Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:10.38,0:01:13.25,Default,,0,0,0,,Жеңіл қуырылған мандарин туралы не ойлайсыз?
Dialogue: 0,0:01:13.25,0:01:16.25,Default,,0,0,0,,Иә, дәмді және иісі де жақсы.
Dialogue: 0,0:01:18.39,0:01:23.03,Default,,0,0,0,,G квесті жазбасында Трисли командасының аты бар.
Dialogue: 0,0:01:23.03,0:01:25.68,Default,,0,0,0,,Хмм, ақыры келді.
Dialogue: 0,0:01:25.68,0:01:31.61,Default,,0,0,0,,Ақырында күтуден шаршадым.
Dialogue: 0,0:01:31.61,0:01:34.41,Default,,0,0,0,,Айтыскерлер көңілді болса жақсы болар еді.
Dialogue: 0,0:04:54.39,0:04:56.34,Default,,0,0,0,,Бір нәрсе➡
Dialogue: 0,0:04:56.34,0:04:59.05,Default,,0,0,0,,Мұнда атмосфера біршама өзгерді.
Dialogue: 0,0:04:59.05,0:05:01.70,Default,,0,0,0,,≪Қош келдіңіз!
Dialogue: 0,0:05:01.70,0:05:05.39,Default,,0,0,0,,Біріккен қасиетті бөлімшеге! Хехе...
Dialogue: 0,0:05:05.39,0:05:08.54,Default,,0,0,0,,Сәттілік! Біраз уақыт өтті. Қалайсың?
Dialogue: 0,0:05:08.54,0:05:10.67,Default,,0,0,0,,Иә! (Шион) Ах!
Dialogue: 0,0:05:10.67,0:05:14.03,Default,,0,0,0,,Аа, мен саған тапсырманы орындауға көмектесемін.
Dialogue: 0,0:05:14.03,0:05:16.21,Default,,0,0,0,,Кішкене болса да Юна Сан филиалы ➡
Dialogue: 0,0:05:16.21,0:05:18.63,Default,,0,0,0,,Мен оны жандандыра алсам ғой.
Dialogue: 0,0:05:18.63,0:05:21.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:21.05,0:05:23.20,Default,,0,0,0,,Алдымен сұрауды қабылдаңыз.
Dialogue: 0,0:05:23.20,0:05:27.80,Default,,0,0,0,,Бұл аяқталғаннан кейін мен сізге қайта туылған Юна Сан тармағын көрсетемін!
Dialogue: 0,0:05:33.88,0:05:36.35,Default,,0,0,0,,Мен бұл туралы бұрын айтып кеткен сияқтымын➡
Dialogue: 0,0:05:36.35,0:05:39.55,Default,,0,0,0,,Енді жауынгерлер рейтингі жойылды➡
Dialogue: 0,0:05:39.55,0:05:43.92,Default,,0,0,0,,Енді барлығы бірдей Vanguard ойнай алады.
Dialogue: 0,0:05:43.92,0:05:45.84,Default,,0,0,0,,Иә
Dialogue: 0,0:05:45.84,0:05:49.90,Default,,0,0,0,,Құрылыстар мен қоршаған орта да өте толық➡
Dialogue: 0,0:05:49.90,0:05:54.39,Default,,0,0,0,,Қазіргі Юна Сан филиалы өздерін толықтай Авангардқа арнай алады➡
Dialogue: 0,0:05:54.39,0:05:56.39,Default,,0,0,0,,Керемет жер
Dialogue: 0,0:05:58.56,0:06:02.36,Default,,0,0,0,,Юна-санға осылай істегеніңе сене алар емеспін➡
Dialogue: 0,0:06:02.36,0:06:06.05,Default,,0,0,0,,Сіз және осы жаңа филиал менеджері кереметсіз.
Dialogue: 0,0:06:06.05,0:06:08.22,Default,,0,0,0,,Рен Сузугамори деген кім?
Dialogue: 0,0:06:08.22,0:06:10.55,Default,,0,0,0,,Иә, Сузугамори филиалының менеджері➡
Dialogue: 0,0:06:10.55,0:06:14.72,Default,,0,0,0,,Ол сонымен қатар «Жоғарғы жауынгерлерді оқыту ұйымының» жетекшісі.
Dialogue: 0,0:06:14.72,0:06:16.69,Default,,0,0,0,,Иә
Dialogue: 0,0:06:16.69,0:06:19.04,Default,,0,0,0,,Бұлардың барлығы Ибуки-санның кәдесыйлары.
Dialogue: 0,0:06:19.04,0:06:21.05,Default,,0,0,0,,Ибукидікі?
Dialogue: 0,0:06:21.05,0:06:23.18,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:23.18,0:06:26.72,Default,,0,0,0,,Ренді филиал басшысы етіп тағайындаған Коудзи Ибуки болды.
Dialogue: 0,0:06:26.72,0:06:29.85,Default,,0,0,0,,Жақында Юна Сан тармағын қалпына келтіруді маған сеніп тапсырады➡
Dialogue: 0,0:06:29.85,0:06:33.37,Default,,0,0,0,,Ибукидің мұрасы - жауынгерлерді күшейту бағдарламасы және ➡
Dialogue: 0,0:06:33.37,0:06:37.21,Default,,0,0,0,,Біздің жауынгерлерді оқыту жүйесі бойынша➡
Dialogue: 0,0:06:37.21,0:06:40.83,Default,,0,0,0,,Жаңа Юна-сан жасады
Dialogue: 0,0:06:40.83,0:06:42.88,Default,,0,0,0,,Таныстыру
Dialogue: 0,0:06:42.88,0:06:45.52,Default,,0,0,0,,Бұл Тецу Шиндзо, филиал бастығының міндетін атқарушы.
Dialogue: 0,0:06:45.52,0:06:49.06,Default,,0,0,0,,Біз сізсіз, Трисли командасы➡
Dialogue: 0,0:06:49.06,0:06:53.24,Default,,0,0,0,,Юна-сан➡ қалдырған Авангард туралы ойлар
Dialogue: 0,0:06:53.24,0:06:55.24,Default,,0,0,0,,Мен оны мұра еттім деп ойлаймын.
Dialogue: 0,0:06:57.25,0:06:59.35,Default,,0,0,0,,Дұрыс. Иә!
Dialogue: 0,0:07:01.35,0:07:07.21,Default,,0,0,0,,Мүлдем... сен мені қиын нәрсеге мәжбүрледің ➡
Dialogue: 0,0:07:07.21,0:07:09.39,Default,,0,0,0,,Ибаки
Dialogue: 0,0:07:09.39,0:07:11.39,Default,,0,0,0,,ﾚﾝ
Dialogue: 0,0:07:15.38,0:07:19.89,Default,,0,0,0,,Мен оның сұрағанын орындауға міндетті емеспін.
Dialogue: 0,0:07:19.89,0:07:24.02,Default,,0,0,0,,Менің ойымша, сіз шағымданбас бұрын филиал менеджері ретінде жұмысыңызды орындауыңыз керек.
Dialogue: 0,0:07:24.02,0:07:26.08,Default,,0,0,0,,Ұйымды тұрақты ететін ➡
Dialogue: 0,0:07:26.08,0:07:29.66,Default,,0,0,0,,Өйткені Рен-сама абсолютті харизма ретінде жоғарыда.
Dialogue: 0,0:07:29.66,0:07:32.55,Default,,0,0,0,,Ұсақ тапсырмаларды орындаудың қажеті жоқ.
Dialogue: 0,0:07:32.55,0:07:37.04,Default,,0,0,0,,Бәрін бізге қалдыр...
Dialogue: 0,0:07:37.04,0:07:39.02,Default,,0,0,0,,Жоқ, бұл өте жаман.
Dialogue: 0,0:07:39.02,0:07:42.38,Default,,0,0,0,,Жоқ, мен Рен-сама үшін істей алатыным осы ғана!
Dialogue: 0,0:07:42.38,0:07:45.75,Default,,0,0,0,,Рен мырза, сіз өз қалауыңыз бойынша істей бересіз деп үміттенемін.
Dialogue: 0,0:07:45.75,0:07:49.88,Default,,0,0,0,,Ренді мәңгілікке бұзба.
Dialogue: 0,0:07:49.88,0:07:53.94,Default,,0,0,0,,Дұрыс... Саған жақсы нәрсе үйретейік.
Dialogue: 0,0:07:53.94,0:07:58.26,Default,,0,0,0,,Біз де G жоспарының серіктесіміз.
Dialogue: 0,0:07:58.26,0:08:02.26,Default,,0,0,0,,Балалар, мұның нені білдіретінін түсіндіңдер ме?
Dialogue: 0,0:08:04.21,0:08:06.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:06.35,0:08:08.39,Default,,0,0,0,,Мен Ибукидің бұйрығын орындайтын сияқтымын➡
Dialogue: 0,0:08:08.39,0:08:10.35,Default,,0,0,0,,Мен ауыра бастадым.
Dialogue: 0,0:08:10.35,0:08:14.39,Default,,0,0,0,,Жарайды, егер біз бүгінгі G Quest ойынын жеңіп алсақ➡
Dialogue: 0,0:08:14.39,0:08:16.43,Default,,0,0,0,,Сыйлық беріңіз
Dialogue: 0,0:08:16.43,0:08:18.43,Default,,0,0,0,,Ол Ибуккиде жоқ.
Dialogue: 0,0:08:18.43,0:08:21.05,Default,,0,0,0,,Лен, тағы да осындай өзімшілдікпен айналыс.
Dialogue: 0,0:08:21.05,0:08:24.33,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:08:24.33,0:08:27.04,Default,,0,0,0,,Ха, мен ештеңе істей алмаймын.
Dialogue: 0,0:08:27.04,0:08:30.54,Default,,0,0,0,,Қандай оғаш адам, Сузугамори филиалының бастығы.
Dialogue: 0,0:08:30.54,0:08:32.76,Default,,0,0,0,,О
Dialogue: 0,0:08:32.76,0:08:37.36,Default,,0,0,0,,Цу~ка Ибукки…｡ (Токоха/Шион) Хаха…
Dialogue: 0,0:08:44.54,0:08:47.37,Default,,0,0,0,,Лами Лабиринт бүгін жоқ па?
Dialogue: 0,0:08:47.37,0:08:51.76,Default,,0,0,0,,Дұрыс, бүгін Драен мен Мегаланикамен болған оқиға бар.
Dialogue: 0,0:08:51.76,0:08:54.06,Default,,0,0,0,,Кешіріңіз, мен сізбен кездесе алмадым
Dialogue: 0,0:08:57.25,0:08:59.25,Default,,0,0,0,,)
Dialogue: 0,0:09:16.22,0:09:21.54,Default,,0,0,0,,Біріккен ғибадатхана тармағы G квесті туралы түсіндіріңіз
Dialogue: 0,0:09:21.54,0:09:25.21,Default,,0,0,0,,Жекпе-жек командалар арасындағы турнирлерде өтеді➡
Dialogue: 0,0:09:25.21,0:09:30.35,Default,,0,0,0,,Ақырында аман қалған бір команда AL4 командасымен шайқасады➡
Dialogue: 0,0:09:30.35,0:09:34.05,Default,,0,0,0,,Жеңіске жетсеңіз, сізге 10 мөр ұпайы беріледі.
Dialogue: 0,0:09:34.05,0:09:37.21,Default,,0,0,0,,Баршаңызға сәттілік тілеймін!
Dialogue: 0,0:09:37.21,0:09:39.84,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:09:39.84,0:09:48.22,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:48.22,0:09:51.87,Default,,0,0,0,,Ранункул гүл қыз Ашаға мін!
Dialogue: 0,0:09:51.87,0:09:54.17,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:09:58.58,0:10:01.68,Default,,0,0,0,,Қасиетті түн күзетшісімен толықтай қорғалған!
Dialogue: 0,0:10:04.43,0:10:07.23,Default,,0,0,0,,Chronojet Dragon көмегімен шабуыл!
Dialogue: 0,0:10:09.37,0:10:21.57,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:21.57,0:10:23.60,Default,,0,0,0,,[Майк] Енді соңғы іріктеу кезеңіне.
Dialogue: 0,0:10:23.60,0:10:27.51,Default,,0,0,0,,[Майк] Tri-Three командасы жеңіп, алға шықты.
Dialogue: 0,0:10:27.51,0:10:31.21,Default,,0,0,0,,[Майк] және Team Dimize Neo
Dialogue: 0,0:10:31.21,0:10:35.62,Default,,0,0,0,,Chrono Dragon Nexus сахнасында Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:10:35.62,0:10:38.62,Default,,0,0,0,,Жеңіліссіз!
Dialogue: 0,0:10:41.72,0:10:44.02,Default,,0,0,0,,[Майк] Бұл шешілді!
Dialogue: 0,0:10:44.02,0:10:48.82,Default,,0,0,0,,[Майк] Трисли командасы алдын ала турнирде жеңіске жетті!
Dialogue: 0,0:10:51.06,0:10:53.03,Default,,0,0,0,,Өте күшті, үшеуін көріңіз
Dialogue: 0,0:10:53.03,0:10:56.62,Default,,0,0,0,,Сіз білесіз бе? Олар әр салада жеңіске жетеді.
Dialogue: 0,0:10:56.62,0:10:58.56,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:10:58.56,0:11:03.46,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:11:03.46,0:11:06.56,Default,,0,0,0,,《Куроностар керемет》
Dialogue: 0,0:11:08.57,0:11:11.69,Default,,0,0,0,,Хехехе... Көңіл-күйім жақсы➡
Dialogue: 0,0:11:11.69,0:11:13.70,Default,,0,0,0,,Сен қол белгілері арқылы байланысасың.
Dialogue: 0,0:11:13.70,0:11:16.21,Default,,0,0,0,,Мен сені мүлде құртамын.
Dialogue: 0,0:11:16.21,0:11:20.84,Default,,0,0,0,,AL4 командасының Кио Яхаги
Dialogue: 0,0:11:20.84,0:11:26.72,Default,,0,0,0,,[Майк] Күткеніңізге рахмет. Біріккен Санктуар филиалы G Quest финалы
Dialogue: 0,0:11:26.72,0:11:29.17,Default,,0,0,0,,[Майк] Жарыс командасын таныстыру
Dialogue: 0,0:11:29.17,0:11:34.88,Default,,0,0,0,,Ең алдымен іріктеу кезеңінде жеңіске жеткен топ
Dialogue: 0,0:11:34.88,0:11:37.78,Default,,0,0,0,,[Майк] Найза басы Токоха Анджо➡
Dialogue: 0,0:11:37.78,0:11:40.18,Default,,0,0,0,,Орта дәрежелі ойыншы Шион Киба➡
Dialogue: 0,0:11:40.18,0:11:43.22,Default,,0,0,0,,Генерал Синдо Куроно
Dialogue: 0,0:11:43.22,0:11:45.60,Default,,0,0,0,,Ал егер сіз осы жерден ұтсаңыз➡
Dialogue: 0,0:11:45.60,0:11:48.39,Default,,0,0,0,,Марканың жалпы саны 50 ұпайға жетеді➡
Dialogue: 0,0:11:48.39,0:11:50.76,Default,,0,0,0,,Ол әлі ешкімде жоқ➡
Dialogue: 0,0:11:50.76,0:11:54.51,Default,,0,0,0,,Сіз ұрпақ шебері атағын аласыз.
Dialogue: 0,0:11:54.51,0:11:56.55,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:11:56.55,0:11:59.52,Default,,0,0,0,,[Майк] №1 буын шебері➡
Dialogue: 0,0:11:59.52,0:12:02.22,Default,,0,0,0,,Оның туған уақыты күтіледі
Dialogue: 0,0:12:02.22,0:12:05.87,Default,,0,0,0,,Бірақ бұл оңай жол емес.
Dialogue: 0,0:12:05.87,0:12:09.88,Default,,0,0,0,,Ұстау – AL4 командасы
Dialogue: 0,0:12:09.88,0:12:13.38,Default,,0,0,0,,[Майк] Найза басы Кио Яхаги➡
Dialogue: 0,0:12:13.38,0:12:16.68,Default,,0,0,0,,Орта деңгейдегі ойыншы Наруми Асака
Dialogue: 0,0:12:16.68,0:12:20.20,Default,,0,0,0,,Ал жалпы...
Dialogue: 0,0:12:20.20,0:12:23.21,Default,,0,0,0,,[Майк] Бұл Сузугамори Рен филиалының басшысы!
Dialogue: 0,0:12:25.19,0:12:27.54,Default,,0,0,0,,Сузугамори филиалының басшысы!?
Dialogue: 0,0:12:30.40,0:12:32.72,Default,,0,0,0,,[Майк] Зал тосын сыйларға толы.
Dialogue: 0,0:12:32.72,0:12:34.67,Default,,0,0,0,,[Майк] Әрине.
Dialogue: 0,0:12:34.67,0:12:37.69,Default,,0,0,0,,[Майк] G Quest ойынында Сузугамори филиалының басшысы төбелеседі➡
Dialogue: 0,0:12:37.69,0:12:39.71,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:12:39.71,0:12:41.73,Default,,0,0,0,,≪Тамаша!
Dialogue: 0,0:12:41.73,0:12:44.81,Default,,0,0,0,,≪Мен ұрпақ шеберін тоқтатуды жоспарлап отырмын.
Dialogue: 0,0:12:44.81,0:12:46.70,Default,,0,0,0,,≪Не болады? Бұл ұрыс
Dialogue: 0,0:12:46.70,0:12:51.69,Default,,0,0,0,,Егер бөлім бастығының өзі соғысқа қатысса...➡
Dialogue: 0,0:12:51.69,0:12:55.06,Default,,0,0,0,,Біз сыйлықты күтетін сияқтымыз.
Dialogue: 0,0:12:55.06,0:12:58.44,Default,,0,0,0,,Осыған байыппен қарайық. Және сыйақы да.
Dialogue: 0,0:12:58.44,0:13:00.44,Default,,0,0,0,,Ұрпақ шебері де
Dialogue: 0,0:14:42.36,0:14:45.40,Default,,0,0,0,,Финал эстафеталық жекпе-жек болады
Dialogue: 0,0:14:45.40,0:14:48.03,Default,,0,0,0,,Жекпе-жек алдында ережелерді тексеріңіз
Dialogue: 0,0:14:48.03,0:14:51.00,Default,,0,0,0,,Авангард 5 зақым алады.
Dialogue: 0,0:14:51.00,0:14:54.72,Default,,0,0,0,,3 орта деңгейдегі ойыншыларға зиян
Dialogue: 0,0:14:54.72,0:14:57.06,Default,,0,0,0,,Ұтылған ойыншы палубаны жинайды
Dialogue: 0,0:14:57.06,0:14:59.40,Default,,0,0,0,,Қол мен тақта тұқым қуалайды➡
Dialogue: 0,0:14:59.40,0:15:02.03,Default,,0,0,0,,Өз палубаңызды пайдаланыңыз
Dialogue: 0,0:15:02.03,0:15:04.37,Default,,0,0,0,,Генерал 3 залал алады
Dialogue: 0,0:15:04.37,0:15:07.47,Default,,0,0,0,,Қарсылас командаға барлығы 11 зиян келтірсеңіз➡
Dialogue: 0,0:15:07.47,0:15:09.36,Default,,0,0,0,,Жеңіс расталды
Dialogue: 0,0:15:09.36,0:15:12.06,Default,,0,0,0,,бастайық
Dialogue: 0,0:15:12.06,0:15:15.41,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:15:15.41,0:15:18.05,Default,,0,0,0,,Таоюань қыз Эльми!
Dialogue: 0,0:15:18.05,0:15:20.38,Default,,0,0,0,,ﾒｶ･ｱﾅﾗｲｻﾞｰ！
Dialogue: 0,0:15:20.38,0:15:24.34,Default,,0,0,0,,Таза қыз Катринаға мініңіз!
Dialogue: 0,0:15:24.34,0:15:27.39,Default,,0,0,0,,Бақа шабушы сияқты жүр!
Dialogue: 0,0:15:27.39,0:15:29.74,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:15:29.74,0:15:31.74,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:15:36.77,0:15:39.39,Default,,0,0,0,,[Майк] Бастапқыда Трисли жетекшілік етеді.
Dialogue: 0,0:15:39.39,0:15:41.69,Default,,0,0,0,,[Майк] Анджо ойыншысының зақымдануы 1
Dialogue: 0,0:15:41.69,0:15:44.06,Default,,0,0,0,,[Майк] Yahagi ойыншысының зақымдануы 3
Dialogue: 0,0:15:44.06,0:15:47.39,Default,,0,0,0,,Ха, сен сондай жақсысың➡
Dialogue: 0,0:15:47.39,0:15:49.76,Default,,0,0,0,,Сен менің жауым емессің.
Dialogue: 0,0:15:49.76,0:15:53.76,Default,,0,0,0,,Талантты адам сияқты Rising Nova-ға мініңіз!
Dialogue: 0,0:15:56.74,0:15:59.69,Default,,0,0,0,,Ол бір кездері төрт жекпе-жек болып қуылғанымен➡
Dialogue: 0,0:15:59.69,0:16:03.38,Default,,0,0,0,,AL4➡ мүшесі ретінде оралды
Dialogue: 0,0:16:03.38,0:16:08.37,Default,,0,0,0,,Менің күшімнен қорқып, қалтырап!
Dialogue: 0,0:16:08.37,0:16:10.37,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:16:10.37,0:16:12.37,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:16:14.72,0:16:19.38,Default,,0,0,0,,Miracle Ace патшасын атып тастаңыз!
Dialogue: 0,0:16:19.38,0:16:23.01,Default,,0,0,0,,Ғажайып Эйспен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:16:23.01,0:16:25.33,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:16:25.33,0:16:28.39,Default,,0,0,0,,Devil Watch-қа жоғары қоңырау
Dialogue: 0,0:16:28.39,0:16:31.47,Default,,0,0,0,,Ібіліс сағатын зарядтаңыз
Dialogue: 0,0:16:31.47,0:16:34.39,Default,,0,0,0,,Заряд? Ха, мен саған айтамын.
Dialogue: 0,0:16:34.39,0:16:39.35,Default,,0,0,0,,Шақырылған бөлімшенің шайқас соңында палубаға оралуына айырбас➡
Dialogue: 0,0:16:39.35,0:16:42.43,Default,,0,0,0,,Үлкен күшке ие болады
Dialogue: 0,0:16:42.43,0:16:46.03,Default,,0,0,0,,Бұл Спайк Brothers-тің ерекше шеберлігі: зарядтау!
Dialogue: 0,0:16:49.72,0:16:51.68,Default,,0,0,0,,Хахаха...!
Dialogue: 0,0:16:51.68,0:16:54.73,Default,,0,0,0,,Ібіліс күзетімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:16:54.73,0:16:58.70,Default,,0,0,0,,Қуат плюс 3000 зарядтау күйіне байланысты!
Dialogue: 0,0:16:58.70,0:17:00.70,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:17:03.39,0:17:06.06,Default,,0,0,0,,Wink Killer Misery арқылы шабуыл
Dialogue: 0,0:17:06.06,0:17:08.06,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:17:11.71,0:17:15.07,Default,,0,0,0,,Мен осы команданың кесу капитанымын.
Dialogue: 0,0:17:15.07,0:17:18.07,Default,,0,0,0,,Бұл күрес ағынды басқарады
Dialogue: 0,0:17:18.07,0:17:21.45,Default,,0,0,0,,Сондықтан мен ешқашан кері шегіне алмаймын.
Dialogue: 0,0:17:21.45,0:17:23.67,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:17:23.67,0:17:27.38,Default,,0,0,0,,Көктемгі гүл ханшайымы Альборея!
Dialogue: 0,0:17:27.38,0:17:29.36,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:17:29.36,0:17:31.80,Default,,0,0,0,,Жоғары қоңырау Greenshot Elf!
Dialogue: 0,0:17:31.80,0:17:34.05,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000！
Dialogue: 0,0:17:34.05,0:17:36.04,Default,,0,0,0,,Блум жасыл эльфті ату!
Dialogue: 0,0:17:36.04,0:17:38.04,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000！
Dialogue: 0,0:17:38.04,0:17:40.02,Default,,0,0,0,,ﾌﾞﾙｰﾑ？
Dialogue: 0,0:17:40.02,0:17:42.71,Default,,0,0,0,,Хехе, мен саған айтамын.
Dialogue: 0,0:17:42.71,0:17:45.71,Default,,0,0,0,,Тақтада аттас бірлік пайда болған кезде➡
Dialogue: 0,0:17:45.71,0:17:48.68,Default,,0,0,0,,Сіз күшті дағдыларды ала аласыз.
Dialogue: 0,0:17:48.68,0:17:54.09,Default,,0,0,0,,Көктемгі гүл ханшайымы Альбореяда Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:54.09,0:17:57.09,Default,,0,0,0,,Ха, алайық.
Dialogue: 0,0:18:00.68,0:18:03.08,Default,,0,0,0,,Хахаха...!
Dialogue: 0,0:18:03.08,0:18:06.35,Default,,0,0,0,,Ең берік темір қабырға! Мен толық күзетшімін!
Dialogue: 0,0:18:06.35,0:18:08.42,Default,,0,0,0,,Хахаха...!
Dialogue: 0,0:18:08.42,0:18:10.72,Default,,0,0,0,,ｷｮｳ…
Dialogue: 0,0:18:12.87,0:18:16.46,Default,,0,0,0,,Не? Арқамды салқындатады...
Dialogue: 0,0:18:16.46,0:18:19.96,Default,,0,0,0,,Гриншот элфімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:23.00,0:18:27.22,Default,,0,0,0,,[Майк] Зақым 4! Авангард 5 зақыммен жеңіледі.
Dialogue: 0,0:18:27.22,0:18:29.39,Default,,0,0,0,,[Майк] Яхаги ойыншысы үлкен соққы
Dialogue: 0,0:18:29.39,0:18:33.34,Default,,0,0,0,,Шулы! Мен мұны осы кезекпен аяқтаймын.
Dialogue: 0,0:18:33.34,0:18:36.73,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:18:36.73,0:18:40.17,Default,,0,0,0,,Үлкен зұлым Дити Пикаро!
Dialogue: 0,0:18:40.17,0:18:43.40,Default,,0,0,0,,Лас Пикаромен Авангардқа шабуыл жасаңыз
Dialogue: 0,0:18:43.40,0:18:46.34,Default,,0,0,0,,Қадам жасау шеберлігі Нянрукты жанға апарыңыз
Dialogue: 0,0:18:46.34,0:18:48.86,Default,,0,0,0,,«Бақа шабушысы» жоғары деңгейлі қоңырау
Dialogue: 0,0:18:48.86,0:18:52.05,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ5000！
Dialogue: 0,0:18:52.05,0:18:54.03,Default,,0,0,0,,Лас Пикаро дағдылары
Dialogue: 0,0:18:54.03,0:18:56.55,Default,,0,0,0,,Колбальт импульсін жанға алыңыз
Dialogue: 0,0:18:56.55,0:18:59.92,Default,,0,0,0,,Жоғары 3 тыл сақшысын шақырыңыз!
Dialogue: 0,0:18:59.92,0:19:01.92,Default,,0,0,0,,ﾁｬｰｼﾞ
Dialogue: 0,0:19:03.89,0:19:05.93,Default,,0,0,0,,Қолыңыздағы карталарды жанға жіберу арқылы➡
Dialogue: 0,0:19:05.93,0:19:09.93,Default,,0,0,0,,Мен бөлімшелерді қуаттандыру кезінде лагерімді дайындадым.
Dialogue: 0,0:19:12.22,0:19:15.40,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:19:15.40,0:19:18.86,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:19:18.86,0:19:21.54,Default,,0,0,0,,Критикалық триггер күші - Frog Raider
Dialogue: 0,0:19:21.54,0:19:24.53,Default,,0,0,0,,Сыншы - жонгернаут!
Dialogue: 0,0:19:24.53,0:19:26.53,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:19:28.72,0:19:30.70,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:19:30.70,0:19:33.22,Default,,0,0,0,,Сіз 2 тамаша картаны қолдандыңыз ба?
Dialogue: 0,0:19:33.22,0:19:37.22,Default,,0,0,0,,Жарайды ма? Менің шабуылдарым жалғаса береді.
Dialogue: 0,0:19:37.22,0:19:41.26,Default,,0,0,0,,Ібіліс сағатының күшейтетін көзді қысу түсімен шабуыл!
Dialogue: 0,0:19:41.26,0:19:44.68,Default,,0,0,0,,Дағдыны белсендіру Juggernaut шақырыңыз!
Dialogue: 0,0:19:44.68,0:19:49.17,Default,,0,0,0,,[Майк] Қолыңызды қайтадан жанға жіберіп, шеберлікпен Жоғарғыға қоңырау шалыңыз.
Dialogue: 0,0:19:49.17,0:19:53.39,Default,,0,0,0,,[Майк] Яхаги: Күшті үздіксіз шабуыл!
Dialogue: 0,0:19:53.39,0:19:56.31,Default,,0,0,0,,Мені ұр!
Dialogue: 0,0:19:56.31,0:19:58.31,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:20:00.93,0:20:02.93,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:20:04.95,0:20:07.37,Default,,0,0,0,,[Майк] Яхагидің қатты асығуы!
Dialogue: 0,0:20:07.37,0:20:11.79,Default,,0,0,0,,[Майк] Анжо ойыншысы Зақым 4. Істейтін ештеңе жоқ
Dialogue: 0,0:20:11.79,0:20:16.38,Default,,0,0,0,,Жерді 12 рет айналып өткен шабуылдарым әлі де тоқтаусыз.
Dialogue: 0,0:20:16.38,0:20:19.88,Default,,0,0,0,,Дағды іске қосылды! Кккккккккккккккккккккккккккккккк солай
Dialogue: 0,0:20:19.88,0:20:23.89,Default,,0,0,0,,Мен ең күштімін! Хахаха...
Dialogue: 0,0:20:23.89,0:20:26.19,Default,,0,0,0,,Ахахха... Уа!
Dialogue: 0,0:20:31.39,0:20:34.85,Default,,0,0,0,,Уф... Жыпылықтауышпен шабуыл
Dialogue: 0,0:20:34.85,0:20:37.38,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ！
Dialogue: 0,0:20:37.38,0:20:40.39,Default,,0,0,0,,Қарғыс атсын... Бұл кезек.
Dialogue: 0,0:20:40.39,0:20:43.02,Default,,0,0,0,,[Майк] Анджо аман қалды.
Dialogue: 0,0:20:43.02,0:20:46.06,Default,,0,0,0,,[Майк] Бұл жолы мен жауап ретінде қарсы шабуыл жасаймын.
Dialogue: 0,0:20:46.06,0:20:49.83,Default,,0,0,0,,Ұжым игілігі үшін міндетті түрде бастама көтеріңіз!
Dialogue: 0,0:20:49.83,0:20:52.23,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:20:52.23,0:20:55.89,Default,,0,0,0,,Арманды айналдыратын Ранункулус Ашермен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:20:55.89,0:20:58.59,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:20:58.59,0:21:00.59,Default,,0,0,0,,Не!?
Dialogue: 0,0:21:08.62,0:21:10.62,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:21:10.62,0:21:13.75,Default,,0,0,0,,[Майк] Трисли командасы бастаманы қолға алды!
Dialogue: 0,0:21:13.75,0:21:17.55,Default,,0,0,0,,Қарғыс атсын! Мен қалағандай күресе алсам...
Dialogue: 0,0:21:20.01,0:21:23.73,Default,,0,0,0,,Менің қолымда мінсіз күзетші бар еді, оны неге күзетпедім?
Dialogue: 0,0:21:23.73,0:21:27.18,Default,,0,0,0,,Бұл AL4 стратегиясы.
Dialogue: 0,0:21:27.18,0:21:31.55,Default,,0,0,0,,[Майк] Яхаги жеңіліске ұшырағандықтан, 9-шы айналым осында аяқталады.
Dialogue: 0,0:21:31.55,0:21:36.18,Default,,0,0,0,,[Майк] AL4 командасының орнына орташа деңгейдегі ойыншы Наруми келеді.
Dialogue: 0,0:21:36.18,0:21:38.16,Default,,0,0,0,,Сіз тым алданып бара жатырсыз.
Dialogue: 0,0:21:38.16,0:21:41.38,Default,,0,0,0,,Хмм, жеткілікті.
Dialogue: 0,0:21:41.38,0:21:43.37,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:21:43.37,0:21:46.05,Default,,0,0,0,,Ал...
Dialogue: 0,0:21:46.05,0:21:48.94,Default,,0,0,0,,Бұл Кио! Бұл Кио Яхаги!
Dialogue: 0,0:21:48.94,0:21:52.53,Default,,0,0,0,,[Майк] Қарым-қатынас қорғаушысы Яхагиден мұраға қалды➡
Dialogue: 0,0:21:52.53,0:21:58.62,Default,,0,0,0,,4 картаны сәйкестендір, Нарумидің қолында 9 карта бар
Dialogue: 0,0:21:58.62,0:22:02.00,Default,,0,0,0,,Екінші акт басталады, абай болыңыз.
Dialogue: 0,0:22:02.00,0:22:05.36,Default,,0,0,0,,Жүр! Түнгі идол Кясарин!
Dialogue: 0,0:22:05.36,0:22:07.42,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:22:07.42,0:22:11.02,Default,,0,0,0,,Тұңғиықтың түнгі пұты
Dialogue: 0,0:22:13.08,0:22:15.58,Default,,0,0,0,,Беатрис
Dialogue: 0,0:22:15.58,0:22:19.84,Default,,0,0,0,,Қоңырау шалыңыз! Қорқынышты пұт көрінісі
Dialogue: 0,0:22:19.84,0:22:22.39,Default,,0,0,0,,Лесли қорқынышты қуыршақ!
Dialogue: 0,0:22:22.39,0:22:26.34,Default,,0,0,0,,Lesley's Boost Winkler Misery көмегімен шабуыл!
Dialogue: 0,0:22:26.34,0:22:29.40,Default,,0,0,0,,Дағдыны белсендіру Алисадан жоғары алкоголь
Dialogue: 0,0:22:29.40,0:22:32.55,Default,,0,0,0,,[Майк] Yahagi➡-дан мұраға алынған бірлікті пайдалану
Dialogue: 0,0:22:32.55,0:22:34.52,Default,,0,0,0,,Наруми орнатқан
Dialogue: 0,0:22:34.52,0:22:37.39,Default,,0,0,0,,[Майк] Бұл эстафеталық жекпе-жектің нағыз ләззаты.
Dialogue: 0,0:22:37.39,0:22:39.84,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:22:39.84,0:22:42.68,Default,,0,0,0,,Авангардқа Алисамен бірге шабуыл жасаңыз
Dialogue: 0,0:22:42.68,0:22:46.35,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:22:46.35,0:22:49.70,Default,,0,0,0,,Анджо Токоха онша қозғалмайды.
Dialogue: 0,0:22:49.70,0:22:51.90,Default,,0,0,0,,Жүйрік болу
Dialogue: 0,0:22:51.90,0:22:54.37,Default,,0,0,0,,Сонда бұл туралы не деуге болады?
Dialogue: 0,0:22:54.37,0:22:57.17,Default,,0,0,0,,Беатриспен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:22:59.26,0:23:01.56,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ｡ ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:23:03.55,0:23:08.15,Default,,0,0,0,,Heal Trigger 1 зақымдарды қалпына келтіреді. Күш Алисаға түседі
Dialogue: 0,0:23:13.06,0:23:15.06,Default,,0,0,0,,Беатрис дағдылары
Dialogue: 0,0:23:15.06,0:23:17.89,Default,,0,0,0,,Алиса Лесли Мирабел жанға
Dialogue: 0,0:23:17.89,0:23:19.85,Default,,0,0,0,,Beardorikusu G аймағына дейін
Dialogue: 0,0:23:19.85,0:23:24.07,Default,,0,0,0,,Soul және Superior Call-дан 2 Алиса алыңыз
Dialogue: 0,0:23:24.07,0:23:27.42,Default,,0,0,0,,Лагерьді ұйымдастыру үшін жанды шебер пайдаланыңыз
Dialogue: 0,0:23:27.42,0:23:30.01,Default,,0,0,0,,Бұл Пейлмунның жақсы білетін тактикасы.
Dialogue: 0,0:23:30.01,0:23:32.73,Default,,0,0,0,,Авангардқа Алисамен бірге шабуыл жасаңыз
Dialogue: 0,0:23:32.73,0:23:34.68,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:23:34.68,0:23:36.73,Default,,0,0,0,,Оң жақ Алисамен шабуыл
Dialogue: 0,0:23:36.73,0:23:39.35,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:23:39.35,0:23:41.85,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:23:41.85,0:23:46.04,Default,,0,0,0,,《Иә, бұл аздап қысылған сияқты.》
Dialogue: 0,0:23:46.04,0:23:49.68,Default,,0,0,0,,Гриншот элфімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:23:49.68,0:23:52.21,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:23:52.21,0:23:54.23,Default,,0,0,0,,ﾋｰﾙﾄﾘｶﾞｰ
Dialogue: 0,0:23:54.23,0:23:58.55,Default,,0,0,0,,Ашермен бірге армандайтын Ранункулдың шабуылы
Dialogue: 0,0:23:58.55,0:24:01.05,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ｡ ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:24:03.04,0:24:06.34,Default,,0,0,0,,Heal Trigger 1 зақымдануды қалпына келтіру
Dialogue: 0,0:24:06.34,0:24:09.70,Default,,0,0,0,,Жасыл атыс элфімен шабуыл! Норгаард
Dialogue: 0,0:24:09.70,0:24:13.28,Default,,0,0,0,,Бұл да күзетсіз. Толық күзетші ғана емес ➡
Dialogue: 0,0:24:13.28,0:24:16.02,Default,,0,0,0,,Сіз барлық карталарыңызды сақтағыңыз келе ме?
Dialogue: 0,0:24:16.02,0:24:19.89,Default,,0,0,0,,Менің жекпе-жегім Рен-самаға арналған жекпе-жек
Dialogue: 0,0:24:19.89,0:24:24.36,Default,,0,0,0,,Менің рөлім - Рен-саманың күресетін сахнасын жасау!
Dialogue: 0,0:24:24.36,0:24:26.38,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:24:26.38,0:24:30.30,Default,,0,0,0,,Бұл менің бақытты қуанышым!
Dialogue: 0,0:24:30.30,0:24:32.22,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:24:32.22,0:24:34.17,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:24:34.17,0:24:36.87,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:24:36.87,0:24:39.54,Default,,0,0,0,,Дағдыларды белсендіру
Dialogue: 0,0:24:39.54,0:24:45.18,Default,,0,0,0,,[Майк] Наруми өз лагерін Soul көмегімен тағы да құрады.
Dialogue: 0,0:24:45.18,0:24:48.90,Default,,0,0,0,,Карталарыңызды сақтаңыз және агрессивті күресіңіз
Dialogue: 0,0:24:48.90,0:24:51.42,Default,,0,0,0,,Бұл AL4
Dialogue: 0,0:24:51.42,0:24:53.92,Default,,0,0,0,,Авангардқа Алисамен бірге шабуыл жасаңыз!
Dialogue: 0,0:24:56.23,0:24:59.38,Default,,0,0,0,,[Майк] Анджо ойыншысы тағы да 4 зиян келтіреді!
Dialogue: 0,0:24:59.38,0:25:02.01,Default,,0,0,0,,Әлі екі шабуыл қалды.
Dialogue: 0,0:25:02.01,0:25:04.55,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:25:04.55,0:25:07.40,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ！
Dialogue: 0,0:25:07.40,0:25:11.72,Default,,0,0,0,,[Майк] Анжо ойыншысы оны сәтті қорғады.
Dialogue: 0,0:25:11.72,0:25:13.73,Default,,0,0,0,,Жарайсыңдар! Жақсы!
Dialogue: 0,0:25:13.73,0:25:16.10,Default,,0,0,0,,Сіз шынымен көп жұмыс істеуіңіз керек.
Dialogue: 0,0:25:16.10,0:25:19.88,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:25:19.88,0:25:24.89,Default,,0,0,0,,Мен сізге бұлай көп қозғалмайтынымды айттым.
Dialogue: 0,0:25:24.89,0:25:29.69,Default,,0,0,0,,Ал біздің өз күресу тәсілдеріміз бар.
Dialogue: 0,0:25:31.71,0:25:35.35,Default,,0,0,0,,《Сіз сахнаға шығуға жарамды сияқтысыз.》
Dialogue: 0,0:25:35.35,0:25:37.78,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:25:37.78,0:25:40.28,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:25:47.38,0:25:50.88,Default,,0,0,0,,[Майк] Бұл шешілді! Зақым 8!
Dialogue: 0,0:25:50.88,0:25:54.30,Default,,0,0,0,,[Майк] Анжо ойыншысы: Екі ойыншы жетіспейді! Жақсы!
Dialogue: 0,0:25:54.30,0:25:58.35,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:25:58.35,0:26:00.71,Default,,0,0,0,,Сахна қойылды.
Dialogue: 0,0:26:00.71,0:26:03.34,Default,,0,0,0,,Рахмет, Асака
Dialogue: 0,0:26:03.34,0:26:06.80,Default,,0,0,0,,[Майк] AL4 командасына ештеңе қалмады
Dialogue: 0,0:26:06.80,0:26:10.40,Default,,0,0,0,,[Майк] Барлығы генерал Сузугамори филиалының бастығына сеніп тапсырылды.
Dialogue: 0,0:26:12.35,0:26:16.92,Default,,0,0,0,,Көптің көзінше төбелескеніме біраз болды.
Dialogue: 0,0:26:16.92,0:26:20.69,Default,,0,0,0,,ﾘﾚｰｼｮﾝｳﾞｧﾝｶﾞｰﾄﾞ
Dialogue: 0,0:26:20.69,0:26:22.99,Default,,0,0,0,,бастайық.
Dialogue: 0,0:26:27.92,0:26:32.42,Default,,0,0,0,,Маған Авангардыңызды көрсетіңіз
Dialogue: 0,0:30:33.40,0:30:35.85,Default,,0,0,0,,Бұл жолғы тақырып – жаңғыру
Dialogue: 0,0:30:35.85,0:30:41.40,Default,,0,0,0,,Енді 1980 және 1990 жылдардағы үлкен бумға не себеп болды →
Dialogue: 0,0:30:41.40,0:30:43.50,Default,,0,0,0,,Ол қайтадан назарда.
Dialogue: 0,0:30:47.69,0:30:51.06,Default,,0,0,0,,Сол ностальгиялық өнім →
Dialogue: 0,0:30:51.06,0:30:54.58,Default,,0,0,0,,Таңқаларлық эволюцияға қол жеткізілді!?
Dialogue: 0,0:30:54.58,0:31:00.38,Default,,0,0,0,,Осыдан кейін біз ностальгиялық, бірақ жаңа эволюциялық жаңғыруды зерттейміз!
Dialogue: 0,0:31:01.88,0:31:07.88,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory