Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.68,0:01:07.62,Default,,0,0,0,,Куроно жігіттері? (Келіңіз) Иә, мен шешкен сияқтымын.
Dialogue: 0,0:01:07.62,0:01:11.19,Default,,0,0,0,,Миоджин Льюестің амбицияларына қарсы тұру
Dialogue: 0,0:01:11.19,0:01:13.76,Default,,0,0,0,,Олар да өсіп келеді.
Dialogue: 0,0:01:13.76,0:01:16.61,Default,,0,0,0,,Бірақ қарсылас тым үлкен
Dialogue: 0,0:01:16.61,0:01:20.41,Default,,0,0,0,,Бұл олар қашатындар емес дегенді білдірмейді.
Dialogue: 0,0:01:27.41,0:01:30.81,Default,,0,0,0,,Мен бірінші дүкенімде дүкендер турнирін өткізуді ойлап жүрмін.
Dialogue: 0,0:01:30.81,0:01:32.81,Default,,0,0,0,,Е...
Dialogue: 0,0:04:45.74,0:04:49.04,Default,,0,0,0,,Жарайсыңдар, жақында басталады➡
Dialogue: 0,0:04:49.04,0:04:52.46,Default,,0,0,0,,Тез қабылдаңыз. Иә!
Dialogue: 0,0:04:52.46,0:04:54.86,Default,,0,0,0,,Бұл бірінші Card Capital дүкені ме?
Dialogue: 0,0:04:54.86,0:04:57.40,Default,,0,0,0,,Бұл жолы жеке матч.
Dialogue: 0,0:04:57.40,0:05:00.09,Default,,0,0,0,,Біз төбелесу мүмкіндігіміз бар.
Dialogue: 0,0:05:00.09,0:05:03.94,Default,,0,0,0,,Біздің бірінші дүкенге қош келдіңіз, Куроно-кун
Dialogue: 0,0:05:03.94,0:05:06.44,Default,,0,0,0,,Дүкен өзгерсе, истребитель де өзгереді.
Dialogue: 0,0:05:06.44,0:05:09.74,Default,,0,0,0,,Әртүрлі адамдармен танысу жақсы.
Dialogue: 0,0:05:15.70,0:05:17.74,Default,,0,0,0,,Сәлем Куроно!
Dialogue: 0,0:05:17.74,0:05:19.72,Default,,0,0,0,,Балалар сендер де келдіңдер ме?
Dialogue: 0,0:05:19.72,0:05:23.14,Default,,0,0,0,,Бірінші дүкен туралы айтатын болсақ, Камуи-сан мен Кай Тошики-сан кездесті➡
Dialogue: 0,0:05:23.14,0:05:25.08,Default,,0,0,0,,Олар топ құрған деген қауесет➡
Dialogue: 0,0:05:25.08,0:05:27.05,Default,,0,0,0,,Киелі жер, былайша айтқанда.
Dialogue: 0,0:05:27.05,0:05:30.58,Default,,0,0,0,,Керемет жауынгер инкогнито режимінде келуі мүмкін!
Dialogue: 0,0:05:30.58,0:05:32.53,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:05:32.53,0:05:34.74,Default,,0,0,0,,Аа... жақсы.
Dialogue: 0,0:05:34.74,0:05:38.11,Default,,0,0,0,,Жоқ, Камуи мырза аты аңызға айналған жауынгер➡
Dialogue: 0,0:05:38.11,0:05:40.24,Default,,0,0,0,,Білемін, бірақ не дейсіз?➡
Dialogue: 0,0:05:40.24,0:05:43.58,Default,,0,0,0,,Біз жиі кездесетіндіктен, сиректік аз.
Dialogue: 0,0:05:43.58,0:05:46.72,Default,,0,0,0,,Не! (Цунето және басқалар) Уау!
Dialogue: 0,0:05:46.72,0:05:48.73,Default,,0,0,0,,Бірінші тур басталады
Dialogue: 0,0:05:48.73,0:05:52.25,Default,,0,0,0,,Әрбір тағайындалған кестені қараңыз.
Dialogue: 0,0:05:52.25,0:05:56.02,Default,,0,0,0,,Бірінші дүкенде дүкен турнирі бар ма?
Dialogue: 0,0:05:56.02,0:05:58.08,Default,,0,0,0,,Токоха-чан бармай ма?
Dialogue: 0,0:05:58.08,0:06:02.03,Default,,0,0,0,,Дәл қазір мен төбелескеннен гөрі палубаларды зерттегенді ұнатамын.
Dialogue: 0,0:06:02.03,0:06:05.23,Default,,0,0,0,,Тек екі G квесті қалды➡
Dialogue: 0,0:06:05.23,0:06:07.90,Default,,0,0,0,,Мен жігерлі болғанымды қалаймын.
Dialogue: 0,0:06:07.90,0:06:11.36,Default,,0,0,0,,Күні кеше ғана қарап отырдым.
Dialogue: 0,0:06:11.36,0:06:14.74,Default,,0,0,0,,Куроно да, Шион да күшейіп келеді.
Dialogue: 0,0:06:14.74,0:06:17.71,Default,,0,0,0,,Мен жеңілуге шамасы жоқ
Dialogue: 0,0:06:17.71,0:06:23.24,Default,,0,0,0,,Мен де жаңа мені тапқым келеді.
Dialogue: 0,0:06:23.24,0:06:26.09,Default,,0,0,0,,Палуба құрылысы туралы ойлану➡
Dialogue: 0,0:06:26.09,0:06:29.46,Default,,0,0,0,,Бұл жаңа өзін іздеуге ұқсас болуы мүмкін.
Dialogue: 0,0:06:29.46,0:06:31.41,Default,,0,0,0,,Сәлем Мисаки-сан➡
Dialogue: 0,0:06:31.41,0:06:33.75,Default,,0,0,0,,Бірліктердің бұл комбинациясы туралы не ойлайсыз?
Dialogue: 0,0:06:33.75,0:06:36.83,Default,,0,0,0,,Олай болса, қарсы жарылыс➡ қолданбаңыз
Dialogue: 0,0:06:36.83,0:06:40.09,Default,,0,0,0,,Менің ойымша, бұл Бірінші Авангард жақсырақ.
Dialogue: 0,0:06:40.09,0:06:42.04,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:06:42.04,0:06:44.57,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:06:44.57,0:06:47.88,Default,,0,0,0,,Сіз керемет жүкті көтеріп жатырсыз.
Dialogue: 0,0:06:47.88,0:06:50.08,Default,,0,0,0,,Не? Бұл жақсы
Dialogue: 0,0:06:50.08,0:06:53.07,Default,,0,0,0,,Мен сені толығымен жеңемін.
Dialogue: 0,0:06:53.07,0:06:55.03,Default,,0,0,0,,Бұл менікі➡
Dialogue: 0,0:06:55.03,0:06:57.92,Default,,0,0,0,,Бұл сіздің тағдырыңызды ойып алудың жалғыз жолы!
Dialogue: 0,0:06:57.92,0:07:00.04,Default,,0,0,0,,Не!? Барайық!
Dialogue: 0,0:07:00.04,0:07:02.12,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:07:02.12,0:07:04.12,Default,,0,0,0,,ｳﾞｧ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:07:14.69,0:07:16.91,Default,,0,0,0,,Bladewing Reggie-ге мініңіз!
Dialogue: 0,0:07:16.91,0:07:21.93,Default,,0,0,0,,Полк шеберлігімен палубадан 3 өлшемді creepers алыңыз!
Dialogue: 0,0:07:21.93,0:07:26.21,Default,,0,0,0,,Бұл Қараңғы діннің ерекшелігі болып табылатын Жандарды қолданатын тактика ма?
Dialogue: 0,0:07:26.21,0:07:28.40,Default,,0,0,0,,Уау! Эх...
Dialogue: 0,0:07:28.40,0:07:32.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:32.04,0:07:35.74,Default,,0,0,0,,Мықтылар шыдауы керек
Dialogue: 0,0:07:35.74,0:07:39.41,Default,,0,0,0,,Бұл қатал тағдырға... қазір емес.
Dialogue: 0,0:07:39.41,0:07:41.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:41.36,0:07:44.42,Default,,0,0,0,,ﾐｬｰ
Dialogue: 0,0:07:44.42,0:07:46.87,Default,,0,0,0,,Авангардқа шабуыл жасаңыз! Күзетші!
Dialogue: 0,0:07:46.87,0:07:49.96,Default,,0,0,0,,Уф... әлі жоқ. Ауызыңды жап!
Dialogue: 0,0:07:49.96,0:07:52.92,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:52.92,0:07:57.92,Default,,0,0,0,,Уайымдама, мен сені сол уақыт келгенше ұстап тұру үшін бар күшімді пайдаланамын.
Dialogue: 0,0:07:59.92,0:08:03.94,Default,,0,0,0,,Кеттік! Тағы да Bladewing Reggie-ге барыңыз!
Dialogue: 0,0:08:03.94,0:08:05.90,Default,,0,0,0,,Палубадан 3 картаны жаныңызға салыңыз!
Dialogue: 0,0:08:05.90,0:08:08.41,Default,,0,0,0,,Қазір 15 жан бар
Dialogue: 0,0:08:08.41,0:08:10.39,Default,,0,0,0,,Уақыттың толықтығы!
Dialogue: 0,0:08:10.39,0:08:14.08,Default,,0,0,0,,Енді мөрді босату уақыты келді!
Dialogue: 0,0:08:14.08,0:08:17.08,Default,,0,0,0,,Барлық тіршілік иелеріне өлімнің мейірімі
Dialogue: 0,0:08:17.08,0:08:19.87,Default,,0,0,0,,Және қайта туылған қайырымдылық
Dialogue: 0,0:08:19.87,0:08:22.90,Default,,0,0,0,,Менің оң қолым реинкарнацияға жауапты→
Dialogue: 0,0:08:22.90,0:08:26.21,Default,,0,0,0,,Құдайдың оң қолы, Құдайдың қолы!
Dialogue: 0,0:08:26.21,0:08:28.56,Default,,0,0,0,,Тасыған затыңызды сындырыңыз➡
Dialogue: 0,0:08:28.56,0:08:30.61,Default,,0,0,0,,Тағдырыңды өзің құрастыр
Dialogue: 0,0:08:30.61,0:08:32.53,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:08:32.53,0:08:34.57,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:08:34.57,0:08:39.04,Default,,0,0,0,,Жою қанаттары Блейдвинг Тибболд!
Dialogue: 0,0:08:39.04,0:08:42.42,Default,,0,0,0,,15 немесе одан да көп жандармен дағдыларды белсендіру➡
Dialogue: 0,0:08:42.42,0:08:47.31,Default,,0,0,0,,Алдыңғы қатардағы құрылғылар All Пауэр Plus 10000
Dialogue: 0,0:08:47.31,0:08:50.53,Default,,0,0,0,,Айналмалы жан менің күшім
Dialogue: 0,0:08:50.53,0:08:53.00,Default,,0,0,0,,Өлімнен асқан махаббат киінген маған→
Dialogue: 0,0:08:53.00,0:08:55.00,Default,,0,0,0,,Тізер!
Dialogue: 0,0:08:56.96,0:08:59.96,Default,,0,0,0,,Тағдыр!!
Dialogue: 0,0:09:02.76,0:09:04.76,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:09:07.23,0:09:12.40,Default,,0,0,0,,Мен бұл кісінің не айтып тұрғанын түсінбеймін, бірақ ол күшті.
Dialogue: 0,0:09:12.40,0:09:15.04,Default,,0,0,0,,Бірақ мен де...
Dialogue: 0,0:09:15.04,0:09:17.36,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:09:17.36,0:09:23.25,Default,,0,0,0,,Уақыт-кеңістік айдаһар хроносмандының революциясы!
Dialogue: 0,0:09:23.25,0:09:28.25,Default,,0,0,0,,Dran және Smoke Gear-тен басқа барлық артқы қорғаушыларды палубаның түбіне жылжыту үшін шеберлікті пайдаланыңыз.
Dialogue: 0,0:09:30.27,0:09:33.07,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:09:36.44,0:09:41.94,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:09:46.52,0:09:51.41,Default,,0,0,0,,Накагами-сан, турнирге және жұмыс іздеуге келген дұрыс па?
Dialogue: 0,0:09:51.41,0:09:54.28,Default,,0,0,0,,Мен қаңғыбаспын
Dialogue: 0,0:09:54.28,0:09:57.03,Default,,0,0,0,,Үлкендеріңіздің қабілетін түсінетін компания болыңыз➡
Dialogue: 0,0:09:57.03,0:09:59.37,Default,,0,0,0,,Біз бір күні кездесеміз
Dialogue: 0,0:09:59.37,0:10:02.45,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:10:02.45,0:10:05.75,Default,,0,0,0,,Жоғарғы соғыс құдайы Сусаномен шабуыл!
Dialogue: 0,0:10:09.21,0:10:11.20,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:10:11.20,0:10:13.75,Default,,0,0,0,,Гуну... Мен кенеттен Камуи-санды соққаныма сене алар емеспін➡
Dialogue: 0,0:10:13.75,0:10:16.40,Default,,0,0,0,,Сәтсіздік! Кешіріңіз.
Dialogue: 0,0:10:16.40,0:10:18.85,Default,,0,0,0,,Сирек кездесетін аңыз күрескерінде
Dialogue: 0,0:10:18.85,0:10:21.91,Default,,0,0,0,,Оны тамырларға дейін ұстамаңыз.
Dialogue: 0,0:10:21.91,0:10:23.89,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:10:23.89,0:10:27.05,Default,,0,0,0,,Ку~ Тікелей жекпе-жекті көргенде қатты әсер еттім.
Dialogue: 0,0:10:27.05,0:10:29.23,Default,,0,0,0,,Камуи өте танымал
Dialogue: 0,0:10:29.23,0:10:31.87,Default,,0,0,0,,Азияны билеген адам.
Dialogue: 0,0:10:31.87,0:10:34.72,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:10:34.72,0:10:37.91,Default,,0,0,0,,Барлығың тыныш болыңдар. Біз ұрысып жатырмыз.
Dialogue: 0,0:10:37.91,0:10:39.88,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:10:39.88,0:10:42.08,Default,,0,0,0,,Олай болса, кететін уақыт келді.
Dialogue: 0,0:10:42.08,0:10:44.45,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ ﾒﾃｵｶｲｻﾞｰ！
Dialogue: 0,0:10:44.45,0:10:46.40,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:10:46.40,0:10:48.77,Default,,0,0,0,,Бұл дауыс...
Dialogue: 0,0:10:48.77,0:10:50.77,Default,,0,0,0,,Иә? Камуи-кун
Dialogue: 0,0:10:52.74,0:10:56.24,Default,,0,0,0,,Эми-сан... Біраз уақыт болды!
Dialogue: 0,0:10:56.24,0:11:00.05,Default,,0,0,0,,Біраз уақыт өтті. Турнирге Камуи-кун да қатысты.
Dialogue: 0,0:11:00.05,0:11:02.08,Default,,0,0,0,,Жоқ, жоқ, иә!
Dialogue: 0,0:11:02.08,0:11:04.93,Default,,0,0,0,,Қатысушы Эми-сан болды!
Dialogue: 0,0:11:04.93,0:11:09.57,Default,,0,0,0,,Иә, мен лотерея ұтып алдым, демек бұл тұқым.
Dialogue: 0,0:11:09.57,0:11:11.72,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:11.72,0:11:15.78,Default,,0,0,0,,А, бұл жекпе-жектің жеңімпазы жеңімпаз болады.
Dialogue: 0,0:11:15.78,0:11:18.08,Default,,0,0,0,,Жеңімпазмен күрес
Dialogue: 0,0:11:20.03,0:11:23.18,Default,,0,0,0,,Камуи мырза? Сәттілік
Dialogue: 0,0:11:23.18,0:11:25.44,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:11:25.44,0:11:29.04,Default,,0,0,0,,Жеңіп, Эми-санмен күрес
Dialogue: 0,0:11:31.08,0:11:35.36,Default,,0,0,0,,((Мен Камуи-кунға жүрегіммен шабуылдаймын.
Dialogue: 0,0:11:35.36,0:11:38.87,Default,,0,0,0,,Эмидің жүрегі - Ногард.
Dialogue: 0,0:11:38.87,0:11:42.90,Default,,0,0,0,,Иә? Шынымен бе? Шыныменде))
Dialogue: 0,0:11:42.90,0:11:46.22,Default,,0,0,0,,Не? Жақсы ма, Камуи-сан?
Dialogue: 0,0:11:46.22,0:11:49.86,Default,,0,0,0,,Шынымен де Ногард
Dialogue: 0,0:11:49.86,0:11:52.70,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:11:52.70,0:11:54.88,Default,,0,0,0,,Иә! Мен Камуи мырзаны жеңдім!
Dialogue: 0,0:11:54.88,0:11:57.88,Default,,0,0,0,,Бұл Каль Кей аңызға айналған өлтіруші Цунет! сурет?
Dialogue: 0,0:12:05.58,0:12:08.56,Default,,0,0,0,,Гяа! Ол кетті!
Dialogue: 0,0:12:08.56,0:12:10.66,Default,,0,0,0,,Ол да өспейді.
Dialogue: 0,0:13:54.72,0:14:00.39,Default,,0,0,0,,Менің құдайым және менің құдайыммен күрес және...
Dialogue: 0,0:14:00.39,0:14:04.73,Default,,0,0,0,,Мен сені ауыстырайын ба? Жарайды ма!?
Dialogue: 0,0:14:04.73,0:14:07.58,Default,,0,0,0,,Жоқ, сіз төбелесуді бастағаннан кейін, ➡
Dialogue: 0,0:14:07.58,0:14:09.65,Default,,0,0,0,,Соңына дейін орындау керек
Dialogue: 0,0:14:09.65,0:14:12.54,Default,,0,0,0,,Дұрыс айтасың Эми-сан.
Dialogue: 0,0:14:12.54,0:14:15.49,Default,,0,0,0,,Цунето-кун, оны соңына дейін көріңіз.
Dialogue: 0,0:14:15.49,0:14:17.49,Default,,0,0,0,,Ауырды
Dialogue: 0,0:14:19.36,0:14:21.76,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:14:21.76,0:14:24.25,Default,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:14:24.25,0:14:27.70,Default,,0,0,0,,Айтпақшы, Хроно ше?
Dialogue: 0,0:14:27.70,0:14:29.74,Default,,0,0,0,,≪Сіз қарсылассыз ба?
Dialogue: 0,0:14:29.74,0:14:33.12,Default,,0,0,0,,А, иә, рахмет.
Dialogue: 0,0:14:33.12,0:14:38.25,Default,,0,0,0,,Мен Катцуми Морикавамын, ғаламдағы ең күшті жауынгермін.
Dialogue: 0,0:14:38.25,0:14:40.42,Default,,0,0,0,,Әлемдегі ең күшті?
Dialogue: 0,0:14:40.42,0:14:45.20,Default,,0,0,0,,Дұрыс, мен көшбасшыны бастап, 4-топ➡ тобын бақылап отырдым
Dialogue: 0,0:14:45.20,0:14:47.91,Default,,0,0,0,,Ең күшті күрескер – мен
Dialogue: 0,0:14:47.91,0:14:50.24,Default,,0,0,0,,Ｑ４？
Dialogue: 0,0:14:50.24,0:14:52.79,Default,,0,0,0,,Егер сіз білмесеңіз, сіз жаңадан бастаушысыз ба?
Dialogue: 0,0:14:52.79,0:14:57.08,Default,,0,0,0,,4-топ деген не? Жетекші Айчи: Мисами Тогура, Камуи Катсураги➡
Dialogue: 0,0:14:57.08,0:15:00.44,Default,,0,0,0,,Тошики Кайдан тұратын ең күшті команда
Dialogue: 0,0:15:00.44,0:15:03.59,Default,,0,0,0,,Камуи мырза мен Тошики Кай мырза?
Dialogue: 0,0:15:03.59,0:15:07.36,Default,,0,0,0,,Оларды өсірген менмін.
Dialogue: 0,0:15:07.36,0:15:10.90,Default,,0,0,0,,Қандай ғажайып күрескер... Ах!
Dialogue: 0,0:15:10.90,0:15:16.23,Default,,0,0,0,,)
Dialogue: 0,0:15:16.23,0:15:19.07,Default,,0,0,0,,Мен көремін. Хехе
Dialogue: 0,0:15:19.07,0:15:22.64,Default,,0,0,0,,Бүгін мен саған кеудемді қарызға беремін. Маған айқайлаңыз.
Dialogue: 0,0:15:22.64,0:15:25.38,Default,,0,0,0,,Иә! (Изаки) Ах~ Кими Кими
Dialogue: 0,0:15:25.38,0:15:28.56,Default,,0,0,0,,Өйткені мен бұл кісіні ешқашан шындап тыңдамаймын.
Dialogue: 0,0:15:28.56,0:15:31.23,Default,,0,0,0,,Не? Жүр балам →
Dialogue: 0,0:15:31.23,0:15:33.90,Default,,0,0,0,,Дайынсың ба? Иә
Dialogue: 0,0:15:33.90,0:15:36.54,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:15:36.54,0:15:39.57,Default,,0,0,0,,Time Break Айдаһарына мініңіз!
Dialogue: 0,0:15:39.57,0:15:41.73,Default,,0,0,0,,Сурет сал?
Dialogue: 0,0:15:41.73,0:15:45.21,Default,,0,0,0,,Тағдырды бұрмалап, досыңа бақыт сыйла
Dialogue: 0,0:15:45.21,0:15:47.25,Default,,0,0,0,,Ｇｱｼｽﾄ！
Dialogue: 0,0:15:47.25,0:15:49.88,Default,,0,0,0,,G көмекші? Е~
Dialogue: 0,0:15:49.88,0:15:53.91,Default,,0,0,0,,Егер сізде жүру кезеңіне дейін жүруге мүмкіндік беретін картаңыз болмаса➡
Dialogue: 0,0:15:53.91,0:15:57.58,Default,,0,0,0,,Қолыңызды көрсету арқылы G көмекті орындауға болады.
Dialogue: 0,0:15:57.58,0:15:59.54,Default,,0,0,0,,Менің қолыма қара!
Dialogue: 0,0:15:59.54,0:16:01.58,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:01.58,0:16:04.37,Default,,0,0,0,,Бар болғаны 3 сұр түсті. Хехе
Dialogue: 0,0:16:04.37,0:16:07.90,Default,,0,0,0,,Авангард 3-сыныпта басталып, 3-сыныпта аяқталады
Dialogue: 0,0:16:07.90,0:16:10.91,Default,,0,0,0,,Ең күшті картаны басқаратын адам 3-разряд➡
Dialogue: 0,0:16:10.91,0:16:14.89,Default,,0,0,0,,Бұл Катцуми Морикава, осы ғаламдағы ең күшті жауынгер.
Dialogue: 0,0:16:14.89,0:16:17.23,Default,,0,0,0,,Мен міне алмаймын.
Dialogue: 0,0:16:17.23,0:16:21.62,Default,,0,0,0,,Қолыңызды ашқаннан кейін палубаның жоғарғы бес картасына қараңыз➡
Dialogue: 0,0:16:21.62,0:16:26.57,Default,,0,0,0,,Қолыңызға Vanguard-дан бір дәреже жоғары карта қосыңыз.
Dialogue: 0,0:16:26.57,0:16:29.96,Default,,0,0,0,,Оны қолыңызға қосқаннан кейін палубаны ➡ араластырыңыз
Dialogue: 0,0:16:29.96,0:16:32.88,Default,,0,0,0,,Қолыңыздан 2 карта және 2 G аймағы картасы➡
Dialogue: 0,0:16:32.88,0:16:35.08,Default,,0,0,0,,Бұл ұрыс оны жарамсыз етеді.
Dialogue: 0,0:16:35.08,0:16:37.55,Default,,0,0,0,,Бұл G-ассист.
Dialogue: 0,0:16:37.55,0:16:40.08,Default,,0,0,0,,Мен көремін. Хмф.
Dialogue: 0,0:16:40.08,0:16:42.74,Default,,0,0,0,,Әңгімелесуге қолайлы жер емес.
Dialogue: 0,0:16:42.74,0:16:45.07,Default,,0,0,0,,Енді дайындал, балам.
Dialogue: 0,0:16:45.07,0:16:47.14,Default,,0,0,0,,Ғажайып балаға барыңыз!
Dialogue: 0,0:16:47.14,0:16:49.88,Default,,0,0,0,,Ең күшті шабуыл! Норгаард
Dialogue: 0,0:16:49.88,0:16:51.90,Default,,0,0,0,,Ең күшті жетекті тексеру
Dialogue: 0,0:16:51.90,0:16:55.57,Default,,0,0,0,,Ең күшті сыни триггерді алыңыз!
Dialogue: 0,0:16:55.57,0:16:57.57,Default,,0,0,0,,Гаха!
Dialogue: 0,0:16:57.57,0:17:00.07,Default,,0,0,0,,Хехехе, жүр балам!
Dialogue: 0,0:17:00.07,0:17:02.52,Default,,0,0,0,,Кел, кеудеме секір
Dialogue: 0,0:17:02.52,0:17:04.56,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:17:04.56,0:17:07.75,Default,,0,0,0,,Жүріңіз және қоңырау шалыңыз
Dialogue: 0,0:17:07.75,0:17:09.70,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:17:09.70,0:17:12.25,Default,,0,0,0,,Арх!
Dialogue: 0,0:17:12.25,0:17:17.29,Default,,0,0,0,,Хахаха, мұндай шабуыл маған ауыртпайды немесе қышытпайды.
Dialogue: 0,0:17:17.29,0:17:22.73,Default,,0,0,0,,Бұл бірлік осылай көрінеді.
Dialogue: 0,0:17:22.73,0:17:25.93,Default,,0,0,0,,Сіздің арқаңызда мен атқа міндім. Шабуыл
Dialogue: 0,0:17:25.93,0:17:29.13,Default,,0,0,0,,Арх!
Dialogue: 0,0:17:29.13,0:17:33.73,Default,,0,0,0,,Менің көңілімді түсірме, балам.
Dialogue: 0,0:17:35.69,0:17:37.91,Default,,0,0,0,,Chronojet Dragon-ға мініңіз!
Dialogue: 0,0:17:37.91,0:17:40.56,Default,,0,0,0,,Сондай-ақ түтіндік тетік деп атаңыз
Dialogue: 0,0:17:40.56,0:17:43.20,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:17:43.20,0:17:45.42,Default,,0,0,0,,Жылы-жылу Aaahahahah...
Dialogue: 0,0:17:45.42,0:17:48.27,Default,,0,0,0,,Бұл сирек кездесетін жақсы жекпе-жек.
Dialogue: 0,0:17:48.27,0:17:50.52,Default,,0,0,0,,Кел, балам, дайындал.
Dialogue: 0,0:17:50.52,0:17:53.44,Default,,0,0,0,,Менің ең күшті кезегім басталды
Dialogue: 0,0:17:53.44,0:17:57.36,Default,,0,0,0,,Нашар сүйрегішке мініңіз!
Dialogue: 0,0:17:57.36,0:18:01.80,Default,,0,0,0,,Қазіргі уақытта қадам құнының жоғары дәрежесі қажет➡
Dialogue: 0,0:18:01.80,0:18:05.52,Default,,0,0,0,,3-сыныптың жарқырауы шарықтау шегіне жетті деуге болады.
Dialogue: 0,0:18:05.52,0:18:10.44,Default,,0,0,0,,Кел, менің сүйікті Гре3, жаңа дәуірдің күші менің қолымда.
Dialogue: 0,0:18:10.44,0:18:13.24,Default,,0,0,0,,Генерация аймағы шығарылды!
Dialogue: 0,0:18:13.24,0:18:16.60,Default,,0,0,0,,Енді ең мықты қадамды ұрпақ!
Dialogue: 0,0:18:16.60,0:18:20.02,Default,,0,0,0,,Құдайдың қолы жақсы соңы сүйрегіш!
Dialogue: 0,0:18:20.02,0:18:24.02,Default,,0,0,0,,Алдыңғы қатардағы Jaggernaut Maximum деп атаңыз!
Dialogue: 0,0:18:24.02,0:18:26.57,Default,,0,0,0,,Авангардқа Джуггернаутпен шабуыл жасаңыз!
Dialogue: 0,0:18:26.57,0:18:28.74,Default,,0,0,0,,Қуат плюс 5000 шеберлікпен!
Dialogue: 0,0:18:28.74,0:18:30.71,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:18:30.71,0:18:33.41,Default,,0,0,0,,Шеберлікпен жонгернаут палубаның астында.
Dialogue: 0,0:18:33.41,0:18:35.92,Default,,0,0,0,,Гуденд сүйрегішімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:35.92,0:18:37.87,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:18:37.87,0:18:40.74,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:18:40.74,0:18:44.88,Default,,0,0,0,,Фу~ Оның күштілігі сонша, ешқандай триггер шықпайды...
Dialogue: 0,0:18:44.88,0:18:47.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:47.26,0:18:49.26,Default,,0,0,0,,Жақсы соңғы дағдылар!
Dialogue: 0,0:18:49.26,0:18:51.80,Default,,0,0,0,,Жақсы ұшын үстелдегі G аймағына қайтарыңыз➡
Dialogue: 0,0:18:51.80,0:18:54.90,Default,,0,0,0,,Палубадан Джаггер жазбасына қоңырау шалыңыз!
Dialogue: 0,0:18:54.90,0:18:59.19,Default,,0,0,0,,Сонымен қатар, палубаның нашар ұшын алып тастаңыз және сапарды үзіңіз!
Dialogue: 0,0:18:59.19,0:19:01.19,Default,,0,0,0,,ﾌﾞﾚｲｸﾗｲﾄﾞ!?
Dialogue: 0,0:19:01.19,0:19:04.86,Default,,0,0,0,,Тек Grey3 немесе одан жоғарырақ сұр3-де жүргенде ғана іске қосылады→
Dialogue: 0,0:19:04.86,0:19:06.86,Default,,0,0,0,,Ең күшті шеберлік!
Dialogue: 0,0:19:06.86,0:19:09.38,Default,,0,0,0,,Жаңа ең күшті күш толып жатыр!
Dialogue: 0,0:19:09.38,0:19:13.05,Default,,0,0,0,,Осы бұрылыс кезінде нашар аяқтау рейд дағдысымен шабуыл➡
Dialogue: 0,0:19:13.05,0:19:16.41,Default,,0,0,0,,Артқы қорғаушының күші +10000!
Dialogue: 0,0:19:16.41,0:19:19.89,Default,,0,0,0,,Авангардқа Juggernaut-пен шабуыл жасаңыз!
Dialogue: 0,0:19:19.89,0:19:22.03,Default,,0,0,0,,Ягуардың дағдыларымен қуат плюс 5000!
Dialogue: 0,0:19:22.03,0:19:25.78,Default,,0,0,0,,Нашар шеберлік сізге қосымша 10 000 қуат береді!
Dialogue: 0,0:19:25.78,0:19:27.78,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ！
Dialogue: 0,0:19:29.70,0:19:34.08,Default,,0,0,0,,Ол жеңіп жатыр... Морикава. Неге...
Dialogue: 0,0:19:34.08,0:19:36.21,Default,,0,0,0,,Бұл менің қабілетім!
Dialogue: 0,0:19:36.21,0:19:39.25,Default,,0,0,0,,Бүгінгі Овеннің табысы ең күшті!
Dialogue: 0,0:19:39.25,0:19:42.35,Default,,0,0,0,,Бұл шеберлік пе, әлде сәттілік пе?
Dialogue: 0,0:19:42.35,0:19:44.72,Default,,0,0,0,,《Күтілгендей, бұл адам күшті.
Dialogue: 0,0:19:44.72,0:19:48.07,Default,,0,0,0,,Камуи мырзаны өсіргенім рас! 》
Dialogue: 0,0:19:48.07,0:19:50.71,Default,,0,0,0,,Авангардқа Джуггернаутпен шабуыл жасаңыз!
Dialogue: 0,0:19:50.71,0:19:54.06,Default,,0,0,0,,Дәл сол шеберлікпен қайтадан қуат алыңыз!
Dialogue: 0,0:19:54.06,0:19:56.73,Default,,0,0,0,,ｶﾞｰﾄﾞ！ ｲﾝﾀｰｾﾌﾟﾄ!!
Dialogue: 0,0:19:56.73,0:20:00.03,Default,,0,0,0,,Сіз қорқасыз ба? Бұл кеңістіктегі және уақыттағы ең күшті жауынгер➡
Dialogue: 0,0:20:00.03,0:20:03.57,Default,,0,0,0,,Ең күшті Катцуми Морикаваның ең күшті шынайы құндылығы!
Dialogue: 0,0:20:03.57,0:20:05.97,Default,,0,0,0,,Сіз тек бақыттысыз.
Dialogue: 0,0:20:05.97,0:20:08.74,Default,,0,0,0,,Сәтті тарту күші...
Dialogue: 0,0:20:08.74,0:20:12.40,Default,,0,0,0,,Тұратын рух →
Dialogue: 0,0:20:12.40,0:20:14.53,Default,,0,0,0,,Күш!
Dialogue: 0,0:20:14.53,0:20:16.73,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ!!
Dialogue: 0,0:20:16.73,0:20:20.71,Default,,0,0,0,,Ғарыштық-уақыт жануары Metallica Phoenix!
Dialogue: 0,0:20:20.71,0:20:24.74,Default,,0,0,0,,Қадаммен жүру дағдысы! Mecha Trainer-ді палубаның астына қойыңыз
Dialogue: 0,0:20:24.74,0:20:28.76,Default,,0,0,0,,Metallica Phoenix көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:20:28.76,0:20:30.82,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:20:30.82,0:20:33.57,Default,,0,0,0,,Артқы гвардияның Хроно Дранына уақыт секірісі!
Dialogue: 0,0:20:33.57,0:20:39.72,Default,,0,0,0,,Палубадан бір дәреже жоғары Steam Maiden меміне қоңырау шалыңыз!
Dialogue: 0,0:20:39.72,0:20:43.19,Default,,0,0,0,,Сонымен қатар, Хроно Доранның уақытты жоғалтқан шеберлігімен→
Dialogue: 0,0:20:43.19,0:20:45.29,Default,,0,0,0,,Chrono Джет Superior қоңырауы!
Dialogue: 0,0:20:49.07,0:20:51.17,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:20:55.74,0:20:58.38,Default,,0,0,0,,《Солай...
Dialogue: 0,0:20:58.38,0:21:02.61,Default,,0,0,0,,Тіпті бір маңызды карта пайда болса, сіз жоғалтасыз...
Dialogue: 0,0:21:02.61,0:21:07.11,Default,,0,0,0,,Неге... Менің қолымда карталар көп》
Dialogue: 0,0:21:09.70,0:21:12.00,Default,,0,0,0,,Не болды бала?
Dialogue: 0,0:21:15.44,0:21:17.44,Default,,0,0,0,,Жалғастыру
Dialogue: 0,0:21:19.36,0:21:24.44,Default,,0,0,0,,《Сіз жетекті тексеру кезінде триггер шықпайтынын білесіз бе?
Dialogue: 0,0:21:24.44,0:21:27.21,Default,,0,0,0,,Түсініксіз...》
Dialogue: 0,0:21:27.21,0:21:29.91,Default,,0,0,0,,А... не болды?
Dialogue: 0,0:21:29.91,0:21:32.03,Default,,0,0,0,,Менен қорқасың ба?
Dialogue: 0,0:21:32.03,0:21:34.28,Default,,0,0,0,,Нәтиже қандай болса да →
Dialogue: 0,0:21:34.28,0:21:37.08,Default,,0,0,0,,Алға ұмтылатын бұл Авангард жауынгерлері!
Dialogue: 0,0:21:39.05,0:21:42.74,Default,,0,0,0,,Кел, балам! Иә!
Dialogue: 0,0:21:42.74,0:21:47.14,Default,,0,0,0,,Time Break Blast Chrono Джет көмегімен Авангардқа шабуыл!
Dialogue: 0,0:21:47.14,0:21:50.44,Default,,0,0,0,,Күзетші жоқ! А... Аа!?
Dialogue: 0,0:21:56.95,0:21:59.55,Default,,0,0,0,,А... Мен жеңіліп қалдым ба?
Dialogue: 0,0:22:01.56,0:22:05.13,Default,,0,0,0,,Неге... күзетпедің?
Dialogue: 0,0:22:05.13,0:22:08.23,Default,,0,0,0,,Менің қолымдағы карталар тым күшті болды...
Dialogue: 0,0:22:10.20,0:22:12.73,Default,,0,0,0,,Барлық 3-сынып!
Dialogue: 0,0:22:12.73,0:22:14.74,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:22:14.74,0:22:17.71,Default,,0,0,0,,Мен шайқастың жақын болғанына таң қалдым.
Dialogue: 0,0:22:17.71,0:22:20.24,Default,,0,0,0,,Gre3 ең күшті
Dialogue: 0,0:22:20.24,0:22:23.41,Default,,0,0,0,,Басқа карталар маған сәйкес келмейді, ең күштісі.
Dialogue: 0,0:22:23.41,0:22:25.86,Default,,0,0,0,,Неге!? Неге сен➡
Dialogue: 0,0:22:25.86,0:22:28.73,Default,,0,0,0,,Сіз 3-ші құттықтау картасына ерекше көңіл бөлесіз бе?
Dialogue: 0,0:22:28.73,0:22:31.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:31.19,0:22:33.24,Default,,0,0,0,,Өйткені маған ұнайды!
Dialogue: 0,0:22:33.24,0:22:35.69,Default,,0,0,0,,Маған ұнады... Бәрі осы ма?
Dialogue: 0,0:22:35.69,0:22:38.86,Default,,0,0,0,,Иә! Хаа!!
Dialogue: 0,0:22:38.86,0:22:44.08,Default,,0,0,0,,Маған ұнады... Бұл сөзсіз Авангард, солай емес пе?
Dialogue: 0,0:22:44.08,0:22:47.05,Default,,0,0,0,,Түсіндіңіз бе? иә!
Dialogue: 0,0:22:47.05,0:22:49.47,Default,,0,0,0,,Мен сізбен келіспеймін.
Dialogue: 0,0:22:49.47,0:22:51.92,Default,,0,0,0,,Бұл жай ғана макияж.
Dialogue: 0,0:22:51.92,0:22:54.04,Default,,0,0,0,,Бұл Макэми емес, Катцуми!
Dialogue: 0,0:22:54.04,0:22:56.99,Default,,0,0,0,,Иә, иә! Өйткені басқа ойын бар➡
Dialogue: 0,0:22:56.99,0:22:58.99,Default,,0,0,0,,Тазалық жасайық.
Dialogue: 0,0:23:02.12,0:23:05.72,Default,,0,0,0,,Енді финалдық матчты бастайық!
Dialogue: 0,0:23:09.14,0:23:11.54,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:23:11.54,0:23:14.88,Default,,0,0,0,,Бұл Бермуд үшбұрышы ма?
Dialogue: 0,0:23:14.88,0:23:17.21,Default,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:23:17.21,0:23:21.51,Default,,0,0,0,,Мен сүйкімді бірліктерді жақсы көремін.
Dialogue: 0,0:23:23.57,0:23:25.72,Default,,0,0,0,,Олай болса, бастайық!
Dialogue: 0,0:23:25.72,0:23:27.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:30.08,0:23:32.63,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:23:32.63,0:23:35.28,Default,,0,0,0,,ﾄｩｲﾝｸﾙﾊﾋﾟﾈｽ･ﾊﾟｼﾌｨｶ！
Dialogue: 0,0:23:35.28,0:23:37.38,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:23:39.37,0:23:42.46,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:23:42.46,0:23:44.76,Default,,0,0,0,,ﾄﾘﾌﾟﾙｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:23:47.04,0:23:50.46,Default,,0,0,0,,Уау!!
Dialogue: 0,0:23:50.46,0:23:52.40,Default,,0,0,0,,Жарайсың, Эми-сан!
Dialogue: 0,0:23:52.40,0:23:55.87,Default,,0,0,0,,Күшті! Өйткені, финалға шығу үшін жеткілікті.
Dialogue: 0,0:23:55.87,0:23:59.12,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:23:59.12,0:24:01.12,Default,,0,0,0,,Бірге көңіл көтерейік
Dialogue: 0,0:24:03.06,0:24:06.95,Default,,0,0,0,,Қарасам, мына кісі осылай ұрысады.
Dialogue: 0,0:24:06.95,0:24:11.25,Default,,0,0,0,,Әркім Vanguard ойынын өзінше ұнатады.
Dialogue: 0,0:24:13.87,0:24:15.91,Default,,0,0,0,,Мен де!
Dialogue: 0,0:24:15.91,0:24:18.21,Default,,0,0,0,,Сәттілік! Менен асып түскен бала!
Dialogue: 0,0:24:18.21,0:24:20.75,Default,,0,0,0,,Оны мына соққыға сал!
Dialogue: 0,0:24:20.75,0:24:25.27,Default,,0,0,0,,Кеңістік пен уақытты кесіп тастаңыз және оны тағдырдың жазуымен өшіріңіз!
Dialogue: 0,0:24:25.27,0:24:28.20,Default,,0,0,0,,Жеңіліссіз!
Dialogue: 0,0:24:28.20,0:24:38.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:38.90,0:24:42.05,Default,,0,0,0,,Жеңімпаз - Куроно Шиндо!
Dialogue: 0,0:24:42.05,0:24:45.74,Default,,0,0,0,,Мен хат жібергім келеді…
Dialogue: 0,0:24:45.74,0:24:49.62,Default,,0,0,0,,Жеңіспен құттықтаймыз. Камуи-кунның шәкірті күткендей.
Dialogue: 0,0:24:49.62,0:24:52.04,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:24:52.04,0:24:56.76,Default,,0,0,0,,Бұл өте қызық болды. Бір кезде тағы ұрысайық.
Dialogue: 0,0:24:56.76,0:24:58.70,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:24:58.70,0:25:01.14,Default,,0,0,0,,Сізге жақсы Куроно
Dialogue: 0,0:25:01.14,0:25:04.74,Default,,0,0,0,,Тәңіріммен күресе алдым. құдай?
Dialogue: 0,0:25:04.74,0:25:07.86,Default,,0,0,0,,Екеуіңнің қарым-қатынастарың қандай?
Dialogue: 0,0:25:07.86,0:25:11.08,Default,,0,0,0,,Жарайды, ақыры үйленеміз...?
Dialogue: 0,0:25:11.08,0:25:13.41,Default,,0,0,0,,Иә? Нағиса ше?
Dialogue: 0,0:25:13.41,0:25:15.75,Default,,0,0,0,,Әй, бұл есімді айтпа!
Dialogue: 0,0:25:15.75,0:25:19.24,Default,,0,0,0,,Неліктен? Түскі асыңызды дайындаңыз➡
Dialogue: 0,0:25:19.24,0:25:21.37,Default,,0,0,0,,Бұл жақсы атмосфера болды, солай емес пе?
Dialogue: 0,0:25:21.37,0:25:24.08,Default,,0,0,0,,Сондықтан! (emi)
Dialogue: 0,0:25:24.08,0:25:27.55,Default,,0,0,0,,Камуй-кун мен Нагиса-чан әрқашан жақсы дос болған.
Dialogue: 0,0:25:27.55,0:25:31.28,Default,,0,0,0,,Жоқ... Эми-сан! Жоқ... Гуа!
Dialogue: 0,0:25:31.28,0:25:33.78,Default,,0,0,0,,Қайтадан бірге ойнайық
Dialogue: 0,0:25:35.74,0:25:38.04,Default,,0,0,0,,А, жоқ... жоқ...
Dialogue: 0,0:25:40.07,0:25:42.04,Default,,0,0,0,,Ка... Камуи мырза?
Dialogue: 0,0:25:42.04,0:25:45.04,Default,,0,0,0,,Эми-сан, жоқ!
Dialogue: 0,0:27:22.74,0:27:24.88,Default,,0,0,0,,Эми-сан…｡ Өте орынды.
Dialogue: 0,0:27:24.88,0:27:28.30,Default,,0,0,0,,Мен саған тамақ сатып алайын. (2 адам) Тамақ ішейік, Сенпай!
Dialogue: 0,0:27:28.30,0:27:30.37,Default,,0,0,0,,Мен сені емдеу туралы ешқашан айтқан емеспін...
Dialogue: 0,0:27:30.37,0:27:33.24,Default,,0,0,0,,Бұл гриль еті ме? (Морикава) Менің ойымша, бұл суши!
Dialogue: 0,0:27:33.24,0:27:36.24,Default,,0,0,0,,Рахмет! (Мива) Балалар сендер де!
Dialogue: 0,0:27:36.24,0:27:39.21,Default,,0,0,0,,Бір элементке дейін! Тек бір зат!
Dialogue: 0,0:27:39.21,0:27:41.96,Default,,0,0,0,,Егер сіз оны орнатсаңыз, олар оны қабылдамайды!
Dialogue: 0,0:27:41.96,0:27:44.26,Default,,0,0,0,,Иә
Dialogue: 0,0:27:46.22,0:27:49.24,Default,,0,0,0,,Сізді ұстап қалғаным үшін кешіріңіз.
Dialogue: 0,0:27:49.24,0:27:53.09,Default,,0,0,0,,Бұл жақсы. Бірақ оқиға неде?
Dialogue: 0,0:27:53.09,0:27:56.46,Default,,0,0,0,,Бітті, күте тұрыңыз.
Dialogue: 0,0:27:56.46,0:27:58.76,Default,,0,0,0,,А... иә
Dialogue: 0,0:30:46.76,0:30:50.62,Default,,0,0,0,,1 иендік монетамен бірдей дерлік →
Dialogue: 0,0:30:50.62,0:30:52.62,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:30:55.87,0:30:57.87,Default,,0,0,0,,Бұл жолы да→
Dialogue: 0,0:30:59.37,0:31:05.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory