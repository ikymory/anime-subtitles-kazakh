Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.67,0:01:08.64,Default,,0,0,0,,Куроно-кун өзінің екінші тәуелді картасын оятқан сияқты.
Dialogue: 0,0:01:08.64,0:01:14.34,Default,,0,0,0,,Сонымен қатар ол Миджин Луизаның амбицияларын тоқтатқысы келеді.
Dialogue: 0,0:01:14.34,0:01:17.78,Default,,0,0,0,,Куроно-кун Лайвтың апаты туралы білді➡
Dialogue: 0,0:01:17.78,0:01:19.80,Default,,0,0,0,,Сіз мұны айттыңыз ба?
Dialogue: 0,0:01:19.80,0:01:22.35,Default,,0,0,0,,Бұл не? Білмей немен бетпе-бет келетін →
Dialogue: 0,0:01:22.35,0:01:24.35,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:01:24.35,0:01:28.04,Default,,0,0,0,,Куроно-кун мен Миоджин Роуз арасындағы →
Dialogue: 0,0:01:28.04,0:01:30.64,Default,,0,0,0,,Жалғаулар тым көп
Dialogue: 0,0:04:54.68,0:04:59.50,Default,,0,0,0,,((Дүкен байқауының жеңімпазы - Куроно Шиндо!
Dialogue: 0,0:04:59.50,0:05:01.50,Default,,0,0,0,,Құттықтаймыз! ))
Dialogue: 0,0:05:07.68,0:05:12.63,Default,,0,0,0,,《Хроно: Бұл қызық болды. Авангард жақсы ғой》
Dialogue: 0,0:05:12.63,0:05:14.80,Default,,0,0,0,,((Ибуки: Миоджин Льюс
Dialogue: 0,0:05:14.80,0:05:18.87,Default,,0,0,0,,Оның мақсаты - Крей планетасынан бірлік шақыру➡
Dialogue: 0,0:05:18.87,0:05:21.47,Default,,0,0,0,,Оны өз амбицияларыңыздың құралына айналдырыңыз.
Dialogue: 0,0:05:23.46,0:05:26.50,Default,,0,0,0,,Шақырылған бірлік өз еркімен алынады➡
Dialogue: 0,0:05:26.50,0:05:29.48,Default,,0,0,0,,Толығымен оның қуыршағы бол
Dialogue: 0,0:05:29.48,0:05:33.48,Default,,0,0,0,,Егер ол күш әлемге шығарылса, бұл үлкен іс болар еді))
Dialogue: 0,0:05:36.07,0:05:39.46,Default,,0,0,0,,《Мен сені ешқашан кешіре алмаймын.
Dialogue: 0,0:05:39.46,0:05:42.51,Default,,0,0,0,,Миоджин тоқтады
Dialogue: 0,0:05:42.51,0:05:46.90,Default,,0,0,0,,Мен сенің қиналуыңа жол бермеймін.
Dialogue: 0,0:05:46.90,0:05:50.22,Default,,0,0,0,,Сондықтан мен қалған тәуелді карталарды мүмкіндігінше тезірек аламын➡
Dialogue: 0,0:05:50.22,0:05:52.22,Default,,0,0,0,,Мен оянуым керек》
Dialogue: 0,0:05:54.32,0:05:57.23,Default,,0,0,0,,((Алғашында бұл сіздің әкеңіз болатын➡
Dialogue: 0,0:05:57.23,0:06:00.20,Default,,0,0,0,,Себебі мен оны саған қалдырдым.
Dialogue: 0,0:06:00.20,0:06:05.30,Default,,0,0,0,,Сізде бұл өсиетті орындауға күшіңіз бар ма? ))
Dialogue: 0,0:06:07.34,0:06:11.01,Default,,0,0,0,,Әкенің өсиеті
Dialogue: 0,0:06:11.01,0:06:14.11,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:06:14.11,0:06:16.85,Default,,0,0,0,,Мен көптен бері бармадым.
Dialogue: 0,0:06:16.85,0:06:19.21,Default,,0,0,0,,Білгіңіз келе ме?
Dialogue: 0,0:06:19.21,0:06:21.21,Default,,0,0,0,,Әкем туралы
Dialogue: 0,0:06:24.12,0:06:26.15,Default,,0,0,0,,Шин мырза
Dialogue: 0,0:06:26.15,0:06:29.83,Default,,0,0,0,,Негізі әкем мен Шиндо Лайв бірге болған➡
Dialogue: 0,0:06:29.83,0:06:31.83,Default,,0,0,0,,Біз бір командада болдық.
Dialogue: 0,0:06:31.83,0:06:33.81,Default,,0,0,0,,Әке мен Шин-сан!?
Dialogue: 0,0:06:33.81,0:06:36.88,Default,,0,0,0,,Мен тіпті әлеммен соғыстым.
Dialogue: 0,0:06:36.88,0:06:41.98,Default,,0,0,0,,Лайв мырза физикалық және рухани жағынан команданың эйсі болды.
Dialogue: 0,0:06:43.96,0:06:48.56,Default,,0,0,0,,Мен үшін Лайв мырза Авангардтың шебері➡
Dialogue: 0,0:06:48.56,0:06:53.06,Default,,0,0,0,,Ол бәсекеге қабілетті бәсекелес және кез келген нәрсе туралы сөйлесуге болатын дос болды.
Dialogue: 0,0:06:54.98,0:06:57.98,Default,,0,0,0,,Неге қазір бұл туралы айтып отырсың?
Dialogue: 0,0:07:03.16,0:07:05.16,Default,,0,0,0,,Бірінші кездескеннен бері➡
Dialogue: 0,0:07:05.16,0:07:08.16,Default,,0,0,0,,Мен Куроно-кунның Лайв мырзаның ұлы екенін білдім.
Dialogue: 0,0:07:10.20,0:07:14.00,Default,,0,0,0,,Қайғылы өткенді еске түсірудің қажеті жоқ деп ойлаймын.
Dialogue: 0,0:07:18.12,0:07:22.16,Default,,0,0,0,,Мынау Шин-сан
Dialogue: 0,0:07:22.16,0:07:24.80,Default,,0,0,0,,Әкем маған қалдырған сияқты➡
Dialogue: 0,0:07:24.80,0:07:26.87,Default,,0,0,0,,Сіз бірдеңе білесіз бе?
Dialogue: 0,0:07:26.87,0:07:28.87,Default,,0,0,0,,Әкем солай айтатын
Dialogue: 0,0:07:33.14,0:07:36.48,Default,,0,0,0,,Жоқ, өкінішке орай, ештеңе жоқ
Dialogue: 0,0:07:36.48,0:07:38.64,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:38.64,0:07:41.16,Default,,0,0,0,,Айтпақшы, мен естідім.
Dialogue: 0,0:07:41.16,0:07:45.03,Default,,0,0,0,,Миоджин Луизаның жоспарын бұзғыңыз келетін сияқты.
Dialogue: 0,0:07:45.03,0:07:47.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:49.81,0:07:52.34,Default,,0,0,0,,Маған да жақында айтты.
Dialogue: 0,0:07:52.34,0:07:54.29,Default,,0,0,0,,Сонымен, Куроно-кун→
Dialogue: 0,0:07:54.29,0:07:56.83,Default,,0,0,0,,Сіз Миджинмен бетпе-бет келуге дайынсыз ба?
Dialogue: 0,0:07:56.83,0:07:59.15,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:07:59.15,0:08:01.48,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:01.48,0:08:05.17,Default,,0,0,0,,Миоджин Авангард бөлімін осы әлемге шақырады➡
Dialogue: 0,0:08:05.17,0:08:08.62,Default,,0,0,0,,Олар бәрін бүлдіруге тырысады!
Dialogue: 0,0:08:08.62,0:08:11.88,Default,,0,0,0,,Сіз мені жалғыз қалдыра алмайсыз!
Dialogue: 0,0:08:11.88,0:08:13.88,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:08:15.81,0:08:17.81,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:22.20,0:08:25.50,Default,,0,0,0,,Мен бұл адамның алдында ант бере аламын ба?
Dialogue: 0,0:08:29.71,0:08:32.01,Default,,0,0,0,,Микуру мырза?
Dialogue: 0,0:08:39.35,0:08:41.35,Default,,0,0,0,,Мен қоңырау шалдым
Dialogue: 0,0:08:44.31,0:08:47.91,Default,,0,0,0,,Мен Куроно-кунды бәрінен де жақсы көремін, өйткені біз отбасымыз.
Dialogue: 0,0:08:49.97,0:08:52.17,Default,,0,0,0,,ｸﾛﾉ
Dialogue: 0,0:08:52.17,0:08:54.17,Default,,0,0,0,,Сен менің ағамсың →
Dialogue: 0,0:08:54.17,0:08:57.49,Default,,0,0,0,,Мен әкемнің апатқа ұшырауына үзілді-кесілді қарсымын.
Dialogue: 0,0:08:57.49,0:09:00.18,Default,,0,0,0,,Мен сенің қауіп төнгеніңді қаламаймын.
Dialogue: 0,0:09:00.18,0:09:02.13,Default,,0,0,0,,Қауіпті ме?
Dialogue: 0,0:09:02.13,0:09:05.60,Default,,0,0,0,,Егер сіз Миджинмен аралассаңыз, сіз Live ➡ сияқты тағдырға тап боласыз
Dialogue: 0,0:09:05.60,0:09:07.98,Default,,0,0,0,,Бақылау қажет болуы мүмкін
Dialogue: 0,0:09:07.98,0:09:09.98,Default,,0,0,0,,Өміріңізді жоғалту…
Dialogue: 0,0:09:19.86,0:09:21.86,Default,,0,0,0,,《Сен шын айтасың ба?》
Dialogue: 0,0:09:24.78,0:09:28.54,Default,,0,0,0,,《Әкем қайтыс болып, мен мекемеге кірген соң➡
Dialogue: 0,0:09:28.54,0:09:30.54,Default,,0,0,0,,Ол үнемі мені көруге келетін》
Dialogue: 0,0:09:32.97,0:09:35.51,Default,,0,0,0,,《Университетке барар кезде компания ашу➡
Dialogue: 0,0:09:35.51,0:09:39.65,Default,,0,0,0,,Ұйықтап жатқанда да жомарт жұмыс істеу➡
Dialogue: 0,0:09:39.65,0:09:44.22,Default,,0,0,0,,Мені қабылдаған Микуру-санға➡
Dialogue: 0,0:09:44.22,0:09:46.52,Default,,0,0,0,,Уайымдауға шамам жоқ.
Dialogue: 0,0:09:49.67,0:09:51.67,Default,,0,0,0,,Әйтеуір, гала-концерт – өзіңді ерекше көрсетуге арналған.
Dialogue: 0,0:09:53.68,0:09:55.63,Default,,0,0,0,,Мен сізден тағы сұраймын.
Dialogue: 0,0:09:55.63,0:09:59.74,Default,,0,0,0,,Десе де, Миджинмен бір істі реттесеңіз ше?
Dialogue: 0,0:09:59.74,0:10:02.74,Default,,0,0,0,,Бірақ оны біреу тоқтатуы керек!
Dialogue: 0,0:10:14.62,0:10:17.70,Default,,0,0,0,,Осылай айтсаң, Куроно-кун➡
Dialogue: 0,0:10:17.70,0:10:19.70,Default,,0,0,0,,Бізге өз шешіміңізді көрсетіңіз!
Dialogue: 0,0:10:25.83,0:10:28.50,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:10:28.50,0:10:31.03,Default,,0,0,0,,ｸﾛﾉ･ﾄﾞﾗﾝ！
Dialogue: 0,0:10:31.03,0:10:34.83,Default,,0,0,0,,Кусаригама ниндзя онифундо!
Dialogue: 0,0:10:43.55,0:10:45.55,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:10:48.65,0:10:55.04,Default,,0,0,0,,Куроно-кун Сіз өзіңізді өзіңіз деп айта аласыз. 3 Куроно ұшағы бар→
Dialogue: 0,0:10:55.04,0:10:58.14,Default,,0,0,0,,Қалған карта сіздің қолыңызда да жоқ шығар.
Dialogue: 0,0:11:02.48,0:11:06.08,Default,,0,0,0,,Мен Chrono Джет суретін сала алмадым
Dialogue: 0,0:11:06.08,0:11:10.38,Default,,0,0,0,,Бұл даму сіздің екіұштылығыңызды білдірмейді ме?
Dialogue: 0,0:11:13.74,0:11:17.24,Default,,0,0,0,,Өзгеріс әкелетін Gear Eagle-ге мініңіз!
Dialogue: 0,0:11:19.51,0:11:21.48,Default,,0,0,0,,Миоджин➡-мен араласқанда
Dialogue: 0,0:11:21.48,0:11:24.34,Default,,0,0,0,,Әкемнің тағдыры маған да тап болуы мүмкін➡
Dialogue: 0,0:11:24.34,0:11:26.82,Default,,0,0,0,,Мұны қалай айта аласыз?
Dialogue: 0,0:11:26.82,0:11:29.29,Default,,0,0,0,,Куроно-кун Тікелей эфир➡
Dialogue: 0,0:11:29.29,0:11:31.61,Default,,0,0,0,,Оның апаттан қайтыс болғанын білесіз бе?
Dialogue: 0,0:11:31.61,0:11:33.61,Default,,0,0,0,,Иә
Dialogue: 0,0:11:33.61,0:11:37.70,Default,,0,0,0,,Апат болған кезде мен Мистер Live-де болдым...
Dialogue: 0,0:11:37.70,0:11:39.70,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:11:42.52,0:11:44.62,Default,,0,0,0,,Бұл Миджин Льюз болатын.
Dialogue: 0,0:11:49.04,0:11:52.64,Default,,0,0,0,,Миджин әкемнің жол апаты болған жерде!?
Dialogue: 0,0:13:34.67,0:13:38.05,Default,,0,0,0,,Апат болған кезде мен Лайв мырзамен бірге болдым➡
Dialogue: 0,0:13:38.05,0:13:40.31,Default,,0,0,0,,Бұл Миджин Льюз болатын.
Dialogue: 0,0:13:40.31,0:13:45.21,Default,,0,0,0,,Миджин... әкемнің жол апаты болған жерде!?
Dialogue: 0,0:13:45.21,0:13:47.98,Default,,0,0,0,,Лейб мырза жазатайым оқиғадан қайтыс болды.
Dialogue: 0,0:13:47.98,0:13:52.67,Default,,0,0,0,,Алайда шындықты оқиға орнында болған Миджин ғана біледі.
Dialogue: 0,0:13:52.67,0:13:57.14,Default,,0,0,0,,Егер Миджин өзіне қарсы шыққандарды жоюды шешсе➡
Dialogue: 0,0:13:57.14,0:14:01.78,Default,,0,0,0,,Екіленбейтін адам болсаң
Dialogue: 0,0:14:01.78,0:14:05.73,Default,,0,0,0,,Куроно-кунға қауіп төнсе, біртүрлі болар еді деп ойламайсың ба?
Dialogue: 0,0:14:05.73,0:14:07.73,Default,,0,0,0,,Куроно-кун жалғыз емес
Dialogue: 0,0:14:10.49,0:14:13.79,Default,,0,0,0,,Мен тіпті Микуру мырза екеніне сене алар емеспін...
Dialogue: 0,0:14:16.64,0:14:20.65,Default,,0,0,0,,Осыншама ойланып отырып дайындалдым ба деп ойлаймын➡
Dialogue: 0,0:14:20.65,0:14:22.65,Default,,0,0,0,,Мен тыңдадым!
Dialogue: 0,0:14:25.67,0:14:27.67,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:14:29.70,0:14:35.33,Default,,0,0,0,,《Мені әрқашан жылы құшақтап жүретін Микуру-сан...
Dialogue: 0,0:14:35.33,0:14:38.63,Default,,0,0,0,,Мен саған қауіп төндіруге жол бере алмаймын!!》
Dialogue: 0,0:14:43.70,0:14:45.70,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:14:48.87,0:14:53.17,Default,,0,0,0,,《Авангард: Мені өзгерткен нәрсе》
Dialogue: 0,0:14:55.33,0:14:57.38,Default,,0,0,0,,《Көп кездесулер➡
Dialogue: 0,0:14:57.38,0:15:00.38,Default,,0,0,0,,Маған да таптырмас достар сыйладың...》
Dialogue: 0,0:15:05.84,0:15:08.64,Default,,0,0,0,,《Мені бақылаған Микуру-сан...》
Dialogue: 0,0:15:14.67,0:15:19.59,Default,,0,0,0,,《Маған жол көрсеткен Вунгард...
Dialogue: 0,0:15:19.59,0:15:21.89,Default,,0,0,0,,Неліктен біреуін таңдау керек...》
Dialogue: 0,0:15:25.96,0:15:28.01,Default,,0,0,0,,ｸﾛﾉ…
Dialogue: 0,0:15:28.01,0:15:31.81,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:15:33.87,0:15:37.97,Default,,0,0,0,,Жасырын айдаһар Хомра шабуылшысы
Dialogue: 0,0:15:40.46,0:15:43.01,Default,,0,0,0,,Оның құдіретін қараңыз!
Dialogue: 0,0:15:43.01,0:15:45.63,Default,,0,0,0,,Homo Raider дағдылары!
Dialogue: 0,0:15:45.63,0:15:49.23,Default,,0,0,0,,Twin Drive болудың орнына дағдыларға ие болыңыз!!
Dialogue: 0,0:15:51.34,0:15:53.35,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:15:53.35,0:15:55.35,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ!!
Dialogue: 0,0:15:57.66,0:16:00.01,Default,,0,0,0,,ﾀﾞﾌﾞﾙｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:16:00.01,0:16:02.51,Default,,0,0,0,,Homo Raider-ге әсері
Dialogue: 0,0:16:05.98,0:16:08.97,Default,,0,0,0,,Қорқынышты ойлардан арылыңыз➡
Dialogue: 0,0:16:08.97,0:16:11.71,Default,,0,0,0,,Идеал әлем➡
Dialogue: 0,0:16:11.71,0:16:13.71,Default,,0,0,0,,Кесіңіз!
Dialogue: 0,0:16:16.49,0:16:18.50,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:16:18.50,0:16:22.03,Default,,0,0,0,,Зақым 5 Бірақ әлі біткен жоқ
Dialogue: 0,0:16:22.03,0:16:24.63,Default,,0,0,0,,Бұрын алған дағдыны іске қосыңыз
Dialogue: 0,0:16:26.62,0:16:29.21,Default,,0,0,0,,Қайтадан тұр, Хомра Райдер!
Dialogue: 0,0:16:29.21,0:16:31.71,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:16:33.70,0:16:35.70,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:16:38.83,0:16:40.83,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:16:52.20,0:16:54.20,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:16:56.13,0:16:58.54,Default,,0,0,0,,《Мен не істеуім керек...》
Dialogue: 0,0:16:58.54,0:17:00.54,Default,,0,0,0,,Менің ол жүзді көргім келмейді.
Dialogue: 0,0:17:02.47,0:17:04.49,Default,,0,0,0,,Микуру мырза?
Dialogue: 0,0:17:04.49,0:17:07.00,Default,,0,0,0,,Маған Авангардты ойнайтын Куроно ұнайды
Dialogue: 0,0:17:07.00,0:17:10.55,Default,,0,0,0,,Сондықтан мен сізге ұнайтын нәрсені жасауға рұқсат еткім келеді!
Dialogue: 0,0:17:10.55,0:17:14.49,Default,,0,0,0,,Бірақ мен сені уайымдап жүрмін.
Dialogue: 0,0:17:14.49,0:17:17.86,Default,,0,0,0,,Жақын адамының кенеттен жоғалып кеткен кездері көп болды.
Dialogue: 0,0:17:17.86,0:17:21.83,Default,,0,0,0,,Мен сенің араласқаныңды қаламаймын
Dialogue: 0,0:17:21.83,0:17:24.96,Default,,0,0,0,,Бірақ менің сүйікті Авангардпен➡
Dialogue: 0,0:17:24.96,0:17:27.96,Default,,0,0,0,,Сенің соншалықты мұңайғаныңды көргім келмейді.
Dialogue: 0,0:17:29.98,0:17:33.64,Default,,0,0,0,,Адасып қалдым... Адасып қалдым
Dialogue: 0,0:17:33.64,0:17:35.64,Default,,0,0,0,,Сондықтан мен оны естігім келеді!
Dialogue: 0,0:17:37.68,0:17:42.65,Default,,0,0,0,,Мен сенің шынайы сезімдеріңді білгім келеді
Dialogue: 0,0:17:42.65,0:17:46.75,Default,,0,0,0,,《Менің... шынайы сезімдерім》
Dialogue: 0,0:17:56.39,0:17:58.65,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:58.65,0:18:03.28,Default,,0,0,0,,Гррр… Уау!
Dialogue: 0,0:18:03.28,0:18:07.37,Default,,0,0,0,,Менің...
Dialogue: 0,0:18:07.37,0:18:10.97,Default,,0,0,0,,Мен сені бұлай етпеймін.
Dialogue: 0,0:18:12.94,0:18:17.68,Default,,0,0,0,,Балалар, сендер де менің достарымсыңдар.
Dialogue: 0,0:18:17.68,0:18:21.98,Default,,0,0,0,,Әрине мен!
Dialogue: 0,0:18:33.53,0:18:35.63,Default,,0,0,0,,Мистер Микл...
Dialogue: 0,0:18:38.64,0:18:41.32,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:41.32,0:18:45.73,Default,,0,0,0,,Жоқ... Мен Микуруды мұңайтқым келмейді.
Dialogue: 0,0:18:45.73,0:18:51.00,Default,,0,0,0,,Бірақ Авангард болмағанда мен Микл-санмен бетпе-бет келе алмас едім.
Dialogue: 0,0:18:51.00,0:18:54.04,Default,,0,0,0,,Саған арқамды бұру → дегенді білдіреді
Dialogue: 0,0:18:54.04,0:18:56.84,Default,,0,0,0,,Бұл Микуруға бет бұрумен бірдей!
Dialogue: 0,0:19:09.28,0:19:12.49,Default,,0,0,0,,Біреуін немесе екіншісін алуға болмайды.
Dialogue: 0,0:19:12.49,0:19:16.16,Default,,0,0,0,,Сондықтан мен екеуін де қорғаймын!
Dialogue: 0,0:19:16.16,0:19:20.16,Default,,0,0,0,,Отбасы және Авангард!
Dialogue: 0,0:19:23.50,0:19:26.47,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ
Dialogue: 0,0:19:26.47,0:19:30.20,Default,,0,0,0,,Қазір маған шынымен қалайтын әлемді көрсететін кез келді!
Dialogue: 0,0:19:30.20,0:19:33.80,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:19:35.78,0:19:43.33,Default,,0,0,0,,Уақыт-кеңістік айдаһар хроносмандының революциясы!
Dialogue: 0,0:19:43.33,0:19:45.84,Default,,0,0,0,,Жаңғыру дағдылары!
Dialogue: 0,0:19:45.84,0:19:49.16,Default,,0,0,0,,Барлық артқы қоршауларды палубаның түбіне жылжытыңыз
Dialogue: 0,0:19:49.16,0:19:52.46,Default,,0,0,0,,Бәрін жоққа айналдыр, бастамасын жарияла!
Dialogue: 0,0:19:54.56,0:19:59.00,Default,,0,0,0,,Сонымен қатар, палубаның астына Сағатқоршы Айдаһардың қадам жасау дағдысын қойыңыз.
Dialogue: 0,0:19:59.00,0:20:04.32,Default,,0,0,0,,Содан кейін палубадағы 10 картаға қарап, 2-ін қолыңызға салыңыз.
Dialogue: 0,0:20:04.32,0:20:06.81,Default,,0,0,0,,Палубаны араластырыңыз
Dialogue: 0,0:20:06.81,0:20:10.86,Default,,0,0,0,,Өзгеріске шақыратын екі Gear Eagles➡
Dialogue: 0,0:20:10.86,0:20:13.46,Default,,0,0,0,,Steam Maiden Call Melam
Dialogue: 0,0:20:18.64,0:20:21.99,Default,,0,0,0,,Сіз де лақтырмаңыз, екеуін де қорғаңыз
Dialogue: 0,0:20:21.99,0:20:25.68,Default,,0,0,0,,Қалай ойлайсыз, сіз осындай ыңғайлы нәрсені жасай аласыз ба?
Dialogue: 0,0:20:25.68,0:20:28.98,Default,,0,0,0,,Бұл сіздің қолыңыздан келетіні туралы емес. Бұл істеу туралы.
Dialogue: 0,0:20:31.17,0:20:33.50,Default,,0,0,0,,《Мен байқадым
Dialogue: 0,0:20:33.50,0:20:37.14,Default,,0,0,0,,Жүрегімді көрсететін айнасың➡
Dialogue: 0,0:20:37.14,0:20:39.64,Default,,0,0,0,,Өйткені бұл басқа мен》
Dialogue: 0,0:20:42.88,0:20:49.38,Default,,0,0,0,,Иә, Авангард - менмін.
Dialogue: 0,0:20:52.87,0:20:54.92,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:20:54.92,0:20:59.22,Default,,0,0,0,,ｸﾛﾉｽｺﾏﾝﾄﾞ･ﾚｳﾞｫﾘｭｰｼｮﾝ！
Dialogue: 0,0:21:06.12,0:21:08.65,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:21:08.65,0:21:12.79,Default,,0,0,0,,《30 000 күзетші. Барлығы 41000
Dialogue: 0,0:21:12.79,0:21:16.66,Default,,0,0,0,,Сіздің қолыңызда екі 10000 карта бар.
Dialogue: 0,0:21:16.66,0:21:20.16,Default,,0,0,0,,Куроно-кунның жеңуінің бір ғана жолы бар➡
Dialogue: 0,0:21:20.16,0:21:22.16,Default,,0,0,0,,Тек үштік триггер》
Dialogue: 0,0:21:24.17,0:21:26.67,Default,,0,0,0,,Олай болса, көрейін.
Dialogue: 0,0:21:26.67,0:21:28.77,Default,,0,0,0,,Өзіңізді дайындаңыз!
Dialogue: 0,0:21:34.86,0:21:36.86,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:21:40.80,0:21:42.84,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:21:42.84,0:21:45.44,Default,,0,0,0,,Қайта қарау үшін қуат плюс 5000
Dialogue: 0,0:21:45.44,0:21:47.71,Default,,0,0,0,,ｸﾘﾃｨｶﾙ ﾌﾟﾗｽ１
Dialogue: 0,0:21:47.71,0:21:49.71,Default,,0,0,0,,(Иида) Ол тіпті мұзды жұмсартатын әсерді де алып тастапты
Dialogue: 0,0:21:51.63,0:21:53.66,Default,,0,0,0,,ｸﾛﾉ…
Dialogue: 0,0:21:53.66,0:21:56.03,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:21:56.03,0:21:58.53,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:22:00.81,0:22:02.87,Default,,0,0,0,,ﾀﾞﾌﾞﾙ…
Dialogue: 0,0:22:02.87,0:22:05.37,Default,,0,0,0,,Барлығын қайта бағалау
Dialogue: 0,0:22:14.20,0:22:19.00,Default,,0,0,0,,《Бұл менің болашағым》
Dialogue: 0,0:22:26.00,0:22:28.00,Default,,0,0,0,,ｻｰﾄﾞﾁｪｯｸ
Dialogue: 0,0:22:43.05,0:22:45.05,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:22:46.98,0:22:50.00,Default,,0,0,0,,ﾄﾘﾌﾟﾙ…
Dialogue: 0,0:22:50.00,0:22:52.02,Default,,0,0,0,,Бұл жігіт те революцияға барады
Dialogue: 0,0:22:52.02,0:22:54.66,Default,,0,0,0,,Одан асып кетіңіз!
Dialogue: 0,0:22:54.66,0:22:58.01,Default,,0,0,0,,Сіз шынымен қалаған болашаққа!
Dialogue: 0,0:22:58.01,0:23:04.11,Default,,0,0,0,,Сублимация жарылысы!
Dialogue: 0,0:23:06.12,0:23:10.32,Default,,0,0,0,,Бұл біздікі➡
Dialogue: 0,0:23:10.32,0:23:14.20,Default,,0,0,0,,Бұл жан!
Dialogue: 0,0:23:14.20,0:23:23.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:23.92,0:23:27.34,Default,,0,0,0,,Бұл... Куроно-кундікі...
Dialogue: 0,0:23:27.34,0:23:44.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:48.10,0:23:52.10,Default,,0,0,0,,Мен саған көрсеттім, Куроно-кун.
Dialogue: 0,0:23:54.49,0:24:14.54,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:14.54,0:24:18.34,Default,,0,0,0,,Сенген жолмен жүр.
Dialogue: 0,0:24:20.54,0:24:22.54,Default,,0,0,0,,Рахмет, Микуру!
Dialogue: 0,0:24:26.63,0:24:29.13,Default,,0,0,0,,Сенің ағаң да солай айтатынына сенімдімін.
Dialogue: 0,0:24:32.54,0:24:36.54,Default,,0,0,0,,Мен Авангардпын...?
Dialogue: 0,0:24:38.48,0:24:41.03,Default,,0,0,0,,《Шин: Онда мен де➡
Dialogue: 0,0:24:41.03,0:24:45.13,Default,,0,0,0,,Біз оны қорғауға дайын болуымыз керек.
Dialogue: 0,0:24:50.46,0:24:55.55,Default,,0,0,0,,Сіздің ұмтылыстарыңыз дұрыс мұраланған сияқты➡
Dialogue: 0,0:24:55.55,0:24:57.55,Default,,0,0,0,,Live Master...
Dialogue: 0,0:25:00.45,0:25:04.62,Default,,0,0,0,,Төтенше жағдайда Микуру-санды маған қалдырыңыз.
Dialogue: 0,0:25:04.62,0:25:06.82,Default,,0,0,0,,Мен сені міндетті түрде қорғаймын.
Dialogue: 0,0:25:06.82,0:25:09.31,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:25:09.31,0:25:13.11,Default,,0,0,0,,Не болды? Сен не туралы айтып тұрсың?
Dialogue: 0,0:25:15.50,0:25:19.47,Default,,0,0,0,,Мен де ағамның не ойлағанын білмеймін.
Dialogue: 0,0:25:19.47,0:25:23.47,Default,,0,0,0,,Үйде жұмыс туралы көп сөйлеспейтінбіз...
Dialogue: 0,0:25:26.16,0:25:28.61,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:25:28.61,0:25:30.83,Default,,0,0,0,,Әкеңнің ниеті қандай?
Dialogue: 0,0:25:30.83,0:25:33.17,Default,,0,0,0,,Маған қалдырғанын білмеймін➡
Dialogue: 0,0:25:33.17,0:25:36.29,Default,,0,0,0,,Отбасымды және Авангардты қорғау үшін→
Dialogue: 0,0:25:36.29,0:25:39.16,Default,,0,0,0,,Осыны пайдаланыңыз
Dialogue: 0,0:25:39.16,0:25:41.29,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:25:41.29,0:25:44.53,Default,,0,0,0,,Қазір сол картаны ұстайтын адам ➡ белгісінен басқа ешкім емес
Dialogue: 0,0:25:44.53,0:25:46.63,Default,,0,0,0,,Өйткені бұл Куроно-кун.
Dialogue: 0,0:27:30.13,0:27:32.67,Default,,0,0,0,,Қазір де Курононың шешімін естігеннен кейін→
Dialogue: 0,0:27:32.67,0:27:36.64,Default,,0,0,0,,Мен үзілді-кесілді қарсымын
Dialogue: 0,0:27:36.64,0:27:38.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:27:38.63,0:27:44.32,Default,,0,0,0,,Куроно шешсе, мен оны тоқтатпаймын. Мен оны тоқтата алмаймын.
Dialogue: 0,0:27:44.32,0:27:47.97,Default,,0,0,0,,Авангард сол балаға арналған➡
Dialogue: 0,0:27:47.97,0:27:52.07,Default,,0,0,0,,Өйткені ол алмастырылмайтын...
Dialogue: 0,0:27:58.85,0:28:01.65,Default,,0,0,0,,Мен сені жек көремін, аға.
Dialogue: 0,0:30:33.63,0:30:35.60,Default,,0,0,0,,Суық қыс жалғасуда
Dialogue: 0,0:30:35.60,0:30:39.60,Default,,0,0,0,,Көшедегі адамдардан қыс мезгіліне тән уайымдары туралы сұрағанымызда,
Dialogue: 0,0:30:52.52,0:30:57.12,Default,,0,0,0,,Міне, сіз білетін, бірақ білмейтін қысқы тері күтімі бойынша бірнеше кеңестер...
Dialogue: 0,0:30:59.98,0:31:02.58,Default,,0,0,0,,Әрі қарай→
Dialogue: 0,0:31:04.08,0:31:10.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory