Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.85,0:01:06.56,Default,,0,0,0,,1-ші Мегаланика филиалының квесті
Dialogue: 0,0:01:06.56,0:01:11.48,Default,,0,0,0,,Турнирде керемет жеңіске жеткен және Арнайы Аква Күшіне қарсы шыққандар➡
Dialogue: 0,0:01:11.48,0:01:13.51,Default,,0,0,0,,ﾁｰﾑ ﾄﾗｲｽﾘｰ！
Dialogue: 0,0:01:13.51,0:01:16.30,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:01:16.30,0:01:19.90,Default,,0,0,0,,[Майк] Жауынгерлер арасында қызу шайқас жүріп жатыр!
Dialogue: 0,0:04:36.90,0:04:41.37,Default,,0,0,0,,Болашақты қолға алып, жеңіске жетелейтін, жаңа тағдырым
Dialogue: 0,0:04:41.37,0:04:44.41,Default,,0,0,0,,Дауылды билеуші, Савас командир!
Dialogue: 0,0:04:44.41,0:04:47.73,Default,,0,0,0,,Токоха Сіз дайынсыз ба? (Токоха) Жүр!
Dialogue: 0,0:04:47.73,0:04:49.73,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:04:52.13,0:04:54.23,Default,,0,0,0,,Скиросспен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:04:56.87,0:04:59.89,Default,,0,0,0,,Командир Савустың шеберлігі белсендіріледі!
Dialogue: 0,0:04:59.89,0:05:02.36,Default,,0,0,0,,Артқы қатарда Скиросспен шабуыл жасаңыз!
Dialogue: 0,0:05:02.36,0:05:04.86,Default,,0,0,0,,Артқы қатардан!!
Dialogue: 0,0:05:04.86,0:05:06.93,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:05:06.93,0:05:09.46,Default,,0,0,0,,Артқы қатардан күтпеген шабуыл!
Dialogue: 0,0:05:09.46,0:05:11.90,Default,,0,0,0,,Анжо ойыншысы үмітсіз күзетші!
Dialogue: 0,0:05:11.90,0:05:16.86,Default,,0,0,0,,Мен мұны істеймін, бірақ менің шабуылдарым жалғасады.
Dialogue: 0,0:05:16.86,0:05:20.54,Default,,0,0,0,,Командир Савуспен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:05:20.54,0:05:23.80,Default,,0,0,0,,Қадамда жүру шеберлігі Командир Савус шеберлігі!
Dialogue: 0,0:05:23.80,0:05:25.90,Default,,0,0,0,,Екі тыл сақшысы шегінді!
Dialogue: 0,0:05:29.37,0:05:31.92,Default,,0,0,0,,《Токоха: Дүниедегі химмен шайқас...
Dialogue: 0,0:05:31.92,0:05:34.71,Default,,0,0,0,,Егер сіз бұл хайпты жеңе алсаңыз➡
Dialogue: 0,0:05:34.71,0:05:38.64,Default,,0,0,0,,Сіз оны көре аласыз, оны түсінуіңіз мүмкін
Dialogue: 0,0:05:38.64,0:05:42.44,Default,,0,0,0,,Мен қалаған үлкен әлем!!》
Dialogue: 0,0:05:47.04,0:05:50.02,Default,,0,0,0,,[Майк] Міне, бұл G бірлігіне ➡ кіреді
Dialogue: 0,0:05:50.02,0:05:52.72,Default,,0,0,0,,Ойыншы Чен бірден шабуыл жасайды!
Dialogue: 0,0:05:52.72,0:05:55.82,Default,,0,0,0,,Подромоспен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:06:01.23,0:06:03.28,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:06:03.28,0:06:06.69,Default,,0,0,0,,Heal Trigger зақымдалуы 1 қалпына келтіру
Dialogue: 0,0:06:06.69,0:06:09.07,Default,,0,0,0,,Қуат Толқынға түседі
Dialogue: 0,0:06:09.07,0:06:11.09,Default,,0,0,0,,Жарайсың, Шарлин!
Dialogue: 0,0:06:11.09,0:06:13.86,Default,,0,0,0,,Подромос дағдылары
Dialogue: 0,0:06:13.86,0:06:19.38,Default,,0,0,0,,Палубадан 5 картаға қарап, Генобий мен Одиссейді шақырыңыз!
Dialogue: 0,0:06:19.38,0:06:21.38,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:06:23.44,0:06:25.74,Default,,0,0,0,,ﾀｲﾀﾞﾙ･ｱｻﾙﾄ！ (ｼｵﾝ)ｲﾝﾀｰｾﾌﾟﾄ！
Dialogue: 0,0:06:28.19,0:06:32.25,Default,,0,0,0,,[Майк] Киба Авангардтың шабуылына тосқауыл қоя білді!
Dialogue: 0,0:06:32.25,0:06:34.85,Default,,0,0,0,,Бірақ әлі біткен жоқ
Dialogue: 0,0:06:34.85,0:06:39.25,Default,,0,0,0,,Дәл осылай, Tidal дағдысы іске қосылды!
Dialogue: 0,0:06:39.25,0:06:42.74,Default,,0,0,0,,Авангардқа қайтадан шабуыл жасаңыз!
Dialogue: 0,0:06:42.74,0:06:52.78,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:52.78,0:06:54.84,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:06:54.84,0:07:01.19,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:01.19,0:07:03.19,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:07:03.19,0:07:05.23,Default,,0,0,0,,Фойверс шеберлігін белсендіру
Dialogue: 0,0:07:05.23,0:07:07.20,Default,,0,0,0,,ｽﾀﾝﾄﾞ
Dialogue: 0,0:07:07.20,0:07:10.00,Default,,0,0,0,,Көбірек қуат плюс 2000. Шабуыл!
Dialogue: 0,0:07:12.90,0:07:17.04,Default,,0,0,0,,Шешілді! Aqua Force үздіксіз шабуылдары!!
Dialogue: 0,0:07:17.04,0:07:19.56,Default,,0,0,0,,Бұл қызықты, филиал басшысы.
Dialogue: 0,0:07:19.56,0:07:24.53,Default,,0,0,0,,Күтілгендей, Дредноут пен Хайме Алькарастың бірігуі дұрыс жауап болды.
Dialogue: 0,0:07:24.53,0:07:26.90,Default,,0,0,0,,Ынтымақтастық - ең жақсы!
Dialogue: 0,0:07:26.90,0:07:28.90,Default,,0,0,0,,ｽﾍﾟｼｬﾙﾁｰﾑ ｲｪｲ!!
Dialogue: 0,0:07:42.02,0:07:44.54,Default,,0,0,0,,《Луна: Бәрің қолыңнан келгеннің бәрін жасаңдар...》
Dialogue: 0,0:07:44.54,0:07:46.55,Default,,0,0,0,,≪Луна-чан, мына жаққа қарашы.
Dialogue: 0,0:07:46.55,0:07:48.59,Default,,0,0,0,,Иә
Dialogue: 0,0:07:48.59,0:07:52.89,Default,,0,0,0,,4 айналымнан кейін зақымдану 3-тен 1-ге тең
Dialogue: 0,0:07:52.89,0:07:56.36,Default,,0,0,0,,Сорю аздап артықшылығы бар!
Dialogue: 0,0:07:56.36,0:07:58.37,Default,,0,0,0,,Синдо Куроно→
Dialogue: 0,0:07:58.37,0:08:01.74,Default,,0,0,0,,Желдің нұсқауымен кездессем➡
Dialogue: 0,0:08:01.74,0:08:06.12,Default,,0,0,0,,Қазір менің алдымда тұрған адам да солай.
Dialogue: 0,0:08:06.12,0:08:08.24,Default,,0,0,0,,Олай болса, көрейін→
Dialogue: 0,0:08:08.24,0:08:10.20,Default,,0,0,0,,Сіздің авангардыңыз
Dialogue: 0,0:08:10.20,0:08:13.36,Default,,0,0,0,,Айтудың қажеті жоқ, Мініңіз!!
Dialogue: 0,0:08:13.36,0:08:16.43,Default,,0,0,0,,ｸﾛﾉｼﾞｪｯﾄ･ﾄﾞﾗｺﾞﾝ!!
Dialogue: 0,0:08:16.43,0:08:19.03,Default,,0,0,0,,ｺｰﾙ ｱﾀｯｸ！
Dialogue: 0,0:08:22.52,0:08:25.63,Default,,0,0,0,,ｸﾛﾉｼﾞｪｯﾄ ﾂｲﾝﾄﾞﾗｲﾌﾞ!!
Dialogue: 0,0:08:25.63,0:08:27.73,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:08:30.18,0:08:33.35,Default,,0,0,0,,ﾊﾞﾘﾌ！ (ﾚｵﾝ)ｶﾞｰﾄﾞ
Dialogue: 0,0:08:33.35,0:08:35.87,Default,,0,0,0,,Синдоның керемет шабуылы!
Dialogue: 0,0:08:35.87,0:08:39.19,Default,,0,0,0,,Бірақ Мастер Леон да бірден қарсы шабуылға шығады.
Dialogue: 0,0:08:39.19,0:08:43.11,Default,,0,0,0,,Қаһарлы жел, ойымды күшке айналдыр➡
Dialogue: 0,0:08:43.11,0:08:45.11,Default,,0,0,0,,Көк айдаһар бол!
Dialogue: 0,0:08:45.11,0:08:47.07,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:08:47.07,0:08:50.54,Default,,0,0,0,,Көк толқынды айдаһар Ашулан Айдаһар!
Dialogue: 0,0:08:50.54,0:08:53.34,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:08:55.54,0:09:00.18,Default,,0,0,0,,Теңіз генералы Тидалбоар Айдаһар!
Dialogue: 0,0:09:00.18,0:09:02.18,Default,,0,0,0,,Никиге қоңырау шалыңыз
Dialogue: 0,0:09:02.18,0:09:05.52,Default,,0,0,0,,Magnum Assault көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:09:05.52,0:09:07.52,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:09:07.52,0:09:09.57,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:09:09.57,0:09:11.51,Default,,0,0,0,,Magnum тұғыры
Dialogue: 0,0:09:11.51,0:09:14.24,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:09:14.24,0:09:18.70,Default,,0,0,0,,Менің әскерімнің жолын алып зеңбірекпен аш!
Dialogue: 0,0:09:18.70,0:09:20.80,Default,,0,0,0,,ｷﾞｶﾞﾝﾃｨｯｸﾊﾞｰｽﾄ！
Dialogue: 0,0:09:25.90,0:09:27.86,Default,,0,0,0,,Жел әлі тоқтаған жоқ
Dialogue: 0,0:09:27.86,0:09:29.86,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:09:29.86,0:09:32.93,Default,,0,0,0,,Tetradrive Dragon жоғары қоңырау
Dialogue: 0,0:09:32.93,0:09:36.20,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:09:36.20,0:09:39.23,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:09:39.23,0:09:43.19,Default,,0,0,0,,Мастер Леонның 4 рет қатарынан шабуылы!
Dialogue: 0,0:09:43.19,0:09:45.52,Default,,0,0,0,,《Уау, әсерлі
Dialogue: 0,0:09:45.52,0:09:47.56,Default,,0,0,0,,Қандай күшті бейне!
Dialogue: 0,0:09:47.56,0:09:50.95,Default,,0,0,0,,Осындай ғажап адаммен күресе білу...》
Dialogue: 0,0:09:50.95,0:09:53.55,Default,,0,0,0,,Бұл ең жақсы, G Quest!
Dialogue: 0,0:09:55.57,0:09:58.87,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:09:58.87,0:10:03.39,Default,,0,0,0,,Кеңістік-уақыт жануары Metallica Phoenix!
Dialogue: 0,0:10:03.39,0:10:05.86,Default,,0,0,0,,Мен оған қазір барымды беремін
Dialogue: 0,0:10:05.86,0:10:08.03,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:10:08.03,0:10:10.18,Default,,0,0,0,,Magnum Assault-ты палубаның төменгі жағына қойыңыз!
Dialogue: 0,0:10:10.18,0:10:14.20,Default,,0,0,0,,Metallica Phoenix көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:10:14.20,0:10:16.25,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:10:16.25,0:10:18.71,Default,,0,0,0,,Уақыт секірісі Куроно Дран Келіңіздер!
Dialogue: 0,0:10:18.71,0:10:21.36,Default,,0,0,0,,ｽﾁｰﾑｽｶﾗｰ ｼﾞｼﾞ！
Dialogue: 0,0:10:21.36,0:10:23.41,Default,,0,0,0,,Джиджидің шеберлігі!
Dialogue: 0,0:10:23.41,0:10:25.35,Default,,0,0,0,,Палубадан 1 картаны сал
Dialogue: 0,0:10:25.35,0:10:27.73,Default,,0,0,0,,Сонымен қатар, Хроно Доранның шеберлігі
Dialogue: 0,0:10:27.73,0:10:31.62,Default,,0,0,0,,Chronojet Dragon керемет қоңырауы!
Dialogue: 0,0:10:31.62,0:10:34.02,Default,,0,0,0,,Ой, Куроно Доран➡
Dialogue: 0,0:10:34.02,0:10:38.56,Default,,0,0,0,,Болашақ көрінісі Chronojet ретінде далада пайда болды!
Dialogue: 0,0:10:38.56,0:10:41.71,Default,,0,0,0,,Өшпес құдірет, Тағдырыңды нұрландыратын нұр!
Dialogue: 0,0:10:41.71,0:10:45.71,Default,,0,0,0,,Қараңғылықты кесіп, Жарық қанаттарын!
Dialogue: 0,0:10:54.31,0:10:56.19,Default,,0,0,0,,Балифуды жалғастырыңыз!
Dialogue: 0,0:10:56.19,0:10:58.23,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:10:58.23,0:11:01.20,Default,,0,0,0,,Өтінемін, Chrono Джет
Dialogue: 0,0:11:01.20,0:11:03.20,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:11:03.20,0:11:05.77,Default,,0,0,0,,(ﾚｵﾝ)ｶﾞｰﾄﾞ！ ｸｯ…
Dialogue: 0,0:11:05.77,0:11:07.77,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:11:11.29,0:11:15.06,Default,,0,0,0,,Қорықпа, селт етпе, күлуді ұмытпа
Dialogue: 0,0:11:15.06,0:11:17.98,Default,,0,0,0,,Синдо спортшысы, оның сыртқы түрі дәл →
Dialogue: 0,0:11:17.98,0:11:21.08,Default,,0,0,0,,Күш-қуаты бар жас сайыскер!
Dialogue: 0,0:11:23.09,0:11:28.36,Default,,0,0,0,,《Әрине... Мойындаймын, ол қызу күрескер.
Dialogue: 0,0:11:28.36,0:11:33.56,Default,,0,0,0,,Бірақ ол жай ғана жанды және абайсыз күрескер.
Dialogue: 0,0:11:33.56,0:11:36.48,Default,,0,0,0,,Сол дәрежеде...》
Dialogue: 0,0:11:36.48,0:11:38.78,Default,,0,0,0,,Генерация аймағы шығарылды!
Dialogue: 0,0:11:42.72,0:11:46.13,Default,,0,0,0,,Ойымды айт, жел
Dialogue: 0,0:11:46.13,0:11:49.73,Default,,0,0,0,,Жел, менің тағдырымды бағытта!
Dialogue: 0,0:11:49.73,0:11:53.83,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:12:02.51,0:12:06.51,Default,,0,0,0,,Көк толқынды айдаһар Тетрабойл айдаһар!
Dialogue: 0,0:12:10.15,0:12:12.95,Default,,0,0,0,,ﾃﾄﾗﾎﾞｲﾙ･ﾄﾞﾗｺﾞﾝ…
Dialogue: 0,0:14:00.90,0:14:03.97,Default,,0,0,0,,Хайуанаттар бағы филиалының сахнасын да жандандырыңыз.
Dialogue: 0,0:14:03.97,0:14:05.97,Default,,0,0,0,,Иә. Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:14:09.22,0:14:12.71,Default,,0,0,0,,Соңына дейін көргім келді.
Dialogue: 0,0:14:12.71,0:14:15.19,Default,,0,0,0,,Иә, екеуің де асығыңыздар.
Dialogue: 0,0:14:15.19,0:14:17.19,Default,,0,0,0,,Иә
Dialogue: 0,0:14:22.35,0:14:24.45,Default,,0,0,0,,Таза көз
Dialogue: 0,0:14:29.44,0:14:35.20,Default,,0,0,0,,[Майк] AquaForce-тің ең күшті G құрылғысы қазір осында!
Dialogue: 0,0:14:35.20,0:14:37.20,Default,,0,0,0,,Жел 5 рет соғады
Dialogue: 0,0:14:37.20,0:14:39.75,Default,,0,0,0,,Және Aquaforth-тың жаңа күші➡
Dialogue: 0,0:14:39.75,0:14:43.37,Default,,0,0,0,,Толқын сізге шабуыл жасайды. Толқын?
Dialogue: 0,0:14:43.37,0:14:48.19,Default,,0,0,0,,Шинду Куроно, мен саған Аквафорттың мәнін көрсетемін.
Dialogue: 0,0:14:48.19,0:14:50.54,Default,,0,0,0,,Егер алға жылжу керек болса→
Dialogue: 0,0:14:50.54,0:14:53.35,Default,,0,0,0,,Маған бұл сынақты жеңе алатыныңызды көрсетіңіз.
Dialogue: 0,0:14:53.35,0:14:55.38,Default,,0,0,0,,Сол қылмыскер... қайтыс болды ма?
Dialogue: 0,0:14:55.38,0:14:59.18,Default,,0,0,0,,Ангарбойл айдаһарының қадам жасау шеберлігін белсендіру
Dialogue: 0,0:15:02.19,0:15:04.19,Default,,0,0,0,,ｺｰﾙ
Dialogue: 0,0:15:04.19,0:15:08.86,Default,,0,0,0,,Daggermaster Dracokit to Soul дағдысын белсендіру
Dialogue: 0,0:15:08.86,0:15:14.05,Default,,0,0,0,,Алдымен, Tetra Drive Dragon көмегімен шабуыл жасаңыз!
Dialogue: 0,0:15:14.05,0:15:16.69,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:15:16.69,0:15:24.03,Default,,0,0,0,,Бұл екінші рет, Tetraboil Dragon көмегімен Авангардқа шабуыл жасау.
Dialogue: 0,0:15:24.03,0:15:26.73,Default,,0,0,0,,Екінші жел толқындар шығарады.
Dialogue: 0,0:15:26.73,0:15:30.37,Default,,0,0,0,,2-толқын Tetra Drive дөңгелегі тірегі
Dialogue: 0,0:15:30.37,0:15:33.40,Default,,0,0,0,,ﾊﾟﾜｰ ﾌﾟﾗｽ3000
Dialogue: 0,0:15:33.40,0:15:35.34,Default,,0,0,0,,Және сурет салу
Dialogue: 0,0:15:35.34,0:15:38.86,Default,,0,0,0,,Күшті әсер белгілі бір шабуылдар саны кезінде беріледі➡
Dialogue: 0,0:15:38.86,0:15:42.20,Default,,0,0,0,,Бұл толқын. Желден туындаған толқындар➡
Dialogue: 0,0:15:42.20,0:15:45.35,Default,,0,0,0,,Жаңа ойыншыларды азаптаңыз!
Dialogue: 0,0:15:45.35,0:15:48.40,Default,,0,0,0,,Шеберлікпен қос жетек!!
Dialogue: 0,0:15:48.40,0:15:51.02,Default,,0,0,0,,Қазір туылған құтырған толқындар➡
Dialogue: 0,0:15:51.02,0:15:53.22,Default,,0,0,0,,Ол сізге шабуыл жасайды.
Dialogue: 0,0:15:53.22,0:15:56.64,Default,,0,0,0,,[Майк] Ой, менде тағы бір толқын пайда болды.
Dialogue: 0,0:15:56.64,0:16:00.18,Default,,0,0,0,,《Тағдыры қызық аквафорт
Dialogue: 0,0:16:00.18,0:16:06.57,Default,,0,0,0,,Менің естуімше, Gear Chronicle - бұл ерекше тағдыры бар клан.
Dialogue: 0,0:16:06.57,0:16:09.52,Default,,0,0,0,,Оның пайдаланушысы, Шинду Куроно
Dialogue: 0,0:16:09.52,0:16:13.74,Default,,0,0,0,,Сіз сынаққа төтеп бере аласыз ба? 》
Dialogue: 0,0:16:13.74,0:16:16.11,Default,,0,0,0,,Көк толқындардан айдаһар➡
Dialogue: 0,0:16:16.11,0:16:20.52,Default,,0,0,0,,Менің алдымда тұрғандарға қатаң үкім шығар!
Dialogue: 0,0:16:20.52,0:16:23.07,Default,,0,0,0,,ｱﾙﾃｨﾒｯﾄ･ｴｸｽﾌﾟﾛｰｼｮﾝ！
Dialogue: 0,0:16:23.07,0:16:26.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:26.84,0:16:30.90,Default,,0,0,0,,[Майк] Зақым 5 Әлі 3 градустық жел қалды.
Dialogue: 0,0:16:30.90,0:16:34.70,Default,,0,0,0,,[Майк] Синдо ойыншысы, бұл сөзсіз жойылады!
Dialogue: 0,0:16:34.70,0:16:39.19,Default,,0,0,0,,[Майк] Соңғы жекпе-жек шебері Леон жаңа ойыншының алдында➡
Dialogue: 0,0:16:39.19,0:16:42.57,Default,,0,0,0,,Үлкен қабырға болып тұру
Dialogue: 0,0:16:42.57,0:16:46.54,Default,,0,0,0,,《Бұл AquaForce шыңында тұрған адамның күші.
Dialogue: 0,0:16:46.54,0:16:49.90,Default,,0,0,0,,Бұл G квесті
Dialogue: 0,0:16:49.90,0:16:53.37,Default,,0,0,0,,Біз жеңе аламыз ба? осы адамға
Dialogue: 0,0:16:53.37,0:16:56.35,Default,,0,0,0,,Сіз бұл қабырғаны жеңе аласыз ба?
Dialogue: 0,0:16:56.35,0:16:59.57,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:59.57,0:17:02.43,Default,,0,0,0,,《Қарғыс атсын! Мен неге сонша әлсізмін? 》
Dialogue: 0,0:17:02.43,0:17:06.21,Default,,0,0,0,,((Арманыңыз болса, биік мақсат қоймасаңыз➡
Dialogue: 0,0:17:06.21,0:17:09.85,Default,,0,0,0,,Мен сенімен күресу үшін өз жолымнан шығудың қажеті жоқ.
Dialogue: 0,0:17:09.85,0:17:13.35,Default,,0,0,0,,Сізді алда не күтіп тұр? ))
Dialogue: 0,0:17:13.35,0:17:18.34,Default,,0,0,0,,《Шынымды айтсам, мен болашақта не күтіп тұрғанын білмеймін.
Dialogue: 0,0:17:18.34,0:17:20.90,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:20.90,0:17:23.56,Default,,0,0,0,,Осы сәттен тыс болашақ бар
Dialogue: 0,0:17:23.56,0:17:28.69,Default,,0,0,0,,Сондықтан мен қазір менің алдымда тұрған нәрсеге бар күшімді салып жатырмын.
Dialogue: 0,0:17:28.69,0:17:32.69,Default,,0,0,0,,Бұл үшінші жел! Tetra Drive көмегімен шабуыл жасаңыз!
Dialogue: 0,0:17:32.69,0:17:36.24,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:17:36.24,0:17:38.85,Default,,0,0,0,,Төртінші рет!
Dialogue: 0,0:17:38.85,0:17:41.20,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:17:41.20,0:17:44.54,Default,,0,0,0,,Жаңа ойыншы Триггердің қуаты плюс➡
Dialogue: 0,0:17:44.54,0:17:47.59,Default,,0,0,0,,Мен төртінші шабуылға тосқауыл қоя алдым.
Dialogue: 0,0:17:47.59,0:17:50.91,Default,,0,0,0,,Төртінші жел құтырған толқындарды көтереді➡
Dialogue: 0,0:17:50.91,0:17:55.81,Default,,0,0,0,,Айдаһар толқынын шақыру 4
Dialogue: 0,0:17:55.81,0:17:59.92,Default,,0,0,0,,Мұрагерлік жан – мақтанышым, күшім
Dialogue: 0,0:17:59.92,0:18:03.69,Default,,0,0,0,,Көк толқындардан қайта кел!
Dialogue: 0,0:18:03.69,0:18:07.69,Default,,0,0,0,,ﾃﾄﾗﾎﾞｲﾙ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:18:07.69,0:18:10.39,Default,,0,0,0,,Енді «Авангард» стендке айналды.
Dialogue: 0,0:18:10.39,0:18:13.85,Default,,0,0,0,,[Майк] Бұл AquaForce, одақтастың күші!
Dialogue: 0,0:18:13.85,0:18:18.44,Default,,0,0,0,,[Майк] Бұл Көк Айдаһар Леон жас қарсыласқа беретін тамаша сынақ!
Dialogue: 0,0:18:18.44,0:18:21.71,Default,,0,0,0,,Есіңізде болсын, соңғы жел – боран.
Dialogue: 0,0:18:21.71,0:18:25.19,Default,,0,0,0,,Tetraboil Dragon көмегімен Авангардқа шабуыл жасаңыз
Dialogue: 0,0:18:25.19,0:18:29.73,Default,,0,0,0,,ｳｪｰﾌﾞ５ ｸﾘﾃｨｶﾙﾌﾟﾗｽ１
Dialogue: 0,0:18:29.73,0:18:33.03,Default,,0,0,0,,[Майк] Сіздің қолыңызда 2 карта қалды. Оның алдын ала аласыз ба!?
Dialogue: 0,0:18:33.03,0:18:35.72,Default,,0,0,0,,ｱﾙﾃｨﾒｯﾄ･ﾚﾎﾞﾘｭｰｼｮﾝ！
Dialogue: 0,0:18:35.72,0:18:46.28,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:46.28,0:18:48.35,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:18:48.35,0:18:51.02,Default,,0,0,0,,[Майк] Синдо оны қорғай алды!
Dialogue: 0,0:18:51.02,0:18:54.41,Default,,0,0,0,,<<Мына жігіт керемет! ≪Триггер мені құтқарды.
Dialogue: 0,0:18:54.41,0:18:59.08,Default,,0,0,0,,≪Сіздің қолыңызда нөлдік карта бар, солай ма? Мен келесі бұрылыста жүре алмаймын деп ойлаймын?
Dialogue: 0,0:18:59.08,0:19:02.20,Default,,0,0,0,,≪Көк айдаһар Леонды жеңу мүмкін емес
Dialogue: 0,0:19:02.20,0:19:05.12,Default,,0,0,0,,Жарайсыңдар, 5 градустық желге төтеп бердіңдер.
Dialogue: 0,0:19:05.12,0:19:07.07,Default,,0,0,0,,Сізді ұрыңыз→
Dialogue: 0,0:19:07.07,0:19:09.02,Default,,0,0,0,,Мен алға жылжамын!
Dialogue: 0,0:19:09.02,0:19:12.89,Default,,0,0,0,,9-кезекке кіру! Зақым 5-тен 4-ке дейін
Dialogue: 0,0:19:12.89,0:19:16.19,Default,,0,0,0,,Қолында нөлдік карталары бар жаңа ойыншымен не болады?
Dialogue: 0,0:19:21.37,0:19:24.19,Default,,0,0,0,,Кеттік! Мастер Леон!!
Dialogue: 0,0:19:24.19,0:19:27.22,Default,,0,0,0,,[Майк] Міне, келдік! Бұл 3-сынып!!
Dialogue: 0,0:19:27.22,0:19:29.52,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:19:31.74,0:19:35.88,Default,,0,0,0,,ｸﾛﾉﾄﾞﾗｺﾞﾝ･ﾈｸｽﾃｰｼﾞ！
Dialogue: 0,0:19:35.88,0:19:38.27,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ!!
Dialogue: 0,0:19:38.27,0:19:41.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:41.92,0:19:46.46,Default,,0,0,0,,Кеңістік пен уақытты кесіп өтіңіз және оны тағдырдың жазуынан тыс жойыңыз!
Dialogue: 0,0:19:46.46,0:19:49.41,Default,,0,0,0,,Жеңіліссіз!!
Dialogue: 0,0:19:49.41,0:19:59.45,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:59.45,0:20:02.04,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:20:02.04,0:20:04.19,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:20:04.19,0:20:06.19,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:20:06.19,0:20:08.23,Default,,0,0,0,,Барлық әсерлер кедергіде.
Dialogue: 0,0:20:08.23,0:20:10.20,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:20:10.20,0:20:12.23,Default,,0,0,0,,Nexus кезеңі шеберлігін белсендіру!!
Dialogue: 0,0:20:12.23,0:20:15.33,Default,,0,0,0,,Hearts' Chronojet Dragon-ды Авангардқа әкеліңіз!
Dialogue: 0,0:20:18.86,0:20:22.51,Default,,0,0,0,,《Күшті бейне күші және табиғи сәттілік...
Dialogue: 0,0:20:22.51,0:20:26.23,Default,,0,0,0,,Ең бастысы, ол көрермендерді баурап алады➡
Dialogue: 0,0:20:26.23,0:20:28.70,Default,,0,0,0,,Қызықтыратын жекпе-жек...》
Dialogue: 0,0:20:28.70,0:20:32.74,Default,,0,0,0,,Түсіндім, бұл сенің желің.
Dialogue: 0,0:20:32.74,0:20:35.26,Default,,0,0,0,,Мен болашақты білмеймін, бірақ➡
Dialogue: 0,0:20:35.26,0:20:38.34,Default,,0,0,0,,Енді менімен күресетін достарым бар.
Dialogue: 0,0:20:38.34,0:20:43.43,Default,,0,0,0,,Шион... Токоха... Джиакроның бірліктері
Dialogue: 0,0:20:43.43,0:20:47.03,Default,,0,0,0,,Барлығымен бірге күресіп, онымен күресіңіз➡
Dialogue: 0,0:20:47.03,0:20:50.60,Default,,0,0,0,,Мен G Quest-ті міндетті түрде жеңемін!
Dialogue: 0,0:20:50.60,0:20:53.86,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝﾌﾞﾚｲｸ！ ﾊﾟﾜｰﾌﾟﾗｽ5000
Dialogue: 0,0:20:53.86,0:20:57.24,Default,,0,0,0,,Ал 1 және одан жоғары сыныптар күзетілмейді!
Dialogue: 0,0:20:57.24,0:20:59.85,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:20:59.85,0:21:03.87,Default,,0,0,0,,0-сыныпта күзет! Барлығы 21000
Dialogue: 0,0:21:03.87,0:21:07.25,Default,,0,0,0,,Рианың шабуылдарын тамаша күзетпен тоқтатуға болады.
Dialogue: 0,0:21:07.25,0:21:09.64,Default,,0,0,0,,Жеңіске жетудің жалғыз жолы - осында шешім қабылдау!
Dialogue: 0,0:21:09.64,0:21:12.44,Default,,0,0,0,,Осы жігітке бәс тігу! Қос диск!!
Dialogue: 0,0:21:16.76,0:21:19.80,Default,,0,0,0,,Жүгіріп өт! Біз ашамыз →
Dialogue: 0,0:21:19.80,0:21:21.69,Default,,0,0,0,,Жаңа әлемге!!
Dialogue: 0,0:21:21.69,0:21:26.09,Default,,0,0,0,,Гейл жанының шабуылы қатарынан соққы үзіліс!
Dialogue: 0,0:21:26.09,0:21:36.53,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:36.53,0:21:39.44,Default,,0,0,0,,[Майк] Жеңімпаз Синдо Куроно!
Dialogue: 0,0:21:39.44,0:21:43.37,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:21:43.37,0:21:46.97,Default,,0,0,0,,Уф... жақсы жел.
Dialogue: 0,0:21:50.36,0:21:54.52,Default,,0,0,0,,《Егер ол келесі айналымға шығарылса, жеңу мүмкіндігі жоқ...
Dialogue: 0,0:21:54.52,0:21:56.52,Default,,0,0,0,,Осы кезекті шешіңіз! 》
Dialogue: 0,0:21:56.52,0:21:59.44,Default,,0,0,0,,Жүрекке Китар!
Dialogue: 0,0:21:59.44,0:22:02.74,Default,,0,0,0,,Токоха, мен де бар күшіммен қабылдаймын!!
Dialogue: 0,0:22:04.86,0:22:06.91,Default,,0,0,0,,Гладиолуспен шабуыл!
Dialogue: 0,0:22:06.91,0:22:09.03,Default,,0,0,0,,ｶﾞｰﾄﾞ！ ｲﾝﾀｰｾﾌﾟﾄ!!
Dialogue: 0,0:22:09.03,0:22:11.07,Default,,0,0,0,,Мен білгім келеді...
Dialogue: 0,0:22:11.07,0:22:13.52,Default,,0,0,0,,Болашақтағы үлкен әлем
Dialogue: 0,0:22:13.52,0:22:18.38,Default,,0,0,0,,Сондықтан сіз міндетті түрде жеңесіз!!
Dialogue: 0,0:22:18.38,0:22:20.68,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ！ ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:22:22.76,0:22:26.05,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:22:30.45,0:22:34.25,Default,,0,0,0,,Жүрек тебіренді, Токоханың байсалдылығы
Dialogue: 0,0:22:38.16,0:22:40.66,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:22:42.87,0:22:46.05,Default,,0,0,0,,Оның күші тым көп және оны қорғауға болмайды.
Dialogue: 0,0:22:46.05,0:22:49.17,Default,,0,0,0,,Жыламаңыз!
Dialogue: 0,0:22:49.17,0:22:51.69,Default,,0,0,0,,《Леон-самаға ұқсас бір жерде→
Dialogue: 0,0:22:51.69,0:22:53.73,Default,,0,0,0,,Күшті ерік-жігерді сезіну
Dialogue: 0,0:22:53.73,0:22:56.70,Default,,0,0,0,,Бір нәрсені арқасына көтеріп жүргендей》
Dialogue: 0,0:22:56.70,0:22:59.57,Default,,0,0,0,,Мен өз мүмкіндігіме сенемін!
Dialogue: 0,0:22:59.57,0:23:03.67,Default,,0,0,0,,Ал мен қалаған болашақты ұстаймын!
Dialogue: 0,0:23:03.67,0:23:06.41,Default,,0,0,0,,Hiten no Holy Knight Altomail →
Dialogue: 0,0:23:06.41,0:23:08.41,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:23:10.86,0:23:13.01,Default,,0,0,0,,[Майк] (Гуки) 3 жарыста 3 жеңіс!
Dialogue: 0,0:23:13.01,0:23:15.68,Default,,0,0,0,,[Майк] (Гуки) командасы үш-үштік толық жеңіс!
Dialogue: 0,0:23:15.68,0:23:17.87,Default,,0,0,0,,<<Мына жігіттер керемет!
Dialogue: 0,0:23:17.87,0:23:22.39,Default,,0,0,0,,≪Ол Юна-санды басып тастады деген қауесет ақиқат еді.
Dialogue: 0,0:23:22.39,0:23:24.37,Default,,0,0,0,,≪Үшеуін жақсы көріңіз!
Dialogue: 0,0:23:24.37,0:23:27.18,Default,,0,0,0,,Ғажайып жаңадан келген адам пайда болды.
Dialogue: 0,0:23:27.18,0:23:30.01,Default,,0,0,0,,Мен Special Aquaforce жеңіледі деп ешқашан күтпедім...
Dialogue: 0,0:23:30.01,0:23:32.60,Default,,0,0,0,,Бұл жақсы емес пе? Бұл тамаша
Dialogue: 0,0:23:32.60,0:23:37.60,Default,,0,0,0,,Үшеуін қолданып көріңіз, ең жақсы G квестімен үзілмеңіз!
Dialogue: 0,0:23:39.57,0:23:42.18,Default,,0,0,0,,Кешіріңіз, Леон, мен жеңілдім.
Dialogue: 0,0:23:42.18,0:23:47.40,Default,,0,0,0,,Уайымдама, олардың желін көрсең болды.
Dialogue: 0,0:23:47.40,0:23:50.52,Default,,0,0,0,,Токоханың байыптылығы таң қалдырды.
Dialogue: 0,0:23:50.52,0:23:54.52,Default,,0,0,0,,Шион Киба да жақсы күресуші еді. Иә иә
Dialogue: 0,0:23:54.52,0:23:57.59,Default,,0,0,0,,Маған досым соғысқа қатысуды өтінді, бірақ→
Dialogue: 0,0:23:57.59,0:24:00.09,Default,,0,0,0,,Мен жақсы жел таптым...
Dialogue: 0,0:24:02.03,0:24:04.10,Default,,0,0,0,,ｺﾝｸﾞﾗﾁｭﾚｰｼｮﾝ！
Dialogue: 0,0:24:04.10,0:24:08.19,Default,,0,0,0,,Үш марканы қолданып көру үшін 10 ұпай аласыз!
Dialogue: 0,0:24:08.19,0:24:12.79,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:24:12.79,0:24:14.86,Default,,0,0,0,,50 нүктеден әлі де алыс ➡
Dialogue: 0,0:24:14.86,0:24:18.88,Default,,0,0,0,,Дегенмен, бұл сенімді алғашқы қадам.
Dialogue: 0,0:24:18.88,0:24:21.95,Default,,0,0,0,,1-ші Мегаланика филиалының квесті➡
Dialogue: 0,0:24:21.95,0:24:24.87,Default,,0,0,0,,Жеңімпаз - үштік үштік командасы!
Dialogue: 0,0:24:24.87,0:24:28.57,Default,,0,0,0,,Хааа~
Dialogue: 0,0:24:28.57,0:24:32.03,Default,,0,0,0,,G Quest енді ғана басталды.
Dialogue: 0,0:24:32.03,0:24:36.90,Default,,0,0,0,,Мен балалар, барлық филиалдарда жеңетіндеріңді айттым.
Dialogue: 0,0:24:36.90,0:24:38.90,Default,,0,0,0,,Оны міндетті түрде орындаңыз
Dialogue: 0,0:24:40.87,0:24:44.19,Default,,0,0,0,,Мүлдем. Ол бізді жеңді.
Dialogue: 0,0:24:44.19,0:24:46.27,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:24:46.27,0:24:50.07,Default,,0,0,0,,Балалар, тағдырды міндетті түрде жеңе аласыздар.
Dialogue: 0,0:24:52.05,0:24:55.15,Default,,0,0,0,,Жел соғып тұр
Dialogue: 0,0:24:58.35,0:25:00.54,Default,,0,0,0,,Сіз шынымен үйге барасыз ба?
Dialogue: 0,0:25:00.54,0:25:04.39,Default,,0,0,0,,Біз жеңдік, ендеше тойлайық.
Dialogue: 0,0:25:04.39,0:25:06.96,Default,,0,0,0,,Менің ертең маңызды бір ісім бар.
Dialogue: 0,0:25:06.96,0:25:09.08,Default,,0,0,0,,Бүгін үйге ерте барғым келеді.
Dialogue: 0,0:25:09.08,0:25:14.22,Default,,0,0,0,,Мен түсіндім, онда мен бұл туралы ештеңе істей алмаймын. Кейінірек кездесеміз.
Dialogue: 0,0:25:14.22,0:25:16.22,Default,,0,0,0,,Тағы да
Dialogue: 0,0:25:19.76,0:25:22.06,Default,,0,0,0,,Бочама, ақыры осында.
Dialogue: 0,0:25:22.06,0:25:26.86,Default,,0,0,0,,Иә, ертең мен нағыз мұрагер боламын.
Dialogue: 0,0:27:08.97,0:28:05.97,Default,,0,0,0,,♪♪～
Dialogue: 0,0:30:34.89,0:30:37.39,Default,,0,0,0,,Бірақ бұған дейін →
Dialogue: 0,0:30:37.39,0:30:40.54,Default,,0,0,0,,Маңызды пресс-конференцияға қатысыңыз!
Dialogue: 0,0:30:40.54,0:30:44.56,Default,,0,0,0,,Пенальтиден Хиде мырза Икумен ретінде марапатталды
Dialogue: 0,0:30:44.56,0:30:46.55,Default,,0,0,0,,Жүлде - Кирин кофесі➡
Dialogue: 0,0:30:46.55,0:30:49.22,Default,,0,0,0,,СУПЕР ӨРТ ЖЫЛДАМДЫҒЫНЫҢ үзілуін алған кезде...
Dialogue: 0,0:30:49.22,0:30:51.52,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:30:58.21,0:31:00.21,Default,,0,0,0,,Және→
Dialogue: 0,0:31:01.71,0:31:07.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory