Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.71,0:01:06.90,Default,,0,0,0,,Крей планетасы?
Dialogue: 0,0:01:06.90,0:01:10.29,Default,,0,0,0,,О, бұл өтірік емес, Крей планетасы➡
Dialogue: 0,0:01:10.29,0:01:13.24,Default,,0,0,0,,Ол шынымен де бар
Dialogue: 0,0:01:13.24,0:01:15.41,Default,,0,0,0,,Сіз мұны бұрын айтпадыңыз ба?
Dialogue: 0,0:01:15.41,0:01:17.38,Default,,0,0,0,,Мен оны естіген жоқпын.
Dialogue: 0,0:01:17.38,0:01:21.40,Default,,0,0,0,,((Наоки: Planet Cray тек картаның ішіндегі нәрсеге қатысты емес.
Dialogue: 0,0:01:21.40,0:01:24.37,Default,,0,0,0,,Иә, шынымен солай))
Dialogue: 0,0:01:24.37,0:01:28.47,Default,,0,0,0,,Наоки-сан маған Камуи-саннан толығырақ мәлімет сұрауымды айтты.
Dialogue: 0,0:01:28.47,0:01:32.04,Default,,0,0,0,,Цк, сен қашып кеттің.
Dialogue: 0,0:01:32.04,0:01:35.64,Default,,0,0,0,,Камуи мырзаның да Клей планетасына қатысы бар ма?
Dialogue: 0,0:01:35.64,0:01:40.74,Default,,0,0,0,,Уф, уайымдама, мен оны ретімен түсіндіремін.
Dialogue: 0,0:04:52.69,0:04:56.74,Default,,0,0,0,,Авангард бейнеленген➡
Dialogue: 0,0:04:56.74,0:04:59.53,Default,,0,0,0,,Планета Клей деп аталатын басқа әлемде өмір сүру→
Dialogue: 0,0:04:59.53,0:05:03.40,Default,,0,0,0,,Әртүрлі қуаттағы қондырғылар
Dialogue: 0,0:05:03.40,0:05:06.70,Default,,0,0,0,,Бұл тек картаның ішіндегі нәрсе емес.
Dialogue: 0,0:05:08.74,0:05:11.24,Default,,0,0,0,,Біздің бұл дүниеден бөлек бар➡
Dialogue: 0,0:05:11.24,0:05:15.28,Default,,0,0,0,,Басқа әлем, ол Крей планетасы.
Dialogue: 0,0:05:15.28,0:05:19.88,Default,,0,0,0,,Карточкада сызылған өлшем бірліктері шынымен Крей планетасында
Dialogue: 0,0:05:24.59,0:05:27.09,Default,,0,0,0,,Балшық планетасы және біздің әлем➡
Dialogue: 0,0:05:27.09,0:05:29.19,Default,,0,0,0,,Олар бір-біріне әсер етеді
Dialogue: 0,0:05:29.19,0:05:32.76,Default,,0,0,0,,Клей дағдарысы біздің дағдарысқа айналады.
Dialogue: 0,0:05:32.76,0:05:34.76,Default,,0,0,0,,Біздікі?
Dialogue: 0,0:05:37.35,0:05:40.27,Default,,0,0,0,,Менің ағаларым мен достарымның күшімен➡
Dialogue: 0,0:05:40.27,0:05:42.57,Default,,0,0,0,,Дағдарыс қалай болса да ауыздықталды.
Dialogue: 0,0:05:42.57,0:05:48.01,Default,,0,0,0,,G Quest-ке жиналғандардың ішінде сол кезден қалған достар көп.
Dialogue: 0,0:05:48.01,0:05:51.23,Default,,0,0,0,,Мен де аздап белсенді болдым.
Dialogue: 0,0:05:51.23,0:05:53.69,Default,,0,0,0,,Бұл маңызды.
Dialogue: 0,0:05:53.69,0:05:56.40,Default,,0,0,0,,Бұл құпия емес➡
Dialogue: 0,0:05:56.40,0:05:59.39,Default,,0,0,0,,Сіз мұны ойламаған жерден айтсаңыз да сенбейсіз.
Dialogue: 0,0:05:59.39,0:06:03.58,Default,,0,0,0,,Сондықтан бәрі әйтеуір үнсіз қалады.
Dialogue: 0,0:06:03.58,0:06:07.07,Default,,0,0,0,,Сәл күте тұрыңыз, содан кейін...
Dialogue: 0,0:06:07.07,0:06:09.05,Default,,0,0,0,,((Ибуки: Тәуелді карта
Dialogue: 0,0:06:09.05,0:06:11.40,Default,,0,0,0,,Боксшы бейнесін тасымалдаушы➡ ретінде пайдалану
Dialogue: 0,0:06:11.40,0:06:17.04,Default,,0,0,0,,Крей планетасының бірлігін бұл әлемге не шақырады
Dialogue: 0,0:06:17.04,0:06:20.25,Default,,0,0,0,,Сіз сияқты басқа адамдар бар.
Dialogue: 0,0:06:20.25,0:06:23.87,Default,,0,0,0,,Тәуелді карталардың саны әлдеқашан бар➡
Dialogue: 0,0:06:23.87,0:06:27.77,Default,,0,0,0,,Өз амбициясын орындауға тырысу))
Dialogue: 0,0:06:27.77,0:06:31.22,Default,,0,0,0,,Бұл нағыз балшықтан жасалған нақты бірлік болды➡
Dialogue: 0,0:06:31.22,0:06:34.19,Default,,0,0,0,,Қоңырауды айтасыз ба?
Dialogue: 0,0:06:34.19,0:06:37.13,Default,,0,0,0,,Сол жерден Ибукиден сұраңыз.
Dialogue: 0,0:06:37.13,0:06:39.40,Default,,0,0,0,,Ол қуып келе жатқан жау.
Dialogue: 0,0:06:39.40,0:06:42.88,Default,,0,0,0,,Ең жылдам жолы - одан сұрау.
Dialogue: 0,0:06:42.88,0:06:44.89,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:06:44.89,0:06:48.36,Default,,0,0,0,,Не? Олар мәселені біржола шешіп қойған жоқ па?
Dialogue: 0,0:06:48.36,0:06:52.56,Default,,0,0,0,,Мен жаман күрескер емес екенімді білемін.
Dialogue: 0,0:06:52.56,0:06:54.58,Default,,0,0,0,,Бірақ...｡ Бірақ?
Dialogue: 0,0:06:54.58,0:06:56.56,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:06:56.56,0:07:00.16,Default,,0,0,0,,Жарайды, мен бәрібір онымен сөйлесуді жоспарлап едім.
Dialogue: 0,0:07:02.24,0:07:06.94,Default,,0,0,0,,Ал, күтіңіз, мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:07:06.94,0:07:11.54,Default,,0,0,0,,Сонда арнайы дайындық жалғыз нұсқа. иә?
Dialogue: 0,0:07:19.74,0:07:22.07,Default,,0,0,0,,Сен Ибукиді жұдырықтайсың.
Dialogue: 0,0:07:22.07,0:07:24.91,Default,,0,0,0,,Ондай жағдайда толық дайын болу керек.
Dialogue: 0,0:07:24.91,0:07:28.01,Default,,0,0,0,,Балалар, неге келдіңдер?
Dialogue: 0,0:07:28.01,0:07:30.23,Default,,0,0,0,,Камуи-санның арнайы дайындығын тек сен ғана аласың➡
Dialogue: 0,0:07:30.23,0:07:32.23,Default,,0,0,0,,Бұл ұят болар еді!
Dialogue: 0,0:07:32.23,0:07:35.39,Default,,0,0,0,,Сыбыстарға қарағанда, Камуи мырза да көптеген арнайы дайындықтан өткен➡
Dialogue: 0,0:07:35.39,0:07:37.57,Default,,0,0,0,,Қазір бар күшін алған сияқты.
Dialogue: 0,0:07:37.57,0:07:39.52,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:07:39.52,0:07:41.73,Default,,0,0,0,,Тек ол ғана жұтылып кеткен азаматтардың өкпе-ренішін қайтара алады
Dialogue: 0,0:07:41.73,0:07:46.13,Default,,0,0,0,,Алыс теңіздегі шалғай арал, ешкім білмейтін құпия жер
Dialogue: 0,0:07:46.13,0:07:51.07,Default,,0,0,0,,Камуи мырза бірнеше рет қанды арнайы дайындықтан өтеді➡
Dialogue: 0,0:07:51.07,0:07:55.57,Default,,0,0,0,,Ақыры мен Азияның шыңын басып алатын күшке ие болдым!
Dialogue: 0,0:07:58.78,0:08:02.08,Default,,0,0,0,,Бүгін біз сол аңызға тоқталамыз.
Dialogue: 0,0:08:10.10,0:08:13.10,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:08:25.52,0:08:30.48,Default,,0,0,0,,Сіз іздеген адамға ұқсайтын адам анда-санда келіп-кетіп тұратын көрінеді.
Dialogue: 0,0:08:30.48,0:08:34.23,Default,,0,0,0,,Мен одан біраз бұрын құтылдым, болды.
Dialogue: 0,0:08:34.23,0:08:39.12,Default,,0,0,0,,Мұндағы иесі оны төлей алатын болса, кез келген адамға қарызға беруімен танымал.
Dialogue: 0,0:08:39.12,0:08:43.39,Default,,0,0,0,,Мен ол жерде кейбір Эйс болғанына сенімдімін...
Dialogue: 0,0:08:43.39,0:08:45.86,Default,,0,0,0,,Эскорпорация? Иә, солай!
Dialogue: 0,0:08:45.86,0:08:49.79,Default,,0,0,0,,Бұл анықтама емес сияқты.
Dialogue: 0,0:08:49.79,0:08:53.29,Default,,0,0,0,,Жоқ, бұл да оның тамаша ізі.
Dialogue: 0,0:09:03.76,0:09:05.76,Default,,0,0,0,,≪Мен сені осында әкелдім.
Dialogue: 0,0:09:07.90,0:09:11.07,Default,,0,0,0,,Шамамен екі ай бұрын
Dialogue: 0,0:09:11.07,0:09:14.47,Default,,0,0,0,,Ол мені шақырды.
Dialogue: 0,0:09:14.47,0:09:18.26,Default,,0,0,0,,Адамдарды біріктіру туралы болды.
Dialogue: 0,0:09:18.26,0:09:23.71,Default,,0,0,0,,Мен бірнеше түрлі ұялы телефондарды пайдаланатын мазасыз жігіт едім.
Dialogue: 0,0:09:23.71,0:09:26.90,Default,,0,0,0,,Жекпе-жек өте күшті болды.
Dialogue: 0,0:09:26.90,0:09:29.35,Default,,0,0,0,,Мен кланның...
Dialogue: 0,0:09:29.35,0:09:31.90,Default,,0,0,0,,ｸﾞﾗﾝﾌﾞﾙｰ
Dialogue: 0,0:09:31.90,0:09:36.27,Default,,0,0,0,,Ақырында кенет жұмысқа тұрсам да, тез шығып кеттім.
Dialogue: 0,0:09:36.27,0:09:39.07,Default,,0,0,0,,Менің ойымша, бұл бәрібір жаман бизнес емес.
Dialogue: 0,0:09:43.40,0:09:46.08,Default,,0,0,0,,Мына жерде, іздену орны.
Dialogue: 0,0:09:46.08,0:09:48.20,Default,,0,0,0,,Мен де бүгін міндетті түрде жеңемін.
Dialogue: 0,0:09:48.20,0:09:50.54,Default,,0,0,0,,Мен де ұтыла алмаймын
Dialogue: 0,0:09:50.54,0:09:54.74,Default,,0,0,0,,Токоха-чан және Квест Біраз уақыт өтті
Dialogue: 0,0:09:54.74,0:09:58.41,Default,,0,0,0,,Кешіріңіз, бұл күндері сізбен араласа алмаймын.
Dialogue: 0,0:09:58.41,0:10:00.62,Default,,0,0,0,,Иә? Жоқ жоқ ➡
Dialogue: 0,0:10:00.62,0:10:04.62,Default,,0,0,0,,Мен сені қолдаймын, Токоха-чан, сен G Quest-те көп жұмыс істейсің.
Dialogue: 0,0:10:06.57,0:10:10.24,Default,,0,0,0,,Мен G-Kue содасы туралы да ақпарат жинадым.
Dialogue: 0,0:10:10.24,0:10:14.53,Default,,0,0,0,,Юнасан филиалында жаңа бөлім басшысы Рен Сузугамори➡ болды
Dialogue: 0,0:10:14.53,0:10:19.23,Default,,0,0,0,,Ол басқарған бестік оның жолында жау болып тұр.
Dialogue: 0,0:10:19.23,0:10:22.10,Default,,0,0,0,,Қауіпті болып көрінетіні - Жұлдыздар қақпасы.
Dialogue: 0,0:10:22.10,0:10:25.89,Default,,0,0,0,,Джокер кланының жетекшісі Ибуки Коудзи сілтемесі бар→
Dialogue: 0,0:10:25.89,0:10:28.36,Default,,0,0,0,,Сол досы Кай Тошики
Dialogue: 0,0:10:28.36,0:10:32.05,Default,,0,0,0,,Егер сіз екі адаммен жекпе-жек өткізіп, кем дегенде бір рет жеңсеңіз, сізге 10 мөр ұпайы беріледі.
Dialogue: 0,0:10:32.05,0:10:36.73,Default,,0,0,0,,Бірақ оны әлі ешкім тазалаған жоқ.
Dialogue: 0,0:10:36.73,0:10:39.60,Default,,0,0,0,,Коудзи Ибуки мен Тошики Кай?
Dialogue: 0,0:10:39.60,0:10:42.72,Default,,0,0,0,,Менің ойымша, бұл оңай болмайды.
Dialogue: 0,0:10:42.72,0:10:45.74,Default,,0,0,0,,Жарайды, Токоха-чан және басқалары.
Dialogue: 0,0:10:45.74,0:10:48.05,Default,,0,0,0,,Хехе, жауынгерлік рух енгізілді!
Dialogue: 0,0:10:48.05,0:10:50.06,Default,,0,0,0,,Уау! Ұстаңыз!
Dialogue: 0,0:10:50.06,0:10:52.73,Default,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:10:52.73,0:10:55.10,Default,,0,0,0,,А... Луна?
Dialogue: 0,0:10:55.10,0:10:57.15,Default,,0,0,0,,Токоха мырза!?
Dialogue: 0,0:10:57.15,0:11:00.37,Default,,0,0,0,,Әй, бұл квестте Токоха да бар шығар?
Dialogue: 0,0:11:00.37,0:11:02.58,Default,,0,0,0,,Иә, достарыммен
Dialogue: 0,0:11:02.58,0:11:04.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:04.93,0:11:08.73,Default,,0,0,0,,Сіз кездейсоқсыз ба?
Dialogue: 0,0:11:08.73,0:11:13.19,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:11:13.19,0:11:15.74,Default,,0,0,0,,Бір сәт кешіріңіз... [TEL]
Dialogue: 0,0:11:15.74,0:11:18.04,Default,,0,0,0,,Камуи мырза? [ТЕЛ]
Dialogue: 0,0:13:00.71,0:13:03.23,Default,,0,0,0,,Сурет!
Dialogue: 0,0:13:03.23,0:13:05.88,Default,,0,0,0,,Бұл Клей планетасының күйіп тұрған жері.
Dialogue: 0,0:13:05.88,0:13:08.40,Default,,0,0,0,,Қайнаған лавасы бар қызыл қызыл жанартау!
Dialogue: 0,0:13:08.40,0:13:11.41,Default,,0,0,0,,Осы әлемде күресу үшін күш алыңыз!
Dialogue: 0,0:13:11.41,0:13:13.36,Default,,0,0,0,,Жүр! (Куроно және т.б.) Атқа мін!
Dialogue: 0,0:13:13.36,0:13:15.74,Default,,0,0,0,,Даусыңыз кішкентай! (Куроно және т.б.) Атқа мін!
Dialogue: 0,0:13:15.74,0:13:17.70,Default,,0,0,0,,Әлі жоқ!!
Dialogue: 0,0:13:17.70,0:13:22.73,Default,,0,0,0,,ﾗｲﾄﾞ！ ﾗｲﾄﾞ！ ﾗｲﾄﾞ！
Dialogue: 0,0:13:22.73,0:13:25.57,Default,,0,0,0,,Сурет! Айнымас күшке ие болыңыз➡
Dialogue: 0,0:13:25.57,0:13:27.69,Default,,0,0,0,,Өзіңізді жеңіске жеткізіңіз!
Dialogue: 0,0:13:27.69,0:13:30.02,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:13:30.02,0:13:33.89,Default,,0,0,0,,Жүр! Жүру! Жүру! Бұл арнайы дайындық па?
Dialogue: 0,0:13:33.89,0:13:36.40,Default,,0,0,0,,Көңілді сияқты~
Dialogue: 0,0:13:36.40,0:13:38.57,Default,,0,0,0,,Ха~
Dialogue: 0,0:13:38.57,0:13:41.54,Default,,0,0,0,,((Өтінемін! Осы жерді тазаласаңыз→
Dialogue: 0,0:13:41.54,0:13:43.74,Default,,0,0,0,,Мен сізге оны еркін пайдалануға уәде беремін.
Dialogue: 0,0:13:43.74,0:13:46.14,Default,,0,0,0,,Мен ерлер ваннасын бітірдім →
Dialogue: 0,0:13:46.14,0:13:49.04,Default,,0,0,0,,Әйелдер ваннасына кіру аздап қиын.
Dialogue: 0,0:13:49.04,0:13:51.08,Default,,0,0,0,,Мен түсінбеймін, бірақ➡
Dialogue: 0,0:13:51.08,0:13:54.52,Default,,0,0,0,,Біз тазаласақ, біз де арнайы дайындықтан өтеміз бе?
Dialogue: 0,0:13:54.52,0:13:59.40,Default,,0,0,0,,О! Сондай-ақ, жеміс-жидек сүтін қалағаныңызша ішуге болады!!))
Dialogue: 0,0:13:59.40,0:14:02.39,Default,,0,0,0,,Мұндай арнайы дайындық...
Dialogue: 0,0:14:02.39,0:14:05.69,Default,,0,0,0,,Кешіріңіз, сіздің квестіңізден бас тартуға тура келді...
Dialogue: 0,0:14:05.69,0:14:09.58,Default,,0,0,0,,Жоқ, жоқ, Токоха-чан! Бұл да тренингтің бір бөлігі.
Dialogue: 0,0:14:09.58,0:14:13.03,Default,,0,0,0,,Моншадағы кір – жүректегі кір
Dialogue: 0,0:14:13.03,0:14:15.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:15.07,0:14:17.52,Default,,0,0,0,,Ешбір жұмыста бұрыштарды кеспеңіз➡
Dialogue: 0,0:14:17.52,0:14:19.74,Default,,0,0,0,,Міне, Ам маған үнемі айтып отырады.
Dialogue: 0,0:14:19.74,0:14:21.78,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:14:21.78,0:14:25.08,Default,,0,0,0,,Енді мен ұсынысты қабылдадым, оны орындаудан басқа амалым жоқ!
Dialogue: 0,0:14:27.06,0:14:30.08,Default,,0,0,0,,ﾊｧ ﾊｧ ﾊｧ…
Dialogue: 0,0:14:30.08,0:14:33.24,Default,,0,0,0,,Бұл... аңызға айналған жаттығу ма?
Dialogue: 0,0:14:33.24,0:14:37.34,Default,,0,0,0,,Сіз шынымен осылай күшті бола аласыз ба?
Dialogue: 0,0:14:41.38,0:14:44.38,Default,,0,0,0,,О...!
Dialogue: 0,0:14:49.07,0:14:52.94,Default,,0,0,0,,Метчабутт каучук үшін ➡
Dialogue: 0,0:14:52.94,0:14:56.44,Default,,0,0,0,,Мен мінемін!
Dialogue: 0,0:14:56.44,0:15:00.44,Default,,0,0,0,,Мен оны көріп тұрмын! Виктор Камуи-санның артында!!
Dialogue: 0,0:15:03.57,0:15:05.70,Default,,0,0,0,,О...!
Dialogue: 0,0:15:05.70,0:15:09.94,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:15:09.94,0:15:12.24,Default,,0,0,0,,Уау!!
Dialogue: 0,0:15:14.20,0:15:17.23,Default,,0,0,0,,Бұл менің Авангардым!
Dialogue: 0,0:15:17.23,0:15:20.20,Default,,0,0,0,,Камуи мырза! Камуи мырза! Камуи мырза...
Dialogue: 0,0:15:20.20,0:15:22.24,Default,,0,0,0,,Енді қайтадан басынан бастайық!
Dialogue: 0,0:15:22.24,0:15:24.22,Default,,0,0,0,,Барлығы менің артымнан!
Dialogue: 0,0:15:24.22,0:15:26.21,Default,,0,0,0,,Иә!!
Dialogue: 0,0:15:26.21,0:15:30.08,Default,,0,0,0,,Содан бері жағдай қалай болды? Сіз Ам Чанды жеңдіңіз бе?
Dialogue: 0,0:15:30.08,0:15:32.91,Default,,0,0,0,,Жеңіліс сериясының рекорды жаңартылуда...
Dialogue: 0,0:15:32.91,0:15:34.93,Default,,0,0,0,,көремін.
Dialogue: 0,0:15:34.93,0:15:38.53,Default,,0,0,0,,Күрсін... Амға баратын жол ұзақ.
Dialogue: 0,0:15:41.07,0:15:46.03,Default,,0,0,0,,Ам, бұл шынымен де керемет.
Dialogue: 0,0:15:46.03,0:15:51.83,Default,,0,0,0,,Ол жаңа ғана барлау жүргізген меннен мүлде басқа...
Dialogue: 0,0:15:53.73,0:15:55.79,Default,,0,0,0,,Мен қалай жете аламын➡
Dialogue: 0,0:15:55.79,0:15:58.09,Default,,0,0,0,,Мен білмеймін, бірақ...
Dialogue: 0,0:16:01.29,0:16:06.58,Default,,0,0,0,,Эхехе... Дәл қазір мен барлық істе бар күшімді салуға тырысамын.
Dialogue: 0,0:16:06.58,0:16:10.03,Default,,0,0,0,,Жұмыс, сабақ және авангард!
Dialogue: 0,0:16:10.03,0:16:14.72,Default,,0,0,0,,Мен де Не істей аламын?➡
Dialogue: 0,0:16:14.72,0:16:17.59,Default,,0,0,0,,Мен әлі де түсінбеймін
Dialogue: 0,0:16:17.59,0:16:21.61,Default,,0,0,0,,Бірақ мен қолымнан келгеннің бәрін істеуге шешім қабылдадым.
Dialogue: 0,0:16:21.61,0:16:23.61,Default,,0,0,0,,Себебі мен алға жылжығым келеді
Dialogue: 0,0:16:26.38,0:16:30.42,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:16:30.42,0:16:33.36,Default,,0,0,0,,Үзіліс аяқталды! Келесі қадам - ​​Stride!
Dialogue: 0,0:16:33.36,0:16:35.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:35.39,0:16:37.69,Default,,0,0,0,,Сәлем
Dialogue: 0,0:16:47.91,0:16:50.36,Default,,0,0,0,,Бұл Крей планетасының дауылды жанартауы!
Dialogue: 0,0:16:50.36,0:16:52.89,Default,,0,0,0,,Қатты найзағайдан қиналып жатсам да➡
Dialogue: 0,0:16:52.89,0:16:55.71,Default,,0,0,0,,Жеңіске жеткеніңізді елестетіңіз!
Dialogue: 0,0:16:55.71,0:16:57.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:59.90,0:17:02.35,Default,,0,0,0,,Уау!?
Dialogue: 0,0:17:02.35,0:17:04.94,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:04.94,0:17:07.24,Default,,0,0,0,,Ұйқысыздық...
Dialogue: 0,0:17:13.36,0:17:15.40,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:17:15.40,0:17:17.57,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:17:17.57,0:17:19.54,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:17:19.54,0:17:23.47,Default,,0,0,0,,Қадамдық ұрпақ! Қадам ұрпақ!
Dialogue: 0,0:17:23.47,0:17:26.39,Default,,0,0,0,,Бұл – ең құнды ойыншы, иә?
Dialogue: 0,0:17:26.39,0:17:29.40,Default,,0,0,0,,Сурет жеткіліксіз сияқты.
Dialogue: 0,0:17:29.40,0:17:31.42,Default,,0,0,0,,Ұятыңды таста!
Dialogue: 0,0:17:31.42,0:17:33.38,Default,,0,0,0,,Ашуыңды шығар!
Dialogue: 0,0:17:33.38,0:17:36.48,Default,,0,0,0,,Сіз шынымен жеңгіңіз келетіндерге!
Dialogue: 0,0:17:43.26,0:17:46.36,Default,,0,0,0,,Мен жеңуім керек адамды...
Dialogue: 0,0:17:51.30,0:17:55.10,Default,,0,0,0,,Еш қағыспа! Оны Наруками кальмары деп ойлаңыз!
Dialogue: 0,0:17:58.73,0:18:01.23,Default,,0,0,0,,Ей, көмектес! Оның алдыңғы тістерін жұлып ал—мен оларды тіс дәрігеріне апарамын!
Dialogue: 0,0:18:05.25,0:18:09.85,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:18:09.85,0:18:13.62,Default,,0,0,0,,Тазалау аяқталды. Ыстық су қосуға болады ма?
Dialogue: 0,0:18:13.62,0:18:16.62,Default,,0,0,0,,Сондай-ақ, бірінші ванна
Dialogue: 0,0:18:23.68,0:18:27.04,Default,,0,0,0,,Соңына дейін қалған сен едің ғой.
Dialogue: 0,0:18:27.04,0:18:29.89,Default,,0,0,0,,Мен сіздерге арнайы оқуымның нәтижесін көрсетемін.
Dialogue: 0,0:18:29.89,0:18:31.93,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:18:31.93,0:18:34.90,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:18:34.90,0:18:38.27,Default,,0,0,0,,Ха~
Dialogue: 0,0:18:38.27,0:18:44.24,Default,,0,0,0,,Ең күшті хайуан құдайы Esix Buster Extreme үшін мен ең күштіні айдаймын!
Dialogue: 0,0:18:44.24,0:18:46.74,Default,,0,0,0,,Бұл сіріңке емес.
Dialogue: 0,0:18:46.74,0:18:50.36,Default,,0,0,0,,Бұл Джушин палубасы. Бұл да керемет емес пе?
Dialogue: 0,0:18:50.36,0:18:52.58,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:18:52.58,0:18:56.97,Default,,0,0,0,,Ең керемет құбыжық құдайының этикасының бұзылуы!
Dialogue: 0,0:18:56.97,0:18:58.85,Default,,0,0,0,,Апат дағдылары
Dialogue: 0,0:18:58.85,0:19:00.90,Default,,0,0,0,,Бұл құрылғы Drive Check➡ арқылы қол жетімді
Dialogue: 0,0:19:00.90,0:19:03.27,Default,,0,0,0,,1 немесе одан жоғары дәрежелі аң құдайы пайда болса →
Dialogue: 0,0:19:03.27,0:19:05.71,Default,,0,0,0,,Бір тылда тұра алады.
Dialogue: 0,0:19:05.71,0:19:10.15,Default,,0,0,0,,Менің палубам негізінен аң құдайларының бірліктерінен тұрады.
Dialogue: 0,0:19:10.15,0:19:13.75,Default,,0,0,0,,Егер сіз тіке тартсаңыз, Лиа міндетті түрде тұрады.
Dialogue: 0,0:19:15.75,0:19:17.77,Default,,0,0,0,,ｺｰﾙ！
Dialogue: 0,0:19:17.77,0:19:19.82,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:19:19.82,0:19:21.91,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:19:21.91,0:19:26.05,Default,,0,0,0,,Аң құдайы Айдаһардың бұралуымен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:26.05,0:19:29.23,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:19:29.23,0:19:32.87,Default,,0,0,0,,Essix Buster Catastrophe арқылы Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:32.87,0:19:34.89,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ！
Dialogue: 0,0:19:34.89,0:19:38.26,Default,,0,0,0,,Кеттік, үштік жетек!
Dialogue: 0,0:19:38.26,0:19:40.28,Default,,0,0,0,,Жек көрушілік
Dialogue: 0,0:19:40.28,0:19:42.25,Default,,0,0,0,,Арыстан да шеберлікпен тік тұрады.
Dialogue: 0,0:19:42.25,0:19:44.20,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:19:44.20,0:19:46.68,Default,,0,0,0,,Аң құдайы Айдаһардың бұралған тірегі
Dialogue: 0,0:19:46.68,0:19:49.22,Default,,0,0,0,,Clock Fencer-тен шегіну үшін өз дағдыларыңызды пайдаланыңыз!
Dialogue: 0,0:19:49.22,0:19:51.24,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:51.24,0:19:54.39,Default,,0,0,0,,Қайғылы тексеру
Dialogue: 0,0:19:54.39,0:19:56.39,Default,,0,0,0,,Бұл жігіт аң құдайы емес еді.
Dialogue: 0,0:19:56.39,0:19:58.41,Default,,0,0,0,,ｽﾀﾝﾄﾞﾄﾘｶﾞｰ
Dialogue: 0,0:19:58.41,0:20:02.78,Default,,0,0,0,,Max Beat стенді Пауэр Plus 5000!
Dialogue: 0,0:20:02.78,0:20:05.28,Default,,0,0,0,,Жүр!
Dialogue: 0,0:20:08.41,0:20:10.41,Default,,0,0,0,,Жек көретіндермен шабуыл!
Dialogue: 0,0:20:10.41,0:20:12.36,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:20:12.36,0:20:17.11,Default,,0,0,0,,Әрі қарай жүрейік! Dragon Twist көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:20:17.11,0:20:20.71,Default,,0,0,0,,Не болды? Ибуки бұлай жеңе алмайды.
Dialogue: 0,0:20:22.69,0:20:24.72,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:20:24.72,0:20:26.74,Default,,0,0,0,,Бұрылыс және аяқтау
Dialogue: 0,0:20:26.74,0:20:29.04,Default,,0,0,0,,Мүмкін соңғысын тапсырған дұрыс болар еді.
Dialogue: 0,0:20:31.40,0:20:35.05,Default,,0,0,0,,Ибукидің аты шыққанда, болды.
Dialogue: 0,0:20:35.05,0:20:37.05,Default,,0,0,0,,Сіз тым санасыз ба?
Dialogue: 0,0:20:39.09,0:20:42.52,Default,,0,0,0,,Мен жеңілгім келмейді, тек оған.
Dialogue: 0,0:20:42.52,0:20:44.93,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:20:44.93,0:20:48.91,Default,,0,0,0,,Кеңістік-уақыт жануары Metallica Phoenix!
Dialogue: 0,0:20:48.91,0:20:52.87,Default,,0,0,0,,Қадаммен жүру дағдысы Драго Палубаның түбіне дейін бұраңыз
Dialogue: 0,0:20:52.87,0:20:54.94,Default,,0,0,0,,ｺｰﾙ ｽﾁｰﾑｽｶﾗｰ ｼﾞｼﾞ
Dialogue: 0,0:20:54.94,0:20:56.95,Default,,0,0,0,,Шеберлікпен 1 картаны сал
Dialogue: 0,0:20:56.95,0:20:59.26,Default,,0,0,0,,ｺｰﾙ ｸﾛｯｸﾌｪﾝｻｰ
Dialogue: 0,0:20:59.26,0:21:01.41,Default,,0,0,0,,Хроно Дранның уақыт секірісі
Dialogue: 0,0:21:01.41,0:21:03.74,Default,,0,0,0,,Палубадан Gear Wolf-ті шақырыңыз
Dialogue: 0,0:21:03.74,0:21:08.18,Default,,0,0,0,,Сонымен қатар, Chrono Джет-ке қоңырау шалу үшін Chrono Dran шеберлігін пайдаланыңыз.
Dialogue: 0,0:21:08.18,0:21:10.90,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:21:10.90,0:21:14.79,Default,,0,0,0,,《Мен әлсіз екенімді білемін, адасып қалдым➡
Dialogue: 0,0:21:14.79,0:21:16.91,Default,,0,0,0,,Бұл да менікі》
Dialogue: 0,0:21:16.91,0:21:18.88,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:21:18.88,0:21:20.93,Default,,0,0,0,,《Бірақ бұл мені ауыртады》
Dialogue: 0,0:21:20.93,0:21:23.71,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:21:23.71,0:21:27.94,Default,,0,0,0,,Metallica Phoenix көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:21:27.94,0:21:32.24,Default,,0,0,0,,Джиджиге уақыт секіріп, жоғары ағынға қоңырау шалыңыз!
Dialogue: 0,0:21:34.54,0:21:39.01,Default,,0,0,0,,Бәрін өзім істей аламын деп көрсету➡
Dialogue: 0,0:21:39.01,0:21:42.23,Default,,0,0,0,,Сізге айту керек ештеңе айтпаңыз
Dialogue: 0,0:21:42.23,0:21:45.35,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:21:45.35,0:21:48.94,Default,,0,0,0,,Критикалық триггер қуаты жоғары ағында
Dialogue: 0,0:21:48.94,0:21:51.74,Default,,0,0,0,,Metallica үшін маңызды!
Dialogue: 0,0:21:54.70,0:21:58.45,Default,,0,0,0,,Жоғары ағындағы Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:21:58.45,0:22:00.55,Default,,0,0,0,,Қуат плюс 4000 шеберлікпен
Dialogue: 0,0:22:04.20,0:22:06.72,Default,,0,0,0,,Мәңгі алақанда➡
Dialogue: 0,0:22:06.72,0:22:09.38,Default,,0,0,0,,Билеуге тоймаймын!
Dialogue: 0,0:22:09.38,0:22:13.73,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:22:13.73,0:22:16.80,Default,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:22:16.80,0:22:19.85,Default,,0,0,0,,Камуи-сан әлі мектеп оқушысы емес!
Dialogue: 0,0:22:19.85,0:22:25.19,Default,,0,0,0,,Жарайды, бірақ сізде біраз тәжірибе бар, солай емес пе?
Dialogue: 0,0:22:25.19,0:22:29.86,Default,,0,0,0,,Мен сізге дәрежедегі айырмашылықты көрсетемін.
Dialogue: 0,0:22:29.86,0:22:32.57,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:22:32.57,0:22:37.07,Default,,0,0,0,,Ең керемет құдайдың Exx Buster апаты!
Dialogue: 0,0:22:37.07,0:22:39.04,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:22:39.04,0:22:42.29,Default,,0,0,0,,Егер көлікті тексеру кезінде хайуан құдайы пайда болса, Риа тұрыңыз.
Dialogue: 0,0:22:42.29,0:22:45.09,Default,,0,0,0,,Сонымен қатар, бұл жолы қуат қосылады.
Dialogue: 0,0:22:47.01,0:22:49.07,Default,,0,0,0,,ｺｰﾙ ﾌﾞﾚｲﾆｰﾊﾟﾋﾟｵ！
Dialogue: 0,0:22:49.07,0:22:51.05,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:22:51.05,0:22:53.07,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:22:53.07,0:22:55.02,Default,,0,0,0,,Ақылмен шабуыл!
Dialogue: 0,0:22:55.02,0:22:57.02,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:22:57.02,0:22:59.63,Default,,0,0,0,,Авангардқа апатпен шабуыл жасаңыз!
Dialogue: 0,0:22:59.63,0:23:02.73,Default,,0,0,0,,Толығымен қорғалған. Үштік жетек
Dialogue: 0,0:23:02.73,0:23:05.40,Default,,0,0,0,,Beast God Ethics Buster
Dialogue: 0,0:23:05.40,0:23:07.35,Default,,0,0,0,,Шеберліктеріңізге қарай Жек көрушілікке төтеп бере аласыз.
Dialogue: 0,0:23:07.35,0:23:09.80,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ3000
Dialogue: 0,0:23:09.80,0:23:12.06,Default,,0,0,0,,Жыртқыш құдай Макс ұрады!
Dialogue: 0,0:23:12.06,0:23:15.03,Default,,0,0,0,,Сіздің шеберлігіңізге байланысты сіз Brainy Papio-ға шыдай аласыз.
Dialogue: 0,0:23:15.03,0:23:17.06,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ3000
Dialogue: 0,0:23:17.06,0:23:19.40,Default,,0,0,0,,Айдаһар құдайының бұралуы!
Dialogue: 0,0:23:19.40,0:23:22.05,Default,,0,0,0,,Тұрыңыз Max Beat шеберлікпен
Dialogue: 0,0:23:22.05,0:23:24.07,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ3000
Dialogue: 0,0:23:24.07,0:23:26.05,Default,,0,0,0,,Құт
Dialogue: 0,0:23:26.05,0:23:28.41,Default,,0,0,0,,Мен сенің сезіміңді түсіндім.
Dialogue: 0,0:23:28.41,0:23:31.41,Default,,0,0,0,,Менің ойымша, ол көбіне қателесіп жүр➡
Dialogue: 0,0:23:31.41,0:23:33.81,Default,,0,0,0,,Ол ебедейсіз болуы керек.
Dialogue: 0,0:23:33.81,0:23:37.08,Default,,0,0,0,,Камуй-сан, сен ол жігіттің иығын көтересің бе?
Dialogue: 0,0:23:37.08,0:23:40.45,Default,,0,0,0,,Біртүрлі болып тұрғаны осы.
Dialogue: 0,0:23:40.45,0:23:43.07,Default,,0,0,0,,Ақылмен шабуыл!
Dialogue: 0,0:23:43.07,0:23:45.07,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ！
Dialogue: 0,0:23:45.07,0:23:48.38,Default,,0,0,0,,Ақыл-ой дағдылары! Макс соққы стенді
Dialogue: 0,0:23:48.38,0:23:53.43,Default,,0,0,0,,Сонымен қатар, Макс Биттің дағдыларымен сіз Brainy-ге төтеп бере аласыз.
Dialogue: 0,0:23:53.43,0:23:56.43,Default,,0,0,0,,Brainy-мен қайтадан шабуыл жасаңыз!
Dialogue: 0,0:24:10.71,0:24:13.75,Default,,0,0,0,,Біраз күтпеген ұқсастықтар бар сияқты.
Dialogue: 0,0:24:13.75,0:24:16.02,Default,,0,0,0,,Сіз және Ибуки
Dialogue: 0,0:24:16.02,0:24:18.12,Default,,0,0,0,,Қайда?
Dialogue: 0,0:24:18.12,0:24:20.12,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:24:23.71,0:24:26.80,Default,,0,0,0,,Жарайды, соғылып сынсын.
Dialogue: 0,0:24:26.80,0:24:28.80,Default,,0,0,0,,Бұл оқиға
Dialogue: 0,0:24:34.35,0:24:37.74,Default,,0,0,0,,А, ыстық су жақсы болды.
Dialogue: 0,0:24:37.74,0:24:40.41,Default,,0,0,0,,Егер сізге тағы бірдеңе керек болса, маған хабарласыңыз.
Dialogue: 0,0:24:40.41,0:24:42.36,Default,,0,0,0,,Токоха-сан Куми-сан
Dialogue: 0,0:24:42.36,0:24:44.43,Default,,0,0,0,,Бұл жерде болғаны дұрыс
Dialogue: 0,0:24:44.43,0:24:46.43,Default,,0,0,0,,Жұмыстарыңызға сәттілік
Dialogue: 0,0:24:50.05,0:24:52.07,Default,,0,0,0,,Пуха~!
Dialogue: 0,0:24:52.07,0:24:54.07,Default,,0,0,0,,Енді біз де ең мықтымыз.
Dialogue: 0,0:24:54.07,0:24:57.07,Default,,0,0,0,,О! Иә иә
Dialogue: 0,0:25:02.43,0:25:04.43,Default,,0,0,0,,Бұл менің келесі мақсатым.
Dialogue: 0,0:25:06.37,0:25:09.69,Default,,0,0,0,,Мен оны Жұлдыздар қақпасының тармағына айналдырғым келеді. (Шион/Токоха) Иә!
Dialogue: 0,0:25:09.69,0:25:13.88,Default,,0,0,0,,Оны жеңбесең, алға баса алмайсың.
Dialogue: 0,0:25:13.88,0:25:16.38,Default,,0,0,0,,Мен де саған аздап қарыздармын.
Dialogue: 0,0:25:21.77,0:25:23.77,Default,,0,0,0,,Zincir секілді жалғасқан
Dialogue: 0,0:26:59.68,0:27:01.74,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:27:01.74,0:27:03.72,Default,,0,0,0,,ｶﾞｰﾄﾞ ｲﾝﾀｰｾﾌﾟﾄ
Dialogue: 0,0:27:03.72,0:27:07.06,Default,,0,0,0,,Сіз мұны жеңе аласыз ба... Күткендей.
Dialogue: 0,0:27:07.06,0:27:10.46,Default,,0,0,0,,Жоқ, триггер шықса, бітті.
Dialogue: 0,0:27:10.46,0:27:12.46,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:27:12.46,0:27:17.42,Default,,0,0,0,,Кристофер Лоу Драен филиалына жиі келетін сияқты.
Dialogue: 0,0:27:17.42,0:27:19.35,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:27:19.35,0:27:21.42,Default,,0,0,0,,Өйткені олар Азиядан шыққан элита.
Dialogue: 0,0:27:21.42,0:27:23.41,Default,,0,0,0,,Мен әртүрлі пікірлерді тыңдағым келеді.
Dialogue: 0,0:27:23.41,0:27:25.38,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:27:25.38,0:27:28.06,Default,,0,0,0,,G Quest жақсы өтіп жатқан сияқты.
Dialogue: 0,0:27:28.06,0:27:31.03,Default,,0,0,0,,Штаб бұл нәтижеге қанағаттануы керек.
Dialogue: 0,0:27:31.03,0:27:33.07,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:27:33.07,0:27:35.74,Default,,0,0,0,,Мазасыздықсыз емес
Dialogue: 0,0:27:35.74,0:27:38.36,Default,,0,0,0,,Эй, мысалы, қандай?
Dialogue: 0,0:27:38.36,0:27:40.44,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:27:40.44,0:27:42.44,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:27:47.03,0:27:49.73,Default,,0,0,0,,Сіз маған әрқашан жаңартуды бере аласыз.
Dialogue: 0,0:27:49.73,0:27:52.39,Default,,0,0,0,,Әрине, күрес жеңіледі, бірақ
Dialogue: 0,0:27:52.39,0:27:56.06,Default,,0,0,0,,Сол жолды дәл қайталаңыз.
Dialogue: 0,0:27:56.06,0:27:59.76,Default,,0,0,0,,Бұл жерде өте жақсы.
Dialogue: 0,0:27:59.76,0:28:03.76,Default,,0,0,0,,Дұрыс? Ол маңайда танымал
Dialogue: 0,0:30:33.66,0:30:35.66,Default,,0,0,0,,Бұл жолы→
Dialogue: 0,0:30:41.55,0:30:43.49,Default,,0,0,0,,10 жыл бұрынғымен салыстырғанда →
Dialogue: 0,0:30:43.49,0:30:46.86,Default,,0,0,0,,Ол осылай өзгереді.
Dialogue: 0,0:30:46.86,0:30:51.66,Default,,0,0,0,,Сондықтан бұл жолы Токиодан табу қиын→
