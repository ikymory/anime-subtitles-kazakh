Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.40,0:01:10.95,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:10.95,0:01:25.45,Default,,0,0,0,,♪♪～
Dialogue: 0,0:04:50.41,0:04:55.03,Default,,0,0,0,,<Шион: Баяғыда бір зұлым мырза көп адамды қинап жүрген➡
Dialogue: 0,0:04:55.03,0:04:58.05,Default,,0,0,0,,Белгілі бір елде➡
Dialogue: 0,0:04:58.05,0:05:04.74,Default,,0,0,0,,Құлаған қылышшыны адам құтқарды.
Dialogue: 0,0:05:04.74,0:05:07.86,Default,,0,0,0,,Ол басқа әлемнен➡
Dialogue: 0,0:05:07.86,0:05:13.58,Default,,0,0,0,,Ол кісіге қылыш берді.
Dialogue: 0,0:05:13.58,0:05:15.95,Default,,0,0,0,,Жарқыраған қылыш Фидес
Dialogue: 0,0:05:15.95,0:05:20.37,Default,,0,0,0,,Әділ ұстаса, қылыш өздігінен жарқырайды➡
Dialogue: 0,0:05:20.37,0:05:24.91,Default,,0,0,0,,Барлығын жеңіңіз
Dialogue: 0,0:05:24.91,0:05:28.36,Default,,0,0,0,,Зұлым мырзаны қылыштың күшімен жеңген адам➡
Dialogue: 0,0:05:28.36,0:05:31.46,Default,,0,0,0,,Әркімнің қалауымен жерді басқар➡
Dialogue: 0,0:05:31.46,0:05:34.06,Default,,0,0,0,,Киба руы гүлденудің негізі болды＞
Dialogue: 0,0:05:36.70,0:05:41.96,Default,,0,0,0,,《Шион: Ал бүгін мен ресми түрде →
Dialogue: 0,0:05:41.96,0:05:44.26,Default,,0,0,0,,оның мұрагері болады》
Dialogue: 0,0:05:51.47,0:06:14.97,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:17.46,0:06:19.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:23.58,0:06:25.64,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:06:25.64,0:06:27.89,Default,,0,0,0,,Әй, жаман екен, ұялы телефон... А! [ТЕЛ]
Dialogue: 0,0:06:27.89,0:06:29.91,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:06:29.91,0:06:36.78,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:36.78,0:06:39.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:43.57,0:06:46.74,Default,,0,0,0,,Құттықтаймын Шион-кун, енді сен де➡
Dialogue: 0,0:06:46.74,0:06:49.59,Default,,0,0,0,,Ол Кибаның ресми мұрагері.
Dialogue: 0,0:06:49.59,0:06:51.66,Default,,0,0,0,,Қазір Киба отбасы аман.
Dialogue: 0,0:06:51.66,0:06:53.53,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:53.53,0:06:55.92,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:06:55.92,0:06:59.07,Default,,0,0,0,,Бұл әдеттен тыс рәсім болды, солай емес пе?
Dialogue: 0,0:06:59.07,0:07:02.04,Default,,0,0,0,,Мәселе мұрагерді ашуда.
Dialogue: 0,0:07:02.04,0:07:07.24,Default,,0,0,0,,Менің ойымша, бұл Киба үшін де билік ретінде қызмет етеді.
Dialogue: 0,0:07:07.24,0:07:09.38,Default,,0,0,0,,Ол жарқыраған жоқ.
Dialogue: 0,0:07:09.38,0:07:11.77,Default,,0,0,0,,Иә? Бұл жарқыраған қылыш
Dialogue: 0,0:07:11.77,0:07:13.77,Default,,0,0,0,,Аңыз бойынша болса➡
Dialogue: 0,0:07:13.77,0:07:17.19,Default,,0,0,0,,Нағыз мұрагердің қолына түссе, жарқырайды.
Dialogue: 0,0:07:17.19,0:07:20.24,Default,,0,0,0,,Бұл жай ғана ертегі
Dialogue: 0,0:07:20.24,0:07:23.69,Default,,0,0,0,,Батыстан келгендер де болған шығар.
Dialogue: 0,0:07:23.69,0:07:27.06,Default,,0,0,0,,Өйткені бұл Киба көтерілісі болған уақытта болды➡
Dialogue: 0,0:07:27.06,0:07:29.73,Default,,0,0,0,,Жалғастыру арқылы аңызға айналды
Dialogue: 0,0:07:29.73,0:07:32.09,Default,,0,0,0,,Бұл шынайы болуы мүмкін емес.
Dialogue: 0,0:07:32.09,0:07:34.44,Default,,0,0,0,,Бала кезінен ➡
Dialogue: 0,0:07:34.44,0:07:36.94,Default,,0,0,0,,Өйткені ол аңызды жақсы көретін.
Dialogue: 0,0:07:38.88,0:07:41.78,Default,,0,0,0,,Крей планетасы болған болса→
Dialogue: 0,0:07:41.78,0:07:44.38,Default,,0,0,0,,Бұл қылыш Крэйден шыққан шығар
Dialogue: 0,0:07:46.35,0:07:49.74,Default,,0,0,0,,Не болды. <<Ой, құттықтаймын, Шион-кун.
Dialogue: 0,0:07:49.74,0:07:52.41,Default,,0,0,0,,Бұл өте тамаша болды.
Dialogue: 0,0:07:52.41,0:07:55.08,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:07:55.08,0:08:00.03,Default,,0,0,0,,Узуки Егер сіз де Кибаның мүшесі болсаңыз, неге сәл күштірек болмасқа!
Dialogue: 0,0:08:00.03,0:08:02.03,Default,,0,0,0,,Кешіріңіз, аға
Dialogue: 0,0:08:02.03,0:08:06.40,Default,,0,0,0,,Мен сіз қайтадан бос сөзге ақша салып, сәтсіздікке ұшырағаныңызды естідім.
Dialogue: 0,0:08:06.40,0:08:11.29,Default,,0,0,0,,Ах, бұл болашақта барлығына көмектесетіні сөзсіз.
Dialogue: 0,0:08:11.29,0:08:14.08,Default,,0,0,0,,Әзірше ерте...
Dialogue: 0,0:08:14.08,0:08:16.56,Default,,0,0,0,,Мен бұл сылтауды естуден шаршадым.
Dialogue: 0,0:08:16.56,0:08:19.05,Default,,0,0,0,,Бүгін мереке
Dialogue: 0,0:08:19.05,0:08:21.90,Default,,0,0,0,,Узуки мырза, қарсы болмасаңыз, мен сусын алғым келеді.
Dialogue: 0,0:08:21.90,0:08:25.81,Default,,0,0,0,,Ух, иә, мені кешіріңіз, Шион-кун.
Dialogue: 0,0:08:25.81,0:08:27.81,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:29.69,0:08:34.75,Default,,0,0,0,,Узуки-сан да бұл жердің игілігі үшін істеп жатыр.
Dialogue: 0,0:08:34.75,0:08:38.25,Default,,0,0,0,,Ол үшін Киба есімі тым маңызды.
Dialogue: 0,0:08:41.24,0:08:43.36,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:08:43.36,0:08:46.08,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:46.08,0:08:49.75,Default,,0,0,0,,Мен соншалықты үлкен нәрсені істей алмаймын.
Dialogue: 0,0:08:49.75,0:08:54.22,Default,,0,0,0,,Олай болса, менімен келісімің осымен аяқталады.
Dialogue: 0,0:08:54.22,0:08:57.74,Default,,0,0,0,,Сіз мәңгі Киба кланының мүшесі боласыз.
Dialogue: 0,0:08:57.74,0:08:59.76,Default,,0,0,0,,Уф, бұл...
Dialogue: 0,0:08:59.76,0:09:01.81,Default,,0,0,0,,[ТЕЛ] Мен дайынмын.
Dialogue: 0,0:09:01.81,0:09:04.91,Default,,0,0,0,,[TEL] Сізге бар болғаны триггерді тартыңыз.
Dialogue: 0,0:09:04.91,0:09:07.70,Default,,0,0,0,,(Қоңырауды ажырату дыбысы)
Dialogue: 0,0:09:07.70,0:09:10.73,Default,,0,0,0,,Узуки ағай. Эй!
Dialogue: 0,0:09:10.73,0:09:12.85,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:09:12.85,0:09:15.59,Default,,0,0,0,,Иә? Жоқ, аа, хаха...
Dialogue: 0,0:09:15.59,0:09:18.76,Default,,0,0,0,,Эй, эй, бұл ештеңе емес.
Dialogue: 0,0:09:18.76,0:09:21.76,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:09:27.77,0:09:32.24,Default,,0,0,0,,Сатып алуға бірнеше кросс-холдинг серіктестері жауап берген сияқты.
Dialogue: 0,0:09:32.24,0:09:34.19,Default,,0,0,0,,ｴｰｽ･ｺｰﾎﾟﾚｰｼｮﾝ？
Dialogue: 0,0:09:34.19,0:09:37.28,Default,,0,0,0,,Қағаз компаниясы болуы мүмкін
Dialogue: 0,0:09:37.28,0:09:41.38,Default,,0,0,0,,Менің әдемі жерімді ешкімге пара беруге тырысуға ешқашан жол бермеймін.
Dialogue: 0,0:09:43.40,0:09:45.40,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,0:09:47.39,0:09:49.99,Default,,0,0,0,,Ештеңеге алаңдамау керек.
Dialogue: 0,0:10:02.75,0:10:06.41,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:10:06.41,0:10:08.36,Default,,0,0,0,,Иә
Dialogue: 0,0:10:08.36,0:10:12.20,Default,,0,0,0,,[ТЕЛ] Эй, танысқаныма қуаныштымын, Кибаның мұрагері.
Dialogue: 0,0:10:12.20,0:10:15.40,Default,,0,0,0,,[Радио] Бұл Эйс. Эйс!?
Dialogue: 0,0:10:15.40,0:10:20.39,Default,,0,0,0,,Дұрыс. Қазіргі таңда қызу талқыға түскен Ace корпорациясының өкілі.
Dialogue: 0,0:10:20.39,0:10:26.41,Default,,0,0,0,,[TEL]Ой, егер сіз оғаш нәрсе жасасаңыз, сізді бірден өшіреді.
Dialogue: 0,0:10:26.41,0:10:28.44,Default,,0,0,0,,Шынымен бе? Оған екеуі неге керек болды?
Dialogue: 0,0:10:28.44,0:10:30.56,Default,,0,0,0,,[ТЕЛ] Күте тұрыңыз, бұл телефон қоңырауы...
Dialogue: 0,0:10:30.56,0:10:34.57,Default,,0,0,0,,[TEL] Мен сізге электрондық пошта арқылы орналасқан жерді жіберемін, сондықтан бүгін кешкі сағат 8-де келіңіз.
Dialogue: 0,0:10:34.57,0:10:37.24,Default,,0,0,0,,[TEL]Бұл барлық адамдар үшін дұрыс емес.
Dialogue: 0,0:10:37.24,0:10:40.27,Default,,0,0,0,,[ТЕЛ] Сондай-ақ сіздің адал күтушіге.
Dialogue: 0,0:10:40.27,0:10:44.87,Default,,0,0,0,,Ал Киминчидің семсері ше?
Dialogue: 0,0:10:47.06,0:10:51.37,Default,,0,0,0,,[ТЕЛ] Мұны жасамаңыз. Маңызды нәрселерден сақ болыңыз ➡
Dialogue: 0,0:10:51.37,0:10:53.87,Default,,0,0,0,,Мен оны құлыптауым керек.
Dialogue: 0,0:10:58.74,0:11:01.43,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:11:01.43,0:11:09.43,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:11:56.90,0:12:00.24,Default,,0,0,0,,Мм! Хмм!
Dialogue: 0,0:12:00.24,0:12:03.36,Default,,0,0,0,,Узуки аға!?
Dialogue: 0,0:12:03.36,0:12:08.06,Default,,0,0,0,,Тамаша, тамаша. Өзіңіз келген сияқтысыз.
Dialogue: 0,0:12:08.06,0:12:11.23,Default,,0,0,0,,Сіз Эйссіз бе?
Dialogue: 0,0:12:11.23,0:12:15.74,Default,,0,0,0,,А... Сіз гакидің сіз ойлағаннан да көп болғанына таң қалдыңыз ба?
Dialogue: 0,0:12:15.74,0:12:17.92,Default,,0,0,0,,Бұл өзара, солай ма?
Dialogue: 0,0:12:17.92,0:12:20.02,Default,,0,0,0,,Кибаның мұрагері
Dialogue: 0,0:12:22.08,0:12:24.24,Default,,0,0,0,,Сіз Узуки мырзаға не істедіңіз?
Dialogue: 0,0:12:24.24,0:12:27.21,Default,,0,0,0,,Жоқ, егер менің мұрагер қылышым болса➡
Dialogue: 0,0:12:27.21,0:12:30.93,Default,,0,0,0,,Егер мен саған айтсам, сен де мұрагер бола аласың➡
Dialogue: 0,0:12:30.93,0:12:34.53,Default,,0,0,0,,Қария, байыпты алып келдім. Ахаха!
Dialogue: 0,0:12:37.02,0:12:41.08,Default,,0,0,0,,Осының бәрінен не пайда?
Dialogue: 0,0:12:41.08,0:12:44.88,Default,,0,0,0,,Байлардың не ойлайтыны маған бәрібір!
Dialogue: 0,0:12:44.88,0:12:46.92,Default,,0,0,0,,Сіздің бизнесіңіз қандай?
Dialogue: 0,0:12:46.92,0:12:49.07,Default,,0,0,0,,Ал, иә, асығыс.
Dialogue: 0,0:12:49.07,0:12:54.52,Default,,0,0,0,,Кими, саған ұнады ма? Авангард
Dialogue: 0,0:12:54.52,0:12:56.86,Default,,0,0,0,,Мен де тәуелдімін.
Dialogue: 0,0:12:56.86,0:12:58.90,Default,,0,0,0,,Ұрыс туралы не айтасыз?
Dialogue: 0,0:12:58.90,0:13:01.90,Default,,0,0,0,,Бас тарт!
Dialogue: 0,0:13:01.90,0:13:07.24,Default,,0,0,0,,Олай болса, сен менімен шайқасасың, егер жеңсең, мен саған қылышты қайтарамын.
Dialogue: 0,0:13:07.24,0:13:09.87,Default,,0,0,0,,Кибаны алуды тоқтатыңыз
Dialogue: 0,0:13:09.87,0:13:16.10,Default,,0,0,0,,Бұл біз өз өмірімізге, жүздеген миллиард долларға бәс тігетін ойын.
Dialogue: 0,0:13:16.10,0:13:18.40,Default,,0,0,0,,Сіз шайқаласыз, солай ма?
Dialogue: 0,0:15:00.40,0:15:02.39,Default,,0,0,0,,Шехер астрономиялық кітапханасының басқарма бастығы, «Юстиция» обсерваториясында
Dialogue: 0,0:15:02.39,0:15:06.57,Default,,0,0,0,,Кибаны сатып алу 80% аяқталды, солай емес пе?
Dialogue: 0,0:15:06.57,0:15:09.43,Default,,0,0,0,,Акционерлерді біріктіру аяқталды
Dialogue: 0,0:15:09.43,0:15:12.70,Default,,0,0,0,,Ертең таңертең бәрі менікі болады.
Dialogue: 0,0:15:12.70,0:15:15.90,Default,,0,0,0,,Іс тым жақсы болса да, бұл жалықтырады.
Dialogue: 0,0:15:15.90,0:15:17.88,Default,,0,0,0,,Толқу жеткіліксіз
Dialogue: 0,0:15:17.88,0:15:21.74,Default,,0,0,0,,Одан да ыстық! Мені одан сайын өртеп жіберетін бір толқу бар!
Dialogue: 0,0:15:21.74,0:15:24.11,Default,,0,0,0,,Бұл сіздің мотивіңіз ме?
Dialogue: 0,0:15:24.11,0:15:27.13,Default,,0,0,0,,Әрине, мен де ақша алғым келеді.
Dialogue: 0,0:15:27.13,0:15:30.08,Default,,0,0,0,,Мен не істеуім керек, кішкентай бала?
Dialogue: 0,0:15:30.08,0:15:33.70,Default,,0,0,0,,Жоқ, Шион-кун! Бұл жігіт қауіпті!
Dialogue: 0,0:15:33.70,0:15:35.90,Default,,0,0,0,,Қандай тұзақ күтіп тұр?
Dialogue: 0,0:15:35.90,0:15:38.89,Default,,0,0,0,,Узуки ағай, үндемеңіз!
Dialogue: 0,0:15:38.89,0:15:41.39,Default,,0,0,0,,Мен Кибаның мұрагерімін.
Dialogue: 0,0:15:41.39,0:15:46.10,Default,,0,0,0,,Мен мұндай жексұрын адамнан ешқашан жеңілмеймін!
Dialogue: 0,0:15:46.10,0:15:48.10,Default,,0,0,0,,Zincir секілді жалғасқан
Dialogue: 0,0:15:50.07,0:15:54.74,Default,,0,0,0,,Осындай жағдайда сіз де алданып қаласыз ба деп уайымдайсыз, солай ма?
Dialogue: 0,0:15:54.74,0:15:57.86,Default,,0,0,0,,Бір-бірімізбен әділ күресу үшін➡
Dialogue: 0,0:15:57.86,0:16:00.58,Default,,0,0,0,,Қапта күрес
Dialogue: 0,0:16:00.58,0:16:05.05,Default,,0,0,0,,Жаңа пакетпен импровизацияланған палуба жасап, шайқас
Dialogue: 0,0:16:05.05,0:16:08.73,Default,,0,0,0,,Қандай карта шығады және ол қандай палуба болады?➡
Dialogue: 0,0:16:08.73,0:16:11.12,Default,,0,0,0,,Барлығы сәттілікке байланысты
Dialogue: 0,0:16:11.12,0:16:13.44,Default,,0,0,0,,Сіз оны қаншалықты пайдалана аласыз→
Dialogue: 0,0:16:13.44,0:16:15.54,Default,,0,0,0,,Сонда бұл күрескердің шеберлігіне байланысты ма?
Dialogue: 0,0:16:17.56,0:16:19.91,Default,,0,0,0,,Екі палубада әртүрлі кландар бар
Dialogue: 0,0:16:19.91,0:16:23.35,Default,,0,0,0,,Бірақ триггер мен дағдылар әртүрлі кландар болса да➡
Dialogue: 0,0:16:23.35,0:16:25.35,Default,,0,0,0,,Оны қолдануға болатынын шешіңіз\NЕгер бұл
Dialogue: 0,0:16:25.35,0:16:28.40,Default,,0,0,0,,болмаса, бұл төбелес болмайды.
Dialogue: 0,0:16:28.40,0:16:31.86,Default,,0,0,0,,《Шион: 8 триггер, толық қорғаушы жоқ
Dialogue: 0,0:16:31.86,0:16:34.21,Default,,0,0,0,,Тек бір G бірлігі
Dialogue: 0,0:16:34.21,0:16:36.90,Default,,0,0,0,,1 және 2-сыныптар біршама топтастырылған➡
Dialogue: 0,0:16:36.90,0:16:40.43,Default,,0,0,0,,Мұны біздің тірек ретінде пайдаланып, жылдам шабуыл жасаудан басқа амалымыз жоқ》
Dialogue: 0,0:16:40.43,0:16:42.53,Default,,0,0,0,,Мен дайынмын.
Dialogue: 0,0:16:44.72,0:16:46.72,Default,,0,0,0,,бастайық
Dialogue: 0,0:16:46.72,0:16:49.64,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:16:49.64,0:16:51.53,Default,,0,0,0,,ﾄﾞﾛｰ
Dialogue: 0,0:16:51.53,0:16:54.53,Default,,0,0,0,,Атпен жүру. Шеберлікпен қозғалыңыз
Dialogue: 0,0:16:54.53,0:16:58.03,Default,,0,0,0,,《Триггерлер аз болса, оны қорғау қиын болады.
Dialogue: 0,0:16:58.03,0:17:01.22,Default,,0,0,0,,Бар болғаны 10 қаптамадан толық қорғаушы ала алмайсыз.
Dialogue: 0,0:17:01.22,0:17:04.62,Default,,0,0,0,,Бұл жағдайда...
Dialogue: 0,0:17:04.62,0:17:07.86,Default,,0,0,0,,Қорғанудан гөрі шабуыл жасаған тиімді.
Dialogue: 0,0:17:07.86,0:17:11.03,Default,,0,0,0,,ﾗｲﾄﾞ ﾛｯｸｸﾗｲﾑ･ﾄﾞﾗｸﾞｰﾝ
Dialogue: 0,0:17:11.03,0:17:13.03,Default,,0,0,0,,Бұлыңғыр Starveider темір
Dialogue: 0,0:17:13.03,0:17:15.74,Default,,0,0,0,,Nightmare Junior-ға қоңырау шалыңыз
Dialogue: 0,0:17:15.74,0:17:18.04,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:22.14,0:17:24.03,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ
Dialogue: 0,0:17:24.03,0:17:26.56,Default,,0,0,0,,ﾗｲﾄﾞ ﾛﾝﾊﾞｽ･ﾒｲｶﾞｽ
Dialogue: 0,0:17:26.56,0:17:30.20,Default,,0,0,0,,Бұлыңғыр жұлдызды үтікті атаңыз
Dialogue: 0,0:17:30.20,0:17:34.70,Default,,0,0,0,,Ромб Мейгаспен Риа теміріне шабуыл жасаңыз
Dialogue: 0,0:17:34.70,0:17:38.07,Default,,0,0,0,,《Тылға мақсатты түрде шабуыл жасап, дамуды ұзарту.
Dialogue: 0,0:17:38.07,0:17:42.03,Default,,0,0,0,,Үш G бірлігін пайдалану керек пе...》
Dialogue: 0,0:17:42.03,0:17:44.10,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:17:44.10,0:17:47.23,Default,,0,0,0,,Кибаның мұрагері?
Dialogue: 0,0:17:47.23,0:17:49.70,Default,,0,0,0,,Сізде бәрі бар
Dialogue: 0,0:17:49.70,0:17:52.74,Default,,0,0,0,,Ақша, билік және талант
Dialogue: 0,0:17:52.74,0:17:58.91,Default,,0,0,0,,Бірақ... сіз әлі шындықты білмейсіз.
Dialogue: 0,0:17:58.91,0:18:00.91,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:18:02.92,0:18:06.04,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:18:06.04,0:18:08.05,Default,,0,0,0,,Демалайық
Dialogue: 0,0:18:08.05,0:18:11.69,Default,,0,0,0,,Түн әлі ұзақ
Dialogue: 0,0:18:11.69,0:18:14.86,Default,,0,0,0,,ﾗｲﾄﾞ ｸﾞﾚｰﾄｺﾝﾎﾟｳｼﾞｬｰ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:18:14.86,0:18:16.86,Default,,0,0,0,,Әдемі аң таймері Алексис
Dialogue: 0,0:18:16.86,0:18:19.57,Default,,0,0,0,,Шайқас әпкесі Тэффиге қоңырау шалыңыз
Dialogue: 0,0:18:19.57,0:18:21.73,Default,,0,0,0,,Алексиспен бірге Янға шабуыл жасаңыз!
Dialogue: 0,0:18:21.73,0:18:23.69,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:18:23.69,0:18:26.74,Default,,0,0,0,,Ұлы композитор Айдаһармен бірге Авангардқа шабуыл жасаңыз
Dialogue: 0,0:18:26.74,0:18:28.69,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:18:28.69,0:18:30.74,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ!!
Dialogue: 0,0:18:30.74,0:18:32.74,Default,,0,0,0,,ｽﾀﾝﾄﾞﾄﾘｶﾞｰ
Dialogue: 0,0:18:34.76,0:18:37.07,Default,,0,0,0,,Ойындардағы әрекеттеріңізден өзгеше.
Dialogue: 0,0:18:37.07,0:18:40.17,Default,,0,0,0,,Бұл мен көтеріп жүрген дүниенің салмағы!
Dialogue: 0,0:18:42.36,0:18:44.36,Default,,0,0,0,,Алексис стенді
Dialogue: 0,0:18:44.36,0:18:47.13,Default,,0,0,0,,Nightmare Girl көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:47.13,0:18:49.13,Default,,0,0,0,,Мен жеңген адаммын!
Dialogue: 0,0:18:51.01,0:18:53.42,Default,,0,0,0,,Алексиспен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:53.42,0:18:55.35,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:18:55.35,0:18:58.05,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:18:58.05,0:19:01.85,Default,,0,0,0,,《Тағы бір нүкте, келесі қадамды мен шешемін》
Dialogue: 0,0:19:04.03,0:19:07.91,Default,,0,0,0,,Айтпақшы, Киминчидің мұрасы➡
Dialogue: 0,0:19:07.91,0:19:11.30,Default,,0,0,0,,Мұрагер болуды дәлелдейтін мұрагерлік.
Dialogue: 0,0:19:11.30,0:19:13.19,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:19:13.19,0:19:15.25,Default,,0,0,0,,Аңыз бар, солай ма?
Dialogue: 0,0:19:15.25,0:19:19.66,Default,,0,0,0,,Қылыш шын иесіне тапсырылғанда жанады дейді.
Dialogue: 0,0:19:19.66,0:19:22.03,Default,,0,0,0,,Бұл жай ғана ертегі
Dialogue: 0,0:19:22.03,0:19:25.08,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:19:25.08,0:19:28.43,Default,,0,0,0,,Бірақ... көрдің бе?
Dialogue: 0,0:19:28.43,0:19:38.93,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:38.93,0:19:41.80,Default,,0,0,0,,Мен оны жаңа ғана қолданып көрдім➡
Dialogue: 0,0:19:41.80,0:19:45.60,Default,,0,0,0,,Бұл тек қарт болғанда ғана болады, солай ма?
Dialogue: 0,0:19:45.60,0:19:49.20,Default,,0,0,0,,Шион-кун, бұл нені білдіреді деп ойлаймын...
Dialogue: 0,0:19:51.69,0:19:54.58,Default,,0,0,0,,Жаныңда болсам да, аға➡
Dialogue: 0,0:19:54.58,0:19:57.20,Default,,0,0,0,,Сен менің әкем болғанда да жарқыраған жоқ.
Dialogue: 0,0:19:57.20,0:20:02.75,Default,,0,0,0,,Інісі болғандықтан ғана қылышқа қол тигізбеді.
Dialogue: 0,0:20:02.75,0:20:07.74,Default,,0,0,0,,Бірақ бұл менің мұрагер болғанымды білдіре ме?
Dialogue: 0,0:20:07.74,0:20:12.14,Default,,0,0,0,,Мұның бәрі менікі ме?
Dialogue: 0,0:20:12.14,0:20:14.70,Default,,0,0,0,,Бұл қылыш пен бұл жер де!
Dialogue: 0,0:20:14.70,0:20:16.70,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:20:16.70,0:20:20.32,Default,,0,0,0,,Эй, мен сонда боламын➡
Dialogue: 0,0:20:20.32,0:20:22.32,Default,,0,0,0,,Менің кетуім керек шығар, солай ма?
Dialogue: 0,0:20:24.19,0:20:28.79,Default,,0,0,0,,Мен мұрагермін. Мен Кибаны қорғауым керек!
Dialogue: 0,0:20:28.79,0:20:32.39,Default,,0,0,0,,Бұл дұрыс емес пе, Шион-кун?
Dialogue: 0,0:20:34.40,0:20:36.77,Default,,0,0,0,,Қайсысы да жақсы.
Dialogue: 0,0:20:36.77,0:20:39.76,Default,,0,0,0,,Мен үлкен ойын ойнай алатын болсам, бұл маған жақсы.
Dialogue: 0,0:20:39.76,0:20:42.89,Default,,0,0,0,,Не істеу керек? Жалғастырасыз ба?
Dialogue: 0,0:20:42.89,0:20:46.76,Default,,0,0,0,,Әлде нағыз мұрагер болған қария ма?
Dialogue: 0,0:20:46.76,0:20:48.83,Default,,0,0,0,,I
Dialogue: 0,0:20:48.83,0:20:51.63,Default,,0,0,0,,Бұл менмін. Әсем жерді қорғайтын менмін!
Dialogue: 0,0:20:53.54,0:20:56.19,Default,,0,0,0,,Иә, қадамдық ұрпақ
Dialogue: 0,0:20:56.19,0:21:00.56,Default,,0,0,0,,ｺｰﾙ ﾀﾞｰｸｻｲﾄﾞ･ﾌﾟﾘﾝｾｽ ﾏｽｶﾚｰﾄﾞﾊﾞﾆｰ
Dialogue: 0,0:21:00.56,0:21:03.73,Default,,0,0,0,,Қайғылы кездейсоқ ғаламда→
Dialogue: 0,0:21:03.73,0:21:05.71,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:21:05.71,0:21:07.72,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:21:07.72,0:21:09.77,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:21:09.77,0:21:13.27,Default,,0,0,0,,ｹﾞｯﾄ ﾄﾞﾛｰﾄﾘｶﾞｰ
Dialogue: 0,0:21:13.27,0:21:15.37,Default,,0,0,0,,Күш Қараңғы беттегі ханшайымға түседі
Dialogue: 0,0:21:17.36,0:21:19.56,Default,,0,0,0,,Бірақ біз міндетті түрде жеңеміз!
Dialogue: 0,0:21:19.56,0:21:22.95,Default,,0,0,0,,Дұрыс, Кибаның мұрагері
Dialogue: 0,0:21:22.95,0:21:25.02,Default,,0,0,0,,​​Жоқ, олай емес.
Dialogue: 0,0:21:25.02,0:21:29.04,Default,,0,0,0,,Мұрагер сол қария еді ғой?
Dialogue: 0,0:21:29.04,0:21:33.86,Default,,0,0,0,,Олай болса, сен кімсің?
Dialogue: 0,0:21:33.86,0:21:36.38,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:21:36.38,0:21:40.28,Default,,0,0,0,,Сізде біліктілік болмаса да, Кибаны қолға алмақшысыз ба?
Dialogue: 0,0:21:40.28,0:21:43.37,Default,,0,0,0,,Бұл жай ғана өтірікші емес пе?
Dialogue: 0,0:21:43.37,0:21:45.40,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:21:45.40,0:21:47.71,Default,,0,0,0,,Бұл жай ғана елес болды.
Dialogue: 0,0:21:47.71,0:21:52.21,Default,,0,0,0,,Сіз сенген және өмір сүрген барлық нәрсе
Dialogue: 0,0:21:52.21,0:21:54.23,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ！
Dialogue: 0,0:21:54.23,0:21:56.37,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:21:56.37,0:22:00.40,Default,,0,0,0,,Бұл шындық, жалған мұрагер!
Dialogue: 0,0:22:00.40,0:22:03.54,Default,,0,0,0,,Ахахха! ауызыңды жап!
Dialogue: 0,0:22:03.54,0:22:05.54,Default,,0,0,0,,Алексиспен шабуыл!
Dialogue: 0,0:22:09.43,0:22:13.58,Default,,0,0,0,,((Кибаның мұрагері болуға лайықты күшті адам бол.
Dialogue: 0,0:22:13.58,0:22:15.68,Default,,0,0,0,,Иә))
Dialogue: 0,0:22:15.68,0:22:18.22,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:22:18.22,0:22:20.69,Default,,0,0,0,,Авангардқа Колосспен шабуыл жасаңыз!
Dialogue: 0,0:22:20.69,0:22:25.26,Default,,0,0,0,,Дағдыны белсендіру Алекситті палубаның төменгі жағына жіберіңіз➡
Dialogue: 0,0:22:25.26,0:22:28.58,Default,,0,0,0,,Ромб мейгасын палубаның түбіне қойыңыз!
Dialogue: 0,0:22:28.58,0:22:34.70,Default,,0,0,0,,)
Dialogue: 0,0:22:34.70,0:22:36.72,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:22:36.72,0:22:38.72,Default,,0,0,0,,Джинимен шабуыл!
Dialogue: 0,0:22:38.72,0:22:41.19,Default,,0,0,0,,Мен бәрін қорғауға ант бердім.
Dialogue: 0,0:22:41.19,0:22:44.26,Default,,0,0,0,,Сізде тіпті біліктілік жоқ па?
Dialogue: 0,0:22:44.26,0:22:47.03,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:22:47.03,0:22:49.08,Default,,0,0,0,,Менің кезегім
Dialogue: 0,0:22:49.08,0:22:51.19,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:22:51.19,0:22:56.91,Default,,0,0,0,,Blitz Spear Dragon Nightmare Junior деп атаңыз
Dialogue: 0,0:22:56.91,0:23:01.86,Default,,0,0,0,,Мен жалған өтірікшіден жеңіле алмаймын.
Dialogue: 0,0:23:01.86,0:23:06.22,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝﾌﾞﾚｲｸ
Dialogue: 0,0:23:06.22,0:23:08.24,Default,,0,0,0,,3 G4s
Dialogue: 0,0:23:08.24,0:23:10.61,Default,,0,0,0,,Олардың екеуі бірдей➡
Dialogue: 0,0:23:10.61,0:23:13.38,Default,,0,0,0,,Менде де бар.
Dialogue: 0,0:23:13.38,0:23:17.45,Default,,0,0,0,,Барлық блоктар үшін қуат плюс 2000
Dialogue: 0,0:23:17.45,0:23:20.75,Default,,0,0,0,,Бұл шындық, балам.
Dialogue: 0,0:23:25.27,0:23:27.37,Default,,0,0,0,,Ойын аяқталды
Dialogue: 0,0:23:33.25,0:23:38.18,Default,,0,0,0,,Шын мәнінде, Кибаны сатып алу аяқталуға жақын➡
Dialogue: 0,0:23:38.18,0:23:40.57,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:23:40.57,0:23:42.87,Default,,0,0,0,,Жағдай 50-50 →
Dialogue: 0,0:23:42.87,0:23:46.88,Default,,0,0,0,,Жоқ, біз кемшілігіміз, шамамен 4-тен 6-ға дейін.
Dialogue: 0,0:23:46.88,0:23:52.53,Default,,0,0,0,,Бірақ бұл мәселені шешеді.
Dialogue: 0,0:23:52.53,0:23:54.70,Default,,0,0,0,,Арзан арандатуға міну➡
Dialogue: 0,0:23:54.70,0:23:57.57,Default,,0,0,0,,Киба отбасын ойынға бәс тігу →
Dialogue: 0,0:23:57.57,0:23:59.61,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:23:59.61,0:24:05.06,Default,,0,0,0,,Осындай мұрагердің қолында болған дүниенің болашағы бар ма?
Dialogue: 0,0:24:05.06,0:24:10.98,Default,,0,0,0,,Саяси және іскер топтағы ірі тұлғалар да бұл туралы байыпты ойлана бастағанына сенімдімін.
Dialogue: 0,0:24:10.98,0:24:13.48,Default,,0,0,0,,О, және...
Dialogue: 0,0:24:15.70,0:24:18.62,Default,,0,0,0,,Сіз бұған шынымен сендіңіз бе?
Dialogue: 0,0:24:18.62,0:24:22.54,Default,,0,0,0,,Шындықта қылыштың жарқырауы мүмкін емес.
Dialogue: 0,0:24:22.54,0:24:26.70,Default,,0,0,0,,Ойындар жеңіске жету үшін ойналады.
Dialogue: 0,0:24:26.70,0:24:28.73,Default,,0,0,0,,Обочама
Dialogue: 0,0:24:28.73,0:24:34.03,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:24:42.28,0:24:46.04,Default,,0,0,0,,<<Ей, естідің бе? Мен Кибаны ұрлап кеткенін естідім.
Dialogue: 0,0:24:46.04,0:24:48.10,Default,,0,0,0,,≪Жұмыс немесе үй сияқты бірдеңе➡
Dialogue: 0,0:24:48.10,0:24:50.70,Default,,0,0,0,,Ағам алып кеткен көрінеді.
Dialogue: 0,0:25:09.19,0:25:14.91,Default,,0,0,0,,Ата-аналар жергілікті жердегі туыстарына сүйенеді және өз өмірлерін қалпына келтіру үшін әрекеттерді бастайды
Dialogue: 0,0:25:14.91,0:25:17.07,Default,,0,0,0,,Мен Ивакураның артымнан жүруін өтіндім.
Dialogue: 0,0:25:17.07,0:25:21.95,Default,,0,0,0,,Мен осында қалып, Эйсті қуамын
Dialogue: 0,0:25:21.95,0:25:27.06,Default,,0,0,0,,Мен мұның осылай аяқталуына жол бермеймін. Мен оны шешуге сенімді боламын.
Dialogue: 0,0:25:27.06,0:25:31.53,Default,,0,0,0,,Мен мұны түсінемін, бірақ жалғыз болған дұрыс па?
Dialogue: 0,0:25:31.53,0:25:34.12,Default,,0,0,0,,Мен қайда болсам да менмін
Dialogue: 0,0:25:34.12,0:25:38.12,Default,,0,0,0,,Vanguard және G Quest арқылы жалғастырыңыз. Жарайды.
Dialogue: 0,0:25:40.02,0:25:42.07,Default,,0,0,0,,ｼｵﾝ…
Dialogue: 0,0:25:42.07,0:25:44.11,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:25:44.11,0:25:47.20,Default,,0,0,0,,Қарт театршыл да болған.
Dialogue: 0,0:25:47.20,0:25:50.40,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:25:50.40,0:25:53.37,Default,,0,0,0,,А, сен кімсің?
Dialogue: 0,0:25:53.37,0:25:55.75,Default,,0,0,0,,Шионды жеңіп қана қойған жоқпын➡
Dialogue: 0,0:25:55.75,0:25:58.61,Default,,0,0,0,,Бірнеше компанияны жылжыту мүмкіндігіне ие болыңыз➡
Dialogue: 0,0:25:58.61,0:26:01.71,Default,,0,0,0,,Тіпті қиын шарттар туралы біледі.
Dialogue: 0,0:26:01.71,0:26:04.03,Default,,0,0,0,,Аа, солай...
Dialogue: 0,0:26:04.03,0:26:06.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:06.03,0:26:09.45,Default,,0,0,0,,Менің бастығым менің бастығым, оның ішінде мынау →
Dialogue: 0,0:26:09.45,0:26:13.05,Default,,0,0,0,,Мен сіздермен әртүрлі нәрселер туралы сөйлескім келеді.
Dialogue: 0,0:27:46.68,0:27:51.45,Default,,0,0,0,,《Ибуки: Үштіктің бірі, Киба Шионның қиындығы
Dialogue: 0,0:27:51.45,0:27:54.45,Default,,0,0,0,,Егер бұл да оның схемаларының бірі болса》
Dialogue: 0,0:28:00.61,0:28:03.41,Default,,0,0,0,,Біраз уақыт болды, Кай.
Dialogue: 0,0:30:33.43,0:30:36.10,Default,,0,0,0,,Бұл жолы біз өте танымал ойынды зерттейміз. Бірақ оған дейін ➡
Dialogue: 0,0:30:36.10,0:30:40.09,Default,,0,0,0,,Маңызды пресс-конференцияға қатысыңыз!
Dialogue: 0,0:30:40.09,0:30:43.59,Default,,0,0,0,,Біріншіден, ол Токио автосалонында 2015➡ көрсетілді
Dialogue: 0,0:30:43.59,0:30:45.64,Default,,0,0,0,,Таңдаулы машиналармен таныстыру
Dialogue: 0,0:30:45.64,0:30:47.64,Default,,0,0,0,,Daihatsu стендінде→
Dialogue: 0,0:30:49.90,0:30:51.87,Default,,0,0,0,,Аймақтың әсемдігін қайта ашыңыз➡
Dialogue: 0,0:30:51.87,0:30:54.32,Default,,0,0,0,,Көлікпен өмірді қызықты ету➡
Dialogue: 0,0:30:54.32,0:30:57.12,Default,,0,0,0,,«Сені және Жапонияны қызықты ет» жобасы басталады
Dialogue: 0,0:30:58.62,0:31:04.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory