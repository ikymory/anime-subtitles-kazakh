Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:28.85,0:01:31.85,Default,,0,0,0,,Ақыры осында. (Сион) Ах.
Dialogue: 0,0:01:33.92,0:01:36.92,Default,,0,0,0,,Олай болса кеттік. Кәне!
Dialogue: 0,0:04:57.89,0:05:01.00,Default,,0,0,0,,Эй, бүгін демалыс па?
Dialogue: 0,0:05:01.00,0:05:04.95,Default,,0,0,0,,Жоқ, бұл ашылу күні болуы керек.
Dialogue: 0,0:05:04.95,0:05:09.66,Default,,0,0,0,,Бірақ квест үшін тым аз адам бар емес пе?
Dialogue: 0,0:05:09.66,0:05:12.09,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,0:05:12.09,0:05:15.83,Default,,0,0,0,,Ал, мен олардың ойын орнында екеніне сенімдімін.
Dialogue: 0,0:05:15.83,0:05:17.85,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:17.85,0:05:22.80,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:22.80,0:05:24.90,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:05:24.90,0:05:26.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:28.91,0:05:32.23,Default,,0,0,0,,Бүгінгі күн үшін рахмет. (Луна) Қайта келші.
Dialogue: 0,0:05:32.23,0:05:34.86,Default,,0,0,0,,Луна Аму-чан
Dialogue: 0,0:05:34.86,0:05:36.86,Default,,0,0,0,,Ламирабидің қол алысу оқиғасы?
Dialogue: 0,0:05:46.89,0:05:50.01,Default,,0,0,0,,Иә? Барлығы үйіне кетіп жатыр ма?
Dialogue: 0,0:05:50.01,0:05:52.71,Default,,0,0,0,,Квест басталғалы тұр
Dialogue: 0,0:05:52.71,0:05:55.07,Default,,0,0,0,,Әрқашан осылай
Dialogue: 0,0:05:55.07,0:05:57.20,Default,,0,0,0,,Басында қатысушылар көп болды➡
Dialogue: 0,0:05:57.20,0:05:59.55,Default,,0,0,0,,Көрермендер де көп болды.
Dialogue: 0,0:05:59.55,0:06:02.19,Default,,0,0,0,,Квесттің қиындық деңгейі тым жоғары➡
Dialogue: 0,0:06:02.19,0:06:04.91,Default,,0,0,0,,Адамдар бірте-бірте келуді тоқтатты.
Dialogue: 0,0:06:04.91,0:06:08.21,Default,,0,0,0,,Ибуки-сан мен Кай-сан тым күшті
Dialogue: 0,0:06:10.18,0:06:12.87,Default,,0,0,0,,Келетін адамдар біздің жанкүйерлер➡
Dialogue: 0,0:06:12.87,0:06:15.50,Default,,0,0,0,,Тек өз шеберлігіне сенімді адамдар
Dialogue: 0,0:06:15.50,0:06:17.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:17.54,0:06:19.99,Default,,0,0,0,,Бұл филиалда не болып жатыр?
Dialogue: 0,0:06:19.99,0:06:22.51,Default,,0,0,0,,Бұл керемет G квесті, солай ма?
Dialogue: 0,0:06:22.51,0:06:24.55,Default,,0,0,0,,Соғысса жақсы болар еді
Dialogue: 0,0:06:24.55,0:06:27.83,Default,,0,0,0,,Маған да ыңғайлы. Мен шоғырлана алатындай сезінемін.
Dialogue: 0,0:06:27.83,0:06:30.39,Default,,0,0,0,,Бұл рас...
Dialogue: 0,0:06:30.39,0:06:32.57,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:06:32.57,0:06:35.07,Default,,0,0,0,,Бұл жерде филиал меңгерушісінің саясаты сияқты.
Dialogue: 0,0:06:46.20,0:06:49.20,Default,,0,0,0,,Филиал менеджері, ол басталғалы жатыр.
Dialogue: 0,0:06:49.20,0:06:52.76,Default,,0,0,0,,Барлығы Ибуки мырза мен Кай мырзаға қалды➡
Dialogue: 0,0:06:52.76,0:06:54.69,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:06:54.69,0:06:56.83,Default,,0,0,0,,Бірақ филиал бастығынсыз...
Dialogue: 0,0:06:56.83,0:06:59.21,Default,,0,0,0,,Мен сені қазір жібере алмаймын.
Dialogue: 0,0:06:59.21,0:07:01.70,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:01.70,0:07:03.74,Default,,0,0,0,,Бұл зерттеу!
Dialogue: 0,0:07:03.74,0:07:06.25,Default,,0,0,0,,мақсаты қандай?
Dialogue: 0,0:07:06.25,0:07:11.35,Default,,0,0,0,,Бүгін тек 21 қатысушы бар сияқты.
Dialogue: 0,0:07:17.50,0:07:20.04,Default,,0,0,0,,Маған мүлдем түсіну қиын.
Dialogue: 0,0:07:20.04,0:07:23.41,Default,,0,0,0,,Мен әлемнің үздік боксшыларымен бәсекеге түсе аламын➡
Dialogue: 0,0:07:23.41,0:07:26.73,Default,,0,0,0,,Неліктен қатысу көрсеткіші төмен?
Dialogue: 0,0:07:26.73,0:07:30.83,Default,,0,0,0,,Жоқ, бұл өте қиын...
Dialogue: 0,0:07:30.83,0:07:35.77,Default,,0,0,0,,Сіз әдеттегі Stargate филиалында Vanguard ойынын жылдам әрі тыныш ойнай аласыз➡
Dialogue: 0,0:07:35.77,0:07:39.37,Default,,0,0,0,,Мен оның қайтып оралғанын қалаймын. Хехе
Dialogue: 0,0:07:42.87,0:07:46.68,Default,,0,0,0,,Шынымен, бұл сізге керек нәрсе ғана ма?
Dialogue: 0,0:07:46.68,0:07:49.21,Default,,0,0,0,,[Майк] Күткеніңізге рахмет.
Dialogue: 0,0:07:49.21,0:07:53.17,Default,,0,0,0,,Біз енді Жұлдыз қақпасының бұтағы G квестін бастаймыз.
Dialogue: 0,0:07:53.17,0:07:55.89,Default,,0,0,0,,Ең алдымен, көрсетіңіз.
Dialogue: 0,0:07:55.89,0:07:58.82,Default,,0,0,0,,Бұл Тошики Кай мен Коджи Ибуки.
Dialogue: 0,0:07:58.82,0:08:23.83,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:23.83,0:08:25.87,Default,,0,0,0,,Ережелер өте қарапайым.
Dialogue: 0,0:08:25.87,0:08:28.19,Default,,0,0,0,,Командаңыздан екі адамды таңдаңыз➡
Dialogue: 0,0:08:28.19,0:08:31.39,Default,,0,0,0,,Мен бұл екеуімен төбелесемін.
Dialogue: 0,0:08:31.39,0:08:35.28,Default,,0,0,0,,Егер сіз бір рет болса да ұтып алсаңыз, сіз 10 белгі ұпайын аласыз.
Dialogue: 0,0:08:35.28,0:08:38.50,Default,,0,0,0,,Жеңілсең 1 ұпаймен аяқталады.
Dialogue: 0,0:08:38.50,0:08:40.58,Default,,0,0,0,,ﾌｯ
Dialogue: 0,0:08:40.58,0:08:44.08,Default,,0,0,0,,《Ол неге күледі...》
Dialogue: 0,0:08:48.52,0:08:51.14,Default,,0,0,0,,Олай болса, бәрі, нұсқаулар алғанша➡
Dialogue: 0,0:08:51.14,0:08:53.44,Default,,0,0,0,,Күту залында күтіңіз.
Dialogue: 0,0:08:58.85,0:09:01.54,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:09:01.54,0:09:04.91,Default,,0,0,0,,Ол күртешемен келді.
Dialogue: 0,0:09:04.91,0:09:07.84,Default,,0,0,0,,Ол кек алу үшін келген шығар.
Dialogue: 0,0:09:07.84,0:09:11.90,Default,,0,0,0,,Бірақ ол мұны өте жақсы біледі.
Dialogue: 0,0:09:11.90,0:09:13.90,Default,,0,0,0,,Мен сенен өзгешемін
Dialogue: 0,0:09:16.92,0:09:19.22,Default,,0,0,0,,өтіңіз ~ Осымен барамыз ба?
Dialogue: 0,0:09:35.52,0:09:39.71,Default,,0,0,0,,Шешім қабылданды! Бүгінгі жекпе-жекті Куроно мен Шионға тапсырамын.
Dialogue: 0,0:09:39.71,0:09:42.58,Default,,0,0,0,,Екеуі де туысқан болғандықтан, солай емес пе?
Dialogue: 0,0:09:42.58,0:09:45.66,Default,,0,0,0,,Куроно Коудзимен бірге Ибуки Шион Тошики Каймен бірге
Dialogue: 0,0:09:45.66,0:09:47.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:47.70,0:09:49.72,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,0:09:49.72,0:09:52.02,Default,,0,0,0,,Сіз оны шешкіңіз келеді, солай ма?
Dialogue: 0,0:09:54.04,0:09:57.68,Default,,0,0,0,,Бұл жаман. Рахмет Токоха
Dialogue: 0,0:09:57.68,0:10:00.21,Default,,0,0,0,,Керісінше, міндетті түрде жеңіске жетіңіз.
Dialogue: 0,0:10:00.21,0:10:03.67,Default,,0,0,0,,Ах! (команда)
Dialogue: 0,0:10:03.67,0:10:06.59,Default,,0,0,0,,[Спикер] Команда Үш рет байқап көріңіз Тошики Каймен қарсыласы➡
Dialogue: 0,0:10:06.59,0:10:09.09,Default,,0,0,0,,Тез дайындалыңыз
Dialogue: 0,0:10:17.16,0:10:19.16,Default,,0,0,0,,Ах! Шион-сан
Dialogue: 0,0:10:19.16,0:10:21.87,Default,,0,0,0,,Қазірдің өзінде басталып жатыр ма? О
Dialogue: 0,0:10:21.87,0:10:23.99,Default,,0,0,0,,Жекпе-жек Мен қараймын.
Dialogue: 0,0:10:23.99,0:10:27.56,Default,,0,0,0,,Менің келесі жұмысыма дейін біраз уақытым бар.
Dialogue: 0,0:10:27.56,0:10:31.66,Default,,0,0,0,,Бірақ осы уақытқа дейін барлық G-ques жеңіске жеткені таңқаларлық!
Dialogue: 0,0:10:31.66,0:10:34.68,Default,,0,0,0,,Осылай жүре берсек, жеңетін шығармыз, солай ма?
Dialogue: 0,0:10:34.68,0:10:37.37,Default,,0,0,0,,Әлі орындалуда
Dialogue: 0,0:10:37.37,0:10:40.74,Default,,0,0,0,,Бұдан былай оларды бір-бірден жинақтаймыз.
Dialogue: 0,0:10:40.74,0:10:44.04,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:10:44.04,0:10:47.51,Default,,0,0,0,,Луна да, мен де сені жақтаймыз, сондықтан бар күшіңізді салыңыз.
Dialogue: 0,0:10:47.51,0:10:49.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:55.08,0:11:11.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:11.92,0:11:14.44,Default,,0,0,0,,Әй, барыңды сал!
Dialogue: 0,0:11:14.44,0:11:16.76,Default,,0,0,0,,Қарғыс атсын мына қалақ!
Dialogue: 0,0:11:16.76,0:11:22.36,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:25.51,0:11:29.20,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｻﾞ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:11:29.20,0:11:32.19,Default,,0,0,0,,Флэш Мириус рыцары!
Dialogue: 0,0:11:32.19,0:11:34.87,Default,,0,0,0,,ﾘｻﾞｰﾄﾞｿﾙｼﾞｬｰ ｻｲｼﾝ
Dialogue: 0,0:11:34.87,0:11:37.34,Default,,0,0,0,,Наруками…
Dialogue: 0,0:11:37.34,0:11:39.34,Default,,0,0,0,,Анықтап көрейік
Dialogue: 0,0:11:41.38,0:11:43.87,Default,,0,0,0,,«Супер Айджа».
Dialogue: 0,0:11:43.87,0:11:48.67,Default,,0,0,0,,Жүр! Ай сәулесінің рыцарь, Ферекс!
Dialogue: 0,0:11:48.67,0:11:51.91,Default,,0,0,0,,ﾗｲﾄﾞ ｸﾗｳﾝﾎﾙﾀﾞｰ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:11:51.91,0:11:53.91,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:11:56.16,0:12:00.57,Default,,0,0,0,,Жүр! Абсолютті қылыштың рыцарь Ливаро!
Dialogue: 0,0:12:00.57,0:12:03.18,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:12:03.18,0:12:06.60,Default,,0,0,0,,ﾗｲﾄﾞ ﾀﾞｽﾄﾌﾟﾗｽﾞﾏ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:12:06.60,0:12:08.60,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:12:13.86,0:12:16.87,Default,,0,0,0,,Осы жерден. Ах
Dialogue: 0,0:12:16.87,0:12:20.70,Default,,0,0,0,,Сынбайтын қылыш, сынбайтын жан!
Dialogue: 0,0:12:20.70,0:12:23.17,Default,,0,0,0,,Енді болат ерік-жігеріңді орындайтын кез!
Dialogue: 0,0:12:23.17,0:12:25.71,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:12:25.71,0:12:29.34,Default,,0,0,0,,Көк аспанның рыцарь Альто поштасы!
Dialogue: 0,0:12:29.34,0:12:31.76,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:12:31.76,0:12:33.80,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:12:33.80,0:12:35.65,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ!!
Dialogue: 0,0:12:35.65,0:12:37.87,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:12:37.87,0:12:40.22,Default,,0,0,0,,Сіз кенеттен артқа тартылдыңыз ба...
Dialogue: 0,0:12:40.22,0:12:43.43,Default,,0,0,0,,Альтомиль үшін критикалық плюс 1
Dialogue: 0,0:12:43.43,0:12:46.23,Default,,0,0,0,,Қос қылыш түні үшін қуат плюс 5000!
Dialogue: 0,0:12:49.93,0:12:52.43,Default,,0,0,0,,Қос қылыш түнімен шабуыл!
Dialogue: 0,0:12:55.89,0:12:58.87,Default,,0,0,0,,Бірден үш! Енді зиян 4
Dialogue: 0,0:12:58.87,0:13:01.17,Default,,0,0,0,,Осы қарқынды жалғастыра бер, Шион!
Dialogue: 0,0:13:03.24,0:13:05.74,Default,,0,0,0,,Бұл күн бұрынғыдан өзгеше.
Dialogue: 0,0:13:07.98,0:13:11.37,Default,,0,0,0,,ﾗｲﾄﾞ･ｻﾞ･ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:13:11.37,0:13:14.94,Default,,0,0,0,,ﾄﾞﾗｺﾞﾆｯｸ･ｶｲｻﾞｰ･ｸﾘﾑｿﾞﾝ！
Dialogue: 0,0:13:14.94,0:13:17.24,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:13:23.75,0:13:27.25,Default,,0,0,0,,Найзағай Айдаһар Рыцарь Торас
Dialogue: 0,0:13:29.50,0:13:32.71,Default,,0,0,0,,Айдаһар дизайнына қоңырау шалыңыз
Dialogue: 0,0:13:32.71,0:13:34.69,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:13:34.69,0:13:37.38,Default,,0,0,0,,Егіз қылыш
Dialogue: 0,0:13:37.38,0:13:39.75,Default,,0,0,0,,Найзағай айдаһар рыцарь Тораста➡
Dialogue: 0,0:13:39.75,0:13:42.35,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:13:42.35,0:13:44.70,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:13:44.70,0:13:47.19,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:13:47.19,0:13:49.79,Default,,0,0,0,,ｹﾞｯﾄ ﾋｰﾙﾄﾘｶﾞｰ
Dialogue: 0,0:13:54.03,0:13:57.40,Default,,0,0,0,,Сайшин шеберлігі Жанға көш
Dialogue: 0,0:13:57.40,0:14:00.20,Default,,0,0,0,,Майлиусты шегіндіріңіз
Dialogue: 0,0:14:00.20,0:14:02.65,Default,,0,0,0,,Сонымен қатар, Thunder Dragon Knight Solas шеберлігі→
Dialogue: 0,0:14:02.65,0:14:04.99,Default,,0,0,0,,Тағы біреуі бар.
Dialogue: 0,0:14:04.99,0:14:07.71,Default,,0,0,0,,Кенеттен үш артқы күзетші пайда болды!
Dialogue: 0,0:14:07.71,0:14:09.83,Default,,0,0,0,,Бұл Наруками... Және ➡
Dialogue: 0,0:14:09.83,0:14:11.90,Default,,0,0,0,,Бұл соңы емес.
Dialogue: 0,0:14:11.90,0:14:14.42,Default,,0,0,0,,Авангардқа➡ түсу
Dialogue: 0,0:14:14.42,0:14:16.42,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:14:21.54,0:14:25.49,Default,,0,0,0,,Наруками әр бұрылыста тылдағы күзетшілерді жояды...
Dialogue: 0,0:14:25.49,0:14:28.03,Default,,0,0,0,,Менің бұл палубаны таңдағаным →
Dialogue: 0,0:14:28.03,0:14:30.33,Default,,0,0,0,,Бұл сенің сынағың.
Dialogue: 0,0:14:32.83,0:14:35.17,Default,,0,0,0,,Бұл туралы➡
Dialogue: 0,0:14:35.17,0:14:37.42,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,0:14:37.42,0:14:41.92,Default,,0,0,0,,Олай болса маған шынайы құндылығыңды көрсет.
Dialogue: 0,0:16:27.85,0:16:30.89,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:16:30.89,0:16:33.76,Default,,0,0,0,,Оборо Қасиетті Рыцарь Габладе!
Dialogue: 0,0:16:33.76,0:16:36.04,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:16:36.04,0:16:39.19,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:16:39.19,0:16:42.08,Default,,0,0,0,,ｹﾞｯﾄ ﾋｰﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:16:42.08,0:16:44.38,Default,,0,0,0,,Кеттік, Ғабладе!
Dialogue: 0,0:16:48.05,0:16:50.91,Default,,0,0,0,,Габураде дағдылары Келіңіздер!
Dialogue: 0,0:16:50.91,0:16:54.59,Default,,0,0,0,,Керемет рыцарь Венисель!
Dialogue: 0,0:16:54.59,0:16:58.39,Default,,0,0,0,,Венизелдің шеберлігі Керемет қоңырау!
Dialogue: 0,0:17:02.33,0:17:04.90,Default,,0,0,0,,Мен өз дағдыларыммен Артқы күзетті бірден қалпына келтіремін!
Dialogue: 0,0:17:04.90,0:17:06.90,Default,,0,0,0,,Енді шайқас басталады! Шион!
Dialogue: 0,0:17:14.51,0:17:17.87,Default,,0,0,0,,《Шион: Сол күні мен өлдім》
Dialogue: 0,0:17:17.87,0:17:21.82,Default,,0,0,0,,Ұлы найза түнімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:21.82,0:17:24.37,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:17:24.37,0:17:26.37,Default,,0,0,0,,ﾍﾞﾆｾﾞｰﾙ！
Dialogue: 0,0:17:26.37,0:17:28.38,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:17:28.38,0:17:32.55,Default,,0,0,0,,Міне, бұл оны сынаққа лайық етеді.
Dialogue: 0,0:17:32.55,0:17:36.70,Default,,0,0,0,,Сонда мен сені тағы да езіп аламын...
Dialogue: 0,0:17:36.70,0:17:38.87,Default,,0,0,0,,ｼｰｸ･ｻﾞ･ﾒｲﾄ！
Dialogue: 0,0:17:38.87,0:17:44.59,Default,,0,0,0,,Айдаһар Кайзер Кримсон, одақтасыңыз Вермилионмен бірге соққы беріңіз.
Dialogue: 0,0:17:44.59,0:17:47.59,Default,,0,0,0,,Апокалипсис легионының найзағайы!
Dialogue: 0,0:17:55.70,0:17:57.72,Default,,0,0,0,,Қозғалтқыш жұмыс істей бастады~
Dialogue: 0,0:17:57.72,0:17:59.71,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:17:59.71,0:18:02.08,Default,,0,0,0,,Вермилион шеберлігін белсендіру
Dialogue: 0,0:18:02.08,0:18:04.38,Default,,0,0,0,,Барлық алдыңғы қатарларға шабуыл жасаңыз!
Dialogue: 0,0:18:08.50,0:18:10.54,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ！
Dialogue: 0,0:18:10.54,0:18:12.59,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ!!
Dialogue: 0,0:18:12.59,0:18:15.26,Default,,0,0,0,,ｹﾞｯﾄ ﾋｰﾙﾄﾘｶﾞｰ
Dialogue: 0,0:18:15.26,0:18:17.76,Default,,0,0,0,,Оны кесіңіз!
Dialogue: 0,0:18:20.83,0:18:23.36,Default,,0,0,0,,Тәжі айдаһарының дағдылары
Dialogue: 0,0:18:23.36,0:18:26.48,Default,,0,0,0,,Бұл бұрылыс кезінде Айдаһар өлімінің өлшемі→
Dialogue: 0,0:18:26.48,0:18:28.85,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000
Dialogue: 0,0:18:28.85,0:18:32.21,Default,,0,0,0,,Шаң плазмалық айдаһар және тәж ұстағыш айдаһар →
Dialogue: 0,0:18:32.21,0:18:35.08,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000
Dialogue: 0,0:18:35.08,0:18:38.71,Default,,0,0,0,,Көбірек қуат плюс 2000
Dialogue: 0,0:18:38.71,0:18:40.70,Default,,0,0,0,,Барлығы үш дене?
Dialogue: 0,0:18:40.70,0:18:45.79,Default,,0,0,0,,Кайзер деп аталатын бірлік соққыға жеткенде іске қосылатын дағды.
Dialogue: 0,0:18:45.79,0:18:47.89,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:52.03,0:18:54.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:58.03,0:19:00.57,Default,,0,0,0,,Қанша рет шеберлікпен қайта құрсаңыз да➡
Dialogue: 0,0:19:00.57,0:19:03.99,Default,,0,0,0,,Нарукамидің алдында бәрі сыпырылып кетеді.
Dialogue: 0,0:19:03.99,0:19:06.89,Default,,0,0,0,,Сонымен қатар, қуат көзін қосқан сайын➡
Dialogue: 0,0:19:06.89,0:19:11.00,Default,,0,0,0,,Тұрған сайын мен қатты қиналып қаламын.
Dialogue: 0,0:19:11.00,0:19:13.40,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:13.40,0:19:17.27,Default,,0,0,0,,5 бірден зиян. Шион...
Dialogue: 0,0:19:17.27,0:19:22.01,Default,,0,0,0,,Ох…
Dialogue: 0,0:19:22.01,0:19:24.71,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:19:24.71,0:19:28.10,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:19:28.10,0:19:31.60,Default,,0,0,0,,Кай Тошики күткендей
Dialogue: 0,0:19:34.22,0:19:36.77,Default,,0,0,0,,Сіз өкінесіз
Dialogue: 0,0:19:36.77,0:19:40.87,Default,,0,0,0,,Сіз маған дәл қазір соңғы соққыны тигізбедіңіз деп үміттенемін!
Dialogue: 0,0:19:43.39,0:19:47.00,Default,,0,0,0,,Енді жаңа эпопеяны жазудың уақыты келді!
Dialogue: 0,0:19:47.00,0:19:49.58,Default,,0,0,0,,Мен қалаған дүниені қолға ал!
Dialogue: 0,0:19:49.58,0:19:51.68,Default,,0,0,0,,ｽﾄﾗｲﾄﾞ･ｻﾞ･ｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:19:58.88,0:20:01.76,Default,,0,0,0,,Ұшатын көктегі қасиетті рыцарь Альтомайл!
Dialogue: 0,0:20:01.76,0:20:03.81,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:20:03.81,0:20:07.35,Default,,0,0,0,,ｽﾍﾟﾘｵﾙｺｰﾙ ﾊﾟﾜｰﾌﾟﾗｽ5000！
Dialogue: 0,0:20:07.35,0:20:10.44,Default,,0,0,0,,Hiten Holy Knight Altomile шеберлігін белсендіру
Dialogue: 0,0:20:10.44,0:20:13.32,Default,,0,0,0,,Алдыңғы қатардағы барлық блоктар үшін қуат плюс 3000
Dialogue: 0,0:20:13.32,0:20:16.54,Default,,0,0,0,,Керемет қоңырау Фрагмент түні!
Dialogue: 0,0:20:16.54,0:20:22.22,Default,,0,0,0,,Сондай-ақ рыцарь Лавр Сильс деп атаңыз!
Dialogue: 0,0:20:22.22,0:20:24.55,Default,,0,0,0,,Бірден қайта құрылды
Dialogue: 0,0:20:24.55,0:20:26.62,Default,,0,0,0,,Жасайық
Dialogue: 0,0:20:26.62,0:21:09.21,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:09.21,0:21:11.23,Default,,0,0,0,,《Қайта-қайта тұру》
Dialogue: 0,0:21:11.23,0:21:14.72,Default,,0,0,0,,Қылышымның алдында еңкей!
Dialogue: 0,0:21:14.72,0:21:18.02,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:21:18.02,0:21:20.04,Default,,0,0,0,,ｱﾙﾄﾏｲﾙ！
Dialogue: 0,0:21:20.04,0:21:22.04,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:21:22.04,0:21:25.56,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:21:25.56,0:21:27.70,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:21:27.70,0:21:33.00,Default,,0,0,0,,Tekkugaruni Пауэр Plus 5000 Critical Plus 1
Dialogue: 0,0:21:33.00,0:21:35.21,Default,,0,0,0,,ｹﾞｯﾄ ｽﾀﾝﾄﾞﾄﾘｶﾞｰ！
Dialogue: 0,0:21:35.21,0:21:37.58,Default,,0,0,0,,Фрагменттің тұрақты түні!
Dialogue: 0,0:21:37.58,0:21:39.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:41.53,0:21:44.03,Default,,0,0,0,,ﾅｲﾄ･ｵﾌﾞ･ﾌﾗｸﾞﾒﾝﾄ！
Dialogue: 0,0:21:46.65,0:21:50.04,Default,,0,0,0,,Зақым 5 Әлі де біраз зақым бар.
Dialogue: 0,0:21:50.04,0:21:52.37,Default,,0,0,0,,Шионға барыңыз!
Dialogue: 0,0:21:52.37,0:21:55.56,Default,,0,0,0,,Пилдің жарылуы
Dialogue: 0,0:21:55.56,0:21:58.06,Default,,0,0,0,,Енді ешқашан адаспаңыз!
Dialogue: 0,0:21:58.06,0:22:09.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:09.37,0:22:13.17,Default,,0,0,0,,Қанша құласам да, ұстаймын
Dialogue: 0,0:22:15.55,0:22:18.47,Default,,0,0,0,,Бұл мен үшін бәрі!
Dialogue: 0,0:22:18.47,0:22:21.97,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:22:23.90,0:22:27.20,Default,,0,0,0,,Күзетші! Көбірек Intercept!
Dialogue: 0,0:22:29.89,0:22:31.91,Default,,0,0,0,,алды
Dialogue: 0,0:22:31.91,0:22:33.91,Default,,0,0,0,,Куу…
Dialogue: 0,0:22:33.91,0:22:36.37,Default,,0,0,0,,Маған сіздің суретіңізді көрсетті.
Dialogue: 0,0:22:36.37,0:22:38.39,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:22:38.39,0:22:40.39,Default,,0,0,0,,ﾌｧｲﾅﾙﾀｰﾝ！
Dialogue: 0,0:22:44.21,0:22:46.16,Default,,0,0,0,,Жер жүзіне нұр жаусын!
Dialogue: 0,0:22:46.16,0:22:49.25,Default,,0,0,0,,Қараңғылықты кесіп өтетін күн күркіреуі!
Dialogue: 0,0:22:49.25,0:22:51.55,Default,,0,0,0,,ｽﾄﾗｲﾄﾞ･ｻﾞ･ｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:23:00.21,0:23:04.71,Default,,0,0,0,,Жаулап алушы Айдаһар Айдаһар Кайзері туралы ескерту!
Dialogue: 0,0:23:04.71,0:23:08.53,Default,,0,0,0,,Сіз оның байыптылығын көрсеттіңіз.
Dialogue: 0,0:23:08.53,0:23:10.57,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:23:10.57,0:23:12.57,Default,,0,0,0,,Алдыңғы қатардағылардың бәріне шабуыл жасаңыз.
Dialogue: 0,0:23:14.54,0:23:17.17,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:23:17.17,0:23:20.38,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ!!!
Dialogue: 0,0:23:20.38,0:23:22.50,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:23:22.50,0:23:26.55,Default,,0,0,0,,Барлық әсерлер Айдаһар өлшемі
Dialogue: 0,0:23:26.55,0:23:29.24,Default,,0,0,0,,Критикалық триггер. Не!?
Dialogue: 0,0:23:29.24,0:23:33.54,Default,,0,0,0,,Сол сияқты, барлық әсерлер драгондық өлшемде.
Dialogue: 0,0:23:39.88,0:23:41.90,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:23:41.90,0:23:44.17,Default,,0,0,0,,Тәжі айдаһарының шеберлігі
Dialogue: 0,0:23:44.17,0:23:47.20,Default,,0,0,0,,Өлшемімен бірге қуат плюс 2000
Dialogue: 0,0:23:47.20,0:23:50.61,Default,,0,0,0,,Сонымен қатар, Dragonic Kaiser жаттығу дағдылары
Dialogue: 0,0:23:50.61,0:23:53.53,Default,,0,0,0,,Пауэр Plus 5000 екеуі де
Dialogue: 0,0:23:53.53,0:23:56.91,Default,,0,0,0,,Тағы да Пауэр Plus 2000
Dialogue: 0,0:23:56.91,0:23:59.51,Default,,0,0,0,,және Пауэр Plus 5000
Dialogue: 0,0:24:01.54,0:24:03.87,Default,,0,0,0,,Енді жалпы қуат 54000
Dialogue: 0,0:24:03.87,0:24:06.57,Default,,0,0,0,,Сіз бұлай қарауыл ойнай алмайсыз.
Dialogue: 0,0:24:06.57,0:24:09.17,Default,,0,0,0,,Міне... Шион...
Dialogue: 0,0:24:14.20,0:24:18.49,Default,,0,0,0,,Бұл... Кай Тошики ме?
Dialogue: 0,0:24:18.49,0:24:23.54,Default,,0,0,0,,Киба Шион Мен әрқашан сенің серігің боламын.
Dialogue: 0,0:24:23.54,0:24:26.86,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:24:26.86,0:24:28.86,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:24:57.86,0:25:02.53,Default,,0,0,0,,Мен хат жібергім келеді…
Dialogue: 0,0:25:02.53,0:25:05.22,Default,,0,0,0,,Хаха
Dialogue: 0,0:25:05.22,0:25:07.20,Default,,0,0,0,,Мен хат жібергім келеді…
Dialogue: 0,0:25:07.20,0:25:20.87,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:20.87,0:25:22.87,Default,,0,0,0,,ｼｵﾝ…
Dialogue: 0,0:25:24.94,0:25:28.51,Default,,0,0,0,,Кешіріңіз, мен жеңе алмадым.
Dialogue: 0,0:25:28.51,0:25:31.86,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл тамаша жекпе-жек болды.
Dialogue: 0,0:25:31.86,0:25:35.50,Default,,0,0,0,,Қалайша Тошики Кайды сонша бұрышқа бұра аласыз?
Dialogue: 0,0:25:35.50,0:25:39.75,Default,,0,0,0,,Бірақ жоғалту - бұл шығын
Dialogue: 0,0:25:39.75,0:25:43.75,Default,,0,0,0,,Әзірге мен Кай Санға тең келер емеспін.
Dialogue: 0,0:25:45.89,0:25:48.49,Default,,0,0,0,,Бірақ қазірден бастап
Dialogue: 0,0:27:28.88,0:27:31.00,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:27:31.00,0:27:33.08,Default,,0,0,0,,Қалай болды? қалақ
Dialogue: 0,0:27:33.08,0:27:35.08,Default,,0,0,0,,Бұл аздап күрескен болуы керек, солай ма?
Dialogue: 0,0:27:37.00,0:27:40.55,Default,,0,0,0,,Шион Киба Ол жақсы боксшы болуы мүмкін.
Dialogue: 0,0:27:40.55,0:27:43.21,Default,,0,0,0,,Жауапты сезіндіңіз бе?
Dialogue: 0,0:27:43.21,0:27:47.49,Default,,0,0,0,,Егер ол... Жоқ, егер олар...
Dialogue: 0,0:27:47.49,0:27:49.58,Default,,0,0,0,,ﾌｯ
Dialogue: 0,0:27:49.58,0:27:53.08,Default,,0,0,0,,Бұл сіздің күткеніңізден де асып түсуі мүмкін.
Dialogue: 0,0:27:55.19,0:27:57.24,Default,,0,0,0,,Келесі кезек сізде.
Dialogue: 0,0:27:57.24,0:27:59.84,Default,,0,0,0,,Түсінгенше көрсетемін
Dialogue: 0,0:30:33.86,0:30:36.83,Default,,0,0,0,,Бұл жолы біз Жапонияның атынан шығамыз→
Dialogue: 0,0:30:36.83,0:30:40.15,Default,,0,0,0,,Өмір ойыны Донжара бейсбол тақтасы
Dialogue: 0,0:30:40.15,0:30:43.87,Default,,0,0,0,,Барлығы ойнаған көптеген стандартты ойыншықтар
Dialogue: 0,0:30:43.87,0:30:48.26,Default,,0,0,0,,Жас комедиялар соңғы нұсқаны көреді!
Dialogue: 0,0:30:48.26,0:30:50.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:50.19,0:30:55.62,Default,,0,0,0,,Ең соңғы әрі жетілдірілген ойыншықтар бірінен соң бірі пайда болады
Dialogue: 0,0:30:55.62,0:30:58.20,Default,,0,0,0,,Жаңа жыл жақындап қалды
Dialogue: 0,0:30:58.20,0:31:01.20,Default,,0,0,0,,Бұл жаңа жылдық сыйлық ақшаға сатып алғыңыз келетін заттардың барлығы.
Dialogue: 0,0:31:02.70,0:31:08.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory