Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:13.04,0:02:14.09,Default,,0,0,0,,Өте көп
Dialogue: 0,0:02:15.06,0:02:19.00,Default,,0,0,0,,Сен мені сонша жек көрдің бе?
Dialogue: 0,0:02:31.04,0:02:32.07,Default,,0,0,0,,Бастапқы маркер
Dialogue: 0,0:02:33.05,0:02:38.06,Default,,0,0,0,,Жәбірленушінің сиқырлы күші бақылаудан шығып, өз денесін әп-сәтте жойып жібереді.
Dialogue: 0,0:02:40.07,0:02:41.08,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:02:42.03,0:02:43.03,Default,,0,0,0,,Меншікті уақытты басқару
Dialogue: 0,0:02:44.07,0:02:46.02,Default,,0,0,0,,Екі еселік жылдамдық
Dialogue: 0,0:03:01.00,0:03:02.07,Default,,0,0,0,,Түпнұсқа таңбалауышы жұмыс істемейді
Dialogue: 0,0:03:03.07,0:03:04.09,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:05.02,0:03:06.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:06.05,0:03:09.05,Default,,0,0,0,,Ол сиқырлы күштің көзі ретінде командалық заклинание қолдана ма?
Dialogue: 0,0:03:10.01,0:03:12.05,Default,,0,0,0,,Origin Bullet күшіне енген кезде,
Dialogue: 0,0:03:12.06,0:03:15.08,Default,,0,0,0,,Оның қолынан сиқырлы күштің бастауы болып табылатын командалық заклинание жоғалып кетті.
Dialogue: 0,0:03:17.03,0:03:20.02,Default,,0,0,0,,Өзінің сиқырлы схемасы қолданылмағандықтан
Dialogue: 0,0:03:20.03,0:03:22.03,Default,,0,0,0,,Бастапқы оқтың сиқырлы күші әсер етпейді.
Dialogue: 0,0:03:23.02,0:03:25.02,Default,,0,0,0,,Бірақ соққанша
Dialogue: 0,0:03:26.01,0:03:28.02,Default,,0,0,0,,Оның өлтіруге күші жетеді
Dialogue: 0,0:03:30.02,0:03:32.06,Default,,0,0,0,,Келесі жолы қашып құтыла аламын деп ойлаймын.
Dialogue: 0,0:03:33.02,0:03:35.04,Default,,0,0,0,,Егер сіз оның қос жылдамдықпен қозғалатынын білсеңіз
Dialogue: 0,0:03:35.07,0:03:39.09,Default,,0,0,0,,Мұны түсінгеннен кейін уақытты өлшеу керек.
Dialogue: 0,0:03:52.04,0:03:53.02,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:04:11.05,0:04:13.05,Default,,0,0,0,,Сізді сонша жынды еткен не болды?
Dialogue: 0,0:04:18.04,0:04:20.02,Default,,0,0,0,,Менің кінәм бар ма?
Dialogue: 0,0:04:37.02,0:04:38.03,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:04:40.09,0:04:41.09,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:04:59.06,0:05:00.06,Default,,0,0,0,,Меншікті уақытты бақылау
Dialogue: 0,0:05:01.03,0:05:03.00,Default,,0,0,0,,Екі еселік жылдамдық
Dialogue: 0,0:05:51.06,0:05:54.04,Default,,0,0,0,,Жақын шайқаста біз өте қолайсыз жағдайға тап болдық.
Dialogue: 0,0:05:55.00,0:05:56.05,Default,,0,0,0,,Калико жоғалды
Dialogue: 0,0:05:56.07,0:05:58.09,Default,,0,0,0,,Contender қайта жүктеуді қажет етеді
Dialogue: 0,0:05:59.09,0:06:00.04,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:01.07,0:06:04.00,Default,,0,0,0,,Бәрі де алыстағы утопия
Dialogue: 0,0:06:07.01,0:06:11.05,Default,,0,0,0,,Қалпына келтіру күші сонша, жүрек бұзылса да, ол бірден қалпына келеді.
Dialogue: 0,0:06:11.07,0:06:14.03,Default,,0,0,0,,Содан кейін миды бұзыңыз
Dialogue: 0,0:06:14.09,0:06:15.06,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:16.02,0:06:18.03,Default,,0,0,0,,Бұл оң қолды қолдануға болмайды.
Dialogue: 0,0:06:18.06,0:06:21.04,Default,,0,0,0,,Авалонның сауықтыру қабілеті өзіне зиян келтіруге қарсы да тиімді
Dialogue: 0,0:06:21.07,0:06:23.09,Default,,0,0,0,,Қалған қарулар - бір пышақ және екі граната.
Dialogue: 0,0:06:24.00,0:06:28.00,Default,,0,0,0,,Он екі қара перне қалды.
Dialogue: 0,0:06:28.01,0:06:30.03,Default,,0,0,0,,Алдын ала пәрмен емлелері үшін тек 8 штрих қалды
Dialogue: 0,0:06:30.05,0:06:31.05,Default,,0,0,0,,Меншікті уақытты бақылау
Dialogue: 0,0:06:32.07,0:06:34.00,Default,,0,0,0,,Үш еселік жылдамдық
Dialogue: 0,0:07:13.06,0:07:14.08,Default,,0,0,0,,Меншікті уақытты бақылау
Dialogue: 0,0:07:15.00,0:07:16.05,Default,,0,0,0,,Төрт еселік жылдамдық
Dialogue: 0,0:08:08.09,0:08:12.02,Default,,0,0,0,,Сонда да мен Қасиетті Граалды жеңемін
Dialogue: 0,0:08:12.06,0:08:14.00,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:08:15.00,0:08:19.00,Default,,0,0,0,,Мен сізге ештеңе өтей алмаймын.
Dialogue: 0,0:08:24.08,0:08:27.02,Default,,0,0,0,,Осы кезеңнің өзінде
Dialogue: 0,0:08:27.08,0:08:32.06,Default,,0,0,0,,Сол үшін қолыңа қылышты аласың ба?
Dialogue: 0,0:08:35.01,0:08:37.04,Default,,0,0,0,,Сіз қиындыққа тап болдыңыз.
Dialogue: 0,0:08:56.09,0:08:57.08,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:04.01,0:09:06.09,Default,,0,0,0,,Мен сенің келетініңе сенімді болдым.
Dialogue: 0,0:09:08.06,0:09:12.06,Default,,0,0,0,,Мен сенің осында жете алатыныңа сендім.
Dialogue: 0,0:09:13.08,0:09:14.08,Default,,0,0,0,,Айри
Dialogue: 0,0:09:15.02,0:09:18.05,Default,,0,0,0,,Бұл сіздің тілектеріңіз орындалатын жер
Dialogue: 0,0:09:18.07,0:09:22.01,Default,,0,0,0,,Іздеген киелі тастың ішінде.
Dialogue: 0,0:09:26.06,0:09:28.05,Default,,0,0,0,,Бұл Қасиетті Граил
Dialogue: 0,0:09:28.07,0:09:30.04,Default,,0,0,0,,Ол әлі қалыптаспағанымен.
Dialogue: 0,0:09:30.07,0:09:33.05,Default,,0,0,0,,Ыдыс толып қалды.
Dialogue: 0,0:09:34.03,0:09:36.07,Default,,0,0,0,,Бар болғаны дұғаңызды оқысаңыз болғаны
Dialogue: 0,0:09:37.01,0:09:41.08,Default,,0,0,0,,Осылайша ол бірінші рет «сыртқа» шыға алады.
Dialogue: 0,0:09:42.01,0:09:44.05,Default,,0,0,0,,Енді, өтінемін
Dialogue: 0,0:09:44.07,0:09:47.02,Default,,0,0,0,,Оған мүмкіндігінше тезірек «құрмет» көрсетіңіз.
Dialogue: 0,0:09:47.05,0:09:48.04,Default,,0,0,0,,Кирицугу
Dialogue: 0,0:09:48.09,0:09:53.03,Default,,0,0,0,,Сіз оның не екенін анықтайтын дұрыс адамсыз.
Dialogue: 0,0:09:54.07,0:09:56.09,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:09:57.06,0:09:59.02,Default,,0,0,0,,Мен Айрисвиелмін
Dialogue: 0,0:09:59.06,0:10:00.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:01.00,0:10:05.05,Default,,0,0,0,,Егер Қасиетті Граил дайын болса, ол қазірдің өзінде
Dialogue: 0,0:10:07.01,0:10:08.06,Default,,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 0,0:10:09.00,0:10:10.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:10.08,0:10:13.06,Default,,0,0,0,,Мен бұл маска екенін жоққа шығармаймын.
Dialogue: 0,0:10:14.05,0:10:18.08,Default,,0,0,0,,Мен бар тұлғамды «қабық» ретінде жабуым керек.
Dialogue: 0,0:10:19.02,0:10:21.07,Default,,0,0,0,,Басқалармен тіл табыса алмайды
Dialogue: 0,0:10:21.08,0:10:27.09,Default,,0,0,0,,Бірақ мен жазған Ирисвиелдің тұлғасы сөзсіз шынайы.
Dialogue: 0,0:10:28.00,0:10:32.09,Default,,0,0,0,,Сондықтан мен Ирисвиелдің соңғы тілегін мұра еттім.
Dialogue: 0,0:10:33.01,0:10:35.03,Default,,0,0,0,,Сіз Қасиетті Граилдың еркісіз бе?
Dialogue: 0,0:10:36.01,0:10:39.04,Default,,0,0,0,,Иә, бұл түсіндіру дұрыс.
Dialogue: 0,0:10:39.09,0:10:42.09,Default,,0,0,0,,Менде ерік пен қалау бар
Dialogue: 0,0:10:43.04,0:10:46.01,Default,,0,0,0,,«Осы әлемде туылу» еркі
Dialogue: 0,0:10:46.05,0:10:47.06,Default,,0,0,0,,Мақтана алатын ұлыңмын. Иә.
Dialogue: 0,0:10:47.08,0:10:53.03,Default,,0,0,0,,Олай болса, сізден сұрайын: Қасиетті Граил менің тілегімді қалай орындамақ?
Dialogue: 0,0:10:53.05,0:10:55.01,Default,,0,0,0,,Бұл дұрыс емес, Кирицугу.
Dialogue: 0,0:10:57.05,0:11:01.06,Default,,0,0,0,,Сіз оны басқалардан жақсы түсінбеуіңіз керек.
Dialogue: 0,0:11:01.08,0:11:03.00,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:11:03.05,0:11:08.04,Default,,0,0,0,,Сіз әлемді қалай құтқару керектігін түсіндіңіз.
Dialogue: 0,0:11:08.06,0:11:11.09,Default,,0,0,0,,Ендеше мен сенің істегеніңді істеймін.
Dialogue: 0,0:11:12.01,0:11:16.07,Default,,0,0,0,,Мен сенің болмысыңды мұра етіп, дұғаларыңды орындаймын.
Dialogue: 0,0:11:17.03,0:11:18.07,Default,,0,0,0,,Егер ол белгілі бір дәрежеде бар күшін салмайтын болса—
Dialogue: 0,0:11:20.08,0:11:22.03,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:11:22.08,0:11:27.06,Default,,0,0,0,,Бұдан былай сізге тек өз ішіндегі сұрақты қою керек.
Dialogue: 0,0:11:33.06,0:11:34.08,Default,,0,0,0,,Бұл
Dialogue: 0,0:11:38.03,0:11:43.04,Default,,0,0,0,,Бір кемеде үш жүз адам, екіншісінде екі жүз адам.
Dialogue: 0,0:11:43.07,0:11:44.04,Default,,0,0,0,,Не?
Dialogue: 0,0:11:44.08,0:11:49.05,Default,,0,0,0,,Барлығы 500 экипаж мүшелері мен жолаушылар, ал қалғандары Кирицугу Эмия.
Dialogue: 0,0:11:50.01,0:11:55.01,Default,,0,0,0,,Осы 501 адам адамзаттың соңғы аман қалғандары деп есептейік.
Dialogue: 0,0:11:55.06,0:12:00.02,Default,,0,0,0,,Екі кеменің түбінде бір уақытта ашылған өлімге әкелетін үлкен тесік.
Dialogue: 0,0:12:00.05,0:12:04.00,Default,,0,0,0,,Тек Кирицугу кемелерді жөндеуге қабілетті.
Dialogue: 0,0:12:04.07,0:12:08.05,Default,,0,0,0,,Енді қай кемені жөндейсіз?
Dialogue: 0,0:12:08.08,0:12:12.02,Default,,0,0,0,,Әрине, бұл бортында 300 адам бар кеме.
Dialogue: 0,0:12:12.06,0:12:14.05,Default,,0,0,0,,Егер сіз мұны шешсеңіз
Dialogue: 0,0:12:15.01,0:12:20.05,Default,,0,0,0,,Басқа кемедегі екі жүз адам сізді ұстап алып, талап етті:
Dialogue: 0,0:12:20.08,0:12:23.02,Default,,0,0,0,,«Алдымен осы кемені жөндеңіз».
Dialogue: 0,0:12:23.07,0:12:25.02,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:12:26.06,0:12:28.01,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:12:55.00,0:12:57.08,Default,,0,0,0,,Барлық 200 адамды өлтіріңіз
Dialogue: 0,0:12:58.00,0:13:01.05,Default,,0,0,0,,Дұрыс Сондықтан Кирицугу Эмия
Dialogue: 0,0:13:05.06,0:13:09.07,Default,,0,0,0,,Енді аман қалған 300 адам зақымдалған кемені тастап кетті.
Dialogue: 0,0:13:10.03,0:13:13.08,Default,,0,0,0,,Екі жаңа кемеде жүзуді жалғастырыңыз
Dialogue: 0,0:13:14.06,0:13:19.05,Default,,0,0,0,,Енді бір кемеде екі жүз адам, екіншісінде жүз адам.
Dialogue: 0,0:13:20.00,0:13:25.04,Default,,0,0,0,,Алайда бұл екі кеменің түбінде бір уақытта тесіктер ашылды.
Dialogue: 0,0:13:25.08,0:13:26.04,Default,,0,0,0,,Эй
Dialogue: 0,0:13:27.08,0:13:31.03,Default,,0,0,0,,Сізді кішірек кемеде жүз адам ұрлап әкетті.
Dialogue: 0,0:13:31.07,0:13:34.04,Default,,0,0,0,,Алдымен кемеңізді жөндеуге мәжбүр болды
Dialogue: 0,0:13:34.09,0:13:36.02,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:13:36.05,0:13:37.07,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:13:38.00,0:13:38.50,Default,,0,0,0,,Бірақ
Dialogue: 0,0:13:55.04,0:13:57.07,Default,,0,0,0,,Иә, дұрыс айтасыз.
Dialogue: 0,0:13:57.09,0:14:00.01,Default,,0,0,0,,Бұл ақымақтық. Бұл ақымақ.
Dialogue: 0,0:14:00.03,0:14:01.07,Default,,0,0,0,,Дұрыс деген не?
Dialogue: 0,0:14:02.00,0:14:03.08,Default,,0,0,0,,Екі жүз адам аман қалды
Dialogue: 0,0:14:04.01,0:14:06.01,Default,,0,0,0,,Оның кесірінен үш жүз адам өлді.
Dialogue: 0,0:14:06.04,0:14:08.04,Default,,0,0,0,,Бұл жағдайда таразының инесі екінші жағын көрсетіп тұр.
Dialogue: 0,0:14:08.06,0:14:11.04,Default,,0,0,0,,Жоқ, есептеу қате емес.
Dialogue: 0,0:14:11.09,0:14:16.01,Default,,0,0,0,,Шынында да, сіз көпті құтқару үшін азды құрбан етуді таңдайсыз.
Dialogue: 0,0:14:16.06,0:14:19.00,Default,,0,0,0,,Менің ойымша, Кирицугу Эмия
Dialogue: 0,0:14:19.05,0:14:23.07,Default,,0,0,0,,Таразыны төңкермеген санаулыларды ылғи да өлтірдің.
Dialogue: 0,0:14:24.05,0:14:28.05,Default,,0,0,0,,Осыншама мәйіт үйіліп жатса да
Dialogue: 0,0:14:28.07,0:14:30.08,Default,,0,0,0,,Егер бұл өмірді сақтап қалса
Dialogue: 0,0:14:31.02,0:14:34.02,Default,,0,0,0,,Қорғалған сан қымбат болуы керек.
Dialogue: 0,0:14:37.06,0:14:40.08,Default,,0,0,0,,Маған көрсеткіңіз келгені осы ма?
Dialogue: 0,0:14:41.02,0:14:42.01,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:42.03,0:14:46.06,Default,,0,0,0,,Бұл сіздің ақиқатыңыз, Кирицугу Эмиияның жауабы.
Dialogue: 0,0:14:47.02,0:14:51.07,Default,,0,0,0,,Басқаша айтқанда, бұл Қасиетті Граил қалау машинасы ретінде орындауы керек.
Dialogue: 0,0:14:51.09,0:14:52.07,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:52.09,0:14:54.09,Default,,0,0,0,,Мен мұны қаламаймын
Dialogue: 0,0:14:55.02,0:14:57.09,Default,,0,0,0,,Бұдан басқа жол болса екен.
Dialogue: 0,0:14:58.05,0:15:02.09,Default,,0,0,0,,Сондықтан менде ғажайыпқа сүйенуден басқа амал жоқ.
Dialogue: 0,0:15:03.02,0:15:05.04,Default,,0,0,0,,Сіз білмейтін әдіс
Dialogue: 0,0:15:05.07,0:15:08.05,Default,,0,0,0,,Мен оны сіздің тілектеріңізге қоса алмаймын.
Dialogue: 0,0:15:09.00,0:15:11.01,Default,,0,0,0,,Дүниенің құтқарылуын тілесең
Dialogue: 0,0:15:11.07,0:15:15.00,Default,,0,0,0,,Оны сізге белгілі құралдар арқылы ғана орындауға болады.
Dialogue: 0,0:15:15.05,0:15:16.05,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:15:16.07,0:15:20.05,Default,,0,0,0,,Бұл қандай керемет?
Dialogue: 0,0:15:21.05,0:15:23.00,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:15:23.07,0:15:29.03,Default,,0,0,0,,Сіз бір кездері өзіңіз ешқашан жасай алмайтын нәрсені жасауға ұмтылдыңыз.
Dialogue: 0,0:15:29.05,0:15:32.08,Default,,0,0,0,,Тапсырманы адам қолымен орындай алмайтын шкала бойынша орындаңыз.
Dialogue: 0,0:15:33.02,0:15:36.03,Default,,0,0,0,,Бұл ғажайып болмаса, не?
Dialogue: 0,0:15:41.09,0:15:43.00,Default,,0,0,0,,Әке.
Dialogue: 0,0:15:51.03,0:15:52.04,Default,,0,0,0,,Наталья
Dialogue: 0,0:15:56.02,0:15:58.01,Default,,0,0,0,,Кирицугу Эмия
Dialogue: 0,0:15:58.05,0:16:04.05,Default,,0,0,0,,——「」
Dialogue: 0,0:16:05.03,0:16:08.03,Default,,0,0,0,,Енді соңғы ұсынысқа.
Dialogue: 0,0:16:10.09,0:16:13.08,Default,,0,0,0,,Үш адам қалды
Dialogue: 0,0:16:16.04,0:16:20.02,Default,,0,0,0,,Екі сақтау керек пе, әлде біреуін таңдау керек пе?
Dialogue: 0,0:16:31.07,0:16:34.02,Default,,0,0,0,,Қош келдіңіз, Кирицугу.
Dialogue: 0,0:16:35.01,0:16:38.00,Default,,0,0,0,,Сіз ақыры оралдыңыз.
Dialogue: 0,0:16:39.06,0:16:41.07,Default,,0,0,0,,Жақсы, түсіндің.
Dialogue: 0,0:16:42.09,0:16:46.04,Default,,0,0,0,,Бұл сіздің дұғаларыңызды Қасиетті Граил арқылы орындау
Dialogue: 0,0:16:50.03,0:16:53.03,Default,,0,0,0,,Ол үшін дұға ету жеткілікті
Dialogue: 0,0:16:53.07,0:16:55.08,Default,,0,0,0,,Әйелімді өмірге қайтар
Dialogue: 0,0:16:56.05,0:16:58.01,Default,,0,0,0,,Қызымды қайтару үшін
Dialogue: 0,0:17:06.00,0:17:09.08,Default,,0,0,0,,Мен енді жаңғақ бүршігін іздей алмаймын.
Dialogue: 0,0:17:10.02,0:17:11.08,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:17:12.01,0:17:16.09,Default,,0,0,0,,Илья, Кирицугу мен сенің анаң бірге болса, бәрі жақсы.
Dialogue: 0,0:17:17.05,0:17:22.02,Default,,0,0,0,,Рахмет, әкем де Ильяны жақсы көреді.
Dialogue: 0,0:17:22.08,0:17:26.00,Default,,0,0,0,,Ант еткенім рас.
Dialogue: 0,0:17:33.02,0:17:34.07,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:17:35.08,0:17:36.05,Default,,0,0,0,,Ілияс
Dialogue: 0,0:17:37.04,0:17:38.06,Default,,0,0,0,,Ілияс
Dialogue: 0,0:17:39.01,0:17:43.07,Default,,0,0,0,,Илья Илья...
Dialogue: 0,0:17:46.00,0:17:48.07,Default,,0,0,0,,Неліктен, неге бұлай?
Dialogue: 0,0:17:48.08,0:17:52.04,Default,,0,0,0,,Сіз біздің Ілияссыз
Dialogue: 0,0:17:58.08,0:18:00.00,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:18:01.02,0:18:03.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:03.07,0:18:09.09,Default,,0,0,0,,Неліктен бізге Қасиетті Граилдан бас тартасың?
Dialogue: 0,0:18:13.06,0:18:16.09,Default,,0,0,0,,Алты миллиард адам және
Dialogue: 0,0:18:17.00,0:18:19.09,Default,,0,0,0,,Мен сені қарғаймын
Dialogue: 0,0:18:20.09,0:18:23.04,Default,,0,0,0,,Кирицугу Эмия
Dialogue: 0,0:18:23.09,0:18:25.02,Default,,0,0,0,,Отбасының екі мүшесі
Dialogue: 0,0:18:25.03,0:18:29.02,Default,,0,0,0,,Анри Маю сізге қарғыс айтады
Dialogue: 0,0:18:29.04,0:18:30.08,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:18:31.03,0:18:32.06,Default,,0,0,0,,Азап
Dialogue: 0,0:18:32.09,0:18:33.05,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:18:33.06,0:18:34.05,Default,,0,0,0,,Өлгенге дейін
Dialogue: 0,0:18:34.07,0:18:35.06,Default,,0,0,0,,Өлтіремін
Dialogue: 0,0:18:35.07,0:18:36.07,Default,,0,0,0,,Тәубе ету
Dialogue: 0,0:18:37.06,0:18:38.08,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:18:39.00,0:18:42.07,Default,,0,0,0,,Ешкімнің шағымдануына жол бермеймін
Dialogue: 0,0:18:42.08,0:18:45.02,Default,,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:19:11.01,0:19:13.08,Default,,0,0,0,,Қандай қызықсыз аяқталды.
Dialogue: 0,0:19:15.05,0:19:17.05,Default,,0,0,0,,Неліктен одан бас тарттыңыз?
Dialogue: 0,0:19:18.00,0:19:19.09,Default,,0,0,0,,Сіз де көрдіңіз бе?
Dialogue: 0,0:19:20.04,0:19:23.05,Default,,0,0,0,,Бәрінен бас тартып, құрбандыққа шалдың.
Dialogue: 0,0:19:23.06,0:19:26.00,Default,,0,0,0,,Сіз осы уақытқа дейін жетуіңіз керек еді.
Dialogue: 0,0:19:26.08,0:19:29.04,Default,,0,0,0,,Алған нәрсенің құны
Dialogue: 0,0:19:29.07,0:19:31.09,Default,,0,0,0,,Неліктен оны қазір күшін жоюға болады?
Dialogue: 0,0:19:32.05,0:19:34.07,Default,,0,0,0,,Түсіну үшін тым ақымақ
Dialogue: 0,0:19:35.05,0:19:37.05,Default,,0,0,0,,ол әкелетін нәрсеге қарағанда
Dialogue: 0,0:19:38.01,0:19:40.06,Default,,0,0,0,,Бұл құрбандық ауырырақ.
Dialogue: 0,0:19:41.01,0:19:42.07,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:19:43.02,0:19:46.06,Default,,0,0,0,,Бұл әмбебап тілек машинасы емес.
Dialogue: 0,0:19:46.09,0:19:48.07,Default,,0,0,0,,Олай болса маған бер.
Dialogue: 0,0:19:49.01,0:19:53.04,Default,,0,0,0,,Саған қажет емес нәрсе маған пайдалы.
Dialogue: 0,0:19:53.09,0:19:57.07,Default,,0,0,0,,Ондай нәрсе туа қалса.
Dialogue: 0,0:19:58.01,0:20:02.08,Default,,0,0,0,,Менің барлық күмәндеріме жауап беру керек
Dialogue: 0,0:20:03.02,0:20:06.09,Default,,0,0,0,,Ол өз өмірін, туғанын қалайды.
Dialogue: 0,0:20:07.05,0:20:09.03,Default,,0,0,0,,Өтінемін, мені өлтірме
Dialogue: 0,0:20:10.01,0:20:10.51,Default,,0,0,0,,Яғни
Dialogue: 0,0:20:16.00,0:20:17.04,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:20:18.00,0:20:21.03,Default,,0,0,0,,Сіз тым ақымақ екенсіз.
Dialogue: 0,0:20:31.02,0:20:33.01,Default,,0,0,0,,Ирисвиел
Dialogue: 0,0:20:35.09,0:20:37.06,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Сабер.
Dialogue: 0,0:20:37.08,0:20:40.07,Default,,0,0,0,,Мен таныс ессіз итпен ойнасам да
Dialogue: 0,0:20:41.01,0:20:45.01,Default,,0,0,0,,Мені күту өте ақылсыздық.
Dialogue: 0,0:20:45.02,0:20:46.02,Default,,0,0,0,,Садақшы
Dialogue: 0,0:20:47.09,0:20:50.02,Default,,0,0,0,,Сенің жүзің қандай!
Dialogue: 0,0:20:50.07,0:20:53.03,Default,,0,0,0,,Аштан өлген ит сияқты емес пе?
Dialogue: 0,0:20:54.00,0:20:56.01,Default,,0,0,0,,Бірақ істер осылай жалғаса берсе,
Dialogue: 0,0:20:57.00,0:21:00.09,Default,,0,0,0,,Қасиетті Граил менікі
Dialogue: 0,0:21:04.01,0:21:05.05,Default,,0,0,0,,Сабер
Dialogue: 0,0:21:05.09,0:21:09.00,Default,,0,0,0,,Аңдауға түсіп, жермен жорғалау
Dialogue: 0,0:21:09.03,0:21:12.04,Default,,0,0,0,,Сіз әдемі әйелсіз
Dialogue: 0,0:21:14.02,0:21:16.02,Default,,0,0,0,,Қылышыңды қойып, менің әйелім бол.
Dialogue: 0,0:21:18.00,0:21:20.03,Default,,0,0,0,,Ғажайыптарды жүзеге асыратын қасиетті гриль, т.б.
Dialogue: 0,0:21:20.06,0:21:24.07,Default,,0,0,0,,Мұндай күдікті нәрсеге байлануының себебі неде?
Dialogue: 0,0:21:26.03,0:21:30.03,Default,,0,0,0,,Барлық түкке тұрғысыз идеалдарыңыз бен анттарыңыздан бас тартыңыз.
Dialogue: 0,0:21:30.05,0:21:34.01,Default,,0,0,0,,Бұдан былай тек мені іздеп, тек менімен боя.
Dialogue: 0,0:21:34.04,0:21:38.04,Default,,0,0,0,,Әлем патшасының атымен
Dialogue: 0,0:21:38.08,0:21:41.09,Default,,0,0,0,,Мен саған бұл дүниенің барлық рахатын, қуанышын сыйлаймын.
Dialogue: 0,0:21:43.04,0:21:46.07,Default,,0,0,0,,Осындай бос сөздің кесірінен сен
Dialogue: 0,0:21:47.02,0:21:49.01,Default,,0,0,0,,Қасиетті құлымды алып кетесің бе?
Dialogue: 0,0:21:53.00,0:21:55.02,Default,,0,0,0,,Мен сіздің өсиетіңізді естіген жоқпын.
Dialogue: 0,0:21:56.01,0:21:58.00,Default,,0,0,0,,Бұл менің шешімім.
Dialogue: 0,0:21:59.04,0:22:02.03,Default,,0,0,0,,Енді жауабын тыңдайық.
Dialogue: 0,0:22:02.08,0:22:04.08,Default,,0,0,0,,Мүлдем бас тарту
Dialogue: 0,0:22:06.06,0:22:09.05,Default,,0,0,0,,Сіз бірдеңе айтуға ұяласыз ба?
Dialogue: 0,0:22:10.00,0:22:13.09,Default,,0,0,0,,Жарайды, қанша рет қате айтсам да кешіремін.
Dialogue: 0,0:22:14.00,0:22:16.04,Default,,0,0,0,,Маған қызмет етудің қуанышын білу
Dialogue: 0,0:22:16.08,0:22:20.02,Default,,0,0,0,,Алдымен ауырсыну арқылы үйрену керек.
Dialogue: 0,0:22:28.04,0:22:29.08,Default,,0,0,0,,Кирицугу
Dialogue: 0,0:22:34.09,0:22:37.01,Default,,0,0,0,,Ақырында шешім қабылдадыңыз ба?
Dialogue: 0,0:22:37.06,0:22:42.01,Default,,0,0,0,,Эмия Кирицугының атынан мен сізге бұйрықты сиқырмен бұйырдым.
Dialogue: 0,0:22:42.05,0:22:44.09,Default,,0,0,0,,Маған Қасиетті Граильді беріңіз
Dialogue: 0,0:22:45.02,0:22:48.00,Default,,0,0,0,,Сабер, Қасиетті Граалды алу үшін асыл фантасмаңызды пайдаланыңыз.
Dialogue: 0,0:22:49.02,0:22:50.06,Default,,0,0,0,,Жою
Dialogue: 0,0:22:51.04,0:22:52.01,Default,,0,0,0,,На
Dialogue: 0,0:22:54.05,0:22:55.03,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:22:55.07,0:22:57.03,Default,,0,0,0,,Нені айтып тұрсың, Сабер?
Dialogue: 0,0:22:58.02,0:22:59.02,Default,,0,0,0,,Жоқ
Dialogue: 0,0:22:59.08,0:23:03.05,Default,,0,0,0,,Үшінші пәрмен емлесі арқылы қайтадан пәрмен беріңіз
Dialogue: 0,0:23:04.04,0:23:05.07,Default,,0,0,0,,Неге, Кирицугу
Dialogue: 0,0:23:06.01,0:23:07.09,Default,,0,0,0,,Егер сіз
Dialogue: 0,0:23:08.03,0:23:09.02,Default,,0,0,0,,Мақсатқа жету біртүрлі бос сезім екен, иә?
Dialogue: 0,0:23:09.05,0:23:14.05,Default,,0,0,0,,Сен менің тойыма кедергі келтіріп тұрсың ба, дәулет?
Dialogue: 0,0:23:14.07,0:23:17.03,Default,,0,0,0,,Сабер Қасиетті Граил
Dialogue: 0,0:23:18.00,0:23:19.04,Default,,0,0,0,,Тоқта
Dialogue: 0,0:23:19.08,0:23:21.04,Default,,0,0,0,,Оны жойыңыз.
Dialogue: 0,0:24:56.07,0:24:58.08,Default,,0,0,0,,Сол жүз есімде
Dialogue: 0,0:24:59.01,0:25:00.05,Default,,0,0,0,,Көз жасыммен
Dialogue: 0,0:25:00.07,0:25:02.07,Default,,0,0,0,,Мен шын жүректен қуаныштымын
Dialogue: 0,0:25:03.01,0:25:04.05,Default,,0,0,0,,Адам фигурасы
Dialogue: 0,0:25:05.03,0:25:07.07,Default,,0,0,0,,Ер адам бір нәрсеге риза болуы керек
Dialogue: 0,0:25:08.04,0:25:10.06,Default,,0,0,0,,«Рахмет» дедім
Dialogue: 0,0:25:11.56,0:25:16.56,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
