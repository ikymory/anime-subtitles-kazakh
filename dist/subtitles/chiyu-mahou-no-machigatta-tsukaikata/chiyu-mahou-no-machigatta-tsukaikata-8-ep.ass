Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.08,0:00:07.42,Default,,0,0,0,,Бұл көп уақытты алады.
Dialogue: 0,0:00:08.13,0:00:11.84,Default,,0,0,0,,Біз лагерь орнататын жерге әлі жарты жолда қалдық, солай ма?
Dialogue: 0,0:00:11.92,0:00:15.18,Default,,0,0,0,,Жындарға шабуыл жасау үшін.
Dialogue: 0,0:00:15.26,0:00:18.18,Default,,0,0,0,,Қамалға жақын болуы мүмкін емес.
Dialogue: 0,0:00:18.26,0:00:23.44,Default,,0,0,0,,Дұрыс, жындар басып келеді.
Dialogue: 0,0:00:25.35,0:00:29.36,Default,,0,0,0,,Умм, капитан, жындар қандай нәсіл?
Dialogue: 0,0:00:29.44,0:00:33.95,Default,,0,0,0,,Дұрыс, жындар мүйізі біртүрлі адамдар.
Dialogue: 0,0:00:34.70,0:00:36.91,Default,,0,0,0,,Бір қарағанда адамға ұқсайды, бірақ
Dialogue: 0,0:00:36.99,0:00:41.66,Default,,0,0,0,,Негізінен адамның физикалық мүмкіндіктері мен сиқырлы күштері бар.
Dialogue: 0,0:00:41.75,0:00:44.96,Default,,0,0,0,,Адамнан артық...?
Dialogue: 0,0:00:45.04,0:00:49.54,Default,,0,0,0,,Тек басшылар ғана емес, ең төменгі сарбаздар да қорқынышты.
Dialogue: 0,0:00:50.13,0:00:51.30,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:00:51.38,0:00:55.26,Default,,0,0,0,,Мен қорқынышты адамдарды білемін, сондықтан бәрі жақсы.
Dialogue: 0,0:00:55.34,0:00:57.34,Default,,0,0,0,,Әңгімешіл бала.
Dialogue: 0,0:00:58.22,0:01:01.26,Default,,0,0,0,,Сіз жаңа ғана батырды шақыруға түсіп қалдыңыз.
Dialogue: 0,0:01:01.35,0:01:03.64,Default,,0,0,0,,Мен мұның соншалықты айналады деп күткен жоқпын.
Dialogue: 0,0:01:03.73,0:01:07.81,Default,,0,0,0,,Мен жиі айтамын, мені сол тозақтық жаттығудан өткізбе.
Dialogue: 0,0:01:07.90,0:01:12.19,Default,,0,0,0,,Мен сізге көпіршікті үрлеуді қалаймын.
Dialogue: 0,0:01:13.11,0:01:14.99,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:01:16.32,0:01:17.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:34.01,0:01:39.01,Default,,0,0,0,,♪～
Dialogue: 0,0:02:57.80,0:03:02.80,Default,,0,0,0,,～♪
Dialogue: 0,0:03:14.31,0:03:15.57,Default,,0,0,0,,Барлығы
Dialogue: 0,0:03:15.65,0:03:18.57,Default,,0,0,0,,Бірге келгендеріңізге рахмет.
Dialogue: 0,0:03:19.24,0:03:22.61,Default,,0,0,0,,Жақында «Сақиналы қараңғылықтың» жанындағы жазықта
Dialogue: 0,0:03:22.70,0:03:26.24,Default,,0,0,0,,Жындардың көрінгені туралы хабарлар бар.
Dialogue: 0,0:03:26.33,0:03:28.41,Default,,0,0,0,,Бұл өте жиі
Dialogue: 0,0:03:29.08,0:03:34.58,Default,,0,0,0,,Осы уақытқа дейін ешкімге шабуыл жасалған жоқ, бірақ зақым қашан болатынын білмейміз.
Dialogue: 0,0:03:34.67,0:03:36.79,Default,,0,0,0,,Сонымен, жағдайға байланысты
Dialogue: 0,0:03:36.88,0:03:40.72,Default,,0,0,0,,Жазықтардың жанынан өтіп бара жатқан саудагерлерге жолсерік беріледі.
Dialogue: 0,0:03:41.42,0:03:46.01,Default,,0,0,0,,Бұйрық генералдан төмен тұрған барлық басшыларға қалдырылады.
Dialogue: 0,0:03:46.10,0:03:50.68,Default,,0,0,0,,Жындар – адамнан асатын дене күші бар нәсіл.
Dialogue: 0,0:03:51.27,0:03:53.73,Default,,0,0,0,,Жанжалдан аулақ болыңыз.
Dialogue: 0,0:03:57.48,0:03:58.57,Default,,0,0,0,,Раушан
Dialogue: 0,0:03:59.82,0:04:02.86,Default,,0,0,0,,Жындардың қозғалысын қалай көресің?
Dialogue: 0,0:04:03.61,0:04:08.28,Default,,0,0,0,,Ештеңе білмеймін, бірақ ойыма келсе...
Dialogue: 0,0:04:10.75,0:04:13.33,Default,,0,0,0,,Сіз бұл шабуыл екеніне сенімдісіз бе?
Dialogue: 0,0:04:13.41,0:04:15.88,Default,,0,0,0,,Бүгінгі жындардың күші сонша...
Dialogue: 0,0:04:15.96,0:04:18.29,Default,,0,0,0,,Бұл мүмкіндік туралы.
Dialogue: 0,0:04:20.30,0:04:23.51,Default,,0,0,0,,Кез келген уақытта әскерлеріңізді жылжытуға дайын болыңыз.
Dialogue: 0,0:04:23.59,0:04:25.51,Default,,0,0,0,,Бұл ысырап болуы мүмкін.
Dialogue: 0,0:04:25.59,0:04:27.43,Default,,0,0,0,,Сонда бұл жақсы.
Dialogue: 0,0:04:27.51,0:04:31.39,Default,,0,0,0,,Төтенше жағдайда жедел әрекет ету маңыздырақ.
Dialogue: 0,0:04:31.98,0:04:34.56,Default,,0,0,0,,Ол әлі де байсалды жігіт.
Dialogue: 0,0:04:34.64,0:04:36.23,Default,,0,0,0,,Мен сізді тыңдаймын.
Dialogue: 0,0:04:36.31,0:04:39.52,Default,,0,0,0,,Мен мұны сендер естісін деп айттым.
Dialogue: 0,0:04:41.03,0:04:44.53,Default,,0,0,0,,Мен де кез келген уақытта көшуге дайын болуым керек пе?
Dialogue: 0,0:04:44.61,0:04:45.53,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:04:45.61,0:04:48.70,Default,,0,0,0,,Маған қосымша ақпарат керек.
Dialogue: 0,0:04:48.78,0:04:50.29,Default,,0,0,0,,Сәлем, капитан
Dialogue: 0,0:04:50.37,0:04:53.33,Default,,0,0,0,,Мен біреуді барлаушыға бір рет жіберуім керек пе?
Dialogue: 0,0:04:53.41,0:04:54.79,Default,,0,0,0,,Жоқ, жалпы...
Dialogue: 0,0:04:54.87,0:04:56.54,Default,,0,0,0,,Чо капитан
Dialogue: 0,0:04:56.62,0:04:58.67,Default,,0,0,0,,Бұдан былай, шу!
Dialogue: 0,0:04:58.75,0:05:01.46,Default,,0,0,0,,Ах! Басың жарылып кетсе не істейсің?
Dialogue: 0,0:05:01.55,0:05:04.30,Default,,0,0,0,,Сіз Мажимонның керемет күшісіз.
Dialogue: 0,0:05:04.38,0:05:06.13,Default,,0,0,0,,Мен өліп жатырмын
Dialogue: 0,0:05:06.22,0:05:08.18,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:05:08.26,0:05:10.93,Default,,0,0,0,,Басқа адамдар ойланып жатқанда тыныш болыңыз.
Dialogue: 0,0:05:11.01,0:05:14.06,Default,,0,0,0,,Менің бастығым тым қатыгез
Dialogue: 0,0:05:15.27,0:05:16.85,Default,,0,0,0,,Оның орнына, капитан.
Dialogue: 0,0:05:16.94,0:05:19.44,Default,,0,0,0,,Бұрынғы оқиға қорқынышты емес пе?
Dialogue: 0,0:05:19.52,0:05:21.36,Default,,0,0,0,,Мен ешқашан жын шығады деп күткен емеспін.
Dialogue: 0,0:05:22.61,0:05:25.24,Default,,0,0,0,,Гэе... неге?
Dialogue: 0,0:05:25.32,0:05:27.70,Default,,0,0,0,,Құпия ақпаратты тыңдамаңыз.
Dialogue: 0,0:05:27.78,0:05:29.87,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:29.95,0:05:31.99,Default,,0,0,0,,Барлық уақытта
Dialogue: 0,0:05:32.08,0:05:35.62,Default,,0,0,0,,Сіз ережелерді түсінбейсіз.
Dialogue: 0,0:05:36.41,0:05:39.96,Default,,0,0,0,,Бірақ шынымен де жындар не үшін бар?
Dialogue: 0,0:05:40.04,0:05:42.38,Default,,0,0,0,,Бұл жақсы нәрсе емес екеніне сенімдімін.
Dialogue: 0,0:05:42.46,0:05:44.63,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:44.71,0:05:47.43,Default,,0,0,0,,Жарайды, төтенше жағдай болса, іссапарға шығамыз.
Dialogue: 0,0:05:47.51,0:05:50.26,Default,,0,0,0,,Тек оларды кері айдау керек.
Dialogue: 0,0:05:50.35,0:05:53.31,Default,,0,0,0,,Үкі, менсінбеу өлімге әкеледі.
Dialogue: 0,0:05:53.39,0:05:56.02,Default,,0,0,0,,Е... О, жоқ, мен білемін.
Dialogue: 0,0:05:56.10,0:05:58.06,Default,,0,0,0,,Әрине мен сені қорлап тұрған жоқпын.
Dialogue: 0,0:05:58.14,0:06:00.73,Default,,0,0,0,,Жаңа айтқандарыңыз туралы олай ойламаймын.
Dialogue: 0,0:06:00.81,0:06:02.61,Default,,0,0,0,,Хо, бұл рас.
Dialogue: 0,0:06:02.69,0:06:06.19,Default,,0,0,0,,Бұл нүктені капитан физикалық түрде үйге соқты.
Dialogue: 0,0:06:06.28,0:06:09.49,Default,,0,0,0,,Бүгін түстен кейін сіздің жаттығуыңызды көруді шештім.
Dialogue: 0,0:06:09.57,0:06:10.62,Default,,0,0,0,,Вегетариандық деген нәрсе бар емес пе?
Dialogue: 0,0:06:10.70,0:06:14.33,Default,,0,0,0,,Капитан да батальон командирі болды, сондықтан қолы бос емес пе?
Dialogue: 0,0:06:14.41,0:06:17.12,Default,,0,0,0,,Жұмысыңа кедергі жасау жаман.
Dialogue: 0,0:06:17.21,0:06:19.92,Default,,0,0,0,,Қош келдіңіз, капитан.
Dialogue: 0,0:06:20.00,0:06:21.67,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:06:21.75,0:06:24.96,Default,,0,0,0,,Не болды, капитанның орынбасары? Сіз бозарған сияқтысыз.
Dialogue: 0,0:06:25.05,0:06:26.84,Default,,0,0,0,,Аа, әсіресе ештеңе...
Dialogue: 0,0:06:26.92,0:06:31.05,Default,,0,0,0,,Бүгіннен бастап мен сендерді біраз уақыттан кейін алғаш рет қайта жаттықтырамын.
Dialogue: 0,0:06:31.14,0:06:32.14,Default,,0,0,0,,Мен – Шығыс Одақтың Элькияға тағайындаған екінші елшісі Ино Хацусе.
Dialogue: 0,0:06:32.22,0:06:34.06,Default,,0,0,0,,Үкі, сен не істедің?
Dialogue: 0,0:06:34.14,0:06:36.93,Default,,0,0,0,,Не? Не? Мен ештеңе айтқан жоқпын
Dialogue: 0,0:06:37.02,0:06:39.56,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба? Иә, иә.
Dialogue: 0,0:06:39.64,0:06:41.85,Default,,0,0,0,,Жоқ... жоқ, бұл...
Dialogue: 0,0:06:41.94,0:06:46.44,Default,,0,0,0,,А, иә! Менің көзқарасым бойынша, бұл күндері бәрі әлсіреген.
Dialogue: 0,0:06:46.53,0:06:49.86,Default,,0,0,0,,Бұл менің вице-капитан ретіндегі сыйлығым...
Dialogue: 0,0:06:49.95,0:06:51.53,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:06:51.61,0:06:53.03,Default,,0,0,0,,Сіз ең бос адам шығарсыз!
Dialogue: 0,0:06:53.12,0:06:55.16,Default,,0,0,0,,Бізге қатысыңыз!
Dialogue: 0,0:06:55.24,0:06:58.54,Default,,0,0,0,,Itai Itai Басшыларға зорлық көрсету дегеніміз не?
Dialogue: 0,0:06:58.62,0:07:00.04,Default,,0,0,0,,Шулы
Dialogue: 0,0:07:00.12,0:07:02.04,Default,,0,0,0,,Оу Кукуру Кю!
Dialogue: 0,0:07:02.13,0:07:04.34,Default,,0,0,0,,Капитан! Өтінемін тоқта
Dialogue: 0,0:07:04.42,0:07:06.21,Default,,0,0,0,,Білесің бе, аяусыз!
Dialogue: 0,0:07:06.30,0:07:09.01,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:07:10.05,0:07:12.18,Default,,0,0,0,,Жындарға қатысты.
Dialogue: 0,0:07:12.26,0:07:17.14,Default,,0,0,0,,Олар біздің аумақтағы құбыжықтарға шабуыл жасап жатқан сияқты.
Dialogue: 0,0:07:17.93,0:07:19.98,Default,,0,0,0,,Куәгердің айтуынша,
Dialogue: 0,0:07:20.06,0:07:23.44,Default,,0,0,0,,Бұл оқытылған жауынгерлер тобы болса керек.
Dialogue: 0,0:07:23.52,0:07:27.90,Default,,0,0,0,,Үздіксіз және ұйымдасқан қозғалысты айтасыз ба?
Dialogue: 0,0:07:27.98,0:07:29.49,Default,,0,0,0,,Жағымсыз иіс шығады.
Dialogue: 0,0:07:29.57,0:07:33.74,Default,,0,0,0,,Роза, жынның әрекетінің себебін анықтап берші.
Dialogue: 0,0:07:33.82,0:07:35.91,Default,,0,0,0,,Қажет болса...
Dialogue: 0,0:07:35.99,0:07:39.00,Default,,0,0,0,,Сондай-ақ күш қолдану...?
Dialogue: 0,0:07:39.58,0:07:43.96,Default,,0,0,0,,Әй, сен болсаң, мен ешнәрсе жасамас едім.
Dialogue: 0,0:07:44.04,0:07:46.79,Default,,0,0,0,,Сеніміңізге рахмет
Dialogue: 0,0:07:46.88,0:07:50.21,Default,,0,0,0,,Мен міндетті түрде үйге нәтижемен ораламын.
Dialogue: 0,0:07:50.80,0:07:54.22,Default,,0,0,0,,Сондықтан біз кетуді шештік.
Dialogue: 0,0:07:54.30,0:07:59.27,Default,,0,0,0,,Орналасқан жері Лингле қараңғылығының айналасында. Біз ертең таңертең ерте кетеміз.
Dialogue: 0,0:07:59.35,0:08:01.06,Default,,0,0,0,,Сұрақтарыңыз бар ма?
Dialogue: 0,0:08:01.14,0:08:03.73,Default,,0,0,0,,Сіз қанша адаммен жұмыс жасайсыз?
Dialogue: 0,0:08:03.81,0:08:06.61,Default,,0,0,0,,Бұл шамамен 10-30 адам.
Dialogue: 0,0:08:06.69,0:08:07.94,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:08.02,0:08:11.15,Default,,0,0,0,,Егер күресу керек болса, бұл өте қиын болуы мүмкін.
Dialogue: 0,0:08:11.24,0:08:14.99,Default,,0,0,0,,Олай болса, бәріңе! Қауіпсіздікке жол бермеңіз және дайындық жасаңыз
Dialogue: 0,0:08:15.07,0:08:16.70,Default,,0,0,0,,Айтасың, айтасың!
Dialogue: 0,0:08:16.78,0:08:20.79,Default,,0,0,0,,Мен кімнің кінәсінен өткен аптаны тозақтың жаттығуы деп ойладым!
Dialogue: 0,0:08:20.87,0:08:23.21,Default,,0,0,0,,Өзіңіз туралы ойланыңыз, ақымақ вице-капитан!
Dialogue: 0,0:08:23.29,0:08:24.46,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:08:24.54,0:08:25.58,Default,,0,0,0,,Бірақ соның арқасында
Dialogue: 0,0:08:25.67,0:08:28.42,Default,,0,0,0,,Барлығы сергек болып, керемет көрінеді.
Dialogue: 0,0:08:28.50,0:08:30.05,Default,,0,0,0,,Осымен миссия жеңіл болады...
Dialogue: 0,0:08:30.13,0:08:32.97,Default,,0,0,0,,(мүшелердің құрамы)
Dialogue: 0,0:08:30.13,0:08:32.97,Default,,0,0,0,,Әй, заттарды лақтырмаңыз, бұл қауіпті! Уф
Dialogue: 0,0:08:32.97,0:08:34.47,Default,,0,0,0,,Әй, заттарды тастама, бұл қауіпті! Уф
Dialogue: 0,0:08:34.55,0:08:35.47,Default,,0,0,0,,Cu?
Dialogue: 0,0:08:35.55,0:08:38.39,Default,,0,0,0,,Кукуру, сен бұл жолы жоқсың.
Dialogue: 0,0:08:38.47,0:08:39.89,Default,,0,0,0,,Кю~
Dialogue: 0,0:08:39.97,0:08:42.68,Default,,0,0,0,,Егер сіз құбыжықтарды анықтай алсаңыз.
Dialogue: 0,0:08:42.77,0:08:44.19,Default,,0,0,0,,Тергеу оңайырақ болады
Dialogue: 0,0:08:44.81,0:08:48.19,Default,,0,0,0,,Дегенмен, сізді жын-перілердің нысанаға алу мүмкіндігі бар.
Dialogue: 0,0:08:48.27,0:08:49.86,Default,,0,0,0,,Мен сізді қауіп төндіргім келмейді.
Dialogue: 0,0:08:50.52,0:08:52.53,Default,,0,0,0,,Кю... Капитан!
Dialogue: 0,0:08:52.61,0:08:55.66,Default,,0,0,0,,Олар сұмдық жасады!
Dialogue: 0,0:08:56.74,0:08:58.07,Default,,0,0,0,,Балалар
Dialogue: 0,0:08:58.16,0:09:03.16,Default,,0,0,0,,Бұл миссияға толық дайындалған дұрыс деп ойлаймын.
Dialogue: 0,0:09:03.25,0:09:06.04,Default,,0,0,0,,Сондықтан мен де сендермен бірге майданға келемін.
Dialogue: 0,0:09:06.12,0:09:07.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:07.63,0:09:08.79,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:09:08.88,0:09:13.34,Default,,0,0,0,,Капитан бізбен соғысқанша, жауымыз жоқ!
Dialogue: 0,0:09:13.42,0:09:16.80,Default,,0,0,0,,Бірдеңе болып қалса да, емдік сиқырмен емделуге болады!
Dialogue: 0,0:09:16.88,0:09:20.76,Default,,0,0,0,,О! Сіз жарақат туралы алаңдамай бар күш-жігеріңізді жұмсай аласыз!
Dialogue: 0,0:09:20.85,0:09:23.22,Default,,0,0,0,,Сіз мұны бар күшіңізбен жасай аласыз!
Dialogue: 0,0:09:23.31,0:09:24.18,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:09:24.27,0:09:28.35,Default,,0,0,0,,Жарайсыңдар бәріңе! Сол жындарды ұшырып жіберейік!
Dialogue: 0,0:09:28.44,0:09:29.77,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:09:30.69,0:09:34.36,Default,,0,0,0,,Олар мүлдем үмітсіз...
Dialogue: 0,0:09:35.03,0:09:37.41,Default,,0,0,0,,Балалар, қазір дайындалыңдар!
Dialogue: 0,0:09:37.49,0:09:38.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:39.03,0:09:42.41,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:09:50.84,0:09:51.84,Default,,0,0,0,,Ki~
Dialogue: 0,0:09:57.47,0:09:58.84,Default,,0,0,0,,Барлығы тыңдайды
Dialogue: 0,0:09:58.93,0:10:01.64,Default,,0,0,0,,Бүгінгі іздеу сәтсіз болды.
Dialogue: 0,0:10:02.22,0:10:06.56,Default,,0,0,0,,Капитанмен сөйлескеннен кейін ертең орманның батыс жағына кіруді ұйғардық.
Dialogue: 0,0:10:06.64,0:10:09.65,Default,,0,0,0,,Батыс? Бұл өте тік жер.
Dialogue: 0,0:10:09.73,0:10:12.19,Default,,0,0,0,,Иә, мен атты қалдырамын.
Dialogue: 0,0:10:12.27,0:10:16.19,Default,,0,0,0,,Алдымен атпен жүретін жерді тауып алған тиімді емес пе?
Dialogue: 0,0:10:16.28,0:10:20.24,Default,,0,0,0,,Жоқ, бұл батыс. Батыста бір нәрсе бар.
Dialogue: 0,0:10:20.32,0:10:21.66,Default,,0,0,0,,Мен солай сезінемін
Dialogue: 0,0:10:27.96,0:10:31.88,Default,,0,0,0,,Жарайды, сен айтсаң, мен істеймін.
Dialogue: 0,0:10:31.96,0:10:33.84,Default,,0,0,0,,Ол вице-капитан.
Dialogue: 0,0:10:33.92,0:10:36.21,Default,,0,0,0,,Сонымен, бұл соңы ма?
Dialogue: 0,0:10:36.30,0:10:38.09,Default,,0,0,0,,Е... иә
Dialogue: 0,0:10:38.17,0:10:42.35,Default,,0,0,0,,Біз кезекпен отты жағамыз, бірақ оған дейін бәрі төсекке жатуы керек...
Dialogue: 0,0:10:42.43,0:10:44.51,Default,,0,0,0,,Ах... хахаха...
Dialogue: 0,0:10:45.60,0:10:49.81,Default,,0,0,0,,Сізге де ұйықтау керек. Мен алдымен отты реттеймін.
Dialogue: 0,0:10:50.52,0:10:52.52,Default,,0,0,0,,Иә
Dialogue: 0,0:11:04.49,0:11:09.87,Default,,0,0,0,,Оңай ұйықтамайтын жігіт бар сияқты, бірақ мен оған ұйықтауға көмектесуім керек пе?
Dialogue: 0,0:11:09.96,0:11:12.54,Default,,0,0,0,,Ух... у... бұл неге болып жатыр?
Dialogue: 0,0:11:12.63,0:11:15.29,Default,,0,0,0,,Бұл жай ғана болжам. Бұл қорқынышты.
Dialogue: 0,0:11:22.43,0:11:25.43,Default,,0,0,0,,Мм... сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:11:25.51,0:11:27.18,Default,,0,0,0,,Не?
Dialogue: 0,0:11:27.26,0:11:30.77,Default,,0,0,0,,Неліктен капитан мені орынбасары етіп таңдады?
Dialogue: 0,0:11:30.85,0:11:31.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:31.89,0:11:34.23,Default,,0,0,0,,Өйткені мен, бұл бөлімде,
Dialogue: 0,0:11:34.31,0:11:36.36,Default,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:11:36.90,0:11:40.11,Default,,0,0,0,,Бұл жерде таңғаларлық ештеңе жоқ...
Dialogue: 0,0:11:40.19,0:11:43.66,Default,,0,0,0,,Бұл менің біліктілігім жоқ дегенді білдіре ме?
Dialogue: 0,0:11:44.87,0:11:47.49,Default,,0,0,0,,Бұл бөлімше капитанның қатаң бақылауында.
Dialogue: 0,0:11:47.58,0:11:49.75,Default,,0,0,0,,Вице-капитан не істейді?
Dialogue: 0,0:11:49.83,0:11:53.54,Default,,0,0,0,,Есеп құру, қару-жараққа өтініш жазу және т.б.
Dialogue: 0,0:11:53.62,0:11:56.09,Default,,0,0,0,,Бұл дерлік жұмыс емес пе?
Dialogue: 0,0:11:56.17,0:11:58.80,Default,,0,0,0,,Мұны біреу істеу керек
Dialogue: 0,0:11:58.88,0:12:03.76,Default,,0,0,0,,Қателер туралы шағымдар мен есептердің болмауы істің қандай да бір жолмен жақсы жүріп жатқанын білдіреді.
Dialogue: 0,0:12:03.84,0:12:07.30,Default,,0,0,0,,…
Dialogue: 0,0:12:07.39,0:12:11.60,Default,,0,0,0,,...
Dialogue: 0,0:12:11.68,0:12:13.39,Default,,0,0,0,,ше? Капитан?
Dialogue: 0,0:12:13.48,0:12:15.35,Default,,0,0,0,,Мен де батальон командирі болдым.
Dialogue: 0,0:12:15.44,0:12:18.94,Default,,0,0,0,,１
Dialogue: 0,0:12:19.02,0:12:22.74,Default,,0,0,0,,Ақырында бұл бөлімді басқару маған тапсырылады.
Dialogue: 0,0:12:22.82,0:12:24.41,Default,,0,0,0,,Жоқ, жоқ, мүмкін емес!
Dialogue: 0,0:12:24.49,0:12:27.83,Default,,0,0,0,,Егер мен қолбасшы болсам, өзара шабуыл болады.
Dialogue: 0,0:12:27.91,0:12:30.58,Default,,0,0,0,,...
Dialogue: 0,0:12:30.66,0:12:33.62,Default,,0,0,0,,Достарың туралы не ойлайсыңдар?
Dialogue: 0,0:12:33.71,0:12:35.50,Default,,0,0,0,,Тек жақсы емес.
Dialogue: 0,0:12:35.58,0:12:38.67,Default,,0,0,0,,...
Dialogue: 0,0:12:39.21,0:12:40.34,Default,,0,0,0,,Я...
Dialogue: 0,0:12:41.51,0:12:44.76,Default,,0,0,0,,...
Dialogue: 0,0:12:46.01,0:12:49.26,Default,,0,0,0,,...
Dialogue: 0,0:12:49.35,0:12:51.52,Default,,0,0,0,,Менің ойлағаным дұрыс болды
Dialogue: 0,0:12:51.60,0:12:54.39,Default,,0,0,0,,...
Dialogue: 0,0:12:55.60,0:12:57.27,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:12:57.35,0:13:00.36,Default,,0,0,0,,Мені ешкім бағындыра алмайды
Dialogue: 0,0:13:00.44,0:13:04.45,Default,,0,0,0,,Кімде-кім арызданса, қолыммен үнін өшіремін.
Dialogue: 0,0:13:04.95,0:13:07.74,Default,,0,0,0,,Мен рыцарь ойнаған кездегі сезімде болдым.
Dialogue: 0,0:13:07.82,0:13:10.91,Default,,0,0,0,,А, сен атақты едің.
Dialogue: 0,0:13:10.99,0:13:13.12,Default,,0,0,0,,Оның қабілеті дәлелденген, бірақ
Dialogue: 0,0:13:13.20,0:13:16.92,Default,,0,0,0,,...
Dialogue: 0,0:13:20.17,0:13:22.05,Default,,0,0,0,,Менің алдымда
Dialogue: 0,0:13:22.71,0:13:24.59,Default,,0,0,0,,Сіз пайда болдыңыз
Dialogue: 0,0:13:24.67,0:13:26.97,Default,,0,0,0,,Мен бұрынғыдаймын
Dialogue: 0,0:13:27.05,0:13:30.26,Default,,0,0,0,,...
Dialogue: 0,0:13:30.35,0:13:35.23,Default,,0,0,0,,...
Dialogue: 0,0:13:35.31,0:13:37.94,Default,,0,0,0,,...
Dialogue: 0,0:13:38.65,0:13:39.98,Default,,0,0,0,,Қарсылық көрсетсеңіз, сізді өшіреді.
Dialogue: 0,0:13:40.06,0:13:44.28,Default,,0,0,0,,...
Dialogue: 0,0:13:44.36,0:13:46.28,Default,,0,0,0,,Мен сені ұрайын дегенде
Dialogue: 0,0:13:46.36,0:13:50.32,Default,,0,0,0,,Мен жұдырықпен ес-түссіз қалдым, бұл менің бұрынғы және кейінгі оқиғалар туралы естеліктерімді өшірді.
Dialogue: 0,0:13:50.99,0:13:53.41,Default,,0,0,0,,Мен сені қатты ұрған жоқпын.
Dialogue: 0,0:13:53.49,0:13:56.58,Default,,0,0,0,,…
Dialogue: 0,0:13:57.50,0:13:59.25,Default,,0,0,0,,Мен сол кезде
Dialogue: 0,0:13:59.33,0:14:02.25,Default,,0,0,0,,...
Dialogue: 0,0:14:03.00,0:14:07.51,Default,,0,0,0,,...
Dialogue: 0,0:14:07.59,0:14:09.59,Default,,0,0,0,,Мен жеңілгенді жек көремін.
Dialogue: 0,0:14:10.18,0:14:13.89,Default,,0,0,0,,Айтпақшы, ортадан біртүрлі мотивация алдым.
Dialogue: 0,0:14:13.97,0:14:16.77,Default,,0,0,0,,Ал, мен онша үлкен мәміле жасаған жоқпын.
Dialogue: 0,0:14:17.35,0:14:19.73,Default,,0,0,0,,Егер сіз капитан ретінде қарасаңыз, мен солай ойлаймын.
Dialogue: 0,0:14:19.81,0:14:22.31,Default,,0,0,0,,Бұл мен үшін бірінші болды.
Dialogue: 0,0:14:22.86,0:14:26.94,Default,,0,0,0,,Соңына дейін берілмей маған қараған адам
Dialogue: 0,0:14:28.82,0:14:34.41,Default,,0,0,0,,Менен бәрінің көңілі қалғаны сонша, мен бас тарттым, бірақ сен ғана маған соқтығыстың.
Dialogue: 0,0:14:34.49,0:14:37.33,Default,,0,0,0,,Бұл өте тітіркендіргіш
Dialogue: 0,0:14:37.96,0:14:41.00,Default,,0,0,0,,Бірақ мен бақытты болдым.
Dialogue: 0,0:14:41.08,0:14:45.50,Default,,0,0,0,,Жасақтағылардың бәрі де осылай ойлайтынына сенімдімін.
Dialogue: 0,0:14:45.59,0:14:49.84,Default,,0,0,0,,Бізді ең жақсы түсінетін адам сенсің.
Dialogue: 0,0:14:49.93,0:14:53.35,Default,,0,0,0,,Сондықтан біздің капитан сізден басқа ешкім бола алмайды.
Dialogue: 0,0:14:56.97,0:14:58.18,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:14:58.27,0:14:59.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:59.23,0:15:00.19,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:15:00.27,0:15:01.23,Default,,0,0,0,,Оны ұмытып қалдың ба?
Dialogue: 0,0:15:01.31,0:15:04.61,Default,,0,0,0,,Түптеп келгенде, бұл ата-анасын тастап кете алмайтын баланың сөзі ғана.
Dialogue: 0,0:15:04.69,0:15:08.07,Default,,0,0,0,,Ұятсыз мойындауға мұндай реакция...
Dialogue: 0,0:15:08.15,0:15:10.36,Default,,0,0,0,,Ал... Капитан күткендей.
Dialogue: 0,0:15:10.45,0:15:14.58,Default,,0,0,0,,Мен сені ең жақсы түсіндім дедің.
Dialogue: 0,0:15:14.66,0:15:16.04,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:15:16.12,0:15:20.46,Default,,0,0,0,,Мен капитан болуға жарамсыз адамды ұсынар едім деп ойлайсыз ба?
Dialogue: 0,0:15:20.54,0:15:23.75,Default,,0,0,0,,А... бұл... өйткені...
Dialogue: 0,0:15:23.83,0:15:27.42,Default,,0,0,0,,Мен сені бекер капитан етіп қойған жоқпын.
Dialogue: 0,0:15:27.50,0:15:29.21,Default,,0,0,0,,Мен оны сеніммен таңдадым.
Dialogue: 0,0:15:29.30,0:15:31.55,Default,,0,0,0,,Иә? Уф!
Dialogue: 0,0:15:31.63,0:15:35.22,Default,,0,0,0,,Сіз бірдеңе істеуге шешім қабылдағаннан кейін, сіз ойланбайсыз.
Dialogue: 0,0:15:35.30,0:15:38.85,Default,,0,0,0,,Қандай жағдай болмасын, тайсалмай алға қарауға болады.
Dialogue: 0,0:15:38.93,0:15:43.73,Default,,0,0,0,,Айналаңыздағыларға эмоционалды қолдаудың көзі бола алады.
Dialogue: 0,0:15:43.81,0:15:45.15,Default,,0,0,0,,Е...
Dialogue: 0,0:15:45.23,0:15:47.73,Default,,0,0,0,,Егер сіз әрқашан жасайтын нәрсені істесеңіз
Dialogue: 0,0:15:47.82,0:15:51.07,Default,,0,0,0,,Басқа адамдар сізге рұқсатсыз ереді.
Dialogue: 0,0:15:51.70,0:15:55.20,Default,,0,0,0,,Ол маған рұқсатсыз еріп келеді...
Dialogue: 0,0:15:55.28,0:15:59.45,Default,,0,0,0,,Ха... Мен саған осыншама көп айтпайынша неге түсінбейсің деп ойлаймын.
Dialogue: 0,0:15:59.54,0:16:02.62,Default,,0,0,0,,Түсінбедім, маған айту керек.
Dialogue: 0,0:16:02.71,0:16:05.63,Default,,0,0,0,,Осыны ескере отырып, ол біраз күліп тұрған сияқты.
Dialogue: 0,0:16:05.71,0:16:06.54,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:16:06.63,0:16:08.46,Default,,0,0,0,,Маған тағы бір оқ ату керек пе?
Dialogue: 0,0:16:08.55,0:16:09.96,Default,,0,0,0,,Кеке Кеке... Жақсы.
Dialogue: 0,0:16:10.92,0:16:11.84,Default,,0,0,0,,Иә
Dialogue: 0,0:16:11.92,0:16:15.93,Default,,0,0,0,,Тыңда, Үкі, өзгермейтін нәрсе жоқ.
Dialogue: 0,0:16:16.01,0:16:18.68,Default,,0,0,0,,Бір күні бәрі өзгереді
Dialogue: 0,0:16:18.76,0:16:22.35,Default,,0,0,0,,Оны қабылдамасаң, алға жылжи алмайсың.
Dialogue: 0,0:16:22.43,0:16:25.10,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:16:25.19,0:16:28.90,Default,,0,0,0,,Мен сіздердің капитандарыңыз болдым.
Dialogue: 0,0:16:29.69,0:16:33.07,Default,,0,0,0,,Бұлай терең ойлаудың қажеті жоқ.
Dialogue: 0,0:16:34.45,0:16:35.57,Default,,0,0,0,,Иә
Dialogue: 0,0:16:35.66,0:16:40.04,Default,,0,0,0,,Олай болса мен отты басып аламын, мен ұйықтаймын.
Dialogue: 0,0:16:40.12,0:16:43.04,Default,,0,0,0,,Иә, қалғанын өзім шешемін.
Dialogue: 0,0:16:43.12,0:16:44.21,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:16:46.25,0:16:48.75,Default,,0,0,0,,Ей, сендер де ұйықтап алыңдар.
Dialogue: 0,0:16:48.84,0:16:51.05,Default,,0,0,0,,Иә? Сіз жігіттер?
Dialogue: 0,0:16:51.76,0:16:54.97,Default,,0,0,0,,Вице-капитан, мен сізге сенемін.
Dialogue: 0,0:16:55.05,0:16:57.59,Default,,0,0,0,,Мен сені жек көрмеймін
Dialogue: 0,0:16:57.68,0:16:59.64,Default,,0,0,0,,О... сендер балалар.
Dialogue: 0,0:16:59.72,0:17:02.10,Default,,0,0,0,,Айтайын дегенім, мен ешкімді жек көрмеймін.
Dialogue: 0,0:17:02.18,0:17:05.02,Default,,0,0,0,,Кейде сіз жай ғана ережелерді сақтайсыз, солай ма?
Dialogue: 0,0:17:05.10,0:17:08.19,Default,,0,0,0,,Сіз тым көп уайымдап жатырсыз, вице-капитан.
Dialogue: 0,0:17:08.27,0:17:09.19,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:17:09.27,0:17:10.65,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:17:10.73,0:17:13.86,Default,,0,0,0,,Күлкіңді ұстап тұрып бұлай айтпауың керек!
Dialogue: 0,0:17:13.94,0:17:16.20,Default,,0,0,0,,Маған маскаңызды беріңіз.
Dialogue: 0,0:17:16.28,0:17:19.70,Default,,0,0,0,,Жындармен соғыспас бұрын, мен сені ұрып-соғамын.
Dialogue: 0,0:17:20.24,0:17:22.24,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:17:29.79,0:17:31.88,Default,,0,0,0,,Ия... уф...
Dialogue: 0,0:17:31.96,0:17:33.17,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:17:33.26,0:17:34.51,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:17:35.97,0:17:38.18,Default,,0,0,0,,Бұл Жарқыраған қасқырдың тырнақ белгісі.
Dialogue: 0,0:17:38.26,0:17:41.81,Default,,0,0,0,,Міне, іздер мен өлі қан
Dialogue: 0,0:17:41.89,0:17:44.22,Default,,0,0,0,,Жындар құбыжықтарды аулайды.
Dialogue: 0,0:17:44.31,0:17:45.64,Default,,0,0,0,,Көру өте керемет.
Dialogue: 0,0:17:45.73,0:17:47.64,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:17:47.73,0:17:51.86,Default,,0,0,0,,Адам аумағында құбыжықтарды аулау үшін бару.
Dialogue: 0,0:17:51.94,0:17:53.78,Default,,0,0,0,,Жай хобби ме?
Dialogue: 0,0:17:53.86,0:17:56.45,Default,,0,0,0,,Егер солай болса, онда бұл орынсыз.
Dialogue: 0,0:17:56.53,0:17:59.87,Default,,0,0,0,,Әйтеуір менде басқа мақсат бар сияқты.
Dialogue: 0,0:18:00.87,0:18:03.95,Default,,0,0,0,,(Қасқыр үреді)
Dialogue: 0,0:18:04.04,0:18:06.00,Default,,0,0,0,,Барлық жауынгерлік әзірлік
Dialogue: 0,0:18:06.08,0:18:07.41,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:18:09.42,0:18:11.13,Default,,0,0,0,,(Қасқыр үреді)
Dialogue: 0,0:18:12.17,0:18:13.67,Default,,0,0,0,,Ол қыңыр.
Dialogue: 0,0:18:13.75,0:18:15.09,Default,,0,0,0,,Тасымалдау
Dialogue: 0,0:18:31.56,0:18:33.65,Default,,0,0,0,,Ақырында ренжідіңіз бе?
Dialogue: 0,0:18:46.91,0:18:49.46,Default,,0,0,0,,Балалар сендер әлі қозғалмайсыңдар.
Dialogue: 0,0:18:49.54,0:18:50.92,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:18:55.67,0:18:58.67,Default,,0,0,0,,Біреудің жерінде не тығылып жүрсің?
Dialogue: 0,0:18:58.76,0:19:01.72,Default,,0,0,0,,Жындар монстрларды көрсету үшін пайдалана ма?
Dialogue: 0,0:19:06.31,0:19:09.89,Default,,0,0,0,,Мен мұндай миссияны орындауға құлықсыз болдым.
Dialogue: 0,0:19:11.31,0:19:14.27,Default,,0,0,0,,Егер ол болашақта пайда әкелсе
Dialogue: 0,0:19:14.36,0:19:16.07,Default,,0,0,0,,Орындалу керек
Dialogue: 0,0:19:16.15,0:19:18.24,Default,,0,0,0,,Бұл қандай миссия?
Dialogue: 0,0:19:18.86,0:19:20.40,Default,,0,0,0,,Мен олай айтпас едім.
Dialogue: 0,0:19:21.03,0:19:23.95,Default,,0,0,0,,Ал, біз не істеуіміз керек?
Dialogue: 0,0:19:24.03,0:19:27.33,Default,,0,0,0,,Сіз әлі де ұрысудан аулақ бола аласыз.
Dialogue: 0,0:19:27.41,0:19:29.83,Default,,0,0,0,,Тыныш кетсең, сағынамын.
Dialogue: 0,0:19:29.91,0:19:35.50,Default,,0,0,0,,Тәкаппар сөйлейсің, бірақ сенде сонша күш бар сияқты.
Dialogue: 0,0:19:35.59,0:19:40.67,Default,,0,0,0,,Бірақ мен бұл жерді көргендіктен, мен сені тірідей үйге жібере алмаймын.
Dialogue: 0,0:19:41.47,0:19:43.01,Default,,0,0,0,,Барлығы өлсін
Dialogue: 0,0:19:46.93,0:19:49.47,Default,,0,0,0,,Үкі Бұйрықты саған қалдырамын, ә?
Dialogue: 0,0:19:49.56,0:19:53.40,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге нұсқаулар беретіндей пациент емеспін.
Dialogue: 0,0:19:53.48,0:19:55.06,Default,,0,0,0,,Мен де солай ойладым, бірақ бұл шешімді талқылаудың қажеті жоқ
Dialogue: 0,0:19:56.73,0:19:57.90,Default,,0,0,0,,Иә
Dialogue: 0,0:19:58.44,0:20:02.32,Default,,0,0,0,,Көрейік, мен өлесің бе, сен өлесің бе.
Dialogue: 0,0:20:02.40,0:20:06.66,Default,,0,0,0,,Қолыңыздан келсе, байқап көріңіз!
Dialogue: 0,0:20:07.74,0:20:12.58,Default,,0,0,0,,Балалар, кішкентай жындарға ынтымақтастығымызды көрсетейік!
Dialogue: 0,0:20:12.66,0:20:13.58,Default,,0,0,0,,О!
Dialogue: 0,0:20:13.67,0:20:15.00,Default,,0,0,0,,(Жын сарбаздарының айқайы)
Dialogue: 0,0:20:16.29,0:20:19.84,Default,,0,0,0,,Жел, аяғым, қалқаным бол.
Dialogue: 0,0:20:19.92,0:20:21.51,Default,,0,0,0,,Сонда менің денем болады
Dialogue: 0,0:20:21.59,0:20:24.01,Default,,0,0,0,,Бәрін шауып өтетін қылышқа айналады.
Dialogue: 0,0:20:24.09,0:20:25.43,Default,,0,0,0,,Жел броньы?
Dialogue: 0,0:20:25.51,0:20:26.85,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:20:30.68,0:20:31.52,Default,,0,0,0,,Иә
Dialogue: 0,0:20:32.98,0:20:35.35,Default,,0,0,0,,Қарапайым адам осылай тез әрекет етеді деп ойлау...
Dialogue: 0,0:20:35.44,0:20:36.98,Default,,0,0,0,,Шу!
Dialogue: 0,0:20:38.27,0:20:40.23,Default,,0,0,0,,Өзімді жоғалтып алған сияқтымын.
Dialogue: 0,0:20:47.12,0:20:48.95,Default,,0,0,0,,Куцу жеңіл соқты
Dialogue: 0,0:20:51.04,0:20:53.58,Default,,0,0,0,,Сол сәтте жел...
Dialogue: 0,0:20:55.71,0:20:57.54,Default,,0,0,0,,Мен мұны сұрадым, балалар.
Dialogue: 0,0:20:57.54,0:20:58.38,Default,,0,0,0,,Мен мұны сұрадым, балалар.
Dialogue: 0,0:20:57.54,0:20:58.38,Default,,0,0,0,,Онда абай болыңыз!
Dialogue: 0,0:20:58.38,0:20:59.34,Default,,0,0,0,,Онда абай болыңыз!
Dialogue: 0,0:21:03.72,0:21:06.93,Default,,0,0,0,,Бұл қиын тактика, адам.
Dialogue: 0,0:21:07.01,0:21:08.72,Default,,0,0,0,,Мен таптым!
Dialogue: 0,0:21:16.98,0:21:19.31,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:21:27.74,0:21:29.95,Default,,0,0,0,,Ахх!
Dialogue: 0,0:21:37.50,0:21:38.63,Default,,0,0,0,,Уф
Dialogue: 0,0:22:01.44,0:22:04.48,Default,,0,0,0,,Мен мұндай күшті ешкімді көрген емеспін.
Dialogue: 0,0:22:04.57,0:22:06.70,Default,,0,0,0,,Жау болсақ та, мақтауға лайық.
Dialogue: 0,0:22:06.78,0:22:10.41,Default,,0,0,0,,Сөйлескің келсе, ұрған соң істе!
Dialogue: 0,0:22:11.70,0:22:12.78,Default,,0,0,0,,Құт
Dialogue: 0,0:22:15.00,0:22:15.91,Default,,0,0,0,,(металлдың соғылған дыбысы)
Dialogue: 0,0:22:16.00,0:22:18.21,Default,,0,0,0,,Казе но Яйбаны араластырдың ба?
Dialogue: 0,0:22:18.83,0:22:19.71,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:22:20.92,0:22:24.55,Default,,0,0,0,,Хе, сен мені қамап қоямын деп ойлама.
Dialogue: 0,0:22:24.63,0:22:26.47,Default,,0,0,0,,(Яйба дыбысы)
Dialogue: 0,0:22:26.55,0:22:29.47,Default,,0,0,0,,Сіз ауыр жарақат алуға дайынсыз ба?
Dialogue: 0,0:22:34.18,0:22:35.06,Default,,0,0,0,,Не?
Dialogue: 0,0:22:35.14,0:22:38.52,Default,,0,0,0,,Бұл... Мен сенің сиқырыңды күтпедім...
Dialogue: 0,0:22:39.10,0:22:41.06,Default,,0,0,0,,Өзімді жоғалтып алған сияқтымын.
Dialogue: 0,0:22:42.73,0:22:46.32,Default,,0,0,0,,Көрдім, емші сиқыршы?
Dialogue: 0,0:22:46.94,0:22:48.82,Default,,0,0,0,,Таза физикалық қабілеттілік және
Dialogue: 0,0:22:48.90,0:22:53.53,Default,,0,0,0,,Емдеу жылдамдығының арқасында бір нысананы жеңу мүмкіндігі
Dialogue: 0,0:22:53.62,0:22:56.70,Default,,0,0,0,,Хаха не деген
Dialogue: 0,0:23:02.25,0:23:04.92,Default,,0,0,0,,Менің атым Нерон Аргенс
Dialogue: 0,0:23:05.00,0:23:06.63,Default,,0,0,0,,Мен сенен де атыңды сұрайын.
Dialogue: 0,0:23:07.59,0:23:08.80,Default,,0,0,0,,Бұл Роза.
Dialogue: 0,0:23:08.88,0:23:11.47,Default,,0,0,0,,Түсіндім, Роза.
Dialogue: 0,0:23:16.72,0:23:19.98,Default,,0,0,0,,Мен сені осында өлтіремін.
Dialogue: 0,0:23:21.14,0:23:24.94,Default,,0,0,0,,Оған дейін мен Темиге жұдырықтаймын.
Dialogue: 0,0:23:32.32,0:23:34.03,Default,,0,0,0,,Ахх!
Dialogue: 0,0:23:34.12,0:23:35.99,Default,,0,0,0,,Качан мықты.
Dialogue: 0,0:23:37.49,0:23:43.49,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory