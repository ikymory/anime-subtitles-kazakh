Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.01,0:00:13.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.01,0:01:39.01,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.52,0:01:47.60,Default,,0,0,0,,Жапонияның ең үлкен жабық спорт кешені Tokyo Dome
Dialogue: 0,0:01:49.81,0:01:54.48,Default,,0,0,0,,Жердің тереңінде бұл нысан жасырын түрде бар дейді.
Dialogue: 0,0:01:56.44,0:01:59.61,Default,,0,0,0,,Токио Доум Коракуэн жерасты аренасы
Dialogue: 0,0:02:00.45,0:02:01.20,Default,,0,0,0,,Жарыс қаншада басталады?
Dialogue: 0,0:02:01.20,0:02:02.16,Default,,0,0,0,,Жарыс қаншада басталады?
Dialogue: 0,0:02:01.20,0:02:02.16,Default,,0,0,0,,«Гран-при»
Dialogue: 0,0:02:02.16,0:02:02.24,Default,,0,0,0,,«Гран-при»
Dialogue: 0,0:02:02.24,0:02:03.54,Default,,0,0,0,,«Гран-при»
Dialogue: 0,0:02:02.24,0:02:03.54,Default,,0,0,0,,Өткенде бірнеше рет жер шарында болған жекпе-жек өнерінің өрлеуі
Dialogue: 0,0:02:03.54,0:02:06.45,Default,,0,0,0,,Өткенде жер бетінде бірнеше рет болған жекпе-жек өнерінің өрлеуі
Dialogue: 0,0:02:08.25,0:02:11.50,Default,,0,0,0,,Толқыны мен ағынына қарамастан
Dialogue: 0,0:02:12.09,0:02:14.84,Default,,0,0,0,,Бұл орын әрқашан толып тұрады.
Dialogue: 0,0:02:14.92,0:02:20.51,Default,,0,0,0,,Өйткені мұнда шақырылған таңдалған мүшелер сенеді
Dialogue: 0,0:02:21.47,0:02:24.51,Default,,0,0,0,,Бұл жердегі ең күштілерді көруге болатын жер
Dialogue: 0,0:02:26.85,0:02:29.52,Default,,0,0,0,,Бұл жерден түсінікті.
Dialogue: 0,0:02:30.31,0:02:32.94,Default,,0,0,0,,Әдеттегідей ыстық
Dialogue: 0,0:02:35.48,0:02:37.28,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:02:38.11,0:02:40.91,Default,,0,0,0,,Сенгоку кезеңі VS (қарсы) динозаврлар дәуірі
Dialogue: 0,0:02:42.78,0:02:46.74,Default,,0,0,0,,Бұл жердегі ең күштілерді көруге болатын жер
Dialogue: 0,0:02:49.50,0:02:50.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:51.04,0:02:53.92,Default,,0,0,0,,Не! Не, не…
Dialogue: 0,0:02:56.05,0:02:57.42,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:02:58.51,0:03:01.30,Default,,0,0,0,,Бір қарағанда атмосфера танылады.
Dialogue: 0,0:03:01.89,0:03:04.85,Default,,0,0,0,,Бір қарағанда байқалатын қолдың салбырап қалу сезімі
Dialogue: 0,0:03:06.60,0:03:08.43,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:03:09.23,0:03:11.44,Default,,0,0,0,,Қызығушылықтан емес
Dialogue: 0,0:03:12.02,0:03:14.44,Default,,0,0,0,,Қызығушылық емес
Dialogue: 0,0:03:14.52,0:03:16.61,Default,,0,0,0,,Оны көру үшін
Dialogue: 0,0:03:16.69,0:03:18.44,Default,,0,0,0,,Қан мен терге көмілген
Dialogue: 0,0:03:19.40,0:03:24.45,Default,,0,0,0,,Таңдаған өмір жолынан табиғи түрде туындайтын міндет.
Dialogue: 0,0:03:25.53,0:03:28.12,Default,,0,0,0,,Менің көргім келгені – шайқас
Dialogue: 0,0:03:28.20,0:03:30.46,Default,,0,0,0,,Көпшілік алдында жазалау емес
Dialogue: 0,0:03:30.54,0:03:33.46,Default,,0,0,0,,Менің көргім келетіні – шайқас.
Dialogue: 0,0:03:33.54,0:03:35.46,Default,,0,0,0,,Сою шоуы емес
Dialogue: 0,0:03:40.13,0:03:42.97,Default,,0,0,0,,Берілмеңіздер, бәріңіз!
Dialogue: 0,0:03:43.05,0:03:43.97,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:46.01,0:03:48.97,Default,,0,0,0,,Тиранозаврдың табиғи жауы...
Dialogue: 0,0:03:49.06,0:03:50.31,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:03:57.07,0:03:58.57,Default,,0,0,0,,(Пиклдің айқайы)
Dialogue: 0,0:03:58.65,0:04:01.49,Default,,0,0,0,,Кесілген доп па?
Dialogue: 0,0:04:03.49,0:04:04.24,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:04:06.28,0:04:08.24,Default,,0,0,0,,Ал... тоқтады ма?
Dialogue: 0,0:04:08.83,0:04:11.00,Default,,0,0,0,,Мұсашидің қылышы тоқтады ма?
Dialogue: 0,0:04:11.08,0:04:12.75,Default,,0,0,0,,Күш керемет!
Dialogue: 0,0:04:12.83,0:04:13.75,Default,,0,0,0,,Не!
Dialogue: 0,0:04:16.17,0:04:17.75,Default,,0,0,0,,Ашулы бет сызықтары және
Dialogue: 0,0:04:17.84,0:04:19.75,Default,,0,0,0,,Қарапайым дене бұлшықеттерімен
Dialogue: 0,0:04:20.34,0:04:22.26,Default,,0,0,0,,Мусашидің жүзі тоқтатылды!
Dialogue: 0,0:04:29.22,0:04:30.27,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:04:30.35,0:04:33.77,Default,,0,0,0,,Apparenari! ет сарайы
Dialogue: 0,0:04:34.60,0:04:36.02,Default,,0,0,0,,(Пиклдің айқайы)
Dialogue: 0,0:04:37.36,0:04:38.27,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:39.86,0:04:41.78,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:04:46.36,0:04:48.32,Default,,0,0,0,,Кеке...ке...
Dialogue: 0,0:04:48.83,0:04:50.29,Default,,0,0,0,,Кери?
Dialogue: 0,0:04:50.95,0:04:52.79,Default,,0,0,0,,(Аруған тұздығы)
Dialogue: 0,0:04:58.63,0:04:59.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:03.88,0:05:06.05,Default,,0,0,0,,Жынға арналған алтын таяқ?
Dialogue: 0,0:05:06.13,0:05:08.55,Default,,0,0,0,,Пикльде қылыш бар!
Dialogue: 0,0:05:08.64,0:05:12.06,Default,,0,0,0,,Шайқаңыз ба? Осындай күші бар қылыш
Dialogue: 0,0:05:16.14,0:05:17.06,Default,,0,0,0,,Ішек
Dialogue: 0,0:05:31.95,0:05:32.79,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:33.83,0:05:34.75,Default,,0,0,0,,Ах
Dialogue: 0,0:05:34.83,0:05:37.00,Default,,0,0,0,,Мен қылышты көрмеймін!
Dialogue: 0,0:05:38.46,0:05:41.00,Default,,0,0,0,,-(1-көрермен) Жерде... -(2-көрермен) Сен оны пышақтап алдың ба?
Dialogue: 0,0:05:41.96,0:05:43.25,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:43.34,0:05:44.51,Default,,0,0,0,,Ол енді менің апам болмайды!
Dialogue: 0,0:05:45.80,0:05:49.59,Default,,0,0,0,,Мен кестім, тігінен кесемін!
Dialogue: 0,0:05:50.76,0:05:52.26,Default,,0,0,0,,Қаттылық
Dialogue: 0,0:05:52.35,0:05:53.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:56.35,0:05:58.77,Default,,0,0,0,,- (3-аудитория мүшесі) Орныңыздан тұрыңыз! - (4-аудитория) Қашан?
Dialogue: 0,0:05:58.85,0:06:02.23,Default,,0,0,0,,Пышақты тоқтата алатын ет храмы.
Dialogue: 0,0:06:02.32,0:06:04.32,Default,,0,0,0,,Мен оны бірінші рет көріп тұрмын.
Dialogue: 0,0:06:06.32,0:06:08.78,Default,,0,0,0,,Менің қылышым дулығаны екіге бөледі
Dialogue: 0,0:06:09.78,0:06:13.28,Default,,0,0,0,,Сүйектермен тоқтайды Бұлшықеттермен тоқтайды
Dialogue: 0,0:06:13.37,0:06:15.79,Default,,0,0,0,,Осындай денелер бар.
Dialogue: 0,0:06:16.45,0:06:18.83,Default,,0,0,0,,Қолымнан қылыш кетті.
Dialogue: 0,0:06:18.92,0:06:21.88,Default,,0,0,0,,Бұл соншалық, мен оны байқамай қалдым.
Dialogue: 0,0:06:22.38,0:06:27.05,Default,,0,0,0,,Мен құлап, күттім, бірақ келесі қадам болмады.
Dialogue: 0,0:06:28.09,0:06:30.05,Default,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:06:30.64,0:06:33.05,Default,,0,0,0,,Пикл қылышшы болды
Dialogue: 0,0:06:35.14,0:06:36.56,Default,,0,0,0,,Жалықтырғыш
Dialogue: 0,0:06:40.90,0:06:42.81,Default,,0,0,0,,Қысым жойылды.
Dialogue: 0,0:06:43.61,0:06:45.69,Default,,0,0,0,,Бірде автор
Dialogue: 0,0:06:45.78,0:06:49.45,Default,,0,0,0,,Бұл атақты каратэшіден сұхбат алған кездегі эпизод.
Dialogue: 0,0:06:50.53,0:06:53.45,Default,,0,0,0,,Мен таң қалдыратын сөздерді естідім.
Dialogue: 0,0:06:54.74,0:06:58.45,Default,,0,0,0,,Пышақ ұстаған адам қауіпті емес
Dialogue: 0,0:07:00.00,0:07:02.46,Default,,0,0,0,,Өйткені мен тек пышақ қолданамын
Dialogue: 0,0:07:04.17,0:07:07.17,Default,,0,0,0,,Бұл өте әсерлі мәлімдеме болды.
Dialogue: 0,0:07:08.84,0:07:10.01,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:11.34,0:07:12.26,Default,,0,0,0,,(Үш адамның ентігу дыбысы)
Dialogue: 0,0:07:12.34,0:07:14.76,Default,,0,0,0,,.
Dialogue: 0,0:07:14.85,0:07:17.10,Default,,0,0,0,,Шыу!
Dialogue: 0,0:07:19.27,0:07:21.02,Default,,0,0,0,,Бұл тән ғибадатханасы болғанымен...
Dialogue: 0,0:07:21.60,0:07:23.02,Default,,0,0,0,,(Тұздалған ыңқыл)
Dialogue: 0,0:07:25.02,0:07:27.28,Default,,0,0,0,,Қалағаныңызша кесуге болады...
Dialogue: 0,0:07:27.36,0:07:28.90,Default,,0,0,0,,(Пиклдің айқайы)
Dialogue: 0,0:07:28.99,0:07:30.28,Default,,0,0,0,,Мүйізді ұстаңыз
Dialogue: 0,0:07:32.45,0:07:33.28,Default,,0,0,0,,Гррр…
Dialogue: 0,0:07:37.37,0:07:38.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:39.37,0:07:42.04,Default,,0,0,0,,Сен мүйізді ұрладың ба?
Dialogue: 0,0:07:43.17,0:07:44.29,Default,,0,0,0,,Екі шынтақ және
Dialogue: 0,0:07:44.96,0:07:46.29,Default,,0,0,0,,Екі иық
Dialogue: 0,0:07:46.96,0:07:50.55,Default,,0,0,0,,Оның үстіне екі тізесін де ұрлады!
Dialogue: 0,0:07:51.30,0:07:52.68,Default,,0,0,0,,Саусақ ұстағыш
Dialogue: 0,0:07:53.26,0:07:54.68,Default,,0,0,0,,Аяқтың кесілгенімен бірдей
Dialogue: 0,0:07:55.51,0:07:58.18,Default,,0,0,0,,Қазіргі кендода жоқ әдістер
Dialogue: 0,0:07:59.10,0:08:01.06,Default,,0,0,0,,Шынай деген таяқ емес
Dialogue: 0,0:08:01.89,0:08:05.19,Default,,0,0,0,,Пышақтарға негізделгендіктен дәл бар техникалар
Dialogue: 0,0:08:06.27,0:08:08.23,Default,,0,0,0,,Бұл қылыш шеберлігі
Dialogue: 0,0:08:09.28,0:08:10.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:10.82,0:08:13.20,Default,,0,0,0,,Бұл қылыш шеберлігі
Dialogue: 0,0:08:14.36,0:08:16.20,Default,,0,0,0,,Біз каратэмен айналысамыз
Dialogue: 0,0:08:16.28,0:08:20.33,Default,,0,0,0,,Өзіңіздің қаруға қарсы дағдыларыңызды көпшілік алдында көрсеткен кездегі ұнайды.
Dialogue: 0,0:08:20.95,0:08:22.08,Default,,0,0,0,,Қарапайым
Dialogue: 0,0:08:22.96,0:08:24.33,Default,,0,0,0,,Түсінуге оңай
Dialogue: 0,0:08:25.12,0:08:28.84,Default,,0,0,0,,Сәйкес қылыш жоқ.
Dialogue: 0,0:08:29.46,0:08:30.96,Default,,0,0,0,,әдепсіз
Dialogue: 0,0:08:31.05,0:08:32.97,Default,,0,0,0,,әдепсіз
Dialogue: 0,0:08:33.55,0:08:37.47,Default,,0,0,0,,Денесі немесе жабыны жоқ әдіс ретінде оны ашық түрде қолданыңыз
Dialogue: 0,0:08:38.05,0:08:42.48,Default,,0,0,0,,Бұл монофониялық қылыш шеберлігі.
Dialogue: 0,0:08:45.56,0:08:47.48,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:48.06,0:08:49.48,Default,,0,0,0,,бағытталған бұрыш
Dialogue: 0,0:08:49.57,0:08:52.99,Default,,0,0,0,,Мен бәрін кесіп тастауым керек еді...
Dialogue: 0,0:08:53.07,0:08:55.49,Default,,0,0,0,,Тек терең шабуыл жасады
Dialogue: 0,0:08:58.07,0:09:02.25,Default,,0,0,0,,Қан тоқтамады, мен білмей жатып, есін жидым.
Dialogue: 0,0:09:02.75,0:09:04.58,Default,,0,0,0,,Мұсашидің жеңісі
Dialogue: 0,0:09:05.58,0:09:06.79,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:07.29,0:09:09.50,Default,,0,0,0,,Бұл шіркін.
Dialogue: 0,0:09:10.71,0:09:12.34,Default,,0,0,0,,Күтілгендей, мұнда...
Dialogue: 0,0:09:13.34,0:09:14.76,Default,,0,0,0,,Сол немесе оң?
Dialogue: 0,0:09:14.84,0:09:16.26,Default,,0,0,0,,Жоғарғы немесе төменгі?
Dialogue: 0,0:09:16.34,0:09:17.76,Default,,0,0,0,,айналасында?
Dialogue: 0,0:09:18.43,0:09:20.76,Default,,0,0,0,,Гүлді екіге бөлу
Dialogue: 0,0:09:22.60,0:09:24.68,Default,,0,0,0,,Бұлай айту маған біртүрлі, бірақ
Dialogue: 0,0:09:25.18,0:09:26.77,Default,,0,0,0,,Сіз мұны түсінесіз деп үміттенемін
Dialogue: 0,0:09:27.98,0:09:30.77,Default,,0,0,0,,Гүлдің алғашқы денесі!
Dialogue: 0,0:09:30.86,0:09:32.78,Default,,0,0,0,,табу
Dialogue: 0,0:09:33.90,0:09:35.65,Default,,0,0,0,,Болат етінің храмы
Dialogue: 0,0:09:36.28,0:09:38.41,Default,,0,0,0,,Жұмсақ тофу терісіне арналған
Dialogue: 0,0:09:46.00,0:09:48.42,Default,,0,0,0,,Келіңіз, тұздалған қияр жеңіз
Dialogue: 0,0:09:50.25,0:09:53.17,Default,,0,0,0,,Мына Мұсашыны тойғанша же.
Dialogue: 0,0:09:53.25,0:09:54.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:57.38,0:10:00.18,Default,,0,0,0,,Біздің уақытымыз жоқ. Асықшы!
Dialogue: 0,0:10:02.10,0:10:03.76,Default,,0,0,0,,Тән ғибадатханасы
Dialogue: 0,0:10:04.27,0:10:07.18,Default,,0,0,0,,Максималды нәтижеге қол жеткізуге тырысу -
Dialogue: 0,0:10:07.77,0:10:08.94,Default,,0,0,0,,Сецуна —
Dialogue: 0,0:10:09.77,0:10:10.94,Default,,0,0,0,,Бірден бұрын-
Dialogue: 0,0:10:11.69,0:10:16.19,Default,,0,0,0,,Ет болат алдында тофуға айналады
Dialogue: 0,0:10:17.19,0:10:19.32,Default,,0,0,0,,Лақтыру сәті
Dialogue: 0,0:10:20.16,0:10:22.33,Default,,0,0,0,,Секіру сәті
Dialogue: 0,0:10:23.12,0:10:25.33,Default,,0,0,0,,Соққы сәті
Dialogue: 0,0:10:26.16,0:10:28.41,Default,,0,0,0,,Бұлшықеттер ең жұмсақ болады
Dialogue: 0,0:10:29.50,0:10:32.92,Default,,0,0,0,,Ең жұмсақ ең қаттының алдында
Dialogue: 0,0:10:33.96,0:10:35.09,Default,,0,0,0,,Ол күтпеген жерден сол жақ қорғаныстан тік соққымен жауап қайтарды
Dialogue: 0,0:10:49.69,0:10:51.10,Default,,0,0,0,,Орындалды.
Dialogue: 0,0:10:51.19,0:10:52.61,Default,,0,0,0,,Жеткілікті
Dialogue: 0,0:10:53.19,0:10:55.61,Default,,0,0,0,,Жарайсың, Рёю.
Dialogue: 0,0:10:55.69,0:10:57.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:57.65,0:10:59.61,Default,,0,0,0,,- (Кодзи Момижи) Токугава мырза - (Мицунари) Иә?
Dialogue: 0,0:10:59.70,0:11:01.11,Default,,0,0,0,,Күзгі жапырақтар
Dialogue: 0,0:11:01.24,0:11:03.62,Default,,0,0,0,,Бұл ойын, Токугава мырза.
Dialogue: 0,0:11:04.41,0:11:05.87,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:11:06.66,0:11:07.91,Default,,0,0,0,,Күзгі жапырақтар
Dialogue: 0,0:11:08.41,0:11:12.21,Default,,0,0,0,,Шешімді тек екі тарап қабылдайды
Dialogue: 0,0:11:12.29,0:11:16.92,Default,,0,0,0,,Біз оны мәселе шешілгеннен кейін ғана жариялаймыз.
Dialogue: 0,0:11:17.42,0:11:19.55,Default,,0,0,0,,Ережелер...
Dialogue: 0,0:11:19.63,0:11:20.84,Default,,0,0,0,,Ой
Dialogue: 0,0:11:21.47,0:11:22.64,Default,,0,0,0,,О
Dialogue: 0,0:11:25.22,0:11:26.89,Default,,0,0,0,,Мен оны жедім.
Dialogue: 0,0:11:28.02,0:11:29.39,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:11:29.48,0:11:34.40,Default,,0,0,0,,Мм... Аа... Әрине.
Dialogue: 0,0:11:34.48,0:11:36.90,Default,,0,0,0,,Директор Катцуми: Бұл мен жеген тұздалған қияр.
Dialogue: 0,0:11:37.94,0:11:41.15,Default,,0,0,0,,Жақсы ма? мен
Dialogue: 0,0:11:41.74,0:11:43.86,Default,,0,0,0,,Қанды қолдар
Dialogue: 0,0:11:43.95,0:11:46.41,Default,,0,0,0,,Әлі де дәмді
Dialogue: 0,0:11:46.99,0:11:49.16,Default,,0,0,0,,Мен өзімді жаман сезінбеймін
Dialogue: 0,0:11:49.25,0:11:51.62,Default,,0,0,0,,Бұлшық еттердің көзін оқу
Dialogue: 0,0:11:51.71,0:11:53.83,Default,,0,0,0,,Мен тынысымның көзін оқи аламын
Dialogue: 0,0:11:53.92,0:11:56.50,Default,,0,0,0,,Гүлді екіге бөледі
Dialogue: 0,0:11:57.00,0:11:58.13,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:58.21,0:11:59.55,Default,,0,0,0,,Шен-шегіне көтеріле алмайтын қылышкерлердің қара қылыштары болады делінеді.
Dialogue: 0,0:11:59.63,0:12:01.42,Default,,0,0,0,,Қанға боялған күйде тамақ ішу
Dialogue: 0,0:12:02.55,0:12:04.51,Default,,0,0,0,,Күтілгендей, мұнда...
Dialogue: 0,0:12:05.51,0:12:06.43,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:07.51,0:12:08.93,Default,,0,0,0,,Мойын...
Dialogue: 0,0:12:09.77,0:12:10.93,Default,,0,0,0,,Хехе...
Dialogue: 0,0:12:11.02,0:12:13.06,Default,,0,0,0,,Сәлем Пикл
Dialogue: 0,0:12:13.14,0:12:16.77,Default,,0,0,0,,Бұл ет пен қан ғана емес, солай ма?
Dialogue: 0,0:12:18.77,0:12:20.19,Default,,0,0,0,,Бұл бас.
Dialogue: 0,0:12:22.19,0:12:24.20,Default,,0,0,0,,Осы жерден тамақтаныңыз
Dialogue: 0,0:12:27.07,0:12:29.95,Default,,0,0,0,,Мен сөздерді түсінбеймін, бірақ—
Dialogue: 0,0:12:30.54,0:12:30.83,Default,,0,0,0,,Біз байланысамыз
Dialogue: 0,0:12:30.83,0:12:32.20,Default,,0,0,0,,Біз қарым-қатынас жасаймыз
Dialogue: 0,0:12:30.83,0:12:32.20,Default,,0,0,0,,(төмен дауыс)
Dialogue: 0,0:12:32.20,0:12:32.79,Default,,0,0,0,,(төмен дауыс)
Dialogue: 0,0:12:32.79,0:12:34.21,Default,,0,0,0,,(төмен дауыс)
Dialogue: 0,0:12:32.79,0:12:34.21,Default,,0,0,0,,Менсіну
Dialogue: 0,0:12:34.21,0:12:34.33,Default,,0,0,0,,Менсіну
Dialogue: 0,0:12:43.80,0:12:46.22,Default,,0,0,0,,Иә? о?
Dialogue: 0,0:12:47.09,0:12:48.89,Default,,0,0,0,,Қорытынды нысан
Dialogue: 0,0:12:49.81,0:12:50.81,Default,,0,0,0,,Уақытында болыңыз!
Dialogue: 0,0:12:51.93,0:12:53.23,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:12:55.31,0:12:56.69,Default,,0,0,0,,Адам?
Dialogue: 0,0:13:01.82,0:13:04.45,Default,,0,0,0,,Қауіп деген не?
Dialogue: 0,0:13:04.53,0:13:08.16,Default,,0,0,0,,Бізге қауіп төндіретін қауіп
Dialogue: 0,0:13:08.24,0:13:11.16,Default,,0,0,0,,Бұлай ойлау қате емес.
Dialogue: 0,0:13:11.83,0:13:13.33,Default,,0,0,0,,Біздің денеміз
Dialogue: 0,0:13:13.41,0:13:15.12,Default,,0,0,0,,Біздің рухымыз
Dialogue: 0,0:13:15.21,0:13:19.17,Default,,0,0,0,,немесе екеуіне де қауіп төндіретін кез келген нәрсе қауіпті.
Dialogue: 0,0:13:19.75,0:13:24.17,Default,,0,0,0,,Сонымен қауіпті жер дегеніміз не?
Dialogue: 0,0:13:24.92,0:13:27.26,Default,,0,0,0,,Денеге келетін болсақ,
Dialogue: 0,0:13:27.34,0:13:29.18,Default,,0,0,0,,Мысалы, тайфун
Dialogue: 0,0:13:30.14,0:13:33.77,Default,,0,0,0,,Толқындары жоғары пирс жеткілікті қауіпті.
Dialogue: 0,0:13:33.85,0:13:35.68,Default,,0,0,0,,Барма
Dialogue: 0,0:13:36.27,0:13:38.19,Default,,0,0,0,,мысалы. жанартау
Dialogue: 0,0:13:38.77,0:13:41.27,Default,,0,0,0,,Белсенді кратер
Dialogue: 0,0:13:41.36,0:13:43.28,Default,,0,0,0,,Лава қайнап жатыр
Dialogue: 0,0:13:43.36,0:13:45.69,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:13:48.07,0:13:49.70,Default,,0,0,0,,Адамдар жиі
Dialogue: 0,0:13:49.78,0:13:52.70,Default,,0,0,0,,Осы қауіптерден кім аман қалды
Dialogue: 0,0:13:52.79,0:13:55.20,Default,,0,0,0,,Батыр деп санауға болады
Dialogue: 0,0:13:55.29,0:13:57.21,Default,,0,0,0,,...
Dialogue: 0,0:13:57.29,0:14:00.13,Default,,0,0,0,,Мен де бұл адамды білемін.
Dialogue: 0,0:14:00.21,0:14:03.71,Default,,0,0,0,,Мүмкін сіз оны батыр дейтін шығарсыз.
Dialogue: 0,0:14:04.55,0:14:07.55,Default,,0,0,0,,Өйткені ол қашып кетті
Dialogue: 0,0:14:07.63,0:14:11.72,Default,,0,0,0,,Бұл қауіпті жер болғандықтан.
Dialogue: 0,0:14:13.06,0:14:16.23,Default,,0,0,0,,Тиранозавр рекстің аузының ішінде
Dialogue: 0,0:14:16.31,0:14:17.27,Default,,0,0,0,,(Аруған тұздығы)
Dialogue: 0,0:14:17.35,0:14:19.23,Default,,0,0,0,,Өткір тістер
Dialogue: 0,0:14:20.23,0:14:23.23,Default,,0,0,0,,Үлкен тістеу күші
Dialogue: 0,0:14:28.53,0:14:30.91,Default,,0,0,0,,Барма
Dialogue: 0,0:14:30.99,0:14:33.91,Default,,0,0,0,,(түтіксіз буын дыбыстары)
Dialogue: 0,0:14:34.70,0:14:37.25,Default,,0,0,0,,О... О!
Dialogue: 0,0:14:37.75,0:14:40.92,Default,,0,0,0,,Түсіндім, бұл адам емес.
Dialogue: 0,0:14:41.00,0:14:42.38,Default,,0,0,0,,Дене пішіні...
Dialogue: 0,0:14:42.46,0:14:43.67,Default,,0,0,0,,Өзгертілді
Dialogue: 0,0:14:43.75,0:14:45.17,Default,,0,0,0,,Ах, жарай берсін—
Dialogue: 0,0:14:45.25,0:14:46.42,Default,,0,0,0,,Есірткі?
Dialogue: 0,0:14:46.51,0:14:48.42,Default,,0,0,0,,Қорытынды нысан…
Dialogue: 0,0:14:48.51,0:14:50.18,Default,,0,0,0,,1-аудио үзінді Хигучидің көлігінің ішінен; 2-ші үзінді Сакура TV-ден, өтінемін.
Dialogue: 0,0:14:50.76,0:14:53.18,Default,,0,0,0,,(Пиклдің ақырын дауысы)
Dialogue: 0,0:14:55.01,0:14:57.93,Default,,0,0,0,,Тіпті ниндзя да әзірге құбыжық
Dialogue: 0,0:14:58.02,0:14:59.18,Default,,0,0,0,,Мононоке?
Dialogue: 0,0:15:01.69,0:15:04.19,Default,,0,0,0,,Маған бәрібір, жүр.
Dialogue: 0,0:15:08.11,0:15:10.20,Default,,0,0,0,,Ұлы маймыл Хидадан бері?
Dialogue: 0,0:15:11.28,0:15:13.45,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:15:20.00,0:15:21.00,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:22.67,0:15:25.00,Default,,0,0,0,,Ет қаттырақ болады
Dialogue: 0,0:15:25.59,0:15:28.51,Default,,0,0,0,,Ағып жатқан қанды да тоқтатуға болады
Dialogue: 0,0:15:30.63,0:15:32.51,Default,,0,0,0,,Мононокеден күткендей
Dialogue: 0,0:15:33.30,0:15:34.76,Default,,0,0,0,,Қалағаныңызша кесіңіз
Dialogue: 0,0:15:36.47,0:15:38.93,Default,,0,0,0,,Мен кескенді қатты жақсы көремін
Dialogue: 0,0:15:39.02,0:15:41.27,Default,,0,0,0,,Сіз қиюға мүмкіндік алған кезде
Dialogue: 0,0:15:42.19,0:15:44.56,Default,,0,0,0,,Мен қажетінен артық кесіп алдым.
Dialogue: 0,0:15:45.15,0:15:46.82,Default,,0,0,0,,Бұл жаман әдет.
Dialogue: 0,0:15:48.03,0:15:52.32,Default,,0,0,0,,Шындығында, бұл қажет емес. Бір қылыш жеткілікті.
Dialogue: 0,0:15:52.91,0:15:55.03,Default,,0,0,0,,Мен бұл мүмкіндікті жіберіп алғым келмейді
Dialogue: 0,0:15:55.12,0:15:57.58,Default,,0,0,0,,Мен көп кесіп тастаймын.
Dialogue: 0,0:15:58.74,0:16:00.70,Default,,0,0,0,,Бұрынғы кездесу
Dialogue: 0,0:16:00.79,0:16:04.71,Default,,0,0,0,,Қылыш астында, иіліп тұрған адам туралы ойладым.
Dialogue: 0,0:16:05.42,0:16:08.21,Default,,0,0,0,,«О... тұр!»
Dialogue: 0,0:16:09.25,0:16:11.84,Default,,0,0,0,,«Менімен тағы кездесіңізші»
Dialogue: 0,0:16:13.84,0:16:16.72,Default,,0,0,0,,Кессем де, Кесем де
Dialogue: 0,0:16:16.80,0:16:20.22,Default,,0,0,0,,Бермейтін дене жоқ па?
Dialogue: 0,0:16:23.98,0:16:26.56,Default,,0,0,0,,Кессем де, Кесем де
Dialogue: 0,0:16:27.15,0:16:31.07,Default,,0,0,0,,10 рет кессең де құламайтын дене бар ма?
Dialogue: 0,0:16:34.45,0:16:37.57,Default,,0,0,0,,Бұл дүние кең әрі терең.
Dialogue: 0,0:16:39.54,0:16:42.50,Default,,0,0,0,,Осылайша итчитачи
Dialogue: 0,0:16:42.58,0:16:43.91,Default,,0,0,0,,Екінші қылыш
Dialogue: 0,0:16:44.00,0:16:45.42,Default,,0,0,0,,Сан-но Тачи
Dialogue: 0,0:16:45.50,0:16:46.83,Default,,0,0,0,,Төрт ұзын қылыш
Dialogue: 0,0:16:46.92,0:16:48.29,Default,,0,0,0,,Бес ұзын қылыш
Dialogue: 0,0:16:48.38,0:16:50.25,Default,,0,0,0,,Року но Тачи
Dialogue: 0,0:16:50.84,0:16:53.67,Default,,0,0,0,,Мен сені қанша рет кесуге рұқсат бересің?
Dialogue: 0,0:16:54.68,0:16:57.59,Default,,0,0,0,,Маған қанша жерден кесуге рұқсат бересіз?
Dialogue: 0,0:17:00.85,0:17:04.60,Default,,0,0,0,,Осы кезде Пиклдің ойына не келді
Dialogue: 0,0:17:04.69,0:17:06.27,Default,,0,0,0,,(Динозаврдың үруі)
Dialogue: 0,0:17:06.35,0:17:07.60,Default,,0,0,0,,Бұл сезім
Dialogue: 0,0:17:08.48,0:17:11.61,Default,,0,0,0,,Бұл сезім басқаларға ұқсамайды
Dialogue: 0,0:17:12.40,0:17:15.61,Default,,0,0,0,,Бұл сезім ешкімге ұқсамайды
Dialogue: 0,0:17:17.78,0:17:19.12,Default,,0,0,0,,Нашар
Dialogue: 0,0:17:19.20,0:17:20.62,Default,,0,0,0,,Жылдам
Dialogue: 0,0:17:20.70,0:17:22.20,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:17:22.70,0:17:23.75,Default,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,0:17:24.75,0:17:25.62,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:17:27.25,0:17:30.13,Default,,0,0,0,,Мынау... мына жігіт!
Dialogue: 0,0:17:31.50,0:17:35.51,Default,,0,0,0,,Бірде абайсызда аузыма лақтырып жібердім.
Dialogue: 0,0:17:36.34,0:17:39.01,Default,,0,0,0,,Ауыз жарылып кетті
Dialogue: 0,0:17:41.18,0:17:45.02,Default,,0,0,0,,Ол өзі, түрін өзгерткен ол.
Dialogue: 0,0:17:45.60,0:17:47.27,Default,,0,0,0,,Екі қолға қару
Dialogue: 0,0:17:48.60,0:17:49.69,Default,,0,0,0,,Сонымен қатар
Dialogue: 0,0:17:50.19,0:17:54.28,Default,,0,0,0,,Мен тіпті денемнен өту үшін оның техникасын қолданамын.
Dialogue: 0,0:18:03.16,0:18:05.33,Default,,0,0,0,,Менің енді тамақ жегім келмейді
Dialogue: 0,0:18:06.33,0:18:10.25,Default,,0,0,0,,Кесілген, ойылған, Күресуге еріксіз
Dialogue: 0,0:18:10.33,0:18:11.96,Default,,0,0,0,,Тәбет жоқ
Dialogue: 0,0:18:12.04,0:18:13.38,Default,,0,0,0,,Жетеді
Dialogue: 0,0:18:13.88,0:18:14.80,Default,,0,0,0,,Мұнда
Dialogue: 0,0:18:15.88,0:18:17.30,Default,,0,0,0,,Не?
Dialogue: 0,0:18:19.05,0:18:21.55,Default,,0,0,0,,Енді тамақ ішудің қажеті жоқ
Dialogue: 0,0:18:21.64,0:18:23.81,Default,,0,0,0,,Менің енді тамақ жегім келмейді
Dialogue: 0,0:18:23.89,0:18:25.81,Default,,0,0,0,,Төтенше жағдайда эвакуациялау?
Dialogue: 0,0:18:27.98,0:18:29.06,Default,,0,0,0,,Тұздалған қияр
Dialogue: 0,0:18:30.35,0:18:32.56,Default,,0,0,0,,Осы кезеңде қайда барасыз?
Dialogue: 0,0:18:34.65,0:18:36.57,Default,,0,0,0,,Бәрі бітті!
Dialogue: 0,0:18:43.16,0:18:44.58,Default,,0,0,0,,Үйге баруым керек пе?
Dialogue: 0,0:18:47.66,0:18:49.58,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:18:57.42,0:18:59.09,Default,,0,0,0,,Хо
Dialogue: 0,0:18:59.17,0:19:02.09,Default,,0,0,0,,Жау алдында сенімді дірілдейсің бе?
Dialogue: 0,0:19:02.89,0:19:06.85,Default,,0,0,0,,Дірілдеп, қозғала алмай жатқан адамды кескім келмейді.
Dialogue: 0,0:19:13.69,0:19:15.11,Default,,0,0,0,,(қатты айқай)
Dialogue: 0,0:19:15.19,0:19:16.11,Default,,0,0,0,,- (Баки) А? -(Мицунари) Ах!
Dialogue: 0,0:19:20.95,0:19:23.45,Default,,0,0,0,,Дауысыңызды көтеруден қорықпаңыз
Dialogue: 0,0:19:23.53,0:19:25.87,Default,,0,0,0,,Қашып кетсең, төрт аяғың бар ма?
Dialogue: 0,0:19:26.91,0:19:30.37,Default,,0,0,0,,Мм, керемет жабайылық.
Dialogue: 0,0:19:30.46,0:19:31.62,Default,,0,0,0,,қашып кетті
Dialogue: 0,0:19:31.71,0:19:33.13,Default,,0,0,0,,Нүкенуке...
Dialogue: 0,0:19:33.21,0:19:34.38,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:19:34.46,0:19:37.59,Default,,0,0,0,,Жоқ...емдеу жоқ.
Dialogue: 0,0:19:37.67,0:19:38.88,Default,,0,0,0,,Тұздалған қияр
Dialogue: 0,0:19:40.09,0:19:41.63,Default,,0,0,0,,Қайда?
Dialogue: 0,0:19:42.97,0:19:44.89,Default,,0,0,0,,(Пиклдің дірілдеген тынысы)
Dialogue: 0,0:19:49.10,0:19:50.89,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:19:51.60,0:19:54.65,Default,,0,0,0,,Тезірек қашып кетсем жақсы болар еді.
Dialogue: 0,0:19:56.73,0:19:59.03,Default,,0,0,0,,Мононоке болса да
Dialogue: 0,0:19:59.11,0:20:01.40,Default,,0,0,0,,Бұл нәрсе емес.
Dialogue: 0,0:20:02.74,0:20:05.16,Default,,0,0,0,,Жабайы қашады
Dialogue: 0,0:20:06.70,0:20:08.70,Default,,0,0,0,,Қалғанын маған қалдырыңыз
Dialogue: 0,0:20:08.79,0:20:11.16,Default,,0,0,0,,Жабайы аң қайда қашады
Dialogue: 0,0:20:15.42,0:20:16.92,Default,,0,0,0,,Қайсысы жоғарғы жағында?
Dialogue: 0,0:20:17.00,0:20:18.25,Default,,0,0,0,,(қатты денені ұрған дыбыс)
Dialogue: 0,0:20:19.05,0:20:21.13,Default,,0,0,0,,Маған штабты көрсетіңіз!
Dialogue: 0,0:20:23.26,0:20:26.26,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:27.76,0:20:31.18,Default,,0,0,0,,Қандай жақсы күн болды!
Dialogue: 0,0:20:33.81,0:20:35.44,Default,,0,0,0,,Армандарыңызды қуып жету...
Dialogue: 0,0:20:37.77,0:20:40.53,Default,,0,0,0,,Оны ондаған жылдар бойы ләззат алды
Dialogue: 0,0:20:41.03,0:20:42.95,Default,,0,0,0,,(Қатты ағынның дыбысы)
Dialogue: 0,0:20:44.49,0:20:47.45,Default,,0,0,0,,Сол адам бүгін түнде сауап алады.
Dialogue: 0,0:20:48.20,0:20:52.50,Default,,0,0,0,,Саке тұманымен тойлайық.
Dialogue: 0,0:20:59.04,0:21:00.80,Default,,0,0,0,,Шығар!
Dialogue: 0,0:21:00.88,0:21:01.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:06.55,0:21:10.47,Default,,0,0,0,,Хмм? иә? Сіз...
Dialogue: 0,0:21:10.56,0:21:12.22,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:13.23,0:21:14.98,Default,,0,0,0,,Бөлім...
Dialogue: 0,0:21:15.56,0:21:18.02,Default,,0,0,0,,О~ Токугава!
Dialogue: 0,0:21:18.11,0:21:19.98,Default,,0,0,0,,Зейінді адам
Dialogue: 0,0:21:20.07,0:21:21.57,Default,,0,0,0,,Күте тұрыңыз…
Dialogue: 0,0:21:27.70,0:21:29.70,Default,,0,0,0,,♪～
Dialogue: 0,0:22:53.99,0:22:55.99,Default,,0,0,0,,～♪
Dialogue: 0,0:22:57.49,0:23:03.49,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory