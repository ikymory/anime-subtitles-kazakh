Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.51,0:00:13.51,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.22,0:01:39.22,Default,,0,0,0,,～♪
Dialogue: 0,0:02:21.93,0:02:24.93,Default,,0,0,0,,(дөңгелектер дыбысы)
Dialogue: 0,0:02:36.44,0:02:38.40,Default,,0,0,0,,Бұл сәл алыс.
Dialogue: 0,0:02:38.49,0:02:43.12,Default,,0,0,0,,Жоқ... бетім, ойым, ойым.
Dialogue: 0,0:02:43.62,0:02:45.62,Default,,0,0,0,,Бұл қашықтық жеткілікті
Dialogue: 0,0:02:45.70,0:02:47.87,Default,,0,0,0,,Артық немесе жетіспеушілік жоқ
Dialogue: 0,0:02:49.79,0:02:52.63,Default,,0,0,0,,Темекі шегуге тыйым салынғаны біртүрлі...
Dialogue: 0,0:02:54.71,0:02:56.84,Default,,0,0,0,,Катцуми Миинеи
Dialogue: 0,0:02:56.92,0:02:57.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:59.22,0:03:01.89,Default,,0,0,0,,Пон семсерінің өлшемі ғана
Dialogue: 0,0:03:01.97,0:03:04.39,Default,,0,0,0,,Мен оны пайдалануға дайынмын.
Dialogue: 0,0:03:05.05,0:03:07.31,Default,,0,0,0,,Мұнда болу дегенді білдіреді
Dialogue: 0,0:03:07.39,0:03:11.39,Default,,0,0,0,,Бұл оның қылышсыз шыққанын білдіре ме?
Dialogue: 0,0:03:11.98,0:03:13.15,Default,,0,0,0,,Саана
Dialogue: 0,0:03:13.23,0:03:16.15,Default,,0,0,0,,Буын алшақтығы мен оқу үшін тым үлкен.
Dialogue: 0,0:03:20.78,0:03:22.66,Default,,0,0,0,,Неге екен?
Dialogue: 0,0:03:22.74,0:03:24.12,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:03:26.12,0:03:28.79,Default,,0,0,0,,Мен генералдың жауы болсам да...
Dialogue: 0,0:03:31.12,0:03:33.54,Default,,0,0,0,,Мен сені жек көремін деп жүре алмаймын.
Dialogue: 0,0:03:34.13,0:03:36.13,Default,,0,0,0,,- (Көрермендер) Иә? -(Көрермендер) Иә?
Dialogue: 0,0:03:36.21,0:03:37.05,Default,,0,0,0,,Әй...
Dialogue: 0,0:03:38.21,0:03:39.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:39.13,0:03:41.05,Default,,0,0,0,,- (Көрермендер) Ах! -(Көрермендер) Ой...
Dialogue: 0,0:03:42.13,0:03:43.30,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:53.65,0:03:54.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:01.61,0:04:05.32,Default,,0,0,0,,Өсек-аяңға алданып, Жапонияға келдім.
Dialogue: 0,0:04:06.03,0:04:09.33,Default,,0,0,0,,Жай қауесет емес
Dialogue: 0,0:04:09.91,0:04:13.83,Default,,0,0,0,,Ондай адам бар ма?
Dialogue: 0,0:04:16.33,0:04:18.29,Default,,0,0,0,,Кіру ерте.
Dialogue: 0,0:04:18.38,0:04:20.55,Default,,0,0,0,,Не болды саған? Біраз қақтығысқыш болып тұрсың ғой?
Dialogue: 0,0:04:24.59,0:04:27.22,Default,,0,0,0,,Хе... Нені жоспарлап отырсыз?
Dialogue: 0,0:04:32.31,0:04:33.39,Default,,0,0,0,,Зазен?
Dialogue: 0,0:04:33.48,0:04:34.60,Default,,0,0,0,,Жаудың тосын сыйы...
Dialogue: 0,0:04:34.69,0:04:35.90,Default,,0,0,0,,Оқыңыз!
Dialogue: 0,0:04:35.98,0:04:37.27,Default,,0,0,0,,Шайқаста шыңдалған
Dialogue: 0,0:04:37.36,0:04:38.82,Default,,0,0,0,,Қолөнер
Dialogue: 0,0:04:38.90,0:04:40.23,Default,,0,0,0,,Алдау...
Dialogue: 0,0:04:42.07,0:04:44.45,Default,,0,0,0,,- (Көрермендер) Ах - (Көрермендер) Келесің бе?
Dialogue: 0,0:04:44.53,0:04:45.66,Default,,0,0,0,,Бұл Баки!
Dialogue: 0,0:04:45.74,0:04:46.74,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:04:47.78,0:04:50.37,Default,,0,0,0,,- (Көрермендер) Бұл Бақи! -(Көрермендер) Бұл Бақи!
Dialogue: 0,0:04:50.45,0:04:53.87,Default,,0,0,0,,(Қуаныш бірте-бірте күшейеді)
Dialogue: 0,0:05:08.47,0:05:10.47,Default,,0,0,0,,(жалғасы бар)
Dialogue: 0,0:05:11.97,0:05:13.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:24.49,0:05:26.65,Default,,0,0,0,,Бон, сен не істеп жүрсің?
Dialogue: 0,0:05:27.41,0:05:28.91,Default,,0,0,0,,Күтуден шаршадым.
Dialogue: 0,0:05:31.08,0:05:31.91,Default,,0,0,0,,Иә
Dialogue: 0,0:05:31.99,0:05:32.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:34.16,0:05:35.50,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:39.63,0:05:42.55,Default,,0,0,0,,Чисугахара көзге көрінетіндей
Dialogue: 0,0:05:43.34,0:05:45.63,Default,,0,0,0,,Жесем де, жесем де
Dialogue: 0,0:05:46.97,0:05:49.09,Default,,0,0,0,,Ішсең де, ішсең де
Dialogue: 0,0:05:49.64,0:05:52.31,Default,,0,0,0,,Шексіз Чисугахара
Dialogue: 0,0:05:56.14,0:05:57.56,Default,,0,0,0,,Тамақтану және тамақтану
Dialogue: 0,0:05:58.27,0:06:00.81,Default,,0,0,0,,Бірде-бір тағам қалмады
Dialogue: 0,0:06:01.52,0:06:02.82,Default,,0,0,0,,Бұл қаңырап
Dialogue: 0,0:06:04.86,0:06:06.78,Default,,0,0,0,,Дәл Секигахара сияқты
Dialogue: 0,0:06:08.20,0:06:09.82,Default,,0,0,0,,Сіз оны жедіңіз бе?
Dialogue: 0,0:06:10.41,0:06:11.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:12.33,0:06:14.83,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:06:16.16,0:06:19.08,Default,,0,0,0,,Хехехе солай ма...
Dialogue: 0,0:06:19.17,0:06:20.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:20.08,0:06:22.09,Default,,0,0,0,,Мен енді тамақ ішпеймін
Dialogue: 0,0:06:22.17,0:06:23.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:23.42,0:06:28.09,Default,,0,0,0,,Тамағыңнан бір түйір де қалмауы керек!
Dialogue: 0,0:06:28.17,0:06:31.64,Default,,0,0,0,,Мен енді той емеспін!
Dialogue: 0,0:06:31.72,0:06:33.85,Default,,0,0,0,,...Олай дейсің.
Dialogue: 0,0:06:34.43,0:06:35.85,Default,,0,0,0,,Ханма Баки!
Dialogue: 0,0:06:37.93,0:06:40.94,Default,,0,0,0,,Хмм... жоқ, у...
Dialogue: 0,0:06:41.94,0:06:45.11,Default,,0,0,0,,Не туралы айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:06:45.69,0:06:46.86,Default,,0,0,0,,Жетеді
Dialogue: 0,0:06:46.94,0:06:49.61,Default,,0,0,0,,У жесең, тіпті табақ!
Dialogue: 0,0:06:49.70,0:06:52.37,Default,,0,0,0,,Табақ жесең, тіпті лоток!
Dialogue: 0,0:06:52.45,0:06:54.58,Default,,0,0,0,,Науаны жесең, тіпті халық!
Dialogue: 0,0:06:57.20,0:06:59.16,Default,,0,0,0,,Қазір не істей аласыз
Dialogue: 0,0:06:59.25,0:07:02.38,Default,,0,0,0,,Нәтижеде болатын нәрсе басқаша емес.
Dialogue: 0,0:07:04.54,0:07:05.88,Default,,0,0,0,,Баки...
Dialogue: 0,0:07:05.96,0:07:09.38,Default,,0,0,0,,Қанның әрбір тамшысын сүртейік.
Dialogue: 0,0:07:09.47,0:07:10.88,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:07:20.52,0:07:24.15,Default,,0,0,0,,Атыс қаруынан басқа барлық қаруларға рұқсат етіледі
Dialogue: 0,0:07:25.11,0:07:27.53,Default,,0,0,0,,Бұл қылыш та орталықта тұр
Dialogue: 0,0:07:27.61,0:07:30.65,Default,,0,0,0,,Қолдану Пайдаланылмайды Қосымша болып саналады.
Dialogue: 0,0:07:32.24,0:07:36.20,Default,,0,0,0,,Айтпақшы, бұл кәрі ханзаданың сөзі.
Dialogue: 0,0:07:36.70,0:07:40.41,Default,,0,0,0,,Бұл матч кімнің жеңетінін шешуге арналған.
Dialogue: 0,0:07:41.08,0:07:42.21,Default,,0,0,0,,Fair play – бұл
Dialogue: 0,0:07:42.29,0:07:45.92,Default,,0,0,0,,Бұл тек екінші дәрежелі екенін түсініңіз.
Dialogue: 0,0:07:46.54,0:07:48.00,Default,,0,0,0,,...
Dialogue: 0,0:07:48.09,0:07:49.92,Default,,0,0,0,,-(Баки) Фуфуфу... -(Үкім) Не?
Dialogue: 0,0:07:50.51,0:07:51.42,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:51.51,0:07:52.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:52.76,0:07:55.80,Default,,0,0,0,,Маған бұл хабар керек пе деп ойлаймын.
Dialogue: 0,0:07:56.35,0:07:58.68,Default,,0,0,0,,Іздеуші дегеніміз не? Беткейлік мимика
Dialogue: 0,0:07:59.43,0:08:02.69,Default,,0,0,0,,Бұл адам тарихтағы ең ауыр қылмыскер.
Dialogue: 0,0:08:03.35,0:08:06.44,Default,,0,0,0,,Қалай тәртіпке келтірілсе де, ол әділ және төртбұрышты.
Dialogue: 0,0:08:06.52,0:08:09.69,Default,,0,0,0,,Ол әділ ойынды аяққа таптайды!
Dialogue: 0,0:08:11.03,0:08:11.94,Default,,0,0,0,,Иә
Dialogue: 0,0:08:14.03,0:08:16.20,Default,,0,0,0,,Қажетсіз күтім, Токугава!
Dialogue: 0,0:08:16.28,0:08:19.20,Default,,0,0,0,,Бон әлдеқайда түсінеді!
Dialogue: 0,0:08:19.29,0:08:20.70,Default,,0,0,0,,Нихихи…
Dialogue: 0,0:08:22.33,0:08:25.46,Default,,0,0,0,,Әйтеуір, біраз уақыттан бері...
Dialogue: 0,0:08:27.00,0:08:28.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:29.05,0:08:30.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:33.05,0:08:34.72,Default,,0,0,0,,Жаңа крем?
Dialogue: 0,0:08:36.80,0:08:39.22,Default,,0,0,0,,Ки... сарайы?
Dialogue: 0,0:08:40.72,0:08:42.02,Default,,0,0,0,,Бастапқы ұстаным!
Dialogue: 0,0:08:49.32,0:08:52.49,Default,,0,0,0,,Бұл өте тәтті, мен одан шаршап бара жатқандай сезінемін.
Dialogue: 0,0:09:02.29,0:09:04.25,Default,,0,0,0,,Тек...
Dialogue: 0,0:09:09.21,0:09:10.67,Default,,0,0,0,,Тек...
Dialogue: 0,0:09:11.38,0:09:12.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.05,0:09:14.76,Default,,0,0,0,,Маған бұл жағдай ұнайды.
Dialogue: 0,0:09:15.59,0:09:18.26,Default,,0,0,0,,Өзім өсіргеннің бәрін беруден басқа амалым жоқ.
Dialogue: 0,0:09:19.14,0:09:21.85,Default,,0,0,0,,Барлық басқа опциялар жабық
Dialogue: 0,0:09:22.85,0:09:23.77,Default,,0,0,0,,Яғни
Dialogue: 0,0:09:25.02,0:09:27.77,Default,,0,0,0,,Сізде бар нәрсені беруге болады
Dialogue: 0,0:09:34.03,0:09:36.03,Default,,0,0,0,,Бастау! (барабан дыбысы)
Dialogue: 0,0:09:36.11,0:09:39.07,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:42.87,0:09:44.04,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:46.12,0:09:46.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:47.04,0:09:49.04,Default,,0,0,0,,- (аудитория) Иә? -(Көрермендер) Бірдеңе...
Dialogue: 0,0:09:49.13,0:09:51.04,Default,,0,0,0,,Осы қашықтықта...
Dialogue: 0,0:09:51.79,0:09:55.55,Default,,0,0,0,,Осы қашықтықта сіз өз күшіңізді түсінесіз
Dialogue: 0,0:09:56.51,0:09:58.55,Default,,0,0,0,,Уау! Және...
Dialogue: 0,0:09:59.43,0:10:02.56,Default,,0,0,0,,Олардың бесеуінің де қылыштары бар!
Dialogue: 0,0:10:03.14,0:10:04.31,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:04.39,0:10:07.06,Default,,0,0,0,,Керемет~
Dialogue: 0,0:10:07.98,0:10:10.31,Default,,0,0,0,,Қандай дарынды адам...
Dialogue: 0,0:10:10.40,0:10:11.81,Default,,0,0,0,,Катцуми
Dialogue: 0,0:10:12.40,0:10:14.07,Default,,0,0,0,,Бұл Мусаши
Dialogue: 0,0:10:15.65,0:10:16.82,Default,,0,0,0,,О, менің...
Dialogue: 0,0:10:19.99,0:10:21.32,Default,,0,0,0,,Сізде ол бар.
Dialogue: 0,0:10:22.33,0:10:24.66,Default,,0,0,0,,Оны дайындаудың қажеті жоқ.
Dialogue: 0,0:10:24.74,0:10:26.29,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:10:27.29,0:10:30.46,Default,,0,0,0,,Менде қылыш жоқ болса, мен оны жеңемін.
Dialogue: 0,0:10:30.54,0:10:33.71,Default,,0,0,0,,Мақтаншақ адамдар маған ұнамайды.
Dialogue: 0,0:10:33.79,0:10:36.67,Default,,0,0,0,,Қолыңда қылыш болса, қолыңнан бәрі келеді.
Dialogue: 0,0:10:37.17,0:10:39.22,Default,,0,0,0,,Егер мұндай Миямото Мусаши
Dialogue: 0,0:10:39.97,0:10:41.72,Default,,0,0,0,,Бұл қаншалықты оңай болар еді
Dialogue: 0,0:10:42.39,0:10:43.22,Default,,0,0,0,,Мұсаши мырза
Dialogue: 0,0:10:44.01,0:10:47.14,Default,,0,0,0,,Біз Миямото Мусашидің жалаң қолын жеңіл қабылдамаймыз.
Dialogue: 0,0:10:47.64,0:10:49.98,Default,,0,0,0,,Ондай адам жоқ.
Dialogue: 0,0:10:50.06,0:10:51.06,Default,,0,0,0,,Тек...
Dialogue: 0,0:10:51.56,0:10:54.15,Default,,0,0,0,,Ештеңе істеу мүмкін емес
Dialogue: 0,0:10:54.65,0:10:56.23,Default,,0,0,0,,Олай ойлама!
Dialogue: 0,0:11:00.86,0:11:02.24,Default,,0,0,0,,Куу~
Dialogue: 0,0:11:02.82,0:11:04.49,Default,,0,0,0,,Ол кенеттен істен шықты ма?
Dialogue: 0,0:11:09.41,0:11:12.00,Default,,0,0,0,,Бон, мен оны олай лақтырған жоқпын.
Dialogue: 0,0:11:12.83,0:11:13.75,Default,,0,0,0,,Менің қылышым
Dialogue: 0,0:11:13.83,0:11:14.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:14.92,0:11:16.38,Default,,0,0,0,,Менікі ме?
Dialogue: 0,0:11:17.21,0:11:18.13,Default,,0,0,0,,Ах
Dialogue: 0,0:11:19.84,0:11:21.63,Default,,0,0,0,,Не... кесіп алдың?
Dialogue: 0,0:11:22.84,0:11:23.89,Default,,0,0,0,,Бір!
Dialogue: 0,0:11:23.97,0:11:25.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:26.31,0:11:27.14,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:31.73,0:11:33.15,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:11:36.23,0:11:38.40,Default,,0,0,0,,Хехе, мен оны теуіп көрдім.
Dialogue: 0,0:11:38.98,0:11:41.11,Default,,0,0,0,,Кездесудің ортасында болсам да.
Dialogue: 0,0:11:41.20,0:11:44.41,Default,,0,0,0,,Тұрақтылығы жоқ бір аяқты жақсы көремін...
Dialogue: 0,0:11:46.99,0:11:50.16,Default,,0,0,0,,Бұрын мен тебу техникасының ақымақтығына шағымданатынмын.
Dialogue: 0,0:11:50.25,0:11:52.12,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:11:52.21,0:11:53.83,Default,,0,0,0,,Мен де үйрендім
Dialogue: 0,0:11:53.92,0:11:59.05,Default,,0,0,0,,...
Dialogue: 0,0:11:59.13,0:12:02.17,Default,,0,0,0,,Жеңілген қарсыластарға қарсы өте тиімді.
Dialogue: 0,0:12:03.13,0:12:05.18,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:12:05.97,0:12:09.31,Default,,0,0,0,,Бір күшті адам маған бір рет қайнаған суды ішті.
Dialogue: 0,0:12:10.06,0:12:12.31,Default,,0,0,0,,Ақша болса, қылыштан артық.
Dialogue: 0,0:12:12.98,0:12:17.82,Default,,0,0,0,,Сол мықты Юдзиро Ханманы жеңгеніңді естідім.
Dialogue: 0,0:12:18.48,0:12:19.82,Default,,0,0,0,,Аппараттар
Dialogue: 0,0:12:21.49,0:12:23.32,Default,,0,0,0,,Мен оны мойындамаймын
Dialogue: 0,0:12:23.90,0:12:27.66,Default,,0,0,0,,Хо Жеңілгеніңді мойындама
Dialogue: 0,0:12:28.33,0:12:31.58,Default,,0,0,0,,Оның орнына жеңісті мойындамасақ...
Dialogue: 0,0:12:31.66,0:12:33.83,Default,,0,0,0,,Тым жақсы киінбеңіз
Dialogue: 0,0:12:34.92,0:12:36.33,Default,,0,0,0,,Жеңіс - жеңіс
Dialogue: 0,0:12:39.42,0:12:40.59,Default,,0,0,0,,Мен тым көп сөйледім
Dialogue: 0,0:12:47.43,0:12:48.35,Default,,0,0,0,,Қасиетті орындарым қалайша күйреді.
Dialogue: 0,0:12:52.60,0:12:53.60,Default,,0,0,0,,Кез келген уақытта
Dialogue: 0,0:12:54.94,0:12:58.61,Default,,0,0,0,,Қалай, не, бұл кездесу...
Dialogue: 0,0:12:59.23,0:13:04.07,Default,,0,0,0,,Ұрпақтарды қамтитын сол кездесудің жалғасы.
Dialogue: 0,0:13:06.57,0:13:08.49,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:13:09.62,0:13:12.12,Default,,0,0,0,,Менің жолыма кедергі болма
Dialogue: 0,0:13:22.71,0:13:24.63,Default,,0,0,0,,Тізені алып тастаңыз
Dialogue: 0,0:13:25.55,0:13:27.64,Default,,0,0,0,,Құлаған дененің үдеуі
Dialogue: 0,0:13:29.14,0:13:30.39,Default,,0,0,0,,Өкшеге соғу
Dialogue: 0,0:13:31.81,0:13:34.14,Default,,0,0,0,,Жау позициясына бұрылыңыз
Dialogue: 0,0:13:35.56,0:13:38.23,Default,,0,0,0,,Сол уақыт ішінде ол шын мәнінде 0,00…
Dialogue: 0,0:13:38.31,0:13:39.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:39.23,0:13:40.15,Default,,0,0,0,,Жоғалу...
Dialogue: 0,0:13:42.73,0:13:45.57,Default,,0,0,0,,О!
Dialogue: 0,0:13:50.32,0:13:52.03,Default,,0,0,0,,Мен... Көре алмаймын!
Dialogue: 0,0:13:52.12,0:13:53.08,Default,,0,0,0,,Жаб?
Dialogue: 0,0:13:53.16,0:13:54.91,Default,,0,0,0,,Бір оқпен жеңілді!
Dialogue: 0,0:13:55.00,0:13:56.37,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:56.46,0:13:58.67,Default,,0,0,0,,Хмм, үш ату.
Dialogue: 0,0:13:58.75,0:14:01.88,Default,,0,0,0,,Бір дыбыс сияқты үш дыбыс
Dialogue: 0,0:14:01.96,0:14:04.42,Default,,0,0,0,,Өте жоғары жылдамдықты тесу
Dialogue: 0,0:14:04.51,0:14:10.18,Default,,0,0,0,,Осы залда қазіргі кесу күші үш рет ату екенін білетін адам бар ма?
Dialogue: 0,0:14:10.26,0:14:11.93,Default,,0,0,0,,Қанша адам бар...
Dialogue: 0,0:14:19.73,0:14:20.81,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:23.57,0:14:27.19,Default,,0,0,0,,Боб Мунден, аты аңызға айналған атқыш
Dialogue: 0,0:14:27.70,0:14:29.82,Default,,0,0,0,,Мылтық механигі
Dialogue: 0,0:14:30.49,0:14:32.70,Default,,0,0,0,,Бір-бірінен 2 метр қашықтықта орналасқан екі шар...
Dialogue: 0,0:14:32.78,0:14:33.62,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:33.70,0:14:35.95,Default,,0,0,0,,0,02 секундта ату
Dialogue: 0,0:14:36.04,0:14:38.33,Default,,0,0,0,,Сол екі атыстың дыбысы болды
Dialogue: 0,0:14:39.16,0:14:42.33,Default,,0,0,0,,Құлағымды тарс еткізсем де, тек бір оқ естимін.
Dialogue: 0,0:14:43.13,0:14:45.59,Default,,0,0,0,,Көзді ашып-жұмғанша асатын жылдамдық
Dialogue: 0,0:14:46.59,0:14:49.59,Default,,0,0,0,,Гитлинг мылтығының атыс жылдамдығымен салыстыруға болады.
Dialogue: 0,0:14:50.76,0:14:53.68,Default,,0,0,0,,Тез ату кезінде тұтқаға түсетін ауырлық күші
Dialogue: 0,0:14:53.76,0:14:55.60,Default,,0,0,0,,Іс жүзінде 10G(G)
Dialogue: 0,0:14:56.39,0:15:01.60,Default,,0,0,0,,10G истребитель ұшқышының физикалық шегіне сәйкес келеді.
Dialogue: 0,0:15:02.94,0:15:05.52,Default,,0,0,0,,Осындай ауырлық күшін көтере алу
Dialogue: 0,0:15:06.73,0:15:11.86,Default,,0,0,0,,Бұл картаны тігінен жыртуға мүмкіндік беретін керемет ұстау мен қысу күшімен байланысты болуы керек.
Dialogue: 0,0:15:13.20,0:15:14.91,Default,,0,0,0,,Джабты Баки атып тастады
Dialogue: 0,0:15:15.41,0:15:17.87,Default,,0,0,0,,Үш сатылы жоғарғы, ортаңғы және төменгі штрих
Dialogue: 0,0:15:18.66,0:15:19.66,Default,,0,0,0,,Бет
Dialogue: 0,0:15:20.25,0:15:21.50,Default,,0,0,0,,Суйгецу
Dialogue: 0,0:15:22.00,0:15:22.88,Default,,0,0,0,,Қаржы
Dialogue: 0,0:15:23.50,0:15:26.13,Default,,0,0,0,,Бір соққыда бір уақытта үш ату Жылдам атыс
Dialogue: 0,0:15:27.21,0:15:30.63,Default,,0,0,0,,Сонымен қатар, ең жылдамдан басталатын тарақан сызықша
Dialogue: 0,0:15:31.51,0:15:33.64,Default,,0,0,0,,Мұсаши қашықтығын жоғалтпасын
Dialogue: 0,0:15:34.51,0:15:35.64,Default,,0,0,0,,Қосымша—
Dialogue: 0,0:15:36.72,0:15:40.77,Default,,0,0,0,,Тізімнен әлсіз тұстарын толық пайдалана отырып әрекет ету арқылы
Dialogue: 0,0:15:40.85,0:15:42.90,Default,,0,0,0,,Жыпылықтау соққысының бірінші түсірілімі
Dialogue: 0,0:15:43.69,0:15:46.40,Default,,0,0,0,,Мұсашидің қабағы терең ойылған.
Dialogue: 0,0:15:47.32,0:15:48.82,Default,,0,0,0,,3-тен жоғары
Dialogue: 0,0:15:48.90,0:15:51.90,Default,,0,0,0,,Қазіргі заманғы ұрыс әдістерін бір мезгілде қолдану
Dialogue: 0,0:15:51.99,0:15:53.61,Default,,0,0,0,,Керемет!
Dialogue: 0,0:15:53.70,0:15:55.91,Default,,0,0,0,,Тамаша ұшы жұмысы
Dialogue: 0,0:15:56.41,0:15:57.91,Default,,0,0,0,,Бұл да рас...
Dialogue: 0,0:15:58.54,0:16:00.91,Default,,0,0,0,,Енді Бақи-сан...
Dialogue: 0,0:16:02.12,0:16:04.12,Default,,0,0,0,,Бірдеңе жоғалып кетті...
Dialogue: 0,0:16:04.75,0:16:08.42,Default,,0,0,0,,(Мусашидің ауыр тыныс алуы)
Dialogue: 0,0:16:08.50,0:16:11.42,Default,,0,0,0,,Сенгокуда жоқ технология
Dialogue: 0,0:16:11.51,0:16:14.68,Default,,0,0,0,,Мұсаши үшін бұл тым жаңа болды ма?
Dialogue: 0,0:16:17.76,0:16:19.06,Default,,0,0,0,,Бонн
Dialogue: 0,0:16:19.14,0:16:22.35,Default,,0,0,0,,Жаңа ғана құлап қалған кезде
Dialogue: 0,0:16:22.43,0:16:24.69,Default,,0,0,0,,Бірнеше рет өлтірілген болуы керек
Dialogue: 0,0:16:24.77,0:16:25.69,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:16:26.27,0:16:28.19,Default,,0,0,0,,Мен мұндай шытырман оқиғаға бармаймын.
Dialogue: 0,0:16:28.27,0:16:29.94,Default,,0,0,0,,Егер сіз оны өлтіргіңіз келсе
Dialogue: 0,0:16:30.03,0:16:32.19,Default,,0,0,0,,Қозғалыс кезінде жақсы
Dialogue: 0,0:16:32.82,0:16:33.70,Default,,0,0,0,,Хаха
Dialogue: 0,0:16:34.78,0:16:36.16,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:36.24,0:16:37.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:37.32,0:16:39.95,Default,,0,0,0,,Қоңырауды жоғарыдан соғу
Dialogue: 0,0:16:40.83,0:16:44.46,Default,,0,0,0,,Маған төменнен соққы тисе, бітті.
Dialogue: 0,0:16:48.79,0:16:49.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:52.97,0:16:54.22,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:16:54.84,0:16:55.72,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:16:56.39,0:16:57.97,Default,,0,0,0,,Енді қосылу уақыты келді
Dialogue: 0,0:16:58.05,0:17:01.72,Default,,0,0,0,,Аспалы мылтық біршама төмен түсті.
Dialogue: 0,0:17:02.98,0:17:04.98,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:10.19,0:17:12.36,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:17:12.94,0:17:15.86,Default,,0,0,0,,Мен саусақтарыңды көзіммен ұстаймын
Dialogue: 0,0:17:16.61,0:17:18.37,Default,,0,0,0,,Мен бұл саусақты сындырамын
Dialogue: 0,0:17:19.03,0:17:20.37,Default,,0,0,0,,Екі көзіммен
Dialogue: 0,0:17:21.95,0:17:25.62,Default,,0,0,0,,Көз алмасымен саусағыңды бұрап алдың...
Dialogue: 0,0:17:26.33,0:17:29.50,Default,,0,0,0,,Бірақ, мен мұны істеймін, ол адам...
Dialogue: 0,0:17:30.09,0:17:34.09,Default,,0,0,0,,Күшті әлсіздік? Не? Бұл сияқты нәрсе...
Dialogue: 0,0:17:34.17,0:17:36.26,Default,,0,0,0,,Бұл өте нашар.
Dialogue: 0,0:17:36.34,0:17:39.85,Default,,0,0,0,,Маған тигенше ұстап алмақ болдым.
Dialogue: 0,0:17:40.85,0:17:42.51,Default,,0,0,0,,Оны ұстауға да уақыт берме
Dialogue: 0,0:17:42.60,0:17:44.35,Default,,0,0,0,,5-тен 6 метрге дейінгі қашықтық
Dialogue: 0,0:17:44.43,0:17:49.52,Default,,0,0,0,,Телепортация? Неге менің саусағымды сындырдың?
Dialogue: 0,0:17:50.11,0:17:51.52,Default,,0,0,0,,Көзді соқыр ету
Dialogue: 0,0:17:52.23,0:17:53.98,Default,,0,0,0,,Өте жылдам!
Dialogue: 0,0:17:54.07,0:17:55.94,Default,,0,0,0,,Өте күшті!
Dialogue: 0,0:17:56.03,0:17:57.11,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:57.61,0:18:01.28,Default,,0,0,0,,Оңай...
Dialogue: 0,0:18:01.37,0:18:03.29,Default,,0,0,0,,таң қалды
Dialogue: 0,0:18:03.87,0:18:05.29,Default,,0,0,0,,Үдеу жоқ
Dialogue: 0,0:18:05.37,0:18:08.29,Default,,0,0,0,,Статикалық денеден бастап
Dialogue: 0,0:18:09.33,0:18:12.21,Default,,0,0,0,,Жеделдеу әрқашан педальды басқан кезде пайда болады.
Dialogue: 0,0:18:12.29,0:18:13.80,Default,,0,0,0,,Дегенмен,
Dialogue: 0,0:18:13.88,0:18:17.01,Default,,0,0,0,,Бонгты басқан кезде үдеу болмайды.
Dialogue: 0,0:18:17.97,0:18:20.80,Default,,0,0,0,,Debana қазірдің өзінде максималды жылдамдықта.
Dialogue: 0,0:18:20.89,0:18:22.30,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:18:23.47,0:18:27.31,Default,,0,0,0,,Ол толығымен босатылмайынша, сіз бұл жылдамдыққа жете алмайсыз.
Dialogue: 0,0:18:27.98,0:18:29.14,Default,,0,0,0,,Иә
Dialogue: 0,0:18:29.65,0:18:31.19,Default,,0,0,0,,Судай...
Dialogue: 0,0:18:31.27,0:18:32.86,Default,,0,0,0,,Мұғалім кім?
Dialogue: 0,0:18:32.94,0:18:35.07,Default,,0,0,0,,-(Баки) Мен жиі айтамын -(Мусаши) А?
Dialogue: 0,0:18:35.15,0:18:37.19,Default,,0,0,0,,Сыртқы түрі
Dialogue: 0,0:18:37.28,0:18:40.16,Default,,0,0,0,,Көп уақытпен кек алайық.
Dialogue: 0,0:18:40.24,0:18:42.07,Default,,0,0,0,,Көп сатып алмаңыз
Dialogue: 0,0:18:42.16,0:18:44.70,Default,,0,0,0,,Қозғалыс сәтінің дәл алдында
Dialogue: 0,0:18:45.20,0:18:47.83,Default,,0,0,0,,Мен сенен шыққандай сезінемін
Dialogue: 0,0:18:48.46,0:18:50.83,Default,,0,0,0,,Бастаманы көтеру кезінде
Dialogue: 0,0:18:50.92,0:18:53.59,Default,,0,0,0,,Бірінші рет ес-түссіз қалдым.
Dialogue: 0,0:18:53.67,0:18:55.09,Default,,0,0,0,,Гая
Dialogue: 0,0:18:55.17,0:18:56.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:56.26,0:18:59.47,Default,,0,0,0,,Сенде бар менде жоқ
Dialogue: 0,0:18:59.55,0:19:00.68,Default,,0,0,0,,Е...
Dialogue: 0,0:19:00.76,0:19:03.93,Default,,0,0,0,,Бұл бастапқы сезу қабілеті.
Dialogue: 0,0:19:04.43,0:19:05.81,Default,,0,0,0,,Мотобу мырза қазірдің өзінде...
Dialogue: 0,0:19:05.89,0:19:07.89,Default,,0,0,0,,Маған жағымпаздануыңызды өтінемін, ақымақ.
Dialogue: 0,0:19:07.98,0:19:09.52,Default,,0,0,0,,Менің оқуым
Dialogue: 0,0:19:09.60,0:19:12.10,Default,,0,0,0,,Бұл жай ғана тәжірибе ұпайларына негізделген оқу.
Dialogue: 0,0:19:12.73,0:19:15.11,Default,,0,0,0,,Ол сіздің миыңыздың тереңдігіне жете алмайды
Dialogue: 0,0:19:15.19,0:19:17.11,Default,,0,0,0,,Осыдан бастап ми...
Dialogue: 0,0:19:17.19,0:19:19.61,Default,,0,0,0,,Енді бір-бірін оқитын кез келді.
Dialogue: 0,0:19:26.29,0:19:27.87,Default,,0,0,0,,Бірге оқи бастадық.
Dialogue: 0,0:19:28.58,0:19:30.29,Default,,0,0,0,,Бұл керемет деңгей.
Dialogue: 0,0:19:30.37,0:19:31.62,Default,,0,0,0,,Алға қадам басуға бел байлау
Dialogue: 0,0:19:32.37,0:19:35.38,Default,,0,0,0,,Бір-бірінің ойын алдын ала оқу
Dialogue: 0,0:19:35.96,0:19:37.05,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:37.71,0:19:40.09,Default,,0,0,0,,Оны тіпті адамның өзі де сезбейді.
Dialogue: 0,0:19:40.17,0:19:42.63,Default,,0,0,0,,Ақыл пайда болғанша ұстау
Dialogue: 0,0:19:43.51,0:19:45.89,Default,,0,0,0,,Сөзбен айтсақ, бұл үлкен мәселе.
Dialogue: 0,0:19:45.97,0:19:48.39,Default,,0,0,0,,Даму онша көп өзгермейді.
Dialogue: 0,0:19:48.47,0:19:49.43,Default,,0,0,0,,Е...
Dialogue: 0,0:19:49.52,0:19:51.10,Default,,0,0,0,,Онда қараңыз.
Dialogue: 0,0:19:56.11,0:19:58.53,Default,,0,0,0,,Аа, жай ғана қалыпты жүріп...
Dialogue: 0,0:20:01.11,0:20:02.11,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:20:03.36,0:20:04.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:06.12,0:20:08.04,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:20:08.79,0:20:09.79,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:20:10.37,0:20:11.79,Default,,0,0,0,,Мен оны міндетті түрде көремін
Dialogue: 0,0:20:11.87,0:20:14.12,Default,,0,0,0,,3 штрих 1 штрихқа айналады
Dialogue: 0,0:20:14.21,0:20:17.50,Default,,0,0,0,,Оның жылдам болғаны сонша, сіз 4 штрих 2 соққыға айналғанын естисіз.
Dialogue: 0,0:20:18.00,0:20:20.17,Default,,0,0,0,,Ол бәрін бақылап отырғанын айтты.
Dialogue: 0,0:20:20.26,0:20:22.80,Default,,0,0,0,,Үндеуге болмайтын нәрсені соттауға болмайды
Dialogue: 0,0:20:22.88,0:20:24.80,Default,,0,0,0,,Та... Бұл рас.
Dialogue: 0,0:20:25.76,0:20:28.93,Default,,0,0,0,,Егер сіз питчинг пішіні туралы бәрін қарасаңыз да
Dialogue: 0,0:20:29.01,0:20:33.44,Default,,0,0,0,,Әуесқойдың кәсіпқой допқа қол тигізуі мүмкін емес еді.
Dialogue: 0,0:20:34.14,0:20:35.94,Default,,0,0,0,,Волейбол шабуылы
Dialogue: 0,0:20:36.02,0:20:38.86,Default,,0,0,0,,Кәсіпқой боксшының қарапайым түзу
Dialogue: 0,0:20:40.15,0:20:42.36,Default,,0,0,0,,Бәрін алдын ала білсең де
Dialogue: 0,0:20:42.86,0:20:45.07,Default,,0,0,0,,Онымен күресу оңай емес
Dialogue: 0,0:20:45.16,0:20:46.82,Default,,0,0,0,,Енді
Dialogue: 0,0:20:49.41,0:20:51.33,Default,,0,0,0,,Үйренгенде...
Dialogue: 0,0:20:52.41,0:20:53.58,Default,,0,0,0,,(Амон) Сенде… жеккөруден басқа сезім жоқ.
Dialogue: 0,0:20:55.04,0:20:57.46,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,0:20:58.59,0:20:59.59,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:00.21,0:21:03.34,Default,,0,0,0,,Керемет, салмақ пайда болды.
Dialogue: 0,0:21:03.42,0:21:04.84,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:21:05.59,0:21:08.18,Default,,0,0,0,,Бұрынғыдан әлдеқайда анық...
Dialogue: 0,0:21:08.68,0:21:12.35,Default,,0,0,0,,Тіпті пышақтың үлгісі мен жарығы да анық...
Dialogue: 0,0:21:12.93,0:21:13.93,Default,,0,0,0,,Менде бар
Dialogue: 0,0:21:14.02,0:21:17.10,Default,,0,0,0,,Менде қылыш бар...
Dialogue: 0,0:21:18.69,0:21:20.44,Default,,0,0,0,,Кесу, итеру
Dialogue: 0,0:21:20.52,0:21:23.32,Default,,0,0,0,,шаншу, ұру, қосылу
Dialogue: 0,0:21:23.40,0:21:24.78,Default,,0,0,0,,Өз қалауыңыз бойынша
Dialogue: 0,0:21:24.86,0:21:29.53,Default,,0,0,0,,Хахаха, мен қазір боспын.
Dialogue: 0,0:21:29.62,0:21:31.29,Default,,0,0,0,,Кирисуби…
Dialogue: 0,0:21:31.79,0:21:33.54,Default,,0,0,0,,Бұл сөздерді кім айтты?
Dialogue: 0,0:21:34.20,0:21:35.41,Default,,0,0,0,,«Өлтіру және байлау»
Dialogue: 0,0:21:35.91,0:21:39.00,Default,,0,0,0,,«Семсердің астында тозақ бар»
Dialogue: 0,0:21:40.13,0:21:42.05,Default,,0,0,0,,«Бір қадам алға»
Dialogue: 0,0:21:43.13,0:21:46.05,Default,,0,0,0,,«Қалғаны - жұмақ»
Dialogue: 0,0:21:47.13,0:21:48.59,Default,,0,0,0,,Гухаа
Dialogue: 0,0:21:51.14,0:21:53.52,Default,,0,0,0,,Бүгін кешке менің жартылай жұмысым бар, білесің ғой~
Dialogue: 0,0:21:54.68,0:21:56.69,Default,,0,0,0,,♪～
Dialogue: 0,0:23:21.02,0:23:23.02,Default,,0,0,0,,～♪
Dialogue: 0,0:23:24.52,0:23:30.52,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory