Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.51,0:00:13.51,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.18,0:01:39.18,Default,,0,0,0,,～♪
Dialogue: 0,0:01:44.47,0:01:46.60,Default,,0,0,0,,Хмм... Бұл ше?
Dialogue: 0,0:01:46.68,0:01:48.10,Default,,0,0,0,,Бұл қалқан.
Dialogue: 0,0:01:48.94,0:01:50.11,Default,,0,0,0,,Қалқан…
Dialogue: 0,0:01:50.19,0:01:52.61,Default,,0,0,0,,ОМОН қолданатын қалқан
Dialogue: 0,0:01:52.69,0:01:53.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:54.19,0:01:58.28,Default,,0,0,0,,Уақыт шектеулі. Қысқаша түсіндіріп беріңізші.
Dialogue: 0,0:01:58.36,0:02:00.53,Default,,0,0,0,,Миямото Мусаши оны кесіп тастады
Dialogue: 0,0:02:00.62,0:02:01.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:01.83,0:02:04.12,Default,,0,0,0,,Соңғы кездері оған көп көңіл бөлінуде... Иә?
Dialogue: 0,0:02:04.70,0:02:08.37,Default,,0,0,0,,Бұл соңғы кезде танымал бола бастаған Мусаши.
Dialogue: 0,0:02:08.46,0:02:10.42,Default,,0,0,0,,Міне, мен кесіп тастадым ...
Dialogue: 0,0:02:10.50,0:02:13.34,Default,,0,0,0,,Қылышпен? Эй~
Dialogue: 0,0:02:13.42,0:02:15.71,Default,,0,0,0,,Біз күшейтілген акрилді қолданамыз
Dialogue: 0,0:02:16.71,0:02:18.38,Default,,0,0,0,,Тіпті оқ ату мүмкін болмаса да
Dialogue: 0,0:02:19.18,0:02:22.64,Default,,0,0,0,,Тас лақтыру пышақпен сындырылатын нәрсе емес.
Dialogue: 0,0:02:23.64,0:02:25.68,Default,,0,0,0,,Мен оны кесіп алдым.
Dialogue: 0,0:02:25.77,0:02:27.06,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:02:27.14,0:02:29.60,Default,,0,0,0,,Тофу немесе сары май сияқты...
Dialogue: 0,0:02:29.69,0:02:31.27,Default,,0,0,0,,«Иә?»
Dialogue: 0,0:02:32.02,0:02:33.48,Default,,0,0,0,,«Иә?» Мен ойлаймын.
Dialogue: 0,0:02:34.19,0:02:38.07,Default,,0,0,0,,Премьер-министрге кенеттен «иә?» деген ой келеді.
Dialogue: 0,0:02:39.45,0:02:40.45,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:41.57,0:02:43.95,Default,,0,0,0,,Мен мұны білемін...
Dialogue: 0,0:02:46.66,0:02:50.58,Default,,0,0,0,,Бір адам жасаңыз
Dialogue: 0,0:02:51.12,0:02:52.83,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:02:52.92,0:02:54.09,Default,,0,0,0,,Міне!
Dialogue: 0,0:02:55.13,0:02:57.59,Default,,0,0,0,,Барлығы бірден қосылды!
Dialogue: 0,0:02:58.26,0:03:00.59,Default,,0,0,0,,Премьер-Министр...
Dialogue: 0,0:03:00.68,0:03:02.84,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,0:03:03.64,0:03:06.35,Default,,0,0,0,,Сіз шынымен үлгердіңіз бе?
Dialogue: 0,0:03:07.35,0:03:10.10,Default,,0,0,0,,Бұл жерден іс тез өтті.
Dialogue: 0,0:03:10.69,0:03:12.90,Default,,0,0,0,,Қаруды қолдануға рұқсат сұрау
Dialogue: 0,0:03:12.98,0:03:15.61,Default,,0,0,0,,Мұндай жоспарлардан әлдеқайда жоғары
Dialogue: 0,0:03:16.19,0:03:19.86,Default,,0,0,0,,Сайттың ауқымы мен деңгейі аспанға көтерілді.
Dialogue: 0,0:03:20.45,0:03:21.36,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:03:22.24,0:03:26.12,Default,,0,0,0,,Полиция мен тәртіп сақшылары оңай енеді.
Dialogue: 0,0:03:26.95,0:03:28.91,Default,,0,0,0,,Мұндай жексұрындық
Dialogue: 0,0:03:29.00,0:03:32.67,Default,,0,0,0,,Көпшілік сізді ешқашан көрмесін!
Dialogue: 0,0:03:32.75,0:03:34.58,Default,,0,0,0,,Халыққа... Жоқ!
Dialogue: 0,0:03:34.67,0:03:38.63,Default,,0,0,0,,Бүкіл әлемге, сол адамға, сол Миямото Мусашиге.
Dialogue: 0,0:03:38.71,0:03:41.63,Default,,0,0,0,,Мені ешқашан «батыр» деп атамаңыз!
Dialogue: 0,0:03:43.43,0:03:46.39,Default,,0,0,0,,Тенка гомен, ресми бекіту
Dialogue: 0,0:03:47.22,0:03:49.72,Default,,0,0,0,,Полиция күштері ашылды
Dialogue: 0,0:03:51.68,0:03:55.40,Default,,0,0,0,,Терроризмге қарсы мақсатта жасалған ең мықты броньды машина.
Dialogue: 0,0:03:55.98,0:03:58.40,Default,,0,0,0,,Жабдық қазір қару деңгейінде.
Dialogue: 0,0:03:59.69,0:04:02.90,Default,,0,0,0,,Арнайы тактикалық шабуыл күштері STAT
Dialogue: 0,0:04:03.57,0:04:05.91,Default,,0,0,0,,Әрине, бұл резеңке оқ емес.
Dialogue: 0,0:04:05.99,0:04:07.99,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:04:11.25,0:04:13.58,Default,,0,0,0,,Тағы бір асыра сілтеу...
Dialogue: 0,0:04:16.75,0:04:17.92,Default,,0,0,0,,Енді...
Dialogue: 0,0:04:18.00,0:04:20.67,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:04:20.76,0:04:22.42,Default,,0,0,0,,Сен кімсің өзі…
Dialogue: 0,0:04:23.01,0:04:25.43,Default,,0,0,0,,Біздің қолымыздан келетін нәрсе бар ма, Премьер-министр?
Dialogue: 0,0:04:25.51,0:04:26.97,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:04:27.05,0:04:31.43,Default,,0,0,0,,Бұл жолы қария өтті!
Dialogue: 0,0:04:31.52,0:04:33.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:36.02,0:04:38.19,Default,,0,0,0,,Миямото Мусаши шынайы!
Dialogue: 0,0:04:38.27,0:04:40.44,Default,,0,0,0,,Оның үстіне ол клондалған адам болған.
Dialogue: 0,0:04:40.53,0:04:42.69,Default,,0,0,0,,Бұл туралы әлем білсе ше?
Dialogue: 0,0:04:42.78,0:04:44.70,Default,,0,0,0,,Жапония оқшауланады
Dialogue: 0,0:04:45.32,0:04:48.12,Default,,0,0,0,,Клондау технологиясы күн санап дамып келеді
Dialogue: 0,0:04:48.20,0:04:51.62,Default,,0,0,0,,Олардың ішінде адамды клондау туралы көзқарастар
Dialogue: 0,0:04:51.70,0:04:53.71,Default,,0,0,0,,Бұл мүлдем тыйым салынған
Dialogue: 0,0:04:53.79,0:04:56.33,Default,,0,0,0,,Бұл бүкіл әлемге ортақ мойындау!
Dialogue: 0,0:04:57.08,0:04:58.08,Default,,0,0,0,,Адамгершілік
Dialogue: 0,0:04:58.58,0:04:59.67,Default,,0,0,0,,Этика
Dialogue: 0,0:05:00.17,0:05:01.42,Default,,0,0,0,,Адам құқықтарын қорғау
Dialogue: 0,0:05:01.92,0:05:04.51,Default,,0,0,0,,- (Премьер-министр) Әр қырынан... - (Мицунари) Түсіндім!
Dialogue: 0,0:05:04.59,0:05:06.34,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:05:15.44,0:05:16.85,Default,,0,0,0,,Өлтіру?
Dialogue: 0,0:05:17.44,0:05:20.48,Default,,0,0,0,,Қазірдің өзінде екі жәбірленуші бар.
Dialogue: 0,0:05:20.57,0:05:22.36,Default,,0,0,0,,Одан әрі көбейту мүмкін емес
Dialogue: 0,0:05:23.19,0:05:25.70,Default,,0,0,0,,Мәйіттер өте көп.
Dialogue: 0,0:05:26.20,0:05:30.12,Default,,0,0,0,,Жақындаған адамды кесетін шебер қылышшы.
Dialogue: 0,0:05:30.20,0:05:33.12,Default,,0,0,0,,Тіпті талқылау қауіпті
Dialogue: 0,0:05:33.20,0:05:37.21,Default,,0,0,0,,Атыс қаруы Өткізілген оқтарды арнайы пайдалануға рұқсат етіледі.\NЕгер
Dialogue: 0,0:05:38.00,0:05:40.13,Default,,0,0,0,,болса, одан да көп
Dialogue: 0,0:05:40.88,0:05:43.17,Default,,0,0,0,,Мәйіттер өте көп
Dialogue: 0,0:05:43.71,0:05:45.30,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:05:45.38,0:05:47.13,Default,,0,0,0,,Бұл өте қатты
Dialogue: 0,0:05:47.76,0:05:48.63,Default,,0,0,0,,Батпырауық?
Dialogue: 0,0:05:49.68,0:05:52.14,Default,,0,0,0,,Билікті біреу алады ма? Соған
Dialogue: 0,0:05:56.73,0:05:57.94,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:58.60,0:06:01.65,Default,,0,0,0,,Әй, қарсы тарапта ешнәрсе жоқ.
Dialogue: 0,0:06:01.73,0:06:03.90,Default,,0,0,0,,Міне, бәрі.
Dialogue: 0,0:06:05.23,0:06:06.90,Default,,0,0,0,,Марухи алға!
Dialogue: 0,0:06:07.61,0:06:10.32,Default,,0,0,0,,Тоқта! Барлық әскерлер сақ болыңдар!
Dialogue: 0,0:06:11.49,0:06:14.33,Default,,0,0,0,,6 және 7 вагондар арасында өтті
Dialogue: 0,0:06:14.41,0:06:15.91,Default,,0,0,0,,Мен сенің артыңа келдім.
Dialogue: 0,0:06:16.00,0:06:18.41,Default,,0,0,0,,Барлық мүшелер, бірден түсіңіздер.
Dialogue: 0,0:06:18.50,0:06:20.33,Default,,0,0,0,,Ескерту деңгейі 4
Dialogue: 0,0:06:20.42,0:06:22.42,Default,,0,0,0,,Пойыздан түскен бойда таралады!
Dialogue: 0,0:06:31.84,0:06:33.14,Default,,0,0,0,,№.
Dialogue: 0,0:06:34.76,0:06:35.68,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:35.77,0:06:37.48,Default,,0,0,0,,Табылмады!
Dialogue: 0,0:06:37.56,0:06:39.19,Default,,0,0,0,,Көліктің астында не бар?
Dialogue: 0,0:06:39.27,0:06:40.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:40.52,0:06:42.44,Default,,0,0,0,,Көліктің астында!
Dialogue: 0,0:06:42.52,0:06:45.36,Default,,0,0,0,,Оны тапқан бойда атып таста!
Dialogue: 0,0:06:45.44,0:06:46.44,Default,,0,0,0,,… …
Dialogue: 0,0:06:47.24,0:06:48.44,Default,,0,0,0,,Бұл…
Dialogue: 0,0:06:49.53,0:06:51.03,Default,,0,0,0,,Шимамото мырза...
Dialogue: 0,0:06:51.61,0:06:54.24,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:06:54.33,0:06:55.70,Default,,0,0,0,,А?
Dialogue: 0,0:06:56.29,0:06:57.12,Default,,0,0,0,,Гррр…
Dialogue: 0,0:06:57.79,0:07:00.46,Default,,0,0,0,,Бір сәт, екі сәт...
Dialogue: 0,0:07:00.54,0:07:02.92,Default,,0,0,0,,Мен артыма қарауға тартындым.
Dialogue: 0,0:07:03.00,0:07:06.42,Default,,0,0,0,,Мен бұрылсам, менің кесілген суретім жыпылықтайды.
Dialogue: 0,0:07:07.26,0:07:10.22,Default,,0,0,0,,STAT үшінші жыпылықтауға мүмкіндік бермеді
Dialogue: 0,0:07:11.01,0:07:14.22,Default,,0,0,0,,Оларды тауып алған бойда атып тастауы керек емес пе еді?
Dialogue: 0,0:07:14.80,0:07:16.72,Default,,0,0,0,,Мені таң қалдырған сурет...
Dialogue: 0,0:07:16.81,0:07:17.93,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:07:18.02,0:07:19.31,Default,,0,0,0,,сызылған
Dialogue: 0,0:07:19.81,0:07:22.44,Default,,0,0,0,,Қайғылы алапат осында және қазір...
Dialogue: 0,0:07:22.52,0:07:23.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:24.81,0:07:26.48,Default,,0,0,0,,Сонымен… шықты!
Dialogue: 0,0:07:26.57,0:07:27.48,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:07:28.07,0:07:29.15,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:07:29.24,0:07:31.90,Default,,0,0,0,,(2-мүшенің айқайы)
Dialogue: 0,0:07:31.99,0:07:33.91,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:33.99,0:07:35.62,Default,,0,0,0,,- (Эскадрон) Мына жерде! -(Эскадрон) Оны қоршап ал.
Dialogue: 0,0:07:35.70,0:07:37.49,Default,,0,0,0,,№5 автокөлік артқы жағынан кесілген!
Dialogue: 0,0:07:37.58,0:07:39.33,Default,,0,0,0,,- (Эскадрон) Оларды қоршама! -(Отряд мүшесі) Кім кесілді?
Dialogue: 0,0:07:44.92,0:07:45.92,Default,,0,0,0,,Төмен!
Dialogue: 0,0:07:46.00,0:07:47.34,Default,,0,0,0,,- (Эскадрон) Сүңгіп кетті! -(Эскадрон) Жарқыра!
Dialogue: 0,0:07:47.42,0:07:48.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:48.96,0:07:50.34,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:07:50.42,0:07:51.34,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:07:51.42,0:07:52.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:55.43,0:07:56.55,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:07:56.64,0:07:58.10,Default,,0,0,0,,- (Эскадрон) Мен кесіп тастадым! -(Эскадрон) Міне!
Dialogue: 0,0:07:58.18,0:07:59.68,Default,,0,0,0,,- (Эскадрон) Мына жақта! -(Эскадрон) Ат!
Dialogue: 0,0:07:59.77,0:08:01.10,Default,,0,0,0,,Атпа, ақымақ!
Dialogue: 0,0:08:01.81,0:08:03.69,Default,,0,0,0,,Мен №1 вагонға бардым!
Dialogue: 0,0:08:03.77,0:08:05.86,Default,,0,0,0,,- (Эскадрон) Қуғын! Chase! -(Эскадрон) Екіге бөл!
Dialogue: 0,0:08:07.69,0:08:08.69,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:08:08.77,0:08:10.61,Default,,0,0,0,,-(Солдат) Айналайын -(Солдат) Қашып кетпесін!
Dialogue: 0,0:08:10.69,0:08:12.86,Default,,0,0,0,,(мүшелердің айқайы)
Dialogue: 0,0:08:12.95,0:08:15.53,Default,,0,0,0,,- (Эскадрон) Қоршауға алынды! -(Эскадрон) Бізді қоршап алыңдар. Біз не істеуіміз керек?
Dialogue: 0,0:08:15.62,0:08:16.78,Default,,0,0,0,,Ату мүмкін емес!
Dialogue: 0,0:08:16.87,0:08:17.87,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:17.95,0:08:19.87,Default,,0,0,0,,Бізді қоршап алды!
Dialogue: 0,0:08:19.95,0:08:21.37,Default,,0,0,0,,Гррр…
Dialogue: 0,0:08:21.45,0:08:22.37,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:08:22.46,0:08:24.37,Default,,0,0,0,,(қайталанатын кесу дыбысы)
Dialogue: 0,0:08:26.46,0:08:29.46,Default,,0,0,0,,(Мүшелердің ыңырануы)
Dialogue: 0,0:08:31.38,0:08:32.88,Default,,0,0,0,,Әй, ол тағы да кетті!
Dialogue: 0,0:08:32.97,0:08:33.97,Default,,0,0,0,,(мүшелердің ыңырануы)
Dialogue: 0,0:08:34.05,0:08:35.80,Default,,0,0,0,,Иә! (кесілген дыбыс)
Dialogue: 0,0:08:35.89,0:08:37.05,Default,,0,0,0,,Мына жерде!
Dialogue: 0,0:08:37.14,0:08:39.68,Default,,0,0,0,,Хмм... Мм... Мусаши ше?
Dialogue: 0,0:08:39.76,0:08:40.81,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:41.43,0:08:43.56,Default,,0,0,0,,Сенпай, бұл...
Dialogue: 0,0:08:44.14,0:08:46.65,Default,,0,0,0,,Олар жойылып кетпей ме?
Dialogue: 0,0:08:50.11,0:08:51.86,Default,,0,0,0,,Пайда болу
Dialogue: 0,0:08:51.94,0:08:52.94,Default,,0,0,0,,Қиық сызық
Dialogue: 0,0:08:53.99,0:08:55.61,Default,,0,0,0,,Қатты соққы
Dialogue: 0,0:08:56.20,0:08:58.12,Default,,0,0,0,,біртіндеп жойылады
Dialogue: 0,0:08:59.03,0:09:02.62,Default,,0,0,0,,Мен командирінен айырылып, аяғынан тік тұрған топқа бұрылдым.
Dialogue: 0,0:09:03.37,0:09:06.12,Default,,0,0,0,,Бұл жын толқынының шабуылы
Dialogue: 0,0:09:06.71,0:09:09.13,Default,,0,0,0,,Таңдалған мүшелер
Dialogue: 0,0:09:09.21,0:09:13.13,Default,,0,0,0,,Қаттылық, орнында қалу, қозғала алмау
Dialogue: 0,0:09:13.21,0:09:15.13,Default,,0,0,0,,Қанша адам қаза тапты?
Dialogue: 0,0:09:15.22,0:09:16.88,Default,,0,0,0,,10 адам жынды болды!
Dialogue: 0,0:09:16.97,0:09:18.59,Default,,0,0,0,,Келесі Кім...
Dialogue: 0,0:09:18.68,0:09:20.22,Default,,0,0,0,,Біз...
Dialogue: 0,0:09:20.72,0:09:23.64,Default,,0,0,0,,Мен мұндай шайқасқа үйренбегенмін!
Dialogue: 0,0:09:23.72,0:09:24.89,Default,,0,0,0,,Тарту!
Dialogue: 0,0:09:24.98,0:09:26.19,Default,,0,0,0,,Артқа шегініңдер!
Dialogue: 0,0:09:26.27,0:09:27.65,Default,,0,0,0,,Көліктен алыс болыңыз!
Dialogue: 0,0:09:28.40,0:09:31.48,Default,,0,0,0,,Осы жерде бір адам құсты.
Dialogue: 0,0:09:31.57,0:09:33.65,Default,,0,0,0,,Инспектор Хикоджи Танума
Dialogue: 0,0:09:33.73,0:09:35.49,Default,,0,0,0,,Назар аударыңыз!
Dialogue: 0,0:09:35.57,0:09:39.16,Default,,0,0,0,,Бұдан былай бұл бөлімшеге инспектор Танума жетекшілік етеді!
Dialogue: 0,0:09:39.24,0:09:42.16,Default,,0,0,0,,Танума STAT нөмірі 2 (екі)
Dialogue: 0,0:09:42.24,0:09:43.66,Default,,0,0,0,,Командалық билікке шақыру
Dialogue: 0,0:09:44.25,0:09:46.08,Default,,0,0,0,,1-ден 6-ға дейінгі автомобильдер
Dialogue: 0,0:09:46.16,0:09:47.79,Default,,0,0,0,,Көліктің алдыңғы жағына бұрылыңыз
Dialogue: 0,0:09:47.87,0:09:49.71,Default,,0,0,0,,7-ден 12-ге дейінгі автомобильдер
Dialogue: 0,0:09:49.79,0:09:51.17,Default,,0,0,0,,Ағымдағы орныңыз бойынша ескерту!
Dialogue: 0,0:09:51.25,0:09:54.17,Default,,0,0,0,,STAT қайтадан қозғала бастайды
Dialogue: 0,0:09:54.26,0:09:55.92,Default,,0,0,0,,Көлік құралын тазарту
Dialogue: 0,0:09:56.51,0:09:57.84,Default,,0,0,0,,Алдыңғы және артқы жағынан шымшу!
Dialogue: 0,0:09:57.93,0:09:59.39,Default,,0,0,0,,2 немесе одан да көп адам 1 топ
Dialogue: 0,0:09:59.47,0:10:00.93,Default,,0,0,0,,Алдыңғы және артқы жағынан абай бол!
Dialogue: 0,0:10:01.01,0:10:02.93,Default,,0,0,0,,Аяқтарды көздеңіз!
Dialogue: 0,0:10:03.01,0:10:05.27,Default,,0,0,0,,Тізеден төмен көздеңіз!
Dialogue: 0,0:10:05.35,0:10:06.93,Default,,0,0,0,,- (Мусаши) Идиот - (Танума) Ха!
Dialogue: 0,0:10:07.56,0:10:08.94,Default,,0,0,0,,Сондай-ақ қашып кет
Dialogue: 0,0:10:09.02,0:10:10.94,Default,,0,0,0,,Сондай-ақ жасырады
Dialogue: 0,0:10:11.02,0:10:13.02,Default,,0,0,0,,Егер сіз...
Dialogue: 0,0:10:13.52,0:10:15.94,Default,,0,0,0,,Жоғары! (мүшелердің таңғаларлық дыбыстары)
Dialogue: 0,0:10:16.03,0:10:17.28,Default,,0,0,0,,Кесу!
Dialogue: 0,0:10:18.78,0:10:19.95,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:10:24.58,0:10:25.58,Default,,0,0,0,,Ыстық...
Dialogue: 0,0:10:27.04,0:10:28.46,Default,,0,0,0,,Инспектор Танума!
Dialogue: 0,0:10:29.04,0:10:29.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:30.04,0:10:31.13,Default,,0,0,0,,Қоршамаңыз!
Dialogue: 0,0:10:31.21,0:10:33.21,Default,,0,0,0,,- (Эскадрон) Ішке кірме! -(Эскадрон) Аяқтар!
Dialogue: 0,0:10:33.29,0:10:35.21,Default,,0,0,0,,(мүшелердің шатастырылған дауыстары)
Dialogue: 0,0:10:35.30,0:10:36.21,Default,,0,0,0,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,0:10:36.30,0:10:38.47,Default,,0,0,0,,Уф
Dialogue: 0,0:10:42.60,0:10:44.97,Default,,0,0,0,,STAT сонымен қатар Жапония азаматтары болып табылады
Dialogue: 0,0:10:45.60,0:10:46.97,Default,,0,0,0,,Сондықтан мен түсіндім
Dialogue: 0,0:10:48.02,0:10:50.56,Default,,0,0,0,,Бұл өте жаман!
Dialogue: 0,0:10:52.65,0:10:54.27,Default,,0,0,0,,Қосарлы қолдану
Dialogue: 0,0:10:54.36,0:10:57.32,Default,,0,0,0,,Ресми аты – «Нитен Ичирю»
Dialogue: 0,0:10:57.82,0:10:59.90,Default,,0,0,0,,Сөзсіз барлық уақыттағы ең күшті
Dialogue: 0,0:10:59.99,0:11:01.53,Default,,0,0,0,,Қылыш шеберінің қылышшысы
Dialogue: 0,0:11:01.61,0:11:03.41,Default,,0,0,0,,№1 әскери офицер
Dialogue: 0,0:11:03.49,0:11:05.99,Default,,0,0,0,,Миямото Мусаши ойлап тапқан дейді.
Dialogue: 0,0:11:06.08,0:11:08.08,Default,,0,0,0,,Негізгі түпнұсқа
Dialogue: 0,0:11:15.04,0:11:16.71,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:11:16.80,0:11:19.55,Default,,0,0,0,,- (Танума) Иә? -(1-эскадрон) Толық қаруланған
Dialogue: 0,0:11:19.63,0:11:21.30,Default,,0,0,0,,Сіз не нәрсеге қанағаттанбайсыз?
Dialogue: 0,0:11:21.38,0:11:23.84,Default,,0,0,0,,Қарсыласта бір ғана жапон қылыш бар, солай ма?
Dialogue: 0,0:11:23.93,0:11:27.93,Default,,0,0,0,,Сол бір жапон қылышын кім ұстайды?
Dialogue: 0,0:11:28.02,0:11:29.02,Default,,0,0,0,,Ол ешқашан да болмайды!
Dialogue: 0,0:11:29.77,0:11:33.77,Default,,0,0,0,,Сіз бұған шынымен сенесіз бе? Миямото Мусаши
Dialogue: 0,0:11:33.85,0:11:36.19,Default,,0,0,0,,Сене аласыз ба?
Dialogue: 0,0:11:36.27,0:11:38.15,Default,,0,0,0,,Бұл маңызды емес
Dialogue: 0,0:11:38.23,0:11:41.95,Default,,0,0,0,,Жоғарыдағы адам Миямото Мусаши болса, онда Миямото Мусаши
Dialogue: 0,0:11:42.03,0:11:44.53,Default,,0,0,0,,Линкольн десең, онда Линкольн.
Dialogue: 0,0:11:44.62,0:11:48.29,Default,,0,0,0,,Сіз күмәндансаңыз да, ол сізге көмектеспейді.
Dialogue: 0,0:11:49.12,0:11:52.00,Default,,0,0,0,,Мен қылыш үшін нағыз мылтық қолданамын...
Dialogue: 0,0:11:52.08,0:11:53.79,Default,,0,0,0,,Бұл да бұйрық.
Dialogue: 0,0:11:53.87,0:11:56.29,Default,,0,0,0,,Брондау қажет емес
Dialogue: 0,0:12:04.47,0:12:06.30,Default,,0,0,0,,Сандарды қарастырыңыз...
Dialogue: 0,0:12:06.89,0:12:09.81,Default,,0,0,0,,Ең соңғы және ең қуатты құралдарды пайдалану...
Dialogue: 0,0:12:10.39,0:12:11.81,Default,,0,0,0,,Бірақ сіз қалай ойлайсыз?
Dialogue: 0,0:12:12.56,0:12:15.31,Default,,0,0,0,,Қатты зақым келтіруде
Dialogue: 0,0:12:15.98,0:12:17.06,Default,,0,0,0,,Жау...
Dialogue: 0,0:12:18.52,0:12:21.57,Default,,0,0,0,,Менде әлі бір сызат болған жоқ.
Dialogue: 0,0:12:22.45,0:12:23.57,Default,,0,0,0,,Аматсуса
Dialogue: 0,0:12:24.28,0:12:26.57,Default,,0,0,0,,Миямото Мусаши болса да
Dialogue: 0,0:12:26.66,0:12:28.58,Default,,0,0,0,,Нитен Ичирю
Dialogue: 0,0:12:29.33,0:12:31.08,Default,,0,0,0,,STAT — жапон тілі
Dialogue: 0,0:12:31.66,0:12:35.25,Default,,0,0,0,,Бұл қауіпті, мен тым көп білемін
Dialogue: 0,0:12:36.50,0:12:37.59,Default,,0,0,0,,Міне!
Dialogue: 0,0:12:38.71,0:12:41.67,Default,,0,0,0,,Ол фигураны мен анда-санда көрдім
Dialogue: 0,0:12:42.72,0:12:43.59,Default,,0,0,0,,Бұл шын!
Dialogue: 0,0:12:44.26,0:12:46.59,Default,,0,0,0,,Нағыз Миямото Мусаши!
Dialogue: 0,0:12:46.68,0:12:48.60,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:12:49.47,0:12:53.60,Default,,0,0,0,,Қозғалсаң, сенің немесе басқаның басы ұшып кетеді.
Dialogue: 0,0:12:54.77,0:12:57.86,Default,,0,0,0,,Сол сөздерді енді айтатындар
Dialogue: 0,0:12:57.94,0:13:00.11,Default,,0,0,0,,Бір адам емес
Dialogue: 0,0:13:01.07,0:13:02.11,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:13:02.19,0:13:04.36,Default,,0,0,0,,Басы кім?
Dialogue: 0,0:13:04.45,0:13:06.66,Default,,0,0,0,,Қалжың емес!
Dialogue: 0,0:13:06.74,0:13:09.37,Default,,0,0,0,,Барлық мүшелер куә
Dialogue: 0,0:13:10.37,0:13:15.12,Default,,0,0,0,,Ол пайда болғаннан кейін соңғы бастық екіге бөлінеді.
Dialogue: 0,0:13:17.17,0:13:18.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:18.21,0:13:20.21,Default,,0,0,0,,(мүшелердің дірілдеген тыныстары)
Dialogue: 0,0:13:21.71,0:13:23.05,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:23.71,0:13:25.13,Default,,0,0,0,,Сіз...
Dialogue: 0,0:13:25.84,0:13:27.64,Default,,0,0,0,,Ештеңе істеу мүмкін емес
Dialogue: 0,0:13:28.34,0:13:29.30,Default,,0,0,0,,Соңы!
Dialogue: 0,0:13:29.39,0:13:32.14,Default,,0,0,0,,Көлігіңізге отырыңыз да, дереу шегініңіз!
Dialogue: 0,0:13:32.72,0:13:34.39,Default,,0,0,0,,Қалғандарды өлтіріңіз!
Dialogue: 0,0:13:34.48,0:13:37.39,Default,,0,0,0,,Қарсы шығу себебіне де қарамай
Dialogue: 0,0:13:38.23,0:13:40.90,Default,,0,0,0,,Мен оған қарсы шыққым келмейтін себебімнен басқа ештеңе көрмеймін.
Dialogue: 0,0:13:43.98,0:13:48.36,Default,,0,0,0,,Бұл күннің ең тегіс қозғалысы деп айтылды.
Dialogue: 0,0:13:51.87,0:13:56.54,Default,,0,0,0,,Полиция деп аталатын алып ұйым бар күш-жігерін салып жұмыс істеуде.
Dialogue: 0,0:13:57.12,0:14:00.29,Default,,0,0,0,,Сіз бір адаммен бәсекелесе алмайсыз.
Dialogue: 0,0:14:01.00,0:14:03.30,Default,,0,0,0,,Amatsusae Бұл адам
Dialogue: 0,0:14:03.96,0:14:07.30,Default,,0,0,0,,Ол генетикалық манипуляция арқылы клондалған адам болды.
Dialogue: 0,0:14:07.88,0:14:10.18,Default,,0,0,0,,Amatsusae, бұл клон
Dialogue: 0,0:14:10.26,0:14:13.31,Default,,0,0,0,,Бұл қылышшы Миямото Мусаши болатын.
Dialogue: 0,0:14:13.39,0:14:15.60,Default,,0,0,0,,Барлығы, бұл бәрі—
Dialogue: 0,0:14:15.68,0:14:18.02,Default,,0,0,0,,21 ғасырда Жапонияда не болып жатыр —
Dialogue: 0,0:14:18.10,0:14:20.31,Default,,0,0,0,,Бұл нақты оқиға.
Dialogue: 0,0:14:20.40,0:14:22.77,Default,,0,0,0,,Бұл әлемге белгілі болса не болады?
Dialogue: 0,0:14:22.86,0:14:24.32,Default,,0,0,0,,Елестетіп көріңізші
Dialogue: 0,0:14:25.11,0:14:27.57,Default,,0,0,0,,Әлем бұл жаңалыққа секіреді.
Dialogue: 0,0:14:28.15,0:14:31.07,Default,,0,0,0,,Бұл жаңалыққа әлем күледі!
Dialogue: 0,0:14:31.16,0:14:33.41,Default,,0,0,0,,Әлемнің түкпір-түкпірінен үлкен қобалжулар.
Dialogue: 0,0:14:33.49,0:14:34.83,Default,,0,0,0,,Бұл жаңалыққа!
Dialogue: 0,0:14:35.41,0:14:37.00,Default,,0,0,0,,Түсінікті айтайын
Dialogue: 0,0:14:37.08,0:14:40.33,Default,,0,0,0,,Бұл ұлттық тәртіп мәселесі.
Dialogue: 0,0:14:41.04,0:14:42.59,Default,,0,0,0,,Біз басқамыз
Dialogue: 0,0:14:42.67,0:14:45.71,Default,,0,0,0,,Біз мықты адам жасауға тырысамыз!
Dialogue: 0,0:14:50.38,0:14:52.22,Default,,0,0,0,,Жерүсті штабының бастығы
Dialogue: 0,0:14:53.05,0:14:55.14,Default,,0,0,0,,Сіз не істер едіңіз?
Dialogue: 0,0:14:55.22,0:14:57.73,Default,,0,0,0,,Әрине, тапсырыс болса...
Dialogue: 0,0:14:57.81,0:14:59.23,Default,,0,0,0,,Ескі герцог
Dialogue: 0,0:14:59.31,0:15:01.73,Default,,0,0,0,,Белгілі болмауы керек
Dialogue: 0,0:15:02.31,0:15:04.48,Default,,0,0,0,,Өзін-өзі қорғау күштері тым көзге түседі.
Dialogue: 0,0:15:04.57,0:15:07.61,Default,,0,0,0,,Ұлттық билік адамға қарсы тұрады
Dialogue: 0,0:15:07.69,0:15:10.74,Default,,0,0,0,,Мұны ешқашан жұртшылыққа көрсетпеу керек!
Dialogue: 0,0:15:10.82,0:15:12.16,Default,,0,0,0,,салтанатты түрде
Dialogue: 0,0:15:12.24,0:15:14.74,Default,,0,0,0,,Мен мұны өте кішкентай оқиға ретінде аяқтағым келеді.
Dialogue: 0,0:15:14.83,0:15:16.74,Default,,0,0,0,,Сомберли
Dialogue: 0,0:15:17.41,0:15:19.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:22.54,0:15:25.75,Default,,0,0,0,,1 адамның ойында бір нәрсе бар
Dialogue: 0,0:15:26.46,0:15:28.96,Default,,0,0,0,,Қолдың күші теңдесі жоқ
Dialogue: 0,0:15:29.05,0:15:32.76,Default,,0,0,0,,Пышақтарға қарсы иммунитет те толық күтіледі.
Dialogue: 0,0:15:32.84,0:15:34.26,Default,,0,0,0,,Өтінемін, менен сөйлеспеңіз.
Dialogue: 0,0:15:35.26,0:15:36.26,Default,,0,0,0,,Тек...
Dialogue: 0,0:15:37.31,0:15:42.77,Default,,0,0,0,,Қоғамға қарсы деп аталатын жақта тұрған адам.
Dialogue: 0,0:15:42.85,0:15:43.81,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:44.86,0:15:46.52,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:15:46.61,0:15:47.98,Default,,0,0,0,,Уцуми-кун
Dialogue: 0,0:15:48.07,0:15:49.03,Default,,0,0,0,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,0:15:49.61,0:15:51.03,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:15:51.61,0:15:55.45,Default,,0,0,0,,Бұл соғыстан кейінгі қара нарық дәуіріне қайта оралу.
Dialogue: 0,0:16:02.16,0:16:05.92,Default,,0,0,0,,Мен қауесетті естігенмін, бірақ бұлай көп болады деп күтпеп едім...
Dialogue: 0,0:16:06.71,0:16:08.42,Default,,0,0,0,,Қандай көзқарас
Dialogue: 0,0:16:09.25,0:16:10.92,Default,,0,0,0,,Неткен өткір көз!
Dialogue: 0,0:16:11.01,0:16:12.76,Default,,0,0,0,,Бұл баланың көзі ме?
Dialogue: 0,0:16:15.01,0:16:16.64,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:16:17.93,0:16:21.43,Default,,0,0,0,,Мынадай жерге полиция бастығы келіп-кетуі керек.
Dialogue: 0,0:16:25.98,0:16:26.94,Default,,0,0,0,,Ханаяма мырза
Dialogue: 0,0:16:27.73,0:16:31.94,Default,,0,0,0,,Бұл да сіз үшін жаман нәрсе болмауы керек.
Dialogue: 0,0:16:32.61,0:16:33.65,Default,,0,0,0,,Ханаяма мырза
Dialogue: 0,0:16:34.15,0:16:37.95,Default,,0,0,0,,Ел игілігі үшін бар күшіңді салар ма едің?
Dialogue: 0,0:16:38.83,0:16:40.49,Default,,0,0,0,,- (Ханаяма) Эй - (Уцуми) Ах...
Dialogue: 0,0:16:41.08,0:16:43.46,Default,,0,0,0,,Абайсыз сөздерді қолданбау
Dialogue: 0,0:16:45.25,0:16:46.54,Default,,0,0,0,,Ел игілігі үшін…
Dialogue: 0,0:16:47.04,0:16:49.46,Default,,0,0,0,,Якудзамен не істеу керек
Dialogue: 0,0:16:50.46,0:16:52.46,Default,,0,0,0,,Менің де еліңді аяймын.
Dialogue: 0,0:16:54.55,0:16:55.93,Default,,0,0,0,,Уцуми мырза
Dialogue: 0,0:16:56.43,0:16:59.47,Default,,0,0,0,,Ежелден жау болдық.
Dialogue: 0,0:17:00.81,0:17:01.97,Default,,0,0,0,,Ханаяма мырза
Dialogue: 0,0:17:02.60,0:17:06.60,Default,,0,0,0,,«Ел үшін» деген дәмді сөздерді айт.
Dialogue: 0,0:17:06.69,0:17:09.15,Default,,0,0,0,,Сіздің назарыңызды аударуға тырысқан дөрекілік үшін кешірім сұраймын.
Dialogue: 0,0:17:10.65,0:17:11.94,Default,,0,0,0,,Осымен
Dialogue: 0,0:17:18.95,0:17:20.70,Default,,0,0,0,,Терроризмнен айырмашылығы
Dialogue: 0,0:17:20.78,0:17:22.37,Default,,0,0,0,,Психодан айырмашылығы
Dialogue: 0,0:17:22.45,0:17:27.00,Default,,0,0,0,,Бұрын кездескен кез келген түрге қолданылмайды
Dialogue: 0,0:17:27.08,0:17:28.96,Default,,0,0,0,,Түбі жоқ сияқты
Dialogue: 0,0:17:29.46,0:17:33.63,Default,,0,0,0,,Біздің алдымызда құбыжық пайда болды.
Dialogue: 0,0:17:34.21,0:17:37.63,Default,,0,0,0,,Ханаяма мырза, мен мұны қайталап айтқым келеді
Dialogue: 0,0:17:37.72,0:17:40.85,Default,,0,0,0,,Барлық мүмкіндіктерді таусылған бізді алмастыру
Dialogue: 0,0:17:40.93,0:17:44.27,Default,,0,0,0,,Каору Ханаяма елді қорғайды
Dialogue: 0,0:17:44.77,0:17:46.85,Default,,0,0,0,,Арба айдаушы сендерге
Dialogue: 0,0:17:46.94,0:17:50.44,Default,,0,0,0,,Бұл шынымен жаман оқиға болмауы керек.
Dialogue: 0,0:17:50.98,0:17:52.48,Default,,0,0,0,,Уцуми мырза
Dialogue: 0,0:17:53.78,0:17:55.99,Default,,0,0,0,,Бүгін үйге қайтыңыз.
Dialogue: 0,0:17:56.07,0:17:56.90,Default,,0,0,0,,А...
Dialogue: 0,0:17:56.99,0:17:59.66,Default,,0,0,0,,Ол бір түнде толтырылмайды.
Dialogue: 0,0:17:59.74,0:18:04.16,Default,,0,0,0,,Міне, сіз бен біздің арамыздағы алшақтық соншалықты терең.
Dialogue: 0,0:18:06.12,0:18:07.66,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:18:08.33,0:18:10.17,Default,,0,0,0,,Бұл тағы да «ол қазір басталды» сценарийі ме, кіру емтихандарындағыдай?
Dialogue: 0,0:18:10.25,0:18:12.92,Default,,0,0,0,,Бұл ақылсыз ұсыныс болуы мүмкін
Dialogue: 0,0:18:29.31,0:18:30.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:31.77,0:18:33.02,Default,,0,0,0,,Ханаяма мырза
Dialogue: 0,0:18:34.36,0:18:37.28,Default,,0,0,0,,Оцуканы Мусаши өлтірді...
Dialogue: 0,0:18:38.28,0:18:40.70,Default,,0,0,0,,Ол менің жолдасым.
Dialogue: 0,0:18:41.74,0:18:44.28,Default,,0,0,0,,Өз қолыммен кек алдым.
Dialogue: 0,0:18:44.99,0:18:46.50,Default,,0,0,0,,Қобалжыған дұрыс, бірақ...
Dialogue: 0,0:18:47.29,0:18:48.62,Default,,0,0,0,,Хаха...
Dialogue: 0,0:18:48.71,0:18:51.17,Default,,0,0,0,,Мен тіпті бір сызат жасай алмаймын.
Dialogue: 0,0:18:52.54,0:18:54.46,Default,,0,0,0,,Кек алу былай тұрсын... хаха
Dialogue: 0,0:18:56.80,0:18:59.05,Default,,0,0,0,,Шәһидтер тауы...
Dialogue: 0,0:19:06.81,0:19:07.98,Default,,0,0,0,,Ханаяма мырза!
Dialogue: 0,0:19:08.06,0:19:09.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:11.56,0:19:14.19,Default,,0,0,0,,Сіз, полиция бастығы
Dialogue: 0,0:19:14.27,0:19:16.48,Default,,0,0,0,,Одан асып кетпеңіз
Dialogue: 0,0:19:17.07,0:19:18.49,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:19:19.19,0:19:20.99,Default,,0,0,0,,Мен оқиғаны түсінемін.
Dialogue: 0,0:19:21.91,0:19:24.45,Default,,0,0,0,,Үйге барып, ішіңіз.
Dialogue: 0,0:19:29.71,0:19:33.13,Default,,0,0,0,,Сізге қоңырау шалғаным үшін кешіріңіз.
Dialogue: 0,0:19:33.21,0:19:34.88,Default,,0,0,0,,Кизаки-кун
Dialogue: 0,0:19:34.96,0:19:36.09,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:36.92,0:19:39.88,Default,,0,0,0,,Сіз генерал туралы айтып отырсыз ба?
Dialogue: 0,0:19:40.51,0:19:41.68,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:41.76,0:19:44.22,Default,,0,0,0,,Өз бетінше әрекет ету
Dialogue: 0,0:19:44.30,0:19:48.39,Default,,0,0,0,,Бұл жақсы нәрсе, өте Ханаямаға ұқсайды...
Dialogue: 0,0:19:50.98,0:19:52.27,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:19:53.48,0:19:56.23,Default,,0,0,0,,Басқа адам - ең нашар
Dialogue: 0,0:19:56.32,0:19:59.40,Default,,0,0,0,,Менің атым Миямото Мусаши.
Dialogue: 0,0:20:00.69,0:20:02.40,Default,,0,0,0,,Кизаки-кун
Dialogue: 0,0:20:02.49,0:20:06.49,Default,,0,0,0,,Сіз ұлттық үкіметтің зиялысы сияқтысыз.
Dialogue: 0,0:20:06.58,0:20:10.37,Default,,0,0,0,,Кешіріңіз, бірақ мен сіздің академиялық біліміңіз туралы айтып отырмын...
Dialogue: 0,0:20:10.45,0:20:12.12,Default,,0,0,0,,Онда мен тыңдаймын.
Dialogue: 0,0:20:12.21,0:20:14.92,Default,,0,0,0,,Клондау туралы біліміңіз бар ма?
Dialogue: 0,0:20:15.00,0:20:15.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:16.71,0:20:18.92,Default,,0,0,0,,Сіз клонсыз ба?
Dialogue: 0,0:20:22.55,0:20:24.51,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:25.72,0:20:27.89,Default,,0,0,0,,Өзін Мусаши деп атайтын адам...
Dialogue: 0,0:20:27.97,0:20:31.02,Default,,0,0,0,,«Өзін Мусаши деп атайтын адам» емес
Dialogue: 0,0:20:31.10,0:20:31.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:32.02,0:20:33.94,Default,,0,0,0,,Бұл нақты нәрсе.
Dialogue: 0,0:20:36.02,0:20:37.19,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:38.23,0:20:39.19,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:20:40.69,0:20:42.44,Default,,0,0,0,,Сөз жоқ
Dialogue: 0,0:20:42.53,0:20:48.20,Default,,0,0,0,,Бір мағынада, пышақ жарақаты оқиғасы сіздің ерекше патентіңіз болып табылады...
Dialogue: 0,0:20:51.29,0:20:53.41,Default,,0,0,0,,Әр түрлі
Dialogue: 0,0:20:54.04,0:20:55.04,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:55.12,0:20:55.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:56.04,0:20:58.71,Default,,0,0,0,,Қылыш қолына келсек...
Dialogue: 0,0:20:59.21,0:21:00.96,Default,,0,0,0,,Сол кездегідей?
Dialogue: 0,0:21:03.05,0:21:06.55,Default,,0,0,0,,Рецукай патшаны кесіп тастады.
Dialogue: 0,0:21:07.05,0:21:07.89,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:09.01,0:21:09.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:14.77,0:21:15.98,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:21:16.06,0:21:17.73,Default,,0,0,0,,Мен артқы жағын алдым
Dialogue: 0,0:21:18.61,0:21:20.07,Default,,0,0,0,,Қаһарлы...
Dialogue: 0,0:21:20.15,0:21:22.28,Default,,0,0,0,,Шынымен де керемет...
Dialogue: 0,0:21:22.36,0:21:25.24,Default,,0,0,0,,Керемет, тамаша...
Dialogue: 0,0:21:25.82,0:21:27.24,Default,,0,0,0,,Шашырап кетудің алдында тұрғанда...
Dialogue: 0,0:21:28.78,0:21:31.54,Default,,0,0,0,,Кәрі Токугава ханзада осылай деді.
Dialogue: 0,0:21:32.49,0:21:35.00,Default,,0,0,0,,«Екінші тарап өте нашар»
Dialogue: 0,0:21:36.50,0:21:37.62,Default,,0,0,0,,(тамшылаған сұйықтықтың дыбысы)
Dialogue: 0,0:21:39.75,0:21:40.79,Default,,0,0,0,,Жалпы?
Dialogue: 0,0:21:41.84,0:21:42.96,Default,,0,0,0,,(тамшылаған сұйықтықтың дыбысы)
Dialogue: 0,0:21:43.51,0:21:44.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:56.69,0:21:58.02,Default,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:21:59.02,0:22:01.02,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:22:01.11,0:22:05.19,Default,,0,0,0,,Мен жай ғана Сибуядан Синджукуға бара жатыр едім.
Dialogue: 0,0:22:10.37,0:22:12.78,Default,,0,0,0,,Бұл жолақ емес пе?
Dialogue: 0,0:22:12.87,0:22:14.29,Default,,0,0,0,,Міне...
Dialogue: 0,0:22:14.87,0:22:17.71,Default,,0,0,0,,Мен сыпайы амандасуым керек.
Dialogue: 0,0:22:21.75,0:22:23.75,Default,,0,0,0,,♪～
Dialogue: 0,0:23:48.09,0:23:50.05,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.55,0:23:57.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory