Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.01,0:00:13.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.09,0:01:39.09,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.10,0:01:45.10,Default,,0,0,0,,Ежелгі биолог доктор Альберт Пэйн
Dialogue: 0,0:01:43.10,0:01:45.10,Default,,0,0,0,,(камера ысырмасының дыбысы)
Dialogue: 0,0:01:45.10,0:01:46.68,Default,,0,0,0,,Ежелгі биолог доктор Альберт Пэйн
Dialogue: 0,0:01:46.77,0:01:47.77,Default,,0,0,0,,Жапонияға шұғыл сапар
Dialogue: 0,0:01:48.35,0:01:49.77,Default,,0,0,0,,Тұздалған қияр
Dialogue: 0,0:01:50.36,0:01:51.77,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:01:51.86,0:01:54.23,Default,,0,0,0,,олжаға айналған алып мақұлық.
Dialogue: 0,0:01:54.32,0:01:56.28,Default,,0,0,0,,Дәрігердің көзқарасы бойынша қалай?
Dialogue: 0,0:01:56.36,0:01:58.32,Default,,0,0,0,,Алып тіршілік иелері...
Dialogue: 0,0:01:58.40,0:02:01.37,Default,,0,0,0,,Пиклдің көзқарасы бойынша бұл қауіпсіз және қолжетімді тағам.
Dialogue: 0,0:02:01.45,0:02:03.03,Default,,0,0,0,,Ол бейнеленген болуы керек.
Dialogue: 0,0:02:03.12,0:02:06.00,Default,,0,0,0,,Бірде ол көзден ғайып болды.
Dialogue: 0,0:02:06.08,0:02:07.54,Default,,0,0,0,,Мистер Пикл
Dialogue: 0,0:02:07.62,0:02:09.79,Default,,0,0,0,,Уақытыңызды қалай өткіздіңіз деп ойлайсыз?
Dialogue: 0,0:02:10.58,0:02:12.04,Default,,0,0,0,,Канализация
Dialogue: 0,0:02:12.13,0:02:14.13,Default,,0,0,0,,Хмм… канализация…
Dialogue: 0,0:02:16.38,0:02:18.88,Default,,0,0,0,,Елордалық канализация дегеніміз не?
Dialogue: 0,0:02:18.97,0:02:21.55,Default,,0,0,0,,Бұл шын мәнінде тамаша джунгли.
Dialogue: 0,0:02:22.26,0:02:25.39,Default,,0,0,0,,Ыстық суды үздіксіз құю
Dialogue: 0,0:02:25.47,0:02:29.31,Default,,0,0,0,,Жыл бойы қалыпты температура мен ылғалдылық сақталады.
Dialogue: 0,0:02:30.10,0:02:32.77,Default,,0,0,0,,Бір күні мен үй жануарларын еріксіз ұстадым.
Dialogue: 0,0:02:32.86,0:02:35.65,Default,,0,0,0,,Сіз оны байқасаңыз, ол күткеннен де үлкен
Dialogue: 0,0:02:35.73,0:02:37.74,Default,,0,0,0,,Иесі жануарды кәдеге жаратуда қиындыққа тап болды
Dialogue: 0,0:02:37.82,0:02:39.82,Default,,0,0,0,,Канализацияда бір түн
Dialogue: 0,0:02:39.90,0:02:41.53,Default,,0,0,0,,Дегенмен, бар
Dialogue: 0,0:02:41.61,0:02:44.83,Default,,0,0,0,,Бұл үй жануарлары үшін тамаша жұмақ болды.
Dialogue: 0,0:02:45.70,0:02:46.58,Default,,0,0,0,,Крокодил
Dialogue: 0,0:02:47.33,0:02:48.33,Default,,0,0,0,,кесіртке
Dialogue: 0,0:02:49.21,0:02:50.08,Default,,0,0,0,,Тасбақа
Dialogue: 0,0:02:50.83,0:02:51.83,Default,,0,0,0,,Сукунаның саусағы!
Dialogue: 0,0:02:52.42,0:02:57.84,Default,,0,0,0,,Токиода жер астында көптеген тропикалық тіршілік иелері бар.
Dialogue: 0,0:02:57.92,0:03:00.63,Default,,0,0,0,,Жер асты тұрғыны ретінде тұздық
Dialogue: 0,0:03:00.72,0:03:03.34,Default,,0,0,0,,Сіздің ойыңызша, алда не жақсы?
Dialogue: 0,0:03:03.43,0:03:05.85,Default,,0,0,0,,Талқылауды күтудің қажеті жоқ
Dialogue: 0,0:03:05.93,0:03:08.60,Default,,0,0,0,,Ол – адамзатқа мұра
Dialogue: 0,0:03:09.52,0:03:11.14,Default,,0,0,0,,Айтудың қажеті жоқ
Dialogue: 0,0:03:11.23,0:03:13.61,Default,,0,0,0,,Дереу түсіру
Dialogue: 0,0:03:14.19,0:03:16.73,Default,,0,0,0,,Үкімет бұл түсініктемеге мән береді.
Dialogue: 0,0:03:16.82,0:03:18.11,Default,,0,0,0,,Елордалық полиция департаментінің директивасы
Dialogue: 0,0:03:18.69,0:03:21.86,Default,,0,0,0,,Бірден 91 адамнан тұратын ОМОН жасақталды.
Dialogue: 0,0:03:22.70,0:03:24.66,Default,,0,0,0,,Доктор Пейннің басшылығымен
Dialogue: 0,0:03:24.74,0:03:28.37,Default,,0,0,0,,Күткендей... Айтайын дегенім, 5 тонна хлороформ дайындаңыз.
Dialogue: 0,0:03:29.08,0:03:31.87,Default,,0,0,0,,Орталықты тұздықты көру орны ретінде орнатыңыз
Dialogue: 0,0:03:32.87,0:03:35.42,Default,,0,0,0,,1000 метр радиуста 10 орын
Dialogue: 0,0:03:35.50,0:03:37.46,Default,,0,0,0,,Бір уақытта шығарылды
Dialogue: 0,0:03:39.96,0:03:44.68,Default,,0,0,0,,Айналадағы канализация тез арада хлороформмен толтырылды.
Dialogue: 0,0:03:45.76,0:03:47.76,Default,,0,0,0,,- (Офицер) Ей, міне келдік - (Офицер) Жата бер!
Dialogue: 0,0:03:47.85,0:03:48.85,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:03:48.93,0:03:52.73,Default,,0,0,0,,Бұл тұздалған қияр! Бұл тұздалған қияр!
Dialogue: 0,0:03:52.81,0:03:57.02,Default,,0,0,0,,Сенда мен куә болған гоминин Пикл.
Dialogue: 0,0:03:57.11,0:03:59.19,Default,,0,0,0,,Сібір жолбарысын өлімге айналдырыңыз—
Dialogue: 0,0:03:59.28,0:04:01.28,Default,,0,0,0,,Бор кезеңінің ең күшті жауынгері
Dialogue: 0,0:04:01.86,0:04:04.78,Default,,0,0,0,,Мені тасымалдайды. Мен қайда барамын?
Dialogue: 0,0:04:04.86,0:04:06.62,Default,,0,0,0,,Баспасөз өкілдерінің сұрақтарына жауап ретінде
Dialogue: 0,0:04:06.70,0:04:10.33,Default,,0,0,0,,Қатысқандар аузын ашпайды
Dialogue: 0,0:04:11.12,0:04:14.04,Default,,0,0,0,,Бұл... иісі керемет.
Dialogue: 0,0:04:14.12,0:04:17.34,Default,,0,0,0,,Бойы 2 метрден асатын үйсіз
Dialogue: 0,0:04:17.42,0:04:19.80,Default,,0,0,0,,Шығарылатын иіске көмектесу мүмкін емес.
Dialogue: 0,0:04:19.88,0:04:21.59,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:21.67,0:04:23.55,Default,,0,0,0,,Дұрыс айтасыз. Иә...
Dialogue: 0,0:04:24.38,0:04:26.59,Default,,0,0,0,,Әлі де
Dialogue: 0,0:04:26.68,0:04:28.85,Default,,0,0,0,,Қандай тамаша нысан.
Dialogue: 0,0:04:28.93,0:04:32.31,Default,,0,0,0,,Tokyo Skytree 366 метр жер астында
Dialogue: 0,0:04:32.39,0:04:34.98,Default,,0,0,0,,Ағаш басынан 1000 метр
Dialogue: 0,0:04:35.06,0:04:37.69,Default,,0,0,0,,Ресми мекеме болмаса да
Dialogue: 0,0:04:37.77,0:04:38.90,Default,,0,0,0,,Мен әлемдегі ең жақсы болғанымды мақтан тұтамын.
Dialogue: 0,0:04:38.90,0:04:39.32,Default,,0,0,0,,Мен әлемдегі ең жақсы болғанымды мақтан тұтамын.
Dialogue: 0,0:04:38.90,0:04:39.32,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:04:39.32,0:04:40.15,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:04:40.15,0:04:41.57,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:04:40.15,0:04:41.57,Default,,0,0,0,,Әрине
Dialogue: 0,0:04:41.65,0:04:44.20,Default,,0,0,0,,- (Токугава Мицунари) Кеш болды - (Нономура/Ауру) Иә?
Dialogue: 0,0:04:44.70,0:04:45.95,Default,,0,0,0,,Қарт адамдар...
Dialogue: 0,0:04:46.03,0:04:48.57,Default,,0,0,0,,Бұл Миямото Мусаши емес пе?
Dialogue: 0,0:04:48.66,0:04:50.37,Default,,0,0,0,,Әй, кәрі ханзада!
Dialogue: 0,0:04:50.45,0:04:52.83,Default,,0,0,0,,Не? А... мен сені білемін...
Dialogue: 0,0:04:53.62,0:04:57.54,Default,,0,0,0,,Хе... сен канализацияда аң аулап жүрмін дедің бе?
Dialogue: 0,0:04:57.63,0:04:59.38,Default,,0,0,0,,Бірінші рет
Dialogue: 0,0:04:59.46,0:05:04.34,Default,,0,0,0,,Токионың қақ ортасында кім аңшылық өмір сүре алады?
Dialogue: 0,0:05:05.93,0:05:08.59,Default,,0,0,0,,Өте тыныш Мусаши
Dialogue: 0,0:05:09.47,0:05:12.10,Default,,0,0,0,,Бұл әйгілі ме? Бұл адам
Dialogue: 0,0:05:12.18,0:05:15.44,Default,,0,0,0,,Ол бүкіл әлемге танымал атақты адам.
Dialogue: 0,0:05:15.52,0:05:18.60,Default,,0,0,0,,Кейбіреулер оны жер бетіндегі ең күшті дейді.
Dialogue: 0,0:05:19.44,0:05:21.11,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:23.69,0:05:24.86,Default,,0,0,0,,(Қатты соғу дыбысы)
Dialogue: 0,0:05:24.94,0:05:26.61,Default,,0,0,0,,(Таңданған үш дауыс)
Dialogue: 0,0:05:29.53,0:05:30.87,Default,,0,0,0,,Мусаши?
Dialogue: 0,0:05:33.62,0:05:35.71,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:36.21,0:05:39.38,Default,,0,0,0,,Не істеп жатырсың, Мусаши?
Dialogue: 0,0:05:40.04,0:05:41.88,Default,,0,0,0,,Не…
Dialogue: 0,0:05:41.96,0:05:43.63,Default,,0,0,0,,Ақылсыз
Dialogue: 0,0:05:43.71,0:05:45.13,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:05:45.21,0:05:48.47,Default,,0,0,0,,Бетке ұрып жатқанда, осылай болады.
Dialogue: 0,0:05:48.55,0:05:50.14,Default,,0,0,0,,Әлі ұйықтап жатыр
Dialogue: 0,0:05:50.22,0:05:52.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:56.23,0:05:57.64,Default,,0,0,0,,(Таңданған үш дауыс)
Dialogue: 0,0:05:58.52,0:06:00.40,Default,,0,0,0,,Қаншалықты сенімді
Dialogue: 0,0:06:01.61,0:06:04.40,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:06:04.48,0:06:06.53,Default,,0,0,0,,Мен басымды жарып жіберейін деп едім, бірақ
Dialogue: 0,0:06:06.61,0:06:07.90,Default,,0,0,0,,Жүзі өтпейді
Dialogue: 0,0:06:07.99,0:06:09.82,Default,,0,0,0,,Сіз оны кесіп тастадыңыз ба?
Dialogue: 0,0:06:10.32,0:06:11.91,Default,,0,0,0,,Әдемі жалаңаш мойын
Dialogue: 0,0:06:12.66,0:06:16.95,Default,,0,0,0,,Бірде сегунның алдында денесін екіге бөледі.
Dialogue: 0,0:06:17.04,0:06:18.12,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:06:18.21,0:06:22.96,Default,,0,0,0,,Соңғы платформаға дейін кесуге арналған артық күш, оның ішінде 6 қол
Dialogue: 0,0:06:23.04,0:06:25.25,Default,,0,0,0,,«Көрінетін» дауыл
Dialogue: 0,0:06:25.34,0:06:26.96,Default,,0,0,0,,«Күтілгендей» жаңбыр жауды
Dialogue: 0,0:06:28.09,0:06:29.59,Default,,0,0,0,,Экстатикалық
Dialogue: 0,0:06:30.84,0:06:32.01,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:06:32.93,0:06:36.02,Default,,0,0,0,,Юдзиро Ханманың омырау сүйегі кесіліп, есінен танып қалды.
Dialogue: 0,0:06:36.68,0:06:38.27,Default,,0,0,0,,Ал енді тағы –
Dialogue: 0,0:06:38.35,0:06:41.52,Default,,0,0,0,,Пышақты осы адамның мойын сүйегі тоқтатты.
Dialogue: 0,0:06:41.60,0:06:44.52,Default,,0,0,0,,Тамаша ет сарайы
Dialogue: 0,0:06:45.44,0:06:48.03,Default,,0,0,0,,Дұрыс, тұздық.
Dialogue: 0,0:06:48.11,0:06:50.03,Default,,0,0,0,,Оны кескен мен болдым.
Dialogue: 0,0:06:50.11,0:06:52.78,Default,,0,0,0,,Мен өмірімді аяқтаған жоқпын.
Dialogue: 0,0:06:52.87,0:06:54.78,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:54.87,0:06:57.29,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:06:58.16,0:06:59.16,Default,,0,0,0,,Егер шайқаста жеңілсең—
Dialogue: 0,0:07:05.63,0:07:07.05,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:09.63,0:07:11.05,Default,,0,0,0,,(Таңданған екі дауыс)
Dialogue: 0,0:07:11.13,0:07:12.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:13.18,0:07:14.30,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:07:14.39,0:07:18.81,Default,,0,0,0,,Менен кем емес аң.
Dialogue: 0,0:07:18.89,0:07:20.81,Default,,0,0,0,,(Аруған тұздығы)
Dialogue: 0,0:07:21.31,0:07:22.31,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:07:28.53,0:07:29.82,Default,,0,0,0,,(Пиклдің айқайы)
Dialogue: 0,0:07:29.90,0:07:32.24,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:07:37.62,0:07:42.08,Default,,0,0,0,,Менің семсерім қару-жарақты ешбір ерекшелігісіз екіге бөле алады.
Dialogue: 0,0:07:42.67,0:07:45.08,Default,,0,0,0,,Мен оны теріме тиген кезде білдім.
Dialogue: 0,0:07:45.17,0:07:48.67,Default,,0,0,0,,Ет секіретін заттар әртүрлі
Dialogue: 0,0:07:49.21,0:07:52.84,Default,,0,0,0,,Қылыш астындағы мүшелер мен сүйектерге жете алмайды.
Dialogue: 0,0:07:54.22,0:07:55.34,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:07:55.97,0:07:58.35,Default,,0,0,0,,Мен қатты зардап шектім деп ойладым, бірақ
Dialogue: 0,0:07:58.43,0:08:00.85,Default,,0,0,0,,Тек көгерген жер қалды...
Dialogue: 0,0:08:00.93,0:08:02.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:02.60,0:08:04.35,Default,,0,0,0,,Пикле есіне түсті
Dialogue: 0,0:08:04.44,0:08:05.56,Default,,0,0,0,,(Динозавр дыбысы)
Dialogue: 0,0:08:05.65,0:08:06.65,Default,,0,0,0,,Сол жер
Dialogue: 0,0:08:10.86,0:08:13.65,Default,,0,0,0,,Өз салмағыңыздан 100 есе асатын аса ауыр салмақ
Dialogue: 0,0:08:14.57,0:08:16.66,Default,,0,0,0,,Сондай қаһарлы адамдардың ішінде...
Dialogue: 0,0:08:16.74,0:08:17.66,Default,,0,0,0,,(Динозавр дыбысы)
Dialogue: 0,0:08:17.74,0:08:19.62,Default,,0,0,0,,Жиренішті бейбақ болды.
Dialogue: 0,0:08:19.70,0:08:22.16,Default,,0,0,0,,Шағын, бірақ жылдам
Dialogue: 0,0:08:23.16,0:08:24.92,Default,,0,0,0,,Ал ептілік
Dialogue: 0,0:08:25.50,0:08:28.42,Default,,0,0,0,,Бірақ ең қауіптісі – бұл.
Dialogue: 0,0:08:29.59,0:08:31.92,Default,,0,0,0,,Екі аяқтағы анау үлкен тікенектер
Dialogue: 0,0:08:33.76,0:08:35.43,Default,,0,0,0,,Бірнеше рет ауырады
Dialogue: 0,0:08:36.47,0:08:39.43,Default,,0,0,0,,Т.Рекс анда-санда өлексені жинайды.
Dialogue: 0,0:08:40.39,0:08:41.93,Default,,0,0,0,,Бірақ ол басқаша.
Dialogue: 0,0:08:42.81,0:08:46.19,Default,,0,0,0,,Әрқашан сергек, қашанда жауыз...
Dialogue: 0,0:08:47.02,0:08:48.48,Default,,0,0,0,,(қатты айқай)
Dialogue: 0,0:08:48.56,0:08:50.69,Default,,0,0,0,,Тек өте ауыр салмақтағылар
Dialogue: 0,0:08:50.78,0:08:52.74,Default,,0,0,0,,Дау
Dialogue: 0,0:08:53.40,0:08:54.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:55.36,0:08:58.66,Default,,0,0,0,,Мен бір нәрсе туралы ойладым...
Dialogue: 0,0:08:59.16,0:09:01.70,Default,,0,0,0,,Дейонихты атаңыз
Dialogue: 0,0:09:01.79,0:09:03.37,Default,,0,0,0,,Жігіт бұрылады
Dialogue: 0,0:09:07.63,0:09:09.13,Default,,0,0,0,,Эксперимент алаңы
Dialogue: 0,0:09:09.21,0:09:12.34,Default,,0,0,0,,Клон туылғаннан кейін мұнда мотор функциясын қолданып көріңіз
Dialogue: 0,0:09:12.42,0:09:15.34,Default,,0,0,0,,Қабырғалары дуралюминийден, едені резеңкеден жасалған.
Dialogue: 0,0:09:16.13,0:09:17.84,Default,,0,0,0,,Сіз оны осы жерден толық пайдалана аласыз...
Dialogue: 0,0:09:17.93,0:09:19.60,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:09:19.68,0:09:21.68,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:09:21.76,0:09:23.56,Default,,0,0,0,,Менен сұрасаңыз, Мұсаши мырза
Dialogue: 0,0:09:23.64,0:09:26.60,Default,,0,0,0,,Сіз клондау технологиясы арқылы жасалған ғажайыпсыз
Dialogue: 0,0:09:28.94,0:09:30.11,Default,,0,0,0,,Екінші жағынан, маринадталған қияр
Dialogue: 0,0:09:31.15,0:09:34.99,Default,,0,0,0,,Қалыңдығы 1000 метр тас тұз қабатынан қазылған —
Dialogue: 0,0:09:35.07,0:09:38.11,Default,,0,0,0,,Олар бор дәуірінде динозаврларды үнемі жеген дейді.
Dialogue: 0,0:09:38.20,0:09:40.95,Default,,0,0,0,,Сөзсіз ғажайып тіршілік
Dialogue: 0,0:09:42.03,0:09:44.70,Default,,0,0,0,,Бізде енді қате шешім бар.
Dialogue: 0,0:09:44.79,0:09:46.54,Default,,0,0,0,,Ғажайыптардың бірі
Dialogue: 0,0:09:46.62,0:09:49.88,Default,,0,0,0,,Немесе екеуін де жоғалтпақшы.
Dialogue: 0,0:09:50.67,0:09:54.51,Default,,0,0,0,,Қайсысы күшті, Мусаши Миямото ма әлде Пиклель ме?
Dialogue: 0,0:09:54.59,0:09:57.47,Default,,0,0,0,,Сол балалық құмарлықтан
Dialogue: 0,0:09:57.55,0:10:00.89,Default,,0,0,0,,Біз орны толмас нәрседен айырылғалы тұрмыз.
Dialogue: 0,0:10:02.47,0:10:04.64,Default,,0,0,0,,Оян!
Dialogue: 0,0:10:04.72,0:10:07.14,Default,,0,0,0,,Даусыңыз үлкен
Dialogue: 0,0:10:07.23,0:10:09.44,Default,,0,0,0,,Мен оянамын
Dialogue: 0,0:10:09.52,0:10:13.82,Default,,0,0,0,,Сенгоку кезеңінің ең күшті қылышшысы және бор дәуірінің ең күшті жауынгері
Dialogue: 0,0:10:13.90,0:10:16.07,Default,,0,0,0,,Мен сені осында кездестірдім
Dialogue: 0,0:10:17.49,0:10:19.82,Default,,0,0,0,,Қылышшы жыныстың арасында шешім қабылдағысы келеді
Dialogue: 0,0:10:19.91,0:10:22.66,Default,,0,0,0,,Жауынгерлер семсершілерді жегісі келеді
Dialogue: 0,0:10:22.74,0:10:27.00,Default,,0,0,0,,Бізге сол жерде болу бақыты бұйырды.
Dialogue: 0,0:10:27.08,0:10:29.17,Default,,0,0,0,,Көргің келмесе, кет.
Dialogue: 0,0:10:30.04,0:10:34.21,Default,,0,0,0,,Маған бұл «арманды» тоқтатуға рұқсат жоқ!
Dialogue: 0,0:10:34.30,0:10:36.01,Default,,0,0,0,,О...
Dialogue: 0,0:10:37.17,0:10:40.26,Default,,0,0,0,,Азу тістерім де жоқ, тек логикамен күресемін.
Dialogue: 0,0:10:40.34,0:10:42.68,Default,,0,0,0,,Сен мені қартайдым деп ойладың ба?
Dialogue: 0,0:10:42.76,0:10:46.18,Default,,0,0,0,,Токугава мырзаның келе жатқанын естігенде қатты толқыдым.
Dialogue: 0,0:10:46.27,0:10:51.19,Default,,0,0,0,,Бойын деп тұрған мына жағдай ойыма оралды.
Dialogue: 0,0:10:51.27,0:10:53.69,Default,,0,0,0,,Алдын ала ескерту Дәл дұрыс
Dialogue: 0,0:10:54.44,0:10:57.40,Default,,0,0,0,,Менің кіруім мемлекеттік қонақ ретінде қабылданады.
Dialogue: 0,0:10:57.49,0:10:59.70,Default,,0,0,0,,Багаж тексерілмеген.
Dialogue: 0,0:11:01.78,0:11:04.78,Default,,0,0,0,,Енді жекпе-жекті көруді доғар.
Dialogue: 0,0:11:04.87,0:11:06.83,Default,,0,0,0,,Сол күйінде таратыңыз
Dialogue: 0,0:11:06.91,0:11:08.25,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:11:08.33,0:11:10.96,Default,,0,0,0,,Аа... ааа
Dialogue: 0,0:11:19.80,0:11:20.76,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:22.05,0:11:23.97,Default,,0,0,0,,Бұл қысқа түтік пе?
Dialogue: 0,0:11:25.35,0:11:26.22,Default,,0,0,0,,Уф… Ой, жоқ!
Dialogue: 0,0:11:27.26,0:11:28.22,Default,,0,0,0,,(Таңданған екі дауыс)
Dialogue: 0,0:11:28.31,0:11:29.68,Default,,0,0,0,,О!
Dialogue: 0,0:11:35.02,0:11:36.44,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:11:36.52,0:11:38.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:40.28,0:11:43.61,Default,,0,0,0,,Шурикеннен оңай, бірақ жиі соғады
Dialogue: 0,0:11:43.70,0:11:44.70,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:11:45.66,0:11:47.62,Default,,0,0,0,,Бұл «жол» емес.
Dialogue: 0,0:11:49.16,0:11:52.83,Default,,0,0,0,,Пиклмен енді мені ешкім мазаламайды.
Dialogue: 0,0:11:53.42,0:11:55.58,Default,,0,0,0,,Бұл дәмді, I
Dialogue: 0,0:11:56.29,0:11:57.34,Default,,0,0,0,,О...
Dialogue: 0,0:12:00.55,0:12:01.67,Default,,0,0,0,,Қазір
Dialogue: 0,0:12:05.89,0:12:07.30,Default,,0,0,0,,Кесілген
Dialogue: 0,0:12:07.89,0:12:11.31,Default,,0,0,0,,Мусаши Миямото пышақсыз қолмен
Dialogue: 0,0:12:11.93,0:12:14.31,Default,,0,0,0,,Сен мені кесіп тастадың!
Dialogue: 0,0:12:16.15,0:12:19.36,Default,,0,0,0,,Менің есімде анық
Dialogue: 0,0:12:19.44,0:12:24.91,Default,,0,0,0,,Суық пышақ теріме оңай сырғып кетеді.
Dialogue: 0,0:12:24.99,0:12:28.41,Default,,0,0,0,,Май және бұлшықет қабаттарынан еш қиындықсыз өтеді
Dialogue: 0,0:12:28.49,0:12:30.83,Default,,0,0,0,,Күшті сүйектерді кесу
Dialogue: 0,0:12:30.91,0:12:35.04,Default,,0,0,0,,Әлсіз және қарсылықсыз ішкі органдарға жетті
Dialogue: 0,0:12:36.29,0:12:39.46,Default,,0,0,0,,Мен басымнан айырылғандай болдым.
Dialogue: 0,0:12:39.55,0:12:42.47,Default,,0,0,0,,Төгілген қан жылы.
Dialogue: 0,0:12:43.17,0:12:45.72,Default,,0,0,0,,Жарқырап ауаға ұшты
Dialogue: 0,0:12:46.80,0:12:47.72,Default,,0,0,0,,«Ата» деген кім?
Dialogue: 0,0:12:48.89,0:12:50.72,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:12:50.81,0:12:52.48,Default,,0,0,0,,Ми...
Dialogue: 0,0:12:52.56,0:12:56.81,Default,,0,0,0,,37 триллион ұяшық оны таныды
Dialogue: 0,0:12:56.90,0:12:59.98,Default,,0,0,0,,Сол кезде мен өлдім!
Dialogue: 0,0:13:00.07,0:13:02.99,Default,,0,0,0,,(Пиклдің күркіреуі)
Dialogue: 0,0:13:03.07,0:13:05.74,Default,,0,0,0,,Мен оны сілкіп тастауға тырыстым.
Dialogue: 0,0:13:06.28,0:13:07.74,Default,,0,0,0,,Бұл көзқарас
Dialogue: 0,0:13:08.41,0:13:10.83,Default,,0,0,0,,Оның ар жағындағы жауыздықты сеземін
Dialogue: 0,0:13:11.33,0:13:14.75,Default,,0,0,0,,Сол елде жеңілген күшті жаудың пайда болуы
Dialogue: 0,0:13:15.33,0:13:16.75,Default,,0,0,0,,Шайқалған
Dialogue: 0,0:13:16.83,0:13:17.92,Default,,0,0,0,,(Аруған тұздығы)
Dialogue: 0,0:13:21.84,0:13:23.51,Default,,0,0,0,,Шыу!
Dialogue: 0,0:13:27.93,0:13:31.51,Default,,0,0,0,,Көбінесе бұл жай ет, бірақ сүйектері кесілмейді.
Dialogue: 0,0:13:32.89,0:13:34.02,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:13:34.10,0:13:36.02,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:36.69,0:13:37.52,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:39.36,0:13:40.77,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:13:41.36,0:13:42.53,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:43.57,0:13:45.28,Default,,0,0,0,,Ең жақсы жағдайда ет
Dialogue: 0,0:13:46.20,0:13:48.03,Default,,0,0,0,,Мен шығыңқы мүшелерді көрмеймін.
Dialogue: 0,0:13:48.70,0:13:50.45,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:13:52.66,0:13:54.29,Default,,0,0,0,,Ешқайсысына ұқсамайды
Dialogue: 0,0:13:55.79,0:13:56.79,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:13:57.75,0:13:59.75,Default,,0,0,0,,Сіз немен күрестіңіз?
Dialogue: 0,0:14:00.88,0:14:02.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:02.63,0:14:04.51,Default,,0,0,0,,О~
Dialogue: 0,0:14:05.13,0:14:07.05,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:14:07.13,0:14:13.43,Default,,0,0,0,,Тұздаудың артындағы мақтау мен марапаттау
Dialogue: 0,0:14:15.06,0:14:17.31,Default,,0,0,0,,Хмм, бұл үлкен сома.
Dialogue: 0,0:14:18.23,0:14:19.81,Default,,0,0,0,,Мен түсіндім, Пикл.
Dialogue: 0,0:14:19.90,0:14:22.82,Default,,0,0,0,,Бұл жай ғана нәрсе емес, бұл аномалия.
Dialogue: 0,0:14:23.44,0:14:27.07,Default,,0,0,0,,Біздің оғаш пішінде көргеніміз тек өткен шақ емес
Dialogue: 0,0:14:28.03,0:14:29.57,Default,,0,0,0,,Бұл күшті.
Dialogue: 0,0:14:30.20,0:14:32.24,Default,,0,0,0,,Бұл керемет күшті.
Dialogue: 0,0:14:32.32,0:14:34.08,Default,,0,0,0,,Мен сенің күшіңе өте қуаныштымын
Dialogue: 0,0:14:34.66,0:14:36.58,Default,,0,0,0,,Сіздің атақты болғаныңызға қуаныштымын.
Dialogue: 0,0:14:36.66,0:14:39.33,Default,,0,0,0,,Мен осы уақытқа дейін қуаныштымын.
Dialogue: 0,0:14:39.42,0:14:42.54,Default,,0,0,0,,Бұл және сізде ...
Dialogue: 0,0:14:43.42,0:14:46.59,Default,,0,0,0,,Оны тамырымен жұлып, менікі ет
Dialogue: 0,0:14:46.67,0:14:48.34,Default,,0,0,0,,(Таңданған үш дауыс)
Dialogue: 0,0:14:48.92,0:14:49.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:49.93,0:14:52.34,Default,,0,0,0,,(төмен дауыс)
Dialogue: 0,0:14:52.43,0:14:53.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:53.43,0:14:54.47,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:55.43,0:14:58.93,Default,,0,0,0,,Қымбат заттарды алма
Dialogue: 0,0:14:59.02,0:15:01.10,Default,,0,0,0,,Мұны қабылдағанымды қалайсыз ба?
Dialogue: 0,0:15:01.19,0:15:02.86,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:15:06.03,0:15:07.78,Default,,0,0,0,,(Пиклдің айқайы)
Dialogue: 0,0:15:09.45,0:15:10.61,Default,,0,0,0,,(қатты соққы дыбысы)
Dialogue: 0,0:15:11.61,0:15:15.87,Default,,0,0,0,,Кездейсоқ... Бұл кезде екі жақтың да сезімі бір болды.
Dialogue: 0,0:15:15.95,0:15:17.87,Default,,0,0,0,,«ұсталды»
Dialogue: 0,0:15:20.21,0:15:23.21,Default,,0,0,0,,Уау! Біртүрлі төрт қол
Dialogue: 0,0:15:23.29,0:15:24.63,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:15:27.21,0:15:30.34,Default,,0,0,0,,Динозаврлардың ең ұлы кезеңі бор кезеңі.
Dialogue: 0,0:15:30.42,0:15:33.14,Default,,0,0,0,,Ең күшті позицияны алған ұстама күші
Dialogue: 0,0:15:34.09,0:15:39.14,Default,,0,0,0,,Шикі жасыл бамбуктың түйіндерін әп-сәтте талқандайтын ұстағыш күші.
Dialogue: 0,0:15:39.85,0:15:41.89,Default,,0,0,0,,Қайсысы күшті?
Dialogue: 0,0:15:48.23,0:15:51.65,Default,,0,0,0,,О! Не...
Dialogue: 0,0:15:51.74,0:15:53.41,Default,,0,0,0,,Керемет!
Dialogue: 0,0:15:53.49,0:15:55.41,Default,,0,0,0,,(қаспа дыбысы)
Dialogue: 0,0:15:57.49,0:15:58.91,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:15:58.99,0:16:00.16,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:16:00.83,0:16:02.41,Default,,0,0,0,,(Аруған тұздығы)
Dialogue: 0,0:16:02.50,0:16:05.54,Default,,0,0,0,,Ойлап қарасам, мені қатты тартып алды.
Dialogue: 0,0:16:05.63,0:16:06.92,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,0:16:07.71,0:16:09.51,Default,,0,0,0,,Пикль - аңшы
Dialogue: 0,0:16:10.71,0:16:12.42,Default,,0,0,0,,Ұстау – күнделікті өмір
Dialogue: 0,0:16:13.43,0:16:15.43,Default,,0,0,0,,Ұстау кәдімгі нәрсе
Dialogue: 0,0:16:16.51,0:16:18.51,Default,,0,0,0,,Ұстау қалыпты жағдай болды
Dialogue: 0,0:16:18.60,0:16:19.77,Default,,0,0,0,,(Динозавр дыбысы)
Dialogue: 0,0:16:19.85,0:16:23.27,Default,,0,0,0,,Ойланып қарасаңыз, олардың ешқайсысы бір нәрсені ұға алмайды.
Dialogue: 0,0:16:24.19,0:16:26.77,Default,,0,0,0,,Иә, сөзсіз
Dialogue: 0,0:16:28.77,0:16:31.36,Default,,0,0,0,,Мен оларға қалай қараймын
Dialogue: 0,0:16:32.61,0:16:33.78,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:16:34.57,0:16:36.28,Default,,0,0,0,,Мені сүй
Dialogue: 0,0:16:37.87,0:16:38.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:42.62,0:16:43.79,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:16:46.79,0:16:47.79,Default,,0,0,0,,Қазір...
Dialogue: 0,0:16:50.75,0:16:52.63,Default,,0,0,0,,Қарт мырза, қабырға...
Dialogue: 0,0:16:52.72,0:16:53.55,Default,,0,0,0,,Қабырға?
Dialogue: 0,0:16:54.38,0:16:55.97,Default,,0,0,0,,Ойыс
Dialogue: 0,0:16:56.05,0:16:58.35,Default,,0,0,0,,Қалыңдығы 30 см дуралюминий қабырғасы
Dialogue: 0,0:16:58.43,0:16:59.56,Default,,0,0,0,,Ойыс
Dialogue: 0,0:17:00.43,0:17:01.64,Default,,0,0,0,,Сол бір ату.
Dialogue: 0,0:17:02.39,0:17:05.39,Default,,0,0,0,,Қарапайым адам сол кезде бірден өлетін еді.
Dialogue: 0,0:17:05.48,0:17:07.06,Default,,0,0,0,,Яру на
Dialogue: 0,0:17:07.15,0:17:08.61,Default,,0,0,0,,Бұл көне заманнан...
Dialogue: 0,0:17:08.69,0:17:11.65,Default,,0,0,0,,Менің ойымша, бұл заттардың физикалық денесі.
Dialogue: 0,0:17:11.73,0:17:15.65,Default,,0,0,0,,Токугава, осы ойынды өзгерте аласыз ба?
Dialogue: 0,0:17:15.74,0:17:17.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:18.03,0:17:19.41,Default,,0,0,0,,Көрінбейтін қылыш
Dialogue: 0,0:17:20.03,0:17:21.91,Default,,0,0,0,,Сен оны неше рет сермедің?
Dialogue: 0,0:17:22.58,0:17:25.41,Default,,0,0,0,,Әдемі тұздалған ет сарайы
Dialogue: 0,0:17:25.50,0:17:29.42,Default,,0,0,0,,Мен пышақтың бәрін өз етіммен тоқтата алдым.
Dialogue: 0,0:17:30.25,0:17:33.21,Default,,0,0,0,,Сүйектері үзілмеген, ішкі мүшелері сақталған.
Dialogue: 0,0:17:33.30,0:17:35.17,Default,,0,0,0,,Әдемі ет сарайы
Dialogue: 0,0:17:36.09,0:17:37.68,Default,,0,0,0,,Мен негізгі бөлімді пайдаланғым келеді
Dialogue: 0,0:17:37.76,0:17:38.68,Default,,0,0,0,,О!
Dialogue: 0,0:17:44.39,0:17:46.44,Default,,0,0,0,,Қандай физикалық күш...
Dialogue: 0,0:17:47.23,0:17:50.19,Default,,0,0,0,,Жабайы жалаңаш жылқы да мойынсұнғыш келеді.
Dialogue: 0,0:17:51.48,0:17:56.45,Default,,0,0,0,,Алайда, егер бұл бүгінгі маңызды кездесу болса,
Dialogue: 0,0:17:57.24,0:18:00.70,Default,,0,0,0,,Мені жоғары көтеруге әлі күшім бар ма деп ойлаймын...
Dialogue: 0,0:18:02.53,0:18:03.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:03.79,0:18:05.75,Default,,0,0,0,,Бұл... әрине...
Dialogue: 0,0:18:05.83,0:18:09.96,Default,,0,0,0,,Мұсашидің шабуылдарының барлығын өзі жасаған болса...
Dialogue: 0,0:18:12.50,0:18:15.05,Default,,0,0,0,,Сүйекпен тоқтатсам да
Dialogue: 0,0:18:15.13,0:18:16.88,Default,,0,0,0,,Терең терең
Dialogue: 0,0:18:16.97,0:18:21.22,Default,,0,0,0,,Дене қанша қарабайыр болса да, қанды тоқтату мүмкін емес.
Dialogue: 0,0:18:21.30,0:18:22.72,Default,,0,0,0,,Қан жоғалтудан болатын өлім
Dialogue: 0,0:18:23.35,0:18:25.22,Default,,0,0,0,,Сіз оны қолданып көрмейінше білмейсіз
Dialogue: 0,0:18:25.31,0:18:27.23,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:18:27.81,0:18:28.98,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:18:29.06,0:18:31.98,Default,,0,0,0,,Қалай ойлайсыңдар маринадталған қияр не?
Dialogue: 0,0:18:32.06,0:18:35.48,Default,,0,0,0,,Адамзат мұрасы! Әлемнің қазыналары!
Dialogue: 0,0:18:36.19,0:18:38.20,Default,,0,0,0,,Ку... Уау! Нгг...
Dialogue: 0,0:18:40.61,0:18:43.74,Default,,0,0,0,,Кай-сан - Нанбан тұлғасы.
Dialogue: 0,0:18:43.83,0:18:44.79,Default,,0,0,0,,(ауырсыну)
Dialogue: 0,0:18:44.87,0:18:46.50,Default,,0,0,0,,Соңынан қорықпа
Dialogue: 0,0:18:47.20,0:18:49.00,Default,,0,0,0,,Мәндер…
Dialogue: 0,0:18:49.71,0:18:53.00,Default,,0,0,0,,Ғаламды бөлетін құндылықтардың айырмашылығы
Dialogue: 0,0:18:54.59,0:18:58.05,Default,,0,0,0,,Химия бойынша Нобель сыйлығының лауреаты Альберт Пэйн
Dialogue: 0,0:18:58.13,0:19:01.01,Default,,0,0,0,,Бұл температура айырмашылығына қарсы дәлел табылмады.
Dialogue: 0,0:19:01.09,0:19:04.51,Default,,0,0,0,,Кейде Токугаваның сұрағысы келетін нәрсесі болады.
Dialogue: 0,0:19:05.22,0:19:08.77,Default,,0,0,0,,Менің сүйікті қылышым әлі қалды ма?
Dialogue: 0,0:19:08.85,0:19:11.02,Default,,0,0,0,,Иә? Хехе...
Dialogue: 0,0:19:11.98,0:19:14.69,Default,,0,0,0,,Мумей Канешиге
Dialogue: 0,0:19:14.77,0:19:17.53,Default,,0,0,0,,Хиго елінде ұйықтау
Dialogue: 0,0:19:18.36,0:19:22.36,Default,,0,0,0,,Барлығына көрсеткім келетін сирек өткірлік
Dialogue: 0,0:19:22.87,0:19:25.53,Default,,0,0,0,,Миямото Мусаши Пиклге қарсы
Dialogue: 0,0:19:25.62,0:19:27.83,Default,,0,0,0,,Сіз қаруды қолдана аласыз...
Dialogue: 0,0:19:28.37,0:19:29.87,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:19:37.75,0:19:39.55,Default,,0,0,0,,Өтірікке толы
Dialogue: 0,0:19:40.05,0:19:43.14,Default,,0,0,0,,«Хикикомори!» сияқты бірдеңе айтыңыз.
Dialogue: 0,0:19:43.22,0:19:47.51,Default,,0,0,0,,Терінің керілуі, бұлшық еттерінің биіктігі, жұдырық көлемі
Dialogue: 0,0:19:47.60,0:19:49.22,Default,,0,0,0,,Бұл бұрынғыдан да көп.
Dialogue: 0,0:19:49.31,0:19:50.89,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:52.73,0:19:55.15,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:19:55.23,0:19:56.36,Default,,0,0,0,,Қазір бұрынғыдан да көп
Dialogue: 0,0:19:56.44,0:19:59.23,Default,,0,0,0,,Оның жаттығып жатқанының белгілері бар, бірақ бұл рас.
Dialogue: 0,0:20:01.24,0:20:03.24,Default,,0,0,0,,Бұл тыныштандырады
Dialogue: 0,0:20:03.99,0:20:05.99,Default,,0,0,0,,Жоғалтқандар бірін-бірі мақтайды
Dialogue: 0,0:20:06.07,0:20:07.99,Default,,0,0,0,,Неге жасырып жатырсың?
Dialogue: 0,0:20:08.08,0:20:11.62,Default,,0,0,0,,Бірін-бірі мақтау жағдайды жақсартса, бір-біріңді табанды түрде мадақтаңдар.
Dialogue: 0,0:20:12.21,0:20:13.37,Default,,0,0,0,,Өте жақсы екен. Хахаха.
Dialogue: 0,0:20:13.46,0:20:14.88,Default,,0,0,0,,- (Баки) Ах - (Соло) А?
Dialogue: 0,0:20:15.75,0:20:18.13,Default,,0,0,0,,Сіз де дәл осылай айтқыңыз келетініне сенімдімін.
Dialogue: 0,0:20:19.09,0:20:20.38,Default,,0,0,0,,Өзара өлім
Dialogue: 0,0:20:21.13,0:20:22.97,Default,,0,0,0,,Сынақ матч емес
Dialogue: 0,0:20:23.05,0:20:25.89,Default,,0,0,0,,Нәтижесі шыққанда біріміз жоқ боламыз.
Dialogue: 0,0:20:26.68,0:20:29.64,Default,,0,0,0,,Бірін-бірі сынаудың орнына бірін-бірі өлтіру
Dialogue: 0,0:20:30.27,0:20:31.10,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:32.68,0:20:34.90,Default,,0,0,0,,Жарайды ма? Жай ғана орында.
Dialogue: 0,0:20:35.48,0:20:38.15,Default,,0,0,0,,Эй, сен істедің!
Dialogue: 0,0:20:38.23,0:20:41.15,Default,,0,0,0,,Иә, мен жасадым.
Dialogue: 0,0:20:41.24,0:20:43.53,Default,,0,0,0,,Өте адал
Dialogue: 0,0:20:44.53,0:20:47.66,Default,,0,0,0,,Бұл өзіңе жақсы, ал Мусаши жақсы емес деп ойлайсың ба?
Dialogue: 0,0:20:50.62,0:20:53.16,Default,,0,0,0,,Бұл адам ауыр емес.
Dialogue: 0,0:20:53.91,0:20:55.17,Default,,0,0,0,,Хо
Dialogue: 0,0:20:55.25,0:20:56.33,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:57.17,0:21:00.46,Default,,0,0,0,,Байыпты болу керек, Бақи.
Dialogue: 0,0:21:00.55,0:21:02.42,Default,,0,0,0,,Ол таза болуы керек пе?
Dialogue: 0,0:21:04.26,0:21:07.26,Default,,0,0,0,,Бұл сызық Миямото Мусаши сияқты!
Dialogue: 0,0:21:07.34,0:21:08.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:08.26,0:21:11.18,Default,,0,0,0,,Ұялмаңыз...
Dialogue: 0,0:21:12.18,0:21:14.27,Default,,0,0,0,,Әкем айтты
Dialogue: 0,0:21:15.56,0:21:18.23,Default,,0,0,0,,Ол ауа арқылы құлады
Dialogue: 0,0:21:18.31,0:21:20.23,Default,,0,0,0,,- (Мусаши) Жарайды ма? Алтын – (Мұсаши) керек пе? Тазалық
Dialogue: 0,0:21:20.32,0:21:22.15,Default,,0,0,0,,- (Мұсаши) Маған мақтау керек... - (Мұсаши) Жоғары көтерілгім келеді!
Dialogue: 0,0:21:22.23,0:21:25.11,Default,,0,0,0,,Мен жүгіре алмаймын немесе тығылғым келеді!
Dialogue: 0,0:21:25.20,0:21:27.36,Default,,0,0,0,,Сіз мұны айттыңыз ба?
Dialogue: 0,0:21:28.24,0:21:30.12,Default,,0,0,0,,Бұл сергітеді.
Dialogue: 0,0:21:30.20,0:21:31.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:36.71,0:21:37.87,Default,,0,0,0,,Баки
Dialogue: 0,0:21:37.96,0:21:41.88,Default,,0,0,0,,Тіпті атақ-даңқ сезімі де сонша...
Dialogue: 0,0:21:41.96,0:21:43.88,Default,,0,0,0,,Төңкерілу?
Dialogue: 0,0:21:43.96,0:21:45.38,Default,,0,0,0,,Зұлымдар Альянсы мен Шие Хачисай-кай арасында жақсы ынтымақтастық жоқ —
Dialogue: 0,0:21:46.30,0:21:47.63,Default,,0,0,0,,Міне, Бақи.
Dialogue: 0,0:21:48.26,0:21:50.64,Default,,0,0,0,,Хаос болса да, шыдамдылық таныту керек.
Dialogue: 0,0:21:50.72,0:21:53.39,Default,,0,0,0,,Мөлдірлік сезімі бар Момона
Dialogue: 0,0:21:53.47,0:21:56.23,Default,,0,0,0,,Сонымен... солай ма?
Dialogue: 0,0:21:57.23,0:22:00.15,Default,,0,0,0,,Ол таза.
Dialogue: 0,0:22:00.23,0:22:01.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:02.90,0:22:05.15,Default,,0,0,0,,Қазір қызық болып барады.
Dialogue: 0,0:22:05.86,0:22:09.41,Default,,0,0,0,,Мен қаталмын, бірақ жүрегім сәбидей маринадталған.
Dialogue: 0,0:22:10.16,0:22:15.16,Default,,0,0,0,,Миямото Мусаши, тазалыққа жету дәрежесіне дейін толығымен зайырлы болды.
Dialogue: 0,0:22:15.79,0:22:19.08,Default,,0,0,0,,Тазалықтың шайқасы, Бақи.
Dialogue: 0,0:22:19.17,0:22:20.71,Default,,0,0,0,,Ах... хаха
Dialogue: 0,0:22:21.21,0:22:23.21,Default,,0,0,0,,♪～
Dialogue: 0,0:23:48.46,0:23:50.47,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.97,0:23:57.97,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory