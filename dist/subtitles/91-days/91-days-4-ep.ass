Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Сен, бауырым
Dialogue: 0,0:00:07.01,0:00:08.08,Default,,0,0,0,,Неге тоқтамайсың?
Dialogue: 0,0:00:08.08,0:00:11.00,Default,,0,0,0,,Ол осылай шешті.
Dialogue: 0,0:00:11.02,0:00:13.09,Default,,0,0,0,,Менің ойымша, басқа адам Галасияның туысы.
Dialogue: 0,0:00:15.05,0:00:19.02,Default,,0,0,0,,Фио отбасы үшін тіпті ұнатпайтын адаммен бірге.
Dialogue: 0,0:00:20.01,0:00:22.00,Default,,0,0,0,,Эй, тоқта!
Dialogue: 0,0:00:22.00,0:00:23.05,Default,,0,0,0,,Шулы
Dialogue: 0,0:00:26.00,0:00:27.02,Default,,0,0,0,,Фрейт
Dialogue: 0,0:00:27.07,0:00:29.01,Default,,0,0,0,,Ол не дейді?
Dialogue: 0,0:00:29.04,0:00:30.08,Default,,0,0,0,,Мен ойлағандай
Dialogue: 0,0:00:30.00,0:00:35.00,Default,,0,0,0,,Негізгі субтитр Ю✿Гүл тілі және Чинатсу субтитр тобы✿Бірлескен өндіріс
Dialogue: 0,0:00:31.03,0:00:33.00,Default,,0,0,0,,Соңғы кезде сөйлеспей қалдық.
Dialogue: 0,0:00:33.06,0:00:35.05,Default,,0,0,0,,Жасөспірімдік шақ?
Dialogue: 0,0:00:35.08,0:00:38.01,Default,,0,0,0,,Менің ойымша, шаш тез өсе бастайды.
Dialogue: 0,0:00:38.01,0:00:40.07,Default,,0,0,0,,Балалар сендер шынымен ағайындысыңдар ма?
Dialogue: 0,0:00:41.04,0:00:44.03,Default,,0,0,0,,Неліктен біз бұрынғыдай сөйлей алмаймыз?
Dialogue: 0,0:00:47.04,0:00:49.00,Default,,0,0,0,,Бұл оңай болуы керек
Dialogue: 0,0:00:55.00,0:00:57.04,Default,,0,0,0,,Мен көп іше алмасам да
Dialogue: 0,0:00:59.08,0:01:02.06,Default,,0,0,0,,Бұл сіз ойлағаннан да қиын.
Dialogue: 0,0:01:18.08,0:01:20.06,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:01:24.03,0:01:27.02,Default,,0,0,0,,Эй, бір апта болды.
Dialogue: 0,0:01:27.05,0:01:29.03,Default,,0,0,0,,Тағы да ұшайық
Dialogue: 0,0:01:29.03,0:01:30.09,Default,,0,0,0,,Мен сені тағы ұрамын.
Dialogue: 0,0:01:31.04,0:01:33.03,Default,,0,0,0,,Сондықтан тым кеш шығар.
Dialogue: 0,0:01:37.02,0:01:39.04,Default,,0,0,0,,Экономикамыз жақсы болсын
Dialogue: 0,0:03:29.09,0:03:34.09,Default,,0,0,0,,Репатриациядан кейін қайта лекция
Dialogue: 0,0:03:41.04,0:03:42.07,Default,,0,0,0,,Қара өрік
Dialogue: 0,0:03:47.06,0:03:51.00,Default,,0,0,0,,Ей, бұл үлпілдікті бұзбай ма?
Dialogue: 0,0:03:57.09,0:03:59.05,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:03:59.09,0:04:01.08,Default,,0,0,0,,Иә, бұл қалыпты емес.
Dialogue: 0,0:04:01.08,0:04:04.00,Default,,0,0,0,,Жоқ, жоқ, бұл үлпілдек
Dialogue: 0,0:04:05.06,0:04:07.03,Default,,0,0,0,,Бірақ бұл жай құймақ
Dialogue: 0,0:04:07.03,0:04:08.01,Default,,0,0,0,,Гочисусан
Dialogue: 0,0:04:09.02,0:04:10.05,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:04:11.06,0:04:15.01,Default,,0,0,0,,Бұл жерде арзан тұру бар ма?
Dialogue: 0,0:04:15.06,0:04:18.08,Default,,0,0,0,,Одан әрірек жерде Кота деген шағын қала бар.
Dialogue: 0,0:04:19.05,0:04:22.02,Default,,0,0,0,,Осыны көрсеткені үшін біреуге рахмет.
Dialogue: 0,0:04:22.02,0:04:24.03,Default,,0,0,0,,Мен әмиянымды уайымдап жүрмін.
Dialogue: 0,0:04:25.00,0:04:26.06,Default,,0,0,0,,Тек көлікте ұйықтаңыз.
Dialogue: 0,0:04:26.06,0:04:30.05,Default,,0,0,0,,Аяғымды созбасам, ұйықтағым келмейді.
Dialogue: 0,0:04:31.03,0:04:33.09,Default,,0,0,0,,Авто кемпинг туралы не деуге болады?
Dialogue: 0,0:04:33.09,0:04:35.07,Default,,0,0,0,,Сіз шатырларды оңай жалға ала аласыз.
Dialogue: 0,0:04:37.00,0:04:37.50,Default,,0,0,0,,Кеттік
Dialogue: 0,0:04:41.01,0:04:42.02,Default,,0,0,0,,Мерекелік соус
Dialogue: 0,0:04:48.05,0:04:49.09,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:51.07,0:04:55.03,Default,,0,0,0,,Бірдеңе болса, мен сүйкімді қызбен жақсы сапарға барғым келді.
Dialogue: 0,0:05:12.04,0:05:13.05,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:05:13.05,0:05:15.07,Default,,0,0,0,,Мен сені жеңемін, бейбақ.
Dialogue: 0,0:05:20.05,0:05:22.07,Default,,0,0,0,,Міне, сол жақта.
Dialogue: 0,0:05:32.00,0:05:34.03,Default,,0,0,0,,Тоқтау алдында ілінісу болуы мүмкін
Dialogue: 0,0:05:35.04,0:05:37.07,Default,,0,0,0,,Қабылдау сол жақтағы ғимаратта.
Dialogue: 0,0:05:37.07,0:05:39.06,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:05:40.05,0:05:43.00,Default,,0,0,0,,Сау бол, жаман жігіт.
Dialogue: 0,0:05:45.05,0:05:47.07,Default,,0,0,0,,Біздің лагерьге барғанымызға біраз болды.
Dialogue: 0,0:05:48.06,0:05:49.04,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:05:49.04,0:05:50.07,Default,,0,0,0,,Су әкеліңіз
Dialogue: 0,0:06:10.00,0:06:12.01,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:06:16.00,0:06:17.06,Default,,0,0,0,,Үлкен аға алдап жатыр
Dialogue: 0,0:06:22.09,0:06:24.08,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:06:24.08,0:06:25.07,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:25.07,0:06:28.07,Default,,0,0,0,,Оны пиньата деп атайды. Бұл ностальгия.
Dialogue: 0,0:06:54.03,0:06:55.03,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:06:57.06,0:06:58.09,Default,,0,0,0,,Қалағанымызды орындайық
Dialogue: 0,0:06:59.02,0:07:00.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:03.00,0:07:05.01,Default,,0,0,0,,Сүйкімді заттар
Dialogue: 0,0:07:05.01,0:07:08.07,Default,,0,0,0,,Фрейт кішкентай кезінде солай болды ма деп ойлаймын.
Dialogue: 0,0:07:10.03,0:07:11.06,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:12.07,0:07:14.07,Default,,0,0,0,,Сәлем әпке
Dialogue: 0,0:07:18.09,0:07:21.00,Default,,0,0,0,,Иә, барлығы.
Dialogue: 0,0:07:21.00,0:07:25.00,Default,,0,0,0,,Сіз маған бір қызық көрсеткіңіз келген сияқты.
Dialogue: 0,0:07:25.08,0:07:27.07,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:27.07,0:07:28.04,Default,,0,0,0,,Мальта
Dialogue: 0,0:07:28.04,0:07:30.02,Default,,0,0,0,,Допты Мартеге беру
Dialogue: 0,0:07:50.09,0:07:53.08,Default,,0,0,0,,Жүр, кеттік, кеттік
Dialogue: 0,0:08:13.02,0:08:14.09,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:08:15.09,0:08:17.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:20.06,0:08:23.06,Default,,0,0,0,,Нене, бұл аға
Dialogue: 0,0:08:23.06,0:08:25.02,Default,,0,0,0,,Мен үшін не істейсің?
Dialogue: 0,0:08:27.04,0:08:29.01,Default,,0,0,0,,Негізсіз мүмкін емес
Dialogue: 0,0:08:29.04,0:08:32.04,Default,,0,0,0,,Менің ойымша, оның беті қызықсыз және мұңды.
Dialogue: 0,0:08:32.07,0:08:35.07,Default,,0,0,0,,Оның шын мәнінде адамдық ізі жоқ.
Dialogue: 0,0:08:38.04,0:08:39.04,Default,,0,0,0,,Менікі?
Dialogue: 0,0:08:43.01,0:08:45.04,Default,,0,0,0,,Бұл қалта ұрлығы емес.
Dialogue: 0,0:08:47.02,0:08:49.05,Default,,0,0,0,,Эй, тоқта!
Dialogue: 0,0:08:56.06,0:08:58.04,Default,,0,0,0,,Сен Салқын емес
Dialogue: 0,0:08:58.04,0:09:00.02,Default,,0,0,0,,Көңіл көтеру мақсатында пайдаланылады
Dialogue: 0,0:09:02.00,0:09:03.01,Default,,0,0,0,,Бітті
Dialogue: 0,0:09:04.02,0:09:05.02,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:09:05.02,0:09:07.00,Default,,0,0,0,,Бұл қызықты болды
Dialogue: 0,0:09:08.00,0:09:09.06,Default,,0,0,0,,Мен саған мынаны беремін
Dialogue: 0,0:09:12.06,0:09:13.04,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:09:14.01,0:09:14.51,Default,,0,0,0,,Иә
Dialogue: 0,0:09:16.01,0:09:17.05,Default,,0,0,0,,Иә, мен саған мынаны беремін.
Dialogue: 0,0:09:32.04,0:09:35.01,Default,,0,0,0,,Бұл не? Бұл өте тозған, солай емес пе?
Dialogue: 0,0:09:35.09,0:09:38.02,Default,,0,0,0,,Эй, бұл арзан болды, сондықтан жақсы.
Dialogue: 0,0:09:41.08,0:09:44.01,Default,,0,0,0,,Алдымен бір бөлікпен жаттығу.
Dialogue: 0,0:09:44.09,0:09:47.03,Default,,0,0,0,,Айла - қолды жоғары көтермеу.
Dialogue: 0,0:09:48.01,0:09:50.05,Default,,0,0,0,,Ванно менен жақсырақ болды.
Dialogue: 0,0:10:01.00,0:10:02.09,Default,,0,0,0,,Менің он жасымда
Dialogue: 0,0:10:02.09,0:10:06.05,Default,,0,0,0,,Қалаға Александр атты цирк тобы келді.
Dialogue: 0,0:10:07.01,0:10:09.07,Default,,0,0,0,,Мен және Ванно шынымен барғымыз келеді.
Dialogue: 0,0:10:10.02,0:10:12.06,Default,,0,0,0,,Жексенбілік қызметтен шығу
Dialogue: 0,0:10:12.06,0:10:15.04,Default,,0,0,0,,Мен әкемнің әмиянындағы ақшаны ұрлап алдым.
Dialogue: 0,0:10:17.00,0:10:20.03,Default,,0,0,0,,Бірақ әкем оңай білді.
Dialogue: 0,0:10:20.09,0:10:23.07,Default,,0,0,0,,Бетінің пішіні өзгергенше ұрды.
Dialogue: 0,0:10:24.04,0:10:27.03,Default,,0,0,0,,Бірақ бұл қызықты болды
Dialogue: 0,0:10:27.07,0:10:30.08,Default,,0,0,0,,Қалаға ондай ештеңе келмеді.
Dialogue: 0,0:10:31.04,0:10:36.01,Default,,0,0,0,,Сен сияқты біз де біраз уақыт бірге жаттығатынбыз.
Dialogue: 0,0:10:36.04,0:10:39.00,Default,,0,0,0,,Егер мен жынды болсам.
Dialogue: 0,0:10:40.01,0:10:45.02,Default,,0,0,0,,Мен оны Фрейт пен Фиоға көрсеткенімде, олар қатты қуанды.
Dialogue: 0,0:10:45.09,0:10:48.04,Default,,0,0,0,,Мен оңай жалықтым.
Dialogue: 0,0:10:51.09,0:10:53.03,Default,,0,0,0,,Сіз балалар үйінде өстіңіз бе?
Dialogue: 0,0:10:55.02,0:10:58.05,Default,,0,0,0,,Осыдан кейін сіз қарапайым бандитсіз.
Dialogue: 0,0:10:58.05,0:11:00.09,Default,,0,0,0,,Бұл сіздің бұрын болған дағдыңыз ба?
Dialogue: 0,0:11:00.09,0:11:02.02,Default,,0,0,0,,Ол жаман бала.
Dialogue: 0,0:11:03.01,0:11:05.05,Default,,0,0,0,,Әуелгіде бұл жай ғана қол алысу болды.
Dialogue: 0,0:11:05.05,0:11:08.06,Default,,0,0,0,,Енді ойланбастан қолым қозғалады
Dialogue: 0,0:11:12.05,0:11:14.02,Default,,0,0,0,,Алғашқы жұмысыңыз қандай болды?
Dialogue: 0,0:11:17.01,0:11:20.07,Default,,0,0,0,,Мен отбасымның ақшасын ұрлаған жігітті түсіруге бардым.
Dialogue: 0,0:11:20.07,0:11:22.01,Default,,0,0,0,,Бұл он төрт жаста
Dialogue: 0,0:11:22.09,0:11:24.01,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:11:24.05,0:11:26.04,Default,,0,0,0,,деді Рагуса.
Dialogue: 0,0:11:27.09,0:11:30.02,Default,,0,0,0,,Сіз жалғыз емессіз.
Dialogue: 0,0:11:30.02,0:11:32.01,Default,,0,0,0,,Мені қосқанда 4 адам бар.
Dialogue: 0,0:11:34.04,0:11:36.03,Default,,0,0,0,,Бұл жиіркенішті жұмыс болды.
Dialogue: 0,0:11:40.06,0:11:42.00,Default,,0,0,0,,Сен оны өлтірдің бе?
Dialogue: 0,0:11:42.04,0:11:44.07,Default,,0,0,0,,Қозғалысты бірінші жасаған екінші тарап болды.
Dialogue: 0,0:11:45.00,0:11:47.07,Default,,0,0,0,,Мен одан кейін тоқтаймын.
Dialogue: 0,0:11:49.00,0:11:52.02,Default,,0,0,0,,Қашып кеткен баланы атып тастадым.
Dialogue: 0,0:11:53.00,0:11:55.02,Default,,0,0,0,,Бірақ мен мұны істей алмадым
Dialogue: 0,0:11:56.08,0:11:59.04,Default,,0,0,0,,Сол кезде мен...
Dialogue: 0,0:12:03.06,0:12:06.08,Default,,0,0,0,,Содан бері Мушараға келдім.
Dialogue: 0,0:12:07.05,0:12:11.01,Default,,0,0,0,,Енді мен тиынсыз қашқынмын.
Dialogue: 0,0:12:11.01,0:12:14.07,Default,,0,0,0,,Жонглермен де айналыса алатын лагерьші?
Dialogue: 0,0:12:40.02,0:12:42.06,Default,,0,0,0,,Тағы бір адам болды
Dialogue: 0,0:12:51.08,0:12:53.09,Default,,0,0,0,,Сіз мұны міндетті түрде әдейі істеп жатырсыз.
Dialogue: 0,0:12:53.09,0:12:54.09,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:58.06,0:13:01.01,Default,,0,0,0,,Мұнда дүкен жасау кезегіңіз.
Dialogue: 0,0:13:02.03,0:13:03.08,Default,,0,0,0,,Сіз бөтен адамсыз ба?
Dialogue: 0,0:13:04.03,0:13:06.06,Default,,0,0,0,,Өз қылмысыңызды басқа жерде жасаңыз.
Dialogue: 0,0:13:06.06,0:13:08.05,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:13:08.05,0:13:11.05,Default,,0,0,0,,Бұл жерде ерекше ештеңе жоқ сияқты.
Dialogue: 0,0:13:11.09,0:13:15.06,Default,,0,0,0,,Бәрінен де жанармайым таусылды.
Dialogue: 0,0:13:15.06,0:13:17.09,Default,,0,0,0,,Оны бір жерде толықтыра алмаймыз ба?
Dialogue: 0,0:13:18.02,0:13:21.01,Default,,0,0,0,,Тыйым салу туралы заң туралы білесіз бе?
Dialogue: 0,0:13:21.08,0:13:23.06,Default,,0,0,0,,Егер сіз білмесеңіз
Dialogue: 0,0:13:28.08,0:13:31.05,Default,,0,0,0,,Алда дәріханаға барыңыз.
Dialogue: 0,0:13:31.05,0:13:33.05,Default,,0,0,0,,Мен Никтен естідім.
Dialogue: 0,0:13:33.05,0:13:34.04,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:39.03,0:13:41.00,Default,,0,0,0,,Мен темекі шекпеймін
Dialogue: 0,0:13:47.05,0:13:49.03,Default,,0,0,0,,Бұл әмиянның түрі нашар.
Dialogue: 0,0:13:59.02,0:14:01.07,Default,,0,0,0,,Әй, кенет болғаныма кешірім сұраймын.
Dialogue: 0,0:14:01.07,0:14:04.09,Default,,0,0,0,,Маған қол ұшын созсаңыз, риза болар едім.
Dialogue: 0,0:14:10.07,0:14:12.00,Default,,0,0,0,,(JoJo) Дүрбелең шығарма!
Dialogue: 0,0:14:12.00,0:14:13.03,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:14:14.01,0:14:15.01,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:14:18.05,0:14:22.00,Default,,0,0,0,,Иә, мен жаңа ғана Кота деген қалаға келдім.
Dialogue: 0,0:14:22.06,0:14:25.00,Default,,0,0,0,,Бір орында ұзақ тұрмаңыз
Dialogue: 0,0:14:26.04,0:14:28.06,Default,,0,0,0,,Мен жаңа ғана келдім.
Dialogue: 0,0:14:28.06,0:14:32.04,Default,,0,0,0,,Жоқ, сендерді Орко қуып келеді.
Dialogue: 0,0:14:33.02,0:14:35.04,Default,,0,0,0,,Әңгіме Ганзоның сатып алғаны.
Dialogue: 0,0:14:35.04,0:14:37.09,Default,,0,0,0,,Ол Ғолиятқа ұқсайтын үлкен жігіт.
Dialogue: 0,0:14:38.06,0:14:39.08,Default,,0,0,0,,Ғолият?
Dialogue: 0,0:14:39.08,0:14:43.06,Default,,0,0,0,,Ескі өсиеттегі 9 фут 6 дюймдік алып.
Dialogue: 0,0:14:43.09,0:14:46.01,Default,,0,0,0,,Бұл түсіну қиын ұқсастық.
Dialogue: 0,0:14:47.01,0:14:48.08,Default,,0,0,0,,Кем дегенде Киелі кітапты оқыңыз
Dialogue: 0,0:14:49.04,0:14:52.05,Default,,0,0,0,,Шіркеуге баруға бос уақытым жетпей қалды.
Dialogue: 0,0:14:54.04,0:14:57.05,Default,,0,0,0,,Жарайды, үлкенін көрсем, сақ боламын.
Dialogue: 0,0:14:57.05,0:14:58.09,Default,,0,0,0,,Осыдан кейін
Dialogue: 0,0:14:59.08,0:15:02.08,Default,,0,0,0,,Фанго мен Орконың біртүрлі иісі шыға бастады.
Dialogue: 0,0:15:03.05,0:15:04.07,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:15:04.07,0:15:07.08,Default,,0,0,0,,Анау жынды итке жаға салма.
Dialogue: 0,0:15:08.06,0:15:10.06,Default,,0,0,0,,Кез келген иесі
Dialogue: 0,0:15:14.06,0:15:16.04,Default,,0,0,0,,Маған ең қиынын беріңіз
Dialogue: 0,0:15:22.08,0:15:24.07,Default,,0,0,0,,Міне, осындай нәрсе бар ма?
Dialogue: 0,0:15:25.01,0:15:26.03,Default,,0,0,0,,Қайта толтыру
Dialogue: 0,0:15:40.05,0:15:42.01,Default,,0,0,0,,Мына жігіттің аузын жап!
Dialogue: 0,0:15:53.07,0:15:56.03,Default,,0,0,0,,Шерифке үргені үшін айыппұл.
Dialogue: 0,0:16:01.02,0:16:03.09,Default,,0,0,0,,Сапаның қандай түрі?
Dialogue: 0,0:16:16.00,0:16:18.01,Default,,0,0,0,,Саяхатшыны көрдің бе?
Dialogue: 0,0:16:18.01,0:16:20.07,Default,,0,0,0,,Екі жас жігіт.
Dialogue: 0,0:16:20.07,0:16:22.04,Default,,0,0,0,,Ара аралау
Dialogue: 0,0:16:22.04,0:16:25.06,Default,,0,0,0,,Бұл дәріхана. Жіберу.
Dialogue: 0,0:16:27.00,0:16:28.07,Default,,0,0,0,,Сен сияқты біреуге уақытымды босқа жұмсауға уақытым жоқ.
Dialogue: 0,0:16:29.01,0:16:30.04,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:16:57.05,0:16:59.02,Default,,0,0,0,,Жасайық, ағайын.
Dialogue: 0,0:16:59.02,0:17:01.03,Default,,0,0,0,,Мен тағы да жеңдім
Dialogue: 0,0:17:08.02,0:17:09.07,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:17:19.01,0:17:21.00,Default,,0,0,0,,Үлкен Мексика
Dialogue: 0,0:17:21.09,0:17:24.05,Default,,0,0,0,,Сеньор, мен саған біреуін беремін.
Dialogue: 0,0:17:24.09,0:17:26.09,Default,,0,0,0,,Жарайсыңдар, бәс тігулер.
Dialogue: 0,0:17:29.05,0:17:31.00,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:31.07,0:17:33.03,Default,,0,0,0,,Мастық суытады.
Dialogue: 0,0:17:36.05,0:17:38.03,Default,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:17:41.08,0:17:43.02,Default,,0,0,0,,Дайын...
Dialogue: 0,0:17:44.02,0:17:45.06,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:18:12.00,0:18:13.03,Default,,0,0,0,,Бұл жанды.
Dialogue: 0,0:18:13.09,0:18:16.02,Default,,0,0,0,,Қызық енді басталады!
Dialogue: 0,0:18:16.02,0:18:17.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:18:17.02,0:18:20.00,Default,,0,0,0,,Ашық ойнайтын жағдайда емеспіз.
Dialogue: 0,0:18:26.05,0:18:28.08,Default,,0,0,0,,Сенің қызарғаныма мен кінәлімін.
Dialogue: 0,0:18:41.01,0:18:42.02,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:18:46.02,0:18:48.08,Default,,0,0,0,,Тәжірибе лайықты болды. Сендердің міндетің не, көпшілік?
Dialogue: 0,0:18:47.09,0:18:49.07,Default,,0,0,0,,Дәрігер Дәрігерді шақырыңыз
Dialogue: 0,0:18:48.08,0:18:49.07,Default,,0,0,0,,Ах
Dialogue: 0,0:18:50.01,0:18:51.04,Default,,0,0,0,,Оны тез шығарыңыз
Dialogue: 0,0:19:11.01,0:19:16.00,Default,,0,0,0,,Автостоппен жүруге тым ауылдық.
Dialogue: 0,0:19:16.06,0:19:18.00,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:19:18.00,0:19:19.07,Default,,0,0,0,,That's right.
Dialogue: 0,0:19:19.07,0:19:21.01,Default,,0,0,0,,Бұл шынымен келе ме?
Dialogue: 0,0:19:21.05,0:19:22.08,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:19:22.08,0:19:26.02,Default,,0,0,0,,Менің қасымда жүрген итім - шебер Иісшіл.
Dialogue: 0,0:19:45.07,0:19:47.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:47.08,0:19:49.02,Default,,0,0,0,,Консервілер.
Dialogue: 0,0:19:49.02,0:19:50.03,Default,,0,0,0,,Оны көргенде білесің
Dialogue: 0,0:19:50.03,0:19:52.04,Default,,0,0,0,,Ананас тортын да дайындадыңыз ба?
Dialogue: 0,0:19:54.04,0:19:57.06,Default,,0,0,0,,Әй, онымен ойнама, мылтығыңның қамын ойла.
Dialogue: 0,0:19:57.06,0:19:59.00,Default,,0,0,0,,Мен оны көлікте қалдырдым
Dialogue: 0,0:19:59.00,0:20:02.02,Default,,0,0,0,,Ха, мені ұмыт.
Dialogue: 0,0:20:08.01,0:20:09.06,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:20:59.09,0:21:00.08,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:21:06.00,0:21:08.00,Default,,0,0,0,,Келіңдер, келіңдер.
Dialogue: 0,0:21:38.08,0:21:40.07,Default,,0,0,0,,Мен оны сізге қарызға бере алдым.
Dialogue: 0,0:21:40.07,0:21:41.07,Default,,0,0,0,,Не
Dialogue: 0,0:21:42.06,0:21:44.01,Default,,0,0,0,,Не?
Dialogue: 0,0:21:44.01,0:21:46.02,Default,,0,0,0,,Мен сізге дәл қазір көмектестім бе?
Dialogue: 0,0:21:46.07,0:21:48.08,Default,,0,0,0,,Олай десеңіз, менмін
Dialogue: 0,0:21:48.08,0:21:49.06,Default,,0,0,0,,Тоқта
Dialogue: 0,0:21:53.03,0:21:54.08,Default,,0,0,0,,Күте тұрыңыз, біз...
Dialogue: 0,0:21:54.08,0:21:55.07,Default,,0,0,0,,Тоқта
Dialogue: 0,0:21:55.07,0:21:56.07,Default,,0,0,0,,Ол қозғалады.
Dialogue: 0,0:22:01.02,0:22:03.07,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:22:17.04,0:22:18.09,Default,,0,0,0,,Мынау не деген жігіт?
Dialogue: 0,0:22:19.01,0:22:20.05,Default,,0,0,0,,Бұл гориллат.
Dialogue: 0,0:22:20.05,0:22:21.05,Default,,0,0,0,,Горилла?
Dialogue: 0,0:22:21.09,0:22:24.02,Default,,0,0,0,,Тек Киелі кітапты оқы, қария.
Dialogue: 0,0:22:26.01,0:22:29.06,Default,,0,0,0,,Маған қамқор бол, мен жақсы серік боламын.
Dialogue: 0,0:22:37.04,0:22:40.00,Default,,0,0,0,,Бұл таңғы ас, біртүрлі емес пе?
Dialogue: 0,0:22:40.00,0:22:41.04,Default,,0,0,0,,Ақша жоқ
Dialogue: 0,0:22:51.03,0:22:52.05,Default,,0,0,0,,Тәтті
Dialogue: 0,0:22:53.55,0:22:58.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
