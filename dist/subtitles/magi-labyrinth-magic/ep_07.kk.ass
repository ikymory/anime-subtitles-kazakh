Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.88,0:00:36.60,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:00:36.60,0:00:40.00,Default,,0,0,0,,күрсіну…. (М Нандо) Ах...
Dialogue: 0,0:00:41.44,0:00:44.64,Default,,0,0,0,,Нии-чан, менің қарным ашты.
Dialogue: 0,0:00:44.64,0:00:46.74,Default,,0,0,0,,Барбадқа дейін шыдамды болыңыз. →
Dialogue: 0,0:00:48.31,0:00:50.77,Default,,0,0,0,,Ол жерде қазір дөрекі.
Dialogue: 0,0:00:50.77,0:00:54.42,Default,,0,0,0,,Солай болса да, оның алдында тұрған нәрсе болуы керек.
Dialogue: 0,0:00:54.42,0:00:57.79,Default,,0,0,0,,Нии-чан міне осы. (С Нандо) Әй?
Dialogue: 0,0:00:57.79,0:01:01.99,Default,,0,0,0,,Уф….
Dialogue: 0,0:01:01.99,0:01:04.03,Default,,0,0,0,,≫Заза заза (аяқ дыбысы)
Dialogue: 0,0:01:04.03,0:01:06.06,Default,,0,0,0,,Уф! (Л Нандо) Иісі алкоголь сияқты!
Dialogue: 0,0:01:06.06,0:01:08.23,Default,,0,0,0,,Сіз мас екенсіз.
Dialogue: 0,0:01:08.23,0:01:11.05,Default,,0,0,0,,Хмм... Хахаха.
Dialogue: 0,0:01:11.05,0:01:13.05,Default,,0,0,0,,Уф….
Dialogue: 0,0:01:14.59,0:02:42.37,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:45.11,0:02:48.58,Default,,0,0,0,,Әй, Мол мырза туған қаласына кемеге отырғалы жатыр→
Dialogue: 0,0:02:48.58,0:02:51.65,Default,,0,0,0,,Сіз Барбадқа барасыз, солай ма? иә.
Dialogue: 0,0:02:51.65,0:02:55.72,Default,,0,0,0,,Сондай-ақ, мен әрқашан сізбен кездескім келеді →
Dialogue: 0,0:02:55.72,0:02:58.08,Default,,0,0,0,,Сізге және Alibaba компаниясына →
Dialogue: 0,0:02:58.08,0:03:02.10,Default,,0,0,0,,Мен сізге алғыс айтқым келді. Рақмет сізге?
Dialogue: 0,0:03:02.10,0:03:05.57,Default,,0,0,0,,Маған тегін болашақ сыйлағаныңыз үшін рахмет→
Dialogue: 0,0:03:05.57,0:03:07.67,Default,,0,0,0,,Мен шынымен ризамын.
Dialogue: 0,0:03:07.67,0:03:09.84,Default,,0,0,0,,Рахмет сізге Аладдин.
Dialogue: 0,0:03:09.84,0:03:12.29,Default,,0,0,0,,А... тоқтаңыз, Мол мырза.
Dialogue: 0,0:03:12.29,0:03:14.51,Default,,0,0,0,,Мен де, бірақ Алибаба-кун да, рахмет →
Dialogue: 0,0:03:14.51,0:03:16.61,Default,,0,0,0,,Менің ойымша, бұл сізге қажет емес деп айтасыз.
Dialogue: 0,0:03:16.61,0:03:19.01,Default,,0,0,0,,Не? Өйткені Alibaba-kun →
Dialogue: 0,0:03:19.01,0:03:22.07,Default,,0,0,0,,Өйткені ол сондай мейірімді адам.
Dialogue: 0,0:03:22.07,0:03:24.84,Default,,0,0,0,,Хехе. Aa~a →
Dialogue: 0,0:03:24.84,0:03:28.37,Default,,0,0,0,,Мен де жақын арада Алибаба-кунмен кездескім келеді.
Dialogue: 0,0:03:28.37,0:03:31.43,Default,,0,0,0,,Осы жолмен жүрсең менімен жолығасың.
Dialogue: 0,0:03:31.43,0:03:35.93,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:35.93,0:03:37.93,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:03:43.74,0:03:45.74,Default,,0,0,0,,Ах.
Dialogue: 0,0:03:50.61,0:03:52.65,Default,,0,0,0,,Сәлем балалар.
Dialogue: 0,0:03:52.65,0:03:54.65,Default,,0,0,0,,Бүгін ауа-райы жақсы.
Dialogue: 0,0:03:56.72,0:03:59.34,Default,,0,0,0,,Ах! Мол-сан, бұл қауіпті! Қайтыңыз!
Dialogue: 0,0:03:59.34,0:04:01.82,Default,,0,0,0,,Жарайды. Мұны маған қалдырыңыз!
Dialogue: 0,0:04:01.82,0:04:04.19,Default,,0,0,0,,Бұл құбыжық болуы мүмкін! О, жоқ... бұл дұрыс емес.
Dialogue: 0,0:04:04.19,0:04:06.69,Default,,0,0,0,,Түсінді. Мен жасаймын! Мені тыңда.
Dialogue: 0,0:04:08.16,0:04:11.40,Default,,0,0,0,,Рахмет саған, Аладдин, киіміңді қарызға бергенің үшін. →
Dialogue: 0,0:04:11.40,0:04:14.75,Default,,0,0,0,,Менің атым Шин. Барбадқа барар жолда →
Dialogue: 0,0:04:14.75,0:04:16.81,Default,,0,0,0,,Мені ұры тонап кетті.
Dialogue: 0,0:04:16.81,0:04:19.62,Default,,0,0,0,,Мен көремін. Кешіріңіз, ағай.
Dialogue: 0,0:04:19.62,0:04:22.03,Default,,0,0,0,,Сәлеметсіз бе, бұл шөлді кесіп өткендіктен→
Dialogue: 0,0:04:22.03,0:04:24.71,Default,,0,0,0,,Сіз қауіпті нәрселерге сезімтал болып бара жатқан сияқтысыз.
Dialogue: 0,0:04:24.71,0:04:27.67,Default,,0,0,0,,Хмм~ Сіз шөлді кесіп өттіңіз бе?
Dialogue: 0,0:04:27.67,0:04:31.59,Default,,0,0,0,,Солтүстік Тяньзан үстіртінен келіп, Орталық шөлді кесіп өтті.
Dialogue: 0,0:04:31.59,0:04:34.44,Default,,0,0,0,,Сирек кездесетін өсімдіктер мен тіршілік иелері көп болды.
Dialogue: 0,0:04:34.44,0:04:36.47,Default,,0,0,0,,Маған ұнайды.
Dialogue: 0,0:04:36.47,0:04:38.64,Default,,0,0,0,,Белгісіз жерлер мен білімге тап болу→
Dialogue: 0,0:04:38.64,0:04:41.05,Default,,0,0,0,,Сол шаттық сезімі. →
Dialogue: 0,0:04:41.05,0:04:44.58,Default,,0,0,0,,Сенім мен жол салу арқылы жинақталған тәжірибе. →
Dialogue: 0,0:04:44.58,0:04:47.55,Default,,0,0,0,,Достармен өмірге қауіп төндіретін байланыс.
Dialogue: 0,0:04:47.55,0:04:50.89,Default,,0,0,0,,Шытырман оқиға жақсы. Бұл шынымен ер адамның романтикасы.
Dialogue: 0,0:04:50.89,0:04:54.01,Default,,0,0,0,,Түсіндім! Сенің сезіміңді түсінемін.
Dialogue: 0,0:04:54.01,0:04:56.80,Default,,0,0,0,,Иә. Және →
Dialogue: 0,0:04:56.80,0:04:59.65,Default,,0,0,0,,Сіздей сүйкімді жас арумен кездесу→
Dialogue: 0,0:04:59.65,0:05:02.65,Default,,0,0,0,,Бұл саяхаттаудың бір қуанышы. Күрсіну….
Dialogue: 0,0:05:07.39,0:05:10.39,Default,,0,0,0,,Сооо... мұхиттың иісі.
Dialogue: 0,0:05:11.76,0:05:14.16,Default,,0,0,0,,Сіз оны сол төбеден өткенде көре аласыз.
Dialogue: 0,0:05:17.32,0:05:20.32,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:05:24.79,0:05:31.68,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:31.68,0:05:34.18,Default,,0,0,0,,Міне... Барбад.
Dialogue: 0,0:05:35.73,0:05:38.29,Default,,0,0,0,,Иә. Бұл портты қаланы астана етіңіз→
Dialogue: 0,0:05:38.29,0:05:41.41,Default,,0,0,0,,Жақын теңіздегі жүздеген үлкенді-кішілі аралдарды біріктіру→
Dialogue: 0,0:05:41.41,0:05:45.06,Default,,0,0,0,,Барбад патшалығы – ұлы теңіз мемлекеті.
Dialogue: 0,0:05:45.06,0:05:52.15,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:52.15,0:05:55.12,Default,,0,0,0,,Бұл ел солтүстіктегі оазистік қалалар тобына жатады→
Dialogue: 0,0:05:55.12,0:06:00.23,Default,,0,0,0,,Солтүстік-шығыста шағын елдер, батыста Партевия және Рейм империясы...→
Dialogue: 0,0:06:00.23,0:06:03.93,Default,,0,0,0,,Ежелден теңіз саудасының орталығы ретінде өркендеді. →
Dialogue: 0,0:06:05.31,0:06:08.05,Default,,0,0,0,,Ұрпақтар бойы Салуджа әулеті деп аталатын корольдік отбасы басқарған→
Dialogue: 0,0:06:08.05,0:06:10.05,Default,,0,0,0,,Мен ставканы көтердім.
Dialogue: 0,0:06:14.59,0:06:35.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:35.59,0:06:37.58,Default,,0,0,0,,«Монархияны құлату»?
Dialogue: 0,0:06:37.58,0:06:41.18,Default,,0,0,0,,Алдыңғы патша дүниеден өткеннен бері ел дүр сілкіндірген сияқты. →
Dialogue: 0,0:06:42.92,0:06:45.19,Default,,0,0,0,,Бірақ сіз мұнда қауіпсізсіз. →
Dialogue: 0,0:06:45.19,0:06:48.79,Default,,0,0,0,,Мен үнемі пайдаланатын елдегі ең сәнді қонақ үй.
Dialogue: 0,0:06:48.79,0:06:50.84,Default,,0,0,0,,Мен тұру ақысын төлеймін.
Dialogue: 0,0:06:50.84,0:06:53.23,Default,,0,0,0,,Бұл жерде қалағаныңызша қала аласыз.
Dialogue: 0,0:06:53.23,0:06:55.70,Default,,0,0,0,,Уау~ Рахмет ағай.
Dialogue: 0,0:06:55.70,0:06:57.73,Default,,0,0,0,,Сіз байсыз, солай емес пе?
Dialogue: 0,0:06:57.73,0:07:00.97,Default,,0,0,0,,Хахаха. Хахахаха!
Dialogue: 0,0:07:00.97,0:07:03.14,Default,,0,0,0,,Не!? Сіз! (Күзетші) Күдікті жігіт!
Dialogue: 0,0:07:03.14,0:07:05.47,Default,,0,0,0,,Не? Менде не күдікті?
Dialogue: 0,0:07:05.47,0:07:08.06,Default,,0,0,0,,Қалай қарасаң да күдікті сияқты!
Dialogue: 0,0:07:08.06,0:07:10.16,Default,,0,0,0,,Міне, сіз. (Жафар) Мүлдем...→
Dialogue: 0,0:07:10.16,0:07:13.58,Default,,0,0,0,,Бұл адам не істеп жатыр? ≪Ол дұрыс киіледі.
Dialogue: 0,0:07:13.58,0:07:16.13,Default,,0,0,0,,күрсіну…. ≪(Күзетші) Сіздің киіміңіз тым кішкентай!
Dialogue: 0,0:07:16.13,0:07:18.80,Default,,0,0,0,,Күте тұрыңыз. (Күзетшілер) А...
Dialogue: 0,0:07:18.80,0:07:22.76,Default,,0,0,0,,Қолайсыздық үшін біздің шебер кешірім сұрайды. →
Dialogue: 0,0:07:22.76,0:07:26.46,Default,,0,0,0,,Иесі айтқандай, тұру шығындарын бізге қалдырыңыз.
Dialogue: 0,0:07:27.86,0:07:29.96,Default,,0,0,0,,Рахмет, қол астындағы қызметкерлерім!
Dialogue: 0,0:07:29.96,0:07:33.47,Default,,0,0,0,,Енді әлгі сұрықсыз кейіпті тез киесің→
Dialogue: 0,0:07:33.47,0:07:37.64,Default,,0,0,0,,Бірдеңе жасаңыз. Ал, Аладдин мен Морджиана.
Dialogue: 0,0:07:37.64,0:07:39.64,Default,,0,0,0,,Кешкі асты бірге ішейік.
Dialogue: 0,0:07:41.13,0:07:43.13,Default,,0,0,0,,Ах.
Dialogue: 0,0:07:45.71,0:07:49.47,Default,,0,0,0,,Сіз таң қалдыңыз ба? Сіз сияқты Фаналис деген не?
Dialogue: 0,0:07:49.47,0:07:53.87,Default,,0,0,0,,күрсіну…. Жақсы, бұл сирек.
Dialogue: 0,0:07:53.87,0:07:56.12,Default,,0,0,0,,Айтпақшы, Шин, болмайды→
Dialogue: 0,0:07:56.12,0:07:58.71,Default,,0,0,0,,Сіздің жүктеріңіздің барлығы ұрланған жоқ, солай ма?
Dialogue: 0,0:07:58.71,0:08:01.35,Default,,0,0,0,,Ол ұрланған.
Dialogue: 0,0:08:01.35,0:08:03.35,Default,,0,0,0,,А... Иә.
Dialogue: 0,0:08:04.77,0:08:07.59,Default,,0,0,0,,Тек киім емес, құрал-сайманның барлық түрі?
Dialogue: 0,0:08:07.59,0:08:09.62,Default,,0,0,0,,Барлығы ұрланған.
Dialogue: 0,0:08:09.62,0:08:13.22,Default,,0,0,0,,А... Оның не екенін ұмыттыңыз ба?
Dialogue: 0,0:08:13.22,0:08:16.23,Default,,0,0,0,,Хахахаха. Жарайды, жарайды. →
Dialogue: 0,0:08:16.23,0:08:19.23,Default,,0,0,0,,Маған қалдырыңыз, мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:08:19.23,0:08:21.68,Default,,0,0,0,,күрсіну. Мүлдем емес…→
Dialogue: 0,0:08:21.68,0:08:24.92,Default,,0,0,0,,Патша екеніңді қашан түсінесің?→
Dialogue: 0,0:08:24.92,0:08:28.12,Default,,0,0,0,,Синдрия мырзам, Синдбад патша.
Dialogue: 0,0:08:30.44,0:08:33.94,Default,,0,0,0,,Уау! Жақсы бөлме екен.
Dialogue: 0,0:08:35.78,0:08:39.60,Default,,0,0,0,,Хэхе! Ахаха хехехе!
Dialogue: 0,0:08:39.60,0:08:41.67,Default,,0,0,0,,Иә, әпке.
Dialogue: 0,0:08:41.67,0:08:45.27,Default,,0,0,0,,Қараңғы континентке баратын кемеге қай жерден жетуге болады?
Dialogue: 0,0:08:45.27,0:08:48.09,Default,,0,0,0,,Қараңғылық? Ah~→
Dialogue: 0,0:08:48.09,0:08:50.55,Default,,0,0,0,,Бұл оңтүстікке қарай бет алған кеме. →
Dialogue: 0,0:08:50.55,0:08:52.71,Default,,0,0,0,,Менің ойымша, қазір қиын болар еді.
Dialogue: 0,0:08:52.71,0:08:55.70,Default,,0,0,0,,Иә? шын мәнінде….
Dialogue: 0,0:08:55.70,0:08:59.42,Default,,0,0,0,,Ши... Синдбад ағай Біраз уақыт өтті.
Dialogue: 0,0:08:59.42,0:09:03.57,Default,,0,0,0,,Сәлемдесудің қажеті жоқ. Менде бір ғана нәрсе бар →
Dialogue: 0,0:09:03.57,0:09:06.51,Default,,0,0,0,,Синдриямен кеме саудасын жалғастыру. →
Dialogue: 0,0:09:06.51,0:09:08.91,Default,,0,0,0,,Әкеңмен бірге не өсірдің →
Dialogue: 0,0:09:08.91,0:09:11.25,Default,,0,0,0,,Сіз біздің екі елдің қарым-қатынасын бұзуға тырысасыз ба?
Dialogue: 0,0:09:11.25,0:09:14.90,Default,,0,0,0,,Мен... Кешіріңіз, бірақ сауданы қайта бастау мүмкін емес. →
Dialogue: 0,0:09:14.90,0:09:17.01,Default,,0,0,0,,Барбадос қазір басты ішкі мәселе болып табылады→
Dialogue: 0,0:09:17.01,0:09:20.31,Default,,0,0,0,,Менің қолым толық. а?
Dialogue: 0,0:09:20.31,0:09:22.89,Default,,0,0,0,,Тұман тобы? иә.
Dialogue: 0,0:09:22.89,0:09:25.53,Default,,0,0,0,,Бұл қалада жиі тұман түседі→
Dialogue: 0,0:09:25.53,0:09:28.23,Default,,0,0,0,,Соңғы уақытта бір топ ұрылар тұманға тығылып жүр→
Dialogue: 0,0:09:28.23,0:09:31.02,Default,,0,0,0,,Ол көріне бастады.
Dialogue: 0,0:09:31.02,0:09:35.19,Default,,0,0,0,,Сен сондай ақымақ болсаң да, екі жыл бұрын сарайдың қазына бөлмесін бұзып кірдің.
Dialogue: 0,0:09:35.19,0:09:38.26,Default,,0,0,0,,Барған сайын үлкейіп барады... Және →
Dialogue: 0,0:09:38.26,0:09:40.71,Default,,0,0,0,,Тіпті жұмбақ сиқырды үйреніңіз→
Dialogue: 0,0:09:40.71,0:09:43.41,Default,,0,0,0,,Ұлттық армия енді бақылауға келмейтін ірі көтерілісші күшке айналды →
Dialogue: 0,0:09:43.41,0:09:45.45,Default,,0,0,0,,Міне солай болды.
Dialogue: 0,0:09:45.45,0:09:47.55,Default,,0,0,0,,Дегенмен, ол негізінен шабуыл жасайды→
Dialogue: 0,0:09:47.55,0:09:51.27,Default,,0,0,0,,Дворянның сарайында немесе елдің сауда кемесіне →
Dialogue: 0,0:09:51.27,0:09:54.16,Default,,0,0,0,,Олар сол жерде ұрлаған ақшалары мен тауарларын бөліседі→
Dialogue: 0,0:09:54.16,0:09:57.13,Default,,0,0,0,,Кейбіреулер оны батыр деп санайды.
Dialogue: 0,0:09:57.13,0:09:59.16,Default,,0,0,0,,Сіз ұрысыз ба?
Dialogue: 0,0:09:59.16,0:10:02.23,Default,,0,0,0,,Ұры дегеніміз не? Ел қазынасына зиянын тигізсе →
Dialogue: 0,0:10:02.23,0:10:06.73,Default,,0,0,0,,Бұл жай ғана салықтарды арттырады. Халық ақымақ.
Dialogue: 0,0:10:08.14,0:10:12.21,Default,,0,0,0,,Балалар, сендер жаман атқа ие болдыңдар. Уф... Менің амалым жоқ!
Dialogue: 0,0:10:12.21,0:10:15.85,Default,,0,0,0,,Соңғы кездері «Тұман бригадасының» бастығы болып бір пысықай жігіт болды.
Dialogue: 0,0:10:15.85,0:10:19.15,Default,,0,0,0,,Ол кісі пайда болғалы бері дүрбелең көп болды→
Dialogue: 0,0:10:19.15,0:10:22.92,Default,,0,0,0,,Ол күшейе түсуде. Жаңа топ...
Dialogue: 0,0:10:22.92,0:10:26.29,Default,,0,0,0,,Иә. Аты - Алибаба. Ах.
Dialogue: 0,0:10:26.29,0:10:28.84,Default,,0,0,0,,Оны жұмбақ Алибаба деп атайды.
Dialogue: 0,0:10:28.84,0:10:30.88,Default,,0,0,0,,Мүлдем... Қазір ше?→
Dialogue: 0,0:10:30.88,0:10:32.91,Default,,0,0,0,,Ол шығып жатыр.
Dialogue: 0,0:10:32.91,0:10:36.48,Default,,0,0,0,,Ағай, бұл туралы... А...
Dialogue: 0,0:10:36.48,0:10:39.60,Default,,0,0,0,,Тыныш! Ал... Қалай болғанда да →
Dialogue: 0,0:10:39.60,0:10:44.18,Default,,0,0,0,,Тұман тобына байланысты сауда мүмкін емес. Қайта іске қосқыңыз келсе →
Dialogue: 0,0:10:44.18,0:10:47.71,Default,,0,0,0,,Қарт өзі бірдеңе жасайды.
Dialogue: 0,0:10:47.71,0:10:51.43,Default,,0,0,0,,О, менің ойымша, біз бұл туралы бірдеңе істей аламыз, солай ма?
Dialogue: 0,0:10:51.43,0:10:53.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:56.10,0:10:58.16,Default,,0,0,0,,Сол тұман тобында менмін→
Dialogue: 0,0:10:58.16,0:11:00.98,Default,,0,0,0,,Мен одан құтыламын. Әскери қажет емес →
Dialogue: 0,0:11:00.98,0:11:03.08,Default,,0,0,0,,Тек біз.
Dialogue: 0,0:11:03.08,0:11:05.08,Default,,0,0,0,,Аа….
Dialogue: 0,0:11:07.22,0:11:11.29,Default,,0,0,0,,Жұмбақ Алибаба. Басқа біреу шығар.
Dialogue: 0,0:11:11.29,0:11:13.59,Default,,0,0,0,,Иә... бұл дұрыс.
Dialogue: 0,0:11:15.07,0:11:18.68,Default,,0,0,0,,Yotto. ≫Гача (терезе дыбысы)
Dialogue: 0,0:11:18.68,0:11:23.38,Default,,0,0,0,,А, мен сенімен жақын арада кездескім келеді, Алибаба-кун.
Dialogue: 0,0:11:24.80,0:11:28.10,Default,,0,0,0,,Амансың ба? Аға. Жақсы. →
Dialogue: 0,0:11:28.10,0:11:31.76,Default,,0,0,0,,Синдриямен сауданы қалпына келтіру бәрібір мүмкін емес→
Dialogue: 0,0:11:31.76,0:11:34.86,Default,,0,0,0,,Тұман бригадасын жеңе алсаңыз, бұл жақсы нәрсе.
Dialogue: 0,0:11:36.26,0:11:39.65,Default,,0,0,0,,Өзіңізді еркін сезініңіз. Барбад мамандығы →
Dialogue: 0,0:11:39.65,0:11:41.98,Default,,0,0,0,,Шөптермен грильде пісірілген Eumera теңіз қарашығы. Апыр-ай!
Dialogue: 0,0:11:41.98,0:11:44.50,Default,,0,0,0,,Ха! Хехе. →
Dialogue: 0,0:11:44.50,0:11:48.04,Default,,0,0,0,,Ойланып қарасам, мен бағыныштымды әлі таныстырған жоқпын. →
Dialogue: 0,0:11:48.04,0:11:51.23,Default,,0,0,0,,Джафар мен Масрур.
Dialogue: 0,0:11:51.23,0:11:55.91,Default,,0,0,0,,Морджиана Бұл жаппай ереже Фаналис.
Dialogue: 0,0:11:55.91,0:11:58.13,Default,,0,0,0,,Иә? Сіз де, солай ма? →
Dialogue: 0,0:11:58.13,0:12:01.07,Default,,0,0,0,,Екеуіміздің көзіміз бірдей.
Dialogue: 0,0:12:01.07,0:12:04.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:04.79,0:12:07.61,Default,,0,0,0,,Сәлеметсіз бе. Ах...
Dialogue: 0,0:12:07.61,0:12:09.64,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:12:09.64,0:12:12.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:12.83,0:12:15.28,Default,,0,0,0,,арқылы не істейсіз? →
Dialogue: 0,0:12:15.28,0:12:18.38,Default,,0,0,0,,Сізде ешқандай құрал болмаса да, осындай арзан мәміле жасадыңыз.
Dialogue: 0,0:12:19.97,0:12:22.37,Default,,0,0,0,,Бұл қандай да бір жолмен жүзеге асады. (Жафар) Эй.
Dialogue: 0,0:12:22.37,0:12:24.71,Default,,0,0,0,,Синдрия құрылған кезде... Бұл өте үлкен.
Dialogue: 0,0:12:24.71,0:12:29.03,Default,,0,0,0,,Марқұм Барбад король маған сауданы үйретті. →
Dialogue: 0,0:12:29.03,0:12:31.07,Default,,0,0,0,,Ол кісі өмірден өтті, бірақ→
Dialogue: 0,0:12:31.07,0:12:33.95,Default,,0,0,0,,Мен сізге үлкен қарыздармын. Мен бұл елді сағынатын боламын →
Dialogue: 0,0:12:33.95,0:12:36.47,Default,,0,0,0,,Мен оны соғыс отына батырмаймын. Пуу (ысқырық дыбысы)
Dialogue: 0,0:12:36.47,0:12:39.66,Default,,0,0,0,,Буу~! Уф! иә?
Dialogue: 0,0:12:39.66,0:12:42.06,Default,,0,0,0,,Уау! →
Dialogue: 0,0:12:42.06,0:12:45.60,Default,,0,0,0,,Аладдин... сен де сиқыршысың ба?
Dialogue: 0,0:12:45.60,0:12:49.62,Default,,0,0,0,,«Mo»? Ағай, сіз басқа магияны білесіз бе?
Dialogue: 0,0:12:49.62,0:12:54.24,Default,,0,0,0,,Ах. Ағай деген кім?
Dialogue: 0,0:12:54.24,0:12:56.34,Default,,0,0,0,,Мен Синдбадпын.
Dialogue: 0,0:12:56.34,0:12:59.78,Default,,0,0,0,,Ах... Хехе.
Dialogue: 0,0:12:59.78,0:13:01.83,Default,,0,0,0,,Иә? иә? →
Dialogue: 0,0:13:01.83,0:13:05.90,Default,,0,0,0,,Сіз білмейсіз бе? Синдбадтың шытырман оқиғалары... білесіз бе.
Dialogue: 0,0:13:05.90,0:13:07.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:09.24,0:13:13.37,Default,,0,0,0,,Хмм! Көптеген саяхаттар мен саяхаттардан кейін →
Dialogue: 0,0:13:13.37,0:13:15.84,Default,,0,0,0,,Әлемнің жеті теңізіндегі шытырман оқиға→
Dialogue: 0,0:13:15.84,0:13:20.88,Default,,0,0,0,,Жеті лабиринтті бағындырып, елін құрған адам. →
Dialogue: 0,0:13:20.88,0:13:24.00,Default,,0,0,0,,Жеті жынның әміршісі, жеті теңіздің патшасы→
Dialogue: 0,0:13:24.00,0:13:26.04,Default,,0,0,0,,Бұл Синдбад.
Dialogue: 0,0:13:26.04,0:13:29.42,Default,,0,0,0,,Сонымен... ғажап... солай емес пе?
Dialogue: 0,0:13:29.42,0:13:32.34,Default,,0,0,0,,А, а... Мен шынымен де түсінбеймін.
Dialogue: 0,0:13:32.34,0:13:34.98,Default,,0,0,0,,Түсінбейсіз бе? Бұл сиқыршы болса да?
Dialogue: 0,0:13:34.98,0:13:37.77,Default,,0,0,0,,Әй, аға, Маги деген не?
Dialogue: 0,0:13:37.77,0:13:41.40,Default,,0,0,0,,Мен әлі өзімді де білмеймін.
Dialogue: 0,0:13:41.40,0:13:44.90,Default,,0,0,0,,Иә... Мен сізге бір нәрсені айта аламын →
Dialogue: 0,0:13:46.32,0:13:48.32,Default,,0,0,0,,Маги осылай білдіреді. →
Dialogue: 0,0:13:49.79,0:13:52.45,Default,,0,0,0,,Джиннің оңай іске асуы үшін жеткілікті→
Dialogue: 0,0:13:52.45,0:13:55.57,Default,,0,0,0,,Сиқырлы қуат шығысы. Сиқыр деген не →
Dialogue: 0,0:13:55.57,0:13:58.50,Default,,0,0,0,,Бұл Рафф өндіретін энергия. →
Dialogue: 0,0:13:58.50,0:14:02.64,Default,,0,0,0,,Қарапайым адам Руфты тек өз ішінде қолдана алады→
Dialogue: 0,0:14:02.64,0:14:05.49,Default,,0,0,0,,Magi басқа Rufus → шығаратын энергияны да жұта алады
Dialogue: 0,0:14:05.49,0:14:07.56,Default,,0,0,0,,Оны шексіз қолдануға болады.
Dialogue: 0,0:14:07.56,0:14:10.75,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:10.75,0:14:13.99,Default,,0,0,0,,Сізді Руфтар жақсы көреді. →
Dialogue: 0,0:14:13.99,0:14:17.39,Default,,0,0,0,,Уау~ Сиқыршылар шынымен де керемет.
Dialogue: 0,0:14:19.32,0:14:21.43,Default,,0,0,0,,Иә. Осындай таңғажайыпқа сен →
Dialogue: 0,0:14:21.43,0:14:24.13,Default,,0,0,0,,Менің сенен бір өтінішім бар. Бұл не?
Dialogue: 0,0:14:24.13,0:14:26.83,Default,,0,0,0,,Осы елде қиындық тудырған ұрыны ұстаңыз→
Dialogue: 0,0:14:26.83,0:14:29.10,Default,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 0,0:14:29.10,0:14:32.17,Default,,0,0,0,,Сәлем! Күте тұрыңыз, Шин. →
Dialogue: 0,0:14:32.17,0:14:34.74,Default,,0,0,0,,Осы балаларды тартқыңыз келе ме?
Dialogue: 0,0:14:34.74,0:14:38.46,Default,,0,0,0,,Неліктен жоқ? Аладдин - сиқыршы. →
Dialogue: 0,0:14:38.46,0:14:41.26,Default,,0,0,0,,Тағдыр таңдайтын қасиет бар. →
Dialogue: 0,0:14:42.96,0:14:45.25,Default,,0,0,0,,Ал енді бізде металл аспаптар→
Dialogue: 0,0:14:45.25,0:14:47.77,Default,,0,0,0,,Тіпті бір емес. (Жафар) Кім кінәлі?
Dialogue: 0,0:14:47.77,0:14:49.77,Default,,0,0,0,,Мол мырза, біз не істеуіміз керек?
Dialogue: 0,0:14:55.44,0:14:59.24,Default,,0,0,0,,Мен қараңғы континентке өткім келеді.
Dialogue: 0,0:15:00.67,0:15:04.49,Default,,0,0,0,,Тұман тобын жеңсем, кеме жүзе ала ма?
Dialogue: 0,0:15:04.49,0:15:06.67,Default,,0,0,0,,Сол үшін келдік.
Dialogue: 0,0:15:06.67,0:15:10.21,Default,,0,0,0,,Онда біз біреуді іздейміз.
Dialogue: 0,0:15:10.21,0:15:13.96,Default,,0,0,0,,Іс ойдағыдай шешілсе, осы елдің патшасынан маған күш беруін өтінемін.→
Dialogue: 0,0:15:13.96,0:15:17.57,Default,,0,0,0,,Маған жақсылық жасай аласыз ба? Оны қолға алайық.
Dialogue: 0,0:15:17.57,0:15:19.60,Default,,0,0,0,,Сіз қалай ойлайсыз? Аладдин.
Dialogue: 0,0:15:19.60,0:15:22.65,Default,,0,0,0,,Иә. Мен мұны істеймін, ұрыларды құртамын.
Dialogue: 0,0:15:22.65,0:15:25.31,Default,,0,0,0,,көремін. Сонымен Аладдин→
Dialogue: 0,0:15:25.31,0:15:28.29,Default,,0,0,0,,Тез стратегия құрастырайық. Иә.
Dialogue: 0,0:15:28.29,0:15:32.16,Default,,0,0,0,,Ал Морджиана, мені қонақ үйде күтіңіз.
Dialogue: 0,0:15:32.16,0:15:35.87,Default,,0,0,0,,Не? Қанша Fanalis →
Dialogue: 0,0:15:35.87,0:15:38.09,Default,,0,0,0,,Мен қыздардың ұрысуына жол бермеймін. →
Dialogue: 0,0:15:38.09,0:15:40.09,Default,,0,0,0,,Енді... Thud!
Dialogue: 0,0:15:42.46,0:15:44.46,Default,,0,0,0,,Мен де күресемін.
Dialogue: 0,0:15:45.98,0:15:48.10,Default,,0,0,0,,Иә….
Dialogue: 0,0:15:48.10,0:15:51.47,Default,,0,0,0,,Тұман тобы бай саудагер Альжаристі көздеп отыр→
Dialogue: 0,0:15:51.47,0:15:53.75,Default,,0,0,0,,Немесе Noble Hardub→
Dialogue: 0,0:15:53.75,0:15:56.32,Default,,0,0,0,,Үйлердің бірі шығар.
Dialogue: 0,0:15:56.32,0:15:58.84,Default,,0,0,0,,Оны қалай айтуға болады? (Джафар) Мұнда басыңыз →
Dialogue: 0,0:15:58.84,0:16:02.21,Default,,0,0,0,,Ұлттық әскердің қозғалысы туралы жалған ақпарат таратқан. →
Dialogue: 0,0:16:02.21,0:16:06.16,Default,,0,0,0,,Тұман бригадасының үкімет ішінде де жанашырлары бар сияқты.
Dialogue: 0,0:16:06.16,0:16:09.10,Default,,0,0,0,,Тіпті үкіметтің ішінде ме? Иә.
Dialogue: 0,0:16:09.10,0:16:11.39,Default,,0,0,0,,Тұман тобы мен елестеткеннен де көп→
Dialogue: 0,0:16:11.39,0:16:13.90,Default,,0,0,0,,Ол ұры ретінде танымал бола бастаған сияқты.
Dialogue: 0,0:16:13.90,0:16:16.79,Default,,0,0,0,,Хмм…. бұл….
Dialogue: 0,0:16:16.79,0:16:18.94,Default,,0,0,0,,Халық қолдаса →
Dialogue: 0,0:16:18.94,0:16:22.44,Default,,0,0,0,,Тұман жолағын түсіру дұрыс па?
Dialogue: 0,0:16:24.58,0:16:27.47,Default,,0,0,0,,Мен дұрыс деп ойлаймын. →
Dialogue: 0,0:16:27.47,0:16:30.29,Default,,0,0,0,,Олар ұрланған ақшаны азаматтарға таратқан→
Dialogue: 0,0:16:30.29,0:16:32.32,Default,,0,0,0,,Қолдау көрсетіледі.
Dialogue: 0,0:16:32.32,0:16:35.39,Default,,0,0,0,,Сондықтан оларды қарақшылар деп атайды. →
Dialogue: 0,0:16:35.39,0:16:37.55,Default,,0,0,0,,Бірақ менің ойымша. →
Dialogue: 0,0:16:37.55,0:16:41.08,Default,,0,0,0,,Бұл қылмысты өзін-өзі ақтау әрекеті →
Dialogue: 0,0:16:41.08,0:16:45.95,Default,,0,0,0,,Әлде бұл жай ғана насихат шығар... →
Dialogue: 0,0:16:45.95,0:16:49.56,Default,,0,0,0,,Мен сондаймын...→
Dialogue: 0,0:16:49.56,0:16:54.61,Default,,0,0,0,,Өзіңіз ойланыңыз және дұрыс деп санайтын жауапты табыңыз. →
Dialogue: 0,0:16:54.61,0:16:59.03,Default,,0,0,0,,Өзіңізге де не жақсы екенін өзіңіз ойлауға бар күшіңізді салыңыз→
Dialogue: 0,0:16:59.03,0:17:02.94,Default,,0,0,0,,Сіздің жауаптарыңызға сеніп, әрекет етуіңізді қалаймын.
Dialogue: 0,0:17:02.94,0:17:06.47,Default,,0,0,0,,Міне осылай мен өзіме жол ойып алдым→
Dialogue: 0,0:17:06.47,0:17:08.47,Default,,0,0,0,,Ал сендер ше?
Dialogue: 0,0:17:11.03,0:17:19.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:19.79,0:17:21.79,Default,,0,0,0,,Тұман шықты. →
Dialogue: 0,0:17:23.24,0:17:26.04,Default,,0,0,0,,Екеуің келгендеріңе қуаныштымын.
Dialogue: 0,0:17:27.53,0:17:32.27,Default,,0,0,0,,Мен ненің дұрыс екенін әлі білмеймін.
Dialogue: 0,0:17:32.27,0:17:34.67,Default,,0,0,0,,Бірақ мен қымбатты досыммен кездескім келеді →
Dialogue: 0,0:17:34.67,0:17:39.17,Default,,0,0,0,,Біз осы уақытқа дейін жеттік. Кездессем бәрін істеймін.
Dialogue: 0,0:17:39.17,0:17:41.46,Default,,0,0,0,,Мен ұрыны да ұстаймын.
Dialogue: 0,0:17:41.46,0:17:44.76,Default,,0,0,0,,Иә. Бұл жақсы жауап.
Dialogue: 0,0:17:44.76,0:17:47.30,Default,,0,0,0,,Мм... ондағы қорғаныс →
Dialogue: 0,0:17:47.30,0:17:50.70,Default,,0,0,0,,Бұл жай ғана Синдбад және басқалар ма?
Dialogue: 0,0:17:50.70,0:17:53.22,Default,,0,0,0,,Уайымдамаңыз. Шіріп кетсе де →
Dialogue: 0,0:17:53.22,0:17:56.94,Default,,0,0,0,,Жеті теңіз билеушісінің екі есімі жай сөз емес.
Dialogue: 0,0:17:56.94,0:17:59.58,Default,,0,0,0,,Ха-ха... Хакушун!
Dialogue: 0,0:17:59.58,0:18:03.00,Default,,0,0,0,,Уф... түнде суық болады. (Масрур) Дұрыс.
Dialogue: 0,0:18:03.00,0:18:05.03,Default,,0,0,0,,Идиот! Қозғалма.
Dialogue: 0,0:18:05.03,0:18:07.08,Default,,0,0,0,,Оны желге қарсы қорғаныс ретінде пайдаланбаңыз.
Dialogue: 0,0:18:07.08,0:18:09.90,Default,,0,0,0,,≪Гача ≪Міне! Сол екі адам! →
Dialogue: 0,0:18:09.90,0:18:12.72,Default,,0,0,0,,Ешқандай араласпа, сақ бол!
Dialogue: 0,0:18:12.72,0:18:16.26,Default,,0,0,0,,Ұлттық армияның көмегі жеткіліксіз болғандықтан, қауіпсіздік қызметінің екі қызметкері ғана →
Dialogue: 0,0:18:16.26,0:18:18.30,Default,,0,0,0,,Мазасыздандым, тіпті тамақ іше де алмаймын!
Dialogue: 0,0:18:18.30,0:18:20.90,Default,,0,0,0,,Сіз тамақтанып жатырсыз. Сіз жақсы жағдайдасыз.
Dialogue: 0,0:18:23.10,0:18:25.14,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:18:25.14,0:18:28.54,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:18:30.12,0:18:32.58,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:18:32.58,0:18:34.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:34.86,0:18:36.90,Default,,0,0,0,,Не деген сұмдық!?
Dialogue: 0,0:18:36.90,0:18:43.29,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:43.29,0:18:45.79,Default,,0,0,0,,Менің кеудем шықпайды. →
Dialogue: 0,0:18:47.11,0:18:51.00,Default,,0,0,0,,Маған тамақ керек...
Dialogue: 0,0:18:51.00,0:18:54.72,Default,,0,0,0,,Жолыма бөгет болсаң... Мен сені өлтіремін!
Dialogue: 0,0:18:54.72,0:18:57.12,Default,,0,0,0,,Уа! Шала иттер?
Dialogue: 0,0:18:57.12,0:19:00.12,Default,,0,0,0,,Тынш! Шш! Мен мұны істеймін, сондықтан кет!
Dialogue: 0,0:19:00.12,0:19:02.16,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:19:02.16,0:19:06.76,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:06.76,0:19:10.87,Default,,0,0,0,,Ах! Мұны істеудің қажеті жоқ.
Dialogue: 0,0:19:10.87,0:19:14.05,Default,,0,0,0,,Дворяндардың байлығы сіздің салықтарыңыздан.
Dialogue: 0,0:19:14.05,0:19:17.04,Default,,0,0,0,,Ах... Төлеуге тұрарлық емес деп ойласаңыз →
Dialogue: 0,0:19:17.04,0:19:19.04,Default,,0,0,0,,Оны қайтаруды сұрауға болады.
Dialogue: 0,0:19:21.13,0:19:23.41,Default,,0,0,0,,Бірақ өз өміріңді алма.
Dialogue: 0,0:19:23.41,0:19:27.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:27.21,0:19:29.77,Default,,0,0,0,,Жарайды ма? Күрсіну…. →
Dialogue: 0,0:19:29.77,0:19:32.52,Default,,0,0,0,,Біз уәде еткен тұман тобы болды→
Dialogue: 0,0:19:32.52,0:19:34.52,Default,,0,0,0,,Бар болғаны суретке түсіру керек.
Dialogue: 0,0:19:36.91,0:19:40.11,Default,,0,0,0,,Бұл ел енді болмауы мүмкін.
Dialogue: 0,0:21:42.55,0:21:44.60,Default,,0,0,0,,Хахаха. Не... күлесің бе?
Dialogue: 0,0:21:44.60,0:21:46.64,Default,,0,0,0,,Хахахаха! Өйткені... бұл бір түрлі...
Dialogue: 0,0:21:46.64,0:21:49.01,Default,,0,0,0,,Джафар мырза, Синдбад мырза және басқалар→
Dialogue: 0,0:21:49.01,0:21:51.04,Default,,0,0,0,,Маған шабуыл жасалды... ≫ (Сарбаздар) Хахахаха! →
Dialogue: 0,0:21:51.04,0:21:53.36,Default,,0,0,0,,≫Хаха! Хахахаха! иә?
Dialogue: 0,0:21:53.36,0:21:56.15,Default,,0,0,0,,Көңілді сияқты. Ах!
Dialogue: 0,0:21:56.15,0:21:58.18,Default,,0,0,0,,Аладдин Сіз бұл тұманмен дем ала алмайсыз!
Dialogue: 0,0:21:58.18,0:22:00.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:00.50,0:22:03.50,Default,,0,0,0,,≪(Солдат) Уау! ≪(Солдат) Келме! →
Dialogue: 0,0:22:03.50,0:22:07.16,Default,,0,0,0,,Ұры! Үлкен армия! не болып жатыр?
Dialogue: 0,0:22:07.16,0:22:11.18,Default,,0,0,0,,Олар қандай да бір галлюцинацияға ұшыраған сияқты.
Dialogue: 0,0:22:11.18,0:22:14.60,Default,,0,0,0,,Сіз байқадыңыз ба? Мына қызыл тұман.
Dialogue: 0,0:22:14.60,0:22:16.63,Default,,0,0,0,,Адамдық шеберлік емес. →
Dialogue: 0,0:22:16.63,0:22:18.99,Default,,0,0,0,,Мысалдың тылсым күші болса керек.
Dialogue: 0,0:22:18.99,0:22:27.56,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:27.56,0:22:30.98,Default,,0,0,0,,Сен бұрынғыдай қорқыныштысың, Зейнеп. →
Dialogue: 0,0:22:30.98,0:22:34.17,Default,,0,0,0,,Сіздің қызыл елес тұман қылышыңыз. Сөйлесуге уақыт болса →
Dialogue: 0,0:22:34.17,0:22:36.80,Default,,0,0,0,,Асығыңыз және сары эрозияға қарсы семсерді қолданыңыз →
Dialogue: 0,0:22:36.80,0:22:40.14,Default,,0,0,0,,Хасан. Ха. Эй, эй.
Dialogue: 0,0:22:40.14,0:22:51.45,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:51.45,0:22:55.17,Default,,0,0,0,,Енді кеттік! Бұл семіз шошқаның сарайы!
Dialogue: 0,0:22:55.17,0:22:57.99,Default,,0,0,0,,Ұялудың қажеті жоқ! (Барлығы) О!
Dialogue: 0,0:22:57.99,0:23:00.03,Default,,0,0,0,,Уау! Уау...
Dialogue: 0,0:23:00.03,0:23:02.03,Default,,0,0,0,,Арх! Жіберу!
Dialogue: 0,0:23:04.10,0:23:06.20,Default,,0,0,0,,Ұлттық армия!? Жоқ.
Dialogue: 0,0:23:06.20,0:23:10.22,Default,,0,0,0,,Алайда, қандай да бір себептермен мен сені тұтқынға аламын.
Dialogue: 0,0:23:10.22,0:23:12.27,Default,,0,0,0,,Сәлем! Ах!
Dialogue: 0,0:23:12.27,0:23:22.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:22.53,0:23:25.54,Default,,0,0,0,,Бұл да... сиқырлы қару...
Dialogue: 0,0:23:25.54,0:23:28.47,Default,,0,0,0,,≪Иә, бұл қара байлаулы тұман қылыш.
Dialogue: 0,0:23:28.47,0:23:31.26,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:31.26,0:23:33.69,Default,,0,0,0,,Сіз бір дюймді жылжыта алмайсыз.
Dialogue: 0,0:23:33.69,0:23:36.86,Default,,0,0,0,,Қасым! Мен достарымды қайтара аламын ба?
Dialogue: 0,0:23:36.86,0:23:38.92,Default,,0,0,0,,Көшбасшының негізгі күші келді!
Dialogue: 0,0:23:38.92,0:23:45.27,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:45.27,0:23:47.31,Default,,0,0,0,,Қасым О, құдайым!
Dialogue: 0,0:23:47.31,0:23:49.34,Default,,0,0,0,,Хмф!
Dialogue: 0,0:23:49.34,0:23:51.75,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:51.75,0:23:54.33,Default,,0,0,0,,Қарғыс атсын... Әйел бәйшешек пе?
Dialogue: 0,0:23:54.33,0:23:57.15,Default,,0,0,0,,Мол мырза! (Беткіленіп) А... Ха!
Dialogue: 0,0:23:57.15,0:23:59.49,Default,,0,0,0,,Ух... Арх! Эй….
Dialogue: 0,0:23:59.49,0:24:01.54,Default,,0,0,0,,А? Қарғыс атсын!
Dialogue: 0,0:24:01.54,0:24:04.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:04.53,0:24:07.23,Default,,0,0,0,,Қазір уақыт. Оны алып, жылжытыңыз!
Dialogue: 0,0:24:07.23,0:24:09.75,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:24:09.75,0:24:13.42,Default,,0,0,0,,≪Мен Alibaba-kun≫ іздеймін
Dialogue: 0,0:24:13.42,0:24:15.45,Default,,0,0,0,,≪Осы мақсатта...≫
Dialogue: 0,0:24:15.45,0:24:17.74,Default,,0,0,0,,Уго-кун! Пух!
Dialogue: 0,0:24:17.74,0:24:19.77,Default,,0,0,0,,Иә? Ах~!
Dialogue: 0,0:24:19.77,0:24:21.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:21.81,0:24:26.01,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:26.01,0:24:28.60,Default,,0,0,0,,Мен сені бұл жерден өткізбеймін!
Dialogue: 0,0:24:28.60,0:24:32.37,Default,,0,0,0,,Да... жоқ. Ондай адаммен... Tsk!
Dialogue: 0,0:24:32.37,0:24:35.86,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:35.86,0:24:37.89,Default,,0,0,0,,Не болды? Досым.
Dialogue: 0,0:24:37.89,0:24:39.94,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:24:39.94,0:24:47.14,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:48.82,0:24:51.27,Default,,0,0,0,,Жүрек соғуы ма?
Dialogue: 0,0:24:51.27,0:24:59.67,Default,,0,0,0,,Докун Докун Докун Докун
Dialogue: 0,0:25:01.83,0:25:03.83,Default,,0,0,0,,Аа….
Dialogue: 0,0:25:09.16,0:25:11.86,Default,,0,0,0,,Alibaba...kun?
Dialogue: 0,0:25:13.54,0:26:07.86,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:12.25,0:26:18.55,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:22.70,0:26:40.20,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:14.57,0:28:16.63,Default,,0,0,0,,Соғыс жеткілікті ме?
Dialogue: 0,0:28:16.63,0:28:20.03,Default,,0,0,0,,Маған неліктен «Туман» тобында екеніңізді айтыңыз.
Dialogue: 0,0:28:23.58,0:28:27.18,Default,,0,0,0,,Мені жалғыз қалдырыңыз. Бұл менің проблемам.
Dialogue: 0,0:30:41.89,0:30:44.31,Default,,0,0,0,,Алдымен жалпы сайлауға көшейік.
Dialogue: 0,0:30:45.88,0:30:48.25,Default,,0,0,0,,Жапонияның қалпына келтіру партиясы және кеше Таййо жоқ партиясы
Dialogue: 0,0:30:49.28,0:30:51.68,Default,,0,0,0,,Қосылу туралы ресми шешім қабылдау туралы
Dialogue: 0,0:30:52.77,0:30:55.45,Default,,0,0,0,,Премьер-министр Нода өзінің бояуын көрсетіп жатса да.
Dialogue: 0,0:30:56.09,0:30:59.24,Default,,0,0,0,,Түстердің араласуынан сұр болып кеткенін сынау, т.б.
Dialogue: 0,0:31:00.74,0:31:05.74,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
