Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.45,0:00:49.66,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:49.66,0:00:51.96,Default,,0,0,0,,≪Қандай зор күш≫
Dialogue: 0,0:00:54.35,0:00:56.39,Default,,0,0,0,,Уго-кун!?
Dialogue: 0,0:00:56.39,0:00:58.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:00.47,0:01:02.88,Default,,0,0,0,,Болды... Уго-кун!
Dialogue: 0,0:01:02.88,0:01:05.15,Default,,0,0,0,,Нашар! Барлығы жүгір!
Dialogue: 0,0:01:05.15,0:01:11.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:11.00,0:01:13.67,Default,,0,0,0,,Догон! Бум!!
Dialogue: 0,0:01:13.67,0:01:21.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:21.59,0:01:23.66,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:01:23.66,0:01:27.50,Default,,0,0,0,,Мол мырза…. Рахмет, бұл пайдалы болды.
Dialogue: 0,0:01:27.50,0:01:29.54,Default,,0,0,0,,А, Тұман труппасындағылардың барлығы ше?
Dialogue: 0,0:01:29.54,0:01:32.24,Default,,0,0,0,,Жарайды. Күрсіну….
Dialogue: 0,0:01:32.24,0:01:36.14,Default,,0,0,0,,Синдбад мырзаның арқасында зардап шеккендер жоқ сияқты.
Dialogue: 0,0:01:36.14,0:01:39.38,Default,,0,0,0,,Өйткені жылдам қоңырау арқылы барлығы тез қашып құтыла алды.
Dialogue: 0,0:01:39.38,0:01:41.38,Default,,0,0,0,,Амансың ба? аа….
Dialogue: 0,0:01:42.80,0:01:45.62,Default,,0,0,0,,Бірақ ол адам...
Dialogue: 0,0:01:45.62,0:01:54.63,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:54.63,0:01:58.47,Default,,0,0,0,,Эй Аладдин, Угоға не болды?
Dialogue: 0,0:01:58.47,0:02:01.58,Default,,0,0,0,,Өздігінен қозғалғандай болды.
Dialogue: 0,0:02:01.58,0:02:06.42,Default,,0,0,0,,Мен білмеймін. Мұндай жағдай менің басымнан бірінші рет болып тұр...
Dialogue: 0,0:02:06.42,0:02:10.64,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:10.64,0:02:14.30,Default,,0,0,0,,Әй, бұл не? Сол құбыжық.
Dialogue: 0,0:02:14.30,0:02:16.35,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:02:16.35,0:02:22.05,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:23.49,0:03:51.25,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:53.41,0:03:56.23,Default,,0,0,0,,Біз сүйкімді Жудал-чанды қатты жақсы көреміз →
Dialogue: 0,0:03:56.23,0:03:58.27,Default,,0,0,0,,Ол сені қорлады деп ойламайсың ба?
Dialogue: 0,0:03:58.27,0:04:01.30,Default,,0,0,0,,Сіз оны дер кезінде құтқара алдыңыз.
Dialogue: 0,0:04:01.30,0:04:03.97,Default,,0,0,0,,Бірақ мен ауыр жарақат алдым.
Dialogue: 0,0:04:03.97,0:04:07.41,Default,,0,0,0,,Эй, Ся Хуанвэнь, оны дұрыстап емде. →
Dialogue: 0,0:04:07.41,0:04:09.46,Default,,0,0,0,,Өліп қалсаң үлкен шаруа.
Dialogue: 0,0:04:09.46,0:04:14.10,Default,,0,0,0,,Түсіндім, ханшайым. Ол біздің қымбат →
Dialogue: 0,0:04:14.10,0:04:16.80,Default,,0,0,0,,Бұл ғибадатхана.
Dialogue: 0,0:04:16.80,0:04:18.91,Default,,0,0,0,,Шин! аа. Сол жігіттер →
Dialogue: 0,0:04:18.91,0:04:20.96,Default,,0,0,0,,Коу империясының адамы.
Dialogue: 0,0:04:20.96,0:04:22.99,Default,,0,0,0,,Коу империясы?
Dialogue: 0,0:04:22.99,0:04:25.03,Default,,0,0,0,,≪Ал бұл үлкен мәселе→
Dialogue: 0,0:04:25.03,0:04:27.50,Default,,0,0,0,,Сиқырлы құралдарды қолдану. →
Dialogue: 0,0:04:27.50,0:04:30.80,Default,,0,0,0,,Тек ешкім емес. Олар қандай мәртебе? ≫
Dialogue: 0,0:04:32.42,0:04:35.24,Default,,0,0,0,,Иә? Не... сіз әлі де мотивациясыз ба? →
Dialogue: 0,0:04:35.24,0:04:38.52,Default,,0,0,0,,Сол құбыжық. Бұл қызық емес. →
Dialogue: 0,0:04:38.52,0:04:40.69,Default,,0,0,0,,Онда мен саған қарсылас боламын.
Dialogue: 0,0:04:40.69,0:04:43.28,Default,,0,0,0,,Сақ болыңыз, ханшайым.
Dialogue: 0,0:04:43.28,0:04:45.43,Default,,0,0,0,,Жарайды. Маған қалдырыңыз.
Dialogue: 0,0:04:45.43,0:04:48.13,Default,,0,0,0,,Емделу керек. иә.
Dialogue: 0,0:04:49.64,0:04:52.09,Default,,0,0,0,,Қайғы мен айырылу рухы→
Dialogue: 0,0:04:52.09,0:04:55.16,Default,,0,0,0,,Саған және сенің ізбасарларыңа бұйырамын. →
Dialogue: 0,0:04:55.16,0:04:57.19,Default,,0,0,0,,Менің сиқырыммен қоректену →
Dialogue: 0,0:04:57.19,0:05:00.68,Default,,0,0,0,,Менің еркіме үлкен күш бер.
Dialogue: 0,0:05:00.68,0:05:02.72,Default,,0,0,0,,Шық, Винея!
Dialogue: 0,0:05:02.72,0:05:07.22,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:07.22,0:05:09.26,Default,,0,0,0,,Ах... Джин металл құралдарды пайдалана ма?
Dialogue: 0,0:05:09.26,0:05:11.29,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:05:11.29,0:05:15.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:15.38,0:05:19.67,Default,,0,0,0,,Ыстық... Мен жинаған судың бәрі буланып кетеді.
Dialogue: 0,0:05:19.67,0:05:21.70,Default,,0,0,0,,Бұл өлім шығын болады!!
Dialogue: 0,0:05:21.70,0:05:29.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:29.81,0:05:31.84,Default,,0,0,0,,Ах! Не? Бұл.
Dialogue: 0,0:05:31.84,0:05:38.64,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:38.64,0:05:40.67,Default,,0,0,0,,Thud! Ах!
Dialogue: 0,0:05:40.67,0:05:46.01,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:46.01,0:05:48.01,Default,,0,0,0,,Уго-кун!!
Dialogue: 0,0:05:56.45,0:06:00.59,Default,,0,0,0,,Сіз қалай ойлайсыз? Ся Хуанвэн. (Ся Хуанвэнь) Сіз күткендей, ханшайым!
Dialogue: 0,0:06:00.59,0:06:02.69,Default,,0,0,0,,Джудар-чанның көңіл-күйі қандай?
Dialogue: 0,0:06:02.69,0:06:05.33,Default,,0,0,0,,Алғашқы көмек көрсетіп жатқанымызбен →
Dialogue: 0,0:06:05.33,0:06:08.70,Default,,0,0,0,,Емдеу үшін сізге тиісті мекеме қажет.
Dialogue: 0,0:06:08.70,0:06:10.70,Default,,0,0,0,,Олай болса, тез кетейік.
Dialogue: 0,0:06:15.36,0:06:17.69,Default,,0,0,0,,Не? сен. Біз→
Dialogue: 0,0:06:17.69,0:06:21.04,Default,,0,0,0,,Мен жаңа ғана құбыжық шабуылдаған туысқа көмектестім.
Dialogue: 0,0:06:21.04,0:06:23.58,Default,,0,0,0,,Жоқ! Уго-кун барлығына қамқорлық жасайды...→
Dialogue: 0,0:06:23.58,0:06:26.27,Default,,0,0,0,,Сен мені қорғау үшін ғана күрестің.
Dialogue: 0,0:06:26.27,0:06:28.74,Default,,0,0,0,,Бірінші араласқан ол!
Dialogue: 0,0:06:28.74,0:06:31.37,Default,,0,0,0,,Иә. Жақсы →
Dialogue: 0,0:06:31.37,0:06:34.07,Default,,0,0,0,,Сіз сол құбыжықтың қожайынысыз ба? →
Dialogue: 0,0:06:35.39,0:06:38.93,Default,,0,0,0,,Төмендегі жігіттер де сенің достарың, солай ма?
Dialogue: 0,0:06:38.93,0:06:42.23,Default,,0,0,0,,Еншин Ентай Энтех Бітті.
Dialogue: 0,0:06:42.23,0:06:51.66,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:51.66,0:06:53.69,Default,,0,0,0,,Не? Бұл жігіттер.
Dialogue: 0,0:06:53.69,0:06:56.10,Default,,0,0,0,,Мен бұл балаға қамқор боламын.
Dialogue: 0,0:06:56.10,0:06:58.61,Default,,0,0,0,,Үшеуіңізді қоқыспен өлтіріңіз.
Dialogue: 0,0:06:58.61,0:07:00.65,Default,,0,0,0,,Дока! (Барлығы) Уау!
Dialogue: 0,0:07:00.65,0:07:02.70,Default,,0,0,0,,Не... не!? Әлгі жігіт! Маған көмектесші!
Dialogue: 0,0:07:02.70,0:07:05.00,Default,,0,0,0,,Арх! Тоқта, Масрур!
Dialogue: 0,0:07:05.00,0:07:08.34,Default,,0,0,0,,Арх! Уф... Уф...
Dialogue: 0,0:07:08.34,0:07:10.91,Default,,0,0,0,,≪Масрурмен тең деп айтасыз ба? ≫
Dialogue: 0,0:07:10.91,0:07:13.08,Default,,0,0,0,,≪Бұл жігіт әлі...≫
Dialogue: 0,0:07:13.08,0:07:15.67,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:15.67,0:07:18.12,Default,,0,0,0,,≪Оны өңдеу өте жылдам≫
Dialogue: 0,0:07:18.12,0:07:20.15,Default,,0,0,0,,Ах! (Джафар) Морджиана→
Dialogue: 0,0:07:20.15,0:07:22.92,Default,,0,0,0,,Барлығымызды бірге қорғайық! иә!
Dialogue: 0,0:07:22.92,0:07:25.56,Default,,0,0,0,,Барлығы менің артымда қалсын! Қарғыс атсын!
Dialogue: 0,0:07:25.56,0:07:28.68,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:28.68,0:07:33.12,Default,,0,0,0,,Жарайды... Қылышпен өте жақсысың. →
Dialogue: 0,0:07:33.12,0:07:35.17,Default,,0,0,0,,Көмек сұрайық.
Dialogue: 0,0:07:35.17,0:07:37.59,Default,,0,0,0,,≪Мынау... мына жігіт күшті≫
Dialogue: 0,0:07:37.59,0:07:41.94,Default,,0,0,0,,Хаааааааааа... (Кугёку) Барлығы көңіл көтеріп жүрген сияқты. →
Dialogue: 0,0:07:41.94,0:07:44.44,Default,,0,0,0,,Мен де Нағыз іс осыдан басталады.
Dialogue: 0,0:07:45.85,0:07:49.83,Default,,0,0,0,,Қайғы мен айырылу рухы, мен саған бұйырамын.
Dialogue: 0,0:07:49.83,0:07:53.17,Default,,0,0,0,,Денеңізге киіңіз, денеңізге тоқтаңыз ...
Dialogue: 0,0:07:53.17,0:07:55.29,Default,,0,0,0,,Не... бұл не? Бұл адам.
Dialogue: 0,0:07:55.29,0:07:58.79,Default,,0,0,0,,Өзімді ұлы жынға айналдыр, Винея.
Dialogue: 0,0:08:02.73,0:08:06.33,Default,,0,0,0,,Тоқта, қыз. Не... сен несің! →
Dialogue: 0,0:08:06.33,0:08:09.13,Default,,0,0,0,,Ах! Мен... менің сиқырлы киімім...
Dialogue: 0,0:08:11.02,0:08:14.67,Default,,0,0,0,,Мен жас ханымның Коу империясының ханшайымы екенін көремін.
Dialogue: 0,0:08:14.67,0:08:17.28,Default,,0,0,0,,А... сен кімсің?
Dialogue: 0,0:08:17.28,0:08:19.93,Default,,0,0,0,,Мен Синдбадпын...→
Dialogue: 0,0:08:19.93,0:08:22.75,Default,,0,0,0,,Бұл Синдрия патшасы Синдбад.
Dialogue: 0,0:08:22.75,0:08:24.75,Default,,0,0,0,,Ах! →
Dialogue: 0,0:08:26.17,0:08:29.47,Default,,0,0,0,,А... сен сол Синдбад патшасысың ба?
Dialogue: 0,0:08:30.99,0:08:33.13,Default,,0,0,0,,Ах! Қашанға дейін ұстайсың, арсыз адам?
Dialogue: 0,0:08:33.13,0:08:36.13,Default,,0,0,0,,Ой…. Кешіріңіз, ханшайым.
Dialogue: 0,0:08:36.13,0:08:38.95,Default,,0,0,0,,Дегенмен, екеуміздің де ұстанымдарымыз бар.
Dialogue: 0,0:08:38.95,0:08:40.98,Default,,0,0,0,,Ондай жерде ұрыспауымыз керек.
Dialogue: 0,0:08:40.98,0:08:43.15,Default,,0,0,0,,Өйткені... сол бала...
Dialogue: 0,0:08:43.15,0:08:47.11,Default,,0,0,0,,Аладдин... қызметкерлеріңізді де осында сақтай аласыз ба? →
Dialogue: 0,0:08:47.11,0:08:50.64,Default,,0,0,0,,Жарайды. Джин бұлай өлмейді. →
Dialogue: 0,0:08:50.64,0:08:53.08,Default,,0,0,0,,Досың тірі. Хахаха….
Dialogue: 0,0:08:53.08,0:08:56.18,Default,,0,0,0,,Бұлай толқығаныңыз сияқты емес.
Dialogue: 0,0:08:59.84,0:09:02.36,Default,,0,0,0,,Ханшайым, мен қазір бір себеппен →
Dialogue: 0,0:09:02.36,0:09:04.81,Default,,0,0,0,,Осы елде болу.
Dialogue: 0,0:09:04.81,0:09:08.41,Default,,0,0,0,,Сен де болсаң, мен сені тиісті жерде қарсы алғым келеді.
Dialogue: 0,0:09:08.41,0:09:11.95,Default,,0,0,0,,Мен... түсіндім. Барлығы. Иә.
Dialogue: 0,0:09:11.95,0:09:14.65,Default,,0,0,0,,Мен үйге бара жатырмын. иә? Ханшайым бірақ...
Dialogue: 0,0:09:14.65,0:09:16.65,Default,,0,0,0,,Жарайды, мен бүгін үйге барамын!
Dialogue: 0,0:09:19.61,0:09:21.97,Default,,0,0,0,,Жақсы ма? Әсіресе, сіз маған →
Dialogue: 0,0:09:21.97,0:09:23.97,Default,,0,0,0,,Мен үйге бармаймын!
Dialogue: 0,0:09:29.53,0:09:32.29,Default,,0,0,0,,Мен кеттім...
Dialogue: 0,0:09:32.29,0:09:36.39,Default,,0,0,0,,Мен құтқарылдым... А, жараланғандарды емдеңдер!
Dialogue: 0,0:09:40.58,0:09:43.08,Default,,0,0,0,,≪Уго-кунның жұлдызы жоғалып кетті≫
Dialogue: 0,0:09:45.40,0:09:48.00,Default,,0,0,0,,≪Уго-кунға көбірек күш беруім керек≫
Dialogue: 0,0:10:01.81,0:10:03.92,Default,,0,0,0,,Шин. Оу. қалай болды? →
Dialogue: 0,0:10:03.92,0:10:06.02,Default,,0,0,0,,Джафар. (Джафар) Бақытымызға орай →
Dialogue: 0,0:10:06.02,0:10:08.60,Default,,0,0,0,,Қайтыс болғандар жоқ сияқты. Мен түсінемін.
Dialogue: 0,0:10:08.60,0:10:10.64,Default,,0,0,0,,Әйтеуір, бұл жай ғана жәрдемақы.
Dialogue: 0,0:10:10.64,0:10:13.09,Default,,0,0,0,,Позаңызды қалпына келтіріңіз. Бұл...→
Dialogue: 0,0:10:13.09,0:10:15.14,Default,,0,0,0,,Мен шүберекті жинадым.
Dialogue: 0,0:10:15.14,0:10:17.71,Default,,0,0,0,,Су мұқтаж жандарға да үлестірілді.
Dialogue: 0,0:10:17.71,0:10:20.42,Default,,0,0,0,,Рахмет. Сізге де біраз демалу керек.
Dialogue: 0,0:10:20.42,0:10:22.52,Default,,0,0,0,,А, жоқ...
Dialogue: 0,0:10:22.52,0:10:25.62,Default,,0,0,0,,Мм... Емдеуге көмектесемін.
Dialogue: 0,0:10:27.74,0:10:29.78,Default,,0,0,0,,Морджиана жақсы қыз.
Dialogue: 0,0:10:29.78,0:10:32.56,Default,,0,0,0,,Күшті және мейірімді. Иә.
Dialogue: 0,0:10:32.56,0:10:34.61,Default,,0,0,0,,Мен айналамды жақсы білемін→
Dialogue: 0,0:10:34.61,0:10:36.80,Default,,0,0,0,,Тиімді және көп жұмыс істейді.
Dialogue: 0,0:10:36.80,0:10:39.80,Default,,0,0,0,,Амансың ба? аа. рақмет сізге.
Dialogue: 0,0:10:41.24,0:10:43.34,Default,,0,0,0,,>
Dialogue: 0,0:10:43.34,0:10:45.84,Default,,0,0,0,,≪Мен ештеңе істей алмадым≫
Dialogue: 0,0:10:47.36,0:10:51.46,Default,,0,0,0,,≪Туған жеріме қайтпас бұрын осы екеуіне көмектескім келеді≫
Dialogue: 0,0:10:52.82,0:10:54.87,Default,,0,0,0,,Ой... Қарғыс атсын!
Dialogue: 0,0:10:54.87,0:10:58.17,Default,,0,0,0,,Боқ~ Мен не істеп жатырмын?
Dialogue: 0,0:11:00.09,0:11:02.54,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:11:02.54,0:11:05.59,Default,,0,0,0,,≪Бәріне шабуыл жасалса да, мен ештеңе істей алмадым≫
Dialogue: 0,0:11:05.59,0:11:09.00,Default,,0,0,0,,≪Сізде Джиннің металл құралдары болса да, сіз қиын сәтте күресе алмайсыз.→
Dialogue: 0,0:11:09.00,0:11:11.03,Default,,0,0,0,,Бұл ештеңені білдірмейді≫
Dialogue: 0,0:11:11.03,0:11:13.89,Default,,0,0,0,,≪Қандай өкінішті... Жынды екен≫
Dialogue: 0,0:11:13.89,0:11:16.46,Default,,0,0,0,,Бұлай жарақат алатын уақыт емес.
Dialogue: 0,0:11:16.46,0:11:18.81,Default,,0,0,0,,Қарғыс атсын, мен осынша зардап шектім.
Dialogue: 0,0:11:18.81,0:11:21.63,Default,,0,0,0,,Уау, мұнда да... мұнда да? ≪Con Con
Dialogue: 0,0:11:21.63,0:11:24.43,Default,,0,0,0,,≪Mr. Алибаба, қалыңыз қалай?
Dialogue: 0,0:11:27.62,0:11:30.69,Default,,0,0,0,,Уау!! Апыр-ай!!
Dialogue: 0,0:11:30.69,0:11:33.14,Default,,0,0,0,,Сіз не істеп жатырсыз!? Нана... не →
Dialogue: 0,0:11:33.14,0:11:35.24,Default,,0,0,0,,Мен жай ғана жараға қарап тұрдым!
Dialogue: 0,0:11:36.69,0:11:40.83,Default,,0,0,0,,Ең болмаса... Маған бұл туралы бірдеңе айтсаңшы.
Dialogue: 0,0:11:40.83,0:11:42.87,Default,,0,0,0,,Жарайды, мынау сияқты.
Dialogue: 0,0:11:42.87,0:11:46.59,Default,,0,0,0,,Мен бәріне көмектесу үшін мұны тез аяқтауым керек.
Dialogue: 0,0:11:46.59,0:11:49.77,Default,,0,0,0,,Әй, айтпақшы, Аладдинге не болды?
Dialogue: 0,0:11:49.77,0:11:54.59,Default,,0,0,0,,Жалғыз қалғым келеді... Менің ойымша, сен депрессиядасың →
Dialogue: 0,0:11:54.59,0:11:57.18,Default,,0,0,0,,Менің ойымша, Уго мырза жоғалып кетті.
Dialogue: 0,0:11:57.18,0:11:59.77,Default,,0,0,0,,Менің ойымша, бұл бәрі емес. Ах.
Dialogue: 0,0:11:59.77,0:12:02.52,Default,,0,0,0,,Аладдин өзінің жұмбақ күшін тым көп пайдаланғанда →
Dialogue: 0,0:12:02.52,0:12:05.04,Default,,0,0,0,,Бұл сіздің физикалық күшіңізді жояды.
Dialogue: 0,0:12:05.04,0:12:07.92,Default,,0,0,0,,Бұл менің басымнан бұрын 7-лабиринтте болған.
Dialogue: 0,0:12:07.92,0:12:10.41,Default,,0,0,0,,≫ (мүше) Сәлем! ≫(мүше) Hey→
Dialogue: 0,0:12:10.41,0:12:12.66,Default,,0,0,0,,≫Бұл жігіт дем алмайды. (2 адам) А.
Dialogue: 0,0:12:12.66,0:12:14.66,Default,,0,0,0,,≫Гача (есік дыбысы) (мүше) Әй... Ол тірі ме?
Dialogue: 0,0:12:17.55,0:12:20.22,Default,,0,0,0,,Аладдин! Аладдин, мықты бол!
Dialogue: 0,0:12:20.22,0:12:22.74,Default,,0,0,0,,Аладдин! ≫ Ысқырықты алып тастаңыз! →
Dialogue: 0,0:12:22.74,0:12:25.74,Default,,0,0,0,,Мына ысқырықты алып тастаңыз! (2 адам) Ах!
Dialogue: 0,0:12:25.74,0:12:27.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:29.16,0:12:33.25,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:33.25,0:12:36.04,Default,,0,0,0,,Өте әлсіз. →
Dialogue: 0,0:12:36.04,0:12:38.07,Default,,0,0,0,,Біз әйтеуір шыдап жүрсек те→
Dialogue: 0,0:12:38.07,0:12:40.11,Default,,0,0,0,,Бұл өте қауіпті жағдай.
Dialogue: 0,0:12:40.11,0:12:42.16,Default,,0,0,0,,Міне... Ол→
Dialogue: 0,0:12:42.16,0:12:45.01,Default,,0,0,0,,Мен сиқырды тым көп қолдандым. (2 адам) А.
Dialogue: 0,0:12:45.01,0:12:48.85,Default,,0,0,0,,Магилер өз айналасының сиқырлы күшін шексіз пайдалана алатыны рас. →
Dialogue: 0,0:12:48.85,0:12:52.20,Default,,0,0,0,,Алайда бұл адамның физикалық күші болған кезде ғана мүмкін болады.
Dialogue: 0,0:12:52.20,0:12:55.87,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:55.87,0:13:00.01,Default,,0,0,0,,≪Бірақ ол кездегіден әлдеқайда суық≫
Dialogue: 0,0:13:00.01,0:13:02.58,Default,,0,0,0,,Аладдиннің шыдамы таусылып, Рафф пен басқалары →
Dialogue: 0,0:13:02.58,0:13:05.88,Default,,0,0,0,,Мен сиқырлы күш жинай алмайтындықтан, мен өз сиқырлы күшімді қолданамын→
Dialogue: 0,0:13:05.88,0:13:08.70,Default,,0,0,0,,Меніңше, ол ысқырығына бере берді. →
Dialogue: 0,0:13:08.70,0:13:12.67,Default,,0,0,0,,Сиқырлы күш беру – өмірді қысқарту. →
Dialogue: 0,0:13:12.67,0:13:15.24,Default,,0,0,0,,Сиқыршы болсаң да, Сиқырлы күшің таусылып қалса...
Dialogue: 0,0:13:15.24,0:13:17.89,Default,,0,0,0,,Мұның бәрі Аладдинге, Уго-кунға →
Dialogue: 0,0:13:17.89,0:13:21.01,Default,,0,0,0,,Аяулы дос болды. Алибаба мырза.
Dialogue: 0,0:13:21.01,0:13:23.05,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:23.05,0:13:27.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:27.07,0:13:29.11,Default,,0,0,0,,≪Бірақ флейтаға→
Dialogue: 0,0:13:29.11,0:13:31.14,Default,,0,0,0,,Сегіз бұрышты жұлдыз қайтып оралмады≫
Dialogue: 0,0:13:31.14,0:13:34.14,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:34.14,0:13:36.55,Default,,0,0,0,,Әйтеуір, Аладдин демалсын. →
Dialogue: 0,0:13:36.55,0:13:39.65,Default,,0,0,0,,Бұл күйде ол бірнеше күн оянбайды.
Dialogue: 0,0:13:42.15,0:13:44.45,Default,,0,0,0,,≫Кеңестер Кеңестер Кеңестер Кеңестер (аяқ дыбыстары)
Dialogue: 0,0:13:47.47,0:13:50.34,Default,,0,0,0,,≪Tattatatta… (аяқ дыбысы) ≪(мүше) Бас!
Dialogue: 0,0:13:50.34,0:13:52.70,Default,,0,0,0,,Alibaba басы! Біз →
Dialogue: 0,0:13:52.70,0:13:55.03,Default,,0,0,0,,Енді не істеуіміз керек!? Тұман тобы...→
Dialogue: 0,0:13:55.03,0:13:57.02,Default,,0,0,0,,Қараңғы аудандармен не болады?
Dialogue: 0,0:13:57.02,0:13:59.57,Default,,0,0,0,,Бас! (Мүше) Айтшы, басшы!
Dialogue: 0,0:13:59.57,0:14:02.17,Default,,0,0,0,,Бас! Өтінемін... айтшы, басшы!
Dialogue: 0,0:14:02.17,0:14:04.17,Default,,0,0,0,,≫Жарайды. Тынышталыңыз. →
Dialogue: 0,0:14:05.67,0:14:10.10,Default,,0,0,0,,Уайымдамаңыз. Мен саған ештеңеге қарамастан бірдеңе істеймін дедім.
Dialogue: 0,0:14:10.10,0:14:12.62,Default,,0,0,0,,Қолдау Синдриядан да келеді. →
Dialogue: 0,0:14:12.62,0:14:15.62,Default,,0,0,0,,Тез қозғалу үшін дайындалыңыз. →
Dialogue: 0,0:14:15.62,0:14:18.52,Default,,0,0,0,,Келіңіздер. А... шынымен де қолдау бола ма?
Dialogue: 0,0:14:20.02,0:14:22.21,Default,,0,0,0,,Бұл рас. →
Dialogue: 0,0:14:22.21,0:14:25.81,Default,,0,0,0,,Олай болса, балалар, тезірек жараланғандарды емдеңдер.
Dialogue: 0,0:14:25.81,0:14:28.58,Default,,0,0,0,,О... ой! Барлығымыз кеттік.
Dialogue: 0,0:14:28.58,0:14:31.57,Default,,0,0,0,,О! (Мүше) Жарайды, мен керек-жарақтарды реттеймін.
Dialogue: 0,0:14:31.57,0:14:34.22,Default,,0,0,0,,Ах. Портта әлі де қолдануға болатын нәрсе болуы мүмкін.
Dialogue: 0,0:14:34.22,0:14:36.22,Default,,0,0,0,,Ах~ Дұрыс. (Мүше) Жарайды, кеттік.
Dialogue: 0,0:14:37.69,0:14:41.59,Default,,0,0,0,,≪ Қарғыс атсын... Мен сондай аяныштымын≫
Dialogue: 0,0:14:41.59,0:14:43.93,Default,,0,0,0,,≪Бұл пайдасыз болып қана қоймай, әркімнің мазасын алады→
Dialogue: 0,0:14:43.93,0:14:45.93,Default,,0,0,0,,Оны алып тастасаңыз да, ол жұмыс істемейді≫
Dialogue: 0,0:14:47.30,0:14:49.57,Default,,0,0,0,,≪Қасым болса жақсы болар еді→
Dialogue: 0,0:14:49.57,0:14:52.04,Default,,0,0,0,,Барлығын біріктіруге болатын еді≫
Dialogue: 0,0:14:52.04,0:14:55.94,Default,,0,0,0,,≪Иә, Қасым... қайда бардың?≫
Dialogue: 0,0:14:55.94,0:14:58.28,Default,,0,0,0,,Бұл қиын! ше!?
Dialogue: 0,0:14:58.28,0:15:01.38,Default,,0,0,0,,Бұл қиын, бас! Ұлттық әскер шабуылға шықты. Ха!
Dialogue: 0,0:17:03.42,0:17:05.42,Default,,0,0,0,,Хиен
Dialogue: 0,0:17:07.74,0:17:10.29,Default,,0,0,0,,Bulkirk!
Dialogue: 0,0:17:10.29,0:17:12.85,Default,,0,0,0,,Жас! Генерал Булкирк.
Dialogue: 0,0:17:12.85,0:17:15.55,Default,,0,0,0,,Мен сені мүлде дұрыс түсінбедім, жігіт.
Dialogue: 0,0:17:15.55,0:17:17.95,Default,,0,0,0,,Ол кезде мен патша қылыш шеберлігінен сабақ бердім →
Dialogue: 0,0:17:17.95,0:17:20.49,Default,,0,0,0,,Мен оны кішкентай бала деп ойламаймын.
Dialogue: 0,0:17:20.49,0:17:22.79,Default,,0,0,0,,Бұл жерге не үшін келдің? Ах...
Dialogue: 0,0:17:24.19,0:17:26.19,Default,,0,0,0,,Submad-nii-san….
Dialogue: 0,0:17:27.63,0:17:30.73,Default,,0,0,0,,A… Alibaba керемет →
Dialogue: 0,0:17:30.73,0:17:34.93,Default,,0,0,0,,Мынадай жасырынған ұрылардың үлкен тобының басы... →
Dialogue: 0,0:17:36.30,0:17:39.07,Default,,0,0,0,,Бұл керемет... →
Dialogue: 0,0:17:39.07,0:17:42.79,Default,,0,0,0,,Мен мұны істей алмаймын. Қазір де солай...→
Dialogue: 0,0:17:42.79,0:17:46.68,Default,,0,0,0,,Танымайтын адамдар көп кездескенде... аяғым дірілдейді→
Dialogue: 0,0:17:46.68,0:17:49.65,Default,,0,0,0,,Бұл тоқтамайды...
Dialogue: 0,0:17:49.65,0:17:51.70,Default,,0,0,0,,Субмад-нии-сан.
Dialogue: 0,0:17:51.70,0:17:54.60,Default,,0,0,0,,Мұнда жас вице-король келді→
Dialogue: 0,0:17:54.60,0:17:58.57,Default,,0,0,0,,Сізбен маңызды әңгіме өткізу. иә?
Dialogue: 0,0:17:58.57,0:18:01.21,Default,,0,0,0,,Бұл біз үшін жау аумағы.
Dialogue: 0,0:18:01.21,0:18:05.23,Default,,0,0,0,,Вице-корольдің сезімін түсінуіңізді өтінемін, өйткені ол өз өмірін қатерге тігіп, сонда барды.
Dialogue: 0,0:18:05.23,0:18:07.98,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:07.98,0:18:10.34,Default,,0,0,0,,≫Бұл субмад емес пе? (Барлығы) О?
Dialogue: 0,0:18:10.34,0:18:12.82,Default,,0,0,0,,Әй... ағай. Көбінесе осылай →
Dialogue: 0,0:18:12.82,0:18:15.91,Default,,0,0,0,,Адамдар көп болатын жерге шықтыңыз. →
Dialogue: 0,0:18:15.91,0:18:19.63,Default,,0,0,0,,Абумадтың айтқаны осы емес пе?
Dialogue: 0,0:18:19.63,0:18:21.66,Default,,0,0,0,,Уф... иә. →
Dialogue: 0,0:18:21.66,0:18:24.55,Default,,0,0,0,,Мен... кешірім сұрауым керек→
Dialogue: 0,0:18:24.55,0:18:27.74,Default,,0,0,0,,Ағамның өміріне қауіп төндіргені үшін...
Dialogue: 0,0:18:27.74,0:18:29.77,Default,,0,0,0,,Мм, түсіндім. →
Dialogue: 0,0:18:29.77,0:18:32.22,Default,,0,0,0,,Солай болды ма? иә?
Dialogue: 0,0:18:32.22,0:18:34.81,Default,,0,0,0,,Менде сонша ақпарат бар екеніне сене алар емеспін →
Dialogue: 0,0:18:34.81,0:18:38.05,Default,,0,0,0,,Мен оны өте орталық адам деп ойладым→
Dialogue: 0,0:18:38.05,0:18:41.38,Default,,0,0,0,,Тұман бригадасына әскери ақпарат таратқан адам →
Dialogue: 0,0:18:41.38,0:18:44.47,Default,,0,0,0,,Тұман тобын нысанаға алғанымды ашқан мен болдым→
Dialogue: 0,0:18:44.47,0:18:47.27,Default,,0,0,0,,Мұның бәрі сен болды, солай ма? Ха!
Dialogue: 0,0:18:49.54,0:18:51.76,Default,,0,0,0,,Sa… Submad-nii-san?
Dialogue: 0,0:18:51.76,0:18:53.98,Default,,0,0,0,,Сіз білмедіңіз бе? иә?
Dialogue: 0,0:18:53.98,0:18:57.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:57.82,0:19:00.12,Default,,0,0,0,,Ой... Менде ештеңе жоқ...
Dialogue: 0,0:19:02.89,0:19:05.81,Default,,0,0,0,,Alibaba бар болғандықтан. Ах.
Dialogue: 0,0:19:05.81,0:19:09.11,Default,,0,0,0,,Alibaba тұман тобында болса →
Dialogue: 0,0:19:09.11,0:19:12.16,Default,,0,0,0,,Мен ол ел үшін бірдеңе жасайды деп ойладым.
Dialogue: 0,0:19:12.16,0:19:14.16,Default,,0,0,0,,Субмад-нии-сан….
Dialogue: 0,0:19:15.73,0:19:19.42,Default,,0,0,0,,Alibaba әрқашан мен істей алмайтын нәрселерді жасай алатын →
Dialogue: 0,0:19:19.42,0:19:21.42,Default,,0,0,0,,Оны жұлып алатын адам еді.
Dialogue: 0,0:19:23.26,0:19:25.31,Default,,0,0,0,,Мен Alibaba-ға барамын→
Dialogue: 0,0:19:25.31,0:19:28.43,Default,,0,0,0,,Мен ағамның тоқтауын қаладым. иә?
Dialogue: 0,0:19:28.43,0:19:33.25,Default,,0,0,0,,Абумадты тоқтату керек пе? Сіз, вице-король, тіпті ұрыларға қол ұшын бердіңіз →
Dialogue: 0,0:19:33.25,0:19:35.55,Default,,0,0,0,,Абумадтың несіне сонша қорқасың?
Dialogue: 0,0:19:36.89,0:19:39.94,Default,,0,0,0,,Мен ағамнан қорқамын...
Dialogue: 0,0:19:39.94,0:19:42.46,Default,,0,0,0,,Бірақ ең қорқыныштысы →
Dialogue: 0,0:19:42.46,0:19:45.16,Default,,0,0,0,,Менің ағамның әрекеті осы.
Dialogue: 0,0:19:45.16,0:19:47.93,Default,,0,0,0,,Не? Бірақ...→
Dialogue: 0,0:19:47.93,0:19:51.74,Default,,0,0,0,,Неліктен жер бетінде бұл болды?→
Dialogue: 0,0:19:51.74,0:19:54.89,Default,,0,0,0,,Менің ең қорқатыным – түсінбейтінім...
Dialogue: 0,0:19:57.23,0:20:00.53,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:20:00.53,0:20:03.47,Default,,0,0,0,,Уф... Уф... →
Dialogue: 0,0:20:03.47,0:20:05.82,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:20:05.82,0:20:09.10,Default,,0,0,0,,Осы жерден сөйлесуге рұқсат етіңіз. →
Dialogue: 0,0:20:09.10,0:20:11.76,Default,,0,0,0,,Оқиға дәл алдыңғы патша → кезінде болды
Dialogue: 0,0:20:11.76,0:20:15.26,Default,,0,0,0,,Мен ауырған кезде басталды. иә?
Dialogue: 0,0:20:17.10,0:20:19.73,Default,,0,0,0,,((Танысқаныма қуаныштымын, ханзада Абумад.→
Dialogue: 0,0:20:19.73,0:20:22.02,Default,,0,0,0,,Менің атым Банкир. →
Dialogue: 0,0:20:22.02,0:20:24.59,Default,,0,0,0,,Сіз қалай ойлайсыз? Келесі патша. →
Dialogue: 0,0:20:24.59,0:20:28.44,Default,,0,0,0,,Неге бәрін өзімізге қалдырмасқа? ))
Dialogue: 0,0:20:28.44,0:20:30.66,Default,,0,0,0,,Ол патша сарайына келді →
Dialogue: 0,0:20:30.66,0:20:34.20,Default,,0,0,0,,Ол өзін экономикалық кеңесшімін деген адам еді. →
Dialogue: 0,0:20:34.20,0:20:37.85,Default,,0,0,0,,Ол кезде Партевиямен сауда → кешіктірілді
Dialogue: 0,0:20:37.85,0:20:42.05,Default,,0,0,0,,Экономикалық жағдайы тұрақты түрде төмендеген Жапонияда→
Dialogue: 0,0:20:42.05,0:20:45.36,Default,,0,0,0,,Басқа елдерде қаржылық сауықтыру тәжірибесі бар →
Dialogue: 0,0:20:45.36,0:20:47.96,Default,,0,0,0,,Мен оның ұсынысын қабылдауды шештім.
Dialogue: 0,0:20:49.31,0:20:51.60,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:51.60,0:20:53.63,Default,,0,0,0,,((Бұл қағаз парағы емес →
Dialogue: 0,0:20:53.63,0:20:56.22,Default,,0,0,0,,Бұл жылтыр)) ((Кира?))
Dialogue: 0,0:20:56.22,0:20:59.94,Default,,0,0,0,,((Бұл құнына Коу империясы кепілдік берген ақша.→
Dialogue: 0,0:20:59.94,0:21:03.54,Default,,0,0,0,,Қалай болғанда да, оны келесі саудада пайдаланып көріңіз))
Dialogue: 0,0:21:03.54,0:21:05.58,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:21:05.58,0:21:07.68,Default,,0,0,0,,Расында да, сол қағаз→
Dialogue: 0,0:21:07.68,0:21:11.15,Default,,0,0,0,,Әртүрлі қымбат алтын бұйымдар мен қолөнер→
Dialogue: 0,0:21:11.15,0:21:15.05,Default,,0,0,0,,Жиһаз ерекше өнімге айналды. →
Dialogue: 0,0:21:15.05,0:21:18.36,Default,,0,0,0,,Банкир маған қалағанымша жылтырақ берді. →
Dialogue: 0,0:21:18.36,0:21:21.96,Default,,0,0,0,,Бірақ сіз оны білмей тұрып, Барбадос экономикасы жарқырап тұр →
Dialogue: 0,0:21:21.96,0:21:24.76,Default,,0,0,0,,Оған толығымен тәуелді болды. →
Dialogue: 0,0:21:26.16,0:21:28.20,Default,,0,0,0,,Бірақ бір қателік болды →
Dialogue: 0,0:21:28.20,0:21:32.34,Default,,0,0,0,,Біз байқамадық. иә?
Dialogue: 0,0:21:32.34,0:21:35.27,Default,,0,0,0,,Жылтырды қарызға алу үшін пайыздар алынады.
Dialogue: 0,0:21:35.27,0:21:39.36,Default,,0,0,0,,Алайда оның мәні аздап өзгереді. →
Dialogue: 0,0:21:39.36,0:21:41.81,Default,,0,0,0,,Кешегі күнге дейін 1 кореге сатып алуға болатын заттар →
Dialogue: 0,0:21:41.81,0:21:43.98,Default,,0,0,0,,кенеттен 2 ко болады. →
Dialogue: 0,0:21:43.98,0:21:47.38,Default,,0,0,0,,Әр жолы елімізге үлкен зиян келді.
Dialogue: 0,0:21:48.90,0:21:51.66,Default,,0,0,0,,Күміс монеталар күмістің өз құнына ие.
Dialogue: 0,0:21:51.66,0:21:55.93,Default,,0,0,0,,Бірақ банкноттар басқа. Негізінде бұл жай ғана қағаз.
Dialogue: 0,0:21:55.93,0:21:59.73,Default,,0,0,0,,Оны жасаған ел оның құндылығына ғана кепілдік береді.
Dialogue: 0,0:21:59.73,0:22:02.95,Default,,0,0,0,,Оған ұлттық экономикалық стандарттарды қосу...
Dialogue: 0,0:22:02.95,0:22:07.02,Default,,0,0,0,,Жапонияның өзінде күміс монеталарға айырбастауға болатын вексельдер бар→
Dialogue: 0,0:22:07.02,0:22:11.04,Default,,0,0,0,,Уақытша. Ол елден тыс жерде пайдаланылмайды.
Dialogue: 0,0:22:11.04,0:22:16.26,Default,,0,0,0,,Еліміздің қарызы орасан зор сомаға шарықтап кетті.
Dialogue: 0,0:22:16.26,0:22:19.38,Default,,0,0,0,,Қарыздарды өтеу үшін мен қарыздарды үйіп-төгдім...
Dialogue: 0,0:22:19.38,0:22:23.04,Default,,0,0,0,,Алайда банктер енді тегін несие бермейді. →
Dialogue: 0,0:22:23.04,0:22:26.89,Default,,0,0,0,,Теңіз құқығы, ұлттық жер мүддесі, сауда құқығы және т.б.→
Dialogue: 0,0:22:26.89,0:22:30.43,Default,,0,0,0,,Кепілге әртүрлі заттар алынды.
Dialogue: 0,0:22:30.43,0:22:32.76,Default,,0,0,0,,Міне... (Булкирк) Көлеңкеде →
Dialogue: 0,0:22:32.76,0:22:35.40,Default,,0,0,0,,Халық азап шекті. →
Dialogue: 0,0:22:35.40,0:22:38.70,Default,,0,0,0,,Үнемі өсіп келе жатқан салықтарға байланысты жеткізілімдер жетіспейді. →
Dialogue: 0,0:22:38.70,0:22:41.04,Default,,0,0,0,,Реніш үнін жапсырғандай→
Dialogue: 0,0:22:41.04,0:22:44.86,Default,,0,0,0,,Патша қараңғы аудандарды жауып, онда тұратын адамдарды қырып тастады.
Dialogue: 0,0:22:47.53,0:22:51.73,Default,,0,0,0,,Бұл да бұрын өте гүлденген портты қала болған.
Dialogue: 0,0:22:51.73,0:22:55.15,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:55.15,0:22:57.31,Default,,0,0,0,,((Сіз патша сарайына барғаннан кейінгі жыл→
Dialogue: 0,0:22:57.31,0:22:59.78,Default,,0,0,0,,Қараңғы аудандарда оба тарады. →
Dialogue: 0,0:22:59.78,0:23:01.88,Default,,0,0,0,,Бірақ ел → дегенді де білмейді
Dialogue: 0,0:23:01.88,0:23:05.38,Default,,0,0,0,,Олар бізді оқшаулап, қараңғы үйлерге қамап тастады))
Dialogue: 0,0:23:07.52,0:23:11.10,Default,,0,0,0,,Алайда, патша отбасы мен саясатты басқаратын ақсүйектер үшін →
Dialogue: 0,0:23:11.10,0:23:13.19,Default,,0,0,0,,Дағдарыс сезімі болған жоқ.
Dialogue: 0,0:23:13.19,0:23:16.12,Default,,0,0,0,,Біздің өміріміз бай болды.
Dialogue: 0,0:23:16.12,0:23:18.16,Default,,0,0,0,,((Кира… толығырақ →
Dialogue: 0,0:23:18.16,0:23:20.18,Default,,0,0,0,,Маған жылтырақ бере алмасаң, қиналып қалдым))
Dialogue: 0,0:23:20.18,0:23:22.21,Default,,0,0,0,,((Алайда, бұл ел енді →
Dialogue: 0,0:23:22.21,0:23:25.75,Default,,0,0,0,,Кепілге берілетін мүлік қалмады.
Dialogue: 0,0:23:25.75,0:23:27.79,Default,,0,0,0,,) ((Не…→
Dialogue: 0,0:23:27.79,0:23:30.76,Default,,0,0,0,,Әлі де көп)) (2 адам) ((иә?))
Dialogue: 0,0:23:30.76,0:23:34.33,Default,,0,0,0,,) ()
Dialogue: 0,0:23:34.33,0:23:37.40,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:23:37.40,0:23:40.82,Default,,0,0,0,,) (барлығы) ((на…))
Dialogue: 0,0:23:40.82,0:23:43.10,Default,,0,0,0,,((Бұл елде әлі де басқа адамдар бар →
Dialogue: 0,0:23:43.10,0:23:45.92,Default,,0,0,0,,Сізде сонша көп нәрсе қалды емес пе? →
Dialogue: 0,0:23:45.92,0:23:49.09,Default,,0,0,0,,Келесі қадам - халықтың адам құқығын кепілге алу))
Dialogue: 0,0:23:49.09,0:23:51.88,Default,,0,0,0,,((Адамдардың кез келген саны туылуы мүмкін.→
Dialogue: 0,0:23:51.88,0:23:54.18,Default,,0,0,0,,Жылтырды мәңгілікке алуға болады))
Dialogue: 0,0:23:55.70,0:23:58.52,Default,,0,0,0,,Ей, халықтың адам құқығына кепілдік бер→
Dialogue: 0,0:23:58.52,0:24:01.27,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:24:01.27,0:24:04.94,Default,,0,0,0,,Олар халықты сатуға тырысады. Эх...
Dialogue: 0,0:24:04.94,0:24:08.41,Default,,0,0,0,,Барбадос халқы Коу империясы мен Реймге→
Dialogue: 0,0:24:08.41,0:24:11.83,Default,,0,0,0,,Партевияға…. Менің ағам Барбад → ойнайды
Dialogue: 0,0:24:11.83,0:24:15.38,Default,,0,0,0,,Біз мұны құл өндіруші елге айналдыруды жоспарлап отырмыз! Ха!
Dialogue: 0,0:24:15.38,0:24:18.14,Default,,0,0,0,,Жоқ... Қарғыс атсын!
Dialogue: 0,0:24:18.14,0:24:22.19,Default,,0,0,0,,Ағам күнде ыстық судай ақша жұмсайды.
Dialogue: 0,0:24:22.19,0:24:24.71,Default,,0,0,0,,Мен басқа ештеңе көре алмаймын.
Dialogue: 0,0:24:24.71,0:24:28.73,Default,,0,0,0,,Дворяндар мен чиновниктер де өз өмірін қорғайды→
Dialogue: 0,0:24:28.73,0:24:32.08,Default,,0,0,0,,Мен ағамның соңынан еремін. Вице-король!
Dialogue: 0,0:24:32.08,0:24:34.55,Default,,0,0,0,,Морджиана. Вице-король→
Dialogue: 0,0:24:34.55,0:24:36.92,Default,,0,0,0,,Оны тоқтатқанымызды қалайсыз→
Dialogue: 0,0:24:36.92,0:24:38.99,Default,,0,0,0,,Сен мұнда келдің бе!?
Dialogue: 0,0:24:38.99,0:24:42.29,Default,,0,0,0,,Дұрыс. Ах.
Dialogue: 0,0:24:43.66,0:24:46.10,Default,,0,0,0,,Уау! Әй... Жасай берейік, Алибаба!
Dialogue: 0,0:24:46.10,0:24:49.17,Default,,0,0,0,,Не? Сол ақымақ жоспарды жасайық →
Dialogue: 0,0:24:49.17,0:24:51.54,Default,,0,0,0,,Тоқта! Ах...
Dialogue: 0,0:24:51.54,0:24:53.57,Default,,0,0,0,,Бас! Бас!
Dialogue: 0,0:24:53.57,0:24:55.61,Default,,0,0,0,,Жас! Alibaba!
Dialogue: 0,0:24:55.61,0:24:57.66,Default,,0,0,0,,Alibaba!
Dialogue: 0,0:24:57.66,0:25:09.46,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:13.43,0:26:07.72,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:12.12,0:26:18.42,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:22.79,0:26:40.09,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:14.44,0:28:16.49,Default,,0,0,0,,Адамдар туғаннан рөлге ие болады.
Dialogue: 0,0:28:16.49,0:28:19.03,Default,,0,0,0,,Менімен келесің бе? Alibaba. Менің ойымша →
Dialogue: 0,0:28:19.03,0:28:21.43,Default,,0,0,0,,Елді сақтайтын адам сол кісі.
Dialogue: 0,0:28:24.28,0:28:27.08,Default,,0,0,0,,Аладдин Мен не істеуім керек...?
Dialogue: 0,0:30:42.87,0:30:45.31,Default,,0,0,0,,Үкіметті сақтау немесе ауыстыру керек пе?
Dialogue: 0,0:30:46.34,0:30:48.66,Default,,0,0,0,,Бүгін Өкілдер палатасының 46-шы сайлауы өтеді.
Dialogue: 0,0:30:48.66,0:30:51.11,Default,,0,0,0,,Дауыс беру бүкіл ел бойынша өтіп жатыр.
Dialogue: 0,0:30:52.13,0:30:54.33,Default,,0,0,0,,16.00-дегі дауыс беру көрсеткіші.
Dialogue: 0,0:30:54.33,0:30:56.60,Default,,0,0,0,,Өткен жолғыдан төмен болса да
Dialogue: 0,0:30:56.60,0:30:58.49,Default,,0,0,0,,Көптеген адамдар түн ортасына дейін анықталады деп күтілуде.
Dialogue: 0,0:30:59.99,0:31:04.99,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
