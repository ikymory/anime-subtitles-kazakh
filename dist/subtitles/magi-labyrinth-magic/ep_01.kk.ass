Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.43,0:00:40.93,Default,,0,0,0,,Уау!!
Dialogue: 0,0:00:46.51,0:00:48.51,Default,,0,0,0,,Бум!
Dialogue: 0,0:00:52.30,0:00:55.95,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:00:55.95,0:01:05.56,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:05.56,0:01:09.97,Default,,0,0,0,,Мен өмірімнің соңына дейін осындай жерде қалып қойғанды жөн көремін →
Dialogue: 0,0:01:09.97,0:01:12.40,Default,,0,0,0,,Өлген жақсы.
Dialogue: 0,0:01:12.40,0:01:14.44,Default,,0,0,0,,Әй, маған жауап бер!
Dialogue: 0,0:01:14.44,0:01:16.44,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:01:18.76,0:01:20.81,Default,,0,0,0,,Мені кешіріңіз. →
Dialogue: 0,0:01:20.81,0:01:24.16,Default,,0,0,0,,Сізге бұлай айтуға рұқсат жоқ.
Dialogue: 0,0:01:24.16,0:01:29.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:29.80,0:01:34.31,Default,,0,0,0,,Бірақ шын қаласаңыз →
Dialogue: 0,0:01:34.31,0:01:37.06,Default,,0,0,0,,Осы киелі ғибадатхананың күшімен →
Dialogue: 0,0:01:37.06,0:01:41.96,Default,,0,0,0,,Мен сенің кез келген тілегіңді орындай аламын. →
Dialogue: 0,0:01:43.43,0:01:47.50,Default,,0,0,0,,Менің патшам... Ұлы сиқыршы. →
Dialogue: 0,0:01:47.50,0:01:50.09,Default,,0,0,0,,Тілегіңіз орындалсын. →
Dialogue: 0,0:01:50.09,0:01:54.46,Default,,0,0,0,,Үлкен байлық және миллиардтаған жұлдыздарды басқару күші →
Dialogue: 0,0:01:54.46,0:01:56.96,Default,,0,0,0,,Тіпті мәңгілік өмір де сенің қолыңда. →
Dialogue: 0,0:01:58.43,0:02:01.93,Default,,0,0,0,,Енді сіздің тілегіңіз қандай?
Dialogue: 0,0:02:04.00,0:02:06.20,Default,,0,0,0,,Менің... тілегім...
Dialogue: 0,0:02:07.67,0:03:36.05,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:42.04,0:03:47.04,Default,,0,0,0,,Хмф! Жақсы.
Dialogue: 0,0:03:48.89,0:03:51.54,Default,,0,0,0,,Фу. ≪(Мамеман) Ашуланба, Алибаба.
Dialogue: 0,0:03:51.54,0:03:53.88,Default,,0,0,0,,Бірдеңе болды ма? Бүгін →
Dialogue: 0,0:03:53.88,0:03:57.00,Default,,0,0,0,,Мен оны Будель мырзаға сатамын. Ah~→
Dialogue: 0,0:03:57.00,0:03:59.04,Default,,0,0,0,,Әлгі менмендік...
Dialogue: 0,0:03:59.04,0:04:02.04,Default,,0,0,0,,Мақсатыма жету үшін бар күшімді саламын.
Dialogue: 0,0:04:02.04,0:04:04.59,Default,,0,0,0,,Мақсат? Хаха. Бұл жігіт →
Dialogue: 0,0:04:04.59,0:04:08.31,Default,,0,0,0,,Лабиринт Мен соған ұмтыламын. Мен түсінемін. →
Dialogue: 0,0:04:08.31,0:04:10.46,Default,,0,0,0,,Жастардың арманы осындай болса керек. →
Dialogue: 0,0:04:10.46,0:04:12.46,Default,,0,0,0,,Хахахаха. (Мамеман) Хахахаха.
Dialogue: 0,0:04:13.88,0:04:17.08,Default,,0,0,0,,Эй... Мен байсалдымын.
Dialogue: 0,0:04:32.92,0:04:34.92,Default,,0,0,0,,Ах! Күрсін.
Dialogue: 0,0:04:37.11,0:04:39.13,Default,,0,0,0,,Сіз….
Dialogue: 0,0:04:39.13,0:04:41.94,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:41.94,0:04:45.13,Default,,0,0,0,,Сәлем, мен Аладдинмін. Саяхатшы.
Dialogue: 0,0:04:45.13,0:04:47.65,Default,,0,0,0,,Енді мына қызыл, тәтті жеміспен→
Dialogue: 0,0:04:47.65,0:04:50.82,Default,,0,0,0,,Тек тамақ ішу! Уф!
Dialogue: 0,0:04:50.82,0:04:53.67,Default,,0,0,0,,Бұл «Са!» емес. Уф….
Dialogue: 0,0:04:53.67,0:04:56.46,Default,,0,0,0,,≫ (Будель) Эй, Алибаба осында ма?
Dialogue: 0,0:04:56.46,0:04:58.63,Default,,0,0,0,,Мен осындамын. (Будель) Хмф.
Dialogue: 0,0:04:58.63,0:05:01.68,Default,,0,0,0,,Хаха…. (Боудель) Барлық жүкті алдыңыз ба? иә?
Dialogue: 0,0:05:01.68,0:05:03.73,Default,,0,0,0,,Сондай-ақ... әрине.
Dialogue: 0,0:05:03.73,0:05:05.89,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:05:05.89,0:05:09.71,Default,,0,0,0,,Мен бір рет толық дайындалдым, бірақ...
Dialogue: 0,0:05:09.71,0:05:12.31,Default,,0,0,0,,Шатаспа, маған көрсет.
Dialogue: 0,0:05:12.31,0:05:16.03,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:16.03,0:05:18.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:18.36,0:05:21.78,Default,,0,0,0,,Хмм. Ну!? Alibaba→
Dialogue: 0,0:05:21.78,0:05:25.15,Default,,0,0,0,,Сіз нені айтасыз!? Жоқ, бұл...
Dialogue: 0,0:05:25.15,0:05:28.27,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:28.27,0:05:31.09,Default,,0,0,0,,Гах! Сен неге еркексің?
Dialogue: 0,0:05:31.09,0:05:33.13,Default,,0,0,0,,Оның кеудесі бар ма?
Dialogue: 0,0:05:33.13,0:05:35.30,Default,,0,0,0,,Уфуфуфу. Хехе!
Dialogue: 0,0:05:35.30,0:05:38.12,Default,,0,0,0,,Маған үлкен кеуделер ұнайды.
Dialogue: 0,0:05:38.12,0:05:40.20,Default,,0,0,0,,Міне, келдің!
Dialogue: 0,0:05:40.20,0:05:42.20,Default,,0,0,0,,Хмм! Ха!
Dialogue: 0,0:05:43.76,0:05:46.51,Default,,0,0,0,,Кешірім сұраймыз. Негізі бұл біртүрлі бала...
Dialogue: 0,0:05:46.51,0:05:48.54,Default,,0,0,0,,Өзіңізді алдамаңыз! →
Dialogue: 0,0:05:48.54,0:05:51.43,Default,,0,0,0,,Сіз оны төлеуіңіз керек! Өтемақы аяқталғанға дейін →
Dialogue: 0,0:05:51.43,0:05:53.90,Default,,0,0,0,,Тегін жұмыс. →
Dialogue: 0,0:05:53.90,0:05:56.00,Default,,0,0,0,,Менің қашып кетуіме жол берме.
Dialogue: 0,0:05:59.59,0:06:02.29,Default,,0,0,0,,Қарғыс атсын саған Будель бейбақ.
Dialogue: 0,0:06:03.73,0:06:06.31,Default,,0,0,0,,Оны да анау бала ашады...→
Dialogue: 0,0:06:06.31,0:06:08.30,Default,,0,0,0,,Бұл ең нашар.
Dialogue: 0,0:06:08.30,0:06:10.30,Default,,0,0,0,,Гррррр (асқазан дыбыстары)
Dialogue: 0,0:06:15.32,0:06:17.24,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:06:17.24,0:06:19.24,Default,,0,0,0,,Иә. Күрсін.
Dialogue: 0,0:06:22.81,0:06:25.88,Default,,0,0,0,,Уф! О, мен бәрін жеймін!
Dialogue: 0,0:06:25.88,0:06:28.75,Default,,0,0,0,,Неліктен? Маған ертерек бермедің бе?
Dialogue: 0,0:06:28.75,0:06:32.05,Default,,0,0,0,,Мұны істеме! Гууууууууууууууууууууууу
Dialogue: 0,0:06:32.05,0:06:34.22,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:06:34.22,0:06:36.86,Default,,0,0,0,,Мен лабиринтті шындап тастауым керек→
Dialogue: 0,0:06:36.86,0:06:40.88,Default,,0,0,0,,Кептіру. иә? Лабиринт дегеніміз не?
Dialogue: 0,0:06:40.88,0:06:42.88,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:44.30,0:06:46.30,Default,,0,0,0,,Сіз мұны білмейсіз бе?
Dialogue: 0,0:06:51.02,0:06:53.48,Default,,0,0,0,,Лабиринт 14 жыл бұрын болған →
Dialogue: 0,0:06:53.48,0:06:57.31,Default,,0,0,0,,Дүние жүзінде пайда болатын жұмбақ қирандылар тобы.
Dialogue: 0,0:06:57.31,0:07:03.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:03.32,0:07:05.49,Default,,0,0,0,,Оны бағындырғандар үшін→
Dialogue: 0,0:07:05.49,0:07:08.84,Default,,0,0,0,,Сізге үлкен байлық пен билік беріледі.
Dialogue: 0,0:07:08.84,0:07:12.84,Default,,0,0,0,,Алтын-күміс қазыналар, жұмбақ сиқырлы заттар, т.б.
Dialogue: 0,0:07:14.90,0:07:17.78,Default,,0,0,0,,Сиқыр... аа.
Dialogue: 0,0:07:17.78,0:07:19.82,Default,,0,0,0,,Нағыз шеберлер әлі де бар →
Dialogue: 0,0:07:19.82,0:07:22.32,Default,,0,0,0,,Бір жерде бар деген қауесет бар...→
Dialogue: 0,0:07:23.79,0:07:26.48,Default,,0,0,0,,Лабиринтте Мажимон бар.
Dialogue: 0,0:07:26.48,0:07:31.65,Default,,0,0,0,,Аа... Ұшатын шүберек, бөтелке Саке →
Dialogue: 0,0:07:31.65,0:07:34.70,Default,,0,0,0,,Ең бастысы шайтан тұрады...→
Dialogue: 0,0:07:34.70,0:07:38.30,Default,,0,0,0,,Металл ыдыстар... Ах.
Dialogue: 0,0:07:38.30,0:07:40.82,Default,,0,0,0,,Қария, ол лабиринт →
Dialogue: 0,0:07:40.82,0:07:44.01,Default,,0,0,0,,Ол қайда? Ах...
Dialogue: 0,0:07:44.01,0:07:46.95,Default,,0,0,0,,Су~… Суу~….
Dialogue: 0,0:07:46.95,0:07:52.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:52.77,0:07:56.27,Default,,0,0,0,,Сіз өз жұбайыңызды таба аласыз.
Dialogue: 0,0:07:58.22,0:08:00.42,Default,,0,0,0,,Қайырлы түн, Уго-кун.
Dialogue: 0,0:08:05.13,0:08:07.23,Default,,0,0,0,,≪Неге ұйықтап жатырсың? Уф!
Dialogue: 0,0:08:09.95,0:08:11.95,Default,,0,0,0,,Гача (құлыптау дыбысы)
Dialogue: 0,0:08:14.19,0:08:16.94,Default,,0,0,0,,Бірдеңені кенет лақтыру қорқынышты емес пе?
Dialogue: 0,0:08:16.94,0:08:19.53,Default,,0,0,0,,Менің артымнан ерме.
Dialogue: 0,0:08:19.53,0:08:22.65,Default,,0,0,0,,Ей, аға, сіз айтып отырған лабиринт →
Dialogue: 0,0:08:22.65,0:08:25.23,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:08:25.23,0:08:27.50,Default,,0,0,0,,Міне.
Dialogue: 0,0:08:27.50,0:08:30.21,Default,,0,0,0,,Бұл лабиринт.
Dialogue: 0,0:08:30.21,0:08:33.88,Default,,0,0,0,,Жетінші лабиринт Амон он жыл бұрын пайда болды.
Dialogue: 0,0:08:33.88,0:08:36.81,Default,,0,0,0,,Уау. Мен де бұл Амонмын →
Dialogue: 0,0:08:36.81,0:08:38.97,Default,,0,0,0,,Дүние жүзінде қалған басқа лабиринттер →
Dialogue: 0,0:08:38.97,0:08:41.02,Default,,0,0,0,,Оны басқаларға қарағанда тезірек тазалаңыз →
Dialogue: 0,0:08:41.02,0:08:44.90,Default,,0,0,0,,Әлемдегі ең бай адам бол.
Dialogue: 0,0:08:44.90,0:08:48.42,Default,,0,0,0,,Сондықтан менің сені уайымдауға уақытым жоқ.
Dialogue: 0,0:08:48.42,0:08:50.42,Default,,0,0,0,,Түсіндіңіз бе? Гаки.
Dialogue: 0,0:08:53.01,0:08:55.30,Default,,0,0,0,,Сізге ақша ұнайды ма?
Dialogue: 0,0:08:55.30,0:08:58.95,Default,,0,0,0,,Ах. маған ақша керек
Dialogue: 0,0:08:58.95,0:09:01.95,Default,,0,0,0,,Бұл елді сатып алуға жеткілікті.
Dialogue: 0,0:09:01.95,0:09:06.16,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:06.16,0:09:08.79,Default,,0,0,0,,Ақшаң болса, кез келген нәрсені аласың.
Dialogue: 0,0:09:08.79,0:09:12.45,Default,,0,0,0,,Сіз дәмді тағамды жей аласыз. Уау, дәмді тағам.
Dialogue: 0,0:09:12.45,0:09:16.65,Default,,0,0,0,,Сондай-ақ, әдемі әйел. Уау, сұлу ханым!
Dialogue: 0,0:09:16.65,0:09:20.86,Default,,0,0,0,,Ах. Ақшасы болса еркек танымал болады!
Dialogue: 0,0:09:20.86,0:09:24.66,Default,,0,0,0,,Мені үлкен, жұмсақ кеуделі әйел басып тұр.
Dialogue: 0,0:09:24.66,0:09:26.91,Default,,0,0,0,,Дұрыс~ Уфуфу!
Dialogue: 0,0:09:26.91,0:09:28.91,Default,,0,0,0,,Мен жалығып барамын. Ах!
Dialogue: 0,0:09:30.33,0:09:33.57,Default,,0,0,0,,А... Кешіріңіз, апа.
Dialogue: 0,0:09:33.57,0:09:40.03,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:40.03,0:09:44.58,Default,,0,0,0,,Ах... Кешіріңіз. Сіз зардап шеккен жоқсыз ба? Мен сіздің жүгіңізді апарайын ба?
Dialogue: 0,0:09:44.58,0:09:48.48,Default,,0,0,0,,Жоқ, бәрі жақсы. Хаха…. Tsk!
Dialogue: 0,0:09:48.48,0:09:50.82,Default,,0,0,0,,Jala jala jala (тізбекті дыбыс)
Dialogue: 0,0:09:50.82,0:09:53.52,Default,,0,0,0,,Не? Иә, сол.
Dialogue: 0,0:09:54.97,0:09:57.01,Default,,0,0,0,,Джара Джара…
Dialogue: 0,0:09:57.01,0:09:59.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:04.08,0:10:06.74,Default,,0,0,0,,≪Ах! ≫Мен жасадым.
Dialogue: 0,0:10:06.74,0:10:09.79,Default,,0,0,0,,Құл? «Қайсы»?
Dialogue: 0,0:10:09.79,0:10:12.91,Default,,0,0,0,,Сатып алынатын және сатылатын адам.
Dialogue: 0,0:10:12.91,0:10:17.46,Default,,0,0,0,,Мені өмір бойы малдай көргім келмейді...
Dialogue: 0,0:10:17.46,0:10:19.46,Default,,0,0,0,,Шіріген дүние.
Dialogue: 0,0:10:24.60,0:10:26.66,Default,,0,0,0,,Пу (ысқырық) Бакин!
Dialogue: 0,0:10:26.66,0:10:28.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:31.39,0:10:36.22,Default,,0,0,0,,Иә, түсіндім. Енді сіз әдемі аяқтарыңызды жасырмай жүре аласыз.
Dialogue: 0,0:10:36.22,0:10:38.27,Default,,0,0,0,,Бұл не? О... Эй, анау...
Dialogue: 0,0:10:38.27,0:10:40.30,Default,,0,0,0,,≪Не істеп жатырсың!? ≫Сен қайда құлсың?
Dialogue: 0,0:10:40.30,0:10:42.67,Default,,0,0,0,,≪Сіз не істеуді жоспарлап отырсыз...? ≫Не!
Dialogue: 0,0:10:42.67,0:10:45.74,Default,,0,0,0,,Tsk! Эй, бұл жаман!
Dialogue: 0,0:10:45.74,0:10:49.55,Default,,0,0,0,,Неліктен? Мм... бұл дұрыс...
Dialogue: 0,0:10:49.55,0:10:51.58,Default,,0,0,0,,Неліктен? Ах...
Dialogue: 0,0:10:51.58,0:10:55.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:55.70,0:10:58.52,Default,,0,0,0,,Құл ұрлау - ауыр қылмыс.
Dialogue: 0,0:10:58.52,0:11:00.86,Default,,0,0,0,,Ах! (Боудель) Бір қолы кесілген. →
Dialogue: 0,0:11:00.86,0:11:03.74,Default,,0,0,0,,Менің өтемақым қандай болады?
Dialogue: 0,0:11:03.74,0:11:07.16,Default,,0,0,0,,Жоқ, біз қарапайым халықпыз.
Dialogue: 0,0:11:07.16,0:11:11.18,Default,,0,0,0,,Мұндай қатты шынжырды үзу мүмкін емес...
Dialogue: 0,0:11:11.18,0:11:14.54,Default,,0,0,0,,Hmph. Бұл соншалықты анық. →
Dialogue: 0,0:11:14.54,0:11:18.92,Default,,0,0,0,,Егер сіз толық соманы төлей алмасаңыз... Иә?
Dialogue: 0,0:11:18.92,0:11:22.43,Default,,0,0,0,,Хаха…. Мен сені құлыма айналдырамын.
Dialogue: 0,0:11:22.43,0:11:25.70,Default,,0,0,0,,Уф... Құл болу қиын.
Dialogue: 0,0:11:25.70,0:11:28.40,Default,,0,0,0,,Тіпті осындай жағдай орын алса да...
Dialogue: 0,0:11:28.40,0:11:32.24,Default,,0,0,0,,Уф! (Будель) Тіпті осындай жағдай орын алса да →
Dialogue: 0,0:11:32.24,0:11:34.27,Default,,0,0,0,,Мен шағымдана алмаймын.
Dialogue: 0,0:11:34.27,0:11:36.27,Default,,0,0,0,,Тоқта, ағай. Ах.
Dialogue: 0,0:11:37.99,0:11:41.71,Default,,0,0,0,,Не? Гаки. Полицияға шағымдануға болады.
Dialogue: 0,0:11:41.71,0:11:43.77,Default,,0,0,0,,Бар болғаны... Уф!
Dialogue: 0,0:11:43.77,0:11:46.64,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:46.64,0:11:49.71,Default,,0,0,0,,Әлде оны қазір өлтіруім керек пе?
Dialogue: 0,0:11:49.71,0:11:51.71,Default,,0,0,0,,Сооо... Пуууууу
Dialogue: 0,0:11:53.43,0:11:55.43,Default,,0,0,0,,Арх! Апыр-ай!
Dialogue: 0,0:11:56.85,0:11:58.88,Default,,0,0,0,,Ах... Банг!
Dialogue: 0,0:11:58.88,0:12:04.90,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:04.90,0:12:06.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:09.51,0:12:11.54,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:12:11.54,0:12:16.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:16.77,0:12:19.35,Default,,0,0,0,,Уго-кун әлі ұялшақ.
Dialogue: 0,0:12:19.35,0:12:22.04,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:22.04,0:12:24.09,Default,,0,0,0,,≫ (Полиция қызметкері) Міне, келдің! Бұл не туралы!?
Dialogue: 0,0:12:24.09,0:12:26.13,Default,,0,0,0,,Жоқ! Ол полиция қызметкері. (Полиция қызметкері) Жолдан кет! Бұл ыңғайсыздық!
Dialogue: 0,0:12:26.13,0:12:28.16,Default,,0,0,0,,Қашайық. ау.
Dialogue: 0,0:12:28.16,0:12:30.21,Default,,0,0,0,,≪(Полиция қызметкері) Біреу құлап қалды. Ха!
Dialogue: 0,0:12:30.21,0:12:33.61,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:46.05,0:12:49.85,Default,,0,0,0,,Пхуха~. Эй, мына флейта...
Dialogue: 0,0:12:49.85,0:12:52.77,Default,,0,0,0,,Иә? Кенеттен бірдеңе шықты.
Dialogue: 0,0:12:52.77,0:12:56.07,Default,,0,0,0,,Бұл Уго-кун. Сен менің досымсың.
Dialogue: 0,0:12:56.07,0:12:58.89,Default,,0,0,0,,Мені барлығы Джин деп атайтын сияқты.
Dialogue: 0,0:12:58.89,0:13:00.93,Default,,0,0,0,,Аа...
Dialogue: 0,0:13:00.93,0:13:02.91,Default,,0,0,0,,≪Күтілгендей≫
Dialogue: 0,0:13:02.91,0:13:06.15,Default,,0,0,0,,≪Аңызға айналған Djinn металл бұйымдары≫
Dialogue: 0,0:13:06.15,0:13:08.93,Default,,0,0,0,,≪Лабиринтті бағындыру - өміріңізге қауіп төндіреді≫
Dialogue: 0,0:13:08.93,0:13:11.83,Default,,0,0,0,,≪Амонға кірген бірде-бір адам қайтып оралмады.≫
Dialogue: 0,0:13:13.52,0:13:16.29,Default,,0,0,0,,≪Осы жігіт болса...≫
Dialogue: 0,0:13:16.29,0:13:18.63,Default,,0,0,0,,Ум~ Аладдин →
Dialogue: 0,0:13:18.63,0:13:20.83,Default,,0,0,0,,Сізге әдемі ханымдар ұнайды ма?
Dialogue: 0,0:13:22.46,0:13:25.35,Default,,0,0,0,,Көп дүрбелең болған сияқты.
Dialogue: 0,0:13:25.35,0:13:28.54,Default,,0,0,0,,Сондай-ақ... Кешіріңіз, тақсыр. →
Dialogue: 0,0:13:28.54,0:13:32.91,Default,,0,0,0,,Құлды қашып жібермек болған мына бір ақымақ болды.
Dialogue: 0,0:13:32.91,0:13:37.11,Default,,0,0,0,,Хмм…. Біртүрлі нәрселердің пайда болуы туралы әңгімелер де бар.
Dialogue: 0,0:13:37.11,0:13:40.05,Default,,0,0,0,,Қалай... неге мұны істейсің?
Dialogue: 0,0:13:40.05,0:13:43.72,Default,,0,0,0,,Менің күзетші итім айтты.
Dialogue: 0,0:13:43.72,0:13:47.07,Default,,0,0,0,,Жоқ, жоқ…. Мұндай көзқарас→
Dialogue: 0,0:13:47.07,0:13:50.37,Default,,0,0,0,,Жәмила-самаға есеп берудің қажеті жоқ деп ойлаймын.
Dialogue: 0,0:13:51.93,0:13:55.00,Default,,0,0,0,,Ойланып қарасаң, ертең керуенге барасың, солай ма?
Dialogue: 0,0:13:55.00,0:13:58.05,Default,,0,0,0,,… Иә. Бұл не?
Dialogue: 0,0:13:58.05,0:14:00.55,Default,,0,0,0,,Мен саған жұмыс беремін.
Dialogue: 0,0:16:02.59,0:16:04.63,Default,,0,0,0,,Уфуфуфу. Маған... ұнайды.
Dialogue: 0,0:16:04.63,0:16:07.58,Default,,0,0,0,,Дүкендер көңілді. Хехе.
Dialogue: 0,0:16:07.58,0:16:09.98,Default,,0,0,0,,Жоқ. Жұмсақ фуфуфу!
Dialogue: 0,0:16:09.98,0:16:14.42,Default,,0,0,0,,Умм, Аладдин саяхаттап жатыр, солай ма?
Dialogue: 0,0:16:14.42,0:16:17.06,Default,,0,0,0,,Сіздің мақсатыңыз бар ма?
Dialogue: 0,0:16:17.06,0:16:21.08,Default,,0,0,0,,Эй, лабиринтте Джиннің металл құралы бар, солай ма?
Dialogue: 0,0:16:21.08,0:16:25.51,Default,,0,0,0,,А, а. Мен Уго-кунға уәде бердім →
Dialogue: 0,0:16:25.51,0:16:28.10,Default,,0,0,0,,Джиннің металл ыдыстарын іздеу.
Dialogue: 0,0:16:28.10,0:16:32.24,Default,,0,0,0,,Олай болса, мені сонда бағыттаңыз.
Dialogue: 0,0:16:32.24,0:16:34.99,Default,,0,0,0,,Түсіндім...
Dialogue: 0,0:16:34.99,0:16:37.39,Default,,0,0,0,,Қалай болғанда да, сен менімен барасың, солай ма?
Dialogue: 0,0:16:37.39,0:16:40.16,Default,,0,0,0,,Иә. Күрсін.
Dialogue: 0,0:16:40.16,0:16:43.63,Default,,0,0,0,,≪Бұл жолы мен лабиринтке барып, өте бай боламын≫
Dialogue: 0,0:16:43.63,0:16:46.40,Default,,0,0,0,,Жоқ, жоқ! Апыр-ай.
Dialogue: 0,0:16:46.40,0:16:49.46,Default,,0,0,0,,≪Сондықтан мен де ләззат алуым керек деп ойлаймын≫
Dialogue: 0,0:16:49.46,0:16:51.62,Default,,0,0,0,,≫Бұл жақында қызмет көрсету уақыты болады.
Dialogue: 0,0:16:51.62,0:16:53.66,Default,,0,0,0,,≪Кәне көңіл көтерейік! ≫
Dialogue: 0,0:16:53.66,0:16:59.52,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:59.52,0:17:01.55,Default,,0,0,0,,≫Күткеніңізге рахмет.
Dialogue: 0,0:17:01.55,0:17:03.55,Default,,0,0,0,,≪Ол осында! ≫
Dialogue: 0,0:17:05.00,0:17:08.61,Default,,0,0,0,,Хехе. Сен сондай сүйкімді доссың.
Dialogue: 0,0:17:08.61,0:17:11.39,Default,,0,0,0,,Ол менің досым емес.
Dialogue: 0,0:17:11.39,0:17:14.45,Default,,0,0,0,,О, солай ма? Мен қазірдің өзінде →
Dialogue: 0,0:17:14.45,0:17:17.07,Default,,0,0,0,,Мен достастырмаймын деп шештім.
Dialogue: 0,0:17:17.07,0:17:20.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:20.07,0:17:22.10,Default,,0,0,0,,Менің атым Элизабет.
Dialogue: 0,0:17:22.10,0:17:25.16,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:25.16,0:17:27.98,Default,,0,0,0,,Біздің ең дарынды үй иесінің лақап аты →
Dialogue: 0,0:17:27.98,0:17:30.03,Default,,0,0,0,,Біз оны алдық. →
Dialogue: 0,0:17:30.03,0:17:32.43,Default,,0,0,0,,Бұдан былай ескертіңіз. Бұл өте жақсы сезінеді!
Dialogue: 0,0:17:32.43,0:17:36.39,Default,,0,0,0,,≫Ки (есік дыбысы) Хаа~ Бұл қызық болды.
Dialogue: 0,0:17:36.39,0:17:39.99,Default,,0,0,0,,Мен лабиринттен қайтқанда қайтамын, адам!
Dialogue: 0,0:17:43.29,0:17:45.29,Default,,0,0,0,,≫ (Будель) Мен сені іздеп көрейін. →
Dialogue: 0,0:17:46.76,0:17:50.26,Default,,0,0,0,,Ойнайтын ақшаң болса, маған өтемақыны қайтаруыңды қалаймын.
Dialogue: 0,0:17:51.68,0:17:54.75,Default,,0,0,0,,Қазір емес. (Будель) Иә?
Dialogue: 0,0:17:54.75,0:17:57.99,Default,,0,0,0,,Бірақ мен лабиринтке кіруді шештім.
Dialogue: 0,0:17:57.99,0:18:00.69,Default,,0,0,0,,Егер сіз оны жеңсеңіз, мен сізге толық төлеймін.
Dialogue: 0,0:18:00.69,0:18:03.63,Default,,0,0,0,,Стратегия? Пуф! (3 адам) Ахаха!
Dialogue: 0,0:18:03.63,0:18:08.13,Default,,0,0,0,,Мұндай ауызша уәдеге кім сенеді?
Dialogue: 0,0:18:08.13,0:18:10.82,Default,,0,0,0,,Барлық жақын қалаларға... қашуға тырысыңыз →
Dialogue: 0,0:18:10.82,0:18:12.87,Default,,0,0,0,,Ол сізді іздеушілер тізіміне енгізеді.
Dialogue: 0,0:18:12.87,0:18:15.81,Default,,0,0,0,,Қарғыс атсын! (Боудель) Енді таңдаңыз. →
Dialogue: 0,0:18:15.81,0:18:20.71,Default,,0,0,0,,Не қазір де, осында да тұтқынға түсесің, немесе өлгенше мен үшін жұмыс істейсің.
Dialogue: 0,0:18:24.03,0:18:26.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:26.94,0:18:31.84,Default,,0,0,0,,Мені мазақ етпе. Сізге тіпті сұраудың қажеті жоқ!
Dialogue: 0,0:18:34.29,0:18:38.01,Default,,0,0,0,,Сонда сіздің жүгіңіз қандай? Күйеу.
Dialogue: 0,0:18:38.01,0:18:40.47,Default,,0,0,0,,Бұл шарап. Жәмилә мырза→
Dialogue: 0,0:18:40.47,0:18:43.87,Default,,0,0,0,,Бұл көрші қаланың қожайынына сыйға тартуға болатын өте сәнді зат. →
Dialogue: 0,0:18:43.87,0:18:45.90,Default,,0,0,0,,Ризашылықпен жұмыс жасаңыз.
Dialogue: 0,0:18:45.90,0:18:48.34,Default,,0,0,0,,Ха! Сүйсініп.
Dialogue: 0,0:18:48.34,0:18:52.84,Default,,0,0,0,,Цк... жүзім шарабы? Бұл менің өмірімді қатерге тігу емес пе?
Dialogue: 0,0:18:54.28,0:18:56.98,Default,,0,0,0,,Тізбек ханымы. иә?
Dialogue: 0,0:18:58.65,0:19:00.75,Default,,0,0,0,,Будель мырза, бұл не?
Dialogue: 0,0:19:00.75,0:19:03.65,Default,,0,0,0,,Ах~ Шахталарға апаратын құл.
Dialogue: 0,0:19:11.70,0:19:15.67,Default,,0,0,0,,Адамға жараспайтын армандарды армандама. →
Dialogue: 0,0:19:15.67,0:19:18.67,Default,,0,0,0,,Тышқан – тышқан. Құл - құл. →
Dialogue: 0,0:19:18.67,0:19:20.71,Default,,0,0,0,,Сен солай туылғаннан бері мәңгі өмір сүресің→
Dialogue: 0,0:19:20.71,0:19:24.21,Default,,0,0,0,,Қоқыстан басқа құны жоқ өмір сүресің.
Dialogue: 0,0:19:26.65,0:19:30.37,Default,,0,0,0,,Сіз олай ойламайсыз ба? иә?
Dialogue: 0,0:19:30.37,0:19:34.87,Default,,0,0,0,,Дұрыс... (Будель) Әй? Мен сені ести алмаймын.
Dialogue: 0,0:19:36.61,0:19:39.12,Default,,0,0,0,,Бұл шынымен де дұрыс.
Dialogue: 0,0:19:39.12,0:19:41.46,Default,,0,0,0,,Жоқ, сіз күткендей, сэр.
Dialogue: 0,0:19:41.46,0:19:45.01,Default,,0,0,0,,болуы керек пе? Хахахаха! →
Dialogue: 0,0:19:45.01,0:19:48.90,Default,,0,0,0,,Ах ха ха ха ха! Хахаха….
Dialogue: 0,0:19:48.90,0:19:52.75,Default,,0,0,0,,Сіз өтірікшісіз. Ах.
Dialogue: 0,0:19:52.75,0:19:55.81,Default,,0,0,0,,Осылай өтірік айта берсең →
Dialogue: 0,0:19:55.81,0:19:58.63,Default,,0,0,0,,Ешкім... тіпті өзім де→
Dialogue: 0,0:19:58.63,0:20:01.93,Default,,0,0,0,,Сіз өзіңізге сене алмаймын деп ойламайсыз ба?
Dialogue: 0,0:20:01.93,0:20:24.67,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:24.67,0:20:26.67,Default,,0,0,0,,​​Таң! Ах!
Dialogue: 0,0:20:28.49,0:20:30.56,Default,,0,0,0,,Кяа~! Шөл гиацинт!
Dialogue: 0,0:20:30.56,0:20:33.38,Default,,0,0,0,,≪Жылдамдығыңызды арттырыңыз! Ақыры осында!
Dialogue: 0,0:20:33.38,0:20:36.43,Default,,0,0,0,,Өйткені олар шарап алып жүреді! ≪Жүгір!
Dialogue: 0,0:20:36.43,0:20:51.46,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:51.46,0:20:53.60,Default,,0,0,0,,Арбаны тастап, жүгір! Жүктеріңізді түсіріңіз!
Dialogue: 0,0:20:53.60,0:20:55.82,Default,,0,0,0,,Кешіріңіз! Түйені алып таста!
Dialogue: 0,0:20:55.82,0:20:57.97,Default,,0,0,0,,Alibaba! Жарайды, ішімдік әкел!
Dialogue: 0,0:20:57.97,0:21:00.07,Default,,0,0,0,,А, иә.
Dialogue: 0,0:21:00.07,0:21:03.26,Default,,0,0,0,,Сіздер де көмектесе аласыздар! Ақша көтеріледі.
Dialogue: 0,0:21:03.26,0:21:05.54,Default,,0,0,0,,Бассейн! Ах!
Dialogue: 0,0:21:05.54,0:21:09.34,Default,,0,0,0,,Уау…. Ах~!
Dialogue: 0,0:21:10.75,0:21:13.19,Default,,0,0,0,,Мина! (Будель) Рақым!
Dialogue: 0,0:21:13.19,0:21:15.19,Default,,0,0,0,,Ах. Анашым!
Dialogue: 0,0:21:16.57,0:21:18.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:20.73,0:21:23.51,Default,,0,0,0,,Ах... (Будель) Фу, бұл қауіпті болды.
Dialogue: 0,0:21:23.51,0:21:26.06,Default,,0,0,0,,Жоқ!! Бұл қауіпті! →
Dialogue: 0,0:21:26.06,0:21:30.32,Default,,0,0,0,,Ары қарай жүрме! Мина... Мина!
Dialogue: 0,0:21:30.32,0:21:33.81,Default,,0,0,0,,≪Беріңіз! (Будель) Эй, алкогольді әкел.
Dialogue: 0,0:21:33.81,0:21:36.41,Default,,0,0,0,,≪Біреу маған көмектесіңізші...≫
Dialogue: 0,0:21:37.79,0:21:40.10,Default,,0,0,0,,Тамақ бергенде қозғалмайды. →
Dialogue: 0,0:21:40.10,0:21:42.75,Default,,0,0,0,,Дәл қазір бұл жерден спиртті шығарып алайық.
Dialogue: 0,0:21:42.75,0:21:45.80,Default,,0,0,0,,Өтінемін! Өтінемін, мені жіберіңізші!
Dialogue: 0,0:21:45.80,0:21:48.39,Default,,0,0,0,,Мені жіберме. Өз бетімше өлсем ше →
Dialogue: 0,0:21:48.39,0:21:51.32,Default,,0,0,0,,Өтемақы шығындары жоғары. (Анашым) Мина!
Dialogue: 0,0:21:51.32,0:21:53.73,Default,,0,0,0,,≪Біреу...≫
Dialogue: 0,0:21:53.73,0:21:56.06,Default,,0,0,0,,≪Өлген≫
Dialogue: 0,0:21:56.06,0:21:58.06,Default,,0,0,0,,≪Біреу! ≫
Dialogue: 0,0:22:00.08,0:22:02.12,Default,,0,0,0,,Ах... Мина!
Dialogue: 0,0:22:02.12,0:22:04.82,Default,,0,0,0,,<<Барлығы өледі. біреу! ≫
Dialogue: 0,0:22:04.82,0:22:07.82,Default,,0,0,0,,Не туралы күбірлеп тұрсың? Тез апарыңыз.
Dialogue: 0,0:22:07.82,0:22:11.06,Default,,0,0,0,,Әй, жоқ... (Будель) Әйелді жылатпа. →
Dialogue: 0,0:22:11.06,0:22:14.55,Default,,0,0,0,,Мен балалардың ақшасын төлеймін. →
Dialogue: 0,0:22:14.55,0:22:16.65,Default,,0,0,0,,Сізге қанша керек? иә?
Dialogue: 0,0:22:16.65,0:22:18.68,Default,,0,0,0,,Баки! Уф!
Dialogue: 0,0:22:18.68,0:22:20.68,Default,,0,0,0,,≪Бұл біреу емес! ≫
Dialogue: 0,0:22:22.34,0:22:24.39,Default,,0,0,0,,Сіздің лас сакеңізбен→
Dialogue: 0,0:22:24.39,0:22:27.29,Default,,0,0,0,,Біреудің өмірін сатып ала алмайсың, ақымақ!!
Dialogue: 0,0:22:29.61,0:22:31.76,Default,,0,0,0,,≪ Қарғыс атсын! Орындалды≫
Dialogue: 0,0:22:31.76,0:22:35.73,Default,,0,0,0,,≪Бірақ мен оған қарап отырып өкініп қалғым келмейді! ≫
Dialogue: 0,0:22:35.73,0:22:37.77,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:22:37.77,0:22:41.69,Default,,0,0,0,,Күте тұрыңыз! Бұл жігіт мас болып қалады.
Dialogue: 0,0:22:41.69,0:22:45.03,Default,,0,0,0,,Аузыңды аш.
Dialogue: 0,0:22:45.03,0:22:49.11,Default,,0,0,0,,Сооо... Пух!
Dialogue: 0,0:22:49.11,0:22:51.15,Default,,0,0,0,,Уф! Апыр-ай!
Dialogue: 0,0:22:51.15,0:23:03.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:03.70,0:23:05.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:07.72,0:23:10.29,Default,,0,0,0,,Қазір, Алибаба-кун!
Dialogue: 0,0:23:10.29,0:23:12.34,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:23:12.34,0:23:15.16,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:15.16,0:23:19.11,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:23:19.11,0:23:22.83,Default,,0,0,0,,Әй, асығыңыз! (2 адам) А...
Dialogue: 0,0:23:22.83,0:23:24.87,Default,,0,0,0,,Аһ!
Dialogue: 0,0:23:24.87,0:23:29.74,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:29.74,0:23:33.28,Default,,0,0,0,,Менде алкоголь жеткіліксіз. Апыр-ай!
Dialogue: 0,0:23:33.28,0:23:40.95,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:40.95,0:23:43.84,Default,,0,0,0,,Hmph. Өйткені сен маған қарсы шықтың.
Dialogue: 0,0:23:43.84,0:23:45.82,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:23:45.82,0:23:48.66,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:48.66,0:23:50.86,Default,,0,0,0,,Ұш! Сиқырлы тақия!
Dialogue: 0,0:23:54.28,0:23:58.65,Default,,0,0,0,,≪Ах~аа... мен өлемін бе?≫
Dialogue: 0,0:23:58.65,0:24:01.65,Default,,0,0,0,,≪Бірақ оған көмектесу мүмкін емес≫
Dialogue: 0,0:24:01.65,0:24:04.36,Default,,0,0,0,,Әрқашан өтірік айту →
Dialogue: 0,0:24:04.36,0:24:06.76,Default,,0,0,0,,Ештеңе істеме...
Dialogue: 0,0:24:06.76,0:24:09.56,Default,,0,0,0,,Маған ақша мен билік керек.
Dialogue: 0,0:24:12.40,0:24:16.60,Default,,0,0,0,,Бірақ... Бірақ мен шынымен қалайтыным...
Dialogue: 0,0:24:18.04,0:24:20.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:22.12,0:24:25.78,Default,,0,0,0,,Өтірікші екенсің ғой, аға.
Dialogue: 0,0:24:25.78,0:24:28.96,Default,,0,0,0,,Сіз шындықты айта аласыз, солай ма?
Dialogue: 0,0:24:28.96,0:24:31.75,Default,,0,0,0,,Ақшаға да, ішімдікке де сатып ала алмайтын нәрселер→
Dialogue: 0,0:24:31.75,0:24:34.75,Default,,0,0,0,,Толығырақ айтып беріңізші. Ах...
Dialogue: 0,0:24:36.15,0:24:38.96,Default,,0,0,0,,≫ (Будель) Тоқта! Сол бала →
Dialogue: 0,0:24:38.96,0:24:42.01,Default,,0,0,0,,1000 жыл еңбек етсең де, ішімдік сатып ала алмайсың.
Dialogue: 0,0:24:42.01,0:24:44.26,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:24:44.26,0:24:48.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:48.77,0:24:50.92,Default,,0,0,0,,Жоқ!!
Dialogue: 0,0:24:50.92,0:25:07.92,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:16.18,0:25:18.23,Default,,0,0,0,,Хехе.
Dialogue: 0,0:25:18.23,0:25:21.28,Default,,0,0,0,,Мина! (Мина) Уау! →
Dialogue: 0,0:25:21.28,0:25:25.19,Default,,0,0,0,,Анашым! Жарайды, жарайды... у...
Dialogue: 0,0:25:25.19,0:25:27.19,Default,,0,0,0,,Уф… Вау….
Dialogue: 0,0:25:32.06,0:25:35.68,Default,,0,0,0,,Аладдин…. Эй Алибаба-кун→
Dialogue: 0,0:25:35.68,0:25:38.80,Default,,0,0,0,,Менің сенен бір жақсылығым бар.
Dialogue: 0,0:25:38.80,0:25:40.90,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:25:42.29,0:25:45.82,Default,,0,0,0,,((Иә, жақсы. Саған тілегім →
Dialogue: 0,0:25:45.82,0:25:47.86,Default,,0,0,0,,Бір ғана))
Dialogue: 0,0:25:47.86,0:25:51.05,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:51.05,0:25:53.05,Default,,0,0,0,,Менің досым бол.
Dialogue: 0,0:25:55.52,0:25:57.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:58.90,0:26:01.42,Default,,0,0,0,,Хехе.
Dialogue: 0,0:26:01.42,0:26:04.43,Default,,0,0,0,,≪(Будель) Балалар, түсіңдер! →
Dialogue: 0,0:26:04.43,0:26:07.13,Default,,0,0,0,,Жарайды, маған... →
Dialogue: 0,0:26:07.13,0:26:10.18,Default,,0,0,0,,Мен сені өмір бойы төлеймін! →
Dialogue: 0,0:26:10.18,0:26:12.77,Default,,0,0,0,,≪Мен сені құлыма айналдырамын~! Кеттік, Уго-кун.
Dialogue: 0,0:26:12.77,0:26:14.80,Default,,0,0,0,,Мені құл ет →
Dialogue: 0,0:26:14.80,0:26:17.09,Default,,0,0,0,,Мен сені сүйреп апарамын!
Dialogue: 0,0:26:17.09,0:26:21.41,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:21.41,0:26:25.21,Default,,0,0,0,,Әлібаба-күн ағайдың құлы болмайды!
Dialogue: 0,0:26:26.78,0:26:28.82,Default,,0,0,0,,Өйткені бұдан былай →
Dialogue: 0,0:26:28.82,0:26:30.82,Default,,0,0,0,,Мен шытырман оқиғаға бара жатырмын.
Dialogue: 0,0:26:32.27,0:26:36.22,Default,,0,0,0,,А, кеттік. Лабиринтке!
Dialogue: 0,0:26:36.22,0:26:38.63,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:26:38.63,0:26:44.93,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:17.58,0:28:20.20,Default,,0,0,0,,Бұл лабиринт. Жарайды, қандай қазына →
Dialogue: 0,0:28:20.20,0:28:22.48,Default,,0,0,0,,Қазір алыңыз! Бірақ мен→
Dialogue: 0,0:28:22.48,0:28:25.78,Default,,0,0,0,,Менің қарным ашты. Уф...
Dialogue: 0,0:28:28.32,0:28:30.32,Default,,0,0,0,,Не болды? Аладдин!
Dialogue: 0,0:30:42.10,0:30:44.06,Default,,0,0,0,,Бүгін түстен кейін, Сайтама префектурасының Кавагое қаласында,
Dialogue: 0,0:30:45.96,0:30:48.56,Default,,0,0,0,,Спартакиададан кейін толық емес орта мектеп алаңында,
Dialogue: 0,0:30:48.56,0:30:50.76,Default,,0,0,0,,Жеңіл жүк көлігі кенет іске қосылды
Dialogue: 0,0:30:55.42,0:30:58.09,Default,,0,0,0,,Бастауыш сыныптың төрт оқушысы қағып, ауыр және жеңіл жарақат алды.
Dialogue: 0,0:30:58.09,0:31:00.04,Default,,0,0,0,,Оқиға орнынан эстафета.
Dialogue: 0,0:31:01.54,0:31:06.54,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
