Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.70,0:00:41.46,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:41.46,0:00:43.50,Default,,0,0,0,,Күрсін.
Dialogue: 0,0:00:43.50,0:00:48.10,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:48.10,0:00:51.52,Default,,0,0,0,,Бұл Амонға кіретін есік. Ақыры осында.
Dialogue: 0,0:00:51.52,0:00:55.37,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:55.37,0:00:57.71,Default,,0,0,0,,Мен оны бір саусақпен ғана түрттім, бірақ бұл аяқталды→
Dialogue: 0,0:00:57.71,0:01:00.20,Default,,0,0,0,,Мен лабиринтке сүйредім.
Dialogue: 0,0:01:00.20,0:01:03.60,Default,,0,0,0,,Ал олардың көпшілігі орала алмайды.
Dialogue: 0,0:01:04.97,0:01:08.70,Default,,0,0,0,,Өлімге апаратын қақпа.
Dialogue: 0,0:01:08.70,0:01:12.89,Default,,0,0,0,,Аладдин Егер сіз артқа бұрылсаңыз, бұл сіздің соңғы мүмкіндігіңіз.
Dialogue: 0,0:01:12.89,0:01:14.89,Default,,0,0,0,,Гррррр (асқазан дыбыстары)
Dialogue: 0,0:01:21.83,0:01:23.83,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:01:26.11,0:01:28.44,Default,,0,0,0,,Уау!!
Dialogue: 0,0:01:28.44,0:01:39.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:39.34,0:01:41.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:43.74,0:01:46.04,Default,,0,0,0,,Не... не? бұл.
Dialogue: 0,0:01:47.86,0:01:51.36,Default,,0,0,0,,Уау! Уау...
Dialogue: 0,0:01:52.72,0:03:20.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:25.07,0:03:28.73,Default,,0,0,0,,≪Хмм? Не? Мұнда≫
Dialogue: 0,0:03:28.73,0:03:31.23,Default,,0,0,0,,≪Мен ештеңе көрмеймін≫
Dialogue: 0,0:03:32.70,0:03:35.15,Default,,0,0,0,,≪Мен тіпті дем ала алмаймын...≫
Dialogue: 0,0:03:35.15,0:03:37.32,Default,,0,0,0,,≪Тыныс алу? Ол аурады! ≫
Dialogue: 0,0:03:37.32,0:03:39.74,Default,,0,0,0,,Буха! Гах...
Dialogue: 0,0:03:39.74,0:03:42.84,Default,,0,0,0,,Пуха! Гохо, гохо, гохо!
Dialogue: 0,0:03:45.18,0:03:47.18,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:03:52.05,0:03:54.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:59.69,0:04:03.59,Default,,0,0,0,,Мына жігіт... Ха! Аладдин.
Dialogue: 0,0:04:06.83,0:04:08.83,Default,,0,0,0,,Аладдин!
Dialogue: 0,0:04:13.09,0:04:15.09,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:23.23,0:04:27.24,Default,,0,0,0,,Бұл жанып тұрған су. Шамдарға арналған майға қарағанда жақсы →
Dialogue: 0,0:04:27.24,0:04:30.02,Default,,0,0,0,,Ол өте жақсы жанады.
Dialogue: 0,0:04:30.02,0:04:32.34,Default,,0,0,0,,Егер сіз бірінші қадамды жасауға тартынсаңыз→
Dialogue: 0,0:04:32.34,0:04:34.63,Default,,0,0,0,,Бұл сіздің сыртта екеніңізді білдіре ме?
Dialogue: 0,0:04:34.63,0:04:38.10,Default,,0,0,0,,Бұл керемет, Алибаба-кун.
Dialogue: 0,0:04:38.10,0:04:40.27,Default,,0,0,0,,Бұл лабиринт.
Dialogue: 0,0:04:40.27,0:04:44.10,Default,,0,0,0,,Ах, а... Бұл лабиринт.
Dialogue: 0,0:04:44.10,0:04:49.18,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:49.18,0:04:52.44,Default,,0,0,0,,≫ (Стюарт) Лордтың өзі лабиринтке енді...→
Dialogue: 0,0:04:52.44,0:04:55.50,Default,,0,0,0,,Қайта қарастырыңыз.
Dialogue: 0,0:04:55.50,0:05:00.00,Default,,0,0,0,,Мен оны көптен бері күттім.
Dialogue: 0,0:05:02.04,0:05:06.54,Default,,0,0,0,,Жоғары мақсат қоятын кез келді.
Dialogue: 0,0:05:06.54,0:05:08.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:10.60,0:05:12.80,Default,,0,0,0,,Сооо... Пух! (ысқырық дыбысы)
Dialogue: 0,0:05:24.03,0:05:28.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:28.11,0:05:31.50,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:05:31.50,0:05:34.90,Default,,0,0,0,,Уф, бұл қауіпті болды.
Dialogue: 0,0:05:37.17,0:05:40.41,Default,,0,0,0,,Сіздің түсіңіз нашар көрінеді ме? бәрі жақсы.
Dialogue: 0,0:05:40.41,0:05:42.91,Default,,0,0,0,,Менің қарным аздап ашты.
Dialogue: 0,0:05:44.33,0:05:47.50,Default,,0,0,0,,Уго-кунды шақыру үшін маған асқазанның күші керек →
Dialogue: 0,0:05:47.50,0:05:49.87,Default,,0,0,0,,Бұл қажет. сондықтан….
Dialogue: 0,0:05:49.87,0:05:53.02,Default,,0,0,0,,Grrrrr
Dialogue: 0,0:05:53.02,0:05:56.03,Default,,0,0,0,,Менің қарным ашты...
Dialogue: 0,0:05:56.03,0:06:00.13,Default,,0,0,0,,≪Жоқ... Мен киімімді ғана секіріп кірдім≫
Dialogue: 0,0:06:02.63,0:06:05.38,Default,,0,0,0,,Хаха, үрейленбе.
Dialogue: 0,0:06:05.38,0:06:08.09,Default,,0,0,0,,Біз тамақты әйтеуір табамыз.
Dialogue: 0,0:06:08.09,0:06:11.51,Default,,0,0,0,,Мені кенет тістеп алма.
Dialogue: 0,0:06:11.51,0:06:14.33,Default,,0,0,0,,Кики Кики! Ах!
Dialogue: 0,0:06:14.33,0:06:16.41,Default,,0,0,0,,Ала... Аладдин?
Dialogue: 0,0:06:16.41,0:06:19.41,Default,,0,0,0,,≪A… Alibaba-kun…. иә?
Dialogue: 0,0:06:20.85,0:06:24.64,Default,,0,0,0,,Ха! Өтінемін маған көмектесіңіз.
Dialogue: 0,0:06:24.64,0:06:26.72,Default,,0,0,0,,Маған көмектесіңізші...
Dialogue: 0,0:06:26.72,0:06:30.09,Default,,0,0,0,,Гияа!!
Dialogue: 0,0:06:30.09,0:06:32.91,Default,,0,0,0,,Қишар!
Dialogue: 0,0:06:32.91,0:06:36.31,Default,,0,0,0,,Кикики… Кики… Кикики…
Dialogue: 0,0:06:38.43,0:06:41.49,Default,,0,0,0,,Сәлем! Хахаха….
Dialogue: 0,0:06:41.49,0:06:44.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:44.59,0:06:47.94,Default,,0,0,0,,Қарғыс атсын! Кілт!
Dialogue: 0,0:06:47.94,0:06:50.50,Default,,0,0,0,,Келме! Заш!
Dialogue: 0,0:06:50.50,0:06:52.87,Default,,0,0,0,,Не? Бұл жігіт. Бұл таңқаларлық нәзік.
Dialogue: 0,0:06:52.87,0:06:56.22,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:56.22,0:06:58.27,Default,,0,0,0,,Кики-ки! Ки-ки-ки!
Dialogue: 0,0:06:58.27,0:07:00.31,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:00.31,0:07:06.66,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:06.66,0:07:08.66,Default,,0,0,0,,Сәлем! Заш!
Dialogue: 0,0:07:10.08,0:07:12.37,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:07:12.37,0:07:16.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:16.21,0:07:18.24,Default,,0,0,0,,Не?
Dialogue: 0,0:07:18.24,0:07:24.48,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:24.48,0:07:26.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:26.53,0:07:33.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:33.84,0:07:35.84,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:37.68,0:07:40.38,Default,,0,0,0,,Қарғыс атсын! Уго-кун...
Dialogue: 0,0:07:40.38,0:07:43.27,Default,,0,0,0,,Пух!
Dialogue: 0,0:07:43.27,0:07:45.30,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:45.30,0:07:51.14,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:51.14,0:07:55.23,Default,,0,0,0,,Сізге енді құпия трюктарыңызды қолданудың қажеті жоқ. Сооо...
Dialogue: 0,0:07:55.23,0:07:58.05,Default,,0,0,0,,Пух!!
Dialogue: 0,0:07:58.05,0:08:01.22,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:01.22,0:08:03.69,Default,,0,0,0,,Не? Құс сияқты...
Dialogue: 0,0:08:03.69,0:08:16.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:16.58,0:08:18.68,Default,,0,0,0,,Догун!
Dialogue: 0,0:08:18.68,0:08:24.18,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:26.78,0:08:30.86,Default,,0,0,0,,Иә! Апыр-ай! Хехе...
Dialogue: 0,0:08:30.86,0:08:32.96,Default,,0,0,0,,Уго-кун күшті, солай ма?
Dialogue: 0,0:08:34.28,0:08:38.07,Default,,0,0,0,,Бар күшімізді салып, мақсатқа бірге жетейік... жарайды...
Dialogue: 0,0:08:38.07,0:08:40.57,Default,,0,0,0,,А... Аладдин!
Dialogue: 0,0:08:42.81,0:08:53.25,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:53.25,0:08:55.55,Default,,0,0,0,,≪Олар маған үнемі көмектесіп тұрады≫
Dialogue: 0,0:08:57.44,0:09:00.99,Default,,0,0,0,,≪Бұл флейта шынымен де соншалықты қажет болды ма?≫
Dialogue: 0,0:09:00.99,0:09:08.03,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:08.03,0:09:12.39,Default,,0,0,0,,Сооо... Сооооо
Dialogue: 0,0:09:12.39,0:09:14.42,Default,,0,0,0,,Хаха.
Dialogue: 0,0:09:14.42,0:09:18.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:18.99,0:09:21.03,Default,,0,0,0,,≪Бұл қай тіл? ≫
Dialogue: 0,0:09:21.03,0:09:23.03,Default,,0,0,0,,<<Аладдинді оқи аласыз ба? ≫
Dialogue: 0,0:09:25.17,0:09:27.75,Default,,0,0,0,,≪Иә, мен бұл жігітті айтып отырмын→
Dialogue: 0,0:09:27.75,0:09:30.32,Default,,0,0,0,,Сіз әлі ештеңе білмейсіз≫
Dialogue: 0,0:09:30.32,0:09:34.02,Default,,0,0,0,,≪Бірақ бұл табиғи ма? Мен де өзім туралы айтпаймын.
Dialogue: 0,0:09:35.43,0:09:38.83,Default,,0,0,0,,≪Бірақ бұл жігіт маған көп нәрсе жасап жатыр...≫
Dialogue: 0,0:09:41.43,0:09:43.59,Default,,0,0,0,,≪Ақырында сөйлесу керек→
Dialogue: 0,0:09:43.59,0:09:45.64,Default,,0,0,0,,Мен лабиринтке не үшін кірдім?
Dialogue: 0,0:09:45.64,0:09:50.68,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:50.68,0:09:54.56,Default,,0,0,0,,≪Қабылданды. Мен сөйлесемін, Аладдин
Dialogue: 0,0:09:54.56,0:09:56.67,Default,,0,0,0,,≪Мен сізге әртүрлі сұрақтар қоямын≫
Dialogue: 0,0:09:56.67,0:09:59.67,Default,,0,0,0,,≪Лабиринтті жалғыз бағындыра алмайсың≫
Dialogue: 0,0:10:11.91,0:10:13.95,Default,,0,0,0,,Аа... Ах!
Dialogue: 0,0:10:13.95,0:10:19.25,Default,,0,0,0,,≪Кеңестер, кеңестер, кеңестер...(аяқ дыбыстары)
Dialogue: 0,0:10:21.46,0:10:23.46,Default,,0,0,0,,≪Неге мырза...≫
Dialogue: 0,0:10:24.88,0:10:27.48,Default,,0,0,0,,≪Сіз шынымен де бізден кейін келдіңіз бе? ≫
Dialogue: 0,0:10:29.08,0:10:31.08,Default,,0,0,0,,≪Жала (тізбектердің дыбысы) Ха!
Dialogue: 0,0:10:33.22,0:10:37.42,Default,,0,0,0,,Қарғыс атсын! Ой... уау...
Dialogue: 0,0:10:37.42,0:10:39.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:39.46,0:10:41.46,Default,,0,0,0,,≪Бұл бала...≫
Dialogue: 0,0:10:43.26,0:10:45.26,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:10:48.37,0:10:50.55,Default,,0,0,0,,Сіз осындай жерде болдыңыз ба?
Dialogue: 0,0:10:50.55,0:10:52.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:54.57,0:10:56.63,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:10:56.63,0:11:02.71,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:02.71,0:11:06.00,Default,,0,0,0,,Мен сені күттім, Маги...→
Dialogue: 0,0:11:06.00,0:11:10.00,Default,,0,0,0,,Мен сенің менің алдымда шыққаныңды 10 жыл бойы көрдім.
Dialogue: 0,0:11:12.19,0:11:14.69,Default,,0,0,0,,≪Magi? Не? Бұл≫
Dialogue: 0,0:11:16.81,0:11:18.85,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:11:18.85,0:11:20.88,Default,,0,0,0,,Күте тұрыңыз... не?!
Dialogue: 0,0:11:20.88,0:11:23.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:23.99,0:11:26.39,Default,,0,0,0,,Күте тұрыңыз. Не айтқың келеді!?
Dialogue: 0,0:11:26.39,0:11:30.23,Default,,0,0,0,,Күрсіну…. Бұл менің желісім.
Dialogue: 0,0:11:30.23,0:11:32.79,Default,,0,0,0,,Сен маған енді керек емессің, үйге қайт.
Dialogue: 0,0:11:32.79,0:11:36.82,Default,,0,0,0,,Қарғыс атсын! Күте тұрыңыз!
Dialogue: 0,0:11:36.82,0:11:40.24,Default,,0,0,0,,күрсіну. Гортасты өлтіріңіз.
Dialogue: 0,0:11:40.24,0:11:42.34,Default,,0,0,0,,Өлтіру? Тынш....
Dialogue: 0,0:11:42.34,0:11:45.34,Default,,0,0,0,,Ах! Хмм….
Dialogue: 0,0:11:45.34,0:11:49.88,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:49.88,0:11:52.20,Default,,0,0,0,,Қарғыс атсын! Хмф!
Dialogue: 0,0:11:52.20,0:11:55.20,Default,,0,0,0,,Ах. Ой...
Dialogue: 0,0:11:55.20,0:11:57.20,Default,,0,0,0,,Сіз кенеттен не істеп жатырсыз?
Dialogue: 0,0:11:58.92,0:12:00.96,Default,,0,0,0,,Сіз керемет емессіз бе? →
Dialogue: 0,0:12:00.96,0:12:03.36,Default,,0,0,0,,Мен оны қарап шықтым. иә?
Dialogue: 0,0:12:03.36,0:12:05.79,Default,,0,0,0,,Уф... → салыстырғанда
Dialogue: 0,0:12:05.79,0:12:08.11,Default,,0,0,0,,Сіз оны пайдалана алмайсыз.
Dialogue: 0,0:12:08.11,0:12:10.27,Default,,0,0,0,,Еңбек – адамның міндеті. Уф...
Dialogue: 0,0:12:10.27,0:12:13.05,Default,,0,0,0,,Одан да адам баласының құлдары→
Dialogue: 0,0:12:13.05,0:12:15.12,Default,,0,0,0,,Жұмыс істеуге шыдамаймын... →
Dialogue: 0,0:12:15.12,0:12:17.41,Default,,0,0,0,,Мен оны қалай толық жазалай аламын? Ой... ой...
Dialogue: 0,0:12:17.41,0:12:21.21,Default,,0,0,0,,Бұл туралы ма? Бұл туралы ма?
Dialogue: 0,0:12:21.21,0:12:23.26,Default,,0,0,0,,≪Бұл не жігіт...≫
Dialogue: 0,0:12:23.26,0:12:25.98,Default,,0,0,0,,Иә, сіз. Ах!
Dialogue: 0,0:12:25.98,0:12:28.75,Default,,0,0,0,,Мен үшін жұмыс істегіңіз келе ме?
Dialogue: 0,0:12:28.75,0:12:32.70,Default,,0,0,0,,Мен өзіммен бірге көптеген жалдамалылар мен құлдарды ала келдім.→
Dialogue: 0,0:12:32.70,0:12:36.43,Default,,0,0,0,,Егер сіз оны тұзақтарды болдырмау үшін қолдансаңыз, ол одан сайын жаншып кетеді.
Dialogue: 0,0:12:36.43,0:12:39.80,Default,,0,0,0,,Сіз лордсыз, солай ма? иә. →
Dialogue: 0,0:12:39.80,0:12:43.57,Default,,0,0,0,,Мен жай ғана аумақ сеніп тапсырылған адаммын. →
Dialogue: 0,0:12:43.57,0:12:46.20,Default,,0,0,0,,Бұл тітіркендіргіш, солай емес пе?
Dialogue: 0,0:12:46.20,0:12:49.20,Default,,0,0,0,,А... Өйткені, солай емес пе!? →
Dialogue: 0,0:12:49.20,0:12:51.26,Default,,0,0,0,,Міне, мен →
Dialogue: 0,0:12:51.26,0:12:53.41,Default,,0,0,0,,Декунобоның оққағары →
Dialogue: 0,0:12:53.41,0:12:57.73,Default,,0,0,0,,Төменгі дәрежем мен тамағыма қанағаттанатыныма сене алар емеспін.
Dialogue: 0,0:12:57.73,0:12:59.90,Default,,0,0,0,,Мен лабиринтті бағындырдым →
Dialogue: 0,0:12:59.90,0:13:03.07,Default,,0,0,0,,Мен өз елімді аламын! →
Dialogue: 0,0:13:03.07,0:13:06.07,Default,,0,0,0,,Жолыма түскендердің бәрін өлтіремін!
Dialogue: 0,0:13:08.64,0:13:11.99,Default,,0,0,0,,Сонымен... сіз ше?
Dialogue: 0,0:13:11.99,0:13:13.99,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:13:18.18,0:13:22.80,Default,,0,0,0,,Уау, бұл өте жақсы қақпа. →
Dialogue: 0,0:13:22.80,0:13:27.40,Default,,0,0,0,,Бұл кейіпкер... Ммм. Бұл транс тілі.
Dialogue: 0,0:13:28.93,0:13:31.08,Default,,0,0,0,,Бұлай етпе, жігітім. Қарапайым адам ретінде →
Dialogue: 0,0:13:31.08,0:13:34.45,Default,,0,0,0,,Тіпті оқи білу де сирек кездеседі.
Dialogue: 0,0:13:34.45,0:13:36.45,Default,,0,0,0,,Не... сәлем.
Dialogue: 0,0:13:38.20,0:13:40.84,Default,,0,0,0,,Транг тілінде сөйлеу үшін өте жоғары білім алу керек→
Dialogue: 0,0:13:40.84,0:13:43.36,Default,,0,0,0,,Әдетте мен оны оқи алмауым керек.
Dialogue: 0,0:13:43.36,0:13:46.96,Default,,0,0,0,,Мен мұны ескі храмдар мен лабиринттердегі нәрсе деп естідім→
Dialogue: 0,0:13:46.96,0:13:50.87,Default,,0,0,0,,Бұл өзін-өзі үйретеді... Хмм. →
Dialogue: 0,0:13:50.87,0:13:54.10,Default,,0,0,0,,Мұғалімнен дұрыс үйрендім. →
Dialogue: 0,0:13:54.10,0:13:57.92,Default,,0,0,0,,Ерм... «Бұл белгісіз айдаһардікі»...→
Dialogue: 0,0:13:57.92,0:14:01.49,Default,,0,0,0,,Иә? «Билейтін шындық нүктесі»...
Dialogue: 0,0:14:01.49,0:14:03.71,Default,,0,0,0,,≪Сіз құмар ойнағыңыз келе ме?≫
Dialogue: 0,0:14:03.71,0:14:06.08,Default,,0,0,0,,«Торнадомен билеу→
Dialogue: 0,0:14:06.08,0:14:08.50,Default,,0,0,0,,Айдаһардың иегін кесіп өту→
Dialogue: 0,0:14:08.50,0:14:11.15,Default,,0,0,0,,Шындыққа жету →
Dialogue: 0,0:14:11.15,0:14:13.96,Default,,0,0,0,,Барлығы айдаһардың құйрығында» →
Dialogue: 0,0:14:13.96,0:14:15.99,Default,,0,0,0,,емес пе?
Dialogue: 0,0:14:15.99,0:14:19.76,Default,,0,0,0,,Келіңіздер! Енді айтайын ба деп ойладым.
Dialogue: 0,0:14:19.76,0:14:23.13,Default,,0,0,0,,Бірақ бұл дұрыс. Аударма дұрыс па? →
Dialogue: 0,0:14:23.13,0:14:25.17,Default,,0,0,0,,Оны өзім дәлелдеймін.
Dialogue: 0,0:14:25.17,0:14:32.86,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:32.86,0:14:36.09,Default,,0,0,0,,≪Аладдин мен үшін денесін сызыққа қойды≫
Dialogue: 0,0:14:36.09,0:14:38.11,Default,,0,0,0,,≪Енді менің кезегім≫
Dialogue: 0,0:14:38.11,0:14:44.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:44.35,0:14:46.39,Default,,0,0,0,,Күрсіну…. Қарғыс атсын!
Dialogue: 0,0:14:46.39,0:14:50.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:50.53,0:14:52.58,Default,,0,0,0,,≪“Торнадомен билеу”≫
Dialogue: 0,0:14:52.58,0:14:56.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:56.11,0:14:58.11,Default,,0,0,0,,О, мен мұны істеймін.
Dialogue: 0,0:14:59.50,0:15:02.02,Default,,0,0,0,,Аһ!
Dialogue: 0,0:15:02.02,0:15:04.36,Default,,0,0,0,,Тезірек ауысыңыз!
Dialogue: 0,0:15:04.36,0:15:11.45,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:11.45,0:15:13.48,Default,,0,0,0,,Гаскон (дыбысты ауыстыру)
Dialogue: 0,0:15:13.48,0:15:18.10,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:18.10,0:15:20.09,Default,,0,0,0,,Енді.
Dialogue: 0,0:15:20.09,0:15:23.74,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:23.74,0:15:26.53,Default,,0,0,0,,Аа... Арх!
Dialogue: 0,0:15:26.53,0:15:28.63,Default,,0,0,0,,Уау!!
Dialogue: 0,0:15:38.42,0:15:40.82,Default,,0,0,0,,Әй, бейшара.
Dialogue: 0,0:15:49.18,0:15:51.22,Default,,0,0,0,,Хмм….
Dialogue: 0,0:15:51.22,0:15:53.59,Default,,0,0,0,,Хмм…. О?
Dialogue: 0,0:15:53.59,0:15:55.59,Default,,0,0,0,,Сіз ояусыз ба? Маги.
Dialogue: 0,0:16:00.76,0:16:03.26,Default,,0,0,0,,Иә? Alibaba ше?
Dialogue: 0,0:18:05.67,0:18:09.66,Default,,0,0,0,,Аға~ Аға маған көмектесті ме?
Dialogue: 0,0:18:09.66,0:18:14.10,Default,,0,0,0,,Иә. Сыбызғыңмен алдымнан кеткен дос →
Dialogue: 0,0:18:14.10,0:18:16.92,Default,,0,0,0,,Мен сені міндетті түрде тауып беремін.
Dialogue: 0,0:18:16.92,0:18:20.02,Default,,0,0,0,,Хэхехе. Хмм.
Dialogue: 0,0:18:25.56,0:18:29.01,Default,,0,0,0,,Ах~ Екеуің менің құлымсыңдар.
Dialogue: 0,0:18:29.01,0:18:31.53,Default,,0,0,0,,Үлкені - Гортас. →
Dialogue: 0,0:18:31.53,0:18:35.65,Default,,0,0,0,,Жарасынан сөйлей алмайтын солтүстіктен көшпелі тайпа→
Dialogue: 0,0:18:35.65,0:18:38.05,Default,,0,0,0,,Бұл өте күшті және үлкен күшке ие. →
Dialogue: 0,0:18:38.05,0:18:40.61,Default,,0,0,0,,Ең кішісі - Морджиана. →
Dialogue: 0,0:18:40.61,0:18:44.96,Default,,0,0,0,,Олар сол қараңғы құрлықты мекендеген аңшы тайпасының ұрпақтары. →
Dialogue: 0,0:18:44.96,0:18:49.28,Default,,0,0,0,,Оның мұрны өте жақсы, аяқтары күшті. →
Dialogue: 0,0:18:49.28,0:18:51.68,Default,,0,0,0,,Екеуі де қымбат болды.
Dialogue: 0,0:18:51.68,0:18:55.52,Default,,0,0,0,,Хмм. Ал...→
Dialogue: 0,0:18:55.52,0:18:58.57,Default,,0,0,0,,Мен жақын арада осы жерден тергейтін боламын. →
Dialogue: 0,0:18:58.57,0:19:00.77,Default,,0,0,0,,Әйелдер мен балалар, осы жерде күтіңіздер. →
Dialogue: 0,0:19:02.48,0:19:04.48,Default,,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:19:08.95,0:19:11.45,Default,,0,0,0,,Қайта кездескенше, апа.
Dialogue: 0,0:19:15.07,0:19:17.07,Default,,0,0,0,,Хмм….
Dialogue: 0,0:19:28.50,0:19:31.62,Default,,0,0,0,,≫Шул шул шул... Иә?
Dialogue: 0,0:19:31.62,0:19:34.43,Default,,0,0,0,,Мырзаларым.
Dialogue: 0,0:19:34.43,0:19:36.61,Default,,0,0,0,,Фуфу… уф….
Dialogue: 0,0:19:36.61,0:19:39.20,Default,,0,0,0,,Ах. Алақай!
Dialogue: 0,0:19:39.20,0:19:41.42,Default,,0,0,0,,Ақыры сәл күлдіңіз, апа.
Dialogue: 0,0:19:41.42,0:19:43.82,Default,,0,0,0,,Мен күлмеймін. Әпке →
Dialogue: 0,0:19:43.82,0:19:45.82,Default,,0,0,0,,Күлімдегенде әдемі көрінесің.
Dialogue: 0,0:19:48.14,0:19:51.94,Default,,0,0,0,,Бірақ сіз біртүрлі көрінесіз.
Dialogue: 0,0:19:51.94,0:19:54.84,Default,,0,0,0,,Қараңғы континент деген елден келгендіктен бе?
Dialogue: 0,0:19:56.53,0:19:59.23,Default,,0,0,0,,Қараңғы емес. иә?
Dialogue: 0,0:19:59.23,0:20:02.47,Default,,0,0,0,,Қараңғы континент – «Рейм империясының оңтүстігі→
Dialogue: 0,0:20:02.47,0:20:04.87,Default,,0,0,0,,«Дамылмаған» деген мағынада аталған→
Dialogue: 0,0:20:04.87,0:20:09.86,Default,,0,0,0,,Менің туған қалам Каталгоға қатысты кемсітетін термин. Өтінемін тоқта.
Dialogue: 0,0:20:09.86,0:20:13.21,Default,,0,0,0,,Аа~ Бұл игерілмеген жер ме?
Dialogue: 0,0:20:13.21,0:20:15.21,Default,,0,0,0,,Ол дамымаған.
Dialogue: 0,0:20:17.30,0:20:21.19,Default,,0,0,0,,Негізі ел бар, ауыл да бар→
Dialogue: 0,0:20:21.19,0:20:23.29,Default,,0,0,0,,Күн әдемі→
Dialogue: 0,0:20:23.29,0:20:27.43,Default,,0,0,0,,Жері кең, ірі жануарлары көп.
Dialogue: 0,0:20:27.43,0:20:30.92,Default,,0,0,0,,Сонымен қатар көптеген дәмді жемістер бар.
Dialogue: 0,0:20:30.92,0:20:35.00,Default,,0,0,0,,Бұл жақсы. Бұл шынымен көңілді орынға ұқсайды.
Dialogue: 0,0:20:35.00,0:20:38.74,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:38.74,0:20:42.54,Default,,0,0,0,,≪Иә. Бұл көңілді орын болатыны сөзсіз≫
Dialogue: 0,0:20:42.54,0:20:44.83,Default,,0,0,0,,>
Dialogue: 0,0:20:44.83,0:20:46.82,Default,,0,0,0,,Менің барғым келеді.
Dialogue: 0,0:20:46.82,0:20:49.62,Default,,0,0,0,,Мені туған жеріңе апар.
Dialogue: 0,0:20:51.55,0:20:55.36,Default,,0,0,0,,Бұл мүмкін емес. Неліктен?
Dialogue: 0,0:20:55.36,0:20:58.09,Default,,0,0,0,,Неліктен...→
Dialogue: 0,0:20:58.09,0:21:02.50,Default,,0,0,0,,Мен құлмын, сондықтан қашып құтыла алмаймын.
Dialogue: 0,0:21:02.50,0:21:05.77,Default,,0,0,0,,Бұрынғыдай шынжырларды үзіп алсаңыз, қашып құтыла аласыз.
Dialogue: 0,0:21:05.77,0:21:07.80,Default,,0,0,0,,Сіз ештеңе түсінбейсіз.
Dialogue: 0,0:21:07.80,0:21:10.81,Default,,0,0,0,,Лорд өте қорқынышты адам.
Dialogue: 0,0:21:10.81,0:21:14.94,Default,,0,0,0,,Тізбекті үзу арқылы құтылудың жолы жоқ.
Dialogue: 0,0:21:14.94,0:21:18.81,Default,,0,0,0,,Не? Сіз жасай аласыз. сен істей алмайсың.
Dialogue: 0,0:21:18.81,0:21:20.90,Default,,0,0,0,,Неліктен? Ах.
Dialogue: 0,0:21:20.90,0:21:23.59,Default,,0,0,0,,Кез келген нәрсе! Мен қолымнан келмейтін нәрсені істей алмаймын.
Dialogue: 0,0:21:23.59,0:21:26.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:26.59,0:21:31.06,Default,,0,0,0,,Мен көремін. Аға апаны көп айтатын көрінбейтін тізбек →
Dialogue: 0,0:21:31.06,0:21:33.16,Default,,0,0,0,,Бұл лордта бар.
Dialogue: 0,0:21:38.77,0:21:41.87,Default,,0,0,0,,Әпке, Алибаба қайда?
Dialogue: 0,0:21:41.87,0:21:45.07,Default,,0,0,0,,Ха! қайда?
Dialogue: 0,0:21:47.49,0:21:51.46,Default,,0,0,0,,Сенің досың үлкен ақымақ.
Dialogue: 0,0:21:51.46,0:21:54.57,Default,,0,0,0,,Бұл тәртіпсіздік. Оның мағынасы жоқ.
Dialogue: 0,0:21:54.57,0:21:57.05,Default,,0,0,0,,Мен өз ұстанымымды түсінбей, абайсызда әрекет еттім→
Dialogue: 0,0:21:57.05,0:22:00.12,Default,,0,0,0,,Өзіңізге көмектесе алмаған кезде басқаларға көмектесуге тырысу→
Dialogue: 0,0:22:00.12,0:22:04.71,Default,,0,0,0,,Соның арқасында досың... досың...→
Dialogue: 0,0:22:04.71,0:22:07.01,Default,,0,0,0,,Ол қайтыс болды. Ах...
Dialogue: 0,0:22:14.90,0:22:16.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:19.12,0:22:22.06,Default,,0,0,0,,Досың қайтыс болды.
Dialogue: 0,0:22:22.06,0:22:26.63,Default,,0,0,0,,Не? А... Иә, түсіндім.
Dialogue: 0,0:22:26.63,0:22:30.89,Default,,0,0,0,,Жағдайыңа абай болмасаң, сен де өлесің.
Dialogue: 0,0:22:30.89,0:22:32.92,Default,,0,0,0,,≫Шынымен емес!
Dialogue: 0,0:22:32.92,0:22:35.02,Default,,0,0,0,,Қарғыс атсын! Ах. Неге….
Dialogue: 0,0:22:35.02,0:22:37.68,Default,,0,0,0,,Өйткені мен өлмейтінмін. ≪Ах~!
Dialogue: 0,0:22:37.68,0:22:40.13,Default,,0,0,0,,Ах. Апыр-ай! Эй….
Dialogue: 0,0:22:40.13,0:22:42.60,Default,,0,0,0,,Маги Маги... Өтінемін. →
Dialogue: 0,0:22:42.60,0:22:45.35,Default,,0,0,0,,Әлгі құбыжық... Уау! Не...
Dialogue: 0,0:22:45.35,0:22:48.65,Default,,0,0,0,,Бұл жаман. Бұл аударма өтірік болды.
Dialogue: 0,0:22:48.65,0:22:50.69,Default,,0,0,0,,Не!? Дұрыс →
Dialogue: 0,0:22:50.69,0:22:53.02,Default,,0,0,0,,«Торнадомен билеу→
Dialogue: 0,0:22:53.02,0:22:57.60,Default,,0,0,0,,Шындық айдаһардың иегінде→
Dialogue: 0,0:22:57.60,0:23:02.95,Default,,0,0,0,,Айдаһардың құйрығына жеткенше бәрі!''
Dialogue: 0,0:23:02.95,0:23:06.02,Default,,0,0,0,,Сіздің арқаңызда мен дұрыс жолды таптым.
Dialogue: 0,0:23:06.02,0:23:09.42,Default,,0,0,0,,Рахмет, мырза! Ах...
Dialogue: 0,0:23:10.73,0:23:12.76,Default,,0,0,0,,Олай болса, сау бол!
Dialogue: 0,0:23:12.76,0:23:15.40,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:15.40,0:23:19.55,Default,,0,0,0,,Кешіріңіз, әпке. Бірақ қайта кездесейік →
Dialogue: 0,0:23:19.55,0:23:21.64,Default,,0,0,0,,Көрінбейтін тізбек үзілгенде →
Dialogue: 0,0:23:21.64,0:23:24.04,Default,,0,0,0,,Күнді бірге тамашалайық!
Dialogue: 0,0:23:24.04,0:23:26.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:26.09,0:23:35.65,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:35.65,0:23:38.82,Default,,0,0,0,,Морджиана! Ха... уф!
Dialogue: 0,0:23:38.82,0:23:42.37,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:42.37,0:23:45.01,Default,,0,0,0,,Эй, эй, эй, эй!
Dialogue: 0,0:23:45.01,0:23:48.01,Default,,0,0,0,,Аладдин шыңы! жоғарыда!
Dialogue: 0,0:23:48.01,0:23:51.87,Default,,0,0,0,,Қарғыс атсын! Сондай төмен адамға →
Dialogue: 0,0:23:51.87,0:23:53.87,Default,,0,0,0,,Ағам! Ағам! Геко ағам!
Dialogue: 0,0:23:55.94,0:23:58.54,Default,,0,0,0,,Уф! Қарғыс атсын! Қарғыс атсын! →
Dialogue: 0,0:23:59.96,0:24:03.56,Default,,0,0,0,,Мен сені өлтіремін. Мен сені міндетті түрде өлтіремін!
Dialogue: 0,0:24:05.86,0:24:08.42,Default,,0,0,0,,Бұл шындықтың есігі болуы керек.
Dialogue: 0,0:24:08.42,0:24:11.12,Default,,0,0,0,,Қазына алда.
Dialogue: 0,0:24:11.12,0:24:13.52,Default,,0,0,0,,Бұл сиқыр.
Dialogue: 0,0:24:13.52,0:24:18.19,Default,,0,0,0,,Сіз оны ашып көрдіңіз бе? жоқ. Есепке қараңыз.
Dialogue: 0,0:24:18.19,0:24:22.05,Default,,0,0,0,,Екі оң қол. Басқаша айтқанда, оны жалғыз аша алмайтын сияқтысыз.
Dialogue: 0,0:24:22.05,0:24:25.22,Default,,0,0,0,,Олай болса, екеуміз ғана болғанымызға қуаныштымын.
Dialogue: 0,0:24:25.22,0:24:27.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:28.82,0:24:30.81,Default,,0,0,0,,Сезамды ашыңыз!
Dialogue: 0,0:24:30.81,0:24:50.66,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:50.66,0:24:52.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:52.71,0:25:08.61,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:13.01,0:26:07.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:12.37,0:26:18.67,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:22.90,0:26:40.20,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:14.68,0:28:18.28,Default,,0,0,0,,Сіз Аладдинді күтіп жүрсіз бе!? Маған жол көрсететін адам сенсің. →
Dialogue: 0,0:28:18.28,0:28:20.98,Default,,0,0,0,,Енді тезірек мені патша етіңіз!
Dialogue: 0,0:28:24.47,0:28:26.97,Default,,0,0,0,,Бүйірлері ашық, балақай.
Dialogue: 0,0:30:42.93,0:30:45.08,Default,,0,0,0,,Жапония Демократиялық партиясының Бас хатшысы Кошииши былай деді:
Dialogue: 0,0:30:45.08,0:30:47.31,Default,,0,0,0,,Күзгі кезектен тыс диета сессиясы осы айдың соңында өтеді.
Dialogue: 0,0:30:48.12,0:30:50.62,Default,,0,0,0,,Жиналуға тілек білдірді.
Dialogue: 0,0:30:52.12,0:30:57.12,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
