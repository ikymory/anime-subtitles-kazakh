Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.36,0:00:36.42,Default,,0,0,0,,Ояну→
Dialogue: 0,0:00:36.42,0:00:39.61,Default,,0,0,0,,Патша өлді деген хабарды есту→
Dialogue: 0,0:00:39.61,0:00:42.31,Default,,0,0,0,,Мен сол күні Барбадтан қашып кеттім.
Dialogue: 0,0:00:43.68,0:00:45.73,Default,,0,0,0,,Содан кейін оазис қала кешенінде →
Dialogue: 0,0:00:45.73,0:00:48.37,Default,,0,0,0,,Күнкөріспен өмір сүр.
Dialogue: 0,0:00:48.37,0:00:51.72,Default,,0,0,0,,Бұл мен әрқашан таңданатын нәрсе болды, сондықтан мен лабиринтке кірдім→
Dialogue: 0,0:00:51.72,0:00:54.76,Default,,0,0,0,,Мен қазынаны алсам, мүмкін түзелетін шығармын...→
Dialogue: 0,0:00:54.76,0:00:57.83,Default,,0,0,0,,Мен мұны бірінші рет ойлап отырмын.
Dialogue: 0,0:00:57.83,0:01:00.37,Default,,0,0,0,,Бірақ бұл жай ғана әңгіме →
Dialogue: 0,0:01:00.37,0:01:03.27,Default,,0,0,0,,Мен күн сайын қалай болса да өтіп жаттым→
Dialogue: 0,0:01:04.64,0:01:07.64,Default,,0,0,0,,Аладдин Мен сені кездестіргенше.
Dialogue: 0,0:01:09.26,0:01:11.29,Default,,0,0,0,,Мен көремін.→
Dialogue: 0,0:01:11.29,0:01:15.01,Default,,0,0,0,,Ол бұрынғы патшаның заңсыз ұлы болды ма? (Жафар) Эй Шин→
Dialogue: 0,0:01:15.01,0:01:17.17,Default,,0,0,0,,Тыңдаудың дәмі нашар.
Dialogue: 0,0:01:17.17,0:01:19.45,Default,,0,0,0,,Тынш!
Dialogue: 0,0:01:19.45,0:01:22.52,Default,,0,0,0,,≪Бірақ мен әлі де түсінбейтін жерлерім бар.
Dialogue: 0,0:01:22.52,0:01:24.56,Default,,0,0,0,,Оқиға ойдағыдай болса→
Dialogue: 0,0:01:24.56,0:01:27.11,Default,,0,0,0,,Саған опасыздық жасаған Қасым.
Dialogue: 0,0:01:27.11,0:01:30.71,Default,,0,0,0,,Бірақ сен неге Тұман тобындасың?
Dialogue: 0,0:01:33.62,0:01:37.52,Default,,0,0,0,,Лабиринтті бағындырғаннан кейін, жаңа қадам жасамас бұрын→
Dialogue: 0,0:01:37.52,0:01:41.02,Default,,0,0,0,,Мен есепшотты шешу үшін Балбадқа оралдым.
Dialogue: 0,0:01:42.86,0:01:45.19,Default,,0,0,0,,Бірақ мен сонда көргенім...
Dialogue: 0,0:01:45.19,0:01:58.29,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:59.72,0:03:27.50,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:29.73,0:03:41.31,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:41.31,0:03:44.10,Default,,0,0,0,,((Ей, қария, Барбад бұл→
Dialogue: 0,0:03:44.10,0:03:46.76,Default,,0,0,0,,Бұл қалай болды? ))
Dialogue: 0,0:03:46.76,0:03:51.24,Default,,0,0,0,,((Мен не істесем де, бұлай істей алмаймын. Алдыңғы патша қайтыс болғаннан кейін →
Dialogue: 0,0:03:51.24,0:03:53.34,Default,,0,0,0,,Бәле болады))
Dialogue: 0,0:03:55.17,0:03:59.38,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:03:59.38,0:04:01.90,Default,,0,0,0,,) ((Ах. →
Dialogue: 0,0:04:01.90,0:04:04.00,Default,,0,0,0,,Осындай тұманды түнде...))
Dialogue: 0,0:04:05.43,0:04:07.95,Default,,0,0,0,,) ((Тұман командасы! Тұман командасы пайда болды!))
Dialogue: 0,0:04:07.95,0:04:10.17,Default,,0,0,0,,) ((Сәлем~!))
Dialogue: 0,0:04:10.17,0:04:12.37,Default,,0,0,0,,) ((уф!))
Dialogue: 0,0:04:14.73,0:04:22.72,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:22.72,0:04:29.79,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:29.79,0:04:32.86,Default,,0,0,0,,Қасым…. Ха.
Dialogue: 0,0:04:32.86,0:04:37.95,Default,,0,0,0,,Алғашында мен де елді ойрандап жүрген сол екен деп ойладым.
Dialogue: 0,0:04:37.95,0:04:41.05,Default,,0,0,0,,Бірақ әңгімені естігенде мүлде басқаша болды.
Dialogue: 0,0:04:42.54,0:04:46.34,Default,,0,0,0,,Шынында да ел кінәлі болды.
Dialogue: 0,0:04:48.66,0:04:50.71,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:50.71,0:04:53.31,Default,,0,0,0,,() ()
Dialogue: 0,0:04:53.31,0:04:56.13,Default,,0,0,0,,((Сіз патша сарайына барғаннан кейінгі жыл→
Dialogue: 0,0:04:56.13,0:04:59.44,Default,,0,0,0,,Қараңғы аудандарда оба тарады. →
Dialogue: 0,0:04:59.44,0:05:03.01,Default,,0,0,0,,Бірақ ел → дегенді де білмейді
Dialogue: 0,0:05:03.01,0:05:06.01,Default,,0,0,0,,Олар бізді оқшаулап, қараңғы үйлерге қамады. →
Dialogue: 0,0:05:07.36,0:05:10.15,Default,,0,0,0,,Дәрігер жоқ, дәрі жоқ→
Dialogue: 0,0:05:10.15,0:05:12.58,Default,,0,0,0,,Бұл тамақ... →
Dialogue: 0,0:05:12.58,0:05:17.02,Default,,0,0,0,,Осының ортасында бәрі үйінді болып өлді. →
Dialogue: 0,0:05:17.02,0:05:20.47,Default,,0,0,0,,Мәриям да қан құсып жатты→
Dialogue: 0,0:05:20.47,0:05:25.06,Default,,0,0,0,,Азап... азап шегу))
Dialogue: 0,0:05:25.06,0:05:27.97,Default,,0,0,0,,((Бірақ менде ештеңе жоқ...→
Dialogue: 0,0:05:27.97,0:05:30.25,Default,,0,0,0,,Мен ештеңе істей алмадым...))
Dialogue: 0,0:05:30.25,0:05:37.16,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:37.16,0:05:39.16,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:05:42.73,0:05:46.23,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:05:47.59,0:05:51.31,Default,,0,0,0,,((Тағы не айтар едіңіз!? Бәрі өлді...→
Dialogue: 0,0:05:51.31,0:05:53.52,Default,,0,0,0,,Ел өлтірді деп айтуым керек пе еді!?→
Dialogue: 0,0:05:53.52,0:05:55.99,Default,,0,0,0,,Әй ханзада!!)) ((Уф...))
Dialogue: 0,0:05:55.99,0:05:58.69,Default,,0,0,0,,) ((Хмм…))
Dialogue: 0,0:06:00.20,0:06:04.22,Default,,0,0,0,,((Эпидемия басылғаннан кейін қараңғы аудандар өртеніп кетті→
Dialogue: 0,0:06:04.22,0:06:08.09,Default,,0,0,0,,Соны көргенде: «Ел бізде емес» деп ойладым.
Dialogue: 0,0:06:08.09,0:06:10.59,Default,,0,0,0,,Олар бұл қоқыстан басқа ештеңе емес деп ойлайды. →
Dialogue: 0,0:06:12.16,0:06:15.61,Default,,0,0,0,,Сондықтан мен Тұман бригадасын ұйымдастырдым. →
Dialogue: 0,0:06:15.61,0:06:17.78,Default,,0,0,0,,Ел өлтіргенге дейін...→
Dialogue: 0,0:06:17.78,0:06:21.44,Default,,0,0,0,,Өз күшімізбен күресіп аман қалу үшін))
Dialogue: 0,0:06:21.44,0:06:29.84,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:06:29.84,0:06:31.88,Default,,0,0,0,,((Наннакотаа, мен білемін!→
Dialogue: 0,0:06:31.88,0:06:34.82,Default,,0,0,0,,Маған сенің айтқаның да керек емес. →
Dialogue: 0,0:06:34.82,0:06:38.62,Default,,0,0,0,,Бірақ басқаша қалай істеу керектігін білмеймін))
Dialogue: 0,0:06:38.62,0:06:40.62,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:06:42.92,0:06:47.11,Default,,0,0,0,,((А... хаха, дұрыс→
Dialogue: 0,0:06:47.11,0:06:49.21,Default,,0,0,0,,Дұрыс)) ()
Dialogue: 0,0:06:49.21,0:06:52.10,Default,,0,0,0,,((Alibaba тұман тобына қосылады...→
Dialogue: 0,0:06:52.10,0:06:54.85,Default,,0,0,0,,Жоқ, көшбасшы болыңыз))
Dialogue: 0,0:06:54.85,0:06:56.90,Default,,0,0,0,,((Егер сіз ханзада болсаңыз, тұман тобы → болады
Dialogue: 0,0:06:56.90,0:06:59.20,Default,,0,0,0,,Енді қарақшылар әскері емес)) ()
Dialogue: 0,0:07:02.48,0:07:04.65,Default,,0,0,0,,Бірде сен маған опасыздық жасадың.
Dialogue: 0,0:07:04.65,0:07:08.07,Default,,0,0,0,,Бірақ біз әңгімелесіп жатқанда, мен бұл туралы ойладым →
Dialogue: 0,0:07:08.07,0:07:12.02,Default,,0,0,0,,Қасым менің отбасым және досым.
Dialogue: 0,0:07:12.02,0:07:14.84,Default,,0,0,0,,Сондықтан мен «Мист» тобына қосылдым.
Dialogue: 0,0:07:14.84,0:07:17.31,Default,,0,0,0,,≪Бұл не? Бұл сезім≫
Dialogue: 0,0:07:17.31,0:07:20.18,Default,,0,0,0,,Мен дереу шара қолдандым.
Dialogue: 0,0:07:20.18,0:07:23.25,Default,,0,0,0,,Халықтың қолдауына ие болу үшін ұрланған заттар...
Dialogue: 0,0:07:23.25,0:07:26.97,Default,,0,0,0,,≪Мен мұндай көріністі бұрын көргендей сезінемін≫
Dialogue: 0,0:07:26.97,0:07:29.97,Default,,0,0,0,,Уақыт пісіп-жетіліп, Тұлғамды ашармын→
Dialogue: 0,0:07:29.97,0:07:32.31,Default,,0,0,0,,Абумадпен сөйлесіңіз.
Dialogue: 0,0:07:32.31,0:07:34.31,Default,,0,0,0,,Мен мұны істеймін, Аладдин!
Dialogue: 0,0:07:39.20,0:07:41.25,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:41.25,0:07:44.07,Default,,0,0,0,,Эй, егер ол әлі жұмыс істемесе→
Dialogue: 0,0:07:44.07,0:07:46.10,Default,,0,0,0,,​​Біз не істеуіміз керек?
Dialogue: 0,0:07:46.10,0:07:48.14,Default,,0,0,0,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:07:48.14,0:07:50.74,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:07:52.83,0:07:55.61,Default,,0,0,0,,Ашумен төбелессең→
Dialogue: 0,0:07:55.61,0:07:58.68,Default,,0,0,0,,Мен өте қайғылы нәрсе болатын сияқты.
Dialogue: 0,0:07:58.68,0:08:02.97,Default,,0,0,0,,Бірақ... бұған көмектесу мүмкін емес.
Dialogue: 0,0:08:02.97,0:08:05.12,Default,,0,0,0,,Бұл ел қазір қорқынышты!
Dialogue: 0,0:08:05.12,0:08:08.01,Default,,0,0,0,,Мұны біреу істеу керек! Әрине →
Dialogue: 0,0:08:08.01,0:08:10.46,Default,,0,0,0,,Мен бұл дұрыс жол емес екенін білемін, бірақ→
Dialogue: 0,0:08:10.46,0:08:14.25,Default,,0,0,0,,Бірақ... Бірақ мен...
Dialogue: 0,0:08:14.25,0:08:16.77,Default,,0,0,0,,Мен оны енді түсінбеймін!
Dialogue: 0,0:08:16.77,0:08:19.70,Default,,0,0,0,,Мен өте аяныштымын...
Dialogue: 0,0:08:19.70,0:08:23.84,Default,,0,0,0,,Сондықтан дәл қазір сені көргім келмеді...
Dialogue: 0,0:08:23.84,0:08:26.91,Default,,0,0,0,,Өтінемін... қазір кет!
Dialogue: 0,0:08:26.91,0:08:28.95,Default,,0,0,0,,Бұл елден кет!!
Dialogue: 0,0:08:28.95,0:08:30.98,Default,,0,0,0,,Бармын! Уф!
Dialogue: 0,0:08:30.98,0:08:33.03,Default,,0,0,0,,Жүр!
Dialogue: 0,0:08:33.03,0:08:36.15,Default,,0,0,0,,Сабыр етші, Алибаба-кун.
Dialogue: 0,0:08:36.15,0:08:40.45,Default,,0,0,0,,Бұл елдің мәселесі біз үшін өте ауыр екені рас.
Dialogue: 0,0:08:42.69,0:08:45.33,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:08:45.33,0:08:47.73,Default,,0,0,0,,Мен сенімен бірге бұл туралы ойланамын.
Dialogue: 0,0:08:49.23,0:08:51.57,Default,,0,0,0,,Асыл досыңызға →
Dialogue: 0,0:08:51.57,0:08:55.71,Default,,0,0,0,,Маған не істеу керектігін ойлануға рұқсат етіңіз.
Dialogue: 0,0:08:55.71,0:08:59.26,Default,,0,0,0,,Уго-кун мен Мол-сан да сонда. Бәріміз ойласақ →
Dialogue: 0,0:08:59.26,0:09:02.91,Default,,0,0,0,,Қазіргіден жақсырақ жауап табатыныңызға сенімдімін.
Dialogue: 0,0:09:02.91,0:09:04.95,Default,,0,0,0,,Аладдин….
Dialogue: 0,0:09:04.95,0:09:07.15,Default,,0,0,0,,Эй, Алибаба-кун.
Dialogue: 0,0:09:09.45,0:09:11.82,Default,,0,0,0,,Ах.
Dialogue: 0,0:09:11.82,0:09:13.86,Default,,0,0,0,,Уау! (2 адам) Ах!
Dialogue: 0,0:09:13.86,0:09:17.56,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:17.56,0:09:19.98,Default,,0,0,0,,Иә. Мен сені күтуге мәжбүр еттім.
Dialogue: 0,0:09:19.98,0:09:23.13,Default,,0,0,0,,Хе. Мен көмектесуге келдім, досым.
Dialogue: 0,0:09:23.13,0:09:26.63,Default,,0,0,0,,Қасым! О? Сендер Юбисіңдер.
Dialogue: 0,0:09:28.14,0:09:30.81,Default,,0,0,0,,Шабуыл, шабуыл! Ол бәрібір бай!
Dialogue: 0,0:09:30.81,0:09:34.66,Default,,0,0,0,,Нысананың сипаттамасын білмеймін! Оларды ұстай беріңіз.
Dialogue: 0,0:09:34.66,0:09:36.70,Default,,0,0,0,,Мен сенің қонақүйге шабуыл жасағаныңды естімеппін!
Dialogue: 0,0:09:36.70,0:09:40.65,Default,,0,0,0,,Сен ақымақ. Бұлай етпесек, жеңілеміз.
Dialogue: 0,0:09:40.65,0:09:43.84,Default,,0,0,0,,Сізді өлтіресіз бе? Мен біраз ақпарат алдым.
Dialogue: 0,0:09:43.84,0:09:47.02,Default,,0,0,0,,Әлгі жігіт осы қонақүйде→
Dialogue: 0,0:09:47.02,0:09:49.02,Default,,0,0,0,,Синдбад.
Dialogue: 0,0:09:50.44,0:09:52.48,Default,,0,0,0,,Мұны істеме!
Dialogue: 0,0:09:52.48,0:09:54.48,Default,,0,0,0,,Мылтық Мылтық! (Барлығы) Ах!
Dialogue: 0,0:09:57.03,0:09:59.14,Default,,0,0,0,,Шин! Маған қалдырыңыз!
Dialogue: 0,0:09:59.14,0:10:01.17,Default,,0,0,0,,Гакин! Уф!
Dialogue: 0,0:10:01.17,0:10:04.36,Default,,0,0,0,,Олар менің кім екенімді біліп, осыны орнатқан сияқты.
Dialogue: 0,0:10:04.36,0:10:07.78,Default,,0,0,0,,Әрине, Синдбад мырза.
Dialogue: 0,0:10:07.78,0:10:10.06,Default,,0,0,0,,Иә! Не!
Dialogue: 0,0:10:10.06,0:10:12.10,Default,,0,0,0,,Аа~ қазірдің өзінде! Бұл пайдасыз нәрсе!
Dialogue: 0,0:10:12.10,0:10:14.14,Default,,0,0,0,,Шулы! Хмф!
Dialogue: 0,0:10:14.14,0:10:16.72,Default,,0,0,0,,Дого! Уф! Ух…→
Dialogue: 0,0:10:16.72,0:10:19.01,Default,,0,0,0,,А... не? Қазір...
Dialogue: 0,0:10:19.01,0:10:21.56,Default,,0,0,0,,Арх! Хасан!
Dialogue: 0,0:10:21.56,0:10:23.63,Default,,0,0,0,,Гохо! Гррр….
Dialogue: 0,0:10:23.63,0:10:25.83,Default,,0,0,0,,Мені қажетсіз сиқырлы күш қолдануды ұмыту.
Dialogue: 0,0:10:27.20,0:10:30.43,Default,,0,0,0,,Бұл туралы кейінірек. Асығыңыз! Күте тұрыңыз! мен...
Dialogue: 0,0:10:30.43,0:10:33.14,Default,,0,0,0,,Бұл қауіпті! Бакки!
Dialogue: 0,0:10:33.14,0:10:35.29,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:10:35.29,0:10:38.19,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:10:40.13,0:10:42.31,Default,,0,0,0,,Не істейсің!? Алибаба мырза!
Dialogue: 0,0:10:42.31,0:10:44.48,Default,,0,0,0,,Олар ұры ғой.
Dialogue: 0,0:10:44.48,0:10:47.77,Default,,0,0,0,,Аузыңды жап, құбыжық әйел. Сіз тағы соққы аласыз ба?
Dialogue: 0,0:10:47.77,0:10:49.97,Default,,0,0,0,,Бум! (мүшелер) О!? Апыр-ай!
Dialogue: 0,0:10:53.06,0:10:56.78,Default,,0,0,0,,Еш қағыспа. Какаре! (мүшелер) О!
Dialogue: 0,0:10:56.78,0:10:59.90,Default,,0,0,0,,Масруле. (Масрур) Түсіндім. →
Dialogue: 0,0:10:59.90,0:11:01.93,Default,,0,0,0,,Хмм….
Dialogue: 0,0:11:01.93,0:11:04.94,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:04.94,0:11:06.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:06.97,0:11:11.36,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:11.36,0:11:13.36,Default,,0,0,0,,Керемет...
Dialogue: 0,0:11:14.96,0:11:17.18,Default,,0,0,0,,Сен тым алысқа барасың, Масрур.
Dialogue: 0,0:11:17.18,0:11:19.58,Default,,0,0,0,,Не... не? Сіз жігіттер!
Dialogue: 0,0:11:19.58,0:11:23.65,Default,,0,0,0,,Не, сен мені іздеп келдің бе?
Dialogue: 0,0:11:23.65,0:11:28.58,Default,,0,0,0,,Мен... сені көріп тұрмын! Хмф!
Dialogue: 0,0:11:28.58,0:11:31.88,Default,,0,0,0,,Уф... Не? бұл.
Dialogue: 0,0:11:31.88,0:11:34.43,Default,,0,0,0,,Сіз неғұрлым көп қозғалсаңыз, соғұрлым оны қатайтасыз. →
Dialogue: 0,0:11:34.43,0:11:36.47,Default,,0,0,0,,Қараңдар! Ешкім қозғалмауы керек! Мен көмектесуім керек.
Dialogue: 0,0:11:36.47,0:11:38.50,Default,,0,0,0,,Пайдасыз.
Dialogue: 0,0:11:38.50,0:11:43.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:43.11,0:11:45.93,Default,,0,0,0,,Ақымақ! (Жағфар) Жеті теңіз әміршісінің аты →
Dialogue: 0,0:11:45.93,0:11:49.10,Default,,0,0,0,,Бұл әзіл емес. Бұл деңгейдегі сиқырлы құралдар → болып табылады
Dialogue: 0,0:11:49.10,0:11:51.15,Default,,0,0,0,,Бұл мен үшін жұмыс істемейді.
Dialogue: 0,0:11:51.15,0:11:53.25,Default,,0,0,0,,Қарғыс атсын!!→
Dialogue: 0,0:11:54.62,0:11:56.65,Default,,0,0,0,,Уф! Қасым!
Dialogue: 0,0:11:56.65,0:11:59.42,Default,,0,0,0,,Енді мен сені ұстап алуым керек→
Dialogue: 0,0:11:59.42,0:12:01.51,Default,,0,0,0,,Менің жұмысым аяқталды. →
Dialogue: 0,0:12:01.51,0:12:04.63,Default,,0,0,0,,Alibaba - керемет құбыжық. Қарғыс атсын!
Dialogue: 0,0:12:04.63,0:12:07.80,Default,,0,0,0,,Генералдар арасындағы мәселені шешейік. →
Dialogue: 0,0:12:07.80,0:12:11.60,Default,,0,0,0,,Жай ғана жіберіңіз. Сіз жеңушісіз бе?
Dialogue: 0,0:12:14.17,0:12:17.76,Default,,0,0,0,,≪Сіз байсалдысыз ба... Синдбад? ≫
Dialogue: 0,0:12:17.76,0:12:20.16,Default,,0,0,0,,≪Сіз аңызға айналған лабиринтті жаулап алушы емессіз бе?≫
Dialogue: 0,0:12:21.61,0:12:25.03,Default,,0,0,0,,≪Аладдин, ол неге қозғалмайды? ≫
Dialogue: 0,0:12:25.03,0:12:27.03,Default,,0,0,0,,≪Alibaba-ға қауіп төніп тұр≫
Dialogue: 0,0:12:36.24,0:12:38.23,Default,,0,0,0,,Alibaba, жүгір! →
Dialogue: 0,0:12:38.23,0:12:41.28,Default,,0,0,0,,Бейбақтар, басшымыз қашсын!
Dialogue: 0,0:12:41.28,0:12:44.40,Default,,0,0,0,,Мен түсінемін, бұл бір нұсқа. →
Dialogue: 0,0:12:44.40,0:12:47.10,Default,,0,0,0,,Тұман тобы бәрібір бітті→
Dialogue: 0,0:12:47.10,0:12:52.33,Default,,0,0,0,,Ойланып қарасаңыз, сіз бұл жігіттерден басқа адамсыз. →
Dialogue: 0,0:12:52.33,0:12:55.21,Default,,0,0,0,,Қашқың келсе, қаш. Ах.
Dialogue: 0,0:12:55.21,0:12:57.73,Default,,0,0,0,,Олар шалғайдағы адамдар. →
Dialogue: 0,0:12:57.73,0:13:00.25,Default,,0,0,0,,Бірақ сіз басқасыз. →
Dialogue: 0,0:13:00.25,0:13:02.77,Default,,0,0,0,,Қанша тайға таңба басқандай →
Dialogue: 0,0:13:02.77,0:13:05.11,Default,,0,0,0,,Сіз бәрібір ханзадасыз.
Dialogue: 0,0:13:05.11,0:13:07.57,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:13:07.57,0:13:10.63,Default,,0,0,0,,Өзің білетіндей әрекет жасама!
Dialogue: 0,0:13:10.63,0:13:13.51,Default,,0,0,0,,Менің бұл жігіттерден айырмашылығым жоқ.
Dialogue: 0,0:13:13.51,0:13:18.14,Default,,0,0,0,,Олардың бәрі менің асыл ағаларым! Бұл...→
Dialogue: 0,0:13:18.14,0:13:21.56,Default,,0,0,0,,Бұл байламды мазақ етпеңдер!!
Dialogue: 0,0:13:21.56,0:13:24.01,Default,,0,0,0,,Азаматтық пен қатаңдық рухы→
Dialogue: 0,0:13:24.01,0:13:26.89,Default,,0,0,0,,Саған және сенің ізбасарларыңа бұйырамын.
Dialogue: 0,0:13:26.89,0:13:28.93,Default,,0,0,0,,Менің сиқырыммен қоректену →
Dialogue: 0,0:13:28.93,0:13:32.00,Default,,0,0,0,,Менің еркіме үлкен күш бер.
Dialogue: 0,0:13:32.00,0:13:34.00,Default,,0,0,0,,Шық, Амон!
Dialogue: 0,0:13:36.37,0:13:39.86,Default,,0,0,0,,≪Мен істеймін... Қарсылас Синдбад болса да! ≫
Dialogue: 0,0:13:39.86,0:13:42.08,Default,,0,0,0,,≪Тұман тобы бітпейді≫
Dialogue: 0,0:13:42.08,0:13:44.18,Default,,0,0,0,,Осы күш менде болғанша!
Dialogue: 0,0:13:45.88,0:13:48.43,Default,,0,0,0,,≪Бұл Амон... жалынның жындары ма?≫
Dialogue: 0,0:13:48.43,0:13:52.15,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:52.15,0:13:54.19,Default,,0,0,0,,≪Барбад стиліндегі корольдік қылыш шеберлігі≫
Dialogue: 0,0:13:54.19,0:13:58.13,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:58.13,0:14:01.03,Default,,0,0,0,,≪Жалынмен үйлесуі де жаман емес≫
Dialogue: 0,0:14:01.03,0:14:03.08,Default,,0,0,0,,Арх! Гакин!
Dialogue: 0,0:14:03.08,0:14:07.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:07.70,0:14:09.74,Default,,0,0,0,,≪Хо... жалын...≫
Dialogue: 0,0:14:09.74,0:14:12.62,Default,,0,0,0,,Дого! Арх!
Dialogue: 0,0:14:12.62,0:14:15.62,Default,,0,0,0,,Alibaba~!! (мүшелер) О...
Dialogue: 0,0:14:16.99,0:14:20.53,Default,,0,0,0,,Сіз джинді қалай қолдану керектігін білмейсіз.
Dialogue: 0,0:14:20.53,0:14:23.87,Default,,0,0,0,,Жаман... Қасым.
Dialogue: 0,0:14:23.87,0:14:26.54,Default,,0,0,0,,Мен... Гохо Гохо...
Dialogue: 0,0:14:26.54,0:14:29.06,Default,,0,0,0,,Қарғыс атсын!!
Dialogue: 0,0:14:29.06,0:14:31.83,Default,,0,0,0,,Неге келдің!?
Dialogue: 0,0:14:31.83,0:14:33.86,Default,,0,0,0,,Синдрияның бұған қатысы жоқ.
Dialogue: 0,0:14:33.86,0:14:37.21,Default,,0,0,0,,Сен келмегенде, ұтылмас едік!
Dialogue: 0,0:14:37.21,0:14:40.45,Default,,0,0,0,,Бұл инсайдерден алынған ақпарат болды→
Dialogue: 0,0:14:40.45,0:14:43.82,Default,,0,0,0,,Мен жай ғана жақсы жұмыс істеп жатырмын деп ойлаймын.
Dialogue: 0,0:14:43.82,0:14:47.01,Default,,0,0,0,,Өзінің дәрменсіздігін түсінбейтін ақымақ.
Dialogue: 0,0:14:47.01,0:14:49.64,Default,,0,0,0,,Айналаңыздағылардың барлығын жеңе алмайтын шайқасқа тартасыз→
Dialogue: 0,0:14:49.64,0:14:52.94,Default,,0,0,0,,Мен сені құртпақшы болдым! Қарғыс атқыр...
Dialogue: 0,0:14:54.57,0:14:58.10,Default,,0,0,0,,Олар ұсталса не болады?
Dialogue: 0,0:14:58.10,0:15:02.66,Default,,0,0,0,,Қиын болса да, сатқынның тағдыры – төбе.
Dialogue: 0,0:15:02.66,0:15:06.23,Default,,0,0,0,,Бірақ әлі де күрескіңіз келсе→
Dialogue: 0,0:15:06.23,0:15:08.96,Default,,0,0,0,,Сізге тағы бір жол қалды.
Dialogue: 0,0:15:08.96,0:15:11.00,Default,,0,0,0,,Иә? Не жетіспейді →
Dialogue: 0,0:15:11.00,0:15:13.65,Default,,0,0,0,,Толықтыру. Яғни →
Dialogue: 0,0:15:13.65,0:15:16.47,Default,,0,0,0,,Мені Тұман труппасының мүшесі етіңіз.
Dialogue: 0,0:15:16.47,0:15:19.67,Default,,0,0,0,,Ах... (Джафар) А!?
Dialogue: 0,0:17:21.70,0:17:23.86,Default,,0,0,0,,Шин... сен Тұман тобындасың ба?
Dialogue: 0,0:17:23.86,0:17:26.65,Default,,0,0,0,,Ах. (Джафар) Сонда сіз төбелескіңіз келе ме?
Dialogue: 0,0:17:26.65,0:17:29.20,Default,,0,0,0,,Ах. (Жафар) Барбад елімен бе?
Dialogue: 0,0:17:29.20,0:17:31.42,Default,,0,0,0,,Ах! (Джафар) А...
Dialogue: 0,0:17:31.42,0:17:35.68,Default,,0,0,0,,Бұл біртүрлі. Тұман бригадасы - жеңілетін жау.
Dialogue: 0,0:17:35.68,0:17:39.81,Default,,0,0,0,,Сауданы қайта бастау үшін Әбумад патшамен мәміле жасамадыңыз ба?
Dialogue: 0,0:17:39.81,0:17:43.63,Default,,0,0,0,,Дегенмен, мен «Туман» тобының жағында болғым келді.
Dialogue: 0,0:17:43.63,0:17:46.19,Default,,0,0,0,,Сенің айтқаның біртүрлі екен!
Dialogue: 0,0:17:46.19,0:17:48.11,Default,,0,0,0,,Ойланып, өз бетінше шешім қабылдадыңыз ба →
Dialogue: 0,0:17:48.11,0:17:50.31,Default,,0,0,0,,Сіз керемет нәрсе айттыңыз!
Dialogue: 0,0:17:51.76,0:17:56.08,Default,,0,0,0,,күрсіну…. Джафар-кун→
Dialogue: 0,0:17:56.08,0:18:00.47,Default,,0,0,0,,Қандай қатыгез адамсың! (Джафар) Не... а!?
Dialogue: 0,0:18:00.47,0:18:03.34,Default,,0,0,0,,Сіз мұны да білесіз бе? Бұл елдің азабы.
Dialogue: 0,0:18:03.34,0:18:05.51,Default,,0,0,0,,Иә. Әлі де →
Dialogue: 0,0:18:05.51,0:18:08.14,Default,,0,0,0,,Сіз жүрегіңіз қозғалмады дейсіз бе?
Dialogue: 0,0:18:08.14,0:18:10.18,Default,,0,0,0,,Ал... бұл дұрыс→
Dialogue: 0,0:18:10.18,0:18:13.00,Default,,0,0,0,,Мен бұл қорқынышты деп ойладым, бірақ... Дұрыс!?
Dialogue: 0,0:18:13.00,0:18:15.35,Default,,0,0,0,,≪Неге мен жаман адаммын...≫
Dialogue: 0,0:18:15.35,0:18:18.94,Default,,0,0,0,,Сондықтан мен ойладым, Сол ақымақ патшадан артық→
Dialogue: 0,0:18:18.94,0:18:23.44,Default,,0,0,0,,Мен бұл жігіттерге қараңғы аудандар үшін күресуге көмектескім келеді.
Dialogue: 0,0:18:23.44,0:18:26.68,Default,,0,0,0,,Мен Тұман бригадасымен бірге шайқасамын.
Dialogue: 0,0:18:26.68,0:18:29.38,Default,,0,0,0,,≪Бұл адам кім...≫
Dialogue: 0,0:18:31.13,0:18:34.67,Default,,0,0,0,,Синдбад ағай біртүрлі адам.
Dialogue: 0,0:18:34.67,0:18:36.82,Default,,0,0,0,,Өте танымал тұлға болыңыз →
Dialogue: 0,0:18:36.82,0:18:40.19,Default,,0,0,0,,Мен түсіндім. солай ма?
Dialogue: 0,0:18:40.19,0:18:43.36,Default,,0,0,0,,Сонымен, қосылуға рұқсат бересіз бе?
Dialogue: 0,0:18:43.36,0:18:46.31,Default,,0,0,0,,Алибаба мырза. Кешіріңіз, бірақ →
Dialogue: 0,0:18:46.31,0:18:50.15,Default,,0,0,0,,Мен бұған сенетіндей аңғал емеспін.
Dialogue: 0,0:18:50.15,0:18:53.45,Default,,0,0,0,,Мен тек осы елдің халқына көмектескім келеді→
Dialogue: 0,0:18:53.45,0:18:55.55,Default,,0,0,0,,Маған сенбейсіз бе? →
Dialogue: 0,0:18:57.34,0:19:01.73,Default,,0,0,0,,Дұрыс... басқа себептер болса→
Dialogue: 0,0:19:01.73,0:19:04.53,Default,,0,0,0,,Бұл әлемнің өзгеруін тоқтату.
Dialogue: 0,0:19:06.25,0:19:08.30,Default,,0,0,0,,Балалар, сезбейсіңдер ме?
Dialogue: 0,0:19:08.30,0:19:12.59,Default,,0,0,0,,Соңғы жылдары соғыстар жиі болып, кедейлік пен кемсітушілік кеңейді→
Dialogue: 0,0:19:12.59,0:19:15.11,Default,,0,0,0,,Дүние шатасуға толы.
Dialogue: 0,0:19:15.11,0:19:19.51,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:19.51,0:19:23.27,Default,,0,0,0,,Синдрия патшасы ретінде мен бұл жағдайға алаңдаймын. →
Dialogue: 0,0:19:23.27,0:19:27.35,Default,,0,0,0,,Сондықтан дүние жүзіндегі ауытқулардың бірі болып табылатын Барбадостағы осы азаматтық соғыс, →
Dialogue: 0,0:19:27.35,0:19:30.11,Default,,0,0,0,,Мен оны шешкім келеді.
Dialogue: 0,0:19:30.11,0:19:32.14,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:19:32.14,0:19:36.00,Default,,0,0,0,,≪Сіз нені айтасыз...? Бұл не? Бұл адам≫
Dialogue: 0,0:19:36.00,0:19:38.03,Default,,0,0,0,,≪Кенеттен дүние...≫
Dialogue: 0,0:19:38.03,0:19:40.55,Default,,0,0,0,,Алданбаңыз! Ол патша болса да→
Dialogue: 0,0:19:40.55,0:19:42.65,Default,,0,0,0,,Біздің достарымыз кімдер? →
Dialogue: 0,0:19:42.65,0:19:46.44,Default,,0,0,0,,Жоғарыдағылар бізге қарап тұр, төмендегілер лас →
Dialogue: 0,0:19:46.44,0:19:48.89,Default,,0,0,0,,Сіз аштан өлген дұрыс деп ойлайсыз!
Dialogue: 0,0:19:48.89,0:19:51.78,Default,,0,0,0,,Біз салтанатты өмір сүретін болсақ.
Dialogue: 0,0:19:51.78,0:19:54.90,Default,,0,0,0,,Жоқ? Е!? Эй Синдбад! →
Dialogue: 0,0:19:54.90,0:19:57.00,Default,,0,0,0,,Ах! Аа….
Dialogue: 0,0:19:57.00,0:19:59.04,Default,,0,0,0,,Үндетпе.
Dialogue: 0,0:19:59.04,0:20:03.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:03.77,0:20:06.29,Default,,0,0,0,,Шин қанша жарақат алды→
Dialogue: 0,0:20:06.29,0:20:08.81,Default,,0,0,0,,Өзіңді құрбан ету арқылы өмір сүрдің бе→
Dialogue: 0,0:20:08.81,0:20:10.98,Default,,0,0,0,,Мен білмейтін қарақшы сияқты.
Dialogue: 0,0:20:10.98,0:20:13.02,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:13.02,0:20:15.12,Default,,0,0,0,,Тоқта, Жафар. Ах.
Dialogue: 0,0:20:17.69,0:20:20.57,Default,,0,0,0,,Кешіріңіз. аа.
Dialogue: 0,0:20:20.57,0:20:23.04,Default,,0,0,0,,Түсіндім. Өтінемін, қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:20:23.04,0:20:27.48,Default,,0,0,0,,Сонымен, сіз бізге қосыласыз ба? рақмет сізге.
Dialogue: 0,0:20:27.48,0:20:30.12,Default,,0,0,0,,Ах... Қарғыс атсын!
Dialogue: 0,0:20:30.12,0:20:33.92,Default,,0,0,0,,Жафар қарт біраз қорқынышты болды емес пе?
Dialogue: 0,0:20:33.92,0:20:36.77,Default,,0,0,0,,Жақсы... кейде.
Dialogue: 0,0:20:36.77,0:20:39.59,Default,,0,0,0,,Енді көп ұзамай Алибаба-кун→
Dialogue: 0,0:20:39.59,0:20:42.19,Default,,0,0,0,,Мен сені менімен Балбад патша сарайына баруға рұқсат етемін.
Dialogue: 0,0:20:43.68,0:20:45.72,Default,,0,0,0,,Халықтың қолдауына ие болған соң →
Dialogue: 0,0:20:45.72,0:20:50.10,Default,,0,0,0,,Сіз өзіңіздің жеке басыңызды ашып, Абумадпен сөйлесуді жоспарлап отырсыз ба? →
Dialogue: 0,0:20:50.10,0:20:52.92,Default,,0,0,0,,Міне, қазір. →
Dialogue: 0,0:20:52.92,0:20:57.36,Default,,0,0,0,,Тұман тобының жетекшісі ретінде ол халықтың қолдауына ие болды→
Dialogue: 0,0:20:57.36,0:21:00.36,Default,,0,0,0,,Мен сіздің ханзада мәртебесіне кепілдік беремін.
Dialogue: 0,0:21:00.36,0:21:03.30,Default,,0,0,0,,Мен бұрынғы патшаның ескі танысымын. →
Dialogue: 0,0:21:03.30,0:21:07.09,Default,,0,0,0,,Иә... сіз бұрынғы патшаға қатты ұқсайсыз. →
Dialogue: 0,0:21:07.09,0:21:09.87,Default,,0,0,0,,Бұл сөзсіз ханзада Барбад. →
Dialogue: 0,0:21:09.87,0:21:13.37,Default,,0,0,0,,Демек, сізде үлкен жауапкершілік бар, солай емес пе?
Dialogue: 0,0:21:16.08,0:21:19.57,Default,,0,0,0,,Саған Қасым ұнай ма? Талқылау аяқталғаннан кейін →
Dialogue: 0,0:21:19.57,0:21:22.74,Default,,0,0,0,,Қашықтықтағы адамдардың өміріне кепілдік беріледі. →
Dialogue: 0,0:21:22.74,0:21:26.29,Default,,0,0,0,,Балалар, осыны қаладыңдар ма?
Dialogue: 0,0:21:26.29,0:21:28.74,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:21:28.74,0:21:32.35,Default,,0,0,0,,Қасым…. Алға, Алибаба-кун.
Dialogue: 0,0:21:32.35,0:21:35.85,Default,,0,0,0,,Сіз батыл адамсыз, солай емес пе? Мен білемін.
Dialogue: 0,0:21:41.64,0:21:44.04,Default,,0,0,0,,Иә? «Мен сізге айтамын.→
Dialogue: 0,0:21:44.04,0:21:47.11,Default,,0,0,0,,Ел қамын ойлағандар бүгін түсте →
Dialogue: 0,0:21:47.11,0:21:49.66,Default,,0,0,0,,Олар патша сарайында жиналды».
Dialogue: 0,0:21:49.66,0:21:52.80,Default,,0,0,0,,«Барлық жұрттың алдында Әбумад патшамен бірге аудиториям болды→
Dialogue: 0,0:21:52.80,0:21:55.45,Default,,0,0,0,,Осы елдің болашағына қатысты →
Dialogue: 0,0:21:55.45,0:21:57.90,Default,,0,0,0,,Біз мұны толығымен талқылауға дайынбыз.'' Мен мұны күтуім керек пе?
Dialogue: 0,0:21:57.90,0:22:01.44,Default,,0,0,0,,«Тұманның көсемі, жұмбақ Әлибаба» →
Dialogue: 0,0:22:01.44,0:22:05.23,Default,,0,0,0,,Алибаба Салуджа, Барбад патшалығының үшінші ханзадасы».
Dialogue: 0,0:22:05.23,0:22:07.26,Default,,0,0,0,,Жұмбақ Алибаба - ханзада!
Dialogue: 0,0:22:07.26,0:22:09.55,Default,,0,0,0,,Бұл жігіт керемет. Барайық.
Dialogue: 0,0:22:09.55,0:22:11.59,Default,,0,0,0,,Ах! Патша сарайына.
Dialogue: 0,0:22:11.59,0:22:14.40,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:14.40,0:22:16.69,Default,,0,0,0,,Мұнда көп адам жиналғанына сене алар емеспін.
Dialogue: 0,0:22:16.69,0:22:19.09,Default,,0,0,0,,Адамдар сізден не күтеді→
Dialogue: 0,0:22:19.09,0:22:22.51,Default,,0,0,0,,Бұл оның қазіргі патшадан үміт үзгенінің дәлелі.
Dialogue: 0,0:22:22.51,0:22:26.91,Default,,0,0,0,,Олардың дауыстары сіздің күшіңіз болсын. иә.
Dialogue: 0,0:22:32.66,0:22:36.54,Default,,0,0,0,,Бұл аласапыран ағаң емес пе?
Dialogue: 0,0:22:36.54,0:22:39.13,Default,,0,0,0,,Менің ішкі істерге араласпау саясатым бар.
Dialogue: 0,0:22:39.13,0:22:41.16,Default,,0,0,0,,Оқиғаны ағаларыңызбен бөлісіңіз.
Dialogue: 0,0:22:41.16,0:22:44.53,Default,,0,0,0,,Осынша ақша беріп жатқанда не айтып тұрсың?
Dialogue: 0,0:22:44.53,0:22:47.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:47.59,0:22:51.61,Default,,0,0,0,,Абумад аға. Хмм...
Dialogue: 0,0:22:51.61,0:22:54.84,Default,,0,0,0,,... Тыңдап көрейік ағайын.
Dialogue: 0,0:22:54.84,0:22:58.25,Default,,0,0,0,,Өйткені Alibaba дұрыс сөйлей алатын адам.
Dialogue: 0,0:22:58.25,0:23:01.82,Default,,0,0,0,,Себебі мен білемін. иә?
Dialogue: 0,0:23:01.82,0:23:04.52,Default,,0,0,0,,Бауырым, сен білесің →
Dialogue: 0,0:23:04.52,0:23:07.42,Default,,0,0,0,,Қазына бөлмесіндегі оқиға менің кінәм.
Dialogue: 0,0:23:07.42,0:23:12.01,Default,,0,0,0,,Әкемнің қайтыс болуына мен себепкер болдым.
Dialogue: 0,0:23:12.01,0:23:16.82,Default,,0,0,0,,Сол кезде мен өшпес күнә жасадым деп есептеймін.
Dialogue: 0,0:23:16.82,0:23:21.07,Default,,0,0,0,,Бірақ неліктен Тұман бригадасы қазынаға шабуыл жасады?→
Dialogue: 0,0:23:21.07,0:23:24.26,Default,,0,0,0,,Қазір бәрі патша сарайына жиналып жатыр ма?
Dialogue: 0,0:23:24.26,0:23:27.56,Default,,0,0,0,,Ойлан! Сіздің адамдарыңыз қазір →
Dialogue: 0,0:23:27.56,0:23:29.90,Default,,0,0,0,,Мен өлгенше қиналамын!
Dialogue: 0,0:23:29.90,0:23:33.80,Default,,0,0,0,,Абумад аға, мен сізден патша ретінде сұраймын.
Dialogue: 0,0:23:33.80,0:23:38.54,Default,,0,0,0,,Маған бұдан былай халықтың өмірін бар күш-қуатыңызбен қорғайтыныңызға уәде беріңіз!
Dialogue: 0,0:23:38.54,0:23:41.84,Default,,0,0,0,,Егер мен мұны істесем, «Мист» тобын таратамын.
Dialogue: 0,0:23:43.46,0:23:47.16,Default,,0,0,0,,Айтқыңыз келгені осы ма? Катсун
Dialogue: 0,0:23:48.57,0:23:50.60,Default,,0,0,0,,О, күте тұрыңыз! Уәде...
Dialogue: 0,0:23:50.60,0:23:52.64,Default,,0,0,0,,Қандай дөрекі. Ха.
Dialogue: 0,0:23:52.64,0:23:56.54,Default,,0,0,0,,Төмен адам заңды патшаның алдында рұқсатсыз тұрады→
Dialogue: 0,0:23:56.54,0:23:59.43,Default,,0,0,0,,Аузыңды ашпа. Аа….
Dialogue: 0,0:23:59.43,0:24:02.90,Default,,0,0,0,,Мен Барбадтың 23-королімін→
Dialogue: 0,0:24:02.90,0:24:05.97,Default,,0,0,0,,Бұл Абумад Салуджа. →
Dialogue: 0,0:24:05.97,0:24:11.05,Default,,0,0,0,,Мен қараңғы ауылдың баласын інім деп ешқашан ойлаған емеспін. →
Dialogue: 0,0:24:11.05,0:24:14.01,Default,,0,0,0,,Сіздің басыңыз Синдрия патшасының қорғауынсыз→
Dialogue: 0,0:24:14.01,0:24:17.54,Default,,0,0,0,,Ұзақ уақыт бойы ұшатыныңды ұмытпа.
Dialogue: 0,0:24:17.54,0:24:20.60,Default,,0,0,0,,Түсіңіз! Мен өзімді жақсы сезініп тұрған жоқпын.
Dialogue: 0,0:24:20.60,0:24:23.23,Default,,0,0,0,,Патша сарайының сыртында құрт көп болды...
Dialogue: 0,0:24:23.23,0:24:25.29,Default,,0,0,0,,Қалжыңдама!!
Dialogue: 0,0:24:25.29,0:24:28.10,Default,,0,0,0,,Өз халқыңды осылай құртқан саған→
Dialogue: 0,0:24:28.10,0:24:30.20,Default,,0,0,0,,Король болуға ешқандай талап жоқ!!
Dialogue: 0,0:24:32.54,0:24:35.90,Default,,0,0,0,,≫ (Банкир) Әй? Бұл қандай әбігер?
Dialogue: 0,0:24:35.90,0:24:38.55,Default,,0,0,0,,О, қайтып келдің бе, банкир?
Dialogue: 0,0:24:38.55,0:24:41.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:41.30,0:24:44.09,Default,,0,0,0,,Алибаба-кун, жақсысың ба?
Dialogue: 0,0:24:44.09,0:24:47.24,Default,,0,0,0,,Бізге ел тұрғындарының қолдауы көп→
Dialogue: 0,0:24:47.24,0:24:50.64,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін. Мен келісемін.
Dialogue: 0,0:24:52.88,0:24:55.32,Default,,0,0,0,,Бұл не? Бұл адамдар тобы.
Dialogue: 0,0:24:55.32,0:25:05.73,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:05.73,0:25:09.60,Default,,0,0,0,,≪Бұл не? Бір сәтке →
Dialogue: 0,0:25:09.60,0:25:12.40,Default,,0,0,0,,Мен ол адам қара күнге ұқсағандай болды≫
Dialogue: 0,0:25:13.70,0:26:07.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:12.39,0:26:18.69,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:23.07,0:26:40.37,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:14.65,0:28:17.83,Default,,0,0,0,,Менімен көбірек ойна, кішкентай сиқыршы!
Dialogue: 0,0:28:17.83,0:28:22.13,Default,,0,0,0,,Бұл түсінікті. Мен бұл адамды тоқтатуым керек.
Dialogue: 0,0:28:24.86,0:28:27.66,Default,,0,0,0,,Бұл жерде тағы бір қараңғы нәрсе!
Dialogue: 0,0:30:45.13,0:30:47.70,Default,,0,0,0,,Бүгін таңертең Яманаши префектурасындағы Чуо экспресс жолында,
Dialogue: 0,0:30:48.33,0:30:51.15,Default,,0,0,0,,Сасаго туннелінде төбе құлады
Dialogue: 0,0:30:51.15,0:30:53.71,Default,,0,0,0,,Кемінде үш көлік қирандылардың астында қалды.
Dialogue: 0,0:30:55.88,0:30:59.26,Default,,0,0,0,,Олардың үш мәйіті фургоннан әзірге расталды.
Dialogue: 0,0:31:00.76,0:31:05.76,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
