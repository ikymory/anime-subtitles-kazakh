Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.02,0:00:34.62,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:34.62,0:00:36.84,Default,,0,0,0,,Жағдай. (Жафар) Иә.
Dialogue: 0,0:00:36.84,0:00:39.24,Default,,0,0,0,,Барлық күштер орналастыруды аяқтады. →
Dialogue: 0,0:00:39.24,0:00:42.36,Default,,0,0,0,,Сегіз генерал да өз позицияларын алды.
Dialogue: 0,0:00:42.36,0:00:51.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:51.07,0:00:54.00,Default,,0,0,0,,Жаудың авангарды жақын арада жақын жерде болады.
Dialogue: 0,0:00:54.00,0:01:10.44,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:10.44,0:01:12.49,Default,,0,0,0,,Босатыңыз!
Dialogue: 0,0:01:12.49,0:01:17.39,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:17.39,0:01:20.05,Default,,0,0,0,,Жебе атылды. Ах! →
Dialogue: 0,0:01:20.05,0:01:22.32,Default,,0,0,0,,Күшті сиқырлы реакция келеді.
Dialogue: 0,0:01:22.32,0:01:28.74,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:28.74,0:01:30.74,Default,,0,0,0,,Хехе.
Dialogue: 0,0:01:32.26,0:01:34.26,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:01:35.71,0:01:39.78,Default,,0,0,0,,Хэхехе. (Масрур) Шамасы...
Dialogue: 0,0:01:39.78,0:01:42.60,Default,,0,0,0,,Менің жолдасым саған ұқсайды.
Dialogue: 0,0:01:42.60,0:01:45.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:47.17,0:01:51.78,Default,,0,0,0,,Қара металды қолданушы пайда болды. аа.
Dialogue: 0,0:01:51.78,0:01:53.88,Default,,0,0,0,,≪Бірақ бұл біртүрлі. Менің күшім →
Dialogue: 0,0:01:53.88,0:01:57.97,Default,,0,0,0,,Ол мөрленген болса да, кірістер саны тым аз≫
Dialogue: 0,0:01:57.97,0:02:02.27,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:07.86,0:02:09.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:11.28,0:02:13.98,Default,,0,0,0,,Мен жақсы дайындалдым. Дәмі →
Dialogue: 0,0:02:13.98,0:02:16.78,Default,,0,0,0,,«Шексіз қылыш биінің қалыптасуы» Менің керемет сиқырым.
Dialogue: 0,0:02:18.19,0:02:51.55,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:55.39,0:03:48.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:51.68,0:03:53.97,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:03:53.97,0:03:56.00,Default,,0,0,0,,Мен мұны Ям мырзадан және басқалардан естідім.
Dialogue: 0,0:03:56.00,0:04:00.32,Default,,0,0,0,,Сиқырлы сауыттың ең мықты болуының себебі оның керемет күшінде→
Dialogue: 0,0:04:00.32,0:04:03.14,Default,,0,0,0,,Ешкім бұғаттай алмайтын өте күшті сиқыр →
Dialogue: 0,0:04:03.14,0:04:05.18,Default,,0,0,0,,Оны қолдануға болады.
Dialogue: 0,0:04:05.18,0:04:07.18,Default,,0,0,0,,Бірақ мен саған олай істеуге рұқсат бермеймін!
Dialogue: 0,0:04:11.07,0:04:13.07,Default,,0,0,0,,Заш! Заш!
Dialogue: 0,0:04:14.60,0:04:16.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:19.46,0:04:23.55,Default,,0,0,0,,Иә, Ысқақ. Дүниені белсендіруге дейін қорғаңыз.
Dialogue: 0,0:04:23.55,0:04:25.88,Default,,0,0,0,,Иә, Иснаан.
Dialogue: 0,0:04:25.88,0:04:27.87,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:27.87,0:04:34.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:34.82,0:04:37.53,Default,,0,0,0,,Қылышшыға келсек, біз оны тоқтатамыз.
Dialogue: 0,0:04:37.53,0:04:39.93,Default,,0,0,0,,Аладдин, сиқырды белсендіруді тоқтатыңыз.
Dialogue: 0,0:04:39.93,0:04:41.93,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:04:44.72,0:04:46.77,Default,,0,0,0,,Ооо! Алақай!
Dialogue: 0,0:04:46.77,0:04:48.81,Default,,0,0,0,,«Булану шомылдыру рәсімі»!
Dialogue: 0,0:04:48.81,0:04:52.01,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:54.33,0:04:56.85,Default,,0,0,0,,Иә? Бу жарылысы? →
Dialogue: 0,0:04:56.85,0:04:59.55,Default,,0,0,0,,Мен сенің су сиқырын қолдана алатыныңды білмедім.
Dialogue: 0,0:04:59.55,0:05:02.85,Default,,0,0,0,,Су сиқыры мен жылу сиқырының қосындысы.
Dialogue: 0,0:05:02.85,0:05:04.89,Default,,0,0,0,,Бірақ оның пайдасы жоқ.
Dialogue: 0,0:05:04.89,0:05:07.64,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:05:07.64,0:05:10.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:10.11,0:05:12.15,Default,,0,0,0,,Сен барып қарап кел.
Dialogue: 0,0:05:12.15,0:05:15.15,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:15.15,0:05:19.05,Default,,0,0,0,,Арх! Хм... Ах!
Dialogue: 0,0:05:19.05,0:05:21.09,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:21.09,0:05:23.39,Default,,0,0,0,,Уф! (Хакурю) Алибаба-доно!
Dialogue: 0,0:05:25.71,0:05:28.71,Default,,0,0,0,,≪Қарғыс атсын... Тіпті Алибаба-доно да мұны істей алмайды →
Dialogue: 0,0:05:28.71,0:05:31.05,Default,,0,0,0,,Менің құшағымның мәні жоқ≫
Dialogue: 0,0:05:31.05,0:05:33.87,Default,,0,0,0,,≪Қалай күшті болуға болады...≫
Dialogue: 0,0:05:33.87,0:05:38.07,Default,,0,0,0,,((Хмм... Басқа амалым жоқ. Жарайсың))
Dialogue: 0,0:05:38.07,0:05:40.57,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:05:41.97,0:05:44.87,Default,,0,0,0,,Ахх!! Арх!
Dialogue: 0,0:05:46.60,0:05:49.30,Default,,0,0,0,,Ха! Ақ айдаһар!
Dialogue: 0,0:05:49.30,0:05:51.30,Default,,0,0,0,,«Булану шомылдыру рәсімі»!
Dialogue: 0,0:05:53.37,0:05:56.44,Default,,0,0,0,,Сәлем! Фуфуфуфуфуфу!
Dialogue: 0,0:05:56.44,0:05:58.47,Default,,0,0,0,,Бля! Ха! Гах...
Dialogue: 0,0:05:58.47,0:06:02.31,Default,,0,0,0,,≪ Қарғыс атсын... Мен қандаймын!? Қолымды да, аяғымды да шығара алмаймын≫
Dialogue: 0,0:06:02.31,0:06:04.33,Default,,0,0,0,,≪Керісінше, Синдбад мырза→
Dialogue: 0,0:06:04.33,0:06:06.93,Default,,0,0,0,,Синдрияға қауіп төндіру≫
Dialogue: 0,0:06:06.93,0:06:10.24,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:06:10.24,0:06:14.31,Default,,0,0,0,,≪Мен саған уәде бердім, бірақ не болып жатыр?≫
Dialogue: 0,0:06:14.31,0:06:16.36,Default,,0,0,0,,≪Неге мен әрқашан...→
Dialogue: 0,0:06:16.36,0:06:20.06,Default,,0,0,0,,Әрқашан осылай болады! ≫
Dialogue: 0,0:06:21.40,0:06:25.12,Default,,0,0,0,,≪Тағдыр осы ма!?≫
Dialogue: 0,0:06:25.12,0:06:28.32,Default,,0,0,0,,Қақпа!!
Dialogue: 0,0:06:29.74,0:06:31.74,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:36.28,0:06:38.28,Default,,0,0,0,,Заш!
Dialogue: 0,0:06:44.80,0:06:47.02,Default,,0,0,0,,Уау!!
Dialogue: 0,0:06:47.02,0:06:49.24,Default,,0,0,0,,Ақ айдаһар! Бейшара мен.
Dialogue: 0,0:06:49.24,0:06:51.24,Default,,0,0,0,,Ха! (Хакурю) Ух...
Dialogue: 0,0:06:52.66,0:06:57.13,Default,,0,0,0,,Ең болмаса рақым ет. Мен сізге дәл қазір жеңілдетемін.
Dialogue: 0,0:06:57.13,0:07:09.10,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:09.10,0:07:11.61,Default,,0,0,0,,Максималды сиқыр «Шексіз қылыш биінің қалыптасуы».
Dialogue: 0,0:07:11.61,0:07:26.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:26.38,0:07:29.08,Default,,0,0,0,,Гяах! Апыр-ай! →
Dialogue: 0,0:07:29.08,0:07:32.89,Default,,0,0,0,,Бұл өте жеңіл! Одан ауыры бар емес пе?
Dialogue: 0,0:07:32.89,0:07:35.14,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:07:35.14,0:07:38.86,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:38.86,0:07:41.26,Default,,0,0,0,,≪Бұл түсінікті емес≫
Dialogue: 0,0:07:41.26,0:07:43.96,Default,,0,0,0,,≪Патша айтып отырған қара металл құралын қолданушы...≫
Dialogue: 0,0:07:43.96,0:07:47.06,Default,,0,0,0,,Кін! (2 адам) Уф... Хмф!
Dialogue: 0,0:07:48.47,0:07:50.50,Default,,0,0,0,,Кин Кин Кин!
Dialogue: 0,0:07:50.50,0:07:53.39,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:53.39,0:07:55.39,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:56.74,0:08:00.58,Default,,0,0,0,,Туысқан үшін өте жақсы.
Dialogue: 0,0:08:00.58,0:08:04.18,Default,,0,0,0,,Бірақ сен менің қара металл бұйымдарыма сәйкес келмейді.
Dialogue: 0,0:08:04.18,0:08:07.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:07.79,0:08:10.07,Default,,0,0,0,,Не... Уф!
Dialogue: 0,0:08:10.07,0:08:12.07,Default,,0,0,0,,Тағы бір нәрсе.
Dialogue: 0,0:08:13.96,0:08:16.43,Default,,0,0,0,,Енді осыдан да құтыла аласың ба!?
Dialogue: 0,0:08:16.43,0:08:19.02,Default,,0,0,0,,Кин kin kin kin... Уф! Ах... Қарғыс атсын! →
Dialogue: 0,0:08:19.02,0:08:23.39,Default,,0,0,0,,Ах! Хмм…. Ха!
Dialogue: 0,0:08:23.39,0:08:25.39,Default,,0,0,0,,Заш! Апыр-ай!
Dialogue: 0,0:08:27.89,0:08:30.64,Default,,0,0,0,,Хмм…. дөрекі. →
Dialogue: 0,0:08:30.64,0:08:33.00,Default,,0,0,0,,Тағы біреуі болды.
Dialogue: 0,0:08:33.00,0:08:35.03,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:08:35.03,0:08:37.55,Default,,0,0,0,,Жаншылды!
Dialogue: 0,0:08:37.55,0:08:42.89,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:42.89,0:08:44.99,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:08:44.99,0:08:47.03,Default,,0,0,0,,Хмм, ой.
Dialogue: 0,0:08:47.03,0:08:52.62,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:52.62,0:08:55.67,Default,,0,0,0,,Хмм, сіз өз күшіңізді мақтан етесіз. →
Dialogue: 0,0:08:55.67,0:09:00.07,Default,,0,0,0,,Жақсы, мен саған Қара патшаның күшін көрсетемін!
Dialogue: 0,0:09:02.06,0:09:05.63,Default,,0,0,0,,«Мың қолдың айналуы» толық денелі сиқырлы сауыт!
Dialogue: 0,0:09:05.63,0:09:13.92,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:13.92,0:09:15.96,Default,,0,0,0,,Ах! Таң!
Dialogue: 0,0:09:15.96,0:09:20.03,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:20.03,0:09:22.19,Default,,0,0,0,,Бухьяхяхяхя!
Dialogue: 0,0:09:22.19,0:09:25.20,Default,,0,0,0,,Пэйлин! Қарғыс атсын!
Dialogue: 0,0:09:25.20,0:09:28.58,Default,,0,0,0,,Эй, эй! Менің қара металл ыдысым →
Dialogue: 0,0:09:28.58,0:09:31.32,Default,,0,0,0,,Егер сізге қара жарық сферасы түссе, сиқыршының «кедергі сиқыры» т.б.→
Dialogue: 0,0:09:31.32,0:09:33.69,Default,,0,0,0,,Бұл бір жапырақ қағаз сияқты.
Dialogue: 0,0:09:33.69,0:09:35.73,Default,,0,0,0,,Қарғыс атсын! Қызық!?
Dialogue: 0,0:09:35.73,0:09:38.04,Default,,0,0,0,,1-ші взвод артқа.
Dialogue: 0,0:09:38.04,0:09:41.03,Default,,0,0,0,,2-3-ші взвод дайын! →
Dialogue: 0,0:09:41.03,0:09:43.62,Default,,0,0,0,,Босатыңыз!
Dialogue: 0,0:09:43.62,0:09:46.50,Default,,0,0,0,,Менің ойымша, олар жалпы алғанда біркелкі сәйкес келеді.
Dialogue: 0,0:09:46.50,0:09:48.99,Default,,0,0,0,,Эй, эй! Бұл мүмкін емес →
Dialogue: 0,0:09:48.99,0:09:52.79,Default,,0,0,0,,Мұның бәрі біздің стратегиямызға байланысты деп ойлайсыз ба? Ах!
Dialogue: 0,0:09:52.79,0:09:56.51,Default,,0,0,0,,Пип (ысқырық дыбысы)
Dialogue: 0,0:09:56.51,0:10:01.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:01.38,0:10:03.90,Default,,0,0,0,,Гоаа!
Dialogue: 0,0:10:03.90,0:10:07.67,Default,,0,0,0,,Қане, бәріміз, мына қара оғаш нәрсені жеп алыңдар!
Dialogue: 0,0:10:07.67,0:10:14.28,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:14.28,0:10:16.65,Default,,0,0,0,,Гуруру…
Dialogue: 0,0:10:16.65,0:10:19.35,Default,,0,0,0,,Ах! өтірік….
Dialogue: 0,0:10:20.59,0:10:22.62,Default,,0,0,0,,Аа….
Dialogue: 0,0:10:22.62,0:10:25.14,Default,,0,0,0,,Ол зат бәрін жұтып қойғанда→
Dialogue: 0,0:10:25.14,0:10:29.35,Default,,0,0,0,,Сенің елің бітеді!
Dialogue: 0,0:10:29.35,0:10:31.38,Default,,0,0,0,,Шин! Бұл не!?
Dialogue: 0,0:10:31.38,0:10:33.42,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:10:33.42,0:10:37.74,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:37.74,0:10:40.84,Default,,0,0,0,,Максималды сиқыр Бұл тамаша.
Dialogue: 0,0:10:46.75,0:10:50.05,Default,,0,0,0,,Құрметті Иснаан, енді ұйым →
Dialogue: 0,0:10:50.05,0:10:53.62,Default,,0,0,0,,Сіз Мұстасимды қалпына келтіруге көмектесесіз бе?
Dialogue: 0,0:10:53.62,0:10:56.89,Default,,0,0,0,,Сен ақымақ. Қай жерде түсіріп жатырсың?
Dialogue: 0,0:10:56.89,0:10:59.41,Default,,0,0,0,,Не? Жарайды!!
Dialogue: 0,0:10:59.41,0:11:02.11,Default,,0,0,0,,Бакин! Ысқақ!
Dialogue: 0,0:11:03.48,0:11:05.88,Default,,0,0,0,,Ах! →
Dialogue: 0,0:11:05.88,0:11:08.77,Default,,0,0,0,,Неге сондасың!?
Dialogue: 0,0:11:08.77,0:11:11.55,Default,,0,0,0,,«Су айнасының айнасы». Жоғары температуралы бумен→
Dialogue: 0,0:11:11.55,0:11:14.82,Default,,0,0,0,,Жарықтың сынуын тудыратын су сиқыры.
Dialogue: 0,0:11:14.82,0:11:17.29,Default,,0,0,0,,Steam? Амал жоқ→
Dialogue: 0,0:11:17.29,0:11:21.25,Default,,0,0,0,,Сондықтан олар бу шығару үшін сиқырды қолданды!?
Dialogue: 0,0:11:21.25,0:11:23.47,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:11:23.47,0:11:25.84,Default,,0,0,0,,Ысқақ!
Dialogue: 0,0:11:25.84,0:11:28.92,Default,,0,0,0,,Кін! Уф! Қарғыс атсын!
Dialogue: 0,0:11:28.92,0:11:32.53,Default,,0,0,0,,Исаак Сол адамдарды жең.
Dialogue: 0,0:11:32.53,0:11:35.16,Default,,0,0,0,,Иә, патшайым… Мәртебелі….
Dialogue: 0,0:11:35.16,0:11:40.63,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:40.63,0:11:42.73,Default,,0,0,0,,Менің сиқырым таусылды.
Dialogue: 0,0:11:44.20,0:11:46.60,Default,,0,0,0,,Қарғыс атсын! Бакин!
Dialogue: 0,0:11:47.96,0:11:52.36,Default,,0,0,0,,Ха! қуыс!? Тіпті басымның ішінде...
Dialogue: 0,0:11:52.36,0:11:55.41,Default,,0,0,0,,Қарғыс атсын! Сіз жасадыңыз. →
Dialogue: 0,0:11:55.41,0:11:57.85,Default,,0,0,0,,Бірақ әлі емес! Әлі біткен жоқ. →
Dialogue: 0,0:11:57.85,0:12:00.64,Default,,0,0,0,,Дұрыс па? Ысқақ!
Dialogue: 0,0:12:00.64,0:12:04.21,Default,,0,0,0,,Иә… Королева….
Dialogue: 0,0:12:04.21,0:12:06.56,Default,,0,0,0,,Бұл не? Сіз жігіттер.
Dialogue: 0,0:12:06.56,0:12:11.00,Default,,0,0,0,,Бұл қуыршақ. Сол қылышшы темір құмнан жаралған.
Dialogue: 0,0:12:11.00,0:12:15.25,Default,,0,0,0,,Бұл сол адамның магниттік сиқырымен қозғалған қуыршақ еді.
Dialogue: 0,0:12:15.25,0:12:18.32,Default,,0,0,0,,Жарайды, менің рыцарым күткендей.
Dialogue: 0,0:12:18.32,0:12:21.86,Default,,0,0,0,,Екеуміз енді арманымызды орындаймыз деген уәде ғой, солай ма?
Dialogue: 0,0:12:21.86,0:12:27.55,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:27.55,0:12:31.45,Default,,0,0,0,,Ысқақ? А... А? →
Dialogue: 0,0:12:32.90,0:12:34.90,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,0:12:36.47,0:12:40.84,Default,,0,0,0,,Тек сен әрқашан жанымда боласың →
Dialogue: 0,0:12:40.84,0:12:43.01,Default,,0,0,0,,Сен осылай уәде бердің бе?
Dialogue: 0,0:12:43.01,0:12:46.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:46.30,0:12:48.35,Default,,0,0,0,,Ысқақ….
Dialogue: 0,0:12:48.35,0:12:51.47,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:51.47,0:12:55.47,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:12:57.53,0:12:59.56,Default,,0,0,0,,Ысқақ….
Dialogue: 0,0:12:59.56,0:13:06.54,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:06.54,0:13:09.47,Default,,0,0,0,,Мүмкін ол адамдар да әт-Саменде болуы мүмкін→
Dialogue: 0,0:13:09.47,0:13:12.47,Default,,0,0,0,,Жаңа ғана қолданылуда... Тоқтаңыз!
Dialogue: 0,0:13:12.47,0:13:14.51,Default,,0,0,0,,Бізді қатты ренжітті →
Dialogue: 0,0:13:14.51,0:13:16.80,Default,,0,0,0,,Тіпті Хакурюдің қолын ал!
Dialogue: 0,0:13:16.80,0:13:21.12,Default,,0,0,0,,Бірақ... Жау болсаң, мені дұшпандай көр!
Dialogue: 0,0:13:21.12,0:13:27.89,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:27.89,0:13:30.34,Default,,0,0,0,,Уф! Ха.
Dialogue: 0,0:13:30.34,0:13:33.65,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:33.65,0:13:36.53,Default,,0,0,0,,Сен де Қасым сияқты→
Dialogue: 0,0:13:36.53,0:13:40.33,Default,,0,0,0,,Олар жай ғана қолданылып жатқан сияқты...
Dialogue: 0,0:13:43.37,0:13:46.27,Default,,0,0,0,,Жарайсың Ысқақ...
Dialogue: 0,0:13:48.29,0:13:50.81,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:50.81,0:13:53.63,Default,,0,0,0,,Алибаба-кун, жоқ! Қарғы сатқыр….
Dialogue: 0,0:13:53.63,0:14:00.89,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:00.89,0:14:03.68,Default,,0,0,0,,Боқ... Қарғыс атсын!!
Dialogue: 0,0:14:03.68,0:14:06.30,Default,,0,0,0,,Гакин!
Dialogue: 0,0:14:06.30,0:14:08.30,Default,,0,0,0,,Алибаба-кун.
Dialogue: 0,0:14:11.93,0:14:14.70,Default,,0,0,0,,Уф! Ах!
Dialogue: 0,0:14:14.70,0:14:18.90,Default,,0,0,0,,Өкінішке орай, сіздің рөліңіз аяқталды, Дүния.
Dialogue: 0,0:14:22.14,0:14:24.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:24.36,0:14:27.56,Default,,0,0,0,,Таң! Таң! Таң!
Dialogue: 0,0:14:30.75,0:14:34.32,Default,,0,0,0,,Енді осымен бітейік!
Dialogue: 0,0:14:34.32,0:14:36.36,Default,,0,0,0,,Иә! Хоора! →
Dialogue: 0,0:14:36.36,0:14:38.64,Default,,0,0,0,,Қара, қара, қара!
Dialogue: 0,0:14:38.64,0:14:41.94,Default,,0,0,0,,Жақсылап жалтармасаң, жаншып кетесің!
Dialogue: 0,0:14:44.02,0:14:47.40,Default,,0,0,0,,Ах~ Не істеуім керек~!?
Dialogue: 0,0:14:47.40,0:14:51.36,Default,,0,0,0,,Бағынышты қару Важра бронь.
Dialogue: 0,0:14:51.36,0:14:53.36,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:14:55.56,0:14:57.56,Default,,0,0,0,,Ха! Дау!
Dialogue: 0,0:15:00.38,0:15:02.43,Default,,0,0,0,,Арх! Уф….
Dialogue: 0,0:15:02.43,0:15:08.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:08.11,0:15:10.93,Default,,0,0,0,,Хехехехехе. →
Dialogue: 0,0:15:10.93,0:15:13.33,Default,,0,0,0,,Ау, ауырады ма? →
Dialogue: 0,0:15:13.33,0:15:17.52,Default,,0,0,0,,Хэхехе. Бейшара вассал →
Dialogue: 0,0:15:17.52,0:15:21.82,Default,,0,0,0,,Мен сені ең болмағанда бар күшіммен жерлеймін.
Dialogue: 0,0:15:23.76,0:15:27.58,Default,,0,0,0,,«Банканың көлеңкесін қалыптастыру» максималды сиқыры!
Dialogue: 0,0:15:27.58,0:15:33.78,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:33.78,0:15:36.75,Default,,0,0,0,,Оған көмектесу мүмкін емес. →
Dialogue: 0,0:15:36.75,0:15:40.95,Default,,0,0,0,,Мен де өз патшамның билігін қарызға аламын ба?
Dialogue: 0,0:15:42.36,0:15:45.26,Default,,0,0,0,,Күнкөріс қаруы Аққан қылыш!
Dialogue: 0,0:15:48.06,0:15:51.18,Default,,0,0,0,,Уфуфуфу. Туысқан сияқты →
Dialogue: 0,0:15:51.18,0:15:53.89,Default,,0,0,0,,Менің бұл техникамды бұғаттауға бола ма?
Dialogue: 0,0:15:53.89,0:16:00.13,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:00.13,0:16:02.13,Default,,0,0,0,,Ah...re?
Dialogue: 0,0:16:03.96,0:16:07.15,Default,,0,0,0,,Нашар. Менің қылышым →
Dialogue: 0,0:16:07.15,0:16:10.64,Default,,0,0,0,,Сіз қиғаш сызықтың траекториясын еркін басқара аласыз.
Dialogue: 0,0:16:10.64,0:16:13.69,Default,,0,0,0,,Уф... Маған ұнамайды. →
Dialogue: 0,0:16:13.69,0:16:17.19,Default,,0,0,0,,Мен мұның біткенін қаламаймын...
Dialogue: 0,0:16:17.19,0:16:20.53,Default,,0,0,0,,Мен әлі де... Уф!
Dialogue: 0,0:16:20.53,0:16:22.53,Default,,0,0,0,,Ах! Эй!
Dialogue: 0,0:16:24.18,0:16:26.18,Default,,0,0,0,,Әпке!
Dialogue: 0,0:16:27.74,0:16:29.74,Default,,0,0,0,,Уф….
Dialogue: 0,0:16:32.36,0:16:34.36,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:36.01,0:16:38.41,Default,,0,0,0,,Құрметті сіздерге!!
Dialogue: 0,0:16:41.58,0:16:45.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:45.00,0:16:47.99,Default,,0,0,0,,Бұл адамның Руфі ме?
Dialogue: 0,0:16:47.99,0:16:51.73,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:51.73,0:16:54.03,Default,,0,0,0,,≪Осы адам туралы естеліктер? ≫
Dialogue: 0,0:16:55.93,0:16:58.72,Default,,0,0,0,,≪Қасим≫ сияқты
Dialogue: 0,0:16:58.72,0:17:01.82,Default,,0,0,0,,) ((≪маған ұнамайды~!))
Dialogue: 0,0:17:01.82,0:17:04.09,Default,,0,0,0,,((Magnostadt!→
Dialogue: 0,0:17:04.09,0:17:06.49,Default,,0,0,0,,Магностадт! →
Dialogue: 0,0:17:06.49,0:17:08.66,Default,,0,0,0,,Магностадт! ))
Dialogue: 0,0:17:08.66,0:17:12.38,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:17:12.38,0:17:15.17,Default,,0,0,0,,((Бұдан былай Магностадт ректоры Могамет болады
Dialogue: 0,0:17:15.17,0:17:17.24,Default,,0,0,0,,Өйткені ол патша болады))
Dialogue: 0,0:17:17.24,0:17:21.56,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:17:21.56,0:17:23.54,Default,,0,0,0,,((Уау!)) ((Гах...))
Dialogue: 0,0:17:23.54,0:17:26.66,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:26.66,0:17:28.93,Default,,0,0,0,,((Подольдік отбасын жою туралы бұйрық))
Dialogue: 0,0:17:28.93,0:17:30.98,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:17:30.98,0:17:34.28,Default,,0,0,0,,Бұл Мұстасим патшалығындағы көтеріліс пе?
Dialogue: 0,0:17:35.65,0:17:38.72,Default,,0,0,0,,) ((Аа... ах~!))
Dialogue: 0,0:17:38.72,0:17:41.32,Default,,0,0,0,,≪Ел күйеді...≫
Dialogue: 0,0:17:43.28,0:17:46.28,Default,,0,0,0,,≪Неге? ≫
Dialogue: 0,0:17:46.28,0:17:50.08,Default,,0,0,0,,≪Әр адам бақытты болғысы келеді≫
Dialogue: 0,0:17:51.50,0:17:54.44,Default,,0,0,0,,≪Неге біз бір-бірімізді өлтіреміз? ≫
Dialogue: 0,0:17:54.44,0:17:57.86,Default,,0,0,0,,≪Неге мен өлуім керек?≫
Dialogue: 0,0:17:57.86,0:18:00.68,Default,,0,0,0,,Ах! Жоқ, Алибаба-кун!
Dialogue: 0,0:18:00.68,0:18:03.02,Default,,0,0,0,,Егер сіз оның Руффпен келісесіз...
Dialogue: 0,0:18:03.02,0:18:05.82,Default,,0,0,0,,((Мен ханшайымды таптым!)) ((Ааа!))
Dialogue: 0,0:18:05.82,0:18:07.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:09.74,0:18:13.16,Default,,0,0,0,,((Пышағыңызды лордқа, корольдік отбасына және т.б. қарсы көрсету. →
Dialogue: 0,0:18:13.16,0:18:15.44,Default,,0,0,0,,Рыцарь болып ұялмайсың ба!?))
Dialogue: 0,0:18:15.44,0:18:24.44,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:18:24.44,0:18:27.21,Default,,0,0,0,,) ((ханшайым әлі жас →
Dialogue: 0,0:18:27.21,0:18:31.64,Default,,0,0,0,,Күнәсіз болсам да, неге өлуім керек!?))
Dialogue: 0,0:18:31.64,0:18:35.71,Default,,0,0,0,,((Неге? Былайша айтқанда →
Dialogue: 0,0:18:35.71,0:18:38.15,Default,,0,0,0,,Өйткені бұл тағдыр! ))
Dialogue: 0,0:18:38.15,0:18:40.59,Default,,0,0,0,,) ((күш!))
Dialogue: 0,0:18:40.59,0:18:48.14,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:18:48.14,0:18:51.15,Default,,0,0,0,,≪Не? ≫
Dialogue: 0,0:18:51.15,0:18:53.15,Default,,0,0,0,,≪Неге бәрі...≫
Dialogue: 0,0:18:55.17,0:18:58.70,Default,,0,0,0,,≪Осындай нәрсені анық көрінетіндей жасай аласыз ба? ≫
Dialogue: 0,0:18:58.70,0:19:03.86,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:19:03.86,0:19:05.91,Default,,0,0,0,,<<Шешілді дейсіз бе? ≫
Dialogue: 0,0:19:05.91,0:19:13.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:13.82,0:19:15.87,Default,,0,0,0,,≪Туған...≫
Dialogue: 0,0:19:15.87,0:19:18.27,Default,,0,0,0,,≪Тікелей...≫
Dialogue: 0,0:19:18.27,0:19:21.99,Default,,0,0,0,,≪Соңы тым оңай аяқталады→
Dialogue: 0,0:19:21.99,0:19:25.65,Default,,0,0,0,,Басынан шешілді дейсіз бе? ≫
Dialogue: 0,0:19:25.65,0:19:30.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:30.34,0:19:33.69,Default,,0,0,0,,≪Адамдарға жол көрсету→
Dialogue: 0,0:19:33.69,0:19:35.72,Default,,0,0,0,,Үлкен қуат≫
Dialogue: 0,0:19:35.72,0:19:41.55,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:41.55,0:19:43.55,Default,,0,0,0,,≪Тағдыр ма? ≫
Dialogue: 0,0:19:45.68,0:19:48.27,Default,,0,0,0,,≪Мен кек сақтаймын≫ ≪Мен кек сақтаймын≫
Dialogue: 0,0:19:48.27,0:19:51.77,Default,,0,0,0,,≪Мен тағдырды жек көремін≫
Dialogue: 0,0:21:55.03,0:21:57.80,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:57.80,0:22:01.64,Default,,0,0,0,,Құлаған. Адамдар тағдырына қарғыс айтқан кезде →
Dialogue: 0,0:22:01.64,0:22:04.69,Default,,0,0,0,,Бұл адамның Руфы қара болады.
Dialogue: 0,0:22:04.69,0:22:07.33,Default,,0,0,0,,Ах. Жоқ, Алибаба-кун!
Dialogue: 0,0:22:07.33,0:22:09.85,Default,,0,0,0,,Оның Руфынан тез кет!
Dialogue: 0,0:22:09.85,0:22:13.22,Default,,0,0,0,,Әйтпесе, сен де құлайсың!
Dialogue: 0,0:22:13.22,0:22:15.22,Default,,0,0,0,,Егер бұл орын алса...
Dialogue: 0,0:22:17.35,0:22:21.16,Default,,0,0,0,,Бари Бали! Уф! Гах...
Dialogue: 0,0:22:21.16,0:22:24.26,Default,,0,0,0,,Ой, маған кедергі жасамаңыз →
Dialogue: 0,0:22:24.26,0:22:27.08,Default,,0,0,0,,Маги. Қарғыс атқыр...
Dialogue: 0,0:22:27.08,0:22:29.08,Default,,0,0,0,,Аладдин….
Dialogue: 0,0:22:30.88,0:22:34.45,Default,,0,0,0,,Жарайсың...
Dialogue: 0,0:22:34.45,0:22:38.14,Default,,0,0,0,,Иә! Бұл дұрыс. Жақсы, король Алибаба. →
Dialogue: 0,0:22:38.14,0:22:42.61,Default,,0,0,0,,Жек көру. Бәріне кінәлі менмін. →
Dialogue: 0,0:22:42.61,0:22:46.85,Default,,0,0,0,,Менің кесірімнен туған жерің өртеніп, жан досың өлді→
Dialogue: 0,0:22:46.85,0:22:51.05,Default,,0,0,0,,Енді мен паналаған ел тағы да соғысқа ұласты.
Dialogue: 0,0:22:51.05,0:22:53.09,Default,,0,0,0,,Сіз...
Dialogue: 0,0:22:53.09,0:22:56.74,Default,,0,0,0,,Зағанға келуіңізге мен де себепкермін. →
Dialogue: 0,0:22:56.74,0:23:00.83,Default,,0,0,0,,Менің қарғысым сені осында әкелді. →
Dialogue: 0,0:23:00.83,0:23:04.78,Default,,0,0,0,,Нәтижесінде Фаналис қыздың сиқырлы күші таусылып, өлім аузында қалды→
Dialogue: 0,0:23:04.78,0:23:09.59,Default,,0,0,0,,Жарқыраған ханзада сол қолынан айырылды. Хмм….
Dialogue: 0,0:23:09.59,0:23:12.59,Default,,0,0,0,,Амон, сенде бұл қылыш бар. →
Dialogue: 0,0:23:12.59,0:23:16.46,Default,,0,0,0,,Сол қаланың қожасын лабиринтке апарған мен болдым.
Dialogue: 0,0:23:16.46,0:23:20.53,Default,,0,0,0,,Ах. (Иснан) Түсінесің бе? Мен...→
Dialogue: 0,0:23:20.53,0:23:24.24,Default,,0,0,0,,Мен сенің тағдырыңмын.
Dialogue: 0,0:23:24.24,0:23:27.06,Default,,0,0,0,,Ах... Жақсы емес...→
Dialogue: 0,0:23:27.06,0:23:31.98,Default,,0,0,0,,Адамның айтқанын тыңдаңыз. Уф...
Dialogue: 0,0:23:31.98,0:23:34.43,Default,,0,0,0,,Сіз мені жек көресіз, солай ма? Егер →
Dialogue: 0,0:23:34.43,0:23:38.53,Default,,0,0,0,,Мені мына қара металл затпен өлтіріңіз.
Dialogue: 0,0:23:39.89,0:23:43.71,Default,,0,0,0,,≪Дәл сол кезде жемқор боласың→
Dialogue: 0,0:23:43.71,0:23:45.74,Default,,0,0,0,,Король Алибаба≫
Dialogue: 0,0:23:45.74,0:23:47.84,Default,,0,0,0,,Қарғыс атсын... қарғыс атсын!
Dialogue: 0,0:23:49.19,0:23:51.23,Default,,0,0,0,,Уау!!
Dialogue: 0,0:23:51.23,0:23:54.42,Default,,0,0,0,,Тоқта, Алибаба-кун!
Dialogue: 0,0:23:54.42,0:23:56.42,Default,,0,0,0,,Тос!
Dialogue: 0,0:23:57.84,0:24:01.29,Default,,0,0,0,,Құттықтаймыз патша Алибаба. →
Dialogue: 0,0:24:01.29,0:24:04.89,Default,,0,0,0,,Әкемізге қош келдіңіз.
Dialogue: 0,0:24:06.18,0:24:08.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:09.60,0:24:11.63,Default,,0,0,0,,Алибаба-кун!
Dialogue: 0,0:24:11.63,0:24:15.60,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:15.60,0:24:17.64,Default,,0,0,0,,Уф! Шин!
Dialogue: 0,0:24:17.64,0:24:20.88,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:20.88,0:24:25.28,Default,,0,0,0,,≪ Қарғыс атсын! Ол ылғалды болды. Бұл олардың шын мақсаты ма?
Dialogue: 0,0:24:25.28,0:24:29.94,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:29.94,0:24:37.74,Default,,0,0,0,,Патша келді.
Dialogue: 0,0:24:37.74,0:24:41.46,Default,,0,0,0,,Енді тағдырдың қамытын тастаңыз →
Dialogue: 0,0:24:41.46,0:24:45.12,Default,,0,0,0,,Жаңа қара патша дүниеге келді.
Dialogue: 0,0:24:45.12,0:24:49.25,Default,,0,0,0,,Қараңғылықтан терең баталар.
Dialogue: 0,0:24:49.25,0:24:58.55,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:00.00,0:25:44.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:48.70,0:25:59.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:07.82,0:26:28.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:31.91,0:30:34.90,Default,,0,0,0,,Премьер-министр Абэ тұрғындардың ядролық апатқа байланысты эвакуациялау орталықтарында тұруын жалғастырып жатқанын айтты.
Dialogue: 0,0:30:35.92,0:30:38.20,Default,,0,0,0,,Намие Таун, Фукусима префектурасында болды, т.б.
Dialogue: 0,0:30:40.12,0:30:41.87,Default,,0,0,0,,Жақында қол жеткізуге шектеулер жеңілдетіледі
Dialogue: 0,0:30:41.87,0:30:45.21,Default,,0,0,0,,Күнделікті өмірге қажетті инфрақұрылымды дамыту және т.б.
Dialogue: 0,0:30:46.71,0:30:51.71,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
