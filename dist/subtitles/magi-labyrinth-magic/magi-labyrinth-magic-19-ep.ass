Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.06,0:00:38.27,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:38.27,0:00:40.44,Default,,0,0,0,,«Қүйген егіз алақан»!
Dialogue: 0,0:00:40.44,0:00:44.04,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:44.04,0:00:46.83,Default,,0,0,0,,≪Тамаша өнім. →
Dialogue: 0,0:00:46.83,0:00:49.73,Default,,0,0,0,,Сен эротикалық бала болсаң да, сиқыршысың≫
Dialogue: 0,0:00:52.13,0:00:55.20,Default,,0,0,0,,күрсіну. Сіз қалай ойлайсыз? Әпке.
Dialogue: 0,0:00:55.20,0:00:58.67,Default,,0,0,0,,Иә, мүлде емес. иә?
Dialogue: 0,0:00:58.67,0:01:01.63,Default,,0,0,0,,Расында да сиқырлы күштің шығуы ғажап. →
Dialogue: 0,0:01:01.63,0:01:06.06,Default,,0,0,0,,Бірақ бұл жай ғана жылудың бөлінуі, сондықтан сиқыр ретінде бұл қарапайым.
Dialogue: 0,0:01:06.06,0:01:09.18,Default,,0,0,0,,Сіз нені айтасыз? Сиқыр дегеніміз →
Dialogue: 0,0:01:09.18,0:01:11.52,Default,,0,0,0,,Сіз тағы да көп нәрсені жасай аласыз.
Dialogue: 0,0:01:11.52,0:01:14.52,Default,,0,0,0,,Мысалы, осылай.
Dialogue: 0,0:01:14.52,0:01:18.43,Default,,0,0,0,,Ах! Әпке?
Dialogue: 0,0:01:18.43,0:01:20.46,Default,,0,0,0,,Мұнда. Ах.
Dialogue: 0,0:01:20.46,0:01:23.65,Default,,0,0,0,,Бұл «Гермиттің су фильмі». Апыр-ай!
Dialogue: 0,0:01:23.65,0:01:26.52,Default,,0,0,0,,Суды жинау Буға түрлендіру →
Dialogue: 0,0:01:26.52,0:01:30.12,Default,,0,0,0,,Жарықты сындыратын үш императивті өрнек →
Dialogue: 0,0:01:30.12,0:01:32.94,Default,,0,0,0,,Мен оны Раффқа беремін. Пәрмен түрі?
Dialogue: 0,0:01:32.94,0:01:35.94,Default,,0,0,0,,Сиқыр іс жүзінде техника.
Dialogue: 0,0:01:35.94,0:01:38.53,Default,,0,0,0,,Руфқа қандай команда беруім керек→
Dialogue: 0,0:01:38.53,0:01:41.85,Default,,0,0,0,,Не болатыны анық анықталған. →
Dialogue: 0,0:01:41.85,0:01:45.94,Default,,0,0,0,,Бұл дүниені құрайтын көзге көрінбейтін шындық. →
Dialogue: 0,0:01:45.94,0:01:50.76,Default,,0,0,0,,Оны шешіп, біріктіріп, әртүрлі құбылыстарды тудырыңыз →
Dialogue: 0,0:01:50.76,0:01:52.86,Default,,0,0,0,,Бұл сиқыр. →
Dialogue: 0,0:01:52.86,0:01:56.16,Default,,0,0,0,,Егер сіз өзіңіз сияқты сиқырлы қолданушы болсаңыз, жаттығу сізге байланысты →
Dialogue: 0,0:01:56.16,0:02:00.90,Default,,0,0,0,,Тіпті жүздеген команда формулаларын біріктіретін керемет сиқырды қолдануға болады.
Dialogue: 0,0:02:00.90,0:02:04.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:04.21,0:02:08.11,Default,,0,0,0,,Түсіндім, сиқыр деген осы.
Dialogue: 0,0:02:08.11,0:02:11.58,Default,,0,0,0,,Хехе. Рахмет, әпке.
Dialogue: 0,0:02:11.58,0:02:15.43,Default,,0,0,0,,Маған сол сиқырды көбірек үйрете беріңіз.
Dialogue: 0,0:02:15.43,0:02:18.27,Default,,0,0,0,,Күрсін! иә!
Dialogue: 0,0:02:18.27,0:02:20.37,Default,,0,0,0,,Арх! Ауырады...
Dialogue: 0,0:02:20.37,0:02:24.39,Default,,0,0,0,,Ол бос. Сіз шынымен де сол қылышпен жасайсыз ба?
Dialogue: 0,0:02:24.39,0:02:26.98,Default,,0,0,0,,Хмм…. Менің сиқырым →
Dialogue: 0,0:02:26.98,0:02:29.08,Default,,0,0,0,,Неліктен бұлай сезіледі→
Dialogue: 0,0:02:29.08,0:02:31.12,Default,,0,0,0,,Мен бұл туралы бірдеңе істегім келеді.
Dialogue: 0,0:02:31.12,0:02:35.05,Default,,0,0,0,,Қылышың сынса да, жалын болмайды, солай ма?
Dialogue: 0,0:02:35.05,0:02:38.92,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:02:38.92,0:02:43.36,Default,,0,0,0,,≪Содан бері Амон мүлде жауап бермеді≫
Dialogue: 0,0:02:43.36,0:02:45.88,Default,,0,0,0,,Бұл, әрине, қорқынышты күйде.
Dialogue: 0,0:02:45.88,0:02:47.92,Default,,0,0,0,,Синдбад мырза.
Dialogue: 0,0:02:47.92,0:02:50.38,Default,,0,0,0,,Біріншіден, мен бұл қылыш туралы бірдеңе істеуім керек.
Dialogue: 0,0:02:50.38,0:02:52.38,Default,,0,0,0,,Не? Кел.
Dialogue: 0,0:02:54.64,0:02:58.06,Default,,0,0,0,,Гача (есік дыбысы) Ол қылыш →
Dialogue: 0,0:02:58.06,0:03:00.95,Default,,0,0,0,,Қазір жақсы емес. Аа!?
Dialogue: 0,0:03:00.95,0:03:03.21,Default,,0,0,0,,Джин өлген жоқ. →
Dialogue: 0,0:03:03.21,0:03:05.32,Default,,0,0,0,,Джинді басқа металл ыдысқа ауыстырсаңыз→
Dialogue: 0,0:03:05.32,0:03:07.49,Default,,0,0,0,,Қайта пайдалануға болады.
Dialogue: 0,0:03:07.49,0:03:10.87,Default,,0,0,0,,Жақсы. Бірақ қандай металл?
Dialogue: 0,0:03:10.87,0:03:13.94,Default,,0,0,0,,Мәселе оны беру керек пе? (2 адам) Иә?
Dialogue: 0,0:03:13.94,0:03:18.01,Default,,0,0,0,,Жын – қожайынымен бірігіп күш көрсететін нәрсе. →
Dialogue: 0,0:03:18.01,0:03:20.15,Default,,0,0,0,,Сондықтан металл ыдыс →
Dialogue: 0,0:03:20.15,0:03:22.25,Default,,0,0,0,,Бұл сіз көптен үйренген нәрсе ме→
Dialogue: 0,0:03:22.25,0:03:25.42,Default,,0,0,0,,Сіздің сезіміңіз немесе байланысыңыз бар нәрсе. →
Dialogue: 0,0:03:25.42,0:03:28.84,Default,,0,0,0,,Бұл пышақ да маңызды болды, солай ма?
Dialogue: 0,0:03:28.84,0:03:32.03,Default,,0,0,0,,Бұл соншалықты үлкен мәселе емес →
Dialogue: 0,0:03:32.03,0:03:34.55,Default,,0,0,0,,Патша сарайына кіргеннен кейін көп ұзамай →
Dialogue: 0,0:03:34.55,0:03:37.90,Default,,0,0,0,,Марқұм Король Барбад үшін сауда бойынша сыныптан тыс оқыту...→
Dialogue: 0,0:03:37.90,0:03:41.15,Default,,0,0,0,,Әкем маған бір-ақ рет келген →
Dialogue: 0,0:03:41.15,0:03:44.87,Default,,0,0,0,,Сол күні мен бірінші рет келіссөздерге қол жеткіздім→
Dialogue: 0,0:03:44.87,0:03:47.17,Default,,0,0,0,,Мына пайдамен алған пышақ.
Dialogue: 0,0:03:48.68,0:03:51.73,Default,,0,0,0,,Жоқ... бұл арзан болса да.
Dialogue: 0,0:03:51.73,0:03:53.83,Default,,0,0,0,,Бұзылғанына біраз көңілім қалды.
Dialogue: 0,0:03:56.38,0:04:00.08,Default,,0,0,0,,көремін. Бұл бұрынғы патшаға қатысты пышақ.
Dialogue: 0,0:04:02.02,0:04:04.31,Default,,0,0,0,,Бұл не? Мен бұрын → болатынмын
Dialogue: 0,0:04:04.31,0:04:06.83,Default,,0,0,0,,Марқұм Барбад патшаның маған берген қылыш.
Dialogue: 0,0:04:06.83,0:04:09.46,Default,,0,0,0,,А... әкемнен бе?
Dialogue: 0,0:04:09.46,0:04:12.53,Default,,0,0,0,,Белгілі бір шайқаста ел мен халық жараланды →
Dialogue: 0,0:04:12.53,0:04:15.35,Default,,0,0,0,,Адасып қалғанда берді.
Dialogue: 0,0:04:15.35,0:04:17.99,Default,,0,0,0,,Жүрегіңді қатайт...
Dialogue: 0,0:04:17.99,0:04:21.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:21.59,0:04:23.59,Default,,0,0,0,,Бұл жолы мен оны саған сеніп тапсырамын.
Dialogue: 0,0:04:25.55,0:04:28.58,Default,,0,0,0,,Қылышты қайтадан қолға алсаңыз →
Dialogue: 0,0:04:28.58,0:04:31.19,Default,,0,0,0,,Егер сіз ұмтылуыңыз керек нәрсе болса.
Dialogue: 0,0:04:31.19,0:04:37.26,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:37.26,0:04:39.29,Default,,0,0,0,,Өз өміріңізге қауіп төндіріңіз.
Dialogue: 0,0:04:39.29,0:04:50.87,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:50.87,0:04:52.91,Default,,0,0,0,,Ах.
Dialogue: 0,0:04:52.91,0:04:56.46,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:56.46,0:04:58.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:00.80,0:05:02.85,Default,,0,0,0,,Амон көшіп кетті.
Dialogue: 0,0:05:02.85,0:05:05.90,Default,,0,0,0,,Джиннің тез қозғалатынына сене алар емеспін→
Dialogue: 0,0:05:05.90,0:05:09.10,Default,,0,0,0,,Әкеңнің нұсқауы шығар. Ах.
Dialogue: 0,0:05:14.06,0:05:47.42,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:51.37,0:06:44.09,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:45.87,0:06:49.96,Default,,0,0,0,,Енді Морджиананың кезегі. иә?
Dialogue: 0,0:06:49.96,0:06:53.53,Default,,0,0,0,,Осылардың ішінен өзіңізге ұнайтын металл бұйымды таңдаңыз.
Dialogue: 0,0:06:53.53,0:06:56.23,Default,,0,0,0,,Иә? Мен... Мен бе?
Dialogue: 0,0:06:56.23,0:06:58.68,Default,,0,0,0,,Иә. Сіздер Alibabaсыздар және балалар→
Dialogue: 0,0:06:58.68,0:07:02.05,Default,,0,0,0,,Егер сіз олармен бірге соғыссаңыз, олардың ізбасарлары бола аласыз.
Dialogue: 0,0:07:02.05,0:07:04.87,Default,,0,0,0,,Ах. Жазылушылар?
Dialogue: 0,0:07:04.87,0:07:07.99,Default,,0,0,0,,Патшаның ыдысы мен патшаның сиқырына тартылған →
Dialogue: 0,0:07:07.99,0:07:10.44,Default,,0,0,0,,Жынның қабілетінен пайда алу →
Dialogue: 0,0:07:10.44,0:07:13.03,Default,,0,0,0,,Ол күшті жауынгер. Ах.
Dialogue: 0,0:07:13.03,0:07:15.73,Default,,0,0,0,,Сол себепті оны тәуелді мүше → деп атайды
Dialogue: 0,0:07:15.73,0:07:18.90,Default,,0,0,0,,Бізге күшті ұстап тұратын ыдыс керек. →
Dialogue: 0,0:07:18.90,0:07:22.02,Default,,0,0,0,,Сіз киетін кез келген металл жақсы. →
Dialogue: 0,0:07:22.02,0:07:24.56,Default,,0,0,0,,Кез келген Морджиана сізге жақсы көрінеді.
Dialogue: 0,0:07:24.56,0:07:27.13,Default,,0,0,0,,Ах... Бірдеңе →
Dialogue: 0,0:07:27.13,0:07:29.53,Default,,0,0,0,,Мен олардың ешқайсысын киіп көрген емеспін.
Dialogue: 0,0:07:29.53,0:07:32.23,Default,,0,0,0,,≪О, Морджиана! (2 адам) Иә?
Dialogue: 0,0:07:32.23,0:07:34.53,Default,,0,0,0,,Бұл сізге жақсы емес пе?
Dialogue: 0,0:07:36.37,0:07:38.97,Default,,0,0,0,,≪Алибаба-кун, қызға ондай болмайды...≫
Dialogue: 0,0:07:40.46,0:07:43.28,Default,,0,0,0,,Бұл маған жақсы көрінеді ме? иә! Шынымен күшті көрінеді.
Dialogue: 0,0:07:43.28,0:07:46.30,Default,,0,0,0,,≪Иә? Сіз сондай бақытты көрінесіз≫
Dialogue: 0,0:07:46.30,0:07:48.35,Default,,0,0,0,,Расында, Морджиана да→
Dialogue: 0,0:07:48.35,0:07:51.40,Default,,0,0,0,,Мен әрқашан киген металды жақсы көремін.
Dialogue: 0,0:07:51.40,0:07:53.80,Default,,0,0,0,,Иә? Хмм….
Dialogue: 0,0:07:55.16,0:07:58.69,Default,,0,0,0,,Ах. Бұл...→
Dialogue: 0,0:07:58.69,0:08:02.39,Default,,0,0,0,,Кез келген металды қолдануға бола ма? аа.
Dialogue: 0,0:08:07.10,0:08:09.92,Default,,0,0,0,,Ах. Эй, бұл...
Dialogue: 0,0:08:09.92,0:08:13.81,Default,,0,0,0,,Иә, бұл менің киген бұғауларым.
Dialogue: 0,0:08:13.81,0:08:16.99,Default,,0,0,0,,Мен оны тастамай ұзақ сақтадым.
Dialogue: 0,0:08:16.99,0:08:19.81,Default,,0,0,0,,Бұл Аладдин → сөйлейді
Dialogue: 0,0:08:19.81,0:08:21.85,Default,,0,0,0,,Гортас кесіп тастайды →
Dialogue: 0,0:08:21.85,0:08:23.85,Default,,0,0,0,,Alibaba оны алып тастады →
Dialogue: 0,0:08:25.52,0:08:29.24,Default,,0,0,0,,Жақындарыма қарыздармын→
Dialogue: 0,0:08:29.24,0:08:31.53,Default,,0,0,0,,Бұл мен мақтан тұтатын маңызды тармақ.
Dialogue: 0,0:08:31.53,0:08:34.46,Default,,0,0,0,,Иә. ≪Кеңестер Кеңестер Кеңестер Кеңестер (аяқ дыбыстары)
Dialogue: 0,0:08:34.46,0:08:36.56,Default,,0,0,0,,≪Mr. (Джафар) Сингх. (3 адам) Иә?
Dialogue: 0,0:08:36.56,0:08:39.38,Default,,0,0,0,,Коу империясынан делегация келді.
Dialogue: 0,0:08:39.38,0:08:53.90,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:53.90,0:08:56.00,Default,,0,0,0,,Ах.
Dialogue: 0,0:08:56.00,0:08:59.35,Default,,0,0,0,,≪Ол Коу империясының ханзадасы ма?≫
Dialogue: 0,0:08:59.35,0:09:01.41,Default,,0,0,0,,Жек көру.
Dialogue: 0,0:09:01.41,0:09:03.44,Default,,0,0,0,,≪Не? ≫
Dialogue: 0,0:09:03.44,0:09:05.96,Default,,0,0,0,,Коу империясының төртінші ханзадасы→
Dialogue: 0,0:09:05.96,0:09:10.16,Default,,0,0,0,,Бұл Рен Хакурю. Мен ұлы мәртебеліден естідім. →
Dialogue: 0,0:09:10.16,0:09:13.33,Default,,0,0,0,,Қош келдіңіз. (Хакурю) Қайын атамның өмірі болмаса да →
Dialogue: 0,0:09:13.33,0:09:15.92,Default,,0,0,0,,Мен сені кездестіремін деп үміттендім.
Dialogue: 0,0:09:15.92,0:09:18.81,Default,,0,0,0,,Бұл құрмет. Айтпақшы →
Dialogue: 0,0:09:18.81,0:09:22.61,Default,,0,0,0,,Хакурю-дононың артындағы дворян... (Джафар) Ах~!
Dialogue: 0,0:09:24.33,0:09:26.93,Default,,0,0,0,,Қайта... Рен Кугёку-доно!
Dialogue: 0,0:09:28.40,0:09:31.47,Default,,0,0,0,,Ах~ Оны Синдбад қызықтырады, солай емес пе?
Dialogue: 0,0:09:31.47,0:09:34.52,Default,,0,0,0,,Ол мені қуып келе жатты. Хехе!
Dialogue: 0,0:09:34.52,0:09:38.43,Default,,0,0,0,,Өткен күн қалай болды? Сізді қайта көруге қуаныштымын.
Dialogue: 0,0:09:38.43,0:09:40.71,Default,,0,0,0,,Қош келдіңіз. (Джафар) Иә?
Dialogue: 0,0:09:40.71,0:09:43.98,Default,,0,0,0,,Иә? Бұл қалыпты ма? (Жафар) Жақсы...→
Dialogue: 0,0:09:43.98,0:09:47.40,Default,,0,0,0,,Онда ештеңе жоқ сияқты. иә? Не?
Dialogue: 0,0:09:47.40,0:09:50.57,Default,,0,0,0,,Біраз уақыт өтті. Коу империясында →
Dialogue: 0,0:09:50.57,0:09:53.27,Default,,0,0,0,,Мен сенімен ешқашан кездесе алмадым. →
Dialogue: 0,0:09:53.27,0:09:57.48,Default,,0,0,0,,Жарайды, мен сені қайтадан көргеніме өте қуаныштымын. Хахаха!
Dialogue: 0,0:09:57.48,0:10:01.02,Default,,0,0,0,,Ешқашан кездесуге мүмкіндік болмады ма?
Dialogue: 0,0:10:01.02,0:10:03.02,Default,,0,0,0,,Не? (Қызыл доп) Хмф!
Dialogue: 0,0:10:04.44,0:10:07.07,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:10:07.07,0:10:10.02,Default,,0,0,0,,Не? (Қызыл доп) Синдбад...→
Dialogue: 0,0:10:10.02,0:10:13.86,Default,,0,0,0,,Кешірім сұраған соң көз жасымды ішіп, елім үшін шыдаймын деп ойладым.→
Dialogue: 0,0:10:13.86,0:10:16.20,Default,,0,0,0,,Мен сені кешіре алмаймын!
Dialogue: 0,0:10:16.20,0:10:18.53,Default,,0,0,0,,Дуэль, Синдбад!
Dialogue: 0,0:10:18.53,0:10:22.92,Default,,0,0,0,,Өлім жазасына лайық қыздың денесін қорлаған айуандық!!
Dialogue: 0,0:10:22.92,0:10:25.41,Default,,0,0,0,,Иә!? (Жафар) Мен оны білдім! →
Dialogue: 0,0:10:25.41,0:10:29.99,Default,,0,0,0,,Не... не істедің!? Аа!? Мен ештеңе істеген жоқпын!
Dialogue: 0,0:10:29.99,0:10:32.05,Default,,0,0,0,,Сіз нені айтасыз!? Ханшайым!
Dialogue: 0,0:10:32.05,0:10:35.93,Default,,0,0,0,,Ах... Уф... →
Dialogue: 0,0:10:35.93,0:10:37.99,Default,,0,0,0,,Ух... а... (Жафар) Әй!
Dialogue: 0,0:10:37.99,0:10:40.85,Default,,0,0,0,,Уф…. Сен мені жылаттың.
Dialogue: 0,0:10:40.85,0:10:45.54,Default,,0,0,0,,Ах... мм... (Ся Хуанвэнь) Кешіріңіз.
Dialogue: 0,0:10:45.54,0:10:47.95,Default,,0,0,0,,Адамның өзінен бұдан былай айтпайды→
Dialogue: 0,0:10:47.95,0:10:51.95,Default,,0,0,0,,Қатыгез. Жалғастыруыма рұқсат етіңіз.
Dialogue: 0,0:10:53.88,0:10:57.00,Default,,0,0,0,,Адамның өзіне сәйкес:
Dialogue: 0,0:10:57.00,0:10:59.89,Default,,0,0,0,,()
Dialogue: 0,0:10:59.89,0:11:03.61,Default,,0,0,0,,Синдбад патшаның Радиан империясындағы соңғы түні→
Dialogue: 0,0:11:03.61,0:11:06.78,Default,,0,0,0,,Қоштасу тойы өтті. →
Dialogue: 0,0:11:06.78,0:11:11.28,Default,,0,0,0,,Түн атып, Когёкухиме төсегінде оянғанда...
Dialogue: 0,0:11:12.72,0:11:14.72,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:11:16.71,0:11:18.71,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:11:20.59,0:11:22.63,Default,,0,0,0,,Ах... (Ся Хуанвэнь) Енді →
Dialogue: 0,0:11:22.63,0:11:24.67,Default,,0,0,0,,Егер ештеңе болмаса...
Dialogue: 0,0:11:24.67,0:11:27.45,Default,,0,0,0,,Уф... Мен түсіндіргім келеді →
Dialogue: 0,0:11:27.45,0:11:30.05,Default,,0,0,0,,Синдбад патша! А... А? Ах...
Dialogue: 0,0:13:32.79,0:13:34.83,Default,,0,0,0,,Уф! Уф….
Dialogue: 0,0:13:34.83,0:13:38.43,Default,,0,0,0,,≪Мен Синдрия патшасы Синдбадпын. →
Dialogue: 0,0:13:38.43,0:13:41.25,Default,,0,0,0,,Талай қиындықты жеңсем де→
Dialogue: 0,0:13:41.25,0:13:43.80,Default,,0,0,0,,Біз қазір бұрын-соңды болмаған дағдарыспен бетпе-бет келіп отырмыз≫
Dialogue: 0,0:13:43.80,0:13:48.09,Default,,0,0,0,,Қарғыс атсын! Коу империясының ханшайымын арамдаған Синдбад! →
Dialogue: 0,0:13:48.09,0:13:50.13,Default,,0,0,0,,Менімен дуэль!
Dialogue: 0,0:13:50.13,0:13:52.98,Default,,0,0,0,,Бас тартсам, мен де сені өлтіріп, өлемін...
Dialogue: 0,0:13:52.98,0:13:55.65,Default,,0,0,0,,Әй... Оита Вашия ханшайымы! →
Dialogue: 0,0:13:55.65,0:14:00.15,Default,,0,0,0,,Қандай үлкен мәселе! (Қызметші) Өтінемін, қойшы!
Dialogue: 0,0:14:00.15,0:14:02.15,Default,,0,0,0,,≪Мен мұны істедім бе? ≫
Dialogue: 0,0:14:03.57,0:14:06.21,Default,,0,0,0,,≪Кешіріңіз, бірақ бұл менің есімде жоқ≫
Dialogue: 0,0:14:06.21,0:14:08.50,Default,,0,0,0,,≪Жеті теңіздің билеушісі деуге болатын адам→
Dialogue: 0,0:14:08.50,0:14:11.50,Default,,0,0,0,,Ішімдікке бату, әйелдерге дөрекілік көрсету, т.б.≫
Dialogue: 0,0:14:12.93,0:14:15.52,Default,,0,0,0,,>
Dialogue: 0,0:14:15.52,0:14:18.46,Default,,0,0,0,,Синдрия патшасының азғындығы. Ах...
Dialogue: 0,0:14:18.46,0:14:20.91,Default,,0,0,0,,Ал ханшайымның өз-өзіне қол жұмсауы. Уф!
Dialogue: 0,0:14:20.91,0:14:24.09,Default,,0,0,0,,Коу империясымен одан әрі соғыс! Ах!
Dialogue: 0,0:14:24.09,0:14:26.55,Default,,0,0,0,,≪Сонымен... халыққа осындай әділетсіздік→
Dialogue: 0,0:14:26.55,0:14:29.02,Default,,0,0,0,,Мен сөзсіз қылмыскермін! ≫
Dialogue: 0,0:14:29.02,0:14:32.62,Default,,0,0,0,,≪Тоқта, күт. Неліктен бұл бірінші кезекте болды? ≫
Dialogue: 0,0:14:32.62,0:14:35.86,Default,,0,0,0,,≪Мен онымен болған кезде ешқашан кездескен емеспін≫
Dialogue: 0,0:14:35.86,0:14:40.11,Default,,0,0,0,,Ойлап қарасам, патша бұл түнде мүлдем мас болған жоқ.
Dialogue: 0,0:14:40.11,0:14:42.58,Default,,0,0,0,,Ах. Дұрыс!?
Dialogue: 0,0:14:42.58,0:14:45.15,Default,,0,0,0,,()
Dialogue: 0,0:14:45.15,0:14:48.22,Default,,0,0,0,,Рәсім ретінде бір жұтым ғана ішіңіз. →
Dialogue: 0,0:14:48.22,0:14:51.07,Default,,0,0,0,,Осыдан кейін мен тіке төсегіме оралдым.
Dialogue: 0,0:14:51.07,0:14:53.61,Default,,0,0,0,,Оған жаңа ғана куә болдық.
Dialogue: 0,0:14:53.61,0:14:56.68,Default,,0,0,0,,Иә! Мен жай ғана ұйықтап қалдым.
Dialogue: 0,0:14:56.68,0:14:58.90,Default,,0,0,0,,Әйтеуір, ханшайымға қатысы жоқ еді.
Dialogue: 0,0:14:58.90,0:15:01.60,Default,,0,0,0,,Онда мен неге сенің бөлмеңде болдым?
Dialogue: 0,0:15:01.60,0:15:04.00,Default,,0,0,0,,Уф! Ханшайым →
Dialogue: 0,0:15:04.00,0:15:07.45,Default,,0,0,0,,Бұл есімде жоқ, бірақ...
Dialogue: 0,0:15:07.45,0:15:09.99,Default,,0,0,0,,Онда неге жалаңаш болдың!?
Dialogue: 0,0:15:09.99,0:15:12.76,Default,,0,0,0,,Сіз ұйықтап жатқанда кейде киіміңізді шешесіз бе?
Dialogue: 0,0:15:12.76,0:15:15.70,Default,,0,0,0,,Иә, бұл жиі кездеседі.
Dialogue: 0,0:15:15.70,0:15:19.07,Default,,0,0,0,,Хмф! Ақымақ болма! Ах...
Dialogue: 0,0:15:19.07,0:15:21.10,Default,,0,0,0,,Егер сіз оны соншалықты қысқартқыңыз келсе→
Dialogue: 0,0:15:21.10,0:15:24.00,Default,,0,0,0,,Бәлкім бұл жолы менің айтқанымды тыңдау керек шығар! →
Dialogue: 0,0:15:25.42,0:15:29.49,Default,,0,0,0,,Сол түні мен кештің бір бұрышында болдым. →
Dialogue: 0,0:15:29.49,0:15:32.86,Default,,0,0,0,,Бірақ ақырында мен сізге телефон соға алмадым→
Dialogue: 0,0:15:32.86,0:15:35.13,Default,,0,0,0,,Мереке аяқталды. →
Dialogue: 0,0:15:35.13,0:15:37.68,Default,,0,0,0,,Содан кейін →
Dialogue: 0,0:15:37.68,0:15:40.98,Default,,0,0,0,,Маған біреу шабуыл жасап, есінен танып қалды→
Dialogue: 0,0:15:42.34,0:15:44.98,Default,,0,0,0,,Мен мұны білмей тұрып, мен Синбад-саманың бөлмесінде болдым→
Dialogue: 0,0:15:44.98,0:15:47.03,Default,,0,0,0,,Таң болды.
Dialogue: 0,0:15:47.03,0:15:49.48,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:15:49.48,0:15:52.12,Default,,0,0,0,,Ах... (Джафар) Бұл дегені ме?
Dialogue: 0,0:15:52.12,0:15:54.52,Default,,0,0,0,,Басқаша айтқанда, осылай болсын!
Dialogue: 0,0:15:54.52,0:15:56.74,Default,,0,0,0,,Ах ха ха ха ха!
Dialogue: 0,0:15:56.74,0:15:59.04,Default,,0,0,0,,Хахаха... ха! Уф!
Dialogue: 0,0:16:01.31,0:16:03.83,Default,,0,0,0,,Өзімнің бұрмаланған қалауларымды қанағаттандыру үшін →
Dialogue: 0,0:16:03.83,0:16:05.86,Default,,0,0,0,,Ханшайымның есінен танып қалғаннан кейін→
Dialogue: 0,0:16:05.86,0:16:08.08,Default,,0,0,0,,Бұл әрекет болуы керек.
Dialogue: 0,0:16:08.08,0:16:11.39,Default,,0,0,0,,Кяа~! (Джафар) Бұл ең жаманы.
Dialogue: 0,0:16:11.39,0:16:14.20,Default,,0,0,0,,Өз патшаңызға сеніңіз! →
Dialogue: 0,0:16:14.20,0:16:18.23,Default,,0,0,0,,Таку…. Мен дипломатия кезінде мас күйде өрескел қателік жасадым, т.б. →
Dialogue: 0,0:16:18.23,0:16:20.26,Default,,0,0,0,,Балалар, бұл рас деп ойлайсыңдар ма!?
Dialogue: 0,0:16:20.26,0:16:22.61,Default,,0,0,0,,Хмм…. Ах.
Dialogue: 0,0:16:22.61,0:16:24.83,Default,,0,0,0,,Менің ойымша. Алкоголизм тұрғысынан→
Dialogue: 0,0:16:24.83,0:16:27.58,Default,,0,0,0,,Мен оған мүлде сенбеймін. (Мәсруле) Әр кезде болады.
Dialogue: 0,0:16:27.58,0:16:30.59,Default,,0,0,0,,Қол тигіздім деген әйелдерден үнемі шағымдар түсіп жатады.
Dialogue: 0,0:16:30.59,0:16:33.22,Default,,0,0,0,,Сіз өткен күні керемет әже болдыңыз.
Dialogue: 0,0:16:33.22,0:16:36.59,Default,,0,0,0,,Мен мұның алдын алдым. Негізі мен де →
Dialogue: 0,0:16:36.59,0:16:38.63,Default,,0,0,0,,Бір рет қолға…. Не...→
Dialogue: 0,0:16:38.63,0:16:42.65,Default,,0,0,0,,Не?! Балалар сендер... →
Dialogue: 0,0:16:42.65,0:16:47.09,Default,,0,0,0,,Барлығы бір-бірімен саяхатта кездесіп, шытырман оқиғаларды бірге көреді→
Dialogue: 0,0:16:47.09,0:16:50.27,Default,,0,0,0,,Қол астындағыларға сенім ұялатсам да→
Dialogue: 0,0:16:50.27,0:16:53.06,Default,,0,0,0,,Бұл туралы не деуге болады? →
Dialogue: 0,0:16:53.06,0:16:55.31,Default,,0,0,0,,Масрур қылышшы болған кезде→
Dialogue: 0,0:16:55.31,0:16:58.92,Default,,0,0,0,,Үмітсіз, бас тартқан көздерімен қарайды. →
Dialogue: 0,0:16:58.92,0:17:01.07,Default,,0,0,0,,Джафар, т.б. Біз алғаш кездескен кезде →
Dialogue: 0,0:17:01.07,0:17:03.65,Default,,0,0,0,,Маған өлтірушінің көзімен қара.
Dialogue: 0,0:17:03.65,0:17:07.56,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:07.56,0:17:09.59,Default,,0,0,0,,Бұл не...? →
Dialogue: 0,0:17:09.59,0:17:13.80,Default,,0,0,0,,Әй... Сенімді қарым-қатынасымыз өтірік пе еді?
Dialogue: 0,0:17:13.80,0:17:17.03,Default,,0,0,0,,Мас адамның барлық айтқанын тыңдай аласыз ба?
Dialogue: 0,0:17:17.03,0:17:19.85,Default,,0,0,0,,Ол әдетте жақсы патша.
Dialogue: 0,0:17:19.85,0:17:23.39,Default,,0,0,0,,Жауапкершілікті алудың жалғыз жолы - ханшайымға үйлену.
Dialogue: 0,0:17:23.39,0:17:25.43,Default,,0,0,0,,Жоқ! Үйлену?!
Dialogue: 0,0:17:25.43,0:17:28.68,Default,,0,0,0,,Уф... Солай болсын!
Dialogue: 0,0:17:28.68,0:17:32.33,Default,,0,0,0,,Ерлі-зайыптылардың арасында байланыс болса, ханшайымның абыройына нұқсан келмес еді.
Dialogue: 0,0:17:32.33,0:17:36.14,Default,,0,0,0,,Менің императорым да саған өзінің ханшайымын береді.
Dialogue: 0,0:17:36.14,0:17:38.46,Default,,0,0,0,,Эй... сәл күте тұрыңыз. →
Dialogue: 0,0:17:38.46,0:17:41.24,Default,,0,0,0,,Рұқсатсыз не істедің? (Джафар) Біздің қолымыздан ештеңе келмейді.
Dialogue: 0,0:17:41.24,0:17:43.61,Default,,0,0,0,,Коу империясы және саяси некелер, т.б.
Dialogue: 0,0:17:43.61,0:17:46.91,Default,,0,0,0,,Соғыс пен достықтың арасында таңдау болмауы мүмкін.
Dialogue: 0,0:17:46.91,0:17:49.13,Default,,0,0,0,,Менің таңдауым жоқ. (Айдаһар) Шебердің сәтсіздігі →
Dialogue: 0,0:17:49.13,0:17:53.75,Default,,0,0,0,,Тағдырдың басы бір... (Масрур) Бұл вассалдың міндеті.
Dialogue: 0,0:17:53.75,0:17:56.64,Default,,0,0,0,,Король Синбад шешіміңізді қабылдаңыз.
Dialogue: 0,0:17:56.64,0:18:04.50,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:04.50,0:18:07.82,Default,,0,0,0,,Ахх!! Мен енді шыдай алмаймын!
Dialogue: 0,0:18:07.82,0:18:11.46,Default,,0,0,0,,Ямурайха, менің кінәсіз екенімді дәлелдеу үшін күшіңді пайдалан.
Dialogue: 0,0:18:11.46,0:18:14.69,Default,,0,0,0,,Амансың ба? Мен шынымен не болғанын ғана білемін →
Dialogue: 0,0:18:14.69,0:18:18.11,Default,,0,0,0,,Мен оны саған көрсете алмаймын, солай ма? Маған бәрі бір!
Dialogue: 0,0:18:18.11,0:18:20.28,Default,,0,0,0,,Келіңіз. Хмм….
Dialogue: 0,0:18:20.28,0:18:23.82,Default,,0,0,0,,Ханшайым, сен де. (Қызыл доп) Ах.
Dialogue: 0,0:18:23.82,0:18:27.52,Default,,0,0,0,,Мен сізге шынымен не болғанын көрсетемін.
Dialogue: 0,0:18:28.92,0:18:31.56,Default,,0,0,0,,Ах! Жоқ, ханшайым!
Dialogue: 0,0:18:31.56,0:18:33.76,Default,,0,0,0,,«Шынайы су қуыршақ шоуы»!
Dialogue: 0,0:18:38.03,0:18:40.08,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:18:40.08,0:18:44.55,Default,,0,0,0,,Екі Руфтен оқиға болған түн туралы айтып беруін сұраңыз. →
Dialogue: 0,0:18:44.55,0:18:47.35,Default,,0,0,0,,Мен бұл сиқыр туралы өтірік айта алмаймын.
Dialogue: 0,0:18:48.66,0:18:50.88,Default,,0,0,0,,Ах! Ол ұйықтап жатыр. →
Dialogue: 0,0:18:50.88,0:18:53.51,Default,,0,0,0,,Ханшайым ше? (Кингёку) Хмм...
Dialogue: 0,0:18:53.51,0:18:56.51,Default,,0,0,0,,Жаяу жүру. (Барлығы) Ах!
Dialogue: 0,0:18:57.97,0:19:00.05,Default,,0,0,0,,Әй... Ол қалқып кетті.
Dialogue: 0,0:19:00.05,0:19:02.05,Default,,0,0,0,,Сізді біреу көтеріп жүр. →
Dialogue: 0,0:19:03.46,0:19:07.14,Default,,0,0,0,,Және ол Синдбад патшаның жанына қойылды...
Dialogue: 0,0:19:07.14,0:19:09.90,Default,,0,0,0,,Сонымен, ағаң ештеңе істемеді.
Dialogue: 0,0:19:09.90,0:19:12.00,Default,,0,0,0,,Хмм…. Мүмкін қазірден бастап.
Dialogue: 0,0:19:12.00,0:19:14.28,Default,,0,0,0,,Бәлкім оны біреу көтеріп алған шығар.
Dialogue: 0,0:19:14.28,0:19:16.44,Default,,0,0,0,,Балалар қарауға болмайды!
Dialogue: 0,0:19:16.44,0:19:19.39,Default,,0,0,0,,Бірақ біз оны басынан өткізуге міндеттіміз.
Dialogue: 0,0:19:19.39,0:19:21.31,Default,,0,0,0,,Иә! О, жоқ!
Dialogue: 0,0:19:21.31,0:19:25.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:25.11,0:19:27.48,Default,,0,0,0,,Мен алға қарай жылдам жүремін.
Dialogue: 0,0:19:27.48,0:19:29.53,Default,,0,0,0,,)) 【9】
Dialogue: 0,0:19:29.53,0:19:31.80,Default,,0,0,0,,Таң атты.
Dialogue: 0,0:19:31.80,0:19:33.84,Default,,0,0,0,,Сіз жай ғана ұйықтап жатырсыз ба?
Dialogue: 0,0:19:33.84,0:19:35.89,Default,,0,0,0,,О! (Барлығы) Ах.
Dialogue: 0,0:19:35.89,0:19:38.94,Default,,0,0,0,,Ақырында ештеңе... Қараңызшы! →
Dialogue: 0,0:19:38.94,0:19:41.50,Default,,0,0,0,,Мен ештеңе істеп жатқан жоқпын! (Барлығы) Ах...
Dialogue: 0,0:19:41.50,0:19:43.86,Default,,0,0,0,,Ах... Ах! Таку…→
Dialogue: 0,0:19:43.86,0:19:46.27,Default,,0,0,0,,Мен қандай қайғылы болдым.
Dialogue: 0,0:19:46.27,0:19:49.20,Default,,0,0,0,,Әй... ханшайым!
Dialogue: 0,0:19:49.20,0:19:51.76,Default,,0,0,0,,Көріп отырғаныңыздай, ештеңе болған жоқ.
Dialogue: 0,0:19:51.76,0:19:54.61,Default,,0,0,0,,Денең де, ар-намысың да нұқсан келтірмейді.
Dialogue: 0,0:19:54.61,0:19:56.89,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:19:56.89,0:19:59.16,Default,,0,0,0,,Алданбаңыз! →
Dialogue: 0,0:19:59.16,0:20:02.17,Default,,0,0,0,,Мұндай жұмбақ сиқырды дәлелдеу мүмкін емес. →
Dialogue: 0,0:20:02.17,0:20:05.10,Default,,0,0,0,,Кінәңізді мойындаңыз, Синдбад патша!
Dialogue: 0,0:20:05.10,0:20:07.75,Default,,0,0,0,,Тоқта, Ся Хуанвэнь! (Ся Хуанвэн) Ха! →
Dialogue: 0,0:20:07.75,0:20:10.46,Default,,0,0,0,,Ханшайым…. Шындығында, тіпті өзім →
Dialogue: 0,0:20:10.46,0:20:12.49,Default,,0,0,0,,Мен бұл біртүрлі болды деп ойладым.
Dialogue: 0,0:20:12.49,0:20:16.81,Default,,0,0,0,,Киімі де, шашы да таралмаған... Бірақ неге екенін түсінбеймін →
Dialogue: 0,0:20:16.81,0:20:21.79,Default,,0,0,0,,Мен қорқып, шу шығардым... (Ся Хуанвэнь) Ах.
Dialogue: 0,0:20:21.79,0:20:23.95,Default,,0,0,0,,Кешіріңіз. (Барлығы) Ах.
Dialogue: 0,0:20:23.95,0:20:26.11,Default,,0,0,0,,Ах…. Ханшайым!
Dialogue: 0,0:20:26.11,0:20:28.91,Default,,0,0,0,,Ханшайым қалай... Не... бірдеңе →
Dialogue: 0,0:20:28.91,0:20:32.00,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:20:32.00,0:20:35.83,Default,,0,0,0,,Бірақ... бұл кінәлінің басқа екенін білдіреді.
Dialogue: 0,0:20:35.83,0:20:37.98,Default,,0,0,0,,Мұндай зиянды нәрсе...
Dialogue: 0,0:20:37.98,0:20:40.04,Default,,0,0,0,,Нақты кім?
Dialogue: 0,0:20:40.04,0:20:42.24,Default,,0,0,0,,Ханшайым…. Ханшайым.
Dialogue: 0,0:20:43.84,0:20:45.88,Default,,0,0,0,,≪Менің атым Ся Хуанвэн≫
Dialogue: 0,0:20:45.88,0:20:48.50,Default,,0,0,0,,≪Ол Когёкухименің қызметшісі. →
Dialogue: 0,0:20:48.50,0:20:52.22,Default,,0,0,0,,Көп жылдар қызмет еткен асыл ханшайым кімге байланысты →
Dialogue: 0,0:20:52.22,0:20:55.57,Default,,0,0,0,,Мен осымен бетпе-бет келіп отырмын...≫
Dialogue: 0,0:20:55.57,0:20:59.17,Default,,0,0,0,,≪Айтпақшы, кінәлі менмін. →
Dialogue: 0,0:20:59.17,0:21:03.73,Default,,0,0,0,,Сол түні мен ханшайымды есінен танып қалдым →
Dialogue: 0,0:21:03.73,0:21:05.78,Default,,0,0,0,,Екі қызметші және патша Синдбад →
Dialogue: 0,0:21:05.78,0:21:08.08,Default,,0,0,0,,Жатқан жеріне жеткізді. →
Dialogue: 0,0:21:09.38,0:21:13.42,Default,,0,0,0,,Неліктен мен бұлай әрекет еттім? →
Dialogue: 0,0:21:13.42,0:21:15.82,Default,,0,0,0,,Менің жоспарым бар еді. →
Dialogue: 0,0:21:17.17,0:21:20.36,Default,,0,0,0,,Барбадқа үйленетін ханшайымның соңынан еріңіз→
Dialogue: 0,0:21:20.36,0:21:23.48,Default,,0,0,0,,Жақында туатын мұрагердің қамқоршысы ретінде→
Dialogue: 0,0:21:23.48,0:21:26.60,Default,,0,0,0,,Бұл елді манипуляциялау жоспары. →
Dialogue: 0,0:21:26.60,0:21:29.20,Default,,0,0,0,,Бірақ ол сәтсіз аяқталды≫
Dialogue: 0,0:21:30.80,0:21:35.43,Default,,0,0,0,,≪Бірақ содан кейін Синдбад патша пайда болды. →
Dialogue: 0,0:21:35.43,0:21:38.71,Default,,0,0,0,,Барбадтың орнына Синдриямен орындаңыз. →
Dialogue: 0,0:21:38.71,0:21:41.97,Default,,0,0,0,,Ханшайым ретінде сіз сүйген адамыңызбен жұбайлық және әйелдік бола аласыз. →
Dialogue: 0,0:21:41.97,0:21:45.35,Default,,0,0,0,,Бір оқпен екі құсты өлтіру! →
Dialogue: 0,0:21:45.35,0:21:47.72,Default,,0,0,0,,Сиқырдың арқасында шындық ашыла жаздады.→
Dialogue: 0,0:21:47.72,0:21:50.77,Default,,0,0,0,,Мықты болсақ, итермелейтін сияқтымыз.≫
Dialogue: 0,0:21:50.77,0:21:53.58,Default,,0,0,0,,Өзіңізді төбелеске түсірмеңіз, ханшайым!
Dialogue: 0,0:21:53.58,0:21:58.16,Default,,0,0,0,,Мен Король Синдбадтан жауапкершілікті өз мойнына алып, маған үйленуді сұраймын!
Dialogue: 0,0:21:58.16,0:22:00.73,Default,,0,0,0,,≪Бұл жолы ол қатты итереді! ≫
Dialogue: 0,0:22:00.73,0:22:03.44,Default,,0,0,0,,Кешіріңіз! иә?
Dialogue: 0,0:22:03.44,0:22:05.61,Default,,0,0,0,,Барлығын Ся Хуанвэнь жасады.
Dialogue: 0,0:22:05.61,0:22:07.64,Default,,0,0,0,,Біз көмектестік.
Dialogue: 0,0:22:07.64,0:22:10.16,Default,,0,0,0,,Не? (Ся Хуанвэн) Не!?→
Dialogue: 0,0:22:10.16,0:22:13.50,Default,,0,0,0,,Ба Ба... Сен ақымақсың ба! (Қызметші) Өйткені →
Dialogue: 0,0:22:13.50,0:22:16.05,Default,,0,0,0,,Мен ханшайымды аяймын. (Джафар) Синдбад патшаны басып алды →
Dialogue: 0,0:22:16.05,0:22:18.89,Default,,0,0,0,,Көтерілісшіні қолға түсіріңіз! (Ся Хуанвэн) Куу~!
Dialogue: 0,0:22:18.89,0:22:22.44,Default,,0,0,0,,Мен мұнда ұстай алмаймын! (Барлығы) Ах!
Dialogue: 0,0:22:22.44,0:22:24.59,Default,,0,0,0,,Баши! (Ся Хуанвэн) Уф!
Dialogue: 0,0:22:24.59,0:22:28.50,Default,,0,0,0,,Ханзада Хакурюу. (Хакурю) Фарс жеткілікті.
Dialogue: 0,0:22:28.50,0:22:31.55,Default,,0,0,0,,Ах... (Ақ айдаһар) Синдбад патша →
Dialogue: 0,0:22:31.55,0:22:34.55,Default,,0,0,0,,Алдағы аласапыран – өз халқымыздың әділетсіздігі.
Dialogue: 0,0:22:34.55,0:22:37.07,Default,,0,0,0,,Ах! (Ся Хуанвэнь) Ах...
Dialogue: 0,0:22:37.07,0:22:39.42,Default,,0,0,0,,Біздің елде көріпкелдік сиқыры да бар. →
Dialogue: 0,0:22:39.42,0:22:41.88,Default,,0,0,0,,Сол су сиқырының да дұрыс екенін көрдім. →
Dialogue: 0,0:22:41.88,0:22:46.38,Default,,0,0,0,,Жоқ? Ся Хуанвэн. (Ся Хуанвэнь) Ах! иә….
Dialogue: 0,0:22:46.38,0:22:49.50,Default,,0,0,0,,Серіктердің дөрекілігі Коу империясы атынан→
Dialogue: 0,0:22:49.50,0:22:51.72,Default,,0,0,0,,Кешірім сұраймыз. Ах...
Dialogue: 0,0:22:51.72,0:22:55.56,Default,,0,0,0,,Алайда бұл жолы шетелде оқудың мақсаты басқа →
Dialogue: 0,0:22:55.56,0:22:58.38,Default,,0,0,0,,Маған қалуға рұқсат етіңіз.
Dialogue: 0,0:22:58.38,0:23:02.20,Default,,0,0,0,,Ах. Рұқсат етейік. (Хакурю) Рахмет.
Dialogue: 0,0:23:02.20,0:23:04.61,Default,,0,0,0,,Осындай ақымақтықпен... (Ся Хуанвэнь) Иә!
Dialogue: 0,0:23:04.61,0:23:09.19,Default,,0,0,0,,Князьді тізесін бүгуге қалай дәтің бар? (Ся Хуанвэн) Бұл бос сөз! →
Dialogue: 0,0:23:09.19,0:23:11.22,Default,,0,0,0,,Менің таңдауым болмады... →
Dialogue: 0,0:23:11.22,0:23:13.81,Default,,0,0,0,,Мен сияқты лас көгілдір армандау үшін →
Dialogue: 0,0:23:13.81,0:23:16.59,Default,,0,0,0,,Мен мұны істеуім керек еді!
Dialogue: 0,0:23:16.59,0:23:19.01,Default,,0,0,0,,Олай айтпа! (Ся Хуанвэнь) Ах!
Dialogue: 0,0:23:19.01,0:23:22.50,Default,,0,0,0,,Ся Хуанвэн жақсы және жақсы қыз. Ха!
Dialogue: 0,0:23:22.50,0:23:25.39,Default,,0,0,0,,Ханшайым... Уау! Уф...
Dialogue: 0,0:23:25.39,0:23:27.42,Default,,0,0,0,,Ах! Уф….
Dialogue: 0,0:23:27.42,0:23:30.54,Default,,0,0,0,,≪Кешірім сұрасам, кешіретін сияқтымын≫
Dialogue: 0,0:23:30.54,0:23:33.89,Default,,0,0,0,,≪қолымнан келгенше кешірім сұраймын≫
Dialogue: 0,0:23:33.89,0:23:36.30,Default,,0,0,0,,Ах.
Dialogue: 0,0:23:36.30,0:23:39.00,Default,,0,0,0,,Пех! (Ся Хуанвэн) Ух... уау!
Dialogue: 0,0:23:39.00,0:23:42.12,Default,,0,0,0,,Сіз сенімдісіз бе? оларды кешір.
Dialogue: 0,0:23:42.12,0:23:45.49,Default,,0,0,0,,Жақсы. Кем дегенде Мәртебелі Ханзада →
Dialogue: 0,0:23:45.49,0:23:49.29,Default,,0,0,0,,Мақсатын орындамайынша оның қайтып келуі екіталай.
Dialogue: 0,0:23:55.27,0:23:57.42,Default,,0,0,0,,Өте жақсы. →
Dialogue: 0,0:23:57.42,0:24:00.24,Default,,0,0,0,,Осындай патшалықты бір ұрпаққа салды→
Dialogue: 0,0:24:00.24,0:24:03.54,Default,,0,0,0,,Ол сондай-ақ қуатты Жеті теңіз альянсын біріктіреді. →
Dialogue: 0,0:24:03.54,0:24:07.93,Default,,0,0,0,,Бұл ерекше талант пен қайырымдылықтың туындысы болуы керек.
Dialogue: 0,0:24:07.93,0:24:11.43,Default,,0,0,0,,Сіз асыра айтып отырсыз. үй.
Dialogue: 0,0:24:11.43,0:24:15.00,Default,,0,0,0,,Жарқыраған императорға кім қатты сөйледі→
Dialogue: 0,0:24:15.00,0:24:17.05,Default,,0,0,0,,Сіз біріншісіз.
Dialogue: 0,0:24:17.05,0:24:19.87,Default,,0,0,0,,Барбадқа қарсы найза ұстағаныңды қалаймын→
Dialogue: 0,0:24:19.87,0:24:21.91,Default,,0,0,0,,Өйткені ол бірбеткей болды.
Dialogue: 0,0:24:21.91,0:24:26.23,Default,,0,0,0,,Біз Коу империясымен достық қарым-қатынаста болғымыз келеді.
Dialogue: 0,0:24:26.23,0:24:28.23,Default,,0,0,0,,Король Синдбад. иә?
Dialogue: 0,0:24:29.58,0:24:31.63,Default,,0,0,0,,Сіз өтірік айтасыз.
Dialogue: 0,0:24:31.63,0:24:34.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:34.99,0:24:39.13,Default,,0,0,0,,Бұл жай ғана үстірт достық па?
Dialogue: 0,0:24:39.13,0:24:41.59,Default,,0,0,0,,Сіз не айтқыңыз келеді?
Dialogue: 0,0:24:41.59,0:24:44.65,Default,,0,0,0,,Мені қате түсінбеңіз. Мен ерекше емеспін →
Dialogue: 0,0:24:44.65,0:24:47.40,Default,,0,0,0,,Мен саған қарсы болғым келмейді.
Dialogue: 0,0:24:47.40,0:24:51.49,Default,,0,0,0,,Менің маңызды жаңалығым бар. иә?
Dialogue: 0,0:24:51.49,0:24:55.99,Default,,0,0,0,,Коу империясында орналасқан ұйым Синдрияны нысанаға алады.
Dialogue: 0,0:24:55.99,0:24:58.09,Default,,0,0,0,,Ол қазірдің өзінде қозғалыста.
Dialogue: 0,0:25:00.01,0:25:02.05,Default,,0,0,0,,Оны дұрыс деп есептей отырып →
Dialogue: 0,0:25:02.05,0:25:04.95,Default,,0,0,0,,Неліктен сен, Коу империясының ханзадасы, мені таңдадың?
Dialogue: 0,0:25:06.37,0:25:08.47,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:25:10.17,0:25:13.63,Default,,0,0,0,,Коу империясын жою.
Dialogue: 0,0:25:13.63,0:25:58.50,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:02.66,0:26:13.26,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:17.54,0:26:42.98,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:44.09,0:30:46.44,Default,,0,0,0,,Шизуока префектурасының Хамамацу қаласындағы JR зауытында
Dialogue: 0,0:30:47.46,0:30:49.65,Default,,0,0,0,,Өткен жылы жарылмаған снарядтар табылды
Dialogue: 0,0:30:49.65,0:30:51.81,Default,,0,0,0,,Бүгін жарылды.
Dialogue: 0,0:30:52.88,0:30:55.33,Default,,0,0,0,,Қаладан жағалауға дейін жүргізілген жұмыстар
Dialogue: 0,0:30:55.33,0:30:58.00,Default,,0,0,0,,Шамамен 10 000 тұрғынға эвакуациялау туралы бұйрық берілді және
Dialogue: 0,0:30:59.50,0:31:04.50,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
