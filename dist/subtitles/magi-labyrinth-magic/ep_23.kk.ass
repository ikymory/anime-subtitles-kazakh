Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.99,0:00:35.03,Default,,0,0,0,,Менің қалағаным сендерсіңдер.
Dialogue: 0,0:00:35.03,0:00:37.06,Default,,0,0,0,,Не?
Dialogue: 0,0:00:37.06,0:00:39.72,Default,,0,0,0,,Әкемізге→
Dialogue: 0,0:00:39.72,0:00:43.60,Default,,0,0,0,,Сүлейменнің даналығын және патша Әли Бабаның өмірін қабыл алыңыз. →
Dialogue: 0,0:00:43.60,0:00:47.61,Default,,0,0,0,,Барлығы Гаппосей жоспары бойынша қалады.
Dialogue: 0,0:00:47.61,0:00:50.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:50.81,0:00:55.55,Default,,0,0,0,,Қарғыс атсын! Кім сенің қалағаныңды істемек?
Dialogue: 0,0:00:55.55,0:00:57.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:59.87,0:01:02.09,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:01:02.09,0:01:06.06,Default,,0,0,0,,Хакурю Онии-сан! Моль мен оның баласын қауіпсіз жерге апарыңыз.
Dialogue: 0,0:01:06.06,0:01:08.06,Default,,0,0,0,,Иә! сұраңыз.
Dialogue: 0,0:01:10.68,0:01:12.72,Default,,0,0,0,,≪Көгеру ауырады≫
Dialogue: 0,0:01:12.72,0:01:15.24,Default,,0,0,0,,≪Сіз сиқырды көп қолдандыңыз ба?≫
Dialogue: 0,0:01:15.24,0:01:17.24,Default,,0,0,0,,Аһ!
Dialogue: 0,0:01:25.08,0:01:58.46,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:02.40,0:02:54.60,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:56.07,0:02:58.97,Default,,0,0,0,,Хахаха…. ≪Додон! Таң!
Dialogue: 0,0:03:00.31,0:03:02.46,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:03:02.46,0:03:05.53,Default,,0,0,0,,Уф…. (Хакурю) Жарайды. →
Dialogue: 0,0:03:05.53,0:03:08.73,Default,,0,0,0,,Бұл екеуі жеңілмейді. барайық!
Dialogue: 0,0:03:11.47,0:03:13.50,Default,,0,0,0,,♬~
Dialogue: 0,0:03:13.50,0:03:15.50,Default,,0,0,0,,Аладдин!
Dialogue: 0,0:03:18.73,0:03:22.68,Default,,0,0,0,,О, ау. Ол құлап, жоғалып кетті ме?
Dialogue: 0,0:03:22.68,0:03:25.27,Default,,0,0,0,,Бұл ақымақтық. Ах.
Dialogue: 0,0:03:25.27,0:03:28.27,Default,,0,0,0,,Қалай ойлайсың, осындай адамды тоқтата аласың ба?
Dialogue: 0,0:03:31.77,0:03:33.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:37.76,0:03:39.96,Default,,0,0,0,,Сиқыршы күткендей.
Dialogue: 0,0:03:45.25,0:03:49.52,Default,,0,0,0,,Танысқаныма қуаныштымын. Мен Мұстасим ханшайымымын →
Dialogue: 0,0:03:49.52,0:03:52.64,Default,,0,0,0,,Дүние Мұстасим. Бұл адам →
Dialogue: 0,0:03:52.64,0:03:55.43,Default,,0,0,0,,Бұл менің рыцарь Исаак. →
Dialogue: 0,0:03:55.43,0:03:59.03,Default,,0,0,0,,Өзіңізге мұқият болыңыз. Мұстасим?
Dialogue: 0,0:03:59.03,0:04:01.32,Default,,0,0,0,,О, сен білесің бе?
Dialogue: 0,0:04:01.32,0:04:05.12,Default,,0,0,0,,Батыстағы салыстырмалы түрде үлкен мемлекет болды.
Dialogue: 0,0:04:05.12,0:04:08.39,Default,,0,0,0,,Бірақ шамамен 10 жыл бұрын мен Магностадтқа бардым→
Dialogue: 0,0:04:08.39,0:04:11.51,Default,,0,0,0,,Бұзылғанын естідім.
Dialogue: 0,0:04:11.51,0:04:14.33,Default,,0,0,0,,Мен де бір нәрсе сұрасам болады ма?
Dialogue: 0,0:04:14.33,0:04:16.35,Default,,0,0,0,,Алибаба мырза.
Dialogue: 0,0:04:16.35,0:04:18.90,Default,,0,0,0,,Неге тірісің?
Dialogue: 0,0:04:18.90,0:04:21.59,Default,,0,0,0,,А... Ел басып қалды →
Dialogue: 0,0:04:21.59,0:04:24.59,Default,,0,0,0,,Сіз елі жойылған ханзадасыз →
Dialogue: 0,0:04:24.59,0:04:27.56,Default,,0,0,0,,Сіз қалай аман қалдыңыз?
Dialogue: 0,0:04:27.56,0:04:29.61,Default,,0,0,0,,Барбад жойылмайды!
Dialogue: 0,0:04:29.61,0:04:32.15,Default,,0,0,0,,Тиісті республика болды, әлі де бар!
Dialogue: 0,0:04:32.15,0:04:34.70,Default,,0,0,0,,Іс жүзінде Коу басқарады →
Dialogue: 0,0:04:34.70,0:04:38.16,Default,,0,0,0,,Тек атымен ғана ел ретінде... солай ма?
Dialogue: 0,0:04:38.16,0:04:41.64,Default,,0,0,0,,Қарғыс атсын! бұл….
Dialogue: 0,0:04:41.64,0:04:43.68,Default,,0,0,0,,Сіз әлі тірісіз →
Dialogue: 0,0:04:43.68,0:04:46.56,Default,,0,0,0,,Қандай да бір қателік болуы керек.
Dialogue: 0,0:04:46.56,0:04:50.82,Default,,0,0,0,,Сондықтан мен сені өлтіремін →
Dialogue: 0,0:04:50.82,0:04:53.04,Default,,0,0,0,,Осы қара металл ыдыспен.
Dialogue: 0,0:04:53.04,0:04:56.04,Default,,0,0,0,,А... қара металл ыдыс?
Dialogue: 0,0:04:56.04,0:05:00.93,Default,,0,0,0,,Иә. Қара руфпен қоректенетін ұйым жасаған →
Dialogue: 0,0:05:00.93,0:05:03.98,Default,,0,0,0,,Бұл тек бізге арналған металл құрал. →
Dialogue: 0,0:05:03.98,0:05:08.64,Default,,0,0,0,,Дегенмен, менің ойымша, балалар, сендер үшін тым кеш.
Dialogue: 0,0:05:08.64,0:05:10.80,Default,,0,0,0,,тым кеш пе? Ах...
Dialogue: 0,0:05:10.80,0:05:15.36,Default,,0,0,0,,Иснаан мырза, Ысқақ, менімен араласпа.
Dialogue: 0,0:05:15.36,0:05:18.55,Default,,0,0,0,,Мен ұйымға өз күшімді көрсеткім келеді.
Dialogue: 0,0:05:18.55,0:05:21.33,Default,,0,0,0,,Ол құдірет менде де бар→
Dialogue: 0,0:05:21.33,0:05:23.33,Default,,0,0,0,,Мен саған дәлелдеймін.
Dialogue: 0,0:05:24.72,0:05:26.92,Default,,0,0,0,,Ха! Дәмі керемет! Шынында да, тамаша!
Dialogue: 0,0:05:28.26,0:05:30.77,Default,,0,0,0,,Докун (жүрек соғысы)
Dialogue: 0,0:05:30.77,0:05:35.46,Default,,0,0,0,,Докун Докун Докун Докун
Dialogue: 0,0:05:35.46,0:05:38.40,Default,,0,0,0,,Тоқта... Тоқта, Қасым!
Dialogue: 0,0:05:38.40,0:05:41.10,Default,,0,0,0,,Алибаба-кун! Уф….
Dialogue: 0,0:05:41.10,0:05:43.14,Default,,0,0,0,,Хехе.
Dialogue: 0,0:05:43.14,0:05:52.45,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:52.45,0:05:54.85,Default,,0,0,0,,Керемет!
Dialogue: 0,0:05:56.35,0:05:59.82,Default,,0,0,0,,Қара… джин….
Dialogue: 0,0:05:59.82,0:06:02.37,Default,,0,0,0,,Докун Докун Докун
Dialogue: 0,0:06:02.37,0:06:05.59,Default,,0,0,0,,Ух... уау!!
Dialogue: 0,0:06:05.59,0:06:13.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:13.80,0:06:16.75,Default,,0,0,0,,Құм! (Иснан) Қараңғылықтың металл ыдысы →
Dialogue: 0,0:06:16.75,0:06:19.57,Default,,0,0,0,,Бұл қара фарфор найзаның күші. →
Dialogue: 0,0:06:19.57,0:06:22.86,Default,,0,0,0,,Дуниа магнетизмді басқарады және темір құмы мен минералдарды бақылайды →
Dialogue: 0,0:06:22.86,0:06:25.45,Default,,0,0,0,,Сіз оны еркін басқара аласыз.
Dialogue: 0,0:06:25.45,0:06:30.13,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:30.13,0:06:32.23,Default,,0,0,0,,Қауіпті! Ах!
Dialogue: 0,0:06:33.57,0:06:36.42,Default,,0,0,0,,Алибаба-кун, бұл сенің досың емес!
Dialogue: 0,0:06:36.42,0:06:39.43,Default,,0,0,0,,Сабыр ет, Алибаба-кун! аа.
Dialogue: 0,0:06:39.43,0:06:41.53,Default,,0,0,0,,Кешіріңіз, Аладдин.
Dialogue: 0,0:06:41.53,0:06:45.48,Default,,0,0,0,,Жүр, Әлібаба-күн. «Қатты дуэт»!
Dialogue: 0,0:06:45.48,0:06:48.97,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:48.97,0:06:53.07,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:55.03,0:06:57.08,Default,,0,0,0,,Кин Кин Кин! Хмм! Ах... Қарғыс атсын!
Dialogue: 0,0:06:57.08,0:06:59.18,Default,,0,0,0,,Арх! Хмм!
Dialogue: 0,0:06:59.18,0:07:02.68,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:02.68,0:07:04.75,Default,,0,0,0,,Хехе.
Dialogue: 0,0:07:04.75,0:07:07.27,Default,,0,0,0,,≪Таң атқан таң...
Dialogue: 0,0:07:07.27,0:07:10.97,Default,,0,0,0,,Ха ха ха.
Dialogue: 0,0:07:16.45,0:07:19.03,Default,,0,0,0,,Эй Синдбад→
Dialogue: 0,0:07:19.03,0:07:21.83,Default,,0,0,0,,Мен сенімен бірге болғым келді. →
Dialogue: 0,0:07:23.35,0:07:26.54,Default,,0,0,0,,Сенімен әлемді жаулап алсам →
Dialogue: 0,0:07:26.54,0:07:30.38,Default,,0,0,0,,Қаншалықты қызық болар деп ойладым. →
Dialogue: 0,0:07:30.38,0:07:33.55,Default,,0,0,0,,Бірақ мен мұны жақында түсіндім. →
Dialogue: 0,0:07:33.55,0:07:36.55,Default,,0,0,0,,Сен кімсің, соншалықты күшті кімсің?→
Dialogue: 0,0:07:36.55,0:07:40.54,Default,,0,0,0,,Бірін-бірі өлтіру қызық болар деп ойладым.
Dialogue: 0,0:07:40.54,0:07:45.14,Default,,0,0,0,,Ал, енді бірден бастайық.
Dialogue: 0,0:07:45.14,0:07:47.36,Default,,0,0,0,,Хахахаха! →
Dialogue: 0,0:07:47.36,0:07:51.92,Default,,0,0,0,,Дүрбелеңге салынбаңыз. Мұнда да көп нәрсе бар. →
Dialogue: 0,0:07:51.92,0:07:55.15,Default,,0,0,0,,Менің бұл жолғы жұмысым – осы елде тосқауыл қою→
Dialogue: 0,0:07:55.15,0:07:58.57,Default,,0,0,0,,Тек оны жою керек. не?
Dialogue: 0,0:07:58.57,0:08:00.74,Default,,0,0,0,,Сондықтан Синбад→
Dialogue: 0,0:08:00.74,0:08:04.58,Default,,0,0,0,,Қателік жасасаң қариялар ұрмасын.
Dialogue: 0,0:08:04.58,0:08:08.48,Default,,0,0,0,,Мен өзімнің Жарқыраған империяммен бір-бірімізді қатты өлтіргенше.
Dialogue: 0,0:08:10.03,0:08:12.92,Default,,0,0,0,,Қазіргі Коу империясы керемет!
Dialogue: 0,0:08:12.92,0:08:16.76,Default,,0,0,0,,Өйткені лабиринтті бағындырушы бес адам бар. →
Dialogue: 0,0:08:16.76,0:08:19.54,Default,,0,0,0,,Бірінші ханшайым Рен Хакуэй. →
Dialogue: 0,0:08:19.54,0:08:22.61,Default,,0,0,0,,Сегізінші ханшайым Ренкогёку. →
Dialogue: 0,0:08:22.61,0:08:25.93,Default,,0,0,0,,Императордың ұлы Ренкоха. →
Dialogue: 0,0:08:25.93,0:08:28.03,Default,,0,0,0,,Рен Комей. →
Dialogue: 0,0:08:28.03,0:08:30.50,Default,,0,0,0,,Қызыл жалын. →
Dialogue: 0,0:08:30.50,0:08:33.21,Default,,0,0,0,,Олардың ішінде Қырмызы жалын жақсы. →
Dialogue: 0,0:08:33.21,0:08:36.56,Default,,0,0,0,,Ол екеуміз қосылсақ, шығыс құрлықты басқара аламыз→
Dialogue: 0,0:08:36.56,0:08:38.73,Default,,0,0,0,,Уақыт зымырап өтеді. →
Dialogue: 0,0:08:38.73,0:08:42.62,Default,,0,0,0,,Олай болса менің кезегім. →
Dialogue: 0,0:08:42.62,0:08:46.59,Default,,0,0,0,,Менің сәулелі империям Синдрияны жояды!
Dialogue: 0,0:08:46.59,0:08:50.19,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:51.63,0:08:53.78,Default,,0,0,0,,≫ (Кугиоку) Жою деген нені білдіреді? →
Dialogue: 0,0:08:53.78,0:08:55.78,Default,,0,0,0,,≫Жудар-чан. иә? →
Dialogue: 0,0:08:57.20,0:09:00.45,Default,,0,0,0,,Біз соғысқа барамыз. Ал, әзірше →
Dialogue: 0,0:09:00.45,0:09:03.02,Default,,0,0,0,,Бұл жарқырау емес, бұл ұйымдастыру.
Dialogue: 0,0:09:03.02,0:09:05.82,Default,,0,0,0,,Ах... Сол себепті Когёку →
Dialogue: 0,0:09:05.82,0:09:08.24,Default,,0,0,0,,Қазір оралыңыз.
Dialogue: 0,0:09:08.24,0:09:10.64,Default,,0,0,0,,Мен Балбадтағы қателігімнен позициямды жоғалттым→
Dialogue: 0,0:09:10.64,0:09:12.75,Default,,0,0,0,,Ол қашып кеткен шығар...
Dialogue: 0,0:09:12.75,0:09:16.40,Default,,0,0,0,,А... Мен сені генерал етемін.
Dialogue: 0,0:09:16.40,0:09:18.75,Default,,0,0,0,,Жауынгер сен де елге қызмет етесің→
Dialogue: 0,0:09:18.75,0:09:21.55,Default,,0,0,0,,Қатты төбелескіңіз келді, солай емес пе?
Dialogue: 0,0:09:29.91,0:09:32.41,Default,,0,0,0,,Не болды? Қызыл доп. Ах...
Dialogue: 0,0:09:33.75,0:09:38.42,Default,,0,0,0,,Майка. Әйтеуір, менің айтқым келгені...→
Dialogue: 0,0:09:38.42,0:09:40.71,Default,,0,0,0,,Жарайсың ба? Синбад.
Dialogue: 0,0:09:40.71,0:09:43.21,Default,,0,0,0,,Мен сені өлтіргенше өлме.
Dialogue: 0,0:09:45.81,0:09:48.11,Default,,0,0,0,,Ха! Сонда кездескенше!
Dialogue: 0,0:09:49.47,0:09:51.99,Default,,0,0,0,,Шин: Мені осылай жібересің бе?
Dialogue: 0,0:09:51.99,0:09:56.07,Default,,0,0,0,,Уайымдамаңыз. Қазір онымен күресетін уақыт емес.
Dialogue: 0,0:09:56.07,0:09:58.56,Default,,0,0,0,,Сегіз генерал Ақ Қошқар мұнарасына жиналады.
Dialogue: 0,0:09:58.56,0:10:01.38,Default,,0,0,0,,Төтенше әскери кеңес өткізу.
Dialogue: 0,0:10:01.38,0:10:06.25,Default,,0,0,0,,Аа... Бүкіл аралға екінші дәрежелі дабыл күйі жарияланды. →
Dialogue: 0,0:10:06.25,0:10:09.42,Default,,0,0,0,,Сегіз генералдың тікелей жауынгерлік әскерін шақырыңыз.
Dialogue: 0,0:10:09.42,0:10:11.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:19.03,0:10:23.22,Default,,0,0,0,,Сонымен шлагбаумдағы тесікті бірден жабу мүмкін емес, солай ма?
Dialogue: 0,0:10:23.22,0:10:26.47,Default,,0,0,0,,Иә. Оны бұрынғыдай берік ету үшін →
Dialogue: 0,0:10:26.47,0:10:29.26,Default,,0,0,0,,Қара таразы мұнарасының барлық сиқыршыларын жұмылдырсақ та→
Dialogue: 0,0:10:29.26,0:10:31.44,Default,,0,0,0,,Менің ойымша, 10 күн қажет.
Dialogue: 0,0:10:31.44,0:10:33.54,Default,,0,0,0,,Мен көремін... →
Dialogue: 0,0:10:33.54,0:10:36.90,Default,,0,0,0,,Жарайды, кедергіден бас тартайық. (Барлығы) иә?
Dialogue: 0,0:10:36.90,0:10:38.95,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,0:10:38.95,0:10:41.05,Default,,0,0,0,,Оның орнына Ямрайха мен сиқыршылар→
Dialogue: 0,0:10:41.05,0:10:43.57,Default,,0,0,0,,Жауынгерлік күш ретінде қосыңыз.
Dialogue: 0,0:10:43.57,0:10:45.97,Default,,0,0,0,,Бұл тікелей жарыс. (Барлығы) Ах.
Dialogue: 0,0:10:47.62,0:10:52.86,Default,,0,0,0,,Патша болсам да, лабиринтті жаулап алушымын.
Dialogue: 0,0:10:52.86,0:10:57.82,Default,,0,0,0,,Қорғаудан гөрі, мен жолды ашып, алға жылжу үшін қолымды пайдаланғым келеді.
Dialogue: 0,0:10:57.82,0:10:59.82,Default,,0,0,0,,Менімен келесің бе?
Dialogue: 0,0:11:01.62,0:11:06.54,Default,,0,0,0,,Енді сегіз генералымыздан не сұрамақсыз, патша?
Dialogue: 0,0:11:06.54,0:11:11.16,Default,,0,0,0,,Иә. Кешіріңіз, бірақ мен осындаймын. →
Dialogue: 0,0:11:11.16,0:11:15.30,Default,,0,0,0,,Сізге әдеттегіден көп жұмыс істеуге тура келеді.
Dialogue: 0,0:11:15.30,0:11:18.61,Default,,0,0,0,,Барлығыңыз, өтінемін. (Барлығы) Ха!
Dialogue: 0,0:11:18.61,0:11:20.89,Default,,0,0,0,,Can Can Can! (қоңырау дыбысы)
Dialogue: 0,0:11:20.89,0:11:24.08,Default,,0,0,0,,Соғыс! Соғыс басталғалы тұр!
Dialogue: 0,0:11:24.08,0:11:27.98,Default,,0,0,0,,Мен оны толығымен қорғаймын. аа. Бұл біздің ел.
Dialogue: 0,0:11:30.07,0:11:32.62,Default,,0,0,0,,Ол маған да қоршауға дайындалу керектігін айтты.
Dialogue: 0,0:11:32.62,0:11:34.65,Default,,0,0,0,,Қолымыздан келгеннің бәрін жасайық, бәріміз.
Dialogue: 0,0:11:34.65,0:11:39.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:41.53,0:11:45.53,Default,,0,0,0,,Хмм…. ≪(Қызыл доп) Синдбад патшамен танысыңыз.
Dialogue: 0,0:11:54.56,0:11:57.13,Default,,0,0,0,,Ах... бұл...→
Dialogue: 0,0:11:57.13,0:12:01.21,Default,,0,0,0,,Біздің елдегі діни қызметкер үлкен құрметсіздік көрсетті. →
Dialogue: 0,0:12:01.21,0:12:04.63,Default,,0,0,0,,Өз еліңмен соғысу шектен шығады.
Dialogue: 0,0:12:04.63,0:12:08.77,Default,,0,0,0,,Сіздің еліңіз бен Кира арасында достық келісім шарты бар.
Dialogue: 0,0:12:08.77,0:12:11.96,Default,,0,0,0,,Ешқашан… ешқашан…. Ханшайым.
Dialogue: 0,0:12:11.96,0:12:15.61,Default,,0,0,0,,Иә….
Dialogue: 0,0:12:15.61,0:12:18.40,Default,,0,0,0,,Ах. Жарайды.
Dialogue: 0,0:12:18.40,0:12:20.95,Default,,0,0,0,,Ха! Аа….
Dialogue: 0,0:12:20.95,0:12:24.25,Default,,0,0,0,,Шынында да, болашақта Синдрия мен Кира → болады
Dialogue: 0,0:12:24.25,0:12:27.32,Default,,0,0,0,,Бізге үстемдік үшін бәсекелесуге тура келуі мүмкін.
Dialogue: 0,0:12:27.32,0:12:30.19,Default,,0,0,0,,Бірақ бұл тек болашақтағы әңгіме.
Dialogue: 0,0:12:30.19,0:12:32.23,Default,,0,0,0,,Енді сұрақ...
Dialogue: 0,0:12:32.23,0:12:35.42,Default,,0,0,0,,Бұл ұйым. Ақыр соңында, сіз білесіз бе?
Dialogue: 0,0:12:35.42,0:12:37.52,Default,,0,0,0,,Бірақ мен олай емеспін.
Dialogue: 0,0:12:37.52,0:12:40.64,Default,,0,0,0,,Расында да, Нұр сарайында ұйым мүшелері →
Dialogue: 0,0:12:40.64,0:12:43.16,Default,,0,0,0,,Ол көп билік жүргізе бастады→
Dialogue: 0,0:12:43.16,0:12:46.69,Default,,0,0,0,,Мен ешқашан... Ах! Аа….
Dialogue: 0,0:12:46.69,0:12:50.96,Default,,0,0,0,,Енді Синдриядан кетіңіз, ханшайым.
Dialogue: 0,0:12:50.96,0:12:54.77,Default,,0,0,0,,Не? Қазір бұл ел нені көздеп отыр?
Dialogue: 0,0:12:54.77,0:12:58.04,Default,,0,0,0,,Бұл өз бастамасымен жұмыс істейтін ұйымның бөлігі сияқты.
Dialogue: 0,0:12:58.04,0:13:01.41,Default,,0,0,0,,Басқаша айтқанда, сіз жарқыраған ханшайым болсаңыз да→
Dialogue: 0,0:13:01.41,0:13:05.06,Default,,0,0,0,,Қауіпсіздікке кепілдік берілмейді.
Dialogue: 0,0:13:05.06,0:13:08.37,Default,,0,0,0,,Мен сенің зардап шеккеніңді қаламаймын. →
Dialogue: 0,0:13:08.37,0:13:11.23,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:13:11.23,0:13:14.35,Default,,0,0,0,,Олай болса, мені жаныңда ұсташы.
Dialogue: 0,0:13:14.35,0:13:16.82,Default,,0,0,0,,Мен де лабиринтті бағындырушымын.
Dialogue: 0,0:13:16.82,0:13:18.86,Default,,0,0,0,,Ешқашан кедергі жасамаңыз.
Dialogue: 0,0:13:18.86,0:13:20.86,Default,,0,0,0,,Жоқ Қаласаңыз…→
Dialogue: 0,0:13:22.38,0:13:24.56,Default,,0,0,0,,Егер бұл сіз үшін болса, мен...
Dialogue: 0,0:13:24.56,0:13:27.06,Default,,0,0,0,,Ханшайым, артық айтпау керек.
Dialogue: 0,0:13:28.52,0:13:31.94,Default,,0,0,0,,Дегенмен, мен сіздің сезімдеріңізді түсінемін.
Dialogue: 0,0:13:31.94,0:13:35.76,Default,,0,0,0,,Көңіліңіз жеткенше осы елде болыңыз, ханшайым.
Dialogue: 0,0:13:35.76,0:13:38.81,Default,,0,0,0,,Ах, а... →
Dialogue: 0,0:13:38.81,0:13:40.81,Default,,0,0,0,,Иә….
Dialogue: 0,0:13:44.42,0:13:47.82,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:55.06,0:15:58.69,Default,,0,0,0,,Қарғыс атсын! Хмм! Гах...
Dialogue: 0,0:15:58.69,0:16:00.90,Default,,0,0,0,,Ей! Хмф!
Dialogue: 0,0:16:00.90,0:16:04.20,Default,,0,0,0,,Ол тез... ауыр көрінсе де.
Dialogue: 0,0:16:05.78,0:16:07.81,Default,,0,0,0,,Аа...
Dialogue: 0,0:16:07.81,0:16:11.65,Default,,0,0,0,,Бұл сұм қылыш. Неліктен бұл сиқырлы жігіттер →
Dialogue: 0,0:16:11.65,0:16:14.58,Default,,0,0,0,,Мен осындай баланы таңдар ма едім деп ойлаймын. Қарғыс атсын!
Dialogue: 0,0:16:14.58,0:16:18.56,Default,,0,0,0,,Маған ұнамайды, Теме де, Маги де.
Dialogue: 0,0:16:18.56,0:16:20.56,Default,,0,0,0,,≪Келе жатыр! ≫
Dialogue: 0,0:16:22.76,0:16:24.76,Default,,0,0,0,,Керемет!
Dialogue: 0,0:16:26.18,0:16:29.00,Default,,0,0,0,,Уф! Ах... Уау!
Dialogue: 0,0:16:29.00,0:16:31.27,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:16:31.27,0:16:33.44,Default,,0,0,0,,≪Бұл жігіт...≫
Dialogue: 0,0:16:33.44,0:16:35.86,Default,,0,0,0,,≪Бұл адам...→
Dialogue: 0,0:16:35.86,0:16:39.36,Default,,0,0,0,,Оның шабуыл күші менің «қорғаныс сиқырымнан» асып түседі≫
Dialogue: 0,0:16:40.81,0:16:43.61,Default,,0,0,0,,≪Ол қылыш шеберлігі жағынан менен толықтай асып түседі≫
Dialogue: 0,0:16:45.68,0:16:48.70,Default,,0,0,0,,≪Бірақ...≫ ≪Бұл соңы емес! ≫
Dialogue: 0,0:16:48.70,0:16:50.70,Default,,0,0,0,,≪Руфтер! ≫
Dialogue: 0,0:16:52.82,0:16:55.21,Default,,0,0,0,,Бұл жай ғана сиқырлы оқ па? →
Dialogue: 0,0:16:55.21,0:16:58.01,Default,,0,0,0,,Қанша рет осылай істесең де, бәрі бірдей емес пе?
Dialogue: 0,0:16:58.01,0:17:01.45,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:01.45,0:17:03.45,Default,,0,0,0,,Хмф, беріле ме?
Dialogue: 0,0:17:04.82,0:17:08.84,Default,,0,0,0,,((Ол қаруланған сиқырлы құрал сіздің қылыш шеберлігіңізге сәйкес келмейді.→
Dialogue: 0,0:17:08.84,0:17:12.08,Default,,0,0,0,,Сізге сәйкес келетін жақсы әдіс бар))
Dialogue: 0,0:17:12.08,0:17:15.46,Default,,0,0,0,,≪Содан бері мен ойлап тапқан патша қылыш шеберлігі →
Dialogue: 0,0:17:15.46,0:17:19.55,Default,,0,0,0,,Бұл қылыштың салмағын қолданатын стиль емес.
Dialogue: 0,0:17:19.55,0:17:23.62,Default,,0,0,0,,≪Басқаша айтқанда, мен үшін ең жақсы жол...≫
Dialogue: 0,0:17:23.62,0:17:26.62,Default,,0,0,0,,Куууу~!
Dialogue: 0,0:17:28.27,0:17:30.86,Default,,0,0,0,,≪Сиқырлы күшті басу және басқару≫
Dialogue: 0,0:17:30.86,0:17:38.12,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:38.12,0:17:40.92,Default,,0,0,0,,Қаруланған сиқырлы құрал Амонның қымбат қылышы!
Dialogue: 0,0:17:43.41,0:17:45.68,Default,,0,0,0,,Кін! Туысқан! Туысқан!
Dialogue: 0,0:17:45.68,0:17:49.65,Default,,0,0,0,,Мм. Сіз қазір сәл жақсырақсыз.
Dialogue: 0,0:17:49.65,0:17:52.28,Default,,0,0,0,,Қарғыс атсын... Хмф!
Dialogue: 0,0:17:52.28,0:17:55.64,Default,,0,0,0,,Ах! Бірақ→
Dialogue: 0,0:17:55.64,0:17:57.99,Default,,0,0,0,,жеткіліксіз.
Dialogue: 0,0:17:57.99,0:18:00.02,Default,,0,0,0,,Бакин! Не!
Dialogue: 0,0:18:00.02,0:18:05.96,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:05.96,0:18:08.06,Default,,0,0,0,,Дүние итеріле бастады ма?
Dialogue: 0,0:18:08.06,0:18:10.82,Default,,0,0,0,,Ха... Маған сиқырлы күш жетпейді! →
Dialogue: 0,0:18:10.82,0:18:14.19,Default,,0,0,0,,Сіз кішкентай шабуылдармен сиқырлы қуатты тұтынуға себеп болдыңыз дейсіз бе?
Dialogue: 0,0:18:14.19,0:18:17.19,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:17.19,0:18:20.13,Default,,0,0,0,,((Ұмытпа, Аладдин-кун.→
Dialogue: 0,0:18:20.13,0:18:22.76,Default,,0,0,0,,Сіз сиқыршысыз. Рафф жақсы көреді →
Dialogue: 0,0:18:22.76,0:18:25.05,Default,,0,0,0,,Таусылмайтын сиқырлы күш - →
Dialogue: 0,0:18:25.05,0:18:28.10,Default,,0,0,0,,Бұл сенің қаруың, оны ешкім жеңе алмайды))
Dialogue: 0,0:18:28.10,0:18:37.86,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:37.86,0:18:41.16,Default,,0,0,0,,Куу~! Заш! Заш! Заш!
Dialogue: 0,0:18:41.16,0:18:48.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:48.30,0:18:51.37,Default,,0,0,0,,«Қүйген егіз алақан»!
Dialogue: 0,0:18:51.37,0:18:54.16,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:18:54.16,0:18:58.33,Default,,0,0,0,,Жарайды, сенің құдіретің керемет. →
Dialogue: 0,0:18:58.33,0:19:01.63,Default,,0,0,0,,Бірақ әлі біткен жоқ. →
Dialogue: 0,0:19:01.63,0:19:05.22,Default,,0,0,0,,Сіздер үшін қара металл ыдыстың одан әрі қуаты→
Dialogue: 0,0:19:05.22,0:19:07.57,Default,,0,0,0,,Танысайық. →
Dialogue: 0,0:19:07.57,0:19:12.17,Default,,0,0,0,,Оған дейін, Дуния, сен өз мақсатыңды орындай алмайсың. →
Dialogue: 0,0:19:13.63,0:19:16.48,Default,,0,0,0,,Оян, қара ыдыс!
Dialogue: 0,0:19:16.48,0:19:18.52,Default,,0,0,0,,Ооо!
Dialogue: 0,0:19:18.52,0:19:21.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:24.87,0:19:27.23,Default,,0,0,0,,Жоқ!!
Dialogue: 0,0:19:27.23,0:19:31.63,Default,,0,0,0,,Гяа!!
Dialogue: 0,0:19:42.46,0:19:45.83,Default,,0,0,0,,Ол қайтып оралады ма? Жоқ, бұл...
Dialogue: 0,0:19:45.83,0:19:53.15,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:53.15,0:19:57.16,Default,,0,0,0,,Бұл қара металдан жасалған ыдыс арқылы жасалған соңғы пішін→
Dialogue: 0,0:19:57.16,0:19:59.26,Default,,0,0,0,,Бұл қараңғылықтың толық денелі сиқырлы сауыты.
Dialogue: 0,0:20:01.46,0:20:04.81,Default,,0,0,0,,Бұл толық денелі қара сауыт па?
Dialogue: 0,0:20:04.81,0:20:08.00,Default,,0,0,0,,Мен сендерге жағымсыз нәрселерді көрсеттім.
Dialogue: 0,0:20:08.00,0:20:11.89,Default,,0,0,0,,Келесі жолы мен сізді осы формада қарсы аламын. →
Dialogue: 0,0:20:11.89,0:20:13.89,Default,,0,0,0,,Иә! (2 адам) Қарғыс атсын!
Dialogue: 0,0:20:16.79,0:20:20.45,Default,,0,0,0,,≪Бұрынғыдан да күштірек күшті сезінемін≫
Dialogue: 0,0:20:20.45,0:20:22.73,Default,,0,0,0,,≪«Қорғаныс сиқыры» міндетті түрде бұзылады≫
Dialogue: 0,0:20:22.73,0:20:24.73,Default,,0,0,0,,Хехе.
Dialogue: 0,0:20:26.69,0:20:29.47,Default,,0,0,0,,Өзгертілді! иә. →
Dialogue: 0,0:20:29.47,0:20:32.54,Default,,0,0,0,,Жиналған темір құмды лезде қатайтып, қару ретінде пайдалану→
Dialogue: 0,0:20:32.54,0:20:36.20,Default,,0,0,0,,Трансформацияланатын болат қалақ. Ах!
Dialogue: 0,0:20:36.20,0:20:38.41,Default,,0,0,0,,Уау! Хмф!
Dialogue: 0,0:20:38.41,0:20:40.41,Default,,0,0,0,,Қарғыс атсын!Апыр-ай!
Dialogue: 0,0:20:41.83,0:20:45.14,Default,,0,0,0,,Рахмет, Алибаба-кун. Бұл 2-ден 1-ге дейін.
Dialogue: 0,0:20:45.14,0:20:47.14,Default,,0,0,0,,Асықпай-ақ қояйық.
Dialogue: 0,0:20:48.98,0:20:53.06,Default,,0,0,0,,Ысқақ, сен қанша ұйықтайсың? Оян.
Dialogue: 0,0:20:53.06,0:20:55.06,Default,,0,0,0,,Иә, Мәртебелі.
Dialogue: 0,0:20:56.72,0:20:58.89,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:58.89,0:21:03.02,Default,,0,0,0,,Бір тамшы қан шықпады, бұл мүмкін емес!
Dialogue: 0,0:21:03.02,0:21:05.91,Default,,0,0,0,,Ысқақ менің тағдырыммен бөліседі→
Dialogue: 0,0:21:05.91,0:21:08.36,Default,,0,0,0,,Ол мәңгілік рыцарь. →
Dialogue: 0,0:21:08.36,0:21:12.80,Default,,0,0,0,,Бірге ант бердік. Бір күні елге барармын...→
Dialogue: 0,0:21:12.80,0:21:16.10,Default,,0,0,0,,Жоғалған Мұстасымды қалпына келтіру.
Dialogue: 0,0:21:16.10,0:21:18.50,Default,,0,0,0,,Мен саған кедергі келтірмеймін.
Dialogue: 0,0:21:18.50,0:21:22.31,Default,,0,0,0,,Бағыныңқы: Қара фарфор сауыт.
Dialogue: 0,0:21:22.31,0:21:25.23,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:21:25.23,0:21:27.63,Default,,0,0,0,,Ысқақтың қара фарфор сауыты →
Dialogue: 0,0:21:27.63,0:21:30.32,Default,,0,0,0,,Құрыш пен жерді магниттік күшпен қайтару→
Dialogue: 0,0:21:30.32,0:21:33.12,Default,,0,0,0,,Жарылыс үдеуін тудырады.
Dialogue: 0,0:21:33.12,0:21:35.12,Default,,0,0,0,,Менің артымнан келе аласыз ба?
Dialogue: 0,0:21:37.19,0:21:39.09,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:39.09,0:21:44.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:44.70,0:21:46.85,Default,,0,0,0,,≪(Хакурю) Артында! Ха! Арх!
Dialogue: 0,0:21:46.85,0:21:50.34,Default,,0,0,0,,Мен саған көмектесемін. Күрсін!
Dialogue: 0,0:21:50.34,0:21:54.54,Default,,0,0,0,,Пайдалы! Морджиана ше? Бұл қазына.
Dialogue: 0,0:21:54.54,0:21:56.64,Default,,0,0,0,,Сіз оны енгіздіңіз бе? (Хакурю) Иә.
Dialogue: 0,0:21:58.01,0:22:00.81,Default,,0,0,0,,Алибаба-доно, ол кезде... Ха! Қарғыс атсын!
Dialogue: 0,0:22:02.43,0:22:05.59,Default,,0,0,0,,Алибаба-кун, уақытты ұтып, күресейік.
Dialogue: 0,0:22:05.59,0:22:08.04,Default,,0,0,0,,Менде сиқырлы күш көп.
Dialogue: 0,0:22:08.04,0:22:11.46,Default,,0,0,0,,Бірақ мен олардың ақырында таусылатынына сенімдімін.
Dialogue: 0,0:22:11.46,0:22:13.74,Default,,0,0,0,,Түсіндім. Хакурю: Біз...
Dialogue: 0,0:22:13.74,0:22:16.54,Default,,0,0,0,,Мұны істеу дұрыс па?
Dialogue: 0,0:22:18.18,0:22:20.58,Default,,0,0,0,,Ах, Синдрия.
Dialogue: 0,0:22:20.58,0:22:23.04,Default,,0,0,0,,Қорғаныс кедергісі бұзылды.
Dialogue: 0,0:22:23.04,0:22:25.44,Default,,0,0,0,,Бұл ұйым болды...
Dialogue: 0,0:22:25.44,0:22:27.47,Default,,0,0,0,,Балалар, сендер нені айтасыңдар?
Dialogue: 0,0:22:27.47,0:22:30.28,Default,,0,0,0,,Сіз бұл елді шайқасқа тартқыңыз келе ме?
Dialogue: 0,0:22:30.28,0:22:35.10,Default,,0,0,0,,Оған сен кінәлісің, Алибаба патша.
Dialogue: 0,0:22:35.10,0:22:37.27,Default,,0,0,0,,Не? (Иснаан) Сіз сол елдесіз →
Dialogue: 0,0:22:37.27,0:22:40.87,Default,,0,0,0,,Біз қашып кеткендіктен, енді бізде Синдрия жоқ→
Dialogue: 0,0:22:40.87,0:22:43.92,Default,,0,0,0,,Оны жалғыз қалдыруға болмайды деп шешілді. →
Dialogue: 0,0:22:43.92,0:22:47.73,Default,,0,0,0,,Ол кісі... Синдбад та. →
Dialogue: 0,0:22:47.73,0:22:52.50,Default,,0,0,0,,Бақытымызға орай, оның өкілеттіктері қазір мөрленген.
Dialogue: 0,0:22:52.50,0:22:55.27,Default,,0,0,0,,Менің кесірімнен солай ма?
Dialogue: 0,0:22:55.27,0:22:57.90,Default,,0,0,0,,Иә, Алибаба патшасы. →
Dialogue: 0,0:22:57.90,0:23:01.74,Default,,0,0,0,,Қайда барсаң да, шатасу болады→
Dialogue: 0,0:23:01.74,0:23:05.34,Default,,0,0,0,,Шайқас болады, өлім болады. →
Dialogue: 0,0:23:06.81,0:23:09.25,Default,,0,0,0,,Бұл сенің тағдырың.
Dialogue: 0,0:23:09.25,0:23:12.03,Default,,0,0,0,,Менің... тағдырым...
Dialogue: 0,0:23:12.03,0:23:14.70,Default,,0,0,0,,Алибаба-кун! (Хакурю) Өтінемін, мені тыңдама. →
Dialogue: 0,0:23:14.70,0:23:17.64,Default,,0,0,0,,Ұйым ұзақ уақыт бойы Синдрияны нысанаға алды.
Dialogue: 0,0:23:17.64,0:23:19.81,Default,,0,0,0,,Қарғыс атсын! (Иснан) О, тәңірім →
Dialogue: 0,0:23:19.81,0:23:23.26,Default,,0,0,0,,Ханзада қиындыққа тап болды. Дүние→
Dialogue: 0,0:23:23.26,0:23:25.45,Default,,0,0,0,,Ол Жудалдың сүйіктісі→
Dialogue: 0,0:23:25.45,0:23:28.45,Default,,0,0,0,,Мен де аздап алаңдаймын →
Dialogue: 0,0:23:28.45,0:23:31.27,Default,,0,0,0,,Мүмкін болса, оны тірідей үйге жеткізгім келеді.
Dialogue: 0,0:23:31.27,0:23:35.83,Default,,0,0,0,,Бұл мүмкін емес. Сіз мұны бірден тоқтатасыз.
Dialogue: 0,0:23:35.83,0:23:39.01,Default,,0,0,0,,Менің керемет сиқырыммен. Ах!
Dialogue: 0,0:23:39.01,0:23:41.05,Default,,0,0,0,,≪Максималды сиқыр? ≫
Dialogue: 0,0:23:41.05,0:23:44.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:44.58,0:23:47.54,Default,,0,0,0,,Максималды сиқыр «Шексіз қылыш биінің қалыптасуы».
Dialogue: 0,0:23:47.54,0:23:55.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:55.58,0:23:57.96,Default,,0,0,0,,Барлығыңыз, сақ болыңыздар! Бұл аз →
Dialogue: 0,0:23:57.96,0:24:02.12,Default,,0,0,0,,Бұл жаман болуы мүмкін! Бірақ бірдеңе істеуден басқа амалым жоқ!
Dialogue: 0,0:24:02.12,0:24:04.27,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:24:04.27,0:24:07.16,Default,,0,0,0,,Тезірек Заған билігіне қол жеткізіңіз→
Dialogue: 0,0:24:07.16,0:24:10.21,Default,,0,0,0,,Оны Синдбад мырзаға жеткізіңіз.
Dialogue: 0,0:24:10.21,0:24:13.03,Default,,0,0,0,,Сен мені қалағаныңды жасауға мәжбүрлейсің бе?
Dialogue: 0,0:24:13.03,0:24:29.08,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:29.08,0:24:31.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:33.77,0:24:37.00,Default,,0,0,0,,≪Жақсы. Ақыры осында. →
Dialogue: 0,0:24:37.00,0:24:40.19,Default,,0,0,0,,Король Алибаба, Синбад→
Dialogue: 0,0:24:40.19,0:24:43.29,Default,,0,0,0,,Ұрыс! Мені жек көр≫
Dialogue: 0,0:24:45.01,0:24:47.11,Default,,0,0,0,,>
Dialogue: 0,0:24:51.88,0:24:54.18,Default,,0,0,0,,Иә? Ол да келген сияқты.
Dialogue: 0,0:24:56.74,0:24:58.97,Default,,0,0,0,,Бұл ел менімен →
Dialogue: 0,0:24:58.97,0:25:02.45,Default,,0,0,0,,Халқым үшін азаттықтың тірегі. →
Dialogue: 0,0:25:02.45,0:25:05.75,Default,,0,0,0,,Ешкім өз бостандығына қол сұға алмайды.
Dialogue: 0,0:25:07.13,0:25:09.89,Default,,0,0,0,,Синдбад атынан бұйрық беремін→
Dialogue: 0,0:25:09.89,0:25:12.49,Default,,0,0,0,,Синдрия патшалығының армиясы!
Dialogue: 0,0:25:14.02,0:25:58.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:02.72,0:26:13.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:17.67,0:26:43.05,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:45.32,0:30:48.14,Default,,0,0,0,,Бүгін Либералдық-демократиялық партия өзінің партия съезіне және Кеңесшілер палатасының жазғы сайлауына дайындалуда.
Dialogue: 0,0:30:48.14,0:30:50.58,Default,,0,0,0,,Премьер-министр Абэ митингі өткізді және
Dialogue: 0,0:30:50.58,0:30:51.83,Default,,0,0,0,,Кеңесшілер палатасының сайлауында жеңіске жету
Dialogue: 0,0:30:51.83,0:30:55.23,Default,,0,0,0,,Ол Жапонияның мақтаншақ Жапонияны қайтаратынын атап өтті.
Dialogue: 0,0:30:56.73,0:31:01.73,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
