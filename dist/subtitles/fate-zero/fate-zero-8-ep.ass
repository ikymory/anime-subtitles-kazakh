Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.82,0:00:08.65,Default,,0,0,0,,Эй, Смоки. Ақыры ұстадым-ау.
Dialogue: 0,0:00:10.99,0:00:12.11,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:00:19.79,0:00:20.79,Default,,0,0,0,,Ханым?
Dialogue: 0,0:00:21.50,0:00:23.50,Default,,0,0,0,,Тағы бір жаңа бұзушы.
Dialogue: 0,0:00:23.75,0:00:26.46,Default,,0,0,0,,Алдымызда
Dialogue: 0,0:00:26.58,0:00:29.05,Default,,0,0,0,,Егер бұл жалғаса берсе, біз бір-бірімізді кездестіреміз
Dialogue: 0,0:00:29.17,0:00:30.30,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:00:30.38,0:00:33.01,Default,,0,0,0,,Енді солтүстік жаққа айналма жолмен барайық.
Dialogue: 0,0:00:34.43,0:00:35.34,Default,,0,0,0,,Ha
Dialogue: 0,0:00:35.97,0:00:36.84,Default,,0,0,0,,Ханым?
Dialogue: 0,0:00:37.51,0:00:38.93,Default,,0,0,0,,Не келе жатыр...
Dialogue: 0,0:00:40.85,0:00:42.52,Default,,0,0,0,,Кирей Котомине
Dialogue: 0,0:00:44.02,0:00:50.02,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:07.89,0:02:13.90,Default,,0,0,0,,~♪
Dialogue: 0,0:02:17.78,0:02:19.49,Default,,0,0,0,,Кирей Котомине
Dialogue: 0,0:02:21.53,0:02:25.29,Default,,0,0,0,,Майя-сан, Кирицугудан алған бұйрықтарыңыз болды
Dialogue: 0,0:02:25.45,0:02:27.75,Default,,0,0,0,,Бұл менің қауіпсіздігімді қамтамасыз ету туралы.
Dialogue: 0,0:02:27.87,0:02:28.71,Default,,0,0,0,,Иә
Dialogue: 0,0:02:30.17,0:02:31.96,Default,,0,0,0,,(Майя) Бірақ... бірақ не?
Dialogue: 0,0:02:32.71,0:02:37.21,Default,,0,0,0,,Мен ол кісінің Кирицугуға кетуіне ешқашан рұқсат бере алмаймын.
Dialogue: 0,0:02:38.63,0:02:40.13,Default,,0,0,0,,Сіз осылай ойлайсыз ба?
Dialogue: 0,0:02:43.43,0:02:45.72,Default,,0,0,0,,Ханым, сіз...
Dialogue: 0,0:02:45.81,0:02:47.48,Default,,0,0,0,,Кездейсоқтық.
Dialogue: 0,0:02:47.60,0:02:50.73,Default,,0,0,0,,Мен де сізбен толықтай келісемін.
Dialogue: 0,0:02:51.73,0:02:53.36,Default,,0,0,0,,Кирей Котомине
Dialogue: 0,0:02:53.48,0:02:57.90,Default,,0,0,0,,Кирицугу үшін ең қауіпті адам...
Dialogue: 0,0:02:59.15,0:03:01.24,Default,,0,0,0,,Екеуміз тоқтаған жеріміз осы.
Dialogue: 0,0:03:01.99,0:03:03.78,Default,,0,0,0,,Жақсы, Майя-сан.
Dialogue: 0,0:03:05.53,0:03:07.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:07.16,0:03:10.33,Default,,0,0,0,,Дайын болыңыз, ханым.
Dialogue: 0,0:03:10.62,0:03:14.04,Default,,0,0,0,,Иә, мен үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:03:14.17,0:03:16.50,Default,,0,0,0,,Сен міндетіңді орындайсың.
Dialogue: 0,0:03:17.00,0:03:19.05,Default,,0,0,0,,Кирицугудан келген бұйрық емес.
Dialogue: 0,0:03:19.34,0:03:21.80,Default,,0,0,0,,Өзіңіз қажет деп санайтын нәрсе
Dialogue: 0,0:03:22.18,0:03:23.01,Default,,0,0,0,,Иә
Dialogue: 0,0:03:24.05,0:03:24.85,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:25.47,0:03:26.26,Default,,0,0,0,,Не?
Dialogue: 0,0:03:26.81,0:03:27.60,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:28.43,0:03:32.31,Default,,0,0,0,,Адамның жүрегі жұмбақ, солай емес пе?
Dialogue: 0,0:03:35.15,0:03:38.11,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:42.20,0:03:42.99,Default,,0,0,0,,Хмм…
Dialogue: 0,0:03:43.11,0:03:46.24,Default,,0,0,0,,Жұмыс істемейтінін білетін қайталанатын шабуылдар...
Dialogue: 0,0:03:55.75,0:03:56.50,Default,,0,0,0,,Ha
Dialogue: 0,0:03:57.38,0:03:58.55,Default,,0,0,0,,Ол сәл қорқынышты емес пе?
Dialogue: 0,0:04:01.72,0:04:02.72,Default,,0,0,0,,Бас терісі!
Dialogue: 0,0:04:18.57,0:04:23.03,Default,,0,0,0,,Сіз Вольмен Гидраграммасының автономды қорғанысы бұзылғанын айттыңыз ба?
Dialogue: 0,0:04:23.78,0:04:27.49,Default,,0,0,0,,Жоқ, жоқ, бұл баланың шабуылында олай емес.
Dialogue: 0,0:04:27.58,0:04:29.74,Default,,0,0,0,,Мен жай ғана сақамды түсірдім!
Dialogue: 0,0:04:30.66,0:04:32.41,Default,,0,0,0,,Жылдамырақ
Dialogue: 0,0:04:32.54,0:04:35.79,Default,,0,0,0,,Және қорғанысыңызды тиімдірек дайындаңыз...
Dialogue: 0,0:04:37.46,0:04:39.92,Default,,0,0,0,,Сиқыршының беті масқара...
Dialogue: 0,0:04:40.30,0:04:41.88,Default,,0,0,0,,Ей, масқара!
Dialogue: 0,0:04:42.26,0:04:44.26,Default,,0,0,0,,Қанымды төгу...
Dialogue: 0,0:04:45.13,0:04:47.09,Default,,0,0,0,,Бұл мені еске түсіреді!
Dialogue: 0,0:04:52.43,0:04:55.56,Default,,0,0,0,,(Кирицугу) Бұл жігіттің құдіретін осылай түсінді.
Dialogue: 0,0:04:55.90,0:04:58.11,Default,,0,0,0,,Дәл сол шабуыл енді жұмыс істемейді
Dialogue: 0,0:04:58.77,0:05:00.77,Default,,0,0,0,,Содан кейін оған барлық сиқырлы күшіңізді құйыңыз.
Dialogue: 0,0:05:00.90,0:05:02.36,Default,,0,0,0,,Олар өздерін қорғауы керек.
Dialogue: 0,0:05:03.61,0:05:04.45,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:05.53,0:05:07.74,Default,,0,0,0,,Егер олай болмаса, мен қиыншылыққа тап болар едім.
Dialogue: 0,0:05:08.12,0:05:09.24,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:05:25.88,0:05:27.09,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:05:33.85,0:05:34.68,Default,,0,0,0,,Гэндзюцу?
Dialogue: 0,0:05:52.28,0:05:53.70,Default,,0,0,0,,Майя-сан, жоқ!
Dialogue: 0,0:05:54.08,0:05:55.08,Default,,0,0,0,,Уф!Қарғыс атқыр...
Dialogue: 0,0:06:05.55,0:06:06.55,Default,,0,0,0,,Ha
Dialogue: 0,0:06:08.18,0:06:09.34,Default,,0,0,0,,Гах...
Dialogue: 0,0:06:11.18,0:06:12.93,Default,,0,0,0,,Гааааааааааа!
Dialogue: 0,0:06:13.06,0:06:15.35,Default,,0,0,0,,Гаха… Каа…
Dialogue: 0,0:06:21.56,0:06:24.02,Default,,0,0,0,,Ханым... Мен алмаймын...
Dialogue: 0,0:06:25.19,0:06:28.45,Default,,0,0,0,,Әйел, сіз таң қалуыңыз мүмкін, бірақ
Dialogue: 0,0:06:28.70,0:06:31.91,Default,,0,0,0,,Мен мұнда сені жеңу үшін келген жоқпын.
Dialogue: 0,0:06:32.87,0:06:36.12,Default,,0,0,0,,Мен Кирей Котоминді түсінемін
Dialogue: 0,0:06:37.37,0:06:39.37,Default,,0,0,0,,Мен сіздің мақсатыңызды білемін
Dialogue: 0,0:06:39.58,0:06:41.50,Default,,0,0,0,,Бірақ бұл қиын кеңес.
Dialogue: 0,0:06:41.79,0:06:44.80,Default,,0,0,0,,Сіз Кирицугу Эмияға ешқашан жете алмайсыз.
Dialogue: 0,0:06:45.63,0:06:47.26,Default,,0,0,0,,Біз оның алдын аламыз.
Dialogue: 0,0:06:48.17,0:06:49.13,Default,,0,0,0,,Мұнда
Dialogue: 0,0:06:49.22,0:06:50.18,Default,,0,0,0,,Ханым!
Dialogue: 0,0:06:50.26,0:06:53.72,Default,,0,0,0,,Бұл адам агент және сиқыршы аңшылықтың шебері!
Dialogue: 0,0:06:53.80,0:06:56.18,Default,,0,0,0,,Мен жай ғана сиқырмен ештеңе істей алатын адам емеспін!
Dialogue: 0,0:06:59.56,0:07:01.73,Default,,0,0,0,,Кирицугудан не үйрендім
Dialogue: 0,0:07:01.81,0:07:03.86,Default,,0,0,0,,Бұл жай ғана көлік жүргізу емес, солай ма?
Dialogue: 0,0:07:04.27,0:07:07.53,Default,,0,0,0,,Өмір сүру және аман қалу үшін!
Dialogue: 0,0:07:08.07,0:07:09.99,Default,,0,0,0,,Shape ist leben!
Dialogue: 0,0:07:10.86,0:07:12.07,Default,,0,0,0,,(айқай)
Dialogue: 0,0:07:16.37,0:07:17.33,Default,,0,0,0,,(айқай)
Dialogue: 0,0:07:25.04,0:07:25.79,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:38.72,0:07:40.81,Default,,0,0,0,,(Майя) Ханым! Бұл тәтті!
Dialogue: 0,0:07:44.40,0:07:45.15,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:07:53.45,0:07:54.62,Default,,0,0,0,,Майя-сан!
Dialogue: 0,0:07:56.28,0:07:57.33,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:07:59.37,0:08:00.50,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:08:09.00,0:08:10.30,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:14.47,0:08:16.01,Default,,0,0,0,,(Кирейдің тыныс алу дыбысы)
Dialogue: 0,0:08:25.10,0:08:26.48,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:08:28.23,0:08:29.48,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:08:50.09,0:08:51.13,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:08:51.21,0:08:52.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:02.39,0:09:04.64,Default,,0,0,0,,Іс осыншама жеткенде,
Dialogue: 0,0:09:04.73,0:09:07.35,Default,,0,0,0,,Мен таң қалдым, таң қалдым.
Dialogue: 0,0:09:07.73,0:09:09.69,Default,,0,0,0,,Бұл сиқырлы кітап, Лансер.
Dialogue: 0,0:09:10.40,0:09:14.57,Default,,0,0,0,,Оның асыл фантасмасы болғанша, бұл соғыс жағдайын өзгерту мүмкін емес.
Dialogue: 0,0:09:15.32,0:09:17.57,Default,,0,0,0,,Мен көремін. Солай ма?
Dialogue: 0,0:09:18.20,0:09:20.24,Default,,0,0,0,,Бірақ әлгі көкбауырдың қолынан
Dialogue: 0,0:09:20.37,0:09:22.66,Default,,0,0,0,,Кітапты өшіргіңіз келсе
Dialogue: 0,0:09:22.91,0:09:24.20,Default,,0,0,0,,Апа, мен өскенде,
Dialogue: 0,0:09:24.33,0:09:26.79,Default,,0,0,0,,Бұл бейбақтардың қабырғасын бұзып өтуден басқа амалымыз жоқ.
Dialogue: 0,0:09:27.29,0:09:28.42,Default,,0,0,0,,Лансер
Dialogue: 0,0:09:28.54,0:09:31.75,Default,,0,0,0,,Осыған байланысты құмар ойын ойнауға дайынсыз ба?
Dialogue: 0,0:09:32.17,0:09:34.21,Default,,0,0,0,,Мен ашулымын, өйткені өзімді жеңілген сезінемін.
Dialogue: 0,0:09:34.34,0:09:37.22,Default,,0,0,0,,Закомен бұлай ойнай беруде өнер жоқ.
Dialogue: 0,0:09:37.80,0:09:40.76,Default,,0,0,0,,Жарайды, мінейік, Сабер.
Dialogue: 0,0:09:41.05,0:09:45.06,Default,,0,0,0,,Мен жол ашамын, бұл сенің бір мүмкіндігің.
Dialogue: 0,0:09:45.39,0:09:48.23,Default,,0,0,0,,Lancer Сіз желді басып жүгіре аласыз ба?
Dialogue: 0,0:09:48.56,0:09:50.69,Default,,0,0,0,,Хехе, түсіндім.
Dialogue: 0,0:09:50.77,0:09:51.77,Default,,0,0,0,,Бұл сезім… қате емес
Dialogue: 0,0:09:52.07,0:09:55.36,Default,,0,0,0,,Соңғы намазыңызды аяқтадыңыз ба?
Dialogue: 0,0:09:55.44,0:09:59.07,Default,,0,0,0,,Енді, қорқыныш, үмітсіздік!
Dialogue: 0,0:09:59.16,0:10:01.87,Default,,0,0,0,,Әскери ерлік дәрежесі арқылы ғана жеңуге болатын «сандағы айырмашылық»
Dialogue: 0,0:10:01.95,0:10:04.79,Default,,0,0,0,,Шектер бар.
Dialogue: 0,0:10:05.50,0:10:07.12,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:10:07.37,0:10:09.79,Default,,0,0,0,,Масқара, солай ма?
Dialogue: 0,0:10:09.92,0:10:12.71,Default,,0,0,0,,Жындармен жаншылған даңқ та, абырой да жоқ.
Dialogue: 0,0:10:12.79,0:10:15.55,Default,,0,0,0,,Мен тұншығып өлемін!
Dialogue: 0,0:10:15.76,0:10:19.64,Default,,0,0,0,,Батыр үшін бұдан асқан ұят жоқ.
Dialogue: 0,0:10:19.76,0:10:22.76,Default,,0,0,0,,Уау! Сол әдемі жүз!
Dialogue: 0,0:10:22.85,0:10:25.68,Default,,0,0,0,,Енді оның қатты бұрмалануына жол беретін кез келді.
Dialogue: 0,0:10:25.81,0:10:26.64,Default,,0,0,0,,Жанна!
Dialogue: 0,0:10:30.73,0:10:33.40,Default,,0,0,0,,Strike Air!
Dialogue: 0,0:10:38.90,0:10:39.91,Default,,0,0,0,,Эй!?
Dialogue: 0,0:10:41.66,0:10:44.03,Default,,0,0,0,,Міне кеттік! Дайын болыңыз!
Dialogue: 0,0:10:46.62,0:10:48.96,Default,,0,0,0,,Гуг! Жын қызыл раушан (гей жаргу)!
Dialogue: 0,0:10:50.08,0:10:50.92,Default,,0,0,0,,Эй!
Dialogue: 0,0:10:55.50,0:10:59.84,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:11:13.86,0:11:15.23,Default,,0,0,0,,Сіз
Dialogue: 0,0:11:15.69,0:11:18.82,Default,,0,0,0,,Сен, сен, сен, сен, сен...
Dialogue: 0,0:11:18.90,0:11:20.74,Default,,0,0,0,,Сіз!!
Dialogue: 0,0:11:22.82,0:11:23.99,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:24.24,0:11:26.87,Default,,0,0,0,,Сабер енді «сол қолын» артқа қайтарса
Dialogue: 0,0:11:26.99,0:11:29.54,Default,,0,0,0,,Дөрекі сөзбен айтқанда, мынандай.
Dialogue: 0,0:11:31.58,0:11:33.04,Default,,0,0,0,,Дайын болыңыз.
Dialogue: 0,0:11:33.17,0:11:33.92,Default,,0,0,0,,Git!
Dialogue: 0,0:11:34.88,0:11:35.92,Default,,0,0,0,,Гедо
Dialogue: 0,0:11:36.67,0:11:40.47,Default,,0,0,0,,Жарайды... куууу!
Dialogue: 0,0:11:52.10,0:11:53.52,Default,,0,0,0,,Бұл нонсенс...
Dialogue: 0,0:11:53.60,0:11:56.02,Default,,0,0,0,,Мен осындай шайқасқа шыққым келеді
Dialogue: 0,0:11:56.11,0:11:59.15,Default,,0,0,0,,Біз Қасиетті Граил соғысына қатыспаймыз!
Dialogue: 0,0:12:10.04,0:12:12.04,Default,,0,0,0,,Ол қайда...?
Dialogue: 0,0:12:19.05,0:12:20.63,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:12:21.84,0:12:23.72,Default,,0,0,0,,Тінтуір тінтуірі
Dialogue: 0,0:12:28.35,0:12:32.64,Default,,0,0,0,,Сіз дәл сол қозғалыс бұрынғыдай жұмыс істейді деп ешқашан ойлаған жоқсыз, солай ма?
Dialogue: 0,0:12:33.10,0:12:34.44,Default,,0,0,0,,Төменгі өмір...
Dialogue: 0,0:12:36.27,0:12:39.40,Default,,0,0,0,,Сен мені бір жебемен марапаттадың.
Dialogue: 0,0:12:39.48,0:12:42.11,Default,,0,0,0,,Бұл мәміле немесе қулық немесе басқа нәрсе емес.
Dialogue: 0,0:12:42.44,0:12:45.57,Default,,0,0,0,,Бұл абсурдтық деп аталатын жай ғана кездейсоқтық.
Dialogue: 0,0:12:45.70,0:12:47.53,Default,,0,0,0,,Мен сізге айырмашылықты көрсетемін
Dialogue: 0,0:12:48.12,0:12:50.24,Default,,0,0,0,,Мен енді оңай өлтірмеймін.
Dialogue: 0,0:12:50.58,0:12:53.66,Default,,0,0,0,,Емдеу арқылы тек өкпе мен жүрек қалпына келеді.
Dialogue: 0,0:12:53.75,0:12:56.79,Default,,0,0,0,,Мен оны саусағыңыздың ұшынан бастап мұқият кесемін.
Dialogue: 0,0:12:57.25,0:13:01.30,Default,,0,0,0,,Өкінішпен, азаптан, үмітсіздіктен өл.
Dialogue: 0,0:13:01.96,0:13:04.47,Default,,0,0,0,,Өлген сайын қарғыс айт.
Dialogue: 0,0:13:04.59,0:13:07.22,Default,,0,0,0,,Жұмыс берушіңіздің қорқақтығы
Dialogue: 0,0:13:07.43,0:13:10.81,Default,,0,0,0,,Қасиетті Граил соғысын масқара еткен Эйнцберндер!
Dialogue: 0,0:13:12.39,0:13:15.19,Default,,0,0,0,,Қуаныш, мейірімсіз!
Dialogue: 0,0:13:17.65,0:13:18.48,Default,,0,0,0,,Хун
Dialogue: 0,0:13:23.19,0:13:25.74,Default,,0,0,0,,Менің ойымша, бұл солай болды! Ақымақ!
Dialogue: 0,0:13:31.33,0:13:32.08,Default,,0,0,0,,Иә
Dialogue: 0,0:13:33.25,0:13:34.50,Default,,0,0,0,,Уа!
Dialogue: 0,0:13:36.04,0:13:37.33,Default,,0,0,0,,Күрес!
Dialogue: 0,0:13:37.83,0:13:38.58,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:13:45.09,0:13:45.88,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:13:53.52,0:13:56.81,Default,,0,0,0,,Мен... Мен жексұрын адаммын.
Dialogue: 0,0:13:58.15,0:13:58.98,Default,,0,0,0,,Лансер
Dialogue: 0,0:14:01.44,0:14:02.65,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:06.99,0:14:09.91,Default,,0,0,0,,Қожайыныма қауіп төніп тұр...
Dialogue: 0,0:14:10.82,0:14:14.79,Default,,0,0,0,,Шамасы, ол мені артта қалдырып, сенің негізгі қоршауыңды шауып тастады.
Dialogue: 0,0:14:18.21,0:14:20.92,Default,,0,0,0,,Мен сенімдімін... бұл менің қожайынымның ісі.
Dialogue: 0,0:14:22.84,0:14:24.80,Default,,0,0,0,,Лансер, асығыңыз!
Dialogue: 0,0:14:25.42,0:14:27.30,Default,,0,0,0,,Иемізге көмекке барыңыз.
Dialogue: 0,0:14:29.68,0:14:32.35,Default,,0,0,0,,Тоқтатуға болмайтын Рыцарлар патшасы
Dialogue: 0,0:14:32.80,0:14:33.85,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:33.97,0:14:37.27,Default,,0,0,0,,Екеуміз бұл мәселені рыцарь ретінде шешуге ант еттік.
Dialogue: 0,0:14:37.68,0:14:39.56,Default,,0,0,0,,Сол мақтанышқа бірге берік болайық
Dialogue: 0,0:14:46.69,0:14:51.45,Default,,0,0,0,,Ақырында бәрі Кирицугу жоспарлағандай болды.
Dialogue: 0,0:14:53.53,0:14:54.28,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:14:57.54,0:15:00.54,Default,,0,0,0,,Баланың шығу тегі – «кесу» және «бірлесу»
Dialogue: 0,0:15:00.67,0:15:01.92,Default,,0,0,0,,Кесу және мұра ету
Dialogue: 0,0:15:05.34,0:15:09.17,Default,,0,0,0,,Оны «жою және қалпына келтіру» деп атаудың сәл өзгеше нюансы бар.
Dialogue: 0,0:15:10.01,0:15:12.39,Default,,0,0,0,,Бірде кесіліп, қайта байланған жіп
Dialogue: 0,0:15:12.47,0:15:15.39,Default,,0,0,0,,Тек түйін бөлігінің қалыңдығы өзгереді, солай ма?
Dialogue: 0,0:15:15.51,0:15:19.60,Default,,0,0,0,,Ол қайтымсыз өзгеріс коннотациясына ие.
Dialogue: 0,0:15:24.06,0:15:29.24,Default,,0,0,0,,Бұл оқта баланың ұнтақталған қабырғалары бар.
Dialogue: 0,0:15:29.32,0:15:33.28,Default,,0,0,0,,Осы арқылы баланың шыққан тегі атылған адам үшін шындыққа айналады.
Dialogue: 0,0:15:34.24,0:15:36.41,Default,,0,0,0,,​​Бұл жігіт сиқыршыларға қауіп төндіреді.
Dialogue: 0,0:15:37.12,0:15:40.25,Default,,0,0,0,,Бұл оққа мен сиқырмен аралассам,
Dialogue: 0,0:15:40.33,0:15:43.67,Default,,0,0,0,,Баланың шығу тегіне байланысты сиқырлы тізбек «үзілген».
Dialogue: 0,0:15:43.75,0:15:45.54,Default,,0,0,0,,«Қосылу» кездейсоқ
Dialogue: 0,0:15:45.63,0:15:48.09,Default,,0,0,0,,Неғұрлым сиқыршы болсаң, соғұрлым жақсысың.
Dialogue: 0,0:15:48.21,0:15:51.05,Default,,0,0,0,,Сиқырлы тізбек бақылаудан шығып, тұйықталу.
Dialogue: 0,0:15:51.55,0:15:53.97,Default,,0,0,0,,Әрине, қарсылас қалпына келе алмайды.
Dialogue: 0,0:15:54.09,0:15:56.51,Default,,0,0,0,,Сиқыршы ретінде де, адам ретінде де.
Dialogue: 0,0:15:57.26,0:16:00.60,Default,,0,0,0,,Бұл баланың ресми киімі, «түпнұсқа оқ»
Dialogue: 0,0:16:01.23,0:16:02.89,Default,,0,0,0,,Барлығы 66 ату
Dialogue: 0,0:16:03.90,0:16:05.65,Default,,0,0,0,,Оны абайлап пайдаланыңыз, солай емес пе?
Dialogue: 0,0:16:09.57,0:16:10.53,Default,,0,0,0,,Гаха
Dialogue: 0,0:16:10.65,0:16:12.99,Default,,0,0,0,,(Кейнет еңіреп)
Dialogue: 0,0:16:15.12,0:16:16.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:18.29,0:16:20.95,Default,,0,0,0,,Ааа! Ах...
Dialogue: 0,0:16:24.29,0:16:27.54,Default,,0,0,0,,Ааааааа...
Dialogue: 0,0:16:52.07,0:16:54.15,Default,,0,0,0,,(Лансер) Енді мен сені осында шашпақтаймын.
Dialogue: 0,0:16:54.28,0:16:56.99,Default,,0,0,0,,Сіз мұның қаншалықты оңай екенін білесіз бе?
Dialogue: 0,0:16:57.95,0:16:59.83,Default,,0,0,0,,Сабер шебері
Dialogue: 0,0:17:00.66,0:17:02.16,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:17:02.70,0:17:04.75,Default,,0,0,0,,Менің қожайыным өлімге жол бермейді
Dialogue: 0,0:17:05.12,0:17:07.29,Default,,0,0,0,,Мен Сабырдың қожасын да өлтірмеймін.
Dialogue: 0,0:17:08.00,0:17:11.80,Default,,0,0,0,,Ол да, мен де істің осылай аяқталғанын қаламаймыз.
Dialogue: 0,0:17:12.26,0:17:13.76,Default,,0,0,0,,Армандарыңды ұмытпа
Dialogue: 0,0:17:14.30,0:17:16.80,Default,,0,0,0,,Осы сәтте сені тірі қалдыратын жалғыз нәрсе
Dialogue: 0,0:17:17.34,0:17:20.18,Default,,0,0,0,,Бұл Рыцарь патшасының адалдығына байланысты болды.
Dialogue: 0,0:17:30.98,0:17:32.90,Default,,0,0,0,,Әйел, маған бір сұрақ қой.
Dialogue: 0,0:17:33.19,0:17:37.57,Default,,0,0,0,,Екеуің Кирицугу Эмиияны қорғау үшін осындасыңдар.
Dialogue: 0,0:17:37.95,0:17:40.58,Default,,0,0,0,,Сіз маған қарсы шыққыңыз келген сияқты...
Dialogue: 0,0:17:43.29,0:17:45.29,Default,,0,0,0,,Бұл кімнің ниеті?
Dialogue: 0,0:17:47.37,0:17:49.13,Default,,0,0,0,,Өйткені команда емлесі жоқ
Dialogue: 0,0:17:49.50,0:17:52.25,Default,,0,0,0,,Сіз Эйнцберннің қожайыны емессіз.
Dialogue: 0,0:17:52.38,0:17:56.93,Default,,0,0,0,,Мүмкін, «ыдыстың қамқоршысы» рөлін алған гомункул
Dialogue: 0,0:17:57.38,0:17:59.01,Default,,0,0,0,,Мұндай адам
Dialogue: 0,0:17:59.09,0:18:03.47,Default,,0,0,0,,Мен шайқастың алдыңғы шебіне бару арқылы қателесуім мүмкін емес.
Dialogue: 0,0:18:03.56,0:18:04.93,Default,,0,0,0,,Ахх...
Dialogue: 0,0:18:05.06,0:18:06.73,Default,,0,0,0,,Мен сенен тағы сұрайын, әйел.
Dialogue: 0,0:18:07.52,0:18:11.06,Default,,0,0,0,,Сен кімнің еркі үшін күрестің?
Dialogue: 0,0:18:15.28,0:18:17.61,Default,,0,0,0,,Ух... ку...
Dialogue: 0,0:18:22.45,0:18:23.58,Default,,0,0,0,,Кирей-сама
Dialogue: 0,0:18:24.62,0:18:27.71,Default,,0,0,0,,(Әйел өлтіруші) Кастер мен Лансер және оның қожайыны да.
Dialogue: 0,0:18:27.79,0:18:30.17,Default,,0,0,0,,Бұл орманнан бәріміз бірге қаштық.
Dialogue: 0,0:18:30.67,0:18:32.63,Default,,0,0,0,,Сабер жақында келеді.
Dialogue: 0,0:18:32.92,0:18:36.09,Default,,0,0,0,,Мырзам, бұл жерде қауіпті.
Dialogue: 0,0:18:37.38,0:18:38.13,Default,,0,0,0,,Хун
Dialogue: 0,0:18:39.09,0:18:39.84,Default,,0,0,0,,Уф
Dialogue: 0,0:18:42.43,0:18:44.31,Default,,0,0,0,,Ннннн!
Dialogue: 0,0:18:45.22,0:18:48.23,Default,,0,0,0,,Мен көремін. Бұл шынымен қызыл ма?
Dialogue: 0,0:18:59.82,0:19:01.82,Default,,0,0,0,,Бұл әйелдер мүмкін емес
Dialogue: 0,0:19:02.12,0:19:04.78,Default,,0,0,0,,Мен ешкімнің нұсқауын алған жоқпын.
Dialogue: 0,0:19:04.87,0:19:07.41,Default,,0,0,0,,Сіз жекпе-жекті өз бетіңізше қабылдадыңыз ба?
Dialogue: 0,0:19:09.54,0:19:10.75,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:10.96,0:19:13.96,Default,,0,0,0,,Кирицугу Эмия менімен бірдей
Dialogue: 0,0:19:14.09,0:19:17.05,Default,,0,0,0,,Оны ешкім түсінбейді де, мойындамайды да.
Dialogue: 0,0:19:17.30,0:19:19.30,Default,,0,0,0,,Ол бос адам болса керек...
Dialogue: 0,0:19:21.89,0:19:23.89,Default,,0,0,0,,Солай болуы керек.
Dialogue: 0,0:19:25.85,0:19:26.93,Default,,0,0,0,,​​Iris Feel!
Dialogue: 0,0:19:27.72,0:19:28.85,Default,,0,0,0,,Iris Feel!
Dialogue: 0,0:19:29.18,0:19:30.60,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:19:33.65,0:19:35.65,Default,,0,0,0,,Айтыңыз… бар…
Dialogue: 0,0:19:35.73,0:19:38.28,Default,,0,0,0,,(Сабер) Жоқ! Сау болыңыз!
Dialogue: 0,0:19:38.65,0:19:40.49,Default,,0,0,0,,Мен Кирицугуға дәл қазір қоңырау шаламын.
Dialogue: 0,0:19:40.95,0:19:42.66,Default,,0,0,0,,Мен оған дейін бар күшімді саламын!
Dialogue: 0,0:19:42.99,0:19:44.28,Default,,0,0,0,,Кирей —...
Dialogue: 0,0:19:45.28,0:19:48.24,Default,,0,0,0,,Бұл жерде жау қайда?
Dialogue: 0,0:19:48.33,0:19:49.66,Default,,0,0,0,,Мен қашып құтыла алдым
Dialogue: 0,0:19:50.33,0:19:53.04,Default,,0,0,0,,Мен сәл ертерек кірсем ғой.
Dialogue: 0,0:19:53.17,0:19:55.29,Default,,0,0,0,,Бұлай болмаған нәрселер
Dialogue: 0,0:19:56.38,0:19:58.71,Default,,0,0,0,,Майя... бұл...
Dialogue: 0,0:19:58.84,0:20:00.72,Default,,0,0,0,,Ол да ауыр жарақат алды.
Dialogue: 0,0:20:00.84,0:20:02.43,Default,,0,0,0,,Өмірге қауіп төндіретін жарақаттар жоқ.
Dialogue: 0,0:20:03.01,0:20:04.34,Default,,0,0,0,,Сізге көбірек ұнайды!
Dialogue: 0,0:20:04.68,0:20:06.30,Default,,0,0,0,,Осы мөлшердегі қан жоғалтуымен...
Dialogue: 0,0:20:10.52,0:20:11.68,Default,,0,0,0,,Irisviel?
Dialogue: 0,0:20:12.77,0:20:13.69,Default,,0,0,0,,Uhu…
Dialogue: 0,0:20:17.23,0:20:18.48,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:20:20.03,0:20:21.32,Default,,0,0,0,,Бұл «барлық алыс утопия (Авалон)» болып табылады
Dialogue: 0,0:20:21.40,0:20:22.78,Default,,0,0,0,,Айри оны мен үшін ұстайды.
Dialogue: 0,0:20:23.15,0:20:24.07,Default,,0,0,0,,Е...
Dialogue: 0,0:20:24.20,0:20:28.33,Default,,0,0,0,,Бірақ бұл иесінің жарасын емдейтін Асыл Фантазм.
Dialogue: 0,0:20:28.41,0:20:30.12,Default,,0,0,0,,Керісінше, Кирицугу...
Dialogue: 0,0:20:30.33,0:20:31.16,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:31.87,0:20:33.46,Default,,0,0,0,,Сабер, бастапқы иесі,
Dialogue: 0,0:20:33.58,0:20:36.21,Default,,0,0,0,,Сен менің қасымда болып, маған сиқырлы күш бермесең.
Dialogue: 0,0:20:36.58,0:20:38.63,Default,,0,0,0,,Қаптаманың тиімділігі көрсетілмеген.
Dialogue: 0,0:20:39.25,0:20:41.76,Default,,0,0,0,,Сабермен болашақта кім жұмыс істейді?
Dialogue: 0,0:20:41.88,0:20:43.22,Default,,0,0,0,,Өйткені бұл Айри.
Dialogue: 0,0:20:43.55,0:20:45.18,Default,,0,0,0,,Оны алғаныңыз жақсы.
Dialogue: 0,0:20:45.68,0:20:48.35,Default,,0,0,0,,Оны денеңіздің ішіне концептуалды қару ретінде бекітіңіз.
Dialogue: 0,0:20:49.35,0:20:52.35,Default,,0,0,0,,Сондай-ақ, бұл туралы басқа ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:20:53.06,0:20:54.73,Default,,0,0,0,,Әрине Саберге де.
Dialogue: 0,0:21:00.19,0:21:01.73,Default,,0,0,0,,Біз әдетте соншалықты алдын ала брондамаймыз, сондықтан асығыс емесбіз
Dialogue: 0,0:21:02.65,0:21:04.95,Default,,0,0,0,,Маған қол тигізген сәттен бастап
Dialogue: 0,0:21:05.07,0:21:07.07,Default,,0,0,0,,Мен «барлық алыс утопияның (Авалон)» күшін сезіндім.
Dialogue: 0,0:21:08.07,0:21:10.24,Default,,0,0,0,,Рахмет Сабер
Dialogue: 0,0:21:13.87,0:21:15.29,Default,,0,0,0,,Кирей Котомине
Dialogue: 0,0:21:16.29,0:21:18.42,Default,,0,0,0,,Бұл агент қауіпті.
Dialogue: 0,0:21:18.63,0:21:22.30,Default,,0,0,0,,Сіз елестете алатындай, одан да көп.
Dialogue: 0,0:21:23.21,0:21:27.30,Default,,0,0,0,,Бүгін менің жолым болды, бірақ одан әрі не болатынын білмеймін.
Dialogue: 0,0:21:27.76,0:21:29.47,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:21:29.60,0:21:32.77,Default,,0,0,0,,Тек оған Кирицугумен кездесуге мүмкіндік бермеңіз.
Dialogue: 0,0:21:34.68,0:21:35.60,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:36.27,0:21:39.44,Default,,0,0,0,,Кирицугуны қорғайтын жалғыз мен емес.
Dialogue: 0,0:21:40.27,0:21:42.78,Default,,0,0,0,,Солай емес пе? Майя-сан
Dialogue: 0,0:21:44.78,0:21:46.99,Default,,0,0,0,,Келесі жолы мен міндетті түрде жеңемін
Dialogue: 0,0:21:48.45,0:21:51.78,Default,,0,0,0,,Кирицугуны бірге қорғайық.
Dialogue: 0,0:21:56.96,0:22:02.96,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:19.21,0:23:25.21,Default,,0,0,0,,~♪
Dialogue: 0,0:23:27.63,0:23:29.80,Default,,0,0,0,,Өйткені, менің қожайыным
Dialogue: 0,0:23:29.88,0:23:31.63,Default,,0,0,0,,Ол өлтірілгелі тұр.
Dialogue: 0,0:23:31.72,0:23:34.01,Default,,0,0,0,,(Токиоми) Ар-намыс тіпті шайқаста қажет.
Dialogue: 0,0:23:34.14,0:23:36.47,Default,,0,0,0,,Мен бұл ұсынысты қабылдай алмаймын.
Dialogue: 0,0:23:36.56,0:23:38.68,Default,,0,0,0,,Өтінемін, маған осы бұйрықтың сиқырын тапсырыңыз.
Dialogue: 0,0:23:38.77,0:23:41.89,Default,,0,0,0,,Лансердің жолы онша емес.
Dialogue: 0,0:23:43.39,0:23:48.39,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
