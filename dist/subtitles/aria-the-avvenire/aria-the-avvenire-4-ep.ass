Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.53,0:01:38.83,Default,,0,0,0,,Амансың ба, президент Ария?
Dialogue: 0,0:01:40.20,0:01:42.91,Default,,0,0,0,,Құстармен дос болу стратегиясы
Dialogue: 0,0:01:43.79,0:01:45.83,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:01:47.63,0:01:50.55,Default,,0,0,0,,Берілмеңіз, барымызды салайық, Президент Ария
Dialogue: 0,0:01:51.13,0:01:52.84,Default,,0,0,0,,Сенсең, ғажайып.
Dialogue: 0,0:01:53.14,0:01:57.93,Default,,0,0,0,,Мен де мүмкіндігінше тезірек Примаундин болу үшін бар күшімді салуым керек.
Dialogue: 0,0:01:57.93,0:01:59.93,Default,,0,0,0,,Енді жаттығу, жаттығу
Dialogue: 0,0:02:00.88,0:02:02.68,Default,,0,0,0,,Ай Чан, сен қатты толқыдың.
Dialogue: 0,0:02:02.99,0:02:06.40,Default,,0,0,0,,Иә, Синглаға көтерілгеннен кейін.
Dialogue: 0,0:02:06.40,0:02:08.36,Default,,0,0,0,,Мен қатты толқып тұрмын
Dialogue: 0,0:02:09.73,0:02:12.40,Default,,0,0,0,,Енді бүгінгі жаттығуды бастайық.
Dialogue: 0,0:02:12.70,0:02:14.00,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:02:14.57,0:02:15.28,Default,,0,0,0,,Иә
Dialogue: 0,0:02:24.47,0:02:27.30,Default,,0,0,0,,Аква су планетасындағы Нео Венеция
Dialogue: 0,0:02:28.42,0:02:32.26,Default,,0,0,0,,Бұл жер бір кездері Венеция қаласының мекені болған.
Dialogue: 0,0:02:32.26,0:02:34.71,Default,,0,0,0,,Қала ауыстырылды және сол қалпында қайта құрылды
Dialogue: 0,0:02:36.47,0:02:39.02,Default,,0,0,0,,Жаңа мен ескінің араласуы
Dialogue: 0,0:02:39.76,0:02:41.68,Default,,0,0,0,,Уақыт баяу өтеді
Dialogue: 0,0:02:42.22,0:02:44.56,Default,,0,0,0,,Кейде оғаш нәрселерге тап болатын қала
Dialogue: 0,0:02:47.01,0:02:51.06,Default,,0,0,0,,Сізге гондолада осы қаланы айналып өту үшін
Dialogue: 0,0:02:51.69,0:02:55.24,Default,,0,0,0,,Біз Undines деп аталатын ұшқышпыз.
Dialogue: 0,0:02:56.69,0:02:58.74,Default,,0,0,0,,Менің Aria компаниясында
Dialogue: 0,0:02:58.74,0:03:00.82,Default,,0,0,0,,Мен, Акари Мизунаши және
Dialogue: 0,0:03:01.04,0:03:04.12,Default,,0,0,0,,Кішім Ай Чан бәріңе жол көрсетеді.
Dialogue: 0,0:03:05.11,0:03:08.25,Default,,0,0,0,,Кәне, бірге тамаша саяхатқа шығайық.
Dialogue: 0,0:05:07.03,0:05:09.08,Default,,0,0,0,,Бұл екеуін кездестіргеніме көп болды.
Dialogue: 0,0:05:10.04,0:05:11.62,Default,,0,0,0,,Алиса да, Айка да
Dialogue: 0,0:05:11.62,0:05:15.00,Default,,0,0,0,,Ол Прима Ундин сияқты өте белсенді.
Dialogue: 0,0:05:15.49,0:05:17.28,Default,,0,0,0,,мысық
Dialogue: 0,0:05:20.04,0:05:22.38,Default,,0,0,0,,Бұл үш адам қалай кездейсоқ кездесті?
Dialogue: 0,0:05:22.59,0:05:24.63,Default,,0,0,0,,Бұл Акваның берген кереметі болса керек.
Dialogue: 0,0:05:25.35,0:05:26.40,Default,,0,0,0,,Керемет?
Dialogue: 0,0:05:31.85,0:05:34.39,Default,,0,0,0,,Алисия белсенді болған кезде
Dialogue: 0,0:05:34.54,0:05:36.61,Default,,0,0,0,,Мен күнде шынымен бос емеспін.
Dialogue: 0,0:05:38.99,0:05:41.44,Default,,0,0,0,,Сәлем, бұл кесте.
Dialogue: 0,0:05:41.87,0:05:43.14,Default,,0,0,0,,Міне, Алисия.
Dialogue: 0,0:05:43.14,0:05:45.70,Default,,0,0,0,,Демалуға уақыт жоқ.
Dialogue: 0,0:05:47.24,0:05:49.45,Default,,0,0,0,,Тезірек толыққанды адам бол
Dialogue: 0,0:05:49.99,0:05:53.33,Default,,0,0,0,,Мен де саған көмектесуім керек.
Dialogue: 0,0:05:58.84,0:06:01.25,Default,,0,0,0,,Сәлем, Акира-сан
Dialogue: 0,0:06:02.23,0:06:03.09,Default,,0,0,0,,Иә
Dialogue: 0,0:06:04.72,0:06:07.72,Default,,0,0,0,,Үйде істейтін ісіңіз болмады ма?
Dialogue: 0,0:06:07.72,0:06:10.68,Default,,0,0,0,,Жоқ, мен кездейсоқ өтіп бара жатырмын.
Dialogue: 0,0:06:10.93,0:06:14.06,Default,,0,0,0,,Мүмкін сенің Алисияға қатысың бар шығар?
Dialogue: 0,0:06:15.92,0:06:17.44,Default,,0,0,0,,Қазіргі
Dialogue: 0,0:06:17.57,0:06:19.86,Default,,0,0,0,,А, мен бүгін көрдім
Dialogue: 0,0:06:22.67,0:06:25.15,Default,,0,0,0,,Иә, бұл Алисияның жасырын туған күні.
Dialogue: 0,0:06:25.70,0:06:28.82,Default,,0,0,0,,Мен оны мүлде байқамадым.
Dialogue: 0,0:06:28.83,0:06:31.74,Default,,0,0,0,,Өйткені Акари-чан Мэнхомадан.
Dialogue: 0,0:06:31.74,0:06:33.04,Default,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,0:06:33.18,0:06:37.12,Default,,0,0,0,,Aqua күнтізбесінде бір жылда 24 ай бар.
Dialogue: 0,0:06:37.12,0:06:40.08,Default,,0,0,0,,Сіз туған күніңізді 12 айдан кейін де тойладыңыз.
Dialogue: 0,0:06:40.20,0:06:42.09,Default,,0,0,0,,Иә, бұл құпия туған күн.
Dialogue: 0,0:06:42.64,0:06:45.88,Default,,0,0,0,,Алисияның туған күні 30 қазан.
Dialogue: 0,0:06:46.51,0:06:49.39,Default,,0,0,0,,Өйткені бүгін 22/30
Dialogue: 0,0:06:49.39,0:06:53.27,Default,,0,0,0,,Басқаша айтқанда, бүгін Алисияның жасырын туған күні!
Dialogue: 0,0:06:53.68,0:06:57.31,Default,,0,0,0,,Сондықтан маған сыйлық беру үшін өз жолыңыздан шығып кеттіңіз.
Dialogue: 0,0:06:57.77,0:07:01.94,Default,,0,0,0,,Жоқ, мен бүгін біраз уақыттан кейін бірінші рет жарты күн демалыс алдым.
Dialogue: 0,0:07:01.94,0:07:04.32,Default,,0,0,0,,Күлкілі жүзбен жұмыс істеп жүрген жігітке.
Dialogue: 0,0:07:04.32,0:07:06.86,Default,,0,0,0,,Мен мұнда сені мазақ етіп, өзін көрсету үшін келдім.
Dialogue: 0,0:07:06.86,0:07:08.07,Default,,0,0,0,,Бұл
Dialogue: 0,0:07:11.05,0:07:14.62,Default,,0,0,0,,Алисия-сан, бүгін сенің соңғы тұтынушың.
Dialogue: 0,0:07:14.95,0:07:18.54,Default,,0,0,0,,Кешкі сағат 18:00-дегі Гондола қауымдастығының жиналысына дейін тегін.
Dialogue: 0,0:07:18.89,0:07:20.75,Default,,0,0,0,,Түсіндім, рахмет
Dialogue: 0,0:07:22.32,0:07:25.05,Default,,0,0,0,,Негізі Афина да келуі керек еді.
Dialogue: 0,0:07:25.86,0:07:27.80,Default,,0,0,0,,Менің шұғыл жұмысым бар сияқты.
Dialogue: 0,0:07:28.11,0:07:29.28,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:07:30.72,0:07:31.40,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:07:35.63,0:07:38.19,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, бұл Aria компаниясы.
Dialogue: 0,0:07:38.80,0:07:39.77,Default,,0,0,0,,Акари-чан
Dialogue: 0,0:07:40.00,0:07:41.65,Default,,0,0,0,,Ах, Алисия.
Dialogue: 0,0:07:42.07,0:07:43.27,Default,,0,0,0,,Кешіріңіз Асай
Dialogue: 0,0:07:43.61,0:07:46.11,Default,,0,0,0,,Бұдан былай, Гондола қауымдастығының қонақтары
Dialogue: 0,0:07:46.11,0:07:48.45,Default,,0,0,0,,Мен саған айнала көрсетуім керек еді.
Dialogue: 0,0:07:49.19,0:07:49.96,Default,,0,0,0,,А, иә
Dialogue: 0,0:07:50.60,0:07:54.33,Default,,0,0,0,,Жиналыс түнде болады, сондықтан мен бүгін үйге қайтайын.
Dialogue: 0,0:07:56.08,0:07:58.79,Default,,0,0,0,,Олай болса, мен тұтынушыны күтемін.
Dialogue: 0,0:08:04.44,0:08:05.11,Default,,0,0,0,,Акира-сан
Dialogue: 0,0:08:05.74,0:08:06.60,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:08:07.86,0:08:10.72,Default,,0,0,0,,Менің де кешкі уақытта үй ішінде жаттығу сабағым бар.
Dialogue: 0,0:08:10.96,0:08:11.92,Default,,0,0,0,,Мен үйге жайлап бара жатырмын
Dialogue: 0,0:08:12.80,0:08:14.72,Default,,0,0,0,,Мен саған сыйлық қалдырамын.
Dialogue: 0,0:08:14.87,0:08:16.56,Default,,0,0,0,,Оны маған ертең беріңіз.
Dialogue: 0,0:08:20.87,0:08:21.60,Default,,0,0,0,,Акира-сан
Dialogue: 0,0:08:23.40,0:08:26.42,Default,,0,0,0,,Осыдан кейін мен өз бетімше жаттығым келеді.
Dialogue: 0,0:08:26.63,0:08:28.40,Default,,0,0,0,,Менімен бірге жүре аласыз ба?
Dialogue: 0,0:08:28.82,0:08:29.78,Default,,0,0,0,,Өз бетінше оқыту?
Dialogue: 0,0:08:30.00,0:08:33.45,Default,,0,0,0,,Иә, әсіресе Алисия жиі қолданатын курстар.
Dialogue: 0,0:08:39.67,0:08:42.87,Default,,0,0,0,,Мен сізге айтамын, менің басшылығым қатаң.
Dialogue: 0,0:08:43.57,0:08:45.55,Default,,0,0,0,,А, иә
Dialogue: 0,0:08:45.63,0:08:47.21,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:09:28.39,0:09:30.17,Default,,0,0,0,,Рахмет, Акари-чан
Dialogue: 0,0:09:30.48,0:09:31.63,Default,,0,0,0,,Біз қайтеміз?
Dialogue: 0,0:09:32.95,0:09:33.64,Default,,0,0,0,,Иә
Dialogue: 0,0:09:37.98,0:09:42.46,Default,,0,0,0,,Негізі бүгін саған сыйлық бергім келмеді.
Dialogue: 0,0:09:45.56,0:09:48.15,Default,,0,0,0,,Біз Сингладан бері біргеміз.
Dialogue: 0,0:09:48.51,0:09:51.32,Default,,0,0,0,,Еңбек етіп, прима бол
Dialogue: 0,0:09:51.68,0:09:54.86,Default,,0,0,0,,Олар үш ірі су перілері деп аталды.
Dialogue: 0,0:09:55.69,0:09:58.66,Default,,0,0,0,,Бірақ үшеуміз кездесеміз.
Dialogue: 0,0:09:58.66,0:10:01.58,Default,,0,0,0,,Бұрын әлдеқайда қиын болатын нәрселер.
Dialogue: 0,0:10:02.46,0:10:05.75,Default,,0,0,0,,Сондықтан мен көп ойлаймын
Dialogue: 0,0:10:06.25,0:10:10.80,Default,,0,0,0,,Үшеуміз бірге кездесетін уақыт өте маңызды.
Dialogue: 0,0:10:11.66,0:10:15.22,Default,,0,0,0,,Ол күндерге қайта оралғым келмейді.
Dialogue: 0,0:10:15.68,0:10:17.30,Default,,0,0,0,,Неге деп ойлаймын
Dialogue: 0,0:10:17.60,0:10:19.22,Default,,0,0,0,,Мен бүгін көмектесе алмаймын
Dialogue: 0,0:10:19.22,0:10:21.60,Default,,0,0,0,,Мен үшеуміз кездескіміз келгендей болды.
Dialogue: 0,0:10:25.68,0:10:27.94,Default,,0,0,0,,Аа, өте аянышты.
Dialogue: 0,0:10:28.72,0:10:30.73,Default,,0,0,0,,Ол кішкентай қыз емес.
Dialogue: 0,0:10:34.53,0:10:36.40,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:10:37.15,0:10:37.53,Default,,0,0,0,,Ах
Dialogue: 0,0:10:46.23,0:10:46.88,Default,,0,0,0,,Алисия
Dialogue: 0,0:11:21.66,0:11:23.04,Default,,0,0,0,,Афина
Dialogue: 0,0:11:34.55,0:11:39.47,Default,,0,0,0,,Құрметті қауымдастық мүшелері, бұл Химеядан келген Акира Э.Феррари.
Dialogue: 0,0:11:39.63,0:11:42.68,Default,,0,0,0,,Бір сәт дөрекілігім үшін кешіріңіз.
Dialogue: 0,0:11:44.14,0:11:46.31,Default,,0,0,0,,Ал, Алисия.
Dialogue: 0,0:12:05.85,0:12:06.40,Default,,0,0,0,,Акира-сан
Dialogue: 0,0:12:20.80,0:12:23.51,Default,,0,0,0,,Туған күніңмен, Алисия
Dialogue: 0,0:12:37.58,0:12:40.74,Default,,0,0,0,,Рахмет, бәрі Акари-чанның арқасында.
Dialogue: 0,0:12:41.24,0:12:41.78,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:43.60,0:12:44.99,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:12:45.64,0:12:47.66,Default,,0,0,0,,Бұл керемет, Акира-сан.
Dialogue: 0,0:12:50.05,0:12:50.76,Default,,0,0,0,,Мен бұған ешқашан жол бере алмаймын.
Dialogue: 0,0:12:51.92,0:12:54.05,Default,,0,0,0,,Сіз асыра айтып отырсыз, Акари-чан.
Dialogue: 0,0:12:54.42,0:12:56.08,Default,,0,0,0,,...
Dialogue: 0,0:12:57.42,0:13:00.26,Default,,0,0,0,,Бірақ бұл шынымен де ғажайып.
Dialogue: 0,0:13:04.76,0:13:10.06,Default,,0,0,0,,Осыны айтып, Акира-сан, Алисия-сан және Афина-сан күлді.
Dialogue: 0,0:13:10.16,0:13:14.65,Default,,0,0,0,,Сол кездегі күлкің кішкентай қыздың күлкісіндей еді.
Dialogue: 0,0:13:19.19,0:13:21.90,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:13:22.20,0:13:22.69,Default,,0,0,0,,Иә
Dialogue: 0,0:13:24.37,0:13:25.57,Default,,0,0,0,,Мен де
Dialogue: 0,0:13:26.32,0:13:27.62,Default,,0,0,0,,Мен де бір күні
Dialogue: 0,0:13:27.62,0:13:30.62,Default,,0,0,0,,Акира-сан мен Афина-сан Алисия-санмен
Dialogue: 0,0:13:30.62,0:13:33.41,Default,,0,0,0,,Айка мен Алиса Акариге ұқсайды.
Dialogue: 0,0:13:33.41,0:13:36.08,Default,,0,0,0,,Мен біреуді кездестірсем деп едім
Dialogue: 0,0:13:36.41,0:13:39.71,Default,,0,0,0,,Хехе, мен де Ай Чанмен кездесетінімізге сенімдімін.
Dialogue: 0,0:13:41.46,0:13:46.55,Default,,0,0,0,,Себебі мен ғажайыптарға толы Аква планетасына келдім.
Dialogue: 0,0:13:48.45,0:13:48.98,Default,,0,0,0,,Иә
Dialogue: 0,0:13:55.03,0:13:57.90,Default,,0,0,0,,Біреумен кездескіңіз келсе кездесе білу
Dialogue: 0,0:13:58.19,0:14:00.82,Default,,0,0,0,,Даусыңды естігің келген кезде ести білу
Dialogue: 0,0:14:01.69,0:14:03.99,Default,,0,0,0,,Кейде бұл ештеңе емес деп ойлайсың
Dialogue: 0,0:14:04.08,0:14:07.37,Default,,0,0,0,,Бұл шын мәнінде үлкен ғажайып болуы мүмкін.
Dialogue: 0,0:14:08.01,0:14:11.60,Default,,0,0,0,,Дәл қазір мен Ай Чанмен біргемін.
