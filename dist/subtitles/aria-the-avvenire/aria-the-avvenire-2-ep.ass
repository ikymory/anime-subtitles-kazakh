Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.16,0:01:17.14,Default,,0,0,0,,♬～
Dialogue: 0,0:01:17.14,0:01:19.11,Default,,0,0,0,,Пуи
Dialogue: 0,0:01:23.15,0:01:26.15,Default,,0,0,0,,Пуи Пуи Ча Пуй Ня
Dialogue: 0,0:01:26.15,0:01:32.16,Default,,0,0,0,,Мияу Пуинья Пуинья
Dialogue: 0,0:01:32.16,0:01:34.16,Default,,0,0,0,,Уау! Уау
Dialogue: 0,0:01:34.16,0:01:36.16,Default,,0,0,0,,Пуи... Пуи
Dialogue: 0,0:01:36.16,0:01:39.16,Default,,0,0,0,,Амансың ба? Ария президенті
Dialogue: 0,0:01:39.16,0:01:43.10,Default,,0,0,0,,Пуи: Құстармен дос болу стратегиясы➡
Dialogue: 0,0:01:43.10,0:01:46.10,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:01:46.10,0:01:48.11,Default,,0,0,0,,Пуи…
Dialogue: 0,0:01:48.11,0:01:51.11,Default,,0,0,0,,Президент Ариядан бас тартпай, қолдан келгеннің бәрін жасайық
Dialogue: 0,0:01:51.11,0:01:53.11,Default,,0,0,0,,Егер сенсеңіз, бұл «Миракуру»
Dialogue: 0,0:01:53.11,0:01:56.11,Default,,0,0,0,,Мен мүмкіндігінше тезірек Прима Ундин бола аламын деп үміттенемін➡
Dialogue: 0,0:01:56.11,0:01:58.12,Default,,0,0,0,,Мен бар күшімді салуым керек
Dialogue: 0,0:01:58.12,0:02:01.12,Default,,0,0,0,,Енді жаттығуды орындаңыз
Dialogue: 0,0:02:01.12,0:02:03.12,Default,,0,0,0,,Ай Чан, сен қатты толқыдың.
Dialogue: 0,0:02:03.12,0:02:06.12,Default,,0,0,0,,Иә, жалғыздыққа көтерілгеннен кейін➡
Dialogue: 0,0:02:06.12,0:02:09.13,Default,,0,0,0,,Мен қатты толқып тұрмын
Dialogue: 0,0:02:09.13,0:02:12.13,Default,,0,0,0,,Енді бүгінгі жаттығуды бастайық.
Dialogue: 0,0:02:12.13,0:02:14.13,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:02:14.13,0:02:17.10,Default,,0,0,0,,Иә
Dialogue: 0,0:02:24.14,0:02:28.15,Default,,0,0,0,,<Аква су планетасындағы Нео Венеция>
Dialogue: 0,0:02:28.15,0:02:31.15,Default,,0,0,0,,<Бұл жер бұрын ерлердің үйі болған➡
Dialogue: 0,0:02:31.15,0:02:36.15,Default,,0,0,0,,Венециядағыдай көшірілген және қайта құрылған қала＞
Dialogue: 0,0:02:36.15,0:02:40.16,Default,,0,0,0,,<Жаңа және ескі қоспа➡
Dialogue: 0,0:02:40.16,0:02:45.13,Default,,0,0,0,,Уақыт баяу өтіп, кейде таңғажайыпқа тап болатын қала>
Dialogue: 0,0:02:47.10,0:02:51.10,Default,,0,0,0,,＜Және сізге гондолада осы қаланы айналып өту үшін➡
Dialogue: 0,0:02:51.10,0:02:56.11,Default,,0,0,0,,Біз Undine деп аталатын ұшқышпыз＞
Dialogue: 0,0:02:56.11,0:02:59.11,Default,,0,0,0,,<Біздің ARIA компаниясында➡
Dialogue: 0,0:02:59.11,0:03:05.12,Default,,0,0,0,,Мен, Акари Мизунаши және менің кіші қызым Ай Чан саған айналаны көрсетемін.＞
Dialogue: 0,0:03:05.12,0:03:09.12,Default,,0,0,0,,<Бірге тамаша саяхат жасайық>
Dialogue: 0,0:03:09.12,0:04:59.06,Default,,0,0,0,,♬～
Dialogue: 0,0:05:07.10,0:05:10.11,Default,,0,0,0,,Бұл екеуін кездестіргеніме көп болды.
Dialogue: 0,0:05:10.11,0:05:13.11,Default,,0,0,0,,Прима Ундин рөліндегі Элис пен Айка➡
Dialogue: 0,0:05:13.11,0:05:15.11,Default,,0,0,0,,Сіз тамаша жұмыс істеп жатырсыз.
Dialogue: 0,0:05:15.11,0:05:17.11,Default,,0,0,0,,А, бұл мысық!
Dialogue: 0,0:05:17.11,0:05:20.12,Default,,0,0,0,,Funnyupui (Қыз) Өте сүйкімді!
Dialogue: 0,0:05:20.12,0:05:22.12,Default,,0,0,0,,Бұл үш адам қалай кездейсоқ кездесті?
Dialogue: 0,0:05:22.12,0:05:25.12,Default,,0,0,0,,Мен бұл Акваның маған берген кереметі екеніне сенімдімін.
Dialogue: 0,0:05:25.12,0:05:28.09,Default,,0,0,0,,«Миракуру» иә...
Dialogue: 0,0:05:32.13,0:05:34.13,Default,,0,0,0,,Алисия белсенді болған кезде➡
Dialogue: 0,0:05:34.13,0:05:38.10,Default,,0,0,0,,Мен күн сайын бос емеспін...
Dialogue: 0,0:05:39.14,0:05:42.07,Default,,0,0,0,,｟Хахи… Бұл кесте｠
Dialogue: 0,0:05:42.07,0:05:45.08,Default,,0,0,0,,｟Мұнымен, Алисия-сан, сенің демалуға уақытың болмайды.
Dialogue: 0,0:05:45.08,0:05:47.08,Default,,0,0,0,,｟Пуи｠
Dialogue: 0,0:05:47.08,0:05:50.08,Default,,0,0,0,,｟Тез толыққанды тұлғаға айналу➡
Dialogue: 0,0:05:50.08,0:05:54.05,Default,,0,0,0,,Мен де саған көмектесуім керек.
Dialogue: 0,0:05:55.09,0:05:58.05,Default,,0,0,0,,｟Ах｠ ｟Пуи｠
Dialogue: 0,0:05:59.09,0:06:01.06,Default,,0,0,0,,｟ Сәлем Акира-сан｠
Dialogue: 0,0:06:02.09,0:06:04.06,Default,,0,0,0,,｟Иә...｠
Dialogue: 0,0:06:05.10,0:06:08.10,Default,,0,0,0,,｟Үйде істеу керек нәрсе жоқ па? ｠
Dialogue: 0,0:06:08.10,0:06:11.10,Default,,0,0,0,,｟Жоқ, мен кездейсоқ өтіп бара жатырмын｠
Dialogue: 0,0:06:11.10,0:06:14.10,Default,,0,0,0,,｟Мүмкін сенің Алисияға қатысың бар шығар? ｠
Dialogue: 0,0:06:14.10,0:06:16.11,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:06:16.11,0:06:21.08,Default,,0,0,0,,｟Бүгін Ах, түсіндім. Бүгін...｠
Dialogue: 0,0:06:23.11,0:06:26.12,Default,,0,0,0,,｟Иә, бұл Алисияның жасырын туған күні｠
Dialogue: 0,0:06:26.12,0:06:29.12,Default,,0,0,0,,｟Мен оны мүлде байқамадым｠
Dialogue: 0,0:06:29.12,0:06:31.12,Default,,0,0,0,,｟Себебі Акари-чан Мэнхомадан.｠
Dialogue: 0,0:06:31.12,0:06:33.12,Default,,0,0,0,,｟Менің таңдауым жоқ｠
Dialogue: 0,0:06:33.12,0:06:37.13,Default,,0,0,0,,｟Aqua күнтізбесінде бір жылда 24 ай бар➡
Dialogue: 0,0:06:37.13,0:06:40.13,Default,,0,0,0,,Сіз туған күніңізді 12 айдан кейін де тойладыңыз｠
Dialogue: 0,0:06:40.13,0:06:43.07,Default,,0,0,0,,｟Иә, бұл құпия туған күн｠
Dialogue: 0,0:06:43.07,0:06:46.07,Default,,0,0,0,,｟Алисияның туған күні 30 қазан➡
Dialogue: 0,0:06:46.07,0:06:50.07,Default,,0,0,0,,Өйткені бүгін 30 желтоқсан...｠
Dialogue: 0,0:06:50.07,0:06:54.08,Default,,0,0,0,,｟Сонымен бүгін Алисияның жасырын туған күні｠
Dialogue: 0,0:06:54.08,0:06:57.08,Default,,0,0,0,,｟Сондықтан маған сыйлық беруге келдіңіз｠
Dialogue: 0,0:06:57.08,0:07:02.09,Default,,0,0,0,,｟Аа, жоқ...Мен бүгін біраз уақыттан кейін бірінші рет жарты күн демалыс алдым➡
Dialogue: 0,0:07:02.09,0:07:04.09,Default,,0,0,0,,Мұңды жүзбен жұмыс істейтін сол жігітке➡
Dialogue: 0,0:07:04.09,0:07:09.06,Default,,0,0,0,,Айтпақшы, мен мұнда жай ғана өзімді көрсету үшін келдім...
Dialogue: 0,0:07:11.09,0:07:15.10,Default,,0,0,0,,｟Алисия-сан, бүгінгі тұтынушы соңғысы➡
Dialogue: 0,0:07:15.10,0:07:19.10,Default,,0,0,0,,Кешкі сағат 18:00-дегі Гондола қауымдастығының жиналысына дейін тегін.
Dialogue: 0,0:07:19.10,0:07:22.11,Default,,0,0,0,,｟Түсіндім, рахмет｠
Dialogue: 0,0:07:22.11,0:07:26.11,Default,,0,0,0,,｟Негізі Афина да келуі керек еді➡
Dialogue: 0,0:07:26.11,0:07:30.11,Default,,0,0,0,,Сізге шұғыл жұмыс бар сияқты.｠ Солай ма?｠
Dialogue: 0,0:07:30.11,0:07:35.12,Default,,0,0,0,,☎(рингтон) ｜Иә Иә｠
Dialogue: 0,0:07:35.12,0:07:39.12,Default,,0,0,0,,｟Күткеніңізге рахмет. Бұл ARIA компаниясы｠
Dialogue: 0,0:07:39.12,0:07:42.06,Default,,0,0,0,,☎｟ Акари-чан? ｠ ｟ Ах, Алисия-сан｠
Dialogue: 0,0:07:42.06,0:07:46.06,Default,,0,0,0,,☎｟Кешіріңіз. Енді мен гондола қауымдастығының қонақтарымен сөйлесетін боламын.➡
Dialogue: 0,0:07:46.06,0:07:48.06,Default,,0,0,0,,Мен саған айналаны көрсетуім керек.
Dialogue: 0,0:07:48.06,0:07:50.07,Default,,0,0,0,,｟Иә｠
Dialogue: 0,0:07:50.07,0:07:54.07,Default,,0,0,0,,☎｟Кездесу кеш болады, сондықтан мен бүгін үйге барамын.
Dialogue: 0,0:07:54.07,0:07:56.07,Default,,0,0,0,,｟Ух｠ ｟Аа…｠
Dialogue: 0,0:07:56.07,0:07:59.08,Default,,0,0,0,,☎｟Сонда сіз тұтынушыны күтесіз｠
Dialogue: 0,0:07:59.08,0:08:01.04,Default,,0,0,0,,｟Иә…｠
Dialogue: 0,0:08:04.08,0:08:06.08,Default,,0,0,0,,｟Акира-сан…｠
Dialogue: 0,0:08:06.08,0:08:08.08,Default,,0,0,0,,｟Қазір...｠ ｟Пуй? ｠
Dialogue: 0,0:08:08.08,0:08:11.09,Default,,0,0,0,,｟Менде кешкі уақытта үйдегі тренинг бар➡
Dialogue: 0,0:08:11.09,0:08:13.09,Default,,0,0,0,,Мен үйге асығыс бара жатырмын｠
Dialogue: 0,0:08:13.09,0:08:17.06,Default,,0,0,0,,｟Мен саған сыйлық қалдырамын, ертең оны маған бер.｠
Dialogue: 0,0:08:18.09,0:08:20.06,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:08:21.10,0:08:23.10,Default,,0,0,0,,｟Акира-сан｠ ｟Мм? ｠
Dialogue: 0,0:08:23.10,0:08:26.10,Default,,0,0,0,,｟Осыдан кейін өз бетімше жаттығым келеді➡
Dialogue: 0,0:08:26.10,0:08:29.11,Default,,0,0,0,,Менімен бірге бола аласыз ба? ｠
Dialogue: 0,0:08:29.11,0:08:31.11,Default,,0,0,0,,｟Өз бетінше оқыту? ｠ ｟Иә｠
Dialogue: 0,0:08:31.11,0:08:34.11,Default,,0,0,0,,｟Әсіресе Алисия жиі қолданатын курстар｠
Dialogue: 0,0:08:34.11,0:08:36.08,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:08:38.11,0:08:44.09,Default,,0,0,0,,｟Ух, менің басшылығым қатаң екенін айтуым керек｠
Dialogue: 0,0:08:45.05,0:08:48.06,Default,,0,0,0,,｟Иә, көп рахмет｠
Dialogue: 0,0:08:48.06,0:09:28.10,Default,,0,0,0,,♬～
Dialogue: 0,0:09:28.10,0:09:30.10,Default,,0,0,0,,｟ Рахмет сізге Акари-чан｠
Dialogue: 0,0:09:30.10,0:09:33.10,Default,,0,0,0,,｟Қайтамыз ба?｠
Dialogue: 0,0:09:33.10,0:09:35.07,Default,,0,0,0,,｟Иә…｠
Dialogue: 0,0:09:38.11,0:09:43.11,Default,,0,0,0,,｟Шындығында бүгінгі күннің мақсаты сізге сыйлық беру емес｠
Dialogue: 0,0:09:43.11,0:09:45.08,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:09:46.12,0:09:48.12,Default,,0,0,0,,｟Біз бойдақ кезімізден біргеміз➡
Dialogue: 0,0:09:48.12,0:09:51.12,Default,,0,0,0,,Еңбек етіп, прима бол➡
Dialogue: 0,0:09:51.12,0:09:55.13,Default,,0,0,0,,Олар үш ұлы су перісі деп аталды...｠
Dialogue: 0,0:09:55.13,0:09:59.13,Default,,0,0,0,,｟Бірақ үшеуміз кездесеміз➡
Dialogue: 0,0:09:59.13,0:10:02.13,Default,,0,0,0,,Бұл қиынға соққан жалғыз нәрсе.
Dialogue: 0,0:10:02.13,0:10:06.14,Default,,0,0,0,,｟Сондықтан мен көп ойлаймын｠
Dialogue: 0,0:10:06.14,0:10:11.14,Default,,0,0,0,,｜Үшеуміз бірге кездесетін уақыт өте маңызды｠
Dialogue: 0,0:10:11.14,0:10:15.14,Default,,0,0,0,,｟Ол күндерге қайта оралғым келмейді.
Dialogue: 0,0:10:15.14,0:10:22.12,Default,,0,0,0,,｟Неге екені белгісіз, мен бүгін үшеуміз кездескіміз келетін сияқты болдым.｠
Dialogue: 0,0:10:25.15,0:10:29.16,Default,,0,0,0,,｟Аа, өте аянышты｠
Dialogue: 0,0:10:29.16,0:10:32.13,Default,,0,0,0,,｟Кішкентай қызға бұл жеткіліксіз｠
Dialogue: 0,0:10:34.16,0:10:37.17,Default,,0,0,0,,｟А, а, а...! ｠
Dialogue: 0,0:10:37.17,0:10:39.14,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:10:46.11,0:10:48.08,Default,,0,0,0,,｟Алисия｠
Dialogue: 0,0:10:51.11,0:10:53.08,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:10:56.12,0:10:58.12,Default,,0,0,0,,♪ (Афинаның ән салған дауысы)
Dialogue: 0,0:10:58.12,0:11:01.12,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:11:01.12,0:11:04.13,Default,,0,0,0,,♪ (Афинаның ән салған дауысы)
Dialogue: 0,0:11:04.13,0:11:06.13,Default,,0,0,0,,｟Ха…｠
Dialogue: 0,0:11:06.13,0:11:11.13,Default,,0,0,0,,♪ (Афинаның ән салған дауысы)
Dialogue: 0,0:11:11.13,0:11:21.14,Default,,0,0,0,,♪～
Dialogue: 0,0:11:21.14,0:11:24.15,Default,,0,0,0,,｟Афина｠
Dialogue: 0,0:11:24.15,0:11:26.12,Default,,0,0,0,,｟Пуи Пуи Жаңа｠
Dialogue: 0,0:11:31.15,0:11:34.16,Default,,0,0,0,,｟｠ ｟｠
Dialogue: 0,0:11:34.16,0:11:40.16,Default,,0,0,0,,｟Құрметті қауымдастық мүшелері, бұл Химейядан келген Акира Э.Феррари｠
Dialogue: 0,0:11:40.16,0:11:44.10,Default,,0,0,0,,｟Бір сәт дөрекілігім үшін кешіріңіз｠
Dialogue: 0,0:11:44.10,0:11:47.07,Default,,0,0,0,,｟Ал, Алисия! ｠
Dialogue: 0,0:11:48.10,0:11:51.11,Default,,0,0,0,,｟Пуи... Пуи Ня｠ ｟Уау｠
Dialogue: 0,0:11:51.11,0:12:01.12,Default,,0,0,0,,♪～
Dialogue: 0,0:12:01.12,0:12:04.12,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:12:04.12,0:12:06.12,Default,,0,0,0,,｟Уф…｠
Dialogue: 0,0:12:06.12,0:12:08.12,Default,,0,0,0,,｟Акира-сан｠ ｟Пуиню｠
Dialogue: 0,0:12:08.12,0:12:19.10,Default,,0,0,0,,♪～
Dialogue: 0,0:12:21.14,0:12:23.14,Default,,0,0,0,,｟Туған күніңмен Алисия! ｠
Dialogue: 0,0:12:23.14,0:12:26.14,Default,,0,0,0,,｟Пуи Пуи Жаңа｠
Dialogue: 0,0:12:26.14,0:12:28.11,Default,,0,0,0,,｟Хехе｠
Dialogue: 0,0:12:29.15,0:12:33.15,Default,,0,0,0,,｟Пуи Пуи Пуи Чар｠
Dialogue: 0,0:12:33.15,0:12:37.15,Default,,0,0,0,,♪～
Dialogue: 0,0:12:37.15,0:12:41.09,Default,,0,0,0,,｟Рахмет, Акари-чанға рахмет｠
Dialogue: 0,0:12:41.09,0:12:43.09,Default,,0,0,0,,｟Жоқ｠
Dialogue: 0,0:12:43.09,0:12:46.10,Default,,0,0,0,,｟Бұл «Миракуру»｠
Dialogue: 0,0:12:46.10,0:12:49.10,Default,,0,0,0,,｟Ғажайып Акира-сан｠
Dialogue: 0,0:12:49.10,0:12:52.10,Default,,0,0,0,,｟Ух хахаха｠
Dialogue: 0,0:12:52.10,0:12:57.11,Default,,0,0,0,,｟Бұл артық айтқандық Акари-чан｠ ｟Ха... Иә｠
Dialogue: 0,0:12:57.11,0:13:01.08,Default,,0,0,0,,｟Бірақ бұл шынымен де ғажайып｠
Dialogue: 0,0:13:05.11,0:13:10.12,Default,,0,0,0,,Акира-сан, Алисия-сан және Афина-сан мұны айтқан соң күлді➡
Dialogue: 0,0:13:10.12,0:13:15.09,Default,,0,0,0,,Сол кездегі күлкің кішкентай қыздың күлкісі сияқты еді.
Dialogue: 0,0:13:19.13,0:13:22.13,Default,,0,0,0,,Жақсы нәрсе
Dialogue: 0,0:13:22.13,0:13:24.13,Default,,0,0,0,,Иә
Dialogue: 0,0:13:24.13,0:13:27.14,Default,,0,0,0,,Мен де... Мен де бір күні➡
Dialogue: 0,0:13:27.14,0:13:30.14,Default,,0,0,0,,Акира мен Афина Алисия үшін➡
Dialogue: 0,0:13:30.14,0:13:33.14,Default,,0,0,0,,Айка мен Алиса сияқты Акари➡
Dialogue: 0,0:13:33.14,0:13:36.15,Default,,0,0,0,,Мен біреуді кездестірсем жақсы болар еді
Dialogue: 0,0:13:36.15,0:13:40.15,Default,,0,0,0,,Иә, мен де Ай Чанмен кездесетінімізге сенімдімін.
Dialogue: 0,0:13:40.15,0:13:42.09,Default,,0,0,0,,Пунья
Dialogue: 0,0:13:42.09,0:13:44.09,Default,,0,0,0,,Өйткені бұл «миракуру» оларға толы жұлдыз➡
Dialogue: 0,0:13:44.09,0:13:47.06,Default,,0,0,0,,Себебі мен Акваға келдім
Dialogue: 0,0:13:48.09,0:13:50.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:55.10,0:13:58.10,Default,,0,0,0,,<Біреуді көргің келсе кездесе алу>
Dialogue: 0,0:13:58.10,0:14:01.10,Default,,0,0,0,,<Даусыңды естігің келген кезде ести білу>
Dialogue: 0,0:14:01.10,0:14:04.11,Default,,0,0,0,,<Кейде бұл ештеңе емес деп ойлайсың➡
Dialogue: 0,0:14:04.11,0:14:08.11,Default,,0,0,0,,Бұл шынымен таңғажайып «Миракуру» болуы мүмкін
Dialogue: 0,0:14:08.11,0:14:13.08,Default,,0,0,0,,<Қазір мен Ай Чанмен осылаймын>
Dialogue: 0,0:14:27.13,0:14:29.13,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:14:29.13,0:14:32.14,Default,,0,0,0,,Хмм, қанағаттандым! (Әйел) Гондола - ең жақсы!
Dialogue: 0,0:14:32.14,0:14:35.14,Default,,0,0,0,,Акари-сан! Пуину Пуи
Dialogue: 0,0:14:35.14,0:14:37.14,Default,,0,0,0,,Бұл қиын! Бұл Миракуру!
Dialogue: 0,0:14:37.14,0:14:40.14,Default,,0,0,0,,Ай-чан Тұтынушы... (Әйел) Ммм?
Dialogue: 0,0:14:40.14,0:14:42.08,Default,,0,0,0,,Ах, кешіріңіз, Бейшара.
Dialogue: 0,0:14:42.08,0:14:45.08,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Маған қол ұшын беріңіз.
Dialogue: 0,0:14:45.08,0:14:48.08,Default,,0,0,0,,Рахмет, керемет нәрсе болды.
Dialogue: 0,0:14:48.08,0:14:50.09,Default,,0,0,0,,Иә! Өте
Dialogue: 0,0:14:50.09,0:14:52.09,Default,,0,0,0,,Бұл қала Ғажайыптарға толы.
Dialogue: 0,0:14:52.09,0:14:54.09,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,0:14:54.09,0:14:57.09,Default,,0,0,0,,Біз «Миракурумен» де таныстық.
Dialogue: 0,0:14:57.09,0:15:00.10,Default,,0,0,0,,Сол үшін мен ертең шамам келгенше жүремін.
Dialogue: 0,0:15:00.10,0:15:02.10,Default,,0,0,0,,Бұл жақсы нәрсе, хехе
Dialogue: 0,0:15:02.10,0:15:04.10,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:04.10,0:15:06.10,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:06.10,0:15:10.11,Default,,0,0,0,,Қай жерде тамақтану керек? (Әйел) Мен Китараны жегім келеді.
Dialogue: 0,0:15:10.11,0:15:14.11,Default,,0,0,0,,Әй, жақсы, тамаша, Ай Чанның «Миракуру» деген не?
Dialogue: 0,0:15:14.11,0:15:16.11,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:15:16.11,0:15:19.12,Default,,0,0,0,,Тыңдашы, Акари-сан, бұл керемет.
Dialogue: 0,0:15:19.12,0:15:21.12,Default,,0,0,0,,Таңғажайып нәрсе болды.
Dialogue: 0,0:15:21.12,0:15:23.12,Default,,0,0,0,,Не?
Dialogue: 0,0:15:23.12,0:15:25.12,Default,,0,0,0,,Дұрыс па? Ария президенті
Dialogue: 0,0:15:25.12,0:15:28.12,Default,,0,0,0,,Сүйкімді! Пуипуй... Президент Ария қатты толқыды.
Dialogue: 0,0:15:28.12,0:15:32.13,Default,,0,0,0,,Бұл шынымен де біртүрлі екен.
Dialogue: 0,0:15:32.13,0:15:35.13,Default,,0,0,0,,Мүмкін Aqua's Miracle кіреберісі➡
Dialogue: 0,0:15:35.13,0:15:37.13,Default,,0,0,0,,Мүмкін сіз таптыңыз.
Dialogue: 0,0:15:37.13,0:15:41.07,Default,,0,0,0,,Иә, не? Не болды?
Dialogue: 0,0:15:41.07,0:15:51.08,Default,,0,0,0,,♬～
Dialogue: 0,0:15:51.08,0:15:53.05,Default,,0,0,0,,Ах
Dialogue: 0,0:15:55.08,0:15:57.09,Default,,0,0,0,,Сәлем (Ер адам) Сәлем
Dialogue: 0,0:15:57.09,0:15:59.09,Default,,0,0,0,,Барлық пайымдаулар жақсы көріне бастады.
Dialogue: 0,0:15:59.09,0:16:02.09,Default,,0,0,0,,Шынымен бе? Қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:16:02.09,0:16:04.09,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:04.09,0:16:06.10,Default,,0,0,0,,Жұмысыңызға сәттілік ағай.
Dialogue: 0,0:16:06.10,0:16:08.06,Default,,0,0,0,,О
Dialogue: 0,0:16:11.10,0:16:17.11,Default,,0,0,0,,Хмф, бұл керемет күн болатынын сезіп тұрмын.
Dialogue: 0,0:16:17.11,0:16:20.11,Default,,0,0,0,,Жоқ, жоқ, мұндай нәрсеге қуанба
Dialogue: 0,0:16:20.11,0:16:23.08,Default,,0,0,0,,Практика
Dialogue: 0,0:16:24.11,0:16:27.12,Default,,0,0,0,,Ммм...
Dialogue: 0,0:16:27.12,0:16:29.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:38.13,0:16:42.06,Default,,0,0,0,,Осындай жерде аллея болды ма?
Dialogue: 0,0:16:42.06,0:16:44.03,Default,,0,0,0,,Ах
Dialogue: 0,0:16:47.07,0:16:49.04,Default,,0,0,0,,Мысық па?
Dialogue: 0,0:16:50.07,0:16:55.08,Default,,0,0,0,,Жоқ, бұл... Кэйт Сит!
Dialogue: 0,0:16:55.08,0:17:00.08,Default,,0,0,0,,Нх ха ха...
Dialogue: 0,0:17:00.08,0:17:03.09,Default,,0,0,0,,Пуи Пуи Мяу
Dialogue: 0,0:17:03.09,0:18:38.08,Default,,0,0,0,,♬～
Dialogue: 0,0:18:44.05,0:18:47.06,Default,,0,0,0,,…
Dialogue: 0,0:18:47.06,0:18:50.06,Default,,0,0,0,,Пуйчер
Dialogue: 0,0:18:50.06,0:18:53.06,Default,,0,0,0,,Мен осындай жерге қосылғаныма сене алар емеспін.
Dialogue: 0,0:18:53.06,0:18:58.03,Default,,0,0,0,,Президент Ария, сіз білесіз бе? Уууу
Dialogue: 0,0:19:00.07,0:19:05.07,Default,,0,0,0,,Не? Мияу Мияу
Dialogue: 0,0:19:05.07,0:19:09.08,Default,,0,0,0,,Мен мұнда емеспін, мен сені көрмей қалдым деп ойлаймын.
Dialogue: 0,0:19:09.08,0:19:11.08,Default,,0,0,0,,Иә? Няня!
Dialogue: 0,0:19:11.08,0:19:13.08,Default,,0,0,0,,Бізге себу деген нені білдіреді?➡
Dialogue: 0,0:19:13.08,0:19:17.09,Default,,0,0,0,,Ол мысық қарапайым адам емес.
Dialogue: 0,0:19:17.09,0:19:19.09,Default,,0,0,0,,Аа, мүмкін...
Dialogue: 0,0:19:19.09,0:19:22.09,Default,,0,0,0,,Сіз Кейт Ситті іздедіңіз бе?
Dialogue: 0,0:19:22.09,0:19:25.09,Default,,0,0,0,,ше? Кейт Ситті іздеп жүрсіз бе?
Dialogue: 0,0:19:25.09,0:19:28.10,Default,,0,0,0,,А, мен ARIA компаниясының жаңа мүшесімін.
Dialogue: 0,0:19:28.10,0:19:33.07,Default,,0,0,0,,Аа... сендер балалар...
Dialogue: 0,0:19:38.11,0:19:41.11,Default,,0,0,0,,Мен Азуса Б. Макларенмін
Dialogue: 0,0:19:41.11,0:19:45.11,Default,,0,0,0,,Химея филиалында мен филиал менеджерінен нұсқаулық алып жатырмын.
Dialogue: 0,0:19:45.11,0:19:48.12,Default,,0,0,0,,Өзім айтсам, мен болашағым бар қормын.
Dialogue: 0,0:19:48.12,0:19:50.12,Default,,0,0,0,,Аня Достоевская
Dialogue: 0,0:19:50.12,0:19:54.12,Default,,0,0,0,,Мен Orange Planet-те Алиса-сенпайға қарыздармын.
Dialogue: 0,0:19:54.12,0:19:57.13,Default,,0,0,0,,Аа, мен Айно Аймын.
Dialogue: 0,0:19:57.13,0:19:59.13,Default,,0,0,0,,Мен білемін~
Dialogue: 0,0:19:59.13,0:20:01.13,Default,,0,0,0,,А... неге?
Dialogue: 0,0:20:01.13,0:20:03.13,Default,,0,0,0,,Иә, әжеден бері ұрпақтан-ұрпаққа жалғасып келеді➡
Dialogue: 0,0:20:03.13,0:20:06.14,Default,,0,0,0,,Цуттара, беделді ARIA компаниясына жаңадан келген➡
Dialogue: 0,0:20:06.14,0:20:08.14,Default,,0,0,0,,Мен қызықпын және оны қарастырамын.
Dialogue: 0,0:20:08.14,0:20:12.14,Default,,0,0,0,,Иә, тексеріңіз. Біртүрлі жаңа жігіт болса ➡
Dialogue: 0,0:20:12.14,0:20:15.14,Default,,0,0,0,,Мені Сібірге жіберіп жатыр (2 адам) Әй!
Dialogue: 0,0:20:15.14,0:20:19.15,Default,,0,0,0,,Сібір қайда орналасқан? (Аня) Мен шынымен білмеймін.
Dialogue: 0,0:20:19.15,0:20:22.15,Default,,0,0,0,,Мұны қалай тексересіз?
Dialogue: 0,0:20:22.15,0:20:24.15,Default,,0,0,0,,Гондола қауымдастығының тіркеу деректері
Dialogue: 0,0:20:24.15,0:20:26.16,Default,,0,0,0,,Бұрын… пышақ еді.
Dialogue: 0,0:20:26.16,0:20:30.16,Default,,0,0,0,,Ал филиал басшысынан алынған ақпарат бойынша...
Dialogue: 0,0:20:30.16,0:20:32.16,Default,,0,0,0,,Бұрынғы жартылай тегін шабандоз Ху...
Dialogue: 0,0:20:32.16,0:20:37.17,Default,,0,0,0,,Алайда мен ARIA компаниясының керемет күшінің арқасында ойымды өзгерте алдым.
Dialogue: 0,0:20:37.17,0:20:39.17,Default,,0,0,0,,Екеуің мысық іздеп жүрсіңдер ме?
Dialogue: 0,0:20:39.17,0:20:41.10,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:20:41.10,0:20:44.11,Default,,0,0,0,,Осы жерде көк көзді мысықтар пайда болады деген қауесет бар.
Dialogue: 0,0:20:44.11,0:20:48.11,Default,,0,0,0,,Біз қазір Himeya негізгі дүкенінің президентін іріктеудеміз.
Dialogue: 0,0:20:48.11,0:20:50.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:50.11,0:20:54.12,Default,,0,0,0,,Сонымен, Ай мырза Кэйт Ситті іздеді ме?
Dialogue: 0,0:20:54.12,0:20:56.12,Default,,0,0,0,,Хахаха мүмкін емес
Dialogue: 0,0:20:56.12,0:20:59.12,Default,,0,0,0,,Мен бұл туралы Алиса-сенпайдан да сұрадым➡
Dialogue: 0,0:20:59.12,0:21:04.13,Default,,0,0,0,,Ай-сан керемет жұмбақ кездесулер бойынша Акари-саннан кейінгі екінші орында.
Dialogue: 0,0:21:04.13,0:21:06.13,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:21:06.13,0:21:09.13,Default,,0,0,0,,Мен бұрын көлеңке көрдім деп ойладым.
Dialogue: 0,0:21:09.13,0:21:14.14,Default,,0,0,0,,Сосын қуанып, артымнан қудым, осында жеткенде
Dialogue: 0,0:21:14.14,0:21:17.14,Default,,0,0,0,,Мен біртүрлі нәрсе айтып тұрмын ба?
Dialogue: 0,0:21:17.14,0:21:20.14,Default,,0,0,0,,Жоқ, бар, бар! Ха!
Dialogue: 0,0:21:20.14,0:21:25.15,Default,,0,0,0,,Жарайсыңдар! Қане, бірге іздейік, жарай ма?
Dialogue: 0,0:21:25.15,0:21:27.15,Default,,0,0,0,,Ябусакада емес
Dialogue: 0,0:21:27.15,0:21:30.15,Default,,0,0,0,,Филиал менеджері басым күшпен шабуыл жасайтынын жиі айтады➡
Dialogue: 0,0:21:30.15,0:21:33.16,Default,,0,0,0,,Бұл керемет нәрсені сезінудің тамаша мүмкіндігі.
Dialogue: 0,0:21:33.16,0:21:37.16,Default,,0,0,0,,Бір сәт бірге ойнайық.
Dialogue: 0,0:21:37.16,0:21:39.16,Default,,0,0,0,,Хмм, жоқ...
Dialogue: 0,0:21:39.16,0:21:41.10,Default,,0,0,0,,Осында тағы барайық.
Dialogue: 0,0:21:41.10,0:21:45.10,Default,,0,0,0,,А... Шынайы ма? (Аня) Күте тұрыңыз...
Dialogue: 0,0:21:45.10,0:21:51.07,Default,,0,0,0,,Ха ха ха... (Аня) Ха ха...
Dialogue: 0,0:21:53.11,0:21:55.11,Default,,0,0,0,,Мен енді жүре алмаймын
Dialogue: 0,0:21:55.11,0:21:58.11,Default,,0,0,0,,Сүйкімді балалар, демалудың не екенін білмейсіңдер ме?
Dialogue: 0,0:21:58.11,0:22:00.12,Default,,0,0,0,,Ух... кешіріңіз.
Dialogue: 0,0:22:00.12,0:22:03.12,Default,,0,0,0,,Өте керемет... қорқынышты
Dialogue: 0,0:22:03.12,0:22:06.12,Default,,0,0,0,,Мм... шай ішкің келе ме?
Dialogue: 0,0:22:06.12,0:22:10.09,Default,,0,0,0,,Иә, бар! (Аня) Мен күттім!
Dialogue: 0,0:22:11.13,0:22:13.13,Default,,0,0,0,,Күткеніңізге рахмет, Президент Ария.
Dialogue: 0,0:22:13.13,0:22:16.13,Default,,0,0,0,,Пуна!
Dialogue: 0,0:22:16.13,0:22:20.14,Default,,0,0,0,,Пуха, мен ақыры тыныс аламын.
Dialogue: 0,0:22:20.14,0:22:24.14,Default,,0,0,0,,Кеш болды, бірақ Азуса-чан, мен бүгін көп жаттығу жасаған жоқпын➡
Dialogue: 0,0:22:24.14,0:22:26.14,Default,,0,0,0,,Айка-сан саған ашуланбайды ма?
Dialogue: 0,0:22:26.14,0:22:29.14,Default,,0,0,0,,Жоқ, жоқ, бірақ➡
Dialogue: 0,0:22:29.14,0:22:33.15,Default,,0,0,0,,Өйткені, мен жаңа президенттікке үміткер болу үшін мысық іздедім...
Dialogue: 0,0:22:33.15,0:22:35.15,Default,,0,0,0,,Мен негізінен Кейт Ситті іздедім.
Dialogue: 0,0:22:35.15,0:22:37.15,Default,,0,0,0,,Няняня...
Dialogue: 0,0:22:37.15,0:22:40.16,Default,,0,0,0,,Алиса-сенпайға қарағанда, Айка-сан қатал➡
Dialogue: 0,0:22:40.16,0:22:42.09,Default,,0,0,0,,Сізді қандай жаза күтіп тұр?
Dialogue: 0,0:22:42.09,0:22:44.09,Default,,0,0,0,,А... бұл жаман болуы мүмкін.
Dialogue: 0,0:22:44.09,0:22:46.10,Default,,0,0,0,,Бұл! (2 адам) Иә?
Dialogue: 0,0:22:46.10,0:22:49.10,Default,,0,0,0,,Екеуің бірге жаттығу жасайсыңдар ма?
Dialogue: 0,0:22:49.10,0:22:52.10,Default,,0,0,0,,Иә, иә (Аня) Дәл солай.
Dialogue: 0,0:22:52.10,0:22:55.10,Default,,0,0,0,,Ха... Мм... Мм!
Dialogue: 0,0:22:55.10,0:22:57.11,Default,,0,0,0,,Мен де саған қосылғым келеді Вакю!
Dialogue: 0,0:22:57.11,0:22:59.07,Default,,0,0,0,,Жапонияға оралғаннан кейін ол агенттік ашты—
Dialogue: 0,0:23:00.11,0:23:04.08,Default,,0,0,0,,Хехе, әрине!
Dialogue: 0,0:23:07.12,0:23:10.12,Default,,0,0,0,,Акари-сан, мүмкін осы шығар➡
Dialogue: 0,0:23:10.12,0:23:13.12,Default,,0,0,0,,Бұл сізге Кейт Сит берген «Ғажайып» емес пе?
Dialogue: 0,0:23:13.12,0:23:15.12,Default,,0,0,0,,Иә, дұрыс, мен сенімдімін
Dialogue: 0,0:23:15.12,0:23:17.13,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:23:17.13,0:23:20.13,Default,,0,0,0,,Фуфуккат теңізі каа
Dialogue: 0,0:23:20.13,0:23:24.13,Default,,0,0,0,,Менің ойымша, ол әлі де бір жерде мені бақылап отыр.
Dialogue: 0,0:23:24.13,0:23:27.14,Default,,0,0,0,,Аа, енді ойлап қарасам, Акари-сан➡
Dialogue: 0,0:23:27.14,0:23:30.11,Default,,0,0,0,,Сіз Кейт Ситпен қайта кездестіңіз бе?
Dialogue: 0,0:23:35.14,0:23:39.11,Default,,0,0,0,,Бұл мен үшін соңғы рет болды
Dialogue: 0,0:23:43.09,0:23:47.09,Default,,0,0,0,,｟Мм Кэйт Си Эй｠
Dialogue: 0,0:23:47.09,0:23:50.09,Default,,0,0,0,,｟Иә, мен сені соңғы уақытта мүлдем көре алмаймын｠
Dialogue: 0,0:23:50.09,0:23:52.09,Default,,0,0,0,,｟Қандай ұят｠
Dialogue: 0,0:23:52.09,0:23:57.10,Default,,0,0,0,,｟Мм, мүмкін енді бір-бірімізді көре алмайтын шығармыз? ｠
Dialogue: 0,0:23:57.10,0:24:00.10,Default,,0,0,0,,｟Иә...｠ ｟Пуикю｠
Dialogue: 0,0:24:00.10,0:24:03.11,Default,,0,0,0,,｟Біз Прима болғымыз келеді｠
Dialogue: 0,0:24:03.11,0:24:06.11,Default,,0,0,0,,｟Бұл сенімді ересек болу дегенді білдіреді, солай емес пе? ｠
Dialogue: 0,0:24:06.11,0:24:10.11,Default,,0,0,0,,｟Сонымен балалар ғана көре алатын дүниеден➡
Dialogue: 0,0:24:10.11,0:24:13.08,Default,,0,0,0,,Бұл оқуды аяқтау керек дегенді білдірмейді ме? ｠
Dialogue: 0,0:24:16.12,0:24:20.12,Default,,0,0,0,,｟ Соңында одан да көп➡
Dialogue: 0,0:24:20.12,0:24:23.09,Default,,0,0,0,,Бір көргеннен болса да сенімен танысқым келеді.
Dialogue: 0,0:24:28.13,0:24:30.13,Default,,0,0,0,,｟Пуина Пуи｠
Dialogue: 0,0:24:30.13,0:24:33.14,Default,,0,0,0,,｟Аа, мүмкін...｠
Dialogue: 0,0:24:33.14,0:24:36.11,Default,,0,0,0,,Кімге ｟? ⦆ ⦅иә? ｠
Dialogue: 0,0:24:39.14,0:24:42.11,Default,,0,0,0,,｟Кетеміз бе?｠
Dialogue: 0,0:24:46.08,0:24:48.08,Default,,0,0,0,,｟Міне, мына жерде｠
Dialogue: 0,0:24:48.08,0:24:51.09,Default,,0,0,0,,｟Нео Венецияның жеті кереметінің бірі➡
Dialogue: 0,0:24:51.09,0:24:54.09,Default,,0,0,0,,Бұл бақытсыздықтың тасы｠ ｟Бақыттың тасы ма? ｠
Dialogue: 0,0:24:54.09,0:24:56.09,Default,,0,0,0,,｟А, мен білемін｠
Dialogue: 0,0:24:56.09,0:25:00.10,Default,,0,0,0,,｟Ол тас Мэнгомның Венециялық анекдотын қайталады➡
Dialogue: 0,0:25:00.10,0:25:02.10,Default,,0,0,0,,Бұл өте әйгілі тас.
Dialogue: 0,0:25:02.10,0:25:05.10,Default,,0,0,0,,｟Хохе, барлығы қашып, жүріп жатыр｠
Dialogue: 0,0:25:05.10,0:25:09.10,Default,,0,0,0,,｟Иә, егер сіз оны бассаңыз, жаман нәрселер болады｠
Dialogue: 0,0:25:09.10,0:25:11.11,Default,,0,0,0,,｟Не жаман? ｠ ｟Келіңіздер...｠
Dialogue: 0,0:25:11.11,0:25:13.11,Default,,0,0,0,,｟Бәрібір, бұл жақсы нәрсе емес｠
Dialogue: 0,0:25:13.11,0:25:17.11,Default,,0,0,0,,｟Бұл қорқынышты тас.｠ ｟Міне, кеттік! ｠
Dialogue: 0,0:25:17.11,0:25:19.11,Default,,0,0,0,,｟ Сәлем! Кіші! ? ｠
Dialogue: 0,0:25:19.11,0:25:22.12,Default,,0,0,0,,｟Айя! (2 адам) Ха! ｠
Dialogue: 0,0:25:22.12,0:25:25.12,Default,,0,0,0,,｠Мен бақытсыздық тасына міндім...｠
Dialogue: 0,0:25:25.12,0:25:28.12,Default,,0,0,0,,｟Бұл кішкентай қыз не істеп жатыр? ｠
Dialogue: 0,0:25:28.12,0:25:30.13,Default,,0,0,0,,｟Күтілгендей, ештеңе болмайды｠
Dialogue: 0,0:25:30.13,0:25:33.13,Default,,0,0,0,,｟Мүмкін деп ойладым.｠
Dialogue: 0,0:25:33.13,0:25:35.13,Default,,0,0,0,,｟Иә? ｠ ｟ Жарайды｠
Dialogue: 0,0:25:35.13,0:25:37.13,Default,,0,0,0,,｟Мен оны бала кезімде талай рет басқанмын➡
Dialogue: 0,0:25:37.13,0:25:39.13,Default,,0,0,0,,Ерекше ештеңе болған жоқ｠
Dialogue: 0,0:25:39.13,0:25:42.07,Default,,0,0,0,,｟Дұрыс, мені қорқытпа｠
Dialogue: 0,0:25:42.07,0:25:45.07,Default,,0,0,0,,｟Бірақ мен Акари-сенпаймен бірге болсам мүмкін болар деп ойладым｠
Dialogue: 0,0:25:45.07,0:25:47.08,Default,,0,0,0,,｟Қорқынышты эксперименттерге тыйым салынады! ｠
Dialogue: 0,0:25:47.08,0:25:49.08,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:25:49.08,0:25:52.08,Default,,0,0,0,,Иә? ｠ (Айка)｠Аа, қазірдің өзінде осындай уақыт болды｠
Dialogue: 0,0:25:52.08,0:25:56.08,Default,,0,0,0,,｟Айка-чан, бүгін сен кіші сыныптарға сабақ бересің｠
Dialogue: 0,0:25:56.08,0:26:00.09,Default,,0,0,0,,｟Нат... мен ұмытып қалдым｠ ｠мектепке баруым керек｠
Dialogue: 0,0:26:00.09,0:26:02.09,Default,,0,0,0,,｟Кездескенше｠ ｟Мен барамын｠
Dialogue: 0,0:26:02.09,0:26:05.06,Default,,0,0,0,,｟Келіңіз және бар күшіңізді салыңыз｠
Dialogue: 0,0:26:07.10,0:26:11.10,Default,,0,0,0,,｟Ал, мен де жұмысқа қайта оралуым керек｠
Dialogue: 0,0:26:11.10,0:26:13.07,Default,,0,0,0,,｟Пуйпуикю｠
Dialogue: 0,0:26:16.10,0:26:18.11,Default,,0,0,0,,｟Нео-Венецияның жеті кереметінің бірі➡
Dialogue: 0,0:26:18.11,0:26:21.11,Default,,0,0,0,,Бақытсыздықтың тасы?
Dialogue: 0,0:26:21.11,0:26:23.11,Default,,0,0,0,,｟Пуи｠
Dialogue: 0,0:26:23.11,0:26:35.12,Default,,0,0,0,,♬～
Dialogue: 0,0:26:35.12,0:26:37.13,Default,,0,0,0,,｟Жүрейік｠
Dialogue: 0,0:26:37.13,0:26:39.13,Default,,0,0,0,,｟Пуи｠ ｟Мүмкін➡
Dialogue: 0,0:26:39.13,0:26:42.06,Default,,0,0,0,,Сіз Кейт Ситті кездестіруіңіз мүмкін｠
Dialogue: 0,0:26:42.06,0:26:44.07,Default,,0,0,0,,｟Пуина Пуи｠
Dialogue: 0,0:26:44.07,0:26:57.08,Default,,0,0,0,,♬～
Dialogue: 0,0:26:57.08,0:26:59.05,Default,,0,0,0,,｟Жарайды! ｠
Dialogue: 0,0:27:01.08,0:27:03.09,Default,,0,0,0,,｟Eit｠ ｟Пуи｠
Dialogue: 0,0:27:03.09,0:27:15.10,Default,,0,0,0,,♬～
Dialogue: 0,0:27:15.10,0:27:17.07,Default,,0,0,0,,｟мм…｠
Dialogue: 0,0:27:23.11,0:27:26.11,Default,,0,0,0,,｟Ештеңе болмайды｠
Dialogue: 0,0:27:26.11,0:27:29.08,Default,,0,0,0,,｟Президент Ария｠ ｟Пуи Нью｠
Dialogue: 0,0:27:31.11,0:27:35.12,Default,,0,0,0,,｟Кейт Ситті енді ешқашан көрмеймін бе деп ойлаймын｠
Dialogue: 0,0:27:35.12,0:27:37.09,Default,,0,0,0,,｟Пуи｠
Dialogue: 0,0:27:40.12,0:27:43.09,Default,,0,0,0,,｟Мен өзімді аздап жалғыз сезінемін｠
Dialogue: 0,0:27:48.06,0:27:51.03,Default,,0,0,0,,｟Күшік? Пуикю｠
Dialogue: 0,0:27:53.07,0:27:55.07,Default,,0,0,0,,｟Пуину Пуи｠
Dialogue: 0,0:27:55.07,0:27:57.04,Default,,0,0,0,,｟Ах! ｠
Dialogue: 0,0:28:00.08,0:28:03.08,Default,,0,0,0,,｟Хохе…｠
Dialogue: 0,0:28:03.08,0:28:05.08,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:28:05.08,0:28:14.09,Default,,0,0,0,,♬～
Dialogue: 0,0:28:14.09,0:28:16.06,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:28:21.10,0:28:25.10,Default,,0,0,0,,｟Мен сені кездестіргеніме қуаныштымын｠
Dialogue: 0,0:28:25.10,0:28:28.10,Default,,0,0,0,,｟Мен сені мәңгілік іздедім｠
Dialogue: 0,0:28:28.10,0:28:30.11,Default,,0,0,0,,｟Осылай қайта кездесіп қалдық➡
Dialogue: 0,0:28:30.11,0:28:33.08,Default,,0,0,0,,Мен шынымен бақыттымын｠
Dialogue: 0,0:28:40.12,0:28:44.05,Default,,0,0,0,,｜Мен сені келесі жолы көруге келемін｠
Dialogue: 0,0:28:44.05,0:28:46.05,Default,,0,0,0,,｟Сізді қай жерде кездестіруге болады? ｠
Dialogue: 0,0:28:46.05,0:28:50.03,Default,,0,0,0,,｟Ол тасты қайтадан бассам бола ма? ｠
Dialogue: 0,0:28:55.06,0:29:01.07,Default,,0,0,0,,｟Біз тағы кездесе алмаймыз ба? Қайтадан ешқашан? ｠
Dialogue: 0,0:29:01.07,0:29:05.07,Default,,0,0,0,,｟Маған бұл ұнамайды｠
Dialogue: 0,0:29:05.07,0:29:07.08,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:29:07.08,0:29:17.09,Default,,0,0,0,,♬～
Dialogue: 0,0:29:17.09,0:29:19.09,Default,,0,0,0,,｟Мәңгілік осында ма? ｠
Dialogue: 0,0:29:19.09,0:29:30.10,Default,,0,0,0,,♬～
Dialogue: 0,0:29:30.10,0:29:32.07,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:29:34.10,0:29:36.07,Default,,0,0,0,,｟А...｠
Dialogue: 0,0:29:42.11,0:29:45.11,Default,,0,0,0,,｟Мен ұмытпаймын｠
Dialogue: 0,0:29:45.11,0:29:49.08,Default,,0,0,0,,｟Мен сені ешқашан ұмытпаймын｠
Dialogue: 0,0:29:57.13,0:30:03.13,Default,,0,0,0,,｟Сондықтан біз әрқашан бірге боламыз｠
Dialogue: 0,0:30:03.13,0:30:28.16,Default,,0,0,0,,♬～
Dialogue: 0,0:30:28.16,0:30:30.13,Default,,0,0,0,,｟Ах｠
Dialogue: 0,0:30:45.11,0:30:48.11,Default,,0,0,0,,｟Президент Ария｠ ｟Пуйчер｠
Dialogue: 0,0:30:48.11,0:30:59.12,Default,,0,0,0,,♬～
Dialogue: 0,0:30:59.12,0:31:02.12,Default,,0,0,0,,｟Puyture｠
Dialogue: 0,0:31:02.12,0:31:11.13,Default,,0,0,0,,♬～
Dialogue: 0,0:31:11.13,0:31:14.14,Default,,0,0,0,,Әдемі, солай емес пе?
Dialogue: 0,0:31:14.14,0:31:19.14,Default,,0,0,0,,Мұның бәрі «Миракуру» шығар
Dialogue: 0,0:31:19.14,0:31:23.11,Default,,0,0,0,,Жарқырап тұрғаны сондықтан шығар деп ойлаймын.
Dialogue: 0,0:31:25.15,0:31:28.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:31:28.15,0:31:31.15,Default,,0,0,0,,P…
Dialogue: 0,0:31:31.15,0:31:33.16,Default,,0,0,0,,Бүгін Ай Чан алған «Ғажайып»➡
Dialogue: 0,0:31:33.16,0:31:36.16,Default,,0,0,0,,Бұл жарқыраған кездесу Иә!
Dialogue: 0,0:31:36.16,0:31:41.10,Default,,0,0,0,,Үшеуміз көп жаттығып, Прима Ундин болуды мақсат етеміз.
Dialogue: 0,0:31:41.10,0:31:47.07,Default,,0,0,0,,Бірақ мен әлі күнге дейін Кейт Ситпен кездескім келеді.
Dialogue: 0,0:31:48.10,0:31:53.11,Default,,0,0,0,,<Егер біз кездессек, әрқашан қоштасатын уақыт болады.>
Dialogue: 0,0:31:53.11,0:31:56.11,Default,,0,0,0,,<Бірақ сол күні қоштасуы керек болған Кэйт Ситке➡
Dialogue: 0,0:31:56.11,0:32:01.12,Default,,0,0,0,,Ай Чанның арқасында мен қайта кездескендей болдым.＞
Dialogue: 0,0:32:01.12,0:32:04.12,Default,,0,0,0,,<Мүмкін махаббат сезімі➡
Dialogue: 0,0:32:04.12,0:32:08.09,Default,,0,0,0,,Мүмкін бұл Ғажайыпты шақырып жатқан шығар.＞
Dialogue: 0,0:32:25.14,0:32:28.11,Default,,0,0,0,,Э? Хмм…
Dialogue: 0,0:32:31.15,0:32:33.15,Default,,0,0,0,,Есікті бастайық
Dialogue: 0,0:32:33.15,0:32:35.15,Default,,0,0,0,,Пуйчер
Dialogue: 0,0:32:35.15,0:32:38.15,Default,,0,0,0,,Сәлем, президент Ария, қайырлы таң.
Dialogue: 0,0:32:38.15,0:32:41.09,Default,,0,0,0,,Пуи Пуи Пуи
Dialogue: 0,0:32:41.09,0:34:26.13,Default,,0,0,0,,♬～
Dialogue: 0,0:34:26.13,0:34:29.13,Default,,0,0,0,,Гондола қауымдастығына жұмысқа сұраныс жіберіңіз➡
Dialogue: 0,0:34:29.13,0:34:32.13,Default,,0,0,0,,Пуи Пуи көшелерінің плакаттарын жасаңыз
Dialogue: 0,0:34:32.13,0:34:36.10,Default,,0,0,0,,Әрине, әңгімелесу және тәжірибелік емтихан міндетті болып табылады.
Dialogue: 0,0:34:42.08,0:34:46.08,Default,,0,0,0,,《ARIA компаниясына лайықты балам бар➡
Dialogue: 0,0:34:46.08,0:34:50.09,Default,,0,0,0,,Мұқият және мұқият таңдау сіздің жауапкершілігіңіз.
Dialogue: 0,0:34:50.09,0:34:52.05,Default,,0,0,0,,📺 (Қабылданған дыбыс)
Dialogue: 0,0:34:54.09,0:34:57.09,Default,,0,0,0,,📺 (электронды дыбыс) Компанияға қосылуды сұрайтын электрондық пошта?
Dialogue: 0,0:34:57.09,0:35:00.10,Default,,0,0,0,,Пуи, №1 өтініш беруші.
Dialogue: 0,0:35:00.10,0:35:03.10,Default,,0,0,0,,Президент Ариа Кью
Dialogue: 0,0:35:03.10,0:35:06.10,Default,,0,0,0,,Иә? Manhom-дан?
Dialogue: 0,0:35:06.10,0:35:10.11,Default,,0,0,0,,Олар жаңа ғана дүкеннің алдына жұмыс туралы хабарландыру іліп қойды, солай ма?
Dialogue: 0,0:35:10.11,0:35:12.11,Default,,0,0,0,,Пуикюу
Dialogue: 0,0:35:12.11,0:35:17.11,Default,,0,0,0,,Осы уақытта біз басты бетке әлі ешқандай жалдау жариялаған жоқпыз.
Dialogue: 0,0:35:17.11,0:35:19.11,Default,,0,0,0,,☎Е, а, а...
Dialogue: 0,0:35:19.11,0:35:22.12,Default,,0,0,0,,☎Өзімнен озып кеткенім үшін кешіріңіз.
Dialogue: 0,0:35:22.12,0:35:25.12,Default,,0,0,0,,Неліктен бізге қосылғың келеді?
Dialogue: 0,0:35:25.12,0:35:30.13,Default,,0,0,0,,☎Мен Undine-ге әрқашан тәнті болдым.
Dialogue: 0,0:35:30.13,0:35:33.13,Default,,0,0,0,,☎Сонымен интернетте ARIA компаниясының суретін түсіріңіз➡
Dialogue: 0,0:35:33.13,0:35:36.13,Default,,0,0,0,,Мен оны кездейсоқ тауып алдым...
Dialogue: 0,0:35:36.13,0:35:40.10,Default,,0,0,0,,☎Мені әйтеуір шақырып жатқандай сезіндім.
Dialogue: 0,0:35:41.07,0:35:44.07,Default,,0,0,0,,《Білуге уақыт бөлемін дедіңіз➡
Dialogue: 0,0:35:44.07,0:35:48.08,Default,,0,0,0,,Мен тіпті бұл қайшылық екенін білемін.
Dialogue: 0,0:35:48.08,0:35:52.05,Default,,0,0,0,,《Бірақ неге?》
Dialogue: 0,0:35:55.08,0:35:59.05,Default,,0,0,0,,Nnnnnnn…
Dialogue: 0,0:36:00.09,0:36:02.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:02.09,0:36:08.06,Default,,0,0,0,,《Ол кезде бұл бала да қорқатын.》
Dialogue: 0,0:36:09.10,0:36:11.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:31.12,0:36:35.12,Default,,0,0,0,,Өйткені, бұл декорация ерекше.
Dialogue: 0,0:36:35.12,0:36:38.13,Default,,0,0,0,,Күткендей, бұл екеуі әрқашан бірге болады➡
Dialogue: 0,0:36:38.13,0:36:41.06,Default,,0,0,0,,Айка мен Алисаға таң қалдыңыз ба?
Dialogue: 0,0:36:41.06,0:36:43.06,Default,,0,0,0,,Иә? Жоқ, әсіресе иә
Dialogue: 0,0:36:43.06,0:36:48.07,Default,,0,0,0,,Бірдеңе болса, филиал менеджері маған ғашық деп ойлаймын.
Dialogue: 0,0:36:48.07,0:36:51.07,Default,,0,0,0,,Orange Planet - бұл компанияның шешімі.
Dialogue: 0,0:36:51.07,0:36:53.07,Default,,0,0,0,,Иә
Dialogue: 0,0:36:53.07,0:36:56.08,Default,,0,0,0,,Сіз өзіңіз таңдай алмайсыз
Dialogue: 0,0:36:56.08,0:37:00.08,Default,,0,0,0,,Сондықтан қандай аға буынға тағайындалатыны үлкен мәселе.
Dialogue: 0,0:37:00.08,0:37:04.09,Default,,0,0,0,,Талантым болса да, мені үлкендерім танымайды➡
Dialogue: 0,0:37:04.09,0:37:06.09,Default,,0,0,0,,Кейбір балалар тастайды.
Dialogue: 0,0:37:06.09,0:37:09.09,Default,,0,0,0,,О, солай…
Dialogue: 0,0:37:09.09,0:37:12.09,Default,,0,0,0,,Басқаша айтқанда, сәттілікті босқа жібермеу керек➡
Dialogue: 0,0:37:12.09,0:37:14.10,Default,,0,0,0,,Бар күшіңді салу керек
Dialogue: 0,0:37:14.10,0:37:17.10,Default,,0,0,0,,Иә! Осы кездесуге ризашылықпен
Dialogue: 0,0:37:17.10,0:37:20.10,Default,,0,0,0,,Иә, үшеуміз міндетті түрде Прима Ундинге айналамыз.
Dialogue: 0,0:37:20.10,0:37:22.10,Default,,0,0,0,,Жаңа! (суға құлаған дыбыс)
Dialogue: 0,0:37:22.10,0:37:24.11,Default,,0,0,0,,Мияу пучочо пучочо…
Dialogue: 0,0:37:24.11,0:37:26.11,Default,,0,0,0,,Президент Ария!
Dialogue: 0,0:37:26.11,0:37:28.11,Default,,0,0,0,,Осыны ұстаңыз
Dialogue: 0,0:37:28.11,0:37:31.11,Default,,0,0,0,,Ваа…уауава…!
Dialogue: 0,0:37:31.11,0:37:33.11,Default,,0,0,0,,Фу…
Dialogue: 0,0:37:33.11,0:37:36.08,Default,,0,0,0,,Годоланың жанынан өту
Dialogue: 0,0:37:42.06,0:37:46.06,Default,,0,0,0,,Мен білмейтін дүниелер әлі де көп.
Dialogue: 0,0:37:46.06,0:37:48.06,Default,,0,0,0,,Мен де солай істеймін.
Dialogue: 0,0:37:48.06,0:37:51.07,Default,,0,0,0,,Өйткені қала өзгеруде.
Dialogue: 0,0:37:51.07,0:37:53.07,Default,,0,0,0,,Егер Prima Undine сізбен бірге жүрсе➡
Dialogue: 0,0:37:53.07,0:37:56.07,Default,,0,0,0,,Сондай-ақ жалғызбасты болсаңыз да жолаушыларды тасымалдауға болатын жүйе бар➡
Dialogue: 0,0:37:56.07,0:38:00.07,Default,,0,0,0,,Бұрын болған жоқ, солай ма?
Dialogue: 0,0:38:00.07,0:38:05.08,Default,,0,0,0,,Жасөспірімдерді жаттықтырамыз деп біреулер айта бастады, көп ұзамай тарады.
Dialogue: 0,0:38:05.08,0:38:09.08,Default,,0,0,0,,Міне осылайша бәрі бірте-бірте өзгере бастады.
Dialogue: 0,0:38:09.08,0:38:11.09,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:38:11.09,0:38:14.09,Default,,0,0,0,,Аты-жөнін де білмейтін көптеген адамдардың ойлары➡
Dialogue: 0,0:38:14.09,0:38:20.09,Default,,0,0,0,,Менің ойымша, олар бізді қаланың сезімімен қолдап жатыр.
Dialogue: 0,0:38:20.09,0:38:22.10,Default,,0,0,0,,Ха! Няня бұл...
Dialogue: 0,0:38:22.10,0:38:25.10,Default,,0,0,0,,Ұятты өсек... Иә?
Dialogue: 0,0:38:25.10,0:38:29.10,Default,,0,0,0,,Хахаха, жарайды, жақсы, бұл туралы уайымдама
Dialogue: 0,0:38:29.10,0:38:39.11,Default,,0,0,0,,♬～
Dialogue: 0,0:38:39.11,0:38:44.05,Default,,0,0,0,,Кенет бұлтты болды (Аня) Бұл маусымда біз ештеңе істей алмаймыз.
Dialogue: 0,0:38:44.05,0:38:47.06,Default,,0,0,0,,Aqua Alta жақында емес пе?
Dialogue: 0,0:38:47.06,0:38:49.06,Default,,0,0,0,,Aqua Alta?
Dialogue: 0,0:38:49.06,0:38:53.06,Default,,0,0,0,,Годоланың жанынан өту (3 адам) Ах.
Dialogue: 0,0:38:53.06,0:39:02.07,Default,,0,0,0,,♬～
Dialogue: 0,0:39:02.07,0:39:06.07,Default,,0,0,0,,Сол күлімсіреп, ән салған дауыс бәрінің көңілін жұбатады.
Dialogue: 0,0:39:06.07,0:39:08.08,Default,,0,0,0,,Мен түсіндім, бірақ...
Dialogue: 0,0:39:08.08,0:39:11.08,Default,,0,0,0,,Иә? (Аня) Алдағы музыка фестивалінде ➡
Dialogue: 0,0:39:11.08,0:39:16.08,Default,,0,0,0,,Афинаның ерекше қойылымын Алиса-сенпай да асыға күтті.
Dialogue: 0,0:39:16.08,0:39:20.09,Default,,0,0,0,,Мен сізден сұраған жұмыстан кенет бас тарта алмаймын.
Dialogue: 0,0:39:20.09,0:39:24.09,Default,,0,0,0,,Е! Жарайды, ол күні біз де бос емес едік➡
Dialogue: 0,0:39:24.09,0:39:27.10,Default,,0,0,0,,Филиал меңгерушісі де онша жақсы емес...
Dialogue: 0,0:39:27.10,0:39:29.10,Default,,0,0,0,,Біз де толық брондадық.
Dialogue: 0,0:39:29.10,0:39:33.10,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:39:33.10,0:39:35.10,Default,,0,0,0,,Ах! Пуи?
Dialogue: 0,0:39:35.10,0:39:37.11,Default,,0,0,0,,Рука, сен күнде қылыш айналдыру жаттығуын жасап жүрсің ғой?
Dialogue: 0,0:39:37.11,0:39:40.11,Default,,0,0,0,,Біз «Миракуру» жасаймыз!
Dialogue: 0,0:39:40.11,0:39:44.11,Default,,0,0,0,,«Миракуру» жаса? (Аня) Қалай?
Dialogue: 0,0:39:44.11,0:39:46.11,Default,,0,0,0,,Аква Альта! Аква Альта➡
Dialogue: 0,0:39:46.11,0:39:48.12,Default,,0,0,0,,«Миракуру» әкелу!
Dialogue: 0,0:39:48.12,0:39:53.12,Default,,0,0,0,,Керемет нәрсе іске қосылған сияқты.
Dialogue: 0,0:39:53.12,0:39:56.09,Default,,0,0,0,,Жүру? (Аня) Бұл бұта емес.
Dialogue: 0,0:40:12.14,0:40:18.15,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:40:18.15,0:40:20.11,Default,,0,0,0,,Ha
Dialogue: 0,0:40:23.15,0:40:26.15,Default,,0,0,0,,Ах! Бұл келді! Бұл келді!
Dialogue: 0,0:40:26.15,0:40:29.16,Default,,0,0,0,,Бұл Aqua Alta, Президент Ария!
Dialogue: 0,0:40:29.16,0:40:33.16,Default,,0,0,0,,Өйткені, Aqua «миракуруға» толы!
Dialogue: 0,0:40:33.16,0:40:36.16,Default,,0,0,0,,Енді операцияны бастайық О! Пуинья
Dialogue: 0,0:40:36.16,0:40:39.17,Default,,0,0,0,,⚟Қайырлы таң, Акари-сан
Dialogue: 0,0:40:39.17,0:40:42.10,Default,,0,0,0,,Қайырлы таң Пуиню Пуи
Dialogue: 0,0:40:42.10,0:40:44.11,Default,,0,0,0,,Бұл Aqua Alta.
Dialogue: 0,0:40:44.11,0:40:47.11,Default,,0,0,0,,Иә! Бүгінгі жұмыс тоқтатылады.
Dialogue: 0,0:40:47.11,0:40:51.11,Default,,0,0,0,,Иә, бүгін балконда демалып күн өткізгіңіз келе ме?
Dialogue: 0,0:40:51.11,0:40:53.11,Default,,0,0,0,,Жоқ! Иә~
Dialogue: 0,0:40:53.11,0:40:55.12,Default,,0,0,0,,Мен шығайын деп жатырмын.
Dialogue: 0,0:40:55.12,0:40:59.12,Default,,0,0,0,,Эй... Сонымен, түскі асқа бірге құймақ жасағыларың келе ме?
Dialogue: 0,0:40:59.12,0:41:01.12,Default,,0,0,0,,Пісіруге болмайды! Иә~
Dialogue: 0,0:41:01.12,0:41:04.13,Default,,0,0,0,,Өкінішке орай, бүгін бізде түскі ас бөлек болады.
Dialogue: 0,0:41:04.13,0:41:09.13,Default,,0,0,0,,Олай болса, кешкі ас әзірлейік. Мүмкін емес! өтінемін, жасамаңыз
Dialogue: 0,0:41:09.13,0:41:11.13,Default,,0,0,0,,Иә~
Dialogue: 0,0:41:11.13,0:41:13.13,Default,,0,0,0,,Мен сенімен кешке хабарласамын, Акари-сан, оған дейін➡
Dialogue: 0,0:41:13.13,0:41:16.14,Default,,0,0,0,,Демалыңыз, Пуинья.
Dialogue: 0,0:41:16.14,0:41:18.11,Default,,0,0,0,,Иә...
Dialogue: 0,0:41:23.14,0:41:26.15,Default,,0,0,0,,Енді мен сіздердің әрқайсыңыз бір миссияны орындағандарыңызды қалаймын!
Dialogue: 0,0:41:26.15,0:41:28.15,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:41:28.15,0:41:30.15,Default,,0,0,0,,Раджа Пуинья
Dialogue: 0,0:41:30.15,0:41:46.10,Default,,0,0,0,,♬～
Dialogue: 0,0:41:46.10,0:41:51.07,Default,,0,0,0,,Айка-чанның да, Алиса-чанның да бүгін кешке дейін жоспары бар ма?
Dialogue: 0,0:41:52.11,0:41:55.08,Default,,0,0,0,,《Ай Чан да бос емес сияқты》
Dialogue: 0,0:41:56.11,0:42:01.12,Default,,0,0,0,,《Келесі жолы әркімнің жұмыс кестесі ыңғайлы кезде сол ыстық бұлаққа барғым келеді》
Dialogue: 0,0:42:01.12,0:42:05.12,Default,,0,0,0,,《Мүмкін мен теңізде жүзу керек шығар, сонымен қатар жаттығу үшін》
Dialogue: 0,0:42:05.12,0:42:11.09,Default,,0,0,0,,《Мүмкін болса, мен Алисия мен әжемнің менімен бірге барғанын қалаймын》
Dialogue: 0,0:42:13.13,0:42:15.13,Default,,0,0,0,,《Орындалу қиын тілек➡
Dialogue: 0,0:42:15.13,0:42:18.13,Default,,0,0,0,,Кеудеде жинала берсе де➡
Dialogue: 0,0:42:18.13,0:42:23.14,Default,,0,0,0,,Сонда да бір күні, бір күні соны ойлауды тоқтата алмаймын.
Dialogue: 0,0:42:23.14,0:42:26.14,Default,,0,0,0,,《Бұл біртүрлі》
Dialogue: 0,0:42:26.14,0:42:30.14,Default,,0,0,0,,📺 (қабылдау дыбысы) Ах, электрондық пошта
Dialogue: 0,0:42:30.14,0:42:34.15,Default,,0,0,0,,Бұл Ай Чанның денесі, иә?
Dialogue: 0,0:42:34.15,0:42:37.15,Default,,0,0,0,,📺 Акари-сан, жақсы демалдың ба?
Dialogue: 0,0:42:37.15,0:42:39.15,Default,,0,0,0,,📺Сағат 5-те осында келіңіз.
Dialogue: 0,0:42:39.15,0:42:42.09,Default,,0,0,0,,📺Мен күтемін (операция дыбысы)
Dialogue: 0,0:42:42.09,0:42:44.09,Default,,0,0,0,,Өлімдік күнәлардың кардиналының оң қолы.
Dialogue: 0,0:42:44.09,0:42:55.10,Default,,0,0,0,,♬～
Dialogue: 0,0:42:55.10,0:42:57.10,Default,,0,0,0,,Ах
Dialogue: 0,0:42:57.10,0:43:10.12,Default,,0,0,0,,♬～
Dialogue: 0,0:43:10.12,0:43:14.12,Default,,0,0,0,,Уау! Ах, Акари-сан, қош келдіңіз.
Dialogue: 0,0:43:14.12,0:43:16.12,Default,,0,0,0,,Пуи Чай Мен сені күттім.
Dialogue: 0,0:43:16.12,0:43:18.13,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,0:43:18.13,0:43:21.13,Default,,0,0,0,,Партия? (Барлығы) Иә!
Dialogue: 0,0:43:21.13,0:43:24.13,Default,,0,0,0,,Бүгін бір нәрсенің мерейтойы ма?
Dialogue: 0,0:43:24.13,0:43:26.13,Default,,0,0,0,,Жоқ, бұл қарапайым күн.
Dialogue: 0,0:43:26.13,0:43:30.14,Default,,0,0,0,,Кәдімгі күні кеш? Керемет нәрсе!
Dialogue: 0,0:43:30.14,0:43:33.14,Default,,0,0,0,,Фуфуфуфу (Айка) Иә? Кіші?
Dialogue: 0,0:43:33.14,0:43:35.14,Default,,0,0,0,,Әй, Айқа-сенпай
Dialogue: 0,0:43:35.14,0:43:37.14,Default,,0,0,0,,Міне, міне! сурет?
Dialogue: 0,0:43:37.14,0:43:41.08,Default,,0,0,0,,Сонымен, Айка-сенпайды да кішілеріңіз шақырған екен?
Dialogue: 0,0:43:41.08,0:43:44.09,Default,,0,0,0,,Иә, ойланып отыр ма деп ойлаймын.
Dialogue: 0,0:43:44.09,0:43:47.09,Default,,0,0,0,,Айка-чан Алиса-чан
Dialogue: 0,0:43:47.09,0:43:50.09,Default,,0,0,0,,Жақсы! Уа вава…
Dialogue: 0,0:43:50.09,0:43:53.06,Default,,0,0,0,,Уау, жарайды!
Dialogue: 0,0:43:55.10,0:43:59.10,Default,,0,0,0,,Түсіндім, бүгін әркімнің істейтін ісі бар.
Dialogue: 0,0:43:59.10,0:44:02.10,Default,,0,0,0,,Қысқасы, бұл солай болды.
Dialogue: 0,0:44:02.10,0:44:04.11,Default,,0,0,0,,Бұл үлкен, мінсіз қылмыс.
Dialogue: 0,0:44:04.11,0:44:06.11,Default,,0,0,0,,Uuuuuuuuuuuuuuuuuuuuuuuuuuuuuuu!
Dialogue: 0,0:44:06.11,0:44:09.11,Default,,0,0,0,,Әлі де біраз орындық қалды.
Dialogue: 0,0:44:09.11,0:44:12.11,Default,,0,0,0,,(Айка) Сонымен...
Dialogue: 0,0:44:12.11,0:44:14.12,Default,,0,0,0,,Мүмкін! Сендер...
Dialogue: 0,0:44:14.12,0:44:16.12,Default,,0,0,0,,Иә? (3 адам) Хехехе
Dialogue: 0,0:44:16.12,0:44:18.12,Default,,0,0,0,,Алисия мен басқалары да қоңырау шалып жатыр!
Dialogue: 0,0:44:18.12,0:44:20.12,Default,,0,0,0,,Уау! (Айка) Гясу!
Dialogue: 0,0:44:20.12,0:44:23.12,Default,,0,0,0,,Хехехехе (Акира) Мен сенің бақытты болуға қалай қарайтыныңды түсінемін, бірақ➡
Dialogue: 0,0:44:23.12,0:44:26.13,Default,,0,0,0,,Бұл Алисия емес, Акира және басқалары шығар.
Dialogue: 0,0:44:26.13,0:44:29.13,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:44:29.13,0:44:32.13,Default,,0,0,0,,Алисия! Әже!
Dialogue: 0,0:44:32.13,0:44:34.14,Default,,0,0,0,,Бүгін мені шақырғаныңызға рахмет.
Dialogue: 0,0:44:34.14,0:44:38.14,Default,,0,0,0,,Керемет таңқаларлық! Мен жасаймын, балалар.
Dialogue: 0,0:44:38.14,0:44:42.08,Default,,0,0,0,,Күнделікті ризашылықпен барымды салдым.
Dialogue: 0,0:44:42.08,0:44:46.08,Default,,0,0,0,,Афина музыкалық фестивальді ерте аяқтады➡
Dialogue: 0,0:44:46.08,0:44:49.08,Default,,0,0,0,,Ол асығыс келетінін айтты.
Dialogue: 0,0:44:49.08,0:44:51.09,Default,,0,0,0,,Егер Афина-сенпай мұны істей алса➡
Dialogue: 0,0:44:51.09,0:44:53.09,Default,,0,0,0,,«Миракуру»
Dialogue: 0,0:44:53.09,0:44:57.09,Default,,0,0,0,,Міне, біз көп адам жинағанымыз өте жақсы.
Dialogue: 0,0:44:57.09,0:45:00.09,Default,,0,0,0,,Иә, бұл «Миракуру» жеткілікті.
Dialogue: 0,0:45:00.09,0:45:03.10,Default,,0,0,0,,О, жақсы иіс. Менің ойымша, бұл раушан шайы.
Dialogue: 0,0:45:03.10,0:45:05.10,Default,,0,0,0,,Иә хехехе
Dialogue: 0,0:45:05.10,0:45:08.10,Default,,0,0,0,,Бұл Ай Чан және басқалар әкелген «Миракуру» иісі.
Dialogue: 0,0:45:08.10,0:45:12.07,Default,,0,0,0,,Ұятсыз сызықтарға жол берілмейді.
Dialogue: 0,0:45:17.11,0:45:21.12,Default,,0,0,0,,Рахмет, өте дәмді болды.
Dialogue: 0,0:45:21.12,0:45:24.12,Default,,0,0,0,,Дегенмен, бізде үш компанияның тағы бір синглы бар➡
Dialogue: 0,0:45:24.12,0:45:29.12,Default,,0,0,0,,Бірлескен жаттығу үшін дос болдық, әже.
Dialogue: 0,0:45:29.12,0:45:33.13,Default,,0,0,0,,Мен президент Ариямен таныстым➡
Dialogue: 0,0:45:33.13,0:45:37.13,Default,,0,0,0,,Уақыт өте баяу өсіңіз➡
Dialogue: 0,0:45:37.13,0:45:40.13,Default,,0,0,0,,Осындай керемет кездесуге әкелгеніне сене алар емеспін➡
Dialogue: 0,0:45:40.13,0:45:43.07,Default,,0,0,0,,Мен бұл туралы ешқашан ойламадым
Dialogue: 0,0:45:43.07,0:45:46.07,Default,,0,0,0,,Өзін өте бақытты сезіну
Dialogue: 0,0:45:46.07,0:45:49.08,Default,,0,0,0,,Мен болашақты асыға күтемін Ах...
Dialogue: 0,0:45:49.08,0:45:51.08,Default,,0,0,0,,Алисия
Dialogue: 0,0:45:51.08,0:45:54.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:54.08,0:45:56.08,Default,,0,0,0,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:45:56.08,0:46:00.05,Default,,0,0,0,,Қолданыстағы жүйені өзгерту оңай емес
Dialogue: 0,0:46:01.09,0:46:03.09,Default,,0,0,0,,Жүйені өзгерту керек пе?
Dialogue: 0,0:46:03.09,0:46:05.09,Default,,0,0,0,,Болашақта кері қайтарулар үшін➡
Dialogue: 0,0:46:05.09,0:46:07.09,Default,,0,0,0,,Prima жылжыту механизмі және ➡
Dialogue: 0,0:46:07.09,0:46:10.10,Default,,0,0,0,,Мен көп нәрсені өзгертуге тырысамын.
Dialogue: 0,0:46:10.10,0:46:13.10,Default,,0,0,0,,Керісінше бақытты кездесулер болады➡
Dialogue: 0,0:46:13.10,0:46:17.10,Default,,0,0,0,,Кездесулер болашаққа тосқауыл қоюы мүмкін.
Dialogue: 0,0:46:17.10,0:46:21.11,Default,,0,0,0,,Егер лоцмандық саланың жүйесі солай ететін болса➡
Dialogue: 0,0:46:21.11,0:46:25.11,Default,,0,0,0,,Сіз өзгеру керек деп ойлайсыз ба?
Dialogue: 0,0:46:25.11,0:46:27.11,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:46:27.11,0:46:31.12,Default,,0,0,0,,Кездесудің маңыздылығын көбірек білетін адам➡
Dialogue: 0,0:46:31.12,0:46:33.09,Default,,0,0,0,,Алисияның өзі
Dialogue: 0,0:46:39.13,0:46:44.07,Default,,0,0,0,,《Бізді үш ірі су перісі деп атай бастағаннан кейін көп ұзамай》
Dialogue: 0,0:46:44.07,0:46:50.07,Default,,0,0,0,,《Мен гондола қауымдастығынан белгілі бір сұрау алдым》
Dialogue: 0,0:46:50.07,0:46:53.07,Default,,0,0,0,,《Әдептілікпен бас тартқаннан кейін де➡
Dialogue: 0,0:46:53.07,0:46:57.08,Default,,0,0,0,,Қауымдастық мүшелері бізге жиі келеді➡
Dialogue: 0,0:46:57.08,0:47:01.08,Default,,0,0,0,,Ол 10 немесе 100 жыл жалғасады➡
Dialogue: 0,0:47:01.08,0:47:05.09,Default,,0,0,0,,Ұшқыштар индустриясы мен ұшқыштар үшін➡
Dialogue: 0,0:47:05.09,0:47:08.09,Default,,0,0,0,,Маңыздылығын қызу түсіндіргенде➡
Dialogue: 0,0:47:08.09,0:47:15.10,Default,,0,0,0,,Өкінішке орай, мен оны қолданғым келеді деп шештім.》
Dialogue: 0,0:47:15.10,0:47:17.10,Default,,0,0,0,,｟Пуи Пуи Пуи｠
Dialogue: 0,0:47:17.10,0:47:22.10,Default,,0,0,0,,｟Ария президенті, гондола қауымдастығы сізді күтеді｠
Dialogue: 0,0:47:22.10,0:47:26.11,Default,,0,0,0,,｟Бос емес кезде компанияны сеніп тапсыра алатын кіші оқушыны іздеңіз ➡
Dialogue: 0,0:47:26.11,0:47:30.08,Default,,0,0,0,,Мен өскенге дейін｠
Dialogue: 0,0:47:31.11,0:47:35.08,Default,,0,0,0,,｟Коухай… Уфуфу｠
Dialogue: 0,0:47:39.12,0:47:42.06,Default,,0,0,0,,《"Мені шақырғандай болдым."》
Dialogue: 0,0:47:42.06,0:47:44.06,Default,,0,0,0,,《Бір сөзбен айтқанда мен күтпедім➡
Dialogue: 0,0:47:44.06,0:47:48.03,Default,,0,0,0,,Менің Акари-чанмен кездесуім басталды》
Dialogue: 0,0:47:53.07,0:47:59.07,Default,,0,0,0,,《Сондықтан баратын жерді таңдауға өзіңізді мәжбүрлемеңіз, баяу жүріңіз.》
Dialogue: 0,0:47:59.07,0:48:02.08,Default,,0,0,0,,《Мен жақсы көретін ARIA компаниясында➡
Dialogue: 0,0:48:02.08,0:48:07.08,Default,,0,0,0,,Осы баламен бірге жайлап өсейік.
Dialogue: 0,0:48:07.08,0:48:10.08,Default,,0,0,0,,《Мен солай ойладым》
Dialogue: 0,0:48:10.08,0:48:14.09,Default,,0,0,0,,｟Уау сүйкімді, бұл не? Бұл｠
Dialogue: 0,0:48:14.09,0:48:16.09,Default,,0,0,0,,｜Түнгі жарық қоңырауы｠
Dialogue: 0,0:48:16.09,0:48:20.09,Default,,0,0,0,,｟Ух~ Мен оны бірінші рет көріп тұрмын｠ ｟Ооо, бұл қызық｠
Dialogue: 0,0:48:20.09,0:48:25.07,Default,,0,0,0,,｟Tantgraze｠
Dialogue: 0,0:48:27.10,0:48:30.07,Default,,0,0,0,,｟Мынау, анау, анау...｠
Dialogue: 0,0:48:31.11,0:48:35.11,Default,,0,0,0,,《Төрт мезгілді осы Аквада бірге өткізейік➡
Dialogue: 0,0:48:35.11,0:48:41.05,Default,,0,0,0,,Бірте-бірте ерекше адамға айналасың.
Dialogue: 0,0:48:41.05,0:48:46.05,Default,,0,0,0,,《Бұл өте ыңғайлы уақыт болды》
Dialogue: 0,0:48:46.05,0:48:51.06,Default,,0,0,0,,《Өте маңызды және қымбат кеңістік》
Dialogue: 0,0:48:51.06,0:48:55.06,Default,,0,0,0,,《Күнделікті біз үйреншікті өмір, дүниенің көрінісі➡
Dialogue: 0,0:48:55.06,0:48:59.07,Default,,0,0,0,,Әдемі жарқыраған》
Dialogue: 0,0:48:59.07,0:49:03.04,Default,,0,0,0,,《Сиқырлағандай》
Dialogue: 0,0:49:04.07,0:49:09.08,Default,,0,0,0,,《Мен бұл орны толмас сәтті жоғалтқым келмейді》
Dialogue: 0,0:49:09.08,0:49:12.08,Default,,0,0,0,,《Мәңгілік жүре бер》
Dialogue: 0,0:49:12.08,0:49:16.08,Default,,0,0,0,,《Егер мен сиқырды қолдансам➡
Dialogue: 0,0:49:16.08,0:49:21.09,Default,,0,0,0,,Мен жай ғана уақытты тоқтатқым келеді》
Dialogue: 0,0:49:21.09,0:49:33.10,Default,,0,0,0,,♬～
Dialogue: 0,0:49:33.10,0:49:35.10,Default,,0,0,0,,｟О, бұл｠
Dialogue: 0,0:49:35.10,0:49:38.11,Default,,0,0,0,,｟Хехе, мен әкелдім｠
Dialogue: 0,0:49:38.11,0:49:41.08,Default,,0,0,0,,｟Ол енді жарқырамайды｠
Dialogue: 0,0:49:43.11,0:49:48.12,Default,,0,0,0,,｟Ей, Акари-чан, біз түнгі жарық қоңырауымен қоштасқанда➡
Dialogue: 0,0:49:48.12,0:49:50.08,Default,,0,0,0,,Өзіңізді қалай сезіндіңіз? ｠
Dialogue: 0,0:49:52.12,0:49:57.12,Default,,0,0,0,,｟Ол сондай жалғыз болды.
Dialogue: 0,0:49:57.12,0:50:00.13,Default,,0,0,0,,｟Қоштасу әрқашан мұңды｠
Dialogue: 0,0:50:00.13,0:50:05.13,Default,,0,0,0,,｟Осы нұрлы қоңырау соққанда және Гондола мырза➡
Dialogue: 0,0:50:05.13,0:50:09.14,Default,,0,0,0,,Мен өзімді өте, өте жалғыз және қайғылы сезіндім｠
Dialogue: 0,0:50:09.14,0:50:15.14,Default,,0,0,0,,｟Бірақ бұл жақсы нәрсе шығар｠
Dialogue: 0,0:50:15.14,0:50:18.11,Default,,0,0,0,,｟Алисия｠ ｟Аа…｠
Dialogue: 0,0:50:19.15,0:50:24.15,Default,,0,0,0,,｟Жалғыздық неғұрлым қайғылы болса, соғұрлым мұңдырақ➡
Dialogue: 0,0:50:24.15,0:50:29.12,Default,,0,0,0,,Себебі ол мен жақсы көретін адам болды.
Dialogue: 0,0:50:30.16,0:50:33.16,Default,,0,0,0,,｟Мен бұл өмір бойы жалғасатын сияқтымын...｠
Dialogue: 0,0:50:33.16,0:50:39.13,Default,,0,0,0,,｟Осы аквамен жарқырап тұратын құнды қатысу｜
Dialogue: 0,0:50:40.17,0:50:48.14,Default,,0,0,0,,｟Сондықтан қайғылы сезімдер де бақытты адамның дәлелі.
Dialogue: 0,0:50:56.12,0:51:01.09,Default,,0,0,0,,《Жүрегіме жинақталған тоқырау босап жатыр》
Dialogue: 0,0:51:06.13,0:51:12.13,Default,,0,0,0,,《Менің денем мөлдір болып, сенің түсің болады》
Dialogue: 0,0:51:12.13,0:51:17.14,Default,,0,0,0,,《Бұл Aqua➡-ды ақырын орап алған сияқты
Dialogue: 0,0:51:17.14,0:51:21.14,Default,,0,0,0,,Алыстағы көк теңіз сияқты》
Dialogue: 0,0:51:21.14,0:51:25.11,Default,,0,0,0,,《Рахмет саған Акари-чан》
Dialogue: 0,0:51:31.15,0:51:33.15,Default,,0,0,0,,｟Ахахаха｠
Dialogue: 0,0:51:33.15,0:51:35.16,Default,,0,0,0,,｟Акари-чан саған осылай айтты ма?｠
Dialogue: 0,0:51:35.16,0:51:37.16,Default,,0,0,0,,｟Иә｠
Dialogue: 0,0:51:37.16,0:51:42.10,Default,,0,0,0,,｜Жалғыздық пен мұң – тек бақытты адамдардың дәлелі.｠
Dialogue: 0,0:51:42.10,0:51:45.10,Default,,0,0,0,,｟Алиса да орта мектепті бітірді｠
Dialogue: 0,0:51:45.10,0:51:48.10,Default,,0,0,0,,｟Біз де дайын болуымыз керек｠
Dialogue: 0,0:51:48.10,0:51:53.11,Default,,0,0,0,,｟Сізді күтіп тұрған гондолалар қауымдастығы ғана емес, солай ма? Ол да
Dialogue: 0,0:51:53.11,0:51:55.11,Default,,0,0,0,,｟Иә｠
Dialogue: 0,0:51:55.11,0:51:57.08,Default,,0,0,0,,｜Олардың барлығы жақсы нәрселер｠
Dialogue: 0,0:52:00.11,0:52:03.08,Default,,0,0,0,,｜Мен енді бір орында тұра алмаймын｠
Dialogue: 0,0:52:04.12,0:52:06.09,Default,,0,0,0,,｟Иә｠
Dialogue: 0,0:52:12.13,0:52:15.10,Default,,0,0,0,,｟Жаңбыр тоқтады｠
Dialogue: 0,0:52:17.13,0:52:19.10,Default,,0,0,0,,｟Е...｠
Dialogue: 0,0:52:21.14,0:52:24.14,Default,,0,0,0,,｟Олай болса бастайық｠
Dialogue: 0,0:52:24.14,0:52:26.11,Default,,0,0,0,,｟Иә! ｠
Dialogue: 0,0:52:27.14,0:52:30.14,Default,,0,0,0,,《Сиқыр ериді》
Dialogue: 0,0:52:30.14,0:52:35.15,Default,,0,0,0,,《Тоқтап қалған уақытым қайта жылжи бастады》
Dialogue: 0,0:52:35.15,0:52:37.15,Default,,0,0,0,,N... Nnn...
Dialogue: 0,0:52:37.15,0:52:39.15,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:52:39.15,0:52:42.09,Default,,0,0,0,,А, арман?
Dialogue: 0,0:52:42.09,0:52:45.06,Default,,0,0,0,,Сіз қандай түс көрдіңіз?
Dialogue: 0,0:52:46.09,0:52:50.10,Default,,0,0,0,,Хехе, сағынышпен кездесу арманы
Dialogue: 0,0:52:50.10,0:52:52.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:52.10,0:52:56.10,Default,,0,0,0,,Мен біраз уақыттан кейін бірінші рет босаңсып қалдым.
Dialogue: 0,0:52:56.10,0:52:59.11,Default,,0,0,0,,Жоспарлаған үш адамға рахмет.
Dialogue: 0,0:52:59.11,0:53:03.11,Default,,0,0,0,,Афина, сен келе алмадың.
Dialogue: 0,0:53:03.11,0:53:06.11,Default,,0,0,0,,Мен оны асығыс аяқтай алмаймын.
Dialogue: 0,0:53:06.11,0:53:08.12,Default,,0,0,0,,Мен күткендей
Dialogue: 0,0:53:08.12,0:53:12.12,Default,,0,0,0,,Бірақ сенің арқаңда тілегімнің дәні бұзылмай қалды.
Dialogue: 0,0:53:12.12,0:53:14.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:14.12,0:53:16.12,Default,,0,0,0,,Тілек тұқымы? Иә
Dialogue: 0,0:53:16.12,0:53:21.13,Default,,0,0,0,,Орындалмаған тілектердің дәні жүрегімде қалады➡
Dialogue: 0,0:53:21.13,0:53:25.13,Default,,0,0,0,,Үміттің нұрын шаша береді
Dialogue: 0,0:53:25.13,0:53:31.14,Default,,0,0,0,,Мен оны өзім өшірмейінше, толқу мәңгілікке жалғасады.
Dialogue: 0,0:53:31.14,0:53:36.14,Default,,0,0,0,,Бұл қуанышты нәрсе емес пе?
Dialogue: 0,0:53:36.14,0:53:39.15,Default,,0,0,0,,Сондықтан сіз бұл тұқымдарды жинайсыз.
Dialogue: 0,0:53:39.15,0:53:43.08,Default,,0,0,0,,Хехехе, бұл біртүрлі нәрсе➡
Dialogue: 0,0:53:43.08,0:53:46.09,Default,,0,0,0,,Мен ешқашан орындалмайды деп ойлаған тілек➡
Dialogue: 0,0:53:46.09,0:53:52.09,Default,,0,0,0,,Кейде түріңді өзгертіп, кенет бетіңді көрсетесің.
Dialogue: 0,0:53:52.09,0:53:55.06,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:53:59.10,0:54:02.10,Default,,0,0,0,,Келесі жолы барлығымызды біріктіруге тырысайық.
Dialogue: 0,0:54:02.10,0:54:05.11,Default,,0,0,0,,Мүмкін келесі жолы гондола кешін өткізетін шығармыз.
Dialogue: 0,0:54:05.11,0:54:07.07,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:54:12.11,0:54:17.12,Default,,0,0,0,,♪ (Афинаның ән салған дауысы)
Dialogue: 0,0:54:17.12,0:54:20.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:20.12,0:54:27.13,Default,,0,0,0,,♪～
Dialogue: 0,0:54:27.13,0:54:30.13,Default,,0,0,0,,Га, Афина-сенпай
Dialogue: 0,0:54:30.13,0:55:53.08,Default,,0,0,0,,♪～
Dialogue: 0,0:55:53.08,0:55:56.05,Default,,0,0,0,,Бұл үлкен «Миракуру»
Dialogue: 0,0:55:57.08,0:56:01.09,Default,,0,0,0,,Бүгін Ай-чан және басқалар жасаған «Миракуру» мерейтойы.
Dialogue: 0,0:56:01.09,0:56:04.09,Default,,0,0,0,,Ұятсыз жолдар жоқ
Dialogue: 0,0:56:04.09,0:56:08.10,Default,,0,0,0,,Содан бері біз қосылдық.
Dialogue: 0,0:56:08.10,0:56:10.06,Default,,0,0,0,,Иә
Dialogue: 0,0:56:11.10,0:56:15.10,Default,,0,0,0,,Әрқайсымыз жүретін жолдар қиылысады➡
Dialogue: 0,0:56:15.10,0:56:20.07,Default,,0,0,0,,Жаңа жолға айналып, қайта алыстау
Dialogue: 0,0:56:21.11,0:56:24.08,Default,,0,0,0,,｟Құттықтаймыз Алиса Чан｠
Dialogue: 0,0:56:25.11,0:56:30.12,Default,,0,0,0,,｟Апельсин ханшайымы жоқ｠
Dialogue: 0,0:56:30.12,0:56:34.09,Default,,0,0,0,,｟Бүгіннен бастап сіз Prima Undineсіз｠
Dialogue: 0,0:56:35.12,0:56:38.09,Default,,0,0,0,,｜Егер сен құласаң, мен оны қабылдамаймын｠
Dialogue: 0,0:56:43.06,0:56:46.07,Default,,0,0,0,,｜ Мәртебелі болашақ патшайым｠
Dialogue: 0,0:56:46.07,0:56:48.04,Default,,0,0,0,,｟Иә! ｠
Dialogue: 0,0:56:55.08,0:57:00.08,Default,,0,0,0,,｟Мен сені кездестіргеніме өте қуаныштымын｠
Dialogue: 0,0:57:00.08,0:57:05.05,Default,,0,0,0,,｟Рахмет, менің аквамаринім｠
Dialogue: 0,0:57:06.09,0:57:09.06,Default,,0,0,0,,｟Аквамарин…｠
Dialogue: 0,0:57:10.09,0:57:13.09,Default,,0,0,0,,｟Дистант көк｠
Dialogue: 0,0:57:13.09,0:57:15.06,Default,,0,0,0,,｟Puyture｠
Dialogue: 0,0:57:16.10,0:57:21.10,Default,,0,0,0,,｟Себебі мен өз жолыммен тоқтаусыз жүріп келемін➡
Dialogue: 0,0:57:21.10,0:57:24.10,Default,,0,0,0,,Мен сені кездестірдім｠
Dialogue: 0,0:57:24.10,0:57:31.08,Default,,0,0,0,,｟Сондықтан біз жаңа сыйлыққа қарай жүруді жалғастырамыз｠
Dialogue: 0,0:57:35.12,0:59:20.09,Default,,0,0,0,,♬～
Dialogue: 0,0:59:20.09,0:59:23.09,Default,,0,0,0,,Есікті бастайық
Dialogue: 0,0:59:23.09,0:59:26.09,Default,,0,0,0,,Біздің болашағымызға
Dialogue: 0,0:59:26.09,0:59:29.10,Default,,0,0,0,,Пуйчер
Dialogue: 0,0:59:29.10,0:59:49.08,Default,,0,0,0,,♬～
Dialogue: 0,0:59:50.58,0:59:56.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory