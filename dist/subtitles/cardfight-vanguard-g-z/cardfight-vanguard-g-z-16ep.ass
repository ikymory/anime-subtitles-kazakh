Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.17,0:01:05.20,Default,,0,0,0,,Джекпот! Нит
Dialogue: 0,0:01:05.20,0:01:08.11,Default,,0,0,0,,Сөз жоқ. (Сион) Иә.
Dialogue: 0,0:01:08.11,0:01:11.46,Default,,0,0,0,,Мен ізімен жүріп, ақыры жеттім.
Dialogue: 0,0:01:11.46,0:01:13.78,Default,,0,0,0,,Елшілерге!
Dialogue: 0,0:01:13.78,0:01:16.77,Default,,0,0,0,,Бұл екі адамның ынта-жігері мен жігерінің жемісі.
Dialogue: 0,0:01:16.77,0:01:19.15,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:01:19.15,0:01:21.77,Default,,0,0,0,,[Радио] (Есай) Инфильтрация кезінде өте сақ болыңыз.
Dialogue: 0,0:01:21.77,0:01:23.76,Default,,0,0,0,,[Сымсыз] Желіні қосулы ұстаңыз
Dialogue: 0,0:01:23.76,0:01:26.11,Default,,0,0,0,,Жарайды, мен де камераны қосамын.
Dialogue: 0,0:01:26.11,0:01:28.11,Default,,0,0,0,,Иә
Dialogue: 0,0:01:30.11,0:01:32.10,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:01:32.10,0:01:36.75,Default,,0,0,0,,Олар жеңіл қауіпсіздікке ие емес.
Dialogue: 0,0:01:36.75,0:01:38.77,Default,,0,0,0,,Мен қатысуды сезбеймін
Dialogue: 0,0:01:38.77,0:01:40.77,Default,,0,0,0,,Бұл шынымен қате ме?
Dialogue: 0,0:01:40.77,0:01:42.78,Default,,0,0,0,,Немесе...
Dialogue: 0,0:01:42.78,0:01:44.76,Default,,0,0,0,,Сізді осында көргеніме қуаныштымын.
Dialogue: 0,0:01:44.76,0:01:48.08,Default,,0,0,0,,Сіз... Валеос!
Dialogue: 0,0:01:48.08,0:01:52.10,Default,,0,0,0,,Савасу Хайме Алкаластың жетекшісі
Dialogue: 0,0:01:52.10,0:01:54.45,Default,,0,0,0,,Және Киба Шион
Dialogue: 0,0:01:54.45,0:01:56.77,Default,,0,0,0,,Сіз жалғыз қалған сияқтысыз.
Dialogue: 0,0:01:56.77,0:02:00.44,Default,,0,0,0,,Байқадың ба... (Хайма) Жарайды онда
Dialogue: 0,0:02:00.44,0:02:02.61,Default,,0,0,0,,Таку!
Dialogue: 0,0:02:02.61,0:02:05.43,Default,,0,0,0,,Қаз мырза ұйықтап жатса да➡
Dialogue: 0,0:02:05.43,0:02:08.10,Default,,0,0,0,,Қандай дөрекісің!
Dialogue: 0,0:02:08.10,0:02:12.00,Default,,0,0,0,,Хехе, Фидестің мұрагері...
Dialogue: 0,0:02:12.00,0:02:14.11,Default,,0,0,0,,Ах, менің Джентль…
Dialogue: 0,0:02:14.11,0:02:16.11,Default,,0,0,0,,ｳﾞｧﾚｵｽ…
Dialogue: 0,0:02:16.11,0:02:19.11,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:19.11,0:02:23.78,Default,,0,0,0,,Тоқта. Мистер қаздың артынан барғың келсе!
Dialogue: 0,0:02:23.78,0:02:26.77,Default,,0,0,0,,Ах~ Не болып жатыр?
Dialogue: 0,0:02:26.77,0:02:28.77,Default,,0,0,0,,Жекпе-жек, ​​Валеос!
Dialogue: 0,0:02:28.77,0:02:30.77,Default,,0,0,0,,Не? сурет? Ах!?
Dialogue: 0,0:02:30.77,0:02:33.77,Default,,0,0,0,,Мен сені жеңемін! Шион!
Dialogue: 0,0:05:47.10,0:05:50.44,Default,,0,0,0,,Хехехе, ыңғайсыз.
Dialogue: 0,0:05:50.44,0:05:52.77,Default,,0,0,0,,Енді Фидес жоғалып кетті➡
Dialogue: 0,0:05:52.77,0:05:56.09,Default,,0,0,0,,Сіз енді мұрагер емессіз.
Dialogue: 0,0:05:56.09,0:05:59.45,Default,,0,0,0,,Жай ғана тітіркендіргіш шыбын.
Dialogue: 0,0:05:59.45,0:06:02.08,Default,,0,0,0,,Қайта ұсталма➡
Dialogue: 0,0:06:02.08,0:06:04.38,Default,,0,0,0,,Мен сені толығымен жерлеймін!
Dialogue: 0,0:06:10.78,0:06:12.78,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ！
Dialogue: 0,0:06:12.78,0:06:14.78,Default,,0,0,0,,(ｼｵﾝ)ｻﾞ…｡ (ｳﾞｧﾚｵｽ)ｾﾞｯﾄ…｡ (ｳﾞｧﾚｵｽ/ｼｵﾝ)ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:06:14.78,0:06:17.43,Default,,0,0,0,,Жыпылықтап тұрған рыцарь Мириус!
Dialogue: 0,0:06:17.43,0:06:20.10,Default,,0,0,0,,Аонами жаңа қызметкері Кости
Dialogue: 0,0:06:20.10,0:06:23.77,Default,,0,0,0,,Жүр! Айдың рыцарь Азу Ферекс!
Dialogue: 0,0:06:23.77,0:06:29.78,Default,,0,0,0,,Жүр! Аонами ефрейтор Беллагиос шабуылдары!
Dialogue: 0,0:06:29.78,0:06:34.43,Default,,0,0,0,,Жүр! Теңдессіз рыцарь Ливаро!
Dialogue: 0,0:06:34.43,0:06:36.44,Default,,0,0,0,,ｺｰﾙ！
Dialogue: 0,0:06:36.44,0:06:38.77,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:06:38.77,0:06:41.11,Default,,0,0,0,,ｶﾞｰﾄﾞ！ ﾌﾝ…
Dialogue: 0,0:06:41.11,0:06:45.76,Default,,0,0,0,,Тағы менің алдымда тұруға қалай дәтің бар!
Dialogue: 0,0:06:45.76,0:06:49.43,Default,,0,0,0,,Мен мұны өз бетімше істей алмадым ...
Dialogue: 0,0:06:49.43,0:06:53.09,Default,,0,0,0,,Хайме мырзаның, Эниши мырзаның және басқалардың күші арқасында➡
Dialogue: 0,0:06:53.09,0:06:55.44,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:06:55.44,0:06:59.79,Default,,0,0,0,,Ал Шион да біздің күшімізге айналды!
Dialogue: 0,0:06:59.79,0:07:02.78,Default,,0,0,0,,Біз осылай күресеміз! (Оған) Біз осылай күресеміз!
Dialogue: 0,0:07:02.78,0:07:06.16,Default,,0,0,0,,Valeos Мен сені Клэйге қайта жіберемін!
Dialogue: 0,0:07:06.16,0:07:08.20,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:07:08.20,0:07:10.10,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:07:10.10,0:07:13.11,Default,,0,0,0,,Арх! Гррр...
Dialogue: 0,0:07:13.11,0:07:15.77,Default,,0,0,0,,Жыпылықтайтын рыцарь Мириустың шеберлігі!
Dialogue: 0,0:07:15.77,0:07:18.11,Default,,0,0,0,,Палубаның ең жақсы 10 картасын қараңыз➡
Dialogue: 0,0:07:18.11,0:07:21.45,Default,,0,0,0,,Сіздің altomail аты бар 2 картаға дейін ашылады!
Dialogue: 0,0:07:21.45,0:07:24.43,Default,,0,0,0,,1 карточка жанға 1 карта
Dialogue: 0,0:07:24.43,0:07:27.12,Default,,0,0,0,,Диаграммаға түспеңіз!
Dialogue: 0,0:07:27.12,0:07:30.77,Default,,0,0,0,,Аонами Суйшо Галеасқа мініңіз!
Dialogue: 0,0:07:30.77,0:07:33.13,Default,,0,0,0,,ｺｰﾙ ﾌｫｲｳﾞｫｽ！
Dialogue: 0,0:07:33.13,0:07:37.78,Default,,0,0,0,,Әрине, сен күресуге тұрмайтын әлсіз жансың.
Dialogue: 0,0:07:37.78,0:07:41.77,Default,,0,0,0,,Мен тіпті Фидестің мұрагері болғандықтан соғыстым!
Dialogue: 0,0:07:41.77,0:07:47.11,Default,,0,0,0,,Мені жеңгіңіз келетіні осы ма?
Dialogue: 0,0:07:47.11,0:07:49.11,Default,,0,0,0,,Күлуді тоқтатыңыз!
Dialogue: 0,0:07:49.11,0:07:52.46,Default,,0,0,0,,Сәлем! Сіз әлі де күресуіңіз керек➡
Dialogue: 0,0:07:52.46,0:07:56.50,Default,,0,0,0,,Жақсы емес пе? Жеңілген адамнан жақсы!
Dialogue: 0,0:07:56.50,0:08:01.12,Default,,0,0,0,,Әй... Мені емдеген – шулы қарға.
Dialogue: 0,0:08:01.12,0:08:05.44,Default,,0,0,0,,Хайм Егер мен оны осылай айтсам, ''Адамдардың мақтанғанына көп уақыт бола қойған жоқ'' болар еді.
Dialogue: 0,0:08:05.44,0:08:08.78,Default,,0,0,0,,Қалай болғанда да!
Dialogue: 0,0:08:08.78,0:08:10.81,Default,,0,0,0,,Шионды бағалама!
Dialogue: 0,0:08:10.81,0:08:14.43,Default,,0,0,0,,Менің мақтанышым сенің қылышыңмен!
Dialogue: 0,0:08:14.43,0:08:16.44,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:08:16.44,0:08:19.79,Default,,0,0,0,,Құдайдың рыцарь Альтомайл!
Dialogue: 0,0:08:19.79,0:08:22.44,Default,,0,0,0,,Жаңа альтоmail
Dialogue: 0,0:08:22.44,0:08:26.13,Default,,0,0,0,,Шионның жаңа шешімі мен шешімі!
Dialogue: 0,0:08:26.13,0:08:31.77,Default,,0,0,0,,Альтомильдік дағдылар! Палубадан Батылмен бір картаны алыңыз➡
Dialogue: 0,0:08:31.77,0:08:33.77,Default,,0,0,0,,ｽﾍﾟﾘｵﾙｺｰﾙ！
Dialogue: 0,0:08:33.77,0:08:35.79,Default,,0,0,0,,Барлаушы үкіді жылжытыңыз!
Dialogue: 0,0:08:35.79,0:08:38.44,Default,,0,0,0,,Қоңырау шалыңыз! Риваромен шабуыл!
Dialogue: 0,0:08:38.44,0:08:41.78,Default,,0,0,0,,Батыл! Батырды палубадан ұстаңыз➡
Dialogue: 0,0:08:41.78,0:08:45.13,Default,,0,0,0,,2 дәрежелі бір картамен керемет қоңырау!
Dialogue: 0,0:08:45.13,0:08:47.12,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:08:47.12,0:08:50.79,Default,,0,0,0,,Шинмейдің альтомайлымен шабуыл!
Dialogue: 0,0:08:50.79,0:08:53.79,Default,,0,0,0,,Беренос шеберлігі іске қосылды! 1 картаны сал!
Dialogue: 0,0:08:53.79,0:08:56.78,Default,,0,0,0,,Альтомиль үшін қуат плюс 5000!
Dialogue: 0,0:08:56.78,0:08:58.78,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:08:58.78,0:09:00.78,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:09:00.78,0:09:03.45,Default,,0,0,0,,ﾌｧｰｽﾄﾁｪｯｸ ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:09:03.45,0:09:06.12,Default,,0,0,0,,Критикалық триггер! Жолсерікке қуат
Dialogue: 0,0:09:06.12,0:09:08.44,Default,,0,0,0,,Маңызды ақпарат алу үшін Altomail сайтына өтіңіз!
Dialogue: 0,0:09:08.44,0:09:10.79,Default,,0,0,0,,Мен көрген қорлықты тазартамын!
Dialogue: 0,0:09:10.79,0:09:13.44,Default,,0,0,0,,Ұрланған нәрсені қалпына келтіріңіз!
Dialogue: 0,0:09:13.44,0:09:16.43,Default,,0,0,0,,Осы қылышпен!!
Dialogue: 0,0:09:16.43,0:09:18.80,Default,,0,0,0,,ｴｽｺｰﾄ！
Dialogue: 0,0:09:18.80,0:09:20.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:20.82,0:09:24.45,Default,,0,0,0,,Ой! Зақым 5!
Dialogue: 0,0:09:24.45,0:09:27.46,Default,,0,0,0,,Жылы альтомайл
Dialogue: 0,0:09:27.46,0:09:30.49,Default,,0,0,0,,Әлі де осал бөлім.
Dialogue: 0,0:09:30.49,0:09:34.80,Default,,0,0,0,,Айқай! Шексіз көк толқындар!
Dialogue: 0,0:09:34.80,0:09:36.80,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:09:39.15,0:09:43.44,Default,,0,0,0,,Аонами Маршал Валеос!
Dialogue: 0,0:09:43.44,0:09:45.47,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:09:45.47,0:09:50.46,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:50.46,0:09:54.16,Default,,0,0,0,,Көк толқын Маршал Айдаһар Су тасқыны қаупі Айдаһар
Dialogue: 0,0:09:56.12,0:09:59.12,Default,,0,0,0,,Қадаммен жүру дағдысы. Сіздің Авангардыңыз➡
Dialogue: 0,0:09:59.12,0:10:01.77,Default,,0,0,0,,11000 қуатта бекітілген
Dialogue: 0,0:10:01.77,0:10:04.46,Default,,0,0,0,,Қоңырау шалыңыз! Қатал дағдылар!
Dialogue: 0,0:10:04.46,0:10:07.43,Default,,0,0,0,,Су тасқыны дағдыларын меңгереді
Dialogue: 0,0:10:07.43,0:10:10.45,Default,,0,0,0,,Қанша күрессең де➡
Dialogue: 0,0:10:10.45,0:10:13.45,Default,,0,0,0,,Қандай ысырап!
Dialogue: 0,0:10:13.45,0:10:16.12,Default,,0,0,0,,Қасума Тоқайрин ыдыс ретінде➡
Dialogue: 0,0:10:16.12,0:10:18.77,Default,,0,0,0,,Бұл жерге қаз-сама түседі➡
Dialogue: 0,0:10:18.77,0:10:22.78,Default,,0,0,0,,Барлық алты ұлттың нөлдік айдаһарлары да оянды.
Dialogue: 0,0:10:22.78,0:10:25.43,Default,,0,0,0,,Жарқыраған қылыш Фидес те➡
Dialogue: 0,0:10:25.43,0:10:29.79,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:10:29.79,0:10:35.11,Default,,0,0,0,,Өйткені Шион Киба деген әлсіз адам мұрагер болды.
Dialogue: 0,0:10:35.11,0:10:38.71,Default,,0,0,0,,Су тасқыны қаупі бар шабуыл!
Dialogue: 0,0:10:40.76,0:10:43.78,Default,,0,0,0,,Дағдыны белсендіру 1 картаны сал!
Dialogue: 0,0:10:43.78,0:10:46.42,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ…
Dialogue: 0,0:10:46.42,0:10:48.44,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:10:48.44,0:10:51.44,Default,,0,0,0,,ﾌｧｰｽﾄﾁｪｯｸ ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:10:51.44,0:10:55.43,Default,,0,0,0,,Критикалық триггер. Төртіншіге күш
Dialogue: 0,0:10:55.43,0:10:57.45,Default,,0,0,0,,Су тасқыны үшін маңызды
Dialogue: 0,0:10:57.45,0:11:00.43,Default,,0,0,0,,ｻｰﾄﾞﾁｪｯｸ ﾋｰﾙﾄﾘｶﾞｰ
Dialogue: 0,0:11:00.43,0:11:02.77,Default,,0,0,0,,Қуат – су тасқыны қаупі!
Dialogue: 0,0:11:02.77,0:11:04.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:07.77,0:11:09.78,Default,,0,0,0,,ｼｵﾝ～
Dialogue: 0,0:11:09.78,0:11:13.78,Default,,0,0,0,,Киба Валеостың нағыз күші осыдан басталады!
Dialogue: 0,0:11:13.78,0:11:16.77,Default,,0,0,0,,Foyverse көмегімен altmail-ге шабуыл жасаңыз!
Dialogue: 0,0:11:16.77,0:11:19.77,Default,,0,0,0,,Дағдыны белсендіру Пауэр plus 2000!
Dialogue: 0,0:11:19.77,0:11:22.12,Default,,0,0,0,,Ұрыстың соңында тұрыңыз!
Dialogue: 0,0:11:22.12,0:11:24.12,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:11:24.12,0:11:26.72,Default,,0,0,0,,Тағы бір рет Scope Sailor's жарылуымен!
Dialogue: 0,0:11:30.11,0:11:32.78,Default,,0,0,0,,Риваро Беренспен күзет!
Dialogue: 0,0:11:32.78,0:11:37.68,Default,,0,0,0,,4-ші шабуылдың соңында Flood Hazard шеберлігі іске қосылады!
Dialogue: 0,0:11:40.17,0:11:42.21,Default,,0,0,0,,Су тасқыны қаупі бар!
Dialogue: 0,0:11:42.21,0:11:44.76,Default,,0,0,0,,Теңізшілердің шеберлігі
Dialogue: 0,0:11:44.76,0:11:47.78,Default,,0,0,0,,Су тасқыны қаупі үшін қуат плюс 4000!
Dialogue: 0,0:11:47.78,0:11:51.83,Default,,0,0,0,,Әлем қазірдің өзінде жойылу жолында.
Dialogue: 0,0:11:51.83,0:11:56.10,Default,,0,0,0,,Сіз оны да көре аласыз, Фидестің мұрагері➡
Dialogue: 0,0:11:56.10,0:11:58.79,Default,,0,0,0,,Дәлел!
Dialogue: 0,0:11:58.79,0:12:02.49,Default,,0,0,0,,Оны қазір тоқтату мүмкін емес!
Dialogue: 0,0:12:05.18,0:12:07.18,Default,,0,0,0,,Уау!!
Dialogue: 0,0:13:48.20,0:13:51.42,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:13:51.42,0:13:53.77,Default,,0,0,0,,ｶﾞｰﾄﾞ！ ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:13:53.77,0:13:57.83,Default,,0,0,0,,Эгреннің шеберлік қалқаны плюс 10000!
Dialogue: 0,0:13:57.83,0:14:00.86,Default,,0,0,0,,ｸﾞｯｼﾞｮﾌﾞ！ ｳﾞｧﾚｵｽ！
Dialogue: 0,0:14:00.86,0:14:07.09,Default,,0,0,0,,Елшілер, сіздердің жоспарларыңыз және Қаздар әкелген жойылу!
Dialogue: 0,0:14:07.09,0:14:09.47,Default,,0,0,0,,Мен оны міндетті түрде тоқтатамын!
Dialogue: 0,0:14:09.47,0:14:12.52,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｻﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:14:12.52,0:14:16.43,Default,,0,0,0,,Ұшатын көктегі қасиетті рыцарь Альтомайл!
Dialogue: 0,0:14:16.43,0:14:19.78,Default,,0,0,0,,Құдалық рыцарь Альтомильдің қадам жасау шеберлігі!
Dialogue: 0,0:14:19.78,0:14:22.82,Default,,0,0,0,,Палубадан Батылмен бір картаны алыңыз➡
Dialogue: 0,0:14:22.82,0:14:24.85,Default,,0,0,0,,ｽﾍﾟﾘｵﾙｺｰﾙ！
Dialogue: 0,0:14:24.85,0:14:26.87,Default,,0,0,0,,Хитен Қасиетті Рыцарь Альтомиль дағдылары
Dialogue: 0,0:14:26.87,0:14:31.09,Default,,0,0,0,,Жоғары спирт Сүлейменді шақырады. Қуат плюс 3000!
Dialogue: 0,0:14:31.09,0:14:33.09,Default,,0,0,0,,Қоңырау шалу!
Dialogue: 0,0:14:33.09,0:14:35.10,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:14:35.10,0:14:39.10,Default,,0,0,0,,Өзіңізді Жанға алыңыз. Сүлейменге қуат плюс 3000!
Dialogue: 0,0:14:39.10,0:14:41.10,Default,,0,0,0,,Береносқа қоңырау шалыңыз!
Dialogue: 0,0:14:41.10,0:14:43.10,Default,,0,0,0,,Хитеннің қасиетті рыцарь Альтомайлмен➡
Dialogue: 0,0:14:43.10,0:14:45.77,Default,,0,0,0,,Ай Рыцарь Азу Ферекстің шеберлігі!
Dialogue: 0,0:14:45.77,0:14:49.76,Default,,0,0,0,,Алдыңғы қатардағы барлық блоктар үшін жалпы қуат плюс 5000!
Dialogue: 0,0:14:49.76,0:14:52.43,Default,,0,0,0,,Гах... (Шион) Шабуыл!
Dialogue: 0,0:14:52.43,0:14:54.78,Default,,0,0,0,,Уау! Гррр...
Dialogue: 0,0:14:54.78,0:14:57.10,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:14:57.10,0:15:01.46,Default,,0,0,0,,Авангардқа триггер күші!
Dialogue: 0,0:15:01.46,0:15:03.48,Default,,0,0,0,,Altomail арқылы шабуыл!
Dialogue: 0,0:15:03.48,0:15:05.76,Default,,0,0,0,,Беренос шеберлігі іске қосылды!
Dialogue: 0,0:15:05.76,0:15:07.76,Default,,0,0,0,,1 карта ұтысы
Dialogue: 0,0:15:07.76,0:15:10.43,Default,,0,0,0,,Альтомиль үшін қуат плюс 5000!
Dialogue: 0,0:15:10.43,0:15:12.78,Default,,0,0,0,,Гуг... 5-ші зақым!
Dialogue: 0,0:15:12.78,0:15:15.12,Default,,0,0,0,,Онда осы жерде бөлісейік.
Dialogue: 0,0:15:15.12,0:15:22.13,Default,,0,0,0,,Күлуді тоқтатыңыз! Ерекшелік: Шинду Куроно Қаз-самаға құрбан болып, болашағынан айырылды.
Dialogue: 0,0:15:22.13,0:15:25.76,Default,,0,0,0,,Ол пионер!
Dialogue: 0,0:15:25.76,0:15:28.45,Default,,0,0,0,,Сіз және бұл әлем➡
Dialogue: 0,0:15:28.45,0:15:31.12,Default,,0,0,0,,Барлығы жоққа жабық!
Dialogue: 0,0:15:31.12,0:15:33.10,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:15:33.10,0:15:35.79,Default,,0,0,0,,ﾌｧｰｽﾄﾁｪｯｸ ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:15:35.79,0:15:38.79,Default,,0,0,0,,Емдеу триггері! Билік Сүлейменге жетеді
Dialogue: 0,0:15:38.79,0:15:41.78,Default,,0,0,0,,ｻｰﾄﾞﾁｪｯｸ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:15:41.78,0:15:44.20,Default,,0,0,0,,Барлық әсерлер Сүлейменге беріледі!
Dialogue: 0,0:15:44.20,0:15:46.12,Default,,0,0,0,,Сүлейменмен шабуыл!
Dialogue: 0,0:15:46.12,0:15:48.10,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:15:48.10,0:15:50.11,Default,,0,0,0,,Альбионға жоғары қоңырау шалыңыз!
Dialogue: 0,0:15:50.11,0:15:52.51,Default,,0,0,0,,Өзіңізге қуат плюс 2000!
Dialogue: 0,0:15:52.51,0:15:56.11,Default,,0,0,0,,Бұл туралы не деуге болады!
Dialogue: 0,0:15:56.11,0:15:59.63,Default,,0,0,0,,Ұрпақ сақшысы одан да қорғалған!
Dialogue: 0,0:15:59.63,0:16:03.18,Default,,0,0,0,,Құдайымыз жойылмас бұрын, Қаздар →
Dialogue: 0,0:16:03.18,0:16:06.10,Default,,0,0,0,,Дүние үнсіз
Dialogue: 0,0:16:06.10,0:16:09.46,Default,,0,0,0,,Дұрыс. Мен сол кезде білдім.
Dialogue: 0,0:16:09.46,0:16:14.15,Default,,0,0,0,,Басым күш, абсолютті тіршілік
Dialogue: 0,0:16:14.15,0:16:16.77,Default,,0,0,0,,Қорқыныш
Dialogue: 0,0:16:16.77,0:16:18.77,Default,,0,0,0,,Ашу
Dialogue: 0,0:16:18.77,0:16:20.77,Default,,0,0,0,,Қайғы
Dialogue: 0,0:16:20.77,0:16:23.44,Default,,0,0,0,,Жоқтау. Және...
Dialogue: 0,0:16:23.44,0:16:28.09,Default,,0,0,0,,Үмітсіздік пен жоғалту биледі
Dialogue: 0,0:16:28.09,0:16:30.76,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:16:30.76,0:16:36.13,Default,,0,0,0,,Мен ештеңе істей алмадым. Бірақ...
Dialogue: 0,0:16:36.13,0:16:39.19,Default,,0,0,0,,Мен алдымда тұрған нәрсеге таң қалдым.
Dialogue: 0,0:16:39.19,0:16:45.44,Default,,0,0,0,,Біздің алдымызда абсолютті болмысқа жабысуымыз керек.
Dialogue: 0,0:16:45.44,0:16:48.14,Default,,0,0,0,,Бұл жағдайда жай ғана араласыңыз!!
Dialogue: 0,0:16:50.43,0:16:53.43,Default,,0,0,0,,Дұрыс. Мен ойлаған сәтте...
Dialogue: 0,0:16:53.43,0:16:56.77,Default,,0,0,0,,Барлығы қуанышқа айналды!
Dialogue: 0,0:16:56.77,0:16:59.42,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:16:59.42,0:17:01.44,Default,,0,0,0,,Құрметті қаздар!!
Dialogue: 0,0:17:01.44,0:17:04.76,Default,,0,0,0,,Альбионда Валеосқа шабуыл жасаңыз!
Dialogue: 0,0:17:04.76,0:17:08.43,Default,,0,0,0,,Дағдыларды белсендіру. Сүлейменге керемет қоңырау!
Dialogue: 0,0:17:08.43,0:17:10.44,Default,,0,0,0,,Ха~!!
Dialogue: 0,0:17:10.44,0:17:12.44,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ！
Dialogue: 0,0:17:12.44,0:17:14.44,Default,,0,0,0,,Сүлейменмен шабуыл!
Dialogue: 0,0:17:14.44,0:17:17.43,Default,,0,0,0,,Дағдыны белсендіру. Үздік шақыру эскорты
Dialogue: 0,0:17:17.43,0:17:19.78,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000！
Dialogue: 0,0:17:19.78,0:17:22.11,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:17:22.11,0:17:25.12,Default,,0,0,0,,Эскортпен шабуыл!
Dialogue: 0,0:17:25.12,0:17:27.14,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ
Dialogue: 0,0:17:27.14,0:17:30.19,Default,,0,0,0,,А... бұрылыс соңы...
Dialogue: 0,0:17:30.19,0:17:33.11,Default,,0,0,0,,Мен шеше алмадым!
Dialogue: 0,0:17:33.11,0:17:36.43,Default,,0,0,0,,Нөлдік айдаһар келе жатыр
Dialogue: 0,0:17:36.43,0:17:39.46,Default,,0,0,0,,Хехе... хахаха... ахахаха!
Dialogue: 0,0:17:39.46,0:17:42.52,Default,,0,0,0,,Құны бойынша Vanguard картасымен бірдей
Dialogue: 0,0:17:42.52,0:17:46.44,Default,,0,0,0,,Менің болашағымды жеп, оны көрсет.
Dialogue: 0,0:17:46.44,0:17:49.61,Default,,0,0,0,,Ахахха... хахаха...
Dialogue: 0,0:17:49.61,0:17:52.76,Default,,0,0,0,,Megalanica Zero Dragon
Dialogue: 0,0:17:52.76,0:17:56.10,Default,,0,0,0,,ｱﾙﾃｨﾒｯﾄｽﾄﾗｲﾄﾞ！
Dialogue: 0,0:17:56.10,0:18:00.10,Default,,0,0,0,,Алыстағы теңіздегі Зелос айдаһары Мегидо!!
Dialogue: 0,0:18:06.12,0:18:10.50,Default,,0,0,0,,Мегидоның шеберлігі. Түсіру аймағынан 5 жоғары қоңырау
Dialogue: 0,0:18:10.50,0:18:14.12,Default,,0,0,0,,Барлығы үшін қуат плюс 5000!
Dialogue: 0,0:18:14.12,0:18:17.62,Default,,0,0,0,,Барлығын Гизе-самаға қалдыр!
Dialogue: 0,0:18:21.14,0:18:24.44,Default,,0,0,0,,Сонда сіз барлық нәрседен құтыласыз.
Dialogue: 0,0:18:24.44,0:18:27.43,Default,,0,0,0,,Бәрі жоғалады!!
Dialogue: 0,0:18:27.43,0:18:29.80,Default,,0,0,0,,Мегидо шеберлігі іске қосылды!
Dialogue: 0,0:18:29.80,0:18:32.12,Default,,0,0,0,,Позициялармен алмасу!
Dialogue: 0,0:18:32.12,0:18:35.79,Default,,0,0,0,,Арсенал флотымен шабуыл. Дағдыларды белсендіру
Dialogue: 0,0:18:35.79,0:18:37.79,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ4000
Dialogue: 0,0:18:39.76,0:18:44.18,Default,,0,0,0,,Осы айналымдағы екінші шабуыл. Арсенал флоты тұр!
Dialogue: 0,0:18:44.18,0:18:46.20,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:18:46.20,0:18:49.10,Default,,0,0,0,,Қорықпа! Қабыл ал!
Dialogue: 0,0:18:49.10,0:18:51.44,Default,,0,0,0,,Барлығын барлау кезінде күзет!
Dialogue: 0,0:18:51.44,0:18:54.46,Default,,0,0,0,,Қалқан плюс шеберлігі бар 5000
Dialogue: 0,0:18:54.46,0:18:57.49,Default,,0,0,0,,Арсенал флоты мен Валеос арасындағы позицияларды ауыстырыңыз
Dialogue: 0,0:18:57.49,0:19:00.78,Default,,0,0,0,,Күшті құтқару жойылу деп аталады
Dialogue: 0,0:19:00.78,0:19:04.47,Default,,0,0,0,,Қуаныш сізді толтырады!
Dialogue: 0,0:19:04.47,0:19:08.17,Default,,0,0,0,,Оны жеп ал. Бұл Қаз-саманың батасы!!
Dialogue: 0,0:19:10.10,0:19:12.11,Default,,0,0,0,,Ах…｡ Ах…
Dialogue: 0,0:19:12.11,0:19:14.11,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:19:14.11,0:19:19.10,Default,,0,0,0,,Не!? Мегидоның шабуылы... Кук... Кук...
Dialogue: 0,0:19:19.10,0:19:21.10,Default,,0,0,0,,ｶﾞﾚｱｽ！
Dialogue: 0,0:19:21.10,0:19:24.77,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ！ ｽﾚｲﾏﾝ！
Dialogue: 0,0:19:24.77,0:19:27.79,Default,,0,0,0,,Ой... уф... неге!
Dialogue: 0,0:19:27.79,0:19:32.68,Default,,0,0,0,,Киба Шион да, Альто Мэйл де елеусіз және осал тіршілік иелері.
Dialogue: 0,0:19:32.68,0:19:35.45,Default,,0,0,0,,Дегенмен бұл күш...
Dialogue: 0,0:19:35.45,0:19:38.83,Default,,0,0,0,,Яғни бірлік адамдардың ойларына жауап береді→
Dialogue: 0,0:19:38.83,0:19:41.87,Default,,0,0,0,,Адамдар бөлімнің ойларына жауап береді
Dialogue: 0,0:19:41.87,0:19:44.44,Default,,0,0,0,,Бұл біздің күшіміз. Бұл біздің күшіміз
Dialogue: 0,0:19:44.44,0:19:47.46,Default,,0,0,0,,Өйткені бұл біздің Авангардымыз! (Оған) Өйткені біз Авангардпыз!
Dialogue: 0,0:19:47.46,0:19:50.78,Default,,0,0,0,,Көшбасшының ойына немқұрайлы қарайтындар үшін→
Dialogue: 0,0:19:50.78,0:19:53.43,Default,,0,0,0,,Сіз ешқашан түсінбейсіз!
Dialogue: 0,0:19:53.43,0:19:56.78,Default,,0,0,0,,Ку… уф… осындай нәрсе…
Dialogue: 0,0:19:56.78,0:19:58.80,Default,,0,0,0,,Осындай нәрсе!!
Dialogue: 0,0:19:58.80,0:20:00.80,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:20:02.86,0:20:05.56,Default,,0,0,0,,Ух... уф... а...
Dialogue: 0,0:20:07.45,0:20:10.77,Default,,0,0,0,,Мен... өз мүмкіндігіме сенемін →
Dialogue: 0,0:20:10.77,0:20:14.12,Default,,0,0,0,,Мен бәрін қорғауға ант беріп, соғыстым.
Dialogue: 0,0:20:14.12,0:20:18.16,Default,,0,0,0,,Мені сондай альтомайл қызықтырды.
Dialogue: 0,0:20:18.16,0:20:21.44,Default,,0,0,0,,Менің де оған ұқсағым келеді.
Dialogue: 0,0:20:21.44,0:20:25.85,Default,,0,0,0,,Сол кездегі сезімдерім Альтомайл екеуміздің бастауымыз болды→
Dialogue: 0,0:20:25.85,0:20:29.25,Default,,0,0,0,,Ешқашан өзгермейтін болашақ
Dialogue: 0,0:20:31.09,0:20:33.79,Default,,0,0,0,,Бұл біздің сеніміміз.
Dialogue: 0,0:20:33.79,0:20:36.44,Default,,0,0,0,,Біз ешқашан берілмейміз!
Dialogue: 0,0:20:36.44,0:20:41.13,Default,,0,0,0,,Шешімді түрде жойыңыз... Жоюды қабылдамаңыз!
Dialogue: 0,0:20:41.13,0:20:44.53,Default,,0,0,0,,Және міндетті түрде осы қолдармен→
Dialogue: 0,0:20:44.53,0:20:47.53,Default,,0,0,0,,Болашақты қолға ал!!
Dialogue: 0,0:20:49.44,0:20:52.81,Default,,0,0,0,,Сонымен... бұл қылыш... Фидес
Dialogue: 0,0:20:52.81,0:20:55.09,Default,,0,0,0,,Бұл ақымақ!
Dialogue: 0,0:20:55.09,0:20:59.11,Default,,0,0,0,,Мен оны сеземін... ол өтіп жатыр.
Dialogue: 0,0:20:59.11,0:21:04.52,Default,,0,0,0,,Бейбітшілікті қалайтын екі планетада өмір сүретіндердің шынайы тілектері→
Dialogue: 0,0:21:04.52,0:21:07.47,Default,,0,0,0,,Күшсіздің даусын тыңда→
Dialogue: 0,0:21:07.47,0:21:10.43,Default,,0,0,0,,Күшсіздің ойын арқау →
Dialogue: 0,0:21:10.43,0:21:14.10,Default,,0,0,0,,Біз күресеміз! Барлығын қорғаңыз!
Dialogue: 0,0:21:14.10,0:21:16.10,Default,,0,0,0,,Ку…ку…
Dialogue: 0,0:21:16.10,0:21:21.49,Default,,0,0,0,,Ей, өлмейтін жан, нұрыңмен зұлымдықты жең!
Dialogue: 0,0:21:21.49,0:21:26.09,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｻﾞｼﾞｪﾈﾚｰｼｮﾝ!!
Dialogue: 0,0:21:26.09,0:21:29.09,Default,,0,0,0,,Өлмейтін қасиетті қылыш!
Dialogue: 0,0:21:31.11,0:21:34.67,Default,,0,0,0,,ﾌｨﾃﾞｽ
Dialogue: 0,0:21:34.67,0:21:37.79,Default,,0,0,0,,Не!? Fides?
Dialogue: 0,0:21:37.79,0:21:42.11,Default,,0,0,0,,Фидестің мәні қылышта емес, оның еркінде.
Dialogue: 0,0:21:42.11,0:21:45.61,Default,,0,0,0,,Және әркімнің еркін жүзеге асыру
Dialogue: 0,0:21:45.61,0:21:48.61,Default,,0,0,0,,Бұл Фидес!
Dialogue: 0,0:21:48.61,0:21:51.78,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:21:51.78,0:21:55.45,Default,,0,0,0,,Қайта тірілсең, оны қайтадан жойғанша.
Dialogue: 0,0:21:55.45,0:21:58.44,Default,,0,0,0,,Бұл менің жауапкершілігім
Dialogue: 0,0:21:58.44,0:22:00.81,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:22:00.81,0:22:05.10,Default,,0,0,0,,Палубадан теңдесі жоқ рыцарь Ливароны шақырыңыз!
Dialogue: 0,0:22:05.10,0:22:08.10,Default,,0,0,0,,Өлмейтін қасиетті қылыш Фидес шеберлігі!
Dialogue: 0,0:22:08.10,0:22:11.49,Default,,0,0,0,,Бұл бұрылыс кезінде Батыл шабуылы бар бөлімшелер →
Dialogue: 0,0:22:11.49,0:22:15.54,Default,,0,0,0,,Егер сізде бір Guardian болса, сіз күшке қарамастан соғыңыз.
Dialogue: 0,0:22:15.54,0:22:18.44,Default,,0,0,0,,Содан кейін мен 2 немесе одан да көп қамқоршыны ойнауым керек →
Dialogue: 0,0:22:18.44,0:22:22.11,Default,,0,0,0,,Бұл сіздің күзетші ойнай алмайтыныңызды білдіре ме? Апыр-ай!
Dialogue: 0,0:22:22.11,0:22:24.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:24.12,0:22:28.12,Default,,0,0,0,,Ферекс дағдылары. Барлық алдыңғы қатарлар үшін қуат плюс 2000!
Dialogue: 0,0:22:28.12,0:22:31.11,Default,,0,0,0,,Риваромен шабуыл!
Dialogue: 0,0:22:31.11,0:22:34.78,Default,,0,0,0,,Батыл. Греносқа жоғары қоңырау шалыңыз
Dialogue: 0,0:22:34.78,0:22:39.78,Default,,0,0,0,,Қазға жабысып, оның қолымен болашағыңды лақтырып тастадың!
Dialogue: 0,0:22:39.78,0:22:43.77,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ｡ ｶﾞｰﾄﾞ！
Dialogue: 0,0:22:43.77,0:22:46.10,Default,,0,0,0,,Мен сенен басқашамын
Dialogue: 0,0:22:46.10,0:22:49.12,Default,,0,0,0,,Ешқашан қашпа. Ешқашан берілме!
Dialogue: 0,0:22:49.12,0:22:51.78,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ｡ ｶﾞｰﾄﾞ！
Dialogue: 0,0:22:51.78,0:22:55.45,Default,,0,0,0,,Менің сенімім, мақтанышым, болашағым →
Dialogue: 0,0:22:55.45,0:23:01.10,Default,,0,0,0,,Оны ешқашан тастамаңыз! Өлмейтін қасиетті қылыш Фидеспен шабуыл жасаңыз!
Dialogue: 0,0:23:01.10,0:23:03.10,Default,,0,0,0,,ﾌﾞﾚｲﾌﾞ
Dialogue: 0,0:23:03.10,0:23:06.77,Default,,0,0,0,,Палубадан жоғары 3 карта шақыру!
Dialogue: 0,0:23:06.77,0:23:08.78,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ…
Dialogue: 0,0:23:08.78,0:23:11.11,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:23:11.11,0:23:13.13,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:23:13.13,0:23:15.17,Default,,0,0,0,,ﾌｧｰｽﾄﾁｪｯｸ
Dialogue: 0,0:23:15.17,0:23:18.20,Default,,0,0,0,,Критикалық триггер. Барлық әсерлер Fides-ке өтеді.
Dialogue: 0,0:23:18.20,0:23:20.12,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:23:20.12,0:23:23.77,Default,,0,0,0,,Критикалық триггер! Әсер Fides үшін бірдей.
Dialogue: 0,0:23:23.77,0:23:25.78,Default,,0,0,0,,ｻｰﾄﾞﾁｪｯｸ
Dialogue: 0,0:23:25.78,0:23:30.15,Default,,0,0,0,,Критикалық триггер! Барлық әсерлер Fides-ке өтеді!
Dialogue: 0,0:23:30.15,0:23:32.43,Default,,0,0,0,,Иә! Үш есе сын !!
Dialogue: 0,0:23:32.43,0:23:34.44,Default,,0,0,0,,Жарайды
Dialogue: 0,0:23:34.44,0:23:39.61,Default,,0,0,0,,Сонымен... бұл... Киба Шион...
Dialogue: 0,0:23:39.61,0:23:44.78,Default,,0,0,0,,Қанша қиын болса да, ауыр болса да→
Dialogue: 0,0:23:44.78,0:23:50.18,Default,,0,0,0,,Мен міндетті түрде көтерілемін! Ал сіз қалағанның бәрі →
Dialogue: 0,0:23:50.18,0:23:55.77,Default,,0,0,0,,Мен оны қолыммен ұстаймын! Өз еркіңіз бен күшіңізбен!
Dialogue: 0,0:23:55.77,0:24:00.85,Default,,0,0,0,,Менмендік! Және ашкөздік!
Dialogue: 0,0:24:00.85,0:24:03.10,Default,,0,0,0,,хабардар
Dialogue: 0,0:24:03.10,0:24:06.12,Default,,0,0,0,,Сонда да мен оны орындаймын.
Dialogue: 0,0:24:06.12,0:24:09.10,Default,,0,0,0,,Өз мүмкіндігіңізге сеніңіз!
Dialogue: 0,0:24:09.10,0:24:12.11,Default,,0,0,0,,ｼｵﾝ…
Dialogue: 0,0:24:12.11,0:24:15.11,Default,,0,0,0,,Мен қаздарды осы қылышпен жеңемін!
Dialogue: 0,0:24:15.11,0:24:17.11,Default,,0,0,0,,Гуо…
Dialogue: 0,0:24:17.11,0:24:19.76,Default,,0,0,0,,Және бәрін қорғаңыз!!
Dialogue: 0,0:24:19.76,0:24:22.18,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:24:22.18,0:24:24.79,Default,,0,0,0,,Ку…ку… Шион…
Dialogue: 0,0:24:24.79,0:24:26.77,Default,,0,0,0,,ｾ･ﾌｨﾆ
Dialogue: 0,0:24:26.77,0:24:29.47,Default,,0,0,0,,Уау!!
Dialogue: 0,0:24:38.10,0:24:40.43,Default,,0,0,0,,Яй Шион!
Dialogue: 0,0:24:40.43,0:24:44.79,Default,,0,0,0,,Жүрекке келіңіз! Дөңгеленіп тұрыңыз! Қатты жүріңіз!!
Dialogue: 0,0:24:44.79,0:24:47.44,Default,,0,0,0,,Эй... бір секундқа қойыңызшы, Хайме мырза.
Dialogue: 0,0:24:47.44,0:24:49.81,Default,,0,0,0,,Мен енді шыдай алмаймын! Егер сіз Хайме-сан болсаңыз...
Dialogue: 0,0:24:49.81,0:24:52.11,Default,,0,0,0,,Мен тоқтамаймын Мен тоқтамаймын! Жоғары биік!!
Dialogue: 0,0:24:52.11,0:24:54.12,Default,,0,0,0,,Хахахаха! Хахаха…｡ Ах…
Dialogue: 0,0:24:54.12,0:24:56.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:56.12,0:24:58.10,Default,,0,0,0,,Карточка!
Dialogue: 0,0:24:58.10,0:25:00.10,Default,,0,0,0,,Гуо~! Ку…
Dialogue: 0,0:25:00.10,0:25:04.11,Default,,0,0,0,,Киба Шион... сен...
Dialogue: 0,0:25:04.11,0:25:08.78,Default,,0,0,0,,Мен сені өлтіремін, Фидесті құртамын.
Dialogue: 0,0:25:08.78,0:25:13.43,Default,,0,0,0,,Барлығы қаз-сама үшін!
Dialogue: 0,0:25:13.43,0:25:16.09,Default,,0,0,0,,Гува…
Dialogue: 0,0:25:16.09,0:25:18.77,Default,,0,0,0,,Ах... Валеос!
Dialogue: 0,0:25:18.77,0:25:21.09,Default,,0,0,0,,ﾌｨﾃﾞｽ…
Dialogue: 0,0:25:21.09,0:25:23.09,Default,,0,0,0,,♬~
Dialogue: 0,0:25:32.45,0:25:36.82,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Екеуіңіздің аман болғаныңызға қуаныштымын.
Dialogue: 0,0:25:36.82,0:25:39.44,Default,,0,0,0,,Осыдан кейін не болады →
Dialogue: 0,0:25:39.44,0:25:43.46,Default,,0,0,0,,Хайме, Солтүстік Америка филиалына Zero Dragon картасын жеткізіңіз.
Dialogue: 0,0:25:43.46,0:25:46.45,Default,,0,0,0,,Ал Киба - →
Dialogue: 0,0:25:46.45,0:25:49.77,Default,,0,0,0,,Ибуки-саннан менің барғанымды қалайтыны туралы хабарлама бар.
Dialogue: 0,0:25:49.77,0:25:52.44,Default,,0,0,0,,Қайда барғыңыз келеді?
Dialogue: 0,0:25:52.44,0:25:56.09,Default,,0,0,0,,Ах. Синдо мен Анджо күтіп тұр.
Dialogue: 0,0:25:56.09,0:25:59.11,Default,,0,0,0,,Не? Куроно мен Токоха? Сонда кездескенше
Dialogue: 0,0:25:59.11,0:26:03.48,Default,,0,0,0,,《Мені күту》
Dialogue: 0,0:26:03.48,0:26:07.48,Default,,0,0,0,,Жаяу жүруді қайта бастау
Dialogue: 0,0:27:41.77,0:27:44.12,Default,,0,0,0,,Ах! Ах... аа... а...
Dialogue: 0,0:27:44.12,0:27:47.14,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:27:47.14,0:27:51.19,Default,,0,0,0,,Сіз ояусыз ба, қаз мырза?
Dialogue: 0,0:27:51.19,0:27:53.09,Default,,0,0,0,,ｷﾞｰｾﾞ…
Dialogue: 0,0:27:53.09,0:28:03.09,Default,,0,0,0,,♪♪～
Dialogue: 0,0:30:33.12,0:30:35.12,Default,,0,0,0,,Даусын жоғалтқан Канон →
Dialogue: 0,0:30:35.12,0:30:39.61,Default,,0,0,0,,Анамның кеңесімен ән мәтінін жазып көрдім.
Dialogue: 0,0:30:39.61,0:30:41.61,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:30:41.61,0:30:45.12,Default,,0,0,0,,Керемет Ғажайып жанкүйердің баласы жағымсыз адамға айналады
Dialogue: 0,0:30:45.12,0:30:47.94,Default,,0,0,0,,Әр адамның қолдауы мен күшті сезімі →
Dialogue: 0,0:30:47.94,0:30:53.11,Default,,0,0,0,,Жағымсыз аураны өшіргеннен кейін Канонның дауысы бұрынғы қалпына келеді!
Dialogue: 0,0:30:53.11,0:30:58.50,Default,,0,0,0,,Қайта тірілген Канон қосылып, бесеуміз баптадық.
Dialogue: 0,0:31:00.00,0:31:06.00,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory