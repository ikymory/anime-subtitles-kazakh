Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.26,0:01:11.70,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:11.70,0:01:17.87,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:17.87,0:01:20.57,Default,,0,0,0,,Мырзам...
Dialogue: 0,0:01:24.23,0:01:26.28,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:01:26.28,0:01:28.28,Default,,0,0,0,,ﾌｨﾃﾞｽ！
Dialogue: 0,0:04:46.56,0:04:50.38,Default,,0,0,0,,Құрметті Шион, мұнда неге келдің?
Dialogue: 0,0:04:50.38,0:04:55.37,Default,,0,0,0,,Мен Фидеске шақырылғандай болдым...
Dialogue: 0,0:04:55.37,0:04:59.71,Default,,0,0,0,,Жарқыраған қылыш Фидес Киба отбасында ұрпаққа мұра болып қалды.
Dialogue: 0,0:04:59.71,0:05:03.70,Default,,0,0,0,,Әділ зұлымдықты жеңеді
Dialogue: 0,0:05:03.70,0:05:08.70,Default,,0,0,0,,Жүректегі әлсіздерге көмектесу ерік-жігерінің символы
Dialogue: 0,0:05:08.70,0:05:12.71,Default,,0,0,0,,Егер Фидес Крей планетасынан келсе ше➡
Dialogue: 0,0:05:12.71,0:05:14.76,Default,,0,0,0,,Оның дифференциалды драйверге қатысы бар ма?
Dialogue: 0,0:05:14.76,0:05:18.36,Default,,0,0,0,,<<Осы жерде болды ма? (Ивакура) Иә?
Dialogue: 0,0:05:23.03,0:05:26.83,Default,,0,0,0,,Сіз кімсіз? Қауіпсіздік дегеніміз не?
Dialogue: 0,0:05:33.21,0:05:40.08,Default,,0,0,0,,Фидес бұл дүниеден мәңгілікке жоғалып кетуі керек.
Dialogue: 0,0:05:40.08,0:05:42.89,Default,,0,0,0,,Фидес мақсатты ма?
Dialogue: 0,0:05:42.89,0:05:46.86,Default,,0,0,0,,Фидес мұрагері, егер менің жолыма бөгет болсаң, мен де сені өшіремін!
Dialogue: 0,0:05:46.86,0:05:48.86,Default,,0,0,0,,Жоғал, Фидес!
Dialogue: 0,0:05:51.55,0:05:53.55,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:05:55.87,0:05:57.90,Default,,0,0,0,,Құрметті Шион!
Dialogue: 0,0:05:57.90,0:06:00.70,Default,,0,0,0,,Менің ойымша, бұл қарудың айырмашылығы...
Dialogue: 0,0:06:00.70,0:06:02.69,Default,,0,0,0,,Неліктен сіз Fides-ті нысанаға аласыз?
Dialogue: 0,0:06:02.69,0:06:06.58,Default,,0,0,0,,Раббым үшін. Мырза?
Dialogue: 0,0:06:06.58,0:06:10.70,Default,,0,0,0,,Сіз газды болат туралы айтып отырсыз ба? Гастиле біздің көшбасшымыз
Dialogue: 0,0:06:10.70,0:06:15.55,Default,,0,0,0,,Менің қожайыным ретінде бір ғана адам бар, ол қаз мырза.
Dialogue: 0,0:06:15.55,0:06:19.72,Default,,0,0,0,,Қаздар... Сендер елшілер қайта тірілуді жоспарлап жатырсыңдар➡
Dialogue: 0,0:06:19.72,0:06:22.22,Default,,0,0,0,,Жоюшы Құдай?
Dialogue: 0,0:06:26.20,0:06:31.55,Default,,0,0,0,,Сіз қаз-саманың қандай керемет екенін түсінбейсіз.
Dialogue: 0,0:06:31.55,0:06:46.65,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:46.65,0:06:49.89,Default,,0,0,0,,)
Dialogue: 0,0:06:49.89,0:06:57.86,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:57.86,0:07:00.36,Default,,0,0,0,,Сонда мен түсіндім
Dialogue: 0,0:07:00.36,0:07:07.45,Default,,0,0,0,,Біздің алдымызда тұрған абсолютті болмысқа жабысуымыз керек.
Dialogue: 0,0:07:07.45,0:07:11.69,Default,,0,0,0,,Қаз-саманың құдіретінің алдында бәрі түкке тұрғысыз.
Dialogue: 0,0:07:11.69,0:07:14.23,Default,,0,0,0,,Бағынудан басқа амал жоқ
Dialogue: 0,0:07:14.23,0:07:19.20,Default,,0,0,0,,Қаз-сама жойылуды қаласа, оның еркін орындау керек.
Dialogue: 0,0:07:19.20,0:07:21.19,Default,,0,0,0,,ﾌﾝ…
Dialogue: 0,0:07:21.19,0:07:23.72,Default,,0,0,0,,Бірақ неге Фидес?
Dialogue: 0,0:07:23.72,0:07:25.86,Default,,0,0,0,,Жауабы осында
Dialogue: 0,0:07:25.86,0:07:28.34,Default,,0,0,0,,Fides жою
Dialogue: 0,0:07:28.34,0:07:30.21,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:07:30.21,0:07:33.21,Default,,0,0,0,,Жекпе-жекке шығайық!
Dialogue: 0,0:07:36.37,0:07:40.87,Default,,0,0,0,,Жекпе-жекте жеңіске жетіңіз және дифридті бірлікті сазға қайтарыңыз
Dialogue: 0,0:07:40.87,0:07:45.53,Default,,0,0,0,,Бұл сіздің жоспарларыңызды бұзып, Фидесті қорғайды.
Dialogue: 0,0:07:45.53,0:07:47.53,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:07:47.53,0:07:50.55,Default,,0,0,0,,Аквафорт маршалы Валеос
Dialogue: 0,0:07:50.55,0:07:52.55,Default,,0,0,0,,ｳﾞｧﾚｵｽ…
Dialogue: 0,0:07:54.55,0:07:58.86,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｻﾞ ｳﾞｧﾝｶﾞｰﾄﾞ！ ｽﾀﾝﾄﾞｱｯﾌﾟ ｾﾞｯﾄ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:07:58.86,0:08:01.73,Default,,0,0,0,,Үйретілген рыцарь Аректус!
Dialogue: 0,0:08:01.73,0:08:04.03,Default,,0,0,0,,Аонами жаңадан келген Кости!
Dialogue: 0,0:08:04.03,0:08:07.72,Default,,0,0,0,,Адал рыцарь Диотиусқа мініңіз!
Dialogue: 0,0:08:07.72,0:08:10.68,Default,,0,0,0,,Беллагиоға бару
Dialogue: 0,0:08:10.68,0:08:14.59,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:08:14.59,0:08:17.29,Default,,0,0,0,,Ха~! Уф...
Dialogue: 0,0:08:19.53,0:08:22.53,Default,,0,0,0,,Альбион рыцарь мініңіз!
Dialogue: 0,0:08:22.53,0:08:24.53,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:08:24.53,0:08:28.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:28.54,0:08:30.55,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ
Dialogue: 0,0:08:30.55,0:08:33.91,Default,,0,0,0,,Аонами Суйшо Галеасқа мініңіз
Dialogue: 0,0:08:33.91,0:08:35.91,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:08:35.91,0:08:37.91,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:08:40.30,0:08:42.30,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:08:45.87,0:08:49.19,Default,,0,0,0,,《Олар оны әлі орнатпаған болса...》
Dialogue: 0,0:08:49.19,0:08:51.21,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ
Dialogue: 0,0:08:51.21,0:08:53.19,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:08:53.19,0:08:55.38,Default,,0,0,0,,Патшалық, менің жаңа қылышым!
Dialogue: 0,0:08:55.38,0:08:57.72,Default,,0,0,0,,Тағдырдың рыцарь Альто-Мэйл!
Dialogue: 0,0:08:57.72,0:08:59.72,Default,,0,0,0,,Бұл сіздің басқа эгоңыз ба?
Dialogue: 0,0:08:59.72,0:09:01.77,Default,,0,0,0,,Altomail арқылы шабуыл!
Dialogue: 0,0:09:01.77,0:09:03.80,Default,,0,0,0,,Беренос дағдылары!
Dialogue: 0,0:09:03.80,0:09:05.69,Default,,0,0,0,,Бұл құрылғыны Сеулге апарыңыз
Dialogue: 0,0:09:05.69,0:09:07.69,Default,,0,0,0,,ﾄﾞﾛｰ
Dialogue: 0,0:09:07.69,0:09:09.71,Default,,0,0,0,,Альтомиль үшін қуат плюс 5000!
Dialogue: 0,0:09:09.71,0:09:11.70,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:09:11.70,0:09:13.71,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:09:13.71,0:09:16.38,Default,,0,0,0,,Барлық Critical Trigger эффектілері сіздің альто-поштаңызда!
Dialogue: 0,0:09:16.38,0:09:18.38,Default,,0,0,0,,Уф! Жақсы...
Dialogue: 0,0:09:20.55,0:09:24.24,Default,,0,0,0,,Мені жеңгіңіз келсе, Фидесті пайдаланыңыз.
Dialogue: 0,0:09:24.24,0:09:27.24,Default,,0,0,0,,Сізге Фидес қатты ұнайтын сияқты.
Dialogue: 0,0:09:27.24,0:09:31.24,Default,,0,0,0,,Сазда өмір сүретін біздер ешқашан ұмытпаймыз.
Dialogue: 0,0:09:33.22,0:09:35.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:35.22,0:09:37.89,Default,,0,0,0,,Балшық планетасы!?
Dialogue: 0,0:09:37.89,0:09:42.29,Default,,0,0,0,,Бір кездері Қаз-сама және біз елшілер → болатын
Dialogue: 0,0:09:42.29,0:09:46.23,Default,,0,0,0,,Дүние жойылу шегіне жеткізілді.
Dialogue: 0,0:09:46.23,0:09:51.24,Default,,0,0,0,,Алты нөлдік айдаһар біздің күшімізге айналды.
Dialogue: 0,0:09:51.24,0:09:54.54,Default,,0,0,0,,Элементтердің массасынан Қаз-сама оны жасады→
Dialogue: 0,0:09:54.54,0:09:57.56,Default,,0,0,0,,Бұл ең күшті айдаһар.
Dialogue: 0,0:09:57.56,0:10:03.23,Default,,0,0,0,,Бірақ біреу ақымақтықпен бізге шабуыл жасамақ болды.
Dialogue: 0,0:10:03.23,0:10:09.25,Default,,0,0,0,,Бұл Мәсіх, жаратушы құдай және оған қосылғандар.
Dialogue: 0,0:10:09.25,0:10:12.22,Default,,0,0,0,,Қаз-сама қирау мен хаос тудырады.
Dialogue: 0,0:10:12.22,0:10:16.82,Default,,0,0,0,,Өйткені Мәсіх жаратылысқа қарама-қарсы және тәртіпті басқарады...
Dialogue: 0,0:10:20.25,0:10:23.80,Default,,0,0,0,,Фидестен жеңілгеннен кейін→
Dialogue: 0,0:10:23.80,0:10:28.90,Default,,0,0,0,,Біздің әскер күшінен айырылды, Қаз мырза мөрмен жабылды.
Dialogue: 0,0:10:31.73,0:10:34.88,Default,,0,0,0,,Барлық жауапкершілік менде.
Dialogue: 0,0:10:34.88,0:10:40.55,Default,,0,0,0,,Жарқыраған Фидес қылыш. Бір қылыш үшін...
Dialogue: 0,0:10:40.55,0:10:43.54,Default,,0,0,0,,Жек көру. Сондықтан сіз Fides-ті нысанаға алып отырсыз ба?
Dialogue: 0,0:10:43.54,0:10:45.92,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:10:45.92,0:10:48.46,Default,,0,0,0,,Бұл жеке кек емес.
Dialogue: 0,0:10:48.46,0:10:51.38,Default,,0,0,0,,Бұл менің мырзам, Қаз-сама үшін.
Dialogue: 0,0:10:51.38,0:10:55.88,Default,,0,0,0,,Қаз-самаға қауіп төндіретін болмысты жою.
Dialogue: 0,0:10:57.89,0:10:59.89,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:10:59.89,0:11:02.86,Default,,0,0,0,,Гүрілдеген шексіз көк толқындар
Dialogue: 0,0:11:02.86,0:11:05.93,Default,,0,0,0,,Маршал Аонами Валеос!
Dialogue: 0,0:11:05.93,0:11:10.33,Default,,0,0,0,,Бұл Валеос... нағыз сен бе?
Dialogue: 0,0:12:51.57,0:12:54.58,Default,,0,0,0,,Міне. Менің AquaForce-тің күші
Dialogue: 0,0:12:54.58,0:12:59.88,Default,,0,0,0,,Қирауға әкелетін көк соққы! Қадам ұрпақ!!
Dialogue: 0,0:13:05.86,0:13:10.88,Default,,0,0,0,,Көк толқын Маршал Айдаһар Су тасқыны қаупі Айдаһар
Dialogue: 0,0:13:10.88,0:13:14.87,Default,,0,0,0,,ﾌﾗｯﾄﾞﾊｻﾞｰﾄﾞ･ﾄﾞﾗｺﾞﾝ…
Dialogue: 0,0:13:14.87,0:13:17.31,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ
Dialogue: 0,0:13:17.31,0:13:20.53,Default,,0,0,0,,Сіздің Авангардыңыз 11000 қуатта бекітілген.
Dialogue: 0,0:13:20.53,0:13:23.20,Default,,0,0,0,,Қарғыс атсын... бұл...
Dialogue: 0,0:13:23.20,0:13:27.20,Default,,0,0,0,,Зақымдану триггері пайда болса да, қуат өспейді.
Dialogue: 0,0:13:27.20,0:13:30.87,Default,,0,0,0,,Сонымен қатар, қарсылас үздіксіз шабуылдарға маманданған Aqua Force.
Dialogue: 0,0:13:30.87,0:13:32.87,Default,,0,0,0,,Шион мырза...
Dialogue: 0,0:13:32.87,0:13:37.88,Default,,0,0,0,,Абсолютті әділеттіліктің жеңілмейтін қаруы, Аквафортты мен жасадым.
Dialogue: 0,0:13:37.88,0:13:41.53,Default,,0,0,0,,Бұл сіз білетін AquaForce-тен өзгеше.
Dialogue: 0,0:13:41.53,0:13:43.53,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:13:43.53,0:13:46.20,Default,,0,0,0,,ｺｰﾙ
Dialogue: 0,0:13:46.20,0:13:48.52,Default,,0,0,0,,Жарқыраған шабуыл
Dialogue: 0,0:13:48.52,0:13:51.19,Default,,0,0,0,,Екі дағдыны меңгеру
Dialogue: 0,0:13:51.19,0:13:53.61,Default,,0,0,0,,1 дағды
Dialogue: 0,0:13:53.61,0:13:57.31,Default,,0,0,0,,Егер бұл бұрылыстағы бірінші шабуыл болса, Гарерт тұрады.
Dialogue: 0,0:14:00.22,0:14:02.25,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:14:02.25,0:14:04.87,Default,,0,0,0,,Стандартты құралмен эскортқа шабуыл жасаңыз!
Dialogue: 0,0:14:04.87,0:14:06.87,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:14:08.88,0:14:13.55,Default,,0,0,0,,Үмітсіздіктің терең теңізіндегі жаңғырық, өлімнің көк шуы!
Dialogue: 0,0:14:13.55,0:14:17.70,Default,,0,0,0,,Көк толқын Маршалы Айдаһар Су тасқыны Айдаһарымен шабуыл!
Dialogue: 0,0:14:17.70,0:14:20.37,Default,,0,0,0,,Галиастың екінші шеберлігі
Dialogue: 0,0:14:20.37,0:14:23.04,Default,,0,0,0,,Авангард шабуыл жасағанда Stand
Dialogue: 0,0:14:23.04,0:14:25.39,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000！
Dialogue: 0,0:14:25.39,0:14:28.41,Default,,0,0,0,,Бір бөлімше үш рет шабуыл жасайды!?
Dialogue: 0,0:14:28.41,0:14:31.47,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ｡ ﾄﾞﾛｰﾄﾘｶﾞｰ
Dialogue: 0,0:14:31.47,0:14:33.40,Default,,0,0,0,,Қуат шыныда
Dialogue: 0,0:14:33.40,0:14:35.57,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ ｻｰﾄﾞﾁｪｯｸ
Dialogue: 0,0:14:35.57,0:14:39.57,Default,,0,0,0,,Критикалық триггер. Барлық әсерлер су тасқыны қаупі айдаһарында.
Dialogue: 0,0:14:44.58,0:14:46.58,Default,,0,0,0,,ｸｯ…
