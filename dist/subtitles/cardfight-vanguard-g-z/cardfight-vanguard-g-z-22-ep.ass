Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.12,0:01:05.14,Default,,0,0,0,,Біздің болашағымызды жасаңыз!
Dialogue: 0,0:01:05.14,0:01:11.56,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:11.56,0:01:14.45,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:14.45,0:01:18.75,Default,,0,0,0,,Кеттік! Қараңдаршы, басшымыз бара жатыр.
Dialogue: 0,0:01:27.11,0:01:33.90,Default,,0,0,0,,Қаздар... Қаздар! Сізбен...
Dialogue: 0,0:01:33.90,0:01:36.10,Default,,0,0,0,,Корпус мүшелеріне бір-біріне негізсіз қылыш кезенуге мүлде болмайды!
Dialogue: 0,0:04:55.05,0:04:57.09,Default,,0,0,0,,Әлемнің ақиқаты➡
Dialogue: 0,0:04:57.09,0:04:59.61,Default,,0,0,0,,бәрін шешеді
Dialogue: 0,0:04:59.61,0:05:04.56,Default,,0,0,0,,Авангардтың астында
Dialogue: 0,0:05:04.56,0:05:08.73,Default,,0,0,0,,Мәсіхтің батасын алған көшбасшылар
Dialogue: 0,0:05:08.73,0:05:11.23,Default,,0,0,0,,Өз тілектеріңізге жауап беріңіз
Dialogue: 0,0:05:13.74,0:05:15.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:15.76,0:05:19.41,Default,,0,0,0,,Осы шайқастан кейін Мәсіхтің тағдыры аяқталды➡
Dialogue: 0,0:05:19.41,0:05:23.21,Default,,0,0,0,,Әрбір себеп пен салдар жоққа айналады
Dialogue: 0,0:05:31.22,0:05:34.57,Default,,0,0,0,,Дүние, үндеме.
Dialogue: 0,0:05:34.57,0:05:37.63,Default,,0,0,0,,Мен әкелемін...
Dialogue: 0,0:05:37.63,0:05:40.13,Default,,0,0,0,,Жойылғанға дейін
Dialogue: 0,0:05:42.07,0:05:44.25,Default,,0,0,0,,Біздің ертеңіміз үшін
Dialogue: 0,0:05:44.25,0:05:47.59,Default,,0,0,0,,Бізді күтіп отырғандардың барлығына
Dialogue: 0,0:05:47.59,0:05:50.24,Default,,0,0,0,,Оны шешіңіз!
Dialogue: 0,0:05:50.24,0:05:52.41,Default,,0,0,0,,Тұр! (Касума) жинағы
Dialogue: 0,0:05:52.41,0:05:55.11,Default,,0,0,0,,ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:05:58.80,0:06:02.59,Default,,0,0,0,,ﾈｵﾝｷﾞｰｾﾞ
Dialogue: 0,0:06:02.59,0:06:04.59,Default,,0,0,0,,ｸﾛﾉ･ﾄﾞﾗﾝ･Ｚ！
Dialogue: 0,0:06:12.05,0:06:15.88,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:06:15.88,0:06:18.90,Default,,0,0,0,,《Басталды...》
Dialogue: 0,0:06:18.90,0:06:22.26,Default,,0,0,0,,Біздің әлем және Крей планетасы➡
Dialogue: 0,0:06:22.26,0:06:26.31,Default,,0,0,0,,Барлығының тағдырын шешетін шешуші шайқас...
Dialogue: 0,0:06:26.31,0:06:30.73,Default,,0,0,0,,Уайымдамаңыз. Олар міндетті түрде жасайды.
Dialogue: 0,0:06:30.73,0:06:33.63,Default,,0,0,0,,Мен мұны сұрадым.
Dialogue: 0,0:06:37.22,0:06:39.64,Default,,0,0,0,,Олар Қаздарды жеңгенше➡
Dialogue: 0,0:06:39.64,0:06:43.06,Default,,0,0,0,,Біз мүмкіндігінше бос орындарды жеңеміз!
Dialogue: 0,0:06:43.06,0:06:45.23,Default,,0,0,0,,Келе беріңіз!
Dialogue: 0,0:06:45.23,0:06:49.60,Default,,0,0,0,,Бостық менің әділдігімнің жауы емес!
Dialogue: 0,0:06:49.60,0:06:52.12,Default,,0,0,0,,ﾊｧ ﾊｧ…
Dialogue: 0,0:06:52.12,0:06:55.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:55.56,0:06:58.66,Default,,0,0,0,,Балалар, тезірек ішке кіріңдер!
Dialogue: 0,0:07:04.56,0:07:07.73,Default,,0,0,0,,Ей, сенің қолыңнан келеді.
Dialogue: 0,0:07:07.73,0:07:11.63,Default,,0,0,0,,Бұл жігіт шексіз.
Dialogue: 0,0:07:14.37,0:07:16.39,Default,,0,0,0,,Сіз мені күтуге мәжбүр еттіңіз!
Dialogue: 0,0:07:16.39,0:07:19.56,Default,,0,0,0,,Драен бұтағын кім қорғайды?
Dialogue: 0,0:07:19.56,0:07:23.42,Default,,0,0,0,,Біз Үштік Айдаһармыз! (Ояма) Мамору!
Dialogue: 0,0:07:23.42,0:07:25.44,Default,,0,0,0,,Штаб туралы не деуге болады?
Dialogue: 0,0:07:25.44,0:07:30.06,Default,,0,0,0,,Бас кеңсе маған ру басшысы ретінде Доран филиалын қорғау керектігін айтты.
Dialogue: 0,0:07:30.06,0:07:33.41,Default,,0,0,0,,Бізде толық мүшелер болмағанына көп уақыт болды.
Dialogue: 0,0:07:33.41,0:07:37.40,Default,,0,0,0,,Жарайды, мен оны бірден кері итеремін! (3 адам) О!
Dialogue: 0,0:07:37.40,0:07:40.60,Default,,0,0,0,,《Мамору: Ибуки-кун, сен де абай бол...》
Dialogue: 0,0:07:47.21,0:07:49.24,Default,,0,0,0,,Уа!
Dialogue: 0,0:07:49.24,0:07:52.40,Default,,0,0,0,,Әділет жауынгері Маска де Маскара келді!
Dialogue: 0,0:07:52.40,0:07:55.55,Default,,0,0,0,,ﾊｲﾒ！
Dialogue: 0,0:07:55.55,0:07:57.57,Default,,0,0,0,,А, айналайын➡
Dialogue: 0,0:07:57.57,0:08:00.07,Default,,0,0,0,,Секундтарда шынайы тұлғаңызды ашпаңыз!
Dialogue: 0,0:08:00.07,0:08:03.06,Default,,0,0,0,,Мен саған көмектесуге келдім, Энишиччи.
Dialogue: 0,0:08:03.06,0:08:05.36,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:09.73,0:08:12.92,Default,,0,0,0,,Жарайды, мен сені бар күшіммен ұрамын!
Dialogue: 0,0:08:12.92,0:08:15.79,Default,,0,0,0,,Мен Амиголардан жеңілуге ​​шамасы жоқ!
Dialogue: 0,0:08:15.79,0:08:18.79,Default,,0,0,0,,Мен сені енді босқа ғашық болуға жол бермеймін!
Dialogue: 0,0:08:27.08,0:08:29.08,Default,,0,0,0,,ｶｽﾞﾏ…
Dialogue: 0,0:08:33.59,0:08:38.11,Default,,0,0,0,,Бұл менің рөлім болса да, мен қиын уақыт болды деп айта алмаймын➡
Dialogue: 0,0:08:38.11,0:08:40.41,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:08:44.25,0:08:47.90,Default,,0,0,0,,ﾗｲﾄﾞ！ ﾊﾟﾙｻｰﾒﾘｰﾌﾞﾛｯｸ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:08:47.90,0:08:50.10,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:08:52.89,0:08:55.56,Default,,0,0,0,,Өзгертілген триггер әсері
Dialogue: 0,0:08:55.56,0:09:00.43,Default,,0,0,0,,Нөлдік айдаһарды байлау
Dialogue: 0,0:09:00.43,0:09:02.45,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:02.45,0:09:05.74,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:09:05.74,0:09:08.59,Default,,0,0,0,,《Мені қиратушы айдаһар құдай Қаздар басып бара жатқанда➡
Dialogue: 0,0:09:08.59,0:09:12.91,Default,,0,0,0,,Оның келесі бұрылысының басында➡
Dialogue: 0,0:09:12.91,0:09:15.41,Default,,0,0,0,,Жеңіліс дерлік сенімді》
Dialogue: 0,0:09:19.08,0:09:22.88,Default,,0,0,0,,《Оның алдында қалпақ киіңіз! 》
Dialogue: 0,0:09:24.94,0:09:28.24,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:09:28.24,0:09:31.08,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:09:31.08,0:09:33.18,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:35.63,0:09:37.93,Default,,0,0,0,,ｶｽﾞﾏ…
Dialogue: 0,0:09:40.40,0:09:44.41,Default,,0,0,0,,((Касума: Ол толып қалды. Енді мұны істеудің қажеті жоқ.
Dialogue: 0,0:09:44.41,0:09:47.89,Default,,0,0,0,,Мұның несі жақсы? ))
Dialogue: 0,0:09:47.89,0:09:51.90,Default,,0,0,0,,Мен оларды ұқсас деп ойладым.
Dialogue: 0,0:09:51.90,0:09:55.10,Default,,0,0,0,,Сол кезде менімен бірге...
Dialogue: 0,0:09:57.07,0:09:59.57,Default,,0,0,0,,Болашақ үшін сіз қолға алғыңыз келеді!
Dialogue: 0,0:09:59.57,0:10:02.91,Default,,0,0,0,,ﾗｲﾄﾞ！ ｸﾛﾉｼﾞｪｯﾄ･ﾄﾞﾗｺﾞﾝ･Ｚ！
Dialogue: 0,0:10:02.91,0:10:09.73,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:09.73,0:10:12.24,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:10:12.24,0:10:15.22,Default,,0,0,0,,ﾒﾀﾊﾟﾙｻｰｱｳﾞﾆｰﾙ･ﾌｪﾆｯｸｽ！
Dialogue: 0,0:10:15.22,0:10:22.23,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:22.23,0:10:24.23,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:10:24.23,0:10:26.93,Default,,0,0,0,,Морфессаны палубаның түбіне қойыңыз!
Dialogue: 0,0:10:29.05,0:10:32.24,Default,,0,0,0,,Бір дәреже жоғары картамен жоғары қоңырау!
Dialogue: 0,0:10:32.24,0:10:34.24,Default,,0,0,0,,Көңілді блоктау дағдылары!
Dialogue: 0,0:10:34.24,0:10:37.89,Default,,0,0,0,,Бұл құрылғыны палубадан 3-сынып деп атаңыз!
Dialogue: 0,0:10:37.89,0:10:39.90,Default,,0,0,0,,Қосымша қоңыраулар!
Dialogue: 0,0:10:39.90,0:10:41.90,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:10:41.90,0:10:46.29,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:46.29,0:10:48.82,Default,,0,0,0,,Бірақ сіз...
Dialogue: 0,0:10:48.82,0:10:51.91,Default,,0,0,0,,Бұл мәңгілік тоқтаған жоқ.
Dialogue: 0,0:10:51.91,0:10:57.95,Default,,0,0,0,,Ұрысқан сайын достарымыз көбейіп, бәріміз бірге күшейеміз➡
Dialogue: 0,0:10:57.95,0:11:01.08,Default,,0,0,0,,Сіз өзіңіз қалаған адам бола алатыныңызға сенімдімін.
Dialogue: 0,0:11:01.08,0:11:05.68,Default,,0,0,0,,Ұстағың келетін болашақтың бар екеніне сену жақсы.
Dialogue: 0,0:11:09.61,0:11:13.90,Default,,0,0,0,,Мен де солай болдым.
Dialogue: 0,0:11:13.90,0:11:16.23,Default,,0,0,0,,Авенир шеберлігі іске қосылды!
Dialogue: 0,0:11:16.23,0:11:18.57,Default,,0,0,0,,ｽﾍﾟﾘｵﾙｺｰﾙ！
Dialogue: 0,0:11:18.57,0:11:21.42,Default,,0,0,0,,Мен Авангардтан не алдым➡
Dialogue: 0,0:11:21.42,0:11:23.72,Default,,0,0,0,,Мен де сізге айтқым келді.
Dialogue: 0,0:11:29.06,0:11:31.40,Default,,0,0,0,,Қолыңызды созсаңыз, ол сонда.
Dialogue: 0,0:11:31.40,0:11:33.90,Default,,0,0,0,,Мен, сен...
Dialogue: 0,0:11:33.90,0:11:37.25,Default,,0,0,0,,Мен қолға алғым келген болашақ!
Dialogue: 0,0:11:37.25,0:11:40.32,Default,,0,0,0,,Әлі жоқ! Найзаның басымен шабуыл жасаңыз!
Dialogue: 0,0:11:40.32,0:11:42.23,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:11:42.23,0:11:44.23,Default,,0,0,0,,Ең жақсы алкоголь!
Dialogue: 0,0:11:46.23,0:11:49.40,Default,,0,0,0,,Касума, мен саған...!
Dialogue: 0,0:11:49.40,0:11:51.40,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ
Dialogue: 0,0:11:54.09,0:11:56.07,Default,,0,0,0,,ｼﾞｬｯｶﾙ！
Dialogue: 0,0:11:56.07,0:11:58.07,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:12:01.24,0:12:04.14,Default,,0,0,0,,Бұл нәтиже.
Dialogue: 0,0:12:08.40,0:12:13.10,Default,,0,0,0,,Қолыңды созған, жол көрсеткен болашақ бар.
Dialogue: 0,0:12:20.90,0:12:25.10,Default,,0,0,0,,Сингулярлық Синдо Хроно
Dialogue: 0,0:14:09.06,0:14:11.44,Default,,0,0,0,,Егер мен сені ешқашан кездестірмесем➡
Dialogue: 0,0:14:11.44,0:14:15.73,Default,,0,0,0,,Ол кісі Қазға айналған жоқ.
Dialogue: 0,0:14:15.73,0:14:19.73,Default,,0,0,0,,Дүниеде бос орын пайда болған жоқ.
Dialogue: 0,0:14:23.24,0:14:26.41,Default,,0,0,0,,Қадам генерациясы. Ах!
Dialogue: 0,0:14:26.41,0:14:29.11,Default,,0,0,0,,ﾄﾞﾗｸﾞｱﾋﾞｽﾙｱｰﾄﾞ
Dialogue: 0,0:14:33.56,0:14:36.66,Default,,0,0,0,,Сіз бәрін бұрмаладыңыз.
Dialogue: 0,0:14:38.90,0:14:41.95,Default,,0,0,0,,Кедергі құлағанда...
Dialogue: 0,0:14:41.95,0:14:45.75,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:14:47.73,0:14:49.90,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:14:49.90,0:14:53.57,Default,,0,0,0,,Қос диск 1 зақымдануын қалпына келтіру
Dialogue: 0,0:14:53.57,0:14:57.37,Default,,0,0,0,,«Нөлдік айдаһарды байлау».
Dialogue: 0,0:14:59.56,0:15:02.06,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:15:02.06,0:15:05.39,Default,,0,0,0,,Нөлдік айдаһарды байлау
Dialogue: 0,0:15:05.39,0:15:07.40,Default,,0,0,0,,Морфесаға қатысты сын
Dialogue: 0,0:15:07.40,0:15:09.38,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:15:09.38,0:15:11.38,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:15:11.38,0:15:14.07,Default,,0,0,0,,《Тыл сақшыларына сын бердім.
Dialogue: 0,0:15:14.07,0:15:16.41,Default,,0,0,0,,Қаздармен➡ шешіп алғыңыз келсе
Dialogue: 0,0:15:16.41,0:15:20.11,Default,,0,0,0,,Бұл 2 ұпай зақымдану жеткілікті дегенді білдіре ме?
Dialogue: 0,0:15:22.06,0:15:24.06,Default,,0,0,0,,Оны атамаңыз!
Dialogue: 0,0:15:27.72,0:15:30.40,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ
Dialogue: 0,0:15:30.40,0:15:33.72,Default,,0,0,0,,Аюлы үкі Жоғары шақыру
Dialogue: 0,0:15:33.72,0:15:37.58,Default,,0,0,0,,Ноэльге шегіну
Dialogue: 0,0:15:37.58,0:15:40.43,Default,,0,0,0,,Abyssalard дағдыларын сүйреңіз
Dialogue: 0,0:15:40.43,0:15:46.00,Default,,0,0,0,,ｽﾍﾟﾘｵﾙｺｰﾙ ﾃﾞｨﾙﾗﾄﾞ ｲｳﾊﾙﾊﾞ➡
Dialogue: 0,0:15:46.00,0:15:48.50,Default,,0,0,0,,Катринаны шегіндіріңіз
Dialogue: 0,0:15:50.37,0:15:53.23,Default,,0,0,0,,《Гүлденген тұқымдар...》
Dialogue: 0,0:15:53.23,0:15:58.76,Default,,0,0,0,,Nice's Burst Dillard көмегімен Авангардқа шабуыл жасаңыз
Dialogue: 0,0:15:58.76,0:16:01.57,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ！
Dialogue: 0,0:16:01.57,0:16:05.40,Default,,0,0,0,,Сіз кездеспеуіңіз керек еді
Dialogue: 0,0:16:05.40,0:16:08.96,Default,,0,0,0,,Дагзамен бірге Авангардқа шабуыл жасаңыз
Dialogue: 0,0:16:08.96,0:16:13.21,Default,,0,0,0,,Дағдыны белсендіру Қажеттілікті қайтару
Dialogue: 0,0:16:13.21,0:16:16.90,Default,,0,0,0,,ｽﾍﾟﾘｵﾙｺｰﾙ
Dialogue: 0,0:16:16.90,0:16:19.09,Default,,0,0,0,,Қасума Тоқайрин мен...
Dialogue: 0,0:16:19.09,0:16:21.09,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ！
Dialogue: 0,0:16:24.44,0:16:26.74,Default,,0,0,0,,Қатысқан барлық достармен...
Dialogue: 0,0:16:29.25,0:16:31.25,Default,,0,0,0,,Авангард және...
Dialogue: 0,0:16:39.42,0:16:43.22,Default,,0,0,0,,Бұл сіздің болашағыңыз болуы керек.
Dialogue: 0,0:16:50.38,0:16:53.74,Default,,0,0,0,,Авангардқа Drag Abyss Guard көмегімен шабуыл жасаңыз
Dialogue: 0,0:16:53.74,0:16:56.22,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:16:56.22,0:16:58.74,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:16:58.74,0:17:01.74,Default,,0,0,0,,Нөлдік айдаһарды байлау
Dialogue: 0,0:17:04.56,0:17:08.23,Default,,0,0,0,,Нөлдік айдаһарды байлау
Dialogue: 0,0:17:08.23,0:17:11.40,Default,,0,0,0,,5 нөлдік айдаһар бар...
Dialogue: 0,0:17:11.40,0:17:14.10,Default,,0,0,0,,Келесі кезекте қаздар келе жатыр!
Dialogue: 0,0:17:16.41,0:17:18.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:20.38,0:17:23.23,Default,,0,0,0,,Токоха-чан!
Dialogue: 0,0:17:23.23,0:17:27.90,Default,,0,0,0,,Мен Токоха-чанның үйін қорғаймын!
Dialogue: 0,0:17:27.90,0:17:32.58,Default,,0,0,0,,Өйткені менде жақсы көретін нәрсені қорғауға күшім жетеді➡
Dialogue: 0,0:17:32.58,0:17:34.73,Default,,0,0,0,,Менде де бар!
Dialogue: 0,0:17:34.73,0:17:37.40,Default,,0,0,0,,Мені бұған сендіретін нәрсе➡
Dialogue: 0,0:17:37.40,0:17:39.42,Default,,0,0,0,,Өйткені бұл Токоха-чан!
Dialogue: 0,0:17:39.42,0:17:44.39,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:44.39,0:17:46.41,Default,,0,0,0,,Мұның соңы жоқ.
Dialogue: 0,0:17:46.41,0:17:50.06,Default,,0,0,0,,Мүмкін олардың да бізге көздері жеткен шығар.
Dialogue: 0,0:17:50.06,0:17:54.56,Default,,0,0,0,,Олай болса, бәріміз бірден жасайық!
Dialogue: 0,0:17:57.00,0:18:00.90,Default,,0,0,0,,Саая-чан! (Exi) Мен Луна!
Dialogue: 0,0:18:00.90,0:18:05.07,Default,,0,0,0,,Эниши мырза, бірге күресуге рұқсат етіңіз!
Dialogue: 0,0:18:05.07,0:18:08.73,Default,,0,0,0,,Біз жақсы көретін әлемді қорғағымыз келеді!
Dialogue: 0,0:18:08.73,0:18:12.73,Default,,0,0,0,,Рахмет! Гүлдердің саны көбейді!
Dialogue: 0,0:18:15.22,0:18:20.54,Default,,0,0,0,,Жоғалтып алмаңыз! Куроно мырза, Шион мырза!
Dialogue: 0,0:18:20.54,0:18:22.73,Default,,0,0,0,,ﾄｺﾊ！
Dialogue: 0,0:18:22.73,0:18:25.73,Default,,0,0,0,,Біздің қазір істей алатынымыз➡
Dialogue: 0,0:18:25.73,0:18:29.11,Default,,0,0,0,,Балалар сендерге рахмет
Dialogue: 0,0:18:29.11,0:18:34.74,Default,,0,0,0,,Бұл бізге қайтадан бастауға мүмкіндік берді және шынайы қарым-қатынасымызды қалпына келтірді!
Dialogue: 0,0:18:34.74,0:18:36.91,Default,,0,0,0,,Бұл Сара және басқаларға арналған➡
Dialogue: 0,0:18:36.91,0:18:39.11,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:18:41.28,0:18:46.90,Default,,0,0,0,,《Әрқашан сенгендей қолыңды соз.
Dialogue: 0,0:18:46.90,0:18:53.44,Default,,0,0,0,,Қызық, сен сол нұрыңмен қанша адамды құтқардың?
Dialogue: 0,0:18:53.44,0:18:55.74,Default,,0,0,0,,Енді менің кезегім! 》
Dialogue: 0,0:19:00.05,0:19:03.25,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:19:03.25,0:19:05.60,Default,,0,0,0,,Төрт мезгіл гүлі ханшайымы Вальгемина!
Dialogue: 0,0:19:05.60,0:19:07.64,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:19:07.64,0:19:09.94,Default,,0,0,0,,Қосымша қоңыраулар!
Dialogue: 0,0:19:12.91,0:19:15.41,Default,,0,0,0,,Вальгеминадағы авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:15.41,0:19:17.41,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:19:19.38,0:19:21.38,Default,,0,0,0,,ﾌﾞﾙｰﾑ！
Dialogue: 0,0:19:23.40,0:19:25.39,Default,,0,0,0,,《Хаяо: Шион-кун, жеңілме!
Dialogue: 0,0:19:25.39,0:19:28.24,Default,,0,0,0,,Сіз міндетті түрде бәрін аласыз!
Dialogue: 0,0:19:28.24,0:19:30.54,Default,,0,0,0,,Жеңіс пен арман➡
Dialogue: 0,0:19:30.54,0:19:33.73,Default,,0,0,0,,Сіз қалағанның бәрі сіздің қолыңызда!
Dialogue: 0,0:19:33.73,0:19:36.15,Default,,0,0,0,,Мен де жеңілмеймін!
Dialogue: 0,0:19:36.15,0:19:39.07,Default,,0,0,0,,Мен бұл батылдықты сенен алдым!
Dialogue: 0,0:19:39.07,0:19:42.07,Default,,0,0,0,,Мен бұл зұлым құдай ма, әлде басқа нәрсе ме, білмеймін ...
Dialogue: 0,0:19:42.07,0:19:45.72,Default,,0,0,0,,Хе, балалар сендерге оңай жеңіс болады, солай ма?
Dialogue: 0,0:19:45.72,0:19:49.38,Default,,0,0,0,,Тек оны жойып, қайта оралыңыз!
Dialogue: 0,0:19:49.38,0:19:51.73,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:19:51.73,0:19:54.38,Default,,0,0,0,,Құдайдың рыцарь Альтомайл!
Dialogue: 0,0:19:54.38,0:19:57.38,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｻﾞｼﾞｪﾈﾚｰｼｮﾝ!!
Dialogue: 0,0:20:01.71,0:20:04.73,Default,,0,0,0,,Біз көнбейміз
Dialogue: 0,0:20:04.73,0:20:09.10,Default,,0,0,0,,Барлық болашағыңызды өз қолыңызда ұстаңыз!
Dialogue: 0,0:20:09.10,0:20:11.10,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:20:19.39,0:20:21.39,Default,,0,0,0,,Уау!?
Dialogue: 0,0:20:21.39,0:20:24.05,Default,,0,0,0,,Бізді осыншама қиындыққа душар етуге қалай дәтің бар...
Dialogue: 0,0:20:24.05,0:20:26.40,Default,,0,0,0,,Қаздар да солай істейтін сияқты.
Dialogue: 0,0:20:26.40,0:20:29.08,Default,,0,0,0,,Мен жеңілмеймін... мүлде!
Dialogue: 0,0:20:29.08,0:20:32.74,Default,,0,0,0,,Сіз не істеп жатырсыз? Үшеуін көріңіз!
Dialogue: 0,0:20:32.74,0:20:35.72,Default,,0,0,0,,Біз асығуымыз керек, өйткені біз салқын →
Dialogue: 0,0:20:35.72,0:20:38.12,Default,,0,0,0,,Мен бәрін аламын!
Dialogue: 0,0:20:40.18,0:20:42.06,Default,,0,0,0,,Филиал бастығы!
Dialogue: 0,0:20:42.06,0:20:45.86,Default,,0,0,0,,Артқа шегініп, қалпына келген дұрыс болар еді...
Dialogue: 0,0:20:48.05,0:20:51.05,Default,,0,0,0,,Бұл көз ауыртады!!
Dialogue: 0,0:20:58.10,0:21:00.40,Default,,0,0,0,,Хун
Dialogue: 0,0:21:00.40,0:21:05.05,Default,,0,0,0,,Тек әлсіздерді аулай алатын шеттетілгендер
Dialogue: 0,0:21:05.05,0:21:09.06,Default,,0,0,0,,Менің жолыма бөгет болма!
Dialogue: 0,0:21:09.06,0:21:11.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:11.06,0:21:13.45,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:21:13.45,0:21:15.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:15.48,0:21:21.09,Default,,0,0,0,,Өйткені, мен... мен оны жай ғана жек көремін...
Dialogue: 0,0:21:21.09,0:21:23.41,Default,,0,0,0,,[Монита] (Вакамизу) Кешіріңіз!!
Dialogue: 0,0:21:23.41,0:21:27.06,Default,,0,0,0,,Диффридтің не екенін зерттеуге деген ұмтылыс →
Dialogue: 0,0:21:27.06,0:21:29.75,Default,,0,0,0,,Мен қарсы тұра алмаймын... Уф...
Dialogue: 0,0:21:29.75,0:21:34.15,Default,,0,0,0,,Иә, иә. Сіз де Айчимен және басқалармен бірге бос орынды жеңу үшін келдіңіз.
Dialogue: 0,0:21:36.42,0:21:39.72,Default,,0,0,0,,Дүние жүзіндегі жауынгерлер көтеріліп жатыр
Dialogue: 0,0:21:41.81,0:21:46.21,Default,,0,0,0,,Тағдыр құдіретінің резонанс... күшейіп келеді.
Dialogue: 0,0:21:48.38,0:21:51.43,Default,,0,0,0,,Иә, мен сізді естимін.
Dialogue: 0,0:21:51.43,0:21:56.51,Default,,0,0,0,,Біздің ойларымыз Крей планетасындағы әрбір адамға батылдық береді→
Dialogue: 0,0:21:56.51,0:22:01.81,Default,,0,0,0,,Бұл сезім көшбасшыларды одан да қатты қолдайды.
Dialogue: 0,0:22:07.65,0:22:10.40,Default,,0,0,0,,Біз қосылдық
Dialogue: 0,0:22:10.40,0:22:13.57,Default,,0,0,0,,Куроно мырза. Барлығы...
Dialogue: 0,0:22:13.57,0:22:16.58,Default,,0,0,0,,Болашақ өз қолыңда→
Dialogue: 0,0:22:16.58,0:22:19.73,Default,,0,0,0,,Біздің әлем... Крей планетасы...
Dialogue: 0,0:22:19.73,0:22:22.13,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:22:31.39,0:22:35.06,Default,,0,0,0,,Мына жігіт тағы да шу шығарып жатыр.
Dialogue: 0,0:22:35.06,0:22:39.73,Default,,0,0,0,,Жекпе-жек алдында бас тарттыңыз ба? Белгілеу
Dialogue: 0,0:22:39.73,0:22:43.23,Default,,0,0,0,,Қолым шырылдап жатыр дедім! Шин!
Dialogue: 0,0:22:45.22,0:22:48.72,Default,,0,0,0,,Әлі жас күрескерлерден жеңілме!
Dialogue: 0,0:22:48.72,0:22:50.74,Default,,0,0,0,,Жап!
Dialogue: 0,0:22:50.74,0:22:53.40,Default,,0,0,0,,Қарсылас қаншалықты күшті болса да →
Dialogue: 0,0:22:53.40,0:22:57.40,Default,,0,0,0,,Осы уақытқа дейін жеткен болсаңыз, жеңе аласыз.
Dialogue: 0,0:22:57.40,0:23:01.40,Default,,0,0,0,,Ал аман-есен оралуыңызды өтінемін.
Dialogue: 0,0:23:01.40,0:23:04.70,Default,,0,0,0,,Сізді күтетіндер үшін
Dialogue: 0,0:23:06.74,0:23:11.11,Default,,0,0,0,,《Ибуки: Мен мұны бірнеше жыл бұрын ешқашан елестеткен емеспін.
Dialogue: 0,0:23:11.11,0:23:15.75,Default,,0,0,0,,Бұл мен, бүкіл әлемнен келген жауынгерлермен бірге→
Dialogue: 0,0:23:15.75,0:23:18.75,Default,,0,0,0,,Болашақты қорғау үшін күресу...》
Dialogue: 0,0:23:20.74,0:23:23.79,Default,,0,0,0,,《Хроно. Сіздің Авангардыңыз →
Dialogue: 0,0:23:23.79,0:23:26.85,Default,,0,0,0,,...
Dialogue: 0,0:23:26.85,0:23:29.85,Default,,0,0,0,,Сіз мұны өзіңіз түсінбеуіңіз мүмкін》
Dialogue: 0,0:23:36.72,0:23:39.72,Default,,0,0,0,,《Сіз бәрін өзгерттіңіз》
Dialogue: 0,0:23:41.73,0:23:47.17,Default,,0,0,0,,《Тайо: Егер мен Куроно-санды сол күні кездестірмегенімде...
Dialogue: 0,0:23:47.17,0:23:50.67,Default,,0,0,0,,Мені жоққа жұтып, ғайып болған болуы керек.
Dialogue: 0,0:23:55.77,0:23:58.38,Default,,0,0,0,,《
Dialogue: 0,0:23:58.38,0:24:01.41,Default,,0,0,0,,...
Dialogue: 0,0:24:01.41,0:24:05.23,Default,,0,0,0,,Куроно-санның Авангарды маған бәрін айтып берді→
Dialogue: 0,0:24:05.23,0:24:08.23,Default,,0,0,0,,》
Dialogue: 0,0:24:10.24,0:24:14.41,Default,,0,0,0,,《Синдо-кун Касума Кимимен кездеседі→
Dialogue: 0,0:24:14.41,0:24:17.41,Default,,0,0,0,,...
Dialogue: 0,0:24:17.41,0:24:22.21,Default,,0,0,0,,Сол сезім әлі де осында... алдыңда.
Dialogue: 0,0:24:24.57,0:24:27.17,Default,,0,0,0,,《》
Dialogue: 0,0:24:35.71,0:24:38.72,Default,,0,0,0,,О
Dialogue: 0,0:24:38.72,0:24:41.72,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:24:41.72,0:24:45.72,Default,,0,0,0,,…
Dialogue: 0,0:24:45.72,0:24:48.06,Default,,0,0,0,,Генерация аймағы шығарылды!
Dialogue: 0,0:24:48.06,0:24:50.36,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:24:52.41,0:24:54.73,Default,,0,0,0,,→
Dialogue: 0,0:24:54.73,0:24:57.39,Default,,0,0,0,,→
Dialogue: 0,0:24:57.39,0:25:00.07,Default,,0,0,0,,Мен... ешқашан қашпаймын!
Dialogue: 0,0:25:00.07,0:25:02.57,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:25:04.73,0:25:06.73,Default,,0,0,0,,ｶｽﾞﾏ!!
Dialogue: 0,0:25:06.73,0:25:08.73,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:25:08.73,0:25:12.73,Default,,0,0,0,,Критикалық триггер. Нөлдік айдаһарды байланыстырыңыз
Dialogue: 0,0:25:12.73,0:25:16.74,Default,,0,0,0,,Авангардқа келесі құралдармен шабуыл жасаңыз!
Dialogue: 0,0:25:16.74,0:25:19.73,Default,,0,0,0,,Сіз не ойласаңыз, солсыз→
Dialogue: 0,0:25:19.73,0:25:23.76,Default,,0,0,0,,Күшіңізді алға жылжу және күресу үшін пайдаланыңыз...
Dialogue: 0,0:25:23.76,0:25:26.80,Default,,0,0,0,,Мен қазір осындамын
Dialogue: 0,0:25:26.80,0:25:29.72,Default,,0,0,0,,Қаздар сияқты нәрсе...
Dialogue: 0,0:25:29.72,0:25:32.74,Default,,0,0,0,,Мен жеңіле алмаймын!!
Dialogue: 0,0:25:32.74,0:25:36.11,Default,,0,0,0,,Ұрпақ қорғаушысы. Әрі қарай күзетші
Dialogue: 0,0:25:36.11,0:25:38.71,Default,,0,0,0,,Мен де соңына дейін күресемін!
Dialogue: 0,0:25:40.75,0:25:43.40,Default,,0,0,0,,Берілістің келесі тірегі
Dialogue: 0,0:25:43.40,0:25:49.10,Default,,0,0,0,,Тағдырға ұшырағанша, мені дара еткен де осы!
Dialogue: 0,0:25:51.07,0:25:54.06,Default,,0,0,0,,Дүние жүзіндегі әрбір адамның ойы→
Dialogue: 0,0:25:54.06,0:25:57.06,Default,,0,0,0,,Біздің көмегімізбен біз сені жеңеміз!
Dialogue: 0,0:25:57.06,0:26:01.38,Default,,0,0,0,,Әлсіз болсам да, Үміт үзілсем де→
Dialogue: 0,0:26:01.38,0:26:05.75,Default,,0,0,0,,Біз міндетті түрде тік тұрып, алға ұмтыламыз!
Dialogue: 0,0:26:05.75,0:26:08.41,Default,,0,0,0,,ｲﾋﾞﾙﾘﾌｭｰｻﾞｰ･ﾄﾞﾗｺﾞﾝ
Dialogue: 0,0:26:08.41,0:26:10.71,Default,,0,0,0,,ｸｲﾝﾃｯﾄｳｫｰﾙ！
Dialogue: 0,0:26:15.40,0:26:18.10,Default,,0,0,0,,Дүние
Dialogue: 0,0:26:20.05,0:26:22.05,Default,,0,0,0,,Үндемеңіз
Dialogue: 0,0:26:24.39,0:26:28.09,Default,,0,0,0,,Мен алып келем
