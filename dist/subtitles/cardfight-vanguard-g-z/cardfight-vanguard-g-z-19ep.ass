Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.10,0:01:05.12,Default,,0,0,0,,Ноа-кун, сені қайтар
Dialogue: 0,0:01:05.12,0:01:08.04,Default,,0,0,0,,Арата-кунға, Макото-кунға және бәрінен бұрын сіз үшін!
Dialogue: 0,0:01:08.04,0:01:11.39,Default,,0,0,0,,Тұр, менің клоным!
Dialogue: 0,0:01:11.39,0:01:16.03,Default,,0,0,0,,ﾗｲﾄﾞ！ ﾌﾞﾗｽﾀｰ･ﾌﾞﾚｰﾄﾞ！
Dialogue: 0,0:01:16.03,0:01:18.35,Default,,0,0,0,,ｺｰﾙ！
Dialogue: 0,0:01:18.35,0:01:21.05,Default,,0,0,0,,《1 тегтегі жекпе-жек
Dialogue: 0,0:01:21.05,0:01:23.65,Default,,0,0,0,,9 ұпай жинаған тарап жеңіледі.
Dialogue: 0,0:01:27.04,0:01:30.36,Default,,0,0,0,,《Біздің залал жалпы ретінде қарастырылады.
Dialogue: 0,0:01:30.36,0:01:33.71,Default,,0,0,0,,Бұрылыс Кайдан Нұхқа келеді.
Dialogue: 0,0:01:33.71,0:01:37.05,Default,,0,0,0,,Содан кейін қайтадан Нұхқа кезек келді》
Dialogue: 0,0:01:37.05,0:01:41.55,Default,,0,0,0,,《Noa: тек алдыңғы кезектегі жауынгерге шабуыл жасай алады》
Dialogue: 0,0:01:44.69,0:01:46.71,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:01:46.71,0:01:49.68,Default,,0,0,0,,《Ауру: шегіну және құлыптау сияқты тақтаға кедергі жасау дағдылары → болып табылады
Dialogue: 0,0:01:49.68,0:01:52.37,Default,,0,0,0,,Кез келген жауынгер үшін қолдануға болады》
Dialogue: 0,0:01:52.37,0:01:55.05,Default,,0,0,0,,ﾗｲﾄﾞ ｻﾞ ｳﾞｧﾝｶﾞｰﾄﾞ
Dialogue: 0,0:01:55.05,0:02:00.05,Default,,0,0,0,,ﾄﾞﾗｺﾞﾆｯｸ･ｵｰﾊﾞｰﾛｰﾄﾞｻﾞﾃﾞｽﾃｨﾆｰ！
Dialogue: 0,0:02:07.01,0:02:09.70,Default,,0,0,0,,《Ноа: Жүр, биле.
Dialogue: 0,0:02:09.70,0:02:12.39,Default,,0,0,0,,Алақанда→
Dialogue: 0,0:02:12.39,0:02:15.37,Default,,0,0,0,,Үмітке жабысу, болашақ туралы айту→
Dialogue: 0,0:02:15.37,0:02:18.79,Default,,0,0,0,,Барлық қуаныш пен үмітсіздік→
Dialogue: 0,0:02:18.79,0:02:22.36,Default,,0,0,0,,Менің кесеме құйыңыз
Dialogue: 0,0:02:22.36,0:02:26.06,Default,,0,0,0,,Қазір тойлау уақыты! 》
Dialogue: 0,0:02:33.06,0:02:36.06,Default,,0,0,0,,ｱﾗﾀ… ﾏｺﾄ…
Dialogue: 0,0:05:54.37,0:05:56.37,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:06:00.03,0:06:04.03,Default,,0,0,0,,ｽﾀｰﾍﾞｲﾀﾞｰ ｶｵｽﾌﾞﾚｲｶｰ･ｸﾗｲｼｽ
Dialogue: 0,0:06:06.04,0:06:08.35,Default,,0,0,0,,ﾛｯｸ
Dialogue: 0,0:06:08.35,0:06:11.65,Default,,0,0,0,,Қара бет жеңілді.
Dialogue: 0,0:06:14.54,0:06:18.70,Default,,0,0,0,,Цу нөлдік айдаһары да сіздің қолыңызға түсті.
Dialogue: 0,0:06:18.70,0:06:21.38,Default,,0,0,0,,Енді 3-тен 3-ке дейін.
Dialogue: 0,0:06:21.38,0:06:25.05,Default,,0,0,0,,Хехе... Бұл 4-ке қарсы ма?
Dialogue: 0,0:06:25.05,0:06:27.71,Default,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:06:27.71,0:06:31.69,Default,,0,0,0,,Сіз мені осындай жерге дейін әкелдіңіз, тіпті төбелесіп те қалдық...
Dialogue: 0,0:06:31.69,0:06:35.73,Default,,0,0,0,,Хахаха, бұл күтпеген жағдай.
Dialogue: 0,0:06:35.73,0:06:39.72,Default,,0,0,0,,Сенің екеуміздің арамызда емес пе?
Dialogue: 0,0:06:39.72,0:06:44.39,Default,,0,0,0,,Тек тиісті кезеңді дайындау.
Dialogue: 0,0:06:44.39,0:06:47.06,Default,,0,0,0,,Оларды рет-ретімен ұсақтаңыз →
Dialogue: 0,0:06:47.06,0:06:49.66,Default,,0,0,0,,Пайыз жоқ
Dialogue: 0,0:06:51.71,0:06:56.09,Default,,0,0,0,,Мен бұған әлі де назар аударамын.
Dialogue: 0,0:06:56.09,0:07:00.16,Default,,0,0,0,,Жетекші Айчи Кай Тошики
Dialogue: 0,0:07:00.16,0:07:06.53,Default,,0,0,0,,Дүниеге Қайта туылу деп аталатын хаос себу сіздің кармаңыз.
Dialogue: 0,0:07:06.53,0:07:08.63,Default,,0,0,0,,Ку…｡ Кай-кун
Dialogue: 0,0:07:12.40,0:07:15.70,Default,,0,0,0,,《Біз тек Артқы қорғаушыны табанды түрде талқандадық.
Dialogue: 0,0:07:15.70,0:07:18.36,Default,,0,0,0,,Маған қарсы жарылысты қолдануға рұқсат етпеңіз→
Dialogue: 0,0:07:18.36,0:07:21.71,Default,,0,0,0,,Айчи тақтасында шығын алу》
Dialogue: 0,0:07:21.71,0:07:24.73,Default,,0,0,0,,《Не жоспарлағаныңызға қарамастан→
Dialogue: 0,0:07:24.73,0:07:27.77,Default,,0,0,0,,Бізге бір ғана нәрсе істеу керек》
Dialogue: 0,0:07:27.77,0:07:29.80,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:07:29.80,0:07:33.72,Default,,0,0,0,,ﾌﾞﾗｽﾀｰ･ﾌﾞﾚｰﾄﾞ･ｴｸｼｰﾄﾞ！
Dialogue: 0,0:07:33.72,0:07:36.72,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:07:40.11,0:07:44.41,Default,,0,0,0,,Қасиетті рыцарь зеңбірек Пирс Сабер!
Dialogue: 0,0:07:46.37,0:07:48.37,Default,,0,0,0,,ｶｽﾞﾏ～！
Dialogue: 0,0:07:51.77,0:07:55.69,Default,,0,0,0,,Ку... Оны естуің керек еді.
Dialogue: 0,0:07:55.69,0:07:58.35,Default,,0,0,0,,Тіпті маған да жетті.
Dialogue: 0,0:07:58.35,0:08:01.72,Default,,0,0,0,,Сол кезде мен сенімдімін...
Dialogue: 0,0:08:01.72,0:08:04.72,Default,,0,0,0,,Вирус зақымдаған бөлікті толық қалпына келтіру үшін→
Dialogue: 0,0:08:04.72,0:08:07.04,Default,,0,0,0,,Біраз уақыт алатын сияқты.
Dialogue: 0,0:08:07.04,0:08:11.03,Default,,0,0,0,,Әзірге ресурстарымызды Zero Dragon қорғаныс жүйесіне аударайық.
Dialogue: 0,0:08:11.03,0:08:13.70,Default,,0,0,0,,Айчи және оның достары қайда?
Dialogue: 0,0:08:13.70,0:08:16.55,Default,,0,0,0,,Бар күшіммен іздеймін...
Dialogue: 0,0:08:16.55,0:08:20.09,Default,,0,0,0,,Қарғыс атсын... Мен оны міндетті түрде табамын.
Dialogue: 0,0:08:20.09,0:08:22.12,Default,,0,0,0,,ﾉｱ…
Dialogue: 0,0:08:22.12,0:08:25.72,Default,,0,0,0,,Екеуің Нұх пен басқалары жоғалып кеткен жерге барыңдар.
Dialogue: 0,0:08:25.72,0:08:29.73,Default,,0,0,0,,Ибуки кезінде Куроно кеңістік-уақыт аралығына мәжбүр болды→
Dialogue: 0,0:08:29.73,0:08:32.78,Default,,0,0,0,,Ол жасырын кіріп, оны құтқарғанын айтты.
Dialogue: 0,0:08:32.78,0:08:35.80,Default,,0,0,0,,Даусыңыз міндетті түрде естіледі
Dialogue: 0,0:08:35.80,0:08:39.36,Default,,0,0,0,,Арғы жағында күтіп тұрған нағыз Нұхқа
Dialogue: 0,0:08:39.36,0:08:42.04,Default,,0,0,0,,Мен сізге міндетті түрде көмектесемін
Dialogue: 0,0:08:42.04,0:08:44.69,Default,,0,0,0,,Мисаки-сан, өтінемін!
Dialogue: 0,0:08:44.69,0:08:47.09,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:08:50.07,0:08:52.37,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:08:52.37,0:08:57.04,Default,,0,0,0,,Енді саған ұнайтын нәрсені істеуге рұқсат бермеймін!
Dialogue: 0,0:08:57.04,0:09:00.39,Default,,0,0,0,,Ноа Хошизаки де қайтарылады.
Dialogue: 0,0:09:00.39,0:09:03.03,Default,,0,0,0,,Намаз оқып, тыңдаушылармен →
Dialogue: 0,0:09:03.03,0:09:07.03,Default,,0,0,0,,Оның басшысы және ең күшті одақтасы?
Dialogue: 0,0:09:07.03,0:09:09.03,Default,,0,0,0,,ｸｱﾄﾞﾗﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:09:09.03,0:09:11.37,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:09:11.37,0:09:14.06,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:09:14.06,0:09:18.04,Default,,0,0,0,,Қанша қараңғылық жеп кетсе де, тұрамын→
Dialogue: 0,0:09:18.04,0:09:21.64,Default,,0,0,0,,Дүниенің тағдырын да тербеткен нұр
Dialogue: 0,0:09:25.37,0:09:31.76,Default,,0,0,0,,Өйткені, соған лайықсыңдар.
Dialogue: 0,0:09:31.76,0:09:36.71,Default,,0,0,0,,Бос бекініс Реликсті осы әлемге апару➡
Dialogue: 0,0:09:36.71,0:09:39.91,Default,,0,0,0,,Ең жақсы құрбандық!
Dialogue: 0,0:09:45.87,0:09:48.21,Default,,0,0,0,,Бұл жерде Кай мен оның достары жоғалып кетті.
Dialogue: 0,0:09:48.21,0:09:52.85,Default,,0,0,0,,А, мен де сеземін...
Dialogue: 0,0:09:52.85,0:09:55.88,Default,,0,0,0,,Нұх осында!
Dialogue: 0,0:09:55.88,0:10:03.22,Default,,0,0,0,,Хехехе... Реликс, Gastile және Darkface жасаған жандар түрмесі.
Dialogue: 0,0:10:03.22,0:10:08.69,Default,,0,0,0,,Қапталған жан жоқтың күшімен тозған➡
Dialogue: 0,0:10:08.69,0:10:12.53,Default,,0,0,0,,Қаздар➡ сауытымен жасалған
Dialogue: 0,0:10:12.53,0:10:16.04,Default,,0,0,0,,Реликтердің мәні Қаздардың құдіретіне байланысты➡
Dialogue: 0,0:10:16.04,0:10:21.21,Default,,0,0,0,,Екі дүниенің арасына салынған жоқтық сынасы
Dialogue: 0,0:10:21.21,0:10:24.19,Default,,0,0,0,,Жанның түрмесі бұзылса да➡
Dialogue: 0,0:10:24.19,0:10:27.61,Default,,0,0,0,,Алынған ішкі кеңістік қалады
Dialogue: 0,0:10:27.61,0:10:31.70,Default,,0,0,0,,Жарқыраған жанды бейнетпен жұту➡
Dialogue: 0,0:10:31.70,0:10:35.70,Default,,0,0,0,,Ештіктің қорғаны болып қайта туды...
Dialogue: 0,0:10:35.70,0:10:39.04,Default,,0,0,0,,Бұл бізді осы кеңістікке тартты➡
Dialogue: 0,0:10:39.04,0:10:41.21,Default,,0,0,0,,Ұрыстың себебі осы ма?
Dialogue: 0,0:10:41.21,0:10:44.55,Default,,0,0,0,,Уф... Мен ғана елші қалдым.
Dialogue: 0,0:10:44.55,0:10:50.87,Default,,0,0,0,,Нөлдік айдаһардың жартысы алынып, торға қамалды.
Dialogue: 0,0:10:50.87,0:10:53.04,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:10:53.04,0:10:56.91,Default,,0,0,0,,Оның денесінде алты нөлдік айдаһар орналасқан➡
Dialogue: 0,0:10:56.91,0:11:02.21,Default,,0,0,0,,Енді Жоюдың Айдаһар құдайы Қаздардың оянатыны анық.
Dialogue: 0,0:11:02.21,0:11:05.87,Default,,0,0,0,,Бұл күш бос бекініс Реликстен келеді➡
Dialogue: 0,0:11:05.87,0:11:10.37,Default,,0,0,0,,Дүние жүзіне таралған
Dialogue: 0,0:11:10.37,0:11:14.86,Default,,0,0,0,,Қуаныңыз! Жеңілісіңізбен➡
Dialogue: 0,0:11:14.86,0:11:19.88,Default,,0,0,0,,Дүниенің ақыры келе жатыр!
Dialogue: 0,0:11:19.88,0:11:26.71,Default,,0,0,0,,ﾃﾞｽｽﾀｰﾍﾞｲﾀﾞｰ ｶｵｽﾕﾆﾊﾞｰｽ･ｱﾙｻｰﾆ
Dialogue: 0,0:11:26.71,0:11:31.86,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ
Dialogue: 0,0:11:31.86,0:11:35.53,Default,,0,0,0,,ﾛｯｸ！
Dialogue: 0,0:11:35.53,0:11:38.03,Default,,0,0,0,,Алсани дағдылары
Dialogue: 0,0:11:38.03,0:11:43.42,Default,,0,0,0,,Екі артқы қорғаушы Тошики Кайды құлыптаңыз
Dialogue: 0,0:11:43.42,0:11:45.44,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:11:45.44,0:11:48.21,Default,,0,0,0,,Егер мүмкін болмаса, 2 картаны салыңыз
Dialogue: 0,0:11:48.21,0:11:51.53,Default,,0,0,0,,Алсани үшін қуат плюс 2000
Dialogue: 0,0:11:51.53,0:11:54.20,Default,,0,0,0,,Қосымша қоңырау
Dialogue: 0,0:11:54.20,0:11:56.37,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:11:56.37,0:11:58.37,Default,,0,0,0,,ﾛｯｸ！
Dialogue: 0,0:11:58.37,0:12:02.54,Default,,0,0,0,,Негізі қаздар дүниені не істемекші➡
Dialogue: 0,0:12:02.54,0:12:06.03,Default,,0,0,0,,Бәріне де жойылу келуі мүмкін➡
Dialogue: 0,0:12:06.03,0:12:08.90,Default,,0,0,0,,Маған маңызды емес
Dialogue: 0,0:12:08.90,0:12:12.45,Default,,0,0,0,,Тек оның алдын алуға тырысыңыз және күресіңіз➡
Dialogue: 0,0:12:12.45,0:12:16.21,Default,,0,0,0,,Мен сенің қыбырлаған үмітіңді көргім келеді.
Dialogue: 0,0:12:16.21,0:12:21.86,Default,,0,0,0,,Сондықтан... Мен осындамын!
Dialogue: 0,0:12:21.86,0:12:27.37,Default,,0,0,0,,Сен менің ең жақсы ойыншықтарымсың.
Dialogue: 0,0:12:27.37,0:12:31.37,Default,,0,0,0,,Билікке ұмтылу, жоқтыққа түсу ➡
Dialogue: 0,0:12:31.37,0:12:34.69,Default,,0,0,0,,Бір-біріңе жабысып, қараңғылықты шығарыңдар➡
Dialogue: 0,0:12:34.69,0:12:39.21,Default,,0,0,0,,Жарық жолына қайта оралдым деп ойласам да...
Dialogue: 0,0:12:39.21,0:12:42.10,Default,,0,0,0,,Мен оны сүртпеймін
Dialogue: 0,0:12:42.10,0:12:44.20,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:12:44.20,0:12:47.35,Default,,0,0,0,,Бірге болсақ бәрін жеңер едік.
Dialogue: 0,0:12:47.35,0:12:53.24,Default,,0,0,0,,Сол жарқын үміт үмітсіздікке айналғанда➡
Dialogue: 0,0:12:53.24,0:12:56.86,Default,,0,0,0,,Онда туатын бос ➡
Dialogue: 0,0:12:56.86,0:13:00.16,Default,,0,0,0,,Реликтерді тірілту
Dialogue: 0,0:13:03.40,0:13:06.10,Default,,0,0,0,,Уф... аа...｡ а
Dialogue: 0,0:13:08.21,0:13:12.19,Default,,0,0,0,,Біз көп рет қателестік. Мен мұны жоққа шығармаймын.
Dialogue: 0,0:13:12.19,0:13:15.10,Default,,0,0,0,,Менің қазір кешірім сұрайын деген ойым жоқ.
Dialogue: 0,0:13:15.10,0:13:17.12,Default,,0,0,0,,Тек...
Dialogue: 0,0:13:17.12,0:13:19.18,Default,,0,0,0,,Ол маған жол көрсетті!
Dialogue: 0,0:13:19.18,0:13:21.70,Default,,0,0,0,,Біз бірге жүрдік!
Dialogue: 0,0:13:21.70,0:13:23.69,Default,,0,0,0,,Біздің…｡ Біздің…
Dialogue: 0,0:13:23.69,0:13:25.72,Default,,0,0,0,,ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:13:25.72,0:13:28.03,Default,,0,0,0,,Мен сенің сөзімді үзуіңе енді жол бермеймін!
Dialogue: 0,0:13:28.03,0:13:30.71,Default,,0,0,0,,Бұл сезім!
Dialogue: 0,0:13:30.71,0:13:35.38,Default,,0,0,0,,Дұрыс... Мен ешкімнің сөзімді кесуіне жол бермеймін.
Dialogue: 0,0:13:35.38,0:13:38.18,Default,,0,0,0,,Өйткені... мен сені кездестірдім!
Dialogue: 0,0:13:40.76,0:13:43.26,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:13:45.19,0:13:49.70,Default,,0,0,0,,Ол соншалықты күшті болды ...
Dialogue: 0,0:13:49.70,0:13:53.17,Default,,0,0,0,,Ол мені іздеді!
Dialogue: 0,0:13:53.17,0:13:59.88,Default,,0,0,0,,)
Dialogue: 0,0:13:59.88,0:14:03.73,Default,,0,0,0,,ｱﾗﾀ！ ﾏｺﾄ！
Dialogue: 0,0:14:03.73,0:14:05.76,Default,,0,0,0,,Мен қателестім…
Dialogue: 0,0:14:05.76,0:14:08.88,Default,,0,0,0,,А, мен дәл сол жердемін.
Dialogue: 0,0:14:08.88,0:14:12.04,Default,,0,0,0,,ﾉｱ!!
Dialogue: 0,0:14:12.04,0:14:17.34,Default,,0,0,0,,Мен осындамын! Арата! Макото!
Dialogue: 0,0:14:19.53,0:14:22.21,Default,,0,0,0,,)
Dialogue: 0,0:14:22.21,0:14:26.35,Default,,0,0,0,,Үйге бірге барайық
Dialogue: 0,0:14:26.35,0:14:28.54,Default,,0,0,0,,А, үйге қайтайық.
Dialogue: 0,0:14:28.54,0:14:31.71,Default,,0,0,0,,Мен қазір сені алып кетейін.
Dialogue: 0,0:14:31.71,0:14:34.41,Default,,0,0,0,,ﾉｱ!!
Dialogue: 0,0:14:42.53,0:14:46.63,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:14:49.69,0:14:53.39,Default,,0,0,0,,ｱﾗﾀ… ﾏｺﾄ…
Dialogue: 0,0:16:41.70,0:16:44.21,Default,,0,0,0,,Ноа... Шынымен бе?
Dialogue: 0,0:16:44.21,0:16:46.24,Default,,0,0,0,,ﾉｱ
Dialogue: 0,0:16:46.24,0:16:51.31,Default,,0,0,0,,Мен екі адамның қоңырау шалғанын естідім.
Dialogue: 0,0:16:51.31,0:16:55.37,Default,,0,0,0,,Макото Аратаға рахмет
Dialogue: 0,0:16:55.37,0:16:59.37,Default,,0,0,0,,А... Жақсы жұмыс. иә!
Dialogue: 0,0:17:02.69,0:17:05.53,Default,,0,0,0,,Нұх! Ах! Уф...
Dialogue: 0,0:17:05.53,0:17:08.05,Default,,0,0,0,,Ух... уау!!
Dialogue: 0,0:17:08.05,0:17:12.37,Default,,0,0,0,,ｱﾗﾀ ﾏｺﾄ！
Dialogue: 0,0:17:12.37,0:17:15.54,Default,,0,0,0,,Бұғауымнан шық➡
Dialogue: 0,0:17:15.54,0:17:19.39,Default,,0,0,0,,Мен үмітсіздікті өз қолыммен ұстау үшін барамын ба?
Dialogue: 0,0:17:19.39,0:17:21.69,Default,,0,0,0,,Ноа Хошизаки
Dialogue: 0,0:17:21.69,0:17:25.20,Default,,0,0,0,,Содан кейін сонда қараңыз.
Dialogue: 0,0:17:25.20,0:17:28.07,Default,,0,0,0,,Дүние жойылады!
Dialogue: 0,0:17:28.07,0:17:30.09,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:17:30.09,0:17:33.69,Default,,0,0,0,,Жоғалатын сенсің, Хаос бұзушы!
Dialogue: 0,0:17:33.69,0:17:36.69,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:36.69,0:17:39.53,Default,,0,0,0,,Тағдыр шеберлігін белсендіру!
Dialogue: 0,0:17:39.53,0:17:44.33,Default,,0,0,0,,Авангард шеңберінен басқа шеңберден бір картаны таңдап, оны түсіру аймағына қойыңыз.
Dialogue: 0,0:17:51.69,0:17:55.36,Default,,0,0,0,,Кайкун
Dialogue: 0,0:17:55.36,0:17:57.88,Default,,0,0,0,,Айчи тақтасы тазартылды!
Dialogue: 0,0:17:57.88,0:18:01.08,Default,,0,0,0,,ｽﾄﾗｲﾄﾞ ｻﾞ ｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:18:04.37,0:18:10.86,Default,,0,0,0,,Жоғарғы император Айдаһар айдаһар басшы Заспаж!
Dialogue: 0,0:18:10.86,0:18:13.55,Default,,0,0,0,,Біреу үшін күресу➡
Dialogue: 0,0:18:13.55,0:18:18.45,Default,,0,0,0,,Мен достарыммен бірге күресудің не екенін түсіндім➡
Dialogue: 0,0:18:18.45,0:18:21.54,Default,,0,0,0,,Себебі мен бос жерді өз көзіммен көрдім
Dialogue: 0,0:18:21.54,0:18:26.19,Default,,0,0,0,,1 Авангардқа зиян!
Dialogue: 0,0:18:26.19,0:18:28.19,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,0:18:28.19,0:18:30.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:30.20,0:18:33.87,Default,,0,0,0,,Авангардқа шабуыл жасаңыз! Норгаард
Dialogue: 0,0:18:33.87,0:18:35.87,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:18:35.87,0:18:38.02,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:18:38.02,0:18:40.02,Default,,0,0,0,,Қуат қыздырғышқа кетеді
Dialogue: 0,0:18:40.02,0:18:43.53,Default,,0,0,0,,Сын үшін Zapage сайтына өтіңіз!
Dialogue: 0,0:18:43.53,0:18:46.43,Default,,0,0,0,,ﾀﾞﾌﾞﾙｸﾘﾃｨｶﾙ！
Dialogue: 0,0:18:46.43,0:18:53.20,Default,,0,0,0,,Сіз бізді шайқасқа шақырған кезде сіздің амбицияларыңыз орындалады!
Dialogue: 0,0:18:53.20,0:18:55.20,Default,,0,0,0,,ﾀﾞﾒｰｼﾞ８！
Dialogue: 0,0:18:55.20,0:18:58.57,Default,,0,0,0,,Дәл осылай, Chaos Breaker-ді бірден пайдаланыңыз! Кай мырза!
Dialogue: 0,0:18:58.57,0:19:04.20,Default,,0,0,0,,Groheater Dragon көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:04.20,0:19:08.22,Default,,0,0,0,,ｶﾞｰﾄﾞ ｲﾝﾀｰｾﾌﾟﾄ
Dialogue: 0,0:19:08.22,0:19:10.24,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:19:10.24,0:19:12.79,Default,,0,0,0,,Тоқтату
Dialogue: 0,0:19:12.79,0:19:18.19,Default,,0,0,0,,Жоқ, бұл бастама... Менің ойымша
Dialogue: 0,0:19:18.19,0:19:23.57,Default,,0,0,0,,Құны бойынша Vanguard картасымен бірдей
Dialogue: 0,0:19:23.57,0:19:26.72,Default,,0,0,0,,Менің бүкіл болашағыма бәс тігу➡
Dialogue: 0,0:19:26.72,0:19:31.71,Default,,0,0,0,,Барлық үмітке, үмітсіздіктің соңы
Dialogue: 0,0:19:31.71,0:19:34.88,Default,,0,0,0,,Менің болашағымды көрсет!
Dialogue: 0,0:19:34.88,0:19:40.68,Default,,0,0,0,,Жұлдыздар қақпасы нөлдік айдаһардың соңғы қадамы!
Dialogue: 0,0:19:46.04,0:19:50.04,Default,,0,0,0,,Жұлдызды жерлеу нөлдік айдаһар сабағы!
Dialogue: 0,0:19:50.04,0:19:52.21,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:19:52.21,0:19:58.41,Default,,0,0,0,,Бұл құрылғы шабуылға ұшырағанның өзінде демалмайды және бұрылыс кезінде 3 ретке дейін шабуылдауға болады.
Dialogue: 0,0:20:00.35,0:20:03.36,Default,,0,0,0,,Жүрегіңе сай ән сал!
Dialogue: 0,0:20:03.36,0:20:08.86,Default,,0,0,0,,Болашаққа үміт!
Dialogue: 0,0:20:08.86,0:20:11.38,Default,,0,0,0,,Армандар мен махаббат!
Dialogue: 0,0:20:11.38,0:20:13.37,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:20:13.37,0:20:15.37,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:20:15.37,0:20:18.87,Default,,0,0,0,,Vanguard үшін Пауэр Plus 5000
Dialogue: 0,0:20:18.87,0:20:21.91,Default,,0,0,0,,Оны оратын менмін
Dialogue: 0,0:20:21.91,0:20:25.53,Default,,0,0,0,,Дүниедегі барлық нәрсе жойылудан бас тартады➡
Dialogue: 0,0:20:25.53,0:20:28.55,Default,,0,0,0,,Болашақты қаласаң!
Dialogue: 0,0:20:28.55,0:20:33.70,Default,,0,0,0,,Мен олардың барлығын талқандаймын және қиратамын.
Dialogue: 0,0:20:33.70,0:20:36.20,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:20:36.20,0:20:38.39,Default,,0,0,0,,Мен дүниені аяқтамаймын
Dialogue: 0,0:20:38.39,0:20:40.86,Default,,0,0,0,,Біз тағы да үшеуміз➡
Dialogue: 0,0:20:40.86,0:20:43.38,Default,,0,0,0,,Мен келесі Undertwenty-де боламын!
Dialogue: 0,0:20:43.38,0:20:45.38,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:20:45.38,0:20:50.02,Default,,0,0,0,,Қарғыс атсын... Әлі екі Авангард шабуылы қалды.
Dialogue: 0,0:20:50.02,0:20:52.52,Default,,0,0,0,,Зақым 8-ден 8-ге дейін ме?
Dialogue: 0,0:20:52.52,0:20:55.21,Default,,0,0,0,,Жою құдайы Айдаһар
Dialogue: 0,0:20:55.21,0:20:58.36,Default,,0,0,0,,Көптен күткен тілегім көп ұзамай орындалады.
Dialogue: 0,0:20:58.36,0:21:00.88,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:21:00.88,0:21:06.37,Default,,0,0,0,,Олай болса, мен де сол қуанышқа кенелемін!
Dialogue: 0,0:21:06.37,0:21:08.37,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:21:12.19,0:21:14.36,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:21:14.36,0:21:17.35,Default,,0,0,0,,Барлығы менің ойыншығым
Dialogue: 0,0:21:17.35,0:21:20.38,Default,,0,0,0,,Барлығы алақанда➡
Dialogue: 0,0:21:20.38,0:21:24.58,Default,,0,0,0,,Үміт іздеп билей бер!
Dialogue: 0,0:21:32.04,0:21:36.05,Default,,0,0,0,,Болашақтан кел, бізді қорға!
Dialogue: 0,0:21:36.05,0:21:38.35,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:21:38.35,0:21:41.37,Default,,0,0,0,,Кішкентай ұлы данышпан Марон!
Dialogue: 0,0:21:41.37,0:21:44.87,Default,,0,0,0,,Дағды іске қосылды! Керемет қоңырау!
Dialogue: 0,0:21:44.87,0:21:47.04,Default,,0,0,0,,ｼｰﾙﾄﾞﾌﾟﾗｽ5000！
Dialogue: 0,0:21:47.04,0:21:49.14,Default,,0,0,0,,Одан да сақ болыңыз!
Dialogue: 0,0:22:03.39,0:22:06.23,Default,,0,0,0,,Мен аман қалдым. Мен оны істедім.
Dialogue: 0,0:22:06.23,0:22:08.73,Default,,0,0,0,,Айдаһардың шабуылы нөл!
Dialogue: 0,0:22:16.72,0:22:18.72,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ！
Dialogue: 0,0:22:22.38,0:22:25.88,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:22:25.88,0:22:30.87,Default,,0,0,0,,Қасиетті Рыцарь Король Альфред Қасиетті Сабер!
Dialogue: 0,0:22:30.87,0:22:32.87,Default,,0,0,0,,ｺｰﾙ
Dialogue: 0,0:22:32.87,0:22:36.21,Default,,0,0,0,,Аянның шегінуі
Dialogue: 0,0:22:36.21,0:22:38.19,Default,,0,0,0,,Альфредоның шеберлігі
Dialogue: 0,0:22:38.19,0:22:40.90,Default,,0,0,0,,Қуат плюс 3000 артық
Dialogue: 0,0:22:40.90,0:22:44.73,Default,,0,0,0,,Маған қос жетекті беріңіз! Жақсы...
Dialogue: 0,0:22:44.73,0:22:47.93,Default,,0,0,0,,Бұл біздің Авангард!
Dialogue: 0,0:22:49.87,0:22:52.56,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:22:52.56,0:22:54.56,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:23:01.88,0:23:05.38,Default,,0,0,0,,ｹﾞｯﾄ｡ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:23:07.37,0:23:11.67,Default,,0,0,0,,Критикалық триггер! Барлық әсерлер АСЫҚТЫ!
Dialogue: 0,0:23:23.86,0:23:29.36,Default,,0,0,0,,Мен саған тәнті болдым
Dialogue: 0,0:23:29.36,0:23:33.35,Default,,0,0,0,,Бұл қазір де өзгерген жоқ.
Dialogue: 0,0:23:33.35,0:23:36.35,Default,,0,0,0,,Кең ғаламда➡
Dialogue: 0,0:23:36.35,0:23:40.56,Default,,0,0,0,,Өзің жақсы көретін іспен айналысуға күш пен сенімділік
Dialogue: 0,0:23:40.56,0:23:45.06,Default,,0,0,0,,Мен оны бір күні өзім ұстаймын...
Dialogue: 0,0:23:51.03,0:23:53.33,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:23:59.54,0:24:02.34,Default,,0,0,0,,ﾉｰﾄﾘｶﾞｰ
Dialogue: 0,0:24:07.03,0:24:11.22,Default,,0,0,0,,Қош бол. (2 адам) Ноа!
Dialogue: 0,0:24:11.22,0:24:13.87,Default,,0,0,0,,Жақсы Жақсы Ноа. Арата Макото
Dialogue: 0,0:24:13.87,0:24:16.37,Default,,0,0,0,,Мен шынымен қауіпсізмін.
Dialogue: 0,0:24:18.53,0:24:22.03,Default,,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:24:22.03,0:24:24.05,Default,,0,0,0,,Достық және көз жасы
Dialogue: 0,0:24:24.05,0:24:29.55,Default,,0,0,0,,Жеңіске деген жеңілдік, болашаққа деген сенім. Үміт.
Dialogue: 0,0:24:29.55,0:24:32.22,Default,,0,0,0,,Мұның бәрін бұзудың жолы бар➡
Dialogue: 0,0:24:32.22,0:24:34.19,Default,,0,0,0,,Менде әлі де бар
Dialogue: 0,0:24:34.19,0:24:37.60,Default,,0,0,0,,Қандай ғанибет!
Dialogue: 0,0:24:37.60,0:24:40.38,Default,,0,0,0,,Бұл сіздің жоғалтыңыз. Chaos Breaker Dragon
Dialogue: 0,0:24:40.38,0:24:42.38,Default,,0,0,0,,Не істесеңіз де➡
Dialogue: 0,0:24:42.38,0:24:45.25,Default,,0,0,0,,Диффрид көтеріліп, сіз рухани денеге айналдыңыз➡
Dialogue: 0,0:24:45.25,0:24:47.27,Default,,0,0,0,,Бірақ мен ештеңе істей алмаймын.
Dialogue: 0,0:24:47.27,0:24:51.06,Default,,0,0,0,,Балалар сендер шынымен сүйкімдісіңдер...
Dialogue: 0,0:24:51.06,0:24:54.93,Default,,0,0,0,,Мен бұл пьесадан кеңістік пен уақытта шаршадым.
Dialogue: 0,0:24:54.93,0:24:58.35,Default,,0,0,0,,Мені қуантқан сендерге➡
Dialogue: 0,0:24:58.35,0:25:02.05,Default,,0,0,0,,Шын жүректен үмітсіздік!
Dialogue: 0,0:25:07.04,0:25:10.53,Default,,0,0,0,,Менің жанымды қабылдап, оны іске қосыңыз!
Dialogue: 0,0:25:10.53,0:25:14.03,Default,,0,0,0,,Бос реликс қорғаны!
Dialogue: 0,0:25:14.03,0:25:17.70,Default,,0,0,0,,Қаздар, маған ойыншық беріңдер.
Dialogue: 0,0:25:17.70,0:25:23.11,Default,,0,0,0,,Осыдан кейін өз қалауыңызша ойнаңыз. Тоқта!
Dialogue: 0,0:25:23.11,0:25:26.21,Default,,0,0,0,,Диффрид еріді, мен рухани денеге айналдым➡
Dialogue: 0,0:25:26.21,0:25:29.21,Default,,0,0,0,,Балалар сендер ештеңе істей алмайсыңдар.
Dialogue: 0,0:25:31.22,0:25:33.57,Default,,0,0,0,,Иә, бұл бет.
Dialogue: 0,0:25:33.57,0:25:38.57,Default,,0,0,0,,Соңына дейін сен менің алақанымдасың!
Dialogue: 0,0:25:43.88,0:25:45.86,Default,,0,0,0,,(ｱﾗｰﾑ)
Dialogue: 0,0:25:45.86,0:25:47.88,Default,,0,0,0,,Не болды!
Dialogue: 0,0:25:47.88,0:25:51.37,Default,,0,0,0,,Қарқынды кеңістіктік бұрмалану бүкіл әлемде кеңейіп келеді!
Dialogue: 0,0:25:51.37,0:25:54.69,Default,,0,0,0,,Бұл реакция Реликс!
Dialogue: 0,0:25:54.69,0:25:56.69,Default,,0,0,0,,ｸﾘｽ!?
Dialogue: 0,0:25:56.69,0:26:00.04,Default,,0,0,0,,Электр қуатын өшіру?
Dialogue: 0,0:26:00.04,0:26:06.22,Default,,0,0,0,,Бүкіл жүйе бұзылады! Әлі болмағанына сене алар емеспін...
Dialogue: 0,0:26:06.22,0:26:09.22,Default,,0,0,0,,Байланыс жоғалды! (Крис) Зақымдалған файлда➡
Dialogue: 0,0:26:09.22,0:26:13.39,Default,,0,0,0,,Relix қайта іске қосылуымен байланысты басқа вирус жасырылған.
Dialogue: 0,0:26:13.39,0:26:17.56,Default,,0,0,0,,Ең үлкен массасы бар ғимарат ішкі кеңістікте расталды!
Dialogue: 0,0:26:17.56,0:26:19.86,Default,,0,0,0,,Нақты кеңістікте пайда болады!
Dialogue: 0,0:26:33.08,0:26:35.08,Default,,0,0,0,,Әй
Dialogue: 0,0:30:33.08,0:30:36.07,Default,,0,0,0,,Акари мен Хикари журналда жұмыс істейді →
Dialogue: 0,0:30:36.07,0:30:40.56,Default,,0,0,0,,Мен далада жұмыс істеп көрейін деп шештім.
Dialogue: 0,0:30:40.56,0:30:44.40,Default,,0,0,0,,Біздің сезімдеріміз басқаша болды, тіпті ұрысып қалдық →
Dialogue: 0,0:30:44.40,0:30:48.75,Default,,0,0,0,,Апалы-сіңлілер арасындағы байланыс тереңдей түсті.
Dialogue: 0,0:30:48.75,0:30:55.41,Default,,0,0,0,,Алайда теріс қате қайтадан пайда болды.
Dialogue: 0,0:30:55.41,0:30:59.41,Default,,0,0,0,,Технодуэлмен реттеу сәтті өтті.
Dialogue: 0,0:31:00.91,0:31:06.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory