Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.62,0:01:06.97,Default,,0,0,0,,Ибуки!
Dialogue: 0,0:01:06.97,0:01:09.37,Default,,0,0,0,,Ибуки!
Dialogue: 0,0:01:12.02,0:01:14.42,Default,,0,0,0,,Ибуки!
Dialogue: 0,0:04:29.29,0:04:31.61,Default,,0,0,0,,Касума Тайоу-кун!
Dialogue: 0,0:04:31.61,0:04:34.61,Default,,0,0,0,,Курононың жоғалып кеткені нені білдіреді?
Dialogue: 0,0:04:34.61,0:04:38.28,Default,,0,0,0,,Мен түсінбеймін. Ол менің көз алдымда жоғалып кетті.
Dialogue: 0,0:04:38.28,0:04:43.17,Default,,0,0,0,,Кеңістік бұрмаланды және ол мен Релаксқа түскен кездегідей болды.
Dialogue: 0,0:04:43.17,0:04:46.22,Default,,0,0,0,,Бұл Курононы Реликс түсірген жер.
Dialogue: 0,0:04:46.22,0:04:49.81,Default,,0,0,0,,Әсер әлі де сақталуы мүмкін.
Dialogue: 0,0:04:49.81,0:04:54.11,Default,,0,0,0,,Сонымен, сіз Курононың қолындағы эмблеманы көрдіңіз.
Dialogue: 0,0:04:56.38,0:05:00.45,Default,,0,0,0,,Қаздарға арналған ыдыс ретінде пайдалану мүмкіндігі жойылды емес пе?
Dialogue: 0,0:05:00.45,0:05:05.52,Default,,0,0,0,,Мм... Расында, Реликс құламай тұрып➡
Dialogue: 0,0:05:05.52,0:05:08.13,Default,,0,0,0,,Куроно-санның эмблемасы бір сәт пайда болады➡
Dialogue: 0,0:05:08.13,0:05:10.29,Default,,0,0,0,,Аяқталған сияқты.
Dialogue: 0,0:05:10.29,0:05:12.31,Default,,0,0,0,,Не!?
Dialogue: 0,0:05:12.31,0:05:16.47,Default,,0,0,0,,Кешіріңіз, бірақ мен бұл туралы ойладым ...
Dialogue: 0,0:05:16.47,0:05:18.64,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:05:18.64,0:05:20.62,Default,,0,0,0,,ｸｿｯ！
Dialogue: 0,0:05:20.62,0:05:23.29,Default,,0,0,0,,ｽﾄｯﾌﾟ！
Dialogue: 0,0:05:23.29,0:05:27.14,Default,,0,0,0,,Әйтеуір, ағаларыңмен хабарласып, қосылайық!
Dialogue: 0,0:05:27.14,0:05:29.70,Default,,0,0,0,,Сол кезді ойлағаннан гөрі➡
Dialogue: 0,0:05:29.70,0:05:31.72,Default,,0,0,0,,Алдымен Курононы табыңыз!
Dialogue: 0,0:05:31.72,0:05:33.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:43.98,0:05:47.28,Default,,0,0,0,,Geacronic бірегейлігі
Dialogue: 0,0:05:47.28,0:05:50.93,Default,,0,0,0,,Ей, өзіңді ұста! (Ибуки) Ух...
Dialogue: 0,0:05:50.93,0:05:53.12,Default,,0,0,0,,Сен, Ибуки...!
Dialogue: 0,0:05:53.12,0:05:56.14,Default,,0,0,0,,Қош келдіңіз! Менің қарғысымның бөлмесіне
Dialogue: 0,0:05:56.14,0:06:01.61,Default,,0,0,0,,Адам ұрыс кезінде зиян шеккен сайын оның өмірі қысқарады.
Dialogue: 0,0:06:01.61,0:06:05.32,Default,,0,0,0,,Қиындық, маған рұқсат етілген жалғыз нәрсе➡
Dialogue: 0,0:06:05.32,0:06:08.82,Default,,0,0,0,,Раббымның құдіреті
Dialogue: 0,0:06:08.82,0:06:11.82,Default,,0,0,0,,Бұл Мәсіхті жою үшін қарғыс.
Dialogue: 0,0:06:13.79,0:06:15.98,Default,,0,0,0,,Арх! Міне бітті!
Dialogue: 0,0:06:15.98,0:06:20.48,Default,,0,0,0,,Мәсіхтің көсемінің өмірі енді желдің алдындағы нұрға айналды.
Dialogue: 0,0:06:20.48,0:06:25.62,Default,,0,0,0,,Клей планетасындағы Мәсіх те өз күшін жоғалтады➡
Dialogue: 0,0:06:25.62,0:06:28.97,Default,,0,0,0,,Жою уақыты келді!
Dialogue: 0,0:06:28.97,0:06:31.14,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:06:31.14,0:06:34.29,Default,,0,0,0,,Уау! Оны асыра алмаңыз!
Dialogue: 0,0:06:34.29,0:06:36.45,Default,,0,0,0,,Жеңіске жетсең өлмейсің!
Dialogue: 0,0:06:36.45,0:06:43.45,Default,,0,0,0,,Бұл кісінің өмірі шайқас біткенше қауіп төнеді.
Dialogue: 0,0:06:43.45,0:06:45.64,Default,,0,0,0,,Мен мұны істеймін! не?
Dialogue: 0,0:06:45.64,0:06:48.81,Default,,0,0,0,,Оның орнына сіз төбелесесіз бе?
Dialogue: 0,0:06:48.81,0:06:50.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:50.79,0:06:55.18,Default,,0,0,0,,Сіз сенімдісіз бе? Жеңілсең сол кісі➡
Dialogue: 0,0:06:55.18,0:06:58.24,Default,,0,0,0,,Сен өлесің.
Dialogue: 0,0:06:58.24,0:07:00.32,Default,,0,0,0,,ｸﾛﾉ…
Dialogue: 0,0:07:00.32,0:07:03.92,Default,,0,0,0,,Саған сеніп тапсырамын. Ибуки
Dialogue: 0,0:07:07.38,0:07:09.38,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:07:12.12,0:07:15.12,Default,,0,0,0,,《Зақым 3-тен 5-ке дейін!
Dialogue: 0,0:07:15.12,0:07:18.14,Default,,0,0,0,,Әрқайсысы бір рет адымдайды.
Dialogue: 0,0:07:18.14,0:07:22.66,Default,,0,0,0,,Картаңызға қарасаңыз, қалай күрескеніңізді көресіз➡
Dialogue: 0,0:07:22.66,0:07:26.46,Default,,0,0,0,,Мен сіздің болашақта қандай жекпе-жекті елестетіп отырғаныңызды көріп тұрмын.
Dialogue: 0,0:07:30.27,0:07:34.47,Default,,0,0,0,,)
Dialogue: 0,0:07:36.27,0:07:39.94,Default,,0,0,0,,Мен бұл жігітпен қалай күресу керектігін жақсы білемін!
Dialogue: 0,0:07:39.94,0:07:44.90,Default,,0,0,0,,Біз жеңіп, үйге бірге барамыз! О, мен оны сізге қалдырамын
Dialogue: 0,0:07:44.90,0:07:46.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:46.78,0:07:50.28,Default,,0,0,0,,Кеттік, алға ұрпақ!
Dialogue: 0,0:07:52.31,0:07:54.31,Default,,0,0,0,,Жаратылыс Айдаһар…
Dialogue: 0,0:07:56.73,0:07:59.73,Default,,0,0,0,,ﾊﾞｻﾙﾃｨｽ･ﾒｻｲｱ！
Dialogue: 0,0:08:01.95,0:08:04.84,Default,,0,0,0,,Идеал Эго Мәсіхтің қадам жасау шеберлігі!
Dialogue: 0,0:08:04.84,0:08:08.89,Default,,0,0,0,,Құлыпталған қолыңыздан бір картаны қойыңыз➡
Dialogue: 0,0:08:08.89,0:08:11.11,Default,,0,0,0,,1 картаны сал!
Dialogue: 0,0:08:11.11,0:08:14.29,Default,,0,0,0,,Авангард үшін қуат плюс 5000!
Dialogue: 0,0:08:14.29,0:08:16.60,Default,,0,0,0,,ｺｰﾙ！ ｱﾚｽﾀｰ･ﾒｻｲｱ！
Dialogue: 0,0:08:16.60,0:08:19.78,Default,,0,0,0,,Қуат плюс 2000 шеберлікпен!
Dialogue: 0,0:08:19.78,0:08:23.45,Default,,0,0,0,,Тұтқынмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:08:23.45,0:08:25.62,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ
Dialogue: 0,0:08:25.62,0:08:28.79,Default,,0,0,0,,Қамау дағдылары! Өзіңізді шайқаңыз!
Dialogue: 0,0:08:28.79,0:08:31.13,Default,,0,0,0,,Ваксторм вампирін құлыптаңыз!
Dialogue: 0,0:08:31.13,0:08:33.31,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:33.31,0:08:36.70,Default,,0,0,0,,Сіз оны өз палубаңыз сияқты пайдаланасыз.
Dialogue: 0,0:08:36.70,0:08:40.45,Default,,0,0,0,,Айтпақшы, мен бұл жігітті бұрыннан танимын.
Dialogue: 0,0:08:40.45,0:08:44.04,Default,,0,0,0,,Мен бұл жігітке үлкен қарыздармын!
Dialogue: 0,0:08:44.04,0:08:49.61,Default,,0,0,0,,)
Dialogue: 0,0:08:49.61,0:08:53.30,Default,,0,0,0,,Мен бұл қарызды қайтарамын!
Dialogue: 0,0:08:53.30,0:08:55.30,Default,,0,0,0,,Қазір уақыт!
Dialogue: 0,0:08:58.96,0:09:00.96,Default,,0,0,0,,Базальт дағдылары!
Dialogue: 0,0:09:00.96,0:09:04.13,Default,,0,0,0,,Айналмалы болтты Грант Вампирімен бекітіңіз!
Dialogue: 0,0:09:04.13,0:09:08.60,Default,,0,0,0,,Сондай-ақ Virastos Arrester Sacrifice құлпын ашыңыз!
Dialogue: 0,0:09:08.60,0:09:11.79,Default,,0,0,0,,1 картаны сал! Virastos дағдылары!
Dialogue: 0,0:09:11.79,0:09:15.97,Default,,0,0,0,,Құлып ашылғанда Қуат плюс 4000!
Dialogue: 0,0:09:15.97,0:09:18.61,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:09:18.61,0:09:21.13,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:09:21.13,0:09:24.28,Default,,0,0,0,,ﾌｧｰｽﾄﾁｪｯｸ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:09:24.28,0:09:28.14,Default,,0,0,0,,Қуат – Вирастос. Критикалық - Базальт!
Dialogue: 0,0:09:28.14,0:09:32.71,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ ｻｰﾄﾞﾁｪｯｸ ﾋｰﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:09:32.71,0:09:36.41,Default,,0,0,0,,Вирастосқа қуат. 1 зақымдарды қалпына келтіреді!
Dialogue: 0,0:09:38.28,0:09:40.58,Default,,0,0,0,,Ах...хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааа...!
Dialogue: 0,0:09:50.11,0:09:53.61,Default,,0,0,0,,Бұл жекпе-жек міндетті түрде жеңіске жетеді!
Dialogue: 0,0:09:53.61,0:09:55.78,Default,,0,0,0,,ｱﾚｽﾀｰ･ﾒｻｲｱ！
Dialogue: 0,0:09:55.78,0:09:57.78,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:09:57.78,0:10:01.13,Default,,0,0,0,,Вирастоспен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:10:01.13,0:10:03.20,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:10:03.20,0:10:05.71,Default,,0,0,0,,Жиналған махаббат құмарлығы
Dialogue: 0,0:10:05.71,0:10:07.77,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:10:07.77,0:10:10.29,Default,,0,0,0,,Virastos дағдылары!
Dialogue: 0,0:10:10.29,0:10:12.28,Default,,0,0,0,,ｿｳﾙﾁｬｰｼﾞ！
Dialogue: 0,0:10:12.28,0:10:14.46,Default,,0,0,0,,Динамис Мәсіхтің шеберлігі!
Dialogue: 0,0:10:14.46,0:10:16.45,Default,,0,0,0,,Құлыпталған Virastos құлпын ашыңыз!
Dialogue: 0,0:10:16.45,0:10:20.45,Default,,0,0,0,,Қуат плюс 4000! Virastos дағдылары!
Dialogue: 0,0:10:20.45,0:10:24.12,Default,,0,0,0,,Құлып ашылғанда Қуат плюс 4000!
Dialogue: 0,0:10:24.12,0:10:26.96,Default,,0,0,0,,Құрбандық шеберлігі құлпы!
Dialogue: 0,0:10:26.96,0:10:28.98,Default,,0,0,0,,ｶｳﾝﾀｰﾁｬｰｼﾞ！
Dialogue: 0,0:10:28.98,0:10:32.53,Default,,0,0,0,,Virastos үшін қуат плюс 3000!
Dialogue: 0,0:10:32.53,0:10:36.95,Default,,0,0,0,,Өсиет ет, азат ет, жақыныңды биікке көтер.
Dialogue: 0,0:10:36.95,0:10:40.29,Default,,0,0,0,,Мәсіхтің әдеттегі әдістері
Dialogue: 0,0:10:40.29,0:10:42.96,Default,,0,0,0,,Жүр!
Dialogue: 0,0:10:42.96,0:10:45.36,Default,,0,0,0,,Бірақ ол маған жетпейді
Dialogue: 0,0:10:48.13,0:10:50.60,Default,,0,0,0,,Уф...! Қарғыс атқыр...
Dialogue: 0,0:10:50.60,0:10:53.29,Default,,0,0,0,,Мен шеше алмадым! Бірақ...
Dialogue: 0,0:10:53.29,0:10:55.44,Default,,0,0,0,,Бірінші қатар құлыптаулы!
Dialogue: 0,0:10:55.44,0:10:58.13,Default,,0,0,0,,Бірақ келесі...
Dialogue: 0,0:10:58.13,0:11:00.29,Default,,0,0,0,,Нөлдік айдаһар!
Dialogue: 0,0:11:00.29,0:11:03.28,Default,,0,0,0,,Хэхехехехехе...!
Dialogue: 0,0:11:03.28,0:11:05.95,Default,,0,0,0,,Барлығы қаз-сама үшін
Dialogue: 0,0:11:05.95,0:11:10.80,Default,,0,0,0,,Барлығы қаз мырзаның өтініші бойынша
Dialogue: 0,0:11:10.80,0:11:15.30,Default,,0,0,0,,Хэхехехехехе...!
Dialogue: 0,0:12:59.30,0:13:02.78,Default,,0,0,0,,Мұндай күн келеді деп ойламаппын➡
Dialogue: 0,0:13:02.78,0:13:05.58,Default,,0,0,0,,Мен оны елестете алмадым
Dialogue: 0,0:13:08.29,0:13:13.31,Default,,0,0,0,,Баяғыда үлкен апаттан жеңілген кезіміз➡
Dialogue: 0,0:13:13.31,0:13:17.36,Default,,0,0,0,,Zero Dragon басқа әлемде мөрленді➡
Dialogue: 0,0:13:17.36,0:13:21.12,Default,,0,0,0,,Енді Қаз-саманың қайта тірілуі орындалмайды...
Dialogue: 0,0:13:21.12,0:13:26.51,Default,,0,0,0,,Менің қолымнан келетіні - дұға ету ➡
Dialogue: 0,0:13:26.51,0:13:29.78,Default,,0,0,0,,Тек Мәсіхке қарғыс айту керек.
Dialogue: 0,0:13:29.78,0:13:33.95,Default,,0,0,0,,Бірақ тағдыр неткен бұрылыс➡
Dialogue: 0,0:13:33.95,0:13:39.64,Default,,0,0,0,,Бұл дүние біртұтас
Dialogue: 0,0:13:39.64,0:13:42.79,Default,,0,0,0,,Геакрониканың ерекшелігіне байланысты
Dialogue: 0,0:13:42.79,0:13:45.46,Default,,0,0,0,,Мен ешқашан орындалмайды деп ойлаған басқа әлемде➡
Dialogue: 0,0:13:45.46,0:13:48.46,Default,,0,0,0,,Осылайша қонуға мүмкіндік туды
Dialogue: 0,0:13:48.46,0:13:54.62,Default,,0,0,0,,О, сен бұл қалай сезінетінін білесің бе? Синдо Куроно
Dialogue: 0,0:13:54.62,0:13:58.27,Default,,0,0,0,,Сізге алғысымды айта алмаймын.
Dialogue: 0,0:13:58.27,0:14:00.96,Default,,0,0,0,,Бәрі де тағдыр
Dialogue: 0,0:14:00.96,0:14:03.81,Default,,0,0,0,,Бұл дүниеде дүниеге келгендер➡
Dialogue: 0,0:14:03.81,0:14:07.63,Default,,0,0,0,,Өлгенше өмір сүру үшін күресу және күрес➡
Dialogue: 0,0:14:07.63,0:14:12.50,Default,,0,0,0,,Адамдардың бірін-бірі ренжіткенін көргенім сонша, мен одан шаршадым.
Dialogue: 0,0:14:12.50,0:14:15.62,Default,,0,0,0,,Дүние жойылғысы келеді.
Dialogue: 0,0:14:15.62,0:14:18.78,Default,,0,0,0,,Бос өміріңнен құтыл!
Dialogue: 0,0:14:18.78,0:14:21.80,Default,,0,0,0,,Қайталанатын ақымақ және бос әрекеттер
Dialogue: 0,0:14:21.80,0:14:26.28,Default,,0,0,0,,Тек мағынасыз үздіксіз азап➡
Dialogue: 0,0:14:26.28,0:14:28.29,Default,,0,0,0,,Тез бітіріңізші...
Dialogue: 0,0:14:28.29,0:14:30.49,Default,,0,0,0,,Сол себепті➡
Dialogue: 0,0:14:30.49,0:14:32.96,Default,,0,0,0,,Сенің болмысың туды.
Dialogue: 0,0:14:32.96,0:14:35.88,Default,,0,0,0,,Geacronic бірегейлігі
Dialogue: 0,0:14:35.88,0:14:38.13,Default,,0,0,0,,Сенің бар болмысың➡
Dialogue: 0,0:14:38.13,0:14:43.62,Default,,0,0,0,,Жоюға ұмтылатын дүниенің керемет ашылуы!
Dialogue: 0,0:14:43.62,0:14:48.14,Default,,0,0,0,,Иә! Енді ешкім, тіпті мен де емес➡
Dialogue: 0,0:14:48.14,0:14:50.79,Default,,0,0,0,,Бұл тағдырды тоқтату мүмкін емес!
Dialogue: 0,0:14:50.79,0:14:56.45,Default,,0,0,0,,Енді сіз Мәсіхтің жолбасшысының орнын басып отырсыз➡
Dialogue: 0,0:14:56.45,0:14:58.80,Default,,0,0,0,,Менімен күресу
Dialogue: 0,0:14:58.80,0:15:01.62,Default,,0,0,0,,Бұл да... тағдыр
Dialogue: 0,0:15:01.62,0:15:04.62,Default,,0,0,0,,Хехе... Не болды бұған?
Dialogue: 0,0:15:04.62,0:15:07.49,Default,,0,0,0,,Иә? Мұның мәні неде?
Dialogue: 0,0:15:07.49,0:15:11.04,Default,,0,0,0,,Айтқыңыз келгені осы ма!? Не?
Dialogue: 0,0:15:11.04,0:15:15.95,Default,,0,0,0,,Бұл тітіркендіргіш, бірақ мен бұл жігіттің оны жек көретіндей күшті екенін білемін.
Dialogue: 0,0:15:15.95,0:15:19.12,Default,,0,0,0,,Мен сеніп, сеніп тапсырдым.
Dialogue: 0,0:15:19.12,0:15:22.44,Default,,0,0,0,,Ааа, мына жігіттің кейпінде төбелессең➡
Dialogue: 0,0:15:22.44,0:15:26.99,Default,,0,0,0,,Біздің жеңілуіміз мүмкін емес! Кукуку... түсіндім.
Dialogue: 0,0:15:26.99,0:15:30.76,Default,,0,0,0,,Сіз мұны облигация деп атайсыз ба?
Dialogue: 0,0:15:30.76,0:15:32.80,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:15:32.80,0:15:38.29,Default,,0,0,0,,Бұл байланыс Қаз-саманың күшіне қаншалықты төтеп бере алады?
Dialogue: 0,0:15:38.29,0:15:41.21,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:15:41.21,0:15:45.11,Default,,0,0,0,,Құны бойынша Vanguard картасымен бірдей
Dialogue: 0,0:15:45.11,0:15:47.65,Default,,0,0,0,,Болашағымның мүмкіндігіне тәуекел ету➡
Dialogue: 0,0:15:47.65,0:15:51.03,Default,,0,0,0,,Барлық тіршілік иелерінің жойылу батасы
Dialogue: 0,0:15:51.03,0:15:54.96,Default,,0,0,0,,Жекпе-жекте жеңіліп қалсаңыз, Generation Zone картасы ➡ болады
Dialogue: 0,0:15:54.96,0:15:57.61,Default,,0,0,0,,Мен ешқашан оралмаймын. Керісінше➡
Dialogue: 0,0:15:57.61,0:16:01.78,Default,,0,0,0,,Егер мен жеңсем, менің альтер эго Коудзи Ибукидің өмірі аяқталады➡
Dialogue: 0,0:16:01.78,0:16:05.28,Default,,0,0,0,,Мәсіх күшін жоғалтады
Dialogue: 0,0:16:05.28,0:16:08.67,Default,,0,0,0,,Және Синдо Куроно
Dialogue: 0,0:16:08.67,0:16:11.81,Default,,0,0,0,,Сіз бұл жолы қаз мырза боласыз.
Dialogue: 0,0:16:11.81,0:16:15.13,Default,,0,0,0,,Сіз ыдысқа барынша жақындадыңыз.
Dialogue: 0,0:16:15.13,0:16:17.81,Default,,0,0,0,,Бұл дүниедегі ең көп➡
Dialogue: 0,0:16:17.81,0:16:20.91,Default,,0,0,0,,Қожайынымды паналауға лайық жан!
Dialogue: 0,0:16:23.80,0:16:28.30,Default,,0,0,0,,Шомылдыру рәсімінен өту ғана қалды
Dialogue: 0,0:16:30.62,0:16:34.29,Default,,0,0,0,,Осылай жасасаң, бұл дүниеге қаз-сама болып түсесің➡
Dialogue: 0,0:16:34.29,0:16:36.95,Default,,0,0,0,,Өз қолдарыңмен әкеліңдер
Dialogue: 0,0:16:36.95,0:16:40.45,Default,,0,0,0,,Дүние аңсайды: жойылу мен жойылу!
Dialogue: 0,0:16:40.45,0:16:43.62,Default,,0,0,0,,Менің болашағымды жеп, оны көрсет.
Dialogue: 0,0:16:43.62,0:16:47.96,Default,,0,0,0,,Даркзонның нөлдік айдаһары➡
Dialogue: 0,0:16:47.96,0:16:52.11,Default,,0,0,0,,ｱﾙﾃｨﾒｯﾄｽﾄﾗｲﾄﾞ！
Dialogue: 0,0:16:52.11,0:16:58.41,Default,,0,0,0,,Нөлдік айдаһар шаңының соңы
Dialogue: 0,0:17:00.79,0:17:03.47,Default,,0,0,0,,Шаң жинау дағдылары
Dialogue: 0,0:17:03.47,0:17:07.46,Default,,0,0,0,,Сіздің барлық бөлімшелеріңіз барлық қабілеттерін жоғалтады➡
Dialogue: 0,0:17:07.46,0:17:09.63,Default,,0,0,0,,Баға мен қуат 1-ге айналады
Dialogue: 0,0:17:09.63,0:17:11.95,Default,,0,0,0,,Не!? Мен өз дағдыларымды пайдалана алмаймын!?
Dialogue: 0,0:17:11.95,0:17:15.79,Default,,0,0,0,,《Қуат 1-ге жеткенде, сізге үлкен көлемдегі күзет қажет》
Dialogue: 0,0:17:15.79,0:17:18.30,Default,,0,0,0,,《Ал егер Авангардтың бағасы 1➡ болса
Dialogue: 0,0:17:18.30,0:17:20.46,Default,,0,0,0,,2 немесе одан жоғары сыныпта күзетуге қабілетсіз
Dialogue: 0,0:17:20.46,0:17:24.83,Default,,0,0,0,,Сіз интерсептіні де, генерацияны да пайдалана алмайсыз! 》
Dialogue: 0,0:17:24.83,0:17:28.47,Default,,0,0,0,,Сонымен қатар, Авангардқа 1 зиян
Dialogue: 0,0:17:28.47,0:17:30.97,Default,,0,0,0,,Гуах!!
Dialogue: 0,0:17:30.97,0:17:34.14,Default,,0,0,0,,Уф... Ибуки!
Dialogue: 0,0:17:34.14,0:17:39.14,Default,,0,0,0,,А... ондай ештеңе жоқ...
Dialogue: 0,0:17:39.14,0:17:41.63,Default,,0,0,0,,Жалғастыру. Бірақ...
Dialogue: 0,0:17:41.63,0:17:44.13,Default,,0,0,0,,Жалғастырыңыз!
Dialogue: 0,0:17:44.13,0:17:46.67,Default,,0,0,0,,Ах... Ибуки!
Dialogue: 0,0:17:46.67,0:17:49.29,Default,,0,0,0,,Аа...｡ Жалғыз нәрсе...
Dialogue: 0,0:17:49.29,0:17:52.79,Default,,0,0,0,,Мен сені кешіре алмаймын! Қоңырау
Dialogue: 0,0:17:52.79,0:17:56.61,Default,,0,0,0,,Уф...Истерикалық Ширлидің шеберлігі
Dialogue: 0,0:17:56.61,0:17:59.61,Default,,0,0,0,,Жан заряды қосымша қоңырау
Dialogue: 0,0:17:59.61,0:18:01.61,Default,,0,0,0,,Гастилдің қараңғылығы
Dialogue: 0,0:18:01.61,0:18:06.79,Default,,0,0,0,,Soul ішінен 2 дәрежелі 2 бірлікке дейін таңдап, түсіру аймағына өтіңіз
Dialogue: 0,0:18:06.79,0:18:12.29,Default,,0,0,0,,Осы айналымда барлық қабілеттерін алыңыз.
Dialogue: 0,0:18:12.29,0:18:16.78,Default,,0,0,0,,Гастиле алған орындаушы дағдыларын көрсетті
Dialogue: 0,0:18:16.78,0:18:21.62,Default,,0,0,0,,Палубаның жоғарғы 7 картасын қараңыз және жанға Қараңғылық бар бір картаны салыңыз.
Dialogue: 0,0:18:21.62,0:18:23.62,Default,,0,0,0,,Және…
Dialogue: 0,0:18:23.62,0:18:28.12,Default,,0,0,0,,Демонстрацияланған жазалаушының қараңғылығы Гастеле сатып алған
Dialogue: 0,0:18:28.12,0:18:32.30,Default,,0,0,0,,Жан 10 немесе одан да көп Пауэр Plus 5000 болғанда
Dialogue: 0,0:18:32.30,0:18:34.96,Default,,0,0,0,,Міне
Dialogue: 0,0:18:34.96,0:18:37.82,Default,,0,0,0,,Бұл менің тақсырымның әкелетін ойраны.
Dialogue: 0,0:18:37.82,0:18:42.12,Default,,0,0,0,,Қозғаушы күш - Нөлдік Айдаһардың күші!
Dialogue: 0,0:18:42.12,0:18:45.64,Default,,0,0,0,,Міне, ақыреттің көрінісі!
Dialogue: 0,0:18:45.64,0:18:47.78,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:18:47.78,0:18:50.13,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:18:50.13,0:18:55.79,Default,,0,0,0,,ﾌｧｰｽﾄﾁｪｯｸ ｾｶﾝﾄﾞﾁｪｯｸ ｻｰﾄﾞﾁｪｯｸ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:18:55.79,0:18:58.30,Default,,0,0,0,,Барлық әсерлер артқы қорғаныс газ болатына өтеді
Dialogue: 0,0:18:58.30,0:19:01.14,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:19:01.14,0:19:04.63,Default,,0,0,0,,Gastile алған кепілдің құлауын басатын дағды
Dialogue: 0,0:19:04.63,0:19:08.57,Default,,0,0,0,,Жан 8 немесе одан да көп қуат плюс 10000 болғанда
Dialogue: 0,0:19:08.57,0:19:11.95,Default,,0,0,0,,0-сыныпта күзетуге болмайды.Не!?
Dialogue: 0,0:19:11.95,0:19:14.79,Default,,0,0,0,,Қоштасу, Мәсіхтің нұсқаушысы
Dialogue: 0,0:19:14.79,0:19:16.81,Default,,0,0,0,,Ал рахмет➡
Dialogue: 0,0:19:16.81,0:19:19.36,Default,,0,0,0,,Geacronic бірегейлігі
Dialogue: 0,0:19:19.36,0:19:26.28,Default,,0,0,0,,Енді, міне, қазір, ыдыс толтырылды, жойылу мен жойылу әлемді емдейді!
Dialogue: 0,0:19:26.28,0:19:28.97,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:19:28.97,0:19:34.62,Default,,0,0,0,,Менің арқамда бұл екі дүние жалғанған...
Dialogue: 0,0:19:34.62,0:19:38.31,Default,,0,0,0,,Сол себепті бұл жігіт...
Dialogue: 0,0:19:38.31,0:19:42.30,Default,,0,0,0,,Бұл жігіттің басынан осындай жағдай өтіп жатса→
Dialogue: 0,0:19:42.30,0:19:45.30,Default,,0,0,0,,Одан да... Мен жеңілуге шамасы жоқ!!
Dialogue: 0,0:19:45.30,0:19:50.34,Default,,0,0,0,,Осы жігіттің өмірін сақтап қалу үшін қолыңыздан келгеннің бәрін жасаңыз... біздің болашағымыз!
Dialogue: 0,0:19:50.34,0:19:52.64,Default,,0,0,0,,Қорғаңыз!!
Dialogue: 0,0:19:52.64,0:19:58.03,Default,,0,0,0,,Мм... Алыстағы тағдырыңды тағдырыңа айналдырма...
Dialogue: 0,0:19:58.03,0:20:00.95,Default,,0,0,0,,Шынайы... тағдыр...
Dialogue: 0,0:20:00.95,0:20:04.62,Default,,0,0,0,,Оны өз қолыңызбен ұстаңыз!
Dialogue: 0,0:20:04.62,0:20:06.62,Default,,0,0,0,,Әй
Dialogue: 0,0:20:06.62,0:20:09.92,Default,,0,0,0,,Қолыңызда карта жоқ па? Тұрыңыз және сурет салыңыз!
Dialogue: 0,0:20:12.01,0:20:14.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:14.05,0:20:17.75,Default,,0,0,0,,Кеттік! Қадам ұрпақ!
Dialogue: 0,0:20:19.95,0:20:26.94,Default,,0,0,0,,Жаратылыс Dragon Harmonix Нео Мессия!
Dialogue: 0,0:20:26.94,0:20:28.96,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:20:28.96,0:20:32.95,Default,,0,0,0,,Тұрақты ғарыштық дұға Бала дағдыларының құлпы 2 артқы күзетші
Dialogue: 0,0:20:32.95,0:20:35.00,Default,,0,0,0,,1 карта ұтысы
Dialogue: 0,0:20:35.00,0:20:37.00,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:20:37.00,0:20:39.04,Default,,0,0,0,,Құрбандық жасау дағдылары
Dialogue: 0,0:20:39.04,0:20:41.29,Default,,0,0,0,,ﾛｯｸ！ ｶｳﾝﾀｰﾁｬｰｼﾞ
Dialogue: 0,0:20:41.29,0:20:44.29,Default,,0,0,0,,Harmonix Neo Messiah үшін қуат плюс 3000!
Dialogue: 0,0:20:44.29,0:20:46.66,Default,,0,0,0,,Идеалды эго деп атаңыз
Dialogue: 0,0:20:46.66,0:20:48.68,Default,,0,0,0,,Вирастос дағдылары
Dialogue: 0,0:20:48.68,0:20:51.30,Default,,0,0,0,,ﾛｯｸ｡ ｿｳﾙﾁｬｰｼﾞ！
Dialogue: 0,0:20:51.30,0:20:54.62,Default,,0,0,0,,Артқы сақшының идеалды эгосымен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:20:54.62,0:20:56.62,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:20:56.62,0:20:59.99,Default,,0,0,0,,Идеалды эго дағдылары. Өзіңізді құлыптаңыз
Dialogue: 0,0:20:59.99,0:21:01.99,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:21:06.63,0:21:09.63,Default,,0,0,0,,Авангардқа шабуыл!!
Dialogue: 0,0:21:11.65,0:21:15.31,Default,,0,0,0,,Harmonix Neo Messiah ұрпағы үштен бөлінді!
Dialogue: 0,0:21:15.31,0:21:18.61,Default,,0,0,0,,Барлық құлыпталған блоктардың құлпын ашыңыз!
Dialogue: 0,0:21:18.61,0:21:21.81,Default,,0,0,0,,Құлыптан босатылған блоктар үшін қуат плюс 5000!
Dialogue: 0,0:21:24.62,0:21:29.06,Default,,0,0,0,,Harmonix Neo Messiah үшін қуат плюс 25000!
Dialogue: 0,0:21:29.06,0:21:32.79,Default,,0,0,0,,Мен 5 дененің құлпын ашқандықтан, мен 1 немесе одан жоғары сыныптарда күзете алмаймын!
Dialogue: 0,0:21:32.79,0:21:34.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:34.79,0:21:39.28,Default,,0,0,0,,Вирастос дағдылары. Қуат плюс 4000! Неон Мессия Аурионның шеберлігі!
Dialogue: 0,0:21:39.28,0:21:41.28,Default,,0,0,0,,1 карта ұтысы
Dialogue: 0,0:21:41.28,0:21:43.58,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ5000！
Dialogue: 0,0:21:45.62,0:21:47.62,Default,,0,0,0,,Өлуіме жол берме
Dialogue: 0,0:21:47.62,0:21:49.92,Default,,0,0,0,,Мен оны ыдыс ретінде пайдалануым керек пе?
Dialogue: 0,0:21:52.05,0:21:55.75,Default,,0,0,0,,Жүр!
Dialogue: 0,0:21:57.63,0:21:59.63,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:22:01.64,0:22:05.34,Default,,0,0,0,,Гуах!!
Dialogue: 0,0:22:10.61,0:22:13.30,Default,,0,0,0,,А... иә... иә...
Dialogue: 0,0:22:13.30,0:22:15.99,Default,,0,0,0,,Амансың ба? Ах... аа...
Dialogue: 0,0:22:15.99,0:22:18.99,Default,,0,0,0,,Сізге рахмет...
Dialogue: 0,0:22:20.97,0:22:22.97,Default,,0,0,0,,А... а...
Dialogue: 0,0:22:24.96,0:22:27.26,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:22:27.26,0:22:29.97,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:22:29.97,0:22:33.32,Default,,0,0,0,,Басқаша айтқанда, менің пешка ретіндегі рөлім осы жерде аяқталады.
Dialogue: 0,0:22:33.32,0:22:36.62,Default,,0,0,0,,Мен енді бұл дүниеде болмасам да→
Dialogue: 0,0:22:36.62,0:22:41.28,Default,,0,0,0,,Ешқандай қирау болмайды...
Dialogue: 0,0:22:41.28,0:22:45.28,Default,,0,0,0,,Әй, кезек біткен әртістер→
Dialogue: 0,0:22:45.28,0:22:48.28,Default,,0,0,0,,Әдемі кетіңіз
Dialogue: 0,0:22:48.28,0:22:50.29,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:22:50.29,0:22:52.97,Default,,0,0,0,,Болашақта қанша күрессең де→
Dialogue: 0,0:22:52.97,0:22:58.34,Default,,0,0,0,,Тағдырдан қашып құтыла алмайсың! Geacronic бірегейлігі
Dialogue: 0,0:22:58.34,0:23:00.96,Default,,0,0,0,,Синдо Куроно!
Dialogue: 0,0:23:00.96,0:23:05.79,Default,,0,0,0,,Драмалық финал мен шымылдығы басталғалы тұр.
Dialogue: 0,0:23:05.79,0:23:09.89,Default,,0,0,0,,Қалғанын сұрадым, Валеос...
Dialogue: 0,0:23:18.03,0:23:20.95,Default,,0,0,0,,[TEL] (Крис) Әрине, сол аймақтың айналасында →
Dialogue: 0,0:23:20.95,0:23:25.37,Default,,0,0,0,,Реликсті тудырған кеңістік-уақыт бұрмалануының әсері сақталды.
Dialogue: 0,0:23:25.37,0:23:28.94,Default,,0,0,0,,[TEL] Бірақ, өкінішке орай, екеуі қайда жоғалып кетті?→
Dialogue: 0,0:23:28.94,0:23:32.31,Default,,0,0,0,,Оларды табуға араласпаңыз.
Dialogue: 0,0:23:32.31,0:23:37.37,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:23:37.37,0:23:39.95,Default,,0,0,0,,Ибуки мырза...
Dialogue: 0,0:23:39.95,0:23:41.95,Default,,0,0,0,,Куроно-кун?
Dialogue: 0,0:23:41.95,0:23:45.11,Default,,0,0,0,,Амансың ба? Ал Ибуки ше?
Dialogue: 0,0:23:45.11,0:23:48.29,Default,,0,0,0,,[ТЕЛ] Мен сенімен біргемін. Сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:23:48.29,0:23:50.30,Default,,0,0,0,,Иә... Иә!
Dialogue: 0,0:23:50.30,0:23:52.93,Default,,0,0,0,,Екеуміз де аманбыз! Сен оралдың
Dialogue: 0,0:23:52.93,0:23:55.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:55.28,0:23:57.95,Default,,0,0,0,,Сіз күткендей, Куроно мырза!
Dialogue: 0,0:23:57.95,0:24:00.97,Default,,0,0,0,,Жарайды, жаңа жылдық кешті қайта ұйымдастырайық!
Dialogue: 0,0:24:00.97,0:24:04.37,Default,,0,0,0,,Дұрыс. (Кай) Тағы да Рождество!
Dialogue: 0,0:24:06.28,0:24:08.28,Default,,0,0,0,,Сәлем. Ах...
Dialogue: 0,0:24:08.28,0:24:10.97,Default,,0,0,0,,Амансың ба? аа...
Dialogue: 0,0:24:10.97,0:24:13.95,Default,,0,0,0,,Өзіңізді қатты итермеңіз. Мені қарт адамдай көрме.
Dialogue: 0,0:24:13.95,0:24:15.96,Default,,0,0,0,,Ха
Dialogue: 0,0:24:15.96,0:24:18.96,Default,,0,0,0,,Керісінше, бұл сізге Рождестволық сыйлық.
Dialogue: 0,0:24:18.96,0:24:22.95,Default,,0,0,0,,А... мен сенен сыйлық алғаныма біраз болды.
Dialogue: 0,0:24:22.95,0:24:26.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:26.28,0:24:29.95,Default,,0,0,0,,Эй, бұл сіздің Рождестволық сыйлығыңыз ба?
Dialogue: 0,0:24:29.95,0:24:33.62,Default,,0,0,0,,Қанағаттанбады ма? Жоқ... өйткені...
Dialogue: 0,0:24:33.62,0:24:37.29,Default,,0,0,0,,...
Dialogue: 0,0:24:37.29,0:24:39.95,Default,,0,0,0,,…
Dialogue: 0,0:24:39.95,0:24:46.14,Default,,0,0,0,,Оның әлемді жоюға мүмкіндігі жоқ. Оны қалай пайдалану керектігін сізге қалдырамын.
Dialogue: 0,0:24:46.14,0:24:51.61,Default,,0,0,0,,Сен маған Гассильдің тағдыры үлкен өтірік екенін көрсетесің.
Dialogue: 0,0:24:51.61,0:24:54.06,Default,,0,0,0,,Кеш! Куроно жігіт
Dialogue: 0,0:24:54.06,0:24:57.28,Default,,0,0,0,,Мен қайтып келгенде, мен сізге тағы бір сыйлық жіберуім керек.
Dialogue: 0,0:24:57.28,0:24:59.97,Default,,0,0,0,,ｻﾝﾀ…
Dialogue: 0,0:24:59.97,0:25:02.60,Default,,0,0,0,,Ах! Жақында емес пе?
Dialogue: 0,0:25:02.60,0:25:04.62,Default,,0,0,0,,ｲｴｰｲ！
Dialogue: 0,0:25:04.62,0:25:07.61,Default,,0,0,0,,Аяз ата! Аяз ата!
Dialogue: 0,0:25:07.61,0:25:09.61,Default,,0,0,0,,Эй
Dialogue: 0,0:25:09.61,0:25:14.61,Default,,0,0,0,,Неліктен сіз Авангардты қорғау үшін сонша әрекетке барасыз?
Dialogue: 0,0:25:14.61,0:25:17.63,Default,,0,0,0,,А... не? Бұталардан таяқтарға дейін
Dialogue: 0,0:25:17.63,0:25:20.97,Default,,0,0,0,,Жекпе-жек адамның бәрін көрсетеді
Dialogue: 0,0:25:20.97,0:25:23.62,Default,,0,0,0,,Оның орнына бүгін шайқас →
Dialogue: 0,0:25:23.62,0:25:26.61,Default,,0,0,0,,Осы уақытқа дейін сіздермен болған ұрыстарымды еске түсіріңізші.
Dialogue: 0,0:25:26.61,0:25:30.63,Default,,0,0,0,,Дұрыс. Бір күні...
Dialogue: 0,0:25:30.63,0:25:34.62,Default,,0,0,0,,Мен саған өскенде айтамын.
Dialogue: 0,0:25:34.62,0:25:36.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:36.62,0:25:39.96,Default,,0,0,0,,Алкогольді ішу тіпті жақсы тағамдар емес.
Dialogue: 0,0:25:39.96,0:25:43.29,Default,,0,0,0,,Күте тұрыңыз... 20-ға келгенше күтесіз бе?
Dialogue: 0,0:25:43.29,0:25:46.31,Default,,0,0,0,,Аа, бұл солай.
Dialogue: 0,0:25:46.31,0:25:48.61,Default,,0,0,0,,...
Dialogue: 0,0:25:48.61,0:25:50.63,Default,,0,0,0,,Хехе
Dialogue: 0,0:25:50.63,0:25:52.93,Default,,0,0,0,,Мен сондай мүйіздімін
Dialogue: 0,0:27:30.35,0:27:32.37,Default,,0,0,0,,ﾀﾞｰｸﾌｪｲｽ
Dialogue: 0,0:27:32.37,0:27:34.29,Default,,0,0,0,,Сіз!!
Dialogue: 0,0:27:34.29,0:27:37.96,Default,,0,0,0,,Өткен күні жақсы болды! (ﾙｳｶﾞ)ｶｵｽﾌﾞﾚｲｶｰ
Dialogue: 0,0:27:37.96,0:27:40.94,Default,,0,0,0,,Сіз 4-топпен өте көңілді болған сияқтысыз.
Dialogue: 0,0:27:40.94,0:27:43.33,Default,,0,0,0,,...
Dialogue: 0,0:27:43.33,0:27:46.37,Default,,0,0,0,,...
Dialogue: 0,0:27:46.37,0:27:48.62,Default,,0,0,0,,Сенің қолыңды кім ойлайды!
Dialogue: 0,0:27:48.62,0:27:51.29,Default,,0,0,0,,Бос уақыт аяқталды
Dialogue: 0,0:27:51.29,0:27:53.62,Default,,0,0,0,,Уақыт толы
Dialogue: 0,0:27:53.62,0:27:58.32,Default,,0,0,0,,Біз, қалған елшілер, соңғы миссиямызды орындаған кезде
Dialogue: 0,0:30:37.30,0:30:39.97,Default,,0,0,0,,ｶﾉﾝ
Dialogue: 0,0:30:39.97,0:30:42.67,Default,,0,0,0,,Канонтеба!
Dialogue: 0,0:30:49.38,0:30:51.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:57.79,0:31:01.89,Default,,0,0,0,,Мұнда мектепте ме? Қысқы демалыс болса да
Dialogue: 0,0:31:03.39,0:31:09.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory