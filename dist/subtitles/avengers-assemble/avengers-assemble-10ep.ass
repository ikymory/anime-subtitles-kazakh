Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.13,0:00:41.43,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.64,0:00:48.08,Default,,0,0,0,,<Кек алушылар Бұл супер қаһармандар →
Dialogue: 0,0:00:48.08,0:00:51.63,Default,,0,0,0,,Жиналған ең күшті батырлар командасы
Dialogue: 0,0:00:51.63,0:00:54.63,Default,,0,0,0,,Өзіңіздің керемет күшіңізді жинаңыз және жердің тыныштығын қорғаңыз! ＞
Dialogue: 0,0:00:54.63,0:00:56.97,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.97,0:00:59.10,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:59.10,0:01:01.62,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.62,0:01:03.62,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.62,0:01:05.64,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.64,0:01:07.64,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.65,0:01:12.15,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:12.15,0:01:15.15,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:15.15,0:01:17.19,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:17.19,0:01:19.22,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:19.22,0:01:21.22,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:23.64,0:01:28.03,Default,,0,0,0,,Мына жерге кел де, тез тарт.
Dialogue: 0,0:01:28.03,0:01:31.09,Default,,0,0,0,,Бұл күлкілі. Мұның қажеті жоқ.
Dialogue: 0,0:01:31.09,0:01:35.44,Default,,0,0,0,,Асығыңыз. Лотерея ең лайықты адамды таңдайды.
Dialogue: 0,0:01:35.44,0:01:37.79,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:37.79,0:01:43.61,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:43.61,0:01:47.49,Default,,0,0,0,,Аа, бұл өтірік. Өткен аптада мен де қысқа сабан салдым.
Dialogue: 0,0:01:47.49,0:01:50.02,Default,,0,0,0,,Тазалық тәртіпті сақтауға көмектеседі
Dialogue: 0,0:01:50.02,0:01:54.94,Default,,0,0,0,,Мұны жаза деп ойламаңыз. Бұл сенің міндетің. Барлығы көмектеседі.
Dialogue: 0,0:01:54.94,0:01:58.80,Default,,0,0,0,,Бұл менің телефоным емес. (Сонымен) Бұл Асгардтың хабарламасы.
Dialogue: 0,0:01:58.80,0:02:01.12,Default,,0,0,0,,Бұл өлшемдерден асып түсетін электрондық пошта.
Dialogue: 0,0:02:01.12,0:02:06.42,Default,,0,0,0,,Маскаңызды ұмытпаңыз. Халктың гамма-сәулелері өлімге әкеледі.
Dialogue: 0,0:02:09.54,0:02:13.61,Default,,0,0,0,,Мен жаңа көрсеткіні Халктың бетімен сынап көрейін деп жатырмын, бірақ сіз оны көргіңіз келе ме?
Dialogue: 0,0:02:13.61,0:02:16.78,Default,,0,0,0,,Сіз мені естисіз бе? Мен қазір барамын. Келесің бе?
Dialogue: 0,0:02:16.78,0:02:19.93,Default,,0,0,0,,Бұл өте пайдалы.
Dialogue: 0,0:02:19.93,0:02:23.79,Default,,0,0,0,,Уа, бұл бұрынғы электрондық пошта ма? Эй, мұның саған еш қатысы жоқ.
Dialogue: 0,0:02:23.79,0:02:29.11,Default,,0,0,0,,Мм, ``Мен Тор Ординсонды бітіру емтиханына қонақ ретінде шақырғым келеді.''
Dialogue: 0,0:02:29.11,0:02:31.95,Default,,0,0,0,,Жақсы, демалыс. Мен жинауым керек.
Dialogue: 0,0:02:31.95,0:02:34.97,Default,,0,0,0,,Асгард? Соғуға тұрарлық біреу бар сияқты.
Dialogue: 0,0:02:34.97,0:02:37.00,Default,,0,0,0,,Уа. Мен бармаймын.
Dialogue: 0,0:02:37.00,0:02:39.10,Default,,0,0,0,,Мен бұл қала үшін алаңдаймын.
Dialogue: 0,0:02:39.10,0:02:44.16,Default,,0,0,0,,Эй, эй, сен мектепте жұлдызды және өте танымал болдың, солай ма?
Dialogue: 0,0:02:44.16,0:02:47.70,Default,,0,0,0,,Барлығы сіздің жағдайыңызды білгісі келеді.
Dialogue: 0,0:02:47.70,0:02:49.81,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:02:49.81,0:02:54.15,Default,,0,0,0,,Білге, барып ал. Мен кептеліп қалдым.
Dialogue: 0,0:02:54.15,0:02:58.31,Default,,0,0,0,,Мен Тонидің Арсеналдың басымен қайта-қайта сөйлескенін көргім келеді➡
Dialogue: 0,0:02:58.31,0:03:01.48,Default,,0,0,0,,Тордың алма-материн көруге бару әлдеқайда қызықты болар еді.
Dialogue: 0,0:03:01.48,0:03:03.66,Default,,0,0,0,,Мен шын жүректен ойлаймын
Dialogue: 0,0:03:03.66,0:03:06.53,Default,,0,0,0,,Асгардтағы мектептер жердегі мектептерден ерекшеленеді.
Dialogue: 0,0:03:06.53,0:03:10.12,Default,,0,0,0,,Әр күн – соғыс. Оқушылар топ құрады➡
Dialogue: 0,0:03:10.12,0:03:13.95,Default,,0,0,0,,Олар кім күшті екенін анықтау үшін жарысты.
Dialogue: 0,0:03:13.95,0:03:16.11,Default,,0,0,0,,А, бұл мектеп, солай ма?
Dialogue: 0,0:03:16.11,0:03:18.63,Default,,0,0,0,,Мектептегідей
Dialogue: 0,0:03:18.63,0:03:21.13,Default,,0,0,0,,Бірақ сіз тек Үлкен залға кіре аласыз.
Dialogue: 0,0:03:21.13,0:03:24.28,Default,,0,0,0,,Неге екенін білмеймін, бірақ тез кетейік.
Dialogue: 0,0:03:24.28,0:03:26.30,Default,,0,0,0,,Майорния, қайтыңыз!
Dialogue: 0,0:03:26.30,0:03:29.94,Default,,0,0,0,,Heimdal порталы!
Dialogue: 0,0:03:29.94,0:03:32.96,Default,,0,0,0,,Бұл көңілді болатын сияқты
Dialogue: 0,0:03:32.96,0:03:37.63,Default,,0,0,0,,Кеш басталғалы тұр!
Dialogue: 0,0:03:37.63,0:03:44.30,Default,,0,0,0,,Құдай-ай!! Бұл да…
Dialogue: 0,0:03:44.30,0:03:46.97,Default,,0,0,0,,Арсенал Халктың іші шіріп жатыр ма?
Dialogue: 0,0:03:46.97,0:03:50.14,Default,,0,0,0,,Жер дірілдеп тұр
Dialogue: 0,0:03:50.14,0:03:54.65,Default,,0,0,0,,Шексіздік тасы анықталды ма?
Dialogue: 0,0:03:54.65,0:03:57.82,Default,,0,0,0,,Барлығың дайындалыңдар. Бұл қарапайым нәрсе болмайтын сияқты.
Dialogue: 0,0:03:57.82,0:04:04.24,Default,,0,0,0,,Біреу ғарыш тасын іске қосты.
Dialogue: 0,0:04:04.24,0:04:06.47,Default,,0,0,0,,Бұл тас не істейді?
Dialogue: 0,0:04:06.47,0:04:13.11,Default,,0,0,0,,Физикалық кеңістікті басқару. Аймақ өлшемі порталы
Dialogue: 0,0:04:13.11,0:04:16.12,Default,,0,0,0,,Вахаха!
Dialogue: 0,0:04:16.12,0:04:20.77,Default,,0,0,0,,Түскі асқа таң қалмаңыз. Осы жерде.
Dialogue: 0,0:04:20.77,0:04:23.96,Default,,0,0,0,,Бұл балқыту пеші деген не?
Dialogue: 0,0:04:23.96,0:04:30.16,Default,,0,0,0,,Уау, мен жаңағы айтқанымды жоққа шығара аламын! Бұл мектеп емес!
Dialogue: 0,0:05:54.13,0:05:56.15,Default,,0,0,0,,Неліктен сұлт бар?
Dialogue: 0,0:05:56.15,0:05:59.15,Default,,0,0,0,,Хеймдал одан да жақсы! (3 адам) Портал!
Dialogue: 0,0:06:07.95,0:06:10.45,Default,,0,0,0,,Кешіріңіз. Бірдеңе мені бұзды➡
Dialogue: 0,0:06:10.45,0:06:12.83,Default,,0,0,0,,Портал бақылаудан тыс
Dialogue: 0,0:06:12.83,0:06:17.45,Default,,0,0,0,,Хеймдал Біраз уақыт өтті. Не болды? Айтыңызшы
Dialogue: 0,0:06:17.45,0:06:20.47,Default,,0,0,0,,Тоғыз аймақ бақылаудан шықты.
Dialogue: 0,0:06:20.47,0:06:24.31,Default,,0,0,0,,Мен де себебін білмеймін. Сақ болыңыз.
Dialogue: 0,0:06:24.31,0:06:27.81,Default,,0,0,0,,Әрине өзгереді. (Жер сылдыры)
Dialogue: 0,0:06:29.78,0:06:32.45,Default,,0,0,0,,Бұл туралы не деуге болады? Жағдайы нашар
Dialogue: 0,0:06:32.45,0:06:37.46,Default,,0,0,0,,Ғимараттың жоғарғы қабаттарындағы өрт тез таралуда.
Dialogue: 0,0:06:37.46,0:06:40.14,Default,,0,0,0,,Елеулі шығын болады!
Dialogue: 0,0:06:40.14,0:06:42.14,Default,,0,0,0,,Менің жақсы ойым бар.
Dialogue: 0,0:06:47.28,0:06:49.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:51.49,0:06:56.48,Default,,0,0,0,,Мен кейінірек түсіндіруім керек. Хамф!
Dialogue: 0,0:06:56.48,0:06:59.78,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:05.00,0:07:07.02,Default,,0,0,0,,Келесі апат болғанға дейін ➡
Dialogue: 0,0:07:07.02,0:07:09.16,Default,,0,0,0,,Ғарыш тасы қай жерде екенін білесіңдер деп үміттенемін.
Dialogue: 0,0:07:09.16,0:07:15.96,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:15.96,0:07:18.77,Default,,0,0,0,,Асгард оқу үйі
Dialogue: 0,0:07:18.77,0:07:21.32,Default,,0,0,0,,О, біз Тордың алма-материн көре аламыз.
Dialogue: 0,0:07:21.32,0:07:23.44,Default,,0,0,0,,Аа... бәрібір дәл осылай➡
Dialogue: 0,0:07:23.44,0:07:25.96,Default,,0,0,0,,Үлкен залдағы банкет залына барайық.
Dialogue: 0,0:07:25.96,0:07:27.98,Default,,0,0,0,,Мен Одиннің ұлымын.
Dialogue: 0,0:07:27.98,0:07:31.13,Default,,0,0,0,,Жарайды, мен кетіп бара жатып бір қарап алайын.
Dialogue: 0,0:07:31.13,0:07:33.16,Default,,0,0,0,,Адамдар көргіңіз келмейтін фотосуреттер бар ма?
Dialogue: 0,0:07:33.16,0:07:36.96,Default,,0,0,0,,Бірақ мереке...күте тұрыңыз! Мен печенье болатынына сенімдімін.
Dialogue: 0,0:07:40.14,0:07:42.16,Default,,0,0,0,,Бұл Тордың мектебі ме?
Dialogue: 0,0:07:42.16,0:07:45.21,Default,,0,0,0,,А... міне, бірақ қыдыруға жарамайды.
Dialogue: 0,0:07:45.21,0:07:47.11,Default,,0,0,0,,Біз іздеген нәрсе...
Dialogue: 0,0:07:47.11,0:07:49.61,Default,,0,0,0,,Иә, иә, сәл күте тұрыңыз.
Dialogue: 0,0:07:49.61,0:07:52.28,Default,,0,0,0,,Бұл ұят фото болды.
Dialogue: 0,0:07:52.28,0:07:56.27,Default,,0,0,0,,Неліктен мұнда тек Локидің суреттері ғана бар?
Dialogue: 0,0:07:56.27,0:07:59.76,Default,,0,0,0,,Энергетикалық операция бастығы Роки
Dialogue: 0,0:07:59.76,0:08:01.78,Default,,0,0,0,,Сиқырлы бас Локи...
Dialogue: 0,0:08:01.78,0:08:04.95,Default,,0,0,0,,Бітіру емтиханы жоғарғы... Roki
Dialogue: 0,0:08:04.95,0:08:08.33,Default,,0,0,0,,Дұрыс. Локи кез келген пәннен жақсы➡
Dialogue: 0,0:08:08.33,0:08:10.95,Default,,0,0,0,,Ол нағыз үздік оқушы болды.
Dialogue: 0,0:08:10.95,0:08:14.10,Default,,0,0,0,,Ақылды болған Локи қазір жауынгерлер зиратына айналды➡
Dialogue: 0,0:08:14.10,0:08:17.27,Default,,0,0,0,,Валхалланың қолына түскені өкінішті.
Dialogue: 0,0:08:17.27,0:08:19.78,Default,,0,0,0,,Күте тұрыңыз, Тордың аты жоқ.
Dialogue: 0,0:08:19.78,0:08:24.13,Default,,0,0,0,,Сіз осы оғаш сиқырлы мектепті бітіргенсіз, солай ма?
Dialogue: 0,0:08:24.13,0:08:26.93,Default,,0,0,0,,Болуы керек еді, бірақ әке➡
Dialogue: 0,0:08:26.93,0:08:30.62,Default,,0,0,0,,Ол майданда менің көмегім керек екенін айтты, сондықтан...
Dialogue: 0,0:08:30.62,0:08:33.12,Default,,0,0,0,,Сондықтан мен оқуды бітірген жоқпын.
Dialogue: 0,0:08:33.12,0:08:36.96,Default,,0,0,0,,Мектеп бітіру емтиханының соңғы күнін күтпестен майдан даласына аттанды.
Dialogue: 0,0:08:36.96,0:08:41.57,Default,,0,0,0,,Сондықтан мен сіз айтқандай оқуды бітірмедім...
Dialogue: 0,0:08:41.57,0:08:44.02,Default,,0,0,0,,Сұрақ! Сіз осында байланып қалдыңыз ба?
Dialogue: 0,0:08:44.02,0:08:47.39,Default,,0,0,0,,Әй, сен мені үнемі аңдып жүресің
Dialogue: 0,0:08:47.39,0:08:50.14,Default,,0,0,0,,Керемет, бұл қалыпты жағдай.
Dialogue: 0,0:08:50.14,0:08:52.14,Default,,0,0,0,,ﾛｷ？
Dialogue: 0,0:08:52.14,0:08:54.81,Default,,0,0,0,,Кішкентай аға, сіз Валхаллада болуыңыз керек!
Dialogue: 0,0:08:54.81,0:08:57.01,Default,,0,0,0,,Біз мұнда қалай келдік?
Dialogue: 0,0:08:59.68,0:09:01.70,Default,,0,0,0,,Сен неге елестерді қуып жүрсің?
Dialogue: 0,0:09:01.70,0:09:03.72,Default,,0,0,0,,ше? Оны ашыңыз!
Dialogue: 0,0:09:03.72,0:09:06.16,Default,,0,0,0,,Оны соғудың қажеті жоқ.
Dialogue: 0,0:09:06.16,0:09:08.14,Default,,0,0,0,,Бір жабылған соң, ешқашан ашпаңыз
Dialogue: 0,0:09:08.14,0:09:11.15,Default,,0,0,0,,Мұның бәрі Локидің зұлым жоспары болуы керек.
Dialogue: 0,0:09:11.15,0:09:14.30,Default,,0,0,0,,Бұл шақыру жалған➡
Dialogue: 0,0:09:14.30,0:09:16.68,Default,,0,0,0,,Мен мектепте қамалып отырмын ба?
Dialogue: 0,0:09:16.68,0:09:19.99,Default,,0,0,0,,Қандай әзіл. Егер мен 15 жаста болсам, мұны көрсем, күлетін едім.
Dialogue: 0,0:09:19.99,0:09:22.99,Default,,0,0,0,,Бұл жерден шығудың бір ғана жолы бар.
Dialogue: 0,0:09:24.99,0:09:27.46,Default,,0,0,0,,Бұлай айтудың бір жолы!
Dialogue: 0,0:09:27.46,0:09:29.81,Default,,0,0,0,,Түсінікті. Күте тұрыңыз.
Dialogue: 0,0:09:29.81,0:09:33.18,Default,,0,0,0,,Мектептің орталығына барсаңыз, портал бар.
Dialogue: 0,0:09:33.18,0:09:35.22,Default,,0,0,0,,Бірақ жету үшін➡
Dialogue: 0,0:09:35.22,0:09:37.62,Default,,0,0,0,,Бітіру емтиханын тапсыру керек
Dialogue: 0,0:09:37.62,0:09:39.62,Default,,0,0,0,,Мен және Халк?
Dialogue: 0,0:09:39.62,0:09:42.11,Default,,0,0,0,,Менің беделімді мен таңдаған жауынгер анықтайды.
Dialogue: 0,0:09:42.11,0:09:44.11,Default,,0,0,0,,Үшеуі де өтуі керек
Dialogue: 0,0:09:44.11,0:09:46.13,Default,,0,0,0,,Басқаша айтқанда, топта үш адам бар.
Dialogue: 0,0:09:46.13,0:09:48.12,Default,,0,0,0,,Сөйлесу жеткілікті. Емтихан қиын ба?
Dialogue: 0,0:09:48.12,0:09:50.12,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:09:50.12,0:09:53.79,Default,,0,0,0,,Бірақ емтихан тапсыру залына кіргеннен кейін ешқашан кері қайту мүмкін емес.
Dialogue: 0,0:09:53.79,0:09:58.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:58.79,0:10:03.28,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:10:03.28,0:10:06.33,Default,,0,0,0,,Бір уақытта тек бір жауынгер ғана шайқаса алады
Dialogue: 0,0:10:06.33,0:10:08.64,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:10:08.64,0:10:10.62,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:10:10.62,0:10:18.45,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:18.45,0:10:20.45,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:10:20.45,0:10:23.62,Default,,0,0,0,,Жоқ, бұл Халктың сынағы. Тек қашып кет➡
Dialogue: 0,0:10:23.62,0:10:26.60,Default,,0,0,0,,Онымен араласпаңыз. Бұл емтиханның екінші ережесі.
Dialogue: 0,0:10:26.60,0:10:28.62,Default,,0,0,0,,Біріншісі қандай?
Dialogue: 0,0:10:28.62,0:10:32.29,Default,,0,0,0,,Сәтсіздікке жол бермеңіз. Егер сәтсіздікке ұшырасаңыз, Валхаллаға барасыз.
Dialogue: 0,0:10:32.29,0:10:34.80,Default,,0,0,0,,Марубату проблемалық сынағы жақсы емес пе?
Dialogue: 0,0:10:34.80,0:10:36.78,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:10:36.78,0:10:44.78,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:49.94,0:10:53.28,Default,,0,0,0,,Тор мен Халк қайда? Hawkeye де
Dialogue: 0,0:10:53.28,0:10:55.97,Default,,0,0,0,,Джарвистің айтуынша, Тор Хоки мен Халкты алып келген➡
Dialogue: 0,0:10:55.97,0:10:57.95,Default,,0,0,0,,Олар Асгардқа бара жатқан сияқты.
Dialogue: 0,0:10:57.95,0:11:04.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:04.37,0:11:06.31,Default,,0,0,0,,Жағдай ушығып барады.
Dialogue: 0,0:11:06.31,0:11:09.46,Default,,0,0,0,,Егер заттар осылай жалғаса берсе, Жер құлап кетуі мүмкін.
Dialogue: 0,0:11:09.46,0:11:12.35,Default,,0,0,0,,Тор порталды ашқанда, ол дірілдей бастады.
Dialogue: 0,0:11:12.35,0:11:14.67,Default,,0,0,0,,Ғарыш тасымен байланысты болуы керек.
Dialogue: 0,0:11:14.67,0:11:18.77,Default,,0,0,0,,Мен онымен байланыса алмаймын Асгарда Соның телефон нөмірін біреу біледі ме?
Dialogue: 0,0:11:21.83,0:11:24.03,Default,,0,0,0,,Бұл қажет емес деп ойлаймын.
Dialogue: 0,0:11:26.70,0:11:29.20,Default,,0,0,0,,Ол Асгардтан келді.
Dialogue: 0,0:12:31.19,0:12:34.78,Default,,0,0,0,,Ах~ Халк! Оны тез сындырыңыз!
Dialogue: 0,0:12:34.78,0:12:37.13,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:12:37.13,0:12:54.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:54.79,0:12:56.79,Default,,0,0,0,,Маған сенің мектебің ұнайды!
Dialogue: 0,0:12:59.77,0:13:03.97,Default,,0,0,0,,Менің талдауым дұрыс болса, Асгард бұл қалаға басып кірді!
Dialogue: 0,0:13:06.45,0:13:08.62,Default,,0,0,0,,Менің көзқарасым бір, Сұңқар.
Dialogue: 0,0:13:08.62,0:13:11.45,Default,,0,0,0,,Ең бастысы, ғарыш тастарын кім және қайда пайдаланып жатыр?➡
Dialogue: 0,0:13:11.45,0:13:13.50,Default,,0,0,0,,Бұл көбірек алаңдатады.
Dialogue: 0,0:13:13.50,0:13:15.51,Default,,0,0,0,,Ұрыс алаңының ортасын табыңыз
Dialogue: 0,0:13:15.51,0:13:17.77,Default,,0,0,0,,Мүмкін Асгард.
Dialogue: 0,0:13:17.77,0:13:21.13,Default,,0,0,0,,Асгардпен нақты кімнің туысы бар?
Dialogue: 0,0:13:21.13,0:13:23.28,Default,,0,0,0,,Сонан басқа
Dialogue: 0,0:13:23.28,0:13:26.45,Default,,0,0,0,,Локи! Сіз ғарыштық тасты алдыңыз.
Dialogue: 0,0:13:26.45,0:13:28.80,Default,,0,0,0,,Сіз Вальхалладан қашуды жоспарлап отырсыз ба?
Dialogue: 0,0:13:28.80,0:13:30.80,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:13:32.84,0:13:36.13,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:13:36.13,0:13:38.80,Default,,0,0,0,,Тазаланды
Dialogue: 0,0:13:38.80,0:13:42.15,Default,,0,0,0,,Жүгіру қиын болды, бірақ бұл емтихан қарапайым➡
Dialogue: 0,0:13:42.15,0:13:46.29,Default,,0,0,0,,Сіз оңай өтіп кете аласыз. (Локи) Хахахаха!
Dialogue: 0,0:13:46.29,0:13:49.27,Default,,0,0,0,,Бірінші емтиханды тапсырды, тағы екеуі қалды.
Dialogue: 0,0:13:49.27,0:13:52.31,Default,,0,0,0,,Мұны қалай жасадыңыз?
Dialogue: 0,0:13:52.31,0:13:56.95,Default,,0,0,0,,Соқтығысқан аймақтар арқылы таңқаларлық нәрселер жасауға болатын сияқты.
Dialogue: 0,0:13:56.95,0:13:59.78,Default,,0,0,0,,Кішкентай елес! Ах!
Dialogue: 0,0:13:59.78,0:14:01.80,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:14:01.80,0:14:05.94,Default,,0,0,0,,Енді құдайлардың әкесі Один інісін қабылдауға батылы бармады➡
Dialogue: 0,0:14:05.94,0:14:08.13,Default,,0,0,0,,Емтихан тапсыра аламын ба?
Dialogue: 0,0:14:08.13,0:14:10.13,Default,,0,0,0,,Один мұны істемейді.
Dialogue: 0,0:14:10.13,0:14:13.01,Default,,0,0,0,,Мен майдан даласында керек болдым
Dialogue: 0,0:14:13.01,0:14:17.05,Default,,0,0,0,,О, сізді ұзақ соғыстан кейін дәл сол күні шақырды ма?
Dialogue: 0,0:14:17.05,0:14:21.12,Default,,0,0,0,,Кездейсоқтық - ақымақтардың сылтауы
Dialogue: 0,0:14:21.12,0:14:24.29,Default,,0,0,0,,Кет, алаяқ! Емтиханды жалғастырайық!
Dialogue: 0,0:14:24.29,0:14:27.28,Default,,0,0,0,,Емтихан енді ғана басталды
Dialogue: 0,0:14:27.28,0:14:29.78,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:14:29.78,0:14:32.93,Default,,0,0,0,,Сонымен келесі бөлмеге қалай барамыз?
Dialogue: 0,0:14:32.93,0:14:35.49,Default,,0,0,0,,Құдай-ай!! Бұл да…
Dialogue: 0,0:14:35.49,0:14:38.11,Default,,0,0,0,,Бұл ақымақ сұрақ болды! Апыр-ай!
Dialogue: 0,0:14:38.11,0:14:40.11,Default,,0,0,0,,(ｿｰ)ﾊﾙｸ！ ﾎｰｸｱｲ！
Dialogue: 0,0:14:43.98,0:14:46.53,Default,,0,0,0,,Әй, солай! Шамдарды қосыңыз!
Dialogue: 0,0:14:46.53,0:14:48.53,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:14:50.77,0:14:53.12,Default,,0,0,0,,А, бірдеңе естіп тұрсың ба?
Dialogue: 0,0:14:53.12,0:14:55.96,Default,,0,0,0,,Сындыратын біреу пайда болған сияқты
Dialogue: 0,0:14:55.96,0:14:59.11,Default,,0,0,0,,Онымен араласпа! Келесі Hawkeye сынағы.
Dialogue: 0,0:14:59.11,0:15:02.13,Default,,0,0,0,,Неліктен бұл менің емтиханым?
Dialogue: 0,0:15:02.13,0:15:05.65,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:05.65,0:15:08.45,Default,,0,0,0,,Бірдеңені тістеп алғыңыз келе ме? Мен мұнымен өмір сүре аламын!
Dialogue: 0,0:15:10.45,0:15:13.45,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:15:15.46,0:15:18.11,Default,,0,0,0,,Жынданып кететін кез келді!
Dialogue: 0,0:15:18.11,0:15:20.81,Default,,0,0,0,,Жарайды, дұрыс.
Dialogue: 0,0:15:20.81,0:15:23.81,Default,,0,0,0,,Егер бұл өрт болса, бұл электр тогы!
Dialogue: 0,0:15:27.97,0:15:31.34,Default,,0,0,0,,Ол айдаһар ма?
Dialogue: 0,0:15:31.34,0:15:40.95,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:40.95,0:15:43.12,Default,,0,0,0,,Жарайсың ба? Қапырық бейбақ!
Dialogue: 0,0:15:43.12,0:15:45.62,Default,,0,0,0,,Бізде бір ортақ нәрсе бар!
Dialogue: 0,0:15:50.61,0:15:53.11,Default,,0,0,0,,Сіз де, мен де ұша алмаймыз!
Dialogue: 0,0:15:53.11,0:16:03.44,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:03.44,0:16:07.83,Default,,0,0,0,,Ей, бұл жаман болған жоқ. Бұл өте қиын емтихан болған жоқ.
Dialogue: 0,0:16:07.83,0:16:10.45,Default,,0,0,0,,Әлі бітіру емтихандары қалды.
Dialogue: 0,0:16:10.45,0:16:13.82,Default,,0,0,0,,Роки о дүниеден қашуға тырысып жатыр ма?
Dialogue: 0,0:16:13.82,0:16:16.94,Default,,0,0,0,,Оның көптеген салаларда артқы есіктері бар.
Dialogue: 0,0:16:16.94,0:16:19.79,Default,,0,0,0,,Менің ойымша, Валхалладан Асгардқа өту жолы да бар.
Dialogue: 0,0:16:19.79,0:16:23.09,Default,,0,0,0,,Бірақ сіз Асгардсыз Асгардқа кіре алмайсыз.
Dialogue: 0,0:16:23.09,0:16:26.45,Default,,0,0,0,,Сонда бір жол бар.
Dialogue: 0,0:16:26.45,0:16:28.77,Default,,0,0,0,,Сіздің кезегіңіз.
Dialogue: 0,0:16:28.77,0:16:31.08,Default,,0,0,0,,Мен дайынмын.
Dialogue: 0,0:16:31.08,0:16:33.27,Default,,0,0,0,,Локи Бұл қандай бөлме?
Dialogue: 0,0:16:33.27,0:16:36.94,Default,,0,0,0,,Алдымен күш, сосын жылдамдық
Dialogue: 0,0:16:36.94,0:16:39.44,Default,,0,0,0,,Даналықтың соңғы сынағы
Dialogue: 0,0:16:39.44,0:16:42.31,Default,,0,0,0,,Менің ағамның кезегі.
Dialogue: 0,0:16:42.31,0:16:45.85,Default,,0,0,0,,Менің қолымнан келсе, ағамның да қолынан келеді.
Dialogue: 0,0:16:45.85,0:16:49.10,Default,,0,0,0,,Ордин жаңа ғана сізге Асгардтың кілтін берді.
Dialogue: 0,0:16:49.10,0:16:51.10,Default,,0,0,0,,Ұлы аға
Dialogue: 0,0:16:51.10,0:16:54.77,Default,,0,0,0,,Өтірікті удай түкіресің.
Dialogue: 0,0:16:54.77,0:16:58.78,Default,,0,0,0,,Сіздің ағаңыз өзінің құндылығын дәлелдеді ме?
Dialogue: 0,0:16:58.78,0:17:02.27,Default,,0,0,0,,Сіз бұл ел мен оның балғасына ие болуға лайықтымын деп айта аласыз ба?
Dialogue: 0,0:17:02.27,0:17:04.47,Default,,0,0,0,,Енді көрсетейін
Dialogue: 0,0:17:10.12,0:17:12.78,Default,,0,0,0,,Қарсылығым тегін берілсе➡
Dialogue: 0,0:17:12.78,0:17:15.11,Default,,0,0,0,,Сіз мені ешқашан танымайсыз
Dialogue: 0,0:17:15.11,0:17:20.15,Default,,0,0,0,,Егер сіз тырыссаңыз, сіз білуіңіз мүмкін. Мен кіммін?
Dialogue: 0,0:17:20.15,0:17:22.45,Default,,0,0,0,,Жұмбақ? Бұл дұрыс
Dialogue: 0,0:17:22.45,0:17:24.79,Default,,0,0,0,,Мен аздап бұрылыс қостым.
Dialogue: 0,0:17:24.79,0:17:27.19,Default,,0,0,0,,Мен жұмбақ кітабын ұмытып кетіппін
Dialogue: 0,0:17:29.09,0:17:31.69,Default,,0,0,0,,Енді маған жауап беріңіз. Ешқандай алдау жоқ.
Dialogue: 0,0:17:35.27,0:17:38.45,Default,,0,0,0,,Керісінше тегін беріледі. Күш сал.
Dialogue: 0,0:17:38.45,0:17:41.44,Default,,0,0,0,,Білеміз бе?
Dialogue: 0,0:17:41.44,0:17:43.46,Default,,0,0,0,,Жоқ, білмеймін.
Dialogue: 0,0:17:43.46,0:17:47.16,Default,,0,0,0,,Сіз сәтсіз адамсыз.
Dialogue: 0,0:17:49.88,0:17:52.27,Default,,0,0,0,,Мына мінсіз дулығаның ішінде не бар?➡
Dialogue: 0,0:17:52.27,0:17:55.17,Default,,0,0,0,,Ол бос емес сияқты.
Dialogue: 0,0:17:59.79,0:18:03.28,Default,,0,0,0,,Мен биік тұрмын, бірақ әлі де қысқарамын➡
Dialogue: 0,0:18:03.28,0:18:05.95,Default,,0,0,0,,Құнды, бірақ танылмаған
Dialogue: 0,0:18:05.95,0:18:11.10,Default,,0,0,0,,Менің елім өзгерді, бірақ ол туған жер. Мен кіммін?
Dialogue: 0,0:18:11.10,0:18:14.45,Default,,0,0,0,,Бағалы, бірақ танылмаған ба?
Dialogue: 0,0:18:14.45,0:18:17.49,Default,,0,0,0,,Локи, сен мен туралы солай ойлайтын шығарсың.
Dialogue: 0,0:18:17.49,0:18:23.43,Default,,0,0,0,,Сіз Тор Ординсонсыз. Жоқ.
Dialogue: 0,0:18:23.43,0:18:25.63,Default,,0,0,0,,Сәтсіздік
Dialogue: 0,0:18:27.60,0:18:29.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:29.59,0:18:31.62,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:18:31.62,0:18:34.62,Default,,0,0,0,,Сіз әрқашан тек өзіңіз туралы ойлайсыз.
Dialogue: 0,0:18:34.62,0:18:37.43,Default,,0,0,0,,Ауырсынуға аздап қараған дұрыс деп ойлаймын.
Dialogue: 0,0:18:37.43,0:18:39.78,Default,,0,0,0,,Сәтсіздік
Dialogue: 0,0:18:39.78,0:18:42.93,Default,,0,0,0,,Сонымен Одинсон. (Сонымен) Ух...
Dialogue: 0,0:18:42.93,0:18:45.85,Default,,0,0,0,,Один дұрыс айтты
Dialogue: 0,0:18:45.85,0:18:49.29,Default,,0,0,0,,Менің ағам бұл сынақтан өтуге лайық емес еді.
Dialogue: 0,0:18:49.29,0:18:52.44,Default,,0,0,0,,Сен ақымақсың, басыңды пайдалана алмайсың.
Dialogue: 0,0:18:52.44,0:18:59.10,Default,,0,0,0,,Thor Ordinson failed. Тор Ординсон сәтсіз аяқталды
Dialogue: 0,0:18:59.10,0:19:01.79,Default,,0,0,0,,Менің ағамның құны жоқ.
Dialogue: 0,0:19:01.79,0:19:03.77,Default,,0,0,0,,Таң қалдыратын жалғыз нәрсе –➡
Dialogue: 0,0:19:03.77,0:19:07.26,Default,,0,0,0,,Бұл тек өтірікпен нығайтылған Одиннің маған берген сенімі.
Dialogue: 0,0:19:07.26,0:19:09.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:09.28,0:19:12.93,Default,,0,0,0,,Ағамның сәтсіздігінің арқасында түрменің қақпасы ашылды.
Dialogue: 0,0:19:12.93,0:19:14.93,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:19:14.93,0:19:21.60,Default,,0,0,0,,Тор Ординсон сәтсіз аяқталды. Тор Ординсон сәтсіз аяқталды
Dialogue: 0,0:19:21.60,0:19:24.97,Default,,0,0,0,,Тор Ординсонның сәтсіздігі
Dialogue: 0,0:19:24.97,0:19:27.61,Default,,0,0,0,,Мен сені Валхаллаға қайта жіберемін...
Dialogue: 0,0:19:27.61,0:19:31.43,Default,,0,0,0,,Егер сізде ғарыш тасы болса, сіз кез келген уақытта Валхалладан қозғала аласыз.
Dialogue: 0,0:19:31.43,0:19:35.45,Default,,0,0,0,,Порталды ағамдай ақымақ ашса ғой.
Dialogue: 0,0:19:35.45,0:19:39.86,Default,,0,0,0,,Есікті ашқаныңыз үшін рахмет
Dialogue: 0,0:19:39.86,0:19:41.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:41.94,0:19:46.14,Default,,0,0,0,,Мені түкке тұрғысыз деп тұрсың ба?
Dialogue: 0,0:20:48.09,0:20:50.44,Default,,0,0,0,,Мен түкке тұрғысыз ба?
Dialogue: 0,0:20:50.44,0:20:53.11,Default,,0,0,0,,Әй, аға, шынымен де бітті.
Dialogue: 0,0:20:53.11,0:20:57.91,Default,,0,0,0,,Бірақ менің жоспарларым енді ғана басталып жатыр.
Dialogue: 0,0:21:00.79,0:21:03.62,Default,,0,0,0,,Менде әлі күнге дейін жауынгерлік рух қалды
Dialogue: 0,0:21:03.62,0:21:05.62,Default,,0,0,0,,Сәтсіздік
Dialogue: 0,0:21:08.93,0:21:12.10,Default,,0,0,0,,Жарай ма? Осындай үлкен нәрсе үшін➡
Dialogue: 0,0:21:12.10,0:21:14.10,Default,,0,0,0,,Мен ешқашан қанатты пакеттерді киген емеспін.
Dialogue: 0,0:21:14.10,0:21:17.10,Default,,0,0,0,,Бұл жұмыс істейді, солай ма? Тони. Asgard жүйесіне қалай кіруге болады➡
Dialogue: 0,0:21:17.10,0:21:19.11,Default,,0,0,0,,Бұл сізге керек, солай ма?
Dialogue: 0,0:21:19.11,0:21:22.41,Default,,0,0,0,,Егер сіз саңылау болса, шағымыңыз жоқ. Барып алыңыз!
Dialogue: 0,0:21:26.13,0:21:30.43,Default,,0,0,0,,Жақсы өтті. Күткендей, біз Сұңқармыз.
Dialogue: 0,0:21:30.43,0:21:34.10,Default,,0,0,0,,Егер сіз осындай нәрседен өміріңізден айырылсаңыз, ұят болады.
Dialogue: 0,0:21:34.10,0:21:36.79,Default,,0,0,0,,Жақсы бала, Билли.
Dialogue: 0,0:21:36.79,0:21:39.49,Default,,0,0,0,,Ақылдың орнына күш?
Dialogue: 0,0:21:41.44,0:21:43.45,Default,,0,0,0,,Әдеттегідей.
Dialogue: 0,0:21:43.45,0:21:45.45,Default,,0,0,0,,Мен биік тұрамын, бірақ әлі де қысқарамын➡
Dialogue: 0,0:21:45.45,0:21:48.33,Default,,0,0,0,,Құнды, бірақ танылмаған
Dialogue: 0,0:21:48.33,0:21:53.33,Default,,0,0,0,,Менің елім өзгерді, бірақ ол туған жер. Мен кіммін?
Dialogue: 0,0:21:57.76,0:22:00.46,Default,,0,0,0,,Сіз Локи Рофей Сансыз
Dialogue: 0,0:22:02.45,0:22:05.80,Default,,0,0,0,,Тіптен ақымақтардың да тығырыққа тірелуі мүмкін.
Dialogue: 0,0:22:05.80,0:22:08.96,Default,,0,0,0,,Түсіру
Dialogue: 0,0:22:08.96,0:22:13.66,Default,,0,0,0,,Сен күшпен күрес, мен ақылмен күресемін.
Dialogue: 0,0:22:15.61,0:22:20.98,Default,,0,0,0,,Екеуі де Валхалла деп аталатын қорқынышты түстен құтылу үшін қажет болды.
Dialogue: 0,0:22:20.98,0:22:24.18,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:22:26.46,0:22:30.59,Default,,0,0,0,,Есікті ағам ашу керек еді.
Dialogue: 0,0:22:30.59,0:22:33.93,Default,,0,0,0,,Әкем мені қалай пайдаланса, ағам да маған➡
Dialogue: 0,0:22:33.93,0:22:36.13,Default,,0,0,0,,Бұл құралдан басқа ештеңе емес!
Dialogue: 0,0:22:44.94,0:22:47.44,Default,,0,0,0,,Бізді банкетке шақырмайсың ба?
Dialogue: 0,0:22:47.44,0:22:49.45,Default,,0,0,0,,Мен ашулы емеспін.
Dialogue: 0,0:22:49.45,0:22:52.45,Default,,0,0,0,,Сен мұнда не үшін келдің? күшейткіштер келді
Dialogue: 0,0:22:52.45,0:22:56.95,Default,,0,0,0,,Сонымен не болып жатыр? Мен естіген әңгіме өтірік болды
Dialogue: 0,0:22:56.95,0:23:00.09,Default,,0,0,0,,Мен майорния алуға лайық емеспін.
Dialogue: 0,0:23:00.09,0:23:02.61,Default,,0,0,0,,Бұл ата-ана мен бала арасындағы мәселе.
Dialogue: 0,0:23:02.61,0:23:06.61,Default,,0,0,0,,Олай болса, маған өз құндылығыңызды көрсетесіз бе, кек алушылар?
Dialogue: 0,0:23:06.61,0:23:11.18,Default,,0,0,0,,Оның орнына мен сізге Ғарыш тасының шынайы күшін көрсетемін.
Dialogue: 0,0:23:11.18,0:23:13.95,Default,,0,0,0,,Ол бізге сабақ беріп жатқан сияқты.
Dialogue: 0,0:23:13.95,0:23:17.61,Default,,0,0,0,,Мен сынақтан өттім! Avengers Assemble!
Dialogue: 0,0:23:17.61,0:23:24.76,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:24.76,0:23:26.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:26.77,0:23:29.44,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:29.44,0:23:33.27,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,0:23:33.27,0:23:37.44,Default,,0,0,0,,Фуфуфуфу…｡ Hawkeye!
Dialogue: 0,0:23:37.44,0:23:40.26,Default,,0,0,0,,Ха! Апыр-ай!
Dialogue: 0,0:23:40.26,0:23:43.62,Default,,0,0,0,,Ендеше, күрес! Маған майорния керек!
Dialogue: 0,0:23:43.62,0:23:45.95,Default,,0,0,0,,Маған сен керексің!
Dialogue: 0,0:23:45.95,0:23:49.94,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:49.94,0:23:52.36,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:23:52.36,0:23:55.45,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:23:55.45,0:23:59.62,Default,,0,0,0,,Сонымен, мен «Кек алушылар» тобына қосылғаннан бері Локидің өтірігін естимін.
Dialogue: 0,0:23:59.62,0:24:04.60,Default,,0,0,0,,Бірақ Тордың құндылығы жоқ деп айту - ең үлкен өтірік.
Dialogue: 0,0:24:04.60,0:24:08.29,Default,,0,0,0,,Рахмет сізге Falcon! Оқу бітіретін кез келді
Dialogue: 0,0:24:08.29,0:24:11.69,Default,,0,0,0,,Локи! Мен жеткілікті болдым
Dialogue: 0,0:24:11.69,0:24:14.19,Default,,0,0,0,,Енді жарысайық.
Dialogue: 0,0:24:17.30,0:24:21.12,Default,,0,0,0,,Ха! Мына балға нені соғады➡
Dialogue: 0,0:24:21.12,0:24:23.62,Default,,0,0,0,,Шешуші менмін.
Dialogue: 0,0:24:30.28,0:24:34.17,Default,,0,0,0,,Майорния мен сияқты жай ғана құрал емес.
Dialogue: 0,0:24:34.17,0:24:41.46,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:41.46,0:24:43.81,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:24:43.81,0:24:46.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:48.13,0:24:50.30,Default,,0,0,0,,ﾑｼﾞｮﾙﾆｱ！
Dialogue: 0,0:24:50.30,0:24:57.96,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:57.96,0:25:02.13,Default,,0,0,0,,Бұл жерден Нью-Йорктің көрінісі ерекше, бірақ енді оны көре алмайсыз.
Dialogue: 0,0:25:02.13,0:25:09.30,Default,,0,0,0,,Мүмкін емес... Ағамды бітіру емтиханынан өте алмайды деп ойлаған.
Dialogue: 0,0:25:09.30,0:25:12.50,Default,,0,0,0,,Одан тіпті Один де қорықты.
Dialogue: 0,0:25:14.77,0:25:17.44,Default,,0,0,0,,Ғарыш тасы осында болды ма?
Dialogue: 0,0:25:17.44,0:25:28.12,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:28.12,0:25:31.99,Default,,0,0,0,,Асгард, менің сағыныш туған қалам
Dialogue: 0,0:25:31.99,0:25:37.11,Default,,0,0,0,,Сіздің арқаңызда мен мектепті аяқтадым.
Dialogue: 0,0:25:37.11,0:25:40.60,Default,,0,0,0,,Мен Халктың киімінен иіс шығады деп ойладым, бірақ Тонидің сауытынан да иіс шығады➡
Dialogue: 0,0:25:40.60,0:25:43.15,Default,,0,0,0,,Оны желге шығару керек. Күткендей➡
Dialogue: 0,0:25:43.15,0:25:45.19,Default,,0,0,0,,Лотерея дұрыс адамды таңдайды, солай ма?
Dialogue: 0,0:25:45.19,0:25:47.61,Default,,0,0,0,,Бас Тор Ординсон
Dialogue: 0,0:25:47.61,0:25:51.59,Default,,0,0,0,,Сізді бітіру емтиханын рекордтық мерзімде тапсыруыңызбен құттықтаймыз
Dialogue: 0,0:25:51.59,0:25:54.51,Default,,0,0,0,,Хахахаха! Оқуымды бітірген соң➡
Dialogue: 0,0:25:54.51,0:25:58.45,Default,,0,0,0,,Көріп отырғаныңыздай, мектеп соншалықты жаман болған жоқ.
Dialogue: 0,0:25:58.45,0:26:01.10,Default,,0,0,0,,Қабырғаға іліп қояйын, Сәлем! тістері?
Dialogue: 0,0:26:01.10,0:26:03.70,Default,,0,0,0,,Жақсы, менікі де!
Dialogue: 0,0:26:36.46,0:26:38.77,Default,,0,0,0,,<«Кек алушылар жиналады» фильмінде пайда болатын суперқаһармандар және басқалар➡
Dialogue: 0,0:26:38.77,0:26:42.11,Default,,0,0,0,,Зұлым және т.б. туралы ақпарат осында жинақталған
Dialogue: 0,0:26:42.11,0:26:44.11,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:46.15,0:26:48.20,Default,,0,0,0,,<Тор - Асгард патшасы Одиннің ұлы➡
Dialogue: 0,0:26:48.20,0:26:51.27,Default,,0,0,0,,Найзағай мен қатты желді шақыру үшін Майорнияны пайдаланыңыз➡
Dialogue: 0,0:26:51.27,0:26:54.12,Default,,0,0,0,,Аспанда ұш. Оның жездесі Роки➡
Dialogue: 0,0:26:54.12,0:26:57.26,Default,,0,0,0,,Сиқыр мен миды жуу арқылы апат әкелуге тырысу
Dialogue: 0,0:26:57.26,0:27:01.16,Default,,0,0,0,,Адамзатты қорғау үшін Тор ағасының амбициясына қарсы күресуді таңдайды>
Dialogue: 0,0:27:02.66,0:27:08.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
