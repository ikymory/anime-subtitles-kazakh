Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.32,0:00:40.62,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:44.81,0:00:46.81,Default,,0,0,0,,<Кек алушылар, яғни➡
Dialogue: 0,0:00:46.81,0:00:48.81,Default,,0,0,0,,Супер қаһармандар жиналды➡
Dialogue: 0,0:00:48.81,0:00:50.81,Default,,0,0,0,,Ең күшті батырлар командасы
Dialogue: 0,0:00:50.81,0:00:52.83,Default,,0,0,0,,Өзіңіздің трансценденттік күшіңізді жинаңыз➡
Dialogue: 0,0:00:52.83,0:00:54.80,Default,,0,0,0,,Жер бетіндегі тыныштықты қорғаңыз! ＞
Dialogue: 0,0:00:54.80,0:00:56.82,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.82,0:00:58.86,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:58.86,0:01:00.88,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:00.88,0:01:02.91,Default,,0,0,0,,Найзағай Құдай Тор
Dialogue: 0,0:01:02.91,0:01:04.81,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:04.81,0:01:06.81,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:08.80,0:01:11.32,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.32,0:01:14.32,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.32,0:01:16.34,Default,,0,0,0,,Қарсылас қандай болса да жеңілмеймін
Dialogue: 0,0:01:16.34,0:01:18.31,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:18.31,0:01:20.31,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:22.35,0:01:26.98,Default,,0,0,0,,Бұл жаңа компьютер сияқты, ешқандай проблема жоқ.
Dialogue: 0,0:01:26.98,0:01:30.18,Default,,0,0,0,,Келесі - электр жүйесі.
Dialogue: 0,0:01:33.64,0:01:35.83,Default,,0,0,0,,Олай болса, маған көбірек күш беріңіз.
Dialogue: 0,0:01:35.83,0:01:38.50,Default,,0,0,0,,Бірақ оны асыра алмаңыз. (Сонымен) Әрине.
Dialogue: 0,0:01:38.50,0:01:41.68,Default,,0,0,0,,Майорния найзағайды теңдесі жоқ дәлдікпен басқара алады.
Dialogue: 0,0:01:41.68,0:01:43.68,Default,,0,0,0,,Ой
Dialogue: 0,0:01:52.96,0:01:55.65,Default,,0,0,0,,Күрсіну… Теңдессіз дәлдік пе?
Dialogue: 0,0:01:55.65,0:01:59.00,Default,,0,0,0,,Бұл дайын машинаны Stark Tech ➡ жасаған
Dialogue: 0,0:01:59.00,0:02:01.02,Default,,0,0,0,,Нәзік болып көрінеді
Dialogue: 0,0:02:01.02,0:02:03.14,Default,,0,0,0,,Кешіріңіз, бірақ мен қазір осы мұнарадамын➡
Dialogue: 0,0:02:03.14,0:02:06.16,Default,,0,0,0,,Ең жоғары технологиялысы - капитанның ескі радиосы.
Dialogue: 0,0:02:06.16,0:02:08.96,Default,,0,0,0,,Сонда сіз капитанның бөлмесіне кірдіңіз бе?
Dialogue: 0,0:02:08.96,0:02:11.98,Default,,0,0,0,,Жоқ... жақсы, сәл ғана.
Dialogue: 0,0:02:11.98,0:02:13.98,Default,,0,0,0,,Егер кәмпит алғыңыз келсе, маған хабарлаңыз.
Dialogue: 0,0:02:13.98,0:02:17.87,Default,,0,0,0,,Ультронды жеңу үшін мұнараны қысқартудан басқа амал қалмады.
Dialogue: 0,0:02:17.87,0:02:21.64,Default,,0,0,0,,Бірақ мен қанша жақсы болсам да, технология менің мамандығым емес.
Dialogue: 0,0:02:21.64,0:02:24.48,Default,,0,0,0,,Сізге ми керек емес пе?
Dialogue: 0,0:02:24.48,0:02:28.65,Default,,0,0,0,,Мен тұрған үңгірде темір костюм жасадым.
Dialogue: 0,0:02:28.65,0:02:32.80,Default,,0,0,0,,[Радио] Қалқанды тасымалдау ұшағына сорғыш адам шабуыл жасап жатқаны туралы ақпарат бар➡
Dialogue: 0,0:02:32.80,0:02:35.65,Default,,0,0,0,,Мен кірдім. Адамды сіңіре ме?
Dialogue: 0,0:02:35.65,0:02:37.66,Default,,0,0,0,,Көзді жұмып та жеңуге болады
Dialogue: 0,0:02:37.66,0:02:40.69,Default,,0,0,0,,Ол біздің рухымызды көтеретін тамаша қарсылас.
Dialogue: 0,0:02:40.69,0:02:44.24,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:02:44.24,0:02:48.24,Default,,0,0,0,,Енді бәріміз... бәріміз жиналдық.
Dialogue: 0,0:02:50.33,0:02:52.33,Default,,0,0,0,,≪Бұл ол! (айқай)
Dialogue: 0,0:02:57.47,0:03:00.16,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:03:00.16,0:03:03.01,Default,,0,0,0,,Бұл қалқан сипаттамалары бар арматураланған болат па?
Dialogue: 0,0:03:03.01,0:03:05.53,Default,,0,0,0,,Сосын мен аламын.
Dialogue: 0,0:03:05.53,0:03:08.30,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:08.30,0:03:10.30,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:10.30,0:03:13.97,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:03:13.97,0:03:16.64,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:16.64,0:03:19.33,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен мүлде қозғала алмаймын
Dialogue: 0,0:03:19.33,0:03:23.30,Default,,0,0,0,,Болаттан күшті снаряд. Сіз таң қалатын едіңіз. Бұл құпия қару.
Dialogue: 0,0:03:23.30,0:03:26.32,Default,,0,0,0,,Менің кезегім кетті, солай емес пе? (Шұғыл) Жақсысың ба?
Dialogue: 0,0:03:26.32,0:03:29.81,Default,,0,0,0,,Ең бастысы - жеңіске жету
Dialogue: 0,0:03:29.81,0:03:32.96,Default,,0,0,0,,Бізді теледидардан көрсетеді
Dialogue: 0,0:03:32.96,0:03:35.33,Default,,0,0,0,,Шашыңызды түзетіңіз
Dialogue: 0,0:03:35.33,0:03:39.48,Default,,0,0,0,,Менің шашым әрқашан мінсіз
Dialogue: 0,0:03:39.48,0:03:42.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:42.42,0:03:44.62,Default,,0,0,0,,Меган Макларен? Мен таң қалдым.
Dialogue: 0,0:03:44.62,0:03:47.47,Default,,0,0,0,,Рахмет Саған сіңірген адам
Dialogue: 0,0:03:47.47,0:03:50.31,Default,,0,0,0,,Мен сен үшін бәрін істеймін, Титания.
Dialogue: 0,0:03:50.31,0:03:52.81,Default,,0,0,0,,Енді сіз көбірек қабілеттісіз➡
Dialogue: 0,0:03:52.81,0:03:55.30,Default,,0,0,0,,Сіздерді жаңа Кек алушылармен таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:03:55.30,0:03:57.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:57.80,0:04:01.81,Default,,0,0,0,,Ах~ Жаңа көргенімді көрдім бе?
Dialogue: 0,0:04:01.81,0:04:04.81,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:04:04.81,0:04:08.15,Default,,0,0,0,,Бұл Асгардтың сиқырлы металл жүні ме?
Dialogue: 0,0:04:08.15,0:04:11.65,Default,,0,0,0,,Уф! Бұл одан әрі күшейтіледі
Dialogue: 0,0:04:13.65,0:04:15.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:18.32,0:04:22.32,Default,,0,0,0,,Өкінішке орай, мораль жақсармайтын сияқты.
Dialogue: 0,0:05:44.41,0:05:47.33,Default,,0,0,0,,Кек алушылар үшін қарап отыр, оларды міндетті түрде жеңіңіз.
Dialogue: 0,0:05:47.33,0:05:49.33,Default,,0,0,0,,Сіз табандысыз!
Dialogue: 0,0:05:52.00,0:05:55.99,Default,,0,0,0,,Арнайы зақымдануды мақсат ету? Бұл шайқаста интернет жарылып кетеді.
Dialogue: 0,0:05:55.99,0:05:58.51,Default,,0,0,0,,Бұл жаман. (Меган) Ақаулық?
Dialogue: 0,0:05:58.51,0:06:01.83,Default,,0,0,0,,Мәселе жоқ, біз Кек алушылармыз.
Dialogue: 0,0:06:01.83,0:06:04.66,Default,,0,0,0,,Асығыңыз! Әрине... Уау!
Dialogue: 0,0:06:04.66,0:06:06.70,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:06:06.70,0:06:09.80,Default,,0,0,0,,Қаруыңыздың дәмін татыңыз! Апыр-ай!
Dialogue: 0,0:06:09.80,0:06:12.15,Default,,0,0,0,,Ой!
Dialogue: 0,0:06:12.15,0:06:14.99,Default,,0,0,0,,Нені сіңірсем де, ол үлкен мақсат болып қала береді.
Dialogue: 0,0:06:14.99,0:06:18.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:18.33,0:06:22.00,Default,,0,0,0,,Ха! Апыр-ай! Уф...
Dialogue: 0,0:06:22.00,0:06:24.20,Default,,0,0,0,,Рахмет. Мен сені қорғаймын.
Dialogue: 0,0:06:26.48,0:06:29.99,Default,,0,0,0,,Ол балғадай күшті және ақымақ.
Dialogue: 0,0:06:29.99,0:06:32.81,Default,,0,0,0,,Көрмесең, шабуыл жасай алмайсың. Сонымен!
Dialogue: 0,0:06:32.81,0:06:35.48,Default,,0,0,0,,Сіз не істеп жатырсыз? Мүмкін сізге көмектесуім керек пе?
Dialogue: 0,0:06:35.48,0:06:38.46,Default,,0,0,0,,Аралас әйелді жек көреді.
Dialogue: 0,0:06:38.46,0:06:41.83,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:06:41.83,0:06:43.98,Default,,0,0,0,,Жүннен жасалған заттарды не істеу керек
Dialogue: 0,0:06:43.98,0:06:45.99,Default,,0,0,0,,Лақтыр! Апыр-ай!
Dialogue: 0,0:06:45.99,0:06:47.99,Default,,0,0,0,,Ооо!
Dialogue: 0,0:06:47.99,0:06:51.14,Default,,0,0,0,,Олай болса, оны жіберіңіз. Сіздің қалауыңыз білсін.
Dialogue: 0,0:06:51.14,0:06:54.81,Default,,0,0,0,,Уау!!
Dialogue: 0,0:06:54.81,0:06:59.68,Default,,0,0,0,,Гравитацияға қарсы электронды шар. Сондай-ақ жаңа жасағаныма патент алдым.
Dialogue: 0,0:06:59.68,0:07:01.97,Default,,0,0,0,,Мұны істеу үшін үш адам қажет болды➡
Dialogue: 0,0:07:01.97,0:07:04.47,Default,,0,0,0,,Сорғыш адам мен Титанияны жеңді
Dialogue: 0,0:07:04.47,0:07:07.82,Default,,0,0,0,,Олар Thanos немесе Hyperion сияқты қауіпті емес.
Dialogue: 0,0:07:07.82,0:07:11.38,Default,,0,0,0,,Тіпті жұтатын еркектер де аздап қорқынышты.
Dialogue: 0,0:07:11.38,0:07:14.48,Default,,0,0,0,,Сондықтан, менің ойымша, ол батырға ұқсайды.
Dialogue: 0,0:07:14.48,0:07:17.30,Default,,0,0,0,,Бірақ Капитан Америка мен Халк қайда?
Dialogue: 0,0:07:17.30,0:07:21.47,Default,,0,0,0,,Негізі қажет емес қызметкерлерді қысқарту арқылы өлшемді азайттық.
Dialogue: 0,0:07:21.47,0:07:24.16,Default,,0,0,0,,Avengers жеңілдетілді➡
Dialogue: 0,0:07:24.16,0:07:26.81,Default,,0,0,0,,Кез келген жаумен күресуге қабілетті
Dialogue: 0,0:07:26.81,0:07:31.18,Default,,0,0,0,,Мен қазір баруым керек, әлем тыныштығын қорғау үшін.
Dialogue: 0,0:07:31.18,0:07:35.82,Default,,0,0,0,,Ой! (Сұңқар Көз) Мен Кек алғанды ​​сағындым!
Dialogue: 0,0:07:35.82,0:07:37.97,Default,,0,0,0,,Ал енді не болады?
Dialogue: 0,0:07:37.97,0:07:40.47,Default,,0,0,0,,Мен капитанның бөлмесінен үстел ойынын таптым.
Dialogue: 0,0:07:40.47,0:07:43.34,Default,,0,0,0,,Сіз акустикалық гитарада ойнап, шам жарығында оқығыңыз келе ме?
Dialogue: 0,0:07:43.34,0:07:45.36,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:45.36,0:07:47.97,Default,,0,0,0,,Жоқ, жоқ! Ах...
Dialogue: 0,0:07:47.97,0:07:51.47,Default,,0,0,0,,Электр қуатынсыз не істеуге болады?
Dialogue: 0,0:07:51.47,0:07:54.64,Default,,0,0,0,,Бұл жабайы қабанға аң аулау. үшін бұрынғы қалпына келеді.
Dialogue: 0,0:07:54.64,0:07:56.82,Default,,0,0,0,,Маған біраз уақыт беріңіз
Dialogue: 0,0:07:56.82,0:07:59.98,Default,,0,0,0,,Ультронды жеңу керек болса да, бұл қиын таңдау болған шығар, солай емес пе?
Dialogue: 0,0:07:59.98,0:08:02.66,Default,,0,0,0,,Қатты тырыспа, мен саған сенемін.
Dialogue: 0,0:08:02.66,0:08:05.65,Default,,0,0,0,,Адамдар өз күштерін сынақ кезінде ғана көрсетеді.
Dialogue: 0,0:08:05.65,0:08:08.65,Default,,0,0,0,,Кеткен достар көп ұзамай қателіктерін түсінді➡
Dialogue: 0,0:08:08.65,0:08:12.81,Default,,0,0,0,,Олар сіздің көшбасшылығыңызды мойындауы керек.
Dialogue: 0,0:08:12.81,0:08:15.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:15.14,0:08:18.00,Default,,0,0,0,,Технологияға келетін болсақ, бұл сөзсіз Falcon.
Dialogue: 0,0:08:18.00,0:08:20.15,Default,,0,0,0,,Аа, қазір жақын жерде болуы керек➡
Dialogue: 0,0:08:20.15,0:08:22.85,Default,,0,0,0,,Сіз бұл командаға оралу үшін қышынуыңыз керек.
Dialogue: 0,0:08:26.04,0:08:28.07,Default,,0,0,0,,Сұңқардан қалқан агентіне дейін
Dialogue: 0,0:08:28.07,0:08:30.57,Default,,0,0,0,,Бұл жерде ешқандай қате жоқ. Тура жүріңіз.
Dialogue: 0,0:08:33.48,0:08:37.48,Default,,0,0,0,,ﾄﾆｰ？ ﾌｧﾙｺﾝ？
Dialogue: 0,0:08:37.48,0:08:39.65,Default,,0,0,0,,Сіз не істеп жатырсыз? Бұл Шилдтің миссиясы.
Dialogue: 0,0:08:39.65,0:08:41.65,Default,,0,0,0,,Тони ше? Кек алушылардың миссиясы
Dialogue: 0,0:08:41.65,0:08:45.66,Default,,0,0,0,,Біз өз командамызды әлдеқайда тиімді етіп қайта құрып жатырмыз.
Dialogue: 0,0:08:45.66,0:08:48.81,Default,,0,0,0,,Мен бүгін таңертең өте жаман жігітті жеңдім.
Dialogue: 0,0:08:48.81,0:08:51.14,Default,,0,0,0,,Мен білемін. Мен оны жаңалықтардан көрдім.
Dialogue: 0,0:08:51.14,0:08:55.32,Default,,0,0,0,,Эй, мен сенің командаға қайтып келгеніңді қалаймын.
Dialogue: 0,0:08:55.32,0:08:57.82,Default,,0,0,0,,Кек алушылар сенің арқаңда күшті болды.
Dialogue: 0,0:08:57.82,0:09:01.49,Default,,0,0,0,,Білесің бе, Тони, біз командадан бір себеппен кеттік.
Dialogue: 0,0:09:01.49,0:09:03.96,Default,,0,0,0,,Сіз заттарды жасырып, бізге қауіп төндірдіңіз➡
Dialogue: 0,0:09:03.96,0:09:06.16,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:09:06.16,0:09:08.46,Default,,0,0,0,,Эй, жақсы ма?
Dialogue: 0,0:09:08.46,0:09:10.48,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:10.48,0:09:13.65,Default,,0,0,0,,А, бұл жаңа түтін экраны.
Dialogue: 0,0:09:13.65,0:09:15.99,Default,,0,0,0,,Жұмбақ көрінеді, солай емес пе?
Dialogue: 0,0:09:15.99,0:09:20.34,Default,,0,0,0,,Жоқ, мен 100 пайыз адал емес екенін білемін.
Dialogue: 0,0:09:20.34,0:09:22.98,Default,,0,0,0,,Хоки мен Торға сәлем айтыңыз
Dialogue: 0,0:09:22.98,0:09:25.00,Default,,0,0,0,,Егер ойыңызды өзгертсеңіз, маған хабарлаңыз.
Dialogue: 0,0:09:25.00,0:09:27.00,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:09:31.65,0:09:35.65,Default,,0,0,0,,Міне, мінекей. Тыныш ақша үшін өзгерісті сақтаңыз.
Dialogue: 0,0:09:41.13,0:09:43.30,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:09:43.30,0:09:45.30,Default,,0,0,0,,Мұнара шу шығара бастады.
Dialogue: 0,0:09:45.30,0:09:47.32,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,0:09:47.32,0:09:50.99,Default,,0,0,0,,Ууу!
Dialogue: 0,0:09:50.99,0:09:53.31,Default,,0,0,0,,Жарайды, бұл үлкен мәселе емес.
Dialogue: 0,0:09:53.31,0:09:55.34,Default,,0,0,0,,Мен Тони Старкпын
Dialogue: 0,0:09:55.34,0:09:57.64,Default,,0,0,0,,Әрі қарай не істеу керек? Сансыз идеялар бар.
Dialogue: 0,0:10:00.65,0:10:03.33,Default,,0,0,0,,Кемпинг жаңа идея ма?
Dialogue: 0,0:10:03.33,0:10:06.04,Default,,0,0,0,,Капитандар да жерде ұйықтап жатыр ма?
Dialogue: 0,0:10:06.04,0:10:08.89,Default,,0,0,0,,Сенімге ие болыңыз, бұл жерде көзге көрінбейтін нәрсе бар.
Dialogue: 0,0:10:08.89,0:10:10.89,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:13.81,0:10:15.81,Default,,0,0,0,,Әрине
Dialogue: 0,0:10:15.81,0:10:18.32,Default,,0,0,0,,Кек алушылар? Маған контейнерді беріңіз және маған көмектесіңіз!
Dialogue: 0,0:10:18.32,0:10:21.70,Default,,0,0,0,,Мақсат? Өтірік емес пе? Тони, маған бұл идея ұнамайды.
Dialogue: 0,0:10:21.70,0:10:23.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:23.72,0:10:25.99,Default,,0,0,0,,Мақсат жоспарланбаған.
Dialogue: 0,0:10:25.99,0:10:29.39,Default,,0,0,0,,Жарайды, ескірген күрес әдісі.
Dialogue: 0,0:10:31.65,0:10:36.50,Default,,0,0,0,,Ой, мен сервоны басқара алмаймын!
Dialogue: 0,0:10:36.50,0:10:38.54,Default,,0,0,0,,Мен саған біреуін беремін, Старк.
Dialogue: 0,0:10:38.54,0:10:41.15,Default,,0,0,0,,Антман, мен сені осында деп ойладым.
Dialogue: 0,0:10:41.15,0:10:43.65,Default,,0,0,0,,Сонымен, сіз Антоний тұрған жерге келдіңіз бе?
Dialogue: 0,0:10:46.99,0:10:49.39,Default,,0,0,0,,От жағудың уақыты келді!
Dialogue: 0,0:10:51.36,0:10:53.36,Default,,0,0,0,,Жаман!
Dialogue: 0,0:10:56.32,0:10:58.32,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:00.96,0:11:03.14,Default,,0,0,0,,Енді бұл жерге келме!
Dialogue: 0,0:11:03.14,0:11:05.15,Default,,0,0,0,,Қандай тамаша іс істедің!
Dialogue: 0,0:11:05.15,0:11:08.30,Default,,0,0,0,,Сондықтан мен бұл жігітті жек көремін. Көмектессем де рахметін айтпайды.
Dialogue: 0,0:11:08.30,0:11:10.97,Default,,0,0,0,,Жарайсың ба? Мен Эймды қуып жібердім.
Dialogue: 0,0:11:10.97,0:11:12.99,Default,,0,0,0,,Пим бөліктерімен бірге
Dialogue: 0,0:11:12.99,0:11:16.66,Default,,0,0,0,,Олар әлемдегі ең қауіпті заттарды алды!
Dialogue: 0,0:11:16.66,0:11:19.36,Default,,0,0,0,,Бұл Тордың кінәсі
Dialogue: 0,0:12:21.64,0:12:23.81,Default,,0,0,0,,Пим бөлшегі Эймнің қолына түсті.
Dialogue: 0,0:12:23.81,0:12:26.31,Default,,0,0,0,,Бұрын-соңды болмаған молекулалық деструкция болады.
Dialogue: 0,0:12:26.31,0:12:30.31,Default,,0,0,0,,Кеттік. Сабыр ет, Антоман, мұны маған қалдыр.
Dialogue: 0,0:12:30.31,0:12:32.98,Default,,0,0,0,,О, о...!
Dialogue: 0,0:12:32.98,0:12:34.99,Default,,0,0,0,,ｽﾀｰｸ！
Dialogue: 0,0:12:34.99,0:12:37.89,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:12:40.14,0:12:43.64,Default,,0,0,0,,Мен мұнара туралы естідім. Сіздің сауытыңыз да зақымдалды ма?
Dialogue: 0,0:12:43.64,0:12:46.66,Default,,0,0,0,,Қол ұшын созайын ба? Жоқ, мен оны жақында жөндеймін.
Dialogue: 0,0:12:46.66,0:12:49.98,Default,,0,0,0,,Маған құралдар керек, сіздің зертханаңыз осында ма?
Dialogue: 0,0:12:49.98,0:12:51.99,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:12:51.99,0:12:54.97,Default,,0,0,0,,Бұл әзіл емес деп ойлаймын.
Dialogue: 0,0:12:54.97,0:12:56.99,Default,,0,0,0,,Бұл әзіл емес
Dialogue: 0,0:12:56.99,0:13:00.16,Default,,0,0,0,,Оны көре алмау оның жоқтығын білдірмейді
Dialogue: 0,0:13:00.16,0:13:02.53,Default,,0,0,0,,Аа, не істеп жатырсың?
Dialogue: 0,0:13:02.53,0:13:05.93,Default,,0,0,0,,Жоқ, бізге пим бөлшектер берілді...! Ой, тоқтат!
Dialogue: 0,0:13:08.34,0:13:10.47,Default,,0,0,0,,Сіз шынымен де осы Аризукада тұрасыз ба?
Dialogue: 0,0:13:10.47,0:13:13.66,Default,,0,0,0,,Иә, Нью-Йоркте жалдау ақысы жоғары.
Dialogue: 0,0:13:13.66,0:13:15.96,Default,,0,0,0,,Маған жалға алудың қажеті жоқ екені рас.
Dialogue: 0,0:13:20.81,0:13:24.17,Default,,0,0,0,,Ішіндегі жабдықтар қолдан жасалған және әдемі.
Dialogue: 0,0:13:24.17,0:13:26.84,Default,,0,0,0,,Бұлай айтудың да жолы бар.
Dialogue: 0,0:13:26.84,0:13:29.26,Default,,0,0,0,,үшін миллионер емес.
Dialogue: 0,0:13:29.26,0:13:33.16,Default,,0,0,0,,Қандай көрінсе де, олардың барлығы озық технологияны пайдаланады.
Dialogue: 0,0:13:33.16,0:13:36.18,Default,,0,0,0,,Джой, Темір адамның түпнұсқалығын растаңыз.
Dialogue: 0,0:13:36.18,0:13:38.13,Default,,0,0,0,,Қалайсың, Тони?
Dialogue: 0,0:13:38.13,0:13:40.32,Default,,0,0,0,,Джаз сияқты, былайша айтқанда.
Dialogue: 0,0:13:40.32,0:13:43.99,Default,,0,0,0,,Емінің ізіне түскіңіз келе ме? Жарайды, тезірек, Джой.
Dialogue: 0,0:13:43.99,0:13:48.99,Default,,0,0,0,,Тілбекті айтты. (Қуаныш) Оны маған қалдырыңыз. Бұл торт серуені.
Dialogue: 0,0:13:48.99,0:13:53.15,Default,,0,0,0,,Эй, артта қал! Отыр! Тоқта!
Dialogue: 0,0:13:53.15,0:13:56.65,Default,,0,0,0,,Эй, сен маған ұнайсың деп ойлаймын. Бұл жағымсыз дәм.
Dialogue: 0,0:13:56.65,0:13:59.05,Default,,0,0,0,,Эй, өтінемін, бірдеңе істеші!
Dialogue: 0,0:13:59.05,0:14:03.16,Default,,0,0,0,,Құмырсқалар пайдалы, өйткені олар дене салмағынан 25 есе артық көтере алады.
Dialogue: 0,0:14:03.16,0:14:06.34,Default,,0,0,0,,Мына жігіттер? Мен сене алар емеспін
Dialogue: 0,0:14:06.34,0:14:09.64,Default,,0,0,0,,Shall we try? Сонда Тесла мен Ньютон бізге қарсылас болады.
Dialogue: 0,0:14:11.73,0:14:14.15,Default,,0,0,0,,Иә, сіз қалай ойлайсыз? Ou…!
Dialogue: 0,0:14:14.15,0:14:17.84,Default,,0,0,0,,Хаха! Егер Халк болса, мен бақытты болар едім, хахаха!
Dialogue: 0,0:14:17.84,0:14:21.19,Default,,0,0,0,,Тони схемасын жаңартқан дұрыс.
Dialogue: 0,0:14:21.19,0:14:24.24,Default,,0,0,0,,Сіз не білесіз? Егер сізде сауыт болса, оны өзіңіз жөндей аласыз.
Dialogue: 0,0:14:24.24,0:14:26.65,Default,,0,0,0,,Кешіріңіз, бастық.
Dialogue: 0,0:14:26.65,0:14:29.83,Default,,0,0,0,,Бұл нені білдіреді? Жоқ, ештеңе емес.
Dialogue: 0,0:14:29.83,0:14:32.99,Default,,0,0,0,,Джой дұрыс айтады. Сол жақ сергіткішті ауыстыру керек➡
Dialogue: 0,0:14:32.99,0:14:36.16,Default,,0,0,0,,Құрыш шамадан тыс жүктеледі. Мені кім деп ойлайсың?
Dialogue: 0,0:14:36.16,0:14:38.66,Default,,0,0,0,,Үңгірдегі темір сауыт жасаған.
Dialogue: 0,0:14:38.66,0:14:42.56,Default,,0,0,0,,Бірақ ол кезде үңгірде жалғыз Тони емес еді, солай ма?
Dialogue: 0,0:14:42.56,0:14:46.32,Default,,0,0,0,,Олай болса, маған қолдау көрсетіңіз. Эйм әлі жүріп жатқан сияқты.
Dialogue: 0,0:14:46.32,0:14:49.99,Default,,0,0,0,,Мен енді араға ілінбеймін және аспанмен ұшамын.
Dialogue: 0,0:14:49.99,0:14:52.81,Default,,0,0,0,,Егер солай болса, ешқандай проблема жоқ.
Dialogue: 0,0:14:52.81,0:14:55.64,Default,,0,0,0,,Құмырсқалармен ұшу!? Мен бұрынғы айтқанымды қайтарып аламын!
Dialogue: 0,0:14:55.64,0:14:58.35,Default,,0,0,0,,Мен ұшамын! Сондықтан жақсырақ!
Dialogue: 0,0:14:58.35,0:15:02.00,Default,,0,0,0,,Ол сізге ұнайтын сияқты, сондықтан ол сізге өзінің жақсы жақтарын көрсеткісі келеді!
Dialogue: 0,0:15:02.00,0:15:04.00,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:15:06.99,0:15:09.49,Default,,0,0,0,,Пим бөлшектерінің сигналы сол жолдан келеді.
Dialogue: 0,0:15:09.49,0:15:11.49,Default,,0,0,0,,Джой, сен оны ұстадың ба?
Dialogue: 0,0:15:11.49,0:15:16.01,Default,,0,0,0,,Бұл жылжымалы зертхана. Бортта біреу бар, басы жай ғана біреу.
Dialogue: 0,0:15:16.01,0:15:18.03,Default,,0,0,0,,ﾓｰﾄﾞｯｸ！
Dialogue: 0,0:15:18.03,0:15:20.03,Default,,0,0,0,,(Жүк көлігінің қираған дыбысы)
Dialogue: 0,0:15:25.32,0:15:27.97,Default,,0,0,0,,Modoc! Мен сенің сонда екеніңді білемін!
Dialogue: 0,0:15:27.97,0:15:30.79,Default,,0,0,0,,Шық!
Dialogue: 0,0:15:30.79,0:15:34.35,Default,,0,0,0,,(Жүк көлігінің қираған дыбысы)
Dialogue: 0,0:15:34.35,0:15:36.87,Default,,0,0,0,,Бұл Modoc емес!
Dialogue: 0,0:15:36.87,0:15:39.40,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:15:39.40,0:15:42.16,Default,,0,0,0,,Бұл сіз білмейтін Modoc!
Dialogue: 0,0:15:42.16,0:15:45.83,Default,,0,0,0,,Пим бөлшектері жақсы жұмыс істеді
Dialogue: 0,0:15:45.83,0:15:49.50,Default,,0,0,0,,Бұл жұмыс істеді ме? Сонда сіз соны мақсатыңыз және солай болды ма?
Dialogue: 0,0:15:49.50,0:15:52.87,Default,,0,0,0,,Ultron құрылғыны басқаруға және еркін қозғалуына қараңыз➡
Dialogue: 0,0:15:52.87,0:15:56.39,Default,,0,0,0,,Мен енді жасанды миға ғана сене алмаймын.
Dialogue: 0,0:15:56.39,0:16:00.49,Default,,0,0,0,,Бірақ енді уайымдама!
Dialogue: 0,0:16:00.49,0:16:06.65,Default,,0,0,0,,Өйткені Мордок физикалық билеушіге айналды!
Dialogue: 0,0:16:06.65,0:16:09.58,Default,,0,0,0,,Неліктен біз басқа Кек алушыларды атамаймыз?
Dialogue: 0,0:16:09.58,0:16:14.47,Default,,0,0,0,,Егер Халк қазір осында болса пайдалы болар еді. Басқа кек алушылар жоқ.
Dialogue: 0,0:16:14.47,0:16:17.34,Default,,0,0,0,,Не? Сіз оларды бөлініп кетті деп ойладыңыз ба?
Dialogue: 0,0:16:17.34,0:16:21.66,Default,,0,0,0,,Модок сияқты бізге де жеткілікті!
Dialogue: 0,0:16:21.66,0:16:23.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:23.66,0:16:27.36,Default,,0,0,0,,Капитанның байланыс ақпараты қандай?
Dialogue: 0,0:17:29.40,0:17:34.40,Default,,0,0,0,,Қызыл бас сүйекке сізбен күресу үшін құпия қоғам керек болды.
Dialogue: 0,0:17:38.02,0:17:41.64,Default,,0,0,0,,Бірақ енді мен өз күшіммен Кек алушыларды ойнаймын➡
Dialogue: 0,0:17:41.64,0:17:44.44,Default,,0,0,0,,Мен сені жеңетін күшке ие болдым!
Dialogue: 0,0:17:49.18,0:17:54.24,Default,,0,0,0,,Оның күші Тормен салыстыруға келеді! Хахахаха!
Dialogue: 0,0:17:54.24,0:17:56.74,Default,,0,0,0,,О, бұл шынымен қызықты бола бастады.
Dialogue: 0,0:18:03.98,0:18:07.15,Default,,0,0,0,,Абайлаңыз, Modoc компаниясының пим бөлшектерін пайдаланғаны ➡ дегенді білдіреді
Dialogue: 0,0:18:07.15,0:18:09.64,Default,,0,0,0,,Ғылыми ұстанымдардан туындаған...
Dialogue: 0,0:18:09.64,0:18:13.14,Default,,0,0,0,,Дәл қазір айтуға болатын бір ғана ғылыми қағида бар.
Dialogue: 0,0:18:13.14,0:18:15.94,Default,,0,0,0,,Үлкенірек... Ол
Dialogue: 0,0:18:20.31,0:18:22.30,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:18:22.30,0:18:24.48,Default,,0,0,0,,-ден үлкенірек бола ма?
Dialogue: 0,0:18:24.48,0:18:28.64,Default,,0,0,0,,Басқаша айтқанда, бұл күйдегі бөлшектер электр энергиясын жұтады.
Dialogue: 0,0:18:28.64,0:18:30.64,Default,,0,0,0,,Мен жақсы сөздер естідім
Dialogue: 0,0:18:30.64,0:18:33.31,Default,,0,0,0,,Жарайды, рахмет, Старк.
Dialogue: 0,0:18:33.31,0:18:37.48,Default,,0,0,0,,Мен ешқашан мұндай күшті сезінген емеспін.
Dialogue: 0,0:18:37.48,0:18:41.15,Default,,0,0,0,,Көбірек жинайық!
Dialogue: 0,0:18:41.15,0:18:45.31,Default,,0,0,0,,Ах ха ха!
Dialogue: 0,0:18:45.31,0:18:47.31,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:57.00,0:18:59.32,Default,,0,0,0,,Құрыш, ұстаңыз.
Dialogue: 0,0:18:59.32,0:19:01.32,Default,,0,0,0,,Не, жарық емес пе?
Dialogue: 0,0:19:05.98,0:19:10.65,Default,,0,0,0,,Кемел денеге ие болған Мордокқа сәжде етті.
Dialogue: 0,0:19:10.65,0:19:13.95,Default,,0,0,0,,Толық фронтальды шабуыл. Ұстамаңыз.
Dialogue: 0,0:19:21.49,0:19:24.48,Default,,0,0,0,,Егер жеті адам болса, фронтальды шабуылдың ықтималдығы азырақ болар еді➡
Dialogue: 0,0:19:24.48,0:19:26.48,Default,,0,0,0,,Енді жартысы
Dialogue: 0,0:19:30.97,0:19:32.99,Default,,0,0,0,,Жоқ, оны азайтуға болмайды.
Dialogue: 0,0:19:32.99,0:19:35.64,Default,,0,0,0,,Оның денесінің ішіндегі пим бөлшектері итермелейді.
Dialogue: 0,0:19:35.64,0:19:37.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:39.64,0:19:41.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:41.64,0:19:46.97,Default,,0,0,0,,Кек алушылар маған қол ұшын созады
Dialogue: 0,0:19:46.97,0:19:48.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:48.99,0:19:50.99,Default,,0,0,0,,Хаха!
Dialogue: 0,0:19:55.98,0:19:59.15,Default,,0,0,0,,Рахмет, Антоман. Енді не істеуіміз керек?
Dialogue: 0,0:19:59.15,0:20:01.65,Default,,0,0,0,,Сіз пим бөлшектерінің сарапшысысыз, солай ма?
Dialogue: 0,0:20:01.65,0:20:05.15,Default,,0,0,0,,Эй, сен менден стратегия туралы сұрап тұрсың ба?
Dialogue: 0,0:20:05.15,0:20:07.82,Default,,0,0,0,,Сіз бұл жігіттен оның стратегиясы туралы сұрайсыз ба?
Dialogue: 0,0:20:07.82,0:20:11.16,Default,,0,0,0,,Ми керек дедіңіз.
Dialogue: 0,0:20:11.16,0:20:15.21,Default,,0,0,0,,Көшбасшылар кейде қалай жүру керектігін білмейді.
Dialogue: 0,0:20:15.21,0:20:17.75,Default,,0,0,0,,Менің бір ойым бар. Бұл өте қауіпті.
Dialogue: 0,0:20:17.75,0:20:20.45,Default,,0,0,0,,Қауіпті болса, бұл сіздің қалағаныңыз.
Dialogue: 0,0:20:22.47,0:20:24.49,Default,,0,0,0,,Кя! Апыр-ай!
Dialogue: 0,0:20:24.49,0:20:27.47,Default,,0,0,0,,Енді қорық. Менің қалағаным сол еді.
Dialogue: 0,0:20:27.47,0:20:32.15,Default,,0,0,0,,Ойын-сауық саябағындағы қызығың бітті, қу арамза.
Dialogue: 0,0:20:32.15,0:20:34.48,Default,,0,0,0,,｜ Көлік жәндік пе?
Dialogue: 0,0:20:34.48,0:20:38.17,Default,,0,0,0,,Ха, найзағай құдайы құлады.
Dialogue: 0,0:20:38.17,0:20:42.07,Default,,0,0,0,,Бұл Тесла асыл және көптеген адал достары бар.
Dialogue: 0,0:20:42.07,0:20:44.27,Default,,0,0,0,,Жарайды, не істеймін…
Dialogue: 0,0:20:47.98,0:20:50.98,Default,,0,0,0,,О, тоқтат!
Dialogue: 0,0:20:50.98,0:20:53.38,Default,,0,0,0,,Әй, кет!
Dialogue: 0,0:20:55.89,0:20:59.14,Default,,0,0,0,,Шабуыл басталды. Сіздің кезегіңіз.
Dialogue: 0,0:20:59.14,0:21:02.14,Default,,0,0,0,,...
Dialogue: 0,0:21:02.14,0:21:04.14,Default,,0,0,0,,Сабыр етіңіз
Dialogue: 0,0:21:11.32,0:21:15.30,Default,,0,0,0,,Уау, бұл қорқынышты. Бұл ежелгі құлақ балауыз мұражайы сияқты.
Dialogue: 0,0:21:15.30,0:21:18.32,Default,,0,0,0,,Құмырсқа адам менің миыма енді ғана кіріп кетті➡
Dialogue: 0,0:21:18.32,0:21:21.64,Default,,0,0,0,,Мен мұндай миды бұрын-соңды көрген емеспін.
Dialogue: 0,0:21:21.64,0:21:24.31,Default,,0,0,0,,[Радио] (Антоман) Маңдай алатын табыңыз. Бөлшектер сонда жиналады.
Dialogue: 0,0:21:24.31,0:21:27.70,Default,,0,0,0,,[Радио] Мүмкіндігінше көп жинаңыз.
Dialogue: 0,0:21:27.70,0:21:30.40,Default,,0,0,0,,Менің өмірімдегі ең жаман күн.
Dialogue: 0,0:21:34.66,0:21:36.86,Default,,0,0,0,,Бөлшектер болды.
Dialogue: 0,0:21:41.81,0:21:45.30,Default,,0,0,0,,Vermin! Арх!
Dialogue: 0,0:21:45.30,0:21:47.30,Default,,0,0,0,,Менің тізем ашық!
Dialogue: 0,0:21:51.47,0:21:53.46,Default,,0,0,0,,[Сымсыз] (Антман) Ironman координаттарын жіберу
Dialogue: 0,0:21:53.46,0:21:55.65,Default,,0,0,0,,Нейтрондарды қолдансаңыз➡
Dialogue: 0,0:21:55.65,0:21:58.31,Default,,0,0,0,,Пим бөлшектерінің әсерін кері қайтару мүмкіндігі болуы керек.
Dialogue: 0,0:21:58.31,0:22:00.31,Default,,0,0,0,,Түсіндім, маған қалдырыңыз.
Dialogue: 0,0:22:06.72,0:22:10.49,Default,,0,0,0,,Пим бөлшектеріне сезімтал нейрондар қайда тығылады?
Dialogue: 0,0:22:10.49,0:22:13.49,Default,,0,0,0,,Found it. Енді Мордокты ашуландырайық.
Dialogue: 0,0:22:15.48,0:22:17.48,Default,,0,0,0,,...
Dialogue: 0,0:22:17.48,0:22:20.97,Default,,0,0,0,,Қазір сауытыңыз бұзылды демеңіз.
Dialogue: 0,0:22:20.97,0:22:22.97,Default,,0,0,0,,Сымдар ақылсыз
Dialogue: 0,0:22:22.97,0:22:25.01,Default,,0,0,0,,Менің айтқаным осы емес пе?
Dialogue: 0,0:22:25.01,0:22:27.71,Default,,0,0,0,,Қазір Modocты тоқтатудың жолы жоқ.
Dialogue: 0,0:22:30.65,0:22:32.67,Default,,0,0,0,,Әлі біткен жоқ
Dialogue: 0,0:22:32.67,0:22:35.67,Default,,0,0,0,,Модоктың миына соққы берудің жолы бар.
Dialogue: 0,0:22:40.97,0:22:43.33,Default,,0,0,0,,Маған Hawkeye кабелін беріңіз
Dialogue: 0,0:22:43.33,0:22:45.50,Default,,0,0,0,,Ми арқылы өтіп, құлақ арқылы шығу.
Dialogue: 0,0:22:45.50,0:22:48.90,Default,,0,0,0,,Құттықтаймыз, сіз ең оғаш команда рекордын жаңарттыңыз.
Dialogue: 0,0:22:52.13,0:22:54.13,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:22:56.16,0:22:58.32,Default,,0,0,0,,Құлақ тесігін жедім.
Dialogue: 0,0:22:58.32,0:23:00.32,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:23:03.20,0:23:06.33,Default,,0,0,0,,Керемет, Хоки. Барлық пим бөлшектерін жинады.
Dialogue: 0,0:23:06.33,0:23:08.83,Default,,0,0,0,,Кеттік. [Радио] (Hawk Eye) Темір адам әлі ішінде.
Dialogue: 0,0:23:16.14,0:23:18.98,Default,,0,0,0,,Старк, сіз шектен шыққан нәрсе ойлап тұрсыз.
Dialogue: 0,0:23:18.98,0:23:21.01,Default,,0,0,0,,Адамдар найзағайға айналса ше?
Dialogue: 0,0:23:21.01,0:23:23.63,Default,,0,0,0,,Бұл шектен шыққан десең, бұл рас.
Dialogue: 0,0:23:23.63,0:23:25.65,Default,,0,0,0,,Ара режиміне қуат қосыңыз
Dialogue: 0,0:23:25.65,0:23:27.67,Default,,0,0,0,,[Сымсыз] Hawkeye
Dialogue: 0,0:23:27.67,0:23:31.82,Default,,0,0,0,,[Радио] Сізге Мгиорнияның теңдесі жоқ дәлдігін көрсетуге рұқсат етіңіз.
Dialogue: 0,0:23:31.82,0:23:34.32,Default,,0,0,0,,ﾔｰｯ！
Dialogue: 0,0:23:39.15,0:23:41.48,Default,,0,0,0,,Гррр…
Dialogue: 0,0:23:41.48,0:23:44.48,Default,,0,0,0,,Гува, не!?
Dialogue: 0,0:23:48.07,0:23:50.66,Default,,0,0,0,,Енді бұл туралы не деуге болады? Бұл толық оралу
Dialogue: 0,0:23:50.66,0:23:52.65,Default,,0,0,0,,Старк сен данышпансың
Dialogue: 0,0:23:52.65,0:23:55.18,Default,,0,0,0,,Бірақ сіз сол жерде тұзаққа түсесіз.
Dialogue: 0,0:23:55.18,0:23:57.20,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:23:57.20,0:24:00.32,Default,,0,0,0,,Режим қысқармай тұрып, бұл жерден кетуіміз керек.
Dialogue: 0,0:24:00.32,0:24:23.06,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:23.06,0:24:25.46,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:24:25.46,0:24:28.35,Default,,0,0,0,,Ақырында, ақырында, ақырында➡
Dialogue: 0,0:24:28.35,0:24:31.48,Default,,0,0,0,,Мен нағыз күшке ие болсам да
Dialogue: 0,0:24:31.48,0:24:35.17,Default,,0,0,0,,Жоғарыда айтқанымдай, сынақ уақыттары нағыз көшбасшыларды жасайды.
Dialogue: 0,0:24:35.17,0:24:40.31,Default,,0,0,0,,Бізде мүшелер мен жабдықтар аз, бірақ жеңіс бәрібір біздікі.
Dialogue: 0,0:24:40.31,0:24:44.68,Default,,0,0,0,,Мен білемін. Бірақ сенсіз мен жетістікке жете алмас едім.
Dialogue: 0,0:24:44.68,0:24:49.77,Default,,0,0,0,,Шынымды айтсам, «Кек алушылар» ойынын ойнау маған өте қызық болды.
Dialogue: 0,0:24:49.77,0:24:54.49,Default,,0,0,0,,Олай болса, неге шынымен де қол ұстаспайсың? (Сұңқыр) А... Шынайысың ба?
Dialogue: 0,0:24:54.49,0:24:59.00,Default,,0,0,0,,Мен бақыттымын. Мен мұны жақсы көргім келеді.
Dialogue: 0,0:24:59.00,0:25:02.67,Default,,0,0,0,,Иә! Қалқанға Модок туралы айтып берейік.
Dialogue: 0,0:25:02.67,0:25:07.30,Default,,0,0,0,,Қалқан әлі біз жақта ма? Капитандар бар.
Dialogue: 0,0:25:07.30,0:25:11.16,Default,,0,0,0,,Менің бір ойым бар
Dialogue: 0,0:25:11.16,0:25:14.48,Default,,0,0,0,,[Монитор] Мен анонимді азаматпын➡
Dialogue: 0,0:25:14.48,0:25:17.16,Default,,0,0,0,,Менің саған айтар сөзім бар.
Dialogue: 0,0:25:17.16,0:25:20.55,Default,,0,0,0,,[Монитор] А, оның аты кім еді? Modoc?
Dialogue: 0,0:25:20.55,0:25:23.32,Default,,0,0,0,,[Монитор] Мен ойын-сауық саябағына байланғанмын.
Dialogue: 0,0:25:23.32,0:25:26.51,Default,,0,0,0,,Бұл сізді бұзбайды деп ойлайсыз ба?
Dialogue: 0,0:25:26.51,0:25:30.64,Default,,0,0,0,,(Артқа айналдыру дыбысы)
Dialogue: 0,0:25:30.64,0:25:33.46,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:25:33.46,0:25:36.02,Default,,0,0,0,,Бұл күлкі емес
Dialogue: 0,0:25:36.02,0:25:38.03,Default,,0,0,0,,Ультронның шабуылына ұқсайды.
Dialogue: 0,0:25:38.03,0:25:40.09,Default,,0,0,0,,Жоқ, бұл Тони Старк.
Dialogue: 0,0:25:40.09,0:25:43.66,Default,,0,0,0,,Оның командасы қайда барса да, абайсызда қиратуды жалғастыруда.
Dialogue: 0,0:25:43.66,0:25:45.68,Default,,0,0,0,,Бұл команда мұны істемейді.
Dialogue: 0,0:25:45.68,0:25:48.33,Default,,0,0,0,,Аа, Smash үшін себеп бар.
Dialogue: 0,0:25:48.33,0:25:50.81,Default,,0,0,0,,Мәселе бар деп ойласаңыз➡
Dialogue: 0,0:25:50.81,0:25:54.67,Default,,0,0,0,,Shield сізге қолдау көрсетпеді немесе сізге ешқандай жабдық бермеді.
Dialogue: 0,0:25:54.67,0:25:56.64,Default,,0,0,0,,Сонымен, біздің есімдеріміз кім?
Dialogue: 0,0:25:56.64,0:25:59.34,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл Avengers
Dialogue: 0,0:25:59.34,0:26:01.34,Default,,0,0,0,,Енді жүріңіз
Dialogue: 0,0:26:35.31,0:26:37.31,Default,,0,0,0,,<“Кек алушылар жиналуда”➡ пайда болады
Dialogue: 0,0:26:37.31,0:26:39.33,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:39.33,0:26:41.48,Default,,0,0,0,,Осы жерде жинаңыз
Dialogue: 0,0:26:41.48,0:26:44.00,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:44.00,0:26:47.39,Default,,0,0,0,,Ғалым доктор Хэнк Пим ашқан Пим бөлшектің күшімен➡
Dialogue: 0,0:26:47.39,0:26:51.12,Default,,0,0,0,,Скотт Лэнг денесін құмырсқадай кішірейтеді
Dialogue: 0,0:26:51.12,0:26:53.16,Default,,0,0,0,,Бұл өлшемді пайдаланыңыз➡
Dialogue: 0,0:26:53.16,0:26:55.49,Default,,0,0,0,,Сіз жауға тосын шабуыл жасай аласыз.
Dialogue: 0,0:26:55.49,0:26:57.51,Default,,0,0,0,,Сонымен қатар, шлемді пайдалану➡
Dialogue: 0,0:26:57.51,0:27:00.41,Default,,0,0,0,,Сондай-ақ телепатия> арқылы құмырсқалармен сөйлесуге және оларды басқаруға болады
Dialogue: 0,0:27:01.91,0:27:07.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
