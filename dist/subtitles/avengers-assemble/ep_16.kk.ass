Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.70,0:00:41.30,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.05,0:00:47.07,Default,,0,0,0,,<Кек алушылар, яғни➡
Dialogue: 0,0:00:47.07,0:00:49.09,Default,,0,0,0,,Супер қаһармандар жиналды➡
Dialogue: 0,0:00:49.09,0:00:51.01,Default,,0,0,0,,Ең күшті батырлар командасы
Dialogue: 0,0:00:51.01,0:00:53.01,Default,,0,0,0,,Өзіңіздің трансценденттік күшіңізді жинаңыз➡
Dialogue: 0,0:00:53.01,0:00:56.35,Default,,0,0,0,,Жер бетіндегі тыныштықты қорғаңыз!
Dialogue: 0,0:00:56.35,0:00:58.50,Default,,0,0,0,,ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:58.50,0:01:01.00,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.00,0:01:03.01,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.01,0:01:05.01,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.01,0:01:07.01,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.01,0:01:11.55,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.55,0:01:14.57,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.57,0:01:16.60,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:16.60,0:01:18.50,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:18.50,0:01:20.50,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:50.74,0:01:54.36,Default,,0,0,0,,Бүркіт 1-ден Айпатчқа дейін. Сәтті ену.
Dialogue: 0,0:01:54.36,0:01:56.99,Default,,0,0,0,,10 күзетші нысанаға. 6 камера
Dialogue: 0,0:01:56.99,0:01:59.35,Default,,0,0,0,,3 бақылау нүктесі бар
Dialogue: 0,0:01:59.35,0:02:02.68,Default,,0,0,0,,[TEL] (Қара жесір) Гидра негізі үшін қауіпсіздік әлсіз.
Dialogue: 0,0:02:02.68,0:02:05.28,Default,,0,0,0,,Камераны кесіңіз
Dialogue: 0,0:02:08.67,0:02:11.97,Default,,0,0,0,,Уф! Тексеру нүктесі 1 таза
Dialogue: 0,0:02:14.51,0:02:16.86,Default,,0,0,0,,Басқа кек алушылар болмаса, оңайырақ болар еді.
Dialogue: 0,0:02:16.86,0:02:19.68,Default,,0,0,0,,Тони сияқты құпия адам менімен бірге →
Dialogue: 0,0:02:19.68,0:02:22.04,Default,,0,0,0,,Жақсы жүретін нәрселердің өзі сәтсіздікке ұшырайды.
Dialogue: 0,0:02:22.04,0:02:25.74,Default,,0,0,0,,Концентрат. Бұл ескі командамен бәсекелесу миссиясы емес.
Dialogue: 0,0:02:27.67,0:02:29.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:31.69,0:02:34.35,Default,,0,0,0,,Иә? (Қара/Жесір) 2-тексеру нүктесі Таза
Dialogue: 0,0:02:34.35,0:02:36.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:41.77,0:02:44.27,Default,,0,0,0,,ﾁｪｯｸﾎﾟｲﾝﾄ３ ｸﾘｱ
Dialogue: 0,0:02:50.01,0:02:52.70,Default,,0,0,0,,Қаһар. Ақпарат қате болды.
Dialogue: 0,0:02:52.70,0:02:55.70,Default,,0,0,0,,Нысананың орнына бір қорғаныс агенті табылды
Dialogue: 0,0:02:55.70,0:02:58.71,Default,,0,0,0,,[TEL] (ашу) Ақпарат дұрыс. Агент мақсат болып табылады.
Dialogue: 0,0:02:58.71,0:03:01.02,Default,,0,0,0,,Миссия маңызды деректерді алу...
Dialogue: 0,0:03:01.02,0:03:03.04,Default,,0,0,0,,[ТЕЛ] Дұрыс, бұл оның миы.
Dialogue: 0,0:03:03.04,0:03:05.34,Default,,0,0,0,,[ТЕЛ] Гидра сізді тапқанша қашып кетіңіз.
Dialogue: 0,0:03:13.37,0:03:15.77,Default,,0,0,0,,Ашу Мәселе орын алды.
Dialogue: 0,0:04:43.69,0:04:46.06,Default,,0,0,0,,[ТЕЛ] Гидраның шабуылына ұшырады
Dialogue: 0,0:04:46.06,0:04:49.12,Default,,0,0,0,,Күтіңіз. Мен сені қазір жаңа қарулармен қолдаймын.
Dialogue: 0,0:04:49.12,0:04:51.03,Default,,0,0,0,,Gunmex-ті атқылаңыз
Dialogue: 0,0:04:51.03,0:04:53.03,Default,,0,0,0,,[ТЕЛ] Сіз бомба тастамақсыз ба!?
Dialogue: 0,0:04:55.69,0:04:58.07,Default,,0,0,0,,[TEL] Барлығы сақ болыңыз!
Dialogue: 0,0:04:58.07,0:05:01.09,Default,,0,0,0,,[TEL] (Қаһарлы) Бұл бомбаға алаңдамаңыз.
Dialogue: 0,0:05:01.09,0:05:03.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:05.01,0:05:07.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:12.41,0:05:14.81,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:05:17.68,0:05:19.68,Default,,0,0,0,,Хун
Dialogue: 0,0:05:21.66,0:05:23.68,Default,,0,0,0,,Халк бомба ма?
Dialogue: 0,0:05:23.68,0:05:26.09,Default,,0,0,0,,ｶﾞﾝﾏｴｯｸｽｽﾏｯｼｭ！
Dialogue: 0,0:05:26.09,0:05:28.69,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,0:05:28.69,0:05:31.01,Default,,0,0,0,,Иә! Хмф!
Dialogue: 0,0:05:31.01,0:05:33.36,Default,,0,0,0,,Ха! Ха!!
Dialogue: 0,0:05:33.36,0:05:35.76,Default,,0,0,0,,Хмф! Алақай!
Dialogue: 0,0:05:38.66,0:05:42.16,Default,,0,0,0,,Хехе, мен бомбамын.
Dialogue: 0,0:05:46.06,0:05:49.68,Default,,0,0,0,,Роботтар бірінен соң бірі келеді. Олар шығару операциялары бойынша нұсқаулар береді.
Dialogue: 0,0:05:49.68,0:05:52.66,Default,,0,0,0,,Стратегия жоқ. Шегіну.
Dialogue: 0,0:05:52.66,0:05:54.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:01.02,0:06:03.36,Default,,0,0,0,,Бұл жаман емес. Ганмаекс
Dialogue: 0,0:06:03.36,0:06:05.36,Default,,0,0,0,,Хун
Dialogue: 0,0:06:08.41,0:06:11.70,Default,,0,0,0,,Сіздің жойқын күшіңіз 500 тонна, солай ма?
Dialogue: 0,0:06:11.70,0:06:13.68,Default,,0,0,0,,Іске қосу шегі де маңызды емес.
Dialogue: 0,0:06:13.68,0:06:15.70,Default,,0,0,0,,Қалағаныңызша қайта пайдалануға болады
Dialogue: 0,0:06:15.70,0:06:18.05,Default,,0,0,0,,Сіздің мәніңіз 5 фотонды цистернаға тең.
Dialogue: 0,0:06:18.05,0:06:20.07,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:06:20.07,0:06:22.11,Default,,0,0,0,,Халк өте танымал. Мен таң қалдым.
Dialogue: 0,0:06:22.11,0:06:25.03,Default,,0,0,0,,Бұл Hawkeye-мен тұздалған тұздықтар үшін бәсекелескеннен жақсы.
Dialogue: 0,0:06:25.03,0:06:27.05,Default,,0,0,0,,А... Әй, қайда қарап тұрсың?
Dialogue: 0,0:06:27.05,0:06:30.68,Default,,0,0,0,,Ах...Сұңқар! Мен сенбедім бұл сен екенсің. Мен шынымен кешірім сұраймын.
Dialogue: 0,0:06:30.68,0:06:32.69,Default,,0,0,0,,Бір-біріңді білесіңдер ме?
Dialogue: 0,0:06:32.69,0:06:35.69,Default,,0,0,0,,Жоқ, бірақ Сэм Уилсон туралы бәрі біледі.
Dialogue: 0,0:06:35.69,0:06:39.69,Default,,0,0,0,,Кек алушыға айналған стажер. Аа, таныс болғаным үшін кешіріңіз.
Dialogue: 0,0:06:39.69,0:06:42.68,Default,,0,0,0,,Уау...емдеу мүлдем басқаша.
Dialogue: 0,0:06:42.68,0:06:44.68,Default,,0,0,0,,Мен оны жек көрмеймін, бірақ
Dialogue: 0,0:06:48.33,0:06:51.50,Default,,0,0,0,,Жақсы жұмыс. Мақсаты да қалпына келеді.
Dialogue: 0,0:06:51.50,0:06:53.52,Default,,0,0,0,,Маған агент деп қоңырау шалыңыз.
Dialogue: 0,0:06:53.52,0:06:57.38,Default,,0,0,0,,Gunmex жобасымен сіз де келісетініңізге сенімдімін, солай ма?
Dialogue: 0,0:06:57.38,0:07:01.03,Default,,0,0,0,,Халктың талқандаудан басқа көптеген таланттары бар.
Dialogue: 0,0:07:01.03,0:07:05.67,Default,,0,0,0,,Сәлем, Гунмекс. Сіз қалқан нұсқаулығына қол қоя аласыз ба?
Dialogue: 0,0:07:05.67,0:07:08.65,Default,,0,0,0,,Жарайды, бірақ сізде үлкен қалам бар ма?
Dialogue: 0,0:07:08.65,0:07:12.07,Default,,0,0,0,,Сіздің командаңыз бұл жерде жақсы таныс сияқты.
Dialogue: 0,0:07:12.07,0:07:15.18,Default,,0,0,0,,Кек алушыларға дұрыс жүйе қажет болды.
Dialogue: 0,0:07:15.18,0:07:19.35,Default,,0,0,0,,Бірақ Старктың еркіндігі сонша, ол бұйрық тізбегін елемеді.
Dialogue: 0,0:07:19.35,0:07:22.35,Default,,0,0,0,,Қалқан командалар тізбегі бойынша жүреді
Dialogue: 0,0:07:22.35,0:07:26.02,Default,,0,0,0,,Сіз өз миссияңызды орындайсыз, мен үлкен суретті көріп отырмын.
Dialogue: 0,0:07:26.02,0:07:29.01,Default,,0,0,0,,Топты жинаңыз. 20 минуттан кейін жиналыс болады.
Dialogue: 0,0:07:29.01,0:07:31.01,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:34.48,0:07:37.68,Default,,0,0,0,,3 күн бұрын мен Hydra-дан қуат көзін ұрлап алдым.
Dialogue: 0,0:07:37.68,0:07:41.35,Default,,0,0,0,,Мәліметтер өте құпия, бірақ бір қала бір сәтте жойылуы мүмкін →
Dialogue: 0,0:07:41.35,0:07:46.74,Default,,0,0,0,,Бұл қорқынышты зат. Алайда оны қысқы күзетші тасымалдау кезінде ұрлап кеткен.
Dialogue: 0,0:07:46.74,0:07:49.74,Default,,0,0,0,,Ресейдің Орталық қолбасшылығы тобында... (тамағын тазартады)
Dialogue: 0,0:07:51.71,0:07:53.70,Default,,0,0,0,,Кешіріңіз. Әдеттен тыс.
Dialogue: 0,0:07:53.70,0:07:56.67,Default,,0,0,0,,Олар қуат көзін бірден пайдаланады.
Dialogue: 0,0:07:56.67,0:07:58.69,Default,,0,0,0,,Неліктен оны әлі пайдаланбадың?
Dialogue: 0,0:07:58.69,0:08:01.19,Default,,0,0,0,,Контейнерді ашу үшін электронды кілт қажет.
Dialogue: 0,0:08:01.19,0:08:04.18,Default,,0,0,0,,Ол Гидраның базасында болды, бірақ оны Crimson Dinamo ұрлап кетті.
Dialogue: 0,0:08:04.18,0:08:07.20,Default,,0,0,0,,Олар оны қазірге дейін Қысқы күзетшілер базасына әкелу керек еді.
Dialogue: 0,0:08:07.20,0:08:09.22,Default,,0,0,0,,Орналасқан жері белгісіз
Dialogue: 0,0:08:09.22,0:08:14.02,Default,,0,0,0,,Сіздің міндетіңіз Динамоға ілесіп, Қысқы гвардияның үй базасын табу➡
Dialogue: 0,0:08:14.02,0:08:16.49,Default,,0,0,0,,Қуат көзінің орнын анықтау
Dialogue: 0,0:08:16.49,0:08:18.89,Default,,0,0,0,,Бұл жолы мен Халкты өзіммен бірге алып кетемін.
Dialogue: 0,0:08:18.89,0:08:21.43,Default,,0,0,0,,Көмекші персонал ретінде емес, команда мүшесі ретінде
Dialogue: 0,0:08:21.43,0:08:26.18,Default,,0,0,0,,Соны орындаңыз. Кілтті қуып келе жатқандар да бар.
Dialogue: 0,0:08:26.18,0:08:29.02,Default,,0,0,0,,Капитан Командалар тізбегі де маңызды➡
Dialogue: 0,0:08:29.02,0:08:31.67,Default,,0,0,0,,Фьюри бізге қосымша ақпарат бергені дұрыс емес пе?
Dialogue: 0,0:08:31.67,0:08:34.19,Default,,0,0,0,,Біз қуат көздері туралы көбірек білуіміз керек
Dialogue: 0,0:08:34.19,0:08:36.63,Default,,0,0,0,,Сіз ең төменгі мәнді естіген шығарсыз.
Dialogue: 0,0:08:36.63,0:08:40.33,Default,,0,0,0,,Бұл Кек алушылардың әдісінен өзгеше, бірақ Фьюридің өз идеялары бар.
Dialogue: 0,0:08:40.33,0:08:42.35,Default,,0,0,0,,Сенейік
Dialogue: 0,0:08:42.35,0:08:45.35,Default,,0,0,0,,Маған қалқан ұнайды. Тамақ бар, ал Hawkeye жоқ.
Dialogue: 0,0:08:45.35,0:08:47.37,Default,,0,0,0,,Сөйлесу Кешіріңіз, бірақ➡
Dialogue: 0,0:08:47.37,0:08:49.69,Default,,0,0,0,,Crimson Dinamo соңғы рет көрген жерге➡
Dialogue: 0,0:08:49.69,0:08:51.79,Default,,0,0,0,,Жақында келеді. Бейне сұрау
Dialogue: 0,0:08:53.84,0:08:55.86,Default,,0,0,0,,Сіз әлі осындасыз ба?
Dialogue: 0,0:08:55.86,0:08:59.02,Default,,0,0,0,,Басқа да қуғыншылар болды. Үлкейту.
Dialogue: 0,0:08:59.02,0:09:01.02,Default,,0,0,0,,Салда, есіңде ме?
Dialogue: 0,0:09:01.02,0:09:03.72,Default,,0,0,0,,А, сіз Squadron Supreme мүшесісіз бе?
Dialogue: 0,0:09:09.83,0:09:12.01,Default,,0,0,0,,Ха~ Сәлем!
Dialogue: 0,0:09:12.01,0:09:14.01,Default,,0,0,0,,Қысқы күзет —➡
Dialogue: 0,0:09:14.01,0:09:16.35,Default,,0,0,0,,Дұрыс қолдануға болмайтын нәрсені алуға тырысу
Dialogue: 0,0:09:16.35,0:09:18.87,Default,,0,0,0,,Кілтті ақырын беріңіз!
Dialogue: 0,0:09:18.87,0:09:21.52,Default,,0,0,0,,Әйтпесе өкінесіз!
Dialogue: 0,0:09:21.52,0:09:26.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:26.84,0:09:28.86,Default,,0,0,0,,Иә! (Динамо) Уау!
Dialogue: 0,0:09:28.86,0:09:35.26,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:39.36,0:09:42.39,Default,,0,0,0,,Тоқылдақ қасқырды ешқашан жеңе алмайды.
Dialogue: 0,0:09:42.39,0:09:44.79,Default,,0,0,0,,Мен хайуан емеспін! Апыр-ай!
Dialogue: 0,0:09:57.59,0:10:00.18,Default,,0,0,0,,Gunmex ұшыруға дайын.
Dialogue: 0,0:10:00.18,0:10:03.03,Default,,0,0,0,,Әлі ерте. Динамоны жүзейік.
Dialogue: 0,0:10:03.03,0:10:05.88,Default,,0,0,0,,Кемені жасырын күйге қойып, оның соңынан еріңіз
Dialogue: 0,0:10:05.88,0:10:09.02,Default,,0,0,0,,Күте тұрыңыз, біз енді зұлымдарды жоймаймыз дейсіз бе?
Dialogue: 0,0:10:09.02,0:10:11.22,Default,,0,0,0,,Істі орындау тәсілін өзгертіңіз
Dialogue: 0,0:10:13.84,0:10:16.34,Default,,0,0,0,,Сәлем! Апыр-ай!
Dialogue: 0,0:10:20.85,0:10:25.84,Default,,0,0,0,,Енді, Динамо кетпей тұрып, Кек алушылар жиналды!
Dialogue: 0,0:10:25.84,0:10:27.84,Default,,0,0,0,,Халк, сен не істеп жатырсың?
Dialogue: 0,0:10:27.84,0:10:30.67,Default,,0,0,0,,Мен әрқашан осы уақытта Торға соқтым.
Dialogue: 0,0:10:30.67,0:10:32.84,Default,,0,0,0,,Бұл не? Амал жоқ...
Dialogue: 0,0:10:32.84,0:10:35.01,Default,,0,0,0,,Ах!!
Dialogue: 0,0:10:35.01,0:10:37.83,Default,,0,0,0,,Күрсін... бұл аз, иә!
Dialogue: 0,0:10:37.83,0:10:40.18,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ？
Dialogue: 0,0:10:40.18,0:10:43.69,Default,,0,0,0,,Иә! Бұл қарызыңызды өтеуге жақсы мүмкіндік!
Dialogue: 0,0:10:43.69,0:10:45.69,Default,,0,0,0,,Ха! Апыр-ай!
Dialogue: 0,0:11:47.68,0:11:51.35,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:11:51.35,0:11:53.75,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:11:58.74,0:12:01.84,Default,,0,0,0,,Өрт, біз Зарданы бұрышқа бұрамыз.
Dialogue: 0,0:12:07.37,0:12:09.52,Default,,0,0,0,,ｲｯﾀ…
Dialogue: 0,0:12:09.52,0:12:13.44,Default,,0,0,0,,Бұл менің жарақат алған қолыммен бірінші рет соғысуым. Рахмет, Халк.
Dialogue: 0,0:12:13.44,0:12:16.18,Default,,0,0,0,,Егер солай болса, мен саған күлемін. Ол қызықсыз жігіт.
Dialogue: 0,0:12:16.18,0:12:19.01,Default,,0,0,0,,Әй, қолыңды сындырып ала жаздағаның керемет.
Dialogue: 0,0:12:19.01,0:12:21.18,Default,,0,0,0,,Беріл, жеңу мүмкіндігі жоқ.
Dialogue: 0,0:12:21.18,0:12:23.59,Default,,0,0,0,,Кек алушылар, үйрен!
Dialogue: 0,0:12:23.59,0:12:26.39,Default,,0,0,0,,Шегінгендер шайқаста жеңіске жетуі керек!
Dialogue: 0,0:12:32.01,0:12:34.01,Default,,0,0,0,,Unihome өзгерген сияқты➡
Dialogue: 0,0:12:34.01,0:12:37.68,Default,,0,0,0,,Сіздің әлсіз жақтарыңызды түсіну бұрынғыдай оңай.
Dialogue: 0,0:12:37.68,0:12:41.35,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:12:41.35,0:12:44.72,Default,,0,0,0,,[Радио] (Қаһарлы) Роджерс Чейз Динамосы, қосымша зақымдарды елемеңіз.
Dialogue: 0,0:12:44.72,0:12:46.84,Default,,0,0,0,,Қолдау бірнеше минут ішінде келеді
Dialogue: 0,0:12:46.84,0:12:49.01,Default,,0,0,0,,Азаматтардың өміріне басымдық берілуі керек
Dialogue: 0,0:12:49.01,0:12:51.53,Default,,0,0,0,,[Сымсыз] (Қаһар) Егер біз Динамоны көрмей қалсақ, құрбандар одан да артады.
Dialogue: 0,0:12:51.53,0:12:53.68,Default,,0,0,0,,Динамо артта қалды
Dialogue: 0,0:12:53.68,0:12:56.02,Default,,0,0,0,,Бұл абсолютті мойынсұнушылықтың соңы ма?
Dialogue: 0,0:12:56.02,0:12:58.02,Default,,0,0,0,,♬~
Dialogue: 0,0:13:01.09,0:13:04.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:04.18,0:13:06.86,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:13:06.86,0:13:09.35,Default,,0,0,0,,Уау... Уау! Жақсы!
Dialogue: 0,0:13:09.35,0:13:11.35,Default,,0,0,0,,Жесір мына жолмен!
Dialogue: 0,0:13:16.71,0:13:18.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:22.36,0:13:24.36,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:13:31.77,0:13:33.77,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:13:38.19,0:13:41.01,Default,,0,0,0,,Уф... Lossl белгісі...
Dialogue: 0,0:13:41.01,0:13:44.05,Default,,0,0,0,,Қош келдіңіз. Бұл Кек алушылардың міндеті адамдарға көмектесу.
Dialogue: 0,0:13:44.05,0:13:46.59,Default,,0,0,0,,Өкінішке орай ол құсамын деді.
Dialogue: 0,0:13:46.59,0:13:49.67,Default,,0,0,0,,[Радио] (Қаһарлы) Роджерс Менің бұйрықтарыма бағынбау дегенді қалай түсінесіңдер?
Dialogue: 0,0:13:49.67,0:13:51.67,Default,,0,0,0,,[Радио] Сізге бағынбағаны үшін айып тағылады.
Dialogue: 0,0:13:51.67,0:13:54.84,Default,,0,0,0,,Бұйрық болса да, бейбіт тұрғындарды құрбандыққа шалуға болмайды.
Dialogue: 0,0:13:54.84,0:13:58.85,Default,,0,0,0,,Динамоны жоғалту миллиондаған адамның өмірін қиады.
Dialogue: 0,0:13:58.85,0:14:02.87,Default,,0,0,0,,Уайымдамаңыз, динамо өзенге құлап кетпес бұрын оған бақылау құралын орнаттық.
Dialogue: 0,0:14:02.87,0:14:05.19,Default,,0,0,0,,[Радио] (Қаһарлы) Араларыңдағы біреудің мақсаты есінде ме?
Dialogue: 0,0:14:05.19,0:14:09.69,Default,,0,0,0,,Қысқы күзеттің ашылуын басты мақсат етіңіз, қалғанының бәрі екінші орында.
Dialogue: 0,0:14:09.69,0:14:12.34,Default,,0,0,0,,[Радио] (Қаһар) Түсінді ме? Мен бұйрықты естідім
Dialogue: 0,0:14:12.34,0:14:14.35,Default,,0,0,0,,Топ үшін ең жақсысын жасаңыз
Dialogue: 0,0:14:14.35,0:14:16.35,Default,,0,0,0,,Мен сенің соңынан еремін
Dialogue: 0,0:14:18.72,0:14:22.02,Default,,0,0,0,,Фьюридің Тониден еш айырмашылығы жоқ, солай ойлайсыз ба?
Dialogue: 0,0:14:22.02,0:14:24.17,Default,,0,0,0,,Динамоның қозғалысы тоқтады.
Dialogue: 0,0:14:24.17,0:14:26.19,Default,,0,0,0,,Бұл қысқы күзетшінің үйі ме?
Dialogue: 0,0:14:26.19,0:14:28.49,Default,,0,0,0,,Қауіпсіз жерге қоныңыз және жаяу жақындаңыз
Dialogue: 0,0:14:31.35,0:14:36.85,Default,,0,0,0,,Келесі жолы Жазғы күзетшінің соңынан қуайық. Ха~
Dialogue: 0,0:14:36.85,0:14:39.02,Default,,0,0,0,,Уау... цукоми жоқ па?
Dialogue: 0,0:14:39.02,0:14:41.36,Default,,0,0,0,,Құрылғы жақын жерде.
Dialogue: 0,0:14:41.36,0:14:43.36,Default,,0,0,0,,Маған аса жақындамау бұйырылды.
Dialogue: 0,0:14:43.36,0:14:45.39,Default,,0,0,0,,Мақсаты қуат көзін табу.
Dialogue: 0,0:14:45.39,0:14:47.91,Default,,0,0,0,,Мен оны өз көзіммен көруім керек
Dialogue: 0,0:14:47.91,0:14:51.18,Default,,0,0,0,,(электрондық дыбыс)
Dialogue: 0,0:14:51.18,0:14:53.85,Default,,0,0,0,,Бұл бақылау құрылғысы. (Сұңқар) Динамо оны лақтырып жіберді.
Dialogue: 0,0:14:53.85,0:14:55.84,Default,,0,0,0,,Мен енді қуып жете алмаймын деп ойлаймын.
Dialogue: 0,0:14:55.84,0:14:57.84,Default,,0,0,0,,Бірақ ол қарға көмілген жоқ.
Dialogue: 0,0:14:57.84,0:14:59.86,Default,,0,0,0,,Мынадай сөз бар
Dialogue: 0,0:14:59.86,0:15:01.86,Default,,0,0,0,,Қотырды жинау оңай.
Dialogue: 0,0:15:14.92,0:15:17.92,Default,,0,0,0,,Мынадай сөз бар. Hulk Smash!
Dialogue: 0,0:15:30.19,0:15:34.19,Default,,0,0,0,,Өткенде тоңып қалып, сауығып кеттім. Мұны есте сақтаңыз.
Dialogue: 0,0:15:36.76,0:15:39.56,Default,,0,0,0,,Бірақ менің жағдайым жақсырақ.
Dialogue: 0,0:15:43.02,0:15:45.32,Default,,0,0,0,,Бірақ біз сан жағынан көппіз.
Dialogue: 0,0:15:57.02,0:15:59.69,Default,,0,0,0,,Оны жіберіңіз
Dialogue: 0,0:15:59.69,0:16:02.86,Default,,0,0,0,,Немесе мен бұны құртамын.
Dialogue: 0,0:16:02.86,0:16:06.36,Default,,0,0,0,,Металл костюм киген кезде қалта ұрыларынан сақ болу керек.
Dialogue: 0,0:16:06.36,0:16:08.51,Default,,0,0,0,,Сұңқарды босатқанда кілтті беріңіз.
Dialogue: 0,0:16:08.51,0:16:10.53,Default,,0,0,0,,Мен мәмілелер жасамаймын
Dialogue: 0,0:16:10.53,0:16:12.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:14.52,0:16:16.72,Default,,0,0,0,,Менің шын атым Джеймс Рэтли
Dialogue: 0,0:17:18.78,0:17:22.02,Default,,0,0,0,,Қызыл күзетші. Біреу жақындап келеді.
Dialogue: 0,0:17:22.02,0:17:25.72,Default,,0,0,0,,Тағы да, Қара жұлдыз. (Қара жұлдыз) Бұл тым үлкен.
Dialogue: 0,0:17:29.17,0:17:32.69,Default,,0,0,0,,ｸﾘﾑｿﾞﾝ･ﾀﾞｲﾅﾓ
Dialogue: 0,0:17:32.69,0:17:35.19,Default,,0,0,0,,Сізге шабуыл жасалғанын естідім, бірақ жақсысыз ба?
Dialogue: 0,0:17:38.35,0:17:40.34,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ
Dialogue: 0,0:17:40.34,0:17:42.85,Default,,0,0,0,,Біз бұл жерде ұтыла алмаймыз!
Dialogue: 0,0:17:42.85,0:17:44.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:44.84,0:17:47.86,Default,,0,0,0,,Динамо қалқанынан табылса
Dialogue: 0,0:17:47.86,0:17:50.35,Default,,0,0,0,,Бұл тапанша. Капитан Америка тірі.
Dialogue: 0,0:17:50.35,0:17:52.38,Default,,0,0,0,,Жаңа ғана есінен танып қалды.
Dialogue: 0,0:17:52.38,0:17:54.40,Default,,0,0,0,,Сонда Халк қайда?
Dialogue: 0,0:17:54.40,0:17:56.40,Default,,0,0,0,,Қар көшкіні кезінде
Dialogue: 0,0:18:02.19,0:18:05.18,Default,,0,0,0,,Сіз бұл мәселені Орталық қолбасшылыққа хабарлауыңыз керек.
Dialogue: 0,0:18:05.18,0:18:07.20,Default,,0,0,0,,Тоқтаймыз. Осы жерде болу➡
Dialogue: 0,0:18:07.20,0:18:11.68,Default,,0,0,0,,Егер олар білсе, сізді алаңдатады. Маған кілтті беріңіз, жолдас.
Dialogue: 0,0:18:11.68,0:18:14.37,Default,,0,0,0,,Мен оны қолданамын. Мен түсінемін.
Dialogue: 0,0:18:14.37,0:18:17.74,Default,,0,0,0,,Достық пен парыздың айырмашылығын сақтағыңыз келе ме?
Dialogue: 0,0:18:17.74,0:18:20.84,Default,,0,0,0,,Сіз кілтті алдыңыз, жарай ма?
Dialogue: 0,0:18:27.52,0:18:31.44,Default,,0,0,0,,Келесі жолы тапаншамен атқың келсе, мені тоқтат.
Dialogue: 0,0:18:31.44,0:18:33.51,Default,,0,0,0,,Операция сәтті өткеніне көңілім көтерілді.
Dialogue: 0,0:18:33.51,0:18:37.18,Default,,0,0,0,,Орыс адам тауып алғанын ойласам, мен орысшамын.
Dialogue: 0,0:18:37.18,0:18:39.21,Default,,0,0,0,,Сіз қалай ойлайсыз? иә?
Dialogue: 0,0:18:39.21,0:18:43.31,Default,,0,0,0,,Мен Хокидің әзілін сағына бастадым. Бұл қорқынышты.
Dialogue: 0,0:18:45.35,0:18:47.35,Default,,0,0,0,,Бірақ ол ұл.
Dialogue: 0,0:18:47.35,0:18:49.87,Default,,0,0,0,,Мен сіздің жолдастарыңыздың алдындағы парызыңызды өтеуге ұмтылуыңызды түсінемін, бірақ➡
Dialogue: 0,0:18:49.87,0:18:51.86,Default,,0,0,0,,Шыдамсыз болмаңыз
Dialogue: 0,0:18:51.86,0:18:53.88,Default,,0,0,0,,Сіз бұл жолдастарыңызға арналған деп айттыңыз ба?
Dialogue: 0,0:18:53.88,0:18:56.21,Default,,0,0,0,,Фьюридің жасыратын нәрселері көп сияқты.
Dialogue: 0,0:18:56.21,0:18:59.21,Default,,0,0,0,,Start unzipping. Артур Майор
Dialogue: 0,0:19:02.62,0:19:04.50,Default,,0,0,0,,Бұл ақылды идея болды.
Dialogue: 0,0:19:04.50,0:19:08.51,Default,,0,0,0,,Қоршау ыдысын қараусыз қалған реакторға жасыру?
Dialogue: 0,0:19:08.51,0:19:10.68,Default,,0,0,0,,Мүлдем. Residual radiation ➡
Dialogue: 0,0:19:10.68,0:19:12.84,Default,,0,0,0,,Энергия іздерін жабу➡
Dialogue: 0,0:19:12.84,0:19:16.18,Default,,0,0,0,,Бұл туралы тіпті орталық қолбасшылықтың өзі де білмеді.
Dialogue: 0,0:19:16.18,0:19:18.20,Default,,0,0,0,,Фьюри дұрыс емес
Dialogue: 0,0:19:18.20,0:19:20.85,Default,,0,0,0,,Бір емес, он қала жойылады.
Dialogue: 0,0:19:20.85,0:19:23.77,Default,,0,0,0,,Жарайды, қуат көзін растадым. Бұл туралы Shield-ке хабарлаңыз...
Dialogue: 0,0:19:23.77,0:19:25.69,Default,,0,0,0,,(Ескерту)
Dialogue: 0,0:19:25.69,0:19:27.68,Default,,0,0,0,,Қалқанды қуғыншы келді ме?
Dialogue: 0,0:19:27.68,0:19:29.98,Default,,0,0,0,,Central command?
Dialogue: 0,0:19:32.18,0:19:35.67,Default,,0,0,0,,Қысқы күзет Жау басып кірді.
Dialogue: 0,0:19:35.67,0:19:38.02,Default,,0,0,0,,Иван? Бірақ Crimson Dinamo...
Dialogue: 0,0:19:38.02,0:19:40.52,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:19:42.67,0:19:45.03,Default,,0,0,0,,Бұл Халк!
Dialogue: 0,0:19:45.03,0:19:47.73,Default,,0,0,0,,Мен S.I.E.L.D. компаниясының жасырын агентімін.
Dialogue: 0,0:19:51.10,0:19:53.10,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:20:01.74,0:20:04.04,Default,,0,0,0,,Бұл қуат көзі Shield компаниясына тиесілі!
Dialogue: 0,0:20:07.00,0:20:10.69,Default,,0,0,0,,Ортаға жиналыңдар!
Dialogue: 0,0:20:10.69,0:20:13.84,Default,,0,0,0,,Key! Электрондық кілтті ұрлаңыз!
Dialogue: 0,0:20:13.84,0:20:16.74,Default,,0,0,0,,Халк Бұл сіздің артыңызда!
Dialogue: 0,0:20:23.35,0:20:26.05,Default,,0,0,0,,Мен жасадым! Осындай сөз болды
Dialogue: 0,0:20:28.35,0:20:30.35,Default,,0,0,0,,Мен одан шаршадым.
Dialogue: 0,0:20:47.69,0:20:50.68,Default,,0,0,0,,Сіз қалқаныңызды дұрыс емес адамға лақтырып жатырсыз.
Dialogue: 0,0:20:50.68,0:20:53.83,Default,,0,0,0,,Ғимарат қирап жатыр!
Dialogue: 0,0:20:53.83,0:20:57.83,Default,,0,0,0,,Сіз тым көп ұрдыңыз ба? Солай сияқты
Dialogue: 0,0:21:01.69,0:21:05.69,Default,,0,0,0,,Кек алушылар ауылды қорғайды. Қысқы күзет қашып кетеді.
Dialogue: 0,0:21:05.69,0:21:07.66,Default,,0,0,0,,Егер бұл Фьюри болса, ол ауылды тастап кетер еді➡
Dialogue: 0,0:21:07.66,0:21:09.66,Default,,0,0,0,,Кек алушылар басқа!
Dialogue: 0,0:21:12.35,0:21:14.55,Default,,0,0,0,,Терезе сұңқары Қоқыстарды тоқтатыңыз.
Dialogue: 0,0:21:14.55,0:21:17.35,Default,,0,0,0,,Халк осында. Негізге қолдау көрсетіңіз.
Dialogue: 0,0:21:20.46,0:21:22.46,Default,,0,0,0,,Қар көшкіні жиіркенішті.
Dialogue: 0,0:21:37.69,0:21:40.24,Default,,0,0,0,,Бұл тоқтатылуы керек
Dialogue: 0,0:21:40.24,0:21:50.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:50.52,0:21:52.54,Default,,0,0,0,,Енді қашайық
Dialogue: 0,0:21:52.54,0:21:55.52,Default,,0,0,0,,Күте тұрыңыз, олар жолдастарын қорғауға тырысады.
Dialogue: 0,0:21:55.52,0:21:58.69,Default,,0,0,0,,Бұл тұзақ болуы керек.
Dialogue: 0,0:21:58.69,0:22:01.35,Default,,0,0,0,,ﾄﾞﾙｸﾞﾎﾟｽﾞ ﾅｲﾔﾂﾋﾞﾃﾞ
Dialogue: 0,0:22:01.35,0:22:04.72,Default,,0,0,0,,Аа, дұрыс. Достық төтенше жағдайда сыналады.
Dialogue: 0,0:22:04.72,0:22:08.02,Default,,0,0,0,,Бәлкім, «Кек алушылардың» біз білмейтін жағы бар шығар.
Dialogue: 0,0:22:08.02,0:22:10.54,Default,,0,0,0,,Қысқы күзет сізге қосылады!
Dialogue: 0,0:22:10.54,0:22:16.44,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:16.44,0:22:18.68,Default,,0,0,0,,Бұл қашуға мүмкіндік болды, бірақ неге?
Dialogue: 0,0:22:18.68,0:22:21.68,Default,,0,0,0,,Мен өз міндеттерімнен қаша алмаймын!
Dialogue: 0,0:22:21.68,0:22:26.10,Default,,0,0,0,,Біз де солай.
Dialogue: 0,0:22:26.10,0:22:29.54,Default,,0,0,0,,Қамқоршы Бұлай жалғаса берсе, ғимарат қирап қалады!
Dialogue: 0,0:22:29.54,0:22:32.69,Default,,0,0,0,,Бұл қуат көзі. Қуатты басқара алсаңыз➡
Dialogue: 0,0:22:32.69,0:22:36.99,Default,,0,0,0,,Зақымданудың алдын алуға бола ма? Әрине, сіз оны басқара аласыз
Dialogue: 0,0:22:40.12,0:22:43.86,Default,,0,0,0,,Сұңқар Жаса! Ауылды сақтап қалудың жалғыз жолы осы
Dialogue: 0,0:22:43.86,0:22:46.86,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:22:46.86,0:22:59.20,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:59.20,0:23:02.84,Default,,0,0,0,,Күте тұрыңыз, энергияны қалай басқарасыз?
Dialogue: 0,0:23:02.84,0:23:05.68,Default,,0,0,0,,Уайымдама, мен оны дұрыс орындаймын.
Dialogue: 0,0:23:05.68,0:23:14.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:14.35,0:23:17.34,Default,,0,0,0,,Біраз уақыт болды, Радио белсенді адам.
Dialogue: 0,0:23:17.34,0:23:22.91,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:22.91,0:23:25.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:25.45,0:23:34.67,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:34.67,0:23:36.68,Default,,0,0,0,,Рахмет, жолдас.
Dialogue: 0,0:23:36.68,0:23:39.19,Default,,0,0,0,,Мен енді ешқашан бос болмаймын деп ойладым.
Dialogue: 0,0:23:39.19,0:23:43.20,Default,,0,0,0,,Қуат көзі адам болды ма? несіне таң қалдың
Dialogue: 0,0:23:43.20,0:23:45.72,Default,,0,0,0,,Сен мұны білмей миссияға бардың ба?
Dialogue: 0,0:23:45.72,0:23:49.00,Default,,0,0,0,,Энергия көп. Аа, ол көп.
Dialogue: 0,0:23:49.00,0:23:51.51,Default,,0,0,0,,Мен аздап қарыз аламын. иә?
Dialogue: 0,0:23:51.51,0:23:55.01,Default,,0,0,0,,♬~
Dialogue: 0,0:23:55.01,0:24:13.11,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:13.11,0:24:15.81,Default,,0,0,0,,Һм? Не болды?
Dialogue: 0,0:24:17.85,0:24:21.00,Default,,0,0,0,,Мен мұндай ақжарқын зұлым адамды көрген емеспін.
Dialogue: 0,0:24:21.00,0:24:23.36,Default,,0,0,0,,Қысқы күзетші зұлым адам емес
Dialogue: 0,0:24:23.36,0:24:27.38,Default,,0,0,0,,Біз Орталық қолбасшылыққа қызмет етеміз, Қалқанның орысша нұсқасы.
Dialogue: 0,0:24:27.38,0:24:31.50,Default,,0,0,0,,Ол жолдасын босату туралы бұйрыққа қарсы әрекет етті.
Dialogue: 0,0:24:31.50,0:24:34.05,Default,,0,0,0,,Ұрлағаным үшін кешірім сұраймын, бірақ➡
Dialogue: 0,0:24:34.05,0:24:37.54,Default,,0,0,0,,Мен достарымның қару ретінде қолданылуына жол бере алмадым.
Dialogue: 0,0:24:37.54,0:24:39.84,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:24:44.51,0:24:48.31,Default,,0,0,0,,Гунмекс, егер қаласаңыз... Мен Халкпын, сондықтан бас тартамын!
Dialogue: 0,0:24:51.52,0:24:54.34,Default,,0,0,0,,Егер сіз өз бетіңізше әрекет етсеңіз, сіз Старкпен бірдейсіз.
Dialogue: 0,0:24:54.34,0:24:57.52,Default,,0,0,0,,Біз ойында пешка емеспіз. Біз адамбыз.
Dialogue: 0,0:24:57.52,0:25:01.36,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:25:01.36,0:25:04.53,Default,,0,0,0,,Сіз түсінбейсіз деп ойлаймын. Сахнаны көре алмайсың.
Dialogue: 0,0:25:04.53,0:25:06.93,Default,,0,0,0,,Себебі сіз тек экрандағы нүктелерді қарап отырсыз.
Dialogue: 0,0:25:06.93,0:25:09.35,Default,,0,0,0,,Пауэр көзі адам екеніне үндемедің.
Dialogue: 0,0:25:09.35,0:25:14.36,Default,,0,0,0,,Тіпті адамдар ма? Мен білмедім. Ол Гидрадан тәркіленді.
Dialogue: 0,0:25:14.36,0:25:18.53,Default,,0,0,0,,Пешкадай болып, енді сене алар емеспін
Dialogue: 0,0:25:18.53,0:25:20.51,Default,,0,0,0,,Тіпті Тони онша алысқа бармас еді.
Dialogue: 0,0:25:20.51,0:25:24.92,Default,,0,0,0,,Бізбен жұмыс істегіңіз келсе, біздің жолымызды өзгертуімізді сұраңыз.
Dialogue: 0,0:25:24.92,0:25:28.67,Default,,0,0,0,,Дұрыс, сендер төртеуің арнайы қорғаныс агенттерісіңдер.
Dialogue: 0,0:25:28.67,0:25:30.87,Default,,0,0,0,,Істерді орындау тәсілін өзгертіңіз
Dialogue: 0,0:25:30.87,0:25:33.29,Default,,0,0,0,,Бұл қиын тапсырма болады, бірақ сіз дайынсыз ба?
Dialogue: 0,0:25:33.29,0:25:35.39,Default,,0,0,0,,Оңай тапсырма жоқ.
Dialogue: 0,0:25:40.83,0:25:44.67,Default,,0,0,0,,Бұл Эймнің шабуылы болды, бірақ жою әрекеттерінің көпшілігі ➡ болды
Dialogue: 0,0:25:44.67,0:25:47.69,Default,,0,0,0,,Оған себеп Темір адам тобының төбелеске шығуы болды.
Dialogue: 0,0:25:47.69,0:25:50.86,Default,,0,0,0,,Тони Старк заңды елемейді
Dialogue: 0,0:25:50.86,0:25:54.03,Default,,0,0,0,,Оның S.H.I.E.L.D. қоңырауына жауап беруге ниеті жоқ сияқты.
Dialogue: 0,0:25:54.03,0:25:58.03,Default,,0,0,0,,Оларға тапсырманы айтыңыз. Оларды алып кетіңіз.
Dialogue: 0,0:26:35.69,0:26:37.69,Default,,0,0,0,,<“Кек алушылар жиналады” фильмінде пайда болды➡
Dialogue: 0,0:26:37.69,0:26:39.67,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:39.67,0:26:41.86,Default,,0,0,0,,Осы жерде жинаңыз
Dialogue: 0,0:26:41.86,0:26:44.51,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:44.51,0:26:47.20,Default,,0,0,0,,Ресейлік суперқаһарман Қызыл күзетші➡
Dialogue: 0,0:26:47.20,0:26:52.07,Default,,0,0,0,,Артур Майордан тұратын Crimson Dinamo Darkstar командасы
Dialogue: 0,0:26:52.07,0:26:54.86,Default,,0,0,0,,Бұл Ресейдің Кек алушыларға берген жауабы деп айтуға болады➡
Dialogue: 0,0:26:54.86,0:26:57.83,Default,,0,0,0,,Бұл топтың көпшілігі бұрынғы Кеңес Одағының командалары➡
Dialogue: 0,0:26:57.83,0:27:00.73,Default,,0,0,0,,Кеңес Одағының жауынгері болды>
Dialogue: 0,0:27:02.23,0:27:08.23,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
