Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.89,0:00:40.89,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.76,0:00:47.71,Default,,0,0,0,,<Кек алушылар Бұл супер қаһармандар →
Dialogue: 0,0:00:47.71,0:00:50.37,Default,,0,0,0,,Жиналған ең күшті батырлар командасы
Dialogue: 0,0:00:50.37,0:00:52.73,Default,,0,0,0,,Төтенше күш жинау→
Dialogue: 0,0:00:52.73,0:00:54.77,Default,,0,0,0,,Жер бетіндегі бейбітшілікті қорға! ＞
Dialogue: 0,0:00:54.77,0:00:56.82,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.82,0:00:58.87,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:58.87,0:01:01.39,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.39,0:01:03.48,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.48,0:01:05.45,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.45,0:01:07.45,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.37,0:01:11.89,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.89,0:01:14.96,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.96,0:01:16.96,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:16.96,0:01:19.03,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:19.03,0:01:21.03,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:22.93,0:01:24.88,Default,,0,0,0,,Құрыш иілген жоқ па?
Dialogue: 0,0:01:24.88,0:01:26.89,Default,,0,0,0,,Қайырлы кеш, бұл Меган Макларен.
Dialogue: 0,0:01:26.89,0:01:29.24,Default,,0,0,0,,Қазір менің алдымда отырған адам → дегеннен басқа ешкім емес
Dialogue: 0,0:01:29.24,0:01:31.87,Default,,0,0,0,,Жеңілмейтін темір адам Тони Старк
Dialogue: 0,0:01:31.87,0:01:34.88,Default,,0,0,0,,Жеңілмеу сәл әсірелеу болуы мүмкін.
Dialogue: 0,0:01:34.88,0:01:37.90,Default,,0,0,0,,Адамдар өшпеушілік пен өлместік → сияқты нәрселер туралы жиі айтады
Dialogue: 0,0:01:37.90,0:01:39.90,Default,,0,0,0,,Қалғаны тартымды, солай емес пе?
Dialogue: 0,0:01:41.92,0:01:44.20,Default,,0,0,0,,Әкім Кек алушылар күнін мерекелеуге арналған шеру өткізеді →
Dialogue: 0,0:01:44.20,0:01:47.61,Default,,0,0,0,,Презентация жасағанда қандай сезімде болдыңыз? Олар тіпті сізге қаланың кілтін берді.
Dialogue: 0,0:01:47.61,0:01:49.62,Default,,0,0,0,,Әрине, бұл үлкен құрмет болды.
Dialogue: 0,0:01:49.62,0:01:51.88,Default,,0,0,0,,Менің еңбегім бағаланғанына қуаныштымын.
Dialogue: 0,0:01:51.88,0:01:54.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:54.21,0:01:58.88,Default,,0,0,0,,Басқаша айтқанда, ұжымның жұмысы, хаха...хаха
Dialogue: 0,0:01:58.88,0:02:01.89,Default,,0,0,0,,Капитан бұл мереке туралы не ойлайды?
Dialogue: 0,0:02:01.89,0:02:04.94,Default,,0,0,0,,Қолымыздан келгенше істейміз→
Dialogue: 0,0:02:04.94,0:02:07.56,Default,,0,0,0,,Мұны тек мақтанышпен орындаңыз.
Dialogue: 0,0:02:07.56,0:02:10.28,Default,,0,0,0,,Кек алушылар күні? Маған бәрібір
Dialogue: 0,0:02:10.28,0:02:12.21,Default,,0,0,0,,Бұл торт өте жақсы.
Dialogue: 0,0:02:12.21,0:02:14.57,Default,,0,0,0,,Кез келген адам қуанар еді.
Dialogue: 0,0:02:14.57,0:02:16.90,Default,,0,0,0,,Бірақ мен әлі де үйреніп жатырмын.
Dialogue: 0,0:02:16.90,0:02:19.97,Default,,0,0,0,,Күлімсіреңіз. (Қара жесір) Мен күліп тұрмын.
Dialogue: 0,0:02:19.97,0:02:24.39,Default,,0,0,0,,Қалай болғанда да, Халк бәрінен күшті, болды.
Dialogue: 0,0:02:24.39,0:02:28.38,Default,,0,0,0,,｜Сонымен ол күштірек дейді, сіздің пікіріңіз қандай?
Dialogue: 0,0:02:28.38,0:02:32.42,Default,,0,0,0,,Бір ғана сөз. Халк - ең күшті.
Dialogue: 0,0:02:32.42,0:02:36.54,Default,,0,0,0,,Тор найзағай мен балғаны пайдаланады, ал сен тек осы жұдырықты қолданасың ба?
Dialogue: 0,0:02:36.54,0:02:38.87,Default,,0,0,0,,Әрине! Апыр-ай!
Dialogue: 0,0:02:38.87,0:02:42.13,Default,,0,0,0,,Халк өзін ең күшті деп айтты?
Dialogue: 0,0:02:42.13,0:02:45.06,Default,,0,0,0,,Ха! Халк, әрине, жақсы қарсылас →
Dialogue: 0,0:02:45.06,0:02:48.58,Default,,0,0,0,,Шайқас қай уақытта өтсе де, нәтижесі барлығына түсінікті.
Dialogue: 0,0:02:48.58,0:02:50.90,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:02:50.90,0:02:53.50,Default,,0,0,0,,ｳｰｯ！
Dialogue: 0,0:02:56.87,0:03:00.23,Default,,0,0,0,,Қабырғаларды берік етуіміз керек.
Dialogue: 0,0:03:00.23,0:03:03.26,Default,,0,0,0,,Хахахаха! Кел, Халк
Dialogue: 0,0:03:03.26,0:03:07.20,Default,,0,0,0,,Майорнияның күшін есте сақтаңыз.
Dialogue: 0,0:03:07.20,0:03:09.24,Default,,0,0,0,,ﾌﾝ！
Dialogue: 0,0:03:09.24,0:03:12.46,Default,,0,0,0,,Эй, осы бөлікті қиып жібере аласыз ба?
Dialogue: 0,0:03:12.46,0:03:14.76,Default,,0,0,0,,Бұл...｡ (ысқырық)
Dialogue: 0,0:03:14.76,0:03:17.26,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ…
Dialogue: 0,0:03:26.27,0:03:28.89,Default,,0,0,0,,Ұрыс, ағайын.
Dialogue: 0,0:03:28.89,0:03:32.29,Default,,0,0,0,,Ішкі жауынгерлік рухыңызды босатыңыз
Dialogue: 0,0:03:32.29,0:03:35.89,Default,,0,0,0,,Асгардтың ұлы жауынгері ретінде.
Dialogue: 0,0:03:38.55,0:03:41.42,Default,,0,0,0,,Мм! Ха!
Dialogue: 0,0:03:41.42,0:03:43.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:46.44,0:03:48.44,Default,,0,0,0,,Бақыланбайтын
Dialogue: 0,0:03:51.38,0:03:54.27,Default,,0,0,0,,Сонымен, сіздің найзағайыңыз
Dialogue: 0,0:03:54.27,0:03:56.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:00.22,0:04:04.01,Default,,0,0,0,,Мен төбелес шығарамын. Менің қалағаным осы.
Dialogue: 0,0:04:04.01,0:04:06.01,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:05:26.97,0:05:30.57,Default,,0,0,0,,Халк! маған қалдыр
Dialogue: 0,0:05:33.21,0:05:35.30,Default,,0,0,0,,Садақ қажет емес
Dialogue: 0,0:05:35.30,0:05:37.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:37.24,0:05:39.94,Default,,0,0,0,,Не? Сіздің тынысыңыздың иісі бар ма? Хаа
Dialogue: 0,0:05:39.94,0:05:41.87,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:05:41.87,0:05:45.21,Default,,0,0,0,,Бірдеңе дұрыс емес. Журналистер қайда кетті?
Dialogue: 0,0:05:45.21,0:05:47.28,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:05:47.28,0:05:50.21,Default,,0,0,0,,Сіз көптеген адамдардың өмірін қатерге тігесіз.
Dialogue: 0,0:05:50.21,0:05:53.07,Default,,0,0,0,,Не үшін? Бұл әдеттегі қуатты салыстыру ма?
Dialogue: 0,0:05:53.07,0:05:55.92,Default,,0,0,0,,Мен жаңа ғана ашуландым. Сенің сылтауың қандай?
Dialogue: 0,0:05:55.92,0:05:57.96,Default,,0,0,0,,Кешіріңіз, Старк
Dialogue: 0,0:05:57.96,0:06:01.61,Default,,0,0,0,,Бұл Асгард стиліндегі жолдастық ойын болды, бірақ ол абайсызда өтті.
Dialogue: 0,0:06:01.61,0:06:04.08,Default,,0,0,0,,Бұл әйгілі Асгард стилі.
Dialogue: 0,0:06:04.08,0:06:07.45,Default,,0,0,0,,Бұл сіздің ағаңыз Локидің қуылуына әкелді→
Dialogue: 0,0:06:07.45,0:06:09.38,Default,,0,0,0,,Бұл жолдастық жарыспен бірдей ме?
Dialogue: 0,0:06:09.38,0:06:13.44,Default,,0,0,0,,Жоқ, бұл дұрыс емес. Роки екеуміздің жағдайда бұл балалар арасындағы жарыс.
Dialogue: 0,0:06:13.44,0:06:15.54,Default,,0,0,0,,Бірақ Локи өзгерді.
Dialogue: 0,0:06:15.54,0:06:19.06,Default,,0,0,0,,Мүмкін қарым-қатынас сіз ойлағандай достық болмаған шығар.
Dialogue: 0,0:06:19.06,0:06:21.38,Default,,0,0,0,,Айтпақшы, Халк, сен кереметсің.
Dialogue: 0,0:06:21.38,0:06:24.23,Default,,0,0,0,,Мм. Ол нағыз батыр.
Dialogue: 0,0:06:24.23,0:06:27.32,Default,,0,0,0,,Енді ше? бәріміз батырмыз
Dialogue: 0,0:06:27.32,0:06:29.55,Default,,0,0,0,,Сізде найзағай мен ағаш таяқ →
Dialogue: 0,0:06:29.55,0:06:32.77,Default,,0,0,0,,Үлкен тасты пайдаланады, бірақ Халк сияқты үлкен емес.
Dialogue: 0,0:06:32.77,0:06:36.21,Default,,0,0,0,,Эй, сен мұны естідің бе? Халк сияқты жақсы емес.
Dialogue: 0,0:06:36.21,0:06:38.20,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:06:38.20,0:06:40.97,Default,,0,0,0,,Эй, тыныштал. Орынға қараңыз.
Dialogue: 0,0:06:40.97,0:06:42.97,Default,,0,0,0,,Халк Мені арандатпа. Бұл жай ғана әзіл.
Dialogue: 0,0:06:45.37,0:06:48.42,Default,,0,0,0,,Халк Жарайсың сізге...
Dialogue: 0,0:06:48.42,0:06:51.88,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:51.88,0:06:54.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:54.13,0:06:56.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:00.70,0:07:03.75,Default,,0,0,0,,Тыңда, мен ақымақ емеспін.
Dialogue: 0,0:07:03.75,0:07:07.05,Default,,0,0,0,,Мен сенен күштімін
Dialogue: 0,0:07:10.21,0:07:13.05,Default,,0,0,0,,Дәлелдеңіз.
Dialogue: 0,0:07:13.05,0:07:16.05,Default,,0,0,0,,Бұл туралы алаңдамаңыз. Бұл Асгард емес.
Dialogue: 0,0:07:16.05,0:07:19.04,Default,,0,0,0,,Сіздің ойыныңыз азаматтарға қауіп төндіреді.
Dialogue: 0,0:07:19.04,0:07:21.72,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз. (Меган) Екеуін тоқтату үшін →
Dialogue: 0,0:07:21.72,0:07:24.61,Default,,0,0,0,,Бұл әркімде бар сұрақтарға жауап беру туралы.
Dialogue: 0,0:07:24.61,0:07:27.55,Default,,0,0,0,,Кім күшті, Халк немесе Тор?
Dialogue: 0,0:07:27.55,0:07:30.57,Default,,0,0,0,,Бұл адам Нью-Йорк қираса жақсы деп ойлай ма?
Dialogue: 0,0:07:30.57,0:07:33.12,Default,,0,0,0,,Екеуіңіз де жеңгіңіз келеді.
Dialogue: 0,0:07:33.12,0:07:36.55,Default,,0,0,0,,Біреуіміз айналамыздағыларға қиындық тудырмай атақ-даңққа жеткенше→
Dialogue: 0,0:07:36.55,0:07:38.94,Default,,0,0,0,,Күресетін жерім болса ғой.
Dialogue: 0,0:07:38.94,0:07:41.31,Default,,0,0,0,,Ол мені қатты қызықтырады.
Dialogue: 0,0:07:41.31,0:07:45.31,Default,,0,0,0,,Жаңалық жүргізуші дұрыс айтады. Heimdal порталы!
Dialogue: 0,0:07:49.55,0:07:51.55,Default,,0,0,0,,Валхаллаға барыңыз
Dialogue: 0,0:07:53.70,0:07:55.76,Default,,0,0,0,,Жүрейік Халк
Dialogue: 0,0:07:55.76,0:07:58.71,Default,,0,0,0,,Асгарда еркін күресуге болатын көптеген жерлер бар.
Dialogue: 0,0:07:58.71,0:08:02.45,Default,,0,0,0,,Соңына дейін күресіп, кім күшті екенін анықтайық.
Dialogue: 0,0:08:02.45,0:08:05.75,Default,,0,0,0,,Маған айналаңызды көрсетіңіз! Уау
Dialogue: 0,0:08:10.39,0:08:13.59,Default,,0,0,0,,ﾊｯﾊｯ ﾊﾊﾊ…
Dialogue: 0,0:08:13.59,0:08:16.59,Default,,0,0,0,,Менің болжамым дұрыс болды. Жаса, Хоки!
Dialogue: 0,0:08:22.72,0:08:26.72,Default,,0,0,0,,Балалар сендер дөңгелегімен жүгіретін тышқандар сияқтысыңдар.
Dialogue: 0,0:08:26.72,0:08:29.06,Default,,0,0,0,,Мүлдем мағынасыз нәрсе жасаңыз
Dialogue: 0,0:08:29.06,0:08:32.04,Default,,0,0,0,,Локи: Сен Халк пен Торға не істедің?
Dialogue: 0,0:08:32.04,0:08:35.11,Default,,0,0,0,,Маған арғы әлемге бір жақты билет берілді.
Dialogue: 0,0:08:35.11,0:08:38.08,Default,,0,0,0,,Валхаллада тек мықтылар ғана қала алады.
Dialogue: 0,0:08:38.08,0:08:42.68,Default,,0,0,0,,Балалар, осы екеуісіз қанша жұмыс істей алатындарын көрейік.
Dialogue: 0,0:08:47.39,0:08:50.38,Default,,0,0,0,,Сонымен, Локи айтып отырған нәрсе - Валхалла...
Dialogue: 0,0:08:50.38,0:08:53.78,Default,,0,0,0,,Бұл шайқаста қаза тапқан асгардиялық жауынгерлердің баратын жері.
Dialogue: 0,0:08:53.78,0:08:55.78,Default,,0,0,0,,Сіз ешқашан қайтып орала алмайсыз
Dialogue: 0,0:09:09.88,0:09:12.93,Default,,0,0,0,,Қайырлы күн Хелла. Валхалла патшайымы
Dialogue: 0,0:09:12.93,0:09:16.39,Default,,0,0,0,,Көңілдің ба? Менің жалығып кеткенім сонша, одан әрі жалықтыра алмадым.
Dialogue: 0,0:09:16.39,0:09:18.39,Default,,0,0,0,,Патшайым осы Валхалланы көретін →
Dialogue: 0,0:09:18.39,0:09:22.98,Default,,0,0,0,,Сіз өз арманыңыз – эпикалық жауынгерлік шоумен атмосфераны жандандыру деп айттыңыз.
Dialogue: 0,0:09:22.98,0:09:25.21,Default,,0,0,0,,Бұл көп уақыт бұрын болды.
Dialogue: 0,0:09:25.21,0:09:28.10,Default,,0,0,0,,Саған осындай тамаша дайындадым десем ше?
Dialogue: 0,0:09:28.10,0:09:31.57,Default,,0,0,0,,Бұл тым көп қиындық, Локи. Енді үстел үстіндегі ең мықты екі жауынгер →
Dialogue: 0,0:09:31.57,0:09:35.87,Default,,0,0,0,,Біз кім өзін ең мықты деп айта алатынын білу үшін күресіп жатырмыз.
Dialogue: 0,0:09:42.71,0:09:45.88,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:09:45.88,0:09:49.24,Default,,0,0,0,,Эй Халк, бұл біртүрлі.
Dialogue: 0,0:09:49.24,0:09:51.82,Default,,0,0,0,,Сіз жай ғана әлсізсіз
Dialogue: 0,0:09:51.82,0:09:54.93,Default,,0,0,0,,Бұл мен білетін Асгард емес.
Dialogue: 0,0:09:54.93,0:09:57.73,Default,,0,0,0,,Кез келген жерде жақсы. Сен хайуан!
Dialogue: 0,0:10:01.05,0:10:04.03,Default,,0,0,0,,Сіз қалай ойлайсыз? бұл таңқаларлық
Dialogue: 0,0:10:04.03,0:10:07.87,Default,,0,0,0,,Бұл шайқасты мәңгі көргіңіз келмейді ме?
Dialogue: 0,0:10:07.87,0:10:10.88,Default,,0,0,0,,Сонымен, сіздің мақсатыңыз қандай?
Dialogue: 0,0:10:10.88,0:10:13.44,Default,,0,0,0,,Шын мәнінде, біраз уақытқа →
Dialogue: 0,0:10:13.44,0:10:18.23,Default,,0,0,0,,Маған қарыз беруіңізді қалайтын бір нәрсем бар.
Dialogue: 0,0:10:18.23,0:10:20.72,Default,,0,0,0,,Мен саған плащтың кемшілігін айттым.
Dialogue: 0,0:10:20.72,0:10:25.54,Default,,0,0,0,,Сүйегі жыртылатын жері.
Dialogue: 0,0:10:25.54,0:10:29.44,Default,,0,0,0,,Уау! Бұл ақымақ сиқырлы трюк. Бұл қай жер?
Dialogue: 0,0:10:29.44,0:10:32.54,Default,,0,0,0,,А, сіз нені айтып тұрсыз? Бұл Валхалла.
Dialogue: 0,0:10:36.28,0:10:38.20,Default,,0,0,0,,Heimdal порталы!
Dialogue: 0,0:10:38.20,0:10:40.29,Default,,0,0,0,,ｱﾌﾞﾗｶﾀﾀﾞﾌﾞﾗ
Dialogue: 0,0:10:40.29,0:10:42.24,Default,,0,0,0,,ﾋﾞﾋﾞﾃﾞ･ﾊﾞﾋﾞﾃﾞ･ﾌﾞｰ！
Dialogue: 0,0:10:42.24,0:10:45.74,Default,,0,0,0,,Жақсы емес. Эй, Сұңқар, портал тауып бер.
Dialogue: 0,0:10:47.96,0:10:50.90,Default,,0,0,0,,Асығыңыз! Қашыңыз, бұл қауіпті!
Dialogue: 0,0:10:50.90,0:10:53.50,Default,,0,0,0,,А, бұл туралы не деуге болады?
Dialogue: 0,0:10:58.14,0:11:01.14,Default,,0,0,0,,Бұл мерекелік костюмдер шеруі емес сияқты.
Dialogue: 0,0:11:03.39,0:11:05.88,Default,,0,0,0,,Бүгін қылыш айналдыру жаттығуын жасадым
Dialogue: 0,0:11:05.88,0:11:09.85,Default,,0,0,0,,Жер патшасы Локи сізге кек алушыларға соғыс жариялайды.
Dialogue: 0,0:11:09.85,0:11:12.95,Default,,0,0,0,,Король? Мен мұндай ештеңе естімедім.
Dialogue: 0,0:12:14.88,0:12:27.19,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:27.19,0:12:30.40,Default,,0,0,0,,Валхалла ұлы жауынгерлер жиналатын ыстық жер емес пе?
Dialogue: 0,0:12:30.40,0:12:33.12,Default,,0,0,0,,Бұл балалар суық көрінеді. иә?
Dialogue: 0,0:12:33.12,0:12:35.04,Default,,0,0,0,,Сіздің әзіліңіз сияқты
Dialogue: 0,0:12:35.04,0:12:37.04,Default,,0,0,0,,Оның ішінде дене жоқ. Таа!
Dialogue: 0,0:12:37.04,0:12:40.11,Default,,0,0,0,,Сіз жай ғана қызықты бірдеңе айтқан болсаңыз да, сіз оны түсінбейсіз бе?
Dialogue: 0,0:12:40.11,0:12:42.14,Default,,0,0,0,,Білсең не істер едің?
Dialogue: 0,0:12:42.14,0:12:44.75,Default,,0,0,0,,Әзілдер жеткілікті! Оны басынан бастап үзейік
Dialogue: 0,0:12:44.75,0:12:47.35,Default,,0,0,0,,Рокиді ұстаңыз! Білемін, Тони!
Dialogue: 0,0:12:49.47,0:12:51.47,Default,,0,0,0,,Мынаны алыңыз!
Dialogue: 0,0:12:53.39,0:12:55.96,Default,,0,0,0,,Бұл көз ауыртады!
Dialogue: 0,0:12:55.96,0:12:57.96,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:12:59.88,0:13:03.90,Default,,0,0,0,,Джарвис! Сонда қалай болды? Сіз Асгардтың жазбаларын таптыңыз ба?
Dialogue: 0,0:13:03.90,0:13:05.92,Default,,0,0,0,,Иә, аңыз бойынша→
Dialogue: 0,0:13:05.92,0:13:11.21,Default,,0,0,0,,Өлгендер патшайымы Гераның аңшылық мүйізіне ие болғандар Вальхара әскерін басқара алады дейді.
Dialogue: 0,0:13:11.21,0:13:13.61,Default,,0,0,0,,Локи басқа әлемнің әскерін ұрлады ма?
Dialogue: 0,0:13:13.61,0:13:17.21,Default,,0,0,0,,Жоқ, сырнай тарту үшін патшайымның рұқсаты керек.
Dialogue: 0,0:13:17.21,0:13:19.28,Default,,0,0,0,,Сіз оны Хелладан алдыңыз ба?
Dialogue: 0,0:13:19.28,0:13:21.88,Default,,0,0,0,,Рок-концертті тез аяқтайық!
Dialogue: 0,0:13:25.89,0:13:28.39,Default,,0,0,0,,Бұл екі адамның төбелесетін уақыты емес.
Dialogue: 0,0:13:28.39,0:13:30.77,Default,,0,0,0,,Жерге қауіп төніп тұр
Dialogue: 0,0:13:30.77,0:13:33.21,Default,,0,0,0,,Мен сенімен ұрысудан шаршадым.
Dialogue: 0,0:13:33.21,0:13:35.56,Default,,0,0,0,,Ха! Ха!
Dialogue: 0,0:13:35.56,0:13:37.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:40.55,0:13:43.20,Default,,0,0,0,,ﾊﾙｸ･ｽﾏｯｼｭ！
Dialogue: 0,0:13:43.20,0:13:46.21,Default,,0,0,0,,Тоқта, Халк деп аталатын...
Dialogue: 0,0:13:46.21,0:13:48.91,Default,,0,0,0,,Асгардиялықтар біртүрлі дулығаларды жақсы көреді.
Dialogue: 0,0:13:48.91,0:13:52.30,Default,,0,0,0,,Бізді не үшін қамауға алу керек? Мен сенің жауың емеспін
Dialogue: 0,0:13:52.30,0:13:55.22,Default,,0,0,0,,Бірде ұлы жауынгерлер шайқасады →
Dialogue: 0,0:13:55.22,0:13:57.87,Default,,0,0,0,,Біз бөлшектелген мәйіттерді жеткілікті түрде көрдік.
Dialogue: 0,0:13:57.87,0:14:02.89,Default,,0,0,0,,Мен жаңа ойын-сауық іздеймін. Енді шоуға оралыңыз.
Dialogue: 0,0:14:02.89,0:14:05.99,Default,,0,0,0,,Бұл сіздің шоуыңыз емес. Апыр-ай!
Dialogue: 0,0:14:09.03,0:14:16.22,Default,,0,0,0,,♬~
Dialogue: 0,0:14:16.22,0:14:19.96,Default,,0,0,0,,Бұл... жер бетінде не істеді?
Dialogue: 0,0:14:19.96,0:14:22.33,Default,,0,0,0,,Тағдыр, арсыз адам.
Dialogue: 0,0:14:22.33,0:14:24.90,Default,,0,0,0,,Хелла! Мұны істеуді дереу тоқтатыңыз
Dialogue: 0,0:14:24.90,0:14:28.25,Default,,0,0,0,,Күрсінемін... Мен сирек көңіл көтеремін.
Dialogue: 0,0:14:28.25,0:14:33.75,Default,,0,0,0,,♬~
Dialogue: 0,0:14:36.72,0:14:40.31,Default,,0,0,0,,Өлгендердің ханшайымы, саған не керек?
Dialogue: 0,0:14:40.31,0:14:44.90,Default,,0,0,0,,Кім күшті? Бар болғаны жауабын тапсаңыз болғаны.
Dialogue: 0,0:14:44.90,0:14:48.54,Default,,0,0,0,,Сіз және Локи сияқты мен де ұрыс іздеп жүрмін.
Dialogue: 0,0:14:48.54,0:14:52.22,Default,,0,0,0,,Алайда бұл шайқас Жердің қорғанысын әлсіретіп жіберді.
Dialogue: 0,0:14:52.22,0:14:55.26,Default,,0,0,0,,Ішіңізде жауынгерлік рух жанып тұр.
Dialogue: 0,0:14:55.26,0:14:58.88,Default,,0,0,0,,Сіз және Локи арасындағы шайқас Асгард → негізін шайқады
Dialogue: 0,0:14:58.88,0:15:01.55,Default,,0,0,0,,Бұл баяғыда емес пе?
Dialogue: 0,0:15:01.55,0:15:05.97,Default,,0,0,0,,Мен тек жекпе-жекті өз көзіммен көргім келеді.
Dialogue: 0,0:15:05.97,0:15:09.54,Default,,0,0,0,,Жеңілгендер кетуі керек. Тек жеңімпаздар қалады.
Dialogue: 0,0:15:09.54,0:15:12.24,Default,,0,0,0,,Оны жеңейік. Біз бұл жерде жасай алмаймыз.
Dialogue: 0,0:15:12.24,0:15:15.21,Default,,0,0,0,,Гера бұл жердің билеушісі.
Dialogue: 0,0:15:15.21,0:15:18.23,Default,,0,0,0,,Бұл қиын, бірақ мен осы Валхаллада жалғыз болғанды жөн көремін →
Dialogue: 0,0:15:18.23,0:15:20.33,Default,,0,0,0,,Бір адам Жерге оралуы керек.
Dialogue: 0,0:15:20.33,0:15:23.43,Default,,0,0,0,,Егер мен жеңсем, достарыңызға оралуыңызға болады.
Dialogue: 0,0:15:29.93,0:15:33.56,Default,,0,0,0,,Үйге бара бер! Халк - ең күшті!! Апыр-ай!
Dialogue: 0,0:15:33.56,0:15:35.57,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:15:35.57,0:15:37.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:43.31,0:15:45.61,Default,,0,0,0,,Қандай аянышты шабуыл.
Dialogue: 0,0:15:49.40,0:15:54.00,Default,,0,0,0,,Ең күшті екі адам кеткен соң, мен енді шыдай алмаймын деп ойлаймын.
Dialogue: 0,0:15:57.49,0:16:00.04,Default,,0,0,0,,Локи! Бұл жолғы мақсатыңыз не?
Dialogue: 0,0:16:00.04,0:16:02.38,Default,,0,0,0,,Зомби патшасы болғыңыз келе ме?
Dialogue: 0,0:16:02.38,0:16:05.88,Default,,0,0,0,,Бұл жауынгерлік мүйіздерді танымал ету үшін жасалған жарнама ма?
Dialogue: 0,0:16:05.88,0:16:12.39,Default,,0,0,0,,Хехехе мен ағамның қолында өстім, үнемі бір-бірімізбен жарысатынбыз.
Dialogue: 0,0:16:12.39,0:16:15.96,Default,,0,0,0,,үшін жарыс болды, бәрі шайқас болды!
Dialogue: 0,0:16:15.96,0:16:18.38,Default,,0,0,0,,Бұл ағайындылық қатынастың кеңеюі ме?
Dialogue: 0,0:16:18.38,0:16:22.11,Default,,0,0,0,,Бауырлар мен әпкелер? Ұрыс басынан бері жүріп жатты
Dialogue: 0,0:16:22.11,0:16:24.47,Default,,0,0,0,,Мен мұздай алыптың ұлымын.
Dialogue: 0,0:16:24.47,0:16:26.90,Default,,0,0,0,,Один ұлын көбірек жарқыратқысы келеді →
Dialogue: 0,0:16:26.90,0:16:28.90,Default,,0,0,0,,Сіз мені кіргіздіңіз.
Dialogue: 0,0:16:30.89,0:16:35.78,Default,,0,0,0,,Ағамның жауынгерлік қасиетін пайдаланып, жеңіске жетудің жолын ақыры таптым.
Dialogue: 0,0:16:35.78,0:16:38.65,Default,,0,0,0,,Ең соңғы күлетін менмін
Dialogue: 0,0:16:38.65,0:16:40.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:40.55,0:16:44.28,Default,,0,0,0,,Мен ең күштімін. Мен осында қаламын!
Dialogue: 0,0:16:44.28,0:16:47.28,Default,,0,0,0,,Жерді сақта - Сонымен
Dialogue: 0,0:16:55.38,0:16:59.73,Default,,0,0,0,,Ахахха, сіздің шайқасыңыз өте қызық екен.
Dialogue: 0,0:16:59.73,0:17:03.10,Default,,0,0,0,,Локи күткендей, сіз мені әрқашан таң қалдырасыз.
Dialogue: 0,0:17:03.10,0:17:05.26,Default,,0,0,0,,Роки ше?
Dialogue: 0,0:17:05.26,0:17:07.56,Default,,0,0,0,,Менің інім қандай қулық жасады?
Dialogue: 0,0:17:14.55,0:17:16.62,Default,,0,0,0,,Бұл қызықты көрінеді.
Dialogue: 0,0:17:16.62,0:17:20.04,Default,,0,0,0,,Сіз Вальхараның әскеріне Жерге шабуыл жасауға рұқсат бердіңіз бе?
Dialogue: 0,0:17:20.04,0:17:22.16,Default,,0,0,0,,Біздің біреуімізге айырбас ретінде
Dialogue: 0,0:17:22.16,0:17:25.76,Default,,0,0,0,,Ең күшті жауынгерді алғыңыз келсе, бұл арзан.
Dialogue: 0,0:17:34.57,0:17:36.70,Default,,0,0,0,,Року шындыққа қараңыз
Dialogue: 0,0:17:36.70,0:17:38.89,Default,,0,0,0,,Сіздің әскеріңіз кетті. Ол аяқтады.
Dialogue: 0,0:17:38.89,0:17:41.06,Default,,0,0,0,,Бұл сіздің жоғалтыңыз.
Dialogue: 0,0:17:41.06,0:17:44.86,Default,,0,0,0,,Мен бұл деңгейде ұтыла алмаймын.
Dialogue: 0,0:17:47.10,0:17:49.55,Default,,0,0,0,,♪♪(мүйіз)
Dialogue: 0,0:17:49.55,0:17:52.67,Default,,0,0,0,,Абайлаңыз, жер астынан бірдеңе келе жатыр.
Dialogue: 0,0:17:52.67,0:17:57.47,Default,,0,0,0,,Егер үлкен асгардиялық құбыжық көрінсе, мен қатты ашуланатын едім.
Dialogue: 0,0:18:05.12,0:18:09.12,Default,,0,0,0,,Бұл Фальконды қатты ашуландыратын сияқты.
Dialogue: 0,0:18:13.89,0:18:16.09,Default,,0,0,0,,Адамдар, сіздердің қандай кемшіліктеріңіз бар?
Dialogue: 0,0:18:16.09,0:18:19.89,Default,,0,0,0,,Мәңгілік деген ұғымды түсінбейсің.
Dialogue: 0,0:18:25.40,0:18:28.90,Default,,0,0,0,,Осы қарқынмен әкім менен қала кілтін қайтарып беруімді өтінеді.
Dialogue: 0,0:19:30.92,0:19:33.92,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:19:40.91,0:19:45.38,Default,,0,0,0,,Күлкілі, Жердің жаңа қызметшілері қашып жүр.
Dialogue: 0,0:19:45.38,0:19:50.12,Default,,0,0,0,,Кек алушы мұнарасына барыңыз. Патшаға сарай керек.
Dialogue: 0,0:19:50.12,0:19:53.01,Default,,0,0,0,,Әңгімешіл екенін ұмытып қалдым.
Dialogue: 0,0:19:53.01,0:19:56.81,Default,,0,0,0,,Бұл сенің әлсіздігің, маған қалдыр.
Dialogue: 0,0:20:00.93,0:20:04.03,Default,,0,0,0,,Әй~ Қатты! Айқайлаған дауысты сағындым
Dialogue: 0,0:20:04.03,0:20:07.40,Default,,0,0,0,,Сырттан шабуыл жасасаң да жақсы емес.
Dialogue: 0,0:20:07.40,0:20:09.44,Default,,0,0,0,,Ішінен жарылып кетеді.
Dialogue: 0,0:20:09.44,0:20:11.84,Default,,0,0,0,,Мен олай емес деп ойлаймын, бірақ сізде құралдар бар ма?
Dialogue: 0,0:20:11.84,0:20:13.94,Default,,0,0,0,,Көшеге шығуға міндетті зат.
Dialogue: 0,0:20:17.23,0:20:19.30,Default,,0,0,0,,ﾊﾊﾊ
Dialogue: 0,0:20:19.30,0:20:21.39,Default,,0,0,0,,Күлетін уақыт емес.
Dialogue: 0,0:20:21.39,0:20:24.39,Default,,0,0,0,,Енді күресуді жалғастырыңыз немесе...
Dialogue: 0,0:20:24.39,0:20:27.59,Default,,0,0,0,,Ағам ақыры мені жеңді.
Dialogue: 0,0:20:27.59,0:20:31.90,Default,,0,0,0,,Ең күшті жауынгер келсе, Роки сенің жауабың.
Dialogue: 0,0:20:31.90,0:20:34.23,Default,,0,0,0,,Бұл мүлдем мағынасыз.
Dialogue: 0,0:20:34.23,0:20:36.22,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:20:36.22,0:20:38.40,Default,,0,0,0,,Жарысқа қатысып жатқанымызды пайдаланып қал →
Dialogue: 0,0:20:38.40,0:20:40.39,Default,,0,0,0,,Сізді мұнда кім құлыптады?
Dialogue: 0,0:20:40.39,0:20:43.32,Default,,0,0,0,,Басқаша айтқанда, сіз Локидің жоспарына түсіп қалдыңыз→
Dialogue: 0,0:20:43.32,0:20:45.73,Default,,0,0,0,,Мен ең мықты жауынгер деп қателестім.
Dialogue: 0,0:20:45.73,0:20:48.21,Default,,0,0,0,,Мен алданып қалдым.
Dialogue: 0,0:20:48.21,0:20:50.93,Default,,0,0,0,,Тіліңді ұста, Одиннің ұлы.
Dialogue: 0,0:20:50.93,0:20:53.38,Default,,0,0,0,,Валхалланың әскері сені жалғыз қалдырмайды.
Dialogue: 0,0:20:53.38,0:20:56.77,Default,,0,0,0,,Айналаңызға қараңыз, Локи бәрін алып кетті.
Dialogue: 0,0:20:56.77,0:20:59.72,Default,,0,0,0,,Бұл шайқаста кім жеңеді деп ойлайсың?
Dialogue: 0,0:20:59.72,0:21:03.66,Default,,0,0,0,,Уау! Локи!
Dialogue: 0,0:21:03.66,0:21:05.96,Default,,0,0,0,,Мен сені ұстап алайын ба?
Dialogue: 0,0:21:15.92,0:21:18.02,Default,,0,0,0,,Кіреберіс бар.
Dialogue: 0,0:21:20.06,0:21:22.36,Default,,0,0,0,,Баратыныңызға сенімдісіз бе?
Dialogue: 0,0:21:28.99,0:21:31.29,Default,,0,0,0,,ﾄｳｯ！
Dialogue: 0,0:21:36.41,0:21:39.55,Default,,0,0,0,,Тони жіліншігіне бомба қойды.
Dialogue: 0,0:21:39.55,0:21:41.92,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:21:41.92,0:21:44.92,Default,,0,0,0,,Менискустың ішінде болуы мүмкін.
Dialogue: 0,0:21:47.27,0:21:50.66,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:21:50.66,0:21:53.76,Default,,0,0,0,,Мұны анатомия сабағында білгеніңізге сенімдімін, бірақ қайдан?
Dialogue: 0,0:21:55.81,0:21:58.41,Default,,0,0,0,,Әйтеуір, мына жігіттің назарын аударыңыз.
Dialogue: 0,0:22:09.09,0:22:12.20,Default,,0,0,0,,Уф...Сұңқар Оң аяқ.
Dialogue: 0,0:22:12.20,0:22:14.20,Default,,0,0,0,,Уау
Dialogue: 0,0:22:14.20,0:22:18.25,Default,,0,0,0,,Мен мұны білемін, мен оны ұстадым.
Dialogue: 0,0:22:18.25,0:22:23.29,Default,,0,0,0,,Сен нағыз батылсың, бірақ жансыз жанның өмірін ала алмайсың.
Dialogue: 0,0:22:23.29,0:22:26.63,Default,,0,0,0,,Маған жазу керек емес. ♪♪ (мүйіз)
Dialogue: 0,0:22:26.63,0:22:28.93,Default,,0,0,0,,ﾊｯ！
Dialogue: 0,0:22:31.88,0:22:34.12,Default,,0,0,0,,Мен қозғалуды тоқтаттым, бірақ мен оны аяқтауым керек.
Dialogue: 0,0:22:34.12,0:22:36.42,Default,,0,0,0,,Бомбалардың айтарлықтай көлемін қажет етеді
Dialogue: 0,0:22:39.79,0:22:41.79,Default,,0,0,0,,ｽﾏｰｯｼｭ！
Dialogue: 0,0:22:43.88,0:22:46.23,Default,,0,0,0,,Бұл солай болуы керек.
Dialogue: 0,0:22:46.23,0:22:49.03,Default,,0,0,0,,Кетіңіз!
Dialogue: 0,0:22:54.72,0:22:57.21,Default,,0,0,0,,ﾛｷ！
Dialogue: 0,0:22:57.21,0:23:01.41,Default,,0,0,0,,Өлгендерді басқаратын мүйіз ең күшті жауынгердің орнына алынған.
Dialogue: 0,0:23:01.41,0:23:05.71,Default,,0,0,0,,Бұл рас, бірақ шектен шығып кеттіңіз, алаяқ.
Dialogue: 0,0:23:08.87,0:23:13.54,Default,,0,0,0,,Жоқ, бұл сіздің шайқасыңыз. Жалғыз күрес.
Dialogue: 0,0:23:13.54,0:23:16.21,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:23:16.21,0:23:19.28,Default,,0,0,0,,Мәселе жоқ. Артында тұрыңыз.
Dialogue: 0,0:23:19.28,0:23:21.28,Default,,0,0,0,,Бұл біздің күрес
Dialogue: 0,0:23:37.08,0:23:39.18,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:23:42.57,0:23:45.37,Default,,0,0,0,,Күте тұрыңыз, мен бұл екеуінің стратегиясын түсінемін.
Dialogue: 0,0:23:45.37,0:23:48.07,Default,,0,0,0,,Мен сені мұндай күшті көрген емеспін.
Dialogue: 0,0:23:48.07,0:23:52.71,Default,,0,0,0,,Бұл жолы сен менің жауынгерлік қасиетімді пайдаландың, мен өзімнің әлсіздігімді түсіндім.
Dialogue: 0,0:23:52.71,0:23:56.23,Default,,0,0,0,,Мен сізге бұрын әділетсіздік жасадым.
Dialogue: 0,0:23:56.23,0:24:00.39,Default,,0,0,0,,Бұл ағаны кешіріңіз, өтінемін.
Dialogue: 0,0:24:00.39,0:24:03.24,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:24:03.24,0:24:05.81,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:24:05.81,0:24:10.70,Default,,0,0,0,,Жақсылық? Сен мені кім деп ойлайсың?
Dialogue: 0,0:24:10.70,0:24:13.45,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:24:13.45,0:24:15.87,Default,,0,0,0,,Міне! Бағыну!
Dialogue: 0,0:24:15.87,0:24:20.11,Default,,0,0,0,,Бұл Локи ақыры Одиннің ұлын жеңді!
Dialogue: 0,0:24:20.11,0:24:23.73,Default,,0,0,0,,Мен ағам бағынады деп ойламадым. Хахахаха!
Dialogue: 0,0:24:23.73,0:24:27.38,Default,,0,0,0,,Нақты не білдіңіз?
Dialogue: 0,0:24:27.38,0:24:30.62,Default,,0,0,0,,Мен сіз ойлағаннан да көбірек үйреніп жатырмын.
Dialogue: 0,0:24:30.62,0:24:32.72,Default,,0,0,0,,Міне!
Dialogue: 0,0:24:32.72,0:24:40.11,Default,,0,0,0,,♪♪(мүйіз)
Dialogue: 0,0:24:40.11,0:24:44.06,Default,,0,0,0,,Сіз іздеген ұлы жауынгер сіздікі болады.
Dialogue: 0,0:24:44.06,0:24:48.69,Default,,0,0,0,,Мен сені мәңгілік шайқас әлеміне апарамын, Локи
Dialogue: 0,0:24:48.69,0:24:52.19,Default,,0,0,0,,А, жоқ, тоқтат, ағайын!
Dialogue: 0,0:24:54.04,0:24:56.11,Default,,0,0,0,,Одиннің ұлы
Dialogue: 0,0:24:56.11,0:24:59.00,Default,,0,0,0,,Менің патшалығымды енді ешқашан қорламайсың.
Dialogue: 0,0:24:59.00,0:25:01.00,Default,,0,0,0,,Уақыты келгенше
Dialogue: 0,0:25:05.29,0:25:08.72,Default,,0,0,0,,Жарайсыңдар, екеуің де. Рокидің жеңіске жетуіне мүмкіндік беру тамаша идея болды.
Dialogue: 0,0:25:08.72,0:25:10.74,Default,,0,0,0,,Бұл оңай болған жоқ, солай ма?
Dialogue: 0,0:25:10.74,0:25:13.88,Default,,0,0,0,,Әй, басымды иіп кету қиын болды, бірақ→
Dialogue: 0,0:25:13.88,0:25:17.60,Default,,0,0,0,,Жеңіс үшін кейде намысыңды құрбан етуге тура келеді.
Dialogue: 0,0:25:17.60,0:25:20.05,Default,,0,0,0,,Мені Валхалла ұстап ала жаздады→
Dialogue: 0,0:25:20.05,0:25:22.20,Default,,0,0,0,,Халкты құтқару үшін
Dialogue: 0,0:25:22.20,0:25:26.39,Default,,0,0,0,,Хмм, ұсталды ма? Бұл менің ең күшті екенімді білдіре ме?
Dialogue: 0,0:25:26.39,0:25:30.54,Default,,0,0,0,,Ешкім айтқан жоқ, ақымақ жасыл дәу.
Dialogue: 0,0:25:30.54,0:25:33.26,Default,,0,0,0,,Күрсін... қайтадан қалыпты жағдайға оралды.
Dialogue: 0,0:25:33.26,0:25:36.12,Default,,0,0,0,,Жоқ, мен бүгін көп нәрсені білдім.
Dialogue: 0,0:25:36.12,0:25:40.37,Default,,0,0,0,,Роки мен таңдаған інім емес, бірақ ол әлі де отбасы.
Dialogue: 0,0:25:40.37,0:25:43.42,Default,,0,0,0,,Мен де Халк отбасын шақыруға қуаныштымын.
Dialogue: 0,0:25:43.42,0:25:46.04,Default,,0,0,0,,Хмм, оны қалдырыңыз.
Dialogue: 0,0:25:46.04,0:25:48.78,Default,,0,0,0,,Келіңдер, ағайындар, құртуды доғарыңдар →
Dialogue: 0,0:25:48.78,0:25:51.87,Default,,0,0,0,,Оның орнына отқа қуырылған ит жейміз.
Dialogue: 0,0:25:51.87,0:25:55.45,Default,,0,0,0,,Хотдог туралы айтып отырсыз ба?
Dialogue: 0,0:25:55.45,0:25:58.37,Default,,0,0,0,,Тони Старк. Бұл Daily Bugle журналындағы Морган Макларен.
Dialogue: 0,0:25:58.37,0:26:00.92,Default,,0,0,0,,Бүгінгі дүрбелең туралы бірер сөз айта аласыз ба?
Dialogue: 0,0:26:00.92,0:26:02.92,Default,,0,0,0,,ﾉｰｺﾒﾝﾄ！
Dialogue: 0,0:26:36.23,0:26:39.71,Default,,0,0,0,,<«Кек алушылар жиналады» фильмінде пайда болатын супер қаһармандар, жауыздар және т.б. туралы ақпарат →
Dialogue: 0,0:26:39.71,0:26:41.75,Default,,0,0,0,,Осы жерге жиналыңыз!
Dialogue: 0,0:26:41.75,0:26:44.88,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:44.88,0:26:48.42,Default,,0,0,0,,Скандинавия мифологиясының құдайлары тұратын әлем және Тордың туған қаласы
Dialogue: 0,0:26:48.42,0:26:52.19,Default,,0,0,0,,Бүкіл ғаламда бар делінетін тоғыз әлемнің бірі→
Dialogue: 0,0:26:52.19,0:26:56.80,Default,,0,0,0,,Жерге және басқа әлемдерге Радуга көпірі Бифрост арқылы қосылады.
Dialogue: 0,0:26:56.80,0:27:00.90,Default,,0,0,0,,Ардақты қаза тапқандардың жатқан жері Валхалла да осында бар>
Dialogue: 0,0:27:02.40,0:27:08.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
