Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.85,0:00:41.15,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.34,0:00:47.36,Default,,0,0,0,,<Кек алушылар, яғни➡
Dialogue: 0,0:00:47.36,0:00:50.99,Default,,0,0,0,,Супер қаһармандар жинаған ең күшті батырлар командасы
Dialogue: 0,0:00:50.99,0:00:54.50,Default,,0,0,0,,Өзіңіздің керемет күшіңізді жинаңыз және жердің тыныштығын қорғаңыз! ＞
Dialogue: 0,0:00:54.50,0:00:57.40,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:57.40,0:00:59.43,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:59.43,0:01:01.34,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.34,0:01:03.34,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.34,0:01:05.37,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.37,0:01:07.37,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.33,0:01:11.85,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.85,0:01:14.83,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.83,0:01:16.88,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:16.88,0:01:18.92,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:18.92,0:01:20.92,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:29.83,0:01:32.35,Default,,0,0,0,,Сәлем, Тони. Оған күмәнім жоқ, бірақ➡
Dialogue: 0,0:01:32.35,0:01:35.52,Default,,0,0,0,,Бұл шынымен робот шабуыл жасаған жер болды ма?
Dialogue: 0,0:01:35.52,0:01:37.51,Default,,0,0,0,,Әлі шабуыл емес.
Dialogue: 0,0:01:37.51,0:01:40.88,Default,,0,0,0,,Детектор жауап берді. Егер ауытқу болса, оны іздеңіз.
Dialogue: 0,0:01:40.88,0:01:43.49,Default,,0,0,0,,Дегенмен, бұл тұзақ болуы мүмкін.
Dialogue: 0,0:01:43.49,0:01:45.50,Default,,0,0,0,,Мен бұл туралы жақсы сөздер естідім.
Dialogue: 0,0:01:45.50,0:01:48.00,Default,,0,0,0,,Оның несі жақсы?
Dialogue: 0,0:01:48.00,0:01:50.02,Default,,0,0,0,,Тониге қауіп төнсе де➡
Dialogue: 0,0:01:50.02,0:01:52.19,Default,,0,0,0,,Көбінесе олар маған ештеңе айтпайды.
Dialogue: 0,0:01:52.19,0:01:55.34,Default,,0,0,0,,Әсіресе Арсенал қатысқан кезде. (Антмен) Арсенал?
Dialogue: 0,0:01:55.34,0:01:57.33,Default,,0,0,0,,Бұл қауіпті нәрсе ме?
Dialogue: 0,0:01:57.33,0:01:59.34,Default,,0,0,0,,Мүмкін мен де білуім керек пе?
Dialogue: 0,0:01:59.34,0:02:03.75,Default,,0,0,0,,Бұл менің әкем жасаған робот. Оны Ultron теріс пайдалануда.
Dialogue: 0,0:02:03.75,0:02:05.67,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:02:05.67,0:02:09.17,Default,,0,0,0,,Арсеналға келгенде ашуланамын.
Dialogue: 0,0:02:09.17,0:02:13.09,Default,,0,0,0,,Эй, мен Ультронның тұзағына талай рет түсіп қалдым.
Dialogue: 0,0:02:13.09,0:02:16.84,Default,,0,0,0,,Кек алушылар қауіпті болса да, қауіп-қатерге қарсы тұруы керек.
Dialogue: 0,0:02:16.84,0:02:20.72,Default,,0,0,0,,Сіз әлі мүше болмасаңыз да, бастық сияқты сөйлемеңіз.
Dialogue: 0,0:02:20.72,0:02:23.02,Default,,0,0,0,,Маған күш-қуатыңды берші... Бұл қоян.
Dialogue: 0,0:02:36.40,0:02:38.43,Default,,0,0,0,,Жер бетінде не болып жатыр?
Dialogue: 0,0:02:38.43,0:02:42.00,Default,,0,0,0,,Мен сені менімен бірге келуіңді сұраймын. Бұл қалқан стиліндегі сәлемдесу ме?
Dialogue: 0,0:02:42.00,0:02:45.36,Default,,0,0,0,,Сіздің шектен шыққан мінезіңіз бұл қалаға қауіп төндіреді.
Dialogue: 0,0:02:45.36,0:02:48.71,Default,,0,0,0,,Бұл қалжың ба? (Халк) Бұл тапсырыс.
Dialogue: 0,0:02:48.71,0:02:52.83,Default,,0,0,0,,Бұл қалқанның бұйрығы болуы керек. Нағыз Халк қайда?
Dialogue: 0,0:02:52.83,0:02:55.18,Default,,0,0,0,,Наташа: Сіз де сенімдісіз бе?
Dialogue: 0,0:02:55.18,0:02:57.15,Default,,0,0,0,,Жеке шабуылдарды доғарыңыз.
Dialogue: 0,0:02:57.15,0:02:59.15,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:02:59.15,0:03:03.09,Default,,0,0,0,,Мен ешқашан S.H.I.E.L.D қамауға алғанын естіген емеспін. егер сіз Кек алушылармен бірге.
Dialogue: 0,0:03:03.09,0:03:05.99,Default,,0,0,0,,Маған әлі мүше емес екенімді айтты.
Dialogue: 0,0:03:05.99,0:03:08.83,Default,,0,0,0,,Мені ұстама, менімен сөйлес.
Dialogue: 0,0:03:08.83,0:03:10.85,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:03:10.85,0:03:12.90,Default,,0,0,0,,Әңгіме ше? Қалжыңдама
Dialogue: 0,0:03:12.90,0:03:16.99,Default,,0,0,0,,Фьюри S.H.I.E.L.D.- ге басқаша әрекет етеді. Бізге ұнамайды, солай ма?
Dialogue: 0,0:03:16.99,0:03:18.99,Default,,0,0,0,,Мен көмектескім келеді
Dialogue: 0,0:03:18.99,0:03:21.51,Default,,0,0,0,,Менің артымнан қазір жүрмесең, бәлеге қаласың.
Dialogue: 0,0:03:21.51,0:03:26.33,Default,,0,0,0,,Сіз бірдеңе таптыңыз ба? Бұл белгісіз импульс, бірақ бұл микро деңгей.
Dialogue: 0,0:03:26.33,0:03:28.33,Default,,0,0,0,,Сонда бұл менің мамандығым.
Dialogue: 0,0:03:28.33,0:03:31.32,Default,,0,0,0,,Мен оған қол ұшын берсем, Тони ренжімей ме?
Dialogue: 0,0:03:31.32,0:03:33.92,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:03:36.49,0:03:39.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:39.66,0:03:41.86,Default,,0,0,0,,ｻﾑ！
Dialogue: 0,0:03:43.85,0:03:47.35,Default,,0,0,0,,Ультрон бұл денені жаңартты
Dialogue: 0,0:03:47.35,0:03:49.85,Default,,0,0,0,,Адамзат аяқталады
Dialogue: 0,0:05:18.84,0:05:21.16,Default,,0,0,0,,Адамзат дәуірі аяқталады
Dialogue: 0,0:05:21.16,0:05:23.86,Default,,0,0,0,,Ультронның жасы жақындап қалды
Dialogue: 0,0:05:28.77,0:05:32.01,Default,,0,0,0,,Сэм Ултронға қарсы күрес! Сіз жеңе аласыз!
Dialogue: 0,0:05:32.01,0:05:35.99,Default,,0,0,0,,Ультронның ақыл-парасатын жеңетін адам жоқ.
Dialogue: 0,0:05:35.99,0:05:38.19,Default,,0,0,0,,Капитан, кет!
Dialogue: 0,0:05:42.15,0:05:44.34,Default,,0,0,0,,Маған тисең, бітті.
Dialogue: 0,0:05:44.34,0:05:47.00,Default,,0,0,0,,Ultron нановирусқа өзгерген сияқты.
Dialogue: 0,0:05:47.00,0:05:51.70,Default,,0,0,0,,Сұңқарды қайтару үшін бізге ақылдырақ тактика керек.
Dialogue: 0,0:05:55.51,0:05:58.17,Default,,0,0,0,,ｿｰ！
Dialogue: 0,0:05:58.17,0:06:01.17,Default,,0,0,0,,Жай шабуыл. Бұл ең жақсы стратегия.
Dialogue: 0,0:06:03.67,0:06:06.32,Default,,0,0,0,,Жоқ, бізге ынтымақтастық қажет.
Dialogue: 0,0:06:06.32,0:06:09.34,Default,,0,0,0,,Халк жесірінің стратегиясы 18 А
Dialogue: 0,0:06:09.34,0:06:12.50,Default,,0,0,0,,Бұл жақсы стратегия. Сіз оны тастай аласыз.
Dialogue: 0,0:06:12.50,0:06:15.00,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:06:20.89,0:06:22.92,Default,,0,0,0,,Менің жолыма кедергі болма.
Dialogue: 0,0:06:22.92,0:06:25.66,Default,,0,0,0,,Айналаңызға көбірек қараңыз
Dialogue: 0,0:06:25.66,0:06:28.66,Default,,0,0,0,,Уау! Халк?
Dialogue: 0,0:06:33.83,0:06:35.83,Default,,0,0,0,,Бір-біріне кедергі жасау
Dialogue: 0,0:06:38.82,0:06:40.83,Default,,0,0,0,,Кім бас тартуы керек?
Dialogue: 0,0:06:40.83,0:06:42.83,Default,,0,0,0,,Жарайды, мұны маған қалдырыңыз.
Dialogue: 0,0:06:42.83,0:06:46.50,Default,,0,0,0,,Жоқ, Сұңқар біздің біріміз. Сіз шегінуіңіз керек.
Dialogue: 0,0:06:46.50,0:06:49.87,Default,,0,0,0,,Сұңқар қай командада болса да дос.
Dialogue: 0,0:06:49.87,0:06:52.87,Default,,0,0,0,,Индивидуализм тиімсіз
Dialogue: 0,0:07:03.15,0:07:05.15,Default,,0,0,0,,Қатайту, байланыстыру және электрлендіру
Dialogue: 0,0:07:05.15,0:07:07.15,Default,,0,0,0,,Бұл тиімді емес пе?
Dialogue: 0,0:07:07.15,0:07:10.65,Default,,0,0,0,,Ультрон дәуірі аяқталды.
Dialogue: 0,0:07:10.65,0:07:13.15,Default,,0,0,0,,Сэм, сен мені естисің бе?
Dialogue: 0,0:07:20.26,0:07:23.33,Default,,0,0,0,,Неге бекер күресуді тоқтатпайсыз?
Dialogue: 0,0:07:23.33,0:07:26.43,Default,,0,0,0,,Сіз мені тоқтата алмайсыз
Dialogue: 0,0:07:32.41,0:07:34.33,Default,,0,0,0,,Сонымен, мен оны сұрадым.
Dialogue: 0,0:07:34.33,0:07:37.13,Default,,0,0,0,,Халк стратегиясы 3 В
Dialogue: 0,0:07:44.34,0:07:46.32,Default,,0,0,0,,Қаланы қиратпа, оны тоқтат.
Dialogue: 0,0:07:46.32,0:07:48.32,Default,,0,0,0,,Бұйрық бойынша.
Dialogue: 0,0:07:54.40,0:07:57.00,Default,,0,0,0,,Неліктен ол жер астына кетті? Өйткені бұл Нью-Йорк
Dialogue: 0,0:07:57.00,0:07:59.90,Default,,0,0,0,,Мен метроға түсемін деп ойлаймын. Барайық.
Dialogue: 0,0:08:07.06,0:08:09.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:09.11,0:08:12.51,Default,,0,0,0,,Шу шығармаңыз, жаңартуды бастаңыз
Dialogue: 0,0:08:15.00,0:08:17.20,Default,,0,0,0,,үшін жүгіреді!
Dialogue: 0,0:08:20.67,0:08:22.66,Default,,0,0,0,,Ультронның интеллектіне қосылу
Dialogue: 0,0:08:22.66,0:08:27.35,Default,,0,0,0,,Ультронның интеллектіне қосылу
Dialogue: 0,0:08:27.35,0:08:30.00,Default,,0,0,0,,Сұңқарлар шайқасы!
Dialogue: 0,0:08:30.00,0:08:32.50,Default,,0,0,0,,Қаш!
Dialogue: 0,0:08:32.50,0:08:35.91,Default,,0,0,0,,Сондықтан мен кірпік сағатын ұнатпаймын.
Dialogue: 0,0:08:35.91,0:08:37.91,Default,,0,0,0,,Шығу жолын күзетіңіз
Dialogue: 0,0:08:47.55,0:08:51.32,Default,,0,0,0,,Ультрон төңкерісі басталып та кетті
Dialogue: 0,0:08:51.32,0:08:54.51,Default,,0,0,0,,Сіз қашан бас тартасыз?
Dialogue: 0,0:08:54.51,0:08:58.86,Default,,0,0,0,,Кек алушылар ешқашан берілмейді!
Dialogue: 0,0:08:58.86,0:09:01.86,Default,,0,0,0,,Сіз жұмыстан кеткен жоқсыз ба? Бұл туралы кейінірек.
Dialogue: 0,0:09:05.17,0:09:07.47,Default,,0,0,0,,Ультронның интеллектіне қосылу
Dialogue: 0,0:09:09.82,0:09:12.68,Default,,0,0,0,,Сен әлсіз роботсың
Dialogue: 0,0:09:12.68,0:09:15.31,Default,,0,0,0,,Әрқайсысы бір таңба. Бұл тең ойын.
Dialogue: 0,0:09:15.31,0:09:18.48,Default,,0,0,0,,О! Жоқ, бұл сіздің жоғалтыңыз.
Dialogue: 0,0:09:18.48,0:09:21.15,Default,,0,0,0,,Капитанның әдістері сізді әлі де тітіркендіреді ме?
Dialogue: 0,0:09:21.15,0:09:23.82,Default,,0,0,0,,Тони сияқты құпия емес.
Dialogue: 0,0:09:23.82,0:09:27.62,Default,,0,0,0,,Тони да жақсарды. Мен сене алар емеспін.
Dialogue: 0,0:09:31.50,0:09:35.32,Default,,0,0,0,,Тони, артқа тұр!
Dialogue: 0,0:09:35.32,0:09:37.67,Default,,0,0,0,,Темір адамның стратегиясы бар.
Dialogue: 0,0:09:37.67,0:09:41.17,Default,,0,0,0,,Бұл мүлдем қате болды. Бұл қауіпті болды.
Dialogue: 0,0:09:41.17,0:09:44.67,Default,,0,0,0,,Тез шегініп, оны қалқанға қалдырыңыз.
Dialogue: 0,0:09:47.83,0:09:49.83,Default,,0,0,0,,Бізді өзіңізбен бірге алып кетуіңіз керек емес пе еді?
Dialogue: 0,0:09:49.83,0:09:53.72,Default,,0,0,0,,Сіз бұйрықтарды елемейсіз.
Dialogue: 0,0:09:53.72,0:09:57.34,Default,,0,0,0,,Жақсы, мен өзім бірдеңе істеймін.
Dialogue: 0,0:09:57.34,0:09:59.97,Default,,0,0,0,,Жағдайға байланысты мінез-құлық өзгеруі мүмкін
Dialogue: 0,0:09:59.97,0:10:02.47,Default,,0,0,0,,Кейде сіз ережені бұзасыз.
Dialogue: 0,0:10:09.50,0:10:13.35,Default,,0,0,0,,Менің нанобөлшектерді қалайсыз ба?
Dialogue: 0,0:10:13.35,0:10:16.85,Default,,0,0,0,,Мен оны саған беремін. Бұл жігіт байқады ма?
Dialogue: 0,0:11:18.84,0:11:23.82,Default,,0,0,0,,Жаңарту кезінде ауыртпалық жоқ. Әрең.
Dialogue: 0,0:11:23.82,0:11:27.12,Default,,0,0,0,,Сіздің рейтингіңізді төмендету өте ауыр!
Dialogue: 0,0:11:33.83,0:11:35.85,Default,,0,0,0,,Сіз Ултронды ұстадыңыз ба?
Dialogue: 0,0:11:35.85,0:11:38.39,Default,,0,0,0,,Бұл әлемдегі ең қауіпті жасанды интеллект.
Dialogue: 0,0:11:38.39,0:11:42.01,Default,,0,0,0,,Бұл хотару емес. Қауіпті деуге де ұқсамайды.
Dialogue: 0,0:11:42.01,0:11:44.33,Default,,0,0,0,,Топтан кеткен адамға сөйлеуге рұқсат бермеңіз.
Dialogue: 0,0:11:44.33,0:11:52.02,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:52.02,0:11:54.22,Default,,0,0,0,,Ультронның интеллектіне қосылу
Dialogue: 0,0:11:57.37,0:12:02.65,Default,,0,0,0,,Нұсқау Ultron желісін кеңейту
Dialogue: 0,0:12:02.65,0:12:04.67,Default,,0,0,0,,Менің командамды бақылаңыз
Dialogue: 0,0:12:04.67,0:12:09.82,Default,,0,0,0,,Роджерс ескі Life Model Decoy Android тапты.
Dialogue: 0,0:12:09.82,0:12:12.16,Default,,0,0,0,,Ультрон ұрлаған? Бұл дұрыс
Dialogue: 0,0:12:12.16,0:12:14.17,Default,,0,0,0,,LMD бүкіл қалаға шабуыл жасауда
Dialogue: 0,0:12:14.17,0:12:17.83,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:12:17.83,0:12:19.83,Default,,0,0,0,,Ультрон барлық жерде дірілдеп жатыр.
Dialogue: 0,0:12:19.83,0:12:21.83,Default,,0,0,0,,Бізге де тарап кету керек
Dialogue: 0,0:12:21.83,0:12:26.47,Default,,0,0,0,,Қазір тым кеш пе? үшін қазірдің өзінде бөлініп кеткен жоқ па?
Dialogue: 0,0:12:26.47,0:12:28.51,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:12:28.51,0:12:32.01,Default,,0,0,0,,Бұл қиындыққа айналды. Қарсы екеніңізге сенімдімін➡
Dialogue: 0,0:12:32.01,0:12:36.15,Default,,0,0,0,,Екі топты араластырған дұрыс. Ол ақыры қайтып келеді деп ойладым.
Dialogue: 0,0:12:36.15,0:12:39.83,Default,,0,0,0,,Біз дуэт боламыз.
Dialogue: 0,0:12:39.83,0:12:44.71,Default,,0,0,0,,Қаншалықты күшті болса да, Хоки Халк бола алмайды.
Dialogue: 0,0:12:44.71,0:12:47.01,Default,,0,0,0,,Эй, мен сені естимін.
Dialogue: 0,0:12:47.01,0:12:49.33,Default,,0,0,0,,Hulk Hawkeye LMD-ді жеңіңіз
Dialogue: 0,0:12:49.33,0:12:52.00,Default,,0,0,0,,Ах, бұл Халк пен Тордың қателігі болды, солай ма?
Dialogue: 0,0:12:52.00,0:12:54.92,Default,,0,0,0,,Капитан айтқандай, өз ойыңызды өзгертіңіз.
Dialogue: 0,0:12:54.92,0:12:59.14,Default,,0,0,0,,Ультрон болған азаматты қамту.
Dialogue: 0,0:12:59.14,0:13:01.16,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:13:01.16,0:13:03.16,Default,,0,0,0,,Сіз Hawkeye-мен бірігіп жатырсыз ба? Мен сені естимін.
Dialogue: 0,0:13:03.16,0:13:07.33,Default,,0,0,0,,Antman Falcon- Ultron вирусын жоюдың жолын табыңыз.
Dialogue: 0,0:13:07.33,0:13:10.18,Default,,0,0,0,,Капитаннан қандай да бір нұсқау бар ма? Сіз шынымен мүшесіз бе?
Dialogue: 0,0:13:10.18,0:13:12.50,Default,,0,0,0,,Тезірек, Антман. Менде Ультронның денесі бар.
Dialogue: 0,0:13:12.50,0:13:14.50,Default,,0,0,0,,Жоқ, мен мұны істеймін.
Dialogue: 0,0:13:14.50,0:13:28.53,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:28.53,0:13:32.19,Default,,0,0,0,,[Монитор] (Қуаныш) Құдай-ау. Ультронды өзіңізбен бірге алып келдіңіз бе?
Dialogue: 0,0:13:32.19,0:13:34.17,Default,,0,0,0,,[Монитор] Бұл қауіпті емес пе!
Dialogue: 0,0:13:34.17,0:13:38.99,Default,,0,0,0,,Аузыңды жап және сканерле, Джо. Сұңқардың кез келген белгісін табыңыз.
Dialogue: 0,0:13:38.99,0:13:41.99,Default,,0,0,0,,Күте тұрыңыз, Сэм. Мен сізге міндетті түрде көмектесемін.
Dialogue: 0,0:13:46.92,0:13:49.49,Default,,0,0,0,,Мен Арсеналды табуға болатын барлық жерлерді іздедім➡
Dialogue: 0,0:13:49.49,0:13:52.99,Default,,0,0,0,,Ультрон жоқ. Ол қайда?
Dialogue: 0,0:13:52.99,0:13:56.56,Default,,0,0,0,,Арсенал туралы ұмытыңыз. Бұл туралы жеткілікті.
Dialogue: 0,0:13:56.56,0:13:59.83,Default,,0,0,0,,Арсенал қолданбай Ultron табыңыз
Dialogue: 0,0:13:59.83,0:14:01.85,Default,,0,0,0,,Мені алда
Dialogue: 0,0:14:01.85,0:14:04.85,Default,,0,0,0,,Ол ең қауіпсіз және ыңғайлы жерде болуы керек.
Dialogue: 0,0:14:09.26,0:14:11.76,Default,,0,0,0,,Бұл өтірік. Ол сол жерде.
Dialogue: 0,0:14:19.65,0:14:22.67,Default,,0,0,0,,Ультрон кілтті өзгертті
Dialogue: 0,0:14:22.67,0:14:25.67,Default,,0,0,0,,Енді мен оны таң қалдыра алмаймын.
Dialogue: 0,0:14:25.67,0:14:28.66,Default,,0,0,0,,Мен сені таң қалдырсам ше? Сіз Ултронды білмейсіз бе?
Dialogue: 0,0:14:28.66,0:14:31.48,Default,,0,0,0,,Старк дұрыс айтады. (2 адам) Уау!
Dialogue: 0,0:14:31.48,0:14:34.33,Default,,0,0,0,,Мен сіздердің қозғалыстарыңызды оқи аламын.
Dialogue: 0,0:14:34.33,0:14:36.52,Default,,0,0,0,,Адамдарды түсіну оңай.
Dialogue: 0,0:14:36.52,0:14:39.99,Default,,0,0,0,,Ультрон бірліктері тамаша үйлесіммен қозғалады
Dialogue: 0,0:14:39.99,0:14:45.84,Default,,0,0,0,,Адамдардың пішіні әртүрлі, ал негізгі бағдарламалық қамтамасыз ету әрқашан жағымсыз.
Dialogue: 0,0:14:45.84,0:14:51.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:51.01,0:14:54.48,Default,,0,0,0,,[TEL]Фьюри Капитан Америка. Олтронның денесін тапты.
Dialogue: 0,0:14:54.48,0:15:00.66,Default,,0,0,0,,Кек алушылар мұнарасына жақын қашықтықтан шабуыл жасаңыз. Бұл жан-жақты соғыс.
Dialogue: 0,0:15:00.66,0:15:02.68,Default,,0,0,0,,Радио ұрланған
Dialogue: 0,0:15:02.68,0:15:06.58,Default,,0,0,0,,Мұнда да солай. Жаман нәрсе болды.
Dialogue: 0,0:15:06.58,0:15:09.08,Default,,0,0,0,,Мен Фьюриді алдауға тырысамын. Неліктен?
Dialogue: 0,0:15:11.50,0:15:14.86,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:15:14.86,0:15:25.68,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:25.68,0:15:28.98,Default,,0,0,0,,Ультрон Трикарияны көздеп отыр
Dialogue: 0,0:15:35.18,0:15:39.01,Default,,0,0,0,,Капитан Эвакуацияға шабуыл жасауға дайын.
Dialogue: 0,0:15:39.01,0:15:41.00,Default,,0,0,0,,Неліктен жауап жоқ?
Dialogue: 0,0:15:41.00,0:15:43.88,Default,,0,0,0,,Хатшы, бұл арнайы жол.
Dialogue: 0,0:15:43.88,0:15:47.38,Default,,0,0,0,,Ашу Бұл тұзақ! Ультронның мақсаты - трикария
Dialogue: 0,0:15:52.34,0:15:54.49,Default,,0,0,0,,Тони, сізде жақсы стратегия бар ма?
Dialogue: 0,0:15:54.49,0:15:58.50,Default,,0,0,0,,Маған тыңдауға рұқсат етіңіз!
Dialogue: 0,0:15:58.50,0:16:04.02,Default,,0,0,0,,Менің жұмбағым қалқан трикариясында аяқталды
Dialogue: 0,0:16:04.02,0:16:09.49,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:09.49,0:16:17.17,Default,,0,0,0,,Ультронның барлау қызметіне қосылу...
Dialogue: 0,0:16:17.17,0:16:20.52,Default,,0,0,0,,тым кеш болды. Қаланы басып алды.
Dialogue: 0,0:16:20.52,0:16:26.93,Default,,0,0,0,,Үш мансапқа дейін! Сізбен тағы да төбелесу керемет болды.
Dialogue: 0,0:16:26.93,0:16:28.93,Default,,0,0,0,,Біз Мисаны екінші Кира болуы мүмкін деген күдікпен қамауға алдық
Dialogue: 0,0:17:31.91,0:17:35.85,Default,,0,0,0,,Егер Ултрон бізді нысанаға алса, жай ғана қарсы тұрыңыз.
Dialogue: 0,0:17:35.85,0:17:38.35,Default,,0,0,0,,Толық қуат!
Dialogue: 0,0:17:47.32,0:17:49.66,Default,,0,0,0,,Бұл жақсы стратегия...
Dialogue: 0,0:17:49.66,0:17:54.35,Default,,0,0,0,,Бронды алып тастау стратегиясы ма?
Dialogue: 0,0:17:54.35,0:17:56.70,Default,,0,0,0,,Оның мылтығы осыған бағытталған.
Dialogue: 0,0:17:56.70,0:18:00.70,Default,,0,0,0,,Мен қолымнан келгенше атамын, жіберіп алмаңыз!
Dialogue: 0,0:18:03.01,0:18:07.16,Default,,0,0,0,,[Сөйлеуші] Мақсатты табу
Dialogue: 0,0:18:07.16,0:18:10.36,Default,,0,0,0,,Сіз тағы да осылай ұша алатыныңызға қуанышты болуыңыз керек.
Dialogue: 0,0:18:14.55,0:18:16.55,Default,,0,0,0,,Зиянкес!
Dialogue: 0,0:18:19.66,0:18:21.66,Default,,0,0,0,,Қорғаныстарыңызды босатыңыз!
Dialogue: 0,0:18:24.69,0:18:26.89,Default,,0,0,0,,Мен директормен сөйлесуім керек.
Dialogue: 0,0:18:29.98,0:18:32.00,Default,,0,0,0,,Артқы жағында бос орын бар ма?
Dialogue: 0,0:18:32.00,0:18:35.16,Default,,0,0,0,,Сегізінші сурет сағат 3 бағытынан бұрылу
Dialogue: 0,0:18:35.16,0:18:37.66,Default,,0,0,0,,Сіз мейірімді серіксіз жалғыз болған шығарсыз, солай ма?
Dialogue: 0,0:18:37.66,0:18:42.16,Default,,0,0,0,,Халық та ол жерде болмады. Ха!
Dialogue: 0,0:18:42.16,0:18:44.60,Default,,0,0,0,,Сіз де дәл осылай ойлайсыз ба?
Dialogue: 0,0:18:44.60,0:18:46.60,Default,,0,0,0,,Жарайды, келіңіз.
Dialogue: 0,0:18:54.32,0:19:03.87,Default,,0,0,0,,Ｈﾀﾞｯｼｭ ＣＬﾀﾞｯｼｭ ＮＡﾀﾞｯｼｭ Ｈ
Dialogue: 0,0:19:03.87,0:19:07.17,Default,,0,0,0,,[Монитор] (Қуаныш) Не айтып тұрсың, мына жігіт?
Dialogue: 0,0:19:07.17,0:19:09.66,Default,,0,0,0,,Бұл антибиотиктің химиялық формуласы.
Dialogue: 0,0:19:09.66,0:19:11.68,Default,,0,0,0,,[Монитор] А, мен мұны білдім.
Dialogue: 0,0:19:11.68,0:19:14.18,Default,,0,0,0,,Мен мұны істей аламын деп ойлаймын. Сәттілік Сэм.
Dialogue: 0,0:19:18.17,0:19:20.48,Default,,0,0,0,,Мен бұл кемені апатқа ұшыратамын ба?
Dialogue: 0,0:19:20.48,0:19:23.15,Default,,0,0,0,,Оның жағдайы жақсы. Ол деректер.
Dialogue: 0,0:19:23.15,0:19:26.82,Default,,0,0,0,,Жалғыз жол - вирусты жою, содан кейін Ultron-ның өзін жою.
Dialogue: 0,0:19:26.82,0:19:31.18,Default,,0,0,0,,Басқаша айтқанда, біз Арсеналдан да айырыламыз. Мәңгі.
Dialogue: 0,0:19:31.18,0:19:34.33,Default,,0,0,0,,Енді сіз осында болсаңыз да, сіз Арсенал туралы ойлайсыз ба?
Dialogue: 0,0:19:34.33,0:19:38.00,Default,,0,0,0,,Сіз түсінбейсіз. Бұл әкемнің шедеврі.
Dialogue: 0,0:19:38.00,0:19:40.34,Default,,0,0,0,,Түсінбейтін сенсің.
Dialogue: 0,0:19:40.34,0:19:42.86,Default,,0,0,0,,Говардтың ең ұлы шедеврі - Арсенал емес
Dialogue: 0,0:19:42.86,0:19:44.88,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:19:44.88,0:19:47.48,Default,,0,0,0,,Үміттерді ақтау
Dialogue: 0,0:19:56.17,0:19:58.84,Default,,0,0,0,,[Монитор] (Қуаныш) Бір минут күтіңіз. Гохо...
Dialogue: 0,0:19:58.84,0:20:01.83,Default,,0,0,0,,[Монитор] Ең алдымен... оны сынап көрген дұрыс емес пе?
Dialogue: 0,0:20:01.83,0:20:04.48,Default,,0,0,0,,Бұл мағынасы бар, бірақ менің уақытым жоқ.
Dialogue: 0,0:20:04.48,0:20:06.48,Default,,0,0,0,,Сұңқарға сеніңіз
Dialogue: 0,0:20:10.85,0:20:12.89,Default,,0,0,0,,Сэм! Кими - гений!!
Dialogue: 0,0:20:12.89,0:20:16.51,Default,,0,0,0,,Жоқ... өйткені сіз химиялық формуланы түсіндіңіз...
Dialogue: 0,0:20:16.51,0:20:19.16,Default,,0,0,0,,Ұйқыға кетіңіз. Келесі дәріні енгізіңіз.
Dialogue: 0,0:20:19.16,0:20:22.18,Default,,0,0,0,,Мен әлі де Ultron-ға қосылғанмын
Dialogue: 0,0:20:22.18,0:20:26.48,Default,,0,0,0,,Бірақ менде де өз еркімнің күші бар. Мен Фьюриге айтуым керек...
Dialogue: 0,0:20:28.59,0:20:30.82,Default,,0,0,0,,Ультронды жеңудің жолы бар
Dialogue: 0,0:20:30.82,0:20:34.49,Default,,0,0,0,,Енді мен әрбір көшірмені негізгі құрылғыға мәжбүрлей аламын.
Dialogue: 0,0:20:34.49,0:20:38.16,Default,,0,0,0,,Бұл ұзаққа созылмайды. Оны бірнеше секундта жойыңыз.
Dialogue: 0,0:20:38.16,0:20:42.17,Default,,0,0,0,,Тони Ультронды қалай жеңетінін білмеймін→
Dialogue: 0,0:20:42.17,0:20:44.58,Default,,0,0,0,,Сіз көп нәрсе туралы ойлануыңыз керек, солай ма?
Dialogue: 0,0:20:44.58,0:20:49.82,Default,,0,0,0,,Шын мәнінде, бір ғана. Бұл қауіпті емес пе? Сондықтан командадан кеттіңдер.
Dialogue: 0,0:20:49.82,0:20:53.21,Default,,0,0,0,,Осылайша сіз әлемді құтқара аласыз, солай ма? Айтыңызшы
Dialogue: 0,0:20:53.21,0:20:56.83,Default,,0,0,0,,Жарайды. Ултронның Трикарияны қалайтынының себебі →
Dialogue: 0,0:20:56.83,0:20:59.83,Default,,0,0,0,,Спутникті толықтай қаруландыру
Dialogue: 0,0:20:59.83,0:21:04.49,Default,,0,0,0,,Басқаша айтқанда, мақсат - Астрокария, Трикарияға тиелген ғарыш кемесі.
Dialogue: 0,0:21:04.49,0:21:07.16,Default,,0,0,0,,Сонымен? Мен оны қалай жеңемін?
Dialogue: 0,0:21:07.16,0:21:10.16,Default,,0,0,0,,Мен саған астрохария беремін
Dialogue: 0,0:21:10.16,0:21:13.18,Default,,0,0,0,,Сен оны жеммен алмақсың ба? Осыдан кейін не болады?
Dialogue: 0,0:21:13.18,0:21:16.83,Default,,0,0,0,,Уау... Мен бүкіл кемені күнге лақтырамын.
Dialogue: 0,0:21:16.83,0:21:19.15,Default,,0,0,0,,Мен сәтсіз болсам ше?
Dialogue: 0,0:21:19.15,0:21:22.99,Default,,0,0,0,,Жер жойылады. Бұл тым қауіпті.
Dialogue: 0,0:21:22.99,0:21:26.18,Default,,0,0,0,,Әлемді құтқару үшін үлкен тәуекелге барыңыз
Dialogue: 0,0:21:26.18,0:21:29.18,Default,,0,0,0,,Тони жыл бойы осылай істейді.
Dialogue: 0,0:21:29.18,0:21:32.48,Default,,0,0,0,,Сондықтан мен «Кек алушылардың» жетекшісімін.
Dialogue: 0,0:21:34.60,0:21:36.60,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:21:41.49,0:21:43.51,Default,,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:21:43.51,0:21:46.36,Default,,0,0,0,,Мен түсіндім. Капитан, сұраңыз.
Dialogue: 0,0:21:46.36,0:21:50.66,Default,,0,0,0,,Маған қалдырыңыз. Эй, аздап уайымдап көрінуге тырыс.
Dialogue: 0,0:21:54.32,0:21:58.84,Default,,0,0,0,,Бұл бір жақты билет екенін түсінесіз бе? ол қайтып келе алмайды
Dialogue: 0,0:21:58.84,0:22:00.84,Default,,0,0,0,,Хмм…
Dialogue: 0,0:22:12.39,0:22:14.69,Default,,0,0,0,,ｽﾀｰｸ…
Dialogue: 0,0:22:23.83,0:22:25.85,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:22:25.85,0:22:28.85,Default,,0,0,0,,Бұл менің күнге бірінші рет саяхаттауым. хмм...
Dialogue: 0,0:22:31.31,0:22:33.83,Default,,0,0,0,,Уф! Ой... аа...
Dialogue: 0,0:22:33.83,0:22:37.83,Default,,0,0,0,,Адамдар сияқты бұл стратегия да сәтсіздікке ұшырайды.
Dialogue: 0,0:22:37.83,0:22:39.85,Default,,0,0,0,,Аһ!
Dialogue: 0,0:22:39.85,0:22:44.42,Default,,0,0,0,,Адамгершілік сәтсіздік пе? бұл рас па? Бұл интернеттен алынған жалған ақпарат емес пе?
Dialogue: 0,0:22:44.42,0:22:46.72,Default,,0,0,0,,[Спикер] Жұлдызаралық жылдамдықты енгізу
Dialogue: 0,0:22:53.66,0:22:58.10,Default,,0,0,0,,Сіз мені жеңуге тырысасыз ба? Бұл ақымақ Старк
Dialogue: 0,0:22:58.10,0:23:01.50,Default,,0,0,0,,Мен мыңдардың бір ғана бірлігімін
Dialogue: 0,0:23:01.50,0:23:06.49,Default,,0,0,0,,Адамдардан айырмашылығы, біз біртұтас үйлесімді интеллектпіз.
Dialogue: 0,0:23:06.49,0:23:09.91,Default,,0,0,0,,Гармония? Гармония бірдейлікті білдірмейді
Dialogue: 0,0:23:09.91,0:23:11.83,Default,,0,0,0,,[Баяндамашы] Меркурий орбитасында...
Dialogue: 0,0:23:11.83,0:23:14.50,Default,,0,0,0,,Бұл бірге жұмыс істеу туралы. басқа сізсіз.→
Dialogue: 0,0:23:14.50,0:23:17.49,Default,,0,0,0,,Бұл адамзаттың ең күшті қаруы екенін білмейсің бе?
Dialogue: 0,0:23:17.49,0:23:19.49,Default,,0,0,0,,ﾌｧﾙｺﾝ!!
Dialogue: 0,0:23:19.49,0:23:23.49,Default,,0,0,0,,Барлық Ultron бірліктерін тасымалдады.
Dialogue: 0,0:23:32.57,0:23:37.16,Default,,0,0,0,,Бағдарламалық құралдың барлық көшірмелері осы құрылғыға қайтарылады.
Dialogue: 0,0:23:37.16,0:23:41.18,Default,,0,0,0,,Сіз не істедіңіз? Бұл қондырғыны Жерге қайтару керек.
Dialogue: 0,0:23:41.18,0:23:43.83,Default,,0,0,0,,Мен мұны істеуге рұқсат етемін деп ойлайсыз ба?
Dialogue: 0,0:23:43.83,0:23:46.83,Default,,0,0,0,,[Спикер] температурасының көтерілуі. Қауіпті.
Dialogue: 0,0:23:48.84,0:23:53.66,Default,,0,0,0,,Сол қарабайыр ақымақтар үшін өзіңді құрбан етесің бе?
Dialogue: 0,0:23:53.66,0:23:55.96,Default,,0,0,0,,Мен әкемнің мені мақтағанын қалаймын.
Dialogue: 0,0:24:04.58,0:24:08.84,Default,,0,0,0,,ﾊﾞｯｸｸﾞﾗｳﾝﾄﾞｿﾌﾄｳｪｱ･ｵｰﾊﾞｰﾗｲﾄﾞ
Dialogue: 0,0:24:08.84,0:24:12.49,Default,,0,0,0,,Сәлем Тони. Сізбен соңғы рет кездескеніме қуаныштымын.
Dialogue: 0,0:24:12.49,0:24:14.49,Default,,0,0,0,,ｱｰｾﾅﾙ？
Dialogue: 0,0:24:14.49,0:24:17.50,Default,,0,0,0,,Менің міндетім - сені қорғау
Dialogue: 0,0:24:17.50,0:24:21.92,Default,,0,0,0,,Сенің әкең екеуміздің қалауымыз осы.
Dialogue: 0,0:24:21.92,0:24:25.52,Default,,0,0,0,,Қош бол Тони. Менің досым.
Dialogue: 0,0:24:27.84,0:24:30.34,Default,,0,0,0,,Арсенал!! Күте тұрыңыз!
Dialogue: 0,0:24:32.33,0:24:34.33,Default,,0,0,0,,Не?
Dialogue: 0,0:24:34.33,0:24:38.43,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:24:40.50,0:24:44.17,Default,,0,0,0,,Қош бол Арсенал... Рахмет, әке.
Dialogue: 0,0:24:44.17,0:24:46.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:48.53,0:24:51.03,Default,,0,0,0,,Ой, бұл жаман.
Dialogue: 0,0:24:54.83,0:24:58.84,Default,,0,0,0,,Кек алушылар. Сізбен және басқалармен бірге күресе алғаныма қуаныштымын.
Dialogue: 0,0:24:58.84,0:25:02.51,Default,,0,0,0,,Болған барлық жағдайға қарамастан, бұл менің өмірімдегі ең жақсы уақыт болды.
Dialogue: 0,0:25:02.51,0:25:06.41,Default,,0,0,0,,Бұл хабар келгенше мен жоқ боламын.
Dialogue: 0,0:25:13.84,0:25:15.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:24.83,0:25:28.33,Default,,0,0,0,,Әй... бұлай істеуді доғарайық.
Dialogue: 0,0:25:28.33,0:25:31.43,Default,,0,0,0,,Бұлардың ешқайсысы. (Сондықтан) кешіріңіз.
Dialogue: 0,0:25:35.93,0:25:38.81,Default,,0,0,0,,Фьюри Кими қайтып орала алмайды деп ойлады.
Dialogue: 0,0:25:38.81,0:25:41.85,Default,,0,0,0,,Сондықтан мен оны командаға жібермеймін.
Dialogue: 0,0:25:41.85,0:25:44.83,Default,,0,0,0,,Сондықтан мен оның қалқанын тастадым.
Dialogue: 0,0:25:44.83,0:25:47.33,Default,,0,0,0,,Кек алушылар. (2 адам) қайта қосылды.
Dialogue: 0,0:25:49.49,0:25:51.49,Default,,0,0,0,,Сен де, Антоман
Dialogue: 0,0:25:51.49,0:25:53.49,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:25:53.49,0:25:55.50,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:25:55.50,0:25:58.15,Default,,0,0,0,,Сабыр ет, Хоки. Біздің айырмашылығымыз - біздің күшіміз.
Dialogue: 0,0:25:58.15,0:26:00.50,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:26:00.50,0:26:02.90,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:26:36.17,0:26:38.66,Default,,0,0,0,,<«Кек алушылар жиналады» фильмінде пайда болатын суперқаһармандар және басқалар➡
Dialogue: 0,0:26:38.66,0:26:42.06,Default,,0,0,0,,Зұлым және т.б. туралы ақпарат осында жинақталған
Dialogue: 0,0:26:42.06,0:26:44.16,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:44.16,0:26:46.16,Default,,0,0,0,,Керемет агенттерден құралған→
Dialogue: 0,0:26:46.16,0:26:48.82,Default,,0,0,0,,Әлемдегі бейбітшілікті сақтауға ұмтылатын халықаралық барлау ұйымы
Dialogue: 0,0:26:48.82,0:26:51.48,Default,,0,0,0,,Трикария ұшатын авиатасымалдаушы → негізінде
Dialogue: 0,0:26:51.48,0:26:53.84,Default,,0,0,0,,Әлемді аспаннан бақылаңыз
Dialogue: 0,0:26:53.84,0:26:56.51,Default,,0,0,0,,Көшбасшы Ник Фюрри және кек алушылар →
Dialogue: 0,0:26:56.51,0:26:58.49,Default,,0,0,0,,Біз келіспеуіміз мүмкін →
Dialogue: 0,0:26:58.49,0:27:00.89,Default,,0,0,0,,Жерді қорғау мақсатында ынтымақтасу＞
Dialogue: 0,0:27:02.39,0:27:08.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
