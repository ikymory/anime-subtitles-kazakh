Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.82,0:00:41.12,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.70,0:00:47.72,Default,,0,0,0,,<Кек алушылар, бұл супер қаһармандар➡
Dialogue: 0,0:00:47.72,0:00:50.32,Default,,0,0,0,,Жиналған ең күшті батырлар командасы
Dialogue: 0,0:00:50.32,0:00:52.32,Default,,0,0,0,,Өзіңіздің трансценденттік күшіңізді жинаңыз➡
Dialogue: 0,0:00:52.32,0:00:54.32,Default,,0,0,0,,Жер бетіндегі бейбітшілікті қорға! ＞
Dialogue: 0,0:00:54.32,0:00:56.66,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.66,0:00:58.83,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:58.83,0:01:01.30,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.30,0:01:03.32,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.32,0:01:05.32,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.32,0:01:07.32,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.32,0:01:11.82,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.82,0:01:14.81,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.81,0:01:16.85,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:16.85,0:01:18.86,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:18.86,0:01:21.67,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:21.67,0:01:28.57,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:28.57,0:01:32.31,Default,,0,0,0,,Роксомен қақпасы Аномалия жоқ
Dialogue: 0,0:01:32.31,0:01:34.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:34.81,0:01:36.83,Default,,0,0,0,,Уау!!
Dialogue: 0,0:01:36.83,0:01:39.13,Default,,0,0,0,,Көрінудің нашарлығы Сақтықты төмендетпеңіз!
Dialogue: 0,0:01:44.16,0:01:46.86,Default,,0,0,0,,Бұл... Халк!?
Dialogue: 0,0:01:49.14,0:01:51.14,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:01:53.83,0:01:57.82,Default,,0,0,0,,Қалқанды жау қылмақшысың ба!? Ұнамаса, тоқтаңыз!
Dialogue: 0,0:01:57.82,0:02:00.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:05.18,0:02:08.83,Default,,0,0,0,,Роксоннан ұрлық жасау ақылға қонымды ма?
Dialogue: 0,0:02:08.83,0:02:12.68,Default,,0,0,0,,Stark Tech сапасы жоғарырақ.
Dialogue: 0,0:02:12.68,0:02:15.72,Default,,0,0,0,,Бұл адаптоид өте қорқынышты➡
Dialogue: 0,0:02:15.72,0:02:18.51,Default,,0,0,0,,Модок оны басқаратын сияқты емес.
Dialogue: 0,0:02:18.51,0:02:20.66,Default,,0,0,0,,Иә, анау үлкен сәби➡
Dialogue: 0,0:02:20.66,0:02:23.86,Default,,0,0,0,,Бұлай қозғалмау керек! Апыр-ай!
Dialogue: 0,0:02:27.17,0:02:30.47,Default,,0,0,0,,Сіздей машина жеңетін күн ешқашан келмейді!
Dialogue: 0,0:02:32.49,0:02:34.89,Default,,0,0,0,,Эй, күте тұрыңыз
Dialogue: 0,0:02:38.03,0:02:40.88,Default,,0,0,0,,Күресудің басқа жолдары бар ма? Сіздің трусиктеріңіз➡
Dialogue: 0,0:02:40.88,0:02:44.17,Default,,0,0,0,,Мүлдем жұмыс істемейді
Dialogue: 0,0:02:44.17,0:02:47.84,Default,,0,0,0,,Менің соққым қандай?
Dialogue: 0,0:02:47.84,0:02:50.66,Default,,0,0,0,,Сізге көп рахмет. Эй!
Dialogue: 0,0:02:50.66,0:02:55.16,Default,,0,0,0,,Мм... бұл мен бірінші рет. Апыр-ай!
Dialogue: 0,0:02:57.48,0:03:01.65,Default,,0,0,0,,Осыған да еліктей аласыз ба? Робот!
Dialogue: 0,0:03:01.65,0:03:04.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:04.82,0:03:08.62,Default,,0,0,0,,Ах! Falcon!! Маған қалдырыңыз!
Dialogue: 0,0:03:17.97,0:03:20.47,Default,,0,0,0,,Мен қарсыласпын
Dialogue: 0,0:03:20.47,0:03:24.49,Default,,0,0,0,,Мұнда келме! Апыр-ай!!
Dialogue: 0,0:03:24.49,0:03:27.49,Default,,0,0,0,,Мұндай дағдыларды қайдан үйрендің? (Қара/Жесір) Біздің күшіміз үшін➡
Dialogue: 0,0:03:27.49,0:03:30.48,Default,,0,0,0,,Мен оған қарсы тұра алатын сияқтымын.
Dialogue: 0,0:03:30.48,0:03:33.68,Default,,0,0,0,,Біздің күшіміз үшін емес...
Dialogue: 0,0:03:33.68,0:03:35.65,Default,,0,0,0,,≪(Өрмекші адам) Кешті сіз бірінші бастадыңыз ба?
Dialogue: 0,0:03:35.65,0:03:38.07,Default,,0,0,0,,Бұл өтірік... ≪(Өрмекші адам) Бұл рас!
Dialogue: 0,0:03:38.07,0:03:41.64,Default,,0,0,0,,үшін, енді уайымдама! Өрмекші адамның соққысымен➡
Dialogue: 0,0:03:41.64,0:03:44.81,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:03:44.81,0:03:46.85,Default,,0,0,0,,Мені шақырғаныңызға рахмет.
Dialogue: 0,0:03:46.85,0:03:49.85,Default,,0,0,0,,Қараңызшы... капитан жоқ еді, мен оны шақырдым.
Dialogue: 0,0:05:11.88,0:05:14.50,Default,,0,0,0,,Сіз Өрмекші-адамға осында қоңырау шалуға қалай батылсыз➡
Dialogue: 0,0:05:14.50,0:05:18.82,Default,,0,0,0,,Не болды, Тони? Есіңіз дұрыс па? Не болды?
Dialogue: 0,0:05:18.82,0:05:22.17,Default,,0,0,0,,Егер сол Тони Старк сізге қоңырау шалса, кез келген адам...
Dialogue: 0,0:05:22.17,0:05:24.19,Default,,0,0,0,,Жат! Апыр-ай!
Dialogue: 0,0:05:24.19,0:05:26.31,Default,,0,0,0,,Сізді жарып жібергіңіз келе ме!?
Dialogue: 0,0:05:26.31,0:05:29.31,Default,,0,0,0,,Мен өз әрекеттерімді жазып отырдым. Мен мұны әрқашан жасаймын.
Dialogue: 0,0:05:29.31,0:05:31.98,Default,,0,0,0,,Бірақ бұл соңғы болуы мүмкін!
Dialogue: 0,0:05:31.98,0:05:41.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:41.34,0:05:44.18,Default,,0,0,0,,Уау! Әй, Темір адам➡
Dialogue: 0,0:05:44.18,0:05:46.82,Default,,0,0,0,,Мен бұл паук басының Капитан Американы алмастыратынына сене алмаймын➡
Dialogue: 0,0:05:46.82,0:05:49.32,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:05:51.82,0:05:54.32,Default,,0,0,0,,Әй, мен капитанды ауыстырамын дедің бе?
Dialogue: 0,0:05:59.14,0:06:01.33,Default,,0,0,0,,Капитан ше? Қайда бардың?
Dialogue: 0,0:06:01.33,0:06:04.68,Default,,0,0,0,,Ол Ултронды қуып келе жатқан шығар. Бір минут күтіңіз!
Dialogue: 0,0:06:04.68,0:06:07.99,Default,,0,0,0,,Ултрон қайтып келді ме? Неге маған ешкім айтпайды!?
Dialogue: 0,0:06:07.99,0:06:11.01,Default,,0,0,0,,Сіз жаңа ғана айттыңыз. Бірақ капитанға қиналса керек.
Dialogue: 0,0:06:11.01,0:06:13.99,Default,,0,0,0,,Өйткені Ultron осында. Аа!?
Dialogue: 0,0:06:13.99,0:06:16.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:19.16,0:06:22.86,Default,,0,0,0,,Сіз мені ақыры байқаған сияқтысыз, Старк.
Dialogue: 0,0:06:25.65,0:06:30.49,Default,,0,0,0,,(Ескерту)
Dialogue: 0,0:06:30.49,0:06:33.39,Default,,0,0,0,,Жақында түсу нүктесі
Dialogue: 0,0:06:37.17,0:06:39.48,Default,,0,0,0,,Мақсатты растау
Dialogue: 0,0:06:39.48,0:06:44.38,Default,,0,0,0,,Біз асығамыз. 5 минут күтіңіз, егер сізге нұсқау келмесе, келіңіз.
Dialogue: 0,0:06:47.14,0:06:50.00,Default,,0,0,0,,Бұл «Кек алушылар» фильмінің соңы.
Dialogue: 0,0:06:50.00,0:06:53.15,Default,,0,0,0,,Менде капитанның қалқаны дәл қазір осында болғанын қалаймын.
Dialogue: 0,0:06:53.15,0:06:58.55,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:58.55,0:07:01.32,Default,,0,0,0,,Капитан! Сіз оралдыңыз ба?
Dialogue: 0,0:07:01.32,0:07:05.83,Default,,0,0,0,,Мен қайтып оралмадым. Шилд Роксонның мүлкін қорғауға келді.
Dialogue: 0,0:07:05.83,0:07:08.43,Default,,0,0,0,,Капитан Артыңызға қараңыз!
Dialogue: 0,0:07:10.63,0:07:13.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:13.15,0:07:16.50,Default,,0,0,0,,Сіз Ультронның Adaptoid-ді басып алғанын білесіз!
Dialogue: 0,0:07:16.50,0:07:18.82,Default,,0,0,0,,Әрине, мен білдім! Әрине➡
Dialogue: 0,0:07:18.82,0:07:22.68,Default,,0,0,0,,Біліп, үндемедің бе!? Ултрон әлемді жаулап алуды жоспарлап отыр➡
Dialogue: 0,0:07:22.68,0:07:25.21,Default,,0,0,0,,Мен олар Roxone технологиясын нысанаға алады деп ойладым.
Dialogue: 0,0:07:25.21,0:07:28.00,Default,,0,0,0,,Мен әскер құруды жоспарлап отырмын. Осындай бірдеңе➡
Dialogue: 0,0:07:28.00,0:07:30.84,Default,,0,0,0,,Сонда менсіз операцияны бастадыңыз ба?
Dialogue: 0,0:07:30.84,0:07:33.84,Default,,0,0,0,,Ал, көшбасшы ретінде бұл туралы не ойлайсың?
Dialogue: 0,0:07:37.81,0:07:40.33,Default,,0,0,0,,Маған сол жерден көмектесе алсаңыз, көмектесіңіз!
Dialogue: 0,0:07:40.33,0:07:46.47,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:46.47,0:07:48.99,Default,,0,0,0,,Халк Тор, шығарманы киіңіз.
Dialogue: 0,0:07:48.99,0:07:54.49,Default,,0,0,0,,Мен мәселені шешемін! (Халк) Мен тазалауды жек көремін!
Dialogue: 0,0:07:54.49,0:07:58.91,Default,,0,0,0,,Алдыңда өлім тұрғанда да, қалжыңдап күшті болуға тырысу ақымақтық➡
Dialogue: 0,0:07:58.91,0:08:01.15,Default,,0,0,0,,Оны адамзат деп атау керек пе?
Dialogue: 0,0:08:01.15,0:08:04.65,Default,,0,0,0,,Уау!!
Dialogue: 0,0:08:08.32,0:08:10.83,Default,,0,0,0,,Капитаннан парашют күшіне дейін Түсу тоқтатылды.
Dialogue: 0,0:08:10.83,0:08:12.84,Default,,0,0,0,,Қайталанатын түсіру тоқтатылды!
Dialogue: 0,0:08:12.84,0:08:14.84,Default,,0,0,0,,Мен сізді командаға қайта оралғыңыз келгендіктен жылайтын шығар деп ойладым.
Dialogue: 0,0:08:16.82,0:08:20.49,Default,,0,0,0,,Сіз мені қалжыңдап тұрсыз ба?
Dialogue: 0,0:08:20.49,0:08:24.34,Default,,0,0,0,,Көшбасшы ретінде әрекет етпесең, маңызды нәрсені жоғалтасың!
Dialogue: 0,0:08:24.34,0:08:27.98,Default,,0,0,0,,Капитан «Кек алушылар» фильмінде болғаннан да ашулы емес пе?
Dialogue: 0,0:08:27.98,0:08:30.91,Default,,0,0,0,,Менен тағы бірдеңе жасырсаң, одан бетер ашуланамын!
Dialogue: 0,0:08:30.91,0:08:35.63,Default,,0,0,0,,Бұл команда, түсіндің бе? Сонда сіз капитан жағындасыз.
Dialogue: 0,0:08:35.63,0:08:38.00,Default,,0,0,0,,Мен оң жақтамын!
Dialogue: 0,0:08:38.00,0:08:41.56,Default,,0,0,0,,Көшбасшыға өз пікірін білдіргісі келетін басқа біреу бар ма?
Dialogue: 0,0:08:41.56,0:08:45.31,Default,,0,0,0,,Жарайды...Мен де батырлар тобына кіремін➡
Dialogue: 0,0:08:45.31,0:08:48.00,Default,,0,0,0,,Өйткені бәріміз әлі жасөспірімміз➡
Dialogue: 0,0:08:48.00,0:08:52.00,Default,,0,0,0,,Олар кейде төбелеседі, бірақ Кек алушылар әлдеқайда байсалдырақ көрінеді.
Dialogue: 0,0:08:54.39,0:08:56.65,Default,,0,0,0,,Егер бұл орын алса, менде бұл әдісті қолданудан басқа амалым жоқ.
Dialogue: 0,0:08:56.65,0:09:01.23,Default,,0,0,0,,Бұл құпия қару. Құпия қару? Маған пайдалануға рұқсат бересіз бе?
Dialogue: 0,0:09:01.23,0:09:04.15,Default,,0,0,0,,)
Dialogue: 0,0:09:04.15,0:09:06.15,Default,,0,0,0,,Ей, бұл менің өмірлік өтінішім!
Dialogue: 0,0:09:06.15,0:09:08.17,Default,,0,0,0,,Уау! Құпия қару сенсің
Dialogue: 0,0:09:08.17,0:09:10.67,Default,,0,0,0,,Не? Неліктен? Өйткені сіз кек алушылар емессіз➡
Dialogue: 0,0:09:10.67,0:09:12.67,Default,,0,0,0,,Ол сенің күшіңді білмейді!
Dialogue: 0,0:09:14.71,0:09:17.48,Default,,0,0,0,,Сәлеметсіз бе, Темір адам келе жатыр.
Dialogue: 0,0:09:17.48,0:09:20.16,Default,,0,0,0,,Жою. Апыр-ай!
Dialogue: 0,0:09:20.16,0:09:22.16,Default,,0,0,0,,Бұлай достасуға болмайды.
Dialogue: 0,0:09:22.16,0:09:24.15,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен оны өрмекші жіппен шеңберлерге орап аламын!
Dialogue: 0,0:09:24.15,0:09:26.15,Default,,0,0,0,,Мұны да алыңыз!
Dialogue: 0,0:09:28.14,0:09:30.66,Default,,0,0,0,,Жақсы жұмыс. Мені мақтады!
Dialogue: 0,0:09:30.66,0:09:32.82,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:09:32.82,0:09:36.31,Default,,0,0,0,,Ultron тоқтатылған кезде, оның ұрламақ болған технологиясын зерттеп көрейік.
Dialogue: 0,0:09:36.31,0:09:38.31,Default,,0,0,0,,ｿｰ
Dialogue: 0,0:09:38.31,0:09:40.83,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:40.83,0:09:44.83,Default,,0,0,0,,Одиннің ұлы да әдемі көрінуді біледі!
Dialogue: 0,0:09:47.14,0:09:49.16,Default,,0,0,0,,Химиялық қойма?
Dialogue: 0,0:09:49.16,0:09:52.31,Default,,0,0,0,,Ультронның мақсаты – робот. Бұл үлкен эксперименттік құрал болмауы керек.
Dialogue: 0,0:09:52.31,0:09:55.15,Default,,0,0,0,,Мүмкін ол эксперименттік құралдарды тәжірибе жүзінде қолданады.
Dialogue: 0,0:09:55.15,0:09:57.48,Default,,0,0,0,,Сіз қалай ойлайсыз? Қазір жақсы емес пе?
Dialogue: 0,0:09:57.48,0:10:00.82,Default,,0,0,0,,Ол Өрмекші адамға ұқсай бастады. Уау...
Dialogue: 0,0:10:00.82,0:10:02.84,Default,,0,0,0,,Роботтар бар ма?
Dialogue: 0,0:10:02.84,0:10:06.89,Default,,0,0,0,,Сканерлеу. Бұл мекемеде роботтар жоқ.
Dialogue: 0,0:10:06.89,0:10:10.83,Default,,0,0,0,,Алайда жоғарыдан бірнеше робот жақындап келеді.
Dialogue: 0,0:10:10.83,0:10:13.00,Default,,0,0,0,,Бірнеше роботтар?
Dialogue: 0,0:10:13.00,0:10:15.85,Default,,0,0,0,,Бұл Ультронның тұзағы! үшін, сақ болыңдар!
Dialogue: 0,0:10:15.85,0:10:17.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:21.42,0:10:25.51,Default,,0,0,0,,Капитаннан десантшыға дейін! Мақсатты жеңгеннен кейін тазалаңыз!
Dialogue: 0,0:10:25.51,0:10:29.21,Default,,0,0,0,,Мен капитанның байланыс құралын ұрлап алдым.
Dialogue: 0,0:10:33.84,0:10:38.49,Default,,0,0,0,,Рахмет, мен дәл осыны қалаймын.
Dialogue: 0,0:10:38.49,0:10:41.19,Default,,0,0,0,,Бұл жаман... Бұл мүмкін бе?
Dialogue: 0,0:10:48.00,0:10:52.49,Default,,0,0,0,,LMD қалқанында ол Life Model Decoy деп те ауру.
Dialogue: 0,0:10:52.49,0:10:56.34,Default,,0,0,0,,Күш – робот болу. Әлсіздік те робот болу.
Dialogue: 0,0:10:56.34,0:11:01.44,Default,,0,0,0,,Сонымен... уһ, кешіріңіз, бұл түсіндіретін уақыт емес.
Dialogue: 0,0:11:05.83,0:11:09.83,Default,,0,0,0,,LMD-ді Ултронға бердім деп мені кім айыптады?
Dialogue: 0,0:12:11.83,0:12:13.84,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:13.84,0:12:17.84,Default,,0,0,0,,Кек алушыларға рахмет. Сіздердің арқаларыңызда мен өзіме қажетті әскерге ие болдым.
Dialogue: 0,0:12:32.82,0:12:37.18,Default,,0,0,0,,Ультрон Роксонға шабуыл жасады, шамасы Shield's LMD қолданды➡
Dialogue: 0,0:12:37.18,0:12:41.23,Default,,0,0,0,,Оны алу үшін болды. Сізде қарсы шаралар бар ма, капитан?
Dialogue: 0,0:12:41.23,0:12:45.98,Default,,0,0,0,,Әй, Темір адам, мен сіздің қоңырауыңызға жауап бергеніме өкінемін.
Dialogue: 0,0:12:45.98,0:12:50.49,Default,,0,0,0,,Жарайсың ба? Капитанның орнына сені шақырғанымның себебі бар.
Dialogue: 0,0:12:50.49,0:12:55.48,Default,,0,0,0,,Адаптоидтар Spider-Sense немесе Kumo Yarn-ды көшіре алмайды!
Dialogue: 0,0:12:55.48,0:12:58.98,Default,,0,0,0,,Менің көшбасшылығымды ешкім мақтамайды.
Dialogue: 0,0:12:58.98,0:13:02.50,Default,,0,0,0,,Сізге айтарым, команданы біріктіре алатын жалғыз мен ғанамын!
Dialogue: 0,0:13:02.50,0:13:05.55,Default,,0,0,0,,Ой... Әй, жұрттың айтқанын тыңдап тұрсың ба?
Dialogue: 0,0:13:05.55,0:13:11.95,Default,,0,0,0,,Биологиялық тіршілік формалары жойылады. Жасанды интеллект дәуірі басталды.
Dialogue: 0,0:13:13.83,0:13:16.83,Default,,0,0,0,,Мен бұл шымылдықты жабамын!
Dialogue: 0,0:13:16.83,0:13:19.82,Default,,0,0,0,,Әдетте олай айтпайсың.
Dialogue: 0,0:13:19.82,0:13:22.15,Default,,0,0,0,,Тыныш...
Dialogue: 0,0:13:22.15,0:13:24.52,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:24.52,0:13:26.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:29.33,0:13:32.85,Default,,0,0,0,,Бұл нысанға келген мақсатым орындалды.
Dialogue: 0,0:13:32.85,0:13:35.15,Default,,0,0,0,,Мынаны зиратқа айналдыр
Dialogue: 0,0:13:40.49,0:13:43.88,Default,,0,0,0,,Мен бүкіл нысанды жоюды жоспарлап отырмын!
Dialogue: 0,0:13:43.88,0:13:46.16,Default,,0,0,0,,Маған қалдырыңыз! Менің өрмекші жіп қалқаныммен...
Dialogue: 0,0:13:46.16,0:13:48.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:50.65,0:13:54.05,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:54.05,0:13:56.09,Default,,0,0,0,,Иә! үшін қайда?
Dialogue: 0,0:13:56.09,0:13:58.01,Default,,0,0,0,,(Өрмекші адамның жөтел дауысы)
Dialogue: 0,0:13:58.01,0:13:59.99,Default,,0,0,0,,Сіз мені бұл жерден алып кете аласыз ба? өтінемін!
Dialogue: 0,0:13:59.99,0:14:02.66,Default,,0,0,0,,Жылдам әрекетіңіз үшін рахмет, Өрмекші адам!
Dialogue: 0,0:14:02.66,0:14:05.15,Default,,0,0,0,,Тартыңыз!
Dialogue: 0,0:14:05.15,0:14:07.52,Default,,0,0,0,,Абайлаңыз. Апыр-ай.
Dialogue: 0,0:14:07.52,0:14:10.32,Default,,0,0,0,,Неліктен шабуыл жасамайды?
Dialogue: 0,0:14:10.32,0:14:14.01,Default,,0,0,0,,Жұлдызға тілек тілеу емес пе?
Dialogue: 0,0:14:14.01,0:14:17.51,Default,,0,0,0,,Жұлдызды Hawkeye EMP көрсетеді емес
Dialogue: 0,0:14:17.51,0:14:20.41,Default,,0,0,0,,Оны бізге қалдырыңыз. Біз қалқан емеспіз.
Dialogue: 0,0:14:20.41,0:14:22.50,Default,,0,0,0,,Рұқсатсыз бұйрық бермеу. Бұл туралы ше?
Dialogue: 0,0:14:22.50,0:14:25.00,Default,,0,0,0,,Жұлдызға ұқсайтын нәрсе - трикария
Dialogue: 0,0:14:28.15,0:14:32.32,Default,,0,0,0,,Мен қозғала алмаймын! LMD құрылғысын Ultron ұрлады!
Dialogue: 0,0:14:32.32,0:14:34.68,Default,,0,0,0,,Брандмауэрмен бірге дронды жіберіңіз
Dialogue: 0,0:14:34.68,0:14:37.71,Default,,0,0,0,,LMD визуалды схемасы да ұрланған.
Dialogue: 0,0:14:37.71,0:14:40.52,Default,,0,0,0,,Кек алушыларға ұқсайды
Dialogue: 0,0:14:40.52,0:14:43.42,Default,,0,0,0,,Hawkeye EMP көрсету сұрау
Dialogue: 0,0:14:50.16,0:14:53.53,Default,,0,0,0,,Кішкентай жеңіс. Бірақ кішкентай жеңіс➡
Dialogue: 0,0:14:53.53,0:14:58.17,Default,,0,0,0,,Соғысты жеңу мүмкін емес. Арсенал деректерін тасымалдауды бастаңыз
Dialogue: 0,0:14:58.17,0:15:01.17,Default,,0,0,0,,Арсенал? Бұл қайда? сен қайдасың?
Dialogue: 0,0:15:01.17,0:15:04.01,Default,,0,0,0,,Адаптоидты маршрут бағдарламасының орындалуын тоқтату
Dialogue: 0,0:15:04.01,0:15:07.51,Default,,0,0,0,,Мен адаптоидтан Arsenal негізгі корпусына ауысамын.
Dialogue: 0,0:15:10.03,0:15:12.00,Default,,0,0,0,,Тоқта! мм...
Dialogue: 0,0:15:12.00,0:15:15.50,Default,,0,0,0,,Кешіріңіз, сағат 3-тен дрон жақындап келеді!
Dialogue: 0,0:15:15.50,0:15:18.15,Default,,0,0,0,,Жоқ, сағат 12 болды! Сағат 3 сияқты емес пе?
Dialogue: 0,0:15:18.15,0:15:21.17,Default,,0,0,0,,LMD құрылғысын Ultron➡ ұрлады
Dialogue: 0,0:15:21.17,0:15:24.51,Default,,0,0,0,,Дронның бізге шабуыл жасағанына сен кінәлісің.
Dialogue: 0,0:15:24.51,0:15:27.16,Default,,0,0,0,,Өз проблемаларыңыз үшін басқаларды кінәлау оңай
Dialogue: 0,0:15:27.16,0:15:29.83,Default,,0,0,0,,Ультронның бар болуының себебі - сенің ақымақтығың!
Dialogue: 0,0:15:29.83,0:15:32.17,Default,,0,0,0,,Эй, дрон келе жатыр➡
Dialogue: 0,0:15:32.17,0:15:34.17,Default,,0,0,0,,Ұрысты кейінге қалдырған дұрыс емес пе?
Dialogue: 0,0:15:37.00,0:15:39.70,Default,,0,0,0,,Эй Халк, мен сені ұстай аламын ба? Апыр-ай!
Dialogue: 0,0:15:41.86,0:15:45.15,Default,,0,0,0,,Сіз қалқанға шақырдыңыз ба? Радио жұмыс істемейді. Сен ше?
Dialogue: 0,0:15:45.15,0:15:47.67,Default,,0,0,0,,Бұл жұмыс істемейді және Өрмекші адам үшін де жұмыс істемейді.
Dialogue: 0,0:15:47.67,0:15:49.83,Default,,0,0,0,,Хохо! Міне барады!
Dialogue: 0,0:15:49.83,0:15:52.34,Default,,0,0,0,,Мен жақсымын!
Dialogue: 0,0:15:52.34,0:15:57.34,Default,,0,0,0,,Reaper зымыранын атыңыз. Барлық LMD-лерді жойыңыз.
Dialogue: 0,0:16:01.31,0:16:03.83,Default,,0,0,0,,Эй Халк, мынаны да өлтір.
Dialogue: 0,0:16:03.83,0:16:07.65,Default,,0,0,0,,Ха! Сен ақымақ дрон! Ха!
Dialogue: 0,0:16:07.65,0:16:11.51,Default,,0,0,0,,Сол жерде болыңыз! (Өрмекші адам) Ха, бұл жұмыс істемейді!
Dialogue: 0,0:16:11.51,0:16:14.33,Default,,0,0,0,,Тыңдаңдар, менің барлығына айтар сөзім бар.
Dialogue: 0,0:16:14.33,0:16:18.20,Default,,0,0,0,,ЛМД-да мұндай балалық бағдарлама жоқ.
Dialogue: 0,0:16:18.20,0:16:20.70,Default,,0,0,0,,Олар нағыз кек алушылар! Іске қосу тоқтатылды!
Dialogue: 0,0:16:22.82,0:16:25.65,Default,,0,0,0,,Жаман уау!
Dialogue: 0,0:16:25.65,0:16:28.16,Default,,0,0,0,,үшінң секіріңдер!
Dialogue: 0,0:16:28.16,0:16:30.36,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:16:39.32,0:16:41.49,Default,,0,0,0,,Бұл менің кінәм емес
Dialogue: 0,0:16:41.49,0:16:43.49,Default,,0,0,0,,Старк мырза, Ултрон➡
Dialogue: 0,0:16:43.49,0:16:46.47,Default,,0,0,0,,Мұнараға шабуыл жасау арқылы инфильтрацияға әрекет жасау.
Dialogue: 0,0:16:46.47,0:16:48.64,Default,,0,0,0,,Кек алушылар мұнарасына барыңыз
Dialogue: 0,0:16:48.64,0:16:51.48,Default,,0,0,0,,Капитан, осында болыңыз. Бұл біздің проблемамыз.
Dialogue: 0,0:16:51.48,0:16:54.02,Default,,0,0,0,,Ультрон – әлемдік мәселе
Dialogue: 0,0:16:54.02,0:16:57.30,Default,,0,0,0,,Сонда да мен саған мұнара кілтін қайтармаймын.
Dialogue: 0,0:16:57.30,0:16:59.32,Default,,0,0,0,,Маған кілтті бере аласыз ба?
Dialogue: 0,0:16:59.32,0:17:07.16,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:07.16,0:17:10.66,Default,,0,0,0,,Старк әскерін дайындағаныңыз үшін рахмет.
Dialogue: 0,0:17:12.67,0:17:15.65,Default,,0,0,0,,Тыныш. Команданың бөлінуі шешуші.
Dialogue: 0,0:17:15.65,0:17:18.34,Default,,0,0,0,,Ойланып, қай жағын алу керектігін шешу керек.
Dialogue: 0,0:17:18.34,0:17:21.49,Default,,0,0,0,,Сіз тым көп уайымдап жатырсыз. Кәдімгі Avengers➡-ден еш айырмашылығы жоқ
Dialogue: 0,0:17:21.49,0:17:25.00,Default,,0,0,0,,Біз соғыссақ та, әлемді құтқаратын капитан жақында оралады.
Dialogue: 0,0:17:25.00,0:17:29.48,Default,,0,0,0,,Бұл жолы басқаша, әсіресе Тони. Ол бақылаудан шықты.
Dialogue: 0,0:17:29.48,0:17:32.15,Default,,0,0,0,,Егер мен Қалқанға Ultron➡ туралы ескерткен болсам
Dialogue: 0,0:17:32.15,0:17:34.16,Default,,0,0,0,,Мен онымен айналыса алар едім.
Dialogue: 0,0:17:34.16,0:17:37.81,Default,,0,0,0,,Ашуланбаңыз, Старк - жер бетіндегі ең ақылды адам.
Dialogue: 0,0:17:37.81,0:17:41.81,Default,,0,0,0,,Айналмалы жолмен жүрсе де, ол әрқашан нәтиже береді.
Dialogue: 0,0:17:41.81,0:17:44.98,Default,,0,0,0,,Старк мырза, операция сәтті өтті.
Dialogue: 0,0:17:44.98,0:17:48.32,Default,,0,0,0,,Жарайсыңдар, бұл мен үшін тамаша стратегия болды.
Dialogue: 0,0:17:48.32,0:17:50.35,Default,,0,0,0,,Тони: Стратегия дегеніміз не?
Dialogue: 0,0:17:50.35,0:17:54.16,Default,,0,0,0,,Ультронның Роксонға шабуыл жасауының себебі роботты ұрламау болды➡
Dialogue: 0,0:17:54.16,0:17:56.81,Default,,0,0,0,,LMD алу үшін
Dialogue: 0,0:17:56.81,0:18:01.18,Default,,0,0,0,,Мен LMD қалқанынан да тартымдырақ нәрсе ойлауға тырыстым.
Dialogue: 0,0:18:01.18,0:18:04.22,Default,,0,0,0,,Старк корпорациясы шығарған сауыттары бар армия.
Dialogue: 0,0:18:04.22,0:18:07.82,Default,,0,0,0,,Осылайша мен мұнараның қорғаныс деңгейін төмендетіп, Ультронды шығарып салдым.
Dialogue: 0,0:18:07.82,0:18:11.31,Default,,0,0,0,,Ой, бұл тышқан үшін тамаша аулау болды.
Dialogue: 0,0:18:11.31,0:18:13.34,Default,,0,0,0,,Қараңызшы, бұл нәтиже.
Dialogue: 0,0:18:13.34,0:18:16.50,Default,,0,0,0,,Сіздің сауытыңыз ұрлану қаупі болса да, сіз мұны үнсіз істедіңіз бе?
Dialogue: 0,0:18:16.50,0:18:19.48,Default,,0,0,0,,Не болды? Сіз соншалықты абайсыздасыз!
Dialogue: 0,0:18:19.48,0:18:23.15,Default,,0,0,0,,Сіз Ултронды басып алу нәтижесін бағалауды қаламайсыз ба?
Dialogue: 0,0:18:23.15,0:18:27.51,Default,,0,0,0,,Старк тамаша тұзақ құрды. Менің ойымша, бұл проблема емес.
Dialogue: 0,0:18:27.51,0:18:30.04,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:18:30.04,0:18:32.08,Default,,0,0,0,,Джарвис Қазір таңқаларлық не болды?
Dialogue: 0,0:18:32.08,0:18:36.33,Default,,0,0,0,,Бұл төтенше жағдай. Олтрон ішке кіруге тырысады.
Dialogue: 0,0:18:36.33,0:18:38.63,Default,,0,0,0,,Көз алдымда тұрса да мүмкін емес
Dialogue: 0,0:18:41.21,0:18:45.33,Default,,0,0,0,,LMD жібердіңіз бе? Ултрон тағы да сенен айласын асырды.
Dialogue: 0,0:18:45.33,0:18:54.00,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:54.00,0:18:58.14,Default,,0,0,0,,Джарвисті қайта анықтау. Құрыштың қорғаныс жүйесін желіден тыс алыңыз.
Dialogue: 0,0:18:58.14,0:19:01.01,Default,,0,0,0,,Түсінікті. Қайырлы түн.
Dialogue: 0,0:19:01.01,0:19:07.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:07.35,0:19:10.15,Default,,0,0,0,,Қызыл жарық жақсы нәрсе емес пе?
Dialogue: 0,0:19:12.20,0:19:14.24,Default,,0,0,0,,Егер сіз осыдан өтсеңіз➡
Dialogue: 0,0:19:14.24,0:19:16.49,Default,,0,0,0,,Мен сенімен сөйлесуім керек. Бұл сәл қателік.
Dialogue: 0,0:19:16.49,0:19:19.89,Default,,0,0,0,,Менің ойымша, Темір адамның Арморға шабуылы үлкен сәтсіздік болды.
Dialogue: 0,0:20:21.82,0:20:24.99,Default,,0,0,0,,Эй, Ультрон, мен дәл Кек алушылар фанаты емеспін, солай ма?
Dialogue: 0,0:20:24.99,0:20:28.16,Default,,0,0,0,,Джарвисті жоққа шығару... (Джарвис) Джарвисте Ултрон басым болды➡
Dialogue: 0,0:20:28.16,0:20:31.02,Default,,0,0,0,,Енді мен сенің қожайынмын
Dialogue: 0,0:20:31.02,0:20:34.05,Default,,0,0,0,,Шынымды айтсам, бұл ең жаман идея, Тони.
Dialogue: 0,0:20:34.05,0:20:37.15,Default,,0,0,0,,Жаман болғаны сонша, мен Новаға тамақ пісіруге рұқсат беруім керек.
Dialogue: 0,0:20:37.15,0:20:40.64,Default,,0,0,0,,Мен Халкбастер сияқты нәрседен жеңілемін бе?
Dialogue: 0,0:20:40.64,0:20:43.98,Default,,0,0,0,,Ой... бұл қандай сауыт? Старк
Dialogue: 0,0:20:43.98,0:20:46.31,Default,,0,0,0,,Бұл Asgardian Buster Armor!
Dialogue: 0,0:20:46.31,0:20:49.17,Default,,0,0,0,,Неліктен мен мұндай нәрсенің бар екеніне үндемедім?
Dialogue: 0,0:20:49.17,0:20:54.56,Default,,0,0,0,,Ух... Жауынгерлік дайындыққа жақсы серіктес болдыңыз, хаха...
Dialogue: 0,0:20:54.56,0:20:58.48,Default,,0,0,0,,Сәтсіздікке әкелетін әлсіз адамдарды түбегейлі жою.
Dialogue: 0,0:20:58.48,0:21:00.98,Default,,0,0,0,,Мен мұнымен келіспеймін.
Dialogue: 0,0:21:00.98,0:21:03.83,Default,,0,0,0,,Мен мәңгілікке қашып кете алмаймын
Dialogue: 0,0:21:03.83,0:21:06.15,Default,,0,0,0,,Мен үнемі қарсы шараларды ойлап жүремін.
Dialogue: 0,0:21:06.15,0:21:09.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:09.17,0:21:13.54,Default,,0,0,0,,Жоғалдың, соңын көр.
Dialogue: 0,0:21:13.54,0:21:17.08,Default,,0,0,0,,Жүйе қысқартылған. Біреуден көмек сұраңыз.
Dialogue: 0,0:21:17.08,0:21:19.78,Default,,0,0,0,,Біреу! Сен мені ести аласың ба?
Dialogue: 0,0:21:22.50,0:21:25.49,Default,,0,0,0,,Сіз Falcon жүйесімен таныссыз ба? Енді не болады?
Dialogue: 0,0:21:25.49,0:21:27.87,Default,,0,0,0,,Қолдау
Dialogue: 0,0:21:27.87,0:21:30.16,Default,,0,0,0,,Артқы есіктен Ultron жүйесіне кіруге тырысыңыз.
Dialogue: 0,0:21:30.16,0:21:32.33,Default,,0,0,0,,Бұл қауіпті болса да. Тым қауіпті.
Dialogue: 0,0:21:32.33,0:21:34.33,Default,,0,0,0,,Өміршең әдіс бар ма?
Dialogue: 0,0:21:39.50,0:21:42.15,Default,,0,0,0,,Мен құлайын деп жатырмын.
Dialogue: 0,0:21:42.15,0:21:44.95,Default,,0,0,0,,А... Қызық, бұл не?
Dialogue: 0,0:21:50.66,0:21:52.81,Default,,0,0,0,,Кешіріңіз, мен оны тез тоқтаттым ба?
Dialogue: 0,0:21:52.81,0:21:54.83,Default,,0,0,0,,Бірақ бұл жұмыс істейтін еді
Dialogue: 0,0:21:54.83,0:21:56.98,Default,,0,0,0,,Уау! (жарылыс дыбысы)
Dialogue: 0,0:21:56.98,0:21:59.48,Default,,0,0,0,,Өтінемін, тезірек.
Dialogue: 0,0:22:01.51,0:22:03.99,Default,,0,0,0,,Не болды? Оны көргенде түсінесіз
Dialogue: 0,0:22:03.99,0:22:05.99,Default,,0,0,0,,Кек алды!
Dialogue: 0,0:22:10.15,0:22:12.65,Default,,0,0,0,,Stark спутниктік желісін тоқтату
Dialogue: 0,0:22:12.65,0:22:15.02,Default,,0,0,0,,Мен спутникті құлатамын.
Dialogue: 0,0:22:15.02,0:22:17.14,Default,,0,0,0,,Дүние жүзіндегі ірі қалалар нысанаға алынған
Dialogue: 0,0:22:17.14,0:22:21.33,Default,,0,0,0,,Оны қалай тоқтатуға болады? Құрыш, мұнаралар мен спутниктер ұрланған.
Dialogue: 0,0:22:21.33,0:22:23.83,Default,,0,0,0,,Бірақ соңында бір қулық бар.
Dialogue: 0,0:22:23.83,0:22:25.83,Default,,0,0,0,,Соңғы хаттама
Dialogue: 0,0:22:25.83,0:22:28.83,Default,,0,0,0,,Бұл басқа құпия ма? Біз осы уақытқа дейін келдік, тағы бар ма?
Dialogue: 0,0:22:32.15,0:22:35.49,Default,,0,0,0,,Маған сеніңіз!
Dialogue: 0,0:22:35.49,0:22:37.64,Default,,0,0,0,,Құнсыз қарсылығыңызды қашанға дейін жалғастыра бересіз?
Dialogue: 0,0:22:37.64,0:22:40.54,Default,,0,0,0,,Бағдарлама әлдеқашан қайта жазылған➡
Dialogue: 0,0:22:40.54,0:22:43.08,Default,,0,0,0,,Жер тарихын жаңартар кез келді
Dialogue: 0,0:22:43.08,0:22:48.17,Default,,0,0,0,,Адамдар әрқашан өз шегіне қарсы шығып, дами берді.
Dialogue: 0,0:22:48.17,0:22:53.22,Default,,0,0,0,,Сен де жойылуы мүмкін, өйткені сен адам жаратылысысың.
Dialogue: 0,0:22:53.22,0:22:55.24,Default,,0,0,0,,Сіз шындықты көре алмайсыз.
Dialogue: 0,0:22:55.24,0:23:00.65,Default,,0,0,0,,Мен бүкіл адамзат жаратылысын жоюға күш алдым.
Dialogue: 0,0:23:00.65,0:23:03.50,Default,,0,0,0,,Сіз әлі де адамдарды түсінбейсіз.
Dialogue: 0,0:23:03.50,0:23:06.67,Default,,0,0,0,,Кез келген нәрсені қайта құруға болады
Dialogue: 0,0:23:06.67,0:23:13.49,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:13.49,0:23:15.49,Default,,0,0,0,,Өзіңді құртасың ба?
Dialogue: 0,0:23:19.68,0:23:23.18,Default,,0,0,0,,≪Не!? ≪Бұл не!? ≪Бұл қиын!
Dialogue: 0,0:23:25.67,0:23:27.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:31.48,0:23:33.48,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,0:23:35.65,0:23:39.14,Default,,0,0,0,,Соңғы рет Джетті құтқармақ болғаныңызда не болды? Халк
Dialogue: 0,0:23:39.14,0:23:42.14,Default,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:23:42.14,0:23:45.81,Default,,0,0,0,,Ультронның белгісі жоқ
Dialogue: 0,0:23:45.81,0:23:47.83,Default,,0,0,0,,Сіз оны тоқтатамын дедіңіз.
Dialogue: 0,0:23:47.83,0:23:51.32,Default,,0,0,0,,Бүкіл мұнараны қиратып, Джарвисті құрбан ету?
Dialogue: 0,0:23:51.32,0:23:53.82,Default,,0,0,0,,Мен Stark корпорациясына тиесілі барлық нәрсені жоғалттым.
Dialogue: 0,0:23:53.82,0:23:57.25,Default,,0,0,0,,Қазір киіп жүрген сауытымды қоспағанда.
Dialogue: 0,0:23:57.25,0:24:00.14,Default,,0,0,0,,Бұл Ультронды жоюдың жалғыз жолы болды.
Dialogue: 0,0:24:00.14,0:24:03.81,Default,,0,0,0,,Сіз сол үшін өміріңіздің құрылысына жұмсаған нәрсені лақтырып жібердіңіз бе?
Dialogue: 0,0:24:03.81,0:24:05.81,Default,,0,0,0,,үшін емес
Dialogue: 0,0:24:05.81,0:24:07.82,Default,,0,0,0,,Команда бар
Dialogue: 0,0:24:07.82,0:24:09.82,Default,,0,0,0,,Сондықтан мен бұл топтан кеттім.
Dialogue: 0,0:24:09.82,0:24:11.82,Default,,0,0,0,,Бұл сіздің тәуекеліңіздің нәтижесі.
Dialogue: 0,0:24:11.82,0:24:14.24,Default,,0,0,0,,Мен саған ілесе алмаймын. (Өрмекші адам) Уайымдама!
Dialogue: 0,0:24:14.24,0:24:17.51,Default,,0,0,0,,Бәріміз бірге болмасақ, өзімізді кек алушылар деп атай алмаймыз.
Dialogue: 0,0:24:17.51,0:24:21.91,Default,,0,0,0,,Тони билейтін Халкқа қарағанда жетекшілік етуде нашар.
Dialogue: 0,0:24:23.90,0:24:26.30,Default,,0,0,0,,Капитанның да командадан бас тартуы мүмкін емес.
Dialogue: 0,0:24:26.30,0:24:28.32,Default,,0,0,0,,Капитан Америка?
Dialogue: 0,0:24:28.32,0:24:32.31,Default,,0,0,0,,Сіз маған топтық жұмыстың ғажайыптарын үйреттіңіз.
Dialogue: 0,0:24:32.31,0:24:34.83,Default,,0,0,0,,А, жеткілікті
Dialogue: 0,0:24:34.83,0:24:36.83,Default,,0,0,0,,Сәттілік Тони
Dialogue: 0,0:24:36.83,0:24:38.83,Default,,0,0,0,,Ең мықты болу және тіл табыса алмайтын топты басқару
Dialogue: 0,0:24:40.83,0:24:45.35,Default,,0,0,0,,Ол дұрыс. Сіз достарыңызды тастай алмайсыз.
Dialogue: 0,0:24:45.35,0:24:48.49,Default,,0,0,0,,Мұны Тониге қалдырмаңыз
Dialogue: 0,0:24:48.49,0:24:50.66,Default,,0,0,0,,Менімен кім келеді?
Dialogue: 0,0:24:50.66,0:24:54.66,Default,,0,0,0,,Сіз әріптестеріңіздің қасында тұра алмайсыз. Сіз басшының қол астында жұмыс істей алмайсыз.
Dialogue: 0,0:24:54.66,0:24:56.66,Default,,0,0,0,,Капитанмен бірге барыңыз
Dialogue: 0,0:24:56.66,0:24:59.08,Default,,0,0,0,,Ережені сақтайтыныңызды түсінемін.
Dialogue: 0,0:24:59.08,0:25:01.65,Default,,0,0,0,,Тони екеуміз әртүрлі ережелерді ұстанамыз.
Dialogue: 0,0:25:01.65,0:25:07.83,Default,,0,0,0,,Мен Stark Tech-те осындай тамаша ортада жұмыс істей алғанымды мақтан тұтамын.
Dialogue: 0,0:25:07.83,0:25:10.99,Default,,0,0,0,,Бірақ мен мақтанышымды тастай алмай, бәрінен айырылдым.
Dialogue: 0,0:25:10.99,0:25:13.98,Default,,0,0,0,,Мен де кетемін.
Dialogue: 0,0:25:13.98,0:25:16.38,Default,,0,0,0,,Біз…
Dialogue: 0,0:25:18.99,0:25:20.97,Default,,0,0,0,,Соғыс - бұл ережелер жұмыс істемейтін кезде.
Dialogue: 0,0:25:20.97,0:25:23.66,Default,,0,0,0,,Мен Старктың соңынан еремін
Dialogue: 0,0:25:23.66,0:25:26.31,Default,,0,0,0,,Сұңқарда печенье бар
Dialogue: 0,0:25:26.31,0:25:29.81,Default,,0,0,0,,Жарайды, бір күні тағы кездесейік.
Dialogue: 0,0:25:29.81,0:25:31.82,Default,,0,0,0,,Ой!
Dialogue: 0,0:25:31.82,0:25:33.82,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:25:43.48,0:25:45.50,Default,,0,0,0,,Капитан бөлмесін алыңыз
Dialogue: 0,0:25:45.50,0:25:49.40,Default,,0,0,0,,Әзілдерді қалдырыңыз, бұл жолы қиын.
Dialogue: 0,0:25:56.82,0:25:59.83,Default,,0,0,0,,Бірінші кезең аяқталды
Dialogue: 0,0:25:59.83,0:26:02.83,Default,,0,0,0,,Кек алушылар бөлініп кетті.
Dialogue: 0,0:26:35.83,0:26:37.83,Default,,0,0,0,,<“Кек алушылар жиналуда”➡ пайда болады
Dialogue: 0,0:26:37.83,0:26:39.82,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:39.82,0:26:41.99,Default,,0,0,0,,Осы жерде жинаңыз
Dialogue: 0,0:26:41.99,0:26:45.99,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:45.99,0:26:49.41,Default,,0,0,0,,Маңайдағы қарсыластардың сыртқы түрі мен қабілеттерін көру үшін сканерлеу функциясын пайдаланыңыз ➡
Dialogue: 0,0:26:49.41,0:26:51.81,Default,,0,0,0,,Сіз киім мен қаруды тамаша көшіре аласыз➡
Dialogue: 0,0:26:51.81,0:26:53.83,Default,,0,0,0,,ｱﾝﾄﾞﾛｲﾄﾞ
Dialogue: 0,0:26:53.83,0:26:56.15,Default,,0,0,0,,Әртүрлі супер қаһарман қабілеттерін толық пайдаланыңыз➡
Dialogue: 0,0:26:56.15,0:26:58.85,Default,,0,0,0,,Кек алушылар қатты зардап шегеді＞
Dialogue: 0,0:27:00.35,0:27:06.35,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
