Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.20,0:00:40.50,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:44.59,0:00:46.61,Default,,0,0,0,,<Кек алушылар, яғни➡
Dialogue: 0,0:00:46.61,0:00:48.51,Default,,0,0,0,,Супер қаһармандар жиналды➡
Dialogue: 0,0:00:48.51,0:00:50.86,Default,,0,0,0,,Ең күшті батырлар командасы
Dialogue: 0,0:00:50.86,0:00:53.68,Default,,0,0,0,,Өзіңіздің керемет күшіңізді жинаңыз және жердің тыныштығын қорғаңыз! ＞
Dialogue: 0,0:00:53.68,0:00:56.02,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.02,0:00:58.22,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:58.22,0:01:00.72,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:00.72,0:01:02.71,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:02.71,0:01:04.68,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:04.68,0:01:06.68,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:08.70,0:01:11.23,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.23,0:01:14.25,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.25,0:01:16.29,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:16.29,0:01:18.19,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:18.19,0:01:20.19,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:22.19,0:01:25.06,Default,,0,0,0,,Humph жоғары қауіпсіздік кванттық шифрлау
Dialogue: 0,0:01:25.06,0:01:28.20,Default,,0,0,0,,Құралдарыңыз болса, алдыңғы есікті бұзып өтуге болады.
Dialogue: 0,0:01:28.20,0:01:31.34,Default,,0,0,0,,Бұл жайсыз жәндік.
Dialogue: 0,0:01:31.34,0:01:33.34,Default,,0,0,0,,Енді, жәндіктер...
Dialogue: 0,0:01:33.34,0:01:35.51,Default,,0,0,0,,Жоқ, қателеспейсіз бе?
Dialogue: 0,0:01:35.51,0:01:37.68,Default,,0,0,0,,Дәреже? Сіз мұнда не істеп жүрсіз?
Dialogue: 0,0:01:37.68,0:01:39.68,Default,,0,0,0,,Мен техникалық қолдауды сұраған жоқпын.
Dialogue: 0,0:01:39.68,0:01:42.35,Default,,0,0,0,,Эй Worldwind, мен құралдарымды қайтарғым келеді.
Dialogue: 0,0:01:42.35,0:01:44.35,Default,,0,0,0,,Чек абыройсыз болды ма?
Dialogue: 0,0:01:44.35,0:01:47.54,Default,,0,0,0,,Мен зерттеуге қаражат табу үшін құралдарды сататынмын➡
Dialogue: 0,0:01:47.54,0:01:50.37,Default,,0,0,0,,Мен Кек алушылар тобына қосылғандықтан сатуды тоқтаттым.
Dialogue: 0,0:01:50.37,0:01:54.43,Default,,0,0,0,,Сіз Кек алушылар тобына қосыласыз ба? Мені қоссаңыз пайдалырақ болар еді.
Dialogue: 0,0:01:54.43,0:01:56.46,Default,,0,0,0,,Бұлай ойлау өзімшілдік, бірақ➡
Dialogue: 0,0:01:56.46,0:01:59.68,Default,,0,0,0,,Әйтеуір, мен құрал-саймандарды жинауда осылай жүремін.
Dialogue: 0,0:01:59.68,0:02:02.20,Default,,0,0,0,,Оны заңсыз мақсаттарда пайдалануы мүмкін адамдардан.
Dialogue: 0,0:02:02.20,0:02:05.57,Default,,0,0,0,,Дөрекі болмаңыз. Мені бәрі құрметтейді.
Dialogue: 0,0:02:05.57,0:02:07.59,Default,,0,0,0,,Мен қазір далада жүрмін.
Dialogue: 0,0:02:07.59,0:02:12.03,Default,,0,0,0,,Тур? Миллиондаған долларлық жабдықтары бар қатты қорғалған зертхана?
Dialogue: 0,0:02:12.03,0:02:14.03,Default,,0,0,0,,Қайда қарасам да өз еркім.
Dialogue: 0,0:02:14.03,0:02:18.03,Default,,0,0,0,,Бұған көз жүгіртсеңіз қалай болады?
Dialogue: 0,0:02:18.03,0:02:20.45,Default,,0,0,0,,Бұл құрал менікі! мәміле жасалды
Dialogue: 0,0:02:20.45,0:02:22.35,Default,,0,0,0,,Қайтару жоқ.
Dialogue: 0,0:02:22.35,0:02:25.35,Default,,0,0,0,,Кешіріңіз, бірақ бұл мәселе. Эй, оны қайтар.
Dialogue: 0,0:02:30.03,0:02:33.68,Default,,0,0,0,,Сіздің ойыңызша, сіз де солай істей аласыз ба? Әлемдік жел
Dialogue: 0,0:02:33.68,0:02:35.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:35.70,0:02:38.35,Default,,0,0,0,,ﾎｰｸｱｲ ﾌﾞﾗｯｸ･ｳｨﾄﾞｳ
Dialogue: 0,0:02:38.35,0:02:40.35,Default,,0,0,0,,Сіздің күшіңіз жел ме?
Dialogue: 0,0:02:44.74,0:02:48.80,Default,,0,0,0,,Егер сіз көп сөйлейтін болсаңыз, Тони Старк жеткілікті.
Dialogue: 0,0:02:48.80,0:02:52.03,Default,,0,0,0,,Рахмет, сіз маған көмектестіңіз. Мен араласқым келмеді, сондықтан үндемедім.
Dialogue: 0,0:02:52.03,0:02:55.54,Default,,0,0,0,,Сен қазір менің досым болған соң, мен зұлымдарды жалғыз жоюға шықпаймын.
Dialogue: 0,0:02:55.54,0:03:00.69,Default,,0,0,0,,Қарсыластың қаскөй деуге болмайтын кішкентай адам болса да.
Dialogue: 0,0:03:00.69,0:03:02.71,Default,,0,0,0,,Мен сізді естимін. Кешіріңіз.
Dialogue: 0,0:03:02.71,0:03:05.36,Default,,0,0,0,,Мен өткен қателіктерімді жасырын түрде тазалағым келді.
Dialogue: 0,0:03:05.36,0:03:08.72,Default,,0,0,0,,Өткенде бәріміз қателестік.
Dialogue: 0,0:03:08.72,0:03:12.87,Default,,0,0,0,,Мен сендермен кеңесуім керек еді. Бірақ мен оны әзірге тазарттым.
Dialogue: 0,0:03:12.87,0:03:17.37,Default,,0,0,0,,Тазартылды ма? Төтенше жағдай түймешігін жасауды ұмыттыңыз ба?
Dialogue: 0,0:03:17.37,0:03:20.37,Default,,0,0,0,,Төтенше жағдай түймесі? Ойлап қарасам, мен жасадым.
Dialogue: 0,0:03:25.20,0:03:28.85,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:03:28.85,0:03:31.35,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:03:34.01,0:03:36.68,Default,,0,0,0,,Неліктен мұндай түймені жасадыңыз!? (Антоман) Маған мұны істеуді өтінді!
Dialogue: 0,0:03:36.68,0:03:38.71,Default,,0,0,0,,Төлем де жақсы болды.
Dialogue: 0,0:03:38.71,0:03:41.21,Default,,0,0,0,,Жұмысты сол себепті қабылдадыңыз ба?
Dialogue: 0,0:05:05.28,0:05:07.78,Default,,0,0,0,,Бір күні өз өнертабыстарым мені мазалайды ма деп ойлаймын.
Dialogue: 0,0:05:13.91,0:05:16.81,Default,,0,0,0,,Эй, мен мұны киюім керек пе?
Dialogue: 0,0:05:19.03,0:05:21.03,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:24.55,0:05:27.35,Default,,0,0,0,,Құралдарыңызды қайтарғанымды қалайсыз ба?
Dialogue: 0,0:05:27.35,0:05:29.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:32.34,0:05:34.34,Default,,0,0,0,,Қазір көмектесіңіз
Dialogue: 0,0:05:37.68,0:05:39.68,Default,,0,0,0,,Өкінішті, өнімді қайтарып алу.
Dialogue: 0,0:05:39.68,0:05:41.68,Default,,0,0,0,,Ақшаны қайтару мүмкін емес.
Dialogue: 0,0:05:44.05,0:05:48.34,Default,,0,0,0,,Құтқаратын тағы бір нәрсе болса, мен саған көмектесемін.
Dialogue: 0,0:05:48.34,0:05:51.53,Default,,0,0,0,,Сіз қай қаскөйге барасыз? (Антоман) Бір минут күте тұрыңыз.
Dialogue: 0,0:05:51.53,0:05:55.20,Default,,0,0,0,,Мадам Экс Egghead Ah~ Blizzard және ➡
Dialogue: 0,0:05:55.20,0:05:57.87,Default,,0,0,0,,ﾕﾆｺｰﾝ…
Dialogue: 0,0:05:57.87,0:06:02.74,Default,,0,0,0,,Мен Халк пен Speed Demon арасындағы шайқасты бірнеше рет көрдім➡
Dialogue: 0,0:06:02.74,0:06:05.03,Default,,0,0,0,,Сіз не іздеп жүрсіз? (Темір адам) Бұл хит
Dialogue: 0,0:06:05.03,0:06:08.53,Default,,0,0,0,,Мен бұл шабуылдың артында Nighthawk тұрғандай сезінемін.
Dialogue: 0,0:06:08.53,0:06:11.93,Default,,0,0,0,,Мен де солай ойлаймын. Жоғарғы эскадрилья қозғала бастады.
Dialogue: 0,0:06:11.93,0:06:13.95,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:06:13.95,0:06:16.52,Default,,0,0,0,,Капот Күлгін адам О, ол жігіт те
Dialogue: 0,0:06:16.52,0:06:19.34,Default,,0,0,0,,Сіз құралдарды Doctor Spectrum-ға саттыңыз ба?
Dialogue: 0,0:06:19.34,0:06:21.53,Default,,0,0,0,,Сіз не ойлап отырсыз? Неліктен?
Dialogue: 0,0:06:21.53,0:06:25.20,Default,,0,0,0,,Ол байсалды, шыншыл адам сияқты көрінді.
Dialogue: 0,0:06:25.20,0:06:27.85,Default,,0,0,0,,Бұл біз Спектр деп білетін адам ма?
Dialogue: 0,0:06:27.85,0:06:31.02,Default,,0,0,0,,Кими жоқ кезде ол Пауэр Prism➡ қолданды
Dialogue: 0,0:06:31.02,0:06:33.02,Default,,0,0,0,,Кек алушыларды жеңуге тырысты
Dialogue: 0,0:06:33.02,0:06:35.54,Default,,0,0,0,,Оған қандай құралдар жасадың?
Dialogue: 0,0:06:35.54,0:06:38.69,Default,,0,0,0,,Бұл қуат күшейткіші. (Сұңқар көз) Сіз жауды күшейттіңіз бе?
Dialogue: 0,0:06:38.69,0:06:42.35,Default,,0,0,0,,Бұл таң қалдырады. Сіз оны қазір командадан қууыңыз керек.
Dialogue: 0,0:06:42.35,0:06:46.22,Default,,0,0,0,,Мен жасадым! Мен эскадрон кодын бұзып үлгердім.
Dialogue: 0,0:06:46.22,0:06:48.74,Default,,0,0,0,,Егер сіз олар тастап кеткен кемеге қарасаңыз➡
Dialogue: 0,0:06:48.74,0:06:52.77,Default,,0,0,0,,Мақсатты анықтауға болады
Dialogue: 0,0:06:52.77,0:06:55.03,Default,,0,0,0,,Биллден тікелей сұраңыз, сіз бірден білесіз.
Dialogue: 0,0:06:55.03,0:06:58.51,Default,,0,0,0,,Билл деген кім? Доктор Спектрдің шын аты
Dialogue: 0,0:06:58.51,0:07:01.53,Default,,0,0,0,,Мені Билли деп атама, қатты ашуланасың.
Dialogue: 0,0:07:01.53,0:07:05.00,Default,,0,0,0,,Сонымен, сіз Билли Спектрдің ұялы телефон нөмірін білесіз бе?
Dialogue: 0,0:07:05.00,0:07:07.04,Default,,0,0,0,,Егер сіз мұны білсеңіз не істер едіңіз?
Dialogue: 0,0:07:07.04,0:07:09.84,Default,,0,0,0,,Құралға орнатылған құмырсқаның феромонын орындасаңыз болғаны.
Dialogue: 0,0:07:09.84,0:07:12.38,Default,,0,0,0,,Тіпті анық көрінсе де
Dialogue: 0,0:07:12.38,0:07:14.34,Default,,0,0,0,,Біз кемені зерттеуіміз керек пе, әлде Феромонды қууымыз керек пе?➡
Dialogue: 0,0:07:14.34,0:07:16.84,Default,,0,0,0,,Сіз қайсысын таңдар едіңіз? Екіге бөлейік
Dialogue: 0,0:07:25.86,0:07:28.89,Default,,0,0,0,,Корпусқа зақым келмеген сияқты.
Dialogue: 0,0:07:28.89,0:07:32.59,Default,,0,0,0,,Тоқта, мен мына жерді ашамын. (Халк) Мен оны саған ашамын.
Dialogue: 0,0:07:34.87,0:07:36.87,Default,,0,0,0,,Кейде ол қатты ашулы жүз жасайды.
Dialogue: 0,0:07:36.87,0:07:38.87,Default,,0,0,0,,Мен де солай істейтін болдым.
Dialogue: 0,0:07:45.51,0:07:48.01,Default,,0,0,0,,Феромон осы жерде тоқтайды.
Dialogue: 0,0:07:48.01,0:07:50.01,Default,,0,0,0,,Айналада ештеңе жоқ
Dialogue: 0,0:07:50.01,0:07:53.52,Default,,0,0,0,,Оны жасыратын құрылғы жасырады ма? Жасырын қабырға болуы мүмкін.
Dialogue: 0,0:07:53.52,0:07:55.72,Default,,0,0,0,,Немесе құм.
Dialogue: 0,0:08:01.53,0:08:04.03,Default,,0,0,0,,...
Dialogue: 0,0:08:04.03,0:08:06.68,Default,,0,0,0,,Ерекше жерде орналасқан
Dialogue: 0,0:08:06.68,0:08:08.68,Default,,0,0,0,,Әзірге Repulsor қолданбас бұрын күте тұрыңыз!
Dialogue: 0,0:08:08.68,0:08:11.35,Default,,0,0,0,,Спектрді жаман адам деп ойлайтын сияқтысыз➡
Dialogue: 0,0:08:11.35,0:08:14.02,Default,,0,0,0,,Маған мүмкіндік беріңізші.
Dialogue: 0,0:08:14.02,0:08:16.36,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:08:16.36,0:08:20.01,Default,,0,0,0,,Сәлем Билл! Скотт Ланг. Не айтқың келеді?
Dialogue: 0,0:08:20.01,0:08:22.01,Default,,0,0,0,,Сізге мүмкіндік берейік
Dialogue: 0,0:08:22.01,0:08:24.97,Default,,0,0,0,,Түнгі сұңқар шөл далада не ойлап отыр?
Dialogue: 0,0:08:24.97,0:08:27.52,Default,,0,0,0,,Кеш болмай тұрғанда кет.
Dialogue: 0,0:08:27.52,0:08:29.52,Default,,0,0,0,,Ей, ұрысудың қажеті жоқ!
Dialogue: 0,0:08:29.52,0:08:32.17,Default,,0,0,0,,Егер сіз маған жасаған Пауэр күшейткішті қайтарсаңыз,
Dialogue: 0,0:08:32.17,0:08:34.68,Default,,0,0,0,,Бұл оңай емес...
Dialogue: 0,0:08:34.68,0:08:36.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:36.69,0:08:40.86,Default,,0,0,0,,Оған мүмкіндік берудің мәні жоқ! Шабуылдарға жауап берейік!
Dialogue: 0,0:08:40.86,0:08:42.85,Default,,0,0,0,,Күте тұрыңыз! (найзағай)
Dialogue: 0,0:08:42.85,0:08:45.04,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:08:45.04,0:08:47.04,Default,,0,0,0,,Мен оны алдым!
Dialogue: 0,0:08:49.52,0:08:51.72,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:08:54.18,0:08:56.18,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:08:56.18,0:08:58.18,Default,,0,0,0,,Сұрасаң, сөйле, іс оңға басады.
Dialogue: 0,0:08:58.18,0:09:01.05,Default,,0,0,0,,Мен үшін енді уайымдама.
Dialogue: 0,0:09:01.05,0:09:03.37,Default,,0,0,0,,Қандай жағдай болмасын, бұл сіздің жауапкершілігіңіз.
Dialogue: 0,0:09:03.37,0:09:16.70,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:16.70,0:09:19.04,Default,,0,0,0,,Барлығың тыныш болыңдар, ұрысты доғарайық!
Dialogue: 0,0:09:19.04,0:09:21.05,Default,,0,0,0,,Күшейткішке шабуыл жасаңыз!
Dialogue: 0,0:09:21.05,0:09:24.09,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:24.09,0:09:26.11,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:26.11,0:09:28.53,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:09:28.53,0:09:31.90,Default,,0,0,0,,Эй, Антман, бұл Пауэр күшейткіші еді, солай ма?
Dialogue: 0,0:09:31.90,0:09:34.22,Default,,0,0,0,,Аа, әрине.
Dialogue: 0,0:09:34.22,0:09:38.22,Default,,0,0,0,,Онда неліктен ол бұзылған болса да қуат беру керек?
Dialogue: 0,0:10:41.22,0:10:43.22,Default,,0,0,0,,Уау...｡ Уау...
Dialogue: 0,0:10:45.21,0:10:48.09,Default,,0,0,0,,Билл Тоқта! Ұрыс ештеңе шешпейді!
Dialogue: 0,0:10:48.09,0:10:50.11,Default,,0,0,0,,Өткенді жуып тастайық
Dialogue: 0,0:10:50.11,0:10:53.03,Default,,0,0,0,,Соғыстың жалғыз жолы екенін түсінбейсің бе?
Dialogue: 0,0:10:53.03,0:10:55.87,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:55.87,0:10:58.69,Default,,0,0,0,,Кек алушылар бұл жерде жеңіледі.
Dialogue: 0,0:10:58.69,0:11:01.37,Default,,0,0,0,,Мен оңайлықпен жеңілмеймін, Билли!
Dialogue: 0,0:11:01.37,0:11:04.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:04.37,0:11:07.07,Default,,0,0,0,,Менің атым - Doctor Spectrum!
Dialogue: 0,0:11:10.01,0:11:12.37,Default,,0,0,0,,Сіз спектрде жақсысыз ➡
Dialogue: 0,0:11:12.37,0:11:16.54,Default,,0,0,0,,Олар қуат күшейткішін сатамыз деді, бірақ екеуі де қателесті.
Dialogue: 0,0:11:16.54,0:11:28.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:28.37,0:11:32.74,Default,,0,0,0,,Мен сені жойып, бұл планетаны басқарамын!
Dialogue: 0,0:11:32.74,0:11:35.86,Default,,0,0,0,,Сонда бұл туралы не деуге болады? Алыңыз!
Dialogue: 0,0:11:35.86,0:11:40.36,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:40.36,0:11:42.51,Default,,0,0,0,,Бұл сіз жеңе алатын қарсылас емес, солай ма?
Dialogue: 0,0:11:42.51,0:11:48.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:48.52,0:11:50.52,Default,,0,0,0,,А... Мен оны жеңе алмадым.
Dialogue: 0,0:11:50.52,0:11:55.04,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:55.04,0:11:58.70,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:11:58.70,0:12:01.50,Default,,0,0,0,,Мен сені кездестіргеніңе өкінемін.
Dialogue: 0,0:12:08.02,0:12:10.02,Default,,0,0,0,,Іші қорқынышты.
Dialogue: 0,0:12:10.02,0:12:12.86,Default,,0,0,0,,Шынымен бе? Сіз күңгірт жарықтан қорқасыз ба?
Dialogue: 0,0:12:12.86,0:12:15.51,Default,,0,0,0,,Мен түнде шам жанып ұйықтаймын.
Dialogue: 0,0:12:15.51,0:12:17.53,Default,,0,0,0,,Сіз мені қалжыңдап тұрсыз ба!?
Dialogue: 0,0:12:17.53,0:12:20.02,Default,,0,0,0,,Ешқандай қозғалыстың белгісі жоқ.
Dialogue: 0,0:12:20.02,0:12:24.02,Default,,0,0,0,,Жүйені қайта іске қосу үшін жеткілікті қуат қалды деп үміттенемін...
Dialogue: 0,0:12:26.04,0:12:31.63,Default,,0,0,0,,(Жәндік тәрізді роботтың қозғалу дыбысы)
Dialogue: 0,0:12:31.63,0:12:34.18,Default,,0,0,0,,Қазір қандай дыбыс? (Шұңқыр) Адамдар көп.
Dialogue: 0,0:12:34.18,0:12:38.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:38.52,0:12:40.85,Default,,0,0,0,,Бұл кеменің қорғаныс жүйесі!
Dialogue: 0,0:12:40.85,0:12:45.53,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:45.53,0:12:47.53,Default,,0,0,0,,Бұл жігіттерді жылжыту күші қалды.
Dialogue: 0,0:12:47.53,0:12:49.70,Default,,0,0,0,,Уау, мен жәндіктерді жек көремін!
Dialogue: 0,0:12:49.70,0:12:52.18,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:12:52.18,0:12:54.53,Default,,0,0,0,,Ах Халк, бұл шынымен қорқынышты.
Dialogue: 0,0:12:54.53,0:13:05.86,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:05.86,0:13:08.35,Default,,0,0,0,,ﾊﾙｸ？
Dialogue: 0,0:13:08.35,0:13:10.75,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:13:10.75,0:13:13.00,Default,,0,0,0,,Осылардың кейбірін үйге алайық.
Dialogue: 0,0:13:13.00,0:13:15.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:15.02,0:13:17.02,Default,,0,0,0,,Деректер бөлмесіне асығыңыз. Уақытымыз көп емес.
Dialogue: 0,0:13:17.02,0:13:19.32,Default,,0,0,0,,А, дұрыс! Асығыңыз!
Dialogue: 0,0:13:22.93,0:13:25.85,Default,,0,0,0,,Жоғалыңыз, кек алушылар!
Dialogue: 0,0:13:25.85,0:13:29.02,Default,,0,0,0,,Мен Пьеро сияқты күдікті адамның бұйрығын тыңдамаймын.
Dialogue: 0,0:13:29.02,0:13:31.19,Default,,0,0,0,,Оны кім құрастырған?
Dialogue: 0,0:13:31.19,0:13:36.19,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:36.19,0:13:38.20,Default,,0,0,0,,Капитан Аздап ауырып тұр!
Dialogue: 0,0:13:38.20,0:13:46.85,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:46.85,0:13:48.86,Default,,0,0,0,,Мен саған айттым
Dialogue: 0,0:13:48.86,0:13:57.51,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:57.51,0:14:00.68,Default,,0,0,0,,А... Осы демалыс күндерін Лас-Вегаста өткіземіз бе?
Dialogue: 0,0:14:00.68,0:14:03.54,Default,,0,0,0,,Барлығы, спектрді қалаға жақындатпаңдар.
Dialogue: 0,0:14:03.54,0:14:22.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:22.34,0:14:25.19,Default,,0,0,0,,Саған сенсем де, сені көре алмадым!
Dialogue: 0,0:14:25.19,0:14:28.36,Default,,0,0,0,,Мен туралы не білесің? Біреу түсінеді ме?
Dialogue: 0,0:14:28.36,0:14:34.27,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:34.27,0:14:36.30,Default,,0,0,0,,♬~
Dialogue: 0,0:14:36.30,0:14:38.19,Default,,0,0,0,,Сіз алаңдадың.
Dialogue: 0,0:14:38.19,0:14:42.36,Default,,0,0,0,,Енді сізді не мазалағанын көрсетейін!
Dialogue: 0,0:14:42.36,0:14:48.85,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:48.85,0:14:53.05,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:14:55.52,0:14:57.52,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:15:01.51,0:15:04.01,Default,,0,0,0,,Демек, бұл… иллюзия.
Dialogue: 0,0:15:07.35,0:15:11.54,Default,,0,0,0,,Сәлеметсіз бе, құрметті ағайын. Локи?
Dialogue: 0,0:15:11.54,0:15:14.19,Default,,0,0,0,,Менің ең жек көретін адамым ағам болар еді➡
Dialogue: 0,0:15:14.19,0:15:16.86,Default,,0,0,0,,Локи менен күштірек.
Dialogue: 0,0:15:16.86,0:15:20.70,Default,,0,0,0,,Жоқ, бұл нағыз локи емес
Dialogue: 0,0:15:20.70,0:15:23.23,Default,,0,0,0,,Ұмытып қалдым демеңіз
Dialogue: 0,0:15:23.23,0:15:26.84,Default,,0,0,0,,Ағам мені құтқара алар еді, бірақ құтқармады.
Dialogue: 0,0:15:26.84,0:15:29.71,Default,,0,0,0,,Ол ағасын тастап кетті.
Dialogue: 0,0:15:29.71,0:15:33.19,Default,,0,0,0,,Жоқ.Мен ағамды жақсы көретінмін.
Dialogue: 0,0:15:33.19,0:15:36.18,Default,,0,0,0,,Мен әрқашан қатарласып күрескім келді.
Dialogue: 0,0:15:36.18,0:15:39.68,Default,,0,0,0,,Өтірік айтпа! Апыр-ай!
Dialogue: 0,0:15:39.68,0:15:42.35,Default,,0,0,0,,Бұл локи нақты біледі.
Dialogue: 0,0:15:42.35,0:15:44.35,Default,,0,0,0,,Шындықты мойындаңыз
Dialogue: 0,0:15:47.52,0:15:49.69,Default,,0,0,0,,Халк Бұл көңілді ме?
Dialogue: 0,0:15:49.69,0:15:52.05,Default,,0,0,0,,Хехе, бұл қызық.
Dialogue: 0,0:15:52.05,0:15:54.05,Default,,0,0,0,,Менің ойымша, деректер бөлмесі сол жерде.
Dialogue: 0,0:15:56.70,0:16:01.04,Default,,0,0,0,,♬~
Dialogue: 0,0:16:01.04,0:16:11.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:11.35,0:16:14.03,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,0:16:14.03,0:16:16.87,Default,,0,0,0,,Отыру
Dialogue: 0,0:16:16.87,0:16:19.37,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:16:22.71,0:16:26.70,Default,,0,0,0,,Асықпасақ, көбірек роботтар шабуыл жасайды.
Dialogue: 0,0:16:26.70,0:16:28.70,Default,,0,0,0,,Бұл көп уақытты қажет етпейді
Dialogue: 0,0:16:33.85,0:16:37.02,Default,,0,0,0,,Уау, мен Пауэр Prism қару деп ойладым.
Dialogue: 0,0:16:37.02,0:16:39.71,Default,,0,0,0,,Жоқ? Бұл тірі зат
Dialogue: 0,0:16:39.71,0:16:42.56,Default,,0,0,0,,Адамдардың сезімдерімен өмір сүреді
Dialogue: 0,0:16:42.56,0:16:45.70,Default,,0,0,0,,Ха, бұл аналар күніне сыйлық ретінде жарамайды.
Dialogue: 0,0:16:45.70,0:16:58.28,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:58.28,0:17:00.86,Default,,0,0,0,,«Доктор Спектрінде» бір құпия бар сияқты.
Dialogue: 0,0:17:00.86,0:17:09.96,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:09.96,0:17:11.96,Default,,0,0,0,,Барлығы, Рокиге ұмтылыңдар!
Dialogue: 0,0:17:17.71,0:17:21.37,Default,,0,0,0,,Мен Тордың ғана оның бұрылып кеткісі келетін өткені бар емес екеніне сенімдімін.
Dialogue: 0,0:17:21.37,0:17:24.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:27.87,0:17:29.84,Default,,0,0,0,,Сен мені жалғыз қалдырдың, Стив.
Dialogue: 0,0:17:29.84,0:17:31.85,Default,,0,0,0,,ｳｨﾝﾀｰ･ｿﾙｼﾞｬｰ？
Dialogue: 0,0:17:31.85,0:17:34.36,Default,,0,0,0,,Басқа біреу төлесін.
Dialogue: 0,0:17:34.36,0:17:38.57,Default,,0,0,0,,Баки, мен сені құтқаруға тырыстым.
Dialogue: 0,0:17:38.57,0:17:42.72,Default,,0,0,0,,Өзіңізді өтірік айтқаныңыз үшін өзіңізді кінәлі сезінбейсіз бе?
Dialogue: 0,0:17:42.72,0:17:44.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:46.69,0:17:48.70,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:17:48.70,0:17:51.13,Default,,0,0,0,,Спектр мұндай әрекеттерді қалай жасай алады?
Dialogue: 0,0:17:51.13,0:17:53.35,Default,,0,0,0,,Қуат призмасы эмоцияларды басқара алады
Dialogue: 0,0:17:53.35,0:17:56.72,Default,,0,0,0,,Қорқыныш пен кінәні сезілетін нәрсеге айналдырыңыз.
Dialogue: 0,0:17:56.72,0:17:59.52,Default,,0,0,0,,Мен өзімді қауіпсіз сезінемін. Қорқатын ештеңе жоқ.
Dialogue: 0,0:17:59.52,0:18:01.52,Default,,0,0,0,,Біртүрлі шаш үлгісі.
Dialogue: 0,0:18:01.52,0:18:05.22,Default,,0,0,0,,Уау! Оны бағаламаған дұрыс.
Dialogue: 0,0:18:08.03,0:18:11.70,Default,,0,0,0,,Қайта кездескенше, Старк. Ультрон!
Dialogue: 0,0:18:11.70,0:18:15.19,Default,,0,0,0,,Мені құрттың деп түсінбеуің.
Dialogue: 0,0:18:15.19,0:18:19.63,Default,,0,0,0,,Сіз кеттіңіз!
Dialogue: 0,0:18:19.63,0:18:25.35,Default,,0,0,0,,Бұл рас па? Түсіңізде менімен ұрысатын шығарсыз.
Dialogue: 0,0:18:25.35,0:18:28.89,Default,,0,0,0,,Және жеңілу
Dialogue: 0,0:18:28.89,0:18:43.05,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:43.05,0:18:47.70,Default,,0,0,0,,Сенің сезімдерің мен қорқыныштарың менің тамағым!
Dialogue: 0,0:18:47.70,0:18:52.50,Default,,0,0,0,,Мен жасадым! Мен барлық күш-қуатымды қайтардым!
Dialogue: 0,0:18:57.36,0:19:00.87,Default,,0,0,0,,Жоғарғы эскадрилья өз планетасын жойды.
Dialogue: 0,0:19:00.87,0:19:02.87,Default,,0,0,0,,Мұқият қараңыздар Кек алушылар
Dialogue: 0,0:19:02.87,0:19:06.27,Default,,0,0,0,,Сенің кесіріңнен бұл планета бітеді.
Dialogue: 0,0:20:08.27,0:20:10.37,Default,,0,0,0,,Маған қараңдар, Кек алушылар.
Dialogue: 0,0:20:10.37,0:20:13.77,Default,,0,0,0,,Сіздің қорқынышты арманыңыз шындыққа айналады
Dialogue: 0,0:20:16.18,0:20:19.86,Default,,0,0,0,,Сіз өз сәтсіздігіңізді ұмыттыңыз ба? Темір бас сүйек Санос
Dialogue: 0,0:20:19.86,0:20:23.72,Default,,0,0,0,,Ал мен дүниені жойып жібере жаздадым
Dialogue: 0,0:20:23.72,0:20:25.82,Default,,0,0,0,,Ауыратын жерімді ұрма
Dialogue: 0,0:20:28.50,0:20:30.69,Default,,0,0,0,,Бұл шындық емес!
Dialogue: 0,0:20:30.69,0:20:33.84,Default,,0,0,0,,Сіз мені үнемі елемейтінсіз
Dialogue: 0,0:20:33.84,0:20:36.53,Default,,0,0,0,,Соңында мен бас тарттым
Dialogue: 0,0:20:36.53,0:20:41.02,Default,,0,0,0,,Мен сені өз ініңді қорғамағаның үшін құрметтеймін➡
Dialogue: 0,0:20:41.02,0:20:43.72,Default,,0,0,0,,Мидгардты қорғап тұрған жоқ па?
Dialogue: 0,0:20:46.54,0:20:48.68,Default,,0,0,0,,Тыныш кетіп қалсаңыз➡
Dialogue: 0,0:20:48.68,0:20:50.98,Default,,0,0,0,,Бұл болмауы керек еді.
Dialogue: 0,0:20:54.60,0:20:58.37,Default,,0,0,0,,Билл Жерді жоймас бұрын Призманы пайдалануды тоқтатыңыз!
Dialogue: 0,0:20:58.37,0:21:02.04,Default,,0,0,0,,Сіз түсінбейсіз. Мен сені басқаратын адам емеспін.
Dialogue: 0,0:21:02.04,0:21:07.44,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:07.44,0:21:10.55,Default,,0,0,0,,Мен қазір сізге көмектесуім керек. (Дабыл)
Dialogue: 0,0:21:10.55,0:21:15.20,Default,,0,0,0,,Мен қауіпсіздік жүйесіне кіргеннен бері өзін-өзі жою құрылғысы іске қосылған сияқты.
Dialogue: 0,0:21:15.20,0:21:17.59,Default,,0,0,0,,Бұлай айтуға тым кеш!
Dialogue: 0,0:21:17.59,0:21:32.29,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:32.29,0:21:35.19,Default,,0,0,0,,Мен жеңілдім! Өйткені кеме су астында қалды➡
Dialogue: 0,0:21:35.19,0:21:37.86,Default,,0,0,0,,Олардың деректері де пайдасыз.
Dialogue: 0,0:21:37.86,0:21:41.06,Default,,0,0,0,,Уайымдамаңыз. Бізде төтенше жағдайдың резервтік көшірмесі бар.
Dialogue: 0,0:21:43.53,0:21:45.72,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:45.72,0:21:48.52,Default,,0,0,0,,Билл Тоқта! Сіз ондай адам емессіз!
Dialogue: 0,0:21:59.53,0:22:02.88,Default,,0,0,0,,Бітті, Баки, мен сенімен ұрыспаймын.
Dialogue: 0,0:22:02.88,0:22:04.92,Default,,0,0,0,,Артық емес
Dialogue: 0,0:22:04.92,0:22:06.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:06.94,0:22:09.21,Default,,0,0,0,,Олай болса, мен оны осында аяқтаймын.
Dialogue: 0,0:22:09.21,0:22:11.36,Default,,0,0,0,,Мен сені тастап кеттім, мойындаймын.
Dialogue: 0,0:22:11.36,0:22:13.88,Default,,0,0,0,,Бұл өкініш ешқашан кетпейді
Dialogue: 0,0:22:13.88,0:22:16.28,Default,,0,0,0,,Өмір бойы арқалайтын жүк.
Dialogue: 0,0:22:18.25,0:22:20.25,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:22:23.04,0:22:26.21,Default,,0,0,0,,Көрдіңіз бе? Біз де жасаймыз. Түсінді.
Dialogue: 0,0:22:26.21,0:22:30.59,Default,,0,0,0,,Мен көбірек тырысуым керек еді.
Dialogue: 0,0:22:30.59,0:22:34.53,Default,,0,0,0,,Мен сенің жақсы болатыныңа сене алмадым.
Dialogue: 0,0:22:34.53,0:22:37.23,Default,,0,0,0,,Бірақ мен енді үмітімді үзбеймін
Dialogue: 0,0:22:45.19,0:22:48.86,Default,,0,0,0,,Ультрон Мен мінсіз емеспін. Қараңызшы, сіз мойындадыңыз.
Dialogue: 0,0:22:48.86,0:22:51.20,Default,,0,0,0,,Кейде біз ойланбай әрекет етеміз
Dialogue: 0,0:22:51.20,0:22:53.53,Default,,0,0,0,,Жерге қауіп төндірді.
Dialogue: 0,0:22:53.53,0:22:56.23,Default,,0,0,0,,Мен міндетті түрде өзімнің әлсіз тұсымды түзетуге тырысамын.
Dialogue: 0,0:23:00.04,0:23:03.03,Default,,0,0,0,,Мені Кек алушылар тоқтата алмайды
Dialogue: 0,0:23:03.03,0:23:06.86,Default,,0,0,0,,Мен ғана тыныштық таба аламын!
Dialogue: 0,0:23:06.86,0:23:09.53,Default,,0,0,0,,Бас тартудың уақыты келді. (Сұңқар) Барлығың тыңдаңдар!
Dialogue: 0,0:23:09.53,0:23:13.54,Default,,0,0,0,,Ант-Адам айтқандай, Спектр жаман жігіт емес.
Dialogue: 0,0:23:13.54,0:23:16.42,Default,,0,0,0,,Мен мұны бұрын айттым, бірақ жағдай өзгерді.
Dialogue: 0,0:23:16.42,0:23:19.51,Default,,0,0,0,,Жоқ, Антоман, менің түйсігім дұрыс болды.
Dialogue: 0,0:23:19.51,0:23:24.01,Default,,0,0,0,,Бұл сен емессің! Менің ойымша, оны Призма басқарады.
Dialogue: 0,0:23:24.01,0:23:27.05,Default,,0,0,0,,Қазір тым кеш!
Dialogue: 0,0:23:27.05,0:23:29.10,Default,,0,0,0,,Ух...тек Антоман емес➡
Dialogue: 0,0:23:29.10,0:23:31.15,Default,,0,0,0,,Біз де саған сенеміз
Dialogue: 0,0:23:31.15,0:23:33.19,Default,,0,0,0,,Сіз өз планетаңызды құтқара алмадыңыз
Dialogue: 0,0:23:33.19,0:23:36.21,Default,,0,0,0,,Бірақ бұл жолы біз Жерді құтқара алуымыз керек!
Dialogue: 0,0:23:36.21,0:23:40.03,Default,,0,0,0,,((Уф... Мен өз планетамды жоя алмаймын!
Dialogue: 0,0:23:40.03,0:23:43.68,Default,,0,0,0,,Сіздің таңдауыңыз жоқ.
Dialogue: 0,0:23:43.68,0:23:45.68,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:23:48.17,0:23:50.69,Default,,0,0,0,,Сіз мұны істемеуіңіз керек!
Dialogue: 0,0:23:50.69,0:23:53.09,Default,,0,0,0,,Уф... Мен мақұлдамаймын!
Dialogue: 0,0:23:53.09,0:23:55.85,Default,,0,0,0,,Қуат ырғағын басқара алмайсыз.
Dialogue: 0,0:23:55.85,0:23:58.03,Default,,0,0,0,,Призма арқылы жұмыс істейді
Dialogue: 0,0:23:58.03,0:24:00.23,Default,,0,0,0,,Тоқта!))
Dialogue: 0,0:24:03.44,0:24:07.02,Default,,0,0,0,,Призма мені таңдады. Мен оны қуып жібере алмаймын.
Dialogue: 0,0:24:07.02,0:24:09.53,Default,,0,0,0,,Бұл менің бөлігім
Dialogue: 0,0:24:09.53,0:24:11.69,Default,,0,0,0,,Қуат күшейткіші қажет болды...
Dialogue: 0,0:24:11.69,0:24:14.86,Default,,0,0,0,,Менің күшімді нығайту және Призманы басу үшін
Dialogue: 0,0:24:14.86,0:24:17.68,Default,,0,0,0,,Егер бұл орын алса, қазірдің өзінде кеш.
Dialogue: 0,0:24:17.68,0:24:20.72,Default,,0,0,0,,Қателікті түзетуге ешқашан кеш емес
Dialogue: 0,0:24:20.72,0:24:24.36,Default,,0,0,0,,Қорқынышыңызды босатыңыз, қолыңыздан келеді!
Dialogue: 0,0:24:24.36,0:24:27.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:27.34,0:24:29.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:29.71,0:24:32.51,Default,,0,0,0,,Уау!!
Dialogue: 0,0:24:39.71,0:24:41.71,Default,,0,0,0,,ﾄﾞｸﾀｰ･ｽﾍﾟｸﾄﾗﾑ！
Dialogue: 0,0:24:44.34,0:24:47.54,Default,,0,0,0,,Маған Билл деп қоңырау шалыңыз
Dialogue: 0,0:24:55.52,0:24:57.69,Default,,0,0,0,,Жақсы қайтарылды.
Dialogue: 0,0:24:57.69,0:25:01.84,Default,,0,0,0,,Сен оны тастап кеткеніңе аз ғана уақыт болды.
Dialogue: 0,0:25:01.84,0:25:05.36,Default,,0,0,0,,Жоқ, ол ауыртпалық болды.
Dialogue: 0,0:25:05.36,0:25:07.36,Default,,0,0,0,,Енді хост қажет емес
Dialogue: 0,0:25:09.35,0:25:14.04,Default,,0,0,0,,Нағыз «Доктор спектрі» дүниеге келді.
Dialogue: 0,0:25:14.04,0:25:16.18,Default,,0,0,0,,Енді келесі қадамға өтіңіз
Dialogue: 0,0:25:16.18,0:25:20.18,Default,,0,0,0,,Squadron Supreme-ге қош келдіңіз
Dialogue: 0,0:25:22.18,0:25:25.33,Default,,0,0,0,,Бұл дұрыс болды. Қалқандық ғарышты зерттеу үшін ➡
Dialogue: 0,0:25:25.33,0:25:27.35,Default,,0,0,0,,Ғалымдар жетіспеді.
Dialogue: 0,0:25:27.35,0:25:29.67,Default,,0,0,0,,Басқа планетаны бір жерде сақтаңыз.
Dialogue: 0,0:25:29.67,0:25:31.84,Default,,0,0,0,,Мені құтқарғаның үшін рахмет
Dialogue: 0,0:25:31.84,0:25:34.36,Default,,0,0,0,,Ақырында призмадан босатылды
Dialogue: 0,0:25:34.36,0:25:37.26,Default,,0,0,0,,Сізді құтқарған өз күшіңіз болды.
Dialogue: 0,0:25:37.26,0:25:39.35,Default,,0,0,0,,«Сендер келесісіңдер!»—
Dialogue: 0,0:25:39.35,0:25:42.37,Default,,0,0,0,,Мен сұмдық істесем де, сен маған сендің.
Dialogue: 0,0:25:42.37,0:25:44.67,Default,,0,0,0,,Адамдарды бұрынғы қателеріне қарап бағалау➡
Dialogue: 0,0:25:44.67,0:25:47.19,Default,,0,0,0,,Мен қателескенімді білдім.
Dialogue: 0,0:25:47.19,0:25:49.54,Default,,0,0,0,,Бір құрал жиналды.
Dialogue: 0,0:25:49.54,0:25:52.84,Default,,0,0,0,,Келесі жинаққа көмектесетін адам бар ма?
Dialogue: 0,0:25:56.68,0:25:58.70,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:25:58.70,0:26:01.30,Default,,0,0,0,,Ұнамаса, айт.
Dialogue: 0,0:26:35.17,0:26:37.21,Default,,0,0,0,,<«Кек алушылар жиналады» фильмінде пайда болды➡
Dialogue: 0,0:26:37.21,0:26:39.23,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:39.23,0:26:41.36,Default,,0,0,0,,Осы жерге жинаңыз
Dialogue: 0,0:26:41.36,0:26:43.36,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:45.53,0:26:49.20,Default,,0,0,0,,<Басқа өлшем әлеміндегі Supreme Hero Team Squadron Supreme мүшесі
Dialogue: 0,0:26:49.20,0:26:53.07,Default,,0,0,0,,Шексіздік тастарынан ол шындықты басқарады➡
Dialogue: 0,0:26:53.07,0:26:55.11,Default,,0,0,0,,Себебі мен Reality Stone➡ қолдандым
Dialogue: 0,0:26:55.11,0:26:57.01,Default,,0,0,0,,Тарих төңкерілді➡
Dialogue: 0,0:26:57.01,0:26:59.21,Default,,0,0,0,,Кек алушылар зұлым адамдар ретінде қарастырылады>
Dialogue: 0,0:27:00.71,0:27:06.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
