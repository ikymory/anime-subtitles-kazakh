Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.00,0:00:41.30,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.49,0:00:47.49,Default,,0,0,0,,<Кек алушылар, яғни➡
Dialogue: 0,0:00:47.49,0:00:49.48,Default,,0,0,0,,Супер қаһармандар жиналды➡
Dialogue: 0,0:00:49.48,0:00:51.66,Default,,0,0,0,,Ең күшті батырлар командасы
Dialogue: 0,0:00:51.66,0:00:54.50,Default,,0,0,0,,Өзіңіздің керемет күшіңізді жинаңыз және жердің тыныштығын қорғаңыз! ＞
Dialogue: 0,0:00:54.50,0:00:56.80,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.80,0:00:58.97,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:58.97,0:01:01.49,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.49,0:01:03.49,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.49,0:01:05.47,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.47,0:01:07.47,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.48,0:01:11.98,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.98,0:01:14.97,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.97,0:01:17.00,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:17.00,0:01:19.04,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:19.04,0:01:21.04,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:23.09,0:01:30.47,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:30.47,0:01:33.49,Default,,0,0,0,,Бұл Жоғарғы эскадрильяның кемесі.
Dialogue: 0,0:01:33.49,0:01:36.64,Default,,0,0,0,,Бұрынғы жауынгерлік кеме қазір аквариумға айналды
Dialogue: 0,0:01:36.64,0:01:39.64,Default,,0,0,0,,А, бұл жаман болды, Тони.
Dialogue: 0,0:01:39.64,0:01:42.66,Default,,0,0,0,,Тергеуге барғанымда, оны суға батырайын деген ойым болған жоқ.
Dialogue: 0,0:01:42.66,0:01:46.07,Default,,0,0,0,,[Радио] да жұмыс жасады. Енді біздің кезегіміз.
Dialogue: 0,0:01:46.07,0:01:48.97,Default,,0,0,0,,Мен Nighthawk-тың осы кемедегі жоспарларын зерттегім келеді.
Dialogue: 0,0:01:48.97,0:01:50.97,Default,,0,0,0,,Өйткені эскадрильялар мені алдай береді➡
Dialogue: 0,0:01:50.97,0:01:52.99,Default,,0,0,0,,Егер сіз бастаманы қолға алмасаңыз
Dialogue: 0,0:01:52.99,0:01:55.86,Default,,0,0,0,,[Радио] (Сұңқар) Night Hawk мұны күткен болуы мүмкін.
Dialogue: 0,0:01:55.86,0:01:59.38,Default,,0,0,0,,Мен оның болжағанын болжап отырмын.
Dialogue: 0,0:01:59.38,0:02:01.41,Default,,0,0,0,,Captain shield
Dialogue: 0,0:02:01.41,0:02:09.82,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:09.82,0:02:13.31,Default,,0,0,0,,Күшейткішті қосыңыз. Мұнараның аркуаторын ➡ пайдаланыңыз
Dialogue: 0,0:02:13.31,0:02:15.33,Default,,0,0,0,,Мына кемені суға түсірейік
Dialogue: 0,0:02:15.33,0:02:17.30,Default,,0,0,0,,Сіз оны іске қоса алатыныңызға сенімдісіз бе? Жоқ
Dialogue: 0,0:02:17.30,0:02:19.30,Default,,0,0,0,,Жасай бер, Сұңқар.
Dialogue: 0,0:02:21.30,0:02:23.30,Default,,0,0,0,,Қараңызшы, ол қозғалды, солай ма? Әй, бірақ➡
Dialogue: 0,0:02:23.30,0:02:25.34,Default,,0,0,0,,Мен әлі ештеңе істеген жоқпын.
Dialogue: 0,0:02:25.34,0:02:27.86,Default,,0,0,0,,Бұл тұзақ!
Dialogue: 0,0:02:27.86,0:02:31.41,Default,,0,0,0,,Темір адам капитан!? Ах, мм...
Dialogue: 0,0:02:31.41,0:02:33.41,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:02:36.65,0:02:38.67,Default,,0,0,0,,Байланыс үзілді
Dialogue: 0,0:02:38.67,0:02:40.65,Default,,0,0,0,,Мүмкін екеуі де қамауға алынған шығар.
Dialogue: 0,0:02:40.65,0:02:42.82,Default,,0,0,0,,Әй, қара! (Сұңқар) Бұл не?
Dialogue: 0,0:02:42.82,0:02:45.16,Default,,0,0,0,,Кішкентай, бірақ... Иә? қауіпті!
Dialogue: 0,0:02:45.16,0:02:47.98,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:47.98,0:02:50.50,Default,,0,0,0,,Бұл қауіпті болды. (Сұңқар көз) Бұл не?
Dialogue: 0,0:02:50.50,0:02:55.40,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:55.40,0:02:57.50,Default,,0,0,0,,ｽｸｱﾄﾞﾛﾝ･ｽﾌﾟﾘｰﾑ！
Dialogue: 0,0:02:57.50,0:03:02.68,Default,,0,0,0,,Кек алушылар ұлы көшбасшысыз да күресе ала ма?
Dialogue: 0,0:03:02.68,0:03:06.08,Default,,0,0,0,,Хахаха... Эскадрилья шабуылы.
Dialogue: 0,0:04:28.99,0:04:39.66,Default,,0,0,0,,♪♪～
Dialogue: 0,0:04:39.66,0:04:43.31,Default,,0,0,0,,Көшбасшы жойылды. Қалғандары оңай жеңістер.
Dialogue: 0,0:04:43.31,0:04:46.51,Default,,0,0,0,,Капитан мен Темірге не істедің? Апыр-ай!
Dialogue: 0,0:04:48.68,0:04:51.30,Default,,0,0,0,,Олар біздің кемеге басып кірді.
Dialogue: 0,0:04:51.30,0:04:53.47,Default,,0,0,0,,Жазаласаң да, өзің кінәлісің.
Dialogue: 0,0:04:53.47,0:04:55.99,Default,,0,0,0,,Кек алушылар дәуірі аяқталды
Dialogue: 0,0:04:55.99,0:05:00.14,Default,,0,0,0,,Жылы көзқарасыңыз тек қана қылмыстың өршуіне әкеледі.
Dialogue: 0,0:05:00.14,0:05:02.14,Default,,0,0,0,,Жерді бізге тапсыр
Dialogue: 0,0:05:02.14,0:05:06.03,Default,,0,0,0,,Жоғарғы эскадрильяның басшылығымен әлем қауіпсіз болады.
Dialogue: 0,0:05:06.03,0:05:08.68,Default,,0,0,0,,Жерді бере алмайсың.
Dialogue: 0,0:05:08.68,0:05:10.80,Default,,0,0,0,,Себебін білесіз бе? Ол ешкімге тиесілі емес
Dialogue: 0,0:05:10.80,0:05:12.97,Default,,0,0,0,,Бұл түнгі сұңқар сияқты айту емес.
Dialogue: 0,0:05:12.97,0:05:15.31,Default,,0,0,0,,Мүмкін бірдеңе бар шығар.
Dialogue: 0,0:05:15.31,0:05:17.31,Default,,0,0,0,,Мен саған ешқашан берілмеймін.
Dialogue: 0,0:05:17.31,0:05:19.33,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:05:19.33,0:05:23.40,Default,,0,0,0,,Сіз соңына дейін күресесіз бе? Дәл мен күткендей болды.
Dialogue: 0,0:05:23.40,0:05:29.97,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:29.97,0:05:32.47,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:05:35.31,0:05:38.98,Default,,0,0,0,,An empty factory? Бұл бізді жалықтыратын стратегия ма?
Dialogue: 0,0:05:38.98,0:05:41.97,Default,,0,0,0,,Жау капитан Америка мен Ironman-ді ұрды
Dialogue: 0,0:05:41.97,0:05:44.49,Default,,0,0,0,,Бұл да тұзақ болуы мүмкін, сондықтан абай болыңыз.
Dialogue: 0,0:05:44.49,0:05:47.64,Default,,0,0,0,,Бізде соңғы үлгідегі жабдықтар бар, бірақ ол жұмыс істемейтін сияқты.
Dialogue: 0,0:05:47.64,0:05:49.64,Default,,0,0,0,,Бір сәт кешіріңіз. (Antoman) Wow...
Dialogue: 0,0:05:49.64,0:05:52.01,Default,,0,0,0,,Speed Demon! (Жылдам демон) Менің атымды есіңе түсірдің бе?
Dialogue: 0,0:05:52.01,0:05:56.15,Default,,0,0,0,,Хахаха... (Сұңқар көз) Біреуді ұрудың не қызығы бар?
Dialogue: 0,0:05:56.15,0:05:58.15,Default,,0,0,0,,Бұл ойын аздап қауіпті.
Dialogue: 0,0:05:58.15,0:06:08.48,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:08.48,0:06:11.31,Default,,0,0,0,,Уау! Ол дұрыс жұмыс істей ме?
Dialogue: 0,0:06:11.31,0:06:13.33,Default,,0,0,0,,Үкім шығару жақсы емес
Dialogue: 0,0:06:13.33,0:06:16.15,Default,,0,0,0,,Жаңа доктор спектрі
Dialogue: 0,0:06:16.15,0:06:19.47,Default,,0,0,0,,Ұялшақ болуды доғар да, маған қатты әсер ет.
Dialogue: 0,0:06:19.47,0:06:26.30,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:26.30,0:06:28.81,Default,,0,0,0,,Оны асыға күтіңіздер! Аңшылықты бастайық!
Dialogue: 0,0:06:28.81,0:06:33.20,Default,,0,0,0,,Халк! Жасырудың қажеті жоқ, құбыжық!
Dialogue: 0,0:06:33.20,0:06:35.72,Default,,0,0,0,,Кім жасырынып жатыр?
Dialogue: 0,0:06:35.72,0:06:37.76,Default,,0,0,0,,(енеді)
Dialogue: 0,0:06:37.76,0:06:40.99,Default,,0,0,0,,Сіз менің күшіммен әрқашан шеберсіз ...
Dialogue: 0,0:06:40.99,0:06:42.96,Default,,0,0,0,,Хмф! (Гиперион) Уау!
Dialogue: 0,0:06:42.96,0:06:44.96,Default,,0,0,0,,Әңгімешіл жігіт.
Dialogue: 0,0:06:44.96,0:06:47.13,Default,,0,0,0,,Гиперион! Дәл солай, мен тағы да өзімшілдікпен әрекет еттім...
Dialogue: 0,0:06:47.13,0:06:49.15,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:49.15,0:06:56.59,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:56.59,0:06:59.98,Default,,0,0,0,,Мен Торды жеңдім, ол маған қарсы тұрады...
Dialogue: 0,0:06:59.98,0:07:01.98,Default,,0,0,0,,Уф! As Hulk says➡
Dialogue: 0,0:07:01.98,0:07:03.98,Default,,0,0,0,,Балалар сендер көп сөйлейсіңдер.
Dialogue: 0,0:07:03.98,0:07:05.99,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:05.99,0:07:08.45,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:07:08.45,0:07:10.49,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:07:10.49,0:07:14.16,Default,,0,0,0,,Кек алушылар, қайда екеніңді айт. Мен Бостандық мүсінінің үстіндемін.
Dialogue: 0,0:07:14.16,0:07:17.65,Default,,0,0,0,,Сәлем! Біз қорқыныш үйіндей зауыттамыз➡
Dialogue: 0,0:07:17.65,0:07:19.65,Default,,0,0,0,,Олар төбелесіп жатса да, олар жай ғана көрікті жерлерді көру ме?
Dialogue: 0,0:07:19.65,0:07:21.82,Default,,0,0,0,,Night Hawk-тің басқа мақсаттары бар.
Dialogue: 0,0:07:21.82,0:07:24.47,Default,,0,0,0,,Әрқашан қарсыласыңыздан айласын асырыңыз.
Dialogue: 0,0:07:24.47,0:07:28.97,Default,,0,0,0,,Тони мен капитанды алып кетті, ал сені алдау жеткілікті.
Dialogue: 0,0:07:28.97,0:07:31.98,Default,,0,0,0,,Екі адамсыз ұжым бірге бола алмайды.
Dialogue: 0,0:07:31.98,0:07:36.32,Default,,0,0,0,,Nighthawk мұнда немесе зауытта емес, яғни...
Dialogue: 0,0:07:36.32,0:07:38.63,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:38.63,0:07:40.97,Default,,0,0,0,,Сіз мені таң қалдырмақшысыз ба? Түнгі сұңқар
Dialogue: 0,0:07:40.97,0:07:44.64,Default,,0,0,0,,Бұл ұят. Бұл оңай емес!
Dialogue: 0,0:07:44.64,0:07:55.82,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:55.82,0:07:58.80,Default,,0,0,0,,Бұл жақын қоңырау болды. Мен құтқарылдым.
Dialogue: 0,0:07:58.80,0:08:03.98,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:03.98,0:08:05.98,Default,,0,0,0,,Ой, бұл қандай жебе?
Dialogue: 0,0:08:05.98,0:08:09.65,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:09.65,0:08:12.65,Default,,0,0,0,,Ұстара арқалығы? Бәрі де мүмкін.
Dialogue: 0,0:08:20.33,0:08:22.33,Default,,0,0,0,,Маған ескі Спектр ұнады, бірақ➡
Dialogue: 0,0:08:22.33,0:08:25.13,Default,,0,0,0,,Дәл қазір сенімен тіл табыса алмаймын.
Dialogue: 0,0:08:28.80,0:08:33.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:33.31,0:08:36.99,Default,,0,0,0,,Сіз өзіңізді кінәлі сезінетін адамды шақыруға тырыстыңыз ба?
Dialogue: 0,0:08:36.99,0:08:41.49,Default,,0,0,0,,Бұл өкінішті болды. Мен бұрынғы қателіктерімді жеңдім.
Dialogue: 0,0:08:44.32,0:08:48.32,Default,,0,0,0,,Хаббл Бұл сіз бе?
Dialogue: 0,0:08:48.32,0:08:51.82,Default,,0,0,0,,Мен оны әдейі баспадым. Мен оны көре алмадым.
Dialogue: 0,0:08:55.66,0:08:57.66,Default,,0,0,0,,Бұл жеткізу жылдамдығы.
Dialogue: 0,0:09:06.97,0:09:08.99,Default,,0,0,0,,Қосымша
Dialogue: 0,0:09:08.99,0:09:12.16,Default,,0,0,0,,Әрі қарай төмен Тым баяу
Dialogue: 0,0:09:12.16,0:09:14.15,Default,,0,0,0,,[Сымсыз] (Сұңқар) Hawkeye Saw
Dialogue: 0,0:09:14.15,0:09:16.13,Default,,0,0,0,,Жылдамдықтағы жындар қаруға қарағанда жылдамырақ қозғала алады.
Dialogue: 0,0:09:16.13,0:09:18.67,Default,,0,0,0,,Бірақ желдің екпінінен қашып құтыла алмайсың
Dialogue: 0,0:09:18.67,0:09:20.87,Default,,0,0,0,,Бұл жақсы кеңес, Сұңқар.
Dialogue: 0,0:09:28.73,0:09:32.63,Default,,0,0,0,,Сіз менің жебелерімді ұрлай аласыз, бірақ менің техникамды ұрлай алмайсыз!
Dialogue: 0,0:09:35.47,0:09:37.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:39.97,0:09:42.64,Default,,0,0,0,,Мен де ойында жақсымын.
Dialogue: 0,0:09:42.64,0:09:44.64,Default,,0,0,0,,Сұңқар Ақпарат үшін рахмет
Dialogue: 0,0:09:44.64,0:09:46.84,Default,,0,0,0,,Мен де сізден сұраймын, капитан Сұңқар.
Dialogue: 0,0:09:48.81,0:09:50.81,Default,,0,0,0,,Жарайсың капитан
Dialogue: 0,0:09:56.31,0:09:58.46,Default,,0,0,0,,Алдымен зауыттық генераторды табыңыз.
Dialogue: 0,0:09:58.46,0:10:00.81,Default,,0,0,0,,Жүйелік кері байланысты қолданып көріңіз
Dialogue: 0,0:10:00.81,0:10:04.35,Default,,0,0,0,,көремін. Егер сіз оны шамадан тыс жүктесеңіз, өрт болады.
Dialogue: 0,0:10:04.35,0:10:06.35,Default,,0,0,0,,[Сымсыз] (Сұңқар) Спектрге қарсы шабуыл жасай алады.
Dialogue: 0,0:10:13.16,0:10:16.66,Default,,0,0,0,,Мен бұл галлюцинация екенін білемін, бірақ мен сенімен ұрысқым келмейді, Хабл.
Dialogue: 0,0:10:16.66,0:10:18.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:22.48,0:10:25.08,Default,,0,0,0,,Мені кешіріңіз, кешіріңіз.
Dialogue: 0,0:10:33.64,0:10:36.01,Default,,0,0,0,,Уау! Falcon сәтті болды
Dialogue: 0,0:10:36.01,0:10:39.83,Default,,0,0,0,,Рахмет, сен Тони сияқты қорқытып тұрсың.
Dialogue: 0,0:10:39.83,0:10:42.13,Default,,0,0,0,,Сол себепті мен де Түнгі Хокке қатты көңіл бөлемін.
Dialogue: 0,0:10:44.80,0:10:46.97,Default,,0,0,0,,Мен сені бұрын жұлып алуға тырыстым.
Dialogue: 0,0:10:46.97,0:10:50.16,Default,,0,0,0,,Сондықтан біз бір-бірімізге тікелей қарсы тұрамыз.
Dialogue: 0,0:10:50.16,0:10:52.29,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:10:52.29,0:10:54.29,Default,,0,0,0,,Сен мені көздеп тұрсың ба?
Dialogue: 0,0:10:56.32,0:10:58.68,Default,,0,0,0,,Сұңқар, сіз эскадрильяны жақсы білесіз.
Dialogue: 0,0:10:58.68,0:11:01.20,Default,,0,0,0,,Сондықтан нұсқауларды сенімді түрде беріңіз.
Dialogue: 0,0:11:01.20,0:11:05.86,Default,,0,0,0,,Сіз бұл шайқаста стратегияңызбен жеңе алмайсыз!
Dialogue: 0,0:11:05.86,0:11:07.83,Default,,0,0,0,,[Радио] (Сұңқар) Менің деректерім бойынша➡
Dialogue: 0,0:11:07.83,0:11:10.66,Default,,0,0,0,,Сарда – ток соғуға әлсіз жарыс.
Dialogue: 0,0:11:10.66,0:11:12.82,Default,,0,0,0,,[Радио] Бірақ ол жерде қуат көзі жоқ.
Dialogue: 0,0:11:12.82,0:11:15.12,Default,,0,0,0,,Бұл күтпеген жерде
Dialogue: 0,0:11:20.31,0:11:24.16,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:24.16,0:11:26.16,Default,,0,0,0,,Гиперионның әлсіз жақтары қандай?
Dialogue: 0,0:11:26.16,0:11:29.16,Default,,0,0,0,,[Радио] (Сұңқар) Мм... соққы. (Халк) Бұл жақсы стратегия.
Dialogue: 0,0:11:39.83,0:11:42.21,Default,,0,0,0,,Менің жауынгерлік дағдыларым жақсарды.
Dialogue: 0,0:11:42.21,0:11:45.25,Default,,0,0,0,,Жалаң қолмен күресу? Бұл күресудің өзіне тән емес тәсілі.
Dialogue: 0,0:11:45.25,0:11:47.13,Default,,0,0,0,,Сізде жақсы интуиция бар.
Dialogue: 0,0:11:47.13,0:11:50.17,Default,,0,0,0,,Бірақ тым кеш
Dialogue: 0,0:11:50.17,0:11:52.82,Default,,0,0,0,,Менен алдау мүмкін емес
Dialogue: 0,0:11:52.82,0:11:54.81,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:11:54.81,0:11:57.33,Default,,0,0,0,,Бұл бізді мұнарадан алыстату стратегиясы болды ма?
Dialogue: 0,0:11:57.33,0:11:59.50,Default,,0,0,0,,Джарвис жағдайды хабарлау
Dialogue: 0,0:11:59.50,0:12:01.66,Default,,0,0,0,,[Сымсыз] (Джарвис) Шамасы, мұнара басқа өлшемде➡
Dialogue: 0,0:12:01.66,0:12:03.65,Default,,0,0,0,,Сіз жіберуге тырысып жатқан сияқтысыз
Dialogue: 0,0:12:03.65,0:12:06.05,Default,,0,0,0,,Сіз бүкіл Нью-Йоркті айтасыз ба?
Dialogue: 0,0:13:08.00,0:13:09.98,Default,,0,0,0,,Қарсы шараларды тез ойластыру керек.
Dialogue: 0,0:13:09.98,0:13:13.14,Default,,0,0,0,,Тауэр мен Нью-Йорк басқа өлшемге жіберіледі!
Dialogue: 0,0:13:13.14,0:13:16.17,Default,,0,0,0,,Сол себепті Жылдам Демон мұнараға кіріп кетті ме?
Dialogue: 0,0:13:16.17,0:13:19.34,Default,,0,0,0,,Nighthawk біраз уақыттан бері жоспар құрып жүр, солай емес пе?
Dialogue: 0,0:13:19.34,0:13:22.49,Default,,0,0,0,,Жарайды, кек алушылар. Мен капитан да, Тони да емеспін.
Dialogue: 0,0:13:22.49,0:13:25.29,Default,,0,0,0,,Алғы сөз қажет емес, Сұңқар. Маған нұсқаулар беріңіз.
Dialogue: 0,0:13:27.37,0:13:29.90,Default,,0,0,0,,Кек алушылар жиналады! Асығыңыз...
Dialogue: 0,0:13:29.90,0:13:32.97,Default,,0,0,0,,Мен бәрібір уақытында үлгермеймін.
Dialogue: 0,0:13:32.97,0:13:34.97,Default,,0,0,0,,Қанаттар!
Dialogue: 0,0:13:34.97,0:13:37.53,Default,,0,0,0,,Барлығы жоспар бойынша.
Dialogue: 0,0:13:37.53,0:13:39.83,Default,,0,0,0,,Бұл жоспарланған болды ма?
Dialogue: 0,0:13:41.83,0:13:44.13,Default,,0,0,0,,Мен қашу жолын бекітемін.
Dialogue: 0,0:13:47.34,0:13:49.32,Default,,0,0,0,,Аһ!
Dialogue: 0,0:13:49.32,0:13:52.32,Default,,0,0,0,,Бұл тағы да ол. Призма сынған жоқ па?
Dialogue: 0,0:13:57.00,0:13:59.50,Default,,0,0,0,,Бұлай жабайы болудан пайда жоқ.
Dialogue: 0,0:13:59.50,0:14:02.60,Default,,0,0,0,,Көп рет үйкеліс үйкеліс жылуын тудырады
Dialogue: 0,0:14:06.02,0:14:08.14,Default,,0,0,0,,Норе Нью-Йоркке асығыңыз
Dialogue: 0,0:14:08.14,0:14:10.14,Default,,0,0,0,,Халк қашып кетті!
Dialogue: 0,0:14:19.72,0:14:22.42,Default,,0,0,0,,Есте сақта, адам.
Dialogue: 0,0:14:24.47,0:14:28.48,Default,,0,0,0,,Бұл Салдадан енді ешқашан бет бұрмағаныңыз жөн.
Dialogue: 0,0:14:28.48,0:14:31.88,Default,,0,0,0,,Не болды? Түнгі сұңқар: Барлығы жоспар бойынша жүріп жатқан жоқ па?
Dialogue: 0,0:14:31.88,0:14:35.65,Default,,0,0,0,,мүлде керісінше. Апыр-ай!
Dialogue: 0,0:14:35.65,0:14:38.32,Default,,0,0,0,,[Радио] (Антоман) Сұңқар Дәл сіз айтқандай.
Dialogue: 0,0:14:38.32,0:14:40.34,Default,,0,0,0,,[Радио] Эскадрилья түрлі тұзақтар орнатты➡
Dialogue: 0,0:14:40.34,0:14:42.34,Default,,0,0,0,,Мен ол жерге қайтып бара алмаймын.
Dialogue: 0,0:14:42.34,0:14:44.84,Default,,0,0,0,,Түнгі сұңқарлар ғана тұзаққа шебер емес!
Dialogue: 0,0:14:48.33,0:14:51.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:51.88,0:14:54.49,Default,,0,0,0,,Сіздің стратегияңыз дұрыс емес. бас тарт.
Dialogue: 0,0:14:54.49,0:14:59.31,Default,,0,0,0,,Жоқ, менің стратегиям жеңді.
Dialogue: 0,0:14:59.31,0:15:02.31,Default,,0,0,0,,Сәтті болса
Dialogue: 0,0:15:02.31,0:15:05.31,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:15:05.31,0:15:07.50,Default,,0,0,0,,Рахмет. Жарайды.
Dialogue: 0,0:15:07.50,0:15:12.00,Default,,0,0,0,,Тасымалдау құрылғысын кері айналдырдыңыз ба? Ұнайды
Dialogue: 0,0:15:14.49,0:15:17.66,Default,,0,0,0,,Өкінішке орай, біз ғана ауыстырылған жоқпыз.
Dialogue: 0,0:15:17.66,0:15:21.01,Default,,0,0,0,,Түнгі сұңқардың тұзағына түсіп қалдым
Dialogue: 0,0:15:21.01,0:15:23.61,Default,,0,0,0,,Бірінен соң бірі құлаған домино сияқты.
Dialogue: 0,0:15:26.30,0:15:28.82,Default,,0,0,0,,Мен сендерді міндетті түрде жеңемін.
Dialogue: 0,0:15:28.82,0:15:30.97,Default,,0,0,0,,Мен мұндай сызықтарды естуден шаршадым.
Dialogue: 0,0:15:30.97,0:15:43.49,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:43.49,0:15:45.52,Default,,0,0,0,,Күте тұрыңыз, ол біраз уақыттан кейін өшеді.
Dialogue: 0,0:15:45.52,0:15:49.83,Default,,0,0,0,,Түсіндім Уау, бұл керемет энергия. Мен оны бірінші рет көріп тұрмын.
Dialogue: 0,0:15:49.83,0:15:53.81,Default,,0,0,0,,Біз Кек алушыларды жалғыз қалдырып, мұнараны ауыстыруды тоқтатуымыз керек.
Dialogue: 0,0:15:53.81,0:15:56.81,Default,,0,0,0,,Мен сені жалғыз қалдырғым келеді, бірақ сен рұқсат бермейсің.
Dialogue: 0,0:16:01.97,0:16:03.99,Default,,0,0,0,,Менің қимылдарым оқылады.
Dialogue: 0,0:16:03.99,0:16:06.37,Default,,0,0,0,,Avengers Change стратегиясы
Dialogue: 0,0:16:06.37,0:16:09.98,Default,,0,0,0,,Сонымен, найзағай. Hawkeye: көрсеткіні осы жерден өткізіңіз.
Dialogue: 0,0:16:09.98,0:16:12.15,Default,,0,0,0,,Бұл жұмыс істей ме?
Dialogue: 0,0:16:12.15,0:16:14.82,Default,,0,0,0,,Гяа!
Dialogue: 0,0:16:14.82,0:16:17.82,Default,,0,0,0,,Мүмкін. Халк Сіз лақтыруды жақсысыз ба?
Dialogue: 0,0:16:17.82,0:16:20.82,Default,,0,0,0,,Ха, сен не айтып тұрсың? Ха!
Dialogue: 0,0:16:23.98,0:16:26.31,Default,,0,0,0,,Жетеді! Сіздің тәкаппар мінезіңіз➡
Dialogue: 0,0:16:26.31,0:16:28.35,Default,,0,0,0,,Мен одан шаршадым! Ха!
Dialogue: 0,0:16:28.35,0:16:30.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:30.90,0:16:44.15,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:44.15,0:16:46.15,Default,,0,0,0,,Ең нашар
Dialogue: 0,0:16:46.15,0:16:48.15,Default,,0,0,0,,Үлкен қателерді өлтіруші?
Dialogue: 0,0:16:48.15,0:16:50.67,Default,,0,0,0,,Джарвис Мұнараға жақындамаңыз
Dialogue: 0,0:16:50.67,0:16:52.70,Default,,0,0,0,,Мен оны тоқтата алмаймын
Dialogue: 0,0:16:52.70,0:16:55.99,Default,,0,0,0,,Жақында бүкіл қала бір жерде ұшып кетеді.
Dialogue: 0,0:16:55.99,0:16:59.98,Default,,0,0,0,,Бұл найзағайға ұқсайды, сондықтан біз бұл туралы бірдеңе істей аламыз.
Dialogue: 0,0:16:59.98,0:17:02.78,Default,,0,0,0,,Nu~!!
Dialogue: 0,0:17:05.48,0:17:07.64,Default,,0,0,0,,Мен іштей кішірейемін.
Dialogue: 0,0:17:07.64,0:17:10.14,Default,,0,0,0,,Мұнараны білетін менмін. мен барамын.
Dialogue: 0,0:17:10.14,0:17:13.33,Default,,0,0,0,,Жарайды, мен саған сенемін.
Dialogue: 0,0:17:13.33,0:17:21.98,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:21.98,0:17:26.35,Default,,0,0,0,,Джарвис I сыртқы антеннадан энергияны қолмен жинаймын
Dialogue: 0,0:17:26.35,0:17:28.37,Default,,0,0,0,,Мен сигнал бергенде, барлығын бірден босатыңыз.
Dialogue: 0,0:17:28.37,0:17:30.39,Default,,0,0,0,,Алға?
Dialogue: 0,0:17:30.39,0:17:32.64,Default,,0,0,0,,Ғарышта ешкім жоқ жерге
Dialogue: 0,0:17:32.64,0:17:35.85,Default,,0,0,0,,Сұңқар Мұның бәрі Найтхоктың жоспары бойынша болуы мүмкін.
Dialogue: 0,0:17:35.85,0:17:40.20,Default,,0,0,0,,Сізді алдап кету мүмкіндігі бар, бірақ бұл қаланы құтқарудың жалғыз жолы.
Dialogue: 0,0:17:40.20,0:17:43.97,Default,,0,0,0,,Мен сіздің шешіміңізге сенемін.
Dialogue: 0,0:17:43.97,0:17:45.97,Default,,0,0,0,,Джарвис қазір!
Dialogue: 0,0:17:45.97,0:17:54.17,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:54.17,0:17:56.32,Default,,0,0,0,,Кешіріңіз, сіздің энергияңыз бұзылды➡
Dialogue: 0,0:17:56.32,0:17:58.32,Default,,0,0,0,,Теңізге бару
Dialogue: 0,0:18:00.47,0:18:05.57,Default,,0,0,0,,Мұнара энергия күшейткішіне айналды ма? Бұлай болмауы керек еді.
Dialogue: 0,0:18:08.15,0:18:11.48,Default,,0,0,0,,Аяқтау уақыты
Dialogue: 0,0:18:11.48,0:18:22.98,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:22.98,0:18:27.17,Default,,0,0,0,,Мұның бәрі кемені қайта тірілтудің жоспары ма?
Dialogue: 0,0:18:27.17,0:18:30.87,Default,,0,0,0,,Сіз кемені іске қосу үшін бұрынғы энергияны пайдаландыңыз ба?
Dialogue: 0,0:18:34.66,0:18:38.06,Default,,0,0,0,,Мені Nighthawk басқарды.
Dialogue: 0,0:19:42.32,0:19:47.00,Default,,0,0,0,,Енді біз Найтхоктың шынайы жоспарын түсіндік.
Dialogue: 0,0:19:47.00,0:19:49.16,Default,,0,0,0,,Сол сәуле жерді тесіп жатыр.
Dialogue: 0,0:19:49.16,0:19:52.17,Default,,0,0,0,,Мен сені тоқтата алмаймын. Мен Тони Старк емеспін.
Dialogue: 0,0:19:52.17,0:19:55.34,Default,,0,0,0,,Қазір біз сенетін жалғыз адам сенсің.
Dialogue: 0,0:19:55.34,0:19:59.31,Default,,0,0,0,,Оның мақсаты Жерді жою емес еді. Бұл үстемдік болуы керек еді.
Dialogue: 0,0:19:59.31,0:20:02.29,Default,,0,0,0,,Эскадрильяларды тоқтату үшін біз бастаманы қолға алуымыз керек.
Dialogue: 0,0:20:02.29,0:20:04.81,Default,,0,0,0,,Мен оған қалағанын жасауға рұқсат бермеймін.
Dialogue: 0,0:20:04.81,0:20:08.65,Default,,0,0,0,,Джарвис Қазір сол кемеден хабар естіп жатырсыз ба?
Dialogue: 0,0:20:08.65,0:20:11.30,Default,,0,0,0,,Иә Қарым-қатынас үлгісін талдадық
Dialogue: 0,0:20:11.30,0:20:14.32,Default,,0,0,0,,Морзе сигналы - SOS
Dialogue: 0,0:20:14.32,0:20:17.98,Default,,0,0,0,,Капитан? Бұл Екінші дүниежүзілік соғыс кезіндегі байланыс құралы.
Dialogue: 0,0:20:17.98,0:20:20.63,Default,,0,0,0,,Капитан мен Тони әлі тірі.
Dialogue: 0,0:20:20.63,0:20:22.63,Default,,0,0,0,,Бұл да тұзақ болуы мүмкін
Dialogue: 0,0:20:22.63,0:20:24.98,Default,,0,0,0,,Мен барлығын кемеге жіберуге тырысамын.
Dialogue: 0,0:20:24.98,0:20:28.02,Default,,0,0,0,,Сонда да Нью-Йорк екіге қысқарар еді➡
Dialogue: 0,0:20:28.02,0:20:30.67,Default,,0,0,0,,Сіз оны көре алмайсыз. Бұл дұрыс.
Dialogue: 0,0:20:30.67,0:20:34.57,Default,,0,0,0,,Біз енді оның қолына түсе алмаймыз. Сұңқардың әдісіне көшейік.
Dialogue: 0,0:20:37.31,0:20:39.31,Default,,0,0,0,,—умеренділермен қақтығысып жатыр.
Dialogue: 0,0:20:44.14,0:20:46.81,Default,,0,0,0,,Пайдасыз батырлар
Dialogue: 0,0:20:46.81,0:20:50.01,Default,,0,0,0,,Біз бағынудан бас тартқан планеталарды жойдық.
Dialogue: 0,0:20:52.48,0:20:55.65,Default,,0,0,0,,А-а... Бұл жолы да тартынбаймын.
Dialogue: 0,0:20:55.65,0:20:59.35,Default,,0,0,0,,Жерді қорғағың келсе, беріл.
Dialogue: 0,0:21:02.55,0:21:06.49,Default,,0,0,0,,Ендеше, олардан сұра! Қалғандары кемеге барады.
Dialogue: 0,0:21:06.49,0:21:09.83,Default,,0,0,0,,♬~
Dialogue: 0,0:21:09.83,0:21:12.86,Default,,0,0,0,,Тоқта, зұлым. Мен сені ары қарай жібермеймін.
Dialogue: 0,0:21:12.86,0:21:16.47,Default,,0,0,0,,Саған уақыт сатып алсам да, мені күлдірме➡
Dialogue: 0,0:21:16.47,0:21:20.14,Default,,0,0,0,,Эскадрильяларды ешкім тоқтата алмайды.
Dialogue: 0,0:21:20.14,0:21:24.51,Default,,0,0,0,,Менің саным аз екені рас, бірақ менде бұл қару бар.
Dialogue: 0,0:21:24.51,0:21:31.50,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:31.50,0:21:34.35,Default,,0,0,0,,Мұны істеу арқылы сіз жеңе алмайсыз! Асгардиялықтар!
Dialogue: 0,0:21:34.35,0:21:47.32,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:47.32,0:21:49.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:53.17,0:21:55.49,Default,,0,0,0,,Әлі де жылынуда
Dialogue: 0,0:21:55.49,0:21:57.84,Default,,0,0,0,,Қазір берілмесең, өкінесің.
Dialogue: 0,0:21:57.84,0:22:00.15,Default,,0,0,0,,Асгардиялықтар ешқашан берілмейді.
Dialogue: 0,0:22:00.15,0:22:02.15,Default,,0,0,0,,Соңына дейін күрес!
Dialogue: 0,0:22:04.32,0:22:07.15,Default,,0,0,0,,Тони эскадронды қалай жеңетінін біледі.
Dialogue: 0,0:22:07.15,0:22:09.69,Default,,0,0,0,,Тони жоқ. Енді оған сенейік.
Dialogue: 0,0:22:09.69,0:22:11.71,Default,,0,0,0,,Бұл сәтті шығар.
Dialogue: 0,0:22:11.71,0:22:13.71,Default,,0,0,0,,Оны ашыңыз!
Dialogue: 0,0:22:16.13,0:22:18.16,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:18.16,0:22:21.06,Default,,0,0,0,,Капитан мен хабарды естідім!
Dialogue: 0,0:22:23.03,0:22:25.83,Default,,0,0,0,,Халк. Мен түссіндім. Өтінемін, аулақ жүріңіз.
Dialogue: 0,0:22:28.97,0:22:31.66,Default,,0,0,0,,Сенің маған көмектесуге келетініңе сендім.
Dialogue: 0,0:22:31.66,0:22:34.06,Default,,0,0,0,,Мен мұны дұрыс әкелдім.
Dialogue: 0,0:22:36.82,0:22:39.15,Default,,0,0,0,,Бұл соңы ма?
Dialogue: 0,0:22:39.15,0:22:41.32,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:22:41.32,0:22:51.65,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:51.65,0:22:54.82,Default,,0,0,0,,Мен жүйені қарадым, бірақ әлі де тұзақтар орнатылған.
Dialogue: 0,0:22:54.82,0:22:57.17,Default,,0,0,0,,Біз қателестік.
Dialogue: 0,0:22:57.17,0:22:59.17,Default,,0,0,0,,Бұл кемеде тесік жоқ➡
Dialogue: 0,0:22:59.17,0:23:01.21,Default,,0,0,0,,Бұл энергияны сорып жатыр!
Dialogue: 0,0:23:01.21,0:23:03.83,Default,,0,0,0,,Сіз оны не үшін пайдаланасыз? Бұл Hyperion кептіргіші ме?
Dialogue: 0,0:23:03.83,0:23:07.15,Default,,0,0,0,,Олар бір жерге жиналды. Бұл жерде!
Dialogue: 0,0:23:07.15,0:23:09.55,Default,,0,0,0,,Энергияны пайдаланатын нәрсе бар.
Dialogue: 0,0:23:15.82,0:23:18.81,Default,,0,0,0,,Nighthawk арқасында мен ақыры қайта тірілдім.
Dialogue: 0,0:23:18.81,0:23:21.48,Default,,0,0,0,,Ол сенуге болатын адам.
Dialogue: 0,0:23:21.48,0:23:25.66,Default,,0,0,0,,Мен үшін уайымдаудың қажеті жоқ. Сіз бұл жолы жүргізіп отырсыз.
Dialogue: 0,0:23:25.66,0:23:27.67,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:23:27.67,0:23:30.67,Default,,0,0,0,,Мен Ньюкпін. Мен сізге кеңес көрсетемін.
Dialogue: 0,0:23:32.64,0:23:35.17,Default,,0,0,0,,Сонымен! Балғаны лақтыр!
Dialogue: 0,0:23:35.17,0:23:40.16,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:40.16,0:23:42.33,Default,,0,0,0,,Міне!
Dialogue: 0,0:23:42.33,0:23:52.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:52.01,0:23:54.11,Default,,0,0,0,,Менің достарым...!
Dialogue: 0,0:23:57.48,0:24:00.65,Default,,0,0,0,,Мен айттым ғой, солай ма? Мен берілуім керек еді!
Dialogue: 0,0:24:00.65,0:24:03.32,Default,,0,0,0,,Иә! (｜｜) Уау!
Dialogue: 0,0:24:03.32,0:24:05.84,Default,,0,0,0,,Нуке керемет қайтып келді.
Dialogue: 0,0:24:05.84,0:24:08.97,Default,,0,0,0,,Бұрынғыдай тағы бірге жабайы жүрейік.
Dialogue: 0,0:24:08.97,0:24:10.98,Default,,0,0,0,,Біраз уақыт өтті!
Dialogue: 0,0:24:10.98,0:24:14.83,Default,,0,0,0,,Бұл планетаны билейтін уақыт келді.
Dialogue: 0,0:24:14.83,0:24:18.15,Default,,0,0,0,,Әй, бұрынғыдай жабайы жүрейік
Dialogue: 0,0:24:18.15,0:24:33.83,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:33.83,0:24:36.82,Default,,0,0,0,,[Монитор] (Түнгі сұңқар) Жердің адамдары, Жоғарғы эскадрилья➡
Dialogue: 0,0:24:36.82,0:24:39.32,Default,,0,0,0,,Біз Кек алушыларды жеңдік. Ол кім?
Dialogue: 0,0:24:39.32,0:24:43.14,Default,,0,0,0,,[Монитор] Енді біз жерді басқарамыз.
Dialogue: 0,0:24:43.14,0:24:46.81,Default,,0,0,0,,[Монитор] Тек бір кек алушылар аман қалды
Dialogue: 0,0:24:46.81,0:24:50.20,Default,,0,0,0,,[Монитор] Сіздің әлеміңіз керемет дамуға қол жеткізеді.
Dialogue: 0,0:24:50.20,0:24:55.17,Default,,0,0,0,,[Монитор] Қылмыскерлер қатаң жазаланады және төбелес болмайды.
Dialogue: 0,0:24:55.17,0:24:58.57,Default,,0,0,0,,[Монитор] Ережеге бағынбағандар аяусыз жойылады.
Dialogue: 0,0:25:03.80,0:25:06.65,Default,,0,0,0,,Оған бүкіл әлем куә болды.
Dialogue: 0,0:25:06.65,0:25:09.80,Default,,0,0,0,,Құдіретті Со жоғалып, тұтқынға айналды.
Dialogue: 0,0:25:09.80,0:25:11.99,Default,,0,0,0,,Мұнымен саған ешкім қарсы тұра алмайды.
Dialogue: 0,0:25:11.99,0:25:14.84,Default,,0,0,0,,Операция өте сәтті өтті. Әрине.
Dialogue: 0,0:25:14.84,0:25:18.64,Default,,0,0,0,,Кек алушылардың әрекетін болжау мүмкін емес.
Dialogue: 0,0:25:22.48,0:25:25.00,Default,,0,0,0,,Бұл күтпеген шығар.
Dialogue: 0,0:25:25.00,0:25:27.82,Default,,0,0,0,,Уф, мен уақытында үлгермеймін деп ойладым, бірақ қуаныштымын.
Dialogue: 0,0:25:27.82,0:25:30.32,Default,,0,0,0,,Егер мен бір сәт баяуырақ болсам, жағдайға түсіп қалар едім.
Dialogue: 0,0:25:30.32,0:25:33.32,Default,,0,0,0,,Уақытында келдің, қуан! Апыр-ай!
Dialogue: 0,0:25:33.32,0:25:37.81,Default,,0,0,0,,Бұл төтенше жағдай болса да, сіз тез шешім қабылдай алдыңыз.
Dialogue: 0,0:25:37.81,0:25:40.80,Default,,0,0,0,,Мен кемеге бару тұзақ екенін білдім.
Dialogue: 0,0:25:40.80,0:25:42.83,Default,,0,0,0,,Мен «Түнгі сұңқардан» айласын асырдым.
Dialogue: 0,0:25:42.83,0:25:45.14,Default,,0,0,0,,Жарайды, сенің тірі екеніңді әлемге білдірейік.
Dialogue: 0,0:25:45.14,0:25:47.14,Default,,0,0,0,,Жоқ, әлі жоқ!
Dialogue: 0,0:25:47.14,0:25:51.16,Default,,0,0,0,,Falcon командасының арқасында эскадрилья бізді өлді деп санайды.
Dialogue: 0,0:25:51.16,0:25:53.80,Default,,0,0,0,,Әзірше оларға осылай ойлауға мүмкіндік берген дұрыс.
Dialogue: 0,0:25:53.80,0:25:56.10,Default,,0,0,0,,Кек алушылар дайынсың ба?
Dialogue: 0,0:25:58.82,0:26:00.99,Default,,0,0,0,,Бар күшімізбен жасайық! Жақсы!
Dialogue: 0,0:26:00.99,0:26:03.29,Default,,0,0,0,,Өз планетамызды қайтарып алайық!
Dialogue: 0,0:26:35.99,0:26:37.99,Default,,0,0,0,,<“Кек алушылар жиналады” фильмінде пайда болды➡
Dialogue: 0,0:26:37.99,0:26:40.12,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:40.12,0:26:42.31,Default,,0,0,0,,Осы жерде жинаңыз
Dialogue: 0,0:26:42.31,0:26:45.18,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:45.18,0:26:49.30,Default,,0,0,0,,Басқа өлшемдегі Squadron Supreme батырлар командасының мүшесі.
Dialogue: 0,0:26:49.30,0:26:52.80,Default,,0,0,0,,Кек алушыларды жеңу үшін өзіңізді Қалқан агенті ретінде жасырыңыз➡
Dialogue: 0,0:26:52.80,0:26:55.32,Default,,0,0,0,,Avengers ➡ әлсіз жақтары туралы ақпарат
Dialogue: 0,0:26:55.32,0:26:57.84,Default,,0,0,0,,Ол ұрлап, пайдаланғысы келетін жауыз>
Dialogue: 0,0:26:57.84,0:27:01.04,Default,,0,0,0,,Жылы көзқарасыңыз тек қана қылмыстың өршуіне әкеледі.
Dialogue: 0,0:27:02.54,0:27:08.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
