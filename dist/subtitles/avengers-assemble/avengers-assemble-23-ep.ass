Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.00,0:00:41.30,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.37,0:00:47.41,Default,,0,0,0,,<Кек алушылар, яғни➡
Dialogue: 0,0:00:47.41,0:00:49.42,Default,,0,0,0,,Супер қаһармандар жиналды➡
Dialogue: 0,0:00:49.42,0:00:51.51,Default,,0,0,0,,Ең күшті батырлар командасы
Dialogue: 0,0:00:51.51,0:00:54.48,Default,,0,0,0,,Өзіңіздің керемет күшіңізді жинаңыз және жердің тыныштығын қорғаңыз! ＞
Dialogue: 0,0:00:54.48,0:00:56.82,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.82,0:00:59.00,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:59.00,0:01:01.50,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.50,0:01:03.51,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.51,0:01:05.51,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.51,0:01:07.51,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.49,0:01:12.01,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:12.01,0:01:15.00,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:15.00,0:01:17.04,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:17.04,0:01:19.05,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:19.05,0:01:21.05,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:25.34,0:01:29.86,Default,,0,0,0,,≪Алға жылжу Алға жылжу
Dialogue: 0,0:01:29.86,0:01:38.66,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:38.66,0:01:42.34,Default,,0,0,0,,Уау! Кек алушылар жоғалып кетті!
Dialogue: 0,0:01:42.34,0:01:46.51,Default,,0,0,0,,Бұл елдің қазір іздеп жүргені – ұлы Аттуманың қайта жаңғыруы.
Dialogue: 0,0:01:46.51,0:01:49.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:49.00,0:01:51.17,Default,,0,0,0,,Кешіріңіз, бірақ бастық қазірдің өзінде осында.
Dialogue: 0,0:01:51.17,0:01:53.51,Default,,0,0,0,,Бұл туралы Атлантидаға хабарланған жоқ па?
Dialogue: 0,0:01:53.51,0:01:55.69,Default,,0,0,0,,Гиперион! (Гиперион) Бұл планета➡
Dialogue: 0,0:01:55.69,0:01:59.18,Default,,0,0,0,,Жоғарғы эскадрилья басқарады. Сіз шеберсіз➡
Dialogue: 0,0:01:59.18,0:02:01.51,Default,,0,0,0,,Барып есеп беріңіз.
Dialogue: 0,0:02:01.51,0:02:04.52,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:02:04.52,0:02:07.62,Default,,0,0,0,,Қалғанын өзім шешемін.
Dialogue: 0,0:02:09.69,0:02:13.19,Default,,0,0,0,,Жерлестер, қазір Кек алушылар қатарына қосылыңыз➡
Dialogue: 0,0:02:13.19,0:02:19.03,Default,,0,0,0,,Олар сізді қорғай алмайды. Олар бұл дүниеден жоғалып кетті.
Dialogue: 0,0:02:19.03,0:02:23.03,Default,,0,0,0,,Біз «Батырлар» атанғандардың бәрін жеңдік.
Dialogue: 0,0:02:26.44,0:02:31.16,Default,,0,0,0,,Бұдан былай біз, ең күшті жаратылыстар, Жоғарғы эскадрильямыз➡
Dialogue: 0,0:02:31.16,0:02:33.53,Default,,0,0,0,,Жерді басқар
Dialogue: 0,0:02:33.53,0:02:36.58,Default,,0,0,0,,(наразылық дауысы)
Dialogue: 0,0:02:36.58,0:02:41.00,Default,,0,0,0,,Біздің бақылауымызда жер толығымен қорғалады.
Dialogue: 0,0:02:41.00,0:02:45.52,Default,,0,0,0,,Қауіпсіздік орнына абсолютті мойынсұнуды күтіңіз.
Dialogue: 0,0:02:45.52,0:02:49.68,Default,,0,0,0,,Қауіпсіздік мойынсұнудан туындамайды. Сіз диктатор!
Dialogue: 0,0:02:49.68,0:02:53.35,Default,,0,0,0,,Аузыңмен күресудің жалғыз жолы, Асгардиялықтар.
Dialogue: 0,0:02:53.35,0:02:58.02,Default,,0,0,0,,Бізде кек алушылар қолданбаған қару бар... Бұл қорқынышты.
Dialogue: 0,0:02:58.02,0:03:01.69,Default,,0,0,0,,Қорқыныш әрқашан адамдарды басқарады.
Dialogue: 0,0:03:01.69,0:03:05.68,Default,,0,0,0,,Бұл дұрыс емес. Нағыз батыр ештеңеден қорықпайды.
Dialogue: 0,0:03:05.68,0:03:10.33,Default,,0,0,0,,Дағдарыс кезінде сіз өзіңіздің ең күшті күшіңізді көрсетесіз.
Dialogue: 0,0:03:10.33,0:03:13.52,Default,,0,0,0,,Сол батырлардың бәрі жойылып кеткені ұят.
Dialogue: 0,0:03:13.52,0:03:16.00,Default,,0,0,0,,[Радио] (сонымен) Бірақ мен әлі де қалдым.
Dialogue: 0,0:03:16.00,0:03:18.51,Default,,0,0,0,,[Радио] (Түнгі сұңқар) Жеңіліс символы ретінде.
Dialogue: 0,0:03:18.51,0:03:20.83,Default,,0,0,0,,Мен сізді анық естимін.
Dialogue: 0,0:03:20.83,0:03:22.84,Default,,0,0,0,,Тыңдау құрылғысы сәтті болды, Антоман.
Dialogue: 0,0:03:22.84,0:03:25.35,Default,,0,0,0,,Түнгі сұңқардың жәндіктерге алаңдамайтынына қуаныштымын.
Dialogue: 0,0:03:25.35,0:03:28.35,Default,,0,0,0,,Мен тығылудан шаршадым. Жарып алайық.
Dialogue: 0,0:03:28.35,0:03:32.02,Default,,0,0,0,,Әлі Халк емес
Dialogue: 0,0:03:32.02,0:03:36.69,Default,,0,0,0,,Енді бізде басымдық бар. Falcon, сіздің келесі жоспарыңыз қандай?
Dialogue: 0,0:03:36.69,0:03:41.06,Default,,0,0,0,,Эскадрилья бізді жеңді деп ойлап, қуанып қалды.
Dialogue: 0,0:03:41.06,0:03:44.62,Default,,0,0,0,,Түнгі сұңқар күтпегендей, оларды шайқап көрейік.
Dialogue: 0,0:03:44.62,0:03:46.69,Default,,0,0,0,,Тек үміт жойылмайды➡
Dialogue: 0,0:03:46.69,0:03:51.09,Default,,0,0,0,,Мен сендерге Кек алушыларды айтамын... Жиналыңдар!
Dialogue: 0,0:05:13.00,0:05:21.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:21.01,0:05:26.33,Default,,0,0,0,,Бізге қарсы шабуылдарға жол берілмейді. Таратыңыз, әйтпесе сізді жоямыз.
Dialogue: 0,0:05:26.33,0:05:32.24,Default,,0,0,0,,Кешіктіруге тыйым салынады. Алға жылжу.
Dialogue: 0,0:05:32.24,0:05:35.99,Default,,0,0,0,,Қазір коменданттық сағат. Сізге сыртқа шығуға рұқсат жоқ.
Dialogue: 0,0:05:35.99,0:05:38.09,Default,,0,0,0,,«Ұшырып жібереді» дегенде, ол ауада ұша ма?
Dialogue: 0,0:05:40.65,0:05:44.00,Default,,0,0,0,,Керемет сұңқар
Dialogue: 0,0:05:44.00,0:05:46.69,Default,,0,0,0,,Nighthawk полиция роботтары өте керемет.
Dialogue: 0,0:05:46.69,0:05:50.06,Default,,0,0,0,,Мұндай заттарды тек Кек алушылар ғана жоя алады.
Dialogue: 0,0:05:50.06,0:05:53.16,Default,,0,0,0,,Бұл электромагниттік импульс, солай ма? Садақ пен жебемен де жасауға болады.
Dialogue: 0,0:05:53.16,0:05:55.33,Default,,0,0,0,,Біздің тірі екеніміз ашылады
Dialogue: 0,0:05:55.33,0:05:59.00,Default,,0,0,0,,Мен Squadron Supreme-тің әлі білгенін қаламаймын.
Dialogue: 0,0:05:59.00,0:06:04.39,Default,,0,0,0,,Бұл сияқты бірдеңе тек қоқыс! (Түнгі сұңқар) Біреу маған шабуыл жасады.
Dialogue: 0,0:06:04.39,0:06:08.94,Default,,0,0,0,,Өртті іштен тудырғаны үшін үнемі біреуді кінәлайсыз➡
Dialogue: 0,0:06:08.94,0:06:11.83,Default,,0,0,0,,Мен оны қарап отырдым. Сіз өзіңіз ойлағандай жақсысыз➡
Dialogue: 0,0:06:11.83,0:06:14.85,Default,,0,0,0,,Оның мінсіз емес екенін қабылдаңыз. (Түнгі сұңқар) Механикалық ақауға байланысты➡
Dialogue: 0,0:06:14.85,0:06:18.00,Default,,0,0,0,,Сенімділікті жоғалтасыз ба? (Жылдам демон) Бұл бәрі емес.
Dialogue: 0,0:06:18.00,0:06:20.67,Default,,0,0,0,,Біз «Кек алушыларды» жеңу үшін топ құрдық.
Dialogue: 0,0:06:20.67,0:06:24.03,Default,,0,0,0,,Сіздің әдісіңізді әрі қарай орындаудың қажеті жоқ.
Dialogue: 0,0:06:24.03,0:06:26.68,Default,,0,0,0,,Утопия жұлдызым сияқты билей алсам➡
Dialogue: 0,0:06:26.68,0:06:29.16,Default,,0,0,0,,Енді бұл қоқысқа сенудің қажеті жоқ.
Dialogue: 0,0:06:29.16,0:06:34.67,Default,,0,0,0,,Кек алушыларды жеңуге кім мүмкіндік бергенін ұмытпаңыз!
Dialogue: 0,0:06:34.67,0:06:36.72,Default,,0,0,0,,[Радио] (Түнгі сұңқар) үшінңыз сәтсіздікке ұшырадыңыз.
Dialogue: 0,0:06:36.72,0:06:39.22,Default,,0,0,0,,[Радио] (Сарда) Өтінемін, бізді қорламайсыз ба?
Dialogue: 0,0:06:39.22,0:06:41.78,Default,,0,0,0,,[Радио] (Жылдам демон) Эй, Түнгі Хок, сен тым жақсы емес сияқтысың.
Dialogue: 0,0:06:41.78,0:06:46.16,Default,,0,0,0,,Мен бақытқа толы болуым керек, бірақ нәрселер күдікті болып көрінеді.
Dialogue: 0,0:06:46.16,0:06:48.33,Default,,0,0,0,,Дәл Falcon ойлағандай. Тынш!
Dialogue: 0,0:06:48.33,0:06:50.85,Default,,0,0,0,,[Радио] (Түнгі сұңқар) Егер сіз оларға қарсылық көрсетсеңіз не болатынын көрсетсеңіз➡
Dialogue: 0,0:06:50.85,0:06:54.84,Default,,0,0,0,,Роботтарды пайдаланудың қажеті болмайды. Әр елдің дипломаттары ➡
Dialogue: 0,0:06:54.84,0:07:00.04,Default,,0,0,0,,Біз қалқан негізіне тығылып жатырмыз. Бізге дипломатияны қалай жасайтынымызды көрсетіңіз.
Dialogue: 0,0:07:03.01,0:07:06.00,Default,,0,0,0,,Әлемнің өкілдері, тыңдаңдар!
Dialogue: 0,0:07:06.00,0:07:09.34,Default,,0,0,0,,Эскадрилья бар болғанша, ұлттың қажеті жоқ.
Dialogue: 0,0:07:09.34,0:07:14.01,Default,,0,0,0,,Сіз эскадрильядан жасыра алмайсыз. Зарда!
Dialogue: 0,0:07:14.01,0:07:16.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:16.66,0:07:21.00,Default,,0,0,0,,Кек алушылар? Ол әлі тірі ме еді?
Dialogue: 0,0:07:21.00,0:07:25.35,Default,,0,0,0,,Елші: Мен бұл мәселені қазір растай немесе жоққа шығара алмаймын.
Dialogue: 0,0:07:25.35,0:07:28.71,Default,,0,0,0,,Бұл құпия. Мен оны әлі жария ете алмаймын.
Dialogue: 0,0:07:28.71,0:07:32.71,Default,,0,0,0,,Жарайды, біз тек құпияны сақтай аламыз.
Dialogue: 0,0:07:43.67,0:07:45.67,Default,,0,0,0,,Уау! (Халк) Уау
Dialogue: 0,0:07:50.68,0:07:54.68,Default,,0,0,0,,Сабақты осылай оқисың. Мейірім жоқ.
Dialogue: 0,0:07:54.68,0:07:57.67,Default,,0,0,0,,Бұл сіздің ақыл ойыныңызға қарағанда тиімдірек.
Dialogue: 0,0:07:57.67,0:08:00.00,Default,,0,0,0,,Сіз керемет сөздер айта аласыз ба? Гиперион
Dialogue: 0,0:08:00.00,0:08:03.36,Default,,0,0,0,,Сіз жарып жіберген ғимаратта ешкім болған жоқ.
Dialogue: 0,0:08:03.36,0:08:06.01,Default,,0,0,0,,Не!? Неліктен?
Dialogue: 0,0:08:06.01,0:08:09.00,Default,,0,0,0,,Біздің жоспарларымызды кім ашты?
Dialogue: 0,0:08:09.00,0:08:11.68,Default,,0,0,0,,Speed Demon сіз үшін шешілді
Dialogue: 0,0:08:11.68,0:08:14.67,Default,,0,0,0,,Бұл ауыз аяқтарыңыздан жылдамырақ қозғалады.
Dialogue: 0,0:08:14.67,0:08:17.06,Default,,0,0,0,,Мен? Бұл сөзсіз Hyperion
Dialogue: 0,0:08:17.06,0:08:20.68,Default,,0,0,0,,Үлкен ауыз, мені ұрмай, ұрысып қалсаң, бұлай болмас еді.
Dialogue: 0,0:08:20.68,0:08:24.33,Default,,0,0,0,,Мен сенің үлкен аузыңды айтып тұрған жоқпын. Мен шындықты айтып тұрмын.
Dialogue: 0,0:08:24.33,0:08:27.72,Default,,0,0,0,,Бұл жаңа емес пе? Мен үндемеймін
Dialogue: 0,0:08:27.72,0:08:30.34,Default,,0,0,0,,Мен сөйлер алдында ойланамын
Dialogue: 0,0:08:30.34,0:08:32.77,Default,,0,0,0,,Неге бір рет байқамайсың, ақымақ?
Dialogue: 0,0:08:32.77,0:08:34.67,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:08:34.67,0:08:38.33,Default,,0,0,0,,Кек алушылар жоғалып кетті. Енді олар жеке қозғала алады.
Dialogue: 0,0:08:38.33,0:08:40.66,Default,,0,0,0,,Енді жерді тауларға бөлейік.
Dialogue: 0,0:08:40.66,0:08:43.01,Default,,0,0,0,,Мен сол аймақты аламын.
Dialogue: 0,0:08:43.01,0:08:45.67,Default,,0,0,0,,Неліктен бірінші таңдайсыз?
Dialogue: 0,0:08:45.67,0:08:48.00,Default,,0,0,0,,Бөлу туралы шешім қабылданған.
Dialogue: 0,0:08:48.00,0:08:52.02,Default,,0,0,0,,Бұл жақсы. Мен сендермен бірге әрекет етудің қажеті жоқ деп ойлаймын.
Dialogue: 0,0:08:52.02,0:08:54.69,Default,,0,0,0,,[Радио] (Сарда) Мен өз территориямды билеймін.
Dialogue: 0,0:08:54.69,0:08:57.33,Default,,0,0,0,,[Радио] (Speed ​​Demon) Мен сендерді енді көргім келмейді.
Dialogue: 0,0:08:57.33,0:08:59.33,Default,,0,0,0,,Біз мұны жасадық! Сызат
Dialogue: 0,0:08:59.33,0:09:01.33,Default,,0,0,0,,Бұл үлкен мәселе, Сэм.
Dialogue: 0,0:09:01.33,0:09:04.99,Default,,0,0,0,,Тіпті Nighthawk да сіздің оларды жылжытып жатқаныңызды жоққа шығара алмайды.
Dialogue: 0,0:09:04.99,0:09:07.01,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:09:07.01,0:09:10.01,Default,,0,0,0,,Біз жоқта топты басқарғаны үшін Сэмге рахмет.
Dialogue: 0,0:09:10.01,0:09:12.99,Default,,0,0,0,,Бақытты қате есептеу.
Dialogue: 0,0:09:12.99,0:09:16.41,Default,,0,0,0,,Бөлінген кезде оларға шабуыл жасаңыз.
Dialogue: 0,0:09:16.41,0:09:18.33,Default,,0,0,0,,Сіз өз миссияңызды білесіз.
Dialogue: 0,0:09:18.33,0:09:21.37,Default,,0,0,0,,Жерімізді қайтарып алайық
Dialogue: 0,0:09:21.37,0:09:25.36,Default,,0,0,0,,Мен ауызша балағаттап, мақтанғаным жетерлік.
Dialogue: 0,0:09:25.36,0:09:29.66,Default,,0,0,0,,Сіздің территорияңызды робот полициясыз сәтті басқара алатыныңызды білу қызықты болады.
Dialogue: 0,0:09:32.35,0:09:35.67,Default,,0,0,0,,Не! Кек алушылар!?
Dialogue: 0,0:09:35.67,0:09:38.69,Default,,0,0,0,,Амал жоқ, оларды жеңу керек еді.
Dialogue: 0,0:09:38.69,0:09:41.34,Default,,0,0,0,,Кім кек алушылар болып көрінеді?
Dialogue: 0,0:09:41.34,0:09:44.01,Default,,0,0,0,,Мен сені тауып, құртамын.
Dialogue: 0,0:09:44.01,0:09:46.34,Default,,0,0,0,,Іздеу қиын, сондықтан мен осында келдім.
Dialogue: 0,0:09:46.34,0:09:48.38,Default,,0,0,0,,Құлыпты өзгертуді ұмытып қалдыңыз.
Dialogue: 0,0:09:48.38,0:09:50.68,Default,,0,0,0,,Сіз оны иеленетін адам қалмады деп ойладыңыз ба?
Dialogue: 0,0:09:50.68,0:09:54.04,Default,,0,0,0,,Өзіңізді алдамаңыз! Тони Старкты жеңу керек еді.
Dialogue: 0,0:09:54.04,0:09:56.34,Default,,0,0,0,,Мүмкін деректер қате болған шығар?
Dialogue: 0,0:09:56.34,0:09:58.69,Default,,0,0,0,,Ей, уақыт жоғалтуды доғарайық.
Dialogue: 0,0:09:58.69,0:10:03.03,Default,,0,0,0,,Мен сенен бір рет сұраймын: беріл, мен саған көмектесемін.
Dialogue: 0,0:10:03.03,0:10:06.03,Default,,0,0,0,,Жалған болса да, мен сені бұл жерден тірі қалдырмаймын.
Dialogue: 0,0:10:08.02,0:10:10.02,Default,,0,0,0,,Сонда жауап жоқ па?
Dialogue: 0,0:11:13.33,0:11:17.35,Default,,0,0,0,,Ғажайып қашу енді мүмкін болмайды, Старк.
Dialogue: 0,0:11:17.35,0:11:20.65,Default,,0,0,0,,Жарғыш мылтық? Бізде Тор бар.
Dialogue: 0,0:11:22.99,0:11:25.99,Default,,0,0,0,,Жоқ! Майорния, кел!
Dialogue: 0,0:11:29.66,0:11:32.67,Default,,0,0,0,,Мен осы сәтті күттім
Dialogue: 0,0:11:32.67,0:11:34.67,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:34.67,0:11:36.67,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:11:36.67,0:11:39.67,Default,,0,0,0,,Мен сізді назардан тыс қалдырмаймын, бірақ менің шұғыл жұмысым бар.
Dialogue: 0,0:11:41.66,0:11:43.69,Default,,0,0,0,,ｽﾀｰｸ！
Dialogue: 0,0:11:43.69,0:11:47.75,Default,,0,0,0,,Эскадрилья! Кек алушылар тірі. Қазір мұнараға жиналыңыз.
Dialogue: 0,0:11:47.75,0:11:51.00,Default,,0,0,0,,[Спикер] Өкінішке орай, мен сізге достарыммен байланысуға рұқсат бермеймін.
Dialogue: 0,0:11:51.00,0:11:54.67,Default,,0,0,0,,Hyperion Salda Мені біреу бар ма?
Dialogue: 0,0:11:54.67,0:11:56.67,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:00.34,0:12:02.34,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:12:04.70,0:12:06.73,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:12:06.73,0:12:09.87,Default,,0,0,0,,Сіз әлі түсіндіңіз бе? Бұл ел Nighthawk-қа берілді.
Dialogue: 0,0:12:09.87,0:12:11.84,Default,,0,0,0,,Мен билеушімін
Dialogue: 0,0:12:11.84,0:12:14.03,Default,,0,0,0,,Баяу қозғалатын бастықтар ұнатпайды.
Dialogue: 0,0:12:14.03,0:12:16.69,Default,,0,0,0,,Hawkeye? Сіз оны жұлып алуыңыз керек еді.
Dialogue: 0,0:12:16.69,0:12:18.69,Default,,0,0,0,,Бұл жай ғана солай емес пе?
Dialogue: 0,0:12:21.68,0:12:24.68,Default,,0,0,0,,Хехе, қашып кетейін деп жатырсың ба? Бұл күлкілі
Dialogue: 0,0:12:26.67,0:12:30.01,Default,,0,0,0,,Уф... Бұл не?
Dialogue: 0,0:12:30.01,0:12:34.51,Default,,0,0,0,,Сіздің қуатыңыз негізінен жоғары жылдамдықпен қозғалатын кинетикалық энергия болып табылады.
Dialogue: 0,0:12:34.51,0:12:36.91,Default,,0,0,0,,Бұл қораптың ішінде пайдасыз.
Dialogue: 0,0:12:36.91,0:12:38.95,Default,,0,0,0,,Бұл соңы деп ойлайсыз ба?
Dialogue: 0,0:12:38.95,0:12:42.17,Default,,0,0,0,,Жоқ, бірақ бұл Халк бар қорап болса, бұл басқа әңгіме, солай емес пе?
Dialogue: 0,0:12:42.17,0:12:45.54,Default,,0,0,0,,Сіз мені өткен күні қатты жылдамдықпен жылжыттыңыз, мен сізге өтемін.
Dialogue: 0,0:12:45.54,0:12:47.56,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:12:47.56,0:12:50.18,Default,,0,0,0,,Күте тұрыңыз! Апыр-ай!
Dialogue: 0,0:12:50.18,0:12:52.83,Default,,0,0,0,,Қараңызшы, бұл жылдамдық белдігі. Дәл тапсырыс бергендей.
Dialogue: 0,0:12:52.83,0:12:55.13,Default,,0,0,0,,Тони, бұл екінші кезең.
Dialogue: 0,0:12:57.85,0:13:00.24,Default,,0,0,0,,Осы жолы оның қашып кетуіне жол бересіз бе? Тор Одинсон
Dialogue: 0,0:13:00.24,0:13:03.77,Default,,0,0,0,,Біз сенің нағыз жауынгер емес екеніңді білеміз.
Dialogue: 0,0:13:03.77,0:13:06.16,Default,,0,0,0,,Мен жақсы құтыла алатын сияқтымын.
Dialogue: 0,0:13:06.16,0:13:08.15,Default,,0,0,0,,Сіздің отбасыңыз тамаша аңшы.
Dialogue: 0,0:13:08.15,0:13:10.33,Default,,0,0,0,,Есіміңді бүлдірме.
Dialogue: 0,0:13:10.33,0:13:14.49,Default,,0,0,0,,Ең намыссыз нәрсе – адам жағына шығу!
Dialogue: 0,0:13:14.49,0:13:16.99,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:13:16.99,0:13:19.01,Default,,0,0,0,,Адамдар эскадрильялардан ерекшеленеді➡
Dialogue: 0,0:13:19.01,0:13:21.66,Default,,0,0,0,,Бірлескен жұмыстың күшін білеміз.
Dialogue: 0,0:13:21.66,0:13:24.00,Default,,0,0,0,,Сіз сенімдісіз бе? Falcon!
Dialogue: 0,0:13:24.00,0:13:26.83,Default,,0,0,0,,Мен сізге аздап қуат беремін.
Dialogue: 0,0:13:26.83,0:13:28.83,Default,,0,0,0,,Сатқын!
Dialogue: 0,0:13:28.83,0:13:31.34,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:13:31.34,0:13:34.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:34.34,0:13:37.01,Default,,0,0,0,,Сіз мені контейнерге қамап отырсыз ба?
Dialogue: 0,0:13:37.01,0:13:40.68,Default,,0,0,0,,Кешіріңіз, бірақ мен бүгін істей алмаймын. Тек бүгін емес, мәңгілік.
Dialogue: 0,0:13:40.68,0:13:42.66,Default,,0,0,0,,[Радио] (Сұңқар) Тони, сіздің пакетіңіз келеді.
Dialogue: 0,0:13:42.66,0:13:44.83,Default,,0,0,0,,Жақсы уақыт! (Сарда) Уау!
Dialogue: 0,0:13:44.83,0:13:47.17,Default,,0,0,0,,Салда? (Сарда) Мен тоқтай алмаймын!
Dialogue: 0,0:13:47.17,0:13:50.69,Default,,0,0,0,,Сұңқар, жәшіктерге тағы екі адам жиналды.
Dialogue: 0,0:13:50.69,0:13:55.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:55.01,0:13:57.33,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:13:57.33,0:13:59.33,Default,,0,0,0,,Енді, Антоман!
Dialogue: 0,0:14:01.67,0:14:04.35,Default,,0,0,0,,Сәлем! Апыр-ай!
Dialogue: 0,0:14:04.35,0:14:07.15,Default,,0,0,0,,Қош бол, менде Doctor Spectrum бар.
Dialogue: 0,0:14:10.01,0:14:12.34,Default,,0,0,0,,Осы соңғы реакцияны басатын құрылғымен➡
Dialogue: 0,0:14:12.34,0:14:16.00,Default,,0,0,0,,Призманың қуатын толық басқара алуыңыз керек.
Dialogue: 0,0:14:16.00,0:14:18.40,Default,,0,0,0,,Капитан Есіңізде ме?
Dialogue: 0,0:14:18.40,0:14:20.33,Default,,0,0,0,,А... бәрібір.
Dialogue: 0,0:14:20.33,0:14:23.19,Default,,0,0,0,,Ол күшті ерік-жігерді қажет етеді, бірақ ол бақылауда.
Dialogue: 0,0:14:23.19,0:14:31.85,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:31.85,0:14:34.17,Default,,0,0,0,,Призманың күшін көрсетейік!
Dialogue: 0,0:14:34.17,0:14:39.07,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:39.07,0:14:41.57,Default,,0,0,0,,Кек алушылар Мынаны қара! Біз жасадық!
Dialogue: 0,0:14:44.01,0:14:48.68,Default,,0,0,0,,Ақырында мен жалғыз басқаруға қолайлы жерге орналастым.
Dialogue: 0,0:14:48.68,0:14:50.68,Default,,0,0,0,,Боу?
Dialogue: 0,0:14:52.67,0:14:54.84,Default,,0,0,0,,Осы планетадан келген құрмет➡
Dialogue: 0,0:14:54.84,0:14:57.51,Default,,0,0,0,,Беретін ештеңе қалмағанша әкелсін.
Dialogue: 0,0:14:57.51,0:15:02.16,Default,,0,0,0,,ше? Бұл не?
Dialogue: 0,0:15:02.16,0:15:05.35,Default,,0,0,0,,Маған...
Dialogue: 0,0:15:05.35,0:15:08.00,Default,,0,0,0,,Сигнал!
Dialogue: 0,0:15:08.00,0:15:11.67,Default,,0,0,0,,Хахахаха... Қалай аман қалғаныңды білмеймін➡
Dialogue: 0,0:15:11.67,0:15:16.32,Default,,0,0,0,,Сене алмаймын, ең әлсіз, маған қарсы тұрар еді.
Dialogue: 0,0:15:16.32,0:15:18.68,Default,,0,0,0,,А... иә? Апыр-ай!
Dialogue: 0,0:15:18.68,0:15:22.00,Default,,0,0,0,,Қуатыңыздың көзі - сары күннің толқын ұзындығы
Dialogue: 0,0:15:22.00,0:15:25.37,Default,,0,0,0,,Бірақ күн көгерген кезде оқиға өзгереді.
Dialogue: 0,0:15:25.37,0:15:29.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:29.92,0:15:32.66,Default,,0,0,0,,Тек сенімді болу үшін... Уф...
Dialogue: 0,0:15:32.66,0:15:35.66,Default,,0,0,0,,Әлсіз кек алушылар жоқ!
Dialogue: 0,0:15:35.66,0:15:48.51,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:48.51,0:15:52.36,Default,,0,0,0,,Tower технологиясын қайтару оңай болды.
Dialogue: 0,0:15:52.36,0:15:54.38,Default,,0,0,0,,Сізден кім алдады деп ойлайсыз?
Dialogue: 0,0:15:54.38,0:15:56.68,Default,,0,0,0,,Бұл сен бе!
Dialogue: 0,0:15:56.68,0:15:58.68,Default,,0,0,0,,Жоқ, бұл команданың күші.
Dialogue: 0,0:15:58.68,0:16:02.04,Default,,0,0,0,,Сұңқардың арқасында мен әр эскадрильяны бір-бірден нысанаға алдым.
Dialogue: 0,0:16:02.04,0:16:05.67,Default,,0,0,0,,Nighthawk Сіз маған бұрын қосылуымды сұрағансыз, солай ма?
Dialogue: 0,0:16:05.67,0:16:08.18,Default,,0,0,0,,Менің таңдауым қате болған жоқ.
Dialogue: 0,0:16:08.18,0:16:11.98,Default,,0,0,0,,Эскадрильяда жалғыз сен қалдың. Сіз ұзаққа бармайсыз.
Dialogue: 0,0:16:11.98,0:16:14.33,Default,,0,0,0,,Әрине маған➡
Dialogue: 0,0:16:14.33,0:16:17.50,Default,,0,0,0,,Мендегі жалғыз күш күтпеген жағдайларға арналған.
Dialogue: 0,0:16:17.50,0:16:20.89,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:20.89,0:16:23.16,Default,,0,0,0,,Мен мұнда келгеніме қуаныштымын, Түнгі сұңқар
Dialogue: 0,0:16:23.16,0:16:25.49,Default,,0,0,0,,Ол көгілдір күн астындағы котенка
Dialogue: 0,0:16:25.49,0:16:28.33,Default,,0,0,0,,Сондықтан маған сен керек едің, Ньюк.
Dialogue: 0,0:16:28.33,0:16:31.65,Default,,0,0,0,,Жаса!
Dialogue: 0,0:16:31.65,0:16:34.00,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:16:34.00,0:16:38.17,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:16:38.17,0:16:41.54,Default,,0,0,0,,Қосымша қуатқа ие болу ешқашан жақсы идея емес.
Dialogue: 0,0:16:41.54,0:16:48.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:48.33,0:16:50.33,Default,,0,0,0,,Нью-Йорк Рахмет
Dialogue: 0,0:16:50.33,0:16:53.35,Default,,0,0,0,,Мен кек алушыларға не істей алатынымды көрсетемін!
Dialogue: 0,0:16:53.35,0:17:02.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:02.33,0:17:05.98,Default,,0,0,0,,Жер біздің бақылауымызға лайық емес болып шықты.
Dialogue: 0,0:17:05.98,0:17:08.00,Default,,0,0,0,,Үкім шығарылды
Dialogue: 0,0:17:08.00,0:17:13.16,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:13.16,0:17:16.66,Default,,0,0,0,,Avengers Nighthawk Hyperion-ты ең жақсы қаруға айналдырды➡
Dialogue: 0,0:17:16.66,0:17:19.66,Default,,0,0,0,,Олар Жерді жарып жібермекші. Оны дереу тоқтатыңыз!
Dialogue: 0,0:18:24.08,0:18:28.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:28.35,0:18:31.72,Default,,0,0,0,,Сәлем, Сұңқар. Ол өзінің жаңа басшылығымен Жерді жарып жібермекші →
Dialogue: 0,0:18:31.72,0:18:34.02,Default,,0,0,0,,Hyperion туралы бірдеңе жасаңыз.
Dialogue: 0,0:18:34.02,0:18:38.02,Default,,0,0,0,,Біз қолайсыз жағдайдамыз, бірақ біз жеңе алмаймыз. Бізде призманың күші бар.
Dialogue: 0,0:18:39.99,0:18:42.01,Default,,0,0,0,,Тағы бір нәрсе айтқыңыз келеді ме?
Dialogue: 0,0:18:42.01,0:18:44.01,Default,,0,0,0,,Уау!!
Dialogue: 0,0:18:54.69,0:18:59.01,Default,,0,0,0,,Мен ғарыштық қуат сапарларын жек көремін!
Dialogue: 0,0:18:59.01,0:19:02.67,Default,,0,0,0,,Бұл супер экспресс болды. (Сұңқар көз) Келесі жолы әр станцияда тоқтау керек...
Dialogue: 0,0:19:02.67,0:19:04.67,Default,,0,0,0,,Призманың күші жойылды
Dialogue: 0,0:19:04.67,0:19:07.32,Default,,0,0,0,,Күнді көгілдір ету үшін қолданылады
Dialogue: 0,0:19:07.32,0:19:09.67,Default,,0,0,0,,Бұл ұят, себебі бұл қазір пайдалы болар еді.
Dialogue: 0,0:19:09.67,0:19:13.33,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:19:13.33,0:19:15.35,Default,,0,0,0,,Бұл түнгі сұңқар.
Dialogue: 0,0:19:15.35,0:19:18.02,Default,,0,0,0,,Батып бара жатқан кемеден қашқан тышқан сияқты.
Dialogue: 0,0:19:18.02,0:19:20.02,Default,,0,0,0,,Әлі батқан жоқ
Dialogue: 0,0:19:20.02,0:19:22.39,Default,,0,0,0,,Тіпті Nighthawk бастаманы өз қолына алуға ниетті болса да →
Dialogue: 0,0:19:22.39,0:19:25.01,Default,,0,0,0,,Кек алушылар енді ешқашан алданбайды.
Dialogue: 0,0:19:25.01,0:19:28.34,Default,,0,0,0,,Ах. Мен бүгін көп нәрсені білдім, Сұңқар.
Dialogue: 0,0:19:28.34,0:19:32.01,Default,,0,0,0,,Nighthawk-ті маған қалдырыңыз. Hyperion туралы не деуге болады?
Dialogue: 0,0:19:32.01,0:19:34.51,Default,,0,0,0,,Үңгірді зерттеу уақыты келді.
Dialogue: 0,0:19:36.52,0:19:40.62,Default,,0,0,0,,Жол Сатурннан тыс. Бұл планеталар арасындағы кеңістік.
Dialogue: 0,0:19:44.51,0:19:46.51,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:19:51.67,0:19:53.67,Default,,0,0,0,,Ой! Уф...
Dialogue: 0,0:19:53.67,0:19:57.00,Default,,0,0,0,,Старк, мен сенен мұндай ақымақ болады деп күтпеген едім.
Dialogue: 0,0:19:57.00,0:20:01.99,Default,,0,0,0,,Жаңа қаруларды сынап көру туралы ойлау. Мен команданы тыңдаймын.
Dialogue: 0,0:20:01.99,0:20:03.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:03.99,0:20:05.99,Default,,0,0,0,,Уау!!
Dialogue: 0,0:20:08.02,0:20:10.33,Default,,0,0,0,,Бұл жылдамдықта Hyperion бірнеше минуттан кейін → болады
Dialogue: 0,0:20:10.33,0:20:12.34,Default,,0,0,0,,Жердің өзегін шайқай бастайды
Dialogue: 0,0:20:12.34,0:20:15.04,Default,,0,0,0,,Сіз өте жылдам жұмыс жасайсыз.
Dialogue: 0,0:20:24.00,0:20:26.68,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ！
Dialogue: 0,0:20:26.68,0:20:31.06,Default,,0,0,0,,Олар өз қабірлеріне секірген сияқты.
Dialogue: 0,0:20:31.06,0:20:33.36,Default,,0,0,0,,Уау!!
Dialogue: 0,0:20:36.34,0:20:38.35,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:20:38.35,0:20:41.70,Default,,0,0,0,,Бұл планетаны жойсақ, достарымыз да құтқарылмайды!
Dialogue: 0,0:20:41.70,0:20:44.33,Default,,0,0,0,,Достар құралдан басқа ештеңе емес
Dialogue: 0,0:20:44.33,0:20:47.33,Default,,0,0,0,,Ал егер құралдар жарамсыз болса, оларды жай ғана лақтырып тастаңыз.
Dialogue: 0,0:20:50.67,0:20:53.03,Default,,0,0,0,,Менің сенің айырмашылығым осы.
Dialogue: 0,0:20:53.03,0:20:56.33,Default,,0,0,0,,Маған өз командам ұнайды. Бұл мені күштірек етеді.
Dialogue: 0,0:20:56.33,0:20:59.52,Default,,0,0,0,,Мен эскадрильялардың достығы нығая түссе екен.
Dialogue: 0,0:20:59.52,0:21:02.35,Default,,0,0,0,,Күшті болу үшін басқалардың қажеті жоқ
Dialogue: 0,0:21:02.35,0:21:04.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:04.66,0:21:06.67,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:21:06.67,0:21:09.84,Default,,0,0,0,,Ух... түсіндім. Бұл ашық реактор ма?
Dialogue: 0,0:21:09.84,0:21:14.64,Default,,0,0,0,,Басқа да айырмашылықтар болды. Менде ондай кемшіліктер жоқ.
Dialogue: 0,0:21:16.73,0:21:18.79,Default,,0,0,0,,Хамф!
Dialogue: 0,0:21:18.79,0:21:20.67,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:20.67,0:21:25.57,Default,,0,0,0,,Squadron Supreme барлық жағынан Кек алушылардан жақсы!
Dialogue: 0,0:21:27.66,0:21:29.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:29.68,0:21:32.33,Default,,0,0,0,,Түнгі сұңқар сені Жерге тастап қашып кетті.
Dialogue: 0,0:21:32.33,0:21:34.33,Default,,0,0,0,,Адал болу қажет емес!
Dialogue: 0,0:21:34.33,0:21:37.34,Default,,0,0,0,,Nighthawk - қажетті одақтас. Ол дос емес.
Dialogue: 0,0:21:37.34,0:21:40.01,Default,,0,0,0,,Бізді байланыстыратын нәрсе – күш!
Dialogue: 0,0:21:40.01,0:21:42.66,Default,,0,0,0,,Қуат таусылғанда →
Dialogue: 0,0:21:42.66,0:21:45.00,Default,,0,0,0,,Гиперион аяқталды. Күресуді жалғастырыңыз!
Dialogue: 0,0:21:45.00,0:21:47.35,Default,,0,0,0,,Түсінді. Оны маған қалдырыңыз.
Dialogue: 0,0:21:47.35,0:21:49.35,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:58.34,0:22:00.34,Default,,0,0,0,,Менің жаным… Ұйықтар алдында әр түн сайын➡
Dialogue: 0,0:22:02.33,0:22:04.67,Default,,0,0,0,,Ой... бұл топтық жұмыс
Dialogue: 0,0:22:04.67,0:22:06.67,Default,,0,0,0,,Неге бір рет жасап көрмеске?
Dialogue: 0,0:22:06.67,0:22:08.65,Default,,0,0,0,,Хмф!
Dialogue: 0,0:22:08.65,0:22:10.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:10.65,0:22:12.66,Default,,0,0,0,,Уау! Ах... Уф...
Dialogue: 0,0:22:12.66,0:22:14.66,Default,,0,0,0,,Хамф!
Dialogue: 0,0:22:14.66,0:22:16.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:16.99,0:22:18.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:26.99,0:22:28.99,Default,,0,0,0,,Уау!!
Dialogue: 0,0:22:28.99,0:22:31.49,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:22:31.49,0:22:34.19,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:22:34.19,0:22:46.97,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:46.97,0:22:48.99,Default,,0,0,0,,Мен мұндай нәрселерге әрдайым шебер болдым, көріп тұрсың ғой.
Dialogue: 0,0:22:48.99,0:22:52.33,Default,,0,0,0,,Ха~!!
Dialogue: 0,0:22:52.33,0:22:54.36,Default,,0,0,0,,Бірақ Гиперионның күші➡
Dialogue: 0,0:22:54.36,0:22:56.68,Default,,0,0,0,,Бұл азайып бара жатқан жоқ сияқты.
Dialogue: 0,0:22:56.68,0:23:06.16,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:06.16,0:23:09.50,Default,,0,0,0,,Тоқташы, бетпердесіз беймаза көрінесің.
Dialogue: 0,0:23:09.50,0:23:12.67,Default,,0,0,0,,Күш-қуатыңыздан айырылып, сауытыңыз жартылай сынды.
Dialogue: 0,0:23:12.67,0:23:15.17,Default,,0,0,0,,Мен бұл кемеге мінген кезде, мен ойынның желіде екенін білдім➡
Dialogue: 0,0:23:15.17,0:23:17.19,Default,,0,0,0,,Байқауым керек еді.
Dialogue: 0,0:23:17.19,0:23:30.32,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:30.32,0:23:32.34,Default,,0,0,0,,Мен мұны күтпеген едім.
Dialogue: 0,0:23:32.34,0:23:35.34,Default,,0,0,0,,Сұңқардан үйренді
Dialogue: 0,0:23:35.34,0:23:37.32,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:23:37.32,0:23:39.49,Default,,0,0,0,,Магниттік полюстерді кері айналдырдыңыз ба?
Dialogue: 0,0:23:39.49,0:23:41.51,Default,,0,0,0,,Сіз кемені жоймақшысыз ба?
Dialogue: 0,0:23:41.51,0:23:45.00,Default,,0,0,0,,Не болды, жауыз? Бұл сіз күткендей емес пе?
Dialogue: 0,0:23:45.00,0:23:47.00,Default,,0,0,0,,Қап…
Dialogue: 0,0:23:52.07,0:23:54.68,Default,,0,0,0,,Гиперион әлі де жердің өзегіне жетуге қабілетті.
Dialogue: 0,0:23:54.68,0:23:56.99,Default,,0,0,0,,Мен оны одан да күшті күшпен құлатуым керек.
Dialogue: 0,0:23:56.99,0:23:59.00,Default,,0,0,0,,Егер мен сізге күшейтуді сұрауға болатынын айтсам, не істер едіңіз?
Dialogue: 0,0:23:59.00,0:24:02.17,Default,,0,0,0,,Бұл өте үлкен армия. Не айтқың келеді?
Dialogue: 0,0:24:02.17,0:24:04.57,Default,,0,0,0,,Адамдар жер бетінде өмір сүретін жалғыз адамдар емес
Dialogue: 0,0:24:07.15,0:24:09.66,Default,,0,0,0,,Олар жәндіктерді➡ деп атады
Dialogue: 0,0:24:09.66,0:24:12.09,Default,,0,0,0,,Мен Жердің жойылғанын қаламаймын.
Dialogue: 0,0:24:12.09,0:24:17.00,Default,,0,0,0,,Уау! Сәлем!
Dialogue: 0,0:24:17.00,0:24:19.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:19.33,0:24:22.17,Default,,0,0,0,,Уф... мына жігіттерге бірдеңе жасаңыз!
Dialogue: 0,0:24:22.17,0:24:25.07,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:24:30.58,0:24:32.66,Default,,0,0,0,,Бұл сен кінәлісің, Старк!
Dialogue: 0,0:24:32.66,0:24:34.66,Default,,0,0,0,,Ой!
Dialogue: 0,0:24:43.51,0:24:47.11,Default,,0,0,0,,Көрдіңіз бе? Nighthawk: Күшті одақтастардың болғаны тиімді.
Dialogue: 0,0:24:52.43,0:24:54.99,Default,,0,0,0,,Гиперион, тезірек маған көмектес!
Dialogue: 0,0:24:54.99,0:24:58.01,Default,,0,0,0,,Анықтама? Мен қате естідім бе?
Dialogue: 0,0:24:58.01,0:25:00.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:06.00,0:25:10.17,Default,,0,0,0,,Жақсы, бәрі Кек алушылар үшін.
Dialogue: 0,0:25:10.17,0:25:12.69,Default,,0,0,0,,Ах... Көмек келді.
Dialogue: 0,0:25:12.69,0:25:14.66,Default,,0,0,0,,Не!?
Dialogue: 0,0:25:14.66,0:25:17.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:17.06,0:25:19.33,Default,,0,0,0,,Әй, мен саған қол ұшын созайын.
Dialogue: 0,0:25:19.33,0:25:23.18,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:25:23.18,0:25:26.02,Default,,0,0,0,,Жоқ, тіпті хош иісті шамдар➡
Dialogue: 0,0:25:26.02,0:25:29.37,Default,,0,0,0,,Мен Hyperion Neo-ны бөлмемнен шығара алмаймын.
Dialogue: 0,0:25:29.37,0:25:32.41,Default,,0,0,0,,Сіз шыны фигураны ұстамаған боларсыз.
Dialogue: 0,0:25:32.41,0:25:34.44,Default,,0,0,0,,Бұл... хаха
Dialogue: 0,0:25:34.44,0:25:38.01,Default,,0,0,0,,Ішке кірмеген дұрыс шығар. Не!?
Dialogue: 0,0:25:38.01,0:25:42.05,Default,,0,0,0,,Біз эскадрильяларды Қалқан ғимаратында орналастыра аламыз ба?
Dialogue: 0,0:25:42.05,0:25:45.09,Default,,0,0,0,,Олар үшін жаңа нысан салған көрінеді.
Dialogue: 0,0:25:45.09,0:25:47.00,Default,,0,0,0,,Әр адамды жалғыз қалдырсаңыз➡
Dialogue: 0,0:25:47.00,0:25:49.49,Default,,0,0,0,,Эскадрон енді ештеңе істей алмайды.
Dialogue: 0,0:25:49.49,0:25:51.51,Default,,0,0,0,,Командадан күшті ештеңе жоқ.
Dialogue: 0,0:25:51.51,0:25:54.51,Default,,0,0,0,,Сондықтан логотипті дұрыс кию керек.
Dialogue: 0,0:25:54.51,0:25:57.70,Default,,0,0,0,,Ах, бұл бәрібір болуы керек.
Dialogue: 0,0:25:57.70,0:26:01.10,Default,,0,0,0,,Жарайды, кек алушылар, жұмысқа қайта оралайық!
Dialogue: 0,0:26:36.04,0:26:38.06,Default,,0,0,0,,<“Кек алушылар жиналуда”➡ пайда болады
Dialogue: 0,0:26:38.06,0:26:40.09,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:40.09,0:26:42.18,Default,,0,0,0,,Осы жерге жинаңыз
Dialogue: 0,0:26:42.18,0:26:45.85,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:45.85,0:26:49.52,Default,,0,0,0,,Сәтсіз экспериментке байланысты мен гамма-сәуле энергиясының көп мөлшеріне ұшырадым➡
Dialogue: 0,0:26:49.52,0:26:53.00,Default,,0,0,0,,Ғалым Брюс Баннер жасыл алыпқа айналады
Dialogue: 0,0:26:53.00,0:26:57.01,Default,,0,0,0,,Ашуы артқан сайын, ол шексіз күшпен талқандалады＞
Dialogue: 0,0:26:57.01,0:26:58.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:58.98,0:27:00.98,Default,,0,0,0,,Иә! Ой…
Dialogue: 0,0:27:02.48,0:27:08.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
