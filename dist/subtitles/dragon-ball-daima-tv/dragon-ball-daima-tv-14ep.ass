Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:05.04,Default,,0000,0000,0000,,[Айдаһар шары дегеніміз не?
Dialogue: 0,0:00:02.04,0:00:05.04,Default,,0000,0000,0000,,7 бөлікті жинап, құпия сөзді айт➡
Dialogue: 0,0:00:05.04,0:00:08.04,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:05.04,0:00:08.04,Default,,0000,0000,0000,,Шенрон пайда болады➡
Dialogue: 0,0:00:08.04,0:00:13.05,Default,,0000,0000,0000,,Кез келген тілек орындалады
Dialogue: 0,0:00:08.04,0:00:13.05,Default,,0000,0000,0000,,Бұл жұмбақ доп]
Dialogue: 0,0:00:13.05,0:00:20.05,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:00:13.05,0:00:20.05,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:00:13.05,0:00:20.05,Default,,0000,0000,0000,,[Сон Гоку әлі зұлымдық қолынан құтылған.
Dialogue: 0,0:00:13.05,0:00:20.05,Default,,0000,0000,0000,,Жерді қорғауды жалғастыру]
Dialogue: 0,0:00:20.05,0:00:30.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:05.02,0:02:07.03,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:02:07.03,0:02:11.03,Default,,0000,0000,0000,,Өте жақсы.
Dialogue: 0,0:02:07.03,0:02:11.03,Default,,0000,0000,0000,,Мен өзімді бұрынғыдан жақсы сезінемін. ➡
Dialogue: 0,0:02:11.03,0:02:14.03,Default,,0000,0000,0000,,Сіз күткендей, Панджи.
Dialogue: 0,0:02:14.03,0:02:16.00,Default,,0000,0000,0000,,Олар Жапонияда, анамды күтіп, оны қауіпсіз ұстап отыр ➡
Dialogue: 0,0:02:19.04,0:02:21.04,Default,,0000,0000,0000,,🔊 (рингтон)
Dialogue: 0,0:02:21.04,0:02:22.71,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:22.71,0:02:25.04,Default,,0000,0000,0000,,🔊
Dialogue: 0,0:02:25.04,0:02:28.05,Default,,0000,0000,0000,,🔊Панджи үшін осы жерді басыңыз
Dialogue: 0,0:02:25.04,0:02:28.05,Default,,0000,0000,0000,,Бұл Панджи. есту?
Dialogue: 0,0:02:28.05,0:02:32.99,Default,,0000,0000,0000,,Әй, ханшайым! Бұл Перал.
Dialogue: 0,0:02:28.05,0:02:32.99,Default,,0000,0000,0000,,Мен оны қалай да естимін.
Dialogue: 0,0:02:32.99,0:02:36.99,Default,,0000,0000,0000,,Не болды? Радио немесе бір нәрсе арқылы.
Dialogue: 0,0:02:36.99,0:02:39.99,Default,,0000,0000,0000,,🔊Ұялы телефон Кракен - құбыжық
Dialogue: 0,0:02:36.99,0:02:39.99,Default,,0000,0000,0000,,Мені жеп қойды.
Dialogue: 0,0:02:39.99,0:02:44.00,Default,,0000,0000,0000,,Иә! ? Сенімен бәрі жақсы ма?
Dialogue: 0,0:02:39.99,0:02:44.00,Default,,0000,0000,0000,,🔊Жарайды! ➡
Dialogue: 0,0:02:44.00,0:02:46.00,Default,,0000,0000,0000,,Оның орнына әкеңе айт. ➡
Dialogue: 0,0:02:46.00,0:02:49.00,Default,,0000,0000,0000,,Сондай-ақ екінші жын әлемінің Айдаһар шары
Dialogue: 0,0:02:46.00,0:02:49.00,Default,,0000,0000,0000,,Оны алыңыз➡
Dialogue: 0,0:02:49.00,0:02:51.67,Default,,0000,0000,0000,,Бұдан былай, бірінші жын әлемі
Dialogue: 0,0:02:49.00,0:02:51.67,Default,,0000,0000,0000,,Ол бортқа қонғалы жатыр.
Dialogue: 0,0:02:51.67,0:02:55.01,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:02:51.67,0:02:55.01,Default,,0000,0000,0000,,Бұл керемет!
Dialogue: 0,0:02:55.01,0:02:57.01,Default,,0000,0000,0000,,🔊Жақсы.
Dialogue: 0,0:02:57.01,0:03:00.01,Default,,0000,0000,0000,,Бірінші жын әлеміндегі патша
Dialogue: 0,0:02:57.01,0:03:00.01,Default,,0000,0000,0000,,Тым кіру ниетімен➡
Dialogue: 0,0:03:00.01,0:03:03.02,Default,,0000,0000,0000,,Ұшақ
Dialogue: 0,0:03:00.01,0:03:03.02,Default,,0000,0000,0000,,Сіз ұрлық жасап жатырсыз.
Dialogue: 0,0:03:03.02,0:03:05.02,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:03:05.02,0:03:08.02,Default,,0000,0000,0000,,Сыртқы әлемнен келген адамдар
Dialogue: 0,0:03:05.02,0:03:08.02,Default,,0000,0000,0000,,Өйткені ол өте күшті➡
Dialogue: 0,0:03:08.02,0:03:11.02,Default,,0000,0000,0000,,Өзіңізді мәжбүрлеудің қажеті жоқ
Dialogue: 0,0:03:08.02,0:03:11.02,Default,,0000,0000,0000,,Маған хабарлаңыз...
Dialogue: 0,0:03:11.02,0:03:14.03,Default,,0000,0000,0000,,🔊
Dialogue: 0,0:03:11.02,0:03:14.03,Default,,0000,0000,0000,,Түсінікті. Мен саған соны айтайын.
Dialogue: 0,0:03:14.03,0:03:18.03,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,0:03:14.03,0:03:18.03,Default,,0000,0000,0000,,🔊 (кесу дыбысы)
Dialogue: 0,0:03:18.03,0:03:21.03,Default,,0000,0000,0000,,Ол патша болғанымен
Dialogue: 0,0:03:18.03,0:03:21.03,Default,,0000,0000,0000,,Ұшақ ұрламақшысың ба?
Dialogue: 0,0:03:21.03,0:03:25.04,Default,,0000,0000,0000,,Орташа өлшемді ұшақтар нәзік.
Dialogue: 0,0:03:21.03,0:03:25.04,Default,,0000,0000,0000,,Бір ғана ұшақ болды.
Dialogue: 0,0:03:25.04,0:03:28.04,Default,,0000,0000,0000,,Патша десең де
Dialogue: 0,0:03:25.04,0:03:28.04,Default,,0000,0000,0000,,Біз бай емеспіз.
Dialogue: 0,0:03:28.04,0:03:31.98,Default,,0000,0000,0000,,Егер сіз Magilight алсаңыз
Dialogue: 0,0:03:28.04,0:03:31.98,Default,,0000,0000,0000,,Мен сендерге бірнеше ұшақтарды сыйлыққа беремін.
Dialogue: 0,0:03:31.98,0:03:35.95,Default,,0000,0000,0000,,Шынымен! ? бұл!
Dialogue: 0,0:03:31.98,0:03:35.95,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:03:41.99,0:03:44.99,Default,,0000,0000,0000,,Әскери полиция ше?
Dialogue: 0,0:03:44.99,0:03:47.99,Default,,0000,0000,0000,,Барлық дерлік персонал
Dialogue: 0,0:03:44.99,0:03:47.99,Default,,0000,0000,0000,,Күту.
Dialogue: 0,0:03:47.99,0:03:49.96,Default,,0000,0000,0000,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:03:52.00,0:03:55.00,Default,,0000,0000,0000,,Одан да көп...
Dialogue: 0,0:03:55.00,0:03:59.01,Default,,0000,0000,0000,,Оларға не болды! ?
Dialogue: 0,0:03:55.00,0:03:59.01,Default,,0000,0000,0000,,Сіз әлі келдіңіз бе? ?
Dialogue: 0,0:03:59.01,0:04:01.01,Default,,0000,0000,0000,,Әрине.
Dialogue: 0,0:04:01.01,0:04:05.01,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:04:01.01,0:04:05.01,Default,,0000,0000,0000,,Токусен
Dialogue: 0,0:04:01.01,0:04:05.01,Default,,0000,0000,0000,,Арнайы жасақ жиналды ма?
Dialogue: 0,0:04:05.01,0:04:07.01,Default,,0000,0000,0000,,Иә. Ана жерде.
Dialogue: 0,0:04:07.01,0:04:09.98,Default,,0000,0000,0000,,Иә? Хмм?
Dialogue: 0,0:04:18.02,0:04:20.03,Default,,0000,0000,0000,,Әму!
Dialogue: 0,0:04:20.03,0:04:23.03,Default,,0000,0000,0000,,(тамақтану дыбысы)
Dialogue: 0,0:04:23.03,0:04:27.00,Default,,0000,0000,0000,,Ах... Уф...
Dialogue: 0,0:04:29.04,0:04:30.97,Default,,0000,0000,0000,,
Dialogue: 0,0:04:30.97,0:04:32.97,Default,,0000,0000,0000,,Ах…. иә?
Dialogue: 0,0:04:32.97,0:04:34.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:36.98,0:04:38.98,Default,,0000,0000,0000,,Гунну….
Dialogue: 0,0:04:38.98,0:04:41.95,Default,,0000,0000,0000,,Бар... Гомер-сама~!
Dialogue: 0,0:04:47.99,0:04:49.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:57.00,0:04:58.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:04.00,0:05:06.01,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:05:06.01,0:05:08.98,Default,,0000,0000,0000,,Арнайы күштердің қолбасшысы Кадем!
Dialogue: 0,0:05:13.01,0:05:15.98,Default,,0000,0000,0000,,Екінші нөмір
Dialogue: 0,0:05:13.01,0:05:15.98,Default,,0000,0000,0000,,№2 арнайы жасақ Данима.
Dialogue: 0,0:05:18.69,0:05:20.69,Default,,0000,0000,0000,,Хи!
Dialogue: 0,0:05:20.69,0:05:23.96,Default,,0000,0000,0000,,Үшінші нөмір
Dialogue: 0,0:05:20.69,0:05:23.96,Default,,0000,0000,0000,,№3 арнайы жасақ Хилия!
Dialogue: 0,0:05:27.03,0:05:31.00,Default,,0000,0000,0000,,Төрт саны
Dialogue: 0,0:05:27.03,0:05:31.00,Default,,0000,0000,0000,,№4 арнайы жасақ Масим!
Dialogue: 0,0:05:34.97,0:05:38.24,Default,,0000,0000,0000,,Бесінші нөмір
Dialogue: 0,0:05:34.97,0:05:38.24,Default,,0000,0000,0000,,№5 арнайы жасақ Гаймой!
Dialogue: 0,0:05:40.64,0:05:42.64,Default,,0000,0000,0000,,Барлығы 5 адам...
Dialogue: 0,0:05:42.64,0:05:44.64,Default,,0000,0000,0000,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:05:44.64,0:05:46.61,Default,,0000,0000,0000,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:05:51.98,0:05:54.95,Default,,0000,0000,0000,,Кенпей Токусен
Dialogue: 0,0:05:51.98,0:05:54.95,Default,,0000,0000,0000,,Әскери полицияның арнайы жасағы!
Dialogue: 0,0:05:57.99,0:05:59.99,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:05:59.99,0:06:01.99,Default,,0000,0000,0000,,Ммм… Ммм….
Dialogue: 0,0:06:01.99,0:06:04.00,Default,,0000,0000,0000,,Хаха~!
Dialogue: 0,0:06:04.00,0:06:06.00,Default,,0000,0000,0000,,Кукуку.
Dialogue: 0,0:06:06.00,0:06:08.00,Default,,0000,0000,0000,,Хе хи! Хахахаха!
Dialogue: 0,0:06:08.00,0:06:09.97,Default,,0000,0000,0000,,Хи хи хи....
Dialogue: 0,0:06:12.00,0:06:15.01,Default,,0000,0000,0000,,А... аа....
Dialogue: 0,0:06:15.01,0:06:17.01,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:06:17.01,0:06:19.01,Default,,0000,0000,0000,,Ұлы жын лорд!
Dialogue: 0,0:06:19.01,0:06:24.02,Default,,0000,0000,0000,,Біз, супер элита
Dialogue: 0,0:06:19.01,0:06:24.02,Default,,0000,0000,0000,,Шақыруға қандай жағдайлар себепші болады?
Dialogue: 0,0:06:24.02,0:06:27.02,Default,,0000,0000,0000,,Хмм... Гохон!
Dialogue: 0,0:06:27.02,0:06:32.96,Default,,0000,0000,0000,,Бізге қарсы шыққан арсыз адамдар
Dialogue: 0,0:06:27.02,0:06:32.96,Default,,0000,0000,0000,,Олар осында шабуыл жасауы мүмкін.
Dialogue: 0,0:06:32.96,0:06:35.96,Default,,0000,0000,0000,,Сол
Dialogue: 0,0:06:32.96,0:06:35.96,Default,,0000,0000,0000,,Қандай ақымақ адамдар тобы.
Dialogue: 0,0:06:35.96,0:06:37.96,Default,,0000,0000,0000,,Сіз сенімдісіз бе? ➡
Dialogue: 0,0:06:37.96,0:06:40.97,Default,,0000,0000,0000,,Жау қазір екінші жын әлемінен.
Dialogue: 0,0:06:37.96,0:06:40.97,Default,,0000,0000,0000,,Біз осында келе жатырмыз. ➡
Dialogue: 0,0:06:40.97,0:06:42.97,Default,,0000,0000,0000,,Себебі мен Warp-sama➡-ды тоқтаттым
Dialogue: 0,0:06:42.97,0:06:47.97,Default,,0000,0000,0000,,Бұл бірінші жын әлеміне келудің құралы
Dialogue: 0,0:06:42.97,0:06:47.97,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:06:47.97,0:06:50.98,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:06:47.97,0:06:50.98,Default,,0000,0000,0000,,Ең нашар жағдайды қарастыру➡
Dialogue: 0,0:06:50.98,0:06:53.98,Default,,0000,0000,0000,,Келгендеріңізге рахмет.
Dialogue: 0,0:06:50.98,0:06:53.98,Default,,0000,0000,0000,,Сонымен.
Dialogue: 0,0:06:53.98,0:06:57.98,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:06:53.98,0:06:57.98,Default,,0000,0000,0000,,Айтпақшы, жау деген не?
Dialogue: 0,0:06:57.98,0:07:03.99,Default,,0000,0000,0000,,Сыртқы әлемнен келді
Dialogue: 0,0:06:57.98,0:07:03.99,Default,,0000,0000,0000,,Бірнеше балалар мен Үшінші жындар патшалығының жігіттері.
Dialogue: 0,0:07:03.99,0:07:07.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:03.99,0:07:07.99,Default,,0000,0000,0000,,Жаңа ғана брат дедіңіз бе?
Dialogue: 0,0:07:07.99,0:07:13.00,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:07:07.99,0:07:13.00,Default,,0000,0000,0000,,Нақтырақ айтсақ, ол бала кейпіндегі ересек адам.
Dialogue: 0,0:07:13.00,0:07:17.00,Default,,0000,0000,0000,,Иә? не? сол.
Dialogue: 0,0:07:17.00,0:07:22.01,Default,,0000,0000,0000,,Жарайды. бәрібір
Dialogue: 0,0:07:17.00,0:07:22.01,Default,,0000,0000,0000,,Баланың сыртқы түріне алданып қалмаңыз.
Dialogue: 0,0:07:22.01,0:07:26.01,Default,,0000,0000,0000,,Hmph.
Dialogue: 0,0:07:22.01,0:07:26.01,Default,,0000,0000,0000,,Ол бала ма, білмеймін➡
Dialogue: 0,0:07:26.01,0:07:29.02,Default,,0000,0000,0000,,Мұны бізге қалдырыңыз, ең күшті ➡
Dialogue: 0,0:07:29.02,0:07:32.95,Default,,0000,0000,0000,,Өзіңізді ваннаға түсіріңіз
Dialogue: 0,0:07:29.02,0:07:32.95,Default,,0000,0000,0000,,Көресіңдер әлі
Dialogue: 0,0:07:29.02,0:07:32.95,Default,,0000,0000,0000,,Фарт көпіршіктерімен ойнаңыз.
Dialogue: 0,0:07:32.95,0:07:34.95,Default,,0000,0000,0000,,Гаххахаха...!
Dialogue: 0,0:07:34.95,0:07:38.96,Default,,0000,0000,0000,,(Арнайы жасақ күлкі)
Dialogue: 0,0:07:38.96,0:07:40.96,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:07:38.96,0:07:40.96,Default,,0000,0000,0000,,Сақтықты төмендетпеңіз.
Dialogue: 0,0:07:40.96,0:07:43.96,Default,,0000,0000,0000,,Сиқыр
Dialogue: 0,0:07:40.96,0:07:43.96,Default,,0000,0000,0000,,Олар Маджин Бууды жеңді➡
Dialogue: 0,0:07:43.96,0:07:46.63,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:07:43.96,0:07:46.63,Default,,0000,0000,0000,,Тіпті Тамагамиді жеңген құбыжық.
Dialogue: 0,0:07:46.63,0:07:49.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:46.63,0:07:49.97,Default,,0000,0000,0000,,Маджин Бууда да Тамагами бар ма?
Dialogue: 0,0:07:49.97,0:07:53.97,Default,,0000,0000,0000,,Капитан. Әзіл, әзіл.
Dialogue: 0,0:07:53.97,0:07:56.98,Default,,0000,0000,0000,,Не! Сіз қалжындап тұрсыз ба? ➡
Dialogue: 0,0:07:56.98,0:07:59.98,Default,,0000,0000,0000,,Қазір мен қатты қорқамын
Dialogue: 0,0:07:56.98,0:07:59.98,Default,,0000,0000,0000,,Бұл кішкентай! ➡
Dialogue: 0,0:07:59.98,0:08:01.98,Default,,0000,0000,0000,,Гаххахаха...!
Dialogue: 0,0:08:01.98,0:08:06.99,Default,,0000,0000,0000,,(Арнайы жасақ күлкі)
Dialogue: 0,0:08:06.99,0:08:09.99,Default,,0000,0000,0000,,Қалжың емес! !
Dialogue: 0,0:08:09.99,0:08:13.99,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:08:09.99,0:08:13.99,Default,,0000,0000,0000,,Бұл сарайға мүлдем кірме. ➡
Dialogue: 0,0:08:13.99,0:08:15.96,Default,,0000,0000,0000,,Және...
Dialogue: 0,0:08:20.00,0:08:24.00,Default,,0000,0000,0000,,Лоббиді жөндеу шығындары
Dialogue: 0,0:08:20.00,0:08:24.00,Default,,0000,0000,0000,,Мен сізден кейінірек ақы аламын!
Dialogue: 0,0:08:24.00,0:08:25.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:37.02,0:08:41.02,Default,,0000,0000,0000,,Бұрынғы айтқаныма шындап қараймын ба деп ойлаймын...
Dialogue: 0,0:08:37.02,0:08:41.02,Default,,0000,0000,0000,,Ондай нәрсе бар ма?
Dialogue: 0,0:08:41.02,0:08:43.02,Default,,0000,0000,0000,,Бұл асыра сілтеу.
Dialogue: 0,0:08:43.02,0:08:48.03,Default,,0000,0000,0000,,Одан да көп
Dialogue: 0,0:08:43.02,0:08:48.03,Default,,0000,0000,0000,,Мен жеген картоп чипсы жақсы болды, солай ма?
Dialogue: 0,0:08:48.03,0:08:50.03,Default,,0000,0000,0000,,Бұл, әрине, жақсы болды.
Dialogue: 0,0:08:50.03,0:08:53.03,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:08:50.03,0:08:53.03,Default,,0000,0000,0000,,Бұл қайда сатылады?
Dialogue: 0,0:08:53.03,0:08:56.00,Default,,0000,0000,0000,,Бұл сарайдағы сауда дүкені ме?
Dialogue: 0,0:09:01.04,0:09:03.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:05.04,0:09:07.05,Default,,0000,0000,0000,,Кайошин
Dialogue: 0,0:09:05.04,0:09:07.05,Default,,0000,0000,0000,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:09:07.05,0:09:10.05,Default,,0000,0000,0000,,Варп-сама біртүрлі әрекет етеді.
Dialogue: 0,0:09:07.05,0:09:10.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:10.05,0:09:12.05,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:09:10.05,0:09:12.05,Default,,0000,0000,0000,,Тіпті жұлдырмайды.
Dialogue: 0,0:09:12.05,0:09:15.05,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:09:15.05,0:09:17.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:17.06,0:09:21.06,Default,,0000,0000,0000,,А, солай.
Dialogue: 0,0:09:21.06,0:09:24.06,Default,,0000,0000,0000,,Гомер және басқалары Варп-саманың қосқышын қосты.
Dialogue: 0,0:09:21.06,0:09:24.06,Default,,0000,0000,0000,,Сіз оны кесіп тастадыңыз.
Dialogue: 0,0:09:24.06,0:09:26.07,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:09:26.07,0:09:28.03,Default,,0000,0000,0000,,Тек оны ашыңыз.
Dialogue: 0,0:09:33.01,0:09:36.01,Default,,0000,0000,0000,,Жоқ. Реакция мүлде жоқ.
Dialogue: 0,0:09:36.01,0:09:38.01,Default,,0000,0000,0000,,Боқ.
Dialogue: 0,0:09:38.01,0:09:41.01,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:09:38.01,0:09:41.01,Default,,0000,0000,0000,,Бірінші жын әлеміне жетудің басқа жолы бар ма?
Dialogue: 0,0:09:41.01,0:09:43.02,Default,,0000,0000,0000,,№.
Dialogue: 0,0:09:43.02,0:09:46.02,Default,,0000,0000,0000,,Олай болса, енді жоқ
Dialogue: 0,0:09:43.02,0:09:46.02,Default,,0000,0000,0000,,Бұл ештеңе істей алмайтынымызды білдіре ме?
Dialogue: 0,0:09:46.02,0:09:49.02,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:09:46.02,0:09:49.02,Default,,0000,0000,0000,,Көріп отырғаныңыздай➡
Dialogue: 0,0:09:49.02,0:09:53.99,Default,,0000,0000,0000,,Бірінші жын әлеміне қосылатын үңгір
Dialogue: 0,0:09:49.02,0:09:53.99,Default,,0000,0000,0000,,Жарық қалқанымен жабылған.
Dialogue: 0,0:09:57.03,0:09:59.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:01.03,0:10:03.00,Default,,0000,0000,0000,,Өсу!
Dialogue: 0,0:10:06.04,0:10:08.04,Default,,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,0:10:08.04,0:10:12.04,Default,,0000,0000,0000,,Себебі мен алда не күтіп тұрғанын көре алмаймын.
Dialogue: 0,0:10:08.04,0:10:12.04,Default,,0000,0000,0000,,Ол шынымен бұғатталған ба?
Dialogue: 0,0:10:12.04,0:10:14.05,Default,,0000,0000,0000,,Идиот! Тоқта!
Dialogue: 0,0:10:14.05,0:10:17.05,Default,,0000,0000,0000,,Қалқанға құлап қалсаңыз
Dialogue: 0,0:10:14.05,0:10:17.05,Default,,0000,0000,0000,,Үйге тірі орала алмайсың...
Dialogue: 0,0:10:17.05,0:10:19.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:25.06,0:10:28.06,Default,,0000,0000,0000,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:10:28.06,0:10:32.03,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:10:28.06,0:10:32.03,Default,,0000,0000,0000,,Мұнда келме.
Dialogue: 0,0:10:35.00,0:10:38.00,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:10:38.00,0:10:40.01,Default,,0000,0000,0000,,Арх!
Dialogue: 0,0:10:40.01,0:10:42.01,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:42.01,0:10:43.98,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:46.01,0:10:50.02,Default,,0000,0000,0000,,Гоку~! !
Dialogue: 0,0:10:50.02,0:10:52.02,Default,,0000,0000,0000,,Мүлдем емес...
Dialogue: 0,0:10:52.02,0:10:53.99,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:58.02,0:11:00.03,Default,,0000,0000,0000,,Өйткені екеуіңде де бірдей квирк бар ма?
Dialogue: 0,0:11:00.03,0:11:05.03,Default,,0000,0000,0000,,Хэхехе…. Бұл жолы.
Dialogue: 0,0:11:05.03,0:11:07.03,Default,,0000,0000,0000,,Көптен бері көрмедім➡
Dialogue: 0,0:11:07.03,0:11:13.01,Default,,0000,0000,0000,,Жындар әлемінде шамалы желдету
Dialogue: 0,0:11:07.03,0:11:13.01,Default,,0000,0000,0000,,Мен жағдайды жақсартуға тырысамын.
Dialogue: 0,0:11:33.99,0:11:39.00,Default,,0000,0000,0000,,Портарат Доддл теңізі
Dialogue: 0,0:11:33.99,0:11:39.00,Default,,0000,0000,0000,,Оқушы Паро. ➡
Dialogue: 0,0:11:39.00,0:11:44.00,Default,,0000,0000,0000,,Портарат Доддл теңізі
Dialogue: 0,0:11:39.00,0:11:44.00,Default,,0000,0000,0000,,Оқушы паро. ➡
Dialogue: 0,0:11:44.00,0:11:49.01,Default,,0000,0000,0000,,Портарат Доддл теңізі
Dialogue: 0,0:11:44.00,0:11:49.01,Default,,0000,0000,0000,,Оқушы Пало. ➡
Dialogue: 0,0:11:49.01,0:11:55.98,Default,,0000,0000,0000,,Портарат Додл теңізі
Dialogue: 0,0:11:49.01,0:11:55.98,Default,,0000,0000,0000,,Оқушы Пало!
Dialogue: 0,0:11:58.02,0:12:00.02,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:12:00.02,0:12:20.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:20.04,0:12:22.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:22.04,0:12:24.04,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:24.04,0:12:37.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:37.99,0:12:41.99,Default,,0000,0000,0000,,С... Қалқан жоғалады...➡
Dialogue: 0,0:12:41.99,0:12:44.00,Default,,0000,0000,0000,,Мен үшінші жын әлемімен сөйлестім! ?
Dialogue: 0,0:12:44.00,0:12:50.00,Default,,0000,0000,0000,,Портарат Доддл теңізі
Dialogue: 0,0:12:44.00,0:12:50.00,Default,,0000,0000,0000,,Оқушы Паро. ➡
Dialogue: 0,0:12:50.00,0:12:54.97,Default,,0000,0000,0000,,Портарат Доддл теңізі
Dialogue: 0,0:12:50.00,0:12:54.97,Default,,0000,0000,0000,,Оқушы Пало!
Dialogue: 0,0:13:02.01,0:13:04.02,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:13:04.02,0:13:05.99,Default,,0000,0000,0000,,Уа.
Dialogue: 0,0:13:09.02,0:13:11.02,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:13:11.02,0:13:23.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:23.04,0:13:26.04,Default,,0000,0000,0000,,Не... Құдай-ау.
Dialogue: 0,0:13:26.04,0:13:28.04,Default,,0000,0000,0000,,Бұл өтірік...
Dialogue: 0,0:13:28.04,0:13:31.98,Default,,0000,0000,0000,,Мен сене алмадым! Тесік ашылды!
Dialogue: 0,0:13:31.98,0:13:35.98,Default,,0000,0000,0000,,Енді сіз қозғала аласыз!
Dialogue: 0,0:13:35.98,0:13:37.98,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:13:37.98,0:13:41.95,Default,,0000,0000,0000,,Мен өлемін деп ойладым.
Dialogue: 0,0:13:37.98,0:13:41.95,Default,,0000,0000,0000,,Сен жақсысың деп үміттенемін...
Dialogue: 0,0:13:44.99,0:13:47.99,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:13:44.99,0:13:47.99,Default,,0000,0000,0000,,Жасай бер, ата!
Dialogue: 0,0:13:47.99,0:13:53.00,Default,,0000,0000,0000,,Мүмкін баяғыда
Dialogue: 0,0:13:47.99,0:13:53.00,Default,,0000,0000,0000,,Қалқанды жасаған сен бе?
Dialogue: 0,0:13:53.00,0:13:55.00,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:13:55.00,0:13:57.00,Default,,0000,0000,0000,,Неліктен олай істедің?
Dialogue: 0,0:13:57.00,0:14:03.01,Default,,0000,0000,0000,,Әйтпесе
Dialogue: 0,0:13:57.00,0:14:03.01,Default,,0000,0000,0000,,Екінші жын дүниесінің жағдайы ауыр болды. ➡
Dialogue: 0,0:14:03.01,0:14:06.01,Default,,0000,0000,0000,,Үшінші жын әлемінен
Dialogue: 0,0:14:03.01,0:14:06.01,Default,,0000,0000,0000,,Бұзақылар. ➡
Dialogue: 0,0:14:06.01,0:14:10.02,Default,,0000,0000,0000,,Бірінші жын дүниеден
Dialogue: 0,0:14:06.01,0:14:10.02,Default,,0000,0000,0000,,Бастық жігіттер үнемі келеді. ➡
Dialogue: 0,0:14:10.02,0:14:14.02,Default,,0000,0000,0000,,Көп емес.
Dialogue: 0,0:14:10.02,0:14:14.02,Default,,0000,0000,0000,,Бейбіт өмір сүре алмадым. ➡
Dialogue: 0,0:14:14.02,0:14:19.02,Default,,0000,0000,0000,,Бұл да сыртқы дүниедегі Намекиан.
Dialogue: 0,0:14:14.02,0:14:19.02,Default,,0000,0000,0000,,Бұл оның кетуінің бір себебі. ➡
Dialogue: 0,0:14:19.02,0:14:23.03,Default,,0000,0000,0000,,Содан кейін қалқан жасаңыз
Dialogue: 0,0:14:19.02,0:14:23.03,Default,,0000,0000,0000,,өтуге болмайды. ➡
Dialogue: 0,0:14:23.03,0:14:25.03,Default,,0000,0000,0000,,орнына
Dialogue: 0,0:14:23.03,0:14:25.03,Default,,0000,0000,0000,,Варп-сама қойылды➡
Dialogue: 0,0:14:25.03,0:14:30.97,Default,,0000,0000,0000,,Соған қарамастан келіп-кетушілердің саны айтарлықтай азайды.
Dialogue: 0,0:14:25.03,0:14:30.97,Default,,0000,0000,0000,,Ол әлдеқайда тыныш болды.
Dialogue: 0,0:14:30.97,0:14:33.97,Default,,0000,0000,0000,,Осынша қолынан келетін Намекиандар
Dialogue: 0,0:14:30.97,0:14:33.97,Default,,0000,0000,0000,,Онда жоқ.
Dialogue: 0,0:14:33.97,0:14:37.98,Default,,0000,0000,0000,,Сіз бәрібірсіз
Dialogue: 0,0:14:33.97,0:14:37.98,Default,,0000,0000,0000,,Аңызға лайық.
Dialogue: 0,0:14:37.98,0:14:39.98,Default,,0000,0000,0000,,Хехе….
Dialogue: 0,0:14:39.98,0:14:43.98,Default,,0000,0000,0000,,Олай болса, бірінші жын әлеміне кірейік!
Dialogue: 0,0:14:43.98,0:14:46.99,Default,,0000,0000,0000,,О! Оу! Оу!
Dialogue: 0,0:14:46.99,0:14:48.95,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:14:59.00,0:15:02.97,Default,,0000,0000,0000,,Жарайсыңдар! Барайық!
Dialogue: 0,0:15:42.04,0:15:44.04,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:15:44.04,0:15:48.01,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:15:52.05,0:15:56.06,Default,,0000,0000,0000,,Дәл қазір ештеңе сезген жоқсың ба?
Dialogue: 0,0:15:56.06,0:15:58.06,Default,,0000,0000,0000,,Иә? Не?
Dialogue: 0,0:15:58.06,0:16:01.06,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:15:58.06,0:16:01.06,Default,,0000,0000,0000,,Жел бірдеңені ұшырып жібергендей болды...
Dialogue: 0,0:16:01.06,0:16:05.06,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:16:01.06,0:16:05.06,Default,,0000,0000,0000,,Ашуланба, Дегесу.
Dialogue: 0,0:16:05.06,0:16:07.03,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:16:22.08,0:16:24.08,Default,,0000,0000,0000,,🔊 (Дыбысты енгізу)
Dialogue: 0,0:16:24.08,0:16:27.09,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:16:27.09,0:16:29.09,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:16:29.09,0:16:32.02,Default,,0000,0000,0000,,Міне болды! Міне осы!
Dialogue: 0,0:16:32.02,0:16:34.03,Default,,0000,0000,0000,,Оның дәмі қоқыс сияқты!
Dialogue: 0,0:16:34.03,0:16:37.03,Default,,0000,0000,0000,,Кабимайо дәмі деп аталатын нәрсе бар.
Dialogue: 0,0:16:37.03,0:16:39.03,Default,,0000,0000,0000,,Ой~!
Dialogue: 0,0:16:37.03,0:16:39.03,Default,,0000,0000,0000,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:16:39.03,0:16:41.03,Default,,0000,0000,0000,,Көптеген картоп чипсы!
Dialogue: 0,0:16:41.03,0:16:44.04,Default,,0000,0000,0000,,Хун. Ол жай бала ма?
Dialogue: 0,0:16:44.04,0:16:46.04,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:16:44.04,0:16:46.04,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Бұл керемет болар еді. ➡
Dialogue: 0,0:16:46.04,0:16:48.04,Default,,0000,0000,0000,,Біздің деңгейде ең мықты➡
Dialogue: 0,0:16:48.04,0:16:50.04,Default,,0000,0000,0000,,Қанша тәттілер➡
Dialogue: 0,0:16:50.04,0:16:53.05,Default,,0000,0000,0000,,Мен бәрін сатып аламын
Dialogue: 0,0:16:50.04,0:16:53.05,Default,,0000,0000,0000,,Сіз мұны істей аласыз!
Dialogue: 0,0:16:53.05,0:16:56.05,Default,,0000,0000,0000,,Гаххахаха...!
Dialogue: 0,0:16:56.05,0:17:00.05,Default,,0000,0000,0000,,Бұл керемет!
Dialogue: 0,0:16:56.05,0:17:00.05,Default,,0000,0000,0000,,Шоколад!
Dialogue: 0,0:17:00.05,0:17:04.06,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,0:17:00.05,0:17:04.06,Default,,0000,0000,0000,,Бала сондай ма?
Dialogue: 0,0:17:04.06,0:17:06.06,Default,,0000,0000,0000,,Бейшара.
Dialogue: 0,0:17:06.06,0:17:09.03,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:17:06.06,0:17:09.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:11.06,0:17:14.07,Default,,0000,0000,0000,,Хи хи хи!
Dialogue: 0,0:17:14.07,0:17:18.07,Default,,0000,0000,0000,,Келіңіздер! Әзірше емес!
Dialogue: 0,0:17:14.07,0:17:18.07,Default,,0000,0000,0000,,О, ау!
Dialogue: 0,0:17:18.07,0:17:20.04,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:17:22.07,0:17:24.08,Default,,0000,0000,0000,,Ол да зұлым.
Dialogue: 0,0:17:24.08,0:17:28.08,Default,,0000,0000,0000,,Көп тамақтаныңыз және элита болыңыз
Dialogue: 0,0:17:24.08,0:17:28.08,Default,,0000,0000,0000,,Біздей бол, ең мықты.
Dialogue: 0,0:17:28.08,0:17:31.02,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:17:31.02,0:17:33.02,Default,,0000,0000,0000,,10 000 бас сүйек.
Dialogue: 0,0:17:33.02,0:17:34.99,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:17:38.02,0:17:41.03,Default,,0000,0000,0000,,Та… Капитан….
Dialogue: 0,0:17:41.03,0:17:44.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:44.03,0:17:49.03,Default,,0000,0000,0000,,Ах... Ахх... Уф....
Dialogue: 0,0:17:49.03,0:17:51.04,Default,,0000,0000,0000,,Шоколадқа керегі осы...
Dialogue: 0,0:17:51.04,0:17:55.04,Default,,0000,0000,0000,,🔊 (Дыбысты енгізу)
Dialogue: 0,0:17:51.04,0:17:55.04,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:17:55.04,0:18:00.05,Default,,0000,0000,0000,,Балалар көп жейді
Dialogue: 0,0:17:55.04,0:18:00.05,Default,,0000,0000,0000,,Өйткені бұл жақсы емес. Сонда кездескенше! ➡
Dialogue: 0,0:18:00.05,0:18:03.05,Default,,0000,0000,0000,,Хахаха...!
Dialogue: 0,0:18:03.05,0:18:07.02,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:18:03.05,0:18:07.02,Default,,0000,0000,0000,,Сізге көп рахмет!
Dialogue: 0,0:18:23.07,0:18:26.07,Default,,0000,0000,0000,,⚟ (діріл дыбысы)
Dialogue: 0,0:18:23.07,0:18:26.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:26.07,0:18:36.01,Default,,0000,0000,0000,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:18:36.01,0:18:38.02,Default,,0000,0000,0000,,Бұл дыбыс…. ➡
Dialogue: 0,0:18:38.02,0:18:40.99,Default,,0000,0000,0000,,Мен оның қалқан екеніне сенбеймін...
Dialogue: 0,0:18:43.02,0:18:45.02,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:18:45.02,0:18:49.03,Default,,0000,0000,0000,,Глорио! Көбірек баяулаңыз!
Dialogue: 0,0:18:45.02,0:18:49.03,Default,,0000,0000,0000,,Ол бұзылады!
Dialogue: 0,0:18:49.03,0:18:51.03,Default,,0000,0000,0000,,Мен білемін! ➡
Dialogue: 0,0:18:51.03,0:18:54.03,Default,,0000,0000,0000,,Мен істеп жатырмын.
Dialogue: 0,0:18:51.03,0:18:54.03,Default,,0000,0000,0000,,Бұл оңайлықпен құлап кетпейді!
Dialogue: 0,0:18:54.03,0:18:57.04,Default,,0000,0000,0000,,Төменгі реактор
Dialogue: 0,0:18:54.03,0:18:57.04,Default,,0000,0000,0000,,Тыңдамай жүргенің жаман!
Dialogue: 0,0:18:57.04,0:19:02.04,Default,,0000,0000,0000,,Бұл жерден кету дегенді білдіреді
Dialogue: 0,0:18:57.04,0:19:02.04,Default,,0000,0000,0000,,Бұл оның бірінші жын әлемінің аспанында пайда болатынын білдіре ме?
Dialogue: 0,0:19:02.04,0:19:04.04,Default,,0000,0000,0000,,Температура қандай?
Dialogue: 0,0:19:04.04,0:19:07.05,Default,,0000,0000,0000,,Менен сұрап тұрсың ба?
Dialogue: 0,0:19:04.04,0:19:07.05,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:19:07.05,0:19:11.05,Default,,0000,0000,0000,,Бағана. ➡
Dialogue: 0,0:19:07.05,0:19:11.05,Default,,0000,0000,0000,,Мен ыстықты ұнатпаймын.
Dialogue: 0,0:19:11.05,0:19:12.72,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:19:12.72,0:19:14.72,Default,,0000,0000,0000,,Бірінші жын әлемі атмосферада➡
Dialogue: 0,0:19:14.72,0:19:19.06,Default,,0000,0000,0000,,Күн тәрізді кішкентай шар
Dialogue: 0,0:19:14.72,0:19:19.06,Default,,0000,0000,0000,,Бір айналу. ➡
Dialogue: 0,0:19:19.06,0:19:23.06,Default,,0000,0000,0000,,Осы уақытта
Dialogue: 0,0:19:19.06,0:19:23.06,Default,,0000,0000,0000,,Менің ойымша, аспандағы температура шамамен 60℃.
Егер ол
Dialogue: 0,0:19:23.06,0:19:27.07,Default,,0000,0000,0000,,болса, онда проблема жоқ.
Dialogue: 0,0:19:23.06,0:19:27.07,Default,,0000,0000,0000,,Егер ол бұзылса, ұшақты лақтырыңыз➡
Dialogue: 0,0:19:27.07,0:19:29.07,Default,,0000,0000,0000,,Өзіміз
Dialogue: 0,0:19:27.07,0:19:29.07,Default,,0000,0000,0000,,Сізге тек қана ұшу керек.
Dialogue: 0,0:19:29.07,0:19:33.01,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:19:29.07,0:19:33.01,Default,,0000,0000,0000,,Хахаха...!
Dialogue: 0,0:19:33.01,0:19:37.01,Default,,0000,0000,0000,,Ro… 60℃! ?
Dialogue: 0,0:19:33.01,0:19:37.01,Default,,0000,0000,0000,,Жақсы ма? ?
Dialogue: 0,0:19:37.01,0:19:39.01,Default,,0000,0000,0000,,Ыстық, солай емес пе? Маған ұнамайды...
Dialogue: 0,0:19:39.01,0:19:43.02,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:19:39.01,0:19:43.02,Default,,0000,0000,0000,,Мен ғана ұша алмаймын ба?
Dialogue: 0,0:19:43.02,0:19:47.02,Default,,0000,0000,0000,,Не? Ол ыстық және
Dialogue: 0,0:19:43.02,0:19:47.02,Default,,0000,0000,0000,,Мен сені ұстап алып ұшамын ба?
Dialogue: 0,0:19:47.02,0:19:50.02,Default,,0000,0000,0000,,
Dialogue: 0,0:19:47.02,0:19:50.02,Default,,0000,0000,0000,,Сізден мұны ешкім талап еткен жоқ! ➡
Dialogue: 0,0:19:50.02,0:19:53.03,Default,,0000,0000,0000,,Мен Вегетадан маған көмектесуін сұраймын.
Dialogue: 0,0:19:50.02,0:19:53.03,Default,,0000,0000,0000,,Әрине.
Dialogue: 0,0:19:53.03,0:19:57.03,Default,,0000,0000,0000,,Уф... Мен жеңілдеп қалдым.
Dialogue: 0,0:19:53.03,0:19:57.03,Default,,0000,0000,0000,,Hmph….
Dialogue: 0,0:19:57.03,0:20:00.03,Default,,0000,0000,0000,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:20:00.03,0:20:04.04,Default,,0000,0000,0000,,Жақында тесіктен құлап кететін сияқты.
Dialogue: 0,0:20:00.03,0:20:04.04,Default,,0000,0000,0000,,Бұл шектеуге жақын!
Dialogue: 0,0:20:04.04,0:20:06.00,Default,,0000,0000,0000,,Есікті ашыңыз!
Dialogue: 0,0:20:10.04,0:20:12.01,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:20:18.05,0:20:21.05,Default,,0000,0000,0000,,Айдаһар допты ұмытпаңыз!
Dialogue: 0,0:20:21.05,0:20:24.06,Default,,0000,0000,0000,,Эй, сенің де ұрысқың келе ме?
Dialogue: 0,0:20:24.06,0:20:26.06,Default,,0000,0000,0000,,Мен? Мүмкін емес.
Dialogue: 0,0:20:26.06,0:20:31.03,Default,,0000,0000,0000,,Сонымен Dragon Ball туралы не деуге болады?
Dialogue: 0,0:20:26.06,0:20:31.03,Default,,0000,0000,0000,,Оны ұстау керек!
Dialogue: 0,0:20:33.00,0:20:35.00,Default,,0000,0000,0000,,Мен біреуін аламын.
Dialogue: 0,0:20:35.00,0:20:38.97,Default,,0000,0000,0000,,Қазір ғана құмар көздеріңмен мені шолып тұрдың ғой, иә?
Dialogue: 0,0:20:35.00,0:20:38.97,Default,,0000,0000,0000,,Қараңғысың, бірақ жақсы жігітсің.
Dialogue: 0,0:20:48.01,0:20:50.02,Default,,0000,0000,0000,,Фу~. Бұл жақын қоңырау болды.
Dialogue: 0,0:20:50.02,0:20:53.02,Default,,0000,0000,0000,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:20:53.02,0:20:56.02,Default,,0000,0000,0000,,Бұл бірінші жын әлемі ме?
Dialogue: 0,0:20:56.02,0:20:59.02,Default,,0000,0000,0000,,Бұл не! ? Өте ыстық, мен өлетін сияқтымын!
Dialogue: 0,0:20:59.02,0:21:03.00,Default,,0000,0000,0000,,Күн жақын болғандықтан!
Dialogue: 0,0:20:59.02,0:21:03.00,Default,,0000,0000,0000,,Жердегі температура одан да төмен!
Dialogue: 0,0:21:05.03,0:21:08.00,Default,,0000,0000,0000,,⚟(Соқтығыс дыбысы)
Dialogue: 0,0:21:05.03,0:21:08.00,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:10.04,0:21:14.04,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:21:10.04,0:21:14.04,Default,,0000,0000,0000,,Бұл сізді жаңа ғана соққан ұшақ болды ма?
Dialogue: 0,0:21:14.04,0:21:19.04,Default,,0000,0000,0000,,Ұшақ неліктен...? иә?
Dialogue: 0,0:21:14.04,0:21:19.04,Default,,0000,0000,0000,,500 метр радиустағы тұрғындар да көшірілді.
Dialogue: 0,0:21:19.04,0:21:22.05,Default,,0000,0000,0000,,Ол алыс, мен оны жақсы көрмеймін➡
Dialogue: 0,0:21:22.05,0:21:25.05,Default,,0000,0000,0000,,Үңгір қалқаны
Dialogue: 0,0:21:22.05,0:21:25.05,Default,,0000,0000,0000,,Жоғалған сияқты емес пе?
Dialogue: 0,0:21:25.05,0:21:29.05,Default,,0000,0000,0000,,Мүмкін емес. иә?
Dialogue: 0,0:21:25.05,0:21:29.05,Default,,0000,0000,0000,,Мен және ұлым
Dialogue: 0,0:21:29.05,0:21:32.99,Default,,0000,0000,0000,,Жоқ, бұл қалқан, дәлірек айтқанда, адам!
Dialogue: 0,0:21:29.05,0:21:32.99,Default,,0000,0000,0000,,Адамдар көп!
Dialogue: 0,0:21:32.99,0:21:34.96,Default,,0000,0000,0000,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:21:37.00,0:21:40.00,Default,,0000,0000,0000,,Сәлем! Тезірек хабарлаңыз!
Dialogue: 0,0:21:40.00,0:21:43.00,Default,,0000,0000,0000,,Не! ? Бұл рас па? ?
Dialogue: 0,0:21:43.00,0:21:47.01,Default,,0000,0000,0000,,Не болды? Deguess.
Dialogue: 0,0:21:43.00,0:21:47.01,Default,,0000,0000,0000,,Құрметті Гомер!
Dialogue: 0,0:21:47.01,0:21:48.67,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:21:48.67,0:21:52.01,Default,,0000,0000,0000,,Абай бол, ДжоДжо!
Dialogue: 0,0:21:48.67,0:21:52.01,Default,,0000,0000,0000,,Не... неге бұл жігіттер! ?
Dialogue: 0,0:21:52.01,0:21:55.01,Default,,0000,0000,0000,,Құрметті Уорп
Dialogue: 0,0:21:52.01,0:21:55.01,Default,,0000,0000,0000,,Сен оны тоқтатпадың ба! ?
Dialogue: 0,0:21:55.01,0:21:59.02,Default,,0000,0000,0000,,Сен мұнда не үшін келдің? ?
Dialogue: 0,0:21:55.01,0:21:59.02,Default,,0000,0000,0000,,Кешіріңіз! ➡
Dialogue: 0,0:21:59.02,0:22:01.02,Default,,0000,0000,0000,,Warp-sama
Dialogue: 0,0:21:59.02,0:22:01.02,Default,,0000,0000,0000,,Мен оны тоқтаттым, бірақ➡
Dialogue: 0,0:22:01.02,0:22:05.02,Default,,0000,0000,0000,,Ертегі бойынша үңгірдегі қалқан
Dialogue: 0,0:22:01.02,0:22:05.02,Default,,0000,0000,0000,,Егер ол жоғалып кеткендей болса...
Dialogue: 0,0:22:05.02,0:22:06.99,Default,,0000,0000,0000,,Қалқан...
Dialogue: 0,0:22:09.03,0:22:13.03,Default,,0000,0000,0000,,
Dialogue: 0,0:22:09.03,0:22:13.03,Default,,0000,0000,0000,,Не... нені айтасың...?
Dialogue: 0,0:22:13.03,0:22:15.00,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:22:17.04,0:22:18.70,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:22:18.70,0:22:22.04,Default,,0000,0000,0000,,Одан да көп
Dialogue: 0,0:22:18.70,0:22:22.04,Default,,0000,0000,0000,,Қазір шабуыл жасаңыз!
Dialogue: 0,0:22:22.04,0:22:26.04,Default,,0000,0000,0000,,Бірден шабуыл жасаңыз!
Dialogue: 0,0:22:26.04,0:22:28.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:28.05,0:22:29.72,Default,,0000,0000,0000,,О, бұл…
Dialogue: 0,0:22:29.72,0:22:31.98,Default,,0000,0000,0000,,Міне болды! Бұл олар!
Dialogue: 0,0:22:31.98,0:22:34.95,Default,,0000,0000,0000,,А, мен таптым...
Dialogue: 0,0:22:37.99,0:22:39.96,Default,,0000,0000,0000,,Какаре~!
Dialogue: 0,0:22:44.00,0:22:45.96,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:22:50.00,0:22:59.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:01.48,0:23:07.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory