Dialogue: 0,0:00:02.07,0:00:07.07,Default,,0000,0000,0000,,[Айдаһар шары дегеніміз не?
Dialogue: 0,0:00:02.07,0:00:07.07,Default,,0000,0000,0000,,7 бөлікті жинап, құпия сөзді айт➡
Dialogue: 0,0:00:07.07,0:00:11.08,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:07.07,0:00:11.08,Default,,0000,0000,0000,,Айдаһар
Dialogue: 0,0:00:07.07,0:00:11.08,Default,,0000,0000,0000,,Шенрон атты айдаһар
Dialogue: 0,0:00:07.07,0:00:11.08,Default,,0000,0000,0000,,Пайда болуы➡
Dialogue: 0,0:00:11.08,0:00:15.08,Default,,0000,0000,0000,,Бұл жұмбақ доп]
Dialogue: 0,0:00:15.08,0:00:21.09,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:15.08,0:00:21.09,Default,,0000,0000,0000,,[Егер сіз Шенроннан қандай да бір тілек сұрасаңыз,
Dialogue: 0,0:00:15.08,0:00:21.09,Default,,0000,0000,0000,,Бұл орындалады]
Dialogue: 0,0:00:21.09,0:00:25.09,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:00:21.09,0:00:25.09,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:00:21.09,0:00:25.09,Default,,0000,0000,0000,,[Бұл Сон Гоку адам
Dialogue: 0,0:00:21.09,0:00:25.09,Default,,0000,0000,0000,,Сабырлы болып көрінсе де➡
Dialogue: 0,0:00:25.09,0:00:31.10,Default,,0000,0000,0000,,Ерекше күші бар жауынгер жарысы
Dialogue: 0,0:00:25.09,0:00:31.10,Default,,0000,0000,0000,,Ол – Сайян]
Dialogue: 0,0:00:31.10,0:00:34.10,Default,,0000,0000,0000,,[тауларда өмір сүрген]
Dialogue: 0,0:00:31.10,0:00:34.10,Default,,0000,0000,0000,,Балалық шақ➡
Dialogue: 0,0:00:34.10,0:00:37.10,Default,,0000,0000,0000,,Айдаһар допты іздеу
Dialogue: 0,0:00:34.10,0:00:37.10,Default,,0000,0000,0000,,Достармен танысу➡
Dialogue: 0,0:00:37.10,0:00:42.11,Default,,0000,0000,0000,,Бірге есейіңіз]
Dialogue: 0,0:00:42.11,0:00:47.11,Default,,0000,0000,0000,,[Менің өмірімнің көп бөлігі
Dialogue: 0,0:00:42.11,0:00:47.11,Default,,0000,0000,0000,,Жас болыңыз➡
Dialogue: 0,0:00:47.11,0:00:49.12,Default,,0000,0000,0000,,Сайян сипаттамалары бар➡
Dialogue: 0,0:00:49.12,0:00:53.12,Default,,0000,0000,0000,,Қазір де
Dialogue: 0,0:00:49.12,0:00:53.12,Default,,0000,0000,0000,,Бұрынғы қарсыластарымен➡
Dialogue: 0,0:00:53.12,0:00:59.13,Default,,0000,0000,0000,,Жаман қолдардан
Dialogue: 0,0:00:53.12,0:00:59.13,Default,,0000,0000,0000,,Жерді қорғауды жалғастыру]
Dialogue: 0,0:00:59.13,0:01:09.14,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:44.03,0:02:47.33,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:02:49.04,0:02:51.04,Default,,0000,0000,0000,,Иә? Ах... ➡
Dialogue: 0,0:02:51.04,0:02:54.04,Default,,0000,0000,0000,,Әй, біреу келе жатыр!
Dialogue: 0,0:02:51.04,0:02:54.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:54.04,0:03:11.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:11.06,0:03:13.06,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:03:13.06,0:03:16.06,Default,,0000,0000,0000,,Біртүрлі адамдар бар.
Dialogue: 0,0:03:18.06,0:03:20.07,Default,,0000,0000,0000,,Нева!
Dialogue: 0,0:03:20.07,0:03:22.07,Default,,0000,0000,0000,,Сіз Намекиансыз ба?
Dialogue: 0,0:03:22.07,0:03:24.07,Default,,0000,0000,0000,,Сіз осында тұрасыз ба?
Dialogue: 0,0:03:24.07,0:03:27.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:27.07,0:03:31.01,Default,,0000,0000,0000,,Айдаһар добы….
Dialogue: 0,0:03:31.01,0:03:34.01,Default,,0000,0000,0000,,Бұл Айдаһар добы.
Dialogue: 0,0:03:34.01,0:03:38.02,Default,,0000,0000,0000,,♬ «Ұстап алайық!
Dialogue: 0,0:03:34.01,0:03:38.02,Default,,0000,0000,0000,,Айдаһар добы
Dialogue: 0,0:03:34.01,0:03:38.02,Default,,0000,0000,0000,,айдаһар шары»
Dialogue: 0,0:03:38.02,0:03:42.02,Default,,0000,0000,0000,,♬ (Нева ызылдаған)
Dialogue: 0,0:03:38.02,0:03:42.02,Default,,0000,0000,0000,,Tsk, бұлыңғыр.
Dialogue: 0,0:03:42.02,0:03:44.02,Default,,0000,0000,0000,,Ол үшін уайымдама, тез барайық.
Dialogue: 0,0:03:42.02,0:03:44.02,Default,,0000,0000,0000,,♬ (Нева ызылдаған)
Dialogue: 0,0:03:44.02,0:03:47.03,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:03:44.02,0:03:47.03,Default,,0000,0000,0000,,Өзіңді ақымақ етіп көрсетуге жеткілікті.
Dialogue: 0,0:03:47.03,0:03:50.03,Default,,0000,0000,0000,,♬ (мырылдау)
Dialogue: 0,0:03:47.03,0:03:50.03,Default,,0000,0000,0000,,Бұл маған түсінікті.
Dialogue: 0,0:03:50.03,0:03:54.03,Default,,0000,0000,0000,,Сіз кездейсоқсыз ба?
Dialogue: 0,0:03:50.03,0:03:54.03,Default,,0000,0000,0000,,Аты аңызға айналған Намекян Нева?
Dialogue: 0,0:03:54.03,0:04:00.04,Default,,0000,0000,0000,,Бұл сирек.
Dialogue: 0,0:03:54.03,0:04:00.04,Default,,0000,0000,0000,,Сіз жекпе-жекке шыққан Намекиансыз ба?
Dialogue: 0,0:04:00.04,0:04:03.04,Default,,0000,0000,0000,,Хмм, Кататуға ұқсайды.
Dialogue: 0,0:04:03.04,0:04:05.04,Default,,0000,0000,0000,,Катацу менің ата-анам.
Dialogue: 0,0:04:05.04,0:04:07.05,Default,,0000,0000,0000,,Сіздің атыңыз кім?
Dialogue: 0,0:04:05.04,0:04:07.05,Default,,0000,0000,0000,,Пикколо.
Dialogue: 0,0:04:07.05,0:04:10.05,Default,,0000,0000,0000,,Пикколо? Бұл біртүрлі атау.
Dialogue: 0,0:04:10.05,0:04:13.05,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:04:13.05,0:04:17.06,Default,,0000,0000,0000,,Сіз ең жақсысыз
Dialogue: 0,0:04:13.05,0:04:17.06,Default,,0000,0000,0000,,Сіз жақсырақ білуіңіз керек.
Dialogue: 0,0:04:17.06,0:04:19.06,Default,,0000,0000,0000,,Жек көру….
Dialogue: 0,0:04:19.06,0:04:23.06,Default,,0000,0000,0000,,Осының болуын күту
Dialogue: 0,0:04:19.06,0:04:23.06,Default,,0000,0000,0000,,Бұлыңғыр болып көріну➡
Dialogue: 0,0:04:23.06,0:04:25.06,Default,,0000,0000,0000,,Ұлы жын патша Гомермен
Dialogue: 0,0:04:23.06,0:04:25.06,Default,,0000,0000,0000,,Жерге келу➡
Dialogue: 0,0:04:25.06,0:04:28.07,Default,,0000,0000,0000,,Қолданылған айдаһар шарлары.
Dialogue: 0,0:04:28.07,0:04:30.07,Default,,0000,0000,0000,,Не...?
Dialogue: 0,0:04:28.07,0:04:30.07,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:04:30.07,0:04:34.34,Default,,0000,0000,0000,,Айдаһар шарларын кім пайдаланды?
Dialogue: 0,0:04:30.07,0:04:34.34,Default,,0000,0000,0000,,Бұл қария ма еді?
Dialogue: 0,0:04:34.34,0:04:39.01,Default,,0000,0000,0000,,Сол Намекяннан күткендей.
Dialogue: 0,0:04:34.34,0:04:39.01,Default,,0000,0000,0000,,Сіз оны көріп тұрған сияқтысыз.
Dialogue: 0,0:04:39.01,0:04:42.02,Default,,0000,0000,0000,,Неліктен біз?
Dialogue: 0,0:04:39.01,0:04:42.02,Default,,0000,0000,0000,,Балаға айналдырдым.
Dialogue: 0,0:04:42.02,0:04:45.02,Default,,0000,0000,0000,,Бұл Гомердің өтініші. ➡
Dialogue: 0,0:04:45.02,0:04:51.02,Default,,0000,0000,0000,,Сол жігіт, сендер Ұлы Жындар әлеміндесіңдер.
Dialogue: 0,0:04:45.02,0:04:51.02,Default,,0000,0000,0000,,Мен бортқа біреу келе ме деп қорықтым. ➡
Dialogue: 0,0:04:51.02,0:04:55.03,Default,,0000,0000,0000,,Балаға рұқсат етсең
Dialogue: 0,0:04:51.02,0:04:55.03,Default,,0000,0000,0000,,Менің жауым болғың келмеді деп ойлаймын.
Dialogue: 0,0:04:55.03,0:04:57.03,Default,,0000,0000,0000,,Кунунуну….
Dialogue: 0,0:04:57.03,0:05:00.37,Default,,0000,0000,0000,,Егер бұл басқа тілек болса
Dialogue: 0,0:04:57.03,0:05:00.37,Default,,0000,0000,0000,,Сіз не істеуді жоспарладыңыз?
Dialogue: 0,0:05:00.37,0:05:04.04,Default,,0000,0000,0000,,Олай болса
Dialogue: 0,0:05:00.37,0:05:04.04,Default,,0000,0000,0000,,Бұлыңғыр болып көріну➡
Dialogue: 0,0:05:04.04,0:05:06.04,Default,,0000,0000,0000,,Мұның бәрі алдау туралы.
Dialogue: 0,0:05:04.04,0:05:06.04,Default,,0000,0000,0000,,Денде➡
Dialogue: 0,0:05:06.04,0:05:09.04,Default,,0000,0000,0000,,Тіпті сені алып кетеді
Dialogue: 0,0:05:06.04,0:05:09.04,Default,,0000,0000,0000,,Сіз мұны күттіңіз бе?
Dialogue: 0,0:05:09.04,0:05:11.04,Default,,0000,0000,0000,,Денде?
Dialogue: 0,0:05:11.04,0:05:14.05,Default,,0000,0000,0000,,Аа, Намекиялық бала.
Dialogue: 0,0:05:14.05,0:05:16.42,Default,,0000,0000,0000,,Әрине мен күткенмін.
Dialogue: 0,0:05:16.42,0:05:18.05,Default,,0000,0000,0000,,Дендесіз➡
Dialogue: 0,0:05:18.05,0:05:23.06,Default,,0000,0000,0000,,Жердің айдаһар шарлары
Dialogue: 0,0:05:18.05,0:05:23.06,Default,,0000,0000,0000,,Сіз оны енді ешқашан пайдалана алмайсыз.
Dialogue: 0,0:05:23.06,0:05:26.06,Default,,0000,0000,0000,,Егер өлтірілсе
Dialogue: 0,0:05:23.06,0:05:26.06,Default,,0000,0000,0000,,Сіз не істеуді жоспарладыңыз? ?
Dialogue: 0,0:05:26.06,0:05:31.00,Default,,0000,0000,0000,,Мен сені өлтірмеймін.
Dialogue: 0,0:05:26.06,0:05:31.00,Default,,0000,0000,0000,,Намекиандар қымбат.
Dialogue: 0,0:05:31.00,0:05:35.00,Default,,0000,0000,0000,,Тіпті Гомер
Dialogue: 0,0:05:31.00,0:05:35.00,Default,,0000,0000,0000,,Мен мұны білемін.
Dialogue: 0,0:05:35.00,0:05:38.00,Default,,0000,0000,0000,,Күтпеген нәрсе болды
Dialogue: 0,0:05:35.00,0:05:38.00,Default,,0000,0000,0000,,Балалар➡
Dialogue: 0,0:05:38.00,0:05:41.01,Default,,0000,0000,0000,,Айдаһар шарлары осында
Dialogue: 0,0:05:38.00,0:05:41.01,Default,,0000,0000,0000,,Мен оларды жинай бастадым.
Dialogue: 0,0:05:41.01,0:05:44.01,Default,,0000,0000,0000,,Өйткені мұнда да
Dialogue: 0,0:05:41.01,0:05:44.01,Default,,0000,0000,0000,,Егер сізде Dragon Ball➡ болса
Dialogue: 0,0:05:44.01,0:05:46.01,Default,,0000,0000,0000,,Содан кейін, есейген кезде➡
Dialogue: 0,0:05:46.01,0:05:49.02,Default,,0000,0000,0000,,Дендеге көмектескен жөн
Dialogue: 0,0:05:46.01,0:05:49.02,Default,,0000,0000,0000,,Қазір ерте.
Dialogue: 0,0:05:49.02,0:05:51.02,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:05:53.02,0:05:55.02,Default,,0000,0000,0000,,Енді сізде неше бар?
Dialogue: 0,0:05:55.02,0:05:56.69,Default,,0000,0000,0000,,Тағы бір нәрсе.
Dialogue: 0,0:05:56.69,0:05:59.03,Default,,0000,0000,0000,,Енді екіншісі
Dialogue: 0,0:05:56.69,0:05:59.03,Default,,0000,0000,0000,,2-ші Макай Айдаһар добы ➡
Dialogue: 0,0:05:59.03,0:06:01.03,Default,,0000,0000,0000,,Мен оны алуға бара жатырмын.
Dialogue: 0,0:06:01.03,0:06:06.03,Default,,0000,0000,0000,,Мен оны үшінші жын әлемінің Тамагамиі болады деп ешқашан күтпедім.
Dialogue: 0,0:06:01.03,0:06:06.03,Default,,0000,0000,0000,,Мен жеңемін деп ойламаймын... ➡
Dialogue: 0,0:06:06.03,0:06:09.04,Default,,0000,0000,0000,,Күткендей, бала кейпінде
Dialogue: 0,0:06:06.03,0:06:09.04,Default,,0000,0000,0000,,Мықты болу үшін➡
Dialogue: 0,0:06:09.04,0:06:11.04,Default,,0000,0000,0000,,Мен бұны күткен жоқпын.
Dialogue: 0,0:06:11.04,0:06:13.04,Default,,0000,0000,0000,,Ах! Мүмкін➡
Dialogue: 0,0:06:13.04,0:06:16.04,Default,,0000,0000,0000,,Тамагами-саманы кім жасады?
Dialogue: 0,0:06:13.04,0:06:16.04,Default,,0000,0000,0000,,Сіз емессіз бе?
Dialogue: 0,0:06:16.04,0:06:18.04,Default,,0000,0000,0000,,О….
Dialogue: 0,0:06:18.04,0:06:20.05,Default,,0000,0000,0000,,Хэхе... жақсы.
Dialogue: 0,0:06:20.05,0:06:23.05,Default,,0000,0000,0000,,Егер сіз сондай күшті нәрсе жасай алсаңыз
Dialogue: 0,0:06:20.05,0:06:23.05,Default,,0000,0000,0000,,Ұлы жын патша т.б.➡
Dialogue: 0,0:06:23.05,0:06:26.05,Default,,0000,0000,0000,,Міне
Dialogue: 0,0:06:23.05,0:06:26.05,Default,,0000,0000,0000,,Тек соғыңыз.
Dialogue: 0,0:06:26.05,0:06:30.99,Default,,0000,0000,0000,,Намекиялықтар күресуге
Dialogue: 0,0:06:26.05,0:06:30.99,Default,,0000,0000,0000,,Күш қолданбаңыз.
Dialogue: 0,0:06:30.99,0:06:32.99,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:32.99,0:06:34.99,Default,,0000,0000,0000,,Не... не?! ➡
Dialogue: 0,0:06:34.99,0:06:37.00,Default,,0000,0000,0000,,Маған қарама!
Dialogue: 0,0:06:37.00,0:06:41.00,Default,,0000,0000,0000,,Жүр, асығайық.
Dialogue: 0,0:06:37.00,0:06:41.00,Default,,0000,0000,0000,,Бұрын бізге әскери полиция шабуыл жасады.
Dialogue: 0,0:06:41.00,0:06:44.00,Default,,0000,0000,0000,,Біз туралы
Dialogue: 0,0:06:41.00,0:06:44.00,Default,,0000,0000,0000,,Гомер біліп қойған.
Dialogue: 0,0:06:44.00,0:06:47.01,Default,,0000,0000,0000,,Жарайды, кеттік.
Dialogue: 0,0:06:47.01,0:06:49.01,Default,,0000,0000,0000,,Мені де алыңыз.
Dialogue: 0,0:06:49.01,0:06:52.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:49.01,0:06:52.01,Default,,0000,0000,0000,,Не? Бұл жақсы емес.
Dialogue: 0,0:06:52.01,0:06:56.02,Default,,0000,0000,0000,,Ұшақ кішкентай болса да
Dialogue: 0,0:06:52.01,0:06:56.02,Default,,0000,0000,0000,,Ата Бұл үлкен.
Dialogue: 0,0:06:56.02,0:06:59.02,Default,,0000,0000,0000,,Намекиан тілінде сөйлей алатындар
Dialogue: 0,0:06:56.02,0:06:59.02,Default,,0000,0000,0000,,Біреу бар ма?
Dialogue: 0,0:06:59.02,0:07:01.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:59.02,0:07:01.02,Default,,0000,0000,0000,,Айдаһар добы➡
Dialogue: 0,0:07:01.02,0:07:06.03,Default,,0000,0000,0000,,Егер сіз үшеуін жинасаңыз
Dialogue: 0,0:07:01.02,0:07:06.03,Default,,0000,0000,0000,,Айдаһарға тілек айту - Намекиан.
Dialogue: 0,0:07:06.03,0:07:08.03,Default,,0000,0000,0000,,Ах!?
Dialogue: 0,0:07:08.03,0:07:12.03,Default,,0000,0000,0000,,Себеп
Dialogue: 0,0:07:08.03,0:07:12.03,Default,,0000,0000,0000,,Намек
Dialogue: 0,0:07:08.03,0:07:12.03,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:07:08.03,0:07:12.03,Default,,0000,0000,0000,,Порунга есімді Шенрон сияқты.
Dialogue: 0,0:07:14.03,0:07:17.04,Default,,0000,0000,0000,,Пикколо Сіз сөйлей аласыз ба?
Dialogue: 0,0:07:17.04,0:07:22.04,Default,,0000,0000,0000,,Жоқ... жер бетіндегі тіршілік
Dialogue: 0,0:07:17.04,0:07:22.04,Default,,0000,0000,0000,,Ұзақ болғандықтан...
Dialogue: 0,0:07:22.04,0:07:24.04,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:07:24.04,0:07:28.05,Default,,0000,0000,0000,,Мені алып кетіңіз
Dialogue: 0,0:07:24.04,0:07:28.05,Default,,0000,0000,0000,,Сіздің тілектеріңіз орындалмайды.
Dialogue: 0,0:07:28.05,0:07:31.98,Default,,0000,0000,0000,,Олай болса, сенімен келгенімді қалайсың ба?
Dialogue: 0,0:07:31.98,0:07:36.99,Default,,0000,0000,0000,,Иә! Келіңіздер, бәріңіз
Dialogue: 0,0:07:31.98,0:07:36.99,Default,,0000,0000,0000,,Атаға орын дайында.
Dialogue: 0,0:07:41.99,0:07:45.00,Default,,0000,0000,0000,,Аа... ➡
Dialogue: 0,0:07:45.00,0:07:49.00,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:07:45.00,0:07:49.00,Default,,0000,0000,0000,,Сонда сіз қайтып келдіңіз бе?
Dialogue: 0,0:07:49.00,0:07:52.00,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:07:52.00,0:07:54.01,Default,,0000,0000,0000,,Енді ұрысуға болмайды
Dialogue: 0,0:07:52.00,0:07:54.01,Default,,0000,0000,0000,,Өйткені бұл қауіпті болды.
Dialogue: 0,0:07:54.01,0:07:58.01,Default,,0000,0000,0000,,Бұлай көрінсе де, бақылау мен пайымдау күші
Dialogue: 0,0:07:54.01,0:07:58.01,Default,,0000,0000,0000,,Мен сенімдімін.
Dialogue: 0,0:07:58.01,0:08:01.01,Default,,0000,0000,0000,,Сіз мұны ашық айтып отырсыз ба?
Dialogue: 0,0:08:01.01,0:08:03.02,Default,,0000,0000,0000,,Одан да көп, Марва➡
Dialogue: 0,0:08:03.02,0:08:06.02,Default,,0000,0000,0000,,Онда әлі Буу үзіндісі бар.
Dialogue: 0,0:08:03.02,0:08:06.02,Default,,0000,0000,0000,,Бұл жеткіліксіз болған сияқты.
Dialogue: 0,0:08:06.02,0:08:08.02,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:08:10.02,0:08:13.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:10.02,0:08:13.03,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:08:19.03,0:08:23.04,Default,,0000,0000,0000,,қалды
Dialogue: 0,0:08:19.03,0:08:23.04,Default,,0000,0000,0000,,Буу ет бөліктері мен сығындысы.
Dialogue: 0,0:08:23.04,0:08:28.04,Default,,0000,0000,0000,,Уху….
Dialogue: 0,0:08:23.04,0:08:28.04,Default,,0000,0000,0000,,Олардың барлығын араластыру керек пе?
Dialogue: 0,0:08:35.05,0:08:38.05,Default,,0000,0000,0000,,Осы жолы асыға күтемін.
Dialogue: 0,0:08:43.06,0:08:48.06,Default,,0000,0000,0000,,Соңғы түйір жуан
Dialogue: 0,0:08:43.06,0:08:48.06,Default,,0000,0000,0000,,Оны 10см дейін көму керек пе?
Dialogue: 0,0:08:50.06,0:08:53.07,Default,,0000,0000,0000,,Жоқ, бұл сіздің соңғы мүмкіндігіңіз.
Dialogue: 0,0:08:50.06,0:08:53.07,Default,,0000,0000,0000,,20см-мен жүрейік.
Dialogue: 0,0:08:53.07,0:08:55.07,Default,,0000,0000,0000,,20см! ? ➡
Dialogue: 0,0:08:55.07,0:08:57.07,Default,,0000,0000,0000,,Бұл өте құмар ойын. ➡
Dialogue: 0,0:08:57.07,0:09:01.07,Default,,0000,0000,0000,,Егер сіз бақылаусыз әрекет ете бастасаңыз
Dialogue: 0,0:08:57.07,0:09:01.07,Default,,0000,0000,0000,,Бұл үлкен мәміле болуы мүмкін.
Dialogue: 0,0:09:01.07,0:09:05.08,Default,,0000,0000,0000,,Бұл жағдайда
Dialogue: 0,0:09:01.07,0:09:05.08,Default,,0000,0000,0000,,Мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:09:05.08,0:09:08.08,Default,,0000,0000,0000,,Сіз солай айтасыз ба? Ха...
Dialogue: 0,0:09:08.08,0:09:13.09,Default,,0000,0000,0000,,Бірақ ол Тамагамиді жеңетін сияқты.
Dialogue: 0,0:09:08.08,0:09:13.09,Default,,0000,0000,0000,,Мен саған өз күшімді көрсетуім керек.
Dialogue: 0,0:09:13.09,0:09:17.09,Default,,0000,0000,0000,,Мен Ұлы Жын патшасы болсам да
Dialogue: 0,0:09:13.09,0:09:17.09,Default,,0000,0000,0000,,Бұл ұзаққа созылмайды.
Dialogue: 0,0:09:17.09,0:09:20.09,Default,,0000,0000,0000,,Мен еңсеремін. Ха.
Dialogue: 0,0:09:24.10,0:09:26.10,Default,,0000,0000,0000,,Менің бөксем ауырып тұр.
Dialogue: 0,0:09:26.10,0:09:29.10,Default,,0000,0000,0000,,Мен неге мұндамын?
Dialogue: 0,0:09:29.10,0:09:31.04,Default,,0000,0000,0000,,Орындар көп емес.
Dialogue: 0,0:09:29.10,0:09:31.04,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:09:31.04,0:09:34.04,Default,,0000,0000,0000,,Бұл жүк сақтау орны емес пе?
Dialogue: 0,0:09:34.04,0:09:37.04,Default,,0000,0000,0000,,Әй, қария, сенің атың кім?
Dialogue: 0,0:09:34.04,0:09:37.04,Default,,0000,0000,0000,,Нева.
Dialogue: 0,0:09:37.04,0:09:40.05,Default,,0000,0000,0000,,Нева-сан
Dialogue: 0,0:09:37.04,0:09:40.05,Default,,0000,0000,0000,,Сен сонда жалғыз тұрасың ба?
Dialogue: 0,0:09:40.05,0:09:43.05,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:09:40.05,0:09:43.05,Default,,0000,0000,0000,,Аа, сен жалғыз емессің бе?
Dialogue: 0,0:09:43.05,0:09:46.05,Default,,0000,0000,0000,,Ал, аздап.
Dialogue: 0,0:09:46.05,0:09:49.06,Default,,0000,0000,0000,,Кайошин
Dialogue: 0,0:09:46.05,0:09:49.06,Default,,0000,0000,0000,,Неге барлығымен бірге?
Dialogue: 0,0:09:46.05,0:09:49.06,Default,,0000,0000,0000,,Сен кеткен жоқсың ба?
Dialogue: 0,0:09:49.06,0:09:52.06,Default,,0000,0000,0000,,Маған ұнайды.
Dialogue: 0,0:09:52.06,0:09:55.06,Default,,0000,0000,0000,,Соңында
Dialogue: 0,0:09:52.06,0:09:55.06,Default,,0000,0000,0000,,Барлығы қайтып келгенде➡
Dialogue: 0,0:09:55.06,0:09:58.06,Default,,0000,0000,0000,,Біз сол аумақты қорғауымыз керек.
Dialogue: 0,0:09:58.06,0:10:01.07,Default,,0000,0000,0000,,Нева-сан, неге?
Dialogue: 0,0:09:58.06,0:10:01.07,Default,,0000,0000,0000,,Тамагами-саманы жасадыңыз ба?
Dialogue: 0,0:10:01.07,0:10:05.07,Default,,0000,0000,0000,,Жердегі Айдаһар шарларында
Dialogue: 0,0:10:01.07,0:10:05.07,Default,,0000,0000,0000,,Ондай нәрсе жоқ.
Dialogue: 0,0:10:05.07,0:10:08.07,Default,,0000,0000,0000,,Бастапқыда
Dialogue: 0,0:10:05.07,0:10:08.07,Default,,0000,0000,0000,,Айдаһар добы ➡
Dialogue: 0,0:10:08.07,0:10:13.08,Default,,0000,0000,0000,,Намекиандықтардың ғана күш-жігері үшін
Dialogue: 0,0:10:08.07,0:10:13.08,Default,,0000,0000,0000,,Бұл сыйлық сияқты болды, бірақ... ➡
Dialogue: 0,0:10:13.08,0:10:17.08,Default,,0000,0000,0000,,Ақырында
Dialogue: 0,0:10:13.08,0:10:17.08,Default,,0000,0000,0000,,Тіпті жаман адамдар да біледі➡
Dialogue: 0,0:10:17.08,0:10:21.09,Default,,0000,0000,0000,,ақымақтықпен
Dialogue: 0,0:10:17.08,0:10:21.09,Default,,0000,0000,0000,,қолданысқа енді.
Dialogue: 0,0:10:21.09,0:10:25.09,Default,,0000,0000,0000,,Ешкім
Dialogue: 0,0:10:21.09,0:10:25.09,Default,,0000,0000,0000,,Оны оңай ұрлау мүмкін болмады.
Dialogue: 0,0:10:25.09,0:10:27.09,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:10:27.09,0:10:30.10,Default,,0000,0000,0000,,Бірақ бұл жазықтық баяу.
Dialogue: 0,0:10:30.10,0:10:32.03,Default,,0000,0000,0000,,Ора және басқалары мінген ұшақ болса➡
Dialogue: 0,0:10:32.03,0:10:34.03,Default,,0000,0000,0000,,Баяғыда
Dialogue: 0,0:10:32.03,0:10:34.03,Default,,0000,0000,0000,,Сіз әлі келдіңіз бе?
Dialogue: 0,0:10:34.03,0:10:38.04,Default,,0000,0000,0000,,Маған көлік беріңіз
Dialogue: 0,0:10:34.03,0:10:38.04,Default,,0000,0000,0000,,Өзімшіл болма.
Dialogue: 0,0:10:38.04,0:10:41.04,Default,,0000,0000,0000,,Айтпақшы
Dialogue: 0,0:10:38.04,0:10:41.04,Default,,0000,0000,0000,,Тамагамимен келесі шайқас➡
Dialogue: 0,0:10:41.04,0:10:43.04,Default,,0000,0000,0000,,Мен мұны істеймін.
Dialogue: 0,0:10:43.04,0:10:45.04,Default,,0000,0000,0000,,Е! ? Бұл дұрыс емес!
Dialogue: 0,0:10:45.04,0:10:47.05,Default,,0000,0000,0000,,Сіз мұны бір рет жасадыңыз.
Dialogue: 0,0:10:47.05,0:10:49.05,Default,,0000,0000,0000,,Енді менің кезегім.
Dialogue: 0,0:10:49.05,0:10:54.05,Default,,0000,0000,0000,,Ата, болды
Dialogue: 0,0:10:49.05,0:10:54.05,Default,,0000,0000,0000,,Басқа адам жарысса дұрыс па?
Dialogue: 0,0:10:54.05,0:10:58.06,Default,,0000,0000,0000,,Ах, егер бұл бір адамға қарсы болса.
Dialogue: 0,0:10:54.05,0:10:58.06,Default,,0000,0000,0000,,Оның басқаша болғаны маңызды емес.
Dialogue: 0,0:10:58.06,0:11:00.06,Default,,0000,0000,0000,,Хехе, бұл анық.
Dialogue: 0,0:11:00.06,0:11:02.06,Default,,0000,0000,0000,,Бұл не? Эй.
Dialogue: 0,0:11:02.06,0:11:06.07,Default,,0000,0000,0000,,Балалар, сендер төбелескің келе ме?
Dialogue: 0,0:11:06.07,0:11:10.07,Default,,0000,0000,0000,,Маған екеуі де ұнайды.
Dialogue: 0,0:11:06.07,0:11:10.07,Default,,0000,0000,0000,,Шайқас.
Dialogue: 0,0:11:20.08,0:11:23.08,Default,,0000,0000,0000,,Дрол.
Dialogue: 0,0:11:41.03,0:11:43.04,Default,,0000,0000,0000,,Оны дұрыс өлшеңіз.
Dialogue: 0,0:11:43.04,0:11:45.07,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:11:45.07,0:11:47.04,Default,,0000,0000,0000,,Содан кейін тұқымдарды көміңіз.
Dialogue: 0,0:11:50.04,0:11:54.05,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:54.05,0:11:58.05,Default,,0000,0000,0000,,Айтпақшы, мына жігіт екеуміз
Dialogue: 0,0:11:54.05,0:11:58.05,Default,,0000,0000,0000,,Бұл олардың ағайынды екенін білдіре ме?
Dialogue: 0,0:11:58.05,0:12:02.05,Default,,0000,0000,0000,,Аа... жақсы
Dialogue: 0,0:11:58.05,0:12:02.05,Default,,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:12:02.05,0:12:06.06,Default,,0000,0000,0000,,Мен өте қуаныштымын! мен аға
Dialogue: 0,0:12:02.05,0:12:06.06,Default,,0000,0000,0000,,Мен мұны қаладым!
Dialogue: 0,0:12:06.06,0:12:09.06,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:12:09.06,0:12:11.06,Default,,0000,0000,0000,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:12:16.10,0:12:19.07,Default,,0000,0000,0000,,Куу суы.
Dialogue: 0,0:12:29.08,0:12:32.02,Default,,0000,0000,0000,,Бұл жақсы! ?
Dialogue: 0,0:12:32.02,0:12:34.02,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:12:38.02,0:12:40.03,Default,,0000,0000,0000,,О.
Dialogue: 0,0:12:40.03,0:12:56.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:56.04,0:12:58.04,Default,,0000,0000,0000,,А... Иә?
Dialogue: 0,0:12:58.04,0:13:01.05,Default,,0000,0000,0000,,Марва Келесі жынның аты кім?
Dialogue: 0,0:13:01.05,0:13:04.05,Default,,0000,0000,0000,,Мажин
Dialogue: 0,0:13:01.05,0:13:04.05,Default,,0000,0000,0000,,Бұл Маджин До!
Dialogue: 0,0:13:10.06,0:13:12.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:14.06,0:13:16.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:49.93,0:13:52.93,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:13:52.93,0:13:54.93,Default,,0000,0000,0000,,Ах, хаха.
Dialogue: 0,0:13:59.94,0:14:05.95,Default,,0000,0000,0000,,Гяо~!
Dialogue: 0,0:14:07.95,0:14:10.95,Default,,0000,0000,0000,,ғұн хун хун➡
Dialogue: 0,0:14:10.95,0:14:15.96,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:14:18.96,0:14:21.29,Default,,0000,0000,0000,,Ноча!
Dialogue: 0,0:14:21.29,0:14:24.96,Default,,0000,0000,0000,,Ноча!
Dialogue: 0,0:14:24.96,0:14:26.97,Default,,0000,0000,0000,,Мен шоколад жегім келеді.
Dialogue: 0,0:14:26.97,0:14:28.97,Default,,0000,0000,0000,,Ха!?
Dialogue: 0,0:14:28.97,0:14:31.90,Default,,0000,0000,0000,,Мен шоколад жегім келеді!
Dialogue: 0,0:14:31.90,0:14:33.91,Default,,0000,0000,0000,,Ма… Марва.
Dialogue: 0,0:14:31.90,0:14:33.91,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:33.91,0:14:37.91,Default,,0000,0000,0000,,Сізде шоколад бар ма?
Dialogue: 0,0:14:33.91,0:14:37.91,Default,,0000,0000,0000,,№.
Dialogue: 0,0:14:37.91,0:14:42.92,Default,,0000,0000,0000,,Ақша беріңізші. Жүгіру
Dialogue: 0,0:14:37.91,0:14:42.92,Default,,0000,0000,0000,,Мен оны ыңғайлы дүкеннен аламын.
Dialogue: 0,0:14:51.92,0:14:54.93,Default,,0000,0000,0000,,Қараңызшы, бұл шоколад.
Dialogue: 0,0:14:51.92,0:14:54.93,Default,,0000,0000,0000,,Қазір ғана құмар көздеріңмен мені шолып тұрдың ғой, иә?
Dialogue: 0,0:15:01.93,0:15:03.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:05.94,0:15:08.94,Default,,0000,0000,0000,,Ағам жасағанның жартысын мен жасаймын.
Dialogue: 0,0:15:08.94,0:15:11.28,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:15:08.94,0:15:11.28,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:11.28,0:15:15.28,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:15:11.28,0:15:15.28,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:15:15.28,0:15:16.95,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:15:16.95,0:15:18.95,Default,,0000,0000,0000,,осындай нәрсе
Dialogue: 0,0:15:16.95,0:15:18.95,Default,,0000,0000,0000,,Мен мұны істегім келді.
Dialogue: 0,0:15:18.95,0:15:21.62,Default,,0000,0000,0000,,Тәттілер үшін жарысу!
Dialogue: 0,0:15:21.62,0:15:23.96,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:15:23.96,0:15:26.96,Default,,0000,0000,0000,,Сіз мұны істей алмайсыз!
Dialogue: 0,0:15:26.96,0:15:29.96,Default,,0000,0000,0000,,Сонда мен не істеймін?
Dialogue: 0,0:15:29.96,0:15:32.97,Default,,0000,0000,0000,,Ах... а...
Dialogue: 0,0:15:32.97,0:15:35.97,Default,,0000,0000,0000,,Бұдан былай Тамагами туралы айтатын боламыз.
Dialogue: 0,0:15:32.97,0:15:35.97,Default,,0000,0000,0000,,Мен сенің жарысқаныңды қалаймын...
Dialogue: 0,0:15:35.97,0:15:37.97,Default,,0000,0000,0000,,«Бұл мүлдем керісінше! Менің жайымды қарашы!»
Dialogue: 0,0:15:35.97,0:15:37.97,Default,,0000,0000,0000,,Ойнайық. Әйтеуір біз пианисттер ғой.
Dialogue: 0,0:15:37.97,0:15:42.98,Default,,0000,0000,0000,,Қалай... шамасы
Dialogue: 0,0:15:37.97,0:15:42.98,Default,,0000,0000,0000,,Бұл жай ғана қауіпсіз сияқты.
Dialogue: 0,0:15:42.98,0:15:44.98,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:15:50.98,0:15:54.99,Default,,0000,0000,0000,,(Гоку және оның достары ұйықтап жатыр)
Dialogue: 0,0:15:54.99,0:15:59.99,Default,,0000,0000,0000,,Енді сіз оны көре аласыз.
Dialogue: 0,0:15:54.99,0:15:59.99,Default,,0000,0000,0000,,Бұл екінші жын әлеміндегі Тамагами.
Dialogue: 0,0:15:59.99,0:16:01.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:13.01,0:16:16.01,Default,,0000,0000,0000,,Бұл Тамагами.
Dialogue: 0,0:16:18.01,0:16:20.01,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:16:27.02,0:16:31.96,Default,,0000,0000,0000,,Гяо!
Dialogue: 0,0:16:27.02,0:16:31.96,Default,,0000,0000,0000,,Мен Маджин До!
Dialogue: 0,0:16:31.96,0:16:33.96,Default,,0000,0000,0000,,Сіз жарысқа қатысасыз ба?
Dialogue: 0,0:16:33.96,0:16:35.96,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:16:39.97,0:16:41.97,Default,,0000,0000,0000,,«Бұл мүлдем керісінше! Менің жайымды қарашы!»
Dialogue: 0,0:16:46.97,0:16:49.98,Default,,0000,0000,0000,,Сәттілік! Ду!
Dialogue: 0,0:16:49.98,0:16:51.98,Default,,0000,0000,0000,,Ах, уф….
Dialogue: 0,0:16:51.98,0:16:54.98,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:16:54.98,0:16:56.98,Default,,0000,0000,0000,,Амансың ба? Сол жігіт.
Dialogue: 0,0:16:56.98,0:16:58.98,Default,,0000,0000,0000,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:17:04.99,0:17:06.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:15.00,0:17:16.67,Default,,0000,0000,0000,,Мистер Спидвагоннан қоңырау
Dialogue: 0,0:17:16.67,0:17:20.01,Default,,0000,0000,0000,,Дөңгелек және дөңгелек.
Dialogue: 0,0:17:20.01,0:17:22.01,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:17:20.01,0:17:22.01,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:17:24.01,0:17:26.01,Default,,0000,0000,0000,,Боёонг! ➡
Dialogue: 0,0:17:26.01,0:17:28.68,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:17:26.01,0:17:28.68,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:17:28.68,0:17:30.95,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:17:30.95,0:17:32.95,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:17:37.62,0:17:41.96,Default,,0000,0000,0000,,Буню.
Dialogue: 0,0:17:37.62,0:17:41.96,Default,,0000,0000,0000,,Тоу! Гочин!
Dialogue: 0,0:17:41.96,0:17:44.96,Default,,0000,0000,0000,,Тоу!
Dialogue: 0,0:17:44.96,0:17:46.97,Default,,0000,0000,0000,,Гяо~!
Dialogue: 0,0:17:46.97,0:17:50.97,Default,,0000,0000,0000,,О….
Dialogue: 0,0:17:46.97,0:17:50.97,Default,,0000,0000,0000,,Жақсы, істе!
Dialogue: 0,0:17:50.97,0:17:52.97,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:18:03.98,0:18:05.98,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:18:07.99,0:18:09.99,Default,,0000,0000,0000,,Хо~.
Dialogue: 0,0:18:24.00,0:18:26.00,Default,,0000,0000,0000,,Бұл Тамагами-сама ма?
Dialogue: 0,0:18:26.00,0:18:28.01,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:18:28.01,0:18:31.94,Default,,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:18:28.01,0:18:31.94,Default,,0000,0000,0000,,Үлкен қола мүсінге ұқсайды.
Dialogue: 0,0:18:31.94,0:18:33.95,Default,,0000,0000,0000,,Егер сіз оны төбелеске шақырсаңыз, ол қозғала бастайды.
Dialogue: 0,0:18:33.95,0:18:37.95,Default,,0000,0000,0000,,Иә? Осылайша
Dialogue: 0,0:18:33.95,0:18:37.95,Default,,0000,0000,0000,,Мен Айдаһар шарларын қорғаймын.
Dialogue: 0,0:18:37.95,0:18:41.95,Default,,0000,0000,0000,,Айтайын, Тамагами
Dialogue: 0,0:18:37.95,0:18:41.95,Default,,0000,0000,0000,,Бұл өте күшті.
Dialogue: 0,0:18:41.95,0:18:45.96,Default,,0000,0000,0000,,Жын қанша күшті болса да ұзақ уақыт
Dialogue: 0,0:18:41.95,0:18:45.96,Default,,0000,0000,0000,,Қарсылас емес.
Dialogue: 0,0:18:45.96,0:18:49.96,Default,,0000,0000,0000,,Қанша күшті болса да
Dialogue: 0,0:18:45.96,0:18:49.96,Default,,0000,0000,0000,,Гоку сияқты жақсы емес, солай ма?
Dialogue: 0,0:18:49.96,0:18:53.97,Default,,0000,0000,0000,,Жеңіл-желпі қарасаң, қиындыққа тап боласың.
Dialogue: 0,0:18:53.97,0:18:55.97,Default,,0000,0000,0000,,Жарайды, оны көргенде түсінесің.
Dialogue: 0,0:18:55.97,0:18:59.97,Default,,0000,0000,0000,,Жарайды…. Хмм.
Dialogue: 0,0:18:59.97,0:19:02.98,Default,,0000,0000,0000,,Екінші нөмірлі Тамагамимен
Dialogue: 0,0:18:59.97,0:19:02.98,Default,,0000,0000,0000,,Мотивацияңыз бар ма?
Dialogue: 0,0:19:02.98,0:19:05.98,Default,,0000,0000,0000,,Төбелескен шашы кіршіксіз.
Dialogue: 0,0:19:02.98,0:19:05.98,Default,,0000,0000,0000,,Жоқ сияқты.
Dialogue: 0,0:19:05.98,0:19:08.98,Default,,0000,0000,0000,,Бұл да бейберекет!
Dialogue: 0,0:19:10.98,0:19:15.99,Default,,0000,0000,0000,,Эй, айдаһар доп
Dialogue: 0,0:19:10.98,0:19:15.99,Default,,0000,0000,0000,,Мен оны алуға келдім. Ұрыс.
Dialogue: 0,0:19:15.99,0:19:20.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:15.99,0:19:20.99,Default,,0000,0000,0000,,Не... сен әлі бала емессің бе?
Dialogue: 0,0:19:20.99,0:19:25.00,Default,,0000,0000,0000,,Қалжыңдауды қойып, үйге қайт.
Dialogue: 0,0:19:20.99,0:19:25.00,Default,,0000,0000,0000,,Анаңның кеудесін де сор.
Dialogue: 0,0:19:25.00,0:19:30.00,Default,,0000,0000,0000,,Матч басталғаннан кейін
Dialogue: 0,0:19:25.00,0:19:30.00,Default,,0000,0000,0000,,Жаңа айтқан сөзіңізге өкінесіз.
Dialogue: 0,0:19:30.00,0:19:33.01,Default,,0000,0000,0000,,Хмм…. иә?
Dialogue: 0,0:19:37.94,0:19:40.95,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:19:37.94,0:19:40.95,Default,,0000,0000,0000,,Уа...
Dialogue: 0,0:19:40.95,0:19:43.95,Default,,0000,0000,0000,,Бұл жігіт дөрекі.
Dialogue: 0,0:19:40.95,0:19:43.95,Default,,0000,0000,0000,,Олар байсалды сияқты.
Dialogue: 0,0:19:43.95,0:19:47.95,Default,,0000,0000,0000,,Мен асығыспын.
Dialogue: 0,0:19:43.95,0:19:47.95,Default,,0000,0000,0000,,бастайық.
Dialogue: 0,0:19:47.95,0:19:50.96,Default,,0000,0000,0000,,Жарайды. Мен екінші нөмірлі Тамагамимін.
Dialogue: 0,0:19:50.96,0:19:54.96,Default,,0000,0000,0000,,Айдаһар допты ойнаңыз➡
Dialogue: 0,0:19:54.96,0:19:56.96,Default,,0000,0000,0000,,Корпус мүшелеріне бір-біріне негізсіз қылыш кезенуге мүлде болмайды!
Dialogue: 0,0:20:00.97,0:20:02.97,Default,,0000,0000,0000,,Басы.
Dialogue: 0,0:20:02.97,0:20:04.97,Default,,0000,0000,0000,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:20:10.98,0:20:12.98,Default,,0000,0000,0000,,Таа!
Dialogue: 0,0:20:16.98,0:20:18.98,Default,,0000,0000,0000,,Келесі аптаның қолжазбасын аяқтауға тек екі бет қана қалды.
Dialogue: 0,0:20:23.99,0:20:26.66,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:20:26.66,0:20:28.99,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:20:28.99,0:20:30.93,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:20:28.99,0:20:30.93,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:20:30.93,0:20:35.93,Default,,0000,0000,0000,,О...
Dialogue: 0,0:20:35.93,0:20:37.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:35.93,0:20:37.94,Default,,0000,0000,0000,,Ах...➡
Dialogue: 0,0:20:37.94,0:20:40.94,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:20:40.94,0:20:42.94,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:40.94,0:20:42.94,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:42.94,0:20:44.98,Default,,0000,0000,0000,,Бұл жігіт керемет!
Dialogue: 0,0:20:44.98,0:20:46.95,Default,,0000,0000,0000,,Әлі алда.
Dialogue: 0,0:20:52.95,0:20:55.95,Default,,0000,0000,0000,,Аа... Ха...
Dialogue: 0,0:20:57.96,0:20:59.96,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:20:59.96,0:21:01.96,Default,,0000,0000,0000,,Ууууах!
Dialogue: 0,0:21:03.96,0:21:05.96,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:21:12.97,0:21:15.97,Default,,0000,0000,0000,,Уф! ой... у...
Dialogue: 0,0:21:15.97,0:21:17.98,Default,,0000,0000,0000,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:21:22.98,0:21:25.98,Default,,0000,0000,0000,,Нчачачача….
Dialogue: 0,0:21:22.98,0:21:25.98,Default,,0000,0000,0000,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:21:25.98,0:21:29.99,Default,,0000,0000,0000,,Чачачача….
Dialogue: 0,0:21:25.98,0:21:29.99,Default,,0000,0000,0000,,Міне солай, ду!
Dialogue: 0,0:21:31.92,0:21:33.93,Default,,0000,0000,0000,,Таа!
Dialogue: 0,0:21:35.93,0:21:37.93,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:21:37.93,0:21:40.93,Default,,0000,0000,0000,,Ууууууу…. ➡
Dialogue: 0,0:21:40.93,0:21:43.94,Default,,0000,0000,0000,,Ах! Ахх!
Dialogue: 0,0:21:49.94,0:21:52.94,Default,,0000,0000,0000,,Гуоооо~.
Dialogue: 0,0:21:55.95,0:21:59.95,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:21:55.95,0:21:59.95,Default,,0000,0000,0000,,Нашар Кракен!
Dialogue: 0,0:22:03.96,0:22:05.96,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:05.96,0:22:20.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:20.97,0:22:22.97,Default,,0000,0000,0000,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:22:22.97,0:22:25.98,Default,,0000,0000,0000,,Мен көптен күттім. ➡
Dialogue: 0,0:22:25.98,0:22:27.98,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:22:25.98,0:22:27.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:27.98,0:22:31.92,Default,,0000,0000,0000,,Ге~ссо~!
Dialogue: 0,0:22:31.92,0:22:35.92,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:22:35.92,0:22:38.92,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:22:35.92,0:22:38.92,Default,,0000,0000,0000,,Ах! Ах! Ах...
Dialogue: 0,0:22:38.92,0:22:43.93,Default,,0000,0000,0000,,Вегета!
Dialogue: 0,0:22:38.92,0:22:43.93,Default,,0000,0000,0000,,Гуооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооуу
Dialogue: 0,0:22:49.94,0:22:59.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:01.45,0:23:07.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory