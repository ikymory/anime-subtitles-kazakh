Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:06.04,Default,,0000,0000,0000,,[Айдаһар шары дегеніміз не?
Dialogue: 0,0:00:02.04,0:00:06.04,Default,,0000,0000,0000,,7 бөлікті жинап, құпия сөзді айт➡
Dialogue: 0,0:00:06.04,0:00:09.04,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:06.04,0:00:09.04,Default,,0000,0000,0000,,Шенрон атты айдаһар пайда болады➡
Dialogue: 0,0:00:09.04,0:00:14.05,Default,,0000,0000,0000,,Кез келген тілек орындалады
Dialogue: 0,0:00:09.04,0:00:14.05,Default,,0000,0000,0000,,Бұл жұмбақ доп]
Dialogue: 0,0:00:14.05,0:00:18.05,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:00:14.05,0:00:18.05,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:00:14.05,0:00:18.05,Default,,0000,0000,0000,,[Бұл Сон Гоку адам
Dialogue: 0,0:00:14.05,0:00:18.05,Default,,0000,0000,0000,,Сабырлы болып көрінсе де➡
Dialogue: 0,0:00:18.05,0:00:24.06,Default,,0000,0000,0000,,Төтенше күшке ие
Dialogue: 0,0:00:18.05,0:00:24.06,Default,,0000,0000,0000,,Жауынгер нәсіл - Сайандар]
Dialogue: 0,0:00:24.06,0:00:28.06,Default,,0000,0000,0000,,[Достармен кездесу]
Dialogue: 0,0:00:24.06,0:00:28.06,Default,,0000,0000,0000,,Бірге шытырман оқиға➡
Dialogue: 0,0:00:28.06,0:00:32.07,Default,,0000,0000,0000,,Ересек болып өсу]
Dialogue: 0,0:00:32.07,0:00:40.07,Default,,0000,0000,0000,,[және қазір де зұлымдық қолынан]
Dialogue: 0,0:00:32.07,0:00:40.07,Default,,0000,0000,0000,,Жерді қорғауды жалғастыру]
Dialogue: 0,0:00:40.07,0:00:50.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:22.01,0:02:24.01,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:24.01,0:02:26.01,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:02:26.01,0:02:27.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:30.02,0:02:32.95,Default,,0000,0000,0000,,А, қозғалтқыш қорқынышты көрінеді!
Dialogue: 0,0:02:30.02,0:02:32.95,Default,,0000,0000,0000,,Кайошин
Dialogue: 0,0:02:30.02,0:02:32.95,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:02:32.95,0:02:36.96,Default,,0000,0000,0000,,Тозып кетсе де
Dialogue: 0,0:02:32.95,0:02:36.96,Default,,0000,0000,0000,,Менің ойымша, мен тым көп жүк алып кеттім.
Dialogue: 0,0:02:36.96,0:02:39.93,Default,,0000,0000,0000,,Мықтап ұстаңыз!
Dialogue: 0,0:02:41.96,0:02:43.93,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:00.98,0:03:03.98,Default,,0000,0000,0000,,Өйткені, бұл артық салмақтан.
Dialogue: 0,0:03:00.98,0:03:03.98,Default,,0000,0000,0000,,Жаңа ғана қате орын алған сияқты.
Dialogue: 0,0:03:03.98,0:03:05.99,Default,,0000,0000,0000,,Сіз не жүктедіңіз?
Dialogue: 0,0:03:05.99,0:03:09.99,Default,,0000,0000,0000,,Төтенше жағдайлар үшін
Dialogue: 0,0:03:05.99,0:03:09.99,Default,,0000,0000,0000,,Мен көп заттар әкелдім. ➡
Dialogue: 0,0:03:09.99,0:03:13.99,Default,,0000,0000,0000,,Бұл жөндеу құралы.
Dialogue: 0,0:03:09.99,0:03:13.99,Default,,0000,0000,0000,,Лагерьге арналған құрал-жабдықтар, алғашқы медициналық көмек көрсету қобдишасы және т.б.➡
Dialogue: 0,0:03:13.99,0:03:16.00,Default,,0000,0000,0000,,Орамалға
Dialogue: 0,0:03:13.99,0:03:16.00,Default,,0000,0000,0000,,Дәретхана қағазы сияқты заттар.
Dialogue: 0,0:03:16.00,0:03:20.97,Default,,0000,0000,0000,,Бұл аздап артық болған сияқты.
Dialogue: 0,0:03:16.00,0:03:20.97,Default,,0000,0000,0000,,Жартысын қалдырыңыз.
Dialogue: 0,0:03:28.01,0:03:31.98,Default,,0000,0000,0000,,Мен барлығын тексергім келеді.
Dialogue: 0,0:03:28.01,0:03:31.98,Default,,0000,0000,0000,,Бір минут күтіңіз.
Dialogue: 0,0:03:33.95,0:03:36.95,Default,,0000,0000,0000,,Сәлем, Гоку
Dialogue: 0,0:03:33.95,0:03:36.95,Default,,0000,0000,0000,,Сіз туралы бұрын➡
Dialogue: 0,0:03:36.95,0:03:39.95,Default,,0000,0000,0000,,Әйтеуір кешіріңіз
Dialogue: 0,0:03:36.95,0:03:39.95,Default,,0000,0000,0000,,Сіз мұны айттыңыз, бірақ бұл не?
Dialogue: 0,0:03:39.95,0:03:42.96,Default,,0000,0000,0000,,О, Кай патша?
Dialogue: 0,0:03:42.96,0:03:44.96,Default,,0000,0000,0000,,Орас ғаламында➡
Dialogue: 0,0:03:44.96,0:03:47.96,Default,,0000,0000,0000,,Кай патша құдай сияқты.
Dialogue: 0,0:03:44.96,0:03:47.96,Default,,0000,0000,0000,,Кейбір адамдар бар➡
Dialogue: 0,0:03:47.96,0:03:50.96,Default,,0000,0000,0000,,Олардың ішіндегі ең үлкені➡
Dialogue: 0,0:03:50.96,0:03:52.97,Default,,0000,0000,0000,,Оны Кай патша деп атайды.
Dialogue: 0,0:03:52.97,0:03:56.97,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:52.97,0:03:56.97,Default,,0000,0000,0000,,Міне, осындай сезім.
Dialogue: 0,0:03:56.97,0:03:59.97,Default,,0000,0000,0000,,Не? Сіз құдайсыз ба?
Dialogue: 0,0:03:59.97,0:04:02.98,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:03:59.97,0:04:02.98,Default,,0000,0000,0000,,Осылай...
Dialogue: 0,0:04:02.98,0:04:04.98,Default,,0000,0000,0000,,Бұл керемет!
Dialogue: 0,0:04:04.98,0:04:06.98,Default,,0000,0000,0000,,Сыртқы дүние дегеніміз не?
Dialogue: 0,0:04:04.98,0:04:06.98,Default,,0000,0000,0000,,Ұлы жын әлемінен әлдеқайда үлкен емес пе?
Dialogue: 0,0:04:06.98,0:04:10.98,Default,,0000,0000,0000,,Ұлы жын әлемінен қашу
Dialogue: 0,0:04:06.98,0:04:10.98,Default,,0000,0000,0000,,Дұрыс айттыңыз!
Dialogue: 0,0:04:10.98,0:04:12.99,Default,,0000,0000,0000,,Сіз қазірдің өзінде ақша тауып жүрсіз бе?
Dialogue: 0,0:04:12.99,0:04:14.99,Default,,0000,0000,0000,,Мен ақша сұрамаймын...
Dialogue: 0,0:04:14.99,0:04:18.99,Default,,0000,0000,0000,,Не? Мен бұл не екенін түсінбеймін.
Dialogue: 0,0:04:18.99,0:04:20.99,Default,,0000,0000,0000,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:04:20.99,0:04:23.00,Default,,0000,0000,0000,,Сәлем, Горилло.
Dialogue: 0,0:04:23.00,0:04:27.00,Default,,0000,0000,0000,,Бұл Глорио.
Dialogue: 0,0:04:23.00,0:04:27.00,Default,,0000,0000,0000,,Сіз әдейі қателесіп жатырсыз.
Dialogue: 0,0:04:27.00,0:04:29.00,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:04:29.00,0:04:30.94,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:04:29.00,0:04:30.94,Default,,0000,0000,0000,,Дұрыс айт.
Dialogue: 0,0:04:30.94,0:04:34.94,Default,,0000,0000,0000,,Ум... Гу... Глорио.
Dialogue: 0,0:04:34.94,0:04:37.94,Default,,0000,0000,0000,,Жарайды. Не?
Dialogue: 0,0:04:37.94,0:04:39.95,Default,,0000,0000,0000,,Тәжік.
Dialogue: 0,0:04:39.95,0:04:41.91,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:44.95,0:04:48.96,Default,,0000,0000,0000,,Сіз жаңа ғана кетіп қалдыңыз.
Dialogue: 0,0:04:44.95,0:04:48.96,Default,,0000,0000,0000,,Сен неге сарайға бармадың?
Dialogue: 0,0:04:48.96,0:04:52.96,Default,,0000,0000,0000,,Өйткені мен кенеттен қаладым
Dialogue: 0,0:04:48.96,0:04:52.96,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:04:52.96,0:04:55.96,Default,,0000,0000,0000,,Мен сонда біраз уақыт боламын.
Dialogue: 0,0:04:55.96,0:04:57.96,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:04:57.96,0:04:59.97,Default,,0000,0000,0000,,Әй, Панджи!
Dialogue: 0,0:04:57.96,0:04:59.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:59.97,0:05:03.97,Default,,0000,0000,0000,,Сізде қағаз бар ма?
Dialogue: 0,0:05:03.97,0:05:06.97,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:05:06.97,0:05:09.98,Default,,0000,0000,0000,,Ах... Уф.
Dialogue: 0,0:05:09.98,0:05:11.98,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:05:11.98,0:05:14.98,Default,,0000,0000,0000,,Өзіңізбен бірге әртүрлі заттарды әкеліңіз.
Dialogue: 0,0:05:11.98,0:05:14.98,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:05:14.98,0:05:17.98,Default,,0000,0000,0000,,Сол жігіт
Dialogue: 0,0:05:14.98,0:05:17.98,Default,,0000,0000,0000,,Ол керемет жігіт, солай емес пе?
Dialogue: 0,0:05:17.98,0:05:21.95,Default,,0000,0000,0000,,Менің білуімше
Dialogue: 0,0:05:17.98,0:05:21.95,Default,,0000,0000,0000,,Әлемдегі ең жақсысы шығар.
Dialogue: 0,0:05:23.99,0:05:25.96,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:05:29.00,0:05:30.93,Default,,0000,0000,0000,,
Dialogue: 0,0:05:29.00,0:05:30.93,Default,,0000,0000,0000,,Бұл жаман! Бұл әскери полиция ұшағы!
Dialogue: 0,0:05:30.93,0:05:32.93,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:32.93,0:05:35.90,Default,,0000,0000,0000,,Иә? Эй.
Dialogue: 0,0:05:32.93,0:05:35.90,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:40.94,0:05:42.94,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:05:42.94,0:05:45.95,Default,,0000,0000,0000,,Мұнда тыныш отырайық. ➡
Dialogue: 0,0:05:45.95,0:05:47.91,Default,,0000,0000,0000,,Бұл қиындық тудырады.
Dialogue: 0,0:05:49.95,0:05:51.95,Default,,0000,0000,0000,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:05:51.95,0:05:54.95,Default,,0000,0000,0000,,Үзіліс жасаңыз.
Dialogue: 0,0:05:54.95,0:05:58.96,Default,,0000,0000,0000,,Екеуіңнің жағаларың жоқ.
Dialogue: 0,0:05:54.95,0:05:58.96,Default,,0000,0000,0000,,Сіз қайдансыз?
Dialogue: 0,0:05:58.96,0:06:02.96,Default,,0000,0000,0000,,Бірінші жын әлемі.
Dialogue: 0,0:05:58.96,0:06:02.96,Default,,0000,0000,0000,,Мен екінші жын дүниемін.
Dialogue: 0,0:06:02.96,0:06:04.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:07.97,0:06:12.97,Default,,0000,0000,0000,,Бұл күдікті.
Dialogue: 0,0:06:07.97,0:06:12.97,Default,,0000,0000,0000,,Бір-біріне ұқсамайтын жын әлемінен шыққан үш адам. ➡
Dialogue: 0,0:06:12.97,0:06:15.98,Default,,0000,0000,0000,,Мақсаты не?
Dialogue: 0,0:06:15.98,0:06:17.94,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:06:19.98,0:06:22.98,Default,,0000,0000,0000,,Жігітім екеуміз дос болып, саяхаттап жүрдік➡
Dialogue: 0,0:06:22.98,0:06:25.99,Default,,0000,0000,0000,,Мына қызға
Dialogue: 0,0:06:22.98,0:06:25.99,Default,,0000,0000,0000,,Мен гид сұрадым.
Dialogue: 0,0:06:25.99,0:06:29.99,Default,,0000,0000,0000,,Осындай жын әлеміне саяхаттау?
Dialogue: 0,0:06:25.99,0:06:29.99,Default,,0000,0000,0000,,Сізге нәрселер ұнайды.
Dialogue: 0,0:06:29.99,0:06:31.92,Default,,0000,0000,0000,,Маған толқулар ұнайды.
Dialogue: 0,0:06:31.92,0:06:34.93,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:06:31.92,0:06:34.93,Default,,0000,0000,0000,,Айтпақшы➡
Dialogue: 0,0:06:34.93,0:06:37.93,Default,,0000,0000,0000,,Оның басы қырық, қолында қызыл таяқ.
Dialogue: 0,0:06:34.93,0:06:37.93,Default,,0000,0000,0000,,Сіз баланы көрмедіңіз бе?
Dialogue: 0,0:06:37.93,0:06:39.93,Default,,0000,0000,0000,,№.
Dialogue: 0,0:06:39.93,0:06:43.94,Default,,0000,0000,0000,,Оны көрсеңіз, әскери полицияға хабарласыңыз.
Dialogue: 0,0:06:39.93,0:06:43.94,Default,,0000,0000,0000,,Мен саған 10 алтын тиын беремін.
Dialogue: 0,0:06:43.94,0:06:45.91,Default,,0000,0000,0000,,​​Түсіндім.
Dialogue: 0,0:06:56.95,0:06:59.92,Default,,0000,0000,0000,,Күлсін, мен сергек болдым.
Dialogue: 0,0:07:01.95,0:07:03.96,Default,,0000,0000,0000,,Не? Қазір не болды?
Dialogue: 0,0:07:03.96,0:07:07.96,Default,,0000,0000,0000,,Сізге сәттілік болды.
Dialogue: 0,0:07:03.96,0:07:07.96,Default,,0000,0000,0000,,Сіз іздеудесіз.
Dialogue: 0,0:07:07.96,0:07:11.96,Default,,0000,0000,0000,,Гоку-сан, бұл шаш үлгісі?
Dialogue: 0,0:07:07.96,0:07:11.96,Default,,0000,0000,0000,,Мені ұстай алмайсың ба?
Dialogue: 0,0:07:11.96,0:07:16.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:11.96,0:07:16.97,Default,,0000,0000,0000,,Бұл мүмкін емес, менің күшті әдетім бар.
Dialogue: 0,0:07:16.97,0:07:18.97,Default,,0000,0000,0000,,Сонымен қатар, сіз қолыңызды жудыңыз ба?
Dialogue: 0,0:07:18.97,0:07:21.94,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:07:18.97,0:07:21.94,Default,,0000,0000,0000,,Қазірдің өзінде...
Dialogue: 0,0:07:34.92,0:07:38.93,Default,,0000,0000,0000,,Аман-есен ұшқаныңызға қуаныштымын.
Dialogue: 0,0:07:34.92,0:07:38.93,Default,,0000,0000,0000,,Пэнджи мырзаға рахмет.
Dialogue: 0,0:07:38.93,0:07:40.93,Default,,0000,0000,0000,,Жақсы. Одан да көп➡
Dialogue: 0,0:07:40.93,0:07:44.93,Default,,0000,0000,0000,,Гриндиялықтар
Dialogue: 0,0:07:40.93,0:07:44.93,Default,,0000,0000,0000,,Олардың ағаштан туғаны рас па?
Dialogue: 0,0:07:44.93,0:07:46.93,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:07:46.93,0:07:49.94,Default,,0000,0000,0000,,Иә! ? Бұл не?
Dialogue: 0,0:07:49.94,0:07:52.94,Default,,0000,0000,0000,,Біз гриндиялықтар
Dialogue: 0,0:07:49.94,0:07:52.94,Default,,0000,0000,0000,,Бірнеше жүз жылда бір рет➡
Dialogue: 0,0:07:52.94,0:07:54.94,Default,,0000,0000,0000,,Ұнтақ ағашынан
Dialogue: 0,0:07:52.94,0:07:54.94,Default,,0000,0000,0000,,Ол дүниеге келді.
Dialogue: 0,0:07:54.94,0:07:56.94,Default,,0000,0000,0000,,Шынымен! ?
Dialogue: 0,0:07:56.94,0:07:59.95,Default,,0000,0000,0000,,Сонда, Кай патша?
Dialogue: 0,0:07:56.94,0:07:59.95,Default,,0000,0000,0000,,Өсімдіктерді айтасың ба?
Dialogue: 0,0:07:59.95,0:08:02.95,Default,,0000,0000,0000,,Енді... бұл...
Dialogue: 0,0:08:02.95,0:08:06.95,Default,,0000,0000,0000,,Сондықтан тамақ ішпеңіз.
Dialogue: 0,0:08:02.95,0:08:06.95,Default,,0000,0000,0000,,Ол суға толы.
Dialogue: 0,0:08:06.95,0:08:09.96,Default,,0000,0000,0000,,Содан кейін Гомердің адъютанты Дегес.
Dialogue: 0,0:08:06.95,0:08:09.96,Default,,0000,0000,0000,,Сіз ағайындыларды айтасыз ба?
Dialogue: 0,0:08:09.96,0:08:14.96,Default,,0000,0000,0000,,216 жаста
Dialogue: 0,0:08:09.96,0:08:14.96,Default,,0000,0000,0000,,Ол менің бір ағаштан туған інім.
Dialogue: 0,0:08:14.96,0:08:16.96,Default,,0000,0000,0000,,Бұл олардың барлығы ағайынды екенін білдіре ме?
Dialogue: 0,0:08:16.96,0:08:19.97,Default,,0000,0000,0000,,Кибито мен сол қарт.
Dialogue: 0,0:08:16.96,0:08:19.97,Default,,0000,0000,0000,,Кай патша да?
Dialogue: 0,0:08:19.97,0:08:23.97,Default,,0000,0000,0000,,Ах... жоқ.
Dialogue: 0,0:08:19.97,0:08:23.97,Default,,0000,0000,0000,,Гриндте бес ағаш болды.
Dialogue: 0,0:08:23.97,0:08:25.97,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:08:25.97,0:08:28.98,Default,,0000,0000,0000,,Әй, неге Дегесу➡
Dialogue: 0,0:08:28.98,0:08:31.98,Default,,0000,0000,0000,,Барлық басқа гриндиандықтармен
Dialogue: 0,0:08:28.98,0:08:31.98,Default,,0000,0000,0000,,Көшеге шықпаңыз➡
Dialogue: 0,0:08:31.98,0:08:33.95,Default,,0000,0000,0000,,Сіз Ұлы Жындар әлемінде қалдыңыз ба?
Dialogue: 0,0:08:36.98,0:08:38.99,Default,,0000,0000,0000,,Дегесудің амбициясы күшті➡
Dialogue: 0,0:08:38.99,0:08:42.99,Default,,0000,0000,0000,,Минна дегеніміз не?
Dialogue: 0,0:08:38.99,0:08:42.99,Default,,0000,0000,0000,,Өйткені ат маған жараспады.
Dialogue: 0,0:08:42.99,0:08:49.00,Default,,0000,0000,0000,,Мен тағы бір гриндиандық әйел бар екеніне сенімдімін.
Dialogue: 0,0:08:42.99,0:08:49.00,Default,,0000,0000,0000,,Кемеңгер ғалым болды ма?
Dialogue: 0,0:08:49.00,0:08:51.00,Default,,0000,0000,0000,,Бұл Аринс.
Dialogue: 0,0:08:51.00,0:08:53.00,Default,,0000,0000,0000,,Ол менің әпкем.
Dialogue: 0,0:08:51.00,0:08:53.00,Default,,0000,0000,0000,,Ағайындылар.
Dialogue: 0,0:08:53.00,0:08:56.00,Default,,0000,0000,0000,,Гриндиялықтарға
Dialogue: 0,0:08:53.00,0:08:56.00,Default,,0000,0000,0000,,Жынысы жоқ➡
Dialogue: 0,0:08:56.00,0:09:00.01,Default,,0000,0000,0000,,Дәл
Dialogue: 0,0:08:56.00,0:09:00.01,Default,,0000,0000,0000,,Ер де, әйел де жоқ... ➡
Dialogue: 0,0:09:00.01,0:09:04.01,Default,,0000,0000,0000,,Ол әрқашан болды
Dialogue: 0,0:09:00.01,0:09:04.01,Default,,0000,0000,0000,,Ол ақылсыз ғалым еді. ➡
Dialogue: 0,0:09:04.01,0:09:10.02,Default,,0000,0000,0000,,Әлі де өте өршіл
Dialogue: 0,0:09:04.01,0:09:10.02,Default,,0000,0000,0000,,Мен қызықты Ұлы Жын әлемін таңдадым.
Dialogue: 0,0:09:10.02,0:09:13.02,Default,,0000,0000,0000,,Проблемалық
Dialogue: 0,0:09:10.02,0:09:13.02,Default,,0000,0000,0000,,Бұл тек бауырлар емес.
Dialogue: 0,0:09:13.02,0:09:15.99,Default,,0000,0000,0000,,Сіз солай айтса да...
Dialogue: 0,0:09:28.03,0:09:31.97,Default,,0000,0000,0000,,Айқай~ Жындар әлемі
Dialogue: 0,0:09:28.03,0:09:31.97,Default,,0000,0000,0000,,Түнде де аздап жарық.
Dialogue: 0,0:09:31.97,0:09:36.98,Default,,0000,0000,0000,,Үшінші жын әлемі
Dialogue: 0,0:09:31.97,0:09:36.98,Default,,0000,0000,0000,,Өйткені екі күн бар. ➡
Dialogue: 0,0:09:36.98,0:09:39.98,Default,,0000,0000,0000,,Глорио: Кезектесіп отырайық па?
Dialogue: 0,0:09:39.98,0:09:42.98,Default,,0000,0000,0000,,Жоқ. Менің ойымша, үзіліс жасайтын уақыт келді.
Dialogue: 0,0:09:42.98,0:09:45.99,Default,,0000,0000,0000,,Тамақтану және ұйықтау
Dialogue: 0,0:09:42.98,0:09:45.99,Default,,0000,0000,0000,,Оны дұрыс қабылдаған дұрыс.
Dialogue: 0,0:09:45.99,0:09:47.99,Default,,0000,0000,0000,,Бұл жерде қонақүйлер жоқ.
Dialogue: 0,0:09:47.99,0:09:50.99,Default,,0000,0000,0000,,Үңгір тауып, лагерьге шық.
Dialogue: 0,0:09:50.99,0:09:53.99,Default,,0000,0000,0000,,А... душ жоқ па?
Dialogue: 0,0:09:53.99,0:09:58.00,Default,,0000,0000,0000,,Аа, кемпинг жабдықтары
Dialogue: 0,0:09:53.99,0:09:58.00,Default,,0000,0000,0000,,Мен оны тұрған жерімде қалдырдым!
Dialogue: 0,0:09:58.00,0:10:03.00,Default,,0000,0000,0000,,Тек душты ұстаңыз.
Dialogue: 0,0:09:58.00,0:10:03.00,Default,,0000,0000,0000,,Әрқашан солай болған.
Dialogue: 0,0:10:03.00,0:10:05.97,Default,,0000,0000,0000,,Сондықтан Гоку таза емес.
Dialogue: 0,0:10:15.01,0:10:17.02,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:10:17.02,0:10:20.99,Default,,0000,0000,0000,,Мм! Бұл өте жақсы.
Dialogue: 0,0:10:23.02,0:10:26.03,Default,,0000,0000,0000,,Уф…. ➡
Dialogue: 0,0:10:26.03,0:10:30.00,Default,,0000,0000,0000,,Бұл қандай ет?
Dialogue: 0,0:10:26.03,0:10:30.00,Default,,0000,0000,0000,,Сұрамаған дұрыс сияқты.
Dialogue: 0,0:10:32.97,0:10:38.97,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:10:38.97,0:10:41.97,Default,,0000,0000,0000,,Айтпақшы, Глорио бұл➡
Dialogue: 0,0:10:41.97,0:10:44.98,Default,,0000,0000,0000,,Ол жаңа ғана бірінші жын әлемінен келді.
Dialogue: 0,0:10:41.97,0:10:44.98,Default,,0000,0000,0000,,Мен айттым ғой. ➡
Dialogue: 0,0:10:44.98,0:10:47.98,Default,,0000,0000,0000,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,0:10:44.98,0:10:47.98,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:10:47.98,0:10:50.98,Default,,0000,0000,0000,,Қалай қарасаң да
Dialogue: 0,0:10:47.98,0:10:50.98,Default,,0000,0000,0000,,Бұл үшінші жын әлеміне ұқсайды.
Dialogue: 0,0:10:50.98,0:10:54.99,Default,,0000,0000,0000,,Ұлы адам жалдаған
Dialogue: 0,0:10:50.98,0:10:54.99,Default,,0000,0000,0000,,Мен қазір бірінші жын әлемінде өмір сүріп жатырмын.
Dialogue: 0,0:10:54.99,0:10:57.99,Default,,0000,0000,0000,,Сіз соншалықты бақытты емессіз бе?
Dialogue: 0,0:10:57.99,0:10:59.99,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:10:59.99,0:11:01.99,Default,,0000,0000,0000,,Ұлы адамдар кімдер?
Dialogue: 0,0:11:01.99,0:11:04.00,Default,,0000,0000,0000,,Мұны кез келген адам жасай алады.
Dialogue: 0,0:11:04.00,0:11:07.00,Default,,0000,0000,0000,,Бірақ қызық емес пе?
Dialogue: 0,0:11:04.00,0:11:07.00,Default,,0000,0000,0000,,Өйткені, сен сондай қара жүрексің. ➡
Dialogue: 0,0:11:07.00,0:11:10.00,Default,,0000,0000,0000,,Салқын болса да.
Dialogue: 0,0:11:10.00,0:11:13.01,Default,,0000,0000,0000,,Неге?
Dialogue: 0,0:11:10.00,0:11:13.01,Default,,0000,0000,0000,,Король Гомерді жеңуге тырысасыз ба?
Dialogue: 0,0:11:13.01,0:11:16.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:16.01,0:11:21.01,Default,,0000,0000,0000,,Әрине, жындарды азаптаңыз.
Dialogue: 0,0:11:16.01,0:11:21.01,Default,,0000,0000,0000,,Өйткені ол жаман адам.
Dialogue: 0,0:11:21.01,0:11:25.02,Default,,0000,0000,0000,,Сізде әділеттілік сезімі күшті.
Dialogue: 0,0:11:21.01,0:11:25.02,Default,,0000,0000,0000,,Жын үшін.
Dialogue: 0,0:11:25.02,0:11:29.02,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:11:29.02,0:11:32.99,Default,,0000,0000,0000,,Қазір ұйықтайық. Ертең де ерте.
Dialogue: 0,0:11:34.96,0:11:39.97,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:11:39.97,0:11:43.97,Default,,0000,0000,0000,,
Dialogue: 0,0:11:43.97,0:11:48.97,Default,,0000,0000,0000,,Иә. Бұл жұмыс істейтін сияқты.
Dialogue: 0,0:11:43.97,0:11:48.97,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:11:48.97,0:11:51.98,Default,,0000,0000,0000,,🔊Келесі күні.
Dialogue: 0,0:11:48.97,0:11:51.98,Default,,0000,0000,0000,,Ухуху...
Dialogue: 0,0:11:51.98,0:11:55.98,Default,,0000,0000,0000,,Іс жақсы жүріп жатқан сияқты.
Dialogue: 0,0:11:51.98,0:11:55.98,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:11:55.98,0:11:57.98,Default,,0000,0000,0000,,🔊
Dialogue: 0,0:11:55.98,0:11:57.98,Default,,0000,0000,0000,,Егер бірдеңе болса, маған қайта хабарласыңыз.
Dialogue: 0,0:11:57.98,0:12:00.99,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:12:00.99,0:12:02.99,Default,,0000,0000,0000,,🔊 (кесу дыбысы)
Dialogue: 0,0:12:02.99,0:12:04.96,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:12:17.00,0:12:20.01,Default,,0000,0000,0000,,(шу)
Dialogue: 0,0:12:20.01,0:12:22.01,Default,,0000,0000,0000,,(шу)
Dialogue: 0,0:12:22.01,0:12:24.01,Default,,0000,0000,0000,,Бұл қандай дыбыс?
Dialogue: 0,0:12:24.01,0:12:26.01,Default,,0000,0000,0000,,(иіскеу дыбысы)
Dialogue: 0,0:12:24.01,0:12:26.01,Default,,0000,0000,0000,,Және➡
Dialogue: 0,0:12:26.01,0:12:29.01,Default,,0000,0000,0000,,Бір нәрсенің иісі бар. Ах.
Dialogue: 0,0:12:29.01,0:12:32.95,Default,,0000,0000,0000,,
Dialogue: 0,0:12:32.95,0:12:34.95,Default,,0000,0000,0000,,(иіскеу дыбысы)
Dialogue: 0,0:12:34.95,0:12:37.96,Default,,0000,0000,0000,,Бұл Гоку-сан емес.
Dialogue: 0,0:12:37.96,0:12:41.96,Default,,0000,0000,0000,,Хмф! Хмф! Хмф! Хмф!
Dialogue: 0,0:12:41.96,0:12:43.96,Default,,0000,0000,0000,,Бұл үңгірдің тереңінен. ➡
Dialogue: 0,0:12:43.96,0:12:45.97,Default,,0000,0000,0000,,Ей, балалар, ояныңдар!
Dialogue: 0,0:12:45.97,0:12:47.97,Default,,0000,0000,0000,,Иә? кету?
Dialogue: 0,0:12:47.97,0:12:50.97,Default,,0000,0000,0000,,Гоку-сан!
Dialogue: 0,0:12:47.97,0:12:50.97,Default,,0000,0000,0000,,Гоку-сан, оян!
Dialogue: 0,0:12:50.97,0:12:52.94,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:12:54.97,0:12:56.94,Default,,0000,0000,0000,,Онда не бар?
Dialogue: 0,0:12:59.98,0:13:01.98,Default,,0000,0000,0000,,Не! ? Не! ?
Dialogue: 0,0:13:01.98,0:13:04.98,Default,,0000,0000,0000,,Сасық!
Dialogue: 0,0:13:04.98,0:13:07.95,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:13:28.97,0:13:30.91,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:13:28.97,0:13:30.91,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:13:30.91,0:13:34.91,Default,,0000,0000,0000,,Жақсы...
Dialogue: 0,0:13:30.91,0:13:34.91,Default,,0000,0000,0000,,Аңға аңға шыққыңыз келсе➡
Dialogue: 0,0:13:34.91,0:13:37.88,Default,,0000,0000,0000,,Ол олжа жағынан келді.
Dialogue: 0,0:13:39.92,0:13:41.92,Default,,0000,0000,0000,,Hmph….
Dialogue: 0,0:13:41.92,0:13:44.92,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:44.92,0:13:47.93,Default,,0000,0000,0000,,Не, сиыр? Мені қорқытпа.
Dialogue: 0,0:13:47.93,0:13:51.93,Default,,0000,0000,0000,,Сиыр емес!
Dialogue: 0,0:13:47.93,0:13:51.93,Default,,0000,0000,0000,,Екі аяқпен жүру және сөйлесу➡
Dialogue: 0,0:13:51.93,0:13:55.94,Default,,0000,0000,0000,,Оның үстіне, осы сияқты
Dialogue: 0,0:13:51.93,0:13:55.94,Default,,0000,0000,0000,,Міне, ақымақ үлкен сиыр бар!
Dialogue: 0,0:13:55.94,0:13:57.94,Default,,0000,0000,0000,,Бұл Минотавр!
Dialogue: 0,0:13:57.94,0:13:59.94,Default,,0000,0000,0000,,Қандай тамаша есім.
Dialogue: 0,0:13:59.94,0:14:02.94,Default,,0000,0000,0000,,Иә? Жақсы... жақсы.
Dialogue: 0,0:14:02.94,0:14:04.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:04.94,0:14:06.95,Default,,0000,0000,0000,,Бұл маңызды емес!
Dialogue: 0,0:14:06.95,0:14:09.95,Default,,0000,0000,0000,,Балалар менің таңғы асым боласыңдар.
Dialogue: 0,0:14:09.95,0:14:12.95,Default,,0000,0000,0000,,Ей, сен сиыр болсаң да, ет жейсің бе?
Dialogue: 0,0:14:12.95,0:14:14.95,Default,,0000,0000,0000,,Сіз бұл сиыр емес деп отырсыз!
Dialogue: 0,0:14:14.95,0:14:18.96,Default,,0000,0000,0000,,Бізге шабуыл жасаңыз
Dialogue: 0,0:14:14.95,0:14:18.96,Default,,0000,0000,0000,,Сіз оны жеуді жоспарлап отырсыз ба?
Dialogue: 0,0:14:18.96,0:14:21.96,Default,,0000,0000,0000,,Міне. Хехе….
Dialogue: 0,0:14:21.96,0:14:24.93,Default,,0000,0000,0000,,Мен оны тазалаймын.
Dialogue: 0,0:14:21.96,0:14:24.93,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:14:26.97,0:14:28.97,Default,,0000,0000,0000,,Шық.
Dialogue: 0,0:14:28.97,0:14:30.90,Default,,0000,0000,0000,,Жотароның Стар Платинумы шынымен де тамаша көру қабілетіне ие болуы мүмкін.
Dialogue: 0,0:14:30.90,0:14:34.91,Default,,0000,0000,0000,,Мен мұны істеймін.
Dialogue: 0,0:14:30.90,0:14:34.91,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:34.91,0:14:36.88,Default,,0000,0000,0000,,Грилло бар
Dialogue: 0,0:14:34.91,0:14:36.88,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:14:38.91,0:14:40.91,Default,,0000,0000,0000,,Бұл Глорио.
Dialogue: 0,0:14:40.91,0:14:42.92,Default,,0000,0000,0000,,Бастық болмаңыз.
Dialogue: 0,0:14:42.92,0:14:45.92,Default,,0000,0000,0000,,Сен және мен
Dialogue: 0,0:14:42.92,0:14:45.92,Default,,0000,0000,0000,,Күште мұндай айырмашылық бар ма?
Dialogue: 0,0:14:45.92,0:14:48.92,Default,,0000,0000,0000,,Жарайды, мен бұлай айтпауым керек еді.
Dialogue: 0,0:14:48.92,0:14:51.89,Default,,0000,0000,0000,,Қызықты. Сіз оны қолданып көргіңіз келе ме?
Dialogue: 0,0:14:58.60,0:15:00.60,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:00.60,0:15:03.94,Default,,0000,0000,0000,,Тоқта.
Dialogue: 0,0:15:00.60,0:15:03.94,Default,,0000,0000,0000,,Қаншалықты керемет екенін білмеймін➡
Dialogue: 0,0:15:03.94,0:15:06.94,Default,,0000,0000,0000,,Ол қазір бала.
Dialogue: 0,0:15:03.94,0:15:06.94,Default,,0000,0000,0000,,Менің ойымша, бұл жақсы жекпе-жек.
Dialogue: 0,0:15:06.94,0:15:10.94,Default,,0000,0000,0000,,Жарайды, ал сен ше?
Dialogue: 0,0:15:06.94,0:15:10.94,Default,,0000,0000,0000,,Мен мұны бір қолмен жасаймын.
Dialogue: 0,0:15:10.94,0:15:12.95,Default,,0000,0000,0000,,Сіз алданып қалдыңыз.
Dialogue: 0,0:15:12.95,0:15:16.95,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:15:12.95,0:15:16.95,Default,,0000,0000,0000,,Сен ақымақ емессің бе?
Dialogue: 0,0:15:16.95,0:15:19.92,Default,,0000,0000,0000,,Эй, мен сені елемеймін бе?
Dialogue: 0,0:15:29.96,0:15:31.96,Default,,0000,0000,0000,,Міне, басталды!
Dialogue: 0,0:15:31.96,0:15:33.93,Default,,0000,0000,0000,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:15:44.31,0:15:45.98,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:15:45.98,0:15:47.98,Default,,0000,0000,0000,,Біз бұған шындап қараймыз!
Dialogue: 0,0:15:47.98,0:15:49.98,Default,,0000,0000,0000,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:15:47.98,0:15:49.98,Default,,0000,0000,0000,,Бұл ондай емес.
Dialogue: 0,0:15:49.98,0:15:51.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:55.99,0:15:58.96,Default,,0000,0000,0000,,Сіз мен ойлағаннан да жақсы жұмыс жасайсыз.
Dialogue: 0,0:16:08.00,0:16:10.00,Default,,0000,0000,0000,,Не? сол.
Dialogue: 0,0:16:10.00,0:16:11.97,Default,,0000,0000,0000,,Бұл сиқыр.
Dialogue: 0,0:16:23.02,0:16:26.02,Default,,0000,0000,0000,,Қауіп...
Dialogue: 0,0:16:26.02,0:16:29.02,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:16:26.02,0:16:29.02,Default,,0000,0000,0000,,Бұл керемет, Глорио!
Dialogue: 0,0:16:29.02,0:16:31.96,Default,,0000,0000,0000,,А... Гоку-сан! ➡
Dialogue: 0,0:16:31.96,0:16:33.96,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,0:16:31.96,0:16:33.96,Default,,0000,0000,0000,,Байыптап көріңіз!
Dialogue: 0,0:16:33.96,0:16:35.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:35.96,0:16:37.96,Default,,0000,0000,0000,,Мен оны көргім келеді! ➡
Dialogue: 0,0:16:37.96,0:16:40.93,Default,,0000,0000,0000,,Глорионың күші
Dialogue: 0,0:16:37.96,0:16:40.93,Default,,0000,0000,0000,,Қандай керемет!
Dialogue: 0,0:16:47.97,0:16:49.94,Default,,0000,0000,0000,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:16:58.98,0:17:00.95,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:17:04.99,0:17:06.96,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:17:08.99,0:17:10.96,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:17:14.00,0:17:17.00,Default,,0000,0000,0000,,Аһ...!
Dialogue: 0,0:17:17.00,0:17:19.97,Default,,0000,0000,0000,,Хааааа!
Dialogue: 0,0:17:23.01,0:17:25.01,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:17:25.01,0:17:26.98,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:17:34.95,0:17:36.92,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:17:38.96,0:17:40.93,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:42.96,0:17:46.93,Default,,0000,0000,0000,,Мен мұндай сиқырды ешқашан көрген емеспін!
Dialogue: 0,0:17:48.97,0:17:51.94,Default,,0000,0000,0000,,бітуге жақын.
Dialogue: 0,0:17:57.98,0:18:00.95,Default,,0000,0000,0000,,Қызықты
Dialogue: 0,0:17:57.98,0:18:00.95,Default,,0000,0000,0000,,Мм... Қызық.
Dialogue: 0,0:18:03.98,0:18:05.95,Default,,0000,0000,0000,,Бұл жұмыс істейтін сияқты.
Dialogue: 0,0:18:14.99,0:18:25.00,Default,,0000,0000,0000,,Ахх...!
Dialogue: 0,0:18:25.00,0:18:30.01,Default,,0000,0000,0000,,Ахххх...!
Dialogue: 0,0:18:30.01,0:18:34.61,Default,,0000,0000,0000,,Хааааааааааааааааааааааааааааааааа!
Dialogue: 0,0:18:34.61,0:18:36.62,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,0:18:36.62,0:18:38.58,Default,,0000,0000,0000,,Бұл не! ?
Dialogue: 0,0:18:36.62,0:18:38.58,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:18:42.96,0:18:44.92,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:18:51.96,0:18:53.97,Default,,0000,0000,0000,,Қарғыс атсын... ➡
Dialogue: 0,0:18:53.97,0:18:58.94,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:19:07.98,0:19:09.95,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:27.00,0:19:28.97,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:19:30.94,0:19:32.91,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:34.94,0:19:36.91,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:19:45.95,0:19:47.92,Default,,0000,0000,0000,,Бұл ұрыс болды.
Dialogue: 0,0:19:50.96,0:19:52.96,Default,,0000,0000,0000,,Түсіндім... ➡
Dialogue: 0,0:19:52.96,0:19:55.93,Default,,0000,0000,0000,,Беру.
Dialogue: 0,0:19:52.96,0:19:55.93,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:20:00.97,0:20:03.97,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:20:03.97,0:20:05.97,Default,,0000,0000,0000,,Бұл не? Қазір не болды?
Dialogue: 0,0:20:05.97,0:20:07.97,Default,,0000,0000,0000,,Ол супер Сайян.
Dialogue: 0,0:20:07.97,0:20:09.98,Default,,0000,0000,0000,,Бала кезде де
Dialogue: 0,0:20:07.97,0:20:09.98,Default,,0000,0000,0000,,Мен мұны істегеніме қуаныштымын.
Dialogue: 0,0:20:09.98,0:20:11.98,Default,,0000,0000,0000,,Басқа әдістер бар ма?
Dialogue: 0,0:20:11.98,0:20:15.98,Default,,0000,0000,0000,,Көп нәрсе.
Dialogue: 0,0:20:11.98,0:20:15.98,Default,,0000,0000,0000,,Күтілгендей.
Dialogue: 0,0:20:15.98,0:20:18.98,Default,,0000,0000,0000,,Гоку да
Dialogue: 0,0:20:15.98,0:20:18.98,Default,,0000,0000,0000,,Сіз осындай таңғажайып сиқырды пайдалана аласыз!
Dialogue: 0,0:20:18.98,0:20:21.99,Default,,0000,0000,0000,,(Кайошин)
Dialogue: 0,0:20:18.98,0:20:21.99,Default,,0000,0000,0000,,Бұл сиқыр емес, бірақ...
Dialogue: 0,0:20:21.99,0:20:23.99,Default,,0000,0000,0000,,Күткеніңізге рахмет!
Dialogue: 0,0:20:21.99,0:20:23.99,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:20:23.99,0:20:25.99,Default,,0000,0000,0000,,Кәне, жасайық!
Dialogue: 0,0:20:25.99,0:20:29.96,Default,,0000,0000,0000,,Бірақ… бірақ… ggggggg….
Dialogue: 0,0:20:31.93,0:20:34.93,Default,,0000,0000,0000,,А... А, дұрыс!
Dialogue: 0,0:20:34.93,0:20:36.94,Default,,0000,0000,0000,,Осыншама жегің келсе➡
Dialogue: 0,0:20:36.94,0:20:39.94,Default,,0000,0000,0000,,Барлығы бірге
Dialogue: 0,0:20:36.94,0:20:39.94,Default,,0000,0000,0000,,Таңғы асқа ішейін бе?
Dialogue: 0,0:20:39.94,0:20:43.94,Default,,0000,0000,0000,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:20:39.94,0:20:43.94,Default,,0000,0000,0000,,Мен ұмытып қалдым. Мен мүлдем ұмытып кеттім!
Dialogue: 0,0:20:43.94,0:20:46.95,Default,,0000,0000,0000,,Ұйықтар алдында
Dialogue: 0,0:20:43.94,0:20:46.95,Default,,0000,0000,0000,,Үлкен құбыжықты жеңіңіз➡
Dialogue: 0,0:20:46.95,0:20:48.95,Default,,0000,0000,0000,,Мен көп треска жедім!
Dialogue: 0,0:20:48.95,0:20:50.95,Default,,0000,0000,0000,,Егер сіз бұл туралы ойласаңыз
Dialogue: 0,0:20:48.95,0:20:50.95,Default,,0000,0000,0000,,Толық болдым.
Dialogue: 0,0:20:50.95,0:20:53.95,Default,,0000,0000,0000,,Балалар, сендер өмірді құтқардыңдар!
Dialogue: 0,0:20:53.95,0:20:56.96,Default,,0000,0000,0000,,(Минотаврдың дірілдеген іші)
Dialogue: 0,0:20:56.96,0:21:00.96,Default,,0000,0000,0000,,Қазір... қазір
Dialogue: 0,0:20:56.96,0:21:00.96,Default,,0000,0000,0000,,Мүмкін мен қайтадан ұйықтауым керек шығар!
Dialogue: 0,0:21:00.96,0:21:04.96,Default,,0000,0000,0000,,Хахахаха... хахахаха....
Dialogue: 0,0:21:04.96,0:21:09.97,Default,,0000,0000,0000,,Енді біз де кетеміз бе?
Dialogue: 0,0:21:04.96,0:21:09.97,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:21:09.97,0:21:11.97,Default,,0000,0000,0000,,Оған дейін, дәретхананың әжетханасы!
Dialogue: 0,0:21:11.97,0:21:15.97,Default,,0000,0000,0000,,А, Панджи, сенде қағаз бар ма?
Dialogue: 0,0:21:15.97,0:21:17.98,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:21:15.97,0:21:17.98,Default,,0000,0000,0000,,(жарылған дыбыс)
Dialogue: 0,0:21:17.98,0:21:19.95,Default,,0000,0000,0000,,Гуе~!
Dialogue: 0,0:21:21.98,0:21:25.95,Default,,0000,0000,0000,,А... Аа...
Dialogue: 0,0:21:30.92,0:21:32.92,Default,,0000,0000,0000,,Бұл қандай сезімде?
Dialogue: 0,0:21:32.92,0:21:36.93,Default,,0000,0000,0000,,Жақында аяқталуы керек.
Dialogue: 0,0:21:32.92,0:21:36.93,Default,,0000,0000,0000,,Мүмкін.
Dialogue: 0,0:21:36.93,0:21:38.93,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:21:38.93,0:21:43.94,Default,,0000,0000,0000,,Хмф... Сайяндар
Dialogue: 0,0:21:38.93,0:21:43.94,Default,,0000,0000,0000,,Мен бір орында тұра алмайтын сияқтымын.
Dialogue: 0,0:21:43.94,0:21:46.94,Default,,0000,0000,0000,,Жарайды, бұл тамаша!
Dialogue: 0,0:21:46.94,0:21:49.91,Default,,0000,0000,0000,,Кету уақыты келді. Дайын бол!
Dialogue: 0,0:21:51.94,0:21:54.95,Default,,0000,0000,0000,,Мен сені Ұлы Жындар әлеміне апарамын.
Dialogue: 0,0:21:54.95,0:21:57.95,Default,,0000,0000,0000,,Дэку-чан…
Dialogue: 0,0:21:54.95,0:21:57.95,Default,,0000,0000,0000,,Кайошиндердің соңынан қуайық.
Dialogue: 0,0:21:57.95,0:22:00.92,Default,,0000,0000,0000,,(Ғарыш кемесінің іске қосылу дыбысы)
Dialogue: 0,0:22:06.96,0:22:08.93,Default,,0000,0000,0000,,Бұл тар.
Dialogue: 0,0:22:21.97,0:22:23.94,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:22:26.98,0:22:28.98,Default,,0000,0000,0000,,(ескерту дыбысы)
Dialogue: 0,0:22:28.98,0:22:31.92,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:22:28.98,0:22:31.92,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:22:31.92,0:22:33.92,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:22:33.92,0:22:36.89,Default,,0000,0000,0000,,(ескерту дыбысы)
Dialogue: 0,0:22:39.93,0:22:41.89,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:45.93,0:22:47.90,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:22:49.94,0:22:59.91,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:01.41,0:23:07.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory