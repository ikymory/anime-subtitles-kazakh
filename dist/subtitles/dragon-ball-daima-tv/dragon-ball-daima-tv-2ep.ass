Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:05.04,Default,,0000,0000,0000,,Уау... Уау!
Dialogue: 0,0:00:02.04,0:00:05.04,Default,,0000,0000,0000,,Хах.
Dialogue: 0,0:00:05.04,0:00:09.04,Default,,0000,0000,0000,,Жарайды. Тілегім орындалды.
Dialogue: 0,0:00:09.04,0:00:12.05,Default,,0000,0000,0000,,Қоштасу.
Dialogue: 0,0:00:09.04,0:00:12.05,Default,,0000,0000,0000,,Ех! ? ➡
Dialogue: 0,0:00:12.05,0:00:15.05,Default,,0000,0000,0000,,Орындауға болатын тілек
Dialogue: 0,0:00:12.05,0:00:15.05,Default,,0000,0000,0000,,Үш емес пе? ?
Dialogue: 0,0:00:15.05,0:00:19.05,Default,,0000,0000,0000,,Бұл тек тұрақты адамдарға арналған қызмет.
Dialogue: 0,0:00:19.05,0:00:23.06,Default,,0000,0000,0000,,Бірінші ештеңе білмейтін адам
Dialogue: 0,0:00:19.05,0:00:23.06,Default,,0000,0000,0000,,Бір ғана.
Dialogue: 0,0:00:23.06,0:00:25.06,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:00:25.06,0:00:27.03,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:25.06,0:00:27.03,Default,,0000,0000,0000,,Сонымен.
Dialogue: 0,0:00:29.06,0:00:32.03,Default,,0000,0000,0000,,Жоқ, яғни, ол қайда…
Dialogue: 0,0:00:41.07,0:00:43.08,Default,,0000,0000,0000,,Жарқырап барады.
Dialogue: 0,0:00:43.08,0:00:46.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:00:43.08,0:00:46.08,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:00:43.08,0:00:46.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:00:46.08,0:00:49.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:00:49.08,0:00:52.09,Default,,0000,0000,0000,,Райнер, кейін кездескенше.
Dialogue: 0,0:00:49.08,0:00:52.09,Default,,0000,0000,0000,,Ауырды...
Dialogue: 0,0:00:49.08,0:00:52.09,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:00:52.09,0:00:56.09,Default,,0000,0000,0000,,Уау~ бұл ауырады~!
Dialogue: 0,0:00:56.09,0:00:59.09,Default,,0000,0000,0000,,Не... бұл не?
Dialogue: 0,0:00:56.09,0:00:59.09,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:00:59.09,0:01:02.03,Default,,0000,0000,0000,,Балалар сендер кішірейіп барасыңдар!
Dialogue: 0,0:01:02.03,0:01:05.03,Default,,0000,0000,0000,,Иә? Сіз не айттыңыз?
Dialogue: 0,0:01:05.03,0:01:07.03,Default,,0000,0000,0000,,Не? О?
Dialogue: 0,0:01:07.03,0:01:09.04,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:01:07.03,0:01:09.04,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:01:09.04,0:01:13.01,Default,,0000,0000,0000,,Не... Бұл не! Алақай! ?
Dialogue: 0,0:01:15.04,0:01:18.04,Default,,0000,0000,0000,,Кайошин
Dialogue: 0,0:01:15.04,0:01:18.04,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:01:18.04,0:01:20.05,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:01:20.05,0:01:23.05,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:01:23.05,0:01:33.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:05.02,0:03:07.02,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:03:05.02,0:03:07.02,Default,,0000,0000,0000,,Бұлай болса ше➡
Dialogue: 0,0:03:07.02,0:03:12.03,Default,,0000,0000,0000,,Ібілістің үшінші көзі
Dialogue: 0,0:03:07.02,0:03:12.03,Default,,0000,0000,0000,,Бірінші тілегіңді орында!
Dialogue: 0,0:03:12.03,0:03:15.03,Default,,0000,0000,0000,,Сәлем Нева!
Dialogue: 0,0:03:12.03,0:03:15.03,Default,,0000,0000,0000,,Ұлы жын әлемінің айдаһар шары ➡
Dialogue: 0,0:03:15.03,0:03:17.03,Default,,0000,0000,0000,,Сіз оларды осы жылдамдықпен жинай алмайсыз ба?
Dialogue: 0,0:03:17.03,0:03:23.04,Default,,0000,0000,0000,,Иә? Егер солай болса
Dialogue: 0,0:03:17.03,0:03:23.04,Default,,0000,0000,0000,,Тамагамимен жарысып, жеңіңіз.
Dialogue: 0,0:03:23.04,0:03:25.04,Default,,0000,0000,0000,,Тс!
Dialogue: 0,0:03:25.04,0:03:28.04,Default,,0000,0000,0000,,Содан кейін тағы да осында.
Dialogue: 0,0:03:25.04,0:03:28.04,Default,,0000,0000,0000,,Басынан бастау керек пе?
Dialogue: 0,0:03:28.04,0:03:31.98,Default,,0000,0000,0000,,Не болса да
Dialogue: 0,0:03:28.04,0:03:31.98,Default,,0000,0000,0000,,Оны кезекпен орындау мүмкін емес.
Dialogue: 0,0:03:31.98,0:03:35.98,Default,,0000,0000,0000,,Куку….
Dialogue: 0,0:03:31.98,0:03:35.98,Default,,0000,0000,0000,,Ал, әзірге➡
Dialogue: 0,0:03:35.98,0:03:37.98,Default,,0000,0000,0000,,Бұл жақсы емес пе? ➡
Dialogue: 0,0:03:37.98,0:03:40.99,Default,,0000,0000,0000,,Енді олар
Dialogue: 0,0:03:37.98,0:03:40.99,Default,,0000,0000,0000,,Мен күшсіз болдым.
Dialogue: 0,0:03:40.99,0:03:43.99,Default,,0000,0000,0000,,(Денде ұйқысы)
Dialogue: 0,0:03:43.99,0:03:47.99,Default,,0000,0000,0000,,Хе... Осы жігіт болмаса➡
Dialogue: 0,0:03:47.99,0:03:50.00,Default,,0000,0000,0000,,Айдаһар добы осында
Dialogue: 0,0:03:47.99,0:03:50.00,Default,,0000,0000,0000,,Оны енді пайдалану мүмкін емес. ➡
Dialogue: 0,0:03:50.00,0:03:53.00,Default,,0000,0000,0000,,Қайдасың?
Dialogue: 0,0:03:50.00,0:03:53.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:53.00,0:03:55.00,Default,,0000,0000,0000,,Уа...
Dialogue: 0,0:03:53.00,0:03:55.00,Default,,0000,0000,0000,,Айо.
Dialogue: 0,0:03:55.00,0:03:58.00,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:03:58.00,0:04:01.01,Default,,0000,0000,0000,,Әйтеуір, мына жігітті өзімізбен бірге ала кетейік.
Dialogue: 0,0:04:01.01,0:04:05.01,Default,,0000,0000,0000,,Төтенше жағдайда
Dialogue: 0,0:04:01.01,0:04:05.01,Default,,0000,0000,0000,,Оны барымта ретінде де қолдануға болады.
Dialogue: 0,0:04:05.01,0:04:08.01,Default,,0000,0000,0000,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:04:08.01,0:04:11.35,Default,,0000,0000,0000,,Ах! Аа… аа….
Dialogue: 0,0:04:11.35,0:04:13.35,Default,,0000,0000,0000,,Ах. ➡
Dialogue: 0,0:04:13.35,0:04:15.36,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:04:15.36,0:04:18.93,Default,,0000,0000,0000,,Ах! Уф, у, у...
Dialogue: 0,0:04:26.03,0:04:29.00,Default,,0000,0000,0000,,Сен… кімсің?
Dialogue: 0,0:04:26.03,0:04:29.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:31.97,0:04:36.98,Default,,0000,0000,0000,,Өтірік!
Dialogue: 0,0:04:31.97,0:04:36.98,Default,,0000,0000,0000,,Trunks енді сәби!
Dialogue: 0,0:04:36.98,0:04:38.98,Default,,0000,0000,0000,,Готен
Dialogue: 0,0:04:36.98,0:04:38.98,Default,,0000,0000,0000,,Готен де!
Dialogue: 0,0:04:38.98,0:04:40.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:40.98,0:04:42.98,Default,,0000,0000,0000,,...
Dialogue: 0,0:04:42.98,0:04:44.98,Default,,0000,0000,0000,,《Транкс-кун
Dialogue: 0,0:04:42.98,0:04:44.98,Default,,0000,0000,0000,,Бала өсіп келеді》
Dialogue: 0,0:04:44.98,0:04:47.99,Default,,0000,0000,0000,,《Тіпті сен де
Dialogue: 0,0:04:44.98,0:04:47.99,Default,,0000,0000,0000,,Сәбиге айналып жатыр》
Dialogue: 0,0:04:47.99,0:04:50.99,Default,,0000,0000,0000,,《Неге?
Dialogue: 0,0:04:47.99,0:04:50.99,Default,,0000,0000,0000,,Бұл болды ма? 》
Dialogue: 0,0:04:50.99,0:04:52.99,Default,,0000,0000,0000,,《Білмеймін》
Dialogue: 0,0:04:52.99,0:04:54.99,Default,,0000,0000,0000,,«Құрғап қалған болар ма?»
Dialogue: 0,0:04:54.99,0:04:59.00,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:04:59.00,0:05:02.00,Default,,0000,0000,0000,,Ах... хахаха...
Dialogue: 0,0:05:02.00,0:05:06.01,Default,,0000,0000,0000,,Барлық адамдар кішірейді ме?
Dialogue: 0,0:05:06.01,0:05:11.01,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:05:06.01,0:05:11.01,Default,,0000,0000,0000,,Барлық қызметкерлер өзгеріссіз қалады.
Dialogue: 0,0:05:11.01,0:05:14.01,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:05:14.01,0:05:17.02,Default,,0000,0000,0000,,Бұл Шайтан мырза.
Dialogue: 0,0:05:14.01,0:05:17.02,Default,,0000,0000,0000,,Буу~!
Dialogue: 0,0:05:17.02,0:05:21.02,Default,,0000,0000,0000,,Жоқ, мен өзімді жас сезінемін!
Dialogue: 0,0:05:21.02,0:05:25.99,Default,,0000,0000,0000,,Әй, теріңіз жылтыр емес пе?
Dialogue: 0,0:05:21.02,0:05:25.99,Default,,0000,0000,0000,,Өте тегіс!
Dialogue: 0,0:05:28.03,0:05:32.97,Default,,0000,0000,0000,,Әркім әртүрлі көрінсе де
Dialogue: 0,0:05:28.03,0:05:32.97,Default,,0000,0000,0000,,Мазмұны сол қалпында қала ма?
Dialogue: 0,0:05:32.97,0:05:37.97,Default,,0000,0000,0000,,Мен өзімді жасарғандай сезінемін.
Dialogue: 0,0:05:32.97,0:05:37.97,Default,,0000,0000,0000,,Чинчукуринге айналды деп ойлаймын...
Dialogue: 0,0:05:37.97,0:05:40.97,Default,,0000,0000,0000,,Маған айтқаныңды қаламаймын.
Dialogue: 0,0:05:40.97,0:05:43.98,Default,,0000,0000,0000,,Кішкентай болғаны жаман болды.
Dialogue: 0,0:05:43.98,0:05:48.98,Default,,0000,0000,0000,,Өтірік! Вегетаға дейін
Dialogue: 0,0:05:43.98,0:05:48.98,Default,,0000,0000,0000,,Сүйкімді болып кетті.
Dialogue: 0,0:05:48.98,0:05:50.98,Default,,0000,0000,0000,,Жер бетінде не болып жатыр?
Dialogue: 0,0:05:50.98,0:05:55.99,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:05:50.98,0:05:55.99,Default,,0000,0000,0000,,Шенронның пайда болуына байланысты шығар
Dialogue: 0,0:05:50.98,0:05:55.99,Default,,0000,0000,0000,,Қатысты нәрсе...
Dialogue: 0,0:05:55.99,0:05:57.99,Default,,0000,0000,0000,,Балалар Жарайды.
Dialogue: 0,0:05:57.99,0:06:00.99,Default,,0000,0000,0000,,Әлемнің ультра суперқаһармандары
Dialogue: 0,0:05:57.99,0:06:00.99,Default,,0000,0000,0000,,Шайтан мырза….
Dialogue: 0,0:06:00.99,0:06:03.00,Default,,0000,0000,0000,,Сәлем! ?
Dialogue: 0,0:06:03.00,0:06:06.00,Default,,0000,0000,0000,,Мен ғибадатханада жағымсыз сезімде болдым.
Dialogue: 0,0:06:06.00,0:06:08.00,Default,,0000,0000,0000,,Иә? Жарайды, мен барамын.
Dialogue: 0,0:06:08.00,0:06:10.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:10.00,0:06:11.97,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:06:10.00,0:06:11.97,Default,,0000,0000,0000,,Құнды заттың бәрін аламын!
Dialogue: 0,0:06:15.01,0:06:17.01,Default,,0000,0000,0000,,Ачачача...!
Dialogue: 0,0:06:17.01,0:06:19.01,Default,,0000,0000,0000,,Фуфуфуфуфуфуфу!
Dialogue: 0,0:06:19.01,0:06:21.01,Default,,0000,0000,0000,,Ол кенеттен кішірейіп кетті➡
Dialogue: 0,0:06:21.01,0:06:24.02,Default,,0000,0000,0000,,Әлі тепе-теңдікте
Dialogue: 0,0:06:21.01,0:06:24.02,Default,,0000,0000,0000,,Сіз оны дұрыс түсіне алмайсыз.
Dialogue: 0,0:06:24.02,0:06:27.02,Default,,0000,0000,0000,,Бұл кім? Сәлем.
Dialogue: 0,0:06:27.02,0:06:29.02,Default,,0000,0000,0000,,Мутенруши
Dialogue: 0,0:06:27.02,0:06:29.02,Default,,0000,0000,0000,,Бұл Бутен Роши.
Dialogue: 0,0:06:29.02,0:06:31.96,Default,,0000,0000,0000,,Камесеннин
Dialogue: 0,0:06:29.02,0:06:31.96,Default,,0000,0000,0000,,Ах! Мастер Роши шебері!
Dialogue: 0,0:06:31.96,0:06:34.96,Default,,0000,0000,0000,,Мен де керемет көрінемін➡
Dialogue: 0,0:06:34.96,0:06:36.96,Default,,0000,0000,0000,,Ата
Dialogue: 0,0:06:34.96,0:06:36.96,Default,,0000,0000,0000,,Жоқ. ➡
Dialogue: 0,0:06:36.96,0:06:39.97,Default,,0000,0000,0000,,Сәлем! Эй!
Dialogue: 0,0:06:39.97,0:06:43.97,Default,,0000,0000,0000,,Тіпті Мастер Роши Аникимен
Dialogue: 0,0:06:39.97,0:06:43.97,Default,,0000,0000,0000,,Маған қоңырау шалыңыз.
Dialogue: 0,0:06:43.97,0:06:45.97,Default,,0000,0000,0000,,Көп~.
Dialogue: 0,0:06:45.97,0:06:48.98,Default,,0000,0000,0000,,Кибито
Dialogue: 0,0:06:45.97,0:06:48.98,Default,,0000,0000,0000,,Ол сені ғибадатханаға апарады.
Dialogue: 0,0:06:48.98,0:06:51.98,Default,,0000,0000,0000,,Кәне, бірге жиналайық.
Dialogue: 0,0:06:51.98,0:06:53.95,Default,,0000,0000,0000,,Күтіңіз. Мен де барамын.
Dialogue: 0,0:07:01.99,0:07:03.99,Default,,0000,0000,0000,,Ах, Yahoo!
Dialogue: 0,0:07:03.99,0:07:06.99,Default,,0000,0000,0000,,Бұл Yahoo емес.
Dialogue: 0,0:07:06.99,0:07:10.00,Default,,0000,0000,0000,,Иә? Айтпақшы, Денде ше?
Dialogue: 0,0:07:10.00,0:07:13.00,Default,,0000,0000,0000,,Мені бейтаныс адамдар алып кетті.
Dialogue: 0,0:07:13.00,0:07:17.00,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:07:13.00,0:07:17.00,Default,,0000,0000,0000,,Біртүрлі жігіттер кімдер?
Dialogue: 0,0:07:17.00,0:07:22.01,Default,,0000,0000,0000,,Құлақтары сүйір
Dialogue: 0,0:07:17.00,0:07:22.01,Default,,0000,0000,0000,,Ұлы жын әлемінен келгенін айтты.
Dialogue: 0,0:07:22.01,0:07:24.01,Default,,0000,0000,0000,,Ұлы жын әлемі?
Dialogue: 0,0:07:24.01,0:07:27.98,Default,,0000,0000,0000,,А... Ұлы жын дүниесі ме?
Dialogue: 0,0:07:33.95,0:07:35.92,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:07:37.96,0:07:42.96,Default,,0000,0000,0000,,Бір адам
Dialogue: 0,0:07:37.96,0:07:42.96,Default,,0000,0000,0000,,Бұл Кай патшаға біраз ұқсады.
Dialogue: 0,0:07:42.96,0:07:44.96,Default,,0000,0000,0000,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,0:07:44.96,0:07:48.97,Default,,0000,0000,0000,,Ол Дегес деп аталды.
Dialogue: 0,0:07:44.96,0:07:48.97,Default,,0000,0000,0000,,Дегес….
Dialogue: 0,0:07:48.97,0:07:52.97,Default,,0000,0000,0000,,Бұл Дегес болды ма?
Dialogue: 0,0:07:48.97,0:07:52.97,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:07:52.97,0:07:55.98,Default,,0000,0000,0000,,Ол Кай патшаның інісі.
Dialogue: 0,0:07:55.98,0:08:00.98,Default,,0000,0000,0000,,Сіздің ініңіз болды ма? ?
Dialogue: 0,0:07:55.98,0:08:00.98,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:08:00.98,0:08:03.98,Default,,0000,0000,0000,,Кейінірек
Dialogue: 0,0:08:00.98,0:08:03.98,Default,,0000,0000,0000,,Кішкентай және бастық жігітпен➡
Dialogue: 0,0:08:03.98,0:08:06.99,Default,,0000,0000,0000,,Нева деп аталады
Dialogue: 0,0:08:03.98,0:08:06.99,Default,,0000,0000,0000,,Намекиан қарт.
Dialogue: 0,0:08:06.99,0:08:09.99,Default,,0000,0000,0000,,Бұл Нева! ?
Dialogue: 0,0:08:06.99,0:08:09.99,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:08:09.99,0:08:14.99,Default,,0000,0000,0000,,Баяғыда Ұлы жын әлемінің Айдаһар шарлары
Dialogue: 0,0:08:09.99,0:08:14.99,Default,,0000,0000,0000,,Қорғау үшін жалғыз қалдым➡
Dialogue: 0,0:08:14.99,0:08:19.00,Default,,0000,0000,0000,,Ол аты аңызға айналған Намекиан.
Dialogue: 0,0:08:19.00,0:08:21.00,Default,,0000,0000,0000,,Сол Намекян➡
Dialogue: 0,0:08:21.00,0:08:24.00,Default,,0000,0000,0000,,Жердің айдаһар шарлары
Dialogue: 0,0:08:21.00,0:08:24.00,Default,,0000,0000,0000,,Сіз мені манипуляцияладыңыз.
Dialogue: 0,0:08:24.00,0:08:28.01,Default,,0000,0000,0000,,Бұл жай болды, бірақ
Dialogue: 0,0:08:24.00,0:08:28.01,Default,,0000,0000,0000,,Техника керемет болды.
Dialogue: 0,0:08:28.01,0:08:31.01,Default,,0000,0000,0000,,Кішкентай және бастық➡
Dialogue: 0,0:08:31.01,0:08:34.01,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:08:31.01,0:08:34.01,Default,,0000,0000,0000,,Шенроннан сұраңыз
Dialogue: 0,0:08:31.01,0:08:34.01,Default,,0000,0000,0000,,Олар бізді бала етті.
Dialogue: 0,0:08:34.01,0:08:38.02,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:08:34.01,0:08:38.02,Default,,0000,0000,0000,,Олай болса дереу оның соңынан барайық.
Dialogue: 0,0:08:38.02,0:08:40.02,Default,,0000,0000,0000,,Мен Дендеге көмектесуім керек.
Dialogue: 0,0:08:40.02,0:08:44.02,Default,,0000,0000,0000,,Бұл мүмкін емес. Ұлы жын әлемінде
Dialogue: 0,0:08:40.02,0:08:44.02,Default,,0000,0000,0000,,...
Dialogue: 0,0:08:40.02,0:08:44.02,Default,,0000,0000,0000,,Телепортация мүмкін емес.
Dialogue: 0,0:08:44.02,0:08:46.99,Default,,0000,0000,0000,,Сонда не істеуіміз керек?
Dialogue: 0,0:08:49.03,0:08:53.03,Default,,0000,0000,0000,,Бұл жұмыс істеуі мүмкін.
Dialogue: 0,0:08:53.03,0:08:58.04,Default,,0000,0000,0000,,Кайошинкай
Dialogue: 0,0:08:53.03,0:08:58.04,Default,,0000,0000,0000,,Кибито Кайошин әлеміне оралу
Dialogue: 0,0:08:53.03,0:08:58.04,Default,,0000,0000,0000,,Маған ғарыш кемесін әкел.
Dialogue: 0,0:08:58.04,0:09:00.01,Default,,0000,0000,0000,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:09:06.05,0:09:09.05,Default,,0000,0000,0000,,(ғарыш кемесін орналастыру дыбысы)
Dialogue: 0,0:09:06.05,0:09:09.05,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:09:09.05,0:09:12.05,Default,,0000,0000,0000,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:09:12.05,0:09:16.06,Default,,0000,0000,0000,,Бұл ғаламда баяғыда
Dialogue: 0,0:09:12.05,0:09:16.06,Default,,0000,0000,0000,,Мынау келген кездегі ғарыш кемесі.
Dialogue: 0,0:09:16.06,0:09:19.06,Default,,0000,0000,0000,,(Батырма басылған дыбысы)
Dialogue: 0,0:09:19.06,0:09:21.03,Default,,0000,0000,0000,,Ол әлі де жұмыс істей ме...
Dialogue: 0,0:09:29.07,0:09:31.00,Default,,0000,0000,0000,,Жақсы емес пе? ➡
Dialogue: 0,0:09:31.00,0:09:34.01,Default,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:09:34.01,0:09:37.01,Default,,0000,0000,0000,,Мен оны ұзақ уақыт жалғыз қалдырдым.
Dialogue: 0,0:09:37.01,0:09:40.01,Default,,0000,0000,0000,,Өзің бар
Dialogue: 0,0:09:37.01,0:09:40.01,Default,,0000,0000,0000,,Жай ғана Булмадан оны жөндеп беруін сұраңыз.
Dialogue: 0,0:09:40.01,0:09:43.02,Default,,0000,0000,0000,,Өйткені ол данышпан.
Dialogue: 0,0:09:43.02,0:09:45.02,Default,,0000,0000,0000,,Ола сені сонда әкеледі.
Dialogue: 0,0:09:45.02,0:09:49.02,Default,,0000,0000,0000,,Уау... Уау!
Dialogue: 0,0:09:49.02,0:09:51.99,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:09:54.03,0:09:58.03,Default,,0000,0000,0000,,О, бұл қауіпті!
Dialogue: 0,0:09:58.03,0:10:02.03,Default,,0000,0000,0000,,Не болды, Ниа?
Dialogue: 0,0:09:58.03,0:10:02.03,Default,,0000,0000,0000,,Кішкентай денеңіздің тепе-теңдігін сақтауға дағдыланыңыз.
Dialogue: 0,0:10:02.03,0:10:06.04,Default,,0000,0000,0000,,Сіз әлі үйреніп қалдыңыз ба?
Dialogue: 0,0:10:02.03,0:10:06.04,Default,,0000,0000,0000,,Хмф! ➡
Dialogue: 0,0:10:06.04,0:10:10.04,Default,,0000,0000,0000,,Ах... уф... ➡
Dialogue: 0,0:10:10.04,0:10:14.05,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:10:10.04,0:10:14.05,Default,,0000,0000,0000,,Сен де солайсың, солай емес пе?
Dialogue: 0,0:10:14.05,0:10:16.02,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:10:30.00,0:10:31.93,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:10:30.00,0:10:31.93,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:10:31.93,0:10:33.93,Default,,0000,0000,0000,,Мен сені алып келдім.
Dialogue: 0,0:10:33.93,0:10:38.94,Default,,0000,0000,0000,,Вегета! Сен де келдің бе?
Dialogue: 0,0:10:33.93,0:10:38.94,Default,,0000,0000,0000,,Әрине.
Dialogue: 0,0:10:38.94,0:10:41.94,Default,,0000,0000,0000,,Осындай жынсыз етіп жасалған
Dialogue: 0,0:10:38.94,0:10:41.94,Default,,0000,0000,0000,,Мені жалғыз қалдырмаңыз!
Dialogue: 0,0:10:41.94,0:10:43.94,Default,,0000,0000,0000,,Балалар сандықтары туралы не деуге болады?
Dialogue: 0,0:10:43.94,0:10:47.95,Default,,0000,0000,0000,,Себебі мен сені күтуіңді сұрадым.
Dialogue: 0,0:10:43.94,0:10:47.95,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:10:47.95,0:10:49.95,Default,,0000,0000,0000,,Мен ертегіні естідім.
Dialogue: 0,0:10:49.95,0:10:52.95,Default,,0000,0000,0000,,Бұл ғарыш кемесі.
Dialogue: 0,0:10:52.95,0:10:56.96,Default,,0000,0000,0000,,Не? бұл.
Dialogue: 0,0:10:52.95,0:10:56.96,Default,,0000,0000,0000,,Әрең сынды. ➡
Dialogue: 0,0:10:56.96,0:10:59.96,Default,,0000,0000,0000,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:10:56.96,0:10:59.96,Default,,0000,0000,0000,,Соңғы кездері сіз әр жерде бір нәрсеге тап болған сияқтысыз.
Dialogue: 0,0:10:59.96,0:11:01.96,Default,,0000,0000,0000,,Гоку және Вегета➡
Dialogue: 0,0:11:01.96,0:11:04.96,Default,,0000,0000,0000,,Кайошин әлемінде
Dialogue: 0,0:11:01.96,0:11:04.96,Default,,0000,0000,0000,,Сиқыр
Dialogue: 0,0:11:01.96,0:11:04.96,Default,,0000,0000,0000,,Маджин Буумен соғысқанда.
Dialogue: 0,0:11:04.96,0:11:11.97,Default,,0000,0000,0000,,Бұл ғарыш кемесі...
Dialogue: 0,0:11:04.96,0:11:11.97,Default,,0000,0000,0000,,Дегенмен, бұл біртүрлі құрылым.
Dialogue: 0,0:11:11.97,0:11:15.98,Default,,0000,0000,0000,,Кәдімгі ғарыш кемесінде
Dialogue: 0,0:11:11.97,0:11:15.98,Default,,0000,0000,0000,,Сіз Ұлы Жындар әлеміне бара алмайсыз.
Dialogue: 0,0:11:15.98,0:11:18.98,Default,,0000,0000,0000,,Мен оны түзетуге тырысамын.
Dialogue: 0,0:11:15.98,0:11:18.98,Default,,0000,0000,0000,,Оған шамамен 10 күн кетуі мүмкін.
Dialogue: 0,0:11:18.98,0:11:20.98,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:11:20.98,0:11:23.98,Default,,0000,0000,0000,,Бұл күш жеткілікті—егер қарсыласың дәл осындай деңгейдегі адам болса.
Dialogue: 0,0:11:20.98,0:11:23.98,Default,,0000,0000,0000,,Денде өлтіріледі.
Dialogue: 0,0:11:23.98,0:11:25.99,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:11:25.99,0:11:27.99,Default,,0000,0000,0000,,Егер Денде мырза
Dialogue: 0,0:11:25.99,0:11:27.99,Default,,0000,0000,0000,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:11:27.99,0:11:30.92,Default,,0000,0000,0000,,Өлтірмей
Dialogue: 0,0:11:27.99,0:11:30.92,Default,,0000,0000,0000,,Себебі мен сені өзіммен бірге алып кетуге барын салдым➡
Dialogue: 0,0:11:30.92,0:11:35.93,Default,,0000,0000,0000,,Менің ойымша, сізде бір нәрсе бар.
Dialogue: 0,0:11:30.92,0:11:35.93,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:11:35.93,0:11:39.93,Default,,0000,0000,0000,,Гараж және машиналар
Dialogue: 0,0:11:35.93,0:11:39.93,Default,,0000,0000,0000,,Бізге көмектесетін робот керек.
Dialogue: 0,0:11:39.93,0:11:41.93,Default,,0000,0000,0000,,Капсула
Dialogue: 0,0:11:39.93,0:11:41.93,Default,,0000,0000,0000,,Мен сізге әкелемін➡
Dialogue: 0,0:11:41.93,0:11:45.94,Default,,0000,0000,0000,,Кибито-сан тағы да
Dialogue: 0,0:11:41.93,0:11:45.94,Default,,0000,0000,0000,,Сіз мені үйге апара аласыз ба?
Dialogue: 0,0:11:45.94,0:11:47.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:47.94,0:11:49.91,Default,,0000,0000,0000,,Түсіндім... Түсіндім.
Dialogue: 0,0:11:53.95,0:11:58.95,Default,,0000,0000,0000,,♬ (Бұлманың гуілдеуі)
Dialogue: 0,0:11:58.95,0:12:00.92,Default,,0000,0000,0000,,Мектептен шығарылу үшін қажет найзағайлар: 7 қалды
Dialogue: 0,0:11:58.95,0:12:00.92,Default,,0000,0000,0000,,Біз қайтуға болады.
Dialogue: 0,0:12:03.96,0:12:06.96,Default,,0000,0000,0000,,Хмф! Хмф!
Dialogue: 0,0:12:06.96,0:12:09.96,Default,,0000,0000,0000,,Таа! Ха!
Dialogue: 0,0:12:09.96,0:12:12.97,Default,,0000,0000,0000,,әйтеуір
Dialogue: 0,0:12:09.96,0:12:12.97,Default,,0000,0000,0000,,Енді сіз жақсы ұша аласыз.
Dialogue: 0,0:12:12.97,0:12:15.97,Default,,0000,0000,0000,,Түсіндім. Түсіндім.
Dialogue: 0,0:12:15.97,0:12:17.94,Default,,0000,0000,0000,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:12:19.97,0:12:24.98,Default,,0000,0000,0000,,Бұл не? Мен оған мүлдем жете алмаймын.
Dialogue: 0,0:12:24.98,0:12:27.98,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:12:27.98,0:12:29.98,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:12:29.98,0:12:33.92,Default,,0000,0000,0000,,А... Иә? Әзірше емес?
Dialogue: 0,0:12:33.92,0:12:37.92,Default,,0000,0000,0000,,Себебі мен кенет кішкентай болып қалдым
Dialogue: 0,0:12:33.92,0:12:37.92,Default,,0000,0000,0000,,Мен қашықтықты сезе алмаймын.
Dialogue: 0,0:12:37.92,0:12:40.93,Default,,0000,0000,0000,,Мен ойлағандай болды.
Dialogue: 0,0:12:40.93,0:12:42.93,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:12:42.93,0:12:45.93,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:12:42.93,0:12:45.93,Default,,0000,0000,0000,,Тым қатты, Какарот!
Dialogue: 0,0:12:45.93,0:12:48.93,Default,,0000,0000,0000,,Вари
Dialogue: 0,0:12:45.93,0:12:48.93,Default,,0000,0000,0000,,Нашар Нашар. Хахаха….
Dialogue: 0,0:12:48.93,0:12:50.94,Default,,0000,0000,0000,,Осылай қалса➡
Dialogue: 0,0:12:50.94,0:12:53.94,Default,,0000,0000,0000,,Осы өлшемге үйренгенше
Dialogue: 0,0:12:50.94,0:12:53.94,Default,,0000,0000,0000,,Бұл ақылсыз.
Dialogue: 0,0:12:53.94,0:12:56.94,Default,,0000,0000,0000,,Хм... Аа, дұрыс!
Dialogue: 0,0:12:56.94,0:13:01.95,Default,,0000,0000,0000,,Мен біраз уақытқа шығамын!
Dialogue: 0,0:12:56.94,0:13:01.95,Default,,0000,0000,0000,,Мен жақында ораламын!
Dialogue: 0,0:13:01.95,0:13:05.95,Default,,0000,0000,0000,,Цк... Ол мазасыз.
Dialogue: 0,0:13:05.95,0:13:08.95,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:13:05.95,0:13:08.95,Default,,0000,0000,0000,,Сүйір құлақтар ➡
Dialogue: 0,0:13:08.95,0:13:11.96,Default,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:13:08.95,0:13:11.96,Default,,0000,0000,0000,,Сіз Ұлы Жындар әлеміненсіз бе?
Dialogue: 0,0:13:11.96,0:13:13.96,Default,,0000,0000,0000,,Бәрі емес.
Dialogue: 0,0:13:13.96,0:13:16.96,Default,,0000,0000,0000,,Менің ойымша, бұл шамамен солай.
Dialogue: 0,0:13:13.96,0:13:16.96,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:13:16.96,0:13:19.97,Default,,0000,0000,0000,,Баяғыда еркіндік іздеп➡
Dialogue: 0,0:13:19.97,0:13:22.97,Default,,0000,0000,0000,,Ғарышқа шығу
Dialogue: 0,0:13:19.97,0:13:22.97,Default,,0000,0000,0000,,Жұлдыздарға үстемдік ету... ➡
Dialogue: 0,0:13:22.97,0:13:24.97,Default,,0000,0000,0000,,Саяхат қарқынды дамып келеді➡
Dialogue: 0,0:13:24.97,0:13:28.97,Default,,0000,0000,0000,,Көптеген жындар
Dialogue: 0,0:13:24.97,0:13:28.97,Default,,0000,0000,0000,,Ұлы жын-шайтан әлемінен адамдар қашып кеткен уақыт болды.
Dialogue: 0,0:13:28.97,0:13:32.91,Default,,0000,0000,0000,,Бұдан кейін тыйым салынады.... ➡
Dialogue: 0,0:13:32.91,0:13:35.92,Default,,0000,0000,0000,,Енді санаулы адамдар ғана рұқсат алады➡
Dialogue: 0,0:13:35.92,0:13:39.89,Default,,0000,0000,0000,,Ұлы жын әлемі
Dialogue: 0,0:13:35.92,0:13:39.89,Default,,0000,0000,0000,,Мен енді алға-артқа жүре алмайтын сияқтымын.
Dialogue: 0,0:13:44.92,0:13:46.93,Default,,0000,0000,0000,,Міне, солай!
Dialogue: 0,0:13:46.93,0:13:49.93,Default,,0000,0000,0000,,Сәлем, Кибито-сан.
Dialogue: 0,0:13:46.93,0:13:49.93,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:13:49.93,0:13:52.93,Default,,0000,0000,0000,,Кешкі ас
Dialogue: 0,0:13:49.93,0:13:52.93,Default,,0000,0000,0000,,Себебі мен сұрадым➡
Dialogue: 0,0:13:52.93,0:13:55.94,Default,,0000,0000,0000,,Барып, оны телепортация арқылы алыңыз.
Dialogue: 0,0:13:52.93,0:13:55.94,Default,,0000,0000,0000,,Бұл біраз кінәлі сезім емес пе?
Dialogue: 0,0:13:55.94,0:13:58.94,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:13:58.94,0:14:01.94,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:14:01.94,0:14:03.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:03.94,0:14:06.95,Default,,0000,0000,0000,,Эй, келдің бе?
Dialogue: 0,0:14:06.95,0:14:10.95,Default,,0000,0000,0000,,Құрметті Қарин.
Dialogue: 0,0:14:06.95,0:14:10.95,Default,,0000,0000,0000,,Біраз уақыт өтті.
Dialogue: 0,0:14:10.95,0:14:13.95,Default,,0000,0000,0000,,Ола кішкентай қызға айналды
Dialogue: 0,0:14:10.95,0:14:13.95,Default,,0000,0000,0000,,Таң қалмайсың ба?
Dialogue: 0,0:14:13.95,0:14:16.96,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:14:16.96,0:14:20.96,Default,,0000,0000,0000,,Кейде осы жерден
Dialogue: 0,0:14:16.96,0:14:20.96,Default,,0000,0000,0000,,Сіз төмендегі жағдайды қарап отырсыз.
Dialogue: 0,0:14:20.96,0:14:24.96,Default,,0000,0000,0000,,Эй, мен жалықтым.
Dialogue: 0,0:14:20.96,0:14:24.96,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:14:24.96,0:14:29.97,Default,,0000,0000,0000,,Осыдан, Қарын-сама
Dialogue: 0,0:14:24.96,0:14:29.97,Default,,0000,0000,0000,,Ола, мен Ньой-бо алуға келдім.
Dialogue: 0,0:14:29.97,0:14:31.90,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:31.90,0:14:34.91,Default,,0000,0000,0000,,Қараңызшы, ол шақпайды.
Dialogue: 0,0:14:34.91,0:14:37.91,Default,,0000,0000,0000,,Бұрын осында болатын, солай ма?
Dialogue: 0,0:14:37.91,0:14:40.91,Default,,0000,0000,0000,,Соңғы уақытта
Dialogue: 0,0:14:37.91,0:14:40.91,Default,,0000,0000,0000,,Кейбір адамдар бұл жерді ғибадатханаға бару үшін пайдаланады➡
Dialogue: 0,0:14:40.91,0:14:44.92,Default,,0000,0000,0000,,Өйткені ол кетті.
Dialogue: 0,0:14:40.91,0:14:44.92,Default,,0000,0000,0000,,Енді ше?
Dialogue: 0,0:14:44.92,0:14:49.59,Default,,0000,0000,0000,,Хмм... Қалай өтті деп ойлаймын.
Dialogue: 0,0:14:44.92,0:14:49.59,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:49.59,0:14:51.92,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:51.92,0:14:54.93,Default,,0000,0000,0000,,Белгілі
Dialogue: 0,0:14:51.92,0:14:54.93,Default,,0000,0000,0000,,Мен оны Мутен Рошиге қалдырдым.
Dialogue: 0,0:14:54.93,0:14:57.93,Default,,0000,0000,0000,,Менің атам қайда? Рақмет сізге!
Dialogue: 0,0:14:57.93,0:14:59.93,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:14:59.93,0:15:02.94,Default,,0000,0000,0000,,Кинтун
Dialogue: 0,0:14:59.93,0:15:02.94,Default,,0000,0000,0000,,Судзитун
Dialogue: 0,0:14:59.93,0:15:02.94,Default,,0000,0000,0000,,Сіз оны өзіңізбен бірге ала аласыз!
Dialogue: 0,0:15:02.94,0:15:06.94,Default,,0000,0000,0000,,Уайымдамаңыз! Уайымдама! Уф~!
Dialogue: 0,0:15:06.94,0:15:10.91,Default,,0000,0000,0000,,Әдеттегідей
Dialogue: 0,0:15:06.94,0:15:10.91,Default,,0000,0000,0000,,Ол бос емес жігіт.
Dialogue: 0,0:15:13.95,0:15:16.95,Default,,0000,0000,0000,,Нихи. Хехе.
Dialogue: 0,0:15:16.95,0:15:19.95,Default,,0000,0000,0000,,Сәлем, ата!
Dialogue: 0,0:15:16.95,0:15:19.95,Default,,0000,0000,0000,,Нихи.
Dialogue: 0,0:15:19.95,0:15:22.96,Default,,0000,0000,0000,,О, Гоку?
Dialogue: 0,0:15:22.96,0:15:24.96,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:24.96,0:15:27.96,Default,,0000,0000,0000,,Үлкен күшпен
Dialogue: 0,0:15:24.96,0:15:27.96,Default,,0000,0000,0000,,Себебі мен жасардым➡
Dialogue: 0,0:15:27.96,0:15:30.96,Default,,0000,0000,0000,,Мен не істегім келеді
Dialogue: 0,0:15:27.96,0:15:30.96,Default,,0000,0000,0000,,Өте көп.
Dialogue: 0,0:15:30.96,0:15:32.97,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:15:32.97,0:15:35.97,Default,,0000,0000,0000,,Бұл не үшін?
Dialogue: 0,0:15:35.97,0:15:40.97,Default,,0000,0000,0000,,Оланың Ньоибосы Сіз білмейсіз бе?
Dialogue: 0,0:15:35.97,0:15:40.97,Default,,0000,0000,0000,,Қарин-сама осында.
Dialogue: 0,0:15:40.97,0:15:45.98,Default,,0000,0000,0000,,Ньой-бо?
Dialogue: 0,0:15:40.97,0:15:45.98,Default,,0000,0000,0000,,Мм... Менің үйімде бар ма?
Dialogue: 0,0:15:45.98,0:15:50.98,Default,,0000,0000,0000,,⚟Иә?
Dialogue: 0,0:15:45.98,0:15:50.98,Default,,0000,0000,0000,,Мен бұл жерде деп естідім.
Dialogue: 0,0:15:50.98,0:15:53.99,Default,,0000,0000,0000,,⚟Бір жерде
Dialogue: 0,0:15:50.98,0:15:53.99,Default,,0000,0000,0000,,Қойылған жоқ па?
Dialogue: 0,0:15:53.99,0:15:55.99,Default,,0000,0000,0000,,⚟ (Каме Эрмит) Менің есімде жоқ.
Dialogue: 0,0:15:55.99,0:15:59.96,Default,,0000,0000,0000,,⚟Олай айтпа
Dialogue: 0,0:15:55.99,0:15:59.96,Default,,0000,0000,0000,,Есіңізде болсын, ата.
Dialogue: 0,0:16:01.99,0:16:04.00,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:16:04.00,0:16:07.00,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:16:04.00,0:16:07.00,Default,,0000,0000,0000,,Қош келдің, немере.
Dialogue: 0,0:16:07.00,0:16:10.00,Default,,0000,0000,0000,,Мен саған жақсы нәрсе көрсетемін.
Dialogue: 0,0:16:10.00,0:16:12.00,Default,,0000,0000,0000,,Джан!
Dialogue: 0,0:16:12.00,0:16:14.01,Default,,0000,0000,0000,,Мен ойлағандай болды.
Dialogue: 0,0:16:14.01,0:16:15.98,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:16:19.01,0:16:22.01,Default,,0000,0000,0000,,Қабыл ал!
Dialogue: 0,0:16:22.01,0:16:24.98,Default,,0000,0000,0000,,Ах! Созыңыз!
Dialogue: 0,0:16:27.02,0:16:30.02,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:30.02,0:16:32.96,Default,,0000,0000,0000,,Қайтыңыз!
Dialogue: 0,0:16:32.96,0:16:36.96,Default,,0000,0000,0000,,Хе... Бұл туралы не айтасыз?
Dialogue: 0,0:16:32.96,0:16:36.96,Default,,0000,0000,0000,,Ньои-бо.
Dialogue: 0,0:16:36.96,0:16:40.97,Default,,0000,0000,0000,,Ностальгиялық, солай ма? Блумерлер.
Dialogue: 0,0:16:36.96,0:16:40.97,Default,,0000,0000,0000,,Рас. Қай жерде болды?
Dialogue: 0,0:16:40.97,0:16:43.97,Default,,0000,0000,0000,,Джикчанчидің киім жіптері.
Dialogue: 0,0:16:43.97,0:16:45.94,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:16:47.97,0:16:51.98,Default,,0000,0000,0000,,О, бұл дәмді көрінеді!
Dialogue: 0,0:16:47.97,0:16:51.98,Default,,0000,0000,0000,,Тез тамақтанып алайық.
Dialogue: 0,0:16:51.98,0:16:53.95,Default,,0000,0000,0000,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:16:58.98,0:17:01.99,Default,,0000,0000,0000,,Ммм!
Dialogue: 0,0:16:58.98,0:17:01.99,Default,,0000,0000,0000,,Ойланып болған соң➡
Dialogue: 0,0:17:01.99,0:17:04.99,Default,,0000,0000,0000,,Кибито-санға арналған ғарыш кемесі.
Dialogue: 0,0:17:01.99,0:17:04.99,Default,,0000,0000,0000,,Capsule корпорациясына➡
Dialogue: 0,0:17:04.99,0:17:07.99,Default,,0000,0000,0000,,Оны біреу көтеріп алғаны дұрыс
Dialogue: 0,0:17:04.99,0:17:07.99,Default,,0000,0000,0000,,Бұл оңай болды.
Dialogue: 0,0:17:07.99,0:17:10.00,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:17:10.00,0:17:13.00,Default,,0000,0000,0000,,Мені курьер немесе басқа нәрсе деп ойлаңыз.
Dialogue: 0,0:17:10.00,0:17:13.00,Default,,0000,0000,0000,,Сіз олай ойламайсыз ба?
Dialogue: 0,0:17:13.00,0:17:17.00,Default,,0000,0000,0000,,Сәлем Пикколо
Dialogue: 0,0:17:13.00,0:17:17.00,Default,,0000,0000,0000,,Ұлы жындар әлемі есіңізде ме?
Dialogue: 0,0:17:17.00,0:17:21.01,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:17:17.00,0:17:21.01,Default,,0000,0000,0000,,Мен әлі туылған жоқпын. ➡
Dialogue: 0,0:17:21.01,0:17:25.01,Default,,0000,0000,0000,,Бірақ мен әңгімені естідім.
Dialogue: 0,0:17:21.01,0:17:25.01,Default,,0000,0000,0000,,Қандай орын?
Dialogue: 0,0:17:25.01,0:17:28.01,Default,,0000,0000,0000,,Кем дегенде, Намекиандықтар
Dialogue: 0,0:17:25.01,0:17:28.01,Default,,0000,0000,0000,,Мен тұратын аудан➡ болды
Dialogue: 0,0:17:28.01,0:17:30.02,Default,,0000,0000,0000,,Бұл жақсы жер болған сияқты.
Dialogue: 0,0:17:30.02,0:17:33.95,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:17:30.02,0:17:33.95,Default,,0000,0000,0000,,Сонда сен неге қашып кеттің?
Dialogue: 0,0:17:33.95,0:17:39.96,Default,,0000,0000,0000,,Намекиялықтар
Dialogue: 0,0:17:33.95,0:17:39.96,Default,,0000,0000,0000,,Басқаруды ұнатпайды.
Dialogue: 0,0:17:39.96,0:17:41.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:43.96,0:17:45.93,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:17:43.96,0:17:45.93,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:17:47.97,0:17:49.97,Default,,0000,0000,0000,,Жау?
Dialogue: 0,0:17:47.97,0:17:49.97,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:17:49.97,0:17:52.97,Default,,0000,0000,0000,,Мен ешқандай күшті өлтіру ниетін сезінбеймін, бірақ...
Dialogue: 0,0:17:52.97,0:17:56.98,Default,,0000,0000,0000,,Себебі мен бала болдым
Dialogue: 0,0:17:52.97,0:17:56.98,Default,,0000,0000,0000,,Сезімдерің түтіккен болуы мүмкін.
Dialogue: 0,0:17:56.98,0:17:58.98,Default,,0000,0000,0000,,Үлкен күшпен
Dialogue: 0,0:17:56.98,0:17:58.98,Default,,0000,0000,0000,,Олар маған той әкелді!
Dialogue: 0,0:17:58.98,0:18:02.98,Default,,0000,0000,0000,,Мен келе жатырмын.
Dialogue: 0,0:17:58.98,0:18:02.98,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:02.98,0:18:04.95,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:11.99,0:18:14.99,Default,,0000,0000,0000,,Әй, ғарыш кемесі. ➡
Dialogue: 0,0:18:14.99,0:18:20.00,Default,,0000,0000,0000,,Ұлы жын әлемінің жігіттері мінген.
Dialogue: 0,0:18:14.99,0:18:20.00,Default,,0000,0000,0000,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:18:20.00,0:18:24.00,Default,,0000,0000,0000,,Ах...бірақ түсі басқа.
Dialogue: 0,0:18:24.00,0:18:25.97,Default,,0000,0000,0000,,Олар дос болуы мүмкін.
Dialogue: 0,0:18:35.95,0:18:37.92,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:42.96,0:18:44.92,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:18:50.96,0:18:53.97,Default,,0000,0000,0000,,Бұл кім? Сәлем.
Dialogue: 0,0:18:53.97,0:18:57.97,Default,,0000,0000,0000,,Мен Глориомын.
Dialogue: 0,0:18:57.97,0:19:00.97,Default,,0000,0000,0000,,Ол Ұлы жындар әлемінен.
Dialogue: 0,0:19:00.97,0:19:03.98,Default,,0000,0000,0000,,А, бұл дұрыс.
Dialogue: 0,0:19:03.98,0:19:08.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:03.98,0:19:08.98,Default,,0000,0000,0000,,Сіз Гокусыз, солай ма?
Dialogue: 0,0:19:08.98,0:19:10.98,Default,,0000,0000,0000,,Иә, бірақ.
Dialogue: 0,0:19:10.98,0:19:13.99,Default,,0000,0000,0000,,Менің сұрайын дегенім бар.
Dialogue: 0,0:19:13.99,0:19:18.99,Default,,0000,0000,0000,,Ұлы жын әлеміне бірге барайық.
Dialogue: 0,0:19:13.99,0:19:18.99,Default,,0000,0000,0000,,Король Гомерді жеңу.
Dialogue: 0,0:19:18.99,0:19:20.99,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:19:20.99,0:19:23.00,Default,,0000,0000,0000,,Не, Гомер! ?
Dialogue: 0,0:19:23.00,0:19:27.00,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:19:23.00,0:19:27.00,Default,,0000,0000,0000,,Ал патша ше?
Dialogue: 0,0:19:27.00,0:19:31.94,Default,,0000,0000,0000,,Жын патшасы Дабура қайтыс болды
Dialogue: 0,0:19:27.00,0:19:31.94,Default,,0000,0000,0000,,Жаңа патша – зұлым жын.
Dialogue: 0,0:19:31.94,0:19:34.94,Default,,0000,0000,0000,,Сондықтан мен түсіндім.
Dialogue: 0,0:19:34.94,0:19:38.94,Default,,0000,0000,0000,,Денде мырзаны ұрлап кеткен кішкентай бала
Dialogue: 0,0:19:34.94,0:19:38.94,Default,,0000,0000,0000,,Бастық бұл➡
Dialogue: 0,0:19:38.94,0:19:42.95,Default,,0000,0000,0000,,Бұл Гомер болатын.
Dialogue: 0,0:19:38.94,0:19:42.95,Default,,0000,0000,0000,,Сол қол
Dialogue: 0,0:19:42.95,0:19:44.95,Default,,0000,0000,0000,,Қауіпсіздігін түсіре алмайтын шайтан.
Dialogue: 0,0:19:44.95,0:19:49.96,Default,,0000,0000,0000,,Ол күшті, бірақ айлакер адам.
Dialogue: 0,0:19:49.96,0:19:51.96,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:19:51.96,0:19:54.96,Default,,0000,0000,0000,,Бұл дұрыс болды, солай емес пе?
Dialogue: 0,0:19:54.96,0:19:58.93,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:19:54.96,0:19:58.93,Default,,0000,0000,0000,,Мен барып Дендеге көмектесейін.
Dialogue: 0,0:20:00.97,0:20:02.97,Default,,0000,0000,0000,,Күтіңіз.
Dialogue: 0,0:20:02.97,0:20:04.97,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:02.97,0:20:04.97,Default,,0000,0000,0000,,Сен неге Гоку туралы айтып отырсың?
Dialogue: 0,0:20:04.97,0:20:06.97,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:20:06.97,0:20:09.98,Default,,0000,0000,0000,,Мен үшінші жын әлемінің патшасынан естідім. ➡
Dialogue: 0,0:20:09.98,0:20:13.98,Default,,0000,0000,0000,,Сиқырлы монитормен
Dialogue: 0,0:20:09.98,0:20:13.98,Default,,0000,0000,0000,,Маджин Буумен болған төбелесті көрген сияқты. ➡
Dialogue: 0,0:20:13.98,0:20:17.98,Default,,0000,0000,0000,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:20:13.98,0:20:17.98,Default,,0000,0000,0000,,Ол патшаның бұйрығымен келді.
Dialogue: 0,0:20:17.98,0:20:21.99,Default,,0000,0000,0000,,Сіз үшінші жын әлемінің патшасысыз.
Dialogue: 0,0:20:17.98,0:20:21.99,Default,,0000,0000,0000,,Сіз қызмет етесіз бе?
Dialogue: 0,0:20:21.99,0:20:28.99,Default,,0000,0000,0000,,Жоқ, мені әкелуіңді өтіндім.
Dialogue: 0,0:20:21.99,0:20:28.99,Default,,0000,0000,0000,,Мен жаңа ғана құпия сұрау алдым.
Dialogue: 0,0:20:28.99,0:20:30.93,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:20:30.93,0:20:34.93,Default,,0000,0000,0000,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:20:30.93,0:20:34.93,Default,,0000,0000,0000,,Жарайды, мен сенімен бірге барайын.
Dialogue: 0,0:20:34.93,0:20:37.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:34.93,0:20:37.94,Default,,0000,0000,0000,,Кай патша! ?
Dialogue: 0,0:20:37.94,0:20:41.94,Default,,0000,0000,0000,,Менің де ағам сияқты
Dialogue: 0,0:20:37.94,0:20:41.94,Default,,0000,0000,0000,,Олардың қатысы бар сияқты. ➡
Dialogue: 0,0:20:41.94,0:20:46.95,Default,,0000,0000,0000,,Сондай-ақ Ұлы жын әлемі туралы.
Dialogue: 0,0:20:41.94,0:20:46.95,Default,,0000,0000,0000,,Себебі мен оны белгілі бір дәрежеде білемін.
Dialogue: 0,0:20:46.95,0:20:48.95,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:20:48.95,0:20:51.95,Default,,0000,0000,0000,,Мектепке қабылдау сыйы ретінде маған берілген тау велосипеді
Dialogue: 0,0:20:48.95,0:20:51.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:51.95,0:20:53.95,Default,,0000,0000,0000,,Мен оны жөндеуге анықтама ретінде пайдаланғым келеді. ➡
Dialogue: 0,0:20:53.95,0:20:57.96,Default,,0000,0000,0000,,Сол ғарыш кемесінен кішкене ғана.
Dialogue: 0,0:20:53.95,0:20:57.96,Default,,0000,0000,0000,,Мен оны көре аламын ба?
Dialogue: 0,0:20:57.96,0:20:59.96,Default,,0000,0000,0000,,Ғарыш кемесі?
Dialogue: 0,0:20:59.96,0:21:02.96,Default,,0000,0000,0000,,А... сіз ұшақты айтасыз ба?
Dialogue: 0,0:21:02.96,0:21:05.96,Default,,0000,0000,0000,,Егер сіз ғарышта ұшқыңыз келсе, ғарыш кемесін қолданбаңыз.
Dialogue: 0,0:21:05.96,0:21:09.97,Default,,0000,0000,0000,,Бұл жолы кездейсоқ
Dialogue: 0,0:21:05.96,0:21:09.97,Default,,0000,0000,0000,,Мен жай ғана ғарышта ұштым.
Dialogue: 0,0:21:09.97,0:21:12.64,Default,,0000,0000,0000,,Мен әдетте ұшпаймын.
Dialogue: 0,0:21:09.97,0:21:12.64,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:21:12.64,0:21:15.64,Default,,0000,0000,0000,,Қарап шығуға болады, бірақ асығыңыз.
Dialogue: 0,0:21:15.64,0:21:17.98,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:17.98,0:21:23.98,Default,,0000,0000,0000,,Глорио есімді адам
Dialogue: 0,0:21:17.98,0:21:23.98,Default,,0000,0000,0000,,Сақ болу керек.
Dialogue: 0,0:21:23.98,0:21:26.99,Default,,0000,0000,0000,,(Дос) Не? «Chōzetsu Zekkyō Keikaku 5 (Бес)» деген бар ма?
Dialogue: 0,0:21:23.98,0:21:26.99,Default,,0000,0000,0000,,Біз➡
Dialogue: 0,0:21:26.99,0:21:29.99,Default,,0000,0000,0000,,Бала болғанымда не болды?
Dialogue: 0,0:21:26.99,0:21:29.99,Default,,0000,0000,0000,,Білмеу керек болса да➡
Dialogue: 0,0:21:29.99,0:21:31.92,Default,,0000,0000,0000,,Мен таң қалмадым.
Dialogue: 0,0:21:31.92,0:21:35.93,Default,,0000,0000,0000,,Бұл туралы да патшадан сұраңыз.
Dialogue: 0,0:21:31.92,0:21:35.93,Default,,0000,0000,0000,,Сіз білмедіңіз бе?
Dialogue: 0,0:21:35.93,0:21:38.93,Default,,0000,0000,0000,,Мен солай деп үміттенемін ...
Dialogue: 0,0:21:38.93,0:21:41.93,Default,,0000,0000,0000,,көремін. Рақмет сізге. ➡
Dialogue: 0,0:21:41.93,0:21:44.94,Default,,0000,0000,0000,,Керемет
Dialogue: 0,0:21:41.93,0:21:44.94,Default,,0000,0000,0000,,Мен әйтеуір логиканы түсіндім.
Dialogue: 0,0:21:44.94,0:21:48.94,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:21:44.94,0:21:48.94,Default,,0000,0000,0000,,Мен оны ойлағаннан да тезірек жөндей алатын сияқтымын.
Dialogue: 0,0:21:48.94,0:21:51.91,Default,,0000,0000,0000,,Жақсы! Бірден барайық!
Dialogue: 0,0:21:53.95,0:21:56.95,Default,,0000,0000,0000,,Мен де барамын.
Dialogue: 0,0:21:53.95,0:21:56.95,Default,,0000,0000,0000,,Сол патшадан құтылыңыз➡
Dialogue: 0,0:21:56.95,0:21:59.95,Default,,0000,0000,0000,,Айдаһар добы
Dialogue: 0,0:21:56.95,0:21:59.95,Default,,0000,0000,0000,,Қайта тірілмесе➡
Dialogue: 0,0:21:59.95,0:22:01.95,Default,,0000,0000,0000,,Біз әлі баламыз.
Dialogue: 0,0:22:01.95,0:22:05.96,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:22:01.95,0:22:05.96,Default,,0000,0000,0000,,Бұл ұшақ тек үш адамды сыйдыра алады.
Dialogue: 0,0:22:05.96,0:22:07.96,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:22:07.96,0:22:10.96,Default,,0000,0000,0000,,Егер бұл баланың денесі болса, оны жинаңыз.
Dialogue: 0,0:22:07.96,0:22:10.96,Default,,0000,0000,0000,,Ол кем дегенде тағы бір адамға сыяды!
Dialogue: 0,0:22:10.96,0:22:13.97,Default,,0000,0000,0000,,Кешіріңіз. Балалар➡
Dialogue: 0,0:22:13.97,0:22:15.97,Default,,0000,0000,0000,,Бұлма оны жөндеп жатыр.
Dialogue: 0,0:22:13.97,0:22:15.97,Default,,0000,0000,0000,,Ғарыш кемесі бекітілгеннен кейін➡
Dialogue: 0,0:22:15.97,0:22:17.97,Default,,0000,0000,0000,,Кейінірек оралыңыз.
Dialogue: 0,0:22:17.97,0:22:19.94,Default,,0000,0000,0000,,Tsk….
Dialogue: 0,0:22:21.97,0:22:24.98,Default,,0000,0000,0000,,(механикалық дыбыс)
Dialogue: 0,0:22:24.98,0:22:26.95,Default,,0000,0000,0000,,Хаха.
Dialogue: 0,0:22:28.98,0:22:32.92,Default,,0000,0000,0000,,Олай болса, бәріміз, көріскенше.
Dialogue: 0,0:22:32.92,0:22:34.89,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:22:36.92,0:22:38.89,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:49.94,0:22:59.91,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:01.41,0:23:07.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory