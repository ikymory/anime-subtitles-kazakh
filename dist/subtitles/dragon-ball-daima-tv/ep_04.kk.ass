Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:12.01,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:42.00,0:01:44.00,Default,,0000,0000,0000,,Ұшақ...
Dialogue: 0,0:01:44.00,0:01:47.01,Default,,0000,0000,0000,,Кайошин
Dialogue: 0,0:01:44.00,0:01:47.01,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:01:47.01,0:01:49.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:01:49.01,0:01:52.98,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:02:03.02,0:02:07.03,Default,,0000,0000,0000,,Боқ...
Dialogue: 0,0:02:03.02,0:02:07.03,Default,,0000,0000,0000,,Мен оны дұрыс құлыптап алсам да...
Dialogue: 0,0:02:07.03,0:02:11.03,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:02:07.03,0:02:11.03,Default,,0000,0000,0000,,Мен Жерге орала аламын ба?
Dialogue: 0,0:02:11.03,0:02:13.03,Default,,0000,0000,0000,,Бұл туралы бірдеңе жасаңыз.
Dialogue: 0,0:02:13.03,0:02:17.04,Default,,0000,0000,0000,,Біраз жүріңіз
Dialogue: 0,0:02:13.03,0:02:17.04,Default,,0000,0000,0000,,Бір жерден көлік алайық.
Dialogue: 0,0:02:17.04,0:02:22.04,Default,,0000,0000,0000,,Ұшсаң оңай.
Dialogue: 0,0:02:17.04,0:02:22.04,Default,,0000,0000,0000,,Әркім ұша алады, солай ма?
Dialogue: 0,0:02:22.04,0:02:25.04,Default,,0000,0000,0000,,
Dialogue: 0,0:02:22.04,0:02:25.04,Default,,0000,0000,0000,,Бұл ауада ұзақ ұшу қиын.
Dialogue: 0,0:02:25.04,0:02:29.05,Default,,0000,0000,0000,,Жоғары энергия тұтыну
Dialogue: 0,0:02:25.04,0:02:29.05,Default,,0000,0000,0000,,Себебі мен тез шаршаймын.
Dialogue: 0,0:02:29.05,0:02:30.65,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:02:30.65,0:02:32.99,Default,,0000,0000,0000,,Йотто.
Dialogue: 0,0:02:32.99,0:02:34.95,Default,,0000,0000,0000,,Иә? иә?
Dialogue: 0,0:02:36.99,0:02:40.99,Default,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:02:36.99,0:02:40.99,Default,,0000,0000,0000,,Бұл өте ауыр.
Dialogue: 0,0:02:40.99,0:02:45.00,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:02:40.99,0:02:45.00,Default,,0000,0000,0000,,Ауа ауыр сезіледі. Мен түсінемін.
Dialogue: 0,0:02:45.00,0:02:50.97,Default,,0000,0000,0000,,Саяхат кезінде қуат таусылып қалса
Dialogue: 0,0:02:45.00,0:02:50.97,Default,,0000,0000,0000,,Бұл қауіпті. Жүрейік.
Dialogue: 0,0:02:58.01,0:03:00.98,Default,,0000,0000,0000,,Уа, бұл тығырыққа тірелді.
Dialogue: 0,0:03:05.02,0:03:07.99,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:03:05.02,0:03:07.99,Default,,0000,0000,0000,,Мұнда ұшып барайық.
Dialogue: 0,0:03:10.02,0:03:13.03,Default,,0000,0000,0000,,Иә! Ой!
Dialogue: 0,0:03:13.03,0:03:18.03,Default,,0000,0000,0000,,Жындар әлемінде аспанда ұшу керек.
Dialogue: 0,0:03:13.03,0:03:18.03,Default,,0000,0000,0000,,Мен ешқайда бара алмаймын деп ойлаймын.
Dialogue: 0,0:03:18.03,0:03:22.04,Default,,0000,0000,0000,,Ұшақ бар болғанша
Dialogue: 0,0:03:18.03,0:03:22.04,Default,,0000,0000,0000,,Бұл тек уақыт мәселесі.
Dialogue: 0,0:03:22.04,0:03:27.04,Default,,0000,0000,0000,,Қараңғылық теңізіне құлау
Dialogue: 0,0:03:22.04,0:03:27.04,Default,,0000,0000,0000,,Қауіпті. Мұқият жалғастырайық.
Dialogue: 0,0:03:27.04,0:03:28.71,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:28.71,0:03:30.31,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:28.71,0:03:30.31,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:30.31,0:03:31.98,Default,,0000,0000,0000,,…
Dialogue: 0,0:03:31.98,0:03:34.95,Default,,0000,0000,0000,,Сәлем! Апыр-ай!
Dialogue: 0,0:03:36.98,0:03:40.99,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:03:36.98,0:03:40.99,Default,,0000,0000,0000,,Гоку-сан күткендей
Dialogue: 0,0:03:36.98,0:03:40.99,Default,,0000,0000,0000,,Бұл бастапқы қозғалыс емес.
Dialogue: 0,0:03:40.99,0:03:43.99,Default,,0000,0000,0000,,Мен әлі ауаны ұстай алмаймын.
Dialogue: 0,0:03:43.99,0:03:45.99,Default,,0000,0000,0000,,Гррр….
Dialogue: 0,0:03:45.99,0:03:51.00,Default,,0000,0000,0000,,Бұл қай жер?
Dialogue: 0,0:03:45.99,0:03:51.00,Default,,0000,0000,0000,,Шынымен де, сақтығыңызды түсірмеңіз.
Dialogue: 0,0:03:51.00,0:03:52.67,Default,,0000,0000,0000,,…
Dialogue: 0,0:03:52.67,0:03:56.00,Default,,0000,0000,0000,,Бұл менмін.
Dialogue: 0,0:03:56.00,0:03:57.97,Default,,0000,0000,0000,,Гува! Апыр-ай! Апыр-ай!
Dialogue: 0,0:04:02.01,0:04:03.98,Default,,0000,0000,0000,,Гуаааааа!
Dialogue: 0,0:04:08.01,0:04:10.02,Default,,0000,0000,0000,,Гува! Апыр-ай!
Dialogue: 0,0:04:10.02,0:04:11.99,Default,,0000,0000,0000,,Жоғалу.
Dialogue: 0,0:04:16.02,0:04:17.69,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:04:17.69,0:04:20.96,Default,,0000,0000,0000,,…
Dialogue: 0,0:04:25.03,0:04:27.03,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:04:27.03,0:04:30.97,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:04:27.03,0:04:30.97,Default,,0000,0000,0000,,Бұл өте ерлік!
Dialogue: 0,0:04:30.97,0:04:34.97,Default,,0000,0000,0000,,Кай патшадан
Dialogue: 0,0:04:30.97,0:04:34.97,Default,,0000,0000,0000,,Таяқ
Dialogue: 0,0:04:30.97,0:04:34.97,Default,,0000,0000,0000,,Менің ойымша, бұл өте күшті.
Dialogue: 0,0:04:34.97,0:04:37.98,Default,,0000,0000,0000,,Менің де күшім бар
Dialogue: 0,0:04:34.97,0:04:37.98,Default,,0000,0000,0000,,Мен сенімдімін.
Dialogue: 0,0:04:37.98,0:04:40.98,Default,,0000,0000,0000,,Әрі қарай жүрейік.
Dialogue: 0,0:04:40.98,0:04:42.98,Default,,0000,0000,0000,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:04:42.98,0:04:44.98,Default,,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:04:44.98,0:04:47.99,Default,,0000,0000,0000,,Келесі қалаға немесе ауылға дейін ұстаңыз.
Dialogue: 0,0:04:47.99,0:04:51.99,Default,,0000,0000,0000,,Дәмді жаңғақтар сияқты нәрсе.
Dialogue: 0,0:04:47.99,0:04:51.99,Default,,0000,0000,0000,,Осының айналасында емес пе?
Dialogue: 0,0:04:51.99,0:04:53.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:53.99,0:04:56.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:56.00,0:05:00.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:56.00,0:05:00.00,Default,,0000,0000,0000,,Сіз тағы бір нәрсені жасырып отырсыз.
Dialogue: 0,0:05:00.00,0:05:02.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:02.00,0:05:03.67,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:05:03.67,0:05:07.01,Default,,0000,0000,0000,,Керемет! Гооооооооооооооооооооооооооооооооооооо
Dialogue: 0,0:05:07.01,0:05:10.01,Default,,0000,0000,0000,,Ти!
Dialogue: 0,0:05:07.01,0:05:10.01,Default,,0000,0000,0000,,Менің денем ауыр.
Dialogue: 0,0:05:10.01,0:05:12.01,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:05:12.01,0:05:15.01,Default,,0000,0000,0000,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:05:12.01,0:05:15.01,Default,,0000,0000,0000,,Незуко! Мен төмен түсемін
Dialogue: 0,0:05:15.01,0:05:16.68,Default,,0000,0000,0000,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:05:15.01,0:05:16.68,Default,,0000,0000,0000,,Гуо! ➡
Dialogue: 0,0:05:16.68,0:05:19.02,Default,,0000,0000,0000,,Гррр…. ➡
Dialogue: 0,0:05:19.02,0:05:21.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:21.02,0:05:25.02,Default,,0000,0000,0000,,Га. Эй, мен шаршадым.
Dialogue: 0,0:05:25.02,0:05:28.03,Default,,0000,0000,0000,,Ол туралы қайдан білдің?
Dialogue: 0,0:05:25.02,0:05:28.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:28.03,0:05:30.96,Default,,0000,0000,0000,,Мен ештеңе көре алмадым.
Dialogue: 0,0:05:30.96,0:05:34.97,Default,,0000,0000,0000,,Ах, бұл ки. Бұл ки.
Dialogue: 0,0:05:30.96,0:05:34.97,Default,,0000,0000,0000,,Мен энергияны жаңа ғана сезіндім.
Dialogue: 0,0:05:34.97,0:05:37.97,Default,,0000,0000,0000,,Ақыл? Не? бұл.
Dialogue: 0,0:05:37.97,0:05:41.94,Default,,0000,0000,0000,,Көрінбейтін энергия сияқты нәрсе
Dialogue: 0,0:05:37.97,0:05:41.94,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:05:45.98,0:05:49.98,Default,,0000,0000,0000,,Иә? Бір нәрсе бар.
Dialogue: 0,0:05:45.98,0:05:49.98,Default,,0000,0000,0000,,Дүкенге ұқсайды.
Dialogue: 0,0:05:49.98,0:05:51.98,Default,,0000,0000,0000,,Сол жерде біраз демалып алайық.
Dialogue: 0,0:05:51.98,0:05:55.25,Default,,0000,0000,0000,,Иә! Мен күріш жей аламын!
Dialogue: 0,0:05:56.99,0:05:59.99,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:05:59.99,0:06:01.99,Default,,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:06:01.99,0:06:04.00,Default,,0000,0000,0000,,Баа!
Dialogue: 0,0:06:01.99,0:06:04.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:04.00,0:06:07.00,Default,,0000,0000,0000,,Ахаха...! Мен сені күтуге мәжбүр еттім. ➡
Dialogue: 0,0:06:07.00,0:06:09.00,Default,,0000,0000,0000,,Иә, шай.
Dialogue: 0,0:06:09.00,0:06:13.01,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:06:09.00,0:06:13.01,Default,,0000,0000,0000,,Бұл міндетті түрде көруге болатын мәзір!
Dialogue: 0,0:06:13.01,0:06:16.01,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:06:13.01,0:06:16.01,Default,,0000,0000,0000,,Жағымды иіс!
Dialogue: 0,0:06:16.01,0:06:18.01,Default,,0000,0000,0000,,Бұл кесірткенің шашлығы.
Dialogue: 0,0:06:18.01,0:06:20.98,Default,,0000,0000,0000,,Ах~ мен аламын!
Dialogue: 0,0:06:25.02,0:06:28.02,Default,,0000,0000,0000,,Иә, бұл дәмді!
Dialogue: 0,0:06:28.02,0:06:30.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:30.02,0:06:31.96,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:06:31.96,0:06:33.96,Default,,0000,0000,0000,,
Dialogue: 0,0:06:31.96,0:06:33.96,Default,,0000,0000,0000,,Бал қосылған шөп шырыны. ➡
Dialogue: 0,0:06:33.96,0:06:36.96,Default,,0000,0000,0000,,Бұл біздің атақты мәзіріміз.
Dialogue: 0,0:06:33.96,0:06:36.96,Default,,0000,0000,0000,,Бұл дәмді!
Dialogue: 0,0:06:36.96,0:06:39.97,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:06:39.97,0:06:41.97,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:41.97,0:06:44.97,Default,,0000,0000,0000,,Ниге
Dialogue: 0,0:06:41.97,0:06:44.97,Default,,0000,0000,0000,,Ауырсыну~! Уа!
Dialogue: 0,0:06:44.97,0:06:47.97,Default,,0000,0000,0000,,Осы ащы дәмді ішкенде
Dialogue: 0,0:06:44.97,0:06:47.97,Default,,0000,0000,0000,,Бұл әдетке айналады.
Dialogue: 0,0:06:47.97,0:06:51.98,Default,,0000,0000,0000,,Ол қоректік заттарға толы.
Dialogue: 0,0:06:47.97,0:06:51.98,Default,,0000,0000,0000,,Бұл бүкіл әлем үшін пайдалы! ➡
Dialogue: 0,0:06:51.98,0:06:53.98,Default,,0000,0000,0000,,Ахаха...!
Dialogue: 0,0:06:53.98,0:06:55.98,Default,,0000,0000,0000,,Глорио мырза.
Dialogue: 0,0:06:55.98,0:06:58.99,Default,,0000,0000,0000,,Бір жерден көлік алған кезде
Dialogue: 0,0:06:55.98,0:06:58.99,Default,,0000,0000,0000,,Мен айтқанымдай➡
Dialogue: 0,0:06:58.99,0:07:01.95,Default,,0000,0000,0000,,Болжам бар ма?
Dialogue: 0,0:06:58.99,0:07:01.95,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:07:05.99,0:07:12.00,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:07:05.99,0:07:12.00,Default,,0000,0000,0000,,Сіз маған қоңырау шалып жатырсыз!
Dialogue: 0,0:07:12.00,0:07:14.00,Default,,0000,0000,0000,,Рей-чан бүгін жақсы бала болғаны үшін 60 ұпай алады!
Dialogue: 0,0:07:14.00,0:07:18.00,Default,,0000,0000,0000,,Ұшақтар бар ма?
Dialogue: 0,0:07:14.00,0:07:18.00,Default,,0000,0000,0000,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:07:18.00,0:07:20.01,Default,,0000,0000,0000,,Мен ұшақ іздеп жүрмін.
Dialogue: 0,0:07:20.01,0:07:21.97,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:07:24.01,0:07:26.01,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:07:26.01,0:07:30.02,Default,,0000,0000,0000,,Бұл сенсің!
Dialogue: 0,0:07:26.01,0:07:30.02,Default,,0000,0000,0000,,Тіпті ұшақтар! ұшақ!
Dialogue: 0,0:07:30.02,0:07:31.95,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:31.95,0:07:37.96,Default,,0000,0000,0000,,Ұшақтар сәнді заттар емес.
Dialogue: 0,0:07:31.95,0:07:37.96,Default,,0000,0000,0000,,Skyseed үшін 8 000 қалай болады?
Dialogue: 0,0:07:37.96,0:07:40.96,Default,,0000,0000,0000,,Skyseed...? Қашықтық қанша?
Dialogue: 0,0:07:40.96,0:07:42.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:42.96,0:07:44.96,Default,,0000,0000,0000,,Ол қанша жерде?
Dialogue: 0,0:07:44.96,0:07:46.97,Default,,0000,0000,0000,,А, иә, дұрыс.
Dialogue: 0,0:07:46.97,0:07:51.97,Default,,0000,0000,0000,,Сіз және бала, ең көбі.
Dialogue: 0,0:07:46.97,0:07:51.97,Default,,0000,0000,0000,,Менің ойымша, бұл шамамен 120 км.
Dialogue: 0,0:07:51.97,0:07:57.98,Default,,0000,0000,0000,,120км…. 8000 бас сүйек...
Dialogue: 0,0:07:51.97,0:07:57.98,Default,,0000,0000,0000,,Бұл сәл қымбат.
Dialogue: 0,0:07:57.98,0:07:59.98,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:07:59.98,0:08:02.98,Default,,0000,0000,0000,,Басқа нәрсе іздеп жүрсіз бе?
Dialogue: 0,0:07:59.98,0:08:02.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:02.98,0:08:05.99,Default,,0000,0000,0000,,5… 5000 жақсы! Сіз қалай ойлайсыз? ?
Dialogue: 0,0:08:05.99,0:08:07.99,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:08:05.99,0:08:07.99,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:08:07.99,0:08:10.99,Default,,0000,0000,0000,,Біртүрлі нәрселер көп.
Dialogue: 0,0:08:10.99,0:08:12.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:12.99,0:08:16.00,Default,,0000,0000,0000,,Не? бұл….
Dialogue: 0,0:08:12.99,0:08:16.00,Default,,0000,0000,0000,,Бұл тәттілер ме?
Dialogue: 0,0:08:16.00,0:08:18.00,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:08:18.00,0:08:22.00,Default,,0000,0000,0000,,Өлі жәндік! Бұл неге...?
Dialogue: 0,0:08:18.00,0:08:22.00,Default,,0000,0000,0000,,Жәндіктер! ?
Dialogue: 0,0:08:22.00,0:08:27.01,Default,,0000,0000,0000,,Ал, балалар.
Dialogue: 0,0:08:22.00,0:08:27.01,Default,,0000,0000,0000,,Сен мына жақтан келген бала емессің.
Dialogue: 0,0:08:27.01,0:08:29.01,Default,,0000,0000,0000,,Фуккасуши
Dialogue: 0,0:08:27.01,0:08:29.01,Default,,0000,0000,0000,,Бұл қайта тірілу қатесі.
Dialogue: 0,0:08:29.01,0:08:33.01,Default,,0000,0000,0000,,Дәрілік қате
Dialogue: 0,0:08:29.01,0:08:33.01,Default,,0000,0000,0000,,Дәрілік жәндіктердің бір түрі
Dialogue: 0,0:08:29.01,0:08:33.01,Default,,0000,0000,0000,,Тамақ жесең, күш-қуатың қайтады.
Dialogue: 0,0:08:33.01,0:08:37.02,Default,,0000,0000,0000,,Уау, бұл керемет.
Dialogue: 0,0:08:33.01,0:08:37.02,Default,,0000,0000,0000,,Сензу
Dialogue: 0,0:08:33.01,0:08:37.02,Default,,0000,0000,0000,,Сензу бұршақтарын көру керемет емес пе?
Dialogue: 0,0:08:37.02,0:08:40.02,Default,,0000,0000,0000,,Ахахха! Бұл не?
Dialogue: 0,0:08:40.02,0:08:43.02,Default,,0000,0000,0000,,Жәндіктердің көптеген түрлері бар.
Dialogue: 0,0:08:40.02,0:08:43.02,Default,,0000,0000,0000,,Ах. ➡
Dialogue: 0,0:08:43.02,0:08:46.03,Default,,0000,0000,0000,,Осы жерден аулауға болатын дәрілік жәндіктер
Dialogue: 0,0:08:43.02,0:08:46.03,Default,,0000,0000,0000,,Онда барлығы дерлік бар. ➡
Dialogue: 0,0:08:46.03,0:08:50.03,Default,,0000,0000,0000,,Қате
Dialogue: 0,0:08:46.03,0:08:50.03,Default,,0000,0000,0000,,Күйікке қарсы тиімді Ачичи қатесі.
Dialogue: 0,0:08:46.03,0:08:50.03,Default,,0000,0000,0000,,Қате
Dialogue: 0,0:08:46.03,0:08:50.03,Default,,0000,0000,0000,,Бас ауруына қарсы тиімді қате. ➡
Dialogue: 0,0:08:50.03,0:08:53.03,Default,,0000,0000,0000,,Қоңыз
Dialogue: 0,0:08:50.03,0:08:53.03,Default,,0000,0000,0000,,Теріңізді жылтыр ететін сұлулық жәндігі.
Dialogue: 0,0:08:53.03,0:08:55.03,Default,,0000,0000,0000,,Бұл қандай жәндік?
Dialogue: 0,0:08:55.03,0:08:58.04,Default,,0000,0000,0000,,
Dialogue: 0,0:08:55.03,0:08:58.04,Default,,0000,0000,0000,,Қате
Dialogue: 0,0:08:55.03,0:08:58.04,Default,,0000,0000,0000,,Иә, бұл жабысқақ қате. ➡
Dialogue: 0,0:08:58.04,0:09:00.04,Default,,0000,0000,0000,,Оны екіге бөліп, екі адамға жесеңіз➡
Dialogue: 0,0:09:00.04,0:09:03.04,Default,,0000,0000,0000,,Біраз уақытқа біріктірілген
Dialogue: 0,0:09:00.04,0:09:03.04,Default,,0000,0000,0000,,Сіз күшті бола аласыз.
Dialogue: 0,0:09:03.04,0:09:06.05,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:09:03.04,0:09:06.05,Default,,0000,0000,0000,,Біріктіру! Фьюжн!
Dialogue: 0,0:09:06.05,0:09:09.05,Default,,0000,0000,0000,,Горилло! Эй!
Dialogue: 0,0:09:09.05,0:09:11.05,Default,,0000,0000,0000,,Бұл Глорио.
Dialogue: 0,0:09:11.05,0:09:13.05,Default,,0000,0000,0000,,Хах.
Dialogue: 0,0:09:11.05,0:09:13.05,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:09:13.05,0:09:16.06,Default,,0000,0000,0000,,Қателердің кейбірін осы жерден сатып алыңыз.
Dialogue: 0,0:09:16.06,0:09:20.06,Default,,0000,0000,0000,,Жәндіктер? О, емдік жәндік.
Dialogue: 0,0:09:20.06,0:09:22.06,Default,,0000,0000,0000,,Шынымен бе? Мен сондай қуаныштымын!
Dialogue: 0,0:09:22.06,0:09:26.07,Default,,0000,0000,0000,,Сувенирлер ондаған жылдар бойы бар.
Dialogue: 0,0:09:22.06,0:09:26.07,Default,,0000,0000,0000,,Өйткені ол ешқашан сатылмаған. ➡
Dialogue: 0,0:09:26.07,0:09:29.07,Default,,0000,0000,0000,,Хаха!
Dialogue: 0,0:09:29.07,0:09:32.00,Default,,0000,0000,0000,,Рахмет, Горилло! Хе.
Dialogue: 0,0:09:32.00,0:09:34.01,Default,,0000,0000,0000,,Бұл Глорио.
Dialogue: 0,0:09:34.01,0:09:35.98,Default,,0000,0000,0000,,Әй, бұл осылай.
Dialogue: 0,0:09:41.01,0:09:43.02,Default,,0000,0000,0000,,Осы жерде күтіңіз.
Dialogue: 0,0:09:43.02,0:09:46.02,Default,,0000,0000,0000,,(Кайошин)
Dialogue: 0,0:09:43.02,0:09:46.02,Default,,0000,0000,0000,,«Осында Skyseed boarding point»?
Dialogue: 0,0:09:46.02,0:09:48.02,Default,,0000,0000,0000,,Не? сол.
Dialogue: 0,0:09:48.02,0:09:51.02,Default,,0000,0000,0000,,Мен де бірінші рет естіп тұрмын.
Dialogue: 0,0:09:51.02,0:09:54.03,Default,,0000,0000,0000,,Кел, кел, кел.
Dialogue: 0,0:09:51.02,0:09:54.03,Default,,0000,0000,0000,,Күткеніңізге рахмет!
Dialogue: 0,0:09:54.03,0:09:58.03,Default,,0000,0000,0000,,Сен екеуміз арман ұшамыз
Dialogue: 0,0:09:54.03,0:09:58.03,Default,,0000,0000,0000,,Бүгінгі түнді сүйіңіз!
Dialogue: 0,0:09:58.03,0:10:04.04,Default,,0000,0000,0000,,Танымал Skyseed аялдамасы
Dialogue: 0,0:09:58.03,0:10:04.04,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:10:04.04,0:10:08.04,Default,,0000,0000,0000,,О...
Dialogue: 0,0:10:04.04,0:10:08.04,Default,,0000,0000,0000,,Қызықты нәрсе сияқты!
Dialogue: 0,0:10:08.04,0:10:12.04,Default,,0000,0000,0000,,Иә, иә, иә, иә!
Dialogue: 0,0:10:08.04,0:10:12.04,Default,,0000,0000,0000,,Бортта үш адам бар!
Dialogue: 0,0:10:12.04,0:10:15.05,Default,,0000,0000,0000,,Жақында
Dialogue: 0,0:10:12.04,0:10:15.05,Default,,0000,0000,0000,,Аспан тұқымы келді!
Dialogue: 0,0:10:15.05,0:10:18.05,Default,,0000,0000,0000,,Мұнда
Dialogue: 0,0:10:15.05,0:10:18.05,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:10:18.05,0:10:21.02,Default,,0000,0000,0000,,Бұл қандай ғажайып көлік?
Dialogue: 0,0:10:24.06,0:10:26.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:24.06,0:10:26.06,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:10:26.06,0:10:28.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:30.06,0:10:33.00,Default,,0000,0000,0000,,Не? Бұл.
Dialogue: 0,0:10:33.00,0:10:36.00,Default,,0000,0000,0000,,Skyseed деп аталады
Dialogue: 0,0:10:33.00,0:10:36.00,Default,,0000,0000,0000,,Оонибана
Dialogue: 0,0:10:33.00,0:10:36.00,Default,,0000,0000,0000,,Бұл үлкен жын гүлінің тұқымы.
Dialogue: 0,0:10:36.00,0:10:37.97,Default,,0000,0000,0000,,Э? Хмм?
Dialogue: 0,0:10:41.01,0:10:45.01,Default,,0000,0000,0000,,Бұл мен ойлағаннан басқаша болды...
Dialogue: 0,0:10:45.01,0:10:48.01,Default,,0000,0000,0000,,
Dialogue: 0,0:10:45.01,0:10:48.01,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:10:48.01,0:10:50.02,Default,,0000,0000,0000,,Сонда қайда бара жатырсың?
Dialogue: 0,0:10:50.02,0:10:55.02,Default,,0000,0000,0000,,Ол сол бағытта.
Dialogue: 0,0:10:50.02,0:10:55.02,Default,,0000,0000,0000,,Айина~.
Dialogue: 0,0:10:55.02,0:10:56.69,Default,,0000,0000,0000,,Ммм.
Dialogue: 0,0:10:56.69,0:10:59.03,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:10:56.69,0:10:59.03,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:10:59.03,0:11:04.03,Default,,0000,0000,0000,,Күткеніңізге рахмет!
Dialogue: 0,0:10:59.03,0:11:04.03,Default,,0000,0000,0000,,Баратын жер - сіздің таңдауыңыз! ➡
Dialogue: 0,0:11:04.03,0:11:09.00,Default,,0000,0000,0000,,Келіңіздер, бәріңіз.
Dialogue: 0,0:11:04.03,0:11:09.00,Default,,0000,0000,0000,,Орынға отырыңыз!
Dialogue: 0,0:11:11.04,0:11:15.04,Default,,0000,0000,0000,,О, Құдай-ай, сен қатты жалықтырасың!
Dialogue: 0,0:11:11.04,0:11:15.04,Default,,0000,0000,0000,,Бұл қалай жұмыс істейді?
Dialogue: 0,0:11:15.04,0:11:20.05,Default,,0000,0000,0000,,Арттағы кішкентай балалар
Dialogue: 0,0:11:15.04,0:11:20.05,Default,,0000,0000,0000,,Алдыңыздағы ағаға жабысыңыз.
Dialogue: 0,0:11:20.05,0:11:23.05,Default,,0000,0000,0000,,Басыңызды қаттырақ иіңіз!
Dialogue: 0,0:11:20.05,0:11:23.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:23.05,0:11:28.02,Default,,0000,0000,0000,,Енді құйрықты шешіп алайық.
Dialogue: 0,0:11:23.05,0:11:28.02,Default,,0000,0000,0000,,Мықтап ұстаңыз!
Dialogue: 0,0:11:29.72,0:11:31.32,Default,,0000,0000,0000,,5…. ➡
Dialogue: 0,0:11:31.32,0:11:32.99,Default,,0000,0000,0000,,4….
Dialogue: 0,0:11:31.32,0:11:32.99,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:11:32.99,0:11:36.00,Default,,0000,0000,0000,,3 2 1…. ➡
Dialogue: 0,0:11:36.00,0:11:38.00,Default,,0000,0000,0000,,Іске қосу~!
Dialogue: 0,0:11:38.00,0:11:40.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:40.00,0:11:42.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:42.00,0:11:44.00,Default,,0000,0000,0000,,Қош келдіңіз!
Dialogue: 0,0:11:44.00,0:11:48.01,Default,,0000,0000,0000,,Ахххххх...!
Dialogue: 0,0:11:44.00,0:11:48.01,Default,,0000,0000,0000,,Керемет жылдамдық!
Dialogue: 0,0:11:48.01,0:11:49.68,Default,,0000,0000,0000,,Мықтап ұстаңыз.
Dialogue: 0,0:11:49.68,0:11:52.01,Default,,0000,0000,0000,,Мм! Фуфуфу….
Dialogue: 0,0:11:52.01,0:11:53.98,Default,,0000,0000,0000,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:11:56.02,0:12:00.02,Default,,0000,0000,0000,,Уау, өте жақсы!
Dialogue: 0,0:12:00.02,0:12:01.99,Default,,0000,0000,0000,,Бұл сергітеді.
Dialogue: 0,0:12:04.02,0:12:08.03,Default,,0000,0000,0000,,Глорио мырза
Dialogue: 0,0:12:04.02,0:12:08.03,Default,,0000,0000,0000,,Сіз көлікті қалай басқарасыз?
Dialogue: 0,0:12:08.03,0:12:11.03,Default,,0000,0000,0000,,Орындалмады.
Dialogue: 0,0:12:08.03,0:12:11.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:11.03,0:12:13.03,Default,,0000,0000,0000,,Бұл ұшатын тұқымдар ғана.
Dialogue: 0,0:12:13.03,0:12:18.04,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:12:13.03,0:12:18.04,Default,,0000,0000,0000,,Шынымен осылай құлай ма? ?
Dialogue: 0,0:12:18.04,0:12:21.71,Default,,0000,0000,0000,,Иә. Сондықтан ол жерге тигенге дейін
Dialogue: 0,0:12:18.04,0:12:21.71,Default,,0000,0000,0000,,Шығу.
Dialogue: 0,0:12:21.71,0:12:24.04,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:12:24.04,0:12:25.71,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:25.71,0:12:28.05,Default,,0000,0000,0000,,Міне, құлдырай бастады.
Dialogue: 0,0:12:28.05,0:12:30.98,Default,,0000,0000,0000,,Қараңғылық теңізіне түссең, құтқарылмайсың.
Dialogue: 0,0:12:28.05,0:12:30.98,Default,,0000,0000,0000,,Абайлаңыз!
Dialogue: 0,0:12:30.98,0:12:33.99,Default,,0000,0000,0000,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:12:33.99,0:12:35.65,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:12:35.65,0:12:38.99,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:12:35.65,0:12:38.99,Default,,0000,0000,0000,,Хаха!
Dialogue: 0,0:12:38.99,0:12:40.96,Default,,0000,0000,0000,,Қазір! Құтылып кету!
Dialogue: 0,0:12:43.00,0:12:46.97,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:43.00,0:12:46.97,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:07.02,0:13:11.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:07.02,0:13:11.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:16.03,0:13:18.03,Default,,0000,0000,0000,,О.
Dialogue: 0,0:13:18.03,0:13:22.03,Default,,0000,0000,0000,,
Dialogue: 0,0:13:18.03,0:13:22.03,Default,,0000,0000,0000,,Міне, мен біршама қашықтыққа жеттім.
Dialogue: 0,0:13:22.03,0:13:25.04,Default,,0000,0000,0000,,Қамалға дейін
Dialogue: 0,0:13:22.03,0:13:25.04,Default,,0000,0000,0000,,Қанша уақыт қалды?
Dialogue: 0,0:13:25.04,0:13:29.04,Default,,0000,0000,0000,,Жарты күн жүрсек жететін сияқтымыз.
Dialogue: 0,0:13:25.04,0:13:29.04,Default,,0000,0000,0000,,Жарты күн?
Dialogue: 0,0:13:29.04,0:13:33.98,Default,,0000,0000,0000,,Аспанда ұшайық.
Dialogue: 0,0:13:29.04,0:13:33.98,Default,,0000,0000,0000,,Шыдамыңыз таусылғанда➡
Dialogue: 0,0:13:33.98,0:13:38.98,Default,,0000,0000,0000,,Мен бұрын сатып алған қайта тірілу қатесі.
Dialogue: 0,0:13:33.98,0:13:38.98,Default,,0000,0000,0000,,Жай ғана жеп қойыңыз.
Dialogue: 0,0:13:38.98,0:13:41.99,Default,,0000,0000,0000,,Мен аздап қатемін...
Dialogue: 0,0:13:41.99,0:13:44.99,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:13:44.99,0:13:47.99,Default,,0000,0000,0000,,Мен шөлдеп тұрмын.
Dialogue: 0,0:13:47.99,0:13:51.00,Default,,0000,0000,0000,,Осында келмес бұрын➡
Dialogue: 0,0:13:51.00,0:13:55.00,Default,,0000,0000,0000,,Пикколо – Ұлы Жындар әлемінің Айдаһар шары.
Dialogue: 0,0:13:51.00,0:13:55.00,Default,,0000,0000,0000,,Сен мұны айтпадың ба?
Dialogue: 0,0:13:55.00,0:13:58.00,Default,,0000,0000,0000,,Бұл рас па? Мұнда да.
Dialogue: 0,0:13:58.00,0:14:03.01,Default,,0000,0000,0000,,О, әрине.
Dialogue: 0,0:13:58.00,0:14:03.01,Default,,0000,0000,0000,,Иә~ Шынайы ма?
Dialogue: 0,0:14:03.01,0:14:07.01,Default,,0000,0000,0000,,Керісінше, Ұлы Жындар әлемінің Айдаһар шарлары
Dialogue: 0,0:14:03.01,0:14:07.01,Default,,0000,0000,0000,,Оны түпнұсқа деп атауға болады.
Dialogue: 0,0:14:07.01,0:14:10.02,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:14:07.01,0:14:10.02,Default,,0000,0000,0000,,Мұнда қалай іздеуге болады?
Dialogue: 0,0:14:10.02,0:14:16.02,Default,,0000,0000,0000,,Іздеу? Іздеудің қажеті жоқ.
Dialogue: 0,0:14:10.02,0:14:16.02,Default,,0000,0000,0000,,Белгілі бір жер белгілі.
Dialogue: 0,0:14:16.02,0:14:19.02,Default,,0000,0000,0000,,Түсіндің бе? Не айтқың келеді?
Dialogue: 0,0:14:19.02,0:14:24.03,Default,,0000,0000,0000,,Ұлы жын әлемінде үш жын әлемі бар.
Dialogue: 0,0:14:19.02,0:14:24.03,Default,,0000,0000,0000,,Бұл үшінші жын әлемі. ➡
Dialogue: 0,0:14:24.03,0:14:27.03,Default,,0000,0000,0000,,Әрбір жын әлемінде
Dialogue: 0,0:14:24.03,0:14:27.03,Default,,0000,0000,0000,,Белгіленген жерде➡
Dialogue: 0,0:14:27.03,0:14:30.04,Default,,0000,0000,0000,,Айдаһар добы
Dialogue: 0,0:14:27.03,0:14:30.04,Default,,0000,0000,0000,,Әрқайсысы бір. ➡
Dialogue: 0,0:14:30.04,0:14:31.97,Default,,0000,0000,0000,,Сонымен, сен сол аралда не істеп жүрдің?
Dialogue: 0,0:14:30.04,0:14:31.97,Default,,0000,0000,0000,,Оны Тамагами деген жауынгер күзетеді.
Dialogue: 0,0:14:31.97,0:14:33.97,Default,,0000,0000,0000,,Тамагами….
Dialogue: 0,0:14:33.97,0:14:37.98,Default,,0000,0000,0000,,Басқаша айтқанда, сол балғамидан
Dialogue: 0,0:14:33.97,0:14:37.98,Default,,0000,0000,0000,,Жай ғана допты алып кет, солай ма?
Dialogue: 0,0:14:37.98,0:14:42.98,Default,,0000,0000,0000,,Ах. Бірақ бұл оңай емес.
Dialogue: 0,0:14:37.98,0:14:42.98,Default,,0000,0000,0000,,Тамагами өте күшті.
Dialogue: 0,0:14:42.98,0:14:44.98,Default,,0000,0000,0000,,Бұл шынымен де соншалықты күшті ме?
Dialogue: 0,0:14:44.98,0:14:49.99,Default,,0000,0000,0000,,Ах. Күресіп, жеңіске жетпесек
Dialogue: 0,0:14:44.98,0:14:49.99,Default,,0000,0000,0000,,Сіз допты ала алмайсыз.
Dialogue: 0,0:14:49.99,0:14:51.99,Default,,0000,0000,0000,,Егер сіз мұны үш рет жасамасаңыз➡
Dialogue: 0,0:14:51.99,0:14:56.00,Default,,0000,0000,0000,,Тілек қабылданбайды...
Dialogue: 0,0:14:51.99,0:14:56.00,Default,,0000,0000,0000,,дейсіз бе?
Dialogue: 0,0:14:56.00,0:14:58.00,Default,,0000,0000,0000,,Осымен.
Dialogue: 0,0:14:58.00,0:15:01.00,Default,,0000,0000,0000,,Айдаһар добы осында
Dialogue: 0,0:14:58.00,0:15:01.00,Default,,0000,0000,0000,,Маған тек 3 дана жинау керек пе?
Dialogue: 0,0:15:01.00,0:15:03.00,Default,,0000,0000,0000,,Өте қызықты көрінеді!
Dialogue: 0,0:15:03.00,0:15:07.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:15:03.00,0:15:07.01,Default,,0000,0000,0000,,Айдаһар шарларын жинаңыз!
Dialogue: 0,0:15:07.01,0:15:08.67,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:15:08.67,0:15:13.01,Default,,0000,0000,0000,,Менің білуімше, үшеуін жинап ал
Dialogue: 0,0:15:08.67,0:15:13.01,Default,,0000,0000,0000,,Тілегін орындаған адам➡
Dialogue: 0,0:15:13.01,0:15:15.01,Default,,0000,0000,0000,,Осы уақытқа дейін ешкім болған жоқ.
Dialogue: 0,0:15:15.01,0:15:18.02,Default,,0000,0000,0000,,Осындай нәрсені естігенде
Dialogue: 0,0:15:15.01,0:15:18.02,Default,,0000,0000,0000,,Барған сайын күйіп бара жатырмын!
Dialogue: 0,0:15:18.02,0:15:21.02,Default,,0000,0000,0000,,Жоқ, Гоку-сан.
Dialogue: 0,0:15:18.02,0:15:21.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:21.02,0:15:23.99,Default,,0000,0000,0000,,Денде мырзаны құтқару үшін
Dialogue: 0,0:15:21.02,0:15:23.99,Default,,0000,0000,0000,,Бұл бірінші шешім.
Dialogue: 0,0:15:26.03,0:15:28.03,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:15:28.03,0:15:32.03,Default,,0000,0000,0000,,Эй, әлгі Тамагами заты.
Dialogue: 0,0:15:28.03,0:15:32.03,Default,,0000,0000,0000,,Бұл алыс па?
Dialogue: 0,0:15:32.03,0:15:36.04,Default,,0000,0000,0000,,Варп-сама келді.
Dialogue: 0,0:15:32.03,0:15:36.04,Default,,0000,0000,0000,,Бұл мүлдем керісінше.
Dialogue: 0,0:15:36.04,0:15:39.04,Default,,0000,0000,0000,,Дәл керісінше! ? Бұл тым алыс.
Dialogue: 0,0:15:39.04,0:15:44.04,Default,,0000,0000,0000,,Мүмкін солай шығар...
Dialogue: 0,0:15:39.04,0:15:44.04,Default,,0000,0000,0000,,Денде➡ көмектесіп жатқанда
Dialogue: 0,0:15:44.04,0:15:47.05,Default,,0000,0000,0000,,Айдаһар шарларын жинаңыз
Dialogue: 0,0:15:44.04,0:15:47.05,Default,,0000,0000,0000,,Тілегің орындалса➡
Dialogue: 0,0:15:47.05,0:15:49.05,Default,,0000,0000,0000,,Орас
Dialogue: 0,0:15:47.05,0:15:49.05,Default,,0000,0000,0000,,Сіз ересек адамға қайта орала аласыз, солай ма?
Dialogue: 0,0:15:49.05,0:15:52.05,Default,,0000,0000,0000,,Бұл рас...
Dialogue: 0,0:15:52.05,0:15:55.72,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:15:52.05,0:15:55.72,Default,,0000,0000,0000,,Мүмкін сіз оны байқап көре аласыз.
Dialogue: 0,0:15:55.72,0:15:58.06,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:58.06,0:16:01.06,Default,,0000,0000,0000,,Егер сол жігіт Дендеге қоңырау шалса
Dialogue: 0,0:15:58.06,0:16:01.06,Default,,0000,0000,0000,,Өлтіру➡
Dialogue: 0,0:16:01.06,0:16:04.06,Default,,0000,0000,0000,,Егер табылмаса
Dialogue: 0,0:16:01.06,0:16:04.06,Default,,0000,0000,0000,,Егер мен бұны қазір айтпасам, кейін қарама-қайшылықтар туындауы мүмкін.
Dialogue: 0,0:16:04.06,0:16:07.07,Default,,0000,0000,0000,,Мұнда Айдаһар допында
Dialogue: 0,0:16:04.06,0:16:07.07,Default,,0000,0000,0000,,Тілегің орындалса➡
Dialogue: 0,0:16:07.07,0:16:10.07,Default,,0000,0000,0000,,Денде сақталады.
Dialogue: 0,0:16:07.07,0:16:10.07,Default,,0000,0000,0000,,Жердегі Айдаһар шарында ➡
Dialogue: 0,0:16:10.07,0:16:12.07,Default,,0000,0000,0000,,Сіз де
Dialogue: 0,0:16:10.07,0:16:12.07,Default,,0000,0000,0000,,Бастапқы пішінге оралуға болады.
Dialogue: 0,0:16:12.07,0:16:14.07,Default,,0000,0000,0000,,Дұрыс! Жаса, істе, істе!
Dialogue: 0,0:16:14.07,0:16:17.04,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:22.08,0:16:24.08,Default,,0000,0000,0000,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:16:24.08,0:16:27.05,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:16:29.09,0:16:31.02,Default,,0000,0000,0000,,О!
Dialogue: 0,0:16:31.02,0:16:36.03,Default,,0000,0000,0000,,Ах! Мен келесі қаланы көремін!
Dialogue: 0,0:16:31.02,0:16:36.03,Default,,0000,0000,0000,,Ақырында су ішуге болады!
Dialogue: 0,0:16:36.03,0:16:40.03,Default,,0000,0000,0000,,Менің де қарным ашты!
Dialogue: 0,0:16:36.03,0:16:40.03,Default,,0000,0000,0000,,Мен біраз демалғым келеді.
Dialogue: 0,0:16:40.03,0:16:43.04,Default,,0000,0000,0000,,О, су!
Dialogue: 0,0:16:43.04,0:16:45.04,Default,,0000,0000,0000,,Олар Жапонияда, анамды күтіп, оны қауіпсіз ұстап отыр ➡
Dialogue: 0,0:16:45.04,0:16:47.04,Default,,0000,0000,0000,,Әй, Гоку-сан!
Dialogue: 0,0:16:47.04,0:16:50.04,Default,,0000,0000,0000,,(ішу дыбысы)
Dialogue: 0,0:16:50.04,0:16:53.05,Default,,0000,0000,0000,,Мұнда су жақсы ма?
Dialogue: 0,0:16:53.05,0:16:55.05,Default,,0000,0000,0000,,Мүмкін.
Dialogue: 0,0:16:55.05,0:16:58.02,Default,,0000,0000,0000,,Пуха! Ха!
Dialogue: 0,0:17:03.06,0:17:07.06,Default,,0000,0000,0000,,(Жындардың сөйлейтін дауыстары)
Dialogue: 0,0:17:07.06,0:17:11.06,Default,,0000,0000,0000,,(Танжиро) Толық шоғырланған тыныс алуды сақтай отырып жаттығу енді екінші табиғатқа айнала бастады.
Dialogue: 0,0:17:07.06,0:17:11.06,Default,,0000,0000,0000,,Бағана. ➡
Dialogue: 0,0:17:11.06,0:17:14.07,Default,,0000,0000,0000,,(Жындардың сөйлейтін дауыстары)
Dialogue: 0,0:17:14.07,0:17:18.07,Default,,0000,0000,0000,,Цк. Бұл әскери полиция.
Dialogue: 0,0:17:14.07,0:17:18.07,Default,,0000,0000,0000,,Әскери полиция?
Dialogue: 0,0:17:18.07,0:17:20.07,Default,,0000,0000,0000,,Ол Ұлы жын патшаның тікелей қолбасшылығында тұрған полиция қызметкері.
Dialogue: 0,0:17:20.07,0:17:24.08,Default,,0000,0000,0000,,Осыдан
Dialogue: 0,0:17:20.07,0:17:24.08,Default,,0000,0000,0000,,Биылғы құрбандықты жинаңыз.
Dialogue: 0,0:17:24.08,0:17:27.08,Default,,0000,0000,0000,,
Dialogue: 0,0:17:27.08,0:17:29.05,Default,,0000,0000,0000,,Мүмкін мен де байқап көрермін.
Dialogue: 0,0:17:31.02,0:17:33.02,Default,,0000,0000,0000,,(Әскери полиция)
Dialogue: 0,0:17:31.02,0:17:33.02,Default,,0000,0000,0000,,Менің ойымша, сіз білесіз➡
Dialogue: 0,0:17:33.02,0:17:38.02,Default,,0000,0000,0000,,Келесі күні мен Даймау Дабураны ауыстырдым.
Dialogue: 0,0:17:33.02,0:17:38.02,Default,,0000,0000,0000,,Лорд Гомер Ұлы жын патшасы болды. ➡
Dialogue: 0,0:17:38.02,0:17:43.03,Default,,0000,0000,0000,,Король Гомер, өзінің барлық бұрынғы құрбандықтарында.
Dialogue: 0,0:17:38.02,0:17:43.03,Default,,0000,0000,0000,,Сіз бұл өте жұмсақ деп ойлайсыз.
Dialogue: 0,0:17:43.03,0:17:46.03,Default,,0000,0000,0000,,Сондықтан қазірден бастап құрбандық ➡ болады
Dialogue: 0,0:17:46.03,0:17:48.03,Default,,0000,0000,0000,,Енді сізде 3 алтын тиын бар!
Dialogue: 0,0:17:48.03,0:17:51.04,Default,,0000,0000,0000,,Үш бөлік! ?
Dialogue: 0,0:17:48.03,0:17:51.04,Default,,0000,0000,0000,,Бұл мүмкін емес!
Dialogue: 0,0:17:51.04,0:17:56.04,Default,,0000,0000,0000,,Алтын теңге төлей алмайтын жалқауларға
Dialogue: 0,0:17:51.04,0:17:56.04,Default,,0000,0000,0000,,Әрбір шығарма сізге 3 жыл өмір береді. ➡
Dialogue: 0,0:17:56.04,0:18:02.05,Default,,0000,0000,0000,,Басқаша айтқанда, тіпті біреуін төлей алмайтындар үшін
Dialogue: 0,0:17:56.04,0:18:02.05,Default,,0000,0000,0000,,9 жыл өмірінің ақысы төленеді. Жақсы ма?
Dialogue: 0,0:18:02.05,0:18:05.05,Default,,0000,0000,0000,,Эй... бұл өте жаман.
Dialogue: 0,0:18:05.05,0:18:07.05,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:18:07.05,0:18:11.06,Default,,0000,0000,0000,,Түсінесіз деп ойлаймын.
Dialogue: 0,0:18:07.05,0:18:11.06,Default,,0000,0000,0000,,Қашқаннан пайда жоқ.
Dialogue: 0,0:18:11.06,0:18:16.06,Default,,0000,0000,0000,,Барлығына тағылған сиқырлы жағалар
Dialogue: 0,0:18:11.06,0:18:16.06,Default,,0000,0000,0000,,Оны міндетті түрде табыңыз!
Dialogue: 0,0:18:16.06,0:18:18.06,Default,,0000,0000,0000,,Уау! Мен білдім... ➡
Dialogue: 0,0:18:18.06,0:18:20.07,Default,,0000,0000,0000,,Ааа... Уау... ➡
Dialogue: 0,0:18:20.07,0:18:23.07,Default,,0000,0000,0000,,Ах! Ахх...
Dialogue: 0,0:18:23.07,0:18:27.07,Default,,0000,0000,0000,,Хун. Егер сіз қашып кетсеңіз
Dialogue: 0,0:18:23.07,0:18:27.07,Default,,0000,0000,0000,,Сонымен қатар, 10 жыл өмір сүру ұзақтығы қосылады. ➡
Dialogue: 0,0:18:27.07,0:18:29.07,Default,,0000,0000,0000,,Менікі де емес—
Dialogue: 0,0:18:29.07,0:18:31.01,Default,,0000,0000,0000,,Сұмдық... Мынау әбігер.
Dialogue: 0,0:18:31.01,0:18:33.01,Default,,0000,0000,0000,,Қандай адамдар тобыр.
Dialogue: 0,0:18:33.01,0:18:34.98,Default,,0000,0000,0000,,Жүр, тез шығар.
Dialogue: 0,0:18:37.02,0:18:38.98,Default,,0000,0000,0000,,Жарайды. Келесі.
Dialogue: 0,0:18:41.02,0:18:43.02,Default,,0000,0000,0000,,Әй, бұл жеткіліксіз.
Dialogue: 0,0:18:43.02,0:18:46.69,Default,,0000,0000,0000,,Менде осы ғана...
Dialogue: 0,0:18:43.02,0:18:46.69,Default,,0000,0000,0000,,Орындаңыз.
Dialogue: 0,0:18:46.69,0:18:49.96,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:46.69,0:18:49.96,Default,,0000,0000,0000,,Келіңіздер.
Dialogue: 0,0:18:53.03,0:18:55.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:58.04,0:19:00.01,Default,,0000,0000,0000,,Ах! Ах!
Dialogue: 0,0:19:05.04,0:19:09.05,Default,,0000,0000,0000,,Цк. Жасырындар жігіттер...
Dialogue: 0,0:19:09.05,0:19:13.05,Default,,0000,0000,0000,,Мен сені үрлеймін бе?
Dialogue: 0,0:19:09.05,0:19:13.05,Default,,0000,0000,0000,,Алыста. Бұл әбігерге түседі.
Dialogue: 0,0:19:13.05,0:19:17.06,Default,,0000,0000,0000,,Өтінемін!
Dialogue: 0,0:19:13.05,0:19:17.06,Default,,0000,0000,0000,,Мені кешіріңіз, келесі жолы төлеймін!
Dialogue: 0,0:19:17.06,0:19:20.06,Default,,0000,0000,0000,,Өмірдің 9 жылын алып тастаса
Dialogue: 0,0:19:17.06,0:19:20.06,Default,,0000,0000,0000,,Өлуің мүмкін!
Dialogue: 0,0:19:20.06,0:19:24.06,Default,,0000,0000,0000,,Жоқ. Орындаңыз.
Dialogue: 0,0:19:24.06,0:19:27.07,Default,,0000,0000,0000,,Сәлем! Қарттарды қорламаңыз!
Dialogue: 0,0:19:27.07,0:19:28.73,Default,,0000,0000,0000,,Конняро Коньяро
Dialogue: 0,0:19:27.07,0:19:28.73,Default,,0000,0000,0000,,Конняро!
Dialogue: 0,0:19:28.73,0:19:30.67,Default,,0000,0000,0000,,Міне! Ата, ашуланбаңыз!
Dialogue: 0,0:19:30.67,0:19:33.01,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:19:33.01,0:19:35.01,Default,,0000,0000,0000,,⚟Ол үшін уайымдамаңыз.
Dialogue: 0,0:19:35.01,0:19:37.01,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:37.01,0:19:38.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:41.01,0:19:44.02,Default,,0000,0000,0000,,Не? сен.
Dialogue: 0,0:19:44.02,0:19:51.02,Default,,0000,0000,0000,,⚟Жаджан!
Dialogue: 0,0:19:44.02,0:19:51.02,Default,,0000,0000,0000,,Маған осы қолдан жасалған васаби бомбасын беріңіз! ➡
Dialogue: 0,0:19:51.02,0:19:53.03,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:19:53.03,0:19:54.99,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:19:59.03,0:20:01.03,Default,,0000,0000,0000,,(Жел дыбысы)
Dialogue: 0,0:20:01.03,0:20:02.70,Default,,0000,0000,0000,,⚟Ах!
Dialogue: 0,0:20:02.70,0:20:04.70,Default,,0000,0000,0000,,Мені ұстаңыз!
Dialogue: 0,0:20:04.70,0:20:08.04,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:20:04.70,0:20:08.04,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:08.04,0:20:11.04,Default,,0000,0000,0000,,⚟Ах! Жіберу! Сен бейбақ!
Dialogue: 0,0:20:11.04,0:20:13.01,Default,,0000,0000,0000,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:20:15.05,0:20:17.02,Default,,0000,0000,0000,,Жолдан кет!
Dialogue: 0,0:20:15.05,0:20:17.02,Default,,0000,0000,0000,,Бұл ыңғайсыздық!
Dialogue: 0,0:20:20.05,0:20:22.05,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:20:22.05,0:20:26.06,Default,,0000,0000,0000,,Сәлем! Тербелмеңіз!
Dialogue: 0,0:20:26.06,0:20:29.06,Default,,0000,0000,0000,,Мына бейбақ...
Dialogue: 0,0:20:29.06,0:20:32.00,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:20:29.06,0:20:32.00,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:20:32.00,0:20:33.67,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:20:33.67,0:20:35.67,Default,,0000,0000,0000,,Яаааа!
Dialogue: 0,0:20:35.67,0:20:39.00,Default,,0000,0000,0000,,О, құдайым...!
Dialogue: 0,0:20:35.67,0:20:39.00,Default,,0000,0000,0000,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:20:39.00,0:20:41.01,Default,,0000,0000,0000,,Уф! Апыр-ай!
Dialogue: 0,0:20:41.01,0:20:43.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:43.01,0:20:46.68,Default,,0000,0000,0000,,Арх! Арх! Уф...
Dialogue: 0,0:20:46.68,0:20:49.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:46.68,0:20:49.01,Default,,0000,0000,0000,,Тез жүр!
Dialogue: 0,0:20:49.01,0:20:51.02,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:20:51.02,0:20:52.68,Default,,0000,0000,0000,,Не болды!
Dialogue: 0,0:20:52.68,0:20:56.02,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:20:56.02,0:20:57.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:21:01.03,0:21:02.69,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:21:02.69,0:21:04.96,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:21:08.03,0:21:09.70,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:21:09.70,0:21:11.37,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:21:09.70,0:21:11.37,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:11.37,0:21:18.04,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:21:18.04,0:21:21.05,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:21:21.05,0:21:23.02,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:21:26.05,0:21:27.72,Default,,0000,0000,0000,,Тааааа~!
Dialogue: 0,0:21:27.72,0:21:30.06,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:30.06,0:21:32.99,Default,,0000,0000,0000,,Таа!
Dialogue: 0,0:21:32.99,0:21:34.66,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:34.66,0:21:37.00,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:21:37.00,0:21:39.00,Default,,0000,0000,0000,,Куаааа!
Dialogue: 0,0:21:39.00,0:21:41.00,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:21:39.00,0:21:41.00,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:21:41.00,0:21:42.97,Default,,0000,0000,0000,,Тааааа...!
Dialogue: 0,0:21:45.00,0:21:48.01,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:48.01,0:21:50.98,Default,,0000,0000,0000,,Иә? Уф….
Dialogue: 0,0:21:53.01,0:21:56.01,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:21:56.01,0:21:57.68,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:21:57.68,0:22:01.02,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:57.68,0:22:01.02,Default,,0000,0000,0000,,А... Мен тым алысқа кетіп қалдым.
Dialogue: 0,0:22:01.02,0:22:03.02,Default,,0000,0000,0000,,Сіз кімсіз? ?
Dialogue: 0,0:22:03.02,0:22:05.02,Default,,0000,0000,0000,,А... Хе...
Dialogue: 0,0:22:05.02,0:22:08.03,Default,,0000,0000,0000,,Тез осында кел.
Dialogue: 0,0:22:08.03,0:22:10.03,Default,,0000,0000,0000,,Асығыңыз.
Dialogue: 0,0:22:10.03,0:22:13.03,Default,,0000,0000,0000,,Жолдан кет! Эй!
Dialogue: 0,0:22:10.03,0:22:13.03,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:22:13.03,0:22:19.04,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:22:19.04,0:22:22.04,Default,,0000,0000,0000,,Енді сен
Dialogue: 0,0:22:19.04,0:22:22.04,Default,,0000,0000,0000,,Мен қуып жеттім.
Dialogue: 0,0:22:22.04,0:22:26.04,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:22:22.04,0:22:26.04,Default,,0000,0000,0000,,Сіз осындай нәрсені жалғыз қалдыра аласыз ба?
Dialogue: 0,0:22:26.04,0:22:29.01,Default,,0000,0000,0000,,Шынында да….
Dialogue: 0,0:22:26.04,0:22:29.01,Default,,0000,0000,0000,,⚟Сіз кімсіз?
Dialogue: 0,0:22:32.98,0:22:34.95,Default,,0000,0000,0000,,Аа, дәл алдында.
Dialogue: 0,0:22:50.00,0:22:59.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:01.48,0:23:07.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory