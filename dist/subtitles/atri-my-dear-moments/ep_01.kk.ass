Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.58,0:00:09.88,Default,,0,0,0,,Бұл... ауырады... ауырады
Dialogue: 0,0:00:15.43,0:00:18.85,Default,,0,0,0,,Маған көмектесіңізші... Суық...
Dialogue: 0,0:00:24.85,0:00:27.86,Default,,0,0,0,,Маған ұнамайды...ұнамайды
Dialogue: 0,0:00:29.11,0:00:31.69,Default,,0,0,0,,Қарғыс атсын... Арх!
Dialogue: 0,0:00:31.78,0:00:32.61,Default,,0,0,0,,Гррр…
Dialogue: 0,0:00:33.74,0:00:35.70,Default,,0,0,0,,Қап! Қат!
Dialogue: 0,0:00:35.78,0:00:37.12,Default,,0,0,0,,(Ананың күбірлеуі)
Dialogue: 0,0:00:37.20,0:00:38.37,Default,,0,0,0,,Ана?
Dialogue: 0,0:00:38.45,0:00:42.08,Default,,0,0,0,,(Ананың күбірлеуі)
Dialogue: 0,0:00:42.16,0:00:42.87,Default,,0,0,0,,Ана...
Dialogue: 0,0:00:44.46,0:00:45.46,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:46.92,0:00:50.59,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:00:52.26,0:00:53.42,Default,,0,0,0,,Тағы да...
Dialogue: 0,0:00:53.51,0:00:54.88,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:00:55.97,0:00:57.72,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:00:59.43,0:01:02.22,Default,,0,0,0,,Соншалықты қорқынышты көрінбе.
Dialogue: 0,0:01:04.60,0:01:08.27,Default,,0,0,0,,Мен саған миллионерлерге билет әкелдім.
Dialogue: 0,0:01:10.32,0:01:13.82,Default,,0,0,0,,Бұл ыңғайсыздық. Мұндай түстерді қолдануға тырысудың пайдасы жоқ.
Dialogue: 0,0:01:13.90,0:01:16.11,Default,,0,0,0,,Қазір ересек адам сияқты әрекет етіңіз
Dialogue: 0,0:01:16.86,0:01:19.82,Default,,0,0,0,,Бұл жолы жақсы болады
Dialogue: 0,0:01:19.91,0:01:21.20,Default,,0,0,0,,Сенімді дереккөзден
Dialogue: 0,0:01:21.28,0:01:24.16,Default,,0,0,0,,Олар бұл жұмыс істейтін зат екенін айтып, маған сатты.
Dialogue: 0,0:01:24.25,0:01:26.58,Default,,0,0,0,,Осылай деп қанша рет алдандым?
Dialogue: 0,0:01:30.42,0:01:32.63,Default,,0,0,0,,Дұрыс өмір сүрсең, жаман өлмейсің.
Dialogue: 0,0:01:32.71,0:01:34.88,Default,,0,0,0,,Тек көріңіз!
Dialogue: 0,0:01:34.96,0:01:36.84,Default,,0,0,0,,Бір Чан-Бір Чан
Dialogue: 0,0:01:37.34,0:01:38.18,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:01:40.30,0:01:43.22,Default,,0,0,0,,Бұл әзірге ең жақсысы.
Dialogue: 0,0:01:43.31,0:01:45.02,Default,,0,0,0,,солай емес пе? Хи хи
Dialogue: 0,0:01:47.06,0:01:48.90,Default,,0,0,0,,Мен мүмкіндігінше тырысуым керек пе?
Dialogue: 0,0:01:53.53,0:01:56.11,Default,,0,0,0,,Менің бәрібір басқа шаруам жоқ.
Dialogue: 0,0:02:00.20,0:02:01.87,Default,,0,0,0,,Осындай әлемде
Dialogue: 0,0:02:15.05,0:02:17.76,Default,,0,0,0,,Жаңа ауқымды энергиямен жабдықтау көзі ретінде
Dialogue: 0,0:02:17.84,0:02:20.22,Default,,0,0,0,,Күтілетін Amaterasu жобасы
Dialogue: 0,0:02:20.30,0:02:22.26,Default,,0,0,0,,Бірінші қадам ретінде
Dialogue: 0,0:02:22.35,0:02:25.85,Default,,0,0,0,,Бұл ұзақ уақыт бойы жоспарланған зымыран ұшыру.
Dialogue: 0,0:02:25.93,0:02:28.18,Default,,0,0,0,,Азаматтардың қарсылық үні де күшті...
Dialogue: 0,0:02:28.27,0:02:30.23,Default,,0,0,0,,Осы жолы ұшатын шығармын ба деп
Dialogue: 0,0:02:30.31,0:02:31.56,Default,,0,0,0,,Ұшу
Dialogue: 0,0:02:32.11,0:02:35.57,Default,,0,0,0,,Бірақ егер сіз отшашуды жағуға мүмкіндігіңіз болса
Dialogue: 0,0:02:35.65,0:02:38.99,Default,,0,0,0,,Бұл біздің өміріміз туралы бірдеңе жасау емес пе?
Dialogue: 0,0:02:40.16,0:02:42.87,Default,,0,0,0,,Егер сіз қазірден өтсеңіз де, ақыры банкротқа ұшырайсыз.
Dialogue: 0,0:02:43.41,0:02:45.16,Default,,0,0,0,,Біз болашақты құруымыз керек
Dialogue: 0,0:02:45.24,0:02:47.58,Default,,0,0,0,,Ол шынымен де тозған.
Dialogue: 0,0:02:47.66,0:02:49.62,Default,,0,0,0,,Сіз шынымен осылай сүңгій аласыз ба?
Dialogue: 0,0:02:49.71,0:02:51.71,Default,,0,0,0,,Сізге сүңгуді айтқан кемпір еді.
Dialogue: 0,0:02:51.79,0:02:53.13,Default,,0,0,0,,«Кэтрин»!
Dialogue: 0,0:02:53.21,0:02:55.63,Default,,0,0,0,,Келесіде мен сені теңізге батырамын!
Dialogue: 0,0:02:56.21,0:02:58.76,Default,,0,0,0,,Біріншіден, тіпті Екатерина да жалған есім.
Dialogue: 0,0:02:58.84,0:03:00.13,Default,,0,0,0,,Бұл ұқсас емес пе?
Dialogue: 0,0:03:00.22,0:03:01.38,Default,,0,0,0,,Шулы!
Dialogue: 0,0:03:01.47,0:03:03.72,Default,,0,0,0,,Адамдарда әртүрлі жағдайлар болады.
Dialogue: 0,0:03:03.80,0:03:05.51,Default,,0,0,0,,Нацу!
Dialogue: 0,0:03:05.60,0:03:06.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:06.26,0:03:09.98,Default,,0,0,0,,(Мо Мизунаның ауыр тыныс алуы)
Dialogue: 0,0:03:10.77,0:03:12.98,Default,,0,0,0,,Нацу-кун, мектепке барайық
Dialogue: 0,0:03:15.27,0:03:16.23,Default,,0,0,0,,Мен сізге қоңырау шалып тұрмын
Dialogue: 0,0:03:16.32,0:03:18.65,Default,,0,0,0,,Егер сіз оны жалғыз қалдырсаңыз, сіз ақыры бас тартасыз
Dialogue: 0,0:03:18.74,0:03:22.61,Default,,0,0,0,,Сізді тастап кетті. Бас тарту - махаббаттың кілті.
Dialogue: 0,0:03:23.11,0:03:25.12,Default,,0,0,0,,Ал... олай емес!
Dialogue: 0,0:03:25.20,0:03:27.29,Default,,0,0,0,,Ммм~
Dialogue: 0,0:03:28.37,0:03:31.41,Default,,0,0,0,,Мен сізді өзіңізді көрсетуді тоқтатты деп ойладым.
Dialogue: 0,0:03:31.50,0:03:34.17,Default,,0,0,0,,Мен оба құдайы сияқты сөйлеме.
Dialogue: 0,0:03:34.67,0:03:38.30,Default,,0,0,0,,Мен бұл Нацуо Икаруганың серіктесімін.
Dialogue: 0,0:03:38.38,0:03:40.51,Default,,0,0,0,,- (Мо Мизуна) Иә! серіктес? -Аа
Dialogue: 0,0:03:40.59,0:03:42.47,Default,,0,0,0,,Кездейсоқ нәрселерді айтпаңыз
Dialogue: 0,0:03:42.55,0:03:44.93,Default,,0,0,0,,Ол күдікті оқиға әкелген шарлатан.
Dialogue: 0,0:03:45.01,0:03:46.47,Default,,0,0,0,,Күдікті емес!
Dialogue: 0,0:03:46.55,0:03:48.93,Default,,0,0,0,,Әжеңнің үйінде қазына жасырылған.
Dialogue: 0,0:03:49.02,0:03:50.85,Default,,0,0,0,,Бұл сөзсіз ақпарат!
Dialogue: 0,0:03:50.93,0:03:53.10,Default,,0,0,0,,Нацукунның әжесі?
Dialogue: 0,0:03:53.19,0:03:55.27,Default,,0,0,0,,... Сіз қандай да бір ғалымсыз ба?
Dialogue: 0,0:03:55.36,0:03:58.40,Default,,0,0,0,,Доктор Ноко Ячигуса, теңіз геологы.
Dialogue: 0,0:03:58.90,0:04:01.49,Default,,0,0,0,,Кемпірдің үйінде жасырылған қазына
Dialogue: 0,0:04:01.57,0:04:05.28,Default,,0,0,0,,Мына жігіт оны жинап, қадаларға бөлмекші.
Dialogue: 0,0:04:05.37,0:04:07.08,Default,,0,0,0,,Хмм... күдікті.
Dialogue: 0,0:04:07.16,0:04:08.20,Default,,0,0,0,,Бағдарлама коды…
Dialogue: 0,0:04:08.28,0:04:10.25,Default,,0,0,0,,Сіз оны... арқылы жасадыңыз ба?
Dialogue: 0,0:04:10.33,0:04:13.71,Default,,0,0,0,,Аа, бұрынғы бөлшектерде ақау болмаса.
Dialogue: 0,0:04:14.83,0:04:16.29,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:16.38,0:04:19.71,Default,,0,0,0,,Жарайды... күте тұрыңыз, мұнымен теңізге түсесіз бе?
Dialogue: 0,0:04:19.80,0:04:20.38,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:20.46,0:04:24.34,Default,,0,0,0,,Тоқтау керек, «өміріңді бағала»
Dialogue: 0,0:04:24.43,0:04:26.01,Default,,0,0,0,,Араламаңыз
Dialogue: 0,0:04:26.09,0:04:29.97,Default,,0,0,0,,Мына бала екеумізге ақша қандай болса да керек.
Dialogue: 0,0:04:30.06,0:04:32.14,Default,,0,0,0,,Мұндай әлемде қалай өмір сүруге болады?
Dialogue: 0,0:04:35.81,0:04:37.65,Default,,0,0,0,,Сол қол
Dialogue: 0,0:04:37.73,0:04:40.78,Default,,0,0,0,,Қазынаны тапқан сәтте «Еңбегіңіз үшін рахмет» деп айтыңыз.
Dialogue: 0,0:04:40.86,0:04:43.24,Default,,0,0,0,,Нацу-кун, сені теңізге лақтырмайсың ба?
Dialogue: 0,0:04:43.32,0:04:44.28,Default,,0,0,0,,Мен осындамын, мама
Dialogue: 0,0:04:44.36,0:04:47.87,Default,,0,0,0,,«Мүмкін»… Тіпті қолайлы емес нәрселерді айтпаңыз.
Dialogue: 0,0:04:48.49,0:04:50.99,Default,,0,0,0,,Сонда менімен Мо Мизуна келе ме?
Dialogue: 0,0:04:51.08,0:04:51.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:52.70,0:04:55.96,Default,,0,0,0,,Бұл жігіттің теңізге сүңгігеніне бірнеше жыл болды.
Dialogue: 0,0:04:56.54,0:04:58.29,Default,,0,0,0,,Мен тағы бірнеше қол алғым келеді.
Dialogue: 0,0:05:00.09,0:05:01.34,Default,,0,0,0,,Бұл жасырын
Dialogue: 0,0:05:02.21,0:05:03.09,Default,,0,0,0,,Не?
Dialogue: 0,0:05:04.59,0:05:05.72,Default,,0,0,0,,Бөлек
Dialogue: 0,0:05:07.89,0:05:11.18,Default,,0,0,0,,Дүниежүзілік масштабта болатын теңіз деңгейінің жылдам көтерілуі
Dialogue: 0,0:05:11.72,0:05:15.27,Default,,0,0,0,,Төменгі жағалаудағы қалалар теңізге батып кетті.
Dialogue: 0,0:05:15.77,0:05:17.27,Default,,0,0,0,,Себеп белгісіз
Dialogue: 0,0:05:17.35,0:05:20.02,Default,,0,0,0,,Жаһандық жылынуға байланысты теңіз суының кеңеюі
Dialogue: 0,0:05:20.11,0:05:22.78,Default,,0,0,0,,Жер қыртысының деформациясы әсерінен теңіз түбінің ультра үлкен сілкінісі және т.б.
Dialogue: 0,0:05:23.53,0:05:27.36,Default,,0,0,0,,Бірнеше теориялар бар, бірақ әлі нақты ештеңе жоқ.
Dialogue: 0,0:05:27.45,0:05:30.62,Default,,0,0,0,,Су деңгейі көтерілгеннен кейін ол бұрынғы қалпына келмейді.
Dialogue: 0,0:05:30.70,0:05:33.33,Default,,0,0,0,,Көптеген қалалар мен инфрақұрылым жоғалды.
Dialogue: 0,0:05:33.41,0:05:37.12,Default,,0,0,0,,Қазірдің өзінде ол жерді ақырын жұтып қоя береді.
Dialogue: 0,0:05:38.33,0:05:40.38,Default,,0,0,0,,Ах... мм...
Dialogue: 0,0:05:40.46,0:05:42.46,Default,,0,0,0,,Мен ішке кіріп, люкті жапқанда
Dialogue: 0,0:05:42.55,0:05:44.26,Default,,0,0,0,,Бұл ілгекті шешіңіз.
Dialogue: 0,0:05:44.34,0:05:47.26,Default,,0,0,0,,Ілмек? Бұл рычаг?
Dialogue: 0,0:05:47.34,0:05:49.97,Default,,0,0,0,,Кэтрин кранды басқаруымды сұрайды.
Dialogue: 0,0:05:56.14,0:05:57.02,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,0:05:57.10,0:05:58.48,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,0:06:02.90,0:06:04.32,Default,,0,0,0,,- жылжытылды! - (Мо Мизуна) Уау!
Dialogue: 0,0:06:04.40,0:06:05.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:06.03,0:06:08.45,Default,,0,0,0,,Бұл бала шынымен жақсы ма?
Dialogue: 0,0:06:08.53,0:06:11.95,Default,,0,0,0,,Оны тез шешіңіз! Жанармай шексіз емес
Dialogue: 0,0:06:12.03,0:06:13.16,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:06:16.16,0:06:17.41,Default,,0,0,0,,Балласты цистернасы ашық
Dialogue: 0,0:06:17.50,0:06:18.62,Default,,0,0,0,,Уау
Dialogue: 0,0:06:18.71,0:06:21.25,Default,,0,0,0,,Бәрібір тоқтаған дұрыс.
Dialogue: 0,0:06:21.33,0:06:24.84,Default,,0,0,0,,Мен таяз жерде сүңгіп жатырмын және оның қай жерде екенін білемін.
Dialogue: 0,0:06:24.92,0:06:25.96,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:06:26.46,0:06:28.88,Default,,0,0,0,,Оның үстіне бір рет баруым керек.
Dialogue: 0,0:06:28.97,0:06:30.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:30.80,0:06:32.22,Default,,0,0,0,,Біреу бару керек
Dialogue: 0,0:06:32.30,0:06:34.89,Default,,0,0,0,,Ол мұхитта мәңгілікке қалды.
Dialogue: 0,0:06:35.56,0:06:37.64,Default,,0,0,0,,Бұл бәрі тұратын қала болса да...
Dialogue: 0,0:06:42.48,0:06:44.11,Default,,0,0,0,,Нацу-кун...
Dialogue: 0,0:06:50.70,0:06:51.66,Default,,0,0,0,,(Қыңқыл) Бірақ қазір менде қорқыныштың бір ұшқыны да жоқ
Dialogue: 0,0:06:57.75,0:07:02.08,Default,,0,0,0,,Көп нәрсе сол күйінде қалды.
Dialogue: 0,0:07:07.34,0:07:08.92,Default,,0,0,0,,Нацу-кун қайда?
Dialogue: 0,0:07:10.26,0:07:12.05,Default,,0,0,0,,Мо Мизуна Алға барайық.
Dialogue: 0,0:07:12.14,0:07:15.10,Default,,0,0,0,,Ендеше! Хахахаха
Dialogue: 0,0:07:15.18,0:07:17.97,Default,,0,0,0,,Нацу-кун, күте тұр!
Dialogue: 0,0:07:20.02,0:07:21.27,Default,,0,0,0,,Оны таптыңыз ба?
Dialogue: 0,0:07:21.35,0:07:23.65,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:07:30.07,0:07:31.07,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:07:43.92,0:07:46.67,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:07:47.17,0:07:49.67,Default,,0,0,0,,Не? Бұл да алтын кесектері болды ма?
Dialogue: 0,0:07:49.76,0:07:53.22,Default,,0,0,0,,Бұл шын болуы мүмкін емес, бұл кеме апаты емес.
Dialogue: 0,0:08:06.31,0:08:08.48,Default,,0,0,0,,Капсула? Жоқ...
Dialogue: 0,0:08:13.03,0:08:14.28,Default,,0,0,0,,Бұл қыз
Dialogue: 0,0:08:18.03,0:08:19.16,Default,,0,0,0,,Қуыршақ…
Dialogue: 0,0:08:20.95,0:08:22.58,Default,,0,0,0,,Гуманоид?
Dialogue: 0,0:08:23.66,0:08:26.29,Default,,0,0,0,,Мен оны жұлып алайын деп жатырмын. Маған кранның ілмегін беріңіз.
Dialogue: 0,0:08:26.38,0:08:27.08,Default,,0,0,0,,Айо
Dialogue: 0,0:08:27.17,0:08:29.67,Default,,0,0,0,,Қуыршаққа ұқсамайды
Dialogue: 0,0:08:30.17,0:08:33.17,Default,,0,0,0,,Оның соншалықты мұқият жасалғанына сене алар емеспін...
Dialogue: 0,0:08:34.18,0:08:35.72,Default,,0,0,0,,бәлкім, осы ғана шығар
Dialogue: 0,0:08:38.68,0:08:39.72,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:40.39,0:08:42.73,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:08:43.77,0:08:44.77,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:08:48.86,0:08:49.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:49.86,0:08:52.36,Default,,0,0,0,,Нацу-кун! Нацукун, не болды?
Dialogue: 0,0:08:52.44,0:08:53.69,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:57.53,0:08:59.83,Default,,0,0,0,,Маған ұнамайды... Маған ұнамайды
Dialogue: 0,0:09:00.87,0:09:02.08,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:09:02.16,0:09:03.83,Default,,0,0,0,,Нацу-кун! Нацу-кун!
Dialogue: 0,0:09:04.41,0:09:06.96,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:09:07.88,0:09:09.42,Default,,0,0,0,,(терезені қағу)
Dialogue: 0,0:09:09.92,0:09:10.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:12.71,0:09:14.42,Default,,0,0,0,,(терезені қағу)
Dialogue: 0,0:09:18.05,0:09:20.68,Default,,0,0,0,,A... То... Ri?
Dialogue: 0,0:09:33.82,0:09:35.44,Default,,0,0,0,,- (Нацуо) Винч... - (Мое Мизуна) Иә?
Dialogue: 0,0:09:36.24,0:09:37.24,Default,,0,0,0,,Тек жүкшығыр!
Dialogue: 0,0:09:44.45,0:09:45.62,Default,,0,0,0,,Нацу-кун!
Dialogue: 0,0:09:46.41,0:09:49.13,Default,,0,0,0,,Уф... Хаа Хаа...
Dialogue: 0,0:09:50.00,0:09:52.13,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:09:53.21,0:09:54.76,Default,,0,0,0,,Ха... міне, болды!
Dialogue: 0,0:09:57.17,0:09:58.84,Default,,0,0,0,,Аһ!
Dialogue: 0,0:10:01.39,0:10:02.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:11.02,0:10:12.02,Default,,0,0,0,,Аяқ?
Dialogue: 0,0:10:13.77,0:10:15.40,Default,,0,0,0,,Бұл менің протездік аяғым ба?
Dialogue: 0,0:10:17.19,0:10:18.36,Default,,0,0,0,,Әлі емес.
Dialogue: 0,0:10:20.70,0:10:23.24,Default,,0,0,0,,Жарық әдемі
Dialogue: 0,0:10:24.99,0:10:28.79,Default,,0,0,0,,Бұл шынымен... әдемі.
Dialogue: 0,0:11:01.99,0:11:03.53,Default,,0,0,0,,Гуманоид…
Dialogue: 0,0:11:04.03,0:11:05.70,Default,,0,0,0,,Робот дегенді қалай түсінесіңдер?
Dialogue: 0,0:11:05.79,0:11:08.41,Default,,0,0,0,,Сіз, адамдар, оны осылай атайсыз -
Dialogue: 0,0:11:08.50,0:11:10.96,Default,,0,0,0,,Ол дәлме-дәл машиналарға жататынымен
Dialogue: 0,0:11:11.04,0:11:14.54,Default,,0,0,0,,Менің ойымша, бұл термин біршама кең.
Dialogue: 0,0:11:14.63,0:11:18.26,Default,,0,0,0,,Ғажайып... адамға ұқсайтын осындай гуманоид.
Dialogue: 0,0:11:18.34,0:11:19.55,Default,,0,0,0,,бәлкім, осы ғана шығар
Dialogue: 0,0:11:19.63,0:11:20.51,Default,,0,0,0,,(Джунпей) Бірақ ол мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:11:20.59,0:11:22.64,Default,,0,0,0,,Жоғары өнімділік!
Dialogue: 0,0:11:24.10,0:11:27.77,Default,,0,0,0,,Бірақ мен оның мұндай нәрсені жасырғанына сене алмаймын.
Dialogue: 0,0:11:27.85,0:11:29.81,Default,,0,0,0,,Адамға жақын гуманоидтар
Dialogue: 0,0:11:29.89,0:11:32.98,Default,,0,0,0,,Ол ұзақ уақыт бұрын тоқтатылды.
Dialogue: 0,0:11:33.06,0:11:33.98,Default,,0,0,0,,Ол жоғары бағаға сатылады
Dialogue: 0,0:11:34.06,0:11:35.77,Default,,0,0,0,,- (Мо Мизуна) Ой, оны сатайын деп жатырсың ба? -хи хи хи
Dialogue: 0,0:11:35.86,0:11:39.15,Default,,0,0,0,,Әрине, сондықтан біз оны құтқардық.
Dialogue: 0,0:11:39.24,0:11:42.11,Default,,0,0,0,,Бірақ сіз мұны істей алмайсыз ...
Dialogue: 0,0:11:42.20,0:11:44.03,Default,,0,0,0,,Иә, жоқ.
Dialogue: 0,0:11:44.12,0:11:47.58,Default,,0,0,0,,Мені қожайынымның рұқсатынсыз сатып алу немесе сату заңсыз.
Dialogue: 0,0:11:47.66,0:11:48.99,Default,,0,0,0,,Хе-хе. Ей, ойын ойнайық.
Dialogue: 0,0:11:49.08,0:11:51.16,Default,,0,0,0,,Бұл доктор Ноко Ячигуса.
Dialogue: 0,0:11:52.33,0:11:53.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:56.21,0:11:57.55,Default,,0,0,0,,Сіздің шеберіңіз...
Dialogue: 0,0:11:59.13,0:12:01.59,Default,,0,0,0,,Бір ай бұрын аурудан қайтыс болды
Dialogue: 0,0:12:01.67,0:12:04.55,Default,,0,0,0,,Не? Нунко бұл...
Dialogue: 0,0:12:05.09,0:12:06.60,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:07.18,0:12:09.18,Default,,0,0,0,,Ах... мм...
Dialogue: 0,0:12:09.27,0:12:11.68,Default,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,0:12:11.77,0:12:14.60,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:12:14.69,0:12:16.73,Default,,0,0,0,,Жарайды... бұл жарық сияқты.
Dialogue: 0,0:12:16.81,0:12:18.52,Default,,0,0,0,,Шығар, бәлкім
Dialogue: 0,0:12:19.02,0:12:22.49,Default,,0,0,0,,Сөздер мен іс-әрекеттердің бәрі жай ғана бағдарлама.
Dialogue: 0,0:12:22.57,0:12:27.03,Default,,0,0,0,,Ендеше, енді қожасы оның немересі болып табылатын осы бала.
Dialogue: 0,0:12:27.12,0:12:29.08,Default,,0,0,0,,Осы адамның бұйрығын орындаңыз.
Dialogue: 0,0:12:29.16,0:12:30.45,Default,,0,0,0,,Бала…
Dialogue: 0,0:12:32.00,0:12:34.62,Default,,0,0,0,,Саған көп рахмет, балам.
Dialogue: 0,0:12:34.71,0:12:37.13,Default,,0,0,0,,Мен сені «Бой-сан» десем болады ма?
Dialogue: 0,0:12:37.21,0:12:42.26,Default,,0,0,0,,Басқа сөздерге «әке», «аға» және «аға» жатады.
Dialogue: 0,0:12:43.01,0:12:44.05,Default,,0,0,0,,Ұл емес
Dialogue: 0,0:12:44.68,0:12:45.80,Default,,0,0,0,,Бұл Нацуо.
Dialogue: 0,0:12:47.30,0:12:48.47,Default,,0,0,0,,Нацуо Икаруга
Dialogue: 0,0:12:48.97,0:12:50.89,Default,,0,0,0,,Нацуо...?
Dialogue: 0,0:12:50.97,0:12:52.73,Default,,0,0,0,,Мен сені қалай атаймын?
Dialogue: 0,0:12:52.81,0:12:54.31,Default,,0,0,0,,Бұл үлгі нөмірі ме?
Dialogue: 0,0:12:54.81,0:12:57.40,Default,,0,0,0,,Жоқ, бұл атау емес пе?
Dialogue: 0,0:12:57.48,0:12:58.23,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:00.15,0:13:00.65,Default,,0,0,0,,Атори
Dialogue: 0,0:13:02.69,0:13:04.15,Default,,0,0,0,,Ол Атори деп аталады.
Dialogue: 0,0:13:04.24,0:13:08.16,Default,,0,0,0,,“Ａ･Ｔ･Ｒ･Ｉ”
Dialogue: 0,0:13:08.24,0:13:09.74,Default,,0,0,0,,Атри…
Dialogue: 0,0:13:10.24,0:13:13.04,Default,,0,0,0,,Иә! Бірегей атау берілген
Dialogue: 0,0:13:13.12,0:13:17.21,Default,,0,0,0,,Роботтың тірі зат ретінде танылатынын дәлелдеу
Dialogue: 0,0:13:17.29,0:13:20.38,Default,,0,0,0,,Жоғары өнімділік – менің статистикамның бірі!
Dialogue: 0,0:13:20.46,0:13:24.05,Default,,0,0,0,,А... бірақ менің ойымша, Нацуо да өте жақсы есім.
Dialogue: 0,0:13:24.13,0:13:26.18,Default,,0,0,0,,Сіз қандай перспектива туралы айтып отырсыз?
Dialogue: 0,0:13:26.26,0:13:28.64,Default,,0,0,0,,Иә? Осы тұрғыдан алғанда
Dialogue: 0,0:13:30.93,0:13:32.22,Default,,0,0,0,,Түсінбейсің бе?
Dialogue: 0,0:13:34.39,0:13:35.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.39,0:13:39.90,Default,,0,0,0,,Мүмкін мені мазақ еткен шығар?
Dialogue: 0,0:13:39.98,0:13:41.44,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:13:44.94,0:13:49.11,Default,,0,0,0,,Мен мектептен келгенше сата алмайсың.
Dialogue: 0,0:13:49.20,0:13:50.16,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:13:50.24,0:13:51.41,Default,,0,0,0,,Нихихи
Dialogue: 0,0:13:51.49,0:13:54.91,Default,,0,0,0,,Мүлдем, мүлде!
Dialogue: 0,0:13:58.75,0:14:00.33,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:14:02.75,0:14:05.01,Default,,0,0,0,,Гуманоидты артқа тастап кете алмаймын.
Dialogue: 0,0:14:05.09,0:14:06.42,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:14:06.51,0:14:09.76,Default,,0,0,0,,Мен де бұл аяқпен бірдеңе істеуім керек.
Dialogue: 0,0:14:09.84,0:14:11.05,Default,,0,0,0,,Мен мұны істеуім керек.
Dialogue: 0,0:14:13.22,0:14:13.81,Default,,0,0,0,,Атори
Dialogue: 0,0:14:13.89,0:14:15.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:16.02,0:14:17.02,Default,,0,0,0,,Кеттік
Dialogue: 0,0:14:17.10,0:14:19.06,Default,,0,0,0,,Ұстаз серуендеуге барасыз ба?
Dialogue: 0,0:14:19.56,0:14:20.90,Default,,0,0,0,,Барсаң түсінесің
Dialogue: 0,0:14:27.99,0:14:31.32,Default,,0,0,0,,Бұл өте кеш. Неге қашпайсың?
Dialogue: 0,0:14:31.41,0:14:33.16,Default,,0,0,0,,Бұл гуманоид.
Dialogue: 0,0:14:33.24,0:14:35.62,Default,,0,0,0,,Сіз қожайыныңыздың бұйрығына қарсы шыға алмайсыз.
Dialogue: 0,0:14:36.12,0:14:37.71,Default,,0,0,0,,Бұл сирек кездеседі ме?
Dialogue: 0,0:14:37.79,0:14:41.13,Default,,0,0,0,,Иә, мен үшін бәрі жаңа.
Dialogue: 0,0:14:41.79,0:14:44.84,Default,,0,0,0,,Соңғы бірнеше жылда мұнда да көп нәрсе өзгерді.
Dialogue: 0,0:14:45.63,0:14:46.92,Default,,0,0,0,,Сіз неше жыл ұйықтадыңыз?
Dialogue: 0,0:14:47.01,0:14:47.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:48.34,0:14:50.55,Default,,0,0,0,,Сіз сонша ұзақ ұйықтадыңыз ба?
Dialogue: 0,0:14:50.63,0:14:52.72,Default,,0,0,0,,Мұны да түсінбейсің бе?
Dialogue: 0,0:14:52.80,0:14:57.06,Default,,0,0,0,,Иә, барлық жады жоғалған сияқты.
Dialogue: 0,0:14:59.18,0:15:00.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:04.52,0:15:05.48,Default,,0,0,0,,Маған еріңіз
Dialogue: 0,0:15:05.57,0:15:06.53,Default,,0,0,0,,А, сәл күте тұрыңыз
Dialogue: 0,0:15:06.61,0:15:07.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:11.28,0:15:12.74,Default,,0,0,0,,Сіз өзіңізге ұнайтын нәрсені таңдай аласыз.
Dialogue: 0,0:15:12.82,0:15:14.70,Default,,0,0,0,,Не? Мен үшін сатып аласың ба?
Dialogue: 0,0:15:14.78,0:15:17.54,Default,,0,0,0,,Сату бағасы төмендемесе жақсы емес пе?
Dialogue: 0,0:15:18.04,0:15:19.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:19.58,0:15:20.25,Default,,0,0,0,,Мен оларды шаруамен жібердім.
Dialogue: 0,0:15:20.33,0:15:23.17,Default,,0,0,0,,Жоқ, бұл ең жақсы өлшем.
Dialogue: 0,0:15:23.25,0:15:26.00,Default,,0,0,0,,Бірақ дизайн бұл.
Dialogue: 0,0:15:26.09,0:15:29.09,Default,,0,0,0,,Хаа... күн батып барады
Dialogue: 0,0:15:29.17,0:15:30.67,Default,,0,0,0,,Сіз шешесіз.
Dialogue: 0,0:15:35.68,0:15:37.60,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:37.68,0:15:39.02,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:15:39.10,0:15:41.02,Default,,0,0,0,,Көлемі де тамаша.
Dialogue: 0,0:15:41.10,0:15:42.69,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:43.19,0:15:45.65,Default,,0,0,0,,Сіз өзіңіздің аяқ киіміңізге шынымен ризасыз ба?
Dialogue: 0,0:15:45.73,0:15:46.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:48.11,0:15:50.28,Default,,0,0,0,,Өйткені шебер маған берді
Dialogue: 0,0:15:50.99,0:15:53.70,Default,,0,0,0,,Сіз бізге заттар бердіңіз!
Dialogue: 0,0:15:57.08,0:16:00.91,Default,,0,0,0,,Иә? Бақытты болу біртүрлі болды ма?
Dialogue: 0,0:16:01.62,0:16:04.67,Default,,0,0,0,,Жоқ, бұл таңқаларлық емес.
Dialogue: 0,0:16:04.75,0:16:06.38,Default,,0,0,0,,Фуфуфуфу~н
Dialogue: 0,0:16:07.09,0:16:10.26,Default,,0,0,0,,Сіздің қарапайым адамнан еш айырмашылығыңыз жоқ.
Dialogue: 0,0:16:10.34,0:16:13.43,Default,,0,0,0,,Сондықтан шығар өндіріс тоқтатылды.
Dialogue: 0,0:16:13.51,0:16:14.18,Default,,0,0,0,,(протездік аяқтың сықырлаған дыбысы)
Dialogue: 0,0:16:14.26,0:16:15.22,Default,,0,0,0,,Runrrun~n
Dialogue: 0,0:16:15.30,0:16:17.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:18.39,0:16:20.18,Default,,0,0,0,,-(Нацуо) Ух... -Жақсысың ба?
Dialogue: 0,0:16:22.69,0:16:25.10,Default,,0,0,0,,Ол ертерек шықты.
Dialogue: 0,0:16:25.60,0:16:28.94,Default,,0,0,0,,Жарайды, бұл протез аяқ та ескі үлгі.
Dialogue: 0,0:16:29.02,0:16:31.49,Default,,0,0,0,,Бұл жоғары өнімділік емес, солай ма?
Dialogue: 0,0:16:31.57,0:16:34.36,Default,,0,0,0,,Аа... Дұрыс.
Dialogue: 0,0:16:51.88,0:16:54.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:54.22,0:16:55.47,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:56.47,0:16:59.39,Default,,0,0,0,,Ямасаки фабрикасының 4-ші буыны
Dialogue: 0,0:16:59.89,0:17:02.81,Default,,0,0,0,,Иә, осыдан кейінгі екі ұрпақ.
Dialogue: 0,0:17:02.89,0:17:04.48,Default,,0,0,0,,2-ші буын...
Dialogue: 0,0:17:04.56,0:17:07.44,Default,,0,0,0,,Осы уақыт ішінде сіз әлдеқайда адамға ұқсадыңыз.
Dialogue: 0,0:17:07.52,0:17:11.02,Default,,0,0,0,,Әй, бұл шыққан кезде қызу тақырып болды.
Dialogue: 0,0:17:11.11,0:17:13.57,Default,,0,0,0,,Бірақ кейін еске түсіру анықталды.
Dialogue: 0,0:17:13.65,0:17:16.24,Default,,0,0,0,,Еске түсіру? Сонда бағасы қанша...
Dialogue: 0,0:17:17.03,0:17:17.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:19.20,0:17:21.54,Default,,0,0,0,,Қарғыс атсын! Сонымен, сіз қалай ойлайсыз?
Dialogue: 0,0:17:22.12,0:17:24.54,Default,,0,0,0,,-Ммм -Уау!
Dialogue: 0,0:17:24.62,0:17:27.08,Default,,0,0,0,,Бұл сома екі адамға бөлінеді...
Dialogue: 0,0:17:27.17,0:17:30.42,Default,,0,0,0,,Немесе... мен жеңдім! Сіздің өміріңізге ставка жасаңыз!
Dialogue: 0,0:17:30.92,0:17:33.17,Default,,0,0,0,,Шақырып алуға қатысты мәселе болды, солай ма?
Dialogue: 0,0:17:33.26,0:17:34.63,Default,,0,0,0,,Осыншама қымбат болған дұрыс па?
Dialogue: 0,0:17:34.72,0:17:37.93,Default,,0,0,0,,Бұл коллекционерлерге ұнайды.
Dialogue: 0,0:17:38.01,0:17:41.89,Default,,0,0,0,,Басқаша айтқанда, біз сізді қанағаттандыратын баға алдық.
Dialogue: 0,0:17:41.97,0:17:43.97,Default,,0,0,0,,Менің жоғары өнімділігім күткендей!
Dialogue: 0,0:17:44.06,0:17:46.81,Default,,0,0,0,,Не істеу керек? Мен оны бірден қалайтын адамды іздеймін
Dialogue: 0,0:17:46.89,0:17:48.10,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:48.19,0:17:49.27,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:49.86,0:17:50.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:51.06,0:17:55.78,Default,,0,0,0,,Сату үшін сәл күте аласыз ба?
Dialogue: 0,0:17:55.86,0:17:57.45,Default,,0,0,0,,Бұрынғы магистр
Dialogue: 0,0:17:57.95,0:18:01.91,Default,,0,0,0,,Жоқ, мен Нункодан тапсырыс алдым.
Dialogue: 0,0:18:02.41,0:18:03.95,Default,,0,0,0,,Ұйықтар алдында
Dialogue: 0,0:18:04.45,0:18:06.87,Default,,0,0,0,,Мен мұны жасамас бұрын мұны істеуіңізді қалаймын.
Dialogue: 0,0:18:07.58,0:18:08.87,Default,,0,0,0,,Әженің бұйрықтары?
Dialogue: 0,0:18:08.96,0:18:09.75,Default,,0,0,0,,Мен оларды шаруамен жібердім.
Dialogue: 0,0:18:09.83,0:18:10.63,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:17.05,0:18:18.34,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:18:18.43,0:18:19.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:19.68,0:18:22.81,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:18:22.89,0:18:25.72,Default,,0,0,0,,Мм... мм...
Dialogue: 0,0:18:25.81,0:18:28.94,Default,,0,0,0,,Сіз ұмытшақсыз ба? Бұл робот болса да
Dialogue: 0,0:18:29.02,0:18:31.61,Default,,0,0,0,,Ойлау үлгілерін адамдарға ұқсату
Dialogue: 0,0:18:31.69,0:18:34.40,Default,,0,0,0,,Адамдар сияқты біз де шатасамыз.
Dialogue: 0,0:18:34.48,0:18:37.40,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:18:37.90,0:18:39.70,Default,,0,0,0,,Ұстаз, есіңізде жоқ па?
Dialogue: 0,0:18:39.78,0:18:41.74,Default,,0,0,0,,Менің есімде қалуға мүмкіндік жоқ.
Dialogue: 0,0:18:41.82,0:18:44.12,Default,,0,0,0,,Бұл енді пайдалы емес...
Dialogue: 0,0:18:44.20,0:18:46.20,Default,,0,0,0,,Мен қиындыққа тап болдым!
Dialogue: 0,0:18:46.29,0:18:48.21,Default,,0,0,0,,Сіз білесіз...
Dialogue: 0,0:18:51.88,0:18:53.46,Default,,0,0,0,,(бұқа бақа дыбысы)
Dialogue: 0,0:18:54.63,0:18:55.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:55.59,0:18:58.30,Default,,0,0,0,,Маңызды нәрсені жоғалту
Dialogue: 0,0:18:58.38,0:19:00.80,Default,,0,0,0,,Мен өнімділігі жоғары адам болсам да...
Dialogue: 0,0:19:00.88,0:19:03.01,Default,,0,0,0,,Күтілгендей, бұл кері қайтарылған өнім
Dialogue: 0,0:19:03.51,0:19:04.51,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:04.60,0:19:08.10,Default,,0,0,0,,Сіз бұл сұмдық үшін жақсы баға алдыңыз.
Dialogue: 0,0:19:09.14,0:19:10.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:10.64,0:19:12.10,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:19:14.98,0:19:19.36,Default,,0,0,0,,Роботты флоп деп атау роботты кемсіту туралы заңның бұзылуы болып табылады!
Dialogue: 0,0:19:19.44,0:19:20.95,Default,,0,0,0,,Түзетіңіз!
Dialogue: 0,0:19:21.03,0:19:23.45,Default,,0,0,0,,Оны қайда жасырдың? Міне бітті!
Dialogue: 0,0:19:23.95,0:19:26.95,Default,,0,0,0,,Хаа... Мен мұны кешіктірмей, ертерек есіме түсіруім керек.
Dialogue: 0,0:19:27.04,0:19:28.41,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:19:28.50,0:19:31.33,Default,,0,0,0,,Мен оны бүгінге қалдырамын.
Dialogue: 0,0:19:31.42,0:19:32.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:32.29,0:19:33.92,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:19:34.00,0:19:36.55,Default,,0,0,0,,Егер сізде шебердің рұқсаты болса, оны сата аласыз, солай ма?
Dialogue: 0,0:19:36.63,0:19:39.17,Default,,0,0,0,,Саған сеніп тапсырып, сен шатастырып алсаң, шыдай алмас едім.
Dialogue: 0,0:19:39.26,0:19:40.26,Default,,0,0,0,,Сіз сатасыз ба?
Dialogue: 0,0:19:40.34,0:19:41.43,Default,,0,0,0,,Сіз оны сатпайсыз ба?
Dialogue: 0,0:19:41.51,0:19:42.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:44.51,0:19:47.26,Default,,0,0,0,,Өлген қожайынымның бұйрықтары есіме түскенде.
Dialogue: 0,0:19:47.35,0:19:48.72,Default,,0,0,0,,Бұл не болады?
Dialogue: 0,0:19:48.81,0:19:52.60,Default,,0,0,0,,Менің ойымша, бұлай істеу мүмкін емес.
Dialogue: 0,0:19:53.31,0:19:55.86,Default,,0,0,0,,Сіз бұл аяқты ауыстырғыңыз келеді, солай ма?
Dialogue: 0,0:19:58.03,0:19:58.94,Default,,0,0,0,,Атори
Dialogue: 0,0:19:59.03,0:19:59.78,Default,,0,0,0,,Иә
Dialogue: 0,0:20:02.99,0:20:04.28,Default,,0,0,0,,Мен Кэтринмен бірге барамын.
Dialogue: 0,0:20:05.78,0:20:06.66,Default,,0,0,0,,Иә
Dialogue: 0,0:20:15.83,0:20:18.46,Default,,0,0,0,,Жарайды, егер мен сатып алушы тапсам, мен сізге хабарласамын.
Dialogue: 0,0:20:19.05,0:20:19.71,Default,,0,0,0,,О
Dialogue: 0,0:20:23.80,0:20:25.59,Default,,0,0,0,,-Мен барамын -Иә
Dialogue: 0,0:20:25.68,0:20:26.76,Default,,0,0,0,,(аяқ киімнің құлаған дыбысы)
Dialogue: 0,0:20:28.89,0:20:30.60,Default,,0,0,0,,Ах... эй
Dialogue: 0,0:20:32.85,0:20:33.69,Default,,0,0,0,,Күтіңіз...
Dialogue: 0,0:20:34.60,0:20:35.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:37.11,0:20:38.11,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:20:40.11,0:20:43.03,Default,,0,0,0,,(Нацуоның қатты тыныс алуы)
Dialogue: 0,0:20:44.86,0:20:46.28,Default,,0,0,0,,Иә? бұзу?
Dialogue: 0,0:20:46.99,0:20:49.70,Default,,0,0,0,,Өйткені, арзан нәрсе жақсы емес.
Dialogue: 0,0:20:52.45,0:20:54.25,Default,,0,0,0,,Куууу…
Dialogue: 0,0:20:54.33,0:20:55.37,Default,,0,0,0,,-Мм... -Ой?
Dialogue: 0,0:20:57.75,0:20:59.04,Default,,0,0,0,,Ах... Ябба!
Dialogue: 0,0:20:59.13,0:21:03.92,Default,,0,0,0,,Ақылыңды көрсет, ақымақ!
Dialogue: 0,0:21:04.88,0:21:06.39,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:21:07.09,0:21:08.76,Default,,0,0,0,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,0:21:09.76,0:21:10.89,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:21:12.31,0:21:13.18,Default,,0,0,0,,(Декү) Кешір мені (Каири) Ах…
Dialogue: 0,0:21:13.27,0:21:16.69,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:21:17.60,0:21:18.44,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:22.23,0:21:23.49,Default,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:21:31.99,0:21:33.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:36.16,0:21:37.17,Default,,0,0,0,,Нацу-кун
Dialogue: 0,0:21:41.17,0:21:44.92,Default,,0,0,0,,Менің шынтағым тырналды. Мен қазір алғашқы көмек жинағын алып жатырмын...
Dialogue: 0,0:21:45.01,0:21:48.09,Default,,0,0,0,,Нашар мені жалғыз қалдыра аласыз ба?
Dialogue: 0,0:21:50.39,0:21:51.22,Default,,0,0,0,,Иә
Dialogue: 0,0:21:56.60,0:21:59.90,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:22:05.32,0:22:07.90,Default,,0,0,0,,Мен сені тіпті академияға да жібердім.
Dialogue: 0,0:22:07.99,0:22:11.78,Default,,0,0,0,,Қашып, қайтып оралу қандай ұят.
Dialogue: 0,0:22:18.25,0:22:19.71,Default,,0,0,0,,Біздің таңдауымыз жоқ.
Dialogue: 0,0:22:24.00,0:22:25.17,Default,,0,0,0,,Мен де...
Dialogue: 0,0:22:26.38,0:22:28.80,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:22:29.68,0:22:31.60,Default,,0,0,0,,Қап! Қат!
Dialogue: 0,0:22:32.60,0:22:35.31,Default,,0,0,0,,Маған ұнамайды... Маған ұнамайды!
Dialogue: 0,0:22:36.22,0:22:36.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:37.77,0:22:39.90,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:22:45.98,0:22:46.94,Default,,0,0,0,,Атри…
Dialogue: 0,0:22:49.03,0:22:50.41,Default,,0,0,0,,Нацуо-сан
Dialogue: 0,0:22:51.78,0:22:52.66,Default,,0,0,0,,Фу…
Dialogue: 0,0:22:54.12,0:22:57.79,Default,,0,0,0,,Мен қожайынның аяғы боламын
Dialogue: 0,0:23:01.00,0:23:03.00,Default,,0,0,0,,♪～
Dialogue: 0,0:24:26.46,0:24:28.46,Default,,0,0,0,,～♪
