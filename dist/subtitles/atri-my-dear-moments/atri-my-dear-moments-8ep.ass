Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.75,0:00:05.17,Default,,0,0,0,,(Атридің ұйықтап жатқан тынысы)
Dialogue: 0,0:00:06.92,0:00:09.25,Default,,0,0,0,,Неге... бұлай болды?
Dialogue: 0,0:00:11.09,0:00:13.59,Default,,0,0,0,,Сол кезде мен сені құшақтағым келді
Dialogue: 0,0:00:14.63,0:00:17.76,Default,,0,0,0,,Менің алдымда кішкентай гуманоид
Dialogue: 0,0:00:18.26,0:00:20.02,Default,,0,0,0,,Мен мұны қымбатты деп ойладым.
Dialogue: 0,0:00:21.10,0:00:24.23,Default,,0,0,0,,Мен ешқашан жібергім келмейтіндей сезінемін...
Dialogue: 0,0:00:27.27,0:00:30.53,Default,,0,0,0,,Ах~ Тыныш! Тыныштал, мен!
Dialogue: 0,0:00:30.61,0:00:33.53,Default,,0,0,0,,Бұл Атри, бұл ақаулы робот бала!
Dialogue: 0,0:00:34.11,0:00:38.58,Default,,0,0,0,,Нацуо-сан, сен оны дұрыс жылтыратпадың.
Dialogue: 0,0:00:38.66,0:00:42.04,Default,,0,0,0,,Енді... дұрыс орындаңыз~
Dialogue: 0,0:00:42.12,0:00:45.79,Default,,0,0,0,,Дұрыс, бұл жай ғана шатасудың сәті болды.
Dialogue: 0,0:00:47.21,0:00:47.71,Default,,0,0,0,,Эй
Dialogue: 0,0:00:47.79,0:00:50.63,Default,,0,0,0,,Эй, оян, Атри.
Dialogue: 0,0:00:50.71,0:00:54.30,Default,,0,0,0,,Нацуо-сан, сәл артта.
Dialogue: 0,0:00:54.38,0:00:56.93,Default,,0,0,0,,Не, ыңғайлы түс көріп тұрсың ба?
Dialogue: 0,0:00:57.01,0:00:59.72,Default,,0,0,0,,Дәлірек айтсақ, сіз армандайсыз...
Dialogue: 0,0:01:00.97,0:01:01.81,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:01:04.64,0:01:07.90,Default,,0,0,0,,Нацуоның жынысы...
Dialogue: 0,0:01:08.48,0:01:10.48,Default,,0,0,0,,♪～
Dialogue: 0,0:02:32.77,0:02:34.77,Default,,0,0,0,,～♪
Dialogue: 0,0:02:42.41,0:02:43.49,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:47.00,0:02:49.25,Default,,0,0,0,,Мұғалім, бітті...
Dialogue: 0,0:02:51.62,0:02:52.75,Default,,0,0,0,,Мұғалім?
Dialogue: 0,0:02:52.83,0:02:54.67,Default,,0,0,0,,Өйткені ыстық
Dialogue: 0,0:02:54.75,0:02:56.21,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:02:56.30,0:02:58.67,Default,,0,0,0,,- (Йоко) Дұрыс емес пе? - (Мо Мизуна) Иә? Басқаша ма?
Dialogue: 0,0:03:00.93,0:03:04.35,Default,,0,0,0,,Қалай қарасаң да, бірдеңе болды.
Dialogue: 0,0:03:04.43,0:03:05.97,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:03:06.06,0:03:10.56,Default,,0,0,0,,Әйелдерден айырмашылығы, мұндай жағдайларда ер адамдар бірден бет-әлпетін көрсетеді.
Dialogue: 0,0:03:10.64,0:03:11.85,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:11.94,0:03:14.48,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:03:14.56,0:03:18.48,Default,,0,0,0,,Ер адамның әйелдің алдында өтірік айтуы ешқашан мағынасыз.
Dialogue: 0,0:03:20.03,0:03:21.36,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:22.95,0:03:26.83,Default,,0,0,0,,Иә, теңізге тым алыс кетпеңіз.
Dialogue: 0,0:03:27.41,0:03:28.45,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:03:28.54,0:03:31.46,Default,,0,0,0,,Аторин суға батқанда жүзе алмайды!
Dialogue: 0,0:03:31.54,0:03:32.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:34.75,0:03:36.59,Default,,0,0,0,,- Пухат - (Миё Ририка) Уау!
Dialogue: 0,0:03:36.67,0:03:37.71,Default,,0,0,0,,Бұл краб!
Dialogue: 0,0:03:38.96,0:03:40.22,Default,,0,0,0,,Гермит краб…
Dialogue: 0,0:03:43.93,0:03:45.01,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:45.09,0:03:48.43,Default,,0,0,0,,Бұл өте нашар.
Dialogue: 0,0:03:48.93,0:03:50.06,Default,,0,0,0,,А... Әй, эй, эй
Dialogue: 0,0:03:51.23,0:03:54.27,Default,,0,0,0,,Бірдеңе болды ма? Атори-чанмен
Dialogue: 0,0:03:54.77,0:03:55.69,Default,,0,0,0,,Бөлек
Dialogue: 0,0:03:56.94,0:03:59.82,Default,,0,0,0,,Құлақтар ашық қызыл! Сондай сүйкімді~
Dialogue: 0,0:04:01.82,0:04:03.07,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:04:03.15,0:04:06.41,Default,,0,0,0,,Сонда сіздің алғашқы махаббатыңыз Атри болғанын мойындайсыз ба?
Dialogue: 0,0:04:06.99,0:04:08.49,Default,,0,0,0,,- (Нацуо) Бұл... - (Йоко)?
Dialogue: 0,0:04:08.99,0:04:10.58,Default,,0,0,0,,«de?» нені білдіреді? білдіреді?
Dialogue: 0,0:04:10.66,0:04:13.62,Default,,0,0,0,,Екеуіңнің араларыңда бірдеңе өзгерді ме?
Dialogue: 0,0:04:17.71,0:04:18.92,Default,,0,0,0,,Күте тұр, Нацу
Dialogue: 0,0:04:20.84,0:04:22.67,Default,,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,0:04:23.26,0:04:24.68,Default,,0,0,0,,- (Рюджи) Бар. - (Мизуна Мо) Иә?
Dialogue: 0,0:04:24.76,0:04:26.47,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:26.55,0:04:28.93,Default,,0,0,0,,Мүмкін мен нақтылауым керек шығар.
Dialogue: 0,0:04:30.43,0:04:33.77,Default,,0,0,0,,Демек, сіз бұл туралы ерекше ештеңе жоқ деп айтасыз.
Dialogue: 0,0:04:33.85,0:04:35.56,Default,,0,0,0,,Көңіл көтермеңіз және істерді үлкейтіңіз
Dialogue: 0,0:04:35.65,0:04:36.27,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:36.35,0:04:38.61,Default,,0,0,0,,Енді тоқтайық
Dialogue: 0,0:04:38.69,0:04:41.36,Default,,0,0,0,,Нацу-кун, ол ештеңе жоқ дейді.
Dialogue: 0,0:04:42.24,0:04:45.11,Default,,0,0,0,,Кешіріңіз, неге бәріміз суға бармаймыз?
Dialogue: 0,0:04:47.70,0:04:48.45,Default,,0,0,0,,болды
Dialogue: 0,0:04:48.53,0:04:49.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:50.24,0:04:52.87,Default,,0,0,0,,Мен ұмытуға тырыссам да...
Dialogue: 0,0:04:53.37,0:04:56.21,Default,,0,0,0,,Біріншіден, біртүрлі түсінбеушіліктерге жол бермеңіз.
Dialogue: 0,0:04:57.79,0:04:59.63,Default,,0,0,0,,Kiss~?
Dialogue: 0,0:04:59.71,0:05:01.05,Default,,0,0,0,,Гармония жасамаңыз!
Dialogue: 0,0:05:01.13,0:05:03.26,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:05:03.34,0:05:06.72,Default,,0,0,0,,Жарайсың Нацу! Мен сендім
Dialogue: 0,0:05:06.80,0:05:07.89,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:05:07.97,0:05:09.30,Default,,0,0,0,,Маған айтпа
Dialogue: 0,0:05:09.39,0:05:12.89,Default,,0,0,0,,Алғашқы махаббатына үйлену әрбір ер адамның арманы.
Dialogue: 0,0:05:12.97,0:05:15.48,Default,,0,0,0,,Сондықтан мені дұрыс түсінбеңіздер деп айтып отырмын.
Dialogue: 0,0:05:15.56,0:05:16.27,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:16.35,0:05:18.65,Default,,0,0,0,,-(Йоко) Дж--(Рюджи) Иә?
Dialogue: 0,0:05:18.73,0:05:20.65,Default,,0,0,0,,Мен оны тартамын~
Dialogue: 0,0:05:20.73,0:05:21.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:22.11,0:05:25.61,Default,,0,0,0,,Көрініп тұр, Нацуо-кун, сен өзіңді неше жаста деп ойлайсың?
Dialogue: 0,0:05:25.70,0:05:27.53,Default,,0,0,0,,17! 17!
Dialogue: 0,0:05:27.61,0:05:31.45,Default,,0,0,0,,Сол кезде мен Атри-чанға ғашық болып, мүлдем лоли болдым...
Dialogue: 0,0:05:31.53,0:05:33.33,Default,,0,0,0,,Демек, сіз басқаша деп отырсыз!
Dialogue: 0,0:05:33.41,0:05:34.70,Default,,0,0,0,,Бірақ сен мені сүйдің, солай ма?
Dialogue: 0,0:05:34.79,0:05:38.12,Default,,0,0,0,,Бұл... кездейсоқтық.
Dialogue: 0,0:05:38.21,0:05:40.38,Default,,0,0,0,,Менің ойымша, бұл жай ғана шатасу сәті болды.
Dialogue: 0,0:05:40.46,0:05:42.59,Default,,0,0,0,,Жауапкершіліктен қашу
Dialogue: 0,0:05:43.17,0:05:45.09,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:05:45.17,0:05:47.80,Default,,0,0,0,,Ал, ең алдымен, әркім сабырлы ойланады.
Dialogue: 0,0:05:47.88,0:05:51.22,Default,,0,0,0,,Атри – адамнан ерекшеленетін гуманоид.
Dialogue: 0,0:05:51.30,0:05:55.14,Default,,0,0,0,,Бірақ Нацукун оның жүрегі болуы мүмкін деді.
Dialogue: 0,0:05:55.64,0:05:56.77,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:05:56.85,0:06:00.48,Default,,0,0,0,,Оларға адамдай қарамасаң аяйсың дейді.
Dialogue: 0,0:06:00.56,0:06:02.82,Default,,0,0,0,,Бұл... бірақ
Dialogue: 0,0:06:02.90,0:06:05.23,Default,,0,0,0,,Ең алдымен түсінікті болуымыз керек.
Dialogue: 0,0:06:05.32,0:06:07.24,Default,,0,0,0,,Нацуо-кунның сезімі
Dialogue: 0,0:06:07.32,0:06:08.74,Default,,0,0,0,,Сізде романтикалық сезімдер бар ма?
Dialogue: 0,0:06:10.74,0:06:13.79,Default,,0,0,0,,Егер сіз үндемей отырсаңыз, бұл оның рас екенін білдірмейді ме?
Dialogue: 0,0:06:14.37,0:06:17.54,Default,,0,0,0,,Шынымды айтсам... Білмеймін.
Dialogue: 0,0:06:17.62,0:06:19.29,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:06:21.67,0:06:24.71,Default,,0,0,0,,Атри да менің ойымда гуманоид.
Dialogue: 0,0:06:25.21,0:06:27.72,Default,,0,0,0,,Ол да менің алғашқы махаббатым еді...
Dialogue: 0,0:06:28.22,0:06:31.26,Default,,0,0,0,,Бұл бір түрлі тәртіпсіздік, мен оны шынымен түсінбеймін.
Dialogue: 0,0:06:31.84,0:06:33.01,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:33.51,0:06:36.56,Default,,0,0,0,,Ойланып қарасаңыз, бұл рас болуы мүмкін.
Dialogue: 0,0:06:37.06,0:06:39.35,Default,,0,0,0,,Күні кешеге дейін гуманоид болған бала
Dialogue: 0,0:06:39.44,0:06:42.98,Default,,0,0,0,,Бұл кенеттен өзіңе ұнаған қызға айналғандай.
Dialogue: 0,0:06:43.06,0:06:43.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:44.07,0:06:47.40,Default,,0,0,0,,Мен осындай жерде болдым, Нацуо-сан!
Dialogue: 0,0:06:47.90,0:06:48.53,Default,,0,0,0,,Не?
Dialogue: 0,0:06:48.61,0:06:53.07,Default,,0,0,0,,Кэтрин сабақты жіберіп алудың жаман екенін айтты.
Dialogue: 0,0:06:53.16,0:06:55.33,Default,,0,0,0,,Енді барлығына жүзу уақыты келді.
Dialogue: 0,0:06:55.41,0:06:57.33,Default,,0,0,0,,Мен жүзе алмаймын дейсің.
Dialogue: 0,0:06:58.04,0:07:02.79,Default,,0,0,0,,Кэтрин біраз жаттығу арқылы тіпті протездік аяғымен жүзуді үйренуге болатынын айтты.
Dialogue: 0,0:07:02.88,0:07:05.29,Default,,0,0,0,,Көрсеткіші жоғары маған қалдырыңыз.
Dialogue: 0,0:07:05.38,0:07:09.13,Default,,0,0,0,,Егер сіз оны Понкоцу Робоға қалдырсаңыз, қанша өміріңіз болса да, бұл жеткіліксіз болады.
Dialogue: 0,0:07:09.22,0:07:11.38,Default,,0,0,0,,Сіз тағы да айттыңыз!
Dialogue: 0,0:07:11.88,0:07:13.34,Default,,0,0,0,,Ах, ысқырық...
Dialogue: 0,0:07:13.43,0:07:16.68,Default,,0,0,0,,Хахаха, ұмыту - бұл жай ғана торт.
Dialogue: 0,0:07:16.76,0:07:18.60,Default,,0,0,0,,Мен сені енді кешірмеймін!
Dialogue: 0,0:07:18.68,0:07:20.81,Default,,0,0,0,,Айналдыратын алып зымыран соққысы!
Dialogue: 0,0:07:20.89,0:07:23.23,Default,,0,0,0,,Ой, бұл жаңа техника ма? Көріңіз, көріңіз
Dialogue: 0,0:07:23.31,0:07:25.61,Default,,0,0,0,,Үлкен айналмалы зымыран…
Dialogue: 0,0:07:27.19,0:07:29.19,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:07:29.28,0:07:31.32,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:07:32.07,0:07:34.03,Default,,0,0,0,,Бүгін біз не туралы сөйлестік?
Dialogue: 0,0:07:34.12,0:07:37.87,Default,,0,0,0,,Иә, маған салыстырмалылық теориясы деген нәрсе үйретілді.
Dialogue: 0,0:07:37.95,0:07:38.87,Default,,0,0,0,,Ринкаға?
Dialogue: 0,0:07:39.50,0:07:42.21,Default,,0,0,0,,Ририка-чан, сен мұны байыппен айтып тұрсың.
Dialogue: 0,0:07:42.29,0:07:45.33,Default,,0,0,0,,Академияға барып, әлемді қалпына келтіріңіз.
Dialogue: 0,0:07:45.84,0:07:47.75,Default,,0,0,0,,Нацукунға ұқсайды
Dialogue: 0,0:07:51.92,0:07:53.89,Default,,0,0,0,,- (Мо Мизуна) Дұрыс, Атри-чан - Иә.
Dialogue: 0,0:07:53.97,0:07:57.68,Default,,0,0,0,,Егер сіз үлгеретін болсаңыз, мен үйге сәл ертерек барып, оны дайындауым керек.
Dialogue: 0,0:07:57.76,0:07:58.89,Default,,0,0,0,,Кеш болады.
Dialogue: 0,0:07:58.97,0:08:01.18,Default,,0,0,0,,Не? Бірақ...
Dialogue: 0,0:08:01.27,0:08:02.77,Default,,0,0,0,,Мизуна Мое айтқандай орындаңыз.
Dialogue: 0,0:08:03.27,0:08:04.94,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:05.02,0:08:08.52,Default,,0,0,0,,Ал, Нацуо мырза, бүгінгі кешкі ас сіздің анаңызбен!
Dialogue: 0,0:08:08.61,0:08:09.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.78,0:08:12.82,Default,,0,0,0,,Ана?
Dialogue: 0,0:08:12.90,0:08:15.62,Default,,0,0,0,,Мен Атри-чанға тағы тамақ жасауды үйреттім.
Dialogue: 0,0:08:16.12,0:08:17.53,Default,,0,0,0,,Барған сайын жақсарып келеді.
Dialogue: 0,0:08:18.70,0:08:19.95,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:08:20.04,0:08:23.71,Default,,0,0,0,,Атри-чан Нацукунның бақытты болғанын қалайды.
Dialogue: 0,0:08:24.33,0:08:26.71,Default,,0,0,0,,Солай етсем, мен де бақытты боламын.
Dialogue: 0,0:08:28.79,0:08:34.30,Default,,0,0,0,,Мен, Нацукун айтқандай, Атри-чанның жүрегі бар деп ойлаймын.
Dialogue: 0,0:08:34.80,0:08:37.80,Default,,0,0,0,,Жасанды интеллект қалай табиғи және шынайы болуы мүмкін?
Dialogue: 0,0:08:37.89,0:08:39.47,Default,,0,0,0,,Сіз айта алмаймын деп ойлайтын нәрсе
Dialogue: 0,0:08:40.26,0:08:43.98,Default,,0,0,0,,Сондықтан өзіңізге адал болыңыз
Dialogue: 0,0:08:46.15,0:08:49.11,Default,,0,0,0,,Атриге дұрыстап қара.
Dialogue: 0,0:08:49.82,0:08:51.98,Default,,0,0,0,,Мен Нацукунның қолынан келетініне сенімдімін.
Dialogue: 0,0:08:53.15,0:08:54.07,Default,,0,0,0,,Мо Мизуна…
Dialogue: 0,0:08:55.36,0:08:58.62,Default,,0,0,0,,Нацу-кун, мен сені сүйем.
Dialogue: 0,0:08:59.12,0:09:00.08,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:09:18.84,0:09:20.64,Default,,0,0,0,,- (Рюджи) Жақсысың ба? - (Мизуна Мо) Иә?
Dialogue: 0,0:09:20.72,0:09:23.27,Default,,0,0,0,,Кешіріңіз, мен жасырын тыңдадым.
Dialogue: 0,0:09:23.35,0:09:26.60,Default,,0,0,0,,Бұл Нацуо-кунның арқасын итеріп жібергендей.
Dialogue: 0,0:09:27.44,0:09:29.44,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:29.52,0:09:31.44,Default,,0,0,0,,«Дұрыс»…
Dialogue: 0,0:09:33.99,0:09:37.36,Default,,0,0,0,,Мен, Нацукун академияға барғанда.
Dialogue: 0,0:09:37.45,0:09:39.41,Default,,0,0,0,,Мен жыламадым
Dialogue: 0,0:09:43.12,0:09:44.91,Default,,0,0,0,,- (Мое Мизуна) Сәттілік - (Нацуо) О
Dialogue: 0,0:09:46.66,0:09:49.25,Default,,0,0,0,,Мен сені көре алмай жалғыз қалуым керек.
Dialogue: 0,0:09:50.54,0:09:54.17,Default,,0,0,0,,Сонда да Нацукун өз мақсатына қарай келе жатыр
Dialogue: 0,0:09:54.76,0:09:55.88,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:09:58.09,0:10:00.18,Default,,0,0,0,,Мен сол артқа қарап ойландым
Dialogue: 0,0:10:00.93,0:10:04.68,Default,,0,0,0,,Мен де қолымнан келгеннің бәрін жасауға тырысамын.
Dialogue: 0,0:10:08.23,0:10:10.90,Default,,0,0,0,,Нацу-кун кішкентай кезінде
Dialogue: 0,0:10:10.98,0:10:14.07,Default,,0,0,0,,Анамның аяғымнан да айырылсам да.
Dialogue: 0,0:10:14.57,0:10:17.78,Default,,0,0,0,,Соған қарамастан мен жалғыз өзім көп оқимын.
Dialogue: 0,0:10:19.07,0:10:23.28,Default,,0,0,0,,Тоқтатылған уақытты жылжыту үшін бар күшіңізді салыңыз...
Dialogue: 0,0:10:23.78,0:10:28.25,Default,,0,0,0,,Мен Нацукунмен бірге болғым келмейді.
Dialogue: 0,0:10:30.04,0:10:32.96,Default,,0,0,0,,Мен бірге жұмыс істегім келеді.
Dialogue: 0,0:10:35.80,0:10:37.17,Default,,0,0,0,,- (Рюджи) Бірақ... - (Йоко) Тыныш.
Dialogue: 0,0:10:41.80,0:10:44.39,Default,,0,0,0,,Енді сол Атри-чан менің қасымда
Dialogue: 0,0:10:44.47,0:10:48.73,Default,,0,0,0,,Нацу-кун, мен сенің бұрынғы Нацу-кунға ұқсап бара жатқаныңды сеземін.
Dialogue: 0,0:10:51.90,0:10:54.27,Default,,0,0,0,,Бірге кешкі ас ішейік пе?
Dialogue: 0,0:10:55.02,0:10:55.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:55.86,0:11:00.86,Default,,0,0,0,,Кэтрин-сенсэй Ририкамен кешкі ас ішетінін айтты.
Dialogue: 0,0:11:00.95,0:11:01.74,Default,,0,0,0,,Мазаңызды алайық
Dialogue: 0,0:11:02.41,0:11:04.66,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:11:05.24,0:11:07.08,Default,,0,0,0,,А, онда мен де баратын шығармын.
Dialogue: 0,0:11:07.16,0:11:08.08,Default,,0,0,0,,- (Йоко) Амал жоқ - (Рюджи) А?
Dialogue: 0,0:11:08.16,0:11:10.00,Default,,0,0,0,,Бүгін ұл балаларға рұқсат етілмейді
Dialogue: 0,0:11:10.08,0:11:10.66,Default,,0,0,0,,Эй?
Dialogue: 0,0:11:13.17,0:11:14.09,Default,,0,0,0,,Иә
Dialogue: 0,0:11:16.25,0:11:17.51,Default,,0,0,0,,Бұл менің анам!
Dialogue: 0,0:11:17.59,0:11:19.09,Default,,0,0,0,,Ет пен картоп, солай ма?
Dialogue: 0,0:11:19.17,0:11:22.26,Default,,0,0,0,,Мое Мизуна оның анасының дәмі сияқты екенін айтты.
Dialogue: 0,0:11:24.72,0:11:26.60,Default,,0,0,0,,Хмм... дәмді.
Dialogue: 0,0:11:26.68,0:11:30.69,Default,,0,0,0,,Әрине мен өнімділігі жоғары адаммын!
Dialogue: 0,0:11:30.77,0:11:32.60,Default,,0,0,0,,Үй жұмысын мүлтіксіз орындаймын.
Dialogue: 0,0:11:33.19,0:11:34.98,Default,,0,0,0,,Қай ауыз сөйлейді?
Dialogue: 0,0:11:35.06,0:11:36.73,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:11:36.82,0:11:40.82,Default,,0,0,0,,Гамбургерлерге келетін болсақ, 107 сәтсіздіктен кейін сәтті болады.
Dialogue: 0,0:11:40.90,0:11:44.66,Default,,0,0,0,,Бұл 74-ші сәтті әрекет.
Dialogue: 0,0:11:44.74,0:11:47.41,Default,,0,0,0,,Менің қандай күшті екенімді көрдің бе?
Dialogue: 0,0:11:47.49,0:11:49.45,Default,,0,0,0,,Сіз соншалықты сәтсіздікке ұшырадыңыз ба?
Dialogue: 0,0:11:49.54,0:11:51.50,Default,,0,0,0,,Ой, уайымдама.
Dialogue: 0,0:11:51.58,0:11:54.46,Default,,0,0,0,,Сәтсіз болғандарды Мизуна Мо өзгертті.
Dialogue: 0,0:11:54.54,0:11:56.84,Default,,0,0,0,,Бұл бәрімізге қатты ұнады
Dialogue: 0,0:11:57.59,0:12:00.05,Default,,0,0,0,,Осыншама жасағың келе ме?
Dialogue: 0,0:12:00.13,0:12:01.17,Default,,0,0,0,,Иә
Dialogue: 0,0:12:01.26,0:12:03.84,Default,,0,0,0,,Нацуо-санның дәмді болғанына қуаныштымын.
Dialogue: 0,0:12:04.55,0:12:06.22,Default,,0,0,0,,Неге бақыттысың?
Dialogue: 0,0:12:06.30,0:12:08.01,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:08.10,0:12:09.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:09.43,0:12:13.64,Default,,0,0,0,,Нацуо-санға пайдалы болғандықтан... мүмкін бе?
Dialogue: 0,0:12:14.23,0:12:16.65,Default,,0,0,0,,Неліктен бұл пайдалы болса, сіз өзіңізді бақытты сезінесіз?
Dialogue: 0,0:12:16.73,0:12:19.86,Default,,0,0,0,,Хмм, бұл рас.
Dialogue: 0,0:12:19.94,0:12:22.49,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:23.32,0:12:25.20,Default,,0,0,0,,Ах! Мен түсінемін
Dialogue: 0,0:12:25.28,0:12:26.53,Default,,0,0,0,,«Маған ұнайды».
Dialogue: 0,0:12:26.62,0:12:28.03,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:12:28.12,0:12:31.20,Default,,0,0,0,,Мен түсінемін, өйткені маған «ұнатады».
Dialogue: 0,0:12:31.29,0:12:33.79,Default,,0,0,0,,Бұл жай ғана «ұнайды» емес
Dialogue: 0,0:12:33.87,0:12:35.71,Default,,0,0,0,,Өйткені менің ғашығым мені «ұнатады».
Dialogue: 0,0:12:36.38,0:12:37.50,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:38.00,0:12:41.09,Default,,0,0,0,,Мен оны жұлып алғандай болдым.
Dialogue: 0,0:12:41.17,0:12:43.05,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:12:43.13,0:12:47.09,Default,,0,0,0,,Жоқ, егер сіз шынымен де осылай айтқыңыз келсе, бәрібір.
Dialogue: 0,0:12:51.89,0:12:53.85,Default,,0,0,0,,-Бұл менің шынайы сезімім.-(Нацуо) А...
Dialogue: 0,0:12:56.35,0:12:58.98,Default,,0,0,0,,Мен сені жақсы көремін, Нацуо-сан.
Dialogue: 0,0:13:06.20,0:13:06.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:07.49,0:13:10.41,Default,,0,0,0,,Менің қарным ашты. тамақ ішейік.
Dialogue: 0,0:13:11.16,0:13:13.79,Default,,0,0,0,,Ет пен картопты суытып жіберуге болмайды.
Dialogue: 0,0:13:15.75,0:13:16.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:25.22,0:13:26.72,Default,,0,0,0,,Қиын
Dialogue: 0,0:13:27.43,0:13:31.72,Default,,0,0,0,,Біріншіден, менде Атриге деген романтикалық сезімдер бар ма?
Dialogue: 0,0:13:32.39,0:13:34.02,Default,,0,0,0,,Атри - атри
Dialogue: 0,0:13:34.10,0:13:37.73,Default,,0,0,0,,Рұқсатсыз мен сол кезден қызға тамсана бердім...
Dialogue: 0,0:13:37.81,0:13:42.15,Default,,0,0,0,,Жоқ...бірақ ол кездегі қыз Атри болатын.
Dialogue: 0,0:13:42.65,0:13:44.32,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:13:44.40,0:13:47.24,Default,,0,0,0,,Не деп күбірлеп тұрсың?
Dialogue: 0,0:13:48.41,0:13:49.16,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:13:50.24,0:13:52.99,Default,,0,0,0,,Неге олай киініп жүрсің...
Dialogue: 0,0:13:53.58,0:13:57.29,Default,,0,0,0,,Нацуо-сан маған суға түсуді бұйырды, себебі ол қайнағалы жатыр.
Dialogue: 0,0:13:57.37,0:13:59.46,Default,,0,0,0,,Сонымен... солай болды ма?
Dialogue: 0,0:14:00.96,0:14:01.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:03.84,0:14:05.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:05.13,0:14:06.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:06.34,0:14:07.84,Default,,0,0,0,,Жоқ... сәл күте тұрыңыз.
Dialogue: 0,0:14:07.93,0:14:09.47,Default,,0,0,0,,О~
Dialogue: 0,0:14:09.55,0:14:11.05,Default,,0,0,0,,Мм... Жалт қарады
Dialogue: 0,0:14:11.14,0:14:13.06,Default,,0,0,0,,Ой... Уау!
Dialogue: 0,0:14:13.64,0:14:16.56,Default,,0,0,0,,Күлкілі, Нацуо-сан айқайлайды.
Dialogue: 0,0:14:17.27,0:14:20.02,Default,,0,0,0,,Сондықтан мен саған тоқта деп айттым!
Dialogue: 0,0:14:20.10,0:14:21.11,Default,,0,0,0,,Бірінші (Бір) фильмнің басты кейіпкерінің немересі, екінші (Екі) фильмнің кінәлісінің немересі—
Dialogue: 0,0:14:21.19,0:14:23.11,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:23.19,0:14:24.73,Default,,0,0,0,,Қазір қызыл
Dialogue: 0,0:14:24.82,0:14:28.11,Default,,0,0,0,,Нацуо-санды түсіну өте оңай.
Dialogue: 0,0:14:28.20,0:14:30.49,Default,,0,0,0,,Сүйкімді болғандықтан, оны мазақтауға тұрарлық.
Dialogue: 0,0:14:32.32,0:14:33.78,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:34.49,0:14:35.33,Default,,0,0,0,,Бұл…
Dialogue: 0,0:14:35.41,0:14:37.79,Default,,0,0,0,,Иә! Мияу... мияу...
Dialogue: 0,0:14:37.87,0:14:41.46,Default,,0,0,0,,Мияу!
Dialogue: 0,0:14:42.63,0:14:44.00,Default,,0,0,0,,Бұл робохара!
Dialogue: 0,0:14:44.09,0:14:47.46,Default,,0,0,0,,Мен сені қайтара алмайтынымды пайдаланып қалуға қалай дәтің бар?
Dialogue: 0,0:14:47.55,0:14:48.67,Default,,0,0,0,,Шулы!
Dialogue: 0,0:14:48.76,0:14:51.64,Default,,0,0,0,,Біз Понкоцу Робоның жыныстық қудалауын тоқтаттық.
Dialogue: 0,0:14:51.72,0:14:54.22,Default,,0,0,0,,Сондықтан зорлық жақсы емес!
Dialogue: 0,0:14:54.31,0:14:56.85,Default,,0,0,0,,Хмф! Бұл төтенше жағдай болды.
Dialogue: 0,0:14:56.93,0:14:57.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:58.81,0:15:00.23,Default,,0,0,0,,Эй, Сакута. Иә, не болды?
Dialogue: 0,0:15:00.31,0:15:02.15,Default,,0,0,0,,Кэтрин маған берді
Dialogue: 0,0:15:02.23,0:15:05.73,Default,,0,0,0,,Оны міндетті түрде «ИӘ» белгісін жоғары қаратып пайдаланыңыз.
Dialogue: 0,0:15:05.82,0:15:08.86,Default,,0,0,0,,Сонда Нацуо-сан маған мейірімді болды.
Dialogue: 0,0:15:08.94,0:15:11.74,Default,,0,0,0,,Ол маған мейірімді болады...
Dialogue: 0,0:15:11.82,0:15:14.03,Default,,0,0,0,,Иә Жоқ?
Dialogue: 0,0:15:21.58,0:15:22.96,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:15:23.83,0:15:25.92,Default,,0,0,0,,Ха... білмеймін.
Dialogue: 0,0:15:26.00,0:15:28.92,Default,,0,0,0,,Иә, күте тұрыңыз.
Dialogue: 0,0:15:29.01,0:15:30.42,Default,,0,0,0,,Уау! Эй...
Dialogue: 0,0:15:30.51,0:15:31.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:35.05,0:15:36.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:37.68,0:15:39.35,Default,,0,0,0,,Нацуо-сан…
Dialogue: 0,0:16:04.92,0:16:07.29,Default,,0,0,0,,Өзіңізге адал болыңыз...
Dialogue: 0,0:16:07.88,0:16:08.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:09.34,0:16:12.26,Default,,0,0,0,,Оян, менде бір ой бар.
Dialogue: 0,0:16:16.35,0:16:18.93,Default,,0,0,0,,Жарайды, осындай нәрсе ме?
Dialogue: 0,0:16:19.01,0:16:20.93,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:16:21.93,0:16:22.89,Default,,0,0,0,,Төсек...
Dialogue: 0,0:16:22.98,0:16:24.90,Default,,0,0,0,,Атри бүгіннен бастап осында ұйықтайды.
Dialogue: 0,0:16:24.98,0:16:26.73,Default,,0,0,0,,Иә! Неліктен?
Dialogue: 0,0:16:26.81,0:16:29.40,Default,,0,0,0,,Онда мен Нацуо-саннан кетемін.
Dialogue: 0,0:16:29.48,0:16:32.86,Default,,0,0,0,,Бұл жақсы, өйткені бұл бірінші кезекте қалыпты жағдай.
Dialogue: 0,0:16:32.95,0:16:36.91,Default,,0,0,0,,Нацуо-сан, менің қасымда болғанымды жек көресің бе?
Dialogue: 0,0:16:36.99,0:16:39.66,Default,,0,0,0,,Сіз мені жек көре бастадыңыз ба?
Dialogue: 0,0:16:39.74,0:16:42.00,Default,,0,0,0,,Жоқ, бұл маған ұнайды.
Dialogue: 0,0:16:42.50,0:16:45.46,Default,,0,0,0,,А, жоқ... Маңызды деп айту дұрыс па?
Dialogue: 0,0:16:46.67,0:16:47.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:50.80,0:16:52.21,Default,,0,0,0,,Бүгіннен бастап Атори
Dialogue: 0,0:16:52.30,0:16:54.97,Default,,0,0,0,,Мен оны жүрегі бар гуманоид ретінде көруді шештім.
Dialogue: 0,0:16:55.47,0:16:59.81,Default,,0,0,0,,Кез келген адам сияқты жүрегі жараланатын адам ретінде.
Dialogue: 0,0:16:59.89,0:17:02.22,Default,,0,0,0,,Олай болса, не болады?
Dialogue: 0,0:17:02.85,0:17:03.77,Default,,0,0,0,,О
Dialogue: 0,0:17:04.44,0:17:07.48,Default,,0,0,0,,Жүрек күрделі, нәзік.
Dialogue: 0,0:17:07.56,0:17:09.73,Default,,0,0,0,,Мұны түсіну оңай емес.
Dialogue: 0,0:17:10.32,0:17:12.61,Default,,0,0,0,,«Ұнату» және «ұнатпау» одан да көп.
Dialogue: 0,0:17:12.69,0:17:13.69,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:17:13.78,0:17:17.91,Default,,0,0,0,,Мүмкін Атри әлі ештеңе түсінбеді.
Dialogue: 0,0:17:18.66,0:17:19.91,Default,,0,0,0,,Өлтірді… Қылыш Қасиеттісін?
Dialogue: 0,0:17:19.99,0:17:22.70,Default,,0,0,0,,Бірте-бірте «қуанышты» және «қайғыны» сезініңіз
Dialogue: 0,0:17:23.20,0:17:25.46,Default,,0,0,0,,Сол рухты өсіргеніңізді қалаймын.
Dialogue: 0,0:17:26.04,0:17:27.58,Default,,0,0,0,,Нацуо-сан…
Dialogue: 0,0:17:28.42,0:17:31.42,Default,,0,0,0,,Бұдан басқа, егер сіз «ұнату» дегенді түсінсеңіз
Dialogue: 0,0:17:31.50,0:17:34.21,Default,,0,0,0,,Екі адам өз сезімдеріне қарсы тұра алса
Dialogue: 0,0:17:34.72,0:17:37.05,Default,,0,0,0,,Сол кезде одан кейін не болатынын ойланайық.
Dialogue: 0,0:17:38.30,0:17:41.76,Default,,0,0,0,,Мм... Мен шынымен түсінбеймін.
Dialogue: 0,0:17:42.26,0:17:45.60,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:17:46.10,0:17:49.19,Default,,0,0,0,,Қарапайым тілмен айтқанда...
Dialogue: 0,0:17:49.27,0:17:51.11,Default,,0,0,0,,Қысқасы?
Dialogue: 0,0:17:53.19,0:17:55.74,Default,,0,0,0,,Бұрынғыдай.
Dialogue: 0,0:17:59.62,0:18:02.74,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:18:02.83,0:18:04.24,Default,,0,0,0,,Пуха~!
Dialogue: 0,0:18:04.33,0:18:06.96,Default,,0,0,0,,А? Бұл қандай көздер?
Dialogue: 0,0:18:07.04,0:18:10.75,Default,,0,0,0,,Ересек болған соң, ішсең де бәрібір, солай ма?
Dialogue: 0,0:18:11.25,0:18:14.42,Default,,0,0,0,,Кэтрин-сенсэй ішкен кезде қандай көрінеді?
Dialogue: 0,0:18:14.51,0:18:15.96,Default,,0,0,0,,Мен ұмытып қалдым...
Dialogue: 0,0:18:16.05,0:18:19.01,Default,,0,0,0,,Айтайын дегенім, маған біраздан бері қызық болды.
Dialogue: 0,0:18:19.09,0:18:21.93,Default,,0,0,0,,Профессор Кэтрин қай елден?
Dialogue: 0,0:18:22.01,0:18:23.85,Default,,0,0,0,,Ах, Жапония.
Dialogue: 0,0:18:23.93,0:18:24.89,Default,,0,0,0,,Шындығында, Хана-чан...
Dialogue: 0,0:18:24.97,0:18:26.52,Default,,0,0,0,,Мені Хана Чан деп атама.
Dialogue: 0,0:18:28.10,0:18:31.86,Default,,0,0,0,,Ринка-чан, өтінемін, қатты тырыспа.
Dialogue: 0,0:18:31.94,0:18:33.82,Default,,0,0,0,,Иә? Сіз қолыңыздан келгеннің бәрін жасағыңыз келе ме?
Dialogue: 0,0:18:33.90,0:18:36.69,Default,,0,0,0,,Жоқ, мен оны қызықты болғандықтан шештім.
Dialogue: 0,0:18:36.78,0:18:37.86,Default,,0,0,0,,Бұл көңілді ме?
Dialogue: 0,0:18:37.95,0:18:40.95,Default,,0,0,0,,Иә, бәрі көп еңбек ету керемет дейді.
Dialogue: 0,0:18:41.03,0:18:43.24,Default,,0,0,0,,Мен мұны жай ғана көңілді болғандықтан істеп жатырмын.
Dialogue: 0,0:18:43.33,0:18:45.37,Default,,0,0,0,,Біртүрлі екен, солай емес пе?
Dialogue: 0,0:18:45.87,0:18:47.96,Default,,0,0,0,,Сақ болайық... Менің айтайын дегенім осы шығар.
Dialogue: 0,0:18:48.04,0:18:49.04,Default,,0,0,0,,Иә
Dialogue: 0,0:18:49.12,0:18:52.00,Default,,0,0,0,,Сондықтан жүрек ауырады
Dialogue: 0,0:18:52.67,0:18:53.67,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:54.55,0:18:57.26,Default,,0,0,0,,Мен бұл туралы шындап ойлануым керек шығар.
Dialogue: 0,0:19:00.09,0:19:02.30,Default,,0,0,0,,Біртүрлі сезіледі.
Dialogue: 0,0:19:02.39,0:19:05.56,Default,,0,0,0,,Әдетте бәрі осылай ұйықтай ма?
Dialogue: 0,0:19:05.64,0:19:06.81,Default,,0,0,0,,Саана
Dialogue: 0,0:19:06.89,0:19:10.02,Default,,0,0,0,,Біреулер ондай, біреулер ондай емес.
Dialogue: 0,0:19:10.10,0:19:11.15,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:19:11.23,0:19:12.31,Default,,0,0,0,,Әртүрлі заттар...
Dialogue: 0,0:19:12.40,0:19:15.98,Default,,0,0,0,,Әй, адамдардың жүрегі бөлек.
Dialogue: 0,0:19:16.07,0:19:17.82,Default,,0,0,0,,«Жақсы» немесе «жаман» ғана емес
Dialogue: 0,0:19:17.90,0:19:20.57,Default,,0,0,0,,«Дұрыс» немесе «бұрыс» ғана емес
Dialogue: 0,0:19:21.70,0:19:23.82,Default,,0,0,0,,Кейде мен қателесемін
Dialogue: 0,0:19:24.99,0:19:26.24,Default,,0,0,0,,Қате...
Dialogue: 0,0:19:26.99,0:19:28.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:29.62,0:19:33.46,Default,,0,0,0,,Менде шын жүрек бар ма?
Dialogue: 0,0:19:34.88,0:19:36.88,Default,,0,0,0,,Мен бар екеніне сенемін
Dialogue: 0,0:19:40.05,0:19:41.09,Default,,0,0,0,,Мен ұйықтайын деп жатырмын
Dialogue: 0,0:19:42.34,0:19:44.09,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:44.18,0:19:44.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:45.39,0:19:47.60,Default,,0,0,0,,Маған қамқорлық көрсеткеніңіз үшін рахмет
Dialogue: 0,0:19:47.68,0:19:49.81,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:19:50.68,0:19:52.52,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:19:52.60,0:19:55.73,Default,,0,0,0,,Атридың арқасында мен өлген жоқпын.
Dialogue: 0,0:19:58.78,0:19:59.94,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:20:00.49,0:20:04.24,Default,,0,0,0,,Неге маған осындай жылы сөздер айттың?
Dialogue: 0,0:20:04.32,0:20:07.33,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:20:07.95,0:20:09.54,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:10.75,0:20:11.96,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:13.92,0:20:15.88,Default,,0,0,0,,Себебі мені оқытты
Dialogue: 0,0:20:17.17,0:20:19.13,Default,,0,0,0,,(Нацуоның ұйқысы)
Dialogue: 0,0:20:22.88,0:20:25.05,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:20:27.35,0:20:30.93,Default,,0,0,0,,Бұл... ауырады... ауырады
Dialogue: 0,0:20:31.43,0:20:32.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:33.39,0:20:34.81,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:20:36.65,0:20:40.07,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:20:41.15,0:20:44.24,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:20:44.74,0:20:45.57,Default,,0,0,0,,Цу!
Dialogue: 0,0:20:45.66,0:20:46.91,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:47.70,0:20:48.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:48.49,0:20:50.87,Default,,0,0,0,,(Атридің ұйқысы)
Dialogue: 0,0:20:50.95,0:20:51.83,Default,,0,0,0,,Atri?
Dialogue: 0,0:20:55.83,0:20:56.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:00.25,0:21:01.09,Default,,0,0,0,,Поцелу…
Dialogue: 0,0:21:02.09,0:21:02.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:04.88,0:21:06.64,Default,,0,0,0,,«Мен қалай әрекет ететінімді білмедім».
Dialogue: 0,0:21:06.72,0:21:10.64,Default,,0,0,0,,«Мен бұрын көрген анықтамаларды көшіру арқылы алға шықтым».
Dialogue: 0,0:21:11.14,0:21:14.98,Default,,0,0,0,,«Нацуо-сан өзін табиғаттан тыс сезінбейтін сияқты».
Dialogue: 0,0:21:15.06,0:21:18.44,Default,,0,0,0,,«Ол маған оны ұнататынын айтты, сондықтан мен оны ұнатамын деп жауап бердім».
Dialogue: 0,0:21:18.94,0:21:23.65,Default,,0,0,0,,«Алайда, Нацуо-санның ұнатулары мен күткеннен басқаша болды».
Dialogue: 0,0:21:23.74,0:21:27.61,Default,,0,0,0,,«Сүйіктің нені ұнататынын біл және материалдарды ізде»
Dialogue: 0,0:21:27.70,0:21:28.57,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:28.66,0:21:32.16,Default,,0,0,0,,«Сүйісуді үйрен, жыныстық қатынасқа түсуді үйрен»
Dialogue: 0,0:21:32.24,0:21:36.42,Default,,0,0,0,,«Келісімге жету процесін үйреніңіз»
Dialogue: 0,0:21:36.50,0:21:39.71,Default,,0,0,0,,«Нацуо мырзаның күмәні жоқ».
Dialogue: 0,0:21:40.63,0:21:42.50,Default,,0,0,0,,«Менде жүрегім бар деп жауап бердім».
Dialogue: 0,0:21:46.51,0:21:47.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:53.68,0:21:55.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:56.85,0:21:58.23,Default,,0,0,0,,Нацуо-сан
Dialogue: 0,0:21:59.48,0:22:00.23,Default,,0,0,0,,Келме...
Dialogue: 0,0:22:00.81,0:22:01.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:03.48,0:22:04.90,Default,,0,0,0,,Демек, бұл… иллюзия.
Dialogue: 0,0:22:10.99,0:22:12.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:37.91,0:23:39.91,Default,,0,0,0,,～♪
