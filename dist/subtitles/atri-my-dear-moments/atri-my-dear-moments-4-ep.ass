Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.37,0:00:04.50,Default,,0,0,0,,Уау! Хахаха
Dialogue: 0,0:00:05.21,0:00:06.50,Default,,0,0,0,,Жылдам жылдам!
Dialogue: 0,0:00:06.58,0:00:08.59,Default,,0,0,0,,Салқын жел
Dialogue: 0,0:00:08.67,0:00:11.01,Default,,0,0,0,,Артқы жағындағы су спрейі керемет!
Dialogue: 0,0:00:11.51,0:00:13.13,Default,,0,0,0,,Құлап кетпеу үшін сақ болыңыз
Dialogue: 0,0:00:15.80,0:00:16.64,Default,,0,0,0,,Бұл жақсы, солай ма?
Dialogue: 0,0:00:19.60,0:00:21.73,Default,,0,0,0,,Сіз мұны істей аламын деп шынымен ойлайсыз ба?
Dialogue: 0,0:00:21.81,0:00:22.68,Default,,0,0,0,,Не?
Dialogue: 0,0:00:22.77,0:00:24.35,Default,,0,0,0,,Толқынды электр энергиясын өндіру
Dialogue: 0,0:00:24.44,0:00:26.27,Default,,0,0,0,,Теориялық тұрғыдан мүмкін болуы керек
Dialogue: 0,0:00:26.86,0:00:29.73,Default,,0,0,0,,Генератор жел немесе атом энергиясы ма.
Dialogue: 0,0:00:29.82,0:00:32.24,Default,,0,0,0,,Негіздер турбинаны қалай бұру керек.
Dialogue: 0,0:00:32.32,0:00:34.20,Default,,0,0,0,,Бұл соншалықты қиын емес.
Dialogue: 0,0:00:34.28,0:00:36.16,Default,,0,0,0,,Тек балалар бар.
Dialogue: 0,0:00:36.24,0:00:38.53,Default,,0,0,0,,Төменгі материалдар немесе құралдар жоқ.
Dialogue: 0,0:00:38.62,0:00:40.83,Default,,0,0,0,,Сондықтан мен сені іздеп келдім.
Dialogue: 0,0:00:41.83,0:00:43.50,Default,,0,0,0,,Қолыңнан келмесе, не істейсің?
Dialogue: 0,0:00:44.08,0:00:45.96,Default,,0,0,0,,Бұл мүмкін емес болып шықты.
Dialogue: 0,0:00:46.04,0:00:48.00,Default,,0,0,0,,Содан кейін мен келесі қадамым туралы ойлана бастаймын.
Dialogue: 0,0:00:48.08,0:00:49.71,Default,,0,0,0,,Бұл прогресс, солай ма?
Dialogue: 0,0:00:53.05,0:00:53.97,Default,,0,0,0,,Хун
Dialogue: 0,0:00:54.63,0:00:55.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:58.18,0:00:59.26,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:00:59.35,0:01:01.18,Default,,0,0,0,,Неліктен Мо Мизуна купальник киіп жүр?
Dialogue: 0,0:01:01.26,0:01:03.06,Default,,0,0,0,,Иә? Жоқ?
Dialogue: 0,0:01:03.14,0:01:05.94,Default,,0,0,0,,Атри-чанның суға түсетіні анық...
Dialogue: 0,0:01:06.02,0:01:08.94,Default,,0,0,0,,Бұл мұхит түбінде. Сіз ама дайвер болмасаңыз, мұны істей алмайсыз.
Dialogue: 0,0:01:09.02,0:01:11.23,Default,,0,0,0,,Бұл электр энергиясы туралы не?
Dialogue: 0,0:01:11.73,0:01:13.44,Default,,0,0,0,,-Кеттік! -(Ринка) А?
Dialogue: 0,0:01:15.07,0:01:17.28,Default,,0,0,0,,Уау, Аторин, тамаша!
Dialogue: 0,0:01:17.36,0:01:19.16,Default,,0,0,0,,Өйткені, бұл Мизуна Моның әпкесі.
Dialogue: 0,0:01:19.24,0:01:21.53,Default,,0,0,0,,Кіші мектепте оқып жүргенімде киген купальнигім тамаша болды.
Dialogue: 0,0:01:21.62,0:01:22.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:23.66,0:01:27.54,Default,,0,0,0,,Неліктен мені мақтап жатса да, өзімді жайсыз сезінемін?
Dialogue: 0,0:01:29.79,0:01:32.05,Default,,0,0,0,,Жарайды, біз келдік.
Dialogue: 0,0:01:33.17,0:01:34.46,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:01:35.88,0:01:37.30,Default,,0,0,0,,Бастайсыз ба?
Dialogue: 0,0:01:38.51,0:01:40.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:02.80,0:03:04.80,Default,,0,0,0,,～♪
Dialogue: 0,0:03:09.14,0:03:10.27,Default,,0,0,0,,Нацу-кун
Dialogue: 0,0:03:10.35,0:03:11.44,Default,,0,0,0,,Нацу-кун, сен мені естисің бе?
Dialogue: 0,0:03:12.06,0:03:13.86,Default,,0,0,0,,Аа, мен жаңа ғана келдім.
Dialogue: 0,0:03:13.94,0:03:15.11,Default,,0,0,0,,Қай жерде?
Dialogue: 0,0:03:15.61,0:03:19.61,Default,,0,0,0,,Бұл... Каннонның алдындағы қиылыс.
Dialogue: 0,0:03:20.70,0:03:22.57,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:03:22.66,0:03:23.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:23.62,0:03:25.99,Default,,0,0,0,,Кенет бетіңізді көрсетпеңіз
Dialogue: 0,0:03:26.70,0:03:28.04,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз бара аламын деп ойлайсыз ба?
Dialogue: 0,0:03:29.62,0:03:32.87,Default,,0,0,0,,Сондықтан мен сізді ести алмаймын дедім.
Dialogue: 0,0:03:43.97,0:03:44.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:45.01,0:03:45.55,Default,,0,0,0,,Не?
Dialogue: 0,0:03:46.35,0:03:49.14,Default,,0,0,0,,Мен бұл жерде Имагава яки дүкені екеніне сенімдімін.
Dialogue: 0,0:03:49.22,0:03:50.52,Default,,0,0,0,,А, мен білемін!
Dialogue: 0,0:03:50.60,0:03:52.60,Default,,0,0,0,,Мен оны әрқашан анама сатып алатынмын.
Dialogue: 0,0:03:52.69,0:03:55.02,Default,,0,0,0,,Рю-чан кремнің жанкүйері болды, солай ма?
Dialogue: 0,0:03:56.31,0:03:58.52,Default,,0,0,0,,Біздің зауыт табылды ма?
Dialogue: 0,0:03:58.61,0:03:59.82,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:59.90,0:04:01.07,Default,,0,0,0,,Міне, болды.
Dialogue: 0,0:04:01.15,0:04:01.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:02.86,0:04:04.41,Default,,0,0,0,,«Нодзима Сейки»
Dialogue: 0,0:04:05.45,0:04:06.70,Default,,0,0,0,,Сізді Нодзима деп атайды ма?
Dialogue: 0,0:04:06.78,0:04:07.99,Default,,0,0,0,,Шулы
Dialogue: 0,0:04:08.49,0:04:10.83,Default,,0,0,0,,Шайыр артқы қоймада.
Dialogue: 0,0:04:12.25,0:04:13.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:13.08,0:04:14.58,Default,,0,0,0,,(дауыссыз дауыс)
Dialogue: 0,0:04:14.67,0:04:16.50,Default,,0,0,0,,Сонда сіз естімеймін дейсіз бе?
Dialogue: 0,0:04:16.58,0:04:18.04,Default,,0,0,0,,Бұл краб! Бұл краб!
Dialogue: 0,0:04:18.13,0:04:20.00,Default,,0,0,0,,«Бұл краб, бұл краб емес!»
Dialogue: 0,0:04:20.59,0:04:22.72,Default,,0,0,0,,Хаа... жарайды.
Dialogue: 0,0:04:22.80,0:04:27.35,Default,,0,0,0,,Рюджидің айтуынша, ол жерде қоймада шайыр бар барабандар болуы керек.
Dialogue: 0,0:04:30.10,0:04:31.22,Default,,0,0,0,,Гааах!
Dialogue: 0,0:04:31.93,0:04:34.27,Default,,0,0,0,,Сонда да сол өрнек
Dialogue: 0,0:04:34.89,0:04:37.11,Default,,0,0,0,,Ерекше аңғардан оңай өтеді.
Dialogue: 0,0:04:37.61,0:04:38.94,Default,,0,0,0,,Таңқаларлық алқап?
Dialogue: 0,0:04:39.02,0:04:43.44,Default,,0,0,0,,Робот адамның мимикасын белгілі бір дәрежеде қайталай алатын болған кезде
Dialogue: 0,0:04:43.53,0:04:46.11,Default,,0,0,0,,Бұл адамдарға жиіркенішті құбылыс.
Dialogue: 0,0:04:46.61,0:04:48.66,Default,,0,0,0,,Гуманоидтар жеңуі керек
Dialogue: 0,0:04:48.74,0:04:50.20,Default,,0,0,0,,Бұл алқап деп айтылады.
Dialogue: 0,0:04:50.79,0:04:52.70,Default,,0,0,0,,Атри-чан мұны істеді ме?
Dialogue: 0,0:04:53.33,0:04:54.21,Default,,0,0,0,,Солай ет.
Dialogue: 0,0:04:55.58,0:04:58.63,Default,,0,0,0,,Бұл оның адамға жақын жаратылғанын білдіре ме?
Dialogue: 0,0:05:03.76,0:05:04.97,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:05:06.30,0:05:07.97,Default,,0,0,0,,Бұл краб!
Dialogue: 0,0:05:08.55,0:05:10.81,Default,,0,0,0,,Бұл краб! Бұл краб!
Dialogue: 0,0:05:10.89,0:05:12.72,Default,,0,0,0,,Роботтар неге сонша бақытты?
Dialogue: 0,0:05:13.43,0:05:16.73,Default,,0,0,0,,Шаян дәмді. Дәмді - бақытты дегенді білдіреді.
Dialogue: 0,0:05:19.56,0:05:21.15,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:05:21.23,0:05:22.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:23.40,0:05:25.57,Default,,0,0,0,,Бұл Имагава ыдысы.
Dialogue: 0,0:05:25.65,0:05:27.82,Default,,0,0,0,,Ах, оны әлі де қолдануға болатын сияқты.
Dialogue: 0,0:05:28.66,0:05:32.24,Default,,0,0,0,,Материалдар Оларды жинауға болады ма? үшін тәтті жегісі келеді, солай ма?
Dialogue: 0,0:05:32.33,0:05:34.08,Default,,0,0,0,,Нацу-кун!
Dialogue: 0,0:05:34.70,0:05:37.37,Default,,0,0,0,,Ұн, жұмыртқа және қызыл бұршақ пастасы, солай ма?
Dialogue: 0,0:05:37.46,0:05:38.71,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:05:38.79,0:05:41.13,Default,,0,0,0,,Ал шайыр ше?
Dialogue: 0,0:05:41.21,0:05:42.80,Default,,0,0,0,,Бұл бастапқы мақсат, солай ма?
Dialogue: 0,0:05:43.55,0:05:44.38,Default,,0,0,0,,О
Dialogue: 0,0:05:44.46,0:05:46.80,Default,,0,0,0,,Қақпақ қатты, тесіктері жоқ.
Dialogue: 0,0:05:46.88,0:05:48.09,Default,,0,0,0,,Мүмкін оны қолдануға болады.
Dialogue: 0,0:05:48.18,0:05:48.89,Default,,0,0,0,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,0:05:48.97,0:05:52.89,Default,,0,0,0,,Мен де зауыттан қолдануға болатын құралдарды таптым.
Dialogue: 0,0:05:52.97,0:05:54.22,Default,,0,0,0,,Сіз қарай аласыз ба?
Dialogue: 0,0:05:54.31,0:05:55.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:55.56,0:05:59.02,Default,,0,0,0,,Бол... Саған осы ғана керек пе, маған бәрібір.
Dialogue: 0,0:06:00.10,0:06:01.19,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:01.77,0:06:05.44,Default,,0,0,0,,Жарайды, аралға қайтып келгенде, бәріміз барбекю жасаймыз!
Dialogue: 0,0:06:05.53,0:06:06.61,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:06.69,0:06:08.53,Default,,0,0,0,,Шаян! Теңіз шаяны!
Dialogue: 0,0:06:12.53,0:06:14.49,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:06:14.99,0:06:16.45,Default,,0,0,0,,Бұл дәмді!
Dialogue: 0,0:06:16.54,0:06:18.41,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:06:18.92,0:06:20.96,Default,,0,0,0,,Роботтар тамақ жей ме?
Dialogue: 0,0:06:21.04,0:06:21.96,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:06:22.04,0:06:23.38,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:23.46,0:06:25.67,Default,,0,0,0,,Оны жеудің қажеті жоқ.
Dialogue: 0,0:06:25.76,0:06:29.30,Default,,0,0,0,,Мен өнімділігі жоғары адам ретінде көп жей аламын!
Dialogue: 0,0:06:29.38,0:06:33.47,Default,,0,0,0,,Оның үстіне оларда адамдар сияқты сезімтал дәм сезімі бар.
Dialogue: 0,0:06:33.55,0:06:36.31,Default,,0,0,0,,Керемет... иә?
Dialogue: 0,0:06:36.39,0:06:38.60,Default,,0,0,0,,Жеу керек болмаса, маған бер.
Dialogue: 0,0:06:38.68,0:06:39.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:39.52,0:06:41.31,Default,,0,0,0,,үшін жинал!
Dialogue: 0,0:06:42.77,0:06:44.07,Default,,0,0,0,,Менің де қолымнан келді.
Dialogue: 0,0:06:44.15,0:06:45.82,Default,,0,0,0,,Уау, жақсы иіс шығады
Dialogue: 0,0:06:45.90,0:06:47.57,Default,,0,0,0,,Мен үнемі тамақтанатын сияқтымын!
Dialogue: 0,0:06:48.24,0:06:50.53,Default,,0,0,0,,Хехе... қаймақ бар.
Dialogue: 0,0:06:50.61,0:06:53.62,Default,,0,0,0,,Шынымен бе? Мен оны Рю Чанға беремін.
Dialogue: 0,0:06:54.74,0:06:57.29,Default,,0,0,0,,Хехе, мен мұны істегім келеді.
Dialogue: 0,0:06:57.37,0:06:59.21,Default,,0,0,0,,Мектеп мерекесіне ұқсайды.
Dialogue: 0,0:06:59.29,0:07:01.08,Default,,0,0,0,,Бункасай? Бұл не?
Dialogue: 0,0:07:01.17,0:07:05.50,Default,,0,0,0,,Менің ойымша, бұл мектеп фестивалі, мұнда сынып спектакль қояды.
Dialogue: 0,0:07:06.00,0:07:07.96,Default,,0,0,0,,Драма, ән және т.б.
Dialogue: 0,0:07:08.46,0:07:11.38,Default,,0,0,0,,Сондай-ақ кофехана, аруақ үйі, т.б.
Dialogue: 0,0:07:11.88,0:07:13.14,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:07:13.22,0:07:13.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:13.93,0:07:16.60,Default,,0,0,0,,Бір күні бәріміз бірге жасайық. Бұл қызық болады.
Dialogue: 0,0:07:16.68,0:07:18.52,Default,,0,0,0,,Мектепте?
Dialogue: 0,0:07:18.60,0:07:19.48,Default,,0,0,0,,Иә
Dialogue: 0,0:07:21.48,0:07:24.36,Default,,0,0,0,,Мен де келе аламын ба?
Dialogue: 0,0:07:24.94,0:07:27.86,Default,,0,0,0,,Әрине, мұны не үшін сұрар едіңіз?
Dialogue: 0,0:07:31.65,0:07:32.86,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:34.91,0:07:37.41,Default,,0,0,0,,Демек, бұл жақсы емес деп айтасыз!
Dialogue: 0,0:07:37.49,0:07:39.50,Default,,0,0,0,,Егер сіз осы сызбаны орындасаңыз, жақсы болуыңыз керек.
Dialogue: 0,0:07:39.58,0:07:40.20,Default,,0,0,0,,Екі рет секіру ме? Әзілдеп тұрсың ғой.
Dialogue: 0,0:07:40.29,0:07:43.58,Default,,0,0,0,,Нацуо-сенсэй мен Рю-чан жұдырықтасуда!
Dialogue: 0,0:07:44.17,0:07:45.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:46.29,0:07:49.17,Default,,0,0,0,,Электр энергиясын тиімді өндіруге келетін болсақ, мұнда мүмкіндігінше көп.
Dialogue: 0,0:07:49.26,0:07:51.59,Default,,0,0,0,,Әрине, жеңілірек етіп жасаған дұрыс.
Dialogue: 0,0:07:51.67,0:07:55.30,Default,,0,0,0,,Өрісті түсінбейтін ақымақтардың жиі айтатын сөзі.
Dialogue: 0,0:07:55.39,0:07:58.14,Default,,0,0,0,,Бұл оське әрқашан жүктеме түседі
Dialogue: 0,0:07:58.22,0:08:00.52,Default,,0,0,0,,Егер бұл бұзылса, тиімділік болмайды.
Dialogue: 0,0:08:00.60,0:08:03.06,Default,,0,0,0,,Есептеулерде проблема болмауы керек, бірақ...
Dialogue: 0,0:08:03.14,0:08:05.27,Default,,0,0,0,,Егер бәрі жоспарланғандай болса
Dialogue: 0,0:08:05.35,0:08:06.56,Default,,0,0,0,,Ешқандай қиындық жоқ
Dialogue: 0,0:08:06.65,0:08:07.98,Default,,0,0,0,,Сіз ештеңе түсінбейсіз!
Dialogue: 0,0:08:08.07,0:08:09.98,Default,,0,0,0,,Ұрысуға болмайды!
Dialogue: 0,0:08:10.57,0:08:12.82,Default,,0,0,0,,Әрі қарай жалғастырғыңыз келсе
Dialogue: 0,0:08:12.90,0:08:15.49,Default,,0,0,0,,Менің зымыран соққым жанып кетеді!
Dialogue: 0,0:08:15.57,0:08:17.49,Default,,0,0,0,,Нацу-кун, сабыр ет.
Dialogue: 0,0:08:17.58,0:08:20.70,Default,,0,0,0,,Рю-чан, жүр, мен саған қаймақ беремін.
Dialogue: 0,0:08:20.79,0:08:21.83,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:21.91,0:08:22.96,Default,,0,0,0,,Мукю…
Dialogue: 0,0:08:23.04,0:08:25.46,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:08:25.54,0:08:27.54,Default,,0,0,0,,Ұрысты кім жүргізіп жатыр?
Dialogue: 0,0:08:27.63,0:08:28.84,Default,,0,0,0,,Иә? Жоқ?
Dialogue: 0,0:08:29.42,0:08:31.76,Default,,0,0,0,,Бірақ екеуіміз де оны төбеге дейін естиміз.
Dialogue: 0,0:08:31.84,0:08:33.34,Default,,0,0,0,,Бұл қатты болды.
Dialogue: 0,0:08:33.42,0:08:34.34,Default,,0,0,0,,(Жан) Эй, Джотаро, сол Какёин жігіт туралы не ойлайсың?
Dialogue: 0,0:08:35.18,0:08:37.72,Default,,0,0,0,,Мен сәл қызғанымды мойындаймын.
Dialogue: 0,0:08:37.80,0:08:42.02,Default,,0,0,0,,Міне, мен академияда жүргенде бұл күнделікті болатын жағдай еді.
Dialogue: 0,0:08:42.10,0:08:44.69,Default,,0,0,0,,Ал... бәрібір солай.
Dialogue: 0,0:08:44.77,0:08:46.77,Default,,0,0,0,,Кішкене ойланыңыз.
Dialogue: 0,0:08:46.85,0:08:47.40,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:08:47.48,0:08:48.73,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:08:49.27,0:08:49.98,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:50.61,0:08:51.90,Default,,0,0,0,,Сіз көмектесуге дайынсыз ба?
Dialogue: 0,0:08:51.98,0:08:52.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:54.24,0:08:57.37,Default,,0,0,0,,Шынымды айтсам, жалғыз істеуден басқа амалым жоқ деп ойладым.
Dialogue: 0,0:08:57.87,0:09:01.70,Default,,0,0,0,,Менің айтқанымнан, мен сізді күшке ие боласыз деп ойламадым.
Dialogue: 0,0:09:02.37,0:09:05.21,Default,,0,0,0,,Сонымен... сен мені ақымақ деп ойладың ба?
Dialogue: 0,0:09:05.29,0:09:07.92,Default,,0,0,0,,Ашық айтсақ, мағынасы осы.
Dialogue: 0,0:09:08.00,0:09:09.29,Default,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:09:09.38,0:09:10.71,Default,,0,0,0,,Мен сені ақымақ деп ойладым...
Dialogue: 0,0:09:10.80,0:09:11.71,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:09:13.13,0:09:13.71,Default,,0,0,0,,Окабе?
Dialogue: 0,0:09:14.38,0:09:15.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:15.80,0:09:17.13,Default,,0,0,0,,Мен оны… қолданамын деп ойламаған едім
Dialogue: 0,0:09:18.09,0:09:21.76,Default,,0,0,0,,Бұл академияда зымырандарды зерттеген кезде жиі болатын.
Dialogue: 0,0:09:21.85,0:09:24.10,Default,,0,0,0,,Есептеу мәселесі мүлде жоқ
Dialogue: 0,0:09:24.18,0:09:27.77,Default,,0,0,0,,Мен оны іс жүзінде жасап, іске қосуға тырысқанда, ол жұмыс істемейді.
Dialogue: 0,0:09:28.44,0:09:31.44,Default,,0,0,0,,Мұндай кезде тәжірибе ең күшті нәрсе.
Dialogue: 0,0:09:31.52,0:09:32.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:33.44,0:09:35.95,Default,,0,0,0,,Бұл менің басымнан өткендей емес...
Dialogue: 0,0:09:36.03,0:09:38.07,Default,,0,0,0,,Бірақ мен зауытта көмектестім.
Dialogue: 0,0:09:38.16,0:09:40.28,Default,,0,0,0,,Сіз байқаған нәрселер көп, солай ма?
Dialogue: 0,0:09:40.37,0:09:42.79,Default,,0,0,0,,Бұл қазір бәрінен де пайдалы.
Dialogue: 0,0:09:43.33,0:09:45.58,Default,,0,0,0,,Мен оны шынымен аяқтағым келеді!
Dialogue: 0,0:09:46.12,0:09:47.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:49.67,0:09:50.54,Default,,0,0,0,,Рю-чан
Dialogue: 0,0:09:50.63,0:09:53.00,Default,,0,0,0,,Мен мектепте көбірек кітап оқығым келеді
Dialogue: 0,0:09:55.80,0:10:00.64,Default,,0,0,0,,Көп... Сабырлы болу, қызу, кенет кешірім сұрау...
Dialogue: 0,0:10:01.22,0:10:02.76,Default,,0,0,0,,Сіз біртүрлі жігітсіз.
Dialogue: 0,0:10:02.85,0:10:03.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:04.18,0:10:05.64,Default,,0,0,0,,Мен де кешірім сұраймын.
Dialogue: 0,0:10:06.14,0:10:07.77,Default,,0,0,0,,Мен сізді дұрыс түсінбедім.
Dialogue: 0,0:10:09.48,0:10:11.44,Default,,0,0,0,,Танысқаныма қуаныштымын, досым
Dialogue: 0,0:10:11.94,0:10:12.90,Default,,0,0,0,,О
Dialogue: 0,0:10:14.23,0:10:15.36,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:18.57,0:10:21.07,Default,,0,0,0,,Олай болса, кездесуді жалғастырайық.
Dialogue: 0,0:10:21.16,0:10:22.74,Default,,0,0,0,,Қалғандардың бәрі мазасыз, сондықтан кетіңіздер.
Dialogue: 0,0:10:22.83,0:10:24.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:24.20,0:10:25.04,Default,,0,0,0,,Кеттік
Dialogue: 0,0:10:25.54,0:10:27.20,Default,,0,0,0,,Ммм~
Dialogue: 0,0:10:29.58,0:10:33.50,Default,,0,0,0,,Сен де Нацуо-санға көмектесіп жатырсың, Рюджи.
Dialogue: 0,0:10:34.00,0:10:34.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:37.92,0:10:38.97,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:49.39,0:10:52.27,Default,,0,0,0,,Өкініштісі, мен оны сізге жеткізу үшін бар күшімді салдым.
Dialogue: 0,0:10:52.36,0:10:54.90,Default,,0,0,0,,Жоқ, қазір ойлап қарасам, Нацукун.
Dialogue: 0,0:10:54.98,0:10:57.74,Default,,0,0,0,,Қызға ауыстыратын киім дайындау мүмкін емес.
Dialogue: 0,0:10:58.32,0:11:00.03,Default,,0,0,0,,Сізге ұнайды ма?
Dialogue: 0,0:11:00.11,0:11:03.91,Default,,0,0,0,,Бұл гуманоид, сондықтан оны ұнатуға да, ұнатпауға да болады.
Dialogue: 0,0:11:05.24,0:11:06.66,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:11:06.74,0:11:07.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:08.33,0:11:10.12,Default,,0,0,0,,Атри-чан сияқты нәрсе
Dialogue: 0,0:11:10.21,0:11:12.88,Default,,0,0,0,,Бұл шынымен гуманоидқа ұқсамайды, солай ма?
Dialogue: 0,0:11:13.38,0:11:17.63,Default,,0,0,0,,Бүгін де Рю-чанға қарасам, ол менен қарағанда пайдалырақ деп ойладым...
Dialogue: 0,0:11:20.97,0:11:25.26,Default,,0,0,0,,Адамдардан еш айырмашылығы жоқ гуманоид жасай алсақ ше?
Dialogue: 0,0:11:25.76,0:11:28.97,Default,,0,0,0,,Оған адам ретінде қарау керек пе?
Dialogue: 0,0:11:29.48,0:11:31.77,Default,,0,0,0,,Оған робот ретінде қарау керек пе?
Dialogue: 0,0:11:32.52,0:11:33.85,Default,,0,0,0,,Сіз қайсысы деп ойлайсыз?
Dialogue: 0,0:11:36.44,0:11:37.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:39.53,0:11:41.24,Default,,0,0,0,,Нацуо-сан!
Dialogue: 0,0:11:41.32,0:11:42.24,Default,,0,0,0,,Енді барыңыз
Dialogue: 0,0:11:43.66,0:11:44.74,Default,,0,0,0,,Ал...
Dialogue: 0,0:11:44.82,0:11:45.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:46.28,0:11:50.54,Default,,0,0,0,,Бұл... оны кию дұрыс па?
Dialogue: 0,0:11:52.21,0:11:53.17,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:53.25,0:11:54.58,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:11:54.67,0:11:56.54,Default,,0,0,0,,Ах! Мен ол туралы естідім
Dialogue: 0,0:11:56.63,0:11:59.26,Default,,0,0,0,,Шалбарыңыздың көрінісін көруге болатын киімнің бұл түрі
Dialogue: 0,0:11:59.34,0:12:01.72,Default,,0,0,0,,Еркектерді нәпсіге түсіретін әсері бар.
Dialogue: 0,0:12:01.80,0:12:03.76,Default,,0,0,0,,- Нацуо-сан, мынау... - (Нацуо) Әрине, басқаша!
Dialogue: 0,0:12:03.84,0:12:05.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:05.34,0:12:07.14,Default,,0,0,0,,Не? Киім ауыстыру...
Dialogue: 0,0:12:07.22,0:12:08.68,Default,,0,0,0,,Бұл пижаманы білдіреді.
Dialogue: 0,0:12:08.76,0:12:10.98,Default,,0,0,0,,Неге бұлай іш киім киесің?
Dialogue: 0,0:12:11.06,0:12:13.39,Default,,0,0,0,,Иә! Солай болды ма?
Dialogue: 0,0:12:13.48,0:12:14.15,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:12:14.23,0:12:16.15,Default,,0,0,0,,Алайда, біз оның қозғалысын тоқтата аламыз.
Dialogue: 0,0:12:16.23,0:12:18.40,Default,,0,0,0,,Түсіндім, Нацуо-сан.
Dialogue: 0,0:12:18.48,0:12:21.53,Default,,0,0,0,,Егер сіз Нацуо-санға осылай көмектесе аласыз!
Dialogue: 0,0:12:23.11,0:12:24.49,Default,,0,0,0,,Бұл жоғары өнімділік…
Dialogue: 0,0:12:24.57,0:12:25.36,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:25.87,0:12:29.49,Default,,0,0,0,,Менің... бәрі
Dialogue: 0,0:12:29.58,0:12:30.75,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:12:30.83,0:12:32.16,Default,,0,0,0,,(Атридың күресіп жатқан дыбысы)
Dialogue: 0,0:12:33.04,0:12:35.58,Default,,0,0,0,,Кешіріңіз, мен сіздің пижамаңызды алып келейін.
Dialogue: 0,0:12:36.29,0:12:36.92,Default,,0,0,0,,Не!
Dialogue: 0,0:12:42.80,0:12:44.51,Default,,0,0,0,,...
Dialogue: 0,0:12:50.81,0:12:51.89,Default,,0,0,0,,Кя!
Dialogue: 0,0:12:52.73,0:12:56.06,Default,,0,0,0,,Қозғалма, жарақат алғың келмейді.
Dialogue: 0,0:12:57.19,0:12:58.81,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:59.40,0:13:01.65,Default,,0,0,0,,Оны көргенде білесің.
Dialogue: 0,0:13:01.73,0:13:04.36,Default,,0,0,0,,Мен баланы алуға келдім.
Dialogue: 0,0:13:04.45,0:13:05.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:05.65,0:13:08.99,Default,,0,0,0,,Бұл оны бөлу туралы әңгіме жоқ дегенді білдіре ме?
Dialogue: 0,0:13:09.07,0:13:10.62,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:10.70,0:13:13.95,Default,,0,0,0,,Кешіріңіз, бірақ маған көбірек ақша керек.
Dialogue: 0,0:13:14.04,0:13:17.92,Default,,0,0,0,,Мен сіз оны ақшаға сатып жатырсыз деп ойладым, бірақ...
Dialogue: 0,0:13:18.00,0:13:20.00,Default,,0,0,0,,Сіз таңқаларлық байсалды екенсіз, балам.
Dialogue: 0,0:13:22.59,0:13:25.51,Default,,0,0,0,,То... Қаш, Атри-чан, қаш!
Dialogue: 0,0:13:25.59,0:13:27.13,Default,,0,0,0,,Сізге зиян тигізгіңіз келетін сияқты.
Dialogue: 0,0:13:27.22,0:13:27.97,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:13:28.05,0:13:33.02,Default,,0,0,0,,Енді ұстаздың билігін маған тапсыратыныңызды осында айтыңыз.
Dialogue: 0,0:13:37.98,0:13:41.86,Default,,0,0,0,,Жоқ, мен саған секірсем де, аяғыммен құтылып кете аламын.
Dialogue: 0,0:13:42.36,0:13:43.98,Default,,0,0,0,,Қанша ұрыс десем де
Dialogue: 0,0:13:44.07,0:13:47.11,Default,,0,0,0,,Гуманоидтар адамдарға шабуыл жасай алмайды.
Dialogue: 0,0:13:47.61,0:13:51.41,Default,,0,0,0,,Бала, тезірек! Мен байсалдымын
Dialogue: 0,0:13:55.58,0:13:57.54,Default,,0,0,0,,Мен... Жарайды, қазір айтамын.
Dialogue: 0,0:13:58.17,0:14:00.08,Default,,0,0,0,,Нацу-кун, №.
Dialogue: 0,0:14:02.59,0:14:03.09,Default,,0,0,0,,Атори
Dialogue: 0,0:14:03.96,0:14:07.22,Default,,0,0,0,,Зымыран соққысы!
Dialogue: 0,0:14:09.68,0:14:12.10,Default,,0,0,0,,Арх! Гах...
Dialogue: 0,0:14:12.18,0:14:14.01,Default,,0,0,0,,Бұл…
Dialogue: 0,0:14:15.31,0:14:18.60,Default,,0,0,0,,Ғұндар! Менің ерекше қадамым қаншалықты күшті?
Dialogue: 0,0:14:18.69,0:14:20.86,Default,,0,0,0,,Тіпті бұл сәл жұмсақ.
Dialogue: 0,0:14:22.61,0:14:23.57,Default,,0,0,0,,Атри…
Dialogue: 0,0:14:24.28,0:14:27.49,Default,,0,0,0,,Адамдарға... шабуыл жасау.
Dialogue: 0,0:14:27.57,0:14:28.86,Default,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:14:28.95,0:14:31.87,Default,,0,0,0,,Иә! Понкотсу жасайсыз ба?
Dialogue: 0,0:14:31.95,0:14:34.20,Default,,0,0,0,,Асығыңыз және тастаңыз!
Dialogue: 0,0:14:34.29,0:14:35.20,Default,,0,0,0,,Ба-ка-ба-ка!
Dialogue: 0,0:14:35.29,0:14:38.54,Default,,0,0,0,,Ғұндар ғұндары! Дөрекі болу дөрекі
Dialogue: 0,0:14:39.04,0:14:41.63,Default,,0,0,0,,Мен Нацуо-санға зиян тигізетін қатысуды қудым.
Dialogue: 0,0:14:42.50,0:14:45.59,Default,,0,0,0,,Керемет болды ма? Бұл пайдалы болды ма?
Dialogue: 0,0:14:45.67,0:14:46.34,Default,,0,0,0,,О
Dialogue: 0,0:14:46.42,0:14:48.38,Default,,0,0,0,,Олай болса мені мадақтаңыз.
Dialogue: 0,0:14:50.13,0:14:53.64,Default,,0,0,0,,Эхехехе, мен де пайдалы бола аламын, солай ма?
Dialogue: 0,0:14:54.60,0:14:58.56,Default,,0,0,0,,Өйткені, мен жоғары нәтижелі адаммын!
Dialogue: 0,0:14:58.64,0:15:00.02,Default,,0,0,0,,Сезінсеңіз, басқалардан артық...
Dialogue: 0,0:15:00.10,0:15:01.60,Default,,0,0,0,,- (Нацуо) Атри - иә?
Dialogue: 0,0:15:02.48,0:15:03.11,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:15:05.48,0:15:07.11,Default,,0,0,0,,Иә, солай!
Dialogue: 0,0:15:14.87,0:15:15.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:17.20,0:15:18.29,Default,,0,0,0,,Бұл…
Dialogue: 0,0:15:21.46,0:15:23.38,Default,,0,0,0,,Мұғалім? Бұл не?
Dialogue: 0,0:15:23.46,0:15:26.63,Default,,0,0,0,,Иә, менің шын атым – Ханако Осада.
Dialogue: 0,0:15:27.25,0:15:28.17,Default,,0,0,0,,Ханако?
Dialogue: 0,0:15:28.26,0:15:29.88,Default,,0,0,0,,Мен Ринка-чаннан сұрадым.
Dialogue: 0,0:15:29.97,0:15:34.26,Default,,0,0,0,,Олар осыдан бірнеше жыл бұрын Хана-чан Сенсей деген адам болғанын айтты.
Dialogue: 0,0:15:34.35,0:15:37.68,Default,,0,0,0,,Сонда сіз осы мектепте мұғалім болдыңыз ба?
Dialogue: 0,0:15:37.77,0:15:38.43,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:15:38.52,0:15:41.14,Default,,0,0,0,,Неліктен олай болды?
Dialogue: 0,0:15:41.73,0:15:43.48,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:15:43.56,0:15:47.90,Default,,0,0,0,,Ол пышақты маған қаратқанда дірілдеп тұрды.
Dialogue: 0,0:15:48.78,0:15:51.90,Default,,0,0,0,,Мүмкін ол шынымен жаман адам емес шығар.
Dialogue: 0,0:15:52.74,0:15:55.12,Default,,0,0,0,,Мені өндіріп алушылар қуып жүрді.
Dialogue: 0,0:15:55.70,0:15:57.66,Default,,0,0,0,,Бұл қажеттіліктен болды деп ойлаймын.
Dialogue: 0,0:15:59.24,0:16:00.58,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:16:00.66,0:16:01.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:01.75,0:16:03.29,Default,,0,0,0,,Эй, келдің бе?
Dialogue: 0,0:16:03.37,0:16:04.42,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:16:04.50,0:16:06.67,Default,,0,0,0,,Шайырға қатысты мәселе жоқ сияқты.
Dialogue: 0,0:16:06.75,0:16:10.09,Default,,0,0,0,,Қалған материалдар үшін қараусыз қалған үй орталығына барсаңыз,
Dialogue: 0,0:16:10.17,0:16:11.67,Default,,0,0,0,,Бұл қалай да болады.
Dialogue: 0,0:16:11.76,0:16:14.09,Default,,0,0,0,,Сонымен, бұл келесі қадам.
Dialogue: 0,0:16:14.18,0:16:15.89,Default,,0,0,0,,Келесі қадам?
Dialogue: 0,0:16:16.39,0:16:19.43,Default,,0,0,0,,Мен оны осында бар құралдармен жасай алмаймын.
Dialogue: 0,0:16:19.52,0:16:20.02,Default,,0,0,0,,осында
Dialogue: 0,0:16:20.85,0:16:21.85,Default,,0,0,0,,Қозғалтқыш?
Dialogue: 0,0:16:21.93,0:16:22.77,Default,,0,0,0,,О
Dialogue: 0,0:16:22.85,0:16:25.44,Default,,0,0,0,,Және оны сақтауға арналған аккумулятор.
Dialogue: 0,0:16:25.52,0:16:28.19,Default,,0,0,0,,Көремін, егер батареялар болмаса
Dialogue: 0,0:16:28.27,0:16:30.86,Default,,0,0,0,,Қанша электр энергиясы өндірілсе де, оны сақтауға болмайды ма?
Dialogue: 0,0:16:30.94,0:16:34.57,Default,,0,0,0,,Иә, моторды алу оңай шығар.
Dialogue: 0,0:16:34.66,0:16:37.83,Default,,0,0,0,,Сондай-ақ аралда көптеген қараусыз қалған зауыттар бар.
Dialogue: 0,0:16:38.33,0:16:39.91,Default,,0,0,0,,Мәселе батареяда.
Dialogue: 0,0:16:40.49,0:16:42.66,Default,,0,0,0,,үшін мұны қалайды.
Dialogue: 0,0:16:42.75,0:16:45.79,Default,,0,0,0,,Мектептерде бастапқыда апаттық батареялар болды, бірақ
Dialogue: 0,0:16:45.87,0:16:48.75,Default,,0,0,0,,Өткенде қарасам, бәрі таза, жоқ екен.
Dialogue: 0,0:16:48.84,0:16:49.80,Default,,0,0,0,,Ах… Эх…
Dialogue: 0,0:16:50.30,0:16:51.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:53.51,0:16:54.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:56.93,0:16:58.43,Default,,0,0,0,,Мұнда да жоқ!
Dialogue: 0,0:16:58.51,0:17:00.06,Default,,0,0,0,,Ақыр соңында?
Dialogue: 0,0:17:01.39,0:17:03.56,Default,,0,0,0,,Мұнда да тек батарея шығарылған.
Dialogue: 0,0:17:03.64,0:17:06.94,Default,,0,0,0,,Иә? Бұл шынымен еш жерде емес
Dialogue: 0,0:17:07.44,0:17:10.57,Default,,0,0,0,,Теңіз деңгейінің көтерілуіне байланысты электр станциялары тоқтатылды
Dialogue: 0,0:17:10.65,0:17:14.32,Default,,0,0,0,,Дүние жүзінде біраз уақыт электр қуатының үзілуі жалғасқандықтан, барлық батареялар істен шықты
Dialogue: 0,0:17:14.40,0:17:16.57,Default,,0,0,0,,Ол өте қымбат бағамен сатылды.
Dialogue: 0,0:17:16.66,0:17:18.99,Default,,0,0,0,,Сонымен, сіз оны өзіңізбен бірге алып кеттіңіз бе?
Dialogue: 0,0:17:21.16,0:17:23.08,Default,,0,0,0,,Мен оны қолдана алатынымды білмеймін, бірақ...
Dialogue: 0,0:17:25.91,0:17:27.92,Default,,0,0,0,,Теңізге қараймыз ба?
Dialogue: 0,0:17:32.17,0:17:33.17,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:17:33.26,0:17:35.17,Default,,0,0,0,,Өкінішке орай...
Dialogue: 0,0:17:35.26,0:17:36.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:36.38,0:17:37.68,Default,,0,0,0,,Ах
Dialogue: 0,0:17:39.39,0:17:42.93,Default,,0,0,0,,Жоқ, тек батарея шығарылды.
Dialogue: 0,0:17:43.02,0:17:45.31,Default,,0,0,0,,Теңіз түбінде болса да?
Dialogue: 0,0:17:45.39,0:17:48.98,Default,,0,0,0,,Олар материктен суасты кемесімен келіп, келесі күні кеткен шығар.
Dialogue: 0,0:17:49.61,0:17:51.98,Default,,0,0,0,,Мен өзімді жалғыз сезінемін.
Dialogue: 0,0:17:53.57,0:17:57.28,Default,,0,0,0,,Осы сомаға сатып алуға болатын батареяларға келетін болсақ...
Dialogue: 0,0:17:58.07,0:18:00.24,Default,,0,0,0,,- (Нацуо) Иә? - (Мо Мизуна) Осының бәрі ме?
Dialogue: 0,0:18:00.32,0:18:01.91,Default,,0,0,0,,Бұл өте қымбат!
Dialogue: 0,0:18:01.99,0:18:04.16,Default,,0,0,0,,Егер сізге ұнамаса, басқасын көріңіз.
Dialogue: 0,0:18:04.79,0:18:08.37,Default,,0,0,0,,Қайда барсаң да, ұқсайды деп ойлаймын.
Dialogue: 0,0:18:08.46,0:18:09.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:10.46,0:18:11.34,Default,,0,0,0,,Кеттік
Dialogue: 0,0:18:12.67,0:18:14.17,Default,,0,0,0,,- (Дүкенші) Эй, күте тұрыңыз - (Нацуо) А?
Dialogue: 0,0:18:14.67,0:18:16.63,Default,,0,0,0,,Анау кішкентай...
Dialogue: 0,0:18:16.72,0:18:20.47,Default,,0,0,0,,Мүмкін маған бұрын сатуға келген гуманоид шығар?
Dialogue: 0,0:18:21.05,0:18:22.81,Default,,0,0,0,,А, есіңізде ме?
Dialogue: 0,0:18:22.89,0:18:26.10,Default,,0,0,0,,Жарайды... онымен айырбастауға болады.
Dialogue: 0,0:18:26.60,0:18:29.27,Default,,0,0,0,,Мына жігіт, мына жігіт, мына жігіт!
Dialogue: 0,0:18:30.23,0:18:30.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:30.81,0:18:33.40,Default,,0,0,0,,Осындай түрін іздейтін біреу бар.
Dialogue: 0,0:18:33.48,0:18:36.49,Default,,0,0,0,,Егер сіз оған әкелсеңіз, сізге кез келген соманы беремін дейді.
Dialogue: 0,0:18:37.32,0:18:38.40,Default,,0,0,0,,Атри...
Dialogue: 0,0:18:40.32,0:18:40.99,Default,,0,0,0,,Хмф!
Dialogue: 0,0:18:41.07,0:18:44.74,Default,,0,0,0,,Демек, менің құндылығым бар деген сөз.
Dialogue: 0,0:18:44.83,0:18:46.79,Default,,0,0,0,,Аа, міне, осыны білдіреді.
Dialogue: 0,0:18:46.87,0:18:49.08,Default,,0,0,0,,Мен сияқты өнімділігі жоғары адам күткендей!
Dialogue: 0,0:18:49.16,0:18:52.50,Default,,0,0,0,,Енді түсіндің, солай ма? Мен ебедейсіз адам емеспін.
Dialogue: 0,0:18:53.09,0:18:55.59,Default,,0,0,0,,Бұл жеткіліксіз болса, оны да қосыңыз
Dialogue: 0,0:18:55.67,0:18:56.21,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:18:57.34,0:18:59.38,Default,,0,0,0,,Неліктен гуманоидтың осы түрі ғана?
Dialogue: 0,0:18:59.47,0:19:00.72,Default,,0,0,0,,Неліктен қымбат?
Dialogue: 0,0:19:00.80,0:19:03.72,Default,,0,0,0,,Хмм... Сирек болғандықтан ба?
Dialogue: 0,0:19:03.80,0:19:04.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:05.18,0:19:08.27,Default,,0,0,0,,Сирек болса да, тым қымбат.
Dialogue: 0,0:19:08.35,0:19:10.14,Default,,0,0,0,,Себеп жоқ па?
Dialogue: 0,0:19:10.23,0:19:12.48,Default,,0,0,0,,Хмм, осы уақытқа дейін...
Dialogue: 0,0:19:13.36,0:19:14.94,Default,,0,0,0,,Материалдар бар ма?
Dialogue: 0,0:19:17.90,0:19:20.11,Default,,0,0,0,,Ямасаки фабрикасының 4-ші буыны
Dialogue: 0,0:19:20.82,0:19:22.70,Default,,0,0,0,,Бұл жай ғана «тоқтатылды» ма?
Dialogue: 0,0:19:23.20,0:19:25.78,Default,,0,0,0,,Сіз оны қайтарып алғанын айттыңыз.
Dialogue: 0,0:19:25.87,0:19:28.62,Default,,0,0,0,,Неліктен? Бұл олардың тым адамға ұқсайтындығынан ба?
Dialogue: 0,0:19:29.20,0:19:30.96,Default,,0,0,0,,Шамасы
Dialogue: 0,0:19:31.04,0:19:33.38,Default,,0,0,0,,Бірақ мен шынымен білмеймін.
Dialogue: 0,0:19:33.46,0:19:35.63,Default,,0,0,0,,Өндірушілер осындай заттарды жасырғанды ​​ұнатады.
Dialogue: 0,0:19:38.80,0:19:41.59,Default,,0,0,0,,Гуманоидты жинаушылар өте аз.
Dialogue: 0,0:19:41.68,0:19:44.64,Default,,0,0,0,,Мұндай адамдар өте сирек болғандықтан көп ақша төлейді.
Dialogue: 0,0:19:44.72,0:19:46.22,Default,,0,0,0,,Егер бұл адамзаттың тіршілігін сақтап қалуға көмектессе, мен
Dialogue: 0,0:19:52.73,0:19:54.65,Default,,0,0,0,,Коллектор болады
Dialogue: 0,0:19:55.15,0:19:59.65,Default,,0,0,0,,Сонда әже оны неге сонша ұқыпты ұстады?
Dialogue: 0,0:20:00.24,0:20:02.65,Default,,0,0,0,,Сирек болғандықтан ғана сақталды...
Dialogue: 0,0:20:03.41,0:20:06.20,Default,,0,0,0,,Өйткені, бұл тек сыртқы көріністе емес.
Dialogue: 0,0:20:06.28,0:20:09.16,Default,,0,0,0,,Ойлар мен сезімдер адамдар сияқты жаратылған...
Dialogue: 0,0:20:09.79,0:20:11.41,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:20:11.50,0:20:12.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:12.79,0:20:15.42,Default,,0,0,0,,Рю-чан, мен шынымен мотивацияланған болсам да.
Dialogue: 0,0:20:16.08,0:20:16.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:17.42,0:20:20.67,Default,,0,0,0,,Ең нашар жағдайда, аккумуляторды су астына алып, оны пайдаланыңыз.
Dialogue: 0,0:20:20.76,0:20:21.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:21.84,0:20:24.93,Default,,0,0,0,,Бірақ содан кейін сіз енді суға түсе алмайсыз.
Dialogue: 0,0:20:25.01,0:20:26.01,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:26.09,0:20:28.76,Default,,0,0,0,,Мен олай ойламаймын...
Dialogue: 0,0:20:34.06,0:20:34.98,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:35.48,0:20:36.19,Default,,0,0,0,,- (Нацуо) Иә? - (Мо Мизуна) Иә?
Dialogue: 0,0:20:38.57,0:20:40.61,Default,,0,0,0,,Мені сатыңызшы
Dialogue: 0,0:20:41.90,0:20:43.28,Default,,0,0,0,,Атори-чан...
Dialogue: 0,0:20:44.28,0:20:46.95,Default,,0,0,0,,Мені сатсаң, аккумуляторды аласың, солай ма?
Dialogue: 0,0:20:47.57,0:20:49.45,Default,,0,0,0,,Мектепте шамдар жанып тұр, солай ма?
Dialogue: 0,0:20:50.04,0:20:52.66,Default,,0,0,0,,Бұл Нацуо-санға пайдалы, солай емес пе?
Dialogue: 0,0:20:56.04,0:20:58.46,Default,,0,0,0,,Бұл менің аяғым болуы керек емес пе?
Dialogue: 0,0:20:58.54,0:20:59.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:59.54,0:21:02.21,Default,,0,0,0,,Нацуо мұның қажеті жоқ екенін айтты.
Dialogue: 0,0:21:02.80,0:21:04.47,Default,,0,0,0,,Кемпірдің бұйрығын не істеуім керек?
Dialogue: 0,0:21:05.30,0:21:06.80,Default,,0,0,0,,Мен мұны бұрын айтқанмын
Dialogue: 0,0:21:06.89,0:21:10.97,Default,,0,0,0,,Гуманоидтар қожайындарының тілегін орындау үшін дүниеге келген.
Dialogue: 0,0:21:13.02,0:21:14.48,Default,,0,0,0,,Сіз оны жек көрмейсіз бе?
Dialogue: 0,0:21:15.06,0:21:16.02,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:19.06,0:21:20.94,Default,,0,0,0,,Сен менің қасымда тұра алмайсың.
Dialogue: 0,0:21:28.87,0:21:32.04,Default,,0,0,0,,Маған ұнамайды... Мен өзімді жалғыз сезінемін.
Dialogue: 0,0:21:36.54,0:21:39.88,Default,,0,0,0,,Бірақ егер Нацуо-санның тілегі орындалса
Dialogue: 0,0:21:41.13,0:21:42.34,Default,,0,0,0,,Атри-чан...
Dialogue: 0,0:21:42.84,0:21:43.88,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:21:44.88,0:21:46.38,Default,,0,0,0,,Мен сені сатпаймын
Dialogue: 0,0:21:46.47,0:21:50.05,Default,,0,0,0,,Батареяны қалай пайдалану керек?
Dialogue: 0,0:21:50.14,0:21:54.14,Default,,0,0,0,,Оның ішінде өнімділігі жоғары батарея бар.
Dialogue: 0,0:21:54.22,0:21:55.64,Default,,0,0,0,,Өйткені, мен...
Dialogue: 0,0:21:55.73,0:21:56.39,Default,,0,0,0,,Қабылданбады!
Dialogue: 0,0:21:56.48,0:21:57.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:01.19,0:22:02.40,Default,,0,0,0,,Нацуо-сан…
Dialogue: 0,0:22:08.74,0:22:09.66,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:22:10.99,0:22:12.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:38.25,0:23:40.25,Default,,0,0,0,,～♪
