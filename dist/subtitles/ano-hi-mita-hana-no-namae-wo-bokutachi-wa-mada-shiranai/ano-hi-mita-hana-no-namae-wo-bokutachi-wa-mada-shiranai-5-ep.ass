Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:01:27.42,Default,,0,0,0,,♪～
Dialogue: 0,0:01:25.93,0:01:30.36,Default,,0,0,0,,♪～
Dialogue: 0,0:01:34.19,0:01:36.49,Default,,0,0,0,,Сақ бол, Джинтан!
Dialogue: 0,0:01:38.11,0:01:39.11,Default,,0,0,0,,Шукууми?
Dialogue: 0,0:01:39.11,0:01:39.57,Default,,0,0,0,,Шукууми?
Dialogue: 0,0:01:39.11,0:01:39.57,Default,,0,0,0,,Жарайды! ―
Dialogue: 0,0:01:39.57,0:01:40.82,Default,,0,0,0,,Жарайды! ―
Dialogue: 0,0:01:46.83,0:01:51.25,Default,,0,0,0,,Юкиацу бұл көйлек...
Dialogue: 0,0:01:52.92,0:01:54.92,Default,,0,0,0,,Менма киген киімге ұқсас...
Dialogue: 0,0:01:56.92,0:02:00.09,Default,,0,0,0,,Жоқ... сен неге олай киіндің...
Dialogue: 0,0:02:02.39,0:02:04.85,Default,,0,0,0,,Мм... жақсысың ба? ―
Dialogue: 0,0:02:05.68,0:02:06.60,Default,,0,0,0,,Дұрыс, болды!
Dialogue: 0,0:02:06.93,0:02:09.94,Default,,0,0,0,,Жақсы сияқты ма?
Dialogue: 0,0:02:11.11,0:02:11.77,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:15.90,0:02:18.15,Default,,0,0,0,,Мұқият қараңыз!
Dialogue: 0,0:02:18.15,0:02:18.45,Default,,0,0,0,,Мұқият қараңыз!
Dialogue: 0,0:02:18.15,0:02:18.45,Default,,0,0,0,,Сәлем, Юкиацу!
Dialogue: 0,0:02:18.45,0:02:20.11,Default,,0,0,0,,Сәлем, Юкиацу!
Dialogue: 0,0:02:21.95,0:02:23.58,Default,,0,0,0,,Оны сол күйінде қалдырыңыз.
Dialogue: 0,0:02:23.58,0:02:23.95,Default,,0,0,0,,Оны сол күйінде қалдырыңыз.
Dialogue: 0,0:02:23.58,0:02:23.95,Default,,0,0,0,,Э? Б-бірақ…
Dialogue: 0,0:02:23.95,0:02:25.79,Default,,0,0,0,,Э? Б-бірақ…
Dialogue: 0,0:02:25.79,0:02:25.91,Default,,0,0,0,,Э? Б-бірақ…
Dialogue: 0,0:02:25.79,0:02:25.91,Default,,0,0,0,,Бұл мүмкіндік.
Dialogue: 0,0:02:25.91,0:02:27.04,Default,,0,0,0,,Бұл мүмкіндік.
Dialogue: 0,0:02:27.16,0:02:30.96,Default,,0,0,0,,Егер мен мұны өткізіп алсам, мен сенімдімін ...
Dialogue: 0,0:02:31.21,0:02:32.46,Default,,0,0,0,,Цуруко…
Dialogue: 0,0:02:36.76,0:02:40.13,Default,,0,0,0,,Эй, сен Менмаға ұқсайсың ба?
Dialogue: 0,0:02:40.30,0:02:42.64,Default,,0,0,0,,Сіз Менманы көре аласыз, солай ма?
Dialogue: 0,0:02:43.47,0:02:45.60,Default,,0,0,0,,Мен Менмаға ұқсаймын ба?
Dialogue: 0,0:02:45.60,0:02:45.81,Default,,0,0,0,,Мен Менмаға ұқсаймын ба?
Dialogue: 0,0:02:45.60,0:02:45.81,Default,,0,0,0,,Юкия...
Dialogue: 0,0:02:45.81,0:02:46.10,Default,,0,0,0,,Юкия...
Dialogue: 0,0:02:46.10,0:02:46.64,Default,,0,0,0,,Юкия...
Dialogue: 0,0:02:46.10,0:02:46.64,Default,,0,0,0,,Сіз оны дұрыс көре аласыз ба? ?
Dialogue: 0,0:02:46.64,0:02:47.98,Default,,0,0,0,,Сіз оны дұрыс көре аласыз ба? ?
Dialogue: 0,0:02:48.85,0:02:50.48,Default,,0,0,0,,Бұл менің кінәм!
Dialogue: 0,0:02:51.15,0:02:55.15,Default,,0,0,0,,Менманың сол күні қайтыс болуына менің кінәм болды.
Dialogue: 0,0:02:55.82,0:02:58.57,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл сенің кінәң емес! ―
Dialogue: 0,0:02:58.78,0:02:59.36,Default,,0,0,0,,Ал, менің...
Dialogue: 0,0:02:59.36,0:02:59.99,Default,,0,0,0,,Ал, менің...
Dialogue: 0,0:02:59.36,0:02:59.99,Default,,0,0,0,,Сіз бұл менің кінәм деп жатқан шығарсыз!!
Dialogue: 0,0:02:59.99,0:03:01.41,Default,,0,0,0,,Сіз бұл менің кінәм деп жатқан шығарсыз!!
Dialogue: 0,0:03:01.99,0:03:04.16,Default,,0,0,0,,Менмаға бұлай айтпасам...
Dialogue: 0,0:03:04.32,0:03:06.16,Default,,0,0,0,,Менма өлген жоқ
Dialogue: 0,0:03:06.41,0:03:09.16,Default,,0,0,0,,Мен Менманың өліміне себепкер болдым! !
Dialogue: 0,0:03:09.66,0:03:10.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:13.04,0:03:16.17,Default,,0,0,0,,Менма пайда болса, ол менің алдымда болады.
Dialogue: 0,0:03:16.34,0:03:22.09,Default,,0,0,0,,Бетперде кисең де, қарғасаң да... көз алдымда! ! ―
Dialogue: 0,0:03:26.31,0:03:29.85,Default,,0,0,0,,Бірақ Менма көрінбеді.
Dialogue: 0,0:03:31.31,0:03:33.02,Default,,0,0,0,,Менің алдымда
Dialogue: 0,0:03:34.35,0:03:35.19,Default,,0,0,0,,Юкиацу…
Dialogue: 0,0:03:35.31,0:03:38.15,Default,,0,0,0,,Сондықтан Менма енді жоқ.
Dialogue: 0,0:03:38.53,0:03:41.15,Default,,0,0,0,,Бұл еш жерде емес! !
Dialogue: 0,0:03:41.53,0:03:45.16,Default,,0,0,0,,(Юкиацу жылап жатыр)
Dialogue: 0,0:03:45.57,0:03:46.78,Default,,0,0,0,,Бар
Dialogue: 0,0:03:54.08,0:03:58.05,Default,,0,0,0,,Менма «Мен осындамын» дейді
Dialogue: 0,0:03:59.30,0:04:02.72,Default,,0,0,0,,Сіз әлі де солайсыз...
Dialogue: 0,0:04:03.93,0:04:07.05,Default,,0,0,0,,Мен... Менма - Юкиацуни...
Dialogue: 0,0:04:07.55,0:04:12.39,Default,,0,0,0,,«Рахмет, кешіріңіз»
Dialogue: 0,0:04:15.73,0:04:17.19,Default,,0,0,0,,А... білесің бе...
Dialogue: 0,0:04:17.56,0:04:21.53,Default,,0,0,0,,Мен түсінбеймін, бірақ...
Dialogue: 0,0:04:22.40,0:04:24.15,Default,,0,0,0,,Юкиацу?
Dialogue: 0,0:04:28.58,0:04:31.04,Default,,0,0,0,,Иә? иә? иә?
Dialogue: 0,0:04:32.16,0:04:33.71,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:04:36.08,0:04:39.50,Default,,0,0,0,,Сәлем! Мен сені жібере аламын ба?
Dialogue: 0,0:04:42.76,0:04:43.76,Default,,0,0,0,,Қышыма...
Dialogue: 0,0:04:46.76,0:04:48.26,Default,,0,0,0,,Жақсы жұмыс.
Dialogue: 0,0:04:48.43,0:04:51.77,Default,,0,0,0,,Сіз білесіз бе? Сіз
Dialogue: 0,0:04:54.43,0:04:56.77,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:04:57.77,0:05:01.90,Default,,0,0,0,,Біз мектептен кейін біраз уақыттан бері кездесіп жүрміз...
Dialogue: 0,0:05:02.94,0:05:06.86,Default,,0,0,0,,Ештеңе етпейді...
Dialogue: 0,0:05:08.28,0:05:09.28,Default,,0,0,0,,Әйелдер -
Dialogue: 0,0:05:10.33,0:05:14.45,Default,,0,0,0,,Ақ ленталы көйлек
Dialogue: 0,0:05:16.04,0:05:17.96,Default,,0,0,0,,Бұл жақсы нәрсе болды ма?
Dialogue: 0,0:05:18.42,0:05:21.63,Default,,0,0,0,,Иә, теңізді шығарған дұрыс.
Dialogue: 0,0:05:22.00,0:05:25.76,Default,,0,0,0,,Тек өзегі шіріп кеткен.
Dialogue: 0,0:05:25.97,0:05:30.14,Default,,0,0,0,,Уми: Егер мен бәрін жұмсасам, ештеңе қалмауы мүмкін.
Dialogue: 0,0:05:30.35,0:05:32.14,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:05:32.14,0:05:32.31,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:05:32.14,0:05:32.31,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:05:32.31,0:05:33.31,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:05:41.06,0:05:45.32,Default,,0,0,0,,«Рахмет, кешіріңіз» -
Dialogue: 0,0:05:55.33,0:05:56.50,Default,,0,0,0,,Менма
Dialogue: 0,0:05:58.00,0:06:01.50,Default,,0,0,0,,Күте тұрыңыз, Джинтан! Джинтан! !
Dialogue: 0,0:06:01.67,0:06:04.25,Default,,0,0,0,,Күте тұрыңыз! Күте тұрыңыз, Менма!
Dialogue: 0,0:06:04.38,0:06:06.01,Default,,0,0,0,,Неліктен? Мен күте алмаймын -
Dialogue: 0,0:06:06.17,0:06:06.84,Default,,0,0,0,,Джинтан кетіп бара жатыр...
Dialogue: 0,0:06:06.84,0:06:07.59,Default,,0,0,0,,Джинтан кетіп бара жатыр...
Dialogue: 0,0:06:06.84,0:06:07.59,Default,,0,0,0,,Оны жіберіңіз!
Dialogue: 0,0:06:07.59,0:06:08.26,Default,,0,0,0,,Оны жіберіңіз!
Dialogue: 0,0:06:08.43,0:06:09.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:14.56,0:06:18.19,Default,,0,0,0,,Менма шіркін емес Менма...
Dialogue: 0,0:06:19.60,0:06:20.85,Default,,0,0,0,,Бұл…
Dialogue: 0,0:06:21.69,0:06:22.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:22.44,0:06:25.03,Default,,0,0,0,,Менма бұл жақсы көрінді деп ойладым.
Dialogue: 0,0:06:26.61,0:06:28.49,Default,,0,0,0,,Менің сүйікті Менмаға!
Dialogue: 0,0:06:28.49,0:06:29.15,Default,,0,0,0,,Менің сүйікті Менмаға!
Dialogue: 0,0:06:28.49,0:06:29.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:29.15,0:06:29.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:29.99,0:06:35.04,Default,,0,0,0,,Ах... у... а...
Dialogue: 0,0:06:39.08,0:06:39.83,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:06:39.83,0:06:40.17,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:06:39.83,0:06:40.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:40.17,0:06:40.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:40.75,0:06:43.17,Default,,0,0,0,,Мен... Джинтан мен барамын...
Dialogue: 0,0:06:43.29,0:06:46.38,Default,,0,0,0,,Менма Цзинтан мен сені қууым керек!
Dialogue: 0,0:06:46.51,0:06:47.88,Default,,0,0,0,,Кейінірек кездескенше!
Dialogue: 0,0:06:49.38,0:06:50.72,Default,,0,0,0,,Менма…
Dialogue: 0,0:06:55.97,0:06:56.89,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:11.74,0:07:17.37,Default,,0,0,0,,(Юкиацу жылап жатыр)
Dialogue: 0,0:07:30.55,0:07:33.43,Default,,0,0,0,,Көзілдірік киген кезде өзіңізді нашар сезінесіз бе? ―
Dialogue: 0,0:07:37.89,0:07:38.68,Default,,0,0,0,,Мен оны көре алмаймын.
Dialogue: 0,0:07:43.56,0:07:45.27,Default,,0,0,0,,Сәлем, жігіттер...
Dialogue: 0,0:07:51.11,0:07:53.24,Default,,0,0,0,,Ерлер… Ма…
Dialogue: 0,0:07:54.28,0:07:56.78,Default,,0,0,0,,Иә? Хехе
Dialogue: 0,0:07:56.99,0:08:00.25,Default,,0,0,0,,Жоқ... Бірдеңе жегіңіз келе ме?
Dialogue: 0,0:08:00.45,0:08:02.12,Default,,0,0,0,,Ал...
Dialogue: 0,0:08:02.37,0:08:03.92,Default,,0,0,0,,Кен-чан рамен!
Dialogue: 0,0:08:04.04,0:08:08.13,Default,,0,0,0,,Менің үйімде жоқ...Жақында көрмедім.
Dialogue: 0,0:08:08.25,0:08:11.72,Default,,0,0,0,,Иә? Сонда мен не істеуім керек?
Dialogue: 0,0:08:11.97,0:08:14.13,Default,,0,0,0,,Ал...
Dialogue: 0,0:08:14.68,0:08:15.47,Default,,0,0,0,,сатып алу
Dialogue: 0,0:08:15.59,0:08:16.60,Default,,0,0,0,,Не!
Dialogue: 0,0:08:16.72,0:08:19.31,Default,,0,0,0,,Жақсы, үйде бар нәрсені ғана пайдаланыңыз.
Dialogue: 0,0:08:21.60,0:08:22.43,Default,,0,0,0,,Джинтан?
Dialogue: 0,0:08:23.44,0:08:27.81,Default,,0,0,0,,Менма өлді, бірақ ол міне.
Dialogue: 0,0:08:28.27,0:08:30.98,Default,,0,0,0,,Юкиацу емес, мен.
Dialogue: 0,0:08:32.07,0:08:34.49,Default,,0,0,0,,Аруақтар, адасушылықтар, бәрібір.
Dialogue: 0,0:08:34.99,0:08:36.57,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:08:37.82,0:08:41.58,Default,,0,0,0,,Бірақ мен бұл туралы ойлаудан аулақ болдым.
Dialogue: 0,0:08:43.83,0:08:46.50,Default,,0,0,0,,Маған барлығымен бірге болу ұнайды...
Dialogue: 0,0:08:47.00,0:08:49.29,Default,,0,0,0,,Джинтанмен бірге болу маған ұнайды.
Dialogue: 0,0:08:50.17,0:08:54.34,Default,,0,0,0,,Бұл бұл туралы дұрыс ойланудың қажеті жоқ дегенді білдірмейді.
Dialogue: 0,0:08:54.59,0:08:56.01,Default,,0,0,0,,Мен бір жерде ойланып қалдым
Dialogue: 0,0:08:57.93,0:09:01.85,Default,,0,0,0,,Менма неге мұнда?
Dialogue: 0,0:09:03.52,0:09:06.19,Default,,0,0,0,,Сіз өте танымалсыз.
Dialogue: 0,0:09:06.98,0:09:08.19,Default,,0,0,0,,А...
Dialogue: 0,0:09:08.52,0:09:15.86,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:09:19.66,0:09:21.83,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:09:28.88,0:09:31.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:31.42,0:09:34.21,Default,,0,0,0,,Менде Кен-Чан рамені болған жоқ, оның орнына...
Dialogue: 0,0:09:34.38,0:09:37.05,Default,,0,0,0,,Орынбасарлар сонша көп пе?
Dialogue: 0,0:09:38.22,0:09:39.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:44.64,0:09:46.43,Default,,0,0,0,,Әй, тез отыр да...
Dialogue: 0,0:09:46.43,0:09:46.89,Default,,0,0,0,,Әй, тезірек отырыңыз...
Dialogue: 0,0:09:46.43,0:09:46.89,Default,,0,0,0,,Джинтан, саған айтар сөзім бар.
Dialogue: 0,0:09:46.89,0:09:49.06,Default,,0,0,0,,Джинтан, саған айтар сөзім бар.
Dialogue: 0,0:09:50.44,0:09:54.36,Default,,0,0,0,,Сөйлесу... Қарашы, Гаргари-кун, еріп кетеді.
Dialogue: 0,0:09:54.48,0:09:57.57,Default,,0,0,0,,Менманың тілегі, Орындалғанын қалаймын.
Dialogue: 0,0:09:59.99,0:10:01.66,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:10:01.78,0:10:04.20,Default,,0,0,0,,Мен де өз жолыммен істеп жатырмын.
Dialogue: 0,0:10:04.33,0:10:07.16,Default,,0,0,0,,Бұл... әртүрлі заттар.
Dialogue: 0,0:10:07.37,0:10:08.25,Default,,0,0,0,,Иә
Dialogue: 0,0:10:08.79,0:10:13.00,Default,,0,0,0,,Мен Юкиацу сияқты құмар емеспін, бірақ...
Dialogue: 0,0:10:13.46,0:10:16.09,Default,,0,0,0,,Бірақ мен үшін...
Dialogue: 0,0:10:16.55,0:10:17.38,Default,,0,0,0,,Иә
Dialogue: 0,0:10:21.64,0:10:24.43,Default,,0,0,0,,Мен де өз жолымда бос емеспін!
Dialogue: 0,0:10:24.64,0:10:27.18,Default,,0,0,0,,Сен үшін уайымдайтын уақытым жоқ!
Dialogue: 0,0:10:28.35,0:10:28.77,Default,,0,0,0,,Цзиньтан…
Dialogue: 0,0:10:28.77,0:10:29.60,Default,,0,0,0,,Цзиньтан…
Dialogue: 0,0:10:28.77,0:10:29.60,Default,,0,0,0,,Үйдемін!
Dialogue: 0,0:10:29.60,0:10:30.77,Default,,0,0,0,,Үйдемін!
Dialogue: 0,0:10:31.94,0:10:33.77,Default,,0,0,0,,Ах~ мен де бүгін шаршадым.
Dialogue: 0,0:10:34.19,0:10:36.53,Default,,0,0,0,,Уа! Бұл не? Сіз той жасап жатырсыз ба? ―
Dialogue: 0,0:10:36.78,0:10:42.37,Default,,0,0,0,,Әй, Гаргари-кун! Сондай сүйкімді! Мен оны аламын ба? Сонымен...
Dialogue: 0,0:10:42.49,0:10:45.12,Default,,0,0,0,,А... бұл сүйкімді емес.
Dialogue: 0,0:10:46.08,0:10:47.29,Default,,0,0,0,,Не деген…
Dialogue: 0,0:10:49.58,0:10:53.42,Default,,0,0,0,,Мені немен айналысады?
Dialogue: 0,0:10:53.54,0:10:57.55,Default,,0,0,0,,Тамақ ішіңіз, интернетті шарлаңыз, ұйықтаңыз және ойын ойнаңыз.
Dialogue: 0,0:10:57.67,0:10:58.97,Default,,0,0,0,,Ұйықта, тамақтан...
Dialogue: 0,0:11:00.59,0:11:02.22,Default,,0,0,0,,Бұл қайталау...
Dialogue: 0,0:11:02.93,0:11:04.22,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:08.81,0:11:10.14,Default,,0,0,0,,《Дегенмен, мен мектеп қызметкері немесе официант болып кіріп көрсем де,
Dialogue: 0,0:11:16.98,0:11:20.65,Default,,0,0,0,,Мен үйге бара жатқанда пойызға отырдым.
Dialogue: 0,0:11:20.82,0:11:25.95,Default,,0,0,0,,Олар жұмысты 7-де бітіретін сияқты, сондықтан...
Dialogue: 0,0:11:28.83,0:11:31.87,Default,,0,0,0,,Ах! Мен Наруконың келгеніне қуаныштымын -
Dialogue: 0,0:11:31.87,0:11:32.12,Default,,0,0,0,,Ах! Мен Наруконың келгеніне қуаныштымын -
Dialogue: 0,0:11:31.87,0:11:32.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:32.12,0:11:32.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:32.67,0:11:35.34,Default,,0,0,0,,Наруко, мен нөмірді қосып қойдым.
Dialogue: 0,0:11:35.67,0:11:39.34,Default,,0,0,0,,Маған бір рет электрондық пошта арқылы бас тартылған кезде, мен не істеу керектігін ойладым.
Dialogue: 0,0:11:39.46,0:11:39.96,Default,,0,0,0,,Ах
Dialogue: 0,0:11:40.13,0:11:43.18,Default,,0,0,0,,Рас! Рёкун маған ашуланатын шығар.
Dialogue: 0,0:11:43.39,0:11:45.01,Default,,0,0,0,,Рё, бұл маңызды емес!
Dialogue: 0,0:11:45.01,0:11:45.68,Default,,0,0,0,,Рио Бұл маңызды емес!
Dialogue: 0,0:11:45.01,0:11:45.68,Default,,0,0,0,,А... білесің бе, мен...
Dialogue: 0,0:11:45.68,0:11:46.47,Default,,0,0,0,,А... білесің бе, мен...
Dialogue: 0,0:11:46.47,0:11:47.01,Default,,0,0,0,,А... білесің бе, мен...
Dialogue: 0,0:11:46.47,0:11:47.01,Default,,0,0,0,,Бірақ шынымен де, Наруко, мен соңғы кездері адамдармен араласуға қиналып жүрмін.
Dialogue: 0,0:11:47.01,0:11:51.27,Default,,0,0,0,,Бірақ шынымен де, Наруко, мен соңғы кездері адамдармен араласуға қиналып жүрмін.
Dialogue: 0,0:11:51.56,0:11:54.65,Default,,0,0,0,,Сіз дос болудан бас тарту туралы ойлағаныңызды айттыңыз, солай ма?
Dialogue: 0,0:11:54.81,0:11:59.53,Default,,0,0,0,,Харуна, сен байсалды қалжыңсың, солай ма? Наруко
Dialogue: 0,0:12:00.61,0:12:02.53,Default,,0,0,0,,«Біз интеллект туралы айтатын болсақ,
Dialogue: 0,0:12:02.65,0:12:05.32,Default,,0,0,0,,біз жақсы балл алу мүмкіндігін білдірмейміз―
Dialogue: 0,0:12:05.45,0:12:07.03,Default,,0,0,0,,белгілі бір сынақ түрі бойынша,―
Dialogue: 0,0:12:07.20,0:12:09.54,Default,,0,0,0,,немесе тіпті мектепте жақсы оқу мүмкіндігі;―
Dialogue: 0,0:12:09.70,0:12:10.87,Default,,0,0,0,,бұл ең жақсы жағдайда ғана...»
Dialogue: 0,0:12:11.04,0:12:15.21,Default,,0,0,0,,(Шығу қоңырауы)
Dialogue: 0,0:12:22.42,0:12:25.55,Default,,0,0,0,,Ах~ 30 минуттан кейін келесі жолы?
Dialogue: 0,0:12:26.93,0:12:27.80,Default,,0,0,0,,Ах
Dialogue: 0,0:12:36.94,0:12:39.32,Default,,0,0,0,,Әдеттегідей, сіз...
Dialogue: 0,0:12:40.86,0:12:43.40,Default,,0,0,0,,Бұл өте қалыпты, бұл қорқынышты
Dialogue: 0,0:12:43.74,0:12:45.74,Default,,0,0,0,,Сонда менің не істегенімді қалайсыз?
Dialogue: 0,0:12:45.91,0:12:46.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:46.91,0:12:49.58,Default,,0,0,0,,Crossdresser! Мен сені қарғағанымды қалайсың ба?
Dialogue: 0,0:12:51.70,0:12:55.33,Default,,0,0,0,,Иә, бұл жақсырақ болуы мүмкін.
Dialogue: 0,0:12:55.46,0:12:59.09,Default,,0,0,0,,Менің өзін-өзі бағалауымды теңестіру үшін оны ыңғайлы болу үшін пайдалануды тоқтата аласыз ба?
Dialogue: 0,0:13:02.05,0:13:06.34,Default,,0,0,0,,Сіздердің арқаларыңызда мен көп жағдайда тоқтай алдым, рахмет.
Dialogue: 0,0:13:12.10,0:13:15.23,Default,,0,0,0,,Содан кейін маған электрондық хат жіберіп, «Мен сені сүйемін» деп айт.
Dialogue: 0,0:13:15.35,0:13:18.23,Default,,0,0,0,,Эх! Шынайы шын!
Dialogue: 0,0:13:21.61,0:13:24.94,Default,,0,0,0,,Пойызға отырыңыз да, қалаға шығыңыз
Dialogue: 0,0:13:25.20,0:13:26.78,Default,,0,0,0,,Үлкен дүкен сөмкесі
Dialogue: 0,0:13:26.99,0:13:30.07,Default,,0,0,0,,Сен сияқты киім ауыстыру.
Dialogue: 0,0:13:31.08,0:13:36.25,Default,,0,0,0,,Киіміңді ауыстырмасаң құтыла алмайсың. Әртүрлі заттар.
Dialogue: 0,0:13:46.76,0:13:48.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:48.80,0:13:52.10,Default,,0,0,0,,Дәмді! Таңғажайып таңғажайып таңғажайып!
Dialogue: 0,0:13:52.39,0:13:56.60,Default,,0,0,0,,Келесі Рё Чан, оны тез сал!
Dialogue: 0,0:13:56.94,0:13:58.73,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:13:56.94,0:13:58.73,Default,,0,0,0,,Әдепсіз дауыстарды шығармаңыз Ж.К
Dialogue: 0,0:13:58.73,0:13:59.06,Default,,0,0,0,,Ұятсыз дауыстарды шығармаңыз Ж.К
Dialogue: 0,0:13:59.90,0:14:02.98,Default,,0,0,0,,Рё-чан, не қаласаң, тезірек!
Dialogue: 0,0:14:03.15,0:14:04.36,Default,,0,0,0,,Көңілді отырсың ба?
Dialogue: 0,0:14:04.36,0:14:04.61,Default,,0,0,0,,Көңілді отырсың ба?
Dialogue: 0,0:14:04.36,0:14:04.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:04.61,0:14:05.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:05.74,0:14:08.07,Default,,0,0,0,,​​Сіз бірдеңені мәжбүрлеп жатқан сияқтысыз ба?
Dialogue: 0,0:14:08.20,0:14:10.32,Default,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,0:14:12.03,0:14:13.83,Default,,0,0,0,,Әй, бірге кетеміз бе?
Dialogue: 0,0:14:13.95,0:14:14.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:14.87,0:14:17.83,Default,,0,0,0,,Нашар! Мен және Наруко-чан кетіп бара жатырмыз
Dialogue: 0,0:14:17.83,0:14:18.46,Default,,0,0,0,,Нашар! Мен және Наруко-чан кетіп бара жатырмыз
Dialogue: 0,0:14:17.83,0:14:18.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:18.58,0:14:19.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:19.37,0:14:19.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:19.37,0:14:19.79,Default,,0,0,0,,Е...күте тұрыңыз!
Dialogue: 0,0:14:19.79,0:14:20.50,Default,,0,0,0,,Е...күте тұрыңыз!
Dialogue: 0,0:14:20.50,0:14:20.83,Default,,0,0,0,,Е...күте тұрыңыз!
Dialogue: 0,0:14:20.50,0:14:20.83,Default,,0,0,0,,Наруко-чанның жағдайы нашар сияқты, мен де ертең таңертең ерте боламын.
Dialogue: 0,0:14:20.83,0:14:25.17,Default,,0,0,0,,Наруко-чанның жағдайы нашар сияқты, мен де ертең таңертең ерте боламын.
Dialogue: 0,0:14:25.51,0:14:27.01,Default,,0,0,0,,«БІР ПАЙС» Мен оны көруім керек
Dialogue: 0,0:14:27.17,0:14:28.84,Default,,0,0,0,,"Ван Пис" ертең шығады!
Dialogue: 0,0:14:28.97,0:14:29.84,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:29.84,0:14:30.18,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:29.84,0:14:30.18,Default,,0,0,0,,Балалар!
Dialogue: 0,0:14:30.18,0:14:31.18,Default,,0,0,0,,Балалар!
Dialogue: 0,0:14:31.93,0:14:34.68,Default,,0,0,0,,Наруко, кейінірек сенен бірдеңе сұрауға рұқсат етіңіз.
Dialogue: 0,0:14:37.98,0:14:39.35,Default,,0,0,0,,Енді барайық.
Dialogue: 0,0:14:39.48,0:14:41.35,Default,,0,0,0,,А... иә
Dialogue: 0,0:14:42.27,0:14:45.53,Default,,0,0,0,,Сонымен... а... бұл!
Dialogue: 0,0:14:46.03,0:14:46.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:46.78,0:14:48.32,Default,,0,0,0,,Станция осында ма?
Dialogue: 0,0:14:48.44,0:14:49.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:49.32,0:14:50.20,Default,,0,0,0,,Не? Ах...-
Dialogue: 0,0:14:50.41,0:14:55.12,Default,,0,0,0,,Мен... Вокзалға бірге қайтамыз ба, әлде бірдеңе...
Dialogue: 0,0:14:55.33,0:14:59.83,Default,,0,0,0,,Жоқ, шығу деген бұл емес пе?
Dialogue: 0,0:15:00.29,0:15:02.63,Default,,0,0,0,,Ал мен қатты іштім...
Dialogue: 0,0:15:03.04,0:15:06.05,Default,,0,0,0,,Мен демалғым келеді, өтірік айтпа.
Dialogue: 0,0:15:06.17,0:15:09.22,Default,,0,0,0,,Мен... мен шынымен ауырып тұрмын!
Dialogue: 0,0:15:09.38,0:15:11.26,Default,,0,0,0,,Неліктен жай ғана үзіліс жасамасқа?
Dialogue: 0,0:15:11.26,0:15:12.30,Default,,0,0,0,,Неліктен жай ғана үзіліс жасамасқа?
Dialogue: 0,0:15:11.26,0:15:12.30,Default,,0,0,0,,«Егер сіз демалсаңыз»
Dialogue: 0,0:15:12.30,0:15:13.05,Default,,0,0,0,,«Егер сіз демалсаңыз»
Dialogue: 0,0:15:13.14,0:15:15.01,Default,,0,0,0,,Иә! «Ван Пис» жақсы ма?
Dialogue: 0,0:15:15.14,0:15:17.35,Default,,0,0,0,,«БІР ПАЙС» Ертең!
Dialogue: 0,0:15:18.02,0:15:19.06,Default,,0,0,0,,Ха! ? ―
Dialogue: 0,0:15:19.48,0:15:20.69,Default,,0,0,0,,Өзіңіз айттыңыз!
Dialogue: 0,0:15:20.69,0:15:21.69,Default,,0,0,0,,Өзіңіз айттыңыз!
Dialogue: 0,0:15:20.69,0:15:21.69,Default,,0,0,0,,Сіз не киіп жүрсіз?
Dialogue: 0,0:15:21.69,0:15:22.40,Default,,0,0,0,,Сіз не киіп жүрсіз?
Dialogue: 0,0:15:22.60,0:15:23.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:23.86,0:15:26.32,Default,,0,0,0,,Бұл бәрібір тас қараңғы, солай ма?
Dialogue: 0,0:15:26.44,0:15:28.99,Default,,0,0,0,,Иә! Эй...
Dialogue: 0,0:15:29.15,0:15:32.20,Default,,0,0,0,,Жоқ, жоқ! Тоқта! Оған тиме!
Dialogue: 0,0:15:32.32,0:15:33.36,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:15:33.57,0:15:36.08,Default,,0,0,0,,«Иә, иә»… Эй!
Dialogue: 0,0:15:36.20,0:15:40.08,Default,,0,0,0,,Жібер! Эй, мені жібер! !
Dialogue: 0,0:15:41.21,0:15:43.42,Default,,0,0,0,,Иә? Анжо?
Dialogue: 0,0:15:44.21,0:15:44.92,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:15:45.08,0:15:47.42,Default,,0,0,0,,Мен қазір Сукумимен және басқалармен ойнап жатырмын.
Dialogue: 0,0:15:48.63,0:15:49.76,Default,,0,0,0,,Сіз де қосылсаңыз ше?
Dialogue: 0,0:15:50.17,0:15:51.67,Default,,0,0,0,,Иә? Ол кім? Теми
Dialogue: 0,0:15:51.80,0:15:54.59,Default,,0,0,0,,Эй! үшін осылай!
Dialogue: 0,0:15:54.72,0:15:58.60,Default,,0,0,0,,Әй, ә, бұл не деген фарс?
Dialogue: 0,0:16:12.24,0:16:14.95,Default,,0,0,0,,Еркекпен араласқан әйелге көмектесу...
Dialogue: 0,0:16:15.91,0:16:19.29,Default,,0,0,0,,Бұл менің өмірімдегі ең жаман оқиға.
Dialogue: 0,0:16:19.66,0:16:21.70,Default,,0,0,0,,Көмек беру дегенді қалай түсінесіңдер? ―
Dialogue: 0,0:16:21.83,0:16:24.29,Default,,0,0,0,,Бұл мені ұрып, артқа тарту сияқты емес пе?
Dialogue: 0,0:16:24.58,0:16:26.29,Default,,0,0,0,,Менің басым мен бетім жақсы, бірақ
Dialogue: 0,0:16:26.46,0:16:28.96,Default,,0,0,0,,Өкінішке орай, оның физикалық күші жетіспейді.
Dialogue: 0,0:16:29.13,0:16:30.09,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:16:30.51,0:16:34.30,Default,,0,0,0,,Сонда да сен өте нашарсың.
Dialogue: 0,0:16:34.93,0:16:38.47,Default,,0,0,0,,Маған айтқаныңды қаламаймын! Бұл трансвестит!
Dialogue: 0,0:16:38.97,0:16:42.14,Default,,0,0,0,,Ах... кешіріңіз... кешіріңіз
Dialogue: 0,0:16:42.31,0:16:45.94,Default,,0,0,0,,Соны айтсаң оңай болар еді ғой.
Dialogue: 0,0:16:46.40,0:16:47.48,Default,,0,0,0,,Сіз пәксіз бе?
Dialogue: 0,0:16:47.65,0:16:48.65,Default,,0,0,0,,Не!
Dialogue: 0,0:16:49.86,0:16:55.11,Default,,0,0,0,,Нана... Нана... Нанана Мәселе бар ма?
Dialogue: 0,0:16:55.45,0:16:56.91,Default,,0,0,0,,Менімен қыдырғың келе ме?
Dialogue: 0,0:16:56.91,0:16:57.32,Default,,0,0,0,,Менімен қыдырғың келе ме?
Dialogue: 0,0:16:56.91,0:16:57.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:57.32,0:16:57.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:58.74,0:17:01.16,Default,,0,0,0,,... дегеніміз не? иә? иә? ―
Dialogue: 0,0:17:01.33,0:17:04.25,Default,,0,0,0,,Күте тұрыңыз... аа... сізге Менма ұнайды, солай ма?
Dialogue: 0,0:17:04.37,0:17:05.58,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:17:05.71,0:17:08.13,Default,,0,0,0,,...
Dialogue: 0,0:17:08.58,0:17:11.50,Default,,0,0,0,,Мүмкін емес! Өйткені бұл мүмкін емес
Dialogue: 0,0:17:11.71,0:17:12.51,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:17:12.63,0:17:13.92,Default,,0,0,0,,Бұл Сукуми ме?
Dialogue: 0,0:17:14.84,0:17:16.51,Default,,0,0,0,,Мұның несі жақсы?
Dialogue: 0,0:17:17.09,0:17:18.18,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:17:18.34,0:17:21.10,Default,,0,0,0,,Соттамаңыз! Ешкімге ұнамайды немесе басқаша нәрсе ...
Dialogue: 0,0:17:21.22,0:17:25.14,Default,,0,0,0,,Сіз бәрінің көшбасшысысыз, ақылды және спорттықсыз ба?
Dialogue: 0,0:17:25.77,0:17:27.31,Default,,0,0,0,,Мұның бәрі баяғыда.
Dialogue: 0,0:17:27.52,0:17:29.86,Default,,0,0,0,,Ал... бұл рас.
Dialogue: 0,0:17:30.02,0:17:32.48,Default,,0,0,0,,Кейбір күтпеген мейірімді адамдар бар...
Dialogue: 0,0:17:32.61,0:17:35.49,Default,,0,0,0,,Соңғы кездері шашымды жақсырақ күтсем ғой...
Dialogue: 0,0:17:35.61,0:17:38.07,Default,,0,0,0,,Сәлем! Айт! Менің ойымша, ол JUMP фильміндегі Яма-чанға ұқсайды...
Dialogue: 0,0:17:38.07,0:17:38.78,Default,,0,0,0,,Сәлем! Айт! Менің ойымша, ол JUMP фильміндегі Яма-чанға ұқсайды...
Dialogue: 0,0:17:38.07,0:17:38.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:38.78,0:17:38.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:38.91,0:17:39.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:38.91,0:17:39.53,Default,,0,0,0,,А...
Dialogue: 0,0:17:39.53,0:17:40.20,Default,,0,0,0,,А...
Dialogue: 0,0:17:42.62,0:17:43.54,Default,,0,0,0,,Уф
Dialogue: 0,0:17:45.33,0:17:48.12,Default,,0,0,0,,Мен сені ұнататынымды білмеймін...
Dialogue: 0,0:17:48.71,0:17:52.50,Default,,0,0,0,,Мен тек Сукуми үшін алаңдаймын.
Dialogue: 0,0:17:53.09,0:17:54.34,Default,,0,0,0,,Сізге қызық па?
Dialogue: 0,0:17:57.13,0:18:00.85,Default,,0,0,0,,Менма, өтінемін өл. Апай, өліңізші.
Dialogue: 0,0:18:01.05,0:18:04.85,Default,,0,0,0,,Бір нәрсе маған Сукумимен сөйлесуімді қиындатты.
Dialogue: 0,0:18:05.48,0:18:09.15,Default,,0,0,0,,Негізі екеуміздің бір мектепте оқитынымызға біраз қуандым.
Dialogue: 0,0:18:10.10,0:18:14.07,Default,,0,0,0,,Бірақ Сукуми Менманы ұмыта алмайды.
Dialogue: 0,0:18:15.23,0:18:20.07,Default,,0,0,0,,Менма туралы, ұмытылмас теңіз жағасын ұмытуға болмайды
Dialogue: 0,0:18:21.45,0:18:22.53,Default,,0,0,0,,Дәл қазір...
Dialogue: 0,0:18:22.53,0:18:23.24,Default,,0,0,0,,Дәл қазір...
Dialogue: 0,0:18:22.53,0:18:23.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:23.41,0:18:27.08,Default,,0,0,0,,Юкиацу, сіз Шукуумидің атын жоғарыда айттыңыз.
Dialogue: 0,0:18:27.41,0:18:29.25,Default,,0,0,0,,«Біз бірге ойнадық»
Dialogue: 0,0:18:36.71,0:18:40.26,Default,,0,0,0,,Жедел пойыз өтеді. Біраз күтіңіз.
Dialogue: 0,0:18:42.39,0:18:44.93,Default,,0,0,0,,Біз артта қалдық.
Dialogue: 0,0:18:45.10,0:18:45.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:45.60,0:18:46.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:45.60,0:18:46.10,Default,,0,0,0,,(Пойыздың өту дыбысы)
Dialogue: 0,0:18:46.10,0:18:47.35,Default,,0,0,0,,(Пойыздың өту дыбысы)
Dialogue: 0,0:18:47.43,0:18:51.27,Default,,0,0,0,,(Пойыздың өту дыбысы)
Dialogue: 0,0:19:00.15,0:19:01.86,Default,,0,0,0,,Жақсы! Ал...
Dialogue: 0,0:19:03.53,0:19:06.08,Default,,0,0,0,,Поку Поку Поку
Dialogue: 0,0:19:07.12,0:19:08.41,Default,,0,0,0,,Чин-
Dialogue: 0,0:19:10.12,0:19:11.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:16.50,0:19:19.09,Default,,0,0,0,,Сен неге менің үйімде тамақ ішесің?
Dialogue: 0,0:19:19.63,0:19:22.09,Default,,0,0,0,,Жабайы көкөністер Сіз оны ұсындыңыз! ―
Dialogue: 0,0:19:22.26,0:19:24.93,Default,,0,0,0,,Хмм! Ақыр аяғында бұл темпура!
Dialogue: 0,0:19:25.81,0:19:28.47,Default,,0,0,0,,Поппо Сіз дәмді жейсіз, солай емес пе?
Dialogue: 0,0:19:28.60,0:19:30.81,Default,,0,0,0,,Мұрынның үстіңгі жағы лас.
Dialogue: 0,0:19:32.02,0:19:34.15,Default,,0,0,0,,Аа, дұрыс. Менма осында ма?
Dialogue: 0,0:19:34.73,0:19:36.90,Default,,0,0,0,,Иә! Мен осындамын
Dialogue: 0,0:19:37.02,0:19:38.65,Default,,0,0,0,,Менманы да же, темпура
Dialogue: 0,0:19:38.65,0:19:39.65,Default,,0,0,0,,Менманы да же, темпура
Dialogue: 0,0:19:38.65,0:19:39.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:40.82,0:19:44.82,Default,,0,0,0,,О... сен бұған шындап сенесің бе? Менма туралы
Dialogue: 0,0:19:44.99,0:19:47.41,Default,,0,0,0,,Мен саған өткен күні айттым!
Dialogue: 0,0:19:47.79,0:19:48.79,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:50.62,0:19:53.62,Default,,0,0,0,,Мен бұл туралы тағы да ойладым.
Dialogue: 0,0:19:54.21,0:19:57.75,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ Менманың осында болуы нені білдіреді?
Dialogue: 0,0:19:58.00,0:19:59.84,Default,,0,0,0,,Жақсы нәрсе емес шығар.
Dialogue: 0,0:20:01.05,0:20:03.18,Default,,0,0,0,,Буддалыққа жете алмау...
Dialogue: 0,0:20:04.05,0:20:05.85,Default,,0,0,0,,Сенің осында жүргенің осы емес пе?
Dialogue: 0,0:20:06.22,0:20:08.26,Default,,0,0,0,,Буддалық…
Dialogue: 0,0:20:10.31,0:20:14.69,Default,,0,0,0,,Мен... түсінбеймін. Анау... Болды.
Dialogue: 0,0:20:14.69,0:20:14.98,Default,,0,0,0,,Мен... түсінбеймін. Анау... Болды.
Dialogue: 0,0:20:14.69,0:20:14.98,Default,,0,0,0,,Джинтан?
Dialogue: 0,0:20:14.98,0:20:15.35,Default,,0,0,0,,Джинтан?
Dialogue: 0,0:20:15.35,0:20:15.98,Default,,0,0,0,,Джинтан?
Dialogue: 0,0:20:15.35,0:20:15.98,Default,,0,0,0,,Менма...!
Dialogue: 0,0:20:15.98,0:20:16.52,Default,,0,0,0,,Менма...!
Dialogue: 0,0:20:17.27,0:20:18.32,Default,,0,0,0,,Менма, сен сондасың ба?
Dialogue: 0,0:20:18.32,0:20:19.19,Default,,0,0,0,,Менма, сен сондасың ба?
Dialogue: 0,0:20:18.32,0:20:19.19,Default,,0,0,0,,Иә?Ах, бұл...
Dialogue: 0,0:20:19.19,0:20:20.11,Default,,0,0,0,,Иә?Ах, бұл...
Dialogue: 0,0:20:20.36,0:20:22.11,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:20:22.11,0:20:22.20,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:20:22.11,0:20:22.20,Default,,0,0,0,,Иә? Күте тұрыңыз...
Dialogue: 0,0:20:22.20,0:20:22.86,Default,,0,0,0,,Иә? Күте тұрыңыз...
Dialogue: 0,0:20:22.86,0:20:23.65,Default,,0,0,0,,Иә? Күте тұрыңыз...
Dialogue: 0,0:20:22.86,0:20:23.65,Default,,0,0,0,,Эй, Менма, сәл ғана, Хинт-кун, солай ма?
Dialogue: 0,0:20:23.65,0:20:27.20,Default,,0,0,0,,Эй, Менма, сәл ғана, Хинт-кун, солай ма?
Dialogue: 0,0:20:27.41,0:20:28.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:28.28,0:20:31.12,Default,,0,0,0,,Мен покпокучинмін.
Dialogue: 0,0:20:31.79,0:20:33.62,Default,,0,0,0,,Қалайсыз, солай ма?
Dialogue: 0,0:20:34.21,0:20:36.79,Default,,0,0,0,,Ей, сен де маған сене аласың!
Dialogue: 0,0:20:37.04,0:20:40.13,Default,,0,0,0,,Мен сізге Буддалыққа жетуге көмектесе аламын.
Dialogue: 0,0:20:40.38,0:20:41.88,Default,,0,0,0,,Эй... Хисакава
Dialogue: 0,0:20:41.88,0:20:42.22,Default,,0,0,0,,Эй... Хисакава
Dialogue: 0,0:20:41.88,0:20:42.22,Default,,0,0,0,,Сәлем Менма
Dialogue: 0,0:20:42.22,0:20:43.13,Default,,0,0,0,,Сәлем Менма
Dialogue: 0,0:20:43.55,0:20:45.30,Default,,0,0,0,,Айтыңызшы, өтінемін!
Dialogue: 0,0:20:45.55,0:20:48.14,Default,,0,0,0,,Бұл жай ғана Цзиньтан емес...
Dialogue: 0,0:20:48.39,0:20:50.14,Default,,0,0,0,,Менің де алдымнан шығуыңызды өтінемін! ―
Dialogue: 0,0:20:51.10,0:20:52.73,Default,,0,0,0,,Жоқ? Эй
Dialogue: 0,0:20:52.73,0:20:53.39,Default,,0,0,0,,Жоқ? Эй
Dialogue: 0,0:20:52.73,0:20:53.39,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:20:53.39,0:20:54.39,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:20:55.90,0:21:01.23,Default,,0,0,0,,Менма, мен бәрімен сөйлескім келеді.
Dialogue: 0,0:21:03.57,0:21:05.78,Default,,0,0,0,,Бірақ мен түсінбеймін.
Dialogue: 0,0:21:05.78,0:21:06.07,Default,,0,0,0,,Бірақ мен түсінбеймін.
Dialogue: 0,0:21:05.78,0:21:06.07,Default,,0,0,0,,үшін бірге -
Dialogue: 0,0:21:06.07,0:21:06.49,Default,,0,0,0,,үшін бірге -
Dialogue: 0,0:21:06.49,0:21:06.99,Default,,0,0,0,,үшін бірге-
Dialogue: 0,0:21:06.49,0:21:06.99,Default,,0,0,0,,Өтініштер, Буддалыққа жету және т.б.
Dialogue: 0,0:21:06.99,0:21:07.16,Default,,0,0,0,,Өтініштер, Буддалыққа жету және т.б.
Dialogue: 0,0:21:07.16,0:21:09.08,Default,,0,0,0,,Өтініштер, Буддалыққа жету және т.б.
Dialogue: 0,0:21:07.16,0:21:09.08,Default,,0,0,0,,Бұл туралы көп ойланайық.
Dialogue: 0,0:21:09.08,0:21:09.49,Default,,0,0,0,,Өтініштер, Буддалыққа жету және т.б.
Dialogue: 0,0:21:09.62,0:21:12.66,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:21:12.66,0:21:13.00,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:21:12.66,0:21:13.00,Default,,0,0,0,,Эй, бұл жақсы емес пе? ―
Dialogue: 0,0:21:13.00,0:21:14.08,Default,,0,0,0,,Эй, бұл жақсы емес пе? ―
Dialogue: 0,0:21:14.33,0:21:16.25,Default,,0,0,0,,Өтінемін, бәрі бір ойлан!
Dialogue: 0,0:21:16.46,0:21:18.08,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:21:18.38,0:21:19.59,Default,,0,0,0,,Сонда Менма бар...
Dialogue: 0,0:21:19.59,0:21:20.71,Default,,0,0,0,,Сонда Менма бар...
Dialogue: 0,0:21:19.59,0:21:20.71,Default,,0,0,0,,Поппо!
Dialogue: 0,0:21:21.59,0:21:26.09,Default,,0,0,0,,(Менманың жылауы)
Dialogue: 0,0:21:26.55,0:21:28.01,Default,,0,0,0,,Сіз мұны тоқтата аласыз ба?
Dialogue: 0,0:21:28.72,0:21:29.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:32.64,0:21:35.69,Default,,0,0,0,,Өтінемін, тоқтатыңыз.
Dialogue: 0,0:21:43.28,0:21:44.78,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:21:53.04,0:21:55.29,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:21:57.08,0:22:49.84,Default,,0,0,0,,♪～
Dialogue: 0,0:22:51.68,0:22:52.85,Default,,0,0,0,,Босшут! ―
Dialogue: 0,0:22:53.05,0:22:55.64,Default,,0,0,0,,Босшу! !
