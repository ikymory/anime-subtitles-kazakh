Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:41.20,0:00:42.54,Default,,0,0,0,,Мені ұстаңыз
Dialogue: 0,0:00:53.17,0:00:55.72,Default,,0,0,0,,Мен сонда бардым.
Dialogue: 0,0:00:56.72,0:00:58.39,Default,,0,0,0,,Қашқаннан пайда жоқ
Dialogue: 0,0:01:03.68,0:01:06.06,Default,,0,0,0,,Болды, бас тарт.
Dialogue: 0,0:01:13.57,0:01:14.40,Default,,0,0,0,,Таз
Dialogue: 0,0:01:24.41,0:01:25.62,Default,,0,0,0,,Қашпа
Dialogue: 0,0:01:49.27,0:01:51.82,Default,,0,0,0,,Дайын бол, сатқын.
Dialogue: 0,0:02:14.92,0:02:16.34,Default,,0,0,0,,Мен Анджелиномын
Dialogue: 0,0:02:16.67,0:02:19.47,Default,,0,0,0,,Бұл қараңғы ет қаласы
Dialogue: 0,0:02:19.59,0:02:22.35,Default,,0,0,0,,Мен туып-өскен, мүмкін өлетін қала
Dialogue: 0,0:02:23.81,0:02:26.02,Default,,0,0,0,,Қараңғы ет қаласы
Dialogue: 0,0:02:26.14,0:02:30.35,Default,,0,0,0,,“DMC” – пайдасыз, бақытсыз және тозығы жеткен қала.
Dialogue: 0,0:02:31.73,0:02:34.36,Default,,0,0,0,,Мен 22 жаста пицца жеткізуші баламын
Dialogue: 0,0:02:34.57,0:02:37.11,Default,,0,0,0,,Жұмыс істегенде, айлық алады.
Dialogue: 0,0:02:37.32,0:02:38.61,Default,,0,0,0,,Драмалық емес.
Dialogue: 0,0:02:38.78,0:02:41.87,Default,,0,0,0,,Өмір жеткілікті түрде күрделі
Dialogue: 0,0:02:48.12,0:02:50.92,Default,,0,0,0,,Менің өмірім сәтсіздікке ұшырау алдында.
Dialogue: 0,0:02:51.08,0:02:54.63,Default,,0,0,0,,Сәтсіздікке ұшырағандар көп, сондықтан мен шағымданбаймын.
Dialogue: 0,0:02:57.34,0:02:59.22,Default,,0,0,0,,Жолдан кет! баспанасыз адамдар
Dialogue: 0,0:03:00.09,0:03:02.18,Default,,0,0,0,,Бұл сұмдық қала.
Dialogue: 0,0:03:02.34,0:03:03.89,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз
Dialogue: 0,0:03:05.85,0:03:07.89,Default,,0,0,0,,Мен сенің қауырсыныңды жұлып аламын
Dialogue: 0,0:03:09.10,0:03:13.31,Default,,0,0,0,,Менің бақытсыз өмірім осылай жалғасады деп ойладым.
Dialogue: 0,0:03:18.19,0:03:20.15,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:03:29.62,0:03:32.58,Default,,0,0,0,,Махаббат трагедиямен аяқталатын сияқты.
Dialogue: 0,0:03:34.29,0:03:35.34,Default,,0,0,0,,Бірақ сіз білесіз бе?
Dialogue: 0,0:03:36.04,0:03:37.55,Default,,0,0,0,,Бұл менің алғашқы махаббатым
Dialogue: 0,0:03:43.72,0:03:46.39,Default,,0,0,0,,Жұмыс үш аптадан аз уақытқа созылады.
Dialogue: 0,0:03:46.72,0:03:49.56,Default,,0,0,0,,Тумысынан жеңілген
Dialogue: 0,0:03:50.39,0:03:53.73,Default,,0,0,0,,Винс тез ашуланады.
Dialogue: 0,0:03:53.90,0:03:55.90,Default,,0,0,0,,Ешкім жұмысқа алмайды
Dialogue: 0,0:03:56.56,0:03:58.27,Default,,0,0,0,,Қаладан қашып құтыла алмаймын
Dialogue: 0,0:03:59.73,0:04:02.40,Default,,0,0,0,,Ең мықтысы ғана аман қалады
Dialogue: 0,0:04:02.57,0:04:05.91,Default,,0,0,0,,Шыққандардың гендері әртүрлі.
Dialogue: 0,0:04:09.74,0:04:12.58,Default,,0,0,0,,Ең бастысы - көзге түспеу.
Dialogue: 0,0:04:14.79,0:04:16.50,Default,,0,0,0,,Маған оғаш адам сияқты қарайды
Dialogue: 0,0:04:16.67,0:04:18.75,Default,,0,0,0,,Мен жай ғана үйге барғым келеді
Dialogue: 0,0:04:18.92,0:04:21.26,Default,,0,0,0,,Ұсқынсыз ақымақтар ақымақ
Dialogue: 0,0:04:22.05,0:04:24.22,Default,,0,0,0,,Аман есен...
Dialogue: 0,0:04:26.47,0:04:29.60,Default,,0,0,0,,Ақырында біз Гвадалупе қонақүйіне келдік.
Dialogue: 0,0:04:29.81,0:04:33.77,Default,,0,0,0,,Мен осында төрт жыл тұрдым, мен өмір бойы сотталғандай сезінемін.
Dialogue: 0,0:04:38.02,0:04:38.90,Default,,0,0,0,,Винс
Dialogue: 0,0:04:39.02,0:04:40.19,Default,,0,0,0,,Бұл тәртіпсіздік.
Dialogue: 0,0:04:40.53,0:04:44.15,Default,,0,0,0,,Күндердің күнінде тазаламасаң, әбігер болады.
Dialogue: 0,0:04:44.45,0:04:46.78,Default,,0,0,0,,Бұл бетке не болды?
Dialogue: 0,0:04:47.82,0:04:50.58,Default,,0,0,0,,Маған жүк көлігі соқтығысты
Dialogue: 0,0:04:50.70,0:04:53.00,Default,,0,0,0,,Барлығы дөрекі көлік жүргізеді.
Dialogue: 0,0:04:53.29,0:04:54.46,Default,,0,0,0,,Сондай-ақ, мен жұмыстан шығарылдым.
Dialogue: 0,0:04:54.62,0:04:55.92,Default,,0,0,0,,Ято ондай Қасиетті Құралды неге сақтап жүр?
Dialogue: 0,0:04:56.08,0:04:57.42,Default,,0,0,0,,Тарақандарды немен тамақтандыру керек?
Dialogue: 0,0:04:57.54,0:04:59.75,Default,,0,0,0,,Еденде көп нәрсе бар.
Dialogue: 0,0:04:59.88,0:05:03.88,Default,,0,0,0,,Ондай лас тамақ ішіңді ауыртады.
Dialogue: 0,0:05:06.05,0:05:08.64,Default,,0,0,0,,Мен жұмыссызмын, пәтерақым 2 айға кешігіп жатыр.
Dialogue: 0,0:05:08.80,0:05:10.68,Default,,0,0,0,,Өте нашар
Dialogue: 0,0:05:11.85,0:05:14.18,Default,,0,0,0,,Мен бұл туралы бірдеңе істеуім керек.
Dialogue: 0,0:05:15.06,0:05:16.98,Default,,0,0,0,,Виллимен сөйлесу
Dialogue: 0,0:05:17.15,0:05:19.23,Default,,0,0,0,,Вилли? Маған үзіліс беріңіз
Dialogue: 0,0:05:19.94,0:05:22.28,Default,,0,0,0,,Жүр, бұл әке.
Dialogue: 0,0:05:22.40,0:05:24.44,Default,,0,0,0,,Кешкі ас ішейік
Dialogue: 0,0:05:26.40,0:05:28.82,Default,,0,0,0,,Бүгін көп адам жиналды.
Dialogue: 0,0:05:28.99,0:05:31.91,Default,,0,0,0,,Бұл жігіттер жиіркенішті.
Dialogue: 0,0:05:32.08,0:05:34.87,Default,,0,0,0,,Бұл қасірет пен бейшаралықтың белгісі.
Dialogue: 0,0:05:43.38,0:05:45.80,Default,,0,0,0,,Бөлме қабылданады
Dialogue: 0,0:05:46.17,0:05:49.64,Default,,0,0,0,,Менің қорқынышты өміріме тарақандар себеп болды.
Dialogue: 0,0:05:52.01,0:05:56.48,Default,,0,0,0,,Егер бұл шынымен жаман болса, мен тарақандарды да тастаймын.
Dialogue: 0,0:07:30.45,0:07:33.99,Default,,0,0,0,,Ей, ақымақтар, Чинатаунға қайтыңдар.
Dialogue: 0,0:07:34.95,0:07:38.49,Default,,0,0,0,,Қазіргі қоғам лаңкестік қаупіне ұшырады...
Dialogue: 0,0:07:38.62,0:07:40.50,Default,,0,0,0,,Менің басым қатты ауырады.
Dialogue: 0,0:07:42.25,0:07:43.79,Default,,0,0,0,,Рено, жақсысың ба?
Dialogue: 0,0:07:43.92,0:07:45.96,Default,,0,0,0,,Түні бойы қорқынышты түс көрдім.
Dialogue: 0,0:07:46.09,0:07:48.63,Default,,0,0,0,,Бұл мотоцикл апатына байланысты.
Dialogue: 0,0:07:48.75,0:07:53.63,Default,,0,0,0,,Ауруханаға барыңыз, басыңыз жарылған болуы мүмкін.
Dialogue: 0,0:07:53.76,0:07:57.68,Default,,0,0,0,,Диагнозды әсірелеуге байланысты ірі көлемде ақша өндіріп алды
Dialogue: 0,0:08:03.77,0:08:06.65,Default,,0,0,0,,Шынайы ма? Менде жағымсыз сезім бар.
Dialogue: 0,0:08:12.32,0:08:13.78,Default,,0,0,0,,Оны аш, бұл менмін.
Dialogue: 0,0:08:14.16,0:08:16.62,Default,,0,0,0,,Бұл Вилли
Dialogue: 0,0:08:18.95,0:08:22.33,Default,,0,0,0,,Мен теледидарды естимін, оны қосыңыз.
Dialogue: 0,0:08:22.46,0:08:26.17,Default,,0,0,0,,Мен сені тесігінен көремін
Dialogue: 0,0:08:26.67,0:08:27.71,Default,,0,0,0,,Нитеба
Dialogue: 0,0:08:27.96,0:08:30.21,Default,,0,0,0,,Тоқта, ол менің басымда жаңғырық.
Dialogue: 0,0:08:36.47,0:08:38.18,Default,,0,0,0,,Эй, шіркін
Dialogue: 0,0:08:38.30,0:08:41.31,Default,,0,0,0,,Gya gya шулы
Dialogue: 0,0:08:38.30,0:08:41.31,Default,,0,0,0,,〝Бөлме 666 Жылан〞
Dialogue: 0,0:08:43.31,0:08:46.48,Default,,0,0,0,,Осы қарқынмен мені жылан жігіт өлтіреді.
Dialogue: 0,0:08:46.65,0:08:49.19,Default,,0,0,0,,Менің басым екіге бөлініп кететін сияқты
Dialogue: 0,0:08:50.32,0:08:54.24,Default,,0,0,0,,Мен біраз уақыт күттім. Порно көрдіңіз бе?
Dialogue: 0,0:08:54.40,0:08:57.74,Default,,0,0,0,,Бұл менің басымда жаңғырық, сондықтан тыныш болыңыз.
Dialogue: 0,0:08:58.45,0:09:00.66,Default,,0,0,0,,Қасыңдағы жігіт кім?
Dialogue: 0,0:09:00.79,0:09:03.75,Default,,0,0,0,,Еркін елде қалаған уақытта айқайлайсың.
Dialogue: 0,0:09:04.75,0:09:06.83,Default,,0,0,0,,Рено Солай емес пе?
Dialogue: 0,0:09:07.00,0:09:09.84,Default,,0,0,0,,Өтінемін, үндемеңіз.
Dialogue: 0,0:09:10.55,0:09:11.55,Default,,0,0,0,,Сонымен... мені ұмытып қалғың келе ме?
Dialogue: 0,0:09:11.71,0:09:15.34,Default,,0,0,0,,Біз лаңкестерге қарсы шабуылдарымызды тоқтатпаймыз...
Dialogue: 0,0:09:15.47,0:09:18.68,Default,,0,0,0,,Террористер қайда?
Dialogue: 0,0:09:18.80,0:09:21.68,Default,,0,0,0,,Ол сіздің қасыңызда жасырынып жатқан болуы мүмкін.
Dialogue: 0,0:09:22.47,0:09:23.77,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:09:24.06,0:09:28.40,Default,,0,0,0,,Бұл бет нағыз террорист.
Dialogue: 0,0:09:28.56,0:09:30.31,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:09:40.91,0:09:42.70,Default,,0,0,0,,Бұл менің хот-догым болса да
Dialogue: 0,0:09:42.87,0:09:46.87,Default,,0,0,0,,Тарақандармен жиі өмір сүруге болады.
Dialogue: 0,0:09:47.00,0:09:49.88,Default,,0,0,0,,Олар ауру әкеледі.
Dialogue: 0,0:09:50.00,0:09:51.63,Default,,0,0,0,,Сонымен не керек?
Dialogue: 0,0:09:52.42,0:09:54.55,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:09:54.67,0:09:58.26,Default,,0,0,0,,Қалайсың деп қызық болдым.
Dialogue: 0,0:09:58.43,0:10:02.26,Default,,0,0,0,,Кішкене сыртқа шықпасаң, зомбиге айналасың.
Dialogue: 0,0:10:03.60,0:10:05.73,Default,,0,0,0,,Профессионалды күрес жалған
Dialogue: 0,0:10:05.89,0:10:08.73,Default,,0,0,0,,Тіпті мен рингте тұра аламын
Dialogue: 0,0:10:08.85,0:10:09.73,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:10.10,0:10:12.94,Default,,0,0,0,,Оны қаңқа басымен жасауға болмайды.
Dialogue: 0,0:10:18.28,0:10:19.95,Default,,0,0,0,,Мен автобустарды жек көремін.
Dialogue: 0,0:10:21.62,0:10:24.58,Default,,0,0,0,,Бірақ көшеде жүрсең, шатасып қаласың.
Dialogue: 0,0:10:24.79,0:10:26.79,Default,,0,0,0,,Бұл шынымен қорқынышты қала.
Dialogue: 0,0:10:26.95,0:10:30.75,Default,,0,0,0,,Ақырында бәрі осы қалаға жұтылады
Dialogue: 0,0:10:31.04,0:10:33.25,Default,,0,0,0,,Тек уақыты басқа.
Dialogue: 0,0:10:34.46,0:10:37.26,Default,,0,0,0,,Бір күні қашып кеткім келеді
Dialogue: 0,0:10:37.38,0:10:39.09,Default,,0,0,0,,Менің көлігім жоқ
Dialogue: 0,0:10:39.72,0:10:41.97,Default,,0,0,0,,Автобус айналады.
Dialogue: 0,0:10:42.39,0:10:44.47,Default,,0,0,0,,Сіз шындықты көруіңіз керек
Dialogue: 0,0:10:44.89,0:10:49.77,Default,,0,0,0,,Ақша жоқ, үміт жоқ, бәріміз зомби сияқтымыз
Dialogue: 0,0:10:50.39,0:10:53.31,Default,,0,0,0,,Біз көлеңкеден төменміз
Dialogue: 0,0:11:08.45,0:11:10.79,Default,,0,0,0,,Рено Ойдан тыс қалмаңыз
Dialogue: 0,0:11:10.96,0:11:12.12,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:11:12.50,0:11:15.63,Default,,0,0,0,,Қасынан өте біртүрлі адам өтіп бара жатты.
Dialogue: 0,0:11:16.63,0:11:17.71,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:11:20.59,0:11:22.68,Default,,0,0,0,,Ақыры сыртқа шыға алдым.
Dialogue: 0,0:11:23.05,0:11:25.01,Default,,0,0,0,,Біз не жейміз?
Dialogue: 0,0:11:25.35,0:11:27.18,Default,,0,0,0,,Мен сізге хот-дог қарызмын.
Dialogue: 0,0:11:30.18,0:11:32.06,Default,,0,0,0,,Diablo үшін чили бұрышын қолданыңыз...
Dialogue: 0,0:11:36.44,0:11:38.07,Default,,0,0,0,,Сонымен жауынгерлік рух...
Dialogue: 0,0:11:42.03,0:11:43.20,Default,,0,0,0,,Рено, жақсысың ба?
Dialogue: 0,0:11:43.36,0:11:44.87,Default,,0,0,0,,Маған не болды?
Dialogue: 0,0:11:46.20,0:11:49.70,Default,,0,0,0,,Рено, кеттік, бізге бірдеңе жеу керек.
Dialogue: 0,0:11:54.04,0:11:55.88,Default,,0,0,0,,Винс дұрыс айтады.
Dialogue: 0,0:11:56.38,0:11:59.21,Default,,0,0,0,,Мүмкін ол апатқа ұшырап, басы сынған шығар.
Dialogue: 0,0:11:59.38,0:12:00.71,Default,,0,0,0,,Бұл әлдеқайда ауыр ма?
Dialogue: 0,0:12:01.22,0:12:02.63,Default,,0,0,0,,Миыңыз зақымдалды ма?
Dialogue: 0,0:12:04.14,0:12:06.93,Default,,0,0,0,,Бір нәрсе сіздің миыңызды бұзады
Dialogue: 0,0:12:07.35,0:12:09.52,Default,,0,0,0,,Екі аптадан кейін өлесің бе?
Dialogue: 0,0:12:11.23,0:12:13.73,Default,,0,0,0,,Рено, сен ауырып тұрған сияқтысың.
Dialogue: 0,0:12:13.89,0:12:15.52,Default,,0,0,0,,Үйде демалғыңыз келе ме?
Dialogue: 0,0:12:16.98,0:12:20.78,Default,,0,0,0,,Мен біртүрлі нәрсе көріп тұрмын.
Dialogue: 0,0:12:21.15,0:12:22.78,Default,,0,0,0,,Мысалы, сол адам
Dialogue: 0,0:12:23.32,0:12:25.78,Default,,0,0,0,,Қараңызшы, бұл біртүрлі емес пе?
Dialogue: 0,0:12:29.74,0:12:30.95,Default,,0,0,0,,Қай жағынан?
Dialogue: 0,0:12:31.70,0:12:34.92,Default,,0,0,0,,Көлеңке Бэтменге ұқсайды
Dialogue: 0,0:12:35.08,0:12:37.88,Default,,0,0,0,,Шатырлар өсіп келеді.
Dialogue: 0,0:12:45.01,0:12:46.59,Default,,0,0,0,,Маған біртүрлі қарама
Dialogue: 0,0:12:46.76,0:12:47.60,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:47.76,0:12:48.93,Default,,0,0,0,,Неге деп ойлаймын
Dialogue: 0,0:12:49.10,0:12:51.60,Default,,0,0,0,,Күннің нұры қызған болар.
Dialogue: 0,0:12:51.77,0:12:54.60,Default,,0,0,0,,Дұрыс, көлеңкеге түсейік.
Dialogue: 0,0:12:54.77,0:12:55.85,Default,,0,0,0,,Pipo дүкеніне барыңыз
Dialogue: 0,0:12:56.02,0:12:57.27,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:12:57.44,0:12:59.65,Default,,0,0,0,,Сіз басқа дүкендерді білмейсіз бе?
Dialogue: 0,0:13:04.57,0:13:07.41,Default,,0,0,0,,Бүгінгі ең жоғары температура жаңартылды
Dialogue: 0,0:13:07.57,0:13:11.41,Default,,0,0,0,,осы маусымдағы орташадан 4 градусқа жоғары
Dialogue: 0,0:13:12.87,0:13:15.58,Default,,0,0,0,,Бұл ұшақтың пайдаланылған газынан туындайды.
Dialogue: 0,0:13:16.04,0:13:19.29,Default,,0,0,0,,Адамдарды газдалған сусындарды сатып алуға тарту
Dialogue: 0,0:13:33.60,0:13:34.48,Default,,0,0,0,,Рено
Dialogue: 0,0:13:34.98,0:13:37.14,Default,,0,0,0,,Тәттілердің тәуелділік қасиеті де қастандық.
Dialogue: 0,0:13:37.98,0:13:42.61,Default,,0,0,0,,Жаңа ғана өте сексуалды қыз кіріп келді.
Dialogue: 0,0:13:48.78,0:13:49.53,Default,,0,0,0,,Қарау
Dialogue: 0,0:13:49.70,0:13:52.62,Default,,0,0,0,,Сізді Рено қызықтырады ма?
Dialogue: 0,0:13:56.00,0:13:57.16,Default,,0,0,0,,Тапсырысыңыз ше?
Dialogue: 0,0:13:57.46,0:13:59.29,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:13:59.67,0:14:00.63,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:14:03.00,0:14:04.96,Default,,0,0,0,,Сіз төлемейсіз бе?
Dialogue: 0,0:14:09.18,0:14:11.01,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,0:14:11.22,0:14:13.39,Default,,0,0,0,,Маған өзгерту қажет емес.
Dialogue: 0,0:14:21.86,0:14:24.32,Default,,0,0,0,,Мен жақсы ұйықтағым келеді.
Dialogue: 0,0:14:26.49,0:14:28.20,Default,,0,0,0,,Сыртқа шығайық
Dialogue: 0,0:14:28.36,0:14:29.82,Default,,0,0,0,,Бұл жалпақ бел бе?
Dialogue: 0,0:14:30.11,0:14:32.49,Default,,0,0,0,,Мен агрессивті заңнан тыс адаммын.
Dialogue: 0,0:14:32.66,0:14:33.83,Default,,0,0,0,,Мен айтып тұрмын
Dialogue: 0,0:14:33.99,0:14:34.83,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:14:35.33,0:14:39.08,Default,,0,0,0,,Қара костюм киген үш адам, солай ма?
Dialogue: 0,0:14:41.00,0:14:41.83,Default,,0,0,0,,Қайда?
Dialogue: 0,0:14:42.13,0:14:43.79,Default,,0,0,0,,Нәзік болыңыз.
Dialogue: 0,0:14:44.04,0:14:46.05,Default,,0,0,0,,Бұл жігіт аяқ киімінің бауын жөндеп тұр ма?
Dialogue: 0,0:14:46.30,0:14:48.13,Default,,0,0,0,,Екі дос бар
Dialogue: 0,0:14:48.38,0:14:50.01,Default,,0,0,0,,Олар артымыздан келе жатыр.
Dialogue: 0,0:14:55.39,0:14:57.39,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:15:09.74,0:15:11.95,Default,,0,0,0,,Қарашы, бұл сенің адасуың.
Dialogue: 0,0:15:12.07,0:15:14.74,Default,,0,0,0,,Таңертеңнен бері біртүрлі болды.
Dialogue: 0,0:15:22.25,0:15:24.29,Default,,0,0,0,,Бұл әлі адасушылық па?
Dialogue: 0,0:15:27.00,0:15:29.13,Default,,0,0,0,,Сізге еру себебін тыңдайық
Dialogue: 0,0:15:30.09,0:15:33.47,Default,,0,0,0,,Біз қарап жатырмыз, сондықтан сіз тыңдай аласыз.
Dialogue: 0,0:15:38.68,0:15:39.85,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:15:42.14,0:15:43.81,Default,,0,0,0,,Ниндзя режиміне кіріңіз
Dialogue: 0,0:15:43.94,0:15:46.98,Default,,0,0,0,,Мен сол бұрышқа бұрылғанда, мен бірден жүгіремін.
Dialogue: 0,0:15:49.78,0:15:50.65,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:15:54.74,0:15:55.82,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:16:02.16,0:16:03.46,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:16:08.09,0:16:10.01,Default,,0,0,0,,Тоқта, мен құсамын.
Dialogue: 0,0:16:28.98,0:16:29.98,Default,,0,0,0,,Тоқта
Dialogue: 0,0:16:30.57,0:16:32.53,Default,,0,0,0,,Оның мылтығы бар.
Dialogue: 0,0:16:32.95,0:16:33.99,Default,,0,0,0,,Не?
Dialogue: 0,0:17:02.39,0:17:03.52,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:17:03.68,0:17:05.35,Default,,0,0,0,,Рено қауіпті
Dialogue: 0,0:17:18.87,0:17:19.87,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:17:36.09,0:17:37.76,Default,,0,0,0,,Тез қашайық
Dialogue: 0,0:17:42.89,0:17:44.77,Default,,0,0,0,,Винс, мылтықты алдың ба?
Dialogue: 0,0:17:45.73,0:17:47.39,Default,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:17:53.15,0:17:54.90,Default,,0,0,0,,Олардың мақсаттары қандай?
Dialogue: 0,0:17:55.07,0:17:55.90,Default,,0,0,0,,Бұл өмір
Dialogue: 0,0:17:56.07,0:17:58.78,Default,,0,0,0,,Бұл қаланың жігіттері жынды екен.
Dialogue: 0,0:17:58.95,0:18:02.37,Default,,0,0,0,,Бірақ сіз неге өмірді мақсат етесіз?
Dialogue: 0,0:18:02.49,0:18:06.04,Default,,0,0,0,,Ол бұзақы емес, кәсіби маманға ұқсайды.
Dialogue: 0,0:18:07.25,0:18:09.04,Default,,0,0,0,,Мен бұл дұрыс емес адам екеніне сенімдімін.
Dialogue: 0,0:18:10.17,0:18:13.38,Default,,0,0,0,,Біз сияқты адамдар бар деп ойлайсың ба?
Dialogue: 0,0:18:13.50,0:18:14.55,Default,,0,0,0,,Бұл ЦРУ
Dialogue: 0,0:18:14.67,0:18:15.76,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:18:15.92,0:18:19.22,Default,,0,0,0,,Ол Кеннедиді өлтіруге күдікті болуы мүмкін бе?
Dialogue: 0,0:18:19.34,0:18:21.05,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:18:21.35,0:18:23.39,Default,,0,0,0,,Сіз ағып жатқан жұлдызды көрдіңіз бе?
Dialogue: 0,0:18:23.51,0:18:24.39,Default,,0,0,0,,Қайда?
Dialogue: 0,0:18:24.52,0:18:26.10,Default,,0,0,0,,Сөзсіз бос
Dialogue: 0,0:18:26.27,0:18:28.56,Default,,0,0,0,,Бірақ өте кең, солай емес пе?
Dialogue: 0,0:18:28.69,0:18:31.36,Default,,0,0,0,,Бұл сөзсіз шексіз.
Dialogue: 0,0:18:32.52,0:18:33.40,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:18:33.57,0:18:35.40,Default,,0,0,0,,Тілек айту керек
Dialogue: 0,0:18:35.98,0:18:37.32,Default,,0,0,0,,Рено нені қалайды?
Dialogue: 0,0:18:38.78,0:18:42.07,Default,,0,0,0,,Мен өзімнен басқа біреу болғым келеді
Dialogue: 0,0:18:43.20,0:18:44.08,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:18:57.63,0:18:58.84,Default,,0,0,0,,Мақсатты ашу
Dialogue: 0,0:19:15.73,0:19:19.19,Default,,0,0,0,,Бұл теледидарда не болып жатыр?
Dialogue: 0,0:19:19.78,0:19:22.07,Default,,0,0,0,,Радиотолқындарда ақау бар.
Dialogue: 0,0:19:27.33,0:19:28.20,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:19:29.08,0:19:30.96,Default,,0,0,0,,Теледидарды соқпаңыз
Dialogue: 0,0:19:31.08,0:19:33.96,Default,,0,0,0,,Полиция радиосына ұқсайды.
Dialogue: 0,0:19:35.04,0:19:37.34,Default,,0,0,0,,Қара нүкте операциясы басталады.
Dialogue: 0,0:19:39.42,0:19:40.88,Default,,0,0,0,,«Қара бас» дегеніміз не?
Dialogue: 0,0:20:08.29,0:20:10.83,Default,,0,0,0,,Дәлізде баяу жүруге болмайды
Dialogue: 0,0:20:11.00,0:20:12.83,Default,,0,0,0,,10 секундтан кейін енгізіңіз
Dialogue: 0,0:20:14.71,0:20:16.71,Default,,0,0,0,,Үлкен оқиғаға ұқсайды.
Dialogue: 0,0:20:16.88,0:20:17.84,Default,,0,0,0,,5 секунд қалды
Dialogue: 0,0:20:20.55,0:20:21.26,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:21.42,0:20:22.17,Default,,0,0,0,,Тез кіріңіз!
Dialogue: 0,0:20:32.68,0:20:35.98,Default,,0,0,0,,Онда тұрма, маған қол ұшын бер
Dialogue: 0,0:20:53.54,0:20:54.37,Default,,0,0,0,,Қазіргі жағдай қандай?
Dialogue: 0,0:20:55.42,0:20:56.25,Default,,0,0,0,,Есеп
Dialogue: 0,0:21:48.84,0:21:50.76,Default,,0,0,0,,Менің бөлмемнен шық.
Dialogue: 0,0:21:58.27,0:22:00.77,Default,,0,0,0,,Сіз полицейді өлтірдіңіз бе?
Dialogue: 0,0:22:12.41,0:22:14.16,Default,,0,0,0,,Енді бітті
Dialogue: 0,0:22:14.87,0:22:15.66,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:22:38.81,0:22:39.64,Default,,0,0,0,,Бұл граната.
Dialogue: 0,0:22:48.95,0:22:50.78,Default,,0,0,0,,Терезе арқылы қашу
Dialogue: 0,0:23:33.82,0:23:35.58,Default,,0,0,0,,Эй, міне.
Dialogue: 0,0:23:43.58,0:23:44.58,Default,,0,0,0,,Бұл жаңа техника ма?
Dialogue: 0,0:23:56.18,0:23:57.76,Default,,0,0,0,,Рено асығыңыз
Dialogue: 0,0:24:01.14,0:24:04.10,Default,,0,0,0,,Сіз ниндзяға ұқсадыңыз.
Dialogue: 0,0:24:10.44,0:24:12.15,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:24:13.20,0:24:15.20,Default,,0,0,0,,Мені сен өлтірмегеніңе сенімдімін.
Dialogue: 0,0:24:18.16,0:24:20.66,Default,,0,0,0,,Элиталық күш балаға қарсы...
Dialogue: 0,0:24:22.12,0:24:23.46,Default,,0,0,0,,Бұл оның ісі.
Dialogue: 0,0:24:24.29,0:24:26.96,Default,,0,0,0,,Менің шынайы болмысым ояна бастады
Dialogue: 0,0:24:27.17,0:24:30.88,Default,,0,0,0,,Бастық ашуланады, бірақ ол бала қауіпті.
Dialogue: 0,0:24:31.05,0:24:33.80,Default,,0,0,0,,Біз кеш болмай тұрып тазалауымыз керек
Dialogue: 0,0:24:37.39,0:24:39.35,Default,,0,0,0,,Бұл үлкен қулық емес.
Dialogue: 0,0:24:39.51,0:24:40.93,Default,,0,0,0,,Ол жұмыс істеуі керек.
Dialogue: 0,0:24:49.65,0:24:52.44,Default,,0,0,0,,Diablo-мен бірігу қиын
Dialogue: 0,0:24:57.49,0:24:59.78,Default,,0,0,0,,Оған ренжімеңіз
Dialogue: 0,0:24:59.95,0:25:04.21,Default,,0,0,0,,Ол қатыгез адам, бірақ жанкүйерлер арасында танымал.
Dialogue: 0,0:25:05.29,0:25:07.04,Default,,0,0,0,,Қараңызшы, бұл аян.
Dialogue: 0,0:25:10.21,0:25:12.92,Default,,0,0,0,,Бұл... тарақан ба?
Dialogue: 0,0:25:13.17,0:25:15.22,Default,,0,0,0,,Оракалдар туралы айтуды доғар.
Dialogue: 0,0:25:15.34,0:25:16.51,Default,,0,0,0,,Ырым
Dialogue: 0,0:25:16.93,0:25:20.22,Default,,0,0,0,,Орамалда тарақан, көлікте тың
Dialogue: 0,0:25:20.39,0:25:22.89,Default,,0,0,0,,Жанып жатқан қаңқа да болды.
Dialogue: 0,0:25:23.10,0:25:26.02,Default,,0,0,0,,Бұл ірімшік сэндвичінде.
Dialogue: 0,0:25:26.52,0:25:29.02,Default,,0,0,0,,Мен оның тост болғанына сенімдімін.
Dialogue: 0,0:25:29.61,0:25:33.74,Default,,0,0,0,,Бізге мағынасыз хабарландыруларды ашатын біреу керек.
Dialogue: 0,0:25:35.70,0:25:39.03,Default,,0,0,0,,Әрбір дақ іздеуді доғар.
Dialogue: 0,0:25:39.20,0:25:41.70,Default,,0,0,0,,Оракулдың адасуы басталады.
Dialogue: 0,0:25:42.20,0:25:44.29,Default,,0,0,0,,Миссияны қабылдаңыз
Dialogue: 0,0:25:44.45,0:25:48.71,Default,,0,0,0,,Біз қамқоршылар сақ болмауымыз керек
Dialogue: 0,0:25:50.54,0:25:51.88,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:25:52.05,0:25:54.09,Default,,0,0,0,,Қамқоршылар
Dialogue: 0,0:25:54.26,0:25:57.09,Default,,0,0,0,,Мен пайғамбарлықтың шифрын ашып, өз миссиямды орындадым.
Dialogue: 0,0:25:57.88,0:26:00.14,Default,,0,0,0,,Шайқас қайталанады
Dialogue: 0,0:26:00.97,0:26:02.31,Default,,0,0,0,,Ол күн жақын
Dialogue: 0,0:26:03.10,0:26:06.27,Default,,0,0,0,,Біз қабілетсіз қамқоршылар емеспіз.
Dialogue: 0,0:26:06.89,0:26:07.81,Default,,0,0,0,,Иә.
Dialogue: 0,0:26:09.40,0:26:11.40,Default,,0,0,0,,Неліктен тарақандар?
Dialogue: 0,0:26:12.90,0:26:14.07,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:26:14.40,0:26:16.90,Default,,0,0,0,,Сабырлы болыңыз және күтіңіз.
Dialogue: 0,0:26:17.40,0:26:19.82,Default,,0,0,0,,Тек уақыт көрсетеді
Dialogue: 0,0:26:25.66,0:26:29.79,Default,,0,0,0,,Луча Ультима балуандары
Dialogue: 0,0:26:29.96,0:26:32.09,Default,,0,0,0,,Ацтек жауынгерлерінің ұрпақтары
Dialogue: 0,0:26:35.59,0:26:39.59,Default,,0,0,0,,Таңдаулы қан тобы бұл белгіні шешеді.
Dialogue: 0,0:26:39.76,0:26:43.43,Default,,0,0,0,,Біз басынан бері қараңғылық күштерімен күресіп келеміз.
Dialogue: 0,0:26:50.35,0:26:52.94,Default,,0,0,0,,Ал қазіргі жауынгерлер
Dialogue: 0,0:26:53.11,0:26:56.28,Default,,0,0,0,,Эпикалық шайқасқа дайындық
Dialogue: 0,0:26:56.61,0:26:58.40,Default,,0,0,0,,Керемет қойылыммен
Dialogue: 0,0:26:58.57,0:27:02.12,Default,,0,0,0,,Күн көріспен бірге сол күнді күту
Dialogue: 0,0:27:18.92,0:27:20.30,Default,,0,0,0,,Баланы әкеліңіз
Dialogue: 0,0:27:25.14,0:27:26.31,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:27:34.65,0:27:35.98,Default,,0,0,0,,Бала қайда?
Dialogue: 0,0:27:47.16,0:27:48.50,Default,,0,0,0,,Мария Мария
Dialogue: 0,0:27:48.66,0:27:51.16,Default,,0,0,0,,Өтінемін, мен жақсы көретін екі адамды қорғаңыз.
Dialogue: 0,0:27:51.33,0:27:53.67,Default,,0,0,0,,Қайдан сұрап тұрсыз?
Dialogue: 0,0:28:05.68,0:28:07.18,Default,,0,0,0,,Тағы бір рет тыңдаңыз
Dialogue: 0,0:28:07.35,0:28:08.68,Default,,0,0,0,,Бала қайда?
Dialogue: 0,0:28:10.06,0:28:11.85,Default,,0,0,0,,Жарайды, мен кеттім. Қош бол.
Dialogue: 0,0:28:14.52,0:28:16.69,Default,,0,0,0,,Басыңа оқ атпа
Dialogue: 0,0:28:28.28,0:28:32.00,Default,,0,0,0,,Ол әйел әу бастан жалған болған.
Dialogue: 0,0:28:33.79,0:28:36.04,Default,,0,0,0,,Гаки жақын жерде емес
Dialogue: 0,0:28:52.18,0:28:56.02,Default,,0,0,0,,Бұл дауыстық пошта емес деп үміттенемін.
Dialogue: 0,0:29:10.08,0:29:11.24,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:29:12.08,0:29:13.75,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:29:17.58,0:29:18.42,Default,,0,0,0,,Бұл Вилли.
Dialogue: 0,0:29:18.59,0:29:19.42,Default,,0,0,0,,Рено?
Dialogue: 0,0:29:19.59,0:29:22.76,Default,,0,0,0,,Басқа жақсы жасырынатын жерлер бар ма?
Dialogue: 0,0:29:22.92,0:29:26.76,Default,,0,0,0,,Бұл мен үшін де өте жаман болады.
Dialogue: 0,0:29:26.93,0:29:30.43,Default,,0,0,0,,Бұл қараңғы аудан, сондықтан Винс...
Dialogue: 0,0:29:30.60,0:29:33.06,Default,,0,0,0,,Сіз шынымен сарайды күттіңіз бе?
Dialogue: 0,0:29:33.22,0:29:35.48,Default,,0,0,0,,Жасырыну... Сонымен...
Dialogue: 0,0:29:35.64,0:29:37.73,Default,,0,0,0,,Сигнал нашар ма?
Dialogue: 0,0:29:38.10,0:29:41.61,Default,,0,0,0,,Мен полиция қызметкерін атып тастасам да, көңіл көтере аламын ба?
Dialogue: 0,0:29:41.94,0:29:44.61,Default,,0,0,0,,Қалай болғанда да, бұл жақсы емес.
Dialogue: 0,0:29:44.78,0:29:47.78,Default,,0,0,0,,Қауіпсіз және жақсырақ жер бар ма?
Dialogue: 0,0:29:47.95,0:29:50.58,Default,,0,0,0,,Туристік агенттік емес
Dialogue: 0,0:29:51.28,0:29:54.62,Default,,0,0,0,,Бірақ менің үйіме ешқашан келме.
Dialogue: 0,0:29:54.79,0:29:56.87,Default,,0,0,0,,Мен қазір онымен жұмыс істеп жатырмын.
Dialogue: 0,0:29:57.29,0:30:00.63,Default,,0,0,0,,Вилли, бұл әзіл емес, салмақты...
Dialogue: 0,0:30:01.46,0:30:03.09,Default,,0,0,0,,Тәтті, мен оны кесіп алдым.
Dialogue: 0,0:30:03.71,0:30:05.97,Default,,0,0,0,,кесілген
Dialogue: 0,0:30:07.97,0:30:09.64,Default,,0,0,0,,Жасыл шалбар.
Dialogue: 0,0:30:15.14,0:30:16.14,Default,,0,0,0,,Бұл жерде қауіпті.
Dialogue: 0,0:30:16.77,0:30:19.15,Default,,0,0,0,,Мен өзімді төбелес иттер қоршап алғандай сезінемін.
Dialogue: 0,0:30:19.65,0:30:21.48,Default,,0,0,0,,Өйткені біз жасыл түсті киеміз
Dialogue: 0,0:30:22.07,0:30:23.32,Default,,0,0,0,,Енді уайымдамаңыз
Dialogue: 0,0:30:23.65,0:30:24.98,Default,,0,0,0,,Әзірге
Dialogue: 0,0:30:25.15,0:30:29.16,Default,,0,0,0,,Ыңғайсыз, бірақ мұнда полиция келмейді.
Dialogue: 0,0:30:29.32,0:30:31.49,Default,,0,0,0,,Өйткені бұл бос жер
Dialogue: 0,0:30:31.70,0:30:34.16,Default,,0,0,0,,Мұны естіп, көңілім босап қалды.
Dialogue: 0,0:30:34.49,0:30:39.33,Default,,0,0,0,,Тек көзіңізді төмен түсіріп, жасыл киінбеңіз.
Dialogue: 0,0:30:39.87,0:30:41.33,Default,,0,0,0,,Ерекше болмаңыз
Dialogue: 0,0:30:43.17,0:30:45.00,Default,,0,0,0,,Бөтен адамға ұқсама
Dialogue: 0,0:30:56.85,0:30:58.02,Default,,0,0,0,,Сәлем, балалар
Dialogue: 0,0:30:58.94,0:31:02.27,Default,,0,0,0,,Бұл біздің аумақ. Қайда бара жатырсың?
Dialogue: 0,0:31:02.69,0:31:05.86,Default,,0,0,0,,Абайлаңыз «Секірмес бұрын қараңыз»
Dialogue: 0,0:31:06.03,0:31:07.69,Default,,0,0,0,,Бұл Шекспир.
Dialogue: 0,0:31:09.03,0:31:11.99,Default,,0,0,0,,Менің Вилли есімді досым бар.
Dialogue: 0,0:31:12.16,0:31:16.04,Default,,0,0,0,,Мұның астарында күрделі жағдайлар жатыр...
Dialogue: 0,0:31:17.04,0:31:21.37,Default,,0,0,0,,«Шындықты айтпасаң, сөйлесудің қажеті жоқ».
Dialogue: 0,0:31:30.55,0:31:32.22,Default,,0,0,0,,Қашпа, қарғыс атқыр жасыл!
Dialogue: 0,0:31:33.47,0:31:34.89,Default,,0,0,0,,Винс, кеттік.
Dialogue: 0,0:31:56.12,0:31:59.41,Default,,0,0,0,,Бұл да Виллидің тозығы жеткен баспанасы.
Dialogue: 0,0:31:59.58,0:32:01.25,Default,,0,0,0,,Бірақ шатыр бар
Dialogue: 0,0:32:01.75,0:32:03.58,Default,,0,0,0,,Біраз уақыт шыдаңыз.
Dialogue: 0,0:32:08.05,0:32:12.05,Default,,0,0,0,,Қарғалар да маған бөтен адамдай қарайды.
Dialogue: 0,0:32:20.27,0:32:24.10,Default,,0,0,0,,Мысықтар жүздеген шақырым жерде иелерінің соңынан еретін сияқты.
Dialogue: 0,0:32:24.44,0:32:27.11,Default,,0,0,0,,Менің тарақандарым да келе ме екен?
Dialogue: 0,0:32:35.45,0:32:38.33,Default,,0,0,0,,Оқ алмасаң да, аштан өлесің.
Dialogue: 0,0:32:40.33,0:32:42.41,Default,,0,0,0,,Егер сіз осы жерден көрінсеңіз
Dialogue: 0,0:32:42.58,0:32:45.12,Default,,0,0,0,,Мүмкін сіз бұл дұрыс емес адам деп айта аласыз.
Dialogue: 0,0:32:45.29,0:32:46.04,Default,,0,0,0,,Содан кейін—
Dialogue: 0,0:32:46.42,0:32:50.46,Default,,0,0,0,,Мен мұны RoboCop-қа айтуым керек еді.
Dialogue: 0,0:32:53.30,0:32:55.26,Default,,0,0,0,,Жармаға не болды?
Dialogue: 0,0:32:58.85,0:33:00.31,Default,,0,0,0,,Электр тогы өтеді, солай ма?
Dialogue: 0,0:33:02.48,0:33:05.31,Default,,0,0,0,,Бірінші дәрежелі кісі өлтіргені үшін екі адам іздеуде
Dialogue: 0,0:33:05.31,0:33:05.98,Default,,0,0,0,,Бірінші дәрежелі кісі өлтіргені үшін екі адам іздеуде
Dialogue: 0,0:33:05.31,0:33:05.98,Default,,0,0,0,,〝Пальма Хилл, тәуекелге барыңыз.〞
Dialogue: 0,0:33:05.98,0:33:06.15,Default,,0,0,0,,``Пальм-Хилл, егер сіз барсаңыз, мұны өз тәуекеліңізбен орындаңыз.''
Dialogue: 0,0:33:06.15,0:33:08.77,Default,,0,0,0,,``Пальм-Хилл, егер барсаңыз, мұны өз тәуекеліңізбен орындаңыз.''
Dialogue: 0,0:33:06.15,0:33:08.77,Default,,0,0,0,,Үкіметке қарсы сөз байласу...
Dialogue: 0,0:33:09.90,0:33:10.65,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:33:10.82,0:33:14.32,Default,,0,0,0,,Егер сіз фотодағы екі адамды көрсеңіз
Dialogue: 0,0:33:14.49,0:33:16.78,Default,,0,0,0,,Дереу хабарлаңыз
Dialogue: 0,0:33:17.03,0:33:21.79,Default,,0,0,0,,Винс, қарашы, сен әлі де берілесің бе?
Dialogue: 0,0:33:22.25,0:33:24.41,Default,,0,0,0,,Не айтып тұрғаныңызды тыңдайық.
Dialogue: 0,0:33:24.58,0:33:25.75,Default,,0,0,0,,Дыбыс деңгейін жоғарылатыңыз
Dialogue: 0,0:33:31.92,0:33:34.17,Default,,0,0,0,,Бұл ең нашар
Dialogue: 0,0:33:34.51,0:33:36.38,Default,,0,0,0,,Сіз бізді шымшып қалды деп ойладыңыз ба?
Dialogue: 0,0:33:36.55,0:33:39.18,Default,,0,0,0,,Бұл нағыз шымшу.
Dialogue: 0,0:33:41.35,0:33:44.73,Default,,0,0,0,,Осы жердегі жігіттер хабарлауы керек пе?
Dialogue: 0,0:34:35.61,0:34:37.57,Default,,0,0,0,,Жұмысқа кірісейік
Dialogue: 0,0:34:37.82,0:34:39.57,Default,,0,0,0,,Үшеуіңіз менімен біргесіз...
Dialogue: 0,0:34:39.78,0:34:42.33,Default,,0,0,0,,Барлық костюмдер жоғалып кетті ме?
Dialogue: 0,0:34:43.58,0:34:44.95,Default,,0,0,0,,Анау үлкен жігіт
Dialogue: 0,0:34:45.62,0:34:48.25,Default,,0,0,0,,Мына жігіттің аузын жап.
Dialogue: 0,0:34:48.75,0:34:49.92,Default,,0,0,0,,Зако ше?
Dialogue: 0,0:34:54.25,0:34:56.59,Default,,0,0,0,,Сіз бұл дауысты естідіңіз бе?
Dialogue: 0,0:34:56.88,0:34:58.97,Default,,0,0,0,,Маған жаңа костюм керек.
Dialogue: 0,0:35:03.39,0:35:04.10,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:35:12.69,0:35:14.77,Default,,0,0,0,,Мен бұл жігіттерді жалғыз қалдырдым.
Dialogue: 0,0:35:15.27,0:35:17.28,Default,,0,0,0,,Бұл не туралы? Тездетіңіз
Dialogue: 0,0:35:20.24,0:35:22.07,Default,,0,0,0,,Екі бала басымдыққа ие.
Dialogue: 0,0:35:23.95,0:35:25.24,Default,,0,0,0,,Винс жігіттері
Dialogue: 0,0:35:31.21,0:35:32.75,Default,,0,0,0,,Жарайды, енді бірнеше күн бұрын өткізген қысқа тарих тестін қайтарып беремін.
Dialogue: 0,0:35:33.25,0:35:34.13,Default,,0,0,0,,Винс!
Dialogue: 0,0:35:35.13,0:35:36.96,Default,,0,0,0,,Артқы есіктен қашып кетті
Dialogue: 0,0:35:37.13,0:35:38.97,Default,,0,0,0,,Мен сені көлікпен қуамын.
Dialogue: 0,0:35:42.64,0:35:47.18,Default,,0,0,0,,«Әлем – сахна, әркім өз рөлін атқарады».
Dialogue: 0,0:35:55.11,0:35:56.94,Default,,0,0,0,,«Түн ортасы сиқыршы шыққанда»
Dialogue: 0,0:35:57.44,0:36:02.53,Default,,0,0,0,,«Зират пен тозақ оянып, әлемге уды шашады».
Dialogue: 0,0:36:13.42,0:36:17.13,Default,,0,0,0,,«Мен таза қан ішемін және аяусыз жұмыс істеймін».
Dialogue: 0,0:36:23.01,0:36:25.51,Default,,0,0,0,,«Мен өмір сүруім керек пе, әлде өлуім керек пе?»
Dialogue: 0,0:36:26.26,0:36:28.56,Default,,0,0,0,,Мен де Шекспирден үзінді келтіремін
Dialogue: 0,0:36:39.32,0:36:40.23,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:37:01.71,0:37:05.59,Default,,0,0,0,,Палм-Хилл сіздің орныңыз емес.
Dialogue: 0,0:37:07.01,0:37:07.93,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:37:17.15,0:37:18.69,Default,,0,0,0,,Бірдеңе аударылды ма?
Dialogue: 0,0:37:18.98,0:37:20.11,Default,,0,0,0,,Бұл шайтан.
Dialogue: 0,0:37:20.27,0:37:22.53,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:37:22.99,0:37:23.99,Default,,0,0,0,,Егер Хигучи екінші Кира сияқты тек қарап-ақ адам өлтіре алса, онда Кираның шын кім екені бағдарлама соңында ашылады!
Dialogue: 0,0:37:31.74,0:37:32.70,Default,,0,0,0,,Не болып жатыр өзі?
Dialogue: 0,0:37:35.54,0:37:36.71,Default,,0,0,0,,Сол көлеңке...
Dialogue: 0,0:37:41.09,0:37:42.92,Default,,0,0,0,,Рено, тез қашайық.
Dialogue: 0,0:37:44.76,0:37:49.14,Default,,0,0,0,,«Кіруге болмайды»
Dialogue: 0,0:37:52.01,0:37:53.77,Default,,0,0,0,,Бұл бұрын не болды?
Dialogue: 0,0:38:00.11,0:38:01.15,Default,,0,0,0,,Эй, күте тұрыңыз
Dialogue: 0,0:38:02.11,0:38:03.48,Default,,0,0,0,,Кілт кептеліп қалды
Dialogue: 0,0:38:09.57,0:38:12.12,Default,,0,0,0,,Балмұздақ сатушының музыкасын өшіріңіз
Dialogue: 0,0:38:15.33,0:38:16.33,Default,,0,0,0,,Тез шығарыңыз
Dialogue: 0,0:38:16.79,0:38:18.12,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:38:18.29,0:38:20.67,Default,,0,0,0,,Мен мұндай көлік түріне үйренбегенмін.
Dialogue: 0,0:38:26.42,0:38:27.17,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:38:27.72,0:38:29.84,Default,,0,0,0,,Қозғалыңыз.
Dialogue: 0,0:38:37.64,0:38:38.85,Default,,0,0,0,,Біз көмектескіміз келеді, білесің бе.
Dialogue: 0,0:38:39.77,0:38:41.02,Default,,0,0,0,,Табылды
Dialogue: 0,0:38:49.95,0:38:50.87,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:39:00.33,0:39:02.38,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:39:03.67,0:39:06.88,Default,,0,0,0,,Бұл құбыжықтар кімдер?
Dialogue: 0,0:39:07.80,0:39:10.72,Default,,0,0,0,,Мен мұндай фильмді бірінші рет көріп тұрмын.
Dialogue: 0,0:39:11.76,0:39:15.68,Default,,0,0,0,,Неліктен Винс басы жанып тұрған кезде әлі тірі?
Dialogue: 0,0:39:16.27,0:39:17.48,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:39:29.28,0:39:30.40,Default,,0,0,0,,Мен оны алып тастадым.
Dialogue: 0,0:39:30.86,0:39:32.20,Default,,0,0,0,,Жүргізу
Dialogue: 0,0:39:37.33,0:39:39.21,Default,,0,0,0,,Винс, қарсы тұр.
Dialogue: 0,0:39:40.71,0:39:42.71,Default,,0,0,0,,Бір нәрсе болуы керек
Dialogue: 0,0:39:44.46,0:39:45.34,Default,,0,0,0,,Сен брат
Dialogue: 0,0:39:53.55,0:39:54.76,Default,,0,0,0,,Оны жылдам сүртіңіз
Dialogue: 0,0:40:11.03,0:40:11.74,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:40:19.75,0:40:20.70,Default,,0,0,0,,Пайдасыз
Dialogue: 0,0:40:39.68,0:40:40.39,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:40:40.72,0:40:42.39,Default,,0,0,0,,(Абдул) Жоғары жрица келесі бөлмеден шабуыл жасап жатыр!
Dialogue: 0,0:40:43.31,0:40:44.44,Default,,0,0,0,,Әлі де бар
Dialogue: 0,0:40:58.45,0:41:00.62,Default,,0,0,0,,Онда оқ бар ма?
Dialogue: 0,0:41:04.08,0:41:06.13,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:41:07.08,0:41:10.21,Default,,0,0,0,,Оларға жылдам оқ атыңыз.
Dialogue: 0,0:41:28.19,0:41:28.86,Default,,0,0,0,,Өте үлкен
Dialogue: 0,0:41:43.12,0:41:45.37,Default,,0,0,0,,Мен сіздің артыңыздан полиция көлігіне дейін бардым.
Dialogue: 0,0:41:50.13,0:41:51.59,Default,,0,0,0,,Рено, бұл қызыл шам.
Dialogue: 0,0:41:52.84,0:41:54.22,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:42:21.03,0:42:22.99,Default,,0,0,0,,Э? Қайда?
Dialogue: 0,0:42:31.21,0:42:33.00,Default,,0,0,0,,Сіз қашып үлгердіңіз.
Dialogue: 0,0:42:36.01,0:42:36.88,Default,,0,0,0,,Рено…
Dialogue: 0,0:42:38.97,0:42:39.93,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:42:40.34,0:42:42.26,Default,,0,0,0,,Олар табанды.
Dialogue: 0,0:42:58.53,0:43:01.53,Default,,0,0,0,,Винс, қауіпсіздік белбеуіңді тақ.
Dialogue: 0,0:43:01.91,0:43:03.08,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:43:11.25,0:43:13.09,Default,,0,0,0,,Менің ішке кіруден басқа амалым жоқ.
Dialogue: 0,0:43:13.25,0:43:14.59,Default,,0,0,0,,Айтпақшы, Венецияға жеткеннен кейін нұсқауларың аяқталады.»
Dialogue: 0,0:43:47.87,0:43:49.62,Default,,0,0,0,,Ия, мен тірімін.
Dialogue: 0,0:44:24.53,0:44:27.08,Default,,0,0,0,,Ол әлі де жақын жерде болуы керек.
Dialogue: 0,0:44:27.49,0:44:29.91,Default,,0,0,0,,Оны міндетті түрде іздеңіз
Dialogue: 0,0:44:30.08,0:44:32.33,Default,,0,0,0,,Барлық тергеушілерді орналастырыңыз.
Dialogue: 0,0:44:33.67,0:44:35.00,Default,,0,0,0,,Ол ерекше бала.
Dialogue: 0,0:44:39.17,0:44:42.17,Default,,0,0,0,,Мачолар мен адамдарды ажыратса
Dialogue: 0,0:44:43.09,0:44:45.34,Default,,0,0,0,,Бұл жаман болады.
Dialogue: 0,0:44:47.85,0:44:50.52,Default,,0,0,0,,Мен сені міндетті түрде табамын
Dialogue: 0,0:44:51.18,0:44:53.31,Default,,0,0,0,,Мен оны аяқтаймын
Dialogue: 0,0:44:55.56,0:44:59.90,Default,,0,0,0,,Бүгін Палм-Хиллде атыс болды.
Dialogue: 0,0:45:00.07,0:45:02.11,Default,,0,0,0,,Мәліметтер белгісіз
Dialogue: 0,0:45:02.28,0:45:03.95,Default,,0,0,0,,Z7 ауданында
Dialogue: 0,0:45:04.03,0:45:04.36,Default,,0,0,0,,〝Мотель қызыл ағашы〞
Dialogue: 0,0:45:04.36,0:45:07.87,Default,,0,0,0,,``Red Tree Motel'' бандалық топтар Жүзім және Лайм одақ құрады...
Dialogue: 0,0:45:07.87,0:45:09.37,Default,,0,0,0,,Жүзім және Лайм банды топтары одақ құрады...
Dialogue: 0,0:45:13.08,0:45:16.38,Default,,0,0,0,,Палм-Хиллде кескілескен шайқас жалғасуда.
Dialogue: 0,0:45:16.54,0:45:19.04,Default,,0,0,0,,Жағдайды болжау мүмкін емес.
Dialogue: 0,0:45:20.21,0:45:22.80,Default,,0,0,0,,Сара Басқа ақпарат бар ма?
Dialogue: 0,0:45:22.97,0:45:25.05,Default,,0,0,0,,Кемінде 10 өлім
Dialogue: 0,0:45:25.22,0:45:28.39,Default,,0,0,0,,50-ден астам адам жараланған деп болжануда.
Dialogue: 0,0:45:28.55,0:45:30.89,Default,,0,0,0,,Далалықтан хабарланды
Dialogue: 0,0:45:31.06,0:45:34.73,Default,,0,0,0,,DMC-де жалғасып жатқан кескілескен шайқасқа қатысты
Dialogue: 0,0:45:34.89,0:45:39.73,Default,,0,0,0,,Біз қосымша жаңартуларды беруді жалғастырамыз.
Dialogue: 0,0:45:40.57,0:45:43.86,Default,,0,0,0,,Жан түршігерлік соңғы жаңалықтар.
Dialogue: 0,0:45:44.15,0:45:48.74,Default,,0,0,0,,Мұнда айтылған көптеген көріністерге сәйкес.
Dialogue: 0,0:45:48.91,0:45:53.33,Default,,0,0,0,,Тарақандардың көп саны шөлге көшіп барады.
Dialogue: 0,0:45:53.50,0:45:54.12,Default,,0,0,0,,Бұл хабар емес пе?
Dialogue: 0,0:45:54.12,0:45:55.41,Default,,0,0,0,,Бұл белгі емес пе? ``Қаланың тереңінен көріну.''
Dialogue: 0,0:45:55.41,0:45:56.08,Default,,0,0,0,,«Қаланың қойнауынан шыққан»
Dialogue: 0,0:45:56.08,0:45:58.04,Default,,0,0,0,,``Қаланың тереңінен пайда болды'' Себебі белгісіз
Dialogue: 0,0:45:58.04,0:45:58.58,Default,,0,0,0,,Себеп белгісіз
Dialogue: 0,0:45:58.75,0:46:00.92,Default,,0,0,0,,Тарақандар тастап кеткен
Dialogue: 0,0:46:01.09,0:46:03.92,Default,,0,0,0,,Бұл қаладан үміт бар ма?
Dialogue: 0,0:46:15.02,0:46:17.90,Default,,0,0,0,,Мен өткен жолы көп төледім.
Dialogue: 0,0:46:18.44,0:46:20.56,Default,,0,0,0,,Бұл өте қауіпті.
Dialogue: 0,0:46:20.86,0:46:23.11,Default,,0,0,0,,Сіз көптен бері тамақ ішкен жоқсыз.
Dialogue: 0,0:46:27.53,0:46:29.45,Default,,0,0,0,,Мен аштан өлетін сияқтымын
Dialogue: 0,0:46:31.07,0:46:32.45,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:46:33.54,0:46:35.16,Default,,0,0,0,,Pipo жоқ.
Dialogue: 0,0:46:49.01,0:46:50.47,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:46:50.80,0:46:51.93,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:47:00.48,0:47:02.81,Default,,0,0,0,,Сондықтан мені қуып жатыр.
Dialogue: 0,0:47:03.82,0:47:05.07,Default,,0,0,0,,Бұл менің есімде жоқ.
Dialogue: 0,0:47:05.23,0:47:06.32,Default,,0,0,0,,Екі адамға сену
Dialogue: 0,0:47:06.69,0:47:08.74,Default,,0,0,0,,Қылмыскерлерге көрінбейді
Dialogue: 0,0:47:09.07,0:47:12.49,Default,,0,0,0,,Жаман жағынан емес, жақсы қыз сияқты.
Dialogue: 0,0:47:16.04,0:47:18.75,Default,,0,0,0,,Одан құтылу мүмкін емес.
Dialogue: 0,0:47:18.91,0:47:21.29,Default,,0,0,0,,Сіздің кінәсіз екеніңізді дәлелдей алатыныңызға сенімдімін.
Dialogue: 0,0:47:21.92,0:47:24.71,Default,,0,0,0,,Сізді жазықсыз қылмыс жасады деп айыптайды.
Dialogue: 0,0:47:29.51,0:47:30.84,Default,,0,0,0,,Сіз тамақ жеген жоқсыз.
Dialogue: 0,0:47:31.34,0:47:32.34,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:47:33.26,0:47:35.76,Default,,0,0,0,,Бұл біртүрлі, Пипо көрінбейді.
Dialogue: 0,0:47:39.89,0:47:41.77,Default,,0,0,0,,Жібер! Бұл заңсыз
Dialogue: 0,0:47:42.90,0:47:44.73,Default,,0,0,0,,Операция сәтті өтті.
Dialogue: 0,0:47:52.03,0:47:55.20,Default,,0,0,0,,Луна, сен бұл жолы жақсы өнер көрсеттің.
Dialogue: 0,0:47:56.37,0:47:59.54,Default,,0,0,0,,Оның қақпан екенін білмей ақымақсың.
Dialogue: 0,0:48:25.98,0:48:29.74,Default,,0,0,0,,Алғаш көргенде мен де шошып кеттім.
Dialogue: 0,0:48:30.44,0:48:34.57,Default,,0,0,0,,Бірақ бұл балалар табиғи құбыжықтар емес.
Dialogue: 0,0:48:34.91,0:48:35.91,Default,,0,0,0,,Адам
Dialogue: 0,0:48:55.22,0:48:55.97,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:48:59.26,0:48:59.97,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:49:25.29,0:49:28.88,Default,,0,0,0,,Ақырында біз кездестік, Анджелино.
Dialogue: 0,0:49:33.47,0:49:34.63,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:49:36.47,0:49:37.84,Default,,0,0,0,,Неліктен мақсат қою керек?
Dialogue: 0,0:49:38.01,0:49:39.43,Default,,0,0,0,,Винс қайда?
Dialogue: 0,0:49:42.02,0:49:44.81,Default,,0,0,0,,Сіз шынымен кімсіз?
Dialogue: 0,0:49:44.98,0:49:47.02,Default,,0,0,0,,Сіз өзіңізді білмейсіз бе?
Dialogue: 0,0:49:47.94,0:49:49.44,Default,,0,0,0,,Сізге —
Dialogue: 0,0:49:49.61,0:49:51.53,Default,,0,0,0,,Мен сені алып келдім.
Dialogue: 0,0:49:51.69,0:49:55.36,Default,,0,0,0,,Өзіңіздің басқалардан ерекшеленетініңізді сезіндіңіз бе?
Dialogue: 0,0:49:57.66,0:50:01.87,Default,,0,0,0,,Маған К мырза деп қоңырау шалыңыз.
Dialogue: 0,0:50:03.66,0:50:04.87,Default,,0,0,0,,Біз—
Dialogue: 0,0:50:05.16,0:50:09.21,Default,,0,0,0,,Мачос ғаламның қараңғы материясынан дүниеге келген.
Dialogue: 0,0:50:09.79,0:50:13.71,Default,,0,0,0,,Сіз бүкіл денеңізде қатты ашуды сезінесіз.
Dialogue: 0,0:50:13.88,0:50:16.88,Default,,0,0,0,,Жоюға деген бақылаусыз қалау
Dialogue: 0,0:50:18.01,0:50:19.76,Default,,0,0,0,,Мен сенің не ойлайтыныңды білемін.
Dialogue: 0,0:50:19.93,0:50:22.31,Default,,0,0,0,,Менің әкем де солай болды.
Dialogue: 0,0:50:22.47,0:50:24.73,Default,,0,0,0,,Біздің серігіміз
Dialogue: 0,0:50:25.02,0:50:27.35,Default,,0,0,0,,Ол ең перспективалы адам болды.
Dialogue: 0,0:50:27.52,0:50:30.98,Default,,0,0,0,,Бірақ сіз біздің маңызды ережелерімізді бұздыңыз.
Dialogue: 0,0:50:31.15,0:50:34.07,Default,,0,0,0,,Адамдармен қарым-қатынас
Dialogue: 0,0:50:34.65,0:50:37.70,Default,,0,0,0,,Махоның қаны сіздің тамырларыңыз арқылы өтеді.
Dialogue: 0,0:50:39.99,0:50:43.41,Default,,0,0,0,,Әкең сені адамдарға аманат етті, бірақ
Dialogue: 0,0:50:43.62,0:50:46.91,Default,,0,0,0,,Менің олардан бөлек екенімді білесің.
Dialogue: 0,0:50:47.37,0:50:51.42,Default,,0,0,0,,Басқарушы билікке жатсаңыз да, бұл азапты өмір.
Dialogue: 0,0:50:51.59,0:50:54.21,Default,,0,0,0,,Қала мен оның айналасындағы адамдар аянышты.
Dialogue: 0,0:50:54.38,0:50:57.42,Default,,0,0,0,,Сізді жек көреді, өйткені сіз басқашасыз.
Dialogue: 0,0:50:57.59,0:50:59.93,Default,,0,0,0,,Достарыңызбен?
Dialogue: 0,0:51:00.05,0:51:03.72,Default,,0,0,0,,Сіздің әлеуетіңіз жабық.
Dialogue: 0,0:51:03.89,0:51:06.93,Default,,0,0,0,,Оянатын уақыт келді, Анджелино.
Dialogue: 0,0:51:07.39,0:51:09.81,Default,,0,0,0,,Сіздің орныңыз осында.
Dialogue: 0,0:51:10.48,0:51:13.32,Default,,0,0,0,,Бізге оралыңыз және достарыңызды өлтіріңіз.
Dialogue: 0,0:51:13.48,0:51:17.86,Default,,0,0,0,,Мен әрқашан ешкім, мағынасыз болмыс болдым.
Dialogue: 0,0:51:18.03,0:51:21.24,Default,,0,0,0,,Бұрын кім болғаныңызбен қоштасыңыз.
Dialogue: 0,0:51:23.78,0:51:28.62,Default,,0,0,0,,Сол досты өлтіріп, бастапқы тапсырмаңызды орындаңыз.
Dialogue: 0,0:51:30.54,0:51:32.38,Default,,0,0,0,,Адамдығыңнан бас тарт
Dialogue: 0,0:51:32.67,0:51:36.09,Default,,0,0,0,,Өзіңіздің шынайы болмысыңызды қабылдаңыз
Dialogue: 0,0:51:36.34,0:51:40.18,Default,,0,0,0,,Уайымдама, мен саған нағыз отбасын беремін.
Dialogue: 0,0:51:40.34,0:51:42.43,Default,,0,0,0,,Винсті өлтіру керек пе?
Dialogue: 0,0:51:45.64,0:51:48.43,Default,,0,0,0,,Лунаны оған апарыңыз.
Dialogue: 0,0:51:48.60,0:51:49.98,Default,,0,0,0,,Винсті өлтіру керек пе?
Dialogue: 0,0:51:54.90,0:51:56.02,Default,,0,0,0,,Менің міндетім...
Dialogue: 0,0:52:10.75,0:52:11.92,Default,,0,0,0,,Ангелино
Dialogue: 0,0:52:14.04,0:52:16.63,Default,,0,0,0,,Сіз абдырап қалуыңыз керек.
Dialogue: 0,0:52:18.88,0:52:20.59,Default,,0,0,0,,Мен де солай болдым
Dialogue: 0,0:52:21.72,0:52:24.34,Default,,0,0,0,,Бірақ шынайы болмысыңызды қабылдаңыз
Dialogue: 0,0:52:24.51,0:52:25.68,Default,,0,0,0,,Бағынбау
Dialogue: 0,0:52:26.56,0:52:29.64,Default,,0,0,0,,Мұқият ойланыңыз
Dialogue: 0,0:52:38.40,0:52:41.11,Default,,0,0,0,,Оған бірге жетейік
Dialogue: 0,0:52:42.57,0:52:44.11,Default,,0,0,0,,Винсті өлтіру...
Dialogue: 0,0:52:47.08,0:52:50.62,Default,,0,0,0,,Қарсылық көрсетудің қажеті жоқ, Анджелино.
Dialogue: 0,0:52:52.08,0:52:55.29,Default,,0,0,0,,DMC тек бірінші қадам болып табылады
Dialogue: 0,0:52:55.75,0:53:00.13,Default,,0,0,0,,Қазірдің өзінде қала экономикасы мен қаржысына қол сұға бастады
Dialogue: 0,0:53:00.26,0:53:03.59,Default,,0,0,0,,Жақында бүкіл ел бізге бағынады.
Dialogue: 0,0:53:03.76,0:53:07.10,Default,,0,0,0,,Жаңадан қабылданған заңның арқасында
Dialogue: 0,0:53:07.30,0:53:11.68,Default,,0,0,0,,Біз бүкіл әлем бойынша ешбір шектеусіз саяхаттай аламыз.
Dialogue: 0,0:53:13.89,0:53:17.56,Default,,0,0,0,,Бұл жер біздің ойын алаңымыз.
Dialogue: 0,0:53:17.81,0:53:20.65,Default,,0,0,0,,Біз теріс энергияны жейміз
Dialogue: 0,0:53:20.82,0:53:25.57,Default,,0,0,0,,Бұл адам кеуектерінен нашар ағып жатқан магма.
Dialogue: 0,0:53:25.74,0:53:27.16,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:53:27.28,0:53:30.24,Default,,0,0,0,,Жердегі теріс энергия
Dialogue: 0,0:53:30.41,0:53:34.21,Default,,0,0,0,,Қанша жесең де, таусылмайды.
Dialogue: 0,0:53:43.21,0:53:46.34,Default,,0,0,0,,Анджелино, мен осында күтемін.
Dialogue: 0,0:53:47.97,0:53:48.72,Default,,0,0,0,,Рено?
Dialogue: 0,0:53:49.85,0:53:52.97,Default,,0,0,0,,Мен өзімнен басқа біреу болғым келеді
Dialogue: 0,0:53:53.48,0:53:54.23,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:53:57.94,0:53:59.86,Default,,0,0,0,,Анам осында
Dialogue: 0,0:54:01.07,0:54:02.86,Default,,0,0,0,,Мен әрқашан сенің жаныңда боламын
Dialogue: 0,0:54:12.58,0:54:14.37,Default,,0,0,0,,Винсті өлтіру...
Dialogue: 0,0:54:16.58,0:54:18.58,Default,,0,0,0,,Мен қазір шок күйдемін.
Dialogue: 0,0:54:18.75,0:54:22.75,Default,,0,0,0,,Мені досымның қаңқасына апарыңыз.
Dialogue: 0,0:54:23.59,0:54:25.42,Default,,0,0,0,,Ол таңдауға рұқсат етіңіз
Dialogue: 0,0:54:25.59,0:54:30.76,Default,,0,0,0,,Қайғылы ғұмырыңда алғаш рет тағдырыңды өзің шешесің.
Dialogue: 0,0:54:32.35,0:54:35.60,Default,,0,0,0,,Досы таңға дейін өмір сүрсе
Dialogue: 0,0:54:36.10,0:54:39.10,Default,,0,0,0,,Екеуін де өлтіріңіз.
Dialogue: 0,0:54:39.44,0:54:41.11,Default,,0,0,0,,Сөздеріңізге келсек,
Dialogue: 0,0:54:41.27,0:54:44.15,Default,,0,0,0,,Неліктен оған мүмкіндік беру керек?
Dialogue: 0,0:54:44.57,0:54:47.90,Default,,0,0,0,,Оны қазір жою керек емес пе?
Dialogue: 0,0:54:56.83,0:54:59.12,Default,,0,0,0,,Тыңдаңыз, Макаби мырза.
Dialogue: 0,0:54:59.46,0:55:02.29,Default,,0,0,0,,Біздің адамдардан айырмашылығымыз осында.
Dialogue: 0,0:55:02.54,0:55:06.01,Default,,0,0,0,,Адамдар бір-біріңді өлтіресіңдер.
Dialogue: 0,0:55:06.17,0:55:10.51,Default,,0,0,0,,Біз ағаларымызды құрметтейміз.
Dialogue: 0,0:55:10.68,0:55:13.30,Default,,0,0,0,,Өйткені біздің идеалдарымыз ортақ
Dialogue: 0,0:55:13.47,0:55:16.73,Default,,0,0,0,,Бірақ сіз түсінбейсіз.
Dialogue: 0,0:55:16.89,0:55:17.81,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:55:17.98,0:55:18.81,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:55:20.31,0:55:24.15,Default,,0,0,0,,Менімен қайта сөйлеспе.
Dialogue: 0,0:55:27.82,0:55:31.03,Default,,0,0,0,,Мен сізге сыртқы әлемде өмір сүре алмайтынымды айттым.
Dialogue: 0,0:55:33.78,0:55:36.54,Default,,0,0,0,,Өйткені бұл бір ғана гибрид
Dialogue: 0,0:55:38.37,0:55:39.16,Default,,0,0,0,,Анджелино...
Dialogue: 0,0:55:39.33,0:55:42.75,Default,,0,0,0,,Осындай мәнсіз өмірді қалайсыз ба?
Dialogue: 0,0:55:42.92,0:55:45.55,Default,,0,0,0,,Кейінірек орындаңыз. Әкем бос емес.
Dialogue: 0,0:55:45.71,0:55:47.17,Default,,0,0,0,,Кезекшілікке оралу
Dialogue: 0,0:55:47.34,0:55:51.13,Default,,0,0,0,,Менің сізге басқа өтінішім бар-жоғын қараңыз.
Dialogue: 0,0:56:06.48,0:56:08.99,Default,,0,0,0,,Тарақандарды қанша жерден қуасың?
Dialogue: 0,0:56:09.15,0:56:11.82,Default,,0,0,0,,Мағынасын мүлде түсінбеймін.
Dialogue: 0,0:56:32.05,0:56:35.43,Default,,0,0,0,,Рено Бұл өте қорқынышты болды.
Dialogue: 0,0:56:35.55,0:56:36.93,Default,,0,0,0,,Ол тірі болды.
Dialogue: 0,0:56:37.18,0:56:39.39,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,0:56:41.89,0:56:43.94,Default,,0,0,0,,Сіз Реносыз, солай ма?
Dialogue: 0,0:56:44.06,0:56:46.06,Default,,0,0,0,,Біз қашуымыз керек
Dialogue: 0,0:56:46.31,0:56:50.61,Default,,0,0,0,,Қалай? Барлық жерде күзетшілер бар.
Dialogue: 0,0:56:50.74,0:56:55.12,Default,,0,0,0,,Сондай-ақ бақылау камерасы бар, сондықтан қашып кетуге мүмкіндік жоқ.
Dialogue: 0,0:56:57.33,0:57:00.08,Default,,0,0,0,,Бізді мәңгілікке қамап қойыңыз
Dialogue: 0,0:57:00.25,0:57:02.08,Default,,0,0,0,,Мен оны сынақ стенді ретінде пайдаланғым келеді.
Dialogue: 0,0:57:02.25,0:57:05.13,Default,,0,0,0,,Электродтарды бүкіл денеге бекітуге болады
Dialogue: 0,0:57:05.42,0:57:08.13,Default,,0,0,0,,Біз қашып құтылдық
Dialogue: 0,0:57:08.25,0:57:11.13,Default,,0,0,0,,Пипо дүкеніндегі әйелге неге сендіңіз?
Dialogue: 0,0:57:11.76,0:57:14.09,Default,,0,0,0,,Мен сені дүкенге кіргізбей қойсам да.
Dialogue: 0,0:57:14.43,0:57:16.51,Default,,0,0,0,,Түсті жаңа ғана байқадым
Dialogue: 0,0:57:17.01,0:57:18.14,Default,,0,0,0,,Мен ренжідім
Dialogue: 0,0:57:27.73,0:57:30.48,Default,,0,0,0,,Себебі сіз әйелдерді қызықтырасыз.
Dialogue: 0,0:57:30.65,0:57:32.44,Default,,0,0,0,,Винстің аузын жап
Dialogue: 0,0:57:32.74,0:57:34.45,Default,,0,0,0,,Мен өзімді біртүрлі сезінемін.
Dialogue: 0,0:57:34.65,0:57:36.82,Default,,0,0,0,,Менен кет, тез...
Dialogue: 0,0:57:38.37,0:57:39.08,Default,,0,0,0,,Рено?
Dialogue: 0,0:57:39.62,0:57:42.62,Default,,0,0,0,,Мен оны басқара алмаймын, кет.
Dialogue: 0,0:57:43.12,0:57:44.00,Default,,0,0,0,,Жақынбаңыз
Dialogue: 0,0:57:44.16,0:57:45.04,Default,,0,0,0,,Мені қорқытпа
Dialogue: 0,0:57:45.21,0:57:46.29,Default,,0,0,0,,Мен мұндай нәрселерге әрдайым шебер болдым, көріп тұрсың ғой.
Dialogue: 0,0:57:47.29,0:57:49.00,Default,,0,0,0,,Кемеде механикалық ақау белгілері байқалмады, күрестің іздері де жоқ еді.
Dialogue: 0,0:57:54.80,0:57:56.55,Default,,0,0,0,,Рено Бұл ауырады.
Dialogue: 0,0:57:58.68,0:58:00.43,Default,,0,0,0,,Лино енді жоқ
Dialogue: 0,0:58:02.18,0:58:04.02,Default,,0,0,0,,Сіз мені дұрыс түсінбейсіз.
Dialogue: 0,0:58:04.18,0:58:06.19,Default,,0,0,0,,Басынан бері Рено болған жоқ.
Dialogue: 0,0:58:07.19,0:58:09.52,Default,,0,0,0,,Менің кім екенімді білмейсің.
Dialogue: 0,0:58:12.19,0:58:15.03,Default,,0,0,0,,Мен сіздің шынайы тұлғаны түсінбейтініңізге сене алмаймын.
Dialogue: 0,0:58:15.32,0:58:17.99,Default,,0,0,0,,Сен... менің досымсың.
Dialogue: 0,0:58:19.66,0:58:21.37,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:58:27.67,0:58:31.04,Default,,0,0,0,,К мырза айтқандай, мен құбыжықпын.
Dialogue: 0,0:58:33.00,0:58:35.72,Default,,0,0,0,,Олар саған не істеді?
Dialogue: 0,0:58:36.63,0:58:38.59,Default,,0,0,0,,Винс Мені кешіріңіз.
Dialogue: 0,0:58:41.64,0:58:45.52,Default,,0,0,0,,Менің ішімде мұндай нәрсе бар екеніне сене алар емеспін
Dialogue: 0,0:58:45.81,0:58:48.14,Default,,0,0,0,,Балалар, тыныш болыңдар.
Dialogue: 0,0:58:48.39,0:58:51.69,Default,,0,0,0,,Әйтпесе аузыңды жауып тастаймын.
Dialogue: 0,0:58:53.65,0:58:56.03,Default,,0,0,0,,Сендер тітіркендіргіштер.
Dialogue: 0,0:58:59.24,0:59:00.87,Default,,0,0,0,,Кешкі ас жоқ
Dialogue: 0,0:59:19.84,0:59:22.39,Default,,0,0,0,,Керемет
Dialogue: 0,0:59:24.51,0:59:27.89,Default,,0,0,0,,4C секторында интрузия анықталды
Dialogue: 0,0:59:28.06,0:59:29.89,Default,,0,0,0,,Интрузия? Мүмкін емес
Dialogue: 0,0:59:46.04,0:59:47.66,Default,,0,0,0,,Мен барып тексеремін.
Dialogue: 0,0:59:47.83,0:59:51.54,Default,,0,0,0,,Мен сенімді болу үшін зертхананы тексеремін.
Dialogue: 0,0:59:51.83,0:59:53.88,Default,,0,0,0,,Ұйықтап қалма
Dialogue: 0,0:59:55.84,0:59:57.92,Default,,0,0,0,,Олар жылы.
Dialogue: 0,1:00:08.27,1:00:10.56,Default,,0,0,0,,Қашқың келсе, дәл қазір
Dialogue: 0,1:00:15.06,1:00:16.61,Default,,0,0,0,,Бейшара балалар.
Dialogue: 0,1:00:52.48,1:00:54.48,Default,,0,0,0,,Төбеге қайта оралуға болады.
Dialogue: 0,1:00:55.61,1:00:57.61,Default,,0,0,0,,Тым жақындамаңыз
Dialogue: 0,1:00:57.77,1:00:58.82,Default,,0,0,0,,Винс…
Dialogue: 0,1:01:05.99,1:01:07.58,Default,,0,0,0,,Бұл аяқталуы мүмкін
Dialogue: 0,1:01:08.62,1:01:09.66,Default,,0,0,0,,Винс…
Dialogue: 0,1:01:18.96,1:01:20.21,Default,,0,0,0,,Сіз кімді атып жатырсыз?
Dialogue: 0,1:01:46.53,1:01:48.07,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,1:01:54.79,1:01:56.37,Default,,0,0,0,,Мен зұлым адамды ұстаймын.
Dialogue: 0,1:01:59.17,1:02:00.04,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,1:02:00.21,1:02:02.05,Default,,0,0,0,,Мұнда асығыңыз!
Dialogue: 0,1:02:04.42,1:02:06.38,Default,,0,0,0,,Рено, ұйықтама.
Dialogue: 0,1:02:27.49,1:02:28.61,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,1:02:28.91,1:02:30.41,Default,,0,0,0,,Бұл сіздің әкеңіз бе?
Dialogue: 0,1:02:30.91,1:02:33.54,Default,,0,0,0,,Мама сені тастап кеткен жоқ.
Dialogue: 0,1:02:33.79,1:02:38.54,Default,,0,0,0,,Ол бізді қорғау үшін өз өмірін құрбан етті.
Dialogue: 0,1:02:40.84,1:02:43.38,Default,,0,0,0,,Мама сені жақсы көретін
Dialogue: 0,1:02:49.59,1:02:53.22,Default,,0,0,0,,Мен сені бар күшіммен қорғауға тырыстым.
Dialogue: 0,1:02:53.68,1:02:55.48,Default,,0,0,0,,Бірақ олар күшті болды
Dialogue: 0,1:02:56.68,1:02:59.56,Default,,0,0,0,,Өз жолыңмен өмір сүр
Dialogue: 0,1:03:02.44,1:03:04.65,Default,,0,0,0,,Олар зұлым жандар
Dialogue: 0,1:03:05.03,1:03:08.74,Default,,0,0,0,,Мен бақылауға құштар адамдармен одақ құрдым.
Dialogue: 0,1:03:08.86,1:03:11.74,Default,,0,0,0,,Адамдарға сенбеді
Dialogue: 0,1:03:12.20,1:03:14.91,Default,,0,0,0,,Ендеше будандастыру
Dialogue: 0,1:03:15.04,1:03:19.75,Default,,0,0,0,,Гибридтердің жүрегі жоқ және қорқынышты да, ауырсынуды да сезбейді.
Dialogue: 0,1:03:19.87,1:03:22.75,Default,,0,0,0,,Олардың гендері мінсіз.
Dialogue: 0,1:03:22.88,1:03:26.76,Default,,0,0,0,,Бірақ Рено басқа, тыйым салынған махаббаттың туындысы.
Dialogue: 0,1:03:26.88,1:03:30.26,Default,,0,0,0,,Махаббаттың әсері күтпеген
Dialogue: 0,1:03:30.38,1:03:32.43,Default,,0,0,0,,Мачосты қалай жеңуге болады?
Dialogue: 0,1:03:32.55,1:03:35.43,Default,,0,0,0,,Тозақтың жаратылысы суықты жек көреді.
Dialogue: 0,1:03:35.56,1:03:39.94,Default,,0,0,0,,Осылайша, күлкілер бүкіл әлемдегі үкіметтерді басқарады.
Dialogue: 0,1:03:40.06,1:03:42.44,Default,,0,0,0,,Жаһандық жылынуға ықпал етті
Dialogue: 0,1:03:42.90,1:03:47.28,Default,,0,0,0,,Парниктік газдар, ормандарды кесу және пайдаланылған газдар
Dialogue: 0,1:03:47.40,1:03:50.78,Default,,0,0,0,,Олар уақыт өте Жерді өзгертті.
Dialogue: 0,1:03:50.91,1:03:53.78,Default,,0,0,0,,Біз идеалды орта құрдық.
Dialogue: 0,1:03:53.91,1:03:57.95,Default,,0,0,0,,Және ол жер бетінде үстемдікке айналды.
Dialogue: 0,1:03:58.25,1:04:01.62,Default,,0,0,0,,Мачо қыстың суығына байланысты.
Dialogue: 0,1:04:01.75,1:04:04.46,Default,,0,0,0,,Мен артықшылығымды жоғалтқым келмейді. ''Ойын аяқталды''
Dialogue: 0,1:04:04.46,1:04:05.67,Default,,0,0,0,,«Ойын аяқталды»
Dialogue: 0,1:04:31.82,1:04:32.66,Default,,0,0,0,,Рено!
Dialogue: 0,1:04:34.28,1:04:36.16,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,1:04:36.87,1:04:38.66,Default,,0,0,0,,Мен бірнеше күн ұйықтадым
Dialogue: 0,1:04:39.25,1:04:41.83,Default,,0,0,0,,Бірақ мен сені сүйе алмадым
Dialogue: 0,1:04:45.59,1:04:47.42,Default,,0,0,0,,Винс, біз қайдамыз?
Dialogue: 0,1:04:51.05,1:04:52.38,Default,,0,0,0,,Тыныс алыңыз
Dialogue: 0,1:04:52.55,1:04:55.43,Default,,0,0,0,,Осының өртеніп кетуіне жол бермеңіз.
Dialogue: 0,1:04:55.72,1:04:58.22,Default,,0,0,0,,Тек үзіліс жасаңыз
Dialogue: 0,1:04:58.39,1:05:01.56,Default,,0,0,0,,Сіз заттың ауырлығын түсінесіз.
Dialogue: 0,1:05:01.73,1:05:03.44,Default,,0,0,0,,Сіз оны уақытында орындамайсыз.
Dialogue: 0,1:05:03.60,1:05:06.73,Default,,0,0,0,,Олар жай ғана әлсіз және жалқау адамдар.
Dialogue: 0,1:05:07.06,1:05:09.90,Default,,0,0,0,,Егер бәрі ойдағыдай болса, бәрі бітеді.
Dialogue: 0,1:05:10.57,1:05:14.41,Default,,0,0,0,,Мен газ баллоны көтеріп, кезіп жүрмін.
Dialogue: 0,1:05:19.91,1:05:21.41,Default,,0,0,0,,Қаңқа жоқ па?
Dialogue: 0,1:05:22.58,1:05:24.92,Default,,0,0,0,,Екі бала жоғалып кетті.
Dialogue: 0,1:05:28.38,1:05:30.76,Default,,0,0,0,,Бұл орын емес.
Dialogue: 0,1:05:30.88,1:05:33.59,Default,,0,0,0,,Сіз әлемді құтқара аламыз деп ойлайсыз ба?
Dialogue: 0,1:06:27.10,1:06:29.81,Default,,0,0,0,,〝Мексика шекарасына дейін〞
Dialogue: 0,1:06:35.40,1:06:38.45,Default,,0,0,0,,Жоғалғысы келетіндер Мексикаға барады
Dialogue: 0,1:06:38.66,1:06:41.28,Default,,0,0,0,,Қашып кету біртүрлі сезінеді.
Dialogue: 0,1:06:41.45,1:06:45.12,Default,,0,0,0,,Онда барсаң да нөлден бастайсың.
Dialogue: 0,1:06:45.33,1:06:48.50,Default,,0,0,0,,Бұдан бұдан жаман болуы мүмкін емес.
Dialogue: 0,1:06:45.33,1:06:48.50,Default,,0,0,0,,〝Автобус аялдамасы〞
Dialogue: 0,1:06:48.67,1:06:52.00,Default,,0,0,0,,Мен Виллиді тастап кете аламын.
Dialogue: 0,1:06:52.38,1:06:55.55,Default,,0,0,0,,Біз оның жалғыз досы болсақ та...
Dialogue: 0,1:06:56.51,1:06:58.55,Default,,0,0,0,,Кішкене салқын ба?
Dialogue: 0,1:07:01.01,1:07:02.68,Default,,0,0,0,,1 доллар қалды
Dialogue: 0,1:07:02.85,1:07:05.02,Default,,0,0,0,,Егер сізді қызықтырса, маған қоңырау шалыңыз.
Dialogue: 0,1:07:14.11,1:07:15.48,Default,,0,0,0,,Бұл олар болуы керек.
Dialogue: 0,1:07:15.61,1:07:18.07,Default,,0,0,0,,Қажетсіз сөздерді айтпаңыз
Dialogue: 0,1:07:19.36,1:07:20.45,Default,,0,0,0,,Қоңырау шалу
Dialogue: 0,1:07:22.49,1:07:23.58,Default,,0,0,0,,Қайсысы?
Dialogue: 0,1:07:24.04,1:07:25.33,Default,,0,0,0,,Бұл біз.
Dialogue: 0,1:07:25.70,1:07:28.58,Default,,0,0,0,,Біз қазір ең нашар жағдайдамыз.
Dialogue: 0,1:07:29.46,1:07:32.04,Default,,0,0,0,,Сіз не айтқыңыз келеді?
Dialogue: 0,1:07:32.21,1:07:33.00,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,1:07:33.54,1:07:34.55,Default,,0,0,0,,Не болды?
Dialogue: 0,1:07:36.71,1:07:38.55,Default,,0,0,0,,Радиотолқындар ең нашар
Dialogue: 0,1:07:38.72,1:07:39.68,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:07:39.88,1:07:41.93,Default,,0,0,0,,Вилли, мен сені естіп тұрмын.
Dialogue: 0,1:07:42.26,1:07:44.18,Default,,0,0,0,,Біздің айтарымыз бар.
Dialogue: 0,1:07:44.39,1:07:46.18,Default,,0,0,0,,Бұл кездейсоқтық. Мен де.
Dialogue: 0,1:07:46.97,1:07:48.60,Default,,0,0,0,,«Қазір үйге қайт»
Dialogue: 0,1:07:49.39,1:07:51.77,Default,,0,0,0,,«Маңызды ақпарат Өмір мен өлімді растау»
Dialogue: 0,1:07:52.06,1:07:53.36,Default,,0,0,0,,хабарланды
Dialogue: 0,1:07:53.73,1:07:56.40,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,1:07:57.23,1:08:00.86,Default,,0,0,0,,Бұл төтенше жағдай. Өтінемін, дереу оралыңыз.
Dialogue: 0,1:08:00.99,1:08:03.07,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:08:03.24,1:08:03.99,Default,,0,0,0,,Керемет
Dialogue: 0,1:08:03.99,1:08:04.87,Default,,0,0,0,,Керемет
Dialogue: 0,1:08:03.99,1:08:04.87,Default,,0,0,0,,〝Маңызды ақпарат〞
Dialogue: 0,1:08:04.87,1:08:05.24,Default,,0,0,0,,〝Маңызды ақпарат〞
Dialogue: 0,1:08:05.41,1:08:06.08,Default,,0,0,0,,〝Қазір үйге қайт. Өмір мен өлімді растау〞
Dialogue: 0,1:08:06.08,1:08:07.12,Default,,0,0,0,,〝Қазір үйге қайт. Өмір мен өлімді растау〞
Dialogue: 0,1:08:06.08,1:08:07.12,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,1:08:07.79,1:08:10.08,Default,,0,0,0,,«Маңызды ақпарат» дегеніміз не?
Dialogue: 0,1:08:11.17,1:08:13.04,Default,,0,0,0,,Мен не айтуым керек?
Dialogue: 0,1:08:14.84,1:08:18.21,Default,,0,0,0,,Мен телефон арқылы түсіндіре алмаймын. Бірден кел.
Dialogue: 0,1:08:20.01,1:08:20.88,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:08:21.34,1:08:22.22,Default,,0,0,0,,Вилли
Dialogue: 0,1:08:22.34,1:08:24.43,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,1:08:24.80,1:08:27.89,Default,,0,0,0,,Мен кездесіп, сөйлескім келетін нәрсе бар.
Dialogue: 0,1:08:28.02,1:08:30.89,Default,,0,0,0,,Мен қатты күйзелдім.
Dialogue: 0,1:08:31.02,1:08:32.56,Default,,0,0,0,,Қайтадан қоңырау шалуға болады
Dialogue: 0,1:08:32.69,1:08:37.23,Default,,0,0,0,,Біртүрлі нәрсе болды. Мен барып көруім керек.
Dialogue: 0,1:08:37.36,1:08:37.69,Default,,0,0,0,,〝Арнайы балмұздақ〞
Dialogue: 0,1:08:37.69,1:08:40.07,Default,,0,0,0,,〝Арнайы балмұздақ〞
Dialogue: 0,1:08:37.69,1:08:40.07,Default,,0,0,0,,Сіз DMC-ге оралуға шындап қарайсыз ба?
Dialogue: 0,1:08:40.07,1:08:40.19,Default,,0,0,0,,〝Арнайы балмұздақ〞
Dialogue: 0,1:08:40.19,1:08:40.90,Default,,0,0,0,,〝Арнайы балмұздақ〞
Dialogue: 0,1:08:40.19,1:08:40.90,Default,,0,0,0,,Бұл өте қауіпті.
Dialogue: 0,1:08:40.90,1:08:41.57,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,1:08:41.70,1:08:43.03,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:08:43.20,1:08:45.99,Default,,0,0,0,,Вилли күшті, сондықтан бәрібір.
Dialogue: 0,1:08:49.70,1:08:53.00,Default,,0,0,0,,Бірақ Виллиге қауіп төнсе, мен оны жалғыз қалдыра алмаймын.
Dialogue: 0,1:08:53.17,1:08:54.96,Default,,0,0,0,,Вилли дегеніміз не?
Dialogue: 0,1:08:55.13,1:08:58.13,Default,,0,0,0,,Бұл бізді қаншалықты мазалайды?
Dialogue: 0,1:08:58.25,1:09:00.63,Default,,0,0,0,,Сен менің досымсың, бірақ мен емес.
Dialogue: 0,1:09:00.76,1:09:02.97,Default,,0,0,0,,Мен одан шаршадым.
Dialogue: 0,1:09:03.09,1:09:05.30,Default,,0,0,0,,Бұл жерден кетейік
Dialogue: 0,1:09:05.43,1:09:08.14,Default,,0,0,0,,Сіз DMC-ден алыс болуыңыз керек.
Dialogue: 0,1:09:08.26,1:09:09.97,Default,,0,0,0,,Вилли - оба құдайы
Dialogue: 0,1:09:12.77,1:09:14.64,Default,,0,0,0,,Сізге соншалықты мән бересіз бе?
Dialogue: 0,1:09:20.28,1:09:23.32,Default,,0,0,0,,Егер сіз шынымен қиыншылыққа тап болсаңыз, сізге көмектесу керек.
Dialogue: 0,1:09:34.46,1:09:39.00,Default,,0,0,0,,DMC-де кескілескен шайқас жалғасуда.
Dialogue: 0,1:09:39.13,1:09:42.17,Default,,0,0,0,,Терроризм деп қорытынды жасауға болады.
Dialogue: 0,1:09:46.30,1:09:48.01,Default,,0,0,0,,Кеңес беру
Dialogue: 0,1:09:48.18,1:09:51.22,Default,,0,0,0,,Сіз мұны телефон арқылы жасадыңыз.
Dialogue: 0,1:09:51.97,1:09:53.85,Default,,0,0,0,,Егер олар келмесе
Dialogue: 0,1:09:54.44,1:09:56.44,Default,,0,0,0,,Сіз азап шегесіз
Dialogue: 0,1:09:59.02,1:10:02.15,Default,,0,0,0,,Мен есегімнен отшашуды атамын.
Dialogue: 0,1:10:02.32,1:10:03.32,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,1:10:04.07,1:10:08.28,Default,,0,0,0,,Мен бала кезімнен жануарларды қорлауды жақсы көремін.
Dialogue: 0,1:10:08.53,1:10:11.74,Default,,0,0,0,,Сондықтан олар келуге міндетті емес.
Dialogue: 0,1:10:20.17,1:10:21.38,Default,,0,0,0,,Мүлдем
Dialogue: 0,1:10:21.75,1:10:24.72,Default,,0,0,0,,Тіркеме тым ыстық.
Dialogue: 0,1:10:25.13,1:10:26.59,Default,,0,0,0,,Хе-хе, рақмет
Dialogue: 0,1:10:27.13,1:10:29.39,Default,,0,0,0,,Сізде желдеткіш жоқ па?
Dialogue: 0,1:10:29.72,1:10:31.60,Default,,0,0,0,,Бұл жақсы төзімді.
Dialogue: 0,1:10:32.89,1:10:34.06,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,1:10:34.39,1:10:38.94,Default,,0,0,0,,Шынымды айтсам, олар қайтып келді. Олар ақымақ.
Dialogue: 0,1:10:39.90,1:10:41.52,Default,,0,0,0,,Бұл арман емес.
Dialogue: 0,1:10:41.94,1:10:43.11,Default,,0,0,0,,Жақсы жаңалық
Dialogue: 0,1:10:43.40,1:10:45.44,Default,,0,0,0,,Менің досым қайтып келді
Dialogue: 0,1:10:46.45,1:10:50.37,Default,,0,0,0,,Жарайды, жарайды, қозғалма.
Dialogue: 0,1:10:51.24,1:10:53.24,Default,,0,0,0,,Сен жолға түстің, жолдан кет.
Dialogue: 0,1:10:55.58,1:10:57.54,Default,,0,0,0,,Тоқта, қашасың.
Dialogue: 0,1:10:57.67,1:10:59.71,Default,,0,0,0,,Бұл менің олжам.
Dialogue: 0,1:11:01.75,1:11:04.26,Default,,0,0,0,,Анама оралыңыз
Dialogue: 0,1:11:04.46,1:11:07.76,Default,,0,0,0,,Ол барлық зұлымдықтың тамыры. Мен кек аламын.
Dialogue: 0,1:11:08.30,1:11:09.64,Default,,0,0,0,,Қарғыс атқан бала.
Dialogue: 0,1:11:14.93,1:11:18.10,Default,,0,0,0,,Мінсіз, бір орында тұрыңыз.
Dialogue: 0,1:11:23.94,1:11:25.61,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:11:25.78,1:11:27.40,Default,,0,0,0,,Бұл мерген.
Dialogue: 0,1:11:27.61,1:11:28.57,Default,,0,0,0,,Іздеу!
Dialogue: 0,1:11:38.16,1:11:39.62,Default,,0,0,0,,Виллидің үйінен.
Dialogue: 0,1:11:59.94,1:12:00.77,Default,,0,0,0,,Вилли
Dialogue: 0,1:12:29.17,1:12:33.01,Default,,0,0,0,,Сізге жіберетініміз – эксклюзивті бейне.
Dialogue: 0,1:12:33.18,1:12:36.18,Default,,0,0,0,,Тәртіпсіздік болмаған жерлерде
Dialogue: 0,1:12:36.35,1:12:38.85,Default,,0,0,0,,Атыс болып жатыр.
Dialogue: 0,1:12:39.02,1:12:43.69,Default,,0,0,0,,Мен ер адамды тіркеменің төбесіне шығып жатқанын көріп тұрмын.
Dialogue: 0,1:12:43.85,1:12:47.69,Default,,0,0,0,,Қарулы террорист анықталды
Dialogue: 0,1:12:47.90,1:12:50.94,Default,,0,0,0,,Соғысқа барғыларың келіп тұр, бейбақтар!
Dialogue: 0,1:12:51.11,1:12:52.82,Default,,0,0,0,,Бұл сәлемдесудің орнына.
Dialogue: 0,1:12:54.03,1:12:55.20,Default,,0,0,0,,Маған көмек керек
Dialogue: 0,1:12:55.37,1:12:57.20,Default,,0,0,0,,Бұл өз-өзіне қол жұмсау
Dialogue: 0,1:12:58.20,1:13:01.62,Default,,0,0,0,,Осыны елемейтін болсаңыз, өмір бойы өкінесіз.
Dialogue: 0,1:13:01.79,1:13:02.83,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,1:13:04.38,1:13:07.71,Default,,0,0,0,,Мен жеңілгенмін, бірақ қорқақ емеспін
Dialogue: 0,1:13:07.88,1:13:09.21,Default,,0,0,0,,Рено кетпе
Dialogue: 0,1:13:09.38,1:13:10.71,Default,,0,0,0,,Бұл абайсызда.
Dialogue: 0,1:13:16.85,1:13:18.22,Default,,0,0,0,,Артқа тартыңыз.
Dialogue: 0,1:13:20.60,1:13:21.68,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,1:13:22.89,1:13:24.73,Default,,0,0,0,,Дұрыс, жүгір.
Dialogue: 0,1:13:30.07,1:13:31.15,Default,,0,0,0,,тоқтатылды
Dialogue: 0,1:13:40.20,1:13:42.25,Default,,0,0,0,,Сенің кесіріңнен тозақ.
Dialogue: 0,1:13:55.55,1:13:58.97,Default,,0,0,0,,Мен таңғажайып көріністің куәсі болып отырмын.
Dialogue: 0,1:13:59.14,1:14:01.27,Default,,0,0,0,,Белгісіз зымыран...
Dialogue: 0,1:14:06.56,1:14:09.11,Default,,0,0,0,,Шөлден ұшырылды
Dialogue: 0,1:14:09.23,1:14:11.23,Default,,0,0,0,,Бұл қандай зымыран?
Dialogue: 0,1:14:14.07,1:14:14.99,Default,,0,0,0,,Ол көтерілді.
Dialogue: 0,1:14:16.82,1:14:18.78,Default,,0,0,0,,Алла разы болсын
Dialogue: 0,1:14:29.46,1:14:32.55,Default,,0,0,0,,Аспанда жарылыс болды. Бұл теракт болды...
Dialogue: 0,1:14:41.60,1:14:42.47,Default,,0,0,0,,Эй
Dialogue: 0,1:14:43.60,1:14:44.77,Default,,0,0,0,,Не болды?
Dialogue: 0,1:14:44.93,1:14:46.81,Default,,0,0,0,,Сол жерден қашыңыз
Dialogue: 0,1:14:56.45,1:14:57.28,Default,,0,0,0,,Рено…
Dialogue: 0,1:14:59.16,1:14:59.99,Default,,0,0,0,,Рено
Dialogue: 0,1:15:23.47,1:15:26.23,Default,,0,0,0,,Бұл да күтілуде ме?
Dialogue: 0,1:15:28.98,1:15:31.73,Default,,0,0,0,,Температураның төмендеуін күтіңіз
Dialogue: 0,1:15:39.36,1:15:40.70,Default,,0,0,0,,Рено, жақсысың ба?
Dialogue: 0,1:15:41.16,1:15:43.20,Default,,0,0,0,,Жарылысқа не себеп болды?
Dialogue: 0,1:15:43.45,1:15:45.20,Default,,0,0,0,,Бұл палуанның зымыраны ма?
Dialogue: 0,1:15:46.66,1:15:48.75,Default,,0,0,0,,Мен білмеймін, бірақ суық
Dialogue: 0,1:16:51.39,1:16:53.81,Default,,0,0,0,,DMC-де қар жауып тұр
Dialogue: 0,1:16:54.10,1:16:55.27,Default,,0,0,0,,Не болды?
Dialogue: 0,1:16:56.90,1:16:58.48,Default,,0,0,0,,Винс жаман
Dialogue: 0,1:16:59.15,1:17:03.32,Default,,0,0,0,,Денем тоңып тұр, жанымда болшы.
Dialogue: 0,1:17:06.58,1:17:09.58,Default,,0,0,0,,Менің бүкіл денем салқын, қатайған.
Dialogue: 0,1:17:12.46,1:17:13.96,Default,,0,0,0,,Өлме
Dialogue: 0,1:17:15.79,1:17:19.63,Default,,0,0,0,,Көз алдымда мені қарсы алған нұрды көріп тұрмын.
Dialogue: 0,1:17:20.42,1:17:22.84,Default,,0,0,0,,Артқа қайт! Барма
Dialogue: 0,1:17:24.51,1:17:26.85,Default,,0,0,0,,Сатқын не істеді?
Dialogue: 0,1:17:32.48,1:17:35.85,Default,,0,0,0,,Мен сені кездестіргеннен бері жолым болмады.
Dialogue: 0,1:17:45.66,1:17:47.74,Default,,0,0,0,,Рено маған сенбе
Dialogue: 0,1:17:54.54,1:17:55.67,Default,,0,0,0,,Күте тұр… Демек, мені соңында ұмытып қалдыңдар ма?
Dialogue: 0,1:17:55.83,1:17:56.67,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,1:17:57.96,1:18:00.50,Default,,0,0,0,,Жүрегім жылыды
Dialogue: 0,1:18:01.30,1:18:05.68,Default,,0,0,0,,Маған қалай өмір сүру керектігін көрсеткеніңіз үшін рахмет.
Dialogue: 0,1:18:07.09,1:18:11.18,Default,,0,0,0,,Мен басқалардың қабылдамауынан қорықтым.
Dialogue: 0,1:18:11.81,1:18:14.85,Default,,0,0,0,,Бірақ жек көрсең, ащы сезім қалады
Dialogue: 0,1:18:16.14,1:18:19.52,Default,,0,0,0,,Тәтті сүйіспеншілік әлдеқайда жақсырақ
Dialogue: 0,1:18:20.52,1:18:21.69,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:18:37.83,1:18:40.34,Default,,0,0,0,,Бұл да балалар сияқты аянышты.
Dialogue: 0,1:18:40.50,1:18:41.38,Default,,0,0,0,,Польнареффтің Рух толқыны сонша жылдам болатынын—
Dialogue: 0,1:18:55.89,1:19:00.56,Default,,0,0,0,,Мазасыздық жойылды. Біз қанша сөйлестік?
Dialogue: 0,1:19:10.53,1:19:13.08,Default,,0,0,0,,Мен мұндай қателікті бірінші рет жасап тұрмын.
Dialogue: 0,1:19:14.91,1:19:16.16,Default,,0,0,0,,Оған жақындамаңыз
Dialogue: 0,1:19:47.44,1:19:50.78,Default,,0,0,0,,Рено Ішкі құбыжықты босатыңыз!
Dialogue: 0,1:19:51.11,1:19:52.12,Default,,0,0,0,,Трансформация
Dialogue: 0,1:19:52.28,1:19:53.78,Default,,0,0,0,,Өлген жақсы
Dialogue: 0,1:19:58.41,1:19:59.79,Default,,0,0,0,,Тұр
Dialogue: 0,1:20:12.80,1:20:14.05,Default,,0,0,0,,Жоқ, олар шын мәнінде тамақтанбай-ақ қоятындай деңгейге дейін дамыды, бірақ…
Dialogue: 0,1:20:18.98,1:20:20.98,Default,,0,0,0,,Адамдығыңнан бас тарт
Dialogue: 0,1:20:21.14,1:20:24.15,Default,,0,0,0,,Өзіңіздің шынайы болмысыңызды қабылдаңыз
Dialogue: 0,1:20:34.32,1:20:37.29,Default,,0,0,0,,Өз жолыңмен өмір сүр
Dialogue: 0,1:20:43.33,1:20:47.09,Default,,0,0,0,,Мен құбыжық емеспін. Бұл жеке-дара шайқас.
Dialogue: 0,1:20:51.68,1:20:53.34,Default,,0,0,0,,Оны жақсы ойнамаңыз
Dialogue: 0,1:20:53.51,1:20:55.47,Default,,0,0,0,,Шатырларыңызды пайдаланыңыз
Dialogue: 0,1:20:55.64,1:21:00.02,Default,,0,0,0,,Егер сізді құбыжық басқаратын болса, өлгеніңіз жақсы.
Dialogue: 0,1:21:01.18,1:21:03.90,Default,,0,0,0,,Шағымсыз ғана жасаңыз
Dialogue: 0,1:21:04.19,1:21:05.02,Default,,0,0,0,,Осымен.
Dialogue: 0,1:21:07.15,1:21:08.78,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,1:21:08.98,1:21:10.86,Default,,0,0,0,,Уағыз айтуға уақыт жоқ
Dialogue: 0,1:21:11.03,1:21:13.57,Default,,0,0,0,,Мен сені бір оқпен ұрамын.
Dialogue: 0,1:21:33.55,1:21:37.39,Default,,0,0,0,,Сәттілік. Pipo дүкенінде кездескенше.
Dialogue: 0,1:21:43.14,1:21:46.73,Default,,0,0,0,,Сіз үлкен күш қолданбадыңыз.
Dialogue: 0,1:21:57.41,1:22:00.20,Default,,0,0,0,,Бұл жеңілгеннің белгісі.
Dialogue: 0,1:22:01.29,1:22:04.66,Default,,0,0,0,,Сондықтан олар сізге мылтық сілтейді, сіз өлесіз.
Dialogue: 0,1:22:07.38,1:22:10.38,Default,,0,0,0,,«Алда одан да жаман нәрселер бар»
Dialogue: 0,1:22:12.76,1:22:15.93,Default,,0,0,0,,«Гамлет» 3-акт, 4-көрініс
Dialogue: 0,1:22:22.10,1:22:24.60,Default,,0,0,0,,«Көзге көз»
Dialogue: 0,1:22:39.91,1:22:43.91,Default,,0,0,0,,``Мылтық алған әрбір адам мылтықтан өледі.''
Dialogue: 0,1:22:50.96,1:22:51.84,Default,,0,0,0,,Луна
Dialogue: 0,1:23:06.85,1:23:07.94,Default,,0,0,0,,Луна…
Dialogue: 0,1:23:25.29,1:23:27.62,Default,,0,0,0,,Луна, барма, күн суық.
Dialogue: 0,1:23:45.93,1:23:49.31,Default,,0,0,0,,Мачодан арыла алдыңыз ба?
Dialogue: 0,1:23:50.44,1:23:51.48,Default,,0,0,0,,Сәттілік?
Dialogue: 0,1:23:53.86,1:23:56.19,Default,,0,0,0,,Белгісіз еңбегі бар адам.
Dialogue: 0,1:23:56.36,1:23:59.03,Default,,0,0,0,,Нағыз батырлар өздерін атамайды.
Dialogue: 0,1:24:03.12,1:24:06.33,Default,,0,0,0,,Жағымсыз оқиғадан екі ай өткен соң
Dialogue: 0,1:24:07.29,1:24:08.04,Default,,0,0,0,,Қар еріп, қала қалпына келеді.
Dialogue: 0,1:24:08.04,1:24:11.67,Default,,0,0,0,,Қар еріп, қала қалпына келеді.
Dialogue: 0,1:24:08.04,1:24:11.67,Default,,0,0,0,,``Менде бәрі жақсы.''
Dialogue: 0,1:24:11.67,1:24:13.71,Default,,0,0,0,,``Менде бәрі жақсы.''
Dialogue: 0,1:24:13.71,1:24:14.88,Default,,0,0,0,,``Менде бәрі жақсы.''
Dialogue: 0,1:24:13.71,1:24:14.88,Default,,0,0,0,,Сол жарылыс туралы дау аяқталды.
Dialogue: 0,1:24:14.88,1:24:16.71,Default,,0,0,0,,Сол жарылыс туралы дау аяқталды.
Dialogue: 0,1:24:16.88,1:24:22.05,Default,,0,0,0,,Спутниктің жарылысы экотерроризммен байланысты.
Dialogue: 0,1:24:22.68,1:24:27.06,Default,,0,0,0,,Ал енді ештеңе болмағандай
Dialogue: 0,1:24:27.89,1:24:30.23,Default,,0,0,0,,Дүние бұрынғыдай.
Dialogue: 0,1:24:31.10,1:24:34.56,Default,,0,0,0,,Айтпақшы, бізге жаңа президент келді.
Dialogue: 0,1:24:35.19,1:24:38.19,Default,,0,0,0,,Мен бірдеңе өзгеретінін білмеймін.
Dialogue: 0,1:24:38.36,1:24:41.74,Default,,0,0,0,,Біз оны күте аламыз, өйткені бізде әйел президент бар.
Dialogue: 0,1:24:43.07,1:24:45.08,Default,,0,0,0,,Виллимен байланыс жоқ
Dialogue: 0,1:24:45.33,1:24:47.08,Default,,0,0,0,,Бірақ ол музыкалық бағдарламаға шықты.
Dialogue: 0,1:24:48.08,1:24:52.75,Default,,0,0,0,,Ол біртүрлі жігіт еді, бірақ ақыры дебют жасады.
Dialogue: 0,1:24:53.42,1:24:56.67,Default,,0,0,0,,Мен қара адаммын, Әлемнің патшасымын
Dialogue: 0,1:24:56.84,1:25:00.80,Default,,0,0,0,,Маған скафандр керек емес, мен оттегімін.
Dialogue: 0,1:25:00.97,1:25:02.63,Default,,0,0,0,,Мен оттегімен көбейтемін
Dialogue: 0,1:25:02.80,1:25:04.97,Default,,0,0,0,,Мен Вилли үшін аздап уайымдап тұрмын.
Dialogue: 0,1:25:05.26,1:25:08.77,Default,,0,0,0,,Егер ол «оттегіде өссе», онда ол жақсы болуы керек.
Dialogue: 0,1:25:09.52,1:25:12.31,Default,,0,0,0,,Ақырында бізге оралады
Dialogue: 0,1:25:12.98,1:25:14.10,Default,,0,0,0,,Бұл табиғат заңы.
Dialogue: 0,1:25:14.44,1:25:17.15,Default,,0,0,0,,Оған ешкім шыдай алмайды
Dialogue: 0,1:25:18.40,1:25:21.32,Default,,0,0,0,,Қала әлі шіріген
Dialogue: 0,1:25:21.65,1:25:24.66,Default,,0,0,0,,Бірақ бұл біз тиесілі жер.
Dialogue: 0,1:25:25.57,1:25:28.54,Default,,0,0,0,,Менде жаңа теледидар бар, сондықтан жаман емес.
Dialogue: 0,1:25:31.12,1:25:33.96,Default,,0,0,0,,Hammer Smash үшін соққы!
Dialogue: 0,1:25:35.46,1:25:36.71,Default,,0,0,0,,Тарақандар да—
Dialogue: 0,1:25:36.96,1:25:40.42,Default,,0,0,0,,Балуансыз оралды
Dialogue: 0,1:25:53.14,1:25:54.98,Default,,0,0,0,,арқасымен құлады
Dialogue: 0,1:25:55.48,1:25:57.69,Default,,0,0,0,,Жолбарыс ауада ұшады
Dialogue: 0,1:25:58.57,1:26:02.69,Default,,0,0,0,,Винс Пипо дүкенінде жұмыс істей бастады.
Dialogue: 0,1:26:03.07,1:26:04.95,Default,,0,0,0,,Бұл мен сені алғаш көрген дүкен.
Dialogue: 0,1:26:06.87,1:26:07.78,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:26:08.49,1:26:09.53,Default,,0,0,0,,Қалайсың?
Dialogue: 0,1:26:09.66,1:26:10.54,Default,,0,0,0,,Жақсы.
Dialogue: 0,1:26:10.66,1:26:13.83,Default,,0,0,0,,Мен мекен-жайы белгісіз дос қызыма хат жазып отырмын.
Dialogue: 0,1:26:15.25,1:26:17.67,Default,,0,0,0,,Мен бүгін де дүкенге келген жоқпын.
Dialogue: 0,1:26:20.34,1:26:22.34,Default,,0,0,0,,Мүмкін ертең келер
Dialogue: 0,1:26:23.21,1:26:24.30,Default,,0,0,0,,Мүмкін.
Dialogue: 0,1:26:24.55,1:26:28.89,Default,,0,0,0,,Мен сені үнемі ойлаймын
Dialogue: 0,1:26:29.18,1:26:30.05,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,1:26:30.60,1:26:33.06,Default,,0,0,0,,Мен туралы аз да болса ойлайсың ба?
Dialogue: 0,1:26:42.19,1:26:45.24,Default,,0,0,0,,«Анджелино»
Dialogue: 0,1:26:47.95,1:26:51.41,Default,,0,0,0,,Менің атым Анджелино
Dialogue: 0,1:26:51.53,1:26:54.29,Default,,0,0,0,,Мекен-жайы - Dark Meat City
Dialogue: 0,1:26:54.70,1:26:58.58,Default,,0,0,0,,Америка Құрама Штаттары Жер және...
Dialogue: 0,1:26:58.88,1:27:00.42,Default,,0,0,0,,Қалғанын білмеймін
Dialogue: 0,1:27:05.88,1:27:06.88,Default,,0,0,0,,Луна
Dialogue: 0,1:27:08.72,1:27:09.93,Default,,0,0,0,,Рахмет
Dialogue: 0,1:27:53.22,1:27:54.06,Default,,0,0,0,,Мен көремін.
