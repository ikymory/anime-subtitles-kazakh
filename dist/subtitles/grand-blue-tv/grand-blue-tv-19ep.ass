Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.29,0:00:05.96,Default,,0,0,0,,Олай болса
Dialogue: 0,0:00:02.29,0:00:05.96,Default,,0,0,0,,Қосымша емтиханды аяқтау
Dialogue: 0,0:00:05.96,0:00:10.13,Default,,0,0,0,,~ аяқталды
Dialogue: 0,0:00:05.96,0:00:10.13,Default,,0,0,0,,Мен қызыл нүктеден қалай да құтыла алатын сияқтымын.
Dialogue: 0,0:00:10.13,0:00:13.47,Default,,0,0,0,,Китахара Имамура
Dialogue: 0,0:00:10.13,0:00:13.47,Default,,0,0,0,,Енді тост алсақ ше?
Dialogue: 0,0:00:13.47,0:00:15.97,Default,,0,0,0,,О, бұл жақсы!
Dialogue: 0,0:00:13.47,0:00:15.97,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:00:15.97,0:00:19.98,Default,,0,0,0,,Жарайды, Китахараның үйі.
Dialogue: 0,0:00:15.97,0:00:19.98,Default,,0,0,0,,Иә, Китахараның үйіне барайық.
Dialogue: 0,0:00:19.98,0:00:22.98,Default,,0,0,0,,Жарайды, бұл Китахараның үйі.
Dialogue: 0,0:00:19.98,0:00:22.98,Default,,0,0,0,,Жарайды, мен сізге жол көрсетуге рұқсат етіңіз.
Dialogue: 0,0:00:22.98,0:00:26.65,Default,,0,0,0,,Жоқ, бұл ағын біртүрлі.
Dialogue: 0,0:00:22.98,0:00:26.65,Default,,0,0,0,,Не? Китахара
Dialogue: 0,0:00:26.65,0:00:30.49,Default,,0,0,0,,Неліктен бұл менің үйім?
Dialogue: 0,0:00:26.65,0:00:30.49,Default,,0,0,0,,Әрине, шешілді.
Dialogue: 0,0:00:30.49,0:00:32.99,Default,,0,0,0,,Тексерілетін нәрселер
Dialogue: 0,0:00:30.49,0:00:32.99,Default,,0,0,0,,Өйткені бар
Dialogue: 0,0:00:32.99,0:00:37.49,Default,,0,0,0,,Растау?
Dialogue: 0,0:00:32.99,0:00:37.49,Default,,0,0,0,,Қараңызшы, Имамура мұны бұрын айтты, солай ма?
Dialogue: 0,0:00:37.49,0:00:39.83,Default,,0,0,0,,((
Dialogue: 0,0:00:37.49,0:00:39.83,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:00:39.83,0:00:41.83,Default,,0,0,0,,Біз бірге тұрамыз))
Dialogue: 0,0:00:41.83,0:00:47.00,Default,,0,0,0,,Эй Китахара-кун...
Dialogue: 0,0:00:41.83,0:00:47.00,Default,,0,0,0,,Мен олай ойламаймын...
Dialogue: 0,0:00:47.00,0:00:49.34,Default,,0,0,0,,(Нодзима/Ямамото)
Dialogue: 0,0:00:47.00,0:00:49.34,Default,,0,0,0,,Расында Котегава-чанмен➡︎
Dialogue: 0,0:00:49.34,0:00:51.51,Default,,0,0,0,,Сіз онда тұрмайсыз, солай ма?
Dialogue: 0,0:00:51.51,0:00:53.51,Default,,0,0,0,,《Білсең, міндетті түрде ұрып-соғасың!
Dialogue: 0,0:00:53.51,0:00:56.28,Default,,0,0,0,,Жоқ, біз кездесіп жатырмыз.
Dialogue: 0,0:00:53.51,0:00:56.28,Default,,0,0,0,,Чиса әлі де жақсы
Dialogue: 0,0:00:56.28,0:00:58.28,Default,,0,0,0,,Мәселе мынада...
Dialogue: 0,0:00:58.28,0:01:00.28,Default,,0,0,0,,Ол өте әдемі және керемет стильге ие.
Dialogue: 0,0:00:58.28,0:01:00.28,Default,,0,0,0,,Әпкеңмен➡︎
Dialogue: 0,0:01:00.28,0:01:03.12,Default,,0,0,0,,Егер мен бірге тұратынымызды білсем...
Dialogue: 0,0:01:03.12,0:01:06.42,Default,,0,0,0,,Не істеу керек...
Dialogue: 0,0:01:03.12,0:01:06.42,Default,,0,0,0,,Өтінемін, Кохэй, маған көмектесші! 》
Dialogue: 0,0:01:08.46,0:01:11.66,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:01:08.46,0:01:11.66,Default,,0,0,0,,Сен бейбақ!
Dialogue: 0,0:02:46.99,0:02:48.99,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:02:46.99,0:02:48.99,Default,,0,0,0,,Иори-кун
Dialogue: 0,0:02:48.99,0:02:50.99,Default,,0,0,0,,Нанака-сан!
Dialogue: 0,0:02:48.99,0:02:50.99,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:50.99,0:02:54.16,Default,,0,0,0,,Бүгін менің бөлмеме университеттің жігіттері келді.
Dialogue: 0,0:02:50.99,0:02:54.16,Default,,0,0,0,,Келемін деді...
Dialogue: 0,0:02:54.16,0:02:56.43,Default,,0,0,0,,Эй, сенің досың келе жатыр.
Dialogue: 0,0:02:56.43,0:03:00.10,Default,,0,0,0,,Сондықтан мүмкіндігінше тезірек жасырыңыз!
Dialogue: 0,0:02:56.43,0:03:00.10,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:00.10,0:03:03.11,Default,,0,0,0,,Мен мұны жақсы түсіндіре алмаймын.
Dialogue: 0,0:03:00.10,0:03:03.11,Default,,0,0,0,,Қарапайым тілмен айтқанда...
Dialogue: 0,0:03:03.11,0:03:08.31,Default,,0,0,0,,Менің өміріме қауіп төніп тұр.
Dialogue: 0,0:03:03.11,0:03:08.31,Default,,0,0,0,,Келіп жатқан досың емес пе?
Dialogue: 0,0:03:10.28,0:03:13.78,Default,,0,0,0,,Уххх
Dialogue: 0,0:03:10.28,0:03:13.78,Default,,0,0,0,,Мен сусындар мен тамақ сатып алдым.
Dialogue: 0,0:03:13.78,0:03:16.12,Default,,0,0,0,,О~ Жақсы жұмыс~
Dialogue: 0,0:03:16.12,0:03:20.29,Default,,0,0,0,,Дайвинг дүкені?
Dialogue: 0,0:03:16.12,0:03:20.29,Default,,0,0,0,,Бұл Китахараның пансионаты ма?
Dialogue: 0,0:03:20.29,0:03:24.63,Default,,0,0,0,,Бұл әдемі дүкен.
Dialogue: 0,0:03:20.29,0:03:24.63,Default,,0,0,0,,Әдетте лас жалаңаш денелерге толы.
Dialogue: 0,0:03:24.63,0:03:28.97,Default,,0,0,0,,Жоқ, мен бөлек бөлмедемін.
Dialogue: 0,0:03:24.63,0:03:28.97,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:03:28.97,0:03:31.30,Default,,0,0,0,,Не?
Dialogue: 0,0:03:28.97,0:03:31.30,Default,,0,0,0,,Маған тағы біраз көрсетіңіз.
Dialogue: 0,0:03:31.30,0:03:33.30,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,0:03:33.30,0:03:36.40,Default,,0,0,0,,《Қазір Чиса мен Нанака-сандікі
Dialogue: 0,0:03:33.30,0:03:36.40,Default,,0,0,0,,Болмысты жасыруға болады》
Dialogue: 0,0:03:38.48,0:03:42.48,Default,,0,0,0,,Бұл менің бөлмем.
Dialogue: 0,0:03:42.48,0:03:46.98,Default,,0,0,0,,Китахара-кун~!
Dialogue: 0,0:03:42.48,0:03:46.98,Default,,0,0,0,,《Азуса-сан! 》
Dialogue: 0,0:03:46.98,0:03:51.16,Default,,0,0,0,,Сенің өмірің қандай қызғаныш!
Dialogue: 0,0:03:46.98,0:03:51.16,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:03:51.16,0:03:55.43,Default,,0,0,0,,А, бұл басқаша...
Dialogue: 0,0:03:51.16,0:03:55.43,Default,,0,0,0,,Ей, эй, тынышталыңдар, балалар.
Dialogue: 0,0:03:55.43,0:03:58.76,Default,,0,0,0,,Яй Ямамото...
Dialogue: 0,0:03:55.43,0:03:58.76,Default,,0,0,0,,Сіз бұл сатқындықты кешіресіз бе?
Dialogue: 0,0:03:58.76,0:04:02.93,Default,,0,0,0,,Сатқындық жоқ, тек қалпақ.
Dialogue: 0,0:03:58.76,0:04:02.93,Default,,0,0,0,,Дабырлаудың қажеті жоқ.
Dialogue: 0,0:04:02.93,0:04:05.27,Default,,0,0,0,,қалпақ!?
Dialogue: 0,0:04:02.93,0:04:05.27,Default,,0,0,0,,Оны киесің бе!?
Dialogue: 0,0:04:05.27,0:04:08.44,Default,,0,0,0,,Мен бұл жігітті қатты қызғанамын
Dialogue: 0,0:04:05.27,0:04:08.44,Default,,0,0,0,,Сіз шындықты ұмыттыңыз ба?
Dialogue: 0,0:04:08.44,0:04:12.28,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:04:08.44,0:04:12.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:12.28,0:04:15.78,Default,,0,0,0,,Иори-кун~!
Dialogue: 0,0:04:12.28,0:04:15.78,Default,,0,0,0,,《Кабако~! 》
Dialogue: 0,0:04:15.78,0:04:18.28,Default,,0,0,0,,Суппозиторийлер?
Dialogue: 0,0:04:15.78,0:04:18.28,Default,,0,0,0,,Неліктен олай көрінеді...
Dialogue: 0,0:04:18.28,0:04:20.95,Default,,0,0,0,,Сіз есін жоғалтып алдыңыз...
Dialogue: 0,0:04:18.28,0:04:20.95,Default,,0,0,0,,Бұл Китахараның кінәсі!
Dialogue: 0,0:04:20.95,0:04:22.95,Default,,0,0,0,,Менің кінәм бар ма?
Dialogue: 0,0:04:22.95,0:04:26.62,Default,,0,0,0,,Бұл... шеңбердегі ойын.
Dialogue: 0,0:04:22.95,0:04:26.62,Default,,0,0,0,,Бұл мен пайдаланған нәрсе.
Dialogue: 0,0:04:26.62,0:04:28.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:26.62,0:04:28.79,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:04:28.79,0:04:32.30,Default,,0,0,0,,Енді ойлап қарасам, Котегава мырзаныкі
Dialogue: 0,0:04:28.79,0:04:32.30,Default,,0,0,0,,Өлшеміне сай емес пе? Бұл өте үлкен.
Dialogue: 0,0:04:32.30,0:04:35.13,Default,,0,0,0,,Менен сұрасаңыз, иә.
Dialogue: 0,0:04:32.30,0:04:35.13,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:04:35.13,0:04:37.97,Default,,0,0,0,,Ойланып қарасаңыз
Dialogue: 0,0:04:35.13,0:04:37.97,Default,,0,0,0,,Оның шынайы болуы мүмкін емес!
Dialogue: 0,0:04:37.97,0:04:41.31,Default,,0,0,0,,Егер шын болса, кім шешіп тастады?
Dialogue: 0,0:04:37.97,0:04:41.31,Default,,0,0,0,,Үйге жете алмай жүрмін.
Dialogue: 0,0:04:41.31,0:04:43.97,Default,,0,0,0,,Сіз әдетте кеудешесіз үйге бармайтын едіңіз.
Dialogue: 0,0:04:43.97,0:04:46.14,Default,,0,0,0,,《Себебі ол адам қалыпты емес...》
Dialogue: 0,0:04:46.14,0:04:49.14,Default,,0,0,0,,Ал, тағы не күдікті?
Dialogue: 0,0:04:46.14,0:04:49.14,Default,,0,0,0,,Әсіресе... иә?
Dialogue: 0,0:04:51.15,0:04:53.85,Default,,0,0,0,,Вегетариандық деген нәрсе бар емес пе?
Dialogue: 0,0:04:51.15,0:04:53.85,Default,,0,0,0,,Мен қателестім деп ойлаймын...
Dialogue: 0,0:04:56.59,0:04:58.59,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:58.59,0:05:00.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:58.59,0:05:00.59,Default,,0,0,0,,Не болды?Балалар сендер
Dialogue: 0,0:05:00.59,0:05:02.59,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:05:00.59,0:05:02.59,Default,,0,0,0,,Бұл ештеңе емес!
Dialogue: 0,0:05:02.59,0:05:04.76,Default,,0,0,0,,Бұл адамның заттары
Dialogue: 0,0:05:02.59,0:05:04.76,Default,,0,0,0,,Бұл, әрине, біртүрлі
Dialogue: 0,0:05:04.76,0:05:07.60,Default,,0,0,0,,Әйелдің көлеңкесі болудан алыс
Dialogue: 0,0:05:04.76,0:05:07.60,Default,,0,0,0,,Қауіпті қараңғылық жасырынып тұр
Dialogue: 0,0:05:07.60,0:05:10.10,Default,,0,0,0,,Әзірге
Dialogue: 0,0:05:07.60,0:05:10.10,Default,,0,0,0,,Байқамаймыз деп алайық.
Dialogue: 0,0:05:10.10,0:05:12.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:12.77,0:05:15.94,Default,,0,0,0,,Сіз толық емес жұмыс күнін іздеп жүрсіз бе?
Dialogue: 0,0:05:12.77,0:05:15.94,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:05:15.94,0:05:19.14,Default,,0,0,0,,Дайвинг қымбат.
Dialogue: 0,0:05:15.94,0:05:19.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:24.45,0:05:26.62,Default,,0,0,0,,《Бәрі: Олай емес, анау жігіт...》
Dialogue: 0,0:05:26.62,0:05:28.62,Default,,0,0,0,,Әзірше ішіп алайық.
Dialogue: 0,0:05:28.62,0:05:31.62,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:28.62,0:05:31.62,Default,,0,0,0,,Ішіп алайық, ұмытайық
Dialogue: 0,0:05:31.62,0:05:33.96,Default,,0,0,0,,Терең ойланып қарасаң қорқынышты...
Dialogue: 0,0:05:33.96,0:05:36.46,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:33.96,0:05:36.46,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:05:36.46,0:05:39.46,Default,,0,0,0,,Олай болса
Dialogue: 0,0:05:36.46,0:05:39.46,Default,,0,0,0,,Мен толықтыру емтиханын сәтті тапсырдым...
Dialogue: 0,0:05:39.46,0:05:41.46,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:05:43.80,0:05:46.80,Default,,0,0,0,,Пуха~! Шынымды айтсам, бұл сыра➡︎
Dialogue: 0,0:05:46.80,0:05:49.64,Default,,0,0,0,,Екінші жартысы Ащы емес пе?
Dialogue: 0,0:05:46.80,0:05:49.64,Default,,0,0,0,,Мен түсіндім, түсінемін
Dialogue: 0,0:05:49.64,0:05:52.64,Default,,0,0,0,,Теңізден шыққаннан кейін
Dialogue: 0,0:05:49.64,0:05:52.64,Default,,0,0,0,,Бірінші тістеу таңқаларлық болды.
Dialogue: 0,0:05:52.64,0:05:56.41,Default,,0,0,0,,Әрине
Dialogue: 0,0:05:52.64,0:05:56.41,Default,,0,0,0,,А? Не болды, Ямамото?
Dialogue: 0,0:05:56.41,0:06:00.58,Default,,0,0,0,,Бұл өте ұзын ванна бөлмесі болатын.
Dialogue: 0,0:05:56.41,0:06:00.58,Default,,0,0,0,,Сәлем Китахара...
Dialogue: 0,0:06:00.58,0:06:03.38,Default,,0,0,0,,Не?
Dialogue: 0,0:06:00.58,0:06:03.38,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:06:06.26,0:06:10.26,Default,,0,0,0,,Мен періштені кездестірдім
Dialogue: 0,0:06:06.26,0:06:10.26,Default,,0,0,0,,Охо~!
Dialogue: 0,0:06:10.26,0:06:13.26,Default,,0,0,0,,Сіз өте әдемісіз! Эй!
Dialogue: 0,0:06:10.26,0:06:13.26,Default,,0,0,0,,Оны қайдан көрдің?
Dialogue: 0,0:06:13.26,0:06:15.27,Default,,0,0,0,,Мен енді ғана ояндым
Dialogue: 0,0:06:13.26,0:06:15.27,Default,,0,0,0,,Сыртқа шыққанда➡︎
Dialogue: 0,0:06:15.27,0:06:17.27,Default,,0,0,0,,Теңізде кездейсоқ
Dialogue: 0,0:06:15.27,0:06:17.27,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:06:17.27,0:06:21.10,Default,,0,0,0,,Мен оны қазір көрдім
Dialogue: 0,0:06:17.27,0:06:21.10,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:06:21.10,0:06:24.78,Default,,0,0,0,,Мен өлсем бола ма?
Dialogue: 0,0:06:21.10,0:06:24.78,Default,,0,0,0,,Сіз не ойладыңыз?
Dialogue: 0,0:06:24.78,0:06:27.28,Default,,0,0,0,,Мен бұл адаммен араласқым келеді.
Dialogue: 0,0:06:27.28,0:06:29.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:27.28,0:06:29.45,Default,,0,0,0,,Бұл мүмкін емес емес пе?
Dialogue: 0,0:06:29.45,0:06:34.62,Default,,0,0,0,,Бұл өте орынсыз.
Dialogue: 0,0:06:29.45,0:06:34.62,Default,,0,0,0,,Мен білемін, бірақ...
Dialogue: 0,0:06:34.62,0:06:37.79,Default,,0,0,0,,Бұл мүмкін болмаса, балам
Dialogue: 0,0:06:34.62,0:06:37.79,Default,,0,0,0,,Мен сенің босанғаныңды қалаймын!
Dialogue: 0,0:06:37.79,0:06:39.79,Default,,0,0,0,,Ой, мына жігіт тым ақымақ екен.
Dialogue: 0,0:06:39.79,0:06:41.79,Default,,0,0,0,,Танысу
Dialogue: 0,0:06:39.79,0:06:41.79,Default,,0,0,0,,Бұл ұят деңгей.
Dialogue: 0,0:06:41.79,0:06:44.09,Default,,0,0,0,,Сен сыныптассың ба?
Dialogue: 0,0:06:41.79,0:06:44.09,Default,,0,0,0,,(Шукуна) Бұл жалықтырады. Егер менің орнымды алмақ болсаң, іске кіріс.
Dialogue: 0,0:06:46.13,0:06:48.30,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:06:46.13,0:06:48.30,Default,,0,0,0,,Соңғы пойыз?
Dialogue: 0,0:06:48.30,0:06:50.30,Default,,0,0,0,,Бұрынғы періштені іздеңіз.
Dialogue: 0,0:06:50.30,0:06:52.97,Default,,0,0,0,,Не!?
Dialogue: 0,0:06:50.30,0:06:52.97,Default,,0,0,0,,Сен не істеп жатырсың?
Dialogue: 0,0:06:52.97,0:06:54.97,Default,,0,0,0,,Бұл шешім қабылданған болуы керек.
Dialogue: 0,0:06:54.97,0:06:57.57,Default,,0,0,0,,Менің қызым боласың деп үміттенемін
Dialogue: 0,0:06:54.97,0:06:57.57,Default,,0,0,0,,Жерге тізерлеп отыр!
Dialogue: 0,0:06:57.57,0:07:02.25,Default,,0,0,0,,Сәжде мойындаудың негізгі қалпы ма?
Dialogue: 0,0:06:57.57,0:07:02.25,Default,,0,0,0,,Маған сіздің осы уақытқа дейінгі саяхатыңыз қызық.
Dialogue: 0,0:07:02.25,0:07:05.92,Default,,0,0,0,,Сіз қайтып келгенде
Dialogue: 0,0:07:02.25,0:07:05.92,Default,,0,0,0,,Мен толыққанды адаммын!
Dialogue: 0,0:07:05.92,0:07:07.92,Default,,0,0,0,,А-а, мен түсіндім...
Dialogue: 0,0:07:07.92,0:07:11.76,Default,,0,0,0,,Ол толыққанды адам...
Dialogue: 0,0:07:07.92,0:07:11.76,Default,,0,0,0,,Ал, қолыңнан келгенін істе.
Dialogue: 0,0:07:11.76,0:07:13.92,Default,,0,0,0,,Сонымен не болады деп ойлайсыңдар?
Dialogue: 0,0:07:13.92,0:07:16.26,Default,,0,0,0,,Екінші тарап
Dialogue: 0,0:07:13.92,0:07:16.26,Default,,0,0,0,,Оның сондай сұлу болғанын қалаймын.
Dialogue: 0,0:07:16.26,0:07:19.10,Default,,0,0,0,,Бірден шайқау
Dialogue: 0,0:07:16.26,0:07:19.10,Default,,0,0,0,,Ер адамдар жылайтын жер емес пе?
Dialogue: 0,0:07:19.10,0:07:23.60,Default,,0,0,0,,Не, сізде де осындай пікір бар ма?
Dialogue: 0,0:07:19.10,0:07:23.60,Default,,0,0,0,,Бәс тігу жұмыс істемейді.
Dialogue: 0,0:07:23.60,0:07:27.10,Default,,0,0,0,,​​О?
Dialogue: 0,0:07:23.60,0:07:27.10,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:07:27.10,0:07:30.27,Default,,0,0,0,,Қателіктеріңе көп тоқталудың орнына,
Dialogue: 0,0:07:27.10,0:07:30.27,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:07:30.27,0:07:35.11,Default,,0,0,0,,Сәлем Китахара! Бұл не?
Dialogue: 0,0:07:30.27,0:07:35.11,Default,,0,0,0,,Біріншіден, сен кімсің?
Dialogue: 0,0:07:35.11,0:07:37.11,Default,,0,0,0,,Сіз оны көрмейсіз бе?
Dialogue: 0,0:07:37.11,0:07:39.45,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:07:37.11,0:07:39.45,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:07:39.45,0:07:42.95,Default,,0,0,0,,Мен қазір
Dialogue: 0,0:07:39.45,0:07:42.95,Default,,0,0,0,,Мен теңізге баруға тырыстым.
Dialogue: 0,0:07:42.95,0:07:46.79,Default,,0,0,0,,Сосын жолда
Dialogue: 0,0:07:42.95,0:07:46.79,Default,,0,0,0,,Мен көптеген жалаңаш еркектерді кездестірдім...
Dialogue: 0,0:07:46.79,0:07:48.79,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:07:46.79,0:07:48.79,Default,,0,0,0,,Не!
Dialogue: 0,0:07:48.79,0:07:50.79,Default,,0,0,0,,Неліктен мұны білу керек?
Dialogue: 0,0:07:50.79,0:07:53.13,Default,,0,0,0,,Лорд Дамианның ағасы.
Dialogue: 0,0:07:50.79,0:07:53.13,Default,,0,0,0,,Бұл апат болды.
Dialogue: 0,0:07:53.13,0:07:56.07,Default,,0,0,0,,Жалаңаш еркектер ше?
Dialogue: 0,0:07:53.13,0:07:56.07,Default,,0,0,0,,Көзіңді шірітеді.
Dialogue: 0,0:07:56.07,0:07:58.90,Default,,0,0,0,,《Біз оны күнде көреміз~》
Dialogue: 0,0:07:58.90,0:08:03.07,Default,,0,0,0,,Ал, іш, іш.
Dialogue: 0,0:07:58.90,0:08:03.07,Default,,0,0,0,,Маған бәрібір бас тарту жазылды.
Dialogue: 0,0:08:03.07,0:08:06.41,Default,,0,0,0,,Ішіп ал, ұмыт!
Dialogue: 0,0:08:03.07,0:08:06.41,Default,,0,0,0,,Сіздің қызыңыз болуы мүмкін емес.
Dialogue: 0,0:08:06.41,0:08:09.58,Default,,0,0,0,,Балалар, мені аздап жұбатасыңдар ма?
Dialogue: 0,0:08:06.41,0:08:09.58,Default,,0,0,0,,Неліктен мұны істеу мүмкін емес?
Dialogue: 0,0:08:09.58,0:08:12.25,Default,,0,0,0,,Бірақ жақсы
Dialogue: 0,0:08:09.58,0:08:12.25,Default,,0,0,0,,Осыны тексеріңіз➡︎
Dialogue: 0,0:08:12.25,0:08:14.75,Default,,0,0,0,,Китахараның бірге тұру теориясы жалған сияқты.
Dialogue: 0,0:08:14.75,0:08:18.59,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:14.75,0:08:18.59,Default,,0,0,0,,Имамура да әзілқой.
Dialogue: 0,0:08:18.59,0:08:21.59,Default,,0,0,0,,Жоқ, мен қалжыңдап тұрған жоқпын... Аргх!
Dialogue: 0,0:08:21.59,0:08:24.59,Default,,0,0,0,,Себебі Кохэй әзілдерді жақсы көреді~
Dialogue: 0,0:08:24.59,0:08:27.43,Default,,0,0,0,,Ең алдымен қарым-қатынаста болу
Dialogue: 0,0:08:24.59,0:08:27.43,Default,,0,0,0,,өзі күдікті.
Dialogue: 0,0:08:27.43,0:08:31.44,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:08:27.43,0:08:31.44,Default,,0,0,0,,Бұл жігіттің қызының болуы тым табиғи емес.
Dialogue: 0,0:08:31.44,0:08:35.27,Default,,0,0,0,,Балалар, мен туралы не білесіңдер?
Dialogue: 0,0:08:31.44,0:08:35.27,Default,,0,0,0,,Жалпы, сондай сүйкімді қыз...
Dialogue: 0,0:08:35.27,0:08:38.94,Default,,0,0,0,,Иори Ванна ыстық.
Dialogue: 0,0:08:35.27,0:08:38.94,Default,,0,0,0,,Келесі... Ах
Dialogue: 0,0:08:38.94,0:08:40.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:40.94,0:08:45.78,Default,,0,0,0,,Егер осылай күттірсең, байқамай өлтіріп тастауым мүмкін, білесің бе?
Dialogue: 0,0:08:40.94,0:08:45.78,Default,,0,0,0,,Мен досым келеді деп ойламадым.
Dialogue: 0,0:08:45.78,0:08:47.78,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:08:45.78,0:08:47.78,Default,,0,0,0,,(шу)
Dialogue: 0,0:08:51.29,0:08:53.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:57.89,0:09:01.40,Default,,0,0,0,,Китахара-кун~!
Dialogue: 0,0:09:01.40,0:09:06.24,Default,,0,0,0,,Жоқ! Мен...
Dialogue: 0,0:09:01.40,0:09:06.24,Default,,0,0,0,,Кохэй, маған көмектесіңізші...
Dialogue: 0,0:09:06.24,0:09:10.34,Default,,0,0,0,,Еденді қанмен ластама.
Dialogue: 0,0:09:06.24,0:09:10.34,Default,,0,0,0,,Құрметті сіз!
Dialogue: 0,0:09:15.41,0:09:18.75,Default,,0,0,0,,Сәлем Чиса...
Dialogue: 0,0:09:15.41,0:09:18.75,Default,,0,0,0,,Не?
Dialogue: 0,0:09:18.75,0:09:23.09,Default,,0,0,0,,Маған осылай қарашы
Dialogue: 0,0:09:18.75,0:09:23.09,Default,,0,0,0,,Оны аямайсың ба?
Dialogue: 0,0:09:23.09,0:09:27.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:23.09,0:09:27.09,Default,,0,0,0,,Бұл шынымен өмірге әсер етеді...
Dialogue: 0,0:09:31.27,0:09:34.61,Default,,0,0,0,,О, мұндағы теңіз әдемі!
Dialogue: 0,0:09:31.27,0:09:34.61,Default,,0,0,0,,Менің барғым келеді
Dialogue: 0,0:09:34.61,0:09:38.11,Default,,0,0,0,,Миякожима?
Dialogue: 0,0:09:34.61,0:09:38.11,Default,,0,0,0,,Мен осындай көріністі көргім келеді~
Dialogue: 0,0:09:38.11,0:09:41.28,Default,,0,0,0,,Мен осында суға түскім келеді
Dialogue: 0,0:09:41.28,0:09:44.62,Default,,0,0,0,,Әй, сен сүңгу туралы айтып тұрсың ба?
Dialogue: 0,0:09:41.28,0:09:44.62,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:09:44.62,0:09:47.79,Default,,0,0,0,,Мен лицензияны тез аламын.
Dialogue: 0,0:09:44.62,0:09:47.79,Default,,0,0,0,,Мен көп нәрсеге сүңгігім келеді!
Dialogue: 0,0:09:47.79,0:09:50.46,Default,,0,0,0,,О
Dialogue: 0,0:09:47.79,0:09:50.46,Default,,0,0,0,,Хахахаха! Солай ма?
Dialogue: 0,0:09:50.46,0:09:53.29,Default,,0,0,0,,Үйірме жұмыстарына кім ынталы?
Dialogue: 0,0:09:50.46,0:09:53.29,Default,,0,0,0,,Бұл жақсы нәрсе.
Dialogue: 0,0:09:53.29,0:09:55.46,Default,,0,0,0,,Сонымен бүгін не істеп жатырсың?
Dialogue: 0,0:09:55.46,0:09:59.13,Default,,0,0,0,,Өзіңіз айтқандай, кіруге ыңғайлы киім киіңіз.
Dialogue: 0,0:09:55.46,0:09:59.13,Default,,0,0,0,,мен әкелдім
Dialogue: 0,0:09:59.13,0:10:02.64,Default,,0,0,0,,Теннистен жұптық матч ойнаңыз
Dialogue: 0,0:09:59.13,0:10:02.64,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:10:02.64,0:10:06.81,Default,,0,0,0,,Бұл достық жүйені оқыту
Dialogue: 0,0:10:02.64,0:10:06.81,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:10:06.81,0:10:12.48,Default,,0,0,0,,Шын мәнінде, бұл ақшалай сыйлық үшін.
Dialogue: 0,0:10:06.81,0:10:12.48,Default,,0,0,0,,Маған Тимбелдің төрағасы келді.
Dialogue: 0,0:10:12.48,0:10:16.65,Default,,0,0,0,,Мен жеңілсем, ерлер сайысында 2-ші орын аламын.
Dialogue: 0,0:10:12.48,0:10:16.65,Default,,0,0,0,,Мен ақшалай жүлдені аударамын.
Dialogue: 0,0:10:16.65,0:10:18.65,Default,,0,0,0,,Тимбель дегеніміз не?
Dialogue: 0,0:10:18.65,0:10:21.15,Default,,0,0,0,,Теннисшіге теннис
Dialogue: 0,0:10:18.65,0:10:21.15,Default,,0,0,0,,Жеңіске жету мүмкін емес!
Dialogue: 0,0:10:21.15,0:10:24.16,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:10:21.15,0:10:24.16,Default,,0,0,0,,Бұл кек алу үшін, солай емес пе?
Dialogue: 0,0:10:24.16,0:10:26.16,Default,,0,0,0,,Ұят болды
Dialogue: 0,0:10:26.16,0:10:28.16,Default,,0,0,0,,А, мен мұны түсіндім.
Dialogue: 0,0:10:26.16,0:10:28.16,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:10:28.16,0:10:30.66,Default,,0,0,0,,Бірақ біз осылай ойлаймыз.
Dialogue: 0,0:10:30.66,0:10:34.33,Default,,0,0,0,,Сіздің ұятыңыз үшін
Dialogue: 0,0:10:30.66,0:10:34.33,Default,,0,0,0,,Егер жүлде ақшасы бар болса, ол арзан болуы керек.
Dialogue: 0,0:10:34.33,0:10:37.33,Default,,0,0,0,,Ал, сен
Dialogue: 0,0:10:34.33,0:10:37.33,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:10:40.84,0:10:42.84,Default,,0,0,0,,Соқыңыз!
Dialogue: 0,0:10:42.84,0:10:46.35,Default,,0,0,0,,Бұл адамдар бейсбол ойындарын немесе басқаларды көріп отырды.
Dialogue: 0,0:10:42.84,0:10:46.35,Default,,0,0,0,,Сіз қате түсіндіңіз бе?
Dialogue: 0,0:10:46.35,0:10:49.18,Default,,0,0,0,,Сіз де ережелерді дұрыс түсінбеген сияқтысыз.
Dialogue: 0,0:10:49.18,0:10:51.52,Default,,0,0,0,,Екеуің келмейсіңдер ме?
Dialogue: 0,0:10:51.52,0:10:56.46,Default,,0,0,0,,Мен сені осы жерден іздеп жатырмын.
Dialogue: 0,0:10:51.52,0:10:56.46,Default,,0,0,0,,Мен де сені шын жүректен қолдаймын.
Dialogue: 0,0:10:56.46,0:10:58.63,Default,,0,0,0,,Айтпақшы, сен Джорджсың.
Dialogue: 0,0:10:58.63,0:11:00.63,Default,,0,0,0,,Теннис киетін болмайсың ба?
Dialogue: 0,0:11:00.63,0:11:03.80,Default,,0,0,0,,Мен оны кимеймін.
Dialogue: 0,0:11:00.63,0:11:03.80,Default,,0,0,0,,Аяғын көрсету ұят.
Dialogue: 0,0:11:03.80,0:11:06.13,Default,,0,0,0,,Бірақ сіз оны Мифконда болған кезде кигенсіз.
Dialogue: 0,0:11:06.13,0:11:09.47,Default,,0,0,0,,Ол боянған.
Dialogue: 0,0:11:06.13,0:11:09.47,Default,,0,0,0,,Өйткені ол да мас болған...
Dialogue: 0,0:11:09.47,0:11:12.14,Default,,0,0,0,,Сіз үшін макияж нені білдіреді?
Dialogue: 0,0:11:12.14,0:11:17.98,Default,,0,0,0,,Ал сол екі адамның қасында
Dialogue: 0,0:11:12.14,0:11:17.98,Default,,0,0,0,,Менің бұлай киінуге сенімім жоқ.
Dialogue: 0,0:11:17.98,0:11:20.81,Default,,0,0,0,,Біз үшін
Dialogue: 0,0:11:17.98,0:11:20.81,Default,,0,0,0,,Джерси сізге жарасады.
Dialogue: 0,0:11:20.81,0:11:23.82,Default,,0,0,0,,Дұрыс, теннис корты.
Dialogue: 0,0:11:20.81,0:11:23.82,Default,,0,0,0,,Мен оны кигенімде де қалқып тұрады.
Dialogue: 0,0:11:23.82,0:11:26.42,Default,,0,0,0,,Мен тенниске әуесқоймын.
Dialogue: 0,0:11:29.99,0:11:35.33,Default,,0,0,0,,Бұл жолы уәде етілгендей.
Dialogue: 0,0:11:29.99,0:11:35.33,Default,,0,0,0,,3 матчтағы жұптардың бір жиынтығы
Dialogue: 0,0:11:35.33,0:11:38.00,Default,,0,0,0,,О
Dialogue: 0,0:11:35.33,0:11:38.00,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ бұл жақсы.
Dialogue: 0,0:11:38.00,0:11:40.50,Default,,0,0,0,,Ол бұл жолы кроссовка киген жоқ.
Dialogue: 0,0:11:40.50,0:11:43.17,Default,,0,0,0,,(Шукуна) Бұл жалықтырады. Егер менің орнымды алмақ болсаң, іске кіріс.
Dialogue: 0,0:11:40.50,0:11:43.17,Default,,0,0,0,,Мен бұлай жасаған жоқпын!
Dialogue: 0,0:11:43.17,0:11:45.51,Default,,0,0,0,,Иә? Бұл бала жаңа ма?
Dialogue: 0,0:11:45.51,0:11:47.51,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:11:47.51,0:11:49.68,Default,,0,0,0,,Ол бізді бірінші рет кездесіп тұр деп ойлады.
Dialogue: 0,0:11:49.68,0:11:52.85,Default,,0,0,0,,Бұл макияж
Dialogue: 0,0:11:49.68,0:11:52.85,Default,,0,0,0,,Ол сізді сыртқы жаулардан қорғады ма?
Dialogue: 0,0:11:52.85,0:11:55.95,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:11:52.85,0:11:55.95,Default,,0,0,0,,Енді бірінші ойынды бастайық.
Dialogue: 0,0:11:55.95,0:11:58.95,Default,,0,0,0,,Тоқыта-сенпай, Котобүкі-сенпай, барыңды сал!
Dialogue: 0,0:11:58.95,0:12:01.45,Default,,0,0,0,,Ах~
Dialogue: 0,0:11:58.95,0:12:01.45,Default,,0,0,0,,Мен бар күшімді саламын~
Dialogue: 0,0:12:01.45,0:12:06.46,Default,,0,0,0,,Олай болса... Эй!
Dialogue: 0,0:12:06.46,0:12:08.46,Default,,0,0,0,,15-0!
Dialogue: 0,0:12:10.46,0:12:12.80,Default,,0,0,0,,Қазір не болып жатыр...
Dialogue: 0,0:12:12.80,0:12:18.47,Default,,0,0,0,,Сіз мұндай күшпен қалай қызмет ете аласыз?
Dialogue: 0,0:12:12.80,0:12:18.47,Default,,0,0,0,,Мен енді оңай сыймаймын.
Dialogue: 0,0:12:18.47,0:12:20.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:20.97,0:12:23.14,Default,,0,0,0,,Міне, Котобуки!
Dialogue: 0,0:12:20.97,0:12:23.14,Default,,0,0,0,,Жарайды, маған қалдырыңыз!
Dialogue: 0,0:12:23.14,0:12:26.81,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:23.14,0:12:26.81,Default,,0,0,0,,О!
Dialogue: 0,0:12:26.81,0:12:30.15,Default,,0,0,0,,30-0!
Dialogue: 0,0:12:26.81,0:12:30.15,Default,,0,0,0,,Әдемі көрінеді.
Dialogue: 0,0:12:30.15,0:12:34.32,Default,,0,0,0,,Токита-сенпай Котобуки-сенпай~!
Dialogue: 0,0:12:34.32,0:12:38.83,Default,,0,0,0,,Жақсы сияқты.
Dialogue: 0,0:12:34.32,0:12:38.83,Default,,0,0,0,,Оның спорттық жүйкелері үлкен дәрежеде.
Dialogue: 0,0:12:38.83,0:12:40.83,Default,,0,0,0,,Хмм…
Dialogue: 0,0:12:40.83,0:12:45.83,Default,,0,0,0,,Айтпақшы, қалған аға буын өкілдері ше?
Dialogue: 0,0:12:40.83,0:12:45.83,Default,,0,0,0,,Осы уақытқа дейін...
Dialogue: 0,0:12:45.83,0:12:48.17,Default,,0,0,0,,Қызық, ол көп ішкендіктен құлап қалды ма?
Dialogue: 0,0:12:48.17,0:12:52.34,Default,,0,0,0,,Мен қараймын.
Dialogue: 0,0:12:48.17,0:12:52.34,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:12:52.34,0:12:54.84,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:12:54.84,0:13:00.11,Default,,0,0,0,,Оның қатты мас болғанына сене алар емеспін!
Dialogue: 0,0:12:54.84,0:13:00.11,Default,,0,0,0,,Не болып жатыр...
Dialogue: 0,0:13:00.11,0:13:04.45,Default,,0,0,0,,О~ Иори мен Кохеи?
Dialogue: 0,0:13:00.11,0:13:04.45,Default,,0,0,0,,Ол ешқашан да болмайды!
Dialogue: 0,0:13:04.45,0:13:06.62,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:13:04.45,0:13:06.62,Default,,0,0,0,,Сіз нені айтасыз!?
Dialogue: 0,0:13:06.62,0:13:09.96,Default,,0,0,0,,Тимбелл
Dialogue: 0,0:13:06.62,0:13:09.96,Default,,0,0,0,,Маған сусын ұсынғаныңыз үшін рахмет.
Dialogue: 0,0:13:09.96,0:13:11.96,Default,,0,0,0,,Мен тым көп іштім...
Dialogue: 0,0:13:13.96,0:13:18.86,Default,,0,0,0,,Менде әлі біраз алкоголь қалды...
Dialogue: 0,0:13:13.96,0:13:18.86,Default,,0,0,0,,Бұл ақымақтық, менің ағаларым...
Dialogue: 0,0:13:20.80,0:13:25.47,Default,,0,0,0,,Бір мезетте буланады!?
Dialogue: 0,0:13:20.80,0:13:25.47,Default,,0,0,0,,Нені ішуге мәжбүр болдың!?
Dialogue: 0,0:13:25.47,0:13:28.14,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:25.47,0:13:28.14,Default,,0,0,0,,Бір-бірімізге қолдау көрсетейік
Dialogue: 0,0:13:28.14,0:13:30.81,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:28.14,0:13:30.81,Default,,0,0,0,,Сонымен ойын қандай?
Dialogue: 0,0:13:30.81,0:13:34.81,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:13:30.81,0:13:34.81,Default,,0,0,0,,Ой... Хахахаха
Dialogue: 0,0:13:34.81,0:13:37.15,Default,,0,0,0,,Неге екені белгісіз, менің қозғалысым біртүрлі баяу болды...
Dialogue: 0,0:13:37.15,0:13:39.99,Default,,0,0,0,,《Кохеи/Иори: Сол екеуі
Dialogue: 0,0:13:37.15,0:13:39.99,Default,,0,0,0,,Сіз жасырын ішкенсіз.
Dialogue: 0,0:13:39.99,0:13:41.99,Default,,0,0,0,,(ысқырық)
Dialogue: 0,0:13:41.99,0:13:43.99,Default,,0,0,0,,Осылай жалғастыра берсек, ұтылып қалуымыз мүмкін.
Dialogue: 0,0:13:43.99,0:13:46.49,Default,,0,0,0,,Бұл екеуі жеңе алады.
Dialogue: 0,0:13:43.99,0:13:46.49,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:13:46.49,0:13:50.33,Default,,0,0,0,,Китахара Бұл екі адам мас болды.
Dialogue: 0,0:13:46.49,0:13:50.33,Default,,0,0,0,,Оянудың жолы бар ма?
Dialogue: 0,0:13:50.33,0:13:52.83,Default,,0,0,0,,Хмм, мұны істейік.
Dialogue: 0,0:13:52.83,0:13:54.83,Default,,0,0,0,,Сот өзгерісі!
Dialogue: 0,0:13:54.83,0:13:58.63,Default,,0,0,0,,Я, бұл көп орын.
Dialogue: 0,0:13:54.83,0:13:58.63,Default,,0,0,0,,О
Dialogue: 0,0:14:00.61,0:14:02.78,Default,,0,0,0,,Buhe~!
Dialogue: 0,0:14:02.78,0:14:07.61,Default,,0,0,0,,Не!? Бұл?
Dialogue: 0,0:14:02.78,0:14:07.61,Default,,0,0,0,,Мазмұны өзгерді ме?
Dialogue: 0,0:14:07.61,0:14:09.62,Default,,0,0,0,,(ысқырық)
Dialogue: 0,0:14:09.62,0:14:12.12,Default,,0,0,0,,Қараңызшы!
Dialogue: 0,0:14:09.62,0:14:12.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:12.12,0:14:15.12,Default,,0,0,0,,Сіз бірдеңе істедіңіз бе?
Dialogue: 0,0:14:12.12,0:14:15.12,Default,,0,0,0,,Бұл кері идея.
Dialogue: 0,0:14:15.12,0:14:17.96,Default,,0,0,0,,Мені оятпа
Dialogue: 0,0:14:15.12,0:14:17.96,Default,,0,0,0,,Оларды да мас қылыңыз.
Dialogue: 0,0:14:17.96,0:14:21.29,Default,,0,0,0,,Спорт шеберлігі туралы не айтасыз?
Dialogue: 0,0:14:21.29,0:14:24.80,Default,,0,0,0,,Қалай болғанда да, бұл бір жеңіс.
Dialogue: 0,0:14:21.29,0:14:24.80,Default,,0,0,0,,Өзіңіз шешіңіз.
Dialogue: 0,0:14:24.80,0:14:28.47,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:14:24.80,0:14:28.47,Default,,0,0,0,,Иә
Dialogue: 0,0:14:28.47,0:14:31.47,Default,,0,0,0,,Айтпақшы, әпке
Dialogue: 0,0:14:28.47,0:14:31.47,Default,,0,0,0,,Менің трикотажым ше?
Dialogue: 0,0:14:31.47,0:14:34.81,Default,,0,0,0,,Менің үйімде бар.
Dialogue: 0,0:14:31.47,0:14:34.81,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:34.81,0:14:37.48,Default,,0,0,0,,Мен сенімді емеспін.
Dialogue: 0,0:14:37.48,0:14:40.65,Default,,0,0,0,,Котегава мырза, теннис ше?
Dialogue: 0,0:14:37.48,0:14:40.65,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:14:40.65,0:14:45.82,Default,,0,0,0,,О, сен Мифконнансың.
Dialogue: 0,0:14:40.65,0:14:45.82,Default,,0,0,0,,Ах, Мифкон бойынша 2 орын
Dialogue: 0,0:14:45.82,0:14:49.66,Default,,0,0,0,,Юбка тігу сайысында жеңіске жетті
Dialogue: 0,0:14:45.82,0:14:49.66,Default,,0,0,0,,Котегава мырза емес
Dialogue: 0,0:14:49.66,0:14:53.49,Default,,0,0,0,,Бұл жолы өте өкінішті
Dialogue: 0,0:14:49.66,0:14:53.49,Default,,0,0,0,,Сізге ұнамайтын адаммен
Dialogue: 0,0:14:53.49,0:14:58.10,Default,,0,0,0,,Бүгін, ең көп дегенде, бұл галерея.
Dialogue: 0,0:14:53.49,0:14:58.10,Default,,0,0,0,,Махаббат пен анонимділікке себіңіз.
Dialogue: 0,0:14:58.10,0:15:01.94,Default,,0,0,0,,Хахахаха...!
Dialogue: 0,0:14:58.10,0:15:01.94,Default,,0,0,0,,Котегава мырза...
Dialogue: 0,0:15:01.94,0:15:03.94,Default,,0,0,0,,Ойын ойнау!
Бұрынғыдай емес,
Dialogue: 0,0:15:08.27,0:15:12.28,Default,,0,0,0,,~ өтіңіз
Dialogue: 0,0:15:08.27,0:15:12.28,Default,,0,0,0,,Бұл дұрыс сәйкестік.
Dialogue: 0,0:15:12.28,0:15:14.95,Default,,0,0,0,,Дөрекі!
Dialogue: 0,0:15:12.28,0:15:14.95,Default,,0,0,0,,Біз де дұрыс жасадық!
Dialogue: 0,0:15:14.95,0:15:20.12,Default,,0,0,0,,Иә, жарайды, су ішіңіз.
Dialogue: 0,0:15:14.95,0:15:20.12,Default,,0,0,0,,Екеуіңізге сәттілік!
Dialogue: 0,0:15:20.12,0:15:22.29,Default,,0,0,0,,Чисаның бірі
Dialogue: 0,0:15:20.12,0:15:22.29,Default,,0,0,0,,Сіз біртүрлі ынталысыз.
Dialogue: 0,0:15:22.29,0:15:25.46,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:15:22.29,0:15:25.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:25.46,0:15:27.63,Default,,0,0,0,,Һм!
Dialogue: 0,0:15:27.63,0:15:30.63,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:15:27.63,0:15:30.63,Default,,0,0,0,,Бұл тамаша мұқаба болды.
Dialogue: 0,0:15:30.63,0:15:33.97,Default,,0,0,0,,Екеуінің достық қарым-қатынасы жақсы.
Dialogue: 0,0:15:30.63,0:15:33.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:33.97,0:15:37.47,Default,,0,0,0,,Қане, дауыстап айтайық.
Dialogue: 0,0:15:33.97,0:15:37.47,Default,,0,0,0,,Маған еріңіз
Dialogue: 0,0:15:37.47,0:15:40.64,Default,,0,0,0,,Чиса~ Керемет дос!
Dialogue: 0,0:15:37.47,0:15:40.64,Default,,0,0,0,,Жақсы жаман Котегава!
Dialogue: 0,0:15:40.64,0:15:44.48,Default,,0,0,0,,Керемет дене, Чи Чан!
Dialogue: 0,0:15:40.64,0:15:44.48,Default,,0,0,0,,Чиса-чан өте жақсы!
Dialogue: 0,0:15:44.48,0:15:46.65,Default,,0,0,0,,Әй, міне, керемет стильді қыз бар.
Dialogue: 0,0:15:44.48,0:15:46.65,Default,,0,0,0,,Олар ойын ойнап жатқан сияқты.
Dialogue: 0,0:15:46.65,0:15:48.65,Default,,0,0,0,,Шынымен, бұл қай бала?
Dialogue: 0,0:15:48.65,0:15:51.48,Default,,0,0,0,,Чиса! Чиса! Чиса! Жақсы дос!
Dialogue: 0,0:15:51.48,0:15:53.82,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:15:53.82,0:15:57.26,Default,,0,0,0,,Стратегияны өзгерту, ең алдымен.
Dialogue: 0,0:15:53.82,0:15:57.26,Default,,0,0,0,,Жап-жақсысын жаншып аламын
Dialogue: 0,0:15:57.26,0:16:00.56,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:15:57.26,0:16:00.56,Default,,0,0,0,,Ойын саны 2-0!
Dialogue: 0,0:16:02.60,0:16:05.10,Default,,0,0,0,,Һм!
Dialogue: 0,0:16:02.60,0:16:05.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:05.10,0:16:07.10,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:16:07.10,0:16:09.10,Default,,0,0,0,,Эй, эй, бұл қауіпті!
Dialogue: 0,0:16:09.10,0:16:12.44,Default,,0,0,0,,Бұл денеге бағытталған.
Dialogue: 0,0:16:09.10,0:16:12.44,Default,,0,0,0,,Денені көздеу?
Dialogue: 0,0:16:12.44,0:16:15.78,Default,,0,0,0,,Басқа адамның денесін тікелей көздеу
Dialogue: 0,0:16:12.44,0:16:15.78,Default,,0,0,0,,Бұл соққы беру стратегиясы.
Dialogue: 0,0:16:15.78,0:16:17.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:17.78,0:16:19.95,Default,,0,0,0,,Һм!
Dialogue: 0,0:16:17.78,0:16:19.95,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:19.95,0:16:22.12,Default,,0,0,0,,О~ Котегавадан келген
Dialogue: 0,0:16:19.95,0:16:22.12,Default,,0,0,0,,Мен оны қайтардым.
Dialogue: 0,0:16:22.12,0:16:25.79,Default,,0,0,0,,Бұл да денеге бағытталған, солай емес пе?
Dialogue: 0,0:16:22.12,0:16:25.79,Default,,0,0,0,,Бұл жақсы мақсат болды.
Dialogue: 0,0:16:25.79,0:16:28.12,Default,,0,0,0,,Түсіндім, сонда...
Dialogue: 0,0:16:28.12,0:16:30.79,Default,,0,0,0,,Чиса жақсы дене!
Dialogue: 0,0:16:28.12,0:16:30.79,Default,,0,0,0,,Керемет дене Котегава!
Dialogue: 0,0:16:30.79,0:16:33.29,Default,,0,0,0,,Чиса-чан, ең әдемі дене!
Dialogue: 0,0:16:33.29,0:16:35.30,Default,,0,0,0,,Бұл қай бала?
Dialogue: 0,0:16:35.30,0:16:37.46,Default,,0,0,0,,Шынымен, қазірдің өзінде тоқтатыңыз!
Dialogue: 0,0:16:37.46,0:16:41.30,Default,,0,0,0,,Қош бол Тинкер Белл!
Dialogue: 0,0:16:37.46,0:16:41.30,Default,,0,0,0,,(ысқырық)
Dialogue: 0,0:16:41.30,0:16:43.30,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:16:43.30,0:16:47.81,Default,,0,0,0,,Не болды? Чиса. Ортасынан
Dialogue: 0,0:16:43.30,0:16:47.81,Default,,0,0,0,,Киімнің етегінен ғана ұстаңыз...
Dialogue: 0,0:16:47.81,0:16:51.81,Default,,0,0,0,,Ал, үшінші ойын.
Dialogue: 0,0:16:47.81,0:16:51.81,Default,,0,0,0,,Мен бастағым келеді...
Dialogue: 0,0:16:51.81,0:16:54.31,Default,,0,0,0,,Сен сонда жақсысың ба?
Dialogue: 0,0:16:54.31,0:16:57.42,Default,,0,0,0,,Сен ше, Джордж?
Dialogue: 0,0:16:54.31,0:16:57.42,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:16:57.42,0:17:00.82,Default,,0,0,0,,Бұл жігіттің жалаңаш денесі біркелкі пішінге ұқсайды
Dialogue: 0,0:16:57.42,0:17:00.82,Default,,0,0,0,,Өйткені ол ер адам
Dialogue: 0,0:17:04.42,0:17:06.76,Default,,0,0,0,,Бір кезде не болар екен деп ойладым, бірақ➡︎
Dialogue: 0,0:17:06.76,0:17:10.06,Default,,0,0,0,,Мына балалар
Dialogue: 0,0:17:06.76,0:17:10.06,Default,,0,0,0,,Оны мүмкіндігінше аянышты түрде жеңіңіз ...
Dialogue: 0,0:17:14.10,0:17:16.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:14.10,0:17:16.94,Default,,0,0,0,,15-0!
Dialogue: 0,0:17:16.94,0:17:19.34,Default,,0,0,0,,Келесі жолы барайық.
Dialogue: 0,0:17:21.27,0:17:24.78,Default,,0,0,0,,Аһ!
Dialogue: 0,0:17:24.78,0:17:26.78,Default,,0,0,0,,30-0!
Dialogue: 0,0:17:26.78,0:17:29.45,Default,,0,0,0,,Иори спортта жақсы болды, солай ма?
Dialogue: 0,0:17:29.45,0:17:32.62,Default,,0,0,0,,Дұрыс, әлгі жігіт.
Dialogue: 0,0:17:29.45,0:17:32.62,Default,,0,0,0,,Ол кезде де басқару элементтері жақсы болатын.
Dialogue: 0,0:17:32.62,0:17:36.46,Default,,0,0,0,,Ах~ Чиса-чандікі
Dialogue: 0,0:17:32.62,0:17:36.46,Default,,0,0,0,,Сіз юбкаңызды қай кезде көтердіңіз?
Dialogue: 0,0:17:36.46,0:17:39.96,Default,,0,0,0,,Сіз...
Dialogue: 0,0:17:36.46,0:17:39.96,Default,,0,0,0,,Оны маған жүзуден басқа нәрсеге қалдырыңыз.
Dialogue: 0,0:17:39.96,0:17:42.30,Default,,0,0,0,,Ku~
Dialogue: 0,0:17:39.96,0:17:42.30,Default,,0,0,0,,Сол іс пе? (Каэбуки) Кэро?
Dialogue: 0,0:17:42.30,0:17:44.63,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:17:42.30,0:17:44.63,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:17:44.63,0:17:46.63,Default,,0,0,0,,Өте тәтті!
Dialogue: 0,0:17:46.63,0:17:48.80,Default,,0,0,0,,Кохеи!
Dialogue: 0,0:17:46.63,0:17:48.80,Default,,0,0,0,,О!
Dialogue: 0,0:17:48.80,0:17:50.90,Default,,0,0,0,,О!
Dialogue: 0,0:17:58.91,0:18:00.91,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:00.91,0:18:06.25,Default,,0,0,0,,Китахара: Олар көп нәрсе жасайды!
Dialogue: 0,0:18:00.91,0:18:06.25,Default,,0,0,0,,Сіз мұны тым көп жасамайсыз.
Dialogue: 0,0:18:06.25,0:18:09.76,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:18:06.25,0:18:09.76,Default,,0,0,0,,Тей!
Dialogue: 0,0:18:09.76,0:18:11.86,Default,,0,0,0,,Һм!
Dialogue: 0,0:18:09.76,0:18:11.86,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:18:17.26,0:18:19.43,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:18:19.43,0:18:22.10,Default,,0,0,0,,Ойын саны 4-0!
Dialogue: 0,0:18:22.10,0:18:26.94,Default,,0,0,0,,Жаман... Біздің күш...
Dialogue: 0,0:18:22.10,0:18:26.94,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:18:26.94,0:18:29.44,Default,,0,0,0,,Нені түсінбейді?
Dialogue: 0,0:18:26.94,0:18:29.44,Default,,0,0,0,,Тек сен
Dialogue: 0,0:18:29.44,0:18:34.45,Default,,0,0,0,,А, иә, мен оны айтуды ұмытып кетіппін.
Dialogue: 0,0:18:29.44,0:18:34.45,Default,,0,0,0,,Менің шеңберім...
Dialogue: 0,0:18:34.45,0:18:38.12,Default,,0,0,0,,Ұрпақ үшін
Dialogue: 0,0:18:34.45,0:18:38.12,Default,,0,0,0,,Мен матчты түсіріп жатырмын.
Dialogue: 0,0:18:38.12,0:18:41.45,Default,,0,0,0,,Не?!
Dialogue: 0,0:18:38.12,0:18:41.45,Default,,0,0,0,,Олай болса, балалар!
Dialogue: 0,0:18:41.45,0:18:43.96,Default,,0,0,0,,Қаншалықты жеңілгенімізді көрсетіңіз
Dialogue: 0,0:18:41.45,0:18:43.96,Default,,0,0,0,,Сіз күлуге тырысып жатырсыз!
Dialogue: 0,0:18:43.96,0:18:45.96,Default,,0,0,0,,Жоқ, бұл жеңілген.
Dialogue: 0,0:18:45.96,0:18:49.13,Default,,0,0,0,,Сен осылай киінгенде
Dialogue: 0,0:18:45.96,0:18:49.13,Default,,0,0,0,,Ашық адам, солай ма?
Dialogue: 0,0:18:49.13,0:18:51.63,Default,,0,0,0,,Кохеи Егер бұл орын алса...
Dialogue: 0,0:18:51.63,0:18:56.24,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:18:51.63,0:18:56.24,Default,,0,0,0,,Бізге тек...
Dialogue: 0,0:18:56.24,0:18:58.74,Default,,0,0,0,,Тек КО
Dialogue: 0,0:18:58.74,0:19:01.57,Default,,0,0,0,,Балалар
Dialogue: 0,0:18:58.74,0:19:01.57,Default,,0,0,0,,Сіз алаңдататын нәрсе туралы ойлайсыз ба?
Dialogue: 0,0:19:01.57,0:19:05.75,Default,,0,0,0,,Хахаха... Мен бұған сенбеймін...
Dialogue: 0,0:19:05.75,0:19:08.08,Default,,0,0,0,,Өл!
Dialogue: 0,0:19:08.08,0:19:10.08,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:10.08,0:19:12.09,Default,,0,0,0,,Бұл не деген айқай?
Dialogue: 0,0:19:12.09,0:19:16.26,Default,,0,0,0,,Жақсы Китахара, жақсы қызмет!
Dialogue: 0,0:19:12.09,0:19:16.26,Default,,0,0,0,,Енді дәл баптау ғана қалды...
Dialogue: 0,0:19:16.26,0:19:18.26,Default,,0,0,0,,Әдемі ас қайда!
Dialogue: 0,0:19:18.26,0:19:22.10,Default,,0,0,0,,Сіз Нованмен бірге дуалға соқтыңыз!
Dialogue: 0,0:19:18.26,0:19:22.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:22.10,0:19:24.26,Default,,0,0,0,,Бұл оңай-ақ болар, иә? Хех, хе-хех, хе
Dialogue: 0,0:19:22.10,0:19:24.26,Default,,0,0,0,,Жалтарма, қорқақ!
Dialogue: 0,0:19:24.26,0:19:26.26,Default,,0,0,0,,Қайсысы қорқақ?
Dialogue: 0,0:19:28.27,0:19:32.11,Default,,0,0,0,,Сақ болыңыз, тек одан аулақ болыңыз
Dialogue: 0,0:19:28.27,0:19:32.11,Default,,0,0,0,,Бұл менің ұпайым болады.
Dialogue: 0,0:19:32.11,0:19:34.61,Default,,0,0,0,,О, мен білемін...
Dialogue: 0,0:19:37.78,0:19:41.11,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:19:41.11,0:19:45.45,Default,,0,0,0,,Аһ!
Dialogue: 0,0:19:45.45,0:19:48.29,Default,,0,0,0,,Мен сақтықты түсіре алмаймын.
Dialogue: 0,0:19:45.45,0:19:48.29,Default,,0,0,0,,Төраға!
Dialogue: 0,0:19:48.29,0:19:50.96,Default,,0,0,0,,Бұл тығырыққа тірелген шығар.
Dialogue: 0,0:19:48.29,0:19:50.96,Default,,0,0,0,,Әдемі жеңілу...
Dialogue: 0,0:19:50.96,0:19:52.96,Default,,0,0,0,,Бұл сұмдық!
Dialogue: 0,0:19:52.96,0:19:55.80,Default,,0,0,0,,Не жігіт, не камера
Dialogue: 0,0:19:52.96,0:19:55.80,Default,,0,0,0,,Ойлан!
Dialogue: 0,0:19:55.80,0:19:59.13,Default,,0,0,0,,Бұл шынымен ұнайды
Dialogue: 0,0:19:55.80,0:19:59.13,Default,,0,0,0,,Онымен айналысу қажет болды ма?
Dialogue: 0,0:19:59.13,0:20:03.14,Default,,0,0,0,,Бұлай болса, бәрі де болады, сен оған шеберсің
Dialogue: 0,0:19:59.13,0:20:03.14,Default,,0,0,0,,Кір қолыңмен жақсылық жаса!
Dialogue: 0,0:20:03.14,0:20:07.47,Default,,0,0,0,,Маған неге сонша көп айту керек болды?
Dialogue: 0,0:20:03.14,0:20:07.47,Default,,0,0,0,,Жоқ! иә?
Dialogue: 0,0:20:07.47,0:20:11.98,Default,,0,0,0,,Кез келген қозғалысты қолдануға бола ма?
Dialogue: 0,0:20:07.47,0:20:11.98,Default,,0,0,0,,Әрине.
Dialogue: 0,0:20:11.98,0:20:13.98,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:13.98,0:20:16.15,Default,,0,0,0,,Өрттен кейінгі жөндеу жұмыстары мен қайта жаңартуға арналған сметаға байланысты келдім.
Dialogue: 0,0:20:13.98,0:20:16.15,Default,,0,0,0,,КО.
Dialogue: 0,0:20:16.15,0:20:20.15,Default,,0,0,0,,Жарайды, бұл Китахара!
Dialogue: 0,0:20:20.15,0:20:22.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:30.16,0:20:32.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:32.17,0:20:36.34,Default,,0,0,0,,Соғу
Dialogue: 0,0:20:32.17,0:20:36.34,Default,,0,0,0,,Уа, не айтып тұрсың?
Dialogue: 0,0:20:36.34,0:20:39.51,Default,,0,0,0,,Жоқ, күтпеген оқиғаға байланысты.
Dialogue: 0,0:20:36.34,0:20:39.51,Default,,0,0,0,,Бос орын бар, сондықтан➡︎
Dialogue: 0,0:20:39.51,0:20:42.01,Default,,0,0,0,,Мүшелерді ауыстырған дұрыс емес пе?
Dialogue: 0,0:20:42.01,0:20:45.71,Default,,0,0,0,,Ой, сіздің кезегіңіз.
Dialogue: 0,0:20:42.01,0:20:45.71,Default,,0,0,0,,Мен де бара аламын.
Dialogue: 0,0:20:47.85,0:20:50.68,Default,,0,0,0,,Гах!
Dialogue: 0,0:20:50.68,0:20:54.35,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:20:54.35,0:20:56.62,Default,,0,0,0,,Не істеп жатырсың, бейбақ?
Dialogue: 0,0:20:56.62,0:20:59.29,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені жасай аласыз.
Dialogue: 0,0:20:56.62,0:20:59.29,Default,,0,0,0,,Мен айттым ғой!
Dialogue: 0,0:20:59.29,0:21:01.29,Default,,0,0,0,,Бұл жігіттерге қарсы!
Dialogue: 0,0:21:01.29,0:21:03.46,Default,,0,0,0,,Оның спорттық шеберлігі жоқ...
Dialogue: 0,0:21:03.46,0:21:05.80,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:21:03.46,0:21:05.80,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:21:05.80,0:21:08.80,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:21:05.80,0:21:08.80,Default,,0,0,0,,Иори теннисте жақсы болды.
Dialogue: 0,0:21:08.80,0:21:10.80,Default,,0,0,0,,Сіз мұны орта мектепте жасадыңыз ба?
Dialogue: 0,0:21:10.80,0:21:14.31,Default,,0,0,0,,Емтихан аяқталғаннан кейін.
Dialogue: 0,0:21:10.80,0:21:14.31,Default,,0,0,0,,Бұл үйірме жұмысы емес пе?
Dialogue: 0,0:21:14.31,0:21:18.81,Default,,0,0,0,,Жоқ... Колледжде қызды қалай алуға болады
Dialogue: 0,0:21:14.31,0:21:18.81,Default,,0,0,0,,Мен теннис ең жақсы деп естідім➡︎
Dialogue: 0,0:21:18.81,0:21:20.81,Default,,0,0,0,,Достармен арнайы дайындық
Dialogue: 0,0:21:20.81,0:21:23.32,Default,,0,0,0,,Бұл таяз.
Dialogue: 0,0:21:20.81,0:21:23.32,Default,,0,0,0,,Идея қарапайым
Dialogue: 0,0:21:23.32,0:21:26.65,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,0:21:23.32,0:21:26.65,Default,,0,0,0,,Қанша жаттығып жүрсем де➡︎
Dialogue: 0,0:21:26.65,0:21:28.65,Default,,0,0,0,,Мен теннис командасына қосылғым келмейді.
Dialogue: 0,0:21:28.65,0:21:32.16,Default,,0,0,0,,Жақсы ештеңе жоқ
Dialogue: 0,0:21:28.65,0:21:32.16,Default,,0,0,0,,Таңдау болған жоқ.
Dialogue: 0,0:21:32.16,0:21:35.83,Default,,0,0,0,,Бұл өте өкінішті
Dialogue: 0,0:21:32.16,0:21:35.83,Default,,0,0,0,,Иориге де қиналып жатыр.
Dialogue: 0,0:21:35.83,0:21:38.66,Default,,0,0,0,,Сіздің естеліктеріңіз
Dialogue: 0,0:21:35.83,0:21:38.66,Default,,0,0,0,,Мен осы дәптерге деген меншік құқығымнан бас тартамын…
Dialogue: 0,0:21:38.66,0:21:41.33,Default,,0,0,0,,Шие… Бұл Хассаикай ма еді?
Dialogue: 0,0:21:38.66,0:21:41.33,Default,,0,0,0,,Теннис қазір жақсы.
Dialogue: 0,0:21:41.33,0:21:43.34,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:41.33,0:21:43.34,Default,,0,0,0,,Енді тағы бір нәрсе бар➡︎
Dialogue: 0,0:21:43.34,0:21:45.51,Default,,0,0,0,,Мен не істегім келеді
Dialogue: 0,0:21:43.34,0:21:45.51,Default,,0,0,0,,Себебі орындалды
Dialogue: 0,0:21:45.51,0:21:48.51,Default,,0,0,0,,Көңілді
Dialogue: 0,0:21:45.51,0:21:48.51,Default,,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:21:52.18,0:21:55.28,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:21:52.18,0:21:55.28,Default,,0,0,0,,Мен өлсем бола ма?
Dialogue: 0,0:21:55.28,0:21:58.45,Default,,0,0,0,,Сонымен
Dialogue: 0,0:21:55.28,0:21:58.45,Default,,0,0,0,,Мен де ақшалай сыйлық алдым➡︎
Dialogue: 0,0:21:58.45,0:22:02.29,Default,,0,0,0,,Мен оқу-жаттығу жиынын өткізуді ойлап жүрмін.
Dialogue: 0,0:21:58.45,0:22:02.29,Default,,0,0,0,,Орналасқан жері - Окинава!
Dialogue: 0,0:22:02.29,0:22:04.96,Default,,0,0,0,,Окинава!
Dialogue: 0,0:22:02.29,0:22:04.96,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:22:04.96,0:22:08.29,Default,,0,0,0,,О? Бұл...
Dialogue: 0,0:22:08.29,0:22:11.30,Default,,0,0,0,,《Біз қарап отырған Окинава журналы...
Dialogue: 0,0:22:11.30,0:22:15.30,Default,,0,0,0,,Мүмкін, аға, біз үшін》
Dialogue: 0,0:22:15.30,0:22:18.97,Default,,0,0,0,,Окинава керемет
Dialogue: 0,0:22:15.30,0:22:18.97,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:22:18.97,0:22:25.37,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:22:26.87,0:22:32.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
