Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.28,0:01:34.28,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:01:34.28,0:01:38.08,Default,,0,0,0,,Жоқ, бұл бала ашулы болды.
Dialogue: 0,0:01:34.28,0:01:38.08,Default,,0,0,0,,Оны нағыз қатты жігіт деп атайсың.
Dialogue: 0,0:01:42.13,0:01:44.29,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:01:44.29,0:01:46.30,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:01:46.30,0:01:49.13,Default,,0,0,0,,Неліктен Миджинмо?
Dialogue: 0,0:01:46.30,0:01:49.13,Default,,0,0,0,,Менде кінә жоқ...
Dialogue: 0,0:01:49.13,0:01:53.14,Default,,0,0,0,,Сізге және сіздің достарыңызға бақыт тілеймін.
Dialogue: 0,0:01:49.13,0:01:53.14,Default,,0,0,0,,Сенде мейірімділік жоқ па?
Dialogue: 0,0:01:53.14,0:01:56.07,Default,,0,0,0,,Сөз
Dialogue: 0,0:01:53.14,0:01:56.07,Default,,0,0,0,,Мен оны толығымен сізге қайтарамын.
Dialogue: 0,0:01:56.07,0:02:00.08,Default,,0,0,0,,Мен оған да мән бермеймін.
Dialogue: 0,0:01:56.07,0:02:00.08,Default,,0,0,0,,Мен үлгерме демеймін.
Dialogue: 0,0:02:00.08,0:02:02.58,Default,,0,0,0,,Хо…
Dialogue: 0,0:02:00.08,0:02:02.58,Default,,0,0,0,,Жай➡︎
Dialogue: 0,0:02:02.58,0:02:06.75,Default,,0,0,0,,Егер қызды қаласаң, өлуге дайын бол.
Dialogue: 0,0:02:02.58,0:02:06.75,Default,,0,0,0,,Мен жай айтып тұрмын
Dialogue: 0,0:02:06.75,0:02:10.92,Default,,0,0,0,,Әй, мен жақсы нәрсе айтайын.
Dialogue: 0,0:02:06.75,0:02:10.92,Default,,0,0,0,,Біз ең жақсы достармыз.
Dialogue: 0,0:02:10.92,0:02:14.76,Default,,0,0,0,,Мына балалар жынды екен.
Dialogue: 0,0:02:10.92,0:02:14.76,Default,,0,0,0,,Олар туысқан рухтар.
Dialogue: 0,0:02:14.76,0:02:20.76,Default,,0,0,0,,Сосын... сосын біз...
Dialogue: 0,0:02:14.76,0:02:20.76,Default,,0,0,0,,Мен қашан қыз аламын?
Dialogue: 0,0:02:20.76,0:02:22.77,Default,,0,0,0,,Менен сұрасаңыз...
Dialogue: 0,0:02:22.77,0:02:25.44,Default,,0,0,0,,Жасырын қимылға кедергі жасау
Dialogue: 0,0:02:22.77,0:02:25.44,Default,,0,0,0,,Тым көп еңкею...
Dialogue: 0,0:02:25.44,0:02:29.11,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:02:25.44,0:02:29.11,Default,,0,0,0,,Вирлпул Риппл Овердрайв!
Dialogue: 0,0:02:29.11,0:02:32.28,Default,,0,0,0,,Бұны бұрын бір ақымақ айтқан.
Dialogue: 0,0:02:32.28,0:02:35.95,Default,,0,0,0,,((Егер біреу дос болса
Dialogue: 0,0:02:32.28,0:02:35.95,Default,,0,0,0,,Сіз қайтадан соқыр кездесуді ұйымдастыра аласыз! ))
Dialogue: 0,0:02:35.95,0:02:38.78,Default,,0,0,0,,Эй, сенің қолыңнан келеді~
Dialogue: 0,0:02:35.95,0:02:38.78,Default,,0,0,0,,Менің қызым бар!
Dialogue: 0,0:02:38.78,0:02:42.29,Default,,0,0,0,,Күте тұрыңыз, күтіңіз, күтіңіз!
Dialogue: 0,0:02:38.78,0:02:42.29,Default,,0,0,0,,Сіз бұрын ортақ кездесу ұйымдастырдыңыз!
Dialogue: 0,0:02:42.29,0:02:44.29,Default,,0,0,0,,Сіз оны бірнеше рет біріктіре аласыз ба?
Dialogue: 0,0:02:44.29,0:02:46.29,Default,,0,0,0,,бір адамға 5000 иен
Dialogue: 0,0:02:46.29,0:02:51.13,Default,,0,0,0,,Дос бақыты үшін
Dialogue: 0,0:02:46.29,0:02:51.13,Default,,0,0,0,,Маған киімімді шешуге рұқсат етіңіз!
Dialogue: 0,0:02:51.13,0:02:54.30,Default,,0,0,0,,Мұны қалай жасауға болады?
Dialogue: 0,0:02:51.13,0:02:54.30,Default,,0,0,0,,Чиса келіседі деп ойлайсың ба?
Dialogue: 0,0:02:54.30,0:02:56.40,Default,,0,0,0,,Білесің бе, маған бәрібір.
Dialogue: 0,0:02:56.40,0:03:00.24,Default,,0,0,0,,Мен онымен бөлісемін.
Dialogue: 0,0:02:56.40,0:03:00.24,Default,,0,0,0,,Оны жазалау ойыны деп көрсетсек ше?
Dialogue: 0,0:03:00.24,0:03:04.41,Default,,0,0,0,,А, түсіндім.
Dialogue: 0,0:03:00.24,0:03:04.41,Default,,0,0,0,,Бұл Король ойынының айналасында ма?
Dialogue: 0,0:03:04.41,0:03:06.41,Default,,0,0,0,,Соның төңірегінде болса керек. Мәселе ➡︎
Dialogue: 0,0:03:06.41,0:03:09.58,Default,,0,0,0,,Котегава өзені ше?
Dialogue: 0,0:03:06.41,0:03:09.58,Default,,0,0,0,,Патша ойынына сүйреп апаратын сал
Dialogue: 0,0:03:09.58,0:03:12.28,Default,,0,0,0,,Ал, мен бұл бөлімді жақсы орындаймын.
Dialogue: 0,0:03:24.43,0:03:26.76,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:03:24.43,0:03:26.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:26.76,0:03:29.60,Default,,0,0,0,,Бұл туралы не ойлайсыз?
Dialogue: 0,0:03:26.76,0:03:29.60,Default,,0,0,0,,Сашими?
Dialogue: 0,0:03:29.60,0:03:34.27,Default,,0,0,0,,Иори төрелік етті ме?
Dialogue: 0,0:03:29.60,0:03:34.27,Default,,0,0,0,,А, мен дәм татсам болады ма?
Dialogue: 0,0:03:34.27,0:03:38.27,Default,,0,0,0,,Иә
Dialogue: 0,0:03:34.27,0:03:38.27,Default,,0,0,0,,Иори балықты ұстай алады.
Dialogue: 0,0:03:40.94,0:03:44.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:40.94,0:03:44.78,Default,,0,0,0,,Король ойыны!
Dialogue: 0,0:03:44.78,0:03:49.29,Default,,0,0,0,,Меніңше, Каэдэге де уақыт келген сияқты
Dialogue: 0,0:03:44.78,0:03:49.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:49.29,0:03:52.29,Default,,0,0,0,,Енді, бәрің, тартыңдар!
Dialogue: 0,0:03:52.29,0:03:54.96,Default,,0,0,0,,Се-жоқ...
Dialogue: 0,0:03:52.29,0:03:54.96,Default,,0,0,0,,Патша!
Dialogue: 0,0:03:54.96,0:03:56.89,Default,,0,0,0,,Иә, тоқта!
Dialogue: 0,0:03:56.89,0:03:59.23,Default,,0,0,0,,Не болды? Кебако
Dialogue: 0,0:03:56.89,0:03:59.23,Default,,0,0,0,,Неліктен тоқтау керек? Кебако
Dialogue: 0,0:03:59.23,0:04:02.23,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:03:59.23,0:04:02.23,Default,,0,0,0,,Жоқ, Айна
Dialogue: 0,0:04:02.23,0:04:04.23,Default,,0,0,0,,Жеребеден кейін
Dialogue: 0,0:04:02.23,0:04:04.23,Default,,0,0,0,,Қатысу керек
Dialogue: 0,0:04:04.23,0:04:07.24,Default,,0,0,0,,Мұны сашими үшін пайдалануға болады.
Dialogue: 0,0:04:04.23,0:04:07.24,Default,,0,0,0,,Оны маған берді...
Dialogue: 0,0:04:07.24,0:04:09.24,Default,,0,0,0,,Не айту керек
Dialogue: 0,0:04:09.24,0:04:12.24,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:04:09.24,0:04:12.24,Default,,0,0,0,,Китахараның айтқанын есіңе түсір
Dialogue: 0,0:04:12.24,0:04:14.91,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:14.91,0:04:17.91,Default,,0,0,0,,Сашими дегеніміз не?
Dialogue: 0,0:04:14.91,0:04:17.91,Default,,0,0,0,,Мен бұлай айтқан емеспін!
Dialogue: 0,0:04:17.91,0:04:19.92,Default,,0,0,0,,Жексұрын!
Dialogue: 0,0:04:19.92,0:04:22.25,Default,,0,0,0,,Жарайды, бұлай тартынба.
Dialogue: 0,0:04:19.92,0:04:22.25,Default,,0,0,0,,Эй?
Dialogue: 0,0:04:22.25,0:04:26.26,Default,,0,0,0,,Бір рет көріп, ұнамаса
Dialogue: 0,0:04:22.25,0:04:26.26,Default,,0,0,0,,Сіз тоқтай аласыз.
Dialogue: 0,0:04:26.26,0:04:30.59,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:04:26.26,0:04:30.59,Default,,0,0,0,,Күрсін... бір рет қана.
Dialogue: 0,0:04:30.59,0:04:36.93,Default,,0,0,0,,Жарайды, сосын тағы...
Dialogue: 0,0:04:30.59,0:04:36.93,Default,,0,0,0,,Бұл патша!
Dialogue: 0,0:04:36.93,0:04:39.94,Default,,0,0,0,,Уууу, бұл менмін.
Dialogue: 0,0:04:39.94,0:04:43.11,Default,,0,0,0,,Сонымен пәрмен...
Dialogue: 0,0:04:39.94,0:04:43.11,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:43.11,0:04:47.61,Default,,0,0,0,,Сонда менен басқаның бәрі...
Dialogue: 0,0:04:47.61,0:04:51.62,Default,,0,0,0,,Осы ойынды соңына дейін ұстаныңыз!
Dialogue: 0,0:04:47.61,0:04:51.62,Default,,0,0,0,,Мен жеңілдім...
Dialogue: 0,0:04:51.62,0:04:53.95,Default,,0,0,0,,Неге сонша?
Dialogue: 0,0:04:51.62,0:04:53.95,Default,,0,0,0,,Менің қатысуымды қалайсыз!
Dialogue: 0,0:04:53.95,0:04:56.22,Default,,0,0,0,,Мен неге таң қалдым~
Dialogue: 0,0:04:56.22,0:04:59.72,Default,,0,0,0,,Патшаның бұйрықтары абсолютті.
Dialogue: 0,0:04:56.22,0:04:59.72,Default,,0,0,0,,Чиса-чан
Dialogue: 0,0:04:59.72,0:05:01.73,Default,,0,0,0,,Тіпті сіздің әпкеңіз де...
Dialogue: 0,0:05:01.73,0:05:05.53,Default,,0,0,0,,《Сен ақымақ...
Dialogue: 0,0:05:01.73,0:05:05.53,Default,,0,0,0,,Бұл екеуі сатып алынды! 》
Dialogue: 0,0:05:08.23,0:05:10.73,Default,,0,0,0,,Бұл патшаның ойыны ма...
Dialogue: 0,0:05:08.23,0:05:10.73,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:05:10.73,0:05:12.74,Default,,0,0,0,,Сіз қалай ойлайсыз...
Dialogue: 0,0:05:12.74,0:05:15.41,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:05:12.74,0:05:15.41,Default,,0,0,0,,Мен де
Dialogue: 0,0:05:15.41,0:05:17.41,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:05:17.41,0:05:20.41,Default,,0,0,0,,Ахахха! Бұл біртүрлі
Dialogue: 0,0:05:17.41,0:05:20.41,Default,,0,0,0,,Неге таң қалдыңыз?
Dialogue: 0,0:05:20.41,0:05:23.91,Default,,0,0,0,,Жоқ, сөзсіз
Dialogue: 0,0:05:20.41,0:05:23.91,Default,,0,0,0,,Мені үнемі қабылдамады...
Dialogue: 0,0:05:29.09,0:05:32.76,Default,,0,0,0,,《Өкінішке орай
Dialogue: 0,0:05:29.09,0:05:32.76,Default,,0,0,0,,Бұл болмайды...》
Dialogue: 0,0:05:32.76,0:05:34.76,Default,,0,0,0,,Хэхехехе...
Dialogue: 0,0:05:34.76,0:05:36.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:34.76,0:05:36.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:36.76,0:05:39.10,Default,,0,0,0,,Олай болса, екінші турға өтейік!
Dialogue: 0,0:05:39.10,0:05:41.43,Default,,0,0,0,,Бұл патша!
Dialogue: 0,0:05:41.43,0:05:44.77,Default,,0,0,0,,Иә, бұл қайтадан менмін.
Dialogue: 0,0:05:41.43,0:05:44.77,Default,,0,0,0,,Ол үздіксіз бе?
Dialogue: 0,0:05:44.77,0:05:48.61,Default,,0,0,0,,Тарту күшті.
Dialogue: 0,0:05:44.77,0:05:48.61,Default,,0,0,0,,Сонымен бұйрықтар қандай?
Dialogue: 0,0:05:48.61,0:05:53.78,Default,,0,0,0,,1-ден 7-ге дейін нөмірленген адамдар бір бөлікті шешуі керек.
Dialogue: 0,0:05:53.78,0:05:56.88,Default,,0,0,0,,Usu!
Dialogue: 0,0:05:53.78,0:05:56.88,Default,,0,0,0,,Киіміңді тез шешіп алдың!
Dialogue: 0,0:05:56.88,0:06:00.22,Default,,0,0,0,,Келіңіздер, келіңіздер
Dialogue: 0,0:05:56.88,0:06:00.22,Default,,0,0,0,,Нанака, киіміңді де шеш! Киіміңді шеш!
Dialogue: 0,0:06:00.22,0:06:04.22,Default,,0,0,0,,Мм... сонда...
Dialogue: 0,0:06:04.22,0:06:06.39,Default,,0,0,0,,♬~
Dialogue: 0,0:06:04.22,0:06:06.39,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:06:06.39,0:06:08.39,Default,,0,0,0,,Не болды? Айна-чан
Dialogue: 0,0:06:08.39,0:06:10.73,Default,,0,0,0,,Тіпті шешіп алсаңыз да
Dialogue: 0,0:06:08.39,0:06:10.73,Default,,0,0,0,,Шұлықтар жеткілікті!
Dialogue: 0,0:06:10.73,0:06:14.06,Default,,0,0,0,,Tsk!
Dialogue: 0,0:06:10.73,0:06:14.06,Default,,0,0,0,,Бұл жолы сағынып қаламын, бірақ...
Dialogue: 0,0:06:14.06,0:06:16.07,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:06:16.07,0:06:18.57,Default,,0,0,0,,Болашақта
Dialogue: 0,0:06:16.07,0:06:18.57,Default,,0,0,0,,Ешқандай әдепсіз бұйрықтар жоқ!
Dialogue: 0,0:06:18.57,0:06:21.07,Default,,0,0,0,,Эх!
Dialogue: 0,0:06:18.57,0:06:21.07,Default,,0,0,0,,Эх!
Dialogue: 0,0:06:21.07,0:06:24.57,Default,,0,0,0,,Патша!
Dialogue: 0,0:06:24.57,0:06:26.91,Default,,0,0,0,,өзінің нағыз Кира екенін дәлелдеуге бағытталған алдын ала ойластырылған кісі өлтіру
Dialogue: 0,0:06:24.57,0:06:26.91,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:06:26.91,0:06:30.58,Default,,0,0,0,,Команда дегеніміз не?
Dialogue: 0,0:06:26.91,0:06:30.58,Default,,0,0,0,,Бұл жай ғана парасаттылық.
Dialogue: 0,0:06:30.58,0:06:35.09,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:06:30.58,0:06:35.09,Default,,0,0,0,,Содан кейін барлығы 1-ден 7-ге дейін...
Dialogue: 0,0:06:35.09,0:06:38.26,Default,,0,0,0,,О!
Dialogue: 0,0:06:35.09,0:06:38.26,Default,,0,0,0,,Келесі ішу кешінде киіміңізді шешпеңіз.
Dialogue: 0,0:06:38.26,0:06:43.43,Default,,0,0,0,,Патшаның бұйрығы...
Dialogue: 0,0:06:38.26,0:06:43.43,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:06:43.43,0:06:46.43,Default,,0,0,0,,Киімді кию және шешу туралы бұйрықтар
Dialogue: 0,0:06:43.43,0:06:46.43,Default,,0,0,0,,Бұл ақылға сыймайды!
Dialogue: 0,0:06:46.43,0:06:48.60,Default,,0,0,0,,Ұят болды! Ұят!
Dialogue: 0,0:06:46.43,0:06:48.60,Default,,0,0,0,,Ақылға қонымды➡︎
Dialogue: 0,0:06:48.60,0:06:51.77,Default,,0,0,0,,Киіміңді шешпе дедім ғой!
Dialogue: 0,0:06:48.60,0:06:51.77,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:06:51.77,0:06:54.44,Default,,0,0,0,,Алға күту
Dialogue: 0,0:06:51.77,0:06:54.44,Default,,0,0,0,,Дұрыс әрекетті қалай жасау керектігін қарастырайық.
Dialogue: 0,0:06:54.44,0:06:58.21,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:06:54.44,0:06:58.21,Default,,0,0,0,,Олай болса, келесіге барайық.
Dialogue: 0,0:06:58.21,0:07:00.88,Default,,0,0,0,,Патша!
Dialogue: 0,0:07:00.88,0:07:05.38,Default,,0,0,0,,Бұл жолы менмін
Dialogue: 0,0:07:00.88,0:07:05.38,Default,,0,0,0,,Олай болса, үшінші адам...
Dialogue: 0,0:07:05.38,0:07:08.05,Default,,0,0,0,,《Жарайды! Қауіпсіз》
Dialogue: 0,0:07:05.38,0:07:08.05,Default,,0,0,0,,Сол жақтағы адамға➡︎
Dialogue: 0,0:07:08.05,0:07:11.72,Default,,0,0,0,,«Мен сені жақсы көремін, әпке»
Dialogue: 0,0:07:08.05,0:07:11.72,Default,,0,0,0,,Махаббатыңызды мойындаңыз
Dialogue: 0,0:07:11.72,0:07:13.72,Default,,0,0,0,,《Мен...》
Dialogue: 0,0:07:13.72,0:07:16.23,Default,,0,0,0,,Кәне, кел, өз сезіміңді айт.
Dialogue: 0,0:07:13.72,0:07:16.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:16.23,0:07:20.06,Default,,0,0,0,,3-ші нөмір сенсің, солай ма?
Dialogue: 0,0:07:16.23,0:07:20.06,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:07:20.06,0:07:23.26,Default,,0,0,0,,Арх! Күте тұрыңыз... сонда кім...
Dialogue: 0,0:07:25.57,0:07:28.74,Default,,0,0,0,,өзінің нағыз Кира екенін дәлелдеуге бағытталған алдын ала ойластырылған кісі өлтіру
Dialogue: 0,0:07:25.57,0:07:28.74,Default,,0,0,0,,Бұл жақсы емес!
Dialogue: 0,0:07:28.74,0:07:31.58,Default,,0,0,0,,Бұл міндетті түрде мәселе болады!
Dialogue: 0,0:07:28.74,0:07:31.58,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:31.58,0:07:33.58,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:07:31.58,0:07:33.58,Default,,0,0,0,,Иори шулы
Dialogue: 0,0:07:33.58,0:07:36.41,Default,,0,0,0,,Патшаның бұйрығы
Dialogue: 0,0:07:33.58,0:07:36.41,Default,,0,0,0,,Әрине?
Dialogue: 0,0:07:36.41,0:07:41.25,Default,,0,0,0,,Мен сізді жақсы көремін, әпке!
Dialogue: 0,0:07:36.41,0:07:41.25,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:41.25,0:07:44.59,Default,,0,0,0,,Патша!
Dialogue: 0,0:07:41.25,0:07:44.59,Default,,0,0,0,,Юу... армандау...
Dialogue: 0,0:07:44.59,0:07:47.42,Default,,0,0,0,,Мен оны міндетті түрде армандаймын...
Dialogue: 0,0:07:47.42,0:07:50.43,Default,,0,0,0,,Иә! Бұл мен!
Dialogue: 0,0:07:47.42,0:07:50.43,Default,,0,0,0,,Аһ!
Dialogue: 0,0:07:50.43,0:07:53.26,Default,,0,0,0,,《Мен салдым! Китахара! 》
Dialogue: 0,0:07:50.43,0:07:53.26,Default,,0,0,0,,《Үлкен мәміле! Кохеи!
Dialogue: 0,0:07:53.26,0:07:56.87,Default,,0,0,0,,Қалғаны - Чиса.
Dialogue: 0,0:07:53.26,0:07:56.87,Default,,0,0,0,,Қандай санды салдың...
Dialogue: 0,0:07:56.87,0:07:59.87,Default,,0,0,0,,Бұл бір рет қолданылатын таяқшаларда біраз жұмыс жасалды.
Dialogue: 0,0:07:59.87,0:08:03.87,Default,,0,0,0,,Ұзындығы әртүрлі болатындар тақ сандар.
Dialogue: 0,0:07:59.87,0:08:03.87,Default,,0,0,0,,Бірдей сан жұп
Dialogue: 0,0:08:03.87,0:08:06.71,Default,,0,0,0,,Ұшы дөңгелектелген.
Dialogue: 0,0:08:03.87,0:08:06.71,Default,,0,0,0,,Сандардың бірінші жартысы➡︎
Dialogue: 0,0:08:06.71,0:08:09.38,Default,,0,0,0,,Бірінші шаршы екінші жартысы! 》
Dialogue: 0,0:08:09.38,0:08:11.38,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:09.38,0:08:11.38,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:11.38,0:08:14.38,Default,,0,0,0,,《Сол пішінмен
Dialogue: 0,0:08:11.38,0:08:14.38,Default,,0,0,0,,Чиза - 1 немесе 3 саны!
Dialogue: 0,0:08:14.38,0:08:17.05,Default,,0,0,0,,Тек екі таңдау қалды!
Dialogue: 0,0:08:14.38,0:08:17.05,Default,,0,0,0,,Саған қалдырамын, Кохэй! 》
Dialogue: 0,0:08:17.05,0:08:19.06,Default,,0,0,0,,《Жарайды! 》
Dialogue: 0,0:08:19.06,0:08:21.22,Default,,0,0,0,,Олай болса, Кохэйкун, маған бұйрықтарыңды бер.
Dialogue: 0,0:08:21.22,0:08:24.39,Default,,0,0,0,,Иә! Менің бұйрығым...
Dialogue: 0,0:08:24.39,0:08:28.23,Default,,0,0,0,,Келесі жолы «Патшамен бірге ішімдік ішу кешінде».
Dialogue: 0,0:08:24.39,0:08:28.23,Default,,0,0,0,,«Досыңды таныстыру»
Dialogue: 0,0:08:28.23,0:08:30.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:28.23,0:08:30.73,Default,,0,0,0,,Адам қандай сан?
Dialogue: 0,0:08:30.73,0:08:33.74,Default,,0,0,0,,Әрине...
Dialogue: 0,0:08:30.73,0:08:33.74,Default,,0,0,0,,А...
Dialogue: 0,0:08:33.74,0:08:36.41,Default,,0,0,0,,№4!
Dialogue: 0,0:08:33.74,0:08:36.41,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:36.41,0:08:41.24,Default,,0,0,0,,Неліктен 4 саны? Бұл ақымақ!
Dialogue: 0,0:08:36.41,0:08:41.24,Default,,0,0,0,,Менің ойымша, сіз төрт саусақты көтердіңіз.
Dialogue: 0,0:08:41.24,0:08:47.08,Default,,0,0,0,,Бұл Чиза саны 1 немесе 3 болуы керек!
Dialogue: 0,0:08:41.24,0:08:47.08,Default,,0,0,0,,Әйтеуір, ол тағы бірдеңе құрып жатты.
Dialogue: 0,0:08:47.08,0:08:50.25,Default,,0,0,0,,Иә, иә, төбелес үшін бар болғаны.
Dialogue: 0,0:08:50.25,0:08:53.92,Default,,0,0,0,,Күрсін... Әй.
Dialogue: 0,0:08:50.25,0:08:53.92,Default,,0,0,0,,Стратегия сәтсіз аяқталды...
Dialogue: 0,0:08:53.92,0:08:58.53,Default,,0,0,0,,Сәл ұялыңыз.
Dialogue: 0,0:08:53.92,0:08:58.53,Default,,0,0,0,,Сонымен? Мақсаты не болды?
Dialogue: 0,0:08:58.53,0:09:02.03,Default,,0,0,0,,Мақсат туралы айтатын болсақ...
Dialogue: 0,0:08:58.53,0:09:02.03,Default,,0,0,0,,Мен бұл туралы неғұрлым көп айтсам, соғұрлым ол ұзарады.
Dialogue: 0,0:09:02.03,0:09:05.54,Default,,0,0,0,,Қысқаша, қорытындылау
Dialogue: 0,0:09:02.03,0:09:05.54,Default,,0,0,0,,Ақша және әйелдер
Dialogue: 0,0:09:05.54,0:09:08.37,Default,,0,0,0,,Ер адамның аты – Ллойд Форджер
Dialogue: 0,0:09:05.54,0:09:08.37,Default,,0,0,0,,Бұл түсінбеушілік
Dialogue: 0,0:09:08.37,0:09:11.54,Default,,0,0,0,,Егер біз соқыр күнді орнатсақ
Dialogue: 0,0:09:08.37,0:09:11.54,Default,,0,0,0,,Ақша алуға уәдемен
Dialogue: 0,0:09:11.54,0:09:15.21,Default,,0,0,0,,Бұл, былайша айтқанда, оқу-жаттығу жиындарына арналған шығындар.
Dialogue: 0,0:09:11.54,0:09:15.21,Default,,0,0,0,,Бұл үйірме жұмысы.
Dialogue: 0,0:09:15.21,0:09:19.22,Default,,0,0,0,,Иә, иә, иә!
Dialogue: 0,0:09:15.21,0:09:19.22,Default,,0,0,0,,Қайта толық емес жұмыс күнімен жұмыс істеп, ақша тапсам ше?
Dialogue: 0,0:09:19.22,0:09:21.38,Default,,0,0,0,,Жабысқақ белгі жоқ...
Dialogue: 0,0:09:21.38,0:09:24.22,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:09:21.38,0:09:24.22,Default,,0,0,0,,Басқа қаржылық жоспарды қарастырыңыз?
Dialogue: 0,0:09:24.22,0:09:26.39,Default,,0,0,0,,Уақытымыз аз, сондықтан асығуымыз керек.
Dialogue: 0,0:09:26.39,0:09:28.73,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:09:26.39,0:09:28.73,Default,,0,0,0,,Мұны байыпты түрде жасаңыз!
Dialogue: 0,0:09:28.73,0:09:31.90,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:28.73,0:09:31.90,Default,,0,0,0,,Екеуің күтіңдер.
Dialogue: 0,0:09:31.90,0:09:34.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:31.90,0:09:34.90,Default,,0,0,0,,Кез келген жағдайда алдыңғы пәрмен де➡︎
Dialogue: 0,0:09:34.90,0:09:38.40,Default,,0,0,0,,Мен мұны істеуім керек
Dialogue: 0,0:09:34.90,0:09:38.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:38.40,0:09:40.90,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:09:45.41,0:09:48.91,Default,,0,0,0,,О!
Dialogue: 0,0:09:45.41,0:09:48.91,Default,,0,0,0,,Токита айтып отырған кішілерсіз бе?
Dialogue: 0,0:09:48.91,0:09:51.25,Default,,0,0,0,,Өте қарқынды
Dialogue: 0,0:09:48.91,0:09:51.25,Default,,0,0,0,,Сіз ішімдік кешін өткізгіңіз келеді!
Dialogue: 0,0:09:51.25,0:09:53.58,Default,,0,0,0,,Біздің клубтың мүшесі болғыңыз келе ме?
Dialogue: 0,0:09:53.58,0:09:57.42,Default,,0,0,0,,Мұнда не болып жатыр?
Dialogue: 0,0:09:53.58,0:09:57.42,Default,,0,0,0,,Сіз бұлай жалақы аласыз деп ойламаңыз.
Dialogue: 0,0:09:57.42,0:09:59.42,Default,,0,0,0,,Керісінше, сіз төлеуіңіз керек! Бөке!
Dialogue: 0,0:09:59.42,0:10:02.26,Default,,0,0,0,,Шулы!
Dialogue: 0,0:09:59.42,0:10:02.26,Default,,0,0,0,,Мен тек өзіме қажет нәрсені жасадым!
Dialogue: 0,0:10:02.26,0:10:05.10,Default,,0,0,0,,Еңбегімді мойындап, маған ақша беріңіз!
Dialogue: 0,0:10:05.10,0:10:08.80,Default,,0,0,0,,Сіз білесіз бе~!
Dialogue: 0,0:10:12.63,0:10:16.14,Default,,0,0,0,,Соңында оқу-жаттығу жиынының ақшасы
Dialogue: 0,0:10:12.63,0:10:16.14,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:16.14,0:10:19.64,Default,,0,0,0,,Бұл әлі де жеткіліксіз
Dialogue: 0,0:10:16.14,0:10:19.64,Default,,0,0,0,,Ертең мен ақша табамын.
Dialogue: 0,0:10:19.64,0:10:22.31,Default,,0,0,0,,Бұл лайықты толық емес жұмыс, солай ма?
Dialogue: 0,0:10:22.31,0:10:25.48,Default,,0,0,0,,Азуса-сан мені іс-шараның қызметкерлерімен таныстырды.
Dialogue: 0,0:10:25.48,0:10:28.15,Default,,0,0,0,,(ысқырық)
Dialogue: 0,0:10:28.15,0:10:31.82,Default,,0,0,0,,Уау, бұл қатты көрінеді
Dialogue: 0,0:10:28.15,0:10:31.82,Default,,0,0,0,,Қысқа мерзімді толық емес жұмыс менің қолымда жалғыз нәрсе болды.
Dialogue: 0,0:10:31.82,0:10:34.32,Default,,0,0,0,,Егер сізде ақша жеткіліксіз болса
Dialogue: 0,0:10:31.82,0:10:34.32,Default,,0,0,0,,Бірге ше?
Dialogue: 0,0:10:34.32,0:10:36.32,Default,,0,0,0,,Ішке секіру дұрыс сияқты.
Dialogue: 0,0:10:36.32,0:10:38.99,Default,,0,0,0,,Мен бас тартамын...
Dialogue: 0,0:10:36.32,0:10:38.99,Default,,0,0,0,,Мен де
Dialogue: 0,0:10:38.99,0:10:40.99,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:10:40.99,0:10:43.00,Default,,0,0,0,,О
Dialogue: 0,0:10:40.99,0:10:43.00,Default,,0,0,0,,Төртеулерің біргесіңдер ме?
Dialogue: 0,0:10:43.00,0:10:45.33,Default,,0,0,0,,Біз жақын жерде кездейсоқ кездестік.
Dialogue: 0,0:10:45.33,0:10:49.17,Default,,0,0,0,,Радиаторлар арзан, солай емес пе?
Dialogue: 0,0:10:45.33,0:10:49.17,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:10:49.17,0:10:52.84,Default,,0,0,0,,Шалғам бар ма?
Dialogue: 0,0:10:49.17,0:10:52.84,Default,,0,0,0,,Не істеу керектігін ойлау
Dialogue: 0,0:10:52.84,0:10:55.78,Default,,0,0,0,,Мен басқасын алғым келеді.
Dialogue: 0,0:10:52.84,0:10:55.78,Default,,0,0,0,,Бюджеттен тыс
Dialogue: 0,0:10:55.78,0:10:59.78,Default,,0,0,0,,Онда мен оны саған сатып аламын.
Dialogue: 0,0:10:55.78,0:10:59.78,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:10:59.78,0:11:03.12,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,0:10:59.78,0:11:03.12,Default,,0,0,0,,Бұлай ұстанудың қажеті жоқ.
Dialogue: 0,0:11:03.12,0:11:06.45,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:11:03.12,0:11:06.45,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:06.45,0:11:08.79,Default,,0,0,0,,Бұл өте қымбат.
Dialogue: 0,0:11:08.79,0:11:11.46,Default,,0,0,0,,《Мен қаншамын?
Dialogue: 0,0:11:08.79,0:11:11.46,Default,,0,0,0,,Олар менің ақшам жоқ деп ойлайтын шығар》
Dialogue: 0,0:11:11.46,0:11:15.63,Default,,0,0,0,,Жоқ, жоқ... қанша мен болсам да
Dialogue: 0,0:11:11.46,0:11:15.63,Default,,0,0,0,,Шамамен бір шалғам сатып алуға болады.
Dialogue: 0,0:11:15.63,0:11:17.80,Default,,0,0,0,,Иә, бәлкім…
Dialogue: 0,0:11:17.80,0:11:20.30,Default,,0,0,0,,Білесің бе, Иори-кун...
Dialogue: 0,0:11:20.30,0:11:24.40,Default,,0,0,0,,Сәлем Чи Чан, Иори.
Dialogue: 0,0:11:20.30,0:11:24.40,Default,,0,0,0,,Алмас сатып алсаңыз не істер едіңіз?
Dialogue: 0,0:11:27.31,0:11:29.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:29.31,0:11:35.32,Default,,0,0,0,,Ju… бар болғаны 15 минут… бар болғаны 15 минут
Dialogue: 0,0:11:29.31,0:11:35.32,Default,,0,0,0,,Сен маған адамдай қарай аласың.
Dialogue: 0,0:11:35.32,0:11:37.82,Default,,0,0,0,,Өйткені! Иори
Dialogue: 0,0:11:35.32,0:11:37.82,Default,,0,0,0,,Керісінше, осы уақытқа дейін➡︎
Dialogue: 0,0:11:37.82,0:11:40.65,Default,,0,0,0,,Ол қалай емделді?
Dialogue: 0,0:11:37.82,0:11:40.65,Default,,0,0,0,,Маған қызық.
Dialogue: 0,0:11:40.65,0:11:43.49,Default,,0,0,0,,Бірақ сізге шалғам керек пе?
Dialogue: 0,0:11:40.65,0:11:43.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:43.49,0:11:46.33,Default,,0,0,0,,Ахахаха!
Dialogue: 0,0:11:43.49,0:11:46.33,Default,,0,0,0,,Жоқ, Иори-кун.
Dialogue: 0,0:11:46.33,0:11:49.16,Default,,0,0,0,,Шалғам емес
Dialogue: 0,0:11:46.33,0:11:49.16,Default,,0,0,0,,Біз Daikon туралы айттық.
Dialogue: 0,0:11:49.16,0:11:53.33,Default,,0,0,0,,Дайкон?
Dialogue: 0,0:11:49.16,0:11:53.33,Default,,0,0,0,,Сонымен, сүңгуір компьютер туралы.
Dialogue: 0,0:11:53.33,0:11:55.27,Default,,0,0,0,,Айтпақшы, баға осы туралы.
Dialogue: 0,0:11:55.27,0:11:57.44,Default,,0,0,0,,Бұл сізде бар
Dialogue: 0,0:11:55.27,0:11:57.44,Default,,0,0,0,,Маған сатып алуға рұқсат етіңіз...
Dialogue: 0,0:11:57.44,0:12:00.61,Default,,0,0,0,,Мен барынша жеңілдік жасауға тырыстым.
Dialogue: 0,0:12:00.61,0:12:04.28,Default,,0,0,0,,Ал, енді бәріміз осындамыз, кеттік!
Dialogue: 0,0:12:00.61,0:12:04.28,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:04.28,0:12:06.95,Default,,0,0,0,,Не? Қайда бара жатырсың?
Dialogue: 0,0:12:06.95,0:12:10.35,Default,,0,0,0,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,0:12:06.95,0:12:10.35,Default,,0,0,0,,Мен сүңгуір жабдықтарын көргім келеді.
Dialogue: 0,0:12:12.29,0:12:14.29,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:12:14.29,0:12:16.62,Default,,0,0,0,,біршама
Dialogue: 0,0:12:14.29,0:12:16.62,Default,,0,0,0,,Жабдықтардың әртүрлі түрлері бар.
Dialogue: 0,0:12:16.62,0:12:19.63,Default,,0,0,0,,Шынымды айтсам, мен нені көруім керек?
Dialogue: 0,0:12:16.62,0:12:19.63,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:12:19.63,0:12:22.13,Default,,0,0,0,,Мен не сатып алуым керек?
Dialogue: 0,0:12:19.63,0:12:22.13,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:12:22.13,0:12:24.96,Default,,0,0,0,,Бастапқыда жалға алу жеткілікті
Dialogue: 0,0:12:22.13,0:12:24.96,Default,,0,0,0,,Маған...
Dialogue: 0,0:12:24.96,0:12:27.80,Default,,0,0,0,,Иә. Маған да солай айтылды.
Dialogue: 0,0:12:27.80,0:12:30.14,Default,,0,0,0,,((әзірше
Dialogue: 0,0:12:27.80,0:12:30.14,Default,,0,0,0,,Сүлгілер мен купальниктер?
Dialogue: 0,0:12:30.14,0:12:32.14,Default,,0,0,0,,А... купальник?!))
Dialogue: 0,0:12:32.14,0:12:34.47,Default,,0,0,0,,О!
Dialogue: 0,0:12:32.14,0:12:34.47,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:12:34.47,0:12:36.48,Default,,0,0,0,,Алдымен
Dialogue: 0,0:12:34.47,0:12:36.48,Default,,0,0,0,,Сізге тек орамал қажет!
Dialogue: 0,0:12:36.48,0:12:39.48,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:36.48,0:12:39.48,Default,,0,0,0,,Не? Ал жүзу киімдері ше?
Dialogue: 0,0:12:39.48,0:12:43.15,Default,,0,0,0,,Өз техникаңызды сатып алу
Dialogue: 0,0:12:39.48,0:12:43.15,Default,,0,0,0,,Алдымен бетперде киюді ұсынамыз.
Dialogue: 0,0:12:43.15,0:12:45.49,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:43.15,0:12:45.49,Default,,0,0,0,,Ал, салыстырмалы түрде➡︎
Dialogue: 0,0:12:45.49,0:12:47.99,Default,,0,0,0,,Қолжетімді баға
Dialogue: 0,0:12:45.49,0:12:47.99,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:12:47.99,0:12:51.82,Default,,0,0,0,,Ең бастысы, суға түсудің мақсаты
Dialogue: 0,0:12:47.99,0:12:51.82,Default,,0,0,0,,Өйткені бұл мұхитқа қарау туралы.
Dialogue: 0,0:12:51.82,0:12:55.16,Default,,0,0,0,,Сізге сәйкес келмейтін маскамен
Dialogue: 0,0:12:51.82,0:12:55.16,Default,,0,0,0,,Көру қиын болса, сізге ұнамас еді, солай ма?
Dialogue: 0,0:12:55.16,0:12:57.10,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:57.10,0:13:00.43,Default,,0,0,0,,Басқа элементтерді Daikon-дан орналастыру керек.
Dialogue: 0,0:12:57.10,0:13:00.43,Default,,0,0,0,,деген ой да бар.
Dialogue: 0,0:13:00.43,0:13:02.60,Default,,0,0,0,,Өзіңіздің қауіпсіздік техникаңызды➡︎ әкеліңіз
Dialogue: 0,0:13:02.60,0:13:06.27,Default,,0,0,0,,Декомпрессиялық ауру қаупі т.б.
Dialogue: 0,0:13:02.60,0:13:06.27,Default,,0,0,0,,Идеясы – азайту
Dialogue: 0,0:13:06.27,0:13:09.28,Default,,0,0,0,,Осы уақытқа дейін біз ешқашан дайкон болған емеспіз.
Dialogue: 0,0:13:06.27,0:13:09.28,Default,,0,0,0,,Менде ол жоқ...
Dialogue: 0,0:13:09.28,0:13:12.95,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:13:09.28,0:13:12.95,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:13:12.95,0:13:15.95,Default,,0,0,0,,Қауіпті тереңдіктерге
Dialogue: 0,0:13:12.95,0:13:15.95,Default,,0,0,0,,Өйткені мен олардың суға түсуіне рұқсат бермедім.
Dialogue: 0,0:13:15.95,0:13:18.12,Default,,0,0,0,,Және осындай нәрсе
Dialogue: 0,0:13:15.95,0:13:18.12,Default,,0,0,0,,Оянбаңыз➡︎
Dialogue: 0,0:13:18.12,0:13:20.62,Default,,0,0,0,,Нұсқаушы сізді бақылайды.
Dialogue: 0,0:13:20.62,0:13:22.62,Default,,0,0,0,,Белгілі бір тереңдікке сүңгу➡︎
Dialogue: 0,0:13:22.62,0:13:28.13,Default,,0,0,0,,Нұсқаушыдан алыстау
Dialogue: 0,0:13:22.62,0:13:28.13,Default,,0,0,0,,Бұл сүңгуірлерге қажетті құрал-жабдықтар.
Dialogue: 0,0:13:28.13,0:13:30.80,Default,,0,0,0,,Ах. Бұл не?
Dialogue: 0,0:13:30.80,0:13:34.63,Default,,0,0,0,,Ток ілгегі
Dialogue: 0,0:13:30.80,0:13:34.63,Default,,0,0,0,,Сөзбе-сөз ілмектеу арқылы қолданылады
Dialogue: 0,0:13:34.63,0:13:36.64,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:34.63,0:13:36.64,Default,,0,0,0,,Бұл қалқыма.
Dialogue: 0,0:13:36.64,0:13:40.81,Default,,0,0,0,,Ішіне ауа салып, үрлеу арқылы қолдану.
Dialogue: 0,0:13:36.64,0:13:40.81,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:40.81,0:13:43.31,Default,,0,0,0,,((Nga~!
Dialogue: 0,0:13:40.81,0:13:43.31,Default,,0,0,0,,Қазір көмектесіңіз! ))
Dialogue: 0,0:13:45.31,0:13:47.31,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:13:47.31,0:13:50.32,Default,,0,0,0,,Теңізде болу қорқынышты...
Dialogue: 0,0:13:47.31,0:13:50.32,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:13:50.32,0:13:53.82,Default,,0,0,0,,《Сол бет
Dialogue: 0,0:13:50.32,0:13:53.82,Default,,0,0,0,,Мен мүлдем ақымақ нәрселерді ойлаймын.
Dialogue: 0,0:13:53.82,0:13:56.26,Default,,0,0,0,,Ендеше, жан-жағыңа көз сал.
Dialogue: 0,0:13:56.26,0:13:58.93,Default,,0,0,0,,Егер сіз бірдеңені түсінбесеңіз
Dialogue: 0,0:13:56.26,0:13:58.93,Default,,0,0,0,,Маған айқайлаңыз
Dialogue: 0,0:13:58.93,0:14:01.59,Default,,0,0,0,,Уххх
Dialogue: 0,0:13:58.93,0:14:01.59,Default,,0,0,0,,Иә
Dialogue: 0,0:14:01.59,0:14:25.62,Default,,0,0,0,,♬︎〜
Dialogue: 0,0:14:25.62,0:14:30.29,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:14:25.62,0:14:30.29,Default,,0,0,0,,Бұл өте ерекше камера.
Dialogue: 0,0:14:30.29,0:14:32.79,Default,,0,0,0,,Мен сізді осылай суретке түсіруге болады деп естідім.
Dialogue: 0,0:14:32.79,0:14:36.80,Default,,0,0,0,,Бұл, әрине, сирек!
Dialogue: 0,0:14:32.79,0:14:36.80,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:14:36.80,0:14:40.47,Default,,0,0,0,,Ха! Иори Иори
Dialogue: 0,0:14:36.80,0:14:40.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:40.47,0:14:42.97,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:14:40.47,0:14:42.97,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:14:42.97,0:14:46.14,Default,,0,0,0,,Осы сияқты басқа да нәрселер
Dialogue: 0,0:14:42.97,0:14:46.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:46.14,0:14:50.31,Default,,0,0,0,,Бұл су астында сөйлей алатын машинаға ұқсайды.
Dialogue: 0,0:14:46.14,0:14:50.31,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:14:50.31,0:14:54.81,Default,,0,0,0,,Дыбыс сүйек өткізгіштігі арқылы қабылданады
Dialogue: 0,0:14:50.31,0:14:54.81,Default,,0,0,0,,Қазіргі ғылым керемет!
Dialogue: 0,0:14:54.81,0:14:57.92,Default,,0,0,0,,Тек әңгіме үшін
Dialogue: 0,0:14:54.81,0:14:57.92,Default,,0,0,0,,Кішкене мәселе бар сияқты.
Dialogue: 0,0:14:57.92,0:15:02.42,Default,,0,0,0,,Бұл рас. Сөздерді алдын ала қолданыңыз.
Dialogue: 0,0:14:57.92,0:15:02.42,Default,,0,0,0,,Кездесу жақсы ма?
Dialogue: 0,0:15:02.42,0:15:05.26,Default,,0,0,0,,Аяқты аузыңа ұстағанда
Dialogue: 0,0:15:02.42,0:15:05.26,Default,,0,0,0,,Айтылуы қиын.
Dialogue: 0,0:15:05.26,0:15:08.93,Default,,0,0,0,,Кешіріңіз! Менің сұрағым бар...
Dialogue: 0,0:15:05.26,0:15:08.93,Default,,0,0,0,,Мен қазір кетуім керек. Күте тұр!
Dialogue: 0,0:15:08.93,0:15:11.76,Default,,0,0,0,,Реттегіш болып табылады
Dialogue: 0,0:15:08.93,0:15:11.76,Default,,0,0,0,,Қалай таңдауға болады?
Dialogue: 0,0:15:11.76,0:15:15.77,Default,,0,0,0,,Не? Reg?
Dialogue: 0,0:15:11.76,0:15:15.77,Default,,0,0,0,,Менің ойымша, әлі де жалға алған дұрыс.
Dialogue: 0,0:15:15.77,0:15:17.77,Default,,0,0,0,,Қалтырап тұрсың ба?
Dialogue: 0,0:15:17.77,0:15:20.11,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:15:17.77,0:15:20.11,Default,,0,0,0,,«Ка»?
Dialogue: 0,0:15:20.11,0:15:22.28,Default,,0,0,0,,Бұл жанама сүйіспеншілік болар еді...
Dialogue: 0,0:15:22.28,0:15:24.78,Default,,0,0,0,,((Енді менің режимімді қарастырайық.
Dialogue: 0,0:15:22.28,0:15:24.78,Default,,0,0,0,,Ха! ))
Dialogue: 0,0:15:24.78,0:15:27.61,Default,,0,0,0,,Осы шеңберде қал
Dialogue: 0,0:15:24.78,0:15:27.61,Default,,0,0,0,,Сіз әлі де бұл туралы алаңдайсыз ба?
Dialogue: 0,0:15:27.61,0:15:29.95,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:15:29.95,0:15:32.62,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:29.95,0:15:32.62,Default,,0,0,0,,Өйткені бұл жанама сүйіспеншіліктен өзгеше
Dialogue: 0,0:15:32.62,0:15:34.62,Default,,0,0,0,,О... солай ма?
Dialogue: 0,0:15:34.62,0:15:37.79,Default,,0,0,0,,Қараңдаршы, ауыздықты ауызға салғанда.
Dialogue: 0,0:15:34.62,0:15:37.79,Default,,0,0,0,,Есте сақтауға тырысыңыз
Dialogue: 0,0:15:37.79,0:15:40.13,Default,,0,0,0,,Әрине
Dialogue: 0,0:15:37.79,0:15:40.13,Default,,0,0,0,,Бұл жанама сүйіспеншіліктен өзгеше.
Dialogue: 0,0:15:40.13,0:15:43.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:40.13,0:15:43.13,Default,,0,0,0,,Сондықтан таңдау керек болса...
Dialogue: 0,0:15:43.13,0:15:45.97,Default,,0,0,0,,((Менің тіс щеткамды пайдаланыңыз.
Dialogue: 0,0:15:43.13,0:15:45.97,Default,,0,0,0,,Ах...))
Dialogue: 0,0:15:45.97,0:15:49.80,Default,,0,0,0,,Бұл тіс щеткасын ортақ пайдалану сияқты.
Dialogue: 0,0:15:45.97,0:15:49.80,Default,,0,0,0,,Мен оны одан сайын жек көремін!
Dialogue: 0,0:15:49.80,0:15:54.97,Default,,0,0,0,,Сонымен, бұл шын мәнінде қандай?
Dialogue: 0,0:15:49.80,0:15:54.97,Default,,0,0,0,,Үйімізді күнде дезинфекциялаймыз ба?
Dialogue: 0,0:15:54.97,0:15:58.91,Default,,0,0,0,,Егер сізді қызықтырса, бір рет
Dialogue: 0,0:15:54.97,0:15:58.91,Default,,0,0,0,,Тікелей жасауға болады ма?
Dialogue: 0,0:15:58.91,0:16:02.08,Default,,0,0,0,,Шындығында, И
Dialogue: 0,0:15:58.91,0:16:02.08,Default,,0,0,0,,Мен жанама сүйіспеншілікке алаңдадым.
Dialogue: 0,0:16:02.08,0:16:04.08,Default,,0,0,0,,Ең нашар!
Dialogue: 0,0:16:02.08,0:16:04.08,Default,,0,0,0,,Тауарлар
Dialogue: 0,0:16:04.08,0:16:06.09,Default,,0,0,0,,Бұл нәрсені жай қалдырыңыз
Dialogue: 0,0:16:04.08,0:16:06.09,Default,,0,0,0,,Мына жақтағы купальниктерді көрейік.
Dialogue: 0,0:16:06.09,0:16:08.92,Default,,0,0,0,,Жаңа купальник ала аламын ба?
Dialogue: 0,0:16:08.92,0:16:11.76,Default,,0,0,0,,Мен өте көп
Dialogue: 0,0:16:08.92,0:16:11.76,Default,,0,0,0,,Мен қорқынышты нәрсе айттым ба?
Dialogue: 0,0:16:11.76,0:16:15.09,Default,,0,0,0,,Қабырғаға табыныңдар. Қабырғаны мадақтаңдар. Қабырғаны құрметтеңдер.
Dialogue: 0,0:16:15.09,0:16:18.43,Default,,0,0,0,,Енді ойлап қарасам, Котегава мырза
Dialogue: 0,0:16:15.09,0:16:18.43,Default,,0,0,0,,«Чиса» жақсы.
Dialogue: 0,0:16:18.43,0:16:20.77,Default,,0,0,0,,Онда мен де «Айна» деп атаймын.
Dialogue: 0,0:16:20.77,0:16:23.10,Default,,0,0,0,,Сонымен
Dialogue: 0,0:16:20.77,0:16:23.10,Default,,0,0,0,,Мен сізден бірнәрсе сұрайын деп едім...
Dialogue: 0,0:16:23.10,0:16:25.27,Default,,0,0,0,,Не?
Dialogue: 0,0:16:25.27,0:16:27.77,Default,,0,0,0,,Иори мен Чиса кездесе ме?
Dialogue: 0,0:16:34.28,0:16:36.78,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:16:34.28,0:16:36.78,Default,,0,0,0,,Иә... дәл сол бет➡︎
Dialogue: 0,0:16:36.78,0:16:39.29,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:16:39.29,0:16:41.62,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:16:39.29,0:16:41.62,Default,,0,0,0,,Иззу көктемі фестивалінде болған оқиға...
Dialogue: 0,0:16:41.62,0:16:47.13,Default,,0,0,0,,Жұмбақ комикстердің арқасында көп нәрсе орын алады.
Dialogue: 0,0:16:41.62,0:16:47.13,Default,,0,0,0,,Бұл қиын болды, сондықтан мен оған қарсы шара қолдануды шештім...
Dialogue: 0,0:16:47.13,0:16:49.30,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:49.30,0:16:52.30,Default,,0,0,0,,Бірінші кезекте...
Dialogue: 0,0:16:49.30,0:16:52.30,Default,,0,0,0,,Тұтынушы!
Dialogue: 0,0:16:52.30,0:16:56.57,Default,,0,0,0,,Киіміңізді фитинг бөлмесінде ауыстырыңыз!
Dialogue: 0,0:16:52.30,0:16:56.57,Default,,0,0,0,,Жоқ! Әдеттегідей...
Dialogue: 0,0:16:56.57,0:16:59.24,Default,,0,0,0,,Мұнда және мұнда ...
Dialogue: 0,0:16:56.57,0:16:59.24,Default,,0,0,0,,Дәлізде киім ауыстырмаңыз! Иори
Dialogue: 0,0:16:59.24,0:17:02.91,Default,,0,0,0,,Шешетін киіміңіз кедергі болады.
Dialogue: 0,0:16:59.24,0:17:02.91,Default,,0,0,0,,Мәселе бұл емес!
Dialogue: 0,0:17:02.91,0:17:05.91,Default,,0,0,0,,Мұндай адамға қарсы
Dialogue: 0,0:17:02.91,0:17:05.91,Default,,0,0,0,,Мен бұл туралы ойлай алмаймын.
Dialogue: 0,0:17:05.91,0:17:09.08,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:17:05.91,0:17:09.08,Default,,0,0,0,,Айтпақшы, Кохейге не болды?
Dialogue: 0,0:17:09.08,0:17:12.78,Default,,0,0,0,,Ойланып қарасам, мен оны көрмеймін.
Dialogue: 0,0:17:09.08,0:17:12.78,Default,,0,0,0,,Мен оны іздеймін.
Dialogue: 0,0:17:14.75,0:17:16.85,Default,,0,0,0,,О, итата
Dialogue: 0,0:17:20.76,0:17:23.26,Default,,0,0,0,,Сіз не істеп жатырсыз?Сіз
Dialogue: 0,0:17:20.76,0:17:23.26,Default,,0,0,0,,Китахара!
Dialogue: 0,0:17:23.26,0:17:25.43,Default,,0,0,0,,Сізді де осында әкелді ме!?
Dialogue: 0,0:17:25.43,0:17:28.10,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:25.43,0:17:28.10,Default,,0,0,0,,Мен сені іздедім...
Dialogue: 0,0:17:28.10,0:17:30.60,Default,,0,0,0,,Сізге дымқыл костюм керек пе?
Dialogue: 0,0:17:28.10,0:17:30.60,Default,,0,0,0,,Сатып алайын деген ойым жоқ еді, бірақ➡︎
Dialogue: 0,0:17:30.60,0:17:34.61,Default,,0,0,0,,Маған бұл қызық!
Dialogue: 0,0:17:30.60,0:17:34.61,Default,,0,0,0,,Бұл, әрине, ерекше дизайн.
Dialogue: 0,0:17:34.61,0:17:37.28,Default,,0,0,0,,Бұл не... баяғыдан бері
Dialogue: 0,0:17:37.28,0:17:40.11,Default,,0,0,0,,Китахара...сіз
Dialogue: 0,0:17:37.28,0:17:40.11,Default,,0,0,0,,Мен бұл анимені білмейтініме сене алар емеспін...
Dialogue: 0,0:17:40.11,0:17:42.78,Default,,0,0,0,,Бұл жалғыз өлшем болса
Dialogue: 0,0:17:40.11,0:17:42.78,Default,,0,0,0,,Мен оны кие алмаймын.
Dialogue: 0,0:17:42.78,0:17:45.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:42.78,0:17:45.45,Default,,0,0,0,,Маған бұны киюдің қажеті жоқ!
Dialogue: 0,0:17:45.45,0:17:47.79,Default,,0,0,0,,Ах... Ах! Мен түсінемін.
Dialogue: 0,0:17:47.79,0:17:50.62,Default,,0,0,0,,Оны кие алатын адамнан сұраңыз
Dialogue: 0,0:17:47.79,0:17:50.62,Default,,0,0,0,,Кері байланыс ала аламын ба?
Dialogue: 0,0:17:50.62,0:17:52.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:50.62,0:17:52.79,Default,,0,0,0,,Жоқ... бұл менің айтқым келгені...
Dialogue: 0,0:17:52.79,0:17:54.79,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:01.07,0:18:03.24,Default,,0,0,0,,Иә... Менің ойымша, бұл ыңғайлы.
Dialogue: 0,0:18:03.24,0:18:06.74,Default,,0,0,0,,Бұл найзағайсыз түр болғандықтан.
Dialogue: 0,0:18:03.24,0:18:06.74,Default,,0,0,0,,Сіздің талғамыңыз әртүрлі ме?
Dialogue: 0,0:18:06.74,0:18:09.41,Default,,0,0,0,,Кохеи Дасаса
Dialogue: 0,0:18:09.41,0:18:14.08,Default,,0,0,0,,Ха... аа!
Dialogue: 0,0:18:14.08,0:18:18.25,Default,,0,0,0,,Мен... Мен бүгін сен туралымын.
Dialogue: 0,0:18:14.08,0:18:18.25,Default,,0,0,0,,Сіз мені жан серігім деп атай аласыз!
Dialogue: 0,0:18:18.25,0:18:22.09,Default,,0,0,0,,Кенет не? Қорқынышты...
Dialogue: 0,0:18:18.25,0:18:22.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:22.09,0:18:24.92,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:18:22.09,0:18:24.92,Default,,0,0,0,,Егер мен бұны қазір айтпасам, кейін қарама-қайшылықтар туындауы мүмкін.
Dialogue: 0,0:18:24.92,0:18:27.26,Default,,0,0,0,,Бұл қазір мүмкін емес, бірақ мен оны бір күні міндетті түрде жасаймын!
Dialogue: 0,0:18:27.26,0:18:29.60,Default,,0,0,0,,Бұрынғы нәрсе
Dialogue: 0,0:18:27.26,0:18:29.60,Default,,0,0,0,,Мен ханым болдым ба?
Dialogue: 0,0:18:29.60,0:18:32.93,Default,,0,0,0,,Сіз қалай ойлайсыз? Балалар сендер
Dialogue: 0,0:18:29.60,0:18:32.93,Default,,0,0,0,,Сіз қалаған нәрсе болды ма?
Dialogue: 0,0:18:32.93,0:18:35.43,Default,,0,0,0,,Көп нәрсе бар
Dialogue: 0,0:18:32.93,0:18:35.43,Default,,0,0,0,,Мен абдырап қалдым...
Dialogue: 0,0:18:35.43,0:18:38.10,Default,,0,0,0,,Әзірше, ұсынылғандай.
Dialogue: 0,0:18:35.43,0:18:38.10,Default,,0,0,0,,Мен маска қолданамын деп ойлаймын
Dialogue: 0,0:18:38.10,0:18:41.27,Default,,0,0,0,,Айна ше?
Dialogue: 0,0:18:38.10,0:18:41.27,Default,,0,0,0,,Мен де маска киемін
Dialogue: 0,0:18:41.27,0:18:53.29,Default,,0,0,0,,♬︎〜
Dialogue: 0,0:18:53.29,0:18:56.59,Default,,0,0,0,,Эй Чиса, масканы қалай таңдауға болады...
Dialogue: 0,0:19:00.39,0:19:04.40,Default,,0,0,0,,Иә? Чиса?
Dialogue: 0,0:19:00.39,0:19:04.40,Default,,0,0,0,,Чи Чан өте сүйкімді!
Dialogue: 0,0:19:04.40,0:19:07.90,Default,,0,0,0,,Жастар! Жастар!
Dialogue: 0,0:19:04.40,0:19:07.90,Default,,0,0,0,,А... не айтып тұрсың?
Dialogue: 0,0:19:07.90,0:19:12.41,Default,,0,0,0,,Жоқ, мен камерада көп жұмыс істеп жатырмын.
Dialogue: 0,0:19:07.90,0:19:12.41,Default,,0,0,0,,Менің ойымша, сіз таңдаған нәрсе сүйкімді емес.
Dialogue: 0,0:19:12.41,0:19:15.07,Default,,0,0,0,,Еске алу
Dialogue: 0,0:19:12.41,0:19:15.07,Default,,0,0,0,,Сіз жай ғана суретке түскіңіз келмейді ме?
Dialogue: 0,0:19:15.07,0:19:17.41,Default,,0,0,0,,Ал Са… сен, тез арада мұнда кет.
Dialogue: 0,0:19:17.41,0:19:21.41,Default,,0,0,0,,Бір жаста болса керек
Dialogue: 0,0:19:17.41,0:19:21.41,Default,,0,0,0,,Сүңгуір досы бар➡︎
Dialogue: 0,0:19:21.41,0:19:24.08,Default,,0,0,0,,Сіз бақыттысыз деп ойлаймын.
Dialogue: 0,0:19:24.08,0:19:27.42,Default,,0,0,0,,Ол өте жақсы
Dialogue: 0,0:19:24.08,0:19:27.42,Default,,0,0,0,,Сіз дайвингті ұнатасыз, солай ма?
Dialogue: 0,0:19:27.42,0:19:29.42,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:33.43,0:19:36.60,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:19:33.43,0:19:36.60,Default,,0,0,0,,Кейде жергілікті тұрғынды пайдаланған ыңғайлы.
Dialogue: 0,0:19:36.60,0:19:38.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:38.93,0:19:42.10,Default,,0,0,0,,Сіз көп нәрсе сатып алдыңыз.
Dialogue: 0,0:19:38.93,0:19:42.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:42.10,0:19:45.44,Default,,0,0,0,,Біз бетперде киеміз
Dialogue: 0,0:19:42.10,0:19:45.44,Default,,0,0,0,,Менде фотоаппарат бар
Dialogue: 0,0:19:45.44,0:19:49.11,Default,,0,0,0,,Әй, сен көп жұмыс жасадың.
Dialogue: 0,0:19:45.44,0:19:49.11,Default,,0,0,0,,«Мен барынша тырыстым»?
Dialogue: 0,0:19:49.11,0:19:51.61,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:19:49.11,0:19:51.61,Default,,0,0,0,,Мен жаңа ғана дүкенге бардым...
Dialogue: 0,0:19:51.61,0:19:54.11,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:19:54.11,0:19:58.62,Default,,0,0,0,,Окинаваға бару үшін ақша керек болса да.
Dialogue: 0,0:19:54.11,0:19:58.62,Default,,0,0,0,,Тіпті жабдықты сатып аласың ба?
Dialogue: 0,0:19:58.62,0:20:00.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:03.29,0:20:12.30,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:20:12.30,0:20:14.30,Default,,0,0,0,,Қарап көріңізші!
Dialogue: 0,0:20:14.30,0:20:18.64,Default,,0,0,0,,Қараңыз...
Dialogue: 0,0:20:14.30,0:20:18.64,Default,,0,0,0,,♬~
Dialogue: 0,0:20:18.64,0:20:20.81,Default,,0,0,0,,Уууу... Ухуфуфу!
Dialogue: 0,0:20:20.81,0:20:25.31,Default,,0,0,0,,Сәлем Китахара...
Dialogue: 0,0:20:20.81,0:20:25.31,Default,,0,0,0,,Қанша уақыт үзіліс аламыз?
Dialogue: 0,0:20:25.31,0:20:28.31,Default,,0,0,0,,Бұл енді ғана басталды
Dialogue: 0,0:20:25.31,0:20:28.31,Default,,0,0,0,,Бірнеше минут болды.
Dialogue: 0,0:20:28.31,0:20:31.91,Default,,0,0,0,,Эй... Китахара...
Dialogue: 0,0:20:28.31,0:20:31.91,Default,,0,0,0,,Үндетпе...Мен сені өлтіремін.
Dialogue: 0,0:20:34.49,0:20:36.82,Default,,0,0,0,,Уау~ Ах...!
Dialogue: 0,0:20:36.82,0:20:40.83,Default,,0,0,0,,Мен енді саған үйлене алмаймын!
Dialogue: 0,0:20:36.82,0:20:40.83,Default,,0,0,0,,Жарайды! Мен бара аламын! Мен бара аламын!
Dialogue: 0,0:20:40.83,0:20:43.16,Default,,0,0,0,,Сіз бұл деңгейде нені қайғырасыз?
Dialogue: 0,0:20:43.16,0:20:45.83,Default,,0,0,0,,Біз күнде дерлік жалаңаш жүреміз.
Dialogue: 0,0:20:45.83,0:20:57.94,Default,,0,0,0,,♬︎〜
Dialogue: 0,0:20:57.94,0:21:00.28,Default,,0,0,0,,Мен сол жерде лицензиялық курстан өттім.
Dialogue: 0,0:21:00.28,0:21:02.95,Default,,0,0,0,,Сосын мен және Котобүки
Dialogue: 0,0:21:00.28,0:21:02.95,Default,,0,0,0,,Күн сайын өзгереді.
Dialogue: 0,0:21:02.95,0:21:05.28,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:05.28,0:21:07.62,Default,,0,0,0,,《Дәл солай, дайындал➡︎
Dialogue: 0,0:21:07.62,0:21:11.12,Default,,0,0,0,,Ақырында, Окинавадағы оқу-жаттығу лагеріне баратын кез келді! 》
Dialogue: 0,0:21:13.63,0:21:17.30,Default,,0,0,0,,Енді балалар
Dialogue: 0,0:21:13.63,0:21:17.30,Default,,0,0,0,,Окинаваға келді!
Dialogue: 0,0:21:17.30,0:21:20.80,Default,,0,0,0,,Меніңше, Каэдэге де уақыт келген сияқты
Dialogue: 0,0:21:22.97,0:21:26.37,Default,,0,0,0,,Иә, Айна-чан үшін.
Dialogue: 0,0:21:22.97,0:21:26.37,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:21:27.87,0:21:33.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
