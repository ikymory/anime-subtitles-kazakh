Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.77,0:00:04.61,Default,,0,0,0,,Жарқыраған күн!
Dialogue: 0,0:00:04.61,0:00:08.61,Default,,0,0,0,,Көк аспан! Көк теңіз!
Dialogue: 0,0:00:08.61,0:00:12.11,Default,,0,0,0,,Кеттік, Рисораба!
Dialogue: 0,0:00:08.61,0:00:12.11,Default,,0,0,0,,Күте тұрыңыз, су перісі!
Dialogue: 0,0:00:12.11,0:00:15.12,Default,,0,0,0,,Тура Окинаваға барыңыз!
Dialogue: 0,0:00:15.12,0:00:17.95,Default,,0,0,0,,Ах~ мен сонда болдым
Dialogue: 0,0:00:17.95,0:00:20.46,Default,,0,0,0,,Аға
Dialogue: 0,0:00:17.95,0:00:20.46,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:00:20.46,0:00:24.79,Default,,0,0,0,,Мен жақсы жұмыс күнін таптым
Dialogue: 0,0:00:20.46,0:00:24.79,Default,,0,0,0,,Мен де сендер туралы қызық болдым.
Dialogue: 0,0:00:24.79,0:00:27.46,Default,,0,0,0,,Толық емес жұмыс күні?
Dialogue: 0,0:00:24.79,0:00:27.46,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:00:27.46,0:00:30.13,Default,,0,0,0,,Әрине, бұл оқу-жаттығу жиынына кеткен шығындарға байланысты.
Dialogue: 0,0:00:30.13,0:00:34.14,Default,,0,0,0,,Иә? Теннис сыйлығымен...
Dialogue: 0,0:00:30.13,0:00:34.14,Default,,0,0,0,,Тек жол жүру шығындары
Dialogue: 0,0:00:34.14,0:00:36.31,Default,,0,0,0,,Қалғаны жеке меншік.
Dialogue: 0,0:00:36.31,0:00:38.47,Default,,0,0,0,,Иә!?
Dialogue: 0,0:00:36.31,0:00:38.47,Default,,0,0,0,,Солай ма?
Сіз
Dialogue: 0,0:00:38.47,0:00:43.37,Default,,0,0,0,,бойынша толық емес жұмыс күнімен жұмыс істейсіз бе? Неге жоқ?
Dialogue: 0,0:02:21.28,0:02:24.95,Default,,0,0,0,,Бүгін жер бетінде не бар?
Dialogue: 0,0:02:21.28,0:02:24.95,Default,,0,0,0,,Не болды? Балалар сендер
Dialogue: 0,0:02:24.95,0:02:28.78,Default,,0,0,0,,А, маған ақша керек.
Dialogue: 0,0:02:28.78,0:02:33.46,Default,,0,0,0,,Ақша табу қиын.
Dialogue: 0,0:02:28.78,0:02:33.46,Default,,0,0,0,,Оқу-жаттығу жиынының ақысы?
Dialogue: 0,0:02:33.46,0:02:38.13,Default,,0,0,0,,Иә? Екеуміз де Токиомыз
Dialogue: 0,0:02:33.46,0:02:38.13,Default,,0,0,0,,Сіз толық емес жұмыс күні туралы хабарлама алған жоқсыз ба?
Dialogue: 0,0:02:38.13,0:02:41.13,Default,,0,0,0,,Көшуге арналған толық емес жұмыс күні... солай ма?
Dialogue: 0,0:02:41.13,0:02:43.97,Default,,0,0,0,,Мен мұнда кеше келдім...
Dialogue: 0,0:02:43.97,0:02:46.97,Default,,0,0,0,,((Grr…
Dialogue: 0,0:02:43.97,0:02:46.97,Default,,0,0,0,,Сол сияқты, бір күні, бір жерде кездесесіздер.
Dialogue: 0,0:02:46.97,0:02:49.81,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:02:46.97,0:02:49.81,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:02:49.81,0:02:52.47,Default,,0,0,0,,Ей, эй, эй, эй!
Dialogue: 0,0:02:52.47,0:02:54.48,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:02:54.48,0:02:57.75,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:02:54.48,0:02:57.75,Default,,0,0,0,,Бұл еңбектің бағасы!
Dialogue: 0,0:02:57.75,0:02:59.75,Default,,0,0,0,,Жарайды, мен сенен тағы сұрайын! ))
Dialogue: 0,0:03:03.09,0:03:05.09,Default,,0,0,0,,((Қаа~!
Dialogue: 0,0:03:05.09,0:03:08.42,Default,,0,0,0,,Жұмыстан кейінгі сусын - ең жақсысы!
Dialogue: 0,0:03:05.09,0:03:08.42,Default,,0,0,0,,Жақсы
Dialogue: 0,0:03:08.42,0:03:10.82,Default,,0,0,0,,Ауыстырылатын орташа жүгіру! ))
Dialogue: 0,0:03:13.26,0:03:15.26,Default,,0,0,0,,♬~
Dialogue: 0,0:03:15.26,0:03:17.43,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:15.26,0:03:17.43,Default,,0,0,0,,Мейрамханада ішкенде солай болады.
Dialogue: 0,0:03:17.43,0:03:19.43,Default,,0,0,0,,Бүгінгі Токи туралы не деуге болады?
Dialogue: 0,0:03:19.43,0:03:22.94,Default,,0,0,0,,Сіз кеше не пайдаландыңыз
Dialogue: 0,0:03:19.43,0:03:22.94,Default,,0,0,0,,Сіз қайтадан ақша таба бастайтын сияқтысыз.
Dialogue: 0,0:03:22.94,0:03:27.28,Default,,0,0,0,,Екеуі де солай істесе ше?
Dialogue: 0,0:03:22.94,0:03:27.28,Default,,0,0,0,,Олай қатты жүру мүмкін емес.
Dialogue: 0,0:03:27.28,0:03:30.61,Default,,0,0,0,,Айтпақшы, бүгін
Dialogue: 0,0:03:27.28,0:03:30.61,Default,,0,0,0,,Котобуки-сенпай да жоқ.
Dialogue: 0,0:03:30.61,0:03:32.61,Default,,0,0,0,,Баки де толық емес жұмыс күні.
Dialogue: 0,0:03:32.61,0:03:34.95,Default,,0,0,0,,Толық емес жұмыс күні?
Dialogue: 0,0:03:32.61,0:03:34.95,Default,,0,0,0,,Бұл адам?
Dialogue: 0,0:03:34.95,0:03:36.95,Default,,0,0,0,,Сіз секс-индустрияда танымалсыз ба?
Dialogue: 0,0:03:36.95,0:03:39.62,Default,,0,0,0,,Шоданцер болуы да мүмкін.
Dialogue: 0,0:03:39.62,0:03:42.46,Default,,0,0,0,,Котобуки Сенпайдың бейнесі қандай...
Dialogue: 0,0:03:42.46,0:03:45.63,Default,,0,0,0,,Ахахха! Бұл олай емес.
Dialogue: 0,0:03:45.63,0:03:49.43,Default,,0,0,0,,Сонымен, сіз Бакидің толық емес жұмыс күніне барғыңыз келе ме?
Dialogue: 0,0:03:52.13,0:03:54.80,Default,,0,0,0,,Қош келдіңіз. Ах...
Dialogue: 0,0:03:54.80,0:03:58.30,Default,,0,0,0,,Yaho~ Мен ойнауға келдім.
Dialogue: 0,0:03:54.80,0:03:58.30,Default,,0,0,0,,О!
Dialogue: 0,0:04:00.24,0:04:03.25,Default,,0,0,0,,Сіз бармен болдыңыз.
Dialogue: 0,0:04:00.24,0:04:03.25,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:03.25,0:04:05.91,Default,,0,0,0,,Мен кейде толық емес жұмыс күнімен жұмыс істеймін.
Dialogue: 0,0:04:05.91,0:04:08.08,Default,,0,0,0,,Не болды?Балалар сендер
Dialogue: 0,0:04:08.08,0:04:12.59,Default,,0,0,0,,((Бұл 200 000 иен болады
Dialogue: 0,0:04:12.59,0:04:16.09,Default,,0,0,0,,Әй, кел! Эй, кел! ))
Dialogue: 0,0:04:18.09,0:04:20.60,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:04:18.09,0:04:20.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:20.60,0:04:22.93,Default,,0,0,0,,Сіз қандай дүкенді елестетесіз?
Dialogue: 0,0:04:22.93,0:04:25.77,Default,,0,0,0,,Бұл қарапайым дүкен.
Dialogue: 0,0:04:25.77,0:04:30.61,Default,,0,0,0,,Бұл жер арзан ғана емес, сонымен қатар арзан.
Dialogue: 0,0:04:25.77,0:04:30.61,Default,,0,0,0,,Бұл бір тиын.
Dialogue: 0,0:04:30.61,0:04:35.28,Default,,0,0,0,,Магистр тіпті студенттерге ұнайтын дүкен жасайды
Dialogue: 0,0:04:30.61,0:04:35.28,Default,,0,0,0,,Өйткені бұл менің ұраным
Dialogue: 0,0:04:35.28,0:04:37.95,Default,,0,0,0,,Сәлем, қош келдіңіз
Dialogue: 0,0:04:37.95,0:04:40.95,Default,,0,0,0,,Жас тұтынушылардың көп екені рас.
Dialogue: 0,0:04:40.95,0:04:43.79,Default,,0,0,0,,Қош келдіңіз Азуса-чан
Dialogue: 0,0:04:43.79,0:04:46.29,Default,,0,0,0,,Аа~ Сәлеметсіз бе, ұстаз
Dialogue: 0,0:04:48.29,0:04:50.29,Default,,0,0,0,,Сен Рюкунның кішісісің бе?
Dialogue: 0,0:04:50.29,0:04:53.80,Default,,0,0,0,,Иә
Dialogue: 0,0:04:50.29,0:04:53.80,Default,,0,0,0,,Ол Бакидің толық емес жұмыс күні қайда жұмыс істейтінін көргісі келеді.
Dialogue: 0,0:04:53.80,0:04:56.23,Default,,0,0,0,,Сонымен? Қараңызшы, сіз қалай ойлайсыз?
Dialogue: 0,0:04:56.23,0:04:59.57,Default,,0,0,0,,Мен жай ғана өзімді жайсыз сезінемін.
Dialogue: 0,0:04:56.23,0:04:59.57,Default,,0,0,0,,Қашан бұлыңғыр болады?
Dialogue: 0,0:04:59.57,0:05:01.90,Default,,0,0,0,,Тістеріңізді қорғаңыз.
Dialogue: 0,0:05:01.90,0:05:05.57,Default,,0,0,0,,Ол Тұтынушыдан
Dialogue: 0,0:05:01.90,0:05:05.57,Default,,0,0,0,,Бұл танымал.
Dialogue: 0,0:05:05.57,0:05:10.25,Default,,0,0,0,,Маған ұнайтын адам бар
Dialogue: 0,0:05:05.57,0:05:10.25,Default,,0,0,0,,Жақсы болмайтын сияқты...
Dialogue: 0,0:05:10.25,0:05:14.25,Default,,0,0,0,,Ахаха! Көп уайымдама
Dialogue: 0,0:05:10.25,0:05:14.25,Default,,0,0,0,,Батыл болыңыз және бар күшіңізді салыңыз!
Dialogue: 0,0:05:14.25,0:05:16.25,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:16.25,0:05:19.59,Default,,0,0,0,,Іс жақсы болмаған кезде➡︎
Dialogue: 0,0:05:19.59,0:05:22.59,Default,,0,0,0,,Мен
Dialogue: 0,0:05:19.59,0:05:22.59,Default,,0,0,0,,Таңға дейін шағымданамын.
Dialogue: 0,0:05:24.59,0:05:27.43,Default,,0,0,0,,Мен одан
Dialogue: 0,0:05:24.59,0:05:27.43,Default,,0,0,0,,Маған Рю-кун көбірек ұнайтын шығар...
Dialogue: 0,0:05:27.43,0:05:29.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.43,0:05:31.43,Default,,0,0,0,,Ұстаз, оның басына пышақ салыңыз
Dialogue: 0,0:05:31.43,0:05:34.10,Default,,0,0,0,,Менен де шанышқы
Dialogue: 0,0:05:31.43,0:05:34.10,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:05:34.10,0:05:37.94,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:05:34.10,0:05:37.94,Default,,0,0,0,,Неліктен сізді дәл осылай айыптап отыр?
Dialogue: 0,0:05:37.94,0:05:41.28,Default,,0,0,0,,Бармен жұмысы ше?
Dialogue: 0,0:05:37.94,0:05:41.28,Default,,0,0,0,,Бұл танымал емес пе?
Dialogue: 0,0:05:41.28,0:05:43.95,Default,,0,0,0,,Аа, бұл жай ғана жұмысты түзету деп ойлаймын.
Dialogue: 0,0:05:43.95,0:05:45.95,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:45.95,0:05:49.45,Default,,0,0,0,,Баки табиғи
Dialogue: 0,0:05:45.95,0:05:49.45,Default,,0,0,0,,Менің ойымша, бұл сіздің жақсы сөздер айтқаныңыз үшін.
Dialogue: 0,0:05:49.45,0:05:51.62,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:05:49.45,0:05:51.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:51.62,0:05:54.12,Default,,0,0,0,,Неге балалар, сендер де жасап көрмеске?
Dialogue: 0,0:05:54.12,0:05:56.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:01.23,0:06:05.23,Default,,0,0,0,,Хе... хе~
Dialogue: 0,0:06:01.23,0:06:05.23,Default,,0,0,0,,Екеуі бірге жақсы көрінеді.
Dialogue: 0,0:06:07.40,0:06:09.57,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:07.40,0:06:09.57,Default,,0,0,0,,Жоқ, жақсы...
Dialogue: 0,0:06:09.57,0:06:11.57,Default,,0,0,0,,Сіз нені айтасыз... А?
Dialogue: 0,0:06:11.57,0:06:13.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:13.58,0:06:17.41,Default,,0,0,0,,Ішетін кеште киім кию...
Dialogue: 0,0:06:13.58,0:06:17.41,Default,,0,0,0,,Бұл өте біртүрлі сезім.
Dialogue: 0,0:06:17.41,0:06:19.92,Default,,0,0,0,,А, мен түсіндім, көремін.
Dialogue: 0,0:06:17.41,0:06:19.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:19.92,0:06:22.08,Default,,0,0,0,,Мен мүлде түсінбеймін бе?
Dialogue: 0,0:06:22.08,0:06:26.59,Default,,0,0,0,,Енді екеумізге.
Dialogue: 0,0:06:22.08,0:06:26.59,Default,,0,0,0,,Мен Азуса-чаннан және басқалардан бізге қызмет етуді сұраймын.
Dialogue: 0,0:06:26.59,0:06:30.26,Default,,0,0,0,,Ах ха...
Dialogue: 0,0:06:26.59,0:06:30.26,Default,,0,0,0,,Жарайды, жайбарақат, сабыр ет.
Dialogue: 0,0:06:30.26,0:06:33.10,Default,,0,0,0,,Егер біз
Dialogue: 0,0:06:30.26,0:06:33.10,Default,,0,0,0,,Сәтсіздікке ұшырау дұрыс емес пе?
Dialogue: 0,0:06:33.10,0:06:37.60,Default,,0,0,0,,О? Сіз де жасайсыз ба?
Dialogue: 0,0:06:33.10,0:06:37.60,Default,,0,0,0,,Тек ол ғана жұтылып кеткен азаматтардың өкпе-ренішін қайтара алады
Dialogue: 0,0:06:37.60,0:06:39.77,Default,,0,0,0,,бойынша қалай тапсырыс беруге болады?
Dialogue: 0,0:06:39.77,0:06:42.60,Default,,0,0,0,,Не? Ал...
Dialogue: 0,0:06:39.77,0:06:42.60,Default,,0,0,0,,Басты жүргізуші Кадзухико Хиби дәл сағат 18:00-де жүрек талмасынан өліп қалады.
Dialogue: 0,0:06:42.60,0:06:46.61,Default,,0,0,0,,Мен ген рифмін
Dialogue: 0,0:06:42.60,0:06:46.61,Default,,0,0,0,,Сонда дәл солай
Dialogue: 0,0:06:46.61,0:06:48.61,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:53.62,0:06:56.55,Default,,0,0,0,,Бұл гендік рифма
Dialogue: 0,0:06:53.62,0:06:56.55,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:06:56.55,0:07:00.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:56.55,0:07:00.56,Default,,0,0,0,,Түсіндім, аты айтып тұрғандай.
Dialogue: 0,0:07:00.56,0:07:02.89,Default,,0,0,0,,Джин мен лайм?
Dialogue: 0,0:07:02.89,0:07:06.06,Default,,0,0,0,,Жақсы! Мен бұрағышпын!
Dialogue: 0,0:07:06.06,0:07:09.06,Default,,0,0,0,,Бұрандалы?
Dialogue: 0,0:07:06.06,0:07:09.06,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:13.74,0:07:16.74,Default,,0,0,0,,Бұрағыш
Dialogue: 0,0:07:13.74,0:07:16.74,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:07:16.74,0:07:19.74,Default,,0,0,0,,Не?
Dialogue: 0,0:07:16.74,0:07:19.74,Default,,0,0,0,,Бұл «бірдеңе» емес пе?
Dialogue: 0,0:07:19.74,0:07:21.91,Default,,0,0,0,,Бұл күлкілі емес екені анық!
Dialogue: 0,0:07:21.91,0:07:23.91,Default,,0,0,0,,Бұл басқаша болды, солай емес пе?
Dialogue: 0,0:07:23.91,0:07:26.42,Default,,0,0,0,,Бірақ егер ол бұрағыш болса
Dialogue: 0,0:07:23.91,0:07:26.42,Default,,0,0,0,,Бұл жалғыз нұсқа
Dialogue: 0,0:07:26.42,0:07:29.25,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:07:26.42,0:07:29.25,Default,,0,0,0,,Мен болғандықтан ғана ойнамайсың ба?
Dialogue: 0,0:07:29.25,0:07:32.09,Default,,0,0,0,,Мен жүгері дорбаларын жүк көліктеріне тиеп, қоймаға апаратынмын.
Dialogue: 0,0:07:29.25,0:07:32.09,Default,,0,0,0,,Ешкім нәтижелерге сәйкес келмейді.
Dialogue: 0,0:07:32.09,0:07:35.76,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:07:32.09,0:07:35.76,Default,,0,0,0,,Алдыңғы жеңіл әзіл.
Dialogue: 0,0:07:35.76,0:07:38.76,Default,,0,0,0,,Бұл бұранда драйвері.
Dialogue: 0,0:07:38.76,0:07:40.76,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:07:45.60,0:07:47.77,Default,,0,0,0,,Әй, бұл басқаша көрінеді!
Dialogue: 0,0:07:47.77,0:07:50.77,Default,,0,0,0,,Сонымен
Dialogue: 0,0:07:47.77,0:07:50.77,Default,,0,0,0,,Нақты жүргізуші болғаныңыз үшін көп...
Dialogue: 0,0:07:50.77,0:07:53.28,Default,,0,0,0,,Ақыр соңында, мен тапсырысымды өзгертемін!
Dialogue: 0,0:07:53.28,0:07:55.88,Default,,0,0,0,,Бұл «Mosco Mole» деп аталады!
Dialogue: 0,0:07:55.88,0:07:58.21,Default,,0,0,0,,Хмм... Мос...
Dialogue: 0,0:07:58.21,0:08:00.21,Default,,0,0,0,,Түсініктеме
Dialogue: 0,0:08:02.55,0:08:04.55,Default,,0,0,0,,Маримо!
Dialogue: 0,0:08:02.55,0:08:04.55,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:08:04.55,0:08:07.72,Default,,0,0,0,,Сіз не туралы айтып отырсыз!?
Dialogue: 0,0:08:07.72,0:08:10.39,Default,,0,0,0,,Мұны байыппен орындаңыз!
Dialogue: 0,0:08:10.39,0:08:13.40,Default,,0,0,0,,Жақсы, жақсы
Dialogue: 0,0:08:10.39,0:08:13.40,Default,,0,0,0,,Барлығы тәжірибе
Dialogue: 0,0:08:13.40,0:08:18.07,Default,,0,0,0,,Олар қызық балалар.
Dialogue: 0,0:08:13.40,0:08:18.07,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:08:18.07,0:08:21.24,Default,,0,0,0,,Егер сіз білмесеңіз
Dialogue: 0,0:08:18.07,0:08:21.24,Default,,0,0,0,,Осыны тексеріңіз
Dialogue: 0,0:08:21.24,0:08:24.91,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:08:21.24,0:08:24.91,Default,,0,0,0,,Егер сізде бұл болса, қорқатын ештеңе жоқ!
Dialogue: 0,0:08:24.91,0:08:27.91,Default,,0,0,0,,Басынан жақсырақ
Dialogue: 0,0:08:24.91,0:08:27.91,Default,,0,0,0,,Саған бергенімді қалаймын.
Dialogue: 0,0:08:27.91,0:08:32.58,Default,,0,0,0,,Бірақ коктейль қалай аталады?
Dialogue: 0,0:08:27.91,0:08:32.58,Default,,0,0,0,,Түсіну қиын нәрселер көп.
Dialogue: 0,0:08:32.58,0:08:35.25,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:08:32.58,0:08:35.25,Default,,0,0,0,,Себебі сізде қиял жетіспейді.
Dialogue: 0,0:08:35.25,0:08:40.26,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:08:35.25,0:08:40.26,Default,,0,0,0,,Мен болсам, аты ғана
Dialogue: 0,0:08:35.25,0:08:40.26,Default,,0,0,0,,Сіз оны оңай кескіндей аласыз.
Dialogue: 0,0:08:40.26,0:08:42.42,Default,,0,0,0,,Мәселен, бұл туралы не деуге болады?
Dialogue: 0,0:08:42.42,0:08:44.82,Default,,0,0,0,,«Жағажайдағы секс»
Dialogue: 0,0:08:46.76,0:08:49.26,Default,,0,0,0,,Хэхе... хехехе...
Dialogue: 0,0:08:49.26,0:08:51.26,Default,,0,0,0,,«Шие гүлі»
Dialogue: 0,0:08:53.27,0:08:55.20,Default,,0,0,0,,А...
Dialogue: 0,0:08:55.20,0:08:57.21,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:08:57.21,0:08:59.71,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:57.21,0:08:59.71,Default,,0,0,0,,Бұл сізге бәрін елестетуге мүмкіндік береді!
Dialogue: 0,0:08:59.71,0:09:01.88,Default,,0,0,0,,Сіз
Dialogue: 0,0:08:59.71,0:09:01.88,Default,,0,0,0,,Мен оны жай ғана елестеткен шығармын!
Dialogue: 0,0:09:01.88,0:09:04.21,Default,,0,0,0,,Тоқта! Бұл соншалықты шіркін!
Dialogue: 0,0:09:04.21,0:09:07.22,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:09:04.21,0:09:07.22,Default,,0,0,0,,Мынадай сәнді жерде➡︎
Dialogue: 0,0:09:07.22,0:09:09.89,Default,,0,0,0,,қолайлырақ
Dialogue: 0,0:09:07.22,0:09:09.89,Default,,0,0,0,,Кейбір өзара әрекеттесу бар, солай ма?
Dialogue: 0,0:09:09.89,0:09:12.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:09.89,0:09:12.05,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:09:12.05,0:09:15.25,Default,,0,0,0,,Фильмдер мен драмаларға қараңыз.
Dialogue: 0,0:09:12.05,0:09:15.25,Default,,0,0,0,,Бұл жалпы емес пе?
Dialogue: 0,0:09:17.23,0:09:19.23,Default,,0,0,0,,()
Dialogue: 0,0:09:21.73,0:09:25.07,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:09:25.07,0:09:27.40,Default,,0,0,0,,Хохо
Dialogue: 0,0:09:25.07,0:09:27.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:27.40,0:09:30.07,Default,,0,0,0,,Ал, сізге.
Dialogue: 0,0:09:27.40,0:09:30.07,Default,,0,0,0,,Бұл мүмкін емес шығар.
Dialogue: 0,0:09:30.07,0:09:34.08,Default,,0,0,0,,Сіз не айтасыз? Дөрекі!
Dialogue: 0,0:09:30.07,0:09:34.08,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:09:34.08,0:09:36.28,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:09:34.08,0:09:36.28,Default,,0,0,0,,О!
Dialogue: 0,0:09:42.75,0:09:44.75,Default,,0,0,0,,Бұл менің сыйлығым
Dialogue: 0,0:09:51.09,0:09:54.60,Default,,0,0,0,,Уау! Көздер! Менің көзім!
Dialogue: 0,0:09:54.60,0:09:56.60,Default,,0,0,0,,Көздеріңмен шаттаныңдар
Dialogue: 0,0:09:56.60,0:09:58.77,Default,,0,0,0,,Менің сұлу бейнем бұзылды!
Dialogue: 0,0:09:58.77,0:10:01.27,Default,,0,0,0,,Адамның көз алдында
Dialogue: 0,0:09:58.77,0:10:01.27,Default,,0,0,0,,Алкоголь құятын нәрсе бар ма?
Dialogue: 0,0:10:01.27,0:10:05.44,Default,,0,0,0,,Шулы! бәрі
Dialogue: 0,0:10:01.27,0:10:05.44,Default,,0,0,0,,Маған алкогольді лақтыр!
Dialogue: 0,0:10:05.44,0:10:08.44,Default,,0,0,0,,Бұл екеуі жақсы дос.
Dialogue: 0,0:10:08.44,0:10:11.28,Default,,0,0,0,,Сол жігіттер
Dialogue: 0,0:10:08.44,0:10:11.28,Default,,0,0,0,,Біз әрқашан бірге боламыз.
Dialogue: 0,0:10:11.28,0:10:13.95,Default,,0,0,0,,Әй, сенің қандай қарым-қатынасың бар?
Dialogue: 0,0:10:13.95,0:10:18.12,Default,,0,0,0,,Бұл екеуінің арасында қандай байланыс бар?
Dialogue: 0,0:10:13.95,0:10:18.12,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:10:18.12,0:10:21.12,Default,,0,0,0,,Бұл жалаңаш қарым-қатынас!
Dialogue: 0,0:10:21.12,0:10:25.29,Default,,0,0,0,,Хахахаха! Тағы да қалжыңдап тұрсың ба?
Dialogue: 0,0:10:25.29,0:10:29.13,Default,,0,0,0,,Жоқ, бұл рас.
Dialogue: 0,0:10:25.29,0:10:29.13,Default,,0,0,0,,Неліктен осы адаммен тексеруге болмайды?
Dialogue: 0,0:10:29.13,0:10:32.13,Default,,0,0,0,,Мен... Иори-кун
Dialogue: 0,0:10:29.13,0:10:32.13,Default,,0,0,0,,Сізден бірдеңе сұрасам болады ма?
Dialogue: 0,0:10:32.13,0:10:34.14,Default,,0,0,0,,Иә
Dialogue: 0,0:10:34.14,0:10:38.47,Default,,0,0,0,,Мм... сенің сүйіктің бар ма?
Dialogue: 0,0:10:38.47,0:10:44.48,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:38.47,0:10:44.48,Default,,0,0,0,,Бар десең, бар.
Dialogue: 0,0:10:44.48,0:10:46.98,Default,,0,0,0,,《Тек жағдайда》
Dialogue: 0,0:10:46.98,0:10:51.49,Default,,0,0,0,,Иә, ол бала
Dialogue: 0,0:10:46.98,0:10:51.49,Default,,0,0,0,,Сіздің шашыңыз қанша?
Dialogue: 0,0:10:51.49,0:10:53.82,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:10:53.82,0:10:57.43,Default,,0,0,0,,Бұл керемет көрінеді
Dialogue: 0,0:10:53.82,0:10:57.43,Default,,0,0,0,,Мазмұны табиғи...
Dialogue: 0,0:10:57.43,0:10:59.43,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:59.43,0:11:03.63,Default,,0,0,0,,Екеуінің арасында кедергілер көп пе?
Dialogue: 0,0:11:05.60,0:11:08.10,Default,,0,0,0,,Иә, дәл солай.
Dialogue: 0,0:11:10.11,0:11:12.11,Default,,0,0,0,,Неліктен мұны істейсіз?
Dialogue: 0,0:11:12.11,0:11:16.95,Default,,0,0,0,,Мен... жоқ, бәрі жақсы.
Dialogue: 0,0:11:12.11,0:11:16.95,Default,,0,0,0,,Махаббаттың пішіні әр адамда әртүрлі.
Dialogue: 0,0:11:16.95,0:11:21.62,Default,,0,0,0,,Иә, жоқ... Мен таң қалдым.
Dialogue: 0,0:11:16.95,0:11:21.62,Default,,0,0,0,,Мен біртүрлі шөлдеп тұрмын.
Dialogue: 0,0:11:21.62,0:11:25.12,Default,,0,0,0,,Улонг шайы ше?
Dialogue: 0,0:11:21.62,0:11:25.12,Default,,0,0,0,,Арнайы қараңыз
Dialogue: 0,0:11:25.12,0:11:27.12,Default,,0,0,0,,Маған анау улонг шайы керек емес.
Dialogue: 0,0:11:27.12,0:11:30.12,Default,,0,0,0,,Жарайды, мен аламын деп ойлаймын.
Dialogue: 0,0:11:27.12,0:11:30.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:35.46,0:11:38.47,Default,,0,0,0,,Хик Хик…
Dialogue: 0,0:11:35.46,0:11:38.47,Default,,0,0,0,,Арьярия
Dialogue: 0,0:11:38.47,0:11:40.47,Default,,0,0,0,,Ұстаз, сіз жақсы ішпейсіз.
Dialogue: 0,0:11:40.47,0:11:43.47,Default,,0,0,0,,Егер сіз сол затты ішсеңіз
Dialogue: 0,0:11:40.47,0:11:43.47,Default,,0,0,0,,Бұл қалыпты жағдай емес пе?
Dialogue: 0,0:11:43.47,0:11:46.98,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:11:43.47,0:11:46.98,Default,,0,0,0,,Ұстаз бұлай оянбайды.
Dialogue: 0,0:11:46.98,0:11:51.65,Default,,0,0,0,,Бұл бізде толық емес жұмыс күні ғана...
Dialogue: 0,0:11:46.98,0:11:51.65,Default,,0,0,0,,Мен мас емеспін!
Dialogue: 0,0:11:51.65,0:11:55.42,Default,,0,0,0,,Бұл взводтың миссиясы –
Dialogue: 0,0:11:51.65,0:11:55.42,Default,,0,0,0,,Тек қоңырау шалыңыз.
Dialogue: 0,0:11:55.42,0:11:58.92,Default,,0,0,0,,Ұстаз! Ұстаз!
Dialogue: 0,0:12:01.76,0:12:04.59,Default,,0,0,0,,Қалай болса да айтамын➡︎
Dialogue: 0,0:12:04.59,0:12:10.79,Default,,0,0,0,,Мен осылай ұйықтасам
Dialogue: 0,0:12:04.59,0:12:10.79,Default,,0,0,0,,Қандай жағдай болса да, сен білмейсің.
Dialogue: 0,0:12:15.77,0:12:18.44,Default,,0,0,0,,Тағы бір сусынға барайық!
Dialogue: 0,0:12:18.44,0:12:22.11,Default,,0,0,0,,Мен бұл шебердің мұндай болады деп күткен жоқпын.
Dialogue: 0,0:12:18.44,0:12:22.11,Default,,0,0,0,,Бірден қайта тірілу үшін...
Dialogue: 0,0:12:22.11,0:12:24.78,Default,,0,0,0,,Сіз таңғаларлық нәрсе айттыңыз ба?
Dialogue: 0,0:12:24.78,0:12:28.28,Default,,0,0,0,,Жоқ, бұл қарапайым кеңес...
Dialogue: 0,0:12:38.29,0:12:41.13,Default,,0,0,0,,О!
Dialogue: 0,0:12:38.29,0:12:41.13,Default,,0,0,0,,Мен сыра сатып алдым.
Dialogue: 0,0:12:41.13,0:12:43.13,Default,,0,0,0,,Балалар, кешігіп қалдыңдар.
Dialogue: 0,0:12:43.13,0:12:45.13,Default,,0,0,0,,Якитори
Dialogue: 0,0:12:43.13,0:12:45.13,Default,,0,0,0,,Суық болып қалатын шығар.
Dialogue: 0,0:12:45.13,0:12:48.83,Default,,0,0,0,,Жаман, жаман, мен дәл қазір толық емес жұмыс күніммен жұмыс істейтінмін.
Dialogue: 0,0:12:51.47,0:12:53.48,Default,,0,0,0,,Олай болса, сау болыңыз!
Dialogue: 0,0:12:53.48,0:12:55.48,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:58.58,0:13:01.25,Default,,0,0,0,,Кейде мен кенеттен ойлаймын...
Dialogue: 0,0:13:01.25,0:13:03.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:01.25,0:13:03.25,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:03.25,0:13:05.75,Default,,0,0,0,,Неліктен менің қызым болмайды?
Dialogue: 0,0:13:05.75,0:13:07.76,Default,,0,0,0,,Жаман бет
Dialogue: 0,0:13:05.75,0:13:07.76,Default,,0,0,0,,Жаман мінез
Dialogue: 0,0:13:07.76,0:13:09.92,Default,,0,0,0,,Өмір нашар
Dialogue: 0,0:13:07.76,0:13:09.92,Default,,0,0,0,,Тек бас тартыңыз
Dialogue: 0,0:13:09.92,0:13:12.09,Default,,0,0,0,,Балалар сендер таңқаларлық қаталсыңдар!
Dialogue: 0,0:13:12.09,0:13:14.43,Default,,0,0,0,,Бұл туралы уайымдама, Ямамото.
Dialogue: 0,0:13:14.43,0:13:18.27,Default,,0,0,0,,Менің сыныбымда кімнің қызы бар?
Dialogue: 0,0:13:14.43,0:13:18.27,Default,,0,0,0,,Өйткені көп емес.
Dialogue: 0,0:13:18.27,0:13:20.60,Default,,0,0,0,,Ахаха жақсы
Dialogue: 0,0:13:20.60,0:13:24.61,Default,,0,0,0,,Солай емес пе? Китахара
Dialogue: 0,0:13:24.61,0:13:27.78,Default,,0,0,0,,Оған
Dialogue: 0,0:13:24.61,0:13:27.78,Default,,0,0,0,,Мен оны бір саусақпен ұстағаным жоқ!
Dialogue: 0,0:13:27.78,0:13:30.11,Default,,0,0,0,,Сіз не қызғанасыз
Dialogue: 0,0:13:27.78,0:13:30.11,Default,,0,0,0,,Мен ештеңе істеп жатқан жоқпын!
Dialogue: 0,0:13:30.11,0:13:32.95,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:30.11,0:13:32.95,Default,,0,0,0,,Егер солай болса, мен оны кешіремін.
Dialogue: 0,0:13:32.95,0:13:37.29,Default,,0,0,0,,Балалар, өткен күні сонша жерге бардыңдар.
Dialogue: 0,0:13:32.95,0:13:37.29,Default,,0,0,0,,Маған санкция салғанмен
Dialogue: 0,0:13:37.29,0:13:40.79,Default,,0,0,0,,Аа, ол кезде көңіл толқытар еді.
Dialogue: 0,0:13:40.79,0:13:44.13,Default,,0,0,0,,Митарай ерекше таң қалдырды.
Dialogue: 0,0:13:40.79,0:13:44.13,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:13:44.13,0:13:47.13,Default,,0,0,0,,Есінен танған кезде Китахараның аузында
Dialogue: 0,0:13:44.13,0:13:47.13,Default,,0,0,0,,Арамшөптерге сүңгу➡︎
Dialogue: 0,0:13:47.13,0:13:49.13,Default,,0,0,0,,Сіз «икебана» сияқты бірдеңе айттыңыз, солай ма?
Dialogue: 0,0:13:49.13,0:13:51.13,Default,,0,0,0,,Сендер адам емессіңдер.
Dialogue: 0,0:13:51.13,0:13:53.13,Default,,0,0,0,,(Нодзима)
Dialogue: 0,0:13:51.13,0:13:53.13,Default,,0,0,0,,Митараи туралы айтсақ...
Dialogue: 0,0:13:53.13,0:13:55.14,Default,,0,0,0,,Не?
Dialogue: 0,0:13:53.13,0:13:55.14,Default,,0,0,0,,Ол кенет➡︎
Dialogue: 0,0:13:55.14,0:13:57.57,Default,,0,0,0,,Сіздің қарым-қатынасыңыз нашар ма?
Dialogue: 0,0:13:55.14,0:13:57.57,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:57.57,0:14:01.41,Default,,0,0,0,,Тіпті ол мұны істей алады!
Dialogue: 0,0:13:57.57,0:14:01.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:01.41,0:14:03.58,Default,,0,0,0,,Жарайды, бетке қарасаңыз➡︎
Dialogue: 0,0:14:03.58,0:14:06.75,Default,,0,0,0,,Оның сүйген қызы болса, қызық болмас еді.
Dialogue: 0,0:14:03.58,0:14:06.75,Default,,0,0,0,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың, иә?
Dialogue: 0,0:14:06.75,0:14:09.75,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:14:06.75,0:14:09.75,Default,,0,0,0,,Егер сенің қызың болса, не істер едің?
Dialogue: 0,0:14:09.75,0:14:12.25,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:14:12.25,0:14:14.59,Default,,0,0,0,,Мен оған сенемін.
Dialogue: 0,0:14:14.59,0:14:17.76,Default,,0,0,0,,Мен әлі де қазіргі сыныпта оқимын.
Dialogue: 0,0:14:14.59,0:14:17.76,Default,,0,0,0,,Сіз үйренбеген кезде➡︎
Dialogue: 0,0:14:17.76,0:14:21.60,Default,,0,0,0,,Маған бірінші қоңырау шалған адам болды
Dialogue: 0,0:14:17.76,0:14:21.60,Default,,0,0,0,,Бұл Митарай болатын.
Dialogue: 0,0:14:21.60,0:14:25.27,Default,,0,0,0,,((Сіз бұрын сабақтан жазбалар алдыңыз ба?
Dialogue: 0,0:14:21.60,0:14:25.27,Default,,0,0,0,,Маған суретке түсуге рұқсат бересіз бе? ))
Dialogue: 0,0:14:25.27,0:14:27.77,Default,,0,0,0,,Сіздің арқаңызда мен де Нодзимамен таныстым➡︎
Dialogue: 0,0:14:27.77,0:14:30.77,Default,,0,0,0,,Осылайша, барлығымен бірге
Dialogue: 0,0:14:27.77,0:14:30.77,Default,,0,0,0,,Енді сіз ішімдік кешін өткізе аласыз
Dialogue: 0,0:14:30.77,0:14:32.77,Default,,0,0,0,,Ямамото…
Dialogue: 0,0:14:32.77,0:14:34.78,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:32.77,0:14:34.78,Default,,0,0,0,,О
Dialogue: 0,0:14:34.78,0:14:37.45,Default,,0,0,0,,Әйтеуір Митарайды да шақырайық.
Dialogue: 0,0:14:37.45,0:14:39.61,Default,,0,0,0,,Маған қоңырау шалғыңыз келе ме?
Dialogue: 0,0:14:39.61,0:14:44.95,Default,,0,0,0,,📱
Dialogue: 0,0:14:44.95,0:14:48.12,Default,,0,0,0,,📱(Митараи) Хмм... Сәлеметсіз бе?
Dialogue: 0,0:14:44.95,0:14:48.12,Default,,0,0,0,,О, Митарай?
Dialogue: 0,0:14:48.12,0:14:50.96,Default,,0,0,0,,Мен қазір Ямамотоның үйінде ішіп жатырмын.
Dialogue: 0,0:14:48.12,0:14:50.96,Default,,0,0,0,,Бос уақытыңыз болса...
Dialogue: 0,0:14:50.96,0:14:54.63,Default,,0,0,0,,📱(Митараи) Нашар. 15 минут...
Dialogue: 0,0:14:50.96,0:14:54.63,Default,,0,0,0,,Жоқ, мен сізге 30 минуттан кейін хабарласамын.
Dialogue: 0,0:14:54.63,0:14:56.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:56.56,0:14:58.73,Default,,0,0,0,,📱Не болды?
Dialogue: 0,0:14:58.73,0:15:01.24,Default,,0,0,0,,📱(Митараи) Бұл ештеңе емес.
Dialogue: 0,0:15:01.24,0:15:05.91,Default,,0,0,0,,Хмм... түсіндім. 30 минутта.
Dialogue: 0,0:15:05.91,0:15:11.25,Default,,0,0,0,,Сіз әйелмен жыныстық қатынастасыз ба?
Dialogue: 0,0:15:05.91,0:15:11.25,Default,,0,0,0,,(Қоңырауды ажырату дыбысы)
Dialogue: 0,0:15:11.25,0:15:14.58,Default,,0,0,0,,...
Dialogue: 0,0:15:11.25,0:15:14.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:14.58,0:15:16.75,Default,,0,0,0,,(Каори) Эмм… есіктер сағат 3-те ашылады, ал жарыс 3:30-да басталады.
Dialogue: 0,0:15:14.58,0:15:16.75,Default,,0,0,0,,Сол себепті біз жақсы араласпаймыз.
Dialogue: 0,0:15:16.75,0:15:20.92,Default,,0,0,0,,Олай болса солай айт.
Dialogue: 0,0:15:16.75,0:15:20.92,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:15:20.92,0:15:25.26,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:15:20.92,0:15:25.26,Default,,0,0,0,,Мен оны өртеп жіберемін.
Dialogue: 0,0:15:25.26,0:15:27.26,Default,,0,0,0,,Оның үйін кім біледі?
Dialogue: 0,0:15:27.26,0:15:29.43,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:15:27.26,0:15:29.43,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:15:29.43,0:15:32.10,Default,,0,0,0,,Сізге
Dialogue: 0,0:15:29.43,0:15:32.10,Default,,0,0,0,,Мен сені кейінірек марапаттаймын.
Dialogue: 0,0:15:32.10,0:15:36.10,Default,,0,0,0,,Жарайсың ба? Сөзсіз
Dialogue: 0,0:15:32.10,0:15:36.10,Default,,0,0,0,,Оның шынайы сезімін сезінуіне жол берме!
Dialogue: 0,0:15:40.28,0:15:42.28,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:42.28,0:15:45.28,Default,,0,0,0,,А, жоқ, бұл ештеңе емес.
Dialogue: 0,0:15:42.28,0:15:45.28,Default,,0,0,0,,Осы балаға не болған екен…
Dialogue: 0,0:15:48.45,0:15:51.95,Default,,0,0,0,,Біз жалғастырамыз ба?
Dialogue: 0,0:15:48.45,0:15:51.95,Default,,0,0,0,,Қазірдің өзінде... ecchi
Dialogue: 0,0:15:51.95,0:15:54.29,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:51.95,0:15:54.29,Default,,0,0,0,,[External:12AECDEA283E4D07F88B9F2B740E4F86] Рақмет!
Dialogue: 0,0:15:54.29,0:15:57.73,Default,,0,0,0,,《Олар болуы мүмкін бе?
Dialogue: 0,0:15:57.73,0:16:00.56,Default,,0,0,0,,Жоқ, келуге әлі ерте! 》
Dialogue: 0,0:16:00.56,0:16:04.73,Default,,0,0,0,,⚞Пошта арқылы!
Dialogue: 0,0:16:00.56,0:16:04.73,Default,,0,0,0,,сені бәсекелес деп санайтын Бакуго мен Тодороки емес
Dialogue: 0,0:16:04.73,0:16:08.24,Default,,0,0,0,,⚞Митараи-сан!
Dialogue: 0,0:16:04.73,0:16:08.24,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:16:08.24,0:16:10.41,Default,,0,0,0,,Мен баруым керек пе?
Dialogue: 0,0:16:10.41,0:16:14.74,Default,,0,0,0,,Бұл жақсы. Әзірге бұл көбірек...
Dialogue: 0,0:16:10.41,0:16:14.74,Default,,0,0,0,,Ой
Dialogue: 0,0:16:14.74,0:16:18.41,Default,,0,0,0,,⚞Митараи-сан! Бұл пошта!
Dialogue: 0,0:16:14.74,0:16:18.41,Default,,0,0,0,,(қағу)
Dialogue: 0,0:16:18.41,0:16:22.08,Default,,0,0,0,,Мен саған әлі де телефон соғып жатырмын...
Dialogue: 0,0:16:18.41,0:16:22.08,Default,,0,0,0,,⚞Митараи-сан!
Dialogue: 0,0:16:22.08,0:16:24.09,Default,,0,0,0,,Мен үйге барамын
Dialogue: 0,0:16:24.09,0:16:27.26,Default,,0,0,0,,⚞Тапсырысыңыз
Dialogue: 0,0:16:24.09,0:16:27.26,Default,,0,0,0,,200 AV ассортимент жинағы➡︎
Dialogue: 0,0:16:27.26,0:16:29.59,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:16:29.59,0:16:32.93,Default,,0,0,0,,200 AV!?
Dialogue: 0,0:16:29.59,0:16:32.93,Default,,0,0,0,,А, жануарлар туралы бейне.
Dialogue: 0,0:16:32.93,0:16:35.43,Default,,0,0,0,,Мен жақында жануарлар туралы білдім.
Dialogue: 0,0:16:35.43,0:16:37.43,Default,,0,0,0,,О... солай ма?
Dialogue: 0,0:16:37.43,0:16:40.60,Default,,0,0,0,,Гррр…
Dialogue: 0,0:16:37.43,0:16:40.60,Default,,0,0,0,,(шу)
Dialogue: 0,0:16:40.60,0:16:43.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:43.44,0:16:45.77,Default,,0,0,0,,⚞Кешіріңіз, осы жерден➡︎
Dialogue: 0,0:16:45.77,0:16:49.11,Default,,0,0,0,,Өйткені ол барлығына сәйкес келмейді
Dialogue: 0,0:16:45.77,0:16:49.11,Default,,0,0,0,,Оны ашыңыз!
Dialogue: 0,0:16:49.11,0:16:51.95,Default,,0,0,0,,Жануарлар туралы бейне...
Dialogue: 0,0:16:51.95,0:16:55.22,Default,,0,0,0,,О, не? Бұл біртүрлі емес пе?
Dialogue: 0,0:16:55.22,0:17:00.05,Default,,0,0,0,,《Бұл қулық
Dialogue: 0,0:16:55.22,0:17:00.05,Default,,0,0,0,,Бұл сөзсіз олар! 》
Dialogue: 0,0:17:00.05,0:17:03.89,Default,,0,0,0,,Жарай ма? Ямамото
Dialogue: 0,0:17:00.05,0:17:03.89,Default,,0,0,0,,Сіздің қымбат DVD...
Dialogue: 0,0:17:03.89,0:17:05.89,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:17:05.89,0:17:09.40,Default,,0,0,0,,Менің бақытсыздығыммен
Dialogue: 0,0:17:05.89,0:17:09.40,Default,,0,0,0,,Оның бақытын жоя алсаң
Dialogue: 0,0:17:09.40,0:17:11.57,Default,,0,0,0,,Өте сергітеді!
Dialogue: 0,0:17:11.57,0:17:15.24,Default,,0,0,0,,Бұл қандай жақсы сезім
Dialogue: 0,0:17:11.57,0:17:15.24,Default,,0,0,0,,Ол гей жігіт.
Dialogue: 0,0:17:15.24,0:17:17.57,Default,,0,0,0,,Аа, ток өшіп қалды.
Dialogue: 0,0:17:17.57,0:17:20.24,Default,,0,0,0,,Жоқ, ол жігіт
Dialogue: 0,0:17:17.57,0:17:20.24,Default,,0,0,0,,Сіз күштеп өтуді қалайсыз ба?
Dialogue: 0,0:17:20.24,0:17:23.75,Default,,0,0,0,,Не істеу керек? Китахара!
Dialogue: 0,0:17:20.24,0:17:23.75,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:17:23.75,0:17:26.91,Default,,0,0,0,,Енді
Dialogue: 0,0:17:23.75,0:17:26.91,Default,,0,0,0,,Мені басқа ештеңе қызықтырмайды.
Dialogue: 0,0:17:26.91,0:17:30.08,Default,,0,0,0,,Мен қазір өзімді жақсы сезінемін.
Dialogue: 0,0:17:30.08,0:17:35.76,Default,,0,0,0,,⚞ Силуэт викторинасы. Бұл не?
Dialogue: 0,0:17:35.76,0:17:41.10,Default,,0,0,0,,《Ниетін білмеймін, бірақ бұл...
Dialogue: 0,0:17:35.76,0:17:41.10,Default,,0,0,0,,Бұл әйгілі «Венераның туылуы», солай ма? 》
Dialogue: 0,0:17:41.10,0:17:43.26,Default,,0,0,0,,⚞Жауап «Ойшыл»
Dialogue: 0,0:17:43.26,0:17:46.27,Default,,0,0,0,,《Ах!
Dialogue: 0,0:17:43.26,0:17:46.27,Default,,0,0,0,,Сіз қателесесіз! 》
Dialogue: 0,0:17:46.27,0:17:48.77,Default,,0,0,0,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:17:46.27,0:17:48.77,Default,,0,0,0,,Бұрын не болды?
Dialogue: 0,0:17:48.77,0:17:53.44,Default,,0,0,0,,А, жоқ, бұл ештеңе емес.
Dialogue: 0,0:17:48.77,0:17:53.44,Default,,0,0,0,,Әзірше маған қарашы.
Dialogue: 0,0:17:53.44,0:17:56.04,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:17:53.44,0:17:56.04,Default,,0,0,0,,Бұл жұмыс істеп тұрған сияқты...
Dialogue: 0,0:17:56.04,0:17:58.05,Default,,0,0,0,,Бұл әлі де жеткіліксіз.
Dialogue: 0,0:17:58.05,0:18:00.05,Default,,0,0,0,,Олай болса, осыны да аяқтаймыз.
Dialogue: 0,0:18:00.05,0:18:02.05,Default,,0,0,0,,Иә? Сен не істеп жатырсың?
Dialogue: 0,0:18:02.05,0:18:06.22,Default,,0,0,0,,LINE дисплей атауы
Dialogue: 0,0:18:02.05,0:18:06.22,Default,,0,0,0,,«Ами» болып өзгертілді
Dialogue: 0,0:18:06.22,0:18:09.52,Default,,0,0,0,,📱(діріл дыбысы)
Dialogue: 0,0:18:11.56,0:18:14.76,Default,,0,0,0,,Гаха! Бұл спам хабарлама...
Dialogue: 0,0:18:11.56,0:18:14.76,Default,,0,0,0,,Оны маған қарызға бер!
Dialogue: 0,0:18:18.40,0:18:20.40,Default,,0,0,0,,Хмф!
Dialogue: 0,0:18:18.40,0:18:20.40,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:20.40,0:18:22.40,Default,,0,0,0,,Не?Бұл
Dialogue: 0,0:18:22.40,0:18:24.91,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:18:22.40,0:18:24.91,Default,,0,0,0,,Менің досым есімін өзгертті➡︎
Dialogue: 0,0:18:24.91,0:18:27.74,Default,,0,0,0,,Мен жай ғана еркелік ойнап жатырмын
Dialogue: 0,0:18:27.74,0:18:30.24,Default,,0,0,0,,(Рио) Бұл жай ғана кездейсоқтық, білесің бе.
Dialogue: 0,0:18:27.74,0:18:30.24,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:18:30.24,0:18:33.92,Default,,0,0,0,,Менің айналамда әйелдер жоқ
Dialogue: 0,0:18:30.24,0:18:33.92,Default,,0,0,0,,Мен саған айттым...
Dialogue: 0,0:18:33.92,0:18:37.09,Default,,0,0,0,,Маған сенбесеңіз
Dialogue: 0,0:18:33.92,0:18:37.09,Default,,0,0,0,,Кейінірек Бұл адамның хабар тарихы➡︎
Dialogue: 0,0:18:37.09,0:18:39.59,Default,,0,0,0,,Мен саған бәрін көрсетемін... Уф...
Dialogue: 0,0:18:39.59,0:18:43.59,Default,,0,0,0,,Бейбақ, мұнда кел
Dialogue: 0,0:18:39.59,0:18:43.59,Default,,0,0,0,,Әйелдердің жоқтығы қандай жақсы!
Dialogue: 0,0:18:43.59,0:18:45.59,Default,,0,0,0,,Біз не істей аламыз?
Dialogue: 0,0:18:45.59,0:18:47.60,Default,,0,0,0,,AV актрисасының дыбысы
Dialogue: 0,0:18:45.59,0:18:47.60,Default,,0,0,0,,Қосылу
Dialogue: 0,0:18:47.60,0:18:49.60,Default,,0,0,0,,Мұндай уақытты қайдан табуға болады?
Dialogue: 0,0:18:49.60,0:18:52.10,Default,,0,0,0,,《Аа... ақымақ
Dialogue: 0,0:18:52.10,0:18:57.04,Default,,0,0,0,,Мен сенің соңынан еріп келдім.
Dialogue: 0,0:18:52.10,0:18:57.04,Default,,0,0,0,,Ол 3D әйел
Dialogue: 0,0:18:57.04,0:19:01.21,Default,,0,0,0,,Киелі жеріме барамын
Dialogue: 0,0:18:57.04,0:19:01.21,Default,,0,0,0,,Үйге барасыз ба?
Dialogue: 0,0:19:01.21,0:19:04.71,Default,,0,0,0,,⚞Осылай десеңіз
Dialogue: 0,0:19:01.21,0:19:04.71,Default,,0,0,0,,Маған сенуге болады, бірақ➡︎
Dialogue: 0,0:19:04.71,0:19:08.55,Default,,0,0,0,,Қазірдің өзінде! Смартфонды өшіріңіз
Dialogue: 0,0:19:04.71,0:19:08.55,Default,,0,0,0,,Ю-оний-чан
Dialogue: 0,0:19:08.55,0:19:11.22,Default,,0,0,0,,Не!
Dialogue: 0,0:19:08.55,0:19:11.22,Default,,0,0,0,,⚞(Митараи) Эй, эй ➡︎
Dialogue: 0,0:19:11.22,0:19:14.06,Default,,0,0,0,,Не болса да
Dialogue: 0,0:19:11.22,0:19:14.06,Default,,0,0,0,,Маған олай шақыруды доғарыңыз.
Dialogue: 0,0:19:14.06,0:19:18.06,Default,,0,0,0,,《Ей, сен мені аға дейсің!?》
Dialogue: 0,0:19:18.06,0:19:22.56,Default,,0,0,0,,Өйткені бұл бала кезден қалыптасқан әдет.
Dialogue: 0,0:19:18.06,0:19:22.56,Default,,0,0,0,,Ол жай ғана шығады.
Dialogue: 0,0:19:22.56,0:19:25.90,Default,,0,0,0,,Бұлай емес
Dialogue: 0,0:19:22.56,0:19:25.90,Default,,0,0,0,,кездесіп жүргенімізге сене алар емеспін.
Dialogue: 0,0:19:25.90,0:19:27.90,Default,,0,0,0,,⚞(Митараи) Себебі сен
Dialogue: 0,0:19:25.90,0:19:27.90,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет кездескенімізде➡︎
Dialogue: 0,0:19:27.90,0:19:31.40,Default,,0,0,0,,Уау, өте сүйкімді болып шықты!
Dialogue: 0,0:19:27.90,0:19:31.40,Default,,0,0,0,,Артық емес
Dialogue: 0,0:19:33.41,0:19:39.25,Default,,0,0,0,,《Олар бала күнгі достар!?》
Dialogue: 0,0:19:39.25,0:19:43.08,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:39.25,0:19:43.08,Default,,0,0,0,,Сіз істейтін ештеңе қалмады дейсіз бе?
Dialogue: 0,0:19:43.08,0:19:46.42,Default,,0,0,0,,Осы сияқты...
Dialogue: 0,0:19:43.08,0:19:46.42,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:19:46.42,0:19:48.42,Default,,0,0,0,,Имамура?
Dialogue: 0,0:19:48.42,0:19:54.10,Default,,0,0,0,,Мен сені микс дауыс деп атаймын
Dialogue: 0,0:19:48.42,0:19:54.10,Default,,0,0,0,,Мен сізге оны қалай айту керектігін көрсетемін!
Dialogue: 0,0:19:54.10,0:19:57.27,Default,,0,0,0,,Неге жылайсың? Сіз
Dialogue: 0,0:19:57.27,0:20:01.94,Default,,0,0,0,,Өйткені менде тек сен бар
Dialogue: 0,0:19:57.27,0:20:01.94,Default,,0,0,0,,(Рио) Бұл жай ғана кездейсоқтық, білесің бе.
Dialogue: 0,0:20:01.94,0:20:04.94,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:20:04.94,0:20:07.78,Default,,0,0,0,,⚞Ю-кун? Мұнда
Dialogue: 0,0:20:04.94,0:20:07.78,Default,,0,0,0,,Ғафу!
Dialogue: 0,0:20:07.78,0:20:10.78,Default,,0,0,0,,Бұл жігіттің табиғи әйел дауысы бар...
Dialogue: 0,0:20:10.78,0:20:12.78,Default,,0,0,0,,Аралас дауыс дегеніміз не?
Dialogue: 0,0:20:12.78,0:20:15.62,Default,,0,0,0,,Табиғи дауыс сияқты қатты дыбыстарды шығару
Dialogue: 0,0:20:12.78,0:20:15.62,Default,,0,0,0,,Техника сияқты
Dialogue: 0,0:20:15.62,0:20:18.12,Default,,0,0,0,,Сіз кейде
Dialogue: 0,0:20:15.62,0:20:18.12,Default,,0,0,0,,Сіз түсінбейтін арнайы дағдылар➡︎
Dialogue: 0,0:20:18.12,0:20:21.62,Default,,0,0,0,,Сізде жасырылған нәрсе бар.
Dialogue: 0,0:20:18.12,0:20:21.62,Default,,0,0,0,,Хмф, мені олай мақтама.
Dialogue: 0,0:20:21.62,0:20:23.62,Default,,0,0,0,,Жақсы! Имамура!
Dialogue: 0,0:20:23.62,0:20:25.63,Default,,0,0,0,,Әлгі қаншық баласына
Dialogue: 0,0:20:23.62,0:20:25.63,Default,,0,0,0,,Маған нұсқау беріңіз!
Dialogue: 0,0:20:25.63,0:20:27.63,Default,,0,0,0,,О!
Dialogue: 0,0:20:27.63,0:20:30.63,Default,,0,0,0,,Эй Ю-кун!
Dialogue: 0,0:20:27.63,0:20:30.63,Default,,0,0,0,,Бұл балалар кімдер!?
Dialogue: 0,0:20:30.63,0:20:34.47,Default,,0,0,0,,Бар, солай ма?
Dialogue: 0,0:20:30.63,0:20:34.47,Default,,0,0,0,,Неге шықпайсың!?
Dialogue: 0,0:20:34.47,0:20:37.47,Default,,0,0,0,,Сол түн маған
Dialogue: 0,0:20:34.47,0:20:37.47,Default,,0,0,0,,«Мен сені сүйемін» деген адам➡︎ болды
Dialogue: 0,0:20:37.47,0:20:39.64,Default,,0,0,0,,Өтірік болды ма? Апыр-ай!
Dialogue: 0,0:20:39.64,0:20:44.15,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:20:39.64,0:20:44.15,Default,,0,0,0,,Менімен енді хабарласпа.
Dialogue: 0,0:20:44.15,0:20:46.15,Default,,0,0,0,,Күтіңіз... күтіңіз!
Dialogue: 0,0:20:46.15,0:20:48.15,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:20:48.15,0:20:50.32,Default,,0,0,0,,Wonderful
Dialogue: 0,0:20:50.32,0:20:53.15,Default,,0,0,0,,Бұл менің ер досымның жұмысы.
Dialogue: 0,0:20:53.15,0:20:55.26,Default,,0,0,0,,Мен қазір олармен байланысты үземін.
Dialogue: 0,0:20:55.26,0:20:57.43,Default,,0,0,0,,Бұған кім сенеді!
Dialogue: 0,0:20:57.43,0:21:00.43,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:20:57.43,0:21:00.43,Default,,0,0,0,,Бұл жағымсыз оқиға болды.
Dialogue: 0,0:21:00.43,0:21:04.27,Default,,0,0,0,,Бұдан былай ол сатқын болады.
Dialogue: 0,0:21:00.43,0:21:04.27,Default,,0,0,0,,Емделейік
Dialogue: 0,0:21:04.27,0:21:06.60,Default,,0,0,0,,Басыңыз! Мен оны мүлде сағындым!
Dialogue: 0,0:21:06.60,0:21:09.60,Default,,0,0,0,,Иә? ше? Китахара
Dialogue: 0,0:21:09.60,0:21:12.77,Default,,0,0,0,,Әлі де сол сатқынға ұқсайды
Dialogue: 0,0:21:09.60,0:21:12.77,Default,,0,0,0,,Сіз қарап отырсыз ба?
Dialogue: 0,0:21:12.77,0:21:15.94,Default,,0,0,0,,Бұл жігіт әлдеқашан
Dialogue: 0,0:21:12.77,0:21:15.94,Default,,0,0,0,,Сен бізбен айырылысып кеттің.
Dialogue: 0,0:21:15.94,0:21:20.45,Default,,0,0,0,,А, мен оның екеніне сенімдімін.
Dialogue: 0,0:21:15.94,0:21:20.45,Default,,0,0,0,,Ол бізбен байланысын үзетінін айтты.
Dialogue: 0,0:21:20.45,0:21:24.62,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:20.45,0:21:24.62,Default,,0,0,0,,Мен оған әлі де сенгім келеді.
Dialogue: 0,0:21:24.62,0:21:30.29,Default,,0,0,0,,Не айттыңыз...
Dialogue: 0,0:21:24.62,0:21:30.29,Default,,0,0,0,,Барлығы, оған жақсылап қараңдар.
Dialogue: 0,0:21:30.29,0:21:34.30,Default,,0,0,0,,Оның көздері әлі бұлыңғыр!
Dialogue: 0,0:21:34.30,0:21:37.47,Default,,0,0,0,,Түсінді. Мен сенен бас тартамын.
Dialogue: 0,0:21:37.47,0:21:42.80,Default,,0,0,0,,Иә, онда
Dialogue: 0,0:21:37.47,0:21:42.80,Default,,0,0,0,,Бірақ ол бұл жерден не істей алады?
Dialogue: 0,0:21:42.80,0:21:45.64,Default,,0,0,0,,Ол қоштасқалы жатыр
Dialogue: 0,0:21:42.80,0:21:45.64,Default,,0,0,0,,Бірдеңе айтсаңыз болғаны.
Dialogue: 0,0:21:45.64,0:21:49.48,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:21:45.64,0:21:49.48,Default,,0,0,0,,Мен түсінбеймін, бірақ айта аламын
Dialogue: 0,0:21:49.48,0:21:52.81,Default,,0,0,0,,Не?
Dialogue: 0,0:21:49.48,0:21:52.81,Default,,0,0,0,,Кузудың назары
Dialogue: 0,0:21:52.81,0:21:55.92,Default,,0,0,0,,Сезімдеріңмен не болып жатыр?
Dialogue: 0,0:21:55.92,0:21:59.25,Default,,0,0,0,,Соңғы бір нәрсе
Dialogue: 0,0:21:55.92,0:21:59.25,Default,,0,0,0,,Сізге айтайын
Dialogue: 0,0:21:59.25,0:22:02.59,Default,,0,0,0,,Не?
Dialogue: 0,0:21:59.25,0:22:02.59,Default,,0,0,0,,Енді біз➡︎
Dialogue: 0,0:22:02.59,0:22:06.26,Default,,0,0,0,,Біз енді ғашық болмаймыз...
Dialogue: 0,0:22:06.26,0:22:09.93,Default,,0,0,0,,Келесі жолы мені досыммен таныстыра аласыз ба?
Dialogue: 0,0:22:09.93,0:22:14.13,Default,,0,0,0,,Уф!Уф!
Dialogue: 0,0:22:19.61,0:22:24.31,Default,,0,0,0,,Біз ең жақсы достармыз!
Dialogue: 0,0:22:25.81,0:22:31.81,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
