Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.21,0:00:09.92,Default,,0,0,0,,Өте ыстық!
Dialogue: 0,0:00:10.34,0:00:12.92,Default,,0,0,0,,Бұл шынымен тропикалық ел сияқты~
Dialogue: 0,0:00:13.47,0:00:15.47,Default,,0,0,0,,Айна назарын өзіне аударады
Dialogue: 0,0:00:15.59,0:00:18.93,Default,,0,0,0,,Ах... Кешіріңіз, бірақ мүмкін...
Dialogue: 0,0:00:19.18,0:00:22.14,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:00:22.27,0:00:24.69,Default,,0,0,0,,Менің ойымша, ол жақтағыдан жақсырақ.
Dialogue: 0,0:00:24.81,0:00:26.94,Default,,0,0,0,,Өйткені ол адам бұрыннан бейтаныс адам.
Dialogue: 0,0:00:27.98,0:00:32.99,Default,,0,0,0,,♪~
Dialogue: 0,0:01:51.94,0:01:56.95,Default,,0,0,0,,~♪
Dialogue: 0,0:01:58.32,0:02:00.95,Default,,0,0,0,,Бүгіннен бастап үш түн осында боламыз.
Dialogue: 0,0:02:01.49,0:02:03.79,Default,,0,0,0,,Бұл шынымен де әдемі жер ме!?
Dialogue: 0,0:02:03.91,0:02:06.45,Default,,0,0,0,,Оу (Котото) Мен тамақты өзім дайындаймын.
Dialogue: 0,0:02:07.16,0:02:08.71,Default,,0,0,0,,Тіпті бассейн де бар, Китахара!
Dialogue: 0,0:02:08.92,0:02:12.46,Default,,0,0,0,,Не! (Токита) Хахаха Иә, үрейленбе.
Dialogue: 0,0:02:18.59,0:02:19.80,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:02:20.59,0:02:22.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:22.35,0:02:24.18,Default,,0,0,0,,Ол өте тар...
Dialogue: 0,0:02:24.31,0:02:26.89,Default,,0,0,0,,Екі адамдық бөлмеде төрт адам бар.
Dialogue: 0,0:02:27.02,0:02:29.14,Default,,0,0,0,,Оның тар екеніне көмектесу мүмкін емес.
Dialogue: 0,0:02:29.27,0:02:32.98,Default,,0,0,0,,Мүмкін менің ағаларым үлкен болғандықтан болар.
Dialogue: 0,0:02:33.27,0:02:34.32,Default,,0,0,0,,Егер бұл орын алса—
Dialogue: 0,0:02:34.44,0:02:37.74,Default,,0,0,0,,Мен немесе Китахара еденде ұйықтауға тура келеді.
Dialogue: 0,0:02:38.24,0:02:39.36,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:02:39.49,0:02:41.74,Default,,0,0,0,,Физикалық тұрғыдан басқа таңдау жоқ.
Dialogue: 0,0:02:42.12,0:02:43.70,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:02:43.83,0:02:46.74,Default,,0,0,0,,Әзірше шешемін, бірақ кейінірек ойланамын.
Dialogue: 0,0:02:46.95,0:02:49.50,Default,,0,0,0,,Не болса да, ең алдымен теңіз!
Dialogue: 0,0:02:49.75,0:02:52.38,Default,,0,0,0,,Ухухуууфуфу…
Dialogue: 0,0:02:52.50,0:02:54.84,Default,,0,0,0,,Өте қызық сияқты
Dialogue: 0,0:02:54.96,0:02:56.75,Default,,0,0,0,,Әрине!
Dialogue: 0,0:02:57.17,0:02:59.76,Default,,0,0,0,,А... Бұл, әрине, жақсы.
Dialogue: 0,0:03:00.22,0:03:01.26,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:03:01.38,0:03:04.30,Default,,0,0,0,,Әй, мен теңізге бірінші артқа барамын!
Dialogue: 0,0:03:04.43,0:03:05.76,Default,,0,0,0,,Уа!
Dialogue: 0,0:03:08.22,0:03:10.14,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:03:10.64,0:03:12.90,Default,,0,0,0,,О! (Иори) Тез кел!
Dialogue: 0,0:03:13.23,0:03:15.65,Default,,0,0,0,,Ах... бақыт
Dialogue: 0,0:03:15.98,0:03:18.74,Default,,0,0,0,,Бұл менің жастық шағымның беті
Dialogue: 0,0:03:18.86,0:03:22.16,Default,,0,0,0,,Жүрегіңіздің альбомын безендіретін асыл естеліктер...
Dialogue: 0,0:03:22.45,0:03:25.16,Default,,0,0,0,,(Иоридің күлкісі)
Dialogue: 0,0:03:25.53,0:03:28.29,Default,,0,0,0,,Менің альбом мозаикаға толы!
Dialogue: 0,0:03:28.41,0:03:31.33,Default,,0,0,0,,Жарайды, оны жалға беру туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:03:31.46,0:03:33.17,Default,,0,0,0,,Дәл.
Dialogue: 0,0:03:33.54,0:03:35.67,Default,,0,0,0,,Қозғалайық (Токита) Неге?
Dialogue: 0,0:03:35.79,0:03:39.05,Default,,0,0,0,,Мұнда адам жоқ, өз қалауыңызша киінуіңізге болады.
Dialogue: 0,0:03:39.55,0:03:41.97,Default,,0,0,0,,Біз көшіп жатырмыз, солай ма? (Токита) О... ой.
Dialogue: 0,0:03:42.09,0:03:43.93,Default,,0,0,0,,Мен түсінбеймін, бірақ түсінемін.
Dialogue: 0,0:03:44.05,0:03:45.93,Default,,0,0,0,,(шулы дауыстар)
Dialogue: 0,0:03:46.30,0:03:47.97,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:03:48.10,0:03:49.81,Default,,0,0,0,,Бұл кәдімгі жағажай.
Dialogue: 0,0:03:49.93,0:03:52.56,Default,,0,0,0,,Жарайды десең, осында істей аласың.
Dialogue: 0,0:03:52.69,0:03:54.94,Default,,0,0,0,,Бұл қызық сияқты.
Dialogue: 0,0:03:55.23,0:03:56.90,Default,,0,0,0,,Жарайды, мен саған сусын әкелейін.
Dialogue: 0,0:03:57.02,0:03:59.19,Default,,0,0,0,,А, мен де (Иори) О?
Dialogue: 0,0:04:01.40,0:04:04.03,Default,,0,0,0,,Қолшатырды жалға беру сияқты бірдеңе бар сияқты.
Dialogue: 0,0:04:04.16,0:04:05.78,Default,,0,0,0,,Мен оны қарызға аламын ба?
Dialogue: 0,0:04:05.99,0:04:07.45,Default,,0,0,0,,Сізге демалыс орны қажет болуы мүмкін
Dialogue: 0,0:04:07.91,0:04:09.29,Default,,0,0,0,,Егер сіз менің үйімді пайдалансаңыз—
Dialogue: 0,0:04:09.41,0:04:12.46,Default,,0,0,0,,Мен сізге қолшатырды тегін беремін (Кохеи/Иори) Иә?
Dialogue: 0,0:04:12.83,0:04:14.42,Default,,0,0,0,,«Қолдану» дегенді қалай түсінесіңдер?
Dialogue: 0,0:04:14.54,0:04:16.58,Default,,0,0,0,,Мен осылай істеп жатырмын.
Dialogue: 0,0:04:18.84,0:04:20.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:20.80,0:04:22.22,Default,,0,0,0,,Банан қайығы?
Dialogue: 0,0:04:22.88,0:04:25.47,Default,,0,0,0,,Олай болса, неге үшеуміз бірге мінбейміз?
Dialogue: 0,0:04:25.59,0:04:27.26,Default,,0,0,0,,А, жоқ, мен...
Dialogue: 0,0:04:27.39,0:04:29.76,Default,,0,0,0,,Қане мініп алайық, Китахара.
Dialogue: 0,0:04:29.89,0:04:32.23,Default,,0,0,0,,Сонымен мен... (Кохеи)...
Dialogue: 0,0:04:32.48,0:04:36.31,Default,,0,0,0,,Бүгін түнде қайда ұйықтау керектігін шешуге қалай қарайсыз?
Dialogue: 0,0:04:36.44,0:04:39.73,Default,,0,0,0,,Кім бірінші шайқаса, сол жеңіледі. (Иори) Иә?
Dialogue: 0,0:04:39.98,0:04:43.49,Default,,0,0,0,,Әрине, қорқамын десең, қолымнан келмейді.
Dialogue: 0,0:04:43.61,0:04:45.99,Default,,0,0,0,,Хм... сен маған айтасың.
Dialogue: 0,0:04:46.57,0:04:49.49,Default,,0,0,0,,Жоғары! Мен бұл шайқаста боламын!
Dialogue: 0,0:04:49.99,0:04:53.29,Default,,0,0,0,,Жарайды ма? Иори: Жақсы жасамасаң суға түсесің.
Dialogue: 0,0:04:53.41,0:04:57.25,Default,,0,0,0,,Жарайды, бізде құтқару кеудешелері мен стратегия бар.
Dialogue: 0,0:04:57.75,0:04:58.75,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:04:59.17,0:05:03.76,Default,,0,0,0,,Оның үстіне судан мәңгі қорқу мүмкін емес.
Dialogue: 0,0:05:04.72,0:05:06.13,Default,,0,0,0,,Айтпақшы, бұл—
Dialogue: 0,0:05:06.26,0:05:08.51,Default,,0,0,0,,Лақтыруға болады ма?
Dialogue: 0,0:05:09.43,0:05:11.01,Default,,0,0,0,,Көп емес.
Dialogue: 0,0:05:11.14,0:05:13.64,Default,,0,0,0,,Бұл жағдайда бұл жақсы сәйкес келмеуі мүмкін.
Dialogue: 0,0:05:13.77,0:05:14.77,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:15.10,0:05:17.19,Default,,0,0,0,,Олай болса, солай.
Dialogue: 0,0:05:17.31,0:05:20.52,Default,,0,0,0,,Теңіз спортынан ыңғайлы рахат алыңыз
Dialogue: 0,0:05:20.65,0:05:24.03,Default,,0,0,0,,Содан кейін тұтқадан ұстаңыз.
Dialogue: 0,0:05:28.61,0:05:30.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:32.08,0:05:33.29,Default,,0,0,0,,Құрметті сіз!
Dialogue: 0,0:05:33.62,0:05:35.41,Default,,0,0,0,,Сен қандай жексұрынсың!
Dialogue: 0,0:05:35.54,0:05:38.54,Default,,0,0,0,,Әрдайым осындай ақымақ нәрселерді ойлап табатын сенсің!
Dialogue: 0,0:05:38.67,0:05:41.04,Default,,0,0,0,,Екеуі бірдей нәрсені істеп жатыр.
Dialogue: 0,0:05:41.46,0:05:43.30,Default,,0,0,0,,Жүрейік (қозғалтқыш дыбысы)
Dialogue: 0,0:05:45.21,0:05:48.30,Default,,0,0,0,,(Иори мен Кохеидің айқайы)
Dialogue: 0,0:05:48.80,0:05:51.80,Default,,0,0,0,,Не болды, Кохэй, сенің жүзің шиеленісіп тұр?
Dialogue: 0,0:05:52.14,0:05:55.81,Default,,0,0,0,,Судан қорқатын сен емессің бе?
Dialogue: 0,0:05:56.23,0:05:58.90,Default,,0,0,0,,Олай болса мен сені бір қолыммен ұрысамын.
Dialogue: 0,0:05:59.02,0:06:00.10,Default,,0,0,0,,Бұл артық емес пе!
Dialogue: 0,0:06:00.23,0:06:01.73,Default,,0,0,0,,Жылдамдаңыз!
Dialogue: 0,0:06:01.86,0:06:03.82,Default,,0,0,0,,Ооооо! (Чиза) Баркер
Dialogue: 0,0:06:03.94,0:06:06.32,Default,,0,0,0,,(Иори мен Кохеидің айқайы)
Dialogue: 0,0:06:06.69,0:06:09.07,Default,,0,0,0,,Жақсы... Жастық.
Dialogue: 0,0:06:09.20,0:06:11.57,Default,,0,0,0,,Хахаха... (Чиса) Кя!
Dialogue: 0,0:06:11.70,0:06:14.08,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:06:15.33,0:06:19.08,Default,,0,0,0,,Арх... Менің қолымнан келеді! Мен аяғыммен ойнасам, мен бірдеңе істей аламын
Dialogue: 0,0:06:19.21,0:06:21.58,Default,,0,0,0,,Бірақ бұл оған бірдей нәрсе.
Dialogue: 0,0:06:21.75,0:06:23.59,Default,,0,0,0,,Өте қиын болды… Өтінемін, мені жалғыз қалдыр.
Dialogue: 0,0:06:23.92,0:06:26.17,Default,,0,0,0,,Мен бұл аяққа бірдеңе жасауым керек!
Dialogue: 0,0:06:26.92,0:06:29.09,Default,,0,0,0,,Мына жерде дауысты актер Кая Мизуки!
Dialogue: 0,0:06:29.22,0:06:31.09,Default,,0,0,0,,Мына жерде AV актрисасы бар!
Dialogue: 0,0:06:31.55,0:06:33.10,Default,,0,0,0,,Ал мына бағана бар.
Dialogue: 0,0:06:33.68,0:06:35.85,Default,,0,0,0,,Ах... (Теңізге құлаған дыбыс)
Dialogue: 0,0:06:35.97,0:06:37.85,Default,,0,0,0,,Құлап кетті (Азуза) Ой, жарайды.
Dialogue: 0,0:06:38.18,0:06:39.85,Default,,0,0,0,,Олар жалқау.
Dialogue: 0,0:06:39.98,0:06:42.48,Default,,0,0,0,,Мына бейбақ! (Кохи) Сен!
Dialogue: 0,0:06:42.61,0:06:43.86,Default,,0,0,0,,Екеуміз де.
Dialogue: 0,0:06:43.98,0:06:45.44,Default,,0,0,0,,Әй, көңілді болды ма?
Dialogue: 0,0:06:45.57,0:06:47.36,Default,,0,0,0,,Мен көңілді болдым, бірақ...
Dialogue: 0,0:06:47.61,0:06:50.40,Default,,0,0,0,,Керемет... Менің де жас болғым келеді.
Dialogue: 0,0:06:50.53,0:06:52.37,Default,,0,0,0,,(Иори мен Айнаның күлкісі)
Dialogue: 0,0:06:52.99,0:06:55.12,Default,,0,0,0,,Олай болса, сен де атқа мінгің келе ме? (Айна) Әй!
Dialogue: 0,0:06:55.62,0:06:56.83,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:07:00.75,0:07:03.38,Default,,0,0,0,,Енді оңға бұрылайық.
Dialogue: 0,0:07:07.09,0:07:09.05,Default,,0,0,0,,Тұрақтылықтың керемет сезімі...
Dialogue: 0,0:07:09.17,0:07:11.88,Default,,0,0,0,,Не болды? Айна (Коши) Көзіңе теңіз суы кірді ме?
Dialogue: 0,0:07:12.09,0:07:13.89,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:14.51,0:07:17.18,Default,,0,0,0,,Мен ойнадым, ойнадым~ (Кохеи) Шаршадым...
Dialogue: 0,0:07:17.31,0:07:19.64,Default,,0,0,0,,Уууу, әлі бірінші күн.
Dialogue: 0,0:07:20.10,0:07:21.89,Default,,0,0,0,,Екеуі де (Кохеи мен Иори) Буу!
Dialogue: 0,0:07:22.69,0:07:25.52,Default,,0,0,0,,Ертеңнен бастап лицензиялық курс бар.
Dialogue: 0,0:07:25.65,0:07:28.40,Default,,0,0,0,,Ұйықтар алдында оқулығыңызды қарап шығыңыз.
Dialogue: 0,0:07:28.86,0:07:29.99,Default,,0,0,0,,Уф
Dialogue: 0,0:07:30.11,0:07:32.41,Default,,0,0,0,,Енді ойлап қарасам, бұл сенің төсегің ғой.
Dialogue: 0,0:07:32.82,0:07:34.37,Default,,0,0,0,,Егер біреу қате әрекет етсе — тіпті ол жай ғана апаттық жағдай болса да —
Dialogue: 0,0:07:34.49,0:07:36.16,Default,,0,0,0,,Кім жеңді?
Dialogue: 0,0:07:39.41,0:07:41.41,Default,,0,0,0,,Толқындардың айырмашылығына байланысты бұл Кохеи болды.
Dialogue: 0,0:07:41.54,0:07:43.42,Default,,0,0,0,,Өте ақымақ!
Dialogue: 0,0:07:43.92,0:07:45.67,Default,,0,0,0,,Толқындар арасындағы айырмашылық қателік!
Dialogue: 0,0:07:45.79,0:07:48.92,Default,,0,0,0,,Иә? не болды? (Токита) О, шынымен...
Dialogue: 0,0:07:49.42,0:07:51.67,Default,,0,0,0,,Ой, кереуеттер жетіспеді ме?
Dialogue: 0,0:07:52.13,0:07:53.93,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:07:54.47,0:07:57.01,Default,,0,0,0,,Егер бұл орын алса, сіз дұрыс ұйықтай алмайсыз, солай ма?
Dialogue: 0,0:07:57.14,0:08:00.35,Default,,0,0,0,,Лицензиялық курс ұйқының болмауына байланысты қауіпті...
Dialogue: 0,0:08:00.60,0:08:02.94,Default,,0,0,0,,Сонымен, мұны істейміз бе? (Чиса/Азуса) Иә?
Dialogue: 0,0:08:03.06,0:08:04.94,Default,,0,0,0,,Ай!
Dialogue: 0,0:08:13.28,0:08:15.95,Default,,0,0,0,,Бұл бөлмеде аяқ-қолыңызды созуға болады, солай ма?
Dialogue: 0,0:08:16.28,0:08:19.70,Default,,0,0,0,,Лицензия курсы үшін дұрыс ұйықтауым керек.
Dialogue: 0,0:08:20.04,0:08:21.66,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:08:21.79,0:08:22.96,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:08:23.21,0:08:24.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:25.08,0:08:27.46,Default,,0,0,0,,(Нанака мен Азусаның ұйықтауы)
Dialogue: 0,0:08:28.13,0:08:29.96,Default,,0,0,0,,Хмм... (Иори) Уф!
Dialogue: 0,0:08:30.42,0:08:31.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:33.63,0:08:34.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:36.72,0:08:37.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:37.85,0:08:40.22,Default,,0,0,0,,(Кохеи мен оның достарының ұйқысы)
Dialogue: 0,0:08:40.35,0:08:42.23,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:08:45.31,0:08:48.23,Default,,0,0,0,,Эххехе…
Dialogue: 0,0:08:56.53,0:08:57.91,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:08:58.53,0:09:00.41,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:09:01.04,0:09:02.41,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:02.54,0:09:04.91,Default,,0,0,0,,Мен ұйықтап жатқанда маған хабарлама келді...
Dialogue: 0,0:09:06.25,0:09:08.33,Default,,0,0,0,,Ой… бұл қорқынышты!
Dialogue: 0,0:09:08.46,0:09:10.42,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:09:10.80,0:09:14.92,Default,,0,0,0,,Менің ойымша, Иори бұл екеуіне қарсы ештеңе істей алмайды.
Dialogue: 0,0:09:15.30,0:09:17.76,Default,,0,0,0,,Ұйқыңыз жетіспеуі мүмкін.
Dialogue: 0,0:09:17.89,0:09:20.81,Default,,0,0,0,,Сондықтан емтихан нәтижесі қорқынышты.
Dialogue: 0,0:09:20.93,0:09:21.93,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:09:22.22,0:09:24.31,Default,,0,0,0,,Жоқ, жоқ, бәрі жақсы.
Dialogue: 0,0:09:24.43,0:09:27.69,Default,,0,0,0,,Ұйқы жетіспеді ме, жоқ па бәрібір, ол бәрібір мылқау.
Dialogue: 0,0:09:28.27,0:09:29.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:29.56,0:09:31.86,Default,,0,0,0,,Біреу аздап айтысыңызшы.
Dialogue: 0,0:09:32.32,0:09:35.19,Default,,0,0,0,,Қайырлы таң, Иори.
Dialogue: 0,0:09:35.78,0:09:36.90,Default,,0,0,0,,Сізге айтайын...
Dialogue: 0,0:09:37.03,0:09:39.99,Default,,0,0,0,,Мен сенен жоғары балл алатыныма сенімдімін, солай ма?
Dialogue: 0,0:09:40.12,0:09:42.45,Default,,0,0,0,,Хмф! Бұл туралы ақымақтар жиі айтады
Dialogue: 0,0:09:42.62,0:09:45.79,Default,,0,0,0,,О? Мен неміс тілінде 17 ұпайды жиі айтамын.
Dialogue: 0,0:09:45.91,0:09:49.71,Default,,0,0,0,,Эй, жай ғана 20 ұпай алып, өзіңізді бастық етіп көрсетпеңіз.
Dialogue: 0,0:09:50.29,0:09:53.46,Default,,0,0,0,,20 ұпай? (Киса) 100 ұпай
Dialogue: 0,0:09:53.88,0:09:56.72,Default,,0,0,0,,Бұл, әрине, алаңдаушылық тудырады.
Dialogue: 0,0:09:56.84,0:09:58.55,Default,,0,0,0,,Кішкене байқап көргіңіз келе ме?
Dialogue: 0,0:09:58.68,0:10:01.72,Default,,0,0,0,,Эй, екеумізде де проблема бар (Иори/Кохеи), иә?
Dialogue: 0,0:10:02.22,0:10:04.97,Default,,0,0,0,,Суда ұзақ қашықтыққа қозғалу үшін қайсысы аз шаршайды?
Dialogue: 0,0:10:05.39,0:10:08.02,Default,,0,0,0,,А. Бетіңізді суға салып, төмен қаратып жатыңыз.
Dialogue: 0,0:10:08.14,0:10:10.31,Default,,0,0,0,,B Аомуке (Иори/Кохеи) Б
Dialogue: 0,0:10:10.44,0:10:11.98,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:10:12.77,0:10:16.24,Default,,0,0,0,,Ашық судағы сүңгуір қанша тереңдікке сүңги алады?
Dialogue: 0,0:10:16.69,0:10:17.86,Default,,0,0,0,,18 метр
Dialogue: 0,0:10:17.99,0:10:20.24,Default,,0,0,0,,Бұл ақылға қонымды мәселе.
Dialogue: 0,0:10:20.66,0:10:23.74,Default,,0,0,0,,А, онда мен саған ақылға қонымды сұрақ қояйын.
Dialogue: 0,0:10:24.29,0:10:26.95,Default,,0,0,0,,Киім ауыстырған кезде киім ауыстыратын бөлмені пайдаланбаңыз... (4 адам)
Dialogue: 0,0:10:27.08,0:10:29.50,Default,,0,0,0,,Мен мәселені әлі шешкен жоқпын...
Dialogue: 0,0:10:29.83,0:10:33.13,Default,,0,0,0,,Ал, қиын есептерді шығарып көрейік.
Dialogue: 0,0:10:33.25,0:10:36.01,Default,,0,0,0,,Сіз жылытпасаңыз, қолыңызды қозғалта алмайтын судың температурасы қандай?
Dialogue: 0,0:10:36.38,0:10:39.51,Default,,0,0,0,,Е, бұл... (Иори) 18 градус.
Dialogue: 0,0:10:39.63,0:10:41.01,Default,,0,0,0,,Не!
Dialogue: 0,0:10:41.26,0:10:42.89,Default,,0,0,0,,Сен істейсің, Иори.
Dialogue: 0,0:10:43.01,0:10:44.56,Default,,0,0,0,,Сен жақсы оқисың.
Dialogue: 0,0:10:44.68,0:10:46.02,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:10:46.35,0:10:49.27,Default,,0,0,0,,Ху... Кохэй: Сен білмейсің.
Dialogue: 0,0:10:49.77,0:10:53.69,Default,,0,0,0,,Мен ол бөлмеде оқулықты қанша оқып отырдым.
Dialogue: 0,0:10:53.94,0:10:56.78,Default,,0,0,0,,Мен көремін. (Котото) Жарақаттың сәтті екені рас па?
Dialogue: 0,0:10:57.23,0:10:59.99,Default,,0,0,0,,Бұл ойланбастан оқудың нәтижесі.
Dialogue: 0,0:11:00.11,0:11:02.49,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:11:03.74,0:11:05.53,Default,,0,0,0,,Қауіпсіз тоқтау тереңдігі қандай?
Dialogue: 0,0:11:05.74,0:11:07.70,Default,,0,0,0,,3-6 метр (дұрыс жауап қоңырауы)
Dialogue: 0,0:11:07.83,0:11:10.04,Default,,0,0,0,,О (Коши) Бұл дұрыс.
Dialogue: 0,0:11:10.25,0:11:13.92,Default,,0,0,0,,Сонымен балық аулау жіптері мен торларын кесуге арналған арнайы жүздері бар ілгектер туралы не деуге болады?
Dialogue: 0,0:11:14.29,0:11:15.80,Default,,0,0,0,,Z пышақ (дұрыс жауап қоңырауы)
Dialogue: 0,0:11:16.13,0:11:18.42,Default,,0,0,0,,Иә, иә (Котото) Бұл үлкен мәселе.
Dialogue: 0,0:11:18.80,0:11:20.17,Default,,0,0,0,,Бұл қол сигналы қандай?
Dialogue: 0,0:11:20.51,0:11:21.93,Default,,0,0,0,,«Сиіс» (Токита) Эй, күте тұрыңыз.
Dialogue: 0,0:11:22.05,0:11:23.55,Default,,0,0,0,,Сіз кенеттен не айтып тұрсыз?
Dialogue: 0,0:11:23.80,0:11:27.52,Default,,0,0,0,,А... Жоқ, жоқ, бұл «Мына жерден қара».
Dialogue: 0,0:11:27.77,0:11:29.68,Default,,0,0,0,,Хмм... онда бұл туралы ше?
Dialogue: 0,0:11:29.81,0:11:31.56,Default,,0,0,0,,``Жеңкеңізге қараңыз.''
Dialogue: 0,0:11:31.69,0:11:33.60,Default,,0,0,0,,Жоқ... олай емес.
Dialogue: 0,0:11:33.73,0:11:36.77,Default,,0,0,0,,Бұған қарамаңыз. Сіз оқулыққа назар аударуыңыз керек.
Dialogue: 0,0:11:36.90,0:11:39.03,Default,,0,0,0,,Оқулық бойынша... Оқулыққа назар аударыңыз (Чиса/Айна) Ах...
Dialogue: 0,0:11:39.15,0:11:42.15,Default,,0,0,0,,Оқыған жағдай есіме түсті.
Dialogue: 0,0:11:42.28,0:11:44.32,Default,,0,0,0,,Көзіңді жұмып тұрған жоқсың ба?
Dialogue: 0,0:11:44.70,0:11:48.99,Default,,0,0,0,,Адам, концентрацияны осы дәрежеде бұзу өте аянышты.
Dialogue: 0,0:11:49.95,0:11:51.33,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:11:58.59,0:12:00.01,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:00.13,0:12:01.84,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:02.26,0:12:03.26,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:12:03.38,0:12:05.34,Default,,0,0,0,,Мен оны көрмедім, Раракотан...
Dialogue: 0,0:12:05.72,0:12:08.60,Default,,0,0,0,,Сонда түні бойы ұйықтай алмадың ба?
Dialogue: 0,0:12:09.06,0:12:11.06,Default,,0,0,0,,Керісінше оның өңі жақсы.
Dialogue: 0,0:12:11.18,0:12:14.35,Default,,0,0,0,,Жоқ, мен ұйықтауға мәжбүр болдым. (Кохи) Қалай?
Dialogue: 0,0:12:14.90,0:12:17.23,Default,,0,0,0,,Өзіңізді өшіріңіз
Dialogue: 0,0:12:17.44,0:12:18.69,Default,,0,0,0,,Бұл қиын жұмыс.
Dialogue: 0,0:12:18.82,0:12:20.86,Default,,0,0,0,,Сіз ұйықтадым деп айта аласыз ба?
Dialogue: 0,0:12:21.28,0:12:24.28,Default,,0,0,0,,Қалай болғанда да, ешқандай проблема жоқ сияқты.
Dialogue: 0,0:12:24.41,0:12:27.83,Default,,0,0,0,,Біз таңғы ас дайындаймыз, сондықтан балалар оны қарап шығу керек.
Dialogue: 0,0:12:27.95,0:12:29.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:32.79,0:12:34.96,Default,,0,0,0,,Сіз осында жазасыз ба?
Dialogue: 0,0:12:35.08,0:12:37.38,Default,,0,0,0,,Мен оны ресми жерде өткізе ме деп ойладым...
Dialogue: 0,0:12:37.84,0:12:40.63,Default,,0,0,0,,Емтихан өте жұмсақ болып көрінеді.
Dialogue: 0,0:12:40.75,0:12:42.88,Default,,0,0,0,,Әрбір сұрақ үшін шамамен 4 таңдау бар.
Dialogue: 0,0:12:43.22,0:12:44.97,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:12:45.09,0:12:47.39,Default,,0,0,0,,Сонда біздің күш-жігеріміз қандай...
Dialogue: 0,0:12:47.51,0:12:49.93,Default,,0,0,0,,Мен не айтуым керек?
Dialogue: 0,0:12:50.06,0:12:52.14,Default,,0,0,0,,Қауіпсіздік техникасы туралы білім.
Dialogue: 0,0:12:52.27,0:12:54.64,Default,,0,0,0,,Қанша оқысаң да шығын бар ма?
Dialogue: 0,0:12:54.98,0:12:57.40,Default,,0,0,0,,Ух... (Кохэй) Сенің сезіміңді түсінемін.
Dialogue: 0,0:12:57.52,0:13:00.90,Default,,0,0,0,,Мен әдетте сүңгіген кезде саңылау тым үлкен.
Dialogue: 0,0:13:01.03,0:13:02.40,Default,,0,0,0,,Емтиханды бастайық~
Dialogue: 0,0:13:07.36,0:13:08.66,Default,,0,0,0,,Жақсы ма деп ойлаймын...
Dialogue: 0,0:13:08.78,0:13:11.16,Default,,0,0,0,,Иә? Сіз Иори үшін алаңдайсыз ба?
Dialogue: 0,0:13:11.41,0:13:14.66,Default,,0,0,0,,Жарайды, солай ма? (Чиса) Бірақ дәл қазір...
Dialogue: 0,0:13:15.12,0:13:16.67,Default,,0,0,0,,«Сиіс»
Dialogue: 0,0:13:17.04,0:13:18.67,Default,,0,0,0,,Бұл бірнеше таңдаулы сұрақ.
Dialogue: 0,0:13:18.79,0:13:21.05,Default,,0,0,0,,Ақымақ нәрсе жазуға орын жоқ.
Dialogue: 0,0:13:21.17,0:13:23.17,Default,,0,0,0,,Егер уайымдасаңыз, неге қарап көрмеске?
Dialogue: 0,0:13:23.46,0:13:25.09,Default,,0,0,0,,Кенеттен татами төсегі жарылып кетті.
Dialogue: 0,0:13:27.01,0:13:29.68,Default,,0,0,0,,Чи Чан шынымен сүйкімді.
Dialogue: 0,0:13:30.05,0:13:31.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:36.89,0:13:38.69,Default,,0,0,0,,А, а, а, а...
Dialogue: 0,0:13:39.15,0:13:41.94,Default,,0,0,0,,Ах... Чиса!
Dialogue: 0,0:13:43.32,0:13:44.69,Default,,0,0,0,,Не!
Dialogue: 0,0:13:46.82,0:13:48.49,Default,,0,0,0,,(Қағазды туралау дыбысы)
Dialogue: 0,0:13:48.61,0:13:50.45,Default,,0,0,0,,Иә, бәрі өтті.
Dialogue: 0,0:13:50.78,0:13:51.91,Default,,0,0,0,,Я...
Dialogue: 0,0:13:52.03,0:13:54.29,Default,,0,0,0,,Неліктен бетіңіз ісінген?
Dialogue: 0,0:13:54.41,0:13:56.21,Default,,0,0,0,,Бұл түнде қалудың зияны.
Dialogue: 0,0:14:01.42,0:14:03.46,Default,,0,0,0,,Барлығы, бастапқы қалдық қысым қандай?
Dialogue: 0,0:14:03.80,0:14:04.88,Default,,0,0,0,,200
Dialogue: 0,0:14:05.01,0:14:06.97,Default,,0,0,0,,Бұл 200. (Айна) Бұл 200.
Dialogue: 0,0:14:07.59,0:14:09.97,Default,,0,0,0,,Қалдық қысым 60-қа жеткенде маған хабарлаңыз.
Dialogue: 0,0:14:10.26,0:14:11.14,Default,,0,0,0,,Иә
Dialogue: 0,0:14:11.26,0:14:13.60,Default,,0,0,0,,60-та қате бар ма?
Dialogue: 0,0:14:13.72,0:14:15.47,Default,,0,0,0,,Жер бетіне шығу уақыты келді
Dialogue: 0,0:14:17.18,0:14:18.35,Default,,0,0,0,,BCD-де
Dialogue: 0,0:14:18.48,0:14:20.73,Default,,0,0,0,,Қуат үрлегішіндегі түймені басқан кезде—
Dialogue: 0,0:14:21.61,0:14:23.73,Default,,0,0,0,,Көкірекшеге ауа кіріп, ол қалқып шығады.
Dialogue: 0,0:14:24.90,0:14:29.49,Default,,0,0,0,,Оны жоғары қаратып, ауа мен раковинаны босату үшін осы түймені басыңыз.
Dialogue: 0,0:14:36.12,0:14:38.25,Default,,0,0,0,,Уау...
Dialogue: 0,0:14:38.62,0:14:42.00,Default,,0,0,0,,Уау! Уф... аахх
Dialogue: 0,0:14:47.30,0:14:49.55,Default,,0,0,0,,Реттегішті бір рет алып тастаңыз—
Dialogue: 0,0:14:50.05,0:14:52.85,Default,,0,0,0,,Суды төгіп, қайта орнатыңыз
Dialogue: 0,0:14:52.97,0:14:54.10,Default,,0,0,0,,Мен әлі бітірген жоқпын. Сенің артыңнан келемін.
Dialogue: 0,0:14:55.14,0:14:57.81,Default,,0,0,0,,Суды қалай шығаруға болады—
Dialogue: 0,0:14:58.43,0:15:00.52,Default,,0,0,0,,Қалай тыныс алу керек және
Dialogue: 0,0:15:01.19,0:15:04.11,Default,,0,0,0,,Екі әдіс бар: тазалау түймесін пайдалану.
Dialogue: 0,0:15:04.61,0:15:06.03,Default,,0,0,0,,Ережелерден бас тарту -
Dialogue: 0,0:15:06.69,0:15:08.78,Default,,0,0,0,,Және тағы да... Уф!
Dialogue: 0,0:15:09.24,0:15:10.74,Default,,0,0,0,,Ой, жоқ…
Dialogue: 0,0:15:12.66,0:15:14.53,Default,,0,0,0,,Ақырын және сабырлы
Dialogue: 0,0:15:16.24,0:15:18.50,Default,,0,0,0,,Чисаның бір нүктелік кеңесі
Dialogue: 0,0:15:18.75,0:15:22.54,Default,,0,0,0,,Егер сіз ережені ұмытып қалсаңыз, оң иықты бір рет төмен түсіріңіз.
Dialogue: 0,0:15:22.67,0:15:26.80,Default,,0,0,0,,Қолыңызды төменнен жоғарыға бұрсаңыз, шланг ұсталып қалады.
Dialogue: 0,0:15:27.09,0:15:29.55,Default,,0,0,0,,Жарайды, мен тазалау түймесін басамын.
Dialogue: 0,0:15:29.80,0:15:32.76,Default,,0,0,0,,Ах
Dialogue: 0,0:15:33.80,0:15:36.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:39.48,0:15:40.43,Default,,0,0,0,,Мен әлі бітірген жоқпын. Сенің артыңнан келемін.
Dialogue: 0,0:15:40.56,0:15:41.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:42.48,0:15:45.31,Default,,0,0,0,,Масканы сумен толтырып, суды сыртқа шығарыңыз
Dialogue: 0,0:15:46.32,0:15:49.53,Default,,0,0,0,,Масканың жоғарғы бөлігін ұстап, мұрын арқылы дем шығарыңыз—
Dialogue: 0,0:15:49.65,0:15:51.57,Default,,0,0,0,,Су ығыстырып, төменнен шығады.
Dialogue: 0,0:15:52.45,0:15:54.32,Default,,0,0,0,,Жарайды (Кохеи)
Dialogue: 0,0:15:55.41,0:15:56.62,Default,,0,0,0,,Дайын!
Dialogue: 0,0:15:58.45,0:15:59.54,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:15:59.66,0:16:02.29,Default,,0,0,0,,Уф!Уф...
Dialogue: 0,0:16:03.29,0:16:04.33,Default,,0,0,0,,Қалдық қысым дегеніміз не?
Dialogue: 0,0:16:04.67,0:16:05.83,Default,,0,0,0,,80
Dialogue: 0,0:16:05.96,0:16:08.09,Default,,0,0,0,,Бұл 60. (Айна) Бұл 60.
Dialogue: 0,0:16:08.63,0:16:10.84,Default,,0,0,0,,Бетке шығады (Aina/Iori/Kohei) Жарайды
Dialogue: 0,0:16:12.17,0:16:14.84,Default,,0,0,0,,Өйткені Окинавадағы теңіз басқа.
Dialogue: 0,0:16:15.68,0:16:18.43,Default,,0,0,0,,Су астында мәңгі қалғың келеді.
Dialogue: 0,0:16:18.56,0:16:20.52,Default,,0,0,0,,Бізге ауа-райы жақсы болды.
Dialogue: 0,0:16:20.64,0:16:23.60,Default,,0,0,0,,Hmph, қалдық қысым 60 жігіт (барлығы) иә?
Dialogue: 0,0:16:23.94,0:16:27.73,Default,,0,0,0,,Иә? Мен 180-де бастадым.
Dialogue: 0,0:16:27.86,0:16:30.86,Default,,0,0,0,,Дайвинг алдында сіз 200 дедіңіз, солай ма?
Dialogue: 0,0:16:30.99,0:16:32.49,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:32.61,0:16:34.86,Default,,0,0,0,,Біз соңғы қалдық қысым туралы айтып отырған сияқтымыз.
Dialogue: 0,0:16:35.41,0:16:36.91,Default,,0,0,0,,Бұл жабу кезіндегі мән бе?
Dialogue: 0,0:16:37.03,0:16:39.83,Default,,0,0,0,,Ештеңені ұрысқа айналдырмаңыздар, балалар.
Dialogue: 0,0:16:39.95,0:16:41.08,Default,,0,0,0,,Я...
Dialogue: 0,0:16:41.70,0:16:44.37,Default,,0,0,0,,Айтпақшы, үлкендеріңіз неше жаста болды?
Dialogue: 0,0:16:44.75,0:16:47.84,Default,,0,0,0,,Иә? Бұл 110 (Кобоши) бірдей.
Dialogue: 0,0:16:47.96,0:16:50.38,Default,,0,0,0,,120 (Киса) 130
Dialogue: 0,0:16:50.92,0:16:52.09,Default,,0,0,0,,Нанака ше?
Dialogue: 0,0:16:52.21,0:16:53.88,Default,,0,0,0,,Мен де Чиса-чанмен біргемін.
Dialogue: 0,0:16:54.13,0:16:57.14,Default,,0,0,0,,Сонымен... (Кохеи) Цифрлар әртүрлі.
Dialogue: 0,0:16:57.47,0:16:59.97,Default,,0,0,0,,Сонымен, сіз әлі де суға түсе алдыңыз, солай ма?
Dialogue: 0,0:17:00.14,0:17:01.14,Default,,0,0,0,,Мен осындамын, мама
Dialogue: 0,0:17:01.56,0:17:03.14,Default,,0,0,0,,Алдымен жоғары көтерілейік.
Dialogue: 0,0:17:03.31,0:17:05.39,Default,,0,0,0,,Сіз сүңгігеніңіз жақсы емес пе еді?
Dialogue: 0,0:17:05.56,0:17:08.36,Default,,0,0,0,,Хахаха бұл жұмыс істемейді.
Dialogue: 0,0:17:08.48,0:17:10.90,Default,,0,0,0,,Дайвинг – топтық әрекет.
Dialogue: 0,0:17:11.32,0:17:14.03,Default,,0,0,0,,Бір адам көтерілсе, бәріміз көтерілеміз.
Dialogue: 0,0:17:14.86,0:17:18.41,Default,,0,0,0,,Егер сізде бірнеше нұсқаушы болса, бұл басқа әңгіме.
Dialogue: 0,0:17:18.78,0:17:21.66,Default,,0,0,0,,Түсіндім... менің айтайын дегенім осы.
Dialogue: 0,0:17:21.79,0:17:24.46,Default,,0,0,0,,Мені ұстама, дөңес.
Dialogue: 0,0:17:24.58,0:17:28.04,Default,,0,0,0,,Ендеше неге маған жоғарыдан қарап тұрсың?
Dialogue: 0,0:17:28.25,0:17:32.30,Default,,0,0,0,,Мен топтық әрекетті айтқаннан кейін, мен шеңберді бұзып үлгердім...
Dialogue: 0,0:17:33.13,0:17:34.88,Default,,0,0,0,,Ұжымдық әрекет…
Dialogue: 0,0:17:36.76,0:17:39.68,Default,,0,0,0,,Сол баланың қасында сіз мүлде жаттығу жасай алмайсыз.
Dialogue: 0,0:17:40.10,0:17:42.68,Default,,0,0,0,,Аяғымды сүйретіп жатқаны ренжітті.
Dialogue: 0,0:17:43.10,0:17:46.39,Default,,0,0,0,,Кешіріңіз, бірақ сіз өзіңізді ұстай аласыз ба?
Dialogue: 0,0:17:47.56,0:17:49.19,Default,,0,0,0,,Айна? (Айна) А...
Dialogue: 0,0:17:49.31,0:17:51.44,Default,,0,0,0,,А-а... не?
Dialogue: 0,0:17:51.57,0:17:53.94,Default,,0,0,0,,Мен аң-таң болдым, бірақ сен жақсысың ба?
Dialogue: 0,0:17:54.40,0:17:56.40,Default,,0,0,0,,Не, шаршадың ба?
Dialogue: 0,0:17:56.53,0:17:58.03,Default,,0,0,0,,Рухың жетпейді, Кебако.
Dialogue: 0,0:17:58.16,0:18:00.16,Default,,0,0,0,,Сондықтан мені Кабако деп атама!
Dialogue: 0,0:18:00.28,0:18:02.70,Default,,0,0,0,,Сіздің физикалық күшіңіз бен рухыңызда ешқандай проблема жоқ.
Dialogue: 0,0:18:03.29,0:18:04.87,Default,,0,0,0,,Бұл жақсы болар еді.
Dialogue: 0,0:18:05.00,0:18:07.71,Default,,0,0,0,,Егер өзіңізді аздап болса да нашар сезінсеңіз, дереу айтыңыз.
Dialogue: 0,0:18:08.17,0:18:10.79,Default,,0,0,0,,Бұл үлкен мәселе деп ойламаңыз.
Dialogue: 0,0:18:10.92,0:18:13.46,Default,,0,0,0,,Теңіздегі өтіріктер қауіпті.
Dialogue: 0,0:18:13.88,0:18:15.26,Default,,0,0,0,,Сенің әрекетің тым балалық… немесе жай ғана қысқа көзді.
Dialogue: 0,0:18:16.63,0:18:19.26,Default,,0,0,0,,Егер сіздің жолдасыңыздың ауасы таусылып қалса —
Dialogue: 0,0:18:19.68,0:18:24.06,Default,,0,0,0,,Басқа адамға сегізаяқты, яғни қосалқы Reg.
Dialogue: 0,0:18:24.18,0:18:25.43,Default,,0,0,0,,(Азузаның тыныс алу дыбысы)
Dialogue: 0,0:18:25.56,0:18:27.68,Default,,0,0,0,,Досыңызбен ауаны бөлісу кезінде—
Dialogue: 0,0:18:27.81,0:18:30.15,Default,,0,0,0,,Қатты ұстап, жоғары көтерілу
Dialogue: 0,0:18:36.03,0:18:38.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:56.88,0:18:58.76,Default,,0,0,0,,Әдемі теңіз...
Dialogue: 0,0:18:59.51,0:19:02.76,Default,,0,0,0,,Барлығы су астында қалғысы келеді, солай ма?
Dialogue: 0,0:19:06.72,0:19:07.98,Default,,0,0,0,,Қалдық қысым дегеніміз не?
Dialogue: 0,0:19:09.02,0:19:10.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:11.81,0:19:14.06,Default,,0,0,0,,90 (Iori) 80
Dialogue: 0,0:19:14.19,0:19:17.28,Default,,0,0,0,,Екеуіміздің де әлі уақытымыз көп... Яғни...
Dialogue: 0,0:19:17.65,0:19:19.95,Default,,0,0,0,,Менің кесірімнен бәрі бітті...
Dialogue: 0,0:19:20.61,0:19:23.82,Default,,0,0,0,,Дәл қазір қалдық қысым 60 болды және әлі де көп орын бар еді.
Dialogue: 0,0:19:24.03,0:19:25.53,Default,,0,0,0,,Егер бұл аз ғана болса...
Dialogue: 0,0:19:26.58,0:19:27.62,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:30.37,0:19:31.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:32.96,0:19:35.04,Default,,0,0,0,,60 (Нанака) Жарайды
Dialogue: 0,0:19:39.30,0:19:40.59,Default,,0,0,0,,(цилиндрді қою дыбысы)
Dialogue: 0,0:19:43.22,0:19:44.05,Default,,0,0,0,,Я...
Dialogue: 0,0:19:45.85,0:19:47.81,Default,,0,0,0,,Эй Кебако (Айна) Ух...
Dialogue: 0,0:19:48.02,0:19:49.31,Default,,0,0,0,,Не?
Dialogue: 0,0:19:49.43,0:19:51.89,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:19:52.02,0:19:54.81,Default,,0,0,0,,Қалдық қысымды алдамақшы болдыңыз (Айна) Уф...
Dialogue: 0,0:19:54.94,0:19:59.07,Default,,0,0,0,,Жаңа ғана маған теңізде жатудың жаман екенін айтты.
Dialogue: 0,0:19:59.40,0:20:02.36,Default,,0,0,0,,Менде қанша қалдық қысым болса да...
Dialogue: 0,0:20:02.49,0:20:03.82,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:20:04.28,0:20:06.28,Default,,0,0,0,,Иә? (Айна) Өйткені...
Dialogue: 0,0:20:06.41,0:20:10.37,Default,,0,0,0,,Менің кесірімнен бәрі ерте кетуге тура келеді деп ойладым.
Dialogue: 0,0:20:10.50,0:20:15.13,Default,,0,0,0,,Не? Қалдық қысым ойынында жеңілгіңіз келмегендіктен өтірік айтуға тырысқан жоқсыз ба?
Dialogue: 0,0:20:15.25,0:20:17.34,Default,,0,0,0,,Мен мұны істемеймін!
Dialogue: 0,0:20:17.46,0:20:21.34,Default,,0,0,0,,Сонымен... үлкендеріңізге қиындық тудырмас үшін...
Dialogue: 0,0:20:21.97,0:20:24.89,Default,,0,0,0,,Мм... (Айна) А? не болды?
Dialogue: 0,0:20:25.01,0:20:27.05,Default,,0,0,0,,Жоқ, бұл не?
Dialogue: 0,0:20:27.18,0:20:29.81,Default,,0,0,0,,Менің ойымша, сізде адамдарға жақсы көзқарас жоқ.
Dialogue: 0,0:20:29.93,0:20:33.02,Default,,0,0,0,,Иә? не? Мен оны түсінбеймін, бірақ
Dialogue: 0,0:20:33.14,0:20:35.35,Default,,0,0,0,,Сіз түсінбейтін адамсыз, солай ма?
Dialogue: 0,0:20:35.85,0:20:39.15,Default,,0,0,0,,Сіздің ойыңызша, бұл адамдар бұл туралы ойлай ма?
Dialogue: 0,0:20:39.27,0:20:41.11,Default,,0,0,0,,О, а... (Иори) Кешіріңіз!
Dialogue: 0,0:20:41.24,0:20:43.11,Default,,0,0,0,,Тоқта... күт!?
Dialogue: 0,0:20:44.86,0:20:47.91,Default,,0,0,0,,Солай болатын сияқты (Токита) Мен түсінемін.
Dialogue: 0,0:20:48.03,0:20:50.16,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,0:20:50.29,0:20:52.62,Default,,0,0,0,,Білесің бе, Айна (Айна) иә.
Dialogue: 0,0:20:53.21,0:20:56.38,Default,,0,0,0,,Неліктен Айна бізбен бірге құрметті сөздер айтады?
Dialogue: 0,0:20:56.71,0:21:00.13,Default,,0,0,0,,Міне, мен жоғары курс студенті болғандықтан, бұл табиғи нәрсе...
Dialogue: 0,0:21:00.50,0:21:02.76,Default,,0,0,0,,Иә, иә, Айна үшін...
Dialogue: 0,0:21:02.88,0:21:06.26,Default,,0,0,0,,Үлкендерге құрмет көрсету табиғи нәрсе.
Dialogue: 0,0:21:06.55,0:21:07.72,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:21:07.84,0:21:10.64,Default,,0,0,0,,Олай болса, онда (Айна) Әй...
Dialogue: 0,0:21:11.10,0:21:14.89,Default,,0,0,0,,Сіз құрметті қарттардың төзімді болуы табиғи нәрсе деп ойлайсыз ба?
Dialogue: 0,0:21:15.39,0:21:19.31,Default,,0,0,0,,Бұл жақсы емес пе? Жаңадан бастағандардың ауаны тұтынуы жылдам.
Dialogue: 0,0:21:19.44,0:21:20.61,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:21:20.73,0:21:22.65,Default,,0,0,0,,Бұл анық емес пе?
Dialogue: 0,0:21:23.03,0:21:25.90,Default,,0,0,0,,Біз сізге қалағаныңызша кеңестерді үйретеміз.
Dialogue: 0,0:21:26.49,0:21:30.16,Default,,0,0,0,,Сондықтан келесі жолы оны жақсарта аламыз. (Азуза) Дұрыс.
Dialogue: 0,0:21:31.41,0:21:34.20,Default,,0,0,0,,Алайда, енді мұндай өтірік айтпауыңызды өтінемін.
Dialogue: 0,0:21:34.33,0:21:37.17,Default,,0,0,0,,Ешқашан, әсіресе қауіпсіздікке келгенде.
Dialogue: 0,0:21:37.29,0:21:40.13,Default,,0,0,0,,Адамның адалдығы ең жақсысы.
Dialogue: 0,0:21:40.25,0:21:41.92,Default,,0,0,0,,Міне (Айна) А...
Dialogue: 0,0:21:42.50,0:21:44.92,Default,,0,0,0,,Мұндағы үлкендер сәл басқаша, солай емес пе?
Dialogue: 0,0:21:45.97,0:21:47.88,Default,,0,0,0,,Ух... иә!
Dialogue: 0,0:21:51.76,0:21:55.68,Default,,0,0,0,,Бірақ Айнаны мазалайтыны осы.
Dialogue: 0,0:21:56.44,0:21:59.44,Default,,0,0,0,,Тәніңді де, жаныңды да бізге көрсете алмағандықтан емес пе?
Dialogue: 0,0:21:59.56,0:22:01.06,Default,,0,0,0,,Не? (Токита) Хмф!
Dialogue: 0,0:22:01.19,0:22:02.69,Default,,0,0,0,,Сіздің ойыңыз бар.
Dialogue: 0,0:22:02.86,0:22:04.48,Default,,0,0,0,,Суға түсу костюмдері жақсы!
Dialogue: 0,0:22:04.61,0:22:07.03,Default,,0,0,0,,Жоқ... бұл мүмкін емес. (Токита) Мысал көрсетейін.
Dialogue: 0,0:22:07.15,0:22:09.20,Default,,0,0,0,,Бұл да ағаның міндеті!
Dialogue: 0,0:22:09.32,0:22:10.70,Default,,0,0,0,,Жыл!
Dialogue: 0,0:22:11.12,0:22:12.45,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:22:12.58,0:22:15.33,Default,,0,0,0,,Иори-кун, бұл жақсы емес.
Dialogue: 0,0:22:15.45,0:22:17.46,Default,,0,0,0,,Не? Басқа проблемалар бар ма?
Dialogue: 0,0:22:17.83,0:22:20.88,Default,,0,0,0,,Хмм, ол қазір жүріп жатыр.
Dialogue: 0,0:22:21.00,0:22:23.46,Default,,0,0,0,,Тек Иори сәтсіз болуы мүмкін.
Dialogue: 0,0:22:23.59,0:22:27.42,Default,,0,0,0,,Ай!
Dialogue: 0,0:22:28.93,0:22:30.09,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:22:30.22,0:22:32.14,Default,,0,0,0,,Иә, шындап.
Dialogue: 0,0:22:34.64,0:22:36.56,Default,,0,0,0,,Қараңызшы, Китахара Майк
Dialogue: 0,0:22:36.68,0:22:38.48,Default,,0,0,0,,Мен де
Dialogue: 0,0:22:38.81,0:22:40.85,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:22:41.10,0:22:43.19,Default,,0,0,0,,О~ Ән сал, ән сал!
Dialogue: 0,0:22:43.32,0:22:44.69,Default,,0,0,0,,Бірге барайық
Dialogue: 0,0:22:45.98,0:22:50.99,Default,,0,0,0,,♪~
Dialogue: 0,0:23:50.17,0:23:55.30,Default,,0,0,0,,~♪
Dialogue: 0,0:23:55.43,0:23:57.43,Default,,0,0,0,,Менсор!
Dialogue: 0,0:24:03.52,0:24:06.27,Default,,0,0,0,,Кешіріңіз, сізбен араласуымды күтіңіз.
Dialogue: 0,0:24:06.73,0:24:07.90,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:24:08.02,0:24:09.44,Default,,0,0,0,,Мен суланып бара жатырмын ...
Dialogue: 0,0:24:09.65,0:24:12.15,Default,,0,0,0,,Киіміңді шеш... (Айна) Әй!
Dialogue: 0,0:24:12.57,0:24:14.82,Default,,0,0,0,,Жарайды, шешіңіз.
Dialogue: 0,0:24:14.95,0:24:17.83,Default,,0,0,0,,Сіз шынымен не істеп жатырсыз?
Dialogue: 0,0:24:19.33,0:24:25.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory