Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.59,0:00:08.10,Default,,0,0,0,,Жаңадан келген Иори-чан➡︎
Dialogue: 0,0:00:08.10,0:00:12.10,Default,,0,0,0,,Осы көктемде мен университет студенті болдым.
Dialogue: 0,0:00:08.10,0:00:12.10,Default,,0,0,0,,Өте ыстық~
Dialogue: 0,0:00:12.10,0:00:14.10,Default,,0,0,0,,Аяғынан шалынған қыздар
Dialogue: 0,0:00:14.10,0:00:17.44,Default,,0,0,0,,Бүгін мені ұсынғаныңыз үшін рахмет... Уф.
Dialogue: 0,0:00:17.44,0:00:20.44,Default,,0,0,0,,Ни~цу
Dialogue: 0,0:00:17.44,0:00:20.44,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:00:20.44,0:00:25.61,Default,,0,0,0,,Хаа ха ха... Түс пе...
Dialogue: 0,0:00:25.61,0:00:27.95,Default,,0,0,0,,Қандай қорқынышты түс...
Dialogue: 0,0:00:27.95,0:00:31.45,Default,,0,0,0,,Мен орта мектеп формасын киемін.
Dialogue: 0,0:00:27.95,0:00:31.45,Default,,0,0,0,,Оны не үшін кию керек...
Dialogue: 0,0:00:31.45,0:00:33.96,Default,,0,0,0,,Қайырлы таң. Эй!
Dialogue: 0,0:00:33.96,0:00:36.12,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:36.12,0:00:39.12,Default,,0,0,0,,Жоқ... иә!
Dialogue: 0,0:02:09.42,0:02:11.42,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:02:11.42,0:02:15.76,Default,,0,0,0,,Амал жоқ... Үлкендерге
Dialogue: 0,0:02:11.42,0:02:15.76,Default,,0,0,0,,Мен мұндай хоббиім бар деп ешқашан ойламаппын...
Dialogue: 0,0:02:15.76,0:02:19.76,Default,,0,0,0,,О? Не туралы айтып тұрсың, Иори?
Dialogue: 0,0:02:15.76,0:02:19.76,Default,,0,0,0,,Өйткені бұл форма!
Dialogue: 0,0:02:19.76,0:02:24.27,Default,,0,0,0,,Маған форма ұнайды, бірақ
Dialogue: 0,0:02:19.76,0:02:24.27,Default,,0,0,0,,Неліктен ол жоғары сыныптағы ұлдарға арналған?
Dialogue: 0,0:02:24.27,0:02:27.94,Default,,0,0,0,,Бүгін мен байсалдымын
Dialogue: 0,0:02:24.27,0:02:27.94,Default,,0,0,0,,Мен үйірме жұмыстарын орындауды ойлап жүрмін.
Dialogue: 0,0:02:27.94,0:02:30.44,Default,,0,0,0,,Э~?
Dialogue: 0,0:02:30.44,0:02:32.84,Default,,0,0,0,,Қайырлы таң... Иә?
Dialogue: 0,0:02:35.11,0:02:37.45,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:02:35.11,0:02:37.45,Default,,0,0,0,,Жоқ! Чиса!
Dialogue: 0,0:02:37.45,0:02:40.45,Default,,0,0,0,,Егер сіз мұны сүңгу үшін пайдалансаңыз, ол сізге беріледі!
Dialogue: 0,0:02:40.45,0:02:43.12,Default,,0,0,0,,Дайвинг? Ах...
Dialogue: 0,0:02:43.12,0:02:46.12,Default,,0,0,0,,Бұл уақыт әлдеқашан ба?
Dialogue: 0,0:02:43.12,0:02:46.12,Default,,0,0,0,,Осымен
Dialogue: 0,0:02:46.12,0:02:49.46,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:46.12,0:02:49.46,Default,,0,0,0,,Қалай ойлайсыз, Чисаны әдеттегідей қабылдап жатыр ма?
Dialogue: 0,0:02:49.46,0:02:52.79,Default,,0,0,0,,Сізге форма керек пе?
Dialogue: 0,0:02:52.79,0:02:57.57,Default,,0,0,0,,Бірақ біз мұны қалай пайдаланамыз?
Dialogue: 0,0:02:52.79,0:02:57.57,Default,,0,0,0,,Мұны істеу сізді акулалардан қорғай ма?
Dialogue: 0,0:02:57.57,0:03:01.57,Default,,0,0,0,,Бұл екеуі не туралы айтып жатыр?
Dialogue: 0,0:02:57.57,0:03:01.57,Default,,0,0,0,,Енді?
Dialogue: 0,0:03:03.57,0:03:06.07,Default,,0,0,0,,Олай болса, түсіндірейін.
Dialogue: 0,0:03:06.07,0:03:09.91,Default,,0,0,0,,Дайвинг үшін қолданылатын құрал-жабдықтар
Dialogue: 0,0:03:06.07,0:03:09.91,Default,,0,0,0,,Негізінен осылай...
Dialogue: 0,0:03:09.91,0:03:13.08,Default,,0,0,0,,Сізге форманың қажеті жоқ!
Dialogue: 0,0:03:09.91,0:03:13.08,Default,,0,0,0,,Өйткені, бұл жақсы идея!
Dialogue: 0,0:03:13.08,0:03:16.75,Default,,0,0,0,,Аузыңды жап, тыңда!
Dialogue: 0,0:03:13.08,0:03:16.75,Default,,0,0,0,,Басқаша айтқанда, дайвинг - бұл...
Dialogue: 0,0:03:16.75,0:03:21.09,Default,,0,0,0,,Бұл ақша тұрады.
Dialogue: 0,0:03:16.75,0:03:21.09,Default,,0,0,0,,Мен сізге осы уақытқа дейін айтқанымнан кейін, сіз түсінесіз, солай ма?
Dialogue: 0,0:03:21.09,0:03:24.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:21.09,0:03:24.09,Default,,0,0,0,,Ол осылай қолданылады.
Dialogue: 0,0:03:24.09,0:03:26.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:31.27,0:03:33.27,Default,,0,0,0,,Уф… Ууу…
Dialogue: 0,0:03:31.27,0:03:33.27,Default,,0,0,0,,Аха... ахаха...
Dialogue: 0,0:03:33.27,0:03:35.94,Default,,0,0,0,,Қандай керемет қиял
Dialogue: 0,0:03:33.27,0:03:35.94,Default,,0,0,0,,Сіз мұны істеп жатқан сияқтысыз.
Dialogue: 0,0:03:35.94,0:03:40.11,Default,,0,0,0,,Иә
Dialogue: 0,0:03:35.94,0:03:40.11,Default,,0,0,0,,Балалар сендер Иззу көктем фестивалі туралы білесіңдер ме?
Dialogue: 0,0:03:40.11,0:03:42.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:40.11,0:03:42.11,Default,,0,0,0,,Мамыр айында орындаңыз➡︎
Dialogue: 0,0:03:42.11,0:03:44.61,Default,,0,0,0,,Бұл менің университетімнің фестивалі туралы.
Dialogue: 0,0:03:44.61,0:03:47.95,Default,,0,0,0,,Шеңберге қарсы «Мистер» сайысы
Dialogue: 0,0:03:44.61,0:03:47.95,Default,,0,0,0,,Оқиға бар...
Dialogue: 0,0:03:47.95,0:03:50.45,Default,,0,0,0,,Жеңімпаз шеңберде
Dialogue: 0,0:03:47.95,0:03:50.45,Default,,0,0,0,,Ақшалай сыйлық болады.
Dialogue: 0,0:03:50.45,0:03:54.96,Default,,0,0,0,,Хмм, солай ма?
Dialogue: 0,0:03:50.45,0:03:54.96,Default,,0,0,0,,Сіз шынымен біздің шыққанымызды қаладыңыз ба?
Dialogue: 0,0:03:54.96,0:03:57.06,Default,,0,0,0,,Бірақ соғыс жыртқыштары сиқыр қолдана алмайды ғой, иә?
Dialogue: 0,0:03:54.96,0:03:57.06,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:03:57.06,0:04:00.90,Default,,0,0,0,,Мұны ерлер сайысы деп те атауға болады...
Dialogue: 0,0:03:57.06,0:04:00.90,Default,,0,0,0,,«отококон» деп қысқартылған
Dialogue: 0,0:04:00.90,0:04:03.73,Default,,0,0,0,,Бұл сұмдық!
Dialogue: 0,0:04:00.90,0:04:03.73,Default,,0,0,0,,Ха! Чиса білді ме?!
Dialogue: 0,0:04:03.73,0:04:06.57,Default,,0,0,0,,Әйтеуір... Былтыр да көргенмін.
Dialogue: 0,0:04:06.57,0:04:09.74,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:06.57,0:04:09.74,Default,,0,0,0,,Осындай киім киіңіз➡︎
Dialogue: 0,0:04:09.74,0:04:11.91,Default,,0,0,0,,Күлкілі
Dialogue: 0,0:04:09.74,0:04:11.91,Default,,0,0,0,,Қалжың емес!
Dialogue: 0,0:04:11.91,0:04:14.08,Default,,0,0,0,,А...
Dialogue: 0,0:04:11.91,0:04:14.08,Default,,0,0,0,,Сәлем Кохеи
Dialogue: 0,0:04:14.08,0:04:16.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:16.08,0:04:18.58,Default,,0,0,0,,Сен әдемісің
Dialogue: 0,0:04:16.08,0:04:18.58,Default,,0,0,0,,Не... не!
Dialogue: 0,0:04:18.58,0:04:20.92,Default,,0,0,0,,Егер сіз келсеңіз, біз міндетті түрде жеңеміз.
Dialogue: 0,0:04:20.92,0:04:23.75,Default,,0,0,0,,Шеңбер үшін
Dialogue: 0,0:04:20.92,0:04:23.75,Default,,0,0,0,,Маған сүйкімділігіңді бере аласың ба?
Dialogue: 0,0:04:23.75,0:04:25.92,Default,,0,0,0,,Жарайды... олай десең де...
Dialogue: 0,0:04:25.92,0:04:29.09,Default,,0,0,0,,Сонда мен саған керек емеспін, солай ма?
Dialogue: 0,0:04:25.92,0:04:29.09,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:29.09,0:04:31.26,Default,,0,0,0,,Өйткені
Dialogue: 0,0:04:29.09,0:04:31.26,Default,,0,0,0,,Кохеи осында, солай ма?
Dialogue: 0,0:04:31.26,0:04:35.26,Default,,0,0,0,,Сәлем, Иори
Dialogue: 0,0:04:31.26,0:04:35.26,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:04:35.26,0:04:38.43,Default,,0,0,0,,Сіз әзілсіз
Dialogue: 0,0:04:35.26,0:04:38.43,Default,,0,0,0,,Мен сені өлтіремін.
Dialogue: 0,0:04:38.43,0:04:40.60,Default,,0,0,0,,Nja
Dialogue: 0,0:04:38.43,0:04:40.60,Default,,0,0,0,,Екеуің де мынаны киіп алыңдар.
Dialogue: 0,0:04:40.60,0:04:43.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:40.60,0:04:43.90,Default,,0,0,0,,Бүгін біз теңізге шығамыз
Dialogue: 0,0:04:45.94,0:04:49.28,Default,,0,0,0,,Көлемі туралы не деуге болады?
Dialogue: 0,0:04:45.94,0:04:49.28,Default,,0,0,0,,Бұл аздап ауырады.
Dialogue: 0,0:04:49.28,0:04:51.61,Default,,0,0,0,,Алшақтық
Dialogue: 0,0:04:49.28,0:04:51.61,Default,,0,0,0,,Егер сіз мұны жасамаған болсаңыз, онда бәрі жақсы.
Dialogue: 0,0:04:51.61,0:04:54.45,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:04:54.45,0:04:57.39,Default,,0,0,0,,Уххх
Dialogue: 0,0:04:54.45,0:04:57.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:57.39,0:05:00.05,Default,,0,0,0,,Теңіз...
Dialogue: 0,0:05:00.05,0:05:03.56,Default,,0,0,0,,Чиса бармай ма?
Dialogue: 0,0:05:00.05,0:05:03.56,Default,,0,0,0,,Дүкен нөмірі
Dialogue: 0,0:05:03.56,0:05:06.26,Default,,0,0,0,,Мен... сонда
Dialogue: 0,0:05:08.23,0:05:10.73,Default,,0,0,0,,Аноса Иори
Dialogue: 0,0:05:08.23,0:05:10.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:10.73,0:05:16.24,Default,,0,0,0,,Сіздің университеттік өміріңіз басталған кезде қатты толқыдыңыз ба?
Dialogue: 0,0:05:16.24,0:05:18.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:16.24,0:05:18.24,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:18.24,0:05:22.74,Default,,0,0,0,,Хм... Қазір ойлап қарасам, көңілім толқып кетті...
Dialogue: 0,0:05:22.74,0:05:25.25,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:05:25.25,0:05:29.58,Default,,0,0,0,,Сонда бұл сізге ұнайтынына сенімдімін.
Dialogue: 0,0:05:29.58,0:05:31.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:31.59,0:05:33.92,Default,,0,0,0,,Иори менімен бірге жаттығады.
Dialogue: 0,0:05:33.92,0:05:36.92,Default,,0,0,0,,Онда мен Кохеймен біргемін.
Dialogue: 0,0:05:36.92,0:05:38.93,Default,,0,0,0,,Мұны істеу өте оңай
Dialogue: 0,0:05:38.93,0:05:43.26,Default,,0,0,0,,Су астында тыныс алу сезімін сезіну
Dialogue: 0,0:05:38.93,0:05:43.26,Default,,0,0,0,,Иә
Dialogue: 0,0:05:43.26,0:05:46.10,Default,,0,0,0,,Аяғыңызды аузыңызға салып дем алыңыз.
Dialogue: 0,0:05:46.10,0:05:48.10,Default,,0,0,0,,Иә
Dialogue: 0,0:05:52.44,0:05:55.71,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:05:52.44,0:05:55.71,Default,,0,0,0,,Қалыпты тыныс алу деген нені білдіреді?
Dialogue: 0,0:05:55.71,0:05:58.38,Default,,0,0,0,,Сезім мүлдем басқаша.
Dialogue: 0,0:05:55.71,0:05:58.38,Default,,0,0,0,,That's right.
Dialogue: 0,0:05:58.38,0:06:01.05,Default,,0,0,0,,Дем алған кезде барлығын бірден
Dialogue: 0,0:05:58.38,0:06:01.05,Default,,0,0,0,,Ауа кіріп бара жатқандай сезіледі.
Dialogue: 0,0:06:01.05,0:06:05.72,Default,,0,0,0,,Иә, бірақ тыныс алғанда
Dialogue: 0,0:06:01.05,0:06:05.72,Default,,0,0,0,,Бұл біраз күш қажет...
Dialogue: 0,0:06:05.72,0:06:10.06,Default,,0,0,0,,Әй, үйренгенше білу керек.
Dialogue: 0,0:06:05.72,0:06:10.06,Default,,0,0,0,,Сізде тыныс алу қиын болуы мүмкін.
Dialogue: 0,0:06:10.06,0:06:14.73,Default,,0,0,0,,Иә
Dialogue: 0,0:06:10.06,0:06:14.73,Default,,0,0,0,,Олай болса, шынымен де сүңгу керек пе?
Dialogue: 0,0:06:14.73,0:06:16.73,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:06:22.07,0:06:25.24,Default,,0,0,0,,♬~
Dialogue: 0,0:06:25.24,0:06:27.34,Default,,0,0,0,,Iori?
Dialogue: 0,0:06:30.58,0:06:32.91,Default,,0,0,0,,Пуха! Ха ха ха ха...
Dialogue: 0,0:06:32.91,0:06:36.25,Default,,0,0,0,,Сәлем, Иори
Dialogue: 0,0:06:32.91,0:06:36.25,Default,,0,0,0,,Не...?
Dialogue: 0,0:06:36.25,0:06:39.59,Default,,0,0,0,,Неліктен тынысыңыз тарылды?
Dialogue: 0,0:06:36.25,0:06:39.59,Default,,0,0,0,,Өйткені бұл ауырады.
Dialogue: 0,0:06:39.59,0:06:42.59,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:06:39.59,0:06:42.59,Default,,0,0,0,,Неге танк алып жүрсің?
Dialogue: 0,0:06:42.59,0:06:46.76,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:06:42.59,0:06:46.76,Default,,0,0,0,,Су астында тыныс алу қандай?
Dialogue: 0,0:06:46.76,0:06:48.93,Default,,0,0,0,,Қорқынышты ма?
Dialogue: 0,0:06:46.76,0:06:48.93,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:48.93,0:06:52.10,Default,,0,0,0,,Мен... жақсы көремін.
Dialogue: 0,0:06:48.93,0:06:52.10,Default,,0,0,0,,Алдымен түсініксіз болуы мүмкін➡︎
Dialogue: 0,0:06:52.10,0:06:55.37,Default,,0,0,0,,Тез үйреніп кетесің
Dialogue: 0,0:06:52.10,0:06:55.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:55.37,0:06:58.07,Default,,0,0,0,,Ал, қайталап көрейік.
Dialogue: 0,0:07:05.05,0:07:08.38,Default,,0,0,0,,Ха! Күрсін...
Dialogue: 0,0:07:05.05,0:07:08.38,Default,,0,0,0,,Не болды?Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:08.38,0:07:11.89,Default,,0,0,0,,Маскада су бар...
Dialogue: 0,0:07:08.38,0:07:11.89,Default,,0,0,0,,Мүмкін ол тым бос бекітілген.
Dialogue: 0,0:07:11.89,0:07:14.05,Default,,0,0,0,,Маған қарызға бер
Dialogue: 0,0:07:14.05,0:07:16.56,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:14.05,0:07:16.56,Default,,0,0,0,,Ах
Dialogue: 0,0:07:16.56,0:07:19.39,Default,,0,0,0,,Иә? Сол тұтынушылар...
Dialogue: 0,0:07:16.56,0:07:19.39,Default,,0,0,0,,Ах
Dialogue: 0,0:07:19.39,0:07:21.73,Default,,0,0,0,,Іссапарға барар алдында суға түсуге келген сияқты.
Dialogue: 0,0:07:21.73,0:07:23.90,Default,,0,0,0,,Бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:07:23.90,0:07:26.90,Default,,0,0,0,,Бос емес болып көрінсеңіз де
Dialogue: 0,0:07:23.90,0:07:26.90,Default,,0,0,0,,Оны костюміңізге дейін жеткізіңіз.
Dialogue: 0,0:07:26.90,0:07:30.24,Default,,0,0,0,,Хэхехе! Сенімді емес пе?
Dialogue: 0,0:07:26.90,0:07:30.24,Default,,0,0,0,,Сенімді?
Dialogue: 0,0:07:30.24,0:07:32.57,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:07:30.24,0:07:32.57,Default,,0,0,0,,Сол адамдар➡︎
Dialogue: 0,0:07:32.57,0:07:35.74,Default,,0,0,0,,Бағалы алтын немесе
Dialogue: 0,0:07:32.57,0:07:35.74,Default,,0,0,0,,Мен уақытымды сүңгу үшін пайдаланамын
Dialogue: 0,0:07:35.74,0:07:38.08,Default,,0,0,0,,Бұл мұнда ➡︎ дегенді білдіреді
Dialogue: 0,0:07:38.08,0:07:41.78,Default,,0,0,0,,Ол соншалықты сүйкімділікке толы
Dialogue: 0,0:07:38.08,0:07:41.78,Default,,0,0,0,,Бұл дәлел емес пе!
Dialogue: 0,0:07:46.25,0:07:48.59,Default,,0,0,0,,Сіз суда қалудан қорқатыныңызды жоғарыда айттыңыз.
Dialogue: 0,0:07:48.59,0:07:51.76,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:07:48.59,0:07:51.76,Default,,0,0,0,,Кешірім сұрайтын ештеңе жоқ
Dialogue: 0,0:07:51.76,0:07:56.70,Default,,0,0,0,,Су астында ауа таусылғанда не болады?
Dialogue: 0,0:07:51.76,0:07:56.70,Default,,0,0,0,,Ойлап қарасам, тіпті қорқамын.
Dialogue: 0,0:07:56.70,0:08:00.03,Default,,0,0,0,,Сіз бұл не екенін білесіз бе?
Dialogue: 0,0:07:56.70,0:08:00.03,Default,,0,0,0,,Ум...
Dialogue: 0,0:08:00.03,0:08:03.37,Default,,0,0,0,,Бұл жігіттің аты Сегізаяқ.
Dialogue: 0,0:08:00.03,0:08:03.37,Default,,0,0,0,,Бұл қосалқы реттегіш.
Dialogue: 0,0:08:03.37,0:08:07.37,Default,,0,0,0,,Достардың су астында ауасы таусылады
Dialogue: 0,0:08:03.37,0:08:07.37,Default,,0,0,0,,Мені оятқанда беремін.
Dialogue: 0,0:08:07.37,0:08:10.04,Default,,0,0,0,,Салмақ белдеуі
Dialogue: 0,0:08:07.37,0:08:10.04,Default,,0,0,0,,Оны кию бағыты анықталды➡︎
Dialogue: 0,0:08:10.04,0:08:12.05,Default,,0,0,0,,Мұның да себебі бар.
Dialogue: 0,0:08:12.05,0:08:15.55,Default,,0,0,0,,Бірдеңе болған кезде
Dialogue: 0,0:08:12.05,0:08:15.55,Default,,0,0,0,,Оны тез жою үшін.
Dialogue: 0,0:08:15.55,0:08:17.72,Default,,0,0,0,,Өз қауіпсіздігіңіз ғана емес➡︎
Dialogue: 0,0:08:17.72,0:08:20.89,Default,,0,0,0,,Сүңгу үшін достар табыңыз
Dialogue: 0,0:08:17.72,0:08:20.89,Default,,0,0,0,,Көмек бере білу
Dialogue: 0,0:08:20.89,0:08:23.39,Default,,0,0,0,,Біз қауіпсіздікті мұқият тексердік.
Dialogue: 0,0:08:23.39,0:08:26.23,Default,,0,0,0,,Мұнда
Dialogue: 0,0:08:23.39,0:08:26.23,Default,,0,0,0,,Бұл тек сен емес, мен де.
Dialogue: 0,0:08:26.23,0:08:28.90,Default,,0,0,0,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,0:08:26.23,0:08:28.90,Default,,0,0,0,,Ішіңізді салып, сүңгіңіз!
Dialogue: 0,0:08:28.90,0:08:31.60,Default,,0,0,0,,Мен саған не болса да көмектесемін
Dialogue: 0,0:08:35.57,0:08:37.91,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:37.91,0:08:40.81,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:08:37.91,0:08:40.81,Default,,0,0,0,,О!
Dialogue: 0,0:08:54.59,0:08:59.36,Default,,0,0,0,,《А... Иә? Дайын!
Dialogue: 0,0:08:54.59,0:08:59.36,Default,,0,0,0,,Мүлдем ауырмайды
Dialogue: 0,0:08:59.36,0:09:01.36,Default,,0,0,0,,Иә! 》
Dialogue: 0,0:09:07.37,0:09:11.07,Default,,0,0,0,,《Бұл... суда》
Dialogue: 0,0:09:13.21,0:09:17.21,Default,,0,0,0,,《Мен білмеген дүние! 》
Dialogue: 0,0:09:22.88,0:09:24.89,Default,,0,0,0,,Чиса!
Dialogue: 0,0:09:22.88,0:09:24.89,Default,,0,0,0,,Иори!?
Dialogue: 0,0:09:24.89,0:09:26.89,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:09:24.89,0:09:26.89,Default,,0,0,0,,Сіз не айттыңыз!
Dialogue: 0,0:09:26.89,0:09:29.72,Default,,0,0,0,,Теңізде
Dialogue: 0,0:09:26.89,0:09:29.72,Default,,0,0,0,,Тыныс алудың өзі керемет!
Dialogue: 0,0:09:29.72,0:09:32.73,Default,,0,0,0,,Мен мүлде жүзе алмаймын!
Dialogue: 0,0:09:29.72,0:09:32.73,Default,,0,0,0,,Сонымен... иә
Dialogue: 0,0:09:32.73,0:09:37.06,Default,,0,0,0,,Бұл жаңа әлем
Dialogue: 0,0:09:32.73,0:09:37.06,Default,,0,0,0,,Қол тигізу дегенді білдіреді!
Dialogue: 0,0:09:37.06,0:09:39.07,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:09:37.06,0:09:39.07,Default,,0,0,0,,Кеңістікке өту➡︎
Dialogue: 0,0:09:39.07,0:09:41.74,Default,,0,0,0,,Салмақсыздықты сезіну сияқты
Dialogue: 0,0:09:39.07,0:09:41.74,Default,,0,0,0,,Бұл сезім ме?
Dialogue: 0,0:09:41.74,0:09:44.91,Default,,0,0,0,,Иори мен түсінемін.
Dialogue: 0,0:09:41.74,0:09:44.91,Default,,0,0,0,,Киіміңді қазір ауыстыр.
Dialogue: 0,0:09:44.91,0:09:47.91,Default,,0,0,0,,Қалқымалы сезім немесе сол сияқты...
Dialogue: 0,0:09:44.91,0:09:47.91,Default,,0,0,0,,Бір ➡︎ болса
Dialogue: 0,0:09:47.91,0:09:51.08,Default,,0,0,0,,Тек қолынан келетінін таңдайтындар үшін.
Dialogue: 0,0:09:47.91,0:09:51.08,Default,,0,0,0,,Бұл мен ешқашан түсінбейтін қуаныш.
Dialogue: 0,0:09:51.08,0:09:53.91,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:51.08,0:09:53.91,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:09:53.91,0:09:55.92,Default,,0,0,0,,Бұл сенсің, солай ма?➡︎
Dialogue: 0,0:09:55.92,0:10:00.09,Default,,0,0,0,,Орындауға болмайтын істерді орындауға қабілетті болу
Dialogue: 0,0:09:55.92,0:10:00.09,Default,,0,0,0,,Бұл қуаныш деп аталады.
Dialogue: 0,0:10:00.09,0:10:02.59,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:02.59,0:10:05.26,Default,,0,0,0,,Керемет! О, дәмді!
Dialogue: 0,0:10:05.26,0:10:07.93,Default,,0,0,0,,Ол шағып жатыр, солай ма?
Dialogue: 0,0:10:05.26,0:10:07.93,Default,,0,0,0,,Қараңдаршы, бұл жеңіл тамақ.
Dialogue: 0,0:10:07.93,0:10:11.10,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:10:07.93,0:10:11.10,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:11.10,0:10:14.60,Default,,0,0,0,,Саған жақсы, Иори.
Dialogue: 0,0:10:11.10,0:10:14.60,Default,,0,0,0,,Мен өзімнің осал тұстарымды жеңе білдім.
Dialogue: 0,0:10:14.60,0:10:16.60,Default,,0,0,0,,Мен әлі де суды ұнатпаймын...
Dialogue: 0,0:10:16.60,0:10:20.94,Default,,0,0,0,,Бірақ жаңа әлемге қадам басу
Dialogue: 0,0:10:16.60,0:10:20.94,Default,,0,0,0,,Енді сіз қызық не екенін білесіз бе?
Dialogue: 0,0:10:20.94,0:10:25.95,Default,,0,0,0,,Иә! Сізге көп рахмет
Dialogue: 0,0:10:20.94,0:10:25.95,Default,,0,0,0,,Жоқ, жоқ, алғысымды айта алмаймын.
Dialogue: 0,0:10:25.95,0:10:29.62,Default,,0,0,0,,Дұрыс. Қазір...
Dialogue: 0,0:10:25.95,0:10:29.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:29.62,0:10:33.45,Default,,0,0,0,,Бұл жаңа әлемнен бас тартыңыз
Dialogue: 0,0:10:29.62,0:10:33.45,Default,,0,0,0,,Енді ешқандай себеп жоқ.
Dialogue: 0,0:10:33.45,0:10:36.15,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:10:38.46,0:10:42.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:38.46,0:10:42.80,Default,,0,0,0,,Мен тағы да көп іштім...
Dialogue: 0,0:10:42.80,0:10:45.13,Default,,0,0,0,,Су…｡ Уф!
Dialogue: 0,0:10:45.13,0:10:47.83,Default,,0,0,0,,Не істеп жатырсың! иә?
Dialogue: 0,0:10:50.47,0:10:52.64,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:52.64,0:10:54.94,Default,,0,0,0,,Ұйықтап алайық
Dialogue: 0,0:10:58.25,0:11:00.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:00.58,0:11:03.08,Default,,0,0,0,,А... А? иә?
Dialogue: 0,0:11:06.59,0:11:08.59,Default,,0,0,0,,《Жоқ, бұл мүмкін емес.
Dialogue: 0,0:11:08.59,0:11:11.93,Default,,0,0,0,,Егер сіз мас күйде оянсаңыз
Dialogue: 0,0:11:08.59,0:11:11.93,Default,,0,0,0,,Менің қасымда жартылай жалаңаш ұйықтап жатыр...》
Dialogue: 0,0:11:11.93,0:11:13.93,Default,,0,0,0,,
Dialogue: 0,0:11:13.93,0:11:16.10,Default,,0,0,0,,《Әдеттегідей》
Dialogue: 0,0:11:16.10,0:11:19.10,Default,,0,0,0,,Дәлірек айтсақ, жер бетіндегі бұл адам не ...
Dialogue: 0,0:11:19.10,0:11:22.60,Default,,0,0,0,,Ой, балалар сендер бірінші рет кездесіп отырсыңдар ма?
Dialogue: 0,0:11:19.10,0:11:22.60,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:11:22.60,0:11:25.77,Default,,0,0,0,,Біздің қамқорлық шеңбері екендігіміз
Dialogue: 0,0:11:22.60,0:11:25.77,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:11:25.77,0:11:28.44,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:11:25.77,0:11:28.44,Default,,0,0,0,,Сіз басқа мектептенсіз бе?
Dialogue: 0,0:11:28.44,0:11:31.95,Default,,0,0,0,,(Норияки) Уф. (Жан) Мм…
Dialogue: 0,0:11:28.44,0:11:31.95,Default,,0,0,0,,Аоми әйелдер университетінің қызметкері Азуса Хамаока - әйел.
Dialogue: 0,0:11:31.95,0:11:34.45,Default,,0,0,0,,А...
Dialogue: 0,0:11:31.95,0:11:34.45,Default,,0,0,0,,Бұл адам неге ұйықтап жатыр?
Dialogue: 0,0:11:34.45,0:11:36.45,Default,,0,0,0,,Футон
Dialogue: 0,0:11:34.45,0:11:36.45,Default,,0,0,0,,Сол жерде болғаны үшін емес пе?
Dialogue: 0,0:11:36.45,0:11:39.29,Default,,0,0,0,,Футон
Dialogue: 0,0:11:36.45,0:11:39.29,Default,,0,0,0,,Мен бірінші ұйықтадым...
Dialogue: 0,0:11:39.29,0:11:41.96,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:11:39.29,0:11:41.96,Default,,0,0,0,,Қамқор әйел емес
Dialogue: 0,0:11:41.96,0:11:44.63,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:11:44.63,0:11:49.13,Default,,0,0,0,,Қалыпты Жалаңаш адам бар бөлмеде
Dialogue: 0,0:11:44.63,0:11:49.13,Default,,0,0,0,,Киіміңді шешіп ұйықтайсың ба?
Dialogue: 0,0:11:49.13,0:11:52.13,Default,,0,0,0,,Міне солай болды
Dialogue: 0,0:11:49.13,0:11:52.13,Default,,0,0,0,,Бұл жігітке әйел сияқты қарау➡︎
Dialogue: 0,0:11:52.13,0:11:56.40,Default,,0,0,0,,Қарап көрейік
Dialogue: 0,0:11:52.13,0:11:56.40,Default,,0,0,0,,Киім кию әдеттен тыс.
Dialogue: 0,0:11:56.40,0:11:58.74,Default,,0,0,0,,Бүгін сыртта
Dialogue: 0,0:11:56.40,0:11:58.74,Default,,0,0,0,,Өйткені менің бір ісім бар.
Dialogue: 0,0:11:58.74,0:12:02.41,Default,,0,0,0,,Сондықтан мен Азусаға телефон соқтым.
Dialogue: 0,0:11:58.74,0:12:02.41,Default,,0,0,0,,Онда мен сені оятайын ба?
Dialogue: 0,0:12:02.41,0:12:04.41,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:12:02.41,0:12:04.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:04.41,0:12:06.75,Default,,0,0,0,,Алдымен сізге
Dialogue: 0,0:12:04.41,0:12:06.75,Default,,0,0,0,,Менің саған айтар сөзім бар.
Dialogue: 0,0:12:06.75,0:12:09.85,Default,,0,0,0,,Бұл Иззу көктемі фестивалі туралы маңызды оқиға.
Dialogue: 0,0:12:15.92,0:12:18.09,Default,,0,0,0,,Сәлем! Аяқталды!
Dialogue: 0,0:12:18.09,0:12:21.26,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:12:18.09,0:12:21.26,Default,,0,0,0,,Сен әлі де жақсысың.
Dialogue: 0,0:12:21.26,0:12:23.43,Default,,0,0,0,,Онша емес!
Dialogue: 0,0:12:21.26,0:12:23.43,Default,,0,0,0,,Иззу көктем фестивалінде➡︎
Dialogue: 0,0:12:23.43,0:12:26.60,Default,,0,0,0,,Сіз окономияки сатасыз ба?
Dialogue: 0,0:12:23.43,0:12:26.60,Default,,0,0,0,,Орташа жақсы
Dialogue: 0,0:12:26.60,0:12:29.10,Default,,0,0,0,,Жақсы болмаса, қиналып қаласың
Dialogue: 0,0:12:26.60,0:12:29.10,Default,,0,0,0,,Шеңбер бюджетінің бөлігі ретінде сату ➡︎
Dialogue: 0,0:12:29.10,0:12:31.77,Default,,0,0,0,,Мен оны қосамын.
Dialogue: 0,0:12:29.10,0:12:31.77,Default,,0,0,0,,Сонымен➡︎
Dialogue: 0,0:12:31.77,0:12:36.28,Default,,0,0,0,,Бүгін мен бірінші курс студентімін.
Dialogue: 0,0:12:31.77,0:12:36.28,Default,,0,0,0,,Оларға мұны қалай жасау керектігін үйретіңіз
Dialogue: 0,0:12:36.28,0:12:39.78,Default,,0,0,0,,Токи мен Баки ше?
Dialogue: 0,0:12:36.28,0:12:39.78,Default,,0,0,0,,А, біз...
Dialogue: 0,0:12:39.78,0:12:42.78,Default,,0,0,0,,Хисаши Токита кеттік!
Dialogue: 0,0:12:39.78,0:12:42.78,Default,,0,0,0,,Ей! Естисің бе!? Польнареф!?
Dialogue: 0,0:12:42.78,0:12:46.45,Default,,0,0,0,,О! Мен жабдықты дайындаймын.
Dialogue: 0,0:12:46.45,0:12:48.46,Default,,0,0,0,,Аяқтаған кезде
Dialogue: 0,0:12:46.45,0:12:48.46,Default,,0,0,0,,Барлығы тамақ ішуге келеді➡︎
Dialogue: 0,0:12:48.46,0:12:51.96,Default,,0,0,0,,Көп пісіріңіз!
Dialogue: 0,0:12:48.46,0:12:51.96,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:12:51.96,0:12:55.40,Default,,0,0,0,,Ал, бастайық.
Dialogue: 0,0:12:51.96,0:12:55.40,Default,,0,0,0,,Иә
Dialogue: 0,0:12:55.40,0:12:57.40,Default,,0,0,0,,《Жасай берейік! Кохеи! 》
Dialogue: 0,0:12:57.40,0:12:59.57,Default,,0,0,0,,《Маған қалдыр! Китахара! 》
Dialogue: 0,0:12:59.57,0:13:03.24,Default,,0,0,0,,((Идзу көктем фестивалі туралы маңызды оқиға?
Dialogue: 0,0:12:59.57,0:13:03.24,Default,,0,0,0,,Бұл еркек жынысы туралы емес пе?
Dialogue: 0,0:13:03.24,0:13:05.74,Default,,0,0,0,,Шын мәнінде, бұл байланысты ...
Dialogue: 0,0:13:05.74,0:13:08.58,Default,,0,0,0,,Сізге
Dialogue: 0,0:13:05.74,0:13:08.58,Default,,0,0,0,,Мен Чиса-чаннан мені көндіруді өтінгім келеді.
Dialogue: 0,0:13:08.58,0:13:12.91,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:13:08.58,0:13:12.91,Default,,0,0,0,,Изу көктем фестивалінде мифкон да бар.
Dialogue: 0,0:13:12.91,0:13:16.92,Default,,0,0,0,,Шеңбер бюджетін алу
Dialogue: 0,0:13:12.91,0:13:16.92,Default,,0,0,0,,Мен Чиса-чанның шыққанын қалаймын.
Dialogue: 0,0:13:16.92,0:13:20.25,Default,,0,0,0,,Жоқ, мені көндіруге тырысу керек!?
Dialogue: 0,0:13:16.92,0:13:20.25,Default,,0,0,0,,Мүлде мүмкін емес!
Dialogue: 0,0:13:20.25,0:13:23.59,Default,,0,0,0,,Бірақ қазір
Dialogue: 0,0:13:20.25,0:13:23.59,Default,,0,0,0,,Егер ол жеңсе➡︎
Dialogue: 0,0:13:23.59,0:13:27.09,Default,,0,0,0,,Балалар
Dialogue: 0,0:13:23.59,0:13:27.09,Default,,0,0,0,,Ерлердің кештеріне барудың қажеті жоқ
Dialogue: 0,0:13:27.09,0:13:30.09,Default,,0,0,0,,Тынш! Жасайық! ))
Dialogue: 0,0:13:34.43,0:13:36.44,Default,,0,0,0,,《Әдетте Чиса ешқашан бармас еді➡︎
Dialogue: 0,0:13:36.44,0:13:38.44,Default,,0,0,0,,Жұмбақ сайысына қатысасың ба?
Dialogue: 0,0:13:36.44,0:13:38.44,Default,,0,0,0,,Келіспеймін》
Dialogue: 0,0:13:38.44,0:13:42.28,Default,,0,0,0,,《Ондай жағдайда жағдай қалыпты емес.
Dialogue: 0,0:13:38.44,0:13:42.28,Default,,0,0,0,,Тек орындаңыз》
Dialogue: 0,0:13:42.28,0:13:44.44,Default,,0,0,0,,《Чизаны мас қыл
Dialogue: 0,0:13:42.28,0:13:44.44,Default,,0,0,0,,Сот үкімінен айырылды…》
Dialogue: 0,0:13:44.44,0:13:46.78,Default,,0,0,0,,《Mycon ойынына қатысуға кепілдік беріңіз! 》
Dialogue: 0,0:13:46.78,0:13:50.28,Default,,0,0,0,,Аға, күн ыстық, Кохей!
Dialogue: 0,0:13:46.78,0:13:50.28,Default,,0,0,0,,Дұрыс, Китахара!
Dialogue: 0,0:13:50.28,0:13:53.29,Default,,0,0,0,,Мен қатты ыстық кезде ыстықтан қорқамын!
Dialogue: 0,0:13:53.29,0:13:55.89,Default,,0,0,0,,Сізге ылғалдану керек!
Dialogue: 0,0:13:55.89,0:13:58.79,Default,,0,0,0,,Содан кейін I
Dialogue: 0,0:13:55.89,0:13:58.79,Default,,0,0,0,,Мен саған сусын алып келейін!
Dialogue: 0,0:14:01.90,0:14:04.57,Default,,0,0,0,,Уулонг шайы!
Dialogue: 0,0:14:01.90,0:14:04.57,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:14:04.57,0:14:07.57,Default,,0,0,0,,《Китахара, түсіндің бе?
Dialogue: 0,0:14:04.57,0:14:07.57,Default,,0,0,0,,Алкоголь сіздің оң қолыңызда! 》
Dialogue: 0,0:14:07.57,0:14:10.90,Default,,0,0,0,,《Оң қол – Чиса, сол қол – мен! 》
Dialogue: 0,0:14:10.90,0:14:15.41,Default,,0,0,0,,Қарашы, Чиза! ішу!
Dialogue: 0,0:14:10.90,0:14:15.41,Default,,0,0,0,,Мен қазір жібере алмаймын, сондықтан кейінірек
Dialogue: 0,0:14:15.41,0:14:18.61,Default,,0,0,0,,Онда мен оны аламын.
Dialogue: 0,0:14:15.41,0:14:18.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:21.58,0:14:25.42,Default,,0,0,0,,Иә? Сіз ішпейсіз бе?
Dialogue: 0,0:14:21.58,0:14:25.42,Default,,0,0,0,,Жоқ... иә... бұл...
Dialogue: 0,0:14:25.42,0:14:28.59,Default,,0,0,0,,Не? Амал жоқ
Dialogue: 0,0:14:25.42,0:14:28.59,Default,,0,0,0,,Онда біртүрлі заттар бар ма?
Dialogue: 0,0:14:28.59,0:14:31.93,Default,,0,0,0,,Ах... Ахахахахахах!
Dialogue: 0,0:14:28.59,0:14:31.93,Default,,0,0,0,,Мен бұны ешқашан күтпеген едім...
Dialogue: 0,0:14:31.93,0:14:36.60,Default,,0,0,0,,Жүр, іш, Китахара!
Dialogue: 0,0:14:31.93,0:14:36.60,Default,,0,0,0,,Уа... ой! Бұл дұрыс!
Dialogue: 0,0:14:36.60,0:14:38.77,Default,,0,0,0,,Иә? не болды? Иори
Dialogue: 0,0:14:38.77,0:14:40.77,Default,,0,0,0,,Жоқ... бәрібір...
Dialogue: 0,0:14:40.77,0:14:45.44,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:14:40.77,0:14:45.44,Default,,0,0,0,,Қазіргі жағдай форс-мажорлық жағдайларға байланысты болуы мүмкін.
Dialogue: 0,0:14:45.44,0:14:48.44,Default,,0,0,0,,Ауыстыру!
Dialogue: 0,0:14:45.44,0:14:48.44,Default,,0,0,0,,Олай болса, мен мұны осы жолы істеуім керек пе?
Dialogue: 0,0:14:48.44,0:14:51.45,Default,,0,0,0,,Сусын болса да
Dialogue: 0,0:14:48.44,0:14:51.45,Default,,0,0,0,,Мен оны саған әкелемін!
Dialogue: 0,0:14:51.45,0:14:54.28,Default,,0,0,0,,Фуфуфуфуфу…
Dialogue: 0,0:14:51.45,0:14:54.28,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:54.28,0:14:56.72,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:14:54.28,0:14:56.72,Default,,0,0,0,,Хо…
Dialogue: 0,0:14:56.72,0:14:58.72,Default,,0,0,0,,Чичичичи... Чиса!
Dialogue: 0,0:14:56.72,0:14:58.72,Default,,0,0,0,,Атап айтқанда, бұл...
Dialogue: 0,0:14:58.72,0:15:01.56,Default,,0,0,0,,Екеуі де өте жақсы.
Dialogue: 0,0:14:58.72,0:15:01.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:01.56,0:15:05.76,Default,,0,0,0,,Бұл Имамура-кунға
Dialogue: 0,0:15:01.56,0:15:05.76,Default,,0,0,0,,Сіз маған оны ішуге тырысасыз ба?
Dialogue: 0,0:15:09.56,0:15:14.74,Default,,0,0,0,,Кохей шайы.
Dialogue: 0,0:15:09.56,0:15:14.74,Default,,0,0,0,,О, бұл жаман.
Dialogue: 0,0:15:14.74,0:15:18.57,Default,,0,0,0,,Боу!
Dialogue: 0,0:15:14.74,0:15:18.57,Default,,0,0,0,,Кешіріңіз... бұл форс-мажорлық жағдайға байланысты болды.
Dialogue: 0,0:15:18.57,0:15:22.27,Default,,0,0,0,,Не болады
Dialogue: 0,0:15:18.57,0:15:22.27,Default,,0,0,0,,Бұл форс-мажорлық жағдайға айналады...
Dialogue: 0,0:15:25.58,0:15:27.92,Default,,0,0,0,,Хмм! Жарайсың, жарайсың!
Dialogue: 0,0:15:27.92,0:15:30.08,Default,,0,0,0,,Азуса мырза
Dialogue: 0,0:15:27.92,0:15:30.08,Default,,0,0,0,,Мен оны жақсы жасай алмаймын, бірақ...
Dialogue: 0,0:15:30.08,0:15:33.88,Default,,0,0,0,,Жарайды, жарайды!
Dialogue: 0,0:15:30.08,0:15:33.88,Default,,0,0,0,,Бұл университет фестиваліндегі дүңгіршек.
Dialogue: 0,0:15:36.76,0:15:40.76,Default,,0,0,0,,Міне, осындай жерде.
Dialogue: 0,0:15:36.76,0:15:40.76,Default,,0,0,0,,Міне, Чиза
Dialogue: 0,0:15:40.76,0:15:43.93,Default,,0,0,0,,Не?
Dialogue: 0,0:15:40.76,0:15:43.93,Default,,0,0,0,,Сіз сыраны қалайсыз, солай ма?
Dialogue: 0,0:15:43.93,0:15:46.10,Default,,0,0,0,,Мен келеді деп ойладым.
Dialogue: 0,0:15:43.93,0:15:46.10,Default,,0,0,0,,Мен дайындап қойдым!
Dialogue: 0,0:15:46.10,0:15:52.11,Default,,0,0,0,,Маған керек емес
Dialogue: 0,0:15:46.10,0:15:52.11,Default,,0,0,0,,А, мен оны ала аламын ба?
Dialogue: 0,0:15:52.11,0:15:55.38,Default,,0,0,0,,(Бекки) Ах, емтихандар аяқталды — ақыры тыныш күндер келді~
Dialogue: 0,0:15:52.11,0:15:55.38,Default,,0,0,0,,Екеуіңнің көңіл-күйлерің нашар!
Dialogue: 0,0:15:55.38,0:15:59.05,Default,,0,0,0,,Міне...
Dialogue: 0,0:15:55.38,0:15:59.05,Default,,0,0,0,,I am extremely happy to share in the praise...
Dialogue: 0,0:15:59.05,0:16:01.88,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:15:59.05,0:16:01.88,Default,,0,0,0,,Нанакадан естігенімдей➡︎
Dialogue: 0,0:16:01.88,0:16:04.72,Default,,0,0,0,,Олар сүйкімді жасөспірімдер емес!
Dialogue: 0,0:16:01.88,0:16:04.72,Default,,0,0,0,,Нанакадан?
Dialogue: 0,0:16:04.72,0:16:08.89,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:16:04.72,0:16:08.89,Default,,0,0,0,,Тек анда-санда телефон соғу.
Dialogue: 0,0:16:08.89,0:16:12.73,Default,,0,0,0,,Сонымен сіз туралы
Dialogue: 0,0:16:08.89,0:16:12.73,Default,,0,0,0,,Мен сені жақсы білемін, Иори-кун.
Dialogue: 0,0:16:12.73,0:16:16.40,Default,,0,0,0,,бірақ тіпті ең кішкентай үміт сызығын беретін іздерді зерттеп көруім керек шығар.
Dialogue: 0,0:16:12.73,0:16:16.40,Default,,0,0,0,,Мен сізден көп нәрсе естідім.
Dialogue: 0,0:16:16.40,0:16:18.40,Default,,0,0,0,,《Нанака-саннан? 》
Dialogue: 0,0:16:20.40,0:16:22.57,Default,,0,0,0,,((Нанака: достарыңызға
Dialogue: 0,0:16:20.40,0:16:22.57,Default,,0,0,0,,Маған хабарласпасаң...))
Dialogue: 0,0:16:22.57,0:16:24.91,Default,,0,0,0,,А...
Dialogue: 0,0:16:22.57,0:16:24.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:24.91,0:16:29.91,Default,,0,0,0,,Iori лас
Dialogue: 0,0:16:24.91,0:16:29.91,Default,,0,0,0,,А, сен не істеп жатырсың?
Dialogue: 0,0:16:29.91,0:16:32.91,Default,,0,0,0,,Ум...
Dialogue: 0,0:16:29.91,0:16:32.91,Default,,0,0,0,,It's a misunderstanding about AV and between men...
Dialogue: 0,0:16:32.91,0:16:38.42,Default,,0,0,0,,Ахаха! Жарайды, жарайды
Dialogue: 0,0:16:32.91,0:16:38.42,Default,,0,0,0,,No... it's not okay at all...
Dialogue: 0,0:16:38.42,0:16:42.82,Default,,0,0,0,,Негізі мен де.
Dialogue: 0,0:16:38.42,0:16:42.82,Default,,0,0,0,,Мен екеуін де істей аламын.
Dialogue: 0,0:16:45.43,0:16:47.43,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:16:45.43,0:16:47.43,Default,,0,0,0,,Жоқ➡︎
Dialogue: 0,0:16:47.43,0:16:49.60,Default,,0,0,0,,Сол хоббиі бар бала бар.
Dialogue: 0,0:16:47.43,0:16:49.60,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:16:49.60,0:16:52.10,Default,,0,0,0,,Let's talk about a lot of things next time!
Dialogue: 0,0:16:52.10,0:16:55.10,Default,,0,0,0,,Бір хобби?
Dialogue: 0,0:16:52.10,0:16:55.10,Default,,0,0,0,,You're talking about diving, right?
Dialogue: 0,0:16:55.10,0:16:57.54,Default,,0,0,0,,Лампалар шамы…!
Dialogue: 0,0:16:55.10,0:16:57.54,Default,,0,0,0,,Сәлем! Китахара!
Dialogue: 0,0:16:57.54,0:17:00.21,Default,,0,0,0,,Маңызды емес әңгіме
Dialogue: 0,0:16:57.54,0:17:00.21,Default,,0,0,0,,Бұл уақыт емес!
Dialogue: 0,0:17:00.21,0:17:04.04,Default,,0,0,0,,Жоқ... бұл өте үлкен мәселе...
Dialogue: 0,0:17:00.21,0:17:04.04,Default,,0,0,0,,Няхаха
Dialogue: 0,0:17:04.04,0:17:06.38,Default,,0,0,0,,Иә? Екеуіңде не болды?
Dialogue: 0,0:17:06.38,0:17:09.78,Default,,0,0,0,,Жоқ, жоқ! Әсіресе!
Dialogue: 0,0:17:06.38,0:17:09.78,Default,,0,0,0,,Мен сусын алып келейін!
Dialogue: 0,0:17:11.72,0:17:14.39,Default,,0,0,0,,Тек осы қозғалыс
Dialogue: 0,0:17:11.72,0:17:14.39,Default,,0,0,0,,Мен оны пайдаланғым келмеді, бірақ...
Dialogue: 0,0:17:14.39,0:17:18.23,Default,,0,0,0,,Барлығына арналған сусындар
Dialogue: 0,0:17:14.39,0:17:18.23,Default,,0,0,0,,Бұл жалғыз таңдау...
Dialogue: 0,0:17:18.23,0:17:20.89,Default,,0,0,0,,Иә! Улонг шайы!
Dialogue: 0,0:17:18.23,0:17:20.89,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:17:20.89,0:17:24.40,Default,,0,0,0,,Жақсы нәрсе, ол әлі де бар
Dialogue: 0,0:17:20.89,0:17:24.40,Default,,0,0,0,,Мен де
Dialogue: 0,0:17:24.40,0:17:26.80,Default,,0,0,0,,Егер Урарака Качанға тиіп қалса—
Dialogue: 0,0:17:28.74,0:17:30.90,Default,,0,0,0,,Хмф!
Dialogue: 0,0:17:28.74,0:17:30.90,Default,,0,0,0,,Теңізді ойласаң, қырылған мұзды елестетесің!
Dialogue: 0,0:17:30.90,0:17:34.24,Default,,0,0,0,,Сироп ерекше!
Dialogue: 0,0:17:30.90,0:17:34.24,Default,,0,0,0,,Мен толып кеттім
Dialogue: 0,0:17:34.24,0:17:36.24,Default,,0,0,0,,Екеуің бірге тамақтаныңдар.
Dialogue: 0,0:17:38.25,0:17:40.75,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:17:38.25,0:17:40.75,Default,,0,0,0,,Сіз біраз уақыттан бері не істеп жатырсыз?
Dialogue: 0,0:17:40.75,0:17:43.25,Default,,0,0,0,,Эй, мен сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:17:43.25,0:17:45.42,Default,,0,0,0,,Чи-чан, мені мас қыл
Dialogue: 0,0:17:43.25,0:17:45.42,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:17:45.42,0:17:47.75,Default,,0,0,0,,О!
Dialogue: 0,0:17:45.42,0:17:47.75,Default,,0,0,0,,Нана... Не айтып тұрсың?
Dialogue: 0,0:17:47.75,0:17:50.26,Default,,0,0,0,,Бұл ауыр айып!
Dialogue: 0,0:17:50.26,0:17:54.09,Default,,0,0,0,,Бірдеңені ұсақтау арқылы істегіңіз келсе
Dialogue: 0,0:17:50.26,0:17:54.09,Default,,0,0,0,,Менің де бір ойым бар~?
Dialogue: 0,0:17:54.09,0:17:56.03,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:17:54.09,0:17:56.03,Default,,0,0,0,,Олай емес...
Dialogue: 0,0:17:56.03,0:17:59.03,Default,,0,0,0,,Сонда сіз не істемек болдыңыз?
Dialogue: 0,0:17:59.03,0:18:01.03,Default,,0,0,0,,Бұлай болса, көмектесу мүмкін емес...!
Dialogue: 0,0:18:01.03,0:18:03.04,Default,,0,0,0,,Енді айла жоқ! Чиса!
Dialogue: 0,0:18:03.04,0:18:06.37,Default,,0,0,0,,А... не?
Dialogue: 0,0:18:03.04,0:18:06.37,Default,,0,0,0,,Мифконда көрсетіңіз!
Dialogue: 0,0:18:06.37,0:18:08.54,Default,,0,0,0,,Ұнатпау
Dialogue: 0,0:18:06.37,0:18:08.54,Default,,0,0,0,,Бұл жігіт мүлде жалаңаш➡︎
Dialogue: 0,0:18:08.54,0:18:11.55,Default,,0,0,0,,Мен жерге тізерлеймін, өтінемін!
Dialogue: 0,0:18:08.54,0:18:11.55,Default,,0,0,0,,Мен оны жоғарыдан басу керек пе?
Dialogue: 0,0:18:11.55,0:18:14.38,Default,,0,0,0,,Тым болмаса шықшы Шықпа, жауап берме!
Dialogue: 0,0:18:11.55,0:18:14.38,Default,,0,0,0,,Тек сұраңыз!
Dialogue: 0,0:18:14.38,0:18:17.05,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:14.38,0:18:17.05,Default,,0,0,0,,Жек көрсең, жек көресің!
Dialogue: 0,0:18:17.05,0:18:20.72,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:18:17.05,0:18:20.72,Default,,0,0,0,,Жақсылық сұрайсың.
Dialogue: 0,0:18:20.72,0:18:23.22,Default,,0,0,0,,Сұрау себебі
Dialogue: 0,0:18:20.72,0:18:23.22,Default,,0,0,0,,Мен оны дұрыс айтуым керек.
Dialogue: 0,0:18:23.22,0:18:26.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:23.22,0:18:26.56,Default,,0,0,0,,Себеп жоқ па?
Dialogue: 0,0:18:26.56,0:18:28.90,Default,,0,0,0,,Жоқ, жақсы... егер Чиса ➡︎ пайда болса
Dialogue: 0,0:18:28.90,0:18:31.40,Default,,0,0,0,,Жүлде ақшасы
Dialogue: 0,0:18:28.90,0:18:31.40,Default,,0,0,0,,Менің ойымша, сіз оны ала аласыз.
Dialogue: 0,0:18:31.40,0:18:35.40,Default,,0,0,0,,Содан кейін біз
Dialogue: 0,0:18:31.40,0:18:35.40,Default,,0,0,0,,Ерлер сайысына барудың қажеті жоқ.
Dialogue: 0,0:18:35.40,0:18:40.91,Default,,0,0,0,,Хмм... түсіндім.
Dialogue: 0,0:18:35.40,0:18:40.91,Default,,0,0,0,,Сіз қалай ойлайсыз? Чи-чан
Dialogue: 0,0:18:40.91,0:18:44.08,Default,,0,0,0,,Мен оны мүлдем жек көремін.
Dialogue: 0,0:18:44.08,0:18:48.58,Default,,0,0,0,,Мен күткен едім, бірақ...
Dialogue: 0,0:18:44.08,0:18:48.58,Default,,0,0,0,,Олай болса менен басынан сұрама.
Dialogue: 0,0:18:48.58,0:18:50.58,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:18:50.58,0:18:52.75,Default,,0,0,0,,Жабысқан арал жоқ сияқты...
Dialogue: 0,0:18:52.75,0:18:57.36,Default,,0,0,0,,Енді ерлер арасындағы жарысқа қатысуға кепілдік бар ма?
Dialogue: 0,0:18:52.75,0:18:57.36,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:18:57.36,0:19:00.69,Default,,0,0,0,,Енді ойлап қарасам, мен үлкендермен бірге болған кезім...
Dialogue: 0,0:18:57.36,0:19:00.69,Default,,0,0,0,,Кім келді?
Dialogue: 0,0:19:00.69,0:19:02.86,Default,,0,0,0,,Азуса Мифкомда.
Dialogue: 0,0:19:02.86,0:19:06.20,Default,,0,0,0,,Ол әрине әдемі.
Dialogue: 0,0:19:02.86,0:19:06.20,Default,,0,0,0,,Алдын ала турда сүрінбей қалғаныммен.
Dialogue: 0,0:19:06.20,0:19:08.20,Default,,0,0,0,,(Дос) Не? «Chōzetsu Zekkyō Keikaku 5 (Бес)» деген бар ма?
Dialogue: 0,0:19:08.20,0:19:10.87,Default,,0,0,0,,купальникіңізді ұмытыңыз
Dialogue: 0,0:19:08.20,0:19:10.87,Default,,0,0,0,,Мен іш киіммен шыққаным үшін дисквалификацияландым.
Dialogue: 0,0:19:10.87,0:19:13.21,Default,,0,0,0,,Көрінгендей, бар
Dialogue: 0,0:19:10.87,0:19:13.21,Default,,0,0,0,,Бұл керемет... Бұл...
Dialogue: 0,0:19:13.21,0:19:16.38,Default,,0,0,0,,Сізде ұят жоқ па?
Dialogue: 0,0:19:13.21,0:19:16.38,Default,,0,0,0,,Ол сондай әйел.
Dialogue: 0,0:19:16.38,0:19:18.38,Default,,0,0,0,,Жоқ, жоқ, солай...
Dialogue: 0,0:19:18.38,0:19:21.38,Default,,0,0,0,,Тек әрқашан жасайтын нәрсені жасаңыз.
Dialogue: 0,0:19:18.38,0:19:21.38,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:19:21.38,0:19:23.72,Default,,0,0,0,,Таа~!
Dialogue: 0,0:19:21.38,0:19:23.72,Default,,0,0,0,,Бұл шешінудің жақсы тәсілі емес пе?
Dialogue: 0,0:19:23.72,0:19:26.52,Default,,0,0,0,,Келесі Егер сіз ұтылсаңыз, M-тәрізді спред жасаңыз!
Dialogue: 0,0:19:29.39,0:19:32.23,Default,,0,0,0,,Жақсы! Біраз
Dialogue: 0,0:19:29.39,0:19:32.23,Default,,0,0,0,,Мен оны сізге араластырып беремін!
Dialogue: 0,0:19:32.23,0:19:36.23,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:19:32.23,0:19:36.23,Default,,0,0,0,,Шынымды айтсам, Азуса мұндайды ұнатады.
Dialogue: 0,0:19:36.23,0:19:39.40,Default,,0,0,0,,Оны араластырыңыз!
Dialogue: 0,0:19:36.23,0:19:39.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:39.40,0:19:42.74,Default,,0,0,0,,Е! Рас па!?
Dialogue: 0,0:19:39.40,0:19:42.74,Default,,0,0,0,,Иә
Dialogue: 0,0:19:42.74,0:19:45.07,Default,,0,0,0,,Өйткені бұл бейсбол жұдырығы, солай ма?
Dialogue: 0,0:19:42.74,0:19:45.07,Default,,0,0,0,,Киіміңді шеш!
Dialogue: 0,0:19:45.07,0:19:47.91,Default,,0,0,0,,Амансың ба!?
Dialogue: 0,0:19:45.07,0:19:47.91,Default,,0,0,0,,Жарайды, жеңілсем, шешіп аламын.
Dialogue: 0,0:19:47.91,0:19:51.24,Default,,0,0,0,,Бұл бейсбол жұдырығы. Күткендей.
Dialogue: 0,0:19:47.91,0:19:51.24,Default,,0,0,0,,Мен мүлдем жалаңаш болмаймын.
Dialogue: 0,0:19:51.24,0:19:53.25,Default,,0,0,0,,Мен де қызбын.
Dialogue: 0,0:19:53.25,0:19:56.58,Default,,0,0,0,,Хо... не?
Dialogue: 0,0:19:53.25,0:19:56.58,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:19:56.58,0:20:01.25,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:19:56.58,0:20:01.25,Default,,0,0,0,,Мен таңғыш салып жатырмын.
Dialogue: 0,0:20:01.25,0:20:04.42,Default,,0,0,0,,Мен бірінші барамын.
Dialogue: 0,0:20:01.25,0:20:04.42,Default,,0,0,0,,Бірақ Китахара...
Dialogue: 0,0:20:04.42,0:20:07.59,Default,,0,0,0,,Ұшатын ештеңе қалмады!
Dialogue: 0,0:20:04.42,0:20:07.59,Default,,0,0,0,,Қахат! Апыр-ай!
Dialogue: 0,0:20:07.59,0:20:10.60,Default,,0,0,0,,Уайымдама, Кохеи. Бір рет қана.
Dialogue: 0,0:20:10.60,0:20:13.40,Default,,0,0,0,,Тек бір мүмкіндік үшін
Dialogue: 0,0:20:10.60,0:20:13.40,Default,,0,0,0,,Мен оған барымды беремін!
Dialogue: 0,0:20:15.44,0:20:19.27,Default,,0,0,0,,Гафуфуфу! Токи Баки
Dialogue: 0,0:20:15.44,0:20:19.27,Default,,0,0,0,,Бұл бала ең жақсы!
Dialogue: 0,0:20:19.27,0:20:22.78,Default,,0,0,0,,Сізге ұнағанына қуаныштымын
Dialogue: 0,0:20:19.27,0:20:22.78,Default,,0,0,0,,Қандай керемет талант.
Dialogue: 0,0:20:22.78,0:20:25.95,Default,,0,0,0,,Олай болса жылдамдықпен жарысайық!
Dialogue: 0,0:20:22.78,0:20:25.95,Default,,0,0,0,,Қабылдап, тұрайық!
Dialogue: 0,0:20:25.95,0:20:29.85,Default,,0,0,0,,Артында болыңыз! Кохеи!
Dialogue: 0,0:20:25.95,0:20:29.85,Default,,0,0,0,,Жоқ, сіз артта қалуыңыз керек.
Dialogue: 0,0:20:31.95,0:20:34.62,Default,,0,0,0,,Бұл қызық болды!
Dialogue: 0,0:20:34.62,0:20:37.12,Default,,0,0,0,,Олар жақсы балалар, солай емес пе?
Dialogue: 0,0:20:34.62,0:20:37.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:37.12,0:20:43.63,Default,,0,0,0,,Мұның несі жақсы?
Dialogue: 0,0:20:37.12,0:20:43.63,Default,,0,0,0,,Маған ұнады.
Dialogue: 0,0:20:43.63,0:20:45.97,Default,,0,0,0,,Эй, Чи Чан
Dialogue: 0,0:20:43.63,0:20:45.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:45.97,0:20:49.47,Default,,0,0,0,,Неге жұмбақ комикстерге бармайсың?
Dialogue: 0,0:20:49.47,0:20:52.97,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:20:49.47,0:20:52.97,Default,,0,0,0,,Мен мұның бәрі әйел болудың пайдасы туралы деп ойлаймын.
Dialogue: 0,0:20:52.97,0:20:55.41,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:20:52.97,0:20:55.41,Default,,0,0,0,,Хмм?
Dialogue: 0,0:20:55.41,0:20:58.08,Default,,0,0,0,,Өйткені қараңдаршы, анау балалар➡︎
Dialogue: 0,0:20:58.08,0:21:01.08,Default,,0,0,0,,Чи-чан жеңеді
Dialogue: 0,0:20:58.08,0:21:01.08,Default,,0,0,0,,Сіз бұған сендіңіз және ешқашан күмәнданбадыңыз, солай емес пе?
Dialogue: 0,0:21:01.08,0:21:06.25,Default,,0,0,0,,Бұл Чи Чанның ең жақсы екенін білдіреді.
Dialogue: 0,0:21:01.08,0:21:06.25,Default,,0,0,0,,Бұл сүйкімді деп ойлағандықтан емес.
Dialogue: 0,0:21:06.25,0:21:10.55,Default,,0,0,0,,((Егер Чиса пайда болса, жеңімпаз жүлде
Dialogue: 0,0:21:06.25,0:21:10.55,Default,,0,0,0,,Сіз аласыз))
Dialogue: 0,0:21:12.93,0:21:16.10,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:12.93,0:21:16.10,Default,,0,0,0,,Заттарыңды үйге әкетуді ұмытып қалғансың ғой…
Dialogue: 0,0:21:16.10,0:21:18.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:16.10,0:21:18.43,Default,,0,0,0,,Мен оны қандай болса да жек көремін➡︎
Dialogue: 0,0:21:18.43,0:21:20.43,Default,,0,0,0,,Бұл емес...
Dialogue: 0,0:21:23.27,0:21:26.44,Default,,0,0,0,,Мен үшін ғана ұят
Dialogue: 0,0:21:23.27,0:21:26.44,Default,,0,0,0,,Жасайық➡︎
Dialogue: 0,0:21:26.44,0:21:29.94,Default,,0,0,0,,Маған сенің ойың ұнамайды!
Dialogue: 0,0:21:29.94,0:21:32.28,Default,,0,0,0,,Ахахаха...!
Dialogue: 0,0:21:32.28,0:21:35.12,Default,,0,0,0,,Не!
Dialogue: 0,0:21:32.28,0:21:35.12,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:21:35.12,0:21:37.78,Default,,0,0,0,,Бұл еркектік емес!
Dialogue: 0,0:21:37.78,0:21:40.38,Default,,0,0,0,,Олай болса мынаны орындайық
Dialogue: 0,0:21:37.78,0:21:40.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:43.12,0:21:45.13,Default,,0,0,0,,Иори мен Кохеи➡︎ге рахмет
Dialogue: 0,0:21:45.13,0:21:47.63,Default,,0,0,0,,Чиса-чан қауіпсіз.
Dialogue: 0,0:21:45.13,0:21:47.63,Default,,0,0,0,,Мен Мифконға түсуді шештім.
Dialogue: 0,0:21:47.63,0:21:51.30,Default,,0,0,0,,Иә! Шын айтасың ба!
Dialogue: 0,0:21:47.63,0:21:51.30,Default,,0,0,0,,Ойыңызды бір түнде өзгертіңіз!
Dialogue: 0,0:21:51.30,0:21:53.63,Default,,0,0,0,,қатысты
Dialogue: 0,0:21:51.30,0:21:53.63,Default,,0,0,0,,Екеуіңе де берер нәрсем бар.
Dialogue: 0,0:21:53.63,0:21:57.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:53.63,0:21:57.40,Default,,0,0,0,,Енді алыңыз.
Dialogue: 0,0:21:57.40,0:22:00.07,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:57.40,0:22:00.07,Default,,0,0,0,,Чиса-чаннан➡︎
Dialogue: 0,0:22:00.07,0:22:02.58,Default,,0,0,0,,Миконға қатысуға қатысты
Dialogue: 0,0:22:00.07,0:22:02.58,Default,,0,0,0,,Ешқандай шарттар берілген жоқ.
Dialogue: 0,0:22:02.58,0:22:05.08,Default,,0,0,0,,Балалар, сендер де ерлер сайысына қатысатын сияқтысыңдар.
Dialogue: 0,0:22:05.08,0:22:08.58,Default,,0,0,0,,Сонда біз не үшінміз?
Dialogue: 0,0:22:05.08,0:22:08.58,Default,,0,0,0,,Бұл ысырапшыл әрекет!
Dialogue: 0,0:22:08.58,0:22:12.25,Default,,0,0,0,,Ең болмағанда сенде мына қыздың бар!
Dialogue: 0,0:22:08.58,0:22:12.25,Default,,0,0,0,,Сіз торлы адамсыз, солай ма?
Dialogue: 0,0:22:12.25,0:22:15.09,Default,,0,0,0,,Уф! Эй...!
Dialogue: 0,0:22:12.25,0:22:15.09,Default,,0,0,0,,Көңілді сияқты
Dialogue: 0,0:22:15.09,0:22:17.42,Default,,0,0,0,,Біздің жақсы дос болғанымыз қандай жақсы!
Dialogue: 0,0:22:17.42,0:22:21.93,Default,,0,0,0,,Мұның бәрі жақсы, солай ма?
Dialogue: 0,0:22:17.42,0:22:21.93,Default,,0,0,0,,Иә
Dialogue: 0,0:22:21.93,0:22:25.33,Default,,0,0,0,,Жарайды, мен аздап жеңілдеп қалдым.
Dialogue: 0,0:22:26.83,0:22:32.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
