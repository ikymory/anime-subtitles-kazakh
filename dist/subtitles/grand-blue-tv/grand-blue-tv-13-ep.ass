Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.27,0:00:15.78,Default,,0,0,0,,♬︎〜
Dialogue: 0,0:00:15.78,0:00:18.95,Default,,0,0,0,,Сіз үлкейдіңіз! Иори
Dialogue: 0,0:00:15.78,0:00:18.95,Default,,0,0,0,,10 жыл болды ма?
Dialogue: 0,0:00:18.95,0:00:21.29,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:00:21.29,0:00:24.29,Default,,0,0,0,,Бұдан былай біз отбасымыз.
Dialogue: 0,0:00:21.29,0:00:24.29,Default,,0,0,0,,Ардақтаушы сөздерді қолданбаңыз!
Dialogue: 0,0:00:24.29,0:00:28.13,Default,,0,0,0,,Әр бұрылыста сезімдеріңе ерік беріп жүру ме?
Dialogue: 0,0:00:24.29,0:00:28.13,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:00:28.13,0:00:30.33,Default,,0,0,0,,Иә...
Dialogue: 0,0:00:33.47,0:00:37.14,Default,,0,0,0,,Дайвинг дүкені Grand Blue…
Dialogue: 0,0:00:37.14,0:00:39.31,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл керемет болуы керек
Dialogue: 0,0:00:39.31,0:00:41.98,Default,,0,0,0,,Мен көлікті артта қалдырамын.
Dialogue: 0,0:00:39.31,0:00:41.98,Default,,0,0,0,,Осы жерден де бір қараңызшы.
Dialogue: 0,0:00:41.98,0:00:44.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:44.65,0:00:49.32,Default,,0,0,0,,《Университетке барғанда ағамның үйіне бардым.
Dialogue: 0,0:00:44.65,0:00:49.32,Default,,0,0,0,,Мен тегін жүктеймін➡︎
Dialogue: 0,0:00:49.32,0:00:52.32,Default,,0,0,0,,Мұнда 10 жылда алғаш рет келді
Dialogue: 0,0:00:49.32,0:00:52.32,Default,,0,0,0,,Теңіз жағасындағы қала
Dialogue: 0,0:00:52.32,0:00:55.76,Default,,0,0,0,,Толқынды есту
Dialogue: 0,0:00:52.32,0:00:55.76,Default,,0,0,0,,Жарқыраған күн》
Dialogue: 0,0:00:55.76,0:00:59.59,Default,,0,0,0,,Уау... ау
Dialogue: 0,0:00:59.59,0:01:01.59,Default,,0,0,0,,Га
Dialogue: 0,0:01:06.43,0:01:08.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:08.94,0:01:11.11,Default,,0,0,0,,А...
Dialogue: 0,0:01:08.94,0:01:11.11,Default,,0,0,0,,Иори! Бұл қайда?
Dialogue: 0,0:01:11.11,0:01:14.44,Default,,0,0,0,,А... иә! мен келе жатырмын!
Dialogue: 0,0:01:14.44,0:01:17.61,Default,,0,0,0,,《Мына қыз таныс сияқты...
Dialogue: 0,0:01:17.61,0:01:22.91,Default,,0,0,0,,Бұрынғыдан басқа ортада, И
Dialogue: 0,0:01:17.61,0:01:22.91,Default,,0,0,0,,Бізді қандай кездесу күтіп тұр? 》
Dialogue: 0,0:01:25.12,0:01:30.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:25.12,0:01:30.12,Default,,0,0,0,,Шығар! Қауіпсіз! Жақсы...
Dialogue: 0,0:03:01.58,0:03:03.92,Default,,0,0,0,,Со... ха...
Dialogue: 0,0:03:03.92,0:03:07.92,Default,,0,0,0,,《Менде қандай кездесу болды...》
Dialogue: 0,0:03:07.92,0:03:10.43,Default,,0,0,0,,Жойой жоқ!
Dialogue: 0,0:03:10.43,0:03:13.26,Default,,0,0,0,,Арх! Мен қалаған жаңа өмір...
Dialogue: 0,0:03:13.26,0:03:15.26,Default,,0,0,0,,Иори!
Dialogue: 0,0:03:13.26,0:03:15.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:15.26,0:03:18.27,Default,,0,0,0,,Менің дүкеніме қайтадан қош келдіңіз.
Dialogue: 0,0:03:15.26,0:03:18.27,Default,,0,0,0,,Ағай!
Dialogue: 0,0:03:18.27,0:03:20.44,Default,,0,0,0,,Бұл не!? Бұл біртүрлі!
Dialogue: 0,0:03:20.44,0:03:22.94,Default,,0,0,0,,А? О, мен жиі еститінім осы.
Dialogue: 0,0:03:22.94,0:03:25.61,Default,,0,0,0,,Маған
Dialogue: 0,0:03:22.94,0:03:25.61,Default,,0,0,0,,Мына алжапқыш маған жараспайды.
Dialogue: 0,0:03:25.61,0:03:28.11,Default,,0,0,0,,Олай емес!
Dialogue: 0,0:03:25.61,0:03:28.11,Default,,0,0,0,,Киім туралы емес пе?
Dialogue: 0,0:03:28.11,0:03:30.95,Default,,0,0,0,,Бұл киім туралы!
Dialogue: 0,0:03:28.11,0:03:30.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:30.95,0:03:33.95,Default,,0,0,0,,…Осылайша мен осы сұмдыққа ат қойдым
Dialogue: 0,0:03:30.95,0:03:33.95,Default,,0,0,0,,Да… Да~!
Dialogue: 0,0:03:33.95,0:03:37.62,Default,,0,0,0,,Бұл әдеттегі көрініс...
Dialogue: 0,0:03:33.95,0:03:37.62,Default,,0,0,0,,Мен ата-анамның үйіне қайтамын!
Dialogue: 0,0:03:37.62,0:03:40.46,Default,,0,0,0,,Сағыныш?
Dialogue: 0,0:03:37.62,0:03:40.46,Default,,0,0,0,,Менеджер Қазір бұл не?
Dialogue: 0,0:03:40.46,0:03:44.46,Default,,0,0,0,,Ол Изу университетіне түскен үлкен бала.
Dialogue: 0,0:03:40.46,0:03:44.46,Default,,0,0,0,,Үлкен балаңыз Изу университетіне бара ма?
Dialogue: 0,0:03:44.46,0:03:48.63,Default,,0,0,0,,Бұл Токита дегенді білдіреді...
Dialogue: 0,0:03:44.46,0:03:48.63,Default,,0,0,0,,Дұрыс, Котобуки.
Dialogue: 0,0:03:48.63,0:03:51.13,Default,,0,0,0,,Жаңадан келгендер үшін мүмкіндік!
Dialogue: 0,0:03:54.14,0:03:56.74,Default,,0,0,0,,Дүкенде неге мұндай бұзық бар...
Dialogue: 0,0:03:56.74,0:03:59.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:56.74,0:03:59.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:59.74,0:04:02.24,Default,,0,0,0,,Күте тұрыңыз! Жаңа студент!
Dialogue: 0,0:04:02.24,0:04:05.25,Default,,0,0,0,,Сіз сыртқа келесіз бе?
Dialogue: 0,0:04:05.25,0:04:07.75,Default,,0,0,0,,Күте тұрыңыз! Жаңадан келген! Неге қашып кетіңіз!?
Dialogue: 0,0:04:07.75,0:04:09.75,Default,,0,0,0,,Сіз міндетті түрде қашып кетесіз!
Dialogue: 0,0:04:09.75,0:04:12.59,Default,,0,0,0,,Енді сен!
Dialogue: 0,0:04:09.75,0:04:12.59,Default,,0,0,0,,Ол ұялшақ бала!
Dialogue: 0,0:04:12.59,0:04:14.76,Default,,0,0,0,,Сіз өзіңіздің қандай екеніңізді білесіз бе?
Dialogue: 0,0:04:14.76,0:04:18.09,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:04:14.76,0:04:18.09,Default,,0,0,0,,Дәлелді себеп бар ма?
Dialogue: 0,0:04:18.09,0:04:21.76,Default,,0,0,0,,Бізді тыңдаңыз!
Dialogue: 0,0:04:18.09,0:04:21.76,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:04:21.76,0:04:24.26,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:04:28.60,0:04:31.77,Default,,0,0,0,,Қош келдіңіз Иори
Dialogue: 0,0:04:28.60,0:04:31.77,Default,,0,0,0,,Сіздің үйдегі ауруыңыз жазылды ма?
Dialogue: 0,0:04:31.77,0:04:34.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:31.77,0:04:34.44,Default,,0,0,0,,Жарайды, мен бір күні адам боламын➡︎
Dialogue: 0,0:04:34.44,0:04:38.28,Default,,0,0,0,,Ата-анаңызды тастап кету
Dialogue: 0,0:04:34.44,0:04:38.28,Default,,0,0,0,,Жарайды! Жақында үйреніп кетесің
Dialogue: 0,0:04:38.28,0:04:41.95,Default,,0,0,0,,Неліктен менің үйім ауырады?
Dialogue: 0,0:04:38.28,0:04:41.95,Default,,0,0,0,,Оқиға ілгерілеуде...
Dialogue: 0,0:04:41.95,0:04:44.29,Default,,0,0,0,,Олай емес пе?
Dialogue: 0,0:04:41.95,0:04:44.29,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:44.29,0:04:47.62,Default,,0,0,0,,Дүкенге кірсем, жалаңаш фестиваль екен.
Dialogue: 0,0:04:44.29,0:04:47.62,Default,,0,0,0,,Мен таң қалдым да, қашып кеттім!
Dialogue: 0,0:04:47.62,0:04:51.13,Default,,0,0,0,,Біз сізге ұнайсыз
Dialogue: 0,0:04:47.62,0:04:51.13,Default,,0,0,0,,Мен осылай киіндім деп ойлайсың ба?
Dialogue: 0,0:04:51.13,0:04:53.96,Default,,0,0,0,,Олай емес пе?
Dialogue: 0,0:04:51.13,0:04:53.96,Default,,0,0,0,,Мен оны жоққа шығармаймын
Dialogue: 0,0:04:53.96,0:04:56.73,Default,,0,0,0,,Ол азғын...
Dialogue: 0,0:04:53.96,0:04:56.73,Default,,0,0,0,,Бұл резервуарды дайындау➡︎
Dialogue: 0,0:04:56.73,0:05:00.07,Default,,0,0,0,,Мен тек рок-н-ролл ойнадым.
Dialogue: 0,0:04:56.73,0:05:00.07,Default,,0,0,0,,Резервуарды дайындау?
Dialogue: 0,0:05:00.07,0:05:04.57,Default,,0,0,0,,Сүңгу кезінде қолданылатын құрал-жабдықтар
Dialogue: 0,0:05:00.07,0:05:04.57,Default,,0,0,0,,Ах... Солай ма?
Dialogue: 0,0:05:04.57,0:05:07.24,Default,,0,0,0,,Сонымен, сен сол аралда не істеп жүрдің?
Dialogue: 0,0:05:04.57,0:05:07.24,Default,,0,0,0,,Рок-н-ролл ойынында шешілді.
Dialogue: 0,0:05:07.24,0:05:09.91,Default,,0,0,0,,А... Сонда?
Dialogue: 0,0:05:07.24,0:05:09.91,Default,,0,0,0,,«Сонымен» нені білдіреді?
Dialogue: 0,0:05:09.91,0:05:12.08,Default,,0,0,0,,Мұның жалаңаштыққа қандай қатысы бар?
Dialogue: 0,0:05:12.08,0:05:14.92,Default,,0,0,0,,Бейсбол жұдырығын ойнасаңыз
Dialogue: 0,0:05:12.08,0:05:14.92,Default,,0,0,0,,Мүлдем жалаңаш болу ақылға қонымды.
Dialogue: 0,0:05:14.92,0:05:18.62,Default,,0,0,0,,Бейсбол жұдырығынан басқа ойын ойнайсыз ба?
Dialogue: 0,0:05:14.92,0:05:18.62,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:05:20.59,0:05:24.59,Default,,0,0,0,,Мен Рюдзиро Котобүкимін
Dialogue: 0,0:05:20.59,0:05:24.59,Default,,0,0,0,,Мен Изу университетінде машина жасау мамандығының үшінші курсындамын.
Dialogue: 0,0:05:24.59,0:05:27.60,Default,,0,0,0,,Бұл Иори Китахара.
Dialogue: 0,0:05:24.59,0:05:27.60,Default,,0,0,0,,Біз бір кафедрадамыз, солай ма?
Dialogue: 0,0:05:27.60,0:05:32.93,Default,,0,0,0,,Түсінемін... Менің үйірмеде сол бөлімде кіші курс студенті бар.
Dialogue: 0,0:05:27.60,0:05:32.93,Default,,0,0,0,,Мен осында болғаныма қуаныштымын.
Dialogue: 0,0:05:32.93,0:05:35.10,Default,,0,0,0,,Мен кіремін деп айтқан жоқпын.
Dialogue: 0,0:05:35.10,0:05:38.61,Default,,0,0,0,,А... бірдеңе
Dialogue: 0,0:05:35.10,0:05:38.61,Default,,0,0,0,,Менің көзіме қарап білуге болады
Dialogue: 0,0:05:38.61,0:05:40.78,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:40.78,0:05:43.95,Default,,0,0,0,,♬~
Dialogue: 0,0:05:40.78,0:05:43.95,Default,,0,0,0,,≪Ол күлмейді≫
Dialogue: 0,0:05:43.95,0:05:47.62,Default,,0,0,0,,Сіз дайвингке қызығасыз ба?
Dialogue: 0,0:05:43.95,0:05:47.62,Default,,0,0,0,,Бар.
Dialogue: 0,0:05:47.62,0:05:50.12,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:05:47.62,0:05:50.12,Default,,0,0,0,,Бірақ менің мотивациям жоқ.
Dialogue: 0,0:05:50.12,0:05:53.12,Default,,0,0,0,,Неліктен? Оны қолданып көргің келмей ме?
Dialogue: 0,0:05:53.12,0:05:56.06,Default,,0,0,0,,Мен жүзе алмаймын...
Dialogue: 0,0:05:56.06,0:06:00.06,Default,,0,0,0,,Иә? Ахаха!
Dialogue: 0,0:05:56.06,0:06:00.06,Default,,0,0,0,,Жапон тілін жақсы білмейсің, солай ма?
Dialogue: 0,0:06:00.06,0:06:02.06,Default,,0,0,0,,Не? кенеттен
Dialogue: 0,0:06:02.06,0:06:04.07,Default,,0,0,0,,Өйткені
Dialogue: 0,0:06:02.06,0:06:04.07,Default,,0,0,0,,Мен мұны қалаймын ба? Жасағым келмейді➡︎
Dialogue: 0,0:06:04.07,0:06:06.40,Default,,0,0,0,,«Болады» және «Мүмкін емес»
Dialogue: 0,0:06:04.07,0:06:06.40,Default,,0,0,0,,Сіз қалай жауап беруге батылыңыз бар?
Dialogue: 0,0:06:06.40,0:06:09.07,Default,,0,0,0,,Бірақ мен теңізге сүңгіп кетсем де
Dialogue: 0,0:06:06.40,0:06:09.07,Default,,0,0,0,,Мен жүзе алмаймын...
Dialogue: 0,0:06:09.07,0:06:11.41,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:06:11.41,0:06:13.74,Default,,0,0,0,,Не болса да...
Dialogue: 0,0:06:13.74,0:06:17.91,Default,,0,0,0,,Тек басынан бастап не істей аласыз
Dialogue: 0,0:06:13.74,0:06:17.91,Default,,0,0,0,,Егер сіз таңдасаңыз, ештеңе болмайды
Dialogue: 0,0:06:17.91,0:06:22.11,Default,,0,0,0,,Маңыздысы сізсіз
Dialogue: 0,0:06:17.91,0:06:22.11,Default,,0,0,0,,Сізді қызықтырады ма?
Dialogue: 0,0:06:30.93,0:06:33.93,Default,,0,0,0,,Алдын ала қарау Еңбегіңізге рахмет!
Dialogue: 0,0:06:30.93,0:06:33.93,Default,,0,0,0,,Ах
Dialogue: 0,0:06:33.93,0:06:38.60,Default,,0,0,0,,Мен танкті артта қалдырамын.
Dialogue: 0,0:06:33.93,0:06:38.60,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:06:38.60,0:06:41.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:38.60,0:06:41.94,Default,,0,0,0,,​​О?
Dialogue: 0,0:06:41.94,0:06:45.61,Default,,0,0,0,,Қош келдіңіз! Иори-кун
Dialogue: 0,0:06:41.94,0:06:45.61,Default,,0,0,0,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:06:45.61,0:06:48.78,Default,,0,0,0,,«Танысқаныма қуаныштымын»?
Dialogue: 0,0:06:45.61,0:06:48.78,Default,,0,0,0,,Сен мені ұмыттың ба?
Dialogue: 0,0:06:48.78,0:06:50.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:50.78,0:06:53.78,Default,,0,0,0,,Нағашымның бетін қалай ұмытамын?
Dialogue: 0,0:06:50.78,0:06:53.78,Default,,0,0,0,,Суық.
Dialogue: 0,0:06:55.72,0:06:59.89,Default,,0,0,0,,Кешіріңіз, мен байқамадым.
Dialogue: 0,0:06:55.72,0:06:59.89,Default,,0,0,0,,10 жыл болды.
Dialogue: 0,0:06:59.89,0:07:03.06,Default,,0,0,0,,Сіз Чиса-чанды кездестірдіңіз бе?
Dialogue: 0,0:06:59.89,0:07:03.06,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:07:03.06,0:07:05.06,Default,,0,0,0,,Мен сені кездестірсем таң қаламын!
Dialogue: 0,0:07:05.06,0:07:07.23,Default,,0,0,0,,Төтенше
Dialogue: 0,0:07:05.06,0:07:07.23,Default,,0,0,0,,Енді сүйкімді!
Dialogue: 0,0:07:07.23,0:07:09.90,Default,,0,0,0,,(Құлақтағы сыңғыру)
Dialogue: 0,0:07:07.23,0:07:09.90,Default,,0,0,0,,Біз бірге суға шомылдық...
Dialogue: 0,0:07:09.90,0:07:13.90,Default,,0,0,0,,А, мүмкін...
Dialogue: 0,0:07:13.90,0:07:16.40,Default,,0,0,0,,Токита-кун және оның достары
Dialogue: 0,0:07:13.90,0:07:16.40,Default,,0,0,0,,Сіз үйірмеге қосылмақшысыз ба?
Dialogue: 0,0:07:16.40,0:07:19.24,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:16.40,0:07:19.24,Default,,0,0,0,,Сіз дайвингті жек көресіз бе?
Dialogue: 0,0:07:19.24,0:07:21.58,Default,,0,0,0,,Мен оны жек көремін деп ойламаймын, бірақ...
Dialogue: 0,0:07:21.58,0:07:25.41,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:07:21.58,0:07:25.41,Default,,0,0,0,,Мен ер балалар мектебін бітірдім➡︎
Dialogue: 0,0:07:25.41,0:07:29.08,Default,,0,0,0,,Мен біраз қашықтықты сақтағым келеді.
Dialogue: 0,0:07:25.41,0:07:29.08,Default,,0,0,0,,Қашықтық? Неден?
Dialogue: 0,0:07:29.08,0:07:31.92,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:31.92,0:07:33.92,Default,,0,0,0,,Уау! Хахаха...!
Dialogue: 0,0:07:33.92,0:07:36.26,Default,,0,0,0,,Осы сияқты
Dialogue: 0,0:07:33.92,0:07:36.26,Default,,0,0,0,,Бұл ұлдар мектебіндегі Нори деген жігіттен!
Dialogue: 0,0:07:36.26,0:07:38.26,Default,,0,0,0,,Ой! Қайтып келдің бе?
Dialogue: 0,0:07:38.26,0:07:41.93,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:07:38.26,0:07:41.93,Default,,0,0,0,,Әзірше киініңіз.
Dialogue: 0,0:07:41.93,0:07:44.43,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:07:41.93,0:07:44.43,Default,,0,0,0,,Иори-кунға қамқор болыңыз!
Dialogue: 0,0:07:44.43,0:07:47.77,Default,,0,0,0,,Күт! Мені иығыңда көтеруді қой!
Dialogue: 0,0:07:44.43,0:07:47.77,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:07:47.77,0:07:52.11,Default,,0,0,0,,Ал, бүгін сіздің қарсы алу кешіңіз!
Dialogue: 0,0:07:47.77,0:07:52.11,Default,,0,0,0,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:07:52.11,0:07:55.11,Default,,0,0,0,,Менің үйірмеге қосылатын ойым жоқ.
Dialogue: 0,0:07:52.11,0:07:55.11,Default,,0,0,0,,Бірінші кезекте...
Dialogue: 0,0:07:55.11,0:07:57.04,Default,,0,0,0,,Артық айтпаңыз
Dialogue: 0,0:07:55.11,0:07:57.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:57.04,0:07:59.05,Default,,0,0,0,,Жарайсың ба? Иори
Dialogue: 0,0:07:57.04,0:07:59.05,Default,,0,0,0,,Не ол?
Dialogue: 0,0:07:59.05,0:08:02.22,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:07:59.05,0:08:02.22,Default,,0,0,0,,Оны жегенді ұнатпайтындар көп сияқты.
Dialogue: 0,0:08:02.22,0:08:04.72,Default,,0,0,0,,Ондай ештеңе жоқ...
Dialogue: 0,0:08:02.22,0:08:04.72,Default,,0,0,0,,Онда болады!
Dialogue: 0,0:08:04.72,0:08:07.05,Default,,0,0,0,,Мен мұны бұрын ешқашан жасаған емеспін
Dialogue: 0,0:08:04.72,0:08:07.05,Default,,0,0,0,,Себебі сіз шағымданасыз.
Dialogue: 0,0:08:07.05,0:08:09.39,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:08:07.05,0:08:09.39,Default,,0,0,0,,Мен мұны бұрын ешқашан жасаған емеспін➡︎
Dialogue: 0,0:08:09.39,0:08:11.73,Default,,0,0,0,,Қоғамдық жолдарда жалаңаш жүгіру
Dialogue: 0,0:08:09.39,0:08:11.73,Default,,0,0,0,,Жақсы емес!
Dialogue: 0,0:08:11.73,0:08:14.06,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:08:11.73,0:08:14.06,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:08:14.06,0:08:16.06,Default,,0,0,0,,Әзірше мынаны ішіңіз➡︎
Dialogue: 0,0:08:16.06,0:08:20.07,Default,,0,0,0,,Бейсбол жұдырығынан бастау керек шығар.
Dialogue: 0,0:08:16.06,0:08:20.07,Default,,0,0,0,,Барлығы тәжірибе
Dialogue: 0,0:08:20.07,0:08:22.90,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:08:20.07,0:08:22.90,Default,,0,0,0,,Бұл міндетті түрде тәжірибе емес!
Dialogue: 0,0:08:22.90,0:08:26.24,Default,,0,0,0,,Бұл дүниеде босқа кеткен тәжірибе жоқ.
Dialogue: 0,0:08:22.90,0:08:26.24,Default,,0,0,0,,жоқ
Dialogue: 0,0:08:26.24,0:08:29.74,Default,,0,0,0,,Өзіңізді алданып қалдым деп ойлап, жасап көріңіз.
Dialogue: 0,0:08:26.24,0:08:29.74,Default,,0,0,0,,Мен үзілді-кесілді бас тартамын
Dialogue: 0,0:08:29.74,0:08:32.75,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз!
Dialogue: 0,0:08:29.74,0:08:32.75,Default,,0,0,0,,Бұл азаймайды!
Dialogue: 0,0:08:32.75,0:08:37.25,Default,,0,0,0,,I won't do it! Мен ондай емеспін
Dialogue: 0,0:08:32.75,0:08:37.25,Default,,0,0,0,,Ол ешқашан дақ қалдырмайды!
Dialogue: 0,0:08:40.92,0:08:43.92,Default,,0,0,0,,Бұл Иори, солай ма?
Dialogue: 0,0:08:48.93,0:08:51.33,Default,,0,0,0,,10 жыл болды...
Dialogue: 0,0:08:57.54,0:08:59.54,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:08:59.54,0:09:02.71,Default,,0,0,0,,Nanbo's Monjai!
Dialogue: 0,0:08:59.54,0:09:02.71,Default,,0,0,0,,Жасайық! Иори!
Dialogue: 0,0:09:02.71,0:09:05.05,Default,,0,0,0,,Мен үш адамды қалдыруға қорықтым!
Dialogue: 0,0:09:05.05,0:09:08.72,Default,,0,0,0,,Тез жеңілу менің абыройым.
Dialogue: 0,0:09:05.05,0:09:08.72,Default,,0,0,0,,Мен оны саған көрсеткім келеді!
Dialogue: 0,0:09:08.72,0:09:11.89,Default,,0,0,0,,Мистер Спидвагоннан қоңырау
Dialogue: 0,0:09:08.72,0:09:11.89,Default,,0,0,0,,Бұл бәрібір тіс тазалағыш, солай ма?
Dialogue: 0,0:09:11.89,0:09:14.72,Default,,0,0,0,,Қанша адам келсе де
Dialogue: 0,0:09:11.89,0:09:14.72,Default,,0,0,0,,Менің трусикам...!
Dialogue: 0,0:09:14.72,0:09:18.72,Default,,0,0,0,,Ах, Чиса-чан, қош келдіңіз.
Dialogue: 0,0:09:14.72,0:09:18.72,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:09:23.56,0:09:25.57,Default,,0,0,0,,Сен «Телефон ауқымын» айтып тұрсың ба? Иә
Dialogue: 0,0:09:25.57,0:09:30.57,Default,,0,0,0,,Эй, біраз болды, Чиса.
Dialogue: 0,0:09:25.57,0:09:30.57,Default,,0,0,0,,Мені есіңізде ме?
Dialogue: 0,0:09:30.57,0:09:34.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:34.24,0:09:38.41,Default,,0,0,0,,Мен мұны тастауым керек сияқты.
Dialogue: 0,0:09:34.24,0:09:38.41,Default,,0,0,0,,Менің қолым шынымен лас па?
Dialogue: 0,0:09:38.41,0:09:43.08,Default,,0,0,0,,Иори сондай ақымақ адам
Dialogue: 0,0:09:38.41,0:09:43.08,Default,,0,0,0,,Мен бұлай болады деп ойламадым.
Dialogue: 0,0:09:43.08,0:09:46.92,Default,,0,0,0,,That's not true! Уф...
Dialogue: 0,0:09:46.92,0:09:49.09,Default,,0,0,0,,Қарғыс атсын! Неліктен бұл болып жатыр...
Dialogue: 0,0:09:49.09,0:09:51.43,Default,,0,0,0,,Сіз және Чиса Чан
Dialogue: 0,0:09:49.09,0:09:51.43,Default,,0,0,0,,Are you a cousin?
Dialogue: 0,0:09:51.43,0:09:54.60,Default,,0,0,0,,Әдемі немере ағасымен бірге тұру - сән-салтанат.
Dialogue: 0,0:09:54.60,0:09:58.77,Default,,0,0,0,,Дәл қазір, лас сияқты.
Dialogue: 0,0:09:54.60,0:09:58.77,Default,,0,0,0,,Мен жаңа ғана емделдім.
Dialogue: 0,0:09:58.77,0:10:03.10,Default,,0,0,0,,Бірақ бәрібір. Сол үйде
Dialogue: 0,0:09:58.77,0:10:03.10,Default,,0,0,0,,Нанака-сан осында!
Dialogue: 0,0:10:03.10,0:10:06.77,Default,,0,0,0,,А...
Dialogue: 0,0:10:03.10,0:10:06.77,Default,,0,0,0,,Одан бас тарт, Иори.
Dialogue: 0,0:10:06.77,0:10:09.61,Default,,0,0,0,,(Изуку) Қарсыластың өз күшін пайдаланып, дәл қорғанына сондай етіп сүңгу...
Dialogue: 0,0:10:06.77,0:10:09.61,Default,,0,0,0,,Маған ұнамайды➡︎
Dialogue: 0,0:10:09.61,0:10:11.78,Default,,0,0,0,,Нанака-сан
Dialogue: 0,0:10:09.61,0:10:11.78,Default,,0,0,0,,Ол жасыруға тырысса керек➡︎
Dialogue: 0,0:10:11.78,0:10:14.88,Default,,0,0,0,,Іс жүзінде тек тараптар үшін
Dialogue: 0,0:10:11.78,0:10:14.88,Default,,0,0,0,,Мен оған кірген жоқпын...
Dialogue: 0,0:10:19.79,0:10:22.62,Default,,0,0,0,,Бұл адам қатты психоз.
Dialogue: 0,0:10:22.62,0:10:25.13,Default,,0,0,0,,Соңғы 10 жылда не болды!
Dialogue: 0,0:10:25.13,0:10:29.46,Default,,0,0,0,,Онша емес... Мен бүгін кездестірген адамдардың ішінде
Dialogue: 0,0:10:25.13,0:10:29.46,Default,,0,0,0,,Жалғыз ем...
Dialogue: 0,0:10:29.46,0:10:32.47,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:10:29.46,0:10:32.47,Default,,0,0,0,,Үйде қандай қызғылт түсті➡︎
Dialogue: 0,0:10:32.47,0:10:34.80,Default,,0,0,0,,Қол жетімді емес нәрсе
Dialogue: 0,0:10:32.47,0:10:34.80,Default,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:10:34.80,0:10:37.64,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:10:37.64,0:10:40.47,Default,,0,0,0,,Үйде драма бар ма?
Dialogue: 0,0:10:37.64,0:10:40.47,Default,,0,0,0,,Сұрамауыңыз керек!
Dialogue: 0,0:10:40.47,0:10:43.14,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:10:40.47,0:10:43.14,Default,,0,0,0,,Олай болса болды➡︎
Dialogue: 0,0:10:43.14,0:10:46.84,Default,,0,0,0,,Мен университет өмірінде бар күшімді саламын!
Dialogue: 0,0:10:43.14,0:10:46.84,Default,,0,0,0,,О! Жанып жатыр!
Dialogue: 0,0:10:48.98,0:10:52.49,Default,,0,0,0,,Енді кештен кейінгі кешке барайық!
Dialogue: 0,0:10:48.98,0:10:52.49,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:10:52.49,0:10:55.92,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:10:52.49,0:10:55.92,Default,,0,0,0,,Ертеңгі жарты күндік жұмыс таң ата.
Dialogue: 0,0:10:55.92,0:10:58.93,Default,,0,0,0,,Мен үшін де соңғы пойыз
Dialogue: 0,0:10:55.92,0:10:58.93,Default,,0,0,0,,Мен де...
Dialogue: 0,0:10:58.93,0:11:03.26,Default,,0,0,0,,Саған соңғы пойыз бәрібір емес пе?
Dialogue: 0,0:10:58.93,0:11:03.26,Default,,0,0,0,,Үй осында.
Dialogue: 0,0:11:03.26,0:11:06.77,Default,,0,0,0,,Жоқ, жоқ, жоқ... Ертең сағат 9-дан бастап
Dialogue: 0,0:11:03.26,0:11:06.77,Default,,0,0,0,,Бұл сіздің бірінші күніңіздегі нұсқаулық!
Dialogue: 0,0:11:06.77,0:11:12.44,Default,,0,0,0,,Жарайды. Маған қалдырыңыз.
Dialogue: 0,0:11:06.77,0:11:12.44,Default,,0,0,0,,Мен ешқашан кешікпейтінімді қадағалаймын.
Dialogue: 0,0:11:12.44,0:11:14.64,Default,,0,0,0,,А...
Dialogue: 0,0:11:19.11,0:11:23.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:23.12,0:11:26.29,Default,,0,0,0,,Уф! Басым ауырып тұр... Ой
Dialogue: 0,0:11:26.29,0:11:29.29,Default,,0,0,0,,Сол ішімдікке барғаным үшін.
Dialogue: 0,0:11:29.29,0:11:31.46,Default,,0,0,0,,Ум, сағат неше?
Dialogue: 0,0:11:31.46,0:11:33.96,Default,,0,0,0,,Уа! Сіз кешігіп қалдыңыз!
Dialogue: 0,0:11:33.96,0:11:35.96,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:11:33.96,0:11:35.96,Default,,0,0,0,,Ах, Маеда әлі тірі екені
Dialogue: 0,0:11:35.96,0:11:39.63,Default,,0,0,0,,А... а?
Dialogue: 0,0:11:35.96,0:11:39.63,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:11:39.63,0:11:41.83,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:45.97,0:11:48.98,Default,,0,0,0,,Жоқ! Егер бұл болса
Dialogue: 0,0:11:45.97,0:11:48.98,Default,,0,0,0,,Мен ешқашан кешікпеймін!
Dialogue: 0,0:11:48.98,0:11:51.65,Default,,0,0,0,,Ей ақымақтар!
Dialogue: 0,0:11:51.65,0:11:53.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:57.42,0:12:02.26,Default,,0,0,0,,《Үмітке толы жаңа кездесулер
Dialogue: 0,0:11:57.42,0:12:02.26,Default,,0,0,0,,Жаңа өмір...》
Dialogue: 0,0:12:02.26,0:12:05.09,Default,,0,0,0,,Бұл аудиторияның алдында болды.
Dialogue: 0,0:12:02.26,0:12:05.09,Default,,0,0,0,,Ол мас болғанын айтты...
Dialogue: 0,0:12:05.09,0:12:08.43,Default,,0,0,0,,《Қабылдаумен бір уақытта
Dialogue: 0,0:12:05.09,0:12:08.43,Default,,0,0,0,,Ол сұр түске боялған》
Dialogue: 0,0:12:08.43,0:12:11.43,Default,,0,0,0,,Эй, әлгі адам...
Dialogue: 0,0:12:08.43,0:12:11.43,Default,,0,0,0,,Сәл салқын емес пе?
Dialogue: 0,0:12:11.43,0:12:15.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:15.10,0:12:17.10,Default,,0,0,0,,《Мм... Аа...
Dialogue: 0,0:12:17.10,0:12:19.94,Default,,0,0,0,,Ол, әрине, әдемі... Иә! 》
Dialogue: 0,0:12:19.94,0:12:21.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:24.28,0:12:27.28,Default,,0,0,0,,Дегенмен, жай кешіру ұзақ мерзімде саған еш пайда әкелмейді.
Dialogue: 0,0:12:24.28,0:12:27.28,Default,,0,0,0,,Һмпф
Dialogue: 0,0:12:27.28,0:12:30.78,Default,,0,0,0,,《Кохеи/Иори: Тек осы жігітпен
Dialogue: 0,0:12:27.28,0:12:30.78,Default,,0,0,0,,Қатыспайды》
Dialogue: 0,0:12:30.78,0:12:33.12,Default,,0,0,0,,Мұның бәрі түсіндіру үшін
Dialogue: 0,0:12:33.12,0:12:36.79,Default,,0,0,0,,Шеңберге саяхатқа шығайық.
Dialogue: 0,0:12:33.12,0:12:36.79,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:12:36.79,0:12:40.63,Default,,0,0,0,,Шеңберді аралау... Әй?
Dialogue: 0,0:12:40.63,0:12:44.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:40.63,0:12:44.47,Default,,0,0,0,,Чиса, сен шеңберді аралауға бара жатырсың...
Dialogue: 0,0:12:44.47,0:12:47.13,Default,,0,0,0,,О... эй!
Dialogue: 0,0:12:47.13,0:12:49.64,Default,,0,0,0,,Менімен олай сөйлеспе.
Dialogue: 0,0:12:49.64,0:12:52.31,Default,,0,0,0,,Аа... Енді сіз оны айтып отырсыз...
Dialogue: 0,0:12:52.31,0:12:55.91,Default,,0,0,0,,Үйге барып киінгім келеді.
Dialogue: 0,0:12:52.31,0:12:55.91,Default,,0,0,0,,Мен үйге баратын жолды білмеймін
Dialogue: 0,0:12:55.91,0:12:59.08,Default,,0,0,0,,Ал, мен үйге барайын.
Dialogue: 0,0:12:55.91,0:12:59.08,Default,,0,0,0,,Жарайды, солай істейік.
Dialogue: 0,0:12:59.08,0:13:03.42,Default,,0,0,0,,Неге менің артымнан келе жатырсың?
Dialogue: 0,0:12:59.08,0:13:03.42,Default,,0,0,0,,Мен бағыт сұрағым келді.
Dialogue: 0,0:13:03.42,0:13:05.59,Default,,0,0,0,,Мүлдем жиіркенішті!
Dialogue: 0,0:13:03.42,0:13:05.59,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:05.59,0:13:08.92,Default,,0,0,0,,Маған айтпаса түсінбейсің бе?
Dialogue: 0,0:13:05.59,0:13:08.92,Default,,0,0,0,,Жоқ, мен оны түсіндім.
Dialogue: 0,0:13:08.92,0:13:11.93,Default,,0,0,0,,Жақсырақ анық
Dialogue: 0,0:13:08.92,0:13:11.93,Default,,0,0,0,,Түсінулеріңізді қалаймын.
Dialogue: 0,0:13:11.93,0:13:14.76,Default,,0,0,0,,Ал, мен үйге барайын.
Dialogue: 0,0:13:14.76,0:13:17.60,Default,,0,0,0,,Сен менімен біргесің
Dialogue: 0,0:13:14.76,0:13:17.60,Default,,0,0,0,,Үйге барғың келмейтінін түсіндім.
Dialogue: 0,0:13:17.60,0:13:19.93,Default,,0,0,0,,Бірақ мен де қиналып жүрмін.
Dialogue: 0,0:13:19.93,0:13:22.10,Default,,0,0,0,,Ендеше маған киімдеріңді беріңдер!
Dialogue: 0,0:13:22.10,0:13:25.27,Default,,0,0,0,,Жартылай жалаңаш бұзық не киеді
Dialogue: 0,0:13:22.10,0:13:25.27,Default,,0,0,0,,Ол маған жақындап, оны беруімді айтып жатыр.
Dialogue: 0,0:13:25.27,0:13:28.44,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:13:25.27,0:13:28.44,Default,,0,0,0,,Біз туысқанбыз!? Біз!
Dialogue: 0,0:13:28.44,0:13:32.28,Default,,0,0,0,,Менің қиыншылықтарым - сенің қиындықтарың!
Dialogue: 0,0:13:28.44,0:13:32.28,Default,,0,0,0,,Киімдерің менікі!
Dialogue: 0,0:13:32.28,0:13:35.95,Default,,0,0,0,,Бұл бір-бірін қолдайтын қарым-қатынас!
Dialogue: 0,0:13:32.28,0:13:35.95,Default,,0,0,0,,Тоқта...
Dialogue: 0,0:13:35.95,0:13:39.29,Default,,0,0,0,,Оны қатты айтпа
Dialogue: 0,0:13:35.95,0:13:39.29,Default,,0,0,0,,«Осындай нәрсе»?
Dialogue: 0,0:13:39.29,0:13:43.29,Default,,0,0,0,,Анау... немере ағасы немесе сол сияқты...
Dialogue: 0,0:13:43.29,0:13:47.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:43.29,0:13:47.13,Default,,0,0,0,,Жарайды, маған киім бермесең➡︎
Dialogue: 0,0:13:47.13,0:13:50.97,Default,,0,0,0,,Мен және сен біргеміз
Dialogue: 0,0:13:47.13,0:13:50.97,Default,,0,0,0,,Осы жерде тұратыныңызды жарнамалаңыз!
Dialogue: 0,0:13:50.97,0:13:54.13,Default,,0,0,0,,Ах... Қарғыс атсын!
Dialogue: 0,0:13:54.13,0:13:56.07,Default,,0,0,0,,Бізді жай ғана адастырды!
Dialogue: 0,0:13:54.13,0:13:56.07,Default,,0,0,0,,О
Dialogue: 0,0:13:56.07,0:14:00.91,Default,,0,0,0,,Шешіңіз... Мен шешемін, өтінемін.
Dialogue: 0,0:14:00.91,0:14:04.08,Default,,0,0,0,,Үй туралы
Dialogue: 0,0:14:00.91,0:14:04.08,Default,,0,0,0,,Хабарды таратпаңыз
Dialogue: 0,0:14:04.08,0:14:06.08,Default,,0,0,0,,Бір минут күтіңіз... сол жол➡︎
Dialogue: 0,0:14:06.08,0:14:10.25,Default,,0,0,0,,Сырттан
Dialogue: 0,0:14:06.08,0:14:10.25,Default,,0,0,0,,Бұл қылмыстың иісі...
Dialogue: 0,0:14:10.25,0:14:12.42,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:14:12.42,0:14:14.92,Default,,0,0,0,,(Дарионың жөтел ұстамасы)
Dialogue: 0,0:14:14.92,0:14:18.43,Default,,0,0,0,,жартылай жалаңаш
Dialogue: 0,0:14:14.92,0:14:18.43,Default,,0,0,0,,Күдікті адам келмеді ме?
Dialogue: 0,0:14:18.43,0:14:21.26,Default,,0,0,0,,《Мен қандаймын?
Dialogue: 0,0:14:18.43,0:14:21.26,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:14:21.26,0:14:23.93,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:21.26,0:14:23.93,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:14:23.93,0:14:27.10,Default,,0,0,0,,Бұл не... сен?
Dialogue: 0,0:14:27.10,0:14:29.27,Default,,0,0,0,,Әртүрлі жағдайлар болады.
Dialogue: 0,0:14:29.27,0:14:32.61,Default,,0,0,0,,Жағдайға байланысты
Dialogue: 0,0:14:29.27,0:14:32.61,Default,,0,0,0,,Мен сізге көмектесе алмаймын.
Dialogue: 0,0:14:32.61,0:14:35.28,Default,,0,0,0,,Сіз шынымен
Dialogue: 0,0:14:32.61,0:14:35.28,Default,,0,0,0,,Ол жақсы жігіт еді!
Dialogue: 0,0:14:35.28,0:14:38.95,Default,,0,0,0,,Бұл Кохеи Имамура.
Dialogue: 0,0:14:35.28,0:14:38.95,Default,,0,0,0,,-де не болды?
Dialogue: 0,0:14:38.95,0:14:42.45,Default,,0,0,0,,Тыңдаңыз! Чисаның жігіті, мен
Dialogue: 0,0:14:38.95,0:14:42.45,Default,,0,0,0,,Үйге апара алмаудан басқа➡︎
Dialogue: 0,0:14:42.45,0:14:44.95,Default,,0,0,0,,Ол тіпті киімін де шешпейді!
Dialogue: 0,0:14:42.45,0:14:44.95,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:14:44.95,0:14:49.12,Default,,0,0,0,,Тағы бір мүмкіндік беріңізші!
Dialogue: 0,0:14:44.95,0:14:49.12,Default,,0,0,0,,Сақтаушының мәжбүрлі әдепсіздігі➡︎
Dialogue: 0,0:14:49.12,0:14:52.46,Default,,0,0,0,,Тыңдауға орын жоқ!
Dialogue: 0,0:14:49.12,0:14:52.46,Default,,0,0,0,,Жағдайлар бар...
Dialogue: 0,0:14:52.46,0:14:56.90,Default,,0,0,0,,Сонда қандай жағдайлар бар?
Dialogue: 0,0:14:52.46,0:14:56.90,Default,,0,0,0,,Мен тергеу изоляторында сөйлесуім керек еді.
Dialogue: 0,0:14:56.90,0:14:59.90,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:14:56.90,0:14:59.90,Default,,0,0,0,,Күте тұрыңыз! Әңгіме жеткілікті
Dialogue: 0,0:14:59.90,0:15:02.07,Default,,0,0,0,,Оның орнына...
Dialogue: 0,0:15:02.07,0:15:04.41,Default,,0,0,0,,Киіміңді шеш!
Dialogue: 0,0:15:04.41,0:15:06.74,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:15:06.74,0:15:08.74,Default,,0,0,0,,(Дарионың жөтел ұстамасы)
Dialogue: 0,0:15:08.74,0:15:10.74,Default,,0,0,0,,Қайда бардың!
Dialogue: 0,0:15:10.74,0:15:12.75,Default,,0,0,0,,《Мына бейбақ...》
Dialogue: 0,0:15:12.75,0:15:14.75,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:15:14.75,0:15:16.92,Default,,0,0,0,,《Алайда
Dialogue: 0,0:15:14.75,0:15:16.92,Default,,0,0,0,,Мен киімімді бірдеңе істеуім керек...
Dialogue: 0,0:15:16.92,0:15:19.92,Default,,0,0,0,,Басқа таныстар туралы айтсақ...》
Dialogue: 0,0:15:23.26,0:15:27.76,Default,,0,0,0,,Дайвинг шеңбері Қараңызшы!
Dialogue: 0,0:15:27.76,0:15:32.60,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:15:27.76,0:15:32.60,Default,,0,0,0,,Уау... Бұл пайдалы.
Dialogue: 0,0:15:32.60,0:15:36.10,Default,,0,0,0,,Сонымен? Не?
Dialogue: 0,0:15:32.60,0:15:36.10,Default,,0,0,0,,Сен маған киіміңді бере аласың ба?
Dialogue: 0,0:15:36.10,0:15:38.77,Default,,0,0,0,,Біртүрлі сөздер айтатын ол.
Dialogue: 0,0:15:38.77,0:15:41.61,Default,,0,0,0,,Осыдан кейін ішуге барғыңыз келсе.
Dialogue: 0,0:15:38.77,0:15:41.61,Default,,0,0,0,,Бұл қос күш болар еді!
Dialogue: 0,0:15:41.61,0:15:46.11,Default,,0,0,0,,Мен ішімдік ішіп қана қоймай, киім киемін.
Dialogue: 0,0:15:41.61,0:15:46.11,Default,,0,0,0,,Киіміңді шешесің деп болжанбай ма?
Dialogue: 0,0:15:46.11,0:15:48.95,Default,,0,0,0,,Бүгін жаңа студенттерді қарсы алу кеші!
Dialogue: 0,0:15:48.95,0:15:51.95,Default,,0,0,0,,Бұл жақсы, бірақ
Dialogue: 0,0:15:48.95,0:15:51.95,Default,,0,0,0,,Әзірше мен киімімді реттеймін...
Dialogue: 0,0:15:51.95,0:15:57.06,Default,,0,0,0,,Олай болса, кем дегенде бір жаңа адам.
Dialogue: 0,0:15:51.95,0:15:57.06,Default,,0,0,0,,Мені тартып алсаң, мен саған киім-кешек беремін.
Dialogue: 0,0:15:57.06,0:15:59.73,Default,,0,0,0,,Мен міндім!
Dialogue: 0,0:15:57.06,0:15:59.73,Default,,0,0,0,,Айтпақшы, болжам бар ма?
Dialogue: 0,0:15:59.73,0:16:02.23,Default,,0,0,0,,Иә! Өтінемін, маған қалдырыңыз!
Dialogue: 0,0:16:09.90,0:16:12.24,Default,,0,0,0,,Қарғыс атсын! Неліктен?
Dialogue: 0,0:16:12.24,0:16:18.75,Default,,0,0,0,,Неліктен мен мектептің негізгі қызымын?
Dialogue: 0,0:16:12.24,0:16:18.75,Default,,0,0,0,,Сұлу қыз жоқ Гарем шеңбері!
Dialogue: 0,0:16:18.75,0:16:23.25,Default,,0,0,0,,Ха... сен...
Dialogue: 0,0:16:18.75,0:16:23.25,Default,,0,0,0,,Берілме, Кохеи
Dialogue: 0,0:16:23.25,0:16:25.59,Default,,0,0,0,,Армандар орындалады егер сен бас тартпасаң
Dialogue: 0,0:16:25.59,0:16:28.42,Default,,0,0,0,,Дүние қандай?
Dialogue: 0,0:16:25.59,0:16:28.42,Default,,0,0,0,,Бұл солай емес пе?
Dialogue: 0,0:16:28.42,0:16:31.76,Default,,0,0,0,,Бірақ шындық суық...
Dialogue: 0,0:16:31.76,0:16:35.26,Default,,0,0,0,,Арх! Бұл кім?
Dialogue: 0,0:16:31.76,0:16:35.26,Default,,0,0,0,,«Ұйықтама»➡︎
Dialogue: 0,0:16:35.26,0:16:39.77,Default,,0,0,0,,«Университетте жоғары сынып оқушылары бар ма?»
Dialogue: 0,0:16:35.26,0:16:39.77,Default,,0,0,0,,Мен түсінбейтін нәрселердің барлығы!
Dialogue: 0,0:16:39.77,0:16:42.44,Default,,0,0,0,,Университетке келгенде жаңа әлем ашылады➡︎
Dialogue: 0,0:16:42.44,0:16:45.61,Default,,0,0,0,,Армандай өмір күтіп тұр
Dialogue: 0,0:16:42.44,0:16:45.61,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,0:16:45.61,0:16:47.61,Default,,0,0,0,,Ариса
Dialogue: 0,0:16:45.61,0:16:47.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:47.61,0:16:49.61,Default,,0,0,0,,Жаңа әлем және арман өмір➡︎
Dialogue: 0,0:16:49.61,0:16:53.28,Default,,0,0,0,,Бірақ сіз кіре берістесіз
Dialogue: 0,0:16:49.61,0:16:53.28,Default,,0,0,0,,Сіз оны түсінбейсіз.
Dialogue: 0,0:16:53.28,0:16:55.88,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:55.88,0:16:59.89,Default,,0,0,0,,Сіз қалай ойлайсыз? Армандарымыздың кіре берісінде бірге
Dialogue: 0,0:16:55.88,0:16:59.89,Default,,0,0,0,,Неліктен оны қолданып көрмеске?
Dialogue: 0,0:16:59.89,0:17:02.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:05.56,0:17:09.40,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:17:05.56,0:17:09.40,Default,,0,0,0,,Біраз уақыт кетті! Сіз!
Dialogue: 0,0:17:09.40,0:17:13.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:09.40,0:17:13.57,Default,,0,0,0,,Киім – адамзат даналығының бірі.
Dialogue: 0,0:17:13.57,0:17:17.40,Default,,0,0,0,,Келіңіздер! Жаңа сәлемдесу кешін бастайық!
Dialogue: 0,0:17:13.57,0:17:17.40,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:17:17.40,0:17:20.91,Default,,0,0,0,,Иори! Сіз не ішесіз?
Dialogue: 0,0:17:17.40,0:17:20.91,Default,,0,0,0,,Маған улонг шайы керек, өтінемін.
Dialogue: 0,0:17:20.91,0:17:22.91,Default,,0,0,0,,Жарайды, түсіндім!
Dialogue: 0,0:17:26.25,0:17:28.75,Default,,0,0,0,,Хой-улонг шайы
Dialogue: 0,0:17:26.25,0:17:28.75,Default,,0,0,0,,Бұл менің білетінім➡︎
Dialogue: 0,0:17:28.75,0:17:32.25,Default,,0,0,0,,Бұл оолонг шайы емес!
Dialogue: 0,0:17:28.75,0:17:32.25,Default,,0,0,0,,Не айту керек
Dialogue: 0,0:17:32.25,0:17:36.59,Default,,0,0,0,,Ол оолонг шайының түсі болады.
Dialogue: 0,0:17:32.25,0:17:36.59,Default,,0,0,0,,Түсі ғана емес➡︎
Dialogue: 0,0:17:36.59,0:17:39.09,Default,,0,0,0,,Ол да от жағады!
Dialogue: 0,0:17:36.59,0:17:39.09,Default,,0,0,0,,Өрт орнында➡︎
Dialogue: 0,0:17:39.09,0:17:42.89,Default,,0,0,0,,Оның басым бөлігі алкоголь!
Dialogue: 0,0:17:39.09,0:17:42.89,Default,,0,0,0,,Су ше?
Dialogue: 0,0:17:48.10,0:17:51.77,Default,,0,0,0,,Ол қалай өртенеді?
Dialogue: 0,0:17:48.10,0:17:51.77,Default,,0,0,0,,Ол жанғыш, солай ма?
Dialogue: 0,0:17:51.77,0:17:54.94,Default,,0,0,0,,Түсіне алаңдамаңыз, себебі бұл су.
Dialogue: 0,0:17:51.77,0:17:54.94,Default,,0,0,0,,Сіз тек түссіз➡︎
Dialogue: 0,0:17:54.94,0:17:57.64,Default,,0,0,0,,Сусындарды ажырата алмайсыз ба?
Dialogue: 0,0:17:59.55,0:18:01.55,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:01.55,0:18:04.38,Default,,0,0,0,,«Кестеңізді кептіріңіз» деп жазыңыз…
Dialogue: 0,0:18:01.55,0:18:04.38,Default,,0,0,0,,«Қуаныш» деп айтылады!
Dialogue: 0,0:18:04.38,0:18:07.05,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:18:07.05,0:18:09.35,Default,,0,0,0,,♬~
Dialogue: 0,0:18:12.89,0:18:16.90,Default,,0,0,0,,Ах. Чиса, келдің бе?
Dialogue: 0,0:18:12.89,0:18:16.90,Default,,0,0,0,,Ах
Dialogue: 0,0:18:16.90,0:18:20.40,Default,,0,0,0,,Әкем баруымды өтінді.
Dialogue: 0,0:18:16.90,0:18:20.40,Default,,0,0,0,,Сіз бұл шеңберге кіресіз бе?
Dialogue: 0,0:18:20.40,0:18:24.57,Default,,0,0,0,,құлықсыз. Ал Иори ше?
Dialogue: 0,0:18:20.40,0:18:24.57,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:24.57,0:18:29.41,Default,,0,0,0,,Хм... Сіз қашып құтыла аласыз ба?
Dialogue: 0,0:18:24.57,0:18:29.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:29.41,0:18:32.41,Default,,0,0,0,,Сәлем! Ах!
Dialogue: 0,0:18:32.41,0:18:36.08,Default,,0,0,0,,Қараңызшы, Иори.
Dialogue: 0,0:18:32.41,0:18:36.08,Default,,0,0,0,,Тост жасамасаң жақсы емес!
Dialogue: 0,0:18:36.08,0:18:38.59,Default,,0,0,0,,Тоқта... Маған ұнамайды!
Dialogue: 0,0:18:38.59,0:18:40.59,Default,,0,0,0,,Баркер
Dialogue: 0,0:18:40.59,0:18:43.09,Default,,0,0,0,,«кесе кептір» деп жаз...
Dialogue: 0,0:18:40.59,0:18:43.09,Default,,0,0,0,,«Сәлеметсіз бе»!
Dialogue: 0,0:18:43.09,0:18:45.43,Default,,0,0,0,,Меніңше, Каэдэге де уақыт келген сияқты
Dialogue: 0,0:18:45.43,0:18:47.59,Default,,0,0,0,,Пуха~! Қараңғы...
Dialogue: 0,0:18:47.59,0:18:49.93,Default,,0,0,0,,Су ішпесең, құлайсың.
Dialogue: 0,0:18:49.93,0:18:52.13,Default,,0,0,0,,А, сәлем
Dialogue: 0,0:18:57.20,0:18:59.87,Default,,0,0,0,,Уокер!
Dialogue: 0,0:18:59.87,0:19:02.54,Default,,0,0,0,,Жақсы ішу, Иори Китахара
Dialogue: 0,0:19:02.54,0:19:05.71,Default,,0,0,0,,Кохеи!
Dialogue: 0,0:19:02.54,0:19:05.71,Default,,0,0,0,,Бұл кек алу әрекеті ме?
Dialogue: 0,0:19:05.71,0:19:08.55,Default,,0,0,0,,Бұл менің ниетім емес. Бірақ...
Dialogue: 0,0:19:08.55,0:19:12.55,Default,,0,0,0,,Мен оларды қосу үшін кем дегенде бір адамды өлтіруім керек.
Dialogue: 0,0:19:08.55,0:19:12.55,Default,,0,0,0,,Сіз қашып құтыла алмайтын сияқтысыз.
Dialogue: 0,0:19:12.55,0:19:16.89,Default,,0,0,0,,Мен түсінемін... әрине.
Dialogue: 0,0:19:12.55,0:19:16.89,Default,,0,0,0,,Біреу өзін құрбан етсе, жарайды.
Dialogue: 0,0:19:16.89,0:19:19.23,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:19:16.89,0:19:19.23,Default,,0,0,0,,О
Dialogue: 0,0:19:19.23,0:19:21.73,Default,,0,0,0,,Мен сені осында әкелуге жауаптымын.
Dialogue: 0,0:19:21.73,0:19:25.57,Default,,0,0,0,,Мен ішімдік ішетіндіктен, сен
Dialogue: 0,0:19:21.73,0:19:25.57,Default,,0,0,0,,Улонг шайын ішіңіз.
Dialogue: 0,0:19:25.57,0:19:29.87,Default,,0,0,0,,Хаха, қандай әдемі
Dialogue: 0,0:19:25.57,0:19:29.87,Default,,0,0,0,,Бұл жанқиярлық рух.
Dialogue: 0,0:19:35.74,0:19:38.25,Default,,0,0,0,,Құрметті сіз!
Dialogue: 0,0:19:35.74,0:19:38.25,Default,,0,0,0,,Ерекше құрбандықтар бар ➡︎
Dialogue: 0,0:19:38.25,0:19:42.58,Default,,0,0,0,,Бұл мен болуым міндетті емес!
Dialogue: 0,0:19:38.25,0:19:42.58,Default,,0,0,0,,Бұл…
Dialogue: 0,0:19:42.58,0:19:45.09,Default,,0,0,0,,Жүр, біз төбелесе алмаймыз!
Dialogue: 0,0:19:45.09,0:19:47.25,Default,,0,0,0,,Егер сізде шынымен қиындық болса
Dialogue: 0,0:19:45.09,0:19:47.25,Default,,0,0,0,,Оны ойынға айналдырыңыз!
Dialogue: 0,0:19:47.25,0:19:49.76,Default,,0,0,0,,Жарыс?
Dialogue: 0,0:19:47.25,0:19:49.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:49.76,0:19:53.43,Default,,0,0,0,,Бұл ұрпақтан ұрпаққа жалғасып келе жатқан PaB стиліндегі байқау!
Dialogue: 0,0:19:49.76,0:19:53.43,Default,,0,0,0,,Ережелер қарапайым!
Dialogue: 0,0:19:53.43,0:19:56.76,Default,,0,0,0,,Алкогольді аузыңа шашсаң, ұтыласың.
Dialogue: 0,0:19:53.43,0:19:56.76,Default,,0,0,0,,Міне!
Dialogue: 0,0:19:56.76,0:19:59.10,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:19:56.76,0:19:59.10,Default,,0,0,0,,Иә
Dialogue: 0,0:19:59.10,0:20:03.90,Default,,0,0,0,,Бір-бірімізге қарап тұрайық
Dialogue: 0,0:19:59.10,0:20:03.90,Default,,0,0,0,,Қараңызшы!
Dialogue: 0,0:20:06.77,0:20:10.61,Default,,0,0,0,,Ээхихихи...
Dialogue: 0,0:20:10.61,0:20:12.61,Default,,0,0,0,,Эххихихи…
Dialogue: 0,0:20:10.61,0:20:12.61,Default,,0,0,0,,Кохеи!
Dialogue: 0,0:20:12.61,0:20:15.12,Default,,0,0,0,,Салмақты әңгімелесуге тырысыңыз
Dialogue: 0,0:20:12.61,0:20:15.12,Default,,0,0,0,,Бұл бір нұсқа.
Dialogue: 0,0:20:15.12,0:20:17.12,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:20:15.12,0:20:17.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:17.12,0:20:19.12,Default,,0,0,0,,Күлмеу керек жағдайларда➡︎
Dialogue: 0,0:20:19.12,0:20:21.46,Default,,0,0,0,,Таңқаларлық
Dialogue: 0,0:20:19.12,0:20:21.46,Default,,0,0,0,,Мұндай әңгіме мені күлдіреді.
Dialogue: 0,0:20:21.46,0:20:26.13,Default,,0,0,0,,Мен... сонда көремін
Dialogue: 0,0:20:21.46,0:20:26.13,Default,,0,0,0,,Мен де өз уайымымды айтамын.
Dialogue: 0,0:20:26.13,0:20:29.96,Default,,0,0,0,,Бұл жай ғана әңгіме, бірақ шын мәнінде бұл мен➡︎
Dialogue: 0,0:20:29.96,0:20:32.80,Default,,0,0,0,,Өзім осылай болсам да, мен отаку едім.
Dialogue: 0,0:20:32.80,0:20:36.97,Default,,0,0,0,,Ою!
Dialogue: 0,0:20:32.80,0:20:36.97,Default,,0,0,0,,Таң қалғаныңызды жасыра алмаған сияқтысыз.
Dialogue: 0,0:20:36.97,0:20:40.31,Default,,0,0,0,,Нені жасыруға болмайды
Dialogue: 0,0:20:36.97,0:20:40.31,Default,,0,0,0,,Сіз отакусыз!
Dialogue: 0,0:20:40.31,0:20:43.14,Default,,0,0,0,,Иори, сен дөрекі көрінесің.
Dialogue: 0,0:20:40.31,0:20:43.14,Default,,0,0,0,,А...
Dialogue: 0,0:20:50.89,0:20:55.23,Default,,0,0,0,,Уг!?
Dialogue: 0,0:20:50.89,0:20:55.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:55.23,0:20:59.57,Default,,0,0,0,,Бір-бірімізге қадала қарайық
Dialogue: 0,0:20:55.23,0:20:59.57,Default,,0,0,0,,Қараңызшы!
Dialogue: 0,0:20:59.57,0:21:03.01,Default,,0,0,0,,Иори
Dialogue: 0,0:20:59.57,0:21:03.01,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,0:21:03.01,0:21:05.17,Default,,0,0,0,,Мен баскетбол ойнағым келеді...
Dialogue: 0,0:21:05.17,0:21:08.01,Default,,0,0,0,,Боу! Гохо!
Dialogue: 0,0:21:05.17,0:21:08.01,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:21:08.01,0:21:11.01,Default,,0,0,0,,Сіз де ішуіңіз керек! иә?
Dialogue: 0,0:21:11.01,0:21:14.31,Default,,0,0,0,,Сіз тағы да дөрекі көрінесіз, Иори.
Dialogue: 0,0:21:17.19,0:21:20.52,Default,,0,0,0,,Бұх! Сіз жасайсыз ба?
Dialogue: 0,0:21:17.19,0:21:20.52,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:21:20.52,0:21:22.69,Default,,0,0,0,,Егер бұл орын алса
Dialogue: 0,0:21:20.52,0:21:22.69,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:21:22.69,0:21:25.86,Default,,0,0,0,,Жоғары! Мен оны ақ-қара түсте түсіндіремін!
Dialogue: 0,0:21:25.86,0:21:32.37,Default,,0,0,0,,Бір-бірімізге қадалып алайық
Dialogue: 0,0:21:25.86,0:21:32.37,Default,,0,0,0,,Қараңызшы!
Dialogue: 0,0:21:32.37,0:21:35.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:32.37,0:21:35.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:35.70,0:21:39.21,Default,,0,0,0,,Дәл солай, балалар... Қараңдаршы.
Dialogue: 0,0:21:39.21,0:21:41.71,Default,,0,0,0,,Ми… су…
Dialogue: 0,0:21:39.21,0:21:41.71,Default,,0,0,0,,Көмегіңе рахмет...
Dialogue: 0,0:21:41.71,0:21:44.11,Default,,0,0,0,,Дегенмен, бұл таң қалдырды.
Dialogue: 0,0:21:46.38,0:21:48.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:48.38,0:21:51.08,Default,,0,0,0,,Балалар
Dialogue: 0,0:21:48.38,0:21:51.08,Default,,0,0,0,,Мен сенің сонша ішкің келетінін білмедім.
Dialogue: 0,0:21:53.39,0:21:56.89,Default,,0,0,0,,Сол үшін
Dialogue: 0,0:21:53.39,0:21:56.89,Default,,0,0,0,,Балалар, сендер де көңілдерінен шығасыңдар!
Dialogue: 0,0:21:58.89,0:22:02.19,Default,,0,0,0,,Бұл су емес!
Dialogue: 0,0:22:07.17,0:22:10.84,Default,,0,0,0,,Иори-кун достарымен
Dialogue: 0,0:22:07.17,0:22:10.84,Default,,0,0,0,,Ол шеңберге қосылатын сияқты.
Dialogue: 0,0:22:10.84,0:22:13.51,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:22:10.84,0:22:13.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:13.51,0:22:16.18,Default,,0,0,0,,Бірақ екі күн қатарынан далада болу...
Dialogue: 0,0:22:16.18,0:22:18.58,Default,,0,0,0,,Сау болу керек
Dialogue: 0,0:22:23.52,0:22:25.69,Default,,0,0,0,,Бұл менің кінәм...
Dialogue: 0,0:22:25.69,0:22:28.59,Default,,0,0,0,,Жоқ... сен кінәлісің...
Dialogue: 0,0:22:30.69,0:22:34.09,Default,,0,0,0,,Күрсін... Әлгі ақымақ шынымен...
Dialogue: 0,0:22:35.59,0:22:41.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
