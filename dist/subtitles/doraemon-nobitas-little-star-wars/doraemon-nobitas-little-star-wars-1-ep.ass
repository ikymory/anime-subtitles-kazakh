Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.14,0:00:20.15,Default,,0000,0000,0000,,Кейкокуон
Dialogue: 0,0:00:11.14,0:00:20.15,Default,,0000,0000,0000,,(ескерту дыбысы)
Dialogue: 0,0:00:20.15,0:00:22.16,Default,,0000,0000,0000,,Бакухатсуон
Dialogue: 0,0:00:20.15,0:00:22.16,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:00:20.15,0:00:22.16,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:00:22.16,0:00:31.13,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:00:31.13,0:00:33.13,Default,,0000,0000,0000,,Мұның бәрі осы ма?
Dialogue: 0,0:00:33.13,0:00:35.14,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:00:33.13,0:00:35.14,Default,,0000,0000,0000,,Ұрланған
Dialogue: 0,0:00:33.13,0:00:35.14,Default,,0000,0000,0000,,Енді қашу зымыранына асығыңыз.
Dialogue: 0,0:00:35.14,0:00:37.17,Default,,0000,0000,0000,,Дайжин
Dialogue: 0,0:00:35.14,0:00:37.17,Default,,0000,0000,0000,,Министрге бұл дұрыс па? ?
Dialogue: 0,0:00:37.17,0:00:40.14,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:00:37.17,0:00:40.14,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:00:37.17,0:00:40.14,Default,,0000,0000,0000,,Біз жалғыз қашып кеткенімізге сене алмаймыз...
Dialogue: 0,0:00:40.14,0:00:44.14,Default,,0000,0000,0000,,Мина
Dialogue: 0,0:00:40.14,0:00:44.14,Default,,0000,0000,0000,,Қалай болғанда да, біз тез арада ауруханаға жетуіміз керек…
Dialogue: 0,0:00:40.14,0:00:44.14,Default,,0000,0000,0000,,Қорытынды
Dialogue: 0,0:00:40.14,0:00:44.14,Default,,0000,0000,0000,,Ұрыс
Dialogue: 0,0:00:40.14,0:00:44.14,Default,,0000,0000,0000,,Барлығымен бірге мен де соңына дейін күресемін!
Dialogue: 0,0:00:45.15,0:00:47.18,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:00:47.18,0:00:51.15,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:00:47.18,0:00:51.15,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:00:47.18,0:00:51.15,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:00:47.18,0:00:51.15,Default,,0000,0000,0000,,Егер қазір аман қалмасаң
Dialogue: 0,0:00:47.18,0:00:51.15,Default,,0000,0000,0000,,Матсуда мырза өледі.
Dialogue: 0,0:00:47.18,0:00:51.15,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:00:47.18,0:00:51.15,Default,,0000,0000,0000,,Хоши
Dialogue: 0,0:00:47.18,0:00:51.15,Default,,0000,0000,0000,,Бұл планетаның иесі кім...!
Dialogue: 0,0:00:51.15,0:00:53.12,Default,,0000,0000,0000,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:00:51.15,0:00:53.12,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:00:57.12,0:01:00.13,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:00:57.12,0:01:00.13,Default,,0000,0000,0000,,Ха! Бұл... мен білмей тұрып! ?
Dialogue: 0,0:01:00.13,0:01:03.13,Default,,0000,0000,0000,,«Онда
Dialogue: 0,0:01:00.13,0:01:03.13,Default,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:01:00.13,0:01:03.13,Default,,0000,0000,0000,,Қашуға арналған зымыранның ішінде».
Dialogue: 0,0:01:03.13,0:01:05.20,Default,,0000,0000,0000,,Хосакан
Dialogue: 0,0:01:03.13,0:01:05.20,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:01:03.13,0:01:05.20,Default,,0000,0000,0000,,Көмекші! Сен не істеп жатырсың! ?
Dialogue: 0,0:01:05.20,0:01:07.20,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:01:05.20,0:01:07.20,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:01:05.20,0:01:07.20,Default,,0000,0000,0000,,«Біз іске қосылғалы жатырмыз».
Dialogue: 0,0:01:08.13,0:01:10.14,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:01:10.14,0:01:16.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:16.11,0:01:19.11,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:01:16.11,0:01:19.11,Default,,0000,0000,0000,,"Жарайды. Сенің қолыңнан келеді".
Dialogue: 0,0:01:19.11,0:01:23.22,Default,,0000,0000,0000,,О.
Dialogue: 0,0:01:19.11,0:01:23.22,Default,,0000,0000,0000,,Жоқ! Мен оны артта қалдырғаныма сене алар емеспін
Dialogue: 0,0:01:19.11,0:01:23.22,Default,,0000,0000,0000,,Мен алмаймын. Пиина!
Dialogue: 0,0:01:23.22,0:01:27.12,Default,,0000,0000,0000,,«Бір күні мен сенімдімін
Dialogue: 0,0:01:23.22,0:01:27.12,Default,,0000,0000,0000,,Қақпақ
Dialogue: 0,0:01:23.22,0:01:27.12,Default,,0000,0000,0000,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,0:01:23.22,0:01:27.12,Default,,0000,0000,0000,,Бұл планетада қайтадан бостандық...»
Dialogue: 0,0:01:27.12,0:01:30.12,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:01:27.12,0:01:30.12,Default,,0000,0000,0000,,Пиина... Пиина-неесан!
Dialogue: 0,0:01:31.12,0:01:35.13,Default,,0000,0000,0000,,Әпке! !
Dialogue: 0,0:01:35.13,0:01:46.14,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:50.14,0:01:53.18,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:01:50.14,0:01:53.18,Default,,0000,0000,0000,,(Нобита)
Dialogue: 0,0:01:50.14,0:01:53.18,Default,,0000,0000,0000,,Кімге... Кімге... Хекшун!
Dialogue: 0,0:01:53.18,0:01:55.11,Default,,0000,0000,0000,,Уау, шамдар!
Dialogue: 0,0:01:55.11,0:01:58.15,Default,,0000,0000,0000,,Идиот!
Dialogue: 0,0:01:55.11,0:01:58.15,Default,,0000,0000,0000,,Не істеп жатырсың, Нобита?
Dialogue: 0,0:01:58.15,0:02:01.15,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:01:58.15,0:02:01.15,Default,,0000,0000,0000,,О.
Dialogue: 0,0:01:58.15,0:02:01.15,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:01:58.15,0:02:01.15,Default,,0000,0000,0000,,О, бұны баспа!
Dialogue: 0,0:02:01.15,0:02:03.12,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:02:01.15,0:02:03.12,Default,,0000,0000,0000,,Уау, туттттттттттттттттттттттт...
Dialogue: 0,0:02:03.12,0:02:05.13,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:02:03.12,0:02:05.13,Default,,0000,0000,0000,,Кесу! кес!
Dialogue: 0,0:02:05.13,0:02:08.13,Default,,0000,0000,0000,,Сацуэй
Dialogue: 0,0:02:05.13,0:02:08.13,Default,,0000,0000,0000,,Түсірілім сәтсіз.
Dialogue: 0,0:02:05.13,0:02:08.13,Default,,0000,0000,0000,,Мүлдем!
Dialogue: 0,0:02:08.13,0:02:11.13,Default,,0000,0000,0000,,Тым көп
Dialogue: 0,0:02:08.13,0:02:11.13,Default,,0000,0000,0000,,Ноби
Dialogue: 0,0:02:08.13,0:02:11.13,Default,,0000,0000,0000,,Амансың ба? Ноби-кун.
Dialogue: 0,0:02:08.13,0:02:11.13,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:02:11.13,0:02:13.13,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:02:11.13,0:02:13.13,Default,,0000,0000,0000,,Фонға
Dialogue: 0,0:02:11.13,0:02:13.13,Default,,0000,0000,0000,,Дина
Dialogue: 0,0:02:11.13,0:02:13.13,Default,,0000,0000,0000,,Бұзыңыз!
Dialogue: 0,0:02:13.13,0:02:15.13,Default,,0000,0000,0000,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:02:15.13,0:02:18.10,Default,,0000,0000,0000,,Джунби
Dialogue: 0,0:02:15.13,0:02:18.10,Default,,0000,0000,0000,,Қанша дайындау керек
Dialogue: 0,0:02:15.13,0:02:18.10,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:02:15.13,0:02:18.10,Default,,0000,0000,0000,,Мен қажет деп ойладым!
Dialogue: 0,0:02:18.10,0:02:20.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:20.11,0:02:23.14,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:02:20.11,0:02:23.14,Default,,0000,0000,0000,,Сунео Джан.
Dialogue: 0,0:02:23.14,0:02:25.15,Default,,0000,0000,0000,,Декисуги-кун да.
Dialogue: 0,0:02:25.15,0:02:28.11,Default,,0000,0000,0000,,Сіз тағы бірдеңе жасадыңыз.
Dialogue: 0,0:02:25.15,0:02:28.11,Default,,0000,0000,0000,,Нобита-кун.
Dialogue: 0,0:02:29.12,0:02:31.15,Default,,0000,0000,0000,,Орындау… Орындау…→
Dialogue: 0,0:02:31.15,0:02:33.12,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,0:02:33.12,0:02:48.13,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:48.13,0:02:56.14,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:56.14,0:03:26.14,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:26.14,0:03:56.14,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:56.14,0:04:04.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:06.18,0:04:08.15,Default,,0000,0000,0000,,Doraemon күткендей!
Dialogue: 0,0:04:08.15,0:04:10.15,Default,,0000,0000,0000,,Хромакей жиынтығының арқасында→
Dialogue: 0,0:04:10.15,0:04:12.15,Default,,0000,0000,0000,,Алғашқы көрініс
Dialogue: 0,0:04:10.15,0:04:12.15,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:04:12.15,0:04:15.15,Default,,0000,0000,0000,,Госей
Dialogue: 0,0:04:12.15,0:04:15.15,Default,,0000,0000,0000,,Токусацу
Dialogue: 0,0:04:12.15,0:04:15.15,Default,,0000,0000,0000,,Канаме
Dialogue: 0,0:04:12.15,0:04:15.15,Default,,0000,0000,0000,,Композиция – арнайы әсерлердің кілті.
Dialogue: 0,0:04:15.15,0:04:17.12,Default,,0000,0000,0000,,Риппа
Dialogue: 0,0:04:15.15,0:04:17.12,Default,,0000,0000,0000,,Дегенмен, бұл тамаша жиынтық.
Dialogue: 0,0:04:17.12,0:04:20.13,Default,,0000,0000,0000,,(Сунео)
Dialogue: 0,0:04:17.12,0:04:20.13,Default,,0000,0000,0000,,Тауық еті
Dialogue: 0,0:04:17.12,0:04:20.13,Default,,0000,0000,0000,,Хиро
Dialogue: 0,0:04:17.12,0:04:20.13,Default,,0000,0000,0000,,Бәлкім, менің бақшам үлкен болғандықтан шығар!
Dialogue: 0,0:04:20.13,0:04:24.13,Default,,0000,0000,0000,,Келесі
Dialogue: 0,0:04:20.13,0:04:24.13,Default,,0000,0000,0000,,Олай болса, келесі көрініс үшін.
Dialogue: 0,0:04:20.13,0:04:24.13,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:04:20.13,0:04:24.13,Default,,0000,0000,0000,,Жаттығуды бастайық!
Dialogue: 0,0:04:24.13,0:04:26.13,Default,,0000,0000,0000,,Яквари
Dialogue: 0,0:04:24.13,0:04:26.13,Default,,0000,0000,0000,,Әй, менің рөлім қандай?
Dialogue: 0,0:04:26.13,0:04:28.13,Default,,0000,0000,0000,,Нобита сол жерде.
Dialogue: 0,0:04:29.14,0:04:31.10,Default,,0000,0000,0000,,Не деген сұмдық!
Dialogue: 0,0:04:31.10,0:04:35.14,Default,,0000,0000,0000,,Пішін
Dialogue: 0,0:04:31.10,0:04:35.14,Default,,0000,0000,0000,,Қоқысты дұрыс тазалай алсаңыз
Dialogue: 0,0:04:31.10,0:04:35.14,Default,,0000,0000,0000,,Суару
Dialogue: 0,0:04:31.10,0:04:35.14,Default,,0000,0000,0000,,Мен бұл туралы ойланамын.
Dialogue: 0,0:04:35.14,0:04:37.14,Default,,0000,0000,0000,,О.
Dialogue: 0,0:04:35.14,0:04:37.14,Default,,0000,0000,0000,,Тезірек бітірейік...
Dialogue: 0,0:04:37.14,0:04:40.21,Default,,0000,0000,0000,,Не... Уау!
Dialogue: 0,0:04:37.14,0:04:40.21,Default,,0000,0000,0000,,Тотттттттттттттттттттттттттт!
Dialogue: 0,0:04:40.21,0:04:43.12,Default,,0000,0000,0000,,Итте... Мен мұны қайтадан жасадым.
Dialogue: 0,0:04:43.12,0:04:46.12,Default,,0000,0000,0000,,Иә? Бұл не?
Dialogue: 0,0:04:47.12,0:04:51.12,Default,,0000,0000,0000,,Хонбан
Dialogue: 0,0:04:47.12,0:04:51.12,Default,,0000,0000,0000,,Нақты орындау уақыты келді!
Dialogue: 0,0:04:47.12,0:04:51.12,Default,,0000,0000,0000,,Шомей
Dialogue: 0,0:04:47.12,0:04:51.12,Default,,0000,0000,0000,,Жарықтандыру туралы не айтасыз?
Dialogue: 0,0:04:51.12,0:04:53.13,Default,,0000,0000,0000,,Дайындық жарайды!
Dialogue: 0,0:04:51.12,0:04:53.13,Default,,0000,0000,0000,,Бұл да жақсы!
Dialogue: 0,0:04:53.13,0:04:57.13,Default,,0000,0000,0000,,Хаккасочи
Dialogue: 0,0:04:53.13,0:04:57.13,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:04:53.13,0:04:57.13,Default,,0000,0000,0000,,Тұтанғыш құрылғыда ақау жоқ.
Dialogue: 0,0:04:53.13,0:04:57.13,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:04:57.13,0:05:01.13,Default,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:04:57.13,0:05:01.13,Default,,0000,0000,0000,,Олай болса, бекіністі бомбалау сахнасы.
Dialogue: 0,0:04:57.13,0:05:01.13,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:04:57.13,0:05:01.13,Default,,0000,0000,0000,,Дайындық….
Dialogue: 0,0:05:01.13,0:05:03.14,Default,,0000,0000,0000,,Сәлем бәріңе!
Dialogue: 0,0:05:04.14,0:05:07.14,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:05:04.14,0:05:07.14,Default,,0000,0000,0000,,CERN-ге қарсы шыққан террорист.
Dialogue: 0,0:05:04.14,0:05:07.14,Default,,0000,0000,0000,,Мен таңғажайып нәрсе таптым.
Dialogue: 0,0:05:07.14,0:05:10.11,Default,,0000,0000,0000,,Қараңыз! бұл ракета
Dialogue: 0,0:05:07.14,0:05:10.11,Default,,0000,0000,0000,,Жарайсың...
Dialogue: 0,0:05:10.11,0:05:14.15,Default,,0000,0000,0000,,Иә Нобита! Неге сен
Dialogue: 0,0:05:10.11,0:05:14.15,Default,,0000,0000,0000,,Кедергі
Dialogue: 0,0:05:10.11,0:05:14.15,Default,,0000,0000,0000,,Сіз жолға түсе бересіз!
Dialogue: 0,0:05:14.15,0:05:18.12,Default,,0000,0000,0000,,Tetsuda
Dialogue: 0,0:05:14.15,0:05:18.12,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:14.15,0:05:18.12,Default,,0000,0000,0000,,Дораемон көмектесемін дейді.
Dialogue: 0,0:05:14.15,0:05:18.12,Default,,0000,0000,0000,,Мен сізге рұқсат етемін!
Dialogue: 0,0:05:18.12,0:05:21.12,Default,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:05:18.12,0:05:21.12,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:05:18.12,0:05:21.12,Default,,0000,0000,0000,,Менің фильмімді бұзғың келсе
Dialogue: 0,0:05:18.12,0:05:21.12,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:05:18.12,0:05:21.12,Default,,0000,0000,0000,,Қазір оралыңыз!
Dialogue: 0,0:05:28.13,0:05:30.13,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:05:30.13,0:05:32.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:35.13,0:05:37.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:39.14,0:05:41.11,Default,,0000,0000,0000,,Не? Апыр-ай...!
Dialogue: 0,0:05:42.11,0:05:44.11,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:05:48.15,0:05:53.12,Default,,0000,0000,0000,,На
Dialogue: 0,0:05:48.15,0:05:53.12,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:05:48.15,0:05:53.12,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:05:56.12,0:05:59.13,Default,,0000,0000,0000,,Кару
Dialogue: 0,0:05:56.12,0:05:59.13,Default,,0000,0000,0000,,Кинзокусей
Dialogue: 0,0:05:56.12,0:05:59.13,Default,,0000,0000,0000,,Бұл жеңіл, бірақ металдан жасалған.
Dialogue: 0,0:05:59.13,0:06:02.13,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:59.13,0:06:02.13,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:05:59.13,0:06:02.13,Default,,0000,0000,0000,,Саптама күйіп кеткендей болады.
Dialogue: 0,0:05:59.13,0:06:02.13,Default,,0000,0000,0000,,Нақты нәрсе
Dialogue: 0,0:05:59.13,0:06:02.13,Default,,0000,0000,0000,,Нақты нәрсе сияқты….
Dialogue: 0,0:06:02.13,0:06:05.13,Default,,0000,0000,0000,,Бір рет
Dialogue: 0,0:06:02.13,0:06:05.13,Default,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:06:02.13,0:06:05.13,Default,,0000,0000,0000,,Дәл қазір ол өздігінен қозғалды.
Dialogue: 0,0:06:02.13,0:06:05.13,Default,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:06:05.13,0:06:08.13,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:05.13,0:06:08.13,Default,,0000,0000,0000,,Ішінде бірдеңе бар ма?
Dialogue: 0,0:06:08.13,0:06:10.14,Default,,0000,0000,0000,,Қайсысы? Иә...
Dialogue: 0,0:06:11.20,0:06:13.11,Default,,0000,0000,0000,,⚞Тоқтаңыз!
Dialogue: 0,0:06:13.11,0:06:15.21,Default,,0000,0000,0000,,Уау! Ха! ?
Dialogue: 0,0:06:15.21,0:06:17.21,Default,,0000,0000,0000,,Зымыран сөйледі!
Dialogue: 0,0:06:17.21,0:06:19.15,Default,,0000,0000,0000,,⚞Бұдан былай
Dialogue: 0,0:06:17.21,0:06:19.15,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:06:17.21,0:06:19.15,Default,,0000,0000,0000,,Мен кетемін→
Dialogue: 0,0:06:19.15,0:06:22.12,Default,,0000,0000,0000,,Ранбу
Dialogue: 0,0:06:19.15,0:06:22.12,Default,,0000,0000,0000,,Зорлық-зомбылық жасамаңыз.
Dialogue: 0,0:06:31.12,0:06:38.13,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:38.13,0:06:40.13,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,0:06:38.13,0:06:40.13,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:06:44.24,0:06:47.14,Default,,0000,0000,0000,,Танысқаныма қуаныштымын. Менің атым Папи.
Dialogue: 0,0:06:47.14,0:06:49.14,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:06:47.14,0:06:49.14,Default,,0000,0000,0000,,Адам?
Dialogue: 0,0:06:49.14,0:06:51.14,Default,,0000,0000,0000,,Гном
Dialogue: 0,0:06:49.14,0:06:51.14,Default,,0000,0000,0000,,Мына ергежейлі сияқты...
Dialogue: 0,0:06:51.14,0:06:54.11,Default,,0000,0000,0000,,Осы жерден қараңыз
Dialogue: 0,0:06:51.14,0:06:54.11,Default,,0000,0000,0000,,Киодзин
Dialogue: 0,0:06:51.14,0:06:54.11,Default,,0000,0000,0000,,Балалар сендер алыпсыңдар.
Dialogue: 0,0:06:56.15,0:06:58.15,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:58.15,0:07:02.19,Default,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:06:58.15,0:07:02.19,Default,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:06:58.15,0:07:02.19,Default,,0000,0000,0000,,Пирика деген алыстағы жұлдыздан
Dialogue: 0,0:06:58.15,0:07:02.19,Default,,0000,0000,0000,,Enro
Dialogue: 0,0:06:58.15,0:07:02.19,Default,,0000,0000,0000,,Барлығы ...
Dialogue: 0,0:07:02.19,0:07:05.16,Default,,0000,0000,0000,,Учуужин
Dialogue: 0,0:07:02.19,0:07:05.16,Default,,0000,0000,0000,,Сонымен, Папи бөтен планеталық па?
Dialogue: 0,0:07:05.16,0:07:07.13,Default,,0000,0000,0000,,Сіздің көзқарасыңыз бойынша
Dialogue: 0,0:07:05.16,0:07:07.13,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:07.13,0:07:10.13,Default,,0000,0000,0000,,Сөздер
Dialogue: 0,0:07:07.13,0:07:10.13,Default,,0000,0000,0000,,Цуу
Dialogue: 0,0:07:07.13,0:07:10.13,Default,,0000,0000,0000,,Бірақ біз әрқашан сөйлесе білдік.
Dialogue: 0,0:07:10.13,0:07:12.13,Default,,0000,0000,0000,,Хоньяку
Dialogue: 0,0:07:10.13,0:07:12.13,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:07:10.13,0:07:12.13,Default,,0000,0000,0000,,Аударма желеін қолдану арқасында.
Dialogue: 0,0:07:12.13,0:07:16.14,Default,,0000,0000,0000,,Аударма желе!
Dialogue: 0,0:07:12.13,0:07:16.14,Default,,0000,0000,0000,,Құралдар
Dialogue: 0,0:07:12.13,0:07:16.14,Default,,0000,0000,0000,,Бұл Doraemon құралы сияқты.
Dialogue: 0,0:07:16.14,0:07:21.11,Default,,0000,0000,0000,,Сонымен... бұл жұлдыз
Dialogue: 0,0:07:16.14,0:07:21.11,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:07:16.14,0:07:21.11,Default,,0000,0000,0000,,Аты кім?
Dialogue: 0,0:07:22.11,0:07:25.11,Default,,0000,0000,0000,,Чикюу
Dialogue: 0,0:07:22.11,0:07:25.11,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:07:22.11,0:07:25.11,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:07:22.11,0:07:25.11,Default,,0000,0000,0000,,Бұл Жер. Білмей келдің бе?
Dialogue: 0,0:07:25.11,0:07:27.15,Default,,0000,0000,0000,,Иә. Осы зымыранмен →
Dialogue: 0,0:07:27.15,0:07:29.15,Default,,0000,0000,0000,,Осының бәрі...
Dialogue: 0,0:07:29.15,0:07:32.15,Default,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:07:29.15,0:07:32.15,Default,,0000,0000,0000,,Бір нәрсе сынған сияқты.
Dialogue: 0,0:07:32.15,0:07:35.12,Default,,0000,0000,0000,,Фудзичаку
Dialogue: 0,0:07:32.15,0:07:35.12,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:07:32.15,0:07:35.12,Default,,0000,0000,0000,,Қону кезіндегі соққы
Dialogue: 0,0:07:32.15,0:07:35.12,Default,,0000,0000,0000,,Генин
Dialogue: 0,0:07:32.15,0:07:35.12,Default,,0000,0000,0000,,Бұл себеп болуы мүмкін.
Dialogue: 0,0:07:35.12,0:07:37.16,Default,,0000,0000,0000,,Ескертпе
Dialogue: 0,0:07:35.12,0:07:37.16,Default,,0000,0000,0000,,Олай болса, түзетейік!
Dialogue: 0,0:07:37.16,0:07:39.13,Default,,0000,0000,0000,,Жоқ! Бұл дұрыс емес...
Dialogue: 0,0:07:39.13,0:07:42.09,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:07:39.13,0:07:42.09,Default,,0000,0000,0000,,Doraemon осылай көрінсе де→
Dialogue: 0,0:07:42.09,0:07:45.13,Default,,0000,0000,0000,,Болашақ
Dialogue: 0,0:07:42.09,0:07:45.13,Default,,0000,0000,0000,,Мен болашақтан келдім
Dialogue: 0,0:07:42.09,0:07:45.13,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:42.09,0:07:45.13,Default,,0000,0000,0000,,Бұл мысық тәрізді робот.
Dialogue: 0,0:07:45.13,0:07:48.20,Default,,0000,0000,0000,,Бенри
Dialogue: 0,0:07:45.13,0:07:48.20,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:07:45.13,0:07:48.20,Default,,0000,0000,0000,,Менде көптеген пайдалы құралдар бар.
Dialogue: 0,0:07:45.13,0:07:48.20,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:07:48.20,0:07:51.14,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:07:48.20,0:07:51.14,Default,,0000,0000,0000,,Бір нәрсені пайдалана аламыз ба, көрейік.
Dialogue: 0,0:07:51.14,0:07:55.11,Default,,0000,0000,0000,,Қияр
Dialogue: 0,0:07:51.14,0:07:55.11,Default,,0000,0000,0000,,Жөндеу жұмыстары аяқталғанша
Dialogue: 0,0:07:51.14,0:07:55.11,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:07:51.14,0:07:55.11,Default,,0000,0000,0000,,Осы жерде қалуыңызға болады.
Dialogue: 0,0:07:56.14,0:08:00.21,Default,,0000,0000,0000,,Себеп
Dialogue: 0,0:07:56.14,0:08:00.21,Default,,0000,0000,0000,,Дайхёу
Dialogue: 0,0:07:56.14,0:08:00.21,Default,,0000,0000,0000,,Пирика планетасы атынан
Dialogue: 0,0:07:56.14,0:08:00.21,Default,,0000,0000,0000,,Үрлемелі
Dialogue: 0,0:07:56.14,0:08:00.21,Default,,0000,0000,0000,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,0:07:56.14,0:08:00.21,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:56.14,0:08:00.21,Default,,0000,0000,0000,,Сен сол 13 жылды жалғыз өзің күтесің, иә!
Dialogue: 0,0:07:56.14,0:08:00.21,Default,,0000,0000,0000,,Мен шексіз алғысымды білдіргім келеді.
Dialogue: 0,0:08:00.21,0:08:03.12,Default,,0000,0000,0000,,Катагата
Dialogue: 0,0:08:00.21,0:08:03.12,Default,,0000,0000,0000,,Рахмет, Чикю халқы.
Dialogue: 0,0:08:03.12,0:08:05.12,Default,,0000,0000,0000,,А, мен әлі атын білмедім.
Dialogue: 0,0:08:05.12,0:08:08.22,Default,,0000,0000,0000,,Мен Нобитамын.
Dialogue: 0,0:08:05.12,0:08:08.22,Default,,0000,0000,0000,,Мен Дораемонмын.
Dialogue: 0,0:08:08.22,0:08:11.19,Default,,0000,0000,0000,,⚞Ноби-чан Дора-чан
Dialogue: 0,0:08:08.22,0:08:11.19,Default,,0000,0000,0000,,Хань
Dialogue: 0,0:08:08.22,0:08:11.19,Default,,0000,0000,0000,,Тамақ!
Dialogue: 0,0:08:11.19,0:08:13.19,Default,,0000,0000,0000,,⚞ (Дораэмон/Нобита) Иә!
Dialogue: 0,0:08:17.13,0:08:19.13,Default,,0000,0000,0000,,Танысқаныма қуаныштымын. Бұл Папи.
Dialogue: 0,0:08:19.13,0:08:22.13,Default,,0000,0000,0000,,Бұл Шизука.
Dialogue: 0,0:08:19.13,0:08:22.13,Default,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:08:19.13,0:08:22.13,Default,,0000,0000,0000,,Мен мүлде дүрбелеңге түсіп кеттім.
Dialogue: 0,0:08:19.13,0:08:22.13,Default,,0000,0000,0000,,Біз сіздің айтқаныңызды тыңдаймыз.
Dialogue: 0,0:08:22.13,0:08:25.14,Default,,0000,0000,0000,,Біраз уақытқа
Dialogue: 0,0:08:22.13,0:08:25.14,Default,,0000,0000,0000,,Коуи
Dialogue: 0,0:08:22.13,0:08:25.14,Default,,0000,0000,0000,,Тәтті
Dialogue: 0,0:08:22.13,0:08:25.14,Default,,0000,0000,0000,,Мейірімділіктеріңізге рахмет→
Dialogue: 0,0:08:25.14,0:08:27.14,Default,,0000,0000,0000,,Сева
Dialogue: 0,0:08:25.14,0:08:27.14,Default,,0000,0000,0000,,Көмегің үшін рахмет...
Dialogue: 0,0:08:30.31,0:08:32.11,Default,,0000,0000,0000,,Пиина….
Dialogue: 0,0:08:32.11,0:08:34.11,Default,,0000,0000,0000,,Өте сүйкімді!
Dialogue: 0,0:08:34.11,0:08:36.22,Default,,0000,0000,0000,,Or... so cute! ?
Dialogue: 0,0:08:36.22,0:08:40.15,Default,,0000,0000,0000,,...
Dialogue: 0,0:08:36.22,0:08:40.15,Default,,0000,0000,0000,,Бұлай көрінсе де, жыл
Dialogue: 0,0:08:36.22,0:08:40.15,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:08:36.22,0:08:40.15,Default,,0000,0000,0000,,Бұл сізге ұқсас.
Dialogue: 0,0:08:40.15,0:08:43.12,Default,,0000,0000,0000,,Ах... Кешіріңіз.
Dialogue: 0,0:08:40.15,0:08:43.12,Default,,0000,0000,0000,,А, жоқ...
Dialogue: 0,0:08:43.12,0:08:47.13,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:08:43.12,0:08:47.13,Default,,0000,0000,0000,,Дұрыс, өз ертегіңді тыңда.
Dialogue: 0,0:08:43.12,0:08:47.13,Default,,0000,0000,0000,,Мен үйімді әкелдім.
Dialogue: 0,0:08:47.13,0:08:49.13,Default,,0000,0000,0000,,Үйде?
Dialogue: 0,0:08:50.13,0:08:52.10,Default,,0000,0000,0000,,Бұл...!
Dialogue: 0,0:08:54.13,0:08:58.10,Default,,0000,0000,0000,,Шамамен
Dialogue: 0,0:08:54.13,0:08:58.10,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Көп нәрсе
Dialogue: 0,0:08:54.13,0:08:58.10,Default,,0000,0000,0000,,Олардың бәрі сонда болуы керек, бірақ...
Dialogue: 0,0:09:00.14,0:09:02.11,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:09:00.14,0:09:02.11,Default,,0000,0000,0000,,Бұл үй маған?
Dialogue: 0,0:09:02.11,0:09:04.11,Default,,0000,0000,0000,,Бөлме
Dialogue: 0,0:09:02.11,0:09:04.11,Default,,0000,0000,0000,,Менің бөлмем тым үлкен.
Dialogue: 0,0:09:04.11,0:09:07.11,Default,,0000,0000,0000,,Сіз оны пайдалана аласыз ба?
Dialogue: 0,0:09:04.11,0:09:07.11,Default,,0000,0000,0000,,Бақытты
Dialogue: 0,0:09:04.11,0:09:07.11,Default,,0000,0000,0000,,Қуаныштымын!
Dialogue: 0,0:09:07.11,0:09:09.22,Default,,0000,0000,0000,,Мен қызғанамын.
Dialogue: 0,0:09:07.11,0:09:09.22,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:09.22,0:09:12.12,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:09:09.22,0:09:12.12,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:09:09.22,0:09:12.12,Default,,0000,0000,0000,,Кусу
Dialogue: 0,0:09:09.22,0:09:12.12,Default,,0000,0000,0000,,Кішкентай кезімде мен көп армандайтынмын.
Dialogue: 0,0:09:12.12,0:09:16.12,Default,,0000,0000,0000,,Ningyou
Dialogue: 0,0:09:12.12,0:09:16.12,Default,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:09:12.12,0:09:16.12,Default,,0000,0000,0000,,Егер сіз қуыршақтың үйінде тұрсаңыз
Dialogue: 0,0:09:12.12,0:09:16.12,Default,,0000,0000,0000,,Дұрыс айтпадым ба, Крюгер мырза?
Dialogue: 0,0:09:12.12,0:09:16.12,Default,,0000,0000,0000,,Мен бұл жақсы болар еді деп ойладым...
Dialogue: 0,0:09:16.12,0:09:19.13,Default,,0000,0000,0000,,Ылғау
Dialogue: 0,0:09:16.12,0:09:19.13,Default,,0000,0000,0000,,Бұл оңай!
Dialogue: 0,0:09:16.12,0:09:19.13,Default,,0000,0000,0000,,Сәлем, Дораемон.
Dialogue: 0,0:09:19.13,0:09:21.09,Default,,0000,0000,0000,,Мака
Dialogue: 0,0:09:19.13,0:09:21.09,Default,,0000,0000,0000,,Маған қалдырыңыз.
Dialogue: 0,0:09:25.13,0:09:27.13,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:25.13,0:09:27.13,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:25.13,0:09:27.13,Default,,0000,0000,0000,,Біз де кеттік!
Dialogue: 0,0:09:27.13,0:09:29.14,Default,,0000,0000,0000,,Олай болса...
Dialogue: 0,0:09:32.14,0:09:34.11,Default,,0000,0000,0000,,Мынау несі... Уау! ?
Dialogue: 0,0:09:34.11,0:09:42.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:42.11,0:09:45.15,Default,,0000,0000,0000,,Хехехе... Уау!
Dialogue: 0,0:09:42.11,0:09:45.15,Default,,0000,0000,0000,,Папи!
Dialogue: 0,0:09:45.15,0:09:48.15,Default,,0000,0000,0000,,Бұл керемет!
Dialogue: 0,0:09:45.15,0:09:48.15,Default,,0000,0000,0000,,Она
Dialogue: 0,0:09:45.15,0:09:48.15,Default,,0000,0000,0000,,О
Dialogue: 0,0:09:45.15,0:09:48.15,Default,,0000,0000,0000,,Енді олардың өлшемдері бірдей.
Dialogue: 0,0:09:48.15,0:09:52.12,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:09:48.15,0:09:52.12,Default,,0000,0000,0000,,Тосын
Dialogue: 0,0:09:48.15,0:09:52.12,Default,,0000,0000,0000,,Мен сізді таң қалдырдым ба?
Dialogue: 0,0:09:52.12,0:09:54.16,Default,,0000,0000,0000,,Иә, өте көп.
Dialogue: 0,0:09:54.16,0:09:57.16,Default,,0000,0000,0000,,Арата
Dialogue: 0,0:09:54.16,0:09:57.16,Default,,0000,0000,0000,,Енді мен бұл туралы тағы да ойландым.
Dialogue: 0,0:09:57.16,0:09:59.17,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:09:57.16,0:09:59.17,Default,,0000,0000,0000,,Миджика
Dialogue: 0,0:09:57.16,0:09:59.17,Default,,0000,0000,0000,,Өзіңізді адамдарға жақын сезіне аласыз →
Dialogue: 0,0:09:59.17,0:10:02.17,Default,,0000,0000,0000,,Суба
Dialogue: 0,0:09:59.17,0:10:02.17,Default,,0000,0000,0000,,Қандай керемет!
Dialogue: 0,0:09:59.17,0:10:02.17,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:10:02.17,0:10:05.17,Default,,0000,0000,0000,,Ахаха!
Dialogue: 0,0:10:02.17,0:10:05.17,Default,,0000,0000,0000,,Бұл тым көп, Папи-кун.
Dialogue: 0,0:10:05.17,0:10:09.14,Default,,0000,0000,0000,,Сәлем Папи. Мен
Dialogue: 0,0:10:05.17,0:10:09.14,Default,,0000,0000,0000,,Тезірек үйдің ішін қарап шыққым келеді.
Dialogue: 0,0:10:09.14,0:10:13.11,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:10:09.14,0:10:13.11,Default,,0000,0000,0000,,Енді осы жаққа келші.
Dialogue: 0,0:10:15.15,0:10:18.15,Default,,0000,0000,0000,,Уау! Бұл қуыршақ болған сияқты!
Dialogue: 0,0:10:18.15,0:10:20.15,Default,,0000,0000,0000,,Тауық
Dialogue: 0,0:10:18.15,0:10:20.15,Default,,0000,0000,0000,,Біртүрлі сезіледі.
Dialogue: 0,0:10:20.15,0:10:23.12,Default,,0000,0000,0000,,Хехе сүйкімді ас үй.
Dialogue: 0,0:10:23.12,0:10:25.12,Default,,0000,0000,0000,,Кайдан
Dialogue: 0,0:10:23.12,0:10:25.12,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:10:23.12,0:10:25.12,Default,,0000,0000,0000,,Ал сіз осы баспалдақпен көтерілгенде...
Dialogue: 0,0:10:26.16,0:10:29.13,Default,,0000,0000,0000,,Гука
Dialogue: 0,0:10:26.16,0:10:29.13,Default,,0000,0000,0000,,Сәнді ванна бөлмесі!
Dialogue: 0,0:10:29.13,0:10:31.13,Default,,0000,0000,0000,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:10:29.13,0:10:31.13,Default,,0000,0000,0000,,Осымен ыстық су алғым келеді.
Dialogue: 0,0:10:31.13,0:10:35.13,Default,,0000,0000,0000,,Кайзо
Dialogue: 0,0:10:31.13,0:10:35.13,Default,,0000,0000,0000,,Суидо
Dialogue: 0,0:10:31.13,0:10:35.13,Default,,0000,0000,0000,,Газды, суды және т.б.
Dialogue: 0,0:10:31.13,0:10:35.13,Default,,0000,0000,0000,,Оны қолдануға жарамды етейік.
Dialogue: 0,0:10:35.13,0:10:39.14,Default,,0000,0000,0000,,Шынымен бе? Дора-чан. жақсы!
Dialogue: 0,0:10:39.14,0:10:42.14,Default,,0000,0000,0000,,Ахаха! Төсек
Dialogue: 0,0:10:39.14,0:10:42.14,Default,,0000,0000,0000,,Нуно
Dialogue: 0,0:10:39.14,0:10:42.14,Default,,0000,0000,0000,,Шүберек пен губкадан жасалған.
Dialogue: 0,0:10:42.14,0:10:45.11,Default,,0000,0000,0000,,Ылғау
Dialogue: 0,0:10:42.14,0:10:45.11,Default,,0000,0000,0000,,Мен де осындай нәрсені қалаймын.
Dialogue: 0,0:10:45.11,0:10:48.11,Default,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:10:45.11,0:10:48.11,Default,,0000,0000,0000,,Кез келген уақытта келіңіз.
Dialogue: 0,0:10:48.11,0:10:50.15,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:10:48.11,0:10:50.15,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:10:50.15,0:10:54.15,Default,,0000,0000,0000,,Достар
Dialogue: 0,0:10:50.15,0:10:54.15,Default,,0000,0000,0000,,Эй, менің кішкентай досым
Dialogue: 0,0:10:50.15,0:10:54.15,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:10:50.15,0:10:54.15,Default,,0000,0000,0000,,Сізге телефон соғуға болады ма?
Dialogue: 0,0:10:54.15,0:10:57.12,Default,,0000,0000,0000,,Кішкентай дос?
Dialogue: 0,0:10:54.15,0:10:57.12,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:10:58.12,0:11:02.13,Default,,0000,0000,0000,,Мен әкелдім!
Dialogue: 0,0:10:58.12,0:11:02.13,Default,,0000,0000,0000,,Менің қуыршақтарым.
Dialogue: 0,0:11:02.13,0:11:05.10,Default,,0000,0000,0000,,Міне, міне!
Dialogue: 0,0:11:02.13,0:11:05.10,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:11:05.10,0:11:09.10,Default,,0000,0000,0000,,Олай болса... мынаны қолданайық!
Dialogue: 0,0:11:11.14,0:11:14.11,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:11:11.14,0:11:14.11,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:11:11.14,0:11:14.11,Default,,0000,0000,0000,,Орнатылған кезде
Dialogue: 0,0:11:11.14,0:11:14.11,Default,,0000,0000,0000,,Қуыршақ роботқа айналады.
Dialogue: 0,0:11:14.11,0:11:16.11,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:11:16.11,0:11:20.21,Default,,0000,0000,0000,,Бұл тұлыпқа арналған родео!
Dialogue: 0,0:11:16.11,0:11:20.21,Default,,0000,0000,0000,,Тамаша!
Dialogue: 0,0:11:20.21,0:11:22.18,Default,,0000,0000,0000,,⚟Бұл жеңіл тамақ.
Dialogue: 0,0:11:23.22,0:11:26.12,Default,,0000,0000,0000,,Оқиға
Dialogue: 0,0:11:23.22,0:11:26.12,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:26.12,0:11:29.12,Default,,0000,0000,0000,,Бірден қауын
Dialogue: 0,0:11:26.12,0:11:29.12,Default,,0000,0000,0000,,Хара
Dialogue: 0,0:11:26.12,0:11:29.12,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:11:26.12,0:11:29.12,Default,,0000,0000,0000,,Тойып жегім келді.
Dialogue: 0,0:11:31.12,0:11:34.09,Default,,0000,0000,0000,,Егер сіз шектен шығып кетсеңіз
Dialogue: 0,0:11:31.12,0:11:34.09,Default,,0000,0000,0000,,Асқазаңды бұзады.
Dialogue: 0,0:11:40.13,0:11:42.13,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:11:42.13,0:11:44.14,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:11:42.13,0:11:44.14,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:11:42.13,0:11:44.14,Default,,0000,0000,0000,,Чикюдің тамағы мынау
Dialogue: 0,0:11:42.13,0:11:44.14,Default,,0000,0000,0000,,Барлығы дәмді.
Dialogue: 0,0:11:47.11,0:11:49.11,Default,,0000,0000,0000,,О?
Dialogue: 0,0:11:50.11,0:11:52.14,Default,,0000,0000,0000,,Э? Тұр... не?
Dialogue: 0,0:11:52.14,0:11:54.18,Default,,0000,0000,0000,,Енді таза.
Dialogue: 0,0:11:54.18,0:11:58.15,Default,,0000,0000,0000,,Қазірдің өзінде! Пиина
Dialogue: 0,0:11:54.18,0:11:58.15,Default,,0000,0000,0000,,Бала Ацука
Dialogue: 0,0:11:54.18,0:11:58.15,Default,,0000,0000,0000,,Маған мәңгілік сәбидей қарашы...
Dialogue: 0,0:11:58.15,0:12:01.15,Default,,0000,0000,0000,,Иә? Пиина дегеніміз не?
Dialogue: 0,0:11:58.15,0:12:01.15,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:12:01.15,0:12:03.12,Default,,0000,0000,0000,,Жоқ... ештеңе...
Dialogue: 0,0:12:03.12,0:12:06.09,Default,,0000,0000,0000,,А, мен оны келесіде жегім келеді.
Dialogue: 0,0:12:07.13,0:12:09.10,Default,,0000,0000,0000,,Мазалағаным үшін кешіріңіз!
Dialogue: 0,0:12:07.13,0:12:09.10,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:12:07.13,0:12:09.10,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:12:07.13,0:12:09.10,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,0:12:12.13,0:12:14.10,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:12:15.10,0:12:17.10,Default,,0000,0000,0000,,Такеши-сан... Ах...
Dialogue: 0,0:12:18.14,0:12:20.11,Default,,0000,0000,0000,,Сәлем Нобита!
Dialogue: 0,0:12:18.14,0:12:20.11,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,0:12:20.11,0:12:24.11,Default,,0000,0000,0000,,Мен үшін алғаш рет!
Dialogue: 0,0:12:20.11,0:12:24.11,Default,,0000,0000,0000,,А... кетті!
Dialogue: 0,0:12:24.11,0:12:27.11,Default,,0000,0000,0000,,Бүгін
Dialogue: 0,0:12:24.11,0:12:27.11,Default,,0000,0000,0000,,Хиру
Dialogue: 0,0:12:24.11,0:12:27.11,Default,,0000,0000,0000,,Бүгін түсте бастаймыз.
Dialogue: 0,0:12:24.11,0:12:27.11,Default,,0000,0000,0000,,Мен айттым ғой! ?
Dialogue: 0,0:12:27.11,0:12:29.12,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:12:27.11,0:12:29.12,Default,,0000,0000,0000,,Сен мені қашанға дейін күтесің!
Dialogue: 0,0:12:29.12,0:12:31.12,Default,,0000,0000,0000,,Джуку
Dialogue: 0,0:12:29.12,0:12:31.12,Default,,0000,0000,0000,,Гашуку
Dialogue: 0,0:12:29.12,0:12:31.12,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:12:29.12,0:12:31.12,Default,,0000,0000,0000,,Енді Декисуги қарбалас мектеп лагерінен шықты→
Dialogue: 0,0:12:31.12,0:12:34.12,Default,,0000,0000,0000,,Сенрёку
Dialogue: 0,0:12:31.12,0:12:34.12,Default,,0000,0000,0000,,Дораемон - ұлы күш!
Dialogue: 0,0:12:34.12,0:12:38.12,Default,,0000,0000,0000,,Маған сен керексің
Dialogue: 0,0:12:34.12,0:12:38.12,Default,,0000,0000,0000,,Учудайсенсо
Dialogue: 0,0:12:34.12,0:12:38.12,Default,,0000,0000,0000,,Ұлы ғарыш соғысы басталған жоқ!
Dialogue: 0,0:12:38.12,0:12:40.13,Default,,0000,0000,0000,,Бұл ғарыштық соғыс! ?
Dialogue: 0,0:12:40.13,0:12:42.09,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:40.13,0:12:42.09,Default,,0000,0000,0000,,Сіз нені айтасыз! ?
Dialogue: 0,0:12:44.13,0:12:46.13,Default,,0000,0000,0000,,Папи деп аталады ма?
Dialogue: 0,0:12:46.13,0:12:50.14,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:12:46.13,0:12:50.14,Default,,0000,0000,0000,,Мұқият қарасаңыз, өте шынайы көрінеді.
Dialogue: 0,0:12:50.14,0:12:53.11,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,0:12:50.14,0:12:53.11,Default,,0000,0000,0000,,Екеуіңде көп нәрсе бар.
Dialogue: 0,0:12:50.14,0:12:53.11,Default,,0000,0000,0000,,Көмегің үшін рахмет.
Dialogue: 0,0:12:53.11,0:12:56.21,Default,,0000,0000,0000,,Сондықтан мен суретке түсе алмаймын.
Dialogue: 0,0:12:53.11,0:12:56.21,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:12:56.21,0:12:58.11,Default,,0000,0000,0000,,Эй?
Dialogue: 0,0:12:56.21,0:12:58.11,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:12:58.11,0:13:01.15,Default,,0000,0000,0000,,Дәл қазір, Шизука-чан
Dialogue: 0,0:12:58.11,0:13:01.15,Default,,0000,0000,0000,,Мен сенің кетіп бара жатқаныңды көрдім.
Dialogue: 0,0:13:01.15,0:13:05.15,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:13:01.15,0:13:05.15,Default,,0000,0000,0000,,Мм... иә... жоқ, бұл...
Dialogue: 0,0:13:05.15,0:13:09.12,Default,,0000,0000,0000,,Асо
Dialogue: 0,0:13:05.15,0:13:09.12,Default,,0000,0000,0000,,Сен ойнап жүрсің ғой!
Dialogue: 0,0:13:05.15,0:13:09.12,Default,,0000,0000,0000,,Кел
Dialogue: 0,0:13:05.15,0:13:09.12,Default,,0000,0000,0000,,Ауырсындырады...!
Dialogue: 0,0:13:09.12,0:13:13.13,Default,,0000,0000,0000,,Чикюджин
Dialogue: 0,0:13:09.12,0:13:13.13,Default,,0000,0000,0000,,Ал, біз жерлестер
Dialogue: 0,0:13:09.12,0:13:13.13,Default,,0000,0000,0000,,Накайо
Dialogue: 0,0:13:09.12,0:13:13.13,Default,,0000,0000,0000,,Барлығы жақсы араласады...
Dialogue: 0,0:13:13.13,0:13:16.13,Default,,0000,0000,0000,,Сізді жерлік ететін не?
Dialogue: 0,0:13:13.13,0:13:16.13,Default,,0000,0000,0000,,Көк
Dialogue: 0,0:13:13.13,0:13:16.13,Default,,0000,0000,0000,,Мына сұр көк дануки!
Dialogue: 0,0:13:16.13,0:13:18.13,Default,,0000,0000,0000,,Ұрыс - бұл
Dialogue: 0,0:13:16.13,0:13:18.13,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:13:18.13,0:13:20.13,Default,,0000,0000,0000,,Бұл маған тиді!
Dialogue: 0,0:13:18.13,0:13:20.13,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:13:20.13,0:13:23.17,Default,,0000,0000,0000,,Келіңдер, бәрің
Dialogue: 0,0:13:20.13,0:13:23.17,Default,,0000,0000,0000,,Миниатюралық жинақтар күтуде!
Dialogue: 0,0:13:23.17,0:13:26.14,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:13:23.17,0:13:26.14,Default,,0000,0000,0000,,Жақсы кадр…. Түсірілім қайта жалғасты!
Dialogue: 0,0:13:27.14,0:13:30.11,Default,,0000,0000,0000,,О! Бұл керемет!
Dialogue: 0,0:13:31.14,0:13:33.15,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:33.15,0:13:45.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:45.12,0:13:48.13,Default,,0000,0000,0000,,С.Ф.
Dialogue: 0,0:13:45.12,0:13:48.13,Default,,0000,0000,0000,,Бұл ғылыми фантастикалық фильмге түскендей!
Dialogue: 0,0:13:48.13,0:13:51.13,Default,,0000,0000,0000,,Цуку
Dialogue: 0,0:13:48.13,0:13:51.13,Default,,0000,0000,0000,,Дүние
Dialogue: 0,0:13:48.13,0:13:51.13,Default,,0000,0000,0000,,Бұл мен жасаған дүние!
Dialogue: 0,0:13:51.13,0:13:55.17,Default,,0000,0000,0000,,Кішірейіп, суретке түсуге тырысу
Dialogue: 0,0:13:51.13,0:13:55.17,Default,,0000,0000,0000,,Жақсы ойластырылған.
Dialogue: 0,0:13:55.17,0:13:58.14,Default,,0000,0000,0000,,Папи-кунды көргенде маған бір ой келді.
Dialogue: 0,0:13:58.14,0:14:01.14,Default,,0000,0000,0000,,Арба дұрыс
Dialogue: 0,0:13:58.14,0:14:01.14,Default,,0000,0000,0000,,Unten
Dialogue: 0,0:13:58.14,0:14:01.14,Default,,0000,0000,0000,,Жүргізу үшін жасалған.
Dialogue: 0,0:14:03.14,0:14:05.14,Default,,0000,0000,0000,,Міне, тежегіш...
Dialogue: 0,0:14:05.14,0:14:08.15,Default,,0000,0000,0000,,«Олай болса кеттік!»
Dialogue: 0,0:14:05.14,0:14:08.15,Default,,0000,0000,0000,,Иә! ? Жоқ, әлі жоқ...!
Dialogue: 0,0:14:08.15,0:14:11.15,Default,,0000,0000,0000,,Цуйгеки
Dialogue: 0,0:14:08.15,0:14:11.15,Default,,0000,0000,0000,,Астро баггиді қуу сахнасы!
Dialogue: 0,0:14:11.15,0:14:13.12,Default,,0000,0000,0000,,Дайындаңыз... Әрекет!
Dialogue: 0,0:14:18.12,0:14:20.19,Default,,0000,0000,0000,,Хяхо~!
Dialogue: 0,0:14:18.12,0:14:20.19,Default,,0000,0000,0000,,Хяхо~!
Dialogue: 0,0:14:20.19,0:14:22.13,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:14:20.19,0:14:22.13,Default,,0000,0000,0000,,Мен жеңілмеймін!
Dialogue: 0,0:14:22.13,0:14:24.10,Default,,0000,0000,0000,,Ал... күте тұрыңыз, Дораемон!
Dialogue: 0,0:14:31.14,0:14:35.21,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:14:31.14,0:14:35.21,Default,,0000,0000,0000,,Мен мұны істеп жатқанда,
Dialogue: 0,0:14:31.14,0:14:35.21,Default,,0000,0000,0000,,Пирика планетасында...
Dialogue: 0,0:14:35.21,0:14:39.18,Default,,0000,0000,0000,,Кикаион
Dialogue: 0,0:14:35.21,0:14:39.18,Default,,0000,0000,0000,,⚞ (механикалық дыбыс)
Dialogue: 0,0:14:35.21,0:14:39.18,Default,,0000,0000,0000,,Иә? Мүмкін емес...!
Dialogue: 0,0:14:41.15,0:14:44.12,Default,,0000,0000,0000,,Нақты іс басталғалы тұр!
Dialogue: 0,0:14:41.15,0:14:44.12,Default,,0000,0000,0000,,Хэхехе!
Dialogue: 0,0:14:45.12,0:14:47.15,Default,,0000,0000,0000,,О? Не?
Dialogue: 0,0:14:47.15,0:14:50.12,Default,,0000,0000,0000,,Хикун
Dialogue: 0,0:14:47.15,0:14:50.12,Default,,0000,0000,0000,,(Ұшу дыбысы)
Dialogue: 0,0:14:50.12,0:14:54.13,Default,,0000,0000,0000,,Уа... ау!
Dialogue: 0,0:14:50.12,0:14:54.13,Default,,0000,0000,0000,,Мына жігіт түсінді!
Dialogue: 0,0:14:54.13,0:14:58.13,Default,,0000,0000,0000,,Сунео күткендей!
Dialogue: 0,0:14:54.13,0:14:58.13,Default,,0000,0000,0000,,Сіз керемет жасадыңыз.
Dialogue: 0,0:14:58.13,0:15:01.13,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:14:58.13,0:15:01.13,Default,,0000,0000,0000,,Дораемон, солай ма?
Dialogue: 0,0:15:01.13,0:15:03.14,Default,,0000,0000,0000,,Не? Менде ондай ештеңе жоқ.
Dialogue: 0,0:15:03.14,0:15:06.21,Default,,0000,0000,0000,,Не! ? Амал жоқ
Dialogue: 0,0:15:03.14,0:15:06.21,Default,,0000,0000,0000,,Бұл Нобита болуы мүмкін емес...
Dialogue: 0,0:15:06.21,0:15:09.21,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:15:10.14,0:15:14.15,Default,,0000,0000,0000,,(Ұшу дыбысы)
Dialogue: 0,0:15:14.15,0:15:17.12,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:15:14.15,0:15:17.12,Default,,0000,0000,0000,,"Бұл жау! Бәрің жүгіріңдер!"
Dialogue: 0,0:15:14.15,0:15:17.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:17.12,0:15:19.08,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:15:17.12,0:15:19.08,Default,,0000,0000,0000,,Вааах!
Dialogue: 0,0:15:21.12,0:15:23.19,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:15:23.19,0:15:25.12,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:15:23.19,0:15:25.12,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:15:25.12,0:15:28.13,Default,,0000,0000,0000,,Менің миниатюра...!
Dialogue: 0,0:15:25.12,0:15:28.13,Default,,0000,0000,0000,,Идиот! Қанекей жүгірейік!
Dialogue: 0,0:15:28.13,0:15:31.13,Default,,0000,0000,0000,,Онда шығып, баспалдақпен жоғары өрмеле.
Dialogue: 0,0:15:28.13,0:15:31.13,Default,,0000,0000,0000,,Багги Багги...!
Dialogue: 0,0:15:31.13,0:15:33.13,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:15:31.13,0:15:33.13,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:15:33.13,0:15:35.13,Default,,0000,0000,0000,,Нобита-кун!
Dialogue: 0,0:15:38.14,0:15:41.11,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:15:38.14,0:15:41.11,Default,,0000,0000,0000,,Жүр! Жүр, асығыңыз!
Dialogue: 0,0:15:41.11,0:15:47.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:47.11,0:15:50.15,Default,,0000,0000,0000,,Доро
Dialogue: 0,0:15:47.11,0:15:50.15,Default,,0000,0000,0000,,Жолға шығайық!
Dialogue: 0,0:15:47.11,0:15:50.15,Default,,0000,0000,0000,,Миги
Dialogue: 0,0:15:47.11,0:15:50.15,Default,,0000,0000,0000,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:15:50.15,0:15:53.15,Default,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:15:50.15,0:15:53.15,Default,,0000,0000,0000,,Сіз әлі келе жатырсыз ба...?
Dialogue: 0,0:15:50.15,0:15:53.15,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:15:50.15,0:15:53.15,Default,,0000,0000,0000,,«Джан Мэй Мэй!»
Dialogue: 0,0:15:53.15,0:15:55.12,Default,,0000,0000,0000,,О...! Апыр-ай!
Dialogue: 0,0:15:57.19,0:16:00.09,Default,,0000,0000,0000,,егеуқұйрық па?
Dialogue: 0,0:15:57.19,0:16:00.09,Default,,0000,0000,0000,,О? Уау не! ?
Dialogue: 0,0:16:00.09,0:16:02.13,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:16:00.09,0:16:02.13,Default,,0000,0000,0000,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:16:02.13,0:16:04.10,Default,,0000,0000,0000,,(жарылған дыбыс)
Dialogue: 0,0:16:02.13,0:16:04.10,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:16:04.10,0:16:09.13,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:09.13,0:16:11.14,Default,,0000,0000,0000,,бұған оғаш көзіп қойған шығар.
Dialogue: 0,0:16:11.14,0:16:13.14,Default,,0000,0000,0000,,Келу
Dialogue: 0,0:16:11.14,0:16:13.14,Default,,0000,0000,0000,,Мен құтқарылдым...
Dialogue: 0,0:16:13.14,0:16:15.11,Default,,0000,0000,0000,,Түтін
Dialogue: 0,0:16:13.14,0:16:15.11,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:16:13.14,0:16:15.11,Default,,0000,0000,0000,,Түтін ұшып тұр...
Dialogue: 0,0:16:15.11,0:16:17.11,Default,,0000,0000,0000,,О-
Dialogue: 0,0:16:15.11,0:16:17.11,Default,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:16:15.11,0:16:17.11,Default,,0000,0000,0000,,Ах! Мен түсірілім алаңындағы өртті сөндіруім керек!
Dialogue: 0,0:16:20.11,0:16:22.11,Default,,0000,0000,0000,,Джудан
Dialogue: 0,0:16:20.11,0:16:22.11,Default,,0000,0000,0000,,Қалжың емес!
Dialogue: 0,0:16:22.11,0:16:25.12,Default,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:16:22.11,0:16:25.12,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:22.11,0:16:25.12,Default,,0000,0000,0000,,Неліктен мен осыдан өтуім керек?
Dialogue: 0,0:16:22.11,0:16:25.12,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:16:25.12,0:16:27.12,Default,,0000,0000,0000,,Папи-кун
Dialogue: 0,0:16:25.12,0:16:27.12,Default,,0000,0000,0000,,Сіз бір нәрсені білетін сияқтысыз.
Dialogue: 0,0:16:27.12,0:16:29.36,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:16:29.36,0:16:32.12,Default,,0000,0000,0000,,Бәрібір сен кінәлісің!
Dialogue: 0,0:16:29.36,0:16:32.12,Default,,0000,0000,0000,,Бір минут күтіңіз!
Dialogue: 0,0:16:32.12,0:16:34.13,Default,,0000,0000,0000,,Сіз мені құтқардыңыз!
Dialogue: 0,0:16:34.13,0:16:36.13,Default,,0000,0000,0000,,Тұқым
Dialogue: 0,0:16:34.13,0:16:36.13,Default,,0000,0000,0000,,Өзім еккен дәнім.
Dialogue: 0,0:16:36.13,0:16:39.13,Default,,0000,0000,0000,,Иә? Тұқымға не болды?
Dialogue: 0,0:16:39.13,0:16:43.14,Default,,0000,0000,0000,,Көңіл көтеру
Dialogue: 0,0:16:39.13,0:16:43.14,Default,,0000,0000,0000,,О.
Dialogue: 0,0:16:39.13,0:16:43.14,Default,,0000,0000,0000,,Бұрынғы кеме мені қуып келе жатты.
Dialogue: 0,0:16:39.13,0:16:43.14,Default,,0000,0000,0000,,Учу Сенкан
Dialogue: 0,0:16:39.13,0:16:43.14,Default,,0000,0000,0000,,Пифияның ғарыш кемесі.
Dialogue: 0,0:16:43.14,0:16:47.21,Default,,0000,0000,0000,,Артыңыздан келе жатырсыз ба?
Dialogue: 0,0:16:43.14,0:16:47.21,Default,,0000,0000,0000,,Пифия? Бұл не? сол.
Dialogue: 0,0:16:47.21,0:16:49.14,Default,,0000,0000,0000,,Қорытынды
Dialogue: 0,0:16:47.21,0:16:49.14,Default,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:16:47.21,0:16:49.14,Default,,0000,0000,0000,,Басынан бастайық.
Dialogue: 0,0:16:49.14,0:16:53.15,Default,,0000,0000,0000,,Кокио
Dialogue: 0,0:16:49.14,0:16:53.15,Default,,0000,0000,0000,,Менің туған жерім Пирика
Dialogue: 0,0:16:49.14,0:16:53.15,Default,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:16:49.14,0:16:53.15,Default,,0000,0000,0000,,Толқу
Dialogue: 0,0:16:49.14,0:16:53.15,Default,,0000,0000,0000,,Бұл өте бейбіт планета болды.
Dialogue: 0,0:16:53.15,0:16:55.15,Default,,0000,0000,0000,,О-
Dialogue: 0,0:16:53.15,0:16:55.15,Default,,0000,0000,0000,,Алайда, бір күні→
Dialogue: 0,0:16:55.15,0:16:58.12,Default,,0000,0000,0000,,Шогунхики
Dialogue: 0,0:16:55.15,0:16:58.12,Default,,0000,0000,0000,,Гүнтай
Dialogue: 0,0:16:55.15,0:16:58.12,Default,,0000,0000,0000,,Генерал Гилмор басқарған армия
Dialogue: 0,0:16:55.15,0:16:58.12,Default,,0000,0000,0000,,Ханран
Dialogue: 0,0:16:55.15,0:16:58.12,Default,,0000,0000,0000,,О.
Dialogue: 0,0:16:55.15,0:16:58.12,Default,,0000,0000,0000,,Көтеріліс шығару→
Dialogue: 0,0:16:58.12,0:17:02.12,Default,,0000,0000,0000,,Сейфу
Dialogue: 0,0:16:58.12,0:17:02.12,Default,,0000,0000,0000,,Фуи
Dialogue: 0,0:16:58.12,0:17:02.12,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:16:58.12,0:17:02.12,Default,,0000,0000,0000,,Үкімет таң қалды
Dialogue: 0,0:16:58.12,0:17:02.12,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:16:58.12,0:17:02.12,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:16:58.12,0:17:02.12,Default,,0000,0000,0000,,Ол ұрланған.
Dialogue: 0,0:17:02.12,0:17:07.16,Default,,0000,0000,0000,,Бұл генерал Гилмор
Dialogue: 0,0:17:02.12,0:17:07.16,Default,,0000,0000,0000,,Жаман нәрселер
Dialogue: 0,0:17:02.12,0:17:07.16,Default,,0000,0000,0000,,Нашар бастық?
Dialogue: 0,0:17:07.16,0:17:12.13,Default,,0000,0000,0000,,Хантай
Dialogue: 0,0:17:07.16,0:17:12.13,Default,,0000,0000,0000,,Go
Dialogue: 0,0:17:07.16,0:17:12.13,Default,,0000,0000,0000,,Генералдың өзіне қарсы пікірлері бар.
Dialogue: 0,0:17:07.16,0:17:12.13,Default,,0000,0000,0000,,Шудан
Dialogue: 0,0:17:07.16,0:17:12.13,Default,,0000,0000,0000,,Кез келген әдіспен өшіру →
Dialogue: 0,0:17:12.13,0:17:14.13,Default,,0000,0000,0000,,Сошики
Dialogue: 0,0:17:12.13,0:17:14.13,Default,,0000,0000,0000,,Пифия деп аталатын ұйым құрдық.
Dialogue: 0,0:17:14.13,0:17:17.14,Default,,0000,0000,0000,,Қытай шамы
Dialogue: 0,0:17:14.13,0:17:17.14,Default,,0000,0000,0000,,Пифияның басшысы - Дракоруру.
Dialogue: 0,0:17:17.14,0:17:20.14,Default,,0000,0000,0000,,Варуджи
Dialogue: 0,0:17:17.14,0:17:20.14,Default,,0000,0000,0000,,Хатара
Dialogue: 0,0:17:17.14,0:17:20.14,Default,,0000,0000,0000,,Қулық жұмыстары
Dialogue: 0,0:17:17.14,0:17:20.14,Default,,0000,0000,0000,,Акума
Dialogue: 0,0:17:17.14,0:17:20.14,Default,,0000,0000,0000,,Орын
Dialogue: 0,0:17:17.14,0:17:20.14,Default,,0000,0000,0000,,Ол шайтан сияқты.
Dialogue: 0,0:17:20.14,0:17:24.14,Default,,0000,0000,0000,,Сол Пифия
Dialogue: 0,0:17:20.14,0:17:24.14,Default,,0000,0000,0000,,Мауах
Dialogue: 0,0:17:20.14,0:17:24.14,Default,,0000,0000,0000,,Сен неге Папи-кунның соңынан еріп жүрсің?
Dialogue: 0,0:17:24.14,0:17:26.15,Default,,0000,0000,0000,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:17:26.15,0:17:31.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:31.15,0:17:34.15,Default,,0000,0000,0000,,Ханджурёку
Dialogue: 0,0:17:31.15,0:17:34.15,Default,,0000,0000,0000,,Шуцурёку
Dialogue: 0,0:17:31.15,0:17:34.15,Default,,0000,0000,0000,,Ауырлық күшіне қарсы қозғалтқыштың шығысы
Dialogue: 0,0:17:31.15,0:17:34.15,Default,,0000,0000,0000,,О.
Dialogue: 0,0:17:31.15,0:17:34.15,Default,,0000,0000,0000,,Барған сайын құлап барады!
Dialogue: 0,0:17:34.15,0:17:38.16,Default,,0000,0000,0000,,Сөмке
Dialogue: 0,0:17:34.15,0:17:38.16,Default,,0000,0000,0000,,Цуйраку
Dialogue: 0,0:17:34.15,0:17:38.16,Default,,0000,0000,0000,,Осы жылдамдықпен сіз апатқа ұшырайсыз!
Dialogue: 0,0:17:34.15,0:17:38.16,Default,,0000,0000,0000,,Мен оны бір жерде жөндеуім керек...
Dialogue: 0,0:17:38.16,0:17:40.13,Default,,0000,0000,0000,,Директор Дракоруру...!
Dialogue: 0,0:17:40.13,0:17:42.16,Default,,0000,0000,0000,,Бұл планетаның жігіттері→
Dialogue: 0,0:17:42.16,0:17:44.13,Default,,0000,0000,0000,,Мен оны тым төмен бағаладым ба?
Dialogue: 0,0:17:44.13,0:17:47.13,Default,,0000,0000,0000,,Джи
Dialogue: 0,0:17:44.13,0:17:47.13,Default,,0000,0000,0000,,оған үкім шығарсын деп қалайтынын.
Dialogue: 0,0:17:44.13,0:17:47.13,Default,,0000,0000,0000,,Яма
Dialogue: 0,0:17:44.13,0:17:47.13,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:17:44.13,0:17:47.13,Default,,0000,0000,0000,,Сағат 10 бағытында тауға қарай жүріңіз!
Dialogue: 0,0:17:47.13,0:17:50.14,Default,,0000,0000,0000,,Қарау
Dialogue: 0,0:17:47.13,0:17:50.14,Default,,0000,0000,0000,,Жасырын нүктелерді іздеу
Dialogue: 0,0:17:47.13,0:17:50.14,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:17:47.13,0:17:50.14,Default,,0000,0000,0000,,Жер!
Dialogue: 0,0:17:52.10,0:17:54.11,Default,,0000,0000,0000,,Дайто Рио
Dialogue: 0,0:17:52.10,0:17:54.11,Default,,0000,0000,0000,,Сіз президентсіз! ?
Dialogue: 0,0:17:54.11,0:17:58.11,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:17:54.11,0:17:58.11,Default,,0000,0000,0000,,Мүмкін генерал
Dialogue: 0,0:17:54.11,0:17:58.11,Default,,0000,0000,0000,,Шори
Dialogue: 0,0:17:54.11,0:17:58.11,Default,,0000,0000,0000,,Какуджитсу
Dialogue: 0,0:17:54.11,0:17:58.11,Default,,0000,0000,0000,,Жеңісті қамтамасыз ету үшін→
Dialogue: 0,0:17:58.11,0:18:02.11,Default,,0000,0000,0000,,Мен президентпін.
Dialogue: 0,0:17:58.11,0:18:02.11,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:17:58.11,0:18:02.11,Default,,0000,0000,0000,,Олар ұсталғысы келетін шығар.
Dialogue: 0,0:18:02.11,0:18:04.15,Default,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:18:02.11,0:18:04.15,Default,,0000,0000,0000,,Папи-кун үшін ғана...
Dialogue: 0,0:18:04.15,0:18:07.12,Default,,0000,0000,0000,,Үлкен шайқас...
Dialogue: 0,0:18:09.12,0:18:12.12,Default,,0000,0000,0000,,Қауіпсіздік
Dialogue: 0,0:18:09.12,0:18:12.12,Default,,0000,0000,0000,,Президент, уайымдамаңыз.
Dialogue: 0,0:18:09.12,0:18:12.12,Default,,0000,0000,0000,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:18:12.12,0:18:14.13,Default,,0000,0000,0000,,Миката
Dialogue: 0,0:18:12.12,0:18:14.13,Default,,0000,0000,0000,,Біз сенің жағындамыз.
Dialogue: 0,0:18:14.13,0:18:17.13,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:18:14.13,0:18:17.13,Default,,0000,0000,0000,,Келесі жолы олар келеді
Dialogue: 0,0:18:14.13,0:18:17.13,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:18:14.13,0:18:17.13,Default,,0000,0000,0000,,Мен сені жұдырықтаймын!
Dialogue: 0,0:18:17.13,0:18:19.13,Default,,0000,0000,0000,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:18:17.13,0:18:19.13,Default,,0000,0000,0000,,Мен де істеймін!
Dialogue: 0,0:18:19.13,0:18:22.13,Default,,0000,0000,0000,,Мәметсубу
Dialogue: 0,0:18:19.13,0:18:22.13,Default,,0000,0000,0000,,Ашық
Dialogue: 0,0:18:19.13,0:18:22.13,Default,,0000,0000,0000,,Қарсылас бұршақтай болса
Dialogue: 0,0:18:19.13,0:18:22.13,Default,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:18:19.13,0:18:22.13,Default,,0000,0000,0000,,Қорықпа!
Dialogue: 0,0:18:22.13,0:18:24.10,Default,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:18:22.13,0:18:24.10,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:18:22.13,0:18:24.10,Default,,0000,0000,0000,,(Дораэмонның күлкісі)
Dialogue: 0,0:18:30.11,0:18:33.15,Default,,0000,0000,0000,,...
Dialogue: 0,0:18:30.11,0:18:33.15,Default,,0000,0000,0000,,Екі қолда да даңқ; жеңіс – біздің әніміз
Dialogue: 0,0:18:30.11,0:18:33.15,Default,,0000,0000,0000,,...
Dialogue: 0,0:18:30.11,0:18:33.15,Default,,0000,0000,0000,,Жөндеу жұмыстары бірнеше күнге созылады.
Dialogue: 0,0:18:33.15,0:18:35.11,Default,,0000,0000,0000,,Ал, адъютант, дәл қазір →
Dialogue: 0,0:18:35.11,0:18:39.12,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:18:35.11,0:18:39.12,Default,,0000,0000,0000,,Матсуда мырза өледі.
Dialogue: 0,0:18:35.11,0:18:39.12,Default,,0000,0000,0000,,Шира
Dialogue: 0,0:18:35.11,0:18:39.12,Default,,0000,0000,0000,,Маған бұл аймақты мұқият зерттеуге рұқсат етіңіз.
Dialogue: 0,0:18:35.11,0:18:39.12,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:18:39.12,0:18:41.09,Default,,0000,0000,0000,,Тансакюу
Dialogue: 0,0:18:39.12,0:18:41.09,Default,,0000,0000,0000,,...
Dialogue: 0,0:18:39.12,0:18:41.09,Default,,0000,0000,0000,,Барлау сферасы шығарылды!
Dialogue: 0,0:18:48.99,0:18:49.16,Default,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:18:48.99,0:18:49.16,Default,,0000,0000,0000,,Кинотеатрға барыңыз.
Dialogue: 0,0:18:48.99,0:18:49.16,Default,,0000,0000,0000,,жүгірді
Dialogue: 0,0:18:48.99,0:18:49.16,Default,,0000,0000,0000,,қараңыз.
Dialogue: 0,0:18:50.20,0:18:52.20,Default,,0000,0000,0000,,Екеуің
Dialogue: 0,0:18:50.20,0:18:52.20,Default,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:18:50.20,0:18:52.20,Default,,0000,0000,0000,,Қазір демалыңыз.
Dialogue: 0,0:18:52.20,0:18:55.17,Default,,0000,0000,0000,,Қалғанын өз бетімше істей аламын.
Dialogue: 0,0:18:55.17,0:18:57.17,Default,,0000,0000,0000,,Tetsuda
Dialogue: 0,0:18:55.17,0:18:57.17,Default,,0000,0000,0000,,Жарайды, мен саған көмектесейін.
Dialogue: 0,0:18:57.17,0:18:59.17,Default,,0000,0000,0000,,Жазғы демалыс
Dialogue: 0,0:18:57.17,0:18:59.17,Default,,0000,0000,0000,,Шукудай
Dialogue: 0,0:18:57.17,0:18:59.17,Default,,0000,0000,0000,,Жазғы демалыстағы үй тапсырмасы ше?
Dialogue: 0,0:18:59.17,0:19:01.17,Default,,0000,0000,0000,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:18:59.17,0:19:01.17,Default,,0000,0000,0000,,Рахмет….
Dialogue: 0,0:19:04.18,0:19:06.18,Default,,0000,0000,0000,,Хмм... иә?
Dialogue: 0,0:19:06.18,0:19:10.18,Default,,0000,0000,0000,,Ах! Қараңдар, қараңдар! Бұл от жабыны!
Dialogue: 0,0:19:06.18,0:19:10.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:10.18,0:19:12.18,Default,,0000,0000,0000,,Мезура
Dialogue: 0,0:19:10.18,0:19:12.18,Default,,0000,0000,0000,,Бұл дұрыс. сирек!
Dialogue: 0,0:19:15.19,0:19:17.19,Default,,0000,0000,0000,,Міне, міне!
Dialogue: 0,0:19:15.19,0:19:17.19,Default,,0000,0000,0000,,Э? Тұр... не?
Dialogue: 0,0:19:17.19,0:19:19.19,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,0:19:19.19,0:19:22.19,Default,,0000,0000,0000,,♬~ «Мұның суы тәтті».
Dialogue: 0,0:19:27.20,0:19:29.17,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:19:27.20,0:19:29.17,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:29.17,0:19:32.17,Default,,0000,0000,0000,,Терезе
Dialogue: 0,0:19:29.17,0:19:32.17,Default,,0000,0000,0000,,Терезені жабыңыз!
Dialogue: 0,0:19:29.17,0:19:32.17,Default,,0000,0000,0000,,Перделер тым ерте!
Dialogue: 0,0:19:35.17,0:19:37.18,Default,,0000,0000,0000,,Пифияның барлау сферасы! ?
Dialogue: 0,0:19:37.18,0:19:39.18,Default,,0000,0000,0000,,Тыңдау
Dialogue: 0,0:19:37.18,0:19:39.18,Default,,0000,0000,0000,,Тіпті мұндай машинаны пайдалану...
Dialogue: 0,0:19:39.18,0:19:43.38,Default,,0000,0000,0000,,Могу
Dialogue: 0,0:19:39.18,0:19:43.38,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:19:39.18,0:19:43.38,Default,,0000,0000,0000,,Кез келген жерге жасырын өтіңіз
Dialogue: 0,0:19:39.18,0:19:43.38,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:19:39.18,0:19:43.38,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:19:39.18,0:19:43.38,Default,,0000,0000,0000,,Қарсыласыңыздың орнын табыңыз.
Dialogue: 0,0:19:43.38,0:19:45.25,Default,,0000,0000,0000,,Өзімді жалқау сезінгенде
Dialogue: 0,0:19:43.38,0:19:45.25,Default,,0000,0000,0000,,Сіз табыласыз!
Dialogue: 0,0:19:45.25,0:19:47.25,Default,,0000,0000,0000,,Жарайды...!
Dialogue: 0,0:19:52.16,0:19:54.19,Default,,0000,0000,0000,,
Dialogue: 0,0:19:52.16,0:19:54.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:54.19,0:19:56.19,Default,,0000,0000,0000,,Шизука-чан.
Dialogue: 0,0:19:56.19,0:19:58.16,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:19:56.19,0:19:58.16,Default,,0000,0000,0000,,Осы сағатта кешірім сұраймын.
Dialogue: 0,0:19:59.26,0:20:03.24,Default,,0000,0000,0000,,Өте
Dialogue: 0,0:19:59.26,0:20:03.24,Default,,0000,0000,0000,,Мен мұндай қорқынышты оқиға болады деп күтпедім.
Dialogue: 0,0:19:59.26,0:20:03.24,Default,,0000,0000,0000,,Мен оның болғанына сене алар емеспін...
Dialogue: 0,0:20:03.24,0:20:06.27,Default,,0000,0000,0000,,Әлі де оларға
Dialogue: 0,0:20:03.24,0:20:06.27,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,0:20:03.24,0:20:06.27,Default,,0000,0000,0000,,Беттің ашылмаған себебі →
Dialogue: 0,0:20:06.27,0:20:08.17,Default,,0000,0000,0000,,Бұл жай ғана Шизука-чан.
Dialogue: 0,0:20:08.17,0:20:12.28,Default,,0000,0000,0000,,Сондықтан Папи-кун
Dialogue: 0,0:20:08.17,0:20:12.28,Default,,0000,0000,0000,,Мені жасыра аласың ба деп ойладым...
Dialogue: 0,0:20:12.28,0:20:14.21,Default,,0000,0000,0000,,Маған қалдырыңыз.
Dialogue: 0,0:20:14.21,0:20:16.21,Default,,0000,0000,0000,,Папи
Dialogue: 0,0:20:14.21,0:20:16.21,Default,,0000,0000,0000,,Энрио
Dialogue: 0,0:20:14.21,0:20:16.21,Default,,0000,0000,0000,,Менімен бірге болыңыз.
Dialogue: 0,0:20:16.21,0:20:18.18,Default,,0000,0000,0000,,Рахмет….
Dialogue: 0,0:20:18.18,0:20:20.19,Default,,0000,0000,0000,,Көңілді
Dialogue: 0,0:20:18.18,0:20:20.19,Default,,0000,0000,0000,,Бірақ мен әлі де алаңдаймын. Жақсы….
Dialogue: 0,0:20:26.19,0:20:28.19,Default,,0000,0000,0000,,Жақсы! Йотто….
Dialogue: 0,0:20:28.19,0:20:30.20,Default,,0000,0000,0000,,Кел.
Dialogue: 0,0:20:31.20,0:20:34.17,Default,,0000,0000,0000,,Бұл баспалдақ. сақ болыңыз.
Dialogue: 0,0:20:35.20,0:20:37.17,Default,,0000,0000,0000,,Тайка Козо
Dialogue: 0,0:20:35.20,0:20:37.17,Default,,0000,0000,0000,,Өйткені оның отқа төзімді құрылымы бар→
Dialogue: 0,0:20:37.17,0:20:40.21,Default,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:20:37.17,0:20:40.21,Default,,0000,0000,0000,,Хара
Dialogue: 0,0:20:37.17,0:20:40.21,Default,,0000,0000,0000,,Үй өртеніп кетсе де
Dialogue: 0,0:20:37.17,0:20:40.21,Default,,0000,0000,0000,,Айнымас.
Dialogue: 0,0:20:40.21,0:20:42.17,Default,,0000,0000,0000,,Өртеп жіберуге тұрарлық па?
Dialogue: 0,0:20:43.21,0:20:46.21,Default,,0000,0000,0000,,Бұл негізгі бөлме.
Dialogue: 0,0:20:43.21,0:20:46.21,Default,,0000,0000,0000,,Уау, ғажап, ғажап!
Dialogue: 0,0:20:46.21,0:20:48.18,Default,,0000,0000,0000,,Таши
Dialogue: 0,0:20:46.21,0:20:48.18,Default,,0000,0000,0000,,Ганжо
Dialogue: 0,0:20:46.21,0:20:48.18,Default,,0000,0000,0000,,Бұл, әрине, қатты көрінеді.
Dialogue: 0,0:20:49.21,0:20:52.22,Default,,0000,0000,0000,,Тохо
Dialogue: 0,0:20:49.21,0:20:52.22,Default,,0000,0000,0000,,Бұл керемет үлкен аумақ...
Dialogue: 0,0:20:52.22,0:20:55.19,Default,,0000,0000,0000,,Келесі, зымыран жөндеу
Dialogue: 0,0:20:52.22,0:20:55.19,Default,,0000,0000,0000,,Осы жерде орындайық.
Dialogue: 0,0:20:55.19,0:20:57.19,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:20:57.19,0:20:59.19,Default,,0000,0000,0000,,Юдан
Dialogue: 0,0:20:57.19,0:20:59.19,Default,,0000,0000,0000,,Бірақ сақтығыңызды төмендетпеңіз.
Dialogue: 0,0:20:59.19,0:21:01.23,Default,,0000,0000,0000,,Дракоруру →
Dialogue: 0,0:21:01.23,0:21:04.20,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:21:01.23,0:21:04.20,Default,,0000,0000,0000,,Папи-кунды ұстау
Dialogue: 0,0:21:01.23,0:21:04.20,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:21:01.23,0:21:04.20,Default,,0000,0000,0000,,Не қажет болса да жасаңыз.
Dialogue: 0,0:21:04.20,0:21:06.20,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:21:04.20,0:21:06.20,Default,,0000,0000,0000,,Мен мұны есте ұстаймын.
Dialogue: 0,0:21:06.20,0:21:09.23,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:21:09.23,0:21:11.20,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:21:09.23,0:21:11.20,Default,,0000,0000,0000,,Есеп беру!
Dialogue: 0,0:21:11.20,0:21:14.21,Default,,0000,0000,0000,,Кюрёкуша
Dialogue: 0,0:21:11.20,0:21:14.21,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:21:11.20,0:21:14.21,Default,,0000,0000,0000,,Арнайы
Dialogue: 0,0:21:11.20,0:21:14.21,Default,,0000,0000,0000,,Папидің төрт серіктесін анықтаңыз.
Dialogue: 0,0:21:11.20,0:21:14.21,Default,,0000,0000,0000,,Мика
Dialogue: 0,0:21:11.20,0:21:14.21,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:21:11.20,0:21:14.21,Default,,0000,0000,0000,,Үш күн болды →
Dialogue: 0,0:21:14.21,0:21:16.21,Default,,0000,0000,0000,,Қиын
Dialogue: 0,0:21:14.21,0:21:16.21,Default,,0000,0000,0000,,Көк Дарума мен ақымақ жүзден басқа →
Dialogue: 0,0:21:16.21,0:21:20.21,Default,,0000,0000,0000,,Құрсау
Dialogue: 0,0:21:16.21,0:21:20.21,Default,,0000,0000,0000,,Сесшоку
Dialogue: 0,0:21:16.21,0:21:20.21,Default,,0000,0000,0000,,Шарт
Dialogue: 0,0:21:16.21,0:21:20.21,Default,,0000,0000,0000,,Олардың бір-бірімен қарым-қатынасы
Dialogue: 0,0:21:16.21,0:21:20.21,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:21:20.21,0:21:22.21,Default,,0000,0000,0000,,Папи болса ше...!
Dialogue: 0,0:21:22.21,0:21:25.18,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:21:22.21,0:21:25.18,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:21:22.21,0:21:25.18,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:21:22.21,0:21:25.18,Default,,0000,0000,0000,,Ая
Dialogue: 0,0:21:22.21,0:21:25.18,Default,,0000,0000,0000,,Бұл әрекет өте күдікті.
Dialogue: 0,0:21:25.18,0:21:27.19,Default,,0000,0000,0000,,Хатшы!
Dialogue: 0,0:21:27.19,0:21:31.22,Default,,0000,0000,0000,,Чоши
Dialogue: 0,0:21:27.19,0:21:31.22,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:21:27.19,0:21:31.22,Default,,0000,0000,0000,,Кондиционерден басқа дұрыс жұмыс істемейді
Dialogue: 0,0:21:27.19,0:21:31.22,Default,,0000,0000,0000,,Жотай
Dialogue: 0,0:21:27.19,0:21:31.22,Default,,0000,0000,0000,,Жетілу
Dialogue: 0,0:21:27.19,0:21:31.22,Default,,0000,0000,0000,,Кеме мінсіз жағдайда!
Dialogue: 0,0:21:31.22,0:21:34.19,Default,,0000,0000,0000,,Олардың уақыты келді
Dialogue: 0,0:21:31.22,0:21:34.19,Default,,0000,0000,0000,,Шүгеки
Dialogue: 0,0:21:31.22,0:21:34.19,Default,,0000,0000,0000,,Шабуыл жасайық!
Dialogue: 0,0:21:34.19,0:21:36.19,Default,,0000,0000,0000,,...
Dialogue: 0,0:21:34.19,0:21:36.19,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:21:34.19,0:21:36.19,Default,,0000,0000,0000,,Адъютант Істі араластырмаңыз.
Dialogue: 0,0:21:36.19,0:21:38.20,Default,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:21:36.19,0:21:38.20,Default,,0000,0000,0000,,Әрекеттер орындалды.
Dialogue: 0,0:21:41.17,0:21:44.17,Default,,0000,0000,0000,,
Dialogue: 0,0:21:41.17,0:21:44.17,Default,,0000,0000,0000,,Шизука-чан?
Dialogue: 0,0:21:44.17,0:21:46.20,Default,,0000,0000,0000,,орыс
Dialogue: 0,0:21:44.17,0:21:46.20,Default,,0000,0000,0000,,Иә? Сіз алыстасыз ба?
Dialogue: 0,0:21:46.20,0:21:49.17,Default,,0000,0000,0000,,Бірақ дұрыс
Dialogue: 0,0:21:46.20,0:21:49.17,Default,,0000,0000,0000,,Перделер жабық.
Dialogue: 0,0:21:51.21,0:21:54.18,Default,,0000,0000,0000,,Тек мүшелер қатысса да
Dialogue: 0,0:21:51.21,0:21:54.18,Default,,0000,0000,0000,,Кайги
Dialogue: 0,0:21:51.21,0:21:54.18,Default,,0000,0000,0000,,Кездесуді бастайық.
Dialogue: 0,0:21:56.18,0:21:58.18,Default,,0000,0000,0000,,Ұзын
Dialogue: 0,0:21:56.18,0:21:58.18,Default,,0000,0000,0000,,Қашан келсең де, ұзын баспалдақ.
Dialogue: 0,0:21:58.18,0:22:01.15,Default,,0000,0000,0000,,Олар да
Dialogue: 0,0:21:58.18,0:22:01.15,Default,,0000,0000,0000,,Оны табудың жолы жоқ.
Dialogue: 0,0:22:08.19,0:22:10.26,Default,,0000,0000,0000,,Жарайды. Енді ақыры...
Dialogue: 0,0:22:10.26,0:22:12.20,Default,,0000,0000,0000,,⚞Сәлем! Папи-кун!
Dialogue: 0,0:22:12.20,0:22:14.20,Default,,0000,0000,0000,,Әй, Дораемон-сан!
Dialogue: 0,0:22:14.20,0:22:16.27,Default,,0000,0000,0000,,Баршаңызға қош келдіңіздер.
Dialogue: 0,0:22:16.27,0:22:18.17,Default,,0000,0000,0000,,Бүгін менде жақсы жаңалық бар.
Dialogue: 0,0:22:18.17,0:22:20.17,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:22:20.17,0:22:22.17,Default,,0000,0000,0000,,«Менің де есебім бар».
Dialogue: 0,0:22:22.17,0:22:24.18,Default,,0000,0000,0000,,Міне болды! Бұл Папи!
Dialogue: 0,0:22:24.18,0:22:26.18,Default,,0000,0000,0000,,Бірдеңенің құлап жатқандай дыбыс естідім — бәрі жақсы ма?
Dialogue: 0,0:22:26.18,0:22:28.18,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:22:26.18,0:22:28.18,Default,,0000,0000,0000,,Бір
Dialogue: 0,0:22:26.18,0:22:28.18,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:22:26.18,0:22:28.18,Default,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:22:26.18,0:22:28.18,Default,,0000,0000,0000,,Нақты орынды анықтаңыз!
Dialogue: 0,0:22:26.18,0:22:28.18,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:22:33.22,0:22:36.19,Default,,0000,0000,0000,,Ол азайып барады! ?
Dialogue: 0,0:22:33.22,0:22:36.19,Default,,0000,0000,0000,,Не? Сол құрал!
Dialogue: 0,0:22:36.19,0:22:38.19,Default,,0000,0000,0000,,Орын
Dialogue: 0,0:22:36.19,0:22:38.19,Default,,0000,0000,0000,,Гидзюцу
Dialogue: 0,0:22:36.19,0:22:38.19,Default,,0000,0000,0000,,Бұл бізде жоқ технология!
Dialogue: 0,0:22:38.19,0:22:40.19,Default,,0000,0000,0000,,Кіру….
Dialogue: 0,0:22:40.19,0:22:44.16,Default,,0000,0000,0000,,Бұл президент.
Dialogue: 0,0:22:40.19,0:22:44.16,Default,,0000,0000,0000,,Риндзи Кантей
Dialogue: 0,0:22:40.19,0:22:44.16,Default,,0000,0000,0000,,Демек, бұл уақытша ресми резиденция...
Dialogue: 0,0:22:46.16,0:22:49.20,Default,,0000,0000,0000,,Әй, не болды! ?
Dialogue: 0,0:22:46.16,0:22:49.20,Default,,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:22:46.16,0:22:49.20,Default,,0000,0000,0000,,Барлау шарының батареясы бітті!
Dialogue: 0,0:22:49.20,0:22:51.20,Default,,0000,0000,0000,,Ақымақ!
Dialogue: 0,0:22:51.20,0:22:53.17,Default,,0000,0000,0000,,Мұнда рух бар.
Dialogue: 0,0:22:51.20,0:22:53.17,Default,,0000,0000,0000,,Орналасқан жері анықталды!
Dialogue: 0,0:22:53.17,0:23:00.18,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:00.18,0:23:03.22,Default,,0000,0000,0000,,Оларды бала деп ойлап, менсінбе.
Dialogue: 0,0:23:03.22,0:23:05.18,Default,,0000,0000,0000,,Зенрёку
Dialogue: 0,0:23:03.22,0:23:05.18,Default,,0000,0000,0000,,Бар күшіңізбен күресіңіз!
Dialogue: 0,0:23:03.22,0:23:05.18,Default,,0000,0000,0000,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:23:03.22,0:23:05.18,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:23:07.25,0:23:10.19,Default,,0000,0000,0000,,Пифия туралы
Dialogue: 0,0:23:07.25,0:23:10.19,Default,,0000,0000,0000,,Хаккен
Dialogue: 0,0:23:07.25,0:23:10.19,Default,,0000,0000,0000,,Сіз керемет жаңалық аштыңыз ба?
Dialogue: 0,0:23:10.19,0:23:15.19,Default,,0000,0000,0000,,Миха
Dialogue: 0,0:23:10.19,0:23:15.19,Default,,0000,0000,0000,,Бізді бақылап тұр
Dialogue: 0,0:23:10.19,0:23:15.19,Default,,0000,0000,0000,,Демпа
Dialogue: 0,0:23:10.19,0:23:15.19,Default,,0000,0000,0000,,Мен сол барлау шарының радиотолқындарын тексердім.
Dialogue: 0,0:23:15.19,0:23:18.16,Default,,0000,0000,0000,,Ширей
Dialogue: 0,0:23:15.19,0:23:18.16,Default,,0000,0000,0000,,Сосын сол затқа бұйрық берді.
Dialogue: 0,0:23:15.19,0:23:18.16,Default,,0000,0000,0000,,Хасшинген
Dialogue: 0,0:23:15.19,0:23:18.16,Default,,0000,0000,0000,,Дереккөз...
Dialogue: 0,0:23:18.16,0:23:22.20,Default,,0000,0000,0000,,Оны таптым! ?
Dialogue: 0,0:23:18.16,0:23:22.20,Default,,0000,0000,0000,,Қызғаныш
Dialogue: 0,0:23:18.16,0:23:22.20,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:23:18.16,0:23:22.20,Default,,0000,0000,0000,,Олар арғы тауда тығылды.
Dialogue: 0,0:23:22.20,0:23:25.24,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,0:23:22.20,0:23:25.24,Default,,0000,0000,0000,,Жүр, оны бірден жеңіп алайық!
Dialogue: 0,0:23:25.24,0:23:29.21,Default,,0000,0000,0000,,Юдан
Dialogue: 0,0:23:25.24,0:23:29.21,Default,,0000,0000,0000,,Енді сақтықты түсіретініңізге сенімдімін!
Dialogue: 0,0:23:25.24,0:23:29.21,Default,,0000,0000,0000,,Және...→
Dialogue: 0,0:23:29.21,0:23:31.21,Default,,0000,0000,0000,,Бізде бұл бар!
Dialogue: 0,0:23:31.21,0:23:33.21,Default,,0000,0000,0000,,Назу
Dialogue: 0,0:23:31.21,0:23:33.21,Default,,0000,0000,0000,,Оны Astro Tank деп атаңыз!
Dialogue: 0,0:23:33.21,0:23:35.18,Default,,0000,0000,0000,,О...!
Dialogue: 0,0:23:35.18,0:23:38.22,Default,,0000,0000,0000,,Фильмнің шарықтау шегі үшін
Dialogue: 0,0:23:35.18,0:23:38.22,Default,,0000,0000,0000,,Мен жасадым →
Dialogue: 0,0:23:38.22,0:23:41.19,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:38.22,0:23:41.19,Default,,0000,0000,0000,,Үсеншаға тыйым салу
Dialogue: 0,0:23:38.22,0:23:41.19,Default,,0000,0000,0000,,Әлемдегі ең күшті әмбебап танк!
Dialogue: 0,0:23:43.19,0:23:46.19,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:23:43.19,0:23:46.19,Default,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:23:43.19,0:23:46.19,Default,,0000,0000,0000,,Егер сіз мұны жасасаңыз, сіз ешқашан жеңілмейсіз!
Dialogue: 0,0:23:46.19,0:23:48.19,Default,,0000,0000,0000,,Не істеймін… не істеймін!
Dialogue: 0,0:23:46.19,0:23:48.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:48.19,0:23:53.20,Default,,0000,0000,0000,,Іс жүзінде
Dialogue: 0,0:23:48.19,0:23:53.20,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:23:48.19,0:23:53.20,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:23:48.19,0:23:53.20,Default,,0000,0000,0000,,Шындығында, ол қазір ғана қауіпсіз болды.
Dialogue: 0,0:23:48.19,0:23:53.20,Default,,0000,0000,0000,,Зымыран жөнделді.
Dialogue: 0,0:23:53.20,0:23:57.20,Default,,0000,0000,0000,,Хабарлау дегеніңіз осы болды ма?
Dialogue: 0,0:23:53.20,0:23:57.20,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:23:57.20,0:24:01.21,Default,,0000,0000,0000,,Олай болса, қалғаны маған байланысты.
Dialogue: 0,0:23:57.20,0:24:01.21,Default,,0000,0000,0000,,Сізге тек Жерді тастап кету керек.
Dialogue: 0,0:24:01.21,0:24:04.21,Default,,0000,0000,0000,,Сенкан
Dialogue: 0,0:24:01.21,0:24:04.21,Default,,0000,0000,0000,,Содан кейін Пифияның жауынгерлік кемесі де.
Dialogue: 0,0:24:01.21,0:24:04.21,Default,,0000,0000,0000,,Мені қуып...
Dialogue: 0,0:24:04.21,0:24:06.18,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:24:04.21,0:24:06.18,Default,,0000,0000,0000,,Сулы, папи!
Dialogue: 0,0:24:06.18,0:24:08.21,Default,,0000,0000,0000,,Қуат
Dialogue: 0,0:24:06.18,0:24:08.21,Default,,0000,0000,0000,,Біз сіздің күшіңіз боламыз
Dialogue: 0,0:24:06.18,0:24:08.21,Default,,0000,0000,0000,,Мен саған айтамын!
Dialogue: 0,0:24:08.21,0:24:10.22,Default,,0000,0000,0000,,Сәлем? барлығы!
Dialogue: 0,0:24:10.22,0:24:12.18,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:24:10.22,0:24:12.18,Default,,0000,0000,0000,,Катакиу
Dialogue: 0,0:24:10.22,0:24:12.18,Default,,0000,0000,0000,,Миниатюралық кек!
Dialogue: 0,0:24:12.18,0:24:14.22,Default,,0000,0000,0000,,Сокун
Dialogue: 0,0:24:12.18,0:24:14.22,Default,,0000,0000,0000,,(жүгіру дыбысы)
Dialogue: 0,0:24:14.22,0:24:16.22,Default,,0000,0000,0000,,Бұл ақылсыз! Қайтадан ойлан!
Dialogue: 0,0:24:16.22,0:24:19.22,Default,,0000,0000,0000,,Шуцугеки
Dialogue: 0,0:24:16.22,0:24:19.22,Default,,0000,0000,0000,,Артқы тауға барыңыз!
Dialogue: 0,0:24:19.22,0:24:28.20,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:32.20,0:24:36.21,Default,,0000,0000,0000,,О? Нобита және басқалар
Dialogue: 0,0:24:32.20,0:24:36.21,Default,,0000,0000,0000,,Келесің бе?
Dialogue: 0,0:24:36.21,0:24:39.21,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:24:36.21,0:24:39.21,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:24:36.21,0:24:39.21,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:24:36.21,0:24:39.21,Default,,0000,0000,0000,,Мен дүкен аралайтын болдым.
Dialogue: 0,0:24:39.21,0:24:42.21,Default,,0000,0000,0000,,Дәмді торт бар.
Dialogue: 0,0:24:42.21,0:24:44.18,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:24:46.18,0:24:49.22,Default,,0000,0000,0000,,Папи мырза?
Dialogue: 0,0:24:46.18,0:24:49.22,Default,,0000,0000,0000,,Бәрі қайда кеткені қызық...
Dialogue: 0,0:24:49.22,0:24:51.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:24:52.19,0:24:54.19,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:24:58.20,0:25:00.20,Default,,0000,0000,0000,,
Dialogue: 0,0:24:58.20,0:25:00.20,Default,,0000,0000,0000,,Юушоку
Dialogue: 0,0:24:58.20,0:25:00.20,Default,,0000,0000,0000,,Шизука Кешкі ас алдында→
Dialogue: 0,0:25:00.20,0:25:02.20,Default,,0000,0000,0000,,Ванна
Dialogue: 0,0:25:00.20,0:25:02.20,Default,,0000,0000,0000,,Ваннаға түсу.
Dialogue: 0,0:25:02.20,0:25:05.20,Default,,0000,0000,0000,,Джунбичу
Dialogue: 0,0:25:02.20,0:25:05.20,Default,,0000,0000,0000,,Иә. Қазір дайындалуда!
Dialogue: 0,0:25:02.20,0:25:05.20,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:25:05.20,0:25:16.21,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:16.21,0:25:18.18,Default,,0000,0000,0000,,Терезе
Dialogue: 0,0:25:16.21,0:25:18.18,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:25:16.21,0:25:18.18,Default,,0000,0000,0000,,Ш… Шынында да.
Dialogue: 0,0:25:18.18,0:25:20.19,Default,,0000,0000,0000,,Бірдеңе?
Dialogue: 0,0:25:21.22,0:25:23.26,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:25:23.26,0:25:31.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:31.16,0:25:33.16,Default,,0000,0000,0000,,Жоқ, бұл Пифия! ?
Dialogue: 0,0:25:35.20,0:25:38.20,Default,,0000,0000,0000,,Жоспарланғандай
Dialogue: 0,0:25:35.20,0:25:38.20,Default,,0000,0000,0000,,Саюу
Dialogue: 0,0:25:35.20,0:25:38.20,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:25:35.20,0:25:38.20,Default,,0000,0000,0000,,Како
Dialogue: 0,0:25:35.20,0:25:38.20,Default,,0000,0000,0000,,Мені оң және сол жақтан қоршап ал!
Dialogue: 0,0:25:39.17,0:25:41.21,Default,,0000,0000,0000,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:25:41.21,0:25:46.21,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:46.21,0:25:48.18,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:25:48.18,0:25:51.18,Default,,0000,0000,0000,,Папи! Енді қаша алмайсың!
Dialogue: 0,0:25:51.18,0:25:53.22,Default,,0000,0000,0000,,Акира
Dialogue: 0,0:25:51.18,0:25:53.22,Default,,0000,0000,0000,,Беріңіз де, шығыңыз!
Dialogue: 0,0:25:53.22,0:25:55.19,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Жіберу!
Dialogue: 0,0:25:55.19,0:25:58.19,Default,,0000,0000,0000,,Сол жарық
Dialogue: 0,0:25:55.19,0:25:58.19,Default,,0000,0000,0000,,Мен сізге оны пайдалануға рұқсат ете алмаймын.
Dialogue: 0,0:25:58.19,0:26:00.19,Default,,0000,0000,0000,,Айт. Папи қайда кетті?
Dialogue: 0,0:26:00.19,0:26:02.19,Default,,0000,0000,0000,,Қытай шамы
Dialogue: 0,0:26:00.19,0:26:02.19,Default,,0000,0000,0000,,Директор Дракоруру!
Dialogue: 0,0:26:02.19,0:26:04.20,Default,,0000,0000,0000,,Бұл адам...! ?
Dialogue: 0,0:26:04.20,0:26:07.27,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:26:04.20,0:26:07.27,Default,,0000,0000,0000,,Ғимараттың іші
Dialogue: 0,0:26:04.20,0:26:07.27,Default,,0000,0000,0000,,Ешкім
Dialogue: 0,0:26:04.20,0:26:07.27,Default,,0000,0000,0000,,Ешкім!
Dialogue: 0,0:26:07.27,0:26:10.20,Default,,0000,0000,0000,,Каноджо
Dialogue: 0,0:26:07.27,0:26:10.20,Default,,0000,0000,0000,,Оның жағдайына қарасаңыз
Dialogue: 0,0:26:07.27,0:26:10.20,Default,,0000,0000,0000,,Түсініп көрейік.
Dialogue: 0,0:26:10.20,0:26:12.17,Default,,0000,0000,0000,,Сіз де серіктессіз, солай ма?
Dialogue: 0,0:26:12.17,0:26:14.17,Default,,0000,0000,0000,,Айт! Папи қайда?
Dialogue: 0,0:26:14.17,0:26:17.24,Default,,0000,0000,0000,,Мен білмеймін!
Dialogue: 0,0:26:14.17,0:26:17.24,Default,,0000,0000,0000,,Мен келгенше ол әлдеқашан...
Dialogue: 0,0:26:17.24,0:26:19.18,Default,,0000,0000,0000,,Бұл...!
Dialogue: 0,0:26:17.24,0:26:19.18,Default,,0000,0000,0000,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:26:19.18,0:26:22.18,Default,,0000,0000,0000,,Жоспар
Dialogue: 0,0:26:19.18,0:26:22.18,Default,,0000,0000,0000,,Алыста. Кеме ішіндегі оқиғаны тыңдаңыз.
Dialogue: 0,0:26:22.18,0:26:24.18,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:26:22.18,0:26:24.18,Default,,0000,0000,0000,,Мені ал.
Dialogue: 0,0:26:22.18,0:26:24.18,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:26:24.18,0:26:27.19,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:26:24.18,0:26:27.19,Default,,0000,0000,0000,,Маған ұнамайды...! Жіберу!
Dialogue: 0,0:26:27.19,0:26:29.19,Default,,0000,0000,0000,,Нобита-сан!
Dialogue: 0,0:26:30.16,0:26:32.19,Default,,0000,0000,0000,,Біздің қозғалыстар
Dialogue: 0,0:26:30.16,0:26:32.19,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:26:30.16,0:26:32.19,Default,,0000,0000,0000,,Ол оқылды ма?
Dialogue: 0,0:26:32.19,0:26:34.19,Default,,0000,0000,0000,,Тесшу
Dialogue: 0,0:26:32.19,0:26:34.19,Default,,0000,0000,0000,,Әзірге бас тартайық!
Dialogue: 0,0:26:35.19,0:26:37.20,Default,,0000,0000,0000,,Онда ештеңе жоқ.
Dialogue: 0,0:26:37.20,0:26:40.20,Default,,0000,0000,0000,,Шынымен
Dialogue: 0,0:26:37.20,0:26:40.20,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:26:37.20,0:26:40.20,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:26:37.20,0:26:40.20,Default,,0000,0000,0000,,Орын дұрыс па?
Dialogue: 0,0:26:40.20,0:26:43.27,Default,,0000,0000,0000,,Сағат бұрын
Dialogue: 0,0:26:40.20,0:26:43.27,Default,,0000,0000,0000,,1 сағат бұрын
Dialogue: 0,0:26:40.20,0:26:43.27,Default,,0000,0000,0000,,Мен осында болғаныма сенімдімін...
Dialogue: 0,0:26:43.27,0:26:46.17,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:26:43.27,0:26:46.17,Default,,0000,0000,0000,,Сіз бізді байқағаныңызға сенімдімін.
Dialogue: 0,0:26:43.27,0:26:46.17,Default,,0000,0000,0000,,Ол қашып кетті.
Dialogue: 0,0:26:46.17,0:26:49.17,Default,,0000,0000,0000,,Аба
Dialogue: 0,0:26:46.17,0:26:49.17,Default,,0000,0000,0000,,Ке! Егер сіз зорлық-зомбылық жасасаңыз
Dialogue: 0,0:26:46.17,0:26:49.17,Default,,0000,0000,0000,,Мен солай ойладым.
Dialogue: 0,0:26:49.17,0:26:52.18,Default,,0000,0000,0000,,Елдіандықтар маған бұйрық беріп тұр ма?
Dialogue: 0,0:26:49.17,0:26:52.18,Default,,0000,0000,0000,,...
Dialogue: 0,0:26:49.17,0:26:52.18,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес. Қайтадан барайық.
Dialogue: 0,0:26:52.18,0:26:54.18,Default,,0000,0000,0000,,Екі
Dialogue: 0,0:26:52.18,0:26:54.18,Default,,0000,0000,0000,,(күрсіну)
Dialogue: 0,0:26:54.18,0:26:56.18,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:26:56.18,0:26:59.18,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:26:56.18,0:26:59.18,Default,,0000,0000,0000,,Мұны кім жасады!
Dialogue: 0,0:26:59.18,0:27:01.19,Default,,0000,0000,0000,,Шизука-чан!
Dialogue: 0,0:27:03.29,0:27:05.26,Default,,0000,0000,0000,,⚞ (Сунео) Бұл не? Міне осы!
Dialogue: 0,0:27:08.19,0:27:10.20,Default,,0000,0000,0000,,Жасыру….
Dialogue: 0,0:27:10.20,0:27:12.20,Default,,0000,0000,0000,,Шизукача...!
Dialogue: 0,0:27:14.20,0:27:16.37,Default,,0000,0000,0000,,Гюнюбуро
Dialogue: 0,0:27:14.20,0:27:16.37,Default,,0000,0000,0000,,Бұл сүт ваннасы...
Dialogue: 0,0:27:16.37,0:27:20.21,Default,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:27:16.37,0:27:20.21,Default,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:27:16.37,0:27:20.21,Default,,0000,0000,0000,,«Бүгін кешкі сағат 9-да
Dialogue: 0,0:27:16.37,0:27:20.21,Default,,0000,0000,0000,,Коен
Dialogue: 0,0:27:16.37,0:27:20.21,Default,,0000,0000,0000,,Фунсуи
Dialogue: 0,0:27:16.37,0:27:20.21,Default,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:27:16.37,0:27:20.21,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:27:16.37,0:27:20.21,Default,,0000,0000,0000,,Саябақтағы субұрқақтың басына жалғыз кел».
Dialogue: 0,0:27:20.21,0:27:23.27,Default,,0000,0000,0000,,«Егер келмесең
Dialogue: 0,0:27:20.21,0:27:23.27,Default,,0000,0000,0000,,Хитоджичи
Dialogue: 0,0:27:20.21,0:27:23.27,Default,,0000,0000,0000,,Шоджо
Dialogue: 0,0:27:20.21,0:27:23.27,Default,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:27:20.21,0:27:23.27,Default,,0000,0000,0000,,Барымтадағы қыздың өмірі жоқ».
Dialogue: 0,0:27:23.27,0:27:25.24,Default,,0000,0000,0000,,«Драколу»
Dialogue: 0,0:27:26.21,0:27:30.18,Default,,0000,0000,0000,,Бұл қиын! Дәл осы уақытқа дейін
Dialogue: 0,0:27:26.21,0:27:30.18,Default,,0000,0000,0000,,Шизука-чан сонда болуы керек еді!
Dialogue: 0,0:27:30.18,0:27:33.18,Default,,0000,0000,0000,,Жикен
Dialogue: 0,0:27:30.18,0:27:33.18,Default,,0000,0000,0000,,Мүмкін бірдеңе болатын шығар...!
Dialogue: 0,0:27:34.19,0:27:38.19,Default,,0000,0000,0000,,Папи-кун
Dialogue: 0,0:27:34.19,0:27:38.19,Default,,0000,0000,0000,,Моджи
Dialogue: 0,0:27:34.19,0:27:38.19,Default,,0000,0000,0000,,Бұл Пирика кейіпкері емес пе?
Dialogue: 0,0:27:38.19,0:27:41.19,Default,,0000,0000,0000,,Шынымен! ?
Dialogue: 0,0:27:38.19,0:27:41.19,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:27:38.19,0:27:41.19,Default,,0000,0000,0000,,Онда не айтылған?
Dialogue: 0,0:27:41.19,0:27:45.20,Default,,0000,0000,0000,,Шизука-сан
Dialogue: 0,0:27:41.19,0:27:45.20,Default,,0000,0000,0000,,Мені Пифия тұтқынға алды...
Dialogue: 0,0:27:45.20,0:27:47.20,Default,,0000,0000,0000,,Не?! ?
Dialogue: 0,0:27:47.20,0:27:50.20,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:27:47.20,0:27:50.20,Default,,0000,0000,0000,,Секинин
Dialogue: 0,0:27:47.20,0:27:50.20,Default,,0000,0000,0000,,Мұның бәрі менің жауапкершілігім...!
Dialogue: 0,0:27:50.20,0:27:52.20,Default,,0000,0000,0000,,Жауапкершілік туралы не деуге болады?
Dialogue: 0,0:27:50.20,0:27:52.20,Default,,0000,0000,0000,,Жағдайда
Dialogue: 0,0:27:50.20,0:27:52.20,Default,,0000,0000,0000,,Осыны айтып тұрсыз!
Dialogue: 0,0:27:52.20,0:27:55.21,Default,,0000,0000,0000,,Мен барып көмектесуім керек...!
Dialogue: 0,0:27:52.20,0:27:55.21,Default,,0000,0000,0000,,Түпнұсқа
Dialogue: 0,0:27:52.20,0:27:55.21,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,0:27:52.20,0:27:55.21,Default,,0000,0000,0000,,Бастапқы өлшемге оралайық!
Dialogue: 0,0:27:55.21,0:27:58.18,Default,,0000,0000,0000,,...
Dialogue: 0,0:27:55.21,0:27:58.18,Default,,0000,0000,0000,,Кууу! Енді мейірім жоқ!
Dialogue: 0,0:27:58.18,0:28:01.28,Default,,0000,0000,0000,,Олар үлкен болған кезде
Dialogue: 0,0:27:58.18,0:28:01.28,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:27:58.18,0:28:01.28,Default,,0000,0000,0000,,Цубу
Dialogue: 0,0:27:58.18,0:28:01.28,Default,,0000,0000,0000,,Ұсақталған және езілген...!
Dialogue: 0,0:28:01.28,0:28:03.21,Default,,0000,0000,0000,,Ал кішкентай шамдар ше?
Dialogue: 0,0:28:03.21,0:28:05.18,Default,,0000,0000,0000,,Тауық
Dialogue: 0,0:28:03.21,0:28:05.18,Default,,0000,0000,0000,,Мен оның осы жерде қойылғанына сенімдімін, солай ма?
Dialogue: 0,0:28:05.18,0:28:08.22,Default,,0000,0000,0000,,Пифия алған сияқты...
Dialogue: 0,0:28:08.22,0:28:10.22,Default,,0000,0000,0000,,Не?! ?
Dialogue: 0,0:28:10.22,0:28:14.19,Default,,0000,0000,0000,,Ал... Сонда біз...
Dialogue: 0,0:28:10.22,0:28:14.19,Default,,0000,0000,0000,,Мәңгілікке кішкентай болып қалады! ?
Dialogue: 0,0:28:14.19,0:28:16.19,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:28:16.19,0:28:18.23,Default,,0000,0000,0000,,Қалжың емес!
Dialogue: 0,0:28:18.23,0:28:21.30,Default,,0000,0000,0000,,Бір нәрсе болуы керек! ?
Dialogue: 0,0:28:18.23,0:28:21.30,Default,,0000,0000,0000,,Сіз үнемі әртүрлі нәрселерді шығарасыз!
Dialogue: 0,0:28:21.30,0:28:23.20,Default,,0000,0000,0000,,Ахаха... Ахаха...!
Dialogue: 0,0:28:23.20,0:28:25.20,Default,,0000,0000,0000,,және т.б.
Dialogue: 0,0:28:23.20,0:28:25.20,Default,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:28:23.20,0:28:25.20,Default,,0000,0000,0000,,Басқа құралдармен бұл мүмкін емес!
Dialogue: 0,0:28:25.20,0:28:27.21,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:28:27.21,0:28:30.21,Default,,0000,0000,0000,,Олардан қайтарып алудан басқа амалымыз жоқ.
Dialogue: 0,0:28:27.21,0:28:30.21,Default,,0000,0000,0000,,дейсіз бе?
Dialogue: 0,0:28:30.21,0:28:34.18,Default,,0000,0000,0000,,Бұл сұмдық! Бұл жолы
Dialogue: 0,0:28:30.21,0:28:34.18,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:28:30.21,0:28:34.18,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:28:30.21,0:28:34.18,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:28:30.21,0:28:34.18,Default,,0000,0000,0000,,Мен буксирленгеніме сенімдімін!
Dialogue: 0,0:28:34.18,0:28:36.21,Default,,0000,0000,0000,,Сәлем...!
Dialogue: 0,0:28:36.21,0:28:39.22,Default,,0000,0000,0000,,Ақылға сыймайтын болса да, амалым жоқ...
Dialogue: 0,0:28:39.22,0:28:41.19,Default,,0000,0000,0000,,Мен Шизука-чанға көмектесуім керек...!
Dialogue: 0,0:28:41.19,0:28:44.22,Default,,0000,0000,0000,,Оны жай қалдыруға бола ма...!
Dialogue: 0,0:28:44.22,0:28:48.19,Default,,0000,0000,0000,,Әрине, Нобита-кун.
Dialogue: 0,0:28:44.22,0:28:48.19,Default,,0000,0000,0000,,Енді түсіндің, дем ал.
Dialogue: 0,0:28:48.19,0:28:51.16,Default,,0000,0000,0000,,Бірақ біз қалай күресуіміз керек...
Dialogue: 0,0:28:54.20,0:28:57.17,Default,,0000,0000,0000,,Юджо
Dialogue: 0,0:28:54.20,0:28:57.17,Default,,0000,0000,0000,,Васу
Dialogue: 0,0:28:54.20,0:28:57.17,Default,,0000,0000,0000,,Мен сенің достығыңды ешқашан ұмытпаймын...
Dialogue: 0,0:28:57.17,0:29:02.17,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:29:02.17,0:29:05.18,Default,,0000,0000,0000,,Менің резервуарымды өзгерте аласыз ба?
Dialogue: 0,0:29:05.18,0:29:08.18,Default,,0000,0000,0000,,Өйткені, бұл жалғыз нұсқа...
Dialogue: 0,0:29:13.18,0:29:16.19,Default,,0000,0000,0000,,Қалай өзгертуге болады
Dialogue: 0,0:29:13.18,0:29:16.19,Default,,0000,0000,0000,,Дулыға сізге ой салады.
Dialogue: 0,0:29:16.19,0:29:19.19,Default,,0000,0000,0000,,Тебукуро
Dialogue: 0,0:29:16.19,0:29:19.19,Default,,0000,0000,0000,,Қолғаптар
Dialogue: 0,0:29:16.19,0:29:19.19,Default,,0000,0000,0000,,Юбисаки
Dialogue: 0,0:29:16.19,0:29:19.19,Default,,0000,0000,0000,,Когу
Dialogue: 0,0:29:16.19,0:29:19.19,Default,,0000,0000,0000,,Саусақ ұштары әртүрлі құралға айналуы мүмкін→
Dialogue: 0,0:29:19.19,0:29:21.19,Default,,0000,0000,0000,,Қосақу
Dialogue: 0,0:29:19.19,0:29:21.19,Default,,0000,0000,0000,,Кез келген қолөнермен айналыса алады.
Dialogue: 0,0:29:21.19,0:29:23.19,Default,,0000,0000,0000,,Бұл қанша тұрады?
Dialogue: 0,0:29:23.19,0:29:25.20,Default,,0000,0000,0000,,Iso
Dialogue: 0,0:29:23.19,0:29:25.20,Default,,0000,0000,0000,,сәйкес
Dialogue: 0,0:29:23.19,0:29:25.20,Default,,0000,0000,0000,,Қанша асықсақ та түн болады.
Dialogue: 0,0:29:25.20,0:29:28.20,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:29:25.20,0:29:28.20,Default,,0000,0000,0000,,Юхан
Dialogue: 0,0:29:25.20,0:29:28.20,Default,,0000,0000,0000,,Мен кешкі асқа дейін үйде болуым керек →
Dialogue: 0,0:29:28.20,0:29:30.20,Default,,0000,0000,0000,,Шинпай
Dialogue: 0,0:29:28.20,0:29:30.20,Default,,0000,0000,0000,,Мен анамды уайымдаймын...
Dialogue: 0,0:29:30.20,0:29:33.17,Default,,0000,0000,0000,,Банмеши
Dialogue: 0,0:29:30.20,0:29:33.17,Default,,0000,0000,0000,,Кешкі ас және Шизука-чан
Dialogue: 0,0:29:30.20,0:29:33.17,Default,,0000,0000,0000,,Даидзи
Dialogue: 0,0:29:30.20,0:29:33.17,Default,,0000,0000,0000,,Қайсысы маңыздырақ!
Dialogue: 0,0:29:33.17,0:29:36.17,Default,,0000,0000,0000,,Кейінірек уақыт машинасында
Dialogue: 0,0:29:33.17,0:29:36.17,Default,,0000,0000,0000,,Югата
Dialogue: 0,0:29:33.17,0:29:36.17,Default,,0000,0000,0000,,Кешке қайтуыңызға болады.
Dialogue: 0,0:29:36.17,0:29:39.18,Default,,0000,0000,0000,,О.
Dialogue: 0,0:29:36.17,0:29:39.18,Default,,0000,0000,0000,,Уақыт қымбат.
Dialogue: 0,0:29:36.17,0:29:39.18,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,0:29:36.17,0:29:39.18,Default,,0000,0000,0000,,Бірден бастайық.
Dialogue: 0,0:29:39.18,0:29:41.18,Default,,0000,0000,0000,,Садьё
Dialogue: 0,0:29:39.18,0:29:41.18,Default,,0000,0000,0000,,Кайши
Dialogue: 0,0:29:39.18,0:29:41.18,Default,,0000,0000,0000,,Өзгерту жұмысы басталады!
Dialogue: 0,0:29:39.18,0:29:41.18,Default,,0000,0000,0000,,Мен ол жігітке ештеңе істей алмаймын
Dialogue: 0,0:29:45.22,0:29:47.19,Default,,0000,0000,0000,,(Куроның айқайы)
Dialogue: 0,0:29:48.19,0:29:50.16,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:29:48.19,0:29:50.16,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:29:52.19,0:29:56.19,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:29:52.19,0:29:56.19,Default,,0000,0000,0000,,Хоньяку
Dialogue: 0,0:29:52.19,0:29:56.19,Default,,0000,0000,0000,,Бұл аударма желе.
Dialogue: 0,0:29:56.19,0:29:58.20,Default,,0000,0000,0000,,Менің не айтып тұрғанымды түсіне аласыз ба?
Dialogue: 0,0:30:00.20,0:30:02.20,Default,,0000,0000,0000,,Канрио
Dialogue: 0,0:30:00.20,0:30:02.20,Default,,0000,0000,0000,,Өзгерту жұмыстары аяқталды!
Dialogue: 0,0:30:02.20,0:30:04.20,Default,,0000,0000,0000,,Кабина да салынды...
Dialogue: 0,0:30:04.20,0:30:06.20,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:30:04.20,0:30:06.20,Default,,0000,0000,0000,,Сіз Шизука-чанға көмектесе аласыз!
Dialogue: 0,0:30:06.20,0:30:09.17,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:30:06.20,0:30:09.17,Default,,0000,0000,0000,,Жарайды, кеттік!
Dialogue: 0,0:30:09.17,0:30:11.18,Default,,0000,0000,0000,,Мен ол жігітке ештеңе істей алмаймын
Dialogue: 0,0:30:11.18,0:30:13.18,Default,,0000,0000,0000,,Сонда қайда бара жатырсың?
Dialogue: 0,0:30:14.18,0:30:16.21,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:30:16.21,0:30:18.22,Default,,0000,0000,0000,,Не? А...?
Dialogue: 0,0:30:18.22,0:30:21.19,Default,,0000,0000,0000,,Мен оның қайда екенін де білмеймін
Dialogue: 0,0:30:18.22,0:30:21.19,Default,,0000,0000,0000,,Сұрыптайтын ақымақтар қайда!
Dialogue: 0,0:30:21.19,0:30:24.19,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:30:21.19,0:30:24.19,Default,,0000,0000,0000,,Папи-кун да кетті...
Dialogue: 0,0:30:24.19,0:30:27.16,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:30:24.19,0:30:27.16,Default,,0000,0000,0000,,Мен ғана қашып кеткен шығармын...
Dialogue: 0,0:30:27.16,0:30:29.26,Default,,0000,0000,0000,,Солай ма? !
Dialogue: 0,0:30:27.16,0:30:29.26,Default,,0000,0000,0000,,Эй...!
Dialogue: 0,0:30:29.26,0:30:35.27,Default,,0000,0000,0000,,⚟ (Ұшу дыбысы)
Dialogue: 0,0:30:37.20,0:30:39.30,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:30:37.20,0:30:39.30,Default,,0000,0000,0000,,Вааах!
Dialogue: 0,0:30:39.30,0:30:41.27,Default,,0000,0000,0000,,Міне! !
