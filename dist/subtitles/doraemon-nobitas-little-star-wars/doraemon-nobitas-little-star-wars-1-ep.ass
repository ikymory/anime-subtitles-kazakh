Dialogue: 0,0:34:59.23,0:35:03.20,Default,,0000,0000,0000,,Бомбалау тоқтатылды! Іске қосуға дайын!
Dialogue: 0,0:34:59.23,0:35:03.20,Default,,0000,0000,0000,,Рёкай
Dialogue: 0,0:34:59.23,0:35:03.20,Default,,0000,0000,0000,,Польнарефф?
Dialogue: 0,0:35:03.20,0:35:06.20,Default,,0000,0000,0000,,Техай
Dialogue: 0,0:35:03.20,0:35:06.20,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:35:03.20,0:35:06.20,Default,,0000,0000,0000,,Барлау шарын ұйымдастыруды ұмытпаңыз! ?
Dialogue: 0,0:35:03.20,0:35:06.20,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:35:06.20,0:35:10.27,Default,,0000,0000,0000,,Папи
Dialogue: 0,0:35:06.20,0:35:10.27,Default,,0000,0000,0000,,Көп
Dialogue: 0,0:35:06.20,0:35:10.27,Default,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:35:06.20,0:35:10.27,Default,,0000,0000,0000,,Мені тамақтандырғаның үшін жарайсың!
Dialogue: 0,0:35:10.27,0:35:13.21,Default,,0000,0000,0000,,Ол қалай өтірік айта алды?
Dialogue: 0,0:35:10.27,0:35:13.21,Default,,0000,0000,0000,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:35:13.21,0:35:16.21,Default,,0000,0000,0000,,Достар
Dialogue: 0,0:35:13.21,0:35:16.21,Default,,0000,0000,0000,,Барлығы Папидің достары туралы.
Dialogue: 0,0:35:13.21,0:35:16.21,Default,,0000,0000,0000,,Кекка
Dialogue: 0,0:35:13.21,0:35:16.21,Default,,0000,0000,0000,,Бұл бағаламаудың нәтижесі...
Dialogue: 0,0:35:16.21,0:35:19.22,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:35:16.21,0:35:19.22,Default,,0000,0000,0000,,Сіз кешіктіңіз! Оны әлі шығара алмайсыз ба? ?
Dialogue: 0,0:35:19.22,0:35:22.19,Default,,0000,0000,0000,,Тасымалдау
Dialogue: 0,0:35:19.22,0:35:22.19,Default,,0000,0000,0000,,Директор Пирикадан хат.
Dialogue: 0,0:35:19.22,0:35:22.19,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:35:22.19,0:35:24.19,Default,,0000,0000,0000,,Мұны қалдырыңыз!
Dialogue: 0,0:35:24.19,0:35:27.16,Default,,0000,0000,0000,,Жоқ... мені байла.
Dialogue: 0,0:35:24.19,0:35:27.16,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:35:29.29,0:35:31.26,Default,,0000,0000,0000,,Генерал Гилмордан...
Dialogue: 0,0:35:32.20,0:35:35.20,Default,,0000,0000,0000,,(LocoRoco айқайы)
Dialogue: 0,0:35:35.20,0:35:38.17,Default,,0000,0000,0000,,Құрметті Папи~
Dialogue: 0,0:35:35.20,0:35:38.17,Default,,0000,0000,0000,,Аман болыңыз!
Dialogue: 0,0:35:39.20,0:35:41.17,Default,,0000,0000,0000,,Түсіндім. Түсіндім.
Dialogue: 0,0:35:39.20,0:35:41.17,Default,,0000,0000,0000,,Тоқта...
Dialogue: 0,0:35:41.17,0:35:43.21,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:35:43.21,0:35:46.21,Default,,0000,0000,0000,,​​Барлығыңызға рахмет!
Dialogue: 0,0:35:46.21,0:35:49.21,Default,,0000,0000,0000,,I
Dialogue: 0,0:35:46.21,0:35:49.21,Default,,0000,0000,0000,,Нидо
Dialogue: 0,0:35:46.21,0:35:49.21,Default,,0000,0000,0000,,Мен енді үйге бара алмаймын деп ойлаймын...
Dialogue: 0,0:35:49.21,0:35:53.22,Default,,0000,0000,0000,,Нағыз коннякумен
Dialogue: 0,0:35:49.21,0:35:53.22,Default,,0000,0000,0000,,Мен Папи-кунның қайда бара жатқанын білдім.
Dialogue: 0,0:35:53.22,0:35:56.19,Default,,0000,0000,0000,,Ханджурёку Сочи
Dialogue: 0,0:35:53.22,0:35:56.19,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:35:53.22,0:35:56.19,Default,,0000,0000,0000,,Ауырлық күшіне қарсы құрылғыны кім орнатты?
Dialogue: 0,0:35:53.22,0:35:56.19,Default,,0000,0000,0000,,Бұл Сунеоның идеясы болды.
Dialogue: 0,0:35:56.19,0:35:59.19,Default,,0000,0000,0000,,А-а... жай ғана шертті.
Dialogue: 0,0:35:59.19,0:36:01.19,Default,,0000,0000,0000,,...
Dialogue: 0,0:35:59.19,0:36:01.19,Default,,0000,0000,0000,,Сора
Dialogue: 0,0:35:59.19,0:36:01.19,Default,,0000,0000,0000,,Аспаннан келе жатқан танктер
Dialogue: 0,0:35:59.19,0:36:01.19,Default,,0000,0000,0000,,Сіз олай ойламайсыз, солай ма?
Dialogue: 0,0:36:01.19,0:36:03.26,Default,,0000,0000,0000,,Мен өзімді сергек сезіндім!
Dialogue: 0,0:36:03.26,0:36:06.20,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:36:03.26,0:36:06.20,Default,,0000,0000,0000,,Мубу
Dialogue: 0,0:36:03.26,0:36:06.20,Default,,0000,0000,0000,,Сіз соншалықты абайсызда бірдеңе жасадыңыз ба?
Dialogue: 0,0:36:06.20,0:36:09.20,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:36:06.20,0:36:09.20,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:36:06.20,0:36:09.20,Default,,0000,0000,0000,,Мен сенен маған көмек сұраған жоқпын!
Dialogue: 0,0:36:09.20,0:36:12.17,Default,,0000,0000,0000,,Джин
Dialogue: 0,0:36:09.20,0:36:12.17,Default,,0000,0000,0000,,Не! Пирика халқы
Dialogue: 0,0:36:09.20,0:36:12.17,Default,,0000,0000,0000,,Мен бұл туралы білмеймін →
Dialogue: 0,0:36:12.17,0:36:15.17,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:36:12.17,0:36:15.17,Default,,0000,0000,0000,,Мису
Dialogue: 0,0:36:12.17,0:36:15.17,Default,,0000,0000,0000,,Мен достарымды тастамаймын!
Dialogue: 0,0:36:15.17,0:36:17.18,Default,,0000,0000,0000,,Осыған байланысты сіз →
Dialogue: 0,0:36:17.18,0:36:20.18,Default,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:36:17.18,0:36:20.18,Default,,0000,0000,0000,,Толығымен Пифия
Dialogue: 0,0:36:17.18,0:36:20.18,Default,,0000,0000,0000,,Мен оларды жауға айналдырдым.
Dialogue: 0,0:36:20.18,0:36:22.18,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:36:20.18,0:36:22.18,Default,,0000,0000,0000,,Олар әу бастан жау болған!
Dialogue: 0,0:36:22.18,0:36:25.18,Default,,0000,0000,0000,,Өте орынды.
Dialogue: 0,0:36:22.18,0:36:25.18,Default,,0000,0000,0000,,Орындау
Dialogue: 0,0:36:22.18,0:36:25.18,Default,,0000,0000,0000,,Сейкоу
Dialogue: 0,0:36:22.18,0:36:25.18,Default,,0000,0000,0000,,Операция сәтті өтті...
Dialogue: 0,0:36:25.18,0:36:27.18,Default,,0000,0000,0000,,Бұл соңы емес.
Dialogue: 0,0:36:27.18,0:36:29.19,Default,,0000,0000,0000,,Бұл жер де
Dialogue: 0,0:36:27.18,0:36:29.19,Default,,0000,0000,0000,,Оларға белгілі.
Dialogue: 0,0:36:29.19,0:36:31.16,Default,,0000,0000,0000,,Иккоку
Dialogue: 0,0:36:29.19,0:36:31.16,Default,,0000,0000,0000,,Бізге тезірек қашу керек...
Dialogue: 0,0:36:31.16,0:36:33.19,Default,,0000,0000,0000,,О.
Dialogue: 0,0:36:31.16,0:36:33.19,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:36:31.16,0:36:33.19,Default,,0000,0000,0000,,Түсіндім, сабыр етіңіз.
Dialogue: 0,0:36:33.19,0:36:36.19,Default,,0000,0000,0000,,Мен түсінбеймін!
Dialogue: 0,0:36:33.19,0:36:36.19,Default,,0000,0000,0000,,О, түсіндім!
Dialogue: 0,0:36:36.19,0:36:38.20,Default,,0000,0000,0000,,Не істеу керек!
Dialogue: 0,0:36:36.19,0:36:38.20,Default,,0000,0000,0000,,Ұрысты тоқтатыңыз!
Dialogue: 0,0:36:38.20,0:36:42.17,Default,,0000,0000,0000,,Балалар сендер ештеңе түсінбейсіңдер.
Dialogue: 0,0:36:38.20,0:36:42.17,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:36:38.20,0:36:42.17,Default,,0000,0000,0000,,Пифияның сұмдығы...
Dialogue: 0,0:36:42.17,0:36:45.17,Default,,0000,0000,0000,,
Dialogue: 0,0:36:42.17,0:36:45.17,Default,,0000,0000,0000,,«Хахахаха... Дұрыс.»
Dialogue: 0,0:36:46.17,0:36:48.17,Default,,0000,0000,0000,,Не? Не?
Dialogue: 0,0:36:46.17,0:36:48.17,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:36:48.17,0:36:50.27,Default,,0000,0000,0000,,«Күтілгендей, Президент мырза».
Dialogue: 0,0:36:50.27,0:36:52.18,Default,,0000,0000,0000,,Дракоруру!
Dialogue: 0,0:36:52.18,0:36:55.18,Default,,0000,0000,0000,,Хонрай
Dialogue: 0,0:36:52.18,0:36:55.18,Default,,0000,0000,0000,,«Бастапқыда,
Dialogue: 0,0:36:52.18,0:36:55.18,Default,,0000,0000,0000,,Дему
Dialogue: 0,0:36:52.18,0:36:55.18,Default,,0000,0000,0000,,Мен сонда бара жатыр едім→
Dialogue: 0,0:36:55.18,0:36:58.22,Default,,0000,0000,0000,,Тайсецу
Dialogue: 0,0:36:55.18,0:36:58.22,Default,,0000,0000,0000,,Шұқығыш
Dialogue: 0,0:36:55.18,0:36:58.22,Default,,0000,0000,0000,,Менің маңызды бір ісім бар».
Dialogue: 0,0:36:58.22,0:37:01.19,Default,,0000,0000,0000,,Хитоши Саки
Dialogue: 0,0:36:58.22,0:37:01.19,Default,,0000,0000,0000,,«Бір қадам алға
Dialogue: 0,0:36:58.22,0:37:01.19,Default,,0000,0000,0000,,Мен Пирикаға оралуды шештім».
Dialogue: 0,0:37:01.19,0:37:04.19,Default,,0000,0000,0000,,«Бұл кішкентай шам
Dialogue: 0,0:37:01.19,0:37:04.19,Default,,0000,0000,0000,,Үйге апарыңыз→
Dialogue: 0,0:37:04.19,0:37:06.19,Default,,0000,0000,0000,,Маған біраз зерттеу жүргізуге рұқсат етіңіз».
Dialogue: 0,0:37:06.19,0:37:09.16,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:37:06.19,0:37:09.16,Default,,0000,0000,0000,,Ұры
Dialogue: 0,0:37:06.19,0:37:09.16,Default,,0000,0000,0000,,Бұл менікі! Қайтарыңыз, ұры!
Dialogue: 0,0:37:09.16,0:37:11.20,Default,,0000,0000,0000,,«Ал, Президент мырза, сізге→
Dialogue: 0,0:37:11.20,0:37:15.20,Default,,0000,0000,0000,,Жасау
Dialogue: 0,0:37:11.20,0:37:15.20,Default,,0000,0000,0000,,Жақында
Dialogue: 0,0:37:11.20,0:37:15.20,Default,,0000,0000,0000,,Тайканшики
Dialogue: 0,0:37:11.20,0:37:15.20,Default,,0000,0000,0000,,Шуссеки
Dialogue: 0,0:37:11.20,0:37:15.20,Default,,0000,0000,0000,,Мен сіздің тәж кию рәсіміне қатысуыңызды қалаймын».
Dialogue: 0,0:37:15.20,0:37:17.20,Default,,0000,0000,0000,,Бұл тәж кию! ?
Dialogue: 0,0:37:17.20,0:37:19.17,Default,,0000,0000,0000,,Бұл Гилмор болуы мүмкін бе?
Dialogue: 0,0:37:19.17,0:37:22.17,Default,,0000,0000,0000,,Тәж кию?
Dialogue: 0,0:37:19.17,0:37:22.17,Default,,0000,0000,0000,,Усама
Dialogue: 0,0:37:19.17,0:37:22.17,Default,,0000,0000,0000,,Гилмор өзін король → дейді
Dialogue: 0,0:37:22.17,0:37:25.21,Default,,0000,0000,0000,,Керемет
Dialogue: 0,0:37:22.17,0:37:25.21,Default,,0000,0000,0000,,Сенген
Dialogue: 0,0:37:22.17,0:37:25.21,Default,,0000,0000,0000,,Мен үлкен хабарландыру жасаймын.
Dialogue: 0,0:37:25.21,0:37:28.21,Default,,0000,0000,0000,,Ақымақ! Пирика халқы
Dialogue: 0,0:37:25.21,0:37:28.21,Default,,0000,0000,0000,,Мито
Dialogue: 0,0:37:25.21,0:37:28.21,Default,,0000,0000,0000,,Мен мұны мойындамаймын!
Dialogue: 0,0:37:28.21,0:37:30.25,Default,,0000,0000,0000,,«Мен мойындаймын».
Dialogue: 0,0:37:30.25,0:37:34.22,Default,,0000,0000,0000,,Адамдар
Dialogue: 0,0:37:30.25,0:37:34.22,Default,,0000,0000,0000,,Шинраиацу
Dialogue: 0,0:37:30.25,0:37:34.22,Default,,0000,0000,0000,,«Себебі адамдар бізге сенеді».
Dialogue: 0,0:37:30.25,0:37:34.22,Default,,0000,0000,0000,,Мизука
Dialogue: 0,0:37:30.25,0:37:34.22,Default,,0000,0000,0000,,Президент Папидің өзі →
Dialogue: 0,0:37:34.22,0:37:37.19,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:37:34.22,0:37:37.19,Default,,0000,0000,0000,,Мен генералға бас иемін».
Dialogue: 0,0:37:37.19,0:37:39.16,Default,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:37:37.19,0:37:39.16,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:37:39.16,0:37:42.19,Default,,0000,0000,0000,,«Бұл туралы ше? Мынаны қараңыз."
Dialogue: 0,0:37:39.16,0:37:42.19,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,0:37:39.16,0:37:42.19,Default,,0000,0000,0000,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:37:42.19,0:37:45.20,Default,,0000,0000,0000,,Ах, Пиина-нисан….
Dialogue: 0,0:37:42.19,0:37:45.20,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:37:45.20,0:37:47.20,Default,,0000,0000,0000,,«Ол қазір
Dialogue: 0,0:37:45.20,0:37:47.20,Default,,0000,0000,0000,,Бұл біздің қолымызда».
Dialogue: 0,0:37:47.20,0:37:50.27,Default,,0000,0000,0000,,«Мұны ұмытпа»
Dialogue: 0,0:37:50.27,0:37:53.24,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:37:50.27,0:37:53.24,Default,,0000,0000,0000,,«Олай болса мен сені тағы да тәж кигізу рәсімінде көремін».
Dialogue: 0,0:37:55.24,0:37:57.24,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:37:58.18,0:38:00.18,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:38:00.18,0:38:03.18,Default,,0000,0000,0000,,Пиина мырза
Dialogue: 0,0:38:00.18,0:38:03.18,Default,,0000,0000,0000,,Папидің әпкесі?
Dialogue: 0,0:38:03.18,0:38:05.22,Default,,0000,0000,0000,,Отбасы
Dialogue: 0,0:38:03.18,0:38:05.22,Default,,0000,0000,0000,,Бір ғана отбасы.
Dialogue: 0,0:38:05.22,0:38:08.19,Default,,0000,0000,0000,,I
Dialogue: 0,0:38:05.22,0:38:08.19,Default,,0000,0000,0000,,Емдеу құралы
Dialogue: 0,0:38:05.22,0:38:08.19,Default,,0000,0000,0000,,Себебі мен қажетсіз нәрсе жасадым...
Dialogue: 0,0:38:08.19,0:38:11.19,Default,,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,0:38:08.19,0:38:11.19,Default,,0000,0000,0000,,Барлығы менің жауапкершілігімде.
Dialogue: 0,0:38:11.19,0:38:13.19,Default,,0000,0000,0000,,Оған ешкім кінәлі емес.
Dialogue: 0,0:38:13.19,0:38:16.19,Default,,0000,0000,0000,,Мәселе мынада
Dialogue: 0,0:38:13.19,0:38:16.19,Default,,0000,0000,0000,,Енді не істейміз?
Dialogue: 0,0:38:16.19,0:38:20.20,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:38:16.19,0:38:20.20,Default,,0000,0000,0000,,Бұл қазірдің өзінде шешілді.
Dialogue: 0,0:38:16.19,0:38:20.20,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:38:16.19,0:38:20.20,Default,,0000,0000,0000,,Тек оларды ұрып таста.
Dialogue: 0,0:38:20.20,0:38:22.20,Default,,0000,0000,0000,,Мәметсубу
Dialogue: 0,0:38:20.20,0:38:22.20,Default,,0000,0000,0000,,Бұршақ тәрізді денесі бар ма?
Dialogue: 0,0:38:22.20,0:38:25.20,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:38:22.20,0:38:25.20,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:38:22.20,0:38:25.20,Default,,0000,0000,0000,,Ол жақта да солай емес пе?
Dialogue: 0,0:38:25.20,0:38:28.17,Default,,0000,0000,0000,,Екінші тарап
Dialogue: 0,0:38:25.20,0:38:28.17,Default,,0000,0000,0000,,Дайгундан
Dialogue: 0,0:38:25.20,0:38:28.17,Default,,0000,0000,0000,,Бұл тіпті ғарыш кемесі бар үлкен армия ма?
Dialogue: 0,0:38:28.17,0:38:32.18,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:38:28.17,0:38:32.18,Default,,0000,0000,0000,,Гил, мен бірдеңені үрлеуім керек.
Dialogue: 0,0:38:28.17,0:38:32.18,Default,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:38:28.17,0:38:32.18,Default,,0000,0000,0000,,Менің көңілім толмайды!
Dialogue: 0,0:38:32.18,0:38:34.21,Default,,0000,0000,0000,,Бұл тәртіпсіздік!
Dialogue: 0,0:38:34.21,0:38:37.18,Default,,0000,0000,0000,,Reisei
Dialogue: 0,0:38:34.21,0:38:37.18,Default,,0000,0000,0000,,Осы жерде тынышталайық.
Dialogue: 0,0:38:34.21,0:38:37.18,Default,,0000,0000,0000,,Сәлем, Шидзука-чан?
Dialogue: 0,0:38:38.22,0:38:41.19,Default,,0000,0000,0000,,Күрделі
Dialogue: 0,0:38:38.22,0:38:41.19,Default,,0000,0000,0000,,Қиын болса да
Dialogue: 0,0:38:38.22,0:38:41.19,Default,,0000,0000,0000,,Папиге көмектесе алсам →
Dialogue: 0,0:38:41.19,0:38:43.15,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:38:45.12,0:38:47.12,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:38:45.12,0:38:47.12,Default,,0000,0000,0000,,Жол
Dialogue: 0,0:38:45.12,0:38:47.12,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:38:45.12,0:38:47.12,Default,,0000,0000,0000,,Егер сіз жеңе алсаңыз, бір ғана жол бар.
Dialogue: 0,0:38:47.12,0:38:50.13,Default,,0000,0000,0000,,Пирика планетасына барыңыз
Dialogue: 0,0:38:47.12,0:38:50.13,Default,,0000,0000,0000,,Кішкентай шамды қайтарыңыз.
Dialogue: 0,0:38:50.13,0:38:53.13,Default,,0000,0000,0000,,Джурёкукен
Dialogue: 0,0:38:50.13,0:38:53.13,Default,,0000,0000,0000,,Ридацу
Dialogue: 0,0:38:50.13,0:38:53.13,Default,,0000,0000,0000,,Какунин
Dialogue: 0,0:38:50.13,0:38:53.13,Default,,0000,0000,0000,,Гравитациялық өрістен шығу Бекіту.
Dialogue: 0,0:38:53.13,0:38:56.17,Default,,0000,0000,0000,,Қаптаманы дайындау аяқталды.
Dialogue: 0,0:38:56.17,0:38:59.14,Default,,0000,0000,0000,,«Жақында
Dialogue: 0,0:38:56.17,0:38:59.14,Default,,0000,0000,0000,,Анықтама
Dialogue: 0,0:38:56.17,0:38:59.14,Default,,0000,0000,0000,,Гиперкеңістікке кіру».
Dialogue: 0,0:38:59.14,0:39:01.14,Default,,0000,0000,0000,,«Бүгіну»
Dialogue: 0,0:39:01.14,0:39:08.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:39:08.15,0:39:11.15,Default,,0000,0000,0000,,Папи мырза дәл солай.
Dialogue: 0,0:39:08.15,0:39:11.15,Default,,0000,0000,0000,,Сіз кез келген нәрсені жасай аласыз, солай ма?
Dialogue: 0,0:39:11.15,0:39:14.19,Default,,0000,0000,0000,,Жоғарғы
Dialogue: 0,0:39:11.15,0:39:14.19,Default,,0000,0000,0000,,Біреудің қиналғанын көргенде
Dialogue: 0,0:39:11.15,0:39:14.19,Default,,0000,0000,0000,,Хо
Dialogue: 0,0:39:11.15,0:39:14.19,Default,,0000,0000,0000,,Мен оны жалғыз қалдыра алмаймын.
Dialogue: 0,0:39:14.19,0:39:18.16,Default,,0000,0000,0000,,Папи не ойлайды?
Dialogue: 0,0:39:14.19,0:39:18.16,Default,,0000,0000,0000,,Фуку
Dialogue: 0,0:39:14.19,0:39:18.16,Default,,0000,0000,0000,,Шексіз үрлеу→
Dialogue: 0,0:39:18.16,0:39:22.16,Default,,0000,0000,0000,,Хатсу
Dialogue: 0,0:39:18.16,0:39:22.16,Default,,0000,0000,0000,,Сіз бұл туралы білмей тұрып, бұл Пирика планетасында бірінші рет.
Dialogue: 0,0:39:18.16,0:39:22.16,Default,,0000,0000,0000,,Шонен
Dialogue: 0,0:39:18.16,0:39:22.16,Default,,0000,0000,0000,,Ол бала президент болды!
Dialogue: 0,0:39:22.16,0:39:24.16,Default,,0000,0000,0000,,...Сондықтан.
Dialogue: 0,0:39:24.16,0:39:26.16,Default,,0000,0000,0000,,Очига
Dialogue: 0,0:39:24.16,0:39:26.16,Default,,0000,0000,0000,,Менен мүлдем өзгеше.
Dialogue: 0,0:39:26.16,0:39:29.17,Default,,0000,0000,0000,,Кешенді оқыту
Dialogue: 0,0:39:26.16,0:39:29.17,Default,,0000,0000,0000,,Ол шын мәнінде керемет адам.
Dialogue: 0,0:39:26.16,0:39:29.17,Default,,0000,0000,0000,,Керемет Керемет.
Dialogue: 0,0:39:29.17,0:39:33.17,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:39:29.17,0:39:33.17,Default,,0000,0000,0000,,Тошигоро
Dialogue: 0,0:39:29.17,0:39:33.17,Default,,0000,0000,0000,,Бірақ мен сенімен құрдаспын.
Dialogue: 0,0:39:29.17,0:39:33.17,Default,,0000,0000,0000,,Орын
Dialogue: 0,0:39:29.17,0:39:33.17,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:39:29.17,0:39:33.17,Default,,0000,0000,0000,,Бұл ұл бала.
Dialogue: 0,0:39:33.17,0:39:35.14,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:39:35.14,0:39:38.18,Default,,0000,0000,0000,,Хитоджичи
Dialogue: 0,0:39:35.14,0:39:38.18,Default,,0000,0000,0000,,Тіпті әпкең де кепілге алынған...
Dialogue: 0,0:39:38.18,0:39:42.18,Default,,0000,0000,0000,,Біз Папи-кунның күшіне сүйенеміз
Dialogue: 0,0:39:38.18,0:39:42.18,Default,,0000,0000,0000,,Сіз үйрендіңіз бе?
Dialogue: 0,0:39:42.18,0:39:44.18,Default,,0000,0000,0000,,Әрине!
Dialogue: 0,0:39:44.18,0:39:46.15,Default,,0000,0000,0000,,Ичимоку Рёзен
Dialogue: 0,0:39:44.18,0:39:46.15,Default,,0000,0000,0000,,Папи-самаға қазір қарасаңыз, анық!
Dialogue: 0,0:39:46.15,0:39:49.15,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:39:46.15,0:39:49.15,Default,,0000,0000,0000,,Осындай жанды көрініс
Dialogue: 0,0:39:46.15,0:39:49.15,Default,,0000,0000,0000,,Мен оны бірінші рет көріп тұрмын!
Dialogue: 0,0:39:49.15,0:39:51.16,Default,,0000,0000,0000,,Жанды ма?
Dialogue: 0,0:39:51.16,0:39:53.16,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:39:51.16,0:39:53.16,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:39:53.16,0:39:57.19,Default,,0000,0000,0000,,Сізде қаншалықты достық бар?
Dialogue: 0,0:39:53.16,0:39:57.19,Default,,0000,0000,0000,,Олар сен үшін қатты уайымдады.
Dialogue: 0,0:39:53.16,0:39:57.19,Default,,0000,0000,0000,,Папи-саманы қолдайсыз ба?
Dialogue: 0,0:39:57.19,0:40:00.16,Default,,0000,0000,0000,,Henpi
Dialogue: 0,0:39:57.19,0:40:00.16,Default,,0000,0000,0000,,Мен сондай шалғай планетадамын...
Dialogue: 0,0:39:57.19,0:40:00.16,Default,,0000,0000,0000,,Шицурей
Dialogue: 0,0:39:57.19,0:40:00.16,Default,,0000,0000,0000,,Толқу
Dialogue: 0,0:39:57.19,0:40:00.16,Default,,0000,0000,0000,,Ах, кешіріңіз. Алыс планетада...
Dialogue: 0,0:40:00.16,0:40:02.13,Default,,0000,0000,0000,,Бұл ұзаққа созылатын сияқты.
Dialogue: 0,0:40:00.16,0:40:02.13,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:40:06.17,0:40:08.14,Default,,0000,0000,0000,,Ичиго Ичи
Dialogue: 0,0:40:06.17,0:40:08.14,Default,,0000,0000,0000,,...
Dialogue: 0,0:40:06.17,0:40:08.14,Default,,0000,0000,0000,,Өмірде бір рет болатын мүмкіндіктің мысалы ретінде...
Dialogue: 0,0:40:06.17,0:40:08.14,Default,,0000,0000,0000,,Loco Loco. Қараңыз.
Dialogue: 0,0:40:08.14,0:40:10.14,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:40:12.14,0:40:15.11,Default,,0000,0000,0000,,Уфуфуфу... ЛокоРоко-чан
Dialogue: 0,0:40:12.14,0:40:15.11,Default,,0000,0000,0000,,Игай
Dialogue: 0,0:40:12.14,0:40:15.11,Default,,0000,0000,0000,,Сіз таңқаларлықтай сөйлейсіз.
Dialogue: 0,0:40:16.15,0:40:18.15,Default,,0000,0000,0000,,Ойланып қарашы, не болды? Сунео.
Dialogue: 0,0:40:18.15,0:40:20.15,Default,,0000,0000,0000,,Біраз уақыттан бері
Dialogue: 0,0:40:18.15,0:40:20.15,Default,,0000,0000,0000,,Үнемі тыныш емес пе?
Dialogue: 0,0:40:22.15,0:40:24.12,Default,,0000,0000,0000,,болды
Dialogue: 0,0:40:22.15,0:40:24.12,Default,,0000,0000,0000,,Сунео, сенің де ішің ауырады ма?
Dialogue: 0,0:40:24.12,0:40:27.12,Default,,0000,0000,0000,,Оны жай ғана қалдыру керек.
Dialogue: 0,0:40:24.12,0:40:27.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:40:27.12,0:40:31.16,Default,,0000,0000,0000,,Бұл Папи-кунның мәселесі.
Dialogue: 0,0:40:27.12,0:40:31.16,Default,,0000,0000,0000,,Неліктен біз...?
Dialogue: 0,0:40:31.16,0:40:33.13,Default,,0000,0000,0000,,Не? О, енді.
Dialogue: 0,0:40:33.13,0:40:35.13,Default,,0000,0000,0000,,Өйткені бұл дұрыс!
Dialogue: 0,0:40:35.13,0:40:37.13,Default,,0000,0000,0000,,Мен барғым келеді
Dialogue: 0,0:40:35.13,0:40:37.13,Default,,0000,0000,0000,,Мен солдат болсам да
Dialogue: 0,0:40:35.13,0:40:37.13,Default,,0000,0000,0000,,Ол тіпті батыр емес.
Dialogue: 0,0:40:37.13,0:40:40.10,Default,,0000,0000,0000,,Мейвакку
Dialogue: 0,0:40:37.13,0:40:40.10,Default,,0000,0000,0000,,Ашығын айтсам, тітіркендіреді!
Dialogue: 0,0:40:41.14,0:40:43.11,Default,,0000,0000,0000,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:40:41.14,0:40:43.11,Default,,0000,0000,0000,,Сунео-сан!
Dialogue: 0,0:40:45.14,0:40:48.15,Default,,0000,0000,0000,,Хмф! ...Дұрыс. Мүлдем!
Dialogue: 0,0:40:48.15,0:40:50.11,Default,,0000,0000,0000,,Мәңгі
Dialogue: 0,0:40:48.15,0:40:50.11,Default,,0000,0000,0000,,Бұл құрттар.
Dialogue: 0,0:40:53.15,0:40:58.16,Default,,0000,0000,0000,,Ах, Сунео-сан.
Dialogue: 0,0:40:53.15,0:40:58.16,Default,,0000,0000,0000,,Току
Dialogue: 0,0:40:53.15,0:40:58.16,Default,,0000,0000,0000,,Кемелерде ерекше мәселе бар...
Dialogue: 0,0:41:09.20,0:41:11.20,Default,,0000,0000,0000,,
Dialogue: 0,0:41:09.20,0:41:11.20,Default,,0000,0000,0000,,⚞Мистер Сунео.
Dialogue: 0,0:41:11.20,0:41:14.21,Default,,0000,0000,0000,,⚞Мен кіремін.
Dialogue: 0,0:41:18.14,0:41:22.15,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:41:18.14,0:41:22.15,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:41:18.14,0:41:22.15,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:41:18.14,0:41:22.15,Default,,0000,0000,0000,,Мен барлығын қатыстырдым.
Dialogue: 0,0:41:22.15,0:41:25.15,Default,,0000,0000,0000,,Аяма
Dialogue: 0,0:41:22.15,0:41:25.15,Default,,0000,0000,0000,,Сіз жай ғана кешірім сұрай аласыз
Dialogue: 0,0:41:22.15,0:41:25.15,Default,,0000,0000,0000,,Жоқ, бірақ...
Dialogue: 0,0:41:25.15,0:41:28.15,Default,,0000,0000,0000,,​​Тоқта!
Dialogue: 0,0:41:25.15,0:41:28.15,Default,,0000,0000,0000,,Мен оны білемін.
Dialogue: 0,0:41:28.15,0:41:30.12,Default,,0000,0000,0000,,Папи-кун қаншалықты қиын?
Dialogue: 0,0:41:30.12,0:41:33.12,Default,,0000,0000,0000,,Бірақ... мен қорқамын.
Dialogue: 0,0:41:33.12,0:41:37.16,Default,,0000,0000,0000,,НАСА
Dialogue: 0,0:41:33.12,0:41:37.16,Default,,0000,0000,0000,,Бұл аянышты. Маған келгенде...
Dialogue: 0,0:41:37.16,0:41:40.16,Default,,0000,0000,0000,,Дәл солай.
Dialogue: 0,0:41:37.16,0:41:40.16,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:41:37.16,0:41:40.16,Default,,0000,0000,0000,,Тіпті мен қорқамын.
Dialogue: 0,0:41:40.16,0:41:42.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:41:42.13,0:41:46.14,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:41:42.13,0:41:46.14,Default,,0000,0000,0000,,Дауыстап айтсаң, президенттің арқасы.
Dialogue: 0,0:41:42.13,0:41:46.14,Default,,0000,0000,0000,,Себебі сені мазақ етеді→
Dialogue: 0,0:41:46.14,0:41:48.14,Default,,0000,0000,0000,,Мен оны айта алмаймын.
Dialogue: 0,0:41:48.14,0:41:51.21,Default,,0000,0000,0000,,...
Dialogue: 0,0:41:48.14,0:41:51.21,Default,,0000,0000,0000,,Өйткені, әрқашан
Dialogue: 0,0:41:48.14,0:41:51.21,Default,,0000,0000,0000,,Кёфу
Dialogue: 0,0:41:48.14,0:41:51.21,Default,,0000,0000,0000,,Қорқынышты бір жерге апарыңыз→
Dialogue: 0,0:41:51.21,0:41:55.15,Default,,0000,0000,0000,,Қолыңнан келгенін ғана істе
Dialogue: 0,0:41:51.21,0:41:55.15,Default,,0000,0000,0000,,Сізде бар күш-жігеріңізбен істеуден басқа амалыңыз жоқ.
Dialogue: 0,0:41:55.15,0:41:58.15,Default,,0000,0000,0000,,Мен не істей аламын?
Dialogue: 0,0:41:58.15,0:42:01.15,Default,,0000,0000,0000,,Сунео-сан аянышты емес.
Dialogue: 0,0:42:01.15,0:42:05.12,Default,,0000,0000,0000,,Чи
Dialogue: 0,0:42:01.15,0:42:05.12,Default,,0000,0000,0000,,Yuuki
Dialogue: 0,0:42:01.15,0:42:05.12,Default,,0000,0000,0000,,Даналығың мен ерлігіңсіз
Dialogue: 0,0:42:01.15,0:42:05.12,Default,,0000,0000,0000,,Мен қазір жоқпын.
Dialogue: 0,0:42:05.12,0:42:07.16,Default,,0000,0000,0000,,Онджин
Dialogue: 0,0:42:05.12,0:42:07.16,Default,,0000,0000,0000,,Сунео-сан менің қайырымды адамым.
Dialogue: 0,0:42:07.16,0:42:10.13,Default,,0000,0000,0000,,Папи-кун! мен...
Dialogue: 0,0:42:11.13,0:42:13.10,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:42:14.13,0:42:17.13,Default,,0000,0000,0000,,Collapse Collapse!
Dialogue: 0,0:42:14.13,0:42:17.13,Default,,0000,0000,0000,,Әй, Папи-кун!
Dialogue: 0,0:42:17.13,0:42:19.20,Default,,0000,0000,0000,,А, бұл қиын!
Dialogue: 0,0:42:17.13,0:42:19.20,Default,,0000,0000,0000,,Ой, кешіріңіз!
Dialogue: 0,0:42:19.20,0:42:21.14,Default,,0000,0000,0000,,Жақсысың ба? Құрметті Папи.
Dialogue: 0,0:42:21.14,0:42:23.14,Default,,0000,0000,0000,,Бұл не? Барлығы
Dialogue: 0,0:42:21.14,0:42:23.14,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:42:23.14,0:42:26.14,Default,,0000,0000,0000,,Хехе... хахахаха...!
Dialogue: 0,0:42:26.14,0:42:28.15,Default,,0000,0000,0000,,Hahahaha…!
Dialogue: 0,0:42:28.15,0:42:30.15,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:42:30.15,0:42:32.15,Default,,0000,0000,0000,,Барлығыңызды кешіріңіз!
Dialogue: 0,0:42:32.15,0:42:34.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:42:32.15,0:42:34.18,Default,,0000,0000,0000,,Мүмкін тіпті мен үшін→
Dialogue: 0,0:42:34.18,0:42:37.15,Default,,0000,0000,0000,,Қазір не істей аласыз
Dialogue: 0,0:42:34.18,0:42:37.15,Default,,0000,0000,0000,,болуы мүмкін.
Dialogue: 0,0:42:37.15,0:42:39.16,Default,,0000,0000,0000,,Ол басылды!
Dialogue: 0,0:42:39.16,0:42:41.23,Default,,0000,0000,0000,,Дораемон
Dialogue: 0,0:42:39.16,0:42:41.23,Default,,0000,0000,0000,,Сіз танк әкелдіңіз, солай ма?
Dialogue: 0,0:42:41.23,0:42:44.23,Default,,0000,0000,0000,,Гамикаку жоқ Уко
Dialogue: 0,0:42:41.23,0:42:44.23,Default,,0000,0000,0000,,Қабырға қағаздары бар ангарда сақталады.
Dialogue: 0,0:42:44.23,0:42:47.16,Default,,0000,0000,0000,,Жарайды! оны қайта құрыңыз
Dialogue: 0,0:42:44.23,0:42:47.16,Default,,0000,0000,0000,,Қуатты күшейтіңіз!
Dialogue: 0,0:42:47.16,0:42:50.13,Default,,0000,0000,0000,,Бұл қандай жаман иіс?
Dialogue: 0,0:42:47.16,0:42:50.13,Default,,0000,0000,0000,,Хара
Dialogue: 0,0:42:47.16,0:42:50.13,Default,,0000,0000,0000,,Сен ашсың, Сунео.
Dialogue: 0,0:42:56.21,0:42:59.18,Default,,0000,0000,0000,,Шығару.
Dialogue: 0,0:42:56.21,0:42:59.18,Default,,0000,0000,0000,,Юнко
Dialogue: 0,0:42:56.21,0:42:59.18,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:42:56.21,0:42:59.18,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:42:56.21,0:42:59.18,Default,,0000,0000,0000,,Круиз режиміне ауысу.
Dialogue: 0,0:43:00.14,0:43:02.15,Default,,0000,0000,0000,,Иә? Хмм...
Dialogue: 0,0:43:03.15,0:43:05.15,Default,,0000,0000,0000,,
Dialogue: 0,0:43:06.15,0:43:08.15,Default,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:43:06.15,0:43:08.15,Default,,0000,0000,0000,,Мен жақсы ұйықтадым.
Dialogue: 0,0:43:08.15,0:43:10.15,Default,,0000,0000,0000,,Нанжигоро
Dialogue: 0,0:43:08.15,0:43:10.15,Default,,0000,0000,0000,,Жерде сағат қанша?
Dialogue: 0,0:43:12.16,0:43:14.12,Default,,0000,0000,0000,,Бұл...!
Dialogue: 0,0:43:15.16,0:43:17.16,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:43:17.16,0:43:19.16,Default,,0000,0000,0000,,Баршаңызға қайырлы таң.
Dialogue: 0,0:43:19.16,0:43:21.17,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:43:19.16,0:43:21.17,Default,,0000,0000,0000,,Мен келдім...
Dialogue: 0,0:43:19.16,0:43:21.17,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:43:21.17,0:43:23.17,Default,,0000,0000,0000,,Пирика жұлдызы.
Dialogue: 0,0:43:23.17,0:43:31.18,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:43:31.18,0:43:34.14,Default,,0000,0000,0000,,Ең алдымен
Dialogue: 0,0:43:31.18,0:43:34.14,Default,,0000,0000,0000,,...
Dialogue: 0,0:43:31.18,0:43:34.14,Default,,0000,0000,0000,,Сол шағын спутниктік аймаққа барыңыз.
Dialogue: 0,0:43:34.14,0:43:36.15,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:43:34.14,0:43:36.15,Default,,0000,0000,0000,,Үлкен сақина
Dialogue: 0,0:43:34.14,0:43:36.15,Default,,0000,0000,0000,,Олар сізді қоршап жатыр, солай ма?
Dialogue: 0,0:43:36.15,0:43:40.12,Default,,0000,0000,0000,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:43:36.15,0:43:40.12,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,0:43:36.15,0:43:40.12,Default,,0000,0000,0000,,Бұл шын мәнінде кішкентай жұлдыздардың жинағы.
Dialogue: 0,0:43:40.12,0:43:42.15,Default,,0000,0000,0000,,
Dialogue: 0,0:43:40.12,0:43:42.15,Default,,0000,0000,0000,,Осы шаңды джунглиде→
Dialogue: 0,0:43:42.15,0:43:45.12,Default,,0000,0000,0000,,Цзиюудомей
Dialogue: 0,0:43:42.15,0:43:45.12,Default,,0000,0000,0000,,Құпия
Dialogue: 0,0:43:42.15,0:43:45.12,Default,,0000,0000,0000,,Біздің Бостандық Одағының құпия негізі
Dialogue: 0,0:43:42.15,0:43:45.12,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:43:45.12,0:43:47.12,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:43:45.12,0:43:47.12,Default,,0000,0000,0000,,Бұл шынымен де Пифия→
Dialogue: 0,0:43:47.12,0:43:49.13,Default,,0000,0000,0000,,Оны табудың жолы жоқ.
Dialogue: 0,0:43:49.13,0:43:52.16,Default,,0000,0000,0000,,Жоқ, мен осыны іздеп жүрмін.
Dialogue: 0,0:43:49.13,0:43:52.16,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:43:52.16,0:43:54.13,Default,,0000,0000,0000,,Джунсей
Dialogue: 0,0:43:52.16,0:43:54.13,Default,,0000,0000,0000,,Патрульдік қайық айналып жүр.
Dialogue: 0,0:43:54.13,0:43:56.13,Default,,0000,0000,0000,,Мүмкін тіпті осы сәтте...
Dialogue: 0,0:43:56.13,0:43:58.14,Default,,0000,0000,0000,,(ескерту дыбысы)
Dialogue: 0,0:43:56.13,0:43:58.14,Default,,0000,0000,0000,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:43:59.14,0:44:01.14,Default,,0000,0000,0000,,Мигикохоу
Dialogue: 0,0:43:59.14,0:44:01.14,Default,,0000,0000,0000,,Сабын
Dialogue: 0,0:43:59.14,0:44:01.14,Default,,0000,0000,0000,,Оң жақтан бір нәрсе келе жатыр!
Dialogue: 0,0:44:01.14,0:44:03.14,Default,,0000,0000,0000,,Көлеңке
Dialogue: 0,0:44:01.14,0:44:03.14,Default,,0000,0000,0000,,Сол спутниктің артында!
Dialogue: 0,0:44:03.14,0:44:10.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:44:10.15,0:44:13.15,Default,,0000,0000,0000,,Ұрыс
Dialogue: 0,0:44:10.15,0:44:13.15,Default,,0000,0000,0000,,Ұрыс!
Dialogue: 0,0:44:10.15,0:44:13.15,Default,,0000,0000,0000,,Қуған адам...→
Dialogue: 0,0:44:13.15,0:44:16.12,Default,,0000,0000,0000,,Бұл менің жолдасым!
Dialogue: 0,0:44:13.15,0:44:16.12,Default,,0000,0000,0000,,Еркін альянс туралы?
Dialogue: 0,0:44:16.12,0:44:19.12,Default,,0000,0000,0000,,Муджин Сентоки
Dialogue: 0,0:44:16.12,0:44:19.12,Default,,0000,0000,0000,,Пифияның ұшқышсыз жауынгері
Dialogue: 0,0:44:16.12,0:44:19.12,Default,,0000,0000,0000,,Тұтқындалу….
Dialogue: 0,0:44:19.12,0:44:22.09,Default,,0000,0000,0000,,Бір рет жеген
Dialogue: 0,0:44:19.12,0:44:22.09,Default,,0000,0000,0000,,Гекиха
Dialogue: 0,0:44:19.12,0:44:22.09,Default,,0000,0000,0000,,Қарсылас жеңілмейінше кетпейді.
Dialogue: 0,0:44:23.13,0:44:25.13,Default,,0000,0000,0000,,Папи-кун!
Dialogue: 0,0:44:25.13,0:44:27.23,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:44:25.13,0:44:27.23,Default,,0000,0000,0000,,Мен резервуарды қарызға алғым келеді.
Dialogue: 0,0:44:27.23,0:44:29.13,Default,,0000,0000,0000,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:44:27.23,0:44:29.13,Default,,0000,0000,0000,,Босдық
Dialogue: 0,0:44:27.23,0:44:29.13,Default,,0000,0000,0000,,SPK-ның мен басқаратын төрт мүшесі ғана бар.
Dialogue: 0,0:44:27.23,0:44:29.13,Default,,0000,0000,0000,,Енді жүгіруге болмайды!
Dialogue: 0,0:44:29.13,0:44:31.17,Default,,0000,0000,0000,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:44:29.13,0:44:31.17,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:44:31.17,0:44:41.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:44:41.15,0:44:43.11,Default,,0000,0000,0000,,《Абайлаңыз...》
Dialogue: 0,0:44:46.15,0:44:48.15,Default,,0000,0000,0000,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:44:46.15,0:44:48.15,Default,,0000,0000,0000,,Оң жақ қозғалтқыш...
Dialogue: 0,0:44:48.15,0:44:52.12,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:44:48.15,0:44:52.12,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:44:48.15,0:44:52.12,Default,,0000,0000,0000,,Не! ? Егер 5 жаңа қол болса! ?
Dialogue: 0,0:44:55.19,0:44:57.19,Default,,0000,0000,0000,,Шинкину
Dialogue: 0,0:44:55.19,0:44:57.19,Default,,0000,0000,0000,,үшін
Dialogue: 0,0:44:55.19,0:44:57.19,Default,,0000,0000,0000,,Suneo Жаңа мүмкіндіктерді қолданып көріңіз!
Dialogue: 0,0:44:58.16,0:45:01.17,Default,,0000,0000,0000,,Барлығың тыңдаңдар.
Dialogue: 0,0:44:58.16,0:45:01.17,Default,,0000,0000,0000,,Айзу
Dialogue: 0,0:44:58.16,0:45:01.17,Default,,0000,0000,0000,,Мен сигнал бергенде →
Dialogue: 0,0:45:01.17,0:45:03.13,Default,,0000,0000,0000,,Қызыл
Dialogue: 0,0:45:01.17,0:45:03.13,Default,,0000,0000,0000,,Оң жақтағы қызыл тұтқаны итеріңіз.
Dialogue: 0,0:45:01.17,0:45:03.13,Default,,0000,0000,0000,,О-
Dialogue: 0,0:45:01.17,0:45:03.13,Default,,0000,0000,0000,,Барынша қатты тартыңыз.
Dialogue: 0,0:45:04.17,0:45:06.14,Default,,0000,0000,0000,,Міне. Иә!
Dialogue: 0,0:45:06.14,0:45:12.14,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:45:12.14,0:45:14.14,Default,,0000,0000,0000,,Нобита-сан! ?
Dialogue: 0,0:45:12.14,0:45:14.14,Default,,0000,0000,0000,,Әлгі ақымақ...!
Dialogue: 0,0:45:14.14,0:45:16.11,Default,,0000,0000,0000,,Уау! ?
Dialogue: 0,0:45:17.15,0:45:19.12,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,0:45:21.15,0:45:23.15,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,0:45:24.19,0:45:26.19,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:45:29.16,0:45:32.13,Default,,0000,0000,0000,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:45:29.16,0:45:32.13,Default,,0000,0000,0000,,Мен мұны жалғыз істей алмадым.
Dialogue: 0,0:45:32.13,0:45:35.17,Default,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:45:32.13,0:45:35.17,Default,,0000,0000,0000,,Күшті….
Dialogue: 0,0:45:32.13,0:45:35.17,Default,,0000,0000,0000,,Нобита-кун, жақсысың ба?
Dialogue: 0,0:45:35.17,0:45:37.17,Default,,0000,0000,0000,,Нобита-кун!
Dialogue: 0,0:45:38.14,0:45:41.14,Default,,0000,0000,0000,,Жарайды... әйтеуір.
Dialogue: 0,0:45:43.14,0:45:45.11,Default,,0000,0000,0000,,Уф, менің басым айналып кетті...
Dialogue: 0,0:45:45.11,0:45:47.14,Default,,0000,0000,0000,,Нобита….
Dialogue: 0,0:45:47.14,0:45:51.15,Default,,0000,0000,0000,,Сунео: Бұл жойғыш ұшақ керемет!
Dialogue: 0,0:45:47.14,0:45:51.15,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:45:51.15,0:45:54.15,Default,,0000,0000,0000,,Бұл... дұрыс!
Dialogue: 0,0:45:51.15,0:45:54.15,Default,,0000,0000,0000,,Оны Astro Thruster деп атаңыз!
Dialogue: 0,0:45:54.15,0:45:56.15,Default,,0000,0000,0000,,Хацушори
Dialogue: 0,0:45:54.15,0:45:56.15,Default,,0000,0000,0000,,Біздің алғашқы жеңісіміз!
Dialogue: 0,0:45:56.15,0:45:59.12,Default,,0000,0000,0000,,«Иә, иә!»
Dialogue: 0,0:45:56.15,0:45:59.12,Default,,0000,0000,0000,,«Қараңдар!»
Dialogue: 0,0:45:59.12,0:46:01.13,Default,,0000,0000,0000,,Пифия қорқынышты емес!
Dialogue: 0,0:45:59.12,0:46:01.13,Default,,0000,0000,0000,,Эй, эй!
Dialogue: 0,0:46:01.13,0:46:03.13,Default,,0000,0000,0000,,
Dialogue: 0,0:46:01.13,0:46:03.13,Default,,0000,0000,0000,,Маған кез келген уақытта қоңырау шалыңыз!
Dialogue: 0,0:46:03.13,0:46:06.13,Default,,0000,0000,0000,,(Сунео)
Dialogue: 0,0:46:03.13,0:46:06.13,Default,,0000,0000,0000,,Миниатюралық танк корпусының алғашқы жеңісі!
Dialogue: 0,0:46:06.13,0:46:08.13,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:46:06.13,0:46:08.13,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:46:20.08,0:46:23.11,Default,,0000,0000,0000,,Онда
Dialogue: 0,0:46:20.08,0:46:23.11,Default,,0000,0000,0000,,Қараңдар! Шұңқырдың түбі...
Dialogue: 0,0:46:23.11,0:46:25.08,Default,,0000,0000,0000,,Бастапқыда→
Dialogue: 0,0:46:25.08,0:46:28.05,Default,,0000,0000,0000,,Кобутсушиген
Dialogue: 0,0:46:25.08,0:46:28.05,Default,,0000,0000,0000,,Жаңа піскен ет
Dialogue: 0,0:46:25.08,0:46:28.05,Default,,0000,0000,0000,,Бұл пайдалы қазбаларды өндіруге арналған кен орны болды.
Dialogue: 0,0:46:37.09,0:46:39.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:46:42.13,0:46:45.10,Default,,0000,0000,0000,,Уф уф! Уф уфф!
Dialogue: 0,0:46:42.13,0:46:45.10,Default,,0000,0000,0000,,Woof woof woof!
Dialogue: 0,0:46:45.10,0:46:49.07,Default,,0000,0000,0000,,Бұл LocoRoco емес пе?
Dialogue: 0,0:46:45.10,0:46:49.07,Default,,0000,0000,0000,,Мен жаңа ғана оралдым!
Dialogue: 0,0:46:49.07,0:46:53.08,Default,,0000,0000,0000,,Маған кім көмектесті?
Dialogue: 0,0:46:49.07,0:46:53.08,Default,,0000,0000,0000,,Mystery
Dialogue: 0,0:46:49.07,0:46:53.08,Default,,0000,0000,0000,,Біртүрлі болды.
Dialogue: 0,0:46:53.08,0:46:55.08,Default,,0000,0000,0000,,Мен жалғыз емеспін!
Dialogue: 0,0:46:55.08,0:46:58.08,Default,,0000,0000,0000,,Сол адамдар мен...
Dialogue: 0,0:46:55.08,0:46:58.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:46:58.08,0:47:00.08,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:47:00.08,0:47:03.09,Default,,0000,0000,0000,,Әйтеуір... А... Анау...
Dialogue: 0,0:47:03.09,0:47:05.09,Default,,0000,0000,0000,,Хира
Dialogue: 0,0:47:03.09,0:47:05.09,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:47:03.09,0:47:05.09,Default,,0000,0000,0000,,Президент!
Dialogue: 0,0:47:05.09,0:47:07.09,Default,,0000,0000,0000,,Министр Генбу!
Dialogue: 0,0:47:07.09,0:47:10.06,Default,,0000,0000,0000,,Не, не…. Ахх...!
Dialogue: 0,0:47:12.10,0:47:16.10,Default,,0000,0000,0000,,Президент Папи мен уайымдадым...
Dialogue: 0,0:47:16.10,0:47:20.07,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:47:16.10,0:47:20.07,Default,,0000,0000,0000,,Сол шабуылда министрге жарайсың...
Dialogue: 0,0:47:20.07,0:47:24.11,Default,,0000,0000,0000,,Ол кезде менің қолымнан келетін жалғыз нәрсе осы еді...
Dialogue: 0,0:47:20.07,0:47:24.11,Default,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:47:24.11,0:47:28.11,Default,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:47:24.11,0:47:28.11,Default,,0000,0000,0000,,Біздің өміріміз осылай
Dialogue: 0,0:47:24.11,0:47:28.11,Default,,0000,0000,0000,,Мұның бәрі Пиина екеуіңнің арқасы.
Dialogue: 0,0:47:28.11,0:47:31.11,Default,,0000,0000,0000,,Сол Пиина...
Dialogue: 0,0:47:31.11,0:47:33.12,Default,,0000,0000,0000,,Мен оқиғаны толық естідім.
Dialogue: 0,0:47:33.12,0:47:35.09,Default,,0000,0000,0000,,Мен де келесі қадамды ойлауым керек.
Dialogue: 0,0:47:36.12,0:47:38.09,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:47:36.12,0:47:38.09,Default,,0000,0000,0000,,LocoRoco Бұл кім?
Dialogue: 0,0:47:38.09,0:47:42.13,Default,,0000,0000,0000,,Мэйшу
Dialogue: 0,0:47:38.09,0:47:42.13,Default,,0000,0000,0000,,Бостандық альянсының жетекшісі
Dialogue: 0,0:47:38.09,0:47:42.13,Default,,0000,0000,0000,,Яғни көшбасшы →
Dialogue: 0,0:47:42.13,0:47:44.09,Default,,0000,0000,0000,,Бұл Генбу-сан!
Dialogue: 0,0:47:44.09,0:47:47.10,Default,,0000,0000,0000,,Чиан
Dialogue: 0,0:47:44.09,0:47:47.10,Default,,0000,0000,0000,,Бұрынғы қауіпсіздік министрі
Dialogue: 0,0:47:44.09,0:47:47.10,Default,,0000,0000,0000,,Мөр
Dialogue: 0,0:47:44.09,0:47:47.10,Default,,0000,0000,0000,,Гилморға қарсы →
Dialogue: 0,0:47:47.10,0:47:49.10,Default,,0000,0000,0000,,Ұсталып қалды
Dialogue: 0,0:47:47.10,0:47:49.10,Default,,0000,0000,0000,,Ұрланған
Dialogue: 0,0:47:47.10,0:47:49.10,Default,,0000,0000,0000,,Қашу!
Dialogue: 0,0:47:49.10,0:47:51.10,Default,,0000,0000,0000,,Арамызда
Dialogue: 0,0:47:49.10,0:47:51.10,Default,,0000,0000,0000,,Жолдастарды жасырын жинап →
Dialogue: 0,0:47:51.10,0:47:54.10,Default,,0000,0000,0000,,Кессей
Dialogue: 0,0:47:51.10,0:47:54.10,Default,,0000,0000,0000,,Осы Бостандық Альянсын құрды
Dialogue: 0,0:47:51.10,0:47:54.10,Default,,0000,0000,0000,,Мен баратынмын!
Dialogue: 0,0:47:56.07,0:47:59.11,Default,,0000,0000,0000,,Кичи
Dialogue: 0,0:47:56.07,0:47:59.11,Default,,0000,0000,0000,,Секининша
Dialogue: 0,0:47:56.07,0:47:59.11,Default,,0000,0000,0000,,Осы базаға жауапты адам
Dialogue: 0,0:47:56.07,0:47:59.11,Default,,0000,0000,0000,,Ширей
Dialogue: 0,0:47:56.07,0:47:59.11,Default,,0000,0000,0000,,Бұл Генбу командирі.
Dialogue: 0,0:47:59.11,0:48:04.08,Default,,0000,0000,0000,,Президентке көмектескеніңіз үшін рахмет.
Dialogue: 0,0:47:59.11,0:48:04.08,Default,,0000,0000,0000,,Менде алғыс сөздер жоқ.
Dialogue: 0,0:48:04.08,0:48:07.12,Default,,0000,0000,0000,,Жоқ, біз жай ғана...
Dialogue: 0,0:48:04.08,0:48:07.12,Default,,0000,0000,0000,,Генбу-сан→
Dialogue: 0,0:48:07.12,0:48:10.12,Default,,0000,0000,0000,,Жұқа көрінгенімен
Dialogue: 0,0:48:07.12,0:48:10.12,Default,,0000,0000,0000,,Вака
Dialogue: 0,0:48:07.12,0:48:10.12,Default,,0000,0000,0000,,Менің жүрегім жаспын.
Dialogue: 0,0:48:10.12,0:48:13.09,Default,,0000,0000,0000,,Қара
Dialogue: 0,0:48:10.12,0:48:13.09,Default,,0000,0000,0000,,Ах!!
Dialogue: 0,0:48:10.12,0:48:13.09,Default,,0000,0000,0000,,Мен тіпті сақалымды қараға боядым...
Dialogue: 0,0:48:10.12,0:48:13.09,Default,,0000,0000,0000,,Бұл LocoRoco.
Dialogue: 0,0:48:13.09,0:48:15.09,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:48:13.09,0:48:15.09,Default,,0000,0000,0000,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,0:48:13.09,0:48:15.09,Default,,0000,0000,0000,,Ән
Dialogue: 0,0:48:13.09,0:48:15.09,Default,,0000,0000,0000,,Менің хоббиім ішу және ән айту...
Dialogue: 0,0:48:13.09,0:48:15.09,Default,,0000,0000,0000,,LocoRoco!
Dialogue: 0,0:48:15.09,0:48:17.06,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:48:15.09,0:48:17.06,Default,,0000,0000,0000,,Қараңдар!
Dialogue: 0,0:48:19.10,0:48:21.10,Default,,0000,0000,0000,,О!
Dialogue: 0,0:48:21.10,0:48:25.07,Default,,0000,0000,0000,,Кангей
Dialogue: 0,0:48:21.10,0:48:25.07,Default,,0000,0000,0000,,Біз сіздерді тағы да қарсы алғымыз келеді.
Dialogue: 0,0:48:26.17,0:48:28.07,Default,,0000,0000,0000,,...
Dialogue: 0,0:48:26.17,0:48:28.07,Default,,0000,0000,0000,,Бұл командалық бөлме.
Dialogue: 0,0:48:28.07,0:48:30.14,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:48:30.14,0:48:33.14,Default,,0000,0000,0000,,Жарайды, бәрі осы...
Dialogue: 0,0:48:35.08,0:48:39.08,Default,,0000,0000,0000,,Мұның бәрі Пиинаның арқасында.
Dialogue: 0,0:48:35.08,0:48:39.08,Default,,0000,0000,0000,,Пиина?
Dialogue: 0,0:48:39.08,0:48:43.09,Default,,0000,0000,0000,,Сосаку
Dialogue: 0,0:48:39.08,0:48:43.09,Default,,0000,0000,0000,,Пиина мен Президентті іздеу
Dialogue: 0,0:48:39.08,0:48:43.09,Default,,0000,0000,0000,,Пифия алаңдап тұрғанда→
Dialogue: 0,0:48:43.09,0:48:46.09,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:48:43.09,0:48:46.09,Default,,0000,0000,0000,,Мен күш жинай алдым.
Dialogue: 0,0:48:46.09,0:48:48.09,Default,,0000,0000,0000,,Бірақ….
Dialogue: 0,0:48:48.09,0:48:50.09,Default,,0000,0000,0000,,
Dialogue: 0,0:48:48.09,0:48:50.09,Default,,0000,0000,0000,,Ол ақыры ұсталды...
Dialogue: 0,0:48:50.09,0:48:53.10,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:48:50.09,0:48:53.10,Default,,0000,0000,0000,,Әрине Пифия
Dialogue: 0,0:48:50.09,0:48:53.10,Default,,0000,0000,0000,,Шокей
Dialogue: 0,0:48:50.09,0:48:53.10,Default,,0000,0000,0000,,Мен Пиинаны өлтіргім келеді.
Dialogue: 0,0:48:53.10,0:48:56.10,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:48:53.10,0:48:56.10,Default,,0000,0000,0000,,Миого күні
Dialogue: 0,0:48:53.10,0:48:56.10,Default,,0000,0000,0000,,Ертеңгі күні шығар...→
Dialogue: 0,0:48:56.10,0:49:00.10,Default,,0000,0000,0000,,Коутей
Dialogue: 0,0:48:56.10,0:49:00.10,Default,,0000,0000,0000,,Гилмор император болады
Dialogue: 0,0:48:56.10,0:49:00.10,Default,,0000,0000,0000,,Тәжі кию рәсімінен кейін шығар.
Dialogue: 0,0:49:00.10,0:49:02.07,Default,,0000,0000,0000,,Уақытымыз таусылып барады!
Dialogue: 0,0:49:02.07,0:49:04.07,Default,,0000,0000,0000,,Пирикада жасырын→
Dialogue: 0,0:49:04.07,0:49:07.11,Default,,0000,0000,0000,,Бостандық альянсының жолдастары
Dialogue: 0,0:49:04.07,0:49:07.11,Default,,0000,0000,0000,,Жақын жерде
Dialogue: 0,0:49:04.07,0:49:07.11,Default,,0000,0000,0000,,Біз астыртын ұйым құрып жатырмыз.
Dialogue: 0,0:49:07.11,0:49:13.08,Default,,0000,0000,0000,,Мазмұны
Dialogue: 0,0:49:07.11,0:49:13.08,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:49:07.11,0:49:13.08,Default,,0000,0000,0000,,Олармен бірге тәж кию күні
Dialogue: 0,0:49:07.11,0:49:13.08,Default,,0000,0000,0000,,Иссей
Dialogue: 0,0:49:07.11,0:49:13.08,Default,,0000,0000,0000,,Кейкаку
Dialogue: 0,0:49:07.11,0:49:13.08,Default,,0000,0000,0000,,Жоспар - бірден шабуыл жасау.
Dialogue: 0,0:49:13.08,0:49:16.09,Default,,0000,0000,0000,,Бостандық альянсы дегеніміз не?
Dialogue: 0,0:49:13.08,0:49:16.09,Default,,0000,0000,0000,,Наннин
Dialogue: 0,0:49:13.08,0:49:16.09,Default,,0000,0000,0000,,Неше адам бар?
Dialogue: 0,0:49:16.09,0:49:20.06,Default,,0000,0000,0000,,Бұл базада 303 адам.
Dialogue: 0,0:49:16.09,0:49:20.06,Default,,0000,0000,0000,,Пирикада 508 адам бар.
Dialogue: 0,0:49:20.06,0:49:22.09,Default,,0000,0000,0000,,Гава
Dialogue: 0,0:49:20.06,0:49:22.09,Default,,0000,0000,0000,,Гилмор туралы не деуге болады?
Dialogue: 0,0:49:22.09,0:49:24.09,Default,,0000,0000,0000,,Адам
Dialogue: 0,0:49:22.09,0:49:24.09,Default,,0000,0000,0000,,Шамамен 800 000.
Dialogue: 0,0:49:24.09,0:49:27.10,Default,,0000,0000,0000,,Мен қалаймын
Dialogue: 0,0:49:24.09,0:49:27.10,Default,,0000,0000,0000,,800 800 000 қарсы! ?
Dialogue: 0,0:49:24.09,0:49:27.10,Default,,0000,0000,0000,,Шобу
Dialogue: 0,0:49:24.09,0:49:27.10,Default,,0000,0000,0000,,Бұл тіпті сәйкестік емес!
Dialogue: 0,0:49:27.10,0:49:30.10,Default,,0000,0000,0000,,Кілт
Dialogue: 0,0:49:27.10,0:49:30.10,Default,,0000,0000,0000,,Жоқ, міндетті емес.
Dialogue: 0,0:49:27.10,0:49:30.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:49:30.10,0:49:35.07,Default,,0000,0000,0000,,Джинмин
Dialogue: 0,0:49:30.10,0:49:35.07,Default,,0000,0000,0000,,Пирика халқының көпшілігі
Dialogue: 0,0:49:30.10,0:49:35.07,Default,,0000,0000,0000,,Нику
Dialogue: 0,0:49:30.10,0:49:35.07,Default,,0000,0000,0000,,Гилмордан қорқады және жек көреді.
Dialogue: 0,0:49:35.07,0:49:40.11,Default,,0000,0000,0000,,Сондықтан Еркін Альянс
Dialogue: 0,0:49:35.07,0:49:40.11,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:49:35.07,0:49:40.11,Default,,0000,0000,0000,,Тәжі кию рәсімінде қолыңызды көтерсеңіз...→
Dialogue: 0,0:49:40.11,0:49:45.08,Default,,0000,0000,0000,,Қалай болғанда да, біз тез арада ауруханаға жетуіміз керек…
Dialogue: 0,0:49:40.11,0:49:45.08,Default,,0000,0000,0000,,Адамдар да бізбен бірге тұрады
Dialogue: 0,0:49:40.11,0:49:45.08,Default,,0000,0000,0000,,Дайбудо
Dialogue: 0,0:49:40.11,0:49:45.08,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:49:40.11,0:49:45.08,Default,,0000,0000,0000,,Үлкен тәртіпсіздік болуы мүмкін.
Dialogue: 0,0:49:45.08,0:49:48.09,Default,,0000,0000,0000,,Мокка
Dialogue: 0,0:49:45.08,0:49:48.09,Default,,0000,0000,0000,,Гиджуцусан
Dialogue: 0,0:49:45.08,0:49:48.09,Default,,0000,0000,0000,,Сонымен қатар, техникалық топ қазіргі уақытта →
Dialogue: 0,0:49:48.09,0:49:52.09,Default,,0000,0000,0000,,Хасшинген
Dialogue: 0,0:49:48.09,0:49:52.09,Default,,0000,0000,0000,,Дереккөзді ашудан аулақ болыңыз
Dialogue: 0,0:49:48.09,0:49:52.09,Default,,0000,0000,0000,,Цуушин Шудан
Dialogue: 0,0:49:48.09,0:49:52.09,Default,,0000,0000,0000,,Байланыс құралы жоқ па→
Dialogue: 0,0:49:52.09,0:49:54.09,Default,,0000,0000,0000,,Кенмей
Dialogue: 0,0:49:52.09,0:49:54.09,Default,,0000,0000,0000,,Саг
Dialogue: 0,0:49:52.09,0:49:54.09,Default,,0000,0000,0000,,Біз қазір қатты ізденіп жатырмыз.
Dialogue: 0,0:49:54.09,0:50:02.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:50:02.10,0:50:04.10,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:50:04.10,0:50:06.10,Default,,0000,0000,0000,,Міне болды!
Dialogue: 0,0:50:06.10,0:50:09.07,Default,,0000,0000,0000,,Нобита-сан!
Dialogue: 0,0:50:06.10,0:50:09.07,Default,,0000,0000,0000,,Неге мұндасың...?
Dialogue: 0,0:50:09.07,0:50:12.11,Default,,0000,0000,0000,,Жоқ... Мен жай ғана қызықпын.
Dialogue: 0,0:50:12.11,0:50:14.08,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,0:50:14.08,0:50:24.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:50:24.12,0:50:26.09,Default,,0000,0000,0000,,Кашики
Dialogue: 0,0:50:24.12,0:50:26.09,Default,,0000,0000,0000,,Керемет пейзаж!
Dialogue: 0,0:50:26.09,0:50:30.09,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:50:26.09,0:50:30.09,Default,,0000,0000,0000,,Шисацу
Dialogue: 0,0:50:26.09,0:50:30.09,Default,,0000,0000,0000,,Бұрын мен тексеруге келгенде
Dialogue: 0,0:50:26.09,0:50:30.09,Default,,0000,0000,0000,,Бұл мен Пиина-ни-санмен тапқан жерім.
Dialogue: 0,0:50:30.09,0:50:33.16,Default,,0000,0000,0000,,Пиинамен...
Dialogue: 0,0:50:30.09,0:50:33.16,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:50:33.16,0:50:36.10,Default,,0000,0000,0000,,(Пинаның дауысы)
Dialogue: 0,0:50:33.16,0:50:36.10,Default,,0000,0000,0000,,Шин
Dialogue: 0,0:50:33.16,0:50:36.10,Default,,0000,0000,0000,,Мен әлі де сене алар емеспін!
Dialogue: 0,0:50:36.10,0:50:40.10,Default,,0000,0000,0000,,Әке
Dialogue: 0,0:50:36.10,0:50:40.10,Default,,0000,0000,0000,,Менің інім
Dialogue: 0,0:50:36.10,0:50:40.10,Default,,0000,0000,0000,,Ол осы планетаның президенті!
Dialogue: 0,0:50:40.10,0:50:42.07,Default,,0000,0000,0000,,Шинмай
Dialogue: 0,0:50:40.10,0:50:42.07,Default,,0000,0000,0000,,Мен әлі де жаңадан бастағанмын...
Dialogue: 0,0:50:42.07,0:50:44.07,Default,,0000,0000,0000,,Бірақ мені бақылаңыз, апа.
Dialogue: 0,0:50:44.07,0:50:46.08,Default,,0000,0000,0000,,Бұдан былай бұл планета→
Dialogue: 0,0:50:46.08,0:50:49.15,Default,,0000,0000,0000,,Учууичи
Dialogue: 0,0:50:46.08,0:50:49.15,Default,,0000,0000,0000,,Кибу
Dialogue: 0,0:50:46.08,0:50:49.15,Default,,0000,0000,0000,,Әлемдегі ең үмітті жұлдыз
Dialogue: 0,0:50:46.08,0:50:49.15,Default,,0000,0000,0000,,Мен саған көрсетемін!
Dialogue: 0,0:50:49.15,0:50:51.15,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:50:55.09,0:50:58.09,Default,,0000,0000,0000,,Мен саған әрқашан көмектесемін, Папи.
Dialogue: 0,0:50:58.09,0:51:00.09,Default,,0000,0000,0000,,Не болса да.
Dialogue: 0,0:51:03.13,0:51:05.10,Default,,0000,0000,0000,,Әпке...
Dialogue: 0,0:51:05.10,0:51:07.10,Default,,0000,0000,0000,,Папи-кун!
Dialogue: 0,0:51:07.10,0:51:09.13,Default,,0000,0000,0000,,Өйткені біз доспыз!
Dialogue: 0,0:51:07.10,0:51:09.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:09.13,0:51:11.13,Default,,0000,0000,0000,,Сіз Сунеоға айттыңыз.
Dialogue: 0,0:51:11.13,0:51:14.10,Default,,0000,0000,0000,,Әркім өзіне ғана
Dialogue: 0,0:51:11.13,0:51:14.10,Default,,0000,0000,0000,,Сіз жасай алмайтын нәрселер бар.
Dialogue: 0,0:51:14.10,0:51:17.11,Default,,0000,0000,0000,,Мен Папи-кун сияқтымын
Dialogue: 0,0:51:14.10,0:51:17.11,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,0:51:14.10,0:51:17.11,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:51:14.10,0:51:17.11,Default,,0000,0000,0000,,Мен ақылды емеспін →
Dialogue: 0,0:51:17.11,0:51:19.11,Default,,0000,0000,0000,,Blowout
Dialogue: 0,0:51:17.11,0:51:19.11,Default,,0000,0000,0000,,Докио
Dialogue: 0,0:51:17.11,0:51:19.11,Default,,0000,0000,0000,,Ол ебедейсіз, батылдығы жоқ...
Dialogue: 0,0:51:19.11,0:51:22.11,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:51:19.11,0:51:22.11,Default,,0000,0000,0000,,Бірақ егер бұл бір ғана нәрсе болса →
Dialogue: 0,0:51:22.11,0:51:25.12,Default,,0000,0000,0000,,Қолыңнан келмесе де
Dialogue: 0,0:51:22.11,0:51:25.12,Default,,0000,0000,0000,,Сіз мұны істей алатын шығарсыз!
Dialogue: 0,0:51:25.12,0:51:28.12,Default,,0000,0000,0000,,Сондықтан маған уәде беруіңізді қалаймын.
Dialogue: 0,0:51:28.12,0:51:31.09,Default,,0000,0000,0000,,Ная
Dialogue: 0,0:51:28.12,0:51:31.09,Default,,0000,0000,0000,,Жалғыз жапа шекпе
Dialogue: 0,0:51:28.12,0:51:31.09,Default,,0000,0000,0000,,Біз үшін де...
Dialogue: 0,0:51:32.19,0:51:35.13,Default,,0000,0000,0000,,Әрине, Нобита-сан...
Dialogue: 0,0:51:35.13,0:51:38.09,Default,,0000,0000,0000,,Барлығың доссыңдар!
Dialogue: 0,0:51:38.09,0:51:41.13,Default,,0000,0000,0000,,Майо
Dialogue: 0,0:51:38.09,0:51:41.13,Default,,0000,0000,0000,,Қанара
Dialogue: 0,0:51:38.09,0:51:41.13,Default,,0000,0000,0000,,Судан
Dialogue: 0,0:51:38.09,0:51:41.13,Default,,0000,0000,0000,,Күмәндансаңыз, міндетті түрде кеңес сұраңыз.
Dialogue: 0,0:51:41.13,0:51:44.13,Default,,0000,0000,0000,,Изога
Dialogue: 0,0:51:41.13,0:51:44.13,Default,,0000,0000,0000,,Енді мен бос емеспін.
Dialogue: 0,0:51:44.13,0:51:46.10,Default,,0000,0000,0000,,Олай болса...
Dialogue: 0,0:51:49.11,0:51:51.07,Default,,0000,0000,0000,,Рахмет, Нобита-сан.
Dialogue: 0,0:51:51.07,0:51:55.08,Default,,0000,0000,0000,,...
Dialogue: 0,0:51:51.07,0:51:55.08,Default,,0000,0000,0000,,Мен бәріңмен кездесе алдым.
Dialogue: 0,0:51:51.07,0:51:55.08,Default,,0000,0000,0000,,Бұл өте жақсы болды….
Dialogue: 0,0:52:00.12,0:52:02.09,Default,,0000,0000,0000,,Президент шаттлда! ?
Dialogue: 0,0:52:02.09,0:52:04.15,Default,,0000,0000,0000,,Ішкі штрихтен
Dialogue: 0,0:52:02.09,0:52:04.15,Default,,0000,0000,0000,,Кьюусейки
Dialogue: 0,0:52:02.09,0:52:04.15,Default,,0000,0000,0000,,Мен кетуге мәжбүр болдым...
Dialogue: 0,0:52:04.15,0:52:07.09,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:52:04.15,0:52:07.09,Default,,0000,0000,0000,,Маған қайта қоңырау шалыңыз!
Dialogue: 0,0:52:04.15,0:52:07.09,Default,,0000,0000,0000,,⚞Байланыс үзілді.
Dialogue: 0,0:52:07.09,0:52:09.09,Default,,0000,0000,0000,,Ал Спидвагон мен басқалар
Dialogue: 0,0:52:07.09,0:52:09.09,Default,,0000,0000,0000,,Мен істей алатын нәрсе бар ма?
Dialogue: 0,0:52:09.09,0:52:12.10,Default,,0000,0000,0000,,Мұны қалай жасауға болады?
Dialogue: 0,0:52:12.10,0:52:14.10,Default,,0000,0000,0000,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:52:14.10,0:52:16.10,Default,,0000,0000,0000,,Папи-кун! !
Dialogue: 0,0:52:24.07,0:52:26.11,Default,,0000,0000,0000,,Гухахаха...!
Dialogue: 0,0:52:26.11,0:52:29.08,Default,,0000,0000,0000,,Папи...
Dialogue: 0,0:52:26.11,0:52:29.08,Default,,0000,0000,0000,,Мен оның жалғыз шығады деп ойламаппын.
Dialogue: 0,0:52:29.08,0:52:32.08,Default,,0000,0000,0000,,Президент күткендей.
Dialogue: 0,0:52:32.08,0:52:35.09,Default,,0000,0000,0000,,Алайда, бұл ертеңгі күнге дейін.
Dialogue: 0,0:52:35.09,0:52:39.09,Default,,0000,0000,0000,,Президент…
Dialogue: 0,0:52:35.09,0:52:39.09,Default,,0000,0000,0000,,Жабу
Dialogue: 0,0:52:35.09,0:52:39.09,Default,,0000,0000,0000,,Сізде бір соңғы миссия бар.
Dialogue: 0,0:52:39.09,0:52:43.09,Default,,0000,0000,0000,,Император Гилмордың тәж киюіне қатысу→
Dialogue: 0,0:52:43.09,0:52:47.10,Default,,0000,0000,0000,,Сейшики
Dialogue: 0,0:52:43.09,0:52:47.10,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:52:43.09,0:52:47.10,Default,,0000,0000,0000,,Юдзу
Dialogue: 0,0:52:43.09,0:52:47.10,Default,,0000,0000,0000,,Мақта
Dialogue: 0,0:52:43.09,0:52:47.10,Default,,0000,0000,0000,,Лауазымды ресми түрде беру
Dialogue: 0,0:52:43.09,0:52:47.10,Default,,0000,0000,0000,,Миссия.
Dialogue: 0,0:52:48.10,0:52:50.10,Default,,0000,0000,0000,,Шайқас аяқталды!
Dialogue: 0,0:52:50.10,0:52:53.10,Default,,0000,0000,0000,,Сейги
Dialogue: 0,0:52:50.10,0:52:53.10,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:52:50.10,0:52:53.10,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:52:50.10,0:52:53.10,Default,,0000,0000,0000,,Менің әділдігімді қабыл алыңыз→
Dialogue: 0,0:52:53.10,0:52:57.11,Default,,0000,0000,0000,,О.
Dialogue: 0,0:52:53.10,0:52:57.11,Default,,0000,0000,0000,,Чицуджо
Dialogue: 0,0:52:53.10,0:52:57.11,Default,,0000,0000,0000,,Бұл планетадағы жаңа тәртіп
Dialogue: 0,0:52:53.10,0:52:57.11,Default,,0000,0000,0000,,сызат
Dialogue: 0,0:52:53.10,0:52:57.11,Default,,0000,0000,0000,,Бірге салайық!
Dialogue: 0,0:52:57.11,0:53:01.08,Default,,0000,0000,0000,,Бастапқыда
Dialogue: 0,0:52:57.11,0:53:01.08,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:52:57.11,0:53:01.08,Default,,0000,0000,0000,,Менің жүрегім жаралған...
Dialogue: 0,0:53:01.08,0:53:03.11,Default,,0000,0000,0000,,Құлпынай
Dialogue: 0,0:53:01.08,0:53:03.11,Default,,0000,0000,0000,,Керемет шешім!
Dialogue: 0,0:53:03.11,0:53:07.08,Default,,0000,0000,0000,,Сөздер
Dialogue: 0,0:53:03.11,0:53:07.08,Default,,0000,0000,0000,,Егер сіз бас тартсаңыз
Dialogue: 0,0:53:03.11,0:53:07.08,Default,,0000,0000,0000,,Әне
Dialogue: 0,0:53:03.11,0:53:07.08,Default,,0000,0000,0000,,Апаңызды айтпай-ақ қояйын→
Dialogue: 0,0:53:07.08,0:53:12.09,Default,,0000,0000,0000,,О
Dialogue: 0,0:53:07.08,0:53:12.09,Default,,0000,0000,0000,,Тами
Dialogue: 0,0:53:07.08,0:53:12.09,Default,,0000,0000,0000,,Пирика адамдары одан да көп
Dialogue: 0,0:53:07.08,0:53:12.09,Default,,0000,0000,0000,,Гисей
Dialogue: 0,0:53:07.08,0:53:12.09,Default,,0000,0000,0000,,Өйткені бұл құрбандық.
Dialogue: 0,0:53:14.09,0:53:17.06,Default,,0000,0000,0000,,Папи-кун тәж кию рәсіміне қатысады! ?
Dialogue: 0,0:53:18.09,0:53:20.10,Default,,0000,0000,0000,,Балалар...
Dialogue: 0,0:53:20.10,0:53:23.10,Default,,0000,0000,0000,,Дракоруру жігіті
Dialogue: 0,0:53:20.10,0:53:23.10,Default,,0000,0000,0000,,...
Dialogue: 0,0:53:20.10,0:53:23.10,Default,,0000,0000,0000,,Сенден
Dialogue: 0,0:53:20.10,0:53:23.10,Default,,0000,0000,0000,,Пирика кезінде жарнамаланады.
Dialogue: 0,0:53:24.10,0:53:29.07,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:53:24.10,0:53:29.07,Default,,0000,0000,0000,,«Ол бұрынғы президент Папи де.
Dialogue: 0,0:53:24.10,0:53:29.07,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:53:24.10,0:53:29.07,Default,,0000,0000,0000,,Енді мен өзімнің Пифияммен біргемін».
Dialogue: 0,0:53:29.07,0:53:31.07,Default,,0000,0000,0000,,Командир Генбу!
Dialogue: 0,0:53:31.07,0:53:35.08,Default,,0000,0000,0000,,Ренраку
Dialogue: 0,0:53:31.07,0:53:35.08,Default,,0000,0000,0000,,Астыртын ұйымға қайта хабарласыңыз.
Dialogue: 0,0:53:31.07,0:53:35.08,Default,,0000,0000,0000,,Мені жіберуіңізді өтінемін!
Dialogue: 0,0:53:35.08,0:53:39.12,Default,,0000,0000,0000,,Асықпаңыз.
Dialogue: 0,0:53:35.08,0:53:39.12,Default,,0000,0000,0000,,...
Dialogue: 0,0:53:35.08,0:53:39.12,Default,,0000,0000,0000,,Гэнджу
Dialogue: 0,0:53:35.08,0:53:39.12,Default,,0000,0000,0000,,Қауіпсіздік күшейтілді.
Dialogue: 0,0:53:39.12,0:53:42.12,Default,,0000,0000,0000,,Сентоки
Dialogue: 0,0:53:39.12,0:53:42.12,Default,,0000,0000,0000,,Мед
Dialogue: 0,0:53:39.12,0:53:42.12,Default,,0000,0000,0000,,Біздің жауынгерлерде тым байқалады.
Dialogue: 0,0:53:42.12,0:53:46.12,Default,,0000,0000,0000,,Yakume
Dialogue: 0,0:53:42.12,0:53:46.12,Default,,0000,0000,0000,,Мм... бұл рөл
Dialogue: 0,0:53:42.12,0:53:46.12,Default,,0000,0000,0000,,Оны бізге қалдырыңыз!
Dialogue: 0,0:53:46.12,0:53:48.09,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:53:46.12,0:53:48.09,Default,,0000,0000,0000,,Ақымақ!
Dialogue: 0,0:53:48.09,0:53:51.09,Default,,0000,0000,0000,,Сіз Чикю халқы
Dialogue: 0,0:53:48.09,0:53:51.09,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,0:53:48.09,0:53:51.09,Default,,0000,0000,0000,,Осындай қауіпті жағдайда...
Dialogue: 0,0:53:51.09,0:53:54.13,Default,,0000,0000,0000,,Бұл адамдар
Dialogue: 0,0:53:51.09,0:53:54.13,Default,,0000,0000,0000,,Тайо
Dialogue: 0,0:53:51.09,0:53:54.13,Default,,0000,0000,0000,,Сіз оған сене аласыз!
Dialogue: 0,0:53:54.13,0:53:56.10,Default,,0000,0000,0000,,Току
Dialogue: 0,0:53:54.13,0:53:56.10,Default,,0000,0000,0000,,Әсіресе Doraemon →
Dialogue: 0,0:53:56.10,0:53:59.20,Default,,0000,0000,0000,,Өте жұмбақ құрал
Dialogue: 0,0:53:56.10,0:53:59.20,Default,,0000,0000,0000,,Менде көп →
Dialogue: 0,0:53:59.20,0:54:02.11,Default,,0000,0000,0000,,Бұл қандай қызық?
Dialogue: 0,0:53:59.20,0:54:02.11,Default,,0000,0000,0000,,Бұл ұзақ әңгіме болар еді, бірақ...
Dialogue: 0,0:54:02.11,0:54:04.11,Default,,0000,0000,0000,,Қараңыз, LocoRoco.
Dialogue: 0,0:54:02.11,0:54:04.11,Default,,0000,0000,0000,,Бір! бір!
Dialogue: 0,0:54:04.11,0:54:06.11,Default,,0000,0000,0000,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:54:06.11,0:54:08.08,Default,,0000,0000,0000,,Бір! Апыр-ай!
Dialogue: 0,0:54:09.11,0:54:13.12,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:54:09.11,0:54:13.12,Default,,0000,0000,0000,,Қол
Dialogue: 0,0:54:09.11,0:54:13.12,Default,,0000,0000,0000,,Папиді қайтарған қолдар
Dialogue: 0,0:54:09.11,0:54:13.12,Default,,0000,0000,0000,,Маған сеніңіз!
Dialogue: 0,0:54:13.12,0:54:17.12,Default,,0000,0000,0000,,Ал егер
Dialogue: 0,0:54:13.12,0:54:17.12,Default,,0000,0000,0000,,Бостандық альянсы жеңілсе ше →
Dialogue: 0,0:54:17.12,0:54:21.09,Default,,0000,0000,0000,,Біз де
Dialogue: 0,0:54:17.12,0:54:21.09,Default,,0000,0000,0000,,Тек мұны істеу жеткіліксіз, солай ма?
Dialogue: 0,0:54:22.09,0:54:24.13,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:54:24.13,0:54:28.10,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:54:24.13,0:54:28.10,Default,,0000,0000,0000,,Генбу-сан!
Dialogue: 0,0:54:28.10,0:54:30.10,Default,,0000,0000,0000,,Гунну….
Dialogue: 0,0:54:32.14,0:54:35.11,Default,,0000,0000,0000,,Теріс
Dialogue: 0,0:54:32.14,0:54:35.11,Default,,0000,0000,0000,,Мен Изуку Мидориямын!
Dialogue: 0,0:54:32.14,0:54:35.11,Default,,0000,0000,0000,,Жарайды, шешілді!
Dialogue: 0,0:54:35.11,0:54:37.11,Default,,0000,0000,0000,,Сенюсакусен
Dialogue: 0,0:54:35.11,0:54:37.11,Default,,0000,0000,0000,,Бұл инфильтрация операциясы!
Dialogue: 0,0:54:37.11,0:54:39.11,Default,,0000,0000,0000,,Мен және Нобита-кун...→
Dialogue: 0,0:54:39.11,0:54:43.11,Default,,0000,0000,0000,,Сонымен қатар, Джиан келе ала ма?
Dialogue: 0,0:54:39.11,0:54:43.11,Default,,0000,0000,0000,,О!
Dialogue: 0,0:54:43.11,0:54:46.12,Default,,0000,0000,0000,,Айтыңызшы, мені артта қалдырасыз.
Dialogue: 0,0:54:43.11,0:54:46.12,Default,,0000,0000,0000,,Мен сені жұдырықтаймын! Хахаха...!
Dialogue: 0,0:54:46.12,0:54:49.12,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:54:46.12,0:54:49.12,Default,,0000,0000,0000,,Гидті маған қалдырыңыз!
Dialogue: 0,0:54:49.12,0:54:51.12,Default,,0000,0000,0000,,Сәлем! неге
Dialogue: 0,0:54:49.12,0:54:51.12,Default,,0000,0000,0000,,Бармаймын ба?
Dialogue: 0,0:54:51.12,0:54:54.12,Default,,0000,0000,0000,,Russ
Dialogue: 0,0:54:51.12,0:54:54.12,Default,,0000,0000,0000,,Алыста жүргенде де өзіңізді қорғау маңызды.
Dialogue: 0,0:54:51.12,0:54:54.12,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:54:54.12,0:54:56.09,Default,,0000,0000,0000,,Дұрыс, Шизука-чан.
Dialogue: 0,0:54:56.09,0:54:58.13,Default,,0000,0000,0000,,Дораемон→
Dialogue: 0,0:54:58.13,0:55:01.13,Default,,0000,0000,0000,,Тебукуро
Dialogue: 0,0:54:58.13,0:55:01.13,Default,,0000,0000,0000,,Қант қызылшасы
Dialogue: 0,0:54:58.13,0:55:01.13,Default,,0000,0000,0000,,Техникалық қолғап және данышпан дулыға
Dialogue: 0,0:54:58.13,0:55:01.13,Default,,0000,0000,0000,,Оны алыңыз.
Dialogue: 0,0:55:01.13,0:55:03.13,Default,,0000,0000,0000,,Сіз не істейсіз? Сунео.
Dialogue: 0,0:55:03.13,0:55:06.10,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:55:03.13,0:55:06.10,Default,,0000,0000,0000,,Сейби
Dialogue: 0,0:55:03.13,0:55:06.10,Default,,0000,0000,0000,,Мен танкімді сақтаймын деп ойладым.
Dialogue: 0,0:55:07.14,0:55:09.11,Default,,0000,0000,0000,,Кокорозуйо
Dialogue: 0,0:55:07.14,0:55:09.11,Default,,0000,0000,0000,,Бұл сендіреді!
Dialogue: 0,0:55:09.11,0:55:13.11,Default,,0000,0000,0000,,Сонда қалғандары?
Dialogue: 0,0:55:09.11,0:55:13.11,Default,,0000,0000,0000,,Ресми
Dialogue: 0,0:55:09.11,0:55:13.11,Default,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:55:09.11,0:55:13.11,Default,,0000,0000,0000,,Жіберілгенге дейін демалыңыз.
Dialogue: 0,0:55:13.11,0:55:37.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:55:37.07,0:56:00.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:56:00.09,0:56:23.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:56:23.08,0:56:46.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:56:50.07,0:56:52.08,Default,,0000,0000,0000,,
Dialogue: 0,0:56:50.07,0:56:52.08,Default,,0000,0000,0000,,Біз кішігірім спутниктік белдеуден шықпақпыз.
Dialogue: 0,0:56:52.08,0:56:54.08,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:56:52.08,0:56:54.08,Default,,0000,0000,0000,,Шабуыл! ?
Dialogue: 0,0:56:54.08,0:56:56.08,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:56:54.08,0:56:56.08,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:56:54.08,0:56:56.08,Default,,0000,0000,0000,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:56:56.08,0:57:00.08,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:56:56.08,0:57:00.08,Default,,0000,0000,0000,,Эйсей
Dialogue: 0,0:56:56.08,0:57:00.08,Default,,0000,0000,0000,,Онымен шағын спутник соқтығысты.
Dialogue: 0,0:56:56.08,0:57:00.08,Default,,0000,0000,0000,,Кейде
Dialogue: 0,0:56:56.08,0:57:00.08,Default,,0000,0000,0000,,Бұл кейде болады.
Dialogue: 0,0:57:00.08,0:57:05.09,Default,,0000,0000,0000,,Инрёку
Dialogue: 0,0:57:00.08,0:57:05.09,Default,,0000,0000,0000,,О-
Dialogue: 0,0:57:00.08,0:57:05.09,Default,,0000,0000,0000,,Пириканың ауырлық күшімен тартылған
Dialogue: 0,0:57:00.08,0:57:05.09,Default,,0000,0000,0000,,Рюсей
Dialogue: 0,0:57:00.08,0:57:05.09,Default,,0000,0000,0000,,Метеорға айналып, құлады.
Dialogue: 0,0:57:05.09,0:57:07.09,Default,,0000,0000,0000,,Міне, солай!
Dialogue: 0,0:57:05.09,0:57:07.09,Default,,0000,0000,0000,,Қайсысы?
Dialogue: 0,0:57:07.09,0:57:09.09,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:57:07.09,0:57:09.09,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:57:09.09,0:57:11.09,Default,,0000,0000,0000,,Метеорит болып көріну
Dialogue: 0,0:57:09.09,0:57:11.09,Default,,0000,0000,0000,,Жәй ғана құла!
Dialogue: 0,0:57:11.09,0:57:14.10,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:57:11.09,0:57:14.10,Default,,0000,0000,0000,,Қызықты
Dialogue: 0,0:57:11.09,0:57:14.10,Default,,0000,0000,0000,,Қызық көрінеді!
Dialogue: 0,0:57:14.10,0:57:16.13,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:57:14.10,0:57:16.13,Default,,0000,0000,0000,,Сосан
Dialogue: 0,0:57:14.10,0:57:16.13,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:57:16.13,0:57:19.10,Default,,0000,0000,0000,,Ракка
Dialogue: 0,0:57:16.13,0:57:19.10,Default,,0000,0000,0000,,Еркін құлау басталады!
Dialogue: 0,0:57:20.20,0:57:22.11,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:57:22.11,0:57:28.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:57:28.11,0:57:31.11,Default,,0000,0000,0000,,Чихё
Dialogue: 0,0:57:28.11,0:57:31.11,Default,,0000,0000,0000,,Хантен
Dialogue: 0,0:57:28.11,0:57:31.11,Default,,0000,0000,0000,,Жер бетінде кері жүру! !
Dialogue: 0,0:57:34.12,0:57:36.12,Default,,0000,0000,0000,,Соқтығыс!
Dialogue: 0,0:57:34.12,0:57:36.12,Default,,0000,0000,0000,,Сона
Dialogue: 0,0:57:34.12,0:57:36.12,Default,,0000,0000,0000,,Соққыға дайындалыңыз!
Dialogue: 0,0:57:36.12,0:57:39.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:57:39.12,0:57:41.09,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:57:41.09,0:57:46.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:57:46.16,0:57:48.10,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:57:48.10,0:57:51.10,Default,,0000,0000,0000,,Кьюка
Dialogue: 0,0:57:48.10,0:57:51.10,Default,,0000,0000,0000,,Соку
Dialogue: 0,0:57:48.10,0:57:51.10,Default,,0000,0000,0000,,Арматураланған пластик бронь
Dialogue: 0,0:57:48.10,0:57:51.10,Default,,0000,0000,0000,,Бас тартпаңыз.
Dialogue: 0,0:57:51.10,0:57:53.10,Default,,0000,0000,0000,,О... мен істеймін...
Dialogue: 0,0:57:51.10,0:57:53.10,Default,,0000,0000,0000,,Нобита-сан?
Dialogue: 0,0:57:53.10,0:57:55.10,Default,,0000,0000,0000,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:57:56.11,0:57:59.11,Default,,0000,0000,0000,,Хокубу-сан сөйлескісі келеді
Dialogue: 0,0:57:56.11,0:57:59.11,Default,,0000,0000,0000,,Солтүстік таулы аймақта
Dialogue: 0,0:57:56.11,0:57:59.11,Default,,0000,0000,0000,,Ракка
Dialogue: 0,0:57:56.11,0:57:59.11,Default,,0000,0000,0000,,Метеордың құлауы расталды.
Dialogue: 0,0:57:59.11,0:58:01.11,Default,,0000,0000,0000,,Бірақ... бұл біртүрлі.
Dialogue: 0,0:58:01.11,0:58:03.18,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:58:01.11,0:58:03.18,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:58:03.18,0:58:05.11,Default,,0000,0000,0000,,Кибо
Dialogue: 0,0:58:03.18,0:58:05.11,Default,,0000,0000,0000,,Кура
Dialogue: 0,0:58:03.18,0:58:05.11,Default,,0000,0000,0000,,Метеордың өлшемімен салыстырғанда →
Dialogue: 0,0:58:05.11,0:58:07.08,Default,,0000,0000,0000,,Құлаудың зақымдалуы
Dialogue: 0,0:58:05.11,0:58:07.08,Default,,0000,0000,0000,,Бұл тым кішкентай.
Dialogue: 0,0:58:07.08,0:58:09.12,Default,,0000,0000,0000,,Бұл жерде.
Dialogue: 0,0:58:09.12,0:58:11.09,Default,,0000,0000,0000,,Сондықтан
Dialogue: 0,0:58:09.12,0:58:11.09,Default,,0000,0000,0000,,Сіз алдауға тырысасыз ба?
Dialogue: 0,0:58:15.09,0:58:17.09,Default,,0000,0000,0000,,Бұл Филипполис.
Dialogue: 0,0:58:17.09,0:58:19.10,Default,,0000,0000,0000,,Президент сонда→
Dialogue: 0,0:58:19.10,0:58:21.10,Default,,0000,0000,0000,,Хонбу
Dialogue: 0,0:58:19.10,0:58:21.10,Default,,0000,0000,0000,,Пифияның штаб-пәтерінде
Dialogue: 0,0:58:19.10,0:58:21.10,Default,,0000,0000,0000,,Тора
Dialogue: 0,0:58:19.10,0:58:21.10,Default,,0000,0000,0000,,Ол ұсталған болуы керек.
Dialogue: 0,0:58:26.10,0:58:29.11,Default,,0000,0000,0000,,Егер сіз өзіңіздің жер бетіңізде қалсаңыз
Dialogue: 0,0:58:26.10,0:58:29.11,Default,,0000,0000,0000,,Бұл сізді күдікті етеді.
Dialogue: 0,0:58:29.11,0:58:31.11,Default,,0000,0000,0000,,Томей
Dialogue: 0,0:58:29.11,0:58:31.11,Default,,0000,0000,0000,,Енді мөлдір болайық.
Dialogue: 0,0:58:31.11,0:58:33.11,Default,,0000,0000,0000,,Бірақ біз бір-бірімізді көре алмаймыз→
Dialogue: 0,0:58:33.11,0:58:35.11,Default,,0000,0000,0000,,Біз ажырасамыз.
Dialogue: 0,0:58:33.11,0:58:35.11,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:58:35.11,0:58:37.18,Default,,0000,0000,0000,,
Dialogue: 0,0:58:35.11,0:58:37.18,Default,,0000,0000,0000,,Онда уайымдамаңыз!
Dialogue: 0,0:58:37.18,0:58:39.18,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:58:37.18,0:58:39.18,Default,,0000,0000,0000,,Өйткені мен Піриканың итімін→
Dialogue: 0,0:58:39.18,0:58:42.12,Default,,0000,0000,0000,,Біртүрлі
Dialogue: 0,0:58:39.18,0:58:42.12,Default,,0000,0000,0000,,Маған кішкене бетперде керек
Dialogue: 0,0:58:39.18,0:58:42.12,Default,,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:58:42.12,0:58:44.09,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:58:45.12,0:58:47.09,Default,,0000,0000,0000,,Сізге бұл қалай ұнайды?
Dialogue: 0,0:58:45.12,0:58:47.09,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:58:47.09,0:58:51.09,Default,,0000,0000,0000,,Көңілсіз
Dialogue: 0,0:58:47.09,0:58:51.09,Default,,0000,0000,0000,,Омокаж
Dialogue: 0,0:58:47.09,0:58:51.09,Default,,0000,0000,0000,,Сол әдемі LocoRoco ізі
Dialogue: 0,0:58:47.09,0:58:51.09,Default,,0000,0000,0000,,Суко
Dialogue: 0,0:58:47.09,0:58:51.09,Default,,0000,0000,0000,,Ол аздап жоғалып кетті ме?
Dialogue: 0,0:58:51.09,0:58:53.10,Default,,0000,0000,0000,,Тіпті жоғалып кетті!
Dialogue: 0,0:58:54.10,0:58:58.07,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:58:54.10,0:58:58.07,Default,,0000,0000,0000,,Сауыттар домбыра ұнтағынан жасалған
Dialogue: 0,0:58:54.10,0:58:58.07,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:58:54.10,0:58:58.07,Default,,0000,0000,0000,,Шизу
Dialogue: 0,0:58:54.10,0:58:58.07,Default,,0000,0000,0000,,Оны жерге батырып жіберейік.
Dialogue: 0,0:58:59.10,0:59:02.11,Default,,0000,0000,0000,,Енді астыртын ұйымның жасырынған жеріне.
Dialogue: 0,0:58:59.10,0:59:02.11,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:58:59.10,0:59:02.11,Default,,0000,0000,0000,,Біз сізге жол көрсетеміз.
Dialogue: 0,0:59:02.11,0:59:04.07,Default,,0000,0000,0000,,Маған еріңіз!
Dialogue: 0,0:59:04.07,0:59:06.11,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:59:06.11,0:59:08.08,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:59:06.11,0:59:08.08,Default,,0000,0000,0000,,О!
Dialogue: 0,0:59:08.08,0:59:10.11,Default,,0000,0000,0000,,Mystery
Dialogue: 0,0:59:08.08,0:59:10.11,Default,,0000,0000,0000,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:59:08.08,0:59:10.11,Default,,0000,0000,0000,,Қызық, → кейін
Dialogue: 0,0:59:10.11,0:59:12.08,Default,,0000,0000,0000,,Аяқ
Dialogue: 0,0:59:10.11,0:59:12.08,Default,,0000,0000,0000,,Бүгін
Dialogue: 0,0:59:10.11,0:59:12.08,Default,,0000,0000,0000,,Олардың қадамдары тоқтады.
Dialogue: 0,0:59:12.08,0:59:15.08,Default,,0000,0000,0000,,Түтін сияқты жоғалатын нәрсе!
Dialogue: 0,0:59:12.08,0:59:15.08,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:59:12.08,0:59:15.08,Default,,0000,0000,0000,,Жақсы іздеңіз!
Dialogue: 0,0:59:15.08,0:59:19.09,Default,,0000,0000,0000,,Жоқ, мен олар туралы айтып отырмын.
Dialogue: 0,0:59:15.08,0:59:19.09,Default,,0000,0000,0000,,Жоғалу...
Dialogue: 0,0:59:24.09,0:59:27.10,Default,,0000,0000,0000,,Бұл Филипполис...
Dialogue: 0,0:59:27.10,0:59:33.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:59:33.10,0:59:35.07,Default,,0000,0000,0000,,Шуто
Dialogue: 0,0:59:33.10,0:59:35.07,Default,,0000,0000,0000,,Тот
Dialogue: 0,0:59:33.10,0:59:35.07,Default,,0000,0000,0000,,Бұл астананың жалғыз жері.
Dialogue: 0,0:59:35.07,0:59:37.07,Default,,0000,0000,0000,,Hitodoo
Dialogue: 0,0:59:35.07,0:59:37.07,Default,,0000,0000,0000,,Суку
Dialogue: 0,0:59:35.07,0:59:37.07,Default,,0000,0000,0000,,Жүріп жүргендер көп емес.
Dialogue: 0,0:59:37.07,0:59:39.08,Default,,0000,0000,0000,,Бұрын басқаша болатын.
Dialogue: 0,0:59:39.08,0:59:41.08,Default,,0000,0000,0000,,Гилмор
Dialogue: 0,0:59:39.08,0:59:41.08,Default,,0000,0000,0000,,О.
Dialogue: 0,0:59:39.08,0:59:41.08,Default,,0000,0000,0000,,Төңкеріске дейін →
Dialogue: 0,0:59:41.08,0:59:43.11,Default,,0000,0000,0000,,Бұл өте жанды болды.
Dialogue: 0,0:59:43.11,0:59:46.08,Default,,0000,0000,0000,,...
Dialogue: 0,0:59:43.11,0:59:46.08,Default,,0000,0000,0000,,Қала
Dialogue: 0,0:59:43.11,0:59:46.08,Default,,0000,0000,0000,,...
Dialogue: 0,0:59:43.11,0:59:46.08,Default,,0000,0000,0000,,Соғыс жалыны бүкіл қалаға тарады.
Dialogue: 0,0:59:43.11,0:59:46.08,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:59:43.11,0:59:46.08,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,0:59:43.11,0:59:46.08,Default,,0000,0000,0000,,Адамдар таусылды →
Dialogue: 0,0:59:46.08,0:59:49.09,Default,,0000,0000,0000,,Менің қазір жұмыс істеп жатқаным
Dialogue: 0,0:59:46.08,0:59:49.09,Default,,0000,0000,0000,,Тек Пифия….
Dialogue: 0,0:59:50.12,0:59:54.09,Default,,0000,0000,0000,,Ой! Бүкіл қалада
Dialogue: 0,0:59:50.12,0:59:54.09,Default,,0000,0000,0000,,Шозоға
Dialogue: 0,0:59:50.12,0:59:54.09,Default,,0000,0000,0000,,Генералдың суретінде→
Dialogue: 0,0:59:54.09,0:59:56.09,Default,,0000,0000,0000,,Сақ болыңыз.
Dialogue: 0,0:59:56.09,0:59:59.10,Default,,0000,0000,0000,,Каншисочи
Dialogue: 0,0:59:56.09,0:59:59.10,Default,,0000,0000,0000,,Көздер бақылау құралы болып табылады.
Dialogue: 0,0:59:59.10,1:00:01.06,Default,,0000,0000,0000,,Сүйікті сүйікті!
Dialogue: 0,1:00:01.06,1:00:03.10,Default,,0000,0000,0000,,
Dialogue: 0,1:00:01.06,1:00:03.10,Default,,0000,0000,0000,,Адамдар қашан және қайда барса да→
Dialogue: 0,1:00:03.10,1:00:06.10,Default,,0000,0000,0000,,Миха
Dialogue: 0,1:00:03.10,1:00:06.10,Default,,0000,0000,0000,,Мені Пифия бақылап отыр.
Dialogue: 0,1:00:06.10,1:00:08.10,Default,,0000,0000,0000,,Қорқынышты...!
Dialogue: 0,1:00:08.10,1:00:12.08,Default,,0000,0000,0000,,Пирика бұрынғыдай
Dialogue: 0,1:00:08.10,1:00:12.08,Default,,0000,0000,0000,,Қызыл
Dialogue: 0,1:00:08.10,1:00:12.08,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,1:00:08.10,1:00:12.08,Default,,0000,0000,0000,,Жарық және көңілді орынды қалай жасауға болады→
Dialogue: 0,1:00:12.08,1:00:15.08,Default,,0000,0000,0000,,Бірге
Dialogue: 0,1:00:12.08,1:00:15.08,Default,,0000,0000,0000,,Біз Гилморды жеңуіміз керек!
Dialogue: 0,1:00:15.08,1:00:17.11,Default,,0000,0000,0000,,Жіп
Dialogue: 0,1:00:15.08,1:00:17.11,Default,,0000,0000,0000,,Ол үшін мүмкіндігінше тезірек, тіпті бір секунд болса да→
Dialogue: 0,1:00:17.11,1:00:20.12,Default,,0000,0000,0000,,...
Dialogue: 0,1:00:17.11,1:00:20.12,Default,,0000,0000,0000,,Біз президент пен Пиина-саманы құтқаруымыз керек!
Dialogue: 0,1:00:20.12,1:00:23.12,Default,,0000,0000,0000,,екеуміз де шараптан бір-бір жұтым татып қойдық…
Dialogue: 0,1:00:20.12,1:00:23.12,Default,,0000,0000,0000,,Бостандық альянсының астыртын ұйымы...
Dialogue: 0,1:00:23.12,1:00:26.09,Default,,0000,0000,0000,,астыртын ұйым
Dialogue: 0,1:00:23.12,1:00:26.09,Default,,0000,0000,0000,,Бұл жасырыну...
Dialogue: 0,1:00:26.09,1:00:28.12,Default,,0000,0000,0000,,Ол қайда?
Dialogue: 0,1:00:28.12,1:00:30.09,Default,,0000,0000,0000,,Шиккай
Dialogue: 0,1:00:28.12,1:00:30.09,Default,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,1:00:28.12,1:00:30.09,Default,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,1:00:28.12,1:00:30.09,Default,,0000,0000,0000,,Кешіріңіз. Мен өтіп кеттім.
Dialogue: 0,1:00:30.09,1:00:32.16,Default,,0000,0000,0000,,Да!
Dialogue: 0,1:00:30.09,1:00:32.16,Default,,0000,0000,0000,,Зуко!
Dialogue: 0,1:00:32.16,1:00:35.10,Default,,0000,0000,0000,,Хайкё
Dialogue: 0,1:00:32.16,1:00:35.10,Default,,0000,0000,0000,,Бұрын қараусыз қалған ғимараттың алдында
Dialogue: 0,1:00:32.16,1:00:35.10,Default,,0000,0000,0000,,Сіз өттіңіз, солай ма?
Dialogue: 0,1:00:35.10,1:00:37.07,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:00:35.10,1:00:37.07,Default,,0000,0000,0000,,Гучи
Dialogue: 0,1:00:35.10,1:00:37.07,Default,,0000,0000,0000,,Ішінде кіреберіс бар...
Dialogue: 0,1:00:37.07,1:00:40.10,Default,,0000,0000,0000,,Барлығына! ? Сыртқы түрі...!
Dialogue: 0,1:00:40.10,1:00:42.07,Default,,0000,0000,0000,,Ах! !
Dialogue: 0,1:00:40.10,1:00:42.07,Default,,0000,0000,0000,,Мен абайсызда болдым!
Dialogue: 0,1:00:42.07,1:00:46.11,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:00:42.07,1:00:46.11,Default,,0000,0000,0000,,Лак қаншалықты тиімді?
Dialogue: 0,1:00:42.07,1:00:46.11,Default,,0000,0000,0000,,Оның мерзімі 4 сағатта бітті!
Dialogue: 0,1:00:46.11,1:00:48.11,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,1:00:46.11,1:00:48.11,Default,,0000,0000,0000,,Қазір не болып жатыр?
Dialogue: 0,1:00:48.11,1:00:51.11,Default,,0000,0000,0000,,Бұл бүкіл оқиға әуесқойларға да тамаша әңгіме болады.
Dialogue: 0,1:00:48.11,1:00:51.11,Default,,0000,0000,0000,,А... Тек қал... Күте тұр!
Dialogue: 0,1:00:51.11,1:00:56.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:00:56.12,1:00:58.12,Default,,0000,0000,0000,,Міне!
Dialogue: 0,1:00:58.12,1:01:00.09,Default,,0000,0000,0000,,Жолдан кет!
Dialogue: 0,1:00:58.12,1:01:00.09,Default,,0000,0000,0000,,Ачача...!
Dialogue: 0,1:01:00.09,1:01:02.09,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,1:01:00.09,1:01:02.09,Default,,0000,0000,0000,,Идиот!
Dialogue: 0,1:01:13.14,1:01:15.20,Default,,0000,0000,0000,,
Dialogue: 0,1:01:15.20,1:01:17.11,Default,,0000,0000,0000,,Махаббат сөздері
Dialogue: 0,1:01:15.20,1:01:17.11,Default,,0000,0000,0000,,⚞Құпия сөз дегеніміз не?
Dialogue: 0,1:01:17.11,1:01:19.08,Default,,0000,0000,0000,,I
Dialogue: 0,1:01:17.11,1:01:19.08,Default,,0000,0000,0000,,Бізге еркіндік бер!
Dialogue: 0,1:01:21.11,1:01:23.11,Default,,0000,0000,0000,,Бұл LocoRoco емес пе?
Dialogue: 0,1:01:25.11,1:01:28.12,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,1:01:25.11,1:01:28.12,Default,,0000,0000,0000,,Аман-есен жеткенің үшін жарайсың.
Dialogue: 0,1:01:28.12,1:01:32.12,Default,,0000,0000,0000,,Эйсейкичи
Dialogue: 0,1:01:28.12,1:01:32.12,Default,,0000,0000,0000,,Ренраку
Dialogue: 0,1:01:28.12,1:01:32.12,Default,,0000,0000,0000,,Спутниктік базамен байланысу мүмкін емес
Dialogue: 0,1:01:28.12,1:01:32.12,Default,,0000,0000,0000,,Мен қиыншылыққа тап болдым.
Dialogue: 0,1:01:32.12,1:01:36.09,Default,,0000,0000,0000,,Енді келесіге көшейік
Dialogue: 0,1:01:32.12,1:01:36.09,Default,,0000,0000,0000,,Сецумэй
Dialogue: 0,1:01:32.12,1:01:36.09,Default,,0000,0000,0000,,Стратегияны түсіндіремін.
Dialogue: 0,1:01:36.09,1:01:39.10,Default,,0000,0000,0000,,Миохо
Dialogue: 0,1:01:36.09,1:01:39.10,Default,,0000,0000,0000,,Операция ертең таңғы сағат 8:00-де басталады!
Dialogue: 0,1:01:39.10,1:01:42.10,Default,,0000,0000,0000,,Дзётаро
Dialogue: 0,1:01:39.10,1:01:42.10,Default,,0000,0000,0000,,Кантей
Dialogue: 0,1:01:39.10,1:01:42.10,Default,,0000,0000,0000,,Негізгі күш ресми резиденцияда... мм...
Dialogue: 0,1:01:42.10,1:01:44.13,Default,,0000,0000,0000,,Қалғаны менмін.
Dialogue: 0,1:01:44.13,1:01:46.10,Default,,0000,0000,0000,,Охон.
Dialogue: 0,1:01:46.10,1:01:50.14,Default,,0000,0000,0000,,Менің айтайын дегенімді мұқият тыңда.
Dialogue: 0,1:01:46.10,1:01:50.14,Default,,0000,0000,0000,,Оны басыңызға түртіңіз.
Dialogue: 0,1:01:50.14,1:01:52.11,Default,,0000,0000,0000,,Учуу
Dialogue: 0,1:01:50.14,1:01:52.11,Default,,0000,0000,0000,,Зерттеу
Dialogue: 0,1:01:50.14,1:01:52.11,Default,,0000,0000,0000,,Мәселе ғаламмен ынтымақтастықта.
Dialogue: 0,1:01:52.11,1:01:56.11,Default,,0000,0000,0000,,Пун
Dialogue: 0,1:01:52.11,1:01:56.11,Default,,0000,0000,0000,,Егер уақыт бір минутқа да өшірілсе
Dialogue: 0,1:01:52.11,1:01:56.11,Default,,0000,0000,0000,,Операция сәтті болмайды.
Dialogue: 0,1:01:56.11,1:02:05.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:02:05.15,1:02:09.13,Default,,0000,0000,0000,,Бұл керемет, Шизука-чан!
Dialogue: 0,1:02:05.15,1:02:09.13,Default,,0000,0000,0000,,Мен де саған тең келе алмаймын.
Dialogue: 0,1:02:09.13,1:02:12.13,Default,,0000,0000,0000,,Әлі жоқ.
Dialogue: 0,1:02:09.13,1:02:12.13,Default,,0000,0000,0000,,Джотацу
Dialogue: 0,1:02:09.13,1:02:12.13,Default,,0000,0000,0000,,Маған көбірек жақсарту керек...
Dialogue: 0,1:02:15.16,1:02:18.13,Default,,0000,0000,0000,,Көшбасшы!
Dialogue: 0,1:02:15.16,1:02:18.13,Default,,0000,0000,0000,,♬ Star Platinum
Dialogue: 0,1:02:15.16,1:02:18.13,Default,,0000,0000,0000,,Хонбу
Dialogue: 0,1:02:15.16,1:02:18.13,Default,,0000,0000,0000,,Ақпарат
Dialogue: 0,1:02:15.16,1:02:18.13,Default,,0000,0000,0000,,2 күн бұрын Pythia штаб-пәтерін бақылау кезінде →
Dialogue: 0,1:02:18.13,1:02:22.11,Default,,0000,0000,0000,,Йотофумей
Dialogue: 0,1:02:18.13,1:02:22.11,Default,,0000,0000,0000,,Ғарыш кемесінен мақсаты белгісіз машина табылды.
Dialogue: 0,1:02:18.13,1:02:22.11,Default,,0000,0000,0000,,♬ Star Platinum
Dialogue: 0,1:02:18.13,1:02:22.11,Default,,0000,0000,0000,,Мен оны әкеліп жатқанын көрдім.
Dialogue: 0,1:02:23.14,1:02:25.14,Default,,0000,0000,0000,,Эйзо
Dialogue: 0,1:02:23.14,1:02:25.14,Default,,0000,0000,0000,,Бұл сол кездегі кадрлар.
Dialogue: 0,1:02:25.14,1:02:27.11,Default,,0000,0000,0000,,Кішкентай жарық!
Dialogue: 0,1:02:27.11,1:02:29.15,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:02:27.11,1:02:29.15,Default,,0000,0000,0000,,Оны таптым!
Dialogue: 0,1:02:29.15,1:02:31.15,Default,,0000,0000,0000,,Пифияның штаб-пәтері!
Dialogue: 0,1:02:31.15,1:02:37.22,Default,,0000,0000,0000,,Ертең
Dialogue: 0,1:02:31.15,1:02:37.22,Default,,0000,0000,0000,,Жарайды, ертең біз де.
Dialogue: 0,1:02:31.15,1:02:37.22,Default,,0000,0000,0000,,Даққан
Dialogue: 0,1:02:31.15,1:02:37.22,Default,,0000,0000,0000,,Аздап
Dialogue: 0,1:02:31.15,1:02:37.22,Default,,0000,0000,0000,,Кіші жарықты қайтарып алу операциясы жүріп жатыр.
Dialogue: 0,1:02:37.22,1:02:39.22,Default,,0000,0000,0000,,⚟ (аяқ дыбысы)
Dialogue: 0,1:02:37.22,1:02:39.22,Default,,0000,0000,0000,,Даққан дегеніміз не?
Dialogue: 0,1:02:39.22,1:02:41.12,Default,,0000,0000,0000,,Ұрланған
Dialogue: 0,1:02:39.22,1:02:41.12,Default,,0000,0000,0000,,Оны қайтарып алу деген сөз!
Dialogue: 0,1:02:39.22,1:02:41.12,Default,,0000,0000,0000,,
Dialogue: 0,1:02:41.12,1:02:44.13,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,1:02:41.12,1:02:44.13,Default,,0000,0000,0000,,Бұл қиын! Пифия сыртта!
Dialogue: 0,1:02:44.13,1:02:46.20,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,1:02:46.20,1:02:48.13,Default,,0000,0000,0000,,Иә...!
Dialogue: 0,1:02:46.20,1:02:48.13,Default,,0000,0000,0000,,Хигучи расталды.
Dialogue: 0,1:02:48.13,1:02:50.13,Default,,0000,0000,0000,,Қалдықтар
Dialogue: 0,1:02:48.13,1:02:50.13,Default,,0000,0000,0000,,Кеттік
Dialogue: 0,1:02:48.13,1:02:50.13,Default,,0000,0000,0000,,Пайдасыз қарсылықты тоқтатыңыз!
Dialogue: 0,1:02:56.14,1:02:58.11,Default,,0000,0000,0000,,Асығыңыз, асығыңыз...
Dialogue: 0,1:02:56.14,1:02:58.11,Default,,0000,0000,0000,,Ол келе жатыр. Кешіріңіз.
Dialogue: 0,1:03:02.15,1:03:04.15,Default,,0000,0000,0000,,Аня ня ня ня...!
Dialogue: 0,1:03:02.15,1:03:04.15,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:03:04.15,1:03:06.15,Default,,0000,0000,0000,,Ах... о...!
Dialogue: 0,1:03:04.15,1:03:06.15,Default,,0000,0000,0000,,Ой!
Dialogue: 0,1:03:06.15,1:03:08.12,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,1:03:06.15,1:03:08.12,Default,,0000,0000,0000,,LocoRoco Маған еріңіз.
Dialogue: 0,1:03:06.15,1:03:08.12,Default,,0000,0000,0000,,Бір!
Dialogue: 0,1:03:08.12,1:03:11.12,Default,,0000,0000,0000,,Көшбасшы ше?
Dialogue: 0,1:03:08.12,1:03:11.12,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:03:08.12,1:03:11.12,Default,,0000,0000,0000,,Тағы кездескенше.
Dialogue: 0,1:03:13.12,1:03:15.12,Default,,0000,0000,0000,,Жүр, осы жаққа.
Dialogue: 0,1:03:18.13,1:03:22.10,Default,,0000,0000,0000,,Жарайды, шық!
Dialogue: 0,1:03:18.13,1:03:22.10,Default,,0000,0000,0000,,Харизма!
Dialogue: 0,1:03:18.13,1:03:22.10,Default,,0000,0000,0000,,Баяу жүріңіз!
Dialogue: 0,1:03:23.13,1:03:26.10,Default,,0000,0000,0000,,(пиф сарбаздары)
Dialogue: 0,1:03:23.13,1:03:26.10,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,1:03:23.13,1:03:26.10,Default,,0000,0000,0000,,Біртүрлі әрекет жасасаң, мен сені атып тастаймын!
Dialogue: 0,1:03:28.14,1:03:31.11,Default,,0000,0000,0000,,Қараңдар! Сол жігіттер...
Dialogue: 0,1:03:34.11,1:03:36.15,Default,,0000,0000,0000,,Дегенмен—
Dialogue: 0,1:03:36.15,1:03:39.15,Default,,0000,0000,0000,,Сіз біраз ұсталған сияқтысыз...
Dialogue: 0,1:03:39.15,1:03:41.12,Default,,0000,0000,0000,,Біз
Dialogue: 0,1:03:39.15,1:03:41.12,Default,,0000,0000,0000,,Ол қоса берілген...
Dialogue: 0,1:03:41.12,1:03:43.12,Default,,0000,0000,0000,,Қарғыс атсын... Қайтып, көмектесейік!
Dialogue: 0,1:03:43.12,1:03:47.09,Default,,0000,0000,0000,,Мен қазір ұсталсам
Dialogue: 0,1:03:43.12,1:03:47.09,Default,,0000,0000,0000,,Ганба
Dialogue: 0,1:03:43.12,1:03:47.09,Default,,0000,0000,0000,,Әркімнің еңбегі зая кетеді!
Dialogue: 0,1:03:47.09,1:03:50.09,Default,,0000,0000,0000,,Оның артында қандай себеп тұрса да,
Dialogue: 0,1:03:47.09,1:03:50.09,Default,,0000,0000,0000,,Тіпті біз ғана →
Dialogue: 0,1:03:50.09,1:03:54.10,Default,,0000,0000,0000,,Кішкентай шамды қайтарыңыз
Dialogue: 0,1:03:50.09,1:03:54.10,Default,,0000,0000,0000,,Олармен күрес!
Dialogue: 0,1:03:54.10,1:03:57.10,Default,,0000,0000,0000,,
Dialogue: 0,1:03:54.10,1:03:57.10,Default,,0000,0000,0000,,«Генерал, біз ақыры білдік».
Dialogue: 0,1:03:57.10,1:03:59.10,Default,,0000,0000,0000,,Хорьо
Dialogue: 0,1:03:57.10,1:03:59.10,Default,,0000,0000,0000,,«Подольный тұтқындардан →
Dialogue: 0,1:03:59.10,1:04:03.11,Default,,0000,0000,0000,,Бостандық альянсының штаб-пәтері орналасқан жерсеріктің орналасқан жері
Dialogue: 0,1:03:59.10,1:04:03.11,Default,,0000,0000,0000,,сұрадым».
Dialogue: 0,1:04:03.11,1:04:05.11,Default,,0000,0000,0000,,Қытай шамы
Dialogue: 0,1:04:03.11,1:04:05.11,Default,,0000,0000,0000,,Жарайсың хатшы мырза.
Dialogue: 0,1:04:05.11,1:04:09.18,Default,,0000,0000,0000,,Сукогеки
Dialogue: 0,1:04:05.11,1:04:09.18,Default,,0000,0000,0000,,Депрессия
Dialogue: 0,1:04:05.11,1:04:09.18,Default,,0000,0000,0000,,Бірден жаудың штабына жан-жақты шабуыл жасауға көшіңіз.
Dialogue: 0,1:04:09.18,1:04:12.11,Default,,0000,0000,0000,,Темекі
Dialogue: 0,1:04:09.18,1:04:12.11,Default,,0000,0000,0000,,Ұшқышсыз жауынгерлерді жинаңыз
Dialogue: 0,1:04:09.18,1:04:12.11,Default,,0000,0000,0000,,Мен оны лақтырамын!
Dialogue: 0,1:04:12.11,1:04:15.12,Default,,0000,0000,0000,,...
Dialogue: 0,1:04:12.11,1:04:15.12,Default,,0000,0000,0000,,«Мейірім көрсетпе!»
Dialogue: 0,1:04:12.11,1:04:15.12,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:04:16.12,1:04:18.12,Default,,0000,0000,0000,,Бұл ұшқышсыз жауынгер ме?
Dialogue: 0,1:04:18.12,1:04:22.09,Default,,0000,0000,0000,,Куугун
Dialogue: 0,1:04:18.12,1:04:22.09,Default,,0000,0000,0000,,Шурёку
Dialogue: 0,1:04:18.12,1:04:22.09,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,1:04:18.12,1:04:22.09,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,1:04:18.12,1:04:22.09,Default,,0000,0000,0000,,Әуе күштерінің негізгі күшін жіберген дұрыс
Dialogue: 0,1:04:18.12,1:04:22.09,Default,,0000,0000,0000,,Мен сенімдімін...
Dialogue: 0,1:04:22.09,1:04:25.13,Default,,0000,0000,0000,,Генерал қорқады.
Dialogue: 0,1:04:25.13,1:04:28.10,Default,,0000,0000,0000,,Жоқ... біздің құрбандық?
Dialogue: 0,1:04:28.10,1:04:31.10,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,1:04:28.10,1:04:31.10,Default,,0000,0000,0000,,Сай
Dialogue: 0,1:04:28.10,1:04:31.10,Default,,0000,0000,0000,,На
Dialogue: 0,1:04:28.10,1:04:31.10,Default,,0000,0000,0000,,Қалып құйылды.
Dialogue: 0,1:04:32.13,1:04:36.14,Default,,0000,0000,0000,,Ұшқышсыз жойғыш эскадрилья
Dialogue: 0,1:04:32.13,1:04:36.14,Default,,0000,0000,0000,,Шағын спутниктік аймаққа орналасыңыз!
Dialogue: 0,1:04:36.14,1:04:38.11,Default,,0000,0000,0000,,О.
Dialogue: 0,1:04:36.14,1:04:38.11,Default,,0000,0000,0000,,Еш ойланбаңыз!
Dialogue: 0,1:04:36.14,1:04:38.11,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:04:38.11,1:04:41.08,Default,,0000,0000,0000,,Ханран
Dialogue: 0,1:04:38.11,1:04:41.08,Default,,0000,0000,0000,,Жалпы қорқатын нәрсе – бүлік.
Dialogue: 0,1:04:41.08,1:04:44.18,Default,,0000,0000,0000,,Тіпті бізге сенуге болмайды...
Dialogue: 0,1:04:44.18,1:05:07.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:05:07.10,1:05:09.11,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,1:05:13.11,1:05:16.08,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,1:05:13.11,1:05:16.08,Default,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,1:05:23.09,1:05:27.06,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,1:05:23.09,1:05:27.06,Default,,0000,0000,0000,,Пифияның ұшқышсыз истребительі тура жүреді
Dialogue: 0,1:05:23.09,1:05:27.06,Default,,0000,0000,0000,,Мына жақта келе жатыр!
Dialogue: 0,1:05:27.06,1:05:30.09,Default,,0000,0000,0000,,Нанбяку
Dialogue: 0,1:05:27.06,1:05:30.09,Default,,0000,0000,0000,,Ештеңе
Dialogue: 0,1:05:27.06,1:05:30.09,Default,,0000,0000,0000,,Тайгун
Dialogue: 0,1:05:27.06,1:05:30.09,Default,,0000,0000,0000,,Жүздік немесе мыңдық үлкен армия...
Dialogue: 0,1:05:30.09,1:05:34.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:05:34.06,1:05:37.10,Default,,0000,0000,0000,,Яку
Dialogue: 0,1:05:34.06,1:05:37.10,Default,,0000,0000,0000,,Джиканго
Dialogue: 0,1:05:34.06,1:05:37.10,Default,,0000,0000,0000,,Шамамен 1 сағаттан кейін
Dialogue: 0,1:05:34.06,1:05:37.10,Default,,0000,0000,0000,,Точаку
Dialogue: 0,1:05:34.06,1:05:37.10,Default,,0000,0000,0000,,Мико
Dialogue: 0,1:05:34.06,1:05:37.10,Default,,0000,0000,0000,,Келеді деп күтілуде!
Dialogue: 0,1:05:37.10,1:05:40.10,Default,,0000,0000,0000,,《Ақыры осы жерді таптым...》
Dialogue: 0,1:05:40.10,1:05:42.07,Default,,0000,0000,0000,,Зенки
Dialogue: 0,1:05:40.10,1:05:42.07,Default,,0000,0000,0000,,Кинкю Хасшин
Dialogue: 0,1:05:40.10,1:05:42.07,Default,,0000,0000,0000,,Барлық ұшақтарды төтенше жағдайда ұшыру!
Dialogue: 0,1:05:43.07,1:05:45.07,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,1:05:46.08,1:05:48.08,Default,,0000,0000,0000,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,1:05:46.08,1:05:48.08,Default,,0000,0000,0000,,Сунео мырза!
Dialogue: 0,1:05:51.08,1:05:55.08,Default,,0000,0000,0000,,...
Dialogue: 0,1:05:51.08,1:05:55.08,Default,,0000,0000,0000,,Сорёку
Dialogue: 0,1:05:51.08,1:05:55.08,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:05:51.08,1:05:55.08,Default,,0000,0000,0000,,«Әркім бар күшімен,
Dialogue: 0,1:05:51.08,1:05:55.08,Default,,0000,0000,0000,,Гейгеки
Dialogue: 0,1:05:51.08,1:05:55.08,Default,,0000,0000,0000,,Кесу! »
Dialogue: 0,1:05:55.08,1:05:58.09,Default,,0000,0000,0000,,Сунео-сан! Қайда бардың?
Dialogue: 0,1:05:58.09,1:06:04.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:06:04.09,1:06:06.10,Default,,0000,0000,0000,,Бұл Сунео-сандікі...
Dialogue: 0,1:06:06.10,1:06:12.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:06:12.07,1:06:14.04,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,1:06:12.07,1:06:14.04,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,1:06:16.11,1:06:19.08,Default,,0000,0000,0000,,Мен ойлағандай…
Dialogue: 0,1:06:16.11,1:06:19.08,Default,,0000,0000,0000,,Шизука-чан...?
Dialogue: 0,1:06:19.08,1:06:22.08,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Осындай жерде.
Dialogue: 0,1:06:22.08,1:06:25.08,Default,,0000,0000,0000,,Жау келе жатыр. Мен жасыруым керек!
Dialogue: 0,1:06:25.08,1:06:29.09,Default,,0000,0000,0000,,Енді сіздің танк
Dialogue: 0,1:06:25.08,1:06:29.09,Default,,0000,0000,0000,,Катсуяку
Dialogue: 0,1:06:25.08,1:06:29.09,Default,,0000,0000,0000,,Белсенді болудың уақыты келді, солай ма?
Dialogue: 0,1:06:29.09,1:06:33.09,Default,,0000,0000,0000,,Неше жүздік немесе мыңдық қарсылас?
Dialogue: 0,1:06:29.09,1:06:33.09,Default,,0000,0000,0000,,Бұл мүмкін емес!
Dialogue: 0,1:06:33.09,1:06:36.06,Default,,0000,0000,0000,,Сондықтан мен осындай планетаға келдім
Dialogue: 0,1:06:33.09,1:06:36.06,Default,,0000,0000,0000,,Мен оны жек көрдім!
Dialogue: 0,1:06:37.09,1:06:42.06,Default,,0000,0000,0000,,Жалпы мен
Dialogue: 0,1:06:37.09,1:06:42.06,Default,,0000,0000,0000,,...
Dialogue: 0,1:06:37.09,1:06:42.06,Default,,0000,0000,0000,,Ұрысқысы келетіні туралы бір ауыз сөз де жоқ...
Dialogue: 0,1:06:42.06,1:06:55.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:06:57.11,1:07:06.19,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:07:06.19,1:07:08.09,Default,,0000,0000,0000,,Тіпті мен қорқамын...
Dialogue: 0,1:07:08.09,1:07:10.09,Default,,0000,0000,0000,,Бірақ...!
Dialogue: 0,1:07:12.09,1:07:15.06,Default,,0000,0000,0000,,Мен осылай жеңілетініме сене алар емеспін.
Dialogue: 0,1:07:12.09,1:07:15.06,Default,,0000,0000,0000,,Соншалықты аянышты емес!
Dialogue: 0,1:07:17.10,1:07:20.07,Default,,0000,0000,0000,,Қолыңыздан келгенше көп нәрсені жасаңыз
Dialogue: 0,1:07:17.10,1:07:20.07,Default,,0000,0000,0000,,Менің мұны істеуден басқа амалым жоқ!
Dialogue: 0,1:07:24.07,1:07:27.11,Default,,0000,0000,0000,,Бұл Пифияның штаб-пәтері.
Dialogue: 0,1:07:27.11,1:07:31.08,Default,,0000,0000,0000,,Міне
Dialogue: 0,1:07:27.11,1:07:31.08,Default,,0000,0000,0000,,...
Dialogue: 0,1:07:27.11,1:07:31.08,Default,,0000,0000,0000,,Ичибансуку
Dialogue: 0,1:07:27.11,1:07:31.08,Default,,0000,0000,0000,,Цууюумон
Dialogue: 0,1:07:27.11,1:07:31.08,Default,,0000,0000,0000,,Кіру мен шығудың ең аз саны бар бүйірлік қақпа.
Dialogue: 0,1:07:31.08,1:07:34.18,Default,,0000,0000,0000,,Сол ғимаратта
Dialogue: 0,1:07:31.08,1:07:34.18,Default,,0000,0000,0000,,Кішкене шам бар.
Dialogue: 0,1:07:34.18,1:07:36.12,Default,,0000,0000,0000,,Иә. Қарап шығудың бәрі осы ма?
Dialogue: 0,1:07:36.12,1:07:38.12,Default,,0000,0000,0000,,
Dialogue: 0,1:07:36.12,1:07:38.12,Default,,0000,0000,0000,,Мен бұл жерде Пифияның көп екеніне сенімдімін→
Dialogue: 0,1:07:38.12,1:07:42.06,Default,,0000,0000,0000,,Тәж киюге дайындық кезінде
Dialogue: 0,1:07:38.12,1:07:42.06,Default,,0000,0000,0000,,Немесе
Dialogue: 0,1:07:38.12,1:07:42.06,Default,,0000,0000,0000,,Оларды итеріп жібереді.
Dialogue: 0,1:07:42.06,1:07:45.09,Default,,0000,0000,0000,,Қазір уақыт
Dialogue: 0,1:07:42.06,1:07:45.09,Default,,0000,0000,0000,,Сенюу
Dialogue: 0,1:07:42.06,1:07:45.09,Default,,0000,0000,0000,,Сондықтан бұл ішке ену мүмкіндігі...
Dialogue: 0,1:07:45.09,1:07:47.10,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,1:07:50.10,1:07:52.13,Default,,0000,0000,0000,,Егер сіз мұны кисеңіз →
Dialogue: 0,1:07:52.13,1:07:56.11,Default,,0000,0000,0000,,Мичибата
Dialogue: 0,1:07:52.13,1:07:56.11,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,1:07:52.13,1:07:56.11,Default,,0000,0000,0000,,Жол жиегіндегі тас сияқты
Dialogue: 0,1:07:52.13,1:07:56.11,Default,,0000,0000,0000,,Танин
Dialogue: 0,1:07:52.13,1:07:56.11,Default,,0000,0000,0000,,Мүлде
Dialogue: 0,1:07:52.13,1:07:56.11,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:07:52.13,1:07:56.11,Default,,0000,0000,0000,,Басқа адамдар сізге мүлдем мән бермейді.
Dialogue: 0,1:07:56.11,1:07:59.07,Default,,0000,0000,0000,,Егер бұл
Dialogue: 0,1:07:56.11,1:07:59.07,Default,,0000,0000,0000,,Уақыт бітеді деп уайымдамаңыз.
Dialogue: 0,1:08:00.08,1:08:04.08,Default,,0000,0000,0000,,Иә? иә?
Dialogue: 0,1:08:00.08,1:08:04.08,Default,,0000,0000,0000,,Бұрын біреу болған сияқты...
Dialogue: 0,1:08:05.11,1:08:09.09,Default,,0000,0000,0000,,Бір-бірімізді мықтап ұстауымыз керек
Dialogue: 0,1:08:05.11,1:08:09.09,Default,,0000,0000,0000,,Біз ажырасамыз.
Dialogue: 0,1:08:09.09,1:08:12.12,Default,,0000,0000,0000,,Бұл шынымен байқалмайды ма?
Dialogue: 0,1:08:12.12,1:08:15.09,Default,,0000,0000,0000,,Сәлем Дораемон.
Dialogue: 0,1:08:12.12,1:08:15.09,Default,,0000,0000,0000,,...
Dialogue: 0,1:08:15.09,1:08:17.09,Default,,0000,0000,0000,,Келу
Dialogue: 0,1:08:15.09,1:08:17.09,Default,,0000,0000,0000,,Әй, көлік!
Dialogue: 0,1:08:15.09,1:08:17.09,Default,,0000,0000,0000,,Кешір… (Иура) Қайдағы жоқ.
Dialogue: 0,1:08:17.09,1:08:19.10,Default,,0000,0000,0000,,Атча...!
Dialogue: 0,1:08:17.09,1:08:19.10,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,1:08:19.10,1:08:23.10,Default,,0000,0000,0000,,Эй, сен бірдеңе дедің бе?
Dialogue: 0,1:08:19.10,1:08:23.10,Default,,0000,0000,0000,,Жоқ, бұл сіз...
Dialogue: 0,1:08:23.10,1:08:25.10,Default,,0000,0000,0000,,Мүмкін бұл менің қиялым шығар...
Dialogue: 0,1:08:29.10,1:08:35.08,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,1:08:35.08,1:08:37.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:08:37.15,1:08:45.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:08:45.09,1:08:47.16,Default,,0000,0000,0000,,Ол қазірдің өзінде басталды...
Dialogue: 0,1:08:47.16,1:08:49.09,Default,,0000,0000,0000,,Джушин
Dialogue: 0,1:08:47.16,1:08:49.09,Default,,0000,0000,0000,,(Қабылдау дабылы)
Dialogue: 0,1:08:47.16,1:08:49.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:08:49.09,1:08:51.09,Default,,0000,0000,0000,,(Сунео)
Dialogue: 0,1:08:49.09,1:08:51.09,Default,,0000,0000,0000,,«Күте тұр, Шизука-чан!»
Dialogue: 0,1:08:51.09,1:08:54.10,Default,,0000,0000,0000,,Сунео-сан! ? Сен келдің!
Dialogue: 0,1:08:54.10,1:08:56.10,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,1:08:54.10,1:08:56.10,Default,,0000,0000,0000,,Мен қаншамын→
Dialogue: 0,1:08:56.10,1:08:59.10,Default,,0000,0000,0000,,Сен жалғызсың
Dialogue: 0,1:08:56.10,1:08:59.10,Default,,0000,0000,0000,,Мен саған қауіп төндіре алмаймын...
Dialogue: 0,1:08:59.10,1:09:01.10,Default,,0000,0000,0000,,Бұл шықты! !
Dialogue: 0,1:09:01.10,1:09:03.07,Default,,0000,0000,0000,,"Бұрын! Бұрын!"
Dialogue: 0,1:09:03.07,1:09:05.07,Default,,0000,0000,0000,,Иә...!
Dialogue: 0,1:09:06.04,1:09:08.08,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:09:08.08,1:09:10.08,Default,,0000,0000,0000,,Шизука-чан! !
Dialogue: 0,1:09:10.08,1:09:17.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:09:17.15,1:09:19.09,Default,,0000,0000,0000,,Міне...
Dialogue: 0,1:09:19.09,1:09:21.09,Default,,0000,0000,0000,,Сунео-сан!
Dialogue: 0,1:09:21.09,1:09:24.06,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:09:21.09,1:09:24.06,Default,,0000,0000,0000,,Сунео-сан! !
Dialogue: 0,1:09:26.10,1:09:28.10,Default,,0000,0000,0000,,Соққыға түсті...→
Dialogue: 0,1:09:28.10,1:09:30.10,Default,,0000,0000,0000,,Жоқ! ?
Dialogue: 0,1:09:30.10,1:09:32.10,Default,,0000,0000,0000,,«Сунео-сан, жақсысың ба!?»
Dialogue: 0,1:09:32.10,1:09:35.07,Default,,0000,0000,0000,,Иә, ештеңе жоқ.
Dialogue: 0,1:09:35.07,1:09:37.07,Default,,0000,0000,0000,,Кьюка Кайзо
Dialogue: 0,1:09:35.07,1:09:37.07,Default,,0000,0000,0000,,Seika
Dialogue: 0,1:09:35.07,1:09:37.07,Default,,0000,0000,0000,,Бұл модификацияларды күшейтудің нәтижесі!
Dialogue: 0,1:09:37.07,1:09:39.07,Default,,0000,0000,0000,,«Бұл керемет!»
Dialogue: 0,1:09:37.07,1:09:39.07,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,1:09:39.07,1:09:41.08,Default,,0000,0000,0000,,(Сунео)
Dialogue: 0,1:09:39.07,1:09:41.08,Default,,0000,0000,0000,,Сайкё
Dialogue: 0,1:09:39.07,1:09:41.08,Default,,0000,0000,0000,,«Менің танкім - әлемдегі ең күшті!»
Dialogue: 0,1:09:41.08,1:09:44.08,Default,,0000,0000,0000,,(ескерту дыбысы)
Dialogue: 0,1:09:41.08,1:09:44.08,Default,,0000,0000,0000,,Мигихоуку
Dialogue: 0,1:09:41.08,1:09:44.08,Default,,0000,0000,0000,,«Оң жақтан екі ұшақ келе жатыр».
Dialogue: 0,1:09:44.08,1:09:46.05,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,1:09:48.08,1:09:50.09,Default,,0000,0000,0000,,Сіз қазірдің өзінде қорқасыз ба?
Dialogue: 0,1:09:50.09,1:10:06.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:10:13.08,1:10:16.08,Default,,0000,0000,0000,,Шизу
Dialogue: 0,1:10:13.08,1:10:16.08,Default,,0000,0000,0000,,Тыныш...
Dialogue: 0,1:10:13.08,1:10:16.08,Default,,0000,0000,0000,,Мұнда ешкім жоқ.
Dialogue: 0,1:10:16.08,1:10:18.08,Default,,0000,0000,0000,,Керемет жұмыс
Dialogue: 0,1:10:16.08,1:10:18.08,Default,,0000,0000,0000,,♬ Соғылуы тиіс толық нүкте
Dialogue: 0,1:10:16.08,1:10:18.08,Default,,0000,0000,0000,,Менен айла таптың!
Dialogue: 0,1:10:18.08,1:10:20.05,Default,,0000,0000,0000,,Бөлме
Dialogue: 0,1:10:18.08,1:10:20.05,Default,,0000,0000,0000,,Бұл бөлме!
Dialogue: 0,1:10:24.05,1:10:27.06,Default,,0000,0000,0000,,Міне болды! Бұл кішкентай шам!
Dialogue: 0,1:10:29.09,1:10:32.06,Default,,0000,0000,0000,,Кайдзо
Dialogue: 0,1:10:29.09,1:10:32.06,Default,,0000,0000,0000,,Дораемон, босату түймесін тез басыңыз!
Dialogue: 0,1:10:33.06,1:10:36.07,Default,,0000,0000,0000,,Уф... аа...!
Dialogue: 0,1:10:36.07,1:10:38.07,Default,,0000,0000,0000,,Хе...!
Dialogue: 0,1:10:48.08,1:10:51.08,Default,,0000,0000,0000,,Шокун
Dialogue: 0,1:10:48.08,1:10:51.08,Default,,0000,0000,0000,,Қош келдіңіз, Чикю халқы.
Dialogue: 0,1:10:51.08,1:10:54.08,Default,,0000,0000,0000,,Онда кім бар?
Dialogue: 0,1:10:51.08,1:10:54.08,Default,,0000,0000,0000,,Хаку
Dialogue: 0,1:10:51.08,1:10:54.08,Default,,0000,0000,0000,,Сенсор арқылы анықталады.
Dialogue: 0,1:10:54.08,1:10:58.05,Default,,0000,0000,0000,,Гейто
Dialogue: 0,1:10:54.08,1:10:58.05,Default,,0000,0000,0000,,Ал мұндай қулық кімнің қолынан келеді?
Dialogue: 0,1:10:54.08,1:10:58.05,Default,,0000,0000,0000,,Мұнда тек сен ғана.
Dialogue: 0,1:10:58.05,1:11:02.06,Default,,0000,0000,0000,,Чика
Dialogue: 0,1:10:58.05,1:11:02.06,Default,,0000,0000,0000,,Ұзын
Dialogue: 0,1:10:58.05,1:11:02.06,Default,,0000,0000,0000,,Шағын шамдар туралы ақпаратты жіберсеңіз
Dialogue: 0,1:10:58.05,1:11:02.06,Default,,0000,0000,0000,,Мен сені келер деп ойладым.
Dialogue: 0,1:11:02.06,1:11:05.09,Default,,0000,0000,0000,,Казо
Dialogue: 0,1:11:02.06,1:11:05.09,Default,,0000,0000,0000,,Өзіңді үшке санап көрсет!
Dialogue: 0,1:11:05.09,1:11:09.06,Default,,0000,0000,0000,,Әйтпесе
Dialogue: 0,1:11:05.09,1:11:09.06,Default,,0000,0000,0000,,Конагона
Dialogue: 0,1:11:05.09,1:11:09.06,Default,,0000,0000,0000,,Мен де шамдарды сындырамын.
Dialogue: 0,1:11:10.07,1:11:12.07,Default,,0000,0000,0000,,Бір!
Dialogue: 0,1:11:13.10,1:11:15.10,Default,,0000,0000,0000,,Екі!
Dialogue: 0,1:11:15.10,1:11:17.11,Default,,0000,0000,0000,,Өтінемін, алғаш ретімді маған берші— Мен бұрын қыздың қолын да ұстаған емеспін.
Dialogue: 0,1:11:17.11,1:11:19.07,Default,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,1:11:17.11,1:11:19.07,Default,,0000,0000,0000,,Жарайды. Қалған достарым да!
Dialogue: 0,1:11:19.07,1:11:21.08,Default,,0000,0000,0000,,Уф….
Dialogue: 0,1:11:21.08,1:11:23.11,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,1:11:21.08,1:11:23.11,Default,,0000,0000,0000,,Соның бәрі тұзақ болды...
Dialogue: 0,1:11:23.11,1:11:26.12,Default,,0000,0000,0000,,Теусу
Dialogue: 0,1:11:23.11,1:11:26.12,Default,,0000,0000,0000,,Мен оны өте әлсіз деп ойладым.
Dialogue: 0,1:11:26.12,1:11:28.12,Default,,0000,0000,0000,,Бұл жігіт...!
Dialogue: 0,1:11:28.12,1:11:30.09,Default,,0000,0000,0000,,Босдық
Dialogue: 0,1:11:28.12,1:11:30.09,Default,,0000,0000,0000,,Жоқ... Мен оны шеше алмаймын...
Dialogue: 0,1:11:31.12,1:11:33.09,Default,,0000,0000,0000,,Уф... Ита...!
Dialogue: 0,1:11:33.09,1:11:35.09,Default,,0000,0000,0000,,Mei
Dialogue: 0,1:11:33.09,1:11:35.09,Default,,0000,0000,0000,,Какухо
Dialogue: 0,1:11:33.09,1:11:35.09,Default,,0000,0000,0000,,3 адам қорғалды!
Dialogue: 0,1:11:35.09,1:11:37.09,Default,,0000,0000,0000,,Үш адам ше?
Dialogue: 0,1:11:37.09,1:11:39.09,Default,,0000,0000,0000,,Пики
Dialogue: 0,1:11:37.09,1:11:39.09,Default,,0000,0000,0000,,Зура
Dialogue: 0,1:11:37.09,1:11:39.09,Default,,0000,0000,0000,,Тағы бір ақымақ болуы керек!
Dialogue: 0,1:11:39.09,1:11:41.10,Default,,0000,0000,0000,,Сәлем! Ол қайда!
Dialogue: 0,1:11:41.10,1:11:45.07,Default,,0000,0000,0000,,Егер сен ақымақ болсаң
Dialogue: 0,1:11:41.10,1:11:45.07,Default,,0000,0000,0000,,Саңырау?
Dialogue: 0,1:11:41.10,1:11:45.07,Default,,0000,0000,0000,,Экспозиция
Тек
Dialogue: 0,1:11:41.10,1:11:45.07,Default,,0000,0000,0000,,...
Dialogue: 0,1:11:41.10,1:11:45.07,Default,,0000,0000,0000,,Дәлізге бомба қойылып жатыр!
Dialogue: 0,1:11:45.07,1:11:48.10,Default,,0000,0000,0000,,Тезірек тоқтатпасақ
Dialogue: 0,1:11:45.07,1:11:48.10,Default,,0000,0000,0000,,Қабырға
Dialogue: 0,1:11:45.07,1:11:48.10,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,1:11:45.07,1:11:48.10,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,1:11:45.07,1:11:48.10,Default,,0000,0000,0000,,Қабырға ұшып кетеді!
Dialogue: 0,1:11:48.10,1:11:51.07,Default,,0000,0000,0000,,Не! ? растау.
Dialogue: 0,1:11:48.10,1:11:51.07,Default,,0000,0000,0000,,2 адам, келіңіздер!
Dialogue: 0,1:11:51.07,1:11:53.11,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:11:53.11,1:11:55.08,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:11:53.11,1:11:55.08,Default,,0000,0000,0000,,Күте тұрыңыз! Есікті ашпа!
Dialogue: 0,1:11:55.08,1:11:57.08,Default,,0000,0000,0000,,Нобита-кун!
Dialogue: 0,1:11:55.08,1:11:57.08,Default,,0000,0000,0000,,Қаш!
Dialogue: 0,1:11:57.08,1:11:59.08,Default,,0000,0000,0000,,Иә! ? Уф!
Dialogue: 0,1:11:59.08,1:12:04.05,Default,,0000,0000,0000,,Уау! Апыр-ай...! Апыр-ай!
Dialogue: 0,1:12:05.12,1:12:07.09,Default,,0000,0000,0000,,Эй!
Dialogue: 0,1:12:10.09,1:12:12.13,Default,,0000,0000,0000,,Не
Dialogue: 0,1:12:10.09,1:12:12.13,Default,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,1:12:12.13,1:12:14.10,Default,,0000,0000,0000,,Ешкімді сыртқа шығармаңыз.
Dialogue: 0,1:12:12.13,1:12:14.10,Default,,0000,0000,0000,,Рёкай
Dialogue: 0,1:12:12.13,1:12:14.10,Default,,0000,0000,0000,,Польнарефф?
Dialogue: 0,1:12:16.07,1:12:19.10,Default,,0000,0000,0000,,Барлығы…. Болды...
Dialogue: 0,1:12:19.10,1:12:22.10,Default,,0000,0000,0000,,Дораемон! !
Dialogue: 0,1:12:22.10,1:12:27.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:12:28.11,1:12:30.08,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,1:12:31.08,1:12:33.08,Default,,0000,0000,0000,,Одақтастар да
Dialogue: 0,1:12:31.08,1:12:33.08,Default,,0000,0000,0000,,Тақырып
Dialogue: 0,1:12:31.08,1:12:33.08,Default,,0000,0000,0000,,О.
Dialogue: 0,1:12:31.08,1:12:33.08,Default,,0000,0000,0000,,Маған қатты қиналғанымен→
Dialogue: 0,1:12:33.08,1:12:35.08,Default,,0000,0000,0000,,Зенметсу
Dialogue: 0,1:12:33.08,1:12:35.08,Default,,0000,0000,0000,,Жау толығымен дерлік жойылды.
Dialogue: 0,1:12:35.08,1:12:38.09,Default,,0000,0000,0000,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,1:12:35.08,1:12:38.09,Default,,0000,0000,0000,,Сунео мен оның достарына рахмет!
Dialogue: 0,1:12:38.09,1:12:40.09,Default,,0000,0000,0000,,«Сунео-сан»
Dialogue: 0,1:12:40.09,1:12:42.09,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:12:42.09,1:12:45.09,Default,,0000,0000,0000,,Барлығыңыз келесі шабуылға дайындалыңыз.
Dialogue: 0,1:12:42.09,1:12:45.09,Default,,0000,0000,0000,,Негізге оралу.
Dialogue: 0,1:12:45.09,1:12:47.10,Default,,0000,0000,0000,,Аа...! ?
Dialogue: 0,1:12:47.10,1:12:49.10,Default,,0000,0000,0000,,«Мен және Шизука-чан
Dialogue: 0,1:12:47.10,1:12:49.10,Default,,0000,0000,0000,,Мен Пирика планетасына жолымды жалғастырамын.''
Dialogue: 0,1:12:49.10,1:12:51.10,Default,,0000,0000,0000,,Бұл не? ?
Dialogue: 0,1:12:51.10,1:12:54.10,Default,,0000,0000,0000,,Чиджо
Dialogue: 0,1:12:51.10,1:12:54.10,Default,,0000,0000,0000,,Жерде, Нобита-сан және т.б
Dialogue: 0,1:12:51.10,1:12:54.10,Default,,0000,0000,0000,,Мен көп жұмыс істеймін!
Dialogue: 0,1:12:54.10,1:12:57.07,Default,,0000,0000,0000,,Орын
Dialogue: 0,1:12:54.10,1:12:57.07,Default,,0000,0000,0000,,Сіз әлі де осы ұшақпен жүре аласыз!
Dialogue: 0,1:12:57.07,1:12:59.07,Default,,0000,0000,0000,,Мен досыма көмектесуім керек!
Dialogue: 0,1:12:59.07,1:13:01.08,Default,,0000,0000,0000,,Бірақ...!
Dialogue: 0,1:13:01.08,1:13:04.08,Default,,0000,0000,0000,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,1:13:01.08,1:13:04.08,Default,,0000,0000,0000,,I
Dialogue: 0,1:13:01.08,1:13:04.08,Default,,0000,0000,0000,,Бізге еркіндік бер!
Dialogue: 0,1:13:04.08,1:13:06.08,Default,,0000,0000,0000,,...Не болды!
Dialogue: 0,1:13:08.02,1:13:30.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:13:30.04,1:13:35.08,Default,,0000,0000,0000,,Шинкоутей
Dialogue: 0,1:13:30.04,1:13:35.08,Default,,0000,0000,0000,,Бұдан былай жаңа император Гилмор
Dialogue: 0,1:13:30.04,1:13:35.08,Default,,0000,0000,0000,,Тайкан
Dialogue: 0,1:13:30.04,1:13:35.08,Default,,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,1:13:30.04,1:13:35.08,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,1:13:30.04,1:13:35.08,Default,,0000,0000,0000,,Тәжін кию рәсімі өтеді!
Dialogue: 0,1:13:35.08,1:13:41.12,Default,,0000,0000,0000,,Сай
Dialogue: 0,1:13:35.08,1:13:41.12,Default,,0000,0000,0000,,Зендай Торё
Dialogue: 0,1:13:35.08,1:13:41.12,Default,,0000,0000,0000,,Бұрынғы президент Папиден
Dialogue: 0,1:13:35.08,1:13:41.12,Default,,0000,0000,0000,,Жартас
Dialogue: 0,1:13:35.08,1:13:41.12,Default,,0000,0000,0000,,Құттықтау сөздерін қабылдау.
Dialogue: 0,1:13:41.12,1:13:46.09,Default,,0000,0000,0000,,Папи... бұл Кисаманыкі
Dialogue: 0,1:13:41.12,1:13:46.09,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,1:13:41.12,1:13:46.09,Default,,0000,0000,0000,,Жұмыс
Dialogue: 0,1:13:41.12,1:13:46.09,Default,,0000,0000,0000,,Бұл менің осы дүниедегі соңғы жұмысым болады.
Dialogue: 0,1:13:50.03,1:13:51.99,Default,,0000,0000,0000,,Президент Папи!
Dialogue: 0,1:13:51.99,1:13:54.00,Default,,0000,0000,0000,,Президент….
Dialogue: 0,1:13:51.99,1:13:54.00,Default,,0000,0000,0000,,Президент Папи….
Dialogue: 0,1:13:55.00,1:13:56.97,Default,,0000,0000,0000,,Президент….
Dialogue: 0,1:13:55.00,1:13:56.97,Default,,0000,0000,0000,,Әй, әңгімені тыңдайық.
Dialogue: 0,1:13:59.00,1:14:03.01,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:13:59.00,1:14:03.01,Default,,0000,0000,0000,,Пирикада тұратын барлықтарыңызға.
Dialogue: 0,1:14:03.01,1:14:05.01,Default,,0000,0000,0000,,Егер бұл рас болса, онда мен →
Dialogue: 0,1:14:05.01,1:14:08.01,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,1:14:05.01,1:14:08.01,Default,,0000,0000,0000,,Кім осындай жерде тұрса
Dialogue: 0,1:14:05.01,1:14:08.01,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,1:14:08.01,1:14:12.08,Default,,0000,0000,0000,,«Себебі мен
Dialogue: 0,1:14:08.01,1:14:12.08,Default,,0000,0000,0000,,Ширен
Dialogue: 0,1:14:08.01,1:14:12.08,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,1:14:08.01,1:14:12.08,Default,,0000,0000,0000,,Басыңыздан өту керек сынақтарға бет бұру→
Dialogue: 0,1:14:12.08,1:14:16.02,Default,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,1:14:12.08,1:14:16.02,Default,,0000,0000,0000,,Ғарышқа бір адам ғана ұшып кетті
Dialogue: 0,1:14:12.08,1:14:16.02,Default,,0000,0000,0000,,Күт… не?
Dialogue: 0,1:14:12.08,1:14:16.02,Default,,0000,0000,0000,,Өйткені сен қорқақсың».
Dialogue: 0,1:14:16.02,1:14:20.02,Default,,0000,0000,0000,,Konkai
Dialogue: 0,1:14:16.02,1:14:20.02,Default,,0000,0000,0000,,«Бірақ бұл жолы
Dialogue: 0,1:14:16.02,1:14:20.02,Default,,0000,0000,0000,,Маған өте маңызды нәрсе туралы хабардар болды→
Dialogue: 0,1:14:20.02,1:14:23.99,Default,,0000,0000,0000,,Бұл менің қолымнан келетін жалғыз нәрсе
Dialogue: 0,1:14:20.02,1:14:23.99,Default,,0000,0000,0000,,Шырмауық
Dialogue: 0,1:14:20.02,1:14:23.99,Default,,0000,0000,0000,,Барлығына айтқым келеді...».
Dialogue: 0,1:14:23.99,1:14:25.99,Default,,0000,0000,0000,,Папи….
Dialogue: 0,1:14:25.99,1:14:31.00,Default,,0000,0000,0000,,Бұл өзіңді өтірік айту
Dialogue: 0,1:14:25.99,1:14:31.00,Default,,0000,0000,0000,,Бұл сіздің өмір сүре алмайтыныңызды білдіреді.
Dialogue: 0,1:14:33.07,1:14:35.00,Default,,0000,0000,0000,,(Папидің дауысы)
Dialogue: 0,1:14:33.07,1:14:35.00,Default,,0000,0000,0000,,Мұны маған кім үйретті →
Dialogue: 0,1:14:35.00,1:14:41.08,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,1:14:35.00,1:14:41.08,Default,,0000,0000,0000,,Ғаламның арғы жағында мен қаштым
Dialogue: 0,1:14:35.00,1:14:41.08,Default,,0000,0000,0000,,Біз Чикю → атты планетада кездестік
Dialogue: 0,1:14:41.08,1:14:44.01,Default,,0000,0000,0000,,Юджин
Dialogue: 0,1:14:41.08,1:14:44.01,Default,,0000,0000,0000,,Бұл бес дос болды.
Dialogue: 0,1:14:44.01,1:14:48.05,Default,,0000,0000,0000,,Шонен Шоджо
Dialogue: 0,1:14:44.01,1:14:48.05,Default,,0000,0000,0000,,Сол ұлдар мен қыздар
Dialogue: 0,1:14:44.01,1:14:48.05,Default,,0000,0000,0000,,Яма
Dialogue: 0,1:14:44.01,1:14:48.05,Default,,0000,0000,0000,,Таудай алып →
Dialogue: 0,1:14:48.05,1:14:49.99,Default,,0000,0000,0000,,Басында қорқынышты болды→
Dialogue: 0,1:14:49.99,1:14:52.99,Default,,0000,0000,0000,,Тіпті қоңырау шалу
Dialogue: 0,1:14:49.99,1:14:52.99,Default,,0000,0000,0000,,мүмкін емес.
Dialogue: 0,1:14:52.99,1:14:56.99,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,1:14:52.99,1:14:56.99,Default,,0000,0000,0000,,Бірақ олар
Dialogue: 0,1:14:52.99,1:14:56.99,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,1:14:52.99,1:14:56.99,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:14:52.99,1:14:56.99,Default,,0000,0000,0000,,Қуанышыңызды достарыңызбен бөлісіңіз →
Dialogue: 0,1:14:56.99,1:15:01.00,Default,,0000,0000,0000,,T: Бүгін айтатын сөздерім осы ғана.
Dialogue: 0,1:14:56.99,1:15:01.00,Default,,0000,0000,0000,,Намида
Dialogue: 0,1:14:56.99,1:15:01.00,Default,,0000,0000,0000,,Жолдастарының қасіретін көріп жылайтыны→
Dialogue: 0,1:15:01.00,1:15:04.00,Default,,0000,0000,0000,,Біздің арамызда ешқандай айырмашылық жоқ.
Dialogue: 0,1:15:01.00,1:15:04.00,Default,,0000,0000,0000,,Хабардарлық →
Dialogue: 0,1:15:04.00,1:15:07.97,Default,,0000,0000,0000,,Then
Dialogue: 0,1:15:04.00,1:15:07.97,Default,,0000,0000,0000,,Орындалды
Dialogue: 0,1:15:04.00,1:15:07.97,Default,,0000,0000,0000,,Біз тез достасып кеттік.
Dialogue: 0,1:15:10.01,1:15:14.01,Default,,0000,0000,0000,,Миши
Dialogue: 0,1:15:10.01,1:15:14.01,Default,,0000,0000,0000,,Олар белгісіз планетадан келді
Dialogue: 0,1:15:10.01,1:15:14.01,Default,,0000,0000,0000,,Менің сөздерім →
Dialogue: 0,1:15:14.01,1:15:17.01,Default,,0000,0000,0000,,Ән
Dialogue: 0,1:15:14.01,1:15:17.01,Default,,0000,0000,0000,,Сөзсіз
Dialogue: 0,1:15:14.01,1:15:17.01,Default,,0000,0000,0000,,Ол маған сенді.
Dialogue: 0,1:15:17.01,1:15:20.98,Default,,0000,0000,0000,,Бұл ғана емес, Пирика үшін.
Dialogue: 0,1:15:17.01,1:15:20.98,Default,,0000,0000,0000,,Туған жерім Чикюден кету→
Dialogue: 0,1:15:20.98,1:15:24.02,Default,,0000,0000,0000,,Қалай болғанда да, біз тез арада ауруханаға жетуіміз керек…
Dialogue: 0,1:15:20.98,1:15:24.02,Default,,0000,0000,0000,,Ная
Dialogue: 0,1:15:20.98,1:15:24.02,Default,,0000,0000,0000,,сызат
Dialogue: 0,1:15:20.98,1:15:24.02,Default,,0000,0000,0000,,Бірге уайымдап, ренжітеді →
Dialogue: 0,1:15:24.02,1:15:27.99,Default,,0000,0000,0000,,Әлі де солай
Dialogue: 0,1:15:24.02,1:15:27.99,Default,,0000,0000,0000,,Олар төбелесіп жатыр.
Dialogue: 0,1:15:27.99,1:15:32.03,Default,,0000,0000,0000,,Маған солай қарашы
Dialogue: 0,1:15:27.99,1:15:32.03,Default,,0000,0000,0000,,Мен ақыры түсіндім.
Dialogue: 0,1:15:32.03,1:15:35.00,Default,,0000,0000,0000,,Пирика халқы болса да.
Dialogue: 0,1:15:32.03,1:15:35.00,Default,,0000,0000,0000,,Мүмкін Чикю адамдары →
Dialogue: 0,1:15:35.00,1:15:40.00,Default,,0000,0000,0000,,Сіз қай планетада болсаңыз да
Dialogue: 0,1:15:35.00,1:15:40.00,Default,,0000,0000,0000,,Бұл маңызды емес!
Dialogue: 0,1:15:40.00,1:15:42.97,Default,,0000,0000,0000,,Кимо
Dialogue: 0,1:15:40.00,1:15:42.97,Default,,0000,0000,0000,,Басқаларға қамқорлық сезімі → болып табылады
Dialogue: 0,1:15:42.97,1:15:47.01,Default,,0000,0000,0000,,Әлемдегі ең маңызды нәрсе
Dialogue: 0,1:15:42.97,1:15:47.01,Default,,0000,0000,0000,,Бұл уәде...
Dialogue: 0,1:15:47.01,1:15:51.01,Default,,0000,0000,0000,,Жарайсың
Dialogue: 0,1:15:47.01,1:15:51.01,Default,,0000,0000,0000,,Өз қалауы үшін
Dialogue: 0,1:15:47.01,1:15:51.01,Default,,0000,0000,0000,,Өтірік айту және адамдарды ренжіту...→
Dialogue: 0,1:15:51.01,1:15:52.98,Default,,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,1:15:51.01,1:15:52.98,Default,,0000,0000,0000,,Бұл дұрыс болуы мүмкін емес!
Dialogue: 0,1:15:52.98,1:15:55.02,Default,,0000,0000,0000,,Уф... мына жігіт...!
Dialogue: 0,1:15:55.02,1:15:57.02,Default,,0000,0000,0000,,Гилмор!
Dialogue: 0,1:15:57.02,1:16:00.99,Default,,0000,0000,0000,,Пириканы сатып алу керек
Dialogue: 0,1:15:57.02,1:16:00.99,Default,,0000,0000,0000,,When
Dialogue: 0,1:15:57.02,1:16:00.99,Default,,0000,0000,0000,,Шихай
Dialogue: 0,1:15:57.02,1:16:00.99,Default,,0000,0000,0000,,Докусайша
Dialogue: 0,1:15:57.02,1:16:00.99,Default,,0000,0000,0000,,Ол қорқыныш пен өтірік арқылы билік ететін диктатор!
Dialogue: 0,1:16:00.99,1:16:04.99,Default,,0000,0000,0000,,Мухо
Dialogue: 0,1:16:00.99,1:16:04.99,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,1:16:00.99,1:16:04.99,Default,,0000,0000,0000,,Мұндай заңсыздыққа шыдайтын күн туады.
Dialogue: 0,1:16:00.99,1:16:04.99,Default,,0000,0000,0000,,Ұзын
Dialogue: 0,1:16:00.99,1:16:04.99,Default,,0000,0000,0000,,Көп емес!
Dialogue: 0,1:16:04.99,1:16:09.06,Default,,0000,0000,0000,,Кальмар
Dialogue: 0,1:16:04.99,1:16:09.06,Default,,0000,0000,0000,,Ақырында адамдардың ашуы
Dialogue: 0,1:16:04.99,1:16:09.06,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,1:16:04.99,1:16:09.06,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:16:04.99,1:16:09.06,Default,,0000,0000,0000,,Пірика аспанында жанған→
Dialogue: 0,1:16:09.06,1:16:11.03,Default,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,1:16:09.06,1:16:11.03,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,1:16:09.06,1:16:11.03,Default,,0000,0000,0000,,Диктаторды өртеп жібереді!
Dialogue: 0,1:16:15.00,1:16:20.04,Default,,0000,0000,0000,,Мына қыранға жарайсың.
Dialogue: 0,1:16:15.00,1:16:20.04,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,1:16:15.00,1:16:20.04,Default,,0000,0000,0000,,Сен мені ұятқа қалдырдың...!
Dialogue: 0,1:16:20.04,1:16:24.01,Default,,0000,0000,0000,,Дзётаро
Dialogue: 0,1:16:20.04,1:16:24.01,Default,,0000,0000,0000,,Қалауыңызша, Пиинамен бірге
Dialogue: 0,1:16:20.04,1:16:24.01,Default,,0000,0000,0000,,қою
Dialogue: 0,1:16:20.04,1:16:24.01,Default,,0000,0000,0000,,Мен сені о дүниеге жіберемін!
Dialogue: 0,1:16:24.01,1:16:26.01,Default,,0000,0000,0000,,Орындауға дайындық!
Dialogue: 0,1:16:26.01,1:16:28.08,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:16:28.08,1:16:30.02,Default,,0000,0000,0000,,Энки
Dialogue: 0,1:16:28.08,1:16:30.02,Default,,0000,0000,0000,,Бұл тәж кию рәсімі кейінге қалдырылады дегенді білдіре ме?
Dialogue: 0,1:16:30.02,1:16:36.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:16:36.02,1:16:39.03,Default,,0000,0000,0000,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,1:16:36.02,1:16:39.03,Default,,0000,0000,0000,,«Докусайша» нені білдіреді?
Dialogue: 0,1:16:39.03,1:16:42.00,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,1:16:39.03,1:16:42.00,Default,,0000,0000,0000,,Сіз! Оны осылай қалдыру дұрыс па?
Dialogue: 0,1:16:42.00,1:16:44.10,Default,,0000,0000,0000,,Бұл жақсы болуы мүмкін емес!
Dialogue: 0,1:16:44.10,1:16:47.04,Default,,0000,0000,0000,,Шиба
Dialogue: 0,1:16:44.10,1:16:47.04,Default,,0000,0000,0000,,Мен енді байланып қалғым келмейді!
Dialogue: 0,1:16:47.04,1:16:50.07,Default,,0000,0000,0000,,Біз
Dialogue: 0,1:16:47.04,1:16:50.07,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,1:16:47.04,1:16:50.07,Default,,0000,0000,0000,,Біз еркіндікті қадірлейтін Пірікеміз!
Dialogue: 0,1:16:50.07,1:16:52.04,Default,,0000,0000,0000,,Хитомака
Dialogue: 0,1:16:50.07,1:16:52.04,Default,,0000,0000,0000,,Оны басқаларға қалдыру дұрыс па? ?
Dialogue: 0,1:16:52.04,1:16:54.01,Default,,0000,0000,0000,,Біз президентке көмектесуіміз керек!
Dialogue: 0,1:16:54.01,1:16:57.05,Default,,0000,0000,0000,,Гилмордың ресми резиденциясы!
Dialogue: 0,1:16:54.01,1:16:57.05,Default,,0000,0000,0000,,Мен барамын!
Dialogue: 0,1:16:57.05,1:16:59.01,Default,,0000,0000,0000,,Мен де барамын!
Dialogue: 0,1:16:57.05,1:16:59.01,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,1:17:00.02,1:17:02.02,Default,,0000,0000,0000,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,1:17:00.02,1:17:02.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:17:03.02,1:17:06.02,Default,,0000,0000,0000,,(пиф сарбазы)
Dialogue: 0,1:17:03.02,1:17:06.02,Default,,0000,0000,0000,,Не? Сол жігіттер...
Dialogue: 0,1:17:21.00,1:17:24.07,Default,,0000,0000,0000,,Құрметті папи! Құрметті Пиина!
Dialogue: 0,1:17:24.07,1:17:27.01,Default,,0000,0000,0000,,Дораемон-сан! ?
Dialogue: 0,1:17:24.07,1:17:27.01,Default,,0000,0000,0000,,Джиан мырза! ?
Dialogue: 0,1:17:27.01,1:17:29.08,Default,,0000,0000,0000,,Қанкей
Dialogue: 0,1:17:27.01,1:17:29.08,Default,,0000,0000,0000,,Чикю халқының бұған қатысы жоқ!
Dialogue: 0,1:17:29.08,1:17:33.05,Default,,0000,0000,0000,,Қайдан бастарын білмеймін.
Dialogue: 0,1:17:29.08,1:17:33.05,Default,,0000,0000,0000,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,1:17:29.08,1:17:33.05,Default,,0000,0000,0000,,Хангьякуша
Dialogue: 0,1:17:29.08,1:17:33.05,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,1:17:29.08,1:17:33.05,Default,,0000,0000,0000,,Барлық сатқындар бірге өлім жазасына кесіледі!
Dialogue: 0,1:17:33.98,1:17:35.98,Default,,0000,0000,0000,,Кайджун
Dialogue: 0,1:17:33.98,1:17:35.98,Default,,0000,0000,0000,,(дыбыс құлпын ашу)
Dialogue: 0,1:17:39.02,1:17:40.99,Default,,0000,0000,0000,,Деншион
Dialogue: 0,1:17:39.02,1:17:40.99,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:17:39.02,1:17:40.99,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:17:41.99,1:17:45.03,Default,,0000,0000,0000,,Эй... Доремондар қайда?
Dialogue: 0,1:17:45.03,1:17:48.00,Default,,0000,0000,0000,,Эй иттеба!
Dialogue: 0,1:17:45.03,1:17:48.00,Default,,0000,0000,0000,,Жерлестер! Жерлестер!
Dialogue: 0,1:17:48.00,1:17:51.00,Default,,0000,0000,0000,,Окуджо
Dialogue: 0,1:17:48.00,1:17:51.00,Default,,0000,0000,0000,,Шокейдзо
Dialogue: 0,1:17:48.00,1:17:51.00,Default,,0000,0000,0000,,Солар болса, төбедегі өлім жазасы...
Dialogue: 0,1:17:51.00,1:17:53.00,Default,,0000,0000,0000,,Өлімге негіз! ? Міне бітті…!
Dialogue: 0,1:17:53.00,1:17:55.00,Default,,0000,0000,0000,,Иә? Өлім орнына не болды?
Dialogue: 0,1:17:55.00,1:17:57.01,Default,,0000,0000,0000,,А, жоқ... бұл ештеңе емес.
Dialogue: 0,1:17:59.01,1:18:00.98,Default,,0000,0000,0000,,Дораемон...!
Dialogue: 0,1:18:04.01,1:18:05.98,Default,,0000,0000,0000,,Мен жақында Филипполисте боламын.
Dialogue: 0,1:18:05.98,1:18:10.99,Default,,0000,0000,0000,,Минатогава
Dialogue: 0,1:18:05.98,1:18:10.99,Default,,0000,0000,0000,,Иә. Порт жағы әлсіз
Dialogue: 0,1:18:05.98,1:18:10.99,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,1:18:05.98,1:18:10.99,Default,,0000,0000,0000,,Радармен расталған.
Dialogue: 0,1:18:10.99,1:18:13.99,Default,,0000,0000,0000,,«Және басқа да көптеген нәрселер
Dialogue: 0,1:18:10.99,1:18:13.99,Default,,0000,0000,0000,,Чика
Dialogue: 0,1:18:10.99,1:18:13.99,Default,,0000,0000,0000,,...
Dialogue: 0,1:18:10.99,1:18:13.99,Default,,0000,0000,0000,,Біз ақпарат жинай алдық...»
Dialogue: 0,1:18:13.99,1:18:21.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:18:21.00,1:18:23.97,Default,,0000,0000,0000,,(пиф сарбаздары)
Dialogue: 0,1:18:21.00,1:18:23.97,Default,,0000,0000,0000,,Қытай шамы
Dialogue: 0,1:18:21.00,1:18:23.97,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,1:18:21.00,1:18:23.97,Default,,0000,0000,0000,,Міне! Бұл режиссердің қалағанындай болды!
Dialogue: 0,1:18:23.97,1:18:26.97,Default,,0000,0000,0000,,Қанша күшті болса да
Dialogue: 0,1:18:23.97,1:18:26.97,Default,,0000,0000,0000,,Егер сіз бұл жігітті өлтірсеңіз...
Dialogue: 0,1:18:27.97,1:18:30.94,Default,,0000,0000,0000,,(пиф сарбаздары)
Dialogue: 0,1:18:27.97,1:18:30.94,Default,,0000,0000,0000,,Денжи
Dialogue: 0,1:18:27.97,1:18:30.94,Default,,0000,0000,0000,,Хаша
Dialogue: 0,1:18:27.97,1:18:30.94,Default,,0000,0000,0000,,Электромагниттік импульстік зымыран ұшыру!
Dialogue: 0,1:18:33.01,1:18:35.98,Default,,0000,0000,0000,,(ескерту дыбысы)
Dialogue: 0,1:18:33.01,1:18:35.98,Default,,0000,0000,0000,,Бірдеңе келе жатыр!
Dialogue: 0,1:18:36.98,1:18:39.98,Default,,0000,0000,0000,,Бұл зымыран. Маған қалдырыңыз!
Dialogue: 0,1:18:39.98,1:18:44.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:18:44.99,1:18:46.99,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:18:46.99,1:18:48.99,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:18:46.99,1:18:48.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:18:51.06,1:18:52.99,Default,,0000,0000,0000,,Соджу
Dialogue: 0,1:18:51.06,1:18:52.99,Default,,0000,0000,0000,,Оны басқара алмаймын!
Dialogue: 0,1:18:52.99,1:18:54.96,Default,,0000,0000,0000,,Сунео-сан!
Dialogue: 0,1:19:06.98,1:19:10.01,Default,,0000,0000,0000,,Сол жігіттер бірден
Dialogue: 0,1:19:06.98,1:19:10.01,Default,,0000,0000,0000,,Мен сені жұдырығыммен ұрғым келді!
Dialogue: 0,1:19:10.01,1:19:11.98,Default,,0000,0000,0000,,Сунеомен бірге
Dialogue: 0,1:19:10.01,1:19:11.98,Default,,0000,0000,0000,,Шизука-чан осында!
Dialogue: 0,1:19:11.98,1:19:14.98,Default,,0000,0000,0000,,Ой... Енді ойлап қарасам, дәл қазір→
Dialogue: 0,1:19:14.98,1:19:18.99,Default,,0000,0000,0000,,Рио
Dialogue: 0,1:19:14.98,1:19:18.99,Default,,0000,0000,0000,,Екі Чикю танкі
Dialogue: 0,1:19:14.98,1:19:18.99,Default,,0000,0000,0000,,қатал
Dialogue: 0,1:19:14.98,1:19:18.99,Default,,0000,0000,0000,,Мен оны атып түсіргені туралы хабарлама алдым...
Dialogue: 0,1:19:18.99,1:19:22.96,Default,,0000,0000,0000,,Ішінде достарың бар.
Dialogue: 0,1:19:18.99,1:19:22.96,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,1:19:18.99,1:19:22.96,Default,,0000,0000,0000,,Қызық, ол бортта болды ма?
Dialogue: 0,1:19:23.99,1:19:25.99,Default,,0000,0000,0000,,Гахахахаха...!
Dialogue: 0,1:19:25.99,1:19:29.03,Default,,0000,0000,0000,,Думей
Dialogue: 0,1:19:25.99,1:19:29.03,Default,,0000,0000,0000,,Бұл одақтың соңы!
Dialogue: 0,1:19:29.03,1:19:32.03,Default,,0000,0000,0000,,Жаса!
Dialogue: 0,1:19:29.03,1:19:32.03,Default,,0000,0000,0000,,Ха! Мақсат!
Dialogue: 0,1:19:33.00,1:19:34.97,Default,,0000,0000,0000,,Дайындық….
Dialogue: 0,1:19:34.97,1:19:38.97,Default,,0000,0000,0000,,Күте тұрыңыз! Сіздер үшін жігіттер
Dialogue: 0,1:19:34.97,1:19:38.97,Default,,0000,0000,0000,,Жүрексізсің бе?
Dialogue: 0,1:19:38.97,1:19:43.01,Default,,0000,0000,0000,,Өйткені бұл солай
Dialogue: 0,1:19:38.97,1:19:43.01,Default,,0000,0000,0000,,Джинбо
Dialogue: 0,1:19:38.97,1:19:43.01,Default,,0000,0000,0000,,Пифияның танымалдығы жоқ!
Dialogue: 0,1:19:43.01,1:19:45.98,Default,,0000,0000,0000,,Тіпті президенттің соңғы сөзі де.
Dialogue: 0,1:19:43.01,1:19:45.98,Default,,0000,0000,0000,,Егер сіз оны тастап кете алмайтыныңызды білсеңіз →
Dialogue: 0,1:19:45.98,1:19:48.98,Default,,0000,0000,0000,,Шимин
Dialogue: 0,1:19:45.98,1:19:48.98,Default,,0000,0000,0000,,Азаматтар
Dialogue: 0,1:19:45.98,1:19:48.98,Default,,0000,0000,0000,,Барған сайын үндемей барамын!
Dialogue: 0,1:19:48.98,1:19:52.05,Default,,0000,0000,0000,,Ең алдымен,
Dialogue: 0,1:19:48.98,1:19:52.05,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,1:19:48.98,1:19:52.05,Default,,0000,0000,0000,,Кім басқалардан жоғары тұруы керек...
Dialogue: 0,1:19:52.05,1:19:53.99,Default,,0000,0000,0000,,
Dialogue: 0,1:19:52.05,1:19:53.99,Default,,0000,0000,0000,,Иә... Түсіндім, түсіндім!
Dialogue: 0,1:19:53.99,1:19:56.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:19:53.99,1:19:56.96,Default,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,1:19:53.99,1:19:56.96,Default,,0000,0000,0000,,Егер айтар сөзің болса, мен сенен сұраймын.
Dialogue: 0,1:19:56.96,1:19:59.06,Default,,0000,0000,0000,,Сонымен, кім...?
Dialogue: 0,1:19:59.06,1:20:01.00,Default,,0000,0000,0000,,О!
Dialogue: 0,1:20:01.00,1:20:02.96,Default,,0000,0000,0000,,Енді менің сөзім.
Dialogue: 0,1:20:01.00,1:20:02.96,Default,,0000,0000,0000,,Темижика
Dialogue: 0,1:20:01.00,1:20:02.96,Default,,0000,0000,0000,,Қысқасы.
Dialogue: 0,1:20:02.96,1:20:05.00,Default,,0000,0000,0000,,Қорқыныш
Dialogue: 0,1:20:02.96,1:20:05.00,Default,,0000,0000,0000,,Бұл 3 жыл бұрын болды, мен оны ешқашан ұмытпаймын →
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,...
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,О.
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,Жыл соңына таяп қалды
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,Тырнақ
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,Жарылыс
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,Суық, қарлы түнде...
Dialogue: 0,1:20:12.01,1:20:14.01,Default,,0000,0000,0000,,Синсуи
Dialogue: 0,1:20:12.01,1:20:14.01,Default,,0000,0000,0000,,Су тасқыны! Уф...!
Dialogue: 0,1:20:14.01,1:20:17.01,Default,,0000,0000,0000,,Уау... аа... аа!
Dialogue: 0,1:20:17.01,1:20:19.08,Default,,0000,0000,0000,,Шыңырау...!
Dialogue: 0,1:20:19.08,1:20:22.05,Default,,0000,0000,0000,,Уф... аа...!
Dialogue: 0,1:20:22.98,1:20:24.99,Default,,0000,0000,0000,,…мм! ?
Dialogue: 0,1:20:31.99,1:20:41.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:20:41.00,1:20:43.00,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,1:20:43.00,1:20:46.01,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,1:20:43.00,1:20:46.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:20:46.01,1:20:51.01,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:20:51.01,1:20:55.98,Default,,0000,0000,0000,,күрсіну…. Бұл нені білдіреді? ?
Dialogue: 0,1:20:59.12,1:21:00.99,Default,,0000,0000,0000,,Әй, не! ?
Dialogue: 0,1:20:59.12,1:21:00.99,Default,,0000,0000,0000,,Итермеңіз!
Dialogue: 0,1:21:00.99,1:21:03.99,Default,,0000,0000,0000,,Бұл сенсің!
Dialogue: 0,1:21:00.99,1:21:03.99,Default,,0000,0000,0000,,Гугггхх... Уф...!
Dialogue: 0,1:21:07.00,1:21:09.00,Default,,0000,0000,0000,,Қалпақ
Dialogue: 0,1:21:07.00,1:21:09.00,Default,,0000,0000,0000,,Не? Бұл қалпақ.
Dialogue: 0,1:21:09.00,1:21:12.00,Default,,0000,0000,0000,,Ең бастысы, ол қазір кім?
Dialogue: 0,1:21:12.00,1:21:14.00,Default,,0000,0000,0000,,...Чикю халқы!
Dialogue: 0,1:21:14.00,1:21:18.01,Default,,0000,0000,0000,,Чукей
Dialogue: 0,1:21:14.00,1:21:18.01,Default,,0000,0000,0000,,Шудан
Dialogue: 0,1:21:14.00,1:21:18.01,Default,,0000,0000,0000,,Хабарды тамашалаған азаматтар тобы
Dialogue: 0,1:21:14.00,1:21:18.01,Default,,0000,0000,0000,,Мына жаққа бара жатыр! ?
Dialogue: 0,1:21:18.01,1:21:20.01,Default,,0000,0000,0000,,сараңдық
Dialogue: 0,1:21:18.01,1:21:20.01,Default,,0000,0000,0000,,Мына нәрсені тепкіле!
Dialogue: 0,1:21:20.01,1:21:23.01,Default,,0000,0000,0000,,Дәнекер
Dialogue: 0,1:21:20.01,1:21:23.01,Default,,0000,0000,0000,,Өз бетіңізше ештеңе шеше алмайсыз ба?
Dialogue: 0,1:21:20.01,1:21:23.01,Default,,0000,0000,0000,,Балалар!
Dialogue: 0,1:21:23.01,1:21:26.98,Default,,0000,0000,0000,,Иә, жеткілікті!
Dialogue: 0,1:21:23.01,1:21:26.98,Default,,0000,0000,0000,,Оны дереу өлтіріңіз!
Dialogue: 0,1:21:26.98,1:21:28.98,Default,,0000,0000,0000,,Мм...!
Dialogue: 0,1:21:29.99,1:21:31.99,Default,,0000,0000,0000,,Жарайды! Мақсат!
Dialogue: 0,1:21:29.99,1:21:31.99,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,1:21:31.99,1:21:33.99,Default,,0000,0000,0000,,Хатшы!
Dialogue: 0,1:21:31.99,1:21:33.99,Default,,0000,0000,0000,,Бұл уақыт қанша? ?
Dialogue: 0,1:21:33.99,1:21:37.99,Default,,0000,0000,0000,,Бұл алып!
Dialogue: 0,1:21:33.99,1:21:37.99,Default,,0000,0000,0000,,Портта екі алып пайда болды!
Dialogue: 0,1:21:37.99,1:21:40.00,Default,,0000,0000,0000,,Бұл алып! ?
Dialogue: 0,1:21:40.00,1:21:42.00,Default,,0000,0000,0000,,О, адам
Dialogue: 0,1:21:40.00,1:21:42.00,Default,,0000,0000,0000,,Ол үлкен адам!
Dialogue: 0,1:21:46.97,1:21:49.97,Default,,0000,0000,0000,,Сіз естідіңіз бе?
Dialogue: 0,1:21:46.97,1:21:49.97,Default,,0000,0000,0000,,Мен туралы, мен үлкен адаммын!
Dialogue: 0,1:21:49.97,1:21:51.97,Default,,0000,0000,0000,,Барлығы жақсы деп үміттенемін...
Dialogue: 0,1:21:51.97,1:21:53.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:21:51.97,1:21:53.98,Default,,0000,0000,0000,,Мазалағаным үшін кешіріңіз!
Dialogue: 0,1:21:54.98,1:21:57.98,Default,,0000,0000,0000,,Шизука-сан... Сунео-сан...!
Dialogue: 0,1:21:57.98,1:21:59.98,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:21:57.98,1:21:59.98,Default,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,1:21:57.98,1:21:59.98,Default,,0000,0000,0000,,Түсіндім! Әсері жойылды!
Dialogue: 0,1:21:59.98,1:22:01.98,Default,,0000,0000,0000,,Тиімділік?
Dialogue: 0,1:22:01.98,1:22:05.99,Default,,0000,0000,0000,,...
Dialogue: 0,1:22:01.98,1:22:05.99,Default,,0000,0000,0000,,Кішкентай жарықтың әсері өшеді
Dialogue: 0,1:22:01.98,1:22:05.99,Default,,0000,0000,0000,,Ол бастапқы өлшеміне оралды!
Dialogue: 0,1:22:05.99,1:22:08.99,Default,,0000,0000,0000,,Онда біз не үшін келдік?
Dialogue: 0,1:22:05.99,1:22:08.99,Default,,0000,0000,0000,,Ол үлкенірек болмайды, солай ма?
Dialogue: 0,1:22:08.99,1:22:10.99,Default,,0000,0000,0000,,Уақыт адамға байланысты өзгереді.
Dialogue: 0,1:22:10.99,1:22:14.06,Default,,0000,0000,0000,,Жақында сонда болатынымызға сенімдімін...
Dialogue: 0,1:22:14.06,1:22:15.96,Default,,0000,0000,0000,,Мен барғым келеді
Dialogue: 0,1:22:14.06,1:22:15.96,Default,,0000,0000,0000,,Қала
Dialogue: 0,1:22:14.06,1:22:15.96,Default,,0000,0000,0000,,Егер солдаттар қаладан қайтып оралмаса! ?
Dialogue: 0,1:22:15.96,1:22:19.00,Default,,0000,0000,0000,,Мужинки
Dialogue: 0,1:22:15.96,1:22:19.00,Default,,0000,0000,0000,,Оусен
Dialogue: 0,1:22:15.96,1:22:19.00,Default,,0000,0000,0000,,Бұл жағдайда дрондармен күресіңіз!
Dialogue: 0,1:22:19.00,1:22:20.97,Default,,0000,0000,0000,,Хатшы!
Dialogue: 0,1:22:19.00,1:22:20.97,Default,,0000,0000,0000,,Каген
Dialogue: 0,1:22:19.00,1:22:20.97,Default,,0000,0000,0000,,Сәлем! Уайымдама!
Dialogue: 0,1:22:20.97,1:22:23.94,Default,,0000,0000,0000,,Кіреберіс осында
Dialogue: 0,1:22:20.97,1:22:23.94,Default,,0000,0000,0000,,Топпа
Dialogue: 0,1:22:20.97,1:22:23.94,Default,,0000,0000,0000,,Азаматтар бұзды!
Dialogue: 0,1:22:24.97,1:22:26.98,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:22:27.98,1:22:29.98,Default,,0000,0000,0000,,Президенттерге көмектесіңіз!
Dialogue: 0,1:22:29.98,1:22:32.01,Default,,0000,0000,0000,,Гилморды жеңіңіз!
Dialogue: 0,1:22:32.01,1:22:33.98,Default,,0000,0000,0000,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,1:22:37.99,1:22:40.99,Default,,0000,0000,0000,,Генерал Гилмор!
Dialogue: 0,1:22:40.99,1:22:42.99,Default,,0000,0000,0000,,О-
Dialogue: 0,1:22:40.99,1:22:42.99,Default,,0000,0000,0000,,Дереу әскерлеріңізді тартыңыз!
Dialogue: 0,1:22:42.99,1:22:44.99,Default,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,1:22:42.99,1:22:44.99,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:22:42.99,1:22:44.99,Default,,0000,0000,0000,,Біз әлі де сөйлесе аламыз.
Dialogue: 0,1:22:44.99,1:22:48.00,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,1:22:44.99,1:22:48.00,Default,,0000,0000,0000,,Түйіндеме
Dialogue: 0,1:22:44.99,1:22:48.00,Default,,0000,0000,0000,,Муими
Dialogue: 0,1:22:44.99,1:22:48.00,Default,,0000,0000,0000,,Әрі қарайғы қайшылықтың мәні жоқ!
Dialogue: 0,1:22:49.00,1:22:50.97,Default,,0000,0000,0000,,Нобита-кун!
Dialogue: 0,1:22:50.97,1:22:53.97,Default,,0000,0000,0000,,Дораемон! Қазір барайық!
Dialogue: 0,1:22:55.00,1:22:56.97,Default,,0000,0000,0000,,Міне, сіз! Бұл Чикю халқы!
Dialogue: 0,1:22:58.01,1:23:00.98,Default,,0000,0000,0000,,Нобита-сан! ?
Dialogue: 0,1:22:58.01,1:23:00.98,Default,,0000,0000,0000,,Тас бомбаға не болды?
Dialogue: 0,1:23:00.98,1:23:04.01,Default,,0000,0000,0000,,Папи! Бәріне Кисама кінәлі!
Dialogue: 0,1:23:04.01,1:23:05.98,Default,,0000,0000,0000,,Беріңіз!
Dialogue: 0,1:23:05.98,1:23:08.98,Default,,0000,0000,0000,,Нуаааа~!
Dialogue: 0,1:23:05.98,1:23:08.98,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,1:23:10.99,1:23:12.95,Default,,0000,0000,0000,,Папи!
Dialogue: 0,1:23:15.99,1:23:17.99,Default,,0000,0000,0000,,Нобита-кун!
Dialogue: 0,1:23:15.99,1:23:17.99,Default,,0000,0000,0000,,Нобита!
Dialogue: 0,1:23:17.99,1:23:19.99,Default,,0000,0000,0000,,Қолдарыңызды алыңыз!
Dialogue: 0,1:23:17.99,1:23:19.99,Default,,0000,0000,0000,,Папи!
Dialogue: 0,1:23:19.99,1:23:22.00,Default,,0000,0000,0000,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,1:23:19.99,1:23:22.00,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:23:22.00,1:23:23.97,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:23:23.97,1:23:25.97,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:23:23.97,1:23:25.97,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:23:35.98,1:23:37.98,Default,,0000,0000,0000,,Гахахахаха!
Dialogue: 0,1:23:37.98,1:23:40.02,Default,,0000,0000,0000,,Көк шаян
Dialogue: 0,1:23:37.98,1:23:40.02,Default,,0000,0000,0000,,Көрдің бе, екі жасар бала?
Dialogue: 0,1:23:40.02,1:23:41.98,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,1:23:41.98,1:23:43.99,Default,,0000,0000,0000,,Хаму
Dialogue: 0,1:23:41.98,1:23:43.99,Default,,0000,0000,0000,,Маған қарсы шыққандар→
Dialogue: 0,1:23:43.99,1:23:47.99,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,1:23:43.99,1:23:47.99,Default,,0000,0000,0000,,Кім болсаң да
Dialogue: 0,1:23:43.99,1:23:47.99,Default,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,1:23:43.99,1:23:47.99,Default,,0000,0000,0000,,Мұны әрқайсымыз көрдік...
Dialogue: 0,1:23:47.99,1:23:49.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:23:51.99,1:23:54.00,Default,,0000,0000,0000,,Әй?
Dialogue: 0,1:23:54.00,1:23:55.96,Default,,0000,0000,0000,,Уау! !
Dialogue: 0,1:23:55.96,1:23:57.93,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:23:59.97,1:24:01.97,Default,,0000,0000,0000,,Нобита-кун!
Dialogue: 0,1:23:59.97,1:24:01.97,Default,,0000,0000,0000,,Нобита!
Dialogue: 0,1:24:01.97,1:24:05.97,Default,,0000,0000,0000,,Уайымдамаңыз.
Dialogue: 0,1:24:01.97,1:24:05.97,Default,,0000,0000,0000,,Қараңызшы, Папи-кун да қауіпсіз.
Dialogue: 0,1:24:05.97,1:24:07.98,Default,,0000,0000,0000,,Папи!
Dialogue: 0,1:24:05.97,1:24:07.98,Default,,0000,0000,0000,,Хахихаха~!
Dialogue: 0,1:24:08.98,1:24:11.98,Default,,0000,0000,0000,,Кел, кел, кел!
Dialogue: 0,1:24:08.98,1:24:11.98,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,1:24:11.98,1:24:13.98,Default,,0000,0000,0000,,Егер бұл орын алса, бұл менікі!
Dialogue: 0,1:24:13.98,1:24:16.95,Default,,0000,0000,0000,,Ойдан тыс қалмаңыз! Ату, ату!
Dialogue: 0,1:24:18.05,1:24:20.02,Default,,0000,0000,0000,,Гао!
Dialogue: 0,1:24:18.05,1:24:20.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:24:22.99,1:24:24.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:24:25.99,1:24:27.96,Default,,0000,0000,0000,,Бұл...→
Dialogue: 0,1:24:27.96,1:24:29.93,Default,,0000,0000,0000,,Гилмор! Дракоруру!
Dialogue: 0,1:24:31.03,1:24:34.00,Default,,0000,0000,0000,,Ей, сен маған қашып кетуге рұқсат еттің!
Dialogue: 0,1:24:31.03,1:24:34.00,Default,,0000,0000,0000,,Барлығы егер бұл орын алса...
Dialogue: 0,1:24:34.00,1:24:36.00,Default,,0000,0000,0000,,Иә... иә?
Dialogue: 0,1:24:36.00,1:24:37.97,Default,,0000,0000,0000,,және келісім-шарт аяқталады
Dialogue: 0,1:24:37.97,1:24:40.98,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,1:24:37.97,1:24:40.98,Default,,0000,0000,0000,,Бұл шынымен де солай...
Dialogue: 0,1:24:40.98,1:24:44.01,Default,,0000,0000,0000,,Көшбасшы!
Dialogue: 0,1:24:40.98,1:24:44.01,Default,,0000,0000,0000,,Жарайды, солай.
Dialogue: 0,1:24:44.01,1:24:47.02,Default,,0000,0000,0000,,Бұл шешілді!
Dialogue: 0,1:24:47.02,1:24:49.98,Default,,0000,0000,0000,,Уайымдамаңыз! Олар одақтастар!
Dialogue: 0,1:24:49.98,1:24:53.05,Default,,0000,0000,0000,,Президент! Сәттілік және аман болыңыз.
Dialogue: 0,1:24:53.05,1:24:56.06,Default,,0000,0000,0000,,Дұрыс, Гилмор тікұшақта...
Dialogue: 0,1:24:56.06,1:24:59.99,Default,,0000,0000,0000,,Иә. Ең алдымен
Dialogue: 0,1:24:56.06,1:24:59.99,Default,,0000,0000,0000,,Жұмыс
Dialogue: 0,1:24:56.06,1:24:59.99,Default,,0000,0000,0000,,Біз адамдарға бұл жағдай туралы хабарлауымыз керек.
Dialogue: 0,1:24:59.99,1:25:03.06,Default,,0000,0000,0000,,Хосуукёку
Dialogue: 0,1:24:59.99,1:25:03.06,Default,,0000,0000,0000,,Хабар тарату станциясына! Менің достарым күтіп отыр.
Dialogue: 0,1:24:59.99,1:25:03.06,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:25:03.06,1:25:05.00,Default,,0000,0000,0000,,Көшбасшы →
Dialogue: 0,1:25:05.00,1:25:08.00,Default,,0000,0000,0000,,Папи-кунға және басқаларға қамқорлық жасаңыз.
Dialogue: 0,1:25:05.00,1:25:08.00,Default,,0000,0000,0000,,Кейін кездескенше.
Dialogue: 0,1:25:08.00,1:25:11.01,Default,,0000,0000,0000,,Тайхи
Dialogue: 0,1:25:08.00,1:25:11.01,Default,,0000,0000,0000,,Эвакуациялаңыз! Эвакуацияланамын!
Dialogue: 0,1:25:08.00,1:25:11.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:25:11.01,1:25:13.01,Default,,0000,0000,0000,,тармақ….
Dialogue: 0,1:25:13.01,1:25:15.08,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,1:25:13.01,1:25:15.08,Default,,0000,0000,0000,,Сіз не істеп жатырсыз...?
Dialogue: 0,1:25:15.08,1:25:17.08,Default,,0000,0000,0000,,⚞Нобита-сан!
Dialogue: 0,1:25:17.08,1:25:19.05,Default,,0000,0000,0000,,Шизука-чан!
Dialogue: 0,1:25:19.98,1:25:23.99,Default,,0000,0000,0000,,Дора-чан Нобита-сан!
Dialogue: 0,1:25:19.98,1:25:23.99,Default,,0000,0000,0000,,Джан!
Dialogue: 0,1:25:23.99,1:25:26.99,Default,,0000,0000,0000,,Сунео!
Dialogue: 0,1:25:23.99,1:25:26.99,Default,,0000,0000,0000,,Барлығына!
Dialogue: 0,1:25:26.99,1:25:28.99,Default,,0000,0000,0000,,Ахаха!
Dialogue: 0,1:25:28.99,1:25:31.99,Default,,0000,0000,0000,,Ахаха... Иә!
Dialogue: 0,1:25:31.99,1:25:34.00,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:25:37.00,1:25:41.00,Default,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,1:25:37.00,1:25:41.00,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,1:25:37.00,1:25:41.00,Default,,0000,0000,0000,,Кездесуімізге қуанышты болу үшін кейінірек күтейік.
Dialogue: 0,1:25:41.00,1:25:42.97,Default,,0000,0000,0000,,Бұл танктер мен тікұшақтар...
Dialogue: 0,1:25:42.97,1:25:46.01,Default,,0000,0000,0000,,Мен оны қарап шықтым. Бұл дрон!
Dialogue: 0,1:25:46.01,1:25:48.01,Default,,0000,0000,0000,,Олай болса, ұстанба!
Dialogue: 0,1:25:51.08,1:25:55.05,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,1:25:55.05,1:25:58.02,Default,,0000,0000,0000,,Сентокайши
Dialogue: 0,1:25:55.05,1:25:58.02,Default,,0000,0000,0000,,Шайқас басталады!
Dialogue: 0,1:25:55.05,1:25:58.02,Default,,0000,0000,0000,,Мен ол жігітке ештеңе істей алмаймын
Dialogue: 0,1:25:58.02,1:25:59.99,Default,,0000,0000,0000,,Тоу! Туу!
Dialogue: 0,1:25:58.02,1:25:59.99,Default,,0000,0000,0000,,Тоу! Туу!
Dialogue: 0,1:25:59.99,1:26:01.99,Default,,0000,0000,0000,,Экспозиция
Dialogue: 0,1:25:59.99,1:26:01.99,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:26:01.99,1:26:04.99,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,1:26:01.99,1:26:04.99,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:26:04.99,1:26:08.03,Default,,0000,0000,0000,,Маған да біреуін оқып бер
Dialogue: 0,1:26:04.99,1:26:08.03,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,1:26:08.03,1:26:11.00,Default,,0000,0000,0000,,Несен
Dialogue: 0,1:26:08.03,1:26:11.00,Default,,0000,0000,0000,,Баршаңыз, жылу сәулелерінен соқыр болмаңыздар!
Dialogue: 0,1:26:11.00,1:26:13.00,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,1:26:11.00,1:26:13.00,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,1:26:13.00,1:26:15.00,Default,,0000,0000,0000,,Кя! Сіз жасадыңыз!
Dialogue: 0,1:26:13.00,1:26:15.00,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:26:15.00,1:26:17.01,Default,,0000,0000,0000,,Қараңдар, қараңдар!
Dialogue: 0,1:26:15.00,1:26:17.01,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,1:26:17.01,1:26:19.01,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,1:26:19.01,1:26:22.01,Default,,0000,0000,0000,,Біз өте жақсы жұмыс жасадық!
Dialogue: 0,1:26:19.01,1:26:22.01,Default,,0000,0000,0000,,Хагота
Dialogue: 0,1:26:19.01,1:26:22.01,Default,,0000,0000,0000,,Тым шайнау!
Dialogue: 0,1:26:22.01,1:26:24.01,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:26:22.01,1:26:24.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:26:24.01,1:26:25.98,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:26:24.01,1:26:25.98,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:26:25.98,1:26:32.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:26:32.99,1:26:34.99,Default,,0000,0000,0000,,Міне, осында!
Dialogue: 0,1:26:38.99,1:26:41.00,Default,,0000,0000,0000,,Кетчаку
Dialogue: 0,1:26:38.99,1:26:41.00,Default,,0000,0000,0000,,Бұл жолы мен мәселені шешемін.
Dialogue: 0,1:26:41.00,1:26:43.97,Default,,0000,0000,0000,,Како
Dialogue: 0,1:26:41.00,1:26:43.97,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,1:26:41.00,1:26:43.97,Default,,0000,0000,0000,,Өзіңізді оң және сол жақтан қоршаңыз!
Dialogue: 0,1:26:41.00,1:26:43.97,Default,,0000,0000,0000,,Зымыран ұшыру!
Dialogue: 0,1:26:43.97,1:26:45.97,Default,,0000,0000,0000,,(Зымыран ұшыру дыбысы)
Dialogue: 0,1:26:45.97,1:26:47.97,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:26:45.97,1:26:47.97,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:26:49.00,1:26:50.97,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:26:49.00,1:26:50.97,Default,,0000,0000,0000,,Сәлем! Апыр-ай!
Dialogue: 0,1:26:50.97,1:26:53.04,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,1:26:50.97,1:26:53.04,Default,,0000,0000,0000,,Мұздатпаңыз!
Dialogue: 0,1:26:53.04,1:26:55.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:26:53.04,1:26:55.01,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:26:55.01,1:26:56.98,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,1:26:55.01,1:26:56.98,Default,,0000,0000,0000,,Оны қу! Демалмаңыз!
Dialogue: 0,1:26:56.98,1:26:58.98,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,1:27:00.98,1:27:02.95,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:27:00.98,1:27:02.95,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:27:04.99,1:27:07.96,Default,,0000,0000,0000,,Жарайды, келесі жолы мен келемін.
Dialogue: 0,1:27:04.99,1:27:07.96,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,1:27:04.99,1:27:07.96,Default,,0000,0000,0000,,Соңғы соққы!
Dialogue: 0,1:27:07.96,1:27:09.99,Default,,0000,0000,0000,,Зенхомон
Dialogue: 0,1:27:07.96,1:27:09.99,Default,,0000,0000,0000,,Барлық қару қақпалары ашық!
Dialogue: 0,1:27:09.99,1:27:12.99,Default,,0000,0000,0000,,Қалай түсіру керек Дайындаңыз!
Dialogue: 0,1:27:12.99,1:27:16.00,Default,,0000,0000,0000,,шамамен осылай жас болар едің.
Dialogue: 0,1:27:12.99,1:27:16.00,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,1:27:16.00,1:27:17.97,Default,,0000,0000,0000,,Ату! Апыр-ай!
Dialogue: 0,1:27:20.00,1:27:24.01,Default,,0000,0000,0000,,Ату, ату, ату!
Dialogue: 0,1:27:24.01,1:27:25.97,Default,,0000,0000,0000,,Шегін!
Dialogue: 0,1:27:28.98,1:27:31.98,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:27:28.98,1:27:31.98,Default,,0000,0000,0000,,Сені қашып құтылуға жібермеймін!
Dialogue: 0,1:27:31.98,1:27:33.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:27:36.99,1:27:38.95,Default,,0000,0000,0000,,Әй, қарт кісі, жақсысың ба? Ауырған жоқсың ба?
Dialogue: 0,1:27:39.99,1:27:41.99,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:27:41.99,1:27:44.99,Default,,0000,0000,0000,,Цуйраку
Dialogue: 0,1:27:41.99,1:27:44.99,Default,,0000,0000,0000,,Осы жылдамдықпен сіз апатқа ұшырайсыз!
Dialogue: 0,1:27:41.99,1:27:44.99,Default,,0000,0000,0000,,Теңіз
Dialogue: 0,1:27:41.99,1:27:44.99,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,1:27:41.99,1:27:44.99,Default,,0000,0000,0000,,Оны теңізге апарыңыз!
Dialogue: 0,1:27:44.99,1:27:46.96,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:27:44.99,1:27:46.96,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:27:48.96,1:27:51.00,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,1:27:48.96,1:27:51.00,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,1:27:48.96,1:27:51.00,Default,,0000,0000,0000,,Ұрланған!
Dialogue: 0,1:27:51.00,1:27:52.97,Default,,0000,0000,0000,,Орятто!
Dialogue: 0,1:27:52.97,1:27:57.01,Default,,0000,0000,0000,,Құлау!
Dialogue: 0,1:27:52.97,1:27:57.01,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:27:52.97,1:27:57.01,Default,,0000,0000,0000,,Шогеки
Dialogue: 0,1:27:52.97,1:27:57.01,Default,,0000,0000,0000,,Барлық мүшелер, соққыға дайындалыңыз!
Dialogue: 0,1:27:57.01,1:28:06.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:28:06.98,1:28:09.95,Default,,0000,0000,0000,,
Dialogue: 0,1:28:06.98,1:28:09.95,Default,,0000,0000,0000,,Эй, Пития бастық, шық!
Dialogue: 0,1:28:09.95,1:28:13.02,Default,,0000,0000,0000,,Олай етпесең, осылай батып кетесің!
Dialogue: 0,1:28:09.95,1:28:13.02,Default,,0000,0000,0000,,Жарайды ма? Эй!
Dialogue: 0,1:28:13.02,1:28:15.02,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,1:28:13.02,1:28:15.02,Default,,0000,0000,0000,,О!
Dialogue: 0,1:28:15.02,1:28:17.99,Default,,0000,0000,0000,,Маған ұнамайды, Дора немесе басқасы.
Dialogue: 0,1:28:18.99,1:28:22.00,Default,,0000,0000,0000,,Жаншылдығың келмесе
Dialogue: 0,1:28:18.99,1:28:22.00,Default,,0000,0000,0000,,Қосан
Dialogue: 0,1:28:18.99,1:28:22.00,Default,,0000,0000,0000,,Беру.
Dialogue: 0,1:28:22.00,1:28:25.00,Default,,0000,0000,0000,,Ябан
Dialogue: 0,1:28:22.00,1:28:25.00,Default,,0000,0000,0000,,Жабайы алып!
Dialogue: 0,1:28:22.00,1:28:25.00,Default,,0000,0000,0000,,Қытай шамы
Dialogue: 0,1:28:22.00,1:28:25.00,Default,,0000,0000,0000,,Директордан қолдарыңызды алыңыз!
Dialogue: 0,1:28:25.00,1:28:27.04,Default,,0000,0000,0000,,Не!
Dialogue: 0,1:28:27.04,1:28:30.97,Default,,0000,0000,0000,,Тоқта, лейтенант! Біз жеңілдік.
Dialogue: 0,1:28:30.97,1:28:34.01,Default,,0000,0000,0000,,Хатшы…. Қарғыс атсын!
Dialogue: 0,1:28:34.01,1:28:36.08,Default,,0000,0000,0000,,Зенменкофуку
Dialogue: 0,1:28:34.01,1:28:36.08,Default,,0000,0000,0000,,Толық тапсыру.
Dialogue: 0,1:28:36.08,1:28:39.98,Default,,0000,0000,0000,,Бука
Dialogue: 0,1:28:36.08,1:28:39.98,Default,,0000,0000,0000,,Алайда, бағыныштылар
Dialogue: 0,1:28:36.08,1:28:39.98,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,1:28:36.08,1:28:39.98,Default,,0000,0000,0000,,О.
Dialogue: 0,1:28:36.08,1:28:39.98,Default,,0000,0000,0000,,Мен сенің кемені аман-есен түсіруіңді қалаймын.
Dialogue: 0,1:28:39.98,1:28:41.98,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:28:41.98,1:28:45.02,Default,,0000,0000,0000,,Тайин
Dialogue: 0,1:28:41.98,1:28:45.02,Default,,0000,0000,0000,,Мүшелеріміздің қауіпсіздігіне уәде берейік.
Dialogue: 0,1:28:45.02,1:28:46.99,Default,,0000,0000,0000,,Сонымен Гилмор ше?
Dialogue: 0,1:28:46.99,1:28:49.99,Default,,0000,0000,0000,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,1:28:46.99,1:28:49.99,Default,,0000,0000,0000,,Кууку
Dialogue: 0,1:28:46.99,1:28:49.99,Default,,0000,0000,0000,,Ол әуежайға бара жатқан шығар.
Dialogue: 0,1:28:49.99,1:28:51.99,Default,,0000,0000,0000,,Бірақ қашып құтыла алмайсың.
Dialogue: 0,1:28:51.99,1:28:55.00,Default,,0000,0000,0000,,Қазір туралы
Dialogue: 0,1:28:51.99,1:28:55.00,Default,,0000,0000,0000,,Қазір...
Dialogue: 0,1:28:55.00,1:28:58.00,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,1:28:55.00,1:28:58.00,Default,,0000,0000,0000,,Ей, көбірек ұшайық!
Dialogue: 0,1:28:55.00,1:28:58.00,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,1:28:58.00,1:29:00.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:29:00.00,1:29:02.00,Default,,0000,0000,0000,,Уа!
Dialogue: 0,1:29:02.00,1:29:06.01,Default,,0000,0000,0000,,Бізге еркіндік бер!
Dialogue: 0,1:29:02.00,1:29:06.01,Default,,0000,0000,0000,,Бізге еркіндік бер!
Dialogue: 0,1:29:06.01,1:29:09.01,Default,,0000,0000,0000,,Отасуке~!
Dialogue: 0,1:29:06.01,1:29:09.01,Default,,0000,0000,0000,,О.
Dialogue: 0,1:29:06.01,1:29:09.01,Default,,0000,0000,0000,,О, күте тұрыңыз! Мені артта қалдырмаңыз!
Dialogue: 0,1:29:09.01,1:29:11.01,Default,,0000,0000,0000,,Эй... Уау!
Dialogue: 0,1:29:11.01,1:29:16.02,Default,,0000,0000,0000,,Бізге еркіндік бер!
Dialogue: 0,1:29:11.01,1:29:16.02,Default,,0000,0000,0000,,Бізге еркіндік бер!
Dialogue: 0,1:29:16.02,1:29:22.02,Default,,0000,0000,0000,,Бізге еркіндік бер! Бізге еркіндік бер!
Dialogue: 0,1:29:22.02,1:29:24.99,Default,,0000,0000,0000,,Барлығы ...
Dialogue: 0,1:29:24.99,1:29:28.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:29:32.03,1:29:38.07,Default,,0000,0000,0000,,Кансей
Dialogue: 0,1:29:32.03,1:29:38.07,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:29:38.07,1:29:39.97,Default,,0000,0000,0000,,Хэхехе!
Dialogue: 0,1:29:39.97,1:29:43.01,Default,,0000,0000,0000,,Бітті.
Dialogue: 0,1:29:39.97,1:29:43.01,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:29:43.01,1:29:46.98,Default,,0000,0000,0000,,Думей
Dialogue: 0,1:29:43.01,1:29:46.98,Default,,0000,0000,0000,,А, бұл Альянс жауынгері!
Dialogue: 0,1:29:43.01,1:29:46.98,Default,,0000,0000,0000,,Әдемі….
Dialogue: 0,1:29:46.98,1:29:48.98,Default,,0000,0000,0000,,Егер сәл ертерек болса →
Dialogue: 0,1:29:48.98,1:29:51.99,Default,,0000,0000,0000,,Менің керемет жерім
Dialogue: 0,1:29:48.98,1:29:51.99,Default,,0000,0000,0000,,Сіз маған көрсете аласыз!
Dialogue: 0,1:29:55.02,1:29:57.99,Default,,0000,0000,0000,,Ханаби
Dialogue: 0,1:29:55.02,1:29:57.99,Default,,0000,0000,0000,,(отшашулардың дыбысы)
Dialogue: 0,1:30:01.96,1:30:04.03,Default,,0000,0000,0000,,Барлығыңызға рахмет.
Dialogue: 0,1:30:04.03,1:30:06.03,Default,,0000,0000,0000,,Сізге көп рахмет!
Dialogue: 0,1:30:10.00,1:30:12.97,Default,,0000,0000,0000,,Ахаха... Ах!
Dialogue: 0,1:30:16.98,1:30:19.98,Default,,0000,0000,0000,,Теріс
Dialogue: 0,1:30:16.98,1:30:19.98,Default,,0000,0000,0000,,Министр, өтінемін.
Dialogue: 0,1:30:16.98,1:30:19.98,Default,,0000,0000,0000,,Маған қалдырыңыз!
Dialogue: 0,1:30:19.98,1:30:23.95,Default,,0000,0000,0000,,Әй, Дораемон!
Dialogue: 0,1:30:19.98,1:30:23.95,Default,,0000,0000,0000,,Папи-кун мен Пиина-сан...
Dialogue: 0,1:30:24.99,1:30:26.99,Default,,0000,0000,0000,,Шизука-чан….
Dialogue: 0,1:30:26.99,1:30:29.99,Default,,0000,0000,0000,,Ешкімге… ешкімге…!!
Dialogue: 0,1:30:26.99,1:30:29.99,Default,,0000,0000,0000,,Екеумізге қалдырайық.
Dialogue: 0,1:30:29.99,1:30:31.99,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,1:30:31.99,1:30:34.96,Default,,0000,0000,0000,,Сізге жақсы, Папи.
Dialogue: 0,1:30:34.96,1:30:38.00,Default,,0000,0000,0000,,Хахахаха!
Dialogue: 0,1:30:38.00,1:30:42.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:30:42.97,1:30:46.97,Default,,0000,0000,0000,,Папиді қорғағаныңыз үшін рахмет.
Dialogue: 0,1:30:46.97,1:30:49.01,Default,,0000,0000,0000,,Пиина апа.
Dialogue: 0,1:30:46.97,1:30:49.01,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:30:49.01,1:30:52.98,Default,,0000,0000,0000,,Жарайды... бұл бекер емес.
Dialogue: 0,1:30:49.01,1:30:52.98,Default,,0000,0000,0000,,Шуяку
Dialogue: 0,1:30:49.01,1:30:52.98,Default,,0000,0000,0000,,Басты кейіпкер осындай жерде...
Dialogue: 0,1:30:54.98,1:30:56.95,Default,,0000,0000,0000,,Мен оны білдім.
Dialogue: 0,1:30:56.95,1:30:59.99,Default,,0000,0000,0000,,Тіпті егер Гилмор болса да
Dialogue: 0,1:30:56.95,1:30:59.99,Default,,0000,0000,0000,,Тіпті жеңе алсаңыз да →
Dialogue: 0,1:30:59.99,1:31:03.99,Default,,0000,0000,0000,,екеуміз де шараптан бір-бір жұтым татып қойдық…
Dialogue: 0,1:30:59.99,1:31:03.99,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,1:30:59.99,1:31:03.99,Default,,0000,0000,0000,,Біреудің құрбандығы сөзсіз.
Dialogue: 0,1:31:03.99,1:31:05.99,Default,,0000,0000,0000,,Папи….
Dialogue: 0,1:31:05.99,1:31:08.96,Default,,0000,0000,0000,,Жұмыс істемей жатыр!
Dialogue: 0,1:31:05.99,1:31:08.96,Default,,0000,0000,0000,,Мен мұны білсем де →
Dialogue: 0,1:31:08.96,1:31:11.00,Default,,0000,0000,0000,,Менің әпкем...
Dialogue: 0,1:31:11.00,1:31:13.97,Default,,0000,0000,0000,,Әпкеме дерлік...!
Dialogue: 0,1:31:14.97,1:31:20.07,Default,,0000,0000,0000,,Сіз сияқты
Dialogue: 0,1:31:14.97,1:31:20.07,Default,,0000,0000,0000,,Риппа
Dialogue: 0,1:31:14.97,1:31:20.07,Default,,0000,0000,0000,,Жақсы президент жоқ, Папи.
Dialogue: 0,1:31:20.07,1:31:22.01,Default,,0000,0000,0000,,Сен менің інімсің→
Dialogue: 0,1:31:22.01,1:31:24.95,Default,,0000,0000,0000,,Hoko
Dialogue: 0,1:31:22.01,1:31:24.95,Default,,0000,0000,0000,,Мен бұдан артық мақтана алмадым.
Dialogue: 0,1:31:24.95,1:31:27.05,Default,,0000,0000,0000,,Рахмет Папи.
Dialogue: 0,1:31:27.05,1:31:28.98,Default,,0000,0000,0000,,На
Dialogue: 0,1:31:27.05,1:31:28.98,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,1:31:27.05,1:31:28.98,Default,,0000,0000,0000,,(Папидің айқайы)
Dialogue: 0,1:31:28.98,1:31:39.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:31:42.96,1:31:45.00,Default,,0000,0000,0000,,Бастама
Dialogue: 0,1:31:42.96,1:31:45.00,Default,,0000,0000,0000,,Мен теңізден жақындағанда→
Dialogue: 0,1:31:45.00,1:31:48.00,Default,,0000,0000,0000,,Осава
Dialogue: 0,1:31:45.00,1:31:48.00,Default,,0000,0000,0000,,«Бұл үлкен адам, бұл үлкен адам»!
Dialogue: 0,1:31:48.00,1:31:51.01,Default,,0000,0000,0000,,Мен әрқашан «Чиби Чиби» деймін.
Dialogue: 0,1:31:48.00,1:31:51.01,Default,,0000,0000,0000,,Маған солай айтылды.
Dialogue: 0,1:31:51.01,1:31:53.98,Default,,0000,0000,0000,,Сосын кішкентай жарық та.
Dialogue: 0,1:31:51.01,1:31:53.98,Default,,0000,0000,0000,,Мен оны қайтарып алдым →
Dialogue: 0,1:31:53.98,1:31:56.01,Default,,0000,0000,0000,,Уақыт келді...
Dialogue: 0,1:31:56.01,1:31:57.98,Default,,0000,0000,0000,,Мен...
Dialogue: 0,1:31:57.98,1:31:59.98,Default,,0000,0000,0000,,Сонымен, сіз кетесіз.
Dialogue: 0,1:32:00.98,1:32:02.98,Default,,0000,0000,0000,,Жабайы болғаннан кейін өзімді сергек сезіндім!
Dialogue: 0,1:32:02.98,1:32:06.02,Default,,0000,0000,0000,,Эй, Папи-кун да.
Dialogue: 0,1:32:02.98,1:32:06.02,Default,,0000,0000,0000,,Жерге қайта кел!
Dialogue: 0,1:32:06.02,1:32:07.99,Default,,0000,0000,0000,,Бұл жолы Пиина-сан бізбен бірге болады.
Dialogue: 0,1:32:07.99,1:32:11.03,Default,,0000,0000,0000,,Ұшақ
Dialogue: 0,1:32:07.99,1:32:11.03,Default,,0000,0000,0000,,Содан кейін мен жасаған дирижабльде→
Dialogue: 0,1:32:11.03,1:32:14.03,Default,,0000,0000,0000,,Мейшо
Dialogue: 0,1:32:11.03,1:32:14.03,Default,,0000,0000,0000,,Мен сізге әртүрлі танымал жерлерді көрсетемін!
Dialogue: 0,1:32:14.03,1:32:16.00,Default,,0000,0000,0000,,Рахмет! өтінемін.
Dialogue: 0,1:32:16.00,1:32:19.00,Default,,0000,0000,0000,,Иә? Бұл не?
Dialogue: 0,1:32:19.00,1:32:20.97,Default,,0000,0000,0000,,Не болды? LocoRoco.
Dialogue: 0,1:32:20.97,1:32:24.01,Default,,0000,0000,0000,,Мен мұны енді ғана түсіндім
Dialogue: 0,1:32:20.97,1:32:24.01,Default,,0000,0000,0000,,Осылай қарап →
Dialogue: 0,1:32:24.01,1:32:26.97,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,1:32:24.01,1:32:26.97,Default,,0000,0000,0000,,Екеуің
Dialogue: 0,1:32:24.01,1:32:26.97,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,1:32:24.01,1:32:26.97,Default,,0000,0000,0000,,Олар өте ұқсас...
Dialogue: 0,1:32:26.97,1:32:31.98,Default,,0000,0000,0000,,Қараңызшы, LocoRoco!
Dialogue: 0,1:32:26.97,1:32:31.98,Default,,0000,0000,0000,,Уф уф!
Dialogue: 0,1:32:31.98,1:32:33.98,Default,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,1:32:31.98,1:32:33.98,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,1:32:33.98,1:32:38.09,Default,,0000,0000,0000,,Алыста жүрсек те
Dialogue: 0,1:32:33.98,1:32:38.09,Default,,0000,0000,0000,,Пирика халқы→
Dialogue: 0,1:32:38.09,1:32:42.09,Default,,0000,0000,0000,,Гата
Dialogue: 0,1:32:38.09,1:32:42.09,Default,,0000,0000,0000,,Yuuki
Dialogue: 0,1:32:38.09,1:32:42.09,Default,,0000,0000,0000,,Сіздің батылдығыңыз
Dialogue: 0,1:32:38.09,1:32:42.09,Default,,0000,0000,0000,,Оқиға
Dialogue: 0,1:32:38.09,1:32:42.09,Default,,0000,0000,0000,,Мен ешқашан ұмытпаймын.
Dialogue: 0,1:32:42.09,1:32:44.99,Default,,0000,0000,0000,,(Пинаның дауысы)
Dialogue: 0,1:32:42.09,1:32:44.99,Default,,0000,0000,0000,,Және олардың жанашырлығы...
Dialogue: 0,1:32:44.99,1:32:48.00,Default,,0000,0000,0000,,Қош бол!
Dialogue: 0,1:32:44.99,1:32:48.00,Default,,0000,0000,0000,,Сау болыңыз!
Dialogue: 0,1:32:48.00,1:32:52.00,Default,,0000,0000,0000,,Рахмет, Чикю!
Dialogue: 0,1:32:52.00,1:32:55.00,Default,,0000,0000,0000,,Біз тағы кездесетінімізге сенімдімін!
Dialogue: 0,1:32:55.00,1:32:58.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:33:03.01,1:33:05.01,Default,,0000,0000,0000,,На
Dialogue: 0,1:33:03.01,1:33:05.01,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,1:33:05.01,1:33:12.99,Default,,0000,0000,0000,,Музыка
Dialogue: 0,1:33:05.01,1:33:12.99,Default,,0000,0000,0000,,♬ ~ “(Музыка)”
Dialogue: 0,1:33:12.99,1:33:19.99,Default,,0000,0000,0000,,Хакушю
Dialogue: 0,1:33:12.99,1:33:19.99,Default,,0000,0000,0000,,(Шапалақтау)
Dialogue: 0,1:33:22.00,1:33:24.00,Default,,0000,0000,0000,,Уау... бұл керемет.
Dialogue: 0,1:33:24.00,1:33:27.00,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,1:33:24.00,1:33:27.00,Default,,0000,0000,0000,,Қалай суретке түсірдің...
Dialogue: 0,1:33:24.00,1:33:27.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:33:27.00,1:33:30.07,Default,,0000,0000,0000,,Оны естігіңіз келе ме?
Dialogue: 0,1:33:30.07,1:33:37.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:33:38.54,1:33:44.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory