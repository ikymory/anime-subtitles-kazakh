Dialogue: 0,0:30:55.19,0:30:57.16,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:30:55.19,0:30:57.16,Default,,0000,0000,0000,,(иіскеу дыбысы)
Dialogue: 0,0:30:58.19,0:31:02.19,Default,,0000,0000,0000,,Папопи парапепе~!
Dialogue: 0,0:31:02.19,0:31:04.20,Default,,0000,0000,0000,,Не? Бұл жігіт.
Dialogue: 0,0:31:04.20,0:31:06.23,Default,,0000,0000,0000,,Порпаппа Папилуппин?
Dialogue: 0,0:31:06.23,0:31:09.20,Default,,0000,0000,0000,,Олар жау емес сияқты...
Dialogue: 0,0:31:06.23,0:31:09.20,Default,,0000,0000,0000,,Шырмауық
Dialogue: 0,0:31:06.23,0:31:09.20,Default,,0000,0000,0000,,Ол саған бірдеңе айтқысы келеді.
Dialogue: 0,0:31:09.20,0:31:11.20,Default,,0000,0000,0000,,Папироппа!
Dialogue: 0,0:31:09.20,0:31:11.20,Default,,0000,0000,0000,,Осындай кезде...
Dialogue: 0,0:31:15.21,0:31:18.18,Default,,0000,0000,0000,,Егер сіз мұны жесеңіз
Dialogue: 0,0:31:15.21,0:31:18.18,Default,,0000,0000,0000,,Кез келген адамның сөзін түсінемін.
Dialogue: 0,0:31:19.21,0:31:22.28,Default,,0000,0000,0000,,Косеки
Dialogue: 0,0:31:19.21,0:31:22.28,Default,,0000,0000,0000,,Зымыранның ізімен жүріңіз
Dialogue: 0,0:31:19.21,0:31:22.28,Default,,0000,0000,0000,,Президенттің иісін қуу→
Dialogue: 0,0:31:22.28,0:31:25.22,Default,,0000,0000,0000,,Ақыры мен мұны білдім
Dialogue: 0,0:31:22.28,0:31:25.22,Default,,0000,0000,0000,,Бұл жер!
Dialogue: 0,0:31:25.22,0:31:27.29,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:31:25.22,0:31:27.29,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:31:25.22,0:31:27.29,Default,,0000,0000,0000,,(жұтыну дыбысы)
Dialogue: 0,0:31:27.29,0:31:29.19,Default,,0000,0000,0000,,Папи-кунды білетініме сене алар емеспін! ?
Dialogue: 0,0:31:29.19,0:31:32.19,Default,,0000,0000,0000,,Мен сөздерді түсінемін!
Dialogue: 0,0:31:29.19,0:31:32.19,Default,,0000,0000,0000,,Олай болса, бұл тез әңгіме!
Dialogue: 0,0:31:32.19,0:31:36.23,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:31:32.19,0:31:36.23,Default,,0000,0000,0000,,Айкен
Dialogue: 0,0:31:32.19,0:31:36.23,Default,,0000,0000,0000,,Мен Папидің итімін.
Dialogue: 0,0:31:32.19,0:31:36.23,Default,,0000,0000,0000,,Оның аты ЛокоРоко.
Dialogue: 0,0:31:36.23,0:31:39.20,Default,,0000,0000,0000,,Оши
Dialogue: 0,0:31:36.23,0:31:39.20,Default,,0000,0000,0000,,Кел, айтшы!
Dialogue: 0,0:31:36.23,0:31:39.20,Default,,0000,0000,0000,,Папи қазір қайда?
Dialogue: 0,0:31:49.21,0:31:52.21,Default,,0000,0000,0000,,Дракоруру!
Dialogue: 0,0:31:49.21,0:31:52.21,Default,,0000,0000,0000,,Якусоку
Dialogue: 0,0:31:49.21,0:31:52.21,Default,,0000,0000,0000,,Бұл уәде етілгендей келді!
Dialogue: 0,0:31:52.21,0:31:54.28,Default,,0000,0000,0000,,Шизукаға айқайлаңыз!
Dialogue: 0,0:31:54.28,0:31:56.21,Default,,0000,0000,0000,,⚟ (судың дыбысы)
Dialogue: 0,0:31:54.28,0:31:56.21,Default,,0000,0000,0000,,Мияу...!
Dialogue: 0,0:31:56.21,0:32:03.19,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:32:03.19,0:32:06.19,Default,,0000,0000,0000,,
Dialogue: 0,0:32:03.19,0:32:06.19,Default,,0000,0000,0000,,Сейбутсу
Dialogue: 0,0:32:03.19,0:32:06.19,Default,,0000,0000,0000,,«Ол не мақұлық? Папи».
Dialogue: 0,0:32:06.19,0:32:09.19,Default,,0000,0000,0000,,Дене
Dialogue: 0,0:32:06.19,0:32:09.19,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:32:06.19,0:32:09.19,Default,,0000,0000,0000,,Бұл машина мысықтың денесін алады.
Dialogue: 0,0:32:06.19,0:32:09.19,Default,,0000,0000,0000,,дұрыс емес.
Dialogue: 0,0:32:09.19,0:32:12.20,Default,,0000,0000,0000,,Қазір мен елсіз жердемін.
Dialogue: 0,0:32:12.20,0:32:15.20,Default,,0000,0000,0000,,Мен Шизука-санды құшақтап алғанымда
Dialogue: 0,0:32:12.20,0:32:15.20,Default,,0000,0000,0000,,О, құдайым
Dialogue: 0,0:32:12.20,0:32:15.20,Default,,0000,0000,0000,,Көрейік.
Dialogue: 0,0:32:15.20,0:32:19.20,Default,,0000,0000,0000,,Айка
Dialogue: 0,0:32:15.20,0:32:19.20,Default,,0000,0000,0000,,Хун. Әдеттегідей
Dialogue: 0,0:32:15.20,0:32:19.20,Default,,0000,0000,0000,,Бір сызықты арқан
Dialogue: 0,0:32:15.20,0:32:19.20,Default,,0000,0000,0000,,Мұны істеу оңай емес.
Dialogue: 0,0:32:19.20,0:32:22.17,Default,,0000,0000,0000,,Ылғау
Dialogue: 0,0:32:19.20,0:32:22.17,Default,,0000,0000,0000,,Алдымен өзіңді көрсет.
Dialogue: 0,0:32:19.20,0:32:22.17,Default,,0000,0000,0000,,Қыз одан кейін.
Dialogue: 0,0:32:22.17,0:32:24.18,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:32:24.18,0:32:28.18,Default,,0000,0000,0000,,Қауіпсіздік
Dialogue: 0,0:32:24.18,0:32:28.18,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:32:24.18,0:32:28.18,Default,,0000,0000,0000,,Шизука-сан қауіпсіз жерге
Dialogue: 0,0:32:24.18,0:32:28.18,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:32:24.18,0:32:28.18,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:32:24.18,0:32:28.18,Default,,0000,0000,0000,,Нё бірінші болып кетеді!
Dialogue: 0,0:32:28.18,0:32:31.18,Default,,0000,0000,0000,,
Dialogue: 0,0:32:28.18,0:32:31.18,Default,,0000,0000,0000,,Шинё
Dialogue: 0,0:32:28.18,0:32:31.18,Default,,0000,0000,0000,,«Сіз маған сенбейсіз бе?
Dialogue: 0,0:32:31.18,0:32:35.19,Default,,0000,0000,0000,,Бір рет
Dialogue: 0,0:32:31.18,0:32:35.19,Default,,0000,0000,0000,,Дракоруру, тіпті бір рет болсаң да
Dialogue: 0,0:32:31.18,0:32:35.19,Default,,0000,0000,0000,,Оқиға
Dialogue: 0,0:32:31.18,0:32:35.19,Default,,0000,0000,0000,,Сіз уәдеңізде тұрдыңыз ба? ?
Dialogue: 0,0:32:35.19,0:32:37.19,Default,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:32:35.19,0:32:37.19,Default,,0000,0000,0000,,Содан кейін кепілді босатқаннан кейін →
Dialogue: 0,0:32:37.19,0:32:40.19,Default,,0000,0000,0000,,Хошо
Dialogue: 0,0:32:37.19,0:32:40.19,Default,,0000,0000,0000,,Сіздің қашып кетпейтініңізге кепілдік жоқ.
Dialogue: 0,0:32:37.19,0:32:40.19,Default,,0000,0000,0000,,Бұл қайда! ?
Dialogue: 0,0:32:40.19,0:32:42.19,Default,,0000,0000,0000,,№.
Dialogue: 0,0:32:42.19,0:32:46.16,Default,,0000,0000,0000,,Бірақ бір рет болса да мен
Dialogue: 0,0:32:42.19,0:32:46.16,Default,,0000,0000,0000,,Сіз өтірік айттыңыз ба?
Dialogue: 0,0:32:47.20,0:32:49.20,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,0:32:50.27,0:32:52.17,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:32:52.17,0:32:54.21,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:32:52.17,0:32:54.21,Default,,0000,0000,0000,,Кемені қондырыңыз!
Dialogue: 0,0:32:52.17,0:32:54.21,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:32:54.21,0:33:00.24,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:33:00.24,0:33:02.25,Default,,0000,0000,0000,,Жүр!
Dialogue: 0,0:33:00.24,0:33:02.25,Default,,0000,0000,0000,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:33:03.18,0:33:06.18,Default,,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,0:33:03.18,0:33:06.18,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:33:03.18,0:33:06.18,Default,,0000,0000,0000,,Жоғал!
Dialogue: 0,0:33:06.18,0:33:08.19,Default,,0000,0000,0000,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:33:10.19,0:33:12.19,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:33:12.19,0:33:14.19,Default,,0000,0000,0000,,Шизука-сан!
Dialogue: 0,0:33:17.20,0:33:20.20,Default,,0000,0000,0000,,Мен тастап кеткен құралдар—
Dialogue: 0,0:33:17.20,0:33:20.20,Default,,0000,0000,0000,,Бұл туралы кейінірек. Асықшы!
Dialogue: 0,0:33:21.20,0:33:23.17,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:33:27.17,0:33:29.17,Default,,0000,0000,0000,,Генки
Dialogue: 0,0:33:27.17,0:33:29.17,Default,,0000,0000,0000,,Қош бол. Сіз жақсы жұмыс жасайсыз деп үміттенемін ...
Dialogue: 0,0:33:32.18,0:33:34.28,Default,,0000,0000,0000,,Папи болады деп ойламадым...! ?
Dialogue: 0,0:33:34.28,0:33:41.19,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:33:41.19,0:33:43.19,Default,,0000,0000,0000,,Жібер! Мен қашпаймын!
Dialogue: 0,0:33:43.19,0:33:47.16,Default,,0000,0000,0000,,Чабан
Dialogue: 0,0:33:43.19,0:33:47.16,Default,,0000,0000,0000,,Дракоруру! Бұл фарсты тоқтатыңыз
Dialogue: 0,0:33:43.19,0:33:47.16,Default,,0000,0000,0000,,Оны тез алып кет!
Dialogue: 0,0:33:47.16,0:33:51.26,Default,,0000,0000,0000,,Айтудың қажеті жоқ.
Dialogue: 0,0:33:47.16,0:33:51.26,Default,,0000,0000,0000,,Ренкоу
Dialogue: 0,0:33:47.16,0:33:51.26,Default,,0000,0000,0000,,Оны дереу алып кетіңіз.
Dialogue: 0,0:33:51.26,0:33:53.20,Default,,0000,0000,0000,,⚞Күтіңіз!
Dialogue: 0,0:33:51.26,0:33:53.20,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:33:53.20,0:33:56.20,Default,,0000,0000,0000,,Жоқ, папи!
Dialogue: 0,0:33:53.20,0:33:56.20,Default,,0000,0000,0000,,Бұл жақсы емес!
Dialogue: 0,0:33:56.20,0:33:58.20,Default,,0000,0000,0000,,Шизука-сан! ?
Dialogue: 0,0:33:56.20,0:33:58.20,Default,,0000,0000,0000,,Ааа... міне!
Dialogue: 0,0:33:58.20,0:34:00.27,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:33:58.20,0:34:00.27,Default,,0000,0000,0000,,Ату! Ат!
Dialogue: 0,0:34:00.27,0:34:02.17,Default,,0000,0000,0000,,Джугекион
Dialogue: 0,0:34:00.27,0:34:02.17,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,0:34:00.27,0:34:02.17,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:34:00.27,0:34:02.17,Default,,0000,0000,0000,,Ақымақ! Йосанка!
Dialogue: 0,0:34:02.17,0:34:04.18,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,0:34:02.17,0:34:04.18,Default,,0000,0000,0000,,Кя! Ахх...!
Dialogue: 0,0:34:04.18,0:34:06.18,Default,,0000,0000,0000,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:34:06.18,0:34:08.18,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:34:06.18,0:34:08.18,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:34:06.18,0:34:08.18,Default,,0000,0000,0000,,Атпа! Мені тірідей ұста!
Dialogue: 0,0:34:06.18,0:34:08.18,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:34:08.18,0:34:10.42,Default,,0000,0000,0000,,Папи-сан...!
Dialogue: 0,0:34:08.18,0:34:10.42,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:34:08.18,0:34:10.42,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:34:10.42,0:34:12.42,Default,,0000,0000,0000,,Ол жай ғана біреудің оны кешіруін қалады ғой, иә?
Dialogue: 0,0:34:10.42,0:34:12.42,Default,,0000,0000,0000,,⚟ (аяқ дыбысы)
Dialogue: 0,0:34:13.18,0:34:15.19,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:34:13.18,0:34:15.19,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:34:15.19,0:34:20.19,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:34:20.19,0:34:24.26,Default,,0000,0000,0000,,Зендан Мэйчуу
Dialogue: 0,0:34:20.19,0:34:24.26,Default,,0000,0000,0000,,Біз мұны жасадық! Барлық оқтар тиді!
Dialogue: 0,0:34:20.19,0:34:24.26,Default,,0000,0000,0000,,Қажетсіз атпаңыз!
Dialogue: 0,0:34:24.26,0:34:27.20,Default,,0000,0000,0000,,Міне болды! Шизука-чан және Папи-кун
Dialogue: 0,0:34:24.26,0:34:27.20,Default,,0000,0000,0000,,Орындалды
Dialogue: 0,0:34:24.26,0:34:27.20,Default,,0000,0000,0000,,Кеме астында!
Dialogue: 0,0:34:27.20,0:34:29.20,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:34:27.20,0:34:29.20,Default,,0000,0000,0000,,Барлығы менің соңымнан жүр!
Dialogue: 0,0:34:29.20,0:34:32.20,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:34:29.20,0:34:32.20,Default,,0000,0000,0000,,Қалғаны жоспарланғандай!
Dialogue: 0,0:34:29.20,0:34:32.20,Default,,0000,0000,0000,,(үру)
Dialogue: 0,0:34:32.20,0:34:42.21,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:34:42.21,0:34:44.22,Default,,0000,0000,0000,,Құрметті папи!
Dialogue: 0,0:34:42.21,0:34:44.22,Default,,0000,0000,0000,,LocoRoco! ?
Dialogue: 0,0:34:44.22,0:34:47.22,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:34:44.22,0:34:47.22,Default,,0000,0000,0000,,Тезірек атқа мін!
Dialogue: 0,0:34:44.22,0:34:47.22,Default,,0000,0000,0000,,Бірақ Дракорурумен уәде...
Dialogue: 0,0:34:47.22,0:34:49.19,Default,,0000,0000,0000,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:34:47.22,0:34:49.19,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:34:50.19,0:34:52.19,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:34:50.19,0:34:52.19,Default,,0000,0000,0000,,Тайкьяку
Dialogue: 0,0:34:50.19,0:34:52.19,Default,,0000,0000,0000,,Барлық мүшелер шегінеді!
Dialogue: 0,0:34:52.19,0:34:59.23,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:34:59.23,0:35:03.20,Default,,0000,0000,0000,,...
