Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.05,0:00:15.67,Jp,NTP,0000,0000,0000,,Альфа Бета Гамма
Dialogue: 0,0:00:15.92,0:00:16.96,Jp,NTP,0000,0000,0000,,Мақсатты қоршау
Dialogue: 0,0:00:24.84,0:00:26.02,Jp,NTP,0000,0000,0000,,Сіз қалтырап тұрсыз ба?
Dialogue: 0,0:00:26.30,0:00:28.55,Jp,NTP,0000,0000,0000,,Ол Альв ретінде тәжірибесіз.
Dialogue: 0,0:00:29.80,0:00:33.10,Jp,NTP,0000,0000,0000,,Енді мені өлтір, сатқын.
Dialogue: 0,0:00:36.70,0:00:37.76,Jp,NTP,0000,0000,0000,,Бөлшектерге тістеу
Dialogue: 0,0:01:09.67,0:01:10.94,Jp,NTP,0000,0000,0000,,Енді сағат 4-тегі жаңалықтарға.
Dialogue: 0,0:01:11.55,0:01:13.47,Jp,NTP,0000,0000,0000,,Окиноторисима Мега Флоат қаласы
Dialogue: 0,0:01:13.62,0:01:16.81,Jp,NTP,0000,0000,0000,,OMFC әкімшілік агенттігі және Alvin Co., Ltd.
Dialogue: 0,0:01:16.95,0:01:19.24,Jp,NTP,0000,0000,0000,,Бүгін түстен кейін бірлескен баспасөз мәслихаты өтті.
Dialogue: 0,0:01:19.52,0:01:21.89,Jp,NTP,0000,0000,0000,,Бір мезгілде дүние жүзінде психикалық жоғалту оқиғасы
Dialogue: 0,0:01:22.02,0:01:23.26,Jp,NTP,0000,0000,0000,,«Ерте көтерілуде»
Dialogue: 0,0:01:23.50,0:01:27.59,Jp,NTP,0000,0000,0000,,Психикалық функцияны жоғалтудың негізгі механизмі нақтыланғанын хабарлады
Dialogue: 0,0:01:34.08,0:01:35.49,Jp,NTP,0000,0000,0000,,Борттағы жолаушылар
Dialogue: 0,0:01:35.49,0:01:37.07,Jp,NTP,0000,0000,0000,,Бұл машинада жеткілікті уақыт қалды.
Dialogue: 0,0:01:37.07,0:01:39.35,Jp,NTP,0000,0000,0000,,Окиноторисима Мега Флоат қаласы
Dialogue: 0,0:01:39.69,0:01:43.71,Jp,NTP,0000,0000,0000,,Біз Дамана халықаралық әуежайына, OMFC-ге қонамыз.
Dialogue: 0,0:01:56.27,0:01:58.82,Jp,NTP,0000,0000,0000,,Окиноторисима ұшқышсыз таксиін пайдаланыңыз.
Dialogue: 0,0:01:58.82,0:02:00.12,Jp,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:02:03.79,0:02:04.91,Jp,NTP,0000,0000,0000,,Кашикомаримасу
Dialogue: 0,0:02:05.32,0:02:07.29,Jp,NTP,0000,0000,0000,,Енді қауіпсіздік белдіктерін тақыңыз.
Dialogue: 0,0:02:07.77,0:02:08.71,Jp,NTP,0000,0000,0000,,Гардарик империясы шапқыншылық бастады.
Dialogue: 0,0:02:26.70,0:02:28.21,Jp,NTP,0000,0000,0000,,Мен мұндамын, Шики
Dialogue: 0,0:02:40.40,0:02:41.38,Jp,NTP,0000,0000,0000,,Күйдіргіш жүз
Dialogue: 0,0:02:42.75,0:02:44.12,Jp,NTP,0000,0000,0000,,Сіз оны пайдаландыңыз деп ойлаймын.
Dialogue: 0,0:02:48.20,0:02:50.64,Jp,NTP,0000,0000,0000,,Не Рейму шын мәнінде.
Dialogue: 0,0:02:53.13,0:02:57.04,Jp,NTP,0000,0000,0000,,Менің Реймуға мойындайтын бір нәрсем бар.
Dialogue: 0,0:02:58.45,0:02:59.24,Jp,NTP,0000,0000,0000,,Мойындау
Dialogue: 0,0:03:00.14,0:03:01.75,Jp,NTP,0000,0000,0000,,Бұл қандай реакция?
Dialogue: 0,0:03:02.27,0:03:06.71,Jp,NTP,0000,0000,0000,,А, сен оның махаббатын мойындайды деп күттің бе?
Dialogue: 0,0:03:07.88,0:03:09.46,Jp,NTP,0000,0000,0000,,Ағаң туралы солай ойлайсың ба?
Dialogue: 0,0:03:09.46,0:03:13.16,Jp,NTP,0000,0000,0000,,Әй, қызарғаныңа қуаныштымын.
Dialogue: 0,0:03:13.24,0:03:15.96,Jp,NTP,0000,0000,0000,,Ақымақ, қызықсыз сөздер айта берсең, сөзіңді кесіп тастаймын.
Dialogue: 0,0:03:16.49,0:03:18.95,Jp,NTP,0000,0000,0000,,Қалжың, сен тым есін жиып қалдың.
Dialogue: 0,0:03:19.61,0:03:22.85,Jp,NTP,0000,0000,0000,,Мен әпкеме ренжігенше, қыз алғаным артық.
Dialogue: 0,0:03:24.18,0:03:26.09,Jp,NTP,0000,0000,0000,,Сонымен, мойындау дегеніміз не?
Dialogue: 0,0:03:29.54,0:03:33.60,Jp,NTP,0000,0000,0000,,Негізі қазір экранда тұрған мен емес.
Dialogue: 0,0:03:34.31,0:03:34.90,Jp,NTP,0000,0000,0000,,болып табылады
Dialogue: 0,0:03:35.22,0:03:37.52,Jp,NTP,0000,0000,0000,,Кешіріңіз, мен түсінбеймін.
Dialogue: 0,0:03:37.96,0:03:40.24,Jp,NTP,0000,0000,0000,,Мен де айта алмай қиналдым.
Dialogue: 0,0:03:40.97,0:03:43.59,Jp,NTP,0000,0000,0000,,Демек, бұл мағынаны білдіреді.
Dialogue: 0,0:03:45.66,0:03:50.55,Jp,NTP,0000,0000,0000,,Бұл бағдарлама бағдарламалық жасақтамасымен жұмыс істейтін менің бейнем ғана.
Dialogue: 0,0:03:51.15,0:03:53.69,Jp,NTP,0000,0000,0000,,Мен өзім мүлде қозғалмаймын.
Dialogue: 0,0:04:11.62,0:04:16.04,Jp,NTP,0000,0000,0000,,NLN нейрондық типті байланыс наномашиналары нені пайдаланады?
Dialogue: 0,0:04:16.40,0:04:18.15,Jp,NTP,0000,0000,0000,,Және дене бассейні
Dialogue: 0,0:04:18.82,0:04:20.59,Jp,NTP,0000,0000,0000,,Бұл өте ыңғайлы.
Dialogue: 0,0:04:21.06,0:04:24.01,Jp,NTP,0000,0000,0000,,Тамақтану, дәретхана, ұйықтау, т.б.
Dialogue: 0,0:04:24.25,0:04:28.01,Jp,NTP,0000,0000,0000,,Осындай қиын нәрселерге алаңдамай, оқуға көңіл бөлуге болады.
Dialogue: 0,0:04:28.64,0:04:30.25,Jp,NTP,0000,0000,0000,,Бұл шын мәнінде өте қымбат
Dialogue: 0,0:04:30.50,0:04:33.12,Jp,NTP,0000,0000,0000,,Менің мектебім осындай істерге көмектеседі.
Dialogue: 0,0:04:33.74,0:04:36.26,Jp,NTP,0000,0000,0000,,Менің айналамда оны қолданатын адамдар өте көп.
Dialogue: 0,0:04:37.65,0:04:38.43,Jp,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:04:39.36,0:04:40.69,Jp,NTP,0000,0000,0000,,Шындық құпия
Dialogue: 0,0:04:41.14,0:04:43.27,Jp,NTP,0000,0000,0000,,Бірақ мен оны құрметпен айтамын.
Dialogue: 0,0:04:44.35,0:04:47.23,Jp,NTP,0000,0000,0000,,Бұл менмін, мен тезірек толыққанды адам болғым келеді.
Dialogue: 0,0:04:47.75,0:04:51.25,Jp,NTP,0000,0000,0000,,Және менің қайтыс болған әкем мен анамның армандарын мұра ету.
Dialogue: 0,0:04:51.57,0:04:53.26,Jp,NTP,0000,0000,0000,,Мен озық ғалым болғым келеді
Dialogue: 0,0:04:54.05,0:04:54.90,Jp,NTP,0000,0000,0000,,Мен солай ойладым.
Dialogue: 0,0:04:56.81,0:04:59.67,Jp,NTP,0000,0000,0000,,Нағыз ата-анаңның армандары
Dialogue: 0,0:05:00.58,0:05:04.38,Jp,NTP,0000,0000,0000,,Иә, мен мұны анам мен әкем жазған кітапты оқу арқылы білдім.
Dialogue: 0,0:05:04.90,0:05:06.07,Jp,NTP,0000,0000,0000,,Осылай жазылған
Dialogue: 0,0:05:13.21,0:05:13.96,Jp,NTP,0000,0000,0000,,Шики
Dialogue: 0,0:05:25.60,0:05:26.60,Jp,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:05:28.75,0:05:30.95,Jp,NTP,0000,0000,0000,,Бұл бала кім?
Dialogue: 0,0:05:36.05,0:05:37.26,Jp,NTP,0000,0000,0000,,Қатысқан адамды ояту
Dialogue: 0,0:05:38.30,0:05:39.51,Jp,NTP,0000,0000,0000,,Жауап беру тобы аурухана бөлмесіне барады
Dialogue: 0,0:05:40.25,0:05:41.46,Jp,NTP,0000,0000,0000,,Айналадағы есіктерді құлыптаңыз
Dialogue: 0,0:05:41.54,0:05:42.56,Jp,NTP,0000,0000,0000,,Қашып кетудің алдын алу
Dialogue: 0,0:05:45.30,0:05:46.64,Jp,NTP,0000,0000,0000,,Менің кетуім керек
Dialogue: 0,0:05:51.67,0:05:52.88,Jp,NTP,0000,0000,0000,,Бұл дене
Dialogue: 0,0:05:56.85,0:05:58.19,Jp,NTP,0000,0000,0000,,Мені тыңда
Dialogue: 0,0:05:59.55,0:06:01.07,Jp,NTP,0000,0000,0000,,Тез, тез, сэр.
Dialogue: 0,0:06:05.43,0:06:08.17,Jp,NTP,0000,0000,0000,,Шики Микадж, мен саған жамандық жасамаймын.
Dialogue: 0,0:06:09.23,0:06:10.72,Jp,NTP,0000,0000,0000,,Шики Микадж
Dialogue: 0,0:06:12.22,0:06:14.44,Jp,NTP,0000,0000,0000,,Жоқ, мен
Dialogue: 0,0:06:15.12,0:06:17.11,Jp,NTP,0000,0000,0000,,«Келесі өмірде» апатқа ұшырадыңыз.
Dialogue: 0,0:06:17.45,0:06:20.85,Jp,NTP,0000,0000,0000,,Мен жанымнан айырылып, осы ауруханада қалдым.
Dialogue: 0,0:06:21.29,0:06:24.17,Jp,NTP,0000,0000,0000,,Бұл жолы емделуіміз лайықты болды.
Dialogue: 0,0:06:24.25,0:06:25.78,Jp,NTP,0000,0000,0000,,Менің жаным оралды.
Dialogue: 0,0:06:26.30,0:06:28.22,Jp,NTP,0000,0000,0000,,Сіздің жадыңызда әлі де шатасу болуы мүмкін, бірақ
Dialogue: 0,0:06:28.86,0:06:31.07,Jp,NTP,0000,0000,0000,,Бәрін бізге қалдыр.
Dialogue: 0,0:06:32.15,0:06:33.60,Jp,NTP,0000,0000,0000,,Енді осында кел.
Dialogue: 0,0:06:36.70,0:06:37.59,Jp,NTP,0000,0000,0000,,Оны бекітіңіз.
Dialogue: 0,0:06:40.41,0:06:41.65,Jp,NTP,0000,0000,0000,,Бұл анық
Dialogue: 0,0:06:43.52,0:06:44.34,Jp,NTP,0000,0000,0000,,Бұл мүмкін емес қой?
Dialogue: 0,0:06:53.22,0:06:54.47,Jp,NTP,0000,0000,0000,,Лифтке қарай
Dialogue: 0,0:06:56.36,0:06:57.10,Jp,NTP,0000,0000,0000,,Жылдамырақ
Dialogue: 0,0:07:00.64,0:07:02.34,Jp,NTP,0000,0000,0000,,NLN бар робот
Dialogue: 0,0:07:09.39,0:07:09.99,Jp,NTP,0000,0000,0000,,Тоқта
Dialogue: 0,0:07:10.26,0:07:11.30,Jp,NTP,0000,0000,0000,,Түзу болыңыз
Dialogue: 0,0:07:17.61,0:07:18.69,Jp,NTP,0000,0000,0000,,Басқа нәрсе
Dialogue: 0,0:07:21.51,0:07:22.81,Jp,NTP,0000,0000,0000,,Жай ғана қозғалмаңыз
Dialogue: 0,0:07:23.42,0:07:24.04,Jp,NTP,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:07:30.46,0:07:31.27,Jp,NTP,0000,0000,0000,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:07:31.79,0:07:33.99,Jp,NTP,0000,0000,0000,,Қазірдің өзінде кеш
Dialogue: 0,0:07:34.22,0:07:35.03,Jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:07:37.50,0:07:40.58,Jp,NTP,0000,0000,0000,,Желідегі құрылғыларды еркін басқару
Dialogue: 0,0:07:41.00,0:07:43.18,Jp,NTP,0000,0000,0000,,Иә, ол да Альв.
Dialogue: 0,0:07:45.63,0:07:46.46,Jp,NTP,0000,0000,0000,,Бұл Оберон.
Dialogue: 0,0:07:47.05,0:07:48.42,Jp,NTP,0000,0000,0000,,Номад, сұрыптау уақыты келді.
Dialogue: 0,0:07:49.22,0:07:50.84,Jp,NTP,0000,0000,0000,,Альв жалғыз қашып кетті.
Dialogue: 0,0:07:51.39,0:07:52.25,Jp,NTP,0000,0000,0000,,Бақылаңыз және оны жойыңыз.
Dialogue: 0,0:07:53.66,0:07:54.55,Jp,NTP,0000,0000,0000,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:07:57.48,0:08:00.44,Jp,NTP,0000,0000,0000,,Уақытыңызды бөлгеніңізге рахмет, Stanblade.
Dialogue: 0,0:08:00.97,0:08:03.70,Jp,NTP,0000,0000,0000,,Дене бассейнінде болсаңыз да, сыртқа шығатын кездер болады.
Dialogue: 0,0:08:05.05,0:08:06.30,Jp,NTP,0000,0000,0000,,Мен уайымдап жүрмін.
Dialogue: 0,0:08:06.74,0:08:10.21,Jp,NTP,0000,0000,0000,,Иә, кейбір адамдар бұрыннан бар.
Dialogue: 0,0:08:10.34,0:08:11.67,Jp,NTP,0000,0000,0000,,Мен анда-санда көрінетін түріммін.
Dialogue: 0,0:08:12.18,0:08:13.49,Jp,NTP,0000,0000,0000,,Сондықтан мен бақыттымын
Dialogue: 0,0:08:13.49,0:08:16.06,Jp,NTP,0000,0000,0000,,Маған бұл тым ұсақ-түйек сияқты.
Dialogue: 0,0:08:16.55,0:08:18.57,Jp,NTP,0000,0000,0000,,Оны пайдаланғыңыз келмесе, жақсы.
Dialogue: 0,0:08:18.87,0:08:21.77,Jp,NTP,0000,0000,0000,,Жоқ, мен оны бірдеңе болған жағдайда қолданамын.
Dialogue: 0,0:08:22.30,0:08:24.48,Jp,NTP,0000,0000,0000,,Оның үстіне бұл маған сыпайылық ретінде берілді.
Dialogue: 0,0:08:25.49,0:08:26.14,Jp,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:08:27.77,0:08:30.59,Jp,NTP,0000,0000,0000,,Дұрыс, Рейму, тағы да мойындауға болады.
Dialogue: 0,0:08:31.24,0:08:32.06,Jp,NTP,0000,0000,0000,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 0,0:08:32.40,0:08:34.35,Jp,NTP,0000,0000,0000,,«Келесі өмірді» білесіз бе?
Dialogue: 0,0:08:34.93,0:08:35.45,Jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:08:35.45,0:08:36.66,Jp,NTP,0000,0000,0000,,Қарапайым тілмен айтқанда.
Dialogue: 0,0:08:37.43,0:08:39.55,Jp,NTP,0000,0000,0000,,NLN пайдалану арқылы
Dialogue: 0,0:08:39.65,0:08:44.10,Jp,NTP,0000,0000,0000,,Бұл виртуалды әлемді бес сезім мүшесі арқылы сезінуге мүмкіндік беретін қызмет.
Dialogue: 0,0:08:45.67,0:08:48.09,Jp,NTP,0000,0000,0000,,Біраз уақыттан бері «Екінші өмір» сияқты нәрсе.
Dialogue: 0,0:08:48.49,0:08:51.41,Jp,NTP,0000,0000,0000,,Жоқ, бұл одан да керемет.\NСіз мұны
Dialogue: 0,0:08:52.06,0:08:53.55,Jp,NTP,0000,0000,0000,,арқылы жасайсыз ба?
Dialogue: 0,0:08:53.90,0:08:55.30,Jp,NTP,0000,0000,0000,,Қызықты көрінеді
Dialogue: 0,0:08:55.58,0:08:56.84,Jp,NTP,0000,0000,0000,,Бұл дем алудың да тамаша тәсілі.
Dialogue: 0,0:08:57.41,0:08:58.88,Jp,NTP,0000,0000,0000,,Қаласаңыз, комплиментпен келіңіз.
Dialogue: 0,0:08:59.09,0:08:59.97,Jp,NTP,0000,0000,0000,,Ендеше бірге ойнайық
Dialogue: 0,0:09:00.63,0:09:02.71,Jp,NTP,0000,0000,0000,,Жарайды, мен ойланып көрейін.
Dialogue: 0,0:09:04.30,0:09:04.84,Jp,NTP,0000,0000,0000,,Джейн
Dialogue: 0,0:09:07.80,0:09:11.48,Jp,NTP,0000,0000,0000,,25 наурызда сағат 18.00-ден 26-сы таңғы таңға дейін болды.
Dialogue: 0,0:09:11.63,0:09:14.07,Jp,NTP,0000,0000,0000,,Бір мезгілде дүние жүзінде психикалық жоғалту оқиғасы
Dialogue: 0,0:09:14.22,0:09:16.28,Jp,NTP,0000,0000,0000,,«Ерте көтерілу» бойынша бақылау
Dialogue: 0,0:09:16.73,0:09:19.11,Jp,NTP,0000,0000,0000,,Жүйке жасушасы типті байланыс наномашинасы
Dialogue: 0,0:09:19.27,0:09:24.01,Jp,NTP,0000,0000,0000,,NLN аббревиатурасын қолданатын «Келесі өмір» виртуалды кеңістігіне қатысушылардың арасында
Dialogue: 0,0:09:24.28,0:09:29.59,Jp,NTP,0000,0000,0000,,Дүние жүзі бойынша 52 535 пайдаланушы психикалық функцияларын жоғалтты.
Dialogue: 0,0:09:29.59,0:09:31.24,Jp,NTP,0000,0000,0000,,Өсімдік-адам күйіне
Dialogue: 0,0:09:31.61,0:09:36.54,Jp,NTP,0000,0000,0000,,Тағы 253 345 пайдаланушы
Dialogue: 0,0:09:36.54,0:09:38.20,Jp,NTP,0000,0000,0000,,Өлген
Dialogue: 0,0:09:49.28,0:09:53.33,Jp,NTP,0000,0000,0000,,Мен осындай NLN пайдаланамын.
Dialogue: 0,0:10:01.35,0:10:02.06,Jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:10:12.85,0:10:13.64,Jp,NTP,0000,0000,0000,,Шики
Dialogue: 0,0:10:27.34,0:10:28.40,Jp,NTP,0000,0000,0000,,Сол Титан
Dialogue: 0,0:10:29.83,0:10:31.61,Jp,NTP,0000,0000,0000,,А, солай.
Dialogue: 0,0:10:31.85,0:10:33.76,Jp,NTP,0000,0000,0000,,Жарайсың Шики
Dialogue: 0,0:10:34.39,0:10:36.84,Jp,NTP,0000,0000,0000,,Мм, мен.
Dialogue: 0,0:10:37.57,0:10:38.18,Jp,NTP,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:10:38.18,0:10:39.44,Jp,NTP,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:10:41.49,0:10:45.10,Jp,NTP,0000,0000,0000,,Мүмкін мен басқа шығармын.
Dialogue: 0,0:10:45.83,0:10:47.87,Jp,NTP,0000,0000,0000,,Өзіңді кіммін деп ойлайсың?
Dialogue: 0,0:10:48.49,0:10:50.21,Jp,NTP,0000,0000,0000,,Бұл Шики болуы керек.
Dialogue: 0,0:10:50.60,0:10:52.62,Jp,NTP,0000,0000,0000,,Мен білмеймін, білмеймін
Dialogue: 0,0:10:53.65,0:10:58.10,Jp,NTP,0000,0000,0000,,Мен бұл киген денемнің мен екеніне мүлде сенімді емеспін.
Dialogue: 0,0:10:58.67,0:11:00.74,Jp,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:11:01.24,0:11:03.11,Jp,NTP,0000,0000,0000,,Мен сен айтқандаймын
Dialogue: 0,0:11:03.26,0:11:05.10,Jp,NTP,0000,0000,0000,,Мүмкін сіз білетін адам шығар
Dialogue: 0,0:11:05.49,0:11:07.69,Jp,NTP,0000,0000,0000,,Бірақ ол мүлдем басқа адам болуы мүмкін.
Dialogue: 0,0:11:07.97,0:11:09.05,Jp,NTP,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:11:09.60,0:11:12.46,Jp,NTP,0000,0000,0000,,«Ерте көтерілу» Сол апатта
Dialogue: 0,0:11:12.59,0:11:15.01,Jp,NTP,0000,0000,0000,,«Келесі өмірге» кірген барлық жандар
Dialogue: 0,0:11:15.32,0:11:17.09,Jp,NTP,0000,0000,0000,,Бірде мен денемді тастап кеттім
Dialogue: 0,0:11:17.51,0:11:19.93,Jp,NTP,0000,0000,0000,,Осыдан кейін әрбір жан дұрыс
Dialogue: 0,0:11:20.10,0:11:22.14,Jp,NTP,0000,0000,0000,,Сіз өз денеңізге орала аласыз
Dialogue: 0,0:11:22.63,0:11:24.83,Jp,NTP,0000,0000,0000,,Сіз қайдан білесіз?
Dialogue: 0,0:11:26.80,0:11:29.40,Jp,NTP,0000,0000,0000,,Бұл өтірік. Менің ойымша, сіз жай ғана ұмытып кеттіңіз.
Dialogue: 0,0:11:30.04,0:11:33.75,Jp,NTP,0000,0000,0000,,Есіңізде болсын, бұл сіз тұратын бөлме.
Dialogue: 0,0:11:34.85,0:11:36.64,Jp,NTP,0000,0000,0000,,Мен сенің ағаңмын
Dialogue: 0,0:11:36.64,0:11:37.81,Jp,NTP,0000,0000,0000,,Жібер
Dialogue: 0,0:11:40.04,0:11:42.26,Jp,NTP,0000,0000,0000,,Мен білмеймін, білмеймін
Dialogue: 0,0:11:45.62,0:11:46.87,Jp,NTP,0000,0000,0000,,Тек киініңіз.
Dialogue: 0,0:11:48.36,0:11:50.99,Jp,NTP,0000,0000,0000,,Шики деген жадыңыз болмаса да.
Dialogue: 0,0:11:52.43,0:11:55.16,Jp,NTP,0000,0000,0000,,Мен апамды бұлай жалғыз қалдыра алмаймын.
Dialogue: 0,0:11:56.96,0:11:59.07,Jp,NTP,0000,0000,0000,,Егер бұл сіздің шики киіміңіз болса
Dialogue: 0,0:12:00.60,0:12:01.58,Jp,NTP,0000,0000,0000,,Қанша көп болса, сонша бар.
Dialogue: 0,0:12:03.14,0:12:04.20,Jp,NTP,0000,0000,0000,,Түсінікті
Dialogue: 0,0:12:04.80,0:12:07.50,Jp,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:12:14.16,0:12:16.95,Jp,NTP,0000,0000,0000,,Сіз шынымен Шикисіз бе?
Dialogue: 0,0:12:17.80,0:12:18.57,Jp,NTP,0000,0000,0000,,Шики ме деп ойлаймын
Dialogue: 0,0:12:19.45,0:12:21.01,Jp,NTP,0000,0000,0000,,Мен екі айда бірінші рет ояндым.
Dialogue: 0,0:12:21.55,0:12:23.43,Jp,NTP,0000,0000,0000,,Менің есте сақтау қабілетім жай ғана шатасуы мүмкін.
Dialogue: 0,0:12:24.23,0:12:25.56,Jp,NTP,0000,0000,0000,,Мен солай ойлағым келеді.
Dialogue: 0,0:12:26.67,0:12:29.36,Jp,NTP,0000,0000,0000,,Мені мейіріммен құшақтап алған сен
Dialogue: 0,0:12:29.70,0:12:32.05,Jp,NTP,0000,0000,0000,,Өзіңді нағыз ағам деп ойласаң
Dialogue: 0,0:12:32.51,0:12:33.84,Jp,NTP,0000,0000,0000,,Өзіңізді қаншалықты қауіпсіз сезінесіз?
Dialogue: 0,0:12:34.74,0:12:37.22,Jp,NTP,0000,0000,0000,,Бірақ мен келісе алмаймын.
Dialogue: 0,0:12:37.75,0:12:41.55,Jp,NTP,0000,0000,0000,,Өйткені мен де, осы дененің өзі де біртүрлі сезінеміз.
Dialogue: 0,0:12:41.75,0:12:43.22,Jp,NTP,0000,0000,0000,,Өте ыңғайсыз
Dialogue: 0,0:12:43.26,0:12:44.83,Jp,NTP,0000,0000,0000,,Қозғалу өте қиын
Dialogue: 0,0:12:45.13,0:12:49.72,Jp,NTP,0000,0000,0000,,Мен бұл дененің оң қолы немесе сол қолы екенін білмедім.
Dialogue: 0,0:12:50.11,0:12:53.31,Jp,NTP,0000,0000,0000,,Бірақ оң қолымды жылжыту қиындай түсті.
Dialogue: 0,0:12:53.55,0:12:56.74,Jp,NTP,0000,0000,0000,,Сол қолым жеңілірек екенін байқай бастадым.
Dialogue: 0,0:12:57.40,0:12:58.95,Jp,NTP,0000,0000,0000,,Жай ғана есте сақтау қабілетін жоғалтты
Dialogue: 0,0:12:59.06,0:13:01.10,Jp,NTP,0000,0000,0000,,Сіз осындай қарапайым нәрселерді ұмытасыз ба?
Dialogue: 0,0:13:02.17,0:13:03.19,Jp,NTP,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:13:03.71,0:13:08.84,Jp,NTP,0000,0000,0000,,Ал кеуделері тым ауыр.
Dialogue: 0,0:13:09.45,0:13:10.55,Jp,NTP,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:13:11.39,0:13:14.07,Jp,NTP,0000,0000,0000,,Менің кеудеме мұндай нәрсені кигенім есімде жоқ.
Dialogue: 0,0:13:14.51,0:13:16.28,Jp,NTP,0000,0000,0000,,Оны киген кездегі естелік деп аталады.
Dialogue: 0,0:13:16.79,0:13:22.02,Jp,NTP,0000,0000,0000,,Біріншіден, менің бұрынғы денем есімде жоқ.
Dialogue: 0,0:13:22.89,0:13:23.93,Jp,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:13:26.29,0:13:27.08,Jp,NTP,0000,0000,0000,,Мұнда кел
Dialogue: 0,0:13:35.56,0:13:37.51,Jp,NTP,0000,0000,0000,,Жалған ақпарат?
Dialogue: 0,0:13:40.82,0:13:42.12,Jp,NTP,0000,0000,0000,,Басқа адам бар ма?
Dialogue: 0,0:13:42.53,0:13:44.64,Jp,NTP,0000,0000,0000,,Тәтті, мұнда NLN жоқ.
Dialogue: 0,0:13:45.51,0:13:46.92,Jp,NTP,0000,0000,0000,,Сонда физика жақсы.
Dialogue: 0,0:13:49.57,0:13:51.56,Jp,NTP,0000,0000,0000,,Эй, бұл не?
Dialogue: 0,0:13:51.80,0:13:56.11,Jp,NTP,0000,0000,0000,,АҚШ әскери шенеунігі офицер «Уордог» тактикалық ұрыс машинасын тұтқындады.
Dialogue: 0,0:13:56.43,0:13:59.46,Jp,NTP,0000,0000,0000,,Желі арқылы сымсыз басқаруға болатын қару.
Dialogue: 0,0:13:59.92,0:14:00.96,Jp,NTP,0000,0000,0000,,Радио жұмысы
Dialogue: 0,0:14:03.38,0:14:05.41,Jp,NTP,0000,0000,0000,,Бұл нәрсені басқаратын біреу бар ма?
Dialogue: 0,0:14:05.80,0:14:08.72,Jp,NTP,0000,0000,0000,,Иә, егер желідегі деректер трафигін талдасақ.
Dialogue: 0,0:14:08.90,0:14:10.40,Jp,NTP,0000,0000,0000,,Мұны түсіну оңай.
Dialogue: 0,0:14:10.90,0:14:11.40,Jp,NTP,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:14:25.41,0:14:26.66,Jp,NTP,0000,0000,0000,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:14:27.30,0:14:30.60,Jp,NTP,0000,0000,0000,,Оптикалық сенсорға бұлтты культура сұйықтығы әсер етті.
Dialogue: 0,0:14:31.00,0:14:32.40,Jp,NTP,0000,0000,0000,,Мен жылытуға ауысқаннан бері
Dialogue: 0,0:14:32.54,0:14:34.16,Jp,NTP,0000,0000,0000,,Инфрақызыл сәулелерді де қолдануға болмайды
Dialogue: 0,0:14:36.20,0:14:36.90,Jp,NTP,0000,0000,0000,,Қандай жағымсыз!
Dialogue: 0,0:14:37.06,0:14:38.62,Jp,NTP,0000,0000,0000,,Бұл ұзаққа созылмауы керек.
Dialogue: 0,0:14:41.03,0:14:45.05,Jp,NTP,0000,0000,0000,,Сізде NLN арқылы жүйемен әрекеттесу мүмкіндігі бар ма?
Dialogue: 0,0:14:46.90,0:14:47.66,Jp,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:14:58.67,0:14:59.44,Jp,NTP,0000,0000,0000,,Мұнда кел
Dialogue: 0,0:15:08.10,0:15:09.21,Jp,NTP,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,0:15:11.10,0:15:12.30,Jp,NTP,0000,0000,0000,,Маған ішуге не бердіңіз?
Dialogue: 0,0:15:13.81,0:15:14.99,Jp,NTP,0000,0000,0000,,NLN
Dialogue: 0,0:15:16.07,0:15:17.94,Jp,NTP,0000,0000,0000,,Ақымақ, білмейсің бе?
Dialogue: 0,0:15:18.09,0:15:19.41,Jp,NTP,0000,0000,0000,,NLN қауіпті
Dialogue: 0,0:15:19.41,0:15:20.66,Jp,NTP,0000,0000,0000,,Адамдар маған ұнайды
Dialogue: 0,0:15:20.75,0:15:23.12,Jp,NTP,0000,0000,0000,,Қарсыластың қимылын NLN арқылы ұстаңыз
Dialogue: 0,0:15:23.61,0:15:25.50,Jp,NTP,0000,0000,0000,,Егер сізде NLN болмаса
Dialogue: 0,0:15:25.92,0:15:29.53,Jp,NTP,0000,0000,0000,,Ол сізді оптикалық және инфрақызыл камералармен іздейді.
Dialogue: 0,0:15:29.85,0:15:32.58,Jp,NTP,0000,0000,0000,,Содан кейін жалған ақпаратқа шектеулер бар.
Dialogue: 0,0:15:34.20,0:15:37.15,Jp,NTP,0000,0000,0000,,Қараңызшы, сіздің ақпаратыңызда NLN басым.
Dialogue: 0,0:15:37.69,0:15:39.01,Jp,NTP,0000,0000,0000,,Оны да ұстап алды
Dialogue: 0,0:15:39.66,0:15:41.52,Jp,NTP,0000,0000,0000,,Жалған NLN ақпараты
Dialogue: 0,0:15:43.84,0:15:46.10,Jp,NTP,0000,0000,0000,,Жоқ, бірақ мұндай нәрсе
Dialogue: 0,0:15:46.48,0:15:48.45,Jp,NTP,0000,0000,0000,,Сіз шынымен Шикисіз.
Dialogue: 0,0:15:50.73,0:15:51.65,Jp,NTP,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:15:52.36,0:15:55.55,Jp,NTP,0000,0000,0000,,Сол «Вардогты» басқаратын жігітке барып, оны жеңіңіз.
Dialogue: 0,0:15:55.95,0:15:57.81,Jp,NTP,0000,0000,0000,,Оны жеңуге бола ма?
Dialogue: 0,0:15:58.59,0:15:59.66,Jp,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:16:00.02,0:16:01.26,Jp,NTP,0000,0000,0000,,Оны жеңуге болады.
Dialogue: 0,0:16:01.57,0:16:04.32,Jp,NTP,0000,0000,0000,,Егер мен мұны жақсы орындасам, мен сенімдімін
Dialogue: 0,0:16:05.10,0:16:06.69,Jp,NTP,0000,0000,0000,,Маған да ұнамайды.
Dialogue: 0,0:16:06.88,0:16:08.89,Jp,NTP,0000,0000,0000,,Ештеңені білмей аяқталу
Dialogue: 0,0:16:10.30,0:16:12.84,Jp,NTP,0000,0000,0000,,Бақытымызға орай, менде де күш бар.
Dialogue: 0,0:16:13.30,0:16:15.42,Jp,NTP,0000,0000,0000,,Себебін білмесем де
Dialogue: 0,0:16:16.01,0:16:19.08,Jp,NTP,0000,0000,0000,,Бірақ сол себепті, себебін білу үшін
Dialogue: 0,0:16:19.44,0:16:20.47,Jp,NTP,0000,0000,0000,,Тірі қалу керек
Dialogue: 0,0:16:22.65,0:16:23.64,Jp,NTP,0000,0000,0000,,бірге
Dialogue: 0,0:16:25.48,0:16:27.07,Jp,NTP,0000,0000,0000,,Келіп алуға болмайды.
Dialogue: 0,0:16:27.46,0:16:29.30,Jp,NTP,0000,0000,0000,,Өйткені I
Dialogue: 0,0:16:30.16,0:16:33.00,Jp,NTP,0000,0000,0000,,Сізді бұған араластырғаным үшін кешірім сұраймын.
Dialogue: 0,0:16:34.40,0:16:36.15,Jp,NTP,0000,0000,0000,,Бірақ бәрібір.
Dialogue: 0,0:16:36.60,0:16:37.90,Jp,NTP,0000,0000,0000,,Мен жалғыз болсам да
Dialogue: 0,0:16:39.03,0:16:41.08,Jp,NTP,0000,0000,0000,,Менде амнезия бар.
Dialogue: 0,0:16:41.66,0:16:45.42,Jp,NTP,0000,0000,0000,,Мен мұны кейін анам мен әкем жазған кітапты оқығанда білдім.
Dialogue: 0,0:16:45.76,0:16:46.87,Jp,NTP,0000,0000,0000,,Осылай жазылған
Dialogue: 0,0:16:47.52,0:16:50.07,Jp,NTP,0000,0000,0000,,Армандар алға ұмтылу сияқты.
Dialogue: 0,0:16:50.63,0:16:52.66,Jp,NTP,0000,0000,0000,,Шындығында, артқа қараңыз
Dialogue: 0,0:16:52.79,0:16:54.95,Jp,NTP,0000,0000,0000,,Қиындыққа тап болған адамға көмектесу.
Dialogue: 0,0:16:55.32,0:16:56.95,Jp,NTP,0000,0000,0000,,Мұқтаж адамға көмектесу
Dialogue: 0,0:16:57.42,0:17:00.80,Jp,NTP,0000,0000,0000,,Иә, сіз «ресурс серігі» терминін білесіз бе?
Dialogue: 0,0:17:01.56,0:17:03.44,Jp,NTP,0000,0000,0000,,Өйткені мен қалағанымша іздей аламын
Dialogue: 0,0:17:03.75,0:17:05.83,Jp,NTP,0000,0000,0000,,Мен қанша сөзді қалаймын, сонша есімде сақтай аламын.
Dialogue: 0,0:17:08.03,0:17:09.29,Jp,NTP,0000,0000,0000,,Зымырандарды пайдалану
Dialogue: 0,0:17:09.49,0:17:12.51,Jp,NTP,0000,0000,0000,,Бұл астероидты Жерге жақындататын нәрсе болуы мүмкін.
Dialogue: 0,0:17:12.95,0:17:15.91,Jp,NTP,0000,0000,0000,,Иә, қазіргі соғыстар мен теңсіздіктер.
Dialogue: 0,0:17:16.11,0:17:20.16,Jp,NTP,0000,0000,0000,,Мәселелердің көпшілігі жер ресурстарының аздығынан туындайды.
Dialogue: 0,0:17:20.58,0:17:22.10,Jp,NTP,0000,0000,0000,,Егер сіз оны шеше алсаңыз
Dialogue: 0,0:17:22.49,0:17:25.84,Jp,NTP,0000,0000,0000,,Сіз мұқтаж адамға көмектесесіз бе?
Dialogue: 0,0:17:26.45,0:17:29.47,Jp,NTP,0000,0000,0000,,Бірақ қазір бұл проектор әлі де тоқтап тұр.
Dialogue: 0,0:17:30.14,0:17:33.97,Jp,NTP,0000,0000,0000,,Анасы мен әкесінің арасындағы апатқа байланысты.
Dialogue: 0,0:17:36.18,0:17:38.54,Jp,NTP,0000,0000,0000,,Мен мұны қабылдағым келеді
Dialogue: 0,0:17:39.37,0:17:41.50,Jp,NTP,0000,0000,0000,,Тез толыққанды зерттеуші болыңыз
Dialogue: 0,0:17:41.70,0:17:44.33,Jp,NTP,0000,0000,0000,,Мен тоқтаған армандарымды қайта қозғағым келеді
Dialogue: 0,0:17:45.95,0:17:47.69,Jp,NTP,0000,0000,0000,,Егер шынымен қаласаңыз
Dialogue: 0,0:17:48.26,0:17:49.14,Jp,NTP,0000,0000,0000,,Жасай бер!
Dialogue: 0,0:17:49.85,0:17:53.38,Jp,NTP,0000,0000,0000,,Жақсы, мен Рейму түсінеді деп сендім.
Dialogue: 0,0:17:54.06,0:17:55.51,Jp,NTP,0000,0000,0000,,Рейму оңай, солай емес пе?
Dialogue: 0,0:17:55.82,0:17:57.82,Jp,NTP,0000,0000,0000,,Әкем мен анам бірдей шығар.
Dialogue: 0,0:17:58.52,0:17:59.02,Jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:00.01,0:18:02.57,Jp,NTP,0000,0000,0000,,Қиындыққа тап болған адамға көмектесе білу
Dialogue: 0,0:18:03.41,0:18:05.34,Jp,NTP,0000,0000,0000,,Мен әдетте сені мазақ етемін.
Dialogue: 0,0:18:05.98,0:18:08.38,Jp,NTP,0000,0000,0000,,Мен туралы мұндай нәрсе
Dialogue: 0,0:18:16.61,0:18:18.21,Jp,NTP,0000,0000,0000,,Мен сені Шики деп ойлағым келеді.
Dialogue: 0,0:18:18.99,0:18:22.69,Jp,NTP,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:18:23.45,0:18:24.31,Jp,NTP,0000,0000,0000,,Тіпті егер
Dialogue: 0,0:18:25.00,0:18:27.56,Jp,NTP,0000,0000,0000,,Сен сияқты қиналған адамға суық болсам,
Dialogue: 0,0:18:28.45,0:18:29.85,Jp,NTP,0000,0000,0000,,Оның көңілі қалады.
Dialogue: 0,0:18:31.03,0:18:31.90,Jp,NTP,0000,0000,0000,,Кем дегенде
Dialogue: 0,0:18:32.14,0:18:34.58,Jp,NTP,0000,0000,0000,,Жадыңызды жоғалтпасаңыз да
Dialogue: 0,0:18:35.50,0:18:36.84,Jp,NTP,0000,0000,0000,,Ол менің әпкем болмаса да
Dialogue: 0,0:18:38.46,0:18:41.91,Jp,NTP,0000,0000,0000,,Сонда да суық адам болғың келмейді.
Dialogue: 0,0:18:47.59,0:18:50.03,Jp,NTP,0000,0000,0000,,Рейму-сан
Dialogue: 0,0:18:55.36,0:18:56.32,Jp,NTP,0000,0000,0000,,Енді Рюука L екенін мәлімдегеннен кейін… оны өлтіру керек.
Dialogue: 0,0:18:57.15,0:18:58.54,Jp,NTP,0000,0000,0000,,Менің айтқанымды орындай аласыз ба?
Dialogue: 0,0:19:08.80,0:19:09.81,Jp,NTP,0000,0000,0000,,Бөлшектерге тістеу
Dialogue: 0,0:19:17.44,0:19:18.14,Jp,NTP,0000,0000,0000,,Келесі шайқас!
Dialogue: 0,0:19:18.75,0:19:19.40,Jp,NTP,0000,0000,0000,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:19:21.70,0:19:22.47,Jp,NTP,0000,0000,0000,,Фалко!!
Dialogue: 0,0:19:34.88,0:19:39.69,Jp,NTP,0000,0000,0000,,Хо NLN оптикалық нервіме және «Вардогтың» оптикалық сенсорына
Dialogue: 0,0:19:39.69,0:19:41.48,Jp,NTP,0000,0000,0000,,Неліктен бір уақытта араласу керек?
Dialogue: 0,0:19:42.40,0:19:44.05,Jp,NTP,0000,0000,0000,,Былайша айтқанда, тамсана білу
Dialogue: 0,0:19:44.50,0:19:48.41,Jp,NTP,0000,0000,0000,,Бірақ инфрақызыл ақпаратқа кедергі жасай алмайтын сияқтысыз.
Dialogue: 0,0:19:49.11,0:19:51.64,Jp,NTP,0000,0000,0000,,Пайдасы жоқ. Сіз мені жеңе алмайсыз.
Dialogue: 0,0:19:51.64,0:19:52.54,Jp,NTP,0000,0000,0000,,Қозаке
Dialogue: 0,0:19:55.54,0:19:56.66,Jp,NTP,0000,0000,0000,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:20:06.25,0:20:07.74,Jp,NTP,0000,0000,0000,,Сен шынымен де тамаша ФБР агенті болдың.
Dialogue: 0,0:20:09.82,0:20:10.93,Jp,NTP,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:20:13.25,0:20:14.57,Jp,NTP,0000,0000,0000,,Сумен сулану арқылы
Dialogue: 0,0:20:14.74,0:20:16.46,Jp,NTP,0000,0000,0000,,Бұл дене температурасын сөндірді ме?
Dialogue: 0,0:20:17.07,0:20:20.18,Jp,NTP,0000,0000,0000,,Бірақ мұндай күйде ток соғуды қолдану...
Dialogue: 0,0:20:20.60,0:20:25.85,Jp,NTP,0000,0000,0000,,Иә, әрине, мен де шығын аламын.
Dialogue: 0,0:20:26.33,0:20:30.87,Jp,NTP,0000,0000,0000,,Бірақ сіз, мұны білетін адам, иллюзияны бұзасыз.
Dialogue: 0,0:20:31.61,0:20:33.85,Jp,NTP,0000,0000,0000,,Қазірдің өзінде мат...
Dialogue: 0,0:20:37.90,0:20:38.90,Jp,NTP,0000,0000,0000,,Қозғалмаңыз
Dialogue: 0,0:20:40.60,0:20:41.26,Jp,NTP,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,0:20:41.26,0:20:42.25,Jp,NTP,0000,0000,0000,,Кел, айтшы.
Dialogue: 0,0:20:42.48,0:20:45.10,Jp,NTP,0000,0000,0000,,Сондықтан жалғыз сен соқпадың.
Dialogue: 0,0:20:45.85,0:20:48.27,Jp,NTP,0000,0000,0000,,Неге бізге шабуыл жасайсың?
Dialogue: 0,0:20:48.91,0:20:52.97,Jp,NTP,0000,0000,0000,,Ал менің бұл күшім қандай?
Dialogue: 0,0:20:55.82,0:20:56.69,Jp,NTP,0000,0000,0000,,Осы уақытқа дейін?
Dialogue: 0,0:21:09.48,0:21:11.37,Jp,NTP,0000,0000,0000,,Бұл шынымен бар ма?
Dialogue: 0,0:21:12.40,0:21:16.19,Jp,NTP,0000,0000,0000,,Адамның денесіне тек сана қателесіп қалай енеді?
Dialogue: 0,0:21:16.46,0:21:17.55,Jp,NTP,0000,0000,0000,,Ақымақ нәрсе
Dialogue: 0,0:21:21.73,0:21:23.08,Jp,NTP,0000,0000,0000,,Менің ойымша, бар
Dialogue: 0,0:21:29.38,0:21:30.20,Jp,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:21:32.89,0:21:34.95,Jp,NTP,0000,0000,0000,,Мен саған көмектесемін
Dialogue: 0,0:21:35.34,0:21:38.48,Jp,NTP,0000,0000,0000,,Мен сенің шын денеңді табамын
Dialogue: 0,0:21:38.90,0:21:40.73,Jp,NTP,0000,0000,0000,,Менің шынайы денем
Dialogue: 0,0:21:41.46,0:21:43.78,Jp,NTP,0000,0000,0000,,Иә, болуы керек.
Dialogue: 0,0:21:44.40,0:21:46.92,Jp,NTP,0000,0000,0000,,Егер солай жасасаңыз, соншалықты уайымсыз көрінудің қажеті жоқ.
Dialogue: 0,0:21:47.50,0:21:49.23,Jp,NTP,0000,0000,0000,,Мен өз өмірімді мақтанышпен өткізе аламын
Dialogue: 0,0:21:49.83,0:21:51.75,Jp,NTP,0000,0000,0000,,Сен де бұл дүниеде
Dialogue: 0,0:21:53.23,0:21:54.97,Jp,NTP,0000,0000,0000,,Тірі қалады
Dialogue: 0,0:21:56.28,0:21:57.49,Jp,NTP,0000,0000,0000,,Жүрегіңізді ұстаңыз
Dialogue: 0,0:21:58.33,0:22:01.15,Jp,NTP,0000,0000,0000,,Олай болса, маған көмектесуіңізді өтінемін.
Dialogue: 0,0:22:01.80,0:22:03.82,Jp,NTP,0000,0000,0000,,Мен апамның жанын табамын деп үміттенемін.
Dialogue: 0,0:22:05.09,0:22:07.19,Jp,NTP,0000,0000,0000,,Екеуміз де қиындыққа тап болдық
Dialogue: 0,0:22:07.96,0:22:11.39,Jp,NTP,0000,0000,0000,,Қол ұстасып, бірге күресейік
Dialogue: 0,0:22:13.62,0:22:17.49,Jp,NTP,0000,0000,0000,,Иә Иә Рахмет, Рейму мырза.
Dialogue: 0,0:22:17.77,0:22:18.60,Jp,NTP,0000,0000,0000,,Әдептілік жақсы.
Dialogue: 0,0:22:19.13,0:22:20.32,Jp,NTP,0000,0000,0000,,Шики де солай болды.
Dialogue: 0,0:22:20.95,0:22:27.27,Jp,NTP,0000,0000,0000,,Иә, онда мені «Өлең» деп атауға болады.
Dialogue: 0,0:22:28.27,0:22:28.89,Jp,NTP,0000,0000,0000,,«Өлең»
Dialogue: 0,0:22:30.20,0:22:33.69,Jp,NTP,0000,0000,0000,,Иә, Шикидің атынан
Dialogue: 0,0:22:34.24,0:22:35.77,Jp,NTP,0000,0000,0000,,«Өлең»
Dialogue: 0,0:22:37.98,0:22:41.05,Jp,NTP,0000,0000,0000,,Танысқаныма қуаныштымын «Өлең»
Dialogue: 0,0:22:42.55,0:22:48.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
