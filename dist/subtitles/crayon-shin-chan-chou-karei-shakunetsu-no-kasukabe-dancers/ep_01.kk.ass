Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.46,0:00:16.47,Default,,0,0,0,,♪「Жану」
Dialogue: 0,0:00:16.55,0:00:18.72,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:00:50.96,0:00:52.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:53.72,0:00:54.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:56.84,0:00:58.09,Default,,0,0,0,,(Құбыжықтың айқайы)
Dialogue: 0,0:01:09.52,0:01:11.94,Default,,0,0,0,,Иә! Та!
Dialogue: 0,0:01:12.07,0:01:13.49,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:17.70,0:01:19.03,Default,,0,0,0,,Бо~!
Dialogue: 0,0:01:21.37,0:01:22.66,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:01:26.58,0:01:27.67,Default,,0,0,0,,Хмф!
Dialogue: 0,0:01:37.80,0:01:39.68,Default,,0,0,0,,Хмф! Ах...
Dialogue: 0,0:01:43.93,0:01:47.23,Default,,0,0,0,,(Бес қорқынышты дауыс)
Dialogue: 0,0:01:49.77,0:01:52.32,Default,,0,0,0,,Сонда да біз берілмейміз!
Dialogue: 0,0:01:59.74,0:02:03.54,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:02:27.06,0:02:28.73,Default,,0,0,0,,Кеттік! Касукабе қорғаныс күштері!
Dialogue: 0,0:02:29.81,0:02:31.06,Default,,0,0,0,,Үндістан?
Dialogue: 0,0:02:31.15,0:02:33.19,Default,,0,0,0,,Бұл карриімен әйгілі ме?
Dialogue: 0,0:02:33.27,0:02:34.69,Default,,0,0,0,,Иә
Dialogue: 0,0:02:34.77,0:02:37.11,Default,,0,0,0,,Мусибай, Хагашмир, Үндістан
Dialogue: 0,0:02:37.19,0:02:39.28,Default,,0,0,0,,Жыл сайын ән айтып, би билейді
Dialogue: 0,0:02:39.36,0:02:41.87,Default,,0,0,0,,Мюзиклден тұратын ойын-сауық фестивалі
Dialogue: 0,0:02:41.95,0:02:43.41,Default,,0,0,0,,Бұл орындалуда
Dialogue: 0,0:02:43.49,0:02:45.41,Default,,0,0,0,,Уау! Бұл керемет!
Dialogue: 0,0:02:47.25,0:02:48.66,Default,,0,0,0,,Мен бұл фестивальге былтыр барғанмын.
Dialogue: 0,0:02:48.75,0:02:49.58,Default,,0,0,0,,Ариана деген кім?
Dialogue: 0,0:02:49.66,0:02:52.38,Default,,0,0,0,,Қазір ол Үндістанда өте танымал.
Dialogue: 0,0:02:52.46,0:02:54.67,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:02:57.67,0:02:59.47,Default,,0,0,0,,Келесі жолы осы Мушибаймен
Dialogue: 0,0:02:59.55,0:03:01.84,Default,,0,0,0,,Туысқан қалаларға айналу құрметіне
Dialogue: 0,0:03:01.93,0:03:03.68,Default,,0,0,0,,Kasukabe балалар ойын-сауық фестивалі
Dialogue: 0,0:03:03.76,0:03:05.51,Default,,0,0,0,,Ол өткізіледі.
Dialogue: 0,0:03:05.60,0:03:08.27,Default,,0,0,0,,Егер сіз сонда жеңіске жетсеңіз, сізді Үндістанға шақырады.
Dialogue: 0,0:03:08.35,0:03:10.23,Default,,0,0,0,,Фестиваль сахнасында билейік
Dialogue: 0,0:03:10.31,0:03:11.14,Default,,0,0,0,,Бо!?
Dialogue: 0,0:03:11.23,0:03:12.69,Default,,0,0,0,,Бұл сіздің Үндістанға тегін бара алатыныңызды білдіре ме!?
Dialogue: 0,0:03:12.77,0:03:15.44,Default,,0,0,0,,Иә! Біз де, Касукабе қорғаныс күштері.
Dialogue: 0,0:03:15.52,0:03:17.65,Default,,0,0,0,,Футаба балабақшасын көрсетейік.
Dialogue: 0,0:03:17.73,0:03:19.11,Default,,0,0,0,,Ол мұнда бәрін талқандауға келген.
Dialogue: 0,0:03:19.19,0:03:21.61,Default,,0,0,0,,Бірақ біз мұны істей аламыз ба?
Dialogue: 0,0:03:21.70,0:03:24.12,Default,,0,0,0,,Масао-кун! Бұл бірінші кезекте жақсы емес!
Dialogue: 0,0:03:24.20,0:03:26.99,Default,,0,0,0,,Олай десеңіз, бұл жақсы емес.
Dialogue: 0,0:03:27.08,0:03:29.50,Default,,0,0,0,,Ора, Үндістанның тамаша ханымы
Dialogue: 0,0:03:29.58,0:03:31.08,Default,,0,0,0,,Мен карри жедім
Dialogue: 0,0:03:31.16,0:03:33.04,Default,,0,0,0,,Нене де Үндістанға барғысы келеді!
Dialogue: 0,0:03:33.12,0:03:34.04,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:03:34.13,0:03:35.75,Default,,0,0,0,,Иә, мен де!
Dialogue: 0,0:03:35.84,0:03:37.00,Default,,0,0,0,,Содан кейін шешілді!
Dialogue: 0,0:03:37.09,0:03:39.21,Default,,0,0,0,,үшінмыз Үндістанға барамыз ба?
Dialogue: 0,0:03:39.30,0:03:41.09,Default,,0,0,0,,Оу!
Dialogue: 0,0:03:41.76,0:03:46.76,Default,,0,0,0,,♪「Жану」
Dialogue: 0,0:04:05.57,0:04:06.95,Default,,0,0,0,,Ммм
Dialogue: 0,0:04:08.91,0:04:11.25,Default,,0,0,0,,Шин-чан, жаттығу ше?
Dialogue: 0,0:04:11.33,0:04:13.67,Default,,0,0,0,,Эй, дәл қазір пиро пиро бум бар.
Dialogue: 0,0:04:13.75,0:04:15.75,Default,,0,0,0,,Мен үнемі жаттығумен айналыстым
Dialogue: 0,0:04:15.83,0:04:18.38,Default,,0,0,0,,Мен анда-санда нағыз үйді ойнағым келеді.
Dialogue: 0,0:04:18.46,0:04:22.84,Default,,0,0,0,,Бүгін менде ағылшын тілінен тест бар, сондықтан оқуым керек.
Dialogue: 0,0:04:23.88,0:04:25.18,Default,,0,0,0,,Бо…
Dialogue: 0,0:04:25.26,0:04:26.80,Default,,0,0,0,,үшін қарайды
Dialogue: 0,0:04:26.89,0:04:28.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:29.43,0:04:31.06,Default,,0,0,0,,Бо…
Dialogue: 0,0:04:31.14,0:04:31.98,Default,,0,0,0,,Наан
Dialogue: 0,0:04:32.77,0:04:34.35,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:34.44,0:04:36.02,Default,,0,0,0,,Бұл наан. Наан ба?
Dialogue: 0,0:04:36.10,0:04:38.06,Default,,0,0,0,,Бұл наан
Dialogue: 0,0:04:38.77,0:04:40.90,Default,,0,0,0,,Үндістандағы барлық адамдармен билеу
Dialogue: 0,0:04:40.98,0:04:45.49,Default,,0,0,0,,Бұл өте, өте, өте, өте қызықты болатыны сөзсіз!
Dialogue: 0,0:04:45.57,0:04:46.78,Default,,0,0,0,,Ха! Ха!
Dialogue: 0,0:04:48.62,0:04:52.50,Default,,0,0,0,,Біздің қымбат уақытымыз тек бір рет болады
Dialogue: 0,0:04:53.41,0:04:54.41,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:54.50,0:04:57.04,Default,,0,0,0,,Жеңіске жетпесем, Үндістанға бара алмаймын.
Dialogue: 0,0:04:57.13,0:04:59.17,Default,,0,0,0,,Иә, көп жаттығу жасайық!
Dialogue: 0,0:04:59.25,0:05:01.59,Default,,0,0,0,,Ммм, Казама-кун, сен жақында әлсірейсің.
Dialogue: 0,0:05:01.67,0:05:03.51,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:05:08.64,0:05:10.51,Default,,0,0,0,,Хой Хой
Dialogue: 0,0:05:10.60,0:05:15.02,Default,,0,0,0,,♪「Жану」
Dialogue: 0,0:05:44.96,0:05:46.72,Default,,0,0,0,,Хой тоттотто...
Dialogue: 0,0:05:46.80,0:05:48.72,Default,,0,0,0,,Тотто Тотто…
Dialogue: 0,0:05:48.80,0:05:51.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:51.80,0:05:53.93,Default,,0,0,0,,Кітап…
Dialogue: 0,0:05:54.02,0:05:54.85,Default,,0,0,0,,Ах
Dialogue: 0,0:05:55.81,0:05:56.93,Default,,0,0,0,,Фу~
Dialogue: 0,0:05:57.02,0:05:58.19,Default,,0,0,0,,Ой... батпақ...
Dialogue: 0,0:05:58.27,0:05:59.90,Default,,0,0,0,,О~ Уау~
Dialogue: 0,0:05:59.98,0:06:01.73,Default,,0,0,0,,-Сәлем! - (Казама-кун және т.б.) Ах!
Dialogue: 0,0:06:06.03,0:06:09.66,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:06:21.04,0:06:23.00,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:06:23.09,0:06:26.26,Default,,0,0,0,,Namaste!
Dialogue: 0,0:06:26.34,0:06:30.51,Default,,0,0,0,,♪～
Dialogue: 0,0:07:21.44,0:07:26.44,Default,,0,0,0,,～♪
Dialogue: 0,0:07:27.53,0:07:28.82,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:07:28.90,0:07:31.36,Default,,0,0,0,,Бұл Үндістан
Dialogue: 0,0:07:40.37,0:07:42.04,Default,,0,0,0,,Жоғалмаңыз
Dialogue: 0,0:07:42.12,0:07:43.79,Default,,0,0,0,,үшін қол ұстасып тұрады
Dialogue: 0,0:07:53.01,0:07:55.05,Default,,0,0,0,,-(Бо-чан) Бо Бо... -Ох~
Dialogue: 0,0:07:55.14,0:07:57.10,Default,,0,0,0,,Бо-чан Синносуке
Dialogue: 0,0:07:57.18,0:07:59.43,Default,,0,0,0,,Мен жүгірмеймін, себебі бұл қауіпті.
Dialogue: 0,0:07:59.52,0:08:01.60,Default,,0,0,0,,Сәлем, Шинносуке!
Dialogue: 0,0:08:01.68,0:08:03.19,Default,,0,0,0,,Бо… ah
Dialogue: 0,0:08:08.44,0:08:10.86,Default,,0,0,0,,Бо~! жақсы! тас!
Dialogue: 0,0:08:11.57,0:08:13.15,Default,,0,0,0,,Хаха
Dialogue: 0,0:08:17.28,0:08:20.12,Default,,0,0,0,,Ұзақ жолдағы қажырлы еңбегіңіз үшін рахмет, Химавари-чан.
Dialogue: 0,0:08:20.20,0:08:21.08,Default,,0,0,0,,Поо!
Dialogue: 0,0:08:21.16,0:08:23.41,Default,,0,0,0,,Міне! Бұл жақсы емес, Хима Чан.
Dialogue: 0,0:08:23.50,0:08:26.42,Default,,0,0,0,,Менің бүкіл отбасым осында келгеніне өкінемін.
Dialogue: 0,0:08:26.50,0:08:29.13,Default,,0,0,0,,Кешіріңіз, хехе...
Dialogue: 0,0:08:29.21,0:08:32.72,Default,,0,0,0,,Жоқ, менің жалғыз жүруім мүмкін емес.
Dialogue: 0,0:08:32.80,0:08:34.59,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:34.68,0:08:36.30,Default,,0,0,0,,Менің әкем мен анам да
Dialogue: 0,0:08:36.39,0:08:38.55,Default,,0,0,0,,Келсеңіз ғой.
Dialogue: 0,0:08:38.64,0:08:42.27,Default,,0,0,0,,Мен де жұмыстан демалыс алуда қиналамын.
Dialogue: 0,0:08:42.35,0:08:43.52,Default,,0,0,0,,Учимо
Dialogue: 0,0:08:43.60,0:08:46.06,Default,,0,0,0,,Ересектер кенеттен демалуға болмайды.
Dialogue: 0,0:08:46.15,0:08:49.32,Default,,0,0,0,,Керемет~ Шин Чанның әкесінің жұмысы жоқ.
Dialogue: 0,0:08:49.40,0:08:51.69,Default,,0,0,0,,Менің жұмысым жоқ сияқты емес.
Dialogue: 0,0:08:51.78,0:08:55.28,Default,,0,0,0,,То-чансыз компанияда проблема болмайды.
Dialogue: 0,0:08:55.36,0:08:56.49,Default,,0,0,0,,Шинносуке
Dialogue: 0,0:08:56.57,0:08:59.99,Default,,0,0,0,,Шындық кейде адамдарға зиян тигізуі мүмкін.
Dialogue: 0,0:09:00.08,0:09:02.08,Default,,0,0,0,,Тіпті Широ да
Dialogue: 0,0:09:02.16,0:09:03.96,Default,,0,0,0,,Широ да отбасы.
Dialogue: 0,0:09:04.04,0:09:05.08,Default,,0,0,0,,(Туған туыс) Олай деуге болады, бірақ (Туған туыс) бұл маңызды мәселе.
Dialogue: 0,0:09:05.16,0:09:06.79,Default,,0,0,0,,Сонымен қайсысы?
Dialogue: 0,0:09:06.87,0:09:09.88,Default,,0,0,0,,Ол бізді Мушибайға апарады.
Dialogue: 0,0:09:09.96,0:09:12.63,Default,,0,0,0,,Бұл біздің жетекшіміз Ухун Ахерн.
Dialogue: 0,0:09:12.71,0:09:14.34,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:09:14.42,0:09:15.42,Default,,0,0,0,,Ухун
Dialogue: 0,0:09:15.51,0:09:17.39,Default,,0,0,0,,Ахан~н
Dialogue: 0,0:09:19.39,0:09:21.35,Default,,0,0,0,,Уау! Бұл не!
Dialogue: 0,0:09:21.43,0:09:23.27,Default,,0,0,0,,Чай, солай ма?
Dialogue: 0,0:09:23.35,0:09:24.35,Default,,0,0,0,,Ахан
Dialogue: 0,0:09:24.43,0:09:26.56,Default,,0,0,0,,Шай жапырағын қайнатып пісірілген сүтті шай
Dialogue: 0,0:09:26.64,0:09:28.81,Default,,0,0,0,,Дәмдеуіштер қосылды
Dialogue: 0,0:09:28.90,0:09:31.11,Default,,0,0,0,,Бастық, мәліметтер.
Dialogue: 0,0:09:31.19,0:09:33.03,Default,,0,0,0,,Мен оқыдым.
Dialogue: 0,0:09:35.11,0:09:36.49,Default,,0,0,0,,Намасте
Dialogue: 0,0:09:36.57,0:09:39.20,Default,,0,0,0,,Намасте үнділік сәлемдесу, солай ма?
Dialogue: 0,0:09:39.28,0:09:43.45,Default,,0,0,0,,Иә, ол «сәлем» немесе «қош бол» дегенді де білдіруі мүмкін.
Dialogue: 0,0:09:43.54,0:09:44.58,Default,,0,0,0,,Казама-кун
Dialogue: 0,0:09:44.66,0:09:47.00,Default,,0,0,0,,Оланың ерекше намастасын көресіз бе?
Dialogue: 0,0:09:47.08,0:09:49.17,Default,,0,0,0,,Арнайы Намаста?
Dialogue: 0,0:09:49.25,0:09:50.38,Default,,0,0,0,,Үндістан туралы айту
Dialogue: 0,0:09:50.46,0:09:53.92,Default,,0,0,0,,Индозо мырза Зо мырза
Dialogue: 0,0:09:54.01,0:09:55.84,Default,,0,0,0,,Намасте~
Dialogue: 0,0:09:55.92,0:09:57.68,Default,,0,0,0,,Піл қайда!
Dialogue: 0,0:09:57.76,0:09:59.80,Default,,0,0,0,,- Идиот - (Бо-чан) Хэхе...
Dialogue: 0,0:10:00.47,0:10:02.60,Default,,0,0,0,,Бохахаха!
Dialogue: 0,0:10:02.68,0:10:06.39,Default,,0,0,0,,Күлгенім сонша, мұрным әдеттегіден де аққан.
Dialogue: 0,0:10:07.60,0:10:11.23,Default,,0,0,0,,Ола Маңыздысы «Зо-сан» деп айту
Dialogue: 0,0:10:11.31,0:10:12.27,Default,,0,0,0,,Казама-кун
Dialogue: 0,0:10:12.36,0:10:14.61,Default,,0,0,0,,Сиыр тезегі Фундерузо~сан
Dialogue: 0,0:10:14.69,0:10:16.86,Default,,0,0,0,,Уау! Мен өзімді толық рахаттанып жатырмын
Dialogue: 0,0:10:16.94,0:10:18.49,Default,,0,0,0,,Раббым!
Dialogue: 0,0:10:18.57,0:10:19.86,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:10:19.95,0:10:21.99,Default,,0,0,0,,Менде су бар, мен саған су алып келейін.
Dialogue: 0,0:10:22.07,0:10:24.74,Default,,0,0,0,,Бұл Үндістанда жиі кездеседі, солай емес пе?
Dialogue: 0,0:10:24.83,0:10:26.58,Default,,0,0,0,,Ахерн
Dialogue: 0,0:10:30.21,0:10:31.92,Default,,0,0,0,,Boh!
Dialogue: 0,0:10:33.13,0:10:34.17,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:34.96,0:10:35.80,Default,,0,0,0,,Бо!
Dialogue: 0,0:10:44.06,0:10:45.22,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:45.31,0:10:46.81,Default,,0,0,0,,Бо-чан, қара, қара!
Dialogue: 0,0:10:46.89,0:10:47.98,Default,,0,0,0,,Бурибури~ Бури Бури~
Dialogue: 0,0:10:48.06,0:10:49.94,Default,,0,0,0,,Брамбл~
Dialogue: 0,0:10:50.02,0:10:52.81,Default,,0,0,0,,Мен қазір ойын-сауық фестиваліне барамын деп ойлаймын.
Dialogue: 0,0:10:52.90,0:10:55.32,Default,,0,0,0,,- Бурибури~ - (Бо-чан) Бурабура~
Dialogue: 0,0:10:55.94,0:10:57.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:59.74,0:11:01.61,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:11:03.57,0:11:05.20,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:11:05.28,0:11:06.79,Default,,0,0,0,,Бо…
Dialogue: 0,0:11:08.83,0:11:09.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:09.87,0:11:11.96,Default,,0,0,0,,Хо хо хо...
Dialogue: 0,0:11:13.96,0:11:16.30,Default,,0,0,0,,Бо…
Dialogue: 0,0:11:18.84,0:11:19.92,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:20.67,0:11:21.97,Default,,0,0,0,,О~
Dialogue: 0,0:11:29.02,0:11:29.98,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:34.90,0:11:35.77,Default,,0,0,0,,О
Dialogue: 0,0:11:51.58,0:11:53.92,Default,,0,0,0,,(тышқан жылайды)
Dialogue: 0,0:11:54.00,0:11:55.71,Default,,0,0,0,,- (Бо-чан) Бо... -Ой?
Dialogue: 0,0:11:58.92,0:12:00.76,Default,,0,0,0,,Кілт?
Dialogue: 0,0:12:00.84,0:12:02.26,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:02.34,0:12:04.22,Default,,0,0,0,,(Шинносукенің дауысы)
Dialogue: 0,0:12:06.18,0:12:08.31,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:12:11.93,0:12:13.35,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:13.44,0:12:14.69,Default,,0,0,0,,Мұрын
Dialogue: 0,0:12:15.31,0:12:17.73,Default,,0,0,0,,... рюкзактары!?
Dialogue: 0,0:12:18.27,0:12:19.15,Default,,0,0,0,,Бо…
Dialogue: 0,0:12:20.94,0:12:21.82,Default,,0,0,0,,Оу!
Dialogue: 0,0:12:21.90,0:12:24.03,Default,,0,0,0,,Шин Чанмен кездесу
Dialogue: 0,0:12:24.11,0:12:26.12,Default,,0,0,0,,О! Ахахха
Dialogue: 0,0:12:26.20,0:12:27.58,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:12:28.70,0:12:31.20,Default,,0,0,0,,Коре Кудаса-и Суну-зу
Dialogue: 0,0:12:31.29,0:12:32.29,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:32.37,0:12:33.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:33.87,0:12:36.25,Default,,0,0,0,,Аттини Аримашита~Дазо
Dialogue: 0,0:12:38.38,0:12:40.05,Default,,0,0,0,,Мен Мане~
Dialogue: 0,0:12:40.13,0:12:42.84,Default,,0,0,0,,100 миллион иен Алимас
Dialogue: 0,0:12:46.22,0:12:47.47,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:47.55,0:12:49.76,Default,,0,0,0,,Алға, алға, уайымдама.
Dialogue: 0,0:12:49.85,0:12:51.43,Default,,0,0,0,,жеткіліксіз шығар
Dialogue: 0,0:12:51.52,0:12:53.68,Default,,0,0,0,,-Ой? -(Бо-чан) Бо
Dialogue: 0,0:12:55.77,0:12:56.60,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:57.90,0:13:00.07,Default,,0,0,0,,Хохо хохо~
Dialogue: 0,0:13:00.15,0:13:02.03,Default,,0,0,0,,(Синносукенің гуілдеуі)
Dialogue: 0,0:13:02.82,0:13:05.99,Default,,0,0,0,,Ханагелина Джоли ~ Жақсы сезім ~
Dialogue: 0,0:13:06.07,0:13:08.20,Default,,0,0,0,,Ханагерина?
Dialogue: 0,0:13:08.28,0:13:09.74,Default,,0,0,0,,Бұл мұрынның аты
Dialogue: 0,0:13:09.83,0:13:12.16,Default,,0,0,0,,Оны қалаған кезде пайдаланыңыз.
Dialogue: 0,0:13:12.24,0:13:15.37,Default,,0,0,0,,Ханагеринаның мұрны Бо-чанның жартысы.
Dialogue: 0,0:13:15.46,0:13:17.63,Default,,0,0,0,,Бо! рахмет
Dialogue: 0,0:13:17.71,0:13:18.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:21.46,0:13:23.67,Default,,0,0,0,,Бұл біріктірілгенде жүректі жасайды
Dialogue: 0,0:13:23.76,0:13:25.63,Default,,0,0,0,,Бөксеге ұқсайтын тас екен!
Dialogue: 0,0:13:25.72,0:13:27.72,Default,,0,0,0,,Иә
Dialogue: 0,0:13:27.80,0:13:29.55,Default,,0,0,0,,Жартысы
Dialogue: 0,0:13:29.64,0:13:31.01,Default,,0,0,0,,-Жарайды ма? -(Бо-чан) Бо
Dialogue: 0,0:13:31.10,0:13:32.64,Default,,0,0,0,,Үнді жақтары
Dialogue: 0,0:13:32.72,0:13:34.85,Default,,0,0,0,,Кәдесый, қаласаңыз.
Dialogue: 0,0:13:34.93,0:13:36.35,Default,,0,0,0,,Со~Томою~
Dialogue: 0,0:13:36.44,0:13:37.98,Default,,0,0,0,,Ю~Томосо~
Dialogue: 0,0:13:38.06,0:13:39.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:40.73,0:13:44.86,Default,,0,0,0,,(Ән айтатын екі дауыс)
Dialogue: 0,0:13:52.45,0:13:54.45,Default,,0,0,0,,Нақты спектакль ертең болады.
Dialogue: 0,0:13:54.54,0:13:56.62,Default,,0,0,0,,Иә, мен оны асыға күтемін!
Dialogue: 0,0:13:56.71,0:13:59.38,Default,,0,0,0,,Ха~ Соңында Нененің сүйкімділігі
Dialogue: 0,0:13:59.46,0:14:01.54,Default,,0,0,0,,Бүкіл әлемге белгілі болады.
Dialogue: 0,0:14:01.63,0:14:03.50,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:03.59,0:14:05.63,Default,,0,0,0,,Мен қобалжыдым.
Dialogue: 0,0:14:05.71,0:14:06.88,Default,,0,0,0,,Әлі ерте
Dialogue: 0,0:14:06.97,0:14:08.05,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:14:08.13,0:14:10.80,Default,,0,0,0,,Үнді халқы Касукабеге қарағанда әлдеқайда көп
Dialogue: 0,0:14:10.89,0:14:12.72,Default,,0,0,0,,Мен жай ғана Масао-кунға қарап тұрмын.
Dialogue: 0,0:14:12.81,0:14:14.01,Default,,0,0,0,,Айтпа~
Dialogue: 0,0:14:14.10,0:14:15.27,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:14:15.35,0:14:18.85,Default,,0,0,0,,Бірге билеуді асыға күтеміз!
Dialogue: 0,0:14:25.90,0:14:27.44,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:14:28.74,0:14:31.66,Default,,0,0,0,,Сіз бірдеңе саттыңыз ба?
Dialogue: 0,0:14:31.74,0:14:33.49,Default,,0,0,0,,Тек сатылатын заттар
Dialogue: 0,0:14:36.83,0:14:38.50,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:14:38.58,0:14:39.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:47.97,0:14:49.38,Default,,0,0,0,,«Қағазды» іздеу
Dialogue: 0,0:14:49.47,0:14:50.63,Default,,0,0,0,,Қағаз?
Dialogue: 0,0:14:50.72,0:14:53.47,Default,,0,0,0,,Жай қағаз майлық сияқты көрінеді
Dialogue: 0,0:14:53.55,0:14:55.64,Default,,0,0,0,,Бірақ сол «қағаз»...
Dialogue: 0,0:14:55.72,0:14:57.31,Default,,0,0,0,,Менің теориям қазіргі уақытта
Dialogue: 0,0:14:57.39,0:14:59.35,Default,,0,0,0,,Мұндай жағдай әсер еткен болуы керек.
Dialogue: 0,0:14:59.44,0:15:01.35,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:15:02.23,0:15:03.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:03.86,0:15:06.65,Default,,0,0,0,,Мен... Мен оны ешқашан көрген емеспін. Бұл дүкенде жоқ!
Dialogue: 0,0:15:06.73,0:15:09.99,Default,,0,0,0,,Осы жерде сияқты. Аники күткендей.
Dialogue: 0,0:15:10.07,0:15:11.82,Default,,0,0,0,,Аа, жоқ деп айтпа!
Dialogue: 0,0:15:11.91,0:15:13.53,Default,,0,0,0,,Әй, бос емес, бос емес
Dialogue: 0,0:15:13.62,0:15:14.95,Default,,0,0,0,,Үйге тез қайтыңыз.
Dialogue: 0,0:15:15.03,0:15:16.83,Default,,0,0,0,,Сіз Титантардың бір-бірімен шайқасып жатқанын айтасыз ба?
Dialogue: 0,0:15:16.91,0:15:19.66,Default,,0,0,0,,Бізден ештеңе жасыра алмайсың.
Dialogue: 0,0:15:19.75,0:15:22.00,Default,,0,0,0,,Дұрыс па? Аники
Dialogue: 0,0:15:23.25,0:15:27.13,Default,,0,0,0,,Ааа... аа...
Dialogue: 0,0:15:27.21,0:15:30.05,Default,,0,0,0,,♪ «Маған шындықты айтпа».
Dialogue: 0,0:15:30.05,0:15:31.18,Default,,0,0,0,,♪ «Маған шындықты айтпа».
Dialogue: 0,0:15:30.05,0:15:31.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.18,0:15:32.09,Default,,0,0,0,,♪ «Маған шындықты айтпа».
Dialogue: 0,0:15:32.18,0:15:33.18,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:37.56,0:15:38.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:40.94,0:15:41.94,Default,,0,0,0,,Хмф!
Dialogue: 0,0:15:46.15,0:15:47.36,Default,,0,0,0,,Хмм?
Dialogue: 0,0:15:53.74,0:15:55.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:42.75,0:16:44.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:45.00,0:16:46.42,Default,,0,0,0,,Хех хех хех
Dialogue: 0,0:16:46.50,0:16:48.88,Default,,0,0,0,,Бұл қазір ғана сатылды.
Dialogue: 0,0:16:48.96,0:16:50.46,Default,,0,0,0,,Оны кімге саттың?
Dialogue: 0,0:16:50.55,0:16:53.34,Default,,0,0,0,,Бөксесі томпайып бөгде елдің баласымен
Dialogue: 0,0:16:53.42,0:16:55.51,Default,,0,0,0,,Мұрыннан су ағып жатқан бала
Dialogue: 0,0:16:55.59,0:16:57.09,Default,,0,0,0,,Бөкселердегі бақыт?
Dialogue: 0,0:16:57.18,0:16:58.76,Default,,0,0,0,,Мұрыннан су ағу?
Dialogue: 0,0:16:58.85,0:17:01.31,Default,,0,0,0,,Осындай бала
Dialogue: 0,0:17:02.77,0:17:06.44,Default,,0,0,0,,Әлгі «қағаз» біреудің мұрнына тығылып қалса ше...
Dialogue: 0,0:17:07.60,0:17:10.90,Default,,0,0,0,,Бұл жігіт үлкен қиындыққа тап болады.
Dialogue: 0,0:17:10.98,0:17:13.36,Default,,0,0,0,,Уншо Уншо...
Dialogue: 0,0:17:13.44,0:17:15.11,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:17:15.20,0:17:16.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:16.41,0:17:19.28,Default,,0,0,0,,Мушибайға дейін пойызбен 15 сағат
Dialogue: 0,0:17:19.37,0:17:20.37,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:17:20.45,0:17:21.74,Default,,0,0,0,,Бұл өте тез өтеді.
Dialogue: 0,0:17:21.83,0:17:24.66,Default,,0,0,0,,Ах! Бұл пойызда бақылау палубасы бар.
Dialogue: 0,0:17:24.75,0:17:26.29,Default,,0,0,0,,үшінмыз зерттеуге барайық!
Dialogue: 0,0:17:26.37,0:17:27.21,Default,,0,0,0,,...
Dialogue: 0,0:17:27.29,0:17:30.84,Default,,0,0,0,,Шин Чанның анасы: Әдемі көріністі жерде суретке түс
Dialogue: 0,0:17:30.92,0:17:32.76,Default,,0,0,0,,Мен анамның жібергенін қалаймын!
Dialogue: 0,0:17:32.84,0:17:33.67,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:17:33.76,0:17:36.38,Default,,0,0,0,,Мен де сұлу келіншекпен суретке түстім.
Dialogue: 0,0:17:36.47,0:17:38.09,Default,,0,0,0,,Мен оны Ка-чанға жібере аламын ба?
Dialogue: 0,0:17:38.18,0:17:39.68,Default,,0,0,0,,Сіз оны жібере аласыз.
Dialogue: 0,0:17:49.65,0:17:51.11,Default,,0,0,0,,Иә, ірімшік!
Dialogue: 0,0:17:51.19,0:17:52.02,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:17:52.11,0:17:54.23,Default,,0,0,0,,үшінның анасына жіберемін.
Dialogue: 0,0:17:54.32,0:17:57.36,Default,,0,0,0,,Ал, қазір Жапонияда сағат қанша?
Dialogue: 0,0:17:57.45,0:17:59.07,Default,,0,0,0,,Ма Икка (беру дыбысы)
Dialogue: 0,0:18:00.66,0:18:02.83,Default,,0,0,0,,Не? Алақай!
Dialogue: 0,0:18:02.91,0:18:05.66,Default,,0,0,0,,Бұл алаңдатады, солай емес пе?
Dialogue: 0,0:18:05.75,0:18:06.79,Default,,0,0,0,,CERN-ге қарсы шыққан террорист.
Dialogue: 0,0:18:06.87,0:18:08.08,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:18:08.17,0:18:10.58,Default,,0,0,0,,Өйткені, бұл Касукабеден бөлек.
Dialogue: 0,0:18:10.67,0:18:12.34,Default,,0,0,0,,Үндістан динамикалық!
Dialogue: 0,0:18:12.42,0:18:13.25,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:18:13.34,0:18:15.26,Default,,0,0,0,,Аа, мен де оны көргім келеді!
Dialogue: 0,0:18:15.34,0:18:16.59,Default,,0,0,0,,Ita…
Dialogue: 0,0:18:16.67,0:18:19.05,Default,,0,0,0,,Иә? а?
Dialogue: 0,0:18:19.13,0:18:23.01,Default,,0,0,0,,Шу~
Dialogue: 0,0:18:23.10,0:18:26.48,Default,,0,0,0,,Шу Шу Шу…
Dialogue: 0,0:18:27.39,0:18:28.85,Default,,0,0,0,,Хмф!
Dialogue: 0,0:18:29.52,0:18:31.73,Default,,0,0,0,,Ммм
Dialogue: 0,0:18:31.81,0:18:32.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:32.98,0:18:34.86,Default,,0,0,0,,Фухохахаха
Dialogue: 0,0:18:34.94,0:18:37.07,Default,,0,0,0,,Брандо мырза
Dialogue: 0,0:18:37.15,0:18:38.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:38.40,0:18:39.36,Default,,0,0,0,,О? Апыр-ай!
Dialogue: 0,0:18:39.45,0:18:40.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:40.36,0:18:44.03,Default,,0,0,0,,Үлкен апалар ~ Ола Шинносуке Нохара
Dialogue: 0,0:18:44.12,0:18:46.66,Default,,0,0,0,,"Хе ха!" менімен ащы карриді ішу керек пе?
Dialogue: 0,0:18:46.75,0:18:48.08,Default,,0,0,0,,Бұл Шинносуке!
Dialogue: 0,0:18:48.16,0:18:50.96,Default,,0,0,0,,Кешіріңіз, кешіріңіз!
Dialogue: 0,0:18:51.04,0:18:54.00,Default,,0,0,0,,Иә? Енді ше...
Dialogue: 0,0:18:54.09,0:18:56.13,Default,,0,0,0,,Ммм~ ақымақ
Dialogue: 0,0:18:56.21,0:18:58.30,Default,,0,0,0,,Сіз Үндістанда не істеп жүрсіз?
Dialogue: 0,0:18:58.38,0:18:59.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:59.30,0:19:01.47,Default,,0,0,0,,Шу~
Dialogue: 0,0:19:01.55,0:19:02.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:02.51,0:19:05.68,Default,,0,0,0,,Ш…
Dialogue: 0,0:19:07.02,0:19:08.77,Default,,0,0,0,,Ш…
Dialogue: 0,0:19:11.85,0:19:13.23,Default,,0,0,0,,Фу~!
Dialogue: 0,0:19:13.31,0:19:17.15,Default,,0,0,0,,Ахаха! Ахахха! Хахаха…
Dialogue: 0,0:19:17.23,0:19:19.03,Default,,0,0,0,,Хмм…
Dialogue: 0,0:19:20.70,0:19:22.16,Default,,0,0,0,,Ола дәретхана~!
Dialogue: 0,0:19:22.24,0:19:24.78,Default,,0,0,0,,А... иә!?
Dialogue: 0,0:19:25.74,0:19:28.12,Default,,0,0,0,,Иә? Мен, неге...
Dialogue: 0,0:19:28.20,0:19:30.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:30.66,0:19:33.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:33.13,0:19:35.50,Default,,0,0,0,,Кун
Dialogue: 0,0:19:38.92,0:19:40.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:40.47,0:19:41.80,Default,,0,0,0,,Әй, Баба!
Dialogue: 0,0:19:41.88,0:19:43.09,Default,,0,0,0,,-Ахахаха! - Энн Энн!
Dialogue: 0,0:19:43.18,0:19:45.43,Default,,0,0,0,,Кемпірлер мен кемпірлер болғаны жақсы!
Dialogue: 0,0:19:45.51,0:19:48.56,Default,,0,0,0,,Иә, Ахан мырза, сіз қалай ойлайсыз?
Dialogue: 0,0:19:48.64,0:19:49.68,Default,,0,0,0,,Ахерн
Dialogue: 0,0:19:49.77,0:19:51.39,Default,,0,0,0,,Леман Шокқа қош келдіңіз!
Dialogue: 0,0:19:51.48,0:19:54.86,Default,,0,0,0,,Қорқынышты ештеңе айтпа ~ «Мен үйдемін, солай ма?
Dialogue: 0,0:19:54.94,0:19:56.98,Default,,0,0,0,,Бақылау машинасы қалай болды?
Dialogue: 0,0:19:57.07,0:19:58.07,Default,,0,0,0,,Физика шекараларын да бағындыратын күш—
Dialogue: 0,0:19:58.15,0:20:00.61,Default,,0,0,0,,Мектеп директоры кейінірек бізбен бірге келеді!
Dialogue: 0,0:20:00.69,0:20:01.99,Default,,0,0,0,,- (Директор) Дұрыс - Уа!
Dialogue: 0,0:20:02.07,0:20:04.62,Default,,0,0,0,,Табылды! Шокоби карри дәмі
Dialogue: 0,0:20:05.91,0:20:08.58,Default,,0,0,0,,Бо-чан, өтінемін, өтінемін, көп.
Dialogue: 0,0:20:08.66,0:20:09.49,Default,,0,0,0,,Бо…
Dialogue: 0,0:20:09.58,0:20:11.54,Default,,0,0,0,,Мен күдіктенемін... А...
Dialogue: 0,0:20:11.62,0:20:12.58,Default,,0,0,0,,Тоқта
Dialogue: 0,0:20:12.66,0:20:15.17,Default,,0,0,0,,Тамақтану алдында жеңіл тағамдарға рұқсат етілмейді.
Dialogue: 0,0:20:15.25,0:20:17.59,Default,,0,0,0,,Е! Качан сараң~
Dialogue: 0,0:20:17.67,0:20:19.05,Default,,0,0,0,,Сараң болғаны дұрыс
Dialogue: 0,0:20:19.13,0:20:22.01,Default,,0,0,0,,Мен оны жегім келеді! Мен жегім келеді, жегім келеді, жегім келеді
Dialogue: 0,0:20:22.09,0:20:24.30,Default,,0,0,0,,Жегім келеді Жегім келеді Жегім келеді Жегім келеді...
Dialogue: 0,0:20:24.38,0:20:25.97,Default,,0,0,0,,Бо Чан жақсы қыз.
Dialogue: 0,0:20:26.05,0:20:29.77,Default,,0,0,0,,Ал, біз келесі станцияда 30 минутқа тоқтаймыз.
Dialogue: 0,0:20:29.85,0:20:32.43,Default,,0,0,0,,Ендеше бәріміз бірге түскі ас сатып алайық.
Dialogue: 0,0:20:32.52,0:20:33.89,Default,,0,0,0,,Боу
Dialogue: 0,0:20:36.23,0:20:39.86,Default,,0,0,0,,Nigaoe From жақын маңдағы қауіпсіздік камерасының бейнелеріне негізделген
Dialogue: 0,0:20:39.94,0:20:42.32,Default,,0,0,0,,«Қағазды» алған балаларды анықтаңыз
Dialogue: 0,0:20:42.40,0:20:44.11,Default,,0,0,0,,Бет-әлпетті тану арқылы бақылау
Dialogue: 0,0:20:44.20,0:20:47.45,Default,,0,0,0,,Ол қазір пойызбен Мушибайға бара жатыр екен.
Dialogue: 0,0:20:47.53,0:20:48.78,Default,,0,0,0,,Бұл пойыз!
Dialogue: 0,0:20:49.49,0:20:51.91,Default,,0,0,0,,Бөксесі томпайып, мұрнынан аққан бала
Dialogue: 0,0:20:52.00,0:20:53.25,Default,,0,0,0,,Оған міну.
Dialogue: 0,0:20:53.33,0:20:56.00,Default,,0,0,0,,Жылдам жұмыс жасаңыз! Аники күткендей
Dialogue: 0,0:20:56.08,0:20:59.54,Default,,0,0,0,,Мен біреудің мұрнына бір жапырақ қағаз қоюын тоқтату үшін бәрін жасаймын!
Dialogue: 0,0:20:59.63,0:21:00.46,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:21:18.81,0:21:20.23,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:21:22.69,0:21:25.53,Default,,0,0,0,,Бо…кітап…
Dialogue: 0,0:21:31.33,0:21:32.20,Default,,0,0,0,,Иә
Dialogue: 0,0:21:32.29,0:21:35.71,Default,,0,0,0,,(жануарлардың ырылдауы)
Dialogue: 0,0:21:35.79,0:21:37.54,Default,,0,0,0,,Қасқыр мырза, бұл қауіпті.
Dialogue: 0,0:21:37.62,0:21:39.46,Default,,0,0,0,,Екі күн бұрын орманда болған жабайы жануар...
Dialogue: 0,0:21:39.54,0:21:41.17,Default,,0,0,0,,Жай ғана сәлем айтыңыз
Dialogue: 0,0:21:41.25,0:21:44.38,Default,,0,0,0,,Were серіктестігіне үміткер
Dialogue: 0,0:21:44.46,0:21:47.88,Default,,0,0,0,,Мықты адам сенің серігің болуға жарайды.
Dialogue: 0,0:21:48.93,0:21:52.85,Default,,0,0,0,,Сіз менің серіктесім бола аласыз ба?
Dialogue: 0,0:21:54.02,0:21:55.81,Default,,0,0,0,,Ола Маған карри ұнайды.
Dialogue: 0,0:21:56.44,0:22:00.52,Default,,0,0,0,,Карридің көптеген түрлері бар.
Dialogue: 0,0:22:00.61,0:22:02.15,Default,,0,0,0,,Ахерн мырза
Dialogue: 0,0:22:02.23,0:22:05.74,Default,,0,0,0,,Мен бұл балаларға азырақ түсті нәрсе болғанын қалаймын.
Dialogue: 0,0:22:05.82,0:22:07.36,Default,,0,0,0,,Ахерн
Dialogue: 0,0:22:08.41,0:22:09.99,Default,,0,0,0,,Ухун Ухун
Dialogue: 0,0:22:10.07,0:22:13.45,Default,,0,0,0,,Күріш? Наан? Чапати?
Dialogue: 0,0:22:13.54,0:22:14.83,Default,,0,0,0,,Чапати?
Dialogue: 0,0:22:14.91,0:22:17.04,Default,,0,0,0,,Чапати Чапати Чапати Чапати…
Dialogue: 0,0:22:17.12,0:22:18.50,Default,,0,0,0,,Бұл кабадди.
Dialogue: 0,0:22:18.58,0:22:19.42,Default,,0,0,0,,Әй?
Dialogue: 0,0:22:20.04,0:22:22.75,Default,,0,0,0,,Олар қазір чапати жасап жатқан сияқты.
Dialogue: 0,0:22:22.84,0:22:26.72,Default,,0,0,0,,Чапати бидай ұнын сумен илеу арқылы дайындалады.
Dialogue: 0,0:22:26.80,0:22:28.22,Default,,0,0,0,,Оны пісірді
Dialogue: 0,0:22:28.30,0:22:31.34,Default,,0,0,0,,Оны үнділік үй шаруашылығында жиі жейді.
Dialogue: 0,0:22:31.43,0:22:32.89,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:22:32.97,0:22:34.14,Default,,0,0,0,,Ахерн
Dialogue: 0,0:22:36.98,0:22:38.60,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:22:38.69,0:22:40.52,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:22:40.60,0:22:43.23,Default,,0,0,0,,Дис чапати дәмді ме?
Dialogue: 0,0:22:43.32,0:22:44.27,Default,,0,0,0,,Иә
Dialogue: 0,0:22:44.36,0:22:45.94,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:22:46.03,0:22:48.28,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:22:51.32,0:22:52.16,Default,,0,0,0,,Наан
Dialogue: 0,0:22:53.99,0:22:55.95,Default,,0,0,0,,Маған күріш ұнайды.
Dialogue: 0,0:22:56.04,0:22:56.87,Default,,0,0,0,,Мен Нан!
Dialogue: 0,0:22:56.95,0:22:57.87,Default,,0,0,0,,Мен де!
Dialogue: 0,0:22:57.95,0:22:59.79,Default,,0,0,0,,-тан -ан
Dialogue: 0,0:22:59.87,0:23:00.83,Default,,0,0,0,,Жасаңыз
Dialogue: 0,0:23:00.92,0:23:03.71,Default,,0,0,0,,Менде күріш те, наан да бар.
Dialogue: 0,0:23:03.79,0:23:05.88,Default,,0,0,0,,Наан қалайсыз ба?
Dialogue: 0,0:23:05.96,0:23:06.80,Default,,0,0,0,,Ахерн
Dialogue: 0,0:23:06.88,0:23:08.92,Default,,0,0,0,,Мен...
Dialogue: 0,0:23:19.35,0:23:20.52,Default,,0,0,0,,Нан!
Dialogue: 0,0:23:26.02,0:23:27.90,Default,,0,0,0,,О, сонымен қатар
Dialogue: 0,0:23:27.98,0:23:31.45,Default,,0,0,0,,Менің қарным ашты, бөксесі жойылады
Dialogue: 0,0:23:31.53,0:23:32.36,Default,,0,0,0,,О!
Dialogue: 0,0:23:32.45,0:23:35.33,Default,,0,0,0,,Қандай карри? Жақсы жұмыс!
Dialogue: 0,0:23:35.41,0:23:37.29,Default,,0,0,0,,Маған тістеп берші.
Dialogue: 0,0:23:37.37,0:23:39.62,Default,,0,0,0,,Ш…
Dialogue: 0,0:23:43.96,0:23:45.71,Default,,0,0,0,,Бо…
Dialogue: 0,0:23:49.71,0:23:52.13,Default,,0,0,0,,Бо~!
Dialogue: 0,0:23:57.81,0:23:59.02,Default,,0,0,0,,Бо…
Dialogue: 0,0:24:02.48,0:24:04.69,Default,,0,0,0,,- (Бо-чан) Бо... - Иә? Жарайды ма?
Dialogue: 0,0:24:04.77,0:24:06.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:09.19,0:24:10.78,Default,,0,0,0,,Ш…
Dialogue: 0,0:24:16.37,0:24:18.20,Default,,0,0,0,,Бо! Ха!
Dialogue: 0,0:24:18.29,0:24:19.95,Default,,0,0,0,,Боха!
Dialogue: 0,0:24:20.04,0:24:22.21,Default,,0,0,0,,(Жүректің соғу дыбысы)
Dialogue: 0,0:24:22.29,0:24:24.37,Default,,0,0,0,,Ммм
Dialogue: 0,0:24:24.46,0:24:27.17,Default,,0,0,0,,Шынайы карри де жаман емес.
Dialogue: 0,0:24:27.25,0:24:29.34,Default,,0,0,0,,Я...
Dialogue: 0,0:24:31.80,0:24:32.63,Default,,0,0,0,,Я...
Dialogue: 0,0:24:33.34,0:24:35.09,Default,,0,0,0,,-Бәрі дәмді көрінеді~ -Тая
Dialogue: 0,0:24:35.18,0:24:36.39,Default,,0,0,0,,Бо!
Dialogue: 0,0:24:39.81,0:24:40.97,Default,,0,0,0,,Бо!
Dialogue: 0,0:24:42.56,0:24:43.48,Default,,0,0,0,,Тая!
Dialogue: 0,0:24:43.56,0:24:46.94,Default,,0,0,0,,Иә? Бо Чан, дәл қазір не істедің?
Dialogue: 0,0:24:48.36,0:24:51.40,Default,,0,0,0,,Маған не болып жатыр?
Dialogue: 0,0:24:52.78,0:24:54.53,Default,,0,0,0,,Наан
Dialogue: 0,0:24:54.61,0:24:56.36,Default,,0,0,0,,Наан күріш
Dialogue: 0,0:24:56.45,0:24:58.07,Default,,0,0,0,,Наан және күріш
Dialogue: 0,0:24:58.16,0:25:00.33,Default,,0,0,0,,Нан Нан Нан
Dialogue: 0,0:25:01.20,0:25:03.46,Default,,0,0,0,,-(Даяшы) Чапати -Ой?
Dialogue: 0,0:25:06.12,0:25:07.50,Default,,0,0,0,,Чапати?
Dialogue: 0,0:25:07.58,0:25:09.00,Default,,0,0,0,,Чапати!?
Dialogue: 0,0:25:09.09,0:25:10.46,Default,,0,0,0,,таудың тереңінде демалыс үйін сатып алу туралы оқиға ше?
Dialogue: 0,0:25:10.55,0:25:12.09,Default,,0,0,0,,үшінна жетеді ме?
Dialogue: 0,0:25:12.17,0:25:13.63,Default,,0,0,0,,Уа!
Dialogue: 0,0:25:13.72,0:25:16.05,Default,,0,0,0,,Шин Чан - Нан
Dialogue: 0,0:25:16.13,0:25:17.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:17.93,0:25:19.68,Default,,0,0,0,,Шин Чан Нан болатын
Dialogue: 0,0:25:19.76,0:25:20.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:20.72,0:25:22.77,Default,,0,0,0,,Мен наан сұрадым...
Dialogue: 0,0:25:22.85,0:25:25.02,Default,,0,0,0,,Бо Чан, не болды?
Dialogue: 0,0:25:25.10,0:25:27.81,Default,,0,0,0,,Мм, менің бөксем тегістеліп қалды~
Dialogue: 0,0:25:27.90,0:25:29.23,Default,,0,0,0,,Итадаки масала карри~
Dialogue: 0,0:25:29.31,0:25:31.82,Default,,0,0,0,,Бұл наан!
Dialogue: 0,0:25:31.90,0:25:33.78,Default,,0,0,0,,Таң қалды!
Dialogue: 0,0:25:33.86,0:25:36.86,Default,,0,0,0,,Шин Чан наанды жегісі келді!
Dialogue: 0,0:25:36.95,0:25:38.24,Default,,0,0,0,,Бұл наан! Наан ғой!
Dialogue: 0,0:25:38.32,0:25:40.83,Default,,0,0,0,,Бо Чаннан қатты дауыл тұр!
Dialogue: 0,0:25:40.91,0:25:43.20,Default,,0,0,0,,Бо!
Dialogue: 0,0:25:43.29,0:25:44.83,Default,,0,0,0,,Бо-чан!?
Dialogue: 0,0:25:46.25,0:25:47.21,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:25:47.83,0:25:49.63,Default,,0,0,0,,Бо!
Dialogue: 0,0:25:49.71,0:25:50.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:51.04,0:25:52.09,Default,,0,0,0,,(Жануарлар үреді)
Dialogue: 0,0:25:52.17,0:25:55.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:01.97,0:26:03.06,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:26:03.14,0:26:04.77,Default,,0,0,0,,Дүниедегі ең қорқынышты нәрсе...
Dialogue: 0,0:26:04.85,0:26:07.81,Default,,0,0,0,,Жабайы баға!
Dialogue: 0,0:26:07.89,0:26:10.40,Default,,0,0,0,,(Рейтелдің айқайы)
Dialogue: 0,0:26:10.48,0:26:11.31,Default,,0,0,0,,Бо?
Dialogue: 0,0:26:13.07,0:26:16.11,Default,,0,0,0,,(қорқынышты дауыс)
Dialogue: 0,0:26:16.19,0:26:17.45,Default,,0,0,0,,Бірдеңе бар
Dialogue: 0,0:26:17.53,0:26:18.78,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:26:18.86,0:26:21.74,Default,,0,0,0,,Бо-чан, қарашы, бұл Нан.
Dialogue: 0,0:26:21.83,0:26:24.70,Default,,0,0,0,,Мен наан аламын, тынышталыңыз.
Dialogue: 0,0:26:24.79,0:26:25.62,Default,,0,0,0,,О!
Dialogue: 0,0:26:25.70,0:26:26.62,Default,,0,0,0,,Не!
Dialogue: 0,0:26:29.75,0:26:32.54,Default,,0,0,0,,Маған Шин Чанның наанын қайтар
Dialogue: 0,0:26:32.63,0:26:35.01,Default,,0,0,0,,(Рейтелдің айқайлауы)
Dialogue: 0,0:26:35.09,0:26:37.42,Default,,0,0,0,,Шин Чанның Нан!
Dialogue: 0,0:26:37.51,0:26:39.18,Default,,0,0,0,,Бо Чан жылдам!
Dialogue: 0,0:26:41.51,0:26:42.47,Default,,0,0,0,,Бо-чан!
Dialogue: 0,0:26:44.64,0:26:46.39,Default,,0,0,0,,(Питбуль) Э? (Доберман) Э?
Dialogue: 0,0:26:49.48,0:26:50.85,Default,,0,0,0,,Таң қалды! Ха!
Dialogue: 0,0:26:53.36,0:26:55.36,Default,,0,0,0,,Бо-чан, сабыр ет.
Dialogue: 0,0:26:55.44,0:26:56.28,Default,,0,0,0,,Немесе...
Dialogue: 0,0:26:56.36,0:26:58.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:58.32,0:26:59.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:59.90,0:27:02.57,Default,,0,0,0,,Ухун ахаан!
Dialogue: 0,0:27:02.66,0:27:04.78,Default,,0,0,0,,Ахерн мырза! Сенімен бәрі жақсы ма!?
Dialogue: 0,0:27:04.87,0:27:08.25,Default,,0,0,0,,Ух... Мм...
Dialogue: 0,0:27:08.33,0:27:11.71,Default,,0,0,0,,Бо Чан, сәл күте тұрыңыз!
Dialogue: 0,0:27:14.34,0:27:15.17,Default,,0,0,0,,Boh!
Dialogue: 0,0:27:15.25,0:27:16.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:27:17.21,0:27:19.59,Default,,0,0,0,,«Қағаз» мұрныңызда бар!
Dialogue: 0,0:27:20.22,0:27:22.39,Default,,0,0,0,,Бір жағы ғана қалды, берілме!
Dialogue: 0,0:27:22.47,0:27:24.18,Default,,0,0,0,,Әй!
Dialogue: 0,0:27:24.76,0:27:25.60,Default,,0,0,0,,Хмф!
Dialogue: 0,0:27:27.60,0:27:31.02,Default,,0,0,0,,Бала! Бұл «қағазды» мұрныңыздан алып тастаңыз!
Dialogue: 0,0:27:31.52,0:27:32.35,Default,,0,0,0,,«Қағаз»?
Dialogue: 0,0:27:33.19,0:27:34.31,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:27:35.32,0:27:38.03,Default,,0,0,0,,Үндістан полициясы ашылмаған құпия іс
Dialogue: 0,0:27:38.11,0:27:39.99,Default,,0,0,0,,Арнайы тергеу бөлімінің детективтері
Dialogue: 0,0:27:40.07,0:27:43.99,Default,,0,0,0,,Кабир Катчапапал Паккапапал Катчапапал Паккапапал
Dialogue: 0,0:27:44.07,0:27:45.24,Default,,0,0,0,,Сондай-ақ аскөк
Dialogue: 0,0:27:45.33,0:27:48.20,Default,,0,0,0,,Мен қауіпті «қағаз» жинауға келдім.
Dialogue: 0,0:27:48.29,0:27:50.37,Default,,0,0,0,,Жақсы жапон тілі!
Dialogue: 0,0:27:50.46,0:27:54.21,Default,,0,0,0,,Біз Үндістанның 1,45 миллиард халқымыз.
Dialogue: 0,0:27:54.29,0:27:56.67,Default,,0,0,0,,Ең жоғарғы элита
Dialogue: 0,0:27:56.75,0:27:58.63,Default,,0,0,0,,Мен 12 тілде сөйлеймін
Dialogue: 0,0:27:58.71,0:28:00.97,Default,,0,0,0,,Аскөк барлық тілдерде сөйлей алады.
Dialogue: 0,0:28:01.05,0:28:02.93,Default,,0,0,0,,Барлық тілдер!?
Dialogue: 0,0:28:03.01,0:28:07.14,Default,,0,0,0,,Үнді тілінде «Бөксемде жүре аламын».
Dialogue: 0,0:28:07.22,0:28:09.85,Default,,0,0,0,,(хинди)
Dialogue: 0,0:28:09.93,0:28:11.31,Default,,0,0,0,,корей тілінде
Dialogue: 0,0:28:11.39,0:28:13.77,Default,,0,0,0,,(корей)
Dialogue: 0,0:28:13.85,0:28:15.65,Default,,0,0,0,,Акита диалектісінде
Dialogue: 0,0:28:15.73,0:28:17.82,Default,,0,0,0,,Мен бөксемде жүре аламын.
Dialogue: 0,0:28:17.90,0:28:18.94,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:28:19.03,0:28:20.61,Default,,0,0,0,,Сіз мені не істеуге мәжбүрлейсіз?
Dialogue: 0,0:28:20.69,0:28:23.07,Default,,0,0,0,,Ум... «қағаз» дегеніміз не?
Dialogue: 0,0:28:23.15,0:28:26.53,Default,,0,0,0,,Баланың мұрнына қадалған зұлым «қағаз».
Dialogue: 0,0:28:27.24,0:28:28.74,Default,,0,0,0,,Сол «қағазды» мұрныма салғанда
Dialogue: 0,0:28:28.83,0:28:31.79,Default,,0,0,0,,Барлық дененің энергиясы мұрынға жиналады
Dialogue: 0,0:28:31.87,0:28:33.71,Default,,0,0,0,,Деміңізді дөрекі етіңіз
Dialogue: 0,0:28:33.79,0:28:36.21,Default,,0,0,0,,Керемет қуат береді!
Dialogue: 0,0:28:36.29,0:28:37.46,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:28:37.54,0:28:38.75,Default,,0,0,0,,Ал «қағаз» - бұл
Dialogue: 0,0:28:38.84,0:28:41.92,Default,,0,0,0,,Адамның тілегін орындауға тырысу
Dialogue: 0,0:28:42.01,0:28:43.47,Default,,0,0,0,,Қалау?
Dialogue: 0,0:28:43.55,0:28:46.64,Default,,0,0,0,,Барлық «қағаз» екі танауға енгенде.
Dialogue: 0,0:28:46.72,0:28:49.64,Default,,0,0,0,,Сол бала өз тілегін орындағысы келді.
Dialogue: 0,0:28:49.72,0:28:51.60,Default,,0,0,0,,Тирания жабайы жүреді
Dialogue: 0,0:28:51.68,0:28:54.73,Default,,0,0,0,,Зорлық-зомбылық және шектен шығу
Dialogue: 0,0:28:54.81,0:28:56.44,Default,,0,0,0,,Тиран бол (Бо-кун)!
Dialogue: 0,0:28:56.52,0:28:59.90,Default,,0,0,0,,Ә!? Бо-чан Бо-кунға айналады!?
Dialogue: 0,0:29:00.02,0:29:02.40,Default,,0,0,0,,«Қағаз» әлі бір жағында
Dialogue: 0,0:29:02.49,0:29:04.86,Default,,0,0,0,,«Қағаздың» күші әлі жартысы ғана
Dialogue: 0,0:29:04.95,0:29:07.66,Default,,0,0,0,,Сол «қағазды» қазір алып тастаңыз!
Dialogue: 0,0:29:07.74,0:29:09.20,Default,,0,0,0,,Дәл Аники айтқандай!
Dialogue: 0,0:29:11.79,0:29:12.62,Default,,0,0,0,,Ах!?
Dialogue: 0,0:29:13.46,0:29:14.58,Default,,0,0,0,,Уф!
Dialogue: 0,0:29:14.66,0:29:17.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:29:17.08,0:29:18.59,Default,,0,0,0,,Хмф!
Dialogue: 0,0:29:18.67,0:29:21.38,Default,,0,0,0,,(Рейтелдің айқайы)
Dialogue: 0,0:29:21.46,0:29:23.38,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:29:24.67,0:29:26.68,Default,,0,0,0,,Наан!
Dialogue: 0,0:29:27.43,0:29:28.26,Default,,0,0,0,,Анна…
Dialogue: 0,0:29:28.34,0:29:29.89,Default,,0,0,0,,О!
Dialogue: 0,0:29:30.85,0:29:32.68,Default,,0,0,0,,Шин Чанның нааны
Dialogue: 0,0:29:32.77,0:29:34.68,Default,,0,0,0,,...
Dialogue: 0,0:29:34.77,0:29:36.27,Default,,0,0,0,,Аха~!
Dialogue: 0,0:29:36.35,0:29:38.77,Default,,0,0,0,,-Ой? -(Бо-чан) Бұл жай наан болса, бұл наан.
Dialogue: 0,0:29:38.86,0:29:40.44,Default,,0,0,0,,Маған карри керек!
Dialogue: 0,0:29:40.52,0:29:42.36,Default,,0,0,0,,- (Бо-чан) Шин-чанға карри! -Апыр-ай!
Dialogue: 0,0:29:42.44,0:29:43.99,Default,,0,0,0,,Шин-чанға карри!
Dialogue: 0,0:29:44.07,0:29:46.45,Default,,0,0,0,,Шин Чанға карри! Шин Чанға карри!
Dialogue: 0,0:29:46.53,0:29:47.36,Default,,0,0,0,,Тататата…
Dialogue: 0,0:29:47.45,0:29:49.07,Default,,0,0,0,,Бо-чан!
Dialogue: 0,0:29:51.95,0:29:53.24,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:29:53.79,0:29:55.16,Default,,0,0,0,,Were серіктестігіне үміткер
Dialogue: 0,0:29:55.91,0:29:58.54,Default,,0,0,0,,Ратель королі, Рателс Рателі.
Dialogue: 0,0:29:58.63,0:30:00.88,Default,,0,0,0,,Сені осылай көруге рұқсат еткеніңе сене алар емеспін.
Dialogue: 0,0:30:01.88,0:30:03.76,Default,,0,0,0,,Оны ұстаңыз!
Dialogue: 0,0:30:06.47,0:30:08.80,Default,,0,0,0,,Шин Чанның карри Шин Чанның карри
Dialogue: 0,0:30:08.89,0:30:11.80,Default,,0,0,0,,Шин Чанның Карри Шин Чан жасыл бұрышты жек көреді
Dialogue: 0,0:30:11.89,0:30:13.26,Default,,0,0,0,,Шин-чан етті жақсы көреді
Dialogue: 0,0:30:13.35,0:30:14.27,Default,,0,0,0,,Бо-чан!
Dialogue: 0,0:30:14.35,0:30:15.73,Default,,0,0,0,,Сізге тандыр тауық еті де ұнай ма?
Dialogue: 0,0:30:15.81,0:30:17.64,Default,,0,0,0,,Маған да күріш ұнайды, маған да нан ұнайды
Dialogue: 0,0:30:17.73,0:30:19.19,Default,,0,0,0,,Наан бар Наан бар
Dialogue: 0,0:30:19.27,0:30:20.81,Default,,0,0,0,,Шин Чанның карриі
Dialogue: 0,0:30:20.90,0:30:22.86,Default,,0,0,0,,Шин Чанның карриі!
Dialogue: 0,0:30:23.82,0:30:24.73,Default,,0,0,0,,Хмф!
Dialogue: 0,0:30:24.82,0:30:26.99,Default,,0,0,0,,Шин Чанның карри Шин Чан етті жақсы көреді
Dialogue: 0,0:30:27.07,0:30:29.11,Default,,0,0,0,,Мен де балықты жақсы көремін, мен асшаяндарды да жақсы көремін
Dialogue: 0,0:30:29.20,0:30:30.41,Default,,0,0,0,,Шин-чан, сен пияз жей аласың ба?
Dialogue: 0,0:30:30.49,0:30:32.41,Default,,0,0,0,,Шин-чан түрлі-түсті заттарды жақсы көреді
Dialogue: 0,0:30:32.49,0:30:33.87,Default,,0,0,0,,Бірақ тым қараңғы болса, бұл жақсы емес
Dialogue: 0,0:30:33.95,0:30:36.25,Default,,0,0,0,,Шин Чанның карри Шин Чанның карри!
Dialogue: 0,0:30:36.33,0:30:37.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:37.66,0:30:39.79,Default,,0,0,0,,Сәлем! Балаларға не істеп жатырсың?
Dialogue: 0,0:30:39.87,0:30:41.42,Default,,0,0,0,,Біз осындамыз!
Dialogue: 0,0:30:41.50,0:30:42.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:42.75,0:30:44.96,Default,,0,0,0,,Мен катаны бірден қоямын.
Dialogue: 0,0:30:45.05,0:30:46.01,Default,,0,0,0,,…Тоқта, қайда барасың, Зура?
Dialogue: 0,0:30:48.26,0:30:51.01,Default,,0,0,0,,Сіздің ішіңізде әлі ұйықтап жатқан қабілеттер
Dialogue: 0,0:30:51.09,0:30:52.76,Default,,0,0,0,,120% қайтарып алыңыз!
Dialogue: 0,0:30:52.85,0:30:55.06,Default,,0,0,0,,Бұл Үндістанның күші!
Dialogue: 0,0:30:55.14,0:30:59.35,Default,,0,0,0,,♪ «Үндістанның қуаты 120%»
Dialogue: 0,0:31:00.69,0:31:03.48,Default,,0,0,0,,(Ән айтатын екі дауыс)
Dialogue: 0,0:31:19.58,0:31:20.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:32.47,0:31:33.34,Default,,0,0,0,,О!
Dialogue: 0,0:31:33.43,0:31:35.14,Default,,0,0,0,,Қуатты күшейту үшін ән айтып, билеңіз!?
Dialogue: 0,0:32:11.30,0:32:13.72,Default,,0,0,0,,Керемет! Үндістанның күші!
Dialogue: 0,0:32:19.81,0:32:21.18,Default,,0,0,0,,Екі рет секіру ме? Әзілдеп тұрсың ғой.
Dialogue: 0,0:32:21.27,0:32:22.48,Default,,0,0,0,,Пойыз!
Dialogue: 0,0:32:22.56,0:32:24.02,Default,,0,0,0,,Мушибай мен кетуім керек!
Dialogue: 0,0:32:24.10,0:32:25.15,Default,,0,0,0,,Бо-чан!?
Dialogue: 0,0:32:25.23,0:32:27.86,Default,,0,0,0,,Ойын-сауық фестивалі! үшінмыз сыртқа шығайық!
Dialogue: 0,0:32:28.65,0:32:29.82,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:32:29.90,0:32:32.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:32.15,0:32:33.40,Default,,0,0,0,,- (Бо-чан) Әй! - (Казама-кун) Ах!
Dialogue: 0,0:32:34.70,0:32:36.37,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:32:37.24,0:32:38.58,Default,,0,0,0,,- (Бо-чан) Әй! -Ах!
Dialogue: 0,0:32:38.66,0:32:40.54,Default,,0,0,0,,Иә!? Аа!? Аа!?
Dialogue: 0,0:32:41.16,0:32:42.00,Default,,0,0,0,,- Кя! -(Бо-чан) Бо!
Dialogue: 0,0:32:42.08,0:32:43.21,Default,,0,0,0,,Иә!? Уау...
Dialogue: 0,0:32:43.29,0:32:44.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:45.75,0:32:47.38,Default,,0,0,0,,А...
Dialogue: 0,0:32:47.46,0:32:48.84,Default,,0,0,0,,-Уау! -(Бо-чан) Бо!
Dialogue: 0,0:32:50.46,0:32:51.97,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:32:52.05,0:32:53.72,Default,,0,0,0,,-Ах... -(Бо-чан) Хмф!
Dialogue: 0,0:32:54.38,0:32:56.14,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:32:56.22,0:32:57.93,Default,,0,0,0,,- (Бо-чан) Бо! -Аа~!
Dialogue: 0,0:32:58.01,0:32:59.43,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:32:59.51,0:33:01.56,Default,,0,0,0,,Фу~ Фу~ На~...
Dialogue: 0,0:33:01.64,0:33:03.60,Default,,0,0,0,,Теріп-жеуге болмайды! Мүлдем!
Dialogue: 0,0:33:03.69,0:33:04.89,Default,,0,0,0,,Уа... ау! Апыр-ай!
Dialogue: 0,0:33:04.98,0:33:07.36,Default,,0,0,0,,Уау! Кенеттен...
Dialogue: 0,0:33:07.44,0:33:09.19,Default,,0,0,0,,Boh!
Dialogue: 0,0:33:09.27,0:33:12.99,Default,,0,0,0,,Бо~!
Dialogue: 0,0:33:13.07,0:33:14.11,Default,,0,0,0,,Boh!
Dialogue: 0,0:33:14.20,0:33:16.36,Default,,0,0,0,,Уау...
Dialogue: 0,0:33:16.45,0:33:17.37,Default,,0,0,0,,Әй?
Dialogue: 0,0:33:19.28,0:33:20.33,Default,,0,0,0,,Садақ…
Dialogue: 0,0:33:20.41,0:33:21.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:23.66,0:33:26.96,Default,,0,0,0,,Хмф! Мен керемет емеспін бе?
Dialogue: 0,0:33:27.83,0:33:28.92,Default,,0,0,0,,Тая
Dialogue: 0,0:33:31.25,0:33:32.96,Default,,0,0,0,,Сіз сондай-ақ осындай нәрсені жасай аласыз
Dialogue: 0,0:33:33.05,0:33:34.34,Default,,0,0,0,,-Уау! - А?
Dialogue: 0,0:33:34.42,0:33:36.43,Default,,0,0,0,,Не болды?
Dialogue: 0,0:33:36.51,0:33:38.59,Default,,0,0,0,,Мен бұрын-соңды мұндай сұлу қызды көрген емеспін.
Dialogue: 0,0:33:38.68,0:33:40.05,Default,,0,0,0,,Күте тұрыңыз! Бо-чан
Dialogue: 0,0:33:40.14,0:33:42.01,Default,,0,0,0,,Сіз бәрін жасай аласыз!
Dialogue: 0,0:33:42.10,0:33:43.56,Default,,0,0,0,,Бо! Бо! Тағзым!
Dialogue: 0,0:33:43.64,0:33:44.48,Default,,0,0,0,,О!?
Dialogue: 0,0:33:45.35,0:33:46.69,Default,,0,0,0,,Мен, керемет!
Dialogue: 0,0:33:46.77,0:33:48.02,Default,,0,0,0,,Не? Аа!? (Әйел) Ах!
Dialogue: 0,0:33:48.10,0:33:49.98,Default,,0,0,0,,Бо~!
Dialogue: 0,0:33:50.06,0:33:51.86,Default,,0,0,0,,Тағзым!
Dialogue: 0,0:33:58.61,0:34:00.37,Default,,0,0,0,,Yotto...
Dialogue: 0,0:34:04.75,0:34:06.87,Default,,0,0,0,,Бо Чан, бұл қауіпті~
Dialogue: 0,0:34:06.96,0:34:08.50,Default,,0,0,0,,Сол «қағазды» алып тастаңыз!
Dialogue: 0,0:34:09.46,0:34:10.46,Default,,0,0,0,,«Қағаз»?
Dialogue: 0,0:34:10.54,0:34:12.21,Default,,0,0,0,,Мұрныңыздағы тіннің арқасында
Dialogue: 0,0:34:12.30,0:34:15.21,Default,,0,0,0,,Бо Чан біртүрлі әрекет етеді!
Dialogue: 0,0:34:17.51,0:34:19.30,Default,,0,0,0,,Бо…
Dialogue: 0,0:34:19.39,0:34:22.35,Default,,0,0,0,,А... бұл біртүрлі ме?
Dialogue: 0,0:34:23.68,0:34:26.31,Default,,0,0,0,,Мен жындымын ба?
Dialogue: 0,0:34:27.35,0:34:29.06,Default,,0,0,0,,Біртүрлі емес
Dialogue: 0,0:34:30.06,0:34:32.44,Default,,0,0,0,,Біртүрлі ештеңе жоқ
Dialogue: 0,0:34:34.28,0:34:37.24,Default,,0,0,0,,Қазіргі мен керемет!
Dialogue: 0,0:34:37.32,0:34:40.36,Default,,0,0,0,,Тағзым! Бобо! Тағзым…
Dialogue: 0,0:34:40.45,0:34:41.74,Default,,0,0,0,,Бо-чан…
Dialogue: 0,0:34:41.82,0:34:43.99,Default,,0,0,0,,Бөксе қылшық бала!
Dialogue: 0,0:34:44.08,0:34:46.29,Default,,0,0,0,,Мына рюкзакты осы жерге тастаңыз!
Dialogue: 0,0:34:47.00,0:34:48.46,Default,,0,0,0,,Мұрыннан ағып жатқан балаға
Dialogue: 0,0:34:48.54,0:34:51.58,Default,,0,0,0,,Басқа қағаздың ұрлануына жол берме!
Dialogue: 0,0:34:51.67,0:34:54.55,Default,,0,0,0,,Бо~ Бобобобо!
Dialogue: 0,0:34:54.63,0:34:55.92,Default,,0,0,0,,Boh!
Dialogue: 0,0:34:56.76,0:34:59.76,Default,,0,0,0,,«Қағаз» Тағы бір қағаз бар.
Dialogue: 0,0:34:59.84,0:35:02.18,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:35:08.64,0:35:11.77,Default,,0,0,0,,«Қағаз» 2 бөлікке бөлінеді
Dialogue: 0,0:35:12.27,0:35:15.07,Default,,0,0,0,,Мен мұны қалаймын! Мен тағы біреуін қалаймын!
Dialogue: 0,0:35:15.15,0:35:17.11,Default,,0,0,0,,Мен мұны қалаймын! Мен оны тілеймін!
Dialogue: 0,0:35:17.19,0:35:20.28,Default,,0,0,0,,«Қағаз» баланың мұрнына жабысып қалды
Dialogue: 0,0:35:20.36,0:35:22.28,Default,,0,0,0,,Мен тағы бір тамақ іздеп жүрмін!
Dialogue: 0,0:35:22.37,0:35:23.20,Default,,0,0,0,,Болады!
Dialogue: 0,0:35:23.28,0:35:24.37,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:35:24.99,0:35:26.62,Default,,0,0,0,,Бо-чан, саған не болды!
Dialogue: 0,0:35:26.70,0:35:28.79,Default,,0,0,0,,Бұл Бо Чанға ұқсамайды!
Dialogue: 0,0:35:28.87,0:35:29.71,Default,,0,0,0,,Бо!?
Dialogue: 0,0:35:29.79,0:35:32.50,Default,,0,0,0,,Бо-чан әлдеқайда сабырлы.
Dialogue: 0,0:35:32.58,0:35:35.34,Default,,0,0,0,,Иә! Бо Чан мейірімдірек
Dialogue: 0,0:35:35.42,0:35:37.59,Default,,0,0,0,,Ал сен жақсы қызсың!
Dialogue: 0,0:35:37.67,0:35:38.76,Default,,0,0,0,,...
Dialogue: 0,0:35:39.97,0:35:41.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:44.51,0:35:46.31,Default,,0,0,0,,Бо-чан!?
Dialogue: 0,0:35:46.39,0:35:48.14,Default,,0,0,0,,- (Бо-чан) Әй! Ха! -Уау...
Dialogue: 0,0:35:48.77,0:35:50.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:35:52.06,0:35:53.60,Default,,0,0,0,,Бо-чан…
Dialogue: 0,0:35:54.65,0:35:57.57,Default,,0,0,0,,Мен туралы не білесің?
Dialogue: 0,0:35:58.44,0:35:59.90,Default,,0,0,0,,Е...
Dialogue: 0,0:36:01.36,0:36:02.86,Default,,0,0,0,,Бо-чан?
Dialogue: 0,0:36:03.53,0:36:06.08,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:36:06.16,0:36:10.04,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:36:12.29,0:36:14.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:14.79,0:36:16.67,Default,,0,0,0,,Уау...
Dialogue: 0,0:36:19.63,0:36:22.43,Default,,0,0,0,,Мықты табылды!
Dialogue: 0,0:36:22.51,0:36:24.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:24.47,0:36:25.85,Default,,0,0,0,,Шинносуке!
Dialogue: 0,0:36:25.93,0:36:28.51,Default,,0,0,0,,О... То-чан!
Dialogue: 0,0:36:28.60,0:36:29.97,Default,,0,0,0,,Уф!
Dialogue: 0,0:36:35.61,0:36:36.86,Default,,0,0,0,,Иә!?
Dialogue: 0,0:36:36.94,0:36:38.32,Default,,0,0,0,,Аха~
Dialogue: 0,0:36:38.40,0:36:39.78,Default,,0,0,0,,Дорарара...!
Dialogue: 0,0:36:39.86,0:36:43.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:43.28,0:36:44.16,Default,,0,0,0,,Хмф!
Dialogue: 0,0:36:44.24,0:36:45.62,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:36:45.70,0:36:47.45,Default,,0,0,0,,Иә! Хмф!
Dialogue: 0,0:36:47.53,0:36:51.58,Default,,0,0,0,,Кабир Катчапапал Паккапапал Катчапапал Паккапапал!
Dialogue: 0,0:36:51.66,0:36:52.79,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:36:52.87,0:36:55.75,Default,,0,0,0,,Аскөк~!
Dialogue: 0,0:36:55.83,0:36:58.21,Default,,0,0,0,,Масао-кун! Широ!
Dialogue: 0,0:37:00.25,0:37:01.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:02.01,0:37:04.18,Default,,0,0,0,,Тотто… Тотто…
Dialogue: 0,0:37:04.26,0:37:05.59,Default,,0,0,0,,Иә? Ах~
Dialogue: 0,0:37:05.68,0:37:09.97,Default,,0,0,0,,Шинносуке!
Dialogue: 0,0:37:17.19,0:37:19.90,Default,,0,0,0,,(Ағып жатқан өзеннің дыбысы)
Dialogue: 0,0:37:28.07,0:37:29.83,Default,,0,0,0,,Шизуку Каваками, Курона Анку, Наширо
Dialogue: 0,0:37:29.91,0:37:31.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:37:35.71,0:37:37.92,Default,,0,0,0,,О? О~
Dialogue: 0,0:37:39.38,0:37:41.75,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:37:41.84,0:37:44.09,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:37:44.17,0:37:46.22,Default,,0,0,0,,Нуах! Ах...
Dialogue: 0,0:37:47.55,0:37:48.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:52.77,0:37:53.93,Default,,0,0,0,,Хой
Dialogue: 0,0:37:56.31,0:37:58.73,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:37:59.90,0:38:03.11,Default,,0,0,0,,То-чан! Ка-чан!
Dialogue: 0,0:38:14.37,0:38:15.37,Default,,0,0,0,,Ау?
Dialogue: 0,0:38:16.12,0:38:19.33,Default,,0,0,0,,Бұл Мусибай, Хагашмир провинциясы
Dialogue: 0,0:38:20.58,0:38:23.59,Default,,0,0,0,,Ойын-сауық фестивалі өтетін орын
Dialogue: 0,0:38:24.38,0:38:26.09,Default,,0,0,0,,Сәлем текше
Dialogue: 0,0:38:26.17,0:38:27.43,Default,,0,0,0,,Иә
Dialogue: 0,0:38:27.51,0:38:30.01,Default,,0,0,0,,Автокөлікті автопилотты дайындаңыз
Dialogue: 0,0:38:30.09,0:38:31.51,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:38:31.60,0:38:33.97,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,0:38:38.98,0:38:42.36,Default,,0,0,0,,Вере сарайына кел, мін.
Dialogue: 0,0:38:42.44,0:38:44.82,Default,,0,0,0,,Мен сені үйіме шақырамын.
Dialogue: 0,0:38:44.90,0:38:46.07,Default,,0,0,0,,Мініңіз
Dialogue: 0,0:38:46.15,0:38:47.65,Default,,0,0,0,,және өзімнің ашуымнан адасуда болдым.
Dialogue: 0,0:38:47.74,0:38:50.28,Default,,0,0,0,,Өйткені Бо Уэрдің серіктесі.
Dialogue: 0,0:38:51.49,0:38:52.62,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:38:54.20,0:38:55.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:55.12,0:38:58.71,Default,,0,0,0,,Міне! Сен не істеп жатырсың!
Dialogue: 0,0:38:58.79,0:39:00.25,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:39:00.33,0:39:01.54,Default,,0,0,0,,Сіз!?
Dialogue: 0,0:39:02.79,0:39:04.50,Default,,0,0,0,,Бо-чан, ол жігіттен аулақ жүр!
Dialogue: 0,0:39:04.59,0:39:07.59,Default,,0,0,0,,- Кя! -Жібер сені, бейбақ!
Dialogue: 0,0:39:07.67,0:39:09.09,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:39:09.18,0:39:11.47,Default,,0,0,0,,Шин Чанның анасы мен әкесі
Dialogue: 0,0:39:11.55,0:39:12.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:14.31,0:39:15.56,Default,,0,0,0,,Мен қазірдің өзінде
Dialogue: 0,0:39:16.18,0:39:19.52,Default,,0,0,0,,Мені ешкімнің қорғауы керек емес
Dialogue: 0,0:39:19.60,0:39:20.73,Default,,0,0,0,,Е...
Dialogue: 0,0:39:20.81,0:39:21.98,Default,,0,0,0,,Бо-чан?
Dialogue: 0,0:39:22.06,0:39:24.57,Default,,0,0,0,,Кел, жолдасым, алға ұмтыл.
Dialogue: 0,0:39:24.65,0:39:26.69,Default,,0,0,0,,Әйтпесе, артқа өтіңіз
Dialogue: 0,0:39:26.78,0:39:29.07,Default,,0,0,0,,- Даааа...! -Ах!
Dialogue: 0,0:39:29.15,0:39:30.53,Default,,0,0,0,,-Уау! -аздап!
Dialogue: 0,0:39:30.61,0:39:32.57,Default,,0,0,0,,Балаңыз үшін не істемексіз?
Dialogue: 0,0:39:32.66,0:39:33.95,Default,,0,0,0,,(Хирошидің айқайы)
Dialogue: 0,0:39:35.79,0:39:37.91,Default,,0,0,0,,-Не істеп жатырсың? - Бұл қандай ем?
Dialogue: 0,0:39:38.00,0:39:39.33,Default,,0,0,0,,Сәлем, Бо Чан!
Dialogue: 0,0:39:39.41,0:39:40.62,Default,,0,0,0,,- (Бо-чан) Бо-бо-бо... - (Казама-кун) Бо-чан!
Dialogue: 0,0:39:40.71,0:39:43.83,Default,,0,0,0,,Мен Шинносуке мен Масао-кунды табуым керек!
Dialogue: 0,0:39:43.92,0:39:47.51,Default,,0,0,0,,Маған қалдырыңыз, мен оны тамаша дайындаймын.
Dialogue: 0,0:39:47.59,0:39:48.55,Default,,0,0,0,,Дайындық?
Dialogue: 0,0:39:48.63,0:39:50.80,Default,,0,0,0,,Бұл ойын-сауық фестивалі, солай ма?
Dialogue: 0,0:39:50.88,0:39:54.26,Default,,0,0,0,,Біз мұнда фестивальде ойнауға келдік.
Dialogue: 0,0:39:54.35,0:39:57.10,Default,,0,0,0,,Біз ойын-сауық фестиваліне бардық
Dialogue: 0,0:39:57.18,0:39:58.72,Default,,0,0,0,,Мен мұнда келдім
Dialogue: 0,0:39:58.81,0:39:59.98,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:40:00.06,0:40:02.56,Default,,0,0,0,,Менің досым Бо үшін
Dialogue: 0,0:40:02.65,0:40:04.94,Default,,0,0,0,,Бүкіл фестивальді сатып алайық
Dialogue: 0,0:40:05.02,0:40:06.65,Default,,0,0,0,,Фестивальді сатып алу!?
Dialogue: 0,0:40:06.73,0:40:08.40,Default,,0,0,0,,Мұны қалай жасауға болады...
Dialogue: 0,0:40:08.48,0:40:10.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:11.57,0:40:15.99,Default,,0,0,0,,Бұл 1 триллион иенге Ware жасаған таңғажайып куб.
Dialogue: 0,0:40:16.08,0:40:19.62,Default,,0,0,0,,Осы арқылы жерсерік арқылы дүниежүзілік желіге қосылуға болады.
Dialogue: 0,0:40:19.70,0:40:22.83,Default,,0,0,0,,Лезде қосылыңыз және кез келген нәрсені жасаңыз
Dialogue: 0,0:40:22.92,0:40:23.96,Default,,0,0,0,,(ақшаның сыңғырлаған дыбысы)
Dialogue: 0,0:40:24.04,0:40:26.34,Default,,0,0,0,,энд фестиваль Ware және т.б.
Dialogue: 0,0:40:26.42,0:40:28.09,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:40:28.17,0:40:30.71,Default,,0,0,0,,Қасқыр мен Боу ұсынады!
Dialogue: 0,0:40:30.80,0:40:32.30,Default,,0,0,0,,Ойын-сауық фестивалі!
Dialogue: 0,0:40:32.38,0:40:33.72,Default,,0,0,0,,Боха!
Dialogue: 0,0:40:33.80,0:40:38.18,Default,,0,0,0,,Әдептілік болғанша жақсы, өйткені мен Боға серіктесмін.
Dialogue: 0,0:40:38.26,0:40:39.14,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:40:39.22,0:40:40.06,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:40:40.14,0:40:42.18,Default,,0,0,0,,Міне! Бо Чанға жақындамаңыз!
Dialogue: 0,0:40:42.27,0:40:43.73,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:40:43.81,0:40:45.48,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:40:45.56,0:40:47.36,Default,,0,0,0,,-Hi Cube - (Сугои кубигі) Иә
Dialogue: 0,0:40:47.44,0:40:49.86,Default,,0,0,0,,Музыка басталады!
Dialogue: 0,0:40:50.57,0:40:54.32,Default,,0,0,0,,♪ «Қасқыр»
Dialogue: 0,0:40:58.24,0:41:02.87,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:42:08.90,0:42:10.61,Default,,0,0,0,,Кім шалбарын шылаған, сен, қанды шошқа!
Dialogue: 0,0:42:10.69,0:42:12.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:42:12.23,0:42:13.61,Default,,0,0,0,,Менің үстіме жат...
Dialogue: 0,0:42:13.69,0:42:15.49,Default,,0,0,0,,Аскөк...
Dialogue: 0,0:42:15.57,0:42:17.24,Default,,0,0,0,,Сіз детективсіз бе?
Dialogue: 0,0:42:17.32,0:42:18.61,Default,,0,0,0,,Бұрынғыдай ән айт
Dialogue: 0,0:42:18.70,0:42:20.70,Default,,0,0,0,,Үнді күшімен бірдеңе жасаңыз!
Dialogue: 0,0:42:20.78,0:42:24.12,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:42:28.04,0:42:29.21,Default,,0,0,0,,Қараңғы!
Dialogue: 0,0:42:29.92,0:42:32.67,Default,,0,0,0,,Бұл «қағаз» дегеніміз не?
Dialogue: 0,0:42:32.75,0:42:35.21,Default,,0,0,0,,Сіз бұл сіздің тілектеріңізді орындайтынын айттыңыз ...
Dialogue: 0,0:42:35.30,0:42:38.93,Default,,0,0,0,,Мен мұны қалайтынымды жегім келеді
Dialogue: 0,0:42:39.01,0:42:42.68,Default,,0,0,0,,Адамның қалауы мұхиттай түпсіз.
Dialogue: 0,0:42:43.64,0:42:45.64,Default,,0,0,0,,«Қағаз» оны мұрнына ұстағандарға арналған
Dialogue: 0,0:42:45.72,0:42:50.02,Default,,0,0,0,,Бұл сізге өз қалауларыңызды жүзеге асыруға күш береді деп ойлаймын.
Dialogue: 0,0:42:50.10,0:42:52.40,Default,,0,0,0,,Сіздің қалауыңызды орындау күші?
Dialogue: 0,0:42:53.48,0:42:57.19,Default,,0,0,0,,Ежелден адамдарды тиран деп атаған.
Dialogue: 0,0:42:57.28,0:43:00.86,Default,,0,0,0,,Кейбіреулер «қағаздың» әсері болуы мүмкін дейді.
Dialogue: 0,0:43:00.95,0:43:03.49,Default,,0,0,0,,Айтпаған
Dialogue: 0,0:43:04.37,0:43:07.83,Default,,0,0,0,,«Қағаздың» бар екендігі соңғы рет расталды
Dialogue: 0,0:43:07.91,0:43:09.46,Default,,0,0,0,,35 жыл бұрын Үндістанда
Dialogue: 0,0:43:09.54,0:43:14.42,Default,,0,0,0,,Үнді пілі бір ауылды діңімен ғана қиратты
Dialogue: 0,0:43:14.50,0:43:16.13,Default,,0,0,0,,Үнді пілі?
Dialogue: 0,0:43:16.21,0:43:20.26,Default,,0,0,0,,Бұл банан өсіретін әдемі ауыл еді.
Dialogue: 0,0:43:21.97,0:43:23.01,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:43:23.10,0:43:26.06,Default,,0,0,0,,«Қағаз» пілдің діңіне жабысып қалды!
Dialogue: 0,0:43:26.77,0:43:31.23,Default,,0,0,0,,Мүмкін пілдің банан жегісі келетіні
Dialogue: 0,0:43:31.31,0:43:34.06,Default,,0,0,0,,Ауылды қиратты деп ойлаймын.
Dialogue: 0,0:43:34.15,0:43:36.86,Default,,0,0,0,,Бо Чанмен не болады?
Dialogue: 0,0:43:36.94,0:43:38.03,Default,,0,0,0,,Екі дана «қағаз»
Dialogue: 0,0:43:38.11,0:43:41.82,Default,,0,0,0,,Екі танау толық толтырылған кезде
Dialogue: 0,0:43:41.91,0:43:46.49,Default,,0,0,0,,Адамдармен бір болып, залым болады деп ойлаймын (Бо-кун).
Dialogue: 0,0:43:49.08,0:43:52.37,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:44:07.97,0:44:09.98,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:44:10.48,0:44:12.69,Default,,0,0,0,,А? Миса?
Dialogue: 0,0:44:12.77,0:44:15.11,Default,,0,0,0,,Мен бұл «қағазды» соңғы рет көрдім
Dialogue: 0,0:44:15.19,0:44:18.48,Default,,0,0,0,,Мен мұны қатты қаласам да, қарсы тұра алмайтындай болдым.
Dialogue: 0,0:44:18.57,0:44:20.57,Default,,0,0,0,,Мен мұны қазір мүлде қаламаймын.
Dialogue: 0,0:44:20.65,0:44:24.24,Default,,0,0,0,,«Қағаз» сол баланы алды
Dialogue: 0,0:44:24.32,0:44:28.54,Default,,0,0,0,,Маған енді ешкімді азғырудың қажеті жоқ сияқты.
Dialogue: 0,0:44:28.62,0:44:32.41,Default,,0,0,0,,Сол баланы тиран ету ғана қалды.
Dialogue: 0,0:44:32.50,0:44:34.54,Default,,0,0,0,,Бөксесі бар баланың
Dialogue: 0,0:44:34.63,0:44:37.50,Default,,0,0,0,,Мен тағы бір «қағаз» алғым келеді
Dialogue: 0,0:44:37.59,0:44:40.17,Default,,0,0,0,,Шинносукеде бар «Қағаз»!?
Dialogue: 0,0:44:40.26,0:44:42.72,Default,,0,0,0,,«Қағаз» екі бөлік, бір
Dialogue: 0,0:44:42.80,0:44:47.68,Default,,0,0,0,,Енді бір тиранның тумауы үшін жағдай осылай болды (Бо-кун)
Dialogue: 0,0:44:47.76,0:44:50.43,Default,,0,0,0,,Қолында «қағаз» бар бөксесі бар бала—
Dialogue: 0,0:44:50.52,0:44:53.14,Default,,0,0,0,,Егер сіз алыс жерде қашып кетсеңіз...
Dialogue: 0,0:44:53.23,0:44:56.31,Default,,0,0,0,,«Бөкселері дөңес бала» Бұлай емес!
Dialogue: 0,0:44:56.40,0:44:57.56,Default,,0,0,0,,Шинносуке Хана!
Dialogue: 0,0:44:57.65,0:45:00.57,Default,,0,0,0,,Бөксесі томпайып, томпақ, тегіс
Dialogue: 0,0:45:00.65,0:45:05.45,Default,,0,0,0,,Менің тәтті сүйкімді балам Шинносуке!
Dialogue: 0,0:45:05.53,0:45:10.54,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:45:23.88,0:45:26.26,Default,,0,0,0,,...
Dialogue: 0,0:45:26.34,0:45:27.55,Default,,0,0,0,,(Қала қарбалас)
Dialogue: 0,0:45:27.64,0:45:28.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:45:32.52,0:45:34.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:39.48,0:45:41.61,Default,,0,0,0,,Ой... Ой...
Dialogue: 0,0:45:41.69,0:45:43.03,Default,,0,0,0,,Уау! Тоттотто...
Dialogue: 0,0:45:43.11,0:45:44.45,Default,,0,0,0,,Уау! Татата...
Dialogue: 0,0:45:44.53,0:45:46.36,Default,,0,0,0,,Ой... Эй!
Dialogue: 0,0:45:47.03,0:45:48.95,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:45:54.08,0:45:56.29,Default,,0,0,0,,Фу~ Фу~
Dialogue: 0,0:45:56.37,0:45:59.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:59.42,0:46:00.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:46:03.55,0:46:04.38,Default,,0,0,0,,(хинди)
Dialogue: 0,0:46:04.47,0:46:06.47,Default,,0,0,0,,О? (Еркек хинди)
Dialogue: 0,0:46:06.55,0:46:09.47,Default,,0,0,0,,Мм... Мен Босемін
Dialogue: 0,0:46:11.05,0:46:13.72,Default,,0,0,0,,Уау! Тоттотто...
Dialogue: 0,0:46:13.81,0:46:14.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:46:14.73,0:46:16.69,Default,,0,0,0,,Хехехе
Dialogue: 0,0:46:16.77,0:46:22.07,Default,,0,0,0,,(Хинди тілінде қонақ үшін)
Dialogue: 0,0:46:22.15,0:46:23.73,Default,,0,0,0,,О...
Dialogue: 0,0:46:24.69,0:46:25.99,Default,,0,0,0,,Ахм
Dialogue: 0,0:46:36.87,0:46:38.04,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:46:41.42,0:46:42.80,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:46:42.88,0:46:45.21,Default,,0,0,0,,Әй?
Dialogue: 0,0:46:45.30,0:46:46.97,Default,,0,0,0,,Зо мырза...
Dialogue: 0,0:46:47.59,0:46:49.59,Default,,0,0,0,,Зо мырза
Dialogue: 0,0:46:49.68,0:46:51.30,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:46:51.39,0:46:52.22,Default,,0,0,0,,О!
Dialogue: 0,0:46:52.30,0:46:57.31,Default,,0,0,0,,♪ «Ола - алаңсыз нәрсе»
Dialogue: 0,0:47:13.45,0:47:18.00,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:49:14.61,0:49:17.99,Default,,0,0,0,,Ахаха ахаха...!
Dialogue: 0,0:49:19.66,0:49:23.50,Default,,0,0,0,,үшін бақытты болсын!
Dialogue: 0,0:49:23.58,0:49:25.17,Default,,0,0,0,,Жарайды~ Ариана
Dialogue: 0,0:49:25.25,0:49:27.13,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:49:27.21,0:49:29.04,Default,,0,0,0,,Биылғы ойын-сауық фестиваліндегі күлімсіреумен
Dialogue: 0,0:49:29.13,0:49:31.09,Default,,0,0,0,,үшінн бақытты ету~
Dialogue: 0,0:49:31.17,0:49:33.55,Default,,0,0,0,,Иә! Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:49:33.63,0:49:35.68,Default,,0,0,0,,Ариана жаттығуда!
Dialogue: 0,0:49:35.76,0:49:36.93,Default,,0,0,0,,- (Кіші мектеп оқушысы В) Иә!? - (Кіші мектеп оқушысы А) Кеттік!
Dialogue: 0,0:49:37.01,0:49:39.01,Default,,0,0,0,,- (Кіші мектеп оқушысы В) Иә! -о?
Dialogue: 0,0:49:39.10,0:49:43.48,Default,,0,0,0,,- (қараушылар) Ариана! -(Ариана) Ахха!
Dialogue: 0,0:49:43.56,0:49:46.06,Default,,0,0,0,,Міне, ақырында! ариана
Dialogue: 0,0:49:46.14,0:49:49.40,Default,,0,0,0,,Әкем де, шешем де маған қолдау көрсету үшін осында!
Dialogue: 0,0:49:49.48,0:49:51.36,Default,,0,0,0,,Әрқашан күлімдеп, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:49:51.44,0:49:52.61,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:49:52.69,0:49:55.11,Default,,0,0,0,,Кетуге аз қалды, кездескенше.
Dialogue: 0,0:49:57.45,0:49:58.95,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:50:01.33,0:50:03.20,Default,,0,0,0,,Әрқашан күліп жүр!
Dialogue: 0,0:50:03.29,0:50:06.37,Default,,0,0,0,,Ешкім менің күйзеліске түскенімді көргісі келмейді.
Dialogue: 0,0:50:12.88,0:50:17.88,Default,,0,0,0,,♪ «Күлкі пішіні»
Dialogue: 0,0:50:51.50,0:50:53.34,Default,,0,0,0,,А, попон - бұл попон! Болды
Dialogue: 0,0:50:53.42,0:50:57.05,Default,,0,0,0,,Дан-дан-дан-дан-н-а-ва-до
Dialogue: 0,0:50:57.13,0:51:00.34,Default,,0,0,0,,Дан-дан-дан-дан-н-а-ва-до
Dialogue: 0,0:51:00.43,0:51:01.39,Default,,0,0,0,,дегеніміз не?
Dialogue: 0,0:51:01.47,0:51:03.18,Default,,0,0,0,,Тағы бір рет! Ана жерде! Дандан...
Dialogue: 0,0:51:03.26,0:51:04.31,Default,,0,0,0,,Әй?
Dialogue: 0,0:51:06.27,0:51:08.23,Default,,0,0,0,,-Эй - (Ариана) Не?
Dialogue: 0,0:51:08.31,0:51:11.27,Default,,0,0,0,,Көңіліңіз түскенде тәтті нәрсе жеңіз.
Dialogue: 0,0:51:11.35,0:51:13.73,Default,,0,0,0,,Өзіңізді әбден алдағаныңыз дұрыс
Dialogue: 0,0:51:13.82,0:51:15.19,Default,,0,0,0,,Ка-чан осылай деді.
Dialogue: 0,0:51:15.28,0:51:17.78,Default,,0,0,0,,Бол... Мен ерекше күйзелмеймін.
Dialogue: 0,0:51:17.86,0:51:20.20,Default,,0,0,0,,Иә? Сіз тілді түсінесіз бе?
Dialogue: 0,0:51:20.28,0:51:22.53,Default,,0,0,0,,Ора, сен үнді тілінде сөйлейсің бе?
Dialogue: 0,0:51:22.62,0:51:24.28,Default,,0,0,0,,Сіз данышпансыз!
Dialogue: 0,0:51:24.37,0:51:26.79,Default,,0,0,0,,Мен жапон тілінде сөйлеймін!
Dialogue: 0,0:51:26.87,0:51:29.75,Default,,0,0,0,,Мен жапон анимелерін жақсы көремін, сондықтан оны зерттедім.
Dialogue: 0,0:51:29.83,0:51:32.67,Default,,0,0,0,,Жарқырау! Менің сүйікті сезімім!
Dialogue: 0,0:51:32.75,0:51:35.71,Default,,0,0,0,,Толқын! Достық, махаббат, өзін-өзі бағалау!
Dialogue: 0,0:51:35.84,0:51:38.17,Default,,0,0,0,,Бритт! Bribri Cure!
Dialogue: 0,0:51:38.26,0:51:40.80,Default,,0,0,0,,Уау! Ақыр соңында, сіз білесіз!
Dialogue: 0,0:51:40.88,0:51:42.80,Default,,0,0,0,,Күнбағыстарды бірге тамашалау
Dialogue: 0,0:51:42.89,0:51:44.64,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:51:44.72,0:51:45.68,Default,,0,0,0,,Аха!
Dialogue: 0,0:51:45.76,0:51:46.97,Default,,0,0,0,,Қарапайым қыз
Dialogue: 0,0:51:47.10,0:51:49.39,Default,,0,0,0,,Өзімнің де, өзгенің де бақыты үшін
Dialogue: 0,0:51:49.48,0:51:53.56,Default,,0,0,0,,Достарыммен бірге кез келген қиындыққа тап боламын!
Dialogue: 0,0:51:54.94,0:51:56.86,Default,,0,0,0,,Бритт!
Dialogue: 0,0:51:56.94,0:51:58.40,Default,,0,0,0,,...
Dialogue: 0,0:51:58.49,0:52:01.03,Default,,0,0,0,,Керемет! керемет!
Dialogue: 0,0:52:01.11,0:52:03.20,Default,,0,0,0,,Ора Брит! Шинносукені емдеңіз!
Dialogue: 0,0:52:03.28,0:52:06.12,Default,,0,0,0,,Мен тамашамын! Ариананы емдеңіз!
Dialogue: 0,0:52:06.20,0:52:07.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:08.12,0:52:10.04,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:52:10.12,0:52:13.50,Default,,0,0,0,,Мен Орабо-чанды және басқаларды іздеп жүрмін.
Dialogue: 0,0:52:14.67,0:52:16.46,Default,,0,0,0,,Бо-чан?
Dialogue: 0,0:52:17.50,0:52:20.17,Default,,0,0,0,,Уф... енді жоқ
Dialogue: 0,0:52:20.26,0:52:22.30,Default,,0,0,0,,Үндістанда адасу...
Dialogue: 0,0:52:22.38,0:52:26.72,Default,,0,0,0,,Тілді түсінбесем де, ақшам жоқ болса да...
Dialogue: 0,0:52:26.81,0:52:29.18,Default,,0,0,0,,Бітті... Уф...
Dialogue: 0,0:52:29.27,0:52:31.52,Default,,0,0,0,,Кун
Dialogue: 0,0:52:32.19,0:52:34.35,Default,,0,0,0,,Энн! Энн! Энн!
Dialogue: 0,0:52:34.44,0:52:37.52,Default,,0,0,0,,Жалғыз қалсам да не істерімді білмеймін
Dialogue: 0,0:52:37.61,0:52:40.28,Default,,0,0,0,,Мен итімді де қарай алмаймын.
Dialogue: 0,0:52:40.36,0:52:42.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:42.24,0:52:45.62,Default,,0,0,0,,Гаруруру…
Dialogue: 0,0:52:46.41,0:52:48.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:49.91,0:52:51.79,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:52:51.87,0:52:53.50,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:52:53.58,0:52:55.83,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:52:57.38,0:52:58.96,Default,,0,0,0,,Энн! Энн!
Dialogue: 0,0:53:00.34,0:53:02.76,Default,,0,0,0,,-Ууу~! -сурет?
Dialogue: 0,0:53:08.72,0:53:10.22,Default,,0,0,0,,Хун!
Dialogue: 0,0:53:11.22,0:53:12.27,Default,,0,0,0,,Кун!
Dialogue: 0,0:53:19.02,0:53:20.69,Default,,0,0,0,,Хмф!
Dialogue: 0,0:53:30.87,0:53:31.79,Default,,0,0,0,,Хмф!
Dialogue: 0,0:53:33.29,0:53:35.92,Default,,0,0,0,,Энн! Энн! Энн! Бір…
Dialogue: 0,0:53:36.79,0:53:37.67,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:53:37.75,0:53:40.38,Default,,0,0,0,,...
Dialogue: 0,0:53:41.55,0:53:44.22,Default,,0,0,0,,...
Dialogue: 0,0:53:44.30,0:53:46.68,Default,,0,0,0,,(Қаңғыбас иттердің үрейлі дауыстары)
Dialogue: 0,0:53:46.76,0:53:50.43,Default,,0,0,0,,...
Dialogue: 0,0:53:50.51,0:53:53.31,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:53:53.39,0:53:54.68,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:53:54.77,0:53:55.77,Default,,0,0,0,,Уф!
Dialogue: 0,0:53:55.85,0:53:58.81,Default,,0,0,0,,Мен Широпайсеннің соңынан еремін!
Dialogue: 0,0:53:58.90,0:54:00.40,Default,,0,0,0,,Ааанан?
Dialogue: 0,0:54:03.61,0:54:07.07,Default,,0,0,0,,(Бо Чанның гуілдеуі)
Dialogue: 0,0:54:18.04,0:54:21.92,Default,,0,0,0,,Бо Чан мен Шин Чанның анасы мен әкесі қайда?
Dialogue: 0,0:54:22.59,0:54:23.88,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:54:40.90,0:54:44.03,Default,,0,0,0,,Ух... Шинносуке~
Dialogue: 0,0:54:44.11,0:54:46.24,Default,,0,0,0,,Масао-кун Широ...
Dialogue: 0,0:54:46.32,0:54:48.28,Default,,0,0,0,,(жұтатын дыбыс)
Dialogue: 0,0:54:48.36,0:54:51.32,Default,,0,0,0,,үшінңыз аман болыңыздар.
Dialogue: 0,0:54:51.41,0:54:53.20,Default,,0,0,0,,Аскөк…
Dialogue: 0,0:54:53.28,0:54:56.75,Default,,0,0,0,,Ересектер карри дайындауға міндетті.
Dialogue: 0,0:55:02.42,0:55:04.13,Default,,0,0,0,,Бо Чан, сен не істеп жатырсың?
Dialogue: 0,0:55:04.21,0:55:06.21,Default,,0,0,0,,(Бо Чанның гуілдеуі)
Dialogue: 0,0:55:06.30,0:55:09.22,Default,,0,0,0,,Фестивальге дайындалу туралы шешім қабылданды, солай ма?
Dialogue: 0,0:55:09.30,0:55:13.01,Default,,0,0,0,,Менің киімім, әнім
Dialogue: 0,0:55:14.39,0:55:15.89,Default,,0,0,0,,Хехе...
Dialogue: 0,0:55:15.97,0:55:18.81,Default,,0,0,0,,үшінн өз ақшаммен дайындадым
Dialogue: 0,0:55:18.89,0:55:22.11,Default,,0,0,0,,Уайымдамаңыз, бұл арзан.
Dialogue: 0,0:55:22.19,0:55:25.44,Default,,0,0,0,,Өйткені Уэль Боның жалғыз және жалғыз серіктесі.
Dialogue: 0,0:55:26.61,0:55:28.15,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:55:30.07,0:55:32.16,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:55:35.41,0:55:39.25,Default,,0,0,0,,Бо Чан, мұрныңыздағы «қағазды» көрдіңіз бе.
Dialogue: 0,0:55:39.33,0:55:41.33,Default,,0,0,0,,Жақында оны тіксем қалай болады?
Dialogue: 0,0:55:41.42,0:55:43.50,Default,,0,0,0,,Егер сіз оны көрсете берсеңіз, қауіпті болады...
Dialogue: 0,0:55:43.59,0:55:44.88,Default,,0,0,0,,Жаман емес
Dialogue: 0,0:55:44.96,0:55:47.46,Default,,0,0,0,,Мен тамаша жұмыс істеп жатырмын!
Dialogue: 0,0:55:47.55,0:55:49.92,Default,,0,0,0,,Бо-чан! Шин-чан мен Масао-кун туралы
Dialogue: 0,0:55:50.01,0:55:52.18,Default,,0,0,0,,Сіз уайымдамайсыз ба?
Dialogue: 0,0:55:58.98,0:55:59.85,Default,,0,0,0,,-Шин-чан! -(Казама-кун) Шинносуке!?
Dialogue: 0,0:55:59.93,0:56:01.81,Default,,0,0,0,,Микка!
Dialogue: 0,0:56:05.69,0:56:07.28,Default,,0,0,0,,Сіз өте жігерлі көрінесіз!
Dialogue: 0,0:56:07.36,0:56:09.86,Default,,0,0,0,,Жақсы, Шинносуке, сен амансың.
Dialogue: 0,0:56:09.94,0:56:11.36,Default,,0,0,0,,Бұл не, Бо Чан?
Dialogue: 0,0:56:11.45,0:56:14.62,Default,,0,0,0,,Шын Чанды және басқаларды шынымен іздеп жүр едің.
Dialogue: 0,0:56:14.70,0:56:16.08,Default,,0,0,0,,Тез айтшы~
Dialogue: 0,0:56:19.16,0:56:21.75,Default,,0,0,0,,«Қағаз» Микке
Dialogue: 0,0:56:21.83,0:56:23.00,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:56:23.08,0:56:24.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:24.54,0:56:26.50,Default,,0,0,0,,Тоқта, Шин Чан!
Dialogue: 0,0:56:26.59,0:56:27.42,Default,,0,0,0,,(қосқышты басқан дыбыс)
Dialogue: 0,0:56:27.50,0:56:29.84,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,0:56:41.02,0:56:44.73,Default,,0,0,0,,Басқаша айтқанда, Бо-чан деген бала «қағазды» мұрнына тығып алды.
Dialogue: 0,0:56:44.81,0:56:47.69,Default,,0,0,0,,Кез келген тілекті жүзеге асыра алатын орасан зор күш
Dialogue: 0,0:56:47.77,0:56:49.57,Default,,0,0,0,,Сіз түсіндіңіз бе?
Dialogue: 0,0:56:49.65,0:56:52.32,Default,,0,0,0,,Мүмкін, әрине, союкото
Dialogue: 0,0:56:52.40,0:56:53.78,Default,,0,0,0,,Хмм…
Dialogue: 0,0:56:53.86,0:56:55.87,Default,,0,0,0,,Ш…
Dialogue: 0,0:56:55.95,0:56:57.83,Default,,0,0,0,,Ха…
Dialogue: 0,0:56:58.74,0:57:03.46,Default,,0,0,0,,Егер менің кез келген істі орындауға күшім жетсе
Dialogue: 0,0:57:03.54,0:57:05.38,Default,,0,0,0,,Шинносуке не істер еді?
Dialogue: 0,0:57:05.46,0:57:06.29,Default,,0,0,0,,Әй?
Dialogue: 0,0:57:07.17,0:57:08.63,Default,,0,0,0,,Ола...
Dialogue: 0,0:57:09.38,0:57:11.09,Default,,0,0,0,,- Дауыл! -(Ариана) А?
Dialogue: 0,0:57:11.17,0:57:14.97,Default,,0,0,0,,Қалғандары жалқаулап, шалқалап жүр.
Dialogue: 0,0:57:15.05,0:57:16.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:57:17.60,0:57:19.89,Default,,0,0,0,,Шинносукеге «қағаз» керек пе?
Dialogue: 0,0:57:19.97,0:57:20.81,Default,,0,0,0,,(ұшқышсыз ұшақтың дыбысы)
Dialogue: 0,0:57:20.89,0:57:23.27,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:57:31.69,0:57:34.11,Default,,0,0,0,,Қазір! Бұл не!?
Dialogue: 0,0:57:35.53,0:57:36.57,Default,,0,0,0,,Шин-чан
Dialogue: 0,0:57:36.66,0:57:37.91,Default,,0,0,0,,Бо-чан!?
Dialogue: 0,0:57:37.99,0:57:39.62,Default,,0,0,0,,Фестиваль басталып жатыр
Dialogue: 0,0:57:39.70,0:57:42.08,Default,,0,0,0,,Қазір! Мен оны іздедім
Dialogue: 0,0:57:42.16,0:57:44.75,Default,,0,0,0,,Уайымдама, мен Шин-Чанға қамқор боламын.
Dialogue: 0,0:57:44.83,0:57:47.79,Default,,0,0,0,,Мен сені аман-есен осында апарамын.
Dialogue: 0,0:57:47.88,0:57:50.67,Default,,0,0,0,,Сонда сізде «қағаз» бар ма?
Dialogue: 0,0:57:50.75,0:57:51.63,Default,,0,0,0,,Е...
Dialogue: 0,0:57:51.71,0:57:53.84,Default,,0,0,0,,Хана Джелина Джоли Бұл дұрыс па?
Dialogue: 0,0:57:53.92,0:57:55.09,Default,,0,0,0,,Не болып жатыр? Бұл
Dialogue: 0,0:57:55.18,0:57:58.18,Default,,0,0,0,,Бо-чан, ішінде емес пе?
Dialogue: 0,0:57:58.26,0:57:59.76,Default,,0,0,0,,Қосылмаған
Dialogue: 0,0:57:59.85,0:58:01.89,Default,,0,0,0,,Ол бар ма? «Қағаз»
Dialogue: 0,0:58:01.97,0:58:03.35,Default,,0,0,0,,Минмин семинары
Dialogue: 0,0:58:03.43,0:58:04.68,Default,,0,0,0,,Су
Dialogue: 0,0:58:04.77,0:58:05.89,Default,,0,0,0,,Мицуами
Dialogue: 0,0:58:05.98,0:58:06.90,Default,,0,0,0,,Мими
Dialogue: 0,0:58:06.98,0:58:08.10,Default,,0,0,0,,Мигимими
Dialogue: 0,0:58:08.19,0:58:09.81,Default,,0,0,0,,Ми Ми…
Dialogue: 0,0:58:09.90,0:58:12.57,Default,,0,0,0,,Сонымен... бұл ширитори ойнайтын уақыт емес!
Dialogue: 0,0:58:12.65,0:58:14.65,Default,,0,0,0,,Иә? Жақсы
Dialogue: 0,0:58:14.74,0:58:17.28,Default,,0,0,0,,Үндістандағы ең жақсысы! Даньявадо!
Dialogue: 0,0:58:17.36,0:58:19.37,Default,,0,0,0,,- (Бо-чан) «Қағаз»! - (Нене-чан мен Казама-кун) Ах!
Dialogue: 0,0:58:19.45,0:58:21.49,Default,,0,0,0,,Уау! Тотто Тотто Тотто…
Dialogue: 0,0:58:23.33,0:58:25.54,Default,,0,0,0,,«Қағаз» Сізде дұрыс.
Dialogue: 0,0:58:25.62,0:58:28.08,Default,,0,0,0,,Шин-чан, сен айттың.
Dialogue: 0,0:58:28.17,0:58:31.00,Default,,0,0,0,,Оны қалаған кезде пайдалана аласыз.
Dialogue: 0,0:58:31.09,0:58:32.96,Default,,0,0,0,,Қазір уақыт.
Dialogue: 0,0:58:33.05,0:58:35.80,Default,,0,0,0,,Маған «қағаз» керек
Dialogue: 0,0:58:35.88,0:58:37.38,Default,,0,0,0,,Маған «қағаз» керек
Dialogue: 0,0:58:37.47,0:58:38.97,Default,,0,0,0,,Маған «қағаз» керек
Dialogue: 0,0:58:39.05,0:58:39.89,Default,,0,0,0,,Маған «қағаз» керек
Dialogue: 0,0:58:39.97,0:58:41.89,Default,,0,0,0,,Бо-чан?
Dialogue: 0,0:58:41.97,0:58:42.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:58:42.93,0:58:43.85,Default,,0,0,0,,Шин-чан
Dialogue: 0,0:58:44.47,0:58:46.31,Default,,0,0,0,,«Қағаз» өтінемін!
Dialogue: 0,0:58:46.98,0:58:49.48,Default,,0,0,0,,Уф! Нигеро! Шинносуке!
Dialogue: 0,0:58:51.36,0:58:52.69,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:58:52.77,0:58:54.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:56.11,0:58:57.82,Default,,0,0,0,,- (Бо-чан) Әй! - (Казама-кун) Уау!
Dialogue: 0,0:58:58.91,0:58:59.82,Default,,0,0,0,,Казама-кун!?
Dialogue: 0,0:59:01.95,0:59:03.79,Default,,0,0,0,,Нигеро! Шинносуке!
Dialogue: 0,0:59:03.87,0:59:05.50,Default,,0,0,0,,-Ах... -(Казама-кун) Бо-чанға «қағаз» бер
Dialogue: 0,0:59:05.58,0:59:06.96,Default,,0,0,0,,Мен емес!
Dialogue: 0,0:59:07.04,0:59:09.17,Default,,0,0,0,,Оны алыс жерге тастаңыз!
Dialogue: 0,0:59:09.25,0:59:10.79,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:59:10.88,0:59:13.17,Default,,0,0,0,,Тоқта! Жіберу!
Dialogue: 0,0:59:13.25,0:59:15.00,Default,,0,0,0,,Казама-кун!
Dialogue: 0,0:59:15.09,0:59:16.71,Default,,0,0,0,,Әй!
Dialogue: 0,0:59:18.76,0:59:20.89,Default,,0,0,0,,Ах! қауіпті!
Dialogue: 0,0:59:22.43,0:59:23.35,Default,,0,0,0,,Кедергі жасамаңыз!
Dialogue: 0,0:59:25.93,0:59:27.60,Default,,0,0,0,,Ариана-чан!
Dialogue: 0,0:59:34.15,0:59:34.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:36.82,0:59:37.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:59:37.90,0:59:39.20,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:59:39.28,0:59:40.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:41.61,0:59:42.74,Default,,0,0,0,,Әй!
Dialogue: 0,0:59:42.82,0:59:43.78,Default,,0,0,0,,Хоттото…
Dialogue: 0,0:59:43.87,0:59:44.78,Default,,0,0,0,,Иә!?
Dialogue: 0,0:59:46.20,0:59:47.62,Default,,0,0,0,,Әй!
Dialogue: 0,0:59:47.70,0:59:49.12,Default,,0,0,0,,Әй!
Dialogue: 0,1:00:04.14,1:00:06.01,Default,,0,0,0,,-Ух~ -(Ариана) Ия...
Dialogue: 0,1:00:06.10,1:00:07.10,Default,,0,0,0,,Ха!
Dialogue: 0,1:00:07.89,1:00:09.81,Default,,0,0,0,,Шинносуке! артта!
Dialogue: 0,1:00:10.35,1:00:12.73,Default,,0,0,0,,Бури Бури~!
Dialogue: 0,1:00:15.82,1:00:17.40,Default,,0,0,0,,Иә!
Dialogue: 0,1:00:17.48,1:00:20.11,Default,,0,0,0,,Біз BribriCure сияқтымыз!
Dialogue: 0,1:00:20.19,1:00:21.45,Default,,0,0,0,,Бұл рас!
Dialogue: 0,1:00:21.53,1:00:23.61,Default,,0,0,0,,Бритт! Bribri Cure!
Dialogue: 0,1:00:23.70,1:00:25.58,Default,,0,0,0,,Бұл Ариана емес пе?
Dialogue: 0,1:00:25.66,1:00:26.95,Default,,0,0,0,,Не? Ариана?
Dialogue: 0,1:00:27.04,1:00:28.24,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:28.91,1:00:30.04,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:30.12,1:00:32.00,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,1:00:32.08,1:00:34.54,Default,,0,0,0,,Ааах… Ааах… Ааах…
Dialogue: 0,1:00:41.01,1:00:42.34,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:45.18,1:00:47.06,Default,,0,0,0,,Ариана!
Dialogue: 0,1:00:47.14,1:00:48.68,Default,,0,0,0,,Ха…
Dialogue: 0,1:00:50.14,1:00:51.23,Default,,0,0,0,,Эй!
Dialogue: 0,1:00:57.02,1:00:59.73,Default,,0,0,0,,Шин Чан аяқталды!
Dialogue: 0,1:00:59.82,1:01:01.90,Default,,0,0,0,,Қалғаны – Масао-кун.
Dialogue: 0,1:01:01.99,1:01:04.03,Default,,0,0,0,,-Бұл жігітті не істеуіміз керек? -Жіберу!
Dialogue: 0,1:01:04.11,1:01:06.57,Default,,0,0,0,,Пиязды турасам ба?
Dialogue: 0,1:01:06.66,1:01:07.87,Default,,0,0,0,,Мені жіберіңізші
Dialogue: 0,1:01:07.95,1:01:10.16,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,1:01:10.24,1:01:11.87,Default,,0,0,0,,Иә
Dialogue: 0,1:01:13.58,1:01:15.25,Default,,0,0,0,,Амансың ба? Казама-кун!
Dialogue: 0,1:01:15.33,1:01:18.04,Default,,0,0,0,,Иә, ха ха...
Dialogue: 0,1:01:18.13,1:01:19.63,Default,,0,0,0,,Әй!
Dialogue: 0,1:01:20.51,1:01:22.76,Default,,0,0,0,,-(Бо-чан) Бо... -Бо-чан
Dialogue: 0,1:01:22.84,1:01:23.76,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,1:01:23.84,1:01:25.93,Default,,0,0,0,,Мына мұрыннан «қағазды» алып тастаңыз!
Dialogue: 0,1:01:26.01,1:01:28.76,Default,,0,0,0,,Сондықтан ол есінен танып жатыр!
Dialogue: 0,1:01:28.85,1:01:31.85,Default,,0,0,0,,Садақ Ештеңе дұрыс емес.
Dialogue: 0,1:01:31.93,1:01:33.43,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:33.52,1:01:35.23,Default,,0,0,0,,Білмедің бе?
Dialogue: 0,1:01:35.94,1:01:38.11,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,1:01:38.19,1:01:40.15,Default,,0,0,0,,Бұл менмін
Dialogue: 0,1:01:40.78,1:01:42.03,Default,,0,0,0,,Нене-чан!
Dialogue: 0,1:01:42.11,1:01:45.49,Default,,0,0,0,,Екеуі де сахналық киім киген
Dialogue: 0,1:01:45.57,1:01:48.24,Default,,0,0,0,,Фестиваль басталып жатыр~
Dialogue: 0,1:01:51.62,1:01:54.08,Default,,0,0,0,,Уф, иа!
Dialogue: 0,1:01:54.16,1:01:55.25,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:01:55.33,1:01:58.58,Default,,0,0,0,,Мен оны алып жүрудің қалай болатынын түсінемін.
Dialogue: 0,1:01:58.67,1:01:59.92,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:02:01.30,1:02:03.01,Default,,0,0,0,,Мен үйге бара жатқан сияқтымын
Dialogue: 0,1:02:03.09,1:02:04.88,Default,,0,0,0,,Осылай мініп жүре берсем, Бо Чанның орнында боламын.
Dialogue: 0,1:02:04.97,1:02:06.30,Default,,0,0,0,,Сіз келесіз бе?
Dialogue: 0,1:02:06.38,1:02:08.14,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,1:02:08.22,1:02:10.35,Default,,0,0,0,,Сонымен, айналасың ба?
Dialogue: 0,1:02:14.98,1:02:15.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:15.89,1:02:19.02,Default,,0,0,0,,Бұл Ариана ма?
Dialogue: 0,1:02:19.11,1:02:21.32,Default,,0,0,0,,Ариана жақсырақ қыз
Dialogue: 0,1:02:21.40,1:02:22.86,Default,,0,0,0,,Егер бұл Ариана болса, мен біраз көңілім қалар еді.
Dialogue: 0,1:02:22.94,1:02:23.78,Default,,0,0,0,,Бұл қандай поза?
Dialogue: 0,1:02:23.86,1:02:26.57,Default,,0,0,0,,Суреттен өзгеше
Dialogue: 0,1:02:26.65,1:02:28.82,Default,,0,0,0,,Ариана сияқты емес
Dialogue: 0,1:02:28.91,1:02:29.74,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:33.29,1:02:36.96,Default,,0,0,0,,(Синносуканың ұйқысы)
Dialogue: 0,1:02:43.21,1:02:47.01,Default,,0,0,0,,♪ «Күлкі пішіні»
Dialogue: 0,1:03:59.83,1:04:01.17,Default,,0,0,0,,Неге...
Dialogue: 0,1:04:01.25,1:04:04.79,Default,,0,0,0,,Бұл көңілді фестиваль болуы керек еді, бірақ...
Dialogue: 0,1:04:11.18,1:04:14.43,Default,,0,0,0,,Жарайды, бәрі жақсы болады.
Dialogue: 0,1:04:14.51,1:04:18.02,Default,,0,0,0,,Нене-чан, енді қолымыздан келгенін істейік.
Dialogue: 0,1:04:19.02,1:04:20.39,Default,,0,0,0,,Иә.
Dialogue: 0,1:04:27.53,1:04:30.11,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,1:04:31.99,1:04:33.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:34.03,1:04:35.95,Default,,0,0,0,,Шинносуке! Оян!
Dialogue: 0,1:04:36.03,1:04:36.87,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:38.87,1:04:41.58,Default,,0,0,0,,Мұнда не болып жатыр!?
Dialogue: 0,1:04:46.54,1:04:49.21,Default,,0,0,0,,Бұл Бо Чан...
Dialogue: 0,1:04:54.59,1:04:57.22,Default,,0,0,0,,Махараджабо ұсынады!
Dialogue: 0,1:04:57.31,1:04:59.81,Default,,0,0,0,,Ойын-сауық фестивалі!
Dialogue: 0,1:05:01.68,1:05:05.81,Default,,0,0,0,,♪ «БҰЛ BO!»
Dialogue: 0,1:06:42.95,1:06:44.45,Default,,0,0,0,,Бо…
Dialogue: 0,1:06:48.58,1:06:50.54,Default,,0,0,0,,Бо... хехе!
Dialogue: 0,1:06:50.63,1:06:52.50,Default,,0,0,0,,(Музыка тоқтайды)
Dialogue: 0,1:06:52.59,1:06:54.38,Default,,0,0,0,,(аудитория шуы)
Dialogue: 0,1:07:00.93,1:07:03.68,Default,,0,0,0,,Нене-чан, сен неге билемейсің?
Dialogue: 0,1:07:04.93,1:07:09.02,Default,,0,0,0,,Казама-кун, мен саған сахналық киіміңді ауыстыр дедім ғой, солай ма?
Dialogue: 0,1:07:10.77,1:07:14.61,Default,,0,0,0,,Сіз бәріміз бірге билейміз деп уәде бергенсіз.
Dialogue: 0,1:07:16.69,1:07:17.74,Default,,0,0,0,,Би
Dialogue: 0,1:07:17.82,1:07:18.99,Default,,0,0,0,,Наразылық!
Dialogue: 0,1:07:19.07,1:07:20.70,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,1:07:20.78,1:07:23.49,Default,,0,0,0,,Мен саған айтамын, өйткені біз доспыз
Dialogue: 0,1:07:23.58,1:07:26.37,Default,,0,0,0,,Адамдардың сезімдері сіз қалағандай болмайды.
Dialogue: 0,1:07:26.45,1:07:30.04,Default,,0,0,0,,Біз ешкімнің бізді қорқытуына жол бермейміз.
Dialogue: 0,1:07:31.21,1:07:32.75,Default,,0,0,0,,Егер сіз билемесеңіз
Dialogue: 0,1:07:32.84,1:07:35.71,Default,,0,0,0,,Пиязды кесектерге кесуге болады ма?
Dialogue: 0,1:07:35.80,1:07:37.42,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:37.51,1:07:38.88,Default,,0,0,0,,Казама-кун!
Dialogue: 0,1:07:38.97,1:07:40.84,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,1:07:40.93,1:07:43.30,Default,,0,0,0,,Тоору-чан!
Dialogue: 0,1:07:43.39,1:07:45.18,Default,,0,0,0,,- (Бо-чан) Бо!? - (Нене-чан мен Казама-кун) Иә!?
Dialogue: 0,1:07:45.26,1:07:48.68,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:48.77,1:07:49.60,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,1:07:49.69,1:07:51.31,Default,,0,0,0,,-Шин-чан! -(Казама-кун) Шинносуке!?
Dialogue: 0,1:07:51.40,1:07:52.69,Default,,0,0,0,,Жылы...
Dialogue: 0,1:07:52.77,1:07:53.73,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:07:53.81,1:07:55.52,Default,,0,0,0,,Даниявард
Dialogue: 0,1:07:55.61,1:07:58.32,Default,,0,0,0,,Неліктен ол қалыпты түрде көріне алмайды?
Dialogue: 0,1:07:58.40,1:08:00.53,Default,,0,0,0,,Сәлем! Не әкелдің?
Dialogue: 0,1:08:00.61,1:08:03.03,Default,,0,0,0,,Мен саған оны алыс жерге қалдыр дедім!
Dialogue: 0,1:08:03.12,1:08:05.45,Default,,0,0,0,,Сіз Ханагеринадан бас тарта алмайсыз, солай ма?
Dialogue: 0,1:08:05.53,1:08:07.24,Default,,0,0,0,,Казама-кун Доихи~
Dialogue: 0,1:08:07.33,1:08:09.33,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,1:08:09.41,1:08:11.12,Default,,0,0,0,,Браво!
Dialogue: 0,1:08:12.96,1:08:14.46,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,1:08:14.54,1:08:16.13,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,1:08:16.21,1:08:17.51,Default,,0,0,0,,Фестивальге қош келдіңіздер
Dialogue: 0,1:08:17.59,1:08:20.05,Default,,0,0,0,,Бо-чан, мен қарап тұрған жоқпын
Dialogue: 0,1:08:20.13,1:08:22.01,Default,,0,0,0,,Атмосфера әйтеуір өзгерді.
Dialogue: 0,1:08:22.09,1:08:25.01,Default,,0,0,0,,Балалар тез өседі
Dialogue: 0,1:08:25.10,1:08:28.22,Default,,0,0,0,,Шин-чан, сен маған «қағазды» бере аласың ба?
Dialogue: 0,1:08:28.31,1:08:29.48,Default,,0,0,0,,Және…
Dialogue: 0,1:08:29.56,1:08:31.69,Default,,0,0,0,,Бәріміз бірге билейік!
Dialogue: 0,1:08:31.77,1:08:34.73,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:08:35.98,1:08:37.36,Default,,0,0,0,,Бо-чан!
Dialogue: 0,1:08:37.44,1:08:38.82,Default,,0,0,0,,Шин-чан
Dialogue: 0,1:08:38.90,1:08:39.82,Default,,0,0,0,,Бо-чан!
Dialogue: 0,1:08:39.90,1:08:40.82,Default,,0,0,0,,Шин-чан
Dialogue: 0,1:08:40.90,1:08:44.03,Default,,0,0,0,,Мен Бо Чанның мұрнын көргім келеді!
Dialogue: 0,1:08:44.11,1:08:45.66,Default,,0,0,0,,Мұрыннан су ағу қазірдің өзінде...
Dialogue: 0,1:08:45.74,1:08:47.74,Default,,0,0,0,,- Қазір! -(Бо-чан) Жуып кетпе.
Dialogue: 0,1:08:47.83,1:08:49.66,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:08:49.75,1:08:51.41,Default,,0,0,0,,«Маған қағаз беріңіз»
Dialogue: 0,1:08:51.50,1:08:52.92,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,1:08:53.00,1:08:54.63,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:08:54.71,1:08:55.96,Default,,0,0,0,,Тағзым!
Dialogue: 0,1:08:56.54,1:08:59.00,Default,,0,0,0,,Ух... ха ха ха ха...
Dialogue: 0,1:08:59.09,1:09:00.51,Default,,0,0,0,,Boh!
Dialogue: 0,1:09:01.13,1:09:02.34,Default,,0,0,0,,- (Бо-чан) Бо! -Апыр-ай!
Dialogue: 0,1:09:03.43,1:09:05.80,Default,,0,0,0,,Бұл «қағаздың» күші ме?
Dialogue: 0,1:09:05.89,1:09:09.06,Default,,0,0,0,,-Шин-чан! -(Казама-кун) Шинносуке Осылай!
Dialogue: 0,1:09:10.56,1:09:11.77,Default,,0,0,0,,Тағзым!
Dialogue: 0,1:09:12.43,1:09:15.73,Default,,0,0,0,,Сол «қағазды» менің бос сол жақ танауыма сал.
Dialogue: 0,1:09:15.81,1:09:17.11,Default,,0,0,0,,Маған кіруге рұқсат бере аласыз ба?
Dialogue: 0,1:09:17.19,1:09:20.57,Default,,0,0,0,,Бо-чан! Ола, бұл мүлдем қызық емес!
Dialogue: 0,1:09:20.65,1:09:24.28,Default,,0,0,0,,Бо... қызық емес пе?
Dialogue: 0,1:09:24.36,1:09:25.95,Default,,0,0,0,,Ш…
Dialogue: 0,1:09:26.03,1:09:29.24,Default,,0,0,0,,Бұл қуат жеткіліксіз.
Dialogue: 0,1:09:29.33,1:09:31.87,Default,,0,0,0,,Тілегіңді жүзеге асырғың келсе
Dialogue: 0,1:09:31.95,1:09:34.08,Default,,0,0,0,,Қуатты алыңыз!
Dialogue: 0,1:09:34.17,1:09:36.58,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,1:09:39.04,1:09:40.71,Default,,0,0,0,,Шин-чан
Dialogue: 0,1:09:40.80,1:09:43.63,Default,,0,0,0,,Жоқ, Шинносуке Нохара!
Dialogue: 0,1:09:43.72,1:09:44.59,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:44.68,1:09:46.76,Default,,0,0,0,,«Қағазды» тапсыру
Dialogue: 0,1:09:46.84,1:09:48.10,Default,,0,0,0,,Бо-чан?
Dialogue: 0,1:09:48.18,1:09:50.93,Default,,0,0,0,,Бұл көңілді ме? Бұл қызық емес пе?
Dialogue: 0,1:09:51.02,1:09:53.52,Default,,0,0,0,,редактор ретінде,
Dialogue: 0,1:09:53.60,1:09:56.06,Default,,0,0,0,,Маған «қағаз» керек
Dialogue: 0,1:09:56.15,1:10:00.77,Default,,0,0,0,,«Қағазды» алып, мінсіз мен бол!
Dialogue: 0,1:10:02.99,1:10:04.74,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,1:10:04.82,1:10:06.28,Default,,0,0,0,,...
Dialogue: 0,1:10:06.36,1:10:07.20,Default,,0,0,0,,Широ!?
Dialogue: 0,1:10:07.28,1:10:09.37,Default,,0,0,0,,Энн Энн!
Dialogue: 0,1:10:09.45,1:10:10.62,Default,,0,0,0,,Бір!
Dialogue: 0,1:10:11.45,1:10:13.16,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:13.25,1:10:14.87,Default,,0,0,0,,Масао-кун!?
Dialogue: 0,1:10:14.96,1:10:16.50,Default,,0,0,0,,Ум!
Dialogue: 0,1:10:18.71,1:10:21.92,Default,,0,0,0,,-Анн Энн... -Бір-бір...
Dialogue: 0,1:10:22.00,1:10:23.80,Default,,0,0,0,,Хмф!
Dialogue: 0,1:10:29.30,1:10:30.68,Default,,0,0,0,,Мұрныңызды шайыңыз!?
Dialogue: 0,1:10:31.51,1:10:33.39,Default,,0,0,0,,Керемет нәрсе болып жатыр!
Dialogue: 0,1:10:33.47,1:10:35.85,Default,,0,0,0,,Қарғыс атсын... Масао осында!
Dialogue: 0,1:10:35.94,1:10:37.65,Default,,0,0,0,,- (Ариана) Ой! -(Бо-чан) Бо!?
Dialogue: 0,1:10:37.73,1:10:39.61,Default,,0,0,0,,Соңында соққы алмасқан адамның сен болғаныңа қуаныштымын
Dialogue: 0,1:10:39.69,1:10:41.57,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:10:43.61,1:10:46.28,Default,,0,0,0,,- (Казама-кун) Енді! Қашайық! -Иә
Dialogue: 0,1:10:52.79,1:10:56.16,Default,,0,0,0,,Шинносуке Нохараны ұстау үшін бар күшіңізді салыңыз!
Dialogue: 0,1:10:56.25,1:10:57.75,Default,,0,0,0,,Өлтіруші аң
Dialogue: 0,1:10:57.83,1:11:01.13,Default,,0,0,0,,Ұрыс режимінің MAX деңгейі!
Dialogue: 0,1:11:04.80,1:11:08.76,Default,,0,0,0,,Өсіре айтып жатырсың, сен бала емессің бе?
Dialogue: 0,1:11:08.84,1:11:10.72,Default,,0,0,0,,Шинносуке Нохараға жеңіл қарамаңыз
Dialogue: 0,1:11:10.72,1:11:11.55,Default,,0,0,0,,Шинносуке Нохараға жеңіл қарамаңыз
Dialogue: 0,1:11:10.72,1:11:11.55,Default,,0,0,0,,Әй?
Dialogue: 0,1:11:11.64,1:11:13.43,Default,,0,0,0,,Шинносуке Нохара
Dialogue: 0,1:11:13.51,1:11:18.02,Default,,0,0,0,,Дауылды дауылмен көтеріңіз, Тәртіпті бөкселеріңізбен бұзыңыз
Dialogue: 0,1:11:18.10,1:11:21.23,Default,,0,0,0,,Әрқашан «қағаз» алыңыз
Dialogue: 0,1:11:25.57,1:11:28.11,Default,,0,0,0,,Шинносуке Бұл бала кім?
Dialogue: 0,1:11:28.20,1:11:30.07,Default,,0,0,0,,Бұл Ариана
Dialogue: 0,1:11:30.16,1:11:31.07,Default,,0,0,0,,Гааах!
Dialogue: 0,1:11:40.62,1:11:42.54,Default,,0,0,0,,- (Казама-кун) Ха! -Ой...
Dialogue: 0,1:11:48.59,1:11:52.55,Default,,0,0,0,,Ха~ ха ха ха ха...
Dialogue: 0,1:11:52.64,1:11:53.93,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,1:11:55.01,1:11:57.18,Default,,0,0,0,,Масао-кун, сен не итке айналасың?
Dialogue: 0,1:11:57.27,1:11:58.27,Default,,0,0,0,,Иә!?
Dialogue: 0,1:11:58.35,1:12:00.52,Default,,0,0,0,,Ит болмай өмір сүре алмайтын адамның сезімі
Dialogue: 0,1:12:00.60,1:12:02.90,Default,,0,0,0,,Шин Чан түсінбейді!
Dialogue: 0,1:12:02.98,1:12:07.32,Default,,0,0,0,,Бо Чанның мұрнындағы «қағаз» барған сайын тереңдеп барады.
Dialogue: 0,1:12:07.40,1:12:08.82,Default,,0,0,0,,Тез тікпесең...
Dialogue: 0,1:12:08.90,1:12:11.70,Default,,0,0,0,,Бұл Бо Чанға ұқсамайды.
Dialogue: 0,1:12:11.78,1:12:13.99,Default,,0,0,0,,Бо Чан сабырлырақ.
Dialogue: 0,1:12:14.07,1:12:15.16,Default,,0,0,0,,Мейірімдірек
Dialogue: 0,1:12:15.24,1:12:18.04,Default,,0,0,0,,Ол бәрінің қамын ойлайтын жақсы бала...
Dialogue: 0,1:12:18.12,1:12:19.66,Default,,0,0,0,,Бо-чанның мұрны жоқ...
Dialogue: 0,1:12:19.75,1:12:22.12,Default,,0,0,0,,Бұл Бо Чан емес!
Dialogue: 0,1:12:22.21,1:12:25.13,Default,,0,0,0,,Бо-чан үнемі мұрыннан су ағуы керек пе?
Dialogue: 0,1:12:25.21,1:12:26.46,Default,,0,0,0,,Әй?
Dialogue: 0,1:12:26.55,1:12:28.71,Default,,0,0,0,,Бо-чан болу қандай?
Dialogue: 0,1:12:28.80,1:12:32.05,Default,,0,0,0,,Мен мейірімді және әрқашан жақсы болуым керек пе?
Dialogue: 0,1:12:32.13,1:12:36.35,Default,,0,0,0,,Бұл әркім өз бетінше шешкен емес пе?
Dialogue: 0,1:12:36.43,1:12:38.56,Default,,0,0,0,,Мен тіпті көңілді болмасам да
Dialogue: 0,1:12:38.64,1:12:41.73,Default,,0,0,0,,Біреуге жымиып, өзіңізді ұстауыңыз керек емес пе?
Dialogue: 0,1:12:41.81,1:12:44.23,Default,,0,0,0,,Мен тітіркенемін
Dialogue: 0,1:12:44.31,1:12:45.86,Default,,0,0,0,,Тіпті қорқып, жылағым келген кезде де
Dialogue: 0,1:12:45.94,1:12:48.19,Default,,0,0,0,,Мен жақсы болып көрініп, күліп жүруім керек пе!?
Dialogue: 0,1:12:50.03,1:12:51.53,Default,,0,0,0,,Мен қызғанамын
Dialogue: 0,1:12:51.61,1:12:52.91,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,1:12:52.99,1:12:56.83,Default,,0,0,0,,Мен осылайша барлығының қолдауын сезінбесе болмайды.
Dialogue: 0,1:12:57.74,1:12:59.54,Default,,0,0,0,,Тіпті жақсы қыз болмасаң да
Dialogue: 0,1:12:59.62,1:13:01.58,Default,,0,0,0,,Мүмкін мен қазір әлдеқайда бақытты шығармын...
Dialogue: 0,1:13:01.66,1:13:03.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:03.21,1:13:05.08,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:05.75,1:13:08.05,Default,,0,0,0,,Жоқ, иә...
Dialogue: 0,1:13:08.75,1:13:10.26,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:13:11.09,1:13:13.01,Default,,0,0,0,,Бо Чан бақытты ма?
Dialogue: 0,1:13:13.09,1:13:15.68,Default,,0,0,0,,Мұрынсыз Бо-чан?
Dialogue: 0,1:13:16.51,1:13:17.97,Default,,0,0,0,,Бо-чан бақытты болса
Dialogue: 0,1:13:18.06,1:13:21.81,Default,,0,0,0,,Бұл «қағазды» тікпеген дұрыс дегенді білдіре ме?
Dialogue: 0,1:13:21.89,1:13:22.73,Default,,0,0,0,,Хмм.
Dialogue: 0,1:13:22.81,1:13:26.61,Default,,0,0,0,,Бо-чан туралы не білеміз?
Dialogue: 0,1:13:26.69,1:13:29.73,Default,,0,0,0,,(робо иттің қадамдары)
Dialogue: 0,1:13:37.28,1:13:39.45,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,1:13:39.54,1:13:41.16,Default,,0,0,0,,Мен қазір қашуым керек!
Dialogue: 0,1:13:48.13,1:13:49.29,Default,,0,0,0,,Хмм… Қалай?
Dialogue: 0,1:13:50.71,1:13:51.55,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:52.26,1:13:53.17,Default,,0,0,0,,Ересектер жоқ!
Dialogue: 0,1:13:53.26,1:13:54.80,Default,,0,0,0,,Сіз қашып кеттіңіз бе!?
Dialogue: 0,1:13:54.88,1:13:57.39,Default,,0,0,0,,Бірақ мен баламды тастап кетуім керек пе?
Dialogue: 0,1:13:58.10,1:14:00.14,Default,,0,0,0,,Бұл да рас.
Dialogue: 0,1:14:01.85,1:14:04.18,Default,,0,0,0,,Нггг... Уау!
Dialogue: 0,1:14:04.27,1:14:06.65,Default,,0,0,0,,-Уау! -(Бағыныңқылар) Уау!
Dialogue: 0,1:14:06.73,1:14:08.77,Default,,0,0,0,,Хмм... Эй!
Dialogue: 0,1:14:11.65,1:14:12.82,Default,,0,0,0,,Хмф!
Dialogue: 0,1:14:13.36,1:14:14.74,Default,,0,0,0,,Әй!
Dialogue: 0,1:14:14.82,1:14:16.82,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,1:14:18.62,1:14:20.45,Default,,0,0,0,,Уф... уф!
Dialogue: 0,1:14:21.41,1:14:22.91,Default,,0,0,0,,Көздер! Көздер!
Dialogue: 0,1:14:23.00,1:14:24.41,Default,,0,0,0,,Аха~
Dialogue: 0,1:14:24.50,1:14:26.71,Default,,0,0,0,,Міне болды! Кілт!
Dialogue: 0,1:14:26.79,1:14:27.62,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:14:33.38,1:14:36.18,Default,,0,0,0,,Біріншіден, біз Нене-чан мен Казама-кунға көмектесуіміз керек!
Dialogue: 0,1:14:36.26,1:14:37.09,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:38.59,1:14:40.51,Default,,0,0,0,,-Уау! -Аа...
Dialogue: 0,1:14:41.56,1:14:44.85,Default,,0,0,0,,Қашқын Орталық бақтың батыс жағындағы A16 өткелін тапты
Dialogue: 0,1:14:44.93,1:14:47.02,Default,,0,0,0,,Қайталанатын қашқын табылды
Dialogue: 0,1:14:48.65,1:14:49.48,Default,,0,0,0,,Уф...
Dialogue: 0,1:14:51.06,1:14:52.61,Default,,0,0,0,,Иә!
Dialogue: 0,1:14:52.69,1:14:55.49,Default,,0,0,0,,Бұл менің Үндістанда өсірілген шұлықтарым!
Dialogue: 0,1:14:56.45,1:14:58.45,Default,,0,0,0,,Келіңіздер!Мінеки біз!
Dialogue: 0,1:15:00.20,1:15:01.49,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:15:03.41,1:15:04.24,Default,,0,0,0,,Хмф!
Dialogue: 0,1:15:05.50,1:15:07.00,Default,,0,0,0,,Сен сондай ақымақсың ба!?
Dialogue: 0,1:15:07.08,1:15:08.71,Default,,0,0,0,,Менің шұлығым жараспайды!?
Dialogue: 0,1:15:08.79,1:15:11.34,Default,,0,0,0,,Мүмкін бұл менің көптен бері карри жасағанымнан шығар.
Dialogue: 0,1:15:11.42,1:15:13.17,Default,,0,0,0,,Дәмдеуіштер күңгірттікті кетіреді
Dialogue: 0,1:15:13.25,1:15:15.88,Default,,0,0,0,,Жағымды сәл ащы иіс!?
Dialogue: 0,1:15:15.96,1:15:18.01,Default,,0,0,0,,Мм... бұл өте жиіркенішті.
Dialogue: 0,1:15:18.09,1:15:20.26,Default,,0,0,0,,Бұл қорқынышты, дәмдеуіштер...
Dialogue: 0,1:15:22.68,1:15:24.26,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:28.02,1:15:30.23,Default,,0,0,0,,Балалар күтіп тұр.
Dialogue: 0,1:15:30.31,1:15:33.15,Default,,0,0,0,,Мен мұндай жерде отыра алмаймын.
Dialogue: 0,1:15:38.57,1:15:40.16,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,1:15:40.24,1:15:43.03,Default,,0,0,0,,Менің ішімде әлі ұйықтап жатқан күш...
Dialogue: 0,1:15:43.12,1:15:46.20,Default,,0,0,0,,Оян, Үндістанның күші!
Dialogue: 0,1:15:46.29,1:15:51.29,Default,,0,0,0,,♪ «Мисае Нохара өтіп жатыр»
Dialogue: 0,1:16:40.84,1:16:42.51,Default,,0,0,0,,-Кункун Энн! -Не болды!? Широ
Dialogue: 0,1:16:42.59,1:16:44.47,Default,,0,0,0,,...
Dialogue: 0,1:16:44.55,1:16:46.64,Default,,0,0,0,,Ақ Паисен!
Dialogue: 0,1:16:49.22,1:16:50.27,Default,,0,0,0,,Энн!
Dialogue: 0,1:16:50.35,1:16:51.27,Default,,0,0,0,,Широ!?
Dialogue: 0,1:16:51.35,1:16:52.35,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,1:16:55.19,1:16:56.06,Default,,0,0,0,,Энн Энн!
Dialogue: 0,1:16:56.15,1:16:57.23,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,1:16:57.32,1:16:59.15,Default,,0,0,0,,Энн Энн!
Dialogue: 0,1:16:59.90,1:17:01.11,Default,,0,0,0,,Широ!
Dialogue: 0,1:17:01.19,1:17:02.45,Default,,0,0,0,,Бір!
Dialogue: 0,1:17:02.53,1:17:03.66,Default,,0,0,0,,Масао-кун!?
Dialogue: 0,1:17:03.74,1:17:04.99,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:05.07,1:17:06.49,Default,,0,0,0,,Уф...
Dialogue: 0,1:17:07.12,1:17:08.74,Default,,0,0,0,,Масао-кун!
Dialogue: 0,1:17:08.83,1:17:12.00,Default,,0,0,0,,Анашым! Папа!
Dialogue: 0,1:17:12.08,1:17:14.67,Default,,0,0,0,,Мен қорықтым! Уау
Dialogue: 0,1:17:15.54,1:17:17.63,Default,,0,0,0,,-То-чан! -а!
Dialogue: 0,1:17:17.71,1:17:19.09,Default,,0,0,0,,Ка-чан!
Dialogue: 0,1:17:20.26,1:17:21.67,Default,,0,0,0,,Шинносуке!
Dialogue: 0,1:17:23.43,1:17:25.51,Default,,0,0,0,,Нене-чан, Казама-кун және Широ да!
Dialogue: 0,1:17:25.59,1:17:26.43,Default,,0,0,0,,Энн!
Dialogue: 0,1:17:26.51,1:17:28.85,Default,,0,0,0,,Аллаға шүкір бәрі аман.
Dialogue: 0,1:17:30.72,1:17:32.77,Default,,0,0,0,,Мо~ То-чан мен Ка-чан да
Dialogue: 0,1:17:32.85,1:17:34.98,Default,,0,0,0,,Адасып кету оңай.
Dialogue: 0,1:17:35.06,1:17:36.23,Default,,0,0,0,,Жарыс басталмас бұрын Қвиркіңді қолданба! Өзіңді шаршатпа!
Dialogue: 0,1:17:36.31,1:17:37.61,Default,,0,0,0,,Даньяваде
Dialogue: 0,1:17:37.69,1:17:39.82,Default,,0,0,0,,Мен мұны көптен бері айтып жүрмін.
Dialogue: 0,1:17:39.90,1:17:40.82,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:17:40.90,1:17:42.78,Default,,0,0,0,,Жаңа бір реттік гаг
Dialogue: 0,1:17:42.86,1:17:44.15,Default,,0,0,0,,Мен бұл нені білдіретінін түсінбеймін.
Dialogue: 0,1:17:44.24,1:17:46.32,Default,,0,0,0,,Өйткені үнді халқы осылай дейді
Dialogue: 0,1:17:46.41,1:17:48.91,Default,,0,0,0,,Иә!? Сіз бұл нені білдіретінін білмейсіз бе?
Dialogue: 0,1:17:48.99,1:17:52.16,Default,,0,0,0,,«Дання сөзі» жапон тілінде «рахмет» дегенді білдіреді.
Dialogue: 0,1:17:52.25,1:17:53.87,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,1:17:53.96,1:17:56.33,Default,,0,0,0,,Маған 10 пикиді хабарлағаныңыз үшін рахмет
Dialogue: 0,1:17:56.42,1:17:58.13,Default,,0,0,0,,Бұл «дання сөзі», солай ма?
Dialogue: 0,1:17:58.21,1:18:01.21,Default,,0,0,0,,«Рахмет» деп осы күнге жеттіңіз бе?
Dialogue: 0,1:18:01.30,1:18:04.13,Default,,0,0,0,,Менің балам болсаң да, тым күштісің.
Dialogue: 0,1:18:04.88,1:18:06.34,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:06.43,1:18:07.84,Default,,0,0,0,,- Ал сіз ше? -(Ариана) Ах!
Dialogue: 0,1:18:08.43,1:18:10.81,Default,,0,0,0,,Ариана-чан Оланың досы!
Dialogue: 0,1:18:10.89,1:18:12.31,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,1:18:12.85,1:18:15.73,Default,,0,0,0,,Сіз Синносүкеге көмектестіңіз!?
Dialogue: 0,1:18:16.44,1:18:17.69,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:18:18.40,1:18:20.15,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:18:20.23,1:18:22.15,Default,,0,0,0,,А... жоқ...
Dialogue: 0,1:18:22.23,1:18:23.61,Default,,0,0,0,,Пу~
Dialogue: 0,1:18:27.16,1:18:28.03,Default,,0,0,0,,Тая!
Dialogue: 0,1:18:32.29,1:18:34.62,Default,,0,0,0,,Жоқ! Кетіп бара жатыр
Dialogue: 0,1:18:39.79,1:18:41.17,Default,,0,0,0,,Иә!
Dialogue: 0,1:18:55.10,1:18:56.77,Default,,0,0,0,,Ха... ха...
Dialogue: 0,1:18:59.35,1:19:01.65,Default,,0,0,0,,Қат! Тәртіпті
Dialogue: 0,1:19:03.32,1:19:06.95,Default,,0,0,0,,Мұны маған қалдыр да, бірінші бар.
Dialogue: 0,1:19:07.03,1:19:08.91,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,1:19:08.99,1:19:10.87,Default,,0,0,0,,Кеттік
Dialogue: 0,1:19:11.74,1:19:15.54,Default,,0,0,0,,Нигеро... Балаларды қауіпсіз жерге апарыңыз
Dialogue: 0,1:19:25.17,1:19:26.72,Default,,0,0,0,,Аники дұрыс айтады!
Dialogue: 0,1:19:27.42,1:19:28.47,Default,,0,0,0,,Ах!?
Dialogue: 0,1:19:28.55,1:19:31.26,Default,,0,0,0,,Нигеро! Балаларды қауіпсіз жерге апарыңыз!
Dialogue: 0,1:19:32.97,1:19:36.22,Default,,0,0,0,,Жасырын тергеу сәтті өтті!
Dialogue: 0,1:19:37.81,1:19:39.19,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,1:19:39.85,1:19:41.15,Default,,0,0,0,,Әрине!
Dialogue: 0,1:19:41.23,1:19:45.19,Default,,0,0,0,,Мен оның ақыры осылай болатын жігіт емес екеніне сендім!
Dialogue: 0,1:19:45.28,1:19:46.61,Default,,0,0,0,,Аники күткендей!
Dialogue: 0,1:19:47.61,1:19:48.45,Default,,0,0,0,,Аскөк!
Dialogue: 0,1:19:48.53,1:19:52.32,Default,,0,0,0,,Кабир Катчапапал Паккапапал Каччапапал Паккапапал
Dialogue: 0,1:19:52.41,1:19:53.37,Default,,0,0,0,,Иә!
Dialogue: 0,1:19:53.45,1:19:58.71,Default,,0,0,0,,♪ «Үндістанның қуаты 120%»
Dialogue: 0,1:20:07.09,1:20:09.30,Default,,0,0,0,,Осы жолмен! дәл қазір
Dialogue: 0,1:20:22.31,1:20:23.90,Default,,0,0,0,,Қоймаға ұқсайды.
Dialogue: 0,1:20:24.94,1:20:27.40,Default,,0,0,0,,Менің көлігім бар. Барайық!
Dialogue: 0,1:20:27.48,1:20:28.36,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:28.44,1:20:30.53,Default,,0,0,0,,Шин Чан, не болды!?
Dialogue: 0,1:20:30.61,1:20:32.82,Default,,0,0,0,,Ола Бо-чанға барыңыз.
Dialogue: 0,1:20:32.91,1:20:34.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:34.37,1:20:37.74,Default,,0,0,0,,Бо-чанды жалғыз қалдырып, қашып кетпе!
Dialogue: 0,1:20:43.00,1:20:44.04,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,1:20:44.13,1:20:47.38,Default,,0,0,0,,Сондықтан қазір мен Бо Чанға көмектесуім керек.
Dialogue: 0,1:20:47.46,1:20:48.76,Default,,0,0,0,,Бұл жерден қашыңыз
Dialogue: 0,1:20:48.84,1:20:49.76,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:49.84,1:20:52.72,Default,,0,0,0,,Сол «қағазды» берсем жаман емес пе?
Dialogue: 0,1:20:52.80,1:20:56.18,Default,,0,0,0,,Бо-чанның ешкімді одан әрі ренжітпеуі үшін.
Dialogue: 0,1:20:58.14,1:20:59.14,Default,,0,0,0,,Иә!
Dialogue: 0,1:21:00.52,1:21:02.10,Default,,0,0,0,,-де? Қайда бара жатырсың?
Dialogue: 0,1:21:02.19,1:21:03.35,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:03.44,1:21:04.56,Default,,0,0,0,,Сәлем! Артық керек емес!
Dialogue: 0,1:21:04.65,1:21:06.52,Default,,0,0,0,,Нешеу бар?
Dialogue: 0,1:21:06.61,1:21:07.94,Default,,0,0,0,,Қашып кететін жер жоқ па?
Dialogue: 0,1:21:08.02,1:21:09.48,Default,,0,0,0,,(Күнбағыс жылайды)
Dialogue: 0,1:21:12.57,1:21:14.91,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:21:14.99,1:21:16.91,Default,,0,0,0,,- Балалар! Барайық! - А?
Dialogue: 0,1:21:18.79,1:21:21.33,Default,,0,0,0,,Жүр!
Dialogue: 0,1:21:21.41,1:21:23.29,Default,,0,0,0,,Өзін-өзі жөндеуді айтарлықтай тиімсіз етеді.
Dialogue: 0,1:21:24.04,1:21:25.75,Default,,0,0,0,,Сіз оны басқара аласыз ба?
Dialogue: 0,1:21:25.83,1:21:28.25,Default,,0,0,0,,Тіпті менде әлі де ұйықтап жатқан қабілеттер бар.
Dialogue: 0,1:21:28.34,1:21:31.17,Default,,0,0,0,,120% Мен сені оятамын!
Dialogue: 0,1:21:32.72,1:21:35.97,Default,,0,0,0,,Кеттік, Үндістанның күші!
Dialogue: 0,1:21:36.05,1:21:40.35,Default,,0,0,0,,♪「Қауіпті аймақ」
Dialogue: 0,1:21:41.81,1:21:44.27,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,1:21:44.35,1:21:45.52,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,1:21:52.74,1:21:57.74,Default,,0,0,0,,(Хироши Катакото ағылшын тілінде «Қауіпті аймақ» әнін айтады)
Dialogue: 0,1:22:16.59,1:22:18.47,Default,,0,0,0,,Үндістанның күші!
Dialogue: 0,1:22:18.55,1:22:20.22,Default,,0,0,0,,Оның жоғалуына жол бермеңіз!
Dialogue: 0,1:22:20.31,1:22:24.14,Default,,0,0,0,,(Хирошидің Катакото ағылшын әні)
Dialogue: 0,1:22:31.19,1:22:32.73,Default,,0,0,0,,То-чан, тезірек!
Dialogue: 0,1:22:39.07,1:22:40.87,Default,,0,0,0,,Уау! (Хирошидің Катакото ағылшын әні)
Dialogue: 0,1:22:45.25,1:22:46.25,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:22:52.21,1:22:54.76,Default,,0,0,0,,(Мисаенің айқайы)
Dialogue: 0,1:23:03.89,1:23:05.60,Default,,0,0,0,,- (Бо-чан) Цк - Менің бағыныштыма...
Dialogue: 0,1:23:05.68,1:23:07.23,Default,,0,0,0,,- (Бо-чан) Мен барамын - А...
Dialogue: 0,1:23:08.81,1:23:10.48,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:23:11.82,1:23:12.98,Default,,0,0,0,,Таң қалды!
Dialogue: 0,1:23:14.40,1:23:15.49,Default,,0,0,0,,Ха!
Dialogue: 0,1:23:20.99,1:23:22.37,Default,,0,0,0,,Жаман адамды қу!
Dialogue: 0,1:23:23.91,1:23:25.08,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:23:27.37,1:23:32.38,Default,,0,0,0,,(Хирошидің Катакото ағылшын әні)
Dialogue: 0,1:23:39.55,1:23:44.72,Default,,0,0,0,,(Барлық Катакото ағылшын әндері)
Dialogue: 0,1:23:56.40,1:23:57.69,Default,,0,0,0,,Жоқ...?
Dialogue: 0,1:23:57.78,1:23:58.86,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:23:58.95,1:24:00.20,Default,,0,0,0,,Ах! О, жоқ!
Dialogue: 0,1:24:00.28,1:24:02.70,Default,,0,0,0,,Жанармай - қауіпті аймақ!
Dialogue: 0,1:24:04.99,1:24:05.99,Default,,0,0,0,,Уау!
Dialogue: 0,1:24:06.08,1:24:09.12,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,1:24:19.01,1:24:20.63,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:24:20.72,1:24:22.51,Default,,0,0,0,,Хаха...
Dialogue: 0,1:24:22.59,1:24:25.06,Default,,0,0,0,,Қауіпті аймақтан өзен жағасына дейін
Dialogue: 0,1:24:25.14,1:24:25.97,Default,,0,0,0,,Хаха...
Dialogue: 0,1:24:26.06,1:24:28.10,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:24:28.18,1:24:30.02,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:24:30.10,1:24:30.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:31.60,1:24:32.90,Default,,0,0,0,,Бұл зейінімді басқа жаққа бұрады, сондықтан кетші.
Dialogue: 0,1:24:32.98,1:24:35.48,Default,,0,0,0,,- (Казама-кун) Құс? -ұшақ?
Dialogue: 0,1:24:35.57,1:24:37.15,Default,,0,0,0,,Бо-чан!
Dialogue: 0,1:24:37.23,1:24:38.07,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:24:41.61,1:24:43.32,Default,,0,0,0,,Тамая~
Dialogue: 0,1:24:43.41,1:24:44.45,Default,,0,0,0,,Егер сіз осылай айтып жатсаңыз!
Dialogue: 0,1:24:44.53,1:24:45.37,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:24:45.45,1:24:47.37,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,1:24:47.45,1:24:49.70,Default,,0,0,0,,Менен қашып құтыла алмайсың
Dialogue: 0,1:24:49.79,1:24:51.21,Default,,0,0,0,,«Қағазды» тапсыру
Dialogue: 0,1:24:54.25,1:24:55.71,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,1:24:55.79,1:24:58.67,Default,,0,0,0,,Бо-чан, сені де қорғау үшін
Dialogue: 0,1:24:58.76,1:25:00.05,Default,,0,0,0,,Иә!
Dialogue: 0,1:25:01.17,1:25:04.43,Default,,0,0,0,,Шинносуке! «Қағазды» алып, алысқа қашыңыз!
Dialogue: 0,1:25:04.51,1:25:06.30,Default,,0,0,0,,Біз уақытты үнемдейміз!
Dialogue: 0,1:25:07.47,1:25:08.77,Default,,0,0,0,,Аму
Dialogue: 0,1:25:08.85,1:25:10.18,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:25:10.27,1:25:11.18,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:12.52,1:25:14.40,Default,,0,0,0,,- (Бо-чан) Хмф! -Апыр-ай!
Dialogue: 0,1:25:15.90,1:25:16.73,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:16.82,1:25:19.48,Default,,0,0,0,,Казама-кун! Нене-чан! Масао-кун!
Dialogue: 0,1:25:19.57,1:25:20.57,Default,,0,0,0,,үшінна!
Dialogue: 0,1:25:21.49,1:25:22.65,Default,,0,0,0,,Еш нәрсеге кедергі жасамаңыз!
Dialogue: 0,1:25:22.74,1:25:24.20,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:27.62,1:25:28.99,Default,,0,0,0,,2 дана «қағаз»
Dialogue: 0,1:25:29.08,1:25:30.70,Default,,0,0,0,,Мен мінсіз боламын
Dialogue: 0,1:25:31.70,1:25:34.25,Default,,0,0,0,,Шинносуке Нохараны таңдаңыз
Dialogue: 0,1:25:34.33,1:25:36.50,Default,,0,0,0,,«Қағазды» өзім тапсыруым керек пе?
Dialogue: 0,1:25:36.58,1:25:39.88,Default,,0,0,0,,Әлде мен сені тонаймын ба?
Dialogue: 0,1:25:40.51,1:25:41.84,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:42.92,1:25:44.76,Default,,0,0,0,,-Аа -Жоқ!
Dialogue: 0,1:25:44.84,1:25:46.22,Default,,0,0,0,,Шинносуке…
Dialogue: 0,1:25:47.22,1:25:48.64,Default,,0,0,0,,Хмм...
Dialogue: 0,1:25:49.39,1:25:50.60,Default,,0,0,0,,Хмф!
Dialogue: 0,1:25:51.81,1:25:55.35,Default,,0,0,0,,Ей, Бо-чанның мұрнын қайтарайық!
Dialogue: 0,1:25:55.44,1:25:58.86,Default,,0,0,0,,Ах! Сіз оны мұрныңызға қоюды жоспарлап отырсыз ба?
Dialogue: 0,1:25:58.94,1:26:00.40,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:26:00.48,1:26:01.78,Default,,0,0,0,,Хмф!
Dialogue: 0,1:26:03.19,1:26:04.78,Default,,0,0,0,,-Ах! - (қағаз дауыс) Шуу!?
Dialogue: 0,1:26:04.86,1:26:05.74,Default,,0,0,0,,Иә!?
Dialogue: 0,1:26:05.86,1:26:06.70,Default,,0,0,0,,Шири?
Dialogue: 0,1:26:11.58,1:26:13.20,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:26:13.29,1:26:15.17,Default,,0,0,0,,- (Бо-чан) Әй! -Эй!
Dialogue: 0,1:26:16.83,1:26:18.29,Default,,0,0,0,,Тототото…
Dialogue: 0,1:26:19.71,1:26:21.59,Default,,0,0,0,,Ха!
Dialogue: 0,1:26:23.84,1:26:25.63,Default,,0,0,0,,«Қағаз» соңғы шара ретінде!?
Dialogue: 0,1:26:25.72,1:26:27.22,Default,,0,0,0,,Менде мұндай ой болған жоқ.
Dialogue: 0,1:26:27.30,1:26:31.22,Default,,0,0,0,,Оны тікелей мұрынға емес, бөксеге қою арқылы
Dialogue: 0,1:26:31.31,1:26:34.02,Default,,0,0,0,,Билікке қол жеткізгенімен, «қағаздың» зұлымдығы
Dialogue: 0,1:26:34.10,1:26:35.81,Default,,0,0,0,,Оны жеткізу қиындап барады.
Dialogue: 0,1:26:35.89,1:26:39.06,Default,,0,0,0,,Аники күткендей! тамаша түсінік
Dialogue: 0,1:26:39.15,1:26:41.73,Default,,0,0,0,,Мен бара аламын! «Қағазыңызды» қайтарыңыз!
Dialogue: 0,1:26:41.82,1:26:43.78,Default,,0,0,0,,Сүйкімді бала Шинносуке!
Dialogue: 0,1:26:43.86,1:26:45.11,Default,,0,0,0,,«Қағазды» кесіңіз!
Dialogue: 0,1:26:45.19,1:26:47.36,Default,,0,0,0,,Жоқ! Маған «қағаз» керек!
Dialogue: 0,1:26:47.45,1:26:49.57,Default,,0,0,0,,Жоқ! Жоқ, жоқ~
Dialogue: 0,1:26:50.33,1:26:51.78,Default,,0,0,0,,Уа! Аха~!
Dialogue: 0,1:26:51.87,1:26:53.08,Default,,0,0,0,,Маған «қағаз» керек!
Dialogue: 0,1:26:53.16,1:26:54.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:26:54.58,1:26:55.75,Default,,0,0,0,,(Бо Чанның дауысы)
Dialogue: 0,1:26:55.83,1:26:57.87,Default,,0,0,0,,- «Қағазды» бөліңіз! - (Бо Чан) О, жоқ!
Dialogue: 0,1:26:57.96,1:26:58.88,Default,,0,0,0,,Маған «қағаз» керек!
Dialogue: 0,1:26:58.96,1:27:00.46,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:27:00.54,1:27:02.30,Default,,0,0,0,,- Қағазды бөліңіз - (Бо-чан) Қағазды қалаймын!
Dialogue: 0,1:27:02.42,1:27:05.34,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ...!
Dialogue: 0,1:27:05.42,1:27:06.88,Default,,0,0,0,,Жылда!
Dialogue: 0,1:27:07.72,1:27:10.47,Default,,0,0,0,,А... Бо-чан, жақсысың ба?
Dialogue: 0,1:27:12.14,1:27:13.85,Default,,0,0,0,,Шинносуке Нохара
Dialogue: 0,1:27:13.93,1:27:16.68,Default,,0,0,0,,Өйткені, сіз қарапайым адам емессіз.
Dialogue: 0,1:27:16.77,1:27:19.44,Default,,0,0,0,,Бірақ нақты нәрсе осы жерден басталады
Dialogue: 0,1:27:19.52,1:27:20.86,Default,,0,0,0,,(ырылдаған дыбыс)
Dialogue: 0,1:27:21.52,1:27:23.23,Default,,0,0,0,,Ах!
Dialogue: 0,1:27:23.32,1:27:24.53,Default,,0,0,0,,Боттар!
Dialogue: 0,1:27:24.61,1:27:27.32,Default,,0,0,0,,Жоқ! «Қағаз» толығымен мұрныңызда!
Dialogue: 0,1:27:27.40,1:27:29.07,Default,,0,0,0,,Сүйкімді бала Шинносуке!
Dialogue: 0,1:27:29.16,1:27:31.99,Default,,0,0,0,,Нигеро!
Dialogue: 0,1:27:32.74,1:27:34.24,Default,,0,0,0,,О? Ха!
Dialogue: 0,1:27:34.33,1:27:35.37,Default,,0,0,0,,Афун
Dialogue: 0,1:27:37.50,1:27:39.50,Default,,0,0,0,,Куку…
Dialogue: 0,1:27:47.80,1:27:49.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:50.72,1:27:51.89,Default,,0,0,0,,Бо Чан?
Dialogue: 0,1:27:51.97,1:27:55.81,Default,,0,0,0,,Бұл мен мінсізмін
Dialogue: 0,1:27:55.89,1:27:58.02,Default,,0,0,0,,Үндістанның күші!
Dialogue: 0,1:27:58.10,1:28:00.77,Default,,0,0,0,,Баяу Ол тоқтап тұрған сияқты.
Dialogue: 0,1:28:01.35,1:28:02.98,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,1:28:03.73,1:28:05.82,Default,,0,0,0,,- (Кабир мен Диль) Ух... - (Бо-чан) Әй!
Dialogue: 0,1:28:05.90,1:28:07.57,Default,,0,0,0,,Тиран (Бо-кун) дүниеге келді!
Dialogue: 0,1:28:07.65,1:28:10.28,Default,,0,0,0,,Осылай болғанына өкінемін.
Dialogue: 0,1:28:10.36,1:28:12.37,Default,,0,0,0,,Мені енді ешкім тоқтата алмайды
Dialogue: 0,1:28:14.24,1:28:16.16,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,1:28:16.24,1:28:18.04,Default,,0,0,0,,Бір сәтте…
Dialogue: 0,1:28:20.08,1:28:20.92,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,1:28:21.00,1:28:22.25,Default,,0,0,0,,Фу
Dialogue: 0,1:28:24.38,1:28:26.59,Default,,0,0,0,,Хмм... уф...
Dialogue: 0,1:28:28.46,1:28:29.59,Default,,0,0,0,,Шинносуке!?
Dialogue: 0,1:28:29.67,1:28:30.97,Default,,0,0,0,,Уау!
Dialogue: 0,1:28:31.05,1:28:31.88,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:28:31.97,1:28:33.93,Default,,0,0,0,,Уау, уау...
Dialogue: 0,1:28:34.01,1:28:35.22,Default,,0,0,0,,Шинносуке!
Dialogue: 0,1:28:35.31,1:28:36.68,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:28:38.81,1:28:41.77,Default,,0,0,0,,Ола «қағазды» алып тастайды
Dialogue: 0,1:28:42.81,1:28:44.98,Default,,0,0,0,,Мұрнынан аққан Бо Чанға
Dialogue: 0,1:28:45.06,1:28:46.65,Default,,0,0,0,,Себебі мен сені қайта көргім келеді
Dialogue: 0,1:28:46.73,1:28:50.32,Default,,0,0,0,,Мен саған айттым, енді мұрыннан су ағып кетпейді.
Dialogue: 0,1:28:50.40,1:28:52.95,Default,,0,0,0,,Бо Чанды жіберіңіз!
Dialogue: 0,1:28:53.03,1:28:57.79,Default,,0,0,0,,Мұрыннан су ағып кетпесе де, мен қызық жасаймын!
Dialogue: 0,1:28:57.87,1:28:59.45,Default,,0,0,0,,Қазір Бо Чан
Dialogue: 0,1:28:59.54,1:29:01.91,Default,,0,0,0,,Мен тек қызық емес нәрселерді жариялап отырмын!
Dialogue: 0,1:29:02.00,1:29:04.13,Default,,0,0,0,,Мен туралы не білесің?
Dialogue: 0,1:29:04.21,1:29:06.25,Default,,0,0,0,,Онда маған айт.
Dialogue: 0,1:29:06.34,1:29:08.30,Default,,0,0,0,,Бо-чан не ойнайды?
Dialogue: 0,1:29:08.38,1:29:11.84,Default,,0,0,0,,Қайда барғыңыз келеді? Сіз не жейсіз? Сізге не ұнайды?
Dialogue: 0,1:29:11.92,1:29:13.72,Default,,0,0,0,,- (Бо-чан) Тоқта! -Апыр-ай!
Dialogue: 0,1:29:13.80,1:29:16.85,Default,,0,0,0,,Мені ұрып-соғудың пайдасы жоқ.
Dialogue: 0,1:29:16.93,1:29:18.77,Default,,0,0,0,,Мен сені жеңуге тырыспаймын.
Dialogue: 0,1:29:18.85,1:29:19.68,Default,,0,0,0,,Бо?
Dialogue: 0,1:29:19.77,1:29:22.64,Default,,0,0,0,,Мен жай ғана Бо Чанмен ойнағым келеді
Dialogue: 0,1:29:23.60,1:29:26.98,Default,,0,0,0,,Бо-чан Бо-кунға айналса да
Dialogue: 0,1:29:27.07,1:29:30.82,Default,,0,0,0,,Бо мырза болсам да Бо мырза болсам да
Dialogue: 0,1:29:30.90,1:29:33.74,Default,,0,0,0,,Ола Бо Чанмен ойнағысы келеді!
Dialogue: 0,1:29:33.82,1:29:35.62,Default,,0,0,0,,Дұрыс, Бо Чан.
Dialogue: 0,1:29:35.70,1:29:37.08,Default,,0,0,0,,Ойнайық
Dialogue: 0,1:29:37.16,1:29:38.33,Default,,0,0,0,,Бұл қызық
Dialogue: 0,1:29:39.79,1:29:42.54,Default,,0,0,0,,Бо-чанның мұрны болмаса да
Dialogue: 0,1:29:42.62,1:29:44.00,Default,,0,0,0,,Тіпті өзгерсе де
Dialogue: 0,1:29:44.08,1:29:45.88,Default,,0,0,0,,Мен бірге көңіл көтергім келеді!
Dialogue: 0,1:29:45.96,1:29:48.71,Default,,0,0,0,,Мен мәңгі ойнағым келеді!
Dialogue: 0,1:29:48.80,1:29:51.34,Default,,0,0,0,,Бо-чан, ойнайық!
Dialogue: 0,1:29:51.42,1:29:52.34,Default,,0,0,0,,Бо-чан
Dialogue: 0,1:29:52.42,1:29:53.42,Default,,0,0,0,,Бо-чан!
Dialogue: 0,1:29:53.51,1:29:54.43,Default,,0,0,0,,Бо-чан
Dialogue: 0,1:29:54.51,1:29:57.30,Default,,0,0,0,,Көптеген жылдар бойы дәрігер болып—
Dialogue: 0,1:29:57.39,1:29:59.01,Default,,0,0,0,,Тағзым! Тағзым! Тағзым! Тағзым…
Dialogue: 0,1:29:59.10,1:30:01.06,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,1:30:01.14,1:30:04.14,Default,,0,0,0,,Тағзым! Садақ тағзым!
Dialogue: 0,1:30:06.19,1:30:07.06,Default,,0,0,0,,Бо…
Dialogue: 0,1:30:08.56,1:30:10.11,Default,,0,0,0,,Бо-чан
Dialogue: 0,1:30:10.19,1:30:12.28,Default,,0,0,0,,Бірге таң қалды
Dialogue: 0,1:30:12.36,1:30:14.32,Default,,0,0,0,,Ха... Ах...
Dialogue: 0,1:30:23.66,1:30:25.67,Default,,0,0,0,,Бурибури~ Бури Бури~
Dialogue: 0,1:30:27.67,1:30:29.13,Default,,0,0,0,,Бо…
Dialogue: 0,1:30:30.96,1:30:32.42,Default,,0,0,0,,Аха!
Dialogue: 0,1:30:35.05,1:30:36.47,Default,,0,0,0,,-(Бо-чан) А... -Ой?
Dialogue: 0,1:30:37.14,1:30:38.55,Default,,0,0,0,,О!
Dialogue: 0,1:30:40.01,1:30:41.68,Default,,0,0,0,,Бо…
Dialogue: 0,1:30:42.35,1:30:43.60,Default,,0,0,0,,Ах
Dialogue: 0,1:30:44.14,1:30:45.02,Default,,0,0,0,,Бөтелке
Dialogue: 0,1:30:45.10,1:30:46.81,Default,,0,0,0,,О!
Dialogue: 0,1:30:46.89,1:30:48.94,Default,,0,0,0,,О? Ахахха~
Dialogue: 0,1:30:49.65,1:30:51.40,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:30:55.19,1:30:56.78,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,1:31:01.99,1:31:05.75,Default,,0,0,0,,Хахахаха! Хаха...
Dialogue: 0,1:31:11.84,1:31:14.59,Default,,0,0,0,,Бо-чан, бірге билейік!
Dialogue: 0,1:31:14.67,1:31:16.42,Default,,0,0,0,,Өйткені біз
Dialogue: 0,1:31:17.43,1:31:21.22,Default,,0,0,0,,Томо да чи дазо~сан!
Dialogue: 0,1:31:21.30,1:31:22.76,Default,,0,0,0,,Хаха
Dialogue: 0,1:31:22.85,1:31:23.68,Default,,0,0,0,,Пуф!
Dialogue: 0,1:31:23.76,1:31:24.68,Default,,0,0,0,,Хахаха!
Dialogue: 0,1:31:24.77,1:31:25.93,Default,,0,0,0,,Әй?
Dialogue: 0,1:31:27.56,1:31:28.90,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:31:29.48,1:31:32.52,Default,,0,0,0,,Ngg...!
Dialogue: 0,1:31:36.69,1:31:38.32,Default,,0,0,0,,Мммм... Нуну...!
Dialogue: 0,1:31:38.40,1:31:40.41,Default,,0,0,0,,(Екі дауыс ән айтады)
Dialogue: 0,1:31:40.49,1:31:42.20,Default,,0,0,0,,Boh!
Dialogue: 0,1:31:43.95,1:31:45.08,Default,,0,0,0,,Нгиги…
Dialogue: 0,1:31:45.16,1:31:46.45,Default,,0,0,0,,(Питбуль) Э? (Доберман) Э?
Dialogue: 0,1:31:58.55,1:31:59.72,Default,,0,0,0,,Бо…
Dialogue: 0,1:32:04.72,1:32:06.89,Default,,0,0,0,,Бөксе тәрізді тас
Dialogue: 0,1:32:06.97,1:32:08.68,Default,,0,0,0,,Үнді жақтары
Dialogue: 0,1:32:08.77,1:32:11.23,Default,,0,0,0,,Кәдесый, қаласаңыз.
Dialogue: 0,1:32:11.31,1:32:12.52,Default,,0,0,0,,Со~Томою~
Dialogue: 0,1:32:12.61,1:32:14.11,Default,,0,0,0,,Ю~Томосо~
Dialogue: 0,1:32:14.19,1:32:15.57,Default,,0,0,0,,Иә
Dialogue: 0,1:32:17.28,1:32:18.82,Default,,0,0,0,,Уау! Бұл Бо Чан!
Dialogue: 0,1:32:18.90,1:32:19.74,Default,,0,0,0,,Бо-чан Бо-чан
Dialogue: 0,1:32:19.82,1:32:20.86,Default,,0,0,0,,Бо-чан
Dialogue: 0,1:32:20.95,1:32:22.66,Default,,0,0,0,,Бо Чан жылап жатыр~
Dialogue: 0,1:32:22.74,1:32:25.08,Default,,0,0,0,,Әр түрлі мұрыннан су ағуы
Dialogue: 0,1:32:25.16,1:32:26.58,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:32:27.54,1:32:28.91,Default,,0,0,0,,…қашып кету…
Dialogue: 0,1:32:29.00,1:32:30.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:32:32.46,1:32:33.88,Default,,0,0,0,,Иә
Dialogue: 0,1:32:37.51,1:32:38.97,Default,,0,0,0,,Кун
Dialogue: 0,1:32:39.05,1:32:40.80,Default,,0,0,0,,(Күнбағыс есінеу)
Dialogue: 0,1:32:41.59,1:32:43.51,Default,,0,0,0,,- (Ариана) Керемет - (Хиросито Мисае) Иә?
Dialogue: 0,1:32:43.59,1:32:45.18,Default,,0,0,0,,Мен тиран болсам да (Бо-кун)
Dialogue: 0,1:32:45.26,1:32:47.52,Default,,0,0,0,,Мені жақсы көретін достарым бар
Dialogue: 0,1:32:48.47,1:32:52.94,Default,,0,0,0,,Негізі мен сенімен күліп, бақытты болуым керек.
Dialogue: 0,1:32:53.02,1:32:56.86,Default,,0,0,0,,Мен сол балаларды қызғанып, көңілім түсіп кетті.
Dialogue: 0,1:32:56.94,1:32:58.48,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:32:58.57,1:33:01.57,Default,,0,0,0,,Маған бұл өте ұнамайды
Dialogue: 0,1:33:05.78,1:33:08.45,Default,,0,0,0,,Мінездің бұл түрі Жаман нәрсе білсең
Dialogue: 0,1:33:08.54,1:33:11.50,Default,,0,0,0,,үшін мені жек көреді, солай ма?
Dialogue: 0,1:33:11.58,1:33:15.08,Default,,0,0,0,,Дәлірек айтсам, мен не дедім...
Dialogue: 0,1:33:15.17,1:33:17.96,Default,,0,0,0,,Маған ұнайсың
Dialogue: 0,1:33:18.05,1:33:18.88,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:18.96,1:33:23.05,Default,,0,0,0,,Біреудің бақытына күліп, қуану керемет.
Dialogue: 0,1:33:23.13,1:33:25.80,Default,,0,0,0,,Олай болмайтын кездер болады, солай ма?
Dialogue: 0,1:33:25.89,1:33:29.10,Default,,0,0,0,,Ой, мен бәріне ұнағым келеді.
Dialogue: 0,1:33:29.18,1:33:32.35,Default,,0,0,0,,Әділ адам болудың айыбы жоқ.
Dialogue: 0,1:33:32.44,1:33:34.56,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,1:33:34.65,1:33:37.11,Default,,0,0,0,,Ешкім мінсіз емес
Dialogue: 0,1:33:37.19,1:33:40.19,Default,,0,0,0,,Егер сен мінсіз болсаң, біз бірге болмас едік.
Dialogue: 0,1:33:40.28,1:33:41.65,Default,,0,0,0,,Мен шаршадым
Dialogue: 0,1:33:41.74,1:33:43.07,Default,,0,0,0,,Мен де
Dialogue: 0,1:33:43.15,1:33:47.45,Default,,0,0,0,,Сенің мінезің жақсы, сұлусың, стилің керемет, әрқашан мейірімдісің.
Dialogue: 0,1:33:47.53,1:33:52.08,Default,,0,0,0,,Егер сіз көңілге қонымды және әр нәрсеге шебер мінсіз адам болсаңыз...
Dialogue: 0,1:33:52.16,1:33:53.04,Default,,0,0,0,,Жаман емес.
Dialogue: 0,1:33:53.12,1:33:54.04,Default,,0,0,0,,Эй!
Dialogue: 0,1:33:54.12,1:33:55.75,Default,,0,0,0,,Поо! Ахахха~
Dialogue: 0,1:33:55.83,1:33:57.84,Default,,0,0,0,,Ариана!
Dialogue: 0,1:34:00.21,1:34:01.05,Default,,0,0,0,,Әй!
Dialogue: 0,1:34:06.34,1:34:07.60,Default,,0,0,0,,Бөтелке
Dialogue: 0,1:34:09.64,1:34:10.77,Default,,0,0,0,,Эй!
Dialogue: 0,1:34:14.10,1:34:17.23,Default,,0,0,0,,Бұны мұрныңыздағы тесікке салсаңыз, сіз ең күшті боласыз.
Dialogue: 0,1:34:17.31,1:34:19.44,Default,,0,0,0,,Жоқ, олай істеме.
Dialogue: 0,1:34:19.52,1:34:23.03,Default,,0,0,0,,Мені кіргізіңіз. Қазір ешкім қарап тұрған жоқ.
Dialogue: 0,1:34:23.11,1:34:25.36,Default,,0,0,0,,Жақсы, бірақ...
Dialogue: 0,1:34:25.45,1:34:26.57,Default,,0,0,0,,Бо-чанның мұрны және
Dialogue: 0,1:34:26.66,1:34:29.20,Default,,0,0,0,,Бұл Шин Чанның бөксесінде тұрған "қағаз".
Dialogue: 0,1:34:29.28,1:34:30.24,Default,,0,0,0,,Ол лас емес пе?
Dialogue: 0,1:34:30.33,1:34:32.70,Default,,0,0,0,,Сізге лас болудың қажеті жоқ!
Dialogue: 0,1:34:32.79,1:34:35.12,Default,,0,0,0,,Бұл енді жай күріш шары емес
Dialogue: 0,1:34:35.21,1:34:37.71,Default,,0,0,0,,Ең жақсы грильдегі күріш шарлары!
Dialogue: 0,1:34:37.79,1:34:39.67,Default,,0,0,0,,Шынында да...
Dialogue: 0,1:34:39.75,1:34:41.88,Default,,0,0,0,,Ах!
Dialogue: 0,1:34:44.92,1:34:46.72,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:34:46.80,1:34:47.68,Default,,0,0,0,,Наан емес пе?
Dialogue: 0,1:34:47.76,1:34:49.30,Default,,0,0,0,,Бұл не, Наан?
Dialogue: 0,1:34:53.35,1:34:56.73,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:34:56.81,1:34:58.10,Default,,0,0,0,,Иә?
Dialogue: 0,1:34:58.19,1:35:00.15,Default,,0,0,0,,Бұл не? Наан?
Dialogue: 0,1:35:00.23,1:35:01.19,Default,,0,0,0,,Күріш?
Dialogue: 0,1:35:04.24,1:35:06.61,Default,,0,0,0,,Мен Чапатимын
Dialogue: 0,1:35:10.66,1:35:13.49,Default,,0,0,0,,Аники! «Қағаз» чапатиге жабысып қалды!
Dialogue: 0,1:35:13.58,1:35:15.29,Default,,0,0,0,,Тиран (Бо-кун) Чапати ма?
Dialogue: 0,1:35:15.96,1:35:18.87,Default,,0,0,0,,Чапати – бидай ұнынан және судан жасалған қамыр.
Dialogue: 0,1:35:18.96,1:35:22.21,Default,,0,0,0,,Жұқа дөңгелек пішінде жайып, ашытпай пісіреді.
Dialogue: 0,1:35:22.29,1:35:24.09,Default,,0,0,0,,Есте сақта
Dialogue: 0,1:35:24.17,1:35:26.67,Default,,0,0,0,,Дүние жүзіне мүлде танымал емес.
Dialogue: 0,1:35:26.76,1:35:29.64,Default,,0,0,0,,Чапати наан мен күріштен басым түседі
Dialogue: 0,1:35:29.72,1:35:33.18,Default,,0,0,0,,Менің атақты болғым келеді!
Dialogue: 0,1:35:33.81,1:35:35.60,Default,,0,0,0,,Бұл жаңа ғана келген бейне.
Dialogue: 0,1:35:35.68,1:35:37.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:35:37.81,1:35:39.06,Default,,0,0,0,,(қораптың құлаған дыбысы)
Dialogue: 0,1:35:39.15,1:35:43.02,Default,,0,0,0,,Бұл жігіт үлкен қиындыққа тап болады...
Dialogue: 0,1:35:43.11,1:35:44.73,Default,,0,0,0,,- (Ер А) Жынды бол! -(Ер В) Уау!
Dialogue: 0,1:35:44.82,1:35:47.70,Default,,0,0,0,,Чапати әлемде мүлдем белгісіз!
Dialogue: 0,1:35:47.78,1:35:49.66,Default,,0,0,0,,Мықтысы табылды!
Dialogue: 0,1:35:49.74,1:35:52.28,Default,,0,0,0,,Оны сенің досыңа айналдырайық!
Dialogue: 0,1:35:54.16,1:35:55.58,Default,,0,0,0,,Гррр... Ах!
Dialogue: 0,1:35:55.66,1:35:58.04,Default,,0,0,0,,Чапати - үйдегі үнді тағамы.
Dialogue: 0,1:35:58.12,1:35:59.79,Default,,0,0,0,,Өте дәмді және кез келген карримен жақсы үйлеседі.
Dialogue: 0,1:35:59.87,1:36:01.29,Default,,0,0,0,,Тамаша тағам
Dialogue: 0,1:36:01.38,1:36:02.96,Default,,0,0,0,,Егер сізде материалдар мен аздап от күші болса
Dialogue: 0,1:36:03.04,1:36:05.00,Default,,0,0,0,,Кез келген уақытта, кез келген жерде жаңа пісірілген дәмді шапаттиден рахат алыңыз.
Dialogue: 0,1:36:05.09,1:36:06.42,Default,,0,0,0,,Жасалуы мүмкін
Dialogue: 0,1:36:06.51,1:36:07.47,Default,,0,0,0,,Шайнайтын және үлпілдек Чапати
Dialogue: 0,1:36:07.55,1:36:09.43,Default,,0,0,0,,Суперфуд шапати
Dialogue: 0,1:36:09.51,1:36:11.97,Default,,0,0,0,,«Чапати» деп айтқың келетін тамаша сөз
Dialogue: 0,1:36:12.05,1:36:13.26,Default,,0,0,0,,үшінн бақытты ететін Чапати
Dialogue: 0,1:36:13.35,1:36:14.93,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,1:36:15.01,1:36:16.10,Default,,0,0,0,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,1:36:16.18,1:36:18.39,Default,,0,0,0,,Чапататтан «қағазды» алып тастау керек!
Dialogue: 0,1:36:18.48,1:36:20.73,Default,,0,0,0,,Бірақ осындай биік жерде...
Dialogue: 0,1:36:22.02,1:36:24.40,Default,,0,0,0,,Жарайды! Мінеки біз!
Dialogue: 0,1:36:25.77,1:36:26.61,Default,,0,0,0,,Әлі емес.
Dialogue: 0,1:36:26.69,1:36:28.65,Default,,0,0,0,,Неліктен ол маған жетеді деп ойладың?
Dialogue: 0,1:36:28.74,1:36:31.36,Default,,0,0,0,,Артқа тұрыңдар, балалар.
Dialogue: 0,1:36:32.03,1:36:34.83,Default,,0,0,0,,Біз оны төмен сүйреп, қағазды алып тастаймыз.
Dialogue: 0,1:36:34.91,1:36:37.29,Default,,0,0,0,,Мен бірден ката киемін!
Dialogue: 0,1:36:37.37,1:36:40.16,Default,,0,0,0,,Үндістанның күші!
Dialogue: 0,1:36:43.13,1:36:45.75,Default,,0,0,0,,Уау!
Dialogue: 0,1:36:45.84,1:36:46.88,Default,,0,0,0,,О!
Dialogue: 0,1:36:46.96,1:36:48.34,Default,,0,0,0,,Ұстадым!
Dialogue: 0,1:36:48.96,1:36:49.80,Default,,0,0,0,,Тек араласып жүрсің...
Dialogue: 0,1:36:49.88,1:36:52.13,Default,,0,0,0,,Мына мыңжапырақ!
Dialogue: 0,1:36:52.22,1:36:53.76,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:36:53.84,1:36:56.72,Default,,0,0,0,,Мен мінсіз қасқырмын!
Dialogue: 0,1:36:56.81,1:36:59.18,Default,,0,0,0,,Үндістандағы ең жақсы адам!
Dialogue: 0,1:36:59.27,1:37:01.44,Default,,0,0,0,,-Мен жалғыз істей алмаймын -Сен!
Dialogue: 0,1:37:01.52,1:37:03.15,Default,,0,0,0,,Энн!
Dialogue: 0,1:37:03.23,1:37:04.90,Default,,0,0,0,,Уау!
Dialogue: 0,1:37:09.07,1:37:10.11,Default,,0,0,0,,-Тая~! - Энн Энн!
Dialogue: 0,1:37:14.82,1:37:16.99,Default,,0,0,0,,Жоқ! Тағы бір қол!
Dialogue: 0,1:37:19.33,1:37:20.41,Default,,0,0,0,,Хамф!
Dialogue: 0,1:37:20.50,1:37:22.37,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз!
Dialogue: 0,1:37:22.46,1:37:24.08,Default,,0,0,0,,Директор!
Dialogue: 0,1:37:24.17,1:37:25.92,Default,,0,0,0,,Ухун ахаан!
Dialogue: 0,1:37:26.00,1:37:27.17,Default,,0,0,0,,Бунта Такакура!
Dialogue: 0,1:37:27.25,1:37:28.25,Default,,0,0,0,,Иә!
Dialogue: 0,1:37:28.34,1:37:31.92,Default,,0,0,0,,Уау! Ораораораора…
Dialogue: 0,1:37:32.01,1:37:34.72,Default,,0,0,0,,Сол екеуінің кейіпкерлері өзгерген жоқ па?
Dialogue: 0,1:37:34.80,1:37:36.97,Default,,0,0,0,,Бұл қиын сапар болса керек.
Dialogue: 0,1:37:38.85,1:37:40.68,Default,,0,0,0,,Мен шапати ұстадым!
Dialogue: 0,1:37:40.77,1:37:43.14,Default,,0,0,0,,Бұл жерден не істейміз!?
Dialogue: 0,1:37:43.23,1:37:45.15,Default,,0,0,0,,Қазір! Барыңыз Zo!
Dialogue: 0,1:37:45.23,1:37:47.36,Default,,0,0,0,,О!
Dialogue: 0,1:37:49.02,1:37:50.73,Default,,0,0,0,,Жоқ! Қауіпті нәрсе жасаңыз!
Dialogue: 0,1:37:50.82,1:37:52.32,Default,,0,0,0,,- (Бо-чан) Маған ұнамайды! -Мен оны ұнатпаймын!
Dialogue: 0,1:37:52.40,1:37:54.91,Default,,0,0,0,,Бізбен кез келген жерге бара аламыз!
Dialogue: 0,1:37:54.99,1:37:56.74,Default,,0,0,0,,Сіз «қағаз» алуға баруды жоспарлап отырсыз ба?
Dialogue: 0,1:37:56.82,1:37:59.45,Default,,0,0,0,,Иә! бұл біздің әлем
Dialogue: 0,1:37:59.54,1:38:02.41,Default,,0,0,0,,Қорықсам да, Жыласам да
Dialogue: 0,1:38:02.50,1:38:04.46,Default,,0,0,0,,Жарайды! күлу
Dialogue: 0,1:38:04.54,1:38:06.38,Default,,0,0,0,,Сіз жалғыз емессіз!
Dialogue: 0,1:38:12.46,1:38:14.63,Default,,0,0,0,,«қағазды» кесу
Dialogue: 0,1:38:14.72,1:38:16.59,Default,,0,0,0,,Әлемді қызықтырақ етіңіз!
Dialogue: 0,1:38:16.68,1:38:18.55,Default,,0,0,0,,«Қағаз» сол жерде!
Dialogue: 0,1:38:18.64,1:38:20.85,Default,,0,0,0,,Кеттік! Касукабе қорғаныс күштері
Dialogue: 0,1:38:20.93,1:38:22.02,Default,,0,0,0,,Намасте~
Dialogue: 0,1:38:22.10,1:38:24.27,Default,,0,0,0,,Енді мен сені өз қолыммен бөліп-жарып тастауға мәжбүрмін.
Dialogue: 0,1:38:31.48,1:38:33.11,Default,,0,0,0,,Жоқ! Мен одан өте алмаймын!
Dialogue: 0,1:38:33.19,1:38:35.57,Default,,0,0,0,,Бәріміз бірге тартайық!
Dialogue: 0,1:38:37.70,1:38:39.03,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:38:56.30,1:38:58.18,Default,,0,0,0,,Уау!
Dialogue: 0,1:38:58.26,1:39:01.10,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:39:10.48,1:39:11.69,Default,,0,0,0,,Әй?
Dialogue: 0,1:39:11.77,1:39:13.36,Default,,0,0,0,,(Деку) Кайри-чан, сен де мектеп фестиваліне келе алмайсың ба?
Dialogue: 0,1:39:14.15,1:39:17.03,Default,,0,0,0,,Итадакимасу!
Dialogue: 0,1:39:17.11,1:39:18.32,Default,,0,0,0,,Уау! Дәмді көрінеді!
Dialogue: 0,1:39:18.41,1:39:19.99,Default,,0,0,0,,Көп.
Dialogue: 0,1:39:20.07,1:39:21.66,Default,,0,0,0,,Көбірек жей беріңіз.
Dialogue: 0,1:39:21.74,1:39:23.45,Default,,0,0,0,,Чапатти майу~
Dialogue: 0,1:39:23.54,1:39:25.41,Default,,0,0,0,,Ахмм
Dialogue: 0,1:39:25.50,1:39:27.41,Default,,0,0,0,,Ммм, дәмді!
Dialogue: 0,1:39:27.50,1:39:30.25,Default,,0,0,0,,Ариана-чан, сізге Bribri Cure ұнай ма?
Dialogue: 0,1:39:30.33,1:39:31.42,Default,,0,0,0,,Әрине!
Dialogue: 0,1:39:31.50,1:39:33.92,Default,,0,0,0,,Маған емделген қияр ұнайды
Dialogue: 0,1:39:34.00,1:39:35.21,Default,,0,0,0,,Керемет!
Dialogue: 0,1:39:35.30,1:39:38.34,Default,,0,0,0,,Ненеге Cure Ornithine ұнайды!
Dialogue: 0,1:39:38.43,1:39:40.68,Default,,0,0,0,,Ариана ше? саған кім ұнайды?
Dialogue: 0,1:39:40.76,1:39:42.81,Default,,0,0,0,,Ku~! Жақсы сұрақ!
Dialogue: 0,1:39:42.89,1:39:47.27,Default,,0,0,0,,Тыңдағаныңызға жарайсың! Маған ең ұнайтыны...
Dialogue: 0,1:39:47.35,1:39:50.52,Default,,0,0,0,,Әркімнің серіктесі көп болса да
Dialogue: 0,1:39:50.60,1:39:54.15,Default,,0,0,0,,Жарықтарда адамдар да, жануарлар да бар.
Dialogue: 0,1:39:54.23,1:39:56.44,Default,,0,0,0,,Сондай-ақ шапати жоқ.
Dialogue: 0,1:39:56.53,1:39:58.45,Default,,0,0,0,,Мен неге серіктес бола алмаймын...
Dialogue: 0,1:39:58.53,1:40:01.03,Default,,0,0,0,,Серік пен дос табуға тырысу
Dialogue: 0,1:40:01.12,1:40:03.41,Default,,0,0,0,,Менің ойымша, бұл жасауға болатын нәрсе емес.
Dialogue: 0,1:40:03.49,1:40:05.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:05.16,1:40:07.25,Default,,0,0,0,,Бір адам болған дұрыс.
Dialogue: 0,1:40:07.33,1:40:10.00,Default,,0,0,0,,Өзіңді басқалармен салыстырма, басқаларға мейірімді бол
Dialogue: 0,1:40:10.08,1:40:14.04,Default,,0,0,0,,Ақымақ болыңыз және өзіңізге ұнайтын нәрседен ләззат алыңыз
Dialogue: 0,1:40:14.13,1:40:17.72,Default,,0,0,0,,Досымды шын жүректен күлдірсем
Dialogue: 0,1:40:17.80,1:40:21.93,Default,,0,0,0,,Бір күні сіз үлкен болсаңыз да, бала болсаңыз да, барлық айырмашылықтарды жеңе аласыз.
Dialogue: 0,1:40:22.01,1:40:26.39,Default,,0,0,0,,Әрине, сіздің қасыңызда тамаша серіктес тұр.
Dialogue: 0,1:40:26.47,1:40:28.56,Default,,0,0,0,,- (Ухун ахаан), солай ма? -(Директор) Ахан!
Dialogue: 0,1:40:28.64,1:40:30.19,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:40:30.27,1:40:31.65,Default,,0,0,0,,Уф...
Dialogue: 0,1:40:33.61,1:40:34.86,Default,,0,0,0,,Рахмет
Dialogue: 0,1:40:35.61,1:40:37.19,Default,,0,0,0,,Ешкім зардап шеккен жоқ
Dialogue: 0,1:40:37.28,1:40:39.32,Default,,0,0,0,,Чапаттиді тоқтатқаныңызға қуаныштымын.
Dialogue: 0,1:40:39.40,1:40:40.65,Default,,0,0,0,,Аникиден күткендей
Dialogue: 0,1:40:40.74,1:40:43.28,Default,,0,0,0,,Енді сол «қағаз» көп жылдар бойы қуып келе жатыр...
Dialogue: 0,1:40:43.37,1:40:44.83,Default,,0,0,0,,Иә? «Қағаз» қайда?
Dialogue: 0,1:40:44.91,1:40:45.74,Default,,0,0,0,,Ах!?
Dialogue: 0,1:40:47.75,1:40:48.79,Default,,0,0,0,,Фу~
Dialogue: 0,1:40:48.87,1:40:51.21,Default,,0,0,0,,Мен дұрыс қағазды тапқаныма қуаныштымын.
Dialogue: 0,1:40:51.29,1:40:54.38,Default,,0,0,0,,♪ Үнді дәретханаларында қағаз жоқ~
Dialogue: 0,1:40:54.46,1:40:57.17,Default,,0,0,0,,♪ Қағаз болса да, оны жууға болмайды ~
Dialogue: 0,1:40:57.25,1:40:59.67,Default,,0,0,0,,- (Кабир) Сол «қағазбен»!? - Бөкселермен!?
Dialogue: 0,1:40:59.76,1:41:00.63,Default,,0,0,0,,Қалайсыз ба?
Dialogue: 0,1:41:00.72,1:41:02.09,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:41:02.18,1:41:05.51,Default,,0,0,0,,Қажет емес пе? Жарайды онда
Dialogue: 0,1:41:05.60,1:41:07.31,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:41:07.39,1:41:10.52,Default,,0,0,0,,Аники «Қағаз» жанып жатыр!
Dialogue: 0,1:41:10.60,1:41:11.44,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:14.02,1:41:16.32,Default,,0,0,0,,Басқа жол жоқ.
Dialogue: 0,1:41:16.40,1:41:17.40,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,1:41:17.48,1:41:19.86,Default,,0,0,0,,Ағаң да шапати жей ме?
Dialogue: 0,1:41:19.94,1:41:22.74,Default,,0,0,0,,Шинносуке ағай емес
Dialogue: 0,1:41:22.82,1:41:24.20,Default,,0,0,0,,Менің атым
Dialogue: 0,1:41:24.28,1:41:28.33,Default,,0,0,0,,Кабир Катчапапал Паккапапал Качапапал Паккапапал
Dialogue: 0,1:41:28.41,1:41:31.29,Default,,0,0,0,,Нобир кесе рамен Тез дайындаңыз Жылдам жеңіз
Dialogue: 0,1:41:31.37,1:41:32.79,Default,,0,0,0,,Жылдам тазалау?
Dialogue: 0,1:41:32.87,1:41:36.67,Default,,0,0,0,,Кабир Катчапапал Паккапапал Качапапал Паккапапал
Dialogue: 0,1:41:36.75,1:41:38.96,Default,,0,0,0,,Хохо, сосын тағы үш рет айт.
Dialogue: 0,1:41:39.05,1:41:39.88,Default,,0,0,0,,Иә?
Dialogue: 0,1:41:39.96,1:41:42.34,Default,,0,0,0,,Кабир Катчапапал Паккапапал Катчапапал Паккапапал
Dialogue: 0,1:41:42.42,1:41:44.72,Default,,0,0,0,,Кабир Катчапапал Паккапапал Каччапапал Паккапапал
Dialogue: 0,1:41:44.80,1:41:47.68,Default,,0,0,0,,Кабир Катчапапал Паккапапал Каччапапал Паккапапал
Dialogue: 0,1:41:47.76,1:41:49.81,Default,,0,0,0,,Мен мұны үш рет айттым. Айтыңызшы, Шинносуке.
Dialogue: 0,1:41:49.89,1:41:51.43,Default,,0,0,0,,Хохо, мен сені жақсы ести алмадым.
Dialogue: 0,1:41:51.52,1:41:52.68,Default,,0,0,0,,Тағы үш рет айтыңыз
Dialogue: 0,1:41:52.77,1:41:55.94,Default,,0,0,0,,Сәлем! Кабир Качаппапал…
Dialogue: 0,1:41:56.02,1:42:01.03,Default,,0,0,0,,♪～
Dialogue: 0,1:44:59.29,1:45:04.29,Default,,0,0,0,,～♪
