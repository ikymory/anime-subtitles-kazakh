Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.63,0:00:13.80,Default,,0,0,0,,Бас сүңгуір 02 Шо Янаги
Dialogue: 0,0:00:14.13,0:00:16.23,Default,,0,0,0,,Сондай-ақ 03 Қызыл үйеңкі
Dialogue: 0,0:00:16.70,0:00:19.36,Default,,0,0,0,,Мордиварп француз филиалынан келген.
Dialogue: 0,0:00:19.80,0:00:23.70,Default,,0,0,0,,Қош келдіңіз, Янаги-кун. Каэде-сан, Жапонияға бармағаныма біраз болды.
Dialogue: 0,0:00:24.13,0:00:26.30,Default,,0,0,0,,Көмегің үшін тағы да рахмет.
Dialogue: 0,0:00:27.06,0:00:30.23,Default,,0,0,0,,Кактустан көңілім қалды.
Dialogue: 0,0:00:30.90,0:00:32.33,Default,,0,0,0,,Жерлеу рәсімі өтті.
Dialogue: 0,0:00:32.93,0:00:34.70,Default,,0,0,0,,Дене әлі күйінде
Dialogue: 0,0:00:36.20,0:00:38.36,Default,,0,0,0,,Мен де оны бұрыннан білемін.
Dialogue: 0,0:00:38.86,0:00:40.30,Default,,0,0,0,,Мен оны әлі сезбеймін
Dialogue: 0,0:00:43.96,0:00:45.56,Default,,0,0,0,,Тез болғаным үшін кешіріңіз, бірақ
Dialogue: 0,0:00:46.03,0:00:47.06,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:00:47.76,0:00:49.83,Default,,0,0,0,,Сол үшін келдік
Dialogue: 0,0:00:51.10,0:00:52.10,Default,,0,0,0,,Онымен.
Dialogue: 0,0:00:58.66,0:01:08.26,Default,,0,0,0,,Көк домалақ үнсіздік
Dialogue: 0,0:01:10.56,0:01:18.76,Default,,0,0,0,,Күміс қайықтың жүзуі
Dialogue: 0,0:01:20.46,0:01:29.20,Default,,0,0,0,,Аты белгісіз адамдар
Dialogue: 0,0:01:32.40,0:01:40.23,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:01:43.46,0:01:52.50,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:01:52.76,0:02:00.90,Default,,0,0,0,,Жанға жол көрсету
Dialogue: 0,0:02:02.73,0:02:12.13,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:12.53,0:02:24.43,Default,,0,0,0,,Ағып жатқанда қозғалмаңыз...
Dialogue: 0,0:02:31.00,0:02:36.23,Default,,0,0,0,,А, мен енді бұл жерге келмеймін деп ойладым.
Dialogue: 0,0:02:39.23,0:02:43.30,Default,,0,0,0,,Хигги, сынықтар? Дұрыс, мен білдім
Dialogue: 0,0:02:43.66,0:02:44.50,Default,,0,0,0,,Иә
Dialogue: 0,0:02:44.56,0:02:46.03,Default,,0,0,0,,Уху-у-у-у-у-у
Dialogue: 0,0:02:46.16,0:02:46.70,Default,,0,0,0,,Хмм?
Dialogue: 0,0:02:47.10,0:02:50.26,Default,,0,0,0,,Кетан өте әлсіз.
Dialogue: 0,0:02:50.30,0:02:51.73,Default,,0,0,0,,О, жоқ, жоқ, олай емес
Dialogue: 0,0:02:51.83,0:02:55.60,Default,,0,0,0,,Бұл жерде біртүрлі нәрсе сезіледі.
Dialogue: 0,0:02:55.83,0:02:56.73,Default,,0,0,0,,Ахаха
Dialogue: 0,0:02:56.83,0:02:59.60,Default,,0,0,0,,Бірдеңе болып қалса, Кетан мені қорға.
Dialogue: 0,0:02:59.83,0:03:01.60,Default,,0,0,0,,Иә, Каэде-сан.
Dialogue: 0,0:03:02.20,0:03:07.50,Default,,0,0,0,,Кейтаның жүрек соғысы тез көтеріледі - Уау, жас, жас
Dialogue: 0,0:03:07.90,0:03:11.06,Default,,0,0,0,,Мүмкін Каэде-чанмен бірігіп кеткен қателік шығар.
Dialogue: 0,0:03:11.13,0:03:12.16,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:03:12.40,0:03:17.06,Default,,0,0,0,,Мен әдетте оянған адамдарға үйренгенмін, сондықтан Кей-чан мен Каэде-сан неге?
Dialogue: 0,0:03:17.76,0:03:21.83,Default,,0,0,0,,Мен Кейтаның қабілеті туралы өткен күні естідім, сондықтан сіз ең жақсы білетін адам шығарсыз.
Dialogue: 0,0:03:22.26,0:03:23.26,Default,,0,0,0,,Каэде-чан
Dialogue: 0,0:03:23.43,0:03:26.20,Default,,0,0,0,,Тіпті ұқсайтын болса да, бұл тапсырма үшін өте қолайлы.
Dialogue: 0,0:03:26.90,0:03:28.70,Default,,0,0,0,,Қос түр және Эспер
Dialogue: 0,0:03:29.36,0:03:31.56,Default,,0,0,0,,Өйткені ондаған миллион адамның біреуі ғана.
Dialogue: 0,0:03:32.06,0:03:36.83,Default,,0,0,0,,Оның үстіне бірдеңе болып қалса, Хиноки-чан менің артымда болады.
Dialogue: 0,0:03:37.73,0:03:41.80,Default,,0,0,0,,Менің ойымша, Көк балта өз тергеуіне жан тыныштығымен назар аудара алады.
Dialogue: 0,0:03:43.76,0:03:44.26,Default,,0,0,0,,Иә
Dialogue: 0,0:03:45.40,0:03:47.60,Default,,0,0,0,,Француз өнімдері де жақында қол жетімді.
Dialogue: 0,0:03:47.83,0:03:51.53,Default,,0,0,0,,Оянған адамдар негізгі мәліметтерді жинаса тиімдірек болар еді.
Dialogue: 0,0:03:53.20,0:03:55.03,Default,,0,0,0,,Камоме екінші орта мектебіндегі оқиға
Dialogue: 0,0:03:55.66,0:04:00.50,Default,,0,0,0,,Факультет пен қызметкерлерді түрмеге қамап, Хинокиге шабуыл жасаған адамның жеке басы анықталды.
Dialogue: 0,0:04:03.33,0:04:04.56,Default,,0,0,0,,Бұл адам болмайды
Dialogue: 0,0:04:04.73,0:04:06.13,Default,,0,0,0,,Директор?
Dialogue: 0,0:04:11.46,0:04:14.56,Default,,0,0,0,,Метан газының жарылуынан денеге қатты зақым келген.
Dialogue: 0,0:04:15.10,0:04:16.86,Default,,0,0,0,,Мен әлі нақты айта алмаймын.
Dialogue: 0,0:04:17.33,0:04:18.06,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:04:18.70,0:04:19.66,Default,,0,0,0,,Алджернон?
Dialogue: 0,0:04:20.96,0:04:24.80,Default,,0,0,0,,Бірақ бұл адам енді ғана қолданылған болуы мүмкін.
Dialogue: 0,0:04:25.43,0:04:26.66,Default,,0,0,0,,Оны кім пайдалана алады?
Dialogue: 0,0:04:27.10,0:04:28.53,Default,,0,0,0,,Мен онша көп білмеймін.
Dialogue: 0,0:04:29.53,0:04:33.86,Default,,0,0,0,,Өнеркәсіптік қалдықтарды өңдейтін жерасты қондырғысын ескі компьютер басқарды.
Dialogue: 0,0:04:34.46,0:04:37.73,Default,,0,0,0,,Нысан жабылғаннан бері қараусыз қалды.
Dialogue: 0,0:04:38.06,0:04:41.16,Default,,0,0,0,,Қолданылуы белгісіз жер асты кабелі қосылды.
Dialogue: 0,0:04:42.13,0:04:47.20,Default,,0,0,0,,А, сондықтан олар компьютерді бұзып, жұмыс роботын басқарды.
Dialogue: 0,0:04:47.66,0:04:48.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:49.10,0:04:52.30,Default,,0,0,0,,Мұндай арнайы бағдарламамен ойнау қандай ерлік.
Dialogue: 0,0:04:52.56,0:04:54.93,Default,,0,0,0,,Менің ойымша, бұл орта мектеп мұғалімі үшін мүмкін емес.
Dialogue: 0,0:04:55.36,0:04:57.16,Default,,0,0,0,,Бұл кабель қайда қосылады?
Dialogue: 0,0:04:58.33,0:05:02.16,Default,,0,0,0,,Қайта тергеуден бұрын Янаги-кун мен Каэде-санның Жапонияға оралуын күтіңіз.
Dialogue: 0,0:05:02.96,0:05:06.36,Default,,0,0,0,,Кабель қосылымы әлемнің төменгі жағында
Dialogue: 0,0:05:13.56,0:05:15.40,Default,,0,0,0,,Роботтың қашып кетуі оқиғаларының сериясы
Dialogue: 0,0:05:15.56,0:05:19.06,Default,,0,0,0,,Әлемнің төменгі қабатынан, одан әрі жер астынан шығады.
Dialogue: 0,0:05:19.30,0:05:21.80,Default,,0,0,0,,Бұл компьютерлік вирустың әсерінен болуы ықтимал.
Dialogue: 0,0:05:22.53,0:05:24.00,Default,,0,0,0,,Алджернонмен қарым-қатынасыңыз қандай?
Dialogue: 0,0:05:24.80,0:05:27.00,Default,,0,0,0,,Тергегенше білмейсің.
Dialogue: 0,0:05:27.50,0:05:27.96,Default,,0,0,0,,Ha
Dialogue: 0,0:05:28.33,0:05:31.50,Default,,0,0,0,,- Бұл, әрине, полицияның бақылауынан тыс - Күнәкар Күнәкар
Dialogue: 0,0:05:35.76,0:05:39.46,Default,,0,0,0,,Хм, әлгі жылтыр адам қайтадан пайда болатын сияқты.
Dialogue: 0,0:05:39.66,0:05:45.90,Default,,0,0,0,,Мирна Жердің тереңдігі, жойылу елі, Мирна
Dialogue: 0,0:05:47.20,0:05:50.40,Default,,0,0,0,,Мен мектепте көрген адам тәрізді жарық.
Dialogue: 0,0:05:50.83,0:05:52.13,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:52.63,0:05:55.60,Default,,0,0,0,,А, бірақ мен бір нәрсені дұрыс түсінбеген шығармын.
Dialogue: 0,0:05:56.43,0:05:58.10,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:05:58.56,0:06:00.63,Default,,0,0,0,,Кетан көрсе
Dialogue: 0,0:06:01.03,0:06:03.66,Default,,0,0,0,,Бұл шынымен де болды.
Dialogue: 0,0:06:03.93,0:06:06.83,Default,,0,0,0,,Түсіндің бе? Каэденің керемет күші
Dialogue: 0,0:06:07.43,0:06:09.96,Default,,0,0,0,,Жоқ, тек болжам.
Dialogue: 0,0:06:10.10,0:06:11.86,Default,,0,0,0,,Ахххх
Dialogue: 0,0:06:13.33,0:06:14.06,Default,,0,0,0,,О
Dialogue: 0,0:06:15.40,0:06:16.83,Default,,0,0,0,,Түнгі көру аймағы қосулы
Dialogue: 0,0:06:19.40,0:06:20.03,Default,,0,0,0,,Кетан
Dialogue: 0,0:06:20.16,0:06:20.63,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:06:21.00,0:06:22.33,Default,,0,0,0,,Бақылаңыз
Dialogue: 0,0:06:22.50,0:06:23.23,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:06:23.83,0:06:25.06,Default,,0,0,0,,UHUB БАСҚАРУ
Dialogue: 0,0:06:25.53,0:06:27.50,Default,,0,0,0,,Әй, iHub бақылауы!
Dialogue: 0,0:06:33.36,0:06:36.56,Default,,0,0,0,,Төңкерілмейінше, одан құтылу екіталай.
Dialogue: 0,0:06:41.93,0:06:45.23,Default,,0,0,0,,Мен жақсы түзетулер енгіземін, сондықтан жақсы қашпаңыз.
Dialogue: 0,0:06:45.56,0:06:48.90,Default,,0,0,0,,Иә? болдырмау? А иә аулақ болыңыз
Dialogue: 0,0:06:51.60,0:06:53.50,Default,,0,0,0,,Келесі сол жақ алдыңғы
Dialogue: 0,0:06:53.60,0:06:54.40,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:06:58.60,0:06:59.86,Default,,0,0,0,,Кей-чан керемет
Dialogue: 0,0:07:00.30,0:07:03.20,Default,,0,0,0,,Жоқ, мұның бәрі Каэде-чанның болжау қабілетінің арқасында.
Dialogue: 0,0:07:03.43,0:07:05.80,Default,,0,0,0,,Бұл сіздің болашақты көре аласыз дегенді білдіре ме?
Dialogue: 0,0:07:06.30,0:07:07.20,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:07:07.96,0:07:12.50,Default,,0,0,0,,Тікелей үңгірден бұрын жойылатын материалдың ішінде электромагниттік өрістің ауытқуы пайда болады.
Dialogue: 0,0:07:13.20,0:07:17.66,Default,,0,0,0,,Жер сілкінісі болмас бұрын балықтар жабайы болып, аңдар тез қашып кетеді деп бұрыннан айтылып келген.
Dialogue: 0,0:07:18.10,0:07:20.53,Default,,0,0,0,,Себебі бізде осы электромагниттік толқындарды қабылдау мүмкіндігі бар.
Dialogue: 0,0:07:21.36,0:07:24.53,Default,,0,0,0,,Бұл Каэде де бірдей сезім мүшелері бар екенін білдіреді.
Dialogue: 0,0:07:25.06,0:07:29.23,Default,,0,0,0,,Француз бөлімшесі де Каэденің доценттік принципін анықтауда қиналады.
Dialogue: 0,0:07:29.40,0:07:30.50,Default,,0,0,0,,Сіз азап шеккен сияқтысыз.
Dialogue: 0,0:07:31.06,0:07:34.20,Default,,0,0,0,,Өйткені, оның өзі де сол логиканы түсінбейді.
Dialogue: 0,0:07:34.83,0:07:38.43,Default,,0,0,0,,Енді сіз Каэде-чанның тергеуге ең жақсы адам екенін анық көре аласыз.
Dialogue: 0,0:07:39.53,0:07:42.20,Default,,0,0,0,,Білмеймін мен ақымақпын.
Dialogue: 0,0:07:45.53,0:07:47.93,Default,,0,0,0,,Хаа ха ха
Dialogue: 0,0:07:48.20,0:07:49.46,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:07:49.80,0:07:54.00,Default,,0,0,0,,Осы уақытқа дейін мен өзімді мүлде құлап бара жатқандай сезінбедім.
Dialogue: 0,0:07:54.73,0:07:57.76,Default,,0,0,0,,Ха, амал жоқ, бұл тағы да үлкен Чика-чанның жұмысы ма?
Dialogue: 0,0:07:58.06,0:08:02.00,Default,,0,0,0,,Жоқ, жақын жерде ештеңе жоқ, сондықтан уайымдамаңыз.
Dialogue: 0,0:08:02.50,0:08:05.13,Default,,0,0,0,,Уф, мен жеңілдеп қалдым.
Dialogue: 0,0:08:05.16,0:08:07.26,Default,,0,0,0,,- Кетан? - Иә, ол не?
Dialogue: 0,0:08:07.43,0:08:09.83,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:08:10.56,0:08:14.60,Default,,0,0,0,,Бұл белсенді режимдегі бала Бақа мырзаға ұқсамайды ма?
Dialogue: 0,0:08:15.06,0:08:15.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:16.33,0:08:21.23,Default,,0,0,0,,Хифун, не туралы айтып тұрсың? Жоқ, Каэде-сан сондай ойнақы.
Dialogue: 0,0:08:21.26,0:08:24.43,Default,,0,0,0,,А, жоқ, бұл шкалада оны болдырмау мүмкін емес.
Dialogue: 0,0:08:24.53,0:08:26.66,Default,,0,0,0,,бөліміне өтіңіз, келесі жолы не істейміз? иә?
Dialogue: 0,0:08:28.80,0:08:29.83,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:08:34.46,0:08:35.16,Default,,0,0,0,,К-чан
Dialogue: 0,0:08:35.56,0:08:36.86,Default,,0,0,0,,Әй, жарайды.
Dialogue: 0,0:08:37.23,0:08:38.70,Default,,0,0,0,,Оянған адамдар не болып жатыр?
Dialogue: 0,0:08:38.90,0:08:40.73,Default,,0,0,0,,Соққы мені бір жерден қағып кеткен сияқты.
Dialogue: 0,0:08:40.86,0:08:42.86,Default,,0,0,0,,Ақпаратты тасымалдау толығымен тоқтатылды.
Dialogue: 0,0:08:43.26,0:08:44.46,Default,,0,0,0,,Мен тірімін
Dialogue: 0,0:08:44.96,0:08:47.83,Default,,0,0,0,,Тозақ сияқты қараңғыда
Dialogue: 0,0:08:48.86,0:08:49.66,Default,,0,0,0,,Мен кетемін
Dialogue: 0,0:08:50.06,0:08:51.90,Default,,0,0,0,,Бірақ а
Dialogue: 0,0:08:53.60,0:08:58.33,Default,,0,0,0,,Хиноки-чан да бас сүңгуір. Мен достарыма сенемін.
Dialogue: 0,0:08:59.20,0:09:02.03,Default,,0,0,0,,Жүйенің өзі оянған және Кэтри.
Dialogue: 0,0:09:02.33,0:09:04.53,Default,,0,0,0,,Жоқ, Тиранның еш айырмашылығы жоқ.
Dialogue: 0,0:09:04.90,0:09:07.43,Default,,0,0,0,,Әдеттегідей сүңгіңіз, сонда бәрі жақсы болады.
Dialogue: 0,0:09:08.23,0:09:10.96,Default,,0,0,0,,Мен мұнымен жақсымын, сондықтан мен мұндамын.
Dialogue: 0,0:09:12.90,0:09:16.30,Default,,0,0,0,,Жарайды, техникалық қызмет көрсету құралын бұраңыз. Мен Тиранды шығарамын.
Dialogue: 0,0:09:18.66,0:09:20.13,Default,,0,0,0,,Мен гельдік кабельді алып тастаймын.
Dialogue: 0,0:09:21.50,0:09:24.33,Default,,0,0,0,,Жүйе қалыпты Woom басының шығысы OK
Dialogue: 0,0:09:25.06,0:09:28.20,Default,,0,0,0,,Serib басты шығысы OK Оны кез келген уақытта шығаруға болады.
Dialogue: 0,0:09:28.40,0:09:29.30,Default,,0,0,0,,Янаги мырза
Dialogue: 0,0:09:29.33,0:09:32.63,Default,,0,0,0,,О, бұл Сара-чан болатын.
Dialogue: 0,0:09:33.06,0:09:38.96,Default,,0,0,0,,Менің ойымша, Янаги мырза тек өзі көрген нәрсеге ғана сенбейді.
Dialogue: 0,0:09:39.40,0:09:43.76,Default,,0,0,0,,Бірақ сіз көре алмайтын нәрселерге күдіктеніңіз.
Dialogue: 0,0:09:43.83,0:09:47.03,Default,,0,0,0,,Ой хаха, түсіндім, есіме түсіремін.
Dialogue: 0,0:10:03.73,0:10:06.10,Default,,0,0,0,,Байланыстыру/қосқышты босату ОК
Dialogue: 0,0:10:08.70,0:10:11.86,Default,,0,0,0,,Бұл Тиран Иә, жақсы көрінеді.
Dialogue: 0,0:10:12.36,0:10:14.40,Default,,0,0,0,,Бұл жігітке де Хиноки-чан ұнайтын сияқты.
Dialogue: 0,0:10:14.86,0:10:15.96,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:10:16.30,0:10:17.90,Default,,0,0,0,,Иә Кеңейтілген
Dialogue: 0,0:10:40.60,0:10:41.33,Default,,0,0,0,,Фуфу
Dialogue: 0,0:10:44.96,0:10:47.46,Default,,0,0,0,,Сіздің қасыңызда
Dialogue: 0,0:11:05.03,0:11:07.50,Default,,0,0,0,,Керемет, мен өзімді жеңіл сезінемін
Dialogue: 0,0:11:10.16,0:11:12.90,Default,,0,0,0,,Оянғандардың байланысы үзілген жерге жететін кез келді.
Dialogue: 0,0:11:16.60,0:11:20.26,Default,,0,0,0,,Не екенін білмеймін, жүрегімді бірдеңе тартып жатқандай болдым.
Dialogue: 0,0:11:22.23,0:11:23.43,Default,,0,0,0,,Мұнда не болып жатыр?
Dialogue: 0,0:11:25.13,0:11:25.83,Default,,0,0,0,,Әлде…
Dialogue: 0,0:11:29.00,0:11:29.60,Default,,0,0,0,,Хиноки-чан
Dialogue: 0,0:11:29.73,0:11:30.33,Default,,0,0,0,,Иә
Dialogue: 0,0:11:30.66,0:11:32.20,Default,,0,0,0,,Бірдеңе келе жатыр, алда.
Dialogue: 0,0:11:32.76,0:11:33.36,Default,,0,0,0,,аулақ болыңыз
Dialogue: 0,0:11:42.56,0:11:43.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:45.23,0:11:45.96,Default,,0,0,0,,Кейінірек?
Dialogue: 0,0:11:46.43,0:11:47.66,Default,,0,0,0,,Оң жаққа жақындау реакциясы?
Dialogue: 0,0:11:51.43,0:11:52.56,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:11:55.70,0:11:57.76,Default,,0,0,0,,Датчикке қарсы бағыттан келу
Dialogue: 0,0:11:58.16,0:12:00.03,Default,,0,0,0,,Сосын ах-а-а
Dialogue: 0,0:12:03.63,0:12:06.63,Default,,0,0,0,,Көре алмайтын нәрседен күдіктеніңіз
Dialogue: 0,0:12:06.93,0:12:09.86,Default,,0,0,0,,Түсіндім, жарайды, Хиноки-чан, бақылауды қолға ал.
Dialogue: 0,0:12:10.10,0:12:12.70,Default,,0,0,0,,A Иә Uhub басқаруы
Dialogue: 0,0:12:12.93,0:12:14.03,Default,,0,0,0,,iHub басқаруы
Dialogue: 0,0:12:36.20,0:12:37.50,Default,,0,0,0,,Амансың ба? Аға
Dialogue: 0,0:12:37.80,0:12:38.53,Default,,0,0,0,,Сынап көрейін
Dialogue: 0,0:12:39.03,0:12:39.60,Default,,0,0,0,,Нитро
Dialogue: 0,0:12:47.76,0:12:48.40,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:12:48.66,0:12:50.30,Default,,0,0,0,,Сізге не шабуыл жасайды?
Dialogue: 0,0:12:51.96,0:12:54.96,Default,,0,0,0,,Өтінемін, Тиран, маған күшіңді берші.
Dialogue: 0,0:12:57.03,0:12:57.50,Default,,0,0,0,,Га
Dialogue: 0,0:12:58.70,0:12:59.16,Default,,0,0,0,,Га
Dialogue: 0,0:13:03.30,0:13:04.13,Default,,0,0,0,,Онда?
Dialogue: 0,0:13:10.36,0:13:11.53,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:11.80,0:13:14.00,Default,,0,0,0,,Бұл құрылысқа арналған қалқан машинасы.
Dialogue: 0,0:13:14.20,0:13:17.06,Default,,0,0,0,,Бұл діріл толқындары арқылы туннельдерді қазатын түрі.
Dialogue: 0,0:13:17.43,0:13:20.86,Default,,0,0,0,,Сонда көрінбейтін шабуыл сол соққы толқыны болды ма?
Dialogue: 0,0:13:21.36,0:13:24.56,Default,,0,0,0,,Бірақ ол неге Тиранның сенсорында?
Dialogue: 0,0:13:24.80,0:13:25.40,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:25.86,0:13:28.43,Default,,0,0,0,,Байланыс Ақпаратты жіберу үзілді.
Dialogue: 0,0:13:28.80,0:13:30.66,Default,,0,0,0,,Ей, сен қалжыңдамайсың.
Dialogue: 0,0:13:30.86,0:13:32.90,Default,,0,0,0,,Тиранға қос апат па?
Dialogue: 0,0:13:37.03,0:13:39.63,Default,,0,0,0,,Байланыс мүмкін емес Сенсор да біртүрлі
Dialogue: 0,0:13:39.96,0:13:41.26,Default,,0,0,0,,Мұны тек көзбен жасаңыз.
Dialogue: 0,0:13:51.26,0:13:52.40,Default,,0,0,0,,Шынында да, бұл жігіт жақсы адам болуы мүмкін, білесің бе?
Dialogue: 0,0:13:52.90,0:13:54.10,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:14:04.03,0:14:05.73,Default,,0,0,0,,А, сен мұны істедің.
Dialogue: 0,0:14:06.03,0:14:06.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:07.20,0:14:10.20,Default,,0,0,0,,Бұл Тиран әртүрлі жолдармен өзгертілген сияқты.
Dialogue: 0,0:14:10.53,0:14:11.30,Default,,0,0,0,,Қолөнер дегеніміз не?
Dialogue: 0,0:14:12.00,0:14:15.06,Default,,0,0,0,,Қарапайым соққы толқынын физикалық шабуылға ұқсату
Dialogue: 0,0:14:15.93,0:14:17.60,Default,,0,0,0,,Бұл жай ғана біздің сезімдеріміз болса да
Dialogue: 0,0:14:18.10,0:14:20.60,Default,,0,0,0,,Тиранның сенсорларын алдау оңай емес.
Dialogue: 0,0:14:21.33,0:14:23.26,Default,,0,0,0,,Сонымен қатар, бұл коммуникацияның бұзылуы
Dialogue: 0,0:14:24.93,0:14:26.43,Default,,0,0,0,,Жау ішімізде
Dialogue: 0,0:14:27.13,0:14:27.83,Default,,0,0,0,,Туыстар?
Dialogue: 0,0:14:35.40,0:14:36.00,Default,,0,0,0,,Хиноки-чан
Dialogue: 0,0:14:36.06,0:14:36.53,Default,,0,0,0,,Ах
Dialogue: 0,0:14:37.26,0:14:39.80,Default,,0,0,0,,Барлық мүмкін басқару элементтерін қолмен бекітіңіз.
Dialogue: 0,0:14:40.33,0:14:40.86,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:14:41.26,0:14:42.80,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:14:48.33,0:14:49.63,Default,,0,0,0,,Артқа немесе алға?
Dialogue: 0,0:14:50.40,0:14:53.63,Default,,0,0,0,,Функционалдық мінсіз болмағандықтан, кері қайту теориясы ма?
Dialogue: 0,0:14:54.76,0:14:55.66,Default,,0,0,0,,Не істеу керек? Шо
Dialogue: 0,0:14:56.50,0:14:59.73,Default,,0,0,0,,Сен Каедені осылай тастап кетесің.
Dialogue: 0,0:15:10.33,0:15:13.83,Default,,0,0,0,,Түсіндім, Кей, осылай жалғастырайық.
Dialogue: 0,0:15:15.03,0:15:16.90,Default,,0,0,0,,Қарғыс атсын, не болып жатыр?
Dialogue: 0,0:15:17.30,0:15:18.93,Default,,0,0,0,,Мен мүлде қалпына келе алмайтын сияқтымын.
Dialogue: 0,0:15:19.16,0:15:22.13,Default,,0,0,0,,Тым болмаса бәрінің қауіпсіз екенін біле алмайсың ба?
Dialogue: 0,0:15:22.50,0:15:23.80,Default,,0,0,0,,Бұл не, тау қарт?
Dialogue: 0,0:15:24.13,0:15:26.73,Default,,0,0,0,,Жоқ, мен ештеңе түсінбеймін.
Dialogue: 0,0:15:27.26,0:15:30.63,Default,,0,0,0,,Тым болмаса микросынықтарды өлшей алсақ.
Dialogue: 0,0:15:31.06,0:15:33.40,Default,,0,0,0,,Техникалық қызмет көрсету тасымалдаушылары, мен қараймын.
Dialogue: 0,0:15:33.50,0:15:34.90,Default,,0,0,0,,Өтінемін, Хэчин.
Dialogue: 0,0:15:35.36,0:15:40.83,Default,,0,0,0,,Алджернон иеленген кедей.
Dialogue: 0,0:15:41.36,0:15:45.10,Default,,0,0,0,,Жақын жерде Сіз кімсіз?
Dialogue: 0,0:15:59.63,0:16:02.03,Default,,0,0,0,,Ойын-сауық саябағының жертөлесінде осындай орын бар.
Dialogue: 0,0:16:06.53,0:16:08.03,Default,,0,0,0,,Бұл тозақ сияқты
Dialogue: 0,0:16:14.76,0:16:18.13,Default,,0,0,0,,Бұл нысан үлкен компьютер ретінде жұмыс істейді.
Dialogue: 0,0:16:18.93,0:16:22.30,Default,,0,0,0,,Бұрынғы оқиғалар осы жерде де бағдарламаланған болуы керек.
Dialogue: 0,0:16:29.16,0:16:29.63,Default,,0,0,0,,Га
Dialogue: 0,0:16:34.63,0:16:35.16,Default,,0,0,0,,Уф
Dialogue: 0,0:16:35.63,0:16:36.56,Default,,0,0,0,,Оянған адам?
Dialogue: 0,0:16:46.00,0:16:50.46,Default,,0,0,0,,Кешіріңіз, Шо, мен сізді басқара алмай қалдым.
Dialogue: 0,0:16:52.53,0:16:55.76,Default,,0,0,0,,Оянған адамдарда командаларды беру жүйесі де басқарылды ма?
Dialogue: 0,0:16:56.13,0:16:58.10,Default,,0,0,0,,Кечан Кечан жақсы ма?
Dialogue: 0,0:16:58.30,0:17:00.80,Default,,0,0,0,,Ой, қарғыс атқыр, не болып жатыр?
Dialogue: 0,0:17:00.86,0:17:03.26,Default,,0,0,0,,Менің қолым түспейді.
Dialogue: 0,0:17:12.76,0:17:13.40,Default,,0,0,0,,Кяах!
Dialogue: 0,0:17:26.16,0:17:30.16,Default,,0,0,0,,Уау, бұл керемет, Тиран.
Dialogue: 0,0:17:30.26,0:17:33.53,Default,,0,0,0,,Олар Оянған адамдарға қарағанда күш пен маневрлік жағынан жақсы емес пе?
Dialogue: 0,0:17:36.00,0:17:39.16,Default,,0,0,0,,Бұл кім? Оянған халықты кім басқарып отыр?
Dialogue: 0,0:17:41.23,0:17:44.63,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:17:45.36,0:17:48.10,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:17:52.56,0:17:53.30,Default,,0,0,0,,Кууу
Dialogue: 0,0:17:56.46,0:17:59.00,Default,,0,0,0,,Сіз ешқашан күткен жоқсыз
Dialogue: 0,0:18:00.83,0:18:03.33,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:18:04.23,0:18:06.96,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:18:14.03,0:18:18.46,Default,,0,0,0,,Гельдің шегін ұстануға жеткілікті орын жоқ сияқты.
Dialogue: 0,0:18:20.06,0:18:21.40,Default,,0,0,0,,Ояну синтезі
Dialogue: 0,0:18:25.53,0:18:27.03,Default,,0,0,0,,Сіз не істеп жатырсыз? Янаги мырза
Dialogue: 0,0:18:27.83,0:18:28.83,Default,,0,0,0,,Сіз мені естисіз бе? Каэде
Dialogue: 0,0:18:29.53,0:18:30.40,Default,,0,0,0,,анық
Dialogue: 0,0:18:30.90,0:18:31.83,Default,,0,0,0,,Мен саған сенемін.
Dialogue: 0,0:18:32.23,0:18:34.63,Default,,0,0,0,,Иә, мұны мүмкіндігінше қатты жасаңыз
Dialogue: 0,0:18:35.33,0:18:36.53,Default,,0,0,0,,Уаа
Dialogue: 0,0:18:38.16,0:18:39.40,Default,,0,0,0,,Ууууку а
Dialogue: 0,0:18:40.13,0:18:41.46,Default,,0,0,0,,Мұнда да?
Dialogue: 0,0:18:42.86,0:18:44.10,Default,,0,0,0,,Ақырында солай болды ма?
Dialogue: 0,0:18:44.56,0:18:45.46,Default,,0,0,0,,G-жиынтығы
Dialogue: 0,0:18:48.50,0:18:49.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:50.36,0:18:51.56,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:53.40,0:18:54.73,Default,,0,0,0,,Синапс белгісі
Dialogue: 0,0:19:05.83,0:19:06.63,Default,,0,0,0,,Kay?
Dialogue: 0,0:19:08.86,0:19:09.33,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:09.93,0:19:10.86,Default,,0,0,0,,И-иә… рас. Менің ағамдай… деп ойлаймын
Dialogue: 0,0:19:14.33,0:19:17.26,Default,,0,0,0,,Өйткені, сіз
Dialogue: 0,0:19:18.06,0:19:20.53,Default,,0,0,0,,Сіз күнәкар болдыңыз ба?
Dialogue: 0,0:19:42.06,0:19:46.63,Default,,0,0,0,,Әдеттегідей, бұл таңғажайып синапсты бомбалау болды, Шо.
Dialogue: 0,0:19:48.46,0:19:51.33,Default,,0,0,0,,Каэде сол жерде болғандықтан, мен сенімді түрде ататын болдым.
Dialogue: 0,0:19:51.76,0:19:53.46,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:53.80,0:19:55.00,Default,,0,0,0,,Асқын критикалық сұйықтық
Dialogue: 0,0:19:55.83,0:19:58.90,Default,,0,0,0,,Оянған адамдарды синаптикалық бомбалау нәтижесінде пайда болатын химиялық заттар.
Dialogue: 0,0:19:59.30,0:20:02.20,Default,,0,0,0,,Бұл одан әрі химиялық ыдырауға әкеліп соқты және оның орнын толтырды.
Dialogue: 0,0:20:03.03,0:20:04.70,Default,,0,0,0,,Кейбір қауіпті заттар қалғанымен
Dialogue: 0,0:20:04.93,0:20:07.56,Default,,0,0,0,,Каэде ионды ыдырауға мүмкіндік береді.
Dialogue: 0,0:20:07.93,0:20:09.46,Default,,0,0,0,,Ах хехе
Dialogue: 0,0:20:10.10,0:20:14.66,Default,,0,0,0,,Гель шегімен синхрондау таңқаларлық оңай болды.
Dialogue: 0,0:20:15.10,0:20:19.50,Default,,0,0,0,,Бұл таңғажайып, Каэде-сан, Эсперлердің істегені осы.
Dialogue: 0,0:20:20.93,0:20:21.60,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:28.46,0:20:29.33,Default,,0,0,0,,Қашып алайық
Dialogue: 0,0:20:34.56,0:20:37.00,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:20:37.20,0:20:40.30,Default,,0,0,0,,Хехехе хехехе
Dialogue: 0,0:20:40.60,0:20:41.10,Default,,0,0,0,,Га
Dialogue: 0,0:20:44.43,0:20:46.70,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:20:47.60,0:20:51.90,Default,,0,0,0,,Егер біз Лимипидтік арнадан өтпеген болсақ, біз де алданып қалар едік.
Dialogue: 0,0:20:53.03,0:20:53.96,Default,,0,0,0,,Алджернон
Dialogue: 0,0:20:56.83,0:20:58.43,Default,,0,0,0,,үшін толтырылған
Dialogue: 0,0:20:59.56,0:21:02.00,Default,,0,0,0,,Бұл маңызды заттай дәлел болды.
Dialogue: 0,0:21:02.60,0:21:04.60,Default,,0,0,0,,Уфуфу жарайды
Dialogue: 0,0:21:05.33,0:21:09.96,Default,,0,0,0,,Қажетті ақпаратты есте сақтаңыз.
Dialogue: 0,0:21:10.03,0:21:14.93,Default,,0,0,0,,Түсіндім, Каэде компьютердің магниттік орналасуын есте сақтай алды.
Dialogue: 0,0:21:15.40,0:21:16.83,Default,,0,0,0,,Қалай?
Dialogue: 0,0:21:17.53,0:21:18.86,Default,,0,0,0,,Бұл жылдам оқудың қолданбасы.
Dialogue: 0,0:21:19.60,0:21:23.03,Default,,0,0,0,,Деректердің үлкен көлемі қосу және өшіру сигналдарының қосындысы ғана.
Dialogue: 0,0:21:24.03,0:21:27.46,Default,,0,0,0,,Мен бұл үлгіні фотосурет сияқты миыма бірден жазамын.
Dialogue: 0,0:21:28.10,0:21:28.73,Default,,0,0,0,,Түсінесің бе?
Dialogue: 0,0:21:30.33,0:21:32.96,Default,,0,0,0,,Білмеймін мен ақымақпын.
Dialogue: 0,0:21:33.43,0:21:35.66,Default,,0,0,0,,Хара Холо Фин Хара Хифу
Dialogue: 0,0:21:41.86,0:21:45.90,Default,,0,0,0,,26 26 26
Dialogue: 0,0:21:46.33,0:21:52.26,Default,,0,0,0,,26 26 26 26
Dialogue: 0,0:21:52.56,0:21:56.26,Default,,0,0,0,,Хе хехе хаха хаха хахаха
Dialogue: 0,0:21:56.33,0:21:58.96,Default,,0,0,0,,Ууу хахаха
Dialogue: 0,0:21:59.10,0:22:01.50,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:22:03.30,0:22:07.03,Default,,0,0,0,,У-у-у-хмм
Dialogue: 0,0:22:08.66,0:22:11.46,Default,,0,0,0,,...
Dialogue: 0,0:22:14.20,0:22:18.46,Default,,0,0,0,,Ааа
Dialogue: 0,0:22:18.63,0:22:19.96,Default,,0,0,0,,Ахх
Dialogue: 0,0:22:22.70,0:22:27.96,Default,,0,0,0,,26... 26 26 26
Dialogue: 0,0:22:28.06,0:22:29.83,Default,,0,0,0,,Уау
Dialogue: 0,0:22:34.60,0:22:47.36,Default,,0,0,0,,Құдайдың күнәсі шексіз теломераларға жазылды
Dialogue: 0,0:22:47.90,0:22:54.06,Default,,0,0,0,,Жалынды құшақтау
Dialogue: 0,0:22:54.56,0:23:01.66,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:01.96,0:23:05.23,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.50,0:23:08.63,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.86,0:23:12.03,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.36,0:23:15.66,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.50,0:23:27.10,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:27.70,0:23:37.40,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:38.00,0:23:48.93,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:59.43,0:24:03.36,Default,,0,0,0,,Үндістанның Аджанта үңгірлері
Dialogue: 0,0:24:03.90,0:24:07.40,Default,,0,0,0,,Барлық жұмбақ жасырылған жер
Dialogue: 0,0:24:08.00,0:24:10.06,Default,,0,0,0,,Қайғылы қоңырау
Dialogue: 0,0:24:10.36,0:24:11.63,Default,,0,0,0,,жаңғырық
Dialogue: 0,0:24:12.93,0:24:14.23,Default,,0,0,0,,Бегемот
Dialogue: 0,0:24:14.63,0:24:15.96,Default,,0,0,0,,Бегемот
Dialogue: 0,0:24:16.40,0:24:20.26,Default,,0,0,0,,Ааа
Dialogue: 0,0:24:21.80,0:24:24.73,Default,,0,0,0,,Сізге келе жатыр
Dialogue: 0,0:24:26.23,0:24:32.23,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
