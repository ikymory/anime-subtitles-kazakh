Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.63,0:00:21.70,Default,,0,0,0,,Igideruu
Dialogue: 0,0:00:21.76,0:00:24.43,Default,,0,0,0,,Эй, басқа жігіттер ше?
Dialogue: 0,0:00:24.56,0:00:28.23,Default,,0,0,0,,Тиран және Оянған адамдардың сәйкестендіру сигналдары үзіліссіз.
Dialogue: 0,0:00:28.83,0:00:29.40,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:00:29.80,0:00:31.46,Default,,0,0,0,,Мен өте ақылсызмын.
Dialogue: 0,0:00:31.93,0:00:32.90,Default,,0,0,0,,Коммуникация – бұл
Dialogue: 0,0:00:33.50,0:00:35.10,Default,,0,0,0,,Жөндеу қажет
Dialogue: 0,0:00:35.23,0:00:36.60,Default,,0,0,0,,Әй, әпке
Dialogue: 0,0:00:37.00,0:00:40.13,Default,,0,0,0,,Бұл Брахман деген не?
Dialogue: 0,0:00:40.26,0:00:43.56,Default,,0,0,0,,Дене құрылысы туралы біраз мәлімет алуымыз керек.
Dialogue: 0,0:00:43.60,0:00:44.83,Default,,0,0,0,,-Мен ештеңе айта алмаймын -Ах!
Dialogue: 0,0:00:44.90,0:00:46.30,Default,,0,0,0,,Сакора Сіз бірдеңе білесіз бе?
Dialogue: 0,0:00:47.26,0:00:52.66,Default,,0,0,0,,Брахман әлі де өз күштерін дұрыс пайдалана алмайды.
Dialogue: 0,0:00:53.03,0:00:57.56,Default,,0,0,0,,Енді мен әлі, тынышпын.
Dialogue: 0,0:00:59.86,0:01:09.13,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:01:11.56,0:01:19.66,Default,,0,0,0,,Қалқымалы күміс қайық
Dialogue: 0,0:01:21.53,0:01:30.13,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:01:33.36,0:01:41.50,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:01:44.56,0:01:53.33,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:01:53.83,0:02:01.86,Default,,0,0,0,,Жанға бағыт беру
Dialogue: 0,0:02:03.46,0:02:13.40,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:13.56,0:02:25.63,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:02:38.60,0:02:41.86,Default,,0,0,0,,Ха ха ха ха Хиноки жақсысың ба?
Dialogue: 0,0:02:42.86,0:02:43.43,Default,,0,0,0,,Иә
Dialogue: 0,0:02:44.13,0:02:47.03,Default,,0,0,0,,Жарылыс күшінен жер шұңқырланып кеткен сияқты.
Dialogue: 0,0:02:47.63,0:02:50.40,Default,,0,0,0,,Бұл қараусыз қалған жерасты нысаны.
Dialogue: 0,0:02:51.70,0:02:52.93,Default,,0,0,0,,Брахманға не болды?
Dialogue: 0,0:02:53.46,0:02:54.40,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:02:55.23,0:02:58.40,Default,,0,0,0,,Ең болмаса жақын жерде емес сияқты.
Dialogue: 0,0:02:59.16,0:03:00.26,Default,,0,0,0,,Директор, Шығыс пен Батыс арасындағы бейбітшіліктің тағдыры осы «Стракс» операциясына тәуелді,
Dialogue: 0,0:03:00.80,0:03:03.36,Default,,0,0,0,,Акамацу мырзаға және басқаларға хабарласқан дұрыс.
Dialogue: 0,0:03:03.86,0:03:07.46,Default,,0,0,0,,Мен тырысып жатырмын, бірақ басқа жақтан жауап алмаймын.
Dialogue: 0,0:03:07.90,0:03:09.33,Default,,0,0,0,,Сізді ұрып-соқты
Dialogue: 0,0:03:09.86,0:03:12.86,Default,,0,0,0,,Контрэйлерлер нейроидтар сияқты берік емес.
Dialogue: 0,0:03:13.70,0:03:17.66,Default,,0,0,0,,Егер олардың бәрі бірге жер астында ағып кетсе, олардың бір жерде жерленген болуы мүмкін.
Dialogue: 0,0:03:18.06,0:03:21.56,Default,,0,0,0,,Хмм, мен шынымен түсінбеймін.
Dialogue: 0,0:03:21.96,0:03:25.43,Default,,0,0,0,,Егер сіз жеткілікті түрде жақындасаңыз, электромагниттік толқындарды қабылдауға болады.
Dialogue: 0,0:03:25.70,0:03:26.50,Default,,0,0,0,,Іздеп көрейік
Dialogue: 0,0:03:27.70,0:03:30.96,Default,,0,0,0,,Жарайды, екіге бөлеміз, бірақ абай болыңыз.
Dialogue: 0,0:03:31.60,0:03:33.33,Default,,0,0,0,,Егер бірдеңе болса, маған дереу хабарласыңыз.
Dialogue: 0,0:03:33.86,0:03:35.13,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:03:58.93,0:04:02.76,Default,,0,0,0,,Бұл мен Куширодағы ғылыми-зерттеу институтында көрген Беттерман деген әйел.
Dialogue: 0,0:04:03.46,0:04:06.13,Default,,0,0,0,,Хиноки өзінің анасына ұқсайтынын айтты.
Dialogue: 0,0:04:07.93,0:04:08.36,Default,,0,0,0,,Иә
Dialogue: 0,0:04:11.93,0:04:16.13,Default,,0,0,0,,Менің ойымша, бұл апа Тұмандық немесе Форте сияқты өзгере ме?
Dialogue: 0,0:04:17.26,0:04:18.10,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:04:18.63,0:04:23.00,Default,,0,0,0,,Мен мектептің жертөлесінде көрген жарыққа ұқсайтын сияқтымын.
Dialogue: 0,0:04:26.46,0:04:27.43,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:04:29.06,0:04:34.23,Default,,0,0,0,,Беттермен Ламия соңғы кездері алдымызда көрінбеді.
Dialogue: 0,0:04:40.00,0:04:41.86,Default,,0,0,0,,Келесі жолы біз шымшып қаламыз
Dialogue: 0,0:04:42.33,0:04:44.93,Default,,0,0,0,,Қызық, анау келіншек тағы да көмекке келе ме?
Dialogue: 0,0:04:47.10,0:04:48.03,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:04:48.76,0:04:49.46,Default,,0,0,0,,Хиноки?
Dialogue: 0,0:04:50.03,0:04:51.16,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:04:51.40,0:04:53.60,Default,,0,0,0,,Мен сияқты ақымақтарды тыңдама.
Dialogue: 0,0:04:55.90,0:04:56.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:58.30,0:04:59.96,Default,,0,0,0,,Неліктен кешірім сұрайсыз?
Dialogue: 0,0:05:01.56,0:05:02.96,Default,,0,0,0,,Кей Чан жаман емес.
Dialogue: 0,0:05:04.20,0:05:06.26,Default,,0,0,0,,Жарайды, өйткені мен ақымақпын
Dialogue: 0,0:05:07.56,0:05:11.30,Default,,0,0,0,,Мен Хинокиден әлдеқайда ақымақпын.
Dialogue: 0,0:05:17.30,0:05:20.96,Default,,0,0,0,,Шо Бұл менмін, мен әрқашан Шомен бірге боламын.
Dialogue: 0,0:05:21.63,0:05:23.33,Default,,0,0,0,,Шомен өмір
Dialogue: 0,0:05:23.96,0:05:25.76,Default,,0,0,0,,Бұл сөз тіркесін жасау жағдайы ма?
Dialogue: 0,0:05:26.33,0:05:27.46,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:30.60,0:05:34.60,Default,,0,0,0,,Брахман мен үшін жаратылды.
Dialogue: 0,0:05:36.56,0:05:39.96,Default,,0,0,0,,Мен Брахманның не екенін түсінбеймін.
Dialogue: 0,0:05:40.80,0:05:41.86,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:05:42.53,0:05:47.06,Default,,0,0,0,,Кеңістікте бар энергияның энергиясы теңдестірілген түрде қосылды.
Dialogue: 0,0:05:47.90,0:05:51.00,Default,,0,0,0,,Сол себепті әрқайсысының қабілеті әртүрлі болды.
Dialogue: 0,0:05:51.16,0:05:53.33,Default,,0,0,0,,Маған дозинг пайдаланушы керек болды.
Dialogue: 0,0:05:56.10,0:05:58.50,Default,,0,0,0,,Менің ойымша, бұл дәмді карри жасаумен бірдей.
Dialogue: 0,0:05:59.53,0:06:02.06,Default,,0,0,0,,Сәбіз Пияз Картоп Ет
Dialogue: 0,0:06:02.96,0:06:05.46,Default,,0,0,0,,Егер сіз жақсы балансты қоспасаңыз, оның дәмі болмайды.
Dialogue: 0,0:06:05.90,0:06:09.60,Default,,0,0,0,,Міне, сондықтан мен суперадамдар альянсына қажет болдым, солай ма?
Dialogue: 0,0:06:10.53,0:06:11.96,Default,,0,0,0,,Каэде картоп па?
Dialogue: 0,0:06:12.26,0:06:13.43,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:06:13.63,0:06:15.63,Default,,0,0,0,,Мен картоп шаңғышысымын
Dialogue: 0,0:06:16.30,0:06:17.16,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:22.46,0:06:24.06,Default,,0,0,0,,Өйткені бүршіктер өсе бастады
Dialogue: 0,0:06:25.53,0:06:29.76,Default,,0,0,0,,Дәмі күшті болғаны сонша, мен картоп шаңғысын жей алмадым.
Dialogue: 0,0:06:31.20,0:06:33.06,Default,,0,0,0,,Сол бүршік үшін алғыс айтуым керек пе?
Dialogue: 0,0:06:33.73,0:06:35.10,Default,,0,0,0,,Шоға рахмет
Dialogue: 0,0:06:35.56,0:06:36.03,Default,,0,0,0,,Иә
Dialogue: 0,0:06:38.50,0:06:42.00,Default,,0,0,0,,Superhuman Alliance штаб-пәтерінде жаңбыр суы үшін жерасты бассейні бар.
Dialogue: 0,0:06:42.63,0:06:45.46,Default,,0,0,0,,200-ден астам қызметкер жұмыспен қамту тірегі болды.
Dialogue: 0,0:06:47.43,0:06:50.46,Default,,0,0,0,,Бетермендер қазір адамдардан гүлдейтін анимус гүлдерін пайдаланады.
Dialogue: 0,0:06:51.20,0:06:54.63,Default,,0,0,0,,Брахман да адамдардың энергиясын түрлендіру катализаторы ретінде пайдаланатын сияқты.
Dialogue: 0,0:06:55.63,0:06:58.43,Default,,0,0,0,,Джинбашира-сан және басқалары болған бассейндегі су.
Dialogue: 0,0:06:59.13,0:07:00.13,Default,,0,0,0,,Байланыстырушы гель
Dialogue: 0,0:07:01.10,0:07:03.96,Default,,0,0,0,,Ертедегі Тиранды осылай атағым келді.
Dialogue: 0,0:07:04.83,0:07:05.83,Default,,0,0,0,,Мен кеше тексердім
Dialogue: 0,0:07:06.36,0:07:09.96,Default,,0,0,0,,Жиналу керек болатын байланыстырушы гель оның бүкіл контейнерімен ауыстырылды.
Dialogue: 0,0:07:10.60,0:07:13.13,Default,,0,0,0,,Адамнан тыс одақ оны ұрлады.
Dialogue: 0,0:07:13.76,0:07:18.33,Default,,0,0,0,,Дұрыс, олар да полициямен айла-шарғы жасап, Akamatsu Industries-ке кірді.
Dialogue: 0,0:07:19.43,0:07:21.16,Default,,0,0,0,,Ол байланыстырушы гельге бағытталған.
Dialogue: 0,0:07:22.56,0:07:26.16,Default,,0,0,0,,Линкер гелі - өте қымбат нәрсе.
Dialogue: 0,0:07:28.06,0:07:32.93,Default,,0,0,0,,Бірақ олардың амбицияларын құрметті Якусуги басып тастады.
Dialogue: 0,0:07:39.50,0:07:42.06,Default,,0,0,0,,Бұл адам қайтыс болды.
Dialogue: 0,0:07:42.66,0:07:47.40,Default,,0,0,0,,Құрметті Якусуги Ойланып қарасаңыз, ол да адамнан асып түсетін адам баласы.
Dialogue: 0,0:07:47.93,0:07:50.10,Default,,0,0,0,,Жақсы адам деп аталса, таң қалмас еді.
Dialogue: 0,0:07:51.26,0:07:52.86,Default,,0,0,0,,Болжалды жас 120 жас
Dialogue: 0,0:07:53.86,0:07:54.80,Default,,0,0,0,,Әлемді саяхаттау
Dialogue: 0,0:07:55.20,0:08:00.56,Default,,0,0,0,,Жаман ойлар деп аталатын теріс энергияны жою жұмысын жалғастырған сиқыршы болды.
Dialogue: 0,0:08:10.90,0:08:11.46,Default,,0,0,0,,Ах
Dialogue: 0,0:08:12.93,0:08:14.33,Default,,0,0,0,,бір нәрсені сезіну
Dialogue: 0,0:08:14.66,0:08:15.40,Default,,0,0,0,,Брахман?
Dialogue: 0,0:08:16.03,0:08:16.66,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:17.56,0:08:20.06,Default,,0,0,0,,Егер оның энергия көзі линкер гелі болса.
Dialogue: 0,0:08:21.30,0:08:23.83,Default,,0,0,0,,Ол тағы да алдымызда шығуы мүмкін.
Dialogue: 0,0:08:28.26,0:08:28.70,Default,,0,0,0,,Ах
Dialogue: 0,0:08:29.53,0:08:30.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:30.63,0:08:31.90,Default,,0,0,0,,Хокс та керемет болды.
Dialogue: 0,0:08:32.60,0:08:33.53,Default,,0,0,0,,Яғни
Dialogue: 0,0:08:36.33,0:08:37.30,Default,,0,0,0,,Контрейлер
Dialogue: 0,0:08:45.03,0:08:49.03,Default,,0,0,0,,Хм, менің ойымша, бұл жер бұрын қоқыс үйіндісі болған.
Dialogue: 0,0:08:55.00,0:08:55.93,Default,,0,0,0,,Қандай дыбыс?
Dialogue: 0,0:09:06.76,0:09:07.30,Default,,0,0,0,,Uhi
Dialogue: 0,0:09:13.86,0:09:14.60,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:09:17.53,0:09:18.43,Default,,0,0,0,,Иә? Уф
Dialogue: 0,0:09:25.40,0:09:26.86,Default,,0,0,0,,Ууууууу қате
Dialogue: 0,0:09:27.70,0:09:28.43,Default,,0,0,0,,К-чан
Dialogue: 0,0:09:28.86,0:09:32.50,Default,,0,0,0,,Қате қате қате
Dialogue: 0,0:09:32.56,0:09:36.46,Default,,0,0,0,,Эй Кей-чан, шығаруды тым көп арттырыңыз, сіз гель шегіне жетесіз.
Dialogue: 0,0:09:36.63,0:09:37.26,Default,,0,0,0,,Жәндіктер
Dialogue: 0,0:09:38.96,0:09:39.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:40.40,0:09:43.06,Default,,0,0,0,,Не болып жатыр? Тынышталыңыз.
Dialogue: 0,0:09:43.43,0:09:45.86,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:09:46.33,0:09:49.03,Default,,0,0,0,,Дұрыс, сіз тынышталуыңыз керек.
Dialogue: 0,0:09:51.26,0:09:51.70,Default,,0,0,0,,Уф
Dialogue: 0,0:10:01.53,0:10:02.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.96,0:10:10.13,Default,,0,0,0,,Бо Бо Бо Бо Бу
Dialogue: 0,0:10:14.50,0:10:18.76,Default,,0,0,0,,Жәндіктер Маған ұнамайды.
Dialogue: 0,0:10:19.33,0:10:23.26,Default,,0,0,0,,Жоқ, маған ұнамайды, маған ұнамайды.
Dialogue: 0,0:10:23.40,0:10:24.26,Default,,0,0,0,,К-чан
Dialogue: 0,0:10:25.50,0:10:26.20,Default,,0,0,0,,Нитро
Dialogue: 0,0:10:31.30,0:10:33.96,Default,,0,0,0,,Шынымен, сауыт еріп жатыр.
Dialogue: 0,0:10:35.56,0:10:38.43,Default,,0,0,0,,Бұл синаптикалық бомбалау сияқты химиялық шабуыл ма?
Dialogue: 0,0:10:39.26,0:10:41.00,Default,,0,0,0,,Көк Балта-кун, Хиноки-сан, мені естисің бе?
Dialogue: 0,0:10:41.66,0:10:42.96,Default,,0,0,0,,Тиран бұл жігітті тоқтатады.
Dialogue: 0,0:10:43.40,0:10:45.66,Default,,0,0,0,,Оянған адамның қабылдау режимінде деректерді жинаңыз.
Dialogue: 0,0:10:46.06,0:10:46.83,Default,,0,0,0,,Сынап көрейін
Dialogue: 0,0:10:47.43,0:10:48.10,Default,,0,0,0,,Кимоноым шаңмен кірленді.
Dialogue: 0,0:10:48.90,0:10:49.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:51.40,0:10:51.90,Default,,0,0,0,,Уф
Dialogue: 0,0:10:52.36,0:10:54.46,Default,,0,0,0,,Мен саған сенемін Хинопи
Dialogue: 0,0:10:55.26,0:10:55.83,Default,,0,0,0,,Иә
Dialogue: 0,0:10:56.40,0:10:57.03,Default,,0,0,0,,К-чан
Dialogue: 0,0:10:57.40,0:10:59.63,Default,,0,0,0,,Ууууууууууууууууууууу!
Dialogue: 0,0:10:59.66,0:11:00.66,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:11:01.26,0:11:02.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:03.16,0:11:06.00,Default,,0,0,0,,Уау, маған енді ұнамайды, енді ұнамайды.
Dialogue: 0,0:11:06.33,0:11:07.60,Default,,0,0,0,,Кей-чан, тыңда.
Dialogue: 0,0:11:08.23,0:11:11.16,Default,,0,0,0,,Себебі Кечан қасымда болды.
Dialogue: 0,0:11:12.40,0:11:13.93,Default,,0,0,0,,Мен осы уақытқа дейін көп еңбек еттім.
Dialogue: 0,0:11:15.46,0:11:19.26,Default,,0,0,0,,Янаги-сан да, Каэде-сан да өмір сүру үшін күресуде.
Dialogue: 0,0:11:20.03,0:11:21.43,Default,,0,0,0,,Біз де күресейік
Dialogue: 0,0:11:23.00,0:11:23.50,Default,,0,0,0,,Ах
Dialogue: 0,0:11:25.43,0:11:28.13,Default,,0,0,0,,Әй, Кейтаға не болды?
Dialogue: 0,0:11:28.43,0:11:32.00,Default,,0,0,0,,Хинокидің қос импульсі 130% жоғары
Dialogue: 0,0:11:32.36,0:11:34.83,Default,,0,0,0,,Қыздың көзқарасын елемеу
Dialogue: 0,0:11:35.23,0:11:36.83,Default,,0,0,0,,Кибатарея Кейта
Dialogue: 0,0:11:37.46,0:11:38.03,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:11:39.00,0:11:39.60,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:11:40.53,0:11:42.73,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:11:43.50,0:11:46.20,Default,,0,0,0,,Мен өзім ештеңе істей алмаймын.
Dialogue: 0,0:11:46.73,0:11:48.90,Default,,0,0,0,,Менсіз істей алмайтын нәрселер бар.
Dialogue: 0,0:11:50.03,0:11:52.66,Default,,0,0,0,,Сіз деректер жинадыңыз, Хиноки.
Dialogue: 0,0:11:53.60,0:11:55.80,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:11:56.40,0:11:57.10,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:11:58.06,0:11:59.53,Default,,0,0,0,,UHUB БАСҚАРУ
Dialogue: 0,0:12:00.20,0:12:01.76,Default,,0,0,0,,iHub басқаруы
Dialogue: 0,0:12:14.66,0:12:15.46,Default,,0,0,0,,Талдау
Dialogue: 0,0:12:20.13,0:12:22.56,Default,,0,0,0,,Деректер оянған адамнан тасымалданды.
Dialogue: 0,0:12:23.33,0:12:26.83,Default,,0,0,0,,NEO бір кездері шебер ретінде адамзаттың шегін болжаған.
Dialogue: 0,0:12:27.20,0:12:29.26,Default,,0,0,0,,Сол шектен шығуға тырысты
Dialogue: 0,0:12:29.80,0:12:33.90,Default,,0,0,0,,Бірақ бұл әрекет, сүңгуді тексеру сәтсіз аяқталды.
Dialogue: 0,0:12:34.50,0:12:36.83,Default,,0,0,0,,Көп ұзамай біз Мордиварп боламыз
Dialogue: 0,0:12:37.40,0:12:40.03,Default,,0,0,0,,BPL адамнан тыс альянсқа бөлінген
Dialogue: 0,0:12:40.63,0:12:42.60,Default,,0,0,0,,Әрбір мүмкіндікті зерттеді
Dialogue: 0,0:12:49.20,0:12:51.13,Default,,0,0,0,,Баратын жері сол Брахман
Dialogue: 0,0:12:51.93,0:12:54.13,Default,,0,0,0,,Жоқ, мен мақұлдамаймын.
Dialogue: 0,0:12:57.56,0:13:00.13,Default,,0,0,0,,Өтінемін, Тиран, маған тағы біраз беріңізші.
Dialogue: 0,0:13:03.43,0:13:04.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:04.43,0:13:05.10,Default,,0,0,0,,Хиноки
Dialogue: 0,0:13:10.16,0:13:11.63,Default,,0,0,0,,Бұл Брахманның құрылымы
Dialogue: 0,0:13:11.93,0:13:15.10,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз оның әлсіздігін таптыңыз ба?
Dialogue: 0,0:13:17.46,0:13:19.06,Default,,0,0,0,,UHUB БАСҚАРУ
Dialogue: 0,0:13:19.70,0:13:21.73,Default,,0,0,0,,iHub басқаруы
Dialogue: 0,0:13:22.96,0:13:25.36,Default,,0,0,0,,Брахман – дененің икемді құрылымы
Dialogue: 0,0:13:26.73,0:13:29.26,Default,,0,0,0,,Ұқсас мүшелер адамда да бар
Dialogue: 0,0:13:30.73,0:13:31.53,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:13:33.76,0:13:35.83,Default,,0,0,0,,Бұл қуық
Dialogue: 0,0:13:37.46,0:13:38.00,Default,,0,0,0,,Иә
Dialogue: 0,0:13:39.70,0:13:40.90,Default,,0,0,0,,Қуық сорпасы
Dialogue: 0,0:13:44.26,0:13:47.00,Default,,0,0,0,,Қуық кейде бірнеше ондаған рет кеңейіп, жиырылады.
Dialogue: 0,0:13:47.33,0:13:51.60,Default,,0,0,0,,Қалыңдығы бірнеше молекула қалың болса да функционалдылықты сақтауға болады.
Dialogue: 0,0:13:52.20,0:13:56.83,Default,,0,0,0,,Брахманның үнемі туатын ядродан басқа қуатты сепкіш энергиясы бар
Dialogue: 0,0:13:57.20,0:14:00.00,Default,,0,0,0,,Бұл кеңею мен жиырылуын еркін басқара алатын көпіршіктен басқа ештеңе емес.
Dialogue: 0,0:14:03.06,0:14:04.46,Default,,0,0,0,,Мен мұны сұрадым, Кей Чан.
Dialogue: 0,0:14:04.70,0:14:08.70,Default,,0,0,0,,Ах, Янаги-сан мен Каэде-санның күш-жігері босқа кетеді.
Dialogue: 0,0:14:09.23,0:14:10.40,Default,,0,0,0,,Үзіліс синтезі
Dialogue: 0,0:14:14.93,0:14:16.26,Default,,0,0,0,,Ұшақтың өз шегі бар
Dialogue: 0,0:14:17.13,0:14:19.96,Default,,0,0,0,,Жарайды, мені Кетан деп атаңыз.
Dialogue: 0,0:14:20.60,0:14:24.83,Default,,0,0,0,,Сіз Linker Gel-ге берілетін адамдардың қос импульстарын біле аласыз ба?
Dialogue: 0,0:14:26.93,0:14:29.96,Default,,0,0,0,,Мен осы уақытқа дейін Нейроноидпен бірге болған адамдардың қабілеттері.
Dialogue: 0,0:14:30.33,0:14:35.20,Default,,0,0,0,,Өз қабілеттерін өзінің қабілетіне шебер түрлендіре алатын өсуге бағытталған бас сүңгуір.
Dialogue: 0,0:14:36.83,0:14:40.56,Default,,0,0,0,,Сондықтан сіз Брахманды таңқаларлық оңай жеңе аласыз.
Dialogue: 0,0:14:41.43,0:14:42.26,Default,,0,0,0,,G-жиынтығы
Dialogue: 0,0:14:43.23,0:14:44.63,Default,,0,0,0,,Ахх
Dialogue: 0,0:14:47.63,0:14:49.73,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:14:55.60,0:14:56.06,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:58.50,0:14:59.96,Default,,0,0,0,,Уууу
Dialogue: 0,0:15:00.73,0:15:01.23,Default,,0,0,0,,Га
Dialogue: 0,0:15:08.86,0:15:11.83,Default,,0,0,0,,Уау
Dialogue: 0,0:15:12.96,0:15:14.60,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,0:15:15.46,0:15:17.00,Default,,0,0,0,,Оянған адам босатылды
Dialogue: 0,0:15:17.30,0:15:20.53,Default,,0,0,0,,Линкер алкалоидтары негізінде синтезделген химиялық заттар
Dialogue: 0,0:15:21.00,0:15:22.66,Default,,0,0,0,,О, мен мұны білемін.
Dialogue: 0,0:15:22.96,0:15:25.06,Default,,0,0,0,,Дәнсіз жүзім жасауға дәрі ғой, солай ма?
Dialogue: 0,0:15:25.46,0:15:26.03,Default,,0,0,0,,Иә
Dialogue: 0,0:15:26.36,0:15:28.70,Default,,0,0,0,,Бұл ұяшықты белсендіру қуатын басуы мүмкін
Dialogue: 0,0:15:29.13,0:15:32.93,Default,,0,0,0,,Тепе-теңдігін жоғалтқан брахман өз денесін басқара алмайды.
Dialogue: 0,0:15:33.06,0:15:36.50,Default,,0,0,0,,Ууууууууууууу...
Dialogue: 0,0:15:36.83,0:15:37.56,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:15:38.03,0:15:40.13,Default,,0,0,0,,Ой, балалар жеңдіңдер.
Dialogue: 0,0:15:40.86,0:15:42.50,Default,,0,0,0,,Көк Балта-кун Хиноки-чан
Dialogue: 0,0:15:43.60,0:15:46.40,Default,,0,0,0,,Өйткені Янаги-сан мен Каэде-сан сонда болды
Dialogue: 0,0:15:53.70,0:15:55.80,Default,,0,0,0,,О, бірдеңе келе жатыр.
Dialogue: 0,0:15:56.23,0:15:57.60,Default,,0,0,0,,Танк сияқты
Dialogue: 0,0:15:58.70,0:16:01.03,Default,,0,0,0,,Хмм, төрт болуы мүмкін.
Dialogue: 0,0:16:05.50,0:16:07.43,Default,,0,0,0,,Көрінгендей, сол жерде біреу оларды күтіп отыр.
Dialogue: 0,0:16:07.90,0:16:08.96,Default,,0,0,0,,Уф
Dialogue: 0,0:16:11.20,0:16:15.46,Default,,0,0,0,,штаб-пәтерден га қос тайпа бірлігі
Dialogue: 0,0:16:15.80,0:16:18.36,Default,,0,0,0,,Ия, көмек келді.
Dialogue: 0,0:16:18.50,0:16:20.30,Default,,0,0,0,,А, мен оны ұстап алдым.
Dialogue: 0,0:16:20.56,0:16:24.93,Default,,0,0,0,,Егер мен мұны ертерек жасасам, мен сонша қиыншылық көрмес едім.
Dialogue: 0,0:16:29.73,0:16:33.46,Default,,0,0,0,,Blossom – жаңа ғана дамыған нейроноидтардың жаңа түрі.
Dialogue: 0,0:16:47.90,0:16:51.43,Default,,0,0,0,,Ой, бұл арнайы күштердің жаңа түрі ме?
Dialogue: 0,0:16:51.73,0:16:54.03,Default,,0,0,0,,Қалғанын соларға қалдыруым керек пе?
Dialogue: 0,0:17:06.53,0:17:07.80,Default,,0,0,0,,Ой!
Dialogue: 0,0:17:08.13,0:17:08.60,Default,,0,0,0,,Уф
Dialogue: 0,0:17:13.56,0:17:15.23,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:17:15.36,0:17:19.23,Default,,0,0,0,,Иә, Blossom – жауынгерлік мақсатта жасалған нейроноид.
Dialogue: 0,0:17:19.76,0:17:22.56,Default,,0,0,0,,Псевдо қос типті бас сүңгуір де ми операциясынан туындаған
Dialogue: 0,0:17:23.13,0:17:27.76,Default,,0,0,0,,Басқаша айтқанда, қос тайпа болғандықтан, біз әрқашан арнайы дайындықтан, түзетулерден өттік.
Dialogue: 0,0:17:28.20,0:17:33.10,Default,,0,0,0,,Ой, Мордиварп әлдебір елмен соғысуды жоспарлап отыр ма?
Dialogue: 0,0:17:33.16,0:17:33.73,Default,,0,0,0,,Уф
Dialogue: 0,0:17:33.83,0:17:34.26,Default,,0,0,0,,Ах
Dialogue: 0,0:17:35.50,0:17:40.00,Default,,0,0,0,,Мына жерде бейшара күнәкарлар тобы бар.
Dialogue: 0,0:17:47.63,0:17:49.40,Default,,0,0,0,,Сакора Сіз нені айтасыз?
Dialogue: 0,0:17:50.90,0:17:52.10,Default,,0,0,0,,Алджернон
Dialogue: 0,0:17:52.83,0:17:53.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:56.53,0:17:58.06,Default,,0,0,0,,Неге?
Dialogue: 0,0:18:00.83,0:18:03.76,Default,,0,0,0,,Ей, ол балалар қауіпті, олар үнемі қозғалады.
Dialogue: 0,0:18:04.53,0:18:07.96,Default,,0,0,0,,Тиранның роторы зақымдалған және ол жоғары жылдамдықпен қозғала алмайды. Алдымен барайық.
Dialogue: 0,0:18:08.33,0:18:10.96,Default,,0,0,0,,Мен сені тастап кете алмаймын.
Dialogue: 0,0:18:15.70,0:18:16.93,Default,,0,0,0,,Артыңыздан келе жатыр
Dialogue: 0,0:18:18.03,0:18:19.36,Default,,0,0,0,,Уау
Dialogue: 0,0:18:22.90,0:18:24.20,Default,,0,0,0,,Менің күресуден басқа амалым жоқ.
Dialogue: 0,0:18:26.50,0:18:28.80,Default,,0,0,0,,Бірақ Канкел шығады.
Dialogue: 0,0:18:31.23,0:18:34.30,Default,,0,0,0,,Онда Forte қолданудан басқа амал жоқ.
Dialogue: 0,0:18:39.20,0:18:40.53,Default,,0,0,0,,Хифууу
Dialogue: 0,0:18:41.00,0:18:42.46,Default,,0,0,0,,Іші ауырады
Dialogue: 0,0:18:43.60,0:18:44.46,Default,,0,0,0,,Куссо
Dialogue: 0,0:18:45.10,0:18:46.40,Default,,0,0,0,,Ууууууук
Dialogue: 0,0:18:51.40,0:18:52.33,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:18:56.63,0:18:58.53,Default,,0,0,0,,Гаригари Гари Гари
Dialogue: 0,0:18:58.63,0:18:59.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:01.80,0:19:02.30,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:06.80,0:19:08.10,Default,,0,0,0,,Күтілгендей пайда болды
Dialogue: 0,0:19:09.56,0:19:11.63,Default,,0,0,0,,Ааа аааа...
Dialogue: 0,0:19:15.86,0:19:18.86,Default,,0,0,0,,Гууууууу...
Dialogue: 0,0:19:34.30,0:19:35.86,Default,,0,0,0,,Ву-у
Dialogue: 0,0:19:36.03,0:19:37.36,Default,,0,0,0,,Гуоооо
Dialogue: 0,0:19:38.06,0:19:38.93,Default,,0,0,0,,Беттерман
Dialogue: 0,0:19:39.66,0:19:40.13,Default,,0,0,0,,Га
Dialogue: 0,0:19:42.13,0:19:42.96,Default,,0,0,0,,Forte
Dialogue: 0,0:19:48.46,0:19:49.20,Default,,0,0,0,,Уккикики
Dialogue: 0,0:19:53.26,0:19:55.96,Default,,0,0,0,,Ууууууу
Dialogue: 0,0:20:00.96,0:20:02.93,Default,,0,0,0,,Оның жауынгерлік күші қорқынышты.
Dialogue: 0,0:20:04.00,0:20:06.10,Default,,0,0,0,,Беттерман Форте
Dialogue: 0,0:20:06.80,0:20:07.30,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:08.40,0:20:10.63,Default,,0,0,0,,Мен оны сол кезде естідім.
Dialogue: 0,0:20:12.70,0:20:15.40,Default,,0,0,0,,Ол жай ғана өз ыңғайлылығы үшін күресіп жатыр.
Dialogue: 0,0:20:16.93,0:20:18.43,Default,,0,0,0,,Оның шынайы мақсаты
Dialogue: 0,0:20:31.80,0:20:32.96,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:20:54.16,0:20:56.53,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:20:57.80,0:20:58.46,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:20:58.83,0:21:00.30,Default,,0,0,0,,Тым таңқаларлық
Dialogue: 0,0:21:00.90,0:21:03.66,Default,,0,0,0,,Әлі біткен жоқ
Dialogue: 0,0:21:05.30,0:21:06.13,Default,,0,0,0,,Мен келемін
Dialogue: 0,0:21:12.26,0:21:12.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:20.86,0:21:23.46,Default,,0,0,0,,Бодайжу Пачира қарттың артынан
Dialogue: 0,0:21:23.86,0:21:26.20,Default,,0,0,0,,Өйткені, олар мені келесі нысанаға алады.
Dialogue: 0,0:21:29.73,0:21:30.43,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:21:41.40,0:21:45.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:45.70,0:21:47.86,Default,,0,0,0,,Люме Сіз қалқан болғыңыз келе ме?
Dialogue: 0,0:21:48.60,0:21:50.73,Default,,0,0,0,,Үмітпен жүр
Dialogue: 0,0:22:03.63,0:22:04.20,Default,,0,0,0,,Гарит
Dialogue: 0,0:22:34.86,0:22:47.60,Default,,0,0,0,,Шексіз теломераларға ойылған Құдайдың күнәсі
Dialogue: 0,0:22:48.20,0:22:54.33,Default,,0,0,0,,Жалынды құшақтап алу
Dialogue: 0,0:22:54.73,0:23:01.86,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:02.10,0:23:05.43,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.73,0:23:08.93,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:09.13,0:23:12.36,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.66,0:23:15.90,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.60,0:23:27.53,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:27.83,0:23:37.50,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:38.13,0:23:49.20,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:59.10,0:24:02.36,Default,,0,0,0,,Қасиетті түн жолымен түсу
Dialogue: 0,0:24:03.16,0:24:06.36,Default,,0,0,0,,Қар қараңғы түнде қар қалыңдайды
Dialogue: 0,0:24:07.66,0:24:10.73,Default,,0,0,0,,Беті жоқ адам қорқынышты адам
Dialogue: 0,0:24:11.96,0:24:14.76,Default,,0,0,0,,Шатасып кету және ұрлау
Dialogue: 0,0:24:16.53,0:24:19.53,Default,,0,0,0,,Маңызды және маңызды құрбандық
Dialogue: 0,0:24:21.16,0:24:23.20,Default,,0,0,0,,Сіздің етіңіз бен қаныңыз
Dialogue: 0,0:24:24.13,0:24:25.56,Default,,0,0,0,,тонау
Dialogue: 0,0:24:27.06,0:24:33.06,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
