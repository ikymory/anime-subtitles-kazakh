Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.40,0:00:20.00,Default,,0,0,0,,Беттерман жалғыз емес пе еді?
Dialogue: 0,0:00:29.00,0:00:31.76,Default,,0,0,0,,Ауада иондардың көп мөлшері анықталды
Dialogue: 0,0:00:32.46,0:00:33.43,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:00:39.16,0:00:40.13,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:00:44.53,0:00:45.80,Default,,0,0,0,,Гамма сәулесінің жарылуы
Dialogue: 0,0:00:46.13,0:00:48.43,Default,,0,0,0,,Неліктен? Неліктен бұл мүмкін?
Dialogue: 0,0:01:04.93,0:01:08.26,Default,,0,0,0,,Иә? Гүлдер жақсы емес сияқты.
Dialogue: 0,0:01:08.53,0:01:09.60,Default,,0,0,0,,Уфуфуфуфуфу
Dialogue: 0,0:01:10.26,0:01:14.20,Default,,0,0,0,,А, мен енді балдың иісін сезбеймін.
Dialogue: 0,0:01:14.73,0:01:18.80,Default,,0,0,0,,Бірақ анти-NBC жабдықтары да сенімсіз.
Dialogue: 0,0:01:19.13,0:01:20.40,Default,,0,0,0,,ха ха ха ха
Dialogue: 0,0:01:21.30,0:01:22.36,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:01:22.40,0:01:25.83,Default,,0,0,0,,Эхехе Няндаа
Dialogue: 0,0:01:26.06,0:01:29.16,Default,,0,0,0,,Сіз әлі бітірдіңіз бе? Охохохо
Dialogue: 0,0:01:29.66,0:01:30.56,Default,,0,0,0,,Иә
Dialogue: 0,0:01:36.06,0:01:38.50,Default,,0,0,0,,Хмм, бұл керемет.
Dialogue: 0,0:01:38.53,0:01:40.83,Default,,0,0,0,,Яняя
Dialogue: 0,0:01:40.93,0:01:42.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:42.60,0:01:43.43,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,0:01:43.53,0:01:46.03,Default,,0,0,0,,Мен жақсы түс көрдім.
Dialogue: 0,0:01:46.60,0:01:51.23,Default,,0,0,0,,Бірақ бұл қорқынышты арманның басы ғана болуы мүмкін.
Dialogue: 0,0:01:51.50,0:01:52.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:52.93,0:01:57.03,Default,,0,0,0,,Менің айтайын дегенім, біз Алджернон болуымыз мүмкін.
Dialogue: 0,0:01:57.70,0:02:00.93,Default,,0,0,0,,Ол ол ол ол ол ол
Dialogue: 0,0:02:01.06,0:02:02.83,Default,,0,0,0,,бұл хахахаха хахахаха
Dialogue: 0,0:02:14.10,0:02:18.40,Default,,0,0,0,,Адамзаттың болашағын сақтау. Жаса, Саламандер 62.
Dialogue: 0,0:02:18.93,0:02:19.46,Default,,0,0,0,,Ха ха
Dialogue: 0,0:02:31.70,0:02:32.23,Default,,0,0,0,,Хмм?
Dialogue: 0,0:02:47.40,0:02:48.36,Default,,0,0,0,,Беттерман
Dialogue: 0,0:02:51.73,0:03:01.16,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:03:03.70,0:03:11.80,Default,,0,0,0,,Жүзетін күміс қайық
Dialogue: 0,0:03:13.56,0:03:22.30,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:03:25.33,0:03:33.40,Default,,0,0,0,,Қай жерде теңселіп жүрсің?
Dialogue: 0,0:03:36.56,0:03:45.40,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:03:45.73,0:03:53.93,Default,,0,0,0,,Жанға бағыт-бағдар беру
Dialogue: 0,0:03:55.73,0:04:05.23,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:04:05.66,0:04:17.80,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:04:22.63,0:04:27.60,Default,,0,0,0,,Ал, мен не істеп едім?
Dialogue: 0,0:04:28.20,0:04:29.33,Default,,0,0,0,,Белгілі
Dialogue: 0,0:04:30.26,0:04:34.23,Default,,0,0,0,,Сара-чан Лимипид арнасында Асами-санның дағдарысы туралы айтып берді.
Dialogue: 0,0:04:34.96,0:04:39.60,Default,,0,0,0,,Сонымен, бәрің Куширодағы BPL деп аталатын ғылыми-зерттеу институтына келдіңдер ме?
Dialogue: 0,0:04:40.73,0:04:43.03,Default,,0,0,0,,Дұрыс, маған жәндіктер әскері шабуыл жасады.
Dialogue: 0,0:04:44.70,0:04:46.90,Default,,0,0,0,,Мен оны қалай да жеңдім деп ойладым.
Dialogue: 0,0:04:49.20,0:04:51.03,Default,,0,0,0,,Иісі тәтті.
Dialogue: 0,0:04:51.93,0:04:54.70,Default,,0,0,0,,Мен өзімді біртүрлі сезінемін.
Dialogue: 0,0:04:57.43,0:04:58.96,Default,,0,0,0,,Мен өзімді шаршағандай сезінемін.
Dialogue: 0,0:04:59.50,0:05:03.80,Default,,0,0,0,,Бұл зауыт сол кабельден қандай да бір сигнал алған сияқты.
Dialogue: 0,0:05:04.53,0:05:07.40,Default,,0,0,0,,Оянатын адамдар гель шегіне жақын.
Dialogue: 0,0:05:08.06,0:05:09.33,Default,,0,0,0,,Тиранның жағдайы жақсы.
Dialogue: 0,0:05:10.10,0:05:11.16,Default,,0,0,0,,Алдымен жоғары қара
Dialogue: 0,0:05:11.63,0:05:13.80,Default,,0,0,0,,Көк балталар, бекер қимылдамаған дұрыс.
Dialogue: 0,0:05:14.53,0:05:16.13,Default,,0,0,0,,Түсіндім, мен күтемін.
Dialogue: 0,0:05:33.06,0:05:36.33,Default,,0,0,0,,Бірақ, Хинокидің айтқаны дұрыс.
Dialogue: 0,0:05:38.10,0:05:41.13,Default,,0,0,0,,Ұшақтар құлап, жәндіктер сізге шабуыл жасайды.
Dialogue: 0,0:05:41.50,0:05:43.66,Default,,0,0,0,,Феромондар мені жынды етеді
Dialogue: 0,0:05:44.36,0:05:47.26,Default,,0,0,0,,Қанша өмірім болса да бұл жеткіліксіз.
Dialogue: 0,0:05:49.56,0:05:52.60,Default,,0,0,0,,Эй, Хиноки, неге уәде бермейсің?
Dialogue: 0,0:05:55.00,0:05:57.80,Default,,0,0,0,,Осы жерден тірі шыға алсам
Dialogue: 0,0:05:58.76,0:06:01.56,Default,,0,0,0,,Кездесуге барайық
Dialogue: 0,0:06:02.66,0:06:05.33,Default,,0,0,0,,Жақсы, үйге аман-есен жеткенше.
Dialogue: 0,0:06:19.66,0:06:21.63,Default,,0,0,0,,Барлық жәндіктер өлді ме?
Dialogue: 0,0:06:22.53,0:06:26.86,Default,,0,0,0,,Өсімдіктер адамның ми толқындарын полиграф сияқты оқи алады
Dialogue: 0,0:06:27.70,0:06:30.76,Default,,0,0,0,,Мүмкін бұл гүлге доктор Умезаки тапсырыс берген шығар.
Dialogue: 0,0:06:31.20,0:06:34.36,Default,,0,0,0,,Ол жәндіктерді басқаратын арнайы феромонды шығарған болуы керек.
Dialogue: 0,0:06:35.33,0:06:40.10,Default,,0,0,0,,Бізді жақсы сезінген сол феромондар болды, солай ма?
Dialogue: 0,0:06:40.76,0:06:43.10,Default,,0,0,0,,Адамдар сөзбен сөйлесетін сияқты
Dialogue: 0,0:06:43.93,0:06:48.03,Default,,0,0,0,,Өсімдіктер әртүрлі тәсілдермен байланысу үшін химиялық заттарды пайдаланады.
Dialogue: 0,0:06:49.36,0:06:53.20,Default,,0,0,0,,Зеңдер мен саңырауқұлақтардың болуы туралы хабарлау кезінде мезосалицилейді қолданыңыз.
Dialogue: 0,0:06:54.30,0:06:56.36,Default,,0,0,0,,Жәндіктер мен ауруларға арналған этилен
Dialogue: 0,0:06:57.56,0:07:00.80,Default,,0,0,0,,Ал жара алған кезде сіз меццо джазманитке айналасыз.
Dialogue: 0,0:07:01.86,0:07:04.26,Default,,0,0,0,,Бізге кедергі жасаған химиялық заттар
Dialogue: 0,0:07:04.66,0:07:08.00,Default,,0,0,0,,Тәтті балдың иісі ұнағандай.
Dialogue: 0,0:07:08.73,0:07:10.40,Default,,0,0,0,,Ол гүл жәндіктерге де пайдалы.
Dialogue: 0,0:07:10.60,0:07:14.20,Default,,0,0,0,,Ол маңызды заттарды шығарған болуы керек.
Dialogue: 0,0:07:15.60,0:07:17.90,Default,,0,0,0,,Енді сол гүл солып қалды
Dialogue: 0,0:07:18.23,0:07:22.83,Default,,0,0,0,,Симбиотикалық қарым-қатынас бұзылып, жәндіктер өмір сүруді жалғастыра алмайды.
Dialogue: 0,0:07:24.46,0:07:25.43,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:07:26.30,0:07:29.76,Default,,0,0,0,,Сонымен, Альжернон да феромондардан туындайды ма?
Dialogue: 0,0:07:30.60,0:07:35.10,Default,,0,0,0,,Алджернонның мидағы дофаминдік рецепторлардың шамадан тыс көбеюіне себеп болатыны рас.
Dialogue: 0,0:07:35.53,0:07:37.86,Default,,0,0,0,,Адамдарды рахатқа шақыратын қасиеті бар.
Dialogue: 0,0:07:39.20,0:07:39.80,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:07:41.06,0:07:43.33,Default,,0,0,0,,Жоғарыда бір нәрсе қозғалып жатыр.
Dialogue: 0,0:07:43.86,0:07:44.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:45.26,0:07:48.06,Default,,0,0,0,,Өте үлкен, тірі зат сияқты
Dialogue: 0,0:07:48.73,0:07:50.80,Default,,0,0,0,,Оны сенсорлар түсіре алмайды.
Dialogue: 0,0:07:51.80,0:07:53.06,Default,,0,0,0,,Сара-чан, не?
Dialogue: 0,0:07:53.40,0:07:53.86,Default,,0,0,0,,Ах
Dialogue: 0,0:07:54.76,0:07:55.26,Default,,0,0,0,,Уф
Dialogue: 0,0:07:56.23,0:07:58.53,Default,,0,0,0,,Бейшара оғаш адамдар
Dialogue: 0,0:07:58.70,0:08:01.50,Default,,0,0,0,,Бұл өте ауыр.
Dialogue: 0,0:08:02.06,0:08:03.13,Default,,0,0,0,,Өте жылдам
Dialogue: 0,0:08:03.33,0:08:04.26,Default,,0,0,0,,Жоқ—
Dialogue: 0,0:08:05.73,0:08:08.20,Default,,0,0,0,,Ууу
Dialogue: 0,0:08:17.40,0:08:19.46,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Янаги-сан және т.б.
Dialogue: 0,0:08:20.83,0:08:21.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:26.70,0:08:27.36,Default,,0,0,0,,Прето?
Dialogue: 0,0:08:30.56,0:08:31.06,Default,,0,0,0,,О
Dialogue: 0,0:08:31.90,0:08:32.76,Default,,0,0,0,,Оян
Dialogue: 0,0:08:35.36,0:08:35.83,Default,,0,0,0,,Хмм?
Dialogue: 0,0:08:39.90,0:08:40.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:41.56,0:08:42.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:46.96,0:08:48.13,Default,,0,0,0,,Гель шектеулері
Dialogue: 0,0:08:48.83,0:08:50.93,Default,,0,0,0,,Сондықтан маған қозғалма деді.
Dialogue: 0,0:08:51.86,0:08:52.40,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:53.43,0:08:54.33,Default,,0,0,0,,Маған осылай аталған «толқындарды» жібергің келе ме?
Dialogue: 0,0:08:56.66,0:09:01.26,Default,,0,0,0,,Бұл Кей-чан айтып отырған Үндістанда өмір сүрген кесіртке ме?
Dialogue: 0,0:09:02.30,0:09:03.53,Default,,0,0,0,,Бұл Прето ғой.
Dialogue: 0,0:09:04.13,0:09:05.63,Default,,0,0,0,,Сіз бірдеңені күтіп тұрған сияқтысыз.
Dialogue: 0,0:09:13.20,0:09:15.60,Default,,0,0,0,,Ха, Тиран құлап қалды ма?
Dialogue: 0,0:09:20.46,0:09:23.26,Default,,0,0,0,,Эй, сен Тиран емессің бе?
Dialogue: 0,0:09:26.53,0:09:29.03,Default,,0,0,0,,Оянған адамдар енді қозғала алмайды.
Dialogue: 0,0:09:32.10,0:09:34.46,Default,,0,0,0,,Гууун
Dialogue: 0,0:09:34.50,0:09:36.13,Default,,0,0,0,,Уф
Dialogue: 0,0:09:37.53,0:09:39.60,Default,,0,0,0,,- Қаш, Хиноки - Ах!
Dialogue: 0,0:09:41.83,0:09:43.03,Default,,0,0,0,,Мен қашып құтыла алмаймын
Dialogue: 0,0:09:43.06,0:09:47.53,Default,,0,0,0,,Шу, мен міндетті түрде тірі ораламын және сенімен кездесуге барамын.
Dialogue: 0,0:09:54.43,0:09:55.96,Default,,0,0,0,,Ммм мұнда.
Dialogue: 0,0:09:56.13,0:09:57.86,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:58.20,0:10:01.53,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:10:05.60,0:10:07.96,Default,,0,0,0,,Бұл дыбыс: Бегемоттың қоңырауы
Dialogue: 0,0:10:24.83,0:10:26.70,Default,,0,0,0,,Наро
Dialogue: 0,0:10:26.93,0:10:29.96,Default,,0,0,0,,Жәндіктерге қарсы No3
Dialogue: 0,0:10:37.46,0:10:37.96,Default,,0,0,0,,Га
Dialogue: 0,0:10:38.40,0:10:40.63,Default,,0,0,0,,Жәндіктерге қарсы құрал алғаныңызға қуаныштысыз
Dialogue: 0,0:10:41.20,0:10:42.23,Default,,0,0,0,,Сіз жүре аласыз ба? Хиноки
Dialogue: 0,0:10:42.86,0:10:43.30,Default,,0,0,0,,Иә
Dialogue: 0,0:10:43.86,0:10:44.46,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:10:52.93,0:10:55.13,Default,,0,0,0,,Гуруруруру…
Dialogue: 0,0:10:56.16,0:10:58.60,Default,,0,0,0,,Гуруруруру…
Dialogue: 0,0:11:05.83,0:11:09.16,Default,,0,0,0,,Оянғандар мен Тиран үшін сәйкестендіру сигналдары жоғалды.
Dialogue: 0,0:11:09.60,0:11:12.10,Default,,0,0,0,,Жәндіктер жойылып кеткен сияқты.
Dialogue: 0,0:11:12.93,0:11:15.36,Default,,0,0,0,,Беттерман қайда кетті?
Dialogue: 0,0:11:17.96,0:11:19.60,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:11:19.66,0:11:20.63,Default,,0,0,0,,Тәбет жоқ
Dialogue: 0,0:11:21.16,0:11:24.56,Default,,0,0,0,,Мұндағы ғылыми-зерттеу институты үнемі өсіп келе жатқан адамзат баласын азық-түлікпен қамтамасыз етеді.
Dialogue: 0,0:11:25.03,0:11:28.66,Default,,0,0,0,,Сіз оны биотехнологиямен толықтыратын нысан дедіңіз.
Dialogue: 0,0:11:30.16,0:11:31.96,Default,,0,0,0,,Халқы 7 млрд?
Dialogue: 0,0:11:33.60,0:11:37.36,Default,,0,0,0,,Ерлердің миллиардтаған ұрығы не үшін жасалатынын білесіз бе?
Dialogue: 0,0:11:37.90,0:11:39.46,Default,,0,0,0,,Кенет лас әзіл?
Dialogue: 0,0:11:39.66,0:11:44.63,Default,,0,0,0,,Бұл артық шығару және ең жақсысын таңдау туралы.
Dialogue: 0,0:11:45.46,0:11:48.93,Default,,0,0,0,,Ах, бүгінде адамдар тым көп екені анық.
Dialogue: 0,0:11:49.83,0:11:54.83,Default,,0,0,0,,Сонымен, Алджернон ең жақсы адамдарды таңдайтын елеуіш пе?
Dialogue: 0,0:11:55.46,0:11:56.26,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:11:59.60,0:12:01.10,Default,,0,0,0,,Бұл табиғи сұрыпталу.
Dialogue: 0,0:12:10.80,0:12:13.33,Default,,0,0,0,,Бұл терең.
Dialogue: 0,0:12:14.06,0:12:17.10,Default,,0,0,0,,Жерге көтерілу үшін әлі көп уақыт керек сияқты.
Dialogue: 0,0:12:17.50,0:12:18.53,Default,,0,0,0,,Ах Ах
Dialogue: 0,0:12:18.83,0:12:19.30,Default,,0,0,0,,Ах
Dialogue: 0,0:12:24.23,0:12:26.23,Default,,0,0,0,,Бұл сөзсіз Прето.
Dialogue: 0,0:12:26.56,0:12:28.26,Default,,0,0,0,,Саған жақындағаным дұрыс па?
Dialogue: 0,0:12:28.46,0:12:28.96,Default,,0,0,0,,Иә
Dialogue: 0,0:12:29.70,0:12:30.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:37.23,0:12:37.93,Default,,0,0,0,,Хота
Dialogue: 0,0:12:38.60,0:12:39.23,Default,,0,0,0,,Сіз адамсыз ба?
Dialogue: 0,0:12:39.36,0:12:41.33,Default,,0,0,0,,Кэнди тірі болды ма?
Dialogue: 0,0:12:41.86,0:12:42.40,Default,,0,0,0,,Иә
Dialogue: 0,0:12:43.20,0:12:44.43,Default,,0,0,0,,Лимипидті арна?
Dialogue: 0,0:12:45.16,0:12:48.26,Default,,0,0,0,,Неліктен мұнда? Бұл қандай машина?
Dialogue: 0,0:12:48.80,0:12:52.00,Default,,0,0,0,,-Глутатионпероксидаза толтырғышы -Ах
Dialogue: 0,0:12:55.36,0:12:56.46,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:12:57.06,0:12:59.40,Default,,0,0,0,,Сол бала сияқты Д типті аңшы
Dialogue: 0,0:12:59.66,0:13:04.60,Default,,0,0,0,,ДНҚ денеде белсенді оттегінің артық өндірілуі үшін манипуляцияланған.
Dialogue: 0,0:13:05.66,0:13:09.36,Default,,0,0,0,,Селен және хром сияқты маңызды минералдармен синтезді ынталандыру.
Dialogue: 0,0:13:09.66,0:13:11.73,Default,,0,0,0,,Маған бұл құрылғы керек.
Dialogue: 0,0:13:12.36,0:13:13.60,Default,,0,0,0,,Өйткені, Лимичан
Dialogue: 0,0:13:14.50,0:13:17.80,Default,,0,0,0,,Сен есейдің, сен Хиноки-чансың.
Dialogue: 0,0:13:18.13,0:13:18.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:19.03,0:13:20.13,Default,,0,0,0,,Сіз Хинокидің танысысыз ба?
Dialogue: 0,0:13:20.56,0:13:22.33,Default,,0,0,0,,Кез келген жағдайда, доктор Умезаки?
Dialogue: 0,0:13:23.06,0:13:26.93,Default,,0,0,0,,Сенің әкең доктор Ая менің досым еді.
Dialogue: 0,0:13:27.50,0:13:28.73,Default,,0,0,0,,Ескі әңгіме
Dialogue: 0,0:13:29.76,0:13:32.43,Default,,0,0,0,,Сіздің отбасыңыз хабарсыз кеткенде
Dialogue: 0,0:13:32.53,0:13:34.83,Default,,0,0,0,,Мен де сайтқа бардым.
Dialogue: 0,0:13:35.43,0:13:35.90,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:36.03,0:13:38.26,Default,,0,0,0,,Сол Аджанта үңгірлеріне
Dialogue: 0,0:13:38.36,0:13:39.63,Default,,0,0,0,,Әкелер қайда?
Dialogue: 0,0:13:42.10,0:13:45.23,Default,,0,0,0,,Бірақ мен үлкен өнім алдым.
Dialogue: 0,0:13:45.63,0:13:48.53,Default,,0,0,0,,Иә, мен мұны кездестірдім.
Dialogue: 0,0:13:51.00,0:13:51.76,Default,,0,0,0,,Яғни
Dialogue: 0,0:13:52.06,0:13:53.26,Default,,0,0,0,,Анимус гүлі
Dialogue: 0,0:13:53.76,0:13:56.00,Default,,0,0,0,,Бұл шынымен де ғажайып гүл.
Dialogue: 0,0:13:56.33,0:14:00.90,Default,,0,0,0,,L типті аминқышқылдарының D типіне айналу қасиеті бар.
Dialogue: 0,0:14:01.73,0:14:05.20,Default,,0,0,0,,Және сол кезде өндірілген орасан зор ферменттік энергия
Dialogue: 0,0:14:05.80,0:14:09.90,Default,,0,0,0,,Қалыпты тірі жасушалар 5-тен 60-қа дейін бөлінеді.
Dialogue: 0,0:14:10.10,0:14:11.66,Default,,0,0,0,,Өмір сүру ұзақтығы аяқталады
Dialogue: 0,0:14:12.80,0:14:14.40,Default,,0,0,0,,Бірақ осы гүл менде болса
Dialogue: 0,0:14:14.43,0:14:19.06,Default,,0,0,0,,Шындығында, 300-ден астам бөлінуге төтеп бере алатын теломерлер жасалады.
Dialogue: 0,0:14:19.53,0:14:20.83,Default,,0,0,0,,Мұндай нәрсе үшін
Dialogue: 0,0:14:26.00,0:14:27.13,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:27.56,0:14:29.86,Default,,0,0,0,,Дүние жүзіндегі аш адамдарды құтқару
Dialogue: 0,0:14:30.23,0:14:33.50,Default,,0,0,0,,Біз ақуызды көп мөлшерде өндіруіміз керек.
Dialogue: 0,0:14:34.26,0:14:35.30,Default,,0,0,0,,Қарама-қайшы
Dialogue: 0,0:14:35.66,0:14:38.03,Default,,0,0,0,,Біреуді құтқару үшін біреуді өлтіру?
Dialogue: 0,0:14:38.63,0:14:40.63,Default,,0,0,0,,Табиғаттағы жалпы мағына
Dialogue: 0,0:14:41.50,0:14:46.06,Default,,0,0,0,,Егер адамзат 7 миллиард адамнан тұратын бір тірі зат болса.
Dialogue: 0,0:14:46.90,0:14:49.26,Default,,0,0,0,,Әрқайсымыз жасушамыз,
Dialogue: 0,0:14:49.43,0:14:53.93,Default,,0,0,0,,Әр адамның рөлін анықтау заңды емес пе?
Dialogue: 0,0:14:54.50,0:14:56.53,Default,,0,0,0,,Мен соншалықты қиын нәрсені түсінбеймін.
Dialogue: 0,0:14:57.93,0:15:03.03,Default,,0,0,0,,Олай болса, бұл сіздердің осы гүлдің егістік алаңына айналуда ғана рөл атқарып жатқаныңызды білдіре ме?
Dialogue: 0,0:15:04.33,0:15:05.36,Default,,0,0,0,,Бегемот патша
Dialogue: 0,0:15:05.76,0:15:09.20,Default,,0,0,0,,Гурул Гя
Dialogue: 0,0:15:10.70,0:15:12.53,Default,,0,0,0,,Бегемот патша
Dialogue: 0,0:15:14.00,0:15:15.26,Default,,0,0,0,,Гоо
Dialogue: 0,0:15:15.33,0:15:16.83,Default,,0,0,0,,Доваа
Dialogue: 0,0:15:21.20,0:15:22.53,Default,,0,0,0,,Кяаа
Dialogue: 0,0:15:25.76,0:15:27.30,Default,,0,0,0,,Сіздің әпкеңіз кім?
Dialogue: 0,0:15:28.00,0:15:31.40,Default,,0,0,0,,О, сенің әлі қозғала алатыныңа сене алар емеспін. Жақсы адам күткендей.
Dialogue: 0,0:15:32.93,0:15:33.50,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:33.96,0:15:35.10,Default,,0,0,0,,Тағы бір жақсы адам
Dialogue: 0,0:15:36.16,0:15:36.90,Default,,0,0,0,,Люма
Dialogue: 0,0:15:41.46,0:15:41.93,Default,,0,0,0,,Ах
Dialogue: 0,0:15:43.23,0:15:44.93,Default,,0,0,0,,Керемет
Dialogue: 0,0:15:48.96,0:15:49.43,Default,,0,0,0,,Га
Dialogue: 0,0:15:50.10,0:15:54.60,Default,,0,0,0,,Король Бегемот оның шатырларынан басқа сұйық сауытпен қорғалған.
Dialogue: 0,0:15:55.10,0:15:57.33,Default,,0,0,0,,Жаралау мүмкін емес
Dialogue: 0,0:15:57.66,0:15:58.90,Default,,0,0,0,,Керемет
Dialogue: 0,0:15:58.96,0:15:59.90,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:16:00.73,0:16:01.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:08.43,0:16:08.93,Default,,0,0,0,,Га
Dialogue: 0,0:16:11.26,0:16:12.36,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,0:16:15.10,0:16:19.70,Default,,0,0,0,,Хахахаха Шигүуу
Dialogue: 0,0:16:19.73,0:16:21.13,Default,,0,0,0,,-Котата -хаха
Dialogue: 0,0:16:21.53,0:16:24.30,Default,,0,0,0,,Мені бұл жерден кетіріңіз
Dialogue: 0,0:16:25.10,0:16:26.86,Default,,0,0,0,,Сонымен сіз осылай айттыңыз.
Dialogue: 0,0:16:27.83,0:16:31.33,Default,,0,0,0,,Даа
Dialogue: 0,0:16:31.40,0:16:34.23,Default,,0,0,0,,7 миллиард 7 миллиард 7 миллиард
Dialogue: 0,0:16:34.53,0:16:38.60,Default,,0,0,0,,7 миллиард 7 миллиард 7 миллиард адам құтқарылады.
Dialogue: 0,0:16:39.23,0:16:39.73,Default,,0,0,0,,Әй
Dialogue: 0,0:16:48.40,0:16:51.76,Default,,0,0,0,,D18 Ол жерден шықсаң өлесің.
Dialogue: 0,0:16:52.30,0:16:54.03,Default,,0,0,0,,Өлген әкең.
Dialogue: 0,0:16:54.56,0:16:55.06,Default,,0,0,0,,Хмм?
Dialogue: 0,0:16:55.43,0:16:56.56,Default,,0,0,0,,Раксаша
Dialogue: 0,0:17:06.76,0:17:07.36,Default,,0,0,0,,Будда
Dialogue: 0,0:17:38.43,0:17:38.96,Default,,0,0,0,,Кяах!
Dialogue: 0,0:17:40.90,0:17:41.43,Default,,0,0,0,,Ах
Dialogue: 0,0:17:45.13,0:17:45.90,Default,,0,0,0,,Канди
Dialogue: 0,0:17:46.36,0:17:46.86,Default,,0,0,0,,Ах
Dialogue: 0,0:17:47.06,0:17:48.83,Default,,0,0,0,,Ооо
Dialogue: 0,0:17:49.60,0:17:54.00,Default,,0,0,0,,Даа
Dialogue: 0,0:17:55.43,0:17:56.33,Default,,0,0,0,,А, а
Dialogue: 0,0:17:59.13,0:18:01.13,Default,,0,0,0,,Иә, менің бетімнен шығып жатыр.
Dialogue: 0,0:18:01.40,0:18:02.53,Default,,0,0,0,,Анимус гүлі
Dialogue: 0,0:18:03.40,0:18:03.86,Default,,0,0,0,,Ах
Dialogue: 0,0:18:05.13,0:18:07.03,Default,,0,0,0,,Мен келдім
Dialogue: 0,0:18:07.80,0:18:08.86,Default,,0,0,0,,Forte жемісі
Dialogue: 0,0:18:09.76,0:18:11.56,Default,,0,0,0,,Гари Гари Гари Гари
Dialogue: 0,0:18:14.16,0:18:14.70,Default,,0,0,0,,Уф
Dialogue: 0,0:18:22.80,0:18:24.40,Default,,0,0,0,,Боо
Dialogue: 0,0:18:28.93,0:18:30.00,Default,,0,0,0,,Го-о
Dialogue: 0,0:18:30.56,0:18:32.03,Default,,0,0,0,,Беттерменнің ең күшті түрі
Dialogue: 0,0:18:32.56,0:18:35.50,Default,,0,0,0,,Бірақ ол жеміс доктор Умезакидің денесінен неліктен шықты?
Dialogue: 0,0:19:09.93,0:19:10.56,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:19:11.76,0:19:13.50,Default,,0,0,0,,Қарсыластың сұйық құрышымен бұғатталған
Dialogue: 0,0:19:13.80,0:19:15.93,Default,,0,0,0,,Сіз өлімге әкелетін күйреу нүктесін таба алмайсыз ба?
Dialogue: 0,0:19:17.16,0:19:19.53,Default,,0,0,0,,Гуоо
Dialogue: 0,0:19:20.10,0:19:22.86,Default,,0,0,0,,Ууу
Dialogue: 0,0:19:24.90,0:19:27.43,Default,,0,0,0,,Ооо
Dialogue: 0,0:19:29.83,0:19:30.76,Default,,0,0,0,,Ооо
Dialogue: 0,0:19:30.93,0:19:33.10,Default,,0,0,0,,Бұл қауіпті сезінеді.
Dialogue: 0,0:19:38.80,0:19:39.33,Default,,0,0,0,,Бу-о
Dialogue: 0,0:19:42.36,0:19:43.13,Default,,0,0,0,,Кьюо
Dialogue: 0,0:19:43.36,0:19:44.23,Default,,0,0,0,,Клапан…
Dialogue: 0,0:19:51.56,0:19:52.56,Default,,0,0,0,,Саңырауқұлақ споралары
Dialogue: 0,0:19:55.23,0:19:57.70,Default,,0,0,0,,Сұйық сауытты саңырауқұлақтар жеп жатыр
Dialogue: 0,0:20:13.50,0:20:14.86,Default,,0,0,0,,Психо даңқы
Dialogue: 0,0:20:16.00,0:20:17.56,Default,,0,0,0,,Ууу
Dialogue: 0,0:20:23.66,0:20:25.70,Default,,0,0,0,,Керемет микро сынық
Dialogue: 0,0:20:30.33,0:20:33.13,Default,,0,0,0,,Гаоо
Dialogue: 0,0:20:44.66,0:20:46.10,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:20:48.23,0:20:49.90,Default,,0,0,0,,Ооо
Dialogue: 0,0:20:55.46,0:20:56.46,Default,,0,0,0,,Керемет...
Dialogue: 0,0:20:56.83,0:20:57.36,Default,,0,0,0,,Ах
Dialogue: 0,0:21:12.40,0:21:12.90,Default,,0,0,0,,Уф
Dialogue: 0,0:21:14.30,0:21:14.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:23.80,0:21:24.33,Default,,0,0,0,,​​О?
Dialogue: 0,0:21:29.33,0:21:30.46,Default,,0,0,0,,Контрейлер
Dialogue: 0,0:21:31.86,0:21:34.30,Default,,0,0,0,,Эй, сен тірісің бе?
Dialogue: 0,0:21:34.76,0:21:38.26,Default,,0,0,0,,Акамацу мырза, бұл пайдалы болды.
Dialogue: 0,0:21:38.73,0:21:40.93,Default,,0,0,0,,Ах ха ха ха ха ха
Dialogue: 0,0:21:41.86,0:21:43.10,Default,,0,0,0,,-Сәлем Хиноки -nh
Dialogue: 0,0:21:43.93,0:21:46.20,Default,,0,0,0,,Уәдеде тұрайық
Dialogue: 0,0:21:49.63,0:21:50.46,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:21:51.70,0:21:52.23,Default,,0,0,0,,Иә
Dialogue: 0,0:22:09.53,0:22:11.06,Default,,0,0,0,,Үміт сақталды
Dialogue: 0,0:22:34.73,0:22:47.33,Default,,0,0,0,,Құдайдың күнәсі шексіз теломерлерге жазылды
Dialogue: 0,0:22:48.03,0:22:54.13,Default,,0,0,0,,Жалынды құшақтап алу
Dialogue: 0,0:22:54.83,0:23:01.86,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:02.06,0:23:05.36,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.60,0:23:08.80,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.96,0:23:12.26,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.46,0:23:15.70,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.63,0:23:27.23,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:27.86,0:23:37.73,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:38.10,0:23:49.06,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:59.70,0:24:01.70,Default,,0,0,0,,Жинал, жинал
Dialogue: 0,0:24:02.23,0:24:04.03,Default,,0,0,0,,Алып тастаңыз Алып кетіңіз
Dialogue: 0,0:24:05.00,0:24:07.00,Default,,0,0,0,,Кагоме Кагоме
Dialogue: 0,0:24:08.03,0:24:10.83,Default,,0,0,0,,Теңіздің арғы жағындағы алыстан
Dialogue: 0,0:24:11.53,0:24:14.50,Default,,0,0,0,,Көлеңкеде жасырынып келеді
Dialogue: 0,0:24:15.23,0:24:18.53,Default,,0,0,0,,Бүкіл жермен жорғалау
Dialogue: 0,0:24:19.80,0:24:21.76,Default,,0,0,0,,Сіздің арқаңызда
Dialogue: 0,0:24:22.33,0:24:23.70,Default,,0,0,0,,ұстаныңыз
