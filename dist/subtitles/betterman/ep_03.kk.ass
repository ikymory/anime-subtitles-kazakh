Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.63,0:00:15.33,Default,,0,0,0,,Көк балта Кейта 17 жаста
Dialogue: 0,0:00:15.83,0:00:19.10,Default,,0,0,0,,Қос түр ретінде бас сүңгуірлер үшін қабілеттілік тестін өткізу.
Dialogue: 0,0:00:19.76,0:00:21.96,Default,,0,0,0,,Мен және Ая Хиноки.
Dialogue: 0,0:00:22.33,0:00:24.26,Default,,0,0,0,,Ханеда теңіздегі теңіз әуежайы
Dialogue: 0,0:00:24.53,0:00:27.40,Default,,0,0,0,,Firefly Squid-тен Мордиварптың штаб-пәтеріне барыңыз.
Dialogue: 0,0:00:29.96,0:00:33.80,Default,,0,0,0,,Керемет, Керемет, Керемет
Dialogue: 0,0:00:34.40,0:00:38.06,Default,,0,0,0,,Бұл соңғы үлгідегі С-21 көлік ұшағы емес пе?
Dialogue: 0,0:00:38.76,0:00:39.70,Default,,0,0,0,,Хмм.
Dialogue: 0,0:00:40.30,0:00:42.83,Default,,0,0,0,,Барлық жазықтықтар бірдей көрінеді
Dialogue: 0,0:00:44.40,0:00:48.53,Default,,0,0,0,,Жарайды, әйел түсінбейтін шығар.
Dialogue: 0,0:00:48.70,0:00:53.36,Default,,0,0,0,,Осыған қарамастан, бұл ұшақ өзін-өзі қорғау күштерімен әлі ресми түрде қабылданған жоқ.
Dialogue: 0,0:00:53.93,0:00:55.30,Default,,0,0,0,,Негізгі қанаттың алдыңғы жиегі
Dialogue: 0,0:00:55.66,0:00:59.13,Default,,0,0,0,,Бұл шекаралық деңгейді басқару болуы мүмкін бе? Бұл қару қоймасы ма?
Dialogue: 0,0:01:01.56,0:01:04.90,Default,,0,0,0,,Сіз шынымен теңіз шошқасы ретінде пайдаланылатыныңызды білесіз бе?
Dialogue: 0,0:01:18.93,0:01:20.00,Default,,0,0,0,,Түн құстары
Dialogue: 0,0:01:22.36,0:01:23.43,Default,,0,0,0,,Аспан үстінде
Dialogue: 0,0:01:25.86,0:01:26.70,Default,,0,0,0,,Ұш
Dialogue: 0,0:01:29.63,0:01:30.13,Default,,0,0,0,,Ах
Dialogue: 0,0:01:31.70,0:01:32.76,Default,,0,0,0,,Көптеген
Dialogue: 0,0:01:34.23,0:01:36.53,Default,,0,0,0,,Көптеген қуыршақтарды алып жүру
Dialogue: 0,0:01:41.83,0:01:51.10,Default,,0,0,0,,Көк домалақ үнсіздік
Dialogue: 0,0:01:53.66,0:02:01.63,Default,,0,0,0,,Күміс қайықтың жүзуі
Dialogue: 0,0:02:03.56,0:02:12.26,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:02:15.30,0:02:23.40,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:02:26.50,0:02:35.43,Default,,0,0,0,,Рух тағы оянды
Dialogue: 0,0:02:35.80,0:02:44.00,Default,,0,0,0,,Жанға бағыт-бағдар беру
Dialogue: 0,0:02:45.80,0:02:55.26,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:55.53,0:03:07.30,Default,,0,0,0,,Ағып жатқанда қозғалмаңыз...
Dialogue: 0,0:03:20.86,0:03:22.76,Default,,0,0,0,,Уау хаха
Dialogue: 0,0:03:23.03,0:03:26.70,Default,,0,0,0,,Мен теңіз әуежайынан C-21 ұшағына міндім десем ше?
Dialogue: 0,0:03:26.86,0:03:30.30,Default,,0,0,0,,Мен Ушии жігіті ренжігені соншалық, оның үстінен сипап қалатынына сенімдімін.
Dialogue: 0,0:03:30.50,0:03:34.33,Default,,0,0,0,,А, мен Радуга көпірі мен шығанақ көпірін бір уақытта көріп тұрмын!
Dialogue: 0,0:03:34.93,0:03:37.73,Default,,0,0,0,,Мүмкін бұл бірінші рет ұшып жатқан шығарсыз?
Dialogue: 0,0:03:37.86,0:03:40.70,Default,,0,0,0,,Әй, бұл теңіз отты.
Dialogue: 0,0:03:40.73,0:03:41.30,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:03:43.50,0:03:45.80,Default,,0,0,0,,Ұшақ осы уақытқа дейін бірқалыпты ұшып келеді.
Dialogue: 0,0:03:46.20,0:03:49.13,Default,,0,0,0,,Біз жоспарлағандай таң атқанда штабқа жетуіміз керек.
Dialogue: 0,0:03:51.80,0:03:53.00,Default,,0,0,0,,Уақытыңызды алыңыз.
Dialogue: 0,0:03:54.23,0:03:54.96,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:03:55.93,0:03:56.63,Default,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:03:56.66,0:03:58.16,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:03:58.93,0:04:02.90,Default,,0,0,0,,Олай емес, біраз уақыт бұрын болған.
Dialogue: 0,0:04:07.30,0:04:10.73,Default,,0,0,0,,Баяғыда болған оқиға сияқты.
Dialogue: 0,0:04:13.50,0:04:14.66,Default,,0,0,0,,Умм, Асами-сан?
Dialogue: 0,0:04:15.86,0:04:16.33,Default,,0,0,0,,Не?
Dialogue: 0,0:04:16.70,0:04:18.46,Default,,0,0,0,,Әлгі Беттермен?
Dialogue: 0,0:04:18.90,0:04:20.53,Default,,0,0,0,,Иә, анау, анау, анау
Dialogue: 0,0:04:20.86,0:04:22.86,Default,,0,0,0,,Өйткені, бұл не?
Dialogue: 0,0:04:25.23,0:04:26.43,Default,,0,0,0,,20 ғасырдың соңы
Dialogue: 0,0:04:26.96,0:04:31.36,Default,,0,0,0,,Солтүстік Каролинадағы Нейсе өзенінде фитопланктонның өршуі
Dialogue: 0,0:04:32.13,0:04:33.63,Default,,0,0,0,,Faceteria piscicida
Dialogue: 0,0:04:34.70,0:04:36.83,Default,,0,0,0,,Қоршаған ортаның өзгеруіне байланысты.
Dialogue: 0,0:04:36.96,0:04:40.16,Default,,0,0,0,,Аз уақыт ішінде ең жақсы пішінге айналатын жаратылыстар
Dialogue: 0,0:04:41.23,0:04:43.50,Default,,0,0,0,,Балшықта өмір сүрсең, қоршалған күйдесің.
Dialogue: 0,0:04:44.56,0:04:48.60,Default,,0,0,0,,Өсімдіктер айналасында өскен кезде олармен қоректенетін амебоидты пішін
Dialogue: 0,0:04:49.46,0:04:52.90,Default,,0,0,0,,Балықтардың саны көбейген сайын олар жалауша болып, етқоректіге айналады.
Dialogue: 0,0:04:53.83,0:04:58.33,Default,,0,0,0,,Басқалары Ол іс жүзінде 24 түрлендіру қабілетіне ие болды.
Dialogue: 0,0:04:59.53,0:05:02.66,Default,,0,0,0,,Сондай-ақ олар уыттылықпен өздерін қорғай алады.
Dialogue: 0,0:05:03.23,0:05:06.80,Default,,0,0,0,,Одан да таңғаларлық, ол ауа арқылы адамға жұғады.
Dialogue: 0,0:05:07.06,0:05:11.86,Default,,0,0,0,,Оның тіпті сағаттарды, тіпті күндерді де жадыны өшіру мүмкіндігі болды.
Dialogue: 0,0:05:12.60,0:05:15.60,Default,,0,0,0,,Әрине, бұл біздің болмысымыз.
Dialogue: 0,0:05:15.73,0:05:19.50,Default,,0,0,0,,Адамдар түсінбегендіктен бе, білмеймін, бірақ...
Dialogue: 0,0:05:20.13,0:05:22.60,Default,,0,0,0,,Бұл Планктон Беттерманның шынайы тұлғасы ма?
Dialogue: 0,0:05:23.03,0:05:24.56,Default,,0,0,0,,Дәл солай шығар
Dialogue: 0,0:05:25.00,0:05:28.66,Default,,0,0,0,,Жақсырақ формаларға айналу мүмкіндігі бар приматтар\NМенің ойымша, бұл
Dialogue: 0,0:05:29.00,0:05:30.26,Default,,0,0,0,,.
Dialogue: 0,0:05:31.06,0:05:33.13,Default,,0,0,0,,Сара Сараның Limipid арнасы бойынша
Dialogue: 0,0:05:33.73,0:05:36.56,Default,,0,0,0,,Бұл жауынгерлік форманың аты - Тұмандық.
Dialogue: 0,0:05:38.20,0:05:39.30,Default,,0,0,0,,Гао
Dialogue: 0,0:05:39.66,0:05:42.00,Default,,0,0,0,,Ал адам кейпінде болған кезде аты кім болған?
Dialogue: 0,0:05:44.03,0:05:44.66,Default,,0,0,0,,Ламия
Dialogue: 0,0:05:46.26,0:05:51.00,Default,,0,0,0,,Әйтеуір, менің ойымша, атмосфера Хинокиге ұқсас болды.
Dialogue: 0,0:05:51.13,0:05:51.60,Default,,0,0,0,,Ах
Dialogue: 0,0:05:51.93,0:05:57.50,Default,,0,0,0,,Хиноки… Хиноки… Хиноки…
Dialogue: 0,0:05:57.83,0:05:59.46,Default,,0,0,0,,Ақылсыз сөз айтпа.
Dialogue: 0,0:05:59.73,0:06:01.93,Default,,0,0,0,,Мен олай құбыжыққа айналмаймын.
Dialogue: 0,0:06:02.16,0:06:03.56,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:06:04.10,0:06:05.20,Default,,0,0,0,,А, қайда бара жатырсың?
Dialogue: 0,0:06:07.23,0:06:07.86,Default,,0,0,0,,Дәретхана
Dialogue: 0,0:06:13.10,0:06:13.83,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:06:17.30,0:06:17.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:22.46,0:06:22.96,Default,,0,0,0,,Ах
Dialogue: 0,0:06:27.83,0:06:28.33,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:06:28.63,0:06:31.13,Default,,0,0,0,,А, мен саған бірден шай берейін.
Dialogue: 0,0:06:31.90,0:06:33.20,Default,,0,0,0,,Иә
Dialogue: 0,0:06:40.60,0:06:41.10,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:06:45.33,0:06:46.80,Default,,0,0,0,,Ламия?
Dialogue: 0,0:06:50.33,0:06:50.83,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:06:52.56,0:06:56.26,Default,,0,0,0,,Бірақ Беттерманның мұндай құбыжық кейіпке енетініне сене алмаймын.
Dialogue: 0,0:06:57.00,0:07:00.16,Default,,0,0,0,,Дененің ішкі бөлігі өте күрделі құрылымды болуы керек.
Dialogue: 0,0:07:01.30,0:07:01.83,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:07:03.86,0:07:04.63,Default,,0,0,0,,Кейта-кун
Dialogue: 0,0:07:05.73,0:07:06.26,Default,,0,0,0,,Иә
Dialogue: 0,0:07:07.03,0:07:11.23,Default,,0,0,0,,Мысалы, сіздің өміріңіз үшін
Dialogue: 0,0:07:12.10,0:07:13.86,Default,,0,0,0,,Мысалы?
Dialogue: 0,0:07:15.23,0:07:17.00,Default,,0,0,0,,Мысалы, бұл
Dialogue: 0,0:07:17.80,0:07:20.86,Default,,0,0,0,,Еееееееееее иә иә? Гуггаа
Dialogue: 0,0:07:20.90,0:07:23.00,Default,,0,0,0,,Белдік өте маңызды, солай ма?
Dialogue: 0,0:07:23.56,0:07:24.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.20,0:07:28.46,Default,,0,0,0,,Бұл жай ғана жіп, бірақ ол өзінің қажетті мақсатын орындайды.
Dialogue: 0,0:07:29.00,0:07:34.13,Default,,0,0,0,,Ха, тойған соң, тынығасың.
Dialogue: 0,0:07:34.20,0:07:36.56,Default,,0,0,0,,Ха ха ха ха ха ха ха ха
Dialogue: 0,0:07:37.43,0:07:38.80,Default,,0,0,0,,Міне, осыны білдіреді.
Dialogue: 0,0:07:39.76,0:07:42.26,Default,,0,0,0,,Күрделілік міндетті түрде эволюцияны білдірмейді
Dialogue: 0,0:07:43.63,0:07:47.36,Default,,0,0,0,,Даралар мен түрлердің сақталуы тіршіліктің мәні болса
Dialogue: 0,0:07:48.13,0:07:51.46,Default,,0,0,0,,Вакуумда немесе -270℃ ортада
Dialogue: 0,0:07:52.20,0:07:54.23,Default,,0,0,0,,Тіпті 1000℃ жоғары температурада
Dialogue: 0,0:07:54.63,0:07:59.46,Default,,0,0,0,,Өзін мұздатып кептіретін және тірі қала алатын микроорганизмдер жақсырақ
Dialogue: 0,0:07:59.86,0:08:01.50,Default,,0,0,0,,әлдеқайда жоғары деп айтуға болады.
Dialogue: 0,0:08:02.80,0:08:06.63,Default,,0,0,0,,Қысқасы, заттарды тек бетіне қарап бағаламаңыз.
Dialogue: 0,0:08:07.60,0:08:09.23,Default,,0,0,0,,Кейта-кун, саған осындай әңгімелер ұнай ма?
Dialogue: 0,0:08:09.90,0:08:12.26,Default,,0,0,0,,Бұл қиын, бірақ қызықты.
Dialogue: 0,0:08:13.06,0:08:15.33,Default,,0,0,0,,Сонда сізде ғұлама болу таланты бар.
Dialogue: 0,0:08:15.53,0:08:20.16,Default,,0,0,0,,Хаха, тіпті мектептегі мұндай бағалар үшін де төменнен санау жылдамырақ.
Dialogue: 0,0:08:21.13,0:08:22.40,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:23.23,0:08:24.06,Default,,0,0,0,,Мен саған айттым ғой, солай ма?
Dialogue: 0,0:08:24.46,0:08:26.53,Default,,0,0,0,,Үстірт нәрсеге қарап үкім шығармаңыз
Dialogue: 0,0:08:27.13,0:08:28.53,Default,,0,0,0,,Біріншіден, қызығушылық танытыңыз.
Dialogue: 0,0:08:29.46,0:08:31.26,Default,,0,0,0,,Оқытудың мәні де осында
Dialogue: 0,0:08:33.40,0:08:34.50,Default,,0,0,0,,Мұндағы Штрохейм — сен бетпе-бет келетін соңғы қарсыласың.
Dialogue: 0,0:08:36.33,0:08:37.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:38.03,0:08:39.30,Default,,0,0,0,,Электр жүйесінің ақауы?
Dialogue: 0,0:08:39.53,0:08:40.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:41.33,0:08:42.13,Default,,0,0,0,,Мен қараймын.
Dialogue: 0,0:08:42.36,0:08:43.33,Default,,0,0,0,,О, мен де
Dialogue: 0,0:08:49.93,0:08:50.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:51.13,0:08:54.03,Default,,0,0,0,,А-а, м-м, кешіріңіз, мм.
Dialogue: 0,0:08:54.60,0:08:56.60,Default,,0,0,0,,Басқару жүйесі жақсы, солай ма?
Dialogue: 0,0:08:57.66,0:08:58.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:59.43,0:09:02.30,Default,,0,0,0,,-Уау!
Dialogue: 0,0:09:02.36,0:09:04.16,Default,,0,0,0,,...
Dialogue: 0,0:09:04.36,0:09:05.10,Default,,0,0,0,,Қуыршақ?
Dialogue: 0,0:09:05.73,0:09:10.20,Default,,0,0,0,,Уф, соқтығыс эксперименттерінде қолданылған муляжға ұқсайды.
Dialogue: 0,0:09:10.63,0:09:11.73,Default,,0,0,0,,Неліктен бұл нәрсе?
Dialogue: 0,0:09:13.06,0:09:13.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:14.16,0:09:15.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:19.63,0:09:22.66,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:09:23.33,0:09:26.43,Default,,0,0,0,,Өлме
Dialogue: 0,0:09:26.83,0:09:30.36,Default,,0,0,0,,Өлме
Dialogue: 0,0:09:30.50,0:09:34.00,Default,,0,0,0,,-Мен өлген жоқпын -Ааааааааааааааааааааааааа
Dialogue: 0,0:09:38.06,0:09:38.53,Default,,0,0,0,,болып табылады
Dialogue: 0,0:09:41.20,0:09:44.03,Default,,0,0,0,,ku келе жатыр, бірдеңе келе жатыр
Dialogue: 0,0:09:44.86,0:09:45.70,Default,,0,0,0,,кабинаға
Dialogue: 0,0:09:46.33,0:09:48.86,Default,,0,0,0,,Ммм, неге аша алмаймын?
Dialogue: 0,0:09:49.76,0:09:50.26,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:55.70,0:09:57.00,Default,,0,0,0,,Ммм хах
Dialogue: 0,0:09:57.73,0:09:58.46,Default,,0,0,0,,Саған қонақүй тауып беремін.
Dialogue: 0,0:09:59.06,0:10:02.23,Default,,0,0,0,,Өлме
Dialogue: 0,0:10:03.10,0:10:06.33,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:10:08.83,0:10:09.60,Default,,0,0,0,,Бұл
Dialogue: 0,0:10:12.96,0:10:13.83,Default,,0,0,0,,А, бұл
Dialogue: 0,0:10:15.73,0:10:16.23,Default,,0,0,0,,Ах
Dialogue: 0,0:10:18.36,0:10:18.86,Default,,0,0,0,,Га
Dialogue: 0,0:10:18.90,0:10:21.06,Default,,0,0,0,,Әй, бұл қуыршақ ғой.
Dialogue: 0,0:10:22.33,0:10:25.03,Default,,0,0,0,,Уф, мен қазір автопилотта заттарды басқарып жатырмын.
Dialogue: 0,0:10:25.46,0:10:27.90,Default,,0,0,0,,Деректерді жаңартпасаңыз, ол ақырында бұзылады.
Dialogue: 0,0:10:28.73,0:10:30.26,Default,,0,0,0,,Неге?
Dialogue: 0,0:10:31.46,0:10:34.46,Default,,0,0,0,,Өлме
Dialogue: 0,0:10:34.63,0:10:37.50,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:10:37.70,0:10:40.53,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:10:40.70,0:10:43.60,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:10:43.73,0:10:46.60,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:10:51.63,0:10:52.80,Default,,0,0,0,,Президент
Dialogue: 0,0:10:54.50,0:10:55.46,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:55.56,0:10:57.40,Default,,0,0,0,,Сара-чан
Dialogue: 0,0:10:58.40,0:10:59.13,Default,,0,0,0,,О?
Dialogue: 0,0:10:59.46,0:11:02.30,Default,,0,0,0,,Хота-сан аспанда
Dialogue: 0,0:11:03.16,0:11:06.26,Default,,0,0,0,,Хиноки-сан және Асами-сан
Dialogue: 0,0:11:07.03,0:11:09.73,Default,,0,0,0,,Көптеген қуыршақтар
Dialogue: 0,0:11:10.23,0:11:11.76,Default,,0,0,0,,-Қуыршақ? -Фуу
Dialogue: 0,0:11:11.80,0:11:14.13,Default,,0,0,0,,-Сен қуыршақ түрін айтып тұрсың ба? -Ааа
Dialogue: 0,0:11:14.20,0:11:14.66,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:14.70,0:11:17.56,Default,,0,0,0,,Осы уақытта Хиноки және басқалары әлі аспанда ма?
Dialogue: 0,0:11:18.13,0:11:18.96,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:11:20.43,0:11:21.23,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:11:22.03,0:11:22.83,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:11:23.46,0:11:25.86,Default,,0,0,0,,Мен қазір сізбен байланысуға тырысамын.
Dialogue: 0,0:11:26.73,0:11:29.96,Default,,0,0,0,,Бірдеңе болса, өзін-өзі қорғау күштерін жібересіз бе?
Dialogue: 0,0:11:31.33,0:11:34.36,Default,,0,0,0,,Оянған адамдарда ұшу аппараттары жоқ.
Dialogue: 0,0:11:36.23,0:11:36.96,Default,,0,0,0,,Тұмандық
Dialogue: 0,0:11:46.50,0:11:47.33,Default,,0,0,0,,Гууууууу
Dialogue: 0,0:11:47.73,0:11:48.20,Default,,0,0,0,,Ах
Dialogue: 0,0:11:50.03,0:11:50.73,Default,,0,0,0,,-Hii -Ah
Dialogue: 0,0:11:52.00,0:11:52.76,Default,,0,0,0,,Хиноки-сан?
Dialogue: 0,0:11:54.63,0:11:56.96,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:11:57.90,0:11:58.40,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:59.83,0:12:00.90,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:12:00.93,0:12:01.90,Default,,0,0,0,,Сіз ұсталған сияқтысыз.
Dialogue: 0,0:12:01.96,0:12:02.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:02.90,0:12:04.76,Default,,0,0,0,,Этто
Dialogue: 0,0:12:06.46,0:12:07.23,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:08.43,0:12:09.43,Default,,0,0,0,,Асами-сан, міне осы.
Dialogue: 0,0:12:10.53,0:12:11.73,Default,,0,0,0,,Қызмет көрсету бөлмесі?
Dialogue: 0,0:12:12.93,0:12:14.20,Default,,0,0,0,,Мен оны бұрын көргенмін.
Dialogue: 0,0:12:14.40,0:12:15.43,Default,,0,0,0,,Дәлдік сызбалар жинағы
Dialogue: 0,0:12:15.80,0:12:19.30,Default,,0,0,0,,С-21 көлік ұшағының төменгі жартысы жүк болып табылады.
Dialogue: 0,0:12:20.16,0:12:21.10,Default,,0,0,0,,Лифттер де
Dialogue: 0,0:12:22.46,0:12:23.86,Default,,0,0,0,,А, болды
Dialogue: 0,0:12:24.46,0:12:25.70,Default,,0,0,0,,Бұл өте кішкентай.
Dialogue: 0,0:12:26.10,0:12:27.93,Default,,0,0,0,,Енді сіз төменге түсуіңіз керек.
Dialogue: 0,0:12:28.40,0:12:32.53,Default,,0,0,0,,Иә? Ха, бұл біртүрлі
Dialogue: 0,0:12:34.30,0:12:35.23,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:38.40,0:12:39.06,Default,,0,0,0,,-Ой? -А
Dialogue: 0,0:12:41.20,0:12:46.00,Default,,0,0,0,,А-а, міне, мінекей, қолмен лифт құлпы.
Dialogue: 0,0:12:46.20,0:12:49.66,Default,,0,0,0,,Мен сол хахаха ахахахха іздедім
Dialogue: 0,0:12:50.43,0:12:53.63,Default,,0,0,0,,...
Dialogue: 0,0:12:54.93,0:12:56.96,Default,,0,0,0,,Ой және ааа
Dialogue: 0,0:12:57.00,0:12:57.46,Default,,0,0,0,,О
Dialogue: 0,0:12:58.30,0:12:59.33,Default,,0,0,0,,(5-сынып оқушысы 5) Сүтсіз. (4-сынып оқушысы 4) Жырт.
Dialogue: 0,0:13:00.93,0:13:02.70,Default,,0,0,0,,Хотару-кун!
Dialogue: 0,0:13:03.13,0:13:04.03,Default,,0,0,0,,Менімен танысыңыз
Dialogue: 0,0:13:04.06,0:13:04.83,Default,,0,0,0,,Уа
Dialogue: 0,0:13:06.46,0:13:08.56,Default,,0,0,0,,Ой, кешіріңіз, жақсысыз ба?
Dialogue: 0,0:13:09.66,0:13:12.43,Default,,0,0,0,,Көп жағдайда жақсы.
Dialogue: 0,0:13:16.10,0:13:17.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:18.30,0:13:22.80,Default,,0,0,0,,Хаа хаа, бұл пайдалы болды.
Dialogue: 0,0:13:24.20,0:13:27.23,Default,,0,0,0,,Эй, мен тағы келдім.
Dialogue: 0,0:13:30.26,0:13:31.83,Default,,0,0,0,,Бұл жолы неден бастаймыз?
Dialogue: 0,0:13:32.60,0:13:34.86,Default,,0,0,0,,Жоғарғы сол жақ?
Dialogue: 0,0:13:35.40,0:13:36.33,Default,,0,0,0,,Әлде…
Dialogue: 0,0:13:37.56,0:13:43.06,Default,,0,0,0,,Увааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:13:43.33,0:13:43.80,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:47.66,0:13:52.66,Default,,0,0,0,,Хунгаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:13:52.83,0:13:53.80,Default,,0,0,0,,Кейта-кун?
Dialogue: 0,0:13:53.83,0:13:56.63,Default,,0,0,0,,...
Dialogue: 0,0:13:57.06,0:13:58.40,Default,,0,0,0,,Қараңызшы, Асами-сан.
Dialogue: 0,0:13:59.80,0:14:00.66,Default,,0,0,0,,Баяндамашы?
Dialogue: 0,0:14:01.56,0:14:04.00,Default,,0,0,0,,Иә, бұл үш өлшемді дыбыс жүйесі.
Dialogue: 0,0:14:04.63,0:14:06.96,Default,,0,0,0,,Ешкім басынан айықпаған.
Dialogue: 0,0:14:07.90,0:14:09.93,Default,,0,0,0,,Жоғарыда, аудитория орындарындағы спикерлерді пайдалану.
Dialogue: 0,0:14:10.40,0:14:13.10,Default,,0,0,0,,Бұл жүк ағаш қорапқа орнатылған динамиктерді пайдаланады.
Dialogue: 0,0:14:13.43,0:14:16.53,Default,,0,0,0,,Бұл бірдеңе бар сияқты дыбыс шығарды.
Dialogue: 0,0:14:17.13,0:14:17.76,Default,,0,0,0,,О
Dialogue: 0,0:14:19.03,0:14:20.10,Default,,0,0,0,,Эй, Хота-кун
Dialogue: 0,0:14:20.80,0:14:23.30,Default,,0,0,0,,Иттер мен мысықтар түннің қараңғылығынан қорықпайды.
Dialogue: 0,0:14:23.93,0:14:27.53,Default,,0,0,0,,Бірақ көптеген адамдар қараңғылықта қалды.
Dialogue: 0,0:14:28.03,0:14:30.63,Default,,0,0,0,,Бұл мені азды-көпті алаңдатады.
Dialogue: 0,0:14:31.63,0:14:32.56,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:14:33.16,0:14:37.83,Default,,0,0,0,,Аа, бұл бұрынғы өмірден естелік немесе басқа нәрсе.
Dialogue: 0,0:14:38.43,0:14:39.33,Default,,0,0,0,,Елестету
Dialogue: 0,0:14:39.86,0:14:40.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:40.73,0:14:42.26,Default,,0,0,0,,Адамдарда қиял бар.
Dialogue: 0,0:14:42.90,0:14:44.20,Default,,0,0,0,,Қараңғыдан кім қорқады?
Dialogue: 0,0:14:44.53,0:14:47.46,Default,,0,0,0,,Өйткені мен сол қараңғыда көрінбейтін нәрсе жасырынып жатқанын елестетемін.
Dialogue: 0,0:14:48.63,0:14:51.73,Default,,0,0,0,,Бұл қиялды оятуға арналған құрал.
Dialogue: 0,0:14:52.26,0:14:55.66,Default,,0,0,0,,Адам психологиясын пайдаланатын нағыз тиімді өндіріс
Dialogue: 0,0:14:56.66,0:14:59.16,Default,,0,0,0,,Жұмбақ үй сияқты.
Dialogue: 0,0:14:59.76,0:15:02.63,Default,,0,0,0,,Әй, бірақ бұл қулықты қалай байқадың?
Dialogue: 0,0:15:03.00,0:15:07.76,Default,,0,0,0,,Әй, мына ағаш жәшік үндеткіштердің дыбысынан аздап дірілдеп тұрды.
Dialogue: 0,0:15:08.20,0:15:10.70,Default,,0,0,0,,Ішінде дыбыс көзі бар екенін бірден білдім.
Dialogue: 0,0:15:11.06,0:15:12.70,Default,,0,0,0,,Бақылаудың ұлы күштері.
Dialogue: 0,0:15:12.96,0:15:15.86,Default,,0,0,0,,Жақсы, хехе, болды, хехехе
Dialogue: 0,0:15:16.23,0:15:18.66,Default,,0,0,0,,Үстірт нәрселерге алданба.
Dialogue: 0,0:15:18.96,0:15:21.80,Default,,0,0,0,,Хахахахахмммм
Dialogue: 0,0:15:22.23,0:15:23.50,Default,,0,0,0,,Әлі де сөйлеуші жоқ
Dialogue: 0,0:15:27.36,0:15:29.36,Default,,0,0,0,,Сөйлеуші емес
Dialogue: 0,0:15:35.80,0:15:38.16,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:15:42.33,0:15:44.33,Default,,0,0,0,,Қуыршақ қозғалады
Dialogue: 0,0:15:52.53,0:15:54.00,Default,,0,0,0,,У-а-а
Dialogue: 0,0:15:55.03,0:15:55.96,Default,,0,0,0,,Қауіпті көрінеді.
Dialogue: 0,0:15:56.06,0:15:57.83,Default,,0,0,0,,Эй, бұл өте жаман.
Dialogue: 0,0:16:00.03,0:16:01.00,Default,,0,0,0,,Қашайық
Dialogue: 0,0:16:14.96,0:16:15.40,Default,,0,0,0,,Уф
Dialogue: 0,0:16:15.43,0:16:16.40,Default,,0,0,0,,-Ха ха ха ха -Қашып кет!
Dialogue: 0,0:16:16.63,0:16:17.16,Default,,0,0,0,,Ах
Dialogue: 0,0:16:20.26,0:16:22.10,Default,,0,0,0,,Иә? Жоғары?
Dialogue: 0,0:16:28.26,0:16:29.66,Default,,0,0,0,,Тағы да
Dialogue: 0,0:16:32.73,0:16:35.96,Default,,0,0,0,,Уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:16:37.46,0:16:38.33,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:16:38.70,0:16:39.86,Default,,0,0,0,,Сәлем Хиноки
Dialogue: 0,0:16:40.73,0:16:42.10,Default,,0,0,0,,Бұл да жақсы емес.
Dialogue: 0,0:16:42.76,0:16:44.33,Default,,0,0,0,,Аа, жақсы болдыңыз ба?
Dialogue: 0,0:16:44.80,0:16:47.63,Default,,0,0,0,,Мені тастап кету жауыздық емес пе?
Dialogue: 0,0:16:47.80,0:16:52.40,Default,,0,0,0,,А, солай. Хиноки болса жарайды ма деп ойлаймын.
Dialogue: 0,0:16:52.60,0:16:54.56,Default,,0,0,0,,Адамдарға қайтадан құбыжық сияқты қарау
Dialogue: 0,0:16:54.76,0:16:55.76,Default,,0,0,0,,Жоқ, хехе
Dialogue: 0,0:16:56.13,0:16:56.63,Default,,0,0,0,,Га
Dialogue: 0,0:16:56.96,0:16:57.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:57.96,0:16:58.53,Default,,0,0,0,,...
Dialogue: 0,0:17:02.96,0:17:05.23,Default,,0,0,0,,Хмм аааааааааааааааааааааааааа
Dialogue: 0,0:17:05.26,0:17:07.66,Default,,0,0,0,,Уау, tho
Dialogue: 0,0:17:07.86,0:17:09.00,Default,,0,0,0,,Уау, ой, ой
Dialogue: 0,0:17:09.06,0:17:12.20,Default,,0,0,0,,Сізде қару, парашют немесе басқа нәрсе жоқ па?
Dialogue: 0,0:17:12.26,0:17:14.40,Default,,0,0,0,,Хмм, Dual Kind дегеніміз не?
Dialogue: 0,0:17:14.43,0:17:18.06,Default,,0,0,0,,Сіз психокинез немесе телепортация сияқты заттарды пайдалана алмайсыз, солай ма?
Dialogue: 0,0:17:18.86,0:17:22.56,Default,,0,0,0,,Өкінішке орай, егер сіз оянған адам сияқты нейроноидпен жүрмесеңіз.
Dialogue: 0,0:17:23.00,0:17:24.43,Default,,0,0,0,,Қарапайым адамдардан айырмашылығы жоқ
Dialogue: 0,0:17:25.10,0:17:27.56,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:28.16,0:17:28.60,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:17:29.70,0:17:30.46,Default,,0,0,0,,Енді бірдеңе
Dialogue: 0,0:17:30.86,0:17:31.33,Default,,0,0,0,,Га
Dialogue: 0,0:17:40.63,0:17:41.40,Default,,0,0,0,,Жақсырақ адам?
Dialogue: 0,0:17:41.80,0:17:42.60,Default,,0,0,0,,- Иә? -Не?
Dialogue: 0,0:17:46.90,0:17:48.03,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:17:48.66,0:17:53.06,Default,,0,0,0,,Осы биіктікте және 800км/сағ жоғары жылдамдықпен ұша алатын тіршілік иесі.
Dialogue: 0,0:17:53.80,0:17:56.30,Default,,0,0,0,,Жоқ, сондықтан мен жақсы адаммын.
Dialogue: 0,0:18:06.93,0:18:08.33,Default,,0,0,0,,Не? Мен сені естімеймін.
Dialogue: 0,0:18:20.33,0:18:21.23,Default,,0,0,0,,Уа
Dialogue: 0,0:18:26.56,0:18:27.83,Default,,0,0,0,,Уау
Dialogue: 0,0:18:30.86,0:18:32.23,Default,,0,0,0,,Қуыршақ бомбасы?
Dialogue: 0,0:18:32.66,0:18:33.76,Default,,0,0,0,,Беттермен ше?
Dialogue: 0,0:18:34.06,0:18:37.06,Default,,0,0,0,,Бұл сияқты нәрседен жеңілетін жұмсақ жаратылыс болмауы керек.
Dialogue: 0,0:18:41.40,0:18:43.66,Default,,0,0,0,,Уу-у
Dialogue: 0,0:18:45.86,0:18:47.06,Default,,0,0,0,,Уаааа
Dialogue: 0,0:19:02.36,0:19:03.80,Default,,0,0,0,,Сіз соққы алдыңыз ба?
Dialogue: 0,0:19:07.83,0:19:08.43,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:19:12.23,0:19:13.76,Default,,0,0,0,,Егер бұл орын алса
Dialogue: 0,0:19:15.43,0:19:17.80,Default,,0,0,0,,Гунггггггхххххххххххххххх
Dialogue: 0,0:19:17.93,0:19:21.50,Default,,0,0,0,,Қалай? Коннярой!
Dialogue: 0,0:19:21.63,0:19:25.03,Default,,0,0,0,,Ораораораораораора иә?
Dialogue: 0,0:19:25.23,0:19:25.66,Default,,0,0,0,,О
Dialogue: 0,0:19:26.16,0:19:26.73,Default,,0,0,0,,О
Dialogue: 0,0:19:26.80,0:19:27.30,Default,,0,0,0,,...
Dialogue: 0,0:19:29.60,0:19:30.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:31.66,0:19:32.53,Default,,0,0,0,,Уф уф
Dialogue: 0,0:19:33.30,0:19:33.73,Default,,0,0,0,,Уф
Dialogue: 0,0:19:33.83,0:19:35.06,Default,,0,0,0,,Сол тышқаннан сақ бол!
Dialogue: 0,0:19:38.00,0:19:43.26,Default,,0,0,0,,перне
Dialogue: 0,0:19:46.86,0:19:49.63,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:19:49.70,0:19:51.10,Default,,0,0,0,,Керемет!
Dialogue: 0,0:19:52.26,0:19:52.93,Default,,0,0,0,,Сәлем
Dialogue: 0,0:19:56.53,0:19:57.26,Default,,0,0,0,,Денең біраз жазылып қалыпты ғой, иә?
Dialogue: 0,0:19:58.46,0:19:58.93,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:20:00.33,0:20:00.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:01.43,0:20:02.53,Default,,0,0,0,,О, мен жасадым ба?
Dialogue: 0,0:20:02.80,0:20:03.36,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:03.43,0:20:04.13,Default,,0,0,0,,Ааа?
Dialogue: 0,0:20:04.76,0:20:06.93,Default,,0,0,0,,Бұл «Төменгі әлем» бөліміндегімен бірдей
Dialogue: 0,0:20:07.43,0:20:09.40,Default,,0,0,0,,- Уаааа - Беттерман тұманының шығуы
Dialogue: 0,0:20:09.73,0:20:12.00,Default,,0,0,0,,Өте жоғары жиілікті психо-дауыс
Dialogue: 0,0:20:14.36,0:20:16.86,Default,,0,0,0,,Көлік ұшағына зақым келтірместен
Dialogue: 0,0:20:17.46,0:20:20.73,Default,,0,0,0,,Мен объектіні соншалықты тамаша жоя алғаныма сене алмаймын.
Dialogue: 0,0:20:21.76,0:20:24.20,Default,,0,0,0,,Ха, бәрі жақсы, егер ол көмектессе.
Dialogue: 0,0:20:25.10,0:20:25.80,Default,,0,0,0,,Ах аа
Dialogue: 0,0:20:25.93,0:20:27.50,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:20:28.33,0:20:28.96,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:20:29.56,0:20:31.73,Default,,0,0,0,,-Иә, құлап жатыр -Ааа
Dialogue: 0,0:20:31.83,0:20:33.20,Default,,0,0,0,,Бұл өте дұрыс
Dialogue: 0,0:20:37.63,0:20:38.36,Default,,0,0,0,,Бұл теңіз
Dialogue: 0,0:20:38.60,0:20:41.83,Default,,0,0,0,,Осы жылдамдықпен құласа, ол құлап кетеді!
Dialogue: 0,0:20:41.90,0:20:45.86,Default,,0,0,0,,Беттерменді көзбен көріп тұрсам да, бұл ұят.
Dialogue: 0,0:20:58.16,0:20:59.56,Default,,0,0,0,,Гуруруруруру
Dialogue: 0,0:21:25.76,0:21:27.80,Default,,0,0,0,,Теңіз жарылып жатыр ма?
Dialogue: 0,0:21:29.60,0:21:31.53,Default,,0,0,0,,Бұл негізгі әсер ме?
Dialogue: 0,0:21:32.93,0:21:34.53,Default,,0,0,0,,Қанат астындағы соққы толқыны
Dialogue: 0,0:21:35.40,0:21:38.33,Default,,0,0,0,,Бұл көлік ұшағы дыбыстан жоғары толқындар үстінде жүреді.
Dialogue: 0,0:21:40.10,0:21:41.46,Default,,0,0,0,,Виллид
Dialogue: 0,0:21:43.33,0:21:44.06,Default,,0,0,0,,Уау
Dialogue: 0,0:21:58.03,0:22:02.66,Default,,0,0,0,,Қанатында осындай үлкен жүк бар үлкен көлік ұшағын оған тимей-ақ басқарасыз ба?
Dialogue: 0,0:22:03.36,0:22:04.30,Default,,0,0,0,,(Отокоцудың дауысы)
Dialogue: 0,0:22:05.46,0:22:06.50,Default,,0,0,0,,Беттерман
Dialogue: 0,0:22:19.40,0:22:22.63,Default,,0,0,0,,Өлме
Dialogue: 0,0:22:22.73,0:22:25.76,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:22:25.83,0:22:29.60,Default,,0,0,0,,Өлме
Dialogue: 0,0:22:34.53,0:22:47.13,Default,,0,0,0,,Құдайдың күнәсі шексіз теломераларға жазылды
Dialogue: 0,0:22:47.86,0:22:54.06,Default,,0,0,0,,Жалынды құшақтау
Dialogue: 0,0:22:54.40,0:23:01.56,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:01.83,0:23:05.13,Default,,0,0,0,,Жан рух Жалғыз дауыс
Dialogue: 0,0:23:05.33,0:23:08.53,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.76,0:23:12.00,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.20,0:23:15.43,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.53,0:23:27.23,Default,,0,0,0,,Алыстағы күннің сәулесін тап!
Dialogue: 0,0:23:27.43,0:23:37.23,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:37.83,0:23:48.86,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:58.76,0:24:00.20,Default,,0,0,0,,Көк жалын
Dialogue: 0,0:24:01.13,0:24:03.43,Default,,0,0,0,,Өртенген адам етінің иісі
Dialogue: 0,0:24:04.96,0:24:05.80,Default,,0,0,0,,Сіз күтесіз бе?
Dialogue: 0,0:24:07.13,0:24:08.20,Default,,0,0,0,,Сіз қоңырау шалып жатырсыз ба?
Dialogue: 0,0:24:09.43,0:24:10.86,Default,,0,0,0,,Мектеп жертөлесі
Dialogue: 0,0:24:12.56,0:24:15.90,Default,,0,0,0,,Ояну рәсімі басталады
Dialogue: 0,0:24:17.26,0:24:20.00,Default,,0,0,0,,Ыстық
Dialogue: 0,0:24:22.03,0:24:25.53,Default,,0,0,0,,Бетіңіз еріп кетеді
Dialogue: 0,0:24:27.03,0:24:33.03,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
