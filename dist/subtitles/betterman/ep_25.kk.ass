Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:20.90,0:00:24.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:24.93,0:00:26.40,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:00:27.36,0:00:28.16,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:00:29.36,0:00:30.63,Default,,0,0,0,,Хэ-хэ
Dialogue: 0,0:00:37.43,0:00:39.26,Default,,0,0,0,,Ку ха ха
Dialogue: 0,0:00:42.46,0:00:43.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:44.10,0:00:45.10,Default,,0,0,0,,Уа, ау, ау
Dialogue: 0,0:00:46.36,0:00:48.30,Default,,0,0,0,,Уф хаа
Dialogue: 0,0:00:50.83,0:00:52.70,Default,,0,0,0,,Уф хаа
Dialogue: 0,0:00:59.30,0:01:01.63,Default,,0,0,0,,Хаа
Dialogue: 0,0:01:08.56,0:01:11.43,Default,,0,0,0,,Мен сені күттім, Цукокун.
Dialogue: 0,0:01:13.30,0:01:14.06,Default,,0,0,0,,Офицер
Dialogue: 0,0:01:15.26,0:01:16.90,Default,,0,0,0,,Көк балта Кейта
Dialogue: 0,0:01:17.60,0:01:21.13,Default,,0,0,0,,Туғаннан кейін көп ұзамай жазатайым оқиғадан бас жарақаты
Dialogue: 0,0:01:21.63,0:01:22.13,Default,,0,0,0,,Уф
Dialogue: 0,0:01:22.90,0:01:28.00,Default,,0,0,0,,Жазбаларға сәйкес, сол кезде үлгіден dura mater трансплантацияланған.
Dialogue: 0,0:01:28.40,0:01:30.26,Default,,0,0,0,,Бас тарту реакциясы жоқ
Dialogue: 0,0:01:31.30,0:01:32.80,Default,,0,0,0,,Оның миы
Dialogue: 0,0:01:34.70,0:01:44.16,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:01:46.56,0:01:54.70,Default,,0,0,0,,Қалқымалы күміс қайық
Dialogue: 0,0:01:56.53,0:02:05.06,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:02:08.30,0:02:16.30,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:02:19.53,0:02:28.40,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:02:28.76,0:02:36.73,Default,,0,0,0,,Жанға бағыт беру
Dialogue: 0,0:02:38.50,0:02:48.23,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:48.56,0:03:00.46,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:03:07.86,0:03:11.26,Default,,0,0,0,,Сіздің роботыңыз мінсіз режимге жетті.
Dialogue: 0,0:03:11.46,0:03:14.80,Default,,0,0,0,,Сондықтан мен сіздерге «Үздік Робо» медалін ұсынғым келеді.
Dialogue: 0,0:03:15.76,0:03:17.40,Default,,0,0,0,,Құттықтаймыз Аонокун
Dialogue: 0,0:03:18.06,0:03:19.76,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:03:20.10,0:03:22.53,Default,,0,0,0,,Бұл ұзақ жол болды
Dialogue: 0,0:03:23.43,0:03:28.40,Default,,0,0,0,,Бірақ толығымен тазартылған болса, бұл аяқталды дегенді білдіреді.
Dialogue: 0,0:03:30.23,0:03:33.46,Default,,0,0,0,,Дамуды қажет етпейтіндей мінсіз не бар?
Dialogue: 0,0:03:34.80,0:03:35.50,Default,,0,0,0,,Ах
Dialogue: 0,0:03:40.06,0:03:41.23,Default,,0,0,0,,Сакора-чан
Dialogue: 0,0:03:42.46,0:03:45.26,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:03:45.70,0:03:48.50,Default,,0,0,0,,-Иойи - Президент Акамацу
Dialogue: 0,0:03:52.00,0:03:52.80,Default,,0,0,0,,Янаги мырза
Dialogue: 0,0:03:53.56,0:03:54.56,Default,,0,0,0,,Каэде-сан
Dialogue: 0,0:03:59.00,0:03:59.73,Default,,0,0,0,,Сіз
Dialogue: 0,0:04:01.00,0:04:04.76,Default,,0,0,0,,Кейта мен асығыспын, сондықтан мен саған қамқорлық жасай алмаймын.
Dialogue: 0,0:04:05.23,0:04:06.00,Default,,0,0,0,,Қош бол
Dialogue: 0,0:04:07.00,0:04:07.56,Default,,0,0,0,,Ах
Dialogue: 0,0:04:18.20,0:04:21.73,Default,,0,0,0,,Сілтеме гелін сақтау қабаты
Dialogue: 0,0:04:40.96,0:04:41.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:47.86,0:04:49.13,Default,,0,0,0,,К-чан
Dialogue: 0,0:04:49.76,0:04:51.96,Default,,0,0,0,,Хиноки Ахахахахха
Dialogue: 0,0:04:53.60,0:04:58.06,Default,,0,0,0,,Аха, жақсы. Ол тірі. Ол тірі. Хахахаха
Dialogue: 0,0:04:58.23,0:05:00.03,Default,,0,0,0,,Иә
Dialogue: 0,0:05:00.56,0:05:02.13,Default,,0,0,0,,Бала
Dialogue: 0,0:05:02.36,0:05:05.80,Default,,0,0,0,,Осы уақытқа дейін жеткеніңіз жақсы.
Dialogue: 0,0:05:06.13,0:05:06.73,Default,,0,0,0,,Игиги
Dialogue: 0,0:05:06.76,0:05:09.03,Default,,0,0,0,,Әй, сен әлі жынсың ғой.
Dialogue: 0,0:05:09.16,0:05:11.76,Default,,0,0,0,,Хинокиді қайтарыңыз
Dialogue: 0,0:05:12.06,0:05:13.96,Default,,0,0,0,,Иә, жоқ, қайтарыңыз.
Dialogue: 0,0:05:14.10,0:05:16.06,Default,,0,0,0,,Ахахха хахахаха
Dialogue: 0,0:05:17.10,0:05:18.90,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:05:20.03,0:05:24.10,Default,,0,0,0,,Біз ең күшті адамдар болмас бұрын, бұл жер бомбаланып, бәрі ұшып кетеді.
Dialogue: 0,0:05:24.93,0:05:25.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:25.50,0:05:30.26,Default,,0,0,0,,Ой, сілтеме гелін қалдырмаңыз.
Dialogue: 0,0:05:30.86,0:05:35.56,Default,,0,0,0,,Төменде ұйықтап жатқан мыңдаған адамдардың денесі босқа кетеді.
Dialogue: 0,0:05:36.23,0:05:38.86,Default,,0,0,0,,Сіз Альджернонсыз.
Dialogue: 0,0:05:39.23,0:05:41.20,Default,,0,0,0,,Охохохохохохо
Dialogue: 0,0:05:41.60,0:05:45.16,Default,,0,0,0,,Алжерноннан зардап шеккендер өлтіруді қайталайды.
Dialogue: 0,0:05:45.30,0:05:48.60,Default,,0,0,0,,Бұл түрдің тіршілік ету инстинкті.
Dialogue: 0,0:05:49.13,0:05:51.26,Default,,0,0,0,,Неліктен өлтіру аман қалады?
Dialogue: 0,0:05:51.76,0:05:56.60,Default,,0,0,0,,Альжернон ауру немесе құбылыс емес, ДНҚ бағдарламасы
Dialogue: 0,0:05:57.23,0:05:59.26,Default,,0,0,0,,Көп мәйіттерден үзілу
Dialogue: 0,0:05:59.30,0:06:04.26,Default,,0,0,0,,Ци энергиясы арқылы тірі дененің өзгеруіне бағыт беру.
Dialogue: 0,0:06:04.93,0:06:06.60,Default,,0,0,0,,Неліктен біз өзгеруіміз керек?
Dialogue: 0,0:06:07.06,0:06:10.26,Default,,0,0,0,,Қанкелден артық билікке ие болу.
Dialogue: 0,0:06:10.56,0:06:11.03,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:06:13.30,0:06:14.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:14.56,0:06:19.10,Default,,0,0,0,,Хохо, сен ақыры көріндің, Беттерман.
Dialogue: 0,0:06:19.86,0:06:22.46,Default,,0,0,0,,Күтуден шаршадым.
Dialogue: 0,0:06:23.36,0:06:25.53,Default,,0,0,0,,Кінәлі болған билік
Dialogue: 0,0:06:26.13,0:06:27.06,Default,,0,0,0,,Ламия
Dialogue: 0,0:06:27.53,0:06:28.30,Default,,0,0,0,,Ммм
Dialogue: 0,0:06:28.86,0:06:31.56,Default,,0,0,0,,Гомеобокс гендерсіз
Dialogue: 0,0:06:31.60,0:06:34.90,Default,,0,0,0,,Қанкелден аса алмайды
Dialogue: 0,0:06:35.56,0:06:39.33,Default,,0,0,0,,Денені оптикалық изомер ретінде қосу арқылы
Dialogue: 0,0:06:39.70,0:06:43.66,Default,,0,0,0,,Гибридизация аяқталды.
Dialogue: 0,0:06:44.60,0:06:47.40,Default,,0,0,0,,L типі және D типі Инь және Ян
Dialogue: 0,0:06:47.43,0:06:51.23,Default,,0,0,0,,Миллиардтаған жылдар бойы екіге бөлінген аминқышқылдары
Dialogue: 0,0:06:51.53,0:06:56.03,Default,,0,0,0,,Енді ақыры толық өмір формасына айналады
Dialogue: 0,0:06:57.46,0:06:58.50,Default,,0,0,0,,Не?
Dialogue: 0,0:06:58.96,0:06:59.60,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:00.23,0:07:01.13,Default,,0,0,0,,Nuo
Dialogue: 0,0:07:01.83,0:07:05.36,Default,,0,0,0,,Дәл екеуі бір-бірінен бөлінгендіктен, олар қатар өмір сүруі керек.
Dialogue: 0,0:07:06.23,0:07:07.66,Default,,0,0,0,,Керемет формада болыңыз
Dialogue: 0,0:07:08.23,0:07:12.50,Default,,0,0,0,,Қанкел сияқты басқаларды теріске шығарудың қайнар көзі.
Dialogue: 0,0:07:13.80,0:07:15.66,Default,,0,0,0,,Даамаре
Dialogue: 0,0:07:15.90,0:07:18.33,Default,,0,0,0,,Анимус гүліне делдал болғанымен.
Dialogue: 0,0:07:18.46,0:07:23.53,Default,,0,0,0,,Адамдарды жейтін Better Man сияқты адамдар адамзаттың қасіретін түсіне ала ма?
Dialogue: 0,0:07:23.90,0:07:27.36,Default,,0,0,0,,Адамзаттың ризығы бітсе, Жақсы адам да құрып кетеді.
Dialogue: 0,0:07:27.83,0:07:31.53,Default,,0,0,0,,Хиноки - Беттерман үшін таптырмас сорт.
Dialogue: 0,0:07:31.80,0:07:32.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:32.60,0:07:35.10,Default,,0,0,0,,Кел, жақсы адам, мені қорға.
Dialogue: 0,0:07:35.43,0:07:38.66,Default,,0,0,0,,Сол қартты жеңіп, Хинокиді құтқарыңыз.
Dialogue: 0,0:07:38.83,0:07:41.20,Default,,0,0,0,,Хохохохохо
Dialogue: 0,0:07:41.50,0:07:43.86,Default,,0,0,0,,Брахуман
Dialogue: 0,0:07:44.26,0:07:44.96,Default,,0,0,0,,Уау
Dialogue: 0,0:07:47.10,0:07:48.03,Default,,0,0,0,,К-чан
Dialogue: 0,0:07:51.00,0:07:52.20,Default,,0,0,0,,пектофораза
Dialogue: 0,0:07:52.63,0:07:53.26,Default,,0,0,0,,Рубрум
Dialogue: 0,0:07:55.63,0:07:58.56,Default,,0,0,0,,Уау Уау Уау
Dialogue: 0,0:08:03.33,0:08:05.53,Default,,0,0,0,,Керемет иммундық бөлшектер
Dialogue: 0,0:08:05.70,0:08:08.50,Default,,0,0,0,,Бірақ сізде мүмкіндік жоқ
Dialogue: 0,0:08:09.23,0:08:11.16,Default,,0,0,0,,Мен бәрін білемін
Dialogue: 0,0:08:11.33,0:08:15.53,Default,,0,0,0,,Мөлдір арналардан асып түсетін оқиғаларды болжау
Dialogue: 0,0:08:15.93,0:08:20.70,Default,,0,0,0,,үшін Акашикалық жазбаларда жазылған шындық
Dialogue: 0,0:08:28.06,0:08:29.00,Default,,0,0,0,,Брахман
Dialogue: 0,0:08:29.43,0:08:32.43,Default,,0,0,0,,Енді түрлендіру, Беттерман.
Dialogue: 0,0:08:32.93,0:08:37.36,Default,,0,0,0,,Трансформациядан кейін сізді күтетін ұйқы - сіздің ең әлсіздігіңіз.
Dialogue: 0,0:08:37.96,0:08:39.96,Default,,0,0,0,,Енді менің досым Беттерман қайтыс болды
Dialogue: 0,0:08:40.10,0:08:43.50,Default,,0,0,0,,Өзіңмен күресуден басқа амалың жоқ.
Dialogue: 0,0:08:44.20,0:08:49.23,Default,,0,0,0,,Түсіңізде бақытты өлуге болады. Сіз бақытты боласыз, солай ма?
Dialogue: 0,0:08:49.93,0:08:54.30,Default,,0,0,0,,Әлде қазір оны жыртып, саған берем бе?
Dialogue: 0,0:09:01.33,0:09:02.26,Default,,0,0,0,,Ух
Dialogue: 0,0:09:03.63,0:09:04.80,Default,,0,0,0,,Ламия
Dialogue: 0,0:09:05.90,0:09:06.53,Default,,0,0,0,,Ууу!!
Dialogue: 0,0:09:07.53,0:09:09.40,Default,,0,0,0,,Бірақ қазірдің өзінде
Dialogue: 0,0:09:10.43,0:09:11.60,Default,,0,0,0,,Мен
Dialogue: 0,0:09:15.76,0:09:16.56,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:09:16.86,0:09:17.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:18.50,0:09:20.23,Default,,0,0,0,,Сен ақымақсың, Хиноки.
Dialogue: 0,0:09:29.20,0:09:31.70,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:09:34.26,0:09:34.76,Default,,0,0,0,,Уф
Dialogue: 0,0:09:36.20,0:09:37.46,Default,,0,0,0,,Гаригари Гарит
Dialogue: 0,0:09:40.00,0:09:40.60,Default,,0,0,0,,Уф
Dialogue: 0,0:09:41.13,0:09:42.03,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,0:09:45.13,0:09:47.50,Default,,0,0,0,,Уау
Dialogue: 0,0:09:47.83,0:09:52.93,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:09:58.03,0:10:00.03,Default,,0,0,0,,Кей-чан қайда?
Dialogue: 0,0:10:02.13,0:10:03.30,Default,,0,0,0,,Ууу
Dialogue: 0,0:10:03.36,0:10:05.10,Default,,0,0,0,,Охохохохо!
Dialogue: 0,0:10:05.23,0:10:10.26,Default,,0,0,0,,Егер менде осыншама көп байланыстырушы гель болса, менің энергиям шексіз болар еді.
Dialogue: 0,0:10:10.70,0:10:14.66,Default,,0,0,0,,Қарсыластың мүмкіндігіне қарай ең жақсы стратегия
Dialogue: 0,0:10:15.70,0:10:19.53,Default,,0,0,0,,Маған Беттерман тұмандығын көрсетуге рұқсат етіңіз.
Dialogue: 0,0:10:21.16,0:10:22.33,Default,,0,0,0,,пектофораза
Dialogue: 0,0:10:22.96,0:10:23.73,Default,,0,0,0,,Виллид
Dialogue: 0,0:10:27.03,0:10:31.90,Default,,0,0,0,,Вирид – негізінен электрлік сигналдарды басқаратын Т-клетка.
Dialogue: 0,0:10:32.66,0:10:36.66,Default,,0,0,0,,Сіз менің нейротрансмиттер жүйемді басқаруға тырысасыз ба?
Dialogue: 0,0:10:40.33,0:10:41.06,Default,,0,0,0,,Уф
Dialogue: 0,0:10:43.03,0:10:44.43,Default,,0,0,0,,Ууаах
Dialogue: 0,0:10:44.80,0:10:48.13,Default,,0,0,0,,Вахахахаха тәтті тәтті
Dialogue: 0,0:10:48.96,0:10:49.80,Default,,0,0,0,,Қайтыс болу
Dialogue: 0,0:11:10.20,0:11:12.66,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:11:28.53,0:11:30.36,Default,,0,0,0,,Вахахахахахаха
Dialogue: 0,0:11:31.56,0:11:32.80,Default,,0,0,0,,Мен оны жалған қауіпсіздік сезіміне бөлеп, бір соққымен өлтіремін!
Dialogue: 0,0:11:33.60,0:11:34.63,Default,,0,0,0,,Беттерман
Dialogue: 0,0:11:36.73,0:11:40.60,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:11:40.70,0:11:45.63,Default,,0,0,0,,Психо-дыбыстық ультрадыбыстық толқындар және т.б., ағынның әсерінен мүлдем қуатсыз.
Dialogue: 0,0:11:45.83,0:11:47.10,Default,,0,0,0,,Гуу
Dialogue: 0,0:11:49.50,0:11:52.13,Default,,0,0,0,,Сіз сілтеме гелін критикалық деңгейге келтірдіңіз бе?
Dialogue: 0,0:12:00.20,0:12:03.26,Default,,0,0,0,,Уиллид қалқаны басқару үшін
Dialogue: 0,0:12:03.93,0:12:04.96,Default,,0,0,0,,Ууук
Dialogue: 0,0:12:05.16,0:12:07.56,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:12:07.83,0:12:11.70,Default,,0,0,0,,Энергияны түрлендіру мүмкін емес.
Dialogue: 0,0:12:11.80,0:12:14.13,Default,,0,0,0,,Гуу...
Dialogue: 0,0:12:15.43,0:12:17.23,Default,,0,0,0,,Ууу
Dialogue: 0,0:12:18.86,0:12:21.86,Default,,0,0,0,,Ноаа
Dialogue: 0,0:12:21.96,0:12:23.33,Default,,0,0,0,,Уау
Dialogue: 0,0:12:24.80,0:12:30.73,Default,,0,0,0,,Яаа
Dialogue: 0,0:12:30.76,0:12:32.10,Default,,0,0,0,,Уф
Dialogue: 0,0:12:39.76,0:12:41.80,Default,,0,0,0,,Ааа
Dialogue: 0,0:12:41.86,0:12:42.90,Default,,0,0,0,,Хахахехе
Dialogue: 0,0:12:42.93,0:12:47.13,Default,,0,0,0,,үшін Акашикалық жазбалар ағынымен жүреді.
Dialogue: 0,0:12:48.03,0:12:51.53,Default,,0,0,0,,Хехе, ең жақсы адам келе жатыр.
Dialogue: 0,0:12:51.83,0:12:54.93,Default,,0,0,0,,Ооо ияаа
Dialogue: 0,0:13:03.00,0:13:03.70,Default,,0,0,0,,Не?
Dialogue: 0,0:13:14.76,0:13:15.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:15.80,0:13:18.26,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:13:22.03,0:13:24.70,Default,,0,0,0,,Біз өлімнен асып түсуге тырыстық
Dialogue: 0,0:13:25.46,0:13:28.76,Default,,0,0,0,,Бірақ өлім эволюция үшін қажеттілік болып табылады
Dialogue: 0,0:13:29.53,0:13:32.03,Default,,0,0,0,,Бұл өмір сүрудің құралы болды
Dialogue: 0,0:13:32.70,0:13:35.40,Default,,0,0,0,,Бұл басынан белгілі болды
Dialogue: 0,0:13:36.23,0:13:38.16,Default,,0,0,0,,Алджернонның да өлімі
Dialogue: 0,0:13:38.83,0:13:41.76,Default,,0,0,0,,Бұл аман қалу бағдарламасы болды.
Dialogue: 0,0:13:42.03,0:13:44.56,Default,,0,0,0,,Адамның тіршілігі үшін апоптоз?
Dialogue: 0,0:13:45.03,0:13:49.96,Default,,0,0,0,,Барлық қателіктердің себебі 7 жыл бұрын жасаған тәжірибем.
Dialogue: 0,0:13:51.23,0:13:53.06,Default,,0,0,0,,Сүңгуірді тексеру
Dialogue: 0,0:14:04.26,0:14:05.26,Default,,0,0,0,,Перудің оңтүстік-шығысында
Dialogue: 0,0:14:05.86,0:14:10.10,Default,,0,0,0,,Анд тауларының ортасында, Бразилия мен Боливия шекарасынан шамамен 200 км жерде.
Dialogue: 0,0:14:10.73,0:14:12.33,Default,,0,0,0,,Бұл тәжірибе жасалды
Dialogue: 0,0:14:13.53,0:14:17.83,Default,,0,0,0,,Бұл эксперимент NEO арқылы адамзатты күшейтуге бағытталған
Dialogue: 0,0:14:20.36,0:14:22.13,Default,,0,0,0,,Мен дайынмын.
Dialogue: 0,0:14:22.73,0:14:25.50,Default,,0,0,0,,Кактус, сен нені айтып тұрсың?
Dialogue: 0,0:14:25.96,0:14:29.10,Default,,0,0,0,,Жоқ, сіз әбігерге түсіп жатқан жоқсыз.
Dialogue: 0,0:14:29.70,0:14:33.40,Default,,0,0,0,,Охохохохохо, мен үйрене алмай жүрген нәрсе.
Dialogue: 0,0:14:33.83,0:14:35.70,Default,,0,0,0,,Биіктігі 6000 метрден жоғары биік тауларда
Dialogue: 0,0:14:36.10,0:14:39.13,Default,,0,0,0,,Мида галлюцинация тудыратын тета тобы пайда болады.
Dialogue: 0,0:14:39.70,0:14:41.00,Default,,0,0,0,,Мүмкін бұл құбылыс
Dialogue: 0,0:14:41.53,0:14:45.23,Default,,0,0,0,,Бұл контурды тану жүйесінің жансыздану жағдайында болуы мүмкін.
Dialogue: 0,0:14:45.86,0:14:48.53,Default,,0,0,0,,Бейыл аңызындағы жасырын ауыл
Dialogue: 0,0:14:48.70,0:14:52.23,Default,,0,0,0,,Мидың танымдық қабілетін тоздыратын жер дейді.
Dialogue: 0,0:14:52.36,0:14:55.73,Default,,0,0,0,,Эй, Мамон-сенсэй, мен сен туралы айтып отырмын.
Dialogue: 0,0:14:56.03,0:14:58.46,Default,,0,0,0,,Егер біз бұл құбылысты довлингке қолдана алсақ ше?
Dialogue: 0,0:14:58.90,0:15:01.50,Default,,0,0,0,,Сіз байлық жасай аламын деп ойлайсыз.
Dialogue: 0,0:15:02.63,0:15:04.36,Default,,0,0,0,,Бірақ бұл жұмбақ сұйықтық.
Dialogue: 0,0:15:04.66,0:15:05.66,Default,,0,0,0,,Байланыстырушы гель
Dialogue: 0,0:15:06.96,0:15:11.20,Default,,0,0,0,,Тірі ағзаларды негізгі реттілігіне қарай үш түрге бөлуге болады.
Dialogue: 0,0:15:12.06,0:15:14.23,Default,,0,0,0,,Эукариоттар жануарлар деп аталады
Dialogue: 0,0:15:15.00,0:15:17.26,Default,,0,0,0,,Бактериялар деп аталатын эубактериялар
Dialogue: 0,0:15:17.86,0:15:22.23,Default,,0,0,0,,Ал байланыстырушы гельдер сияқты ерекше ортада өмір сүретін архейлер.
Dialogue: 0,0:15:23.30,0:15:25.26,Default,,0,0,0,,Митохондриялар сияқты
Dialogue: 0,0:15:25.40,0:15:29.00,Default,,0,0,0,,Қос түрге жауап ретінде энергияны өндіру нені білдіреді?
Dialogue: 0,0:15:29.80,0:15:35.03,Default,,0,0,0,,VRE сияқты төзімді бактериялар қазір бүкіл әлемде кең таралған.
Dialogue: 0,0:15:36.03,0:15:38.03,Default,,0,0,0,,Адам геномын талдау жобасымен бірдей
Dialogue: 0,0:15:38.40,0:15:43.06,Default,,0,0,0,,Супербионың алдыңғы қатарында тұрған «Ең жақсы адам» жобасы да шұғыл қажет.
Dialogue: 0,0:15:44.93,0:15:47.76,Default,,0,0,0,,Барлық жасушалардың функционалдық ыдырау гендерінен
Dialogue: 0,0:15:48.10,0:15:52.36,Default,,0,0,0,,Жыныс жасушаларының мәңгілік бөліну қабілетін шақыру
Dialogue: 0,0:15:53.66,0:15:56.06,Default,,0,0,0,,Линкер гелінің энергиясымен
Dialogue: 0,0:15:56.43,0:16:00.23,Default,,0,0,0,,Биологиялық сызбаны бірден қайта салуға болады.
Dialogue: 0,0:16:01.30,0:16:02.66,Default,,0,0,0,,Беттермен сияқты
Dialogue: 0,0:16:03.33,0:16:07.06,Default,,0,0,0,,Өлмейтін болу керемет, өте жақсы.
Dialogue: 0,0:16:07.26,0:16:12.40,Default,,0,0,0,,Мен қазірдің өзінде күшейтілген ағзалардың ондаған түрлерін өсіріп жатырмын.
Dialogue: 0,0:16:13.03,0:16:18.46,Default,,0,0,0,,Адамзатқа қауіпсіз генетикалық түрлендірілген тағамдар қажет.
Dialogue: 0,0:16:19.46,0:16:20.13,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:16:20.90,0:16:23.40,Default,,0,0,0,,NEO – экономикаға басымдық беретін ұйым.
Dialogue: 0,0:16:24.10,0:16:27.80,Default,,0,0,0,,«Үздік адам» жобасы да үлкен пайдаға қол жеткізуді көздейді.
Dialogue: 0,0:16:27.96,0:16:31.03,Default,,0,0,0,,Жаңа препараттар - бұл жаңа емдеу әдістерін жасау құралы ғана
Dialogue: 0,0:16:31.80,0:16:35.86,Default,,0,0,0,,Мені адамзаттың ең ұлы эволюциясы қызықтырады.
Dialogue: 0,0:16:36.06,0:16:37.26,Default,,0,0,0,,Мен осындамын.
Dialogue: 0,0:16:38.40,0:16:39.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:39.66,0:16:40.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:41.00,0:16:45.16,Default,,0,0,0,,Адам ағзасында мәңгілік бөлінетін тағы бір жасуша бар.
Dialogue: 0,0:16:46.13,0:16:48.36,Default,,0,0,0,,Бұл рак клеткасы
Dialogue: 0,0:16:49.53,0:16:52.06,Default,,0,0,0,,Еске түсіргіңіз келмейтін генетикалық ақпарат.
Dialogue: 0,0:16:52.86,0:16:55.83,Default,,0,0,0,,Менің ойымша, ол мұндай әрекетке бармайды.
Dialogue: 0,0:16:56.46,0:16:57.76,Default,,0,0,0,,Тәкаппар болма
Dialogue: 0,0:16:58.56,0:17:01.20,Default,,0,0,0,,Адамзат тарихы – сәтсіздіктер тізбегі
Dialogue: 0,0:17:02.03,0:17:05.00,Default,,0,0,0,,Бұл тәжірибе адамның иммунитетін арттырды.
Dialogue: 0,0:17:05.30,0:17:09.46,Default,,0,0,0,,Ең болмағанда заттардың эволюциясына әкелу үшін бар күшімізді салайық.
Dialogue: 0,0:17:10.26,0:17:12.36,Default,,0,0,0,,Ең жақсы адамға эволюция
Dialogue: 0,0:17:13.86,0:17:15.23,Default,,0,0,0,,Бұл жерде ме?
Dialogue: 0,0:17:17.53,0:17:21.53,Default,,0,0,0,,Кәрі Пачираның оқиғалар туралы болжамды теріске шығару қабілеті
Dialogue: 0,0:17:24.50,0:17:25.46,Default,,0,0,0,,Құрметті
Dialogue: 0,0:17:27.86,0:17:28.86,Default,,0,0,0,,Якусуги
Dialogue: 0,0:17:33.50,0:17:35.86,Default,,0,0,0,,Жаман ойдың көзі
Dialogue: 0,0:17:37.06,0:17:40.80,Default,,0,0,0,,Кінәлінің көзін тоқтатыңыз.
Dialogue: 0,0:18:11.53,0:18:16.46,Default,,0,0,0,,Уау...
Dialogue: 0,0:18:40.16,0:18:41.60,Default,,0,0,0,,Менің ұяшықтарым
Dialogue: 0,0:18:42.80,0:18:47.46,Default,,0,0,0,,Енді маған өлімді күту ғана қалды.
Dialogue: 0,0:18:52.00,0:18:52.70,Default,,0,0,0,,Ламия
Dialogue: 0,0:18:53.96,0:18:55.36,Default,,0,0,0,,Бұл сіздікі
Dialogue: 0,0:18:56.06,0:18:59.23,Default,,0,0,0,,Үмітімізден туған анимус гүлі
Dialogue: 0,0:19:00.50,0:19:01.43,Default,,0,0,0,,Wiwele жемісі
Dialogue: 0,0:19:08.10,0:19:08.80,Default,,0,0,0,,Гарит
Dialogue: 0,0:19:13.83,0:19:16.90,Default,,0,0,0,,Сол сияқты Менің ұяшықтарым қайта жанданды
Dialogue: 0,0:19:17.83,0:19:19.66,Default,,0,0,0,,Ламия Жемісі
Dialogue: 0,0:19:20.36,0:19:21.10,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:19:21.73,0:19:24.53,Default,,0,0,0,,Аджанта үңгірлері, Үндістан Марио Аяя
Dialogue: 0,0:19:25.10,0:19:26.16,Default,,0,0,0,,Wiwer болуға үміттенемін
Dialogue: 0,0:19:27.30,0:19:31.93,Default,,0,0,0,,Бұл жерде үміт, қайнар көзі және күш бар.
Dialogue: 0,0:19:32.90,0:19:34.83,Default,,0,0,0,,Ламия Біртүрлі екен.
Dialogue: 0,0:19:35.40,0:19:37.06,Default,,0,0,0,,Сіз адам сияқтысыз
Dialogue: 0,0:19:38.40,0:19:42.63,Default,,0,0,0,,Уивеле атанған адамның есімі менде сақталады.
Dialogue: 0,0:19:54.63,0:19:55.93,Default,,0,0,0,,Сіз Күнкелді көрдіңіз бе?
Dialogue: 0,0:19:56.80,0:19:57.33,Default,,0,0,0,,О
Dialogue: 0,0:19:58.20,0:19:59.56,Default,,0,0,0,,Жою керек
Dialogue: 0,0:20:00.40,0:20:04.33,Default,,0,0,0,,Қанкел жойылса да, Wiwere болмайды, Сомнияның болашағы да болмайды.
Dialogue: 0,0:20:05.43,0:20:08.16,Default,,0,0,0,,Біз артта қалған соңғы үмітті қорғауымыз керек.
Dialogue: 0,0:20:28.43,0:20:29.43,Default,,0,0,0,,Гаоо
Dialogue: 0,0:20:29.50,0:20:30.23,Default,,0,0,0,,Ах
Dialogue: 0,0:20:48.16,0:20:48.66,Default,,0,0,0,,Ах
Dialogue: 0,0:20:53.10,0:20:56.46,Default,,0,0,0,,Охохохохохо бұл ұят
Dialogue: 0,0:20:57.93,0:21:02.96,Default,,0,0,0,,Таймердің орнына Уиллидті орнату қиынға соққанмен.
Dialogue: 0,0:21:04.33,0:21:08.10,Default,,0,0,0,,Линкер гелі - Канкелдің жалғыз әлсіз тұсы
Dialogue: 0,0:21:09.83,0:21:12.10,Default,,0,0,0,,Сіз оны көзбен көрген сияқтысыз.
Dialogue: 0,0:21:13.30,0:21:15.30,Default,,0,0,0,,Жеңіске жету үшін бұл жеткіліксіз
Dialogue: 0,0:21:16.80,0:21:18.60,Default,,0,0,0,,Ең жақсы адамға
Dialogue: 0,0:21:19.13,0:21:20.66,Default,,0,0,0,,Ухахахаха
Dialogue: 0,0:21:27.56,0:21:28.06,Default,,0,0,0,,Уф
Dialogue: 0,0:21:32.30,0:21:34.50,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:21:35.16,0:21:36.10,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,0:21:39.80,0:21:40.66,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:21:45.66,0:21:48.50,Default,,0,0,0,,Мен №1 Оянған адамды қозғалта алдым
Dialogue: 0,0:21:49.86,0:21:51.63,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:21:52.76,0:21:53.80,Default,,0,0,0,,К-чан
Dialogue: 0,0:21:55.23,0:21:56.30,Default,,0,0,0,,Хиноки
Dialogue: 0,0:21:56.90,0:22:00.33,Default,,0,0,0,,Сіздің тірі екеніңізге қуаныштымын.
Dialogue: 0,0:22:01.53,0:22:03.56,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:22:06.43,0:22:06.90,Default,,0,0,0,,Уф
Dialogue: 0,0:22:07.06,0:22:07.60,Default,,0,0,0,,Га
Dialogue: 0,0:22:07.66,0:22:08.10,Default,,0,0,0,,Ах
Dialogue: 0,0:22:11.70,0:22:14.93,Default,,0,0,0,,Жас өмір
Dialogue: 0,0:22:16.43,0:22:20.56,Default,,0,0,0,,Кінәлінің көзін тоқтатыңыз.
Dialogue: 0,0:22:22.06,0:22:23.46,Default,,0,0,0,,Бұл I
Dialogue: 0,0:22:25.53,0:22:29.23,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:22:34.60,0:22:47.20,Default,,0,0,0,,Шексіз теломераларға ойылған Құдайдың күнәсі
Dialogue: 0,0:22:47.86,0:22:54.00,Default,,0,0,0,,Жалынды құшақтап алу
Dialogue: 0,0:22:54.33,0:23:01.60,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:01.86,0:23:05.13,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.40,0:23:08.66,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.76,0:23:12.03,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.33,0:23:15.53,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.43,0:23:27.23,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:27.63,0:23:37.50,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:37.90,0:23:48.66,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:59.26,0:24:02.73,Default,,0,0,0,,Сайонара Юменокакера
Dialogue: 0,0:24:03.63,0:24:06.83,Default,,0,0,0,,үшін ештеңеге оралмайды
Dialogue: 0,0:24:07.20,0:24:10.00,Default,,0,0,0,,Адамдарға арналған мерейтой
Dialogue: 0,0:24:11.26,0:24:14.63,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:24:15.56,0:24:19.93,Default,,0,0,0,,Келеді, келе жатыр, өмір бітетін күн
Dialogue: 0,0:24:20.90,0:24:23.03,Default,,0,0,0,,Сіздің қасыңызда
Dialogue: 0,0:24:23.83,0:24:25.03,Default,,0,0,0,,Беттерман
