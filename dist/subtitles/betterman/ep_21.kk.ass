Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.96,0:00:13.83,Default,,0,0,0,,Брахма
Dialogue: 0,0:00:14.86,0:00:20.90,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:00:23.76,0:00:28.00,Default,,0,0,0,,Охохохо, орындалды.
Dialogue: 0,0:00:28.13,0:00:32.66,Default,,0,0,0,,Ең күшті адам тұқымы Брахманға эволюция
Dialogue: 0,0:00:32.90,0:00:36.43,Default,,0,0,0,,Ахх
Dialogue: 0,0:00:42.10,0:00:44.13,Default,,0,0,0,,Ратнасамбхава
Dialogue: 0,0:00:50.03,0:00:52.16,Default,,0,0,0,,Амитабх
Dialogue: 0,0:00:55.60,0:00:56.23,Default,,0,0,0,,Уау
Dialogue: 0,0:01:03.16,0:01:03.70,Default,,0,0,0,,Иә
Dialogue: 0,0:01:04.16,0:01:06.63,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:01:09.70,0:01:11.53,Default,,0,0,0,,Жаман ойлар
Dialogue: 0,0:01:12.00,0:01:14.46,Default,,0,0,0,,Оны қазір жойыңыз
Dialogue: 0,0:01:19.16,0:01:20.76,Default,,0,0,0,,Чичичи
Dialogue: 0,0:01:21.03,0:01:24.66,Default,,0,0,0,,Бірінен соң бірі не болып жатыр?
Dialogue: 0,0:01:24.93,0:01:26.33,Default,,0,0,0,,Барлығы тірі ме?
Dialogue: 0,0:01:26.96,0:01:29.23,Default,,0,0,0,,Оянған адам, мұнда неге келдің?
Dialogue: 0,0:01:29.66,0:01:31.50,Default,,0,0,0,,Мен оны іздедім.
Dialogue: 0,0:01:31.66,0:01:34.50,Default,,0,0,0,,Акамацу Когио да сұмдық күйде.
Dialogue: 0,0:01:34.86,0:01:36.33,Default,,0,0,0,,Тез жүріңіз
Dialogue: 0,0:01:39.46,0:01:43.33,Default,,0,0,0,,Ахх
Dialogue: 0,0:01:46.76,0:01:47.26,Default,,0,0,0,,Гаргари
Dialogue: 0,0:01:47.40,0:01:51.06,Default,,0,0,0,,Ахх
Dialogue: 0,0:01:55.50,0:01:59.63,Default,,0,0,0,,Адамдар жасаған заттарды жою
Dialogue: 0,0:02:15.56,0:02:16.13,Default,,0,0,0,,Иә
Dialogue: 0,0:02:21.96,0:02:23.96,Default,,0,0,0,,Бұл бәрінен кейін көрінді.
Dialogue: 0,0:02:28.60,0:02:29.73,Default,,0,0,0,,Канкел
Dialogue: 0,0:02:31.20,0:02:34.23,Default,,0,0,0,,Сізде бірге өмір сүретін өмір жоқ.
Dialogue: 0,0:02:37.53,0:02:39.73,Default,,0,0,0,,Бір ғана жеке тұлғаның болуы
Dialogue: 0,0:02:40.10,0:02:41.80,Default,,0,0,0,,Сондықтан Канкел
Dialogue: 0,0:02:42.43,0:02:44.56,Default,,0,0,0,,Мына пачираны құртамыз ба?
Dialogue: 0,0:02:50.16,0:02:52.83,Default,,0,0,0,,Менің Пондусымның күшімен
Dialogue: 0,0:02:53.06,0:02:57.43,Default,,0,0,0,,Канкел өзінің гравитациялық тепе-теңдігін сақтауы керек.
Dialogue: 0,0:02:58.30,0:03:00.80,Default,,0,0,0,,Сен субстанция болғандықтан
Dialogue: 0,0:03:06.76,0:03:10.73,Default,,0,0,0,,Кінәлі болып табылатын қалған билікті іздеу ғана қалды.
Dialogue: 0,0:03:11.66,0:03:12.23,Default,,0,0,0,,Енді бұл – қабілетке қарсы қабілет, техникаға қарсы техника, рухқа қарсы рух!
Dialogue: 0,0:03:12.60,0:03:16.30,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:03:17.40,0:03:18.80,Default,,0,0,0,,Юкине, сонда ісіңді бітірген соң дүкенге қара.
Dialogue: 0,0:03:19.06,0:03:21.60,Default,,0,0,0,,Осы пачираның жасушаларында
Dialogue: 0,0:03:23.90,0:03:24.93,Default,,0,0,0,,Ламия
Dialogue: 0,0:03:33.50,0:03:33.93,Default,,0,0,0,,Иә
Dialogue: 0,0:03:34.33,0:03:34.80,Default,,0,0,0,,Иә
Dialogue: 0,0:03:35.70,0:03:37.80,Default,,0,0,0,,Бұл зұлым рух қайдан шыққан?
Dialogue: 0,0:03:42.96,0:03:47.66,Default,,0,0,0,,Біздің Сомниумның бастығы Пачира ақсақал жойылды.
Dialogue: 0,0:03:50.70,0:04:00.10,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:04:02.60,0:04:10.83,Default,,0,0,0,,Жүзетін күміс қайық
Dialogue: 0,0:04:12.56,0:04:20.96,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:04:24.30,0:04:32.46,Default,,0,0,0,,Қай жерде теңселіп жүрсің?
Dialogue: 0,0:04:35.56,0:04:44.23,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:04:44.80,0:04:52.93,Default,,0,0,0,,Жанға бағыт-бағдар беру
Dialogue: 0,0:04:54.73,0:05:04.20,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:05:04.56,0:05:16.83,Default,,0,0,0,,Ағынмен қозғалма...
Dialogue: 0,0:05:27.83,0:05:28.60,Default,,0,0,0,,Ламия
Dialogue: 0,0:05:29.90,0:05:34.80,Default,,0,0,0,,Lume Fruit болмаса, мен бұл пішінге орала алмаймын.
Dialogue: 0,0:05:35.83,0:05:38.03,Default,,0,0,0,,Бірақ мен сенімен бірге барғым келеді
Dialogue: 0,0:05:39.46,0:05:40.53,Default,,0,0,0,,Мені ал
Dialogue: 0,0:05:41.63,0:05:43.50,Default,,0,0,0,,Менің өмірім сенікі
Dialogue: 0,0:05:45.06,0:05:45.86,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:46.73,0:05:48.76,Default,,0,0,0,,Бірге барайық Сәми
Dialogue: 0,0:05:49.60,0:05:50.36,Default,,0,0,0,,Ламия
Dialogue: 0,0:05:52.50,0:05:53.23,Default,,0,0,0,,Ламия
Dialogue: 0,0:05:55.86,0:05:56.60,Default,,0,0,0,,Ламия
Dialogue: 0,0:05:57.76,0:05:59.50,Default,,0,0,0,,Енді сол кәрі Пачира қайтыс болды
Dialogue: 0,0:06:00.13,0:06:02.60,Default,,0,0,0,,Енді, Ламия, сенің кезегің.
Dialogue: 0,0:06:03.96,0:06:05.90,Default,,0,0,0,,Соңына дейін I
Dialogue: 0,0:06:07.00,0:06:08.46,Default,,0,0,0,,Сіз үшін өмір сүру
Dialogue: 0,0:06:12.46,0:06:13.90,Default,,0,0,0,,Кеше түнгі сағат 22:00 шамасында.
Dialogue: 0,0:06:14.06,0:06:17.60,Default,,0,0,0,,Ниши-Синджуку, Токиодағы Choujin Alliance Co., Ltd. бас кеңсесінің ғимаратында.
Dialogue: 0,0:06:17.83,0:06:19.36,Default,,0,0,0,,Жарылыс болды
Dialogue: 0,0:06:20.13,0:06:24.20,Default,,0,0,0,,Себеп қазір зерттелуде, бірақ зардап шеккендер жоқ.
Dialogue: 0,0:06:24.73,0:06:27.23,Default,,0,0,0,,Цк, зардап шеккендер жоқ.
Dialogue: 0,0:06:30.16,0:06:35.46,Default,,0,0,0,,Біртүрлі жер асты бассейніндегі 200-ден астам маринадталған Будда
Dialogue: 0,0:06:36.06,0:06:39.50,Default,,0,0,0,,Инспектор: Полиция күштері Akamatsu Industries-ке кірді.
Dialogue: 0,0:06:40.10,0:06:41.96,Default,,0,0,0,,Әр адамның жады бос сияқты.
Dialogue: 0,0:06:42.73,0:06:45.23,Default,,0,0,0,,Ештеңе есіңізде болмаса
Dialogue: 0,0:06:45.56,0:06:46.66,Default,,0,0,0,,О, жеткілікті
Dialogue: 0,0:06:47.43,0:06:49.66,Default,,0,0,0,,Мұндағы «Төменгі әлем» оқиғасы
Dialogue: 0,0:06:50.33,0:06:52.63,Default,,0,0,0,,Мәңгі түнде жүргендей
Dialogue: 0,0:06:53.43,0:06:55.00,Default,,0,0,0,,Қалғанын соларға қалдыр.
Dialogue: 0,0:06:55.50,0:06:56.23,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:07:05.60,0:07:06.56,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:07.06,0:07:09.13,Default,,0,0,0,,сіз оларды әдейі жеке-жеке сынақтарға қарсы қойып отырсыз ғой?
Dialogue: 0,0:07:09.73,0:07:11.80,Default,,0,0,0,,Олай болса осында күтеміз
Dialogue: 0,0:07:12.20,0:07:16.50,Default,,0,0,0,,Қарғыс атсын, тіпті жоғарғы қабаттың өзі қуыс қабық.
Dialogue: 0,0:07:16.96,0:07:19.73,Default,,0,0,0,,Олардың бәрі қайда кетті?
Dialogue: 0,0:07:19.93,0:07:22.53,Default,,0,0,0,,Мен қазір Mordywarp штаб-пәтеріне хабарластым.
Dialogue: 0,0:07:23.10,0:07:27.90,Default,,0,0,0,,Нейроноидты және қос тайпалы арнайы жасақтардың жаңа түрі іске қосылғаны айтылады.
Dialogue: 0,0:07:28.60,0:07:31.23,Default,,0,0,0,,Сіз ақырында қозғала бастадыңыз ба?
Dialogue: 0,0:07:31.46,0:07:34.43,Default,,0,0,0,,Уа, Президент, мен жерасты өткелін көрдім.
Dialogue: 0,0:07:35.06,0:07:37.63,Default,,0,0,0,,Ол жерден суперадамдар альянсы қашып кеткен сияқты.
Dialogue: 0,0:07:37.96,0:07:39.10,Default,,0,0,0,,Нануууу
Dialogue: 0,0:07:41.46,0:07:42.70,Default,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 0,0:07:44.50,0:07:50.06,Default,,0,0,0,,Е, қазір жабық тұрған 15-ші метро желісінің құрылыс жолына қосылған сияқты.
Dialogue: 0,0:07:50.20,0:07:51.23,Default,,0,0,0,,- Иә - түсіндім.
Dialogue: 0,0:07:51.43,0:07:53.06,Default,,0,0,0,,Оның артынан тез қуып алайық.
Dialogue: 0,0:07:53.33,0:07:54.66,Default,,0,0,0,,Маған айтудың қажеті жоқ
Dialogue: 0,0:07:55.13,0:07:55.96,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:07:56.46,0:07:58.40,Default,,0,0,0,,Бізге жалғыз жүру қауіпті.
Dialogue: 0,0:07:59.03,0:07:59.46,Default,,0,0,0,,Ах
Dialogue: 0,0:08:00.20,0:08:00.93,Default,,0,0,0,,Янаги-кун
Dialogue: 0,0:08:01.66,0:08:03.63,Default,,0,0,0,,Өтінемін, мені жіберіңізші, Асами-сан.
Dialogue: 0,0:08:04.63,0:08:08.60,Default,,0,0,0,,Каэде екеуміз гүл мен жәндік сияқты симбиотикалық қарым-қатынастамыз.
Dialogue: 0,0:08:09.53,0:08:11.13,Default,,0,0,0,,Екеуінсіз өмір сүре алмайсың.
Dialogue: 0,0:08:12.23,0:08:13.16,Default,,0,0,0,,Өкінгім келмейді.
Dialogue: 0,0:08:14.26,0:08:14.93,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:22.63,0:08:23.60,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:08:24.70,0:08:29.40,Default,,0,0,0,,Осы уақытқа дейін бізді сахнаның ар жағында құтқарып келген Әмірші еді.
Dialogue: 0,0:08:29.86,0:08:32.70,Default,,0,0,0,,Бұл Беттерманның достарының бірі ме?
Dialogue: 0,0:08:32.96,0:08:38.00,Default,,0,0,0,,Жоқ, мен сол қоңырауды көргенде біртүрлі екен деп ойладым.
Dialogue: 0,0:08:39.13,0:08:40.23,Default,,0,0,0,,Құрметті Якусуги
Dialogue: 0,0:08:40.86,0:08:43.66,Default,,0,0,0,,Эзотерикалық буддизмнің құпия техникасын меңгерді.
Dialogue: 0,0:08:44.03,0:08:46.13,Default,,0,0,0,,Адамзаттағы ең күшті тіршілік иесі шығар
Dialogue: 0,0:08:47.50,0:08:49.43,Default,,0,0,0,,Құрметті Якусуги тірі еді
Dialogue: 0,0:08:50.66,0:08:53.93,Default,,0,0,0,,Мен сізді бірнеше жыл бұрын Перуде жоғалып кеткеніңізді естідім.
Dialogue: 0,0:08:54.93,0:08:58.53,Default,,0,0,0,,Брахман деп аталатын оғаш жаратылыс
Dialogue: 0,0:09:00.26,0:09:02.66,Default,,0,0,0,,Құрметті Якусугидің мұндай нәрседен жеңіліп қалуы мүмкін емес.
Dialogue: 0,0:09:02.73,0:09:03.60,Default,,0,0,0,,Мен Каэде жоқпын
Dialogue: 0,0:09:04.70,0:09:05.20,Default,,0,0,0,,Каэде
Dialogue: 0,0:09:05.26,0:09:06.13,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:09:06.16,0:09:06.70,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:09:07.96,0:09:12.13,Default,,0,0,0,,Тезірек Каэде-сан Тездет
Dialogue: 0,0:09:12.46,0:09:13.93,Default,,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:09:14.83,0:09:18.26,Default,,0,0,0,,Әйтпесе, қорқынышты нәрсе болады.
Dialogue: 0,0:09:22.03,0:09:23.63,Default,,0,0,0,,Кей-чан, ол туралы не айтасыз?
Dialogue: 0,0:09:24.30,0:09:26.06,Default,,0,0,0,,Аа, бәрі жақсы болып жатыр.
Dialogue: 0,0:09:27.93,0:09:32.26,Default,,0,0,0,,Мен соңғы төрт жыл бойы жалғыз болдым.
Dialogue: 0,0:09:32.96,0:09:33.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:34.06,0:09:37.70,Default,,0,0,0,,Янаги-сан мен Каэде-сан, біз әрқашан бірге бола аламыз
Dialogue: 0,0:09:38.26,0:09:39.23,Default,,0,0,0,,Мен қызғандым
Dialogue: 0,0:09:40.66,0:09:43.06,Default,,0,0,0,,Сондықтан Янаги-санның бұрынғы түрі
Dialogue: 0,0:09:43.63,0:09:45.83,Default,,0,0,0,,Жалғыз көрінгені сонша, мен оны көре алмадым.
Dialogue: 0,0:09:47.03,0:09:50.23,Default,,0,0,0,,Сіз үшін маңызды адамның өмірден өткені өте ауыр, солай емес пе?
Dialogue: 0,0:09:50.76,0:09:51.66,Default,,0,0,0,,Хиноки
Dialogue: 0,0:09:52.60,0:09:56.70,Default,,0,0,0,,Кей-чан, Каэде-санды міндетті түрде қайтарайық.
Dialogue: 0,0:09:57.26,0:09:59.30,Default,,0,0,0,,Аа, түсіндім.
Dialogue: 0,0:10:00.66,0:10:01.93,Default,,0,0,0,,Әрқашан Хинокиде
Dialogue: 0,0:10:02.40,0:10:04.70,Default,,0,0,0,,-Мен сенің жаныңда боламын, ах -Хиноки Кейта
Dialogue: 0,0:10:05.03,0:10:07.33,Default,,0,0,0,,-Жақсы жер екен... -Сақора Каэденің орнын сезген сияқты.
Dialogue: 0,0:10:07.50,0:10:09.00,Default,,0,0,0,,Мен жерге көтерілемін
Dialogue: 0,0:10:09.06,0:10:09.53,Default,,0,0,0,,Иә
Dialogue: 0,0:10:25.40,0:10:26.33,Default,,0,0,0,,Тұрғын ауданы
Dialogue: 0,0:10:26.90,0:10:29.40,Default,,0,0,0,,Жоқ, мұнда ешкім жоқ.
Dialogue: 0,0:10:30.20,0:10:32.20,Default,,0,0,0,,Қаланың орталығына жақын болуы керек, солай ма?
Dialogue: 0,0:10:32.80,0:10:36.83,Default,,0,0,0,,Сіз бүкіл әлемде әртүрлі қоздырғыштарды жойып жатқан кезде.
Dialogue: 0,0:10:37.26,0:10:39.53,Default,,0,0,0,,Токиода да көп оқиға болды.
Dialogue: 0,0:10:40.00,0:10:40.86,Default,,0,0,0,,Ахаха
Dialogue: 0,0:10:41.60,0:10:44.83,Default,,0,0,0,,Су және кәріз жүйелеріндегі құтқару желілері ескіруде.
Dialogue: 0,0:10:45.36,0:10:47.73,Default,,0,0,0,,Жаңа қала жоспарының іске қосылуымен
Dialogue: 0,0:10:48.10,0:10:49.90,Default,,0,0,0,,Тұрғындар қала шетіне қоныс аударады
Dialogue: 0,0:10:50.90,0:10:52.76,Default,,0,0,0,,Қайта құру жоспары бар.
Dialogue: 0,0:10:53.03,0:10:56.66,Default,,0,0,0,,Қала орталығындағы ең жақсы жерде болу бюджетті жоспарлауды қиындатты.
Dialogue: 0,0:10:57.26,0:11:00.06,Default,,0,0,0,,Құрылысты бастау перспективасы әлі жоқ.
Dialogue: 0,0:11:01.03,0:11:02.30,Default,,0,0,0,,Бұл елес қала ма?
Dialogue: 0,0:11:03.13,0:11:07.26,Default,,0,0,0,,Жоғарыда айтылған жерасты өткелі де жаңа метро желісі ретінде салынды.
Dialogue: 0,0:11:07.63,0:11:11.60,Default,,0,0,0,,Желі картасын қайталап өзгертуге байланысты қатып қалады
Dialogue: 0,0:11:12.10,0:11:12.96,Default,,0,0,0,,Бізге уақыт тауып бердік қой, иә?
Dialogue: 0,0:11:13.60,0:11:17.16,Default,,0,0,0,,Бұл саясат, бұл шенеуніктердің ыңғайлылығы.
Dialogue: 0,0:11:17.76,0:11:21.93,Default,,0,0,0,,Сайлау нәтижелерінде үлкен өзгеріс болған сайын ақшаны пайдалану тәсілі өзгереді.
Dialogue: 0,0:11:23.13,0:11:24.30,Default,,0,0,0,,Заттардың құндылығы қандай?
Dialogue: 0,0:11:24.40,0:11:27.60,Default,,0,0,0,,Оны тек жоғарыдағы адамның таразысымен ғана өлшеуге болады.
Dialogue: 0,0:11:28.13,0:11:29.70,Default,,0,0,0,,Бұл салық ақшасын босқа жұмсау.
Dialogue: 0,0:11:30.43,0:11:31.30,Default,,0,0,0,,Көпшілігі
Dialogue: 0,0:11:31.66,0:11:34.26,Default,,0,0,0,,Ысырапшыл шығынды пайдалану арқылы
Dialogue: 0,0:11:34.36,0:11:36.20,Default,,0,0,0,,Сондай-ақ жоғары көтерілу жолы бар.
Dialogue: 0,0:11:36.60,0:11:39.30,Default,,0,0,0,,Неліктен Адамзаттан тыс одақ мұнда қашып кетті?
Dialogue: 0,0:11:40.16,0:11:41.76,Default,,0,0,0,,Мен үйсіздердің осында қалғанын қаламаймын.
Dialogue: 0,0:11:42.23,0:11:44.50,Default,,0,0,0,,Бұл енді шектеулі аймақ.
Dialogue: 0,0:11:45.26,0:11:48.40,Default,,0,0,0,,Олар мұны біледі және оны жасырынатын орын ретінде пайдалануды жоспарлап отырған шығар.
Dialogue: 0,0:11:50.23,0:11:52.03,Default,,0,0,0,,Сара-чан да әбден шаршады.
Dialogue: 0,0:11:52.83,0:11:56.33,Default,,0,0,0,,Бұл жер өз бетімізше іздеуге тым үлкен.
Dialogue: 0,0:11:56.80,0:11:59.56,Default,,0,0,0,,Нағыз тайпаны немесе бір нәрсені күтесіз бе?
Dialogue: 0,0:12:00.10,0:12:02.26,Default,,0,0,0,,Олар дайындалған мамандар
Dialogue: 0,0:12:03.16,0:12:07.10,Default,,0,0,0,,Менің ойымша, бірігіп, ұйымдасқан іс-әрекет тиімдірек болады.
Dialogue: 0,0:12:07.96,0:12:11.86,Default,,0,0,0,,Әзірге нейрондық күтімді аяқтаймыз.
Dialogue: 0,0:12:13.83,0:12:14.73,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:12:14.96,0:12:16.33,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:12:26.50,0:12:27.80,Default,,0,0,0,,Хиноки, қайда бара жатырсың?
Dialogue: 0,0:12:27.83,0:12:28.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:28.43,0:12:31.86,Default,,0,0,0,,Ей, біз әрқашан бірге боламыз, біз бөлек бола алмаймыз.
Dialogue: 0,0:12:33.66,0:12:36.70,Default,,0,0,0,,Бірақ олар маған ваннаға жалғыз баруға рұқсат берді.
Dialogue: 0,0:12:37.16,0:12:38.76,Default,,0,0,0,,Хе иә иә
Dialogue: 0,0:12:48.96,0:12:49.43,Default,,0,0,0,,Ах
Dialogue: 0,0:12:59.06,0:12:59.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:05.00,0:13:05.66,Default,,0,0,0,,Ах
Dialogue: 0,0:13:07.96,0:13:11.90,Default,,0,0,0,,Ааааааааааааааааааааааааааааа
Dialogue: 0,0:13:13.66,0:13:17.66,Default,,0,0,0,,Уф аа
Dialogue: 0,0:13:20.13,0:13:21.50,Default,,0,0,0,,Абдул, айтуды ұмытыппын—
Dialogue: 0,0:13:30.46,0:13:31.20,Default,,0,0,0,,Ах
Dialogue: 0,0:13:33.66,0:13:35.16,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:13:50.50,0:13:51.96,Default,,0,0,0,,Жинақтау
Dialogue: 0,0:13:52.53,0:13:53.53,Default,,0,0,0,,Жинақтау
Dialogue: 0,0:13:54.63,0:13:58.16,Default,,0,0,0,,Қираудың тағдырынан не құтыла алады?
Dialogue: 0,0:13:58.36,0:14:00.53,Default,,0,0,0,,Тек адамдардан тыс адамдар
Dialogue: 0,0:14:01.53,0:14:04.06,Default,,0,0,0,,Қираудың тағдырынан не құтыла алады?
Dialogue: 0,0:14:04.70,0:14:06.40,Default,,0,0,0,,Тек адамдардан тыс адамдар
Dialogue: 0,0:14:07.23,0:14:07.96,Default,,0,0,0,,Иә
Dialogue: 0,0:14:08.60,0:14:09.33,Default,,0,0,0,,Иә
Dialogue: 0,0:14:13.03,0:14:14.86,Default,,0,0,0,,Брахман
Dialogue: 0,0:14:15.96,0:14:16.50,Default,,0,0,0,,Каэде
Dialogue: 0,0:14:25.80,0:14:27.10,Default,,0,0,0,,Хаа Каэде
Dialogue: 0,0:14:29.56,0:14:30.06,Default,,0,0,0,,Ах
Dialogue: 0,0:14:30.46,0:14:31.20,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:14:32.73,0:14:33.53,Default,,0,0,0,,Беттерман
Dialogue: 0,0:14:34.90,0:14:35.53,Default,,0,0,0,,Ламия
Dialogue: 0,0:14:38.36,0:14:39.13,Default,,0,0,0,,Хиноки-чан
Dialogue: 0,0:14:40.70,0:14:41.33,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:14:44.50,0:14:45.13,Default,,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 0,0:15:04.86,0:15:06.50,Default,,0,0,0,,Шо Янаги
Dialogue: 0,0:15:10.00,0:15:16.43,Default,,0,0,0,,...
Dialogue: 0,0:15:17.36,0:15:19.13,Default,,0,0,0,,Уау
Dialogue: 0,0:15:19.16,0:15:22.23,Default,,0,0,0,,Гя гя
Dialogue: 0,0:15:22.33,0:15:25.06,Default,,0,0,0,,Жоғары тазалықтағы линкер гелі бар
Dialogue: 0,0:15:25.36,0:15:29.43,Default,,0,0,0,,Мен кемелдікке жақындадым.
Dialogue: 0,0:15:35.13,0:15:42.93,Default,,0,0,0,,...
Dialogue: 0,0:15:45.30,0:15:46.26,Default,,0,0,0,,Ах
Dialogue: 0,0:15:56.73,0:15:58.36,Default,,0,0,0,,Кінәлі болған билік
Dialogue: 0,0:16:04.46,0:16:05.10,Default,,0,0,0,,Ламия
Dialogue: 0,0:16:06.03,0:16:06.73,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:08.13,0:16:08.63,Default,,0,0,0,,Ах
Dialogue: 0,0:16:10.96,0:16:12.50,Default,,0,0,0,,Гя
Dialogue: 0,0:16:12.56,0:16:13.36,Default,,0,0,0,,Сакора-чан
Dialogue: 0,0:16:13.56,0:16:14.26,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:15.90,0:16:18.43,Default,,0,0,0,,Күштері таусылғандарға
Dialogue: 0,0:16:18.70,0:16:20.40,Default,,0,0,0,,Ауырсыну және қайғы
Dialogue: 0,0:16:21.03,0:16:22.36,Default,,0,0,0,,Жарылу
Dialogue: 0,0:16:22.66,0:16:23.83,Default,,0,0,0,,Олар сол таңертең ғана қабырғалардың ар жағына барлау миссиясына аттанған еді.
Dialogue: 0,0:16:24.76,0:16:25.46,Default,,0,0,0,,Ах
Dialogue: 0,0:16:29.20,0:16:30.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:30.73,0:16:31.66,Default,,0,0,0,,Брахман
Dialogue: 0,0:16:32.13,0:16:34.90,Default,,0,0,0,,Жоқ, кешегіден сәл басқаша.
Dialogue: 0,0:16:35.76,0:16:36.23,Default,,0,0,0,,Га
Dialogue: 0,0:16:42.86,0:16:45.00,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:16:49.96,0:16:50.60,Default,,0,0,0,,Каэде
Dialogue: 0,0:16:51.30,0:16:51.96,Default,,0,0,0,,Шо
Dialogue: 0,0:16:53.30,0:16:53.86,Default,,0,0,0,,Каэде
Dialogue: 0,0:16:55.13,0:16:58.73,Default,,0,0,0,,Мені күдіктеріңмен баурап ал
Dialogue: 0,0:17:00.03,0:17:01.30,Default,,0,0,0,,Мені алда
Dialogue: 0,0:17:02.46,0:17:04.00,Default,,0,0,0,,Мені еркін сезіну
Dialogue: 0,0:17:20.66,0:17:21.33,Default,,0,0,0,,Шо
Dialogue: 0,0:17:23.33,0:17:23.86,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:17:24.90,0:17:26.16,Default,,0,0,0,,Осы қабілетті пайдалану
Dialogue: 0,0:17:27.03,0:17:30.46,Default,,0,0,0,,Мен айналамдағы адамдар әрқашан таңданатын адам болғым келеді.
Dialogue: 0,0:17:30.96,0:17:32.26,Default,,0,0,0,,Автоұсыныс жасалды
Dialogue: 0,0:17:33.06,0:17:36.70,Default,,0,0,0,,Бірақ бұл Кейдеге опасыздық жасаған шығар.
Dialogue: 0,0:17:37.56,0:17:38.20,Default,,0,0,0,,Та-да!
Dialogue: 0,0:17:39.60,0:17:42.86,Default,,0,0,0,,Сенсіз өзімді қауіпсіз сезіне алмаймын
Dialogue: 0,0:17:43.86,0:17:46.50,Default,,0,0,0,,Шоның қабілетінсіз өмір сүре алмайды
Dialogue: 0,0:17:49.73,0:17:52.80,Default,,0,0,0,,Мен сенімен мәңгі бірге боламын
Dialogue: 0,0:17:58.23,0:17:58.70,Default,,0,0,0,,Ах
Dialogue: 0,0:18:00.30,0:18:02.63,Default,,0,0,0,,Бұл тек ұлулардан жасалған шашқа арналған әшекей.
Dialogue: 0,0:18:03.80,0:18:06.36,Default,,0,0,0,,Бұл ерекше ештеңе емес, сіз білесіз.
Dialogue: 0,0:18:07.10,0:18:09.06,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:18:09.90,0:18:13.13,Default,,0,0,0,,Мені жаңа ғана мұғалімім пайдаланып жүрген болатын.
Dialogue: 0,0:18:14.26,0:18:16.73,Default,,0,0,0,,Осы күнге таймер орнатылды.
Dialogue: 0,0:18:18.13,0:18:20.10,Default,,0,0,0,,Бірақ мен оны сезіндім.
Dialogue: 0,0:18:21.03,0:18:23.66,Default,,0,0,0,,Шо мен менің арамыздағы байланыс
Dialogue: 0,0:18:24.60,0:18:26.16,Default,,0,0,0,,Ахх
Dialogue: 0,0:18:33.00,0:18:34.06,Default,,0,0,0,,О, қарғыс атсын
Dialogue: 0,0:18:34.53,0:18:37.13,Default,,0,0,0,,Янаги мен Хиноки мырза қайда кетті?
Dialogue: 0,0:18:37.33,0:18:41.86,Default,,0,0,0,,Жарайды, жалғыз Хота нейроноидты жылжыту үшін ештеңе істей алмайды.
Dialogue: 0,0:18:41.96,0:18:44.40,Default,,0,0,0,,Сіз бәрібір жалғыз ештеңе істей алмайсыз.
Dialogue: 0,0:18:45.16,0:18:47.70,Default,,0,0,0,,BPL көмегімен жасалған D типті аңшы
Dialogue: 0,0:18:48.30,0:18:53.03,Default,,0,0,0,,Және бұл Брахман деп аталатын адамнан тыс одақ жасаған нәрсе.
Dialogue: 0,0:18:56.80,0:19:00.50,Default,,0,0,0,,Өйткені, бұл «Ең жақсы адам» жобасының жалғасы.
Dialogue: 0,0:19:04.80,0:19:08.30,Default,,0,0,0,,Кәрі адамдарды Алджернон жойды
Dialogue: 0,0:19:09.06,0:19:12.60,Default,,0,0,0,,Тек жаңа адам тұқымы Брахман аман қалады.
Dialogue: 0,0:19:17.53,0:19:20.10,Default,,0,0,0,,Жаман ойдың көзін үзу
Dialogue: 0,0:19:20.73,0:19:23.73,Default,,0,0,0,,Чакраның басшылығы арқылы маған ұсынылады.
Dialogue: 0,0:19:24.23,0:19:24.93,Default,,0,0,0,,Құрметті
Dialogue: 0,0:19:25.23,0:19:26.00,Default,,0,0,0,,Уау
Dialogue: 0,0:19:30.50,0:19:34.96,Default,,0,0,0,,Біздің альянстың қызметіне бірнеше рет кедергі келтірген нәрсе
Dialogue: 0,0:19:35.06,0:19:36.56,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:19:37.70,0:19:40.70,Default,,0,0,0,,Бір кездері адамзаттың жасырын мүмкіндіктері
Dialogue: 0,0:19:40.73,0:19:45.66,Default,,0,0,0,,Мәртебелі Якусуги, ол ең бейнеленген тіршілік иесі ретінде қарастырылды.
Dialogue: 0,0:19:46.43,0:19:48.46,Default,,0,0,0,,Менің есте сақтау қабілетім жойылды
Dialogue: 0,0:19:49.06,0:19:52.00,Default,,0,0,0,,Біз тек чакраның басшылығымен күресеміз.
Dialogue: 0,0:19:52.70,0:19:56.60,Default,,0,0,0,,Сүңгуірді тексеру тіпті есіңізде де жоқ.
Dialogue: 0,0:19:56.96,0:19:57.76,Default,,0,0,0,,Білмеймін
Dialogue: 0,0:19:58.03,0:19:59.16,Default,,0,0,0,,әзіл-оспақ
Dialogue: 0,0:20:00.53,0:20:01.00,Default,,0,0,0,,Әй
Dialogue: 0,0:20:04.23,0:20:06.23,Default,,0,0,0,,Уф, бұл не?
Dialogue: 0,0:20:06.36,0:20:06.96,Default,,0,0,0,,Барлығы
Dialogue: 0,0:20:07.20,0:20:07.66,Default,,0,0,0,,Уф
Dialogue: 0,0:20:08.23,0:20:09.10,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:20:09.70,0:20:10.33,Default,,0,0,0,,Ой
Dialogue: 0,0:20:10.60,0:20:11.70,Default,,0,0,0,,Каэде-сан
Dialogue: 0,0:20:12.00,0:20:13.00,Default,,0,0,0,,Сонда сіз қауіпсіз болдыңыз ба?
Dialogue: 0,0:20:13.53,0:20:17.03,Default,,0,0,0,,Кешіріңіз, Каэде-чан қайтып келді.
Dialogue: 0,0:20:19.53,0:20:20.53,Default,,0,0,0,,Мен ЖоЖомен шайқасуға оралдым!
Dialogue: 0,0:20:21.00,0:20:23.96,Default,,0,0,0,,Қазір ең мықтысы менмін.
Dialogue: 0,0:20:26.33,0:20:27.03,Default,,0,0,0,,Сіз төбелесесіз бе?
Dialogue: 0,0:20:27.53,0:20:30.70,Default,,0,0,0,,Жақсылық жоқ, Қанкел алда болса.
Dialogue: 0,0:20:31.50,0:20:32.13,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:20:32.50,0:20:36.33,Default,,0,0,0,,Тоқта, тіпті біздің ескі Пачира да жойылды.
Dialogue: 0,0:20:37.23,0:20:39.06,Default,,0,0,0,,Ламия уақытын күтіңіз
Dialogue: 0,0:20:40.40,0:20:41.26,Default,,0,0,0,,Ояну
Dialogue: 0,0:20:41.46,0:20:42.03,Default,,0,0,0,,Ояну
Dialogue: 0,0:20:45.16,0:20:46.63,Default,,0,0,0,,UHUB БАСҚАРУ
Dialogue: 0,0:20:47.26,0:20:49.16,Default,,0,0,0,,iHub басқаруы
Dialogue: 0,0:20:49.73,0:20:51.36,Default,,0,0,0,,UHUB БАСҚАРУ
Dialogue: 0,0:20:51.80,0:20:53.03,Default,,0,0,0,,iHub басқаруы
Dialogue: 0,0:21:10.96,0:21:14.13,Default,,0,0,0,,Сол президент Сара-чанға не істеуіміз керек?
Dialogue: 0,0:21:14.50,0:21:16.23,Default,,0,0,0,,Маниджи машинасына отырыңыз
Dialogue: 0,0:21:20.63,0:21:21.80,Default,,0,0,0,,А, мынау
Dialogue: 0,0:21:22.43,0:21:26.40,Default,,0,0,0,,15 жыл бұрын Психикалық зерттеу мекемесінің мұғалімі
Dialogue: 0,0:21:29.33,0:21:33.93,Default,,0,0,0,,Адамгершіліктен тыс альянстың соңғы басшысы Мамон оның өзгерген формасы болып табылады.
Dialogue: 0,0:21:34.30,0:21:35.26,Default,,0,0,0,,Брахман
Dialogue: 0,0:21:36.16,0:21:37.23,Default,,0,0,0,,Қайтыс болу
Dialogue: 0,0:21:38.30,0:21:39.30,Default,,0,0,0,,Қайтыс болу
Dialogue: 0,0:21:40.40,0:21:41.60,Default,,0,0,0,,Қайтыс болу
Dialogue: 0,0:21:41.90,0:21:42.96,Default,,0,0,0,,Тоқта
Dialogue: 0,0:21:44.93,0:21:46.53,Default,,0,0,0,,Бұзбаңыз
Dialogue: 0,0:21:47.70,0:21:48.76,Default,,0,0,0,,Қайтыс болу
Dialogue: 0,0:21:49.50,0:21:51.76,Default,,0,0,0,,Таңғажайып құйма энергиясы
Dialogue: 0,0:21:52.10,0:21:55.63,Default,,0,0,0,,Не? Мен қысыммен алға жылжи алмаймын.
Dialogue: 0,0:21:55.90,0:21:57.16,Default,,0,0,0,,Өлу
Dialogue: 0,0:21:58.00,0:21:59.43,Default,,0,0,0,,Өлу
Dialogue: 0,0:22:00.26,0:22:00.93,Default,,0,0,0,,Уф
Dialogue: 0,0:22:01.66,0:22:03.43,Default,,0,0,0,,Енді рақым жоқ
Dialogue: 0,0:22:04.20,0:22:06.93,Default,,0,0,0,,Менімен бірге өл
Dialogue: 0,0:22:08.20,0:22:10.36,Default,,0,0,0,,Амоггасидди
Dialogue: 0,0:22:12.93,0:22:14.56,Default,,0,0,0,,Құрметті
Dialogue: 0,0:22:15.73,0:22:17.96,Default,,0,0,0,,Кінәлінің көзін тоқтатыңыз.
Dialogue: 0,0:22:18.80,0:22:20.50,Default,,0,0,0,,Жас өмір
Dialogue: 0,0:22:25.10,0:22:26.20,Default,,0,0,0,,Уау
Dialogue: 0,0:22:26.90,0:22:28.00,Default,,0,0,0,,Уау
Dialogue: 0,0:22:34.50,0:22:47.30,Default,,0,0,0,,Шексіз теломераларға ойылған Құдайдың күнәсі
Dialogue: 0,0:22:47.80,0:22:53.96,Default,,0,0,0,,Жалынды құшақтап алу
Dialogue: 0,0:22:54.36,0:23:01.56,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:01.83,0:23:05.03,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.33,0:23:08.50,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.70,0:23:12.00,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.20,0:23:15.43,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.36,0:23:27.16,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:27.50,0:23:37.30,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:37.86,0:23:48.86,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:58.66,0:24:01.73,Default,,0,0,0,,Тіршілік деп аталатын аминқышқылдары
Dialogue: 0,0:24:02.36,0:24:05.30,Default,,0,0,0,,Сыну, жою, жою
Dialogue: 0,0:24:06.16,0:24:09.66,Default,,0,0,0,,Ерте эволюцияны өтеу
Dialogue: 0,0:24:10.60,0:24:14.50,Default,,0,0,0,,ауырсынатын ауырады өте ауырады
Dialogue: 0,0:24:15.40,0:24:16.96,Default,,0,0,0,,Бірақ мен өмір сүргім келеді
Dialogue: 0,0:24:17.56,0:24:19.13,Default,,0,0,0,,Жүрегім жылайды
Dialogue: 0,0:24:20.80,0:24:22.80,Default,,0,0,0,,Сіздің де өміріңіз
Dialogue: 0,0:24:23.66,0:24:25.03,Default,,0,0,0,,Күресу
