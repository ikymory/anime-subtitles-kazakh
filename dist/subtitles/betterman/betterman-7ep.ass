Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.46,0:00:17.23,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:00:20.60,0:00:21.66,Default,,0,0,0,,Психо дауыс
Dialogue: 0,0:00:22.96,0:00:27.36,Default,,0,0,0,,Гаа гаоо гааа
Dialogue: 0,0:00:32.86,0:00:34.70,Default,,0,0,0,,Гауоооооо
Dialogue: 0,0:00:34.80,0:00:35.66,Default,,0,0,0,,Беттерман
Dialogue: 0,0:00:36.43,0:00:40.23,Default,,0,0,0,,Гаар
Dialogue: 0,0:00:41.73,0:00:51.33,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:00:53.63,0:01:01.80,Default,,0,0,0,,Күміс қайықтың жүзуі
Dialogue: 0,0:01:03.53,0:01:12.40,Default,,0,0,0,,Аты белгісіз адамдар
Dialogue: 0,0:01:15.40,0:01:23.16,Default,,0,0,0,,Қай жерде теңселіп жүрсің?
Dialogue: 0,0:01:26.66,0:01:35.43,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:01:35.80,0:01:43.93,Default,,0,0,0,,Жанға бағыт-бағдар беру
Dialogue: 0,0:01:45.73,0:01:55.33,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:01:55.60,0:02:07.86,Default,,0,0,0,,Ағып жатқанда қозғалмаңыз...
Dialogue: 0,0:02:20.86,0:02:22.76,Default,,0,0,0,,Техникалық қызмет көрсетуші жауап беріңіз
Dialogue: 0,0:02:23.33,0:02:24.90,Default,,0,0,0,,Президент Президент
Dialogue: 0,0:02:25.66,0:02:27.73,Default,,0,0,0,,Хе хе хе хе хе хе
Dialogue: 0,0:02:27.80,0:02:28.66,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:02:29.16,0:02:32.26,Default,,0,0,0,,Оянғандардың да, Тиранның да сәйкестендіру сигналдары кесілген.
Dialogue: 0,0:02:32.46,0:02:34.50,Default,,0,0,0,,Тасты тез арада алып тастамасақ, қауіпті болмай ма?
Dialogue: 0,0:02:34.66,0:02:38.43,Default,,0,0,0,,Алайда радио үзіліп, жолдар жабылған.
Dialogue: 0,0:02:38.76,0:02:40.50,Default,,0,0,0,,Таңның атуын күтуден басқа амалым жоқ.
Dialogue: 0,0:02:40.80,0:02:43.33,Default,,0,0,0,,Хмм, мына жәндік сондай шулы.
Dialogue: 0,0:02:43.40,0:02:43.86,Default,,0,0,0,,О
Dialogue: 0,0:02:45.50,0:02:45.96,Default,,0,0,0,,Хой
Dialogue: 0,0:02:46.16,0:02:46.63,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:02:47.73,0:02:49.53,Default,,0,0,0,,Жәндіктерден сақтандырғыш №1
Dialogue: 0,0:02:49.83,0:02:52.80,Default,,0,0,0,,Ол осы ақымақ өнертабыстардың бәрін жасаған президент болды.
Dialogue: 0,0:02:53.40,0:02:53.93,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:02:55.06,0:02:58.80,Default,,0,0,0,,Жоғалғандар - президент, Кейта, Хиноки-чан және Сара-чан.
Dialogue: 0,0:02:59.13,0:03:02.20,Default,,0,0,0,,Янагидің күйеуі Каэде-чан және Асами ханым
Dialogue: 0,0:03:03.40,0:03:06.83,Default,,0,0,0,,Бүкіл нейроноидтың жерленгені ирониялық.
Dialogue: 0,0:03:19.53,0:03:20.76,Default,,0,0,0,,Кешіріңіз Хиноки
Dialogue: 0,0:03:21.66,0:03:24.70,Default,,0,0,0,,Тергеу аяқталғаннан кейін анам қайтып келеді.
Dialogue: 0,0:03:25.63,0:03:29.23,Default,,0,0,0,,Екеуіңіз де уайымдамаңыздар, мен қазірдің өзінде орта мектеп оқушысымын.
Dialogue: 0,0:03:29.40,0:03:30.70,Default,,0,0,0,,Жалғыз болған дұрыс
Dialogue: 0,0:03:31.03,0:03:32.36,Default,,0,0,0,,Сен ақымақсың, Хиноки.
Dialogue: 0,0:03:32.86,0:03:33.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:34.50,0:03:37.03,Default,,0,0,0,,Қиындыққа тап болсаңыз, ысқырыңыз.
Dialogue: 0,0:03:38.00,0:03:39.20,Default,,0,0,0,,Мен дереу жүгіремін.
Dialogue: 0,0:03:39.73,0:03:42.26,Default,,0,0,0,,Бірдеңе болып қалса, аға, маған хабарласыңыз.
Dialogue: 0,0:03:42.66,0:03:44.36,Default,,0,0,0,,Мен сізге бірден көмектесемін.
Dialogue: 0,0:03:45.16,0:03:47.13,Default,,0,0,0,,Мен саған сенемін, Хиноки-сама.
Dialogue: 0,0:03:47.46,0:03:48.66,Default,,0,0,0,,Жақсы, ахаха
Dialogue: 0,0:03:48.80,0:03:51.13,Default,,0,0,0,,Ухуху хаха...
Dialogue: 0,0:03:51.86,0:03:52.83,Default,,0,0,0,,Марио-нии-чан
Dialogue: 0,0:04:03.93,0:04:07.93,Default,,0,0,0,,Әкем, шешем, ағам өлген жоқ.
Dialogue: 0,0:04:08.56,0:04:10.33,Default,,0,0,0,,Абсолюттік абсолют
Dialogue: 0,0:04:11.50,0:04:14.00,Default,,0,0,0,,Қиындық болса, ысқырық.
Dialogue: 0,0:04:14.96,0:04:16.40,Default,,0,0,0,,Мен дереу жүгіріп барамын.
Dialogue: 0,0:04:17.00,0:04:19.23,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:04:19.50,0:04:22.56,Default,,0,0,0,,Ах, сәлем, сәлем
Dialogue: 0,0:04:22.83,0:04:27.20,Default,,0,0,0,,Фухиуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:04:28.13,0:04:32.36,Default,,0,0,0,,Хиноки Енді жылама Хиноки
Dialogue: 0,0:04:32.40,0:04:34.10,Default,,0,0,0,,Уф хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:04:34.33,0:04:36.93,Default,,0,0,0,,Мен сенің жаныңда боламын.
Dialogue: 0,0:04:37.13,0:04:39.70,Default,,0,0,0,,...
Dialogue: 0,0:04:40.46,0:04:40.93,Default,,0,0,0,,О
Dialogue: 0,0:04:42.40,0:04:43.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:44.86,0:04:46.20,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:04:47.00,0:04:47.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:48.70,0:04:51.50,Default,,0,0,0,,Өйткені бұл менің арманым
Dialogue: 0,0:04:52.33,0:04:55.46,Default,,0,0,0,,Иә, иә, иә, иә.
Dialogue: 0,0:04:56.13,0:04:56.80,Default,,0,0,0,,О
Dialogue: 0,0:05:03.66,0:05:06.46,Default,,0,0,0,,Аджанта үңгірлерінің жер асты
Dialogue: 0,0:05:07.56,0:05:10.93,Default,,0,0,0,,Ха, Хиноки, Хиноки, эй, Хиноки
Dialogue: 0,0:05:12.03,0:05:12.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:13.16,0:05:14.20,Default,,0,0,0,,Хино Нори
Dialogue: 0,0:05:14.76,0:05:16.16,Default,,0,0,0,,-Қауіпті дейді -Не?
Dialogue: 0,0:05:19.66,0:05:20.33,Default,,0,0,0,,Сіз
Dialogue: 0,0:05:21.76,0:05:22.73,Default,,0,0,0,,үнді?
Dialogue: 0,0:05:23.20,0:05:24.53,Default,,0,0,0,,Бегемот пайда болады
Dialogue: 0,0:05:24.70,0:05:25.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:26.10,0:05:28.13,Default,,0,0,0,,А, Бегемот бұл құбыжық па?
Dialogue: 0,0:05:28.73,0:05:30.50,Default,,0,0,0,,Тез қашқаныңыз жөн.
Dialogue: 0,0:05:31.40,0:05:33.26,Default,,0,0,0,,А, о, эй, сен!
Dialogue: 0,0:05:38.33,0:05:41.10,Default,,0,0,0,,Әлгі бала аузын қозғамай сөйледі.
Dialogue: 0,0:05:43.16,0:05:46.50,Default,,0,0,0,,Бірақ бұл туристік орынға айналған жер.
Dialogue: 0,0:05:47.13,0:05:50.13,Default,,0,0,0,,Жер астында белгісіз қирандыларда үлкен құбыжық өмір сүре ме?
Dialogue: 0,0:05:51.73,0:05:56.66,Default,,0,0,0,,Менің ойымша, бұл университеттің зерттеу тобының жоғалып кеткен жері ме?
Dialogue: 0,0:05:57.00,0:05:57.76,Default,,0,0,0,,-Иә. -Е.
Dialogue: 0,0:05:58.60,0:06:00.56,Default,,0,0,0,,Ах, Хиноки, байқадың ба?
Dialogue: 0,0:06:02.20,0:06:04.86,Default,,0,0,0,,Бұл жерде монахтар ораза ұстайды.
Dialogue: 0,0:06:04.93,0:06:07.80,Default,,0,0,0,,Сондай-ақ ол ағартушылыққа жету үшін киелі орын болған дейді.
Dialogue: 0,0:06:08.56,0:06:11.53,Default,,0,0,0,,Оразаның азабы рухыңды сындырмасын
Dialogue: 0,0:06:12.23,0:06:15.16,Default,,0,0,0,,Мидағы химиялық заттар ауруды ләззатқа айналдырады
Dialogue: 0,0:06:16.10,0:06:16.86,Default,,0,0,0,,Бұл жер
Dialogue: 0,0:06:17.16,0:06:21.26,Default,,0,0,0,,Сондай-ақ бұл галлюцинациядан ләззат алатын құпия орын болған деген теория бар.
Dialogue: 0,0:06:22.10,0:06:24.06,Default,,0,0,0,,Өте егжей-тегжейлі Хиноки
Dialogue: 0,0:06:24.66,0:06:28.10,Default,,0,0,0,,Зерттеу тобының мүшелеріне палеонтолог доктор Айя кіреді
Dialogue: 0,0:06:28.46,0:06:31.56,Default,,0,0,0,,Яғни менің әкем мен анам.
Dialogue: 0,0:06:32.06,0:06:35.16,Default,,0,0,0,,Ал менің ағам да қасымда болды.
Dialogue: 0,0:06:36.23,0:06:38.86,Default,,0,0,0,,Е, сонда бәрі сол құбыжыққа барады.
Dialogue: 0,0:06:39.46,0:06:40.96,Default,,0,0,0,,Мен мұндай нәрсені емдемеймін.
Dialogue: 0,0:06:41.80,0:06:43.23,Default,,0,0,0,,Мұның бәрі елес
Dialogue: 0,0:06:43.90,0:06:45.23,Default,,0,0,0,,Өйткені Беттермен де.
Dialogue: 0,0:06:46.13,0:06:47.90,Default,,0,0,0,,Бұл Алджернонның шынайы тұлғасы
Dialogue: 0,0:06:48.60,0:06:51.30,Default,,0,0,0,,Барлығы адам жасаған елес.
Dialogue: 0,0:06:51.90,0:06:53.13,Default,,0,0,0,,Осы жерде бәріміз өлеміз.
Dialogue: 0,0:06:55.40,0:06:57.70,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:06:59.36,0:07:02.26,Default,,0,0,0,,Кеттік, Хиноки. Біз екі жақтымыз, солай ма?
Dialogue: 0,0:07:02.66,0:07:06.00,Default,,0,0,0,,Бірге жұмыс жасасақ, бұл жерден кететінімізге сенімдімін.
Dialogue: 0,0:07:06.56,0:07:09.13,Default,,0,0,0,,Dual Kind соншалықты ыңғайлы емес.
Dialogue: 0,0:07:09.46,0:07:10.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:11.83,0:07:14.96,Default,,0,0,0,,Ендеше, біз осы уақытқа дейін үлгердік, солай емес пе?
Dialogue: 0,0:07:15.46,0:07:16.20,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,0:07:18.00,0:07:21.40,Default,,0,0,0,,Аа, егер мұндай жерде бас тартсақ, Хинокидің отбасы да бақытты болмайды.
Dialogue: 0,0:07:23.63,0:07:24.10,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:07:26.10,0:07:26.83,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:07:28.43,0:07:30.73,Default,,0,0,0,,Өйткені мен ақымақпын
Dialogue: 0,0:07:32.83,0:07:35.00,Default,,0,0,0,,Президент!
Dialogue: 0,0:07:35.43,0:07:36.80,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:07:36.90,0:07:38.16,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:07:38.30,0:07:39.36,Default,,0,0,0,,Офицер
Dialogue: 0,0:07:42.10,0:07:42.83,Default,,0,0,0,,Кэй
Dialogue: 0,0:07:43.23,0:07:43.70,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:45.33,0:07:46.10,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:07:46.73,0:07:47.83,Default,,0,0,0,,Ааа
Dialogue: 0,0:07:47.93,0:07:48.40,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:49.83,0:07:50.43,Default,,0,0,0,,Каэде
Dialogue: 0,0:07:51.53,0:07:52.06,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:53.86,0:07:56.43,Default,,0,0,0,,Асами-сан, Сара-чан және Акамацу-сан да.
Dialogue: 0,0:07:56.66,0:07:58.40,Default,,0,0,0,,Ахххх
Dialogue: 0,0:07:58.50,0:07:58.96,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:07:59.03,0:08:01.60,Default,,0,0,0,,Мен мұнда не үшін келдім?
Dialogue: 0,0:08:02.23,0:08:04.23,Default,,0,0,0,,Мен балалық шағымды армандадым
Dialogue: 0,0:08:05.03,0:08:06.40,Default,,0,0,0,,Бұл галлюцинация сияқты болды
Dialogue: 0,0:08:07.83,0:08:09.30,Default,,0,0,0,,Сара-чанның да жағдайы жақсы.
Dialogue: 0,0:08:10.00,0:08:11.40,Default,,0,0,0,,Ол жай ғана ұйықтап жатқан сияқты
Dialogue: 0,0:08:11.80,0:08:15.56,Default,,0,0,0,,Бұл жарық люминесцентті зеңнің немесе оттықтың қандай да бір түріне ұқсайды.
Dialogue: 0,0:08:16.20,0:08:17.66,Default,,0,0,0,,Аджанта жер асты?
Dialogue: 0,0:08:18.96,0:08:22.06,Default,,0,0,0,,Алайда қиранды үшін біртүрлі геометриялық.
Dialogue: 0,0:08:23.36,0:08:23.86,Default,,0,0,0,,Га
Dialogue: 0,0:08:56.70,0:08:57.40,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:08:57.50,0:09:01.70,Default,,0,0,0,,...
Dialogue: 0,0:09:01.76,0:09:04.63,Default,,0,0,0,,О, Аоаки-кун және Хиноки-чан да.
Dialogue: 0,0:09:05.30,0:09:06.06,Default,,0,0,0,,О
Dialogue: 0,0:09:06.16,0:09:08.10,Default,,0,0,0,,Әй, екеуміз де аман қалдық.
Dialogue: 0,0:09:08.56,0:09:11.20,Default,,0,0,0,,Янаги-сан және бәрі де.
Dialogue: 0,0:09:11.73,0:09:16.00,Default,,0,0,0,,Хаа, бұл мені құтқарды.
Dialogue: 0,0:09:17.73,0:09:18.96,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:09:23.00,0:09:26.33,Default,,0,0,0,,Бегемот құбыжығы шынымен өмір сүрді ме?
Dialogue: 0,0:09:26.40,0:09:28.33,Default,,0,0,0,,Егер бұл рас болса
Dialogue: 0,0:09:28.66,0:09:30.96,Default,,0,0,0,,Фактілер - бұл факт, менің ойымша, олар үлкен фактілер.
Dialogue: 0,0:09:31.23,0:09:33.60,Default,,0,0,0,,Психо дауысы жұмыс істемейді, Жақсы адам жеңілді.
Dialogue: 0,0:09:33.83,0:09:35.66,Default,,0,0,0,,Мен ''Бұл керемет!'' деп ойладым.
Dialogue: 0,0:09:35.90,0:09:39.93,Default,,0,0,0,,Бегемот құлағын ашып, УДЗ сияқты дыбыс шығарады.
Dialogue: 0,0:09:40.00,0:09:43.36,Default,,0,0,0,,Хинокидің ауыр жүгін арқама салып, әйтеуір құтылдым.
Dialogue: 0,0:09:43.43,0:09:44.73,Default,,0,0,0,,Бұл өте ауыр.
Dialogue: 0,0:09:44.86,0:09:45.33,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:09:45.86,0:09:47.30,Default,,0,0,0,,Бегемоттың шақыруы
Dialogue: 0,0:09:48.20,0:09:51.10,Default,,0,0,0,,Бұл мас ететін дыбысы бар галлюциноген болды ма?
Dialogue: 0,0:09:51.73,0:09:54.10,Default,,0,0,0,,Аралар достарымен араласады
Dialogue: 0,0:09:54.13,0:09:56.36,Default,,0,0,0,,Ауада билеу қимылын жасау
Dialogue: 0,0:09:56.83,0:10:01.10,Default,,0,0,0,,Бимен бірге құйрық 250 Гц шамасында дыбыс сигналын шығарады.
Dialogue: 0,0:10:01.40,0:10:03.36,Default,,0,0,0,,Көлеміне байланысты интервал
Dialogue: 0,0:10:03.56,0:10:06.86,Default,,0,0,0,,Достарыңызға ұядан гүлге дейінгі бағыт пен қашықтықты айтыңыз.
Dialogue: 0,0:10:07.33,0:10:10.50,Default,,0,0,0,,Мұның Бегемоттың шақыруымен қандай қатысы бар?
Dialogue: 0,0:10:11.03,0:10:16.23,Default,,0,0,0,,Басқа жұмысшы аралар бұл дыбысты адамның жартылай шеңберлі арналарына сәйкес келетін параллельді сезімтал түктері арқылы қабылдады.
Dialogue: 0,0:10:16.66,0:10:17.86,Default,,0,0,0,,Өз еркімен емес
Dialogue: 0,0:10:18.20,0:10:22.40,Default,,0,0,0,,Дыбыспен басқарылғандай, рефлекторлық әрекетпен гүлге қарай ұшамын.
Dialogue: 0,0:10:23.23,0:10:25.56,Default,,0,0,0,,Сонымен балды тапқан жұмысшы ара
Dialogue: 0,0:10:25.63,0:10:28.23,Default,,0,0,0,,Басқа серіктерді дыбыс арқылы басқару
Dialogue: 0,0:10:28.70,0:10:33.30,Default,,0,0,0,,Сонымен, біз де дыбысты басқару арқылы осы уақытқа дейін жеттік.
Dialogue: 0,0:10:34.03,0:10:36.66,Default,,0,0,0,,Неге екені белгісіз, аяғым шаршап кетті деп ойладым.
Dialogue: 0,0:10:37.36,0:10:40.33,Default,,0,0,0,,Келесіде бұл дыбысты естігенде, сіз міндетті түрде сыртқа шығасыз.
Dialogue: 0,0:10:40.93,0:10:44.80,Default,,0,0,0,,Иә, Каэде-сан мен Сарачан бұл дыбысқа шыдай алмады.
Dialogue: 0,0:10:45.03,0:10:46.93,Default,,0,0,0,,Менің тосқауылым да.
Dialogue: 0,0:10:47.06,0:10:49.90,Default,,0,0,0,,Бұл шынымен де Алджернонның шынайы тұлғасы болуы мүмкін бе?
Dialogue: 0,0:10:50.40,0:10:52.50,Default,,0,0,0,,Мен әлі білмеймін
Dialogue: 0,0:10:53.13,0:10:54.86,Default,,0,0,0,,Әйтеуір, бұл жерден кетейік.
Dialogue: 0,0:10:55.23,0:10:58.86,Default,,0,0,0,,Сол Бегемоттың бізге тағы қашан шабуыл жасайтынын білмейміз.
Dialogue: 0,0:10:59.50,0:11:00.60,Default,,0,0,0,,Сіз оны оқи аласыз ба? Каэде
Dialogue: 0,0:11:01.53,0:11:02.70,Default,,0,0,0,,О-о
Dialogue: 0,0:11:02.76,0:11:07.16,Default,,0,0,0,,Түсіндім, егер сіз Каэде-санның дуалы бар бұл сарайдың құрылымын оқысаңыз.
Dialogue: 0,0:11:07.46,0:11:09.50,Default,,0,0,0,,Сіз жер бетіне шығуды таба аласыз
Dialogue: 0,0:11:09.70,0:11:11.86,Default,,0,0,0,,Мен үйге бара аламын. Мен құтқарыламын, Хиноки.
Dialogue: 0,0:11:12.33,0:11:14.70,Default,,0,0,0,,Мен әлі білмеймін
Dialogue: 0,0:11:15.50,0:11:16.30,Default,,0,0,0,,Бар
Dialogue: 0,0:11:17.00,0:11:17.63,Default,,0,0,0,,Сакура
Dialogue: 0,0:11:17.73,0:11:18.93,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:11:19.30,0:11:21.20,Default,,0,0,0,,Әлі де бар
Dialogue: 0,0:11:22.36,0:11:24.33,Default,,0,0,0,,Мен сынақтан өтуге тырысамын.
Dialogue: 0,0:11:27.03,0:11:29.26,Default,,0,0,0,,Гуруруру Гуруруру
Dialogue: 0,0:11:49.40,0:11:49.93,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:11:50.33,0:11:50.83,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:11:55.53,0:11:56.80,Default,,0,0,0,,Сіз әлі тірісіз бе?
Dialogue: 0,0:11:57.20,0:11:59.40,Default,,0,0,0,,Бегемоттан қашып құтылдың.
Dialogue: 0,0:12:01.90,0:12:05.46,Default,,0,0,0,,Гяаааа
Dialogue: 0,0:12:06.03,0:12:08.66,Default,,0,0,0,,Пектофорац... Рубрум
Dialogue: 0,0:12:10.46,0:12:15.10,Default,,0,0,0,,Егер қашып кеткім келгенде—
Dialogue: 0,0:12:22.03,0:12:24.43,Default,,0,0,0,,Олар менің барлық ағаларымды да өлтірді.
Dialogue: 0,0:12:25.10,0:12:26.76,Default,,0,0,0,,Осында қалсаң өлесің.
Dialogue: 0,0:12:38.90,0:12:41.26,Default,,0,0,0,,Бұл нәрсе ара ұясына ұқсайды.
Dialogue: 0,0:12:42.00,0:12:43.03,Default,,0,0,0,,Қайсысы? Каэде
Dialogue: 0,0:12:44.13,0:12:46.06,Default,,0,0,0,,Мм, дұрыс айтасың деп ойлаймын.
Dialogue: 0,0:12:46.66,0:12:48.76,Default,,0,0,0,,Жоқ, ол жақындап келеді.
Dialogue: 0,0:12:49.03,0:12:49.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:51.60,0:12:53.53,Default,,0,0,0,,Нана не на не? бұл дыбыс
Dialogue: 0,0:12:53.90,0:12:55.26,Default,,0,0,0,,Тірі зат сияқты
Dialogue: 0,0:12:55.86,0:12:57.06,Default,,0,0,0,,Каэде Қайсысы?
Dialogue: 0,0:12:57.60,0:12:59.33,Default,,0,0,0,,Екеуі де пайдасыз болып көрінеді.
Dialogue: 0,0:13:00.23,0:13:02.00,Default,,0,0,0,,Қашу жолы жоқ.
Dialogue: 0,0:13:02.86,0:13:03.70,Default,,0,0,0,,Шегінейік
Dialogue: 0,0:13:03.90,0:13:06.70,Default,,0,0,0,,Хааааааааааааааааааааааааа
Dialogue: 0,0:13:06.93,0:13:08.30,Default,,0,0,0,,Хаааааааааан
Dialogue: 0,0:13:10.63,0:13:13.06,Default,,0,0,0,,Уау, бірдеңе болды!
Dialogue: 0,0:13:13.26,0:13:18.06,Default,,0,0,0,,Оу-у-у-у-у-у-у-у!
Dialogue: 0,0:13:18.66,0:13:19.13,Default,,0,0,0,,Га
Dialogue: 0,0:13:24.96,0:13:26.96,Default,,0,0,0,,Бөгет құрылысында байқалған монитор кесірткесі?
Dialogue: 0,0:13:29.56,0:13:33.06,Default,,0,0,0,,Прето Ал, Прето ашуланғанда, ол Буддаға айналады.
Dialogue: 0,0:13:34.00,0:13:35.16,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:13:38.23,0:13:40.06,Default,,0,0,0,,Тез қашыңдар дедім.
Dialogue: 0,0:13:40.40,0:13:43.83,Default,,0,0,0,,Иә? Керемет. Сіз болдыңыз ба?
Dialogue: 0,0:13:44.23,0:13:46.20,Default,,0,0,0,,Керемет пе? Фуфу
Dialogue: 0,0:13:50.10,0:13:50.63,Default,,0,0,0,,О
Dialogue: 0,0:13:52.20,0:13:52.66,Default,,0,0,0,,Уф
Dialogue: 0,0:13:53.60,0:13:54.03,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:13:55.06,0:13:55.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:56.56,0:13:57.13,Default,,0,0,0,,О
Dialogue: 0,0:13:57.66,0:14:00.33,Default,,0,0,0,,Оны артта қалдырмаңыз.
Dialogue: 0,0:14:01.33,0:14:04.76,Default,,0,0,0,,иә, иә... иә, ха
Dialogue: 0,0:14:04.86,0:14:07.26,Default,,0,0,0,,...
Dialogue: 0,0:14:07.33,0:14:10.43,Default,,0,0,0,,Иә, бұл техникалық қызмет көрсетуші.
Dialogue: 0,0:14:12.93,0:14:14.06,Default,,0,0,0,,Сосын Тиран да.
Dialogue: 0,0:14:14.50,0:14:16.76,Default,,0,0,0,,Аа, оянғандар бар шығар.
Dialogue: 0,0:14:17.03,0:14:17.76,Default,,0,0,0,,(ДжоДжо) Х… Ол менің киімімді жыртып, тікелей теріме еніп барады.
Dialogue: 0,0:14:18.80,0:14:19.40,Default,,0,0,0,,Не?
Dialogue: 0,0:14:24.03,0:14:26.23,Default,,0,0,0,,-Аа, Бегемот шықты -Ах
Dialogue: 0,0:14:28.36,0:14:29.10,Default,,0,0,0,,Ламия
Dialogue: 0,0:14:30.93,0:14:31.73,Default,,0,0,0,,Семе?
Dialogue: 0,0:14:33.13,0:14:35.20,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:14:35.70,0:14:37.03,Default,,0,0,0,,Білу керек еді
Dialogue: 0,0:14:37.63,0:14:39.80,Default,,0,0,0,,Тұмандықпен жеңе алмайсыз
Dialogue: 0,0:14:40.33,0:14:43.36,Default,,0,0,0,,Оны қорғау үшін күресуден басқа амалым қалмады.
Dialogue: 0,0:14:43.66,0:14:46.13,Default,,0,0,0,,Егер бұл ниет сақталса, тұр.
Dialogue: 0,0:14:46.96,0:14:48.63,Default,,0,0,0,,Жарық сөнбес үшін
Dialogue: 0,0:14:49.43,0:14:50.06,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:14:51.53,0:14:52.86,Default,,0,0,0,,Қолыңды соз, Ламия
Dialogue: 0,0:14:53.86,0:14:56.26,Default,,0,0,0,,Сіз іздеген нәрсе дәл сол жерде
Dialogue: 0,0:15:03.46,0:15:04.00,Default,,0,0,0,,На
Dialogue: 0,0:15:04.36,0:15:06.30,Default,,0,0,0,,Ол бізді күтіп тұрды
Dialogue: 0,0:15:07.70,0:15:09.56,Default,,0,0,0,,Тағдырдың нұсқауымен жүр
Dialogue: 0,0:15:11.46,0:15:12.63,Default,,0,0,0,,Және бұл
Dialogue: 0,0:15:14.13,0:15:16.00,Default,,0,0,0,,Біздің үмітімізден туған
Dialogue: 0,0:15:17.53,0:15:18.20,Default,,0,0,0,,Forte
Dialogue: 0,0:15:20.50,0:15:24.23,Default,,0,0,0,,Егер қашып кеткім келгенде—
Dialogue: 0,0:15:25.03,0:15:28.93,Default,,0,0,0,,Хмм, жоқ, қайтып барсам да жағдай қауіпті.
Dialogue: 0,0:15:29.16,0:15:31.86,Default,,0,0,0,,Керемет! Ол үнді пілінен үш есе үлкен.
Dialogue: 0,0:15:32.16,0:15:34.10,Default,,0,0,0,,-Куч -Гяаа
Dialogue: 0,0:15:34.20,0:15:36.73,Default,,0,0,0,,-Шықылдау -Ооооооооооо
Dialogue: 0,0:15:37.46,0:15:39.13,Default,,0,0,0,,-Бұл дыбыс әлі -Ах!
Dialogue: 0,0:15:40.13,0:15:40.80,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:15:41.13,0:15:43.16,Default,,0,0,0,,Ооооооо
Dialogue: 0,0:15:45.33,0:15:46.10,Default,,0,0,0,,Беттерман
Dialogue: 0,0:15:46.40,0:15:46.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:49.26,0:15:51.06,Default,,0,0,0,,Кали қытырлақ қытырлақ
Dialogue: 0,0:15:59.00,0:16:00.00,Default,,0,0,0,,Уоооах!
Dialogue: 0,0:16:13.76,0:16:15.63,Default,,0,0,0,,Теяаа
Dialogue: 0,0:16:15.96,0:16:20.83,Default,,0,0,0,,Ти
Dialogue: 0,0:16:32.33,0:16:33.03,Default,,0,0,0,,О
Dialogue: 0,0:16:34.73,0:16:36.06,Default,,0,0,0,,Бұл Беттерман
Dialogue: 0,0:16:37.46,0:16:39.53,Default,,0,0,0,,Жоқ, ол бұрынғыдан басқаша көрінеді.
Dialogue: 0,0:16:45.26,0:16:45.96,Default,,0,0,0,,Forte
Dialogue: 0,0:16:46.93,0:16:47.70,Default,,0,0,0,,Forte?
Dialogue: 0,0:16:48.93,0:16:52.20,Default,,0,0,0,,Бұл жақсы адамның есімі.
Dialogue: 0,0:16:53.30,0:16:55.03,Default,,0,0,0,,Гуруруруру
Dialogue: 0,0:16:55.90,0:16:58.26,Default,,0,0,0,,Ааа
Dialogue: 0,0:17:00.96,0:17:01.60,Default,,0,0,0,,Гаа
Dialogue: 0,0:17:03.66,0:17:05.70,Default,,0,0,0,,Ооооо
Dialogue: 0,0:17:10.03,0:17:10.83,Default,,0,0,0,,Күшті
Dialogue: 0,0:17:11.76,0:17:14.90,Default,,0,0,0,,Сіз бетпе-бет келген жауға сәйкес формаңызды өзгерттіңіз бе?
Dialogue: 0,0:17:15.33,0:17:17.33,Default,,0,0,0,,Иә, бұл жақсы адам.
Dialogue: 0,0:17:17.73,0:17:20.33,Default,,0,0,0,,Жарайды, қазір техникалық қызмет көрсетушіге барайық.
Dialogue: 0,0:17:21.06,0:17:25.50,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:17:27.36,0:17:27.90,Default,,0,0,0,,Ах
Dialogue: 0,0:17:33.70,0:17:36.00,Default,,0,0,0,,Дірілді болдырмайтын материал құрылымы
Dialogue: 0,0:17:38.63,0:17:39.33,Default,,0,0,0,,Мен ең жек көретін сөздерім—
Dialogue: 0,0:17:41.40,0:17:42.10,Default,,0,0,0,,Гаа
Dialogue: 0,0:17:45.60,0:17:48.50,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:17:48.73,0:17:53.10,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:17:55.33,0:17:55.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:57.06,0:17:57.50,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:58.33,0:17:59.13,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:02.43,0:18:05.93,Default,,0,0,0,,Гяаа
Dialogue: 0,0:18:09.83,0:18:10.50,Default,,0,0,0,,Оян
Dialogue: 0,0:18:10.76,0:18:11.30,Default,,0,0,0,,Ояну
Dialogue: 0,0:18:16.46,0:18:18.80,Default,,0,0,0,,Уф, асықпасақ, біз де тірідей көміліп қаламыз.
Dialogue: 0,0:18:18.83,0:18:21.26,Default,,0,0,0,,Иә, оның ұзаққа созылуы екіталай.
Dialogue: 0,0:18:21.76,0:18:25.86,Default,,0,0,0,,Хмм, маған бәрібір, бірақ бәрің неге менің орныма келесіңдер?
Dialogue: 0,0:18:26.43,0:18:28.06,Default,,0,0,0,,Бұл қыбырлаған оқиға ма?
Dialogue: 0,0:18:28.66,0:18:32.00,Default,,0,0,0,,Құбыжықтарды құбыжықтарға қалдырыңыз және оларды мүмкіндігінше тезірек жойыңыз.
Dialogue: 0,0:18:32.33,0:18:33.53,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:18:33.83,0:18:35.63,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:18:39.16,0:18:39.86,Default,,0,0,0,,Ооо
Dialogue: 0,0:18:40.73,0:18:42.20,Default,,0,0,0,,Гаар
Dialogue: 0,0:18:46.86,0:18:48.83,Default,,0,0,0,,Бұл тым қауіпті! Біз Сантананы өлтіруіміз керек.
Dialogue: 0,0:18:53.33,0:18:53.80,Default,,0,0,0,,Құт
Dialogue: 0,0:18:54.13,0:18:55.40,Default,,0,0,0,,Тау жыныстары нәзік.
Dialogue: 0,0:18:56.30,0:18:57.86,Default,,0,0,0,,Синапсты бомбалаумен бірден бармақшысыз ба?
Dialogue: 0,0:18:58.33,0:19:02.40,Default,,0,0,0,,Бұл жақсы емес сияқты, бірақ мен тесікті бұрғылай салысымен ол құлап кетеді.
Dialogue: 0,0:19:02.63,0:19:04.63,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:19:09.03,0:19:09.93,Default,,0,0,0,,Бөгет құрылысы
Dialogue: 0,0:19:10.43,0:19:11.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:11.73,0:19:13.76,Default,,0,0,0,,Сіз оны жолда көрдіңіз, солай ма? бөгет құрылысы
Dialogue: 0,0:19:14.16,0:19:15.13,Default,,0,0,0,,Өте көзге түседі.
Dialogue: 0,0:19:15.53,0:19:18.06,Default,,0,0,0,,Бөгет – суды ұстап тұру үшін қолданылатын нәрсе.
Dialogue: 0,0:19:18.70,0:19:21.86,Default,,0,0,0,,Тау жыныстары опырылып жатса, оны тоқтату керек.
Dialogue: 0,0:19:22.26,0:19:23.90,Default,,0,0,0,,Сіз ақымақ бірдеңе айтуға қалай батылыңыз бар?
Dialogue: 0,0:19:24.50,0:19:25.30,Default,,0,0,0,,көремін.
Dialogue: 0,0:19:25.73,0:19:27.00,Default,,0,0,0,,Оқыдым, Көк балта-күн.
Dialogue: 0,0:19:27.53,0:19:29.40,Default,,0,0,0,,Жарайды, G-жиынтығы.
Dialogue: 0,0:19:29.50,0:19:32.26,Default,,0,0,0,,Гауоооооооооооо
Dialogue: 0,0:19:51.16,0:19:52.60,Default,,0,0,0,,Гуоооооо
Dialogue: 0,0:19:57.36,0:19:58.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:03.73,0:20:07.23,Default,,0,0,0,,Гуруруруру
Dialogue: 0,0:20:07.50,0:20:11.53,Default,,0,0,0,,Grrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr
Dialogue: 0,0:20:11.96,0:20:13.30,Default,,0,0,0,,Психо даңқ
Dialogue: 0,0:20:13.50,0:20:14.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:14.20,0:20:16.50,Default,,0,0,0,,Ооооооо
Dialogue: 0,0:20:22.46,0:20:23.90,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:20:27.96,0:20:30.33,Default,,0,0,0,,Синапс оқының шабуылы
Dialogue: 0,0:20:34.23,0:20:35.10,Default,,0,0,0,,Тиранмен шайқасу
Dialogue: 0,0:20:35.46,0:20:36.66,Default,,0,0,0,,Оянған адаммен қатып қалу
Dialogue: 0,0:20:37.20,0:20:38.23,Default,,0,0,0,,Идея сыйлығы.
Dialogue: 0,0:20:52.60,0:20:53.70,Default,,0,0,0,,Тезірек, Хота
Dialogue: 0,0:20:54.10,0:20:55.30,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:20:57.73,0:20:58.20,Default,,0,0,0,,Құт
Dialogue: 0,0:21:00.93,0:21:02.20,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:21:02.80,0:21:04.83,Default,,0,0,0,,Ооо...
Dialogue: 0,0:21:05.00,0:21:07.33,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:21:07.40,0:21:08.83,Default,,0,0,0,,Мен дереу жүгіремін.
Dialogue: 0,0:21:14.06,0:21:14.93,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:21:30.86,0:21:32.90,Default,,0,0,0,,Бұл жақсы емес деп шешілді.
Dialogue: 0,0:21:33.23,0:21:35.80,Default,,0,0,0,,Бәрімізді Бегемот жеп қойды.
Dialogue: 0,0:21:37.13,0:21:38.20,Default,,0,0,0,,-Ой? -а?
Dialogue: 0,0:21:44.46,0:21:45.33,Default,,0,0,0,,Ууууууууууууууууу
Dialogue: 0,0:21:45.40,0:21:47.06,Default,,0,0,0,,Ооо
Dialogue: 0,0:21:47.13,0:21:47.60,Default,,0,0,0,,О
Dialogue: 0,0:21:49.26,0:21:51.13,Default,,0,0,0,,Ааа жоқ аааа
Dialogue: 0,0:21:51.40,0:21:54.86,Default,,0,0,0,,Пепе, мен сені көрдім
Dialogue: 0,0:21:55.20,0:21:59.60,Default,,0,0,0,,Иә, өлгендердің жаны өлім түбінен шықты!
Dialogue: 0,0:21:59.66,0:22:01.96,Default,,0,0,0,,О, жер-жерде көгерген.
Dialogue: 0,0:22:02.43,0:22:05.60,Default,,0,0,0,,Бұл депутат орнынан басқа адамдар мінетін орын емес.
Dialogue: 0,0:22:06.66,0:22:10.46,Default,,0,0,0,,Барлығы аман-есен оралған сияқты.
Dialogue: 0,0:22:13.63,0:22:14.76,Default,,0,0,0,,Президент
Dialogue: 0,0:22:14.80,0:22:16.40,Default,,0,0,0,,Эй, сен тірісің.
Dialogue: 0,0:22:16.43,0:22:18.03,Default,,0,0,0,,Мен сендім!
Dialogue: 0,0:22:18.40,0:22:20.20,Default,,0,0,0,,Президент
Dialogue: 0,0:22:34.46,0:22:47.13,Default,,0,0,0,,Құдайдың күнәсі шексіз теломераларға жазылды
Dialogue: 0,0:22:47.70,0:22:54.00,Default,,0,0,0,,Жалынды құшақтау
Dialogue: 0,0:22:54.33,0:23:01.60,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:01.80,0:23:05.00,Default,,0,0,0,,Жан рух Жалғыз дауыс
Dialogue: 0,0:23:05.26,0:23:08.53,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.70,0:23:11.83,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.20,0:23:15.43,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.33,0:23:27.03,Default,,0,0,0,,Алыстағы күннің сәулесін тап!
Dialogue: 0,0:23:27.56,0:23:37.16,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:37.83,0:23:48.80,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:59.30,0:24:00.63,Default,,0,0,0,,Мен ештеңе көре алмаймын
Dialogue: 0,0:24:01.40,0:24:02.83,Default,,0,0,0,,Мен ештеңе естімеймін
Dialogue: 0,0:24:03.83,0:24:07.26,Default,,0,0,0,,Менің кілтім сынған.
Dialogue: 0,0:24:08.66,0:24:09.80,Default,,0,0,0,,Саламандр?
Dialogue: 0,0:24:10.96,0:24:12.03,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:24:13.06,0:24:15.46,Default,,0,0,0,,У денені бұзады
Dialogue: 0,0:24:16.60,0:24:19.23,Default,,0,0,0,,Сығынды дене арқылы өтеді
Dialogue: 0,0:24:20.80,0:24:22.60,Default,,0,0,0,,Сіз іштен
Dialogue: 0,0:24:23.13,0:24:24.40,Default,,0,0,0,,Эрозия
Dialogue: 0,0:24:25.90,0:24:31.90,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
