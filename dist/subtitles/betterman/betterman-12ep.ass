Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.23,0:00:22.23,Default,,0,0,0,,BPL бұрынғысынша бұрынғысынша бірдей ме?
Dialogue: 0,0:00:22.66,0:00:26.13,Default,,0,0,0,,-Иә, біз де мәжбүрлі тексеруге рұқсат алдық -Фуаааааааааааааааааааааа
Dialogue: 0,0:00:26.30,0:00:27.40,Default,,0,0,0,,Спутниктік суреттер бойынша
Dialogue: 0,0:00:27.63,0:00:31.36,Default,,0,0,0,,Нысан ішінде ұшу-қону жолағында ешбір ұшақ тұрмаған сияқты, сондықтан қонуға болады.
Dialogue: 0,0:00:31.96,0:00:35.00,Default,,0,0,0,,Менің ойымша, абайсызда қонуға болады.
Dialogue: 0,0:00:35.60,0:00:37.30,Default,,0,0,0,,Буйтол да штабтан келе жатыр.
Dialogue: 0,0:00:38.03,0:00:39.16,Default,,0,0,0,,Жаңа бас сүңгуір
Dialogue: 0,0:00:39.46,0:00:43.20,Default,,0,0,0,,Сондай-ақ қауіпсіздікті қамтамасыз ету үшін алдымен арнайы жасақтар түседі.
Dialogue: 0,0:00:43.76,0:00:44.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:44.90,0:00:48.93,Default,,0,0,0,,Күрсін, міне. Бұл жылдам. Бұл сөзсіз жылдам.
Dialogue: 0,0:00:49.33,0:00:51.60,Default,,0,0,0,,Бұл ұшақ V-22 Osprey.
Dialogue: 0,0:00:57.90,0:01:00.00,Default,,0,0,0,,Кенеттен сайтта нейрондық сүңгу?
Dialogue: 0,0:01:00.73,0:01:03.66,Default,,0,0,0,,Мен жеткілікті модельдеу жасадым. Ешқандай проблемалар жоқ.
Dialogue: 0,0:01:04.36,0:01:04.96,Default,,0,0,0,,Жақсы
Dialogue: 0,0:01:05.50,0:01:06.56,Default,,0,0,0,,- Экипажға айтыңыз - иә?
Dialogue: 0,0:01:07.10,0:01:09.30,Default,,0,0,0,,Алда келе жатқан белгісіз нысан
Dialogue: 0,0:01:10.13,0:01:12.13,Default,,0,0,0,,Құрылғы енді ескерту режиміне өтеді.
Dialogue: 0,0:01:16.70,0:01:18.23,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:19.03,0:01:20.26,Default,,0,0,0,,Жоқ, одан құтылу мүмкін емес.
Dialogue: 0,0:01:26.33,0:01:27.96,Default,,0,0,0,,Увааааааааааааааааааа
Dialogue: 0,0:01:36.60,0:01:38.70,Default,,0,0,0,,Ақымақ мылтық жұмыс істемейді.
Dialogue: 0,0:01:40.20,0:01:43.26,Default,,0,0,0,,Гагаааааааааааааааааааааааааааа
Dialogue: 0,0:01:43.86,0:01:44.90,Default,,0,0,0,,Ой-о-о-о-о
Dialogue: 0,0:01:45.40,0:01:47.13,Default,,0,0,0,,Менде әлі ештеңе жоқ
Dialogue: 0,0:01:47.50,0:01:49.40,Default,,0,0,0,,Дааааааааааааааааааааааааааааа
Dialogue: 0,0:01:52.83,0:02:02.30,Default,,0,0,0,,Көк домалақ үнсіздік
Dialogue: 0,0:02:04.53,0:02:12.56,Default,,0,0,0,,Жүзетін күміс қайық
Dialogue: 0,0:02:14.50,0:02:23.03,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:02:26.30,0:02:34.43,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:02:37.56,0:02:46.33,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:02:46.80,0:02:54.86,Default,,0,0,0,,Жанға бағыт беру
Dialogue: 0,0:02:56.73,0:03:06.40,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:03:06.50,0:03:18.10,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:03:36.76,0:03:38.36,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:39.30,0:03:40.26,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:40.73,0:03:44.93,Default,,0,0,0,,Бұл кешегі күні зауытта уылдырық шашқан жәндіктердің бірі болуы керек.
Dialogue: 0,0:03:45.36,0:03:47.80,Default,,0,0,0,,Аспанда осылай ұшатын жәндіктер?
Dialogue: 0,0:03:48.30,0:03:52.53,Default,,0,0,0,,Егер жәндіктер жасанды түрде жетілдірілсе, бұл мүмкін емес.
Dialogue: 0,0:03:53.30,0:03:56.00,Default,,0,0,0,,Арнайы жасақ 3 минутқа ғана созылды, уау.
Dialogue: 0,0:03:56.60,0:03:58.90,Default,,0,0,0,,Біз келесі мақсатта боламыз.
Dialogue: 0,0:04:00.36,0:04:01.90,Default,,0,0,0,,Капитан, биіктікті төмендетіңіз.
Dialogue: 0,0:04:06.56,0:04:08.80,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:04:11.36,0:04:12.63,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,0:04:13.06,0:04:14.93,Default,,0,0,0,,Ұшақты жәндіктер жеп жатыр.
Dialogue: 0,0:04:17.56,0:04:19.50,Default,,0,0,0,,А, мен кіріп жатырмын.
Dialogue: 0,0:04:29.73,0:04:31.96,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:04:46.16,0:04:47.33,Default,,0,0,0,,Ахх
Dialogue: 0,0:04:47.56,0:04:51.43,Default,,0,0,0,,Мен 17 жаста, сүйікті Каори-чанның деректерін жібергеніме қуаныштымын.
Dialogue: 0,0:04:52.80,0:04:53.23,Default,,0,0,0,,Ах
Dialogue: 0,0:04:53.80,0:04:54.53,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:04:55.10,0:04:56.26,Default,,0,0,0,,Ұшқыш өлтірілді
Dialogue: 0,0:04:56.80,0:04:57.36,Default,,0,0,0,,Не?
Dialogue: 0,0:04:57.73,0:04:59.00,Default,,0,0,0,,Жанармай багы да зақымдалған.
Dialogue: 0,0:04:59.50,0:05:01.16,Default,,0,0,0,,Мен қандай да бір жолмен шұғыл қонуға тырысамын.
Dialogue: 0,0:05:01.86,0:05:03.93,Default,,0,0,0,,Әй, эй, теңізге қон.
Dialogue: 0,0:05:04.30,0:05:05.16,Default,,0,0,0,,Мен жерді көріп тұрмын
Dialogue: 0,0:05:06.10,0:05:07.36,Default,,0,0,0,,Куширо Маршленд
Dialogue: 0,0:05:10.33,0:05:11.66,Default,,0,0,0,,О, жақсы!
Dialogue: 0,0:05:12.00,0:05:12.46,Default,,0,0,0,,Уау
Dialogue: 0,0:05:16.80,0:05:18.23,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:05:18.43,0:05:19.60,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:05:21.63,0:05:22.10,Default,,0,0,0,,Урааа
Dialogue: 0,0:05:34.30,0:05:37.03,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:05:37.50,0:05:38.93,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:05:39.60,0:05:41.76,Default,,0,0,0,,Иә
Dialogue: 0,0:05:42.00,0:05:44.33,Default,,0,0,0,,Ннааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа Президент
Dialogue: 0,0:05:44.53,0:05:47.90,Default,,0,0,0,,Жол ақысын алмасаңыз, бұл әзіл емес.
Dialogue: 0,0:05:47.96,0:05:49.13,Default,,0,0,0,,Уф, Сара қайда?
Dialogue: 0,0:05:50.20,0:05:51.40,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:05:51.80,0:05:52.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:53.13,0:05:54.36,Default,,0,0,0,,Муши-сан
Dialogue: 0,0:05:56.60,0:06:00.13,Default,,0,0,0,,Эй, Йоринуки Каори, 18 жаста, сен әкелдің.
Dialogue: 0,0:06:00.23,0:06:02.06,Default,,0,0,0,,Мен оның контррейлерде екеніне сенімдімін.
Dialogue: 0,0:06:02.13,0:06:03.53,Default,,0,0,0,,А, жарайды, кеттік.
Dialogue: 0,0:06:03.86,0:06:04.33,Default,,0,0,0,,Ммм
Dialogue: 0,0:06:05.36,0:06:09.20,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:06:09.33,0:06:11.76,Default,,0,0,0,,Хахахаха, бұл жақсы емес.
Dialogue: 0,0:06:12.20,0:06:15.03,Default,,0,0,0,,Хиноки, бұл туралы бірдеңе жасаңыз.
Dialogue: 0,0:06:15.26,0:06:15.90,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:06:15.96,0:06:17.96,Default,,0,0,0,,Ha Uhub бақылауы
Dialogue: 0,0:06:18.73,0:06:20.06,Default,,0,0,0,,iHub басқаруы
Dialogue: 0,0:06:28.13,0:06:30.03,Default,,0,0,0,,Бұл көмектесті.
Dialogue: 0,0:06:31.76,0:06:32.26,Default,,0,0,0,,Га
Dialogue: 0,0:06:40.23,0:06:44.76,Default,,0,0,0,,Уау, хахахаха, қателер, тағы қателер.
Dialogue: 0,0:06:45.10,0:06:47.06,Default,,0,0,0,,Хиноки, бірдеңе істеуіңізді өтінемін.
Dialogue: 0,0:06:47.36,0:06:49.33,Default,,0,0,0,,Хиноки Хиноки
Dialogue: 0,0:06:50.33,0:06:51.03,Default,,0,0,0,,Маған енді ұнамайды
Dialogue: 0,0:06:52.00,0:06:52.50,Default,,0,0,0,,Қалай?
Dialogue: 0,0:06:54.16,0:06:57.13,Default,,0,0,0,,Мен бұдан былай Оянған адамды мінбеуім керек еді.
Dialogue: 0,0:06:58.86,0:07:01.93,Default,,0,0,0,,Мен енді құбыжықтарды, роботтарды немесе жәндіктерді қаламаймын.
Dialogue: 0,0:07:02.26,0:07:04.23,Default,,0,0,0,,Хиноки
Dialogue: 0,0:07:05.53,0:07:08.90,Default,,0,0,0,,Мен мұндай нәрсемен күресу үшін бас сүңгуір болған жоқпын.
Dialogue: 0,0:07:16.23,0:07:18.30,Default,,0,0,0,,Бұл қанша уақытқа созылады деп ойлаймын.
Dialogue: 0,0:07:18.70,0:07:21.13,Default,,0,0,0,,Кейтамен және басқалармен байланысуым керек пе?
Dialogue: 0,0:07:21.93,0:07:23.33,Default,,0,0,0,,-Иә, Президент мырза -Әй?
Dialogue: 0,0:07:24.03,0:07:25.93,Default,,0,0,0,,Каэде-чан, жақсысың ба?
Dialogue: 0,0:07:26.40,0:07:29.86,Default,,0,0,0,,Иә, мен соңғы сәтте Тиранға міндім.
Dialogue: 0,0:07:30.30,0:07:31.36,Default,,0,0,0,,Шие де менімен бірге.
Dialogue: 0,0:07:31.53,0:07:32.96,Default,,0,0,0,,Иә, Шие?
Dialogue: 0,0:07:33.30,0:07:35.70,Default,,0,0,0,,Бұл мен туралы сияқты
Dialogue: 0,0:07:36.30,0:07:40.10,Default,,0,0,0,,Сакура Сакура?
Dialogue: 0,0:07:40.86,0:07:42.30,Default,,0,0,0,,Ах, шие.
Dialogue: 0,0:07:42.80,0:07:46.30,Default,,0,0,0,,Мен Шо мен Мордиварп халқын таба алмаймын.
Dialogue: 0,0:07:46.53,0:07:49.70,Default,,0,0,0,,Егер есімде дұрыс болса, ол С-21 кабинасында болуы керек.
Dialogue: 0,0:07:50.36,0:07:51.30,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:52.16,0:07:56.06,Default,,0,0,0,,Олай болса, мен Шиемен бірге Ульва-чанды тауып алайын.
Dialogue: 0,0:07:57.30,0:07:58.53,Default,,0,0,0,,Ульва-чан?
Dialogue: 0,0:07:59.30,0:08:00.63,Default,,0,0,0,,Тиран туралы.
Dialogue: 0,0:08:01.16,0:08:02.13,Default,,0,0,0,,(Беатриса) Ол кітап бөлмеге кіріп кеткен жәндіктерден қалай құтылу керектігін айтып бере ме екен?
Dialogue: 0,0:08:06.26,0:08:08.16,Default,,0,0,0,,Иә, күткендей.
Dialogue: 0,0:08:09.06,0:08:12.00,Default,,0,0,0,,Балалар сендер өте кедей екенсіңдер
Dialogue: 0,0:08:12.70,0:08:13.96,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:08:14.43,0:08:16.23,Default,,0,0,0,,Не? шие
Dialogue: 0,0:08:16.96,0:08:17.56,Default,,0,0,0,,Ааа
Dialogue: 0,0:08:20.60,0:08:22.36,Default,,0,0,0,,Уф, жоқ, мен қашып құтыла алмаймын.
Dialogue: 0,0:08:23.30,0:08:25.66,Default,,0,0,0,,Хмм, эй, аа!
Dialogue: 0,0:08:26.93,0:08:27.63,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:08:28.63,0:08:30.66,Default,,0,0,0,,Не болды? Сара Каэде-чан
Dialogue: 0,0:08:31.60,0:08:33.30,Default,,0,0,0,,Сыртқы камера бұғатталған.
Dialogue: 0,0:08:33.70,0:08:35.90,Default,,0,0,0,,-Хи хи -Не болды? Эй, маған жауап берші.
Dialogue: 0,0:08:40.80,0:08:42.46,Default,,0,0,0,,Увааааааааааааааааааа
Dialogue: 0,0:08:42.56,0:08:43.00,Default,,0,0,0,,О
Dialogue: 0,0:08:43.63,0:08:44.53,Default,,0,0,0,,Уау
Dialogue: 0,0:08:49.70,0:08:52.93,Default,,0,0,0,,А, жоқ, Мордиварптық достар.
Dialogue: 0,0:09:04.33,0:09:05.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:10.26,0:09:10.70,Default,,0,0,0,,Ах
Dialogue: 0,0:09:11.80,0:09:12.96,Default,,0,0,0,,Хааааааааааааааааааааааааааа
Dialogue: 0,0:09:14.10,0:09:17.83,Default,,0,0,0,,Ұшақ бөлініп, барлығы бір-бірінен біршама алшақтап кеткен сияқты.
Dialogue: 0,0:09:19.26,0:09:20.90,Default,,0,0,0,,Мынау сол жақтағы басқару мұнарасы ма?
Dialogue: 0,0:09:24.13,0:09:28.06,Default,,0,0,0,,Биотехнология және тағамдық ғылыми-зерттеу институты BPL
Dialogue: 0,0:09:31.26,0:09:31.73,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:09:33.23,0:09:33.76,Default,,0,0,0,,Га
Dialogue: 0,0:09:37.76,0:09:38.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:42.73,0:09:43.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:43.90,0:09:44.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:46.66,0:09:47.43,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:09:47.66,0:09:48.10,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:51.96,0:09:52.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:53.16,0:09:54.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:55.53,0:09:59.53,Default,,0,0,0,,Не? Не? Не?
Dialogue: 0,0:10:00.30,0:10:00.76,Default,,0,0,0,,Ах
Dialogue: 0,0:10:01.96,0:10:02.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:04.26,0:10:04.80,Default,,0,0,0,,Ахаха
Dialogue: 0,0:10:13.43,0:10:15.20,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:10:17.63,0:10:18.56,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:10:18.86,0:10:19.46,Default,,0,0,0,,(Фушигиро) Тек теңсіз шындық қана—
Dialogue: 0,0:10:19.90,0:10:24.00,Default,,0,0,0,,Сіз ақыры оянған сияқтысыз, доктор Цуко.
Dialogue: 0,0:10:25.03,0:10:25.73,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:10:26.80,0:10:29.53,Default,,0,0,0,,Бұл биопровизия зертханасының технологиясы
Dialogue: 0,0:10:30.60,0:10:33.60,Default,,0,0,0,,Бұл UMA жасау мүмкін болуы мүмкін.
Dialogue: 0,0:10:35.66,0:10:38.10,Default,,0,0,0,,Мен солай ойласам да, бұл туралы ойлағым келмеді.
Dialogue: 0,0:10:39.46,0:10:42.13,Default,,0,0,0,,Дәрігер адамзаттың ертеңгі азық-түлік жағдайына алаңдады.
Dialogue: 0,0:10:42.50,0:10:43.96,Default,,0,0,0,,Зерттеумен жұмыс істеу керек еді
Dialogue: 0,0:10:45.53,0:10:47.03,Default,,0,0,0,,Бірақ неге бұлай істедің?
Dialogue: 0,0:10:47.66,0:10:50.06,Default,,0,0,0,,Мен сізден түсінеді деп күтпеймін.
Dialogue: 0,0:10:50.80,0:10:52.86,Default,,0,0,0,,Тек оларға көрсін.
Dialogue: 0,0:10:53.70,0:10:56.03,Default,,0,0,0,,Зерттеуімнің мақсаты
Dialogue: 0,0:10:56.83,0:10:58.60,Default,,0,0,0,,Хотару-кун Хиноки-сан
Dialogue: 0,0:11:00.76,0:11:02.10,Default,,0,0,0,,Сәлем Хино Нори
Dialogue: 0,0:11:02.53,0:11:06.23,Default,,0,0,0,,Егер бұл мәңгілікке жалғаса берсе, гель өзінің шегіне жетеді және сіз қозғала алмайсыз.
Dialogue: 0,0:11:06.80,0:11:10.80,Default,,0,0,0,,Өтінемін, мен мұндай жерде өлгім келмейді.
Dialogue: 0,0:11:11.46,0:11:12.73,Default,,0,0,0,,Содан кейін оны сол жерде орындаңыз.
Dialogue: 0,0:11:13.76,0:11:15.00,Default,,0,0,0,,UHUB БАСҚАРУ
Dialogue: 0,0:11:15.23,0:11:17.20,Default,,0,0,0,,ihub басқару элементі
Dialogue: 0,0:11:23.23,0:11:25.56,Default,,0,0,0,,Кюн нооооо
Dialogue: 0,0:11:27.00,0:11:29.43,Default,,0,0,0,,Мордиварптың мақтаныш Neuronoid өнімділігі
Dialogue: 0,0:11:29.70,0:11:31.66,Default,,0,0,0,,Толығырақ қарастырайық
Dialogue: 0,0:11:32.73,0:11:37.46,Default,,0,0,0,,Енді, балалар, менің тілектерімді орындаңдар.
Dialogue: 0,0:11:42.10,0:11:43.06,Default,,0,0,0,,Балалар
Dialogue: 0,0:11:44.80,0:11:45.76,Default,,0,0,0,,Балалар
Dialogue: 0,0:11:46.66,0:11:48.33,Default,,0,0,0,,Мен сенің әкеңмін
Dialogue: 0,0:11:48.73,0:11:50.80,Default,,0,0,0,,Менің тілегімді орында
Dialogue: 0,0:11:51.36,0:11:52.96,Default,,0,0,0,,Иә әке
Dialogue: 0,0:12:02.30,0:12:06.40,Default,,0,0,0,,Өлгің келмесе, мықты бол, балаларым.
Dialogue: 0,0:12:06.96,0:12:10.23,Default,,0,0,0,,Иә, мен күшейемін, әке.
Dialogue: 0,0:12:14.06,0:12:15.70,Default,,0,0,0,,Әке
Dialogue: 0,0:12:29.50,0:12:30.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:30.80,0:12:31.26,Default,,0,0,0,,Ах
Dialogue: 0,0:12:31.70,0:12:34.00,Default,,0,0,0,,Бұл үзіндінің соңы Батыс күмбезі ме?
Dialogue: 0,0:12:34.70,0:12:35.13,Default,,0,0,0,,Ах
Dialogue: 0,0:12:43.23,0:12:43.73,Default,,0,0,0,,Га
Dialogue: 0,0:12:46.93,0:12:49.33,Default,,0,0,0,,Жәндіктер адамдарды басқара ма?
Dialogue: 0,0:12:53.30,0:12:55.50,Default,,0,0,0,,Бәрі қайда?
Dialogue: 0,0:12:55.90,0:12:57.90,Default,,0,0,0,,Мен ешқашан жәндік шабуылдайды деп ойламадым.
Dialogue: 0,0:12:58.56,0:12:59.13,Default,,0,0,0,,Кетан
Dialogue: 0,0:12:59.50,0:12:59.96,Default,,0,0,0,,Әй
Dialogue: 0,0:13:00.70,0:13:01.63,Default,,0,0,0,,Сен тірісің бе?
Dialogue: 0,0:13:02.13,0:13:04.30,Default,,0,0,0,,Каэде-сан, қалғандары ше?
Dialogue: 0,0:13:04.83,0:13:08.96,Default,,0,0,0,,Ей, сендер де жақсысыңдар. Мен де жақсымын.
Dialogue: 0,0:13:09.60,0:13:10.73,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:11.23,0:13:14.66,Default,,0,0,0,,Күте тұрыңыз. Мен жәндіктерді қуу үшін синапс оқын қолданамын.
Dialogue: 0,0:13:15.20,0:13:17.16,Default,,0,0,0,,Тоқта, тым көп
Dialogue: 0,0:13:17.50,0:13:20.83,Default,,0,0,0,,Екі немесе үш синаптикалық оқ ештеңе істемейді.
Dialogue: 0,0:13:21.46,0:13:22.96,Default,,0,0,0,,Гельді ысырап етпеңіз
Dialogue: 0,0:13:23.60,0:13:25.63,Default,,0,0,0,,Сонда мен не істеуім керек?
Dialogue: 0,0:13:26.00,0:13:27.80,Default,,0,0,0,,Мен қазір бұл туралы ойлап отырмын.
Dialogue: 0,0:13:28.26,0:13:29.20,Default,,0,0,0,,жақсы
Dialogue: 0,0:13:29.80,0:13:30.26,Default,,0,0,0,,Га
Dialogue: 0,0:13:38.16,0:13:39.33,Default,,0,0,0,,Қазір мен ваннада шомылып жатырмын, шамамен 30 минуттан кейін бар.
Dialogue: 0,0:13:40.66,0:13:42.80,Default,,0,0,0,,Менің сүйкімді балаларым
Dialogue: 0,0:13:45.06,0:13:45.96,Default,,0,0,0,,Геркулес
Dialogue: 0,0:13:50.16,0:13:51.10,Default,,0,0,0,,Медуза
Dialogue: 0,0:13:52.76,0:13:53.93,Default,,0,0,0,,Және Икар
Dialogue: 0,0:13:55.80,0:13:59.23,Default,,0,0,0,,Ааааааааааааааааааааааааааааа
Dialogue: 0,0:14:00.60,0:14:03.60,Default,,0,0,0,,Бұл құбыжық әскерінің штабы ма?
Dialogue: 0,0:14:04.23,0:14:08.20,Default,,0,0,0,,Біздің жобаға кедергі келтіретіндердің барлығын жойыңыз.
Dialogue: 0,0:14:12.63,0:14:14.30,Default,,0,0,0,,Шие бақылауы
Dialogue: 0,0:14:18.63,0:14:20.16,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:14:20.90,0:14:22.13,Default,,0,0,0,,Аааааааааааааааааааааааа барлығы
Dialogue: 0,0:14:23.20,0:14:23.66,Default,,0,0,0,,Га
Dialogue: 0,0:14:26.53,0:14:28.13,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:14:31.06,0:14:31.66,Default,,0,0,0,,Кяаааааааааа
Dialogue: 0,0:14:31.83,0:14:33.46,Default,,0,0,0,,Хотата мырза Хиноки мырза
Dialogue: 0,0:14:37.26,0:14:38.26,Default,,0,0,0,,Біздің үмітіміз
Dialogue: 0,0:14:39.06,0:14:39.63,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:14:42.20,0:14:43.16,Default,,0,0,0,,Амал жоқ
Dialogue: 0,0:14:44.16,0:14:45.06,Default,,0,0,0,,Сіз оны пайдаланасыз ба?
Dialogue: 0,0:14:46.20,0:14:46.66,Default,,0,0,0,,Иә
Dialogue: 0,0:14:47.43,0:14:49.23,Default,,0,0,0,,Соңғы тұмандық жемісі
Dialogue: 0,0:14:50.56,0:14:52.33,Default,,0,0,0,,Іздегеніңізді осы жерден табуыңыз керек.
Dialogue: 0,0:14:53.26,0:14:54.66,Default,,0,0,0,,Қалғаны өзіңізге байланысты.
Dialogue: 0,0:14:55.83,0:14:56.53,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:09.06,0:15:09.66,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:10.80,0:15:11.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:16.80,0:15:19.03,Default,,0,0,0,,Беттерман Ламия
Dialogue: 0,0:15:19.76,0:15:21.86,Default,,0,0,0,,Шо Янаги
Dialogue: 0,0:15:22.43,0:15:24.30,Default,,0,0,0,,Неге, менің атым?
Dialogue: 0,0:15:24.93,0:15:27.10,Default,,0,0,0,,Мен Лимипид арнасында көремін.
Dialogue: 0,0:15:47.66,0:15:48.93,Default,,0,0,0,,Шие келе жатыр
Dialogue: 0,0:15:49.80,0:15:50.50,Default,,0,0,0,,Жалғау
Dialogue: 0,0:15:52.40,0:15:54.70,Default,,0,0,0,,Осыны орындайық.
Dialogue: 0,0:15:58.00,0:15:58.66,Default,,0,0,0,,Иә
Dialogue: 0,0:15:59.36,0:16:02.73,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:16:03.50,0:16:04.30,Default,,0,0,0,,Геге гуах
Dialogue: 0,0:16:12.33,0:16:12.83,Default,,0,0,0,,Жоқққ!
Dialogue: 0,0:16:13.23,0:16:15.06,Default,,0,0,0,,Әрқайсысы бір мезгілде жәндіктер
Dialogue: 0,0:16:15.50,0:16:18.70,Default,,0,0,0,,Олар ірі тіршілік иесінің жақсы ұйымдастырылған жасушалары ма?
Dialogue: 0,0:16:19.16,0:16:21.06,Default,,0,0,0,,Сен оны Каору-чанмен бұза алмайсың ба?
Dialogue: 0,0:16:21.90,0:16:24.53,Default,,0,0,0,,Мобильді құрылғылар үшін шек әлдеқашан асып кетті.
Dialogue: 0,0:16:25.03,0:16:26.73,Default,,0,0,0,,Менің өлгім келмейді
Dialogue: 0,0:16:31.10,0:16:32.00,Default,,0,0,0,,Увааааааааааааааааааа
Dialogue: 0,0:16:32.50,0:16:33.80,Default,,0,0,0,,Кяаааааааааа
Dialogue: 0,0:16:43.90,0:16:48.13,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:16:48.73,0:16:49.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:52.60,0:16:53.03,Default,,0,0,0,,Ах
Dialogue: 0,0:17:01.93,0:17:02.43,Default,,0,0,0,,Иә
Dialogue: 0,0:17:06.50,0:17:07.00,Default,,0,0,0,,Ах
Dialogue: 0,0:17:18.23,0:17:18.76,Default,,0,0,0,,Міне келдік
Dialogue: 0,0:17:19.26,0:17:20.10,Default,,0,0,0,,Беттерман
Dialogue: 0,0:17:25.60,0:17:26.26,Default,,0,0,0,,Тұмандық
Dialogue: 0,0:17:35.76,0:17:38.16,Default,,0,0,0,,Ооо, бұл керемет
Dialogue: 0,0:17:39.00,0:17:41.46,Default,,0,0,0,,Беттерменнің ауадағы қозғалғыштық формасы?
Dialogue: 0,0:17:42.76,0:17:44.96,Default,,0,0,0,,Икар, сен оны қолға ал.
Dialogue: 0,0:17:54.76,0:17:58.86,Default,,0,0,0,,Ей, эй, егер Беттерман келсе, біз жеңдік.
Dialogue: 0,0:18:06.56,0:18:07.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:08.93,0:18:09.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:12.86,0:18:14.53,Default,,0,0,0,,Келіңіз, доктор Цуко.
Dialogue: 0,0:18:14.93,0:18:17.63,Default,,0,0,0,,-Сен менің қол-аяғың болып жұмыс істегенімді қалайсың ба? -Ах!
Dialogue: 0,0:18:18.53,0:18:22.53,Default,,0,0,0,,Уайымдамаңыз, сіздің ерік-жігеріңіз жақын арада жоғалады.
Dialogue: 0,0:18:22.83,0:18:24.50,Default,,0,0,0,,Хехехехе хахахахаха
Dialogue: 0,0:18:24.53,0:18:25.06,Default,,0,0,0,,Хааааааааааааааааааааааа
Dialogue: 0,0:18:27.80,0:18:31.73,Default,,0,0,0,,А-а-а-а-а-а-а-а
Dialogue: 0,0:18:32.26,0:18:35.93,Default,,0,0,0,,Уф-а-а-а
Dialogue: 0,0:18:36.16,0:18:37.63,Default,,0,0,0,,А, мен оны жек көремін.
Dialogue: 0,0:18:37.86,0:18:40.93,Default,,0,0,0,,Имплант сіздің аузыңызға түседі.
Dialogue: 0,0:18:41.56,0:18:45.20,Default,,0,0,0,,Арнайы нейротоксинмен миыңызды робот маған айналдырыңыз.
Dialogue: 0,0:18:45.66,0:18:48.30,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:48.46,0:18:52.20,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:18:52.96,0:18:53.43,Default,,0,0,0,,Уф
Dialogue: 0,0:18:53.80,0:18:54.26,Default,,0,0,0,,Уф
Dialogue: 0,0:18:54.93,0:18:56.76,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:19:13.56,0:19:14.06,Default,,0,0,0,,Га
Dialogue: 0,0:19:14.53,0:19:15.10,Default,,0,0,0,,Асами-сан
Dialogue: 0,0:19:16.80,0:19:17.43,Default,,0,0,0,,Ах ха
Dialogue: 0,0:19:21.63,0:19:23.30,Default,,0,0,0,,...
Dialogue: 0,0:19:23.96,0:19:26.36,Default,,0,0,0,,Кешіріңіз, мен кешігіп қалдым, Асами-сан.
Dialogue: 0,0:19:26.63,0:19:28.40,Default,,0,0,0,,Ха, ха, Янаги-кун
Dialogue: 0,0:19:29.03,0:19:31.90,Default,,0,0,0,,Рахмет, рахмет
Dialogue: 0,0:19:32.46,0:19:33.80,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:34.00,0:19:36.56,Default,,0,0,0,,Имплантатымды бейтараптандыру деген нені білдіреді?
Dialogue: 0,0:19:36.86,0:19:38.93,Default,,0,0,0,,Қандай сиқырлы амалды қолдандың?
Dialogue: 0,0:19:39.83,0:19:41.53,Default,,0,0,0,,Сіз доктор Умезакисіз, солай ма?
Dialogue: 0,0:19:42.23,0:19:42.96,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:43.40,0:19:46.60,Default,,0,0,0,,Біз де Беттерманның пайда болуымен айналысып жатырмыз.
Dialogue: 0,0:19:47.30,0:19:49.20,Default,,0,0,0,,Балалар, уайымдауға уақыт жоқ.
Dialogue: 0,0:19:50.56,0:19:52.30,Default,,0,0,0,,Беттермен туралы білесіз бе?
Dialogue: 0,0:19:53.23,0:19:54.66,Default,,0,0,0,,Асами-сан, бұл жерден кетейік.
Dialogue: 0,0:19:55.06,0:19:55.53,Default,,0,0,0,,Иә
Dialogue: 0,0:20:02.20,0:20:04.40,Default,,0,0,0,,Каэде-сан, №.
Dialogue: 0,0:20:05.03,0:20:06.23,Default,,0,0,0,,Мен қазірдің өзінде
Dialogue: 0,0:20:09.26,0:20:09.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:10.73,0:20:13.56,Default,,0,0,0,,Сәттілік Шие, синаптикалық оқтар!
Dialogue: 0,0:20:14.33,0:20:17.26,Default,,0,0,0,,Менің қолымнан келмейді, бұл ауырады.
Dialogue: 0,0:20:18.13,0:20:19.93,Default,,0,0,0,,Өйткені ха!
Dialogue: 0,0:20:22.83,0:20:23.73,Default,,0,0,0,,Каэде-сан
Dialogue: 0,0:20:23.96,0:20:24.60,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:25.26,0:20:26.80,Default,,0,0,0,,Мен дауысты естимін
Dialogue: 0,0:20:27.30,0:20:29.23,Default,,0,0,0,,Янаги және Асами мырза
Dialogue: 0,0:20:30.10,0:20:32.33,Default,,0,0,0,,Сол ғимаратта
Dialogue: 0,0:20:33.00,0:20:35.20,Default,,0,0,0,,Шие Ұлы Шо
Dialogue: 0,0:20:46.53,0:20:47.43,Default,,0,0,0,,Ха ха
Dialogue: 0,0:20:47.63,0:20:48.16,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:20:48.86,0:20:51.76,Default,,0,0,0,,Бұл орталық күмбез. Жерге шығатын жол болуы керек.
Dialogue: 0,0:20:53.43,0:20:55.26,Default,,0,0,0,,Хаа ха ха
Dialogue: 0,0:20:55.60,0:20:56.40,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:20:56.43,0:20:58.46,Default,,0,0,0,,Хаа ха ха ха жарайды
Dialogue: 0,0:20:59.33,0:20:59.93,Default,,0,0,0,,Уау
Dialogue: 0,0:21:05.13,0:21:05.70,Default,,0,0,0,,Тиран
Dialogue: 0,0:21:07.03,0:21:09.96,Default,,0,0,0,,Шо: Асами-сан да аман қалды.
Dialogue: 0,0:21:10.56,0:21:11.23,Default,,0,0,0,,Каэде
Dialogue: 0,0:21:11.50,0:21:12.36,Default,,0,0,0,,Сакора-чан
Dialogue: 0,0:21:12.86,0:21:15.60,Default,,0,0,0,,Тезірек, қателер келеді!
Dialogue: 0,0:21:25.43,0:21:27.06,Default,,0,0,0,,Қоңыздар жинағы?
Dialogue: 0,0:21:27.70,0:21:29.23,Default,,0,0,0,,Келесі жолы мен осы жерден кетемін.
Dialogue: 0,0:21:46.33,0:21:48.83,Default,,0,0,0,,Ораааааааааааааааааааааааааа
Dialogue: 0,0:21:51.86,0:21:52.66,Default,,0,0,0,,Тахахаха
Dialogue: 0,0:21:53.16,0:21:54.60,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,0:21:54.93,0:21:57.16,Default,,0,0,0,,Өйткені, синапсты бомбалау жалғыз нұсқа.
Dialogue: 0,0:21:58.46,0:22:00.10,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:22:01.66,0:22:02.16,Default,,0,0,0,,Жоқққ!
Dialogue: 0,0:22:09.20,0:22:10.66,Default,,0,0,0,,Ммм
Dialogue: 0,0:22:11.63,0:22:12.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:27.90,0:22:29.03,Default,,0,0,0,,Жақсы жақсы
Dialogue: 0,0:22:34.53,0:22:47.10,Default,,0,0,0,,Құдайдың күнәсі шексіз теломерлерге жазылды
Dialogue: 0,0:22:47.80,0:22:53.96,Default,,0,0,0,,Жалынды құшақтап алу
Dialogue: 0,0:22:54.56,0:23:01.53,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:01.80,0:23:04.96,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.33,0:23:08.53,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.70,0:23:11.96,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.26,0:23:15.46,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.33,0:23:26.93,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:27.53,0:23:37.46,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:37.83,0:23:48.80,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:59.03,0:24:01.80,Default,,0,0,0,,Балдың иісіне мас болған
Dialogue: 0,0:24:02.70,0:24:05.63,Default,,0,0,0,,Айналып, айналады.
Dialogue: 0,0:24:06.66,0:24:09.00,Default,,0,0,0,,көңілді күлкілі
Dialogue: 0,0:24:09.46,0:24:12.06,Default,,0,0,0,,бақытты азапты
Dialogue: 0,0:24:13.16,0:24:15.66,Default,,0,0,0,,Ауырады. Ол аурады.
Dialogue: 0,0:24:16.13,0:24:18.63,Default,,0,0,0,,Ауыртады Ауыртады
Dialogue: 0,0:24:20.10,0:24:21.96,Default,,0,0,0,,Сіздің жалаңаш теріңіз
Dialogue: 0,0:24:22.76,0:24:24.13,Default,,0,0,0,,Сыртып алыңыз
Dialogue: 0,0:24:25.63,0:24:31.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
