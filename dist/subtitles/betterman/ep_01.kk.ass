Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.83,0:00:17.03,Default,,0,0,0,,Оны тез табыңыз
Dialogue: 0,0:00:21.63,0:00:26.46,Default,,0,0,0,,Қазір табыңыз
Dialogue: 0,0:00:28.83,0:00:32.10,Default,,0,0,0,,Ха ха ха ха ха ха ха
Dialogue: 0,0:00:36.36,0:00:37.90,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:00:37.96,0:00:38.80,Default,,0,0,0,,Қараңғылық…
Dialogue: 0,0:00:41.66,0:00:51.16,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:00:53.76,0:01:01.63,Default,,0,0,0,,Күміс қайықтың жүзуі
Dialogue: 0,0:01:03.60,0:01:12.13,Default,,0,0,0,,Аты белгісіз адамдар
Dialogue: 0,0:01:15.56,0:01:23.36,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:01:26.66,0:01:35.40,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:01:35.73,0:01:43.90,Default,,0,0,0,,Жанға бағыт беру
Dialogue: 0,0:01:45.86,0:01:55.30,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:01:55.66,0:02:07.00,Default,,0,0,0,,Ағып жатқанда қозғалмаңыз...
Dialogue: 0,0:02:15.66,0:02:17.13,Default,,0,0,0,,Хмм?
Dialogue: 0,0:02:18.36,0:02:19.86,Default,,0,0,0,,...
Dialogue: 0,0:02:22.16,0:02:22.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:32.56,0:02:34.16,Default,,0,0,0,,Не?
Dialogue: 0,0:02:42.06,0:02:47.13,Default,,0,0,0,,Ммм
Dialogue: 0,0:02:48.06,0:02:49.20,Default,,0,0,0,,5 минут қалды
Dialogue: 0,0:02:56.06,0:02:58.60,Default,,0,0,0,,Уау...
Dialogue: 0,0:03:00.33,0:03:01.66,Default,,0,0,0,,Уау аааа
Dialogue: 0,0:03:01.76,0:03:05.06,Default,,0,0,0,,Әлемнің төменгі жағында, жер астындағы 200 метрлік үлкен ойын-сауық саябағы
Dialogue: 0,0:03:05.30,0:03:06.80,Default,,0,0,0,,Ақырында ертең ашылады
Dialogue: 0,0:03:06.86,0:03:09.76,Default,,0,0,0,,Чика-чан да күтіп тұр.
Dialogue: 0,0:03:17.46,0:03:19.20,Default,,0,0,0,,Ей, кешігіп қалдың.
Dialogue: 0,0:03:22.46,0:03:24.10,Default,,0,0,0,,Тезірек май толтырыңыз! ! !
Dialogue: 0,0:03:26.60,0:03:28.90,Default,,0,0,0,,Уау, уау
Dialogue: 0,0:03:29.13,0:03:32.26,Default,,0,0,0,,Әй, уау, уау!
Dialogue: 0,0:03:36.46,0:03:39.70,Default,,0,0,0,,Эй, эй, бұл жақсы. Мұғалім әлі сонда ма?
Dialogue: 0,0:03:39.96,0:03:42.90,Default,,0,0,0,,Әй, Кейта, ауысатын студент келе жатқан сияқты.
Dialogue: 0,0:03:43.20,0:03:43.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:43.90,0:03:47.43,Default,,0,0,0,,Ол әйел екен деген қауесет бар. Ол ұсқынсыз емес деп үміттенемін.
Dialogue: 0,0:03:47.93,0:03:51.06,Default,,0,0,0,,Уши, сен тағы бір тентек нәрсені ойлап жүрген шығарсың.
Dialogue: 0,0:03:51.10,0:03:53.33,Default,,0,0,0,,Теттетте фью
Dialogue: 0,0:03:53.63,0:03:55.63,Default,,0,0,0,,О, міне, Кейта келдік
Dialogue: 0,0:03:55.66,0:03:56.36,Default,,0,0,0,,Ой
Dialogue: 0,0:03:57.36,0:03:58.33,Default,,0,0,0,,Хью
Dialogue: 0,0:04:00.96,0:04:01.43,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:04:04.03,0:04:04.66,Default,,0,0,0,,О
Dialogue: 0,0:04:09.90,0:04:10.60,Default,,0,0,0,,К-чан
Dialogue: 0,0:04:11.36,0:04:12.26,Default,,0,0,0,,К-чан
Dialogue: 0,0:04:12.63,0:04:13.86,Default,,0,0,0,,К-чан
Dialogue: 0,0:04:14.33,0:04:15.83,Default,,0,0,0,,К-чан
Dialogue: 0,0:04:16.00,0:04:16.56,Default,,0,0,0,,Ах
Dialogue: 0,0:04:16.76,0:04:17.46,Default,,0,0,0,,Хиноки
Dialogue: 0,0:04:35.83,0:04:38.66,Default,,0,0,0,,Олардың ашылу салтанатына дайындалып жатқанын естідім.
Dialogue: 0,0:04:39.10,0:04:41.06,Default,,0,0,0,,200-ден астам адам бар, солай ма?
Dialogue: 0,0:04:41.90,0:04:45.60,Default,,0,0,0,,Кейбір Буддалардың жарақаттары жоқ, ал басқалары ұсақталған.
Dialogue: 0,0:04:46.33,0:04:50.83,Default,,0,0,0,,Ауруханаға 42 аман қалған адам түсті. Олармен танысқыңыз келе ме?
Dialogue: 0,0:04:51.40,0:04:53.63,Default,,0,0,0,,Инспектор, маман келді.
Dialogue: 0,0:04:53.86,0:04:54.43,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:01.20,0:05:02.03,Default,,0,0,0,,Не, эй?
Dialogue: 0,0:05:02.66,0:05:03.26,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:05:04.06,0:05:07.83,Default,,0,0,0,,Өткен деректердің шамамен 40% Mordywarp құрастырған
Dialogue: 0,0:05:08.20,0:05:09.16,Default,,0,0,0,,Олар сәйкес келеді.
Dialogue: 0,0:05:12.73,0:05:15.06,Default,,0,0,0,,Бұл сөзсіз Алджернон сияқты.
Dialogue: 0,0:05:15.80,0:05:17.90,Default,,0,0,0,,үшінңыз тез эвакуациялаңыздар.
Dialogue: 0,0:05:18.33,0:05:19.96,Default,,0,0,0,,Бұл жай ғана оқыс оқиға емес
Dialogue: 0,0:05:20.66,0:05:23.20,Default,,0,0,0,,Ішке кірген Өзін-өзі қорғау күштерімен не істейсіз?
Dialogue: 0,0:05:24.10,0:05:26.43,Default,,0,0,0,,тым кеш шығар
Dialogue: 0,0:05:26.90,0:05:28.36,Default,,0,0,0,,Хинокиге қоңырау шалуым керек пе?
Dialogue: 0,0:05:28.96,0:05:29.86,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:31.76,0:05:32.40,Default,,0,0,0,,Қайдан келдің?
Dialogue: 0,0:05:32.80,0:05:33.73,Default,,0,0,0,,Сәл артқа шегініңіз.
Dialogue: 0,0:05:33.93,0:05:36.70,Default,,0,0,0,,Мені есіңе түсірдің, Кейта, солай ма?
Dialogue: 0,0:05:37.10,0:05:37.53,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:05:40.43,0:05:40.90,Default,,0,0,0,,Иә
Dialogue: 0,0:05:45.96,0:05:46.46,Default,,0,0,0,,Иә
Dialogue: 0,0:05:47.83,0:05:50.10,Default,,0,0,0,,-Кешіріңіз. -Ааа.
Dialogue: 0,0:05:51.23,0:05:53.43,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:05:54.60,0:05:58.56,Default,,0,0,0,,Ертең ашылуы жоспарланған Әлемнің түбіндегі апат,
Dialogue: 0,0:05:58.73,0:06:01.80,Default,,0,0,0,,Қазіргі уақытта полиция мен өзін-өзі қорғау күштері тергеу жүргізіп жатыр.
Dialogue: 0,0:06:02.00,0:06:03.83,Default,,0,0,0,,Мәліметтер әлі жарияланған жоқ
Dialogue: 0,0:06:04.96,0:06:07.20,Default,,0,0,0,,Әй, ауысатын студент үйге келеді!
Dialogue: 0,0:06:07.26,0:06:07.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:11.23,0:06:13.00,Default,,0,0,0,,Сіз қозғалыстың ортасындасыз ба?
Dialogue: 0,0:06:19.60,0:06:21.63,Default,,0,0,0,,...
Dialogue: 0,0:06:23.06,0:06:26.50,Default,,0,0,0,,Тіркеме үшінші жертөле қабатына келді. Өтінемін, алға.
Dialogue: 0,0:06:32.33,0:06:35.56,Default,,0,0,0,,Ахх, мен суланып бара жатырмын.
Dialogue: 0,0:06:35.63,0:06:38.23,Default,,0,0,0,,...
Dialogue: 0,0:06:38.36,0:06:40.36,Default,,0,0,0,,Вататата және oh-e-na
Dialogue: 0,0:06:41.53,0:06:44.73,Default,,0,0,0,,Аа, бүгін жаман күн. Хаа.
Dialogue: 0,0:06:45.00,0:06:47.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:58.16,0:07:02.56,Default,,0,0,0,,Ах, әлем түбі, олар апатқа байланысты жабылғанын айтты.
Dialogue: 0,0:07:03.63,0:07:05.73,Default,,0,0,0,,Бұл қақпа ашық.
Dialogue: 0,0:07:07.83,0:07:10.53,Default,,0,0,0,,Ешкім жоқ па?
Dialogue: 0,0:07:11.40,0:07:14.46,Default,,0,0,0,,Чика-чан қатты әсер етті!
Dialogue: 0,0:07:14.50,0:07:14.93,Default,,0,0,0,,Уф
Dialogue: 0,0:07:14.96,0:07:17.86,Default,,0,0,0,,Алдыңғы және артқы жағында болғанымен, дененің қай бөлігі ішкі деп аталады?
Dialogue: 0,0:07:18.00,0:07:18.50,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:18.53,0:07:22.03,Default,,0,0,0,,3 2 1 0 Боу! Жауап - сіздің асқазаныңыз бен арқаңыз.
Dialogue: 0,0:07:22.43,0:07:26.23,Default,,0,0,0,,-Сен тозаққа барасың!
Dialogue: 0,0:07:26.26,0:07:27.33,Default,,0,0,0,,Не?
Dialogue: 0,0:07:27.56,0:07:30.33,Default,,0,0,0,,Әй, күт, күт, күт, не болады?
Dialogue: 0,0:07:30.36,0:07:34.96,Default,,0,0,0,,Жақсы, ой, ой, ой, ой, ой
Dialogue: 0,0:07:35.00,0:07:37.36,Default,,0,0,0,,Ух эй эй эй эй ей нн
Dialogue: 0,0:07:37.50,0:07:41.46,Default,,0,0,0,,Hohohohohohohohohohohohohohohoho
Dialogue: 0,0:07:44.56,0:07:47.60,Default,,0,0,0,,Нггааахххх
Dialogue: 0,0:07:48.70,0:07:49.30,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:07:53.83,0:07:55.86,Default,,0,0,0,,Эй
Dialogue: 0,0:07:57.66,0:07:59.53,Default,,0,0,0,,Кең
Dialogue: 0,0:07:59.96,0:08:02.70,Default,,0,0,0,,Жер астында көп жер бар.
Dialogue: 0,0:08:04.06,0:08:04.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.20,0:08:11.76,Default,,0,0,0,,фуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуф
Dialogue: 0,0:08:16.70,0:08:17.26,Default,,0,0,0,,Угігіи
Dialogue: 0,0:08:24.36,0:08:28.60,Default,,0,0,0,,Уваа аа
Dialogue: 0,0:08:28.80,0:08:29.36,Default,,0,0,0,,Уф
Dialogue: 0,0:08:29.90,0:08:31.70,Default,,0,0,0,,Ааа... уф
Dialogue: 0,0:08:32.93,0:08:33.43,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:08:35.13,0:08:39.73,Default,,0,0,0,,Ах ха ха ха ха ха
Dialogue: 0,0:08:40.46,0:08:42.40,Default,,0,0,0,,Бұл адам емес.
Dialogue: 0,0:08:43.23,0:08:44.46,Default,,0,0,0,,Хиккинн
Dialogue: 0,0:08:46.23,0:08:47.73,Default,,0,0,0,,Жау жақындап келеді.
Dialogue: 0,0:08:50.06,0:08:50.86,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:08:52.80,0:08:54.63,Default,,0,0,0,,...
Dialogue: 0,0:09:04.80,0:09:05.73,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:06.20,0:09:08.13,Default,,0,0,0,,Хаа
Dialogue: 0,0:09:11.30,0:09:11.86,Default,,0,0,0,,Ах
Dialogue: 0,0:09:12.53,0:09:13.60,Default,,0,0,0,,...
Dialogue: 0,0:09:24.63,0:09:25.16,Default,,0,0,0,,Хиноки?
Dialogue: 0,0:09:29.10,0:09:30.70,Default,,0,0,0,,Хиноки емес
Dialogue: 0,0:09:40.00,0:09:40.50,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:09:41.83,0:09:43.06,Default,,0,0,0,,О
Dialogue: 0,0:09:45.03,0:09:46.40,Default,,0,0,0,,Аа, бұл
Dialogue: 0,0:09:48.00,0:09:49.50,Default,,0,0,0,,Сіз ауыратын нәрсе жасайсыз ба?
Dialogue: 0,0:09:49.83,0:09:52.90,Default,,0,0,0,,Иә? Жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:09:53.20,0:09:56.93,Default,,0,0,0,,Мен жаңа ғана өтіп бара жатқан жоғары сынып оқушысымын.
Dialogue: 0,0:09:57.83,0:09:59.00,Default,,0,0,0,,Жоғары сынып оқушылары
Dialogue: 0,0:09:59.63,0:10:03.70,Default,,0,0,0,,Бұл керемет, ең заманауи әскери басқару жүйесі сияқты.
Dialogue: 0,0:10:04.56,0:10:07.56,Default,,0,0,0,,А-а, мен мұны қалай аламын?
Dialogue: 0,0:10:08.26,0:10:09.50,Default,,0,0,0,,Оны қабылдамаңыз.
Dialogue: 0,0:10:09.73,0:10:10.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:15.96,0:10:18.60,Default,,0,0,0,,Ха, жоқ, бұл.
Dialogue: 0,0:10:19.43,0:10:21.56,Default,,0,0,0,,Тез қашып кеткеніңіз жөн.
Dialogue: 0,0:10:21.96,0:10:23.73,Default,,0,0,0,,Өйткені көп адам өлді
Dialogue: 0,0:10:23.86,0:10:24.83,Default,,0,0,0,,Сен өлдің бе?
Dialogue: 0,0:10:25.66,0:10:27.70,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:10:27.96,0:10:30.06,Default,,0,0,0,,Мен бұған жақсымын.
Dialogue: 0,0:10:30.53,0:10:33.33,Default,,0,0,0,,Мазалағаныңызға рахмет.
Dialogue: 0,0:10:33.53,0:10:37.30,Default,,0,0,0,,Жоқ, жоқ, о, онда мен барамын.
Dialogue: 0,0:10:37.70,0:10:38.20,Default,,0,0,0,,Иә
Dialogue: 0,0:10:38.66,0:10:40.16,Default,,0,0,0,,Сау болыңыз.
Dialogue: 0,0:10:43.00,0:10:47.16,Default,,0,0,0,,А?
Dialogue: 0,0:10:47.33,0:10:51.00,Default,,0,0,0,,Сәлеметсіз бе? Әй, эй, эй, сәл күте тұрыңыз, күтіңіз, уау!
Dialogue: 0,0:10:51.13,0:10:54.66,Default,,0,0,0,,О, ой, ой, барамын, барамын.
Dialogue: 0,0:10:55.00,0:10:55.43,Default,,0,0,0,,Уф
Dialogue: 0,0:11:06.73,0:11:08.00,Default,,0,0,0,,Уау
Dialogue: 0,0:11:08.70,0:11:10.76,Default,,0,0,0,,Хи хи хи хаа
Dialogue: 0,0:11:12.06,0:11:15.13,Default,,0,0,0,,Да-да-да-да-да-до-до-да-да-да-ааа
Dialogue: 0,0:11:15.60,0:11:17.86,Default,,0,0,0,,Йотто хихи йоша
Dialogue: 0,0:11:17.93,0:11:20.80,Default,,0,0,0,,А-а-а
Dialogue: 0,0:11:20.96,0:11:25.36,Default,,0,0,0,,Ах чо чо чо чо чо чо ах иә иә
Dialogue: 0,0:11:25.40,0:11:27.96,Default,,0,0,0,,Гагагага…
Dialogue: 0,0:11:28.06,0:11:31.16,Default,,0,0,0,,Ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха .
Dialogue: 0,0:11:34.46,0:11:35.86,Default,,0,0,0,,Таа
Dialogue: 0,0:11:36.40,0:11:40.20,Default,,0,0,0,,Таа
Dialogue: 0,0:11:40.63,0:11:41.96,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:11:43.46,0:11:43.96,Default,,0,0,0,,Әу
Dialogue: 0,0:11:45.20,0:11:49.13,Default,,0,0,0,,Гухаа
Dialogue: 0,0:11:56.10,0:11:57.13,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:11:58.70,0:12:01.03,Default,,0,0,0,,Жер асты қабатынан байланыс мүмкін емес
Dialogue: 0,0:12:01.26,0:12:04.10,Default,,0,0,0,,Бірде-бір адам қайтып келген жоқ.
Dialogue: 0,0:12:10.56,0:12:11.40,Default,,0,0,0,,Ке-чан?
Dialogue: 0,0:12:15.40,0:12:17.83,Default,,0,0,0,,Ура
Dialogue: 0,0:12:23.63,0:12:26.60,Default,,0,0,0,,Бортта біреу бар ма? Ол әскери мақсатқа арналған ба?
Dialogue: 0,0:12:27.03,0:12:28.90,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:12:29.63,0:12:30.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:32.13,0:12:34.20,Default,,0,0,0,,бір нәрсе жақындады
Dialogue: 0,0:12:34.83,0:12:35.30,Default,,0,0,0,,Га
Dialogue: 0,0:12:35.96,0:12:37.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:37.46,0:12:40.13,Default,,0,0,0,,-Уау! -Ха!
Dialogue: 0,0:12:40.53,0:12:42.80,Default,,0,0,0,,Оянған адамның түнде көру аймағы іске қосылды
Dialogue: 0,0:12:43.33,0:12:44.90,Default,,0,0,0,,Мына қара тұман деген не?
Dialogue: 0,0:12:45.33,0:12:47.90,Default,,0,0,0,,Ингредиент графигінде уыттылық жоқ.
Dialogue: 0,0:12:48.16,0:12:50.86,Default,,0,0,0,,Атрак үшін қара түтін емес пе?
Dialogue: 0,0:12:51.23,0:12:53.23,Default,,0,0,0,,Хиноки кактусына не болды?
Dialogue: 0,0:12:53.63,0:12:57.03,Default,,0,0,0,,Мен қатты күліп шықтым.
Dialogue: 0,0:12:57.70,0:12:58.90,Default,,0,0,0,,Ол шықты ма?
Dialogue: 0,0:13:00.70,0:13:04.33,Default,,0,0,0,,Соңғы деректер бойынша дофамин қалыптыдан 20 есе көп.
Dialogue: 0,0:13:04.83,0:13:07.86,Default,,0,0,0,,Иммундық функция 34%-ға төмендеді.
Dialogue: 0,0:13:08.53,0:13:09.66,Default,,0,0,0,,Алджернон?
Dialogue: 0,0:13:10.20,0:13:11.16,Default,,0,0,0,,100% дерлік
Dialogue: 0,0:13:11.46,0:13:13.93,Default,,0,0,0,,Неліктен манипуляциялық қорап бар?
Dialogue: 0,0:13:14.23,0:13:18.10,Default,,0,0,0,,Бұл Barrier-kun One-Seven сияқты иондық қалқанмен байланысты.
Dialogue: 0,0:13:18.73,0:13:19.60,Default,,0,0,0,,Бұл ғана емес
Dialogue: 0,0:13:19.90,0:13:23.96,Default,,0,0,0,,Ол менің амулет костюмім сияқты қорғаныс функциясына ие болуы керек.
Dialogue: 0,0:13:24.33,0:13:25.20,Default,,0,0,0,,Секір!!
Dialogue: 0,0:13:25.53,0:13:28.03,Default,,0,0,0,,Нейроноидқа отырар алдында да болар.
Dialogue: 0,0:13:28.16,0:13:31.36,Default,,0,0,0,,Оны Альжернон жұқтырған болуы керек.
Dialogue: 0,0:13:31.96,0:13:35.13,Default,,0,0,0,,Не істеу керек? Егер бұл жай Хиноки болса, оянған адамдар қозғалмайды.
Dialogue: 0,0:13:35.50,0:13:37.26,Default,,0,0,0,,Екінші реттік апаттар қаупі де бар
Dialogue: 0,0:13:37.86,0:13:40.43,Default,,0,0,0,,Микросынықтарды бәрібір өлшеңіз
Dialogue: 0,0:13:40.86,0:13:43.40,Default,,0,0,0,,Одан кейін техникалық қызмет көрсететін таспаны төменгі қабатқа түсіріңіз.
Dialogue: 0,0:13:43.46,0:13:45.43,Default,,0,0,0,,Осылай кешіктірсеңіз, уақытында үлгересіз бе?
Dialogue: 0,0:13:45.73,0:13:46.96,Default,,0,0,0,,Өзіңізден озып кетпеңіз
Dialogue: 0,0:13:47.33,0:13:49.76,Default,,0,0,0,,Абайсыз әрекет етсең, бәрі өледі.
Dialogue: 0,0:13:49.93,0:13:50.93,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:13:51.06,0:13:52.30,Default,,0,0,0,,Бұл да өткен деректер ме?
Dialogue: 0,0:13:52.70,0:13:53.13,Default,,0,0,0,,Иә
Dialogue: 0,0:13:54.80,0:13:57.03,Default,,0,0,0,,Чика-чан қатты әсер етті!
Dialogue: 0,0:13:57.10,0:13:58.73,Default,,0,0,0,,-Уау ааа -ухх
Dialogue: 0,0:13:58.80,0:14:01.53,Default,,0,0,0,,Хахахаха Ахахахаха Ахахахха
Dialogue: 0,0:14:01.56,0:14:02.86,Default,,0,0,0,,-Ээхи -Ууу
Dialogue: 0,0:14:04.56,0:14:05.60,Default,,0,0,0,,Суық
Dialogue: 0,0:14:08.10,0:14:10.30,Default,,0,0,0,,-хахахаха -хии
Dialogue: 0,0:14:10.66,0:14:15.63,Default,,0,0,0,,Ааа
Dialogue: 0,0:14:16.26,0:14:18.90,Default,,0,0,0,,Хихихи аа
Dialogue: 0,0:14:19.16,0:14:22.20,Default,,0,0,0,,Уф, мен мұны енді қаламаймын.
Dialogue: 0,0:14:22.46,0:14:25.70,Default,,0,0,0,,Сәлем Сәлем Сәлем Сәлем Ха Ха Ха
Dialogue: 0,0:14:26.30,0:14:27.10,Default,,0,0,0,,Акамацу мырза
Dialogue: 0,0:14:27.50,0:14:28.06,Default,,0,0,0,,Не?
Dialogue: 0,0:14:28.56,0:14:30.93,Default,,0,0,0,,Мен жаңа ғана сыныптасымды кездестірдім.
Dialogue: 0,0:14:30.96,0:14:31.53,Default,,0,0,0,,Хиноки
Dialogue: 0,0:14:31.66,0:14:32.13,Default,,0,0,0,,Ах
Dialogue: 0,0:14:32.86,0:14:33.53,Default,,0,0,0,,болып табылады
Dialogue: 0,0:14:34.30,0:14:35.13,Default,,0,0,0,,К-чан
Dialogue: 0,0:14:35.16,0:14:37.50,Default,,0,0,0,,Бұл Хиноки, өте жақсы!
Dialogue: 0,0:14:37.83,0:14:42.36,Default,,0,0,0,,Дұрыс, мен кішкентай кезімде Хиноки мені Ке Чан деп атайтын.
Dialogue: 0,0:14:42.56,0:14:45.50,Default,,0,0,0,,Сол жерде болыңыз Серибхед рок
Dialogue: 0,0:14:46.06,0:14:47.96,Default,,0,0,0,,Не? Ааа
Dialogue: 0,0:14:51.30,0:14:52.40,Default,,0,0,0,,Кактус қайтып келді
Dialogue: 0,0:14:52.80,0:14:56.76,Default,,0,0,0,,Жоқ, жоқ, бұл жігіт адам шығар.
Dialogue: 0,0:14:57.33,0:15:01.13,Default,,0,0,0,,Уау, роботтың іші осындай.
Dialogue: 0,0:15:02.43,0:15:04.33,Default,,0,0,0,,Уф, эй
Dialogue: 0,0:15:06.53,0:15:08.23,Default,,0,0,0,,Каппа-кун?
Dialogue: 0,0:15:08.56,0:15:10.86,Default,,0,0,0,,Жарайды, ол өте берік.
Dialogue: 0,0:15:12.06,0:15:12.56,Default,,0,0,0,,Га
Dialogue: 0,0:15:13.73,0:15:14.80,Default,,0,0,0,,Мен енді сол қателігімді қайталамаймын.
Dialogue: 0,0:15:15.53,0:15:18.13,Default,,0,0,0,,Мен енді сол қателігімді қайталамаймын.
Dialogue: 0,0:15:19.96,0:15:23.70,Default,,0,0,0,,Уф, Хиноки, мен мұны қалай басқарамын?
Dialogue: 0,0:15:23.90,0:15:25.23,Default,,0,0,0,,Бұл қарапайым адамдар үшін мүмкін емес.
Dialogue: 0,0:15:25.73,0:15:30.10,Default,,0,0,0,,«Мен мұны істей алмаймын». Осылай жалғаса берсе, ішім тесіліп қалатын сияқты.
Dialogue: 0,0:15:30.40,0:15:34.10,Default,,0,0,0,,Бұл робот өзін-өзі қорғау күштері үшін өте құпия қару емес пе?
Dialogue: 0,0:15:34.13,0:15:39.06,Default,,0,0,0,,Уф, уау, жиіркенішті, былғары, уау.
Dialogue: 0,0:15:40.73,0:15:41.40,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:44.33,0:15:45.90,Default,,0,0,0,,Қос импульс соншалықты көп
Dialogue: 0,0:15:47.10,0:15:49.06,Default,,0,0,0,,Серіп басына кім мінеді?
Dialogue: 0,0:15:51.86,0:15:52.46,Default,,0,0,0,,бірақ көзге ілеспейтіндей жылдам
Dialogue: 0,0:15:53.50,0:15:54.10,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:54.66,0:15:55.26,Default,,0,0,0,,Ояну
Dialogue: 0,0:15:58.03,0:15:59.23,Default,,0,0,0,,Қозғалыс тоқтады.
Dialogue: 0,0:15:59.53,0:16:00.63,Default,,0,0,0,,Біздің күштеріміздің бұйрығы бойынша, сені ұрлап әкетуге келдім
Dialogue: 0,0:16:01.40,0:16:03.43,Default,,0,0,0,,Менің иығыма жабысып қалды!
Dialogue: 0,0:16:05.93,0:16:08.20,Default,,0,0,0,,Ууу
Dialogue: 0,0:16:09.03,0:16:10.66,Default,,0,0,0,,Ууу
Dialogue: 0,0:16:11.13,0:16:12.13,Default,,0,0,0,,Ууу
Dialogue: 0,0:16:17.66,0:16:19.60,Default,,0,0,0,,Ғажайып күш
Dialogue: 0,0:16:20.90,0:16:21.46,Default,,0,0,0,,Эй
Dialogue: 0,0:16:21.53,0:16:22.70,Default,,0,0,0,,- Иә? -Сен кімсің?
Dialogue: 0,0:16:23.06,0:16:27.50,Default,,0,0,0,,А, бұл Көк балта Кейта. Аға, бұрын теледидардан көргенмін.
Dialogue: 0,0:16:27.80,0:16:30.16,Default,,0,0,0,,``Жапонияның атақты президенттері'' бағдарламасы бойынша
Dialogue: 0,0:16:30.56,0:16:31.10,Default,,0,0,0,,Э?
Dialogue: 0,0:16:31.53,0:16:35.40,Default,,0,0,0,,Түсіндім. Akamatsu Kogyo - президенттің компаниясы.
Dialogue: 0,0:16:35.60,0:16:38.60,Default,,0,0,0,,Уау, олардың осындай үлкен робот жасағаны таңқаларлық.
Dialogue: 0,0:16:39.10,0:16:40.93,Default,,0,0,0,,Сіз бұрын трейлерден хабарласып жатырсыз.
Dialogue: 0,0:16:41.43,0:16:44.00,Default,,0,0,0,,-Неліктен бұл робот екі адамды отырғызады... -Бұл қиыншылық.
Dialogue: 0,0:16:44.33,0:16:47.10,Default,,0,0,0,,Әйтеуір, үнсіз отыра бересің.
Dialogue: 0,0:16:47.43,0:16:48.56,Default,,0,0,0,,Тірі қалсам ғой
Dialogue: 0,0:16:48.66,0:16:50.36,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:16:50.73,0:16:53.23,Default,,0,0,0,,Хиноки Гельдің шегі жақындап қалды
Dialogue: 0,0:16:53.56,0:16:54.43,Default,,0,0,0,,Оны бір рет қайтарыңыз
Dialogue: 0,0:16:54.53,0:16:55.83,Default,,0,0,0,,Кактуспен не істеу керек?
Dialogue: 0,0:17:00.23,0:17:02.13,Default,,0,0,0,,Шеруден бастайық па?
Dialogue: 0,0:17:03.26,0:17:05.63,Default,,0,0,0,,Хмм? Хехе, өте әдемі
Dialogue: 0,0:17:07.03,0:17:09.20,Default,,0,0,0,,Сәлем аа на аа
Dialogue: 0,0:17:10.06,0:17:10.53,Default,,0,0,0,,Әй
Dialogue: 0,0:17:18.13,0:17:19.06,Default,,0,0,0,,Тезірек, Хиноки
Dialogue: 0,0:17:19.20,0:17:19.90,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:17:21.00,0:17:21.46,Default,,0,0,0,,Ах
Dialogue: 0,0:17:22.33,0:17:24.13,Default,,0,0,0,,Бір нәрсе жақындап қалды
Dialogue: 0,0:17:33.46,0:17:34.50,Default,,0,0,0,,Гаааах
Dialogue: 0,0:17:35.46,0:17:37.00,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:17:37.16,0:17:41.03,Default,,0,0,0,,Ааа, бұл керемет. Құлап кетсем де, әсер еткен жоқтың қасы.
Dialogue: 0,0:17:41.20,0:17:43.86,Default,,0,0,0,,Бұл кабинаның амортизаторы қалай жұмыс істейді?
Dialogue: 0,0:17:44.56,0:17:45.23,Default,,0,0,0,,аулақ болыңыз
Dialogue: 0,0:17:49.80,0:17:51.43,Default,,0,0,0,,Хиноки Сіз оны талдай аласыз ба?
Dialogue: 0,0:17:52.06,0:17:52.83,Default,,0,0,0,,Талдау
Dialogue: 0,0:17:55.16,0:17:58.20,Default,,0,0,0,,Тасымалданатын рецепторды іске қосу компонентінің мәндері
Dialogue: 0,0:17:58.60,0:18:03.76,Default,,0,0,0,,Сырты арматураланған пластмассадан, ал ішкі бөлігі металл және электр сымдарының массасы.
Dialogue: 0,0:18:04.13,0:18:06.30,Default,,0,0,0,,Қысқасы, бұл робот.
Dialogue: 0,0:18:17.30,0:18:19.70,Default,,0,0,0,,А, түтін оқтары мен отшашулар.
Dialogue: 0,0:18:19.93,0:18:22.43,Default,,0,0,0,,Гель өзінің шегіне жеткенше санаулы минуттар қалды.
Dialogue: 0,0:18:22.83,0:18:24.26,Default,,0,0,0,,Техникалық қызмет көрсету құралын түсіріңіз.
Dialogue: 0,0:18:27.70,0:18:29.83,Default,,0,0,0,,Жоқ, мен жақсы қозғала алмаймын.
Dialogue: 0,0:18:31.00,0:18:32.13,Default,,0,0,0,,-К-чан өтінемін -Иә?
Dialogue: 0,0:18:32.93,0:18:34.23,Default,,0,0,0,,Кішкене ғана көмек
Dialogue: 0,0:18:34.53,0:18:35.73,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:18:36.63,0:18:38.20,Default,,0,0,0,,Uhub басқаруы
Dialogue: 0,0:18:38.70,0:18:40.76,Default,,0,0,0,,Кей-чан, iHub басқаруы.
Dialogue: 0,0:18:41.03,0:18:42.26,Default,,0,0,0,,-Айқай! -Жарайды түсіндім.
Dialogue: 0,0:18:44.80,0:18:46.93,Default,,0,0,0,,iHub басқаруы
Dialogue: 0,0:18:48.13,0:18:48.70,Default,,0,0,0,,Igi
Dialogue: 0,0:18:58.10,0:18:58.96,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:19:04.56,0:19:05.03,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:05.83,0:19:06.30,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:06.56,0:19:07.03,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:11.30,0:19:12.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:13.36,0:19:15.40,Default,,0,0,0,,Үзіліс синтезі Асығыңыз!
Dialogue: 0,0:19:15.80,0:19:19.86,Default,,0,0,0,,Мм, бубубу үзіліс, синтезатор!
Dialogue: 0,0:19:24.90,0:19:28.66,Default,,0,0,0,,Қатты қышқыл зат Ал бұл синтез жылдамдығы
Dialogue: 0,0:19:28.93,0:19:30.76,Default,,0,0,0,,Кактустан әлдеқайда жоғары
Dialogue: 0,0:19:34.73,0:19:35.43,Default,,0,0,0,,G-жиынтығы
Dialogue: 0,0:19:36.36,0:19:37.26,Default,,0,0,0,,...
Dialogue: 0,0:19:44.40,0:19:45.86,Default,,0,0,0,,Ууу
Dialogue: 0,0:19:49.50,0:19:51.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:51.13,0:19:52.86,Default,,0,0,0,,Сіз бұлай қозғала алмайсыз.
Dialogue: 0,0:19:54.30,0:19:56.26,Default,,0,0,0,,Хотару-чан, синаптикалық оқ!
Dialogue: 0,0:19:56.46,0:19:57.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:57.56,0:19:59.16,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:19:59.46,0:20:01.50,Default,,0,0,0,,Күрсін, мен оны енді түсінбеймін, бірақ о
Dialogue: 0,0:20:01.63,0:20:04.03,Default,,0,0,0,,Синапс белгісі
Dialogue: 0,0:20:24.86,0:20:27.83,Default,,0,0,0,,Металдарды ыдырататын қышқылдар электрлік ағуды тудыруы мүмкін.
Dialogue: 0,0:20:28.06,0:20:31.66,Default,,0,0,0,,Сіз тіпті жүйенің өзін бұзатынын есептедіңіз бе?
Dialogue: 0,0:20:31.96,0:20:34.00,Default,,0,0,0,,Уақыт кідірісімен әрекеттесетін заттарды күту
Dialogue: 0,0:20:34.36,0:20:36.53,Default,,0,0,0,,Сіз тіпті қоршаған ортаны қалыпқа келтірдіңіз.
Dialogue: 0,0:20:37.23,0:20:38.33,Default,,0,0,0,,Керемет
Dialogue: 0,0:20:43.76,0:20:44.93,Default,,0,0,0,,Рахмет, Кей Чан
Dialogue: 0,0:20:45.46,0:20:49.80,Default,,0,0,0,,Бұл робот жақсы көрінбейді, бірақ ол өте күшті.
Dialogue: 0,0:20:50.13,0:20:51.16,Default,,0,0,0,,Бұл робот емес.
Dialogue: 0,0:20:51.66,0:20:54.20,Default,,0,0,0,,Нейроноидты оятатын адам №1
Dialogue: 0,0:20:54.73,0:20:56.20,Default,,0,0,0,,Ха, мен келемін!
Dialogue: 0,0:20:56.60,0:20:59.73,Default,,0,0,0,,Оянған адам? иә?
Dialogue: 0,0:21:04.40,0:21:06.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:06.36,0:21:08.66,Default,,0,0,0,,Уф, не түсіп жатыр?
Dialogue: 0,0:21:11.66,0:21:14.56,Default,,0,0,0,,Чика-чан қатты қуанды!
Dialogue: 0,0:21:15.03,0:21:16.10,Default,,0,0,0,,Чика-чан
Dialogue: 0,0:21:17.43,0:21:18.93,Default,,0,0,0,,Хахахахахахахахаха...
Dialogue: 0,0:21:19.03,0:21:23.33,Default,,0,0,0,,Бұрын жасаған әдістемені қалай қайталауға болады? Хиноки?
Dialogue: 0,0:21:24.86,0:21:25.76,Default,,0,0,0,,Уақыт аяқталды
Dialogue: 0,0:21:26.16,0:21:30.03,Default,,0,0,0,,Линкер гелі диализге ұшырамаса, оянған адам бір қадам алға жылжи алмайды.
Dialogue: 0,0:21:30.36,0:21:32.53,Default,,0,0,0,,Бұл жанармай таусылғанын білдіре ме?
Dialogue: 0,0:21:32.56,0:21:33.60,Default,,0,0,0,,-Хиноки Эй -Техникалық тасымалдаушы
Dialogue: 0,0:21:33.63,0:21:36.33,Default,,0,0,0,,-Сен мені естисің бе? Хиноки Хиноки - Менің ойымша, бұл тіпті менің бағалауым бойынша 20 метр емес.
Dialogue: 0,0:21:36.66,0:21:40.30,Default,,0,0,0,,Фуфухахахахахахахахахахахахахахахахахахахахахаха
Dialogue: 0,0:21:41.20,0:21:43.13,Default,,0,0,0,,Біздің үмітімізді тыңда
Dialogue: 0,0:21:44.53,0:21:47.46,Default,,0,0,0,,Менің оны Тұмандық үшін қолданудан басқа амалым жоқ сияқты.
Dialogue: 0,0:21:48.36,0:21:50.36,Default,,0,0,0,,Ухуху уһ уһ уһ уһ
Dialogue: 0,0:21:50.43,0:21:52.63,Default,,0,0,0,,-Хахахахаха -Ааа
Dialogue: 0,0:21:53.76,0:21:54.40,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:21:54.43,0:21:57.56,Default,,0,0,0,,Нуфф хахахахахаха
Dialogue: 0,0:22:01.96,0:22:03.06,Default,,0,0,0,,Гаригаригаригари
Dialogue: 0,0:22:03.10,0:22:05.06,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:22:08.56,0:22:09.00,Default,,0,0,0,,Га
Dialogue: 0,0:22:11.80,0:22:13.20,Default,,0,0,0,,Ааа
Dialogue: 0,0:22:13.66,0:22:17.53,Default,,0,0,0,,Ааа
Dialogue: 0,0:22:17.63,0:22:18.66,Default,,0,0,0,,Міне!
Dialogue: 0,0:22:19.26,0:22:22.03,Default,,0,0,0,,Ооо
Dialogue: 0,0:22:22.16,0:22:26.80,Default,,0,0,0,,Ууу
Dialogue: 0,0:22:27.36,0:22:28.60,Default,,0,0,0,,Беттерман
Dialogue: 0,0:22:34.46,0:22:47.06,Default,,0,0,0,,Құдайдың күнәсі шексіз теломерлерге жазылды
Dialogue: 0,0:22:47.73,0:22:53.73,Default,,0,0,0,,Жалынды құшақтап алу
Dialogue: 0,0:22:54.56,0:23:01.43,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:01.96,0:23:05.13,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.30,0:23:08.46,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.70,0:23:11.83,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.16,0:23:15.36,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.26,0:23:26.60,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:27.36,0:23:37.13,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:37.83,0:23:48.83,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:24:00.33,0:24:04.16,Default,,0,0,0,,Ол адам - ​​Ламия, ол адам - ​​инкарнация.
Dialogue: 0,0:24:05.43,0:24:09.20,Default,,0,0,0,,Бұл адам Тұмандық деп аталатын инкарнация.
Dialogue: 0,0:24:10.96,0:24:12.10,Default,,0,0,0,,үшін өле ме?
Dialogue: 0,0:24:13.13,0:24:15.90,Default,,0,0,0,,Мен де? сен де?
Dialogue: 0,0:24:17.43,0:24:21.56,Default,,0,0,0,,Есту, есту, қараңғылық дауысы
Dialogue: 0,0:24:23.16,0:24:25.16,Default,,0,0,0,,Сізден кейін
Dialogue: 0,0:24:26.66,0:24:32.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
