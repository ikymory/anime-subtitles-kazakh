Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.03,0:00:19.26,Default,,0,0,0,,Президент, пакет келді.
Dialogue: 0,0:00:19.96,0:00:21.10,Default,,0,0,0,,Тым үлкен
Dialogue: 0,0:00:21.46,0:00:24.36,Default,,0,0,0,,Бұл А-сыныптағы арнайы модификация жинағы екенін айтады.
Dialogue: 0,0:00:24.73,0:00:27.70,Default,,0,0,0,,Көріп отырғаныңыздай, бұл Рождестволық сыйлық.
Dialogue: 0,0:00:27.90,0:00:29.56,Default,,0,0,0,,Рождестволық сыйлық
Dialogue: 0,0:00:30.03,0:00:33.36,Default,,0,0,0,,Әй, Америкадағы әкемнен.
Dialogue: 0,0:00:34.10,0:00:38.46,Default,,0,0,0,,Мен оған жарты жыл бұрын тапсырыс бердім, ол тез аяқталды.
Dialogue: 0,0:00:39.56,0:00:43.33,Default,,0,0,0,,Ойлап қарасам, президенттің әкесі ғалым болған ғой?
Dialogue: 0,0:00:44.53,0:00:48.13,Default,,0,0,0,,Нарухоро Бұл өнертабысқа деген сүйіспеншілік тұқым қуалаушылық болды.
Dialogue: 0,0:00:55.23,0:00:57.43,Default,,0,0,0,,Бұл әлі де жақсы емес пе?
Dialogue: 0,0:00:58.13,0:00:58.66,Default,,0,0,0,,Иә
Dialogue: 0,0:00:59.96,0:01:02.60,Default,,0,0,0,,Оған кіре алмағаныма бір ай болды.
Dialogue: 0,0:01:03.66,0:01:05.73,Default,,0,0,0,,Тұрақты рейстер де бірінен соң бірін жоғалтты.
Dialogue: 0,0:01:11.03,0:01:15.06,Default,,0,0,0,,Тіпті штабта қатаң бақыланатын қос тайпа да осылай жойылды.
Dialogue: 0,0:01:16.13,0:01:20.96,Default,,0,0,0,,Үш күн бұрын штаб-пәтерге жіберілген француз филиалының тергеу тобы да байланысын үзді.
Dialogue: 0,0:01:22.93,0:01:24.63,Default,,0,0,0,,Бұл Алджернон.
Dialogue: 0,0:01:25.83,0:01:27.40,Default,,0,0,0,,100% дерлік
Dialogue: 0,0:01:30.76,0:01:36.60,Default,,0,0,0,,Бүкіл әлемде қатыгездікпен өлтіру оқиғалары және кенеттен жаппай суицидтер жиі орын алуда.
Dialogue: 0,0:01:37.23,0:01:39.46,Default,,0,0,0,,Бұл жағдайлардың ортақтығы мынада
Dialogue: 0,0:01:39.93,0:01:42.10,Default,,0,0,0,,Әдетте бейбіт өмір сүрген адамдар
Dialogue: 0,0:01:42.46,0:01:46.43,Default,,0,0,0,,Бір күні кенеттен әдеттен тыс әрекет жасай бастайды дейді.
Dialogue: 0,0:01:46.70,0:01:48.86,Default,,0,0,0,,Қоздырғыштары белгісіз жұқпалы аурулар
Dialogue: 0,0:01:48.96,0:01:49.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:49.86,0:01:55.03,Default,,0,0,0,,Қазір мұнда барлығы жиналды, тіпті өзім де.
Dialogue: 0,0:01:55.46,0:01:59.10,Default,,0,0,0,,Сіз бұл оғаш ауруды жұқтырған боларсыз.
Dialogue: 0,0:01:59.83,0:02:01.26,Default,,0,0,0,,Сіз жұқтырғансыз ба?
Dialogue: 0,0:02:01.83,0:02:04.43,Default,,0,0,0,,Иә, Алджернонға.
Dialogue: 0,0:02:06.73,0:02:16.30,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:02:18.60,0:02:26.63,Default,,0,0,0,,Қалқымалы күміс қайық
Dialogue: 0,0:02:28.53,0:02:37.10,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:02:40.36,0:02:48.56,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:02:51.50,0:03:00.33,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:03:00.83,0:03:08.86,Default,,0,0,0,,Жанға бағыт беру
Dialogue: 0,0:03:10.66,0:03:20.20,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:03:20.70,0:03:32.63,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:03:44.76,0:03:47.13,Default,,0,0,0,,Рождество мерекесімен
Dialogue: 0,0:03:47.86,0:03:48.80,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:03:48.83,0:03:51.23,Default,,0,0,0,,Ойчи Нийсанши
Dialogue: 0,0:03:52.56,0:03:53.20,Default,,0,0,0,,Уау
Dialogue: 0,0:03:56.60,0:04:00.26,Default,,0,0,0,,Ендеше, әйтеуір бір жылды аман-есен өткізетін сияқтымыз.
Dialogue: 0,0:04:00.36,0:04:01.23,Default,,0,0,0,,Мүлдем емес.
Dialogue: 0,0:04:01.56,0:04:04.93,Default,,0,0,0,,Соңғы бірнеше айда қанша рет өліп қала жаздағанымды білмеймін.
Dialogue: 0,0:04:05.13,0:04:07.16,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:04:07.50,0:04:10.63,Default,,0,0,0,,Мен өткен күні жақсы емес деп ойладым.
Dialogue: 0,0:04:10.93,0:04:13.26,Default,,0,0,0,,Иә, иә, дұрыс.
Dialogue: 0,0:04:15.30,0:04:18.26,Default,,0,0,0,,Якусуги деген қарт сиқыршы.
Dialogue: 0,0:04:18.83,0:04:22.06,Default,,0,0,0,,Бізді Хинокиде тұзаққа түсірген шығар
Dialogue: 0,0:04:22.40,0:04:24.96,Default,,0,0,0,,Мүмкін бұл оны адамнан тыс одақтан қорғау үшін болған шығар.
Dialogue: 0,0:04:25.33,0:04:28.66,Default,,0,0,0,,Дұрыс, мен ештеңе ойлаған жоқпын.
Dialogue: 0,0:04:29.20,0:04:32.00,Default,,0,0,0,,Ол біраз уақыттан бері чакраны басшылыққа алды.
Dialogue: 0,0:04:32.03,0:04:34.46,Default,,0,0,0,,Ол бұл әрекетті шешіп жатқанын айтты.
Dialogue: 0,0:04:34.83,0:04:37.86,Default,,0,0,0,,Бұл ағартушылық күйі ме?
Dialogue: 0,0:04:38.33,0:04:38.83,Default,,0,0,0,,Иә
Dialogue: 0,0:04:39.10,0:04:41.86,Default,,0,0,0,,Адамның өзі ештеңені ойламайды.
Dialogue: 0,0:04:41.93,0:04:44.33,Default,,0,0,0,,Хахахахаха Хинокиге ұқсайтын шығар
Dialogue: 0,0:04:45.13,0:04:47.70,Default,,0,0,0,,Әйтеуір, мен де нұрлы күйдемін.
Dialogue: 0,0:04:50.33,0:04:53.80,Default,,0,0,0,,Бірақ ол чакраман енді арамызда жоқ.
Dialogue: 0,0:04:54.80,0:04:58.56,Default,,0,0,0,,Ууууууу
Dialogue: 0,0:05:04.53,0:05:07.56,Default,,0,0,0,,Кактустан шыққан форте жемісі жоғалып кетті.
Dialogue: 0,0:05:08.26,0:05:12.10,Default,,0,0,0,,Сонымен Беттерман оны әкелді ғой?
Dialogue: 0,0:05:13.43,0:05:15.43,Default,,0,0,0,,Қадірменді дүниеден өткен болса
Dialogue: 0,0:05:19.03,0:05:22.76,Default,,0,0,0,,Кактус пен доктор Умезаки сияқты, бір жерде жеміс
Dialogue: 0,0:05:24.26,0:05:25.30,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:25.73,0:05:29.86,Default,,0,0,0,,Соған қарамастан, Forte өте күшті болуы керек.
Dialogue: 0,0:05:30.33,0:05:32.46,Default,,0,0,0,,Беттерманның Люме есімді әпкесі.
Dialogue: 0,0:05:32.53,0:05:35.96,Default,,0,0,0,,Мен сол қара жігітті аз уақытта жеңдім.
Dialogue: 0,0:05:36.23,0:05:38.06,Default,,0,0,0,,Соңында не болды?
Dialogue: 0,0:05:38.70,0:05:42.90,Default,,0,0,0,,Не? Бұл да жақсы адам емес пе?
Dialogue: 0,0:05:43.30,0:05:44.86,Default,,0,0,0,,Бұл әлі айтып жеткізу мүмкін емес
Dialogue: 0,0:05:51.70,0:05:54.36,Default,,0,0,0,,Forte да үздіксіз Aqua түрленеді.
Dialogue: 0,0:05:55.06,0:05:59.76,Default,,0,0,0,,Олар бізді әп-сәтте бірнеше ондаған шақырым жердегі Akamatsu Industries-ке көшірді.
Dialogue: 0,0:06:00.96,0:06:03.20,Default,,0,0,0,,Бұл нағыз ғажайып тәжірибе болды.
Dialogue: 0,0:06:04.36,0:06:07.23,Default,,0,0,0,,Менің бүкіл денем суда еріп бара жатқандай болды.
Dialogue: 0,0:06:08.13,0:06:10.50,Default,,0,0,0,,Химиямен түсіндіру мүмкін емес.
Dialogue: 0,0:06:13.60,0:06:16.86,Default,,0,0,0,,Бұл шынымен де адамзаттың ақыл-ойын ескіргендей етеді.
Dialogue: 0,0:06:17.70,0:06:20.50,Default,,0,0,0,,Иә, иә, мен тірі болғаныма қуаныштымын.
Dialogue: 0,0:06:21.00,0:06:24.96,Default,,0,0,0,,Альджернон теледидарда бұл дүние жүзінде болып жатқанын айтты.
Dialogue: 0,0:06:25.66,0:06:27.26,Default,,0,0,0,,Мордиварп туралы не деуге болады?
Dialogue: 0,0:06:27.60,0:06:30.96,Default,,0,0,0,,Мұны кейінірек түсіндіремін.
Dialogue: 0,0:06:31.16,0:06:31.80,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:32.76,0:06:34.63,Default,,0,0,0,,Мен барлығынан бір нәрсе сұрағым келеді.
Dialogue: 0,0:06:35.33,0:06:39.53,Default,,0,0,0,,Жоқ, Янаги-сан, сен сондай жақсы көрінесің.
Dialogue: 0,0:06:40.73,0:06:44.63,Default,,0,0,0,,Дұрыс, мен шын мәнінде бақыттымын.
Dialogue: 0,0:06:44.70,0:06:45.36,Default,,0,0,0,,Иә
Dialogue: 0,0:06:45.66,0:06:46.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:46.50,0:06:47.73,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:06:48.63,0:06:50.26,Default,,0,0,0,,Міне 4 ай болды.
Dialogue: 0,0:06:50.50,0:06:52.26,Default,,0,0,0,,Иә
Dialogue: 0,0:06:52.36,0:06:54.96,Default,,0,0,0,,Жарайды, төрт ай дегенді білдіреді.
Dialogue: 0,0:06:55.26,0:06:55.76,Default,,0,0,0,,Иә
Dialogue: 0,0:06:56.13,0:06:58.66,Default,,0,0,0,,Неге ертерек айтпадың?
Dialogue: 0,0:06:59.03,0:07:01.60,Default,,0,0,0,,Білсем, нейронды ештеңеге қоймас едім.
Dialogue: 0,0:07:02.43,0:07:03.76,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:04.20,0:07:06.70,Default,,0,0,0,,Енді әлемге Алджернон қауіп төніп тұр
Dialogue: 0,0:07:07.10,0:07:11.53,Default,,0,0,0,,Мен қатты толқу мүмкін емес, бірақ шынымды айтсам, мен қазір шынымен бақыттымын.
Dialogue: 0,0:07:12.13,0:07:15.86,Default,,0,0,0,,Сондықтан мен мұнда ең болмағанда қарапайым үйлену тойын өткізгім келеді.
Dialogue: 0,0:07:17.60,0:07:18.90,Default,,0,0,0,,Ия
Dialogue: 0,0:07:18.96,0:07:20.00,Default,,0,0,0,,Ооо
Dialogue: 0,0:07:20.03,0:07:21.60,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:07:22.80,0:07:25.86,Default,,0,0,0,,Құттықтаймыз Янаги-кун Каэде-сан
Dialogue: 0,0:07:48.33,0:07:50.86,Default,,0,0,0,,Бұл Янаги-сан мен Каэде-санның сәбиі ме?
Dialogue: 0,0:07:51.53,0:07:55.60,Default,,0,0,0,,Ол ұл болсын, қыз болсын, өте әдемі болуы керек.
Dialogue: 0,0:07:56.93,0:08:01.16,Default,,0,0,0,,Мүмкін керемет қабілеті бар бала туатын шығар.
Dialogue: 0,0:08:01.50,0:08:02.76,Default,,0,0,0,,Қабілет бойынша да
Dialogue: 0,0:08:04.10,0:08:08.80,Default,,0,0,0,,Тірі заттар әр түрлі даралар арасындағы репродуктивті әрекеттер арқылы ұрпақ әкелді.
Dialogue: 0,0:08:09.23,0:08:12.90,Default,,0,0,0,,Болашақ ұрпаққа күшті және жақсы гендер қалдыру
Dialogue: 0,0:08:13.86,0:08:18.83,Default,,0,0,0,,Барлық тіршілік иелері өзінің қазіргі болмысын жоққа шығару арқылы дами береді.
Dialogue: 0,0:08:20.46,0:08:24.56,Default,,0,0,0,,Адамзат дами алды, өйткені ерлер мен әйелдер болды.
Dialogue: 0,0:08:24.90,0:08:27.86,Default,,0,0,0,,Өйткені, адамдар жалғыз өмір сүре алмайды, солай ма?
Dialogue: 0,0:08:29.26,0:08:33.56,Default,,0,0,0,,Түсінемін, сондықтан Dualkind Neuronoid-ді өздігінен жылжыта алмайды.
Dialogue: 0,0:08:34.06,0:08:38.00,Default,,0,0,0,,Адамдардың бір-бірімен симбиотикалық қатынасы бар деп айтуға болады.
Dialogue: 0,0:08:38.20,0:08:41.70,Default,,0,0,0,,А, онда бізге Беттерман көмектеседі.
Dialogue: 0,0:08:42.13,0:08:43.96,Default,,0,0,0,,Менің ойымша, бұл симбиотикалық қарым-қатынас болғандықтан.
Dialogue: 0,0:08:44.60,0:08:45.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:45.86,0:08:48.86,Default,,0,0,0,,Асами-сан, мен адаммын ба?
Dialogue: 0,0:08:49.66,0:08:50.73,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:08:51.46,0:08:55.83,Default,,0,0,0,,Мен де бір күні Беттерман сияқты құбыжыққа айналармын ба деп ойлаймын.
Dialogue: 0,0:08:56.43,0:08:58.43,Default,,0,0,0,,Соңғы кездері мен бұл туралы ойлана бастадым.
Dialogue: 0,0:08:59.36,0:09:00.56,Default,,0,0,0,,Хмм, мүмкін емес.
Dialogue: 0,0:09:01.46,0:09:02.36,Default,,0,0,0,,Хиноки-сан
Dialogue: 0,0:09:03.26,0:09:06.66,Default,,0,0,0,,Жарайды, сен адам екенсің.
Dialogue: 0,0:09:07.90,0:09:08.36,Default,,0,0,0,,Ах
Dialogue: 0,0:09:09.90,0:09:10.43,Default,,0,0,0,,Иә
Dialogue: 0,0:09:13.96,0:09:16.13,Default,,0,0,0,,Рождество мерекесімен Сара Чан
Dialogue: 0,0:09:19.60,0:09:21.60,Default,,0,0,0,,Сіз соңғы уақытта көп ұйықтайсыз.
Dialogue: 0,0:09:21.93,0:09:23.83,Default,,0,0,0,,Бұл бала әлсіз.
Dialogue: 0,0:09:25.90,0:09:28.40,Default,,0,0,0,,Білесіз бе, мен бұл туралы біраздан бері ойладым.
Dialogue: 0,0:09:28.63,0:09:29.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:29.16,0:09:32.13,Default,,0,0,0,,Мүмкін Хиноки мен Сара-чанның қарым-қатынасы жақсы емес шығар?
Dialogue: 0,0:09:32.33,0:09:33.83,Default,,0,0,0,,Эй, неге?
Dialogue: 0,0:09:34.13,0:09:37.73,Default,,0,0,0,,Себебі мен Сара-чанмен сөйлеспеймін.
Dialogue: 0,0:09:38.43,0:09:40.53,Default,,0,0,0,,Ол мұндай нәрседен аулақ болуға тырысатын сияқты.
Dialogue: 0,0:09:41.00,0:09:43.36,Default,,0,0,0,,Бұл менің ниетім емес.
Dialogue: 0,0:09:44.56,0:09:49.20,Default,,0,0,0,,А, бірақ менен сұрасаңыз, бұл рас деп ойлаймын.
Dialogue: 0,0:09:50.73,0:09:55.30,Default,,0,0,0,,Мен мұнда алғаш келгенімде Сарамен қазіргіге қарағанда жақсы араластым.
Dialogue: 0,0:09:55.96,0:09:59.26,Default,,0,0,0,,Жасымыз жақын болғандықтан, қарындасымыз бар сияқты.
Dialogue: 0,0:10:00.13,0:10:00.66,Default,,0,0,0,,Иә
Dialogue: 0,0:10:02.13,0:10:04.93,Default,,0,0,0,,Бірақ мен не ойлаймын және не ойлаймын
Dialogue: 0,0:10:05.60,0:10:08.23,Default,,0,0,0,,Мен барлығын бастан-аяқ көріп тұрғандай сезіне бастадым.
Dialogue: 0,0:10:09.16,0:10:11.80,Default,,0,0,0,,Мүмкін мен табиғи түрде одан аулақ болуға тырыстым.
Dialogue: 0,0:10:12.10,0:10:13.96,Default,,0,0,0,,Лимипидті арна?
Dialogue: 0,0:10:15.26,0:10:16.73,Default,,0,0,0,,Бірақ Сакора жаман емес.
Dialogue: 0,0:10:17.43,0:10:22.16,Default,,0,0,0,,Өйткені сол қабілеттен ең көп зардап шегетін – Сараның өзі.
Dialogue: 0,0:10:23.23,0:10:27.33,Default,,0,0,0,,Ах, Сара-чан, мен сенің СДВГ-мен ауыратыныңды естідім.
Dialogue: 0,0:10:27.80,0:10:30.36,Default,,0,0,0,,Бас сүйек нервтері араласатын ауру.
Dialogue: 0,0:10:31.60,0:10:33.03,Default,,0,0,0,,Сакораның басының іші
Dialogue: 0,0:10:33.53,0:10:38.00,Default,,0,0,0,,Лимипид арнасы арқылы бүкіл әлем бойынша адамдардың дауысы үзіліссіз естілуі мүмкін.
Dialogue: 0,0:10:38.80,0:10:39.80,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:41.00,0:10:43.10,Default,,0,0,0,,Егер мен бұл қабілетпен туылмасам
Dialogue: 0,0:10:44.00,0:10:46.53,Default,,0,0,0,,Сакора кәдімгі қыз болуы мүмкін еді.
Dialogue: 0,0:10:49.66,0:10:50.33,Default,,0,0,0,,Сакура
Dialogue: 0,0:10:52.23,0:10:52.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:58.60,0:11:01.96,Default,,0,0,0,,Хм, бұл көрініс өте тыныш.
Dialogue: 0,0:11:02.20,0:11:04.60,Default,,0,0,0,,Барлық адамдар тірі сияқты.
Dialogue: 0,0:11:04.90,0:11:07.80,Default,,0,0,0,,Маған енді Беттермен де, Алджернон да бәрібір.
Dialogue: 0,0:11:08.33,0:11:09.63,Default,,0,0,0,,Өйткені мен ақымақпын
Dialogue: 0,0:11:10.20,0:11:13.20,Default,,0,0,0,,Хинокидің қанатты сөзі шындықтан қашу емес пе?
Dialogue: 0,0:11:13.46,0:11:14.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:17.93,0:11:21.06,Default,,0,0,0,,Мен әрқашан Хинокидің қасында боламын.
Dialogue: 0,0:11:22.33,0:11:24.30,Default,,0,0,0,,Сол азапты нәрселер
Dialogue: 0,0:11:24.70,0:11:27.43,Default,,0,0,0,,Оны бірге шешейік.
Dialogue: 0,0:11:28.46,0:11:29.20,Default,,0,0,0,,К-чан
Dialogue: 0,0:11:29.36,0:11:30.16,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:11:33.23,0:11:34.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:34.50,0:11:38.43,Default,,0,0,0,,Хе, о, жоқ, жоқ, жоқ, хе, хе, хе.
Dialogue: 0,0:11:38.73,0:11:41.20,Default,,0,0,0,,Аа, дұрыс, мен қазір келемін.
Dialogue: 0,0:11:41.40,0:11:41.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:41.96,0:11:46.36,Default,,0,0,0,,Иә, жақсы. Ата-анам ыстық суға кетті, бүгін қайтып келмейді.
Dialogue: 0,0:11:47.50,0:11:51.46,Default,,0,0,0,,А, о, жоқ, жоқ, жоқ, мен бұл оғаш нәрсені істемеймін.
Dialogue: 0,0:11:51.50,0:11:53.66,Default,,0,0,0,,бөліміне өтіңіз, мен мұны ешқашан жасамаймын деп уәде беремін.
Dialogue: 0,0:11:53.73,0:11:58.16,Default,,0,0,0,,Оооооооооооооооооооооооооооооооооооооооооуууууууууууууууууууууууууууууууууу
Dialogue: 0,0:11:58.53,0:12:00.70,Default,,0,0,0,,А, жақсысың ба?
Dialogue: 0,0:12:02.96,0:12:03.70,Default,,0,0,0,,Иә
Dialogue: 0,0:12:04.93,0:12:07.50,Default,,0,0,0,,-Уфуфуфуфуфуфуфу -а
Dialogue: 0,0:12:07.56,0:12:11.43,Default,,0,0,0,,-Аха Уфуфуфу -Хехехе
Dialogue: 0,0:12:12.76,0:12:13.36,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:14.30,0:12:14.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:16.20,0:12:18.33,Default,,0,0,0,,Мені жібер, Ке-чан-чи
Dialogue: 0,0:12:23.46,0:12:24.53,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:12:25.50,0:12:27.63,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:12:30.53,0:12:31.56,Default,,0,0,0,,Ұры?
Dialogue: 0,0:12:33.60,0:12:34.13,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:12:36.50,0:12:37.46,Default,,0,0,0,,Уф аа
Dialogue: 0,0:12:37.83,0:12:38.30,Default,,0,0,0,,Ах
Dialogue: 0,0:12:41.00,0:12:41.60,Default,,0,0,0,,К-чан
Dialogue: 0,0:12:42.00,0:12:42.60,Default,,0,0,0,,Хаха!
Dialogue: 0,0:12:43.33,0:12:44.00,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:12:47.30,0:12:51.16,Default,,0,0,0,,Ах ха ха ха ха ха ха ха шаршаған шығарсың.
Dialogue: 0,0:12:51.63,0:12:52.33,Default,,0,0,0,,Эй!
Dialogue: 0,0:12:52.56,0:12:53.70,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:12:53.80,0:12:56.76,Default,,0,0,0,,А, мен саған кесе мен табақ алып беремін. Тек бір жерде отырыңыз.
Dialogue: 0,0:12:57.73,0:12:59.93,Default,,0,0,0,,Эххехе ах
Dialogue: 0,0:13:04.50,0:13:05.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:12.00,0:13:12.73,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:13:17.50,0:13:17.93,Default,,0,0,0,,Уф
Dialogue: 0,0:13:21.13,0:13:21.66,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:13:26.66,0:13:27.23,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:13:32.66,0:13:34.20,Default,,0,0,0,,Ха, бұл менің қиялым ғана.
Dialogue: 0,0:13:37.00,0:13:38.66,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:13:42.53,0:13:46.03,Default,,0,0,0,,Әй, уау!
Dialogue: 0,0:13:46.16,0:13:48.43,Default,,0,0,0,,-К-чан К-чан -Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:13:48.56,0:13:49.16,Default,,0,0,0,,Шашылыңдар!
Dialogue: 0,0:13:54.13,0:13:54.96,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:55.70,0:14:00.16,Default,,0,0,0,,Рере эх хахаха ада мен сәл құлап қалдым.
Dialogue: 0,0:14:00.20,0:14:00.80,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:14:02.60,0:14:03.23,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:14:04.13,0:14:04.90,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:14:06.50,0:14:07.10,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:14:17.93,0:14:19.73,Default,,0,0,0,,Жақсы. Әдеттегідей.
Dialogue: 0,0:14:21.36,0:14:23.00,Default,,0,0,0,,А, бұл менің бөлмем.
Dialogue: 0,0:14:24.63,0:14:25.73,Default,,0,0,0,,Бұл тәртіпсіздік.
Dialogue: 0,0:14:26.13,0:14:28.70,Default,,0,0,0,,А, мен оны жылына екі рет ғана тазалаймын.
Dialogue: 0,0:14:30.13,0:14:33.70,Default,,0,0,0,,Хмм, бірақ бұл тыныштандыратын бөлме.
Dialogue: 0,0:14:35.46,0:14:35.96,Default,,0,0,0,,Ах
Dialogue: 0,0:14:36.26,0:14:36.86,Default,,0,0,0,,Электр қуатын өшіру?
Dialogue: 0,0:14:37.23,0:14:39.03,Default,,0,0,0,,Әй, қар жауған шығар.
Dialogue: 0,0:14:39.70,0:14:40.16,Default,,0,0,0,,Иә
Dialogue: 0,0:14:46.83,0:14:47.73,Default,,0,0,0,,К-чан
Dialogue: 0,0:14:48.56,0:14:49.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.36,0:14:51.66,Default,,0,0,0,,Осымен
Dialogue: 0,0:14:52.03,0:14:52.50,Default,,0,0,0,,Иә
Dialogue: 0,0:14:53.86,0:14:54.30,Default,,0,0,0,,Ах
Dialogue: 0,0:14:55.16,0:14:55.83,Default,,0,0,0,,О
Dialogue: 0,0:15:03.90,0:15:05.10,Default,,0,0,0,,Эх, Хиноки
Dialogue: 0,0:15:05.40,0:15:05.83,Default,,0,0,0,,Иә
Dialogue: 0,0:15:06.06,0:15:08.03,Default,,0,0,0,,Мен уәде беремін
Dialogue: 0,0:15:10.00,0:15:11.96,Default,,0,0,0,,Хинокиді жалғыз қалдырмаңыз
Dialogue: 0,0:15:12.86,0:15:14.40,Default,,0,0,0,,Мен әрқашан сенің жаныңда боламын
Dialogue: 0,0:15:15.40,0:15:16.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:15:17.90,0:15:18.60,Default,,0,0,0,,К-чан
Dialogue: 0,0:15:25.93,0:15:26.40,Default,,0,0,0,,Ах
Dialogue: 0,0:15:31.73,0:15:32.56,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:15:32.83,0:15:34.43,Default,,0,0,0,,Ootto guah
Dialogue: 0,0:15:34.70,0:15:36.73,Default,,0,0,0,,Ах, Харахоро
Dialogue: 0,0:15:37.93,0:15:38.40,Default,,0,0,0,,Га
Dialogue: 0,0:15:41.70,0:15:43.56,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:15:45.96,0:15:47.20,Default,,0,0,0,,Ах ха ха
Dialogue: 0,0:15:54.86,0:15:55.33,Default,,0,0,0,,Ах
Dialogue: 0,0:16:00.13,0:16:01.13,Default,,0,0,0,,К-чан
Dialogue: 0,0:16:06.33,0:16:08.60,Default,,0,0,0,,Хааааааааааааа
Dialogue: 0,0:16:08.86,0:16:11.10,Default,,0,0,0,,А, иә, иә?
Dialogue: 0,0:16:11.70,0:16:12.16,Default,,0,0,0,,Уф
Dialogue: 0,0:16:16.66,0:16:17.10,Default,,0,0,0,,Уф
Dialogue: 0,0:16:17.46,0:16:18.10,Default,,0,0,0,,Уф
Dialogue: 0,0:16:18.40,0:16:21.30,Default,,0,0,0,,Хааааааааааа
Dialogue: 0,0:16:23.10,0:16:23.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:45.66,0:16:46.73,Default,,0,0,0,,Уф аа
Dialogue: 0,0:16:48.26,0:16:49.76,Default,,0,0,0,,Оянған адамның ішінде
Dialogue: 0,0:16:51.00,0:16:52.90,Default,,0,0,0,,Неліктен мен сүңгуір костюмін кидім?
Dialogue: 0,0:16:53.60,0:16:55.43,Default,,0,0,0,,Ха ха-а
Dialogue: 0,0:16:56.26,0:16:56.70,Default,,0,0,0,,Ах
Dialogue: 0,0:17:01.13,0:17:02.60,Default,,0,0,0,,-Хаа -Ке-чан
Dialogue: 0,0:17:03.50,0:17:05.66,Default,,0,0,0,,Алджернон.
Dialogue: 0,0:17:06.50,0:17:07.13,Default,,0,0,0,,Әй
Dialogue: 0,0:17:10.43,0:17:12.63,Default,,0,0,0,,Хехехехе ха
Dialogue: 0,0:17:26.70,0:17:29.46,Default,,0,0,0,,Не, ол дауыстық командаларсыз жұмыс істейді?
Dialogue: 0,0:17:41.16,0:17:43.36,Default,,0,0,0,,Тоқта, ұмыттың ба?
Dialogue: 0,0:17:44.00,0:17:47.03,Default,,0,0,0,,Бодайжу Пачира қарт екеуміз
Dialogue: 0,0:17:47.73,0:17:49.96,Default,,0,0,0,,Олардың барлығын Қанкел жойғанын.
Dialogue: 0,0:17:50.56,0:17:52.06,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:52.96,0:17:55.43,Default,,0,0,0,,Мен саған ештеңе істей алмадым
Dialogue: 0,0:17:56.73,0:18:00.16,Default,,0,0,0,,Ламия Сіз Сомнияның мұрагерісіз.
Dialogue: 0,0:18:00.90,0:18:02.00,Default,,0,0,0,,Өлме
Dialogue: 0,0:18:03.66,0:18:04.56,Default,,0,0,0,,Гаргаригари
Dialogue: 0,0:18:05.23,0:18:07.86,Default,,0,0,0,,Үмітсіз мұраның мәні жоқ
Dialogue: 0,0:18:09.26,0:18:14.00,Default,,0,0,0,,Ламия, сенің ішіңдегі Wiwele өте күшті.
Dialogue: 0,0:18:16.00,0:18:19.83,Default,,0,0,0,,Уау...
Dialogue: 0,0:18:21.96,0:18:25.56,Default,,0,0,0,,Увааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:18:33.56,0:18:35.73,Default,,0,0,0,,Кей-чан, төбелескің келе ме?
Dialogue: 0,0:18:36.10,0:18:38.10,Default,,0,0,0,,Уф, мен одан шыға алмаймын.
Dialogue: 0,0:18:38.66,0:18:39.70,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:18:43.90,0:18:44.53,Default,,0,0,0,,Иә
Dialogue: 0,0:18:45.16,0:18:46.26,Default,,0,0,0,,Не?
Dialogue: 0,0:18:53.10,0:18:54.90,Default,,0,0,0,,Synapse Bullet қолданбасын пайдалануға дайын
Dialogue: 0,0:18:57.13,0:18:58.33,Default,,0,0,0,,Оянатын адам және
Dialogue: 0,0:18:59.06,0:18:59.96,Default,,0,0,0,,Беттерман
Dialogue: 0,0:19:00.40,0:19:01.50,Default,,0,0,0,,Ұрыс
Dialogue: 0,0:19:01.73,0:19:03.90,Default,,0,0,0,,Сіз әлі мас сияқтысыз.
Dialogue: 0,0:19:09.43,0:19:10.93,Default,,0,0,0,,Тоқта, Ке Чан.
Dialogue: 0,0:19:25.50,0:19:28.26,Default,,0,0,0,,Тұманды қауіпті заттардың нөсерімен бұзу
Dialogue: 0,0:19:28.46,0:19:30.56,Default,,0,0,0,,Әр түрлі уақытта босатылған синаптикалық зеңбірек
Dialogue: 0,0:19:31.03,0:19:34.33,Default,,0,0,0,,Сіз қозғалысты фазааралық желіммен орау арқылы тоқтаттыңыз ба?
Dialogue: 0,0:19:43.36,0:19:44.60,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:44.73,0:19:46.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:53.60,0:19:55.03,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:19:59.90,0:20:00.83,Default,,0,0,0,,Мамон Сенсей
Dialogue: 0,0:20:01.23,0:20:02.30,Default,,0,0,0,,Ал Хиёриге не болды?!
Dialogue: 0,0:20:02.66,0:20:04.26,Default,,0,0,0,,Сонда Ке Чан ше?
Dialogue: 0,0:20:04.83,0:20:06.33,Default,,0,0,0,,Уа
Dialogue: 0,0:20:06.56,0:20:07.60,Default,,0,0,0,,Каар
Dialogue: 0,0:20:08.36,0:20:09.70,Default,,0,0,0,,А-а-а
Dialogue: 0,0:20:13.93,0:20:14.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:29.36,0:20:30.43,Default,,0,0,0,,Содан кейін кезекте тұрғандарды жақсылап ұрып, ақшаларын тартып алады
Dialogue: 0,0:20:30.80,0:20:33.13,Default,,0,0,0,,Бұл қардан жасалған клон.
Dialogue: 0,0:20:33.30,0:20:35.83,Default,,0,0,0,,Соғыс
Dialogue: 0,0:20:40.36,0:20:41.76,Default,,0,0,0,,Уау
Dialogue: 0,0:20:41.83,0:20:43.73,Default,,0,0,0,,Мен оны жек көремін, о
Dialogue: 0,0:20:43.93,0:20:45.40,Default,,0,0,0,,Кя
Dialogue: 0,0:20:46.60,0:20:47.50,Default,,0,0,0,,Хиноки-сан
Dialogue: 0,0:20:50.86,0:20:53.10,Default,,0,0,0,,Қарғыс атқыр, сен мені кепілге алмақшысың ба?
Dialogue: 0,0:20:53.20,0:20:54.63,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:20:57.60,0:21:01.60,Default,,0,0,0,,Ой, қозғалма, Беттерман.
Dialogue: 0,0:21:02.80,0:21:06.26,Default,,0,0,0,,Көшсең, үмітің сөнеді.
Dialogue: 0,0:21:06.40,0:21:10.23,Default,,0,0,0,,Мен сенің денеңнің сырын білгім келеді.
Dialogue: 0,0:21:11.26,0:21:14.50,Default,,0,0,0,,Брахманның ең күшті адам нәсіліне айналуы үшін
Dialogue: 0,0:21:15.10,0:21:18.33,Default,,0,0,0,,Сіздің ДНҚ-ға Алджернон әсер етпейді.
Dialogue: 0,0:21:18.36,0:21:21.06,Default,,0,0,0,,Садақа беріңіз
Dialogue: 0,0:21:23.36,0:21:24.90,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:21:29.16,0:21:30.50,Default,,0,0,0,,Ооооооо
Dialogue: 0,0:21:32.60,0:21:34.13,Default,,0,0,0,,Беттерман, тезірек Хиноки-санды көр.
Dialogue: 0,0:21:34.26,0:21:35.10,Default,,0,0,0,,Гаук
Dialogue: 0,0:21:35.83,0:21:37.60,Default,,0,0,0,,Жоқ, бұл нақты емес.
Dialogue: 0,0:21:41.20,0:21:43.63,Default,,0,0,0,,Хахахахаха Бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:21:43.76,0:21:45.93,Default,,0,0,0,,Оны бір рет көтердік делік
Dialogue: 0,0:21:49.36,0:21:50.63,Default,,0,0,0,,Брахман қайда?
Dialogue: 0,0:21:52.03,0:21:55.80,Default,,0,0,0,,Ол кетті. Ол өте алыс кетті.
Dialogue: 0,0:21:56.73,0:21:58.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:00.13,0:22:00.83,Default,,0,0,0,,Ой
Dialogue: 0,0:22:08.73,0:22:10.50,Default,,0,0,0,,Кункель Неліктен
Dialogue: 0,0:22:12.73,0:22:16.66,Default,,0,0,0,,Хиноки хх мм
Dialogue: 0,0:22:17.03,0:22:17.66,Default,,0,0,0,,Га
Dialogue: 0,0:22:18.10,0:22:19.90,Default,,0,0,0,,Оны тез табыңыз
Dialogue: 0,0:22:20.73,0:22:22.93,Default,,0,0,0,,Қазір іздеу
Dialogue: 0,0:22:23.76,0:22:26.63,Default,,0,0,0,,маңызды
Dialogue: 0,0:22:27.20,0:22:30.16,Default,,0,0,0,,маңызды
Dialogue: 0,0:22:35.00,0:22:47.70,Default,,0,0,0,,Шексіз теломераларға ойылған Құдайдың күнәсі
Dialogue: 0,0:22:48.23,0:22:54.40,Default,,0,0,0,,Жалынды құшақтап алу
Dialogue: 0,0:22:54.90,0:23:01.93,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:02.20,0:23:05.53,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.80,0:23:08.96,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:09.16,0:23:12.46,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.66,0:23:15.86,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.80,0:23:27.66,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:28.00,0:23:37.53,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:38.23,0:23:49.16,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:59.36,0:24:02.90,Default,,0,0,0,,Алыстағы теңіз түбінде
Dialogue: 0,0:24:03.53,0:24:06.73,Default,,0,0,0,,Өлім уақыты жақындады
Dialogue: 0,0:24:07.66,0:24:11.66,Default,,0,0,0,,Өмірдің нұры сөнеді
Dialogue: 0,0:24:12.76,0:24:16.73,Default,,0,0,0,,Бір, екі, үш
Dialogue: 0,0:24:17.43,0:24:20.33,Default,,0,0,0,,О, енді тоқтат.
Dialogue: 0,0:24:21.60,0:24:23.46,Default,,0,0,0,,Жүрегіңіздің соғуы
Dialogue: 0,0:24:24.43,0:24:25.63,Default,,0,0,0,,Тоқта
Dialogue: 0,0:24:27.13,0:24:33.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
