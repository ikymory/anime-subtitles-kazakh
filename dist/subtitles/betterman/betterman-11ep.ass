Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.60,0:00:28.66,Default,,0,0,0,,Қате жеп өлгенше, аяғымды жеп өлгенім артық.
Dialogue: 0,0:00:30.76,0:00:31.66,Default,,0,0,0,,Торияааа
Dialogue: 0,0:00:34.26,0:00:35.10,Default,,0,0,0,,Тым
Dialogue: 0,0:00:36.06,0:00:36.73,Default,,0,0,0,,Сол жексұрын Аводл әлі тірі ғой, иә?
Dialogue: 0,0:00:37.50,0:00:39.36,Default,,0,0,0,,Менің қымбаттым Каори-чан, 17 жаста
Dialogue: 0,0:00:41.10,0:00:44.93,Default,,0,0,0,,Сәлеметсіз бе, мен KAORI, 17 жастамын.
Dialogue: 0,0:00:45.53,0:00:49.10,Default,,0,0,0,,Бәріміз мен жасаған иістерден ләззат алайық.
Dialogue: 0,0:00:56.83,0:00:59.20,Default,,0,0,0,,КАОРИ-чан, одан сайын көп жасай бер.
Dialogue: 0,0:00:59.40,0:01:02.60,Default,,0,0,0,,Жақсы иіс шығады. Көбірек жасаңыз.
Dialogue: 0,0:01:02.86,0:01:06.00,Default,,0,0,0,,Жақсы иіс шығады. Көбірек жасаңыз.
Dialogue: 0,0:01:08.70,0:01:09.73,Default,,0,0,0,,Ахх
Dialogue: 0,0:01:24.73,0:01:34.13,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:01:36.60,0:01:44.73,Default,,0,0,0,,Жүзетін күміс қайық
Dialogue: 0,0:01:46.60,0:01:55.00,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:01:58.40,0:02:06.73,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:02:09.53,0:02:18.36,Default,,0,0,0,,Рух тағы оянды
Dialogue: 0,0:02:18.80,0:02:26.83,Default,,0,0,0,,Жанға жол көрсету
Dialogue: 0,0:02:28.66,0:02:38.33,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:38.56,0:02:50.26,Default,,0,0,0,,Ағынмен қозғалма...
Dialogue: 0,0:02:55.43,0:02:57.83,Default,,0,0,0,,Еш ойланбастан ләззат алыңыз.
Dialogue: 0,0:02:58.20,0:02:59.10,Default,,0,0,0,,Ой, иә
Dialogue: 0,0:03:01.80,0:03:04.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:05.16,0:03:06.70,Default,,0,0,0,,Ааа
Dialogue: 0,0:03:12.03,0:03:13.03,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:03:13.66,0:03:14.10,Default,,0,0,0,,Сәлем
Dialogue: 0,0:03:19.96,0:03:20.40,Default,,0,0,0,,Ах
Dialogue: 0,0:03:20.93,0:03:22.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:23.03,0:03:25.70,Default,,0,0,0,,Мен өзімді жеңіл сезінемін.
Dialogue: 0,0:03:26.10,0:03:29.16,Default,,0,0,0,,А-а, мен жұлдыздарды көрдім.
Dialogue: 0,0:03:29.53,0:03:30.10,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:32.03,0:03:34.20,Default,,0,0,0,,Хаха хааан
Dialogue: 0,0:03:34.90,0:03:37.33,Default,,0,0,0,,Бұлттардың үстіне қара
Dialogue: 0,0:03:49.33,0:03:51.33,Default,,0,0,0,,Менің көру қабілетім нашар.
Dialogue: 0,0:03:55.56,0:03:58.63,Default,,0,0,0,,Хмм, мен осы уақытқа дейін жаңарттым.
Dialogue: 0,0:03:58.86,0:04:01.26,Default,,0,0,0,,Сіздің Super Robot K-100 дәл солай
Dialogue: 0,0:04:01.53,0:04:02.66,Default,,0,0,0,,Гохогогого…
Dialogue: 0,0:04:03.03,0:04:06.06,Default,,0,0,0,,Әке, дәрігер ұйықтау керек деді.
Dialogue: 0,0:04:07.50,0:04:10.00,Default,,0,0,0,,Десуваай
Dialogue: 0,0:04:12.83,0:04:14.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:14.93,0:04:17.23,Default,,0,0,0,,Сәлем Каппа-кун?
Dialogue: 0,0:04:17.76,0:04:18.23,Default,,0,0,0,,Ах
Dialogue: 0,0:04:19.13,0:04:20.00,Default,,0,0,0,,Хиноки
Dialogue: 0,0:04:23.76,0:04:26.30,Default,,0,0,0,,Көк балталы жігіттің бір жерден сынғаны анық.
Dialogue: 0,0:04:26.56,0:04:29.43,Default,,0,0,0,,Хиноки: Сен Кейтамен бала кезден доссың, солай ма?
Dialogue: 0,0:04:29.83,0:04:31.76,Default,,0,0,0,,Ол әрқашан табиғи болды ма?
Dialogue: 0,0:04:32.16,0:04:32.90,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:33.66,0:04:38.20,Default,,0,0,0,,Бірақ ол адамдар ойлағандай оғаш емес.
Dialogue: 0,0:04:38.93,0:04:39.53,Default,,0,0,0,,Ке Чан
Dialogue: 0,0:04:39.86,0:04:40.90,Default,,0,0,0,,Ке-чан?
Dialogue: 0,0:04:41.26,0:04:42.53,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:04:44.93,0:04:47.43,Default,,0,0,0,,Бұл да Эль-Ниньоға байланысты ма?
Dialogue: 0,0:04:47.66,0:04:50.76,Default,,0,0,0,,Жапонияның жартысынан көбі тұманда.
Dialogue: 0,0:04:51.40,0:04:55.16,Default,,0,0,0,,Сіздің арқаңызда жөндеу жұмыстары алға баспайды.
Dialogue: 0,0:04:55.80,0:04:58.16,Default,,0,0,0,,Мына өлі құртты қайда қою керек?
Dialogue: 0,0:04:58.63,0:05:01.90,Default,,0,0,0,,Мен оны Мордиварпқа мүмкіндігінше тезірек бергім келеді.
Dialogue: 0,0:05:02.20,0:05:02.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:08.70,0:05:11.26,Default,,0,0,0,,Сол кездегі қария?
Dialogue: 0,0:05:21.70,0:05:26.16,Default,,0,0,0,,Тұманды күнде рухтар әлемінің есігінің ашық екенін білдіреді.
Dialogue: 0,0:05:27.60,0:05:30.43,Default,,0,0,0,,Олар вампирлер жарқанатқа айналады дейді, солай ма?
Dialogue: 0,0:05:30.96,0:05:34.13,Default,,0,0,0,,Бірақ, күшті рухани күші бар вампирлер
Dialogue: 0,0:05:34.80,0:05:37.46,Default,,0,0,0,,Сіз сондай-ақ тұманға айналып, қозғала аласыз.
Dialogue: 0,0:05:46.43,0:05:47.20,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:49.50,0:05:50.46,Default,,0,0,0,,Әпке
Dialogue: 0,0:05:50.86,0:05:53.56,Default,,0,0,0,,Не болды, Риччан, ұмыттың ба?
Dialogue: 0,0:05:58.50,0:05:59.80,Default,,0,0,0,,Kyaaah
Dialogue: 0,0:05:59.90,0:06:03.63,Default,,0,0,0,,Мен бұл жиіркенішті жұмыс орнына енді шыдай алмаймын.
Dialogue: 0,0:06:04.73,0:06:07.43,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге Куниге қайтуға рұқсат етемін.
Dialogue: 0,0:06:08.43,0:06:12.73,Default,,0,0,0,,Бірдеңе деді де кетіп қалды, сондықтан қайтып келмейді деп ойладым.
Dialogue: 0,0:06:14.73,0:06:18.50,Default,,0,0,0,,Тұманның қалың болғаны сонша, пойыз қозғалмай қалды.
Dialogue: 0,0:06:20.56,0:06:24.46,Default,,0,0,0,,Мен өз пәтерімде жалғыз қалудан қорқамын, сондықтан осындамын.
Dialogue: 0,0:06:25.93,0:06:26.76,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:06:28.50,0:06:29.26,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:06:30.50,0:06:33.03,Default,,0,0,0,,Хинокимен қаншалықты алыс жүрдіңіз?
Dialogue: 0,0:06:33.20,0:06:33.66,Default,,0,0,0,,Ггаааах!
Dialogue: 0,0:06:34.10,0:06:36.53,Default,,0,0,0,,Екеуің кездесіп жүргендеріңді білемін.
Dialogue: 0,0:06:36.56,0:06:37.03,Default,,0,0,0,,Ой.
Dialogue: 0,0:06:37.06,0:06:39.80,Default,,0,0,0,,-Hehehehehehehe -Сіз біз бір жарым күндік жұмысты істеп жатырмыз деп тұрсыз.
Dialogue: 0,0:06:39.83,0:06:41.36,Default,,0,0,0,,A? Бұл В ме?
Dialogue: 0,0:06:41.53,0:06:42.00,Default,,0,0,0,,Уф
Dialogue: 0,0:06:43.50,0:06:45.36,Default,,0,0,0,,Иә, көп нәрсе.
Dialogue: 0,0:06:45.40,0:06:49.63,Default,,0,0,0,,Қарғыс атсын, жақсы жүрсің. Хе хе хе хе хе.
Dialogue: 0,0:06:49.90,0:06:52.26,Default,,0,0,0,,Жүр, кел, нанымыз таусылады.
Dialogue: 0,0:06:53.70,0:06:55.73,Default,,0,0,0,,Кей-чан, сен жараланған жоқсың ба?
Dialogue: 0,0:06:55.83,0:06:56.30,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:06:56.80,0:06:58.33,Default,,0,0,0,,Бүгін таңертең тағы құладың.
Dialogue: 0,0:06:58.63,0:07:00.63,Default,,0,0,0,,А-а, бұл үнемі болады.
Dialogue: 0,0:07:01.06,0:07:04.26,Default,,0,0,0,,Әй, бірақ мен көзілдірік жақтауларының қызмет ету мерзімі жақында келе ме деп ойлаймын.
Dialogue: 0,0:07:04.96,0:07:08.20,Default,,0,0,0,,Мен Хинокидің тірі екеніне қуаныштымын.
Dialogue: 0,0:07:09.20,0:07:12.13,Default,,0,0,0,,Рас, мен өзім сене алмаймын
Dialogue: 0,0:07:14.03,0:07:16.36,Default,,0,0,0,,Дәл сол бас сүңгуір Кактус өлді
Dialogue: 0,0:07:17.10,0:07:19.00,Default,,0,0,0,,Тіпті Хэчин мырзаның өзі Алджернон болатын.
Dialogue: 0,0:07:20.03,0:07:22.96,Default,,0,0,0,,Альджернон жаңа вирустан туындаған ба?
Dialogue: 0,0:07:23.60,0:07:25.13,Default,,0,0,0,,Бұл терроризмнің жаңа түрі ме?
Dialogue: 0,0:07:25.83,0:07:28.10,Default,,0,0,0,,Бұл белгісіз басқыншылардың ісі ме?
Dialogue: 0,0:07:28.96,0:07:33.13,Default,,0,0,0,,Біз шынайы тұлғаны түсіне алмайтын қазіргі жағдайда, тіпті оған қарсы қорғаныс таба алмаймыз.
Dialogue: 0,0:07:34.40,0:07:37.80,Default,,0,0,0,,Біз тек адамдардың өлетінін білеміз.
Dialogue: 0,0:07:38.86,0:07:41.53,Default,,0,0,0,,Хахахахахахахахаха
Dialogue: 0,0:07:41.96,0:07:44.80,Default,,0,0,0,,Тіпті алдыңғы директордың өзі есінен танып қалды.
Dialogue: 0,0:07:47.83,0:07:48.66,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:07:52.96,0:07:55.43,Default,,0,0,0,,Ал ауруханадағы улы тырнақ медбикесі.
Dialogue: 0,0:07:56.63,0:08:00.63,Default,,0,0,0,,Мен мұндай нәрсе болады деп ойламадым.
Dialogue: 0,0:08:01.63,0:08:02.16,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:08:03.53,0:08:06.00,Default,,0,0,0,,Үндістанда жоғалған отбасын іздеу
Dialogue: 0,0:08:06.76,0:08:10.80,Default,,0,0,0,,Әкемнің танысы Асами мырзамен жаңа ғана қызметтес болсам да.
Dialogue: 0,0:08:17.03,0:08:19.90,Default,,0,0,0,,Жарайды ахахаха хахахаха
Dialogue: 0,0:08:20.30,0:08:22.93,Default,,0,0,0,,Мен Хинокиге отбасын табуға көмектесемін.
Dialogue: 0,0:08:23.46,0:08:24.20,Default,,0,0,0,,Сонымен
Dialogue: 0,0:08:24.63,0:08:25.36,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:26.70,0:08:29.46,Default,,0,0,0,,Бірақ мен енді Neuronoid мінгім келмейді.
Dialogue: 0,0:08:30.93,0:08:33.03,Default,,0,0,0,,Басыңызды көтеріңіз.
Dialogue: 0,0:08:33.56,0:08:36.53,Default,,0,0,0,,Кез келген адам өз шегінен асып кетсе, құлауы мүмкін.
Dialogue: 0,0:08:36.96,0:08:40.53,Default,,0,0,0,,Сонымен қатар, сіз үшін бұрыштарды кесу жақсы идея емес.
Dialogue: 0,0:08:42.40,0:08:44.76,Default,,0,0,0,,Біріншіден, біз жай ғана қосалқы мердігерміз.
Dialogue: 0,0:08:45.00,0:08:47.20,Default,,0,0,0,,Тегіс болма.
Dialogue: 0,0:08:48.10,0:08:49.76,Default,,0,0,0,,Әй, сіз әңгімені естіген шығарсыз.
Dialogue: 0,0:08:50.30,0:08:53.53,Default,,0,0,0,,Мен нейроноидты беруге келістім.
Dialogue: 0,0:08:54.33,0:08:59.00,Default,,0,0,0,,Менен басқа қызметкерлер мүлдем қорқады.
Dialogue: 0,0:09:00.06,0:09:02.70,Default,,0,0,0,,Кешіріңіз, бірақ біздің жұмысымыз осында аяқталады.
Dialogue: 0,0:09:04.50,0:09:05.86,Default,,0,0,0,,Не болды? Аға
Dialogue: 0,0:09:09.30,0:09:10.93,Default,,0,0,0,,Ах ха ха
Dialogue: 0,0:09:11.80,0:09:12.26,Default,,0,0,0,,Ах
Dialogue: 0,0:09:14.50,0:09:17.06,Default,,0,0,0,,Титан шабуылына ұшыраған Трост ауданында,
Dialogue: 0,0:09:19.00,0:09:20.60,Default,,0,0,0,,Мұнда ерекше ештеңе жоқ.
Dialogue: 0,0:09:21.60,0:09:23.40,Default,,0,0,0,,Әлде бұл басқа жәндік пе?
Dialogue: 0,0:09:24.66,0:09:27.96,Default,,0,0,0,,Менің еліктеу қабілетіме кім кедергі жасайды?
Dialogue: 0,0:09:33.33,0:09:35.46,Default,,0,0,0,,Мен де кішкентай кезімде.
Dialogue: 0,0:09:35.83,0:09:40.40,Default,,0,0,0,,Мен үнемі жылайтынмын, өйткені айналамдағылардың бәрі мені ауыртады.
Dialogue: 0,0:09:41.26,0:09:45.90,Default,,0,0,0,,Әртүрлі болу жақсы болуы мүмкін, бірақ жалғыздық та болуы мүмкін.
Dialogue: 0,0:09:46.46,0:09:49.16,Default,,0,0,0,,Ана әке
Dialogue: 0,0:09:50.36,0:09:53.83,Default,,0,0,0,,Менің қолымнан ұстаңыз
Dialogue: 0,0:09:56.66,0:09:58.06,Default,,0,0,0,,Тұманның арғы жағында
Dialogue: 0,0:09:58.93,0:09:59.70,Default,,0,0,0,,Бар
Dialogue: 0,0:10:00.66,0:10:01.46,Default,,0,0,0,,Бар
Dialogue: 0,0:10:02.10,0:10:05.70,Default,,0,0,0,,Шодың інісі бар екенін айттым ба?
Dialogue: 0,0:10:06.46,0:10:07.90,Default,,0,0,0,,Теңіздің арғы жағында
Dialogue: 0,0:10:08.83,0:10:09.63,Default,,0,0,0,,Мен келемін
Dialogue: 0,0:10:10.56,0:10:11.33,Default,,0,0,0,,Мен келемін
Dialogue: 0,0:10:12.00,0:10:13.70,Default,,0,0,0,,Кетанмен алғаш танысқанда
Dialogue: 0,0:10:14.26,0:10:18.06,Default,,0,0,0,,Шо таң қалды, себебі ол інісіне сәл ұқсайды.
Dialogue: 0,0:10:19.73,0:10:20.36,Default,,0,0,0,,Кей
Dialogue: 0,0:10:20.56,0:10:22.40,Default,,0,0,0,,Ngggggggggggggg
Dialogue: 0,0:10:23.50,0:10:24.53,Default,,0,0,0,,И-иә… рас. Менің ағамдай… деп ойлаймын
Dialogue: 0,0:10:25.70,0:10:27.93,Default,,0,0,0,,Бала қайтыс болды.
Dialogue: 0,0:10:29.30,0:10:29.93,Default,,0,0,0,,Кэй
Dialogue: 0,0:10:38.10,0:10:38.90,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:39.56,0:10:42.06,Default,,0,0,0,,Осы уақытқа дейін барлығы үшін көп рахмет.
Dialogue: 0,0:10:42.50,0:10:44.80,Default,,0,0,0,,Мен де өз үйімді таба алмай жүрмін.
Dialogue: 0,0:10:45.20,0:10:47.60,Default,,0,0,0,,Алджернонның шынайы тұлғасы әлі де түсініксіз.
Dialogue: 0,0:10:48.03,0:10:50.20,Default,,0,0,0,,Мен көп өкінемін.
Dialogue: 0,0:10:50.56,0:10:53.63,Default,,0,0,0,,Жоқ, мен сізге бұдан былай қиындық туғыза алмаймын.
Dialogue: 0,0:10:54.23,0:10:57.70,Default,,0,0,0,,Әсіресе, мен Хиноки-сан мен Хота-кунға қауіп төндіре алмаймын.
Dialogue: 0,0:10:58.20,0:11:00.06,Default,,0,0,0,,-де балама бас сүңгуір болып табылады
Dialogue: 0,0:11:00.46,0:11:04.93,Default,,0,0,0,,Иә, арнайы дайындалған екі адам қазірдің өзінде күту режимінде.
Dialogue: 0,0:11:05.30,0:11:07.70,Default,,0,0,0,,Иә, иә, бұл жақсы болды.
Dialogue: 0,0:11:08.10,0:11:10.70,Default,,0,0,0,,3 күннен кейін тапсыру жұмысы Рахмет.
Dialogue: 0,0:11:11.20,0:11:11.90,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:11:12.86,0:11:15.06,Default,,0,0,0,,ҰМА-ның шынайы тұлғасы көрінді.
Dialogue: 0,0:11:16.33,0:11:20.16,Default,,0,0,0,,Мен білу үшін тез BPL-ге бара жатырмын.
Dialogue: 0,0:11:20.56,0:11:22.76,Default,,0,0,0,,Мен бұл BPL екеніне сенімдімін.
Dialogue: 0,0:11:23.00,0:11:26.00,Default,,0,0,0,,Бұл Куширодағы қандай да бір нысан болды ма?
Dialogue: 0,0:11:27.20,0:11:29.40,Default,,0,0,0,,Шикі азық-түлік ғылыми-зерттеу институты
Dialogue: 0,0:11:43.10,0:11:45.06,Default,,0,0,0,,Сіз Ламияға барасыз ба?
Dialogue: 0,0:11:46.30,0:11:48.13,Default,,0,0,0,,Тұмандықтың бір жемісі қалды
Dialogue: 0,0:11:50.06,0:11:53.53,Default,,0,0,0,,Сол кезде сол елде пайда болған форте жемісі
Dialogue: 0,0:11:54.70,0:11:57.40,Default,,0,0,0,,Үмітімізден жаралғанына дау жоқ.
Dialogue: 0,0:11:59.03,0:12:02.86,Default,,0,0,0,,Кінәлі үмітті жеп жатыр.
Dialogue: 0,0:12:04.16,0:12:05.93,Default,,0,0,0,,Біз дұрыс болдық
Dialogue: 0,0:12:08.06,0:12:10.53,Default,,0,0,0,,Сол өлкеде де жаңа өнім болды.
Dialogue: 0,0:12:11.86,0:12:12.50,Default,,0,0,0,,Сәл
Dialogue: 0,0:12:13.73,0:12:16.13,Default,,0,0,0,,Қазір тұманның арғы жағында саяхаттау уақыты
Dialogue: 0,0:12:17.30,0:12:19.03,Default,,0,0,0,,Бұл қиын шайқас болады.
Dialogue: 0,0:12:20.40,0:12:24.80,Default,,0,0,0,,Үміт күші жалғасуда, менің жеңу мүмкіндігім бар.
Dialogue: 0,0:12:25.86,0:12:26.53,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:12:27.33,0:12:31.36,Default,,0,0,0,,Біз іздеген нәрсе сонда да болуы керек.
Dialogue: 0,0:12:32.36,0:12:34.43,Default,,0,0,0,,Кінәлі болған билік
Dialogue: 0,0:12:37.33,0:12:41.26,Default,,0,0,0,,«Оянған адамды» мінгенде өзімді батырдай сезіндім.
Dialogue: 0,0:12:42.03,0:12:44.80,Default,,0,0,0,,Әй, менің еңбегім жоқ.
Dialogue: 0,0:12:45.46,0:12:47.16,Default,,0,0,0,,Нейроноидты қозғалта алу арқылы
Dialogue: 0,0:12:48.13,0:12:51.06,Default,,0,0,0,,Мен өзімді екі жақтымын деп ойладым.
Dialogue: 0,0:12:52.26,0:12:54.43,Default,,0,0,0,,iHub басқаруы
Dialogue: 0,0:13:01.73,0:13:02.90,Default,,0,0,0,,Мен оны алғаш мінгенде де
Dialogue: 0,0:13:03.26,0:13:05.90,Default,,0,0,0,,Мақсатына қарай өзгеретін роботты басқаруға болады.
Dialogue: 0,0:13:06.50,0:13:08.23,Default,,0,0,0,,Мен қатты қозғалғаным есімде.
Dialogue: 0,0:13:18.36,0:13:19.96,Default,,0,0,0,,Ноаааааааааааааааааааааааа
Dialogue: 0,0:13:29.06,0:13:31.56,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:13:43.63,0:13:46.00,Default,,0,0,0,,Мен де Тиранға мінсем деп ойладым.
Dialogue: 0,0:13:46.66,0:13:48.63,Default,,0,0,0,,Ол оянған адамға қарағанда орындауда әлдеқайда жақсы.
Dialogue: 0,0:13:49.26,0:13:51.46,Default,,0,0,0,,Мен оны дұрыс жұмыс істей алмауым мүмкін.
Dialogue: 0,0:13:57.33,0:13:59.13,Default,,0,0,0,,Күткендей, Ясанаги мырза керемет.
Dialogue: 0,0:14:02.13,0:14:06.70,Default,,0,0,0,,Каэде-сан сонымен қатар есеп шығаруды меңгеріп, орасан зор деректер жинады.
Dialogue: 0,0:14:07.23,0:14:08.63,Default,,0,0,0,,Тіпті иондарды да ыдыратуы мүмкін.
Dialogue: 0,0:14:12.16,0:14:13.73,Default,,0,0,0,,Хинокидің қос импульсі
Dialogue: 0,0:14:14.26,0:14:17.46,Default,,0,0,0,,Үзіліс синтезінен құралған деструктивті заттың тазалығын анықтаңыз.
Dialogue: 0,0:14:17.96,0:14:20.96,Default,,0,0,0,,Шамасы, ол оны басқаларға қарағанда тиімдірек арттыра алады.
Dialogue: 0,0:14:22.43,0:14:23.43,Default,,0,0,0,,Сара-чан сияқты нәрсе
Dialogue: 0,0:14:23.93,0:14:27.40,Default,,0,0,0,,Лимипидті арна арқылы нейроноидтың күйін оқып жатырсыз ба?
Dialogue: 0,0:14:27.93,0:14:31.03,Default,,0,0,0,,Сіз өзіңіздің өнімділігіңізден асатын қабілеттерді көрсете аласыз.
Dialogue: 0,0:14:33.16,0:14:36.93,Default,,0,0,0,,Бұл жақсы естеліктерге айналады, солай ма?
Dialogue: 0,0:14:37.96,0:14:40.76,Default,,0,0,0,,Мен өз жолымда бар күшімді саламын деп ойладым.
Dialogue: 0,0:14:41.53,0:14:43.93,Default,,0,0,0,,Оянған адамды енді мінудің қажеті жоқ.
Dialogue: 0,0:14:44.23,0:14:47.86,Default,,0,0,0,,Кенеттен осылай айтсаң да, мен қуанбаймын.
Dialogue: 0,0:14:49.43,0:14:52.66,Default,,0,0,0,,Хота-сансыз жақсылық жоқ
Dialogue: 0,0:14:53.16,0:14:55.63,Default,,0,0,0,,Иә, мен кейде қонаққа келемін.
Dialogue: 0,0:14:56.00,0:14:58.53,Default,,0,0,0,,Әй, айтпақшы, Сара-чан не болады?
Dialogue: 0,0:14:58.96,0:14:59.90,Default,,0,0,0,,Қайтадан ауруханаға жатқызылды ма?
Dialogue: 0,0:15:01.30,0:15:03.73,Default,,0,0,0,,Мен тұманның арғы жағынан қоңырау шалып жатырмын
Dialogue: 0,0:15:04.53,0:15:05.63,Default,,0,0,0,,Лимипидті арна?
Dialogue: 0,0:15:06.66,0:15:10.60,Default,,0,0,0,,Қайғылы ырымдарға толы
Dialogue: 0,0:15:11.33,0:15:12.10,Default,,0,0,0,,Уф хе
Dialogue: 0,0:15:13.00,0:15:15.56,Default,,0,0,0,,Қорқынышты қорқынышты
Dialogue: 0,0:15:16.36,0:15:18.93,Default,,0,0,0,,Менің қасымда болшы
Dialogue: 0,0:15:24.70,0:15:25.50,Default,,0,0,0,,Әкем
Dialogue: 0,0:15:26.16,0:15:26.83,Default,,0,0,0,,Мен
Dialogue: 0,0:15:29.10,0:15:29.96,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:15:30.80,0:15:31.50,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:15:33.66,0:15:35.53,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:15:38.86,0:15:41.40,Default,,0,0,0,,Бауырым, айтшы
Dialogue: 0,0:15:42.56,0:15:43.53,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:15:44.46,0:15:46.90,Default,,0,0,0,,Өйткені мен ақымақпын
Dialogue: 0,0:15:49.50,0:15:51.73,Default,,0,0,0,,Тұман біршама сейілді.
Dialogue: 0,0:15:54.10,0:15:55.76,Default,,0,0,0,,сарымсақ сарымсақ
Dialogue: 0,0:15:57.20,0:16:00.50,Default,,0,0,0,,Тиран мен Оянған отты кальмарды тапсыру кезінде
Dialogue: 0,0:16:00.80,0:16:04.40,Default,,0,0,0,,Мен сендерден қос деректерді қабылдауды сұраймын.
Dialogue: 0,0:16:05.40,0:16:07.66,Default,,0,0,0,,Осы уақытқа дейін болған оқиғалар үшін кешірім сұраймын.
Dialogue: 0,0:16:07.76,0:16:10.43,Default,,0,0,0,,Жоқ, өте қызық болды.
Dialogue: 0,0:16:14.93,0:16:16.90,Default,,0,0,0,,Асами-сан бүгін келмейді ме?
Dialogue: 0,0:16:17.46,0:16:19.23,Default,,0,0,0,,Хоккайдода әлі де болса керек
Dialogue: 0,0:16:21.03,0:16:25.60,Default,,0,0,0,,Осыдан төрт жыл бұрын доктор Аяның апатқа ұшырауына байланысты тергеу есеп беру жиналысы өтті.
Dialogue: 0,0:16:26.56,0:16:27.60,Default,,0,0,0,,Доктор Умезаки
Dialogue: 0,0:16:27.90,0:16:30.73,Default,,0,0,0,,Беттер Сіз қазірдің өзінде осындайсыз ба?
Dialogue: 0,0:16:31.76,0:16:35.16,Default,,0,0,0,,Ойлап қарасам, Кактус Прикл де өмірден өтті.
Dialogue: 0,0:16:35.46,0:16:37.33,Default,,0,0,0,,Бұл әлі де Алджернон ба?
Dialogue: 0,0:16:38.40,0:16:38.86,Default,,0,0,0,,Иә
Dialogue: 0,0:16:40.23,0:16:42.60,Default,,0,0,0,,Ах, мына күлгін жарық
Dialogue: 0,0:16:42.80,0:16:46.36,Default,,0,0,0,,Өсімдіктерге хлорофиллді оңай сіңіретін толқын ұзындығында.
Dialogue: 0,0:16:47.10,0:16:49.53,Default,,0,0,0,,Фотосинтезге ықпал ететін даналық
Dialogue: 0,0:16:50.33,0:16:51.43,Default,,0,0,0,,Бұл да дыбыс.
Dialogue: 0,0:16:51.83,0:16:55.93,Default,,0,0,0,,Бұл резонанс арқылы өсімдіктердің суды сіңіруін жеңілдететін әдіс.
Dialogue: 0,0:16:56.96,0:16:57.76,Default,,0,0,0,,бұл дұрыс
Dialogue: 0,0:16:58.66,0:17:02.03,Default,,0,0,0,,Гибберелл қышқылының белсенділігіне байланысты да өсу жылдамырақ.
Dialogue: 0,0:17:02.90,0:17:06.66,Default,,0,0,0,,Сіз гидропоникалық өсірумен де белсенді түрде айналысып жатқан сияқтысыз.
Dialogue: 0,0:17:08.83,0:17:13.66,Default,,0,0,0,,Мен сіз жіберген барлық материалдарды қарап шықтым.
Dialogue: 0,0:17:14.10,0:17:16.70,Default,,0,0,0,,Заманауи биотехнологияның алдыңғы қатарында
Dialogue: 0,0:17:17.33,0:17:20.13,Default,,0,0,0,,BPL әлемдегі азық-түлік жағдайын қолдайды
Dialogue: 0,0:17:21.06,0:17:23.20,Default,,0,0,0,,Оның директоры, доктор Умезакиге,
Dialogue: 0,0:17:23.83,0:17:25.26,Default,,0,0,0,,UMA серияларына қатысты
Dialogue: 0,0:17:25.80,0:17:29.36,Default,,0,0,0,,Сіз маған пайдалы ақпарат бере аласыз деп ойладым.
Dialogue: 0,0:17:32.63,0:17:34.63,Default,,0,0,0,,Сізге қалай ұнайды? бір нәрсе
Dialogue: 0,0:17:35.13,0:17:36.83,Default,,0,0,0,,А, жоқ, мен.
Dialogue: 0,0:17:38.20,0:17:42.03,Default,,0,0,0,,Жәндіктер келесі ұрпақ үшін құнды ақуыз көзі болып табылады.
Dialogue: 0,0:17:43.80,0:17:44.93,Default,,0,0,0,,Ааа хааан
Dialogue: 0,0:17:45.30,0:17:49.63,Default,,0,0,0,,Жәндік денесінің бір бөлігін жоғалтып алса да, терісін төгу арқылы қалпына келеді.
Dialogue: 0,0:17:50.73,0:17:53.90,Default,,0,0,0,,Өрмекшілердің кейбір түрлері 30 жыл өмір сүреді.
Dialogue: 0,0:17:55.06,0:17:57.36,Default,,0,0,0,,Адамзат үшін.
Dialogue: 0,0:17:57.66,0:18:00.96,Default,,0,0,0,,Тіршіліктің супер формаларының болуы шексіз қызығушылық тудырады.
Dialogue: 0,0:18:02.86,0:18:04.06,Default,,0,0,0,,Маған хабарлаңыз
Dialogue: 0,0:18:05.46,0:18:06.80,Default,,0,0,0,,Беттермен туралы
Dialogue: 0,0:18:07.23,0:18:07.70,Default,,0,0,0,,Га
Dialogue: 0,0:18:08.30,0:18:10.30,Default,,0,0,0,,Mordiwarp және BPL
Dialogue: 0,0:18:10.96,0:18:13.70,Default,,0,0,0,,Бауырлас мекемелердің екеуі де NEO-дан тараған
Dialogue: 0,0:18:14.46,0:18:18.06,Default,,0,0,0,,Біздің түпкі мақсатымыз бір болуы керек, солай емес пе?
Dialogue: 0,0:18:21.53,0:18:24.70,Default,,0,0,0,,Беттерман Ламия деп аталатын гуманоидтан шыққан.
Dialogue: 0,0:18:25.03,0:18:29.93,Default,,0,0,0,,Әр түрлі жауынгерлік формаларға айналу мүмкіндігі расталды.
Dialogue: 0,0:18:35.83,0:18:38.80,Default,,0,0,0,,Тұмандық ұшуға қабілетті пішін
Dialogue: 0,0:18:45.83,0:18:47.26,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:18:48.36,0:18:52.10,Default,,0,0,0,,Гуаааааааааааа
Dialogue: 0,0:18:52.16,0:18:55.90,Default,,0,0,0,,Және Беттерманның ең күшті түрі, Форте
Dialogue: 0,0:18:57.13,0:18:59.93,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:19:09.20,0:19:13.20,Default,,0,0,0,,Сонымен қатар, Aqua - су астындағы шайқастарға маманданған пішін.
Dialogue: 0,0:19:16.66,0:19:20.20,Default,,0,0,0,,Оның жүзу жылдамдығы ауада ұшуға қарағанда жылдамырақ.
Dialogue: 0,0:19:35.96,0:19:38.73,Default,,0,0,0,,Қарсылас UMA-ның дене сұйықтықтарын сіңіріп, талдаңыз
Dialogue: 0,0:19:42.66,0:19:47.63,Default,,0,0,0,,Содан кейін олар дәл сол ДНҚ-ға ұқсайтын жалған жасушалар жасап, оларды мұхитқа таратып жіберді.
Dialogue: 0,0:19:48.50,0:19:50.03,Default,,0,0,0,,Бұл апоптоз
Dialogue: 0,0:19:50.63,0:19:54.90,Default,,0,0,0,,Басқаша айтқанда, ол UMA денесінің жасушаларына өзін-өзі өлтіру туралы бұйрық жібереді және олардың өліміне әкеледі.
Dialogue: 0,0:19:55.06,0:19:56.10,Default,,0,0,0,,Өлімге әкелетін сұйықтық
Dialogue: 0,0:19:57.26,0:19:58.26,Default,,0,0,0,,Психосұйықтық
Dialogue: 0,0:20:00.13,0:20:03.40,Default,,0,0,0,,Біздің жалпы санамыздан тыс тіршілік формасы Беттерман
Dialogue: 0,0:20:06.26,0:20:08.70,Default,,0,0,0,,Ааааааааааааааааааааааа
Dialogue: 0,0:20:08.73,0:20:11.63,Default,,0,0,0,,Екі форма да сома сияқты нәрсені жеуді қамтиды.
Dialogue: 0,0:20:11.93,0:20:14.06,Default,,0,0,0,,Трансформацияның катализаторы сияқты.
Dialogue: 0,0:20:15.56,0:20:17.46,Default,,0,0,0,,Олай болса, мен оны білемін.
Dialogue: 0,0:20:17.63,0:20:18.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:18.83,0:20:19.30,Default,,0,0,0,,Уф
Dialogue: 0,0:20:21.10,0:20:21.76,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:20:22.33,0:20:26.83,Default,,0,0,0,,Аа, мен доктор Цуконың есептеулеріне таң қалдым.
Dialogue: 0,0:20:28.03,0:20:31.06,Default,,0,0,0,,Зертханаға қайтып бару керек.
Dialogue: 0,0:20:32.73,0:20:34.86,Default,,0,0,0,,Анимус гүлі
Dialogue: 0,0:20:45.60,0:20:46.40,Default,,0,0,0,,Тұмандық жемісі
Dialogue: 0,0:20:47.76,0:20:48.26,Default,,0,0,0,,Ах
Dialogue: 0,0:20:50.23,0:20:51.96,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:20:52.96,0:20:55.86,Default,,0,0,0,,Бір нәрсенің иісі өте жақсы.
Dialogue: 0,0:20:56.93,0:20:58.16,Default,,0,0,0,,Гүлдің шырыны сияқты
Dialogue: 0,0:20:59.73,0:21:02.36,Default,,0,0,0,,Анимустың иісі емес
Dialogue: 0,0:21:06.36,0:21:10.40,Default,,0,0,0,,Доктор Цуко, сіз оны қалайсыз ба?
Dialogue: 0,0:21:11.33,0:21:11.96,Default,,0,0,0,,Иә
Dialogue: 0,0:21:13.03,0:21:14.26,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:21:22.26,0:21:24.50,Default,,0,0,0,,Хмм, дәмді
Dialogue: 0,0:21:25.13,0:21:25.66,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:26.60,0:21:27.50,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:21:27.66,0:21:31.63,Default,,0,0,0,,Қалағаныңызша рахат алыңыз, доктор Цуко.
Dialogue: 0,0:21:32.30,0:21:33.76,Default,,0,0,0,,Ммммм ааа
Dialogue: 0,0:21:35.20,0:21:37.83,Default,,0,0,0,,Пухаххххххххххххххххххххххххххх
Dialogue: 0,0:21:38.60,0:21:42.06,Default,,0,0,0,,Аспан – көкте, аспан – жерде
Dialogue: 0,0:21:42.73,0:21:45.93,Default,,0,0,0,,Аспанда жұлдыздар бар, жерде жұлдыздар бар.
Dialogue: 0,0:21:46.70,0:21:50.60,Default,,0,0,0,,Аспанда бар нәрсенің бәрі жерде де бар.
Dialogue: 0,0:21:51.26,0:21:54.30,Default,,0,0,0,,Жұмбақтары шешілгендер бақытты.
Dialogue: 0,0:21:55.90,0:21:58.43,Default,,0,0,0,,Мен Асамидің әпкесінен хабар алған жоқпын ба?
Dialogue: 0,0:21:58.90,0:21:59.43,Default,,0,0,0,,Иә
Dialogue: 0,0:22:00.06,0:22:02.86,Default,,0,0,0,,Тіпті BPL шығысынан батысқа қарай созылатын қосылатын жолдар
Dialogue: 0,0:22:03.50,0:22:04.86,Default,,0,0,0,,Оны жер мен құм бөгеп тұрған сияқты.
Dialogue: 0,0:22:05.26,0:22:08.76,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:22:08.80,0:22:12.23,Default,,0,0,0,,Мен өлтіремін, өлтіремін.
Dialogue: 0,0:22:13.03,0:22:16.06,Default,,0,0,0,,Тез, тез маған көмектес.
Dialogue: 0,0:22:16.46,0:22:18.30,Default,,0,0,0,,Бұл басқарудың жолы емес.
Dialogue: 0,0:22:18.70,0:22:19.86,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:22:21.96,0:22:23.10,Default,,0,0,0,,Кейта
Dialogue: 0,0:22:25.10,0:22:25.86,Default,,0,0,0,,Канди
Dialogue: 0,0:22:34.73,0:22:47.30,Default,,0,0,0,,Құдайдың күнәсі шексіз теломераларға жазылды
Dialogue: 0,0:22:47.90,0:22:54.03,Default,,0,0,0,,Жалынды құшақтау
Dialogue: 0,0:22:54.33,0:23:01.70,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:01.96,0:23:05.16,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.50,0:23:08.66,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.86,0:23:12.03,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.30,0:23:15.56,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.63,0:23:27.10,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:27.73,0:23:37.20,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:37.96,0:23:49.03,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:58.66,0:24:01.53,Default,,0,0,0,,Тұманның ар жағында жылау
Dialogue: 0,0:24:02.06,0:24:04.50,Default,,0,0,0,,Үш айдаһар күтіп тұр
Dialogue: 0,0:24:05.56,0:24:07.06,Default,,0,0,0,,Қайғылы жер
Dialogue: 0,0:24:08.03,0:24:11.60,Default,,0,0,0,,Құдайдың ережелеріне қарсы тұратын бекініс
Dialogue: 0,0:24:12.73,0:24:15.26,Default,,0,0,0,,Өлтіріңіз немесе өлтіріңіз
Dialogue: 0,0:24:16.13,0:24:19.36,Default,,0,0,0,,Өткір азу тістері ұстап алды
Dialogue: 0,0:24:20.46,0:24:22.16,Default,,0,0,0,,Тамағың
Dialogue: 0,0:24:23.16,0:24:24.50,Default,,0,0,0,,сызат
Dialogue: 0,0:24:26.00,0:24:32.00,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
