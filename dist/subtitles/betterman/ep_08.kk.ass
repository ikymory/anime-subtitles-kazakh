Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:41.73,0:00:44.53,Default,,0,0,0,,Бүгін ашық емес
Dialogue: 0,0:00:45.40,0:00:46.93,Default,,0,0,0,,Мен ештеңе естімеймін
Dialogue: 0,0:00:47.50,0:00:48.96,Default,,0,0,0,,Мен ештеңе көре алмаймын
Dialogue: 0,0:00:49.66,0:00:51.23,Default,,0,0,0,,Менің кілтім
Dialogue: 0,0:00:51.93,0:00:53.23,Default,,0,0,0,,Ол сынған
Dialogue: 0,0:00:59.90,0:01:00.43,Default,,0,0,0,,Га
Dialogue: 0,0:01:00.63,0:01:02.70,Default,,0,0,0,,Амансың ба? Сара-чан
Dialogue: 0,0:01:05.70,0:01:06.26,Default,,0,0,0,,Иә
Dialogue: 0,0:01:07.40,0:01:11.43,Default,,0,0,0,,Бірақ мен ештеңе түсінбеймін
Dialogue: 0,0:01:13.73,0:01:23.30,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:01:25.70,0:01:33.70,Default,,0,0,0,,Қалқымалы күміс қайық
Dialogue: 0,0:01:35.53,0:01:44.40,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:01:47.33,0:01:55.16,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:01:58.53,0:02:07.23,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:02:07.80,0:02:15.96,Default,,0,0,0,,Жанға бағыт беру
Dialogue: 0,0:02:17.76,0:02:27.33,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:27.56,0:02:39.43,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:02:45.13,0:02:47.66,Default,,0,0,0,,Үндістанға сапар өте қиын болды ма?
Dialogue: 0,0:02:48.20,0:02:50.43,Default,,0,0,0,,Сіз жүйкеңізге қатты қысым жасаған сияқтысыз.
Dialogue: 0,0:02:51.10,0:02:52.20,Default,,0,0,0,,Лимипидті арна болып табылады
Dialogue: 0,0:02:52.33,0:02:55.43,Default,,0,0,0,,Адамдардың ортақ санасын қабылдайтын радио сияқты.
Dialogue: 0,0:02:56.06,0:02:57.76,Default,,0,0,0,,Сіз күйде болуыңыз мүмкін.
Dialogue: 0,0:03:01.10,0:03:04.46,Default,,0,0,0,,Лимичанды үнемі ашпаған дұрыс.
Dialogue: 0,0:03:04.86,0:03:07.00,Default,,0,0,0,,Мен Сакораға қуаныштымын.
Dialogue: 0,0:03:09.06,0:03:13.93,Default,,0,0,0,,Оң жақ №26 жетек 26 адам қарауы керек.
Dialogue: 0,0:03:14.00,0:03:15.46,Default,,0,0,0,,Әдеттегідей.
Dialogue: 0,0:03:15.53,0:03:18.43,Default,,0,0,0,,Өйткені, бұл 26 есе тиімдірек.
Dialogue: 0,0:03:18.86,0:03:22.06,Default,,0,0,0,,26 дана бөлшектердің құны өседі.
Dialogue: 0,0:03:22.40,0:03:25.83,Default,,0,0,0,,-Ол сізді 26 сағатты үнемдей алады. - Алджернон?
Dialogue: 0,0:03:26.40,0:03:27.43,Default,,0,0,0,,Француз тармағында
Dialogue: 0,0:03:27.83,0:03:31.73,Default,,0,0,0,,Кейбір сарапшылар бұл эндокриндік бұзылулар тудыратын лиганд аномалиясы деп санайды.
Dialogue: 0,0:03:33.30,0:03:37.86,Default,,0,0,0,,Үндістанға экспедиция оның шынайы тұлғасын білу үшін барлығы құм астында.
Dialogue: 0,0:03:38.33,0:03:42.33,Default,,0,0,0,,Бұлай жалғаса берсе, ДНҚ-дағы митохондриялар АТФ жоғалады.
Dialogue: 0,0:03:44.00,0:03:44.83,Default,,0,0,0,,Алты ай ішінде
Dialogue: 0,0:03:46.36,0:03:50.13,Default,,0,0,0,,Әйтеуір мен терапия деп аталатын жаңа емді қолданып көрейін деп шештім.
Dialogue: 0,0:03:50.40,0:03:51.93,Default,,0,0,0,,Аурухана осылай деді.
Dialogue: 0,0:03:53.46,0:03:54.13,Default,,0,0,0,,Бірақ
Dialogue: 0,0:03:55.00,0:04:00.13,Default,,0,0,0,,26 қабатты ғимараттан 26 адам 26 метр...
Dialogue: 0,0:04:09.43,0:04:12.53,Default,,0,0,0,,Бұл гүлді Аджантадан жинай алатыныңа сенбеймін.
Dialogue: 0,0:04:13.86,0:04:15.63,Default,,0,0,0,,Үндістанның Аджанта үңгірлері
Dialogue: 0,0:04:16.26,0:04:18.00,Default,,0,0,0,,Гяаа
Dialogue: 0,0:04:18.26,0:04:22.66,Default,,0,0,0,,Арнайы ультрадыбыстық толқындар арқылы адамның миын шатастырып, оны жер асты үңгіріне тарту.
Dialogue: 0,0:04:23.53,0:04:25.86,Default,,0,0,0,,Жұмбақ тіршілік иесі Бегемот
Dialogue: 0,0:04:26.93,0:04:29.93,Default,,0,0,0,,Бір жерге жиналғанымызға қарағанда.
Dialogue: 0,0:04:30.36,0:04:32.93,Default,,0,0,0,,Ақыр аяғында адамдарға жем болу мақсаты болды ма?
Dialogue: 0,0:04:34.46,0:04:35.86,Default,,0,0,0,,Кейін білдім
Dialogue: 0,0:04:36.40,0:04:40.30,Default,,0,0,0,,Бұл шақыруды Акаматсу Джоның ультрадыбыстық жәндіктерге қарсы құралы жасады.
Dialogue: 0,0:04:40.60,0:04:43.40,Default,,0,0,0,,Нәзік болғаны сонша, тиімділігін жоғалтты.
Dialogue: 0,0:04:44.40,0:04:46.00,Default,,0,0,0,,Үңгір ішіндегі Хота-кун және т.б
Dialogue: 0,0:04:46.80,0:04:48.83,Default,,0,0,0,,Сыртта Акамацу Когио адамдары
Dialogue: 0,0:04:49.80,0:04:52.66,Default,,0,0,0,,Мен жер асты лабиринтінде бұл қоңырауды естігенде
Dialogue: 0,0:04:53.56,0:04:55.53,Default,,0,0,0,,Екі жағдайда да, сол жәндіктерге қарсы құралмен
Dialogue: 0,0:04:55.86,0:04:58.93,Default,,0,0,0,,Галлюцинация тудыратын ультрадыбыстық толқындар жойылады
Dialogue: 0,0:04:59.83,0:05:04.16,Default,,0,0,0,,Нерв тінінің сынама нәтижелері бәрімізде теріс болғандықтан.
Dialogue: 0,0:05:04.50,0:05:08.23,Default,,0,0,0,,Бегемоттың шақыруы Алджернонға себеп болуы екіталай.
Dialogue: 0,0:05:10.53,0:05:13.76,Default,,0,0,0,,Осыдан төрт жыл бұрын доктор Аяның кеші хабарсыз кеткен
Dialogue: 0,0:05:14.26,0:05:17.00,Default,,0,0,0,,Сондай-ақ, Мордиварптың алдыңғы тобы бұл жолы қайда?
Dialogue: 0,0:05:19.13,0:05:21.56,Default,,0,0,0,,Қазба жұмыстары өте қиын болып қала береді
Dialogue: 0,0:05:22.96,0:05:26.90,Default,,0,0,0,,Ал Беттерман Форте жаңа трансформацияны көрсетті.
Dialogue: 0,0:05:30.06,0:05:33.43,Default,,0,0,0,,Қабілетті жаудың денесіне тигізу арқылы алуға болады.
Dialogue: 0,0:05:33.76,0:05:37.50,Default,,0,0,0,,Материалдың құлау нүктесін, қирау нүктесін табыңыз.
Dialogue: 0,0:05:38.70,0:05:43.43,Default,,0,0,0,,Басына лезде жойылуға әкелетін сырғымалы қылыш бар.
Dialogue: 0,0:05:52.90,0:05:53.90,Default,,0,0,0,,Психо даңқы
Dialogue: 0,0:05:53.93,0:05:55.90,Default,,0,0,0,,Гуоо
Dialogue: 0,0:05:56.76,0:05:58.93,Default,,0,0,0,,Адамның санасынан тыс жаратылыстар
Dialogue: 0,0:05:59.80,0:06:03.46,Default,,0,0,0,,Форте мен Бегемот шынымен де сонда болды ма?
Dialogue: 0,0:06:04.70,0:06:07.10,Default,,0,0,0,,Мүмкін бәрі біздікі шығар
Dialogue: 0,0:06:14.76,0:06:15.96,Default,,0,0,0,,А, кешіріңіз.
Dialogue: 0,0:06:17.86,0:06:21.63,Default,,0,0,0,,Жанашырлық таныту үшін бірдеңе әкелген дұрыс, хаха.
Dialogue: 0,0:06:22.23,0:06:23.56,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:06:24.86,0:06:28.93,Default,,0,0,0,,Сара-чан болса, әдемі гүл шоғындай болар еді.
Dialogue: 0,0:06:29.73,0:06:33.70,Default,,0,0,0,,Сара-чанға шие гүлі жоқ, хехехехехе
Dialogue: 0,0:06:34.06,0:06:35.80,Default,,0,0,0,,Эй, сен қалай ойлайсың? Хиноки
Dialogue: 0,0:06:37.60,0:06:38.33,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:06:38.63,0:06:39.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:42.53,0:06:45.50,Default,,0,0,0,,Жалғыз барсам әлі де жасамаймын.
Dialogue: 0,0:06:45.90,0:06:48.06,Default,,0,0,0,,Ааа
Dialogue: 0,0:06:49.60,0:06:50.73,Default,,0,0,0,,Хмм, неге?
Dialogue: 0,0:07:36.36,0:07:37.33,Default,,0,0,0,,Ә? Мүмкін емес…
Dialogue: 0,0:07:38.16,0:07:39.66,Default,,0,0,0,,Мен ауырсынуды жек көремін
Dialogue: 0,0:07:39.90,0:07:40.43,Default,,0,0,0,,Уау
Dialogue: 0,0:07:43.23,0:07:44.10,Default,,0,0,0,,Кейта мырза
Dialogue: 0,0:07:44.63,0:07:49.40,Default,,0,0,0,,Е, хе, таң қалдың ба? Хехехехехе
Dialogue: 0,0:07:53.03,0:07:54.06,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:07:54.60,0:07:55.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:55.76,0:07:58.40,Default,,0,0,0,,Кейта-санның мені көруге келетініне сене алар емеспін.
Dialogue: 0,0:07:59.63,0:08:01.33,Default,,0,0,0,,Өйткені мен олай ойламадым.
Dialogue: 0,0:08:02.06,0:08:03.66,Default,,0,0,0,,О, жоқ хаха
Dialogue: 0,0:08:03.96,0:08:07.16,Default,,0,0,0,,Таңертең барлығы келді.
Dialogue: 0,0:08:08.06,0:08:10.70,Default,,0,0,0,,Бірақ мен енді ешкім келмейді деп ойладым.
Dialogue: 0,0:08:10.90,0:08:12.80,Default,,0,0,0,,Хе хе хе хе хе?
Dialogue: 0,0:08:13.03,0:08:14.86,Default,,0,0,0,,Ууу
Dialogue: 0,0:08:15.86,0:08:19.10,Default,,0,0,0,,...
Dialogue: 0,0:08:19.70,0:08:20.40,Default,,0,0,0,,Сара-сан
Dialogue: 0,0:08:20.46,0:08:22.73,Default,,0,0,0,,Ех уау хе хе хе хе
Dialogue: 0,0:08:23.26,0:08:24.36,Default,,0,0,0,,Тексеру уақыты келді
Dialogue: 0,0:08:25.20,0:08:28.00,Default,,0,0,0,,Қайта ауырады ма?
Dialogue: 0,0:08:28.33,0:08:29.26,Default,,0,0,0,,Асығыңыз
Dialogue: 0,0:08:35.93,0:08:36.70,Default,,0,0,0,,Кейта мырза
Dialogue: 0,0:08:37.16,0:08:40.16,Default,,0,0,0,,Мен қайтып келгенше кетпе.
Dialogue: 0,0:08:41.20,0:08:43.80,Default,,0,0,0,,Иә, мен күтемін.
Dialogue: 0,0:08:44.30,0:08:45.73,Default,,0,0,0,,Аурухана іші тыныш
Dialogue: 0,0:08:45.83,0:08:49.80,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:52.53,0:08:53.76,Default,,0,0,0,,Не?
Dialogue: 0,0:08:57.20,0:08:57.63,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:03.93,0:09:05.26,Default,,0,0,0,,Ештеңе жазылмаған
Dialogue: 0,0:09:06.23,0:09:06.96,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:18.83,0:09:23.23,Default,,0,0,0,,Мм, бүгінгі сынақ әдеттегіден өзгеше ме?
Dialogue: 0,0:09:23.50,0:09:24.10,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:09:25.70,0:09:29.03,Default,,0,0,0,,Сабыр сақтасаң, тез бітеді.
Dialogue: 0,0:09:30.46,0:09:31.50,Default,,0,0,0,,Хм. Хахахаха
Dialogue: 0,0:09:41.46,0:09:42.63,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,0:09:43.63,0:09:44.10,Default,,0,0,0,,Әй
Dialogue: 0,0:09:44.70,0:09:47.80,Default,,0,0,0,,Сара-чанның қолдары сондай жұмсақ еді.
Dialogue: 0,0:09:47.83,0:09:51.86,Default,,0,0,0,,Хм хехе хехе хехе
Dialogue: 0,0:09:52.26,0:09:56.13,Default,,0,0,0,,Мм, ол қай аурухана бөлмесінде болды?
Dialogue: 0,0:09:57.66,0:09:59.63,Default,,0,0,0,,А, менің ойымша, бұл осында болды.
Dialogue: 0,0:10:02.03,0:10:03.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:03.83,0:10:07.63,Default,,0,0,0,,Жоқ, мен қателесіппін. Кешіріңіз.
Dialogue: 0,0:10:08.93,0:10:09.73,Default,,0,0,0,,Жақсы
Dialogue: 0,0:10:13.03,0:10:14.73,Default,,0,0,0,,Шегелер иә?
Dialogue: 0,0:10:15.13,0:10:15.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:17.30,0:10:20.06,Default,,0,0,0,,Мен оның қандай да бір емдеу үшін қолданылатынына сенімдімін.
Dialogue: 0,0:10:22.36,0:10:23.30,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:10:23.40,0:10:23.86,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:33.53,0:10:36.70,Default,,0,0,0,,Кешіріңіз. Мен жақында кетемін.
Dialogue: 0,0:10:39.90,0:10:42.03,Default,,0,0,0,,Жалған шегелер
Dialogue: 0,0:10:52.10,0:10:52.96,Default,,0,0,0,,Сакура
Dialogue: 0,0:10:59.00,0:11:02.33,Default,,0,0,0,,Хмм? Бұл шынымен сирек болды ма?
Dialogue: 0,0:11:02.76,0:11:05.83,Default,,0,0,0,,Ол гүлдер негізінен үңгірлерде өседі, және
Dialogue: 0,0:11:06.03,0:11:07.00,Default,,0,0,0,,Өйткені оның жапырақтары жоқ
Dialogue: 0,0:11:07.43,0:11:10.50,Default,,0,0,0,,Фотосинтезсіз қоректік заттарды қалай аламыз?
Dialogue: 0,0:11:10.93,0:11:12.43,Default,,0,0,0,,Әлі шешілмеген
Dialogue: 0,0:11:13.16,0:11:16.96,Default,,0,0,0,,Еуропа мен Америкада оны өлім әкелетін гүлді анимус деп те атайды.
Dialogue: 0,0:11:18.26,0:11:20.10,Default,,0,0,0,,Өлім әкелетін гүл
Dialogue: 0,0:11:20.36,0:11:23.53,Default,,0,0,0,,Бұл қосалқы мердігерлер ретінде біз үшін тым ауыр жүк.
Dialogue: 0,0:11:23.73,0:11:26.63,Default,,0,0,0,,Үздіксіз ынтымақтастық үшін рахмет.
Dialogue: 0,0:11:27.10,0:11:27.90,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:28.80,0:11:30.10,Default,,0,0,0,,Бұл біз мінген кеме.
Dialogue: 0,0:11:30.46,0:11:32.63,Default,,0,0,0,,-Шааанми -Қолайсыздық үшін кешіріңіз.
Dialogue: 0,0:11:41.90,0:11:42.76,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:11:44.23,0:11:45.60,Default,,0,0,0,,Hihihihihihihii
Dialogue: 0,0:11:46.90,0:11:48.26,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:11:50.46,0:11:52.63,Default,,0,0,0,,Хэхехехе о татата
Dialogue: 0,0:12:03.23,0:12:05.70,Default,,0,0,0,,Бұл қандай аурухана?
Dialogue: 0,0:12:09.43,0:12:10.06,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:12:15.33,0:12:16.10,Default,,0,0,0,,Иә
Dialogue: 0,0:12:17.06,0:12:17.53,Default,,0,0,0,,Ах
Dialogue: 0,0:12:18.66,0:12:19.33,Default,,0,0,0,,О
Dialogue: 0,0:12:22.30,0:12:24.30,Default,,0,0,0,,Ууу
Dialogue: 0,0:12:30.26,0:12:32.23,Default,,0,0,0,,Хехехехе хахахахаха
Dialogue: 0,0:12:32.26,0:12:35.16,Default,,0,0,0,,Уухахахаа
Dialogue: 0,0:12:36.10,0:12:36.53,Default,,0,0,0,,Ах
Dialogue: 0,0:12:37.26,0:12:38.23,Default,,0,0,0,,Хихихихихи
Dialogue: 0,0:12:39.06,0:12:41.40,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:12:44.53,0:12:44.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:48.16,0:12:48.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:50.80,0:12:52.70,Default,,0,0,0,,Прето Жоқ
Dialogue: 0,0:12:53.46,0:12:55.26,Default,,0,0,0,,Сізге қауіпті жерлер ұнамайды.
Dialogue: 0,0:12:55.53,0:12:58.43,Default,,0,0,0,,А, сен
Dialogue: 0,0:12:59.46,0:13:01.46,Default,,0,0,0,,Хота көрген қыз
Dialogue: 0,0:13:01.73,0:13:05.10,Default,,0,0,0,,Орманда тұратын қорқынышты сою құдайы.
Dialogue: 0,0:13:05.40,0:13:07.90,Default,,0,0,0,,Бұл сөзсіз Чанди.
Dialogue: 0,0:13:08.13,0:13:10.33,Default,,0,0,0,,Сіз Кэндисіз бе?
Dialogue: 0,0:13:11.26,0:13:12.23,Default,,0,0,0,,Кәмпит?
Dialogue: 0,0:13:12.80,0:13:14.86,Default,,0,0,0,,Күткендей ол сөйлемейді.
Dialogue: 0,0:13:16.46,0:13:17.83,Default,,0,0,0,,-Мм? Күй - Хмф
Dialogue: 0,0:13:21.43,0:13:21.86,Default,,0,0,0,,Га
Dialogue: 0,0:13:23.46,0:13:24.66,Default,,0,0,0,,Раксаша
Dialogue: 0,0:13:42.10,0:13:45.06,Default,,0,0,0,,Бұл, әрине, мен Аджантада кездестірген Будда.
Dialogue: 0,0:13:45.76,0:13:47.00,Default,,0,0,0,,Уау хаха
Dialogue: 0,0:13:52.56,0:13:54.50,Default,,0,0,0,,Хехехехеаа
Dialogue: 0,0:13:55.56,0:13:57.76,Default,,0,0,0,,Уау, бұл тамаша.
Dialogue: 0,0:13:58.90,0:13:59.86,Default,,0,0,0,,Качо?
Dialogue: 0,0:14:01.30,0:14:03.20,Default,,0,0,0,,Бұл сауыт тәрізді нәрсе қалай жұмыс істейді?
Dialogue: 0,0:14:03.60,0:14:06.16,Default,,0,0,0,,Жапонияға Үндістаннан жолаушылар ұшағымен келдіңіз бе?
Dialogue: 0,0:14:06.63,0:14:07.63,Default,,0,0,0,,Сізді өлтіреді
Dialogue: 0,0:14:09.30,0:14:09.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:13.86,0:14:15.43,Default,,0,0,0,,Уваа
Dialogue: 0,0:14:16.53,0:14:17.53,Default,,0,0,0,,Тез қаш!
Dialogue: 0,0:14:17.56,0:14:18.00,Default,,0,0,0,,Грр
Dialogue: 0,0:14:19.03,0:14:19.90,Default,,0,0,0,,Таа
Dialogue: 0,0:14:23.06,0:14:26.16,Default,,0,0,0,,Охохохо какчое каччо
Dialogue: 0,0:14:26.46,0:14:29.66,Default,,0,0,0,,Бірақ мұнда медбикелер не болып жатыр?
Dialogue: 0,0:14:30.43,0:14:32.73,Default,,0,0,0,,Иә, дұрыс, Сара-чан.
Dialogue: 0,0:14:38.13,0:14:39.10,Default,,0,0,0,,Ммм
Dialogue: 0,0:14:40.96,0:14:43.93,Default,,0,0,0,,Әдеттегіден қатты ауыратын сияқты
Dialogue: 0,0:14:45.03,0:14:45.83,Default,,0,0,0,,Сакора-чан
Dialogue: 0,0:14:46.73,0:14:47.63,Default,,0,0,0,,Кейта мырза
Dialogue: 0,0:14:48.93,0:14:49.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:53.46,0:14:54.66,Default,,0,0,0,,Уаа
Dialogue: 0,0:14:56.03,0:14:58.46,Default,,0,0,0,,Арнайы розеткадан ажыратыңыз
Dialogue: 0,0:15:04.23,0:15:04.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:05.36,0:15:07.76,Default,,0,0,0,,Хихинда Ги
Dialogue: 0,0:15:08.96,0:15:09.93,Default,,0,0,0,,Нуааах
Dialogue: 0,0:15:11.00,0:15:12.06,Default,,0,0,0,,Дәптерімді қайтар.
Dialogue: 0,0:15:14.00,0:15:14.50,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:15:14.93,0:15:16.40,Default,,0,0,0,,Сара-чан қазір
Dialogue: 0,0:15:16.96,0:15:17.43,Default,,0,0,0,,Тет
Dialogue: 0,0:15:20.56,0:15:22.26,Default,,0,0,0,,Хаа ха ха
Dialogue: 0,0:15:26.86,0:15:27.40,Default,,0,0,0,,♬~
Dialogue: 0,0:15:43.20,0:15:43.90,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:15:45.36,0:15:48.40,Default,,0,0,0,,Аа, дұрыс, Akamatsu Industries компаниясына хабарласайық.
Dialogue: 0,0:15:49.60,0:15:51.30,Default,,0,0,0,,Жоқ, антенна жұмыс істемейді.
Dialogue: 0,0:15:52.10,0:15:53.40,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:56.26,0:15:57.23,Default,,0,0,0,,Кейта мырза
Dialogue: 0,0:15:57.60,0:16:01.16,Default,,0,0,0,,Уфхх
Dialogue: 0,0:16:05.30,0:16:06.40,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:06.70,0:16:10.36,Default,,0,0,0,,Хм, ой, жоқ, жоқ, хаха, хахахаха
Dialogue: 0,0:16:10.73,0:16:14.86,Default,,0,0,0,,Кейта-санның маған көмектесуге келгеніне қуандым.
Dialogue: 0,0:16:15.13,0:16:17.53,Default,,0,0,0,,Хмм, бұл ер адамға табиғи нәрсе.
Dialogue: 0,0:16:18.60,0:16:20.90,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:16:21.73,0:16:25.76,Default,,0,0,0,,Мен Кейта-санға өтірік айттым.
Dialogue: 0,0:16:26.10,0:16:28.03,Default,,0,0,0,,Иә? өтірік?
Dialogue: 0,0:16:29.36,0:16:29.83,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:31.56,0:16:35.03,Default,,0,0,0,,Кейта-санның жақсы болатынына сенімдімін.
Dialogue: 0,0:16:36.43,0:16:38.46,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:16:38.73,0:16:39.86,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:16:40.93,0:16:43.26,Default,,0,0,0,,Себебі мен сенің жанымда болғаныңды қаладым
Dialogue: 0,0:16:44.16,0:16:47.36,Default,,0,0,0,,Аа жоқ аһ хе хе хе хе хе
Dialogue: 0,0:16:47.40,0:16:50.20,Default,,0,0,0,,Бұл жақсы, бәрі осы.
Dialogue: 0,0:16:50.26,0:16:50.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:52.53,0:16:56.23,Default,,0,0,0,,Бұл менің мүлдем жақсы емес екенімді білдіре ме?
Dialogue: 0,0:16:56.73,0:16:57.50,Default,,0,0,0,,Уау
Dialogue: 0,0:16:58.50,0:16:59.33,Default,,0,0,0,,Мен
Dialogue: 0,0:17:00.06,0:17:05.90,Default,,0,0,0,,Мен әлсірегендіктен туылғаннан бері ауруханадамын.
Dialogue: 0,0:17:07.06,0:17:11.03,Default,,0,0,0,,Сондықтан мен мектептің қандай екенін білмеймін.
Dialogue: 0,0:17:11.86,0:17:16.16,Default,,0,0,0,,Мен достарды да, ұлдарды да түсінбеймін.
Dialogue: 0,0:17:17.36,0:17:19.76,Default,,0,0,0,,Мен Хота-санды алғаш көргенде
Dialogue: 0,0:17:20.53,0:17:24.36,Default,,0,0,0,,Мен оны өте көңілді, мейірімді адам деп ойладым.
Dialogue: 0,0:17:24.76,0:17:28.76,Default,,0,0,0,,Сондықтан мен сенің қасымда болғаныңды қалаймын
Dialogue: 0,0:17:29.73,0:17:32.36,Default,,0,0,0,,Мен өтірік айттым, жақсымын дедім.
Dialogue: 0,0:17:33.50,0:17:35.23,Default,,0,0,0,,Сакора-чан
Dialogue: 0,0:17:36.43,0:17:39.13,Default,,0,0,0,,Мен сені ұстамасам
Dialogue: 0,0:17:39.83,0:17:44.16,Default,,0,0,0,,Хотата мырза, сіз мұндай қауіпті тәжірибеден аулақ болар едіңіз.
Dialogue: 0,0:17:45.90,0:17:46.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:47.20,0:17:52.23,Default,,0,0,0,,А, жоқ, сондықтан, иә, жақсы.
Dialogue: 0,0:17:52.76,0:17:53.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:54.13,0:17:56.93,Default,,0,0,0,,Бұл қытай медицинасының иісі қандай?
Dialogue: 0,0:17:57.46,0:17:57.96,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:59.50,0:18:02.50,Default,,0,0,0,,Ванна немесе бассейн?
Dialogue: 0,0:18:03.93,0:18:07.36,Default,,0,0,0,,Не? Бұл капсулалар өте көп.
Dialogue: 0,0:18:08.53,0:18:09.90,Default,,0,0,0,,көз жарақатыңыз өмірге қауіпті болмаса да, ол жеңіл жарақат емес.
Dialogue: 0,0:18:13.73,0:18:18.16,Default,,0,0,0,,Адамдар, бәріміз де бұл сұйықтыққа малындық.
Dialogue: 0,0:18:21.43,0:18:24.70,Default,,0,0,0,,Джиее
Dialogue: 0,0:18:25.73,0:18:26.93,Default,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,0:18:27.30,0:18:30.16,Default,,0,0,0,,Жоқ, ол дем алып жатыр деп ойлаймын.
Dialogue: 0,0:18:30.43,0:18:32.13,Default,,0,0,0,,Өйткені, мен саған көмектесуім керек.
Dialogue: 0,0:18:32.80,0:18:33.50,Default,,0,0,0,,К-чан
Dialogue: 0,0:18:33.56,0:18:34.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:34.40,0:18:35.50,Default,,0,0,0,,Хиноки
Dialogue: 0,0:18:36.23,0:18:37.06,Default,,0,0,0,,Мен
Dialogue: 0,0:18:40.80,0:18:41.73,Default,,0,0,0,,Хиноки-сан
Dialogue: 0,0:18:42.40,0:18:44.00,Default,,0,0,0,,Сіз тырнақтардан уландыңыз ба?
Dialogue: 0,0:18:44.56,0:18:45.83,Default,,0,0,0,,Улы емес
Dialogue: 0,0:18:46.10,0:18:46.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:47.36,0:18:50.40,Default,,0,0,0,,Бұл тек біздің ауруханада бар соңғы емдеу әдісі.
Dialogue: 0,0:18:50.83,0:18:52.33,Default,,0,0,0,,Уландыру терапиясы
Dialogue: 0,0:18:53.46,0:18:55.40,Default,,0,0,0,,Бұл жақсы жұмыс істейді.
Dialogue: 0,0:18:55.83,0:18:59.56,Default,,0,0,0,,Ой, біз саумыз хахахахаха
Dialogue: 0,0:19:00.03,0:19:03.73,Default,,0,0,0,,Бұл ем тек сау адамдарда тиімді.
Dialogue: 0,0:19:04.60,0:19:09.76,Default,,0,0,0,,Бірақ бүгін мен артық емдедім, сығындысы жұқа болып кетті.
Dialogue: 0,0:19:10.66,0:19:13.40,Default,,0,0,0,,Саламандрды көбірек жұмыс істеуге баулуымыз керек.
Dialogue: 0,0:19:17.53,0:19:18.10,Default,,0,0,0,,Хихихихи
Dialogue: 0,0:19:18.36,0:19:19.23,Default,,0,0,0,,Уваа
Dialogue: 0,0:19:22.83,0:19:26.80,Default,,0,0,0,,Жүр, маған көбірек үзінді бер, Саламандер.
Dialogue: 0,0:19:32.70,0:19:34.53,Default,,0,0,0,,Уаа
Dialogue: 0,0:19:38.16,0:19:40.03,Default,,0,0,0,,Енді мен де сау бола аламын
Dialogue: 0,0:19:40.63,0:19:41.13,Default,,0,0,0,,Угягья
Dialogue: 0,0:19:41.90,0:19:43.40,Default,,0,0,0,,Екеуіміздің де салмағымыз ауыр.
Dialogue: 0,0:19:46.00,0:19:49.26,Default,,0,0,0,,Менің кілтім қайтадан
Dialogue: 0,0:19:51.66,0:19:54.30,Default,,0,0,0,,Нгя хии хихихихи
Dialogue: 0,0:19:54.40,0:19:56.73,Default,,0,0,0,,Сара-чан Хиноки
Dialogue: 0,0:19:57.50,0:19:59.90,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:20:04.60,0:20:06.90,Default,,0,0,0,,менің кілтім
Dialogue: 0,0:20:20.33,0:20:20.80,Default,,0,0,0,,Ах
Dialogue: 0,0:20:20.90,0:20:21.83,Default,,0,0,0,,Мен қателестім…
Dialogue: 0,0:20:22.16,0:20:22.63,Default,,0,0,0,,О
Dialogue: 0,0:20:25.86,0:20:27.70,Default,,0,0,0,,Бұл енді жақсы емес
Dialogue: 0,0:20:30.03,0:20:30.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:32.70,0:20:34.53,Default,,0,0,0,,Уау уау уау
Dialogue: 0,0:20:37.50,0:20:39.36,Default,,0,0,0,,Ву-у
Dialogue: 0,0:20:40.26,0:20:41.20,Default,,0,0,0,,Беттерман
Dialogue: 0,0:20:47.93,0:20:48.90,Default,,0,0,0,,Гуу
Dialogue: 0,0:20:48.93,0:20:50.43,Default,,0,0,0,,Беттерман үзіндіге айналады
Dialogue: 0,0:20:51.26,0:20:52.16,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:52.83,0:20:56.33,Default,,0,0,0,,Тұмандықтың денесі тірі сияқты, бірақ олай емес.
Dialogue: 0,0:20:56.86,0:20:59.30,Default,,0,0,0,,Мұның мағынасы жоқ.
Dialogue: 0,0:21:14.00,0:21:17.36,Default,,0,0,0,,Гаа
Dialogue: 0,0:21:17.93,0:21:19.93,Default,,0,0,0,,Гуаааа
Dialogue: 0,0:21:21.16,0:21:22.70,Default,,0,0,0,,Ааа
Dialogue: 0,0:21:23.03,0:21:24.86,Default,,0,0,0,,О, бұл қорқынышты.
Dialogue: 0,0:21:27.30,0:21:30.40,Default,,0,0,0,,Ууаааах
Dialogue: 0,0:21:33.56,0:21:36.20,Default,,0,0,0,,Уваа
Dialogue: 0,0:21:40.03,0:21:42.20,Default,,0,0,0,,Гуаааа
Dialogue: 0,0:21:46.80,0:21:55.40,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:22:11.90,0:22:12.60,Default,,0,0,0,,Альбом
Dialogue: 0,0:22:34.70,0:22:47.23,Default,,0,0,0,,Шексіз теломераларға ойылған Құдайдың күнәсі
Dialogue: 0,0:22:47.96,0:22:54.06,Default,,0,0,0,,Жалынды құшақтап алу
Dialogue: 0,0:22:54.63,0:23:01.66,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:02.00,0:23:05.20,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.50,0:23:08.60,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.93,0:23:12.10,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.33,0:23:15.60,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.50,0:23:27.30,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:27.76,0:23:37.60,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:38.03,0:23:49.03,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:24:00.23,0:24:03.00,Default,,0,0,0,,Толқын жұтқан кемелер
Dialogue: 0,0:24:03.66,0:24:06.33,Default,,0,0,0,,Тербеліп, мені шақырып тұр
Dialogue: 0,0:24:07.63,0:24:09.20,Default,,0,0,0,,Аква келе жатыр
Dialogue: 0,0:24:10.53,0:24:14.26,Default,,0,0,0,,Терең, салқын судың түбі
Dialogue: 0,0:24:15.10,0:24:17.03,Default,,0,0,0,,Букубукубукубуку
Dialogue: 0,0:24:17.30,0:24:18.80,Default,,0,0,0,,Батып кету
Dialogue: 0,0:24:20.20,0:24:21.96,Default,,0,0,0,,Сіздің тыныс алуыңыз
Dialogue: 0,0:24:22.70,0:24:24.23,Default,,0,0,0,,Ол тоқтағанша
Dialogue: 0,0:24:25.73,0:24:31.73,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
