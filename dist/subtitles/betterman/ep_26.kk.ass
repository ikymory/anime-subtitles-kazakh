Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.70,0:00:13.03,Default,,0,0,0,,Аспан аспанда
Dialogue: 0,0:00:14.23,0:00:15.56,Default,,0,0,0,,Аспан да жер бетінде
Dialogue: 0,0:00:16.73,0:00:17.93,Default,,0,0,0,,Жұлдыздар аспанда
Dialogue: 0,0:00:18.86,0:00:20.20,Default,,0,0,0,,Жұлдыздар да жер бетінде
Dialogue: 0,0:00:21.13,0:00:24.86,Default,,0,0,0,,Аспанда бар нәрсенің бәрі жерде де бар.
Dialogue: 0,0:00:25.73,0:00:28.80,Default,,0,0,0,,Бақытты – шешілмеген жұмбақ
Dialogue: 0,0:00:31.80,0:00:36.73,Default,,0,0,0,,Уау
Dialogue: 0,0:00:44.26,0:00:45.40,Default,,0,0,0,,Сүңгуірді тексеру
Dialogue: 0,0:00:46.13,0:00:48.63,Default,,0,0,0,,Генетикалық деңгейде мутация тудырады
Dialogue: 0,0:00:49.26,0:00:53.53,Default,,0,0,0,,Тіпті төзімді патогендерден де асып түсетін өлместікке ұмтылу эксперименті
Dialogue: 0,0:00:56.03,0:00:59.13,Default,,0,0,0,,Гомеобокс гендерінің биологиялық сызбасы
Dialogue: 0,0:00:59.30,0:01:02.20,Default,,0,0,0,,Ол сілтеме гелі арқылы қайта жазылуы керек еді.
Dialogue: 0,0:01:02.90,0:01:03.66,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:01:05.46,0:01:08.36,Default,,0,0,0,,Мүмкін Беттерман мыңдаған жылдар бұрын дүниеге келген.
Dialogue: 0,0:01:08.76,0:01:11.13,Default,,0,0,0,,Сүңгуір тексеруден сәтті өткен түрлер
Dialogue: 0,0:01:11.90,0:01:14.96,Default,,0,0,0,,Осы Мордиварп жерасты тәжірибелік қондырғысында.
Dialogue: 0,0:01:15.00,0:01:18.03,Default,,0,0,0,,Мен сүңгуір тексеруді бірнеше рет қайталадым.
Dialogue: 0,0:01:18.30,0:01:21.10,Default,,0,0,0,,Мен жақсы адам бола алмадым
Dialogue: 0,0:01:22.00,0:01:26.33,Default,,0,0,0,,Бірақ мен Limipid арнасын алмадым.
Dialogue: 0,0:01:27.23,0:01:30.73,Default,,0,0,0,,Ал мен сананың кең мұхитынан өттім
Dialogue: 0,0:01:31.06,0:01:34.06,Default,,0,0,0,,Ақыры жауабын білетін адам келді.
Dialogue: 0,0:01:36.53,0:01:38.56,Default,,0,0,0,,Перудағы Попо көлінің суы ғана
Dialogue: 0,0:01:39.26,0:01:42.93,Default,,0,0,0,,Бұл менің қасіретімді басатын жалғыз дәрі болды.
Dialogue: 0,0:01:43.60,0:01:47.66,Default,,0,0,0,,Бірақ су көп ұзамай тазалығын жоғалтты.
Dialogue: 0,0:01:49.40,0:01:52.60,Default,,0,0,0,,Ауа райының қалыптан тыс жағдайларын тудыратын адамдардың табиғаттың бұзылуы
Dialogue: 0,0:01:53.23,0:01:56.16,Default,,0,0,0,,Ішімдегі Қанкелді шығардым.
Dialogue: 0,0:01:57.26,0:02:01.83,Default,,0,0,0,,Мен жадымды жоғалтып, чакраның басшылығымен осында келдім.
Dialogue: 0,0:02:02.06,0:02:08.00,Default,,0,0,0,,Бірақ бұл Қанкелдің бүкіл тіршіліктің жойылуына дайындығынан басқа ештеңе емес.
Dialogue: 0,0:02:09.06,0:02:11.43,Default,,0,0,0,,Ей, сен тірісің, қария.
Dialogue: 0,0:02:12.13,0:02:13.13,Default,,0,0,0,,Канкел дегеніміз не?
Dialogue: 0,0:02:14.06,0:02:17.20,Default,,0,0,0,,Адамдар ешқашан өлмейтін жасушаларды мақсат етті
Dialogue: 0,0:02:18.36,0:02:20.33,Default,,0,0,0,,Жою – жаңа өмірге эволюция
Dialogue: 0,0:02:21.20,0:02:23.60,Default,,0,0,0,,Бірақ адамдар одан бас тартты.
Dialogue: 0,0:02:24.53,0:02:27.83,Default,,0,0,0,,Қартайсам деген қорқынышқа шыдай алмаймын.
Dialogue: 0,0:02:28.33,0:02:33.33,Default,,0,0,0,,Адамдар өмір сүру ұзақтығынан асып түсетін өлместікке айналуға ұмтылды.
Dialogue: 0,0:02:33.86,0:02:36.80,Default,,0,0,0,,Бірақ бұл нәтиже.
Dialogue: 0,0:02:39.76,0:02:49.16,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:02:51.70,0:02:59.76,Default,,0,0,0,,Қалқымалы күміс қайық
Dialogue: 0,0:03:01.53,0:03:10.13,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:03:13.40,0:03:21.50,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:03:24.60,0:03:33.50,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:03:33.93,0:03:41.80,Default,,0,0,0,,Жанға бағыт беру
Dialogue: 0,0:03:43.60,0:03:53.30,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:03:53.70,0:04:05.90,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:04:16.13,0:04:17.70,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,0:04:18.33,0:04:22.40,Default,,0,0,0,,Күтілгендей, құрметті Якусуги ең жақсы адам ретінде жетілдірілді.
Dialogue: 0,0:04:22.90,0:04:26.30,Default,,0,0,0,,Уваа
Dialogue: 0,0:04:26.66,0:04:32.46,Default,,0,0,0,,Мәртебелі мәңгі бөлінетін өлмейтін жасушаларды алды.
Dialogue: 0,0:04:32.73,0:04:35.76,Default,,0,0,0,,О, сен неге Беттерменге шабуыл жасайсың?
Dialogue: 0,0:04:36.40,0:04:42.36,Default,,0,0,0,,Себебі Беттерман - адамдарды қорғайтын иммундық антидене.
Dialogue: 0,0:04:43.03,0:04:45.26,Default,,0,0,0,,Егер Беттермен өлсе
Dialogue: 0,0:04:45.46,0:04:49.96,Default,,0,0,0,,Қанкел адамның да жойылатынын біле ме?
Dialogue: 0,0:04:50.36,0:04:51.06,Default,,0,0,0,,Сакура
Dialogue: 0,0:04:51.66,0:04:55.23,Default,,0,0,0,,Кота Аоакиге дура матер берген донор болды
Dialogue: 0,0:04:55.70,0:04:59.56,Default,,0,0,0,,Лорье Нуар, сол кезде Жапонияда тұратын геолог
Dialogue: 0,0:05:00.23,0:05:03.73,Default,,0,0,0,,Ол линкер гелін зерттеудің жетекші зерттеушісі болды.
Dialogue: 0,0:05:04.13,0:05:06.66,Default,,0,0,0,,Лори маған айтты
Dialogue: 0,0:05:07.20,0:05:13.46,Default,,0,0,0,,Кейта-санның ішінде болсам да, көпке дейін өзімді қалпына келтіре алмадым.
Dialogue: 0,0:05:13.76,0:05:14.96,Default,,0,0,0,,Бірақ қазір
Dialogue: 0,0:05:16.40,0:05:20.43,Default,,0,0,0,,Оның Оянған адамға жақындауы кездейсоқ емес.
Dialogue: 0,0:05:22.10,0:05:23.66,Default,,0,0,0,,Хота-кундағы Лорье
Dialogue: 0,0:05:24.00,0:05:26.80,Default,,0,0,0,,Өзіңіздің нейрожелілеріңізді қалпына келтіру үшін
Dialogue: 0,0:05:27.20,0:05:28.70,Default,,0,0,0,,Байланыстырушы гельді қолданғанда
Dialogue: 0,0:05:28.86,0:05:29.76,Default,,0,0,0,,Иә
Dialogue: 0,0:05:30.73,0:05:34.30,Default,,0,0,0,,Сонда мен оянған адамдарды өзім қозғалта алдым ба?
Dialogue: 0,0:05:34.86,0:05:39.60,Default,,0,0,0,,Кейтаның миында екі екі текті адамның нейрондары бар.
Dialogue: 0,0:05:40.13,0:05:43.13,Default,,0,0,0,,Ертеде адамдар линкер гелін қолданған.
Dialogue: 0,0:05:43.16,0:05:48.10,Default,,0,0,0,,Жер астынан пайда болатын тіршілік көзі Симзония деп аталды.
Dialogue: 0,0:05:48.56,0:05:53.83,Default,,0,0,0,,Және олармен өзара әрекеттесу арқылы әртүрлі білім алғаны айтылады.
Dialogue: 0,0:05:54.26,0:05:58.43,Default,,0,0,0,,Лорье сөйлеуді білді
Dialogue: 0,0:05:58.96,0:06:02.20,Default,,0,0,0,,Көп өмірмен араласу арқылы
Dialogue: 0,0:06:02.43,0:06:05.96,Default,,0,0,0,,Энергияны өндіретін байланыстырушы гель және
Dialogue: 0,0:06:06.83,0:06:10.60,Default,,0,0,0,,Канкель басқа организмдердің хромосомаларын өзгертті.
Dialogue: 0,0:06:10.80,0:06:13.83,Default,,0,0,0,,Өз ішінде балқыту қабілеті бар.
Dialogue: 0,0:06:14.56,0:06:19.06,Default,,0,0,0,,Бірақ бұл будандастыру линкер геліне қарсы да дәрменсіз.
Dialogue: 0,0:06:19.43,0:06:20.90,Default,,0,0,0,,Мүмкін солай шығар
Dialogue: 0,0:06:21.63,0:06:23.33,Default,,0,0,0,,Өйткені ол тіршілік көзі
Dialogue: 0,0:06:23.86,0:06:24.73,Default,,0,0,0,,К-чан
Dialogue: 0,0:06:25.23,0:06:28.66,Default,,0,0,0,,Ол барлық нәрсенің бастауы болды.
Dialogue: 0,0:06:29.43,0:06:34.16,Default,,0,0,0,,Өсу типіндегі бас сүңгуір Кей-чанның тағы бір кейіпкері болды.
Dialogue: 0,0:06:36.13,0:06:37.83,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:06:42.23,0:06:44.16,Default,,0,0,0,,Ой!
Dialogue: 0,0:06:44.50,0:06:46.96,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:06:49.00,0:06:49.70,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:06:53.63,0:06:56.96,Default,,0,0,0,,Қанша азайтсаң да көбейеді.
Dialogue: 0,0:06:57.33,0:06:58.46,Default,,0,0,0,,Өлмейтін жасушалар
Dialogue: 0,0:06:58.83,0:07:00.00,Default,,0,0,0,,Кінәлінің көзі
Dialogue: 0,0:07:00.53,0:07:03.60,Default,,0,0,0,,Сонымен, сүңгуір тексеруден аман қалғандарымыз
Dialogue: 0,0:07:04.06,0:07:06.06,Default,,0,0,0,,Кінәлі болған билік
Dialogue: 0,0:07:06.83,0:07:10.73,Default,,0,0,0,,Канкелдің тууы деп аталатын экожүйеге төнетін қауіп туралы мәлімет.
Dialogue: 0,0:07:10.90,0:07:13.80,Default,,0,0,0,,Мидағы прион протеинінде әлі де басылған
Dialogue: 0,0:07:14.13,0:07:16.63,Default,,0,0,0,,Дүниенің төрт бұрышына тарап кеттік
Dialogue: 0,0:07:17.23,0:07:20.56,Default,,0,0,0,,Ал біз байланысқан кез келген адамға
Dialogue: 0,0:07:20.70,0:07:24.06,Default,,0,0,0,,Бұл импульстік үлгі жіберілді.
Dialogue: 0,0:07:24.63,0:07:28.96,Default,,0,0,0,,Кристалды ядро түзетін зат суды бірден мұзға айналдырады
Dialogue: 0,0:07:29.50,0:07:33.00,Default,,0,0,0,,Бұл менің миымда өлім бағдарламасын белсендірді.
Dialogue: 0,0:07:33.36,0:07:34.63,Default,,0,0,0,,Алджернон
Dialogue: 0,0:07:35.46,0:07:36.60,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:07:38.10,0:07:39.46,Default,,0,0,0,,Уау
Dialogue: 0,0:07:43.13,0:07:45.43,Default,,0,0,0,,Уау
Dialogue: 0,0:07:45.80,0:07:46.76,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:07:47.60,0:07:48.76,Default,,0,0,0,,Өзім
Dialogue: 0,0:07:50.23,0:07:52.63,Default,,0,0,0,,Альжернонның шығу тегі
Dialogue: 0,0:07:53.13,0:07:54.60,Default,,0,0,0,,Алджернон
Dialogue: 0,0:07:55.06,0:07:58.93,Default,,0,0,0,,Адамның ерекше өліміне байланысты өсетін анимус арқылы
Dialogue: 0,0:07:59.16,0:08:04.56,Default,,0,0,0,,Беттерман деп аталатын иммундық антиденелерді тартатын биологиялық механизм
Dialogue: 0,0:08:05.93,0:08:06.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.26,0:08:08.23,Default,,0,0,0,,Балалар
Dialogue: 0,0:08:09.33,0:08:13.13,Default,,0,0,0,,Оянған адамның ішіндегі 12 дельфин
Dialogue: 0,0:08:14.86,0:08:16.60,Default,,0,0,0,,Теңізге қайта барасыз ба?
Dialogue: 0,0:08:17.43,0:08:18.90,Default,,0,0,0,,Сіз бақытты көрінесіз.
Dialogue: 0,0:08:19.83,0:08:20.36,Default,,0,0,0,,Иә
Dialogue: 0,0:08:20.93,0:08:24.66,Default,,0,0,0,,Қарама, жердің тереңіне қарама
Dialogue: 0,0:08:25.53,0:08:26.63,Default,,0,0,0,,Жойылған жер
Dialogue: 0,0:08:29.33,0:08:30.86,Default,,0,0,0,,Көк балта Кейта
Dialogue: 0,0:08:32.63,0:08:34.26,Default,,0,0,0,,Гуманоидтық жарық
Dialogue: 0,0:08:35.03,0:08:37.76,Default,,0,0,0,,Мүмкін менің ішімде басқасы бар шығар
Dialogue: 0,0:08:38.26,0:08:39.73,Default,,0,0,0,,Лорье Нуар
Dialogue: 0,0:08:40.76,0:08:45.60,Default,,0,0,0,,Мен сіздің миыңызда шатастырып жіберген сияқтымын.
Dialogue: 0,0:08:46.13,0:08:47.30,Default,,0,0,0,,Шатасу
Dialogue: 0,0:08:48.03,0:08:50.26,Default,,0,0,0,,Менде кейде оғаш галлюцинациялар болды
Dialogue: 0,0:08:51.73,0:08:53.83,Default,,0,0,0,,Сіз қазір көріп тұрған мені
Dialogue: 0,0:08:54.23,0:08:57.46,Default,,0,0,0,,Бұл жай ғана сіздің миыңызда жасалған виртуалды бейне.
Dialogue: 0,0:08:58.20,0:08:59.26,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:08:59.83,0:09:02.03,Default,,0,0,0,,Жақында бәрі бітеді
Dialogue: 0,0:09:03.00,0:09:05.50,Default,,0,0,0,,Рахмет, Көк балта Кейта
Dialogue: 0,0:09:06.40,0:09:07.60,Default,,0,0,0,,О, бұл
Dialogue: 0,0:09:09.70,0:09:10.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:12.20,0:09:14.46,Default,,0,0,0,,Мен жындымын
Dialogue: 0,0:09:15.66,0:09:18.03,Default,,0,0,0,,Хаа Хиноки
Dialogue: 0,0:09:19.10,0:09:20.13,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,0:09:22.56,0:09:25.13,Default,,0,0,0,,Жоқ, енді қозғалма.
Dialogue: 0,0:09:28.40,0:09:29.76,Default,,0,0,0,,К-чан
Dialogue: 0,0:09:32.23,0:09:35.30,Default,,0,0,0,,Кешіріңіз Хиноки I
Dialogue: 0,0:09:36.80,0:09:41.06,Default,,0,0,0,,Кей-чан, сен уәдеңде тұрдың.
Dialogue: 0,0:09:42.33,0:09:44.70,Default,,0,0,0,,Сіз әрқашан менің жанымда боласыз
Dialogue: 0,0:09:46.20,0:09:47.10,Default,,0,0,0,,Хиноки
Dialogue: 0,0:09:48.00,0:09:49.63,Default,,0,0,0,,Кешіріңіз, Кей Чан
Dialogue: 0,0:09:50.80,0:09:53.20,Default,,0,0,0,,Мен сияқты ақымақтарға
Dialogue: 0,0:09:54.36,0:09:57.60,Default,,0,0,0,,Мен Хинокиді қорғай алмадым.
Dialogue: 0,0:09:58.76,0:10:00.83,Default,,0,0,0,,Жарайды, рахмет.
Dialogue: 0,0:10:01.86,0:10:03.70,Default,,0,0,0,,Мен сені сүйемін, К-чан
Dialogue: 0,0:10:05.00,0:10:08.23,Default,,0,0,0,,Хиноки Біз өлеміз бе?
Dialogue: 0,0:10:09.26,0:10:13.10,Default,,0,0,0,,Өлсем, анимус гүлі боламын.
Dialogue: 0,0:10:14.50,0:10:18.60,Default,,0,0,0,,Сосын ағам мені жеп қойды
Dialogue: 0,0:10:19.93,0:10:25.70,Default,,0,0,0,,Кей-чанға көмектесетініне сенімдімін.
Dialogue: 0,0:10:27.26,0:10:31.63,Default,,0,0,0,,Хиноки Хиноки Хиноки
Dialogue: 0,0:10:40.56,0:10:44.36,Default,,0,0,0,,Әуе шабуылының басталуына 5 минут қалды
Dialogue: 0,0:10:45.16,0:10:47.50,Default,,0,0,0,,Кешіріңіз, Цуко-кун.
Dialogue: 0,0:10:48.53,0:10:53.63,Default,,0,0,0,,Сізді зертханаға қайтып келуге мәжбүрлеу керек еді.
Dialogue: 0,0:10:54.60,0:10:58.46,Default,,0,0,0,,Әкем мен шешемнің тілегін орындаймын.
Dialogue: 0,0:10:59.13,0:11:03.43,Default,,0,0,0,,Біз көптеген адамдарды аурудан құтқару үшін күрестік.
Dialogue: 0,0:11:04.73,0:11:07.33,Default,,0,0,0,,Бірақ бұл күлкілі
Dialogue: 0,0:11:08.46,0:11:10.40,Default,,0,0,0,,Алджернонды дүние жүзіне шашырату
Dialogue: 0,0:11:11.16,0:11:13.90,Default,,0,0,0,,Жазықсыз адамдарды өлтіре бергеніме сене алар емеспін.
Dialogue: 0,0:11:14.70,0:11:18.63,Default,,0,0,0,,Өлім – келесі туудың тағдыры
Dialogue: 0,0:11:20.66,0:11:21.16,Default,,0,0,0,,Га
Dialogue: 0,0:11:22.10,0:11:22.83,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:11:25.60,0:11:26.96,Default,,0,0,0,,D типті аңшы
Dialogue: 0,0:11:27.70,0:11:32.50,Default,,0,0,0,,Қабық түзетін бактериялармен симбиоз орнатқан жақсартылған адамдар
Dialogue: 0,0:11:33.26,0:11:37.36,Default,,0,0,0,,Сол бала үшін және біздің тағдырымыз үшін
Dialogue: 0,0:11:38.06,0:11:39.56,Default,,0,0,0,,Этикадан тыс
Dialogue: 0,0:11:42.16,0:11:43.10,Default,,0,0,0,,Балалар
Dialogue: 0,0:11:44.66,0:11:45.66,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:11:50.46,0:11:51.56,Default,,0,0,0,,Сакура
Dialogue: 0,0:11:54.06,0:11:56.00,Default,,0,0,0,,Эй, эй, эй
Dialogue: 0,0:11:56.60,0:11:58.63,Default,,0,0,0,,Көзіңді аш, Сара.
Dialogue: 0,0:12:02.20,0:12:08.50,Default,,0,0,0,,Ахахахахаа
Dialogue: 0,0:12:09.33,0:12:10.43,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:12:11.06,0:12:14.26,Default,,0,0,0,,Бұл Асамидің әпкесі мінген Грианоид.
Dialogue: 0,0:12:15.36,0:12:18.26,Default,,0,0,0,,Амал жоқ, бәрі өлді.
Dialogue: 0,0:12:19.00,0:12:21.80,Default,,0,0,0,,Тез қашыңыз
Dialogue: 0,0:12:22.40,0:12:26.56,Default,,0,0,0,,Сакора, мен сені бұл жерге әкелмеуім керек еді.
Dialogue: 0,0:12:27.40,0:12:28.70,Default,,0,0,0,,Анам кеткен соң
Dialogue: 0,0:12:29.16,0:12:33.20,Default,,0,0,0,,Өйткені мен қайда барсам да сенімен бірге боламын деп уәде бердім.
Dialogue: 0,0:12:33.93,0:12:34.90,Default,,0,0,0,,Мордиварптан
Dialogue: 0,0:12:35.16,0:12:39.30,Default,,0,0,0,,Арнайы медициналық маниджи аппаратын пайдалануға рұқсат алу жағдайында.
Dialogue: 0,0:12:39.96,0:12:42.33,Default,,0,0,0,,Техникалық ынтымақтастық бастапқыда болды
Dialogue: 0,0:12:43.66,0:12:45.53,Default,,0,0,0,,Мен мұндай нәрсе болады деп күткен емеспін.
Dialogue: 0,0:12:46.53,0:12:50.80,Default,,0,0,0,,Мен шынымен де пайдасыз әкемін.
Dialogue: 0,0:12:51.26,0:12:53.23,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:12:53.96,0:12:58.53,Default,,0,0,0,,Мен сенімен бірге көп жерге барғаныма қуаныштымын.
Dialogue: 0,0:12:59.53,0:13:02.06,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,0:13:03.10,0:13:03.90,Default,,0,0,0,,Сакура
Dialogue: 0,0:13:10.46,0:13:12.46,Default,,0,0,0,,Боқ, уф, уф.
Dialogue: 0,0:13:13.46,0:13:15.86,Default,,0,0,0,,Қарғыс атсын, қозғал, қозғал!
Dialogue: 0,0:13:16.53,0:13:20.90,Default,,0,0,0,,Иә, қозғал, қозғал, қозғал, қозғал!
Dialogue: 0,0:13:21.30,0:13:23.40,Default,,0,0,0,,Қозғал, қозғал, қозғал
Dialogue: 0,0:13:24.20,0:13:29.50,Default,,0,0,0,,Вуги, қозғал!
Dialogue: 0,0:14:11.10,0:14:15.43,Default,,0,0,0,,Бәрін Қанкел алып кетеді
Dialogue: 0,0:14:24.10,0:14:24.96,Default,,0,0,0,,Ламия
Dialogue: 0,0:14:25.03,0:14:25.90,Default,,0,0,0,,Ламия
Dialogue: 0,0:14:26.00,0:14:26.90,Default,,0,0,0,,Ламия
Dialogue: 0,0:14:27.56,0:14:29.90,Default,,0,0,0,,Әлі біткен жоқ
Dialogue: 0,0:14:31.46,0:14:35.60,Default,,0,0,0,,Менде енді Wiwele-ді ұстауға күшім де жетпейді.
Dialogue: 0,0:14:36.30,0:14:38.33,Default,,0,0,0,,Мен ұмытқан сияқты емеспін.
Dialogue: 0,0:14:38.90,0:14:40.83,Default,,0,0,0,,Қолында Форте
Dialogue: 0,0:14:41.73,0:14:44.53,Default,,0,0,0,,Форте Канкелді жеңе алмайды.
Dialogue: 0,0:14:45.60,0:14:49.06,Default,,0,0,0,,Форте жиналса, не туады
Dialogue: 0,0:14:50.63,0:14:51.43,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:14:52.26,0:14:55.26,Default,,0,0,0,,Иә, Қанкел – қауіп.
Dialogue: 0,0:14:55.76,0:14:56.60,Default,,0,0,0,,Орфос
Dialogue: 0,0:15:13.66,0:15:17.43,Default,,0,0,0,,Сізде Ортосқа қарсылық бар ма?
Dialogue: 0,0:15:18.06,0:15:21.53,Default,,0,0,0,,Қазір сынап көруден басқа амал жоқ.
Dialogue: 0,0:15:22.36,0:15:25.80,Default,,0,0,0,,Егер әлі де күресуге ерік-жігеріңіз болса, тұрыңыз.
Dialogue: 0,0:15:26.70,0:15:28.73,Default,,0,0,0,,Жарықты сөндірмеу үшін
Dialogue: 0,0:15:33.03,0:15:33.90,Default,,0,0,0,,Ламия
Dialogue: 0,0:15:38.00,0:15:40.83,Default,,0,0,0,,Ескі Пакира Бодайджу Семе
Dialogue: 0,0:15:41.26,0:15:42.13,Default,,0,0,0,,мен
Dialogue: 0,0:15:44.36,0:15:46.73,Default,,0,0,0,,Мені жаңа дүниеге әкел
Dialogue: 0,0:15:48.83,0:15:51.73,Default,,0,0,0,,Мені тоқтатыңыз!
Dialogue: 0,0:15:53.46,0:15:55.70,Default,,0,0,0,,Гари Гари Гари Гари
Dialogue: 0,0:16:20.06,0:16:23.06,Default,,0,0,0,,Ууу
Dialogue: 0,0:16:35.03,0:16:37.10,Default,,0,0,0,,Ууу...
Dialogue: 0,0:16:38.00,0:16:39.06,Default,,0,0,0,,Құрметті Якусуги
Dialogue: 0,0:16:39.70,0:16:42.83,Default,,0,0,0,,Қанкелдің жасырын иесіне жетті
Dialogue: 0,0:16:45.80,0:16:48.00,Default,,0,0,0,,Чакраның мөрленген апат күші
Dialogue: 0,0:16:48.53,0:16:50.80,Default,,0,0,0,,Өзім де көре алмайтын факт
Dialogue: 0,0:16:59.56,0:17:04.56,Default,,0,0,0,,Өлім күшінен асатын туудың өмірлік күші сізді тоқтатады.
Dialogue: 0,0:17:37.50,0:17:38.80,Default,,0,0,0,,Уау
Dialogue: 0,0:17:40.66,0:17:41.93,Default,,0,0,0,,Біз сомниум
Dialogue: 0,0:17:42.33,0:17:46.06,Default,,0,0,0,,Экожүйенің тепе-теңдігін сақтайтын бауыр қызметі сияқты тіршілік ету
Dialogue: 0,0:17:47.10,0:17:51.40,Default,,0,0,0,,Біз өлсек, иммунитеті жоқтар да жойылады.
Dialogue: 0,0:17:52.36,0:17:54.60,Default,,0,0,0,,Менің ұяшықтарымды ұрлағандар
Dialogue: 0,0:17:55.20,0:17:57.50,Default,,0,0,0,,Өз өмірімнен асатындар
Dialogue: 0,0:17:58.06,0:18:00.43,Default,,0,0,0,,Менің эволюциямның жетістігі
Dialogue: 0,0:18:01.36,0:18:03.16,Default,,0,0,0,,Канкел еліктегіш
Dialogue: 0,0:18:09.16,0:18:09.80,Default,,0,0,0,,Мұндай шалқып жатқан шөлде мотоцикліммен келе жатқанда —
Dialogue: 0,0:18:36.16,0:18:38.86,Default,,0,0,0,,Адам ең жақсы адам болуды мақсат етті
Dialogue: 0,0:18:39.46,0:18:42.00,Default,,0,0,0,,Бірге өмір сүру ережелерін бұзуды білдірсе де
Dialogue: 0,0:18:42.76,0:18:48.00,Default,,0,0,0,,Бірақ егер сіз шынымен дұрыс жолды таңдап, әрі қарай жүрсеңіз
Dialogue: 0,0:18:48.40,0:18:52.30,Default,,0,0,0,,Мені тоқтат, жақсы адам.
Dialogue: 0,0:18:55.90,0:18:59.93,Default,,0,0,0,,Хромосома спиральдары екі рет қосылу арқылы симбиотикалық өмір сүреді.
Dialogue: 0,0:19:00.50,0:19:02.43,Default,,0,0,0,,Қоршаған ортаның өзгеруіне байланысты өзгерістер
Dialogue: 0,0:19:02.73,0:19:06.56,Default,,0,0,0,,Басқаша айтқанда, жасушалардың шексіз бөлінуі адам үшін эволюция емес.
Dialogue: 0,0:19:07.00,0:19:10.70,Default,,0,0,0,,Дегенмен, Қанкелге ұқсайтын бір ғана адам бар.
Dialogue: 0,0:19:11.33,0:19:12.00,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:19:12.53,0:19:13.80,Default,,0,0,0,,Жыныс жасушалары
Dialogue: 0,0:19:13.93,0:19:15.36,Default,,0,0,0,,Психоверс
Dialogue: 0,0:19:17.23,0:19:20.20,Default,,0,0,0,,Ууу
Dialogue: 0,0:19:33.40,0:19:36.40,Default,,0,0,0,,Бұл менің қабілеттерімнің босатылуына әкеледі ме?
Dialogue: 0,0:19:36.70,0:19:41.06,Default,,0,0,0,,Барлық генетикалық ақпарат оянғанда, бағдарлама ештеңеге оралмайды.
Dialogue: 0,0:20:16.60,0:20:17.80,Default,,0,0,0,,Бұл сен едің
Dialogue: 0,0:20:18.50,0:20:21.10,Default,,0,0,0,,Ол маған көп нәрсені үйретті.
Dialogue: 0,0:20:25.30,0:20:26.46,Default,,0,0,0,,Бірге барайық.
Dialogue: 0,0:20:27.40,0:20:28.73,Default,,0,0,0,,Мұнда ештеңе жоқ
Dialogue: 0,0:20:30.06,0:20:34.53,Default,,0,0,0,,Ойнайық, ойнайық, Ойнайық, ойнайық
Dialogue: 0,0:20:43.13,0:20:44.10,Default,,0,0,0,,Сакура
Dialogue: 0,0:20:45.60,0:20:48.43,Default,,0,0,0,,Алджернон жоғалып кетті ме?
Dialogue: 0,0:20:50.26,0:20:51.03,Default,,0,0,0,,Иә
Dialogue: 0,0:20:52.40,0:20:54.50,Default,,0,0,0,,Каиша келгенде де, біз тек бірнеше минут тұрып әңгімелесеміз.
Dialogue: 0,0:20:56.23,0:20:58.43,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:20:59.60,0:21:01.33,Default,,0,0,0,,Менің ойымша, бұл болды
Dialogue: 0,0:21:10.23,0:21:11.20,Default,,0,0,0,,Сакура
Dialogue: 0,0:21:11.56,0:21:12.43,Default,,0,0,0,,Сакура
Dialogue: 0,0:21:14.30,0:21:15.10,Default,,0,0,0,,Сакура
Dialogue: 0,0:21:18.46,0:21:19.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:21.16,0:21:22.40,Default,,0,0,0,,Сіз ұйықтадыңыз ба?
Dialogue: 0,0:21:26.93,0:21:39.93,Default,,0,0,0,,Алыс жердегілер
Dialogue: 0,0:21:40.23,0:21:52.40,Default,,0,0,0,,Мәңгілік қараңғылық
Dialogue: 0,0:21:52.50,0:22:05.50,Default,,0,0,0,,Мирна өлілер елі
Dialogue: 0,0:22:05.80,0:22:21.76,Default,,0,0,0,,Кикунаның жойылу дауысы
Dialogue: 0,0:22:25.70,0:22:37.76,Default,,0,0,0,,Қазіргі адам ойнай алады
Dialogue: 0,0:22:39.53,0:22:54.43,Default,,0,0,0,,Жарқыраған Симзония теңізі
Dialogue: 0,0:23:00.46,0:23:01.06,Default,,0,0,0,,Уф
Dialogue: 0,0:23:04.53,0:23:05.20,Default,,0,0,0,,К-чан
Dialogue: 0,0:23:05.56,0:23:06.40,Default,,0,0,0,,Ммм
Dialogue: 0,0:23:08.13,0:23:09.50,Default,,0,0,0,,Хиноки
Dialogue: 0,0:23:10.53,0:23:12.90,Default,,0,0,0,,Мен оны алып жүруді тапсырдым.
Dialogue: 0,0:23:13.60,0:23:15.86,Default,,0,0,0,,Біз осы уақытқа дейін
Dialogue: 0,0:23:16.80,0:23:18.43,Default,,0,0,0,,Е, кімге?
Dialogue: 0,0:23:20.16,0:23:22.00,Default,,0,0,0,,Біз тіріміз
Dialogue: 0,0:23:22.80,0:23:23.43,Default,,0,0,0,,Иә
Dialogue: 0,0:23:24.23,0:23:25.13,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:23:26.60,0:23:27.56,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:23:27.70,0:23:32.53,Default,,0,0,0,,Хэхе хаха хахахаха ахахахах
Dialogue: 0,0:23:32.83,0:23:38.00,Default,,0,0,0,,Мен тірімін Мен тірімін Ахахахаха
Dialogue: 0,0:23:38.10,0:23:39.66,Default,,0,0,0,,Ахахахахаха
Dialogue: 0,0:23:39.73,0:23:43.60,Default,,0,0,0,,Иә Ахаха хехехе
Dialogue: 0,0:23:43.76,0:23:48.46,Default,,0,0,0,,Ахахаха ахахха
Dialogue: 0,0:23:48.60,0:23:54.76,Default,,0,0,0,,Ахахаха…
