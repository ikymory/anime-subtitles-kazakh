Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.46,0:00:14.03,Default,,0,0,0,,Мен Асамидің әпкесі туралы естіген жоқпын ба?
Dialogue: 0,0:00:14.36,0:00:16.46,Default,,0,0,0,,Биотехнология және тағамдық ғылыми-зерттеу институты
Dialogue: 0,0:00:18.36,0:00:19.16,Default,,0,0,0,,Кейта
Dialogue: 0,0:00:24.33,0:00:25.23,Default,,0,0,0,,Геркулес
Dialogue: 0,0:00:29.23,0:00:30.10,Default,,0,0,0,,Медуза
Dialogue: 0,0:00:31.76,0:00:32.93,Default,,0,0,0,,Және Икар
Dialogue: 0,0:00:35.03,0:00:38.80,Default,,0,0,0,,Біздің жобаға кедергі келтіретіндердің барлығын жойыңыз.
Dialogue: 0,0:00:40.26,0:00:42.26,Default,,0,0,0,,Беттерман Ламия
Dialogue: 0,0:00:43.10,0:00:45.03,Default,,0,0,0,,Шо Ясанаги
Dialogue: 0,0:00:50.06,0:00:54.13,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:01:05.10,0:01:06.80,Default,,0,0,0,,Ха ха ха жек көру
Dialogue: 0,0:01:21.46,0:01:22.56,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:01:31.66,0:01:32.63,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:01:37.30,0:01:37.76,Default,,0,0,0,,Га
Dialogue: 0,0:01:40.73,0:01:50.20,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:01:52.60,0:02:00.80,Default,,0,0,0,,Жүзетін күміс қайық
Dialogue: 0,0:02:02.53,0:02:11.20,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:02:14.46,0:02:22.50,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:02:25.60,0:02:34.46,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:02:34.80,0:02:42.96,Default,,0,0,0,,Жанға бағыт-бағдар беру
Dialogue: 0,0:02:44.73,0:02:54.30,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:54.60,0:03:06.16,Default,,0,0,0,,Ағынмен қозғалма...
Dialogue: 0,0:03:10.60,0:03:13.26,Default,,0,0,0,,Эй, неге мен сымсыз байланысты пайдалана алмаймын?
Dialogue: 0,0:03:13.56,0:03:16.26,Default,,0,0,0,,Маған қатты соққы тисе, мен сынамын.
Dialogue: 0,0:03:16.80,0:03:20.73,Default,,0,0,0,,Оянғандармен, Тиранмен әрең сөйлесемін.
Dialogue: 0,0:03:21.30,0:03:22.06,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:03:22.53,0:03:25.03,Default,,0,0,0,,- Құдай көмектессін... - Мордиварптың арнайы жасақтары осында болса.
Dialogue: 0,0:03:25.40,0:03:28.60,Default,,0,0,0,,Олар үш минутқа жетпей жойылды.
Dialogue: 0,0:03:29.63,0:03:33.23,Default,,0,0,0,,BPL-де нақты не болады?
Dialogue: 0,0:03:38.36,0:03:40.16,Default,,0,0,0,,А, мұнда ше?
Dialogue: 0,0:03:40.66,0:03:41.73,Default,,0,0,0,,Орталық күмбез
Dialogue: 0,0:03:42.23,0:03:43.76,Default,,0,0,0,,Жер бетіне шығатын жол болуы керек
Dialogue: 0,0:03:45.20,0:03:46.86,Default,,0,0,0,,Хаа ха ха
Dialogue: 0,0:03:46.96,0:03:47.73,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:03:47.90,0:03:49.93,Default,,0,0,0,,Ха ха жарайды
Dialogue: 0,0:03:50.26,0:03:51.36,Default,,0,0,0,,күрсіну
Dialogue: 0,0:03:56.56,0:03:57.23,Default,,0,0,0,,Тиран
Dialogue: 0,0:03:58.40,0:04:01.33,Default,,0,0,0,,Шо: Асами-сан да аман қалды.
Dialogue: 0,0:04:02.13,0:04:02.80,Default,,0,0,0,,Каэде
Dialogue: 0,0:04:03.06,0:04:03.93,Default,,0,0,0,,Сакора-чан
Dialogue: 0,0:04:04.33,0:04:07.00,Default,,0,0,0,,Тезірек, қателер келеді!
Dialogue: 0,0:04:16.60,0:04:18.36,Default,,0,0,0,,Келесі жолы мен осы жерден кетемін.
Dialogue: 0,0:04:21.33,0:04:24.20,Default,,0,0,0,,Гуаааааааааааааа
Dialogue: 0,0:04:25.10,0:04:28.10,Default,,0,0,0,,Бір және бәрі Бір және бәрі
Dialogue: 0,0:04:29.00,0:04:30.60,Default,,0,0,0,,Жақсы ұйымдастырылған топ
Dialogue: 0,0:04:31.00,0:04:32.30,Default,,0,0,0,,мен оған тек ризашылығымды және ең үлкен құрметімді білдіремін!
Dialogue: 0,0:04:42.30,0:04:49.13,Default,,0,0,0,,Гу Гу Гу Гу Гу Гу Гу Гу бөлінді Уууууууу
Dialogue: 0,0:04:49.56,0:04:53.50,Default,,0,0,0,,Эй Хиноки, жоқ, шығыс төмендеп жатыр.
Dialogue: 0,0:04:54.00,0:04:56.93,Default,,0,0,0,,Хинокидің қос импульсі әлсіреп бара жатқан сияқты.
Dialogue: 0,0:04:57.43,0:05:00.40,Default,,0,0,0,,Өтінемін, Хиноки, ынтымақтасуыңызды өтінемін.
Dialogue: 0,0:05:02.00,0:05:04.60,Default,,0,0,0,,Мүмкін мен осында өлуім керек шығар.
Dialogue: 0,0:05:06.03,0:05:09.26,Default,,0,0,0,,Ей, өлетін болсаң, жалғыз өлме.
Dialogue: 0,0:05:09.56,0:05:12.33,Default,,0,0,0,,Мені өзіңізбен бірге алып кетпеңіз.
Dialogue: 0,0:05:14.86,0:05:15.33,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:24.93,0:05:27.50,Default,,0,0,0,,Жарайды, бұл тамаша үзіліс синтезі.
Dialogue: 0,0:05:36.86,0:05:38.00,Default,,0,0,0,,Көлге құлау
Dialogue: 0,0:05:38.80,0:05:41.20,Default,,0,0,0,,Бұл гельді үнемдеудің жалғыз жолы
Dialogue: 0,0:05:41.56,0:05:42.40,Default,,0,0,0,,G-жиынтығы
Dialogue: 0,0:05:50.50,0:05:52.26,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:05:56.50,0:05:58.13,Default,,0,0,0,,Сен істедің, Кейта.
Dialogue: 0,0:05:58.73,0:06:01.86,Default,,0,0,0,,Бұл лезде, бірақ бүкіл көл қатты қышқылға айналады.
Dialogue: 0,0:06:02.10,0:06:05.70,Default,,0,0,0,,Бұл барлық түтік құрттарының хитинін бірден ыдырату стратегиясы ма?
Dialogue: 0,0:06:06.03,0:06:09.20,Default,,0,0,0,,Бірақ содан кейін оянған адамдар да еріп кетеді.
Dialogue: 0,0:06:09.53,0:06:11.00,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:06:11.20,0:06:16.26,Default,,0,0,0,,Бұл менің өнімім Perfectware болса, ол 5 немесе 10 минуттан аспайды.
Dialogue: 0,0:06:20.03,0:06:22.16,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:06:22.73,0:06:25.73,Default,,0,0,0,,Кішіменнің жылы көже стратегиясын ата
Dialogue: 0,0:06:26.80,0:06:28.73,Default,,0,0,0,,Керемет К-чан
Dialogue: 0,0:06:29.20,0:06:32.53,Default,,0,0,0,,Мұның бәрі Хинокидің қос импульсінің арқасында.
Dialogue: 0,0:06:32.86,0:06:36.46,Default,,0,0,0,,А-а, кешіріңіз, мен жаңа ғана ашуланып қалдым.
Dialogue: 0,0:06:37.00,0:06:40.50,Default,,0,0,0,,Жоқ, бұл менің кінәм, кешіріңіз.
Dialogue: 0,0:06:41.03,0:06:43.96,Default,,0,0,0,,Біз өлсек те Хиноки бірге боламыз
Dialogue: 0,0:06:46.33,0:06:47.10,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:58.33,0:06:59.40,Default,,0,0,0,,G-жиынтығы
Dialogue: 0,0:07:02.16,0:07:02.90,Default,,0,0,0,,Янаги-кун
Dialogue: 0,0:07:03.30,0:07:04.30,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:07:04.73,0:07:05.96,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:07:09.53,0:07:10.63,Default,,0,0,0,,Сұйық гелий?
Dialogue: 0,0:07:14.70,0:07:15.50,Default,,0,0,0,,Қашу
Dialogue: 0,0:07:16.03,0:07:16.93,Default,,0,0,0,,(Идзуми) Уау! Бұл өте қызықты естіледі.
Dialogue: 0,0:07:19.66,0:07:20.26,Default,,0,0,0,,Ахаха
Dialogue: 0,0:07:20.83,0:07:25.80,Default,,0,0,0,,Олар синаптикалық конвертке жасырын түрде сұйық гелий шығарды, солай ма?
Dialogue: 0,0:07:26.63,0:07:31.10,Default,,0,0,0,,Оны уақыт айырмашылығына байланысты пайда болатындай етіп реттеу таңқаларлық оңай болды.
Dialogue: 0,0:08:09.46,0:08:11.73,Default,,0,0,0,,Беттерман қауіпті емес пе?
Dialogue: 0,0:08:12.50,0:08:14.03,Default,,0,0,0,,Осыншама дисперсиямен
Dialogue: 0,0:08:14.23,0:08:17.60,Default,,0,0,0,,Оларды Psycho Voice арқылы жою қиын екені рас па?
Dialogue: 0,0:08:17.96,0:08:20.86,Default,,0,0,0,,Тұмандық қай жаққа ұшып барады?
Dialogue: 0,0:08:33.00,0:08:38.16,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:08:47.33,0:08:49.63,Default,,0,0,0,,Гуар
Dialogue: 0,0:08:55.20,0:08:58.66,Default,,0,0,0,,Жаңбыр бұлттары психо дауыстың соққы толқынын күшейтті ме?
Dialogue: 0,0:08:59.06,0:09:01.93,Default,,0,0,0,,Олай болса, мен де өзімді жарып жіберемін.
Dialogue: 0,0:09:02.26,0:09:05.16,Default,,0,0,0,,Ол үмітсіз шабуыл ма? иә?
Dialogue: 0,0:09:16.20,0:09:17.70,Default,,0,0,0,,Охххх
Dialogue: 0,0:09:22.00,0:09:23.03,Default,,0,0,0,,Барлығы қауіпсіз бе?
Dialogue: 0,0:09:23.63,0:09:24.46,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:09:25.36,0:09:26.46,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:27.06,0:09:32.00,Default,,0,0,0,,Жарайды, бәрібір бір жерге жиналып, Мордиварптың көмегінің келуін күтейік.
Dialogue: 0,0:09:33.16,0:09:36.16,Default,,0,0,0,,Мен мұны шынымен істегім келеді, бірақ
Dialogue: 0,0:09:41.30,0:09:45.60,Default,,0,0,0,,Гель шегі келгенше жаудың жасырынған жеріне тиген дұрыс.
Dialogue: 0,0:09:46.03,0:09:46.76,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:09:47.10,0:09:50.53,Default,,0,0,0,,Зертхана әлі де көптеген жәндіктерге толы.
Dialogue: 0,0:09:51.00,0:09:54.73,Default,,0,0,0,,Сондықтан оны қазір жеңген дұрыс.
Dialogue: 0,0:09:55.53,0:09:56.43,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,0:09:56.76,0:09:59.73,Default,,0,0,0,,Мұнда бегемоттардың көп саны өсіріледі.
Dialogue: 0,0:10:05.60,0:10:07.13,Default,,0,0,0,,Маған бұл енді ұнамайды
Dialogue: 0,0:10:08.03,0:10:09.70,Default,,0,0,0,,Бұл қозғалмайтын дәлелдеме ме?
Dialogue: 0,0:10:11.16,0:10:13.90,Default,,0,0,0,,Әй, тез қашқан дұрыс емес пе?
Dialogue: 0,0:10:14.86,0:10:16.13,Default,,0,0,0,,Абайсыз әрекет ету қауіпті
Dialogue: 0,0:10:16.76,0:10:17.86,Default,,0,0,0,,Әзірше кездесейік.
Dialogue: 0,0:10:21.73,0:10:23.76,Default,,0,0,0,,Шо: Менің аяғым құлап қалды.
Dialogue: 0,0:10:24.76,0:10:25.26,Default,,0,0,0,,Яғни, егер мен шынымен алға барсам, сен мені жұдырықтап тастайсың ба?
Dialogue: 0,0:10:25.36,0:10:26.16,Default,,0,0,0,,Ах аа
Dialogue: 0,0:10:27.60,0:10:28.30,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:10:29.50,0:10:30.50,Default,,0,0,0,,- Уау - Уау
Dialogue: 0,0:10:34.66,0:10:35.93,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:36.30,0:10:37.96,Default,,0,0,0,,Жарайды, бірден.
Dialogue: 0,0:10:39.73,0:10:42.06,Default,,0,0,0,,Үлкен тесік бар.
Dialogue: 0,0:10:42.40,0:10:43.73,Default,,0,0,0,,Су астындағы іс-әрекеттерге арналған жабдықтар
Dialogue: 0,0:10:44.26,0:10:45.33,Default,,0,0,0,,Мен уақытында үлгермейтін сияқтымын
Dialogue: 0,0:10:50.53,0:10:51.86,Default,,0,0,0,,Кяаааааааааааааааааааааа
Dialogue: 0,0:10:54.56,0:10:55.06,Default,,0,0,0,,Ммм
Dialogue: 0,0:10:57.00,0:10:57.46,Default,,0,0,0,,Ах
Dialogue: 0,0:11:01.93,0:11:03.76,Default,,0,0,0,,Батыс күмбезге оралу?
Dialogue: 0,0:11:04.03,0:11:06.63,Default,,0,0,0,,Мұны доктор Умезаки әдейі орнатты ма?
Dialogue: 0,0:11:07.23,0:11:08.86,Default,,0,0,0,,Сіз бізге қашып кетуге рұқсат бермейсіз бе?
Dialogue: 0,0:11:09.46,0:11:10.53,Default,,0,0,0,,Иә, бәрібір.
Dialogue: 0,0:11:16.60,0:11:19.10,Default,,0,0,0,,Мынадай жерді теспегенде
Dialogue: 0,0:11:20.33,0:11:23.96,Default,,0,0,0,,Беттерман, келесі жолы сені көргенде, шағымдануға тура келеді.
Dialogue: 0,0:11:24.63,0:11:25.33,Default,,0,0,0,,Коммуникациялар туралы не деуге болады?
Dialogue: 0,0:11:25.83,0:11:27.66,Default,,0,0,0,,Кептелу соншалықты нашар, бұл мүмкін емес.
Dialogue: 0,0:11:28.40,0:11:30.46,Default,,0,0,0,,Кейта-кун, жақсысың ба?
Dialogue: 0,0:11:31.20,0:11:32.60,Default,,0,0,0,,Әйтеуір, шығуды табайық.
Dialogue: 0,0:11:33.56,0:11:34.06,Default,,0,0,0,,Каэде
Dialogue: 0,0:11:34.66,0:11:36.03,Default,,0,0,0,,Мен жай ғана навигация жасауым керек пе?
Dialogue: 0,0:11:36.10,0:11:36.63,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:11:37.13,0:11:39.66,Default,,0,0,0,,Менің ойымша, шығысқа қарай кең жол жақсырақ.
Dialogue: 0,0:11:40.03,0:11:40.56,Default,,0,0,0,,OK
Dialogue: 0,0:11:41.33,0:11:44.26,Default,,0,0,0,,Доктор Умезаки бірдеңе орнатпады деп үміттенемін.
Dialogue: 0,0:11:45.03,0:11:46.00,Default,,0,0,0,,Мен күтемін
Dialogue: 0,0:11:47.20,0:11:48.26,Default,,0,0,0,,Мен күтемін
Dialogue: 0,0:11:51.53,0:11:52.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:52.80,0:11:54.86,Default,,0,0,0,,Олар бұл орталық күмбез деді.
Dialogue: 0,0:11:55.43,0:11:57.90,Default,,0,0,0,,Қызық, бұл Тиранның қай жерде екеніне байланысты ма?
Dialogue: 0,0:12:12.40,0:12:13.43,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:12:14.23,0:12:15.30,Default,,0,0,0,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:12:25.06,0:12:27.20,Default,,0,0,0,,Асами мырза оны Үндістанда таңдады.
Dialogue: 0,0:12:27.40,0:12:28.66,Default,,0,0,0,,Анимус гүлі?
Dialogue: 0,0:12:29.46,0:12:29.96,Default,,0,0,0,,Га
Dialogue: 0,0:12:31.86,0:12:32.40,Default,,0,0,0,,Ах
Dialogue: 0,0:12:33.63,0:12:34.76,Default,,0,0,0,,29-шы эпизод: Мақсат – Рим! Колизей
Dialogue: 0,0:12:35.23,0:12:38.06,Default,,0,0,0,,Мынау да, мынау да, мынау да
Dialogue: 0,0:12:38.26,0:12:42.20,Default,,0,0,0,,Бұл жүк кемесінде жасырылған адам капсуласы.
Dialogue: 0,0:12:42.56,0:12:44.70,Default,,0,0,0,,Неге менің бетімнен гүлдер жайқалып тұр?
Dialogue: 0,0:12:44.96,0:12:45.43,Default,,0,0,0,,Га
Dialogue: 0,0:12:48.26,0:12:49.13,Default,,0,0,0,,Хэчин мырза
Dialogue: 0,0:12:54.66,0:12:55.90,Default,,0,0,0,,Өлім әкелетін гүл?
Dialogue: 0,0:12:56.66,0:12:58.03,Default,,0,0,0,,Олар адамдардан гүлдейді ме?
Dialogue: 0,0:12:59.03,0:13:01.10,Default,,0,0,0,,Анимус гүл бақшасы
Dialogue: 0,0:13:02.60,0:13:06.03,Default,,0,0,0,,Мүмкін, доктор Умезаки жәндіктерді басқарған шығар.
Dialogue: 0,0:13:06.40,0:13:09.36,Default,,0,0,0,,Олар тұтқынға алынған адамдар мен капсулаларды тасымалдаған болуы мүмкін.
Dialogue: 0,0:13:09.76,0:13:13.33,Default,,0,0,0,,Күткендей, мен Үндістанда көрген геометриялық өрнекті тесік
Dialogue: 0,0:13:13.83,0:13:15.73,Default,,0,0,0,,Іштен шабуыл жасағандар?
Dialogue: 0,0:13:16.33,0:13:16.83,Default,,0,0,0,,О
Dialogue: 0,0:13:17.50,0:13:21.96,Default,,0,0,0,,Рэнд медициналық орталығының жертөлесінен капсулалар мен қызметкерлер де шығарылды.
Dialogue: 0,0:13:22.56,0:13:25.90,Default,,0,0,0,,Сонымен жүк кемесінің ішіндегі алтыбұрышты қабырға туралы не деуге болады?
Dialogue: 0,0:13:27.53,0:13:30.56,Default,,0,0,0,,Жүк кемесінен капсуланы да кім алды?
Dialogue: 0,0:13:31.70,0:13:32.46,Default,,0,0,0,,Барлығы
Dialogue: 0,0:13:38.80,0:13:39.80,Default,,0,0,0,,Жәндіктердің жұмысы
Dialogue: 0,0:13:41.06,0:13:45.43,Default,,0,0,0,,Ал бұл адамдар анимустың гүлденуіне арналған питомниктер болды.
Dialogue: 0,0:13:46.66,0:13:49.60,Default,,0,0,0,,Батыс аңыздарындағы Мандрагора сияқты
Dialogue: 0,0:13:50.26,0:13:53.96,Default,,0,0,0,,Сонда Аджанта астындағы гүл бақшасы ше?
Dialogue: 0,0:14:12.50,0:14:15.36,Default,,0,0,0,,Гаригари Гаригари Гаригари Гарит Гарит
Dialogue: 0,0:14:15.63,0:14:16.36,Default,,0,0,0,,Ах Ах
Dialogue: 0,0:14:32.16,0:14:34.80,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:14:35.46,0:14:36.33,Default,,0,0,0,,Уау
Dialogue: 0,0:14:37.16,0:14:38.46,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:14:39.46,0:14:42.50,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:14:43.23,0:14:48.16,Default,,0,0,0,,Беттерман Ламия өзгерген кезде, ол жеген анимус жемісі болды.
Dialogue: 0,0:14:50.33,0:14:53.16,Default,,0,0,0,,Бұл жемістің қандай құпиясы бар?
Dialogue: 0,0:14:55.50,0:14:58.20,Default,,0,0,0,,Сонымен қатар, сіз осы өсірумен не істеп жатырсыз?
Dialogue: 0,0:14:58.70,0:14:59.90,Default,,0,0,0,,Dr.
Dialogue: 0,0:15:00.16,0:15:04.73,Default,,0,0,0,,Біз жартылай тұрақты түрде клондауға болатын тағам әзірлеумен айналыстық.
Dialogue: 0,0:15:05.33,0:15:06.20,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:15:07.30,0:15:07.76,Default,,0,0,0,,Ах
Dialogue: 0,0:15:08.26,0:15:08.73,Default,,0,0,0,,Эй
Dialogue: 0,0:15:09.16,0:15:09.60,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:15:10.33,0:15:11.43,Default,,0,0,0,,Сіз бірдеңенің иісін сезбейсіз бе?
Dialogue: 0,0:15:12.00,0:15:15.96,Default,,0,0,0,,Ах, иіс жоқ, доктор Умезаки анық қара.
Dialogue: 0,0:15:16.30,0:15:20.00,Default,,0,0,0,,Жоқ, қарашы, мына иіс.
Dialogue: 0,0:15:20.63,0:15:21.30,Default,,0,0,0,,Иіс?
Dialogue: 0,0:15:21.73,0:15:25.73,Default,,0,0,0,,Ойлап қарасам, бал сияқты тәтті нәрсе екен.
Dialogue: 0,0:15:26.36,0:15:30.06,Default,,0,0,0,,Ион алмасу сүзгісі дұрыс жұмыс істеп тұр.
Dialogue: 0,0:15:31.53,0:15:35.56,Default,,0,0,0,,Күрсін, мен өзімді жақсы сезіне бастадым.
Dialogue: 0,0:15:35.96,0:15:39.66,Default,,0,0,0,,NBC-ке қарсы жабдық мінсіз болғанымен, иіс молекулалары
Dialogue: 0,0:15:40.46,0:15:41.23,Default,,0,0,0,,Молекула болып табылады
Dialogue: 0,0:15:42.66,0:15:43.60,Default,,0,0,0,,Молекула болып табылады
Dialogue: 0,0:15:45.90,0:15:51.06,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:15:51.46,0:15:54.50,Default,,0,0,0,,Атмосферада ерекше компонент бар.
Dialogue: 0,0:15:55.30,0:15:57.70,Default,,0,0,0,,Ингредиенттер
Dialogue: 0,0:15:58.63,0:16:03.03,Default,,0,0,0,,Тоқаш тоқаш тоқаш тоқаш тоқаш тоқаш тоқаш тоқаш тоқаш
Dialogue: 0,0:16:03.40,0:16:08.10,Default,,0,0,0,,Бум бум бум Ах, ара ұшады Хехехехехе
Dialogue: 0,0:16:08.13,0:16:11.83,Default,,0,0,0,,Бум бум бум ара ұшады
Dialogue: 0,0:16:12.16,0:16:14.83,Default,,0,0,0,,Кей-чан, бәрі де.
Dialogue: 0,0:16:15.13,0:16:17.33,Default,,0,0,0,,Хахахахахаха
Dialogue: 0,0:16:17.46,0:16:19.30,Default,,0,0,0,,Хахахахахаха
Dialogue: 0,0:16:19.40,0:16:21.80,Default,,0,0,0,,Ахахахахахаха хехехехе
Dialogue: 0,0:16:22.16,0:16:27.63,Default,,0,0,0,,Bufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufu
Dialogue: 0,0:16:28.20,0:16:31.10,Default,,0,0,0,,Жоқ, сіз мұнда қала алмайсыз.
Dialogue: 0,0:16:31.96,0:16:34.20,Default,,0,0,0,,Хиноки-сан тез
Dialogue: 0,0:16:36.26,0:16:40.43,Default,,0,0,0,,Хехе хехе хехе хахаха хаха
Dialogue: 0,0:16:40.46,0:16:44.33,Default,,0,0,0,,-Хахахахаха... -Иә?
Dialogue: 0,0:16:47.63,0:16:51.10,Default,,0,0,0,,Жәндіктер жоқ, Алжерноннан ешқандай қауіп жоқ сияқты.
Dialogue: 0,0:16:51.73,0:16:53.50,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:16:54.16,0:16:57.00,Default,,0,0,0,,Мен қазір Schlieren қолданып жатырмын.
Dialogue: 0,0:16:57.30,0:16:58.40,Default,,0,0,0,,Schlieren дегеніміз не?
Dialogue: 0,0:16:58.80,0:17:03.56,Default,,0,0,0,,Ауа тығыздығындағы айырмашылықтарды түсіру және иістерді көру үшін жарықты пайдаланатын құрылғы!
Dialogue: 0,0:17:04.36,0:17:05.03,Default,,0,0,0,,Э?
Dialogue: 0,0:17:05.43,0:17:06.30,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:06.63,0:17:11.36,Default,,0,0,0,,Феромон негізіндегі химиялық заттың бір түрі көп мөлшерде шығарыла бастады.
Dialogue: 0,0:17:12.10,0:17:13.80,Default,,0,0,0,,Феромондардың иісі бар ма?
Dialogue: 0,0:17:14.26,0:17:18.03,Default,,0,0,0,,Бұл бағыт BPL орталық күмбезінің жер асты.
Dialogue: 0,0:17:23.20,0:17:27.10,Default,,0,0,0,,Ха ха ха ха ха ха ха
Dialogue: 0,0:17:27.86,0:17:31.36,Default,,0,0,0,,Хэхе хахахаха...
Dialogue: 0,0:17:33.13,0:17:34.50,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:17:34.70,0:17:36.13,Default,,0,0,0,,Әй, мына гүлдер
Dialogue: 0,0:17:37.80,0:17:40.16,Default,,0,0,0,,Дофамин нейротрансмиттері
Dialogue: 0,0:17:40.46,0:17:44.06,Default,,0,0,0,,Олар миға бөлінетін феромондарды таратса да.
Dialogue: 0,0:17:44.40,0:17:47.33,Default,,0,0,0,,Ешқандай айырмашылық жоқ. Хехе хехе хехе хехе
Dialogue: 0,0:17:47.50,0:17:49.66,Default,,0,0,0,,Хахахахаха солай
Dialogue: 0,0:17:49.96,0:17:55.26,Default,,0,0,0,,Біздің ләззат орталықтары барынша ынталандырылады.
Dialogue: 0,0:17:55.36,0:17:57.83,Default,,0,0,0,,Ха ха ха ха хи хи хи хи хи хи
Dialogue: 0,0:17:58.00,0:18:01.56,Default,,0,0,0,,Бәріміз де өлеміз.
Dialogue: 0,0:18:01.60,0:18:04.40,Default,,0,0,0,,Ахахахаха…
Dialogue: 0,0:18:04.93,0:18:07.26,Default,,0,0,0,,Әй, бұл не деректер?
Dialogue: 0,0:18:07.60,0:18:11.30,Default,,0,0,0,,Осыншама көп феромондардың арасында ешкім есі дұрыс бола алмайды.
Dialogue: 0,0:18:11.73,0:18:14.23,Default,,0,0,0,,Егер біреу бар болса, стимуляторларға үйреніп қалған Сакора шығар.
Dialogue: 0,0:18:15.00,0:18:19.10,Default,,0,0,0,,Дұрыс, мен де шыдай алмаймын.
Dialogue: 0,0:18:19.20,0:18:20.23,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:18:20.93,0:18:22.60,Default,,0,0,0,,Нахахахахаха
Dialogue: 0,0:18:22.70,0:18:23.33,Default,,0,0,0,,Нухахахаха
Dialogue: 0,0:18:23.40,0:18:26.70,Default,,0,0,0,,Лала Негі Бүгін де Неги
Dialogue: 0,0:18:26.73,0:18:30.00,Default,,0,0,0,,Президент-чан, иісі жақсы.
Dialogue: 0,0:18:30.33,0:18:34.93,Default,,0,0,0,,Мен сені тез өлтіремін, иісін сеземін.
Dialogue: 0,0:18:35.00,0:18:39.30,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:18:39.36,0:18:42.90,Default,,0,0,0,,Хахахаха би билеп ән айт
Dialogue: 0,0:18:43.53,0:18:46.80,Default,,0,0,0,,Саламандрдың қасиетті суы ми импульстарын өзгертті.
Dialogue: 0,0:18:47.13,0:18:48.96,Default,,0,0,0,,Белладоннаға жеткізу
Dialogue: 0,0:18:50.66,0:18:54.36,Default,,0,0,0,,Ал белладонна күй тартады.
Dialogue: 0,0:18:54.86,0:18:56.43,Default,,0,0,0,,Менің ұпайым бойынша
Dialogue: 0,0:19:00.36,0:19:04.13,Default,,0,0,0,,Хахахаха аа хахахаха...
Dialogue: 0,0:19:04.16,0:19:04.70,Default,,0,0,0,,Ах ха
Dialogue: 0,0:19:04.76,0:19:06.36,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:19:06.70,0:19:08.63,Default,,0,0,0,,Ах ха ха ха ха
Dialogue: 0,0:19:08.73,0:19:10.26,Default,,0,0,0,,Хихьяхьяхьяхьяхя
Dialogue: 0,0:19:10.36,0:19:12.40,Default,,0,0,0,,Хихихихихи
Dialogue: 0,0:19:12.46,0:19:14.23,Default,,0,0,0,,Хахахахахаха
Dialogue: 0,0:19:17.80,0:19:18.63,Default,,0,0,0,,Хотата
Dialogue: 0,0:19:20.26,0:19:22.56,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:23.23,0:19:24.13,Default,,0,0,0,,Маған қоңырау шалыңыз
Dialogue: 0,0:19:24.96,0:19:28.20,Default,,0,0,0,,Сіз мені әрқашан Better Man деп атайсыз.
Dialogue: 0,0:19:29.30,0:19:32.46,Default,,0,0,0,,Мен сені шақырып жатырмын ба?
Dialogue: 0,0:19:41.60,0:19:44.50,Default,,0,0,0,,Кінәлі – билік
Dialogue: 0,0:19:46.00,0:19:48.10,Default,,0,0,0,,Мен сені күттім, Беттерман.
Dialogue: 0,0:19:48.86,0:19:49.46,Default,,0,0,0,,Ламия
Dialogue: 0,0:19:49.80,0:19:53.00,Default,,0,0,0,,Бұл сіз қалайсыз ба?
Dialogue: 0,0:19:53.66,0:19:56.03,Default,,0,0,0,,Хахахахахахаха
Dialogue: 0,0:19:56.60,0:19:58.43,Default,,0,0,0,,Келіңіз және алыңыз.
Dialogue: 0,0:19:59.16,0:20:02.10,Default,,0,0,0,,Бұл түрлендіру үшін қажет пе?
Dialogue: 0,0:20:09.60,0:20:10.26,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:20:15.66,0:20:16.13,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:17.43,0:20:17.86,Default,,0,0,0,,Ах
Dialogue: 0,0:20:20.96,0:20:21.60,Default,,0,0,0,,Рубрум
Dialogue: 0,0:20:24.30,0:20:25.23,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:20:25.40,0:20:28.13,Default,,0,0,0,,Саңырауқұлақ әдеттен тыс тез өседі.
Dialogue: 0,0:20:28.53,0:20:32.83,Default,,0,0,0,,Тіпті Беттерманның мақтанған пектофорезі де бұғатталған сияқты.
Dialogue: 0,0:20:33.50,0:20:35.10,Default,,0,0,0,,Біраз демалыңыз
Dialogue: 0,0:20:35.80,0:20:40.13,Default,,0,0,0,,Трансформациядан кейін денеге бірнеше сағат ұйқы қажет.
Dialogue: 0,0:20:42.80,0:20:46.70,Default,,0,0,0,,Осы арада жан-жақты талдап көрейік.
Dialogue: 0,0:20:47.13,0:20:47.93,Default,,0,0,0,,Тасымалдаушы
Dialogue: 0,0:20:55.96,0:20:58.16,Default,,0,0,0,,Нухахахахаха
Dialogue: 0,0:20:59.93,0:21:00.86,Default,,0,0,0,,Мен келемін
Dialogue: 0,0:21:03.83,0:21:04.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:07.43,0:21:10.70,Default,,0,0,0,,Не? Сол адам тәрізді жарық
Dialogue: 0,0:21:42.73,0:21:43.50,Default,,0,0,0,,Тасымалдаушы
Dialogue: 0,0:21:49.23,0:21:57.06,Default,,0,0,0,,Бірақ бұл қызық бола бастады.
Dialogue: 0,0:21:57.43,0:21:58.00,Default,,0,0,0,,Не?!
Dialogue: 0,0:22:11.26,0:22:12.70,Default,,0,0,0,,Үлкен энергия
Dialogue: 0,0:22:13.76,0:22:14.43,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:22:17.83,0:22:20.33,Default,,0,0,0,,Жоқ, сен де жақсы адамсың
Dialogue: 0,0:22:20.90,0:22:21.60,Default,,0,0,0,,Люме
Dialogue: 0,0:22:34.50,0:22:47.20,Default,,0,0,0,,Құдайдың күнәсі шексіз теломераларға ойылған
Dialogue: 0,0:22:47.83,0:22:53.96,Default,,0,0,0,,Жалынды құшақтау
Dialogue: 0,0:22:54.36,0:23:01.50,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:01.80,0:23:05.03,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.33,0:23:08.53,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.70,0:23:12.00,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.20,0:23:15.43,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.33,0:23:27.06,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:27.53,0:23:37.20,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:37.83,0:23:48.66,Default,,0,0,0,,Өсіп келе жатқан үмітті жырла!
Dialogue: 0,0:24:01.23,0:24:03.76,Default,,0,0,0,,Адамның тағдыры шақырады
Dialogue: 0,0:24:04.83,0:24:09.06,Default,,0,0,0,,Шексіз өткен, қайғылы тартыс
Dialogue: 0,0:24:10.20,0:24:14.33,Default,,0,0,0,,Жүрегім бұралып, жүрегім өлді
Dialogue: 0,0:24:15.20,0:24:18.16,Default,,0,0,0,,Барлығын Форте басып қалды
Dialogue: 0,0:24:19.30,0:24:21.30,Default,,0,0,0,,Сенің де жүрегің
Dialogue: 0,0:24:21.96,0:24:23.26,Default,,0,0,0,,Бөлу
Dialogue: 0,0:24:24.76,0:24:30.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
