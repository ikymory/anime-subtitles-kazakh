Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.50,0:00:07.96,Default,,0,0,0,,Эх!
Dialogue: 0,0:00:08.04,0:00:10.21,Default,,0,0,0,,Бұл жақсырақ!
Dialogue: 0,0:00:10.30,0:00:13.22,Default,,0,0,0,,Өйткені Цзянши жаман аяқталуды жақсы көреді!
Dialogue: 0,0:00:13.30,0:00:15.68,Default,,0,0,0,,Бұл жаман аяқталмайды.
Dialogue: 0,0:00:16.18,0:00:19.47,Default,,0,0,0,,Коноха мұның көңілді жаман аяқталатынын айтады.
Dialogue: 0,0:00:19.56,0:00:21.39,Default,,0,0,0,,Қазіргі трендті өлім ойыны қандай?
Dialogue: 0,0:00:21.47,0:00:23.23,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:00:24.94,0:00:27.44,Default,,0,0,0,,Балалар, сендерге әлі ерте.
Dialogue: 0,0:00:27.52,0:00:28.69,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:00:28.77,0:00:31.32,Default,,0,0,0,,Кюнши (Ларако) Мен өзімді қарт адамдай сезінемін
Dialogue: 0,0:00:32.03,0:00:33.49,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:00:33.57,0:00:34.65,Default,,0,0,0,,Аа...
Dialogue: 0,0:00:40.74,0:00:41.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:42.04,0:00:45.00,Default,,0,0,0,,Мейконың тағы бір жанкүйері осында.
Dialogue: 0,0:00:45.08,0:00:46.75,Default,,0,0,0,,Бишоуджо ойынының түпнұсқа суретшісі болыңыз
Dialogue: 0,0:00:46.83,0:00:49.13,Default,,0,0,0,,Біз адамдар бізді қуып жететін дәуірде өмір сүріп жатырмыз.
Dialogue: 0,0:00:49.21,0:00:51.42,Default,,0,0,0,,Енді мен оны қуу демеймін.
Dialogue: 0,0:00:52.05,0:00:53.67,Default,,0,0,0,,Сталкер!
Dialogue: 0,0:00:55.38,0:00:56.63,Default,,0,0,0,,Сәлем Коно-чан
Dialogue: 0,0:00:56.72,0:00:58.30,Default,,0,0,0,,Иә, Мейко-сан.
Dialogue: 0,0:00:58.80,0:00:59.35,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:00:59.43,0:01:01.89,Default,,0,0,0,,Бір-бірінің сызбасын сәйкестендіру...
Dialogue: 0,0:01:01.97,0:01:03.27,Default,,0,0,0,,Мейкоға ұнайды
Dialogue: 0,0:01:03.35,0:01:04.77,Default,,0,0,0,,Менің ойымша, сіз оны суретке түсіруіңіз керек!
Dialogue: 0,0:01:04.85,0:01:06.56,Default,,0,0,0,,Егер сізде тек түстер болса
Dialogue: 0,0:01:06.64,0:01:08.65,Default,,0,0,0,,Бірақ Коно-чан мен мен
Dialogue: 0,0:01:08.73,0:01:10.65,Default,,0,0,0,,Үлгі тым өзгеше емес пе?
Dialogue: 0,0:01:10.73,0:01:15.11,Default,,0,0,0,,Мазмұны қызықты болса, суреттердегі айырмашылық оны көбірек моей етеді.
Dialogue: 0,0:01:15.20,0:01:16.53,Default,,0,0,0,,Әлеуметтік ойындар үшін бұл қалыпты жағдай.
Dialogue: 0,0:01:16.61,0:01:18.36,Default,,0,0,0,,Әлеуметтік ойын?
Dialogue: 0,0:01:19.03,0:01:20.33,Default,,0,0,0,,Хмм?
Dialogue: 0,0:01:21.49,0:01:23.83,Default,,0,0,0,,...
Dialogue: 0,0:01:23.91,0:01:27.46,Default,,0,0,0,,♪ Хун хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе
Dialogue: 0,0:01:30.63,0:01:31.75,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:01:31.84,0:01:34.51,Default,,0,0,0,,Бұрынғы «ГОРОСКОПқа» қарағанда ғажайып.
Dialogue: 0,0:01:34.59,0:01:36.13,Default,,0,0,0,,Біріншіден, сценарийдің көлемі...
Dialogue: 0,0:01:39.64,0:01:40.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:03.83,0:02:04.33,Default,,0,0,0,,О
Dialogue: 0,0:02:09.46,0:02:11.84,Default,,0,0,0,,Жарайсың (Гомикава) Хэхе
Dialogue: 0,0:02:11.92,0:02:13.38,Default,,0,0,0,,Жақсы баға.
Dialogue: 0,0:02:20.47,0:02:22.64,Default,,0,0,0,,Хааа~
Dialogue: 0,0:02:22.72,0:02:24.10,Default,,0,0,0,,Айқай~
Dialogue: 0,0:02:30.52,0:02:32.27,Default,,0,0,0,,Пуха~
Dialogue: 0,0:02:52.04,0:02:54.04,Default,,0,0,0,,♪～
Dialogue: 0,0:04:17.71,0:04:19.71,Default,,0,0,0,,～♪
Dialogue: 0,0:04:36.90,0:04:39.27,Default,,0,0,0,,О... Эй, мынау...
Dialogue: 0,0:04:39.36,0:04:41.53,Default,,0,0,0,,Уау, бұл қызық көрінеді!
Dialogue: 0,0:04:41.61,0:04:43.74,Default,,0,0,0,,Мен оны қызықты етіп жасадым.
Dialogue: 0,0:04:43.82,0:04:46.99,Default,,0,0,0,,Біз мұны шынымен жасадық па?
Dialogue: 0,0:04:47.07,0:04:49.74,Default,,0,0,0,,Дұрыс, 5 айдан кейін!
Dialogue: 0,0:04:49.83,0:04:51.29,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:04:51.37,0:04:53.62,Default,,0,0,0,,Негізгіге сақтық көшірме жасау
Dialogue: 0,0:04:53.71,0:04:54.83,Default,,0,0,0,,Және резерв
Dialogue: 0,0:04:54.91,0:04:56.33,Default,,0,0,0,,Дубляж да аяқталды.
Dialogue: 0,0:04:56.42,0:04:57.83,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:04:57.92,0:04:59.46,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:04:59.54,0:05:01.92,Default,,0,0,0,,үшін, бәрі орындалды!
Dialogue: 0,0:05:02.01,0:05:03.13,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:05:03.76,0:05:07.05,Default,,0,0,0,,Сәлем! Ура!
Dialogue: 0,0:05:07.14,0:05:09.35,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:05:10.56,0:05:11.39,Default,,0,0,0,,Дегенмен, не болып жатқанын түсінбеймін.
Dialogue: 0,0:05:11.47,0:05:14.43,Default,,0,0,0,,Тағдыры қауіп төндіретін алкогольдік бағдарламалық жасақтаманың соңғы жұмысы
Dialogue: 0,0:05:14.52,0:05:16.77,Default,,0,0,0,,«Соңғы вальс» аяқталды!
Dialogue: 0,0:05:17.90,0:05:20.06,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:05:20.15,0:05:23.03,Default,,0,0,0,,Бүгін мен ішіп, жеймін!
Dialogue: 0,0:05:23.11,0:05:25.53,Default,,0,0,0,,Маған енді 1 миллиард бәрібір!
Dialogue: 0,0:05:25.61,0:05:26.49,Default,,0,0,0,,Не!
Dialogue: 0,0:05:26.57,0:05:29.41,Default,,0,0,0,,Мен осындай нәрсені жасағаныма қуаныштымын!
Dialogue: 0,0:05:29.49,0:05:31.74,Default,,0,0,0,,Жоқ, жоқ, бұл жақсы емес, солай ма? Жақсы емес пе?
Dialogue: 0,0:05:31.83,0:05:32.74,Default,,0,0,0,,Эй!
Dialogue: 0,0:05:32.83,0:05:35.83,Default,,0,0,0,,Бірақ бұл шынымен сатылады деп ойлаймын.
Dialogue: 0,0:05:35.91,0:05:39.00,Default,,0,0,0,,Иә! Шындығында, мұнда және жерде жауап жақсы болды.
Dialogue: 0,0:05:39.08,0:05:40.92,Default,,0,0,0,,Сіз оны асыға күтетін шығарсыз!
Dialogue: 0,0:05:41.00,0:05:42.34,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:05:44.34,0:05:46.59,Default,,0,0,0,,Цзянши әрқашан болды
Dialogue: 0,0:05:46.67,0:05:49.22,Default,,0,0,0,,Сіз мұны істей алмайтыныңызды айттыңыз!
Dialogue: 0,0:05:49.30,0:05:52.35,Default,,0,0,0,,Сен ойлайсың, ойланбас жоспар.
Dialogue: 0,0:05:52.43,0:05:54.60,Default,,0,0,0,,Ондай Кёнсуға...
Dialogue: 0,0:05:55.10,0:05:57.98,Default,,0,0,0,,Жаза!
Dialogue: 0,0:05:58.52,0:06:00.73,Default,,0,0,0,,Қолдарыңызды пайдалануды тоқтатыңыз! Қолдар!
Dialogue: 0,0:06:00.81,0:06:02.15,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:06:02.23,0:06:05.03,Default,,0,0,0,,Егер Mamo-chan дауыспен енгізу бағдарламалық құралын жасаса
Dialogue: 0,0:06:05.11,0:06:07.03,Default,,0,0,0,,Мормантай!
Dialogue: 0,0:06:07.11,0:06:09.03,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:06:09.66,0:06:12.41,Default,,0,0,0,,Уф... Бұл ұят.
Dialogue: 0,0:06:12.49,0:06:14.70,Default,,0,0,0,,Бұл... қорқынышты.
Dialogue: 0,0:06:14.79,0:06:18.54,Default,,0,0,0,,Дәлірек айтқанда, қамқоршы қайда?
Dialogue: 0,0:06:18.62,0:06:21.88,Default,,0,0,0,,Менің ойымша, Мамору әлі компанияда.
Dialogue: 0,0:06:21.96,0:06:26.21,Default,,0,0,0,,Хаха, ол керемет жігіт~
Dialogue: 0,0:06:27.34,0:06:29.30,Default,,0,0,0,,Айтпақшы,
Dialogue: 0,0:06:29.38,0:06:31.72,Default,,0,0,0,,Sofmap сайтында ``Соңғы вальс'' постері әлдеқашан бар.
Dialogue: 0,0:06:31.80,0:06:32.80,Default,,0,0,0,,Ол жарияланды.
Dialogue: 0,0:06:32.89,0:06:34.93,Default,,0,0,0,,Мен... Мен оны көргім келеді!
Dialogue: 0,0:06:35.01,0:06:36.97,Default,,0,0,0,,Барып көрейік! Барып көрейік!
Dialogue: 0,0:06:40.19,0:06:41.90,Default,,0,0,0,,Мен оны асыға күтемін~
Dialogue: 0,0:06:41.98,0:06:44.65,Default,,0,0,0,,Өте жұмсақ!
Dialogue: 0,0:06:45.36,0:06:47.15,Default,,0,0,0,,♬~
Dialogue: 0,0:06:49.65,0:06:51.74,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:06:51.82,0:06:53.95,Default,,0,0,0,,Күрсін, бұл жақсы!
Dialogue: 0,0:06:54.03,0:06:56.95,Default,,0,0,0,,Осылай қарасам, тағы да сеземін.
Dialogue: 0,0:06:57.04,0:06:57.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:58.04,0:07:00.62,Default,,0,0,0,,Ей, бәріміз бірге суретке түсейік.
Dialogue: 0,0:07:00.71,0:07:02.46,Default,,0,0,0,,Кімде фотоаппарат бар?
Dialogue: 0,0:07:02.54,0:07:03.54,Default,,0,0,0,,Бар.
Dialogue: 0,0:07:03.63,0:07:05.17,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:07:05.25,0:07:06.80,Default,,0,0,0,,Сол жерде суретке түсіріңіз!
Dialogue: 0,0:07:08.46,0:07:09.84,Default,,0,0,0,,Хааа~
Dialogue: 0,0:07:09.92,0:07:11.18,Default,,0,0,0,,Коно-чан
Dialogue: 0,0:07:15.26,0:07:18.64,Default,,0,0,0,,Бишоужо ойынын жасайтын менмін.
Dialogue: 0,0:07:18.72,0:07:20.48,Default,,0,0,0,,Мен біраз ыңғайсызданып қалдым.
Dialogue: 0,0:07:20.56,0:07:21.48,Default,,0,0,0,,Не!
Dialogue: 0,0:07:21.56,0:07:26.44,Default,,0,0,0,,Өйткені ол әйел және әдемі қыздардың тентек суреттерін салады.
Dialogue: 0,0:07:26.94,0:07:28.86,Default,,0,0,0,,Менің ойымша, бұл біртүрлі болды.
Dialogue: 0,0:07:28.94,0:07:29.99,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:30.07,0:07:34.28,Default,,0,0,0,,Бірақ іс жүзінде бұл мүлдем маңызды емес еді.
Dialogue: 0,0:07:34.37,0:07:35.70,Default,,0,0,0,,Енді мен білемін
Dialogue: 0,0:07:36.53,0:07:39.62,Default,,0,0,0,,Өйткені қазір бұл ойын
Dialogue: 0,0:07:39.70,0:07:43.04,Default,,0,0,0,,Өйткені мен мұны барлығының жасағанын қалаймын.
Dialogue: 0,0:07:43.71,0:07:47.21,Default,,0,0,0,,Бұл ойын өте қызықты!
Dialogue: 0,0:07:47.71,0:07:48.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:48.96,0:07:52.13,Default,,0,0,0,,Бірге сыз, бірге боя
Dialogue: 0,0:07:52.22,0:07:56.39,Default,,0,0,0,,Әркім өз әңгімесін, дауысын, дыбысын әкеледі.
Dialogue: 0,0:07:56.93,0:07:58.31,Default,,0,0,0,,Сорғы
Dialogue: 0,0:07:59.14,0:08:01.23,Default,,0,0,0,,Менің “ұятым”
Dialogue: 0,0:08:01.31,0:08:03.81,Default,,0,0,0,,үшін аздап әкелді.
Dialogue: 0,0:08:04.65,0:08:08.32,Default,,0,0,0,,Ендеше, мен сенің бәрін көргеніңді қалаймын!
Dialogue: 0,0:08:08.40,0:08:11.40,Default,,0,0,0,,Мен бүкіл әлемдегі адамдар осылай істегенін қалаймын.
Dialogue: 0,0:08:11.49,0:08:13.53,Default,,0,0,0,,Сіз... әлем?
Dialogue: 0,0:08:13.61,0:08:17.49,Default,,0,0,0,,Жарайды... бұл аздап асыра сілтеу, хаха...
Dialogue: 0,0:08:17.58,0:08:19.99,Default,,0,0,0,,Жоқ, бұл дұрыс емес!
Dialogue: 0,0:08:20.08,0:08:21.54,Default,,0,0,0,,Қайырлы дүние!
Dialogue: 0,0:08:21.62,0:08:23.92,Default,,0,0,0,,Бұл да алдын ала жасалған қадам! Иә
Dialogue: 0,0:08:24.00,0:08:26.75,Default,,0,0,0,,Бүкіл дүние жүзіндегі адамдарды осылай жасауға шақырайық!
Dialogue: 0,0:08:26.83,0:08:30.00,Default,,0,0,0,,«Некопара» Мяуға ұмтыл!
Dialogue: 0,0:08:30.09,0:08:31.63,Default,,0,0,0,,Мияу... Мияу?
Dialogue: 0,0:08:31.71,0:08:33.34,Default,,0,0,0,,Мияу!
Dialogue: 0,0:08:33.42,0:08:35.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:35.59,0:08:37.47,Default,,0,0,0,,Фуфу Ахаха!
Dialogue: 0,0:08:37.97,0:08:41.72,Default,,0,0,0,,Әй, жинал, суретке түсейік.
Dialogue: 0,0:08:41.81,0:08:43.43,Default,,0,0,0,,Иә
Dialogue: 0,0:08:44.10,0:08:46.44,Default,,0,0,0,,Мейко-сан, тез, тез
Dialogue: 0,0:08:48.73,0:08:50.48,Default,,0,0,0,,Сәлем Тенчо-сан
Dialogue: 0,0:08:50.57,0:08:54.03,Default,,0,0,0,,Суретке түскен соң, ана жаққа барайық!
Dialogue: 0,0:08:54.11,0:08:56.11,Default,,0,0,0,,Ол қайда? Онда
Dialogue: 0,0:08:56.20,0:08:58.57,Default,,0,0,0,,«Онда» дегені…
Dialogue: 0,0:08:58.66,0:09:00.12,Default,,0,0,0,,Дежико ғимараты!
Dialogue: 0,0:09:00.66,0:09:02.29,Default,,0,0,0,,Хоуа~
Dialogue: 0,0:09:02.37,0:09:05.41,Default,,0,0,0,,Бұл Дежико ғимараты! Мен оны бірінші рет көрдім
Dialogue: 0,0:09:05.50,0:09:08.00,Default,,0,0,0,,Қайта қарасам, ғажап
Dialogue: 0,0:09:08.50,0:09:11.25,Default,,0,0,0,,Акихабарада осындай нәрсені салу дұрыс па?
Dialogue: 0,0:09:11.34,0:09:12.46,Default,,0,0,0,,Әдемі қыздар да
Dialogue: 0,0:09:12.55,0:09:15.34,Default,,0,0,0,,Ақыры мен ғимараттың басына жеттім.
Dialogue: 0,0:09:15.84,0:09:16.97,Default,,0,0,0,,Тіпті біз де
Dialogue: 0,0:09:17.05,0:09:20.22,Default,,0,0,0,,Сіз соншалықты үлкен тақта қоя аласыз!
Dialogue: 0,0:09:20.30,0:09:23.06,Default,,0,0,0,,Дежико ғимараты жаңадан салынды!
Dialogue: 0,0:09:23.14,0:09:24.60,Default,,0,0,0,,Уау~
Dialogue: 0,0:09:25.81,0:09:26.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.85,0:09:30.31,Default,,0,0,0,,Жарайды, онда келесіге көшейік!
Dialogue: 0,0:09:30.40,0:09:31.86,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:09:31.94,0:09:32.90,Default,,0,0,0,,Ах
Dialogue: 0,0:09:32.98,0:09:35.74,Default,,0,0,0,,Ой, қар жауды, қар жауды
Dialogue: 0,0:09:35.82,0:09:37.61,Default,,0,0,0,,Суық болады деп ойладым.
Dialogue: 0,0:09:37.70,0:09:40.24,Default,,0,0,0,,Ия, қар, қар!
Dialogue: 0,0:09:43.74,0:09:44.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:44.95,0:09:47.08,Default,,0,0,0,,Әпке! Ах
Dialogue: 0,0:09:48.71,0:09:50.59,Default,,0,0,0,,Ах, Туя-чан
Dialogue: 0,0:09:51.71,0:09:54.59,Default,,0,0,0,,Не болды? Осындай уақытта
Dialogue: 0,0:09:55.09,0:09:56.97,Default,,0,0,0,,Әй, Дежико ғимараты!
Dialogue: 0,0:09:57.59,0:09:59.30,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:09:59.39,0:10:00.51,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:00.60,0:10:02.01,Default,,0,0,0,,Әпке
Dialogue: 0,0:10:02.10,0:10:04.60,Default,,0,0,0,,Сұлу қыздардың жасы келе жатыр.
Dialogue: 0,0:10:05.10,0:10:06.85,Default,,0,0,0,,Әпкем айтқандай
Dialogue: 0,0:10:06.93,0:10:09.60,Default,,0,0,0,,Иә, мен міндетті түрде келемін!
Dialogue: 0,0:10:10.44,0:10:11.98,Default,,0,0,0,,Айтпақшы, апа
Dialogue: 0,0:10:12.86,0:10:16.36,Default,,0,0,0,,Сіздің әпкеңіз де бишоджо ойынын жасап жүр еді, солай ма?
Dialogue: 0,0:10:16.44,0:10:18.03,Default,,0,0,0,,Сол адамдармен
Dialogue: 0,0:10:19.24,0:10:22.45,Default,,0,0,0,,Мұның бәрі алкогольсіз сусындар туралы, солай ма?
Dialogue: 0,0:10:22.53,0:10:24.58,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:10:24.66,0:10:28.00,Default,,0,0,0,,Осы уақытқа дейін жарты күндік жұмысым бар еді, бірақ хехе
Dialogue: 0,0:10:31.83,0:10:36.01,Default,,0,0,0,,Құрметті әпке, мен жаңа компания ашуды жоспарлап отырмын.
Dialogue: 0,0:10:36.09,0:10:37.17,Default,,0,0,0,,Эх!
Dialogue: 0,0:10:37.76,0:10:41.18,Default,,0,0,0,,Осы дәуірге сәйкес ойындар жасай алатын компания
Dialogue: 0,0:10:41.26,0:10:43.64,Default,,0,0,0,,Мен оны нөлден бастап өзім жасауды ойладым.
Dialogue: 0,0:10:43.72,0:10:46.97,Default,,0,0,0,,Иә? Шынымен бе? Керемет!
Dialogue: 0,0:10:47.06,0:10:47.77,Default,,0,0,0,,Иә
Dialogue: 0,0:10:49.35,0:10:51.48,Default,,0,0,0,,Сонымен, э-э…
Dialogue: 0,0:10:52.06,0:10:52.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:53.65,0:10:56.36,Default,,0,0,0,,Әпке, менімен бірге жүріңіз...
Dialogue: 0,0:10:57.82,0:11:00.95,Default,,0,0,0,,Менімен ойын ойнағың келе ме?
Dialogue: 0,0:11:01.03,0:11:02.53,Default,,0,0,0,,Эх!
Dialogue: 0,0:11:02.62,0:11:05.70,Default,,0,0,0,,Біз Акихабарада алғаш кездескеннен бастап, И
Dialogue: 0,0:11:05.79,0:11:08.54,Default,,0,0,0,,Мен сені көптен бері қудым!
Dialogue: 0,0:11:08.62,0:11:11.00,Default,,0,0,0,,Егер мен сенімен ойын құра алсам
Dialogue: 0,0:11:11.58,0:11:14.09,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,0:11:14.17,0:11:18.09,Default,,0,0,0,,Уау... жарайды... маған осылай қарасаң...
Dialogue: 0,0:11:18.17,0:11:21.43,Default,,0,0,0,,Ко... Бұл Коноха үшін ысырап.
Dialogue: 0,0:11:21.51,0:11:23.76,Default,,0,0,0,,Әпке, өтінемін!
Dialogue: 0,0:11:24.35,0:11:25.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:27.77,0:11:29.56,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:11:30.60,0:11:32.94,Default,,0,0,0,,Бірақ бұл қазір мүмкін емес.
Dialogue: 0,0:11:33.44,0:11:33.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:34.52,0:11:36.82,Default,,0,0,0,,Коноха, мен мұнда қанша уақыт тұра аламын?
Dialogue: 0,0:11:36.90,0:11:38.28,Default,,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 0,0:11:39.69,0:11:43.20,Default,,0,0,0,,Сіз саяхаттауды немесе көшуді айтасыз ба?
Dialogue: 0,0:11:43.28,0:11:46.66,Default,,0,0,0,,Хмм, мен не айтарымды білмеймін...
Dialogue: 0,0:11:47.16,0:11:48.95,Default,,0,0,0,,Бірақ... бірақ...
Dialogue: 0,0:11:49.04,0:11:51.87,Default,,0,0,0,,Келесі кездескенімізде, бірге ойындар туралы сөйлесейік!
Dialogue: 0,0:11:51.96,0:11:53.83,Default,,0,0,0,,Сіз ойын жасай аласыз
Dialogue: 0,0:11:53.92,0:11:56.71,Default,,0,0,0,,Джангара Рамен Оны жай ғана жеуге болады!
Dialogue: 0,0:11:57.29,0:12:01.72,Default,,0,0,0,,Өйткені Коноха мен басқалардың арасында әдемі қыз ойыны бар.
Dialogue: 0,0:12:04.76,0:12:06.47,Default,,0,0,0,,Иә, әпке!
Dialogue: 0,0:12:06.97,0:12:08.47,Default,,0,0,0,,Коно-чан
Dialogue: 0,0:12:08.56,0:12:12.02,Default,,0,0,0,,Біз қазір екінші үйге барамыз, бірақ бізбен бірге барғың келе ме?
Dialogue: 0,0:12:12.10,0:12:13.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:13.52,0:12:16.15,Default,,0,0,0,,Коноха Мен жұмысқа қайта барамын.
Dialogue: 0,0:12:16.94,0:12:18.15,Default,,0,0,0,,Олай болса, Туя-чан.
Dialogue: 0,0:12:18.73,0:12:19.73,Default,,0,0,0,,Сен өте тәртіпсізсің.
Dialogue: 0,0:12:27.49,0:12:29.95,Default,,0,0,0,,Иә, әпке.
Dialogue: 0,0:12:38.29,0:12:41.76,Default,,0,0,0,,Ах... Echosoft болды
Dialogue: 0,0:12:43.01,0:12:46.01,Default,,0,0,0,,Сіз байқадыңыз ба? Бұл таңқаларлық емес пе?
Dialogue: 0,0:12:46.59,0:12:48.80,Default,,0,0,0,,Культтық бағдарламалық қамтамасыз ету
Dialogue: 0,0:12:48.89,0:12:52.14,Default,,0,0,0,,Echosoft компаниясының "Ойын үйіне қош келдіңіз!"
Dialogue: 0,0:12:52.22,0:12:54.64,Default,,0,0,0,,Бір ғана кітаппен жоғалып кеткен жұмбақ компания
Dialogue: 0,0:12:55.14,0:12:58.06,Default,,0,0,0,,Мазмұны үйлесімді емес, бірақ бірегей
Dialogue: 0,0:12:58.15,0:13:00.57,Default,,0,0,0,,Атын білесіз бе?
Dialogue: 0,0:13:00.65,0:13:05.28,Default,,0,0,0,,Ол қандай да бір күдікті әрекетке қатысты және оны полиция қамауға алды.
Dialogue: 0,0:13:05.36,0:13:07.11,Default,,0,0,0,,Иә? полиция?
Dialogue: 0,0:13:07.20,0:13:08.70,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:13:08.78,0:13:10.62,Default,,0,0,0,,Бұл қауесет
Dialogue: 0,0:13:10.70,0:13:13.58,Default,,0,0,0,,Саори оқиғасы сияқты емес пе?
Dialogue: 0,0:13:13.66,0:13:17.46,Default,,0,0,0,,Немесе бас компания солай шығар...хехехе
Dialogue: 0,0:13:17.54,0:13:19.96,Default,,0,0,0,,Қарастырылып отырған адамдар болғанымен
Dialogue: 0,0:13:20.04,0:13:20.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:21.55,0:13:23.38,Default,,0,0,0,,Эй, не болды, Армин? Өзіңді қолыңнан ал, иә? Эй!
Dialogue: 0,0:13:27.26,0:13:28.59,Default,,0,0,0,,Echosoft
Dialogue: 0,0:13:29.09,0:13:31.43,Default,,0,0,0,,Өйткені, мен өткенге саяхат жасадым.
Dialogue: 0,0:13:32.06,0:13:34.68,Default,,0,0,0,,Мен түс көрген емеспін және аян көрген жоқпын.
Dialogue: 0,0:13:35.27,0:13:37.98,Default,,0,0,0,,Коноха пайдаланылған бағдарламалық құрал дүкенінен алған бағдарламалық құрал.
Dialogue: 0,0:13:38.52,0:13:42.36,Default,,0,0,0,,Осыны пайдаланып, Коноха екеуміз де өткенге саяхат жасадық.
Dialogue: 0,0:13:43.90,0:13:45.44,Default,,0,0,0,,Бұл болуы мүмкін бе?
Dialogue: 0,0:13:45.53,0:13:48.32,Default,,0,0,0,,Бұл Echo арқылы қандай да бір түрде өзгертілген бағдарламалық құрал ма?
Dialogue: 0,0:13:49.45,0:13:51.37,Default,,0,0,0,,Ойын өртеніп кетті ме?
Dialogue: 0,0:13:51.45,0:13:52.95,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:53.04,0:13:54.41,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:13:55.08,0:13:57.58,Default,,0,0,0,,Осы ғана қалды
Dialogue: 0,0:13:59.46,0:14:02.46,Default,,0,0,0,,Конохаға тиесілі барлық ойындар өртеніп кетті.
Dialogue: 0,0:14:03.09,0:14:05.92,Default,,0,0,0,,Себебі мен «Түс періштелерін» аштым
Dialogue: 0,0:14:06.01,0:14:08.09,Default,,0,0,0,,Тек «Күлкілі кеш» қалады
Dialogue: 0,0:14:09.93,0:14:12.14,Default,,0,0,0,,Тақырып есімде жақсы емес, бірақ
Dialogue: 0,0:14:12.22,0:14:15.93,Default,,0,0,0,,Болашақта қолжетімді болуы керек ойындардың барлығы жоғалып кетті.
Dialogue: 0,0:14:17.85,0:14:20.60,Default,,0,0,0,,Мен үшін уақытты жоғалту дұрыс болды ма?
Dialogue: 0,0:14:21.40,0:14:24.78,Default,,0,0,0,,Бұл Коноханың ойыны емес пе еді?
Dialogue: 0,0:14:26.49,0:14:28.24,Default,,0,0,0,,Олармен кездесу...
Dialogue: 0,0:14:29.07,0:14:31.49,Default,,0,0,0,,Қорғаңыз!
Dialogue: 0,0:14:31.99,0:14:34.12,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:14:36.41,0:14:37.20,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:37.29,0:14:39.79,Default,,0,0,0,,Мен... бұл компания деп ойладым.
Dialogue: 0,0:14:39.87,0:14:41.42,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:14:42.54,0:14:43.67,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:14:44.17,0:14:46.71,Default,,0,0,0,,Ішуге арналған тағам Мен оны түскі ас қорабына жасадым.
Dialogue: 0,0:14:46.80,0:14:48.38,Default,,0,0,0,,Маморудың үлесі
Dialogue: 0,0:14:50.68,0:14:51.43,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:14:51.97,0:14:54.47,Default,,0,0,0,,Мен аш емеспін.
Dialogue: 0,0:14:54.56,0:14:56.31,Default,,0,0,0,,Эх!
Dialogue: 0,0:14:57.98,0:15:00.77,Default,,0,0,0,,Сіз бәрібір жоғалып кеткен жоқсыз.
Dialogue: 0,0:15:00.85,0:15:02.61,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:15:02.69,0:15:05.65,Default,,0,0,0,,Ойын жасаудың ортасында жай ғана жоғалып кетуі мүмкін емес.
Dialogue: 0,0:15:06.23,0:15:09.28,Default,,0,0,0,,Бірақ мен қайтып оралудың қажеті жоқ екеніне өте қуаныштымын~
Dialogue: 0,0:15:12.49,0:15:15.08,Default,,0,0,0,,Мүмкін сіз ойын ойнағыңыз келетін шығар.
Dialogue: 0,0:15:15.58,0:15:18.79,Default,,0,0,0,,Мүмкін сізді осы дәуірде ұстап тұрған да осы шығар.
Dialogue: 0,0:15:19.33,0:15:22.67,Default,,0,0,0,,Иә? Бұл қалай жұмыс істейді?
Dialogue: 0,0:15:22.75,0:15:24.25,Default,,0,0,0,,Мен оның қалай жұмыс істейтінін түсінбеймін
Dialogue: 0,0:15:24.75,0:15:27.13,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:15:27.21,0:15:28.26,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:28.76,0:15:30.05,Default,,0,0,0,,Олай болса, Коноха
Dialogue: 0,0:15:30.13,0:15:32.38,Default,,0,0,0,,Бұл кез келген уақытта жоғалып кетсе, бұл таңқаларлық емес дегенді білдіре ме?
Dialogue: 0,0:15:33.55,0:15:34.93,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:15:35.47,0:15:37.47,Default,,0,0,0,,Мүмкін келесі жылы да шығар.
Dialogue: 0,0:15:38.06,0:15:41.60,Default,,0,0,0,,Жарайды, мен оның қашан жоғалатынын білмеймін, сондықтан айтайын.
Dialogue: 0,0:15:42.35,0:15:43.27,Default,,0,0,0,,Мамору-кун!
Dialogue: 0,0:15:43.77,0:15:44.65,Default,,0,0,0,,Не?
Dialogue: 0,0:15:44.73,0:15:48.03,Default,,0,0,0,,Бірге ойын жасау керемет болды!
Dialogue: 0,0:15:48.11,0:15:51.03,Default,,0,0,0,,Шынында да ең жақсы!
Dialogue: 0,0:15:51.61,0:15:53.95,Default,,0,0,0,,Әркім алкогольді алкогольсіз сусындарды жақсы көреді!
Dialogue: 0,0:15:54.53,0:15:58.45,Default,,0,0,0,,Коноха Мен осындай сезімді сезінгім келеді деп ойладым!
Dialogue: 0,0:15:58.95,0:16:01.16,Default,,0,0,0,,Сонымен қатар, егер қамқоршы болмаса
Dialogue: 0,0:16:01.25,0:16:04.83,Default,,0,0,0,,Коноха Мен мұндай керемет ойын жасай алмадым
Dialogue: 0,0:16:04.92,0:16:05.71,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:16:05.79,0:16:07.71,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:16:08.30,0:16:09.80,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:16:09.88,0:16:11.97,Default,,0,0,0,,Сіз... ауырып жатырсыз ба?
Dialogue: 0,0:16:12.05,0:16:13.47,Default,,0,0,0,,Му!
Dialogue: 0,0:16:13.55,0:16:16.72,Default,,0,0,0,,Коноха Мен шынымен ризамын!
Dialogue: 0,0:16:17.81,0:16:20.14,Default,,0,0,0,,Мен мұны сен үшін жасаған жоқпын.
Dialogue: 0,0:16:20.77,0:16:22.43,Default,,0,0,0,,Бұл мүдделер сәйкестігінің нәтижесі, солай ма?
Dialogue: 0,0:16:22.98,0:16:25.15,Default,,0,0,0,,Осындай кезде...
Dialogue: 0,0:16:25.23,0:16:28.40,Default,,0,0,0,,Менің ойымша, бұл «Әй, балалар» дегеннен жақсы.
Dialogue: 0,0:16:28.48,0:16:30.61,Default,,0,0,0,,Ал, мен әлі білмеймін.
Dialogue: 0,0:16:31.11,0:16:34.78,Default,,0,0,0,,Коноханы қанағаттандырса да, ол 1 миллиард сатпайынша жұмыс істемейді.
Dialogue: 0,0:16:34.86,0:16:37.74,Default,,0,0,0,,Уайымдамаңыз, ол ойын сатылады.
Dialogue: 0,0:16:37.83,0:16:38.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:40.20,0:16:42.25,Default,,0,0,0,,Ол міндетті түрде сатылады.
Dialogue: 0,0:16:42.33,0:16:45.46,Default,,0,0,0,,Бұл ойында сонша энергия бар.
Dialogue: 0,0:16:47.17,0:16:49.17,Default,,0,0,0,,Эротикалық ойындарда әлі де көп нәрсе жасауға болады.
Dialogue: 0,0:16:49.25,0:16:50.59,Default,,0,0,0,,Бұл сирек дүние
Dialogue: 0,0:16:51.51,0:16:54.38,Default,,0,0,0,,Онда сонша қызуы бар нәрсе пайда болады.
Dialogue: 0,0:16:54.47,0:16:56.34,Default,,0,0,0,,Оның сатылмауы мүмкін емес
Dialogue: 0,0:16:57.01,0:16:59.26,Default,,0,0,0,,үшінның көргісі келетіні.
Dialogue: 0,0:17:00.85,0:17:01.77,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:17:01.85,0:17:04.23,Default,,0,0,0,,1 миллиард, оны қайтару былай тұрсын
Dialogue: 0,0:17:04.31,0:17:06.77,Default,,0,0,0,,Әкең тағы да ақшаға жынды ма?
Dialogue: 0,0:17:06.85,0:17:08.15,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,0:17:08.77,0:17:10.52,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:17:13.53,0:17:15.03,Default,,0,0,0,,Сенде бәрі жақсы.
Dialogue: 0,0:17:15.11,0:17:15.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:16.16,0:17:16.99,Default,,0,0,0,,Сіз сияқты біреу
Dialogue: 0,0:17:17.07,0:17:19.49,Default,,0,0,0,,Мен армандарымды орындаймын деп ойлаймын
Dialogue: 0,0:17:20.33,0:17:22.79,Default,,0,0,0,,Менде сендей күш жоқ.
Dialogue: 0,0:17:22.87,0:17:24.50,Default,,0,0,0,,Б-Бұл не болып жатыр өзі? Не болып жатыр…
Dialogue: 0,0:17:24.58,0:17:26.42,Default,,0,0,0,,Тіпті осы жолы, тіпті бұрын
Dialogue: 0,0:17:26.50,0:17:29.67,Default,,0,0,0,,Сізге рахмет, ойын аяқталды.
Dialogue: 0,0:17:29.75,0:17:33.21,Default,,0,0,0,,Егер сіз Мори-кун болсаңыз, сіз Конохадан да таңғажайып нәрселер жасай аласыз!
Dialogue: 0,0:17:33.71,0:17:34.76,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:17:35.26,0:17:37.51,Default,,0,0,0,,Мамору-кун, сенің арманың жоқ па?
Dialogue: 0,0:17:38.09,0:17:39.18,Default,,0,0,0,,Атап айтқанда, ештеңе жоқ
Dialogue: 0,0:17:39.72,0:17:43.31,Default,,0,0,0,,98 (Кюухачи) әлемді жаулап алса, маған басқа ештеңе керек емес.
Dialogue: 0,0:17:43.39,0:17:46.19,Default,,0,0,0,,Джу... Бұл өте қауіпті түс.
Dialogue: 0,0:17:46.27,0:17:50.11,Default,,0,0,0,,Мен ештеңенің өзгергенін қаламаймын.
Dialogue: 0,0:17:51.19,0:17:55.19,Default,,0,0,0,,Мен бұл қала мен 98 сол қалпында қалғанын қалаймын.
Dialogue: 0,0:17:56.20,0:17:59.32,Default,,0,0,0,,Бірақ қала мен оның тұрғындары таңғажайып жылдамдықпен өзгеруде.
Dialogue: 0,0:18:00.28,0:18:01.87,Default,,0,0,0,,Оны тоқтату мүмкін емес
Dialogue: 0,0:18:03.12,0:18:07.33,Default,,0,0,0,,Алайда, бұл жолы алкогольсіз сусындар қалған шығар.
Dialogue: 0,0:18:09.67,0:18:11.38,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:18:12.09,0:18:13.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:14.92,0:18:17.67,Default,,0,0,0,,Мамору-кун, қар жауды, қар жауды!
Dialogue: 0,0:18:17.76,0:18:19.26,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:19.34,0:18:21.64,Default,,0,0,0,,Суық тиіп қалмас үшін тез үйге қайтайық.
Dialogue: 0,0:18:21.72,0:18:22.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:24.85,0:18:26.85,Default,,0,0,0,,Ах! Мори-кун, қара!
Dialogue: 0,0:18:26.93,0:18:28.48,Default,,0,0,0,,Аспанға қара!
Dialogue: 0,0:18:28.98,0:18:29.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:29.81,0:18:30.98,Default,,0,0,0,,(қағаз қаптың құлаған дыбысы)
Dialogue: 0,0:18:32.23,0:18:33.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:41.78,0:18:42.70,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:05.93,0:19:06.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:07.02,0:19:07.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:11.60,0:19:13.40,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:19:13.90,0:19:14.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:16.07,0:19:19.44,Default,,0,0,0,,Мен саған түскі ас қорабын беруді ұмытып кетіппін.
Dialogue: 0,0:19:19.99,0:19:21.49,Default,,0,0,0,,Бірақ оған көмектесу мүмкін емес.
Dialogue: 0,0:19:23.91,0:19:24.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:24.99,0:19:27.12,Default,,0,0,0,,Уақыт секірулері жоқ.
Dialogue: 0,0:19:27.62,0:19:30.25,Default,,0,0,0,,Сондықтан мен бұл дүниеде бар күшімді салуым керек.
Dialogue: 0,0:19:30.33,0:19:31.79,Default,,0,0,0,,Хаа~
Dialogue: 0,0:19:31.87,0:19:35.29,Default,,0,0,0,,Сіз қайтадан Bluebell қызметкері боласыз ба?
Dialogue: 0,0:19:35.84,0:19:40.30,Default,,0,0,0,,Бірақ шытырман оқиғаның арқасында өскен Коноха сәл басқаша!
Dialogue: 0,0:19:42.22,0:19:43.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:44.47,0:19:45.22,Default,,0,0,0,,А...
Dialogue: 0,0:19:45.30,0:19:47.64,Default,,0,0,0,,Маған айта аласыз ба?
Dialogue: 0,0:19:49.22,0:19:52.10,Default,,0,0,0,,Бұл Акихабара, солай ма?
Dialogue: 0,0:19:52.60,0:19:55.02,Default,,0,0,0,,Анимация туралы не деуге болады? Донки ше?
Dialogue: 0,0:19:55.81,0:19:56.40,Default,,0,0,0,,Ах
Dialogue: 0,0:19:57.69,0:20:02.40,Default,,0,0,0,,Е-е... ее...
Dialogue: 0,0:20:02.95,0:20:06.53,Default,,0,0,0,,Бұл... Бұл... Бұл Аспан ағашы ма?
Dialogue: 0,0:20:07.37,0:20:09.33,Default,,0,0,0,,...Бұл жерде басқа нәрсе бар!
Dialogue: 0,0:20:10.79,0:20:13.58,Default,,0,0,0,,Сонымен...бірақ жер бедері Акихабараға ұқсайды.
Dialogue: 0,0:20:14.08,0:20:15.08,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:20:15.88,0:20:17.92,Default,,0,0,0,,Мұнда... қайда?
Dialogue: 0,0:20:26.93,0:20:28.10,Default,,0,0,0,,Акихабара…
Dialogue: 0,0:20:28.60,0:20:31.18,Default,,0,0,0,,Акихабара? Мұнда?
Dialogue: 0,0:20:32.94,0:20:34.77,Default,,0,0,0,,Не?Бұл
Dialogue: 0,0:20:36.86,0:20:38.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:39.73,0:20:41.49,Default,,0,0,0,,Жоқ... не? ток
Dialogue: 0,0:20:47.16,0:20:48.95,Default,,0,0,0,,Бұл ғимарат...
Dialogue: 0,0:20:50.41,0:20:54.21,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:54.29,0:20:57.88,Default,,0,0,0,,Ваа
Dialogue: 0,0:20:57.96,0:20:59.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:59.13,0:21:01.76,Default,,0,0,0,,Әй, анау ана жақтағы әйел!
Dialogue: 0,0:21:01.84,0:21:05.18,Default,,0,0,0,,Бұл қауіпті, жақындамаңыз!
Dialogue: 0,0:21:05.26,0:21:07.72,Default,,0,0,0,,Кешіріңіз кешіріңіз Кешіріңіз мені кешіріңіз
Dialogue: 0,0:21:08.30,0:21:11.10,Default,,0,0,0,,Сонымен... Бірақ Коноха білетін Акиба...
Dialogue: 0,0:21:11.18,0:21:12.77,Default,,0,0,0,,Бұл жалғыз орын!
Dialogue: 0,0:21:12.85,0:21:15.31,Default,,0,0,0,,Коноханың Акибасы ~!
Dialogue: 0,0:21:15.39,0:21:17.23,Default,,0,0,0,,Мен полиция шақырамын!
Dialogue: 0,0:21:17.31,0:21:18.19,Default,,0,0,0,,Не?
Dialogue: 0,0:21:18.27,0:21:22.28,Default,,0,0,0,,А... жоқ, мен адасып кеткен сияқтымын.
Dialogue: 0,0:21:22.36,0:21:25.45,Default,,0,0,0,,Алып алу Жұмысқа оралыңыз
Dialogue: 0,0:21:25.53,0:21:26.57,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:21:26.66,0:21:29.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:30.08,0:21:31.66,Default,,0,0,0,,Ух... уф
Dialogue: 0,0:21:32.45,0:21:33.00,Default,,0,0,0,,(Мысықтың ырылы)
Dialogue: 0,0:21:33.08,0:21:34.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:37.58,0:21:39.00,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:21:40.13,0:21:41.63,Default,,0,0,0,,Көптен бері көрмей жүрсіз бе?
Dialogue: 0,0:21:42.13,0:21:42.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:42.84,0:21:46.43,Default,,0,0,0,,Иә! Мо... Момо... Мүмкін
Dialogue: 0,0:21:47.30,0:21:49.30,Default,,0,0,0,,Мүмкін Мамору-кун шығар?
Dialogue: 0,0:21:51.60,0:21:53.10,Default,,0,0,0,,Мамору…
Dialogue: 0,0:21:55.56,0:21:57.06,Default,,0,0,0,,Мамору-кун...
Dialogue: 0,0:21:57.98,0:21:59.81,Default,,0,0,0,,Мамору-кун...
Dialogue: 0,0:22:00.73,0:22:05.94,Default,,0,0,0,,Мори-кун ағай!
Dialogue: 0,0:22:06.03,0:22:08.03,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.95,0:23:35.95,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.70,0:23:41.00,Default,,0,0,0,,(Пернетақта пернесінің дыбысы)
Dialogue: 0,0:23:42.50,0:23:48.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
