Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.35,0:01:00.37,Default,,0,0,0,,♬～
Dialogue: 0,0:01:00.37,0:01:20.33,Default,,0,0,0,,♬～
Dialogue: 0,0:01:20.33,0:01:30.34,Default,,0,0,0,,♬～
Dialogue: 0,0:01:30.34,0:01:41.35,Default,,0,0,0,,♬～
Dialogue: 0,0:01:41.35,0:01:43.35,Default,,0,0,0,,(жүгіру дыбысы)
Dialogue: 0,0:01:43.35,0:01:48.35,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:01:50.36,0:01:53.36,Default,,0,0,0,,Хмм... Ах!
Dialogue: 0,0:01:57.36,0:02:00.37,Default,,0,0,0,,Ой
Dialogue: 0,0:02:00.37,0:02:02.37,Default,,0,0,0,,≪(нәрестенің жылауы)
Dialogue: 0,0:02:02.37,0:02:05.37,Default,,0,0,0,,Ха... Мисае...
Dialogue: 0,0:02:05.37,0:02:08.38,Default,,0,0,0,,Жарайсың! Мисае!
Dialogue: 0,0:02:08.38,0:02:12.38,Default,,0,0,0,,Ах (медбике) Нохара мырза көрші. Келесі есік.
Dialogue: 0,0:02:12.38,0:02:15.38,Default,,0,0,0,,Ааааааа…
Dialogue: 0,0:02:15.38,0:02:18.39,Default,,0,0,0,,Ой, кішкентай...
Dialogue: 0,0:02:18.39,0:02:21.32,Default,,0,0,0,,Аа
Dialogue: 0,0:02:21.32,0:02:23.32,Default,,0,0,0,,Ақыры сені кездестірдім.
Dialogue: 0,0:02:23.32,0:02:25.33,Default,,0,0,0,,Эй, көре аласың ба?
Dialogue: 0,0:02:25.33,0:02:28.33,Default,,0,0,0,,Мен сенің әкеңмін.
Dialogue: 0,0:02:28.33,0:02:34.33,Default,,0,0,0,,Миса, сен керемет жұмыс жасадың. Рақмет сізге.
Dialogue: 0,0:02:34.33,0:02:37.34,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:37.34,0:02:40.34,Default,,0,0,0,,Сіз есімді ойладыңыз ба?
Dialogue: 0,0:02:40.34,0:02:44.34,Default,,0,0,0,,О, керемет, Шиничи, Томонори...
Dialogue: 0,0:02:44.34,0:02:48.35,Default,,0,0,0,,Ым... А, әріптер жаңбырда жазылған.
Dialogue: 0,0:02:48.35,0:02:52.35,Default,,0,0,0,,Шинносуке?
Dialogue: 0,0:02:52.35,0:02:55.36,Default,,0,0,0,,Ууууууу, күлдің бе?
Dialogue: 0,0:02:55.36,0:02:57.36,Default,,0,0,0,,Жоқ, Шинносуке
Dialogue: 0,0:02:57.36,0:03:00.36,Default,,0,0,0,,Аха Шинносуке~
Dialogue: 0,0:03:00.36,0:03:03.36,Default,,0,0,0,,Уу (Мисаэ/Хироши) Шинносуке~
Dialogue: 0,0:03:03.36,0:03:07.37,Default,,0,0,0,,Уау, Шинносуке
Dialogue: 0,0:03:07.37,0:03:09.37,Default,,0,0,0,,Шин-чан
Dialogue: 0,0:03:09.37,0:03:15.38,Default,,0,0,0,,Фуфу Шинносуке Фуфуфу Шин-чан
Dialogue: 0,0:03:15.38,0:03:17.38,Default,,0,0,0,,(жартылай қоңырау дыбысы)
Dialogue: 0,0:03:17.38,0:03:19.38,Default,,0,0,0,,Қауіпсіздік клапаны ашық! (Ниндзя) Асығыңыз!
Dialogue: 0,0:03:19.38,0:03:21.31,Default,,0,0,0,,Адамдарды жинаңыз!
Dialogue: 0,0:03:21.31,0:03:25.32,Default,,0,0,0,,(Ниндзялар сөйлейді)
Dialogue: 0,0:03:25.32,0:03:27.32,Default,,0,0,0,,Ммм!
Dialogue: 0,0:03:27.32,0:03:30.32,Default,,0,0,0,,Менің рухым жетпейді! Сақ болыңыз!
Dialogue: 0,0:03:30.32,0:03:32.33,Default,,0,0,0,,Ақсақал, осылай жалғаса берсе...
Dialogue: 0,0:03:32.33,0:03:36.33,Default,,0,0,0,,Маған мына жігіттің ұлын (Гомаэмон) әкелші...
Dialogue: 0,0:03:36.33,0:03:41.33,Default,,0,0,0,,Егер сіз гермиттің ұлы болсаңыз, Mononoke no Jutsu пайдалана білуіңіз керек.
Dialogue: 0,0:03:41.33,0:03:43.34,Default,,0,0,0,,(Алып горилланың айқайы)
Dialogue: 0,0:03:43.34,0:03:46.34,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:03:46.34,0:03:49.34,Default,,0,0,0,,Әлі де жақын! (Ниндзя) Қылмыскер ниндзяның қашып кетуіне жол бермеңіз!
Dialogue: 0,0:03:49.34,0:03:51.34,Default,,0,0,0,,Айнал!
Dialogue: 0,0:03:51.34,0:03:53.35,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:53.35,0:03:55.35,Default,,0,0,0,,Анашым, қайда барасыз!?
Dialogue: 0,0:03:55.35,0:03:57.35,Default,,0,0,0,,Бұл қауіпсіз жер!
Dialogue: 0,0:03:57.35,0:04:01.35,Default,,0,0,0,,Мен бұл адамдар екеніне сенімдімін ...
Dialogue: 0,0:04:08.36,0:04:13.37,Default,,0,0,0,,♪(Камен Ондо әрекеті)
Dialogue: 0,0:04:13.37,0:04:17.37,Default,,0,0,0,,♪～
Dialogue: 0,0:04:17.37,0:04:19.37,Default,,0,0,0,,♪Кеттік!
Dialogue: 0,0:04:19.37,0:04:22.31,Default,,0,0,0,,Барлығы~ Мен қарбызды кесіп алдым~
Dialogue: 0,0:04:22.31,0:04:24.31,Default,,0,0,0,,Хой
Dialogue: 0,0:04:26.31,0:04:28.31,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:04:28.31,0:04:30.32,Default,,0,0,0,,Itadadakimasu Pupupupu…
Dialogue: 0,0:04:30.32,0:04:32.32,Default,,0,0,0,,Шин-чан, енді бұзық қылма.
Dialogue: 0,0:04:32.32,0:04:36.32,Default,,0,0,0,,Әй, бәріміз, біз әлі жаттығып жатырмыз~
Dialogue: 0,0:04:36.32,0:04:40.33,Default,,0,0,0,,Кішкене үзіліс жасайық (нене) Масао-кун тым ынталы.
Dialogue: 0,0:04:40.33,0:04:43.33,Default,,0,0,0,,Әрине Вахахахаха!
Dialogue: 0,0:04:43.33,0:04:49.34,Default,,0,0,0,,Әрекет Камен костюмі Жазғы құрғақ торлы тігінші
Dialogue: 0,0:04:49.34,0:04:52.34,Default,,0,0,0,,Олар әрқашан экшн маскаларымен жарнама жасайды.
Dialogue: 0,0:04:52.34,0:04:56.34,Default,,0,0,0,,♪Жаз ортасы да әділдікті қорғау үшін~
Dialogue: 0,0:04:56.34,0:04:59.35,Default,,0,0,0,,♪Мен құрғақ тормен келдім~
Dialogue: 0,0:04:59.35,0:05:03.35,Default,,0,0,0,,Әрекет сәулесі! (Кадзама) Action Chop!
Dialogue: 0,0:05:03.35,0:05:06.35,Default,,0,0,0,,Казама-кун, сен балаларға арналған бағдарламаларды көрмейсің ғой?
Dialogue: 0,0:05:06.35,0:05:10.36,Default,,0,0,0,,Ах!? Мен... сенің осылай істеп жатқаныңды жаңа ғана көрдім.
Dialogue: 0,0:05:10.36,0:05:13.36,Default,,0,0,0,,Әрқашан деп айтпадың ба? (Қазама) Мен бұлай айтқан жоқпын!
Dialogue: 0,0:05:13.36,0:05:16.36,Default,,0,0,0,,Отшашу үшін биге жаттығады ма?
Dialogue: 0,0:05:16.36,0:05:18.36,Default,,0,0,0,,Бәріміз бірге барайық
Dialogue: 0,0:05:18.36,0:05:20.30,Default,,0,0,0,,Таңдалған бала сахнаға шығады⇒
Dialogue: 0,0:05:20.30,0:05:22.30,Default,,0,0,0,,Сіз әрекетті маскамен билей аласыз.
Dialogue: 0,0:05:22.30,0:05:25.31,Default,,0,0,0,,Эй, әрине, менмін!
Dialogue: 0,0:05:25.31,0:05:28.31,Default,,0,0,0,,Мен Касукабенің тыныштығын қорғаймын!
Dialogue: 0,0:05:28.31,0:05:30.31,Default,,0,0,0,,Му! Масао-кун өте қу!
Dialogue: 0,0:05:30.31,0:05:33.31,Default,,0,0,0,,Мен де Ораны қалаймын! Әрекет маскасы костюмі!
Dialogue: 0,0:05:33.31,0:05:35.32,Default,,0,0,0,,Мен мұны қалаймын! Мен оны қалаймын, мен оны қалаймын!
Dialogue: 0,0:05:35.32,0:05:37.32,Default,,0,0,0,,Мен қалаймын Мен қалаймын ...
Dialogue: 0,0:05:37.32,0:05:40.32,Default,,0,0,0,,Барлығы қарап тұрса да, ұялмаңыз.
Dialogue: 0,0:05:40.32,0:05:44.32,Default,,0,0,0,,Өтінемін, уайымдама (бу) Мен өз қалауымды тоқтата алмаймын
Dialogue: 0,0:05:44.32,0:05:49.33,Default,,0,0,0,,Мен оны қалаймын, мен оны қалаймын, мен оны қалаймын ... (Кіру қоңырауы)
Dialogue: 0,0:05:49.33,0:05:51.33,Default,,0,0,0,,Иә, иә~ (кіреберіс қоңырауы)
Dialogue: 0,0:05:51.33,0:05:54.33,Default,,0,0,0,,Иә, иә (кіреберіс қоңырауы)
Dialogue: 0,0:05:54.33,0:05:56.34,Default,,0,0,0,,Біз өте өкінеміз!
Dialogue: 0,0:05:56.34,0:05:58.34,Default,,0,0,0,,Ә!? (Клиника директоры) Бұл шынымен де солай!
Dialogue: 0,0:05:58.34,0:06:03.34,Default,,0,0,0,,Тоқта... күте тұр, бұл не? (Клиника директоры) Кешіріңіз.
Dialogue: 0,0:06:03.34,0:06:06.35,Default,,0,0,0,,Не болды? Жоқ, менің ойымша...
Dialogue: 0,0:06:06.35,0:06:09.35,Default,,0,0,0,,Бұл адам Шибата акушерлік және гинекология бөлімінің директоры.
Dialogue: 0,0:06:09.35,0:06:12.35,Default,,0,0,0,,Шибата акушерлік және гинекология дегеніміз не?
Dialogue: 0,0:06:12.35,0:06:15.35,Default,,0,0,0,,Шинносуке туған аурухана?
Dialogue: 0,0:06:17.36,0:06:19.36,Default,,0,0,0,,Сіз оны көре аласыз ба? бұл бала
Dialogue: 0,0:06:19.36,0:06:22.30,Default,,0,0,0,,Не? Иә... сіздің балаңыз.
Dialogue: 0,0:06:22.30,0:06:24.30,Default,,0,0,0,,Ха!? Иә?
Dialogue: 0,0:06:24.30,0:06:27.30,Default,,0,0,0,,Сәлем! Мен де сенің балаңмын
Dialogue: 0,0:06:27.30,0:06:30.30,Default,,0,0,0,,перде артындағы бөлме – священник кіретін бөлме екенін
Dialogue: 0,0:06:30.30,0:06:32.30,Default,,0,0,0,,Ішінде баяу сөйле
Dialogue: 0,0:06:35.31,0:06:40.31,Default,,0,0,0,,Менің атым Окусо Какуёме, ал бұл бала Чинзо.
Dialogue: 0,0:06:40.31,0:06:43.32,Default,,0,0,0,,Ора Шинносуке Нохара, 5 жаста, тербеледі ~
Dialogue: 0,0:06:43.32,0:06:45.32,Default,,0,0,0,,Мойын?
Dialogue: 0,0:06:45.32,0:06:47.32,Default,,0,0,0,,Енді бір жас жігіттен сәлем.
Dialogue: 0,0:06:47.32,0:06:49.32,Default,,0,0,0,,О? Қанша күннен бері іш қатып жатырсыз?
Dialogue: 0,0:06:49.32,0:06:52.33,Default,,0,0,0,,Менің ішім жеуге болатын мейрамханаға барған анамдікіндей.
Dialogue: 0,0:06:52.33,0:06:56.33,Default,,0,0,0,,Эй, Шинносуке, бақшада ойна.
Dialogue: 0,0:06:56.33,0:06:58.33,Default,,0,0,0,,Хой
Dialogue: 0,0:06:58.33,0:07:01.33,Default,,0,0,0,,Неге бізбен ойнамайсың, Чинзо-кун?
Dialogue: 0,0:07:01.33,0:07:05.33,Default,,0,0,0,,Анашым, жарай ма? иә? Әрине
Dialogue: 0,0:07:09.34,0:07:12.35,Default,,0,0,0,,Сонымен бұл нені білдіреді?
Dialogue: 0,0:07:12.35,0:07:16.35,Default,,0,0,0,,Шын мәнінде, Нохара-сама мен Онсогакуре-саманың баласы⇒
Dialogue: 0,0:07:16.35,0:07:19.35,Default,,0,0,0,,Мен оны араластырдым ...
Dialogue: 0,0:07:19.35,0:07:21.29,Default,,0,0,0,,Иә!? Қате!?
Dialogue: 0,0:07:21.29,0:07:25.29,Default,,0,0,0,,Мен де алғашында сене алмадым.
Dialogue: 0,0:07:25.29,0:07:29.30,Default,,0,0,0,,Бірақ мен бұл бағалау нәтижесін алдым.
Dialogue: 0,0:07:29.30,0:07:34.30,Default,,0,0,0,,Чинзо - сенің балаң, ал Синосуке менікі...
Dialogue: 0,0:07:34.30,0:07:37.30,Default,,0,0,0,,Менің атым Онсо Гинчинзо.
Dialogue: 0,0:07:37.30,0:07:41.31,Default,,0,0,0,,Қандай таңқаларлық! Бұл
Dialogue: 0,0:07:41.31,0:07:44.31,Default,,0,0,0,,Біртүрлі нәрселерді үйретуді доғар (Чинзо) Иә?
Dialogue: 0,0:07:44.31,0:07:47.31,Default,,0,0,0,,Чинзо-кун да кете ме?
Dialogue: 0,0:07:47.31,0:07:49.32,Default,,0,0,0,,Әрекет маскасы?
Dialogue: 0,0:07:49.32,0:07:51.32,Default,,0,0,0,,♪Жарайды! (Балалар)♪Уайымдамаңыз
Dialogue: 0,0:07:51.32,0:07:55.32,Default,,0,0,0,,♪ Бір рет демалып, екі рет ұйықтауға болады.
Dialogue: 0,0:07:55.32,0:07:57.32,Default,,0,0,0,,♪Ертең (балалар)♪ Ертең
Dialogue: 0,0:07:57.32,0:07:59.33,Default,,0,0,0,,♪Әрине (балалар)♪Әрине
Dialogue: 0,0:07:59.33,0:08:01.33,Default,,0,0,0,,♪Ертең ешқашан өлмейді!
Dialogue: 0,0:08:01.33,0:08:06.33,Default,,0,0,0,,Аа, мен үйге жақында барамын. Крам мектебінің жазғы сабағының уақыты келді.
Dialogue: 0,0:08:06.33,0:08:08.33,Default,,0,0,0,,Нене де бүгін отбасымен кешкі ас ішіп отыр⇒
Dialogue: 0,0:08:08.33,0:08:10.34,Default,,0,0,0,,Мен үйге ерте барып киінуім керек.
Dialogue: 0,0:08:10.34,0:08:12.34,Default,,0,0,0,,Мен не киюім керек?
Dialogue: 0,0:08:12.34,0:08:14.34,Default,,0,0,0,,Мен Шин Чанға телефон соққан жоқпын.
Dialogue: 0,0:08:14.34,0:08:16.34,Default,,0,0,0,,Шин Чан жақында кездескенше~
Dialogue: 0,0:08:16.34,0:08:18.34,Default,,0,0,0,,Тағы~
Dialogue: 0,0:08:18.34,0:08:21.28,Default,,0,0,0,,Иә? не болды? Нене-чан
Dialogue: 0,0:08:21.28,0:08:24.28,Default,,0,0,0,,Кез келген жерден табуға болатын өте қарапайым отбасымен⇒
Dialogue: 0,0:08:24.28,0:08:27.29,Default,,0,0,0,,Баласы бар жүкті әйелдің себебі бар сияқты...
Dialogue: 0,0:08:27.29,0:08:29.29,Default,,0,0,0,,Аудармасы бар ма?
Dialogue: 0,0:08:29.29,0:08:33.29,Default,,0,0,0,,Менің кеудемде бұл сыбдыр бірдеңе бар.
Dialogue: 0,0:08:33.29,0:08:36.30,Default,,0,0,0,,Жүрек айнуы? (Масао) Қарбызды көп жемейсің бе?
Dialogue: 0,0:08:36.30,0:08:38.30,Default,,0,0,0,,Nnu!
Dialogue: 0,0:08:38.30,0:08:41.30,Default,,0,0,0,,Қарапайым отбасына келе жатқан дауылды ескерту
Dialogue: 0,0:08:41.30,0:08:43.30,Default,,0,0,0,,Мақта кәмпит! (Широ) Энн!
Dialogue: 0,0:08:43.30,0:08:46.31,Default,,0,0,0,,Сізде сиқыр бар ма? (Сиро) Ән Ән Ән…
Dialogue: 0,0:08:46.31,0:08:48.31,Default,,0,0,0,,Эй аааааааааааа
Dialogue: 0,0:08:48.31,0:08:50.31,Default,,0,0,0,,Кун... жейсің бе?
Dialogue: 0,0:08:50.31,0:08:52.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:52.31,0:08:55.31,Default,,0,0,0,,Я...
Dialogue: 0,0:08:55.31,0:08:57.32,Default,,0,0,0,,Ойлап қарасам, мен босандым⇒
Dialogue: 0,0:08:57.32,0:09:00.32,Default,,0,0,0,,Нохара мырза, сіз аурухана бөлмесіне қателесіп кірдіңіз, солай ма?
Dialogue: 0,0:09:00.32,0:09:04.32,Default,,0,0,0,,Ах... «Мисаэ» деп айқайлап жатқанда
Dialogue: 0,0:09:04.32,0:09:07.33,Default,,0,0,0,,Солай ма? Мен қателескенім есімде
Dialogue: 0,0:09:07.33,0:09:11.33,Default,,0,0,0,,Бірақ бұл... (Клиника директоры) Барлығына біздің аурухана жауапты.
Dialogue: 0,0:09:11.33,0:09:13.33,Default,,0,0,0,,Біз өте өкінеміз!
Dialogue: 0,0:09:13.33,0:09:15.33,Default,,0,0,0,,Уф, уф… Бізді кім қуып келеді?
Dialogue: 0,0:09:15.33,0:09:18.34,Default,,0,0,0,,Бұл аурухананың шынайылығы...
Dialogue: 0,0:09:18.34,0:09:21.27,Default,,0,0,0,,Ақша алсам да, (емхана директоры) бұл өте таза алтын.
Dialogue: 0,0:09:21.27,0:09:23.28,Default,,0,0,0,,Өте таза алтын!?
Dialogue: 0,0:09:23.28,0:09:25.28,Default,,0,0,0,,Жапон иені үшін бұл шамамен ⇒
Dialogue: 0,0:09:25.28,0:09:27.28,Default,,0,0,0,,Бұл үш Токио күмбезінің өлшеміне тең.
Dialogue: 0,0:09:27.28,0:09:30.28,Default,,0,0,0,,Токио күмбезі... 3 рет?
Dialogue: 0,0:09:30.28,0:09:32.29,Default,,0,0,0,,Төлеңіз, жоқ, жоқ, жоқ.
Dialogue: 0,0:09:32.29,0:09:35.29,Default,,0,0,0,,Шинносуке біздің бала емес десе де⇒
Dialogue: 0,0:09:35.29,0:09:39.29,Default,,0,0,0,,Сене алар емеспін... Дұрыс.
Dialogue: 0,0:09:39.29,0:09:41.29,Default,,0,0,0,,Мен де солай сезінемін.
Dialogue: 0,0:09:41.29,0:09:44.30,Default,,0,0,0,,Қандай жағдай болмасын, сол қызбен бірге тұрған бес жыл⇒
Dialogue: 0,0:09:44.30,0:09:47.30,Default,,0,0,0,,Бұл өтірік емес.
Dialogue: 0,0:09:47.30,0:09:50.30,Default,,0,0,0,,Бірақ Чинзо да Нохара мырзаның ұлы.
Dialogue: 0,0:09:50.30,0:09:53.31,Default,,0,0,0,,Ахх... Сонымен⇒
Dialogue: 0,0:09:53.31,0:09:56.31,Default,,0,0,0,,Осы үйде отбасы болып бірге тұруға не жетсін⇒
Dialogue: 0,0:09:56.31,0:09:58.31,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:09:58.31,0:10:00.31,Default,,0,0,0,,Бүкіл отбасы?
Dialogue: 0,0:10:00.31,0:10:04.32,Default,,0,0,0,,Нохара отбасы, Чинзо, мен және туылмаған бала.
Dialogue: 0,0:10:04.32,0:10:06.32,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:10:06.32,0:10:09.32,Default,,0,0,0,,Маған жүз қадам беріңіз. Мен Чинзо-кунның отбасын білемін, бірақ ⇒
Dialogue: 0,0:10:09.32,0:10:12.33,Default,,0,0,0,,Неліктен сіз және сіздің туылмаған балаңыз?
Dialogue: 0,0:10:12.33,0:10:15.33,Default,,0,0,0,,Өйткені мен Шинносукенің ата-анасымын.
Dialogue: 0,0:10:15.33,0:10:18.33,Default,,0,0,0,,Мен, Шинносукенің әке-шешесі, бұл бала⇒
Dialogue: 0,0:10:18.33,0:10:20.33,Default,,0,0,0,,Шинносукенің ағасы
Dialogue: 0,0:10:20.33,0:10:22.34,Default,,0,0,0,,Шинносукенің ата-анасы Нохара мырзадан ⇒
Dialogue: 0,0:10:22.34,0:10:26.34,Default,,0,0,0,,Шинносукенің бауырлары мен ата-анасы отбасы, солай ма?
Dialogue: 0,0:10:26.34,0:10:31.34,Default,,0,0,0,,Е-е... мм... Мен түсінбей бастадым.
Dialogue: 0,0:10:31.34,0:10:35.35,Default,,0,0,0,,Бүгін үйге қайтыңыз.
Dialogue: 0,0:10:35.35,0:10:39.35,Default,,0,0,0,,Мен саған мұндай нәрсені бере алмаймын, басыңды көтер.
Dialogue: 0,0:10:39.35,0:10:41.35,Default,,0,0,0,,Хаа!
Dialogue: 0,0:10:41.35,0:10:44.35,Default,,0,0,0,,Ниндзюцу Канбини жоқ Дзюцу
Dialogue: 0,0:10:47.36,0:10:52.37,Default,,0,0,0,,(цикаданың айқайы)
Dialogue: 0,0:10:52.37,0:10:55.37,Default,,0,0,0,,N?
Dialogue: 0,0:10:57.37,0:10:59.37,Default,,0,0,0,,Хуаннн…
Dialogue: 0,0:11:01.37,0:11:03.37,Default,,0,0,0,,(есік дыбысы)
Dialogue: 0,0:11:12.39,0:11:16.39,Default,,0,0,0,,Каа! (Барлығы) иә?
Dialogue: 0,0:11:16.39,0:11:19.39,Default,,0,0,0,,Жүр, тамақ ішейік, а?
Dialogue: 0,0:11:19.39,0:11:21.33,Default,,0,0,0,,Шибата акушерлік және гинекология деген кім?
Dialogue: 0,0:11:21.33,0:11:25.33,Default,,0,0,0,,Үйге қайттың, солай ма? Өйткені қазір бар
Dialogue: 0,0:11:25.33,0:11:27.33,Default,,0,0,0,,Бұл не!?
Dialogue: 0,0:11:27.33,0:11:30.34,Default,,0,0,0,,Нохара мырза отбасы болып бірге тамақтанайық деді.
Dialogue: 0,0:11:30.34,0:11:32.34,Default,,0,0,0,,Отбасы? Бүгіннен бастап⇒
Dialogue: 0,0:11:32.34,0:11:36.34,Default,,0,0,0,,Отбасы екендеріңіз есіңізде емес пе?
Dialogue: 0,0:11:36.34,0:11:38.34,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:11:38.34,0:11:40.35,Default,,0,0,0,,Соққы сіздің жадыңызды өшірді ме?
Dialogue: 0,0:11:40.35,0:11:44.35,Default,,0,0,0,,Итадаки Маргарита! Ммм
Dialogue: 0,0:11:44.35,0:11:47.35,Default,,0,0,0,,Хмм! Бөксесі жарылып кететіндей дәмді~
Dialogue: 0,0:11:47.35,0:11:49.36,Default,,0,0,0,,Не? Бөксесі? Ммм
Dialogue: 0,0:11:49.36,0:11:52.36,Default,,0,0,0,,Бури бури~ Бури бури~
Dialogue: 0,0:11:52.36,0:11:54.36,Default,,0,0,0,,Анашым, жесем болады ма?
Dialogue: 0,0:11:54.36,0:11:56.36,Default,,0,0,0,,Иә, алайық.
Dialogue: 0,0:11:56.36,0:12:00.37,Default,,0,0,0,,Бұл... мочи ме? Бұл пицца, солай ма?
Dialogue: 0,0:12:00.37,0:12:02.37,Default,,0,0,0,,Пицца гарнирге ұқсайды
Dialogue: 0,0:12:02.37,0:12:04.37,Default,,0,0,0,,Ммм, егер мынаны жесең⇒
Dialogue: 0,0:12:04.37,0:12:07.37,Default,,0,0,0,,Бүгін мен үйге барамын...
Dialogue: 0,0:12:07.37,0:12:09.38,Default,,0,0,0,,Уф! Мм... дәмді...
Dialogue: 0,0:12:09.38,0:12:11.38,Default,,0,0,0,,Ә!? Босану!?
Dialogue: 0,0:12:11.38,0:12:14.38,Default,,0,0,0,,Дәмді! Мына бала да солай айтады.
Dialogue: 0,0:12:18.38,0:12:20.32,Default,,0,0,0,,Сіз сөйлейсіз бе? Мүмкін...
Dialogue: 0,0:12:20.32,0:12:22.32,Default,,0,0,0,,Иә, иә, ә!
Dialogue: 0,0:12:22.32,0:12:25.32,Default,,0,0,0,,Ол жерге қалай кірдің? Ал...
Dialogue: 0,0:12:25.32,0:12:28.33,Default,,0,0,0,,Бұл туралы бір күні кездескенде сөйлесейік.
Dialogue: 0,0:12:28.33,0:12:31.33,Default,,0,0,0,,Вентрилокизм? Және бұл жақсы.
Dialogue: 0,0:12:31.33,0:12:33.33,Default,,0,0,0,,Қашан шығасың? (вентрилокизм) Белгіленген күнге дейін⇒
Dialogue: 0,0:12:33.33,0:12:35.33,Default,,0,0,0,,Бір ай ғана қалды.
Dialogue: 0,0:12:35.33,0:12:38.34,Default,,0,0,0,,Бауырым, бұл жағдайда маған көмектесіңізші.
Dialogue: 0,0:12:38.34,0:12:41.34,Default,,0,0,0,,Бу ража! (2 адам) мм...
Dialogue: 0,0:12:44.34,0:12:46.35,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:12:46.35,0:12:50.35,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:12:50.35,0:12:53.35,Default,,0,0,0,,Бірақ... Бірақ?
Dialogue: 0,0:12:53.35,0:12:56.36,Default,,0,0,0,,Егер бұл рас болса ше?
Dialogue: 0,0:12:56.36,0:12:58.36,Default,,0,0,0,,Бұлай болуы мүмкін емес!
Dialogue: 0,0:12:58.36,0:13:00.36,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:13:00.36,0:13:05.36,Default,,0,0,0,,Шинносуке біздің бала емес...
Dialogue: 0,0:13:05.36,0:13:09.37,Default,,0,0,0,,Әке? А, сен ояндың ба?
Dialogue: 0,0:13:09.37,0:13:14.37,Default,,0,0,0,,Көп шулағаным үшін кешіріңіз, қазір ұйықтайық.
Dialogue: 0,0:13:17.38,0:13:23.32,Default,,0,0,0,,Рин! болат! Үзіліс! Ниндзюцу мононоке жоқ джуцу!
Dialogue: 0,0:13:23.32,0:13:26.32,Default,,0,0,0,,Чинзо, ниндзюцумен айналысатын кез келді.
Dialogue: 0,0:13:26.32,0:13:30.32,Default,,0,0,0,,Бірақ мен Mononoke no Jutsu⇒ қолдана білуім керек
Dialogue: 0,0:13:30.32,0:13:33.33,Default,,0,0,0,,Бәріне ыңғайсыз... Жетеді.
Dialogue: 0,0:13:33.33,0:13:37.33,Default,,0,0,0,,Сіздің де болашағыңыз басқаша.
Dialogue: 0,0:13:37.33,0:13:39.33,Default,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,0:13:39.33,0:13:43.34,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:13:43.34,0:13:56.35,Default,,0,0,0,,♬～
Dialogue: 0,0:13:59.35,0:14:11.36,Default,,0,0,0,,♬～
Dialogue: 0,0:14:11.36,0:14:13.36,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:15.37,0:14:17.37,Default,,0,0,0,,Трансформация техникасы!?
Dialogue: 0,0:14:17.37,0:14:19.37,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:19.37,0:14:21.31,Default,,0,0,0,,Бала қайда?
Dialogue: 0,0:14:21.31,0:14:24.31,Default,,0,0,0,,Санды да көп, анау қарынмен не істей аласың?
Dialogue: 0,0:14:24.31,0:14:27.31,Default,,0,0,0,,Момындықпен оралсаң, өмірің алынады...
Dialogue: 0,0:14:27.31,0:14:29.31,Default,,0,0,0,,Уф! (Ниндзя) Ах!
Dialogue: 0,0:14:31.32,0:14:34.32,Default,,0,0,0,,Ниндзя қуыршақ
Dialogue: 0,0:14:34.32,0:14:38.32,Default,,0,0,0,,Уау! (Ниндзя) Уау...
Dialogue: 0,0:14:38.32,0:14:40.32,Default,,0,0,0,,Уф…
Dialogue: 0,0:14:42.33,0:14:45.33,Default,,0,0,0,,Ах! (Ниндзя) Ух...
Dialogue: 0,0:14:45.33,0:14:47.33,Default,,0,0,0,,Сен бұны істей аласың ба?
Dialogue: 0,0:14:49.34,0:14:51.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:53.34,0:14:55.34,Default,,0,0,0,,Иә! (Ниндзя) E…
Dialogue: 0,0:14:57.34,0:14:59.35,Default,,0,0,0,,Ха! Ха! Жеңілдік!
Dialogue: 0,0:14:59.35,0:15:02.35,Default,,0,0,0,,Уау! (Ниндзя) Гррр
Dialogue: 0,0:15:02.35,0:15:06.35,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:06.35,0:15:08.35,Default,,0,0,0,,О? О? Ниндзя!?
Dialogue: 0,0:15:08.35,0:15:10.36,Default,,0,0,0,,Шықпа!
Dialogue: 0,0:15:10.36,0:15:12.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:14.36,0:15:16.36,Default,,0,0,0,,Осы жерде болыңыз!
Dialogue: 0,0:15:25.30,0:15:27.30,Default,,0,0,0,,Хмф!
Dialogue: 0,0:15:34.31,0:15:37.32,Default,,0,0,0,,А... Ол да Ола!
Dialogue: 0,0:15:37.32,0:15:39.32,Default,,0,0,0,,Ха!?
Dialogue: 0,0:15:39.32,0:15:41.32,Default,,0,0,0,,Ниндзя өнері: селфи техникасы! (Ұялы телефон ысырмасының дыбысы)
Dialogue: 0,0:15:41.32,0:15:43.32,Default,,0,0,0,,Ол бар, оны қорғаңыз.
Dialogue: 0,0:15:43.32,0:15:46.33,Default,,0,0,0,,Жоқ! Бұл бала (Ниндзя) Ха!
Dialogue: 0,0:15:46.33,0:15:48.33,Default,,0,0,0,,Ой!?
Dialogue: 0,0:15:48.33,0:15:51.33,Default,,0,0,0,,Міне (Менеджер) Жарайды, мен оны қайтарып аламын.
Dialogue: 0,0:16:00.34,0:16:05.34,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:16:13.35,0:16:18.35,Default,,0,0,0,,(Сарқырама дыбысы)
Dialogue: 0,0:16:21.29,0:16:24.30,Default,,0,0,0,,О? Хмм... бұл қайда?
Dialogue: 0,0:16:24.30,0:16:28.30,Default,,0,0,0,,Шиноби ауылына кіретін бақылау бекеті осында.
Dialogue: 0,0:16:28.30,0:16:30.30,Default,,0,0,0,,Осиноби?
Dialogue: 0,0:16:30.30,0:16:33.30,Default,,0,0,0,,Тоқта және сол жерде күт.
Dialogue: 0,0:16:36.31,0:16:38.31,Default,,0,0,0,,Шинносуке-сан, бұдан былай...
Dialogue: 0,0:16:38.31,0:16:41.31,Default,,0,0,0,,Е, түрлендіру техникасы!?
Dialogue: 0,0:16:41.31,0:16:44.32,Default,,0,0,0,,Құпия сөз Yama (Директор) өзені
Dialogue: 0,0:16:44.32,0:16:46.32,Default,,0,0,0,,Хотака - Сейбу арыстандары
Dialogue: 0,0:16:46.32,0:16:49.32,Default,,0,0,0,,Уф... (Секишо күзетшісі) Алаяқ! Диа Диа!
Dialogue: 0,0:16:49.32,0:16:54.33,Default,,0,0,0,,Күте тұрыңыз! Құпия сөз - өзен! өзен!
Dialogue: 0,0:16:54.33,0:16:56.33,Default,,0,0,0,,Дайын бол
Dialogue: 0,0:16:56.33,0:16:59.33,Default,,0,0,0,,Мен ол киіммен ауылға кіре алмаймын.
Dialogue: 0,0:16:59.33,0:17:02.33,Default,,0,0,0,,Арқанды шеш! Мен геофизикпін
Dialogue: 0,0:17:02.33,0:17:05.34,Default,,0,0,0,,Тек тергесем деймін... (Бақылаушы) Үніңді жап, күдікті жігіт!
Dialogue: 0,0:17:05.34,0:17:07.34,Default,,0,0,0,,Галанду~! (Секишо күзетшісі) Сондай киінген ғалым⇒
Dialogue: 0,0:17:07.34,0:17:09.34,Default,,0,0,0,,Сіз ол жерде болуыңыз мүмкін емес! (Директор) Сіз зиянкессіз бе?
Dialogue: 0,0:17:09.34,0:17:11.34,Default,,0,0,0,,Иә, мен оны бүгін таңертең орманда ұстадым.
Dialogue: 0,0:17:11.34,0:17:13.35,Default,,0,0,0,,Түрмеде қамау
Dialogue: 0,0:17:13.35,0:17:17.35,Default,,0,0,0,,Ауылды білетін адамды тірідей үйіне жібере алмаймын.
Dialogue: 0,0:17:17.35,0:17:19.35,Default,,0,0,0,,Сақтық шарасы ретінде ескерту деңгейін 3-ке дейін көтеріңіз.
Dialogue: 0,0:17:19.35,0:17:21.29,Default,,0,0,0,,Мұқият тыңда, Шинносуке-сан⇒
Dialogue: 0,0:17:21.29,0:17:24.29,Default,,0,0,0,,Бүгіннен бастап мен ниндзямын.
Dialogue: 0,0:17:24.29,0:17:27.29,Default,,0,0,0,,О? Ал енді ⇒
Dialogue: 0,0:17:27.29,0:17:30.30,Default,,0,0,0,,Мен сенің анаңмын, иә?
Dialogue: 0,0:17:30.30,0:17:35.30,Default,,0,0,0,,Бүгіннен бастап сіз ниндзя Икусо Какуречинзосыз.
Dialogue: 0,0:17:44.31,0:17:46.31,Default,,0,0,0,,Бұл Осиноби ауылы ма?
Dialogue: 0,0:17:46.31,0:17:49.32,Default,,0,0,0,,Иә, бәрі ниндзя болып туылады⇒
Dialogue: 0,0:17:49.32,0:17:54.32,Default,,0,0,0,,Ниндзя болып өлу, аты жоқ ниндзялар ауылы
Dialogue: 0,0:17:54.32,0:17:58.32,Default,,0,0,0,,Ей, жүзі шаршаған қария, қайда барасың?
Dialogue: 0,0:17:58.32,0:18:01.33,Default,,0,0,0,,Жер кіндігі Жер кіндігі?
Dialogue: 0,0:18:01.33,0:18:04.33,Default,,0,0,0,,Сен мұны осы ауылда да білмейсің бе?
Dialogue: 0,0:18:04.33,0:18:07.33,Default,,0,0,0,,шектеулі адамдар ғана кіре алатын арнайы орын
Dialogue: 0,0:18:07.33,0:18:10.34,Default,,0,0,0,,О? О... Уау!
Dialogue: 0,0:18:10.34,0:18:15.34,Default,,0,0,0,,Бұл не! Бұл жердің кіндігі
Dialogue: 0,0:18:15.34,0:18:18.34,Default,,0,0,0,,Хохо Күнжіт тұқымын ала аласыз ба?
Dialogue: 0,0:18:18.34,0:18:21.28,Default,,0,0,0,,Өте таза алтынның үлкен кесегі⇒
Dialogue: 0,0:18:21.28,0:18:24.28,Default,,0,0,0,,Біз терең тесікті бітеп жатырмыз.
Dialogue: 0,0:18:24.28,0:18:26.29,Default,,0,0,0,,Бұл қаншалықты терең?
Dialogue: 0,0:18:26.29,0:18:28.29,Default,,0,0,0,,Мүмкін сәл көбірек
Dialogue: 0,0:18:28.29,0:18:31.29,Default,,0,0,0,,Ол шұңқыр ағаштың тамырындай жайылып жатыр⇒
Dialogue: 0,0:18:31.29,0:18:34.29,Default,,0,0,0,,Жердің ортасына дейін созылған дейді.
Dialogue: 0,0:18:34.29,0:18:36.30,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:36.30,0:18:39.30,Default,,0,0,0,,Кіріңіз. Әй, бұл мүмкін емес!
Dialogue: 0,0:18:39.30,0:18:42.30,Default,,0,0,0,,Егер бұл тығын шықса⇒
Dialogue: 0,0:18:42.30,0:18:45.30,Default,,0,0,0,,Келіңіздер, бұл қиын! Сіз не болады деп ойлайсыз?
Dialogue: 0,0:18:45.30,0:18:50.31,Default,,0,0,0,,Мен зәр шығаруды тоқтата алмаймын, бұл да қиын...
Dialogue: 0,0:18:50.31,0:18:53.31,Default,,0,0,0,,Ауа толтырылған шар тәрізді⇒
Dialogue: 0,0:18:53.31,0:18:57.32,Default,,0,0,0,,Жер ғажайып энергияға толы.
Dialogue: 0,0:18:57.32,0:19:01.32,Default,,0,0,0,,Біз бұл энергияны «нитл»⇒ деп атаймыз
Dialogue: 0,0:19:01.32,0:19:04.32,Default,,0,0,0,,Егер бұл тығын шықса⇒
Dialogue: 0,0:19:04.32,0:19:06.33,Default,,0,0,0,,Нинтл жерден жоғалады⇒
Dialogue: 0,0:19:06.33,0:19:11.33,Default,,0,0,0,,Жер құрғақ, теңіз тыныш, жел соқпайды⇒
Dialogue: 0,0:19:11.33,0:19:14.33,Default,,0,0,0,,Бұл жер өлім планетасына айналады.
Dialogue: 0,0:19:14.33,0:19:17.34,Default,,0,0,0,,Пиллбуг
Dialogue: 0,0:19:17.34,0:19:21.27,Default,,0,0,0,,Кел, ақсақал қарсы алады.
Dialogue: 0,0:19:21.27,0:19:24.28,Default,,0,0,0,,Сіз қатал адамсыз. Өтінемін, дөрекі болмаңыз.
Dialogue: 0,0:19:24.28,0:19:26.28,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:26.28,0:19:28.28,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,0:19:30.28,0:19:33.29,Default,,0,0,0,,Иә? Цубуан!?
Dialogue: 0,0:19:33.29,0:19:36.29,Default,,0,0,0,,Бүгінгі дайфуку қошян болды дедім ғой!
Dialogue: 0,0:19:36.29,0:19:38.29,Default,,0,0,0,,Әй, бірден басқасын дайында...
Dialogue: 0,0:19:38.29,0:19:43.30,Default,,0,0,0,,Аузыңды жап! Нинпо ақша үйіндісі!
Dialogue: 0,0:19:43.30,0:19:45.30,Default,,0,0,0,,Гуах! Ах...
Dialogue: 0,0:19:47.30,0:19:50.30,Default,,0,0,0,,Мүлдем қабілетсіз
Dialogue: 0,0:19:52.30,0:19:55.31,Default,,0,0,0,,≪(ﾉｯｸ)
Dialogue: 0,0:19:55.31,0:20:00.31,Default,,0,0,0,,Мен Окусо Какуречино мен оның анасы Чиёмені қайтарып алдым.
Dialogue: 0,0:20:00.31,0:20:02.31,Default,,0,0,0,,Еңбекқорлық Тынымсыз еңбек
Dialogue: 0,0:20:02.31,0:20:04.32,Default,,0,0,0,,Сәлем! Ах!?
Dialogue: 0,0:20:04.32,0:20:06.32,Default,,0,0,0,,Меніңше, бұл матч…
Dialogue: 0,0:20:06.32,0:20:09.32,Default,,0,0,0,,Сіз сирек кездесетін қазынасыз ба?
Dialogue: 0,0:20:09.32,0:20:11.32,Default,,0,0,0,,Иә? Чинзо-кун?
Dialogue: 0,0:20:11.32,0:20:14.33,Default,,0,0,0,,Сәлеметсіз бе? Чин-чан
Dialogue: 0,0:20:14.33,0:20:16.33,Default,,0,0,0,,Чин-чан? Шин-чан Чин-чан
Dialogue: 0,0:20:16.33,0:20:21.33,Default,,0,0,0,,Оны қалай атайтының маған бәрібір! Мононоке техникасын көрсет!
Dialogue: 0,0:20:21.33,0:20:24.34,Default,,0,0,0,,Пуруруру… Пуруруру… Гача
Dialogue: 0,0:20:24.34,0:20:27.34,Default,,0,0,0,,Сәлеметсіз бе, қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:20:27.34,0:20:29.34,Default,,0,0,0,,Бұл бұлыңғыр емес! Мононоке!
Dialogue: 0,0:20:29.34,0:20:32.34,Default,,0,0,0,,О? Ақымақ
Dialogue: 0,0:20:32.34,0:20:35.35,Default,,0,0,0,,Ниндзя өнері Кидара... (жер шуылдауы)
Dialogue: 0,0:20:35.35,0:20:37.35,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:20:37.35,0:20:39.35,Default,,0,0,0,,(жартылай қоңырау дыбысы)
Dialogue: 0,0:20:39.35,0:20:43.36,Default,,0,0,0,,Кіндік қысымы жоғарылайды! (Ниндзя) Кран қозғалып жатыр!
Dialogue: 0,0:20:43.36,0:20:46.36,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:20:46.36,0:20:50.36,Default,,0,0,0,,Қауіпсіздік клапанын ашыңыз! Гомаэмон
Dialogue: 0,0:20:54.37,0:20:59.37,Default,,0,0,0,,Бұл сіздің әкеңіз Какуре Гомаэмон.
Dialogue: 0,0:21:01.37,0:21:04.38,Default,,0,0,0,,Әке? Горилла!?
Dialogue: 0,0:21:04.38,0:21:06.38,Default,,0,0,0,,Рин! болат! Үзіліс!
Dialogue: 0,0:21:06.38,0:21:08.38,Default,,0,0,0,,Мононоке Хохо!
Dialogue: 0,0:21:08.38,0:21:11.38,Default,,0,0,0,,Ниндзя өнері: Мононоке тәсілі
Dialogue: 0,0:21:11.38,0:21:13.39,Default,,0,0,0,,Денеде шоғырланған Nintle бар⇒
Dialogue: 0,0:21:13.39,0:21:18.39,Default,,0,0,0,,Пайдаланушының жүрегінде өмір сүретін аңды бейнелейтін ниндзяның соңғы техникасы!
Dialogue: 0,0:21:18.39,0:21:20.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:26.33,0:21:28.33,Default,,0,0,0,,(Алып горилланың айқайы)
Dialogue: 0,0:21:28.33,0:21:33.34,Default,,0,0,0,,Уау! Горилладан горилла шықты!
Dialogue: 0,0:21:33.34,0:21:47.35,Default,,0,0,0,,♬～
Dialogue: 0,0:21:47.35,0:21:50.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:50.36,0:21:52.36,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:21:57.36,0:22:00.37,Default,,0,0,0,,Уау! Өте керемет!
Dialogue: 0,0:22:00.37,0:22:02.37,Default,,0,0,0,,«Керемет!» емес
Dialogue: 0,0:22:02.37,0:22:04.37,Default,,0,0,0,,Оны да жасап, көмектес!
Dialogue: 0,0:22:04.37,0:22:07.37,Default,,0,0,0,,Ақсақал, мына бала... Иә, иә.
Dialogue: 0,0:22:07.37,0:22:09.37,Default,,0,0,0,,Ал, сіз мұны қалайсыз ба?
Dialogue: 0,0:22:13.38,0:22:15.38,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:22:15.38,0:22:17.38,Default,,0,0,0,,Сот...
Dialogue: 0,0:22:17.38,0:22:20.32,Default,,0,0,0,,Хмф, хехе!
Dialogue: 0,0:22:20.32,0:22:23.32,Default,,0,0,0,,Ниндзя өнері: Мононо жоқ, жоқ, джуцу!
Dialogue: 0,0:22:23.32,0:22:27.33,Default,,0,0,0,,Мононоке ~ Қолтықтағы шаш ~ Қолтықтағы шаш ~
Dialogue: 0,0:22:27.33,0:22:31.33,Default,,0,0,0,,Өзіңізді алдамаңыз! Сендер күнәкарсыңдар!
Dialogue: 0,0:22:31.33,0:22:34.33,Default,,0,0,0,,Аса таза алтынды ұрлап, осы ауылдан қашып кеткен.
Dialogue: 0,0:22:34.33,0:22:38.34,Default,,0,0,0,,Ниндзя кодексіне сәйкес қалада сүйреп апару жазасы!
Dialogue: 0,0:22:38.34,0:22:41.34,Default,,0,0,0,,Кінәлі (Гомаэмон) Ах!
Dialogue: 0,0:22:41.34,0:22:44.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:22:44.34,0:22:47.35,Default,,0,0,0,,Сіздің асқазаныңызда оны тек гермит ретінде қолдануға болады ⇒
Dialogue: 0,0:22:47.35,0:22:50.35,Default,,0,0,0,,Мононоке техникасын мұраға алатын бала бар.
Dialogue: 0,0:22:50.35,0:22:54.35,Default,,0,0,0,,Сондықтан бала туылғанға дейін жазаны орындау кейінге қалдырылады.
Dialogue: 0,0:22:54.35,0:22:56.36,Default,,0,0,0,,Бірақ үйден шықпаңыз
Dialogue: 0,0:22:56.36,0:22:58.36,Default,,0,0,0,,Байқап жүріңіз
Dialogue: 0,0:22:58.36,0:23:00.36,Default,,0,0,0,,Үйқамақ
Dialogue: 0,0:23:00.36,0:23:04.36,Default,,0,0,0,,Қажетсіз нәрселерді ойлама, жақсы бала ту
Dialogue: 0,0:23:04.36,0:23:08.37,Default,,0,0,0,,Ертеңнен бастап ұлыңызды ниндзя балабақшасына беріңіз.
Dialogue: 0,0:23:08.37,0:23:10.37,Default,,0,0,0,,Не? (Ақсақал) Нинпо ⇒
Dialogue: 0,0:23:10.37,0:23:12.37,Default,,0,0,0,,3 күн ішінде негізгіден қайта құру⇒
Dialogue: 0,0:23:12.37,0:23:15.37,Default,,0,0,0,,Олар Мононоке но-джуцуды үйренсін
Dialogue: 0,0:23:15.37,0:23:17.38,Default,,0,0,0,,Алайда осы уақытқа дейін ол балабақшаға бармаған ⇒
Dialogue: 0,0:23:17.38,0:23:20.31,Default,,0,0,0,,Үйдегі жаттығу (Ақсақал) Қандай тәтті!
Dialogue: 0,0:23:20.31,0:23:24.32,Default,,0,0,0,,Міне, осындай ерекше күтімнің нәтижесі!
Dialogue: 0,0:23:24.32,0:23:27.32,Default,,0,0,0,,Қараңызшы, Горилла мырза, бұл банан!
Dialogue: 0,0:23:27.32,0:23:30.32,Default,,0,0,0,,Қолдаңдар! Отыр! Бірақ 3 күнде...
Dialogue: 0,0:23:30.32,0:23:32.32,Default,,0,0,0,,Содан кейін 4 күн...
Dialogue: 0,0:23:32.32,0:23:35.33,Default,,0,0,0,,Бүгінгі өте таза алтын
Dialogue: 0,0:23:35.33,0:23:38.33,Default,,0,0,0,,О, мені күте тұрыңызшы.
Dialogue: 0,0:23:38.33,0:23:40.33,Default,,0,0,0,,Мухфуфуфу мен қорқамын⇒
Dialogue: 0,0:23:40.33,0:23:43.34,Default,,0,0,0,,Соңғы кездері қарынымның тұрақсыз болуының себебі, мен оны қырып тастадым ⇒
Dialogue: 0,0:23:43.34,0:23:47.34,Default,,0,0,0,,Бұл да тығынның кішірек болуынан емес пе?
Dialogue: 0,0:23:47.34,0:23:49.34,Default,,0,0,0,,Ешқандай негіз жоқ!
Dialogue: 0,0:23:49.34,0:23:53.35,Default,,0,0,0,,Кім туралы қандай мәліметтер бар? Әуесқойлардың сөйлеуіне жол бермеңіз
Dialogue: 0,0:23:53.35,0:23:57.35,Default,,0,0,0,,Ертеңнен бастап кесіп алған соманы екі есе көбейтіңіз.
Dialogue: 0,0:23:57.35,0:23:59.35,Default,,0,0,0,,Ха! Кункун…
Dialogue: 0,0:23:59.35,0:24:01.35,Default,,0,0,0,,Кункун… Кункун…
Dialogue: 0,0:24:01.35,0:24:04.36,Default,,0,0,0,,Менің аяғым әкемдікіне көбірек ұқсайды.⇒
Dialogue: 0,0:24:04.36,0:24:06.36,Default,,0,0,0,,Ылғал ақ түске ұқсайды
Dialogue: 0,0:24:06.36,0:24:08.36,Default,,0,0,0,,Оның беті менің әкемдікі емес⇒
Dialogue: 0,0:24:08.36,0:24:10.36,Default,,0,0,0,,Анаң ашуланғанда ұқсайсың.
Dialogue: 0,0:24:10.36,0:24:14.37,Default,,0,0,0,,Эй, неге горилла? Хо... Ухохо
Dialogue: 0,0:24:14.37,0:24:17.37,Default,,0,0,0,,Иә! Мен оны әкеме де көрсетемін.
Dialogue: 0,0:24:17.37,0:24:20.31,Default,,0,0,0,,Ниндзя өнері: селфи жасау өнері! (ысырма дыбысы)
Dialogue: 0,0:24:20.31,0:24:23.31,Default,,0,0,0,,(Хабар жіберу дыбысы)
Dialogue: 0,0:24:23.31,0:24:25.31,Default,,0,0,0,,О! Конфискация~
Dialogue: 0,0:24:25.31,0:24:29.31,Default,,0,0,0,,Ауылға сырттан заттарды әкелу ережеге қайшы.
Dialogue: 0,0:24:29.31,0:24:33.32,Default,,0,0,0,,Басқалардың заттарын алмау керек! Маған смартфонымды қайтарып беріңізші!
Dialogue: 0,0:24:33.32,0:24:36.32,Default,,0,0,0,,Ниндзя заңы: ақша!
Dialogue: 0,0:24:38.32,0:24:42.33,Default,,0,0,0,,Ах, егер сен ниндзя болсаң, ниндзяға көбірек ұқса.
Dialogue: 0,0:24:42.33,0:24:46.33,Default,,0,0,0,,Құпия болды деп ренжіме.
Dialogue: 0,0:24:46.33,0:24:48.33,Default,,0,0,0,,Эбаринбо!
Dialogue: 0,0:24:48.33,0:24:51.34,Default,,0,0,0,,Бұл туралы үнемі айтатын жігіт әдетте жаман жігіт⇒
Dialogue: 0,0:24:51.34,0:24:54.34,Default,,0,0,0,,Әкем осылай деді!
Dialogue: 0,0:24:54.34,0:24:57.34,Default,,0,0,0,,Тәртіп те қажет.
Dialogue: 0,0:25:02.35,0:25:05.35,Default,,0,0,0,,Фу…
Dialogue: 0,0:25:05.35,0:25:08.35,Default,,0,0,0,,Кешіріңіз (Гомаэмон) Чинзо Хохохо?
Dialogue: 0,0:25:08.35,0:25:11.36,Default,,0,0,0,,Чинзо ауылдың сыртында
Dialogue: 0,0:25:11.36,0:25:15.36,Default,,0,0,0,,Сіз мұнда қарағанда қауіпсіз жерде болуыңыз керек...
Dialogue: 0,0:25:15.36,0:25:19.36,Default,,0,0,0,,Ухо ой хоу хоу хоу... Өйткені⇒
Dialogue: 0,0:25:19.36,0:25:22.30,Default,,0,0,0,,Мен сенімен сөйлескім келсе де, сен әрқашан жоқсың!
Dialogue: 0,0:25:22.30,0:25:27.31,Default,,0,0,0,,Чинзоны маған қалдырыңыз...
Dialogue: 0,0:25:27.31,0:25:29.31,Default,,0,0,0,,Уууу хохохо
Dialogue: 0,0:25:29.31,0:25:31.31,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:25:31.31,0:25:34.31,Default,,0,0,0,,Мен бұл туралы бірдеңе істеймін
Dialogue: 0,0:25:34.31,0:25:36.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:36.31,0:25:39.32,Default,,0,0,0,,Осыны орындасаңыз...
Dialogue: 0,0:25:39.32,0:25:43.32,Default,,0,0,0,,Оған дейін мен Шинносуке-санды міндетті түрде қорғаймын.
Dialogue: 0,0:25:43.32,0:25:48.32,Default,,0,0,0,,Ааааааааааааааааааааааааааааа...
Dialogue: 0,0:25:52.33,0:25:57.34,Default,,0,0,0,,Мистер Спидвагоннан қоңырау
Dialogue: 0,0:25:57.34,0:26:00.34,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:26:00.34,0:26:03.34,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:26:03.34,0:26:05.34,Default,,0,0,0,,Сіз қоңырау шалып жатырсыз ба?
Dialogue: 0,0:26:05.34,0:26:08.35,Default,,0,0,0,,Бұл ауылды білмеу керек.
Dialogue: 0,0:26:08.35,0:26:12.35,Default,,0,0,0,,Отбасы Чиёмемен араласқан Нохара деп атады...⇒
Dialogue: 0,0:26:12.35,0:26:15.35,Default,,0,0,0,,Одан құтылу (Хегахиса) болады
Dialogue: 0,0:26:15.35,0:26:18.35,Default,,0,0,0,,Оны бізге қалдыр, көлеңкелер әскері.
Dialogue: 0,0:26:21.29,0:26:25.30,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:26:25.30,0:26:31.30,Default,,0,0,0,,Шин-Чан, мен күнде ұйықтайтынмын, өйткені жазғы демалыс...
Dialogue: 0,0:26:31.30,0:26:34.31,Default,,0,0,0,,А? Бұл әжетхана ма?
Dialogue: 0,0:26:34.31,0:26:37.31,Default,,0,0,0,,Ха... Екінші қабатқа қараймын.
Dialogue: 0,0:26:39.31,0:26:42.31,Default,,0,0,0,,Шинносуке?
Dialogue: 0,0:26:42.31,0:26:46.32,Default,,0,0,0,,Шинносуке Шинносуке
Dialogue: 0,0:26:46.32,0:26:49.32,Default,,0,0,0,,Әй...
Dialogue: 0,0:26:49.32,0:26:51.32,Default,,0,0,0,,Тая? ау
Dialogue: 0,0:26:51.32,0:26:53.33,Default,,0,0,0,,Ей, екінші қабатта ешкім жоқ!
Dialogue: 0,0:26:53.33,0:26:55.33,Default,,0,0,0,,Ә!? Бұл ата-ана мен бала да?
Dialogue: 0,0:26:55.33,0:26:57.33,Default,,0,0,0,,Иә, мүмкін емес...
Dialogue: 0,0:26:57.33,0:26:59.33,Default,,0,0,0,,Тая Уау!?
Dialogue: 0,0:26:59.33,0:27:01.33,Default,,0,0,0,,Широ Бұл үлкен емес пе?
Dialogue: 0,0:27:01.33,0:27:04.34,Default,,0,0,0,,А? Бұл туралы айтатын болсақ ...
Dialogue: 0,0:27:04.34,0:27:06.34,Default,,0,0,0,,Кун... н-ан!
Dialogue: 0,0:27:06.34,0:27:09.34,Default,,0,0,0,,Ә!? Екі Широ!?
Dialogue: 0,0:27:09.34,0:27:11.34,Default,,0,0,0,,Тая~!
Dialogue: 0,0:27:13.35,0:27:16.35,Default,,0,0,0,,Ә!?
Dialogue: 0,0:27:19.35,0:27:21.29,Default,,0,0,0,,Пуха!
Dialogue: 0,0:27:21.29,0:27:24.29,Default,,0,0,0,,Чинзо-кун!? (Құлаған дыбыс)
Dialogue: 0,0:27:24.29,0:27:26.29,Default,,0,0,0,,Гаар!!
Dialogue: 0,0:27:26.29,0:27:28.29,Default,,0,0,0,,Ке... полиция! Полиция~! Оу!
Dialogue: 0,0:27:30.30,0:27:32.30,Default,,0,0,0,,Бұл менің анамдікі
Dialogue: 0,0:27:32.30,0:27:34.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:34.30,0:27:36.30,Default,,0,0,0,,А... қуыршақ?
Dialogue: 0,0:27:36.30,0:27:39.30,Default,,0,0,0,,Сіз нені айтасыз? иә? О?
Dialogue: 0,0:27:42.31,0:27:45.31,Default,,0,0,0,,Хаа!? Бұл не?
Dialogue: 0,0:27:45.31,0:27:49.31,Default,,0,0,0,,Шин-чан! Бұл горилла не?
Dialogue: 0,0:27:49.31,0:27:52.31,Default,,0,0,0,,Кез келген жағдайда, әке! (2 адам) Иә?
Dialogue: 0,0:27:54.32,0:27:59.32,Default,,0,0,0,,Сонымен, бұл Синноске қазір ниндзялар ауылында дегенді білдіре ме?
Dialogue: 0,0:27:59.32,0:28:01.33,Default,,0,0,0,,Мүмкін анам да сенің жаныңда шығар.
Dialogue: 0,0:28:01.33,0:28:06.33,Default,,0,0,0,,Маған не болса да бұдан жасырын деді.
Dialogue: 0,0:28:06.33,0:28:08.33,Default,,0,0,0,,Дұрыс... (Дауысты нұсқау) Мен үйдемін⇒
Dialogue: 0,0:28:08.33,0:28:11.34,Default,,0,0,0,,Мен телефонға жауап бере алмаймын. Сіз менің үй мекенжайымды білесіз бе?
Dialogue: 0,0:28:11.34,0:28:14.34,Default,,0,0,0,,Жоқ... Сіздің телефон нөміріңіз қандай?
Dialogue: 0,0:28:14.34,0:28:18.34,Default,,0,0,0,,Не? Телефон банкі дегеніміз не?
Dialogue: 0,0:28:18.34,0:28:20.28,Default,,0,0,0,,Иә? ≪(Широның үруі)
Dialogue: 0,0:28:20.28,0:28:29.18,Default,,0,0,0,,(қабығы)
Dialogue: 0,0:28:31.29,0:28:33.29,Default,,0,0,0,,Мен қазір телефонға жауап бере алмаймын...
Dialogue: 0,0:28:33.29,0:28:35.29,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:28:35.29,0:28:37.30,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:28:37.30,0:28:41.30,Default,,0,0,0,,Аа, кешіріңіз, Чинзо-кун кешірім сұрамайды.
Dialogue: 0,0:28:41.30,0:28:44.30,Default,,0,0,0,,Жоқ... бұл менің кінәм шығар.
Dialogue: 0,0:28:44.30,0:28:46.30,Default,,0,0,0,,Не? (Чинзо) Мен⇒
Dialogue: 0,0:28:46.30,0:28:49.31,Default,,0,0,0,,Инсу гермитінің қаны бар кез келген адам оны пайдалана алуы керек⇒
Dialogue: 0,0:28:49.31,0:28:53.31,Default,,0,0,0,,Мен Mononoke no Jutsu пайдалана алмаймын...
Dialogue: 0,0:28:53.31,0:28:57.32,Default,,0,0,0,,Егер техниканы қолдана алсам⇒
Dialogue: 0,0:28:57.32,0:29:01.32,Default,,0,0,0,,Анамның да қашпағаны жақсы шығар...
Dialogue: 0,0:29:05.32,0:29:08.33,Default,,0,0,0,,Уайымдамаңыз, жақында кездесеміз.
Dialogue: 0,0:29:08.33,0:29:11.33,Default,,0,0,0,,Ана мен Шин Чанды бірге іздейік.
Dialogue: 0,0:29:11.33,0:29:13.33,Default,,0,0,0,,Иә, ДК!
Dialogue: 0,0:29:13.33,0:29:15.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:15.33,0:29:17.34,Default,,0,0,0,,Компьютерде ⇒
Dialogue: 0,0:29:17.34,0:29:19.34,Default,,0,0,0,,Жоғалған смартфонның орналасқан жері туралы ақпаратты таба алуыңыз керек
Dialogue: 0,0:29:19.34,0:29:23.27,Default,,0,0,0,,Түсіндім! Күткендей, Миса оны жоғалтуға дағдыланған.
Dialogue: 0,0:29:23.27,0:29:25.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:25.28,0:29:28.28,Default,,0,0,0,,Ух... Ой...
Dialogue: 0,0:29:28.28,0:29:30.28,Default,,0,0,0,,Мм... иә?
Dialogue: 0,0:29:30.28,0:29:33.28,Default,,0,0,0,,Сасық емес пе? иә? Бұл мен емес
Dialogue: 0,0:29:33.28,0:29:36.29,Default,,0,0,0,,Мен де емеспін.
Dialogue: 0,0:29:36.29,0:29:40.29,Default,,0,0,0,,Бұл менмін! Хехехехе!
Dialogue: 0,0:29:40.29,0:29:46.30,Default,,0,0,0,,Хехехехехе! Хехехе...
Dialogue: 0,0:29:46.30,0:29:51.30,Default,,0,0,0,,Көлеңкелік өлтіруші Хисайзу Хега
Dialogue: 0,0:29:51.30,0:29:53.30,Default,,0,0,0,,Мен қазір осындамын.
Dialogue: 0,0:29:53.30,0:29:57.31,Default,,0,0,0,,Көлеңке өлтіруші... Сіз оны білесіз бе?
Dialogue: 0,0:29:57.31,0:29:59.31,Default,,0,0,0,,Мен ол туралы естідім
Dialogue: 0,0:29:59.31,0:30:03.31,Default,,0,0,0,,Ең күшті ниндзялар тобы бар, олар көздеген олжасын міндетті түрде түсіреді.
Dialogue: 0,0:30:03.31,0:30:05.31,Default,,0,0,0,,Е... күшік!
Dialogue: 0,0:30:11.32,0:30:13.32,Default,,0,0,0,,Skyship…
Dialogue: 0,0:30:13.32,0:30:17.33,Default,,0,0,0,,Ей, балалар бүгін бітірдіңдер.
Dialogue: 0,0:30:17.33,0:30:21.33,Default,,0,0,0,,Бұл ең сасық күн!
Dialogue: 0,0:30:21.33,0:30:23.33,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:30:23.33,0:30:27.34,Default,,0,0,0,,Ninja Dark Shuriken су таңбасының түрі
Dialogue: 0,0:30:27.34,0:30:29.34,Default,,0,0,0,,Қиындық!
Dialogue: 0,0:30:29.34,0:30:33.34,Default,,0,0,0,,Кя!
Dialogue: 0,0:30:33.34,0:30:37.35,Default,,0,0,0,,Қарғыс атсын! Ол қандай жігіт!?
Dialogue: 0,0:30:37.35,0:30:40.35,Default,,0,0,0,,Нинтурге бай жерде өсірілген ерекше картоп ⇒
Dialogue: 0,0:30:40.35,0:30:45.35,Default,,0,0,0,,Жақсы дайындалған ішегінде оны газға айналдырып, фарт бомбасын жасайды!
Dialogue: 0,0:30:47.36,0:30:50.36,Default,,0,0,0,,Ааааааааа... Қашпа!
Dialogue: 0,0:30:50.36,0:30:52.36,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:30:55.37,0:30:58.37,Default,,0,0,0,,Менің несиеге әлі 32 жыл қалды.
Dialogue: 0,0:30:58.37,0:31:00.37,Default,,0,0,0,,Сасық!
Dialogue: 0,0:31:00.37,0:31:02.37,Default,,0,0,0,,Уау! Кя!
Dialogue: 0,0:31:02.37,0:31:05.38,Default,,0,0,0,,Мисае! қауіпті!
Dialogue: 0,0:31:05.38,0:31:08.38,Default,,0,0,0,,Хм!?
Dialogue: 0,0:31:08.38,0:31:10.38,Default,,0,0,0,,Ниндзя қағазы Шурикен!
Dialogue: 0,0:31:14.39,0:31:16.39,Default,,0,0,0,,Сіз ниндзясыз ба?
Dialogue: 0,0:31:19.39,0:31:21.29,Default,,0,0,0,,Сен оны білесің бе, Аводөл? (Аводөл) Ах… өте
Dialogue: 0,0:31:23.33,0:31:25.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:27.33,0:31:30.34,Default,,0,0,0,,Рин! болат! Үзіліс!
Dialogue: 0,0:31:30.34,0:31:33.34,Default,,0,0,0,,Не!? (Чинзо) Ниндзюцу Мононоке жоқ Джутсу!
Dialogue: 0,0:31:33.34,0:31:37.34,Default,,0,0,0,,Бұл мононок!?
Dialogue: 0,0:31:37.34,0:31:40.35,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:31:40.35,0:31:42.35,Default,,0,0,0,,Менің ойымша, бұл жақсы емес ...
Dialogue: 0,0:31:42.35,0:31:48.35,Default,,0,0,0,,Сіз біз туралы тым көп білетін сияқтысыз.
Dialogue: 0,0:31:48.35,0:31:51.35,Default,,0,0,0,,Тірі қалу мүмкін емес
Dialogue: 0,0:31:53.36,0:31:57.36,Default,,0,0,0,,Ниндзя Қараңғы Шурикен Бакон жоқ Ката
Dialogue: 0,0:31:57.36,0:32:00.37,Default,,0,0,0,,(Ұлы дыбыс)
Dialogue: 0,0:32:00.37,0:32:02.37,Default,,0,0,0,,Шексіз лүпіл!
Dialogue: 0,0:32:02.37,0:32:05.37,Default,,0,0,0,,Уау... (Хегахиса) Ахх!!
Dialogue: 0,0:32:05.37,0:32:07.37,Default,,0,0,0,,Қазір! Оу!
Dialogue: 0,0:32:07.37,0:32:09.37,Default,,0,0,0,,Нуо!
Dialogue: 0,0:32:09.37,0:32:12.38,Default,,0,0,0,,Ниндзя техникасы: Фарт қайтару!
Dialogue: 0,0:32:12.38,0:32:16.38,Default,,0,0,0,,Бұл тіпті осырық емес! Жаңғақ жаңғақ жаңғақ...
Dialogue: 0,0:32:16.38,0:32:19.38,Default,,0,0,0,,Нуар!! (Жарылыс дыбысы)
Dialogue: 0,0:32:19.38,0:32:22.28,Default,,0,0,0,,Широ! Энн! Анан!
Dialogue: 0,0:32:24.32,0:32:27.33,Default,,0,0,0,,Қарғыс атсын... Күте тұрыңыз...
Dialogue: 0,0:32:27.33,0:32:29.33,Default,,0,0,0,,(Ұлы дыбыс)
Dialogue: 0,0:32:29.33,0:32:33.33,Default,,0,0,0,,Бұл не!? Ха...
Dialogue: 0,0:32:33.33,0:32:36.33,Default,,0,0,0,,Чинзо-кун, маған көмектескенің үшін рахмет!?
Dialogue: 0,0:32:36.33,0:32:38.34,Default,,0,0,0,,Анама бірдеңе болса⇒
Dialogue: 0,0:32:38.34,0:32:41.34,Default,,0,0,0,,Нохара отбасын отбасы ретінде қарастырыңыз.
Dialogue: 0,0:32:41.34,0:32:45.34,Default,,0,0,0,,А... ә!? Апыр-ай!
Dialogue: 0,0:32:45.34,0:32:48.34,Default,,0,0,0,,Не, кенеттен?
Dialogue: 0,0:32:50.35,0:32:53.35,Default,,0,0,0,,Ә!? Құйрық~!?
Dialogue: 0,0:32:53.35,0:32:57.36,Default,,0,0,0,,(Тауықтың айқайы)
Dialogue: 0,0:32:57.36,0:33:03.36,Default,,0,0,0,,Ммм, ана... жоқ...
Dialogue: 0,0:33:03.36,0:33:07.37,Default,,0,0,0,,Эй, мен тағы біраз ұйықтаймын~
Dialogue: 0,0:33:07.37,0:33:12.37,Default,,0,0,0,,Ммм~ Анашым, сіздің қолыңыздағы шаш әдеттегіден де түкті екен... Уау!?
Dialogue: 0,0:33:14.37,0:33:16.37,Default,,0,0,0,,Вауавуа!
Dialogue: 0,0:33:16.37,0:33:19.38,Default,,0,0,0,,Әй?
Dialogue: 0,0:33:19.38,0:33:21.31,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:33:21.31,0:33:24.32,Default,,0,0,0,,Бұл кісі – ата.
Dialogue: 0,0:33:24.32,0:33:27.32,Default,,0,0,0,,Бұл жалқау...
Dialogue: 0,0:33:27.32,0:33:31.32,Default,,0,0,0,,Егер сіз Мононоке техникасын ұзақ уақыт бойы қолданып жүрсеңіз⇒
Dialogue: 0,0:33:31.32,0:33:35.33,Default,,0,0,0,,Денем хайуанға айналып, оны қайтара алмаймын ⇒
Dialogue: 0,0:33:35.33,0:33:38.33,Default,,0,0,0,,Бұл өте қорқынышты техника.
Dialogue: 0,0:33:38.33,0:33:41.33,Default,,0,0,0,,Ой...
Dialogue: 0,0:33:41.33,0:33:44.34,Default,,0,0,0,,Тоттотто! Ах
Dialogue: 0,0:33:44.34,0:33:47.34,Default,,0,0,0,,Бұл Шинносукенің киімі.
Dialogue: 0,0:33:47.34,0:33:50.34,Default,,0,0,0,,Кішкентай кезімде солай киетінмін.
Dialogue: 0,0:33:50.34,0:33:52.34,Default,,0,0,0,,Бұл жақсырақ
Dialogue: 0,0:33:52.34,0:33:56.34,Default,,0,0,0,,Бүгін солай!
Dialogue: 0,0:33:58.35,0:34:01.35,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:34:01.35,0:34:03.35,Default,,0,0,0,,Келіңізші, өтінемін!
Dialogue: 0,0:34:03.35,0:34:06.36,Default,,0,0,0,,Селин Дион ең жақсы!
Dialogue: 0,0:34:06.36,0:34:09.36,Default,,0,0,0,,Аммммммммммм...
Dialogue: 0,0:34:09.36,0:34:13.36,Default,,0,0,0,,Аммммммммммммммм
Dialogue: 0,0:34:13.36,0:34:15.37,Default,,0,0,0,,≪(Жартылай қоңырау дыбысы) Ха!
Dialogue: 0,0:34:15.37,0:34:20.31,Default,,0,0,0,,≪(Жартылай қоңырау дыбысы)
Dialogue: 0,0:34:20.31,0:34:22.31,Default,,0,0,0,,Сіз енді тамақ ішпейсіз бе?
Dialogue: 0,0:34:22.31,0:34:25.31,Default,,0,0,0,,Чиёме-чан көп жемейді, иә?
Dialogue: 0,0:34:25.31,0:34:28.31,Default,,0,0,0,,Оланың анасы құрсағында жатқанда...
Dialogue: 0,0:34:30.32,0:34:32.32,Default,,0,0,0,,Мен емес ⇒
Dialogue: 0,0:34:32.32,0:34:36.32,Default,,0,0,0,,Сіздің асқазаныңыздағы бала тамақ жегісі келетінін айтады.
Dialogue: 0,0:34:36.32,0:34:40.33,Default,,0,0,0,,Нимпу Бұл ашкөздіктің әдісі болды Амуамуаму...
Dialogue: 0,0:34:40.33,0:34:44.33,Default,,0,0,0,,Хехехе, онда мен Химавари-чанның үлкен жегіш екеніне сенімдімін.
Dialogue: 0,0:34:44.33,0:34:47.33,Default,,0,0,0,,Мүмкін~ ≪(тықылдату)
Dialogue: 0,0:34:47.33,0:34:50.34,Default,,0,0,0,,Жел диірмені
Dialogue: 0,0:34:50.34,0:34:53.34,Default,,0,0,0,,Ақсақалдың бұйыруы Чинзоға ⇒ қарауға
Dialogue: 0,0:34:53.34,0:34:56.34,Default,,0,0,0,,Мен сені ниндзя балабақшасынан алып кетуге келдім.
Dialogue: 0,0:34:56.34,0:34:59.34,Default,,0,0,0,,Хохо, сенің еңбектерің, еңбектерің.
Dialogue: 0,0:34:59.34,0:35:02.35,Default,,0,0,0,,Сіз сирек кездесетін қазынасыз ба?
Dialogue: 0,0:35:02.35,0:35:04.35,Default,,0,0,0,,Ола Шинно Нохара...
Dialogue: 0,0:35:04.35,0:35:06.35,Default,,0,0,0,,Бұл Икусо Какуречино.
Dialogue: 0,0:35:06.35,0:35:08.35,Default,,0,0,0,,Сәл күте тұрыңыз, мен дайындаймын.
Dialogue: 0,0:35:08.35,0:35:11.35,Default,,0,0,0,,Иә? Тезірек, кешігіп қаласыз.
Dialogue: 0,0:35:14.36,0:35:16.36,Default,,0,0,0,,Сақ болыңыз...
Dialogue: 0,0:35:16.36,0:35:21.30,Default,,0,0,0,,Хой иттеки макарон краб граттан
Dialogue: 0,0:35:21.30,0:35:24.30,Default,,0,0,0,,Шаян шаян~ Шаян шаян~
Dialogue: 0,0:35:32.31,0:35:36.31,Default,,0,0,0,,Н… нн… н…
Dialogue: 0,0:35:39.32,0:35:42.32,Default,,0,0,0,,Қалғаны өтінемін
Dialogue: 0,0:35:42.32,0:35:45.32,Default,,0,0,0,,(тауық айқайы)
Dialogue: 0,0:35:45.32,0:35:49.33,Default,,0,0,0,,Коккоккоккоккоккок…
Dialogue: 0,0:35:49.33,0:35:54.33,Default,,0,0,0,,Кококкоккоккоккоккоккоккок…
Dialogue: 0,0:35:54.33,0:35:57.34,Default,,0,0,0,,Нинпо дегеніміз не?⇒
Dialogue: 0,0:35:57.34,0:36:01.34,Default,,0,0,0,,Жерден денеге алынған Нинтльді қолдану
Dialogue: 0,0:36:01.34,0:36:04.34,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:36:04.34,0:36:07.34,Default,,0,0,0,,Тіпті Чинзо (Ямачио) Эй?
Dialogue: 0,0:36:10.35,0:36:13.35,Default,,0,0,0,,Кейде мен үлкен аңды шақырамын...
Dialogue: 0,0:36:13.35,0:36:15.35,Default,,0,0,0,,Хмф!
Dialogue: 0,0:36:15.35,0:36:17.36,Default,,0,0,0,,О? (Sensei Ninja) Бұл жаттығу, бірақ⇒
Dialogue: 0,0:36:17.36,0:36:20.29,Default,,0,0,0,,Рандориде оңай жүрмеңіз!
Dialogue: 0,0:36:20.29,0:36:22.29,Default,,0,0,0,,Кір жуу? О?
Dialogue: 0,0:36:22.29,0:36:25.29,Default,,0,0,0,,Сәттілік! Фуко~!
Dialogue: 0,0:36:27.30,0:36:30.30,Default,,0,0,0,,Кеттік! Нинпо Ханабубуки!
Dialogue: 0,0:36:30.30,0:36:33.30,Default,,0,0,0,,О? О құдайым-ай!
Dialogue: 0,0:36:33.30,0:36:35.31,Default,,0,0,0,,Фуко күткендей! (Ямачио) Осы балабақшада ⇒
Dialogue: 0,0:36:35.31,0:36:37.31,Default,,0,0,0,,Фуконы жеңетін ешкім жоқ.
Dialogue: 0,0:36:37.31,0:36:39.31,Default,,0,0,0,,Қазір! Бар!
Dialogue: 0,0:36:39.31,0:36:41.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:36:41.31,0:36:44.32,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:36:44.32,0:36:48.32,Default,,0,0,0,,Менің киімім неге шешіледі!?
Dialogue: 0,0:36:48.32,0:36:50.32,Default,,0,0,0,,Нинпо! Ах
Dialogue: 0,0:36:50.32,0:36:52.32,Default,,0,0,0,,Ана (балабақша тәрбиеленушілері) күндіз а...
Dialogue: 0,0:36:52.32,0:36:54.33,Default,,0,0,0,,Нинпо! Ха!
Dialogue: 0,0:36:54.33,0:36:57.33,Default,,0,0,0,,жексенбі әке
Dialogue: 0,0:36:57.33,0:37:00.33,Default,,0,0,0,,Сіз жай ғана ұйықтап жатырсыз. Ал, онша емес.
Dialogue: 0,0:37:00.33,0:37:02.33,Default,,0,0,0,,Мен сені мақтап тұрғаным жоқ! О?
Dialogue: 0,0:37:02.33,0:37:06.34,Default,,0,0,0,,Ақымақ болма, маған мононоке но-джутсуыңды көрсет!
Dialogue: 0,0:37:06.34,0:37:09.34,Default,,0,0,0,,Басқа таңдау жоқ.
Dialogue: 0,0:37:10.34,0:37:12.34,Default,,0,0,0,,Ах…
Dialogue: 0,0:37:12.34,0:37:16.35,Default,,0,0,0,,Хмф! Чан Лин Сян
Dialogue: 0,0:37:16.35,0:37:19.35,Default,,0,0,0,,Ниндзя өнері: Мононоке тәсілі!
Dialogue: 0,0:37:19.35,0:37:21.29,Default,,0,0,0,,Жылан
Dialogue: 0,0:37:21.29,0:37:23.29,Default,,0,0,0,,Көгершін? (Барлығы) Ах...
Dialogue: 0,0:37:23.29,0:37:25.29,Default,,0,0,0,,Қарғыс атсын! Мені мазақ етпе!
Dialogue: 0,0:37:25.29,0:37:29.29,Default,,0,0,0,,Хаа! Нинпо: Ашулы жел Буки!
Dialogue: 0,0:37:29.29,0:37:32.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:37:35.30,0:37:40.30,Default,,0,0,0,,Ниндзюцу Бунджири жоқ Дзюцу! Бури Бури Бури Бури Бури Бури
Dialogue: 0,0:37:40.30,0:37:42.31,Default,,0,0,0,,Бури бури бури бури бури бури
Dialogue: 0,0:37:42.31,0:37:45.31,Default,,0,0,0,,Бури бури бури бури бури бури (балабақша тәрбиешісі) Аха, бұл не?
Dialogue: 0,0:37:45.31,0:37:47.31,Default,,0,0,0,,Біртүрлі~ (Балабақша оқушылары) Ахаха
Dialogue: 0,0:37:47.31,0:37:51.32,Default,,0,0,0,,Уау Нинпо Пу! Дәретхана ~!
Dialogue: 0,0:37:51.32,0:37:54.32,Default,,0,0,0,,Бұл не? (Балабақша оқушысы) Керісінше, ғажап.
Dialogue: 0,0:37:54.32,0:38:14.34,Default,,0,0,0,,♬～
Dialogue: 0,0:38:14.34,0:38:17.34,Default,,0,0,0,,♬～
Dialogue: 0,0:38:17.34,0:38:19.34,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:38:21.28,0:38:23.28,Default,,0,0,0,,Егер сіз мұны орындасаңыз...
Dialogue: 0,0:38:27.29,0:38:30.29,Default,,0,0,0,,Әй, кәмпиттер сатып ал (ана). Бір ғана.
Dialogue: 0,0:38:30.29,0:38:32.29,Default,,0,0,0,,Иә! Хмм
Dialogue: 0,0:38:32.29,0:38:36.29,Default,,0,0,0,,Мононокенің джуцусы ма... Чиндзо-кун да қиналып жатыр.
Dialogue: 0,0:38:36.29,0:38:38.30,Default,,0,0,0,,Жоқ, мен
Dialogue: 0,0:38:38.30,0:38:41.30,Default,,0,0,0,,Бір күні әкемнің жолын қуармын⇒
Dialogue: 0,0:38:41.30,0:38:44.30,Default,,0,0,0,,Мен әлі аңды шақыра алмаймын.
Dialogue: 0,0:38:44.30,0:38:48.31,Default,,0,0,0,,Бірақ неге екені белгісіз құлақтары мен құйрығы ғана шықты.
Dialogue: 0,0:38:48.31,0:38:51.31,Default,,0,0,0,,Ннннннннннннннннннннннннннннннннннннннннннннннннннннннннннннннннннннннннн
Dialogue: 0,0:38:54.31,0:38:57.32,Default,,0,0,0,,Уау... қаласаң мынаны же.
Dialogue: 0,0:38:57.32,0:39:00.32,Default,,0,0,0,,Иә, мен аламын.
Dialogue: 0,0:39:00.32,0:39:04.32,Default,,0,0,0,,Чинзо-кун әкесінің жолын қуғысы келе ме?
Dialogue: 0,0:39:04.32,0:39:06.32,Default,,0,0,0,,Оны мұрагерлікке алғыңыз келе ме? Өйткені⇒
Dialogue: 0,0:39:06.32,0:39:10.33,Default,,0,0,0,,Техниканы қолдана берсең, жануарға айналып, қайтып орала алмайсың, солай ма?
Dialogue: 0,0:39:10.33,0:39:12.33,Default,,0,0,0,,Иә
Dialogue: 0,0:39:12.33,0:39:16.33,Default,,0,0,0,,Мен де бір күні хайуанға айналамын деп ойлаймын.
Dialogue: 0,0:39:16.33,0:39:20.27,Default,,0,0,0,,Құлағы мен шашы қасқырға ұқсайтындықтан, қасқыр шығар.
Dialogue: 0,0:39:20.27,0:39:22.27,Default,,0,0,0,,Хам Хам Хам…
Dialogue: 0,0:39:24.28,0:39:27.28,Default,,0,0,0,,Бұл тиін емес пе? Бұл тиін.
Dialogue: 0,0:39:27.28,0:39:31.28,Default,,0,0,0,,Мисаның смартфоны жұмыс істемей тұр ма? Иә, әрқашан бір жерде
Dialogue: 0,0:39:31.28,0:39:35.29,Default,,0,0,0,,Жақсы! Күте тұрыңыз, Шинносуке!
Dialogue: 0,0:39:35.29,0:39:37.29,Default,,0,0,0,,Мен қазір барамын!
Dialogue: 0,0:39:46.30,0:39:49.30,Default,,0,0,0,,(Балалардың сөйлейтін дыбыстары)
Dialogue: 0,0:39:49.30,0:39:51.30,Default,,0,0,0,,Фуко мықты ғой.
Dialogue: 0,0:39:51.30,0:39:54.31,Default,,0,0,0,,Оны куноичиге қалдыру ысырап болар еді.
Dialogue: 0,0:39:54.31,0:39:56.31,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:40:04.32,0:40:06.32,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:40:10.32,0:40:12.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:40:12.32,0:40:15.33,Default,,0,0,0,,Менің ойымша, бұл да үлкен мәселе емес.
Dialogue: 0,0:40:15.33,0:40:17.33,Default,,0,0,0,,Әй?
Dialogue: 0,0:40:21.33,0:40:27.34,Default,,0,0,0,,Өскенде кіндік қорғауға жауапты боласың, солай ма?
Dialogue: 0,0:40:27.34,0:40:29.34,Default,,0,0,0,,Мен өскенде⇒
Dialogue: 0,0:40:29.34,0:40:33.34,Default,,0,0,0,,Нанако Они-санмен бақытты отбасын құрыңыз
Dialogue: 0,0:40:33.34,0:40:35.35,Default,,0,0,0,,Әрекет маскасы болыңыз⇒
Dialogue: 0,0:40:35.35,0:40:37.35,Default,,0,0,0,,Касукабенің тыныштығын қорға!
Dialogue: 0,0:40:37.35,0:40:40.35,Default,,0,0,0,,Бибібибі...
Dialogue: 0,0:40:40.35,0:40:42.35,Default,,0,0,0,,Мен бұл нені білдіретінін білмеймін
Dialogue: 0,0:40:42.35,0:40:45.36,Default,,0,0,0,,Фуко-чан ше? иә?
Dialogue: 0,0:40:45.36,0:40:47.36,Default,,0,0,0,,Мен...
Dialogue: 0,0:40:47.36,0:40:49.36,Default,,0,0,0,,Чоро!
Dialogue: 0,0:40:49.36,0:40:52.36,Default,,0,0,0,,Бақа, ақымақ! Мен куноичимін!
Dialogue: 0,0:40:52.36,0:40:55.36,Default,,0,0,0,,Ақсақал болу мүмкін емес...
Dialogue: 0,0:40:59.37,0:41:01.37,Default,,0,0,0,,Ола анамның смартфоны⇒
Dialogue: 0,0:41:01.37,0:41:04.38,Default,,0,0,0,,Мен оны қайтаруым керек! Әй, эй!
Dialogue: 0,0:41:04.38,0:41:09.38,Default,,0,0,0,,Қайда бара жатырсың?!
Dialogue: 0,0:41:09.38,0:41:14.39,Default,,0,0,0,,(ﾏﾅｰﾓｰﾄﾞ)
Dialogue: 0,0:41:14.39,0:41:17.39,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:41:17.39,0:41:19.39,Default,,0,0,0,,Шықпайды... Артық өтініш берсең ⇒
Dialogue: 0,0:41:19.39,0:41:22.33,Default,,0,0,0,,Екінші жағындағы батарея таусылған болуы мүмкін.
Dialogue: 0,0:41:22.33,0:41:24.33,Default,,0,0,0,,Иә...
Dialogue: 0,0:41:24.33,0:41:26.33,Default,,0,0,0,,А, ана жақта⇒
Dialogue: 0,0:41:26.33,0:41:28.33,Default,,0,0,0,,Келгенде анаммен кесіп өткен жерім осы!
Dialogue: 0,0:41:28.33,0:41:31.34,Default,,0,0,0,,Ех!
Dialogue: 0,0:41:31.34,0:41:34.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:34.34,0:41:38.34,Default,,0,0,0,,А... Менің ойымша, жақын жерде көпір жоқ.
Dialogue: 0,0:41:38.34,0:41:41.35,Default,,0,0,0,,Чинзо-кун өзеннен қалай өтті?
Dialogue: 0,0:41:41.35,0:41:46.35,Default,,0,0,0,,Нинпоны пайдалану... Мен оның осы жерде жерленгеніне сенімдімін.
Dialogue: 0,0:41:48.35,0:41:50.35,Default,,0,0,0,,Иә? Осылай ма?
Dialogue: 0,0:41:50.35,0:41:53.36,Default,,0,0,0,,Иә? Мүмкін осында? иә?
Dialogue: 0,0:41:53.36,0:41:55.36,Default,,0,0,0,,Не? Бар ма?
Dialogue: 0,0:41:55.36,0:41:57.36,Default,,0,0,0,,Бұл тиін Бұл тиін
Dialogue: 0,0:41:57.36,0:41:59.36,Default,,0,0,0,,А, мінеки!
Dialogue: 0,0:41:59.36,0:42:03.37,Default,,0,0,0,,Бұл не? Ниндзя өнері мизугумо
Dialogue: 0,0:42:03.37,0:42:06.37,Default,,0,0,0,,Егер сіз ниндзя болсаңыз, онымен суда жүруге болады.
Dialogue: 0,0:42:06.37,0:42:09.37,Default,,0,0,0,,Чинзо-кун, маған ниндзя техникасын айтшы.
Dialogue: 0,0:42:09.37,0:42:12.38,Default,,0,0,0,,Е, бұл мүмкін емес. Бұл оңай емес...
Dialogue: 0,0:42:12.38,0:42:16.38,Default,,0,0,0,,Бұл мүмкін болмаса да жасаңыз! Өйткені басқа амал жоқ
Dialogue: 0,0:42:16.38,0:42:19.38,Default,,0,0,0,,Оның үстіне су өрмекшілері екі адамға ғана жетеді...
Dialogue: 0,0:42:19.38,0:42:22.32,Default,,0,0,0,,Синносуке сізді күтуде. Жүзейік!
Dialogue: 0,0:42:22.32,0:42:26.32,Default,,0,0,0,,Бірақ анам бұл өзенде қолтырауын бар деді...
Dialogue: 0,0:42:30.33,0:42:33.33,Default,,0,0,0,,Мен қалаймын
Dialogue: 0,0:42:33.33,0:42:37.33,Default,,0,0,0,,Сәлем Химавари! Сенімен бәрі жақсы ма? Ааа!
Dialogue: 0,0:42:37.33,0:42:39.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:39.34,0:42:41.34,Default,,0,0,0,,Гррр…
Dialogue: 0,0:42:41.34,0:42:47.34,Default,,0,0,0,,Мен сізге күнделікті пойызда жұмыс істеуге барған кезде қалыптасқан тепе-теңдік сезімін көрсетемін!
Dialogue: 0,0:42:47.34,0:42:50.35,Default,,0,0,0,,Мүмкіндігінше демалу жақсы
Dialogue: 0,0:42:50.35,0:42:52.35,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:42:52.35,0:42:54.35,Default,,0,0,0,,Мен енді сол қателігімді қайталамаймын.
Dialogue: 0,0:42:54.35,0:43:04.36,Default,,0,0,0,,♬～
Dialogue: 0,0:43:04.36,0:43:08.37,Default,,0,0,0,,Уаааааа... ахах!
Dialogue: 0,0:43:08.37,0:43:12.37,Default,,0,0,0,,Иә! Ааа!
Dialogue: 0,0:43:12.37,0:43:16.37,Default,,0,0,0,,Хмм... Ха! Нннннннн…
Dialogue: 0,0:43:16.37,0:43:18.38,Default,,0,0,0,,Анна?
Dialogue: 0,0:43:18.38,0:43:21.31,Default,,0,0,0,,Энн! Анан!
Dialogue: 0,0:43:21.31,0:43:24.32,Default,,0,0,0,,Не? (Нәжіс) ♪ Нини нин нин!
Dialogue: 0,0:43:24.32,0:43:26.32,Default,,0,0,0,,Бұл не!? (нәжіс түрі) ♪ Нинини nin
Dialogue: 0,0:43:26.32,0:43:30.32,Default,,0,0,0,,Бұл адам көлеңкелі өлтіруші, Гиотебин типі.
Dialogue: 0,0:43:30.32,0:43:35.33,Default,,0,0,0,,Мен де Якухико Вадамын, мен қазір осындамын.
Dialogue: 0,0:43:35.33,0:43:38.33,Default,,0,0,0,,Тағы бір оғаш ниндзя келді.
Dialogue: 0,0:43:38.33,0:43:40.33,Default,,0,0,0,,Нәжіс жүйесі енді бүкіл дененің тесіктерін пайдаланады⇒
Dialogue: 0,0:43:40.33,0:43:43.33,Default,,0,0,0,,Жерден Нинтлдің көп мөлшерін сіңіріңіз⇒
Dialogue: 0,0:43:43.33,0:43:47.34,Default,,0,0,0,,Дене барынша шыңдалған.
Dialogue: 0,0:43:47.34,0:43:49.34,Default,,0,0,0,,Сондай-ақ... Мен орасан зор қуатты сезінемін.
Dialogue: 0,0:43:49.34,0:43:53.34,Default,,0,0,0,,Бұл кісінің өзін толық ашатын уақыты жақындап қалды⇒
Dialogue: 0,0:43:53.34,0:43:56.35,Default,,0,0,0,,Сіздің тағдырыңыз шешілді
Dialogue: 0,0:43:56.35,0:43:59.35,Default,,0,0,0,,Мен шынымен түсінбедім, бірақ қазір қашайық.
Dialogue: 0,0:43:59.35,0:44:02.35,Default,,0,0,0,,Асығыңыз! Осыны ұстаныңыз!
Dialogue: 0,0:44:02.35,0:44:05.35,Default,,0,0,0,,Не? Ау, ауырады! Уф...
Dialogue: 0,0:44:07.36,0:44:12.36,Default,,0,0,0,,Nodate қонақжайлылық ниндзя өнерін жіберіп алмаңыз!
Dialogue: 0,0:44:12.36,0:44:16.37,Default,,0,0,0,,Ой, бұл не!? Гехо, Гехо, Гехо!
Dialogue: 0,0:44:16.37,0:44:19.37,Default,,0,0,0,,Шәй ішіп, демалыңыз~ Мисэ~!
Dialogue: 0,0:44:19.37,0:44:22.31,Default,,0,0,0,,Асықсаң күл! Сатан алғыр?
Dialogue: 0,0:44:22.31,0:44:25.31,Default,,0,0,0,,Ахаха! Тоқта, сен!
Dialogue: 0,0:44:25.31,0:44:29.31,Default,,0,0,0,,♪Нини нинини нинини нинини
Dialogue: 0,0:44:36.32,0:44:38.32,Default,,0,0,0,,Кіру оңай емес.
Dialogue: 0,0:44:38.32,0:44:41.33,Default,,0,0,0,,Ақсақалдан қайтарып алу мүмкін емес.
Dialogue: 0,0:44:41.33,0:44:44.33,Default,,0,0,0,,Бұл мүмкін емес! Анам үнемі солай айтады
Dialogue: 0,0:44:44.33,0:44:49.33,Default,,0,0,0,,Сіз енді мұны істей алмаймын деп ойласаңыз да, тәттілерді қалағаныңызша жеуге болады.
Dialogue: 0,0:44:49.33,0:44:53.34,Default,,0,0,0,,Иә? Ха!
Dialogue: 0,0:44:53.34,0:44:56.34,Default,,0,0,0,,Ниндзя техникасы: Жасырын әдістер!
Dialogue: 0,0:45:03.35,0:45:06.35,Default,,0,0,0,,Олай болса, Ола да, Нинпо Досакуса но Джуцу!?
Dialogue: 0,0:45:06.35,0:45:09.35,Default,,0,0,0,,...
Dialogue: 0,0:45:09.35,0:45:13.36,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:45:13.36,0:45:16.36,Default,,0,0,0,,Сәлеметсіз бе (қақпашы)?
Dialogue: 0,0:45:16.36,0:45:18.36,Default,,0,0,0,,Мен орта мектепте оқып жүргенде бір сыныптасымның —
Dialogue: 0,0:45:20.30,0:45:22.30,Default,,0,0,0,,Иә? (Фууко) Абайсызда болма.
Dialogue: 0,0:45:22.30,0:45:24.30,Default,,0,0,0,,Білсең, үлкен бәлеге қаласың.
Dialogue: 0,0:45:24.30,0:45:27.30,Default,,0,0,0,,Онда неге менің артымнан ердің?
Dialogue: 0,0:45:27.30,0:45:30.31,Default,,0,0,0,,Саған қарау менің міндетім.
Dialogue: 0,0:45:30.31,0:45:34.31,Default,,0,0,0,,Хохо, шиноби сияқты бол.
Dialogue: 0,0:45:36.31,0:45:39.32,Default,,0,0,0,,Смартфоныңыз қайда? О?
Dialogue: 0,0:45:39.32,0:45:42.32,Default,,0,0,0,,Бұл не? (Фууко) Не ​​айтып тұрсың?
Dialogue: 0,0:45:42.32,0:45:44.32,Default,,0,0,0,,Сіздің ата-бабаларыңыз, солай ма?
Dialogue: 0,0:45:44.32,0:45:48.33,Default,,0,0,0,,Иә! Казугакуре Гомаэмонның бірінші буыны
Dialogue: 0,0:45:48.33,0:45:50.33,Default,,0,0,0,,Баяғыда жер жарылған⇒
Dialogue: 0,0:45:50.33,0:45:54.33,Default,,0,0,0,,Нинтл Жердің кіндігінен атқылай бастағанда⇒
Dialogue: 0,0:45:54.33,0:45:57.33,Default,,0,0,0,,Katon no Jutsu⇒ көмегімен балқытылған алтынды пайдалану
Dialogue: 0,0:45:57.33,0:45:59.34,Default,,0,0,0,,Өте таза алтынның үлкен мөлшерін жасаңыз⇒
Dialogue: 0,0:45:59.34,0:46:02.34,Default,,0,0,0,,Ішіңізді тығындау үшін Мононоке техникасын қолданыңыз ⇒
Dialogue: 0,0:46:02.34,0:46:06.34,Default,,0,0,0,,Әлемді жойылудан құтқарған аңызға айналған ниндзя
Dialogue: 0,0:46:06.34,0:46:09.35,Default,,0,0,0,,Барлығының арманы, иә?
Dialogue: 0,0:46:09.35,0:46:12.35,Default,,0,0,0,,Кешіріңіз, мен сіздің смартфоныңыз туралы білмеймін... Ах!
Dialogue: 0,0:46:12.35,0:46:14.35,Default,,0,0,0,,Хмм! (Ниндзя) Иә?
Dialogue: 0,0:46:14.35,0:46:17.35,Default,,0,0,0,,Хмм... (Фууко) Ха ха ха ха...
Dialogue: 0,0:46:17.35,0:46:21.29,Default,,0,0,0,,Не істеп жатырсың! Нинпо: Түсінбегендеріңізді адамдардан сұраңыз
Dialogue: 0,0:46:21.29,0:46:23.29,Default,,0,0,0,,Мұндай ниндзя заңы жоқ!
Dialogue: 0,0:46:30.30,0:46:35.30,Default,,0,0,0,,(Ниндзялар сөйлейді)
Dialogue: 0,0:46:41.31,0:46:44.31,Default,,0,0,0,,Чинзо шынымен біртүрлі екен.
Dialogue: 0,0:46:44.31,0:46:48.32,Default,,0,0,0,,Солай ма? (Фуко) Ол мен ойлағаннан мүлдем басқа.
Dialogue: 0,0:46:48.32,0:46:52.32,Default,,0,0,0,,Қалыпты ниндзя өнерін пайдалана алмайсыз ба?
Dialogue: 0,0:46:52.32,0:46:56.33,Default,,0,0,0,,Ниндзяның пайдалы әдістері: бөкседен секіру! Уау!
Dialogue: 0,0:46:56.33,0:46:58.33,Default,,0,0,0,,Тоқта! Ой және уааааааааааааааааааааа...
Dialogue: 0,0:46:58.33,0:47:01.33,Default,,0,0,0,,Ах! Ой...
Dialogue: 0,0:47:01.33,0:47:03.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:03.33,0:47:05.34,Default,,0,0,0,,А, бұл қызық болды. Қайтадан жасайық.
Dialogue: 0,0:47:05.34,0:47:08.34,Default,,0,0,0,,Бұлай етпе! ≪(Ақсақал) Вахахаха!
Dialogue: 0,0:47:08.34,0:47:12.34,Default,,0,0,0,,Иә? (Ақсақал) Хахаха!
Dialogue: 0,0:47:12.34,0:47:15.35,Default,,0,0,0,,Дахахаха! Бұл крокодил ақымақ
Dialogue: 0,0:47:15.35,0:47:19.35,Default,,0,0,0,,Жаңа кранның құрылысы аяқталуға жақын⇒
Dialogue: 0,0:47:19.35,0:47:23.29,Default,,0,0,0,,Меніңше, аса таза алтынды ары қарай кесудің қажеті жоқ.
Dialogue: 0,0:47:23.29,0:47:26.29,Default,,0,0,0,,Сараң болма, қиып кете бер.
Dialogue: 0,0:47:26.29,0:47:31.30,Default,,0,0,0,,Жаңа тығын біткеннен кейін, сіз бәрін еркін пайдалана аласыз.
Dialogue: 0,0:47:31.30,0:47:33.30,Default,,0,0,0,,Иә, мен ақылдымын.
Dialogue: 0,0:47:33.30,0:47:37.30,Default,,0,0,0,,Хмм, сигнал нашар. Жақында 5G-ге ауысуым керек пе?
Dialogue: 0,0:47:37.30,0:47:39.30,Default,,0,0,0,,≪Бес қария, бес қария!
Dialogue: 0,0:47:39.30,0:47:42.31,Default,,0,0,0,,≪Бұл не? Вахахаха! ≪(Министрлер) Хахаха!
Dialogue: 0,0:47:42.31,0:47:44.31,Default,,0,0,0,,Бұл не? Қандай сән-салтанат.
Dialogue: 0,0:47:44.31,0:47:46.31,Default,,0,0,0,,Сондай-ақ қараңыз Ола Сондай-ақ Оланы қараңыз
Dialogue: 0,0:47:46.31,0:47:50.31,Default,,0,0,0,,Күте тұрыңыз... (Ақсақал) А? Ол кім?
Dialogue: 0,0:47:50.31,0:47:53.32,Default,,0,0,0,,≪Паон! Бұл не, піл?
Dialogue: 0,0:47:53.32,0:47:55.32,Default,,0,0,0,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:47:55.32,0:47:58.32,Default,,0,0,0,,Ол алаяқ! Диа! Диа~!
Dialogue: 0,0:47:58.32,0:48:01.32,Default,,0,0,0,,Иә! (Фууко) Эй! Апыр-ай!
Dialogue: 0,0:48:03.33,0:48:06.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:48:06.33,0:48:08.33,Default,,0,0,0,,Оны таптым! (Фууко) Не ​​істеуім керек!
Dialogue: 0,0:48:08.33,0:48:10.33,Default,,0,0,0,,Маған қашып кетуге жол берме! Осындай кездерде, солай!
Dialogue: 0,0:48:10.33,0:48:14.33,Default,,0,0,0,,Ниндзя өнері: Өмір қандай болса, солай болады. Тым орынды!
Dialogue: 0,0:48:17.34,0:48:19.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:48:22.28,0:48:25.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:25.28,0:48:28.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:48:36.29,0:48:39.30,Default,,0,0,0,,О
Dialogue: 0,0:48:39.30,0:48:41.30,Default,,0,0,0,,О!
Dialogue: 0,0:48:45.30,0:48:47.30,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:48:47.30,0:48:50.31,Default,,0,0,0,,Уф... Мен шаршадым.
Dialogue: 0,0:48:50.31,0:48:54.31,Default,,0,0,0,,Ха, мынау сарайдың басы...
Dialogue: 0,0:48:54.31,0:48:57.31,Default,,0,0,0,,Ақсақалдың бөлмесі?
Dialogue: 0,0:48:57.31,0:49:00.32,Default,,0,0,0,,Ауыл сыртынан әкелінген дүниелер қаншама...
Dialogue: 0,0:49:00.32,0:49:03.32,Default,,0,0,0,,Олар бізге жоқ дейді.
Dialogue: 0,0:49:03.32,0:49:07.32,Default,,0,0,0,,О? Ой! Анамдікі!
Dialogue: 0,0:49:07.32,0:49:10.33,Default,,0,0,0,,Сен, мынаны ұстаңдар~!
Dialogue: 0,0:49:10.33,0:49:15.33,Default,,0,0,0,,♪Нини нин нин нин нин нин нин нин…
Dialogue: 0,0:49:15.33,0:49:19.34,Default,,0,0,0,,Мен қасқырмын...Қасқыр азуымды жалаңаштадым.
Dialogue: 0,0:49:19.34,0:49:21.27,Default,,0,0,0,,Рин! болат! Үзіліс!
Dialogue: 0,0:49:21.27,0:49:24.27,Default,,0,0,0,,Ниндзюцу Мононоке жоқ Джутсу!
Dialogue: 0,0:49:24.27,0:49:28.28,Default,,0,0,0,,Қарғыс атсын... Рин! болат! Үзіліс!
Dialogue: 0,0:49:28.28,0:49:32.28,Default,,0,0,0,,Мононоке жоқ Джутсу! Мононоке жоқ Джутсу! Тая! Тая! Тая!
Dialogue: 0,0:49:32.28,0:49:34.28,Default,,0,0,0,,♪Нинининин (Широ) мүмкін!
Dialogue: 0,0:49:34.28,0:49:38.29,Default,,0,0,0,,Күтіп, шай мен тәттілерді ішіңіз!
Dialogue: 0,0:49:38.29,0:49:41.29,Default,,0,0,0,,Мисае! (рингтон)
Dialogue: 0,0:49:41.29,0:49:45.30,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:49:45.30,0:49:47.30,Default,,0,0,0,,Яаааааааааааааааааааааааааааа! Ааа
Dialogue: 0,0:49:47.30,0:49:50.30,Default,,0,0,0,,Қаш, Миса! Хахахахаха!
Dialogue: 0,0:49:50.30,0:49:52.30,Default,,0,0,0,,Хяха хахаха! Әке!?
Dialogue: 0,0:49:52.30,0:49:54.30,Default,,0,0,0,,Күнбағыс Чинзо-кун
Dialogue: 0,0:49:54.30,0:49:56.31,Default,,0,0,0,,Ахаха! Хахахахаха! Әке!?
Dialogue: 0,0:49:56.31,0:49:58.31,Default,,0,0,0,,Шинно... (Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,0:49:58.31,0:50:00.31,Default,,0,0,0,,Ах…
Dialogue: 0,0:50:00.31,0:50:02.31,Default,,0,0,0,,Әке, ана!
Dialogue: 0,0:50:02.31,0:50:05.32,Default,,0,0,0,,Әке! Анашым!
Dialogue: 0,0:50:05.32,0:50:07.32,Default,,0,0,0,,Сәлем! Шинносуке!?
Dialogue: 0,0:50:07.32,0:50:11.32,Default,,0,0,0,,Шинносуке? Шинносуке! Шинносуке?
Dialogue: 0,0:50:11.32,0:50:16.32,Default,,0,0,0,,Хяхахаха! Тоқта! Уау...
Dialogue: 0,0:50:18.33,0:50:21.33,Default,,0,0,0,,Вани!?
Dialogue: 0,0:50:21.33,0:50:25.34,Default,,0,0,0,,Уайымдамаңыз! (Такухико) Уау!
Dialogue: 0,0:50:25.34,0:50:28.34,Default,,0,0,0,,Уэбби! Түсінікті!
Dialogue: 0,0:50:28.34,0:50:31.34,Default,,0,0,0,,Шын-Чан болды ма?
Dialogue: 0,0:50:31.34,0:50:35.35,Default,,0,0,0,,Сіз қателесе алмайсыз. Бұл сөзсіз Шинносуке болды.
Dialogue: 0,0:50:35.35,0:50:37.35,Default,,0,0,0,,Бұл қандай сезімде? Қалайсың? Сіз жылап жатқан жоқсыз ба?
Dialogue: 0,0:50:37.35,0:50:41.35,Default,,0,0,0,,Дұрыс тамақтандың ба? Сіз су ішесіз бе? Сіз суық емессіз бе?
Dialogue: 0,0:50:41.35,0:50:44.35,Default,,0,0,0,,Көңілді отырсың ба? О, жоқ, бұл бір сәтке ғана болды ...
Dialogue: 0,0:50:44.35,0:50:48.36,Default,,0,0,0,,Осыны айтып тұрсыз ба? Қараңыз.
Dialogue: 0,0:50:48.36,0:50:52.36,Default,,0,0,0,,♪ Нини нин нин нин нин нин нин
Dialogue: 0,0:50:52.36,0:50:56.37,Default,,0,0,0,,♪Нин нин нин!
Dialogue: 0,0:50:56.37,0:51:00.37,Default,,0,0,0,,Хмф! (2 адам) Уау!
Dialogue: 0,0:51:02.37,0:51:07.38,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:51:07.38,0:51:12.38,Default,,0,0,0,,Хун хун... (күнбағыс жылап)
Dialogue: 0,0:51:12.38,0:51:16.39,Default,,0,0,0,,Хмф! Мисае!
Dialogue: 0,0:51:16.39,0:51:20.32,Default,,0,0,0,,Хаа!
Dialogue: 0,0:51:20.32,0:51:23.33,Default,,0,0,0,,Иә? Уф...
Dialogue: 0,0:51:23.33,0:51:27.33,Default,,0,0,0,,Ахх... (әдемі) Ахахха!
Dialogue: 0,0:51:27.33,0:51:29.33,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:51:29.33,0:51:32.34,Default,,0,0,0,,Кү…
Dialogue: 0,0:51:32.34,0:51:34.34,Default,,0,0,0,,Тая~
Dialogue: 0,0:51:34.34,0:51:36.34,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:51:36.34,0:51:40.34,Default,,0,0,0,,Ха! Хмф! Жеңілдік! (Әдемі) Хаха Ахаха!
Dialogue: 0,0:51:40.34,0:51:43.35,Default,,0,0,0,,Ах! Кяхаха
Dialogue: 0,0:51:43.35,0:51:47.35,Default,,0,0,0,,Ахахха! (нәжіс) Уау!
Dialogue: 0,0:51:47.35,0:51:50.35,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:51:50.35,0:51:53.35,Default,,0,0,0,,Вааа!
Dialogue: 0,0:51:55.36,0:51:59.36,Default,,0,0,0,,Аха! Ахахха!
Dialogue: 0,0:51:59.36,0:52:01.37,Default,,0,0,0,,Тая~ (2 адам) Бұл кім?
Dialogue: 0,0:52:01.37,0:52:03.37,Default,,0,0,0,,Анау әдемі жігіт... А?
Dialogue: 0,0:52:03.37,0:52:08.37,Default,,0,0,0,,Ал... Әйтеуір, аман қалдым. Қазір асығайық.
Dialogue: 0,0:52:08.37,0:52:11.38,Default,,0,0,0,,Әкесі… Анасы…
Dialogue: 0,0:52:11.38,0:52:13.38,Default,,0,0,0,,≪(Ақсақал) Менің бөлмем! Маған қашып кетуіме жол берме!
Dialogue: 0,0:52:13.38,0:52:16.38,Default,,0,0,0,,Әй, жүр! иә? иә?
Dialogue: 0,0:52:20.32,0:52:22.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:52:22.32,0:52:26.32,Default,,0,0,0,,Ниндзя қолшатыр көлігі~!
Dialogue: 0,0:52:28.33,0:52:31.33,Default,,0,0,0,,О
Dialogue: 0,0:52:31.33,0:52:33.33,Default,,0,0,0,,Муу!
Dialogue: 0,0:52:33.33,0:52:35.33,Default,,0,0,0,,Уау
Dialogue: 0,0:52:35.33,0:52:45.34,Default,,0,0,0,,♬～
Dialogue: 0,0:52:45.34,0:52:47.34,Default,,0,0,0,,Осындай кездейсоқ ниндзя техникасымен⇒
Dialogue: 0,0:52:47.34,0:52:51.35,Default,,0,0,0,,Шынымен ақсақалдан қайтардың.
Dialogue: 0,0:52:51.35,0:52:53.35,Default,,0,0,0,,Бұл анамның смартфоны.
Dialogue: 0,0:52:53.35,0:52:55.35,Default,,0,0,0,,(Кёко) Ах…
Dialogue: 0,0:52:55.35,0:53:00.36,Default,,0,0,0,,Иә? Әй, анашым!
Dialogue: 0,0:53:00.36,0:53:03.36,Default,,0,0,0,,Ахаха (Фууконың анасы) Казе-чан қош келдіңіз
Dialogue: 0,0:53:03.36,0:53:08.37,Default,,0,0,0,,Бүгін біз күріш пісіреміз (Фууко)! Алақай! Хехе
Dialogue: 0,0:53:08.37,0:53:12.37,Default,,0,0,0,,А, үйге қайт. Чинзо: Тамаша!
Dialogue: 0,0:53:12.37,0:53:14.37,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:53:14.37,0:53:17.37,Default,,0,0,0,,Дұрыс, біз де чаван муши жасайық.
Dialogue: 0,0:53:17.37,0:53:19.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:53:19.38,0:53:21.31,Default,,0,0,0,,Әкем де бақытты болады (Фуконың анасы) Иә.
Dialogue: 0,0:53:21.31,0:53:24.31,Default,,0,0,0,,Маған көмектесе аласыз ба? (Фууко) Иә
Dialogue: 0,0:53:24.31,0:53:29.31,Default,,0,0,0,,Мен демаламын~ (Диқанның әкесі) Ой, кешіріңіз.
Dialogue: 0,0:53:32.32,0:53:34.32,Default,,0,0,0,,Бонд! Бүгін кешкі асқа не берілетінін болжа!
Dialogue: 0,0:53:38.33,0:53:41.33,Default,,0,0,0,,О? О...
Dialogue: 0,0:53:41.33,0:53:43.33,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,0:53:51.34,0:53:56.35,Default,,0,0,0,,Химавари Чинзо-кун Ахаха!
Dialogue: 0,0:53:56.35,0:54:00.35,Default,,0,0,0,,Сәлеметсіз бе, әке?
Dialogue: 0,0:54:03.35,0:54:06.36,Default,,0,0,0,,(Үлкен арыстанның жорғалауы)
Dialogue: 0,0:54:06.36,0:54:10.36,Default,,0,0,0,,О! О?
Dialogue: 0,0:54:10.36,0:54:30.31,Default,,0,0,0,,♬～
Dialogue: 0,0:54:30.31,0:54:35.32,Default,,0,0,0,,♬～
Dialogue: 0,0:54:35.32,0:54:38.32,Default,,0,0,0,,Хуа… н…
Dialogue: 0,0:54:42.33,0:54:47.33,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:54:47.33,0:54:50.33,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:54:50.33,0:54:54.34,Default,,0,0,0,,Сіз өте мықтысыз. Сіз әлсіз немесе өзімшіл ештеңе айтпайсыз.
Dialogue: 0,0:54:54.34,0:54:58.34,Default,,0,0,0,,Менің ойымша, сіз көп нәрсені ұстап тұрсыз.
Dialogue: 0,0:54:58.34,0:55:01.34,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:55:01.34,0:55:03.35,Default,,0,0,0,,Әй... Эй⇒
Dialogue: 0,0:55:03.35,0:55:06.35,Default,,0,0,0,,Шинносуке хайуанға айналса, сен не істер едің?
Dialogue: 0,0:55:06.35,0:55:08.35,Default,,0,0,0,,Не? Горилла?
Dialogue: 0,0:55:08.35,0:55:12.36,Default,,0,0,0,,Ата-ана мен бала төбелессе, жеңе алмайды деп ойлаймын.
Dialogue: 0,0:55:12.36,0:55:15.36,Default,,0,0,0,,Фуфуфуфу (Чинзоу) Әкесі...
Dialogue: 0,0:55:21.30,0:55:26.30,Default,,0,0,0,,Есіңде ме? Сізге Шинносуке бірінші рет қоңырау шалды
Dialogue: 0,0:55:26.30,0:55:31.31,Default,,0,0,0,,Ұмыту мүмкін емес, өйткені мен сені әке деп айта алмаймын...
Dialogue: 0,0:55:31.31,0:55:34.31,Default,,0,0,0,,Ова Ова
Dialogue: 0,0:55:34.31,0:55:36.31,Default,,0,0,0,,Мені айтып тұрсың ба?
Dialogue: 0,0:55:36.31,0:55:39.32,Default,,0,0,0,,Ова Ахаха мен солай ойлаймын.
Dialogue: 0,0:55:39.32,0:55:43.32,Default,,0,0,0,,Шинносуке~ Шин-чан, анаң ше?
Dialogue: 0,0:55:43.32,0:55:45.32,Default,,0,0,0,,Айджин Неге!
Dialogue: 0,0:55:45.32,0:55:49.33,Default,,0,0,0,,А... хахаха!
Dialogue: 0,0:55:49.33,0:55:52.33,Default,,0,0,0,,Шинносуке~ Хэхе
Dialogue: 0,0:55:57.33,0:56:00.34,Default,,0,0,0,,О!
Dialogue: 0,0:56:00.34,0:56:02.34,Default,,0,0,0,,Шинносуке~
Dialogue: 0,0:56:07.34,0:56:09.35,Default,,0,0,0,,Ааа
Dialogue: 0,0:56:09.35,0:56:11.35,Default,,0,0,0,,Шинносуке!
Dialogue: 0,0:56:11.35,0:56:14.35,Default,,0,0,0,,«Шинносуке»
Dialogue: 0,0:56:17.35,0:56:19.35,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:56:21.29,0:56:24.29,Default,,0,0,0,,Шинносуке! О?
Dialogue: 0,0:56:27.30,0:56:29.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:33.30,0:56:36.30,Default,,0,0,0,,Шинносуке~ Ой?
Dialogue: 0,0:56:38.31,0:56:40.31,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:56:45.32,0:56:47.32,Default,,0,0,0,,Шинносуке!
Dialogue: 0,0:56:47.32,0:56:49.32,Default,,0,0,0,,Шинчан
Dialogue: 0,0:56:49.32,0:56:51.32,Default,,0,0,0,,Шинносуке!
Dialogue: 0,0:56:51.32,0:56:53.32,Default,,0,0,0,,Шинносуке
Dialogue: 0,0:56:53.32,0:56:55.33,Default,,0,0,0,,Шинносуке
Dialogue: 0,0:56:55.33,0:56:57.33,Default,,0,0,0,,Шин-чан Шинносуке
Dialogue: 0,0:56:57.33,0:56:59.33,Default,,0,0,0,,Шинчан Шинносуке!
Dialogue: 0,0:56:59.33,0:57:01.33,Default,,0,0,0,,Шин-чан Шинносуке
Dialogue: 0,0:57:01.33,0:57:03.33,Default,,0,0,0,,Шинносуке Шинносуке
Dialogue: 0,0:57:03.33,0:57:05.34,Default,,0,0,0,,Шин-чан Шинносуке
Dialogue: 0,0:57:05.34,0:57:07.34,Default,,0,0,0,,Шинносуке Шин-чан
Dialogue: 0,0:57:07.34,0:57:11.34,Default,,0,0,0,,Шинносуке Шинносуке Шин-чан
Dialogue: 0,0:57:14.34,0:57:17.35,Default,,0,0,0,,Шин-чан (Хирошидің дауысы) Шинносуке
Dialogue: 0,0:57:17.35,0:57:19.35,Default,,0,0,0,,Ах…
Dialogue: 0,0:57:19.35,0:57:22.25,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:57:26.29,0:57:29.29,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:57:29.29,0:57:32.29,Default,,0,0,0,,Ха... орындалды.
Dialogue: 0,0:57:39.30,0:57:42.31,Default,,0,0,0,,Бұл бақылау пункті ме? (Чинзо) Иә
Dialogue: 0,0:57:42.31,0:57:45.31,Default,,0,0,0,,Тек ниндзялар өте алады.
Dialogue: 0,0:57:45.31,0:57:49.31,Default,,0,0,0,,Егер сіз осы уақытқа дейін келген болсаңыз, бұл бәрі немесе ештеңе!
Dialogue: 0,0:57:49.31,0:58:00.32,Default,,0,0,0,,♬～
Dialogue: 0,0:58:00.32,0:58:02.33,Default,,0,0,0,,(есік қағу)
Dialogue: 0,0:58:02.33,0:58:05.33,Default,,0,0,0,,Сұраймыз! Дегозару
Dialogue: 0,0:58:05.33,0:58:07.33,Default,,0,0,0,,Құпия сөз дегеніміз не? тау
Dialogue: 0,0:58:07.33,0:58:09.33,Default,,0,0,0,,Мм... Ка өзен!
Dialogue: 0,0:58:09.33,0:58:12.34,Default,,0,0,0,,Эй, бұл оңай емес... (Секишо саны) Дұрыс!
Dialogue: 0,0:58:12.34,0:58:15.34,Default,,0,0,0,,Жарайсыңдар! (Бақылау пунктінің нөмірі) 2-сұрақ
Dialogue: 0,0:58:15.34,0:58:18.34,Default,,0,0,0,,Не? (Бақылау пунктінің нөмірі) Құпия сөз дегеніміз не? Болу
Dialogue: 0,0:58:18.34,0:58:22.28,Default,,0,0,0,,Нару… Уу… Ходо Әлем
Dialogue: 0,0:58:22.28,0:58:24.28,Default,,0,0,0,,Арнайы жазғы ниндзя!
Dialogue: 0,0:58:24.28,0:58:27.28,Default,,0,0,0,,Дұрыс жауап – кіндік
Dialogue: 0,0:58:27.28,0:58:30.29,Default,,0,0,0,,Ол алаяқ! Диа Диа!
Dialogue: 0,0:58:30.29,0:58:34.29,Default,,0,0,0,,Кун... (Чинзоу) Мұнда кел!
Dialogue: 0,0:58:34.29,0:58:37.29,Default,,0,0,0,,Шүкір, мынаны маған бер!
Dialogue: 0,0:58:37.29,0:58:39.30,Default,,0,0,0,,Нинпо әкесінің шұлықтары үлкен дөңгелегі!
Dialogue: 0,0:58:39.30,0:58:41.30,Default,,0,0,0,,Уау! (Секишо нөмірі) Ух...
Dialogue: 0,0:58:41.30,0:58:44.30,Default,,0,0,0,,Уф! (Бақылау пунктінің нөмірі) Жақсы!
Dialogue: 0,0:58:44.30,0:58:46.30,Default,,0,0,0,,Сасық! Қазір!
Dialogue: 0,0:58:50.31,0:58:53.31,Default,,0,0,0,,Керемет! Ниндзя әдістерін қалай қолдануға болады?
Dialogue: 0,0:58:53.31,0:58:57.31,Default,,0,0,0,,Ата-аналар балалары үшін бәрін жасай алады.
Dialogue: 0,0:58:57.31,0:59:00.32,Default,,0,0,0,,Нинпо Ояшин! Ақымақ нәрсе айтпа⇒
Dialogue: 0,0:59:00.32,0:59:02.32,Default,,0,0,0,,Тез бол, Шинносуке... Ха
Dialogue: 0,0:59:05.32,0:59:08.32,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:59:08.32,0:59:12.32,Default,,0,0,0,,Кеттік! Нинпо әкесінің шұлықтары!
Dialogue: 0,0:59:15.33,0:59:19.34,Default,,0,0,0,,Аз уақыт болса да, мен саған қамқор болдым.
Dialogue: 0,0:59:19.34,0:59:21.24,Default,,0,0,0,,Nja
Dialogue: 0,0:59:28.28,0:59:31.28,Default,,0,0,0,,Қайда бара жатырсың? Мен Касукабеге қайтамын.
Dialogue: 0,0:59:31.28,0:59:34.28,Default,,0,0,0,,Касукабе?
Dialogue: 0,0:59:34.28,0:59:37.29,Default,,0,0,0,,Күте тұрыңыз, Икусо Какуречинзо
Dialogue: 0,0:59:37.29,0:59:39.29,Default,,0,0,0,,Шинносуке Нохара
Dialogue: 0,0:59:39.29,0:59:42.29,Default,,0,0,0,,Не? (Ниндзяны қараңыз) Инсо-Гермиттің үлкен ұлы⇒
Dialogue: 0,0:59:42.29,0:59:48.30,Default,,0,0,0,,Чинзо, солай ма? Менің атым Шинносуке Нохара!
Dialogue: 0,0:59:48.30,0:59:50.30,Default,,0,0,0,,Интрудер (Ниндзяны қараңыз) Жау
Dialogue: 0,0:59:50.30,0:59:52.30,Default,,0,0,0,,Кокс! Коко коко…
Dialogue: 0,0:59:52.30,0:59:55.31,Default,,0,0,0,,Ko! Әтеш!
Dialogue: 0,0:59:55.31,0:59:58.31,Default,,0,0,0,,Кокс
Dialogue: 0,0:59:58.31,1:00:00.31,Default,,0,0,0,,Ааа!?
Dialogue: 0,1:00:00.31,1:00:04.31,Default,,0,0,0,,Ниндзяның манипуляция өнері!
Dialogue: 0,1:00:04.31,1:00:06.31,Default,,0,0,0,,Шинносуке-сан, қаш!
Dialogue: 0,1:00:15.33,1:00:18.33,Default,,0,0,0,,♪ (Ойын музыкасы) (Репортаждық ниндзя) Ақсақал, ауылда бір қаскүнем бар.
Dialogue: 0,1:00:18.33,1:00:20.33,Default,,0,0,0,,Не!
Dialogue: 0,1:00:20.33,1:00:22.33,Default,,0,0,0,,Нохара⇒ атты отбасы
Dialogue: 0,1:00:22.33,1:00:24.33,Default,,0,0,0,,Олар Шинносуке деген баланы іздеп жүрген сияқты.
Dialogue: 0,1:00:24.33,1:00:27.34,Default,,0,0,0,,Көлеңкелік өлтіруші, сіз сәтсіздікке ұшырадыңыз ба?
Dialogue: 0,1:00:27.34,1:00:30.34,Default,,0,0,0,,(Дыбысты сақтау)
Dialogue: 0,1:00:30.34,1:00:35.34,Default,,0,0,0,,Түтінді көтер! Біз оларды еш нәрсеге қарамастан ұстауымыз керек!
Dialogue: 0,1:00:42.35,1:00:44.35,Default,,0,0,0,,Вууу Чинзо…
Dialogue: 0,1:00:44.35,1:00:47.36,Default,,0,0,0,,(жартылай қоңырау дыбысы)
Dialogue: 0,1:00:47.36,1:00:50.36,Default,,0,0,0,,Ола ла ла ла!
Dialogue: 0,1:00:50.36,1:00:53.36,Default,,0,0,0,,Дааа! (Ниндзя) Уау!
Dialogue: 0,1:00:53.36,1:00:56.37,Default,,0,0,0,,Тоқта, бұл адамдар бізге жау емес!
Dialogue: 0,1:00:56.37,1:00:58.37,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:58.37,1:01:01.37,Default,,0,0,0,,Шинносуке! Шин Чан!
Dialogue: 0,1:01:01.37,1:01:04.37,Default,,0,0,0,,Ха ха ха... Уау уа!
Dialogue: 0,1:01:09.38,1:01:12.38,Default,,0,0,0,,О...
Dialogue: 0,1:01:12.38,1:01:14.38,Default,,0,0,0,,≪Шинносуке~!
Dialogue: 0,1:01:14.38,1:01:18.39,Default,,0,0,0,,О? Әке? ≪Шинчан!
Dialogue: 0,1:01:18.39,1:01:20.29,Default,,0,0,0,,Ана
Dialogue: 0,1:01:22.33,1:01:25.33,Default,,0,0,0,,Тая~! Шинносуке!
Dialogue: 0,1:01:25.33,1:01:28.33,Default,,0,0,0,,Әке! Анашым!
Dialogue: 0,1:01:28.33,1:01:32.34,Default,,0,0,0,,Уақыт! Широ! Ой...
Dialogue: 0,1:01:32.34,1:01:34.34,Default,,0,0,0,,Әке! Анашым!
Dialogue: 0,1:01:34.34,1:01:37.34,Default,,0,0,0,,Шинносуке! Ораора Ораора!
Dialogue: 0,1:01:37.34,1:01:39.34,Default,,0,0,0,,Нинпо әкесінің шұлықтары!
Dialogue: 0,1:01:39.34,1:01:41.34,Default,,0,0,0,,Ой! Әкемнің аяқ киімі!
Dialogue: 0,1:01:41.34,1:01:43.35,Default,,0,0,0,,Фуга!? Әкенің жалаң аяқ!
Dialogue: 0,1:01:43.35,1:01:49.35,Default,,0,0,0,,Ниндзя анасының ақымақ күші!
Dialogue: 0,1:01:49.35,1:01:51.35,Default,,0,0,0,,Шинносуке! Шин Чан!
Dialogue: 0,1:01:51.35,1:01:55.35,Default,,0,0,0,,Бұл ниндзяның ата-ана болу өнері...
Dialogue: 0,1:02:02.37,1:02:06.37,Default,,0,0,0,,Ха, Шинносуке... А!?
Dialogue: 0,1:02:06.37,1:02:08.37,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,1:02:13.38,1:02:17.38,Default,,0,0,0,,А? Уау?
Dialogue: 0,1:02:17.38,1:02:20.28,Default,,0,0,0,,Шин-чан! Ах...
Dialogue: 0,1:02:24.32,1:02:28.32,Default,,0,0,0,,Уф... Шинносуке, кешігіп келгенім үшін кешіріңіз.
Dialogue: 0,1:02:28.32,1:02:33.33,Default,,0,0,0,,Шинносуке... Горилла болсаң да, жарайды ⇒
Dialogue: 0,1:02:33.33,1:02:36.33,Default,,0,0,0,,Олар нағыз ата-ана ма, жоқ па ⇒
Dialogue: 0,1:02:36.33,1:02:40.34,Default,,0,0,0,,Бұл маңызды емес! Сенсіз мағынасыз!
Dialogue: 0,1:02:40.34,1:02:45.34,Default,,0,0,0,,Шинносуке... Уау?
Dialogue: 0,1:02:45.34,1:02:48.34,Default,,0,0,0,,Бұдан былай мен...⇒
Dialogue: 0,1:02:48.34,1:02:52.35,Default,,0,0,0,,Мен сенімен бірге жылағым да, күлкім келеді...
Dialogue: 0,1:02:52.35,1:02:54.35,Default,,0,0,0,,Қазір, оның орнына…
Dialogue: 0,1:02:54.35,1:02:57.35,Default,,0,0,0,,Гориллалар күледі ме? (2 адам) Иә!?
Dialogue: 0,1:02:59.36,1:03:02.36,Default,,0,0,0,,Мен әкемнің гориллаларды сонша жақсы көретінін білмедім⇒
Dialogue: 0,1:03:02.36,1:03:04.36,Default,,0,0,0,,Мен мұны білмедім.
Dialogue: 0,1:03:04.36,1:03:08.36,Default,,0,0,0,,Шинносуке! Әке! Анашым!
Dialogue: 0,1:03:08.36,1:03:10.37,Default,,0,0,0,,Шинносуке!
Dialogue: 0,1:03:10.37,1:03:12.37,Default,,0,0,0,,Уууу…
Dialogue: 0,1:03:15.37,1:03:17.37,Default,,0,0,0,,Тер сияқты иіс~
Dialogue: 0,1:03:17.37,1:03:20.31,Default,,0,0,0,,Тітіркендіреді, шыда.
Dialogue: 0,1:03:20.31,1:03:22.31,Default,,0,0,0,,Энн! Тая~
Dialogue: 0,1:03:22.31,1:03:25.31,Default,,0,0,0,,Энн! Энн!
Dialogue: 0,1:03:25.31,1:03:28.31,Default,,0,0,0,,Куун Куун
Dialogue: 0,1:03:31.32,1:03:34.32,Default,,0,0,0,,А, қуғыншылар келе жатыр!
Dialogue: 0,1:03:37.33,1:03:39.33,Default,,0,0,0,,Уа (Ниндзя) Гуа!
Dialogue: 0,1:03:39.33,1:03:43.33,Default,,0,0,0,,Сәлем! Апыр-ай!
Dialogue: 0,1:03:43.33,1:03:46.34,Default,,0,0,0,,Анашым! Чинзо барлығы⇒
Dialogue: 0,1:03:46.34,1:03:48.34,Default,,0,0,0,,Тез кел!
Dialogue: 0,1:03:53.34,1:03:56.35,Default,,0,0,0,,Біз сізді бақылау нүктесін айналып өтуге мүмкіндік беретін бос орынға бағыттаймыз.
Dialogue: 0,1:03:56.35,1:03:58.35,Default,,0,0,0,,Сізді тауып алмас үшін абайлап жасырыңыз...
Dialogue: 0,1:03:58.35,1:04:02.35,Default,,0,0,0,,Не айтқыңыз келетінін түсіндіріңіз!
Dialogue: 0,1:04:02.35,1:04:06.36,Default,,0,0,0,,Бұл болғаны үшін кешіріңіз...
Dialogue: 0,1:04:06.36,1:04:09.36,Default,,0,0,0,,Шатасу – өтірік.
Dialogue: 0,1:04:09.36,1:04:11.36,Default,,0,0,0,,Менің ойымша, ...
Dialogue: 0,1:04:11.36,1:04:16.37,Default,,0,0,0,,Бірақ сол ауруханада бір күні босанғаным рас.
Dialogue: 0,1:04:16.37,1:04:18.37,Default,,0,0,0,,Ол кезде маған осы ауылда жасалған бұйымдар ұнайтын⇒
Dialogue: 0,1:04:18.37,1:04:21.30,Default,,0,0,0,,Мен сыртта сату миссиясындамын⇒
Dialogue: 0,1:04:21.30,1:04:25.31,Default,,0,0,0,,Мен кенеттен толғағым шығып, ауруханаға жеткізілдім.
Dialogue: 0,1:04:25.31,1:04:27.31,Default,,0,0,0,,Мен сонда көрген Нохаралар⇒
Dialogue: 0,1:04:27.31,1:04:30.31,Default,,0,0,0,,Олар қарапайым, қарапайым отбасы сияқты.
Dialogue: 0,1:04:30.31,1:04:32.32,Default,,0,0,0,,Сіз жекпе-жекті сатасыз ба?
Dialogue: 0,1:04:32.32,1:04:34.32,Default,,0,0,0,,Ол шынымен бақытты көрінеді...
Dialogue: 0,1:04:36.32,1:04:38.32,Default,,0,0,0,,Осы ауылдағы еркіндік⇒
Dialogue: 0,1:04:38.32,1:04:42.33,Default,,0,0,0,,Өзіңе ұнайтын іспен күн көретін жер жоқ.
Dialogue: 0,1:04:42.33,1:04:45.33,Default,,0,0,0,,Әсіресе осы балаға, кіндік тығынын қорғау үшін⇒
Dialogue: 0,1:04:45.33,1:04:48.33,Default,,0,0,0,,Сіз бүкіл өміріңізді арнауыңыз керек
Dialogue: 0,1:04:48.33,1:04:51.33,Default,,0,0,0,,Нохара мырза сияқты отбасында өмір сүре алсам⇒
Dialogue: 0,1:04:51.33,1:04:56.33,Default,,0,0,0,,Мен Чинзо да бақытты болар деп ойладым...
Dialogue: 0,1:04:59.34,1:05:02.35,Default,,0,0,0,,Анашым, мен...
Dialogue: 0,1:05:02.35,1:05:04.35,Default,,0,0,0,,Mononoke no Jutsu⇒ қолданбай
Dialogue: 0,1:05:04.35,1:05:07.35,Default,,0,0,0,,Жердің кіндігін қорғайтын жол бар емес пе?
Dialogue: 0,1:05:07.35,1:05:12.36,Default,,0,0,0,,Иә, болуы керек.
Dialogue: 0,1:05:12.36,1:05:16.36,Default,,0,0,0,,Менің қарынымның барын жасырын түрде жария ету⇒
Dialogue: 0,1:05:16.36,1:05:19.36,Default,,0,0,0,,Атақты ғалымға тергеу жүргізуді сұрап хат жазыңыз⇒
Dialogue: 0,1:05:19.36,1:05:23.30,Default,,0,0,0,,Мононокенің орнында кіндік қорғайтын қуыршақ та бар...
Dialogue: 0,1:05:23.30,1:05:26.30,Default,,0,0,0,,Бірақ ақсақал рұқсат бермейді.
Dialogue: 0,1:05:26.30,1:05:29.31,Default,,0,0,0,,Бұл кіндік қорғап қалған ауыл.
Dialogue: 0,1:05:29.31,1:05:33.31,Default,,0,0,0,,Ол рөлден бас тарту оңай емес.
Dialogue: 0,1:05:33.31,1:05:37.31,Default,,0,0,0,,Жердің кіндігі соншалықты ғажап па?
Dialogue: 0,1:05:37.31,1:05:40.32,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,1:05:40.32,1:05:42.32,Default,,0,0,0,,Бұл жердің кіндігі.
Dialogue: 0,1:05:44.32,1:05:47.32,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,1:05:47.32,1:05:50.33,Default,,0,0,0,,Гориллалар өте керемет!
Dialogue: 0,1:05:50.33,1:05:53.33,Default,,0,0,0,,Чинзо-кунның әкесі үлкен, солай емес пе?
Dialogue: 0,1:05:53.33,1:05:55.33,Default,,0,0,0,,Жоқ, бұл горилла.
Dialogue: 0,1:05:55.33,1:05:57.33,Default,,0,0,0,,Әкесі - кіші горилла
Dialogue: 0,1:05:57.33,1:05:59.34,Default,,0,0,0,,А...
Dialogue: 0,1:05:59.34,1:06:01.34,Default,,0,0,0,,Тесік кіндіктің артында.
Dialogue: 0,1:06:01.34,1:06:04.34,Default,,0,0,0,,Қараңғы түскенше күтіңіз де, ауылға барыңыз... (Менеджер) Нинпо Жерге барыңыз!
Dialogue: 0,1:06:04.34,1:06:06.34,Default,,0,0,0,,Уау!
Dialogue: 0,1:06:06.34,1:06:09.35,Default,,0,0,0,,Иә? Жеңілдік! Бұл не!?
Dialogue: 0,1:06:09.35,1:06:11.35,Default,,0,0,0,,Жоқ! (Ақсақал) Иә, талай рет ⇒
Dialogue: 0,1:06:11.35,1:06:16.35,Default,,0,0,0,,Мен сені қашып құтыла алмаймын, бастық қария.
Dialogue: 0,1:06:16.35,1:06:18.35,Default,,0,0,0,,Анашым! Шин Чан!
Dialogue: 0,1:06:18.35,1:06:22.29,Default,,0,0,0,,Сізге Mononoke no Jutsu қолданбасын пайдалана алатын адам ғана қажет.
Dialogue: 0,1:06:22.29,1:06:24.29,Default,,0,0,0,,Қауіптілер өлсін
Dialogue: 0,1:06:24.29,1:06:27.30,Default,,0,0,0,,Ақсақал, соншалықты алысқа бармасаңыз да...
Dialogue: 0,1:06:27.30,1:06:30.30,Default,,0,0,0,,Нинпо Өте үлкен ақша үйіндісі!
Dialogue: 0,1:06:34.30,1:06:37.31,Default,,0,0,0,,Тоқтаңыз! Бұл адамдар маңызды емес!
Dialogue: 0,1:06:37.31,1:06:39.31,Default,,0,0,0,,Ал анау бала... уф.
Dialogue: 0,1:06:39.31,1:06:41.31,Default,,0,0,0,,Анашым! Эй, тоқта!
Dialogue: 0,1:06:41.31,1:06:44.31,Default,,0,0,0,,Уау! Не... бұл не!?
Dialogue: 0,1:06:46.32,1:06:49.32,Default,,0,0,0,,Анашым! Әке~!
Dialogue: 0,1:06:49.32,1:06:51.32,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,1:06:54.32,1:06:58.33,Default,,0,0,0,,Чинзо Вуоххо!
Dialogue: 0,1:06:58.33,1:07:00.33,Default,,0,0,0,,Незуко! Мен төмен түсемін
Dialogue: 0,1:07:00.33,1:07:02.33,Default,,0,0,0,,(Мұрынды шұқылау дыбысы)
Dialogue: 0,1:07:02.33,1:07:05.33,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:05.33,1:07:07.34,Default,,0,0,0,,Хохохохохо?
Dialogue: 0,1:07:07.34,1:07:09.34,Default,,0,0,0,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,1:07:09.34,1:07:14.34,Default,,0,0,0,,Қарғыс атсын... Гомаэмон мырза, сіздің ішіңіз не болды!?
Dialogue: 0,1:07:16.35,1:07:19.35,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:19.35,1:07:22.29,Default,,0,0,0,,Хо-хо-хо!
Dialogue: 0,1:07:22.29,1:07:24.29,Default,,0,0,0,,Ура!
Dialogue: 0,1:07:31.29,1:07:33.29,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:35.30,1:07:37.30,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,1:07:37.30,1:07:41.30,Default,,0,0,0,,Менің өте таза алтыным! Тамая~
Dialogue: 0,1:07:41.30,1:07:45.31,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,1:07:45.31,1:07:47.31,Default,,0,0,0,,Міне, Касукабе отшашу фестивалі басталды!
Dialogue: 0,1:07:47.31,1:07:49.31,Default,,0,0,0,,Савабе-сан! (Савабе) Ах ⇒
Dialogue: 0,1:07:49.31,1:07:51.31,Default,,0,0,0,,Рахмет. Енді кеттік⇒
Dialogue: 0,1:07:51.31,1:07:54.32,Default,,0,0,0,,Қонақтарымызды ортаға шақырайық. Барлығы күтіп отыр...
Dialogue: 0,1:07:54.32,1:07:56.32,Default,,0,0,0,,Сәлем! (Ивай) Касукабенің күзетшісі⇒
Dialogue: 0,1:07:56.32,1:07:58.32,Default,,0,0,0,,Бұл Әрекет Камен.
Dialogue: 0,1:07:58.32,1:08:01.32,Default,,0,0,0,,Жоқ, жоқ, мұндай қанатты сөз еш жерде жоқ.
Dialogue: 0,1:08:01.32,1:08:04.33,Default,,0,0,0,,Рұқсатсыз бекітпеңіз! (Ивай) Мен әділеттің одақтасымын⇒
Dialogue: 0,1:08:04.33,1:08:07.33,Default,,0,0,0,,Біреуі болса, салқынырақ емес пе еді?
Dialogue: 0,1:08:07.33,1:08:09.33,Default,,0,0,0,,Иә? Ах ха...
Dialogue: 0,1:08:09.33,1:08:12.34,Default,,0,0,0,,Қараңызшы, немесе Касукабенің кәрі иті.
Dialogue: 0,1:08:12.34,1:08:14.34,Default,,0,0,0,,Мен қартайдым! Керемет емес⇒
Dialogue: 0,1:08:14.34,1:08:16.34,Default,,0,0,0,,Бірінші кезекте қанатты сөз ретінде⇒
Dialogue: 0,1:08:16.34,1:08:19.34,Default,,0,0,0,,Әрекет Камен-сан... (не) Шин-чан келмей жатыр.
Dialogue: 0,1:08:19.34,1:08:23.28,Default,,0,0,0,,Бәріміз бірге сахнаға шыға алдық.
Dialogue: 0,1:08:23.28,1:08:27.28,Default,,0,0,0,,Мен бәрібір ұмытамын, әрқашан орынды.
Dialogue: 0,1:08:27.28,1:08:30.29,Default,,0,0,0,,Бірақ мен оны асыға күттім.
Dialogue: 0,1:08:30.29,1:08:33.29,Default,,0,0,0,,Бірдеңе болды ма деп ойлаймын...
Dialogue: 0,1:08:33.29,1:08:35.29,Default,,0,0,0,,Таку!
Dialogue: 0,1:08:35.29,1:08:38.29,Default,,0,0,0,,Мен сені іздеймін! (Жоқ) Е, қазірден бастап!?
Dialogue: 0,1:08:38.29,1:08:43.30,Default,,0,0,0,,Мен сенімен барамын (neh) Оған көмектесу мүмкін емес.
Dialogue: 0,1:08:43.30,1:08:48.30,Default,,0,0,0,,Мен бармаймын! Сахна уақыты келді!
Dialogue: 0,1:08:48.30,1:08:54.31,Default,,0,0,0,,Мені жалғыз қалдырсаң, ақыры келемін. Әйтеуір, бұл ұзақ әңгіме.
Dialogue: 0,1:08:54.31,1:08:57.31,Default,,0,0,0,,Бұл ашылу актісі болса да... (Ивай) Комацуна жоқ Шалғын
Dialogue: 0,1:08:57.31,1:09:00.32,Default,,0,0,0,,Сіз өтірік айтасыз!? Мен бұл жерге жайлау екен деп келдім ⇒
Dialogue: 0,1:09:00.32,1:09:02.32,Default,,0,0,0,,Мұның бәрі Комацуна!
Dialogue: 0,1:09:06.32,1:09:08.32,Default,,0,0,0,,Аяғы ауыратын ыстық бұлақтар
Dialogue: 0,1:09:08.32,1:09:10.33,Default,,0,0,0,,Уау, ауырып тұр!
Dialogue: 0,1:09:10.33,1:09:13.33,Default,,0,0,0,,Мен мұнда келдім, өйткені ол аяғы ауырады деген, бірақ бәрібір шағып тұр!
Dialogue: 0,1:09:15.33,1:09:17.33,Default,,0,0,0,,Тұздалған сәулелер
Dialogue: 0,1:09:17.33,1:09:19.34,Default,,0,0,0,,Керемет! Егер сіз осы нұрды шашсаңыз ⇒
Dialogue: 0,1:09:19.34,1:09:21.27,Default,,0,0,0,,Күріш кебегінде кез келген көкөністі маринадтауға болады.
Dialogue: 0,1:09:21.27,1:09:23.27,Default,,0,0,0,,Қияр, баклажан және брокколи
Dialogue: 0,1:09:23.27,1:09:26.28,Default,,0,0,0,,Бұл барлығына арналған... Иә? (Ивай) О?
Dialogue: 0,1:09:26.28,1:09:29.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:29.28,1:09:33.28,Default,,0,0,0,,Ағын... жұлдыздар?
Dialogue: 0,1:09:33.28,1:09:36.29,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:36.29,1:09:40.29,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:09:44.29,1:09:47.30,Default,,0,0,0,,Иә? Уау Уау!
Dialogue: 0,1:09:47.30,1:09:49.30,Default,,0,0,0,,(құлыптау дыбысы)
Dialogue: 0,1:09:49.30,1:09:52.30,Default,,0,0,0,,Біз сізден хабар алғанша үндемеңіз.
Dialogue: 0,1:09:52.30,1:09:55.30,Default,,0,0,0,,Қиямет! (құлап түскен дыбыс)
Dialogue: 0,1:09:55.30,1:09:58.31,Default,,0,0,0,,Гррр... Уф... Жақсысың ба?
Dialogue: 0,1:09:58.31,1:10:02.31,Default,,0,0,0,,Ууу... Ууу...
Dialogue: 0,1:10:02.31,1:10:06.32,Default,,0,0,0,,Ішім шығады деп ойламаппын...
Dialogue: 0,1:10:06.32,1:10:08.32,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,1:10:10.32,1:10:13.32,Default,,0,0,0,,Бұл жаман емес пе?
Dialogue: 0,1:10:13.32,1:10:16.33,Default,,0,0,0,,Ол оны маған мақтанып көрсету үшін жасап жатыр— дәл осындай нәрсе істегісі келеді!
Dialogue: 0,1:10:16.33,1:10:21.33,Default,,0,0,0,,Енді ол түтікке ешкім байланбауы керек.
Dialogue: 0,1:10:21.33,1:10:24.33,Default,,0,0,0,,Чиёме... Мықтап ұстаңыз!
Dialogue: 0,1:10:24.33,1:10:28.34,Default,,0,0,0,,Бұл жақсы емес, солай ма? Тығын шықса, жер бүлінер еді.
Dialogue: 0,1:10:28.34,1:10:30.34,Default,,0,0,0,,Дұрыс! Ха!?
Dialogue: 0,1:10:36.35,1:10:39.35,Default,,0,0,0,,Жоқ! Тағы бір оғаш ниндзя келді!
Dialogue: 0,1:10:39.35,1:10:42.35,Default,,0,0,0,,Галанду! Ниндзя емес
Dialogue: 0,1:10:42.35,1:10:46.36,Default,,0,0,0,,Мен көптеген жылдар бойы Жердің ядролық энергиясын зерттедім.
Dialogue: 0,1:10:46.36,1:10:49.36,Default,,0,0,0,,Доктор Харано Шитагаме! (Шитадж) Әй?
Dialogue: 0,1:10:49.36,1:10:53.36,Default,,0,0,0,,Келген сен болдың. Маған хатты жіберген сен болдың.
Dialogue: 0,1:10:53.36,1:10:58.37,Default,,0,0,0,,Иә (Шитаж) Әйтеуір, дәл қазір уақытым жоқ.
Dialogue: 0,1:10:58.37,1:11:01.37,Default,,0,0,0,,Жердің негізгі энергиясын қараңыз⇒
Dialogue: 0,1:11:01.37,1:11:05.37,Default,,0,0,0,,Сіз айтатын адамдар саны өте жылдам азайып келеді.
Dialogue: 0,1:11:05.37,1:11:08.38,Default,,0,0,0,,Ол киімдерді қайдан алдың? «GAP»
Dialogue: 0,1:11:08.38,1:11:11.38,Default,,0,0,0,,Бұдан былай бүкіл әлемде ⇒
Dialogue: 0,1:11:11.38,1:11:13.38,Default,,0,0,0,,Табиғи апаттар бола бастайды
Dialogue: 0,1:11:13.38,1:11:17.39,Default,,0,0,0,,Жердің магнит өрісі жойылып, жанартаулық әрекет тоқтап, айналуы тоқтайды.
Dialogue: 0,1:11:17.39,1:11:19.39,Default,,0,0,0,,Ә!?
Dialogue: 0,1:11:19.39,1:11:23.33,Default,,0,0,0,,Ол айналуды тоқтатады ма? Мен фотоға түсіре аламын ба?
Dialogue: 0,1:11:23.33,1:11:25.33,Default,,0,0,0,,Өтінемін (ысырма дыбысы)
Dialogue: 0,1:11:25.33,1:11:28.33,Default,,0,0,0,,Жерде 8 сағат қалды.
Dialogue: 0,1:11:28.33,1:11:32.33,Default,,0,0,0,,Осы уақытқа дейін ол тесікті жаппасақ⇒
Dialogue: 0,1:11:32.33,1:11:37.34,Default,,0,0,0,,Таң енді ешқашан атпайды. Бүгін бұл планета өледі.
Dialogue: 0,1:11:37.34,1:11:39.34,Default,,0,0,0,,Гаранду (ысырма дыбысы)
Dialogue: 0,1:11:39.34,1:11:41.34,Default,,0,0,0,,Ниндзя әдістерімен бірдеңе жасай алмайсыз ба?
Dialogue: 0,1:11:41.34,1:11:44.35,Default,,0,0,0,,Үлкен горилла тығынды алуға барады.
Dialogue: 0,1:11:44.35,1:11:46.35,Default,,0,0,0,,Ннн... nn!
Dialogue: 0,1:11:46.35,1:11:50.35,Default,,0,0,0,,Әке, ол денемен Мононокенің джутсуын қолдану мүмкін емес.
Dialogue: 0,1:11:50.35,1:11:53.36,Default,,0,0,0,,Ха ха... жолы бар.
Dialogue: 0,1:11:53.36,1:11:55.36,Default,,0,0,0,,Шынымен!?
Dialogue: 0,1:11:55.36,1:11:58.36,Default,,0,0,0,,Бұл үлкен саңылауды көтере алуы керек.
Dialogue: 0,1:11:58.36,1:12:02.36,Default,,0,0,0,,Иә? Бірақ алдымен бұл жерден кетуім керек.
Dialogue: 0,1:12:02.36,1:12:04.37,Default,,0,0,0,,Тая? (Ниндзя қарашы) Бұл алаяқ!
Dialogue: 0,1:12:04.37,1:12:07.37,Default,,0,0,0,,Deae Deae~!
Dialogue: 0,1:12:07.37,1:12:10.37,Default,,0,0,0,,Бұл не!?
Dialogue: 0,1:12:10.37,1:12:13.37,Default,,0,0,0,,Ата! Жалқау!?
Dialogue: 0,1:12:15.38,1:12:17.38,Default,,0,0,0,,Хаа!
Dialogue: 0,1:12:17.38,1:12:20.32,Default,,0,0,0,,Иә! Уау...
Dialogue: 0,1:12:20.32,1:12:22.32,Default,,0,0,0,,Уау! (Намакемоно) Хмф
Dialogue: 0,1:12:24.32,1:12:27.32,Default,,0,0,0,,О! (кесілген дыбыс)
Dialogue: 0,1:12:29.33,1:12:32.33,Default,,0,0,0,,Уау... Мен мүлде жалқау емеспін.
Dialogue: 0,1:12:32.33,1:12:35.33,Default,,0,0,0,,Атам менің қожайыным.
Dialogue: 0,1:12:35.33,1:12:38.33,Default,,0,0,0,,Барлығын өзім сиқыршының рақымына бөлеп алғанмын—!
Dialogue: 0,1:12:38.33,1:12:42.34,Default,,0,0,0,,Жарайды, қарыныңызды жаңа тығынмен тығындаңыз.
Dialogue: 0,1:12:42.34,1:12:45.34,Default,,0,0,0,,Мен өте таза алтынды жинап, қайтамын.
Dialogue: 0,1:12:45.34,1:12:49.35,Default,,0,0,0,,Ақсақал, әлі біткен жоқ, әлі ерте.
Dialogue: 0,1:12:49.35,1:12:53.35,Default,,0,0,0,,Енді қолданба, қашан қолданасың? Бар!
Dialogue: 0,1:12:58.35,1:13:01.36,Default,,0,0,0,,Бұл не!?
Dialogue: 0,1:13:01.36,1:13:03.36,Default,,0,0,0,,Бұл үлкен қуыршақ Куджира-кун.
Dialogue: 0,1:13:03.36,1:13:05.36,Default,,0,0,0,,Mononoke no Jutsu⇒ қолданбай
Dialogue: 0,1:13:05.36,1:13:07.36,Default,,0,0,0,,Іш тығынын ұстау үшін жасалған.
Dialogue: 0,1:13:07.36,1:13:09.37,Default,,0,0,0,,Е! Амал жоқ, бұл⇒
Dialogue: 0,1:13:09.37,1:13:13.37,Default,,0,0,0,,Сіз саңылау жасадыңыз ба?
Dialogue: 0,1:13:13.37,1:13:16.37,Default,,0,0,0,,Иә, басқа шаруам жоқ.
Dialogue: 0,1:13:16.37,1:13:19.38,Default,,0,0,0,,Жоқ, жеткілікті. Егер мен мұны істей аламын.
Dialogue: 0,1:13:19.38,1:13:24.31,Default,,0,0,0,,Уау! Ха ха ха ха...
Dialogue: 0,1:13:24.31,1:13:28.32,Default,,0,0,0,,Жақсы... Кешіріңіз! менің адамым
Dialogue: 0,1:13:28.32,1:13:31.32,Default,,0,0,0,,Жарайды, менің әкем гориллаларды жақсы көреді.
Dialogue: 0,1:13:31.32,1:13:33.32,Default,,0,0,0,,Шулы...
Dialogue: 0,1:13:33.32,1:13:36.33,Default,,0,0,0,,Барлығы осында тығылуларыңызды өтінемін.
Dialogue: 0,1:13:36.33,1:13:38.33,Default,,0,0,0,,Мен қазір тығынды іздеп, оны аламын.
Dialogue: 0,1:13:38.33,1:13:40.33,Default,,0,0,0,,Біз де барамыз!
Dialogue: 0,1:13:40.33,1:13:43.33,Default,,0,0,0,,Не? Оны бір адам ғана басқара алады
Dialogue: 0,1:13:43.33,1:13:47.34,Default,,0,0,0,,Осылайша сіз бәрін өзіңіз жасауға тырысасыз⇒
Dialogue: 0,1:13:47.34,1:13:50.34,Default,,0,0,0,,Дәл қазір бұл қиыншылыққа айналды!
Dialogue: 0,1:13:52.34,1:13:55.34,Default,,0,0,0,,Шынымды айтсам көмек сұрай аламын ба?
Dialogue: 0,1:13:55.34,1:13:57.35,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:57.35,1:14:00.35,Default,,0,0,0,,Сіздің отбасыңыз ыдырап жатыр⇒
Dialogue: 0,1:14:00.35,1:14:02.35,Default,,0,0,0,,Саған бұл енді ұнамайды, солай ма?
Dialogue: 0,1:14:06.36,1:14:08.36,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:14:08.36,1:14:12.36,Default,,0,0,0,,Дұрыс! қалды!
Dialogue: 0,1:14:12.36,1:14:15.36,Default,,0,0,0,,(Танжиро) Уф… (Барабан соғу дыбысы)
Dialogue: 0,1:14:15.36,1:14:18.37,Default,,0,0,0,,(Барабан соғу дыбысы)
Dialogue: 0,1:14:18.37,1:14:21.30,Default,,0,0,0,,Ми~ги!
Dialogue: 0,1:14:21.30,1:14:25.31,Default,,0,0,0,,Солға~!
Dialogue: 0,1:14:25.31,1:14:28.31,Default,,0,0,0,,Сіз мұны жалғыз жасамақ болдыңыз ба?
Dialogue: 0,1:14:28.31,1:14:30.31,Default,,0,0,0,,Сіз жүктісіз!
Dialogue: 0,1:14:30.31,1:14:35.32,Default,,0,0,0,,Орташа жаттығу жасаған дұрыс дейді!
Dialogue: 0,1:14:35.32,1:14:38.32,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,1:14:38.32,1:14:40.32,Default,,0,0,0,,Дұрыс! қалды!
Dialogue: 0,1:14:40.32,1:14:43.33,Default,,0,0,0,,ортасы
Dialogue: 0,1:14:43.33,1:14:46.33,Default,,0,0,0,,О! Бұл Шинносуке⇒
Dialogue: 0,1:14:46.33,1:14:48.33,Default,,0,0,0,,Маған рұқсатсыз тиіспе! Қулық ⇒
Dialogue: 0,1:14:48.33,1:14:52.33,Default,,0,0,0,,Тек аналардың рахатын көр! Мен де жасаймын! Мен де жасаймын!
Dialogue: 0,1:14:52.33,1:14:56.34,Default,,0,0,0,,Жасасаң, істе! Мен жасаймын! Мен де көмектесемін!
Dialogue: 0,1:14:56.34,1:14:59.34,Default,,0,0,0,,Не? Сонда...
Dialogue: 0,1:14:59.34,1:15:02.34,Default,,0,0,0,,Енді, екі адам, тұтқаны бұрыңыз.
Dialogue: 0,1:15:02.34,1:15:04.35,Default,,0,0,0,,О! көкірекше!
Dialogue: 0,1:15:04.35,1:15:07.35,Default,,0,0,0,,Бураджа~! Арысып жатырсыз ба?
Dialogue: 0,1:15:07.35,1:15:10.35,Default,,0,0,0,,Кешіріңіз, жоқ~ хехехехе
Dialogue: 0,1:15:10.35,1:15:13.36,Default,,0,0,0,,Чиёме-сан, мен сені ауыстырайын ба?
Dialogue: 0,1:15:13.36,1:15:15.36,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,1:15:15.36,1:15:18.36,Default,,0,0,0,,Мисэ-сан басқару элементтерін алғанша, И
Dialogue: 0,1:15:18.36,1:15:22.30,Default,,0,0,0,,Олай болса, тез кіндігімізді жауып, ертең қайта алайық.
Dialogue: 0,1:15:22.30,1:15:25.30,Default,,0,0,0,,Нохара отбасы және Онсогакуре отбасы!
Dialogue: 0,1:15:25.30,1:15:28.30,Default,,0,0,0,,Ертең! Тая~!
Dialogue: 0,1:15:42.32,1:15:44.32,Default,,0,0,0,,Кенеттен бүкіл әлемде⇒
Dialogue: 0,1:15:44.32,1:15:47.32,Default,,0,0,0,,Қалыпты емес құбылыстар бірінен соң бірі хабарлана бастады.
Dialogue: 0,1:15:47.32,1:15:49.32,Default,,0,0,0,,Жерден үлкен энергия⇒
Dialogue: 0,1:15:49.32,1:15:51.33,Default,,0,0,0,,Жоғалып бара жатыр ма екен... (Ер диктор) Экономикаға тигізетін әсері ⇒
Dialogue: 0,1:15:51.33,1:15:53.33,Default,,0,0,0,,Бізді (әйел диктор) кездейсоқ жер сілкіністері алаңдатады ⇒
Dialogue: 0,1:15:53.33,1:15:56.33,Default,,0,0,0,,Бұл орын алды және қазір Жапонияның метеорологиялық агенттігі оның себебін зерттеп жатыр.
Dialogue: 0,1:15:56.33,1:15:58.33,Default,,0,0,0,,Орын алған электр қуатының үзілуін қалпына келтіру мүмкіндігі әлі жоқ⇒
Dialogue: 0,1:15:58.33,1:16:00.34,Default,,0,0,0,,Тұрмай... (Әйел диктор) Әр жерде ⇒
Dialogue: 0,1:16:00.34,1:16:04.34,Default,,0,0,0,,Өсімдіктер қурап, егінге де әсер етуде.
Dialogue: 0,1:16:04.34,1:16:07.34,Default,,0,0,0,,Касукабе отшашу фестивалі өтетін жерде осы жерді басыңыз ⇒
Dialogue: 0,1:16:07.34,1:16:11.35,Default,,0,0,0,,Аспаннан түскен үлкен алтын кесекпен⇒
Dialogue: 0,1:16:11.35,1:16:13.35,Default,,0,0,0,,Турбулентті атмосфера бар
Dialogue: 0,1:16:13.35,1:16:17.35,Default,,0,0,0,,Уау! Маған көмектесші!
Dialogue: 0,1:16:17.35,1:16:19.35,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:16:19.35,1:16:21.29,Default,,0,0,0,,Масао-кун, бұл қауіпті!
Dialogue: 0,1:16:21.29,1:16:23.29,Default,,0,0,0,,Тезірек секір!
Dialogue: 0,1:16:23.29,1:16:27.30,Default,,0,0,0,,Өйткені шалбарыңызды шешіңіз! тез!
Dialogue: 0,1:16:27.30,1:16:31.30,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:16:31.30,1:16:33.30,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:16:33.30,1:16:35.30,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:16:35.30,1:16:39.31,Default,,0,0,0,,Ооо... Ооо!
Dialogue: 0,1:16:39.31,1:16:41.31,Default,,0,0,0,,Иә? Масао-кун⇒
Dialogue: 0,1:16:41.31,1:16:45.31,Default,,0,0,0,,Сіз мұздатылған күріш шарына ұқсайсыз, жақсы ма?
Dialogue: 0,1:16:45.31,1:16:47.31,Default,,0,0,0,,Шин-чан!
Dialogue: 0,1:16:49.32,1:16:51.32,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:16:51.32,1:16:53.32,Default,,0,0,0,,Масао-кун!
Dialogue: 0,1:16:55.32,1:16:58.33,Default,,0,0,0,,Шинносуке!?
Dialogue: 0,1:16:58.33,1:17:01.33,Default,,0,0,0,,Ниндзя Шинносуке Нохара Қайтадан қош келдіңіз!
Dialogue: 0,1:17:01.33,1:17:03.33,Default,,0,0,0,,Ниндзя!?
Dialogue: 0,1:17:05.33,1:17:08.34,Default,,0,0,0,,А, ертең бұлшық еттерім ауыратыны сөзсіз.
Dialogue: 0,1:17:08.34,1:17:11.34,Default,,0,0,0,,Енді кіндік тығынын жинаңыз
Dialogue: 0,1:17:14.34,1:17:19.35,Default,,0,0,0,,Әкем – горилла, ал атам – жалқау
Dialogue: 0,1:17:19.35,1:17:23.29,Default,,0,0,0,,Чинзо-кун күрделі отбасылық ортада өсті, солай емес пе?
Dialogue: 0,1:17:23.29,1:17:26.29,Default,,0,0,0,,Бәрің не істеп жүрсіңдер?
Dialogue: 0,1:17:26.29,1:17:28.29,Default,,0,0,0,,Бүгін маскалы отшашу фестивалі!
Dialogue: 0,1:17:28.29,1:17:31.29,Default,,0,0,0,,Мен сені көптен бері күттім!
Dialogue: 0,1:17:31.29,1:17:34.30,Default,,0,0,0,,Иә, дұрыс. Өйткені бұл үлкен мәселе⇒
Dialogue: 0,1:17:34.30,1:17:36.30,Default,,0,0,0,,Барлығы бірге
Dialogue: 0,1:17:36.30,1:17:38.30,Default,,0,0,0,,♪Билейік! (Балалар)♪БИ!
Dialogue: 0,1:17:38.30,1:17:42.30,Default,,0,0,0,,♪Жүректің соғуы - ең жақсы ырғақ
Dialogue: 0,1:17:42.30,1:17:48.31,Default,,0,0,0,,♪Жаңғырған аяқ дыбыстары жерді айналдырады
Dialogue: 0,1:17:48.31,1:17:50.31,Default,,0,0,0,,♪Жарайды! Мен дайынмын
Dialogue: 0,1:17:50.31,1:17:52.31,Default,,0,0,0,,Барлығыңыз атқа мініңіздер.
Dialogue: 0,1:17:52.31,1:17:55.32,Default,,0,0,0,,Жүр, кеттік! Хой~и
Dialogue: 0,1:17:55.32,1:17:57.32,Default,,0,0,0,,Шин-чан, сен соған мінесің бе?
Dialogue: 0,1:17:57.32,1:17:59.32,Default,,0,0,0,,Дұрыс (нене) Мен де мінгім келеді
Dialogue: 0,1:17:59.32,1:18:01.32,Default,,0,0,0,,Маған да ұшқыш болсын (Қазама).
Dialogue: 0,1:18:01.32,1:18:03.32,Default,,0,0,0,,Чинзо-кун?
Dialogue: 0,1:18:05.33,1:18:08.33,Default,,0,0,0,,Жоқ... Иә?
Dialogue: 0,1:18:08.33,1:18:11.33,Default,,0,0,0,,Чинзо? (Чинзо) Жоқ, жоқ, жоқ, жоқ!
Dialogue: 0,1:18:11.33,1:18:14.34,Default,,0,0,0,,Әрекет Камен Томороне Never Die Ondo барлығымен бірге ⇒
Dialogue: 0,1:18:14.34,1:18:16.34,Default,,0,0,0,,Мен билегім келеді! Мен билегім келеді! Мен билегім келеді! Мен билегім келеді!
Dialogue: 0,1:18:16.34,1:18:20.28,Default,,0,0,0,,Жоқ, менің шыдамдылық шектегішім өшіп қалған сияқты.
Dialogue: 0,1:18:20.28,1:18:24.28,Default,,0,0,0,,Мен мұны қалаймын! Мен достарыммен көп ойнағым келеді!
Dialogue: 0,1:18:24.28,1:18:27.28,Default,,0,0,0,,Мен балабақшаға барғым келеді! Мен де көбірек пицца жегім келеді!
Dialogue: 0,1:18:27.28,1:18:31.29,Default,,0,0,0,,Мен ит ұстағым келеді! Мен анам мен әкемнің қасында болғым келеді!
Dialogue: 0,1:18:31.29,1:18:34.29,Default,,0,0,0,,… …⇒
Dialogue: 0,1:18:34.29,1:18:39.29,Default,,0,0,0,,Мен тамақ жегім келеді... серуендеуге барамын...
Dialogue: 0,1:18:39.29,1:18:44.30,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,1:18:44.30,1:18:47.30,Default,,0,0,0,,Уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,1:18:47.30,1:18:51.31,Default,,0,0,0,,...
Dialogue: 0,1:18:51.31,1:18:54.31,Default,,0,0,0,,Маған ұнады!
Dialogue: 0,1:18:54.31,1:18:58.31,Default,,0,0,0,,Ішіңізді жапқаннан кейін бәріміз бірге ойнайық.
Dialogue: 0,1:19:00.32,1:19:02.32,Default,,0,0,0,,Иә!
Dialogue: 0,1:19:04.32,1:19:08.32,Default,,0,0,0,,Бұған жол берме! Ах!
Dialogue: 0,1:19:08.32,1:19:10.32,Default,,0,0,0,,Ақсақал!
Dialogue: 0,1:19:13.33,1:19:17.33,Default,,0,0,0,,...
Dialogue: 0,1:19:17.33,1:19:21.27,Default,,0,0,0,,...
Dialogue: 0,1:19:21.27,1:19:24.27,Default,,0,0,0,,Бастайық! Тығынды Katon no Jutsu⇒ көмегімен ерітіңіз
Dialogue: 0,1:19:24.27,1:19:28.27,Default,,0,0,0,,...
Dialogue: 0,1:19:33.28,1:19:36.28,Default,,0,0,0,,Ақсақал! Олай жасама⇒
Dialogue: 0,1:19:36.28,1:19:38.29,Default,,0,0,0,,...
Dialogue: 0,1:19:38.29,1:19:40.29,Default,,0,0,0,,...
Dialogue: 0,1:19:40.29,1:19:43.29,Default,,0,0,0,,Эй, сен! Сен не істеп жатырсың?
Dialogue: 0,1:19:43.29,1:19:47.30,Default,,0,0,0,,Уайымдамаңыз, қазір мен жасаған жаңа тығын болады.
Dialogue: 0,1:19:47.30,1:19:51.30,Default,,0,0,0,,Жердің кіндігін қағып ал! Мен бұғаттаймын.
Dialogue: 0,1:19:51.30,1:19:54.30,Default,,0,0,0,,1 2! 1 2! (Бағыныңқы) Ей, мен келдім.
Dialogue: 0,1:19:54.30,1:19:56.30,Default,,0,0,0,,Әлі аяқталмаған ба?
Dialogue: 0,1:19:56.30,1:19:59.31,Default,,0,0,0,,1 2! 1... (Менеджер) Тоқтауды қалай тартуға болады!
Dialogue: 0,1:19:59.31,1:20:03.31,Default,,0,0,0,,Сіз не істейсіз? (Менеджер) Бізде мұны істеуден басқа амал жоқ.
Dialogue: 0,1:20:10.32,1:20:13.32,Default,,0,0,0,,Ах…
Dialogue: 0,1:20:13.32,1:20:15.32,Default,,0,0,0,,Дұрыс...
Dialogue: 0,1:20:15.32,1:20:19.33,Default,,0,0,0,,Асығыңыз! Ешқандай да қалдырмай жинаңыз!
Dialogue: 0,1:20:19.33,1:20:22.33,Default,,0,0,0,,Не істеу керек? Менің уақытым жоқ
Dialogue: 0,1:20:22.33,1:20:25.33,Default,,0,0,0,,Егер бұл орын алса, сіз тығынды күшпен қайтара аласыз!
Dialogue: 0,1:20:27.34,1:20:30.34,Default,,0,0,0,,Мисэ-сан... Иә?
Dialogue: 0,1:20:30.34,1:20:32.34,Default,,0,0,0,,Хмм... туатын шығар...
Dialogue: 0,1:20:32.34,1:20:34.34,Default,,0,0,0,,Ә!?
Dialogue: 0,1:20:34.34,1:20:36.34,Default,,0,0,0,,(киттің ізі)
Dialogue: 0,1:20:36.34,1:20:40.34,Default,,0,0,0,,Кешіріңіз! Ол босанатын сияқты!
Dialogue: 0,1:20:42.35,1:20:46.35,Default,,0,0,0,,Осындай уақытта кешірім сұраймын...
Dialogue: 0,1:20:46.35,1:20:48.36,Default,,0,0,0,,Шындығында, мен Сиқыршылар культіне қатысты бірнеше жаңа нәрсені түсіндім
Dialogue: 0,1:20:48.36,1:20:52.36,Default,,0,0,0,,Мисэ-сан, маған көмектесші.
Dialogue: 0,1:20:52.36,1:20:56.36,Default,,0,0,0,,Осы балалардың болашағын қорғаңыз...
Dialogue: 0,1:20:56.36,1:20:58.37,Default,,0,0,0,,Сіз айттыңыз.
Dialogue: 0,1:20:58.37,1:21:02.37,Default,,0,0,0,,Бұл дүниеге келетін бала Шинносукенің ағасы⇒
Dialogue: 0,1:21:02.37,1:21:05.37,Default,,0,0,0,,Біз отбасымыз, солай ма?
Dialogue: 0,1:21:05.37,1:21:08.38,Default,,0,0,0,,А... қалғанын бізге қалдырыңыз.
Dialogue: 0,1:21:08.38,1:21:11.38,Default,,0,0,0,,Мен Куджира-кунды басқаруға үйреніп бара жатырмын.
Dialogue: 0,1:21:11.38,1:21:14.38,Default,,0,0,0,,Иә, мүмкін
Dialogue: 0,1:21:14.38,1:21:17.39,Default,,0,0,0,,Қашан кездесе аламыз? (Чиоменің қарыншалығы) Бұл ертең.
Dialogue: 0,1:21:17.39,1:21:19.39,Default,,0,0,0,,О!
Dialogue: 0,1:21:19.39,1:21:22.32,Default,,0,0,0,,Мынаны ал, мен сені шақырамын. Иә.
Dialogue: 0,1:21:22.32,1:21:25.33,Default,,0,0,0,,Чинзо-кун, анаңмен осында күт.
Dialogue: 0,1:21:25.33,1:21:29.33,Default,,0,0,0,,Жоқ, мен де барамын. иә?
Dialogue: 0,1:21:29.33,1:21:32.33,Default,,0,0,0,,Ал егер... мен...⇒
Dialogue: 0,1:21:32.33,1:21:36.34,Default,,0,0,0,,Ағам жерді бәрімен бірге қорғайды.
Dialogue: 0,1:21:36.34,1:21:41.34,Default,,0,0,0,,Тез шығып, анамды қорғаңызшы.
Dialogue: 0,1:21:41.34,1:21:43.34,Default,,0,0,0,,Иә
Dialogue: 0,1:21:46.35,1:21:51.35,Default,,0,0,0,,Чиёме хо хо хо
Dialogue: 0,1:21:51.35,1:21:53.36,Default,,0,0,0,,Иә, мен де...
Dialogue: 0,1:21:53.36,1:21:57.36,Default,,0,0,0,,Маған сирек кездесетін қазына беріңізші (Гомаэмон) Ыстық
Dialogue: 0,1:21:57.36,1:21:59.36,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,1:21:59.36,1:22:02.36,Default,,0,0,0,,Солға! дұрыс!
Dialogue: 0,1:22:02.36,1:22:05.37,Default,,0,0,0,,Солға! дұрыс!
Dialogue: 0,1:22:05.37,1:22:08.37,Default,,0,0,0,,Солға! дұрыс!
Dialogue: 0,1:22:08.37,1:22:11.37,Default,,0,0,0,,Солға! Олардан саңылауды қайтарыңыз.
Dialogue: 0,1:22:11.37,1:22:14.38,Default,,0,0,0,,Жердің кіндігіне тосқауыл қоямын!
Dialogue: 0,1:22:14.38,1:22:17.38,Default,,0,0,0,,Уау!? (Ниндзялар) Уау!
Dialogue: 0,1:22:17.38,1:22:19.38,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,1:22:19.38,1:22:23.28,Default,,0,0,0,,Гохогогохо... Гохохо...
Dialogue: 0,1:22:25.32,1:22:29.32,Default,,0,0,0,,Мм... у... Не?!
Dialogue: 0,1:22:29.32,1:22:32.33,Default,,0,0,0,,Бұл сәтсіздік. Не істеуім керек?
Dialogue: 0,1:22:32.33,1:22:36.33,Default,,0,0,0,,Гунуну... өзің ойла, қабілетсіз!
Dialogue: 0,1:22:36.33,1:22:39.33,Default,,0,0,0,,Не істеп жатырсың! Жұмысқа оралыңыз!
Dialogue: 0,1:22:39.33,1:22:42.34,Default,,0,0,0,,Бірақ... (Ақсақал) Жерге не жетсін⇒
Dialogue: 0,1:22:42.34,1:22:46.34,Default,,0,0,0,,Бұл өте таза алтынды ешкімге бермеңіз!
Dialogue: 0,1:22:46.34,1:22:49.34,Default,,0,0,0,,Ха!? Сіз не айтып жатқаныңызды білесіз бе!?
Dialogue: 0,1:22:49.34,1:22:51.35,Default,,0,0,0,,Тыныш, үндеме, үндеме!
Dialogue: 0,1:22:51.35,1:22:56.35,Default,,0,0,0,,Мұны ақшаға айналдырып, қауіпсіз жерге жүгіріңіз!
Dialogue: 0,1:22:56.35,1:22:58.35,Default,,0,0,0,,Қауіпсіз жер дегеніміз не?
Dialogue: 0,1:22:58.35,1:23:02.36,Default,,0,0,0,,Ақшаң болса, кез келген нәрсені, соның ішінде баспана сатып алуға болады.
Dialogue: 0,1:23:02.36,1:23:05.36,Default,,0,0,0,,Эй, оны Катон но Джуцумен тез ерітіп алайық!
Dialogue: 0,1:23:05.36,1:23:07.36,Default,,0,0,0,,Бірақ... Ах...
Dialogue: 0,1:23:07.36,1:23:10.37,Default,,0,0,0,,Ақсақалдың бұйрығын орындамайсың ба?
Dialogue: 0,1:23:10.37,1:23:13.37,Default,,0,0,0,,Қарғыс атсын! Ниндзя өнері өмір бойы...
Dialogue: 0,1:23:13.37,1:23:16.37,Default,,0,0,0,,Не? (Хатшы) Ол үшін уайымдамаңыз⇒
Dialogue: 0,1:23:16.37,1:23:18.37,Default,,0,0,0,,Мына бейбақ, иә?
Dialogue: 0,1:23:18.37,1:23:23.31,Default,,0,0,0,,Жердің кіндігін қорғау деп шыдадым!
Dialogue: 0,1:23:23.31,1:23:26.31,Default,,0,0,0,,Сіз өз мүддеңіз туралы естідіңіз бе?
Dialogue: 0,1:23:26.31,1:23:29.32,Default,,0,0,0,,Кунойчидің атын атамаңыз! Мен сені үрлеймін!
Dialogue: 0,1:23:29.32,1:23:31.32,Default,,0,0,0,,Нинпо Ақшаны қайтарыңыз!
Dialogue: 0,1:23:31.32,1:23:33.32,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,1:23:33.32,1:23:38.32,Default,,0,0,0,,Ниндзюцу Қарт адам аралға жер аударылды!
Dialogue: 0,1:23:41.33,1:23:44.33,Default,,0,0,0,,Ой! Ол аурады!
Dialogue: 0,1:23:44.33,1:23:48.33,Default,,0,0,0,,Ха ха ха... кешіріңіз.
Dialogue: 0,1:23:50.34,1:23:56.34,Default,,0,0,0,,Әйтсе де, мұны ауылға апаруға жол жоқ...
Dialogue: 0,1:23:56.34,1:23:59.35,Default,,0,0,0,,Берілмеңіз
Dialogue: 0,1:23:59.35,1:24:02.35,Default,,0,0,0,,Біз бұл балалардың болашағын қорғауымыз керек.
Dialogue: 0,1:24:02.35,1:24:04.35,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:04.35,1:24:06.35,Default,,0,0,0,,Мен арқанды тауып келейін.
Dialogue: 0,1:24:06.35,1:24:08.36,Default,,0,0,0,,Егер біз көліктерді жинасақ, оларды сүйреп апаруымыз мүмкін.
Dialogue: 0,1:24:08.36,1:24:11.36,Default,,0,0,0,,Мен Куджира-кун қозғала алатынын көремін.
Dialogue: 0,1:24:11.36,1:24:15.36,Default,,0,0,0,,Қырылған ультра таза алтынды бастапқы пішініне қайтарыңыз! Асығыңыз!
Dialogue: 0,1:24:15.36,1:24:18.37,Default,,0,0,0,,Үзілген арқанды қайта жалғап, тығынға қайта іліңіз!
Dialogue: 0,1:24:18.37,1:24:21.30,Default,,0,0,0,,Жақсы... Хмф!
Dialogue: 0,1:24:21.30,1:24:25.31,Default,,0,0,0,,Рин! болат! Үзіліс! (Чинзо) Әке!
Dialogue: 0,1:24:25.31,1:24:30.31,Default,,0,0,0,,Ухохо Мононоке Ухохо! Уау!
Dialogue: 0,1:24:32.31,1:24:34.32,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,1:24:34.32,1:24:36.32,Default,,0,0,0,,Ууууу... (Чинзоу) Ах...
Dialogue: 0,1:24:36.32,1:24:38.32,Default,,0,0,0,,Әке...
Dialogue: 0,1:24:38.32,1:24:41.32,Default,,0,0,0,,Өте сүйкімді! (Масао) Бұл нағыз нәрсеге ұқсайды~
Dialogue: 0,1:24:41.32,1:24:44.33,Default,,0,0,0,,Чинзо-кун да мұны істей ала ма?
Dialogue: 0,1:24:44.33,1:24:49.33,Default,,0,0,0,,А... Менің қолымнан келмейді...
Dialogue: 0,1:24:52.33,1:24:57.34,Default,,0,0,0,,Чинзо Сенің қолыңнан келетініне сенімдімін.
Dialogue: 0,1:24:57.34,1:25:01.34,Default,,0,0,0,,Бірақ Mononoke no Jutsu⇒ қолданбасын пайдалана алмасаңыз да
Dialogue: 0,1:25:01.34,1:25:05.35,Default,,0,0,0,,Чинзо - сенің әкеңнің асыл ұлы.
Dialogue: 0,1:25:05.35,1:25:07.35,Default,,0,0,0,,Әке...
Dialogue: 0,1:25:07.35,1:25:11.35,Default,,0,0,0,,Тан Тан Мен!
Dialogue: 0,1:25:11.35,1:25:13.36,Default,,0,0,0,,Ниндзя техникасы: тұздалған қиярлар!
Dialogue: 0,1:25:13.36,1:25:15.36,Default,,0,0,0,,Олардың бәрі әртүрлі, солай ма?
Dialogue: 0,1:25:15.36,1:25:18.36,Default,,0,0,0,,Эй, Чинзо-кун, бізге де айтшы.
Dialogue: 0,1:25:18.36,1:25:21.30,Default,,0,0,0,,Е, бірақ... (не) Сараң болма.
Dialogue: 0,1:25:21.30,1:25:25.30,Default,,0,0,0,,Дұрыс, бәріміз істейік (Чинзо) А...
Dialogue: 0,1:25:25.30,1:25:29.30,Default,,0,0,0,,Иә, барлығымыз, бізге қосылыңыздар!
Dialogue: 0,1:25:29.30,1:25:34.31,Default,,0,0,0,,Бұл сіздің жүрегіңіздегі аңды шақыруға арналған ниндзяның соңғы әдісі.
Dialogue: 0,1:25:34.31,1:25:38.31,Default,,0,0,0,,Рин! болат! Үзіліс! (Балалар) Рин! болат! Үзіліс!
Dialogue: 0,1:25:38.31,1:25:42.32,Default,,0,0,0,,Ниндзя өнері: Мононоке тәсілі! (Балалар) Мононоке жоқ Джутсу!
Dialogue: 0,1:25:42.32,1:25:45.32,Default,,0,0,0,,А, сен оны орындадың ба? Бұл орындалды
Dialogue: 0,1:25:45.32,1:25:47.32,Default,,0,0,0,,Орындалды!
Dialogue: 0,1:25:47.32,1:25:49.32,Default,,0,0,0,,Бұл рас! Орындалды! (Чинзо) Иә?
Dialogue: 0,1:25:49.32,1:25:52.33,Default,,0,0,0,,Ей, жарқырап тұр, мен де!
Dialogue: 0,1:25:52.33,1:25:59.33,Default,,0,0,0,,Рахмет, Чинзо-кун (Чинзо) Иә, бірақ неге...
Dialogue: 0,1:25:59.33,1:26:02.34,Default,,0,0,0,,Мононоке но Дзюцу бастапқыда ⇒ болды
Dialogue: 0,1:26:02.34,1:26:06.34,Default,,0,0,0,,Еркін балалардың ойын арқылы жасаған ниндзя әдістері
Dialogue: 0,1:26:06.34,1:26:10.35,Default,,0,0,0,,Бұл кез келген бала қолдана алатын әдіс болды.
Dialogue: 0,1:26:10.35,1:26:13.35,Default,,0,0,0,,Міне, кіндік тығыны шығып кетті⇒
Dialogue: 0,1:26:13.35,1:26:16.35,Default,,0,0,0,,Атмосфера нинтльге толы
Dialogue: 0,1:26:16.35,1:26:18.35,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:26:18.35,1:26:22.25,Default,,0,0,0,,Иә, шық, қасқырым!
Dialogue: 0,1:26:24.29,1:26:27.29,Default,,0,0,0,,Қасқыр? (Масао) Тиін?
Dialogue: 0,1:26:29.30,1:26:32.30,Default,,0,0,0,,Момонга!
Dialogue: 0,1:26:32.30,1:26:35.30,Default,,0,0,0,,Чинзо-кун, бұл Момонга болатын.
Dialogue: 0,1:26:39.31,1:26:43.31,Default,,0,0,0,,Қарашы, қарашы, менің ұшатын тиінім! Сондай сүйкімді!
Dialogue: 0,1:26:43.31,1:26:48.32,Default,,0,0,0,,Дәл менің әкемнің иісі сияқты, өте жұмсақ! Хехехе
Dialogue: 0,1:26:48.32,1:26:50.32,Default,,0,0,0,,Сонда біз де! Ооо
Dialogue: 0,1:26:50.32,1:26:52.32,Default,,0,0,0,,Мен сүйкімді қоянмын
Dialogue: 0,1:26:52.32,1:26:54.32,Default,,0,0,0,,Мен арыстанмын, хайуандардың патшасымын!
Dialogue: 0,1:26:54.32,1:26:56.32,Default,,0,0,0,,Иә!
Dialogue: 0,1:27:02.33,1:27:05.33,Default,,0,0,0,,Бенгал жолбарысы! (Масао) Мен тасбақамын ба?
Dialogue: 0,1:27:05.33,1:27:07.34,Default,,0,0,0,,Мен Нене-чанның жыртқыш екенін білемін, бірақ...
Dialogue: 0,1:27:07.34,1:27:10.34,Default,,0,0,0,,Неге! (Масао) Эй! Уф...
Dialogue: 0,1:27:10.34,1:27:13.34,Default,,0,0,0,,Мен трицератоппын! Бо~
Dialogue: 0,1:27:13.34,1:27:16.34,Default,,0,0,0,,Бо Чан күткендей...
Dialogue: 0,1:27:16.34,1:27:18.35,Default,,0,0,0,,Шошқа!?
Dialogue: 0,1:27:18.35,1:27:21.28,Default,,0,0,0,,Бұл үлкен емес, сондықтан бұл шағын шошқа, солай ма?
Dialogue: 0,1:27:21.28,1:27:23.28,Default,,0,0,0,,Тоору-чан өте сүйкімді~ Шулы!
Dialogue: 0,1:27:23.28,1:27:27.29,Default,,0,0,0,,Шошқалар таза болғанды ​​ұнатады және өте ақылды жануарлар!
Dialogue: 0,1:27:27.29,1:27:30.29,Default,,0,0,0,,Бұл үлкен шағын шошқа, ол тітіркендіргіш⇒
Dialogue: 0,1:27:30.29,1:27:33.29,Default,,0,0,0,,Казама-кунға ұқсайды Иә Иә
Dialogue: 0,1:27:33.29,1:27:36.30,Default,,0,0,0,,Синносуке - бұл! Бұл не?
Dialogue: 0,1:27:36.30,1:27:38.30,Default,,0,0,0,,О? кальмар аяқтары
Dialogue: 0,1:27:38.30,1:27:41.30,Default,,0,0,0,,Бұл сегізаяқ Неліктен ол сегізаяқ?
Dialogue: 0,1:27:41.30,1:27:44.31,Default,,0,0,0,,Менің қарным енді ашты~ (ішім ырылдап)
Dialogue: 0,1:27:44.31,1:27:47.31,Default,,0,0,0,,Қарапайым жігіт... (нене) А!
Dialogue: 0,1:27:47.31,1:27:50.31,Default,,0,0,0,,Чинзо-кун, бұл...
Dialogue: 0,1:27:50.31,1:27:53.31,Default,,0,0,0,,Ах! (Масао) Бұл не!?
Dialogue: 0,1:27:53.31,1:27:55.32,Default,,0,0,0,,О...
Dialogue: 0,1:27:55.32,1:27:58.32,Default,,0,0,0,,Ештеңе етпейді, тек джуцу⇒ қолданбасаңыз
Dialogue: 0,1:27:58.32,1:28:00.32,Default,,0,0,0,,Мен бірден келемін, Сегізаяқ.
Dialogue: 0,1:28:00.32,1:28:05.33,Default,,0,0,0,,Құрметті Шинносуке, бізде уақыт жоқ. Барлығымыз тығынды көтеріп алайық.
Dialogue: 0,1:28:05.33,1:28:07.33,Default,,0,0,0,,Сонымен, барасың ба? Иә.
Dialogue: 0,1:28:07.33,1:28:10.33,Default,,0,0,0,,Касукабе ниндзя командасы! (Балалар) Ертең!
Dialogue: 0,1:28:10.33,1:28:12.33,Default,,0,0,0,,(Жануарлардың ақыруы)
Dialogue: 0,1:28:12.33,1:28:17.34,Default,,0,0,0,,♪(Тайко барабанының орындауы Камен Ондо)
Dialogue: 0,1:28:17.34,1:28:23.28,Default,,0,0,0,,♪～
Dialogue: 0,1:28:23.28,1:28:26.28,Default,,0,0,0,,Әке! Бұл қауіпті!
Dialogue: 0,1:28:26.28,1:28:28.28,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,1:28:28.28,1:28:32.29,Default,,0,0,0,,Ішіңді жауып тастайды! иә?
Dialogue: 0,1:28:32.29,1:28:34.29,Default,,0,0,0,,Уау!
Dialogue: 0,1:28:34.29,1:28:41.30,Default,,0,0,0,,♪～
Dialogue: 0,1:28:41.30,1:28:43.30,Default,,0,0,0,,Ауыл осында!
Dialogue: 0,1:28:43.30,1:28:45.30,Default,,0,0,0,,Жолыңызды ашыңыз!
Dialogue: 0,1:28:45.30,1:28:48.30,Default,,0,0,0,,Кіндік тығыны өтеді!
Dialogue: 0,1:28:48.30,1:28:57.31,Default,,0,0,0,,♪～
Dialogue: 0,1:28:57.31,1:29:00.32,Default,,0,0,0,,Уф…!
Dialogue: 0,1:29:00.32,1:29:03.32,Default,,0,0,0,,Қауіпті! Нене Чан Бо Чан!
Dialogue: 0,1:29:03.32,1:29:07.32,Default,,0,0,0,,Кя! Жоқ~!
Dialogue: 0,1:29:07.32,1:29:11.33,Default,,0,0,0,,Ораораораораораораораораораораораора!
Dialogue: 0,1:29:11.33,1:29:18.33,Default,,0,0,0,,♪～
Dialogue: 0,1:29:18.33,1:29:20.27,Default,,0,0,0,,Сіз тіпті су астына түсе аласыз!
Dialogue: 0,1:29:20.27,1:29:25.27,Default,,0,0,0,,Ең күшті тасбақа туралы аңыз басталады! Вахахахаха!
Dialogue: 0,1:29:25.27,1:29:27.28,Default,,0,0,0,,Масао-кун, бұрын!
Dialogue: 0,1:29:27.28,1:29:30.28,Default,,0,0,0,,Ууууууууууууууууууууу!
Dialogue: 0,1:29:30.28,1:29:36.28,Default,,0,0,0,,♪～
Dialogue: 0,1:29:36.28,1:29:39.29,Default,,0,0,0,,Жақсы, Чинзо-кун!
Dialogue: 0,1:29:39.29,1:29:46.29,Default,,0,0,0,,♪～
Dialogue: 0,1:29:46.29,1:29:49.30,Default,,0,0,0,,Сіз де көмектесе аласыз, иә...
Dialogue: 0,1:29:49.30,1:29:53.30,Default,,0,0,0,,Ниндзя өнері: Мононоке тәсілі!
Dialogue: 0,1:29:53.30,1:29:56.30,Default,,0,0,0,,1 қой 2 қой ⇒
Dialogue: 0,1:29:56.30,1:29:59.31,Default,,0,0,0,,Қой... уф... ұйықтап жатқанда шығар!
Dialogue: 0,1:29:59.31,1:30:11.21,Default,,0,0,0,,♪～
Dialogue: 0,1:30:15.32,1:30:18.33,Default,,0,0,0,,Мен ниндзялар ауылын көріп тұрмын.
Dialogue: 0,1:30:18.33,1:30:21.33,Default,,0,0,0,,Ішім шыққанына сенбеймін...
Dialogue: 0,1:30:21.33,1:30:25.33,Default,,0,0,0,,Не болып жатыр... Ха
Dialogue: 0,1:30:29.34,1:30:31.34,Default,,0,0,0,,Чинзо!?
Dialogue: 0,1:30:33.34,1:30:38.35,Default,,0,0,0,,Жердің кіндігі сол (Қазама) Жарайды, бәріміз бірге боламыз.
Dialogue: 0,1:30:38.35,1:30:40.35,Default,,0,0,0,,Бо~!
Dialogue: 0,1:30:45.35,1:30:47.35,Default,,0,0,0,,Ауырсын!
Dialogue: 0,1:30:50.36,1:30:52.36,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,1:30:52.36,1:30:54.36,Default,,0,0,0,,Ах!
Dialogue: 0,1:30:54.36,1:30:57.37,Default,,0,0,0,,Уау!
Dialogue: 0,1:30:57.37,1:30:59.37,Default,,0,0,0,,Бұл...
Dialogue: 0,1:30:59.37,1:31:02.37,Default,,0,0,0,,Егер сіз тығынды көбірек күшпен итермесеңіз...
Dialogue: 0,1:31:02.37,1:31:06.37,Default,,0,0,0,,Осы уақытқа дейін келгенмен не істеуім керек...
Dialogue: 0,1:31:06.37,1:31:09.38,Default,,0,0,0,,Ммм~ Мен көмектесе алмаймын~
Dialogue: 0,1:31:09.38,1:31:12.38,Default,,0,0,0,,Тағы бір рет көрейік.
Dialogue: 0,1:31:12.38,1:31:14.38,Default,,0,0,0,,Шинносуке! (Сирек сақталады) Шинносуке-доно!
Dialogue: 0,1:31:14.38,1:31:16.38,Default,,0,0,0,,Шин-чан!
Dialogue: 0,1:31:16.38,1:31:20.32,Default,,0,0,0,,Пон Поко Рин! Ниндзюцу мононоке жоқ джуцу!
Dialogue: 0,1:31:20.32,1:31:22.32,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:31:22.32,1:31:24.33,Default,,0,0,0,,Хохоу!
Dialogue: 0,1:31:24.33,1:31:27.33,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:27.33,1:31:29.33,Default,,0,0,0,,Піл мырза?
Dialogue: 0,1:31:32.33,1:31:35.34,Default,,0,0,0,,О, Широ!
Dialogue: 0,1:31:35.34,1:31:37.34,Default,,0,0,0,,О? Ооо
Dialogue: 0,1:31:37.34,1:31:41.34,Default,,0,0,0,,♪Irohaoe Irohaoe
Dialogue: 0,1:31:41.34,1:31:44.35,Default,,0,0,0,,♪Хехехехе (Казама) Солай ма?
Dialogue: 0,1:31:44.35,1:31:47.35,Default,,0,0,0,,Широ Шин Чанның жүрегінде, солай ма?
Dialogue: 0,1:31:47.35,1:31:49.35,Default,,0,0,0,,Жарайды, тағы бір рет!
Dialogue: 0,1:31:51.35,1:31:54.36,Default,,0,0,0,,Иә!
Dialogue: 0,1:31:54.36,1:31:57.36,Default,,0,0,0,,Ха!
Dialogue: 0,1:31:57.36,1:32:00.36,Default,,0,0,0,,Нмм...
Dialogue: 0,1:32:00.36,1:32:03.36,Default,,0,0,0,,Нгу…
Dialogue: 0,1:32:03.36,1:32:07.37,Default,,0,0,0,,Нунуну... О! Ой ой!
Dialogue: 0,1:32:07.37,1:32:09.37,Default,,0,0,0,,Ол түкіріп жатқан бұл қан не?
Dialogue: 0,1:32:09.37,1:32:11.37,Default,,0,0,0,,Жоқ, сәл артық!
Dialogue: 0,1:32:11.37,1:32:13.37,Default,,0,0,0,,Нунуну…
Dialogue: 0,1:32:13.37,1:32:15.38,Default,,0,0,0,,Сәттілік! Широ!
Dialogue: 0,1:32:15.38,1:32:19.38,Default,,0,0,0,,Энн! Энн! (Хироши/Мисаэ) Солға! дұрыс! қалды!
Dialogue: 0,1:32:19.38,1:32:21.32,Default,,0,0,0,,Шинносуке!
Dialogue: 0,1:32:21.32,1:32:24.32,Default,,0,0,0,,Ол жерден кет!
Dialogue: 0,1:32:24.32,1:32:30.32,Default,,0,0,0,,Жүгірмесең, құлайсың!
Dialogue: 0,1:32:30.32,1:32:32.33,Default,,0,0,0,,Иә? Эй!
Dialogue: 0,1:32:32.33,1:32:35.33,Default,,0,0,0,,Уау!
Dialogue: 0,1:32:35.33,1:32:37.33,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,1:32:42.34,1:32:45.34,Default,,0,0,0,,Тая! Уф! аа!
Dialogue: 0,1:32:45.34,1:32:48.34,Default,,0,0,0,,Мокякякя, кякякя!
Dialogue: 0,1:32:48.34,1:32:50.34,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,1:32:50.34,1:32:53.35,Default,,0,0,0,,Ах…
Dialogue: 0,1:32:53.35,1:32:56.35,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,1:32:56.35,1:33:00.35,Default,,0,0,0,,Эй, бұл Химавари жоқ Мононоке ме еді?
Dialogue: 0,1:33:00.35,1:33:02.35,Default,,0,0,0,,Мына әдемі жігіт...
Dialogue: 0,1:33:07.36,1:33:10.36,Default,,0,0,0,,Енді жүр!
Dialogue: 0,1:33:10.36,1:33:14.36,Default,,0,0,0,,Ой... уау!
Dialogue: 0,1:33:18.37,1:33:21.31,Default,,0,0,0,,Иә! Әй!
Dialogue: 0,1:33:21.31,1:33:24.31,Default,,0,0,0,,Иә! Жүр, Чинзо-кун!
Dialogue: 0,1:33:24.31,1:33:26.31,Default,,0,0,0,,Бу ража!
Dialogue: 0,1:33:28.32,1:33:32.32,Default,,0,0,0,,Ниндзя техникасы Момонга жоқ Дзюцу!
Dialogue: 0,1:33:32.32,1:33:34.32,Default,,0,0,0,,Сәл жоғарырақ!
Dialogue: 0,1:33:34.32,1:33:38.33,Default,,0,0,0,,Тоқтатқышты жоғарыдан ішке қарай итеріңіз!
Dialogue: 0,1:33:38.33,1:33:41.33,Default,,0,0,0,,Оо?
Dialogue: 0,1:33:41.33,1:33:47.34,Default,,0,0,0,,Ниндзя техникасы өте үлкен жел бомбасы! Ұшу!!
Dialogue: 0,1:33:47.34,1:33:49.34,Default,,0,0,0,,Хаа!
Dialogue: 0,1:33:49.34,1:33:51.34,Default,,0,0,0,,Ниндзя мақта кәмпиттері!
Dialogue: 0,1:33:51.34,1:33:54.34,Default,,0,0,0,,Энн!
Dialogue: 0,1:33:54.34,1:33:57.34,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,1:34:05.35,1:34:09.36,Default,,0,0,0,,Кун, мен сенің тесігіңді жаптым!
Dialogue: 0,1:34:09.36,1:34:13.36,Default,,0,0,0,,Ей, кіндік О, ол, солай!
Dialogue: 0,1:34:13.36,1:34:17.37,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,1:34:17.37,1:34:22.27,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,1:34:38.32,1:34:42.32,Default,,0,0,0,,(теңіз құстары әні)
Dialogue: 0,1:34:42.32,1:34:45.33,Default,,0,0,0,,(цикаданың айқайы)
Dialogue: 0,1:34:45.33,1:34:49.33,Default,,0,0,0,,Уау...
Dialogue: 0,1:34:49.33,1:34:53.33,Default,,0,0,0,,Фуфуфуфуфуфуфу (Гомаэмон) Хохохо
Dialogue: 0,1:34:56.34,1:34:59.34,Default,,0,0,0,,Хохо... (балам) аааа
Dialogue: 0,1:34:59.34,1:35:01.34,Default,,0,0,0,,Хохохохо
Dialogue: 0,1:35:01.34,1:35:04.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:04.35,1:35:06.35,Default,,0,0,0,,Аа
Dialogue: 0,1:35:11.35,1:35:15.36,Default,,0,0,0,,Шиноби ауылы туралы ақпарат таратамыз.
Dialogue: 0,1:35:15.36,1:35:17.36,Default,,0,0,0,,Шынында да, ниндзялар ауылы да жарқырай түсті~
Dialogue: 0,1:35:17.36,1:35:19.36,Default,,0,0,0,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,1:35:19.36,1:35:21.30,Default,,0,0,0,,Бұл жолы өте тереңдеп кетті⇒
Dialogue: 0,1:35:21.30,1:35:23.30,Default,,0,0,0,,Мен ішектің тығынын бұрап алдым⇒
Dialogue: 0,1:35:23.30,1:35:26.30,Default,,0,0,0,,Ол енді табиғи түрде шықпайтын сияқты.
Dialogue: 0,1:35:26.30,1:35:30.30,Default,,0,0,0,,Бұдан былай ешкім шүмекті жабуға міндетті емес.
Dialogue: 0,1:35:30.30,1:35:33.31,Default,,0,0,0,,Иә! Барлығыңызға рахмет
Dialogue: 0,1:35:33.31,1:35:36.31,Default,,0,0,0,,Ол жігітті қайта шақыра алмайсың.
Dialogue: 0,1:35:36.31,1:35:38.31,Default,,0,0,0,,Өте
Dialogue: 0,1:35:38.31,1:35:43.32,Default,,0,0,0,,Уфуфу (Гомаэмон) Уухохо хохо
Dialogue: 0,1:35:43.32,1:35:45.32,Default,,0,0,0,,Әрекет сәулесі! Бибібибі…
Dialogue: 0,1:35:45.32,1:35:48.32,Default,,0,0,0,,Енді әрекет маскасын киетін кезегім!
Dialogue: 0,1:35:48.32,1:35:50.32,Default,,0,0,0,,Олай болса, мен Кванттық Робомын!
Dialogue: 0,1:35:50.32,1:35:53.32,Default,,0,0,0,,Әрекет сәулесі! Бибібибі…
Dialogue: 0,1:35:55.33,1:35:57.33,Default,,0,0,0,,Келесі жолы маған қонаққа келіңіз.
Dialogue: 0,1:35:57.33,1:36:01.34,Default,,0,0,0,,Иә, әйтеуір (Чинзо) Қайта кездескенше, Шинносуке!
Dialogue: 0,1:36:01.34,1:36:05.34,Default,,0,0,0,,Жақында кездескенше (қозғалтқыштың іске қосу дыбысы)
Dialogue: 0,1:36:08.34,1:36:28.30,Default,,0,0,0,,♬～
Dialogue: 0,1:36:28.30,1:36:48.32,Default,,0,0,0,,♬～
Dialogue: 0,1:36:48.32,1:37:08.34,Default,,0,0,0,,♬～
Dialogue: 0,1:37:08.34,1:37:28.29,Default,,0,0,0,,♬～
Dialogue: 0,1:37:28.29,1:37:48.31,Default,,0,0,0,,♬～
Dialogue: 0,1:37:48.31,1:38:08.33,Default,,0,0,0,,♬～
Dialogue: 0,1:38:08.33,1:38:28.28,Default,,0,0,0,,♬～
Dialogue: 0,1:38:28.28,1:38:48.30,Default,,0,0,0,,♬～
Dialogue: 0,1:38:48.30,1:39:08.32,Default,,0,0,0,,♬～
Dialogue: 0,1:39:08.32,1:39:28.28,Default,,0,0,0,,♬～
Dialogue: 0,1:39:28.28,1:39:41.08,Default,,0,0,0,,♬～
