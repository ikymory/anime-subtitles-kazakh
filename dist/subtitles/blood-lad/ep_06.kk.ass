Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:03.00,Default,,0,0,0,,Құттықтаймыз Стаз, сіз енді ресми түрде босатылдыңыз.
Dialogue: 0,0:00:03.00,0:00:04.00,Default,,0,0,0,,Иә
Dialogue: 0,0:00:04.00,0:00:10.00,Default,,0,0,0,,Өз күшіңізді қайтарып алып, электрлік жын-шайтанның вампиріне айналу қандай сезімде?
Dialogue: 0,0:00:10.00,0:00:15.00,Default,,0,0,0,,Бұл ең нашар. Енді құбыжық кетуі керек.
Dialogue: 0,0:00:15.00,0:00:18.00,Default,,0,0,0,,Бұл Теменің күші қайтып келгеннен кейін өзін жақсы сезінеді.
Dialogue: 0,0:00:18.00,0:00:23.00,Default,,0,0,0,,Дұрыс, ол өзінің қайтарылған күшін оған қарсы қолдануға тамаша адам.
Dialogue: 0,0:00:23.00,0:00:28.00,Default,,0,0,0,,Мен өзімнің бойымда дамытқан дарынды тағы бір рет көрсете аламын.
Dialogue: 0,0:00:28.00,0:00:29.00,Default,,0,0,0,,Сенің әкең Эден мектебінің түлегі ғой, иә?
Dialogue: 0,0:00:29.00,0:00:32.00,Default,,0,0,0,,Ақыры шынайы сезімдеріңді айттыңдар.
Dialogue: 0,0:00:33.00,0:00:37.00,Default,,0,0,0,,Басқа адамға сіздің мақсатыңызды түсінуге көмектесетін мейірімді және күшті
Dialogue: 0,0:00:37.00,0:00:42.00,Default,,0,0,0,,Сіз де біз сияқтысыз. Мен мұны жек көремін, аға.
Dialogue: 0,0:00:42.00,0:00:46.00,Default,,0,0,0,,Сен сондай сүйкімді інісің, Стаз.
Dialogue: 0,0:00:46.00,0:00:47.00,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:00:47.00,0:00:48.00,Default,,0,0,0,,О
Dialogue: 0,0:00:48.00,0:00:52.00,Default,,0,0,0,,Егер мен оны тоқтата алсам, мен сізге қалай жетекшілік ету керектігін көрсетемін.
Dialogue: 0,0:00:52.00,0:00:53.00,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:00:53.00,0:00:57.00,Default,,0,0,0,,Мен қазір қарап отырған пейзаж мынау
Dialogue: 0,0:00:57.00,0:01:02.00,Default,,0,0,0,,Ол өшіп қалды
Dialogue: 0,0:01:02.00,0:01:05.00,Default,,0,0,0,,Әрқашан сіз үшін
Dialogue: 0,0:01:05.00,0:01:07.00,Default,,0,0,0,,Мені тапты
Dialogue: 0,0:01:07.00,0:01:09.00,Default,,0,0,0,,(Деку) Кайри-чан, сен де мектеп фестиваліне келе алмайсың ба?
Dialogue: 0,0:01:09.00,0:01:11.00,Default,,0,0,0,,Мені тапты
Dialogue: 0,0:01:11.00,0:01:13.00,Default,,0,0,0,,(Деку) Кайри-чан, сен де мектеп фестиваліне келе алмайсың ба?
Dialogue: 0,0:01:13.00,0:01:15.00,Default,,0,0,0,,Мені тапты
Dialogue: 0,0:01:15.00,0:01:17.00,Default,,0,0,0,,(Деку) Кайри-чан, сен де мектеп фестиваліне келе алмайсың ба?
Dialogue: 0,0:01:17.00,0:01:19.00,Default,,0,0,0,,Мені тапты
Dialogue: 0,0:01:19.00,0:01:21.00,Default,,0,0,0,,(Деку) Кайри-чан, сен де мектеп фестиваліне келе алмайсың ба?
Dialogue: 0,0:01:21.00,0:01:26.00,Default,,0,0,0,,Тек өткен шақ әрқашан жарқырап тұратын
Dialogue: 0,0:01:26.00,0:01:30.00,Default,,0,0,0,,Айтсаң да, мен көрген емеспін.
Dialogue: 0,0:01:32.00,0:01:37.00,Default,,0,0,0,,Мені түсінгім келмейді.
Dialogue: 0,0:01:37.00,0:01:40.00,Default,,0,0,0,,Тек дұрыс түсінбеу үшін
Dialogue: 0,0:01:40.00,0:01:43.00,Default,,0,0,0,,Бірақ тек бір адам
Dialogue: 0,0:01:43.00,0:01:45.00,Default,,0,0,0,,Тек сіз үшін
Dialogue: 0,0:01:45.00,0:01:51.00,Default,,0,0,0,,Мен нақты сөзбен айтқым келеді.
Dialogue: 0,0:01:53.00,0:01:54.00,Default,,0,0,0,,Нәресте сәби сәби сәби
Dialogue: 0,0:01:54.00,0:01:56.00,Default,,0,0,0,,Ой!
Dialogue: 0,0:01:56.00,0:01:58.00,Default,,0,0,0,,Бұл дүние
Dialogue: 0,0:01:58.00,0:02:02.00,Default,,0,0,0,,Ашық боялған
Dialogue: 0,0:02:02.00,0:02:03.00,Default,,0,0,0,,Нәресте сәби сәби сәби
Dialogue: 0,0:02:03.00,0:02:05.00,Default,,0,0,0,,Болашақ әлі ақ
Dialogue: 0,0:02:05.00,0:02:07.00,Default,,0,0,0,,Мен алған махаббат түсінде
Dialogue: 0,0:02:07.00,0:02:11.00,Default,,0,0,0,,Ұшатын көк айқай
Dialogue: 0,0:02:11.00,0:02:15.00,Default,,0,0,0,,Сіз суретіңізді алып тастадыңыз.
Dialogue: 0,0:02:15.00,0:02:21.00,Default,,0,0,0,,Жасырмаңыз, жеңіске жетуіңіз мүмкін
Dialogue: 0,0:02:35.00,0:02:37.00,Default,,0,0,0,,Бұл қызықты тарау болды.
Dialogue: 0,0:02:37.00,0:02:40.00,Default,,0,0,0,,Мен мұны қазір қолдандым.
Dialogue: 0,0:02:40.00,0:02:42.00,Default,,0,0,0,,Шошқаның аузында аузын кең ашып
Dialogue: 0,0:02:42.00,0:02:44.00,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:02:44.00,0:02:46.00,Default,,0,0,0,,Дене ішіне таралса
Dialogue: 0,0:02:46.00,0:02:48.00,Default,,0,0,0,,Зудон
Dialogue: 0,0:02:48.00,0:02:49.00,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:02:50.00,0:02:52.00,Default,,0,0,0,,Белл-чан қайтадан
Dialogue: 0,0:02:52.00,0:02:53.00,Default,,0,0,0,,Джо
Dialogue: 0,0:02:54.00,0:02:56.00,Default,,0,0,0,,Күтілетін тағамдар мен көңіл-күй.
Dialogue: 0,0:02:56.00,0:02:57.00,Default,,0,0,0,,Мистер Белл
Dialogue: 0,0:02:57.00,0:02:58.00,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:02:58.00,0:03:00.00,Default,,0,0,0,,Тыныштық, жануарлар стилі марапаты
Dialogue: 0,0:03:00.00,0:03:01.00,Default,,0,0,0,,Бұл мен
Dialogue: 0,0:03:01.00,0:03:05.00,Default,,0,0,0,,Сіз бұл бетті Франкеннен естіген сияқтысыз.
Dialogue: 0,0:03:05.00,0:03:09.00,Default,,0,0,0,,Ол жердегілердің бәріне қиындық туғызатын сияқты.
Dialogue: 0,0:03:10.00,0:03:11.00,Default,,0,0,0,,Жеті кәсіби батыр мен үш орта мектеп оқушысы—
Dialogue: 0,0:03:11.00,0:03:13.00,Default,,0,0,0,,Қасқыр да солай
Dialogue: 0,0:03:13.00,0:03:15.00,Default,,0,0,0,,Мен Миджин туралы ойламаймын да.
Dialogue: 0,0:03:16.00,0:03:17.00,Default,,0,0,0,,Не?
Dialogue: 0,0:03:17.00,0:03:19.00,Default,,0,0,0,,Сен де менімен ойнағың келді.
Dialogue: 0,0:03:19.00,0:03:20.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:20.00,0:03:22.00,Default,,0,0,0,,Ойнайық
Dialogue: 0,0:03:23.00,0:03:25.00,Default,,0,0,0,,Мен мұны әлдеқашан көрдім.
Dialogue: 0,0:03:31.00,0:03:33.00,Default,,0,0,0,,Маған ұнайсың
Dialogue: 0,0:03:33.00,0:03:35.00,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:03:36.00,0:03:38.00,Default,,0,0,0,,Жоғалмаңыз
Dialogue: 0,0:03:38.00,0:03:40.00,Default,,0,0,0,,Кез келген бөлшектер жақсы
Dialogue: 0,0:03:40.00,0:03:42.00,Default,,0,0,0,,Аяқ?
Dialogue: 0,0:03:42.00,0:03:43.00,Default,,0,0,0,,Хмм иә
Dialogue: 0,0:03:43.00,0:03:45.00,Default,,0,0,0,,Бастапқыда бұл аяқ болды, бірақ
Dialogue: 0,0:03:45.00,0:03:47.00,Default,,0,0,0,,Хмм, уақытыңызды алыңыз.
Dialogue: 0,0:03:47.00,0:03:48.00,Default,,0,0,0,,Мейіз
Dialogue: 0,0:03:49.00,0:03:51.00,Default,,0,0,0,,Бұл қол бұрынғыдан
Dialogue: 0,0:03:51.00,0:03:53.00,Default,,0,0,0,,Менің ойымша, ол бұзылған.
Dialogue: 0,0:03:57.00,0:03:59.00,Default,,0,0,0,,Емделгендей емес.
Dialogue: 0,0:03:59.00,0:04:01.00,Default,,0,0,0,,Ол сөзсіз бұзылды.
Dialogue: 0,0:04:01.00,0:04:03.00,Default,,0,0,0,,Бірақ, бұл мен үшін маңызды емес.
Dialogue: 0,0:04:03.00,0:04:05.00,Default,,0,0,0,,Енді неге?
Dialogue: 0,0:04:05.00,0:04:06.00,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:04:06.00,0:04:08.00,Default,,0,0,0,,Мен сізге айтайын.
Dialogue: 0,0:04:08.00,0:04:10.00,Default,,0,0,0,,Барлық жауаптар безендіру
Dialogue: 0,0:04:10.00,0:04:12.00,Default,,0,0,0,,Бұл қолдар мен аяқтардың бәрі
Dialogue: 0,0:04:12.00,0:04:16.00,Default,,0,0,0,,Сүйектер мен бұлшықеттер жүйке арқылы қозғалмайды.
Dialogue: 0,0:04:16.00,0:04:18.00,Default,,0,0,0,,Тек сиқырлы күшпен басқарылады
Dialogue: 0,0:04:18.00,0:04:21.00,Default,,0,0,0,,Міне, сен көріп тұрған менмін
Dialogue: 0,0:04:21.00,0:04:23.00,Default,,0,0,0,,Нағыз мен емес
Dialogue: 0,0:04:23.00,0:04:25.00,Default,,0,0,0,,Ет пен қанды басқаратын елес
Dialogue: 0,0:04:25.00,0:04:27.00,Default,,0,0,0,,Өйткені мен сондаймын
Dialogue: 0,0:04:30.00,0:04:33.00,Default,,0,0,0,,Бұл менің басқа ыдыста болған сиқырлы күшім.
Dialogue: 0,0:04:33.00,0:04:36.00,Default,,0,0,0,,Мен өзімнің бастапқы контейнеріме оралғалы жатырмын.
Dialogue: 0,0:04:36.00,0:04:40.00,Default,,0,0,0,,Енді сіздің сүйікті викторинаңыздың уақыты келді.
Dialogue: 0,0:04:40.00,0:04:45.00,Default,,0,0,0,,Сиқырлы күш сыртта болғанда қандай жаратылыс сыртқы түрін өзгертеді?
Dialogue: 0,0:04:47.00,0:04:49.00,Default,,0,0,0,,Жауап – мен
Dialogue: 0,0:04:49.00,0:04:51.00,Default,,0,0,0,,Мен әлі жауап берген жоқпын.
Dialogue: 0,0:04:51.00,0:04:54.00,Default,,0,0,0,,Сізде викторинаға қабілет жоқ.
Dialogue: 0,0:04:54.00,0:04:57.00,Default,,0,0,0,,Бірақ бұл қызық.
Dialogue: 0,0:04:58.00,0:04:59.00,Default,,0,0,0,,3 минут
Dialogue: 0,0:04:59.00,0:05:02.00,Default,,0,0,0,,Сол кезде қасқыр қасқырға айналады
Dialogue: 0,0:05:02.00,0:05:04.00,Default,,0,0,0,,Қасқыр - қасқыр, солай ма?
Dialogue: 0,0:05:04.00,0:05:06.00,Default,,0,0,0,,Ақылдың уақыт шегі бар ма?
Dialogue: 0,0:05:06.00,0:05:08.00,Default,,0,0,0,,Міне
Dialogue: 0,0:05:08.00,0:05:10.00,Default,,0,0,0,,Әңгіме әлі біткен жоқ.
Dialogue: 0,0:05:10.00,0:05:11.00,Default,,0,0,0,,Жарыс басталмас бұрын Қвиркіңді қолданба! Өзіңді шаршатпа!
Dialogue: 0,0:05:11.00,0:05:14.00,Default,,0,0,0,,Мен Франкенмен сөйлесемін.
Dialogue: 0,0:05:14.00,0:05:17.00,Default,,0,0,0,,Біраз ғана екеуміз
Dialogue: 0,0:05:18.00,0:05:20.00,Default,,0,0,0,,Ол тентек әйел.
Dialogue: 0,0:05:21.00,0:05:22.00,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,0:05:22.00,0:05:24.00,Default,,0,0,0,,Сен мені осындай жерге қамап қойсаң
Dialogue: 0,0:05:24.00,0:05:26.00,Default,,0,0,0,,Ол қызды емдеуге болмайды.
Dialogue: 0,0:05:26.00,0:05:29.00,Default,,0,0,0,,Мен оны емдегім келді.
Dialogue: 0,0:05:29.00,0:05:32.00,Default,,0,0,0,,Сіз Қасқырдың тез жеңілгенін қалайсыз.
Dialogue: 0,0:05:32.00,0:05:35.00,Default,,0,0,0,,Егер бұл орын алса, келесі ойыншықты жіберуге болады.
Dialogue: 0,0:05:35.00,0:05:37.00,Default,,0,0,0,,Сіз Винтер-Чанмен араласа аласыз, солай ма?
Dialogue: 0,0:05:37.00,0:05:39.00,Default,,0,0,0,,негізгі тақырып
Dialogue: 0,0:05:39.00,0:05:41.00,Default,,0,0,0,,Сіз басынан бастап білдіңіз.
Dialogue: 0,0:05:41.00,0:05:44.00,Default,,0,0,0,,Әкім кеңістіктік сиқырды қолдана алады.
Dialogue: 0,0:05:44.00,0:05:47.00,Default,,0,0,0,,Сіз менің зертханамды іздедіңіз бе?
Dialogue: 0,0:05:47.00,0:05:49.00,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:05:49.00,0:05:50.00,Default,,0,0,0,,Бұл маған түсінікті
Dialogue: 0,0:05:50.00,0:05:54.00,Default,,0,0,0,,Ендеше маған қазір білетіндеріңді айтып беріңдер.
Dialogue: 0,0:05:54.00,0:05:56.00,Default,,0,0,0,,Ас үй
Dialogue: 0,0:05:57.00,0:05:59.00,Default,,0,0,0,,Солтүстік сол жақта ма?
Dialogue: 0,0:05:59.00,0:06:03.00,Default,,0,0,0,,Мен ешқашан шапан мен толық дене гимнастикасын қазіргідей қатты қалаған емеспін.
Dialogue: 0,0:06:03.00,0:06:06.00,Default,,0,0,0,,Мойынға жарқыраған тас тағу жаман емес.
Dialogue: 0,0:06:06.00,0:06:09.00,Default,,0,0,0,,Өкінішке орай мен баламын.
Dialogue: 0,0:06:09.00,0:06:11.00,Default,,0,0,0,,Бұл сөзсіз батылдық
Dialogue: 0,0:06:11.00,0:06:13.00,Default,,0,0,0,,Періштенің күшімен ұш
Dialogue: 0,0:06:16.00,0:06:18.00,Default,,0,0,0,,Аспанның арғы жағында
Dialogue: 0,0:06:19.00,0:06:22.00,Default,,0,0,0,,Жарайды, тамаша.
Dialogue: 0,0:06:22.00,0:06:25.00,Default,,0,0,0,,Таяқты сермеп тұрған кездегіден әлдеқайда жақсырақ.
Dialogue: 0,0:06:25.00,0:06:27.00,Default,,0,0,0,,Мектептің күші
Dialogue: 0,0:06:27.00,0:06:29.00,Default,,0,0,0,,Ұқыпты және орынды стиль
Dialogue: 0,0:06:29.00,0:06:30.00,Default,,0,0,0,,Буси!
Dialogue: 0,0:06:30.00,0:06:31.00,Default,,0,0,0,,Бірақ бір жерде
Dialogue: 0,0:06:33.00,0:06:34.00,Default,,0,0,0,,эфемерлі
Dialogue: 0,0:06:41.00,0:06:43.00,Default,,0,0,0,,Жоқ, бұл уақытшалық
Dialogue: 0,0:06:44.00,0:06:46.00,Default,,0,0,0,,Бұл әдемі шығар
Dialogue: 0,0:06:48.00,0:06:50.00,Default,,0,0,0,,Менің саған уақытым жоқ.
Dialogue: 0,0:06:50.00,0:06:54.00,Default,,0,0,0,,Мен шығарған сиқырлы күш денеме қайта оралады.
Dialogue: 0,0:06:55.00,0:06:59.00,Default,,0,0,0,,Менің журналымның қасқыр емес бөлігі мені оны басқаруға мәжбүр етеді.
Dialogue: 0,0:07:01.00,0:07:04.00,Default,,0,0,0,,Сіздің айтқаныңыз да өткінші бөлік.
Dialogue: 0,0:07:04.00,0:07:07.00,Default,,0,0,0,,Абба, бұзық!
Dialogue: 0,0:07:10.00,0:07:12.00,Default,,0,0,0,,Ауырады
Dialogue: 0,0:07:13.00,0:07:16.00,Default,,0,0,0,,Мен ұша алмайтынымды ұмытып қалдым.
Dialogue: 0,0:07:16.00,0:07:17.00,Default,,0,0,0,,Мен
Dialogue: 0,0:07:17.00,0:07:18.00,Default,,0,0,0,,Қасқыр
Dialogue: 0,0:07:18.00,0:07:20.00,Default,,0,0,0,,Жұлдыздар, сен мұнда не істеп жүрсің?
Dialogue: 0,0:07:20.00,0:07:22.00,Default,,0,0,0,,Сіз жаңа доссыз ба?
Dialogue: 0,0:07:23.00,0:07:25.00,Default,,0,0,0,,Эй, сен шын айтасың ба?
Dialogue: 0,0:07:25.00,0:07:27.00,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:07:27.00,0:07:28.00,Default,,0,0,0,,Мен саған айттым
Dialogue: 0,0:07:28.00,0:07:30.00,Default,,0,0,0,,Мен елеспін
Dialogue: 0,0:07:30.00,0:07:32.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:32.00,0:07:34.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:35.00,0:07:36.00,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:07:36.00,0:07:38.00,Default,,0,0,0,,Аа, аздап.
Dialogue: 0,0:07:39.00,0:07:42.00,Default,,0,0,0,,Сіз шынымен де ұсақ жануарлардың айласын білесіз.
Dialogue: 0,0:07:43.00,0:07:46.00,Default,,0,0,0,,Неліктен Белл қалыпты жағдайға оралды?
Dialogue: 0,0:07:46.00,0:07:48.00,Default,,0,0,0,,Бұл тентек жануар, расында.
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:07:50.00,0:07:52.00,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:07:52.00,0:07:55.00,Default,,0,0,0,,Бланкен біраз уақыт үйіне бара алмайтын сияқты.
Dialogue: 0,0:07:55.00,0:07:57.00,Default,,0,0,0,,Біз де Қасқырды қолдаймыз.
Dialogue: 0,0:07:57.00,0:07:59.00,Default,,0,0,0,,Арнайы орындарда.
Dialogue: 0,0:08:04.00,0:08:05.00,Default,,0,0,0,,Қасқыр
Dialogue: 0,0:08:08.00,0:08:10.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:10.00,0:08:13.00,Default,,0,0,0,,Осы Шоу дәуірі сізді таң қалдырды деп үміттенемін.
Dialogue: 0,0:08:13.00,0:08:14.00,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:08:16.00,0:08:18.00,Default,,0,0,0,,Трансформация күтілгеннен ертерек болды
Dialogue: 0,0:08:19.00,0:08:20.00,Default,,0,0,0,,Жұлдыздар мырза
Dialogue: 0,0:08:20.00,0:08:22.00,Default,,0,0,0,,Ол не үшін мұнда?
Dialogue: 0,0:08:22.00,0:08:24.00,Default,,0,0,0,,Уақыт бітті, Қасқыр.
Dialogue: 0,0:08:24.00,0:08:27.00,Default,,0,0,0,,Бұл сенің қасқыр ретінде бірінші рет сәтсіздікке ұшырауың.
Dialogue: 0,0:08:27.00,0:08:30.00,Default,,0,0,0,,Жолдан кет, әлі біткен жоқ.
Dialogue: 0,0:08:30.00,0:08:33.00,Default,,0,0,0,,Олай деме, мені де таныстыршы.
Dialogue: 0,0:08:33.00,0:08:35.00,Default,,0,0,0,,Бұл көрнекі кей мысал болып табылады
Dialogue: 0,0:08:35.00,0:08:37.00,Default,,0,0,0,,Сіз мен туралы білесіз бе?
Dialogue: 0,0:08:37.00,0:08:38.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:38.00,0:08:40.00,Default,,0,0,0,,Әй, жабдық әдісіне не болды?
Dialogue: 0,0:08:40.00,0:08:42.00,Default,,0,0,0,,Дәмі қандай?
Dialogue: 0,0:08:42.00,0:08:44.00,Default,,0,0,0,,Сіз тыңдайсыз, жауап беріңіз.
Dialogue: 0,0:08:44.00,0:08:45.00,Default,,0,0,0,,Маған не деп жауап бергеніңізді айтыңыз.
Dialogue: 0,0:08:45.00,0:08:47.00,Default,,0,0,0,,Шулы, саған уақытым жоқ.
Dialogue: 0,0:08:47.00,0:08:48.00,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:08:48.00,0:08:49.00,Default,,0,0,0,,Уақытыңыз болмаса, сәлем айтыңыз.
Dialogue: 0,0:08:49.00,0:08:51.00,Default,,0,0,0,,Мен сөйлесуге уақытым жоқ дедім.
Dialogue: 0,0:08:51.00,0:08:53.00,Default,,0,0,0,,Уақыт жоқ дегенді қалай түсінесіңдер?
Dialogue: 0,0:08:53.00,0:08:55.00,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:08:56.00,0:08:58.00,Default,,0,0,0,,Мен тыңдаймын
Dialogue: 0,0:08:58.00,0:09:00.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:00.00,0:09:02.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:02.00,0:09:05.00,Default,,0,0,0,,Мен тыңдаймын
Dialogue: 0,0:09:05.00,0:09:09.00,Default,,0,0,0,,Жауап бергің келмесе, жоғалуыңды сұраймын.
Dialogue: 0,0:09:09.00,0:09:13.00,Default,,0,0,0,,Бұл адамның сиқырлы күші өте көп.
Dialogue: 0,0:09:17.00,0:09:19.00,Default,,0,0,0,,Бұл өзіне қызмет етеді.
Dialogue: 0,0:09:19.00,0:09:21.00,Default,,0,0,0,,Шешілмеген түрлендіру
Dialogue: 0,0:09:21.00,0:09:24.00,Default,,0,0,0,,Әлі уақыт бар
Dialogue: 0,0:09:28.00,0:09:30.00,Default,,0,0,0,,Жақсырақ
Dialogue: 0,0:09:31.00,0:09:33.00,Default,,0,0,0,,Темір Ямагучи вампирі
Dialogue: 0,0:09:38.00,0:09:40.00,Default,,0,0,0,,Бұл 10 жыл ерте болды.
Dialogue: 0,0:09:40.00,0:09:42.00,Default,,0,0,0,,Дәлірек айтсақ, қансорғыш элемент қазір қайда?
Dialogue: 0,0:09:42.00,0:09:44.00,Default,,0,0,0,,Мүмкін ол жігіт шығар?
Dialogue: 0,0:09:44.00,0:09:47.00,Default,,0,0,0,,Өйткені, допты мұқият тыңдаңыз
Dialogue: 0,0:09:47.00,0:09:50.00,Default,,0,0,0,,Мен тағы да сиқырлы күшімді жинақтауым керек.
Dialogue: 0,0:09:50.00,0:09:54.00,Default,,0,0,0,,Басқаша айтқанда, егер біз онымен қазіргідей күрессек,
Dialogue: 0,0:09:54.00,0:09:57.00,Default,,0,0,0,,Тез шабуылда ыдырап кете ме деп қорқамын.
Dialogue: 0,0:09:57.00,0:10:00.00,Default,,0,0,0,,Дұрыс, мен қазір сондаймын.
Dialogue: 0,0:10:00.00,0:10:02.00,Default,,0,0,0,,Бірақ сіз қазір басқаша көрінесіз.
Dialogue: 0,0:10:02.00,0:10:06.00,Default,,0,0,0,,Сондықтан екеуміз де кейін келеміз.
Dialogue: 0,0:10:06.00,0:10:09.00,Default,,0,0,0,,Неден бастайтыныңызды ойлап, соған сәйкес әрекет етіңіз.
Dialogue: 0,0:10:09.00,0:10:11.00,Default,,0,0,0,,Сонымен бұл нені білдіреді?
Dialogue: 0,0:10:11.00,0:10:13.00,Default,,0,0,0,,Таяқшаны түрту
Dialogue: 0,0:10:13.00,0:10:15.00,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:10:15.00,0:10:19.00,Default,,0,0,0,,Мен қайтып оралмайынша ренжіме, вампир.
Dialogue: 0,0:10:19.00,0:10:21.00,Default,,0,0,0,,Олар қандай?
Dialogue: 0,0:10:21.00,0:10:23.00,Default,,0,0,0,,Түсіндім, әлгі жігіт
Dialogue: 0,0:10:23.00,0:10:27.00,Default,,0,0,0,,Ол маған берген уәдесін есіне алды.
Dialogue: 0,0:10:30.00,0:10:32.00,Default,,0,0,0,,Бұл тек сенсің
Dialogue: 0,0:10:32.00,0:10:37.00,Default,,0,0,0,,Ей қасқыр сүйікті таяқшасын алуды күтіп тұр.
Dialogue: 0,0:10:37.00,0:10:41.00,Default,,0,0,0,,Мен сонда болдым, көгалда әйелімді күтіп тұрдым.
Dialogue: 0,0:10:41.00,0:10:42.00,Default,,0,0,0,,О
Dialogue: 0,0:10:42.00,0:10:45.00,Default,,0,0,0,,Мені өте жалғыз жерге жіберді.
Dialogue: 0,0:10:45.00,0:10:48.00,Default,,0,0,0,,Бұл әсерлі емес пе?
Dialogue: 0,0:10:48.00,0:10:50.00,Default,,0,0,0,,Мен көбірек сапада тербеліп жатырмын.
Dialogue: 0,0:10:50.00,0:10:52.00,Default,,0,0,0,,Саған да сұрақ-жауап берейік
Dialogue: 0,0:10:52.00,0:10:54.00,Default,,0,0,0,,Осындай жерге желпініп кетсем де
Dialogue: 0,0:10:54.00,0:10:57.00,Default,,0,0,0,,Мен неге шыдамдылықпен күттім деп ойлаймын.
Dialogue: 0,0:10:57.00,0:11:01.00,Default,,0,0,0,,Аренасты тауып, оған ғашық болдыңыз ба?
Dialogue: 0,0:11:01.00,0:11:03.00,Default,,0,0,0,,Мен ақымақ болғандықтан ба?
Dialogue: 0,0:11:03.00,0:11:07.00,Default,,0,0,0,,Жоқ, жауап өте кең.
Dialogue: 0,0:11:07.00,0:11:10.00,Default,,0,0,0,,Мен екеуіңмен де қолымнан келгеннің бәрін жасай аламын.
Dialogue: 0,0:11:10.00,0:11:12.00,Default,,0,0,0,,Өйткені мен солай ойладым.
Dialogue: 0,0:11:12.00,0:11:14.00,Default,,0,0,0,,Сізде викторинаға қабілет жоқ.
Dialogue: 0,0:11:14.00,0:11:18.00,Default,,0,0,0,,Мен оны асыға күттім, бірақ оны қанша адам жасады?
Dialogue: 0,0:11:18.00,0:11:20.00,Default,,0,0,0,,Менің ойымша, бұл шешілді.
Dialogue: 0,0:11:22.00,0:11:25.00,Default,,0,0,0,,Өйткені мен өзімше жеткіліктімін.
Dialogue: 0,0:11:25.00,0:11:28.00,Default,,0,0,0,,Бұрынғыдай.
Dialogue: 0,0:11:28.00,0:11:29.00,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:11:29.00,0:11:31.00,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:11:34.00,0:11:36.00,Default,,0,0,0,,Әдемі емес
Dialogue: 0,0:11:36.00,0:11:39.00,Default,,0,0,0,,Бұл жердегі аңдардың шайқасы.
Dialogue: 0,0:11:39.00,0:11:41.00,Default,,0,0,0,,Кумоцуги таз
Dialogue: 0,0:11:41.00,0:11:42.00,Default,,0,0,0,,Өл, мен
Dialogue: 0,0:11:42.00,0:11:43.00,Default,,0,0,0,,Сказ мырза
Dialogue: 0,0:11:43.00,0:11:47.00,Default,,0,0,0,,Бұл, әрине, Белл айтқандай қуаттандырылған сияқты.
Dialogue: 0,0:11:48.00,0:11:50.00,Default,,0,0,0,,Әлгі жігіт тым абдырап қалды.
Dialogue: 0,0:11:50.00,0:11:52.00,Default,,0,0,0,,Әлі бітті ме?
Dialogue: 0,0:11:52.00,0:11:53.00,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:11:53.00,0:11:56.00,Default,,0,0,0,,Кішігірім шабуылдармен ұрудың қажеті жоқ.
Dialogue: 0,0:11:56.00,0:11:57.00,Default,,0,0,0,,Бұл – Қабырға.
Dialogue: 0,0:11:57.00,0:11:59.00,Default,,0,0,0,,Бір соққы.
Dialogue: 0,0:11:59.00,0:12:04.00,Default,,0,0,0,,Бір соққымен өшіретін күшті соққыдан құтылыңыз.
Dialogue: 0,0:12:04.00,0:12:05.00,Default,,0,0,0,,Тейюу
Dialogue: 0,0:12:05.00,0:12:06.00,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:12:06.00,0:12:09.00,Default,,0,0,0,,Каме
Dialogue: 0,0:12:16.00,0:12:18.00,Default,,0,0,0,,Бұл нені еліктейді?
Dialogue: 0,0:12:18.00,0:12:21.00,Default,,0,0,0,,Не болды, Фуми? Сіз сусын алғыңыз келе ме?
Dialogue: 0,0:12:21.00,0:12:23.00,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:12:23.00,0:12:26.00,Default,,0,0,0,,Мен Сказдың техникасына таң қалдым.
Dialogue: 0,0:12:27.00,0:12:29.00,Default,,0,0,0,,Саған қарап ашуым келеді
Dialogue: 0,0:12:29.00,0:12:34.00,Default,,0,0,0,,Жақсы бөліктерден тұрса да, ол мүлдем қолданылмайды.
Dialogue: 0,0:12:34.00,0:12:38.00,Default,,0,0,0,,Барлық техникалар дәмсіз және кемшіліктерге толы және әдемі емес.
Dialogue: 0,0:12:38.00,0:12:40.00,Default,,0,0,0,,Қазір әсіресе жаман болды.
Dialogue: 0,0:12:40.00,0:12:46.00,Default,,0,0,0,,Мұндай трюкті жеңіспен орындауға тырысу тек үшінші дәрежелі нәрсе.
Dialogue: 0,0:12:48.00,0:12:51.00,Default,,0,0,0,,Эй, сен не істедің?
Dialogue: 0,0:12:52.00,0:12:56.00,Default,,0,0,0,,Қазіргі техника мен құрметтейтін ғаламдағы ең ұлы батырдың техникасы.
Dialogue: 0,0:12:56.00,0:13:00.00,Default,,0,0,0,,Егер нақты нәрсе осы әдісті орындаса, ол сөзсіз болар еді
Dialogue: 0,0:13:00.00,0:13:03.00,Default,,0,0,0,,100% бір сәтте шаңға айналды
Dialogue: 0,0:13:03.00,0:13:05.00,Default,,0,0,0,,Бұл керемет техника.
Dialogue: 0,0:13:05.00,0:13:09.00,Default,,0,0,0,,Сіздің қауіпсіз болғаныңыздың себебі мен фейк болдым.
Dialogue: 0,0:13:09.00,0:13:14.00,Default,,0,0,0,,Өйткені жалған мен таңданғаннан абайсызда болды.
Dialogue: 0,0:13:14.00,0:13:16.00,Default,,0,0,0,,Әрине, бұл үшінші деңгей.
Dialogue: 0,0:13:16.00,0:13:19.00,Default,,0,0,0,,Әрине, бұл менің қолымнан келетін әдіс емес еді.
Dialogue: 0,0:13:19.00,0:13:22.00,Default,,0,0,0,,Сондықтан мен өз өнеріммен жарысуым керек.
Dialogue: 0,0:13:22.00,0:13:23.00,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:13:23.00,0:13:24.00,Default,,0,0,0,,Сіз өзіңізсіз...
Dialogue: 0,0:13:24.00,0:13:26.00,Default,,0,0,0,,Өте шулысың, аузыңды жап.
Dialogue: 0,0:13:26.00,0:13:28.00,Default,,0,0,0,,Мен енді ғана шештім.
Dialogue: 0,0:13:28.00,0:13:30.00,Default,,0,0,0,,Әрқашан өлтіру
Dialogue: 0,0:13:30.00,0:13:31.00,Default,,0,0,0,,Өлім
Dialogue: 0,0:13:31.00,0:13:32.00,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:13:32.00,0:13:34.00,Default,,0,0,0,,Бұл да өте қауіпті.
Dialogue: 0,0:13:34.00,0:13:35.00,Default,,0,0,0,,Түпнұсқа
Dialogue: 0,0:13:35.00,0:13:41.00,Default,,0,0,0,,Теми – бұл мен жасаған, үшінші дәрежелі адам, Теми мазақ еткен ерекше әрекет.
Dialogue: 0,0:13:41.00,0:13:42.00,Default,,0,0,0,,Әрқашан өлтіру
Dialogue: 0,0:13:42.00,0:13:43.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:43.00,0:13:46.00,Default,,0,0,0,,Ақырында бұл мәселеге шындап кіріскен сияқтысыз.
Dialogue: 0,0:13:46.00,0:13:50.00,Default,,0,0,0,,Сондықтан бұл жерде тамақтанған жөн.
Dialogue: 0,0:13:53.00,0:13:55.00,Default,,0,0,0,,Екеуміз де барымызды салайық.
Dialogue: 0,0:13:56.00,0:13:57.00,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:13:57.00,0:14:00.00,Default,,0,0,0,,Дәл мен ойлағандай болып шықты.
Dialogue: 0,0:14:00.00,0:14:03.00,Default,,0,0,0,,Оның жетіспейтіні бар еді.
Dialogue: 0,0:14:03.00,0:14:08.00,Default,,0,0,0,,Сіз барлық күшіңізді нокдаунға жұмсай алатындай сезінетін қарсылас, т.
Dialogue: 0,0:14:08.00,0:14:11.00,Default,,0,0,0,,Айқын жау бар.
Dialogue: 0,0:14:11.00,0:14:14.00,Default,,0,0,0,,Енді, Лиз, мұқият қара.
Dialogue: 0,0:14:14.00,0:14:16.00,Default,,0,0,0,,Бұл Жұлдыздар
Dialogue: 0,0:14:17.00,0:14:18.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:18.00,0:14:21.00,Default,,0,0,0,,Бұл сенің ағаңның сиқырының түрі.
Dialogue: 0,0:14:22.00,0:14:23.00,Default,,0,0,0,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,0:14:23.00,0:14:25.00,Default,,0,0,0,,Уау
Dialogue: 0,0:14:26.00,0:14:28.00,Default,,0,0,0,,Кеңістік неліктен жабылды?
Dialogue: 0,0:14:28.00,0:14:29.00,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:14:29.00,0:14:31.00,Default,,0,0,0,,Төменгі сыныптың жындары жеңіл.
Dialogue: 0,0:14:31.00,0:14:34.00,Default,,0,0,0,,Ары қарай қарасаңыз, сіз де ұштайсыз.
Dialogue: 0,0:14:34.00,0:14:35.00,Default,,0,0,0,,Келіңдер, келіңдер.
Dialogue: 0,0:14:35.00,0:14:37.00,Default,,0,0,0,,Мен мұны істеп жатырмын, өйткені менде бір нәрсе бар.
Dialogue: 0,0:14:37.00,0:14:38.00,Default,,0,0,0,,Нет... не істеп жатырсың...
Dialogue: 0,0:14:38.00,0:14:40.00,Default,,0,0,0,,Біз әрқашан осындай болдық.
Dialogue: 0,0:14:41.00,0:14:43.00,Default,,0,0,0,,Қызық, оған не болды?
Dialogue: 0,0:14:43.00,0:14:45.00,Default,,0,0,0,,Буси!
Dialogue: 0,0:14:46.00,0:14:51.00,Default,,0,0,0,,Енді мен сіз болуға тиісті адамды кездестіргендей болдым.
Dialogue: 0,0:14:52.00,0:14:53.00,Default,,0,0,0,,Момент
Dialogue: 0,0:14:53.00,0:14:54.00,Default,,0,0,0,,Кездесу
Dialogue: 0,0:14:55.00,0:14:57.00,Default,,0,0,0,,Біз ажырасып кеттік
Dialogue: 0,0:15:01.00,0:15:03.00,Default,,0,0,0,,Нәтиже осы жағдай.
Dialogue: 0,0:15:03.00,0:15:05.00,Default,,0,0,0,,Буси!
Dialogue: 0,0:15:05.00,0:15:06.00,Default,,0,0,0,,Тұру
Dialogue: 0,0:15:06.00,0:15:07.00,Default,,0,0,0,,...
Dialogue: 0,0:15:07.00,0:15:10.00,Default,,0,0,0,,Мен қалған барлық сиқырлы күшімді жұмсадым.
Dialogue: 0,0:15:10.00,0:15:12.00,Default,,0,0,0,,Менің енді төбелесуге құмар емеспін
Dialogue: 0,0:15:12.00,0:15:13.00,Default,,0,0,0,,бүлінген
Dialogue: 0,0:15:14.00,0:15:17.00,Default,,0,0,0,,Неліктен сіз өзіңізге ыңғайлы күлуге тырысасыз?
Dialogue: 0,0:15:17.00,0:15:20.00,Default,,0,0,0,,Біздің шайқас басталғалы тұр.
Dialogue: 0,0:15:27.00,0:15:29.00,Default,,0,0,0,,Біреуін қалайсыз ба?
Dialogue: 0,0:15:29.00,0:15:32.00,Default,,0,0,0,,Мен үшін күштің өзі сұлулық.
Dialogue: 0,0:15:32.00,0:15:33.00,Default,,0,0,0,,Салмағы
Dialogue: 0,0:15:34.00,0:15:35.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:35.00,0:15:39.00,Default,,0,0,0,,Мен Темиді жеңу үшін қандай әдіс қолдану керек деп көп ойладым.
Dialogue: 0,0:15:39.00,0:15:43.00,Default,,0,0,0,,Бұл менің сүйікті ерекше қимылым, себебі бұл өте қиын.
Dialogue: 0,0:15:43.00,0:15:45.00,Default,,0,0,0,,Мен сізге жеңілдетемін.
Dialogue: 0,0:15:47.00,0:15:48.00,Default,,0,0,0,,Есеп № 006
Dialogue: 0,0:15:48.00,0:15:50.00,Default,,0,0,0,,Бұзылған патчворк жігіт
Dialogue: 0,0:15:51.00,0:15:52.00,Default,,0,0,0,,Екеуі де емес пе!?
Dialogue: 0,0:15:52.00,0:15:55.00,Default,,0,0,0,,Соңында жаман қимыл емес.
Dialogue: 0,0:15:55.00,0:15:57.00,Default,,0,0,0,,Мен сондаймын
Dialogue: 0,0:16:03.00,0:16:04.00,Default,,0,0,0,,Ол аяқталды ма?
Dialogue: 0,0:16:05.00,0:16:07.00,Default,,0,0,0,,Кешіріңіз, бұл жай ғана аяқталды.
Dialogue: 0,0:16:07.00,0:16:09.00,Default,,0,0,0,,Менің сенен бір өтінішім бар.
Dialogue: 0,0:16:12.00,0:16:14.00,Default,,0,0,0,,Енді мен сенімдімін
Dialogue: 0,0:16:14.00,0:16:16.00,Default,,0,0,0,,Күтілгендей, қызметкерлердің қолдары
Dialogue: 0,0:16:16.00,0:16:17.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:17.00,0:16:19.00,Default,,0,0,0,,Сіздің қолыңыз
Dialogue: 0,0:16:19.00,0:16:20.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:20.00,0:16:21.00,Default,,0,0,0,,Сіздің қолыңыз
Dialogue: 0,0:16:21.00,0:16:22.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:22.00,0:16:24.00,Default,,0,0,0,,Енді мен сенімдімін
Dialogue: 0,0:16:24.00,0:16:26.00,Default,,0,0,0,,Таяқ әлі жау.
Dialogue: 0,0:16:26.00,0:16:28.00,Default,,0,0,0,,Менің ойымша, ол мұны қаламайды.
Dialogue: 0,0:16:29.00,0:16:30.00,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:16:30.00,0:16:32.00,Default,,0,0,0,,Жүр, Лиз, сыртқа шығайық.
Dialogue: 0,0:16:32.00,0:16:33.00,Default,,0,0,0,,Жаңа дыбыс\NТағы
Dialogue: 0,0:16:34.00,0:16:35.00,Default,,0,0,0,,2
Dialogue: 0,0:16:36.00,0:16:40.00,Default,,0,0,0,,Уақыт жоқ кезде олар не істеп жатыр?
Dialogue: 0,0:16:41.00,0:16:43.00,Default,,0,0,0,,Бұл соншалықты жаман емес.
Dialogue: 0,0:16:44.00,0:16:45.00,Default,,0,0,0,,Чиккушо
Dialogue: 0,0:16:46.00,0:16:47.00,Default,,0,0,0,,Әрине бәрі
Dialogue: 0,0:16:47.00,0:16:50.00,Default,,0,0,0,,Әрқайсысының өз маңызды нәрселері бар.
Dialogue: 0,0:16:51.00,0:16:54.00,Default,,0,0,0,,Менің мақсатым қыс мезгілін жандандыру.
Dialogue: 0,0:16:54.00,0:16:56.00,Default,,0,0,0,,Дәл қазір болған оқиға рас болса
Dialogue: 0,0:16:56.00,0:16:58.00,Default,,0,0,0,,Шынымды айтсам, өзіңізге жеңіл жүрмеңіз.
Dialogue: 0,0:16:58.00,0:17:00.00,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:17:00.00,0:17:02.00,Default,,0,0,0,,Ол бірнеше сағаттан кейін жоғалады.
Dialogue: 0,0:17:02.00,0:17:03.00,Default,,0,0,0,,Бұл сен кінәлі
Dialogue: 0,0:17:03.00,0:17:05.00,Default,,0,0,0,,Не болса да
Dialogue: 0,0:17:05.00,0:17:06.00,Default,,0,0,0,,Бір қыстан кейін
Dialogue: 0,0:17:06.00,0:17:08.00,Default,,0,0,0,,Менімен жарысу туралы айтып тұрсың ба?
Dialogue: 0,0:17:08.00,0:17:10.00,Default,,0,0,0,,Менің мінезімді білесің.
Dialogue: 0,0:17:11.00,0:17:14.00,Default,,0,0,0,,Ақ пен қараны кие алмаймын
Dialogue: 0,0:17:14.00,0:17:15.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:17:15.00,0:17:17.00,Default,,0,0,0,,Сіз логикалық тұрғыдан бір-бірімен синхронды болу туралы айта алмайсыз.
Dialogue: 0,0:17:18.00,0:17:19.00,Default,,0,0,0,,Жүр.
Dialogue: 0,0:17:20.00,0:17:21.00,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:17:21.00,0:17:23.00,Default,,0,0,0,,Мысалдағы Будда осында.
Dialogue: 0,0:17:28.00,0:17:29.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:17:29.00,0:17:31.00,Default,,0,0,0,,Жер бетінде қалай?
Dialogue: 0,0:17:31.00,0:17:34.00,Default,,0,0,0,,Мен кәсіби кеңістіктік сиқыршымын.
Dialogue: 0,0:17:34.00,0:17:36.00,Default,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,0:17:36.00,0:17:38.00,Default,,0,0,0,,Ол қашып құтылдым деп ойлаған шығар.
Dialogue: 0,0:17:39.00,0:17:40.00,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:17:42.00,0:17:44.00,Default,,0,0,0,,Бұл техника
Dialogue: 0,0:17:44.00,0:17:45.00,Default,,0,0,0,,Мен сияқты
Dialogue: 0,0:17:45.00,0:17:46.00,Default,,0,0,0,,Қауіп-қатерлерге байланысты әуе саяхатынан бас тартып—
Dialogue: 0,0:17:46.00,0:17:48.00,Default,,0,0,0,,Менікі түпнұсқа
Dialogue: 0,0:17:48.00,0:17:50.00,Default,,0,0,0,,Сіз жай ғана еліктеушісіз.
Dialogue: 0,0:17:51.00,0:17:52.00,Default,,0,0,0,,Әкім бұл әдісті қай жерде жасады?
Dialogue: 0,0:17:52.00,0:17:55.00,Default,,0,0,0,,Оны кигенім есімде жоқ.
Dialogue: 0,0:17:55.00,0:17:58.00,Default,,0,0,0,,Мен сені кездестірмейінше менің күшім өзімде деп ойладым
Dialogue: 0,0:17:59.00,0:18:01.00,Default,,0,0,0,,Енді маған хабарлаңыз.
Dialogue: 0,0:18:01.00,0:18:04.00,Default,,0,0,0,,Әкімді жаратқан жынның шын тұлғасы
Dialogue: 0,0:18:05.00,0:18:07.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:08.00,0:18:09.00,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:18:09.00,0:18:12.00,Default,,0,0,0,,Менің зерттеуім тұйыққа тірелді.
Dialogue: 0,0:18:12.00,0:18:14.00,Default,,0,0,0,,Денені жалғау кілті
Dialogue: 0,0:18:14.00,0:18:16.00,Default,,0,0,0,,Күшті бөліктердің көшбасшысы
Dialogue: 0,0:18:16.00,0:18:18.00,Default,,0,0,0,,Себебі мен оны ала алмадым.
Dialogue: 0,0:18:19.00,0:18:20.00,Default,,0,0,0,,Осындай кездері
Dialogue: 0,0:18:24.00,0:18:25.00,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:18:25.00,0:18:26.00,Default,,0,0,0,,Сәлем Франкен
Dialogue: 0,0:18:26.00,0:18:27.00,Default,,0,0,0,,Мен жақсы қыз болдым ба деп ойлаймын.
Dialogue: 0,0:18:27.00,0:18:29.00,Default,,0,0,0,,...
Dialogue: 0,0:18:29.00,0:18:30.00,Default,,0,0,0,,Мен біреуден сұрап тұрмын
Dialogue: 0,0:18:30.00,0:18:32.00,Default,,0,0,0,,Алдыңғы жағына шығыңыз.
Dialogue: 0,0:18:32.00,0:18:35.00,Default,,0,0,0,,...
Dialogue: 0,0:18:37.00,0:18:38.00,Default,,0,0,0,,...
Dialogue: 0,0:18:39.00,0:18:42.00,Default,,0,0,0,,Әкімнің өзегі болып табылатын ғарыштық сиқырды пайдалана білетін адам.
Dialogue: 0,0:18:43.00,0:18:44.00,Default,,0,0,0,,Сол
Dialogue: 0,0:18:44.00,0:18:47.00,Default,,0,0,0,,Менің сиқырымды ұрлаған сиқырлы ұры
Dialogue: 0,0:18:47.00,0:18:48.00,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:18:49.00,0:18:51.00,Default,,0,0,0,,Аяз ата кім?
Dialogue: 0,0:18:51.00,0:18:52.00,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:18:52.00,0:18:54.00,Default,,0,0,0,,...
Dialogue: 0,0:18:54.00,0:18:55.00,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:18:55.00,0:18:58.00,Default,,0,0,0,,Мен сиқырлы ұрыны таптым деп ойлаған кезде
Dialogue: 0,0:18:58.00,0:19:00.00,Default,,0,0,0,,...
Dialogue: 0,0:19:00.00,0:19:02.00,Default,,0,0,0,,Мынау
Dialogue: 0,0:19:02.00,0:19:05.00,Default,,0,0,0,,Бұл Цутазды электрмен тасымалдаған ханым емес пе?
Dialogue: 0,0:19:06.00,0:19:08.00,Default,,0,0,0,,...
Dialogue: 0,0:19:08.00,0:19:09.00,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:19:09.00,0:19:10.00,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:19:10.00,0:19:11.00,Default,,0,0,0,,...
Dialogue: 0,0:19:11.00,0:19:12.00,Default,,0,0,0,,Сүйелдер
Dialogue: 0,0:19:12.00,0:19:13.00,Default,,0,0,0,,...
Dialogue: 0,0:19:13.00,0:19:16.00,Default,,0,0,0,,Мен бұл мәселе бойынша хабарлаудан бас тарттым.
Dialogue: 0,0:19:16.00,0:19:18.00,Default,,0,0,0,,...
Dialogue: 0,0:19:18.00,0:19:21.00,Default,,0,0,0,,Франкенштейн және Папрадон Аким
Dialogue: 0,0:19:21.00,0:19:24.00,Default,,0,0,0,,Жындар әлемінің тәртібін бұзатын көптеген бұзушылықтарға байланысты.
Dialogue: 0,0:19:24.00,0:19:26.00,Default,,0,0,0,,...
Dialogue: 0,0:19:27.00,0:19:28.00,Default,,0,0,0,,Өлім жазасы?
Dialogue: 0,0:19:28.00,0:19:29.00,Default,,0,0,0,,Лидс жоқ
Dialogue: 0,0:19:29.00,0:19:31.00,Default,,0,0,0,,...
Dialogue: 0,0:19:31.00,0:19:32.00,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:19:32.00,0:19:35.00,Default,,0,0,0,,Мен осыдан кейін елес қызға көмектесемін деген уәдем бар.
Dialogue: 0,0:19:35.00,0:19:39.00,Default,,0,0,0,,Өкінішке орай, бұл уәде ешқашан орындалмайды.
Dialogue: 0,0:19:39.00,0:19:40.00,Default,,0,0,0,,Лидс
Dialogue: 0,0:19:40.00,0:19:41.00,Default,,0,0,0,,Иә, аға.
Dialogue: 0,0:19:43.00,0:19:44.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:19:51.00,0:19:52.00,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:19:52.00,0:19:54.00,Default,,0,0,0,,...
Dialogue: 0,0:19:54.00,0:19:57.00,Default,,0,0,0,,Мен ешқашан нәтижелерге қанағаттанған емеспін.
Dialogue: 0,0:19:57.00,0:19:59.00,Default,,0,0,0,,...
Dialogue: 0,0:19:59.00,0:20:01.00,Default,,0,0,0,,...
Dialogue: 0,0:20:01.00,0:20:03.00,Default,,0,0,0,,Бұл маған нәтижесіз шайқас сияқты көрінеді.
Dialogue: 0,0:20:03.00,0:20:05.00,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:20:05.00,0:20:08.00,Default,,0,0,0,,Ханак маған сенің сондай адам екеніңді айтты.
Dialogue: 0,0:20:09.00,0:20:10.00,Default,,0,0,0,,Сол кезде де
Dialogue: 0,0:20:10.00,0:20:12.00,Default,,0,0,0,,...
Dialogue: 0,0:20:14.00,0:20:15.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:17.00,0:20:18.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:20:18.00,0:20:19.00,Default,,0,0,0,,Сказ
Dialogue: 0,0:20:19.00,0:20:20.00,Default,,0,0,0,,Қайдан келдің?
Dialogue: 0,0:20:20.00,0:20:21.00,Default,,0,0,0,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:20:21.00,0:20:22.00,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:20:22.00,0:20:24.00,Default,,0,0,0,,Мен сенен неге жоғарыдан келгеніңді сұрадым.
Dialogue: 0,0:20:24.00,0:20:25.00,Default,,0,0,0,,Бұл үй болды
Dialogue: 0,0:20:25.00,0:20:27.00,Default,,0,0,0,,Мен Жапонияға барғым келеді
Dialogue: 0,0:20:27.00,0:20:28.00,Default,,0,0,0,,А?
Dialogue: 0,0:20:28.00,0:20:30.00,Default,,0,0,0,,Мен режиссер Миядзакимен танысқым келеді
Dialogue: 0,0:20:30.00,0:20:31.00,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:20:32.00,0:20:35.00,Default,,0,0,0,,Өйткені адам әлеміне бару үшін ақша керек.
Dialogue: 0,0:20:35.00,0:20:36.00,Default,,0,0,0,,Сізде бар ма?
Dialogue: 0,0:20:38.00,0:20:41.00,Default,,0,0,0,,Онда мен сізге қалай тез ақша табу керектігін көрсетемін.
Dialogue: 0,0:20:41.00,0:20:43.00,Default,,0,0,0,,Менімен жарысыңыз
Dialogue: 0,0:20:43.00,0:20:45.00,Default,,0,0,0,,Егер жеңсең, мен саған ақша беремін
Dialogue: 0,0:20:45.00,0:20:48.00,Default,,0,0,0,,Мен жеңсем, сен менің түбім боласың.
Dialogue: 0,0:20:48.00,0:20:49.00,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:20:49.00,0:20:50.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:20:53.00,0:20:54.00,Default,,0,0,0,,Мидория, рингтен шық.
Dialogue: 0,0:20:55.00,0:20:57.00,Default,,0,0,0,,Мен ашулансам ше?
Dialogue: 0,0:20:57.00,0:20:58.00,Default,,0,0,0,,Сіз ештеңе істеп жатқан жоқсыз.
Dialogue: 0,0:20:58.00,0:21:00.00,Default,,0,0,0,,Бұл әрқашан менің жұлқам болды
Dialogue: 0,0:21:00.00,0:21:02.00,Default,,0,0,0,,Сіз төбелеспейсіз.
Dialogue: 0,0:21:02.00,0:21:03.00,Default,,0,0,0,,Сабыр ет, Қасқыр.
Dialogue: 0,0:21:03.00,0:21:05.00,Default,,0,0,0,,Ол кішкентай ғана бала.
Dialogue: 0,0:21:05.00,0:21:06.00,Default,,0,0,0,,Қашу
Dialogue: 0,0:21:06.00,0:21:07.00,Default,,0,0,0,,Жоғарыдан құлаған
Dialogue: 0,0:21:07.00,0:21:08.00,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:21:08.00,0:21:10.00,Default,,0,0,0,,Сіз толыққанды жынсыз.
Dialogue: 0,0:21:10.00,0:21:11.00,Default,,0,0,0,,Иә, маған жауап беріңіз.
Dialogue: 0,0:21:11.00,0:21:13.00,Default,,0,0,0,,Неге менімен шындап ұрыспайсың?
Dialogue: 0,0:21:15.00,0:21:17.00,Default,,0,0,0,,Өйткені мен байыпты болдым.
Dialogue: 0,0:21:17.00,0:21:19.00,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:21:19.00,0:21:21.00,Default,,0,0,0,,Zendo Demon дегеніміз не?
Dialogue: 0,0:21:21.00,0:21:23.00,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:21:23.00,0:21:25.00,Default,,0,0,0,,Мен күштімін
Dialogue: 0,0:21:25.00,0:21:28.00,Default,,0,0,0,,Менің ойымша, журналдар арасында онша үлкен айырмашылық жоқ.
Dialogue: 0,0:21:28.00,0:21:30.00,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:21:30.00,0:21:32.00,Default,,0,0,0,,Шындығында, тіпті сіздің сиқырыңыз жабылған
Dialogue: 0,0:21:32.00,0:21:35.00,Default,,0,0,0,,Мейірім көрсетуге күші жетерлік.
Dialogue: 0,0:21:35.00,0:21:38.00,Default,,0,0,0,,Ол бар күшімен күресуге лайық емес еді.
Dialogue: 0,0:21:38.00,0:21:41.00,Default,,0,0,0,,Бұған қалай қанағаттануға болады?
Dialogue: 0,0:21:43.00,0:21:44.00,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:21:44.00,0:21:46.00,Default,,0,0,0,,Мен ақ пен қараға ораламын
Dialogue: 0,0:21:47.00,0:21:49.00,Default,,0,0,0,,Келесі жолы мен сені байсалдылыққа шақырамын.
Dialogue: 0,0:21:49.00,0:21:51.00,Default,,0,0,0,,Оны тіпті сізге де жібермеңіз.
Dialogue: 0,0:21:52.00,0:21:54.00,Default,,0,0,0,,Себебі мен әкемін
Dialogue: 0,0:21:55.00,0:21:57.00,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:21:57.00,0:21:58.00,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:21:58.00,0:22:00.00,Default,,0,0,0,,Сіздің де журналдарда достарыңыз болды.
Dialogue: 0,0:22:01.00,0:22:03.00,Default,,0,0,0,,Эй, сен неге төмендесің?
Dialogue: 0,0:22:03.00,0:22:05.00,Default,,0,0,0,,Ол кенет қай жерде пайда болды?
Dialogue: 0,0:22:05.00,0:22:07.00,Default,,0,0,0,,Лиздің жұмысы
Dialogue: 0,0:22:07.00,0:22:09.00,Default,,0,0,0,,Лиздің жұмысында.
Dialogue: 0,0:22:09.00,0:22:11.00,Default,,0,0,0,,Мені осында құрбым алып келді.
Dialogue: 0,0:22:11.00,0:22:15.00,Default,,0,0,0,,Менің ұстанымым ұзын болып бөлінеді.
Dialogue: 0,0:22:16.00,0:22:17.00,Default,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:22:17.00,0:22:20.00,Default,,0,0,0,,Бірақ ол ол туралы айтып тұрғандай емес.
Dialogue: 0,0:22:20.00,0:22:23.00,Default,,0,0,0,,Журналдардың өте жақсы достары бар, солай емес пе?
Dialogue: 0,0:22:23.00,0:22:24.00,Default,,0,0,0,,Сәлем, Лиз.
Dialogue: 0,0:22:24.00,0:22:25.00,Default,,0,0,0,,Бұл журнал болса да
Dialogue: 0,0:22:25.00,0:22:27.00,Default,,0,0,0,,Ой, балалар сендерге не болып жатыр?
Dialogue: 0,0:22:27.00,0:22:29.00,Default,,0,0,0,,Ісіңіз біткен соң, үйге тез қайтыңыз.
Dialogue: 0,0:22:29.00,0:22:31.00,Default,,0,0,0,,Менде әлі де бар.
Dialogue: 0,0:22:32.00,0:22:34.00,Default,,0,0,0,,Уәде етілген адам реанимациясы
Dialogue: 0,0:22:34.00,0:22:36.00,Default,,0,0,0,,Мен ұмытқан сияқты емеспін.
Dialogue: 0,0:22:37.00,0:22:41.00,Default,,0,0,0,,Алдымен өмірге қайта оралғысы келетін қызбен танысайық.
Dialogue: 0,0:22:44.00,0:22:47.00,Default,,0,0,0,,Сізбен кездескісі келетін сезімдер
Dialogue: 0,0:22:47.00,0:22:50.00,Default,,0,0,0,,Облигацияларға айналу
Dialogue: 0,0:22:50.00,0:22:56.00,Default,,0,0,0,,Сізге жету үшін барайық
Dialogue: 0,0:23:08.00,0:23:10.00,Default,,0,0,0,,Адал болыңыз
Dialogue: 0,0:23:10.00,0:23:13.00,Default,,0,0,0,,Бұл қиын, солай емес пе?
Dialogue: 0,0:23:13.00,0:23:16.00,Default,,0,0,0,,Мен неге күшейемін?
Dialogue: 0,0:23:16.00,0:23:19.00,Default,,0,0,0,,Мұң күшейеді
Dialogue: 0,0:23:20.00,0:23:22.00,Default,,0,0,0,,Мен не айтқым келеді
Dialogue: 0,0:23:22.00,0:23:25.00,Default,,0,0,0,,Олар өте көп.
Dialogue: 0,0:23:25.00,0:23:28.00,Default,,0,0,0,,Тек мағынасы жоқ сөздер
Dialogue: 0,0:23:28.00,0:23:31.00,Default,,0,0,0,,Толып жатыр, тоқтамайды
Dialogue: 0,0:23:31.00,0:23:33.00,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:23:33.00,0:23:37.00,Default,,0,0,0,,Бір ғана сөз
Dialogue: 0,0:23:37.00,0:23:41.00,Default,,0,0,0,,Маған неге айта алмайсың?
Dialogue: 0,0:23:41.00,0:23:44.00,Default,,0,0,0,,Сіз мені сезінесіз бе?
Dialogue: 0,0:23:45.00,0:23:47.00,Default,,0,0,0,,Екі фьючерс
Dialogue: 0,0:23:47.00,0:23:50.00,Default,,0,0,0,,Шөпті шығарайық
Dialogue: 0,0:23:50.00,0:23:53.00,Default,,0,0,0,,Сақина саусақтағы қызыл лирон
Dialogue: 0,0:23:53.00,0:23:56.00,Default,,0,0,0,,Оны мықтап байлаңыз
Dialogue: 0,0:23:56.00,0:23:59.00,Default,,0,0,0,,Сізге қарай жүгіру
Dialogue: 0,0:23:59.00,0:24:02.00,Default,,0,0,0,,Ғашық жұлдыз
Dialogue: 0,0:24:02.00,0:24:07.00,Default,,0,0,0,,Үлкен күлімсіреп
Dialogue: 0,0:24:07.00,0:24:11.00,Default,,0,0,0,,Барып алайық
Dialogue: 0,0:24:32.00,0:24:35.00,Default,,0,0,0,,Жындар әлемінде тек жаман балалар бар.
Dialogue: 0,0:24:36.50,0:24:42.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
