Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.00,Default,,0,0,0,,Мұқият тыңдаңыз!
Dialogue: 0,0:00:02.00,0:00:04.00,Default,,0,0,0,,Осы сәтте
Dialogue: 0,0:00:04.00,0:00:07.00,Default,,0,0,0,,Бұл аумақ біздің бақылауымызда болады!
Dialogue: 0,0:00:07.00,0:00:09.00,Default,,0,0,0,,Есіңізде болсын!
Dialogue: 0,0:00:09.00,0:00:12.00,Default,,0,0,0,,Жоғарғы аумақтық бастық қайда?
Dialogue: 0,0:00:12.00,0:00:14.00,Default,,0,0,0,,Ел аралайтын бастықтар арасындағы бастық!
Dialogue: 0,0:00:14.00,0:00:17.00,Default,,0,0,0,,Біздің патшамыз! Король Қасқырдың аты!
Dialogue: 0,0:00:17.00,0:00:19.00,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:00:19.00,0:00:21.00,Default,,0,0,0,,Мен саған тоқтаңдар дедім.
Dialogue: 0,0:00:21.00,0:00:23.00,Default,,0,0,0,,Әр жолы оның жанында
Dialogue: 0,0:00:23.00,0:00:25.00,Default,,0,0,0,,Маған рұқсат етіңізші.
Dialogue: 0,0:00:25.00,0:00:27.00,Default,,0,0,0,,Бұл жақсы сезінеді
Dialogue: 0,0:00:27.00,0:00:29.00,Default,,0,0,0,,Мен әлі бәрін жеңген жоқпын.
Dialogue: 0,0:00:29.00,0:00:31.00,Default,,0,0,0,,Содан кейін жаулап алған Акацукиге,
Dialogue: 0,0:00:32.00,0:00:33.00,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:00:33.00,0:00:35.00,Default,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:00:35.00,0:00:36.00,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:00:36.00,0:00:39.00,Default,,0,0,0,,Мына жігіттердің бәрі шайнайтын балыққа толы.
Dialogue: 0,0:00:39.00,0:00:40.00,Default,,0,0,0,,Қызықты
Dialogue: 0,0:00:57.00,0:01:01.00,Default,,0,0,0,,Мен қазір қарап отырған көрініс мынау
Dialogue: 0,0:01:01.00,0:01:04.00,Default,,0,0,0,,Ол өшіп қалды
Dialogue: 0,0:01:04.00,0:01:09.00,Default,,0,0,0,,Тек өткен шақ әрқашан жарқырап тұратын
Dialogue: 0,0:01:09.00,0:01:14.00,Default,,0,0,0,,Айтса да, көрген емеспін.
Dialogue: 0,0:01:15.00,0:01:20.00,Default,,0,0,0,,Мені түсінгім келмейді
Dialogue: 0,0:01:20.00,0:01:23.00,Default,,0,0,0,,Түсінбеу керек
Dialogue: 0,0:01:23.00,0:01:24.00,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:01:24.00,0:01:28.00,Default,,0,0,0,,Тек сіз үшін
Dialogue: 0,0:01:28.00,0:01:34.00,Default,,0,0,0,,Мен нақты сөзбен айтқым келеді
Dialogue: 0,0:01:35.00,0:01:37.00,Default,,0,0,0,,Нәресте сәби сәби сәби
Dialogue: 0,0:01:37.00,0:01:39.00,Default,,0,0,0,,Ой!
Dialogue: 0,0:01:39.00,0:01:41.00,Default,,0,0,0,,Бұл дүние
Dialogue: 0,0:01:41.00,0:01:45.00,Default,,0,0,0,,Ашық боялған
Dialogue: 0,0:01:45.00,0:01:47.00,Default,,0,0,0,,Нәресте бала, бала жоқ
Dialogue: 0,0:01:47.00,0:01:49.00,Default,,0,0,0,,Әлі ақ
Dialogue: 0,0:01:50.00,0:01:51.00,Default,,0,0,0,,Нәресте бала, бала жоқ
Dialogue: 0,0:01:51.00,0:01:53.00,Default,,0,0,0,,Әлі ақ
Dialogue: 0,0:01:53.00,0:01:56.00,Default,,0,0,0,,Болашақты қолға алғандай
Dialogue: 0,0:01:56.00,0:01:59.00,Default,,0,0,0,,Flying OS кремі
Dialogue: 0,0:01:59.00,0:02:03.00,Default,,0,0,0,,Егер сіз суретіңізді алып тастасаңыз
Dialogue: 0,0:02:03.00,0:02:05.00,Default,,0,0,0,,Оны жасырмаңыз
Dialogue: 0,0:02:05.00,0:02:09.00,Default,,0,0,0,,Мүмкін жеңіс
Dialogue: 0,0:02:19.00,0:02:21.00,Default,,0,0,0,,Қасқыр меннен зиялы бөлек.
Dialogue: 0,0:02:21.00,0:02:24.00,Default,,0,0,0,,Ол өзінің күшін айтуды ұмытатын жынның түрі.
Dialogue: 0,0:02:24.00,0:02:26.00,Default,,0,0,0,,Барания
Dialogue: 0,0:02:26.00,0:02:28.00,Default,,0,0,0,,Дүкен менеджері күткендей
Dialogue: 0,0:02:28.00,0:02:30.00,Default,,0,0,0,,Сіздің бүлікшіл сезіміңіз жарқырайды.
Dialogue: 0,0:02:30.00,0:02:32.00,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:02:32.00,0:02:34.00,Default,,0,0,0,,Балалар тыңдап тұрсыңдар ма?
Dialogue: 0,0:02:34.00,0:02:37.00,Default,,0,0,0,,Себебі мені қызықтырмайды.
Dialogue: 0,0:02:37.00,0:02:38.00,Default,,0,0,0,,Сен
Dialogue: 0,0:02:38.00,0:02:40.00,Default,,0,0,0,,Таныс болсақ жақсы болар еді.
Dialogue: 0,0:02:40.00,0:02:42.00,Default,,0,0,0,,Сұрасаңыз, адам денесінің жаратылуы.
Dialogue: 0,0:02:42.00,0:02:43.00,Default,,0,0,0,,Бізге қосылыңыз
Dialogue: 0,0:02:43.00,0:02:45.00,Default,,0,0,0,,Бұл оңай ма?
Dialogue: 0,0:02:45.00,0:02:47.00,Default,,0,0,0,,Ол екеуміздің бала кезден дос болғанымыз рас.
Dialogue: 0,0:02:47.00,0:02:50.00,Default,,0,0,0,,Енді мен де оның арқанын үзе аламын.
Dialogue: 0,0:02:50.00,0:02:51.00,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:02:51.00,0:02:53.00,Default,,0,0,0,,Күш-қуатымды пайдаланып, тез жүруді қалаймын.
Dialogue: 0,0:02:53.00,0:02:54.00,Default,,0,0,0,,Тетино
Dialogue: 0,0:02:54.00,0:02:56.00,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:02:57.00,0:02:58.00,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:02:58.00,0:03:00.00,Default,,0,0,0,,Маған адамдарды пайдалану ұнайды, бірақ
Dialogue: 0,0:03:00.00,0:03:03.00,Default,,0,0,0,,Мен пайдаланғанды жек көремін.
Dialogue: 0,0:03:03.00,0:03:04.00,Default,,0,0,0,,OK
Dialogue: 0,0:03:04.00,0:03:06.00,Default,,0,0,0,,Балалар, сендер адамдарды пайдаланасыңдар ма?
Dialogue: 0,0:03:06.00,0:03:08.00,Default,,0,0,0,,Балалар, сендер адамдарды пайдаланасыңдар ма?
Dialogue: 0,0:03:08.00,0:03:10.00,Default,,0,0,0,,Балалар, сендер адамдарды пайдаланасыңдар ма?
Dialogue: 0,0:03:10.00,0:03:12.00,Default,,0,0,0,,Мен пайдаланғанды ​​жек көремін.
Dialogue: 0,0:03:12.00,0:03:13.00,Default,,0,0,0,,OK
Dialogue: 0,0:03:13.00,0:03:15.00,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:03:15.00,0:03:18.00,Default,,0,0,0,,Бұл жағдайда күш қолданыңыз
Dialogue: 0,0:03:19.00,0:03:21.00,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:03:26.00,0:03:27.00,Default,,0,0,0,,онда Цуки-кунге қатысты күдік мүлде сейіледі.
Dialogue: 0,0:03:27.00,0:03:30.00,Default,,0,0,0,,Одан басқа сондай бейбіт күн.
Dialogue: 0,0:03:30.00,0:03:32.00,Default,,0,0,0,,Сынақ күшіне толы
Dialogue: 0,0:03:32.00,0:03:34.00,Default,,0,0,0,,Йошида да жақсырақ болды.
Dialogue: 0,0:03:34.00,0:03:36.00,Default,,0,0,0,,Менің ойымша, бәрі жақсы.
Dialogue: 0,0:03:36.00,0:03:39.00,Default,,0,0,0,,Біз мұны өзіміз жасай аламыз.
Dialogue: 0,0:03:39.00,0:03:40.00,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:03:40.00,0:03:41.00,Default,,0,0,0,,Деку
Dialogue: 0,0:03:42.00,0:03:43.00,Default,,0,0,0,,Не?
Dialogue: 0,0:03:44.00,0:03:46.00,Default,,0,0,0,,Бұл жүзі жақсы.
Dialogue: 0,0:03:46.00,0:03:47.00,Default,,0,0,0,,Йошида Оме
Dialogue: 0,0:03:47.00,0:03:48.00,Default,,0,0,0,,Сіз қолдарыңызды көтердіңіз.
Dialogue: 0,0:03:48.00,0:03:49.00,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:03:56.00,0:03:58.00,Default,,0,0,0,,Ең жақсы бастық
Dialogue: 0,0:04:09.00,0:04:10.00,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:04:10.00,0:04:12.00,Default,,0,0,0,,Маған кейінірек қайтаруыңызды өтінемін.
Dialogue: 0,0:04:13.00,0:04:14.00,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:04:14.00,0:04:16.00,Default,,0,0,0,,Не болды, бастық?
Dialogue: 0,0:04:16.00,0:04:18.00,Default,,0,0,0,,Мыжып қалма, балақай.
Dialogue: 0,0:04:18.00,0:04:19.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:04:19.00,0:04:20.00,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:04:20.00,0:04:24.00,Default,,0,0,0,,Мені өз соққым соқты.
Dialogue: 0,0:04:25.00,0:04:26.00,Default,,0,0,0,,Миссия үшін,
Dialogue: 0,0:04:26.00,0:04:28.00,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:04:29.00,0:04:30.00,Default,,0,0,0,,Сол әйел
Dialogue: 0,0:04:35.00,0:04:37.00,Default,,0,0,0,,Бұл келесі жолы орын алса, ол тегін болады.
Dialogue: 0,0:04:37.00,0:04:39.00,Default,,0,0,0,,Қазір жақсысың ба?
Dialogue: 0,0:04:40.00,0:04:42.00,Default,,0,0,0,,Жындар әлемінің атмосферасы осындай.
Dialogue: 0,0:04:42.00,0:04:44.00,Default,,0,0,0,,Бастық күткендей
Dialogue: 0,0:04:44.00,0:04:47.00,Default,,0,0,0,,Өлтірсе де өлмейтін адам
Dialogue: 0,0:04:48.00,0:04:49.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:04:49.00,0:04:50.00,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:04:50.00,0:04:52.00,Default,,0,0,0,,Тағы барайын ба?
Dialogue: 0,0:04:52.00,0:04:54.00,Default,,0,0,0,,Батыс жындар әлемі
Dialogue: 0,0:05:02.00,0:05:04.00,Default,,0,0,0,,Бұл Қасқырдың аумағы.
Dialogue: 0,0:05:07.00,0:05:08.00,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:05:08.00,0:05:10.00,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:05:13.00,0:05:16.00,Default,,0,0,0,,Сіз өзіңіз баруды шешкен сияқтысыз.
Dialogue: 0,0:05:16.00,0:05:19.00,Default,,0,0,0,,Одан да жаман болмай, мені ертіп кеткенің дұрыс болар еді.
Dialogue: 0,0:05:19.00,0:05:21.00,Default,,0,0,0,,Сіз түсінбейсіз, менеджер.
Dialogue: 0,0:05:21.00,0:05:24.00,Default,,0,0,0,,Мен бұған әлі де күмәнданамын.
Dialogue: 0,0:05:24.00,0:05:27.00,Default,,0,0,0,,Сиқырлы ұры туралы
Dialogue: 0,0:05:27.00,0:05:30.00,Default,,0,0,0,,Мен Винтер Митч өтірік айтады деп ойламаймын.
Dialogue: 0,0:05:30.00,0:05:34.00,Default,,0,0,0,,Мен сондай-ақ Stazz 100% ақ деп ойламаймын.
Dialogue: 0,0:05:34.00,0:05:37.00,Default,,0,0,0,,Ол көптеген сиқырлы күштерді жасырады.
Dialogue: 0,0:05:37.00,0:05:41.00,Default,,0,0,0,,Бірақ мен сенің сиқырыңды ұрлай аламын ба деп ойлаймын?
Dialogue: 0,0:05:41.00,0:05:44.00,Default,,0,0,0,,Міне, мен растағым келеді.
Dialogue: 0,0:05:44.00,0:05:49.00,Default,,0,0,0,,Ол қиын бала, сондықтан мен оны қызықтыратын бала деп айта алмаймын.
Dialogue: 0,0:05:49.00,0:05:52.00,Default,,0,0,0,,Мен жай ғана қылмыскерді тапқым келеді.
Dialogue: 0,0:05:52.00,0:05:55.00,Default,,0,0,0,,Кінәлі Дарлинг болуы керек, солай ма?
Dialogue: 0,0:05:57.00,0:06:00.00,Default,,0,0,0,,Жарайсыңдар, балалар дайынсыңдар ма?
Dialogue: 0,0:06:00.00,0:06:02.00,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:06:02.00,0:06:04.00,Default,,0,0,0,,Адамдардың бірге жүруі және адамдарды қоршауы
Dialogue: 0,0:06:04.00,0:06:07.00,Default,,0,0,0,,Сондықтан мен де баруым керек.
Dialogue: 0,0:06:07.00,0:06:10.00,Default,,0,0,0,,Мойынды қаттырақ қатайтыңыз
Dialogue: 0,0:06:10.00,0:06:13.00,Default,,0,0,0,,Бастық себеті реттелді.
Dialogue: 0,0:06:13.00,0:06:14.00,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:06:14.00,0:06:15.00,Default,,0,0,0,,Себет?
Dialogue: 0,0:06:15.00,0:06:16.00,Default,,0,0,0,,Себет дегеніміз не?
Dialogue: 0,0:06:18.00,0:06:20.00,Default,,0,0,0,,Сіз бірден келдіңіз.
Dialogue: 0,0:06:25.00,0:06:27.00,Default,,0,0,0,,Сіз жын әлемінің кез келген жеріне бара аласыз
Dialogue: 0,0:06:27.00,0:06:29.00,Default,,0,0,0,,Хатомды тасымалдау
Dialogue: 0,0:06:29.00,0:06:31.00,Default,,0,0,0,,Осы арқылы мен сізден Батыс жындар әлеміне баруыңызды сұраймын.
Dialogue: 0,0:06:33.00,0:06:37.00,Default,,0,0,0,,Бастық, кәрзеңкені шақырайық.
Dialogue: 0,0:06:37.00,0:06:39.00,Default,,0,0,0,,Сенің жігерің жоқ, бейбақ.
Dialogue: 0,0:06:39.00,0:06:40.00,Default,,0,0,0,,Мен бірдеңе айтсам да
Dialogue: 0,0:06:40.00,0:06:44.00,Default,,0,0,0,,Бұл жерден біздің базаға дейін әлі 500 шақырым.
Dialogue: 0,0:06:48.00,0:06:51.00,Default,,0,0,0,,Мен жылдаммын, бірақ санауда баяумын.
Dialogue: 0,0:06:51.00,0:06:54.00,Default,,0,0,0,,Әй, сен мынаны мініп барасың ба?
Dialogue: 0,0:06:54.00,0:06:56.00,Default,,0,0,0,,Босс
Dialogue: 0,0:06:56.00,0:06:57.00,Default,,0,0,0,,Себет
Dialogue: 0,0:06:57.00,0:06:58.00,Default,,0,0,0,,Хо
Dialogue: 0,0:06:58.00,0:07:01.00,Default,,0,0,0,,Себетті оқу жылдамырақ дейді.
Dialogue: 0,0:07:01.00,0:07:03.00,Default,,0,0,0,,Не?
Dialogue: 0,0:07:04.00,0:07:07.00,Default,,0,0,0,,Менің аяғым себетке қарағанда баяу.
Dialogue: 0,0:07:07.00,0:07:08.00,Default,,0,0,0,,О
Dialogue: 0,0:07:08.00,0:07:11.00,Default,,0,0,0,,Жоқ, бұл менің айтқым келгені емес.
Dialogue: 0,0:07:11.00,0:07:14.00,Default,,0,0,0,,Қараңдаршы, енді бастық Батыс Жындар әлемінің жұлдызы.
Dialogue: 0,0:07:14.00,0:07:17.00,Default,,0,0,0,,Жанкүйерлер менің қолтаңбамды сұрай ма деп ойлаймын.
Dialogue: 0,0:07:17.00,0:07:21.00,Default,,0,0,0,,Мен кеткенше қыздардың қатары болатынына сенімдімін.
Dialogue: 0,0:07:23.00,0:07:25.00,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:07:28.00,0:07:32.00,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл жын әлеміндегі ең жылдам секіріс.
Dialogue: 0,0:07:32.00,0:07:35.00,Default,,0,0,0,,Өтінемін, осы тізбекті алып тастаңыз.
Dialogue: 0,0:07:35.00,0:07:37.00,Default,,0,0,0,,Жер мен құм жоғарыдан құлағалы тұр.
Dialogue: 0,0:07:37.00,0:07:40.00,Default,,0,0,0,,Одан гөрі сіздің кезегіңіз.
Dialogue: 0,0:07:40.00,0:07:41.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:07:41.00,0:07:44.00,Default,,0,0,0,,Осы жерден Батыс жындар әлеміне дейін басқа біреудің аумағы.
Dialogue: 0,0:07:44.00,0:07:47.00,Default,,0,0,0,,Содан кейін сіздің Үшінші Аидаңыз
Dialogue: 0,0:07:47.00,0:07:50.00,Default,,0,0,0,,Біреуді басқа бастықтармен 8 сәйкестікке әкелмейтін маршрут бойынша шарлауын сұраңыз.
Dialogue: 0,0:07:50.00,0:07:52.00,Default,,0,0,0,,Біреу кенеттен солай айтса да
Dialogue: 0,0:07:52.00,0:07:54.00,Default,,0,0,0,,Маған Сати керек.
Dialogue: 0,0:07:54.00,0:07:56.00,Default,,0,0,0,,А, мен оны көріп тұрмын.
Dialogue: 0,0:07:56.00,0:07:58.00,Default,,0,0,0,,Жоқ, мен оны көргім келеді.
Dialogue: 0,0:07:58.00,0:08:00.00,Default,,0,0,0,,Менің ойымша, жақын жерде болған дұрыс.
Dialogue: 0,0:08:00.00,0:08:02.00,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:08:02.00,0:08:04.00,Default,,0,0,0,,Болжау
Dialogue: 0,0:08:04.00,0:08:06.00,Default,,0,0,0,,Бүркіт көзі
Dialogue: 0,0:08:12.00,0:08:13.00,Default,,0,0,0,,Уау
Dialogue: 0,0:08:13.00,0:08:14.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:14.00,0:08:16.00,Default,,0,0,0,,Енді тоқта, мені ұрасың!
Dialogue: 0,0:08:16.00,0:08:19.00,Default,,0,0,0,,Сіз келген сияқтысыз.
Dialogue: 0,0:08:21.00,0:08:23.00,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:08:23.00,0:08:24.00,Default,,0,0,0,,Ол мүлдем бәсеңдемейді.
Dialogue: 0,0:08:24.00,0:08:27.00,Default,,0,0,0,,Эй, осы жерден тоқта!
Dialogue: 0,0:08:29.00,0:08:31.00,Default,,0,0,0,,Уф, бұл қорқынышты.
Dialogue: 0,0:08:40.00,0:08:41.00,Default,,0,0,0,,Ол тоқтатылды.
Dialogue: 0,0:08:41.00,0:08:43.00,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:49.00,0:08:50.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:08:51.00,0:08:54.00,Default,,0,0,0,,Көптен бері көрмегелі, Қасқыр бала
Dialogue: 0,0:08:54.00,0:08:57.00,Default,,0,0,0,,Мені сол атпен атайтын жалғыз сенсің
Dialogue: 0,0:08:57.00,0:08:58.00,Default,,0,0,0,,Қанды шие
Dialogue: 0,0:08:58.00,0:09:00.00,Default,,0,0,0,,Скрудж
Dialogue: 0,0:09:01.00,0:09:04.00,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:09:05.00,0:09:08.00,Default,,0,0,0,,Мен мұны сақтай алмаймын.
Dialogue: 0,0:09:08.00,0:09:10.00,Default,,0,0,0,,Жөндеу стенді
Dialogue: 0,0:09:13.00,0:09:16.00,Default,,0,0,0,,Жоқ, сондықтан
Dialogue: 0,0:09:20.00,0:09:21.00,Default,,0,0,0,,Уф
Dialogue: 0,0:09:21.00,0:09:22.00,Default,,0,0,0,,Уф
Dialogue: 0,0:09:28.00,0:09:30.00,Default,,0,0,0,,Көп уақыт болды, солай емес пе, Стаз?
Dialogue: 0,0:09:30.00,0:09:32.00,Default,,0,0,0,,Сіз де өзгерген жоқсыз.
Dialogue: 0,0:09:32.00,0:09:34.00,Default,,0,0,0,,Кешіріңіз, себетті сындырып, күтіңіз.
Dialogue: 0,0:09:34.00,0:09:37.00,Default,,0,0,0,,Жоқ, мен сені көруге бара жатыр едім.
Dialogue: 0,0:09:37.00,0:09:38.00,Default,,0,0,0,,Тым көп күш салу
Dialogue: 0,0:09:38.00,0:09:39.00,Default,,0,0,0,,Бұл таныс сияқты.
Dialogue: 0,0:09:39.00,0:09:40.00,Default,,0,0,0,,Сол бет
Dialogue: 0,0:09:40.00,0:09:42.00,Default,,0,0,0,,Соңғы кездері ешқайсымызға көрсетпесем де.
Dialogue: 0,0:09:42.00,0:09:44.00,Default,,0,0,0,,Сіз қағазды қидыңыз
Dialogue: 0,0:09:44.00,0:09:48.00,Default,,0,0,0,,Мынау қыңыр нәрсе.
Dialogue: 0,0:09:54.00,0:09:58.00,Default,,0,0,0,,Бастық сізді бағалайды.
Dialogue: 0,0:09:59.00,0:10:01.00,Default,,0,0,0,,Пэйшн Скейн
Dialogue: 0,0:10:01.00,0:10:03.00,Default,,0,0,0,,Бірақ сізде ондай ақша бар
Dialogue: 0,0:10:03.00,0:10:05.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:10:07.00,0:10:09.00,Default,,0,0,0,,Адам денесінің жасалу кітабы
Dialogue: 0,0:10:10.00,0:10:13.00,Default,,0,0,0,,Жаратылыс кітабын жазуға рұқсат етіңіз.
Dialogue: 0,0:10:14.00,0:10:17.00,Default,,0,0,0,,Мен сондай қиын кітапты оқимын деп ойлайсың ба?
Dialogue: 0,0:10:17.00,0:10:18.00,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:10:18.00,0:10:21.00,Default,,0,0,0,,Олай болса, бастықтың рұқсатымен іздеуге көмектесе аласыз ба?
Dialogue: 0,0:10:21.00,0:10:22.00,Default,,0,0,0,,болып табылады
Dialogue: 0,0:10:22.00,0:10:25.00,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:10:25.00,0:10:26.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:26.00,0:10:29.00,Default,,0,0,0,,Қазір менің территориямның қаншалықты үлкен екенін білмейсің.
Dialogue: 0,0:10:31.00,0:10:34.00,Default,,0,0,0,,Батыс жын-шайтан әлемінің көпшілігі осындай.
Dialogue: 0,0:10:34.00,0:10:35.00,Default,,0,0,0,,Мұндай қиыншылықтар
Dialogue: 0,0:10:35.00,0:10:37.00,Default,,0,0,0,,Мен оны жай ғана бере алмаймын.
Dialogue: 0,0:10:37.00,0:10:38.00,Default,,0,0,0,,Ақыр соңында?
Dialogue: 0,0:10:38.00,0:10:41.00,Default,,0,0,0,,Олай болса шешеміз.
Dialogue: 0,0:10:41.00,0:10:43.00,Default,,0,0,0,,Ескі әдіс
Dialogue: 0,0:10:45.00,0:10:48.00,Default,,0,0,0,,Жеңіске жетсем, кітапты тауып беруіңді сұраймын.
Dialogue: 0,0:10:48.00,0:10:50.00,Default,,0,0,0,,Егер мен жеңсем
Dialogue: 0,0:10:52.00,0:10:54.00,Default,,0,0,0,,Мына әйелді орындайық
Dialogue: 0,0:10:54.00,0:10:55.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:10:55.00,0:10:56.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:56.00,0:10:58.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:00.00,0:11:01.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:11:01.00,0:11:02.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:02.00,0:11:04.00,Default,,0,0,0,,Бұл менің хоббиім емес.
Dialogue: 0,0:11:04.00,0:11:06.00,Default,,0,0,0,,Неліктен сізде бар?
Dialogue: 0,0:11:06.00,0:11:07.00,Default,,0,0,0,,О.
Dialogue: 0,0:11:11.00,0:11:14.00,Default,,0,0,0,,Менің түрім шынымен де жиіркенішті болды ма?
Dialogue: 0,0:11:15.00,0:11:16.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:16.00,0:11:18.00,Default,,0,0,0,,Ол осылайша қуанады.
Dialogue: 0,0:11:22.00,0:11:23.00,Default,,0,0,0,,Боулинг
Dialogue: 0,0:11:23.00,0:11:24.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:24.00,0:11:26.00,Default,,0,0,0,,Боулингке келгенде ешқашан жеңілуге болмайды
Dialogue: 0,0:11:27.00,0:11:28.00,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:11:28.00,0:11:30.00,Default,,0,0,0,,Мен сіздің қаншалықты жақсы екеніңізді білмеймін.
Dialogue: 0,0:11:30.00,0:11:32.00,Default,,0,0,0,,Бірдеңе болуы әбден мүмкін емес пе?
Dialogue: 0,0:11:33.00,0:11:34.00,Default,,0,0,0,,Сіз солай ойлайсыз.
Dialogue: 0,0:11:34.00,0:11:37.00,Default,,0,0,0,,Бірақ Қасқыр екеуміз әр түрлі жындармыз.
Dialogue: 0,0:11:37.00,0:11:40.00,Default,,0,0,0,,Мен сиқырлы күшті ағынды түрде қолданатын жынның түрімін.
Dialogue: 0,0:11:40.00,0:11:42.00,Default,,0,0,0,,Қашықтықтан шабуыл жасауда жақсы
Dialogue: 0,0:11:43.00,0:11:46.00,Default,,0,0,0,,Ал әлгі жігіт өзінің сиқырлы күшін өз денесіне басып алды.
Dialogue: 0,0:11:46.00,0:11:48.00,Default,,0,0,0,,Ол өзін-өзі күшейтетін тип.
Dialogue: 0,0:11:48.00,0:11:51.00,Default,,0,0,0,,Мен өзімнің ерекше күшіммен тікелей соққы бергенді ұнатамын.
Dialogue: 0,0:11:51.00,0:11:56.00,Default,,0,0,0,,Ендеше оның қолынан келетіні бар күшімен допты лақтыру.
Dialogue: 0,0:11:57.00,0:12:01.00,Default,,0,0,0,,Мен допты түйреуішке дейін жылжыта аламын.
Dialogue: 0,0:12:01.00,0:12:03.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:03.00,0:12:05.00,Default,,0,0,0,,Соңында кім жеңеді?
Dialogue: 0,0:12:07.00,0:12:09.00,Default,,0,0,0,,Сіз дайын сияқтысыз.
Dialogue: 0,0:12:15.00,0:12:18.00,Default,,0,0,0,,Эй, эй, ойын боулингке айналды.
Dialogue: 0,0:12:19.00,0:12:24.00,Default,,0,0,0,,Тіпті боулинг пен бокста үшеуі ғана сәйкес келеді: Бо және Хунг.
Dialogue: 0,0:12:25.00,0:12:26.00,Default,,0,0,0,,Бұл өте жақсы сәйкес келеді.
Dialogue: 0,0:12:27.00,0:12:31.00,Default,,0,0,0,,Сен ақымақсың ба? Егер сіз мұндай жекпе-жекті қабылдасаңыз, жеңу мүмкін емес.
Dialogue: 0,0:12:31.00,0:12:33.00,Default,,0,0,0,,Сен тітіркендірдің, Джиро.
Dialogue: 0,0:12:34.00,0:12:36.00,Default,,0,0,0,,Қаһарлы қыс.
Dialogue: 0,0:12:38.00,0:12:41.00,Default,,0,0,0,,Мен оны міндетті түрде қолыммен тірілтемін.
Dialogue: 0,0:12:42.00,0:12:44.00,Default,,0,0,0,,Мен оны ешқашан Қасқырға бермес едім.
Dialogue: 0,0:12:45.00,0:12:47.00,Default,,0,0,0,,Кешігіп қалдың, жігітім.
Dialogue: 0,0:12:47.00,0:12:49.00,Default,,0,0,0,,Ол қашып кеткен шығар.
Dialogue: 0,0:12:49.00,0:12:51.00,Default,,0,0,0,,Әйел осында сақталады.
Dialogue: 0,0:12:51.00,0:12:53.00,Default,,0,0,0,,Мен ешқайда бармаймын
Dialogue: 0,0:12:53.00,0:12:54.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:12:55.00,0:12:58.00,Default,,0,0,0,,Бұл костюмнің бір түрі ме?
Dialogue: 0,0:12:58.00,0:13:01.00,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:13:01.00,0:13:03.00,Default,,0,0,0,,Дөңгелек қыз деп аталады.
Dialogue: 0,0:13:03.00,0:13:09.00,Default,,0,0,0,,Жарайды, бұл мектептегі купальник, бірақ ол бұрмаланған. Осылай киінген.
Dialogue: 0,0:13:10.00,0:13:11.00,Default,,0,0,0,,Босс
Dialogue: 0,0:13:12.00,0:13:14.00,Default,,0,0,0,,Бұл әйел салмақты!
Dialogue: 0,0:13:15.00,0:13:17.00,Default,,0,0,0,,Мен ешқашан әйелдің қобалжуын күткен емеспін.
Dialogue: 0,0:13:17.00,0:13:21.00,Default,,0,0,0,,Идиот, бұл қазіргі кездегі балалар мангасы тіпті жаман реакция емес.
Dialogue: 0,0:13:22.00,0:13:24.00,Default,,0,0,0,,Кішкентай жануар сияқты ауыр
Dialogue: 0,0:13:24.00,0:13:28.00,Default,,0,0,0,,Мен өзімді нәзік сезінемін, сондықтан жындар әлемінде жалғыз өмір сүре алмаймын деп ойлаймын.
Dialogue: 0,0:13:30.00,0:13:31.00,Default,,0,0,0,,Усаги-чан
Dialogue: 0,0:13:34.00,0:13:35.00,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:13:35.00,0:13:38.00,Default,,0,0,0,,Ол сүйкімді, оны қорғаңыз.
Dialogue: 0,0:13:39.00,0:13:40.00,Default,,0,0,0,,Бұл ойын
Dialogue: 0,0:13:41.00,0:13:43.00,Default,,0,0,0,,Біз мүлдем ұтылуға болмайды.
Dialogue: 0,0:13:45.00,0:13:47.00,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:13:47.00,0:13:50.00,Default,,0,0,0,,Мен батыстағы досыма қарызға ақша бере аламын.
Dialogue: 0,0:13:50.00,0:13:52.00,Default,,0,0,0,,Сол ақшаны қайтарып алсам ғой
Dialogue: 0,0:13:55.00,0:13:56.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:56.00,0:14:00.00,Default,,0,0,0,,Ол боксқа ақша салған көрінеді.
Dialogue: 0,0:14:00.00,0:14:02.00,Default,,0,0,0,,Мен жеңсем, оны қайтарамын.
Dialogue: 0,0:14:05.00,0:14:06.00,Default,,0,0,0,,Демонстрация
Dialogue: 0,0:14:06.00,0:14:07.00,Default,,0,0,0,,Қорап
Dialogue: 0,0:14:15.00,0:14:16.00,Default,,0,0,0,,Жырақта!
Dialogue: 0,0:14:17.00,0:14:18.00,Default,,0,0,0,,Кенеттен бұл клинч.
Dialogue: 0,0:14:18.00,0:14:20.00,Default,,0,0,0,,Мен сенің не ойлап тұрғаныңды білмеймін.
Dialogue: 0,0:14:20.00,0:14:22.00,Default,,0,0,0,,Мені жеңу мүмкін емес
Dialogue: 0,0:14:24.00,0:14:25.00,Default,,0,0,0,,Бір соққы
Dialogue: 0,0:14:25.00,0:14:27.00,Default,,0,0,0,,Соққы батып кетті
Dialogue: 0,0:14:28.00,0:14:30.00,Default,,0,0,0,,Иә, рас па?
Dialogue: 0,0:14:30.00,0:14:33.00,Default,,0,0,0,,Бұл жай ғана менің қиялым болды ма?
Dialogue: 0,0:14:33.00,0:14:34.00,Default,,0,0,0,,Стаз мырза
Dialogue: 0,0:14:34.00,0:14:35.00,Default,,0,0,0,,7
Dialogue: 0,0:14:35.00,0:14:36.00,Default,,0,0,0,,Өйткені Staz
Dialogue: 0,0:14:36.00,0:14:37.00,Default,,0,0,0,,8
Dialogue: 0,0:14:37.00,0:14:38.00,Default,,0,0,0,,9
Dialogue: 0,0:14:38.00,0:14:39.00,Default,,0,0,0,,Стаз мырза
Dialogue: 0,0:14:41.00,0:14:43.00,Default,,0,0,0,,Сіз жақсы түс көрдіңіз бе?
Dialogue: 0,0:14:44.00,0:14:46.00,Default,,0,0,0,,Бұл ұйықтау таңқаларлық ыңғайлы болды.
Dialogue: 0,0:14:46.00,0:14:49.00,Default,,0,0,0,,Олай болса маған қайтадан ұйықтауға рұқсат етіңіз.
Dialogue: 0,0:14:49.00,0:14:50.00,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:14:50.00,0:14:51.00,Default,,0,0,0,,Бұл әлі де жақын шайқас
Dialogue: 0,0:14:51.00,0:14:53.00,Default,,0,0,0,,Мен Қасқырға көмектесе алмаймын.
Dialogue: 0,0:14:54.00,0:14:56.00,Default,,0,0,0,,Өйткені Стаз - вампир.
Dialogue: 0,0:14:56.00,0:14:57.00,Default,,0,0,0,,Физикалық зақым
Dialogue: 0,0:14:57.00,0:14:59.00,Default,,0,0,0,,Сиқырлы күшпен бірден қалпына келтіруге болады.
Dialogue: 0,0:14:59.00,0:15:00.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:15:00.00,0:15:02.00,Default,,0,0,0,,Мен бұған жете алмаймын
Dialogue: 0,0:15:03.00,0:15:04.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:04.00,0:15:06.00,Default,,0,0,0,,Керемет төзімділік.
Dialogue: 0,0:15:06.00,0:15:09.00,Default,,0,0,0,,Жүрегіңе пышақ тисе де, санаулы секундта жазылып кетеді.
Dialogue: 0,0:15:09.00,0:15:11.00,Default,,0,0,0,,Вампир қаны дегеніміз не?
Dialogue: 0,0:15:11.00,0:15:12.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:15:12.00,0:15:13.00,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:15:19.00,0:15:22.00,Default,,0,0,0,,Осылай шыдағаннан кейін не болады?
Dialogue: 0,0:15:22.00,0:15:24.00,Default,,0,0,0,,Мен сені ұруым керек
Dialogue: 0,0:15:24.00,0:15:25.00,Default,,0,0,0,,Көбінесе
Dialogue: 0,0:15:25.00,0:15:26.00,Default,,0,0,0,,Емдеу мүмкін емес
Dialogue: 0,0:15:27.00,0:15:28.00,Default,,0,0,0,,Төре төре
Dialogue: 0,0:15:28.00,0:15:29.00,Default,,0,0,0,,Емде, емде.
Dialogue: 0,0:15:29.00,0:15:30.00,Default,,0,0,0,,Осылайша
Dialogue: 0,0:15:30.00,0:15:33.00,Default,,0,0,0,,Өзіңізді емдеу үшін дөңгелек затты тартыңыз
Dialogue: 0,0:15:33.00,0:15:34.00,Default,,0,0,0,,Бұл сұмдық
Dialogue: 0,0:15:34.00,0:15:36.00,Default,,0,0,0,,Мен оны құртамын.
Dialogue: 0,0:15:36.00,0:15:37.00,Default,,0,0,0,,Жетті, Конни
Dialogue: 0,0:15:37.00,0:15:39.00,Default,,0,0,0,,Оның сиқырлы күші бос.
Dialogue: 0,0:15:39.00,0:15:41.00,Default,,0,0,0,,Стаз мырза
Dialogue: 0,0:15:41.00,0:15:42.00,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:15:42.00,0:15:43.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:15:50.00,0:15:51.00,Default,,0,0,0,,Не?
Dialogue: 0,0:15:51.00,0:15:53.00,Default,,0,0,0,,Бұл шаршау сезімі
Dialogue: 0,0:15:55.00,0:15:56.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:57.00,0:15:59.00,Default,,0,0,0,,Мен бұл уақытты күткен жоқпын
Dialogue: 0,0:16:00.00,0:16:01.00,Default,,0,0,0,,(Норияки) Уф. (Жан) Мм…
Dialogue: 0,0:16:02.00,0:16:04.00,Default,,0,0,0,,Мен мұны ақыры түсіндім.
Dialogue: 0,0:16:04.00,0:16:05.00,Default,,0,0,0,,Сен
Dialogue: 0,0:16:05.00,0:16:08.00,Default,,0,0,0,,Сен менің сиқырлы күшімді сорып алдың.
Dialogue: 0,0:16:08.00,0:16:10.00,Default,,0,0,0,,Менің денеме осындай нәрсені сал
Dialogue: 0,0:16:10.00,0:16:11.00,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:16:11.00,0:16:12.00,Default,,0,0,0,,Не?
Dialogue: 0,0:16:13.00,0:16:14.00,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:16:14.00,0:16:16.00,Default,,0,0,0,,Бұл менің терім
Dialogue: 0,0:16:17.00,0:16:20.00,Default,,0,0,0,,Маған соғұрлым көп зиян келтіресің
Dialogue: 0,0:16:20.00,0:16:22.00,Default,,0,0,0,,Сіздің сиқырлы күшіңіз төмендеді.
Dialogue: 0,0:16:23.00,0:16:24.00,Default,,0,0,0,,шықты
Dialogue: 0,0:16:24.00,0:16:25.00,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:16:25.00,0:16:26.00,Default,,0,0,0,,Чучу пойызы
Dialogue: 0,0:16:26.00,0:16:28.00,Default,,0,0,0,,Қасқырдың шабуылынан келтірілген зиян
Dialogue: 0,0:16:28.00,0:16:30.00,Default,,0,0,0,,Қасқырдың сиқырлы күшімен қалпына келтіруге болады
Dialogue: 0,0:16:30.00,0:16:33.00,Default,,0,0,0,,Енді менде 0 зиян бар.
Dialogue: 0,0:16:33.00,0:16:36.00,Default,,0,0,0,,Иықтарың мен сиқырлы күштерің бос.
Dialogue: 0,0:16:37.00,0:16:40.00,Default,,0,0,0,,Сіз сауығып кеткенше жүгіргіңіз келетін шығар.
Dialogue: 0,0:16:40.00,0:16:41.00,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:16:41.00,0:16:42.00,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:16:46.00,0:16:47.00,Default,,0,0,0,,Ойнату
Dialogue: 0,0:16:47.00,0:16:48.00,Default,,0,0,0,,Ойнату
Dialogue: 0,0:16:51.00,0:16:54.00,Default,,0,0,0,,Бұл рингте сіз үшін құтылу мүмкін емес.
Dialogue: 0,0:16:56.00,0:16:57.00,Default,,0,0,0,,Бозер
Dialogue: 0,0:16:58.00,0:16:59.00,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:16:59.00,0:17:00.00,Default,,0,0,0,,Санау
Dialogue: 0,0:17:00.00,0:17:01.00,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:17:01.00,0:17:02.00,Default,,0,0,0,,Екі
Dialogue: 0,0:17:02.00,0:17:03.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:17:03.00,0:17:04.00,Default,,0,0,0,,Тұрмаңыз
Dialogue: 0,0:17:05.00,0:17:07.00,Default,,0,0,0,,Егер сіз қазір болсаңыз
Dialogue: 0,0:17:07.00,0:17:09.00,Default,,0,0,0,,Мен тіпті zip аламын
Dialogue: 0,0:17:09.00,0:17:11.00,Default,,0,0,0,,Тұрсаң өлесің.
Dialogue: 0,0:17:11.00,0:17:13.00,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:17:13.00,0:17:14.00,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:14.00,0:17:16.00,Default,,0,0,0,,Соған дейін барсын
Dialogue: 0,0:17:16.00,0:17:17.00,Default,,0,0,0,,Кітап?
Dialogue: 0,0:17:17.00,0:17:19.00,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:17:19.00,0:17:21.00,Default,,0,0,0,,Бұдан басқа нәрсе
Dialogue: 0,0:17:21.00,0:17:24.00,Default,,0,0,0,,Сіз мұны қатты қалайсыз
Dialogue: 0,0:17:24.00,0:17:26.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:26.00,0:17:27.00,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:17:27.00,0:17:28.00,Default,,0,0,0,,Мен
Dialogue: 0,0:17:31.00,0:17:34.00,Default,,0,0,0,,Өзіңіз осылай болса да не қалайсыз?
Dialogue: 0,0:17:34.00,0:17:35.00,Default,,0,0,0,,Жұлдыздар
Dialogue: 0,0:17:35.00,0:17:36.00,Default,,0,0,0,,Дос
Dialogue: 0,0:17:36.00,0:17:39.00,Default,,0,0,0,,Жартылай сиқырлы күшпен жартылай центрифугалау
Dialogue: 0,0:17:39.00,0:17:40.00,Default,,0,0,0,,Vanilla Ice айтты
Dialogue: 0,0:17:40.00,0:17:41.00,Default,,0,0,0,,Янагифу
Dialogue: 0,0:17:42.00,0:17:44.00,Default,,0,0,0,,Енді мен елес болдым
Dialogue: 0,0:17:44.00,0:17:46.00,Default,,0,0,0,,Бастапқыда адам
Dialogue: 0,0:17:46.00,0:17:49.00,Default,,0,0,0,,Мен оны бастапқы қалпына келтіремін.
Dialogue: 0,0:17:49.00,0:17:51.00,Default,,0,0,0,,Мен қайтқым келеді
Dialogue: 0,0:17:51.00,0:17:53.00,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:17:53.00,0:17:55.00,Default,,0,0,0,,Сіз ондай адам емессіз.
Dialogue: 0,0:17:55.00,0:17:59.00,Default,,0,0,0,,Мен тек өзіме сенемін және тек өзім үшін әрекет етемін.
Dialogue: 0,0:17:59.00,0:18:01.00,Default,,0,0,0,,Қайта тірілткеннен кейін не істеу керек
Dialogue: 0,0:18:01.00,0:18:03.00,Default,,0,0,0,,Мен адам болып қайтамын
Dialogue: 0,0:18:03.00,0:18:05.00,Default,,0,0,0,,Сіз өзіңіз үшін әрекет етпейсіз
Dialogue: 0,0:18:05.00,0:18:08.00,Default,,0,0,0,,Қайта тіріл, содан кейін не?
Dialogue: 0,0:18:08.00,0:18:11.00,Default,,0,0,0,,Ол адам болған соң онымен не істейсің?
Dialogue: 0,0:18:11.00,0:18:12.00,Default,,0,0,0,,Жұлдыздар
Dialogue: 0,0:18:12.00,0:18:13.00,Default,,0,0,0,,Шулы
Dialogue: 0,0:18:18.00,0:18:20.00,Default,,0,0,0,,Оның сізге еш қатысы жоқ.
Dialogue: 0,0:18:22.00,0:18:23.00,Default,,0,0,0,,Қозғалмай отырыңыз
Dialogue: 0,0:18:23.00,0:18:25.00,Default,,0,0,0,,Бұл вампир
Dialogue: 0,0:18:27.00,0:18:29.00,Default,,0,0,0,,Қайсысы жарты жолда?
Dialogue: 0,0:18:29.00,0:18:31.00,Default,,0,0,0,,Мен вампирлерді ұнатпаймын десем де.
Dialogue: 0,0:18:31.00,0:18:33.00,Default,,0,0,0,,Уақыты келгенде күшке төтеп берерсің.
Dialogue: 0,0:18:33.00,0:18:34.00,Default,,0,0,0,,Дамаре
Dialogue: 0,0:18:34.00,0:18:35.00,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:18:36.00,0:18:40.00,Default,,0,0,0,,Сіз өзіңіздің алдыңызда әдемі адаммен тіл табысуға тырысып жатырсыз ба?
Dialogue: 0,0:18:40.00,0:18:41.00,Default,,0,0,0,,Дамаре
Dialogue: 0,0:18:41.00,0:18:44.00,Default,,0,0,0,,Вампир болмас бұрын, сіз бөтен адамсыз.
Dialogue: 0,0:18:44.00,0:18:46.00,Default,,0,0,0,,Бұл мені күлдіреді
Dialogue: 0,0:18:46.00,0:18:48.00,Default,,0,0,0,,Ойнап жүрген ит мынау ма?
Dialogue: 0,0:18:48.00,0:18:51.00,Default,,0,0,0,,Идиот, егер одан да көп жасасаң, мен саған шындап сенемін.
Dialogue: 0,0:18:57.00,0:18:59.00,Default,,0,0,0,,Бітті
Dialogue: 0,0:18:59.00,0:19:02.00,Default,,0,0,0,,Достардың бір-бірін ренжітуі
Dialogue: 0,0:19:02.00,0:19:05.00,Default,,0,0,0,,Бұл жай ғана ұрыс емес пе?
Dialogue: 0,0:19:05.00,0:19:09.00,Default,,0,0,0,,Біз неге тіл табыса алмаймыз?
Dialogue: 0,0:19:09.00,0:19:10.00,Default,,0,0,0,,Мен
Dialogue: 0,0:19:11.00,0:19:14.00,Default,,0,0,0,,Мен жын-шайтан әлемі немесе екеуің туралы көп білмеймін.
Dialogue: 0,0:19:14.00,0:19:15.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:19:15.00,0:19:18.00,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:19:19.00,0:19:21.00,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:19:21.00,0:19:22.00,Default,,0,0,0,,Сен
Dialogue: 0,0:19:22.00,0:19:26.00,Default,,0,0,0,,Бұл ойында мен, саяхатшы әйел,
Dialogue: 0,0:19:26.00,0:19:28.00,Default,,0,0,0,,Ақ пен қараны киіп өлме
Dialogue: 0,0:19:28.00,0:19:29.00,Default,,0,0,0,,Иә
Dialogue: 0,0:19:29.00,0:19:31.00,Default,,0,0,0,,Қорытындылай келе, екі жақ та жеңіледі.
Dialogue: 0,0:19:31.00,0:19:34.00,Default,,0,0,0,,Мен сендермен сөйлесе алмаймын.
Dialogue: 0,0:19:34.00,0:19:37.00,Default,,0,0,0,,Жарайды, сіз қазір жоғалып кете аласыз.
Dialogue: 0,0:19:37.00,0:19:39.00,Default,,0,0,0,,Осы сақинадан.
Dialogue: 0,0:19:41.00,0:19:42.00,Default,,0,0,0,,Автобус
Dialogue: 0,0:19:42.00,0:19:44.00,Default,,0,0,0,,Уссазу
Dialogue: 0,0:19:47.00,0:19:50.00,Default,,0,0,0,,Бұл екеуінің шайқасы аяқталды.
Dialogue: 0,0:19:50.00,0:19:53.00,Default,,0,0,0,,Үйге өзіңіз бара аласыз.
Dialogue: 0,0:19:53.00,0:19:55.00,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:19:55.00,0:19:56.00,Default,,0,0,0,,Сіз
Dialogue: 0,0:19:56.00,0:19:57.00,Default,,0,0,0,,Сіз
Dialogue: 0,0:19:57.00,0:19:58.00,Default,,0,0,0,,Сіз
Dialogue: 0,0:19:59.00,0:20:02.00,Default,,0,0,0,,Құмар ойындар әділетсіз
Dialogue: 0,0:20:02.00,0:20:05.00,Default,,0,0,0,,Тотото деп айтайық
Dialogue: 0,0:20:05.00,0:20:07.00,Default,,0,0,0,,Додонмай
Dialogue: 0,0:20:08.00,0:20:09.00,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:20:09.00,0:20:10.00,Default,,0,0,0,,Саана
Dialogue: 0,0:20:10.00,0:20:13.00,Default,,0,0,0,,Сіз бұл әйелді танисыз ба?
Dialogue: 0,0:20:13.00,0:20:14.00,Default,,0,0,0,,О
Dialogue: 0,0:20:14.00,0:20:18.00,Default,,0,0,0,,Кітапты өзіңмен бірге ала келген ол.
Dialogue: 0,0:20:18.00,0:20:22.00,Default,,0,0,0,,Боулинг ойынымызды боксқа айналдырған ол.
Dialogue: 0,0:20:22.00,0:20:23.00,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:20:23.00,0:20:26.00,Default,,0,0,0,,Балалар, алдап жатқан сияқты бірдеңе айтыңыз.
Dialogue: 0,0:20:26.00,0:20:29.00,Default,,0,0,0,,Боулингті тоқтатып, боксты бастаңыз.
Dialogue: 0,0:20:29.00,0:20:33.00,Default,,0,0,0,,Екеумізді де сол әйел биледі ме?
Dialogue: 0,0:20:33.00,0:20:35.00,Default,,0,0,0,,Қандай мақсатта?
Dialogue: 0,0:20:35.00,0:20:37.00,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:20:40.00,0:20:43.00,Default,,0,0,0,,Қызды жылатқан жігіттерге айтайын ба?
Dialogue: 0,0:20:43.00,0:20:44.00,Default,,0,0,0,,О
Dialogue: 0,0:20:44.00,0:20:46.00,Default,,0,0,0,,Одан гөрі бұл
Dialogue: 0,0:20:46.00,0:20:47.00,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:20:47.00,0:20:49.00,Default,,0,0,0,,Құдайдың қайта тірілу кітабы
Dialogue: 0,0:20:49.00,0:20:51.00,Default,,0,0,0,,Арнайы тегін тамақ ішуге бола ма?
Dialogue: 0,0:20:51.00,0:20:53.00,Default,,0,0,0,,Сізде бірінші кезекте болды ма?
Dialogue: 0,0:20:53.00,0:20:56.00,Default,,0,0,0,,Адамдарды мазақ етіп, алданба, үлкен қарын күш.
Dialogue: 0,0:20:56.00,0:20:57.00,Default,,0,0,0,,Дегенмен, бұл біреуі шын мәнінде өте сүйкімді.
Dialogue: 0,0:20:57.00,0:20:59.00,Default,,0,0,0,,Мен оны айта алмаймын.
Dialogue: 0,0:20:59.00,0:21:00.00,Default,,0,0,0,,Мен мұндамын, Барға.
Dialogue: 0,0:21:00.00,0:21:02.00,Default,,0,0,0,,тістеуге болмайды
Dialogue: 0,0:21:02.00,0:21:05.00,Default,,0,0,0,,Қашанға дейін жылайсың?
Dialogue: 0,0:21:05.00,0:21:06.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:21:06.00,0:21:07.00,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:21:11.00,0:21:12.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:14.00,0:21:15.00,Default,,0,0,0,,О
Dialogue: 0,0:21:15.00,0:21:17.00,Default,,0,0,0,,Мен ойлағандай.
Dialogue: 0,0:21:17.00,0:21:19.00,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:21:19.00,0:21:22.00,Default,,0,0,0,,Эй, балалар, тіпті оқи алмайсыңдар.
Dialogue: 0,0:21:22.00,0:21:24.00,Default,,0,0,0,,Олай болса өтінемін
Dialogue: 0,0:21:24.00,0:21:25.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:25.00,0:21:26.00,Default,,0,0,0,,Уау
Dialogue: 0,0:21:26.00,0:21:27.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:27.00,0:21:28.00,Default,,0,0,0,,Төбешіктерді текшелеп турап, суға салып қойыңыз.
Dialogue: 0,0:21:28.00,0:21:29.00,Default,,0,0,0,,Қуыруға арналған табада күнжіт майын қыздырыңыз.
Dialogue: 0,0:21:29.00,0:21:31.00,Default,,0,0,0,,Қатты отта лопуха тамырын араластырып қуырыңыз.
Dialogue: 0,0:21:31.00,0:21:33.00,Default,,0,0,0,,Сәбізді де араластырып қуырыңыз, сосын саке мен соя соусын қосыңыз.
Dialogue: 0,0:21:33.00,0:21:34.00,Default,,0,0,0,,Аяяяя
Dialogue: 0,0:21:34.00,0:21:35.00,Default,,0,0,0,,Бұл Kinpera лопуха, солай ма?
Dialogue: 0,0:21:35.00,0:21:36.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:36.00,0:21:39.00,Default,,0,0,0,,Сіз мұны оқи алмайсыз ба?
Dialogue: 0,0:21:39.00,0:21:42.00,Default,,0,0,0,,Мен де оқи алмаймын, бірақ бұл кітаптың қалай жұмыс істейтінін түсінемін.
Dialogue: 0,0:21:42.00,0:21:43.00,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:21:43.00,0:21:45.00,Default,,0,0,0,,Бұл код сияқты.
Dialogue: 0,0:21:45.00,0:21:49.00,Default,,0,0,0,,Бүкіл кітап сөз бірліктерінің үлкен анаграммасы болса керек.
Dialogue: 0,0:21:49.00,0:21:54.00,Default,,0,0,0,,Бұл оны шешу үшін барлық сөздерді ауыстырып, қайта құру керек дегенді білдіреді.
Dialogue: 0,0:21:54.00,0:21:57.00,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды түсінбеймін.
Dialogue: 0,0:21:57.00,0:22:02.00,Default,,0,0,0,,Сіз механизмді түсінсеңіз де, оны шешу өте жалықтырады.
Dialogue: 0,0:22:02.00,0:22:07.00,Default,,0,0,0,,Былайша айтқанда, мазмұнын осы қорлау кітапты жазған бала жазған, жиіркенішті бейбақ.
Dialogue: 0,0:22:07.00,0:22:09.00,Default,,0,0,0,,Тікелей сұрау жылдамырақ.
Dialogue: 0,0:22:09.00,0:22:12.00,Default,,0,0,0,,Бұл қандай кітап?
Dialogue: 0,0:22:12.00,0:22:14.00,Default,,0,0,0,,Оны жазған адамның аты-жөні жазылған деп ойлаймын.
Dialogue: 0,0:22:14.00,0:22:15.00,Default,,0,0,0,,На
Dialogue: 0,0:22:42.00,0:22:44.00,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:22:44.00,0:22:46.00,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
