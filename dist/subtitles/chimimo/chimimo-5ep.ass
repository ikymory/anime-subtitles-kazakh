Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.21,0:00:03.21,Default,,0,0,0,,Келесі кездескенше! Келесі жолы~!
Dialogue: 0,0:00:03.21,0:00:05.21,Default,,0,0,0,,Келесі жолы~!
Dialogue: 0,0:00:09.19,0:00:11.86,Default,,0,0,0,,<Онигами отбасының үш әпкесі тұратын үйде.
Dialogue: 0,0:00:11.86,0:00:15.53,Default,,0,0,0,,Тозақ мырза 12 Чимимомен келді.
Dialogue: 0,0:00:15.53,0:00:17.53,Default,,0,0,0,,Олар әлі білмейді
Dialogue: 0,0:00:17.53,0:00:19.86,Default,,0,0,0,,Олардың шынайы мақсаты
Dialogue: 0,0:00:19.86,0:00:23.20,Default,,0,0,0,,Мақсат адам әлемін тозаққа айналдыру болды>
Dialogue: 0,0:00:23.20,0:00:43.22,Default,,0,0,0,,Сен
Dialogue: 0,0:00:43.22,0:01:03.24,Default,,0,0,0,,Сен
Dialogue: 0,0:01:03.24,0:01:23.19,Default,,0,0,0,,Сен
Dialogue: 0,0:01:23.19,0:01:25.53,Default,,0,0,0,,Сен
Dialogue: 0,0:01:25.53,0:01:29.20,Default,,0,0,0,,Сен
Dialogue: 0,0:01:29.20,0:01:49.22,Default,,0,0,0,,Сен
Dialogue: 0,0:01:49.22,0:01:52.22,Default,,0,0,0,,Сен
Dialogue: 0,0:05:04.18,0:05:06.18,Default,,0,0,0,,«Тозақ жоспары»
Dialogue: 0,0:05:08.52,0:05:10.52,Default,,0,0,0,,♪ Хехехехе
Dialogue: 0,0:05:10.52,0:05:12.52,Default,,0,0,0,,♪ Ауа-райы жақсы
Dialogue: 0,0:05:12.52,0:05:15.19,Default,,0,0,0,,♪ Тозақ тозақ тозақ ауа райы~
Dialogue: 0,0:05:15.19,0:05:17.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:17.19,0:05:19.53,Default,,0,0,0,,Хисо Хисо Хисо Хисо (Кишин Хазуки) Иә
Dialogue: 0,0:05:19.53,0:05:22.20,Default,,0,0,0,,Доккойшо және ах...
Dialogue: 0,0:05:22.20,0:05:25.87,Default,,0,0,0,,Не? Не? Таку…
Dialogue: 0,0:05:25.87,0:05:28.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:28.20,0:05:30.21,Default,,0,0,0,,Эй, менің шұлықтарымды ал.
Dialogue: 0,0:05:30.21,0:05:32.21,Default,,0,0,0,,Ей, ей!
Dialogue: 0,0:05:32.21,0:05:34.21,Default,,0,0,0,,Не болды!
Dialogue: 0,0:05:36.55,0:05:38.55,Default,,0,0,0,,Чими! Чими
Dialogue: 0,0:05:38.55,0:05:40.55,Default,,0,0,0,,А, эй, күте тұрыңыз!
Dialogue: 0,0:05:40.55,0:05:42.55,Default,,0,0,0,,Не!
Dialogue: 0,0:05:42.55,0:05:44.89,Default,,0,0,0,,Иә? Сен не істеп жатырсың?
Dialogue: 0,0:05:44.89,0:05:47.29,Default,,0,0,0,,Чими~ (Мистер Тозақ) Бұл не?
Dialogue: 0,0:05:48.22,0:05:50.52,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:51.90,0:05:55.90,Default,,0,0,0,,Чими Чими Мочи Мочи Моцу
Dialogue: 0,0:05:56.90,0:05:59.17,Default,,0,0,0,,Джонатанды өлтіру үшін Дио қолданған өлімге әкелетін қабілет.
Dialogue: 0,0:05:59.17,0:06:01.50,Default,,0,0,0,,Сасс
Dialogue: 0,0:06:01.50,0:06:03.84,Default,,0,0,0,,Шута та шу
Dialogue: 0,0:06:03.84,0:06:08.18,Default,,0,0,0,,(Мистер Тозақ)
Dialogue: 0,0:06:08.18,0:06:13.52,Default,,0,0,0,,Сен
Dialogue: 0,0:06:13.52,0:06:15.52,Default,,0,0,0,,Иә? Ха!
Dialogue: 0,0:06:18.52,0:06:20.52,Default,,0,0,0,,Мэй?
Dialogue: 0,0:06:20.52,0:06:23.22,Default,,0,0,0,,Мими Мими~
Dialogue: 0,0:06:24.19,0:06:26.20,Default,,0,0,0,,<Ах! Менің қалағаным сол еді
Dialogue: 0,0:06:26.20,0:06:28.87,Default,,0,0,0,,Жаңа Бостандық мүсіні фотокітап! >
Dialogue: 0,0:06:28.87,0:06:30.87,Default,,0,0,0,,Бостандық мүсіні?
Dialogue: 0,0:06:30.87,0:06:32.87,Default,,0,0,0,,Чими~
Dialogue: 0,0:06:32.87,0:06:35.54,Default,,0,0,0,,Тозақ мырза білді ме? Чими~
Dialogue: 0,0:06:35.54,0:06:37.54,Default,,0,0,0,,(Мистер Тозақ)
Dialogue: 0,0:06:37.54,0:06:39.54,Default,,0,0,0,,Құс бұлғын
Dialogue: 0,0:06:39.54,0:06:41.88,Default,,0,0,0,,Чими! Ми~!
Dialogue: 0,0:06:41.88,0:06:43.88,Default,,0,0,0,,Күте тұрыңыз! Чими?
Dialogue: 0,0:06:43.88,0:06:46.22,Default,,0,0,0,,Түсіндің бе? Егер тозақ мені байқаса
Dialogue: 0,0:06:46.22,0:06:48.89,Default,,0,0,0,,Бұл жоспар бітті, жаным!
Dialogue: 0,0:06:48.89,0:06:51.22,Default,,0,0,0,,Жоспар? Жарайды
Dialogue: 0,0:06:51.22,0:06:53.89,Default,,0,0,0,,Чими! Чими!
Dialogue: 0,0:06:53.89,0:06:57.56,Default,,0,0,0,,Жоспар ойдағыдай болса, мен сені одан да көп марапаттаймын.
Dialogue: 0,0:06:57.56,0:07:00.16,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:07:00.16,0:07:02.83,Default,,0,0,0,,Ах! Бұл не күлкі?
Dialogue: 0,0:07:02.83,0:07:04.83,Default,,0,0,0,,Сіз не жоспарлап отырсыз...
Dialogue: 0,0:07:04.83,0:07:07.23,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:07:11.51,0:07:14.51,Default,,0,0,0,,(тозақ)
Dialogue: 0,0:07:14.51,0:07:16.85,Default,,0,0,0,,Соя соусын алыңыз
Dialogue: 0,0:07:16.85,0:07:18.85,Default,,0,0,0,,Рахмет Чими~
Dialogue: 0,0:07:18.85,0:07:21.52,Default,,0,0,0,,<Сен мені тыңдамайсың
Dialogue: 0,0:07:21.52,0:07:23.85,Default,,0,0,0,,Неге менің жиенім... дейді.
Dialogue: 0,0:07:23.85,0:07:26.85,Default,,0,0,0,,Жерде не...> Хехе
Dialogue: 0,0:07:28.86,0:07:31.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:31.53,0:07:35.20,Default,,0,0,0,,<Осында «Тозақ адам әлемі» филиалын орнатқаннан кейін
Dialogue: 0,0:07:35.20,0:07:40.20,Default,,0,0,0,,Мен адамдық тергеудің бір бөлігі ретінде Кишиндер отбасының үш апалы-сіңлісін бақылап отырдым.
Dialogue: 0,0:07:40.20,0:07:42.87,Default,,0,0,0,,Әлгі үш апаға келгенде...>
Dialogue: 0,0:07:42.87,0:07:44.87,Default,,0,0,0,,《♪ Көңілді көңіл көтеру》
Dialogue: 0,0:07:44.87,0:07:47.54,Default,,0,0,0,,《Ах! Уууу
Dialogue: 0,0:07:47.54,0:07:49.88,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:07:49.88,0:07:51.88,Default,,0,0,0,,Кией! 》
Dialogue: 0,0:07:51.88,0:07:54.55,Default,,0,0,0,,<Бұл тозақтың бірінші блогы
Dialogue: 0,0:07:54.55,0:07:59.16,Default,,0,0,0,,Барлығын бір жұдырықпен өлтіріңіз, Демон Банчу Муцуми! >
Dialogue: 0,0:07:59.16,0:08:02.16,Default,,0,0,0,,《Кешкі астың қызығы тунец.》
Dialogue: 0,0:08:04.16,0:08:06.50,Default,,0,0,0,,А... иә...
Dialogue: 0,0:08:06.50,0:08:09.50,Default,,0,0,0,,《Ух... Уау! 》
Dialogue: 0,0:08:09.50,0:08:11.83,Default,,0,0,0,,<Тіпті тозақ да ақшаға байланысты.
Dialogue: 0,0:08:11.83,0:08:14.84,Default,,0,0,0,,Кижин отбасының мас ақшасы Геба Хазуки! >
Dialogue: 0,0:08:14.84,0:08:18.17,Default,,0,0,0,,《Мм... Менің образымды қиялдамаңыз!
Dialogue: 0,0:08:18.17,0:08:20.51,Default,,0,0,0,,Орындау ақысы: 1000 иен.
Dialogue: 0,0:08:20.51,0:08:22.51,Default,,0,0,0,,<және жиен
Dialogue: 0,0:08:22.51,0:08:25.52,Default,,0,0,0,,Мен оны тозақтық жақсы қыз деп ойладым.
Dialogue: 0,0:08:25.52,0:08:27.52,Default,,0,0,0,,Бірақ бұған дейін...>
Dialogue: 0,0:08:30.19,0:08:33.86,Default,,0,0,0,,《Ей, арпа шайы жоқ! Ваннаға түскеннен кейінгі сусын...》
Dialogue: 0,0:08:33.86,0:08:37.53,Default,,0,0,0,,《Аа, енді...Мұнда келсем арпа шайын қайнатпаймын.》
Dialogue: 0,0:08:37.53,0:08:39.53,Default,,0,0,0,,《Мей? 》
Dialogue: 0,0:08:39.53,0:08:43.53,Default,,0,0,0,,《Арпа шайының ережесі: оны соңына дейін ішкен адам келесі шайды жасай алады.
Dialogue: 0,0:08:43.53,0:08:45.87,Default,,0,0,0,,Жиен жасау азап.
Dialogue: 0,0:08:45.87,0:08:49.21,Default,,0,0,0,,Соңғы болып қалмас үшін сәл ғана қалдырыңыз.
Dialogue: 0,0:08:49.21,0:08:51.21,Default,,0,0,0,,《Е... паллиативтер》
Dialogue: 0,0:08:51.21,0:08:54.54,Default,,0,0,0,,《Ендеше, Тозақ мырза, арпа шайын қайнатып беріңізші.
Dialogue: 0,0:08:54.54,0:08:56.55,Default,,0,0,0,,Өйткені біз заттарды қайнататын адамдармыз》
Dialogue: 0,0:08:56.55,0:08:58.48,Default,,0,0,0,,《Ух...》 《Иә》
Dialogue: 0,0:08:58.48,0:09:02.15,Default,,0,0,0,,《Хаа... Кунуну...》
Dialogue: 0,0:09:02.15,0:09:04.49,Default,,0,0,0,,《Хазунее》 《Мм? 》
Dialogue: 0,0:09:04.49,0:09:07.16,Default,,0,0,0,,《Білесің бе, мен ертең достарыммен шығамын...》
Dialogue: 0,0:09:07.16,0:09:09.16,Default,,0,0,0,,《Егер мен барсам ше? 》
Dialogue: 0,0:09:09.16,0:09:12.16,Default,,0,0,0,,《Кішкене ғана қалта ақшасы》 《Е~》
Dialogue: 0,0:09:12.16,0:09:15.50,Default,,0,0,0,,《Мен осы айда манга мен кроссовка сатып алдым, сондықтан мен қысылып қалдым.
Dialogue: 0,0:09:15.50,0:09:18.84,Default,,0,0,0,,Өтінемін, мен жуынатын бөлмені тазалау міндетін аламын! 》
Dialogue: 0,0:09:18.84,0:09:21.84,Default,,0,0,0,,《Оған көмектесу мүмкін емес...
Dialogue: 0,0:09:21.84,0:09:24.51,Default,,0,0,0,,Хмм》 《Уау, 5000 иен! 》
Dialogue: 0,0:09:24.51,0:09:26.84,Default,,0,0,0,,《Ах! Цянгебаның ақшасы бар ма? 》
Dialogue: 0,0:09:26.84,0:09:29.51,Default,,0,0,0,,《Рахмет Хазуки-сама
Dialogue: 0,0:09:29.51,0:09:31.85,Default,,0,0,0,,Мен бұл жақсылықты ешқашан ұмытпаймын.
Dialogue: 0,0:09:31.85,0:09:35.85,Default,,0,0,0,,《Ой, жалдау ақысын осы айдың басында төлеңіз.》
Dialogue: 0,0:09:35.85,0:09:37.85,Default,,0,0,0,,《Мм? « «Не!
Dialogue: 0,0:09:37.85,0:09:39.85,Default,,0,0,0,,Уф…》
Dialogue: 0,0:09:41.86,0:09:46.86,Default,,0,0,0,,Балалық рухым, шашыңды тозақ желдері кептірсін!
Dialogue: 0,0:09:46.86,0:09:48.86,Default,,0,0,0,,Иә! (Цубаса) Чими!
Dialogue: 0,0:09:50.20,0:09:52.20,Default,,0,0,0,,Чими~!
Dialogue: 0,0:09:52.20,0:09:55.54,Default,,0,0,0,,О, мынау ыңғайлы, Тозақ мырзаға еліктеп.
Dialogue: 0,0:09:55.54,0:09:58.81,Default,,0,0,0,,<Бұл өтірік... Өтінемін, өтірік деп айтыңызшы.
Dialogue: 0,0:09:58.81,0:10:02.15,Default,,0,0,0,,Тозақты оңай меңгеруімнің еш себебі жоқ...>
Dialogue: 0,0:10:02.15,0:10:04.81,Default,,0,0,0,,Чими де соқсын
Dialogue: 0,0:10:04.81,0:10:06.82,Default,,0,0,0,,Ми~! Хехе
Dialogue: 0,0:10:06.82,0:10:08.82,Default,,0,0,0,,<Бұл шайтан!
Dialogue: 0,0:10:08.82,0:10:12.82,Default,,0,0,0,,Мей, жын-перілер отбасын түзетуші, ол бәрін өзі қалағандай басқарады! >
Dialogue: 0,0:10:12.82,0:10:14.82,Default,,0,0,0,,Хи хи (тозақ) Мен қорқамын...
Dialogue: 0,0:10:17.16,0:10:20.16,Default,,0,0,0,,Жиеніңізбен не жоспарлап отырсыз?
Dialogue: 0,0:10:20.16,0:10:22.17,Default,,0,0,0,,Чимими…
Dialogue: 0,0:10:22.17,0:10:24.17,Default,,0,0,0,,«Мен ештеңе жоспарлап отырған жоқпын»?
Dialogue: 0,0:10:24.17,0:10:26.17,Default,,0,0,0,,Чими~ (Мистер Тозақ) Білу керек!
Dialogue: 0,0:10:26.17,0:10:28.84,Default,,0,0,0,,Менің білгенімді қаламайтын жоспарларыңыз болуы керек!
Dialogue: 0,0:10:28.84,0:10:31.17,Default,,0,0,0,,Чими (Мистер Тозақ) Қандай жоспар?
Dialogue: 0,0:10:31.17,0:10:34.18,Default,,0,0,0,,Чими~! Ми~!
Dialogue: 0,0:10:34.18,0:10:36.18,Default,,0,0,0,,～
Dialogue: 0,0:10:36.18,0:10:38.18,Default,,0,0,0,,Ми! (Мистер Тозақ) Ах!
Dialogue: 0,0:10:38.18,0:10:40.52,Default,,0,0,0,,Чими Чими Чими
Dialogue: 0,0:10:40.52,0:10:43.22,Default,,0,0,0,,Неге, олар... сенің қалағаныңды істейді!
Dialogue: 0,0:10:46.86,0:10:49.53,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:10:49.53,0:10:52.86,Default,,0,0,0,,<Ке... Жиеніңіз екеуіңіз жақсы аралассаңыздар жақсы болар еді.
Dialogue: 0,0:10:52.86,0:10:54.86,Default,,0,0,0,,Өте жақсы емес!
Dialogue: 0,0:10:54.86,0:10:56.87,Default,,0,0,0,,Ерекше ештеңе жоқ> Хэхе
Dialogue: 0,0:10:56.87,0:10:59.14,Default,,0,0,0,,<Шын мәнінде жақсы емес
Dialogue: 0,0:10:59.14,0:11:01.14,Default,,0,0,0,,Өте жақсы емес! >
Dialogue: 0,0:11:04.81,0:11:07.14,Default,,0,0,0,,Қарғыс атсын... бұл тағы да менің жиенім.
Dialogue: 0,0:11:07.14,0:11:09.15,Default,,0,0,0,,(тозақ)
Dialogue: 0,0:11:09.15,0:11:11.15,Default,,0,0,0,,Сонымен... Мен бармаймын!
Dialogue: 0,0:11:13.15,0:11:16.49,Default,,0,0,0,,(тозақ)
Dialogue: 0,0:11:16.49,0:11:20.16,Default,,0,0,0,,Бұл маған тозақтың сұмдығын еске түсіреді.
Dialogue: 0,0:11:20.16,0:11:22.16,Default,,0,0,0,,Чими Чими
Dialogue: 0,0:11:22.16,0:11:24.49,Default,,0,0,0,,Хмф! Чими! Мен...
Dialogue: 0,0:11:24.49,0:11:28.16,Default,,0,0,0,,Тақсыр, сізден ынтымақтастық сұраймын.
Dialogue: 0,0:11:28.16,0:11:30.46,Default,,0,0,0,,Чими~ Ми…
Dialogue: 0,0:11:32.50,0:11:36.51,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:11:36.51,0:11:42.85,Default,,0,0,0,,Сен
Dialogue: 0,0:11:42.85,0:11:44.85,Default,,0,0,0,,Ихихихихи
Dialogue: 0,0:11:44.85,0:11:49.19,Default,,0,0,0,,Мэй, мен сені өмір бойы арпа шайын қайнатып жіберемін.
Dialogue: 0,0:11:49.19,0:11:51.19,Default,,0,0,0,,Ми... (Мистер Тозақ) Иә?
Dialogue: 0,0:11:51.19,0:11:53.19,Default,,0,0,0,,«Балаларды қызғану дұрыс емес»?
Dialogue: 0,0:11:53.19,0:11:56.53,Default,,0,0,0,,Жоқ... жоқ! Бұл оны тозаққа айналдыру жоспарының бір бөлігі.
Dialogue: 0,0:11:56.53,0:11:59.46,Default,,0,0,0,,Ой... Уау!
Dialogue: 0,0:11:59.46,0:12:02.13,Default,,0,0,0,,А... Қауіпті Қауіпті
Dialogue: 0,0:12:02.13,0:12:04.47,Default,,0,0,0,,Кеттік Чими~
Dialogue: 0,0:12:04.47,0:12:06.47,Default,,0,0,0,,Шулы!
Dialogue: 0,0:12:06.47,0:12:08.47,Default,,0,0,0,,Менің сағым
Dialogue: 0,0:12:08.47,0:12:12.48,Default,,0,0,0,,Сізді арпа адамға айналдыру үшін пластикалық хирургияның тозақтық әдістерін қолданыңыз!
Dialogue: 0,0:12:12.48,0:12:14.81,Default,,0,0,0,,Чими... Чими!
Dialogue: 0,0:12:14.81,0:12:17.15,Default,,0,0,0,,Чимими…
Dialogue: 0,0:12:17.15,0:12:19.15,Default,,0,0,0,,Ми~!
Dialogue: 0,0:12:22.49,0:12:25.19,Default,,0,0,0,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:12:27.16,0:12:29.83,Default,,0,0,0,,Чими чими!
Dialogue: 0,0:12:29.83,0:12:32.50,Default,,0,0,0,,Не? Аа, не? Ах
Dialogue: 0,0:12:32.50,0:12:34.83,Default,,0,0,0,,А... ой-о-о-о!
Dialogue: 0,0:12:34.83,0:12:36.83,Default,,0,0,0,,Чимими~!
Dialogue: 0,0:12:36.83,0:12:40.83,Default,,0,0,0,,Не? Ах, аа! Гайя!
Dialogue: 0,0:12:43.17,0:12:47.18,Default,,0,0,0,,Иә? иә? Хмм...
Dialogue: 0,0:12:47.18,0:12:50.18,Default,,0,0,0,,Бұл ештеңе емес пе? Ха...
Dialogue: 0,0:12:51.18,0:12:54.85,Default,,0,0,0,,Не? Бұл менің туған күнім бе?
Dialogue: 0,0:12:54.85,0:12:57.52,Default,,0,0,0,,Чими~ Чими Чими!
Dialogue: 0,0:12:57.52,0:13:01.86,Default,,0,0,0,,《♪ Фуфуфу~ Ауа-райы жақсы》
Dialogue: 0,0:13:01.86,0:13:04.86,Default,,0,0,0,,《Бұл өткен жылы Хазюнаның туған күні еді》
Dialogue: 0,0:13:04.86,0:13:08.53,Default,,0,0,0,,《Ах ха ха! Бұл костюм кеші болды.
Dialogue: 0,0:13:08.53,0:13:11.87,Default,,0,0,0,,《Көңілді болды, мен мұны қайта жасағым келеді》 《Ухуху》
Dialogue: 0,0:13:11.87,0:13:14.87,Default,,0,0,0,,《♪ Тозақ тозақ тозақ ауа райы~》
Dialogue: 0,0:13:14.87,0:13:18.87,Default,,0,0,0,,《Айтпақшы, Тозақ мырзаның туған күні қашан? 》
Dialogue: 0,0:13:18.87,0:13:21.54,Default,,0,0,0,,《Аа, мен сенен бұрын туған күніңді сұрадым.
Dialogue: 0,0:13:21.54,0:13:23.55,Default,,0,0,0,,Туған күнін білмеймін деді.
Dialogue: 0,0:13:23.55,0:13:25.55,Default,,0,0,0,,《Мен...》
Dialogue: 0,0:13:25.55,0:13:28.88,Default,,0,0,0,,《Мүмкін, тозақта туған күн жоқ шығар》
Dialogue: 0,0:13:28.88,0:13:31.22,Default,,0,0,0,,《Мм》
Dialogue: 0,0:13:31.22,0:13:33.56,Default,,0,0,0,,《Мм》
Dialogue: 0,0:13:33.56,0:13:35.56,Default,,0,0,0,,《Аа...》
Dialogue: 0,0:13:35.56,0:13:39.56,Default,,0,0,0,,《Иә! Біз Мистер Хеллдің туған күнін шештік.
Dialogue: 0,0:13:39.56,0:13:41.56,Default,,0,0,0,,Той өткізбейсіз бе? 》
Dialogue: 0,0:13:41.56,0:13:44.90,Default,,0,0,0,,《Уфуфу, жақсы, бірақ Мэй жоспар құруы керек.》
Dialogue: 0,0:13:44.90,0:13:47.24,Default,,0,0,0,,《Иә! Оны тосын кешке айналдырыңыз
Dialogue: 0,0:13:47.24,0:13:50.57,Default,,0,0,0,,Тозақ мырзаны таң қалдырыңыз! 》 (Хазуки/Мэй)《Хехе》
Dialogue: 0,0:13:50.57,0:13:53.24,Default,,0,0,0,,《Ей, мен Тозақ мырзаның нені жақсы көретінін білгім келеді.
Dialogue: 0,0:13:53.24,0:13:55.24,Default,,0,0,0,,Маған жасырын айтқаныңызды қалаймын》
Dialogue: 0,0:13:55.24,0:13:58.25,Default,,0,0,0,,《Чими~ Чимичими》
Dialogue: 0,0:13:58.25,0:14:01.52,Default,,0,0,0,,Міне, Азаттық мүсінінің фотоальбомы...
Dialogue: 0,0:14:01.52,0:14:06.19,Default,,0,0,0,,《Жарайды ма? Бұл жоспар ешқашан Тозақ мырза үшін жұмыс істемейді.
Dialogue: 0,0:14:06.19,0:14:08.86,Default,,0,0,0,,Тозақ, мен сені таң қалдырғалы жатырмын.
Dialogue: 0,0:14:08.86,0:14:10.86,Default,,0,0,0,,Хехе, асыға күтемін.
Dialogue: 0,0:14:10.86,0:14:14.26,Default,,0,0,0,,Тозақ мырза, оның түрі қандай? Фуфуфу》
Dialogue: 0,0:14:15.20,0:14:17.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:17.53,0:14:21.54,Default,,0,0,0,,Не болды, Тозақ мырза? Сол бет...
Dialogue: 0,0:14:21.54,0:14:25.21,Default,,0,0,0,,Ой... Жоқ, бұл...
Dialogue: 0,0:14:25.21,0:14:29.88,Default,,0,0,0,,Кішігірім оқыс оқиғадан мұрнымнан арпа шайы шыға бастады.
Dialogue: 0,0:14:29.88,0:14:31.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:31.88,0:14:33.88,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:14:33.88,0:14:35.89,Default,,0,0,0,,Жеңіл жазатайым оқиға дегеніміз не?
Dialogue: 0,0:14:35.89,0:14:38.22,Default,,0,0,0,,А... бұл...
Dialogue: 0,0:14:38.22,0:14:40.22,Default,,0,0,0,,О, арпа шайы бар.
Dialogue: 0,0:14:40.22,0:14:42.22,Default,,0,0,0,,Ах! Тоқта
Dialogue: 0,0:14:42.22,0:14:44.56,Default,,0,0,0,,Тозақ мырзаның арпа шайы өрескел және мүмкін емес.
Dialogue: 0,0:14:44.56,0:14:46.56,Default,,0,0,0,,Өміріңізде ешқашан арпа шайын қайнатпаңыз.
Dialogue: 0,0:14:46.56,0:14:48.56,Default,,0,0,0,,А...
Dialogue: 0,0:14:48.56,0:14:51.23,Default,,0,0,0,,Сонымен... солай ма?
Dialogue: 0,0:14:51.23,0:14:55.24,Default,,0,0,0,,Аха аха аха ахаха...
Dialogue: 0,0:14:55.24,0:14:58.17,Default,,0,0,0,,Тозақ...
Dialogue: 0,0:17:30.19,0:17:32.79,Default,,0,0,0,,«Өлі тозақ»
Dialogue: 0,0:17:34.53,0:17:37.20,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:17:37.20,0:17:40.20,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:17:40.20,0:17:42.20,Default,,0,0,0,,Тозақта зомби бар ма?
Dialogue: 0,0:17:42.20,0:17:44.54,Default,,0,0,0,,Хазунексо Не? сол косплей
Dialogue: 0,0:17:44.54,0:17:46.88,Default,,0,0,0,,Менің жиенімнің туған күні
Dialogue: 0,0:17:46.88,0:17:49.21,Default,,0,0,0,,Мен саған оны тозаққа ұқсат дедім.
Dialogue: 0,0:17:49.21,0:17:52.21,Default,,0,0,0,,Сүйкімді емес пе? Бұл эротикалық түрі
Dialogue: 0,0:17:52.21,0:17:54.55,Default,,0,0,0,,Бұл зомбиден гөрі тозаққа ұқсайды, солай ма?
Dialogue: 0,0:17:54.55,0:17:57.89,Default,,0,0,0,,Зомбилер өлді, сондықтан бұл тозақ сияқты!
Dialogue: 0,0:17:57.89,0:18:00.22,Default,,0,0,0,,Әй, эй, ұрыспа.
Dialogue: 0,0:18:00.22,0:18:04.23,Default,,0,0,0,,Тозақ мырза қайтып келгенше безендіруді аяқтауым керек.
Dialogue: 0,0:18:04.23,0:18:06.56,Default,,0,0,0,,Муцүнэ... Не? Сол көзқарас
Dialogue: 0,0:18:06.56,0:18:11.23,Default,,0,0,0,,Не? Себебі олар тозақ сияқты киінеміз дейді.
Dialogue: 0,0:18:11.23,0:18:13.24,Default,,0,0,0,,Құмырсқа? Тозақ...
Dialogue: 0,0:18:13.24,0:18:15.57,Default,,0,0,0,,Ах~ Иә
Dialogue: 0,0:18:15.57,0:18:18.84,Default,,0,0,0,,Дұрыс, құмырсқа тозағының ішінде.
Dialogue: 0,0:18:18.84,0:18:22.84,Default,,0,0,0,,Бұл дұрыс емес пе? Тіпті тозақ да әртүрлілік
Dialogue: 0,0:18:24.85,0:18:27.52,Default,,0,0,0,,Айтайын дегенім бүгін сенің туған күнің неліктен?
Dialogue: 0,0:18:27.52,0:18:30.52,Default,,0,0,0,,Тозақ, сен туған күніңді білмейсің ғой?
Dialogue: 0,0:18:30.52,0:18:33.19,Default,,0,0,0,,Иә, бүгін Буцумецу.
Dialogue: 0,0:18:33.19,0:18:35.86,Default,,0,0,0,,Тозақтың келгеніне тура 49 күн болды.
Dialogue: 0,0:18:35.86,0:18:39.86,Default,,0,0,0,,Бұл не? Эй, тозақ, сен әлі оралдың ба?
Dialogue: 0,0:18:39.86,0:18:42.87,Default,,0,0,0,,Мен одан келесі қалаға дүкен аралауды өтіндім.
Dialogue: 0,0:18:42.87,0:18:45.20,Default,,0,0,0,,Әлі де біраз уақыт қажет емес пе?
Dialogue: 0,0:18:45.20,0:18:49.87,Default,,0,0,0,,Хехехе, мен тосын туған күн кешін тозақтан күтіп жүрмін.
Dialogue: 0,0:18:49.87,0:18:52.21,Default,,0,0,0,,Сізді қатты таң қалдыратыныңызға сенімдімін.
Dialogue: 0,0:18:52.21,0:18:54.21,Default,,0,0,0,,()
Dialogue: 0,0:18:56.21,0:18:58.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:58.55,0:19:00.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:00.55,0:19:04.89,Default,,0,0,0,,Иә! Бұл өтірік...Сене алар емеспін!
Dialogue: 0,0:19:04.89,0:19:07.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:07.22,0:19:12.23,Default,,0,0,0,,Бұл таңқаларлық екенін білсең де, таң қалу қиын.
Dialogue: 0,0:19:12.23,0:19:14.90,Default,,0,0,0,,Чимими~ (Тозақ-сан) Иә? «Сіз бақытты көрінесіз»?
Dialogue: 0,0:19:14.90,0:19:18.50,Default,,0,0,0,,Сен ақымақсың ба? Мен тозақтан келген хабаршымын.
Dialogue: 0,0:19:18.50,0:19:21.50,Default,,0,0,0,,Туған күнді бұлай өткізуге қуану мүмкін емес.
Dialogue: 0,0:19:21.50,0:19:25.51,Default,,0,0,0,,Олардың ойлағанын алып тастауы аянышты.
Dialogue: 0,0:19:25.51,0:19:28.51,Default,,0,0,0,,Оған көмектесу мүмкін емес, сондықтан жай ғана тойланыңыз.
Dialogue: 0,0:19:28.51,0:19:31.85,Default,,0,0,0,,Бірақ туған күн кешінде не істейміз деп ойлаймын.
Dialogue: 0,0:19:31.85,0:19:34.85,Default,,0,0,0,,Туған күн кеші... хахахаха
Dialogue: 0,0:19:34.85,0:19:36.85,Default,,0,0,0,,Чими~
Dialogue: 0,0:19:36.85,0:19:39.86,Default,,0,0,0,,Жақсы! Мен үйге ерте барамын.
Dialogue: 0,0:19:39.86,0:19:42.52,Default,,0,0,0,,Иә! Менің туған күнім?
Dialogue: 0,0:19:42.52,0:19:46.53,Default,,0,0,0,,Бұл не?! иә!
Dialogue: 0,0:19:46.53,0:19:48.53,Default,,0,0,0,,Мен асыра айтып тұрмын ба?
Dialogue: 0,0:19:48.53,0:19:51.53,Default,,0,0,0,,Не? Менің туған күнім?
Dialogue: 0,0:19:51.53,0:19:53.54,Default,,0,0,0,,Жарайды, егер сендер осылай жасағыларың келсе.
Dialogue: 0,0:19:53.54,0:19:55.54,Default,,0,0,0,,Оған көмектесу мүмкін емес, иә.
Dialogue: 0,0:19:55.54,0:19:57.84,Default,,0,0,0,,Бұл емес, мұнымен жүрейік.
Dialogue: 0,0:19:59.88,0:20:02.21,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:20:02.21,0:20:04.21,Default,,0,0,0,,(Крекер дыбысы)
Dialogue: 0,0:20:04.21,0:20:07.21,Default,,0,0,0,,Туған күнің құтты болсын, тозақ!
Dialogue: 0,0:20:08.55,0:20:10.55,Default,,0,0,0,,Чими... (Мистер Тозақ)...
Dialogue: 0,0:20:10.55,0:20:14.22,Default,,0,0,0,,Иә! иә! Шабуыл...
Dialogue: 0,0:20:14.22,0:20:16.23,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:20:16.23,0:20:18.49,Default,,0,0,0,,Бүгін Тозақтың туған күні.
Dialogue: 0,0:20:18.49,0:20:20.50,Default,,0,0,0,,Жиенім ойланып қалды.
Dialogue: 0,0:20:20.50,0:20:23.83,Default,,0,0,0,,Міне! О, өлі?
Dialogue: 0,0:20:23.83,0:20:27.17,Default,,0,0,0,,Өлді ме? Чимимононың досы, солай ма?
Dialogue: 0,0:20:27.17,0:20:30.17,Default,,0,0,0,,Өлген сияқты, сондықтан өлді.
Dialogue: 0,0:20:30.17,0:20:32.17,Default,,0,0,0,,… ()
Dialogue: 0,0:20:32.17,0:20:34.51,Default,,0,0,0,,()
Dialogue: 0,0:20:34.51,0:20:38.51,Default,,0,0,0,,Иә! Әй, Сенпай, иә! иә?
Dialogue: 0,0:20:38.51,0:20:43.19,Default,,0,0,0,,Ах... иә, Тозақтың Сенпайы, Чими Мурью, осында.
Dialogue: 0,0:20:43.19,0:20:47.86,Default,,0,0,0,,Не? Чими Муриоға тозақ жоспарының барысын көрсету керек пе?
Dialogue: 0,0:20:47.86,0:20:50.26,Default,,0,0,0,,Иә! Аа, әрине!
Dialogue: 0,0:20:51.53,0:20:53.53,Default,,0,0,0,,Сонымен, әлгі қарт...
Dialogue: 0,0:20:53.53,0:20:56.87,Default,,0,0,0,,Тозақтандыру жоспары орындалмай қоймайды,
Dialogue: 0,0:20:56.87,0:21:00.54,Default,,0,0,0,,Адамдардың менің туған күнімді өткізіп жатқанына сене алар емеспін.
Dialogue: 0,0:21:00.54,0:21:03.54,Default,,0,0,0,,Тозақ Сенпай білсе...
Dialogue: 0,0:21:03.54,0:21:05.54,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:05.54,0:21:07.54,Default,,0,0,0,,<Өлтірілген...
Dialogue: 0,0:21:07.54,0:21:11.88,Default,,0,0,0,,Мені жиенім дайындаған туған күн кеші өлтірді! >
Dialogue: 0,0:21:11.88,0:21:15.55,Default,,0,0,0,,Уф... тозақта не істеуім керек?
Dialogue: 0,0:21:15.55,0:21:18.49,Default,,0,0,0,,Иә? иә? Ол ше?
Dialogue: 0,0:21:18.49,0:21:20.49,Default,,0,0,0,,Чими? (Мистер Тозақ) Иә?
Dialogue: 0,0:21:20.49,0:21:22.49,Default,,0,0,0,,Чими! (Мистер Тозақ) Уау!
Dialogue: 0,0:21:22.49,0:21:25.49,Default,,0,0,0,,«Адамның тозақ әлемі» бөліміне қош келдіңіз
Dialogue: 0,0:21:25.49,0:21:27.83,Default,,0,0,0,,Мен Джигоку-сенпайдан естідім.
Dialogue: 0,0:21:27.83,0:21:31.50,Default,,0,0,0,,А... жарайды, оны тозаққа айналдырудың жоспары ғой...
Dialogue: 0,0:21:31.50,0:21:36.50,Default,,0,0,0,,Мм, сіз көп прогреске қол жеткізе алмасаңыз...
Dialogue: 0,0:21:38.17,0:21:40.17,Default,,0,0,0,,Эй!
Dialogue: 0,0:21:44.51,0:21:46.52,Default,,0,0,0,,Эххехе Эхехехе...
Dialogue: 0,0:21:46.52,0:21:49.18,Default,,0,0,0,,Тозақ, тост ішейік~
Dialogue: 0,0:21:49.18,0:21:51.19,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:21:51.19,0:21:53.52,Default,,0,0,0,,А, дұрыс!
Dialogue: 0,0:21:53.52,0:21:57.86,Default,,0,0,0,,Бұл адамдар адам әлеміндегі зұлым ұйымды басқаратын жаман адамдар.
Dialogue: 0,0:21:57.86,0:22:01.86,Default,,0,0,0,,Адамдық пен кемшілікті тозақ жағына сатсақ,
Dialogue: 0,0:22:01.86,0:22:06.54,Default,,0,0,0,,Олай болса, бұдан былай адам әлемінде тозақтың дүниеге келуін тойлайық.
Dialogue: 0,0:22:06.54,0:22:08.87,Default,,0,0,0,,«Тозақтың туған күні»
Dialogue: 0,0:22:08.87,0:22:12.54,Default,,0,0,0,,Біз тозақтану жоспарының соңғы отырысын өткізгелі жатыр едік.
Dialogue: 0,0:22:12.54,0:22:15.84,Default,,0,0,0,,Жақсы, сіз дұрыс жерге келдіңіз.
Dialogue: 0,0:22:17.55,0:22:19.82,Default,,0,0,0,,Сосын тағы да...
Dialogue: 0,0:22:19.82,0:22:22.48,Default,,0,0,0,,Тозақтың туған күнін тойлау
Dialogue: 0,0:22:22.48,0:22:24.49,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:22:24.49,0:22:27.82,Default,,0,0,0,,Сәттілік! Ах... Сәлем! Сәлем!
Dialogue: 0,0:22:27.82,0:22:29.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:29.83,0:22:31.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:31.83,0:22:33.83,Default,,0,0,0,,Өйткені мен сіздің жасыңызды білмедім
Dialogue: 0,0:22:33.83,0:22:36.83,Default,,0,0,0,,Әзірше мен оны тозақтық санға айналдыруға тырыстым.
Dialogue: 0,0:22:36.83,0:22:40.50,Default,,0,0,0,,Тілек айту кезінде шырақты сөндір.
Dialogue: 0,0:22:40.50,0:22:42.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:42.50,0:22:45.84,Default,,0,0,0,,А, онда мен әлемді тозаққа айналдырамын~
Dialogue: 0,0:22:45.84,0:22:48.18,Default,,0,0,0,,Иә (тыныс алу дыбысы)
Dialogue: 0,0:22:48.18,0:22:50.85,Default,,0,0,0,,Ва~хахахаха!
Dialogue: 0,0:22:50.85,0:22:53.52,Default,,0,0,0,,Бұл не? Бұл тозақ Ахахха
Dialogue: 0,0:22:53.52,0:22:56.19,Default,,0,0,0,,Иә, бәрі бірге тамақтансын.
Dialogue: 0,0:22:56.19,0:22:58.85,Default,,0,0,0,,Чими~
Dialogue: 0,0:22:58.85,0:23:00.85,Default,,0,0,0,,Чими!
Dialogue: 0,0:23:03.86,0:23:05.86,Default,,0,0,0,,Чими…
Dialogue: 0,0:23:07.53,0:23:09.53,Default,,0,0,0,,Чими Чими~
Dialogue: 0,0:23:09.53,0:23:11.53,Default,,0,0,0,,Ми... ми!
Dialogue: 0,0:23:14.20,0:23:16.80,Default,,0,0,0,,Чи… чими~
Dialogue: 0,0:23:19.14,0:23:23.15,Default,,0,0,0,,(Тозақ-сан)
Dialogue: 0,0:23:23.15,0:23:25.81,Default,,0,0,0,,Жая~! Пината!
Dialogue: 0,0:23:25.81,0:23:27.82,Default,,0,0,0,,Пиньата? Ах!
Dialogue: 0,0:23:27.82,0:23:31.15,Default,,0,0,0,,Ішінде кәмпит бар, оны сындырасың.
Dialogue: 0,0:23:31.15,0:23:34.49,Default,,0,0,0,,Бұл менің отбасымның туған күні болды.
Dialogue: 0,0:23:34.49,0:23:36.49,Default,,0,0,0,,Мен мұны біраз уақыттан кейін бірінші рет жасағым келді
Dialogue: 0,0:23:36.49,0:23:39.49,Default,,0,0,0,,Иә, осыған бөліңіз
Dialogue: 0,0:23:39.49,0:23:44.49,Default,,0,0,0,,Адамдарды тозаққа айналдыруды жоспарлаңыз. Біз алдымен адамдарға осылай қарауды жоспарлап отырмыз.
Dialogue: 0,0:23:45.83,0:23:49.17,Default,,0,0,0,,Тозақтың жазасын ал!
Dialogue: 0,0:23:49.17,0:23:51.84,Default,,0,0,0,,Ei Ei Ei Ei!
Dialogue: 0,0:23:51.84,0:23:53.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:53.84,0:23:57.18,Default,,0,0,0,,Сәлем! Мынаны да жеп ал! Тозаққа кет!
Dialogue: 0,0:23:57.18,0:24:00.85,Default,,0,0,0,,Хе... Хмф! Хмф! Хмф!
Dialogue: 0,0:24:00.85,0:24:03.52,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,0:24:03.52,0:24:06.19,Default,,0,0,0,,Иә, ол тозаққа толы.
Dialogue: 0,0:24:06.19,0:24:08.19,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:24:09.52,0:24:11.53,Default,,0,0,0,,Қазір! Бұл Тори Сабль!
Dialogue: 0,0:24:11.53,0:24:13.53,Default,,0,0,0,,Чими~
Dialogue: 0,0:24:13.53,0:24:16.53,Default,,0,0,0,,Бұл тәтті, қытырлақ және дәмді.
Dialogue: 0,0:24:19.13,0:24:22.14,Default,,0,0,0,,Ха! Мен оны тозаққа айналдыруым керек ...
Dialogue: 0,0:24:22.14,0:24:25.47,Default,,0,0,0,,Сіз мұны осылай жасайсыз! Хмф!
Dialogue: 0,0:24:25.47,0:24:28.14,Default,,0,0,0,,Чими! Чими мими…
Dialogue: 0,0:24:28.14,0:24:30.44,Default,,0,0,0,,Мен сені қоқысқа айналдырып, жеймін
Dialogue: 0,0:24:33.48,0:24:35.48,Default,,0,0,0,,О...
Dialogue: 0,0:24:35.48,0:24:37.82,Default,,0,0,0,,Вахахаха! Хехе
Dialogue: 0,0:24:37.82,0:24:41.49,Default,,0,0,0,,Тамақтанудың жабайы, тозақтыққа шыдамас
Dialogue: 0,0:24:41.49,0:24:44.19,Default,,0,0,0,,Пиньятаға ренішіңіз бар ма?
Dialogue: 0,0:24:45.49,0:24:48.83,Default,,0,0,0,,Тозақ мырзаға сыйлығымыз бар.
Dialogue: 0,0:24:48.83,0:24:50.83,Default,,0,0,0,,Сыйлық па?
Dialogue: 0,0:24:50.83,0:24:53.83,Default,,0,0,0,,Иә, 100 миллион иен (Мистер Тозақ) 100 миллион иен!
Dialogue: 0,0:24:54.84,0:24:57.17,Default,,0,0,0,,Жарайды, бұл қазірдің өзінде оған тұрарлық емес.
Dialogue: 0,0:24:57.17,0:25:00.51,Default,,0,0,0,,10 жылдан кейін бұл сан шамамен 100 миллионға жетеді деп күтілуде.
Dialogue: 0,0:25:00.51,0:25:02.84,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,0:25:02.84,0:25:04.85,Default,,0,0,0,,Мен Тозақ мырзаның суретін салдым
Dialogue: 0,0:25:04.85,0:25:06.85,Default,,0,0,0,,Бұл мен бе?
Dialogue: 0,0:25:06.85,0:25:09.18,Default,,0,0,0,,Түсіндім. Рақмет сізге.
Dialogue: 0,0:25:09.18,0:25:11.19,Default,,0,0,0,,Маған қамқор болған сен бе? Рақмет…
Dialogue: 0,0:25:11.19,0:25:15.86,Default,,0,0,0,,Ах... бұл адам бет-бейнесі авангардтық өнер тозағы.
Dialogue: 0,0:25:15.86,0:25:18.53,Default,,0,0,0,,Адамдарды осындай етіп көрсететін ол тозақ.
Dialogue: 0,0:25:18.53,0:25:20.86,Default,,0,0,0,,Жасағым келеді
Dialogue: 0,0:25:20.86,0:25:23.26,Default,,0,0,0,,Мен оларды соншалықты ұнатпаймын...
Dialogue: 0,0:25:26.20,0:25:28.20,Default,,0,0,0,,Хии, хии, фууу…
Dialogue: 0,0:25:28.20,0:25:31.20,Default,,0,0,0,,Хабу саке Бұл менің қолымнан жасалған.
Dialogue: 0,0:25:32.21,0:25:34.54,Default,,0,0,0,,О, иә, рахмет... Ах!
Dialogue: 0,0:25:34.54,0:25:37.88,Default,,0,0,0,,Ол кез келген аңды секундта жеңіп, бәрін жей алады.
Dialogue: 0,0:25:37.88,0:25:40.22,Default,,0,0,0,,Мен қорқынышты адаммын
Dialogue: 0,0:25:40.22,0:25:44.22,Default,,0,0,0,,Бұл тозақтандыру жоспарының соңғы қаруы болады деп жоспарлануда.
Dialogue: 0,0:25:44.22,0:25:48.22,Default,,0,0,0,,Жиеніңіз ше? Мен хат жаздым.
Dialogue: 0,0:25:48.22,0:25:50.56,Default,,0,0,0,,Хат?
Dialogue: 0,0:25:50.56,0:25:52.56,Default,,0,0,0,,«Тозаққа
Dialogue: 0,0:25:52.56,0:25:56.57,Default,,0,0,0,,Мистер Тозақ Чимимо және басқаларымен біздің үйге келгенде
Dialogue: 0,0:25:56.57,0:25:59.57,Default,,0,0,0,,Чимимо басында сүйкімді, бірақ
Dialogue: 0,0:25:59.57,0:26:01.90,Default,,0,0,0,,Тозақ мырза қарт адам.
Dialogue: 0,0:26:01.90,0:26:04.24,Default,,0,0,0,,Жын-шайтан болған соң шашың түсіп қалады.
Dialogue: 0,0:26:04.24,0:26:07.24,Default,,0,0,0,,Ылғалды кезде жануардың қатты иісі шығады.
Dialogue: 0,0:26:07.24,0:26:10.25,Default,,0,0,0,,Мен бұл аздап жиіркенішті деп ойладым».
Dialogue: 0,0:26:10.25,0:26:13.25,Default,,0,0,0,,Жануардың иісі бар ма? (иіскеу дыбысы)
Dialogue: 0,0:26:13.25,0:26:16.25,Default,,0,0,0,,«Бірақ біз бірге тұрған кезде,
Dialogue: 0,0:26:16.25,0:26:20.19,Default,,0,0,0,,Тозақ мырза жалғыз адам болса да, қалыпты тамақтанады.
Dialogue: 0,0:26:20.19,0:26:24.19,Default,,0,0,0,,Суға шомылыңыз және өз өміріңізді ұстанбай өткізіңіз.
Dialogue: 0,0:26:24.19,0:26:27.53,Default,,0,0,0,,Ақшам жоқ болса да, күнде бақытты өмір сүремін.
Dialogue: 0,0:26:27.53,0:26:31.20,Default,,0,0,0,,Оның жүрегі күшті және менің ойымша, бұл шынымен де керемет».
Dialogue: 0,0:26:31.20,0:26:33.20,Default,,0,0,0,,Хаа…
Dialogue: 0,0:26:33.20,0:26:36.20,Default,,0,0,0,,«Мен әкемді ешқашан кездестірмедім, бірақ
Dialogue: 0,0:26:36.20,0:26:39.21,Default,,0,0,0,,Менің әкем болса, осындай болар еді
Dialogue: 0,0:26:39.21,0:26:41.54,Default,,0,0,0,,Әр күнің көңілді өтетініне сенімдімін.
Dialogue: 0,0:26:41.54,0:26:43.54,Default,,0,0,0,,Мен солай ойлаймын».
Dialogue: 0,0:26:45.21,0:26:48.22,Default,,0,0,0,,«Тозақ-сан, Кишин отбасына қош келдіңіз.
Dialogue: 0,0:26:48.22,0:26:51.22,Default,,0,0,0,,Мен сіздің тұрақты қолдауыңызды күтемін, Мейори».
Dialogue: 0,0:26:51.22,0:26:53.22,Default,,0,0,0,,Mei...
Dialogue: 0,0:26:53.22,0:26:56.22,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:26:56.22,0:26:59.23,Default,,0,0,0,,Иә? Жынның көзіне жас?
Dialogue: 0,0:26:59.23,0:27:01.90,Default,,0,0,0,,Жоқ... Менің жылағым келмейді! Сен ақымақсың ба?
Dialogue: 0,0:27:01.90,0:27:04.23,Default,,0,0,0,,Рахмет Мей
Dialogue: 0,0:27:04.23,0:27:06.57,Default,,0,0,0,,Мүмкін, осы жолы қатысады
Dialogue: 0,0:27:06.57,0:27:08.57,Default,,0,0,0,,Бұл... бұған ешқандай түсініктеме жоқ... Иә?
Dialogue: 0,0:27:11.91,0:27:13.91,Default,,0,0,0,,Бүгінгі еңбектеріңізге рахмет.
Dialogue: 0,0:27:13.91,0:27:15.91,Default,,0,0,0,,Бұл кәдесый.
Dialogue: 0,0:27:15.91,0:27:17.91,Default,,0,0,0,,Чими~
Dialogue: 0,0:27:17.91,0:27:21.91,Default,,0,0,0,,Джигоку-сенпайға сәлемімді айтыңыз.
Dialogue: 0,0:27:29.19,0:27:31.19,Default,,0,0,0,,Хаа…
Dialogue: 0,0:27:31.19,0:27:34.86,Default,,0,0,0,,Сіз тозақ жасау жоспары орындалмай жатқанын білдіңіз бе?
Dialogue: 0,0:27:34.86,0:27:36.87,Default,,0,0,0,,～
Dialogue: 0,0:27:36.87,0:27:38.87,Default,,0,0,0,,Ішейік
Dialogue: 0,0:27:38.87,0:27:41.87,Default,,0,0,0,,Бүгін сізде неше рет болды? Хехе
Dialogue: 0,0:27:41.87,0:27:44.54,Default,,0,0,0,,Сонымен... Муцуми қандай киінген?
Dialogue: 0,0:27:44.54,0:27:47.21,Default,,0,0,0,,Бұл құмырсқа Джигоку (Мистер Тозақ) Құмырсқа ма?
Dialogue: 0,0:27:47.21,0:27:49.81,Default,,0,0,0,,(Мэйдің күлкісі)
Dialogue: 0,0:27:53.55,0:28:13.57,Default,,0,0,0,,Сен
Dialogue: 0,0:28:13.57,0:28:33.52,Default,,0,0,0,,Сен
Dialogue: 0,0:28:33.52,0:28:53.54,Default,,0,0,0,,Сен
Dialogue: 0,0:28:53.54,0:29:13.56,Default,,0,0,0,,Сен
Dialogue: 0,0:29:13.56,0:29:22.86,Default,,0,0,0,,Сен
Dialogue: 0,0:29:23.84,0:29:25.84,Default,,0,0,0,,<Тозақ поштасынан алынған
Dialogue: 0,0:29:25.84,0:29:29.84,Default,,0,0,0,,«Тозақ мәселесі» адамның бақытсыздығын өзіне сіңіріп, үлкен болады
Dialogue: 0,0:29:29.84,0:29:32.85,Default,,0,0,0,,Жақсы, жақсы! Көбірек темекі шегіңіз!
Dialogue: 0,0:29:32.85,0:29:35.18,Default,,0,0,0,,Келесі жолы: «Тозақ мәселесі»
Dialogue: 0,0:29:35.18,0:29:37.19,Default,,0,0,0,,«Бақыт тозағы» туралы екі кітап>
Dialogue: 0,0:29:38.69,0:29:44.69,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory