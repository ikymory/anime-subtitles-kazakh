Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.46,0:00:37.00,Default,,0,0,0,,Керемет! Ол соншалықты алыс ұшты!
Dialogue: 0,0:00:37.00,0:00:39.52,Default,,0,0,0,,Енді Чика-чанның ұшатын кезегі!
Dialogue: 0,0:00:39.52,0:00:42.68,Default,,0,0,0,,Эй, мен де.
Dialogue: 0,0:00:42.68,0:00:43.72,Default,,0,0,0,,Міне!
Dialogue: 0,0:00:43.72,0:00:47.88,Default,,0,0,0,,Ах~ тағы да ұшатын шығар деп ойладым.
Dialogue: 0,0:00:47.88,0:00:50.80,Default,,0,0,0,,Чика-чан, тағы бір рет, тағы бір рет!
Dialogue: 0,0:00:51.64,0:00:53.03,Default,,0,0,0,,...! иә!
Dialogue: 0,0:01:09.48,0:01:11.58,Default,,0,0,0,,Бұл сіздікі ме?
Dialogue: 0,0:01:11.58,0:01:13.29,Default,,0,0,0,,Иә! Бұл дұрыс.
Dialogue: 0,0:01:18.19,0:01:20.21,Default,,0,0,0,,Ол әрі қарай ұша ала ма?
Dialogue: 0,0:01:20.21,0:01:21.54,Default,,0,0,0,,Сіз оны ұша аласыз!
Dialogue: 0,0:01:21.54,0:01:24.39,Default,,0,0,0,,Толығырақ! Кемпірқосақтан да артық!
Dialogue: 0,0:01:38.36,0:01:41.37,Default,,0,0,0,,Сен тағы да биледің!
Dialogue: 0,0:01:41.37,0:01:45.50,Default,,0,0,0,,Осы мектепте, барлығымен, барлық Ақордалармен!
Dialogue: 0,0:01:45.50,0:01:48.32,Default,,0,0,0,,Білесің бе, мен саған бір нәрсе айтқым келеді.
Dialogue: 0,0:01:48.32,0:01:49.29,Default,,0,0,0,,Чика және
Dialogue: 0,0:01:49.29,0:01:50.29,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:01:50.29,0:01:51.79,Default,,0,0,0,,Нені жеткізгіңіз келеді?
Dialogue: 0,0:01:51.79,0:01:52.52,Default,,0,0,0,,Бірақ біз соншалықты жақын таныс емеспіз, сондықтан мен оның жеке ісіне араласқым келмейді, сондықтан [Сыртта: 583134B86E7D90960F64C5B863196978]
Dialogue: 0,0:01:52.52,0:01:53.34,Default,,0,0,0,,Зура?
Dialogue: 0,0:01:53.34,0:01:54.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:54.62,0:02:00.35,Default,,0,0,0,,Бұл біз 3 курс студенттері және Аква болашағы туралы әңгіме!
Dialogue: 0,0:02:01.04,0:02:02.09,Default,,0,0,0,,Болашақ...!
Dialogue: 0,0:02:04.38,0:02:06.06,Default,,0,0,0,,Манга ма? Ах, мен де бәрібір адам сияқты оқимын ғой, болар.
Dialogue: 0,0:02:06.06,0:02:12.37,Default,,0,0,0,,Жарқырағым келеді, бастағым келеді
Dialogue: 0,0:02:12.37,0:02:18.67,Default,,0,0,0,,Достарыммен кездескенде мен жүгірген жол
Dialogue: 0,0:02:18.67,0:02:26.88,Default,,0,0,0,,0-ден 1-ге өту қаншалықты қиын?
Dialogue: 0,0:02:26.88,0:02:39.66,Default,,0,0,0,,Бірақ ол байланысқа айналды.
Dialogue: 0,0:02:39.66,0:02:41.08,Default,,0,0,0,,Манга ма? Ах, мен де бәрібір адам сияқты оқимын ғой, болар.
Dialogue: 0,0:02:41.08,0:02:46.44,Default,,0,0,0,,Ештеңені түсінбеймін, Көз жасыммен, терлеп
Dialogue: 0,0:02:46.44,0:02:51.88,Default,,0,0,0,,Достарымның жігерімен жүріп өткен жолым
Dialogue: 0,0:02:51.88,0:02:58.58,Default,,0,0,0,,Аспанға қарап, күнде сөйлесетінбіз.
Dialogue: 0,0:02:58.58,0:03:06.41,Default,,0,0,0,,Сондықтан әркім қолынан келгенін жасады.
Dialogue: 0,0:03:06.41,0:03:13.36,Default,,0,0,0,,Арман мәңгі жүрегімде болды
Dialogue: 0,0:03:13.36,0:03:18.32,Default,,0,0,0,,Мен сені көрмей қала жаздасам да
Dialogue: 0,0:03:18.32,0:03:24.29,Default,,0,0,0,,Біз ешқашан берілмейміз!
Dialogue: 0,0:03:24.29,0:03:27.33,Default,,0,0,0,,Себебі мен жарық көрдім
Dialogue: 0,0:03:27.33,0:03:30.29,Default,,0,0,0,,Егер мен оған көбірек кіріссем
Dialogue: 0,0:03:30.29,0:03:36.83,Default,,0,0,0,,Мен оның өзгеретініне сендім
Dialogue: 0,0:03:39.08,0:03:42.80,Default,,0,0,0,,Барлығымен
Dialogue: 0,0:03:57.15,0:03:58.60,Default,,0,0,0,,Манга ма? Ах, мен де бәрібір адам сияқты оқимын ғой, болар.
Dialogue: 0,0:03:58.60,0:04:04.01,Default,,0,0,0,,Бір, екі, Тілегім орындалды.
Dialogue: 0,0:04:04.01,0:04:08.83,Default,,0,0,0,,Достарым барына қуанып, жолға жүгірдім.
Dialogue: 0,0:04:10.13,0:04:16.16,Default,,0,0,0,,Бірақ сіз білесіз бе, ажырасу барлығында болады.
Dialogue: 0,0:04:16.16,0:04:23.97,Default,,0,0,0,,Біз қайда барамыз? Тиісті мақсаттарымызға қарай
Dialogue: 0,0:04:23.97,0:04:30.84,Default,,0,0,0,,Әрі қарай жүгірейік, бізге осы ғана қалды
Dialogue: 0,0:04:30.84,0:04:35.84,Default,,0,0,0,,Мен солай ойлаймын, бірақ мен уайымдап отырмын.
Dialogue: 0,0:04:35.84,0:04:41.85,Default,,0,0,0,,Бізді ешқашан сүймейді
Dialogue: 0,0:04:41.85,0:04:44.85,Default,,0,0,0,,Өйткені мен оны ыстық сезінгім келеді
Dialogue: 0,0:04:44.85,0:04:47.84,Default,,0,0,0,,Басқа жолмен
Dialogue: 0,0:04:47.84,0:04:53.72,Default,,0,0,0,,Жаңадан армандау
Dialogue: 0,0:04:54.75,0:04:56.30,Default,,0,0,0,,О, мен не істеуім керек?
Dialogue: 0,0:04:56.30,0:04:57.72,Default,,0,0,0,,О, мен не істеуім керек?
Dialogue: 0,0:04:57.72,0:04:59.32,Default,,0,0,0,,О, мен не істеуім керек?
Dialogue: 0,0:04:59.32,0:05:00.72,Default,,0,0,0,,О, мен не істеуім керек?
Dialogue: 0,0:05:00.72,0:05:01.44,Default,,0,0,0,,Түсіндің бе? (Егер барсаң)
Dialogue: 0,0:05:01.44,0:05:01.96,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:05:01.96,0:05:06.38,Default,,0,0,0,,Біз болашақта кім боламыз...?
Dialogue: 0,0:05:28.60,0:05:30.54,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:05:30.54,0:05:37.44,Default,,0,0,0,,Өзің бол және сиқыр жаса
Dialogue: 0,0:05:37.44,0:05:45.19,Default,,0,0,0,,Достарымды шығарып салуға тура келетінін мойындаймын.
Dialogue: 0,0:05:47.16,0:05:54.15,Default,,0,0,0,,Жарайды, ол 0 емес! Менде бәрі жақсы, күлейік
Dialogue: 0,0:05:54.15,0:06:02.00,Default,,0,0,0,,Байқап көрейік, тырысамыз
Dialogue: 0,0:06:02.00,0:06:08.89,Default,,0,0,0,,Әрі қарай жүгірейік, бізге осы ғана қалды
Dialogue: 0,0:06:08.89,0:06:13.89,Default,,0,0,0,,Мен бұл туралы ойлағандықтан жүгіремін.
Dialogue: 0,0:06:13.89,0:06:19.91,Default,,0,0,0,,Бізді ешқашан аямайды
Dialogue: 0,0:06:19.91,0:06:22.87,Default,,0,0,0,,Өйткені мен оны ыстық сезінгім келеді
Dialogue: 0,0:06:22.87,0:06:25.86,Default,,0,0,0,,Басқа жолмен
Dialogue: 0,0:06:25.86,0:06:31.79,Default,,0,0,0,,Жаңадан армандау
Dialogue: 0,0:06:31.79,0:06:37.80,Default,,0,0,0,,Енді шымылдық ашылғанда, Мәңгілікке ән салғым келеді.
Dialogue: 0,0:06:37.80,0:06:45.31,Default,,0,0,0,,Таусылмас арман болсын...
Dialogue: 0,0:07:17.78,0:07:19.29,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:07:20.72,0:07:24.17,Default,,0,0,0,,Енді қайтіп жаттығу жасайық.
Dialogue: 0,0:07:24.17,0:07:29.01,Default,,0,0,0,,Иә. Алтауымыз жаңа мектепке барсақ та, біз Ақур болып қала береміз.
Dialogue: 0,0:07:31.37,0:07:32.43,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:32.43,0:07:34.78,Default,,0,0,0,,Бұл барлығының жауабы.
Dialogue: 0,0:07:34.78,0:07:36.56,Default,,0,0,0,,Мотивацияланған еркелік.
Dialogue: 0,0:07:36.56,0:07:37.42,Default,,0,0,0,,Гиран
Dialogue: 0,0:07:38.43,0:07:41.32,Default,,0,0,0,,Зура әдеттегідей атмосфераны оқи алмайды.
Dialogue: 0,0:07:41.32,0:07:42.56,Default,,0,0,0,,Бұл соншалықты қатты!
Dialogue: 0,0:07:44.54,0:07:45.63,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:45.63,0:07:48.36,Default,,0,0,0,,Сіз қай жерде жаттығу жасайсыз?
Dialogue: 0,0:07:48.36,0:07:51.20,Default,,0,0,0,,Қай жерде болса да, әдеттегі
Dialogue: 0,0:07:51.20,0:07:53.14,Default,,0,0,0,,...О, түсіндім.
Dialogue: 0,0:07:53.14,0:07:55.37,Default,,0,0,0,,Мен мектепті пайдалана алмаймын.
Dialogue: 0,0:07:55.37,0:07:57.87,Default,,0,0,0,,Станция алдындағы жаттығу алаңы қайда орналасқан?
Dialogue: 0,0:07:57.87,0:08:01.66,Default,,0,0,0,,Лав Лайв бар! Мен біткенше қалуға уәде беремін...
Dialogue: 0,0:08:01.66,0:08:04.53,Default,,0,0,0,,Иә? Сонымен не істеуіміз керек?
Dialogue: 0,0:08:04.53,0:08:06.09,Default,,0,0,0,,Мариден сұрауым керек пе?
Dialogue: 0,0:08:06.09,0:08:07.93,Default,,0,0,0,,Сіз бір жерден болжап отырсыз ба?
Dialogue: 0,0:08:10.04,0:08:11.05,Default,,0,0,0,,Хмм, Чика-чан?
Dialogue: 0,0:08:11.05,0:08:13.12,Default,,0,0,0,,Оны өзіміз іздеп көрейік.
Dialogue: 0,0:08:14.76,0:08:18.51,Default,,0,0,0,,Саған сүйенсем, қолымнан ештеңе келмейтіндей сезінемін.
Dialogue: 0,0:08:18.51,0:08:23.19,Default,,0,0,0,,Бұл алты адам – бастама. Осы алты адаммен бірдеңе істеуіміз керек.
Dialogue: 0,0:08:26.90,0:08:27.77,Default,,0,0,0,,Дұрыс? Хехе!
Dialogue: 0,0:08:30.58,0:08:31.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:32.65,0:08:33.70,Default,,0,0,0,,Жарқ етті!
Dialogue: 0,0:08:33.70,0:08:34.91,Default,,0,0,0,,Иә! Йо-чан!
Dialogue: 0,0:08:35.75,0:08:38.47,Default,,0,0,0,,Жаңа мектепті сынауға қалай қарайсыз?
Dialogue: 0,0:08:38.47,0:08:40.16,Default,,0,0,0,,Біз көктемнен барамыз,
Dialogue: 0,0:08:42.02,0:08:43.36,Default,,0,0,0,,Жаңа...
Dialogue: 0,0:08:44.42,0:08:46.42,Default,,0,0,0,,Мектеп...?
Dialogue: 0,0:08:49.28,0:08:51.17,Default,,0,0,0,,Бұл өте алыс.
Dialogue: 0,0:08:51.17,0:08:55.68,Default,,0,0,0,,Оқушылардың санын ескерсек, бұл өте үлкен мектеп сияқты.
Dialogue: 0,0:08:55.68,0:09:00.42,Default,,0,0,0,,Иә? Бұл жерде мектеп болды ма?
Dialogue: 0,0:09:10.72,0:09:11.78,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:09:11.78,0:09:13.95,Default,,0,0,0,,Немесе өткен...
Dialogue: 0,0:09:13.95,0:09:16.32,Default,,0,0,0,,-Иә, қателескен шығарсың, солай ма?
Dialogue: 0,0:09:16.32,0:09:20.28,Default,,0,0,0,,Иә? Бірақ бұл мектептен жіберілген электрондық хат, солай ма?
Dialogue: 0,0:09:20.92,0:09:25.75,Default,,0,0,0,,-Уранохши студенттері кіру салтанаты күні осында жиналуы керек. - Бұл шынымен де шынайы ма?
Dialogue: 0,0:09:25.75,0:09:28.78,Default,,0,0,0,,Ахх!
Dialogue: 0,0:09:28.78,0:09:30.13,Default,,0,0,0,,Сонымен... мені ұмытып қалғың келе ме?
Dialogue: 0,0:09:30.80,0:09:32.74,Default,,0,0,0,,Мектеп филиалы! ?
Dialogue: 0,0:09:34.62,0:09:35.84,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:09:35.84,0:09:41.15,Default,,0,0,0,,Бір дауыс Ура но Хошимен бірге болғылары келмейтінін айтып тұрған сияқты.
Dialogue: 0,0:09:41.15,0:09:45.23,Default,,0,0,0,,Біраз уақытқа филиал мектебіне барып, істің қалай жүріп жатқанын көру керек деп шешілді.
Dialogue: 0,0:09:45.23,0:09:50.76,Default,,0,0,0,,Сонымен, олар Уранохоши оқушылары үшін пайдаланылмайтын бастауыш мектепті жалға алған сияқты.
Dialogue: 0,0:09:50.76,0:09:53.19,Default,,0,0,0,,Қазіргі уақытта бір ғана сынып бар.
Dialogue: 0,0:09:53.19,0:09:58.43,Default,,0,0,0,,Біріктіруге байланысты жабылған мектепке көшудің мәні жоқ.
Dialogue: 0,0:09:58.43,0:10:04.23,Default,,0,0,0,,Сондай-ақ, үшінші курсты бітіргеннен кейін де, Руби және басқалары бір сыныпқа кірсе...
Dialogue: 0,0:10:06.60,0:10:08.34,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:09.35,0:10:09.92,Default,,0,0,0,,...Біз?
Dialogue: 0,0:10:10.72,0:10:13.80,Default,,0,0,0,,Ух...қош келдіңіз, тозақ аймағы...(Қош келдіңіз, hell zone.) -Хмф!
Dialogue: 0,0:10:16.51,0:10:19.98,Default,,0,0,0,,Бұл не! Мен сабақ бере алмаймын!
Dialogue: 0,0:10:19.98,0:10:22.20,Default,,0,0,0,,Мектептегі кумирлік іс-әрекеттер.
Dialogue: 0,0:10:22.20,0:10:23.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:23.01,0:10:26.60,Default,,0,0,0,,Бірақ неге кейбір адамдар бірге болғылары келмейді дейді?
Dialogue: 0,0:10:28.73,0:10:32.02,Default,,0,0,0,,Ойланып қарашы, Ю-чанға не болды? -сурет?
Dialogue: 0,0:10:33.86,0:10:35.93,Default,,0,0,0,,Иә, бұл рас.
Dialogue: 0,0:10:35.93,0:10:37.03,Default,,0,0,0,,Онда жоқ.
Dialogue: 0,0:10:37.03,0:10:39.73,Default,,0,0,0,,Мен осы уақытқа дейін отырдым.
Dialogue: 0,0:10:39.73,0:10:42.22,Default,,0,0,0,,Егер есімде дұрыс болса, маған телефон соқты.
Dialogue: 0,0:10:44.25,0:10:45.10,Default,,0,0,0,,Өтірік! ?
Dialogue: 0,0:10:46.69,0:10:47.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:47.61,0:10:48.96,Default,,0,0,0,,Зура!
Dialogue: 0,0:10:50.96,0:10:52.06,Default,,0,0,0,,Не?
Dialogue: 0,0:10:54.79,0:10:57.22,Default,,0,0,0,,На, на, нана жоқ зура~
Dialogue: 0,0:10:57.22,0:10:59.93,Default,,0,0,0,,Кішкентай жын аздап шу шығарып жатыр.
Dialogue: 0,0:10:59.93,0:11:00.69,Default,,0,0,0,,Пи, Пигги! ! !
Dialogue: 0,0:11:00.69,0:11:01.93,Default,,0,0,0,,Тынышталыңыз. П-Пигги! ! !
Dialogue: 0,0:11:02.59,0:11:04.61,Default,,0,0,0,,Не жасырып тұрсың?
Dialogue: 0,0:11:04.61,0:11:06.35,Default,,0,0,0,,Иә, не көрдіңіз?
Dialogue: 0,0:11:06.35,0:11:08.68,Default,,0,0,0,,Ештеңе, ештеңе!
Dialogue: 0,0:11:08.68,0:11:09.93,Default,,0,0,0,,Оны көрмегеніңіз жөн!
Dialogue: 0,0:11:09.93,0:11:11.60,Default,,0,0,0,,Дәл солай!
Dialogue: 0,0:11:13.15,0:11:14.65,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:18.15,0:11:22.34,Default,,0,0,0,,Аха! Мүмкін сіз бір жерден сүйкімді форманы таптыңыз ба?
Dialogue: 0,0:11:22.78,0:11:24.74,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:11:42.47,0:11:43.26,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:11:44.74,0:11:47.51,Default,,0,0,0,,Хё Айоэ, Хьюме Хюме.
Dialogue: 0,0:11:49.22,0:11:51.90,Default,,0,0,0,,Мен-көрдім. Юме.
Dialogue: 0,0:11:51.90,0:11:53.02,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:54.48,0:11:56.67,Default,,0,0,0,,Уф! Шындық – әділдік.
Dialogue: 0,0:11:56.67,0:11:57.27,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:11:57.27,0:12:00.06,Default,,0,0,0,,Мүмкін Ю Чанның інісі Зура шығар?
Dialogue: 0,0:12:00.06,0:12:01.46,Default,,0,0,0,,Інісі?
Dialogue: 0,0:12:01.46,0:12:05.30,Default,,0,0,0,,Мен ол жерде болмағандай сезінемін.
Dialogue: 0,0:12:05.30,0:12:06.94,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:12:06.94,0:12:08.28,Default,,0,0,0,,Күні,
Dialogue: 0,0:12:08.28,0:12:09.39,Default,,0,0,0,,Үлкен жын! ?
Dialogue: 0,0:12:09.39,0:12:11.33,Default,,0,0,0,,Эй, мына жаққа кел!
Dialogue: 0,0:12:12.84,0:12:15.04,Default,,0,0,0,,Мияу, мияу.
Dialogue: 0,0:12:16.09,0:12:17.60,Default,,0,0,0,,Неге жасырып тұрсың?
Dialogue: 0,0:12:17.82,0:12:19.05,Default,,0,0,0,,Өйткені,
Dialogue: 0,0:12:22.76,0:12:24.05,Default,,0,0,0,,О, ол жерде жоқ!
Dialogue: 0,0:12:24.05,0:12:25.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:25.76,0:12:27.56,Default,,0,0,0,,...
Dialogue: 0,0:12:28.30,0:12:30.06,Default,,0,0,0,,Сәттілік.
Dialogue: 0,0:12:37.82,0:12:39.60,Default,,0,0,0,,Тек оны итермеңіз.
Dialogue: 0,0:12:39.60,0:12:40.30,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:12:40.30,0:12:41.74,Default,,0,0,0,,Зураны тыңдау
Dialogue: 0,0:12:45.42,0:12:46.87,Default,,0,0,0,,Мияу, мияу.
Dialogue: 0,0:13:04.19,0:13:06.09,Default,,0,0,0,,Мияу, мияу.
Dialogue: 0,0:13:12.97,0:13:15.32,Default,,0,0,0,,Не, мысық?
Dialogue: 0,0:13:18.76,0:13:21.78,Default,,0,0,0,,Я, қауіпті, қауіпті.
Dialogue: 0,0:13:21.78,0:13:24.28,Default,,0,0,0,,Мен ұсталып қала жаздадым.
Dialogue: 0,0:13:26.41,0:13:27.87,Default,,0,0,0,,Йошико, Чан?
Dialogue: 0,0:13:30.29,0:13:34.42,Default,,0,0,0,,Тұтынушының ыңғайлылығына байланысты сіз жасаған қоңырауға жауап беру мүмкін емес.
Dialogue: 0,0:13:34.42,0:13:36.54,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:13:36.98,0:13:38.61,Default,,0,0,0,,Не болды, Ю-чан?
Dialogue: 0,0:13:38.61,0:13:40.73,Default,,0,0,0,,Ах, кешіріңіз, Цуки-чан.
Dialogue: 0,0:13:40.73,0:13:41.81,Default,,0,0,0,,Ай,
Dialogue: 0,0:13:41.81,0:13:43.01,Default,,0,0,0,,Чан?
Dialogue: 0,0:13:43.01,0:13:44.94,Default,,0,0,0,,Ой-оу! Чика-чан! ?
Dialogue: 0,0:13:44.94,0:13:48.26,Default,,0,0,0,,Ой, түсіндім, мен сені бұрын таныстырған жоқпын ба?
Dialogue: 0,0:13:48.90,0:13:50.88,Default,,0,0,0,,Менің немере ағам Цуки-чан!
Dialogue: 0,0:13:50.88,0:13:52.25,Default,,0,0,0,,Бұл ай.
Dialogue: 0,0:13:52.25,0:13:54.06,Default,,0,0,0,,Еуропа!
Dialogue: 0,0:13:54.06,0:13:55.67,Default,,0,0,0,,Мүмкін,
Dialogue: 0,0:13:55.67,0:13:56.93,Default,,0,0,0,,Сіз қызсыз ба?
Dialogue: 0,0:13:58.00,0:14:00.15,Default,,0,0,0,,Не?
Dialogue: 0,0:14:03.67,0:14:06.57,Default,,0,0,0,,Не? Сонда сіз сол мектептің оқушысысыз ба?
Dialogue: 0,0:14:06.57,0:14:07.77,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:07.77,0:14:12.16,Default,,0,0,0,,Мектепке кірер алдында мен Ю Чаннан менімен бірге мектепке келуін өтіндім.
Dialogue: 0,0:14:12.16,0:14:15.45,Default,,0,0,0,,Йо Чан Чика Чанмен бірге мектепке барғысы келеді.
Dialogue: 0,0:14:15.45,0:14:17.56,Default,,0,0,0,,Мен-Солай ма?
Dialogue: 0,0:14:17.56,0:14:19.39,Default,,0,0,0,,Ұялатын ештеңе жоқ.
Dialogue: 0,0:14:19.39,0:14:21.50,Default,,0,0,0,,А, сен Рико-чансың, солай ма?
Dialogue: 0,0:14:21.50,0:14:22.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:22.17,0:14:25.26,Default,,0,0,0,,Йо Чан үнемі мені құрметтейтінін айтады.
Dialogue: 0,0:14:25.97,0:14:28.06,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:14:28.06,0:14:29.79,Default,,0,0,0,,Ұялатын ештеңе жоқ.
Dialogue: 0,0:14:31.26,0:14:32.68,Default,,0,0,0,,Чика-чан,
Dialogue: 0,0:14:32.68,0:14:35.64,Default,,0,0,0,,Руби-чан, Ханамару-чан, Йошико-чан,
Dialogue: 0,0:14:35.64,0:14:41.78,Default,,0,0,0,,Йо-чан Акурларды қатты ұнататын сияқты, біз олар туралы кездескен сайын сөйлесеміз.
Dialogue: 0,0:14:41.78,0:14:47.65,Default,,0,0,0,,Мен әрқашан Акурс Ю-чанның бір бөлігі деп ойлаймын.
Dialogue: 0,0:14:47.65,0:14:51.45,Default,,0,0,0,,Ух...осындай бірдеңені айтсаң шынымен ұят.
Dialogue: 0,0:14:51.45,0:14:55.98,Default,,0,0,0,,Ю-чан күткендей, екі жақтың арасында ешқандай айырмашылық жоқ.
Dialogue: 0,0:14:55.98,0:14:58.40,Default,,0,0,0,,Маған неге қарап тұрсың!
Dialogue: 0,0:14:58.40,0:15:00.42,Default,,0,0,0,,Сонымен қатар мектеп филиалы туралы...
Dialogue: 0,0:15:01.91,0:15:04.96,Default,,0,0,0,,Иә, неге олай дейсің...
Dialogue: 0,0:15:07.46,0:15:11.30,Default,,0,0,0,,Менің мектебімде үнемі үйірме жұмыстары белсенді болды.
Dialogue: 0,0:15:11.30,0:15:14.32,Default,,0,0,0,,Кейбір үйірме жұмыстары тіпті ұлттық жарыстарға да қатысады.
Dialogue: 0,0:15:14.61,0:15:16.10,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:15:17.15,0:15:21.49,Default,,0,0,0,,Уранохаши студенттері кіргенде, атмосфера толып кетті.
Dialogue: 0,0:15:21.49,0:15:25.61,Default,,0,0,0,,Кейбір ата-аналар дау-дамай бола ма деп алаңдайтын сияқты.
Dialogue: 0,0:15:26.73,0:15:27.95,Default,,0,0,0,,біздің орнымыз ба?
Dialogue: 0,0:15:27.95,0:15:30.01,Default,,0,0,0,,Неге олай айтып тұрсың!
Dialogue: 0,0:15:30.01,0:15:36.34,Default,,0,0,0,,, солай ма? Біз студенттерді де, мұғалімдерді де алаңдататын ештеңе жоқ деп сендіруге тырыстық.
Dialogue: 0,0:15:36.34,0:15:40.32,Default,,0,0,0,,Үйірме жұмыстарым дұрыс болмаса, не істеуім керек? Мен жауапкершілікті өз мойныма аламын ба?
Dialogue: 0,0:15:41.37,0:15:44.96,Default,,0,0,0,,Осылай айта бастасаң, қолыңнан ештеңе келмейді деп ойлаймын.
Dialogue: 0,0:15:46.96,0:15:50.38,Default,,0,0,0,,Сонымен, біз не істеу керектігін талқыладық.
Dialogue: 0,0:15:50.38,0:15:52.49,Default,,0,0,0,,Жалпы соғыс?
Dialogue: 0,0:15:52.49,0:15:54.22,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес. Ух,
Dialogue: 0,0:15:55.14,0:15:58.61,Default,,0,0,0,,Бұл адамдарды алаңдататын нәрсе - Уранохоши студенттері.
Dialogue: 0,0:15:58.61,0:16:02.35,Default,,0,0,0,,Менің ойымша, бұл сіздің клубтық іс-әрекеттеріңізді шындап атқара алатындығыңызға байланысты.
Dialogue: 0,0:16:02.35,0:16:07.22,Default,,0,0,0,,Сонымен, сізге тек дәлелденген тәжірибесі бар клубтық іс-шаралар бар екенін дәлелдеу керек.
Dialogue: 0,0:16:07.22,0:16:08.59,Default,,0,0,0,,Клуб қызметі...
Dialogue: 0,0:16:08.59,0:16:10.52,Default,,0,0,0,,Дәлелдеймін десең де...
Dialogue: 0,0:16:12.27,0:16:14.36,Default,,0,0,0,,Мұндай үйірме жұмыстары...
Dialogue: 0,0:16:19.09,0:16:20.33,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:16:22.10,0:16:24.88,Default,,0,0,0,,Бір ғана клуб ел біріншілігін жеңіп алды.
Dialogue: 0,0:16:26.85,0:16:27.57,Default,,0,0,0,,...Ах.
Dialogue: 0,0:16:28.81,0:16:34.39,Default,,0,0,0,,Біздің мектептің кумир клубы жаңа мектептегі басқа үйірмелер сияқты жақсы.
Dialogue: 0,0:16:34.39,0:16:40.52,Default,,0,0,0,,Адамдар біздің іс-әрекетімізге байсалды екенімізді және адамдарды жылжытып жатқанымызды түсінсе жақсы емес пе?
Dialogue: 0,0:16:40.52,0:16:43.32,Default,,0,0,0,,Бұл жақсы!
Dialogue: 0,0:16:43.32,0:16:44.49,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:16:44.49,0:16:46.40,Default,,0,0,0,,Сіз оны тікелей эфирде орындауды жоспарлап отырсыз ба?
Dialogue: 0,0:16:46.40,0:16:52.11,Default,,0,0,0,,Мұның бәрі жақсы, бірақ келесі аптада керемет оқиға болады!
Dialogue: 0,0:16:52.11,0:16:54.08,Default,,0,0,0,,Ми, ми,
Dialogue: 0,0:16:54.08,0:16:55.59,Default,,0,0,0,,Болашақ Зура!
Dialogue: 0,0:16:55.59,0:16:58.36,Default,,0,0,0,,Сіз барасыз ба? Шынымен...?
Dialogue: 0,0:17:02.77,0:17:07.12,Default,,0,0,0,,Міне! Талантты адам! Менің өткен өмірімді білетін адам...
Dialogue: 0,0:17:07.12,0:17:08.18,Default,,0,0,0,,Өткен өмірі?
Dialogue: 0,0:17:08.18,0:17:10.63,Default,,0,0,0,,Орта мектептегі сыныптасы Зура.
Dialogue: 0,0:17:11.71,0:17:13.80,Default,,0,0,0,,Бұл мектепке және барлығына арналған.
Dialogue: 0,0:17:27.60,0:17:29.02,Default,,0,0,0,,Орындау...
Dialogue: 0,0:17:29.02,0:17:31.46,Default,,0,0,0,,Мынадай үлкен жер еді...
Dialogue: 0,0:17:31.46,0:17:37.23,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Live Live! Финалдың өтетін орны жүздеген есе үлкен болды...
Dialogue: 0,0:17:38.22,0:17:40.11,Default,,0,0,0,,Ол кезде бәрі сонда болды...
Dialogue: 0,0:17:41.11,0:17:43.29,Default,,0,0,0,,Иә, қазір де.
Dialogue: 0,0:17:46.45,0:17:47.82,Default,,0,0,0,,Бұл бәрі ме?
Dialogue: 0,0:17:48.58,0:17:51.67,Default,,0,0,0,,Мен күткеннен 6 адам көп болды.
Dialogue: 0,0:17:51.67,0:17:53.09,Default,,0,0,0,,Мүмкін азырақ.
Dialogue: 0,0:17:54.67,0:17:57.08,Default,,0,0,0,,Кезек Ю Чанға келді.
Dialogue: 0,0:17:57.08,0:17:59.22,Default,,0,0,0,,Маған қосымша уақыт берілгендіктен,
Dialogue: 0,0:17:59.22,0:18:00.67,Default,,0,0,0,,Сәттілік.
Dialogue: 0,0:18:01.80,0:18:03.58,Default,,0,0,0,,Ура но Хошидегі барлық адамдар үшін.
Dialogue: 0,0:18:04.76,0:18:05.44,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:06.66,0:18:08.72,Default,,0,0,0,,Жарайды, сенің қолыңнан келеді.
Dialogue: 0,0:18:13.01,0:18:14.57,Default,,0,0,0,,0-ден 1-ге дейін,
Dialogue: 0,0:18:14.57,0:18:16.89,Default,,0,0,0,,1 және одан кейінгі;
Dialogue: 0,0:18:16.89,0:18:18.07,Default,,0,0,0,,Акурлар,
Dialogue: 0,0:18:18.07,0:18:21.62,Default,,0,0,0,,Саншаин
Dialogue: 0,0:18:23.83,0:18:30.68,Default,,0,0,0,,Олай болса, осы көктемнен бастап Уранохоши қыздар мектебінің пұт клубы мектебімізбен біріктіріледі.
Dialogue: 0,0:18:30.68,0:18:33.37,Default,,0,0,0,,Біз Аква тобының тірі қойылымын өткізгіміз келеді.
Dialogue: 0,0:18:36.29,0:18:37.59,Default,,0,0,0,,Бұл бастама.
Dialogue: 0,0:18:38.56,0:18:40.50,Default,,0,0,0,,Бұл біздің
Dialogue: 0,0:18:40.50,0:18:42.60,Default,,0,0,0,,Жаңа Акурлардың алғашқы қадамы.
Dialogue: 0,0:18:42.60,0:18:45.08,Default,,0,0,0,,Бұл алты адам алға қадам басады.
Dialogue: 0,0:18:45.08,0:18:46.11,Default,,0,0,0,,6 адам,
Dialogue: 0,0:18:47.28,0:18:48.12,Default,,0,0,0,,6 адам...
Dialogue: 0,0:19:14.54,0:19:16.75,Default,,0,0,0,,Сәтсіз қалдыңыз.
Dialogue: 0,0:19:16.75,0:19:20.31,Default,,0,0,0,,Мен мұндай қарапайым қателік жасаймын деп ешқашан ойламадым...
Dialogue: 0,0:19:20.31,0:19:23.79,Default,,0,0,0,,Мен босаңсығандықтан емес деп ойлаймын, бірақ
Dialogue: 0,0:19:23.79,0:19:26.52,Default,,0,0,0,,Бірдеңе мені ыңғайсыз сезініп тұр.
Dialogue: 0,0:19:26.52,0:19:27.93,Default,,0,0,0,,6 адам болса.
Dialogue: 0,0:19:28.98,0:19:30.06,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:19:35.05,0:19:37.09,Default,,0,0,0,,Міне, болды.
Dialogue: 0,0:19:37.09,0:19:38.83,Default,,0,0,0,,Чика!
Dialogue: 0,0:19:38.83,0:19:39.57,Default,,0,0,0,,Мутчан.
Dialogue: 0,0:19:41.57,0:19:42.69,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:19:44.34,0:19:49.00,Default,,0,0,0,,Өйткені, мен оны қазіргі қалпында сақтап, бір сәт салалық мектеп ретінде ұстағым келеді...
Dialogue: 0,0:19:49.76,0:19:51.42,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:51.42,0:19:54.88,Default,,0,0,0,,Кешіріңіз. Дұрыс жасасақ...
Dialogue: 0,0:19:54.88,0:19:59.88,Default,,0,0,0,,Иә, иә. Бұл Чика мен басқалардың кінәсі емес. Негізінде, кінәлі өзіміз.
Dialogue: 0,0:19:59.88,0:20:04.39,Default,,0,0,0,,Мектеп жабылғанда да, осы жолы да мен Чикаға және басқаларға толықтай сендім.
Dialogue: 0,0:20:04.39,0:20:09.98,Default,,0,0,0,,Негізі Чика мен басқалардан артық мақтанатын клуб жоқ...
Dialogue: 0,0:20:09.98,0:20:13.95,Default,,0,0,0,,Себебі аз ғана адам болды және барлығы қос бөлімде жұмыс істеді.
Dialogue: 0,0:20:13.95,0:20:15.56,Default,,0,0,0,,Бұл жүзу үйірмесіне де қатысты.
Dialogue: 0,0:20:16.15,0:20:21.21,Default,,0,0,0,,Бірақ біз мұны дұрыс жасауымыз керек еді...
Dialogue: 0,0:20:31.31,0:20:32.29,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:20:34.64,0:20:35.67,Default,,0,0,0,,...Рахмет?
Dialogue: 0,0:20:35.67,0:20:38.84,Default,,0,0,0,,Ура но Хошидің барлығы түсінеді.
Dialogue: 0,0:20:38.84,0:20:41.09,Default,,0,0,0,,Ескі мектеп ғимараттары да жаман емес.
Dialogue: 0,0:20:41.09,0:20:45.39,Default,,0,0,0,,Шындығында, менің ойымша, бұл бізге сәл көбірек ұқсайды.
Dialogue: 0,0:20:45.39,0:20:48.84,Default,,0,0,0,,Бұл шынымен де бізге ұқсайды.
Dialogue: 0,0:20:54.47,0:20:56.00,Default,,0,0,0,,Уф, итадаки!
Dialogue: 0,0:20:56.00,0:20:57.84,Default,,0,0,0,,Бұл адамдар ештеңе істемейді.
Dialogue: 0,0:20:57.84,0:20:58.98,Default,,0,0,0,,Бір!
Dialogue: 0,0:21:00.98,0:21:03.32,Default,,0,0,0,,Алты адам?
Dialogue: 0,0:21:08.74,0:21:12.51,Default,,0,0,0,,Біраз уақыт болды, солай емес пе? Сіз осылай сөйлесесіз.
Dialogue: 0,0:21:14.45,0:21:16.55,Default,,0,0,0,,Саған бәрібір ма?
Dialogue: 0,0:21:16.55,0:21:19.04,Default,,0,0,0,,Менің айтқым келгені бұл емес...
Dialogue: 0,0:21:22.36,0:21:27.51,Default,,0,0,0,,Менің ойымша, мектептегі кумирлер басқа клубтық іс-шараларға қарағанда оңай түсінілмейді.
Dialogue: 0,0:21:28.06,0:21:32.77,Default,,0,0,0,,Ол сахнада үнемі күлімсіреп жүреді, сондықтан ол жеткілікті байсалды емес сияқты,
Dialogue: 0,0:21:33.34,0:21:38.06,Default,,0,0,0,,Ол көңілді сияқты, сондықтан кейде жай ғана көңілді болып көрінеді.
Dialogue: 0,0:21:38.06,0:21:39.15,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:21:39.99,0:21:44.22,Default,,0,0,0,,Бірақ шын мәнінде олар ән айтып билеп, ауыр көрінді.
Dialogue: 0,0:21:44.22,0:21:47.90,Default,,0,0,0,,Мазасыз болып көрінсеңіз, қарап отырған адамдарға да ұнамайды.
Dialogue: 0,0:21:47.90,0:21:51.24,Default,,0,0,0,,Мен мұндай нәрсені көрсетпеуге тырысуым керек,
Dialogue: 0,0:21:52.40,0:21:55.19,Default,,0,0,0,,Менің ойымша, бізде сөзді берілмей жеткізуден басқа амал жоқ.
Dialogue: 0,0:21:56.16,0:22:00.05,Default,,0,0,0,,Тіпті Уранохашидің шәкірттері де өте көп жұмыс жасады.
Dialogue: 0,0:22:00.76,0:22:06.95,Default,,0,0,0,,Мектеп кумирлері мектептегі жаңа клубтық іс-шаралар сияқты байыпты жұмыс істейді деп айтылады.
Dialogue: 0,0:22:08.91,0:22:11.37,Default,,0,0,0,,Мен мұны білемін, бірақ...
Dialogue: 0,0:22:17.34,0:22:21.27,Default,,0,0,0,,Мен 6 адаммен жалғастыру нені білдіреді деп ойлаймын.
Dialogue: 0,0:22:22.02,0:22:27.53,Default,,0,0,0,,Мари-чан мен басқалары маған кем дегенде 6 адаммен жалғастыру керектігін айтқанда, мен оларды дұрыс деп ойладым.
Dialogue: 0,0:22:28.08,0:22:32.12,Default,,0,0,0,,Жарайды! Мен қатты толқып кеттім,
Dialogue: 0,0:22:32.12,0:22:36.19,Default,,0,0,0,,Біз алты адам болған соң, мен кенет бір нәрсеге алаңдадым.
Dialogue: 0,0:22:36.19,0:22:40.13,Default,,0,0,0,,Мен оны сахнада тұрған сәтте түсінгеніме сенімдімін.
Dialogue: 0,0:22:44.37,0:22:49.01,Default,,0,0,0,,Мари-чан, Канан-чан және Диа-чан енді жоқ.
Dialogue: 0,0:22:50.14,0:22:52.39,Default,,0,0,0,,Жаңа акурлар дегеніміз не?
Dialogue: 0,0:22:53.17,0:22:56.52,Default,,0,0,0,,Үш адам жоқ, Акурлар...
Dialogue: 0,0:22:58.20,0:23:00.31,Default,,0,0,0,,Не істеу керек? қазірден бастап.
Dialogue: 0,0:23:01.43,0:23:06.53,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, Уранохоши мен мектеп пұттары дұрыс түсінілмеуі мүмкін.
Dialogue: 0,0:23:07.88,0:23:08.78,Default,,0,0,0,,Кешігіп қалғаным үшін кешірім сұраймын.
Dialogue: 0,0:23:08.78,0:23:13.37,Default,,0,0,0,,Егер сәтсіздікке ұшырасақ, оның орнын өзіміз толтырудан басқа амалымыз жоқ, солай ма?
Dialogue: 0,0:23:15.37,0:23:17.25,Default,,0,0,0,,Менің ойымша, әлі уақыт бар.
Dialogue: 0,0:23:17.75,0:23:19.16,Default,,0,0,0,,Біз оны уақытында орындаймыз ба?
Dialogue: 0,0:23:19.16,0:23:24.63,Default,,0,0,0,,Иә! Қарсы болғандар сенің бұл жолы дұрыс істей алатыныңды көрсін.
Dialogue: 0,0:23:26.86,0:23:27.76,Default,,0,0,0,,Тікелей ме?
Dialogue: 0,0:23:27.76,0:23:32.91,Default,,0,0,0,,Алға жылжымайынша, жауаптарымызды таба алмаймыз деп ойлаймын.
Dialogue: 0,0:23:33.74,0:23:37.39,Default,,0,0,0,,Уайымдасаңыз да, жасайық! Live Live!
Dialogue: 0,0:23:39.72,0:23:41.60,Default,,0,0,0,,Бірдеңе Рико-чанға ұқсамайды!
Dialogue: 0,0:23:42.51,0:23:47.18,Default,,0,0,0,,Екеуміздің бірге жүргенімізге 1 жыл болғандықтан, мен басқа біреудің түсіне түстім бе деп ойлаймын?
Dialogue: 0,0:23:47.18,0:23:48.09,Default,,0,0,0,,Кімдікі?
Dialogue: 0,0:23:51.17,0:23:53.28,Default,,0,0,0,,Чика-чанға ұқсайды.
Dialogue: 0,0:23:53.97,0:23:57.38,Default,,0,0,0,,Менің ойымша, алда әлі көп жол бар.
Dialogue: 0,0:23:57.38,0:23:58.99,Default,,0,0,0,,Сіз жеңдіңіз, солай ма?
Dialogue: 0,0:23:59.87,0:24:03.00,Default,,0,0,0,,Бірақ бәрібір жақсы емес!
Dialogue: 0,0:24:03.00,0:24:05.13,Default,,0,0,0,,Түсіндім, жоқ, жоқ.
Dialogue: 0,0:24:08.28,0:24:09.65,Default,,0,0,0,,Сіз бақытты көрінесіз.
Dialogue: 0,0:24:09.65,0:24:10.81,Default,,0,0,0,,Рико-чан - бұл.
Dialogue: 0,0:24:10.90,0:24:14.64,Default,,0,0,0,,Иә, бұл бізге көбірек ұқсауы мүмкін.
Dialogue: 0,0:24:14.64,0:24:18.60,Default,,0,0,0,,Десе де, көп нәрсенің орындалуы керек деген сөз.
Dialogue: 0,0:24:20.02,0:24:20.98,Default,,0,0,0,,Жүгірейік!
Dialogue: 0,0:24:21.73,0:24:22.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:30.06,0:24:32.08,Default,,0,0,0,,Жарқыраған Зура...
Dialogue: 0,0:24:32.08,0:24:34.49,Default,,0,0,0,,Мен тағы бір айналып барамын.
Dialogue: 0,0:24:34.49,0:24:36.95,Default,,0,0,0,,Е...
Dialogue: 0,0:24:36.95,0:24:40.18,Default,,0,0,0,,Иччини-санши
Dialogue: 0,0:24:40.18,0:24:42.00,Default,,0,0,0,,Ниини-санши,
Dialogue: 0,0:24:42.00,0:24:44.87,Default,,0,0,0,,Сонымен, жаттығу орнымен не болды?
Dialogue: 0,0:24:44.87,0:24:48.50,Default,,0,0,0,,Мен көп іздедім, бірақ таба алмадым...
Dialogue: 0,0:24:48.50,0:24:51.17,Default,,0,0,0,,Әзірше бұл жерде істеуден басқа амалым жоқ.
Dialogue: 0,0:24:51.17,0:24:51.88,Default,,0,0,0,,Міне! ?
Dialogue: 0,0:24:51.88,0:24:55.22,Default,,0,0,0,,Біз басына оралған сияқтымыз.
Dialogue: 0,0:24:55.88,0:24:57.01,Default,,0,0,0,,Егер мені өлтірсең, сен де менің сияқты қарғыс атқан жанға айналасың.
Dialogue: 0,0:24:57.01,0:24:57.64,Default,,0,0,0,,Зура?
Dialogue: 0,0:24:57.64,0:25:03.37,Default,,0,0,0,,Бізде нақты жаттығу орны жоқ, бізде клуб бөлмесі жоқ және біздің топтың аты да жоқ!
Dialogue: 0,0:25:03.37,0:25:08.43,Default,,0,0,0,,Ал, мен Ю-чан мен Рико-чанмен сөйлескенде, біз осында жаттығатынбыз.
Dialogue: 0,0:25:09.20,0:25:12.00,Default,,0,0,0,,Содан мен Акурспен кездестім.
Dialogue: 0,0:25:12.57,0:25:13.74,Default,,0,0,0,,Иә.
Dialogue: 0,0:25:13.74,0:25:15.85,Default,,0,0,0,,Көп уақыт өтті!
Dialogue: 0,0:25:16.66,0:25:17.74,Default,,0,0,0,,Зура!
Dialogue: 0,0:25:21.26,0:25:22.16,Default,,0,0,0,,Риа-чан!
Dialogue: 0,0:25:22.16,0:25:24.75,Default,,0,0,0,,Әулие Қар.
Dialogue: 0,0:25:25.12,0:25:26.59,Default,,0,0,0,,Неліктен екі адам?
Dialogue: 0,0:25:26.59,0:25:29.66,Default,,0,0,0,,Мен оған электрондық хат жібергенімде, ол Токиоға келетінін айтты.
Dialogue: 0,0:25:29.66,0:25:32.02,Default,,0,0,0,,Мен сізге жаттығу көруге рұқсат етемін деп ойладым.
Dialogue: 0,0:25:32.02,0:25:38.87,Default,,0,0,0,,Негізі мен әпкемнің дипломдық сапарында болсам да, маған үнемі хабарласпаңызшы.
Dialogue: 0,0:25:38.87,0:25:40.01,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:25:40.67,0:25:41.96,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:25:41.96,0:25:44.26,Default,,0,0,0,,Риа да барғысы келді.
Dialogue: 0,0:25:44.26,0:25:45.27,Default,,0,0,0,,Әпке!
Dialogue: 0,0:25:45.27,0:25:46.74,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:25:48.35,0:25:53.94,Default,,0,0,0,,Ал, бастайық, қарап жібере аласыз ба? біздің қазіргі өнімділігіміз.
Dialogue: 0,0:25:53.94,0:25:54.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:26:06.51,0:26:07.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:26:08.73,0:26:09.83,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:26:09.83,0:26:14.55,Default,,0,0,0,,Мен мұны анық айтамын. Менің ойымша, олар бізді шақырды.
Dialogue: 0,0:26:16.30,0:26:17.89,Default,,0,0,0,,Иә,
Dialogue: 0,0:26:17.89,0:26:21.43,Default,,0,0,0,,Лав Лайв! Жеңіс кезіндегі көрсеткіш 100 болса,
Dialogue: 0,0:26:22.59,0:26:28.02,Default,,0,0,0,,Менің ойымша, сіз қазір шамамен 30, тіпті 20 деп айта аласыз.
Dialogue: 0,0:26:28.02,0:26:29.64,Default,,0,0,0,,Сонымен...?
Dialogue: 0,0:26:29.64,0:26:32.23,Default,,0,0,0,,Жартысы, жартысы?
Dialogue: 0,0:26:32.23,0:26:37.23,Default,,0,0,0,,Үшінші курстың үш студентінің қатысуы қаншалықты маңызды болды.
Dialogue: 0,0:26:37.23,0:26:39.66,Default,,0,0,0,,Канан Мацуураның ырғақ пен би сезімі,
Dialogue: 0,0:26:39.66,0:26:42.20,Default,,0,0,0,,Мари Охараның әншілік қабілеті,
Dialogue: 0,0:26:42.20,0:26:44.87,Default,,0,0,0,,Диа Куросаваның сәні мен болуы,
Dialogue: 0,0:26:44.87,0:26:49.89,Default,,0,0,0,,Бұл Акурстың жарықтығы мен энергиясы болды.
Dialogue: 0,0:26:51.04,0:26:55.17,Default,,0,0,0,,Енді бұл жоғалғандықтан, мен алаңдаушылық пен абдырап қалдым.
Dialogue: 0,0:26:55.17,0:26:58.83,Default,,0,0,0,,Бір нәрсе үлпілдек және анықталмаған сияқты.
Dialogue: 0,0:27:01.03,0:27:03.75,Default,,0,0,0,,Сіз оны тамаша тапқан сияқтысыз...
Dialogue: 0,0:27:04.75,0:27:07.47,Default,,0,0,0,,Бірақ қалай...
Dialogue: 0,0:27:09.68,0:27:13.40,Default,,0,0,0,,Міне! Адамдардан сұрау арқылы білуге ​​мүмкіндік жоқ!
Dialogue: 0,0:27:13.40,0:27:16.06,Default,,0,0,0,,Мұның бәрін өзіңіз жасауыңыз керек!
Dialogue: 0,0:27:16.90,0:27:17.77,Default,,0,0,0,,Риа-чан...
Dialogue: 0,0:27:18.24,0:27:21.51,Default,,0,0,0,,Әпкелер кетті!
Dialogue: 0,0:27:25.67,0:27:26.91,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:27:27.65,0:27:31.17,Default,,0,0,0,,Риа-чан, сіз жаңа мектеп кумирін бастадыңыз ба?
Dialogue: 0,0:27:31.75,0:27:34.87,Default,,0,0,0,,Осылай деген ниет бар сияқты, бірақ қиын.
Dialogue: 0,0:27:36.50,0:27:42.97,Default,,0,0,0,,Біраз адам жиналып жаңа бір істі бірге бастаған сияқты, бірақ жақсы болмай тұрған сияқты...
Dialogue: 0,0:27:42.97,0:27:45.08,Default,,0,0,0,,Бұл оның тұлғасы.
Dialogue: 0,0:27:45.08,0:27:46.85,Default,,0,0,0,,Басқа адамдар туралы бірдеңе айта аласыз ба?
Dialogue: 0,0:27:46.85,0:27:47.87,Default,,0,0,0,,Шулы!
Dialogue: 0,0:28:06.58,0:28:07.92,Default,,0,0,0,,Сондықтан мен оны дәлелдеймін.
Dialogue: 0,0:28:09.97,0:28:13.29,Default,,0,0,0,,Риа-чан жалғыз өзі көп жұмыс істейді.
Dialogue: 0,0:28:14.52,0:28:17.21,Default,,0,0,0,,Лав Лайв! Бұл ойын емес.
Dialogue: 0,0:28:33.52,0:28:35.40,Default,,0,0,0,,Не?
Dialogue: 0,0:28:41.45,0:28:44.41,Default,,0,0,0,,Мен мұны бұрын көргеніме сенімдімін...
Dialogue: 0,0:28:53.76,0:28:56.83,Default,,0,0,0,,Ана, ана, ана,
Dialogue: 0,0:28:56.83,0:28:58.42,Default,,0,0,0,,Бұл Мари-чан!
Dialogue: 0,0:28:59.35,0:29:00.40,Default,,0,0,0,,Зура!
Dialogue: 0,0:29:01.19,0:29:03.97,Default,,0,0,0,,Мари-чан, неге болмайды?
Dialogue: 0,0:29:03.97,0:29:08.30,Default,,0,0,0,,Менің қызым үнемі қамқорлық жасайды!
Dialogue: 0,0:29:08.30,0:29:10.49,Default,,0,0,0,,Мари Охараның анасы,
Dialogue: 0,0:29:11.30,0:29:14.10,Default,,0,0,0,,Маридің анасы!
Dialogue: 0,0:29:14.73,0:29:15.48,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:29:18.19,0:29:20.32,Default,,0,0,0,,Мен сізбен байланыса алмаймын! ?
Dialogue: 0,0:29:33.48,0:29:37.00,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:29:37.00,0:29:42.77,Default,,0,0,0,,Бұған дейін мен Мариден сіз туралы көп естідім.
Dialogue: 0,0:29:42.77,0:29:47.01,Default,,0,0,0,,Мектеп үшін көп рахмет.
Dialogue: 0,0:29:47.37,0:29:48.83,Default,,0,0,0,,Руби-чан да?
Dialogue: 0,0:29:48.83,0:29:53.98,Default,,0,0,0,,Руби көптен күткен бітіру сапарында болды, сондықтан мен онымен байланыспауға тырыстым.
Dialogue: 0,0:29:54.34,0:30:01.53,Default,,0,0,0,,Ум, Хагуу, Десвар және үшеуміз! Мен барлық байланысымды жоғалттым.
Dialogue: 0,0:30:01.53,0:30:04.18,Default,,0,0,0,,Хагуу мен Десвар...
Dialogue: 0,0:30:04.18,0:30:07.03,Default,,0,0,0,,Сөзсіз Канан-чан және Диа-чан.
Dialogue: 0,0:30:07.03,0:30:15.38,Default,,0,0,0,,Балалар, Мари мен басқаларды таба алатындарыңа сенімдімін.
Dialogue: 0,0:30:17.04,0:30:17.46,Default,,0,0,0,,,
Dialogue: 0,0:30:18.16,0:30:18.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:22.55,0:30:23.80,Default,,0,0,0,,Алайда, біз оның қозғалысын тоқтата аламыз.
Dialogue: 0,0:30:30.97,0:30:31.88,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:30:31.88,0:30:34.27,Default,,0,0,0,,3 адам тапсаң мына ақшаны маған бер! ?
Dialogue: 0,0:30:37.83,0:30:39.40,Default,,0,0,0,,Бұл шоколад.
Dialogue: 0,0:30:39.40,0:30:44.04,Default,,0,0,0,,Иә. Бұл жол ақысын төлейтінімізді білдіретін спектакль.
Dialogue: 0,0:30:44.04,0:30:45.57,Default,,0,0,0,,, солай ма?
Dialogue: 0,0:30:45.57,0:30:51.03,Default,,0,0,0,,Алайда, егер шынымен тапсаңыз, мен сізге тиісінше ризамын.
Dialogue: 0,0:30:51.03,0:30:52.41,Default,,0,0,0,,Қалай болғанда да.
Dialogue: 0,0:30:53.32,0:30:54.54,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:30:54.54,0:31:01.68,Default,,0,0,0,,Құлаған періште Джонның көзіне түссең, үшеуін табу оңай болады!
Dialogue: 0,0:31:01.68,0:31:04.42,Default,,0,0,0,,Сізді ақша соқыр етеді ме?
Dialogue: 0,0:31:04.42,0:31:08.04,Default,,0,0,0,,Сіз не туралы айтып тұрсыз? Ақша келесі тікелей шоуға жұмсалады!
Dialogue: 0,0:31:08.04,0:31:12.61,Default,,0,0,0,,Тікелей эфир! Дұрыс, Руби және басқалары тікелей эфирде!
Dialogue: 0,0:31:12.61,0:31:16.31,Default,,0,0,0,,Бірақ ол жоқ, солай ма? Уайым уайымдау болуы мүмкін.
Dialogue: 0,0:31:16.90,0:31:17.69,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:31:23.55,0:31:25.61,Default,,0,0,0,,Менің ойымша, сіз баруыңыз керек.
Dialogue: 0,0:31:28.83,0:31:32.41,Default,,0,0,0,,Мен бұрын әркімнің жаттығуын көргенде солай ойладым.
Dialogue: 0,0:31:32.90,0:31:38.29,Default,,0,0,0,,Не себеп болса да, бір рет бітіретін үш адаммен сөйлескенім дұрыс деп ойладым.
Dialogue: 0,0:31:38.77,0:31:40.09,Default,,0,0,0,,Кешігіп қалғаным үшін кешірім сұраймын.
Dialogue: 0,0:31:40.09,0:31:48.58,Default,,0,0,0,,Жаңа қадам жасау үшін осы уақытқа дейін болған оқиғаларды дұрыстап қарау жаман емес деп ойлаймын.
Dialogue: 0,0:31:57.92,0:31:58.84,Default,,0,0,0,,Чика-чан.
Dialogue: 0,0:32:00.39,0:32:02.83,Default,,0,0,0,,Менің ойымша, Сейра-сан дұрыс айтады.
Dialogue: 0,0:32:02.83,0:32:05.19,Default,,0,0,0,,Сіз кез келген жерде тікелей эфирде жаттығуға болады.
Dialogue: 0,0:32:05.19,0:32:07.35,Default,,0,0,0,,Біз осы уақытқа дейін жеттік!
Dialogue: 0,0:32:07.96,0:32:10.46,Default,,0,0,0,,Жарайды, қолыңнан келеді!
Dialogue: 0,0:32:14.94,0:32:17.36,Default,,0,0,0,,Түсіндім! Барайық!
Dialogue: 0,0:32:17.36,0:32:22.69,Default,,0,0,0,,О! Өте көп рахмет!
Dialogue: 0,0:32:23.58,0:32:28.42,Default,,0,0,0,,Сонымен, Мари мен үшеуіңіз дипломдық сапарға қайда бардыңыздар?
Dialogue: 0,0:32:28.42,0:32:32.01,Default,,0,0,0,,Солтүстік полигон? Оңтүстіктің зерттелмеген аймағы?
Dialogue: 0,0:32:32.01,0:32:33.34,Default,,0,0,0,,Яғни
Dialogue: 0,0:32:33.34,0:32:34.30,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:32:34.30,0:32:40.56,Default,,0,0,0,,Біз үшеуміз Охара тұқымдас ата-бабаларымыз өмір сүрген елге саяхат жасаймыз.
Dialogue: 0,0:32:40.56,0:32:42.17,Default,,0,0,0,,Бұл...
Dialogue: 0,0:32:42.17,0:32:43.69,Default,,0,0,0,,Сіздер батыл сарбаздарсыздар
Dialogue: 0,0:32:45.86,0:32:49.77,Default,,0,0,0,,Міне!
Dialogue: 0,0:32:52.56,0:32:55.66,Default,,0,0,0,,Йохан, аааа!
Dialogue: 0,0:33:09.95,0:33:14.34,Default,,0,0,0,,Джон... өз жерінде...
Dialogue: 0,0:33:14.34,0:33:15.59,Default,,0,0,0,,Құлаған аспан!
Dialogue: 0,0:33:20.18,0:33:21.23,Default,,0,0,0,,келді!
Dialogue: 0,0:33:21.23,0:33:23.74,Default,,0,0,0,,Пісте буоно Зура~!
Dialogue: 0,0:33:23.74,0:33:24.44,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:33:24.44,0:33:26.24,Default,,0,0,0,,Шоколад та бар.
Dialogue: 0,0:33:26.24,0:33:27.90,Default,,0,0,0,,Йошико да тамақ іше ме?
Dialogue: 0,0:33:27.90,0:33:29.01,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:33:29.01,0:33:33.53,Default,,0,0,0,,Жоқ, бірақ бұрын осы үлгімен қорқынышты тәжірибе болғаным есімде...
Dialogue: 0,0:33:34.17,0:33:35.51,Default,,0,0,0,,Бірақ тамақтаныңыз!
Dialogue: 0,0:33:36.94,0:33:38.53,Default,,0,0,0,,Сонымен байланыс дегеніміз не?
Dialogue: 0,0:33:39.01,0:33:41.04,Default,,0,0,0,,Әпкемнен ештеңе...
Dialogue: 0,0:33:41.04,0:33:43.93,Default,,0,0,0,,Канан-чан мен Мари-чан әлі жоқ.
Dialogue: 0,0:33:43.93,0:33:48.06,Default,,0,0,0,,Мен сізге осында келемін деп алғаш жібергенде алғаным осы ғана.
Dialogue: 0,0:33:49.77,0:33:53.09,Default,,0,0,0,,Мына фотодағы жерге барудан басқа амалым жоқ.
Dialogue: 0,0:33:53.09,0:33:54.72,Default,,0,0,0,,Дәл осында!
Dialogue: 0,0:33:54.72,0:33:56.20,Default,,0,0,0,,Иә? Түсінесіз бе?
Dialogue: 0,0:33:56.20,0:34:01.06,Default,,0,0,0,,Иә. Цуки-чан, мен кішкентай кезімде Италияда тұрдым, сондықтан мен бұл туралы көп білемін!
Dialogue: 0,0:34:01.06,0:34:05.54,Default,,0,0,0,,Бұл бағыттаушы рөл. Түсінбеген жеріңіз болса, менен сұраңыз.
Dialogue: 0,0:34:05.54,0:34:08.05,Default,,0,0,0,,Кәне, жалғыз барайық
Dialogue: 0,0:34:08.05,0:34:11.43,Default,,0,0,0,,Сәлем! Бұл менің желісім!
Dialogue: 0,0:34:14.00,0:34:17.54,Default,,0,0,0,,Бұл таңқаларлық. Барған жеріңде өзендер бар.
Dialogue: 0,0:34:17.54,0:34:23.01,Default,,0,0,0,,Қала каналдармен көмкерілген. Екінші жағынан, көліктер өте алмайды.
Dialogue: 0,0:34:23.01,0:34:25.12,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:34:25.12,0:34:28.71,Default,,0,0,0,,Мен өзімді адасып бара жатқандай сезінемін.
Dialogue: 0,0:34:45.96,0:34:47.31,Default,,0,0,0,,Міне!
Dialogue: 0,0:34:49.73,0:34:51.75,Default,,0,0,0,,Ханамаручаааааааан...
Dialogue: 0,0:34:51.75,0:34:53.40,Default,,0,0,0,,О, жарайды, жарайды.
Dialogue: 0,0:34:53.40,0:34:54.44,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:34:57.35,0:34:59.24,Default,,0,0,0,,Бұл міндетті түрде осында.
Dialogue: 0,0:35:12.40,0:35:14.15,Default,,0,0,0,,Телефон шырылдауда.
Dialogue: 0,0:35:23.64,0:35:24.82,Default,,0,0,0,,Мун-чан?
Dialogue: 0,0:35:27.14,0:35:28.35,Default,,0,0,0,,Боволо...
Dialogue: 0,0:35:28.35,0:35:28.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:29.98,0:35:32.50,Default,,0,0,0,,Тіпті Контарини дель Боволо!
Dialogue: 0,0:35:35.40,0:35:37.99,Default,,0,0,0,,Ендеше, қалай қарасаң да күдікті емес!
Dialogue: 0,0:35:39.20,0:35:41.81,Default,,0,0,0,,Мүмкін мен сенатқа барармын...
Dialogue: 0,0:35:41.81,0:35:43.72,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:35:45.06,0:35:46.08,Default,,0,0,0,,Мелло
Dialogue: 0,0:35:46.08,0:35:47.33,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:35:51.67,0:35:53.64,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:35:56.67,0:35:58.03,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:35:58.03,0:36:00.59,Default,,0,0,0,,Бұл ортағасырға өткен уақытқа саяхат жасағандай!
Dialogue: 0,0:36:00.59,0:36:03.26,Default,,0,0,0,,Сіз осы ғимараттың үстінде болуыңыз керек...
Dialogue: 0,0:36:04.66,0:36:06.26,Default,,0,0,0,,Ах! Әпке!
Dialogue: 0,0:36:06.26,0:36:07.35,Default,,0,0,0,,Мари-чан!
Dialogue: 0,0:36:07.35,0:36:08.45,Default,,0,0,0,,Канан-чан!
Dialogue: 0,0:36:11.54,0:36:12.58,Default,,0,0,0,,Жақсы
Dialogue: 0,0:36:24.29,0:36:25.36,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:36:32.05,0:36:35.86,Default,,0,0,0,,Үлкен әпке! !
Dialogue: 0,0:36:35.86,0:36:39.26,Default,,0,0,0,,Міне, осы уақытқа дейін келдіңіз. Бұл алыс.
Dialogue: 0,0:36:39.26,0:36:41.22,Default,,0,0,0,,Өйткені, өйткені...
Dialogue: 0,0:36:41.22,0:36:44.37,Default,,0,0,0,,Жақсы, үшеуміз бірге болдық.
Dialogue: 0,0:36:44.37,0:36:47.58,Default,,0,0,0,,Әрине! Біз мәңгі бірге боламыз.
Dialogue: 0,0:36:47.58,0:36:49.65,Default,,0,0,0,,Сен неге жоқсың?
Dialogue: 0,0:36:50.49,0:36:53.02,Default,,0,0,0,,Жоқ, белгісіз?
Dialogue: 0,0:36:53.81,0:36:57.82,Default,,0,0,0,,Өйткені, солай болады!
Dialogue: 0,0:36:57.82,0:37:01.32,Default,,0,0,0,,Маридің анасы Чикаға және басқаларға не деді?
Dialogue: 0,0:37:01.32,0:37:02.53,Default,,0,0,0,,Атап айтқанда
Dialogue: 0,0:37:02.53,0:37:06.75,Default,,0,0,0,,Тек ол жоқ, мен уайымдап тұрмын.
Dialogue: 0,0:37:06.75,0:37:08.78,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:37:08.78,0:37:13.87,Default,,0,0,0,,Танысқаныма қуаныштымын! Менің атым Цуки Ватанабе! Мен Йо Чанның немере ағасымын!
Dialogue: 0,0:37:13.87,0:37:16.08,Default,,0,0,0,,Еуропа!
Dialogue: 0,0:37:16.08,0:37:17.90,Default,,0,0,0,,О! Өте әдемі!
Dialogue: 0,0:37:17.90,0:37:18.84,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:37:18.84,0:37:20.92,Default,,0,0,0,,...Сен Чанның немере ағасы.
Dialogue: 0,0:37:23.06,0:37:24.67,Default,,0,0,0,,Бұл баспалдақ...
Dialogue: 0,0:37:24.67,0:37:27.87,Default,,0,0,0,,...Зураның басы айналады~
Dialogue: 0,0:37:27.87,0:37:28.95,Default,,0,0,0,,Ханамару-чан!
Dialogue: 0,0:37:28.95,0:37:29.81,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:37:29.81,0:37:33.30,Default,,0,0,0,,Бірақ Чика мен басқалары ештеңе білмеді...
Dialogue: 0,0:37:33.30,0:37:35.94,Default,,0,0,0,,Осылайша ол даши үшін қолданылды.
Dialogue: 0,0:37:35.94,0:37:37.03,Default,,0,0,0,,Даши?
Dialogue: 0,0:37:37.03,0:37:42.12,Default,,0,0,0,,Егер Чика-ччи және басқалардың келе жатқанын білсек, міндетті түрде олармен байланысамыз.
Dialogue: 0,0:37:42.12,0:37:44.07,Default,,0,0,0,,Осылайша ол оны азғырды,
Dialogue: 0,0:37:45.16,0:37:48.49,Default,,0,0,0,,Мен оны ұстауға бел байладым!
Dialogue: 0,0:37:48.49,0:37:49.79,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:37:49.79,0:37:52.79,Default,,0,0,0,,Сонда сіз жоғалып кеттім деп өтірік айттыңыз ба? ?
Dialogue: 0,0:38:00.12,0:38:03.01,Default,,0,0,0,,Бұл жерде ұзақ тұру мүмкін емес...
Dialogue: 0,0:38:03.01,0:38:04.30,Default,,0,0,0,,Кун-кун.
Dialogue: 0,0:38:04.30,0:38:05.01,Default,,0,0,0,,Иә...
Dialogue: 0,0:38:05.01,0:38:05.84,Default,,0,0,0,,Кун-кун.
Dialogue: 0,0:38:05.84,0:38:06.63,Default,,0,0,0,,О...
Dialogue: 0,0:38:06.63,0:38:09.47,Default,,0,0,0,,Иә, кешіріңіз!
Dialogue: 0,0:38:14.48,0:38:15.80,Default,,0,0,0,,Бірыңғай киім!
Dialogue: 0,0:38:15.80,0:38:17.14,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:38:17.14,0:38:18.65,Default,,0,0,0,,Дамезура~.
Dialogue: 0,0:38:22.81,0:38:23.93,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:38:23.93,0:38:26.55,Default,,0,0,0,,Ю-Чанның немере ағасы...
Dialogue: 0,0:38:26.55,0:38:27.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:27.54,0:38:28.80,Default,,0,0,0,,Сәлем! Кешіріңіз Ruby!
Dialogue: 0,0:38:28.80,0:38:29.84,Default,,0,0,0,,Руби, кешіріңіз!
Dialogue: 0,0:38:29.84,0:38:33.12,Default,,0,0,0,,Егжей-тегжейлі әңгіме ештеңе емес!
Dialogue: 0,0:38:33.12,0:38:37.67,Default,,0,0,0,,Мари мен басқалары анасынан қашып жүрген болуы мүмкін бе?
Dialogue: 0,0:38:37.67,0:38:39.57,Default,,0,0,0,,Үлкен әпке...
Dialogue: 0,0:38:39.57,0:38:40.88,Default,,0,0,0,,Оны бірден қуып жіберейік!
Dialogue: 0,0:38:40.88,0:38:44.32,Default,,0,0,0,,Бұл мүмкін емес. Қайда кеткенімді де білмеймін...
Dialogue: 0,0:38:44.32,0:38:45.43,Default,,0,0,0,,Кешігіп қалғаным үшін кешірім сұраймын.
Dialogue: 0,0:38:46.72,0:38:48.24,Default,,0,0,0,,Бұл...
Dialogue: 0,0:38:48.24,0:38:54.28,Default,,0,0,0,,Джон өзі қорғайтын жерге қарап тұрғанда, ертегі нұсқауы оған қайда бару керектігін көрсетеді.
Dialogue: 0,0:38:55.19,0:38:56.06,Default,,0,0,0,,Джон?
Dialogue: 0,0:38:56.06,0:39:00.52,Default,,0,0,0,,Жоқ. Менің ойымша, бұл Жақия әулие болған жер.
Dialogue: 0,0:39:00.52,0:39:03.21,Default,,0,0,0,,О, сондай жер бар!
Dialogue: 0,0:39:04.28,0:39:08.62,Default,,0,0,0,,Иә. Патрон әулие Джованни, Джон жері!
Dialogue: 0,0:39:08.62,0:39:10.07,Default,,0,0,0,,Онда кездесейік!
Dialogue: 0,0:39:10.58,0:39:12.94,Default,,0,0,0,,Сіз шынымен осылай қашуды жоспарлап отырсыз ба?
Dialogue: 0,0:39:12.94,0:39:13.96,Default,,0,0,0,,Сізге ұнамай ма?
Dialogue: 0,0:39:14.63,0:39:16.62,Default,,0,0,0,,Мен оны ұнатпаймын деп тұрған жоқпын!
Dialogue: 0,0:39:16.62,0:39:18.39,Default,,0,0,0,,Маған ұнайды.
Dialogue: 0,0:39:18.39,0:39:21.47,Default,,0,0,0,,Кішкентай кезімде Мариді өзіммен ойнауға алып шыққандағыдай.
Dialogue: 0,0:39:21.47,0:39:25.90,Default,,0,0,0,,Сіз енді жас ханым емессіз, Мари-сан.
Dialogue: 0,0:39:25.90,0:39:27.73,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:39:28.45,0:39:29.93,Default,,0,0,0,,Сондай-ақ,
Dialogue: 0,0:39:29.93,0:39:31.16,Default,,0,0,0,,Жаман емес!
Dialogue: 0,0:39:34.99,0:39:37.38,Default,,0,0,0,,Біз сонда барамыз ба? (О, жоқ!)
Dialogue: 0,0:39:37.38,0:39:39.79,Default,,0,0,0,,Осы жолмен жүреміз бе? (О, жоқ!)
Dialogue: 0,0:39:39.79,0:39:44.49,Default,,0,0,0,,Қай жолмен жүруім керек? Білмеймін, жоқ, жоқ!
Dialogue: 0,0:39:44.49,0:39:49.38,Default,,0,0,0,,Жүр! Мен мәңгілік еркін өмір сүргім келеді
Dialogue: 0,0:39:49.38,0:39:52.63,Default,,0,0,0,,Иә, байқадым
Dialogue: 0,0:39:52.63,0:39:58.93,Default,,0,0,0,,Тезірек қашамыз ба? Иә, қаш!
Dialogue: 0,0:39:58.93,0:40:03.47,Default,,0,0,0,,Маған кедергі жасама, сау бол
Dialogue: 0,0:40:03.47,0:40:08.51,Default,,0,0,0,,Мен бұл туралы жүгіріп келе жатып ойладым.
Dialogue: 0,0:40:08.51,0:40:13.03,Default,,0,0,0,,Тер төгіп, шыдамсыздықпен Ах! Қазірдің өзінде ыстық
Dialogue: 0,0:40:13.03,0:40:18.11,Default,,0,0,0,,Қатты айтсам, табылып қала ма деп қорқамын
Dialogue: 0,0:40:18.11,0:40:22.04,Default,,0,0,0,,Мен саған өз сөзіммен айтамын
Dialogue: 0,0:40:22.04,0:40:25.29,Default,,0,0,0,,Өрмелеу, түсу, көтерілу
Dialogue: 0,0:40:25.29,0:40:26.86,Default,,0,0,0,,Төменге көтеріл, жоғары көтеріл!
Dialogue: 0,0:40:26.86,0:40:27.66,Default,,0,0,0,,Айқас, бұрылу, айқасу (лабиринт сияқты)
Dialogue: 0,0:40:27.66,0:40:30.15,Default,,0,0,0,,Айқас, бұрылыс, айқас
Dialogue: 0,0:40:30.15,0:40:32.51,Default,,0,0,0,,Айқас, бұрылыс, айқас
Dialogue: 0,0:40:32.51,0:40:36.61,Default,,0,0,0,,Мен қатты жүгіргендіктен ауырса да
Dialogue: 0,0:40:36.61,0:40:44.34,Default,,0,0,0,,Неге екені белгісіз, бәрі күле бастайды, тоқтай алмайды.
Dialogue: 0,0:40:44.86,0:40:48.94,Default,,0,0,0,,Сондықтан оны қуған болуы керек.
Dialogue: 0,0:40:48.94,0:40:51.47,Default,,0,0,0,,Мүмкін ол мені қуып келе жатқан шығар
Dialogue: 0,0:40:51.47,0:40:56.19,Default,,0,0,0,,Шеңберді дөңгелек және дөңгелек сызыңыз
Dialogue: 0,0:40:56.19,0:41:01.07,Default,,0,0,0,,Мен ұсталғым келмейді, бірақ ұсталғым келеді.
Dialogue: 0,0:41:01.07,0:41:09.77,Default,,0,0,0,,Бұл Runaway мәңгі қызықты болып барады!?
Dialogue: 0,0:41:10.99,0:41:15.75,Default,,0,0,0,,Мен еркін өмір сүргім келеді
Dialogue: 0,0:41:15.75,0:41:19.00,Default,,0,0,0,,Иә, байқадым
Dialogue: 0,0:41:19.00,0:41:25.30,Default,,0,0,0,,Тез қашамыз ба? Тек қашып кет!
Dialogue: 0,0:41:25.30,0:41:29.86,Default,,0,0,0,,Маған кедергі жасама, сау бол
Dialogue: 0,0:41:32.84,0:41:35.18,Default,,0,0,0,,Келу ~
Dialogue: 0,0:41:37.42,0:41:42.21,Default,,0,0,0,,Бұл керемет жер. Бұл да Охара отбасының вилласы ма?
Dialogue: 0,0:41:42.21,0:41:43.93,Default,,0,0,0,,Біздің бай болуымыздың себебі осы.
Dialogue: 0,0:41:43.93,0:41:45.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:41:45.04,0:41:50.94,Default,,0,0,0,,Мен соны айтқым келеді, бірақ шын мәнінде мұндағы бір танысым маған аздап қарызға берді.
Dialogue: 0,0:41:50.94,0:41:56.97,Default,,0,0,0,,Мүмкін қазірге дейін жақын жердегі Охара отбасының вилласында болуы мүмкін.\NМенің ойымша, бұл
Dialogue: 0,0:42:00.49,0:42:03.24,Default,,0,0,0,,.
Dialogue: 0,0:42:03.24,0:42:05.91,Default,,0,0,0,,Аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:42:05.91,0:42:11.42,Default,,0,0,0,,Сонымен, сіз Чикамен және басқалармен әдейі кездесіп, тұқым тарамас бұрын қайда екеніңізді айттыңыз.
Dialogue: 0,0:42:11.42,0:42:15.56,Default,,0,0,0,,Иә! Сонда қарсы тарап оны қашып кетті деп қателесіп,
Dialogue: 0,0:42:15.56,0:42:18.97,Default,,0,0,0,,Охара отбасының басқа қаладағы вилласын іздеуді бастаңыз.
Dialogue: 0,0:42:19.80,0:42:21.51,Default,,0,0,0,,Уақытты сатып алуға болады.
Dialogue: 0,0:42:22.37,0:42:24.45,Default,,0,0,0,,Чика-сан және басқалары не істейді?
Dialogue: 0,0:42:25.16,0:42:30.46,Default,,0,0,0,,Мүмкін хабарды дұрыс түсінсеңіз, байқайсыз.
Dialogue: 0,0:42:30.46,0:42:35.53,Default,,0,0,0,,Бірақ ол тек Маридің анасы айтқандықтан ғана келеді деп ойламаймын.
Dialogue: 0,0:42:36.64,0:42:42.83,Default,,0,0,0,,Мен саған бізді оңаша қалдырып, жаңа акурларды бастауды айттым...
Dialogue: 0,0:42:47.97,0:42:50.83,Default,,0,0,0,,Маған айтқандықтан емес шығар.
Dialogue: 0,0:42:53.61,0:42:54.80,Default,,0,0,0,,Мүмкін,
Dialogue: 0,0:42:54.80,0:42:57.90,Default,,0,0,0,,Менің ойымша, сіз бір нәрсе туралы сөйлескіңіз келеді.
Dialogue: 0,0:43:02.43,0:43:04.92,Default,,0,0,0,,Флоренцияға келу ~ Джон... Джон... Джон... Джон... көкек
Dialogue: 0,0:43:04.92,0:43:05.80,Default,,0,0,0,,Не істеу керек? Джон... Джон... Джон... Джон... Кукккккккккккккккккк
Dialogue: 0,0:43:05.80,0:43:05.81,Default,,0,0,0,,Мен бәрібір бірдеңе жеймін. Не істеуім керек? Джон... Джон... Джон... Джон... Кукккккккккккккккккк
Dialogue: 0,0:43:05.81,0:43:08.43,Default,,0,0,0,,Джон...Джон...Джон...Джон...Куккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккк ккккк                                     бәрібір бірдеңе жеу үшін.
Dialogue: 0,0:43:08.43,0:43:08.44,Default,,0,0,0,,Мен бәрібір бірдеңе жеуім керек.
Dialogue: 0,0:43:08.44,0:43:10.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:43:19.69,0:43:22.14,Default,,0,0,0,,Молто Буоно Зура~!
Dialogue: 0,0:43:22.14,0:43:23.16,Default,,0,0,0,,Кездесу аяқталғаннан кейін де, үйге келген соң қылмыскерлерді үкім шығарумен қайта айналысамын.
Dialogue: 0,0:43:23.16,0:43:25.00,Default,,0,0,0,,Бұл өте дәмді.
Dialogue: 0,0:43:25.00,0:43:26.14,Default,,0,0,0,,Хабарды көргеннен кейін осында келдім, бірақ мен оның шынымен дәмді екенін айта аламын.
Dialogue: 0,0:43:26.14,0:43:28.89,Default,,0,0,0,,Хабарды көрген соң осы уақытқа дейін келдім, бірақ
Dialogue: 0,0:43:28.89,0:43:31.04,Default,,0,0,0,,Мари мен басқалары қайда екен деп ойлаймын.
Dialogue: 0,0:43:31.04,0:43:34.65,Default,,0,0,0,,Қайта күтсеңіз, қарсы тарап сізге хабарласады...
Dialogue: 0,0:43:34.65,0:43:36.14,Default,,0,0,0,,Ол келер ме екен...?
Dialogue: 0,0:43:36.14,0:43:37.05,Default,,0,0,0,,Ұялы телефондар ше?
Dialogue: 0,0:43:37.05,0:43:44.35,Default,,0,0,0,,Ештеңе... Менің ойымша, Маридің анасы ұялы телефонынан не болып жатқанын көре алады.
Dialogue: 0,0:43:44.35,0:43:46.31,Default,,0,0,0,,көремін.
Dialogue: 0,0:43:49.60,0:43:51.52,Default,,0,0,0,,Сәлеметсіз бе, күткеніңізге рахмет!
Dialogue: 0,0:43:51.52,0:43:52.77,Default,,0,0,0,,Ой, бұл не!
Dialogue: 0,0:43:52.77,0:43:53.73,Default,,0,0,0,,Үлкен!
Dialogue: 0,0:43:53.73,0:43:58.20,Default,,0,0,0,,Бистека алла Фиорентина! Бұл жерде ерекшелік бар.
Dialogue: 0,0:43:58.90,0:44:01.18,Default,,0,0,0,,Итадакизира.
Dialogue: 0,0:44:01.18,0:44:02.41,Default,,0,0,0,,Йошико да
Dialogue: 0,0:44:03.09,0:44:03.66,Default,,0,0,0,,Бұл,
Dialogue: 0,0:44:04.32,0:44:05.64,Default,,0,0,0,,Йошико-чан?
Dialogue: 0,0:44:06.42,0:44:08.16,Default,,0,0,0,,Йошико-чан.
Dialogue: 0,0:44:08.90,0:44:12.32,Default,,0,0,0,,Йохане Чаан!
Dialogue: 0,0:44:12.32,0:44:13.33,Default,,0,0,0,,... жоғалып кетті ме?
Dialogue: 0,0:44:13.33,0:44:14.78,Default,,0,0,0,,Құлаған періште,
Dialogue: 0,0:44:14.78,0:44:17.52,Default,,0,0,0,,Осы жолы жоғалып кетсең не істейсің?
Dialogue: 0,0:44:17.52,0:44:18.81,Default,,0,0,0,,туындаған сияқты,
Dialogue: 0,0:44:18.81,0:44:20.54,Default,,0,0,0,,Егер бар болса...
Dialogue: 0,0:44:21.40,0:44:22.52,Default,,0,0,0,,Джон...
Dialogue: 0,0:44:22.52,0:44:23.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:23.34,0:44:25.97,Default,,0,0,0,,Йошико-чан «Йохане» деп күбірлей берді!
Dialogue: 0,0:44:28.60,0:44:30.52,Default,,0,0,0,,Әрқашан, әрқашан!
Dialogue: 0,0:44:38.02,0:44:41.36,Default,,0,0,0,,Үлкен!
Dialogue: 0,0:44:41.36,0:44:43.74,Default,,0,0,0,,Бұл не! таңқаларлық!
Dialogue: 0,0:44:43.74,0:44:44.86,Default,,0,0,0,,...
Dialogue: 0,0:44:44.86,0:44:46.30,Default,,0,0,0,,Думо?
Dialogue: 0,0:44:46.30,0:44:49.88,Default,,0,0,0,,Бұл қаладағы ең әйгілі ғимарат.
Dialogue: 0,0:44:49.88,0:44:54.29,Default,,0,0,0,,Қалада осындай үлкен нәрсенің болғаны таң қалдырады.
Dialogue: 0,0:44:55.28,0:44:58.53,Default,,0,0,0,,Міне, құлаған періште! ?
Dialogue: 0,0:44:58.53,0:44:59.71,Default,,0,0,0,,Онда жоқ...
Dialogue: 0,0:45:00.69,0:45:02.01,Default,,0,0,0,,Сіз іздеушісіз бе?
Dialogue: 0,0:45:03.20,0:45:05.21,Default,,0,0,0,,Иә! ? Иә, дұрыс.
Dialogue: 0,0:45:05.21,0:45:07.49,Default,,0,0,0,,Шамамен Руби және басқалармен бір жаста.
Dialogue: 0,0:45:07.49,0:45:09.53,Default,,0,0,0,,Олардың биіктігі шамамен бірдей,
Dialogue: 0,0:45:09.53,0:45:11.40,Default,,0,0,0,,Әрқашан шулы!
Dialogue: 0,0:45:11.40,0:45:14.98,Default,,0,0,0,,Өздерін құлаған періште деп атайтын бір топ қыздар.
Dialogue: 0,0:45:14.98,0:45:19.69,Default,,0,0,0,,Қарасам, бұл өте асыл адам.
Dialogue: 0,0:45:21.86,0:45:23.17,Default,,0,0,0,,Йошико-чан?
Dialogue: 0,0:45:23.17,0:45:24.94,Default,,0,0,0,,Не істеп жатырсың...Зура?
Dialogue: 0,0:45:25.72,0:45:28.41,Default,,0,0,0,,Йошико емес. Бұл Йохан!
Dialogue: 0,0:45:28.41,0:45:31.28,Default,,0,0,0,,Өйткені мен қатты уайымдадым.
Dialogue: 0,0:45:31.28,0:45:34.41,Default,,0,0,0,,...Сонымен, бұл қалай көрінеді? Сіз ұсталып қаласыз.
Dialogue: 0,0:45:34.41,0:45:37.50,Default,,0,0,0,,Тынышталыңыз. Кәдімгі Лилия.
Dialogue: 0,0:45:37.50,0:45:41.92,Default,,0,0,0,,Өте сабырлы! Сондықтан мен Лили жоқ дедім! ?
Dialogue: 0,0:45:41.92,0:45:45.80,Default,,0,0,0,,Мен енді құлаған Джон періште емеспін.
Dialogue: 0,0:45:45.80,0:45:52.81,Default,,0,0,0,,Дәл осы жерде мен өзімнің әулием Джоннан Джонның фамилиясын алдым!
Dialogue: 0,0:45:54.24,0:45:56.72,Default,,0,0,0,,Ақордада қыздардың неше түрі бар!
Dialogue: 0,0:45:57.57,0:45:59.42,Default,,0,0,0,,Мен уайымдап ақша жоғалттым.
Dialogue: 0,0:45:59.42,0:46:05.30,Default,,0,0,0,,Келіңдер, бәрің. Осы Джон періштенің басшылығымен төбенің еденіне ұмтылайық!
Dialogue: 0,0:46:06.57,0:46:07.94,Default,,0,0,0,,Төбенің едені?
Dialogue: 0,0:46:07.94,0:46:09.21,Default,,0,0,0,,Бұл күмбез.
Dialogue: 0,0:46:09.21,0:46:10.92,Default,,0,0,0,,Дуомо шатыры.
Dialogue: 0,0:46:10.92,0:46:14.54,Default,,0,0,0,,Бүгін ғана соңғы нұсқау қол жетімді болды.
Dialogue: 0,0:46:14.54,0:46:19.00,Default,,0,0,0,,Иә. Бір адамға 15 евро төлеңіз!
Dialogue: 0,0:46:19.00,0:46:20.33,Default,,0,0,0,,Ақша алыңыз! ?
Dialogue: 0,0:46:20.33,0:46:22.33,Default,,0,0,0,,Бұл жай ғана билет.
Dialogue: 0,0:46:22.33,0:46:24.74,Default,,0,0,0,,Ол мүлде періште емес...
Dialogue: 0,0:46:24.74,0:46:26.01,Default,,0,0,0,,Киран!
Dialogue: 0,0:46:30.01,0:46:33.01,Default,,0,0,0,,Барлық қызыл шатырлар! Апыр-ай!
Dialogue: 0,0:46:33.01,0:46:38.21,Default,,0,0,0,,Жапонияда оншалықты көп көрмейсің. Қаланың біртұтас көрінісі.
Dialogue: 0,0:46:38.21,0:46:42.02,Default,,0,0,0,,Иә. Жүздеген жылдар бойы солай болды.
Dialogue: 0,0:46:43.36,0:46:46.68,Default,,0,0,0,,Мұндағы баспалдақтар тым тік.
Dialogue: 0,0:46:46.68,0:46:50.45,Default,,0,0,0,,Бұл ескі ғимарат, сондықтан лифт жоқ.
Dialogue: 0,0:46:50.45,0:46:56.41,Default,,0,0,0,,Толған... Жоханның рухы бата мен Ізгі хабар атмосферасын сыбырлайды!
Dialogue: 0,0:46:56.41,0:46:58.44,Default,,0,0,0,,Иә? Бұл...
Dialogue: 0,0:46:58.44,0:47:00.18,Default,,0,0,0,,Ертегі жыпылықтайды! ?
Dialogue: 0,0:47:00.18,0:47:01.16,Default,,0,0,0,,Не?
Dialogue: 0,0:47:01.16,0:47:03.37,Default,,0,0,0,,Ол белгі беріп тұрған сияқты...
Dialogue: 0,0:47:03.37,0:47:06.67,Default,,0,0,0,,Ойланып көр, ертегі жолбасшы!
Dialogue: 0,0:47:09.90,0:47:11.18,Default,,0,0,0,,Бұл жарық!
Dialogue: 0,0:47:12.41,0:47:13.61,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:47:17.36,0:47:18.76,Default,,0,0,0,,Сіз шынымен де осындасыз ба?
Dialogue: 0,0:47:20.25,0:47:21.38,Default,,0,0,0,,Иә...
Dialogue: 0,0:47:21.38,0:47:24.82,Default,,0,0,0,,Қайырлы кеш! !
Dialogue: 0,0:47:26.61,0:47:29.22,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:47:29.22,0:47:30.82,Default,,0,0,0,,Қош келдің.
Dialogue: 0,0:47:35.08,0:47:37.20,Default,,0,0,0,,Осы жолы кие алмадың ба?
Dialogue: 0,0:47:37.20,0:47:41.67,Default,,0,0,0,,Жарайды. Мен бірнеше рет жолды өзгерту арқылы осы уақытқа дейін көтерілдім.
Dialogue: 0,0:47:41.67,0:47:43.36,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:47:45.65,0:47:49.88,Default,,0,0,0,,Сонда да мен сенің осы уақытқа дейін жеткеніңе сене алар емеспін...
Dialogue: 0,0:47:49.88,0:47:52.05,Default,,0,0,0,,Сіз анадан бірдеңе естідіңіз бе?
Dialogue: 0,0:47:52.05,0:47:54.05,Default,,0,0,0,,Иә, әсіресе.
Dialogue: 0,0:47:54.05,0:47:56.84,Default,,0,0,0,,Нақты не болды? ана.
Dialogue: 0,0:47:56.84,0:47:58.93,Default,,0,0,0,,Иә, сәл...
Dialogue: 0,0:47:58.93,0:48:03.16,Default,,0,0,0,,Біз осы уақытқа дейін жеттік. Айтшы, Мари-чан.
Dialogue: 0,0:48:04.30,0:48:09.07,Default,,0,0,0,,Мен Чика мен басқаларды аяймын. Мен оны осылай жасырамын.
Dialogue: 0,0:48:11.54,0:48:12.72,Default,,0,0,0,,Кешігіп қалғаным үшін кешірім сұраймын.
Dialogue: 0,0:48:12.72,0:48:14.17,Default,,0,0,0,,Шындығында,
Dialogue: 0,0:48:14.17,0:48:15.84,Default,,0,0,0,,Мари үйленеді!
Dialogue: 0,0:48:20.04,0:48:21.80,Default,,0,0,0,,Сіз біреумен ұрысып жатырсыз ба?
Dialogue: 0,0:48:21.80,0:48:23.16,Default,,0,0,0,,Сол дуэль.
Dialogue: 0,0:48:23.16,0:48:24.06,Default,,0,0,0,,Сізге сұлулық ұнайды ма?
Dialogue: 0,0:48:24.06,0:48:25.64,Default,,0,0,0,,Мен таза адаммын.
Dialogue: 0,0:48:25.64,0:48:27.00,Default,,0,0,0,,Қызықты оқиға?
Dialogue: 0,0:48:27.00,0:48:28.08,Default,,0,0,0,,Шедевр.
Dialogue: 0,0:48:28.08,0:48:30.16,Default,,0,0,0,,Марудың соңы қызық.
Dialogue: 0,0:48:30.16,0:48:31.89,Default,,0,0,0,,Бұл соңы.
Dialogue: 0,0:48:32.88,0:48:34.13,Default,,0,0,0,,Бұл кедергі ме?
Dialogue: 0,0:48:34.13,0:48:35.80,Default,,0,0,0,,Сондықтан үйленеміз!
Dialogue: 0,0:48:37.06,0:48:40.06,Default,,0,0,0,,Иә, иә! ?
Dialogue: 0,0:48:40.06,0:48:41.52,Default,,0,0,0,,Тұрмысқа шық! ?
Dialogue: 0,0:48:41.52,0:48:42.52,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:48:42.52,0:48:44.74,Default,,0,0,0,,Кім және кім және кім және кім! ?
Dialogue: 0,0:48:44.74,0:48:46.98,Default,,0,0,0,,Күте тұрыңыз! Мен болмаймын.
Dialogue: 0,0:48:46.98,0:48:47.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:47.77,0:48:50.08,Default,,0,0,0,,Канан, ақымақ болма.
Dialogue: 0,0:48:50.08,0:48:53.65,Default,,0,0,0,,Бірақ жағдай осылай жалғаса берсе, солай болады, солай емес пе?
Dialogue: 0,0:48:53.65,0:48:56.34,Default,,0,0,0,,Сондықтан сіз мұның алдын алуға тырысасыз, солай емес пе?
Dialogue: 0,0:48:56.34,0:48:59.32,Default,,0,0,0,,Мен енді түсінбеймін! Не айтқың келеді?
Dialogue: 0,0:48:59.32,0:49:02.71,Default,,0,0,0,,Басқаша айтқанда, неке туралы сөз болады.
Dialogue: 0,0:49:02.71,0:49:06.33,Default,,0,0,0,,Ал басқа адам мен бұрын ешқашан көрмеген адам!
Dialogue: 0,0:49:06.33,0:49:07.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:49:09.00,0:49:11.05,Default,,0,0,0,,Өйткені мен Маридің бостандығын тартып алғым келеді.
Dialogue: 0,0:49:13.48,0:49:19.26,Default,,0,0,0,,Маридің анасы көптен бері біз туралы жақсы ойлаған жоқ.
Dialogue: 0,0:49:19.26,0:49:26.84,Default,,0,0,0,,Осы уақытқа дейін Мари мойынсұнып тыңдады, бірақ бізбен танысқаннан кейін ол өздігінен әрекет ете бастады.
Dialogue: 0,0:49:28.12,0:49:33.45,Default,,0,0,0,,Орта мектеп те рұқсатсыз Уранохошиге оралып, басқарманың президенті болды.
Dialogue: 0,0:49:33.45,0:49:37.95,Default,,0,0,0,,Мектеп кумирлерінен жақсы әсер алмаған шығар.
Dialogue: 0,0:49:37.95,0:49:39.72,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:49:39.72,0:49:42.77,Default,,0,0,0,,Сонымен, мүмкін мектеп бітіруге арналған сапар?
Dialogue: 0,0:49:42.77,0:49:47.08,Default,,0,0,0,,Сонымен. Анам түсінсін деп жазып қалдым.
Dialogue: 0,0:49:47.08,0:49:50.25,Default,,0,0,0,,Мен енді сол кездегі адам емеспін.
Dialogue: 0,0:49:50.25,0:49:53.44,Default,,0,0,0,,Бостандыққа жол бермесең, қайтып келмеймін.
Dialogue: 0,0:49:54.47,0:49:56.73,Default,,0,0,0,,Бұл жоспарланған қылмыс емес.
Dialogue: 0,0:49:56.73,0:50:00.64,Default,,0,0,0,,Мен оның бұлайша қуғындайтынын күтпедім.
Dialogue: 0,0:50:00.64,0:50:05.62,Default,,0,0,0,,Ұрысты доғарайық. Барлығыңыз тыныш болыңыздар.
Dialogue: 0,0:50:05.62,0:50:07.02,Default,,0,0,0,,Не істеп жатырсың, Зура?
Dialogue: 0,0:50:07.02,0:50:11.40,Default,,0,0,0,,Джон періште де соны қалайды!
Dialogue: 0,0:50:11.40,0:50:14.68,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:50:16.05,0:50:16.96,Default,,0,0,0,,Йошико-чан!
Dialogue: 0,0:50:16.96,0:50:18.30,Default,,0,0,0,,Жарайды! ?
Dialogue: 0,0:50:19.12,0:50:20.02,Default,,0,0,0,,Жақсы~
Dialogue: 0,0:50:20.02,0:50:21.87,Default,,0,0,0,,Ол шынымен де құлаған періште.
Dialogue: 0,0:50:21.87,0:50:23.80,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:50:23.80,0:50:26.45,Default,,0,0,0,,Маған көмектесіңізші!
Dialogue: 0,0:50:26.45,0:50:28.84,Default,,0,0,0,,Зура ақыры қалыпқа келді.
Dialogue: 0,0:50:40.37,0:50:41.89,Default,,0,0,0,,Құлаған періште түседі!
Dialogue: 0,0:50:42.64,0:50:43.68,Default,,0,0,0,,Сучан!
Dialogue: 0,0:50:43.68,0:50:44.76,Default,,0,0,0,,Дәлірек айтқанда,
Dialogue: 0,0:50:44.76,0:50:48.17,Default,,0,0,0,,Мәселе мынада, түпнұсқа осы.
Dialogue: 0,0:50:48.17,0:50:51.15,Default,,0,0,0,,Аузыңды жап! Кішкентай жын, Лили!
Dialogue: 0,0:50:51.15,0:50:53.05,Default,,0,0,0,,Лилияға рұқсат жоқ!
Dialogue: 0,0:50:53.05,0:50:59.37,Default,,0,0,0,,Қалай болғанда да, Чика мен басқалары қатысқандықтан, мен қазір не істеймін деп мұқият ойлануым керек.
Dialogue: 0,0:50:59.37,0:51:00.90,Default,,0,0,0,,.
Dialogue: 0,0:51:03.20,0:51:04.42,Default,,0,0,0,,А...?
Dialogue: 0,0:51:05.44,0:51:08.05,Default,,0,0,0,,Ал, анашым...!
Dialogue: 0,0:51:09.08,0:51:10.98,Default,,0,0,0,,Сенің мұндай жерде жасырынып жүргеніңе сене алар емеспін.
Dialogue: 0,0:51:10.98,0:51:12.77,Default,,0,0,0,,Бұл да Хагудың даналығы ма?
Dialogue: 0,0:51:12.77,0:51:13.46,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:51:14.72,0:51:17.84,Default,,0,0,0,,Мен бұл туралы ойладым. Себебі анам табанды...
Dialogue: 0,0:51:18.44,0:51:21.42,Default,,0,0,0,,Бұл мен табанды болмағандықтан болды.
Dialogue: 0,0:51:21.42,0:51:28.85,Default,,0,0,0,,Бастауыш сыныпта оқып жүргенімде үйден қашып кеткенімде және орта мектепті жалғыз тастап, мектепті құтқару үшін Уранохошиге оралғанымда,
Dialogue: 0,0:51:28.85,0:51:31.74,Default,,0,0,0,,Мен әкемнің айтқанына шыдадым.
Dialogue: 0,0:51:31.74,0:51:34.25,Default,,0,0,0,,Алайда нәтиже өлім!
Dialogue: 0,0:51:34.25,0:51:35.36,Default,,0,0,0,,Бұл...
Dialogue: 0,0:51:35.36,0:51:37.22,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:51:37.22,0:51:40.11,Default,,0,0,0,,Жақсы ештеңе болған жоқ, солай ма?
Dialogue: 0,0:51:40.11,0:51:45.87,Default,,0,0,0,,Мектеп жабылды, ал Маридің шетелде оқуға құқығы болмады!
Dialogue: 0,0:51:45.87,0:51:49.14,Default,,0,0,0,,Күте тұрыңыз! Бірақ мектеп кумирі дұрыс айтты.
Dialogue: 0,0:51:49.14,0:51:52.32,Default,,0,0,0,,Бәріміз бірге сүйейік! жеңді!
Dialogue: 0,0:51:52.32,0:51:53.40,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:51:54.78,0:51:59.44,Default,,0,0,0,,Мектеп кумирі болудан не ұттың?
Dialogue: 0,0:52:01.44,0:52:02.58,Default,,0,0,0,,Бұл қоқыс.
Dialogue: 0,0:52:04.37,0:52:05.38,Default,,0,0,0,,Білек...?
Dialogue: 0,0:52:09.18,0:52:11.00,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:52:11.73,0:52:15.88,Default,,0,0,0,,Сондықтан біз Мариді сыртқы әлемге шығардық.
Dialogue: 0,0:52:16.65,0:52:17.52,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:52:18.21,0:52:20.90,Default,,0,0,0,,Қалай болғанда да, мен Маридің әрекетіне жауаптымын...
Dialogue: 0,0:52:20.90,0:52:22.29,Default,,0,0,0,,Бұл бос сөз емес!
Dialogue: 0,0:52:23.57,0:52:24.20,Default,,0,0,0,,Мари.
Dialogue: 0,0:52:24.69,0:52:27.70,Default,,0,0,0,,Мектеп кумирлерінің құны жоқ емес!
Dialogue: 0,0:52:28.74,0:52:35.46,Default,,0,0,0,,Егер біз мектеп кумирлерінің ақымақ емес екенін дәлелдей алсақ, олар шынымен керемет.
Dialogue: 0,0:52:35.46,0:52:37.36,Default,,0,0,0,,Маған қалағанымды жасауға рұқсат бересіз бе?
Dialogue: 0,0:52:38.71,0:52:44.34,Default,,0,0,0,,Егер мен анамның алдында мектептегі пұттардың адамдарды таң қалдыратынын дәлелдей алсам,
Dialogue: 0,0:52:44.34,0:52:46.76,Default,,0,0,0,,Менің өткенімді қабылдайсың ба?
Dialogue: 0,0:52:46.76,0:52:48.57,Default,,0,0,0,,Үйленуді сұрауды тоқтатыңыз,
Dialogue: 0,0:52:48.57,0:52:52.73,Default,,0,0,0,,Сізбен еркін кездесуге рұқсат ете аласыз ба?
Dialogue: 0,0:53:02.17,0:53:03.11,Default,,0,0,0,,...Жарайды.
Dialogue: 0,0:53:04.29,0:53:05.20,Default,,0,0,0,,Ана...
Dialogue: 0,0:53:05.20,0:53:10.08,Default,,0,0,0,,Алайда! Егер ол жұмыс істемесе, мен сізге айтқанымды тыңдауыңызды сұраймын!
Dialogue: 0,0:53:27.92,0:53:28.88,Default,,0,0,0,,Риа,
Dialogue: 0,0:53:29.64,0:53:32.68,Default,,0,0,0,,Маған жаңа ғана Чика және басқалары қоңырау шалды.
Dialogue: 0,0:53:32.68,0:53:36.80,Default,,0,0,0,,Осыдан кейін біз сол жерде тікелей шоу жасадық, нәтижесінде
Dialogue: 0,0:53:42.20,0:53:43.53,Default,,0,0,0,,Әпке...
Dialogue: 0,0:53:43.53,0:53:45.89,Default,,0,0,0,,Өтінемін, шамдарды өшіріңіз...
Dialogue: 0,0:53:48.20,0:53:49.26,Default,,0,0,0,,Себеп...
Dialogue: 0,0:53:56.52,0:53:58.17,Default,,0,0,0,,...
Dialogue: 0,0:53:58.17,0:54:01.13,Default,,0,0,0,,Қайырлы кеш, Бонасера.
Dialogue: 0,0:54:02.88,0:54:05.54,Default,,0,0,0,,Оттимо Зура!
Dialogue: 0,0:54:05.54,0:54:07.64,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:54:07.64,0:54:11.24,Default,,0,0,0,,Мен сонша жесем де, еш өзгеріс жоқ.
Dialogue: 0,0:54:11.24,0:54:12.86,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:54:12.86,0:54:17.15,Default,,0,0,0,,Бұл лазанья да дәмді!
Dialogue: 0,0:54:18.56,0:54:19.45,Default,,0,0,0,,Жауап беріңіз…
Dialogue: 0,0:54:19.45,0:54:20.94,Default,,0,0,0,,Бұл шешілді ме?
Dialogue: 0,0:54:20.94,0:54:21.96,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:54:22.77,0:54:23.82,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:54:23.82,0:54:26.02,Default,,0,0,0,,Бұл ән айтатын жер!
Dialogue: 0,0:54:26.02,0:54:30.12,Default,,0,0,0,,Бұл қызық болды! Треви фонтаны, шындықтың аузы!
Dialogue: 0,0:54:30.12,0:54:34.25,Default,,0,0,0,,Шынымен. Барлығымен бірге өте қызықты!
Dialogue: 0,0:54:34.25,0:54:35.96,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:54:35.96,0:54:37.86,Default,,0,0,0,,Сіз оны көтердіңіз, солай ма?
Dialogue: 0,0:54:37.86,0:54:42.62,Default,,0,0,0,,Осы жерде тікелей эфирде шоу жасап, анаңызға мектептегі кумирлердің қандай керемет екенін көрсетейік!
Dialogue: 0,0:54:42.62,0:54:44.76,Default,,0,0,0,,Мен білемін, білемін
Dialogue: 0,0:54:44.76,0:54:48.84,Default,,0,0,0,,Шын мәнінде, барлық жер әдемі және адамдар көп,
Dialogue: 0,0:54:48.84,0:54:52.56,Default,,0,0,0,,Егер мен сахнада ән айта алсам, бұл өте қызықты болар еді деп ойлаймын.
Dialogue: 0,0:54:52.56,0:54:57.00,Default,,0,0,0,,Иә. Субұрқақ әдемі, баспалдақтар да әдемі болды.
Dialogue: 0,0:54:57.00,0:54:59.27,Default,,0,0,0,,Мен мұның бәрін пайдалана алсам ғой!
Dialogue: 0,0:54:59.27,0:55:01.53,Default,,0,0,0,,Күтілгендей, барлығы...
Dialogue: 0,0:55:01.53,0:55:03.09,Default,,0,0,0,,Сонда Колизей ше?
Dialogue: 0,0:55:03.09,0:55:05.28,Default,,0,0,0,,Бейнекамераны маған қалдырыңыз!
Dialogue: 0,0:55:05.28,0:55:07.01,Default,,0,0,0,,О! Жақсы!
Dialogue: 0,0:55:07.01,0:55:09.93,Default,,0,0,0,,Иә. Көп адам жиналатын сияқты
Dialogue: 0,0:55:09.93,0:55:11.37,Default,,0,0,0,,бекітілген бе?
Dialogue: 0,0:55:11.37,0:55:12.32,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:55:13.03,0:55:15.62,Default,,0,0,0,,Менен бір нәрсе сұрағаныңызды қалаймын.
Dialogue: 0,0:55:15.62,0:55:18.73,Default,,0,0,0,,Мен бірінші курс студенттерімен сөйлескім келеді.
Dialogue: 0,0:55:21.74,0:55:25.49,Default,,0,0,0,,Мен Руби мен басқалардың осы тікелей шоудың орнын шешкенін қалаймын!
Dialogue: 0,0:55:26.76,0:55:32.76,Default,,0,0,0,,Осы уақытқа дейін Руби мен оның достары әрқашан Чика-чан мен оның әпкелеріне сенетін.
Dialogue: 0,0:55:32.76,0:55:36.41,Default,,0,0,0,,Сонымен! Осы тірі орындауды маған қалдырғаныңызды қалаймын!
Dialogue: 0,0:55:40.29,0:55:43.42,Default,,0,0,0,,Менің ішім сыни тоқ...
Dialogue: 0,0:55:43.42,0:55:46.05,Default,,0,0,0,,Сахна алдында бірдеңе жасаңыз.
Dialogue: 0,0:55:46.05,0:55:47.97,Default,,0,0,0,,Қайырлы түн Мизура~
Dialogue: 0,0:55:47.97,0:55:50.32,Default,,0,0,0,,Неліктен бұл әрқашан мен ғана?
Dialogue: 0,0:55:50.89,0:55:51.99,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:55:53.93,0:55:56.62,Default,,0,0,0,,Өйткені Мари кенеттен осындай сөздер айта бастайды.
Dialogue: 0,0:55:56.62,0:56:00.01,Default,,0,0,0,,Жай... Сөзді сатыңыз және Сөзді сатып алыңыз.
Dialogue: 0,0:56:00.01,0:56:01.88,Default,,0,0,0,,Сөздерді сату және сөздерді сатып алу?
Dialogue: 0,0:56:01.88,0:56:02.63,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:56:02.63,0:56:08.49,Default,,0,0,0,,Қарсылық болып көрінсе, үшеуміз бірге бірдеңе істеудің жолы бар.
Dialogue: 0,0:56:08.49,0:56:09.24,Default,,0,0,0,,Чика және басқалары...
Dialogue: 0,0:56:09.24,0:56:10.96,Default,,0,0,0,,Иә, иә, бәрі жақсы.
Dialogue: 0,0:56:11.63,0:56:14.62,Default,,0,0,0,,Негізі біз де бақыттымыз.
Dialogue: 0,0:56:14.62,0:56:16.02,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:56:16.02,0:56:22.01,Default,,0,0,0,,Иә, мен мұнда тек Маридің анасы айтқандықтан ғана келген жоқпын.
Dialogue: 0,0:56:22.60,0:56:28.10,Default,,0,0,0,,Негізінде, менің ойымша, Руби-чан және басқалар, соның ішінде біз де уайымдадық.
Dialogue: 0,0:56:29.05,0:56:32.11,Default,,0,0,0,,Барлығы біраз уайымдады, солай ма?
Dialogue: 0,0:56:32.11,0:56:34.87,Default,,0,0,0,,Жаңа акурлар дегеніміз не?
Dialogue: 0,0:56:34.87,0:56:37.87,Default,,0,0,0,,Жаңа акурлар?
Dialogue: 0,0:56:37.87,0:56:43.33,Default,,0,0,0,,Мен оны өзіміз табуымыз керек екенін білемін, бірақ...
Dialogue: 0,0:56:43.33,0:56:48.36,Default,,0,0,0,,Сосын Сейра-сан бір рет кездесіп, сөйлескеніміз дұрыс деп ойлады.
Dialogue: 0,0:56:48.36,0:56:49.54,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:56:50.29,0:56:52.72,Default,,0,0,0,,Қалай ойлайсың, Канан-чан?
Dialogue: 0,0:56:53.92,0:56:55.97,Default,,0,0,0,,...Менің ойымша, Чика дұрыс айтады.
Dialogue: 0,0:56:55.97,0:56:56.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:56.80,0:56:59.46,Default,,0,0,0,,Чика мен басқалардың оны табудан басқа амалы жоқ.
Dialogue: 0,0:56:59.46,0:57:03.42,Default,,0,0,0,,Дұрыс. Біздің пікірлеріміз қосылса, мағынасыз болар еді.
Dialogue: 0,0:57:04.04,0:57:05.15,Default,,0,0,0,,... дұрыс па?
Dialogue: 0,0:57:05.15,0:57:06.30,Default,,0,0,0,,Бірақ
Dialogue: 0,0:57:09.52,0:57:12.24,Default,,0,0,0,,Бірақ менің сезімім әрқашан осында болады.
Dialogue: 0,0:57:12.73,0:57:13.99,Default,,0,0,0,,Маридің сезімі,
Dialogue: 0,0:57:13.99,0:57:15.74,Default,,0,0,0,,Алмаз сезімдері,
Dialogue: 0,0:57:15.74,0:57:18.09,Default,,0,0,0,,Менің де сезімім,
Dialogue: 0,0:57:18.09,0:57:19.74,Default,,0,0,0,,Әрқашан бірдей
Dialogue: 0,0:57:19.74,0:57:21.45,Default,,0,0,0,,Мәңгі...
Dialogue: 0,0:57:21.45,0:57:24.46,Default,,0,0,0,,Иә, әрқашан
Dialogue: 0,0:57:26.46,0:57:30.06,Default,,0,0,0,,Жарайды, ертең ерте, сондықтан мен қазір ұйықтаймын.
Dialogue: 0,0:57:30.06,0:57:31.84,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:57:39.92,0:57:41.04,Default,,0,0,0,,Чика-чан
Dialogue: 0,0:57:42.06,0:57:44.69,Default,,0,0,0,,Мен бірдеңені көрдім!
Dialogue: 0,0:57:44.69,0:57:46.44,Default,,0,0,0,,Мен оны көрдім деп ойлаймын!
Dialogue: 0,0:57:59.81,0:58:01.88,Default,,0,0,0,,Мен қайда баруым керек?
Dialogue: 0,0:58:02.64,0:58:04.60,Default,,0,0,0,,Осы Джонның көзімен!
Dialogue: 0,0:58:04.60,0:58:07.12,Default,,0,0,0,,Негізі мен орынды шешіп қойғанмын!
Dialogue: 0,0:58:29.93,0:58:32.87,Default,,0,0,0,,Тоқтаусыз музыка
Dialogue: 0,0:58:32.87,0:58:38.56,Default,,0,0,0,,Тоқтаусыз секіріп жатқан жүрек
Dialogue: 0,0:58:38.86,0:58:42.92,Default,,0,0,0,,Біз қаншалықты кішкентаймыз
Dialogue: 0,0:58:42.92,0:58:44.75,Default,,0,0,0,,Бірақ
Dialogue: 0,0:58:44.78,0:58:48.85,Default,,0,0,0,,Мен көп нәрсені түсіндім.
Dialogue: 0,0:58:48.85,0:58:52.91,Default,,0,0,0,,Барған сайын армандағым келеді
Dialogue: 0,0:58:53.64,0:58:56.68,Default,,0,0,0,,Қолымнан келмейтін істерді жасай алдым.
Dialogue: 0,0:58:56.68,0:58:59.61,Default,,0,0,0,,Мен мұны жалғыз жасай алмадым.
Dialogue: 0,0:58:59.61,0:59:02.21,Default,,0,0,0,,Біз бірге болғанда шығарылатын күш
Dialogue: 0,0:59:02.21,0:59:04.72,Default,,0,0,0,,Мен өзімді бақытты сезінемін.
Dialogue: 0,0:59:04.72,0:59:05.50,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:59:05.50,0:59:11.11,Default,,0,0,0,,Болашақ қазіргі уақыттан тыс
Dialogue: 0,0:59:11.11,0:59:14.00,Default,,0,0,0,,Сіз өзіңізді ұстауыңыз керек
Dialogue: 0,0:59:14.00,0:59:19.70,Default,,0,0,0,,Ол үшін бос қанатпен ұшып кет!!
Dialogue: 0,0:59:19.70,0:59:22.90,Default,,0,0,0,,Мен толққым келеді, мен қалаймын
Dialogue: 0,0:59:22.90,0:59:24.40,Default,,0,0,0,,Мен толққым келеді, мен қалаймын
Dialogue: 0,0:59:24.40,0:59:25.00,Default,,0,0,0,,Бүкіл әлем біртұтас болады (егер біз билесек)
Dialogue: 0,0:59:25.00,0:59:28.84,Default,,0,0,0,,Бүкіл әлем біртұтас болады
Dialogue: 0,0:59:28.84,0:59:30.54,Default,,0,0,0,,Келіңіздер! Кәне! Кәне!
Dialogue: 0,0:59:30.54,0:59:31.64,Default,,0,0,0,,Ыстық болыңыз! !
Dialogue: 0,0:59:31.64,0:59:34.76,Default,,0,0,0,,Мен толқығым келеді, сондықтан мен сізге мұны істеуге рұқсат етемін.
Dialogue: 0,0:59:34.76,0:59:36.21,Default,,0,0,0,,Мен толқығым келеді, сондықтан мен сізге мұны істеуге рұқсат етемін.
Dialogue: 0,0:59:36.21,0:59:40.53,Default,,0,0,0,,Жүрегі байланысқан әрбір адаммен
Dialogue: 0,0:59:40.53,0:59:45.84,Default,,0,0,0,,Мен соншалықты керемет нәрсені істеуді тоқтата алмаймын
Dialogue: 0,0:59:45.84,0:59:48.87,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:59:48.87,0:59:51.15,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:59:51.15,0:59:52.57,Default,,0,0,0,,Бәріңе, Дайсуки!
Dialogue: 0,0:59:57.01,0:59:58.51,Default,,0,0,0,,Бәріңе, Дайсуки!
Dialogue: 0,0:59:58.86,1:00:04.79,Default,,0,0,0,,Өлеңге сөз берілгенде
Dialogue: 0,1:00:04.79,1:00:14.60,Default,,0,0,0,,Маған берілген бұл сезімді ешқашан ұмытпаймын
Dialogue: 0,1:00:14.60,1:00:17.77,Default,,0,0,0,,Мен толққым келеді, мен қалаймын
Dialogue: 0,1:00:17.77,1:00:19.29,Default,,0,0,0,,Мен толққым келеді, мен қалаймын
Dialogue: 0,1:00:19.29,1:00:20.09,Default,,0,0,0,,Бүкіл әлем біртұтас болады (егер біз билесек)
Dialogue: 0,1:00:20.09,1:00:23.67,Default,,0,0,0,,Бүкіл әлем біртұтас болады
Dialogue: 0,1:00:23.67,1:00:25.33,Default,,0,0,0,,Келіңіздер! Кәне! Кәне!
Dialogue: 0,1:00:25.33,1:00:26.48,Default,,0,0,0,,Ыстық болыңыз! !
Dialogue: 0,1:00:26.48,1:00:29.64,Default,,0,0,0,,Мен толқығым келеді, сондықтан мен сізге мұны істеуге рұқсат етемін.
Dialogue: 0,1:00:29.64,1:00:31.10,Default,,0,0,0,,Мен толқығым келеді, сондықтан мен сізге мұны істеуге рұқсат етемін.
Dialogue: 0,1:00:31.10,1:00:35.33,Default,,0,0,0,,Жүрегі байланысқан әрбір адаммен
Dialogue: 0,1:00:35.33,1:00:40.68,Default,,0,0,0,,Мен соншалықты керемет нәрсені істеуді тоқтата алмаймын
Dialogue: 0,1:00:40.68,1:00:41.86,Default,,0,0,0,,Дұрыс!
Dialogue: 0,1:00:41.86,1:00:44.45,Default,,0,0,0,,Тоқтаусыз музыка. Дұрыс!
Dialogue: 0,1:00:44.45,1:00:44.83,Default,,0,0,0,,Тоқтаусыз музыка
Dialogue: 0,1:00:44.83,1:00:50.32,Default,,0,0,0,,Тоқтаусыз секірген жүрек
Dialogue: 0,1:00:59.14,1:01:00.21,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,1:01:00.21,1:01:03.34,Default,,0,0,0,,Ruby қазір бәрін жасай алады.
Dialogue: 0,1:01:03.34,1:01:04.96,Default,,0,0,0,,Кез келген нәрсе!
Dialogue: 0,1:01:04.96,1:01:06.14,Default,,0,0,0,,Иә!
Dialogue: 0,1:01:06.14,1:01:09.05,Default,,0,0,0,,Неліктен Плаза де Испанияны таңдадыңыз?
Dialogue: 0,1:01:09.05,1:01:09.89,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,1:01:09.89,1:01:14.74,Default,,0,0,0,,Қалай болғанда да, бұл зуралар Нумазу жағалауындағы тас баспалдақтарды еске түсіреді.
Dialogue: 0,1:01:14.74,1:01:15.90,Default,,0,0,0,,Сәлем! ?
Dialogue: 0,1:01:19.28,1:01:20.24,Default,,0,0,0,,Мари
Dialogue: 0,1:01:23.76,1:01:24.74,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,1:01:26.58,1:01:32.30,Default,,0,0,0,,Осы уақытқа дейін барлығымен бірге жасаған саяхатым енді менің бір бөлігім.
Dialogue: 0,1:01:32.30,1:01:33.83,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,1:01:35.01,1:01:40.50,Default,,0,0,0,,Мені анам мен әкем қалай өсірсе, Акурс және басқалары мені өсірді.
Dialogue: 0,1:01:41.33,1:01:44.34,Default,,0,0,0,,Сіз ештеңені жібере алмайсыз.
Dialogue: 0,1:01:45.00,1:01:47.09,Default,,0,0,0,,Мен қазір сондаймын.
Dialogue: 0,1:01:57.49,1:01:58.68,Default,,0,0,0,,Не болды?
Dialogue: 0,1:01:58.68,1:01:59.69,Default,,0,0,0,,Енді?
Dialogue: 0,1:02:05.30,1:02:06.45,Default,,0,0,0,,Бірақ
Dialogue: 0,1:02:07.10,1:02:08.70,Default,,0,0,0,,Сіз түсінесіз деп ойлаймын.
Dialogue: 0,1:02:09.81,1:02:10.89,Default,,0,0,0,,Иә
Dialogue: 0,1:02:18.26,1:02:20.57,Default,,0,0,0,,Джон...Қайтар!
Dialogue: 0,1:02:21.17,1:02:22.89,Default,,0,0,0,,Шаршаған ерке~.
Dialogue: 0,1:02:22.89,1:02:24.38,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,1:02:29.96,1:02:32.13,Default,,0,0,0,,Зура ешкіммен бірге~
Dialogue: 0,1:02:32.13,1:02:35.61,Default,,0,0,0,,Мутчан және басқалары оның осында екенін айтты...
Dialogue: 0,1:02:38.46,1:02:40.40,Default,,0,0,0,,Қайтып келдің!
Dialogue: 0,1:02:41.78,1:02:45.36,Default,,0,0,0,,Кешіріңіз. Мен жанды орындауға көмек сұрадым.
Dialogue: 0,1:02:45.36,1:02:49.85,Default,,0,0,0,,Бұл өте жақсы. Мен электрондық поштаны алған бойда барлығына хабарластым,
Dialogue: 0,1:02:49.85,1:02:52.09,Default,,0,0,0,,Ол маған бірден көмектесетінін айтты.
Dialogue: 0,1:02:53.73,1:02:56.25,Default,,0,0,0,,Негізі менде сахнаның бейнесі бар!
Dialogue: 0,1:02:56.25,1:02:57.54,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:02:57.54,1:02:59.78,Default,,0,0,0,,Қараңыз және таң қалдырыңыз!
Dialogue: 0,1:02:59.78,1:03:01.13,Default,,0,0,0,,Міне!
Dialogue: 0,1:03:01.79,1:03:03.66,Default,,0,0,0,,Иә!
Dialogue: 0,1:03:05.71,1:03:06.97,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,1:03:06.97,1:03:08.30,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:03:08.30,1:03:10.59,Default,,0,0,0,,Бірақ осындай тамаша сахна...
Dialogue: 0,1:03:10.59,1:03:13.18,Default,,0,0,0,,Бұл өте жақсы емес, бірақ мен оны уақытында жасай алмаймыз деп ойлаймын...
Dialogue: 0,1:03:13.18,1:03:15.45,Default,,0,0,0,,Мен де солай айттым.
Dialogue: 0,1:03:15.45,1:03:20.94,Default,,0,0,0,,Мен бұл туралы бәріне айтқанымда, мен олар міндетті түрде Аква үшін қолайлы болатын таңғажайып сахнаны жасайтынын түсіндім.
Dialogue: 0,1:03:20.94,1:03:24.90,Default,,0,0,0,,Мен сізге тіпті Ура но Хошидің де мұны дұрыс істей алмайтынын дәлелдеймін.
Dialogue: 0,1:03:24.90,1:03:30.20,Default,,0,0,0,,Дегенмен жанды дыбысты орындайтын қызметкерлер жетіспейді.
Dialogue: 0,1:03:30.20,1:03:31.66,Default,,0,0,0,,Сәлем
Dialogue: 0,1:03:31.66,1:03:33.62,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,1:03:36.88,1:03:39.37,Default,,0,0,0,,Ол маған кеңес сұрап келді.
Dialogue: 0,1:03:39.37,1:03:43.69,Default,,0,0,0,,Кейбір ата-аналардың қарсылығы әлі де бар, бірақ олар ынтымақтасқысы келеді.
Dialogue: 0,1:03:43.69,1:03:46.46,Default,,0,0,0,,Бірақ адам саны әлі де аз...
Dialogue: 0,1:03:47.50,1:03:49.69,Default,,0,0,0,,Сәлеметсіз бе, студенттер кеңесінің төрағасы!
Dialogue: 0,1:03:49.69,1:03:51.22,Default,,0,0,0,,Рахмет.
Dialogue: 0,1:03:51.22,1:03:52.60,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,1:03:52.60,1:03:53.88,Default,,0,0,0,,Мүмкін,
Dialogue: 0,1:03:53.88,1:03:55.12,Default,,0,0,0,,Йохан!
Dialogue: 0,1:03:55.12,1:03:55.90,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:03:55.90,1:03:58.10,Default,,0,0,0,,Орта мектепке бірге бардық!
Dialogue: 0,1:03:59.61,1:04:01.23,Default,,0,0,0,,Мен оны үнемі онлайн көремін!
Dialogue: 0,1:04:02.73,1:04:05.23,Default,,0,0,0,,Джон, Адвент! ! !
Dialogue: 0,1:04:10.49,1:04:15.32,Default,,0,0,0,,Мен үшін тамырлас болсаң да, қашу жақсы емес, солай ма?
Dialogue: 0,1:04:16.24,1:04:16.95,Default,,0,0,0,,Шулы!
Dialogue: 0,1:04:16.95,1:04:21.56,Default,,0,0,0,,Менімен суретке түскіңіз келе ме? Йоханнамен бірге.
Dialogue: 0,1:04:21.56,1:04:22.42,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,1:04:22.42,1:04:23.26,Default,,0,0,0,,Шынымен! ?
Dialogue: 0,1:04:23.26,1:04:24.52,Default,,0,0,0,,Суретке түсіріңіз!
Dialogue: 0,1:04:24.52,1:04:25.50,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:04:27.46,1:04:29.24,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін.
Dialogue: 0,1:04:29.24,1:04:30.97,Default,,0,0,0,,Мен бар күшімді саламын.
Dialogue: 0,1:04:30.97,1:04:32.58,Default,,0,0,0,,H-бұл қорқынышты...
Dialogue: 0,1:04:32.58,1:04:35.05,Default,,0,0,0,,Кішкентай жынның бүлігі...!
Dialogue: 0,1:04:36.94,1:04:37.92,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:04:37.92,1:04:39.48,Default,,0,0,0,,Оны бағалаңыз!
Dialogue: 0,1:04:39.48,1:04:41.78,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,1:04:41.78,1:04:44.36,Default,,0,0,0,,Маған жеке куәлігіңізді көрсетіңіз, сонда мен сізге фотосурет жіберемін.
Dialogue: 0,1:04:48.82,1:04:50.49,Default,,0,0,0,,Фурифури.
Dialogue: 0,1:04:50.49,1:04:52.16,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:04:52.16,1:04:53.20,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,1:05:00.90,1:05:03.38,Default,,0,0,0,,Жарайды! Қанекей мынаны істейік!
Dialogue: 0,1:05:03.38,1:05:06.57,Default,,0,0,0,,Бірақ мен ән айтқан кездегідей емес,
Dialogue: 0,1:05:06.57,1:05:09.02,Default,,0,0,0,,Мари-чан және басқалары кетті...
Dialogue: 0,1:05:10.42,1:05:11.09,Default,,0,0,0,,...болуы мүмкін.
Dialogue: 0,1:05:12.05,1:05:13.43,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,1:05:13.96,1:05:15.18,Default,,0,0,0,,Руби-чан!
Dialogue: 0,1:05:15.85,1:05:17.58,Default,,0,0,0,,Менің де қолымнан келеді!
Dialogue: 0,1:05:17.58,1:05:18.74,Default,,0,0,0,,Чика-чан да?
Dialogue: 0,1:05:18.74,1:05:19.68,Default,,0,0,0,,Иә!
Dialogue: 0,1:05:23.04,1:05:25.31,Default,,0,0,0,,Біз де бар күшімізді салуымыз керек!
Dialogue: 0,1:05:25.31,1:05:26.86,Default,,0,0,0,,Айтпақшы, кәдесыйлар ше?
Dialogue: 0,1:05:26.86,1:05:28.36,Default,,0,0,0,,А, мен ұмытып кетіппін...
Dialogue: 0,1:05:28.36,1:05:29.82,Default,,0,0,0,,Ееееее! ?
Dialogue: 0,1:05:30.57,1:05:35.28,Default,,0,0,0,,Әйтеуір, мен жаңа мектептің осындай екеніне сене алар емеспін.
Dialogue: 0,1:05:35.28,1:05:38.42,Default,,0,0,0,,Маған дұрыс айтқаныңызды қалаймын.
Dialogue: 0,1:05:38.42,1:05:41.28,Default,,0,0,0,,Егер мен не болып жатқанын білсем, көмектесуге тырысар едім.
Dialogue: 0,1:05:41.28,1:05:42.33,Default,,0,0,0,,Мақсат ақыл-есі бар сияқты,
Dialogue: 0,1:05:43.06,1:05:45.53,Default,,0,0,0,,Біз өзіміз бірдеңе істеуіміз керек.
Dialogue: 0,1:05:46.69,1:05:48.12,Default,,0,0,0,,Не болды?
Dialogue: 0,1:05:48.12,1:05:52.36,Default,,0,0,0,,Өте қызық! Мен ештеңе істей алмаймын.
Dialogue: 0,1:05:52.36,1:05:56.34,Default,,0,0,0,,Оған көмектесу мүмкін емес. Өйткені біз мектеп бітірдік.
Dialogue: 0,1:05:57.00,1:06:01.06,Default,,0,0,0,,Чика да осы тікелей эфирді көруімді өтінді.
Dialogue: 0,1:06:01.06,1:06:03.17,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:06:06.06,1:06:07.38,Default,,0,0,0,,Бұл...
Dialogue: 0,1:06:09.18,1:06:11.07,Default,,0,0,0,,Ей, жарасайық.
Dialogue: 0,1:06:11.07,1:06:13.12,Default,,0,0,0,,Кішкене үндемеңіз.
Dialogue: 0,1:06:13.78,1:06:15.52,Default,,0,0,0,,Чика-чан қазір қатты жұмыс істеп жатыр.
Dialogue: 0,1:06:17.00,1:06:17.95,Default,,0,0,0,,Отырыңыз.
Dialogue: 0,1:06:20.33,1:06:21.33,Default,,0,0,0,,Отырыңыз!
Dialogue: 0,1:06:22.16,1:06:23.72,Default,,0,0,0,,Ооооооооооооооооооооооооооооооооооооооооооооооооо!
Dialogue: 0,1:06:24.30,1:06:26.93,Default,,0,0,0,,Тек мені тыңда!
Dialogue: 0,1:06:45.81,1:06:47.18,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,1:06:48.60,1:06:50.45,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,1:06:53.81,1:06:59.32,Default,,0,0,0,,Мен бір нәрсені түсіне бастағандай сезінемін. Болашақтың басы неден басталады?
Dialogue: 0,1:07:00.33,1:07:02.33,Default,,0,0,0,,Сіз 6 акурды айтасыз ба?
Dialogue: 0,1:07:02.72,1:07:03.82,Default,,0,0,0,,Иә.
Dialogue: 0,1:07:03.82,1:07:08.21,Default,,0,0,0,,Мен әрқашан бастама 0 деп ойладым.
Dialogue: 0,1:07:08.21,1:07:12.17,Default,,0,0,0,,Бір нәрсені 0-ден бастау оның басы екенін білдіреді.
Dialogue: 0,1:07:12.17,1:07:13.46,Default,,0,0,0,,Жоқ?
Dialogue: 0,1:07:15.41,1:07:16.42,Default,,0,0,0,,№.
Dialogue: 0,1:07:17.17,1:07:22.09,Default,,0,0,0,,Өйткені 0 осы уақытқа дейін істегендердің бәрі жойылады дегенді білдіреді, солай емес пе?
Dialogue: 0,1:07:22.09,1:07:23.76,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,1:07:24.84,1:07:28.24,Default,,0,0,0,,Осы уақытқа дейін істеген істерімнің бәрі қалды.
Dialogue: 0,1:07:28.98,1:07:32.36,Default,,0,0,0,,Еш нәрсе жоғалмайды.
Dialogue: 0,1:07:35.29,1:07:38.78,Default,,0,0,0,,Осыны ойласам, қолымнан бірдеңе келетіндей болдым!
Dialogue: 0,1:07:40.30,1:07:42.12,Default,,0,0,0,,Ән мәтінін асыға күтемін.
Dialogue: 0,1:07:42.12,1:07:43.80,Default,,0,0,0,,Жақсы өлең жазып беріңізші.
Dialogue: 0,1:07:43.80,1:07:48.62,Default,,0,0,0,,Әрине. Қалай болғанда да, мен күн сайын музыкамен айналысатынмын.
Dialogue: 0,1:07:49.78,1:07:53.25,Default,,0,0,0,,Уақытым болса, ән тыңдаймын.
Dialogue: 0,1:07:53.98,1:07:55.80,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:07:55.80,1:07:57.51,Default,,0,0,0,,Біз жалғыз емеспіз.
Dialogue: 0,1:07:57.51,1:08:02.76,Default,,0,0,0,,Руби-чан мен Ханамару-чан костюмдер туралы анықтама алу үшін мата дүкенін қарап отырды.
Dialogue: 0,1:08:03.41,1:08:08.39,Default,,0,0,0,,Йо-чан мен Йошико-чан жаңа қадам жасау үшін көп жұмыс жасады.
Dialogue: 0,1:08:09.14,1:08:12.52,Default,,0,0,0,,Түсіндім... Аква керемет...
Dialogue: 0,1:08:12.52,1:08:16.42,Default,,0,0,0,,Керемет, осындай топтың басшысы болып.
Dialogue: 0,1:08:16.42,1:08:17.53,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:08:20.20,1:08:21.95,Default,,0,0,0,,Чика-чан!
Dialogue: 0,1:08:21.95,1:08:23.49,Default,,0,0,0,,Не?
Dialogue: 0,1:08:23.49,1:08:25.16,Default,,0,0,0,,Канан-чан маған қоңырау шалады~
Dialogue: 0,1:08:25.16,1:08:26.21,Default,,0,0,0,,Не?
Dialogue: 0,1:08:26.21,1:08:29.12,Default,,0,0,0,,Ой, батарея бітті...
Dialogue: 0,1:08:29.49,1:08:31.37,Default,,0,0,0,,Иә, иә! ?
Dialogue: 0,1:08:31.37,1:08:36.42,Default,,0,0,0,,Риа-чан Аква тобына қосылды! ?
Dialogue: 0,1:08:36.42,1:08:38.69,Default,,0,0,0,,Бұл сіздің аударып жатқаныңызды білдіре ме?
Dialogue: 0,1:08:38.69,1:08:39.47,Default,,0,0,0,,Иә
Dialogue: 0,1:08:39.47,1:08:45.54,Default,,0,0,0,,Егер сіз көктемде өтініш берсеңіз, сіз басқалармен бірге жаңа мектепке барасыз.
Dialogue: 0,1:08:45.54,1:08:47.45,Default,,0,0,0,,Үйрену оңай деп ойладым.
Dialogue: 0,1:08:48.96,1:08:51.23,Default,,0,0,0,,Риа-чан мұны істегісі келеді дейсіз бе?
Dialogue: 0,1:08:51.23,1:08:52.18,Default,,0,0,0,,Жоқ,
Dialogue: 0,1:08:52.18,1:08:54.29,Default,,0,0,0,,Біз әлі сөйлеспеген сияқтымыз.
Dialogue: 0,1:08:54.29,1:08:58.07,Default,,0,0,0,,Дегенмен, Сейра үшін бұл ең жақсы нәрсе деп ойлаймын.
Dialogue: 0,1:08:59.10,1:09:04.24,Default,,0,0,0,,Оқу орнын бітірген студент ретінде біреу хабарласып, ойымды сұрады.
Dialogue: 0,1:09:04.24,1:09:11.87,Default,,0,0,0,,Сейра-санмен сөйлескеніміз жақсы болар еді, бірақ мен Чика-сан мен басқалардың сезімдері де маңызды деп ойладым.
Dialogue: 0,1:09:12.69,1:09:14.28,Default,,0,0,0,,Риа-чан...
Dialogue: 0,1:09:14.28,1:09:15.88,Default,,0,0,0,,Аква кіріңіз...
Dialogue: 0,1:09:15.88,1:09:18.38,Default,,0,0,0,,Сіз жай ғана елестетсеңіз де...
Dialogue: 0,1:09:21.26,1:09:22.74,Default,,0,0,0,,Бұл қандай қадам?
Dialogue: 0,1:09:22.74,1:09:26.68,Default,,0,0,0,,Мектеп кумирлері тек көңіл көтеру үшін ғана емес! Йошико!
Dialogue: 0,1:09:26.68,1:09:29.60,Default,,0,0,0,,Йошико емес! Йохане!
Dialogue: 0,1:09:29.60,1:09:31.56,Default,,0,0,0,,Сіз не елестетесіз?
Dialogue: 0,1:09:32.34,1:09:33.66,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,1:09:33.66,1:09:36.02,Default,,0,0,0,,Жарайды, саған бұл мүлдем ұнамайды, солай ма?
Dialogue: 0,1:09:36.50,1:09:41.53,Default,,0,0,0,,Біз бәріміз бұрын айтқанымыздай, Акурда тұрақты адамдардың саны жоқ.
Dialogue: 0,1:09:41.53,1:09:46.03,Default,,0,0,0,,Сонымен қатар, Риа-чан да сол Лав Лайв бағдарламасында! Мен соған көп еңбек еткен доспын.
Dialogue: 0,1:09:46.03,1:09:47.76,Default,,0,0,0,,...Жақсы емес пе?
Dialogue: 0,1:09:47.76,1:09:49.30,Default,,0,0,0,,Бұл бір қиындыққа ұқсайды.
Dialogue: 0,1:09:49.30,1:09:54.37,Default,,0,0,0,,Йошико-чаннан үйренгенім Сузурадан үйренгенім көп.
Dialogue: 0,1:09:56.44,1:09:58.00,Default,,0,0,0,,Тек...
Dialogue: 0,1:09:58.00,1:09:59.63,Default,,0,0,0,,№.
Dialogue: 0,1:10:00.82,1:10:05.12,Default,,0,0,0,,Риа-чан, сен ондай нәрсені ешқашан қаламайды деп ойлаймын.
Dialogue: 0,1:10:05.12,1:10:09.53,Default,,0,0,0,,Мен Аква-қа қосылсам да, менің қазіргі проблемаларым шешілмейді деп ойлаймын.
Dialogue: 0,1:10:10.73,1:10:12.39,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,1:10:12.39,1:10:18.65,Default,,0,0,0,,Себебі Риа-Чан Сент-Қарды аяқтап, жаңа топ ашады, солай ма?
Dialogue: 0,1:10:19.73,1:10:26.24,Default,,0,0,0,,Әпкеммен жалғасқан Әулие қарды қастерлей бергім келеді, сондықтан жаңа топ ашамын.
Dialogue: 0,1:10:26.24,1:10:31.12,Default,,0,0,0,,Бұл Аква-қа қосылу дегенді білдірмейді деп ойлаймын.
Dialogue: 0,1:10:32.29,1:10:36.70,Default,,0,0,0,,Руби, мен оны апаңмен бірге ән айтудан алдым.
Dialogue: 0,1:10:38.28,1:10:40.88,Default,,0,0,0,,Менің апаларым жоғалып кетпейді.
Dialogue: 0,1:10:42.45,1:10:47.00,Default,,0,0,0,,Бір сахнада болмасақ та, біргеміз.
Dialogue: 0,1:10:48.50,1:10:49.70,Default,,0,0,0,,Бірге?
Dialogue: 0,1:10:53.06,1:10:57.06,Default,,0,0,0,,Менің ойымша, Риа Чан мұны түсінбейді.
Dialogue: 0,1:10:59.73,1:11:04.32,Default,,0,0,0,,Енді Сейра кеткен соң, мен бірдеңе істеуім керек.
Dialogue: 0,1:11:04.32,1:11:08.78,Default,,0,0,0,,Маған шынымен де Әулие Қарға ұқсас нәрсе жасау керек болды.
Dialogue: 0,1:11:09.86,1:11:14.96,Default,,0,0,0,,Махаббат Әпкеммен бірге өмір сүр! Мен міндетті түрде жеңуім керек,
Dialogue: 0,1:11:14.96,1:11:17.00,Default,,0,0,0,,Сейра-санды аяймын...
Dialogue: 0,1:11:22.21,1:11:27.26,Default,,0,0,0,,Менің ойымша, Руби Риа-санның сезімін жақсы түсінетін шығар.
Dialogue: 0,1:11:27.92,1:11:31.28,Default,,0,0,0,,Мектеп бітірген сіңлісі ретінде.
Dialogue: 0,1:11:36.98,1:11:39.70,Default,,0,0,0,,Руби-чан айтқандай, Зура!
Dialogue: 0,1:11:39.70,1:11:40.40,Default,,0,0,0,,Келісемін!
Dialogue: 0,1:11:40.93,1:11:41.73,Default,,0,0,0,,Иә!
Dialogue: 0,1:11:43.08,1:11:45.05,Default,,0,0,0,,Олай болса, мен не істеуім керек...
Dialogue: 0,1:11:47.94,1:11:49.11,Default,,0,0,0,,Иә.
Dialogue: 0,1:11:50.09,1:11:52.62,Default,,0,0,0,,Менің ойымша, бұл сізге айту!
Dialogue: 0,1:11:52.62,1:11:53.74,Default,,0,0,0,,Иә.
Dialogue: 0,1:11:54.45,1:11:55.80,Default,,0,0,0,,Біз біргеміз.
Dialogue: 0,1:11:55.80,1:11:57.90,Default,,0,0,0,,Мен әрқашан сенің жаныңда боламын.
Dialogue: 0,1:11:57.90,1:12:01.83,Default,,0,0,0,,Рианың ең үлкен армандарының бірін орындаңыз.
Dialogue: 0,1:12:03.05,1:12:04.60,Default,,0,0,0,,Арманда!
Dialogue: 0,1:12:04.60,1:12:06.51,Default,,0,0,0,,Түсіндім, бұл арман!
Dialogue: 0,1:12:07.40,1:12:10.33,Default,,0,0,0,,Барлығының пікірі бір сияқты!
Dialogue: 0,1:12:13.86,1:12:18.18,Default,,0,0,0,,Риа-чанның орындағысы келген, бірақ орындай алмаған арманы!
Dialogue: 0,1:12:19.45,1:12:20.89,Default,,0,0,0,,Дұрыс!
Dialogue: 0,1:12:20.89,1:12:23.36,Default,,0,0,0,,Оны орындайық! Барлығына!
Dialogue: 0,1:12:24.54,1:12:27.02,Default,,0,0,0,,Мен бірден Сейра-санға айтуым керек!
Dialogue: 0,1:12:47.85,1:12:50.89,Default,,0,0,0,,Апамның асыл арманы.
Dialogue: 0,1:13:01.30,1:13:04.24,Default,,0,0,0,,Мен бұздым...
Dialogue: 0,1:13:08.30,1:13:09.07,Default,,0,0,0,,Әпке...
Dialogue: 0,1:13:12.58,1:13:13.70,Default,,0,0,0,,Әпке!
Dialogue: 0,1:13:18.82,1:13:21.37,Default,,0,0,0,,Әулие Қар жеңіледі.
Dialogue: 0,1:13:21.37,1:13:23.42,Default,,0,0,0,,Ол жеңіске фаворит болды.
Dialogue: 0,1:13:25.46,1:13:27.78,Default,,0,0,0,,Сіз не болатынын ешқашан білмейсіз.
Dialogue: 0,1:13:30.38,1:13:31.85,Default,,0,0,0,,Риа!
Dialogue: 0,1:14:00.36,1:14:01.54,Default,,0,0,0,,Әпке...
Dialogue: 0,1:14:05.18,1:14:07.54,Default,,0,0,0,,Сен неге олайсың?
Dialogue: 0,1:14:09.17,1:14:13.97,Default,,0,0,0,,Олай болса! Live Live! Финал қосымша уақытта ойналады!
Dialogue: 0,1:14:13.97,1:14:15.04,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:15.92,1:14:18.72,Default,,0,0,0,,Екі финалистпен таныстырайық!
Dialogue: 0,1:14:18.72,1:14:19.88,Default,,0,0,0,,Керемет...
Dialogue: 0,1:14:19.88,1:14:21.16,Default,,0,0,0,,Көңіл-күйім көтеріңкі...
Dialogue: 0,1:14:21.16,1:14:22.41,Default,,0,0,0,,Мен жеңілетін сияқтымын...
Dialogue: 0,1:14:22.41,1:14:25.56,Default,,0,0,0,,Ура но Хошиден супернова пайда болды!
Dialogue: 0,1:14:25.56,1:14:29.46,Default,,0,0,0,,Оның финалға бірінші рет өтуіне қарамастан, оның қабілеті жоғары деңгейде!
Dialogue: 0,1:14:29.46,1:14:31.98,Default,,0,0,0,,Мектеп кумирі Аква!
Dialogue: 0,1:14:31.98,1:14:33.99,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:14:34.58,1:14:36.34,Default,,0,0,0,,Және тағы бір жұп!
Dialogue: 0,1:14:36.34,1:14:39.05,Default,,0,0,0,,Солтүстік елден туған супер жұлдыз!
Dialogue: 0,1:14:39.05,1:14:40.78,Default,,0,0,0,,Әулие Қар!
Dialogue: 0,1:14:42.05,1:14:46.40,Default,,0,0,0,,Бұдан былай біздің жеке Лав Лайв! Финал өтеді.
Dialogue: 0,1:14:49.75,1:14:56.72,Default,,0,0,0,,Егер мен финалдық сахнада өнер көрсететін болсам, мен осы костюмді, биді және әнді таңдар едім.
Dialogue: 0,1:15:03.81,1:15:04.93,Default,,0,0,0,,Әпке.
Dialogue: 0,1:15:04.93,1:15:12.15,Default,,0,0,0,,Егер мен Акурспен бәсекеге түсуім керек болса, егер мен финалдық кезеңде тұра алсам,
Dialogue: 0,1:15:13.37,1:15:16.15,Default,,0,0,0,,Мен сізге айтайын деп едім.
Dialogue: 0,1:15:23.38,1:15:24.52,Default,,0,0,0,,Әпке!
Dialogue: 0,1:15:26.70,1:15:28.79,Default,,0,0,0,,Бұл жылайтын уақыт емес.
Dialogue: 0,1:15:29.62,1:15:32.04,Default,,0,0,0,,Бірге алға ұмтылайық, Риа-чан!
Dialogue: 0,1:15:34.14,1:15:35.84,Default,,0,0,0,,Бұзбаңыз.
Dialogue: 0,1:15:36.70,1:15:43.22,Default,,0,0,0,,Руби Риа-чан, Ханамару-чан және Йошико-чанмен кездесуге мүмкіндігі болғандықтан барын сала алды.
Dialogue: 0,1:15:45.05,1:15:47.33,Default,,0,0,0,,Лав Лайв! Бұл ойын емес!
Dialogue: 0,1:15:53.02,1:15:54.30,Default,,0,0,0,,Ән айтайық.
Dialogue: 0,1:15:54.30,1:15:54.88,Default,,0,0,0,,Иә!
Dialogue: 0,1:15:55.77,1:15:58.05,Default,,0,0,0,,Бұл сахнада екі адам,
Dialogue: 0,1:15:58.05,1:15:59.97,Default,,0,0,0,,Аква-пен бар күшіңізді салыңыз!
Dialogue: 0,1:16:11.65,1:16:15.09,Default,,0,0,0,,Жалғыз емес екеніңізге сенімдімін, арманыңызға барыңыз
Dialogue: 0,1:16:15.09,1:16:17.84,Default,,0,0,0,,Екіленіп тұрғанда, ДАЙЫН? ЖЕТ!
Dialogue: 0,1:16:28.77,1:16:31.20,Default,,0,0,0,,Сіз байқаған сияқтысыз ба?
Dialogue: 0,1:16:31.20,1:16:35.70,Default,,0,0,0,,Ішіңіздегі өшпес жарық (Дұрыс!)
Dialogue: 0,1:16:35.70,1:16:42.51,Default,,0,0,0,,Қайда барсам да, Үміт БИІК ҰШАДЫ деген қауырсын
Dialogue: 0,1:16:42.51,1:16:44.86,Default,,0,0,0,,Күш іздесең
Dialogue: 0,1:16:44.86,1:16:49.40,Default,,0,0,0,,Өзіміздің әлсіз тұстарымызды қабыл алайық (МЕНІҢ КҮНІМ!)
Dialogue: 0,1:16:49.40,1:16:54.08,Default,,0,0,0,,Жүрегіңде орын жоқ болса, армандарың сөніп қалуы мүмкін.
Dialogue: 0,1:16:54.08,1:16:55.79,Default,,0,0,0,,Кел, қайта туылайық!
Dialogue: 0,1:16:55.79,1:16:59.22,Default,,0,0,0,,Жаңа бол, ескі қабығыңнан шығып, алға ұмтыл.
Dialogue: 0,1:16:59.22,1:17:02.24,Default,,0,0,0,,Сіз мұны істей аласыз. Сіз жасай аласыз. Келесі орынға жүгіріңіз!
Dialogue: 0,1:17:02.24,1:17:05.65,Default,,0,0,0,,Көбірек (мен билегім келеді!)
Dialogue: 0,1:17:05.65,1:17:09.04,Default,,0,0,0,,Би билейік! (иә!) би! (иә!) Мен билеуді тоқтата алмаймын!!
Dialogue: 0,1:17:09.04,1:17:12.88,Default,,0,0,0,,Сеніңіз! (Сеніңіз!) тағы! (қайтадан!)
Dialogue: 0,1:17:12.88,1:17:15.90,Default,,0,0,0,,Барлығын құшақтап жатқанда
Dialogue: 0,1:17:15.90,1:17:19.77,Default,,0,0,0,,Сеніңіз! (Сеніңіз!) тағы! (қайтадан!)
Dialogue: 0,1:17:19.77,1:17:23.18,Default,,0,0,0,,Қайтадан басталады (ӘНімді АЙҚАЛАҢЫЗ!)
Dialogue: 0,1:17:23.18,1:17:26.60,Default,,0,0,0,,Байыптымын демесең де, көрсететініне сенімдімін.
Dialogue: 0,1:17:26.60,1:17:29.69,Default,,0,0,0,,Қалағанша құмар бол, еркін бол
Dialogue: 0,1:17:29.69,1:17:33.46,Default,,0,0,0,,Сеніңіз! (Сеніңіз!) тағы! (қайтадан!)
Dialogue: 0,1:17:33.46,1:17:37.35,Default,,0,0,0,,Қайтадан басталып жатыр Иә! (Иә иә!
Dialogue: 0,1:17:37.35,1:17:42.10,Default,,0,0,0,,Ах Шытырман оқиға бітпейді Кеттік
Dialogue: 0,1:17:42.10,1:17:44.26,Default,,0,0,0,,3...2...1, Бар!
Dialogue: 0,1:18:08.44,1:18:11.82,Default,,0,0,0,,Бұл сәт ешқашан кетпейді!
Dialogue: 0,1:18:16.12,1:18:22.67,Default,,0,0,0,,Әулие Қар, Риа және менің сезіміміз мәңгі қалады.
Dialogue: 0,1:18:22.67,1:18:26.61,Default,,0,0,0,,Ол Рианың жүрегінде мәңгі сақталады.
Dialogue: 0,1:18:26.61,1:18:30.68,Default,,0,0,0,,Заттар қанша өзгерсе де, олар өзгеріссіз қалады.
Dialogue: 0,1:18:32.72,1:18:35.44,Default,,0,0,0,,...Сондықтан қуудың қажеті жоқ!
Dialogue: 0,1:18:36.57,1:18:38.48,Default,,0,0,0,,Ол нені жеткізгісі келді.
Dialogue: 0,1:18:44.82,1:18:45.78,Default,,0,0,0,,Әпке!
Dialogue: 0,1:19:06.48,1:19:11.01,Default,,0,0,0,,күрсіну. Мектеп кумирлері сөзсіз көңілді!
Dialogue: 0,1:19:11.01,1:19:15.02,Default,,0,0,0,,Бірақ бұл жолы, бұл соңғы рет!
Dialogue: 0,1:19:15.02,1:19:17.64,Default,,0,0,0,,Сонымен! Ақырында айтып берейін!
Dialogue: 0,1:19:17.64,1:19:19.56,Default,,0,0,0,,Біздің ойымыз!
Dialogue: 0,1:19:27.53,1:19:30.74,Default,,0,0,0,,Ах! Қайда жүрсем де сені ұмытпаймын
Dialogue: 0,1:19:30.74,1:19:35.26,Default,,0,0,0,,Ең жарқын әуен
Dialogue: 0,1:19:45.92,1:19:49.22,Default,,0,0,0,,Мен осында мәңгі қалғым келеді
Dialogue: 0,1:19:49.22,1:19:53.67,Default,,0,0,0,,Әркімнің сезімі бір екені сөзсіз
Dialogue: 0,1:19:53.67,1:19:56.19,Default,,0,0,0,,(Бәріміз мәңгі ән айтайық!)
Dialogue: 0,1:19:56.19,1:19:59.77,Default,,0,0,0,,Бірақ алда жол бар.
Dialogue: 0,1:19:59.77,1:20:05.74,Default,,0,0,0,,Әртүрлі болашақ, келесі толқуға
Dialogue: 0,1:20:05.74,1:20:08.56,Default,,0,0,0,,Кездесу/қоштасу
Dialogue: 0,1:20:08.56,1:20:13.49,Default,,0,0,0,,Мен бұл қайталау екенін түсіндім.
Dialogue: 0,1:20:13.49,1:20:18.55,Default,,0,0,0,,Бірақ күліп, Мен сені тағы көремін деп айтамын.
Dialogue: 0,1:20:18.55,1:20:22.39,Default,,0,0,0,,Шын жүректен!
Dialogue: 0,1:20:25.83,1:20:29.28,Default,,0,0,0,,Жарқыраған арман
Dialogue: 0,1:20:29.28,1:20:34.11,Default,,0,0,0,,Жүрегімізде жарқырайды
Dialogue: 0,1:20:34.11,1:20:37.53,Default,,0,0,0,,Ыстық және үлкен «жылтыр»
Dialogue: 0,1:20:37.53,1:20:40.99,Default,,0,0,0,,Енді мен ертеңге қайта бастағым келеді.
Dialogue: 0,1:20:40.99,1:20:44.92,Default,,0,0,0,,Ерекше нәрсе ме? Бірдеңе істе!
Dialogue: 0,1:20:44.92,1:20:50.43,Default,,0,0,0,,Маған бұл не деген қызық! ?
Dialogue: 0,1:20:50.43,1:20:57.22,Default,,0,0,0,,Жаңа арман, жаңа ән, Қосылдық
Dialogue: 0,1:21:18.53,1:21:19.35,Default,,0,0,0,,Керемет...
Dialogue: 0,1:21:20.69,1:21:24.46,Default,,0,0,0,,Мектеп кумирлері шынымен де керемет!
Dialogue: 0,1:21:24.46,1:21:31.85,Default,,0,0,0,,Kono Лав Лайв! Бұл тек біз ғана көре алатындай ысырап!
Dialogue: 0,1:21:34.50,1:21:35.54,Default,,0,0,0,,Чика-чан?
Dialogue: 0,1:21:40.90,1:21:42.04,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,1:21:42.96,1:21:45.69,Default,,0,0,0,,Біздің жаңа акурлар!
Dialogue: 0,1:22:01.78,1:22:04.95,Default,,0,0,0,,Бұл мен білмей тұрып келді.
Dialogue: 0,1:22:04.95,1:22:08.40,Default,,0,0,0,,Сондай алыс жерге
Dialogue: 0,1:22:08.40,1:22:14.66,Default,,0,0,0,,Әй, аспан әрқашан көгілдір
Dialogue: 0,1:22:14.66,1:22:17.97,Default,,0,0,0,,Өйткені ештеңе болған жоқ
Dialogue: 0,1:22:17.97,1:22:21.44,Default,,0,0,0,,Мен бір нәрсені түсінгім келеді
Dialogue: 0,1:22:21.44,1:22:28.71,Default,,0,0,0,,Аа, сен маған жол аштың деп ойлаймын.
Dialogue: 0,1:22:28.71,1:22:39.24,Default,,0,0,0,,Мен ғажайыптардың болатынын білдім.
Dialogue: 0,1:22:39.24,1:22:53.48,Default,,0,0,0,,Мен сол кездегілерге үйреткім келеді.
Dialogue: 0,1:22:53.48,1:22:59.74,Default,,0,0,0,,Сіз бас тартқыңыз келсе, үлкен өзгеріс жасайтын кез келді.
Dialogue: 0,1:22:59.74,1:23:06.15,Default,,0,0,0,,Өйткені ол жерде міндетті түрде мүмкіндік бар.
Dialogue: 0,1:23:06.20,1:23:12.70,Default,,0,0,0,,Жүрегімді күдік тебірентсе де, асыға күтемін.
Dialogue: 0,1:23:12.70,1:23:17.58,Default,,0,0,0,,Жаңбыр тоқтамас деп жүгіріп келдім.
Dialogue: 0,1:23:17.58,1:23:18.74,Default,,0,0,0,,Сол себепті, күн, жаңбыр тоқтамайды, мен жүгіріп келдім.
Dialogue: 0,1:23:18.74,1:23:20.73,Default,,0,0,0,,Егер сіз жоғары қарасаңыз, сіз ыстық күнді көресіз, сондықтан күн сәулесі
Dialogue: 0,1:23:20.73,1:23:23.83,Default,,0,0,0,,Жоғары қарасаң, ыстық күн
Dialogue: 0,1:23:28.98,1:23:35.49,Default,,0,0,0,,Қозғалмай тұрсаңыз, таба алмайсыз. Демалсаңыз да тоқтамаңыз.
Dialogue: 0,1:23:35.49,1:23:46.28,Default,,0,0,0,,Түн батқанда күн аспанда...!
Dialogue: 0,1:23:48.34,1:23:55.74,Default,,0,0,0,,Бұл туралы ойланғаннан кейін, бұл біз Аква сахнасын нөлден бірінші рет жасауымыз мүмкін!
Dialogue: 0,1:23:55.74,1:23:57.01,Default,,0,0,0,,Иә.
Dialogue: 0,1:23:57.01,1:24:00.62,Default,,0,0,0,,Бұл жаңа бастама!
Dialogue: 0,1:24:00.62,1:24:03.10,Default,,0,0,0,,Егер сіз мұны салсаңыз, ол бар!
Dialogue: 0,1:24:03.10,1:24:05.81,Default,,0,0,0,,Мукчан мен басқалары да көңіл көтеріп жатқан сияқты!
Dialogue: 0,1:24:05.81,1:24:06.56,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:06.56,1:24:09.88,Default,,0,0,0,,Мектеп жабылу фестивалінен бері бәріміз бірге бірдеңе жасадық!
Dialogue: 0,1:24:09.88,1:24:12.73,Default,,0,0,0,,Міне, Урамоно өзінің шынайы әлеуетін көрсетеді!
Dialogue: 0,1:24:13.58,1:24:15.92,Default,,0,0,0,,Сіз бұл сахнада ән айтып жатырсыз.
Dialogue: 0,1:24:15.92,1:24:17.62,Default,,0,0,0,,Оны асыға күтіңіз.
Dialogue: 0,1:24:17.62,1:24:19.09,Default,,0,0,0,,Жүйке!
Dialogue: 0,1:24:19.09,1:24:20.48,Default,,0,0,0,,...Шинизура.
Dialogue: 0,1:24:20.48,1:24:22.37,Default,,0,0,0,,Бұл дұрыс. Неліктен?
Dialogue: 0,1:24:22.90,1:24:25.62,Default,,0,0,0,,Мүмкін сәл үлкейіп кеткен шығар.
Dialogue: 0,1:24:25.62,1:24:27.24,Default,,0,0,0,,Марутачи?
Dialogue: 0,1:24:27.24,1:24:28.14,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:32.44,1:24:35.04,Default,,0,0,0,,Чика мен басқалары бірінші үйге бармайды!
Dialogue: 0,1:24:35.04,1:24:35.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:35.59,1:24:37.88,Default,,0,0,0,,Қалғанын біз шешеміз!
Dialogue: 0,1:24:37.88,1:24:41.68,Default,,0,0,0,,Жақсы демалып, жақсы өнер көрсет!
Dialogue: 0,1:24:41.68,1:24:42.78,Default,,0,0,0,,Бірақ!
Dialogue: 0,1:24:42.78,1:24:46.81,Default,,0,0,0,,Жарайды! Бізден әлдеқайда көп!
Dialogue: 0,1:24:46.81,1:24:47.47,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,1:24:53.13,1:24:54.61,Default,,0,0,0,,Міне, осында!
Dialogue: 0,1:24:55.26,1:24:57.81,Default,,0,0,0,,Қасиетті соғыс болмай қоймайды ма...?
Dialogue: 0,1:24:57.81,1:24:59.42,Default,,0,0,0,,Тынышталыңыз Зура!
Dialogue: 0,1:24:59.42,1:25:01.57,Default,,0,0,0,,Цуки-чан, не болды?
Dialogue: 0,1:25:01.57,1:25:05.33,Default,,0,0,0,,Олар сол тікелей бейнені көргеннен кейін келді.
Dialogue: 0,1:25:05.33,1:25:07.95,Default,,0,0,0,,Біздің де қолымыздан бірдеңе келе ме деп ойлаймын.
Dialogue: 0,1:25:07.95,1:25:09.13,Default,,0,0,0,,Алайда,
Dialogue: 0,1:25:09.85,1:25:12.09,Default,,0,0,0,,Қарсы болған жоқ па?
Dialogue: 0,1:25:12.09,1:25:13.33,Default,,0,0,0,,Мен мұны байқадым.
Dialogue: 0,1:25:13.97,1:25:17.46,Default,,0,0,0,,Үйірме жұмыстарын не үшін жасаймыз?
Dialogue: 0,1:25:17.46,1:25:19.12,Default,,0,0,0,,Ата-аналар да.
Dialogue: 0,1:25:19.12,1:25:20.30,Default,,0,0,0,,Не үшін...
Dialogue: 0,1:25:20.30,1:25:22.72,Default,,0,0,0,,Көңілді болу
Dialogue: 0,1:25:22.72,1:25:27.09,Default,,0,0,0,,Барлығына мектеп кумирі болу ұнады.
Dialogue: 0,1:25:27.85,1:25:30.98,Default,,0,0,0,,Біз де байсалды болуымыз керек.
Dialogue: 0,1:25:31.68,1:25:36.01,Default,,0,0,0,,Акур мен Әулие Қар маған мұны түсінді.
Dialogue: 0,1:25:37.17,1:25:38.36,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:25:38.36,1:25:40.13,Default,,0,0,0,,Иә,
Dialogue: 0,1:25:40.13,1:25:42.17,Default,,0,0,0,,Біз де шақырдық!
Dialogue: 0,1:25:42.17,1:25:43.74,Default,,0,0,0,,Сондықтан тартынбаңыз!
Dialogue: 0,1:25:43.74,1:25:46.10,Default,,0,0,0,,Барлығы көмектессін!
Dialogue: 0,1:25:46.10,1:25:47.12,Default,,0,0,0,,Сіз қалай ойлайсыз...?
Dialogue: 0,1:25:47.96,1:25:49.49,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:25:49.49,1:25:52.46,Default,,0,0,0,,Олай болса, бұзылайық!
Dialogue: 0,1:25:53.48,1:25:56.78,Default,,0,0,0,,Не істеу керек? Кішкене болса да жаттығуды қалайсыз ба?
Dialogue: 0,1:25:56.78,1:25:59.17,Default,,0,0,0,,Бұл да жақсы.
Dialogue: 0,1:25:59.17,1:26:00.93,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,1:26:01.62,1:26:06.16,Default,,0,0,0,,Енді ойлап қарасам, Мари мен басқалары мұнда қанша уақыт қалады?
Dialogue: 0,1:26:09.22,1:26:13.02,Default,,0,0,0,,Чика мен басқалардың бастағанын көрген соң, мен тура сол жаққа барамын.
Dialogue: 0,1:26:14.48,1:26:16.65,Default,,0,0,0,,Әр жерде
Dialogue: 0,1:26:16.65,1:26:17.69,Default,,0,0,0,,...
Dialogue: 0,1:26:17.69,1:26:19.25,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,1:26:19.25,1:26:20.76,Default,,0,0,0,,Мен солай деп ойлаймын.
Dialogue: 0,1:26:21.65,1:26:22.98,Default,,0,0,0,,Бұған дейін,
Dialogue: 0,1:26:22.98,1:26:24.61,Default,,0,0,0,,Соңында неге бәріміз бармаймыз?
Dialogue: 0,1:26:24.61,1:26:25.40,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:26.18,1:26:27.74,Default,,0,0,0,,Бұл тоғыз адам.
Dialogue: 0,1:26:29.77,1:26:32.91,Default,,0,0,0,,Ойлап қарасам, аялдама ғайып болады.
Dialogue: 0,1:26:32.91,1:26:36.42,Default,,0,0,0,,Мектеп жабылса, оны пайдаланатын ешкім болмайды.
Dialogue: 0,1:26:36.42,1:26:38.92,Default,,0,0,0,,Көп күтсең, қараңғы түседі.
Dialogue: 0,1:26:41.97,1:26:43.98,Default,,0,0,0,,Мен ностальгиялық сезінемін!
Dialogue: 0,1:26:45.70,1:26:48.66,Default,,0,0,0,,Мектеп бітіру рәсімінен бері аз ғана уақыт өтті.
Dialogue: 0,1:26:50.09,1:26:52.85,Default,,0,0,0,,Бұл мен күнде жүретін жол.
Dialogue: 0,1:26:53.93,1:26:57.13,Default,,0,0,0,,Біраз уақыт келмесем де сағынышқа толы болармын.
Dialogue: 0,1:27:03.53,1:27:06.86,Default,,0,0,0,,Шынында да, көп нәрсе болды.
Dialogue: 0,1:27:06.86,1:27:09.48,Default,,0,0,0,,Күн сайын қызу болды!
Dialogue: 0,1:27:09.48,1:27:12.44,Default,,0,0,0,,Бұл жандыдан гөрі шулырақ.
Dialogue: 0,1:27:12.44,1:27:15.37,Default,,0,0,0,,Йошико-чан басқа адамдар туралы айта алмайды.
Dialogue: 0,1:27:15.37,1:27:19.13,Default,,0,0,0,,Не! Тіпті Зурамару да, басқалары да өте шулы болды!
Dialogue: 0,1:27:19.69,1:27:21.25,Default,,0,0,0,,Бірақ бұл қызықты болды!
Dialogue: 0,1:27:30.66,1:27:32.60,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,1:27:32.60,1:27:35.97,Default,,0,0,0,,Енді? Қызық, мені шақырды ма? Мектепке.
Dialogue: 0,1:27:35.97,1:27:39.06,Default,,0,0,0,,Бірақ оның дұрыс болғанына көңілім толды.
Dialogue: 0,1:27:40.94,1:27:41.69,Default,,0,0,0,,Ах,
Dialogue: 0,1:27:43.02,1:27:44.10,Default,,0,0,0,,Ашық па?
Dialogue: 0,1:27:55.26,1:27:56.20,Default,,0,0,0,,Жарайды
Dialogue: 0,1:27:56.80,1:27:58.13,Default,,0,0,0,,Ол кетпейді!
Dialogue: 0,1:27:59.36,1:28:01.88,Default,,0,0,0,,Ура но Хоши да. Бұл мектеп ғимараты да.
Dialogue: 0,1:28:02.54,1:28:08.88,Default,,0,0,0,,Жер де. Сондай-ақ кітапхана. Төбесі де. Сондай-ақ клуб бөлмесі.
Dialogue: 0,1:28:08.88,1:28:13.28,Default,,0,0,0,,Теңіз де. Құмды жағажайлар да. Автобус аялдамасы да.
Dialogue: 0,1:28:13.28,1:28:18.80,Default,,0,0,0,,Күн де. Кемелер де. Аспан да. Таулар да.
Dialogue: 0,1:28:18.80,1:28:19.89,Default,,0,0,0,,Қала да.
Dialogue: 0,1:28:23.13,1:28:24.90,Default,,0,0,0,,Ақурлар да.
Dialogue: 0,1:28:30.29,1:28:31.07,Default,,0,0,0,,Үйге қайтайық!
Dialogue: 0,1:28:35.29,1:28:38.00,Default,,0,0,0,,Барлығы осында.
Dialogue: 0,1:28:38.00,1:28:40.00,Default,,0,0,0,,Бұл жерде қалады.
Dialogue: 0,1:28:40.72,1:28:43.58,Default,,0,0,0,,Ол ешқашан 0 болмайды.
Dialogue: 0,1:28:43.58,1:28:49.59,Default,,0,0,0,,Ол біздің ішімізде қалады және әрқашан бізбен бірге болады. Біз мәңгі бірге жүреміз.
Dialogue: 0,1:28:49.59,1:28:53.59,Default,,0,0,0,,Мұның бәрі біздің бір бөлігіміз.
Dialogue: 0,1:28:54.17,1:28:55.17,Default,,0,0,0,,Сол себепті!
Dialogue: 0,1:28:57.56,1:28:59.85,Default,,0,0,0,,Ол әрқашан 0-ден басталады!
Dialogue: 0,1:29:11.44,1:29:16.12,Default,,0,0,0,,Бастау, қадамдап алға жылжу, құру,
Dialogue: 0,1:29:18.68,1:29:21.62,Default,,0,0,0,,Бірақ мен оның 0-ге оралғанын байқаған кезде,
Dialogue: 0,1:29:24.25,1:29:27.13,Default,,0,0,0,,Сонда да мен оларды бір-бірлеп жинадым.
Dialogue: 0,1:29:29.58,1:29:34.08,Default,,0,0,0,,Істің қалай болатынына сеніңіз,
Dialogue: 0,1:29:35.21,1:29:38.14,Default,,0,0,0,,Дегенмен шындық қатал,
Dialogue: 0,1:29:44.00,1:29:47.86,Default,,0,0,0,,Ең көп жасағым келген тілегім орындала алмады,
Dialogue: 0,1:29:49.52,1:29:52.65,Default,,0,0,0,,Мен қайтадан 0-ге оралғандай болдым,
Dialogue: 0,1:29:55.44,1:29:59.72,Default,,0,0,0,,Ішімізде көп қазына туады,
Dialogue: 0,1:30:10.78,1:30:11.80,Default,,0,0,0,,Бұл
Dialogue: 0,1:30:12.92,1:30:15.14,Default,,0,0,0,,Өйткені ол ешқашан жойылмайтын нәрсе,
Dialogue: 0,1:30:56.37,1:30:58.51,Default,,0,0,0,,Көк құс
Dialogue: 0,1:30:58.51,1:31:01.21,Default,,0,0,0,,Мен кемпірқосақтың үстінен ұша алатындықтан,
Dialogue: 0,1:31:01.21,1:31:04.41,Default,,0,0,0,,Әрине, біз мұны істей аламыз!
Dialogue: 0,1:31:27.96,1:31:30.46,Default,,0,0,0,,Барлығына! Сәлем!
Dialogue: 0,1:31:30.46,1:31:31.16,Default,,0,0,0,,Аква-тың жанды орындауы!
Dialogue: 0,1:31:31.16,1:31:32.41,Default,,0,0,0,,Ruby және басқалары Аква тікелей шоуын өткізбекші!
Dialogue: 0,1:31:32.41,1:31:33.05,Default,,0,0,0,,Ура но Хоши...
Dialogue: 0,1:31:33.05,1:31:34.46,Default,,0,0,0,,Байқап көріңіз!
Dialogue: 0,1:31:34.46,1:31:39.47,Default,,0,0,0,,Түпнұсқа! Бұл Uranohoshi қыздар орта мектебінің мектеп кумирі Аква!
Dialogue: 0,1:31:40.00,1:31:44.92,Default,,0,0,0,,Бұдан былай біз оңтүстік шығыстағы осы ерекше сахнада тікелей эфирде өнер көрсететін боламыз!
Dialogue: 0,1:31:45.86,1:31:50.48,Default,,0,0,0,,Ruby және басқалары, жаңа Аква-ды қараңыз!
Dialogue: 0,1:31:51.01,1:31:52.80,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,1:31:59.82,1:32:02.66,Default,,0,0,0,,Келіңіздер! Қолымыздан келгенше ән салайық!
Dialogue: 0,1:32:02.66,1:32:04.26,Default,,0,0,0,,Барлығы үшін!
Dialogue: 0,1:32:04.26,1:32:05.58,Default,,0,0,0,,Бар жүрегіммен!
Dialogue: 0,1:32:05.58,1:32:07.05,Default,,0,0,0,,Оны резонансқа айналдырайық!
Dialogue: 0,1:32:07.05,1:32:08.56,Default,,0,0,0,,Бұл ән!
Dialogue: 0,1:32:08.56,1:32:10.58,Default,,0,0,0,,Біздің бастауымыздың әні!
Dialogue: 0,1:32:12.59,1:32:13.79,Default,,0,0,0,,1!
Dialogue: 0,1:32:13.79,1:32:15.05,Default,,0,0,0,,2
Dialogue: 0,1:32:15.05,1:32:16.30,Default,,0,0,0,,3!
Dialogue: 0,1:32:16.30,1:32:17.55,Default,,0,0,0,,4!
Dialogue: 0,1:32:17.55,1:32:18.76,Default,,0,0,0,,5!
Dialogue: 0,1:32:18.76,1:32:20.13,Default,,0,0,0,,6!
Dialogue: 0,1:32:21.89,1:32:23.10,Default,,0,0,0,,7!
Dialogue: 0,1:32:23.10,1:32:24.35,Default,,0,0,0,,8!
Dialogue: 0,1:32:24.35,1:32:25.47,Default,,0,0,0,,9!
Dialogue: 0,1:32:31.57,1:32:33.02,Default,,0,0,0,,...Сіз естідіңіз бе?
Dialogue: 0,1:32:39.56,1:32:41.49,Default,,0,0,0,,1-ден әрі қарай!
Dialogue: 0,1:32:41.49,1:32:45.99,Default,,0,0,0,,Барлығымен бірге! Болашаққа қарай!
Dialogue: 0,1:32:46.32,1:32:48.50,Default,,0,0,0,,Аква! !
Dialogue: 0,1:32:48.50,1:32:55.25,Default,,0,0,0,,Саншин!
Dialogue: 0,1:33:12.20,1:33:20.62,Default,,0,0,0,,Әрбір есте сақтау маңызды
Dialogue: 0,1:33:20.62,1:33:27.52,Default,,0,0,0,,Бұл біздің мәңгілік әдемі қазынамыз.
Dialogue: 0,1:33:27.52,1:33:30.91,Default,,0,0,0,,Қанша жерден алыс болса да
Dialogue: 0,1:33:30.91,1:33:35.94,Default,,0,0,0,,Кәдімгі пейзажды сіз міндетті түрде көресіз
Dialogue: 0,1:33:35.94,1:33:42.44,Default,,0,0,0,,Өйткені ол менің жүрегімде сақталған
Dialogue: 0,1:33:42.44,1:33:45.09,Default,,0,0,0,,Танысқыңыз келсе
Dialogue: 0,1:33:45.09,1:33:48.92,Default,,0,0,0,,Көзіңді жұмып, бәрін шақыр
Dialogue: 0,1:33:48.92,1:33:53.97,Default,,0,0,0,,Сонда сіз бұл әнді естисіз
Dialogue: 0,1:33:53.97,1:34:00.64,Default,,0,0,0,,Эй, келесі қайда? бірге барайық
Dialogue: 0,1:34:00.64,1:34:08.81,Default,,0,0,0,,Ұмытпаймын Ұмытпаймын Арманым болса
Dialogue: 0,1:34:08.81,1:34:16.02,Default,,0,0,0,,Сіз және біз өзіміз қалаған адам бола аламыз.
Dialogue: 0,1:34:16.02,1:34:23.92,Default,,0,0,0,,Ұмытпа, ұмытпа, арманда
Dialogue: 0,1:34:23.92,1:34:32.16,Default,,0,0,0,,Ертеңгі күн бүгіннен гөрі арманға жақын болады.
Dialogue: 0,1:34:48.19,1:34:56.58,Default,,0,0,0,,Әр адам әртүрлі болғанымен, олар бірдей болды.
Dialogue: 0,1:34:56.58,1:35:03.55,Default,,0,0,0,,Мен осы сәтті бағалаймын
Dialogue: 0,1:35:03.55,1:35:09.99,Default,,0,0,0,,Ешқашан өшпейтін тамаша оқиға
Dialogue: 0,1:35:09.99,1:35:14.38,Default,,0,0,0,,Біз мұны барлығымен бірге жасай алдық.
Dialogue: 0,1:35:14.38,1:35:18.47,Default,,0,0,0,,Керемет, рахмет!
Dialogue: 0,1:35:18.47,1:35:21.13,Default,,0,0,0,,Мен сені көргім келеді
Dialogue: 0,1:35:21.13,1:35:24.95,Default,,0,0,0,,Білемін, бәріне телефон соғым келеді.
Dialogue: 0,1:35:24.95,1:35:29.98,Default,,0,0,0,,Мен бұл әнді әрқашан тыңдаймын
Dialogue: 0,1:35:29.98,1:35:36.61,Default,,0,0,0,,Сіз әлі де жүгіре аласыз. Бірге барайық.
Dialogue: 0,1:35:36.61,1:35:44.80,Default,,0,0,0,,Тоқтамайтын ыстық жүрек, тоқтамас
Dialogue: 0,1:35:44.80,1:35:52.02,Default,,0,0,0,,Сіз және біз байланыста боламыз.
Dialogue: 0,1:35:52.02,1:35:59.95,Default,,0,0,0,,Тоқтамайды Тоқтамайды Қызып барады
Dialogue: 0,1:35:59.95,1:36:08.67,Default,,0,0,0,,Жаңа жылтырға қол созайық
Dialogue: 0,1:36:24.17,1:36:30.64,Default,,0,0,0,,Мен әлі жетілмегенмін
Dialogue: 0,1:36:30.64,1:36:43.79,Default,,0,0,0,,Біз алға жылжуымыз керек, тек осыны істеу керек, солай ма? Болашаққа! !
Dialogue: 0,1:36:43.79,1:36:51.98,Default,,0,0,0,,Ұмытпаймын Ұмытпаймын Арманым болса
Dialogue: 0,1:36:51.98,1:36:59.26,Default,,0,0,0,,Сіз және біз өзіміз қалаған адам бола аламыз.
Dialogue: 0,1:36:59.26,1:37:07.15,Default,,0,0,0,,Ұмытпа, ұмытпа, арманда
Dialogue: 0,1:37:07.15,1:37:14.56,Default,,0,0,0,,Ертеңгі күн бүгіннен гөрі арманға жақын болады.
Dialogue: 0,1:37:14.57,1:37:22.74,Default,,0,0,0,,Тоқтамас ыстық жүрек, тоқтамас
Dialogue: 0,1:37:22.74,1:37:29.95,Default,,0,0,0,,Сіз және біз байланыста боламыз.
Dialogue: 0,1:37:29.95,1:37:37.88,Default,,0,0,0,,Тоқтамайды Тоқтамайды Қызып барады
Dialogue: 0,1:37:37.88,1:37:46.83,Default,,0,0,0,,Жаңа жылтырға қол созайық
Dialogue: 0,1:39:09.43,1:39:10.56,Default,,0,0,0,,Жылдам, жылдам!
Dialogue: 0,1:39:10.56,1:39:12.17,Default,,0,0,0,,Мектепке қабылдау сыйы ретінде маған берілген тау велосипеді
Dialogue: 0,1:39:13.78,1:39:15.76,Default,,0,0,0,,Міне, келді!
Dialogue: 0,1:39:15.76,1:39:18.80,Default,,0,0,0,,Мен кішкентай кезімде теңізге шомылатынмын.
Dialogue: 0,1:39:18.80,1:39:20.69,Default,,0,0,0,,Олай болса, мұнда не үшін келдің?
Dialogue: 0,1:39:20.69,1:39:23.67,Default,,0,0,0,,Бұл киелі жер, солай ма? Қасиетті жер.
Dialogue: 0,1:39:23.67,1:39:24.83,Default,,0,0,0,,Қасиетті жер?
Dialogue: 0,1:39:24.83,1:39:29.94,Default,,0,0,0,,Иә? Сіз өткен күні Нумазудың тікелей эфирін көрмедіңіз бе?
Dialogue: 0,1:39:30.86,1:39:32.00,Default,,0,0,0,,I,
Dialogue: 0,1:39:32.00,1:39:36.24,Default,,0,0,0,,Мен мектеп оқушысы болған кезде міндетті түрде мектептің кумир клубына қатысамын!
Dialogue: 0,1:39:37.29,1:39:38.68,Default,,0,0,0,,Қайтадан басталды.
Dialogue: 0,1:39:38.68,1:39:41.14,Default,,0,0,0,,Барлығы сондай жарқырап тұрды...
Dialogue: 0,1:39:42.10,1:39:44.40,Default,,0,0,0,,Мен де жарқырағым келеді!
Dialogue: 0,1:39:45.93,1:39:47.08,Default,,0,0,0,,Мен көмектесе алмаймын.
Dialogue: 0,1:39:48.02,1:39:50.08,Default,,0,0,0,,Сонымен аты кім?
Dialogue: 0,1:39:50.08,1:39:53.03,Default,,0,0,0,,Иә, аты...
