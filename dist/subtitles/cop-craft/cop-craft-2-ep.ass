Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 1,0:01:32.15,0:01:35.28,Default,,0,0,0,,Қала шамдары миллион долларды қалайды
Dialogue: 1,0:01:35.45,0:01:38.51,Default,,0,0,0,,Ұзақ атсаң, бұл жұмақ
Dialogue: 1,0:01:38.63,0:01:42.19,Default,,0,0,0,,Мұқият қарасаңыз
Dialogue: 1,0:01:42.22,0:01:42.22,Default,,0,0,0,,Қаңқаларға толы тас жол
Dialogue: 1,0:01:46.02,0:01:49.21,Default,,0,0,0,,Қиылыста айқайлаған қала жігіттері
Dialogue: 1,0:01:49.40,0:01:52.52,Default,,0,0,0,,Біреудің мәселесі сияқты үнсіздік
Dialogue: 1,0:01:52.52,0:01:59.08,Default,,0,0,0,,Ұлы қала жақсыны да, жаманды да жұтады.
Dialogue: 1,0:01:59.29,0:02:05.74,Default,,0,0,0,,Бауырластар әлемі біткенше біз қанша жүреміз?
Dialogue: 1,0:02:05.74,0:02:10.07,Default,,0,0,0,,Бұл қолда не қалды?
Dialogue: 1,0:02:10.07,0:02:13.66,Default,,0,0,0,,Өлгенше күресейік
Dialogue: 1,0:02:14.40,0:02:19.17,Default,,0,0,0,,Қала құрылыс пен қиратумен айналысуда.
Dialogue: 1,0:02:19.17,0:02:22.37,Default,,0,0,0,,Бұл темір зат сияқты
Dialogue: 1,0:02:22.61,0:02:29.49,Default,,0,0,0,,Адамның қалауы түріне айналды
Dialogue: 1,0:02:29.61,0:02:33.20,Default,,0,0,0,,Үндетпе, тым қатты.
Dialogue: 1,0:02:33.20,0:02:36.47,Default,,0,0,0,,Менің қалағаным бір ғана
Dialogue: 1,0:02:36.59,0:02:44.52,Default,,0,0,0,,Осы жерде екенін мойындаңыз, Парадисо
Dialogue: 1,0:02:46.54,0:02:49.37,Default,,0,0,0,,Парадисо
Dialogue: 0,0:00:17.25,0:00:18.34,Default,,0,0,0,,Мен өлі адаммын!
Dialogue: 0,0:00:18.34,0:00:19.01,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:00:22.54,0:00:24.20,Default,,0,0,0,,Неге әуре! Неге әуре!
Dialogue: 0,0:00:26.25,0:00:27.02,Default,,0,0,0,,Бұл карта сәл ақымақтай көрінбей ме?
Dialogue: 0,0:00:27.02,0:00:28.37,Default,,0,0,0,,Бұл жерден қозғалма!
Dialogue: 0,0:00:28.37,0:00:30.29,Default,,0,0,0,,Жоқ, менмін!
Dialogue: 0,0:00:30.29,0:00:32.08,Default,,0,0,0,,Тек ештеңе істеме!
Dialogue: 0,0:00:49.70,0:00:51.16,Default,,0,0,0,,Идиот! Жасыру!
Dialogue: 0,0:01:00.79,0:01:03.12,Default,,0,0,0,,Кариаена аралы Сан-Тереза қаласы
Dialogue: 0,0:01:03.12,0:01:07.58,Default,,0,0,0,,Бұл қала жер бетіндегі бөтен әлемге апаратын қақпа.
Dialogue: 0,0:01:07.58,0:01:12.41,Default,,0,0,0,,Әртүрлі этникалық топтар мен әртүрлі мәдениеттер, бар және жоқтар
Dialogue: 0,0:01:12.41,0:01:16.66,Default,,0,0,0,,Алайда сол бейберекеттіктің көлеңкесінде көптеген қылмыстар жасырынып жатты.
Dialogue: 0,0:01:16.66,0:01:19.45,Default,,0,0,0,,Осы ауыр қылмыстармен күресетін детективтер
Dialogue: 0,0:01:19.45,0:01:22.33,Default,,0,0,0,,Сан Тереза қалалық полиция бөлімінде болған
Dialogue: 0,0:02:53.66,0:02:58.00,Default,,0,0,0,,Кенеттен айтпа... Бұл Дон Ки Хоте.
Dialogue: 0,0:02:58.00,0:03:01.66,Default,,0,0,0,,Оны ұстап алып, тұншықтырып өлтіру деген жоқ па?
Dialogue: 0,0:03:04.41,0:03:06.41,Default,,0,0,0,,Бірдеңе айт!
Dialogue: 0,0:03:06.41,0:03:09.25,Default,,0,0,0,,Бұл адамды Мирди басқарды.
Dialogue: 0,0:03:09.25,0:03:13.33,Default,,0,0,0,,Мен оны қолға түсірсем де, одан ештеңе ала алмас едім.
Dialogue: 0,0:03:13.33,0:03:14.54,Default,,0,0,0,,Милди?
Dialogue: 0,0:03:14.54,0:03:18.25,Default,,0,0,0,,Бұл әдіс, өлілерді манипуляциялау техникасы.
Dialogue: 0,0:03:18.25,0:03:23.79,Default,,0,0,0,,Бұл адамды зұлым Латена жеп, тірі кезінде өлі адамға айналды.
Dialogue: 0,0:03:23.79,0:03:27.50,Default,,0,0,0,,Сіз оны қандай да бір күдікті заклинание үшін кінәлағыңыз келе ме?
Dialogue: 0,0:03:27.50,0:03:28.54,Default,,0,0,0,,Не?
Dialogue: 0,0:03:28.54,0:03:30.58,Default,,0,0,0,,Тергеуге кедергі жасау.
Dialogue: 0,0:03:30.58,0:03:34.91,Default,,0,0,0,,Сол ертегі туралы біреу тексерсе, қиналатын адамдар бар.
Dialogue: 0,0:03:34.91,0:03:37.08,Default,,0,0,0,,Олар сені жібермеді ме?
Dialogue: 0,0:03:37.08,0:03:38.20,Default,,0,0,0,,Мен есімде сақтамасам да,
Dialogue: 0,0:03:38.20,0:03:40.00,Default,,0,0,0,,Бұл нені білдіреді
Dialogue: 0,0:03:40.00,0:03:43.33,Default,,0,0,0,,Қанша қалталы ақша алғаныңызды білмеймін.
Dialogue: 0,0:03:44.79,0:03:48.25,Default,,0,0,0,,Бұл бірінші және соңғы ескерту, Ке Иматуба.
Dialogue: 0,0:03:48.25,0:03:52.08,Default,,0,0,0,,Маған енді мұндай құрметсіздік жасама.
Dialogue: 0,0:03:52.08,0:03:54.20,Default,,0,0,0,,Келесі жолы мен сені өлтіремін, мен байсалдымын.
Dialogue: 0,0:03:54.20,0:03:55.83,Default,,0,0,0,,Эй, түсіндім.
Dialogue: 0,0:03:59.00,0:04:03.87,Default,,0,0,0,,Мен сияқты бейшараның сөзі сізді қатты мазалады ма?
Dialogue: 0,0:04:03.87,0:04:04.91,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:04:04.91,0:04:05.95,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:04:14.75,0:04:17.50,Default,,0,0,0,,Эй... Мен сенен бірдеңе сұрайын деп едім.
Dialogue: 0,0:04:17.50,0:04:18.45,Default,,0,0,0,,Не?
Dialogue: 0,0:04:18.45,0:04:20.33,Default,,0,0,0,,Хошиді ұстауға шындап кірісесіз бе?
Dialogue: 0,0:04:20.33,0:04:22.45,Default,,0,0,0,,Сен ертегіні қайтарғың келеді, солай ма?
Dialogue: 0,0:04:22.45,0:04:23.54,Default,,0,0,0,,Әрине.
Dialogue: 0,0:04:23.54,0:04:25.87,Default,,0,0,0,,Негізі мен де.
Dialogue: 0,0:04:25.87,0:04:31.20,Default,,0,0,0,,Бірақ біз неге бір-бірімізге айқайлап, бір-бірімізге қару сілтейміз?
Dialogue: 0,0:04:36.37,0:04:37.95,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:04:37.95,0:04:41.12,Default,,0,0,0,,Одан да бұл жігітті айла-шарғы жасап жатыр еді... жақсы, түсіндім.
Dialogue: 0,0:04:41.12,0:04:44.66,Default,,0,0,0,,Мені кеше дәл осындай жігіт өлтіре жаздады.
Dialogue: 0,0:04:44.66,0:04:47.70,Default,,0,0,0,,Не? Неге ертерек айтпадың?
Dialogue: 0,0:04:47.70,0:04:51.12,Default,,0,0,0,,Мен сенің анаң емес екенімді білесің бе?
Dialogue: 0,0:05:01.16,0:05:03.62,Default,,0,0,0,,Кэй, қорытындыларыңызбен бөліскіңіз келе ме?
Dialogue: 0,0:05:03.62,0:05:05.50,Default,,0,0,0,,Мен оны оқып шықтым, Сесиль.
Dialogue: 0,0:05:05.50,0:05:08.25,Default,,0,0,0,,Мен бұл жігіттердің ортақ қасиеттерін білгім келеді.
Dialogue: 0,0:05:08.25,0:05:09.87,Default,,0,0,0,,оңай
Dialogue: 0,0:05:09.87,0:05:13.20,Default,,0,0,0,,Сіздің серіктесіңізді өлтірген осы адаммен
Dialogue: 0,0:05:13.20,0:05:16.37,Default,,0,0,0,,Бұл сені өлтірмек болған адам
Dialogue: 0,0:05:16.37,0:05:19.33,Default,,0,0,0,,Өлмес бұрын екеуі де... өлген.
Dialogue: 0,0:05:19.33,0:05:21.37,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:05:21.37,0:05:24.70,Default,,0,0,0,,Қандағы оттегі мен сүт қышқылының деңгейіне тоқталайық.
Dialogue: 0,0:05:24.70,0:05:28.83,Default,,0,0,0,,Сіз оқ атқан және клиникалық өлі болуы керек адам.
Dialogue: 0,0:05:28.83,0:05:31.16,Default,,0,0,0,,Ол қандай да бір себептермен қозғала береді
Dialogue: 0,0:05:31.16,0:05:34.08,Default,,0,0,0,,Сонда ол шынымен өлі санға айналады.
Dialogue: 0,0:05:34.08,0:05:35.83,Default,,0,0,0,,Бізге ортақ нәрсе осы
Dialogue: 0,0:05:35.83,0:05:37.79,Default,,0,0,0,,...Зомби сияқты бірдеңе ме?
Dialogue: 0,0:05:37.79,0:05:41.70,Default,,0,0,0,,Мен білмеймін, өйткені мен зомбидің анықтамасын білмеймін.
Dialogue: 0,0:05:41.70,0:05:44.16,Default,,0,0,0,,Дәрілік заттың байқалатын реакциялары жоқ
Dialogue: 0,0:05:44.16,0:05:46.45,Default,,0,0,0,,Ол ішімдік пен темекіні ұнататын сияқты.
Dialogue: 0,0:05:46.45,0:05:47.91,Default,,0,0,0,,Дені сау дерлік.
Dialogue: 0,0:05:47.91,0:05:49.70,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:05:49.70,0:05:52.45,Default,,0,0,0,,Мм... бұл жас ханым кім?
Dialogue: 0,0:05:52.45,0:05:53.91,Default,,0,0,0,,Тирана Экседирика
Dialogue: 0,0:05:53.91,0:05:55.37,Default,,0,0,0,,Милвуар сері
Dialogue: 0,0:05:55.37,0:05:59.08,Default,,0,0,0,,Олар басқа дүниенің тұтынушылары.
Dialogue: 0,0:05:59.08,0:06:00.91,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:06:00.91,0:06:04.16,Default,,0,0,0,,Ол сиқыр іздеп жүрген сияқты.
Dialogue: 0,0:06:04.16,0:06:05.41,Default,,0,0,0,,Kay?
Dialogue: 0,0:06:05.41,0:06:08.00,Default,,0,0,0,,Ол бетті жасама, мен еркекпін.
Dialogue: 0,0:06:08.00,0:06:09.54,Default,,0,0,0,,Бұл жігітпен де солай.
Dialogue: 0,0:06:09.54,0:06:11.62,Default,,0,0,0,,Латенаның жағымсыз иісі бар.
Dialogue: 0,0:06:11.62,0:06:12.87,Default,,0,0,0,,Латена дегеніміз не?
Dialogue: 0,0:06:12.87,0:06:15.54,Default,,0,0,0,,Латена - Латена.
Dialogue: 0,0:06:15.54,0:06:18.41,Default,,0,0,0,,Бұл сиқырлы қуат көзі немесе бір нәрсе сияқты.
Dialogue: 0,0:06:18.41,0:06:19.83,Default,,0,0,0,,Мен де түсінбеймін.
Dialogue: 0,0:06:19.83,0:06:22.95,Default,,0,0,0,,Жиренішті өңдеуден өткен ертегі Латена.
Dialogue: 0,0:06:22.95,0:06:26.87,Default,,0,0,0,,Бұл адамдар оған үнемі ұшырап, өлді.
Dialogue: 0,0:06:28.79,0:06:33.58,Default,,0,0,0,,Мүмкін сіз есірткіні меңзеп тұрған шығарсыз? Әлемде жасалған семани...
Dialogue: 0,0:06:33.58,0:06:37.58,Default,,0,0,0,,Ертегі шаңы? Бұл жігіттер нашақор ма?
Dialogue: 0,0:06:37.58,0:06:40.75,Default,,0,0,0,,Өлген адамды нашақор деп айтқыңыз келсе, иә.
Dialogue: 0,0:06:40.75,0:06:44.00,Default,,0,0,0,,Марзаниттер өлілерді басқару қабілетіне ие.
Dialogue: 0,0:06:44.00,0:06:46.33,Default,,0,0,0,,Тест айтпайды.
Dialogue: 0,0:06:46.33,0:06:48.58,Default,,0,0,0,,Ол дәрі жұмбақтарға толы.
Dialogue: 0,0:06:48.58,0:06:51.79,Default,,0,0,0,,Ол перілерден жасалғандықтан.
Dialogue: 0,0:06:51.79,0:06:54.33,Default,,0,0,0,,Асыл пері...
Dialogue: 0,0:06:54.33,0:06:56.75,Default,,0,0,0,,Сұмдық адамдар
Dialogue: 0,0:06:56.75,0:06:59.66,Default,,0,0,0,,-да? Сіз сиқырды қолдана аласыз ба?
Dialogue: 0,0:06:59.66,0:07:01.75,Default,,0,0,0,,Милди оны аздап пайдалана алады.
Dialogue: 0,0:07:01.75,0:07:06.08,Default,,0,0,0,,Содан кейін полиция иті сияқты Латена иісіне еріңіз.
Dialogue: 0,0:07:06.08,0:07:09.54,Default,,0,0,0,,Сіздің қиялыңыз жоқ сияқты, солай ма? Кей Иматуба
Dialogue: 0,0:07:09.54,0:07:12.20,Default,,0,0,0,,Милди керемет, бірақ құдіретті емес
Dialogue: 0,0:07:12.20,0:07:14.71,Default,,0,0,0,,Оны бейшара басына соғыңыз.
Dialogue: 0,0:07:14.71,0:07:19.00,Default,,0,0,0,,Әй, әлгі асыл, түкке тұрғысыз сөздер бағаланады.
Dialogue: 0,0:07:19.00,0:07:22.25,Default,,0,0,0,,Иә? Сіздердің қарым-қатынастарыңыз жақсы емес пе?
Dialogue: 0,0:07:22.25,0:07:25.33,Default,,0,0,0,,Егер солай көрінсе, солай болуы керек.
Dialogue: 0,0:07:25.33,0:07:29.70,Default,,0,0,0,,Бұл адамды ұнататын адам бар ма?
Dialogue: 0,0:07:29.70,0:07:31.12,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:07:33.45,0:07:34.45,Default,,0,0,0,,Kay?
Dialogue: 0,0:07:35.75,0:07:36.91,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:37.70,0:07:39.16,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:07:40.70,0:07:42.33,Default,,0,0,0,,Маған кез келген уақытта қоңырау шалыңыз!
Dialogue: 0,0:07:42.33,0:07:44.45,Default,,0,0,0,,Ах, рахмет
Dialogue: 0,0:07:46.45,0:07:48.08,Default,,0,0,0,,Не? Қазіргі әңгіме
Dialogue: 0,0:07:48.08,0:07:49.25,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:07:49.25,0:07:52.12,Default,,0,0,0,,Жоқ, мен қызықпын, айтыңызшы.
Dialogue: 0,0:07:52.12,0:07:53.52,Default,,0,0,0,,Бұл менің бұрынғы қызым.
Dialogue: 0,0:07:53.70,0:07:56.00,Default,,0,0,0,,Иә? Мотокано дегеніміз не?
Dialogue: 0,0:07:56.00,0:07:57.20,Default,,0,0,0,,Шулы
Dialogue: 0,0:07:58.33,0:08:01.75,Default,,0,0,0,,Мәселе - шабуылдың уақыты.
Dialogue: 0,0:08:01.75,0:08:05.33,Default,,0,0,0,,Альварес бақылауда болды ма? Ағып кету болды ма?
Dialogue: 0,0:08:05.33,0:08:06.79,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:08:06.79,0:08:09.25,Default,,0,0,0,,Жұлдыздар қанша болса, сонша мүмкіндік бар.
Dialogue: 0,0:08:09.25,0:08:13.58,Default,,0,0,0,,Алайда... сіз бұл батыл рыцарь әйелді алып тастай аласыз.
Dialogue: 0,0:08:13.58,0:08:16.29,Default,,0,0,0,,Өйткені, бұл жігіт телефон соғуды да білмейді.
Dialogue: 0,0:08:16.29,0:08:18.20,Default,,0,0,0,,Білемін, кітаптан оқыдым.
Dialogue: 0,0:08:18.20,0:08:22.50,Default,,0,0,0,,Шынымен! Сіз сондай білімдісіз.
Dialogue: 0,0:08:22.50,0:08:24.04,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:08:24.04,0:08:27.37,Default,,0,0,0,,Сондықтан мен минимумға дейін есеп беруді жалғастырамын.
Dialogue: 0,0:08:27.37,0:08:30.70,Default,,0,0,0,,Жарайды, мұқият жүріңіз.
Dialogue: 0,0:08:30.70,0:08:31.87,Default,,0,0,0,,Рёкай
Dialogue: 0,0:08:33.33,0:08:34.87,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:08:34.87,0:08:39.95,Default,,0,0,0,,Мен тұрақты боламын. Жарайды... бірақ қазірдің өзінде кеш. Ертеңнен бастап.
Dialogue: 0,0:08:39.95,0:08:41.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:41.29,0:08:43.37,Default,,0,0,0,,Қонақ үй қай жерде? Мен оны сізге жіберемін
Dialogue: 0,0:08:44.62,0:08:46.08,Default,,0,0,0,,Бұл менің нөмірім.
Dialogue: 0,0:08:46.08,0:08:50.12,Default,,0,0,0,,Сенің қиындыққа тап болғаныңды қаламаймын. Бөлмеңізге барып, тыныш ұйықтаңыз.
Dialogue: 0,0:08:50.12,0:08:52.58,Default,,0,0,0,,Уайымдама, бұл бала емес.
Dialogue: 0,0:08:52.58,0:08:55.50,Default,,0,0,0,,Қалай қарасаң да, сен әлі баласың, сондықтан мен уайымдаймын.
Dialogue: 0,0:08:55.50,0:08:57.50,Default,,0,0,0,,Менің әлі 26-дамын
Dialogue: 0,0:08:57.50,0:09:01.41,Default,,0,0,0,,Жердің жасы 18. Онда кездескенше.
Dialogue: 0,0:09:01.41,0:09:02.41,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:10.12,0:09:12.08,Default,,0,0,0,,Ха... Бүгін түн суық...
Dialogue: 0,0:09:15.16,0:09:16.37,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:16.52,0:09:17.71,Default,,0,0,0,,Қонақ үйден қуылды
Dialogue: 0,0:09:18.05,0:09:18.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:19.16,0:09:21.75,Default,,0,0,0,,Қаруға рұқсат етілмейді.
Dialogue: 0,0:09:21.75,0:09:24.00,Default,,0,0,0,,Маған қылышымды бер
Dialogue: 0,0:09:24.00,0:09:26.33,Default,,0,0,0,,Бұл заттарды қалдырыңыз...
Dialogue: 0,0:09:26.33,0:09:27.50,Default,,0,0,0,,Ол әлі оралмады ма?
Dialogue: 0,0:09:27.50,0:09:29.82,Default,,0,0,0,,Қылыш - рыцарь өмірі.
Dialogue: 0,0:09:30.50,0:09:33.50,Default,,0,0,0,,Содан кейін сол жерде лагерь жасаңыз. Мен білмеймін.
Dialogue: 0,0:09:33.50,0:09:34.50,Default,,0,0,0,,Чип! Чип! Чип, чип, чип…
Dialogue: 0,0:09:47.18,0:09:49.04,Default,,0,0,0,,А... Таку!
Dialogue: 0,0:10:02.70,0:10:05.12,Default,,0,0,0,,Қалалық полицияның ұйықтайтын бөлмесі үнемі лық толы.
Dialogue: 0,0:10:05.12,0:10:07.41,Default,,0,0,0,,Көптеген полиция қызметкерлері семанилерді жек көреді.
Dialogue: 0,0:10:07.41,0:10:09.20,Default,,0,0,0,,Менің бөлмемде ұйықта
Dialogue: 0,0:10:09.20,0:10:10.62,Default,,0,0,0,,О... сіздің бөлмеңіз бе?
Dialogue: 0,0:10:10.62,0:10:13.62,Default,,0,0,0,,Уайымдама, мен саған шабуыл жасамаймын.
Dialogue: 0,0:10:13.62,0:10:14.79,Default,,0,0,0,,Әрине
Dialogue: 0,0:10:14.79,0:10:20.59,Default,,0,0,0,,Бірақ... әлгі жалған қауесет пен жаман атақ... мұндай абыройсыздық...
Dialogue: 0,0:10:20.33,0:10:23.45,Default,,0,0,0,,Үніңді жап, сылдырлама.
Dialogue: 0,0:10:26.87,0:10:29.37,Default,,0,0,0,,Жүктеріңізді қалдырыңыз да, әзірге жоғары көтеріліңіз.
Dialogue: 0,0:10:31.54,0:10:33.20,Default,,0,0,0,,Неліктен мұндай нәрсе?
Dialogue: 0,0:10:33.20,0:10:35.12,Default,,0,0,0,,Менің мысықтарға аллергиям бар.
Dialogue: 0,0:10:39.70,0:10:40.70,Default,,0,0,0,,Кэй!
Dialogue: 0,0:10:42.04,0:10:43.20,Default,,0,0,0,,K?
Dialogue: 0,0:10:43.20,0:10:46.00,Default,,0,0,0,,Жоқ, мен мысықтарды айтып отырмын.
Dialogue: 0,0:10:46.00,0:10:47.83,Default,,0,0,0,,Менің тілімде
Dialogue: 0,0:10:47.83,0:10:50.08,Default,,0,0,0,,Мен сені мен туралы айтып отырсың деп ойладым.
Dialogue: 0,0:10:50.08,0:10:53.58,Default,,0,0,0,,Ал, жоқ... Мысықтың аты кім?
Dialogue: 0,0:10:53.58,0:10:54.62,Default,,0,0,0,,Бұл Курой
Dialogue: 0,0:10:54.62,0:10:56.16,Default,,0,0,0,,Аллергия дегеніміз не?
Dialogue: 0,0:10:57.04,0:10:59.70,Default,,0,0,0,,Мен осы жігіттің қасында болғанда астмамен ауырамын.
Dialogue: 0,0:10:59.70,0:11:01.75,Default,,0,0,0,,Бұл конституцияға қатысты мәселе.
Dialogue: 0,0:11:01.75,0:11:05.75,Default,,0,0,0,,Ендеше неге біз өзімізге ұнамайтын мысықты ұстаудың қиындығына барамыз?
Dialogue: 0,0:11:05.75,0:11:09.37,Default,,0,0,0,,Менің көптеген сұрақтарым бар, кешіріңіз.
Dialogue: 0,0:11:19.83,0:11:22.20,Default,,0,0,0,,Шамамен 3 ай бұрын...
Dialogue: 0,0:11:22.20,0:11:27.25,Default,,0,0,0,,Біз қуып келе жатқан есірткі сатушының көлігі қаңғыбас мысықты қағып кетті.
Dialogue: 0,0:11:27.25,0:11:28.37,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:11:28.37,0:11:33.29,Default,,0,0,0,,Кінәлі бірден ұсталып, әйтеуір аман қалды.
Dialogue: 0,0:11:33.29,0:11:36.62,Default,,0,0,0,,Бірақ басқа әріптестерім мені қабылдамайды.
Dialogue: 0,0:11:36.62,0:11:39.08,Default,,0,0,0,,Мен оны уақытша сақтаймын.
Dialogue: 0,0:11:39.08,0:11:41.00,Default,,0,0,0,,Мысықтарға аллергияңыз бар ма?
Dialogue: 0,0:11:41.00,0:11:44.66,Default,,0,0,0,,Оған көмектесу мүмкін емес... Мен де жауаптымын.
Dialogue: 0,0:11:44.66,0:11:48.04,Default,,0,0,0,,Мен алушыны іздеймін, бірақ таба алмаймын...
Dialogue: 0,0:11:49.70,0:11:50.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:50.91,0:11:51.91,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:53.08,0:11:54.58,Default,,0,0,0,,Бұл шынымен де біртүрлі ме?
Dialogue: 0,0:11:54.58,0:11:58.25,Default,,0,0,0,,Кешіріңіз, Кей... Бірақ бұл...
Dialogue: 0,0:12:08.12,0:12:12.37,Default,,0,0,0,,Кэй Иматуба Сіз таңқаларлықтай мейірімді сияқтысыз.
Dialogue: 0,0:12:12.37,0:12:13.91,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:12:13.91,0:12:17.79,Default,,0,0,0,,Егер мен зардап шеккен қаңғыбас мысықты суықта қалдырсам, оның ұйықтауы қиын болады.
Dialogue: 0,0:12:17.79,0:12:19.83,Default,,0,0,0,,Сайып келгенде, бұл өзіңіз үшін
Dialogue: 0,0:12:19.83,0:12:22.70,Default,,0,0,0,,Мен бұл баламен бірдеймін бе?
Dialogue: 0,0:12:22.70,0:12:25.58,Default,,0,0,0,,Егер сізге ұнамаса, саябаққа қайта барыңыз.
Dialogue: 0,0:12:25.58,0:12:28.54,Default,,0,0,0,,Жоқ, бұл пайдалы. Бұны ұнатамын.
Dialogue: 0,0:12:28.54,0:12:29.91,Default,,0,0,0,,Осындай бөлме бар ма?
Dialogue: 0,0:12:29.91,0:12:32.41,Default,,0,0,0,,Жоқ, бұл жағдай.
Dialogue: 0,0:12:32.41,0:12:34.75,Default,,0,0,0,,Мен сен туралы айтып тұрған жоқпын, солай ма?
Dialogue: 0,0:12:36.75,0:12:39.83,Default,,0,0,0,,Олай болса, барып ұйықтап ал.
Dialogue: 0,0:12:39.83,0:12:42.58,Default,,0,0,0,,Куройды жатын бөлмеге кіргізбе
Dialogue: 0,0:12:42.58,0:12:44.25,Default,,0,0,0,,Кей матова
Dialogue: 0,0:12:44.25,0:12:46.83,Default,,0,0,0,,Негізі мен біраз уайымдадым.
Dialogue: 0,0:12:49.50,0:12:51.66,Default,,0,0,0,,Ал... рахмет...
Dialogue: 0,0:12:51.66,0:12:54.25,Default,,0,0,0,,Мм...қайырлы түн...
Dialogue: 0,0:12:56.29,0:12:57.33,Default,,0,0,0,,Зұлымдар Альянсы мен Шие Хачисай-кай арасында жақсы ынтымақтастық жоқ —
Dialogue: 0,0:13:12.50,0:13:15.00,Default,,0,0,0,,Ол... Адамның аты кім?
Dialogue: 0,0:13:15.00,0:13:17.41,Default,,0,0,0,,Сіз күліп жүрдіңіз бе...
Dialogue: 0,0:13:37.83,0:13:40.62,Default,,0,0,0,,Мен сені күттім бе? Карим мырза
Dialogue: 0,0:13:40.62,0:13:43.50,Default,,0,0,0,,Жақсы әлеуметтік этикет Эльбажи мырза
Dialogue: 0,0:13:43.50,0:13:44.75,Default,,0,0,0,,Мәміле
Dialogue: 0,0:13:50.66,0:13:52.62,Default,,0,0,0,,Жарайсың, Террорист мырза!
Dialogue: 0,0:13:52.62,0:13:54.91,Default,,0,0,0,,Өйткені, қолма-қол ақша төлеу жақсы.
Dialogue: 0,0:13:54.91,0:13:57.91,Default,,0,0,0,,Қалғанын өнімнің орнына сұраймын.
Dialogue: 0,0:13:57.91,0:14:00.54,Default,,0,0,0,,Ол өте жақсы тербеліп тұрған сияқты, солай емес пе?
Dialogue: 0,0:14:00.54,0:14:01.41,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:01.41,0:14:06.58,Default,,0,0,0,,Кедей перілердің арқасында бәріміз бақытты өмір сүре аламыз.
Dialogue: 0,0:14:06.58,0:14:09.91,Default,,0,0,0,,Мысалы, сол көлік! Бұл 300 000 доллар.
Dialogue: 0,0:14:09.91,0:14:13.54,Default,,0,0,0,,Бұл кроссовкалар 3000 доллар тұрады.
Dialogue: 0,0:14:13.54,0:14:16.20,Default,,0,0,0,,Алайда әйелдер оны бар болғаны 3 долларға ләззат ала алады.
Dialogue: 0,0:14:16.20,0:14:17.75,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:14:17.75,0:14:18.54,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:14:18.54,0:14:20.83,Default,,0,0,0,,Себебі мен әдемімін
Dialogue: 0,0:14:20.83,0:14:25.29,Default,,0,0,0,,Жердегі әйелдер туралы сөз болғанда, бәрі оларға қарайды.
Dialogue: 0,0:14:25.29,0:14:26.45,Default,,0,0,0,,Чороймонса
Dialogue: 0,0:14:26.45,0:14:29.33,Default,,0,0,0,,Мені алаңдататын жалғыз нәрсе - өнім.
Dialogue: 0,0:14:29.33,0:14:31.29,Default,,0,0,0,,Ах... Кешіріңіз, кешіріңіз.
Dialogue: 0,0:14:31.29,0:14:32.66,Default,,0,0,0,,Сәлем Зелада!
Dialogue: 0,0:14:34.20,0:14:36.62,Default,,0,0,0,,Сіз мені шақырып жатырсыз ба, мырзам?
Dialogue: 0,0:14:36.62,0:14:40.58,Default,,0,0,0,,Карим мырза, сізді ментор Зеладамен таныстыруға рұқсат етіңіз.
Dialogue: 0,0:14:40.58,0:14:42.79,Default,,0,0,0,,Ол сиқыршы ма?
Dialogue: 0,0:14:42.79,0:14:46.33,Default,,0,0,0,,Дұрыс. Өлі манипуляторлар - әлемдегі ең жақсысы.
Dialogue: 0,0:14:46.33,0:14:48.16,Default,,0,0,0,,Қалдық сөздер
Dialogue: 0,0:14:48.16,0:14:53.04,Default,,0,0,0,,Қызметім үшін ғана үйренген қулық.
Dialogue: 0,0:14:53.04,0:14:57.41,Default,,0,0,0,,Сіз өлді деп айттыңыз. Сіз Fairy Dust тәуелділігін айттыңыз ба?
Dialogue: 0,0:14:57.41,0:14:59.29,Default,,0,0,0,,Ол сол жақта.
Dialogue: 0,0:14:59.29,0:15:05.54,Default,,0,0,0,,Менің әдіс-тәсілдерім рухы сау адамға тиімді болмайды.
Dialogue: 0,0:15:05.54,0:15:07.50,Default,,0,0,0,,Міне, осы жігіт кіріп келеді.
Dialogue: 0,0:15:07.50,0:15:09.62,Default,,0,0,0,,Бұл ертегі бомбасы ма?
Dialogue: 0,0:15:09.62,0:15:11.54,Default,,0,0,0,,Бұл прототип.
Dialogue: 0,0:15:11.54,0:15:13.87,Default,,0,0,0,,Мен оны бірден сынап көрейін деп жатырмын.
Dialogue: 0,0:15:13.87,0:15:15.29,Default,,0,0,0,,Эй... нені айтып тұрсың?
Dialogue: 0,0:15:15.29,0:15:18.04,Default,,0,0,0,,Мен оларды 911-ге шақырдым.
Dialogue: 0,0:15:18.04,0:15:20.62,Default,,0,0,0,,Күдікті адам шу шығарды ма?
Dialogue: 0,0:15:21.50,0:15:23.79,Default,,0,0,0,,Бұл орынға тыйым салынған.
Dialogue: 0,0:15:23.79,0:15:26.41,Default,,0,0,0,,Барлығы ақырын қолдарын көтереді.
Dialogue: 0,0:15:24.70,0:15:26.41,Default,,0,0,0,,Жарыққа қарамайсың ба?
Dialogue: 0,0:15:34.29,0:15:36.08,Default,,0,0,0,,Дәл осы көше!
Dialogue: 0,0:15:36.08,0:15:38.16,Default,,0,0,0,,Сіз қалай ойлайсыз? гелада
Dialogue: 0,0:15:38.16,0:15:44.58,Default,,0,0,0,,Иә, тақсыр, бұл екеуі өліп қалды.
Dialogue: 0,0:15:44.58,0:15:46.83,Default,,0,0,0,,Ал, сәлем беруге рұқсат етіңіздер.
Dialogue: 0,0:15:46.83,0:15:48.41,Default,,0,0,0,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:15:49.95,0:15:51.87,Default,,0,0,0,,Біреуін атып өлтіру
Dialogue: 0,0:15:51.87,0:15:52.87,Default,,0,0,0,,Иә
Dialogue: 0,0:15:57.33,0:15:59.70,Default,,0,0,0,,Бейшара! Ол қайтыс болды!
Dialogue: 0,0:15:59.70,0:16:02.33,Default,,0,0,0,,Келесі... Меніңше, солай.
Dialogue: 0,0:16:02.33,0:16:04.87,Default,,0,0,0,,Олар капюшонда билесін!
Dialogue: 0,0:16:07.45,0:16:11.95,Default,,0,0,0,,Зелада! Сенің биге деген сезімің жоқ сияқты!
Dialogue: 0,0:16:11.95,0:16:13.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:15.37,0:16:18.00,Default,,0,0,0,,Қызық, солай ма? Не? Не?
Dialogue: 0,0:16:18.00,0:16:20.25,Default,,0,0,0,,Сіз қанша адамды басқара аласыз?
Dialogue: 0,0:16:20.25,0:16:22.54,Default,,0,0,0,,Тіпті 5 000 немесе 10 000
Dialogue: 0,0:16:22.54,0:16:26.91,Default,,0,0,0,,Мен бір рет 100-ге дейін тырыстым.
Dialogue: 0,0:16:26.91,0:16:28.16,Default,,0,0,0,,Не...
Dialogue: 0,0:16:28.16,0:16:32.58,Default,,0,0,0,,Бұл прототип, бірақ дайын өнім керемет, солай емес пе?
Dialogue: 0,0:16:32.58,0:16:36.08,Default,,0,0,0,,Мен барлық жоғары дәрежелі перілерді пайдаланамын...
Dialogue: 0,0:16:36.08,0:16:40.62,Default,,0,0,0,,Тиімді аудан...жақсы, шамамен 5км радиуста.
Dialogue: 0,0:16:40.62,0:16:42.79,Default,,0,0,0,,Бұл ядролық бомба сияқты
Dialogue: 0,0:16:42.79,0:16:46.16,Default,,0,0,0,,Бұл ірі державалардың үкіметтерін құлату үшін пайдаланылуы мүмкін.
Dialogue: 0,0:16:46.16,0:16:48.33,Default,,0,0,0,,Қалауыңызша пайдаланыңыз
Dialogue: 0,0:16:48.33,0:16:50.83,Default,,0,0,0,,Дегенмен, гелада жалға беріледі.
Dialogue: 0,0:16:52.16,0:16:53.66,Default,,0,0,0,,Ақша беріңіз
Dialogue: 0,0:16:53.66,0:16:55.00,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:16:55.00,0:16:57.33,Default,,0,0,0,,Ал, мен реттеуді жасаймын.
Dialogue: 0,0:16:57.33,0:17:00.62,Default,,0,0,0,,Мырзам, сіз ол мырзамен не істегіңіз келеді?
Dialogue: 0,0:17:00.62,0:17:02.58,Default,,0,0,0,,Аа, менен құтыл.
Dialogue: 0,0:17:42.00,0:17:45.79,Default,,0,0,0,,Бұл досымның табытын бірінші рет көтеріп тұрғаным емес...
Dialogue: 0,0:17:45.79,0:17:47.54,Default,,0,0,0,,Мен оны әлі аяқтай алмаймын
Dialogue: 0,0:17:47.54,0:17:49.37,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:17:49.37,0:17:55.54,Default,,0,0,0,,Осы айда үш адам қалалық полицияда қызметтік міндетін атқару кезінде қаза тапты. Жердегі мораль ең төменгі деңгейде.
Dialogue: 0,0:17:55.54,0:18:00.04,Default,,0,0,0,,Бірақ қалалық кеңес полицияның бюджетін одан әрі қысқартуға тырысады.
Dialogue: 0,0:18:00.04,0:18:04.25,Default,,0,0,0,,Олар шындықты көрмейді, ақымақтар.
Dialogue: 0,0:18:04.25,0:18:06.12,Default,,0,0,0,,Бас…
Dialogue: 0,0:18:06.12,0:18:09.20,Default,,0,0,0,,Жоқ... назарыңызды жүргізіліп жатқан тергеуге аударыңыз.
Dialogue: 0,0:18:15.54,0:18:17.50,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:18:17.50,0:18:18.91,Default,,0,0,0,,Не?
Dialogue: 0,0:18:18.91,0:18:20.54,Default,,0,0,0,,Әсіресе?
Dialogue: 0,0:18:20.54,0:18:21.75,Default,,0,0,0,,Кеттік
Dialogue: 0,0:18:25.04,0:18:26.41,Default,,0,0,0,,Ұзақ болды ма?
Dialogue: 0,0:18:26.41,0:18:27.50,Default,,0,0,0,,Не?
Dialogue: 0,0:18:27.50,0:18:30.41,Default,,0,0,0,,Марқұм оның серіктесі болды, солай ма?
Dialogue: 0,0:18:30.41,0:18:33.70,Default,,0,0,0,,Ал, Рик жақсы жігіт еді.
Dialogue: 0,0:18:33.70,0:18:37.87,Default,,0,0,0,,Олар өздері қолдаған бейсбол командасы туралы соңына дейін қақтығысты.
Dialogue: 0,0:18:39.45,0:18:43.58,Default,,0,0,0,,Елімде өлгенді жоқтайды көп.
Dialogue: 0,0:18:43.58,0:18:47.45,Default,,0,0,0,,Бейбіт мәңгілік көктем еліне баруға болады дейді.
Dialogue: 0,0:18:47.45,0:18:50.87,Default,,0,0,0,,Детектив Фьюри жасайтын шығар.
Dialogue: 0,0:18:50.87,0:18:52.50,Default,,0,0,0,,Сіз мені жұбатасыз ба?
Dialogue: 0,0:18:52.50,0:18:53.83,Default,,0,0,0,,Нашар ма?
Dialogue: 0,0:18:53.83,0:18:55.20,Default,,0,0,0,,Бөлек
Dialogue: 0,0:18:55.20,0:18:58.54,Default,,0,0,0,,Сіз бұл жағдайда не айту керектігін білесіз.
Dialogue: 0,0:18:58.54,0:19:01.66,Default,,0,0,0,,Рахмет, Дарш Занна.
Dialogue: 0,0:19:01.66,0:19:02.75,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:05.12,0:19:06.91,Default,,0,0,0,,Kay? Қазір жақсы ма?
Dialogue: 0,0:19:06.91,0:19:08.91,Default,,0,0,0,,Джеймиге не болды?
Dialogue: 0,0:19:08.91,0:19:12.12,Default,,0,0,0,,Юбеден келген полиция көлігінің жоғалғанын білесіз бе?
Dialogue: 0,0:19:12.12,0:19:14.87,Default,,0,0,0,,22-ші учаскенің жігіттері, солай ма?
Dialogue: 0,0:19:14.87,0:19:17.70,Default,,0,0,0,,Ол Шығыс Рок саябағында табылған сияқты.
Dialogue: 0,0:19:17.70,0:19:20.04,Default,,0,0,0,,Екі полиция қызметкері де қаза тапты.
Dialogue: 0,0:19:27.50,0:19:31.50,Default,,0,0,0,,Кісі өлтіру орны Редмурдағы құрылыс алаңы екені белгілі.
Dialogue: 0,0:19:31.50,0:19:35.33,Default,,0,0,0,,Олар оны полиция көлігімен осында апарып, толығымен тоғанға тастады.
Dialogue: 0,0:19:35.33,0:19:37.20,Default,,0,0,0,,Бұл шынымен де кісі өлтіру ме?
Dialogue: 0,0:19:37.20,0:19:40.91,Default,,0,0,0,,Бұл оқтың өту бұрышын ескерсек, суицидке ұқсайды.
Dialogue: 0,0:19:40.91,0:19:44.87,Default,,0,0,0,,Білмеймін...шындық мәйітті күтетін шығар.
Dialogue: 0,0:19:44.87,0:19:47.75,Default,,0,0,0,,Полиция итінен қарауды сұрауым керек пе?
Dialogue: 0,0:19:47.75,0:19:49.00,Default,,0,0,0,,Сәлем! Тирана!
Dialogue: 0,0:19:53.95,0:19:58.04,Default,,0,0,0,,Менің атымды есіңе түсіргеніңе таң қалдым.
Dialogue: 0,0:19:58.04,0:20:00.83,Default,,0,0,0,,Жарайды, Хотокеге қарашы.
Dialogue: 0,0:20:00.83,0:20:02.20,Default,,0,0,0,,Бона Тирана.
Dialogue: 0,0:20:02.20,0:20:03.91,Default,,0,0,0,,Мен саған солай ата деп айттым ба?
Dialogue: 0,0:20:03.91,0:20:07.25,Default,,0,0,0,,Қарап көріңіз!
Dialogue: 0,0:20:07.25,0:20:12.33,Default,,0,0,0,,Бұл да сол кісі өлтірушілер мен контрабандашылар сияқты өлген адам.
Dialogue: 0,0:20:12.33,0:20:14.87,Default,,0,0,0,,Сіз ертегі шаңына тәуелдісіз бе?
Dialogue: 0,0:20:14.87,0:20:16.29,Default,,0,0,0,,Бұл полиция қызметкері.
Dialogue: 0,0:20:16.29,0:20:17.83,Default,,0,0,0,,Бірақ күмән жоқ
Dialogue: 0,0:20:17.83,0:20:21.50,Default,,0,0,0,,Егер полиция қызметкері бандит болса, сіздің отбасыңыз жақын арада біледі.
Dialogue: 0,0:20:21.50,0:20:23.41,Default,,0,0,0,,Мүмкін алтын бұйымдар қолданылған болуы мүмкін
Dialogue: 0,0:20:23.41,0:20:24.83,Default,,0,0,0,,Голдсмит?
Dialogue: 0,0:20:24.83,0:20:28.33,Default,,0,0,0,,Зертхана - Латенаны арттыратын катализатор.
Dialogue: 0,0:20:28.33,0:20:30.54,Default,,0,0,0,,Егер бірдеңе сонша күшке ие болса
Dialogue: 0,0:20:30.54,0:20:33.12,Default,,0,0,0,,Тіпті бір шаштың қияметінен ауытқуға жол берілмейді.
Dialogue: 0,0:20:33.12,0:20:36.37,Default,,0,0,0,,Оны біздің елдің ең жақсы шеберлері де жасай алмас еді.
Dialogue: 0,0:20:36.37,0:20:38.58,Default,,0,0,0,,Мен қателесіп жатырмын ба?
Dialogue: 0,0:20:38.58,0:20:39.83,Default,,0,0,0,,Қателіктеріңе көп тоқталудың орнына,
Dialogue: 0,0:20:39.83,0:20:42.58,Default,,0,0,0,,Адам қолымен мүмкін емес шығар...
Dialogue: 0,0:20:42.58,0:20:45.29,Default,,0,0,0,,Цифрлық басқарылатын станоктар туралы не деуге болады?
Dialogue: 0,0:20:46.75,0:20:49.00,Default,,0,0,0,,Жарайды... осында.
Dialogue: 0,0:20:49.00,0:20:50.25,Default,,0,0,0,,Не?
Dialogue: 0,0:20:50.25,0:20:53.87,Default,,0,0,0,,Дәлдігі жоғары станоктарды сатып алушылар көп емес.
Dialogue: 0,0:20:53.87,0:20:57.08,Default,,0,0,0,,Жалған компанияларды пайдаланатын адамдар бар... көрдің бе?
Dialogue: 0,0:20:57.08,0:20:58.45,Default,,0,0,0,,Деннис Эльбажи
Dialogue: 0,0:20:58.45,0:21:00.87,Default,,0,0,0,,Семани клубының менеджері...
Dialogue: 0,0:21:00.87,0:21:03.70,Default,,0,0,0,,Мұндай адамның станоктарға қандай пайдасы бар?
Dialogue: 0,0:21:03.70,0:21:04.70,Default,,0,0,0,,Ұстап алайық!
Dialogue: 0,0:21:04.70,0:21:06.33,Default,,0,0,0,,Қандай төлем?
Dialogue: 0,0:21:06.33,0:21:09.16,Default,,0,0,0,,Бәрі де болады! Ұстап, жауап ал!
Dialogue: 0,0:21:09.16,0:21:10.79,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:21:10.79,0:21:15.04,Default,,0,0,0,,Жер бетінде адамның негізгі құқықтарына ие Құдай бар. Біріншіден, бізге дәлел керек.
Dialogue: 0,0:21:15.04,0:21:17.45,Default,,0,0,0,,Сотты қанағаттандыру үшін
Dialogue: 0,0:21:17.45,0:21:20.12,Default,,0,0,0,,Бірақ біз асығуымыз керек!
Dialogue: 0,0:21:20.12,0:21:22.41,Default,,0,0,0,,Процедура қажет.
Dialogue: 0,0:21:22.41,0:21:25.54,Default,,0,0,0,,Сол баланың өміріне қауіп төніп тұр!
Dialogue: 0,0:21:25.54,0:21:27.87,Default,,0,0,0,,Мына бала? Сіз перілер туралы айтып отырсыз ба?
Dialogue: 0,0:21:29.37,0:21:31.54,Default,,0,0,0,,Себебі бар сияқты.
Dialogue: 0,0:21:31.54,0:21:34.00,Default,,0,0,0,,Сен ше, Кей?
Dialogue: 0,0:21:34.00,0:21:37.52,Default,,0,0,0,,Сол өріс... пері өлсе бәрібір деп ойлайсың ба?
Dialogue: 0,0:21:38.87,0:21:41.58,Default,,0,0,0,,Мен жауапкершілікті сезінемін.
Dialogue: 0,0:21:41.58,0:21:44.54,Default,,0,0,0,,Менің де сол баланың алдында жауапкершілігім бар.
Dialogue: 0,0:21:46.62,0:21:48.16,Default,,0,0,0,,Дәретхана? Эй
Dialogue: 0,0:22:05.91,0:22:08.66,Default,,0,0,0,,Өмірден маңыздырақ емес пе еді?
Dialogue: 0,0:23:42.80,0:23:44.70,Default,,0,0,0,,Келесі COP CRAFT
Dialogue: 0,0:22:29.98,0:22:34.27,Default,,0,0,0,,Неве Сия Дарш Занна
Dialogue: 0,0:22:34.46,0:22:38.46,Default,,0,0,0,,Бұл дүниенің соңында
Dialogue: 0,0:22:38.52,0:22:43.01,Default,,0,0,0,,Дұға еткендей сыбырлау
Dialogue: 0,0:22:43.25,0:22:47.09,Default,,0,0,0,,Мен қолымды создым
Dialogue: 0,0:22:47.09,0:22:51.54,Default,,0,0,0,,өте маңызды
Dialogue: 0,0:22:51.54,0:22:56.04,Default,,0,0,0,,Өйткені заттар көзге көрінбейді
Dialogue: 0,0:22:56.04,0:22:59.11,Default,,0,0,0,,Енді алға күтіңіз
Dialogue: 0,0:22:59.11,0:23:04.03,Default,,0,0,0,,Осы сезімді сезін
Dialogue: 0,0:23:04.14,0:23:08.62,Default,,0,0,0,,Dark Future Slash
Dialogue: 0,0:23:08.62,0:23:12.90,Default,,0,0,0,,Жаныңыздың дауысын тыңдаңыз
Dialogue: 0,0:23:12.90,0:23:14.69,Default,,0,0,0,,Көрінбейтін ертең
Dialogue: 0,0:23:14.69,0:23:17.01,Default,,0,0,0,,Жаңа әлем
Dialogue: 0,0:23:17.01,0:23:21.10,Default,,0,0,0,,Уақыт пен кеңістіктен тыс екі сот байланысқан
Dialogue: 0,0:23:21.10,0:23:25.63,Default,,0,0,0,,Енді қорқатын ештеңе жоқ
Dialogue: 0,0:23:25.63,0:23:29.91,Default,,0,0,0,,Біріктірілген қолымызда емес
Dialogue: 0,0:23:29.91,0:23:33.83,Default,,0,0,0,,Сиқырланып, мекендеген жан
Dialogue: 0,0:23:33.95,0:23:38.01,Default,,0,0,0,,Жүрегімде мақтанышпен, Мен сенген нәрсеге сендім.
Dialogue: 0,0:23:38.01,0:23:40.07,Default,,0,0,0,,Жолға шығыңыз
Dialogue: 0,0:23:46.20,0:23:52.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory