Dialogue: 0,0:23:44.62,0:23:46.62,Default,,0,0,0,,

Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 1,0:01:56.17,0:01:59.30,Default,,0,0,0,,Қала шамдары миллион долларды қалайды
Dialogue: 1,0:01:59.47,0:02:02.53,Default,,0,0,0,,Ұзақ атсаң, бұл жұмақ
Dialogue: 1,0:02:02.65,0:02:06.21,Default,,0,0,0,,Мұқият қарасаңыз
Dialogue: 1,0:02:06.24,0:02:06.24,Default,,0,0,0,,Қаңқаларға толы тас жол
Dialogue: 1,0:02:10.04,0:02:13.23,Default,,0,0,0,,Қиылыста айқайлаған қала жігіттері
Dialogue: 1,0:02:13.42,0:02:16.54,Default,,0,0,0,,Біреудің мәселесі сияқты үнсіздік
Dialogue: 1,0:02:16.54,0:02:23.10,Default,,0,0,0,,Ұлы қала жақсыны да, жаманды да жұтады.
Dialogue: 1,0:02:23.31,0:02:29.76,Default,,0,0,0,,Бауырластар әлемі біткенше біз қанша жүреміз?
Dialogue: 1,0:02:29.76,0:02:34.09,Default,,0,0,0,,Бұл қолда не қалды?
Dialogue: 1,0:02:34.09,0:02:37.68,Default,,0,0,0,,Өлгенше күресейік
Dialogue: 1,0:02:38.42,0:02:43.19,Default,,0,0,0,,Қала құрылыс пен қиратумен айналысуда.
Dialogue: 1,0:02:43.19,0:02:46.39,Default,,0,0,0,,Бұл темір зат сияқты
Dialogue: 1,0:02:46.63,0:02:53.51,Default,,0,0,0,,Адамның қалауы түріне айналды
Dialogue: 1,0:02:53.63,0:02:57.22,Default,,0,0,0,,Үндетпе, тым қатты.
Dialogue: 1,0:02:57.22,0:03:00.49,Default,,0,0,0,,Менің қалағаным бір ғана
Dialogue: 1,0:03:00.61,0:03:08.54,Default,,0,0,0,,Осы жерде екенін мойындаңыз, Парадисо
Dialogue: 1,0:03:10.56,0:03:13.39,Default,,0,0,0,,Парадисо
Dialogue: 0,0:00:13.75,0:00:16.12,Default,,0,0,0,,Суицид?
Dialogue: 0,0:00:16.12,0:00:17.41,Default,,0,0,0,,Ол Касуканың жауы ғой, иә?
Dialogue: 0,0:00:17.41,0:00:18.41,Default,,0,0,0,,Кэй?
Dialogue: 0,0:00:19.87,0:00:23.58,Default,,0,0,0,,Мен қазір Эльбажи мен оның компаниясы туралы мәліметтерді жіберемін.
Dialogue: 0,0:00:26.25,0:00:28.12,Default,,0,0,0,,Кэмми келмейді.
Dialogue: 0,0:00:28.12,0:00:30.79,Default,,0,0,0,,Айтар сөзің жоқ па?
Dialogue: 0,0:00:30.79,0:00:32.08,Default,,0,0,0,,Бұл субтитрлер JOJO's Bizarre Adventure форумы, Yuhari Subtitles және Gods Subtitles Group бірлесіп дайындады
Dialogue: 0,0:00:32.08,0:00:33.83,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:00:37.54,0:00:39.87,Default,,0,0,0,,Тирана деген қызға не болды?
Dialogue: 0,0:00:39.87,0:00:41.14,Default,,0,0,0,,Мен оны көрген жоқпын.
Dialogue: 0,0:00:41.33,0:00:42.08,Default,,0,0,0,,Хмм?
Dialogue: 0,0:00:42.08,0:00:44.58,Default,,0,0,0,,А... бұл ұйықтау бөлмесі.
Dialogue: 0,0:00:44.58,0:00:47.25,Default,,0,0,0,,Сіз үйренбеген қалада болудан шаршаған шығарсыз.
Dialogue: 0,0:00:47.25,0:00:50.58,Default,,0,0,0,,Сонда бұл қылышқа не болды?
Dialogue: 0,0:00:53.00,0:00:56.87,Default,,0,0,0,,Кешіріңіз, мен одан көзімді алғанымда ол жоқ еді.
Dialogue: 0,0:00:56.87,0:00:58.33,Default,,0,0,0,,Мені қазір қайтарыңыз
Dialogue: 0,0:00:58.33,0:01:00.25,Default,,0,0,0,,Мен тергеуді қысқартқым келмейді.
Dialogue: 0,0:01:06.87,0:01:11.58,Default,,0,0,0,,15 жыл бұрын Тынық мұхитының үстінде белгісіз гиперкеңістік қақпасы пайда болды.
Dialogue: 0,0:01:11.58,0:01:16.87,Default,,0,0,0,,Оның арғы жағында перілер мен құбыжықтар мекендеген біртүрлі әлем болды.
Dialogue: 0,0:01:16.87,0:01:19.20,Default,,0,0,0,,Кариаена аралы Сан-Тереза қаласы
Dialogue: 0,0:01:19.20,0:01:22.54,Default,,0,0,0,,Бұл қала Жер әлеміне кіретін қақпа.
Dialogue: 0,0:01:22.54,0:01:25.04,Default,,0,0,0,,Екі дүниеде де 2 миллионнан астам иммигранттар
Dialogue: 0,0:01:25.04,0:01:29.62,Default,,0,0,0,,Әртүрлі этникалық топтар мен әртүрлі мәдениеттер, бар және жоқтар
Dialogue: 0,0:01:29.62,0:01:33.04,Default,,0,0,0,,Бұл әлемдегі ең жаңа арман қала
Dialogue: 0,0:01:33.04,0:01:37.41,Default,,0,0,0,,Бірақ сол хаостың көлеңкесінде көптеген қылмыстар жасырынып жатты.
Dialogue: 0,0:01:37.41,0:01:39.08,Default,,0,0,0,,Есірткі Жезөкшелік
Dialogue: 0,0:01:39.08,0:01:40.41,Default,,0,0,0,,Қару-жарақ саудасы
Dialogue: 0,0:01:40.41,0:01:43.50,Default,,0,0,0,,Осы ауыр қылмыстармен күресетін детективтер
Dialogue: 0,0:01:43.50,0:01:46.29,Default,,0,0,0,,Сан Тереза қалалық полиция бөлімінде болған
Dialogue: 0,0:03:30.20,0:03:31.54,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:03:31.54,0:03:38.04,Default,,0,0,0,,Менің ынтымақтастығымсыз сіз жай ғана бас тартасыз ба? Жұлдыз Тирана…
Dialogue: 0,0:03:38.04,0:03:41.00,Default,,0,0,0,,Жердегі Құдайға рахмет
Dialogue: 0,0:03:41.00,0:03:44.83,Default,,0,0,0,,Сіздің құдайыңыз құжатты қолдан жасауға көмектеседі ме?
Dialogue: 0,0:03:44.83,0:03:48.70,Default,,0,0,0,,Сонда да...Мен салтанатты киімді көбірек таңдар едім.
Dialogue: 0,0:03:48.70,0:03:51.12,Default,,0,0,0,,Ұялмаңыз
Dialogue: 0,0:03:51.12,0:03:55.75,Default,,0,0,0,,Жер бетінде мәртебесі жоғары әйелдер осылай жүреді.
Dialogue: 0,0:03:55.75,0:03:57.83,Default,,0,0,0,,Келіңіздер, көріңіздер.
Dialogue: 0,0:03:58.58,0:04:00.12,Default,,0,0,0,,Мынау... осылай ма?
Dialogue: 0,0:04:04.00,0:04:07.08,Default,,0,0,0,,Халлилуя, Халлилуя!
Dialogue: 0,0:04:07.08,0:04:11.33,Default,,0,0,0,,Бұл керемет деп ойламайсыз ба? ағасы Кенни
Dialogue: 0,0:04:11.33,0:04:12.54,Default,,0,0,0,,Сүйкімді...
Dialogue: 0,0:04:20.00,0:04:23.00,Default,,0,0,0,,Жарайды... қызықсыз кеңістік екен.
Dialogue: 0,0:04:23.00,0:04:25.04,Default,,0,0,0,,Дискотека ойнау, дискотека ойнау
Dialogue: 0,0:04:25.04,0:04:27.25,Default,,0,0,0,,Бұл дүкен емес...
Dialogue: 0,0:04:27.25,0:04:28.91,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:04:28.91,0:04:30.00,Default,,0,0,0,,Сыйақы
Dialogue: 0,0:04:31.70,0:04:34.45,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:04:34.45,0:04:36.12,Default,,0,0,0,,Амансың ба? Мисс
Dialogue: 0,0:04:36.12,0:04:38.62,Default,,0,0,0,,Бұл маңызды емес пе?
Dialogue: 0,0:04:38.62,0:04:41.25,Default,,0,0,0,,Бұл анамның естелігі, бірақ маған енді керегі жоқ.
Dialogue: 0,0:04:41.25,0:04:42.54,Default,,0,0,0,,Егер ол жылдамдықты арттырса, тіпті модель ұшақ болса да—
Dialogue: 0,0:04:42.54,0:04:43.91,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:04:45.13,0:04:46.62,Default,,0,0,0,,Дарш Занна
Dialogue: 0,0:04:46.62,0:04:51.16,Default,,0,0,0,,Ал, аға, айтпақшы, бүгін кешті көңілді өткізейік.
Dialogue: 0,0:04:51.16,0:04:56.16,Default,,0,0,0,,Әке, әлгі жас келіншек бірдеңе ойлап отыр емес пе?
Dialogue: 0,0:04:56.16,0:04:58.20,Default,,0,0,0,,Бұл сіздің көп уайымға толы жасыңыз.
Dialogue: 0,0:04:58.20,0:05:00.16,Default,,0,0,0,,Олар әртүрлі нәрселерді басынан өткерсін.
Dialogue: 0,0:05:00.16,0:05:03.62,Default,,0,0,0,,O, V, A және т.б.
Dialogue: 0,0:05:03.62,0:05:05.08,Default,,0,0,0,,Мен уайымдап тұрмын...
Dialogue: 0,0:05:12.91,0:05:14.04,Default,,0,0,0,,Маған су беріңізші
Dialogue: 0,0:05:15.29,0:05:16.37,Default,,0,0,0,,Егер бізге шабуыл жасалса, олар да араласып қалады.
Dialogue: 0,0:05:20.95,0:05:23.66,Default,,0,0,0,,Эй, көңілді жүрсің бе?
Dialogue: 0,0:05:23.66,0:05:24.43,Default,,0,0,0,,Жоғал
Dialogue: 0,0:05:24.43,0:05:26.04,Default,,0,0,0,,Мен жалықтым.
Dialogue: 0,0:05:26.04,0:05:29.01,Default,,0,0,0,,Сіз Тибурани аймағынан шыққан асыл адамсыз.
Dialogue: 0,0:05:29.50,0:05:30.75,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:05:30.75,0:05:32.83,Default,,0,0,0,,Мен де сол жақтанмын.
Dialogue: 0,0:05:46.37,0:05:51.54,Default,,0,0,0,,Иә? Бұл қарғыс атқыр ақсүйектердің сөздері жалықтырады.
Dialogue: 0,0:05:51.54,0:05:53.04,Default,,0,0,0,,Мен сенімен осында сөйлесе аламын ба?
Dialogue: 0,0:05:53.04,0:05:54.66,Default,,0,0,0,,Өз талаптарыңызды айтыңыз
Dialogue: 0,0:05:54.66,0:05:55.87,Default,,0,0,0,,Алып алу
Dialogue: 0,0:05:55.87,0:06:01.37,Default,,0,0,0,,Мен сен сияқты адамдарды жақсы көремін. Сіз қалай ойлайсыз? Келесі матч
Dialogue: 0,0:06:01.37,0:06:04.54,Default,,0,0,0,,Мен басқа біреуді іздеп жүрмін.
Dialogue: 0,0:06:04.54,0:06:07.16,Default,,0,0,0,,Әй, сен кімге қарап тұрсың?
Dialogue: 0,0:06:07.16,0:06:11.33,Default,,0,0,0,,Деннис Эльбажи - бұл жерде менеджер.
Dialogue: 0,0:06:11.33,0:06:12.87,Default,,0,0,0,,О, Деннис!
Dialogue: 0,0:06:12.87,0:06:15.00,Default,,0,0,0,,Деннис Деннис... Деннис!
Dialogue: 0,0:06:16.20,0:06:19.75,Default,,0,0,0,,Денис Елбаги менің досым. Оны саған таныстырайын ба?
Dialogue: 0,0:06:21.04,0:06:25.29,Default,,0,0,0,,Бұл бетті жасауды доғар да, менің артымнан жүр.
Dialogue: 0,0:06:27.50,0:06:28.91,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:06:31.08,0:06:34.54,Default,,0,0,0,,Осындай нәрселер, мен Деннис Елбагимін
Dialogue: 0,0:06:34.54,0:06:35.87,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:06:35.87,0:06:36.91,Default,,0,0,0,,Бөлек
Dialogue: 0,0:06:36.91,0:06:39.08,Default,,0,0,0,,А, қызықсыз.
Dialogue: 0,0:06:39.08,0:06:42.25,Default,,0,0,0,,Сонымен, жас ханым, сізге не керек?
Dialogue: 0,0:06:42.25,0:06:44.58,Default,,0,0,0,,Мен Тирана Экседирикамын
Dialogue: 0,0:06:44.58,0:06:46.92,Default,,0,0,0,,Милвуар рыцарлары жіберді
Dialogue: 0,0:06:47.13,0:06:48.79,Default,,0,0,0,,Хо, рыцарь ма?
Dialogue: 0,0:06:48.79,0:06:51.16,Default,,0,0,0,,Менде сіз туралы ақпарат бар.
Dialogue: 0,0:06:51.16,0:06:53.12,Default,,0,0,0,,Ертегіні қайтарып алайық
Dialogue: 0,0:06:53.12,0:06:54.91,Default,,0,0,0,,Га, бұл туралы.
Dialogue: 0,0:06:54.91,0:06:58.33,Default,,0,0,0,,Жоқ, мүмкін емес, өйткені бұл өнім.
Dialogue: 0,0:06:58.33,0:07:01.08,Default,,0,0,0,,Мен сіз иә деп жауап бересіз деп ойладым.
Dialogue: 0,0:07:01.08,0:07:03.29,Default,,0,0,0,,Сіз дайын сияқтысыз.
Dialogue: 0,0:07:03.29,0:07:05.37,Default,,0,0,0,,Осымен әңгіме аяқталды.
Dialogue: 0,0:07:08.95,0:07:10.41,Default,,0,0,0,,жетілмеген
Dialogue: 0,0:07:12.66,0:07:15.66,Default,,0,0,0,,Бұл сіз Дринидің қаруына сенгендіктен болады, т.б.
Dialogue: 0,0:07:15.66,0:07:17.12,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,0:07:17.12,0:07:21.25,Default,,0,0,0,,Қазіргі жастардың сүйегі жоқ деп қиналып жүр...
Dialogue: 0,0:07:22.45,0:07:24.04,Default,,0,0,0,,Мен жай ғана сұрайтын шығармын.
Dialogue: 0,0:07:24.04,0:07:25.91,Default,,0,0,0,,Сіздің мұғаліміңіз кім?
Dialogue: 0,0:07:25.91,0:07:27.70,Default,,0,0,0,,Мен саған үйретемін деген ниетім жоқ.
Dialogue: 0,0:07:27.70,0:07:28.91,Default,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,0:07:33.58,0:07:34.66,Default,,0,0,0,,Бұл жігіт...!
Dialogue: 0,0:07:37.54,0:07:41.00,Default,,0,0,0,,Менің трусикамды қазірден бастап көре аласыз, солай ма? Тирана-чан
Dialogue: 0,0:07:43.25,0:07:45.16,Default,,0,0,0,,Мені әлі өлтірме
Dialogue: 0,0:07:45.16,0:07:47.87,Default,,0,0,0,,Мен әртүрлі нәрселерді мұқият тыңдағым келеді.
Dialogue: 0,0:07:56.25,0:07:59.66,Default,,0,0,0,,Бұл салада даму алға жылжымайды.
Dialogue: 0,0:07:59.66,0:08:02.91,Default,,0,0,0,,Басқа дүниенің қалдықтары әлі де сақталған.
Dialogue: 0,0:08:02.91,0:08:06.83,Default,,0,0,0,,Тұрғындар жоқ, олар Долини қаласына қоныс аударды.
Dialogue: 0,0:08:06.83,0:08:11.20,Default,,0,0,0,,Егін өсірсең де, бір доллар да таппайсың.
Dialogue: 0,0:08:11.20,0:08:13.70,Default,,0,0,0,,Жер құдайының атын білесің бе?
Dialogue: 0,0:08:15.33,0:08:16.45,Default,,0,0,0,,Ақша
Dialogue: 0,0:08:16.45,0:08:18.58,Default,,0,0,0,,Оны түсіну өте оңай.
Dialogue: 0,0:08:18.58,0:08:20.70,Default,,0,0,0,,Мен де дінімді өзгерттім.
Dialogue: 0,0:08:29.08,0:08:32.12,Default,,0,0,0,,Мен сізді күттім, тақсыр.
Dialogue: 0,0:08:32.12,0:08:34.62,Default,,0,0,0,,Зелада Өнім дайын.
Dialogue: 0,0:08:34.62,0:08:36.88,Default,,0,0,0,,Иә, қараңызшы.
Dialogue: 0,0:08:37.45,0:08:39.45,Default,,0,0,0,,Мына ханым ше?
Dialogue: 0,0:08:39.45,0:08:40.87,Default,,0,0,0,,Милвуар сері.
Dialogue: 0,0:08:40.87,0:08:43.25,Default,,0,0,0,,Сіз менің дүкенімді қалай иіскедіңіз?
Dialogue: 0,0:08:43.25,0:08:45.41,Default,,0,0,0,,Бұл туралы мені тыңда.
Dialogue: 0,0:08:45.41,0:08:46.79,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:08:46.79,0:08:49.91,Default,,0,0,0,,Көру үшін бәрін айтып берейін.
Dialogue: 0,0:08:53.95,0:08:57.33,Default,,0,0,0,,Енді, Карим мырза, іскерлік келіссөздерді аяқтайық.
Dialogue: 0,0:09:00.08,0:09:02.33,Default,,0,0,0,,Бұл өте жаман...
Dialogue: 0,0:09:05.25,0:09:06.54,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:09:06.54,0:09:08.75,Default,,0,0,0,,Бұл Hightails ескі храмы.
Dialogue: 0,0:09:08.75,0:09:11.41,Default,,0,0,0,,Бұл тасымалдаушының жазбаларына сәйкес келеді.
Dialogue: 0,0:09:11.41,0:09:12.87,Default,,0,0,0,,Бақылауды жалғастыру
Dialogue: 0,0:09:12.87,0:09:15.00,Default,,0,0,0,,SWAT сізге қарай бет алды
Dialogue: 0,0:09:15.00,0:09:16.37,Default,,0,0,0,,Қашан келесіз?
Dialogue: 0,0:09:16.37,0:09:17.62,Default,,0,0,0,,30 минуттан кейін
Dialogue: 0,0:09:17.62,0:09:20.12,Default,,0,0,0,,Соншама? Өтінемін, асығыңыз
Dialogue: 0,0:09:20.12,0:09:21.54,Default,,0,0,0,,Ақылсыз қозғалма
Dialogue: 0,0:09:23.29,0:09:25.08,Default,,0,0,0,,Мұны тезірек жасаған дұрыс
Dialogue: 0,0:09:28.54,0:09:31.45,Default,,0,0,0,,Кешіріңіз, сақ болыңыз.
Dialogue: 0,0:09:31.45,0:09:32.83,Default,,0,0,0,,Жауап алу
Dialogue: 0,0:09:32.83,0:09:35.16,Default,,0,0,0,,Мен жақында қайтамын.
Dialogue: 0,0:09:52.91,0:09:53.91,Default,,0,0,0,,Өрт?
Dialogue: 0,0:09:59.00,0:10:00.20,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:10:04.25,0:10:08.00,Default,,0,0,0,,О, құдай-ау, мен Дон Кихот боп жүрмін бе...
Dialogue: 0,0:10:20.16,0:10:21.58,Default,,0,0,0,,Әй, тыныш тұр!
Dialogue: 0,0:10:30.87,0:10:32.45,Default,,0,0,0,,Эй, сен мұнда не істеп жүрсің?
Dialogue: 0,0:10:33.62,0:10:35.00,Default,,0,0,0,,Бұл жұмыс!
Dialogue: 0,0:10:36.45,0:10:39.54,Default,,0,0,0,,Кез келген жағдайда! Бұл полиция! Қаруыңызды тастаңыз...
Dialogue: 0,0:10:41.79,0:10:43.79,Default,,0,0,0,,Иә, солай ойладым.
Dialogue: 0,0:10:49.54,0:10:51.50,Default,,0,0,0,,Пері қайда! Айтыңызшы!
Dialogue: 0,0:11:14.87,0:11:16.37,Default,,0,0,0,,Қандай сұмдық...
Dialogue: 0,0:11:16.87,0:11:20.00,Default,,0,0,0,,Мен жақсырақпын...
Dialogue: 0,0:11:20.00,0:11:25.20,Default,,0,0,0,,Олардан есірткі жасау үшін ақша керек емес пе?
Dialogue: 0,0:11:25.20,0:11:27.91,Default,,0,0,0,,Жаңа өнімдерге инвестицияланған
Dialogue: 0,0:11:27.91,0:11:31.97,Default,,0,0,0,,Міне, осындай өрттен кейін мен қатты күйзелемін.
Dialogue: 0,0:11:31.79,0:11:33.04,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:11:33.04,0:11:34.95,Default,,0,0,0,,О, сен ашулысың ба?
Dialogue: 0,0:11:34.95,0:11:38.62,Default,,0,0,0,,Перілер киелі, қол тигізбейді.
Dialogue: 0,0:11:38.62,0:11:40.79,Default,,0,0,0,,Міне, сен...!
Dialogue: 0,0:11:40.79,0:11:43.29,Default,,0,0,0,,Бұл жаңа өнім.
Dialogue: 0,0:11:44.29,0:11:46.04,Default,,0,0,0,,Перілерді құрал ретінде пайдалану
Dialogue: 0,0:11:46.04,0:11:51.16,Default,,0,0,0,,Айналадан бірнеше шақырым жердегі адамдарды тез ертегі шаңына тәуелді етеді.
Dialogue: 0,0:11:51.16,0:11:53.66,Default,,0,0,0,,Қаласаңыз, психикалық бомба.
Dialogue: 0,0:11:53.66,0:11:56.29,Default,,0,0,0,,Мен жақсырақ есім іздеп жүрмін.
Dialogue: 0,0:11:56.29,0:11:58.12,Default,,0,0,0,,Қорқынышты нәрселер...
Dialogue: 0,0:11:58.12,0:12:00.87,Default,,0,0,0,,Сен енді адам емессің!
Dialogue: 0,0:12:00.87,0:12:04.12,Default,,0,0,0,,Адам? Бұл адам
Dialogue: 0,0:12:04.12,0:12:07.79,Default,,0,0,0,,Мен де о дүниеде өскен самурайлар отбасының баласымын.
Dialogue: 0,0:12:07.79,0:12:09.45,Default,,0,0,0,,Қылыш шеберлігі Атты шеберлік
Dialogue: 0,0:12:09.45,0:12:11.20,Default,,0,0,0,,Қасиетті рәсімдердегі сиқыр
Dialogue: 0,0:12:11.20,0:12:13.20,Default,,0,0,0,,Барлығы соғылған
Dialogue: 0,0:12:13.20,0:12:16.45,Default,,0,0,0,,Сонда оны біліксіз патшалар мен ақсүйектер тобы пайдаланды ма?
Dialogue: 0,0:12:16.45,0:12:19.45,Default,,0,0,0,,Біздің аумақ үшін соғысып жатқанымыз таңқаларлық емес.
Dialogue: 0,0:12:19.45,0:12:23.04,Default,,0,0,0,,Құрметті өмір енді аяқталды. Мен құсып жатырмын.
Dialogue: 0,0:12:24.62,0:12:26.75,Default,,0,0,0,,Алайда жер басқаша.
Dialogue: 0,0:12:26.75,0:12:29.00,Default,,0,0,0,,Американдық арман дегеніміз не?
Dialogue: 0,0:12:30.20,0:12:32.16,Default,,0,0,0,,Мен саған айттым ба? ақша
Dialogue: 0,0:12:32.16,0:12:36.37,Default,,0,0,0,,Ақшаң болса, бәрі орындалады! Бұл адамға көбірек ұқсайды!
Dialogue: 0,0:12:39.58,0:12:43.70,Default,,0,0,0,,Сонда Тирана-чан да ақымақтардың бірі ғой? Өте жаман...
Dialogue: 0,0:12:43.70,0:12:45.54,Default,,0,0,0,,Бұрыштарды кесудің қажеті жоқ...
Dialogue: 0,0:12:48.00,0:12:49.58,Default,,0,0,0,,Биле, биле!
Dialogue: 0,0:12:50.95,0:12:55.83,Default,,0,0,0,,Сора Сора! Біраз уақыттан кейін кеуделеріңіз жалаңаш болады!
Dialogue: 0,0:12:55.83,0:12:57.83,Default,,0,0,0,,Қылышым болса...!
Dialogue: 0,0:12:57.83,0:12:58.83,Default,,0,0,0,,Тирана!
Dialogue: 0,0:13:07.76,0:13:11.37,Default,,0,0,0,,Иә? Бұл позиция сол Вредени фракциясы семсер ме?
Dialogue: 0,0:13:11.37,0:13:14.75,Default,,0,0,0,,Мен саған үйрететін қылыш атым жоқ дедім ғой!
Dialogue: 0,0:13:14.75,0:13:16.25,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:13:16.25,0:13:17.70,Default,,0,0,0,,Мен сізге көмектесе аламын ба?
Dialogue: 0,0:13:17.70,0:13:20.25,Default,,0,0,0,,Пайдасыз! Мен бұл адамды өлтіремін!
Dialogue: 0,0:13:22.04,0:13:23.91,Default,,0,0,0,,Жарайды! Жаса!
Dialogue: 0,0:13:33.25,0:13:34.54,Default,,0,0,0,,Бұл әуесқой...
Dialogue: 0,0:13:44.04,0:13:46.12,Default,,0,0,0,,Өлер алдында айтамын
Dialogue: 0,0:13:46.12,0:13:49.12,Default,,0,0,0,,Менің қожайынымның аты - Лорд Галада Вредени.
Dialogue: 0,0:13:49.12,0:13:52.29,Default,,0,0,0,,Аспан асты дүниесінің жындарын үйрет
Dialogue: 0,0:13:52.29,0:13:54.25,Default,,0,0,0,,Бля саған...
Dialogue: 0,0:13:58.66,0:14:02.83,Default,,0,0,0,,Жарайсың, мен болсам төбемнен домалап қашып кетер едім.
Dialogue: 0,0:14:02.83,0:14:04.04,Default,,0,0,0,,Ол қауіпті бейбақ.
Dialogue: 0,0:14:04.04,0:14:05.91,Default,,0,0,0,,Ол айбатты жау болды.
Dialogue: 0,0:14:05.91,0:14:08.79,Default,,0,0,0,,Сонымен не? Сол көзқарас
Dialogue: 0,0:14:08.79,0:14:10.62,Default,,0,0,0,,Қарама!
Dialogue: 0,0:14:10.62,0:14:12.41,Default,,0,0,0,,Бұл менің хоббиім емес.
Dialogue: 0,0:14:12.41,0:14:15.29,Default,,0,0,0,,Ей, тез қозғалайық.
Dialogue: 0,0:14:15.29,0:14:17.41,Default,,0,0,0,,Күте тұрыңыз, ол бала әлі жоқ...
Dialogue: 0,0:14:19.87,0:14:20.91,Default,,0,0,0,,(Иида) Турбо Герой Ингениумды білесің бе?
Dialogue: 0,0:14:20.91,0:14:22.16,Default,,0,0,0,,Не?
Dialogue: 0,0:14:23.29,0:14:24.79,Default,,0,0,0,,Жай қуыршақ
Dialogue: 0,0:14:26.08,0:14:27.83,Default,,0,0,0,,Латенаны сезінбейді
Dialogue: 0,0:14:27.83,0:14:30.16,Default,,0,0,0,,Шынайы нәрсе алыс
Dialogue: 0,0:14:30.16,0:14:31.87,Default,,0,0,0,,Оны біреу алып кетті ме?
Dialogue: 0,0:14:31.87,0:14:33.91,Default,,0,0,0,,Тыныш алаңдаулы
Dialogue: 0,0:14:37.20,0:14:38.20,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:14:42.00,0:14:44.70,Default,,0,0,0,,Жаңа іздер
Dialogue: 0,0:14:44.70,0:14:50.20,Default,,0,0,0,,Анау қызыл сиқыршы баланы қақпанға түсірген бомбаны алып қашып кетті.
Dialogue: 0,0:14:50.20,0:14:51.91,Default,,0,0,0,,Қуып бара жатқанда түсіндіріңіз
Dialogue: 0,0:14:51.91,0:14:53.00,Default,,0,0,0,,Кеттік, Кей.
Dialogue: 0,0:14:54.12,0:14:56.25,Default,,0,0,0,,Психикалық бомба?
Dialogue: 0,0:14:56.25,0:14:57.95,Default,,0,0,0,,Мен егжей-тегжейлі логиканы түсінбеймін, бірақ
Dialogue: 0,0:14:57.95,0:15:01.50,Default,,0,0,0,,22-ші бөлімшедегі адамдарға неліктен шабуыл жасалғаны түсіндірілмейді.
Dialogue: 0,0:15:01.50,0:15:04.33,Default,,0,0,0,,Әлгі сиқыршы Зелада оны алып кетті.
Dialogue: 0,0:15:04.33,0:15:06.25,Default,,0,0,0,,Оны пайдалансаң, апат болады.
Dialogue: 0,0:15:06.25,0:15:09.87,Default,,0,0,0,,Бір сәтте ондаған мың адам якудзаға айналуы мүмкін.
Dialogue: 0,0:15:09.87,0:15:13.16,Default,,0,0,0,,Осылайша сіз оны өз қалауыңыз бойынша басқара аласыз...
Dialogue: 0,0:15:13.16,0:15:15.66,Default,,0,0,0,,Тыныш, бала өте жақын.
Dialogue: 0,0:15:23.29,0:15:24.29,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,0:15:25.04,0:15:27.79,Default,,0,0,0,,Қолдарыңызды баяу көтеріңіз.
Dialogue: 0,0:15:29.70,0:15:34.08,Default,,0,0,0,,Әй, сен... өткен күні алдамшы детектив болдың.
Dialogue: 0,0:15:34.08,0:15:35.50,Default,,0,0,0,,Мынау
Dialogue: 0,0:15:35.50,0:15:36.75,Default,,0,0,0,,Абайлаңыз, Кей!
Dialogue: 0,0:15:38.70,0:15:42.75,Default,,0,0,0,,Бұл Риктің аты. Мен сені өмірімнің соңына дейін қиналамын.
Dialogue: 0,0:15:42.75,0:15:45.37,Default,,0,0,0,,Е-е... қарияға не ұят.
Dialogue: 0,0:15:45.37,0:15:47.75,Default,,0,0,0,,Тым болмаса мейіріміңді төгіп көр...
Dialogue: 0,0:15:47.75,0:15:51.00,Default,,0,0,0,,Шулы! сені тұтқындаймын
Dialogue: 0,0:15:51.00,0:15:53.66,Default,,0,0,0,,Матобаны ұстап алған сияқтысыз.
Dialogue: 0,0:15:55.16,0:15:56.37,Default,,0,0,0,,А... Бастық?
Dialogue: 0,0:15:57.20,0:15:59.73,Default,,0,0,0,,SWAT оны да бақылауға алады.
Dialogue: 0,0:16:00.29,0:16:03.23,Default,,0,0,0,,Террористік тапсырыс беруші де қамауға алынды
Dialogue: 0,0:16:04.08,0:16:07.91,Default,,0,0,0,,Бәрінен де артық... Бірақ мұнда неге?
Dialogue: 0,0:16:07.91,0:16:09.25,Default,,0,0,0,,Мынау
Dialogue: 0,0:16:10.87,0:16:13.20,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:16:13.20,0:16:14.83,Default,,0,0,0,,Ер адамды жіберіңіз
Dialogue: 0,0:16:17.45,0:16:19.58,Default,,0,0,0,,Менің көлігімді пайдаланыңыз
Dialogue: 0,0:16:19.58,0:16:21.54,Default,,0,0,0,,Көмегіңіз үшін рахмет, Росс мырза.
Dialogue: 0,0:16:21.54,0:16:22.54,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:16:24.04,0:16:25.87,Default,,0,0,0,,Мылтығыңды лақтыр, Матоба.
Dialogue: 0,0:16:25.87,0:16:27.20,Default,,0,0,0,,Бас…
Dialogue: 0,0:16:27.20,0:16:28.58,Default,,0,0,0,,Оны лақтырыңыз
Dialogue: 0,0:16:32.66,0:16:36.16,Default,,0,0,0,,Дұрыс, бұл Матоба-сама болатын.
Dialogue: 0,0:16:36.16,0:16:38.45,Default,,0,0,0,,Барлығы күшті және мойынсұнғыш
Dialogue: 0,0:16:38.45,0:16:42.08,Default,,0,0,0,,Мен сені сол батпақта кездескендегіден басқа адам сияқтысың.
Dialogue: 0,0:16:47.12,0:16:48.62,Default,,0,0,0,,Сіз...
Dialogue: 0,0:16:48.62,0:16:49.91,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:16:49.91,0:16:53.08,Default,,0,0,0,,Сол соғыс кезіндегі менің әскерлерім!
Dialogue: 0,0:16:53.08,0:16:55.20,Default,,0,0,0,,(Әкесінің жылауы)
Dialogue: 0,0:16:56.45,0:16:58.25,Default,,0,0,0,,Матобаны қозғалтпаңыз
Dialogue: 0,0:16:58.25,0:17:01.04,Default,,0,0,0,,А... бұл жігіт Рик...
Dialogue: 0,0:17:01.04,0:17:05.62,Default,,0,0,0,,Сіз оған тергеу барысын жеткіздіңіз бе?
Dialogue: 0,0:17:05.62,0:17:08.16,Default,,0,0,0,,Иә, мұның бәрі мен.
Dialogue: 0,0:17:08.16,0:17:12.79,Default,,0,0,0,,Мен сізді ұстап тұру үшін тәжірибесіз Семани жалдадым.
Dialogue: 0,0:17:12.79,0:17:16.12,Default,,0,0,0,,Ол сондай-ақ Альвареске қастандық машинасын жіберді.
Dialogue: 0,0:17:16.12,0:17:20.12,Default,,0,0,0,,Ол Зеладаға ғибадатхананың бұзылғанын хабарлаған.
Dialogue: 0,0:17:20.12,0:17:21.87,Default,,0,0,0,,Ол Рикті өлтірді ме?
Dialogue: 0,0:17:23.16,0:17:24.95,Default,,0,0,0,,Жауап!
Dialogue: 0,0:17:24.95,0:17:27.25,Default,,0,0,0,,Фьюри түсінетін болды
Dialogue: 0,0:17:27.25,0:17:29.33,Default,,0,0,0,,Мұндай жағдайдың болуы сөзсіз еді.
Dialogue: 0,0:17:30.95,0:17:32.25,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:17:32.25,0:17:34.62,Default,,0,0,0,,Росс Тек сізге...
Dialogue: 0,0:17:34.62,0:17:35.95,Default,,0,0,0,,Бұл қандай да бір «Гя●ган» ба?!
Dialogue: 0,0:17:35.95,0:17:37.83,Default,,0,0,0,,Мүдделердің сәйкестігі
Dialogue: 0,0:17:37.83,0:17:42.33,Default,,0,0,0,,Бұл адам Зелада жер өркениетін жек көреді.
Dialogue: 0,0:17:42.33,0:17:46.16,Default,,0,0,0,,Жер мен Семани әлемі арасында өшпенділік тудыратын терроризм
Dialogue: 0,0:17:46.16,0:17:49.04,Default,,0,0,0,,Бұл ортақ мақсат
Dialogue: 0,0:17:49.04,0:17:53.12,Default,,0,0,0,,Татуласу мен бірге өмір сүру - идеалистік нонсенс.
Dialogue: 0,0:17:53.12,0:17:55.66,Default,,0,0,0,,Біз және олар бір-бірімізді ешқашан түсінбейміз
Dialogue: 0,0:17:55.66,0:17:57.54,Default,,0,0,0,,Бөлуден басқа амал жоқ
Dialogue: 0,0:17:57.54,0:18:00.45,Default,,0,0,0,,Бірақ кейбір адамдар бейімделеді.
Dialogue: 0,0:18:00.45,0:18:03.83,Default,,0,0,0,,Оның бейімделгіштігі қорқынышты.
Dialogue: 0,0:18:03.83,0:18:06.45,Default,,0,0,0,,Мына семанилердің өміршеңдігін қараңыз.
Dialogue: 0,0:18:06.45,0:18:11.04,Default,,0,0,0,,Үш ұрпақтан кейін Жер қоғамы олардың бақылауында болады.
Dialogue: 0,0:18:11.04,0:18:13.50,Default,,0,0,0,,Инвазия ешкімді байқамай-ақ болады...
Dialogue: 0,0:18:13.50,0:18:18.41,Default,,0,0,0,,Дұрыс... Нақты басқыншылар да байқамай жүре береді.
Dialogue: 0,0:18:20.45,0:18:24.00,Default,,0,0,0,,Біз әлемді олардың қауіптілігі туралы хабардар етуіміз керек.
Dialogue: 0,0:18:24.00,0:18:28.91,Default,,0,0,0,,Сол себепті бұл психикалық бомба қоғамның инфрақұрылымына зиян тигізбеді.
Dialogue: 0,0:18:28.91,0:18:33.12,Default,,0,0,0,,Өйткені ол адамдар арасында қорқыныш тудыруы мүмкін.
Dialogue: 0,0:18:33.12,0:18:36.91,Default,,0,0,0,,Полицейдің айтқаны!
Dialogue: 0,0:18:36.91,0:18:41.58,Default,,0,0,0,,Мен полиция қызметкерімін... онда мен оған дейін жерлікпін.
Dialogue: 0,0:18:43.16,0:18:47.62,Default,,0,0,0,,Кей матова Түсінетін шығарсың деп ойладым.
Dialogue: 0,0:18:47.62,0:18:50.79,Default,,0,0,0,,Жолдас болайық, блять.
Dialogue: 0,0:18:50.79,0:18:52.75,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:18:52.75,0:18:55.91,Default,,0,0,0,,Сіздің тобығыңызда әрқашан револьвер тығылған болатын.
Dialogue: 0,0:18:55.91,0:18:57.50,Default,,0,0,0,,Сіз көріңіз.
Dialogue: 0,0:19:22.00,0:19:26.70,Default,,0,0,0,,Мен сені ойладым... әкем сияқты...
Dialogue: 0,0:19:26.70,0:19:27.87,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:19:29.54,0:19:31.29,Default,,0,0,0,,мен оны өзім қорғауым керек дегендей
Dialogue: 0,0:19:34.79,0:19:35.79,Default,,0,0,0,,Кей
Dialogue: 0,0:19:36.41,0:19:38.29,Default,,0,0,0,,Жоқ... бәрібір.
Dialogue: 0,0:19:38.29,0:19:39.75,Default,,0,0,0,,Сіз жақсы өмір сүрдіңіз.
Dialogue: 0,0:19:42.12,0:19:43.45,Default,,0,0,0,,Жинақталған
Dialogue: 0,0:19:43.45,0:19:44.54,Default,,0,0,0,,Мен де
Dialogue: 0,0:19:48.58,0:19:50.08,Default,,0,0,0,,Мен оны қуамын.
Dialogue: 0,0:19:50.08,0:19:51.33,Default,,0,0,0,,Гелада ше?
Dialogue: 0,0:19:51.33,0:19:53.91,Default,,0,0,0,,Мен сол бомбаны бірден қолданамын.
Dialogue: 0,0:19:56.95,0:20:00.95,Default,,0,0,0,,Бастықтың көлігі Королева алқабындағы Орман мұнарасынан табылды.
Dialogue: 0,0:20:00.95,0:20:02.79,Default,,0,0,0,,Одаққа қатысты оқиғалар немесе байқаулар туралы ешқандай хабар жоқ
Dialogue: 0,0:20:02.79,0:20:05.58,Default,,0,0,0,,Кей: Бастық туралы...
Dialogue: 0,0:20:05.58,0:20:08.12,Default,,0,0,0,,Мен кейінірек сөйлесемін. Шарттарды жасаңыз.
Dialogue: 0,0:20:09.45,0:20:13.29,Default,,0,0,0,,Орман мұнарасы Қаладағы ең биік ғимараттардың бірі
Dialogue: 0,0:20:13.29,0:20:15.50,Default,,0,0,0,,Психикалық бомба бар ма?
Dialogue: 0,0:20:15.50,0:20:19.20,Default,,0,0,0,,Егер шатырда қолданылса, ол жерге қарағанда тиімдірек болуы мүмкін.
Dialogue: 0,0:20:19.20,0:20:20.33,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:20:20.33,0:20:23.00,Default,,0,0,0,,Бұл ядролық бомбамен бірдей ме?
Dialogue: 0,0:20:23.00,0:20:24.50,Default,,0,0,0,,Бұл қандай жер?
Dialogue: 0,0:20:24.50,0:20:28.79,Default,,0,0,0,,Қарапайым адамдарға қатысы жоқ байларға толы дүние.
Dialogue: 0,0:20:28.79,0:20:31.87,Default,,0,0,0,,Зелада ойнауды кенеттен тоқтату ақымақтық сияқты.
Dialogue: 0,0:20:33.37,0:20:35.70,Default,,0,0,0,,Бұл жай ғана әзіл екенін білемін.
Dialogue: 0,0:20:35.70,0:20:36.87,Default,,0,0,0,,жақсы
Dialogue: 0,0:20:38.00,0:20:38.83,Default,,0,0,0,,Кей
Dialogue: 0,0:20:38.83,0:20:40.25,Default,,0,0,0,,Не?
Dialogue: 0,0:20:40.25,0:20:43.70,Default,,0,0,0,,Сіз бұл сиқыршы Зеладаны білесіз бе?
Dialogue: 0,0:20:45.54,0:20:49.08,Default,,0,0,0,,Маған ол жай ғана қылмыскер.
Dialogue: 0,0:20:55.75,0:20:58.66,Default,,0,0,0,,Әлгі сиқыршы... бұл Зеладаның жұмысы.
Dialogue: 0,0:20:59.75,0:21:00.75,Default,,0,0,0,,Жоғары!
Dialogue: 0,0:21:01.87,0:21:03.37,Default,,0,0,0,,Ол қауіпті ме?
Dialogue: 0,0:21:03.37,0:21:05.79,Default,,0,0,0,,Сиқыршының күші жалған емес.
Dialogue: 0,0:21:05.79,0:21:08.66,Default,,0,0,0,,Жауынгерді соқыр етіп, улы отты босатыңыз
Dialogue: 0,0:21:08.66,0:21:10.83,Default,,0,0,0,,Қаруларыңыз ше...
Dialogue: 0,0:21:10.83,0:21:14.45,Default,,0,0,0,,Бұл мен көптен бері қолданып жүрген жақсы мылтық.
Dialogue: 0,0:21:14.45,0:21:17.79,Default,,0,0,0,,Долини мылтықтарының жаны жоқ.
Dialogue: 0,0:21:17.79,0:21:23.16,Default,,0,0,0,,Жоқ... бұл әлсіз, бірақ мен бұл мылтықтан латена сезініп тұрмын.
Dialogue: 0,0:21:24.25,0:21:27.79,Default,,0,0,0,,Латена кез келген нысанда тұрады, егер сіздің сезімдеріңіз онымен толтырылса.
Dialogue: 0,0:21:34.62,0:21:39.50,Default,,0,0,0,,Мені тастама, Кей. Жаудың тосын шабуылын мен ғана көре аламын.
Dialogue: 0,0:21:39.50,0:21:40.95,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:40.95,0:21:43.16,Default,,0,0,0,,Маған сеніңіз, досым.
Dialogue: 0,0:21:44.95,0:21:46.16,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:21:49.33,0:21:50.37,Default,,0,0,0,,Сагаре!
Dialogue: 0,0:21:51.70,0:21:53.29,Default,,0,0,0,,Алға... Жүгір!
Dialogue: 0,0:21:55.33,0:21:58.70,Default,,0,0,0,,Сол жалынға соқсам, өкпем күйіп, дем алмай қалар едім.
Dialogue: 0,0:21:58.70,0:22:01.04,Default,,0,0,0,,Тұншығудан өлім Қарғыс атсын.
Dialogue: 0,0:22:02.12,0:22:03.25,Default,,0,0,0,,Міне!
Dialogue: 0,0:22:06.62,0:22:07.75,Default,,0,0,0,,Лея!
Dialogue: 0,0:23:42.75,0:23:44.62,Default,,0,0,0,,Келесі COP CRAFT
Dialogue: 0,0:22:29.98,0:22:34.27,Default,,0,0,0,,Неве Сия Дарш Занна
Dialogue: 0,0:22:34.46,0:22:38.46,Default,,0,0,0,,Бұл дүниенің соңында
Dialogue: 0,0:22:38.52,0:22:43.01,Default,,0,0,0,,Дұға еткендей сыбырлау
Dialogue: 0,0:22:43.25,0:22:47.09,Default,,0,0,0,,Мен қолымды создым
Dialogue: 0,0:22:47.09,0:22:51.54,Default,,0,0,0,,өте маңызды
Dialogue: 0,0:22:51.54,0:22:56.04,Default,,0,0,0,,Өйткені заттар көзге көрінбейді
Dialogue: 0,0:22:56.04,0:22:59.11,Default,,0,0,0,,Енді алға күтіңіз.
Dialogue: 0,0:22:59.11,0:23:04.03,Default,,0,0,0,,Осы сезімді сезін
Dialogue: 0,0:23:04.14,0:23:08.62,Default,,0,0,0,,Dark Future Slash
Dialogue: 0,0:23:08.62,0:23:12.90,Default,,0,0,0,,Жаныңның дауысын тыңда
Dialogue: 0,0:23:12.90,0:23:14.69,Default,,0,0,0,,Ертең әлі көрінбейді
Dialogue: 0,0:23:14.69,0:23:17.01,Default,,0,0,0,,Жаңа әлем
Dialogue: 0,0:23:17.01,0:23:21.10,Default,,0,0,0,,Уақыт пен кеңістіктен тыс екі сот бір-бірімен байланысты
Dialogue: 0,0:23:21.10,0:23:25.63,Default,,0,0,0,,Енді қорқатын ештеңе жоқ
Dialogue: 0,0:23:25.63,0:23:29.91,Default,,0,0,0,,Біріктірілген қолымызда емес
Dialogue: 0,0:23:29.91,0:23:33.83,Default,,0,0,0,,Сиқырланып, мекендеген жан
Dialogue: 0,0:23:33.95,0:23:38.01,Default,,0,0,0,,Жүрегімде мақтанышпен, Мен сенген нәрсеге сендім.
Dialogue: 0,0:23:38.01,0:23:40.07,Default,,0,0,0,,Жолға шығыңыз
Dialogue: 0,0:23:46.12,0:23:52.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory