Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.67,0:00:14.68,Default,,0,0,0,,♪～
Dialogue: 0,0:01:39.93,0:01:41.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:47.02,0:01:50.02,Default,,0,0,0,,Какемакумо Данышпан
Dialogue: 0,0:01:50.10,0:01:54.28,Default,,0,0,0,,Брахиозавр Ұлы Құдай
Dialogue: 0,0:01:54.36,0:02:00.32,Default,,0,0,0,,Біз шөпқоректілер күн сайын өмірге қауіп төндіретін қауіпке тап боламыз.
Dialogue: 0,0:02:00.82,0:02:05.91,Default,,0,0,0,,Түрлі иллюзияларды елестету, оларды тазарту...
Dialogue: 0,0:02:06.41,0:02:08.54,Default,,0,0,0,,Әй, амулет сатып алайық.
Dialogue: 0,0:02:08.62,0:02:11.21,Default,,0,0,0,,Ал, шоттар арзанырақ.
Dialogue: 0,0:02:11.29,0:02:13.84,Default,,0,0,0,,Жарайды, ақшаңа сараң болма.
Dialogue: 0,0:02:13.92,0:02:15.80,Default,,0,0,0,,Қалай болғанда да, бұл босаңсытады.
Dialogue: 0,0:02:15.88,0:02:16.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:16.55,0:02:20.89,Default,,0,0,0,,Мені қорға, бақытты бол...
Dialogue: 0,0:02:20.97,0:02:23.05,Default,,0,0,0,,Келіңдер, келіңдер, келіңдер, бәріміз.
Dialogue: 0,0:02:23.14,0:02:28.48,Default,,0,0,0,,Тірі жеп қалмас үшін тазарып, дұға ет.
Dialogue: 0,0:02:29.81,0:02:32.98,Default,,0,0,0,,Бұл мерекеге келетін шөпқоректілер
Dialogue: 0,0:02:33.52,0:02:36.57,Default,,0,0,0,,Тамақ іше алатын позициядан кездейсоқ ләззат алу.
Dialogue: 0,0:02:36.65,0:02:39.15,Default,,0,0,0,,Барлығы көңілді жігіттер.
Dialogue: 0,0:02:40.07,0:02:42.66,Default,,0,0,0,,Бірақ бұл бала басқаша.
Dialogue: 0,0:02:43.32,0:02:45.24,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:02:45.33,0:02:47.16,Default,,0,0,0,,Күн сайын мен «бүгін өліп қалуым мүмкін» деп ойлаймын.
Dialogue: 0,0:02:47.25,0:02:48.96,Default,,0,0,0,,Мен өмірімді ойланып өткіздім
Dialogue: 0,0:02:49.50,0:02:53.13,Default,,0,0,0,,Онда не үшін университетке түсесің?
Dialogue: 0,0:02:53.21,0:02:54.71,Default,,0,0,0,,Мен бүгін өлуім мүмкін
Dialogue: 0,0:02:54.79,0:02:58.42,Default,,0,0,0,,Иә? Бірақ бұл мен бұл басқа.
Dialogue: 0,0:02:58.51,0:03:00.68,Default,,0,0,0,,Өйткені менің өлгім келмейді.
Dialogue: 0,0:03:00.76,0:03:04.55,Default,,0,0,0,,Қашан өлетінімді білмесем де, Армандап, еңбектенемін.
Dialogue: 0,0:03:05.60,0:03:07.10,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:03:08.02,0:03:11.81,Default,,0,0,0,,Сол баланың сезіміне сіңген қан мен ет
Dialogue: 0,0:03:11.90,0:03:14.56,Default,,0,0,0,,Оның дәмі қандай?
Dialogue: 0,0:03:16.11,0:03:17.82,Default,,0,0,0,,Профессор Лумрон
Dialogue: 0,0:03:18.57,0:03:19.53,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:20.11,0:03:22.16,Default,,0,0,0,,Жоқ, қауын
Dialogue: 0,0:03:23.24,0:03:26.83,Default,,0,0,0,,Құлағымның, бүйірімнің қарызын өтеуге келдім.
Dialogue: 0,0:03:27.83,0:03:29.37,Default,,0,0,0,,Сіз...
Dialogue: 0,0:03:30.25,0:03:33.96,Default,,0,0,0,,О, сен тірісің!
Dialogue: 0,0:03:34.04,0:03:36.54,Default,,0,0,0,,Сен тағы да өлтіруге келдің бе?
Dialogue: 0,0:03:36.63,0:03:41.22,Default,,0,0,0,,Бірақ, өкінішке орай, менде бүгін кешке маңызды нәрсе істеу керек.
Dialogue: 0,0:03:41.30,0:03:43.18,Default,,0,0,0,,Күнді өзгертіңіз
Dialogue: 0,0:03:43.76,0:03:45.43,Default,,0,0,0,,Ол бала келмейді.
Dialogue: 0,0:03:45.51,0:03:46.68,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:46.76,0:03:47.81,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:03:47.89,0:03:51.35,Default,,0,0,0,,«Хару-чан»? Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:03:51.43,0:03:53.69,Default,,0,0,0,,Мен оның орнына сені алуға келдім!
Dialogue: 0,0:03:54.56,0:03:55.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:57.52,0:03:59.65,Default,,0,0,0,,(қадамдық дыбыс)
Dialogue: 0,0:04:00.15,0:04:03.36,Default,,0,0,0,,Бұл аздап ұрлау. Ұрлау.
Dialogue: 0,0:04:07.41,0:04:10.04,Default,,0,0,0,,Әй, дұрыстап түсіндіріңізші.
Dialogue: 0,0:04:13.87,0:04:16.25,Default,,0,0,0,,Шу шығаруды тоқтатыңыз!
Dialogue: 0,0:04:17.79,0:04:20.96,Default,,0,0,0,,Сіз нені айтасыз? Мен Чикон фестиваліне барамын
Dialogue: 0,0:04:21.46,0:04:24.26,Default,,0,0,0,,Мен білемін, бірақ...
Dialogue: 0,0:04:24.34,0:04:25.26,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:04:26.01,0:04:28.01,Default,,0,0,0,,Біз өткен күні «тамақтану» туралы айтқан әңгіме—
Dialogue: 0,0:04:28.10,0:04:29.97,Default,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:04:30.06,0:04:32.02,Default,,0,0,0,,Мен саған мені жалғыз қалдыр дедім!
Dialogue: 0,0:04:32.10,0:04:33.94,Default,,0,0,0,,Сізге бұлай кездесудің әзіл болғанын айтсаңыз болғаны...
Dialogue: 0,0:04:34.02,0:04:35.90,Default,,0,0,0,,Ол сіз қалжыңдайтын адам емес!
Dialogue: 0,0:04:35.98,0:04:37.06,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:04:37.15,0:04:40.11,Default,,0,0,0,,Уәде еткеніңіз жай ғана университет оқытушысы емес еді.
Dialogue: 0,0:04:40.19,0:04:41.57,Default,,0,0,0,,Бэк нарықтың басшысы
Dialogue: 0,0:04:41.65,0:04:44.28,Default,,0,0,0,,Ол Легосиді екі рет өлтірмек болған қатыгез жігіт.
Dialogue: 0,0:04:45.28,0:04:45.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:46.41,0:04:47.20,Default,,0,0,0,,(Харудың таңданысы)
Dialogue: 0,0:04:50.24,0:04:52.54,Default,,0,0,0,,Бүгін осында болыңыз.
Dialogue: 0,0:04:52.62,0:04:54.87,Default,,0,0,0,,А, менің қарным ашты.
Dialogue: 0,0:04:55.37,0:04:56.54,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:04:57.17,0:04:58.33,Default,,0,0,0,,Не жақсы?
Dialogue: 0,0:04:58.92,0:05:00.42,Default,,0,0,0,,Көкөніс таяқшалары
Dialogue: 0,0:05:00.50,0:05:01.75,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:01.84,0:05:04.55,Default,,0,0,0,,Мен оны сізге әкелемін, сондықтан тыныш болыңыз.
Dialogue: 0,0:05:05.30,0:05:06.09,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:07.39,0:05:08.30,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:05:10.68,0:05:11.35,Default,,0,0,0,,Га
Dialogue: 0,0:05:11.93,0:05:13.18,Default,,0,0,0,,Гү… гүг… Дұрыс.
Dialogue: 0,0:05:13.27,0:05:15.23,Default,,0,0,0,,Мұғалім, сенің нәсілің қандай?
Dialogue: 0,0:05:15.31,0:05:19.94,Default,,0,0,0,,Не? Көріп тұрғандай мен қарақұйрықпын
Dialogue: 0,0:05:20.02,0:05:21.61,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:05:21.69,0:05:24.19,Default,,0,0,0,,Біздің қазір бір-бірімізді құшақтауымыз еркек пен әйел емес.
Dialogue: 0,0:05:24.28,0:05:28.99,Default,,0,0,0,,Бұл жыртқыштың шөпқоректіні ұстап алғанына ұқсас болды...
Dialogue: 0,0:05:29.49,0:05:31.03,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:05:31.70,0:05:34.83,Default,,0,0,0,,Сен сол қыздың жігітісің...
Dialogue: 0,0:05:35.62,0:05:39.33,Default,,0,0,0,,Туған күнге сыйлық жоқ...?
Dialogue: 0,0:05:39.42,0:05:41.13,Default,,0,0,0,,Неліктен Хару-чан?
Dialogue: 0,0:05:41.21,0:05:42.42,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:42.92,0:05:45.38,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:05:46.63,0:05:47.97,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:05:48.05,0:05:48.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:49.68,0:05:51.60,Default,,0,0,0,,Өйткені ол дәмді көрінеді
Dialogue: 0,0:05:51.68,0:05:52.89,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:52.97,0:05:54.22,Default,,0,0,0,,(Қауын күлкі)
Dialogue: 0,0:05:54.31,0:05:55.73,Default,,0,0,0,,Соңғы кездері түн-түні оқып жүргендіктен.
Dialogue: 0,0:05:56.73,0:05:59.35,Default,,0,0,0,,Оның дәмі тек құм сияқты.
Dialogue: 0,0:05:59.44,0:06:00.44,Default,,0,0,0,,Не?
Dialogue: 0,0:06:01.48,0:06:04.32,Default,,0,0,0,,Қорқып өлген
Dialogue: 0,0:06:04.40,0:06:05.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:07.49,0:06:09.95,Default,,0,0,0,,Олардың еті
Dialogue: 0,0:06:10.03,0:06:14.87,Default,,0,0,0,,Мен туғаннан бері өлімнен қорқып, қатып қалдым.
Dialogue: 0,0:06:14.95,0:06:16.33,Default,,0,0,0,,Барлық адам өлуден қорқады
Dialogue: 0,0:06:16.41,0:06:17.54,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:06:18.41,0:06:19.46,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:20.04,0:06:22.34,Default,,0,0,0,,Сол таза ақ бала
Dialogue: 0,0:06:22.42,0:06:25.59,Default,,0,0,0,,Мен өлуге де, өмір сүруге де қорықпаймын.
Dialogue: 0,0:06:26.21,0:06:29.09,Default,,0,0,0,,Сол етке қызыққаным сондықтан...
Dialogue: 0,0:06:29.18,0:06:33.43,Default,,0,0,0,,Жоқ, мен оған байланып қалдым.
Dialogue: 0,0:06:33.51,0:06:35.18,Default,,0,0,0,,Сіз сияқты.
Dialogue: 0,0:06:35.26,0:06:36.22,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:37.35,0:06:38.81,Default,,0,0,0,,Мен олай ойламаймын...
Dialogue: 0,0:06:38.89,0:06:42.98,Default,,0,0,0,,А, сен де қиналған сияқтысың.
Dialogue: 0,0:06:43.94,0:06:46.03,Default,,0,0,0,,Оны жеңілдетейік
Dialogue: 0,0:06:46.61,0:06:47.53,Default,,0,0,0,,Ха...
Dialogue: 0,0:06:48.74,0:06:49.32,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:06:49.40,0:06:50.32,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:51.45,0:06:52.07,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:52.16,0:06:53.07,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:54.33,0:06:57.12,Default,,0,0,0,,Бүгін менің туған күнім
Dialogue: 0,0:06:57.20,0:06:59.04,Default,,0,0,0,,Маған қалаған нәрсені істеуге рұқсат етіңіз
Dialogue: 0,0:06:59.12,0:07:02.17,Default,,0,0,0,,Мені өлтірсең де, сен қалағандай болмайды.
Dialogue: 0,0:07:02.25,0:07:07.55,Default,,0,0,0,,Мен әрқашан өзім қалаған нәрсені жасадым.
Dialogue: 0,0:07:08.97,0:07:13.80,Default,,0,0,0,,Бірақ мен орындай алмаған бір нәрсе болды.
Dialogue: 0,0:07:15.47,0:07:19.39,Default,,0,0,0,,Мен тумауға тырыспадым.
Dialogue: 0,0:07:20.06,0:07:22.40,Default,,0,0,0,,Не? Не айттың... Уф
Dialogue: 0,0:07:23.10,0:07:24.52,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:26.23,0:07:31.49,Default,,0,0,0,,Менің ата-анамда жауапсыз түраралық романс болды.
Dialogue: 0,0:07:31.57,0:07:36.20,Default,,0,0,0,,Соның нәтижесінде қоғамда жат нәрсе жасадық.
Dialogue: 0,0:07:36.28,0:07:37.45,Default,,0,0,0,,Бөтен зат?
Dialogue: 0,0:07:38.08,0:07:40.16,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:07:41.46,0:07:43.42,Default,,0,0,0,,Тиісті бақылаумен
Dialogue: 0,0:07:43.50,0:07:47.34,Default,,0,0,0,,Бұл қоғамда аралас балалар жоқ.
Dialogue: 0,0:07:47.42,0:07:48.46,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:07:48.55,0:07:49.63,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:49.71,0:07:51.97,Default,,0,0,0,,Ата-ана да баласымен бақытты болғысы келеді...
Dialogue: 0,0:07:52.05,0:07:55.01,Default,,0,0,0,,Бұл ата-ананың эгосы.
Dialogue: 0,0:07:55.09,0:08:00.02,Default,,0,0,0,,Аралас бала үшін туылу - өлім жазасына кесу.
Dialogue: 0,0:08:00.10,0:08:01.93,Default,,0,0,0,,Ех... солай...
Dialogue: 0,0:08:02.02,0:08:03.98,Default,,0,0,0,,Ауырсыну
Dialogue: 0,0:08:04.90,0:08:08.73,Default,,0,0,0,,Ата-анамның да дәмін татуға рұқсат беруім керек.
Dialogue: 0,0:08:09.36,0:08:14.49,Default,,0,0,0,,Сонымен, бұдан былай туатын аралас баланың орнына —
Dialogue: 0,0:08:14.57,0:08:20.24,Default,,0,0,0,,Мен сол жауапсыз жат ата-анадан кек аламын.
Dialogue: 0,0:08:20.33,0:08:22.75,Default,,0,0,0,,Туылғаннан кейін тым кеш
Dialogue: 0,0:08:22.83,0:08:23.71,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:24.29,0:08:25.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:25.33,0:08:27.08,Default,,0,0,0,,Сіз сериялық өлтіру оқиғасына жауаптысыз!
Dialogue: 0,0:08:27.17,0:08:30.67,Default,,0,0,0,,Енді сіз емессіз бе?
Dialogue: 0,0:08:30.76,0:08:31.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:31.80,0:08:35.64,Default,,0,0,0,,Жыртқыштар шөпқоректілерді жейді, солай ма?
Dialogue: 0,0:08:36.26,0:08:38.22,Default,,0,0,0,,Мен оны жаңа ғана сынап көрдім
Dialogue: 0,0:08:38.30,0:08:41.18,Default,,0,0,0,,Олардың арасында не бар
Dialogue: 0,0:08:41.27,0:08:45.31,Default,,0,0,0,,Бұл тәбет пе, әлде махаббат па?
Dialogue: 0,0:08:45.90,0:08:49.98,Default,,0,0,0,,Сіз бәрін реттедіңіз...
Dialogue: 0,0:08:50.48,0:08:53.36,Default,,0,0,0,,(Қауын күлкі)
Dialogue: 0,0:08:53.44,0:08:56.70,Default,,0,0,0,,Ол қанға боялып, жүзі шаттыққа бөленді.
Dialogue: 0,0:08:56.78,0:08:59.12,Default,,0,0,0,,Мен мұндай көзқарасты кешіре алмаймын!
Dialogue: 0,0:08:59.20,0:09:01.95,Default,,0,0,0,,Үндемей қал, бұл менің еркіндігім.
Dialogue: 0,0:09:02.04,0:09:03.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:03.83,0:09:07.38,Default,,0,0,0,,Бұл қоғамда әркім ойына келгенін істей алмайды.
Dialogue: 0,0:09:07.46,0:09:10.29,Default,,0,0,0,,Сен сияқты аңдар көп, бұл қауіпті.
Dialogue: 0,0:09:10.38,0:09:11.00,Default,,0,0,0,,Мен басқамын!
Dialogue: 0,0:09:11.09,0:09:12.59,Default,,0,0,0,,(Қауынның күлкісі)
Dialogue: 0,0:09:12.67,0:09:14.88,Default,,0,0,0,,Барлығы осылай дейді
Dialogue: 0,0:09:15.55,0:09:16.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:16.63,0:09:20.64,Default,,0,0,0,,Олай болса мына сұраққа жауап беріңіз.
Dialogue: 0,0:09:21.22,0:09:22.43,Default,,0,0,0,,Екі таңдау бар.
Dialogue: 0,0:09:24.14,0:09:28.02,Default,,0,0,0,,Сойыссыз қоғам
Dialogue: 0,0:09:28.10,0:09:30.86,Default,,0,0,0,,Дегенмен, қадағалаумен
Dialogue: 0,0:09:31.69,0:09:35.40,Default,,0,0,0,,B Ас пен сойыс бар қоғам
Dialogue: 0,0:09:35.49,0:09:38.82,Default,,0,0,0,,Бақылау жоқ
Dialogue: 0,0:09:39.74,0:09:41.03,Default,,0,0,0,,Сіз қайсысын таңдар едіңіз?
Dialogue: 0,0:09:43.41,0:09:44.75,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:45.71,0:09:46.87,Default,,0,0,0,,Өйткені А
Dialogue: 0,0:09:46.96,0:09:49.04,Default,,0,0,0,,Ассыз, сойыссыз қоғам, солай ма?
Dialogue: 0,0:09:49.13,0:09:51.29,Default,,0,0,0,,Бақылауға бола ма?
Dialogue: 0,0:09:51.38,0:09:53.63,Default,,0,0,0,,Қауіпсіздік үшін болса, оған көмектесу мүмкін емес.
Dialogue: 0,0:09:53.71,0:09:54.51,Default,,0,0,0,,Халл?
Dialogue: 0,0:09:54.59,0:09:56.22,Default,,0,0,0,,(Қауынның күлкісі)
Dialogue: 0,0:09:56.30,0:09:58.30,Default,,0,0,0,,Мен саған бөлмеден шықпа деп айттым.
Dialogue: 0,0:09:58.38,0:10:03.26,Default,,0,0,0,,Бұл бірлесе өмір сүру және өркендеу қоғамы у да, дәрі де емес.
Dialogue: 0,0:10:03.35,0:10:06.98,Default,,0,0,0,,Бұл бір-бірімізді бақылайтын түрме.
Dialogue: 0,0:10:07.73,0:10:09.94,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:10:12.57,0:10:18.61,Default,,0,0,0,,Сабыр күртеше киген, Тірі, бірақ бостандығы жоқ тұтқын
Dialogue: 0,0:10:19.24,0:10:21.03,Default,,0,0,0,,Бұл сендерсіңдер, балалар
Dialogue: 0,0:10:22.66,0:10:24.95,Default,,0,0,0,,Бірақ мен басқашамын.
Dialogue: 0,0:10:25.45,0:10:27.08,Default,,0,0,0,,B таңдаңыз
Dialogue: 0,0:10:27.83,0:10:30.33,Default,,0,0,0,,Тамақ энергияға толы
Dialogue: 0,0:10:30.42,0:10:34.71,Default,,0,0,0,,Белсенді, жанды, жанды
Dialogue: 0,0:10:34.80,0:10:38.92,Default,,0,0,0,,Сіз не білесіз? Егер сіз жыртқыш болсаңыз
Dialogue: 0,0:10:39.01,0:10:42.89,Default,,0,0,0,,Уф... Соның азабын тарттым.
Dialogue: 0,0:10:44.10,0:10:47.06,Default,,0,0,0,,Өзіңіздің шынайы болмысыңызды басу —
Dialogue: 0,0:10:47.14,0:10:51.19,Default,,0,0,0,,Өзіңізді жақсы ұстаңыз және қадамнан таймаңыз.
Dialogue: 0,0:10:51.27,0:10:54.40,Default,,0,0,0,,Бұл шынымен бақытты өмір сүру жолы ма?
Dialogue: 0,0:10:54.98,0:10:57.07,Default,,0,0,0,,Ешкімнің құрбан болмауы маңызды.
Dialogue: 0,0:10:57.15,0:11:00.32,Default,,0,0,0,,Бақытсыздықты азайту сізді бақытты ете ме?
Dialogue: 0,0:11:01.91,0:11:03.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:03.70,0:11:08.62,Default,,0,0,0,,Ол үшін қоғамдағы бөгде заттар жойылуы керек.
Dialogue: 0,0:11:09.50,0:11:14.92,Default,,0,0,0,,А... Мен олардың дауыстарын біраз уақыттан кейін бірінші рет есіме түсіріп отырмын.
Dialogue: 0,0:11:15.00,0:11:17.76,Default,,0,0,0,,Мен тірі болғандықтан...
Dialogue: 0,0:11:17.84,0:11:22.30,Default,,0,0,0,,Дүниенің шетінде бізді бұрыштамаға тырысқандар
Dialogue: 0,0:11:22.39,0:11:24.22,Default,,0,0,0,,Секір!
Dialogue: 0,0:11:24.30,0:11:25.30,Default,,0,0,0,,Секір!
Dialogue: 0,0:11:25.39,0:11:27.56,Default,,0,0,0,,Жоқ, мен енді таза шөп қоректі жануарға айналуым керек.
Dialogue: 0,0:11:27.64,0:11:29.89,Default,,0,0,0,,Қарашы, азу тістері көрініп тұр, қауын.
Dialogue: 0,0:11:29.98,0:11:31.89,Default,,0,0,0,,Мысықтар қонуға жақсы ма?
Dialogue: 0,0:11:31.98,0:11:33.60,Default,,0,0,0,,Анаңдай болсаң, Өлмейтініңе сенімдімін.
Dialogue: 0,0:11:33.69,0:11:36.73,Default,,0,0,0,,Егер сіз әкеңізге ұқсасаңыз ше? Мен бұл туралы ештеңе білмеймін.
Dialogue: 0,0:11:37.23,0:11:39.40,Default,,0,0,0,,Секір! Асықшы!
Dialogue: 0,0:11:39.49,0:11:41.11,Default,,0,0,0,,Тез орындаңыз!
Dialogue: 0,0:11:41.20,0:11:42.07,Default,,0,0,0,,Секір!
Dialogue: 0,0:11:42.15,0:11:43.82,Default,,0,0,0,,Бұл мені өлтірмейді, бірақ біраз уақыт дұрыс жүре алмайтын шығармын.
Dialogue: 0,0:11:46.20,0:11:50.41,Default,,0,0,0,,Мен 9 жасымда сыныптасымды өлтірдім...
Dialogue: 0,0:11:50.50,0:11:53.21,Default,,0,0,0,,Мен бірінші рет босатылдым
Dialogue: 0,0:11:54.29,0:11:55.50,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:56.34,0:12:00.21,Default,,0,0,0,,Қазір ойлап қарасам, сол кезде дұрыстап секіріп кетсем ғой.
Dialogue: 0,0:12:00.30,0:12:05.97,Default,,0,0,0,,Жердің түкпір-түкпіріне дейін ұшқаннан гөрі азат болуы мүмкін бе?
Dialogue: 0,0:12:06.05,0:12:06.97,Default,,0,0,0,,А...?
Dialogue: 0,0:12:07.97,0:12:09.43,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:12:09.52,0:12:12.02,Default,,0,0,0,,Мұқият қарау керек.
Dialogue: 0,0:12:12.10,0:12:13.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:13.69,0:12:14.77,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:12:14.85,0:12:18.90,Default,,0,0,0,,А... аа... аааааа!
Dialogue: 0,0:12:25.03,0:12:25.99,Default,,0,0,0,,(Легоши күші)
Dialogue: 0,0:12:27.58,0:12:29.20,Default,,0,0,0,,Мен сені бүгін қашып кетуге ешқашан жол бермеймін
Dialogue: 0,0:12:30.24,0:12:31.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:36.88,0:12:37.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:37.75,0:12:39.17,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:12:39.25,0:12:40.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:40.50,0:12:41.63,Default,,0,0,0,,Кеттік
Dialogue: 0,0:12:41.71,0:12:43.30,Default,,0,0,0,,А? Қайда?
Dialogue: 0,0:12:43.38,0:12:45.13,Default,,0,0,0,,Мен сені полицияға алып барамын.
Dialogue: 0,0:12:45.22,0:12:47.72,Default,,0,0,0,,Ұнамаса, алып жүруден басқа амал жоқ.
Dialogue: 0,0:12:47.80,0:12:48.43,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:48.51,0:12:50.77,Default,,0,0,0,,А... а...
Dialogue: 0,0:12:51.39,0:12:52.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:52.18,0:12:54.89,Default,,0,0,0,,Иә, полиция?
Dialogue: 0,0:12:54.98,0:12:58.15,Default,,0,0,0,,Бір рет болса да ыңғайсыз жағдайда өмір сүрдім...
Dialogue: 0,0:12:58.23,0:12:59.52,Default,,0,0,0,,Қателіктеріңе көп тоқталудың орнына,
Dialogue: 0,0:12:59.61,0:13:03.69,Default,,0,0,0,,Бұл қоянды әлі де жеуге болады дегенді білдіре ме?
Dialogue: 0,0:13:03.78,0:13:05.78,Default,,0,0,0,,Мені полицияға апарыңыз...
Dialogue: 0,0:13:05.86,0:13:09.66,Default,,0,0,0,,Соттылығыңыз болса да Яхья мырзадан ұлтаралық некеге тұруды сұрайық.
Dialogue: 0,0:13:09.74,0:13:13.29,Default,,0,0,0,,Сол қоянды жемесем, мәңгі өмір сүремін...
Dialogue: 0,0:13:13.37,0:13:15.37,Default,,0,0,0,,«дәмді» дегеннің не екенін әлі білмеймін
Dialogue: 0,0:13:15.46,0:13:16.96,Default,,0,0,0,,Мәңгілік бірге...
Dialogue: 0,0:13:17.04,0:13:18.42,Default,,0,0,0,,Бір уыс жақсы.
Dialogue: 0,0:13:18.50,0:13:19.67,Default,,0,0,0,,Хару-чанмен...
Dialogue: 0,0:13:22.30,0:13:23.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:26.01,0:13:28.18,Default,,0,0,0,,Бұл жыртқыштың құдіреті.
Dialogue: 0,0:13:28.26,0:13:29.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:29.26,0:13:31.97,Default,,0,0,0,,Білегімнен ұстап тұрған құдірет.
Dialogue: 0,0:13:32.89,0:13:35.06,Default,,0,0,0,,Бұзылатын сияқты.
Dialogue: 0,0:13:35.14,0:13:37.60,Default,,0,0,0,,Қасқыр болсаң, үйрету керек еді.
Dialogue: 0,0:13:37.69,0:13:40.56,Default,,0,0,0,,Әлсіздерге мейірімді бол
Dialogue: 0,0:13:40.65,0:13:41.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:41.48,0:13:42.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:42.82,0:13:46.45,Default,,0,0,0,,Мен өзімді керемет жауыз қасқыр сияқты сезінемін.
Dialogue: 0,0:13:47.15,0:13:48.45,Default,,0,0,0,,-Хмф -Ах!
Dialogue: 0,0:13:48.53,0:13:49.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:49.74,0:13:50.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:50.91,0:13:52.28,Default,,0,0,0,,(Қауын күші)
Dialogue: 0,0:13:52.37,0:13:54.08,Default,,0,0,0,,(Қауын күлкі)
Dialogue: 0,0:13:54.16,0:13:57.58,Default,,0,0,0,,Мен бәрібір ішіңді жыртып алайыншы.
Dialogue: 0,0:13:57.67,0:13:58.25,Default,,0,0,0,,(Легоши күші)
Dialogue: 0,0:13:58.33,0:14:00.46,Default,,0,0,0,,О... хахахаха
Dialogue: 0,0:14:00.54,0:14:03.13,Default,,0,0,0,,Әй, сен епті болып кеттің.
Dialogue: 0,0:14:03.21,0:14:06.09,Default,,0,0,0,,Бұл жалқаудан жақсы.
Dialogue: 0,0:14:06.17,0:14:07.51,Default,,0,0,0,,Мені мазақ етпе!
Dialogue: 0,0:14:16.31,0:14:17.14,Default,,0,0,0,,(Қауын күлкі)
Dialogue: 0,0:14:19.10,0:14:20.69,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:14:20.77,0:14:24.28,Default,,0,0,0,,О, маған көмектес! Қасқыр өлтірді!
Dialogue: 0,0:14:25.15,0:14:26.03,Default,,0,0,0,,Бұл ол!
Dialogue: 0,0:14:26.11,0:14:26.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:26.69,0:14:28.24,Default,,0,0,0,,Тез ішке кіріңіз.
Dialogue: 0,0:14:28.32,0:14:29.45,Default,,0,0,0,,Етқоректі жануарларға кіруге тыйым салынады.
Dialogue: 0,0:14:29.53,0:14:31.37,Default,,0,0,0,,Ол қатыгез қылмыскер...
Dialogue: 0,0:14:31.45,0:14:32.62,Default,,0,0,0,,Мен оны ұстауым керек!
Dialogue: 0,0:14:32.70,0:14:33.66,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:14:33.74,0:14:34.91,Default,,0,0,0,,Мен полиция шақырамын!
Dialogue: 0,0:14:34.99,0:14:38.00,Default,,0,0,0,,Ах! Қат!
Dialogue: 0,0:14:42.04,0:14:43.17,Default,,0,0,0,,(шу)
Dialogue: 0,0:14:43.25,0:14:44.92,Default,,0,0,0,,Иә? Хару?
Dialogue: 0,0:14:47.09,0:14:48.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:48.55,0:14:49.51,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:49.59,0:14:52.30,Default,,0,0,0,,Не... Мен бұл сақинаны тастадым.
Dialogue: 0,0:14:52.39,0:14:54.39,Default,,0,0,0,,Оны жарық түскеннен кейін іздеу керек.
Dialogue: 0,0:14:54.47,0:14:57.56,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:14:57.64,0:14:59.56,Default,,0,0,0,,Луи-сенпай, бұл менмін.
Dialogue: 0,0:14:59.64,0:15:00.56,Default,,0,0,0,,Сіз оны ұстадыңыз ба?
Dialogue: 0,0:15:01.15,0:15:02.56,Default,,0,0,0,,Мен қашып құтыла алдым
Dialogue: 0,0:15:02.65,0:15:04.57,Default,,0,0,0,,Кешіріңіз, бұл да.
Dialogue: 0,0:15:04.65,0:15:05.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:05.44,0:15:07.65,Default,,0,0,0,,Мен қарамасам, Хару қашып кетті.
Dialogue: 0,0:15:07.74,0:15:08.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:08.74,0:15:11.03,Default,,0,0,0,,Ол сол жаққа бет алған болуы мүмкін.
Dialogue: 0,0:15:11.11,0:15:11.99,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:15:12.07,0:15:13.37,Default,,0,0,0,,Маған қайта хабарласыңыз.
Dialogue: 0,0:15:15.78,0:15:16.83,Default,,0,0,0,,Мен қиындыққа тап болдым...
Dialogue: 0,0:15:16.91,0:15:19.04,Default,,0,0,0,,Егер бұл Хару-сама болса...
Dialogue: 0,0:15:19.62,0:15:20.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:21.21,0:15:22.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:22.92,0:15:25.71,Default,,0,0,0,,Мейрамхана ашқыңыз келсе, тамақ дайындау мен ингредиенттерден басқа нәрсемен айналысыңыз.
Dialogue: 0,0:15:25.79,0:15:27.21,Default,,0,0,0,,Мен бұл туралы ойлануым керек.
Dialogue: 0,0:15:27.30,0:15:29.67,Default,,0,0,0,,Осыны қазір түсінсеңіз жеткілікті
Dialogue: 0,0:15:27.30,0:15:29.67,Default,,0,0,0,,(Луидің ауыр тыныс алуы)
Dialogue: 0,0:15:29.76,0:15:31.84,Default,,0,0,0,,Хару! Сен бөлмеңе барасың...
Dialogue: 0,0:15:31.93,0:15:33.76,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:15:33.84,0:15:36.93,Default,,0,0,0,,Жуынатын бөлмеге бара жатып, кітап сөресін байқадым...
Dialogue: 0,0:15:37.01,0:15:38.89,Default,,0,0,0,,Дүкен ашқыңыз келгендіктен—
Dialogue: 0,0:15:38.97,0:15:41.56,Default,,0,0,0,,Сонда мен сізге менеджмент мамандығын да оқуға кеңес берер едім.
Dialogue: 0,0:15:41.64,0:15:42.60,Default,,0,0,0,,(Харудың күлкісі)
Dialogue: 0,0:15:42.69,0:15:45.06,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:15:45.94,0:15:47.36,Default,,0,0,0,,Ол мені іздеді.
Dialogue: 0,0:15:47.44,0:15:49.61,Default,,0,0,0,,Бірақ ол күткендей, бүгін үнсіз қалды.
Dialogue: 0,0:15:49.69,0:15:50.86,Default,,0,0,0,,Сосын бөлмеде...
Dialogue: 0,0:15:50.94,0:15:52.11,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:52.20,0:15:52.99,Default,,0,0,0,,Бұл Бұл Сіз мұны оқуыңыз керек
Dialogue: 0,0:15:52.99,0:15:53.86,Default,,0,0,0,,Бұл Бұл Сіз мұны оқуыңыз керек
Dialogue: 0,0:15:52.99,0:15:53.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:53.95,0:15:55.24,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:55.32,0:15:56.91,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:57.49,0:16:00.79,Default,,0,0,0,,Сіз кереметсіз.
Dialogue: 0,0:16:01.33,0:16:04.25,Default,,0,0,0,,Сондықтан бұл жеңілдік
Dialogue: 0,0:16:04.33,0:16:06.50,Default,,0,0,0,,Сіз амулет сатып аламын дедіңіз.
Dialogue: 0,0:16:06.59,0:16:07.92,Default,,0,0,0,,А, бұл Легоши.
Dialogue: 0,0:16:08.00,0:16:10.21,Default,,0,0,0,,Қауын табылмады
Dialogue: 0,0:16:10.76,0:16:11.72,Default,,0,0,0,,Бұл Хару-чанға да қатысты...
Dialogue: 0,0:16:11.80,0:16:12.76,Default,,0,0,0,,Легоши-кун?
Dialogue: 0,0:16:12.84,0:16:14.39,Default,,0,0,0,,Хару-чан?
Dialogue: 0,0:16:14.47,0:16:15.22,Default,,0,0,0,,Өзгерту
Dialogue: 0,0:16:16.72,0:16:18.97,Default,,0,0,0,,Легоши-кун, жақсысың ба? Сіз жарақат алдыңыз ба?
Dialogue: 0,0:16:19.06,0:16:20.77,Default,,0,0,0,,Жоқ, жоқ. Мен істеген жоқпын.
Dialogue: 0,0:16:20.85,0:16:21.48,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:21.56,0:16:23.64,Default,,0,0,0,,Жоқ, Хару-чан жаман емес.
Dialogue: 0,0:16:23.73,0:16:25.98,Default,,0,0,0,,Күрсін, аман-есен болғаныңа қуаныштымын.
Dialogue: 0,0:16:26.56,0:16:27.40,Default,,0,0,0,,Осымен
Dialogue: 0,0:16:26.56,0:16:27.40,Default,,0,0,0,,Иә
Dialogue: 0,0:16:27.48,0:16:29.57,Default,,0,0,0,,Луидің әкесі өте күлкілі
Dialogue: 0,0:16:29.65,0:16:33.49,Default,,0,0,0,,Ол көп нәрсені біледі, хехе, ол да Луиге ұқсайды.
Dialogue: 0,0:16:33.57,0:16:34.86,Default,,0,0,0,,(Легоши мен Харудың күлкісі)
Dialogue: 0,0:16:34.95,0:16:38.91,Default,,0,0,0,,Мен сенімен танысқым келеді, бірақ дәл қазір Хару-чанмен кездескім келеді.
Dialogue: 0,0:16:39.66,0:16:40.79,Default,,0,0,0,,Ертең ше?
Dialogue: 0,0:16:40.87,0:16:43.16,Default,,0,0,0,,Жақсы, мен сені университетті бітірген соң алып кетемін.
Dialogue: 0,0:16:43.25,0:16:45.29,Default,,0,0,0,,Иә, рахмет.
Dialogue: 0,0:16:45.37,0:16:46.75,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:16:47.75,0:16:48.63,Default,,0,0,0,,Незуко мені құтқарды ма? Рақмет.
Dialogue: 0,0:16:48.71,0:16:49.75,Default,,0,0,0,,Әй, Сенпай!
Dialogue: 0,0:16:49.84,0:16:51.30,Default,,0,0,0,,Не істеу керек? Осыдан кейін
Dialogue: 0,0:16:51.38,0:16:57.18,Default,,0,0,0,,Аа, қазір ойлап қарасам, ол сериялық өлтіру оқиғасына кінәлі.
Dialogue: 0,0:16:57.26,0:17:00.26,Default,,0,0,0,,Бұл да Қауынның еңбегі ме? Ал полиция ше?
Dialogue: 0,0:17:00.35,0:17:02.14,Default,,0,0,0,,Дәлел жоқ
Dialogue: 0,0:17:02.22,0:17:03.02,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:17:03.10,0:17:06.23,Default,,0,0,0,,Бірақ тез арада қолға алмасақ, құрбандар көбейеді.
Dialogue: 0,0:17:06.31,0:17:09.57,Default,,0,0,0,,Дұрыс, мен де қараймын.
Dialogue: 0,0:17:10.23,0:17:11.28,Default,,0,0,0,,Абайсызда болмаңыз
Dialogue: 0,0:17:11.36,0:17:13.11,Default,,0,0,0,,Маған Хару-чан туралы айтып беріңізші.
Dialogue: 0,0:17:13.61,0:17:14.11,Default,,0,0,0,,О
Dialogue: 0,0:17:14.19,0:17:15.65,Default,,0,0,0,,- Көрдіңіз бе? -Хмм?
Dialogue: 0,0:17:15.74,0:17:16.24,Default,,0,0,0,,(қосу дыбысы)
Dialogue: 0,0:17:16.32,0:17:21.45,Default,,0,0,0,,Не? Менің ойымша, ол оны ақыры сатып алды.
Dialogue: 0,0:17:30.92,0:17:32.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:32.63,0:17:33.38,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:34.38,0:17:35.38,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:17:35.97,0:17:37.84,Default,,0,0,0,,Енді сақалды болжау...
Dialogue: 0,0:17:37.93,0:17:41.81,Default,,0,0,0,,Алдағы шымтезек соғысына қалай қатысу керектігін шешіңіз
Dialogue: 0,0:17:42.81,0:17:47.52,Default,,0,0,0,,Егер мұртшалар оңға қарай қозғалса, біз қатысуға өкіл жібереміз.
Dialogue: 0,0:17:47.60,0:17:49.44,Default,,0,0,0,,Егер мұрт солға қарай қозғалса...
Dialogue: 0,0:17:49.52,0:17:50.81,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:17:51.61,0:17:53.53,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:17:54.49,0:17:55.82,Default,,0,0,0,,Луи
Dialogue: 0,0:17:56.57,0:17:59.07,Default,,0,0,0,,Сіз бастық болуды ойлайсыз ба?
Dialogue: 0,0:17:59.57,0:18:01.28,Default,,0,0,0,,Не? қауын?
Dialogue: 0,0:18:01.37,0:18:03.04,Default,,0,0,0,,Сіз қай жерде тұратыныңызды білмейсіз бе?
Dialogue: 0,0:18:03.58,0:18:06.37,Default,,0,0,0,,Мен сені соңғы кезде көрмедім.
Dialogue: 0,0:18:06.46,0:18:08.58,Default,,0,0,0,,Мен оны артқы базарда көрген ешкімді ешқашан естіген емеспін.
Dialogue: 0,0:18:09.25,0:18:10.46,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:18:11.09,0:18:12.00,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:18:12.09,0:18:14.59,Default,,0,0,0,,Егер сізде қандай да бір ақпарат болса, маған хабарлай аласыз ба?
Dialogue: 0,0:18:14.67,0:18:17.22,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:18:17.30,0:18:19.09,Default,,0,0,0,,Өйткені ол бастық.
Dialogue: 0,0:18:19.18,0:18:23.39,Default,,0,0,0,,Егер сіз эстетика мен мақтанышсыз кісі өлтіруші болсаңыз да, бастық бастық па?
Dialogue: 0,0:18:23.47,0:18:25.22,Default,,0,0,0,,Көресіз.
Dialogue: 0,0:18:25.89,0:18:27.64,Default,,0,0,0,,Мен мұны бәрібір сұрадым.
Dialogue: 0,0:18:32.69,0:18:35.07,Default,,0,0,0,,Ол да артқы базарда емес пе?
Dialogue: 0,0:18:35.90,0:18:36.94,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:18:37.57,0:18:40.24,Default,,0,0,0,,Қауіпті ескерту үшін теледидардың күшін пайдалануымыз керек пе?
Dialogue: 0,0:18:41.24,0:18:43.95,Default,,0,0,0,,Жоқ, ешқандай дәлел жоқ.
Dialogue: 0,0:18:44.03,0:18:45.83,Default,,0,0,0,,Бұл тек шатасушылық тудырады.
Dialogue: 0,0:18:46.58,0:18:48.54,Default,,0,0,0,,Яхья мырзамен кеңесуім керек пе?
Dialogue: 0,0:18:49.12,0:18:51.38,Default,,0,0,0,,Жоқ, сіз қазірге дейін білуіңіз керек еді.
Dialogue: 0,0:18:51.46,0:18:52.38,Default,,0,0,0,,(есік тұтқасының айналу дыбысы)
Dialogue: 0,0:18:53.17,0:18:54.80,Default,,0,0,0,,Сәлем Луис
Dialogue: 0,0:18:54.88,0:18:59.51,Default,,0,0,0,,Бүгін кейбір қарсыластар бар, сондықтан өзіңізді ашық айтуға мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:18:59.59,0:19:02.85,Default,,0,0,0,,Нашар сөйлеп жалынбайсың.
Dialogue: 0,0:19:02.93,0:19:06.64,Default,,0,0,0,,Сізді экранда көру - біз үшін жеңіс.
Dialogue: 0,0:19:06.72,0:19:08.10,Default,,0,0,0,,(Әкім күлді)
Dialogue: 0,0:19:08.18,0:19:08.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:08.81,0:19:10.60,Default,,0,0,0,,(Луис жалған күлімсіреу)
Dialogue: 0,0:19:12.56,0:19:15.77,Default,,0,0,0,,Арзан кофенің иісі бар.
Dialogue: 0,0:19:15.86,0:19:17.57,Default,,0,0,0,,Жоқ, елші
Dialogue: 0,0:19:17.65,0:19:20.24,Default,,0,0,0,,Арзан еритін кофе ішпеңіз.
Dialogue: 0,0:19:20.32,0:19:23.82,Default,,0,0,0,,Сіз Kopi Luwak ішіп көрдіңіз бе?
Dialogue: 0,0:19:23.91,0:19:26.95,Default,,0,0,0,,Бұл тамаша. Мен сені келесі жолы той беремін.
Dialogue: 0,0:19:27.54,0:19:31.12,Default,,0,0,0,,Енді нағыз нәрсенің уақыты келді Күлімсіреп күліңіз!
Dialogue: 0,0:19:31.87,0:19:33.04,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:33.75,0:19:34.79,Default,,0,0,0,,Копи Лувак…
Dialogue: 0,0:19:34.79,0:19:35.79,Default,,0,0,0,,Копи Лувак…
Dialogue: 0,0:19:34.79,0:19:35.79,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:19:37.38,0:19:39.72,Default,,0,0,0,,Эй, мен жеткізуге тапсырыс беремін.
Dialogue: 0,0:19:40.22,0:19:41.84,Default,,0,0,0,,Иә
Dialogue: 0,0:19:41.93,0:19:46.39,Default,,0,0,0,,Бұл 1-ші теңіз аймағы. Сіз теңіз тілінде сөйлей аласыз ба?
Dialogue: 0,0:19:46.47,0:19:50.23,Default,,0,0,0,,Аппупопопи Бебебе Бероп Помпоропу
Dialogue: 0,0:19:50.31,0:19:52.10,Default,,0,0,0,,О! Сен жақсысың
Dialogue: 0,0:19:52.19,0:19:55.02,Default,,0,0,0,,Мен Черритон академиясын бітірген жоқпын.
Dialogue: 0,0:19:55.11,0:19:57.07,Default,,0,0,0,,Жақсы, күткендей.
Dialogue: 0,0:19:57.15,0:20:00.78,Default,,0,0,0,,Мен сенің Легоши үшін шымшушы ретінде емес, мен үшін жұмыс істегеніңді қалаймын.
Dialogue: 0,0:20:01.74,0:20:03.53,Default,,0,0,0,,Айтпақшы, Легоши-кун—
Dialogue: 0,0:20:03.61,0:20:06.87,Default,,0,0,0,,Сіз маған демалыс алу себебін көрсетпедіңіз, бірақ бірдеңе естідіңіз бе?
Dialogue: 0,0:20:06.95,0:20:07.87,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:07.95,0:20:10.83,Default,,0,0,0,,Бірақ мен жақсы себеп бар деп ойлаймын.
Dialogue: 0,0:20:10.91,0:20:14.46,Default,,0,0,0,,Сөйлеуге шебер болмағандықтан, оны жиі түсінбейді.
Dialogue: 0,0:20:14.54,0:20:16.84,Default,,0,0,0,,Мектепте де солай болды ма?
Dialogue: 0,0:20:16.92,0:20:18.63,Default,,0,0,0,,Мен күбірледім.
Dialogue: 0,0:20:18.71,0:20:21.97,Default,,0,0,0,,Удон дәмді, шебері сымбатты.
Dialogue: 0,0:20:22.05,0:20:23.55,Default,,0,0,0,,Ал, мен барамын.
Dialogue: 0,0:20:24.80,0:20:28.22,Default,,0,0,0,,Ол бәрібір жақсы жігіт.
Dialogue: 0,0:20:29.18,0:20:32.23,Default,,0,0,0,,Ммммммм...
Dialogue: 0,0:20:33.10,0:20:34.52,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:20:35.77,0:20:39.32,Default,,0,0,0,,Шиши-гумидің Луи-сенпайдан жасырын болжауы
Dialogue: 0,0:20:40.03,0:20:42.49,Default,,0,0,0,,Менің ойымша, қасқырдың жүні жақсы емес пе?
Dialogue: 0,0:20:43.36,0:20:46.99,Default,,0,0,0,,Қауын Ол да университетті тастады.
Dialogue: 0,0:20:47.57,0:20:50.37,Default,,0,0,0,,Мен оның қайда болуы мүмкін екендігі туралы кеңес алғым келеді...
Dialogue: 0,0:20:50.45,0:20:51.33,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:20:51.41,0:20:52.66,Default,,0,0,0,,Ах
Dialogue: 0,0:20:56.29,0:20:58.00,Default,,0,0,0,,Татуировка студиясы…
Dialogue: 0,0:20:58.50,0:20:59.75,Default,,0,0,0,,(Қауын күлкі)
Dialogue: 0,0:20:59.84,0:21:02.42,Default,,0,0,0,,Әй, сен епті болып кетіпсің.
Dialogue: 0,0:21:02.51,0:21:05.34,Default,,0,0,0,,Бұл жалқаудан жақсы.
Dialogue: 0,0:21:05.43,0:21:07.01,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:21:13.02,0:21:14.98,Default,,0,0,0,,Кешіріңіз—
Dialogue: 0,0:21:15.56,0:21:16.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:21.44,0:21:22.19,Default,,0,0,0,,Ах
Dialogue: 0,0:21:25.74,0:21:26.41,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:21:29.03,0:21:30.78,Default,,0,0,0,,... қиын!
Dialogue: 0,0:21:30.87,0:21:32.62,Default,,0,0,0,,А... біреу!
Dialogue: 0,0:21:33.12,0:21:34.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:36.04,0:21:37.79,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:21:37.87,0:21:41.59,Default,,0,0,0,,А... Мен мұнда жүргенде қорқынышты сезінемін.
Dialogue: 0,0:21:42.92,0:21:44.01,Default,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:21:54.43,0:21:56.73,Default,,0,0,0,,Әй, эй! Қасқыр сонда!
Dialogue: 0,0:21:56.81,0:21:59.02,Default,,0,0,0,,Күте тұрыңыз! тоқта!
Dialogue: 0,0:22:00.36,0:22:03.23,Default,,0,0,0,,Екі хабарланғандай... Иә.
Dialogue: 0,0:22:04.74,0:22:06.49,Default,,0,0,0,,Екеуі де өлді
Dialogue: 0,0:22:07.78,0:22:09.28,Default,,0,0,0,,Мен сот-медициналық сараптама жүргізгім келеді.
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.91,0:23:41.92,Default,,0,0,0,,～♪
