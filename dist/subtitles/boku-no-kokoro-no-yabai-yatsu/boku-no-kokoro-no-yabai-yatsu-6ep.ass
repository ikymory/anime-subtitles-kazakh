Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.41,0:00:03.58,Default,,0,0,0,,Аа...
Dialogue: 0,0:00:06.54,0:00:08.38,Default,,0,0,0,,Иә? үшін ше?
Dialogue: 0,0:00:09.63,0:00:10.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:11.09,0:00:12.92,Default,,0,0,0,,Бәріне айтпадың ба!
Dialogue: 0,0:00:13.01,0:00:14.55,Default,,0,0,0,,Мен сізді тыңдап отыр деп ойладым.
Dialogue: 0,0:00:19.43,0:00:20.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:20.43,0:00:23.77,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:00:24.39,0:00:27.69,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:00:32.61,0:00:34.78,Default,,0,0,0,,Жұмыс сапарынан қайтар жолда
Dialogue: 0,0:00:35.28,0:00:37.16,Default,,0,0,0,,Басқалардан бөлінген
Dialogue: 0,0:00:37.95,0:00:40.12,Default,,0,0,0,,Кешіріңіз, мен...
Dialogue: 0,0:00:41.04,0:00:43.50,Default,,0,0,0,,Жоқ, пойыз жақында келеді.
Dialogue: 0,0:00:43.58,0:00:45.25,Default,,0,0,0,,Мен ерекше асықпаймын...
Dialogue: 0,0:00:45.33,0:00:47.67,Default,,0,0,0,,Мен абдырап қалсам да...
Dialogue: 0,0:00:47.75,0:00:49.67,Default,,0,0,0,,Ах, ақымақ! Күлдірме!
Dialogue: 0,0:00:49.75,0:00:51.38,Default,,0,0,0,,Сіз өзіңізді бақыттымын деп ойламайсыз ба...
Dialogue: 0,0:00:51.46,0:00:52.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:54.59,0:00:55.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:57.76,0:01:00.26,Default,,0,0,0,,Бір... Келесісі 7 минуттан кейін болады ма?
Dialogue: 0,0:01:00.76,0:01:02.22,Default,,0,0,0,,Әзірше орнымызға отырайық.
Dialogue: 0,0:01:02.85,0:01:04.39,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:01:04.48,0:01:06.85,Default,,0,0,0,,Мен ғана бата деп есептеймін
Dialogue: 0,0:01:07.44,0:01:10.57,Default,,0,0,0,,Біріншіден, мен сияқты адаммен жалғыз қалу ұят.
Dialogue: 0,0:01:10.65,0:01:12.40,Default,,0,0,0,,Мүмкін бұл көз жасы шығар
Dialogue: 0,0:01:13.69,0:01:14.90,Default,,0,0,0,,(Ямаданың жылағаны)
Dialogue: 0,0:01:14.99,0:01:17.11,Default,,0,0,0,,Бұл шоу емес.
Dialogue: 0,0:01:17.20,0:01:19.62,Default,,0,0,0,,Мен сені жылатып жіберген сияқтымын.
Dialogue: 0,0:01:20.91,0:01:22.62,Default,,0,0,0,,Жоқ, мүмкін
Dialogue: 0,0:01:30.46,0:01:31.63,Default,,0,0,0,,(тиын салу дыбысы)
Dialogue: 0,0:01:32.13,0:01:32.80,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:01:34.88,0:01:37.13,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:01:41.30,0:01:45.23,Default,,0,0,0,,А... жақсы, сусын жақсы болар еді.
Dialogue: 0,0:02:01.91,0:02:03.74,Default,,0,0,0,,Қарғыс атсын... жоқ па?
Dialogue: 0,0:02:04.79,0:02:08.75,Default,,0,0,0,,Мм... енді ойлап қарасам, ваннаға барған мен едім.
Dialogue: 0,0:02:09.25,0:02:13.38,Default,,0,0,0,,Барар алдында барлығына үлкенірек хабарландыру жасаса ғой...
Dialogue: 0,0:02:16.42,0:02:19.97,Default,,0,0,0,,Ант! Мен қазір дәретханаға барамын!
Dialogue: 0,0:02:20.55,0:02:22.47,Default,,0,0,0,,А... ха
Dialogue: 0,0:02:22.55,0:02:25.56,Default,,0,0,0,,Ахахха Декларация хахаха
Dialogue: 0,0:02:26.72,0:02:27.68,Default,,0,0,0,,Алыста!
Dialogue: 0,0:02:32.52,0:02:34.52,Default,,0,0,0,,♪～
Dialogue: 0,0:03:59.90,0:04:01.90,Default,,0,0,0,,～♪
Dialogue: 0,0:04:12.16,0:04:16.21,Default,,0,0,0,,Ямада модель ретінде қаншалықты танымал?
Dialogue: 0,0:04:16.88,0:04:18.71,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:04:19.55,0:04:21.21,Default,,0,0,0,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:04:21.30,0:04:24.22,Default,,0,0,0,,Ямаданы білетін адам болуы мүмкін.
Dialogue: 0,0:04:27.64,0:04:31.10,Default,,0,0,0,,Мусашикояма Мусашикояма
Dialogue: 0,0:04:36.77,0:04:37.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:38.65,0:04:40.57,Default,,0,0,0,,Біз қайтадан ажырасамыз
Dialogue: 0,0:04:44.53,0:04:47.78,Default,,0,0,0,,Хара мырзаның тобы Нагасаки қалпағы?
Dialogue: 0,0:04:47.87,0:04:48.57,Default,,0,0,0,,Осы жолы оны міндетті түрде қолға түсіреміз.
Dialogue: 0,0:04:49.20,0:04:49.99,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:04:50.49,0:04:52.33,Default,,0,0,0,,Міндетті түрде жеуге болмайды
Dialogue: 0,0:04:52.83,0:04:55.75,Default,,0,0,0,,Жеке маған бұл да қатты ұнады.
Dialogue: 0,0:04:56.25,0:04:57.58,Default,,0,0,0,,Негізінен қазір
Dialogue: 0,0:04:57.67,0:04:58.58,Default,,0,0,0,,Мен де!
Dialogue: 0,0:05:00.09,0:05:02.46,Default,,0,0,0,,Бұл екеуі кездесе ме?
Dialogue: 0,0:05:04.59,0:05:05.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:05.59,0:05:06.38,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:05:06.88,0:05:09.51,Default,,0,0,0,,Бір сыныпта жүргеніміз ғажап емес пе?
Dialogue: 0,0:05:09.60,0:05:11.01,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:05:11.10,0:05:12.52,Default,,0,0,0,,Бастауыш мектеп
Dialogue: 0,0:05:12.60,0:05:15.06,Default,,0,0,0,,Бұл туралы ашық айтқан жұп болды.
Dialogue: 0,0:05:15.14,0:05:16.52,Default,,0,0,0,,Әрқашан қол ұстаңыз
Dialogue: 0,0:05:17.02,0:05:18.52,Default,,0,0,0,,А...
Dialogue: 0,0:05:19.19,0:05:20.48,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:05:20.57,0:05:24.15,Default,,0,0,0,,Менің ойымша, оны құпия сақтау қызықырақ.
Dialogue: 0,0:05:24.65,0:05:25.90,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:05:27.57,0:05:29.32,Default,,0,0,0,,Ичикава Сіз қалай ойлайсыз?
Dialogue: 0,0:05:29.41,0:05:30.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:38.75,0:05:39.83,Default,,0,0,0,,Аяқтарды жуу
Dialogue: 0,0:05:39.92,0:05:43.84,Default,,0,0,0,,Күрсін... Бұл жақсы емес пе?
Dialogue: 0,0:05:43.92,0:05:46.47,Default,,0,0,0,,Мазмұнды ойыңызға алыңыз!
Dialogue: 0,0:05:46.55,0:05:49.84,Default,,0,0,0,,(Ямаданың гуілдеуі)
Dialogue: 0,0:05:50.43,0:05:51.68,Default,,0,0,0,,Ах~
Dialogue: 0,0:05:52.18,0:05:53.60,Default,,0,0,0,,Мені еркелетіңіз
Dialogue: 0,0:05:53.68,0:05:54.31,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:05:58.94,0:06:00.52,Default,,0,0,0,,Чии, кешіріңіз.
Dialogue: 0,0:06:00.61,0:06:02.94,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:06:03.02,0:06:03.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:04.11,0:06:07.70,Default,,0,0,0,,Мен топ басшысымын, сондықтан уақытында болуым керек.
Dialogue: 0,0:06:07.78,0:06:11.03,Default,,0,0,0,,Менің назарымды аударғаным сонша, айналамдағыны көре алмадым.
Dialogue: 0,0:06:11.62,0:06:12.53,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:16.45,0:06:19.62,Default,,0,0,0,,Жарайды, әркім қателеседі.
Dialogue: 0,0:06:19.71,0:06:21.29,Default,,0,0,0,,- (Секине/Йошида) Не! -(Ичикава) Не!
Dialogue: 0,0:06:25.88,0:06:30.89,Default,,0,0,0,,Жоқ, жұмыс сапары өте қиын болды.
Dialogue: 0,0:06:31.39,0:06:35.85,Default,,0,0,0,,Мен дөрекі сұрақтар қоямын. Әркім өзінше әрекет етіп, бөлініп кетеді.
Dialogue: 0,0:06:36.35,0:06:38.56,Default,,0,0,0,,Олардың бәрі аң-таң болып өмір сүреді.
Dialogue: 0,0:06:38.64,0:06:42.06,Default,,0,0,0,,Кио Чан, мен бұл туралы кеше естідім.
Dialogue: 0,0:06:42.15,0:06:42.86,Default,,0,0,0,,А...
Dialogue: 0,0:06:43.56,0:06:45.57,Default,,0,0,0,,Мен кеше анаммен сөйлестім.
Dialogue: 0,0:06:46.44,0:06:47.90,Default,,0,0,0,,Мен қазір кетуім керек
Dialogue: 0,0:06:47.99,0:06:50.95,Default,,0,0,0,,Бұл күндері мектеп қызық сияқты.
Dialogue: 0,0:06:51.03,0:06:51.57,Default,,0,0,0,,А...
Dialogue: 0,0:06:51.66,0:06:52.82,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:55.54,0:06:58.79,Default,,0,0,0,,Бұл көңілді ме? Бұл шындық болуы мүмкін емес
Dialogue: 0,0:06:58.87,0:07:00.92,Default,,0,0,0,,Менің әлі достарым жоқ.
Dialogue: 0,0:07:08.71,0:07:10.55,Default,,0,0,0,,Сізге Ямада ұнайтындықтан ба?
Dialogue: 0,0:07:11.05,0:07:12.76,Default,,0,0,0,,Мұндай сұмдық интроверт
Dialogue: 0,0:07:12.84,0:07:15.14,Default,,0,0,0,,Киракира Шоуджо Манганы оқу мүмкін емес.
Dialogue: 0,0:07:15.22,0:07:16.81,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:07:16.89,0:07:21.39,Default,,0,0,0,,Жоқ, алданып қалмаңыз. Көңіліңіздің түбінде мені мазақ етіп отырсыз.
Dialogue: 0,0:07:21.89,0:07:24.23,Default,,0,0,0,,Ақырында зардап шегетін сенсің
Dialogue: 0,0:07:27.23,0:07:28.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:34.70,0:07:35.91,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:07:35.99,0:07:37.49,Default,,0,0,0,,Иә, қайырлы таң
Dialogue: 0,0:07:38.16,0:07:40.33,Default,,0,0,0,,Ямада? Сен не істеп жатырсың?
Dialogue: 0,0:07:40.41,0:07:42.29,Default,,0,0,0,,А... у... сәл.
Dialogue: 0,0:07:42.37,0:07:44.29,Default,,0,0,0,,Сіз дене шынықтыру мұғалімісіз бе?
Dialogue: 0,0:07:44.88,0:07:46.63,Default,,0,0,0,,Сіз біреуді күтіп тұрсыз ба?
Dialogue: 0,0:07:46.71,0:07:48.46,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:07:49.51,0:07:51.09,Default,,0,0,0,,О...
Dialogue: 0,0:07:51.59,0:07:52.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:53.51,0:07:55.22,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:07:57.26,0:07:58.60,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:07:59.56,0:08:01.02,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:08:01.60,0:08:02.73,Default,,0,0,0,,Әбунай
Dialogue: 0,0:08:02.81,0:08:05.02,Default,,0,0,0,,Егер менің велосипедім болмаса, мен оны өткізіп алар едім.
Dialogue: 0,0:08:05.10,0:08:06.77,Default,,0,0,0,,О... ой...
Dialogue: 0,0:08:12.32,0:08:13.28,Default,,0,0,0,,Ум...
Dialogue: 0,0:08:14.53,0:08:16.12,Default,,0,0,0,,-(Ямада) Бұл -(Ичикава) Иә?
Dialogue: 0,0:08:16.78,0:08:18.12,Default,,0,0,0,,Маған қарызға беремін дедіңіз.
Dialogue: 0,0:08:19.29,0:08:19.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:20.54,0:08:21.25,Default,,0,0,0,,Бұл қажет емес пе?
Dialogue: 0,0:08:21.75,0:08:23.58,Default,,0,0,0,,Сіз мұны айтқыңыз келді ме?
Dialogue: 0,0:08:24.25,0:08:25.58,Default,,0,0,0,,Бар...
Dialogue: 0,0:08:26.29,0:08:28.21,Default,,0,0,0,,Бірақ неге қазір?
Dialogue: 0,0:08:28.71,0:08:31.76,Default,,0,0,0,,Мен кітапханаға бара алмаймын, өйткені мен бүгін ерте кетемін.
Dialogue: 0,0:08:32.26,0:08:33.30,Default,,0,0,0,,О
Dialogue: 0,0:08:33.38,0:08:35.51,Default,,0,0,0,,Бұл өте қызық
Dialogue: 0,0:08:35.59,0:08:36.93,Default,,0,0,0,,Басты кейіпкердің дені сау.
Dialogue: 0,0:08:37.01,0:08:39.64,Default,,0,0,0,,Менің ең жақын досым жолда қайтыс болған сияқты көп нәрсе болды.
Dialogue: 0,0:08:39.72,0:08:43.64,Default,,0,0,0,,Артқы мұқабадағы керемет жігіт шын мәнінде мейірімді.
Dialogue: 0,0:08:43.73,0:08:46.44,Default,,0,0,0,,Мен сізге жай ғана негізгі спойлер берген жоқпын ба?
Dialogue: 0,0:08:49.02,0:08:52.28,Default,,0,0,0,,Ха! Жоқ, бұл шамамен 3 том.
Dialogue: 0,0:08:52.36,0:08:53.24,Default,,0,0,0,,Өте ерте...
Dialogue: 0,0:08:53.32,0:08:54.49,Default,,0,0,0,,Жеткілікті жеткілікті
Dialogue: 0,0:08:59.87,0:09:00.99,Default,,0,0,0,,Мұқият оқып шығыңыз
Dialogue: 0,0:09:03.83,0:09:05.46,Default,,0,0,0,,Иә? Жарайды ма?
Dialogue: 0,0:09:05.96,0:09:07.00,Default,,0,0,0,,Не?
Dialogue: 0,0:09:07.08,0:09:09.75,Default,,0,0,0,,Жоқ, сен мектеп қақпасында біреуді күтіп тұр едің ғой?
Dialogue: 0,0:09:09.84,0:09:10.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:12.59,0:09:13.34,Default,,0,0,0,,Иә
Dialogue: 0,0:09:15.34,0:09:16.13,Default,,0,0,0,,Иә
Dialogue: 0,0:09:16.72,0:09:17.34,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:28.56,0:09:32.57,Default,,0,0,0,,Ямада кейде жұмыстан ерте кетеді немесе жұмысқа демалыс алады.
Dialogue: 0,0:09:34.78,0:09:36.61,Default,,0,0,0,,А, мен бүгін отырмын.
Dialogue: 0,0:09:38.20,0:09:40.07,Default,,0,0,0,,Не? Сен бүгін ерте кетесің!
Dialogue: 0,0:09:40.58,0:09:41.87,Default,,0,0,0,,Мен біраз тоқтадым
Dialogue: 0,0:09:42.74,0:09:43.91,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:09:44.00,0:09:46.37,Default,,0,0,0,,Өткен күні мен: «Неге отырмайсың?» деп сұрадым.
Dialogue: 0,0:09:47.12,0:09:50.29,Default,,0,0,0,,Е, жоқ, тұрып қалсаң, басыңа кіру оңайырақ.
Dialogue: 0,0:09:50.38,0:09:52.13,Default,,0,0,0,,Сіз мұны айттыңыз.
Dialogue: 0,0:09:52.21,0:09:53.34,Default,,0,0,0,,Шулы Шулы!
Dialogue: 0,0:09:53.42,0:09:55.67,Default,,0,0,0,,А, бұл "Кими-оку" емес!
Dialogue: 0,0:09:55.76,0:09:56.55,Default,,0,0,0,,А...
Dialogue: 0,0:09:56.63,0:09:59.09,Default,,0,0,0,,Мен үйде манга оқимын.
Dialogue: 0,0:09:59.18,0:10:00.34,Default,,0,0,0,,Қазір оқыңыз!
Dialogue: 0,0:10:01.10,0:10:03.35,Default,,0,0,0,,Бұл... бұл қорқынышты роман.
Dialogue: 0,0:10:03.93,0:10:04.97,Default,,0,0,0,,Осы дүкеннен қанша адам ғайып болды екен?
Dialogue: 0,0:10:13.73,0:10:15.07,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:15.94,0:10:17.40,Default,,0,0,0,,А... жоқ, кешіріңіз.
Dialogue: 0,0:10:17.49,0:10:19.11,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:10:19.91,0:10:22.62,Default,,0,0,0,,А, мен қазір кетуім керек, кешіріңіз.
Dialogue: 0,0:10:23.12,0:10:24.66,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:10:26.25,0:10:28.96,Default,,0,0,0,,Иә? Неге маған қоңырау шалуды қойдыңыз?
Dialogue: 0,0:10:29.04,0:10:31.38,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:10:34.55,0:10:36.84,Default,,0,0,0,,Сен ертең мектепке келесің бе?
Dialogue: 0,0:10:36.92,0:10:39.38,Default,,0,0,0,,Жоқ... не тыңдадың?
Dialogue: 0,0:10:41.72,0:10:43.60,Default,,0,0,0,,Иә, барыңыз
Dialogue: 0,0:10:44.14,0:10:45.97,Default,,0,0,0,,Мен де кітапханаға барамын
Dialogue: 0,0:10:49.89,0:10:52.27,Default,,0,0,0,,Өйткені бұл дүниеде абсолюттер жоқ
Dialogue: 0,0:10:52.36,0:10:53.86,Default,,0,0,0,,Бұл егжей-тегжейлі.
Dialogue: 0,0:10:54.36,0:10:57.61,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:10:58.57,0:11:02.03,Default,,0,0,0,,Маған мектеп ұнайтын сияқты.
Dialogue: 0,0:11:04.03,0:11:06.04,Default,,0,0,0,,«Кимииро октавасы»
Dialogue: 0,0:11:06.95,0:11:08.83,Default,,0,0,0,,Сіз оны қалай оқисыз?
Dialogue: 0,0:11:11.21,0:11:12.17,Default,,0,0,0,,Уф… Ой, жоқ!
Dialogue: 0,0:11:13.67,0:11:15.09,Default,,0,0,0,,Уф… Ой, жоқ!
Dialogue: 0,0:11:22.51,0:11:25.10,Default,,0,0,0,,Міне~
Dialogue: 0,0:11:37.61,0:11:38.53,Default,,0,0,0,,Сіз оны оқыдыңыз ба?
Dialogue: 0,0:11:38.61,0:11:39.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:39.65,0:11:42.32,Default,,0,0,0,,Е, жоқ... әлі.
Dialogue: 0,0:11:42.82,0:11:45.12,Default,,0,0,0,,Мен кеше ойымды жинақтай алмадым.
Dialogue: 0,0:11:45.62,0:11:48.12,Default,,0,0,0,,Тез оқымасаңыз, спойлер аласыз.
Dialogue: 0,0:11:48.20,0:11:49.83,Default,,0,0,0,,Көп уақыт өтті.
Dialogue: 0,0:11:49.91,0:11:51.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:53.75,0:11:56.34,Default,,0,0,0,,Мен оны сыныпта да оқи алмаймын.
Dialogue: 0,0:11:59.05,0:11:59.80,Default,,0,0,0,,Ичикава
Dialogue: 0,0:11:59.88,0:12:00.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:02.38,0:12:03.38,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:12:03.47,0:12:06.35,Default,,0,0,0,,Неліктен сіз Ямадамен қалыпты сөйлесесіз?
Dialogue: 0,0:12:07.10,0:12:08.22,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:12:08.31,0:12:10.52,Default,,0,0,0,,ше? Олар сыныптас
Dialogue: 0,0:12:10.60,0:12:12.39,Default,,0,0,0,,Бұл достық емес пе?
Dialogue: 0,0:12:12.48,0:12:14.15,Default,,0,0,0,,Сонымен... осындай нәрсе
Dialogue: 0,0:12:14.65,0:12:16.94,Default,,0,0,0,,Бұл қорлау...
Dialogue: 0,0:12:17.57,0:12:20.90,Default,,0,0,0,,Сізге Ямада ұнай ма?
Dialogue: 0,0:12:21.40,0:12:21.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:22.53,0:12:24.66,Default,,0,0,0,,Жарайды, маған ұнайтын жігітті былай қойғанда.
Dialogue: 0,0:12:24.74,0:12:26.95,Default,,0,0,0,,Мүмкін сенің жігітің бар шығар.
Dialogue: 0,0:12:27.53,0:12:31.33,Default,,0,0,0,,Маған ондай нәрсе мүлдем мән бермейді.
Dialogue: 0,0:12:31.41,0:12:33.33,Default,,0,0,0,,Мынау... Қойбана?
Dialogue: 0,0:12:33.41,0:12:37.29,Default,,0,0,0,,Ичикава: Біз жақсы доспыз, сондықтан сіз бірдеңе білетін шығарсыз деп ойладым.
Dialogue: 0,0:12:37.38,0:12:38.75,Default,,0,0,0,,...
Dialogue: 0,0:12:38.84,0:12:40.46,Default,,0,0,0,,Кенеттен татами төсегі жарылып кетті.
Dialogue: 0,0:12:40.96,0:12:43.09,Default,,0,0,0,,Мен олардың жоқтығын білемін.
Dialogue: 0,0:12:43.17,0:12:44.72,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:12:44.80,0:12:47.60,Default,,0,0,0,,Мұны естігенімді ешкімге айтпа.
Dialogue: 0,0:12:47.68,0:12:49.64,Default,,0,0,0,,Ах, а... а
Dialogue: 0,0:12:50.14,0:12:52.60,Default,,0,0,0,,Бірақ бұл абайсызда, Ямада.
Dialogue: 0,0:12:52.68,0:12:54.35,Default,,0,0,0,,Мен сенімдімін…
Dialogue: 0,0:12:54.85,0:12:58.61,Default,,0,0,0,,Бірақ... мен сені жақсы көремін, сондықтан оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:12:59.61,0:13:00.90,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:00.98,0:13:02.86,Default,,0,0,0,,Бұл ұят
Dialogue: 0,0:13:03.44,0:13:05.49,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,0:13:05.57,0:13:08.37,Default,,0,0,0,,Мен оны жақында ғана байқадым.
Dialogue: 0,0:13:09.33,0:13:11.20,Default,,0,0,0,,Қашан...?
Dialogue: 0,0:13:11.29,0:13:14.87,Default,,0,0,0,,Хмм, сұрасаң... дұрыс.
Dialogue: 0,0:13:15.46,0:13:17.83,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:13:17.92,0:13:20.13,Default,,0,0,0,,Ямададан шыға алмадым.
Dialogue: 0,0:13:20.21,0:13:21.67,Default,,0,0,0,,Мен сұрамауым керек еді.
Dialogue: 0,0:13:22.17,0:13:25.76,Default,,0,0,0,,Қарашы, қызды шынымен ұнатсаң, оны тастап кете алмайсың, солай ма?
Dialogue: 0,0:13:25.84,0:13:27.38,Default,,0,0,0,,Бұл өте маңызды.
Dialogue: 0,0:13:27.47,0:13:28.34,Default,,0,0,0,,А...
Dialogue: 0,0:13:28.84,0:13:29.60,Default,,0,0,0,,Не?
Dialogue: 0,0:13:29.68,0:13:31.35,Default,,0,0,0,,Мен жүгері дорбаларын жүк көліктеріне тиеп, қоймаға апаратынмын.
Dialogue: 0,0:13:31.43,0:13:32.60,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:13:32.68,0:13:34.02,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:13:34.10,0:13:37.27,Default,,0,0,0,,Бұл маған «ұнайтын» нәрсені ұнатпаймын дегенді білдіре ме?
Dialogue: 0,0:13:37.35,0:13:39.06,Default,,0,0,0,,Сізге тек сексуалдық көзқараспен қарау
Dialogue: 0,0:13:39.15,0:13:41.23,Default,,0,0,0,,Иә? Эй, тыңдап тұрсың ба?
Dialogue: 0,0:13:42.19,0:13:44.57,Default,,0,0,0,,Жоқ... бұл жерде сізге ұнайтын нәрсе бар ма?
Dialogue: 0,0:13:44.65,0:13:47.61,Default,,0,0,0,,А? Эй, сенің көзің нашар ма?
Dialogue: 0,0:13:48.11,0:13:49.49,Default,,0,0,0,,Бет?
Dialogue: 0,0:13:49.57,0:13:50.99,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:13:51.08,0:13:52.62,Default,,0,0,0,,Көп нәрсе бар!
Dialogue: 0,0:13:52.70,0:13:55.54,Default,,0,0,0,,Сонымен қатар, стиль өте керемет.
Dialogue: 0,0:13:55.62,0:13:57.87,Default,,0,0,0,,Қалай болғанда да солай көрінеді
Dialogue: 0,0:13:57.96,0:14:00.38,Default,,0,0,0,,Кеуде жақсы, бірақ бұл аяқтар.
Dialogue: 0,0:14:00.46,0:14:02.46,Default,,0,0,0,,Бұл жұқа.
Dialogue: 0,0:14:02.55,0:14:05.88,Default,,0,0,0,,Жамбастары толық және эротикалық.
Dialogue: 0,0:14:06.47,0:14:08.18,Default,,0,0,0,,Қазір... Мен барамын.
Dialogue: 0,0:14:08.26,0:14:09.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:09.13,0:14:13.68,Default,,0,0,0,,Әй, білесің бе, басқаға айтпа.
Dialogue: 0,0:14:16.93,0:14:19.31,Default,,0,0,0,,Бұл не... ыңғайсыздық?
Dialogue: 0,0:14:20.06,0:14:23.07,Default,,0,0,0,,Осы уақытқа дейін мен көп лас сөздер айттым.
Dialogue: 0,0:14:23.15,0:14:25.07,Default,,0,0,0,,Мен әр жолы аздап тітіркенген болуым керек.
Dialogue: 0,0:14:25.78,0:14:28.07,Default,,0,0,0,,Тіпті мен саған эротикалық көзбен қараймын
Dialogue: 0,0:14:28.57,0:14:30.82,Default,,0,0,0,,Бірақ бұл жайсыздық...
Dialogue: 0,0:14:31.95,0:14:35.33,Default,,0,0,0,,Е, менің не айтып тұрғанымды қайдан білесің?
Dialogue: 0,0:14:35.41,0:14:37.37,Default,,0,0,0,,Әйтеуір оқиға ағымына байланысты
Dialogue: 0,0:14:38.33,0:14:42.13,Default,,0,0,0,,Бұл ыңғайсыздық менің махаббатымның шекарасы ма?
Dialogue: 0,0:14:43.96,0:14:47.17,Default,,0,0,0,,- (Кобаяши) Мен мұны қалай да түсінемін - (Секине) Күткендей, Баяшико
Dialogue: 0,0:14:47.67,0:14:50.38,Default,,0,0,0,,Сонымен, викторина туралы не айтасыз?
Dialogue: 0,0:14:50.88,0:14:52.34,Default,,0,0,0,,Хохеф холохохев
Dialogue: 0,0:14:52.85,0:14:53.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:54.10,0:14:54.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:54.97,0:14:55.76,Default,,0,0,0,,- (Секине) Не айттыңыз? -(Ёшида) Не айтып тұрсың?
Dialogue: 0,0:14:57.85,0:14:59.69,Default,,0,0,0,,Хохеф холохохев
Dialogue: 0,0:14:59.77,0:15:00.81,Default,,0,0,0,,Бірақ соғыс жыртқыштары сиқыр қолдана алмайды ғой, иә?
Dialogue: 0,0:15:00.89,0:15:02.35,Default,,0,0,0,,Жоқ, бұл не?
Dialogue: 0,0:15:03.19,0:15:04.15,Default,,0,0,0,,О...
Dialogue: 0,0:15:06.23,0:15:07.19,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,0:15:07.28,0:15:09.19,Default,,0,0,0,,Бұл «Не?» емес!
Dialogue: 0,0:15:10.49,0:15:11.70,Default,,0,0,0,,Соңында...
Dialogue: 0,0:15:11.78,0:15:15.20,Default,,0,0,0,,Мен де саған эротикалық көзбен қарайтыныма сенімдімін.
Dialogue: 0,0:15:15.70,0:15:19.62,Default,,0,0,0,,Бұл сізге Ямаданы ұнатпайтыныңызды білдіре ме?
Dialogue: 0,0:15:20.12,0:15:20.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:24.96,0:15:27.84,Default,,0,0,0,,Қалай... қалай... қалай
Dialogue: 0,0:15:28.92,0:15:30.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.47,0:15:34.22,Default,,0,0,0,,Мен енді тәтті жей алмаймын.
Dialogue: 0,0:15:34.30,0:15:37.39,Default,,0,0,0,,Тәттілер мені байсалды етіп көрсетті.
Dialogue: 0,0:15:37.47,0:15:40.27,Default,,0,0,0,,Күні кешеге дейін мұндай белгі болған жоқ, солай ма?
Dialogue: 0,0:15:40.77,0:15:42.73,Default,,0,0,0,,Егер солай десеңіз, онда иә.
Dialogue: 0,0:15:43.23,0:15:46.07,Default,,0,0,0,,Бірақ кітапханада ішіп-жеуге тыйым салынғаны дұрыс.
Dialogue: 0,0:15:46.57,0:15:48.23,Default,,0,0,0,,Бір қызығы осы.
Dialogue: 0,0:15:50.65,0:15:53.99,Default,,0,0,0,,Егер анық болса, оны қазір хабарландыру тақтасына қоюдың не қажеті бар?
Dialogue: 0,0:15:54.49,0:15:56.78,Default,,0,0,0,,Ешкім тамақ ішпейді
Dialogue: 0,0:15:58.49,0:15:59.79,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:15:59.87,0:16:01.29,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:16:01.79,0:16:03.37,Default,,0,0,0,,Ямада әзілі
Dialogue: 0,0:16:04.08,0:16:05.58,Default,,0,0,0,,Менің айтқым келгені
Dialogue: 0,0:16:05.67,0:16:07.88,Default,,0,0,0,,Мүмкін мен ішіп-жеп жатқан шығармын.
Dialogue: 0,0:16:07.96,0:16:10.01,Default,,0,0,0,,Менің ойымша, олар мұны біледі.
Dialogue: 0,0:16:10.51,0:16:12.17,Default,,0,0,0,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың, иә?
Dialogue: 0,0:16:12.26,0:16:14.39,Default,,0,0,0,,-де біреу сізді мазақ етті.
Dialogue: 0,0:16:15.34,0:16:20.06,Default,,0,0,0,,Менің білетінім Кобаяши Секине мен Йошида Хара.
Dialogue: 0,0:16:20.14,0:16:21.85,Default,,0,0,0,,Канзаки Киншу аңғары…
Dialogue: 0,0:16:21.93,0:16:24.56,Default,,0,0,0,,Ал... олай істеуді доғарайық.
Dialogue: 0,0:16:24.65,0:16:27.06,Default,,0,0,0,,Басқа адамдар да келіп-кетіп жатыр.
Dialogue: 0,0:16:27.15,0:16:28.36,Default,,0,0,0,,Сіз өте сүйкімдісіз.
Dialogue: 0,0:16:29.15,0:16:32.32,Default,,0,0,0,,Кітапханашыдан стикердің артындағы тарих туралы сұраңыз.
Dialogue: 0,0:16:32.82,0:16:33.70,Default,,0,0,0,,Иә
Dialogue: 0,0:16:37.62,0:16:38.70,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:16:38.78,0:16:39.95,Default,,0,0,0,,Бұрын қоқыс жәшігінде
Dialogue: 0,0:16:40.04,0:16:42.62,Default,,0,0,0,,Ол тәттілер салынған дорбаны лақтырып жібергенін айтты.
Dialogue: 0,0:16:42.71,0:16:43.83,Default,,0,0,0,,Бұл себеп пе?
Dialogue: 0,0:16:44.46,0:16:45.62,Default,,0,0,0,,Бұл да біртүрлі.
Dialogue: 0,0:16:46.13,0:16:50.34,Default,,0,0,0,,Өйткені мен тәттілерді кітапхананың қоқыс жәшігіне тастамаймын.
Dialogue: 0,0:16:50.84,0:16:51.46,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:16:52.13,0:16:55.38,Default,,0,0,0,,Нағыз кінәлі шығар
Dialogue: 0,0:16:55.47,0:16:57.18,Default,,0,0,0,,Вегетариандық деген нәрсе бар емес пе?
Dialogue: 0,0:16:57.68,0:16:58.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:59.18,0:17:00.93,Default,,0,0,0,,Бұл жолы әзіл емес!
Dialogue: 0,0:17:01.56,0:17:03.14,Default,,0,0,0,,А, стикер?
Dialogue: 0,0:17:03.23,0:17:07.81,Default,,0,0,0,,Уау...айқын болса да біртүрлі көрінеді.
Dialogue: 0,0:17:07.90,0:17:09.82,Default,,0,0,0,,Бұл еденде болды
Dialogue: 0,0:17:09.90,0:17:10.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:11.32,0:17:13.53,Default,,0,0,0,,Жарайды, кәмпит болса да.
Dialogue: 0,0:17:13.61,0:17:16.53,Default,,0,0,0,,Егер бұған рұқсат етсек, шектеу болмайды.
Dialogue: 0,0:17:16.61,0:17:20.03,Default,,0,0,0,,Түсінікті болса да, кейбір балалар жазбасаң түсінбейді.
Dialogue: 0,0:17:22.29,0:17:24.54,Default,,0,0,0,,Әй, бірдеңе айтпайсың ба?
Dialogue: 0,0:17:26.96,0:17:28.54,Default,,0,0,0,,Маған бірдеңе айтыңызшы!
Dialogue: 0,0:17:32.80,0:17:34.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:34.84,0:17:38.14,Default,,0,0,0,,Бүгін... соңғы рет пе?
Dialogue: 0,0:17:38.22,0:17:40.05,Default,,0,0,0,,Ямада кітапханаға келеді.
Dialogue: 0,0:17:40.76,0:17:42.01,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:42.51,0:17:46.35,Default,,0,0,0,,Егер мен тәтті жей алмасам, мұнда болуыма еш себеп жоқ.
Dialogue: 0,0:17:46.98,0:17:49.73,Default,,0,0,0,,Жоқ, сіз нені білдіреді?
Dialogue: 0,0:17:50.23,0:17:54.19,Default,,0,0,0,,Ямада кездейсоқ кітапханада болды, сондықтан біз жай ғана сөйлестік.
Dialogue: 0,0:17:55.86,0:17:57.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:59.16,0:18:01.58,Default,,0,0,0,,Мен бұған тыйым салынғанын бұрыннан білетінмін.
Dialogue: 0,0:18:01.66,0:18:04.41,Default,,0,0,0,,Стикер болса да, оның еш айырмашылығы болмас еді.
Dialogue: 0,0:18:05.08,0:18:07.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:07.21,0:18:09.63,Default,,0,0,0,,Бастапқыда мен тәуекелге бел байладым.
Dialogue: 0,0:18:10.13,0:18:12.25,Default,,0,0,0,,Салқын болмаңыз
Dialogue: 0,0:18:12.34,0:18:15.17,Default,,0,0,0,,Сол мұғалім мені тапса, болды...
Dialogue: 0,0:18:15.26,0:18:17.67,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:19.30,0:18:20.09,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:25.06,0:18:26.23,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:18:31.52,0:18:32.48,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:18:37.03,0:18:38.15,Default,,0,0,0,,Осы уақытта Джозеф пен басқалар—
Dialogue: 0,0:18:44.99,0:18:46.33,Default,,0,0,0,,Өте көп
Dialogue: 0,0:18:50.67,0:18:51.88,Default,,0,0,0,,Мен оны жақсы көремін!
Dialogue: 0,0:19:06.97,0:19:12.40,Default,,0,0,0,,Әй, шыбын... бұл қауіпті болды.
Dialogue: 0,0:19:16.11,0:19:19.11,Default,,0,0,0,,Ал... бұл шынымен қорқынышты болды ма?
Dialogue: 0,0:19:20.45,0:19:22.28,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:19:22.36,0:19:25.83,Default,,0,0,0,,Өйткені тәркілеудің орнына мен тыйым сала ма деп қорқамын.
Dialogue: 0,0:19:30.33,0:19:33.29,Default,,0,0,0,,Не? Ол еріді ме? Оны жуған дұрыс
Dialogue: 0,0:19:35.09,0:19:36.34,Default,,0,0,0,,Онда барыңыз.
Dialogue: 0,0:19:36.42,0:19:37.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:45.68,0:19:46.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:56.86,0:19:57.77,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:00.19,0:20:03.74,Default,,0,0,0,,Менің ойымша, қазірден бастап тәттілерді жеуден бас тартқан дұрыс.
Dialogue: 0,0:20:04.24,0:20:05.07,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:20:06.66,0:20:07.58,Default,,0,0,0,,Иә
Dialogue: 0,0:20:09.83,0:20:12.62,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:20:13.21,0:20:16.04,Default,,0,0,0,,Болды, бітті.
Dialogue: 0,0:20:17.42,0:20:18.75,Default,,0,0,0,,үшін
Dialogue: 0,0:20:27.60,0:20:29.01,Default,,0,0,0,,А... а...
Dialogue: 0,0:20:33.89,0:20:36.98,Default,,0,0,0,,Мен... Мен үй тапсырмасын орындауды ойладым.
Dialogue: 0,0:20:38.27,0:20:40.03,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:20:44.24,0:20:44.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:47.78,0:20:50.16,Default,,0,0,0,,Мен тәттілерді жеуден бас тартуды шештім.
Dialogue: 0,0:20:50.24,0:20:51.29,Default,,0,0,0,,үштен екіге дейін
Dialogue: 0,0:20:52.75,0:20:54.79,Default,,0,0,0,,Бұл санда емес.
Dialogue: 0,0:20:56.08,0:20:59.59,Default,,0,0,0,,Өйткені Ямада үшін ештеңе өзгерген жоқ.
Dialogue: 0,0:21:03.01,0:21:05.01,Default,,0,0,0,,♪～
Dialogue: 0,0:22:29.76,0:22:31.76,Default,,0,0,0,,～♪
Dialogue: 0,0:22:33.93,0:22:37.14,Default,,0,0,0,,Бірақ кәмпит дорбасын қоқыс жәшігіне кім лақтырды?
Dialogue: 0,0:22:37.23,0:22:38.14,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:22:38.23,0:22:39.48,Default,,0,0,0,,Бұл Ичикава емес пе?
Dialogue: 0,0:22:39.56,0:22:40.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:40.60,0:22:42.69,Default,,0,0,0,,Өйткені біраз уақыт бұрын...
Dialogue: 0,0:22:42.77,0:22:44.78,Default,,0,0,0,,- (Ямада) Хмм - (Ичикава) Е...
Dialogue: 0,0:22:47.44,0:22:48.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:49.70,0:22:50.91,Default,,0,0,0,,Хмм?
Dialogue: 0,0:22:51.49,0:22:54.58,Default,,0,0,0,,Жоқ, мен оны лақтырған жоқпын.
Dialogue: 0,0:22:54.66,0:22:56.62,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:22:57.66,0:22:58.46,Default,,0,0,0,,Бұл қоқыс
Dialogue: 0,0:22:58.54,0:22:59.79,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:22:59.87,0:23:01.38,Default,,0,0,0,,Сен оны үйге апардың ба?
Dialogue: 0,0:23:01.46,0:23:03.13,Default,,0,0,0,,Неліктен? неге?
Dialogue: 0,0:23:04.63,0:23:10.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
