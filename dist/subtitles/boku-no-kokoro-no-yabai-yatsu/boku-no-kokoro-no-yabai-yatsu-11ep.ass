Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.50,0:00:03.79,Default,,0,0,0,,Жаңа жыл түні
Dialogue: 0,0:00:04.50,0:00:06.17,Default,,0,0,0,,Жыл соңындағы отбасылық мейрамхана
Dialogue: 0,0:00:07.34,0:00:08.25,Default,,0,0,0,,Онда...
Dialogue: 0,0:00:13.68,0:00:15.51,Default,,0,0,0,,Бұл тозақ болды
Dialogue: 0,0:00:16.26,0:00:18.30,Default,,0,0,0,,Екеуің бір сыныптасыңдар ма?
Dialogue: 0,0:00:18.81,0:00:19.76,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:00:19.85,0:00:21.68,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:00:21.77,0:00:24.27,Default,,0,0,0,,Ей, орындарымызды ауыстырайық.
Dialogue: 0,0:00:24.77,0:00:28.94,Default,,0,0,0,,Сонымен, Ямада мырза, сіз не істеп жатырсыз?
Dialogue: 0,0:00:31.07,0:00:34.36,Default,,0,0,0,,Уақыт төрт күнге кері кетеді.
Dialogue: 0,0:00:35.53,0:00:37.53,Default,,0,0,0,,♪～
Dialogue: 0,0:02:02.91,0:02:04.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:06.62,0:02:09.21,Default,,0,0,0,,Акитаға жыл сайынғы қайтару
Dialogue: 0,0:02:09.29,0:02:12.46,Default,,0,0,0,,Соған қарамастан биыл күн жылы болатын сияқты.
Dialogue: 0,0:02:12.54,0:02:13.80,Default,,0,0,0,,- (Ичикаваның анасы) Әкесі - (Ичикаваның әкесі) Хмм...
Dialogue: 0,0:02:13.88,0:02:14.50,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:14.59,0:02:17.17,Default,,0,0,0,,Кёчан, бұл үлкен мәселе...
Dialogue: 0,0:02:17.26,0:02:19.43,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:21.43,0:02:23.01,Default,,0,0,0,,Мен Акитаға келсем де
Dialogue: 0,0:02:23.10,0:02:24.81,Default,,0,0,0,,Күнделікті өмірден ерекше айырмашылығы жоқ
Dialogue: 0,0:02:25.52,0:02:26.68,Default,,0,0,0,,Жалғыз мәселе...
Dialogue: 0,0:02:27.93,0:02:28.77,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:02:28.85,0:02:30.27,Default,,0,0,0,,Әпкеммен бір бөлмеде тұру
Dialogue: 0,0:02:30.77,0:02:32.86,Default,,0,0,0,,Иә? Оны қоюға әлі ерте ме?
Dialogue: 0,0:02:33.36,0:02:34.36,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:02:34.44,0:02:37.03,Default,,0,0,0,,Енді бұл бетті жасама
Dialogue: 0,0:02:37.11,0:02:39.11,Default,,0,0,0,,Өткен жылы да бірге болдық.
Dialogue: 0,0:02:39.20,0:02:41.53,Default,,0,0,0,,Иә, былтыр да солай болды.
Dialogue: 0,0:02:42.03,0:02:42.66,Default,,0,0,0,,Айырмашылығы...
Dialogue: 0,0:02:42.74,0:02:43.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:43.70,0:02:44.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:46.54,0:02:47.37,Default,,0,0,0,,Ямада
Dialogue: 0,0:02:48.37,0:02:49.66,Default,,0,0,0,,Тағы тамақ?
Dialogue: 0,0:02:50.67,0:02:51.79,Default,,0,0,0,,Аа, мен бұл туралы ойласам
Dialogue: 0,0:02:52.50,0:02:53.88,Default,,0,0,0,,Акита?
Dialogue: 0,0:02:53.96,0:02:56.88,Default,,0,0,0,,Менің ата-анамның екеуі де кантолық, сондықтан мен қызғанамын.
Dialogue: 0,0:02:57.38,0:02:59.67,Default,,0,0,0,,Мен қар көрінісін көргім келеді.
Dialogue: 0,0:02:59.76,0:03:03.85,Default,,0,0,0,,А... онда мен саған қарлы көріністің суретін жіберемін.
Dialogue: 0,0:03:05.01,0:03:07.72,Default,,0,0,0,,Шынымен бе? Бұл уәде
Dialogue: 0,0:03:12.10,0:03:12.98,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:13.98,0:03:15.15,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:16.82,0:03:18.48,Default,,0,0,0,,Иә? Қайда бара жатырсың?
Dialogue: 0,0:03:18.57,0:03:19.74,Default,,0,0,0,,Жаяу
Dialogue: 0,0:03:29.20,0:03:30.54,Default,,0,0,0,,Тыныштық
Dialogue: 0,0:03:37.96,0:03:39.96,Default,,0,0,0,,Мм... мм?
Dialogue: 0,0:03:42.59,0:03:44.47,Default,,0,0,0,,О... Да!
Dialogue: 0,0:03:50.02,0:03:52.06,Default,,0,0,0,,Кио Чан
Dialogue: 0,0:03:52.56,0:03:54.44,Default,,0,0,0,,Кио-чан!
Dialogue: 0,0:03:55.02,0:03:57.36,Default,,0,0,0,,Қанша жерге бардың... А?
Dialogue: 0,0:03:58.94,0:03:59.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:01.57,0:04:03.28,Default,,0,0,0,,Кио-чан!
Dialogue: 0,0:04:03.36,0:04:04.86,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:04:05.62,0:04:06.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:07.45,0:04:09.49,Default,,0,0,0,,Хмм... Мен ұйықтап жатырмын.
Dialogue: 0,0:04:09.58,0:04:11.45,Default,,0,0,0,,Бұл мүлде мүмкін емес
Dialogue: 0,0:04:11.54,0:04:12.62,Default,,0,0,0,,Тұру керек пе?
Dialogue: 0,0:04:14.83,0:04:15.50,Default,,0,0,0,,(Қараңыз!)
Dialogue: 0,0:04:15.58,0:04:17.00,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:04:17.09,0:04:18.00,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:04:21.51,0:04:24.93,Default,,0,0,0,,Үйге оралған бойда осылай болып кетті.
Dialogue: 0,0:04:25.43,0:04:28.01,Default,,0,0,0,,Неге сол жарға бардың?
Dialogue: 0,0:04:28.51,0:04:30.77,Default,,0,0,0,,Келіңіздер ме? Көңіліңіз толқып тұр ма?
Dialogue: 0,0:04:30.85,0:04:32.48,Default,,0,0,0,,Бұл сөзсіз өтірік
Dialogue: 0,0:04:33.23,0:04:36.06,Default,,0,0,0,,Негізі қазір өзімді сәл жоғары сезінемін.
Dialogue: 0,0:04:36.56,0:04:38.48,Default,,0,0,0,,Бірақ ойланып қарасаңыз
Dialogue: 0,0:04:38.98,0:04:43.11,Default,,0,0,0,,Бұл Кио Чанның бірінші рет тентек болып, ауыр жарақат алуы болуы мүмкін.
Dialogue: 0,0:04:43.19,0:04:45.11,Default,,0,0,0,,Бұзық емес
Dialogue: 0,0:04:46.28,0:04:49.70,Default,,0,0,0,,Ата-аналар мұндай сезімдер арқылы дұрыс көре алады.
Dialogue: 0,0:04:51.79,0:04:53.04,Default,,0,0,0,,Уау! Дәмді көрінеді...
Dialogue: 0,0:04:53.12,0:04:55.46,Default,,0,0,0,,Кешкі ас та керемет сәнді болды.
Dialogue: 0,0:04:55.54,0:04:56.92,Default,,0,0,0,,Иә, хмм.
Dialogue: 0,0:04:57.00,0:04:57.83,Default,,0,0,0,,Тоқта
Dialogue: 0,0:04:57.92,0:04:58.46,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:58.96,0:05:00.75,Default,,0,0,0,,Мен селфиге түстім.
Dialogue: 0,0:05:01.88,0:05:02.96,Default,,0,0,0,,Мен оны сізге жібердім.
Dialogue: 0,0:05:03.46,0:05:04.88,Default,,0,0,0,,Танымал болуы мүмкін
Dialogue: 0,0:05:05.76,0:05:07.22,Default,,0,0,0,,О
Dialogue: 0,0:05:08.80,0:05:10.47,Default,,0,0,0,,Бейне қоңырау
Dialogue: 0,0:05:16.89,0:05:18.02,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:05:18.10,0:05:20.77,Default,,0,0,0,,Ха! Көзілдірік... демалыс киімі!
Dialogue: 0,0:05:20.86,0:05:21.69,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:05:22.19,0:05:23.44,Default,,0,0,0,,Дыбысты ести алмайсыз ба?
Dialogue: 0,0:05:23.53,0:05:26.70,Default,,0,0,0,,Қарғыс атсын... Бүгін қолымнан келмейді!
Dialogue: 0,0:05:27.20,0:05:29.20,Default,,0,0,0,,Не… не болды? кенеттен
Dialogue: 0,0:05:29.28,0:05:30.45,Default,,0,0,0,,Бұл сызық.
Dialogue: 0,0:05:30.53,0:05:32.41,Default,,0,0,0,,Не болды? қол
Dialogue: 0,0:05:32.49,0:05:34.54,Default,,0,0,0,,А... жоқ, мен жай ғана құладым.
Dialogue: 0,0:05:35.04,0:05:37.46,Default,,0,0,0,,Мүлдем ауырмайды
Dialogue: 0,0:05:37.54,0:05:39.96,Default,,0,0,0,,Ха... Мен таң қалдым.
Dialogue: 0,0:05:40.54,0:05:42.05,Default,,0,0,0,,Иә?Ах!
Dialogue: 0,0:05:43.05,0:05:44.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:45.84,0:05:50.26,Default,,0,0,0,,Сондықтан мен ертең Токиоға қайта ұшамын деп шештім.
Dialogue: 0,0:05:50.35,0:05:52.81,Default,,0,0,0,,Түсіндім, бұл ұят.
Dialogue: 0,0:05:53.31,0:05:53.93,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:54.93,0:05:57.56,Default,,0,0,0,,Олай болса... Жарайды, қайтып келгенде...
Dialogue: 0,0:05:57.64,0:05:58.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:58.35,0:05:59.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:02.40,0:06:03.19,Default,,0,0,0,,Хаа!
Dialogue: 0,0:06:04.61,0:06:05.94,Default,,0,0,0,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,0:06:07.28,0:06:07.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:08.49,0:06:09.86,Default,,0,0,0,,Мен оны кесіп алдым.
Dialogue: 0,0:06:10.37,0:06:12.03,Default,,0,0,0,,Сүйкімді бала
Dialogue: 0,0:06:12.12,0:06:13.70,Default,,0,0,0,,К... Сыныптағы қыз
Dialogue: 0,0:06:14.20,0:06:16.66,Default,,0,0,0,,Менің айтайын дегенім, кешіріңіз, бұл шу болды.
Dialogue: 0,0:06:16.75,0:06:19.17,Default,,0,0,0,,Иә! Сіз хабар таратушы емессіз бе?
Dialogue: 0,0:06:19.25,0:06:20.50,Default,,0,0,0,,Уф... кетті.
Dialogue: 0,0:06:21.00,0:06:22.84,Default,,0,0,0,,Бұл өте сүйкімді болды
Dialogue: 0,0:06:23.42,0:06:24.92,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:06:25.42,0:06:28.42,Default,,0,0,0,,Сіздің қарама-қарсы жыныстағы достарыңыз бар шығар.
Dialogue: 0,0:06:28.93,0:06:30.18,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:06:30.26,0:06:31.55,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:32.05,0:06:35.68,Default,,0,0,0,,Жоқ, бірақ... Менің ойымша, олар дос...
Dialogue: 0,0:06:36.18,0:06:36.89,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:06:37.39,0:06:39.14,Default,,0,0,0,,Боқ... сабырлы бол.
Dialogue: 0,0:06:39.23,0:06:40.48,Default,,0,0,0,,Егер танылса...
Dialogue: 0,0:06:40.56,0:06:43.69,Default,,0,0,0,,Сонымен? ол саған ұнайды ма? Сіз кездесіп жүрсіз бе?
Dialogue: 0,0:06:43.77,0:06:44.52,Default,,0,0,0,,Келесі жолы кездесуге рұқсат етіңіз!
Dialogue: 0,0:06:44.61,0:06:45.53,Default,,0,0,0,,Мүлдем тітіркендіргіш
Dialogue: 0,0:06:48.99,0:06:50.95,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:06:51.86,0:06:54.33,Default,,0,0,0,,Ерте жат, шаршадың.
Dialogue: 0,0:06:56.16,0:06:57.91,Default,,0,0,0,,Неге тереңірек қазбайсың?
Dialogue: 0,0:06:58.00,0:07:00.08,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:07:00.16,0:07:01.46,Default,,0,0,0,,Ах
Dialogue: 0,0:07:03.79,0:07:06.21,Default,,0,0,0,,Сіз мөрді дұрыс қолданбайсыз.
Dialogue: 0,0:07:20.81,0:07:23.77,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:07:24.27,0:07:25.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:25.90,0:07:27.98,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:07:28.82,0:07:29.99,Default,,0,0,0,,Достар…
Dialogue: 0,0:07:30.49,0:07:34.57,Default,,0,0,0,,соншалықты алыс сөз болды, ол тіпті болжамды түрлендіруде де көрінбеді.
Dialogue: 0,0:07:36.49,0:07:38.24,Default,,0,0,0,,Мөртабан қандай эмоция?
Dialogue: 0,0:07:42.08,0:07:43.58,Default,,0,0,0,,Сонымен... телефон?
Dialogue: 0,0:07:44.08,0:07:45.00,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:07:45.08,0:07:45.96,Default,,0,0,0,,Ерте
Dialogue: 0,0:07:49.09,0:07:50.55,Default,,0,0,0,,Сіздің әпкеңіз ұйықтады ма?
Dialogue: 0,0:07:51.05,0:07:53.76,Default,,0,0,0,,Қазір дәлізге шыққан соң, мен жақсымын.
Dialogue: 0,0:07:54.26,0:07:55.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:55.60,0:07:56.85,Default,,0,0,0,,Қолдарың жақсы ма?
Dialogue: 0,0:07:56.93,0:08:00.39,Default,,0,0,0,,А... Иә, сәл ыңғайсыз.
Dialogue: 0,0:08:01.06,0:08:02.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:03.39,0:08:06.23,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:08:06.31,0:08:07.82,Default,,0,0,0,,Жақын жерде сусындар бар ма?
Dialogue: 0,0:08:08.40,0:08:09.57,Default,,0,0,0,,Сусын?
Dialogue: 0,0:08:14.36,0:08:15.49,Default,,0,0,0,,Иә, бар.
Dialogue: 0,0:08:15.99,0:08:16.87,Default,,0,0,0,,Мен оны ала аламын ба?
Dialogue: 0,0:08:17.37,0:08:19.41,Default,,0,0,0,,Иә... мен алдым.
Dialogue: 0,0:08:19.49,0:08:21.29,Default,,0,0,0,,Кәне, ішіп алайық.
Dialogue: 0,0:08:25.75,0:08:26.67,Default,,0,0,0,,Терезе бар ма?
Dialogue: 0,0:08:27.17,0:08:27.96,Default,,0,0,0,,Сыртқа қараңыз
Dialogue: 0,0:08:28.46,0:08:29.13,Default,,0,0,0,,Сыртта?
Dialogue: 0,0:08:34.22,0:08:35.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:38.43,0:08:40.64,Default,,0,0,0,,Мен айды көрмеймін.
Dialogue: 0,0:08:41.22,0:08:42.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:44.64,0:08:45.48,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:08:46.73,0:08:48.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:50.23,0:08:51.15,Default,,0,0,0,,Уау...
Dialogue: 0,0:08:54.45,0:08:57.53,Default,,0,0,0,,Дәлірек айтсақ, бұл нені білдіреді...
Dialogue: 0,0:08:59.41,0:09:00.58,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:09:06.58,0:09:08.54,Default,,0,0,0,,Кешіріңіз, түн ортасында
Dialogue: 0,0:09:09.04,0:09:12.17,Default,,0,0,0,,А, жоқ... Соңғы кездері көп ұйықтай алмай жүрмін.
Dialogue: 0,0:09:12.84,0:09:16.43,Default,,0,0,0,,Содан кейін бос қолыңызды басыңызға қойыңыз.
Dialogue: 0,0:09:16.51,0:09:17.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:19.64,0:09:20.43,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:09:20.51,0:09:23.89,Default,,0,0,0,,3 рет жоғарыдан төменге қарай
Dialogue: 0,0:09:24.39,0:09:25.94,Default,,0,0,0,,Қайталау
Dialogue: 0,0:09:27.40,0:09:28.40,Default,,0,0,0,,Не?
Dialogue: 0,0:09:28.90,0:09:30.65,Default,,0,0,0,,Ұйқының сүйкімділігі
Dialogue: 0,0:09:31.15,0:09:32.82,Default,,0,0,0,,Қыздарға мұндай нәрсе ұнайды.
Dialogue: 0,0:09:33.32,0:09:34.65,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:34.74,0:09:36.61,Default,,0,0,0,,Олай болса, қайырлы түн
Dialogue: 0,0:09:36.70,0:09:37.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:37.53,0:09:38.86,Default,,0,0,0,,Ах... қайырлы түн...
Dialogue: 0,0:09:38.95,0:09:39.66,Default,,0,0,0,,(Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,0:09:40.32,0:09:41.95,Default,,0,0,0,,Қарғыс атқыр... тез
Dialogue: 0,0:09:42.49,0:09:45.08,Default,,0,0,0,,Ол қашықтан басқарылатын сияқты.
Dialogue: 0,0:09:49.29,0:09:52.34,Default,,0,0,0,,Бірдеңе болды, соңында мен...
Dialogue: 0,0:09:54.38,0:09:58.01,Default,,0,0,0,,Кио-чан, сен ересек адам сияқтысың.
Dialogue: 0,0:09:58.09,0:09:59.97,Default,,0,0,0,,Сыртқы түрі өзгермегенімен
Dialogue: 0,0:10:00.05,0:10:00.55,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:10:01.80,0:10:04.39,Default,,0,0,0,,Мен Токиоға бір күнде оралуды шештім.
Dialogue: 0,0:10:04.89,0:10:07.73,Default,,0,0,0,,Мен кәдесый сатып алуым керек.
Dialogue: 0,0:10:07.81,0:10:09.73,Default,,0,0,0,,Әй, мына үшеуі жақсы ма?
Dialogue: 0,0:10:09.81,0:10:10.44,Default,,0,0,0,,Иә
Dialogue: 0,0:10:11.48,0:10:14.61,Default,,0,0,0,,Айтпақшы, Ямада, маған Ину ұнады.
Dialogue: 0,0:10:14.69,0:10:16.53,Default,,0,0,0,,Уау өте сүйкімді
Dialogue: 0,0:10:16.61,0:10:17.74,Default,,0,0,0,,Сәйкестендіру керек пе?
Dialogue: 0,0:10:17.82,0:10:19.32,Default,,0,0,0,,ше? Неге...
Dialogue: 0,0:10:20.36,0:10:21.87,Default,,0,0,0,,Жаса! Мен оны сатып аламын!
Dialogue: 0,0:10:21.95,0:10:23.20,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:23.28,0:10:24.87,Default,,0,0,0,,Сен оны не үшін тартасың?
Dialogue: 0,0:10:26.37,0:10:29.71,Default,,0,0,0,,Біз доспыз, сондықтан кәдесый жақсы болар еді.
Dialogue: 0,0:10:31.17,0:10:32.88,Default,,0,0,0,,Сол бала
Dialogue: 0,0:10:32.96,0:10:35.67,Default,,0,0,0,,Ол сүйкімді, бірақ мен оны тым талғампаз дер едім.
Dialogue: 0,0:10:35.76,0:10:37.34,Default,,0,0,0,,Мен ұстамды емес дер едім...
Dialogue: 0,0:10:37.42,0:10:38.13,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:38.22,0:10:41.30,Default,,0,0,0,,Қысқасы, әйел бет емес.
Dialogue: 0,0:10:41.39,0:10:43.89,Default,,0,0,0,,Эгё Бұл шындық
Dialogue: 0,0:10:43.97,0:10:45.14,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:10:45.22,0:10:48.64,Default,,0,0,0,,Мен ешқашан орындалмайтын ғашықпын деп ойлайсың.
Dialogue: 0,0:10:49.27,0:10:52.44,Default,,0,0,0,,Ал... Дегенмен қателеспеген шығармын.
Dialogue: 0,0:10:53.56,0:10:56.69,Default,,0,0,0,,Әпкем бір жағынан маған ұқсайды ғой.
Dialogue: 0,0:10:57.19,0:11:01.03,Default,,0,0,0,,Егер қолың жетпейтін нәрсе болса, жарақат алмас бұрын тез бас тарт.
Dialogue: 0,0:11:01.53,0:11:02.99,Default,,0,0,0,,Бұл түрі.
Dialogue: 0,0:11:03.49,0:11:08.04,Default,,0,0,0,,Бірақ дәл қазір, тіпті дәл осы сәтте мен LINE өзара әрекеттесуіме қарап отырмын.
Dialogue: 0,0:11:08.62,0:11:10.33,Default,,0,0,0,,Ямаданы басымнан шығара алмаймын
Dialogue: 0,0:11:10.87,0:11:13.75,Default,,0,0,0,,Сол себепті кеше маған телефон соққан қыз...
Dialogue: 0,0:11:13.83,0:11:14.54,Default,,0,0,0,,Ямада
Dialogue: 0,0:11:15.04,0:11:16.00,Default,,0,0,0,,Ямада?
Dialogue: 0,0:11:16.71,0:11:18.63,Default,,0,0,0,,Кио Чан суық тиіп қалғанда
Dialogue: 0,0:11:19.22,0:11:21.22,Default,,0,0,0,,Мен жалғыз келіп, хат қалдырдым...
Dialogue: 0,0:11:21.72,0:11:23.43,Default,,0,0,0,,Өтірік! Әлгі бала?
Dialogue: 0,0:11:23.51,0:11:26.31,Default,,0,0,0,,лас болғандықтан бала деп ойладым.
Dialogue: 0,0:11:26.85,0:11:30.02,Default,,0,0,0,,Бар емес пе? импульс
Dialogue: 0,0:11:30.10,0:11:31.27,Default,,0,0,0,,Ниш
Dialogue: 0,0:11:31.77,0:11:33.35,Default,,0,0,0,,Өйткені біз өте жақынбыз.
Dialogue: 0,0:11:33.44,0:11:35.11,Default,,0,0,0,,Ей, келесі жолы кездесейік.
Dialogue: 0,0:11:35.19,0:11:36.32,Default,,0,0,0,,Сәлем анашым, ояныңыз~
Dialogue: 0,0:11:36.40,0:11:38.48,Default,,0,0,0,,О, тоқтат!
Dialogue: 0,0:11:41.36,0:11:42.57,Default,,0,0,0,,Қараңызшы
Dialogue: 0,0:11:42.66,0:11:44.53,Default,,0,0,0,,Мен Осородан сатып алғанмын.
Dialogue: 0,0:11:44.62,0:11:45.53,Default,,0,0,0,,Жаңа жылдық сапарға қоса беріледі
Dialogue: 0,0:11:46.70,0:11:48.41,Default,,0,0,0,,Иә? Қайда бара жатырсың?
Dialogue: 0,0:11:48.91,0:11:51.04,Default,,0,0,0,,Кітапты қайтарыңыз.
Dialogue: 0,0:11:51.83,0:11:53.29,Default,,0,0,0,,Мен өтірік айтпаймын
Dialogue: 0,0:11:55.88,0:11:57.29,Default,,0,0,0,,Манга және
Dialogue: 0,0:11:57.80,0:12:00.46,Default,,0,0,0,,Мен Рождествода қайтаруды ұмытып кеткен орамал
Dialogue: 0,0:12:01.09,0:12:03.68,Default,,0,0,0,,Және Акита сувенирлері
Dialogue: 0,0:12:05.05,0:12:05.80,Default,,0,0,0,,Бір!
Dialogue: 0,0:12:05.89,0:12:06.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:07.26,0:12:07.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:08.51,0:12:10.68,Default,,0,0,0,,Мориё қаласы дейсіз бе? Хмм…
Dialogue: 0,0:12:11.18,0:12:12.85,Default,,0,0,0,,Мориё қаласы дейсіз бе? Хмм…
Dialogue: 0,0:12:13.44,0:12:15.56,Default,,0,0,0,,Ал... бұл кездесу...
Dialogue: 0,0:12:15.65,0:12:18.65,Default,,0,0,0,,А, жоқ, мен бұл туралы ойладым.
Dialogue: 0,0:12:18.73,0:12:21.61,Default,,0,0,0,,Сіз жарақат алдыңыз, сіз велосипедпен жүре алмайсыз.
Dialogue: 0,0:12:21.69,0:12:22.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:23.03,0:12:25.11,Default,,0,0,0,,Бірақ егер оны дұрыс емес жерге қойсаңыз...
Dialogue: 0,0:12:25.20,0:12:26.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:28.70,0:12:31.25,Default,,0,0,0,,Біраз уақыт өтті
Dialogue: 0,0:12:31.75,0:12:33.08,Default,,0,0,0,,5 күн болды.
Dialogue: 0,0:12:33.16,0:12:34.29,Default,,0,0,0,,- (Уантаро) Бір! -(Ямада) Ах.
Dialogue: 0,0:12:35.08,0:12:36.54,Default,,0,0,0,,Бұл Вантаро
Dialogue: 0,0:12:36.63,0:12:37.75,Default,,0,0,0,,Бұл ит
Dialogue: 0,0:12:38.25,0:12:39.38,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:40.88,0:12:41.84,Default,,0,0,0,,Дөңгелек
Dialogue: 0,0:12:43.67,0:12:44.47,Default,,0,0,0,,Кун
Dialogue: 0,0:12:45.18,0:12:49.72,Default,,0,0,0,,Ойланып қарасаңыз, кәдесыйлар ауыр емес пе?
Dialogue: 0,0:12:50.51,0:12:53.06,Default,,0,0,0,,Мен иттерді жақсы көретінім есімде қорқынышты.
Dialogue: 0,0:12:53.56,0:12:56.48,Default,,0,0,0,,Тәттілер жақсы болды, Ямада сорпасы.
Dialogue: 0,0:12:57.44,0:13:01.98,Default,,0,0,0,,Соңғы кездері мен терең ойланбай, ойланбай әрекет ете бастадым.
Dialogue: 0,0:13:02.49,0:13:04.07,Default,,0,0,0,,Бұл нәтиже
Dialogue: 0,0:13:04.57,0:13:05.40,Default,,0,0,0,,Өзіңізге қамқорлық жасау керек
Dialogue: 0,0:13:05.49,0:13:06.74,Default,,0,0,0,,Ах
Dialogue: 0,0:13:07.32,0:13:09.28,Default,,0,0,0,,Иә, мен қақпақты ашық қалдырдым.
Dialogue: 0,0:13:09.99,0:13:11.04,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:16.00,0:13:18.46,Default,,0,0,0,,Эй, Ичикава, сен де бұйрық беріп көр.
Dialogue: 0,0:13:18.54,0:13:19.79,Default,,0,0,0,,Е...
Dialogue: 0,0:13:20.88,0:13:22.51,Default,,0,0,0,,Ла… дөңгелек
Dialogue: 0,0:13:30.01,0:13:30.97,Default,,0,0,0,,бейім
Dialogue: 0,0:13:33.02,0:13:34.23,Default,,0,0,0,,- (Вантаро) Кун - (Ичикава) Ах...
Dialogue: 0,0:13:35.94,0:13:36.60,Default,,0,0,0,,Қолдар
Dialogue: 0,0:13:40.40,0:13:41.90,Default,,0,0,0,,Сіз мұны қазір істемек болдыңыз.
Dialogue: 0,0:13:42.40,0:13:43.40,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:13:48.24,0:13:49.66,Default,,0,0,0,,Менің қолым суық...
Dialogue: 0,0:13:50.91,0:13:51.74,Default,,0,0,0,,Суық, солай емес пе?
Dialogue: 0,0:13:52.24,0:13:53.87,Default,,0,0,0,,Иә, сәл ғана...
Dialogue: 0,0:13:54.83,0:13:57.33,Default,,0,0,0,,Аа, дұрыс, глушитель
Dialogue: 0,0:13:59.83,0:14:01.13,Default,,0,0,0,,Ой…
Dialogue: 0,0:14:02.04,0:14:03.05,Default,,0,0,0,,Міне.
Dialogue: 0,0:14:04.13,0:14:06.76,Default,,0,0,0,,Шаң басып кетпесін деп пластмассаға салып қойдым.
Dialogue: 0,0:14:10.97,0:14:11.89,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:14:13.39,0:14:15.68,Default,,0,0,0,,Мен оны Ичикаваға беруді ойладым.
Dialogue: 0,0:14:16.27,0:14:16.93,Default,,0,0,0,,А...
Dialogue: 0,0:14:17.85,0:14:22.52,Default,,0,0,0,,Бірақ мен... ұнамауы мүмкін сияқты.
Dialogue: 0,0:14:23.86,0:14:26.03,Default,,0,0,0,,Шынымен бе? Онда мен оны қазір үйге алып кетейін.
Dialogue: 0,0:14:27.03,0:14:27.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:28.32,0:14:30.11,Default,,0,0,0,,Бірнеше ауыр естеліктер қайтадан оралды, иә?
Dialogue: 0,0:14:31.20,0:14:33.03,Default,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,0:14:42.13,0:14:43.29,Default,,0,0,0,,Акита ит
Dialogue: 0,0:14:44.13,0:14:45.92,Default,,0,0,0,,О... кәдесый сияқты.
Dialogue: 0,0:14:51.80,0:14:52.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.01,0:14:54.31,Default,,0,0,0,,Е!
Dialogue: 0,0:14:55.64,0:14:57.56,Default,,0,0,0,,- (Ямада) Ахаха фуфуфу - (Вантаро) Вуф
Dialogue: 0,0:14:58.31,0:15:00.56,Default,,0,0,0,,О, жоқ, жоқ
Dialogue: 0,0:15:01.90,0:15:03.15,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:15:04.94,0:15:06.32,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:15:13.32,0:15:16.24,Default,,0,0,0,,Бұл акита ит болғандықтан, оны Акита Кентаро деп атайық.
Dialogue: 0,0:15:16.74,0:15:18.45,Default,,0,0,0,,Сізде ат қою мағынасы жоқ.
Dialogue: 0,0:15:18.54,0:15:19.79,Default,,0,0,0,,Акита Ину қоры
Dialogue: 0,0:15:20.29,0:15:22.75,Default,,0,0,0,,Аа, дұрыс, Ичикава, сен жаңа жылдық қонаққа барасың ба?
Dialogue: 0,0:15:23.25,0:15:25.25,Default,,0,0,0,,А, кеттік
Dialogue: 0,0:15:25.84,0:15:26.88,Default,,0,0,0,,Әрқашан отбасымен бірге
Dialogue: 0,0:15:26.96,0:15:28.63,Default,,0,0,0,,Шынымен бе? Алақай!
Dialogue: 0,0:15:28.71,0:15:31.72,Default,,0,0,0,,Жарайды, мен сізге орын мен уақытты кейін жіберемін.
Dialogue: 0,0:15:31.80,0:15:32.68,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:15:32.76,0:15:33.26,Default,,0,0,0,,А...
Dialogue: 0,0:15:34.89,0:15:36.01,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:38.52,0:15:40.43,Default,,0,0,0,,Осыдан бірнеше күн өткен соң
Dialogue: 0,0:15:41.35,0:15:44.90,Default,,0,0,0,,Мен мұны білмей тұрып, мен күн сайын Ямадамен байланыста болдым.
Dialogue: 0,0:15:46.19,0:15:49.49,Default,,0,0,0,,Жоқ, жоқ, басқа қыздар туралы есту жиіркенішті.
Dialogue: 0,0:15:49.57,0:15:51.99,Default,,0,0,0,,Мен бұл жерде сенімді жауапты ұстанамын...
Dialogue: 0,0:15:53.91,0:15:57.83,Default,,0,0,0,,Бәлкім, ол қызып кеткен болар.
Dialogue: 0,0:16:01.12,0:16:02.92,Default,,0,0,0,,Уф... суық
Dialogue: 0,0:16:03.92,0:16:05.13,Default,,0,0,0,,Не?
Dialogue: 0,0:16:05.21,0:16:06.09,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:16:06.17,0:16:06.71,Default,,0,0,0,,Өте өкінішті...
Dialogue: 0,0:16:06.79,0:16:08.46,Default,,0,0,0,,Жаңа жыл қарсаңында күткендей
Dialogue: 0,0:16:08.96,0:16:10.80,Default,,0,0,0,,Жаңа ғана сусын сатып алдым...
Dialogue: 0,0:16:11.30,0:16:11.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.26,0:16:15.43,Default,,0,0,0,,О~ Велосипед-кун
Dialogue: 0,0:16:15.51,0:16:16.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:16.35,0:16:18.01,Default,,0,0,0,,Аа, бұл бала кім?
Dialogue: 0,0:16:18.51,0:16:20.06,Default,,0,0,0,,Келіңіздер ме? Мой, мен білмеймін
Dialogue: 0,0:16:20.85,0:16:24.35,Default,,0,0,0,,Мм, мен сенімдімін, қала... қала...
Dialogue: 0,0:16:24.44,0:16:25.35,Default,,0,0,0,,Ичихара…
Dialogue: 0,0:16:25.85,0:16:27.77,Default,,0,0,0,,Аа, дұрыс, Ичихара-кун.
Dialogue: 0,0:16:28.77,0:16:32.36,Default,,0,0,0,,Ал енді былай
Dialogue: 0,0:16:33.74,0:16:34.66,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:16:35.16,0:16:36.70,Default,,0,0,0,,Ямада мырза, сіз не істеп жатырсыз?
Dialogue: 0,0:16:37.20,0:16:39.58,Default,,0,0,0,,Күтілгендей, мені пайдаланыңыз...
Dialogue: 0,0:16:40.08,0:16:42.16,Default,,0,0,0,,Сіз LINE білесіз бе? Ямада мырзаныкі
Dialogue: 0,0:16:42.25,0:16:43.37,Default,,0,0,0,,СОЛ?
Dialogue: 0,0:16:43.87,0:16:47.46,Default,,0,0,0,,Е-е, жоқ... Олар телепатиялық жолмен сөйлесетін сияқты.
Dialogue: 0,0:16:47.96,0:16:50.63,Default,,0,0,0,,Бұл бала маған айтпайды.
Dialogue: 0,0:16:50.71,0:16:52.46,Default,,0,0,0,,Ичихара-кун да сыныптас, солай ма?
Dialogue: 0,0:16:52.97,0:16:54.55,Default,,0,0,0,,Хмм? Солай ма?
Dialogue: 0,0:16:54.63,0:16:56.34,Default,,0,0,0,,Өзін басқа біреу етіп көрсету?
Dialogue: 0,0:16:56.43,0:16:57.55,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:58.05,0:17:00.43,Default,,0,0,0,,Таныссың деп айту қиын болар еді.
Dialogue: 0,0:17:00.51,0:17:02.98,Default,,0,0,0,,Сол бала, Ямада мырза...
Dialogue: 0,0:17:03.93,0:17:04.44,Default,,0,0,0,,Не!
Dialogue: 0,0:17:04.52,0:17:06.85,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:17:07.90,0:17:09.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:10.73,0:17:11.78,Default,,0,0,0,,«Анна Ямада»
Dialogue: 0,0:17:13.03,0:17:14.74,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:17:15.40,0:17:16.57,Default,,0,0,0,,Мен қайғылымын
Dialogue: 0,0:17:17.07,0:17:19.16,Default,,0,0,0,,А, м, бұл...
Dialogue: 0,0:17:19.66,0:17:22.95,Default,,0,0,0,,Кіші балаларыңа олай істеме, қиналып қалдың.
Dialogue: 0,0:17:23.83,0:17:27.00,Default,,0,0,0,,Кешіріңіз, бірақ сіз маған кофе әкеле аласыз ба?
Dialogue: 0,0:17:27.08,0:17:28.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:29.33,0:17:30.00,Default,,0,0,0,,Иә
Dialogue: 0,0:17:40.30,0:17:42.60,Default,,0,0,0,,Мо, мені де ауыстыршы.
Dialogue: 0,0:17:48.60,0:17:50.90,Default,,0,0,0,,Күш қолданудың уақыты келді ме?
Dialogue: 0,0:17:56.61,0:17:58.95,Default,,0,0,0,,Мен саған Ичихара-кунның айтқанын айтпаймын.
Dialogue: 0,0:17:59.45,0:18:01.99,Default,,0,0,0,,Ондағы екі адам да сенен естімейтіндерін айтты.
Dialogue: 0,0:18:02.49,0:18:04.12,Default,,0,0,0,,Ешқандай қиындық тудыруға ниетім жоқ.
Dialogue: 0,0:18:07.71,0:18:08.83,Default,,0,0,0,,Әлі де жақсы емес пе?
Dialogue: 0,0:18:17.55,0:18:19.34,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:18:20.39,0:18:22.68,Default,,0,0,0,,Неліктен? Мұның себебі неде?
Dialogue: 0,0:18:24.22,0:18:25.31,Default,,0,0,0,,Менің иісімді есіңе түсірдің бе?
Dialogue: 0,0:18:26.85,0:18:27.68,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:18:28.19,0:18:29.81,Default,,0,0,0,,Өйткені бұл маған ұнамайды
Dialogue: 0,0:18:34.57,0:18:36.32,Default,,0,0,0,,Мо мен үйге баруым керек.
Dialogue: 0,0:18:36.82,0:18:39.11,Default,,0,0,0,,Өтінемін, мені үйге апарыңыз, Ичихара-кун.
Dialogue: 0,0:18:39.20,0:18:39.82,Default,,0,0,0,,А...
Dialogue: 0,0:18:40.32,0:18:42.03,Default,,0,0,0,,Түнде жүру қорқынышты
Dialogue: 0,0:18:42.12,0:18:44.83,Default,,0,0,0,,А, онда мен барайын ба?
Dialogue: 0,0:18:45.33,0:18:47.04,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:18:47.75,0:18:50.29,Default,,0,0,0,,Біз доспыз.
Dialogue: 0,0:18:59.13,0:19:01.89,Default,,0,0,0,,Мен саған ғашық болғым келмейді
Dialogue: 0,0:19:02.39,0:19:04.39,Default,,0,0,0,,Жарайды, мен де қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:19:04.47,0:19:05.85,Default,,0,0,0,,Мен өтірік айтуда жақсы емеспін
Dialogue: 0,0:19:06.35,0:19:08.77,Default,,0,0,0,,Жоқ, жай ғана көңіл-күйім жақсы болды.
Dialogue: 0,0:19:08.85,0:19:11.94,Default,,0,0,0,,Мүмкін сіз келесі жолы ағаңызға айтуыңыз керек.
Dialogue: 0,0:19:12.02,0:19:15.32,Default,,0,0,0,,Сіз мені және Ямаданы дұрыс түсінбейсіз.
Dialogue: 0,0:19:15.82,0:19:17.73,Default,,0,0,0,,Түсінбеушілік~?
Dialogue: 0,0:19:18.40,0:19:19.49,Default,,0,0,0,,- (Секине) Сонда... - (Ичикава) А?
Dialogue: 0,0:19:19.57,0:19:21.20,Default,,0,0,0,,Мұны істеу дұрыс емес.
Dialogue: 0,0:19:21.28,0:19:22.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:22.66,0:19:24.49,Default,,0,0,0,,Мен соншалықты жылдам қозғала алмадым.
Dialogue: 0,0:19:24.58,0:19:28.50,Default,,0,0,0,,Жоқ, ой... Менің ойымша, бұл түсінбеушілік...
Dialogue: 0,0:19:30.37,0:19:34.75,Default,,0,0,0,,Маған ұнайды... Менің ойымша, Ямада.
Dialogue: 0,0:19:35.75,0:19:36.59,Default,,0,0,0,,Күн
Dialogue: 0,0:19:41.05,0:19:42.89,Default,,0,0,0,,Мен білемін! Мен білемін!
Dialogue: 0,0:19:42.97,0:19:46.05,Default,,0,0,0,,Теру~ Теру~ Ру~
Dialogue: 0,0:19:48.10,0:19:51.56,Default,,0,0,0,,Айтайын, түсіну оңай емес пе?
Dialogue: 0,0:19:58.57,0:19:59.74,Default,,0,0,0,,Дәл осы жерде.
Dialogue: 0,0:20:00.24,0:20:01.20,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:20:02.61,0:20:03.66,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:03.74,0:20:05.16,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:20:05.24,0:20:07.49,Default,,0,0,0,,Мұндай жағдайда кез келген адам мұны жасайды.
Dialogue: 0,0:20:07.99,0:20:09.70,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:20:09.79,0:20:11.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:13.29,0:20:14.58,Default,,0,0,0,,Келгіңіз келе ме?
Dialogue: 0,0:20:14.67,0:20:15.54,Default,,0,0,0,,А...
Dialogue: 0,0:20:16.04,0:20:18.00,Default,,0,0,0,,Олай болса... Жаңа жыл құтты болсын.
Dialogue: 0,0:20:18.63,0:20:20.84,Default,,0,0,0,,Мен оны қарап шықтым!
Dialogue: 0,0:20:23.80,0:20:26.64,Default,,0,0,0,,«Мен сені сүйемін» деп дауыстап айта алдым
Dialogue: 0,0:20:27.14,0:20:30.02,Default,,0,0,0,,Сосын сәл жыныссыз болады...
Dialogue: 0,0:20:34.44,0:20:36.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:40.90,0:20:42.15,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:20:42.65,0:20:43.57,Default,,0,0,0,,(Игги) Ұф! (Джозеф) Хи-хи
Dialogue: 0,0:20:44.07,0:20:47.95,Default,,0,0,0,,Жоқ... не болды? Бұл сирек.
Dialogue: 0,0:20:48.78,0:20:51.79,Default,,0,0,0,,Әйтеуір, сенің дауысыңды естігім келеді.
Dialogue: 0,0:20:52.29,0:20:55.54,Default,,0,0,0,,Мм... аа... Жаңа жыл құтты болсын
Dialogue: 0,0:20:56.04,0:20:57.42,Default,,0,0,0,,Иә? Таң болды ма?
Dialogue: 0,0:20:58.00,0:21:00.00,Default,,0,0,0,,Мен сізге айтқым келді
Dialogue: 0,0:21:00.50,0:21:01.71,Default,,0,0,0,,Уххх
Dialogue: 0,0:21:02.21,0:21:03.67,Default,,0,0,0,,А, Моеко осында.
Dialogue: 0,0:21:03.76,0:21:04.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:05.13,0:21:06.84,Default,,0,0,0,,Ал... Сонда...
Dialogue: 0,0:21:06.93,0:21:08.10,Default,,0,0,0,,- (Ичикава) Осы жерде - (Ямада) А, а...
Dialogue: 0,0:21:11.14,0:21:13.81,Default,,0,0,0,,Менен бір күні...
Dialogue: 0,0:21:17.27,0:21:17.77,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:21:19.77,0:21:22.19,Default,,0,0,0,,Анна қоқыс жәшігін көрмей ме?
Dialogue: 0,0:21:23.36,0:21:24.15,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:24.65,0:21:26.66,Default,,0,0,0,,♪～
Dialogue: 0,0:22:45.57,0:22:47.57,Default,,0,0,0,,～♪
