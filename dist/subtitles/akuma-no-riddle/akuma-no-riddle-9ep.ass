Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.91,0:01:39.28,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:39.28,0:01:42.41,Default,,0,0,0,,)
Dialogue: 0,0:01:42.41,0:01:45.17,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:45.17,0:01:47.20,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:47.20,0:01:50.61,Default,,0,0,0,,)
Dialogue: 0,0:01:50.61,0:01:54.24,Default,,0,0,0,,((Бұл баланың күшін көргендердің бәрі таң қалды➡
Dialogue: 0,0:01:54.24,0:01:56.81,Default,,0,0,0,,Бұл мүмкін емес деп қорқамын.➡
Dialogue: 0,0:01:56.81,0:02:00.51,Default,,0,0,0,,Бұл Азуманың мұрагері үшін тамаша есім емес пе? ))
Dialogue: 0,0:02:01.97,0:02:07.07,Default,,0,0,0,,)
Dialogue: 0,0:02:10.24,0:02:12.53,Default,,0,0,0,,((Мен әлі де сол қызды қалаймын➡
Dialogue: 0,0:02:12.53,0:02:14.95,Default,,0,0,0,,Мен Азуманың менің орныма келгенін қаламаймын.➡
Dialogue: 0,0:02:14.95,0:02:19.78,Default,,0,0,0,,Сенің біз сияқты қанішер болғаныңды қаламаймыз))
Dialogue: 0,0:02:19.78,0:02:22.15,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:02:22.15,0:02:24.91,Default,,0,0,0,,((Майко өтінемін➡
Dialogue: 0,0:02:24.91,0:02:27.44,Default,,0,0,0,,Маған бірдеңе болса➡
Dialogue: 0,0:02:27.44,0:02:29.94,Default,,0,0,0,,Анау бала... Токаку...))
Dialogue: 0,0:02:33.27,0:02:37.34,Default,,0,0,0,,((Токаку-чан, мұнда кел. Тезірек! Уақытымыз жоқ!➡)
Dialogue: 0,0:02:37.34,0:02:41.51,Default,,0,0,0,,Токаку-чан, қазірден бастап біреуді өлтіруді ойласаң➡
Dialogue: 0,0:02:41.51,0:02:44.43,Default,,0,0,0,,Мына ғибадатхананы есте сақта))
Dialogue: 0,0:02:44.43,0:02:46.51,Default,,0,0,0,,)
Dialogue: 0,0:02:46.51,0:02:49.85,Default,,0,0,0,,)
Dialogue: 0,0:02:49.85,0:02:53.00,Default,,0,0,0,,)) (шынайы қоңырау)((себебі ол қарап отыр))
Dialogue: 0,0:02:53.00,0:02:55.00,Default,,0,0,0,,Пішан! (найзағай)
Dialogue: 0,0:02:56.59,0:03:01.46,Default,,0,0,0,,♬～
Dialogue: 0,0:03:01.46,0:03:03.78,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:03:03.78,0:03:05.80,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:03:05.80,0:03:09.68,Default,,0,0,0,,Жауап! Қазір дыбыс қандай!? Неге Банба!?
Dialogue: 0,0:03:09.68,0:03:11.82,Default,,0,0,0,,Сіз уәде бердіңіз.➡
Dialogue: 0,0:03:11.82,0:03:14.81,Default,,0,0,0,,Мен жиіркенішті Азуманы➡ өлтіріп жатқанда
Dialogue: 0,0:03:14.81,0:03:17.03,Default,,0,0,0,,Сіз Харумен қалағаныңызды жасай аласыз.
Dialogue: 0,0:03:17.03,0:03:19.03,Default,,0,0,0,,А...
Dialogue: 0,0:03:20.46,0:03:22.46,Default,,0,0,0,,≫Бум! (қирау дыбысы) Ха!
Dialogue: 0,0:03:24.92,0:03:27.00,Default,,0,0,0,,Мен сізге рұқсат бермеймін! Қарғыс атсын!
Dialogue: 0,0:03:27.00,0:03:31.39,Default,,0,0,0,,♬～
Dialogue: 0,0:03:31.39,0:03:33.51,Default,,0,0,0,,Қарғыс атқыр... Жолдан кет!
Dialogue: 0,0:03:33.51,0:03:36.68,Default,,0,0,0,,Егер мені өлтіретін болсаң➡
Dialogue: 0,0:03:36.68,0:03:39.56,Default,,0,0,0,,Бұл болмауы керек еді.
Dialogue: 0,0:03:39.56,0:03:42.76,Default,,0,0,0,,♬～
Dialogue: 0,0:03:44.19,0:03:46.24,Default,,0,0,0,,♬ Кері санауға дайынсыз ба
Dialogue: 0,0:03:46.24,0:03:48.41,Default,,0,0,0,,♬ Жүгіруге жол жоқ
Dialogue: 0,0:03:48.41,0:03:57.55,Default,,0,0,0,,♬～
Dialogue: 0,0:03:57.55,0:04:02.27,Default,,0,0,0,,♬ Оңай диапазонға түспеңіз.
Dialogue: 0,0:04:02.27,0:04:07.04,Default,,0,0,0,,♬ Бұл қырғи-қабақ соғыс аймағы. Қазіргі жағдай жалықтырады.
Dialogue: 0,0:04:07.04,0:04:11.75,Default,,0,0,0,,♬ Ей, балалар, сондықтан ерекше екенсіңдер.
Dialogue: 0,0:04:11.75,0:04:13.82,Default,,0,0,0,,♬ Баяғыда сыйымдылық асып кеткен
Dialogue: 0,0:04:13.82,0:04:16.08,Default,,0,0,0,,♬ Өзін-өзі мазақ ету түбі жоқ сезім
Dialogue: 0,0:04:16.08,0:04:18.14,Default,,0,0,0,,♬ Өте сүйкімді
Dialogue: 0,0:04:18.14,0:04:21.06,Default,,0,0,0,,♬ Мен саған ақымақтығымды көрсете алмаймын.
Dialogue: 0,0:04:21.06,0:04:23.07,Default,,0,0,0,,♬ Бекер толқу
Dialogue: 0,0:04:23.07,0:04:25.07,Default,,0,0,0,,♬ Тек ынталандыру үшін
Dialogue: 0,0:04:26.48,0:04:29.13,Default,,0,0,0,,♬ Қабылдау/бүлік Екі ғана таңдау бар ма?
Dialogue: 0,0:04:29.13,0:04:32.90,Default,,0,0,0,,♬ ah Эстетика «Мен ешкімге тиіспеймін»
Dialogue: 0,0:04:32.90,0:04:34.94,Default,,0,0,0,,♬ Жараның кінәсіздігі
Dialogue: 0,0:04:34.94,0:04:37.57,Default,,0,0,0,,♬ Мен де сол топқа кіремін.
Dialogue: 0,0:04:37.57,0:04:39.61,Default,,0,0,0,,♬ орылатын болады
Dialogue: 0,0:04:39.61,0:04:42.11,Default,,0,0,0,,♬ Ешбір жағдайда әрқашан жалғасуда
Dialogue: 0,0:04:42.11,0:04:46.25,Default,,0,0,0,,♬ Белдемшенің етегі туралы шындық
Dialogue: 0,0:04:46.25,0:04:51.24,Default,,0,0,0,,♬ Тек ақымақ сияқты сеніңіз
Dialogue: 0,0:04:51.24,0:04:55.51,Default,,0,0,0,,♬ Маған қатты әсер етті
Dialogue: 0,0:04:55.51,0:05:02.13,Default,,0,0,0,,♬ Оны твиттер арқылы жазыңыз.
Dialogue: 0,0:05:02.13,0:05:11.53,Default,,0,0,0,,♬～
Dialogue: 0,0:05:24.57,0:05:27.81,Default,,0,0,0,,♬～
Dialogue: 0,0:05:27.81,0:05:30.24,Default,,0,0,0,,♬~
Dialogue: 0,0:05:30.24,0:05:32.98,Default,,0,0,0,,Рахмет.➡
Dialogue: 0,0:05:32.98,0:05:37.93,Default,,0,0,0,,Сіздің арқаңызда Махиру тағы бір қазынаға қол жеткізді.➡
Dialogue: 0,0:05:37.93,0:05:40.75,Default,,0,0,0,,Ол болған бос орынды толтырыңыз➡
Dialogue: 0,0:05:40.75,0:05:43.07,Default,,0,0,0,,Бұл ең үлкен қазына!
Dialogue: 0,0:05:43.07,0:05:45.07,Default,,0,0,0,,Котон! Апыр-ай! Ахх...
Dialogue: 0,0:05:46.94,0:05:48.98,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:48.98,0:05:51.06,Default,,0,0,0,,Хаа ха ха...➡
Dialogue: 0,0:05:51.06,0:05:54.65,Default,,0,0,0,,Мен ұялы телефонымды лақтырып жібердім
Dialogue: 0,0:05:54.65,0:05:57.50,Default,,0,0,0,,Бум! (Майя) Ахаха, тамаша.
Dialogue: 0,0:05:57.50,0:06:00.61,Default,,0,0,0,,Оңай бітсе қызық болмас еді.
Dialogue: 0,0:06:00.61,0:06:03.48,Default,,0,0,0,,Хахахааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:06:03.48,0:06:06.83,Default,,0,0,0,,♬~
Dialogue: 0,0:06:06.83,0:06:13.40,Default,,0,0,0,,♬～
Dialogue: 0,0:06:13.40,0:06:15.74,Default,,0,0,0,,≪Бум! Ха...
Dialogue: 0,0:06:15.74,0:06:18.32,Default,,0,0,0,,Сіз жігітті шығыстан іздеп жүрсіз бе? ➡
Dialogue: 0,0:06:18.32,0:06:21.06,Default,,0,0,0,,Ол жігіт қазір қасында болар еді➡
Dialogue: 0,0:06:21.06,0:06:23.24,Default,,0,0,0,,Инукай мені өлтіріп жатыр!
Dialogue: 0,0:06:23.24,0:06:26.06,Default,,0,0,0,,♬~
Dialogue: 0,0:06:26.06,0:06:28.22,Default,,0,0,0,,♬~
Dialogue: 0,0:06:28.22,0:06:31.72,Default,,0,0,0,,Бум! Бум!
Dialogue: 0,0:06:33.74,0:06:35.94,Default,,0,0,0,,Ешқандай көмек келмейді.➡
Dialogue: 0,0:06:37.34,0:06:39.41,Default,,0,0,0,,Қалай атасаң да➡
Dialogue: 0,0:06:39.41,0:06:43.80,Default,,0,0,0,,Қоңырау шалсаңыз да, қоңырау шалсаңыз да ...
Dialogue: 0,0:06:43.80,0:06:45.80,Default,,0,0,0,,♬~
Dialogue: 0,0:06:48.14,0:06:50.17,Default,,0,0,0,,))
Dialogue: 0,0:06:50.17,0:06:53.61,Default,,0,0,0,,Ешкім Ешкім ➡
Dialogue: 0,0:06:53.61,0:06:55.61,Default,,0,0,0,,Ешкім...
Dialogue: 0,0:06:58.05,0:07:01.85,Default,,0,0,0,,Мен оны көрмедім! Ол жерде жоқ, еш жерде жоқ!
Dialogue: 0,0:07:01.85,0:07:04.25,Default,,0,0,0,,Мұнда ➡
Dialogue: 0,0:07:04.25,0:07:06.27,Default,,0,0,0,,Мұнда ешкім жоқ!
Dialogue: 0,0:07:06.27,0:07:18.25,Default,,0,0,0,,♬～
Dialogue: 0,0:07:18.25,0:07:21.15,Default,,0,0,0,,Сол жерде Азумамен жақсы араласыңыз.
Dialogue: 0,0:07:23.77,0:07:26.74,Default,,0,0,0,,Басыңыз! (Майя) Уау!
Dialogue: 0,0:07:26.74,0:07:28.78,Default,,0,0,0,,Парин! Апыр-ай!
Dialogue: 0,0:07:28.78,0:07:32.38,Default,,0,0,0,,♬～
Dialogue: 0,0:07:32.38,0:07:34.38,Default,,0,0,0,,Хехе...
Dialogue: 0,0:07:36.99,0:07:41.39,Default,,0,0,0,,Басынан біртүрлі деп ойладым!
Dialogue: 0,0:07:41.39,0:07:46.14,Default,,0,0,0,,Сен мұнда не үшін келдің? Бұл көздің жауын алады.
Dialogue: 0,0:07:46.14,0:07:48.43,Default,,0,0,0,,Мылтық! Уф...
Dialogue: 0,0:07:48.43,0:07:51.73,Default,,0,0,0,,Ичинозаға қол тигізбеу керек пе? Қате емес пе?
Dialogue: 0,0:07:51.73,0:07:54.90,Default,,0,0,0,,Өлтіруге қабілетсіздігіңізді жасыру үшін камуфляж
Dialogue: 0,0:07:54.90,0:07:58.21,Default,,0,0,0,,Оның да жүзі жақсы.
Dialogue: 0,0:07:58.21,0:08:00.94,Default,,0,0,0,,≪Ештеңені ойламаңыз. Ештеңені сезінбеу≫
Dialogue: 0,0:08:00.94,0:08:02.96,Default,,0,0,0,,≪Әдеттегідей...≫
Dialogue: 0,0:08:02.96,0:08:05.98,Default,,0,0,0,,Бұл не, батыста Кузуха, шығыста Азума?
Dialogue: 0,0:08:05.98,0:08:10.07,Default,,0,0,0,,Мен сені өлтірсем, бұл менің ең күшті екенімді білдіре ме!?
Dialogue: 0,0:08:10.07,0:08:12.07,Default,,0,0,0,,Какин!
Dialogue: 0,0:08:12.07,0:08:14.34,Default,,0,0,0,,Хехе. Кук…
Dialogue: 0,0:08:14.34,0:08:16.54,Default,,0,0,0,,[TEL] (Кіріс электрондық пошта/Үнсіз режим)
Dialogue: 0,0:08:16.54,0:08:18.91,Default,,0,0,0,,Хошу қаласынан өтіп бара жатып
Dialogue: 0,0:08:18.91,0:08:22.95,Default,,0,0,0,,♬～
Dialogue: 0,0:08:22.95,0:08:25.75,Default,,0,0,0,,Ах! Бля... Бля...
Dialogue: 0,0:08:27.44,0:08:29.49,Default,,0,0,0,,Ах… Уф…
Dialogue: 0,0:08:29.49,0:08:34.58,Default,,0,0,0,,♬～
Dialogue: 0,0:08:34.58,0:08:36.61,Default,,0,0,0,,Егер сіз осындай нәрсені көріп отырсаңыз ше? ➡
Dialogue: 0,0:08:36.61,0:08:39.15,Default,,0,0,0,,Исукеге дөрекілік көрсетіп жатқан жоқсың ба?
Dialogue: 0,0:08:39.15,0:08:44.85,Default,,0,0,0,,♬～
Dialogue: 0,0:08:44.85,0:08:46.85,Default,,0,0,0,,♬~
Dialogue: 0,0:08:48.81,0:08:50.81,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:08:52.58,0:08:55.06,Default,,0,0,0,,Сәлем! (Исуке) Ах!
Dialogue: 0,0:08:55.06,0:08:58.00,Default,,0,0,0,,♬～
Dialogue: 0,0:08:58.00,0:09:01.50,Default,,0,0,0,,Гохогогого гогого...
Dialogue: 0,0:09:03.67,0:09:06.77,Default,,0,0,0,,Уф.
Dialogue: 0,0:09:06.77,0:09:11.18,Default,,0,0,0,,♬～
Dialogue: 0,0:09:11.18,0:09:13.20,Default,,0,0,0,,Токаку!
Dialogue: 0,0:09:13.20,0:09:18.14,Default,,0,0,0,,♬～
Dialogue: 0,0:09:18.14,0:09:20.44,Default,,0,0,0,,Бум! Ах... Уф!
Dialogue: 0,0:09:21.87,0:09:24.51,Default,,0,0,0,,Күте тұрыңыз... Иә...
Dialogue: 0,0:09:24.51,0:09:36.42,Default,,0,0,0,,♬～
Dialogue: 0,0:09:36.42,0:09:40.48,Default,,0,0,0,,Хэхехехехе...
Dialogue: 0,0:09:40.48,0:09:48.87,Default,,0,0,0,,♬～
Dialogue: 0,0:09:48.87,0:09:51.52,Default,,0,0,0,,((Егер ол қазір қасында болса➡
Dialogue: 0,0:09:51.52,0:09:54.02,Default,,0,0,0,,Инукай мені өлтіріп жатыр! ))
Dialogue: 0,0:09:56.14,0:09:58.29,Default,,0,0,0,,≪Жарайды. Токаку мырза➡
Dialogue: 0,0:09:58.29,0:10:00.78,Default,,0,0,0,,Мұны оңай істеу мүмкін емес≫
Dialogue: 0,0:10:00.78,0:10:03.68,Default,,0,0,0,,Ги... Ха!
Dialogue: 0,0:10:03.68,0:10:14.01,Default,,0,0,0,,≪Жақсы...
Dialogue: 0,0:10:14.01,0:10:27.51,Default,,0,0,0,,♬～
Dialogue: 0,0:10:27.51,0:10:30.58,Default,,0,0,0,,Уф~
Dialogue: 0,0:10:30.58,0:10:33.38,Default,,0,0,0,,Каран…
Dialogue: 0,0:10:33.38,0:10:35.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:35.48,0:10:37.80,Default,,0,0,0,,Ха...
Dialogue: 0,0:10:37.80,0:10:41.10,Default,,0,0,0,,Тонтон. Онда бар ма?
Dialogue: 0,0:10:44.02,0:10:46.02,Default,,0,0,0,,♬~
Dialogue: 0,0:10:47.41,0:10:50.81,Default,,0,0,0,,Concon. Сіз сондасыз ба?
Dialogue: 0,0:10:52.25,0:10:54.30,Default,,0,0,0,,≫Бум!
Dialogue: 0,0:10:54.30,0:10:57.54,Default,,0,0,0,,Сіз сондасыз ба? Concon
Dialogue: 0,0:10:57.54,0:10:59.57,Default,,0,0,0,,♬~
Dialogue: 0,0:10:59.57,0:11:06.14,Default,,0,0,0,,♬～
Dialogue: 0,0:11:06.14,0:11:09.01,Default,,0,0,0,,≫(Майя) Сіз кіресіз бе?
Dialogue: 0,0:11:09.01,0:11:11.22,Default,,0,0,0,,≫Бум!
Dialogue: 0,0:11:11.22,0:11:13.70,Default,,0,0,0,,≫(Майя) Сіз кіресіз бе?
Dialogue: 0,0:11:13.70,0:11:15.75,Default,,0,0,0,,≫Бум!
Dialogue: 0,0:11:15.75,0:11:18.51,Default,,0,0,0,,≫(Майя) Сіз кіресіз бе?
Dialogue: 0,0:11:18.51,0:11:20.54,Default,,0,0,0,,≫Бум!
Dialogue: 0,0:11:20.54,0:11:29.03,Default,,0,0,0,,♬～
Dialogue: 0,0:11:29.03,0:11:31.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:32.80,0:11:35.31,Default,,0,0,0,,≫Concon
Dialogue: 0,0:11:35.31,0:11:37.44,Default,,0,0,0,,Бұл... Bang!
Dialogue: 0,0:11:37.44,0:11:43.78,Default,,0,0,0,,♬～
Dialogue: 0,0:11:43.78,0:11:46.83,Default,,0,0,0,,Ахахахха, керемет!
Dialogue: 0,0:11:46.83,0:11:50.54,Default,,0,0,0,,Мұрын Менің мұрным езіліп кетті! Ахахха!
Dialogue: 0,0:11:50.54,0:11:52.57,Default,,0,0,0,,Хахахаха｡➡
Dialogue: 0,0:11:52.57,0:11:54.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:54.61,0:11:59.30,Default,,0,0,0,,♬～
Dialogue: 0,0:11:59.30,0:12:03.90,Default,,0,0,0,,10 минут үзіліс~ Жайлап алайық.
Dialogue: 0,0:12:03.90,0:12:06.59,Default,,0,0,0,,Түн әлі ұзақ.
Dialogue: 0,0:12:06.59,0:12:10.59,Default,,0,0,0,,♬~
Dialogue: 0,0:12:12.31,0:12:14.31,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:17.03,0:12:20.07,Default,,0,0,0,,≪Қайда? Күн шуақты. Сен қайдасың? ≫
Dialogue: 0,0:12:20.07,0:12:31.20,Default,,0,0,0,,♬～
Dialogue: 0,0:12:31.20,0:12:33.95,Default,,0,0,0,,≪Осы жерден не болады...≫
Dialogue: 0,0:12:33.95,0:12:35.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:35.98,0:12:39.50,Default,,0,0,0,,♬～
Dialogue: 0,0:12:39.50,0:12:42.21,Default,,0,0,0,,Какин Какин Какин!
Dialogue: 0,0:12:42.21,0:12:45.58,Default,,0,0,0,,♬～
Dialogue: 0,0:12:45.58,0:12:47.58,Default,,0,0,0,,Какин!
Dialogue: 0,0:12:49.03,0:12:51.57,Default,,0,0,0,,Фу. Ах...
Dialogue: 0,0:12:51.57,0:13:01.57,Default,,0,0,0,,♬～
Dialogue: 0,0:15:09.69,0:15:12.64,Default,,0,0,0,,≪Мен не істеуім керек? Сіз қайда жүгіресіз? ≫
Dialogue: 0,0:15:12.64,0:15:14.54,Default,,0,0,0,,≪Токаку-сан жарай ма? ≫
Dialogue: 0,0:15:14.54,0:15:16.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:16.58,0:15:20.60,Default,,0,0,0,,♬～
Dialogue: 0,0:15:20.60,0:15:22.63,Default,,0,0,0,,Токаку мырза...
Dialogue: 0,0:15:22.63,0:15:26.22,Default,,0,0,0,,♬～
Dialogue: 0,0:15:26.22,0:15:28.22,Default,,0,0,0,,Га. Бум!
Dialogue: 0,0:15:28.22,0:15:31.31,Default,,0,0,0,,♬～
Dialogue: 0,0:15:31.31,0:15:33.79,Default,,0,0,0,,Жалтарма.➡
Dialogue: 0,0:15:33.79,0:15:38.35,Default,,0,0,0,,О, Шығыс? Қазірдің өзінде бітті ме?
Dialogue: 0,0:15:38.35,0:15:40.72,Default,,0,0,0,,Мәйіт қайда? ➡
Dialogue: 0,0:15:40.72,0:15:43.57,Default,,0,0,0,,Хаха, күте тұрыңыз~
Dialogue: 0,0:15:43.57,0:15:55.92,Default,,0,0,0,,♬～
Dialogue: 0,0:15:55.92,0:15:57.94,Default,,0,0,0,,Ах
Dialogue: 0,0:15:57.94,0:16:00.84,Default,,0,0,0,,♬～
Dialogue: 0,0:16:00.84,0:16:02.87,Default,,0,0,0,,Сылдырлат... Соққы (есік дыбысы)
Dialogue: 0,0:16:02.87,0:16:05.04,Default,,0,0,0,,♬~
Dialogue: 0,0:16:05.04,0:16:07.04,Default,,0,0,0,,≫Бум!
Dialogue: 0,0:16:08.76,0:16:13.82,Default,,0,0,0,,Хехе. Мен сізге құтылу мүмкін емес дедім!
Dialogue: 0,0:16:13.82,0:16:17.09,Default,,0,0,0,,♬～
Dialogue: 0,0:16:17.09,0:16:19.11,Default,,0,0,0,,♬~
Dialogue: 0,0:16:19.11,0:16:22.46,Default,,0,0,0,,♬～
Dialogue: 0,0:16:22.46,0:16:25.28,Default,,0,0,0,,Бум! иә? Ммм…｡➡
Dialogue: 0,0:16:25.28,0:16:27.98,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:16:30.87,0:16:33.17,Default,,0,0,0,,Уф! Ой... ой...
Dialogue: 0,0:16:34.62,0:16:37.29,Default,,0,0,0,,Сіз осы уақытқа дейін тамаша жұмыс жасадыңыз.
Dialogue: 0,0:16:37.29,0:16:40.88,Default,,0,0,0,,Сыйлық ретінде мен сені бір оқпен батырамын.
Dialogue: 0,0:16:40.88,0:16:44.25,Default,,0,0,0,,Хару өлмейді. Ол міндетті түрде бітіреді➡
Dialogue: 0,0:16:44.25,0:16:46.38,Default,,0,0,0,,Мен Токаку мырзаға уәде бердім.
Dialogue: 0,0:16:46.38,0:16:49.15,Default,,0,0,0,,Ей, шығыс қазірдің өзінде...
Dialogue: 0,0:16:49.15,0:16:53.07,Default,,0,0,0,,Токаку-сан да өлмейді! Мен мұндай жерде өле алмаймын!
Dialogue: 0,0:16:53.07,0:16:57.63,Default,,0,0,0,,♬～
Dialogue: 0,0:16:57.63,0:17:00.63,Default,,0,0,0,,Хехе. Сау бол~
Dialogue: 0,0:17:05.85,0:17:07.91,Default,,0,0,0,,()
Dialogue: 0,0:17:07.91,0:17:11.01,Default,,0,0,0,,)
Dialogue: 0,0:17:13.28,0:17:16.65,Default,,0,0,0,,Уау!!
Dialogue: 0,0:17:16.65,0:17:20.23,Default,,0,0,0,,Ахх! Уф... Уф...
Dialogue: 0,0:17:20.23,0:17:23.12,Default,,0,0,0,,≫Адаммен...(аяқ дыбысы)
Dialogue: 0,0:17:23.12,0:17:25.16,Default,,0,0,0,,Токакуса… ah
Dialogue: 0,0:17:25.16,0:17:31.61,Default,,0,0,0,,♬～
Dialogue: 0,0:17:31.61,0:17:33.71,Default,,0,0,0,,Уф... Уф...｡➡
Dialogue: 0,0:17:34.98,0:17:36.98,Default,,0,0,0,,Уф... уау! Докка
Dialogue: 0,0:17:39.04,0:17:43.11,Default,,0,0,0,,Менің осында екенімді білесіз бе?
Dialogue: 0,0:17:43.11,0:17:45.51,Default,,0,0,0,,Тотокаку қайтыс болды.
Dialogue: 0,0:17:49.35,0:17:52.02,Default,,0,0,0,,((Токаку-чан, асығыңыз! Уақытымыз жоқ!))
Dialogue: 0,0:17:52.02,0:17:54.24,Default,,0,0,0,,)
Dialogue: 0,0:17:54.24,0:17:57.77,Default,,0,0,0,,((｡ ➡
Dialogue: 0,0:17:57.77,0:18:00.47,Default,,0,0,0,,Хината әлеміне! ))
Dialogue: 0,0:18:00.47,0:18:03.36,Default,,0,0,0,,)
Dialogue: 0,0:18:03.36,0:18:06.08,Default,,0,0,0,,)
Dialogue: 0,0:18:06.08,0:18:08.10,Default,,0,0,0,,((Менің әпкем де көп тіледі➡
Dialogue: 0,0:18:08.10,0:18:10.87,Default,,0,0,0,,Себебі мен абдырап қалдым))
Dialogue: 0,0:18:10.87,0:18:14.27,Default,,0,0,0,,) (шынайы қоңырау)((Бұл менің кінәм.➡
Dialogue: 0,0:18:14.27,0:18:17.61,Default,,0,0,0,,Қарындасым болғандықтан, Азуманың билігінен қаштым➡
Dialogue: 0,0:18:17.61,0:18:21.58,Default,,0,0,0,,Бәрін иығына көтеріп, күрескен жалғыз өзі...))
Dialogue: 0,0:18:21.58,0:18:23.81,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:18:23.81,0:18:25.85,Default,,0,0,0,,)
Dialogue: 0,0:18:25.85,0:18:36.79,Default,,0,0,0,,♬～
Dialogue: 0,0:18:36.79,0:18:39.15,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:18:39.15,0:18:47.20,Default,,0,0,0,,♬～
Dialogue: 0,0:18:47.20,0:18:50.11,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:18:50.11,0:18:53.71,Default,,0,0,0,,)
Dialogue: 0,0:18:53.71,0:18:57.11,Default,,0,0,0,,((Бұл сенің кінәң емес...｡➡
Dialogue: 0,0:18:57.11,0:19:01.14,Default,,0,0,0,,Есіңізде болмаса да➡
Dialogue: 0,0:19:01.14,0:19:05.31,Default,,0,0,0,,Әпкем екеуміз оны үнемі көріп отырдық...))
Dialogue: 0,0:19:05.31,0:19:09.18,Default,,0,0,0,,♬～
Dialogue: 0,0:19:09.18,0:19:11.23,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:19:11.23,0:19:30.55,Default,,0,0,0,,♬～
Dialogue: 0,0:19:30.55,0:19:35.35,Default,,0,0,0,,♬～
Dialogue: 0,0:19:37.49,0:19:41.94,Default,,0,0,0,,Осы уақыт бойы мені шақырған сен болдың.
Dialogue: 0,0:19:41.94,0:19:46.13,Default,,0,0,0,,♬～
Dialogue: 0,0:19:46.13,0:19:48.25,Default,,0,0,0,,Сен мені қорғадың ба?
Dialogue: 0,0:19:48.25,0:19:53.02,Default,,0,0,0,,♬～
Dialogue: 0,0:19:53.02,0:19:57.09,Default,,0,0,0,,Рахмет. Мен қазір жақсымын.
Dialogue: 0,0:19:57.09,0:19:59.13,Default,,0,0,0,,Токаку…
Dialogue: 0,0:19:59.13,0:20:01.70,Default,,0,0,0,,Мен қорғағым келетін нәрсені таптым.
Dialogue: 0,0:20:01.70,0:20:05.23,Default,,0,0,0,,Бұдан былай бұл сізге байланысты
Dialogue: 0,0:20:05.23,0:20:14.88,Default,,0,0,0,,♬～
Dialogue: 0,0:20:14.88,0:20:18.96,Default,,0,0,0,,Мен ол жерге бір күні барамын, сол жерде күте тұрыңыз.
Dialogue: 0,0:20:18.96,0:20:23.62,Default,,0,0,0,,♬～
Dialogue: 0,0:20:23.62,0:20:26.92,Default,,0,0,0,,Зааа (жаңбыр дыбысы)
Dialogue: 0,0:20:30.41,0:20:32.51,Default,,0,0,0,,Анам…
Dialogue: 0,0:20:35.20,0:20:37.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:37.25,0:20:39.83,Default,,0,0,0,,Қарғыс атсын...｡ Ах.
Dialogue: 0,0:20:39.83,0:20:46.36,Default,,0,0,0,,♬～
Dialogue: 0,0:20:46.36,0:20:48.36,Default,,0,0,0,,♬~
Dialogue: 0,0:20:49.99,0:20:52.06,Default,,0,0,0,,Күн шуақты…
Dialogue: 0,0:20:52.06,0:21:01.56,Default,,0,0,0,,♬～
Dialogue: 0,0:21:01.56,0:21:11.56,Default,,0,0,0,,♬～
Dialogue: 0,0:21:13.98,0:21:19.91,Default,,0,0,0,,♬～
Dialogue: 0,0:21:19.91,0:21:23.51,Default,,0,0,0,,Ей, эй, қашу үшін барыңды сал.➡
Dialogue: 0,0:21:23.51,0:21:26.20,Default,,0,0,0,,Мен сені өлтіремін, жарай ма?
Dialogue: 0,0:21:26.20,0:21:28.32,Default,,0,0,0,,Кішкене ғана?
Dialogue: 0,0:21:28.32,0:21:31.92,Default,,0,0,0,,Әдеттегі тітіркендіргіш позитив қайда кетті?
Dialogue: 0,0:21:33.44,0:21:38.23,Default,,0,0,0,,Шығыстың жігіті өлгенде қатты таң қалдым.
Dialogue: 0,0:21:38.23,0:21:40.24,Default,,0,0,0,,Докка
Dialogue: 0,0:21:40.24,0:21:43.60,Default,,0,0,0,,♬～
Dialogue: 0,0:21:43.60,0:21:47.40,Default,,0,0,0,,Онда мен сені ол сияқты өлтіремін.
Dialogue: 0,0:21:48.94,0:21:52.94,Default,,0,0,0,,Мен оны терезеден осылай лақтырып жібердім.➡
Dialogue: 0,0:21:52.94,0:21:56.98,Default,,0,0,0,,Оңай, солай ма? Ол да ақымақ.
Dialogue: 0,0:21:56.98,0:22:00.73,Default,,0,0,0,,Мен сені қорғамағанымда, сен өлмес едің.
Dialogue: 0,0:22:00.73,0:22:12.86,Default,,0,0,0,,♬～
Dialogue: 0,0:22:12.86,0:22:15.80,Default,,0,0,0,,Ух... а... а...
Dialogue: 0,0:22:15.80,0:22:18.40,Default,,0,0,0,,Жұмыс аяқталды~
Dialogue: 0,0:22:20.62,0:22:24.91,Default,,0,0,0,,Гусс (пышақ пышақ дыбысы) Ах Ах...➡
Dialogue: 0,0:22:24.91,0:22:27.41,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:22:29.24,0:22:31.88,Default,,0,0,0,,≪Mr. Токаку...? ≫
Dialogue: 0,0:22:31.88,0:22:33.90,Default,,0,0,0,,Ахх!!
Dialogue: 0,0:22:33.90,0:22:37.00,Default,,0,0,0,,♬～
Dialogue: 0,0:22:37.00,0:22:39.27,Default,,0,0,0,,Нан!
Dialogue: 0,0:22:39.27,0:22:41.27,Default,,0,0,0,,Нан!
Dialogue: 0,0:22:42.67,0:22:45.94,Default,,0,0,0,,Уф! Бұл сенің шығының, Инукай.
Dialogue: 0,0:22:45.94,0:22:48.86,Default,,0,0,0,,Боки! (сынған сүйектердің дыбысы)
Dialogue: 0,0:22:48.86,0:22:52.68,Default,,0,0,0,,Өлтір! Мен бәрібір істей алмаймын!
Dialogue: 0,0:22:52.68,0:22:55.38,Default,,0,0,0,,Уф... Мен сені қазір өлтіре аламын.
Dialogue: 0,0:22:56.77,0:22:59.44,Default,,0,0,0,,Бірақ сен мені өлтірмейсің
Dialogue: 0,0:22:59.44,0:23:01.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:01.89,0:23:11.89,Default,,0,0,0,,♬～
Dialogue: 0,0:23:11.89,0:23:16.27,Default,,0,0,0,,Хаа... хааааа...
Dialogue: 0,0:23:16.27,0:23:18.33,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:23:18.33,0:23:22.76,Default,,0,0,0,,♬～
Dialogue: 0,0:23:22.76,0:23:27.35,Default,,0,0,0,,Токаку~! Токаку! Токаку! Күн шуақты...
Dialogue: 0,0:23:27.35,0:23:31.00,Default,,0,0,0,,Мен өлдім деп ойладым. Ауа райының ашық болуына байланысты тағы да...
Dialogue: 0,0:23:31.00,0:23:34.11,Default,,0,0,0,,Мен сені енді көре алмаймын...
Dialogue: 0,0:23:34.11,0:23:36.41,Default,,0,0,0,,Токаку~!
Dialogue: 0,0:23:36.41,0:23:39.88,Default,,0,0,0,,Уф! Уау!
Dialogue: 0,0:23:39.88,0:23:47.64,Default,,0,0,0,,♬～
Dialogue: 0,0:23:47.64,0:23:51.44,Default,,0,0,0,,Жаңбыр... Тайфунның көзінде.
Dialogue: 0,0:23:53.26,0:23:56.46,Default,,0,0,0,,Бұл қарғыс емес еді. иә?
Dialogue: 0,0:23:56.46,0:23:58.52,Default,,0,0,0,,Мен әрқашан осылай ойладым
Dialogue: 0,0:23:58.52,0:24:02.54,Default,,0,0,0,,Арқада өлгендердің ойымен өмір сүру әзіл емес➡
Dialogue: 0,0:24:02.54,0:24:05.47,Default,,0,0,0,,Бұл мен үшін өте ауыр.
Dialogue: 0,0:24:05.47,0:24:10.76,Default,,0,0,0,,♬～
Dialogue: 0,0:24:10.76,0:24:13.10,Default,,0,0,0,,Бірақ бұл басқаша болды.
Dialogue: 0,0:24:13.10,0:24:17.17,Default,,0,0,0,,Мен әрқашан қорғандым
Dialogue: 0,0:24:17.17,0:24:20.07,Default,,0,0,0,,♬～
Dialogue: 0,0:24:20.07,0:24:23.24,Default,,0,0,0,,Байқағаныңызға сенімдімін➡
Dialogue: 0,0:24:23.24,0:24:25.24,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:24:27.63,0:24:31.63,Default,,0,0,0,,Тірі екеніңізге қуаныштымын. Ах.
Dialogue: 0,0:24:33.55,0:24:46.98,Default,,0,0,0,,♬～
Dialogue: 0,0:24:46.98,0:24:49.83,Default,,0,0,0,,Балалар сендер өте батыл болдыңдар.➡
Dialogue: 0,0:24:49.83,0:24:52.65,Default,,0,0,0,,Дүниедегі барлық нәрсе оны жоққа шығаруға тырысады➡
Dialogue: 0,0:24:52.65,0:24:56.01,Default,,0,0,0,,Мен сені мақтаймын.➡
Dialogue: 0,0:24:56.01,0:25:00.13,Default,,0,0,0,,Қалғанын маған тапсырып, тыныш ұйықта.
Dialogue: 0,0:25:00.13,0:25:05.80,Default,,0,0,0,,♬～
Dialogue: 0,0:25:05.80,0:25:09.04,Default,,0,0,0,,♬ хун хун хун хун хун хун
Dialogue: 0,0:25:09.04,0:25:12.74,Default,,0,0,0,,♬ Хммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:25:12.74,0:25:20.75,Default,,0,0,0,,♬～
Dialogue: 0,0:25:20.75,0:25:23.05,Default,,0,0,0,,Ах
Dialogue: 0,0:25:24.94,0:25:27.44,Default,,0,0,0,,Ах, рярья. Майя-сан мен Исуке-сан да➡
Dialogue: 0,0:25:27.44,0:25:31.54,Default,,0,0,0,,Бітті ме? Бұл таң қаларлықтай тез өтті.➡
Dialogue: 0,0:25:31.54,0:25:33.86,Default,,0,0,0,,Соңында, соңғысы?
Dialogue: 0,0:25:33.86,0:25:37.76,Default,,0,0,0,,Шығыстың Азумасын асыға күтемін
Dialogue: 0,0:25:39.40,0:25:44.92,Default,,0,0,0,,♬～
Dialogue: 0,0:25:44.92,0:25:54.48,Default,,0,0,0,,♬～
Dialogue: 0,0:25:54.48,0:25:57.35,Default,,0,0,0,,♬ Жартылай жігіт
Dialogue: 0,0:25:57.35,0:26:00.65,Default,,0,0,0,,♬ Енді қашатын кез.
Dialogue: 0,0:26:02.04,0:26:04.81,Default,,0,0,0,,♬ Мұқият күтім
Dialogue: 0,0:26:04.81,0:26:07.81,Default,,0,0,0,,♬ Пышақпен абай болыңыз★
Dialogue: 0,0:26:09.23,0:26:12.27,Default,,0,0,0,,♬ Маған көзіңізді қысыңыз
Dialogue: 0,0:26:12.27,0:26:15.57,Default,,0,0,0,,♬ Барлық тән мен жан
Dialogue: 0,0:26:16.90,0:26:19.64,Default,,0,0,0,,♬ Оны алып кетті.
Dialogue: 0,0:26:19.64,0:26:22.64,Default,,0,0,0,,♬ Тым үлкен баға
Dialogue: 0,0:26:24.08,0:26:27.26,Default,,0,0,0,,♬ Тез бай болу туралы
Dialogue: 0,0:26:27.26,0:26:31.07,Default,,0,0,0,,♬ Мен оған тәуелдімін♪
Dialogue: 0,0:26:31.07,0:26:34.14,Default,,0,0,0,,♬ Бір күні бір күні
Dialogue: 0,0:26:34.14,0:26:38.41,Default,,0,0,0,,♬ Ертеңгі күн дәл солай идеал болып шықса
Dialogue: 0,0:26:38.41,0:26:41.55,Default,,0,0,0,,♬ Тіпті мен үшін де
Dialogue: 0,0:26:41.55,0:26:46.30,Default,,0,0,0,,♬ Мен біреудің күлгенін қалаймын.
Dialogue: 0,0:26:46.30,0:26:48.94,Default,,0,0,0,,♬ 0 немесе 100?
Dialogue: 0,0:26:48.94,0:26:53.34,Default,,0,0,0,,♬ Бұл ебедейсіз жол
Dialogue: 0,0:26:53.34,0:26:56.44,Default,,0,0,0,,♬ Жарайды.
Dialogue: 0,0:26:56.44,0:27:01.48,Default,,0,0,0,,♬ Енді мен ойлана аламын
Dialogue: 0,0:27:01.48,0:27:05.07,Default,,0,0,0,,♬ Періштенің күлкісі сондықтан
Dialogue: 0,0:27:05.07,0:27:08.57,Default,,0,0,0,,♬～
Dialogue: 0,0:28:40.63,0:28:43.03,Default,,0,0,0,,Келесі шай ішу бар ма? Өйткені оны жас келіншек жүргізеді➡
Dialogue: 0,0:28:43.03,0:28:47.67,Default,,0,0,0,,Мен бұл экстравагант деп ойлаймын. Дресс-код бар сияқты.➡
Dialogue: 0,0:28:47.67,0:28:50.54,Default,,0,0,0,,Ең жақсы шайға арналған сәнді еден.➡
Dialogue: 0,0:28:50.54,0:28:53.24,Default,,0,0,0,,Тек көңіл көтер, Токаку.
Dialogue: 0,0:28:54.63,0:28:56.68,Default,,0,0,0,,«Куругуми үй бөлмесі»!
Dialogue: 0,0:28:56.68,0:28:59.58,Default,,0,0,0,,Токаку-сан, Ібіліс жұмбағы көрмесі шешілді!
Dialogue: 0,0:28:59.58,0:29:03.07,Default,,0,0,0,,Аниманың түпнұсқа сызбалары мен сюжеттер тақтасы сияқты өндіріс материалдарының көрмесі өтетін сияқты.
Dialogue: 0,0:29:03.07,0:29:05.87,Default,,0,0,0,,Сатуға арналған түпнұсқа тауарлар және өткізу орны бойынша шектеулі жеңілдіктер де қолжетімді➡
Dialogue: 0,0:29:05.87,0:29:09.51,Default,,0,0,0,,Бар сияқты! 23 шілдеден бастап Токио Акихабара➡
Dialogue: 0,0:29:09.51,0:29:12.46,Default,,0,0,0,,9 тамыздан бастап Осуда, Нагояда өтеді ме?
Dialogue: 0,0:29:12.46,0:29:15.56,Default,,0,0,0,,Толық ақпаратты ресми веб-сайттан қараңыз.
Dialogue: 0,0:29:17.06,0:29:23.06,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory