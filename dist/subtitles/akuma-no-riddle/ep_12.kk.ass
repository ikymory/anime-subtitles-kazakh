Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:35.10,0:01:37.13,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:37.13,0:01:40.08,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:40.08,0:01:43.49,Default,,0,0,0,,((Күтілгендей, ол бала біз сияқты қанішер➡
Dialogue: 0,0:01:43.49,0:01:45.49,Default,,0,0,0,,Мен олай болғанын қаламаймын))
Dialogue: 0,0:01:46.89,0:01:50.83,Default,,0,0,0,,((Токаку-чан, егер сіз қазірден бастап біреуді өлтіруді ойласаңыз➡
Dialogue: 0,0:01:50.83,0:01:52.83,Default,,0,0,0,,Мына ғибадатхананы есте сақта))
Dialogue: 0,0:01:54.22,0:01:56.27,Default,,0,0,0,,)
Dialogue: 0,0:01:56.27,0:01:59.85,Default,,0,0,0,,((Сен мені өлтіре алмайсың. Сол ғибадатхананың ішінде➡
Dialogue: 0,0:01:59.85,0:02:01.95,Default,,0,0,0,,Себебі сенің анаң қарап отыр))
Dialogue: 0,0:02:04.31,0:02:07.39,Default,,0,0,0,,Неліктен? Токаку-сан
Dialogue: 0,0:02:07.39,0:02:10.79,Default,,0,0,0,,Бұл... Бұл нені білдіреді?
Dialogue: 0,0:02:13.08,0:02:15.58,Default,,0,0,0,,Токаку-сан, ауа райы жақсы ма?
Dialogue: 0,0:02:17.04,0:02:20.91,Default,,0,0,0,,Мен білмеймін! Мен мүлде түсінбеймін, Токаку!
Dialogue: 0,0:02:20.91,0:02:23.34,Default,,0,0,0,,Неліктен? Жақсы ауа-райы...
Dialogue: 0,0:02:23.34,0:02:27.01,Default,,0,0,0,,Мен бұрын біреуді өлтіре алмайтын едім.
Dialogue: 0,0:02:27.01,0:02:30.35,Default,,0,0,0,,Бірақ қазір заклинание бұзылды.
Dialogue: 0,0:02:30.35,0:02:37.22,Default,,0,0,0,,♬～
Dialogue: 0,0:02:37.22,0:02:39.69,Default,,0,0,0,,Мен өз жолымды шешемін
Dialogue: 0,0:02:39.69,0:02:49.75,Default,,0,0,0,,♬～
Dialogue: 0,0:02:49.75,0:02:51.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:51.92,0:03:05.02,Default,,0,0,0,,♬～
Dialogue: 0,0:03:06.42,0:03:08.74,Default,,0,0,0,,♬ Кері санауға дайынсыз ба
Dialogue: 0,0:03:08.74,0:03:10.94,Default,,0,0,0,,♬ Жүгіруге жол жоқ
Dialogue: 0,0:03:10.94,0:03:20.07,Default,,0,0,0,,♬～
Dialogue: 0,0:03:20.07,0:03:24.69,Default,,0,0,0,,♬ Оңай диапазонға түспеңіз.
Dialogue: 0,0:03:24.69,0:03:29.56,Default,,0,0,0,,♬ Бұл суық соғыс аймағы. Қазіргі жағдай жалықтырады.
Dialogue: 0,0:03:29.56,0:03:34.21,Default,,0,0,0,,♬ Ей, балалар, сондықтан сен ерекше екенсің.
Dialogue: 0,0:03:34.21,0:03:36.25,Default,,0,0,0,,♬ Баяғыда сыйымдылық асып кеткен
Dialogue: 0,0:03:36.25,0:03:38.57,Default,,0,0,0,,♬ Өзін-өзі мазақ ету түбі жоқ сезім
Dialogue: 0,0:03:38.57,0:03:40.62,Default,,0,0,0,,♬ Өте сүйкімді
Dialogue: 0,0:03:40.62,0:03:43.52,Default,,0,0,0,,♬ Мен саған ақымақтығымды көрсете алмаймын.
Dialogue: 0,0:03:43.52,0:03:45.54,Default,,0,0,0,,♬ Бекер толқу
Dialogue: 0,0:03:45.54,0:03:47.54,Default,,0,0,0,,♬ Тек ынталандыру үшін
Dialogue: 0,0:03:48.95,0:03:51.48,Default,,0,0,0,,♬ Қабылдау/бүлік Екі ғана таңдау бар ма?
Dialogue: 0,0:03:51.48,0:03:55.19,Default,,0,0,0,,♬ ah Эстетика «Мен ешкімге тиіспеймін»
Dialogue: 0,0:03:55.19,0:03:57.34,Default,,0,0,0,,♬ Жараның кінәсіздігі
Dialogue: 0,0:03:57.34,0:03:59.86,Default,,0,0,0,,♬ Мен де сол топқа кіремін.
Dialogue: 0,0:03:59.86,0:04:01.96,Default,,0,0,0,,♬ орылатын болады
Dialogue: 0,0:04:01.96,0:04:04.53,Default,,0,0,0,,♬ Ешбір жағдайда әрқашан жалғасуда
Dialogue: 0,0:04:04.53,0:04:08.52,Default,,0,0,0,,♬ Белдемшенің етегі туралы шындық
Dialogue: 0,0:04:08.52,0:04:13.62,Default,,0,0,0,,♬ Тек ақымақ сияқты сеніңіз
Dialogue: 0,0:04:13.62,0:04:17.76,Default,,0,0,0,,♬ Маған қатты әсер етті
Dialogue: 0,0:04:17.76,0:04:24.52,Default,,0,0,0,,♬ Оны твиттер арқылы жіберіңіз.
Dialogue: 0,0:04:24.52,0:04:34.02,Default,,0,0,0,,♬～
Dialogue: 0,0:04:47.47,0:04:51.01,Default,,0,0,0,,Өл және өмір сүр, немесе өмір сүр және өл➡
Dialogue: 0,0:04:51.01,0:04:54.11,Default,,0,0,0,,Әлде мен аман қалуға тырысуым керек пе? ➡
Dialogue: 0,0:04:54.11,0:04:56.98,Default,,0,0,0,,Токаку, сен байқадың ғой, солай емес пе? ➡
Dialogue: 0,0:04:56.98,0:04:59.35,Default,,0,0,0,,Нақты жауап –➡
Dialogue: 0,0:04:59.35,0:05:03.39,Default,,0,0,0,,Бұл берілген нұсқалардан тыс нәрсе.
Dialogue: 0,0:05:03.39,0:05:08.64,Default,,0,0,0,,♬～
Dialogue: 0,0:05:08.64,0:05:12.25,Default,,0,0,0,,Жоқ... Токаку
Dialogue: 0,0:05:12.25,0:05:14.77,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:05:14.77,0:05:20.52,Default,,0,0,0,,♬～
Dialogue: 0,0:05:20.52,0:05:22.56,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:05:22.56,0:05:33.88,Default,,0,0,0,,♬～
Dialogue: 0,0:05:33.88,0:05:37.29,Default,,0,0,0,,Мен сізге бір нәрсе сұрайын
Dialogue: 0,0:05:37.29,0:05:42.19,Default,,0,0,0,,Токаку-сан Харуды сатып жібергені үшін оны өлтіре ме?
Dialogue: 0,0:05:42.19,0:05:44.73,Default,,0,0,0,,Хару қуатты пайдаланады➡
Dialogue: 0,0:05:44.73,0:05:47.28,Default,,0,0,0,,Сіз мені манипуляциялады деп ойладыңыз ба?
Dialogue: 0,0:05:47.28,0:05:51.35,Default,,0,0,0,,♬～
Dialogue: 0,0:05:51.35,0:05:56.86,Default,,0,0,0,,Мен мұны істеудің басқа жолын таба алмадым.
Dialogue: 0,0:05:56.86,0:05:59.56,Default,,0,0,0,,Барлығын дәлелдеу үшін...
Dialogue: 0,0:06:02.03,0:06:04.53,Default,,0,0,0,,Жарылыс! Bang! Bang!
Dialogue: 0,0:06:06.92,0:06:10.62,Default,,0,0,0,,Күн шуақты! иә?
Dialogue: 0,0:06:10.62,0:06:14.34,Default,,0,0,0,,Токаку мырза!? Ол не деп тұрсың?
Dialogue: 0,0:06:14.34,0:06:19.71,Default,,0,0,0,,♬～
Dialogue: 0,0:06:19.71,0:06:23.28,Default,,0,0,0,,Токаку мырза, бұл не...
Dialogue: 0,0:06:23.28,0:06:25.32,Default,,0,0,0,,Екі Токаку-сан?
Dialogue: 0,0:06:25.32,0:06:27.57,Default,,0,0,0,,Ол сұңқар! иә?
Dialogue: 0,0:06:27.57,0:06:29.96,Default,,0,0,0,,Ол мұны сізге бұрын айтқан жоқ па?
Dialogue: 0,0:06:29.96,0:06:32.59,Default,,0,0,0,,Шығыс Азума Батыс Кузуха➡
Dialogue: 0,0:06:32.59,0:06:35.85,Default,,0,0,0,,Қанішерлердің ежелгі отбасы
Dialogue: 0,0:06:35.85,0:06:39.02,Default,,0,0,0,,өлтірудің практикалық әдістеріне мамандандырылған➡
Dialogue: 0,0:06:39.02,0:06:41.34,Default,,0,0,0,,Бізге Азума➡
Dialogue: 0,0:06:41.34,0:06:46.49,Default,,0,0,0,,Батыстың құзухасы – көне заманнан бері келе жатқан сиқыршылар әулеті.
Dialogue: 0,0:06:46.49,0:06:49.46,Default,,0,0,0,,Сиқыр? Негізі ➡
Dialogue: 0,0:06:49.46,0:06:51.78,Default,,0,0,0,,Гипнозға немесе ұсынысқа ұқсас
Dialogue: 0,0:06:51.78,0:06:55.88,Default,,0,0,0,,Мақсатты психологиялық манипуляциялау және оны дұрыс қабылдаудан айыру➡
Dialogue: 0,0:06:55.88,0:06:59.79,Default,,0,0,0,,Өлімге себепкер болу немесе басқа біреуді өлтіру
Dialogue: 0,0:06:59.79,0:07:03.64,Default,,0,0,0,,Сонымен, бұрынғы Токаку-сан сұңқар ма?
Dialogue: 0,0:07:03.64,0:07:06.71,Default,,0,0,0,,Маған солай көрінді
Dialogue: 0,0:07:06.71,0:07:09.55,Default,,0,0,0,,Мүмкін бұл жарық пен жанып тұрған хош иісті зат➡
Dialogue: 0,0:07:09.55,0:07:11.55,Default,,0,0,0,,Ұйықтататын әсері бар
Dialogue: 0,0:07:12.95,0:07:16.84,Default,,0,0,0,,Бұл жер ол үшін сахна іспетті.
Dialogue: 0,0:07:16.84,0:07:19.64,Default,,0,0,0,,Бірақ бұл сұңқар болды делік➡
Dialogue: 0,0:07:19.64,0:07:21.69,Default,,0,0,0,,Харуды не үшін өлтірдің?
Dialogue: 0,0:07:21.69,0:07:24.03,Default,,0,0,0,,Ni - Қара тобының төрешісі...
Dialogue: 0,0:07:24.03,0:07:27.75,Default,,0,0,0,,Мен ешқашан өлтіруші емеспін деп айтқан емеспін!
Dialogue: 0,0:07:27.75,0:07:31.65,Default,,0,0,0,,Қара топ біткен сәтте мен сені сатып жіберемін.
Dialogue: 0,0:07:31.65,0:07:34.99,Default,,0,0,0,,Менің сыртқы түрімде
Dialogue: 0,0:07:34.99,0:07:37.93,Default,,0,0,0,,Бұл оған ұнайтын сияқты, солай емес пе?
Dialogue: 0,0:07:37.93,0:07:45.58,Default,,0,0,0,,♬～
Dialogue: 0,0:07:45.58,0:07:47.58,Default,,0,0,0,,Ах
Dialogue: 0,0:07:49.19,0:07:51.56,Default,,0,0,0,,Мұнда да отбасы...
Dialogue: 0,0:07:51.56,0:07:55.64,Default,,0,0,0,,Күн шуақты ма? Токаку-сан жақсы ма?
Dialogue: 0,0:07:55.64,0:08:00.61,Default,,0,0,0,,Хару шынымен Токаку-санның санасын басқара алды ма?
Dialogue: 0,0:08:00.61,0:08:03.25,Default,,0,0,0,,Тіпті Хару түсінбейді, солай ма?
Dialogue: 0,0:08:03.25,0:08:07.85,Default,,0,0,0,,Хару... Хару Токаку мырзаға қайтымсыз нәрсе жасады!
Dialogue: 0,0:08:10.34,0:08:13.39,Default,,0,0,0,,Расында мен сені қорғаймын➡
Dialogue: 0,0:08:13.39,0:08:16.03,Default,,0,0,0,,Бұл бейсаналық бұйрық болуы мүмкін.
Dialogue: 0,0:08:16.03,0:08:18.63,Default,,0,0,0,,Мұны ешкім жоққа шығара алмайды
Dialogue: 0,0:08:20.08,0:08:25.32,Default,,0,0,0,,Бірақ мен бұл жерде таптырмас нәрсе алдым.
Dialogue: 0,0:08:25.32,0:08:30.02,Default,,0,0,0,,Мені осы деңгейге жеткізген сезімдер мен қазір бармын.
Dialogue: 0,0:08:33.60,0:08:35.65,Default,,0,0,0,,Гах... А, шуақ!
Dialogue: 0,0:08:35.65,0:08:38.69,Default,,0,0,0,,Жарылыс! Жарылыс!
Dialogue: 0,0:08:38.69,0:08:40.72,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:08:40.72,0:08:46.13,Default,,0,0,0,,♬～
Dialogue: 0,0:08:46.13,0:08:48.43,Default,,0,0,0,,Қарғыс атсын... Шынайы болмысыңды көрсет!
Dialogue: 0,0:08:48.43,0:08:50.43,Default,,0,0,0,,Бах Бах Бах! Тсс
Dialogue: 0,0:08:52.08,0:08:54.12,Default,,0,0,0,,Басу түймесін басыңыз
Dialogue: 0,0:08:54.12,0:08:57.87,Default,,0,0,0,,♬～
Dialogue: 0,0:08:57.87,0:09:01.34,Default,,0,0,0,,Әңгіме бұзылды! Оны да мазақ етіңіз! ➡
Dialogue: 0,0:09:01.34,0:09:05.91,Default,,0,0,0,,Мен Харуды қорғауға ант бердім! Мен сені өлтіре алмаймын!
Dialogue: 0,0:09:05.91,0:09:07.97,Default,,0,0,0,,Жоқ! Дока!
Dialogue: 0,0:09:07.97,0:09:12.99,Default,,0,0,0,,♬～
Dialogue: 0,0:09:12.99,0:09:16.82,Default,,0,0,0,,Хару үшін мен Харуды өлтіремін.
Dialogue: 0,0:09:16.82,0:09:21.70,Default,,0,0,0,,Мен сізді ақылды адам деп ойладым.
Dialogue: 0,0:09:21.70,0:09:24.18,Default,,0,0,0,,Бұл ең орынды
Dialogue: 0,0:09:24.18,0:09:26.93,Default,,0,0,0,,Мен дәлелдеуім керек
Dialogue: 0,0:09:26.93,0:09:28.95,Default,,0,0,0,,Ха...
Dialogue: 0,0:09:28.95,0:09:31.84,Default,,0,0,0,,)
Dialogue: 0,0:09:31.84,0:09:35.16,Default,,0,0,0,,Дәлелдеу? Тіпті Харумото да білмейді! ➡
Dialogue: 0,0:09:35.16,0:09:37.81,Default,,0,0,0,,Сол себепті күмәнданудан басқа амалым жоқ! ➡
Dialogue: 0,0:09:37.81,0:09:40.81,Default,,0,0,0,,Мұның бәрі праймердің кесірінен болды ма деп ойлаймын!
Dialogue: 0,0:09:42.18,0:09:44.25,Default,,0,0,0,,((Төраға - Бастауыш - ➡
Dialogue: 0,0:09:44.25,0:09:47.87,Default,,0,0,0,,Санасыз жұмыс істейтінін де айтты))
Dialogue: 0,0:09:47.87,0:09:51.33,Default,,0,0,0,,)
Dialogue: 0,0:09:51.33,0:09:54.81,Default,,0,0,0,,♬～
Dialogue: 0,0:09:54.81,0:09:58.32,Default,,0,0,0,,Сонда сен көптен бері қорғап жүрген Харуды өлтірмексің бе?
Dialogue: 0,0:09:58.32,0:10:01.18,Default,,0,0,0,,Бұл мен әрқашан қорғайтын ашық ауа-райының арқасында.
Dialogue: 0,0:10:01.18,0:10:04.47,Default,,0,0,0,,Хмм... Мен Харуды өлтіре аламын! ➡
Dialogue: 0,0:10:04.47,0:10:07.82,Default,,0,0,0,,Хару қанша өмір сүргісі келсе де! ➡
Dialogue: 0,0:10:07.82,0:10:09.84,Default,,0,0,0,,Праймерді көрсетсеңіз де!
Dialogue: 0,0:10:09.84,0:10:12.81,Default,,0,0,0,,Сіз Харудың ең үлкен тілегін өлтіресіз бе?
Dialogue: 0,0:10:12.81,0:10:15.51,Default,,0,0,0,,Бұл тілек мен үшін орындалмайды!
Dialogue: 0,0:10:16.92,0:10:19.35,Default,,0,0,0,,Сонымен, сіз Тотокаку болып көрінесіз бе?
Dialogue: 0,0:10:19.35,0:10:22.66,Default,,0,0,0,,Кін! Өзіңізді мазақ етпеңіз!
Dialogue: 0,0:10:22.66,0:10:24.69,Default,,0,0,0,,Маған мағынасы жоқ! ➡
Dialogue: 0,0:10:24.69,0:10:30.09,Default,,0,0,0,,Бәрі менің еркім! Бұл мен өзім үшін таңдаған жол!
Dialogue: 0,0:10:32.70,0:10:36.77,Default,,0,0,0,,)
Dialogue: 0,0:10:36.77,0:10:41.07,Default,,0,0,0,,♬～
Dialogue: 0,0:10:41.07,0:10:43.11,Default,,0,0,0,,Мылтық! Уф...
Dialogue: 0,0:10:43.11,0:10:46.23,Default,,0,0,0,,♬～
Dialogue: 0,0:10:46.23,0:10:50.28,Default,,0,0,0,,Ауырды... Мүлдем жындысың.➡
Dialogue: 0,0:10:50.28,0:10:53.05,Default,,0,0,0,,Сізге рахмет, сценарий бұзылды.➡
Dialogue: 0,0:10:53.05,0:10:56.11,Default,,0,0,0,,Бірақ Хару сенікі➡
Dialogue: 0,0:10:56.11,0:10:58.98,Default,,0,0,0,,Мен мұны істеуге рұқсат бермеймін!
Dialogue: 0,0:10:58.98,0:11:01.03,Default,,0,0,0,,Гусса
Dialogue: 0,0:11:01.03,0:11:04.45,Default,,0,0,0,,♬～
Dialogue: 0,0:11:04.45,0:11:06.45,Default,,0,0,0,,Гусса!
Dialogue: 0,0:11:17.59,0:11:19.69,Default,,0,0,0,,Уф! Уф... Уф!
Dialogue: 0,0:11:21.53,0:11:23.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:24.92,0:11:32.99,Default,,0,0,0,,♬～
Dialogue: 0,0:11:32.99,0:11:37.09,Default,,0,0,0,,Уф... Уау!!
Dialogue: 0,0:11:38.52,0:11:42.52,Default,,0,0,0,,≪Рахмет, мен Токакудың сезімін түсіндім≫
Dialogue: 0,0:11:45.11,0:11:47.92,Default,,0,0,0,,≪Мені әрқашан қорғағаныңыз үшін рахмет≫
Dialogue: 0,0:11:47.92,0:11:50.46,Default,,0,0,0,,≪Мені қайта-қайта ауыртыңыз➡
Dialogue: 0,0:11:50.46,0:11:52.81,Default,,0,0,0,,Мұны істегеніңіз үшін рахмет➡
Dialogue: 0,0:11:52.81,0:11:54.95,Default,,0,0,0,,Сізге көп рахмет≫
Dialogue: 0,0:11:54.95,0:11:56.98,Default,,0,0,0,,≪Мен сені жақсы көремін≫
Dialogue: 0,0:11:56.98,0:12:00.75,Default,,0,0,0,,<<Бірақ Хару әлі өле алмайды>>
Dialogue: 0,0:12:00.75,0:12:02.79,Default,,0,0,0,,≪Міндетті түрде өмір сүріңіз! ≫
Dialogue: 0,0:12:02.79,0:12:10.99,Default,,0,0,0,,♬～
Dialogue: 0,0:14:17.99,0:14:23.05,Default,,0,0,0,,Егер Харудың қабілеті өмір сүруге құштарлықтан туындаса➡
Dialogue: 0,0:14:23.05,0:14:27.93,Default,,0,0,0,,Әрине, Харуды өлімге душар ету жұмыс істемейді.
Dialogue: 0,0:14:27.93,0:14:31.79,Default,,0,0,0,,Егер Харуды өлтіру ниеті болса➡
Dialogue: 0,0:14:31.79,0:14:35.06,Default,,0,0,0,,Бұл ниет тек менікі.
Dialogue: 0,0:14:35.06,0:14:38.09,Default,,0,0,0,,Менің еркім еркін
Dialogue: 0,0:14:38.09,0:14:41.15,Default,,0,0,0,,Оны Хару манипуляциялаған жоқ.
Dialogue: 0,0:14:41.15,0:14:45.12,Default,,0,0,0,,Мен Харуды қорғауды өз қалауыммен жасадым.
Dialogue: 0,0:14:45.12,0:14:47.19,Default,,0,0,0,,Дәлелдеу үшін...
Dialogue: 0,0:14:47.19,0:14:55.83,Default,,0,0,0,,♬～
Dialogue: 0,0:14:55.83,0:14:57.83,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,0:15:00.82,0:15:02.82,Default,,0,0,0,,А...
Dialogue: 0,0:15:04.75,0:15:06.81,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:06.81,0:15:16.83,Default,,0,0,0,,♬～
Dialogue: 0,0:15:16.83,0:15:19.25,Default,,0,0,0,,Сіздің отбасыңыз➡
Dialogue: 0,0:15:19.25,0:15:22.37,Default,,0,0,0,,Менің ойымша, бұл менімен бірдей болды.
Dialogue: 0,0:15:22.37,0:15:24.41,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:24.41,0:15:37.79,Default,,0,0,0,,♬～
Dialogue: 0,0:15:37.79,0:15:39.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:39.81,0:15:44.18,Default,,0,0,0,,♬～
Dialogue: 0,0:15:44.18,0:15:48.08,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:15:50.58,0:15:53.15,Default,,0,0,0,,Ақырында мен оны өлтірдім.➡
Dialogue: 0,0:15:53.15,0:15:56.59,Default,,0,0,0,,Олар Харуды өзіңе ұқсату қызық болар еді дейді➡
Dialogue: 0,0:15:56.59,0:16:00.78,Default,,0,0,0,,Мен көптен бері дайындалдым, бірақ ол қазірдің өзінде бұзылды ...
Dialogue: 0,0:16:00.78,0:16:03.21,Default,,0,0,0,,Гохогохо Гохогохо! ➡
Dialogue: 0,0:16:03.21,0:16:06.32,Default,,0,0,0,,Күрсін... Күрсін... Өйткені ➡
Dialogue: 0,0:16:06.32,0:16:08.49,Default,,0,0,0,,Сіз де мен сияқтысыз.➡
Dialogue: 0,0:16:08.49,0:16:10.87,Default,,0,0,0,,Тек өлтіруге қабілетті➡
Dialogue: 0,0:16:10.87,0:16:14.76,Default,,0,0,0,,Шіріген теңіз жәндіктері... хаха...
Dialogue: 0,0:16:14.76,0:16:17.68,Default,,0,0,0,,Хината үшін ешқашан...
Dialogue: 0,0:16:17.68,0:16:22.45,Default,,0,0,0,,♬～
Dialogue: 0,0:16:22.45,0:16:27.39,Default,,0,0,0,,Уф... Ууууууууу...
Dialogue: 0,0:16:27.39,0:16:30.14,Default,,0,0,0,,Күн шуақты… Уф…➡
Dialogue: 0,0:16:30.14,0:16:32.26,Default,,0,0,0,,Күн шуақты…
Dialogue: 0,0:16:32.26,0:16:52.05,Default,,0,0,0,,♬～
Dialogue: 0,0:16:52.05,0:16:57.22,Default,,0,0,0,,♬～
Dialogue: 0,0:16:57.22,0:16:59.25,Default,,0,0,0,,Банг (жедел жәрдем есігінің дыбысы)
Dialogue: 0,0:16:59.25,0:17:06.49,Default,,0,0,0,,[Спикер] Адамдар Адамдар Адамдар Адамдар…
Dialogue: 0,0:17:06.49,0:17:09.68,Default,,0,0,0,,Құттықтаймыз, Хигаши Токаку мырза.➡
Dialogue: 0,0:17:09.68,0:17:13.28,Default,,0,0,0,,Енді сіз Хару Ичинозаның қара тобындасыз➡
Dialogue: 0,0:17:13.28,0:17:16.82,Default,,0,0,0,,Соңғы жеңімпаз анықталды.➡
Dialogue: 0,0:17:16.82,0:17:20.02,Default,,0,0,0,,Бізге өзіңіз қалаған сыйлықтарды беріңіз
Dialogue: 0,0:17:22.89,0:17:25.04,Default,,0,0,0,,Күрсін...｡ Жарайды, онда➡
Dialogue: 0,0:17:25.04,0:17:27.91,Default,,0,0,0,,Сыйлығыңыз ұсталады.➡
Dialogue: 0,0:17:27.91,0:17:32.67,Default,,0,0,0,,Қажет сезінген кезде маған келіңіз.
Dialogue: 0,0:17:32.67,0:17:37.19,Default,,0,0,0,,♬～
Dialogue: 0,0:17:37.19,0:17:41.69,Default,,0,0,0,,♬～
Dialogue: 0,0:17:41.69,0:17:44.46,Default,,0,0,0,,Үміт бар. Бірақ➡
Dialogue: 0,0:17:44.46,0:17:48.52,Default,,0,0,0,,Мен оны ешқашан орындай алмаймын
Dialogue: 0,0:17:48.52,0:17:52.46,Default,,0,0,0,,Қарғыс атсын... Қарғыс атсын...
Dialogue: 0,0:17:52.46,0:17:57.96,Default,,0,0,0,,♬～
Dialogue: 0,0:17:59.35,0:18:03.48,Default,,0,0,0,,♬～
Dialogue: 0,0:18:03.48,0:18:05.99,Default,,0,0,0,,Бітіру сертификаты➡
Dialogue: 0,0:18:05.99,0:18:08.92,Default,,0,0,0,,10-сынып қара тобының қатысу саны 13➡
Dialogue: 0,0:18:08.92,0:18:11.64,Default,,0,0,0,,Хару Ичиноза. Иә!
Dialogue: 0,0:18:11.64,0:18:15.25,Default,,0,0,0,,«Бітіру туралы куәлік Хару Ичиноза➡
Dialogue: 0,0:18:15.25,0:18:20.05,Default,,0,0,0,,Құқық сіздің мектебіміз белгілеген барлық курстарды аяқтағаныңызды куәландырады».
Dialogue: 0,0:18:21.82,0:18:24.87,Default,,0,0,0,,Сізді мектеп бітіруіңізбен құттықтаймыз, Хару Ичиноза
Dialogue: 0,0:18:24.87,0:18:28.47,Default,,0,0,0,,Рахмет, Мизороги мырза
Dialogue: 0,0:18:28.47,0:18:32.80,Default,,0,0,0,,Ақыры Қара тобында жалғыз сен қалдың.
Dialogue: 0,0:18:32.80,0:18:40.99,Default,,0,0,0,,♬～
Dialogue: 0,0:18:40.99,0:18:44.09,Default,,0,0,0,,Мұғалім, оны Хару шешеді.
Dialogue: 0,0:18:44.09,0:18:46.31,Default,,0,0,0,,Не? Бір күні➡
Dialogue: 0,0:18:46.31,0:18:49.41,Default,,0,0,0,,Барлығымен қайта кездессем, міндетті түрде саған беремін.
Dialogue: 0,0:18:51.25,0:18:54.15,Default,,0,0,0,,Бұл көмектеспейді деп ойлаймын.
Dialogue: 0,0:18:54.15,0:18:56.75,Default,,0,0,0,,Баланың үнемі көрген жаралары➡
Dialogue: 0,0:18:56.75,0:18:59.36,Default,,0,0,0,,Ақыры сол баланы қорғадың.
Dialogue: 0,0:18:59.36,0:19:01.93,Default,,0,0,0,,Токаку-сан да таң қалды.
Dialogue: 0,0:19:01.93,0:19:05.26,Default,,0,0,0,,Қабырғаларда титан болады деп ешқашан ойламадым.➡
Dialogue: 0,0:19:05.26,0:19:09.52,Default,,0,0,0,,Сіздің арқаңызда пышақтың жүзі жүрегімнен сәл ауытқып кетті.
Dialogue: 0,0:19:09.52,0:19:11.92,Default,,0,0,0,,Шибуто Сусшо~
Dialogue: 0,0:19:11.92,0:19:15.02,Default,,0,0,0,,Қыңыр, Тоджи мырза, сіз де солай ма?
Dialogue: 0,0:19:15.02,0:19:17.52,Default,,0,0,0,,Сен оңай өлмейсің.
Dialogue: 0,0:19:18.91,0:19:22.73,Default,,0,0,0,,Тірі болу – кешірілу деген сөз сияқты.
Dialogue: 0,0:19:22.73,0:19:27.35,Default,,0,0,0,,Әй, жақсы сөз екен. Бұл Тони мырзаға ұқсамайды.
Dialogue: 0,0:19:27.35,0:19:31.92,Default,,0,0,0,,Сіз білдіңіз бе? Мен оны бұрын бір жерде тыңдадым.
Dialogue: 0,0:19:31.92,0:19:48.24,Default,,0,0,0,,♬～
Dialogue: 0,0:19:48.24,0:19:50.99,Default,,0,0,0,,Сізді мектеп бітіруіңізбен құттықтаймыз
Dialogue: 0,0:19:50.99,0:19:55.59,Default,,0,0,0,,♬～
Dialogue: 0,0:19:57.00,0:20:04.49,Default,,0,0,0,,♬～ («Жоғары қара, құрмет» фортепианолық қойылым)
Dialogue: 0,0:20:04.49,0:20:12.08,Default,,0,0,0,,♬ Жоғары қарасаң, құрметке бөленесің.
Dialogue: 0,0:20:12.08,0:20:19.67,Default,,0,0,0,,♬ Менің ұстазымның рақымы
Dialogue: 0,0:20:19.67,0:20:27.24,Default,,0,0,0,,♬ Тағы да ілім бағында
Dialogue: 0,0:20:27.24,0:20:34.22,Default,,0,0,0,,♬ Неше жыл болды?
Dialogue: 0,0:20:34.22,0:20:38.44,Default,,0,0,0,,♬～
Dialogue: 0,0:20:38.44,0:20:40.71,Default,,0,0,0,,≫(Батлер) Жас ханым. (Джункико) Иә?
Dialogue: 0,0:20:40.71,0:20:42.76,Default,,0,0,0,,InterCybernetics Inc.➡
Dialogue: 0,0:20:42.76,0:20:45.66,Default,,0,0,0,,Біз прототип туралы ақпарат алдық.
Dialogue: 0,0:20:45.66,0:20:49.16,Default,,0,0,0,,Бұл жеткілікті. Рақмет сізге. Мисс?
Dialogue: 0,0:20:50.82,0:20:55.32,Default,,0,0,0,,Мен тамақ пісіруді ойлап жүрмін.
Dialogue: 0,0:20:55.32,0:21:00.71,Default,,0,0,0,,♬～
Dialogue: 0,0:21:00.71,0:21:04.85,Default,,0,0,0,,Бүгін сені көруге соңғы рет келеді деп ойладым.
Dialogue: 0,0:21:04.85,0:21:08.82,Default,,0,0,0,,Артыңызға қарап отырсаңыз да, ештеңе білмейсіз.
Dialogue: 0,0:21:08.82,0:21:14.22,Default,,0,0,0,,Өкінішке орай, жастық шағым тез бітпейтін сияқты.
Dialogue: 0,0:21:16.53,0:21:18.75,Default,,0,0,0,,[ТЕЛ](ﾏﾅｰﾓｰﾄﾞ)
Dialogue: 0,0:21:18.75,0:21:20.95,Default,,0,0,0,,Сәлеметсіз бе, Фуюка? ➡
Dialogue: 0,0:21:20.95,0:21:24.85,Default,,0,0,0,,Ах~ Олай болса, қонақ бөлмедегі шай бөлмесінде.➡
Dialogue: 0,0:21:24.85,0:21:27.40,Default,,0,0,0,,Не, Аки? Аа~➡
Dialogue: 0,0:21:27.40,0:21:31.16,Default,,0,0,0,,Түкірсең жазылатынын айт. Хахаха.➡
Dialogue: 0,0:21:31.16,0:21:34.61,Default,,0,0,0,,Иә? О, мен бүгін үйге ерте бара аламын.
Dialogue: 0,0:21:34.61,0:21:38.63,Default,,0,0,0,,Менің саған кәдесыйым бар. Оны асыға күтіңіз. Хахахаха! ➡
Dialogue: 0,0:21:38.63,0:21:42.49,Default,,0,0,0,,Ах, барлығына жетеді. Хахахаха.
Dialogue: 0,0:21:42.49,0:21:45.30,Default,,0,0,0,,♬~
Dialogue: 0,0:21:45.30,0:21:48.61,Default,,0,0,0,,♬～
Dialogue: 0,0:21:48.61,0:21:50.64,Default,,0,0,0,,Банг! Bang!
Dialogue: 0,0:21:50.64,0:21:53.80,Default,,0,0,0,,≪Платформадан ешкім қашып құтыла алмады...?≫
Dialogue: 0,0:21:53.80,0:21:59.32,Default,,0,0,0,,♬～
Dialogue: 0,0:21:59.32,0:22:03.54,Default,,0,0,0,,≪Онда мен бірінші боламын.➡
Dialogue: 0,0:22:03.54,0:22:07.13,Default,,0,0,0,,Бақылап отырыңыз, Ирена-сенпай≫
Dialogue: 0,0:22:07.13,0:22:16.65,Default,,0,0,0,,♬～
Dialogue: 0,0:22:16.65,0:22:19.56,Default,,0,0,0,,♬ Ақылды болайық~
Dialogue: 0,0:22:19.56,0:22:22.38,Default,,0,0,0,,Сабыр тағы бірнеше жыл Сабыр
Dialogue: 0,0:22:22.38,0:22:24.99,Default,,0,0,0,,Сабыр тағы бірнеше жыл Сабыр
Dialogue: 0,0:22:24.99,0:22:27.51,Default,,0,0,0,,Заза (толқындардың дыбысы)
Dialogue: 0,0:22:27.51,0:22:33.70,Default,,0,0,0,,♬～
Dialogue: 0,0:22:33.70,0:22:35.76,Default,,0,0,0,,Уайымдама, жақсы көңіл күйде бол.
Dialogue: 0,0:22:35.76,0:22:37.82,Default,,0,0,0,,Себебі~➡
Dialogue: 0,0:22:37.82,0:22:41.08,Default,,0,0,0,,Егер бұл рас болса, барлық жерде➡
Dialogue: 0,0:22:41.08,0:22:44.28,Default,,0,0,0,,Ол анаға, әкеге және Исукеге тиесілі.
Dialogue: 0,0:22:44.28,0:22:46.58,Default,,0,0,0,,Хехе, анам мен әкем➡
Dialogue: 0,0:22:46.58,0:22:49.88,Default,,0,0,0,,Сенің болғаның мені бақытты етеді, солай ма?
Dialogue: 0,0:22:51.95,0:22:54.94,Default,,0,0,0,,Әй, әкең келді.
Dialogue: 0,0:22:54.94,0:22:57.84,Default,,0,0,0,,Ах! Хехехе!
Dialogue: 0,0:23:00.06,0:23:02.52,Default,,0,0,0,,Мұғалімнің айтуынша, уақыт та қалды➡
Dialogue: 0,0:23:02.52,0:23:05.42,Default,,0,0,0,,Маған оңалтуды бастауға болатынын айтты.➡
Dialogue: 0,0:23:06.84,0:23:09.31,Default,,0,0,0,,Маусым жақсарып келеді➡
Dialogue: 0,0:23:09.31,0:23:13.13,Default,,0,0,0,,Біраз уақытқа далаға шыққан дұрыс болар.
Dialogue: 0,0:23:13.13,0:23:16.46,Default,,0,0,0,,♬～
Dialogue: 0,0:23:16.46,0:23:18.71,Default,,0,0,0,,Сіз алма алғыңыз келе ме?
Dialogue: 0,0:23:18.71,0:23:30.73,Default,,0,0,0,,♬～
Dialogue: 0,0:23:30.73,0:23:32.81,Default,,0,0,0,,Ах
Dialogue: 0,0:23:32.81,0:23:38.89,Default,,0,0,0,,♬～
Dialogue: 0,0:23:38.89,0:23:43.37,Default,,0,0,0,,Мен мұны айтуға жарамсыз екенімді білемін.
Dialogue: 0,0:23:43.37,0:23:47.43,Default,,0,0,0,,♬～
Dialogue: 0,0:23:47.43,0:23:49.45,Default,,0,0,0,,Хехе
Dialogue: 0,0:23:49.45,0:23:54.83,Default,,0,0,0,,♬～
Dialogue: 0,0:23:54.83,0:23:57.65,Default,,0,0,0,,Осылай аяқталуы мүмкін бе?➡
Dialogue: 0,0:23:57.65,0:24:01.82,Default,,0,0,0,,Мен олардың құпиясын міндетті түрде ашамын.
Dialogue: 0,0:24:01.82,0:24:04.84,Default,,0,0,0,,Тырылдау...(пернетақта жұмысының дыбысы)
Dialogue: 0,0:24:04.84,0:24:06.95,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:24:06.95,0:24:10.50,Default,,0,0,0,,Ах! Хехехе
Dialogue: 0,0:24:10.50,0:24:18.26,Default,,0,0,0,,♬～
Dialogue: 0,0:24:18.26,0:24:20.29,Default,,0,0,0,,Керемет көрініс
Dialogue: 0,0:24:20.29,0:24:24.20,Default,,0,0,0,,Мая қазір жалғыз болсам да жақсымын
Dialogue: 0,0:24:24.20,0:24:27.32,Default,,0,0,0,,Өйткені дүние осындай➡
Dialogue: 0,0:24:27.32,0:24:29.35,Default,,0,0,0,,Бұл кең.
Dialogue: 0,0:24:29.35,0:24:40.25,Default,,0,0,0,,♬～
Dialogue: 0,0:24:41.66,0:24:50.39,Default,,0,0,0,,♬～
Dialogue: 0,0:24:50.39,0:24:53.59,Default,,0,0,0,,Дыбыстық сигнал...
Dialogue: 0,0:24:53.59,0:24:56.28,Default,,0,0,0,,Фу~｡ ≫Токаку-сан!
Dialogue: 0,0:24:56.28,0:24:59.28,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:24:59.28,0:25:02.22,Default,,0,0,0,,Бұл…
Dialogue: 0,0:25:02.22,0:25:04.80,Default,,0,0,0,,Токаку да бар! Маған керек емес
Dialogue: 0,0:25:04.80,0:25:07.62,Default,,0,0,0,,Иә? О, күт! Маған керек емес...
Dialogue: 0,0:25:07.62,0:25:10.46,Default,,0,0,0,,Сәлем Токаку-сан! Хехехе
Dialogue: 0,0:25:10.46,0:25:28.66,Default,,0,0,0,,♬～
Dialogue: 0,0:25:29.98,0:25:36.67,Default,,0,0,0,,♬～
Dialogue: 0,0:25:36.67,0:25:45.29,Default,,0,0,0,,♬～
Dialogue: 0,0:25:45.29,0:25:48.75,Default,,0,0,0,,♬ Кететіндерге
Dialogue: 0,0:25:48.75,0:25:56.36,Default,,0,0,0,,♬ Ұстайтын гүл болмаса да
Dialogue: 0,0:25:56.36,0:25:59.83,Default,,0,0,0,,♬ Бұл дүние біртүрлі
Dialogue: 0,0:25:59.83,0:26:03.23,Default,,0,0,0,,♬ Қоштасу сөздер
Dialogue: 0,0:26:03.23,0:26:06.88,Default,,0,0,0,,♬ Жасырын мейірім
Dialogue: 0,0:26:06.88,0:26:12.69,Default,,0,0,0,,♬ Байланыс жүрегімде ериді
Dialogue: 0,0:26:12.69,0:26:17.29,Default,,0,0,0,,♬ Мәрмәр өрнекке айналады
Dialogue: 0,0:26:17.29,0:26:21.81,Default,,0,0,0,,♬～
Dialogue: 0,0:26:21.81,0:26:23.85,Default,,0,0,0,,♬ Тәтті емес пе?
Dialogue: 0,0:26:23.85,0:26:25.89,Default,,0,0,0,,♬ Әркім әртүрлі
Dialogue: 0,0:26:25.89,0:26:28.65,Default,,0,0,0,,♬ Естеліктерге бет бұру
Dialogue: 0,0:26:28.65,0:26:32.04,Default,,0,0,0,,♬ Жаяу жүру жолы
Dialogue: 0,0:26:32.04,0:26:34.08,Default,,0,0,0,,♬ Мен оны табамын
Dialogue: 0,0:26:34.08,0:26:36.93,Default,,0,0,0,,♬ Жұмбақ жұмбақ болып қалса да
Dialogue: 0,0:26:36.93,0:26:40.45,Default,,0,0,0,,♬ Бұрын-соңды көрмеген декорацияны былай қойғанда
Dialogue: 0,0:26:40.45,0:26:45.45,Default,,0,0,0,,♬ Соңғы станцияға асығыңыз
Dialogue: 0,0:26:45.45,0:26:51.08,Default,,0,0,0,,♬～
Dialogue: 0,0:26:51.08,0:26:56.28,Default,,0,0,0,,♬～
Dialogue: 0,0:27:00.47,0:27:04.47,Default,,0,0,0,,[TEL] (Алынған электрондық пошта/Үнсіз режим)
Dialogue: 0,0:27:07.06,0:27:09.06,Default,,0,0,0,,Әй
Dialogue: 0,0:28:41.05,0:28:43.09,Default,,0,0,0,,«Куругуми үй бөлмесі»! Токаку-сан➡
Dialogue: 0,0:28:43.09,0:28:45.22,Default,,0,0,0,,«Сиг Кроне» ойыны туралы не ойлайсыз?
Dialogue: 0,0:28:45.22,0:28:48.86,Default,,0,0,0,,Қастандық туралы хабарлама беретін және қарсыласқа шабуыл жасайтын карта бар➡
Dialogue: 0,0:28:48.86,0:28:51.23,Default,,0,0,0,,Ойында кек бар... Сонымен қатар ➡
Dialogue: 0,0:28:51.23,0:28:53.73,Default,,0,0,0,,Сонымен қатар жаңадан салынған иллюстрациялар мен құйылған қолтаңбалар➡
Dialogue: 0,0:28:53.73,0:28:56.09,Default,,0,0,0,,Сіз оларды жинағыңыз келеді. Тіпті осы ойында➡
Dialogue: 0,0:28:56.09,0:28:58.72,Default,,0,0,0,,Мен Ичинозаны міндетті түрде қорғаймын! Толық ақпарат алу үшін➡
Dialogue: 0,0:28:58.72,0:29:01.02,Default,,0,0,0,,Ресми веб-сайтты тексеріңіз
Dialogue: 0,0:29:02.52,0:29:08.52,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory