Dialogue: 0,0:01:34.25,0:01:39.60,Default,,0,0,0,,)) 【9】
Dialogue: 0,0:01:39.60,0:01:42.35,Default,,0,0,0,,)
Dialogue: 0,0:01:42.35,0:01:53.55,Default,,0,0,0,,♬～
Dialogue: 0,0:01:53.55,0:01:56.25,Default,,0,0,0,,((Токаку-чан, бәрібір осы жерден кет➡
Dialogue: 0,0:01:56.25,0:01:58.29,Default,,0,0,0,,Неге апаларыңмен бірге тұрмайсыңдар? ))
Dialogue: 0,0:01:58.29,0:02:03.51,Default,,0,0,0,,♬～
Dialogue: 0,0:02:03.51,0:02:05.56,Default,,0,0,0,,)
Dialogue: 0,0:02:05.56,0:02:07.98,Default,,0,0,0,,((мектепте менің достарым көп➡
Dialogue: 0,0:02:07.98,0:02:10.88,Default,,0,0,0,,Тәттілер, қызықты кітаптар, т.б.➡
Dialogue: 0,0:02:10.88,0:02:13.70,Default,,0,0,0,,Енді ешқандай жаттығу жасаудың қажеті жоқ.➡
Dialogue: 0,0:02:13.70,0:02:16.70,Default,,0,0,0,,Сіздің әпкеңіз де солай қалағанына сенімдімін))
Dialogue: 0,0:02:18.04,0:02:20.18,Default,,0,0,0,,((бос сөз айтпа))
Dialogue: 0,0:02:20.18,0:02:23.38,Default,,0,0,0,,) (Токакудың әжесі)((Асуманың масқарасы!➡)
Dialogue: 0,0:02:24.88,0:02:28.85,Default,,0,0,0,,Сіз отағасының мұрагерімен сөйлесе алмайсыз))
Dialogue: 0,0:02:28.85,0:02:32.42,Default,,0,0,0,,)
Dialogue: 0,0:02:32.42,0:02:36.76,Default,,0,0,0,,♬～
Dialogue: 0,0:02:36.76,0:02:38.78,Default,,0,0,0,,) (Тотокаку)((Ах...))
Dialogue: 0,0:02:38.78,0:02:43.45,Default,,0,0,0,,♬～
Dialogue: 0,0:02:43.45,0:02:45.48,Default,,0,0,0,,)
Dialogue: 0,0:02:45.48,0:02:53.06,Default,,0,0,0,,♬～
Dialogue: 0,0:02:53.06,0:02:55.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:55.98,0:03:08.28,Default,,0,0,0,,♬～
Dialogue: 0,0:03:09.69,0:03:11.88,Default,,0,0,0,,♬ Кері санауға дайынсыз ба
Dialogue: 0,0:03:11.88,0:03:14.15,Default,,0,0,0,,♬ Жүгіруге жол жоқ
Dialogue: 0,0:03:14.15,0:03:23.26,Default,,0,0,0,,♬～
Dialogue: 0,0:03:23.26,0:03:27.88,Default,,0,0,0,,♬ Оңай диапазонға түспеңіз.
Dialogue: 0,0:03:27.88,0:03:32.93,Default,,0,0,0,,♬ Бұл қырғи-қабақ соғыс аймағы. Қазіргі жағдай жалықтырады.
Dialogue: 0,0:03:32.93,0:03:37.35,Default,,0,0,0,,♬ Ей, балалар, сондықтан сен ерекше екенсің.
Dialogue: 0,0:03:37.35,0:03:39.42,Default,,0,0,0,,♬ Баяғыда сыйымдылық асып кеткен
Dialogue: 0,0:03:39.42,0:03:41.76,Default,,0,0,0,,♬ Өзін-өзі мазақ ету түбі жоқ сезім
Dialogue: 0,0:03:41.76,0:03:43.79,Default,,0,0,0,,♬ Өте сүйкімді
Dialogue: 0,0:03:43.79,0:03:46.75,Default,,0,0,0,,♬ Мен саған ақымақтығымды көрсете алмаймын.
Dialogue: 0,0:03:46.75,0:03:48.78,Default,,0,0,0,,♬ Бекер толқу
Dialogue: 0,0:03:48.78,0:03:50.78,Default,,0,0,0,,♬ Тек ынталандыру үшін
Dialogue: 0,0:03:52.18,0:03:54.85,Default,,0,0,0,,♬ Қабылдау/бүлік Екі ғана таңдау бар ма?
Dialogue: 0,0:03:54.85,0:03:58.59,Default,,0,0,0,,♬ ah Эстетика «Мен ешкімге тиіспеймін»
Dialogue: 0,0:03:58.59,0:04:00.61,Default,,0,0,0,,♬ Жараның кінәсіздігі
Dialogue: 0,0:04:00.61,0:04:03.25,Default,,0,0,0,,♬ Мен де сол топқа кіремін.
Dialogue: 0,0:04:03.25,0:04:05.28,Default,,0,0,0,,♬ орылатын болады
Dialogue: 0,0:04:05.28,0:04:07.78,Default,,0,0,0,,♬ Ешбір жағдайда әрқашан жалғасуда
Dialogue: 0,0:04:07.78,0:04:11.79,Default,,0,0,0,,♬ Белдемшенің етегі туралы шындық
Dialogue: 0,0:04:11.79,0:04:16.91,Default,,0,0,0,,♬ Тек ақымақ сияқты сеніңіз
Dialogue: 0,0:04:16.91,0:04:21.18,Default,,0,0,0,,♬ Маған қатты әсер етті
Dialogue: 0,0:04:21.18,0:04:27.75,Default,,0,0,0,,♬ Оны твиттер арқылы жазыңыз.
Dialogue: 0,0:04:27.75,0:04:37.25,Default,,0,0,0,,♬～
Dialogue: 0,0:04:50.24,0:04:55.21,Default,,0,0,0,,♬～
Dialogue: 0,0:04:55.21,0:04:57.38,Default,,0,0,0,,Осы айдың соңында ➡
Dialogue: 0,0:04:57.38,0:05:00.40,Default,,0,0,0,,Myojo академиясының құрылған мерейтойлық фестивалі келе жатыр! ➡
Dialogue: 0,0:05:00.40,0:05:02.62,Default,,0,0,0,,Бұл мектептегі фестиваль! ➡
Dialogue: 0,0:05:02.62,0:05:06.02,Default,,0,0,0,,Ендеше бір серпіліп, бірге сахналық қойылым қойайық.➡
Dialogue: 0,0:05:06.02,0:05:08.74,Default,,0,0,0,,Менің сыныбым әдемі әйелдерге толы.➡
Dialogue: 0,0:05:08.74,0:05:13.28,Default,,0,0,0,,Спектакль – «Ромео мен Джульеттаның» ең корольдік жолы! ➡
Dialogue: 0,0:05:13.28,0:05:17.12,Default,,0,0,0,,Ұстаз, сценарий жазуға да көп еңбектендіңіз! ➡
Dialogue: 0,0:05:17.12,0:05:19.91,Default,,0,0,0,,Баршаңыз, 10-бетті ашыңыз.➡
Dialogue: 0,0:05:19.91,0:05:22.02,Default,,0,0,0,,Бұл әйгілі көрініс.➡
Dialogue: 0,0:05:22.02,0:05:24.33,Default,,0,0,0,,«О, Ромео➡
Dialogue: 0,0:05:24.33,0:05:26.45,Default,,0,0,0,,Сен неге Ромеосың? »
Dialogue: 0,0:05:26.45,0:05:30.32,Default,,0,0,0,,Қиындық~｡ Исуке - ең жақсы.
Dialogue: 0,0:05:30.32,0:05:33.92,Default,,0,0,0,,Ахахаха... Жалқау болсаң, несие ала алмайсың.
Dialogue: 0,0:05:33.92,0:05:37.52,Default,,0,0,0,,♬～
Dialogue: 0,0:05:37.52,0:05:40.71,Default,,0,0,0,,Бұл пьеса ма? Хехе
Dialogue: 0,0:05:40.71,0:05:43.71,Default,,0,0,0,,Хмм, өте тыныш.
Dialogue: 0,0:05:45.76,0:05:48.20,Default,,0,0,0,,О, Ромео Ромео➡
Dialogue: 0,0:05:48.20,0:05:51.07,Default,,0,0,0,,Сен неге Ромеосың?
Dialogue: 0,0:05:51.07,0:05:53.82,Default,,0,0,0,,Аа... егер қаласаңыз➡
Dialogue: 0,0:05:53.82,0:05:55.91,Default,,0,0,0,,Мен енді Ромео емеспін! ➡
Dialogue: 0,0:05:55.91,0:05:59.64,Default,,0,0,0,,Сіздің сүйіктіңіз, бұл менің жаңа есімім!
Dialogue: 0,0:05:59.64,0:06:02.35,Default,,0,0,0,,Мұнда қалай келдіңіз?
Dialogue: 0,0:06:02.35,0:06:05.50,Default,,0,0,0,,Егер табылсаң, өлтіресің.
Dialogue: 0,0:06:05.50,0:06:08.34,Default,,0,0,0,,Сенің көздерің әлдеқайда қорқынышты
Dialogue: 0,0:06:08.34,0:06:11.42,Default,,0,0,0,,Күлімсіреңіз.
Dialogue: 0,0:06:11.42,0:06:13.99,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:06:13.99,0:06:16.18,Default,,0,0,0,,Жоқ, жоқ, жоқ! ➡
Dialogue: 0,0:06:16.18,0:06:21.20,Default,,0,0,0,,Мүлде жоқ! Тыңда, Наматаме, еркек рөлі сексуалды!
Dialogue: 0,0:06:21.20,0:06:24.80,Default,,0,0,0,,Көрермендердің барлығын сексуалдық тартымдылығыңызға ғашық етіңіз!
Dialogue: 0,0:06:24.80,0:06:28.22,Default,,0,0,0,,Икемді болыңыз! Ыстық және сексуалды болыңыз! ➡
Dialogue: 0,0:06:28.22,0:06:31.08,Default,,0,0,0,,Бүйірден қарау! Көрермендерді көзіңмен өлтір!
Dialogue: 0,0:06:31.08,0:06:33.98,Default,,0,0,0,,Кэ... Кенмочи: Бұл туралы.
Dialogue: 0,0:06:35.35,0:06:39.13,Default,,0,0,0,,Мұғалім, үндемеңіз. Иә... Иә.
Dialogue: 0,0:06:39.13,0:06:44.06,Default,,0,0,0,,Бұл керемет, Шиена-чан. (Тай) Ол актерлік өнерді ұнататын сияқты.
Dialogue: 0,0:06:44.06,0:06:47.38,Default,,0,0,0,,Бұл гала емес. Бұл...
Dialogue: 0,0:06:47.38,0:06:51.45,Default,,0,0,0,,Дұрыс, Джульетта жақсырақ болды.
Dialogue: 0,0:06:51.45,0:06:54.50,Default,,0,0,0,,Сенсоку-сан – әйел.
Dialogue: 0,0:06:54.50,0:06:58.00,Default,,0,0,0,,♬～
Dialogue: 0,0:06:58.00,0:07:01.64,Default,,0,0,0,,Фу~ Мен мұнымен жоспар құра алмаймын.
Dialogue: 0,0:07:01.64,0:07:06.18,Default,,0,0,0,,Ол өндірістік жоспар деп аталады. Мен оған құмармын.
Dialogue: 0,0:07:06.18,0:07:13.42,Default,,0,0,0,,♬～
Dialogue: 0,0:07:13.42,0:07:16.56,Default,,0,0,0,,Ммм... Ммм...
Dialogue: 0,0:07:16.56,0:07:19.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:19.31,0:07:23.41,Default,,0,0,0,,Міне, келдіңіз. Рахмет, Харуки-сан. Бұл керемет!
Dialogue: 0,0:07:23.41,0:07:27.48,Default,,0,0,0,,Менің басқа еңбегім жоқ. Маған оны да берме.
Dialogue: 0,0:07:27.48,0:07:31.82,Default,,0,0,0,,♬～
Dialogue: 0,0:07:31.82,0:07:35.36,Default,,0,0,0,,А...｡ Мен мұны істей алмаймын.
Dialogue: 0,0:07:35.36,0:07:38.56,Default,,0,0,0,,Мен мұндай жұмысқа жарамсызмын.
Dialogue: 0,0:07:40.65,0:07:42.70,Default,,0,0,0,,Хун
Dialogue: 0,0:07:42.70,0:07:46.84,Default,,0,0,0,,♬～
Dialogue: 0,0:07:46.84,0:07:49.24,Default,,0,0,0,,Аа, мына жерде.
Dialogue: 0,0:07:49.24,0:07:51.59,Default,,0,0,0,,Бүгін бірде бұзылатын сияқты.
Dialogue: 0,0:07:51.59,0:07:53.78,Default,,0,0,0,,О
Dialogue: 0,0:07:53.78,0:07:56.38,Default,,0,0,0,,Сынақтан кейін мектеп мерекесі?
Dialogue: 0,0:07:58.01,0:08:01.85,Default,,0,0,0,,Жарайды, сен студент сияқтысың.
Dialogue: 0,0:08:01.85,0:08:03.85,Default,,0,0,0,,Біз…
Dialogue: 0,0:08:05.24,0:08:09.93,Default,,0,0,0,,Мен білемін. Бірақ, әйтеуір, бәрі көңілді жүрген сияқты.
Dialogue: 0,0:08:09.93,0:08:12.84,Default,,0,0,0,,Мұндай жағдайлар сирек кездеседі.
Dialogue: 0,0:08:12.84,0:08:16.38,Default,,0,0,0,,Харуки-сан, болды!
Dialogue: 0,0:08:16.38,0:08:18.40,Default,,0,0,0,,Харуки-санға рахмет!
Dialogue: 0,0:08:18.40,0:08:22.25,Default,,0,0,0,,Хаха. [ТЕЛ]
Dialogue: 0,0:08:22.25,0:08:24.35,Default,,0,0,0,,Бұл... жаман.
Dialogue: 0,0:08:27.76,0:08:32.31,Default,,0,0,0,,Сәлеметсіз бе, Фуюка? [TEL] (Фуйука) Ух... үлкен апа...
Dialogue: 0,0:08:32.31,0:08:34.93,Default,,0,0,0,,Бұл менмін! Тыныш бол!
Dialogue: 0,0:08:34.93,0:08:38.93,Default,,0,0,0,,Жарайды. Менің әпкем бұл туралы міндетті түрде бірдеңе жасайды.
Dialogue: 0,0:08:40.39,0:08:43.26,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сіз отбасы емессіз бе?
Dialogue: 0,0:08:43.26,0:08:45.44,Default,,0,0,0,,Ах. Сонда кездескенше.
Dialogue: 0,0:08:45.44,0:08:48.61,Default,,0,0,0,,♬～
Dialogue: 0,0:08:48.61,0:08:51.22,Default,,0,0,0,,≪Басынан бастап➡
Dialogue: 0,0:08:51.22,0:08:53.52,Default,,0,0,0,,Сіз білуіңіз керек еді, солай ма?
Dialogue: 0,0:08:53.52,0:08:56.97,Default,,0,0,0,,≪Бейбітшілік? Мектеп мерекесі? Мұның бәрі өтірік≫
Dialogue: 0,0:08:56.97,0:09:01.86,Default,,0,0,0,,♬～
Dialogue: 0,0:09:01.86,0:09:03.86,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:07.58,0:09:11.70,Default,,0,0,0,,Эхехехе Ванна~ Ванна~
Dialogue: 0,0:09:11.70,0:09:14.21,Default,,0,0,0,,Үлкен ванна~
Dialogue: 0,0:09:14.21,0:09:17.43,Default,,0,0,0,,Токаку-сан, эй! Тым көңілді болмаңыз
Dialogue: 0,0:09:17.43,0:09:20.25,Default,,0,0,0,,Біреу келгенше тез кетемін.
Dialogue: 0,0:09:20.25,0:09:23.45,Default,,0,0,0,,Енді ешкім келмейді, дәл осы кездегідей.
Dialogue: 0,0:09:23.45,0:09:26.52,Default,,0,0,0,,Аа, Токаку мырза, мен сіздің арқаңызды жуамын.
Dialogue: 0,0:09:26.52,0:09:30.92,Default,,0,0,0,,Жақсы. Ұстамаңыз. Эй!
Dialogue: 0,0:09:30.92,0:09:33.51,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:09:33.51,0:09:35.54,Default,,0,0,0,,Сіз мені мазаладыңыз ба?
Dialogue: 0,0:09:35.54,0:09:50.08,Default,,0,0,0,,♬～
Dialogue: 0,0:09:50.08,0:09:52.08,Default,,0,0,0,,Мен түлкіден сұрадым
Dialogue: 0,0:09:54.21,0:09:57.42,Default,,0,0,0,,Адамдар өздері үшін өледі➡
Dialogue: 0,0:09:57.42,0:10:00.29,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:10:00.29,0:10:03.59,Default,,0,0,0,,Біреудің есебінен аман қалу➡
Dialogue: 0,0:10:03.59,0:10:07.16,Default,,0,0,0,,Сонда да күліп, өмір сүруге бола ма?
Dialogue: 0,0:10:07.16,0:10:09.16,Default,,0,0,0,,Сага!
Dialogue: 0,0:10:12.13,0:10:14.53,Default,,0,0,0,,Күл, Харуха
Dialogue: 0,0:10:17.65,0:10:20.71,Default,,0,0,0,,Бұл үлкен мәселе. Сәлем Азума➡
Dialogue: 0,0:10:20.71,0:10:23.71,Default,,0,0,0,,Бұл жігіт сен өлсең де күледі.
Dialogue: 0,0:10:26.14,0:10:29.61,Default,,0,0,0,,Тоқта, Хару-чан қорқады.
Dialogue: 0,0:10:29.61,0:10:35.54,Default,,0,0,0,,♬～
Dialogue: 0,0:10:35.54,0:10:39.51,Default,,0,0,0,,Ха... анау Азума. Бұл сүйексіз емес пе?
Dialogue: 0,0:10:39.51,0:10:42.01,Default,,0,0,0,,Сіз оны соншалықты төмен түсіру үшін не істедіңіз?
Dialogue: 0,0:10:44.18,0:10:47.18,Default,,0,0,0,,Егер сен қазіргідей болсаң, менің де қолымнан келеді деп ойлаймын.
Dialogue: 0,0:10:48.75,0:10:51.35,Default,,0,0,0,,Ихиноза шығып жатыр. О, Токаку-сан.
Dialogue: 0,0:10:54.02,0:10:56.02,Default,,0,0,0,,≪Сырылдау... Соққы (есік дыбысы)
Dialogue: 0,0:10:57.41,0:11:03.68,Default,,0,0,0,,♬～
Dialogue: 0,0:11:03.68,0:11:07.87,Default,,0,0,0,,Токакуса... Сәл ашулану керек!
Dialogue: 0,0:11:07.87,0:11:12.41,Default,,0,0,0,,Өкінбейсің бе! Сіз осындай нәрсені айттыңыз!
Dialogue: 0,0:11:12.41,0:11:17.25,Default,,0,0,0,,Токаку-сан ашуланғанда не істейсің? Қарғыс атқыр...
Dialogue: 0,0:11:17.25,0:11:19.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:21.68,0:11:24.52,Default,,0,0,0,,Харуки-сан, сен әдеттегіден басқаша болдың.
Dialogue: 0,0:11:24.52,0:11:26.52,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:11:28.66,0:11:33.28,Default,,0,0,0,,[ｽﾋﾟｰｶ] ｷｰﾝ ｺｰﾝ ｶｰﾝ ｺｰﾝ…(ﾁｬｲﾑ)
Dialogue: 0,0:11:33.28,0:11:36.45,Default,,0,0,0,,Токаку-санның үйі шынымен де керемет пе?
Dialogue: 0,0:11:36.45,0:11:38.92,Default,,0,0,0,,Бұл таңқаларлық емес!
Dialogue: 0,0:11:38.92,0:11:43.04,Default,,0,0,0,,Бұл дүниеде Азума сені ұрса, болды!
Dialogue: 0,0:11:43.04,0:11:46.19,Default,,0,0,0,,Атақты? (Тай) Білмейтін адам жоқ.
Dialogue: 0,0:11:46.19,0:11:49.73,Default,,0,0,0,,Баяғыдан бері бұл елдің қараңғылығында билік жүргізіп келеді➡
Dialogue: 0,0:11:49.73,0:11:51.78,Default,,0,0,0,,Кісі өлтіру отбасы.➡
Dialogue: 0,0:11:51.78,0:11:55.90,Default,,0,0,0,,Шығыста Азума, батыста Кузуха.➡
Dialogue: 0,0:11:55.90,0:12:00.50,Default,,0,0,0,,Сол кездегі билік басындағыларға қызмет ете отырып, біз тарихты жасырын өзгерттік.
Dialogue: 0,0:12:01.89,0:12:04.51,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:12:04.51,0:12:07.18,Default,,0,0,0,,Қара топ ережелері 2-бап
Dialogue: 0,0:12:07.18,0:12:10.68,Default,,0,0,0,,Уау! Токаку-сан, тағы да карри! ➡
Dialogue: 0,0:12:10.68,0:12:13.03,Default,,0,0,0,,Маған қатты ұнайды!
Dialogue: 0,0:12:13.03,0:12:16.24,Default,,0,0,0,,Сіздің сыныптан тыс адамдар білмеуі керек, солай емес пе?
Dialogue: 0,0:12:16.24,0:12:19.36,Default,,0,0,0,,Біз төрешілерміз. Хехе
Dialogue: 0,0:12:19.36,0:12:22.69,Default,,0,0,0,,Токаку-сан, уф... Сұрағыңыз келетін нәрсе болса ➡
Dialogue: 0,0:12:22.69,0:12:25.78,Default,,0,0,0,,Менен сұраңыз, Мишитадан емес.
Dialogue: 0,0:12:25.78,0:12:27.95,Default,,0,0,0,,Мишита! иә?
Dialogue: 0,0:12:27.95,0:12:30.99,Default,,0,0,0,,Сонымен... онда отбасы құрылымы туралы не деуге болады?
Dialogue: 0,0:12:30.99,0:12:33.07,Default,,0,0,0,,Сіздің некеңіз бар ма?
Dialogue: 0,0:12:33.07,0:12:38.69,Default,,0,0,0,,Мен әкемнің жүзін білмедім. Анам мені босанғаннан кейін көп ұзамай қайтыс болды.
Dialogue: 0,0:12:38.69,0:12:42.91,Default,,0,0,0,,Мен әжемнің қолында өстім. Менің басқа да қарым-қатынасым бар...
Dialogue: 0,0:12:42.91,0:12:47.77,Default,,0,0,0,,♬～
Dialogue: 0,0:12:47.77,0:12:49.77,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:12:51.19,0:12:54.28,Default,,0,0,0,,Кешіріңіз... Кешіріңіз... (Тайвань) Жоқ, қандай таңғаларлық сәйкестік! ➡
Dialogue: 0,0:12:54.28,0:12:56.51,Default,,0,0,0,,Негізі біз өмір бойы жалғызбыз!
Dialogue: 0,0:12:56.51,0:12:58.55,Default,,0,0,0,,Мені қызықтырмайды. (Тайвань) О.
Dialogue: 0,0:12:58.55,0:13:06.65,Default,,0,0,0,,♬～
Dialogue: 0,0:13:08.12,0:13:12.73,Default,,0,0,0,,Иә. Сіздің отбасыңыздан? Жоқ, жоқ
Dialogue: 0,0:13:12.73,0:13:16.33,Default,,0,0,0,,Бұл жаман болды. Мен жай ғана бірдеңе ойлап отыр едім➡
Dialogue: 0,0:13:16.33,0:13:19.18,Default,,0,0,0,,Мен сегізге жеттім.
Dialogue: 0,0:13:19.18,0:13:22.02,Default,,0,0,0,,Ах~ Бүгін де тыныш.
Dialogue: 0,0:13:22.02,0:13:27.84,Default,,0,0,0,,♬～
Dialogue: 0,0:13:27.84,0:13:32.51,Default,,0,0,0,,Егер бұл рас болса, Хару-чан сол жағында болуы керек еді.➡
Dialogue: 0,0:13:32.51,0:13:34.88,Default,,0,0,0,,Хару-чан жалғыз емес
Dialogue: 0,0:13:34.88,0:13:38.64,Default,,0,0,0,,Барлығы, мен бұл жерге шынымен келген жоқпын.
Dialogue: 0,0:13:38.64,0:13:42.24,Default,,0,0,0,,♬～
Dialogue: 0,0:13:42.24,0:13:44.38,Default,,0,0,0,,Себеп-салдар қандай?
Dialogue: 0,0:13:44.38,0:13:46.41,Default,,0,0,0,,Сәлем Азума➡
Dialogue: 0,0:13:46.41,0:13:49.51,Default,,0,0,0,,Хару-чанды босатқыңыз келмей ме?
Dialogue: 0,0:13:51.72,0:13:56.86,Default,,0,0,0,,Сол баланы байланыстыратын барлық нәрседен біз
Dialogue: 0,0:13:56.86,0:14:01.09,Default,,0,0,0,,Сіз бұл қара топ ережелерінен тыс екенін айтасыз ба?
Dialogue: 0,0:14:01.09,0:14:04.79,Default,,0,0,0,,Бүгін түнгі сағат 10-да осы жерде. Толығырақ сол кезде.
Dialogue: 0,0:14:06.15,0:14:08.15,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:14:10.24,0:14:24.32,Default,,0,0,0,,♬～
Dialogue: 0,0:14:24.32,0:14:28.32,Default,,0,0,0,,Хмм, бұл сіздің себебіңіз.➡
Dialogue: 0,0:14:28.32,0:14:30.36,Default,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:14:30.36,0:14:34.58,Default,,0,0,0,,♬～
Dialogue: 0,0:14:34.58,0:14:37.43,Default,,0,0,0,,Олардың барлығын өлтіріңіз.
Dialogue: 0,0:14:37.43,0:14:40.65,Default,,0,0,0,,Исуке әрқашан осылай өмір сүрген.
Dialogue: 0,0:14:40.65,0:14:45.40,Default,,0,0,0,,Бұл туралы ойлану уақытты босқа кетіреді. Өмір қысқа, солай ма? ➡
Dialogue: 0,0:14:45.40,0:14:49.64,Default,,0,0,0,,Керек емес нәрсені тез лақтырып, еркін болу керек.
Dialogue: 0,0:14:49.64,0:14:52.99,Default,,0,0,0,,♬～
Dialogue: 0,0:14:52.99,0:14:56.08,Default,,0,0,0,,Хмм... Мен сізге біраз кеңес бердім.
Dialogue: 0,0:14:56.08,0:15:01.18,Default,,0,0,0,,♬～
Dialogue: 0,0:17:07.26,0:17:11.25,Default,,0,0,0,,♬～
Dialogue: 0,0:17:11.25,0:17:14.39,Default,,0,0,0,,Біреуді өлтіргенім үшін сыйға бірінші сатып алғаным ➡ болды
Dialogue: 0,0:17:14.39,0:17:17.37,Default,,0,0,0,,Күлімсіреген отбасы мүшелеріне толы дастархан➡
Dialogue: 0,0:17:17.37,0:17:21.07,Default,,0,0,0,,Мен әрқашан баланың қызғылт маникюрін қалайтынмын.➡
Dialogue: 0,0:17:22.94,0:17:27.18,Default,,0,0,0,,Маған сәйкес келмейтінін басынан-ақ білдім.
Dialogue: 0,0:17:27.18,0:17:30.52,Default,,0,0,0,,♬～
Dialogue: 0,0:17:30.52,0:17:34.24,Default,,0,0,0,,Харуки-санның сыйлығы оны Куро тобына шақырған кезден басталады➡
Dialogue: 0,0:17:34.24,0:17:36.29,Default,,0,0,0,,Мен тыңдаймын.
Dialogue: 0,0:17:36.29,0:17:41.25,Default,,0,0,0,,Менің отбасымды өмір бойы сақтайтын ақша. Бұл жақсы ма?
Dialogue: 0,0:17:41.25,0:17:45.72,Default,,0,0,0,,Аа, мен бір нәрсені растағым келеді.
Dialogue: 0,0:17:45.72,0:17:47.75,Default,,0,0,0,,Не?
Dialogue: 0,0:17:47.75,0:18:04.62,Default,,0,0,0,,♬～
Dialogue: 0,0:18:04.62,0:18:06.70,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:18:06.70,0:18:14.15,Default,,0,0,0,,♬～
Dialogue: 0,0:18:14.15,0:18:16.15,Default,,0,0,0,,Сылдырмақ...
Dialogue: 0,0:18:18.02,0:18:21.85,Default,,0,0,0,,Токаку мырза, сіздің ісіңіз қандай?
Dialogue: 0,0:18:21.85,0:18:28.33,Default,,0,0,0,,♬～
Dialogue: 0,0:18:28.33,0:18:30.38,Default,,0,0,0,,Токакуса… ah
Dialogue: 0,0:18:30.38,0:18:40.81,Default,,0,0,0,,♬～
Dialogue: 0,0:18:40.81,0:18:42.94,Default,,0,0,0,,Харуки-сан? Мм~➡
Dialogue: 0,0:18:42.94,0:18:45.11,Default,,0,0,0,,Токаку мырза, сіз көрмедіңіз бе?
Dialogue: 0,0:18:45.11,0:18:47.41,Default,,0,0,0,,Менің шұғыл жұмысым бар деген жадынама бар.
Dialogue: 0,0:18:47.41,0:18:50.72,Default,,0,0,0,,Шығыс болса, олар келмейді.
Dialogue: 0,0:18:50.72,0:18:52.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:52.75,0:19:00.06,Default,,0,0,0,,♬～
Dialogue: 0,0:19:00.06,0:19:02.58,Default,,0,0,0,,Мен сені босатамын.
Dialogue: 0,0:19:02.58,0:19:10.77,Default,,0,0,0,,♬～
Dialogue: 0,0:19:10.77,0:19:13.04,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:19:13.04,0:19:32.44,Default,,0,0,0,,♬～
Dialogue: 0,0:19:32.44,0:19:34.98,Default,,0,0,0,,Гохо, гохо, гохо!
Dialogue: 0,0:19:34.98,0:19:37.21,Default,,0,0,0,,Бұл қорқынышты. Кездесу➡
Dialogue: 0,0:19:37.21,0:19:40.20,Default,,0,0,0,,Хана, ол толығымен қамтылды ма? Болды
Dialogue: 0,0:19:40.20,0:19:43.35,Default,,0,0,0,,Мен өтірік айтпаймын. Мен.➡
Dialogue: 0,0:19:43.35,0:19:45.85,Default,,0,0,0,,Мен Хару-чанды босатуға келдім.
Dialogue: 0,0:19:45.85,0:19:49.79,Default,,0,0,0,,Бұл барлық облигациялардан құтылудың жалғыз жолы.
Dialogue: 0,0:19:49.79,0:19:52.86,Default,,0,0,0,,Токакуса... Бұлай қозғалма.
Dialogue: 0,0:19:52.86,0:20:01.92,Default,,0,0,0,,♬～
Dialogue: 0,0:20:01.92,0:20:04.84,Default,,0,0,0,,Tsk! Тіпті бұл Азума➡ болса да
Dialogue: 0,0:20:04.84,0:20:08.44,Default,,0,0,0,,Мен енді саған мұны істей алмаймын!
Dialogue: 0,0:20:10.71,0:20:12.75,Default,,0,0,0,,Токаку-сан! Қозғалма!
Dialogue: 0,0:20:12.75,0:20:19.04,Default,,0,0,0,,♬～
Dialogue: 0,0:20:19.04,0:20:21.07,Default,,0,0,0,,Және... Bang!
Dialogue: 0,0:20:21.07,0:20:26.33,Default,,0,0,0,,♬～
Dialogue: 0,0:20:26.33,0:20:28.73,Default,,0,0,0,,Қарғыс атсын...｡ Мен түсінемін.
Dialogue: 0,0:20:31.02,0:20:33.12,Default,,0,0,0,,Мен оны жақсы түсіндім.
Dialogue: 0,0:20:33.12,0:20:37.84,Default,,0,0,0,,♬～
Dialogue: 0,0:20:37.84,0:20:39.89,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:20:39.89,0:20:44.58,Default,,0,0,0,,♬～
Dialogue: 0,0:20:44.58,0:20:46.61,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:46.61,0:20:48.61,Default,,0,0,0,,Дока! Уф... Уф!
Dialogue: 0,0:20:53.89,0:20:56.79,Default,,0,0,0,,Уф... бұл ауырады
Dialogue: 0,0:20:56.79,0:20:59.29,Default,,0,0,0,,Бұл өте ұят.
Dialogue: 0,0:20:59.29,0:21:02.18,Default,,0,0,0,,Мықты болу үшін нені құрбан ету керек еді?
Dialogue: 0,0:21:02.18,0:21:04.22,Default,,0,0,0,,Пех!
Dialogue: 0,0:21:04.22,0:21:08.15,Default,,0,0,0,,Сіз мұны әлі де жасайсыз ба? Бұл себеп-салдар нәрсе.
Dialogue: 0,0:21:08.15,0:21:10.71,Default,,0,0,0,,Түсейін десем де, түсе алмадым➡
Dialogue: 0,0:21:10.71,0:21:13.61,Default,,0,0,0,,Сен де, мен де
Dialogue: 0,0:21:13.61,0:21:16.44,Default,,0,0,0,,Қанша жүрсем де қашып құтыла алмаймын
Dialogue: 0,0:21:16.44,0:21:21.25,Default,,0,0,0,,♬～
Dialogue: 0,0:21:21.25,0:21:24.45,Default,,0,0,0,,Бұл еркін болудың жалғыз жолы
Dialogue: 0,0:21:25.89,0:21:28.64,Default,,0,0,0,,Аа... менің ➡
Dialogue: 0,0:21:28.64,0:21:31.18,Default,,0,0,0,,Жеңіс!
Dialogue: 0,0:21:31.18,0:21:33.18,Default,,0,0,0,,Ах! Не!?
Dialogue: 0,0:21:38.18,0:21:40.38,Default,,0,0,0,,Сылдырылдау!
Dialogue: 0,0:21:42.35,0:21:46.24,Default,,0,0,0,,)
Dialogue: 0,0:21:46.24,0:21:48.28,Default,,0,0,0,,)
Dialogue: 0,0:21:48.28,0:21:52.58,Default,,0,0,0,,♬～
Dialogue: 0,0:21:52.58,0:21:54.92,Default,,0,0,0,,((Мен өлсем де➡
Dialogue: 0,0:21:54.92,0:21:58.32,Default,,0,0,0,,Сыйлық сіздің отбасыңызға беріледі, солай ма? ))
Dialogue: 0,0:22:00.07,0:22:03.67,Default,,0,0,0,,≪Бәріңіз күліп, өмір сүресіз, солай ма? ≫
Dialogue: 0,0:22:03.67,0:22:05.67,Default,,0,0,0,,≪Хару-чан≫ сияқты
Dialogue: 0,0:22:07.11,0:22:10.72,Default,,0,0,0,,Гашаан!!
Dialogue: 0,0:22:10.72,0:22:24.26,Default,,0,0,0,,♬～
Dialogue: 0,0:22:24.26,0:22:26.28,Default,,0,0,0,,Неге...
Dialogue: 0,0:22:26.28,0:22:30.99,Default,,0,0,0,,♬～
Dialogue: 0,0:22:30.99,0:22:33.54,Default,,0,0,0,,Харуки жинағы...
Dialogue: 0,0:22:33.54,0:22:35.96,Default,,0,0,0,,Соның арқасында бос орын пайда болды.
Dialogue: 0,0:22:35.96,0:22:45.23,Default,,0,0,0,,♬～
Dialogue: 0,0:22:45.23,0:22:56.08,Default,,0,0,0,,♬～
Dialogue: 0,0:22:56.08,0:22:59.58,Default,,0,0,0,,Өлімге әкелетін жарақаттар жоқ. Рақмет сізге.
Dialogue: 0,0:23:00.93,0:23:02.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:04.99,0:23:07.00,Default,,0,0,0,,Сіз оянасыз ба?
Dialogue: 0,0:23:07.00,0:23:09.74,Default,,0,0,0,,Бұл сіз...
Dialogue: 0,0:23:09.74,0:23:14.95,Default,,0,0,0,,күрсіну~. Ааа мен жеңілдім. Мен тапсырамын.➡
Dialogue: 0,0:23:14.95,0:23:18.30,Default,,0,0,0,,Біз бәріміз таза өмірден өтуді жоспарлағанбыз.➡
Dialogue: 0,0:23:18.30,0:23:20.87,Default,,0,0,0,,Бұл соншалықты жаман емес.
Dialogue: 0,0:23:20.87,0:23:23.57,Default,,0,0,0,,Мен оңай өлмеймін.
Dialogue: 0,0:23:25.52,0:23:29.86,Default,,0,0,0,,Тірі болу – кешірілу➡
Dialogue: 0,0:23:29.86,0:23:31.96,Default,,0,0,0,,Қазір осында болу
Dialogue: 0,0:23:33.75,0:23:37.87,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:23:37.87,0:23:40.94,Default,,0,0,0,,Ешкім сұрамаса да
Dialogue: 0,0:23:40.94,0:23:43.24,Default,,0,0,0,,Бұл қызықты оқиға.
Dialogue: 0,0:23:43.24,0:23:46.78,Default,,0,0,0,,♬～
Dialogue: 0,0:23:46.78,0:23:49.21,Default,,0,0,0,,Олай болса, оған көмектесу мүмкін емес деп ойлаймын.
Dialogue: 0,0:23:49.21,0:23:52.98,Default,,0,0,0,,Менің ойымша, біз қандай да бір жолмен бар күшімізді салуымыз керек.
Dialogue: 0,0:23:52.98,0:23:56.35,Default,,0,0,0,,Ах~ахх...｡ Хэхехе
Dialogue: 0,0:23:56.35,0:23:59.74,Default,,0,0,0,,♬～
Dialogue: 0,0:23:59.74,0:24:04.14,Default,,0,0,0,,Не? Менің өлмегенім үшін жеңілдеп қалған сияқтысың.
Dialogue: 0,0:24:06.20,0:24:09.78,Default,,0,0,0,,Сіз де өлмеген сияқтысыз➡
Dialogue: 0,0:24:09.78,0:24:13.90,Default,,0,0,0,,Қазірден бастап бар күшіңізді салыңыз. Хехе
Dialogue: 0,0:24:13.90,0:24:19.69,Default,,0,0,0,,♬～
Dialogue: 0,0:24:19.69,0:24:22.81,Default,,0,0,0,,Харуки-ничан, тезірек ораласыз ба?
Dialogue: 0,0:24:22.81,0:24:25.90,Default,,0,0,0,,Мүмкін? (Фуйука) Дұрыс.➡
Dialogue: 0,0:24:25.90,0:24:29.22,Default,,0,0,0,,Өйткені, отбасылардың бірге болғаны жақсы.
Dialogue: 0,0:24:29.22,0:24:35.22,Default,,0,0,0,,♬～
Dialogue: 0,0:24:37.41,0:24:42.98,Default,,0,0,0,,Жоооооуу!!
Dialogue: 0,0:24:42.98,0:24:58.92,Default,,0,0,0,,♬～
Dialogue: 0,0:24:58.92,0:25:02.50,Default,,0,0,0,,Дүние кешірімге толы деп айта аламыз ба?
Dialogue: 0,0:25:02.50,0:25:05.47,Default,,0,0,0,,Сыныпта менің басымнан осындай жағдай болса да...➡
Dialogue: 0,0:25:05.47,0:25:08.33,Default,,0,0,0,,Бүкіл әлем маған өлім тілесе де➡
Dialogue: 0,0:25:08.33,0:25:10.76,Default,,0,0,0,,Сіз бәрін кешіре аласыз ба?
Dialogue: 0,0:25:10.76,0:25:14.06,Default,,0,0,0,,♬～
Dialogue: 0,0:25:14.06,0:25:17.70,Default,,0,0,0,,Тәубе еткен адамның күнәлары мен қателіктерін кешіре гөр➡
Dialogue: 0,0:25:17.70,0:25:21.06,Default,,0,0,0,,Кешіріңіз, қанша қаласаңыз, сонша рет.
Dialogue: 0,0:25:21.06,0:25:26.74,Default,,0,0,0,,♬～
Dialogue: 0,0:25:26.74,0:25:29.38,Default,,0,0,0,,Бұл шексіз көп рет кешіруді білдіреді.
Dialogue: 0,0:25:29.38,0:25:37.88,Default,,0,0,0,,♬～
Dialogue: 0,0:25:39.24,0:25:45.68,Default,,0,0,0,,♬～
Dialogue: 0,0:25:45.68,0:25:48.62,Default,,0,0,0,,♬ таңбалық жанашырлық
Dialogue: 0,0:25:48.62,0:25:51.67,Default,,0,0,0,,♬ Қанша қабат салсаңыз да
Dialogue: 0,0:25:51.67,0:25:54.54,Default,,0,0,0,,♬ Тән – адалдық
Dialogue: 0,0:25:54.54,0:25:57.73,Default,,0,0,0,,♬ жеткіліксіз, қанағаттандырылмаған
Dialogue: 0,0:25:57.73,0:26:00.91,Default,,0,0,0,,♬ Оған берген уәдем
Dialogue: 0,0:26:00.91,0:26:03.70,Default,,0,0,0,,♬ Мен оны еш нәрсеге қарамастан қорғағым келеді
Dialogue: 0,0:26:03.70,0:26:08.90,Default,,0,0,0,,♬ Аяқ киіміңіздің бауын мықтап байлаңыз
Dialogue: 0,0:26:08.90,0:26:15.01,Default,,0,0,0,,♬ Тіпті өмір де қымбат деуге болады.
Dialogue: 0,0:26:15.01,0:26:19.55,Default,,0,0,0,,♬ Тілегіңіз бар ма?
Dialogue: 0,0:26:19.55,0:26:21.60,Default,,0,0,0,,♬ О, мені босат
Dialogue: 0,0:26:21.60,0:26:25.85,Default,,0,0,0,,♬ Құрбандық пен ауырсыну маңызды емес
Dialogue: 0,0:26:25.85,0:26:27.87,Default,,0,0,0,,♬ Мені босат
Dialogue: 0,0:26:27.87,0:26:32.04,Default,,0,0,0,,♬ Өтірікші, мейірімділік, бітті
Dialogue: 0,0:26:32.04,0:26:35.66,Default,,0,0,0,,♬ Сізден не күтілуде Сіздің жүгіңіз қандай
Dialogue: 0,0:26:35.66,0:26:38.62,Default,,0,0,0,,♬ Ол күшке айналады
Dialogue: 0,0:26:38.62,0:26:41.62,Default,,0,0,0,,♬ Өмір сүрудің мәні - аяқталу мағынасы
Dialogue: 0,0:26:41.62,0:26:45.92,Default,,0,0,0,,♬ Себебі мен оның ішімде екенін білемін
Dialogue: 0,0:26:45.92,0:26:49.58,Default,,0,0,0,,♬ Өтінемін, мені босатыңызшы
Dialogue: 0,0:26:49.58,0:26:59.24,Default,,0,0,0,,♬～
Dialogue: 0,0:26:59.24,0:27:03.91,Default,,0,0,0,,♬ Маңызды емес жанашырлық
Dialogue: 0,0:27:03.91,0:27:08.21,Default,,0,0,0,,♬～
Dialogue: 0,0:28:40.29,0:28:42.32,Default,,0,0,0,,｢Болу немесе болмау｣｡➡
Dialogue: 0,0:28:42.32,0:28:44.88,Default,,0,0,0,,«Өмір сүру керек пе, әлде өлу керек пе? Бұл сұрақ.»➡
Dialogue: 0,0:28:44.88,0:28:47.78,Default,,0,0,0,,Бұл «Гамлетте» кездесетін жол. Бұл жолы ➡
Dialogue: 0,0:28:47.78,0:28:50.35,Default,,0,0,0,,«Ромео мен Джульетта» болғандықтан маңызды емес дейсіз бе? ➡
Dialogue: 0,0:28:50.35,0:28:53.25,Default,,0,0,0,,Фестиваль деп толқып кетсең, Мен саған қиналып қараймын.
Dialogue: 0,0:28:54.69,0:28:57.10,Default,,0,0,0,,«Куругуми үй бөлмесі»!
Dialogue: 0,0:28:57.10,0:28:59.37,Default,,0,0,0,,Эй Токаку-сан...Не болды?
Dialogue: 0,0:28:59.37,0:29:02.19,Default,,0,0,0,,Өзіңізді жақсы сезінбейтін жағдайлар сирек кездеседі. Негізі➡
Dialogue: 0,0:29:02.19,0:29:05.81,Default,,0,0,0,,Менің үстелімде осындай нәрсе бар. Бұл ескерту қағазы...➡
Dialogue: 0,0:29:05.81,0:29:08.35,Default,,0,0,0,,Иллюстрациялық карта емес!? Бұл карта➡
Dialogue: 0,0:29:08.35,0:29:11.00,Default,,0,0,0,,Бұл ``diomedéashop'' дүкенінен алуға болатын нәрсе.
Dialogue: 0,0:29:11.00,0:29:13.29,Default,,0,0,0,,Мен уайымдап ақша жоғалттым. Айтпақшы➡
Dialogue: 0,0:29:13.29,0:29:15.62,Default,,0,0,0,,«Ібіліс жұмбағы» белгішелер, стикерлер және т.б. болады. ➡
Dialogue: 0,0:29:15.62,0:29:18.06,Default,,0,0,0,,Басқа да көптеген тауарлар бар!
Dialogue: 0,0:29:18.06,0:29:20.36,Default,,0,0,0,,Токаку-сан, қазір тексеріңіз!
Dialogue: 0,0:29:20.36,0:29:23.46,Default,,0,0,0,,Менің шиеленісуім кенет күшейді. Blu-ray және DVD ➡
Dialogue: 0,0:29:23.46,0:29:25.52,Default,,0,0,0,,Сатып алу кезіндегі жеңілдіктер де бар➡
Dialogue: 0,0:29:25.52,0:29:28.25,Default,,0,0,0,,Барлығыңыз, «Шайтанның жұмбағы» ресми басты бетін қараңыз ➡
Dialogue: 0,0:29:28.25,0:29:30.25,Default,,0,0,0,,Қарап көріңіз!
Dialogue: 0,0:29:31.75,0:29:37.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory