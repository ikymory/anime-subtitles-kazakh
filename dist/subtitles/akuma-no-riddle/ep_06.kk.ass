Dialogue: 0,0:01:36.26,0:01:40.04,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:40.04,0:01:44.65,Default,,0,0,0,,♬～
Dialogue: 0,0:01:44.65,0:01:47.29,Default,,0,0,0,,((Хмм?)) (Сензу)((Қайда бара жатырсың?))
Dialogue: 0,0:01:47.29,0:01:49.89,Default,,0,0,0,,)
Dialogue: 0,0:01:49.89,0:01:53.78,Default,,0,0,0,,((Мен оны сенімен бірге іздеймін)) ((Ах...))
Dialogue: 0,0:01:53.78,0:01:58.41,Default,,0,0,0,,)
Dialogue: 0,0:01:58.41,0:02:02.67,Default,,0,0,0,,)
Dialogue: 0,0:02:02.67,0:02:04.82,Default,,0,0,0,,)
Dialogue: 0,0:02:04.82,0:02:09.06,Default,,0,0,0,,)
Dialogue: 0,0:02:09.06,0:02:12.71,Default,,0,0,0,,() ()
Dialogue: 0,0:02:12.71,0:02:14.71,Default,,0,0,0,,()
Dialogue: 0,0:02:16.88,0:02:20.38,Default,,0,0,0,,((Бастауыш сынып оқушысы? Қамқоршың жоқ па?))
Dialogue: 0,0:02:20.38,0:02:23.60,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:02:23.60,0:02:28.20,Default,,0,0,0,,♬～
Dialogue: 0,0:02:29.63,0:02:31.80,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:02:31.80,0:02:34.72,Default,,0,0,0,,Біз аңдыған үйді ойнаймыз! (Оқушы) Мына жақта, мына жақта!
Dialogue: 0,0:02:34.72,0:02:41.91,Default,,0,0,0,,♬～ (Жол өнімділігі)
Dialogue: 0,0:02:41.91,0:02:44.61,Default,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:02:44.61,0:02:48.71,Default,,0,0,0,,Уау! (Сензу) Бұл өте қызықты.
Dialogue: 0,0:02:48.71,0:02:51.32,Default,,0,0,0,,♬~
Dialogue: 0,0:02:51.32,0:02:54.22,Default,,0,0,0,,Джекпот! Clank clang... (қоңырау дыбысы)
Dialogue: 0,0:02:54.22,0:02:57.07,Default,,0,0,0,,Токаку мырза керемет!
Dialogue: 0,0:02:57.07,0:03:00.17,Default,,0,0,0,,Міне, сенің қалағаның осы болды.
Dialogue: 0,0:03:02.28,0:03:05.08,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:03:06.46,0:03:08.53,Default,,0,0,0,,Джекпот! Каран Каран…
Dialogue: 0,0:03:08.53,0:03:10.87,Default,,0,0,0,,♬ Хмф, сағ, сағ (Студент) Қош келдіңіз! ➡
Dialogue: 0,0:03:10.87,0:03:12.87,Default,,0,0,0,,Бұл Якисоба! (Табыт) Фуфуфуфуфу!
Dialogue: 0,0:03:14.17,0:03:18.64,Default,,0,0,0,,Хехехе, рахмет, Сенсоку-сан!
Dialogue: 0,0:03:18.64,0:03:23.75,Default,,0,0,0,,Қара топта Киригая сияқты бала бар ма деп алаңдаймын.
Dialogue: 0,0:03:23.75,0:03:26.15,Default,,0,0,0,,Ғибадатхана қыз-қызметшісінің киімі оған жарасады.
Dialogue: 0,0:03:26.15,0:03:29.49,Default,,0,0,0,,♬～
Dialogue: 0,0:03:29.49,0:03:33.09,Default,,0,0,0,,Менде бәрі жақсы. Сенсоку мырза ше? ➡
Dialogue: 0,0:03:33.09,0:03:36.89,Default,,0,0,0,,Сіз Ичиноза-сан сіздің мақсатыңыз емес екенін айттыңыз.
Dialogue: 0,0:03:38.48,0:03:40.48,Default,,0,0,0,,Періште кернейі
Dialogue: 0,0:03:42.50,0:03:45.05,Default,,0,0,0,,Аяусыз улаушы.
Dialogue: 0,0:03:45.05,0:03:48.22,Default,,0,0,0,,Мен оны міндетті түрде тауып, өз қолыммен жеңемін.
Dialogue: 0,0:03:48.22,0:03:51.64,Default,,0,0,0,,♬～
Dialogue: 0,0:03:51.64,0:03:54.64,Default,,0,0,0,,Мен Сенсоку мырзаға көмектесемін.
Dialogue: 0,0:03:58.18,0:04:00.50,Default,,0,0,0,,♬ Кері санауға дайынсыз ба
Dialogue: 0,0:04:00.50,0:04:02.65,Default,,0,0,0,,♬ Жүгіруге жол жоқ
Dialogue: 0,0:04:02.65,0:04:11.78,Default,,0,0,0,,♬～
Dialogue: 0,0:04:11.78,0:04:16.40,Default,,0,0,0,,♬ Оңай диапазонға түспеңіз.
Dialogue: 0,0:04:16.40,0:04:21.29,Default,,0,0,0,,♬ Бұл қырғи-қабақ соғыс аймағы. Қазіргі жағдай жалықтырады.
Dialogue: 0,0:04:21.29,0:04:25.86,Default,,0,0,0,,♬ Ей, балалар, сондықтан ерекше екенсіңдер.
Dialogue: 0,0:04:25.86,0:04:27.91,Default,,0,0,0,,♬ Баяғыда сыйымдылық асып кеткен
Dialogue: 0,0:04:27.91,0:04:30.21,Default,,0,0,0,,♬ Өзін-өзі мазақ ету түбі жоқ сезім
Dialogue: 0,0:04:30.21,0:04:32.32,Default,,0,0,0,,♬ Өте сүйкімді
Dialogue: 0,0:04:32.32,0:04:35.32,Default,,0,0,0,,♬ Саған ақымақтығымды көрсете алмаймын.
Dialogue: 0,0:04:35.32,0:04:37.37,Default,,0,0,0,,♬ Бекер толқу
Dialogue: 0,0:04:37.37,0:04:39.37,Default,,0,0,0,,♬ Тек ынталандыру үшін
Dialogue: 0,0:04:40.71,0:04:43.28,Default,,0,0,0,,♬ Қабылдау/Көтеріліс Тек екі таңдау бар ма?
Dialogue: 0,0:04:43.28,0:04:47.05,Default,,0,0,0,,♬ ah Эстетика «Мен ешкімге тиіспеймін»
Dialogue: 0,0:04:47.05,0:04:49.10,Default,,0,0,0,,♬ Жараның кінәсіздігі
Dialogue: 0,0:04:49.10,0:04:51.82,Default,,0,0,0,,♬ Мен де сол топқа кіремін.
Dialogue: 0,0:04:51.82,0:04:53.84,Default,,0,0,0,,♬ орылады
Dialogue: 0,0:04:53.84,0:04:56.21,Default,,0,0,0,,♬ Ешбір жағдайда әрқашан жалғасуда
Dialogue: 0,0:04:56.21,0:05:00.31,Default,,0,0,0,,♬ Белдемшенің етегі туралы шындық
Dialogue: 0,0:05:00.31,0:05:05.33,Default,,0,0,0,,♬ Тек ақымақ сияқты сеніңіз
Dialogue: 0,0:05:05.33,0:05:09.69,Default,,0,0,0,,♬ Маған қатты әсер етті
Dialogue: 0,0:05:09.69,0:05:16.36,Default,,0,0,0,,♬ Оны твиттер арқылы жіберіңіз.
Dialogue: 0,0:05:16.36,0:05:25.76,Default,,0,0,0,,♬～
Dialogue: 0,0:05:38.70,0:05:41.57,Default,,0,0,0,,Кін! Туысқан! Туысқан!
Dialogue: 0,0:05:41.57,0:05:43.75,Default,,0,0,0,,Кинкин Кинкин!
Dialogue: 0,0:05:43.75,0:05:45.77,Default,,0,0,0,,Какин! Апыр-ай!
Dialogue: 0,0:05:45.77,0:05:49.58,Default,,0,0,0,,Аа~ қазірдің өзінде! Ичиноза: Дұрыс істе! ➡
Dialogue: 0,0:05:49.58,0:05:53.21,Default,,0,0,0,,Нағыз нәрсе ертең! кешіріңіз
Dialogue: 0,0:05:53.21,0:05:56.38,Default,,0,0,0,,Мен оны қолымнан келгенше қанша қаласам, сонша қайталаймын!
Dialogue: 0,0:05:56.38,0:05:58.69,Default,,0,0,0,,Иә...｡ Көрдіңіз бе?
Dialogue: 0,0:05:58.69,0:06:01.26,Default,,0,0,0,,А, рахмет, Токаку-сан.
Dialogue: 0,0:06:01.26,0:06:03.31,Default,,0,0,0,,Ихинозаның күші жоқ.
Dialogue: 0,0:06:03.31,0:06:06.44,Default,,0,0,0,,Сіз бұрын ешқашан қылыш ұстаған емессіз, солай ма?
Dialogue: 0,0:06:06.44,0:06:08.68,Default,,0,0,0,,Жарайды, тағы! Тибалт бұл➡
Dialogue: 0,0:06:08.68,0:06:11.03,Default,,0,0,0,,Меркутио өлтірілген жерден!
Dialogue: 0,0:06:11.03,0:06:13.85,Default,,0,0,0,,Азума-санның рөлі Хару-чанды өлтіру болды➡
Dialogue: 0,0:06:13.85,0:06:16.04,Default,,0,0,0,,Бұл күлкілі~
Dialogue: 0,0:06:16.04,0:06:18.64,Default,,0,0,0,,Иә, иә! Өз костюміңізді киіңіз➡
Dialogue: 0,0:06:18.64,0:06:20.96,Default,,0,0,0,,Оның дұрыс жұмыс істеп тұрғанын тексеріңіз! ➡
Dialogue: 0,0:06:20.96,0:06:24.18,Default,,0,0,0,,Ақаулық болса, Бамба мырзадан оны шешуін сұраңыз!
Dialogue: 0,0:06:24.18,0:06:26.31,Default,,0,0,0,,Бұл өте ащы
Dialogue: 0,0:06:26.31,0:06:29.47,Default,,0,0,0,,Мен күтушімін, сонда мен неге қызметші формасын киіп жүрмін?
Dialogue: 0,0:06:29.47,0:06:33.05,Default,,0,0,0,,Эй, қызметші "мен" дейді
Dialogue: 0,0:06:33.05,0:06:36.14,Default,,0,0,0,,Қызметші Жоқ... Мен күтушімін...
Dialogue: 0,0:06:36.14,0:06:40.01,Default,,0,0,0,,Бұл жақсы емес пе? Gap Moe
Dialogue: 0,0:06:40.01,0:06:42.68,Default,,0,0,0,,Уау, Эй-сан, бұл өте жақсы!
Dialogue: 0,0:06:42.68,0:06:45.32,Default,,0,0,0,,Әй, сен де сондай әдемісің.
Dialogue: 0,0:06:45.32,0:06:47.39,Default,,0,0,0,,А... Меніңше, солай ма?
Dialogue: 0,0:06:47.39,0:06:51.32,Default,,0,0,0,,Умаконың да костюмі бар. Токаку мырза!
Dialogue: 0,0:06:51.32,0:06:53.32,Default,,0,0,0,,Бұл жанды.
Dialogue: 0,0:06:55.33,0:06:57.81,Default,,0,0,0,,Барлығы~ Мына жаққа қараңдар~!
Dialogue: 0,0:06:57.81,0:07:01.70,Default,,0,0,0,,Иә~ Фото? (Тайвань) Бұл тамаша! Жастық шақтың бір бөлігі!
Dialogue: 0,0:07:01.70,0:07:14.80,Default,,0,0,0,,♬～
Dialogue: 0,0:07:17.18,0:07:21.64,Default,,0,0,0,,Киригая Қарсы болмасаң, неге анда-санда қоғамдық моншаға бармайсың?
Dialogue: 0,0:07:21.64,0:07:25.81,Default,,0,0,0,,Кешіріңіз, мен шаршадым.
Dialogue: 0,0:07:25.81,0:07:28.21,Default,,0,0,0,,Мен көрдім. Содан кейін
Dialogue: 0,0:07:30.98,0:07:33.08,Default,,0,0,0,,Перненің соғуы (есік дыбысы)
Dialogue: 0,0:07:33.08,0:07:40.04,Default,,0,0,0,,♬～
Dialogue: 0,0:07:40.04,0:07:42.09,Default,,0,0,0,,Банг! (Есік дыбысы) Иә?
Dialogue: 0,0:07:42.09,0:07:45.24,Default,,0,0,0,,Күте тұрыңыз, Ичиноза! Сіз оны кейінірек қалдыра аласыз!
Dialogue: 0,0:07:45.24,0:07:48.25,Default,,0,0,0,,Бірақ мен оны тез арада табуым керек. Ихиноза!
Dialogue: 0,0:07:48.25,0:07:55.64,Default,,0,0,0,,♬～
Dialogue: 0,0:07:55.64,0:07:59.37,Default,,0,0,0,,О? Киригая ше? (Сензу) Мен ұйықтап жатырмын.
Dialogue: 0,0:07:59.37,0:08:03.77,Default,,0,0,0,,Хмм, кейде олар бір-бірінен ажыратылған түрде әрекет етеді.
Dialogue: 0,0:08:06.05,0:08:08.70,Default,,0,0,0,,Уф~
Dialogue: 0,0:08:08.70,0:08:11.90,Default,,0,0,0,,)
Dialogue: 0,0:08:13.34,0:08:15.94,Default,,0,0,0,,≪Бұл туралы айтқаныңызға қуаныштысыз ба...≫
Dialogue: 0,0:08:18.83,0:08:22.43,Default,,0,0,0,,Хмм, бұл қайда кетті скрипт
Dialogue: 0,0:08:22.43,0:08:25.00,Default,,0,0,0,,Мен оны осы жерде деп ойладым...
Dialogue: 0,0:08:25.00,0:08:27.25,Default,,0,0,0,,Негізі сөмкемде болды➡\NБұл
Dialogue: 0,0:08:27.25,0:08:29.29,Default,,0,0,0,,сияқты нәрсе емес пе?
Dialogue: 0,0:08:29.29,0:08:32.57,Default,,0,0,0,,Мен сөмкенің ішіне қарадым.
Dialogue: 0,0:08:32.57,0:08:36.81,Default,,0,0,0,,Токаку-сан, ше? Бұл біртүрлі
Dialogue: 0,0:08:36.81,0:08:44.29,Default,,0,0,0,,♬～
Dialogue: 0,0:08:44.29,0:08:47.49,Default,,0,0,0,,Хехе. ≫(Хицуги) Сен осы сағатқа дейін өте ынтасың.
Dialogue: 0,0:08:48.77,0:08:51.39,Default,,0,0,0,,Ах... жақсы.
Dialogue: 0,0:08:51.39,0:08:55.36,Default,,0,0,0,,Сіз ертең Ичиноза-санмен айналысуды жоспарлап отырсыз ба?
Dialogue: 0,0:08:55.36,0:08:57.72,Default,,0,0,0,,Не? Ах...｡➡
Dialogue: 0,0:08:57.72,0:09:00.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.02,0:09:03.40,Default,,0,0,0,,Сол себепті сен қатты толқыдың.
Dialogue: 0,0:09:03.40,0:09:06.46,Default,,0,0,0,,Киригая бірдеңені ұмытты ма?
Dialogue: 0,0:09:06.46,0:09:10.36,Default,,0,0,0,,Жоқ.Мен де ертеңгі күнге дайындалуға келдім.
Dialogue: 0,0:09:13.21,0:09:15.25,Default,,0,0,0,,Басыңыз!
Dialogue: 0,0:09:15.25,0:09:18.37,Default,,0,0,0,,♬～
Dialogue: 0,0:09:18.37,0:09:20.82,Default,,0,0,0,,Уф уф...➡
Dialogue: 0,0:09:20.82,0:09:23.04,Default,,0,0,0,,Уф... Шапалақтаңыз!
Dialogue: 0,0:09:23.04,0:09:26.51,Default,,0,0,0,,Енді ше? О, Токаку-сан!
Dialogue: 0,0:09:26.51,0:09:31.53,Default,,0,0,0,,♬～
Dialogue: 0,0:09:31.53,0:09:35.15,Default,,0,0,0,,Ах. Шиена-чан!
Dialogue: 0,0:09:35.15,0:09:37.15,Default,,0,0,0,,А, келіңдер!
Dialogue: 0,0:09:39.07,0:09:41.21,Default,,0,0,0,,Бұл кім!?
Dialogue: 0,0:09:41.21,0:09:45.88,Default,,0,0,0,,Мұны көріп тұрғандарыңызға сене алар емеспін➡
Dialogue: 0,0:09:45.88,0:09:48.33,Default,,0,0,0,,Ол жерде жоқ.
Dialogue: 0,0:09:48.33,0:09:52.12,Default,,0,0,0,,Бұл Хицуги-чан болуы мүмкін бе? Неліктен Кенмочи?
Dialogue: 0,0:09:52.12,0:09:55.24,Default,,0,0,0,,Маған жай ғана ыңғайсыздық туғызғандықтан, кетуімді өтінді.
Dialogue: 0,0:09:55.24,0:10:02.18,Default,,0,0,0,,♬～
Dialogue: 0,0:10:02.18,0:10:06.05,Default,,0,0,0,,Аа, мен мұны кейінірек шығарамын деп ойладым.
Dialogue: 0,0:10:06.05,0:10:10.19,Default,,0,0,0,,♬～
Dialogue: 0,0:10:10.19,0:10:12.29,Default,,0,0,0,,Мен ертеңді асыға күтемін.
Dialogue: 0,0:10:12.29,0:10:15.89,Default,,0,0,0,,♬～
Dialogue: 0,0:10:15.89,0:10:17.89,Default,,0,0,0,,Хицуги-чан…
Dialogue: 0,0:12:24.92,0:12:29.81,Default,,0,0,0,,Иә~ Кенмочи кенеттен ауруханаға жатқызуға тура келді.➡
Dialogue: 0,0:12:29.81,0:12:35.33,Default,,0,0,0,,Оның да бүгінгі кезеңі сәтті өтсін!
Dialogue: 0,0:12:35.33,0:12:38.94,Default,,0,0,0,,Мен сені аяймын, өйткені сен қатты толқыдың.➡
Dialogue: 0,0:12:38.94,0:12:41.44,Default,,0,0,0,,Азума-сан, ең болмағанда сахна біткенше➡
Dialogue: 0,0:12:41.44,0:12:43.47,Default,,0,0,0,,Мен күтуім керек еді.
Dialogue: 0,0:12:43.47,0:12:45.51,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:12:45.51,0:12:50.51,Default,,0,0,0,,О? Азума-сан мұны Хару-чанды қорғау үшін істемеді ме?
Dialogue: 0,0:12:52.85,0:12:55.19,Default,,0,0,0,,≪Шығыста қылыш бар ма? ≫
Dialogue: 0,0:12:55.19,0:12:58.51,Default,,0,0,0,,Кенмочи мырза улы инемен оқталған, оның жағдайы ауыр.
Dialogue: 0,0:12:58.51,0:13:02.58,Default,,0,0,0,,А... (Исуке) Хмм, бұл улы.
Dialogue: 0,0:13:02.58,0:13:06.46,Default,,0,0,0,,Айтпақшы, Кенмочи мырза өзінің ескерту билетін кеше түнде жариялады➡
Dialogue: 0,0:13:06.46,0:13:11.08,Default,,0,0,0,,Мен біраз уақытқа ауруханада жатқан сияқтымын, сондықтан бұл өшіп қалады.
Dialogue: 0,0:13:11.08,0:13:17.99,Default,,0,0,0,,♬～
Dialogue: 0,0:13:17.99,0:13:20.33,Default,,0,0,0,,Мына балалар сүйкімді
Dialogue: 0,0:13:20.33,0:13:24.05,Default,,0,0,0,,Иә, иә! 10-сынып қара сыныбының «Ромео мен Джульетта»➡
Dialogue: 0,0:13:24.05,0:13:26.25,Default,,0,0,0,,Оны жіберіп алмаңыз!
Dialogue: 0,0:13:26.25,0:13:28.74,Default,,0,0,0,,Қара топ сұлуларға толы сияқты!
Dialogue: 0,0:13:28.74,0:13:30.74,Default,,0,0,0,,Барып көрейік пе? (Оқушы) Иә, иә!
Dialogue: 0,0:13:32.22,0:13:34.78,Default,,0,0,0,,Кем дегенде Шиена-чан➡ үшін
Dialogue: 0,0:13:34.78,0:13:37.69,Default,,0,0,0,,Бүгінгі кезең сәтті өткенін қалаймын.
Dialogue: 0,0:13:37.69,0:13:42.45,Default,,0,0,0,,Қылыш ұстаушы үшін... Хехехе, бұл мүмкін емес шығар?
Dialogue: 0,0:13:42.45,0:13:45.50,Default,,0,0,0,,Киригая уды қолданатын шығар.
Dialogue: 0,0:13:45.50,0:13:49.62,Default,,0,0,0,,Оған жақындама, бүгін басқа ештеңе жеме.
Dialogue: 0,0:13:49.62,0:13:52.59,Default,,0,0,0,,Түсінді ме? Иә
Dialogue: 0,0:13:52.59,0:13:57.33,Default,,0,0,0,,Мен сені қорғаймын. Токаку мырза...
Dialogue: 0,0:13:57.33,0:14:00.83,Default,,0,0,0,,Сондықтан бүгінгі күнді толық рахатқа бөліңіз. Иә!
Dialogue: 0,0:14:02.52,0:14:05.51,Default,,0,0,0,,Өйткені, Сенсоку - әйел.➡
Dialogue: 0,0:14:05.51,0:14:07.54,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:14:07.54,0:14:10.83,Default,,0,0,0,,Ах...｡ Мен отокоякумын ➡
Dialogue: 0,0:14:10.83,0:14:13.68,Default,,0,0,0,,Киригая жақсырақ... (Табыт) Уф.➡
Dialogue: 0,0:14:13.68,0:14:16.88,Default,,0,0,0,,Сенсоку-сан, сен шынымен жақсысың.
Dialogue: 0,0:14:19.25,0:14:22.41,Default,,0,0,0,,Періште керней｡➡
Dialogue: 0,0:14:22.41,0:14:25.24,Default,,0,0,0,,Мені неге іздейсің?
Dialogue: 0,0:14:25.24,0:14:31.92,Default,,0,0,0,,♬～
Dialogue: 0,0:14:31.92,0:14:36.37,Default,,0,0,0,,((Ол баланы не үшін өлтірді деп ойлаймын➡
Dialogue: 0,0:14:36.37,0:14:39.89,Default,,0,0,0,,Қанша ойласам да түсінбеймін))
Dialogue: 0,0:14:39.89,0:14:44.53,Default,,0,0,0,,♬～
Dialogue: 0,0:14:44.53,0:14:47.58,Default,,0,0,0,,А, бұл біртүрлі емес пе? ➡
Dialogue: 0,0:14:47.58,0:14:51.38,Default,,0,0,0,,Бет-аузын танымайтын біреуді қуып осынша келдім.
Dialogue: 0,0:14:52.74,0:14:57.07,Default,,0,0,0,,Олар Сензу үшін маңызды адамдар болды, солай ма?
Dialogue: 0,0:14:57.07,0:15:01.81,Default,,0,0,0,,Ааа, мен сенің қызыңды бір-ақ рет кездестірдім➡
Dialogue: 0,0:15:01.81,0:15:05.17,Default,,0,0,0,,Ол жарқын, жақсы адам еді. (Табыт) А?
Dialogue: 0,0:15:05.17,0:15:09.44,Default,,0,0,0,,Сіз тек бір рет кездескен адам үшін бе?
Dialogue: 0,0:15:09.44,0:15:13.41,Default,,0,0,0,,Хехе. (Хисаши) Сенсоку-сан мейірімді адам.
Dialogue: 0,0:15:13.41,0:15:17.71,Default,,0,0,0,,Мен сенің күлкіңді қайтарғым келеді.➡
Dialogue: 0,0:15:19.26,0:15:23.42,Default,,0,0,0,,Киригая Сіз кеше маған көмектесемін дедіңіз➡
Dialogue: 0,0:15:23.42,0:15:25.57,Default,,0,0,0,,Мұны істеудің қажеті жоқ.➡
Dialogue: 0,0:15:25.57,0:15:30.12,Default,,0,0,0,,Сен сияқты балалар қараңғыда қыбыр етпеуі керек.
Dialogue: 0,0:15:30.12,0:15:33.61,Default,,0,0,0,,Хехе. Жарайды➡
Dialogue: 0,0:15:33.61,0:15:36.31,Default,,0,0,0,,Мен соншалықты әлсіз емеспін.
Dialogue: 0,0:15:38.10,0:15:40.10,Default,,0,0,0,,Киригая?
Dialogue: 0,0:15:41.50,0:15:43.59,Default,,0,0,0,,А, а~｡ Мм.
Dialogue: 0,0:15:43.59,0:15:46.11,Default,,0,0,0,,Бұдан былай 10-курсқа қарай қара топ➡
Dialogue: 0,0:15:46.11,0:15:48.98,Default,,0,0,0,,[Баяндамашы] «Ромео мен Джульетта» қойылады! ➡
Dialogue: 0,0:15:48.98,0:15:51.76,Default,,0,0,0,,Барлығың, орамалдарың дайын ба?
Dialogue: 0,0:15:51.76,0:15:56.38,Default,,0,0,0,,Ұялы телефоныңызды өшіріңіз. Әдепті сыйламайтын балаларға ➡
Dialogue: 0,0:15:56.38,0:15:58.64,Default,,0,0,0,,Сіз тіпті өлтірілгеніңізді де білмейсіз, солай ма?
Dialogue: 0,0:15:58.64,0:16:01.52,Default,,0,0,0,,Ахахха! (Оқушы) Бұл хабарландыру қызық екен!
Dialogue: 0,0:16:01.52,0:16:04.72,Default,,0,0,0,,Жарайды, Инукай, ұстап алу жарайды.
Dialogue: 0,0:16:06.18,0:16:10.48,Default,,0,0,0,,Ихиноза Сіз қобалжыдыңыз ба? Иә...
Dialogue: 0,0:16:10.48,0:16:12.48,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:18.49,0:16:20.51,Default,,0,0,0,,[Спикер] Boo (дыбыстық сигналды ашу)
Dialogue: 0,0:16:20.51,0:16:25.78,Default,,0,0,0,,Мен хат жібергім келеді…
Dialogue: 0,0:16:25.78,0:16:30.58,Default,,0,0,0,,Қайырлы түн, жас ханым. (Табыт) Иә, қайырлы түн.➡
Dialogue: 0,0:16:30.58,0:16:35.51,Default,,0,0,0,,Әй, күндіз-түні ойлайтыным сол адам.
Dialogue: 0,0:16:35.51,0:16:37.77,Default,,0,0,0,,Әй, менің ең қымбат адамым...➡
Dialogue: 0,0:16:37.77,0:16:43.31,Default,,0,0,0,,Түннің қанат күшін қарызға алып, Бүгін түнде осылай ұштым.
Dialogue: 0,0:16:43.31,0:16:49.70,Default,,0,0,0,,Бүгінгі түнде ай әдемі. Бірақ ай құдайы, сен қатыгезсің.
Dialogue: 0,0:16:49.70,0:16:53.57,Default,,0,0,0,,≪Егер олар оны бүгін орнатса, 10 сағаттан аз уақыт қалады≫
Dialogue: 0,0:16:53.57,0:16:55.57,Default,,0,0,0,,Ах
Dialogue: 0,0:16:58.33,0:17:02.53,Default,,0,0,0,,Мен өзімді ақымақ сияқты сезінемін. Балконнан жалғыз➡
Dialogue: 0,0:17:02.53,0:17:05.09,Default,,0,0,0,,Мен сенімен сөйлесіп тұрмын. Токаку-сан?
Dialogue: 0,0:17:05.09,0:17:07.67,Default,,0,0,0,,Ол умен қапталған. Ха...
Dialogue: 0,0:17:07.67,0:17:11.68,Default,,0,0,0,,Қылышың дұрыс па? Ал...
Dialogue: 0,0:17:11.68,0:17:15.08,Default,,0,0,0,,Маған Ромеоны әкеліңізші.
Dialogue: 0,0:17:16.55,0:17:20.60,Default,,0,0,0,,Оған қол тигізбеңіз. ДДСҰ!? Онда кім бар?
Dialogue: 0,0:17:20.60,0:17:23.90,Default,,0,0,0,,У тұтқаға салынған. У...
Dialogue: 0,0:17:23.90,0:17:26.51,Default,,0,0,0,,Өйткені, Хицуги-чан...
Dialogue: 0,0:17:26.51,0:17:29.18,Default,,0,0,0,,О, Ромео Ромео➡
Dialogue: 0,0:17:29.18,0:17:31.98,Default,,0,0,0,,Сен неге Ромеосың?
Dialogue: 0,0:17:31.98,0:17:36.18,Default,,0,0,0,,Қаласаң, мен енді Ромео емеспін
Dialogue: 0,0:17:36.18,0:17:40.15,Default,,0,0,0,,Сенің ғашығың, бұл менің атым
Dialogue: 0,0:17:40.15,0:17:42.86,Default,,0,0,0,,Мұнда қалай келдіңіз?
Dialogue: 0,0:17:42.86,0:17:45.78,Default,,0,0,0,,≪Сол екі...≫
Dialogue: 0,0:17:45.78,0:17:48.08,Default,,0,0,0,,) ((О?))
Dialogue: 0,0:17:48.08,0:17:51.75,Default,,0,0,0,,)
Dialogue: 0,0:17:51.75,0:17:55.14,Default,,0,0,0,,)
Dialogue: 0,0:17:55.14,0:17:57.87,Default,,0,0,0,,≪Улы шақпақ... Қарғыс атсын! ≫
Dialogue: 0,0:17:57.87,0:18:02.04,Default,,0,0,0,,А, сенің көздерің әлдеқайда қорқынышты.
Dialogue: 0,0:18:02.04,0:18:05.61,Default,,0,0,0,,Күлімсіреңіз. (Барлығы) Эй!
Dialogue: 0,0:18:05.61,0:18:08.50,Default,,0,0,0,,Ичинозамен бірдеңе болды ма?
Dialogue: 0,0:18:08.50,0:18:12.10,Default,,0,0,0,,Не? Сіз Ичинозаға ескерту қағазын бердіңіз бе?
Dialogue: 0,0:18:14.84,0:18:18.54,Default,,0,0,0,,Қайтуыңызды өтінемін! Сен екеуміз жаумыз! ➡
Dialogue: 0,0:18:18.54,0:18:22.68,Default,,0,0,0,,Енді жоқ... (Сензу) Жоқ, олай болуы мүмкін емес!
Dialogue: 0,0:18:22.68,0:18:25.18,Default,,0,0,0,,Ромео Өте керемет!
Dialogue: 0,0:18:25.18,0:18:27.25,Default,,0,0,0,,≫(Таза махаббат баласы) Жүріс? Джульеттаға не болды?
Dialogue: 0,0:18:27.25,0:18:30.72,Default,,0,0,0,,Мен үшін қылыш ұстадың ба?
Dialogue: 0,0:18:30.72,0:18:34.91,Default,,0,0,0,,Ичиноза періште кернейі болуы мүмкін бе?
Dialogue: 0,0:18:34.91,0:18:38.55,Default,,0,0,0,,♬～
Dialogue: 0,0:18:38.55,0:18:40.58,Default,,0,0,0,,Әй, Сенсоку-сан!
Dialogue: 0,0:18:40.58,0:18:47.62,Default,,0,0,0,,♬～
Dialogue: 0,0:18:47.62,0:18:49.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:49.67,0:18:52.76,Default,,0,0,0,,♬～
Dialogue: 0,0:18:52.76,0:18:55.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:55.41,0:18:58.93,Default,,0,0,0,,Оған қол тигізбеңіз! Бұл улы!
Dialogue: 0,0:18:58.93,0:19:02.02,Default,,0,0,0,,У? Сізге маңызды емес
Dialogue: 0,0:19:02.02,0:19:06.14,Default,,0,0,0,,♬～
Dialogue: 0,0:19:06.14,0:19:08.48,Default,,0,0,0,,Кеттік
Dialogue: 0,0:19:08.48,0:19:11.44,Default,,0,0,0,,Сен сол қылышқа уландың ба?
Dialogue: 0,0:19:11.44,0:19:13.88,Default,,0,0,0,,Ичиноза періште керней ме?
Dialogue: 0,0:19:13.88,0:19:16.05,Default,,0,0,0,,Періште кернейі?
Dialogue: 0,0:19:16.05,0:19:19.10,Default,,0,0,0,,Ұстазымның қызын өлтірген адам➡
Dialogue: 0,0:19:19.10,0:19:21.57,Default,,0,0,0,,Сіз бе? иә?
Dialogue: 0,0:19:21.57,0:19:23.84,Default,,0,0,0,,≫(Джунико) Джульетта, сен не істеп жатырсың...
Dialogue: 0,0:19:23.84,0:19:29.15,Default,,0,0,0,,Кешіріңіз, анашым. Менің жүрегім әлдеқашан сол адамға тиесілі.
Dialogue: 0,0:19:29.15,0:19:32.65,Default,,0,0,0,,Киригая менің қолымды ластағанымды қаламады...
Dialogue: 0,0:19:35.22,0:19:39.61,Default,,0,0,0,,Айтайын, бұл театрлық қылыш емес.
Dialogue: 0,0:19:39.61,0:19:41.98,Default,,0,0,0,,Ах... Ичиноза
Dialogue: 0,0:19:41.98,0:19:44.83,Default,,0,0,0,,Жас келіншек жаман емес.
Dialogue: 0,0:19:44.83,0:19:48.00,Default,,0,0,0,,Иә? (Оқушы) А? Неліктен?
Dialogue: 0,0:19:48.00,0:19:51.18,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:19:51.18,0:19:56.34,Default,,0,0,0,,♬～
Dialogue: 0,0:19:56.34,0:19:59.54,Default,,0,0,0,,Осы жерде бол, сен мына жігіттің қасында амансың.
Dialogue: 0,0:19:59.54,0:20:02.74,Default,,0,0,0,,А... иә. Мынау... мына жігіт?
Dialogue: 0,0:20:05.58,0:20:08.77,Default,,0,0,0,,Мен сенің қарсыласыңмын. Жақсы.
Dialogue: 0,0:20:08.77,0:20:17.41,Default,,0,0,0,,♬～
Dialogue: 0,0:20:17.41,0:20:21.73,Default,,0,0,0,,Аа...｡ Жоқ, Ромео мырза бірбеткей.
Dialogue: 0,0:20:21.73,0:20:25.87,Default,,0,0,0,,Мен Джульетта үшін Тибалтпен күресетін сияқтымын.
Dialogue: 0,0:20:25.87,0:20:28.19,Default,,0,0,0,,Кинкин! Кинкин!
Dialogue: 0,0:20:28.19,0:20:31.27,Default,,0,0,0,,Мен оны кешірмеймін! Қамтқыңыз келсе➡
Dialogue: 0,0:20:31.27,0:20:35.25,Default,,0,0,0,,Сіз де мұны істегенше! Алдын ала ескертуге не болды?
Dialogue: 0,0:20:35.25,0:20:39.43,Default,,0,0,0,,Бұл маңызды емес! Неліктен сіз Ихинозаны нысанаға аласыз?
Dialogue: 0,0:20:39.43,0:20:42.34,Default,,0,0,0,,Менің мақсатым – періште кернейі
Dialogue: 0,0:20:42.34,0:20:45.81,Default,,0,0,0,,Бұл Ичиноза еді! ➡
Dialogue: 0,0:20:45.81,0:20:48.88,Default,,0,0,0,,Ха! Оның арқасында➡
Dialogue: 0,0:20:48.88,0:20:51.13,Default,,0,0,0,,Осы уақытқа дейін көптеген адамдар➡
Dialogue: 0,0:20:51.13,0:20:53.18,Default,,0,0,0,,Өлді! Гакин!
Dialogue: 0,0:20:53.18,0:20:55.35,Default,,0,0,0,,Ичиноза туралы не білесіз?
Dialogue: 0,0:20:55.35,0:20:58.44,Default,,0,0,0,,Ах... Қарғыс атсын.
Dialogue: 0,0:20:58.44,0:21:01.04,Default,,0,0,0,,Аяусыз улаушы➡
Dialogue: 0,0:21:01.04,0:21:04.41,Default,,0,0,0,,Мен сені кешіре алмаймын! У!?
Dialogue: 0,0:21:04.41,0:21:06.64,Default,,0,0,0,,Баки!
Dialogue: 0,0:21:06.64,0:21:08.64,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:21:10.18,0:21:21.81,Default,,0,0,0,,♬～
Dialogue: 0,0:21:21.81,0:21:26.20,Default,,0,0,0,,Хм... Кеше Кенмочи ойнаған Ичиноза емес пе?
Dialogue: 0,0:21:26.20,0:21:29.27,Default,,0,0,0,,Киригая туралы айтып тұрған жоқсыз ба?
Dialogue: 0,0:21:29.27,0:21:32.42,Default,,0,0,0,,Ах... Киригая?
Dialogue: 0,0:21:32.42,0:21:35.24,Default,,0,0,0,,Ненің негізінде!? Мен оны кеше көрдім.
Dialogue: 0,0:21:35.24,0:21:39.46,Default,,0,0,0,,Қылыш ұстаған Киригая болды! Бұл өтірік!
Dialogue: 0,0:21:39.46,0:21:42.35,Default,,0,0,0,,Бұл дұрыс. (2 адам) А.
Dialogue: 0,0:21:42.35,0:21:44.35,Default,,0,0,0,,Киригая?
Dialogue: 0,0:21:45.90,0:21:48.15,Default,,0,0,0,,Періште кернейі ➡
Dialogue: 0,0:21:48.15,0:21:50.17,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:21:50.17,0:21:53.59,Default,,0,0,0,,Не айтасыз...｡ Менің жоспарым➡
Dialogue: 0,0:21:53.59,0:21:55.81,Default,,0,0,0,,Ичиноза-сан сахнада➡
Dialogue: 0,0:21:55.81,0:21:58.80,Default,,0,0,0,,Сіз айтқандай, мен өлуім керек еді.
Dialogue: 0,0:21:58.80,0:22:02.63,Default,,0,0,0,,Сонда қылышқа уды кім салды...
Dialogue: 0,0:22:02.63,0:22:05.69,Default,,0,0,0,,Бұл менмін. Сондықтан➡
Dialogue: 0,0:22:05.69,0:22:09.84,Default,,0,0,0,,Сендзоку-санның Азума-санмен жекпе-жекке шығуына ешқандай себеп жоқ.
Dialogue: 0,0:22:09.84,0:22:11.88,Default,,0,0,0,,Киригая…
Dialogue: 0,0:22:11.88,0:22:16.48,Default,,0,0,0,,Енді қайтайық. Көрермендер сізді күтуде.
Dialogue: 0,0:22:20.68,0:22:24.55,Default,,0,0,0,,Егер сіз бұл дәріні қабылдасаңыз, сіз тоқтатылған анимация күйіне өтесіз...
Dialogue: 0,0:22:24.55,0:22:29.54,Default,,0,0,0,,Бұл маңызды емес. Әке, оны маған бер.
Dialogue: 0,0:22:29.54,0:22:33.01,Default,,0,0,0,,Бұл екеуі жау болды...
Dialogue: 0,0:22:33.01,0:22:35.55,Default,,0,0,0,,Татуласпаймыз ба?
Dialogue: 0,0:22:35.55,0:22:39.60,Default,,0,0,0,,Менің ойымша, бұл мүмкін емес. Ол да өлтіруші.
Dialogue: 0,0:22:39.60,0:22:43.04,Default,,0,0,0,,≫(Нидзи) 42 сағаттан кейін сіз жақсы ұйықтайсыз➡
Dialogue: 0,0:22:43.04,0:22:45.86,Default,,0,0,0,,≫Оянғандай жаңғыру
Dialogue: 0,0:22:45.86,0:22:58.25,Default,,0,0,0,,♬～
Dialogue: 0,0:22:58.25,0:23:00.61,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:23:00.61,0:23:04.74,Default,,0,0,0,,♬～
Dialogue: 0,0:23:04.74,0:23:07.40,Default,,0,0,0,,Өз миссияңызды орындаңыз
Dialogue: 0,0:23:07.40,0:23:10.30,Default,,0,0,0,,Ромео Егер бұл сіз үшін болса...
Dialogue: 0,0:23:11.74,0:23:14.84,Default,,0,0,0,,Әй, Ромео!
Dialogue: 0,0:23:14.84,0:23:17.24,Default,,0,0,0,,Уау! (Оқушы) Керемет!
Dialogue: 0,0:23:17.24,0:23:19.24,Default,,0,0,0,,Құрметті Ромео!
Dialogue: 0,0:23:21.09,0:23:23.15,Default,,0,0,0,,Мұны таптым
Dialogue: 0,0:23:23.15,0:23:27.78,Default,,0,0,0,,♬～
Dialogue: 0,0:23:27.78,0:23:30.05,Default,,0,0,0,,Енді түсіндің, солай ма?
Dialogue: 0,0:23:30.05,0:23:32.47,Default,,0,0,0,,Сен екеуміз жаумыз
Dialogue: 0,0:23:32.47,0:23:35.01,Default,,0,0,0,,Ақыр соңында, тағдыр таусылмайтын
Dialogue: 0,0:23:35.01,0:23:37.21,Default,,0,0,0,,Сонда мұны істеудің жалғыз жолы осы!
Dialogue: 0,0:23:38.61,0:23:40.63,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:23:40.63,0:23:48.04,Default,,0,0,0,,♬～
Dialogue: 0,0:23:48.04,0:23:50.42,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:23:50.42,0:23:54.61,Default,,0,0,0,,♬～
Dialogue: 0,0:23:54.61,0:23:57.91,Default,,0,0,0,,Бұл менің рөлім.
Dialogue: 0,0:23:59.45,0:24:02.45,Default,,0,0,0,,Жақсы, Сенсоку-сан.
Dialogue: 0,0:24:04.52,0:24:06.54,Default,,0,0,0,,Гусса
Dialogue: 0,0:24:06.54,0:24:08.58,Default,,0,0,0,,Ах...｡ Уф!
Dialogue: 0,0:24:08.58,0:24:13.68,Default,,0,0,0,,♬～
Dialogue: 0,0:24:13.68,0:24:16.18,Default,,0,0,0,,Мынау...табыт...
Dialogue: 0,0:24:16.18,0:24:19.65,Default,,0,0,0,,Джульеттаның қалаған нәрсесі Ромео болды.
Dialogue: 0,0:24:19.65,0:24:22.77,Default,,0,0,0,,♬～
Dialogue: 0,0:24:22.77,0:24:25.24,Default,,0,0,0,,Барлығы аяқталғанда, сізбен➡
Dialogue: 0,0:24:25.24,0:24:27.91,Default,,0,0,0,,Ол осы жерден кетуді жоспарлап отырғанын айтты.➡
Dialogue: 0,0:24:27.91,0:24:30.76,Default,,0,0,0,,Бала шынымен қалаған нәрсе болды➡
Dialogue: 0,0:24:30.76,0:24:33.42,Default,,0,0,0,,Бұл сен едің.
Dialogue: 0,0:24:33.42,0:24:35.44,Default,,0,0,0,,Бұл...
Dialogue: 0,0:24:35.44,0:24:41.56,Default,,0,0,0,,♬～
Dialogue: 0,0:24:41.56,0:24:45.81,Default,,0,0,0,,Мен сен туралы ештеңе білмедім.
Dialogue: 0,0:24:45.81,0:24:59.63,Default,,0,0,0,,♬～
Dialogue: 0,0:24:59.63,0:25:01.68,Default,,0,0,0,,Демек, ойлағанымдай…
Dialogue: 0,0:25:01.68,0:25:05.28,Default,,0,0,0,,♬～
Dialogue: 0,0:25:05.28,0:25:09.69,Default,,0,0,0,,Мен хат жібергім келеді…
Dialogue: 0,0:25:09.69,0:25:13.04,Default,,0,0,0,,♬～
Dialogue: 0,0:25:13.04,0:25:16.41,Default,,0,0,0,,Бұл қызықты болды! (Оқушы) Соңында жыладым. Мен жыладым.
Dialogue: 0,0:25:16.41,0:25:19.25,Default,,0,0,0,,Мен сені шынымен өлді деп ойладым.
Dialogue: 0,0:25:19.25,0:25:38.85,Default,,0,0,0,,♬～
Dialogue: 0,0:25:40.15,0:25:43.54,Default,,0,0,0,,♬ Сіздермен бірге
Dialogue: 0,0:25:43.54,0:25:46.61,Default,,0,0,0,,♬ Тіпті трагедия
Dialogue: 0,0:25:46.61,0:25:54.01,Default,,0,0,0,,♬ Романсқа айналу
Dialogue: 0,0:25:56.18,0:26:02.04,Default,,0,0,0,,♬ Мен сені алғаш көрген сәттен бастап
Dialogue: 0,0:26:02.04,0:26:08.44,Default,,0,0,0,,♬ Мен жынды бола бастадым.
Dialogue: 0,0:26:09.76,0:26:12.65,Default,,0,0,0,,♬ Өткен және қазіргі
Dialogue: 0,0:26:12.65,0:26:15.82,Default,,0,0,0,,♬ Болашақ және бәрі
Dialogue: 0,0:26:15.82,0:26:22.54,Default,,0,0,0,,♬ Мен оны жәшікке салып, өртеп жіберсем.
Dialogue: 0,0:26:22.54,0:26:25.98,Default,,0,0,0,,♬ Тіпті періштелер де бейкүнә күледі
Dialogue: 0,0:26:25.98,0:26:29.73,Default,,0,0,0,,♬ Шайтанға айналғандай
Dialogue: 0,0:26:29.73,0:26:33.27,Default,,0,0,0,,♬ Ондай дүниемен қоштас
Dialogue: 0,0:26:33.27,0:26:36.87,Default,,0,0,0,,♬ Тозаққа барайық
Dialogue: 0,0:26:38.84,0:26:42.41,Default,,0,0,0,,♬ Ұстаған қолымыз суып қалады
Dialogue: 0,0:26:42.41,0:26:46.68,Default,,0,0,0,,♬ Енді сіз шынымен біреу бола аласыз
Dialogue: 0,0:26:46.68,0:26:52.67,Default,,0,0,0,,♬ Тәнді жейтін удың өзі қымбат
Dialogue: 0,0:26:52.67,0:26:56.28,Default,,0,0,0,,♬ Кеудені тесіп өтетін жүз
Dialogue: 0,0:26:56.28,0:27:00.41,Default,,0,0,0,,♬ Бізді ажыратпаймын
Dialogue: 0,0:27:00.41,0:27:07.61,Default,,0,0,0,,♬ Мен бұл өмірді бергенше
Dialogue: 0,0:28:40.75,0:28:42.90,Default,,0,0,0,,Қарбызды бөлудің ресми ережелері бар➡
Dialogue: 0,0:28:42.90,0:28:46.49,Default,,0,0,0,,Тіпті соңғы тазарту да қарастырылған сияқты.➡
Dialogue: 0,0:28:46.49,0:28:50.94,Default,,0,0,0,,Шынайы ма? Үйге жеткенше далаға барудан еш айырмашылығы жоқ.➡
Dialogue: 0,0:28:50.94,0:28:53.54,Default,,0,0,0,,Жақсы, мен соңғы кездері қарбыз жеген жоқпын.
Dialogue: 0,0:28:54.98,0:28:57.01,Default,,0,0,0,,«Куругуми үй бөлмесі»!
Dialogue: 0,0:28:57.01,0:28:59.12,Default,,0,0,0,,♬ Хехехехехехе («Кеше, бүгін, ертең» деп шуылдау)
Dialogue: 0,0:28:59.12,0:29:01.62,Default,,0,0,0,,Не? Мен күлгенім үшін жаман сезінемін
Dialogue: 0,0:29:01.62,0:29:05.15,Default,,0,0,0,,Өйткені мен өте бақыттымын! Хару Тачи➡ әндері бар CD
Dialogue: 0,0:29:05.15,0:29:07.19,Default,,0,0,0,,Ол сатылымда. Ах!
Dialogue: 0,0:29:07.19,0:29:10.78,Default,,0,0,0,,Ерм, Токакудың әні де қосылғанына сенімдімін.
Dialogue: 0,0:29:10.78,0:29:13.83,Default,,0,0,0,,♬ Күшіңді пайдалан, эй, тоқта!
Dialogue: 0,0:29:13.83,0:29:16.92,Default,,0,0,0,,Хехе, Токаку-сан, сен ұялшақсың.
Dialogue: 0,0:29:16.92,0:29:19.55,Default,,0,0,0,,«Шайтанның жұмбақ» кейіпкерлері аяқталатын тақырып жинағы➡
Dialogue: 0,0:29:19.55,0:29:22.24,Default,,0,0,0,,Мамыр айынан бастап 3 ай қатарынан сатылымға шығады➡
Dialogue: 0,0:29:22.24,0:29:24.94,Default,,0,0,0,,Рахмет! Менің әнім ғана емес➡
Dialogue: 0,0:29:24.94,0:29:27.34,Default,,0,0,0,,Оған сол қара топтағы жігіттердің әндері де кіреді.
Dialogue: 0,0:29:27.34,0:29:29.84,Default,,0,0,0,,Ән айтқан жалғыз мен емес!
Dialogue: 0,0:29:31.34,0:29:37.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory