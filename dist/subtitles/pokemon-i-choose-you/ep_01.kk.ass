Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.05,0:00:18.01,Default,,0,0,0,,Пика Пикачу
Dialogue: 0,0:00:26.56,0:00:30.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:30.19,0:00:31.99,Default,,0,0,0,,Покемон Лигасының финалы:
Dialogue: 0,0:00:32.07,0:00:34.91,Default,,0,0,0,,Бұл қызу шайқасқа айналуда.
Dialogue: 0,0:00:39.41,0:00:41.12,Default,,0,0,0,,Генгар жалтарып кетті
Dialogue: 0,0:00:44.00,0:00:45.88,Default,,0,0,0,,Тасбақа
Dialogue: 0,0:00:46.50,0:00:47.88,Default,,0,0,0,,Гех... Гех
Dialogue: 0,0:00:47.96,0:00:50.09,Default,,0,0,0,,Міне, Түнгі бас.
Dialogue: 0,0:00:50.76,0:00:51.84,Default,,0,0,0,,Blastoise шыдады
Dialogue: 0,0:00:51.84,0:00:53.72,Default,,0,0,0,,Жарылуға шыдады Гарме!
Dialogue: 0,0:00:53.80,0:00:56.01,Default,,0,0,0,,Эй, бұл Рейто Бим.
Dialogue: 0,0:00:56.09,0:00:58.72,Default,,0,0,0,,Мен тоңып қалдым. Не істеуім керек?
Dialogue: 0,0:01:01.27,0:01:02.85,Default,,0,0,0,,Ойын!
Dialogue: 0,0:01:06.73,0:01:08.90,Default,,0,0,0,,Келесі Покемон...
Dialogue: 0,0:01:10.78,0:01:13.15,Default,,0,0,0,,Бұл Фушигибана!
Dialogue: 0,0:01:13.24,0:01:13.99,Default,,0,0,0,,Банан
Dialogue: 0,0:01:13.99,0:01:14.40,Default,,0,0,0,,Жапырақ кескішпен банан шабуылы
Dialogue: 0,0:01:14.40,0:01:15.99,Default,,0,0,0,,Жапырақ кескішпен шабуыл
Dialogue: 0,0:01:16.07,0:01:17.28,Default,,0,0,0,,Тасбақа
Dialogue: 0,0:01:18.57,0:01:20.08,Default,,0,0,0,,Ойын ойыны!
Dialogue: 0,0:01:20.41,0:01:23.50,Default,,0,0,0,,Blastoise Hydro Pump Тікелей соққы!
Dialogue: 0,0:01:23.58,0:01:24.58,Default,,0,0,0,,Бана!
Dialogue: 0,0:01:24.83,0:01:26.71,Default,,0,0,0,,Ойыншы!
Dialogue: 0,0:01:28.71,0:01:30.29,Default,,0,0,0,,Ууууууууууууу
Dialogue: 0,0:01:30.38,0:01:33.21,Default,,0,0,0,,Күштердің соқтығысуы, тараптардың ешқайсысы да бір дюймге көнбейді
Dialogue: 0,0:01:33.21,0:01:35.13,Default,,0,0,0,,Күштердің қақтығысы, екеуі де бір дюймді беруден бас тартты...
Dialogue: 0,0:01:37.59,0:01:39.76,Default,,0,0,0,,О, бұл таңқаларлық.
Dialogue: 0,0:01:39.85,0:01:40.18,Default,,0,0,0,,Тамаша, салқын таң, иә?
Dialogue: 0,0:01:40.18,0:01:41.93,Default,,0,0,0,,Керемет (әңгімелеу) Масала қаласынан келген Сатоши бала
Dialogue: 0,0:01:41.93,0:01:42.47,Default,,0,0,0,,Бұл Масала қаласындағы Сатоши бала
Dialogue: 0,0:01:42.68,0:01:43.06,Default,,0,0,0,,Жүр! жақсы!
Dialogue: 0,0:01:43.06,0:01:45.48,Default,,0,0,0,,Жүр! жақсы! Ертең мен 10 жасымды тойлаймын
Dialogue: 0,0:01:45.48,0:01:46.02,Default,,0,0,0,,Ертең мен 10 жасымды тойлаймын.
Dialogue: 0,0:01:46.10,0:01:46.48,Default,,0,0,0,,Мен 10 жасқа толғанда, осы қалада—
Dialogue: 0,0:01:46.48,0:01:47.48,Default,,0,0,0,,Мен 10 жасқа толғанда, осы қалада...
Dialogue: 0,0:01:47.48,0:01:48.02,Default,,0,0,0,,Мен 10 жасқа толғанда, осы қалада—
Dialogue: 0,0:01:48.10,0:01:50.69,Default,,0,0,0,,Покемонды зерттеуші профессор Оактан — А... мінекей!
Dialogue: 0,0:01:50.77,0:01:55.99,Default,,0,0,0,,Бастаушы покемон Bulbasaur Charmander Squirtle —
Dialogue: 0,0:01:56.07,0:01:57.74,Default,,0,0,0,,Олардың біреуін алыңыз—
Dialogue: 0,0:01:57.82,0:01:58.07,Default,,0,0,0,,Покемон жаттықтырушысы ретінде саяхатқа шығыңыз.
Dialogue: 0,0:01:58.07,0:01:59.87,Default,,0,0,0,,Покемон жаттықтырушысы ретінде саяхатқа шығыңыз!
Dialogue: 0,0:01:59.87,0:02:00.95,Default,,0,0,0,,Покемон жаттықтырушысы ретінде саяхатқа шығыңыз.
Dialogue: 0,0:02:03.54,0:02:05.16,Default,,0,0,0,,(Сатоши ұйқысы)
Dialogue: 0,0:02:05.25,0:02:09.25,Default,,0,0,0,,Булбасар... Шармандер...
Dialogue: 0,0:02:09.79,0:02:12.13,Default,,0,0,0,,Сквирт...
Dialogue: 0,0:02:13.05,0:02:14.46,Default,,0,0,0,,Бұл не? Мен қайдамын?
Dialogue: 0,0:02:16.30,0:02:19.34,Default,,0,0,0,,Мен сені таңдадым (бұзылған дыбыс)
Dialogue: 0,0:02:19.80,0:02:21.93,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,0:02:24.47,0:02:27.10,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:02:31.19,0:02:33.11,Default,,0,0,0,,Сатоси, сен қанша ұйықтайсың?
Dialogue: 0,0:02:33.65,0:02:36.11,Default,,0,0,0,,Мен Окидо институтына кешігіп барамын.
Dialogue: 0,0:02:36.19,0:02:39.03,Default,,0,0,0,,Окидо ғылыми-зерттеу институты... Ha...
Dialogue: 0,0:02:39.11,0:02:40.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:40.78,0:02:42.78,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:02:42.87,0:02:45.62,Default,,0,0,0,,Мама, неге мені оятпадың?
Dialogue: 0,0:02:46.16,0:02:48.96,Default,,0,0,0,,Сіз 10-ға толғанда өзіңіз тұрамын дедіңіз ғой?
Dialogue: 0,0:02:49.04,0:02:50.29,Default,,0,0,0,,Ой... ааа ааа
Dialogue: 0,0:02:50.37,0:02:53.38,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:02:54.34,0:02:56.80,Default,,0,0,0,,Мен мұнда отырып ауа оғын атып, оны дәл тигізе алар едім
Dialogue: 0,0:02:58.80,0:03:01.22,Default,,0,0,0,,(Мадацубоми мен Назонокуса дыбысы)
Dialogue: 0,0:03:01.30,0:03:02.51,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:03:02.60,0:03:05.18,Default,,0,0,0,,Әй, доктор Оак.
Dialogue: 0,0:03:05.26,0:03:06.72,Default,,0,0,0,,О, Сатоши-кун
Dialogue: 0,0:03:07.18,0:03:09.48,Default,,0,0,0,,Менің... Покемоным ше?
Dialogue: 0,0:03:09.56,0:03:13.02,Default,,0,0,0,,Иә? Әй, бүгін төрт адам кетіп бара жатыр деп естідім...
Dialogue: 0,0:03:13.11,0:03:14.73,Default,,0,0,0,,Сіз соңғысысыз ба?
Dialogue: 0,0:03:16.69,0:03:19.86,Default,,0,0,0,,Мен... Мен көпке дейін екілендім, бірақ шештім.
Dialogue: 0,0:03:19.95,0:03:22.62,Default,,0,0,0,,Сквирт Мен сені Покемон ретінде таңдадым.
Dialogue: 0,0:03:22.70,0:03:25.83,Default,,0,0,0,,Сквиртті кешікпеген бала алды.
Dialogue: 0,0:03:25.91,0:03:27.12,Default,,0,0,0,,Зени
Dialogue: 0,0:03:28.75,0:03:31.58,Default,,0,0,0,,Хаа... Кешігіп келгеніме мен кінәлімін.
Dialogue: 0,0:03:31.67,0:03:33.67,Default,,0,0,0,,Олай болса, Бұлбасар, мен сені таңдадым.
Dialogue: 0,0:03:34.21,0:03:36.75,Default,,0,0,0,,Уақытында келген бала да алды.
Dialogue: 0,0:03:36.84,0:03:37.96,Default,,0,0,0,,Дания
Dialogue: 0,0:03:39.88,0:03:43.43,Default,,0,0,0,,Я, Чармандер, сен мен таңдаған Покемонсың.
Dialogue: 0,0:03:43.93,0:03:47.43,Default,,0,0,0,,Қала маңындағы пойыз немесе Покемон болсын, бір секундтық кешігу өміріңізді өзгертуі мүмкін.
Dialogue: 0,0:03:47.51,0:03:48.68,Default,,0,0,0,,Өзгертіңіз!
Dialogue: 0,0:03:48.77,0:03:49.98,Default,,0,0,0,,Кейдж
Dialogue: 0,0:03:51.35,0:03:52.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:53.27,0:03:57.44,Default,,0,0,0,,А... Сонда мен покемонсыз саяхатқа шығайын ба?
Dialogue: 0,0:03:57.52,0:03:59.86,Default,,0,0,0,,Тағы біреуі болса ғой...
Dialogue: 0,0:03:59.94,0:04:01.36,Default,,0,0,0,,А, маған берші.
Dialogue: 0,0:04:01.45,0:04:05.20,Default,,0,0,0,,Қалған Покемонға қатысты мәселе бар...
Dialogue: 0,0:04:05.28,0:04:06.28,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:06.37,0:04:08.62,Default,,0,0,0,,Менің кешігіп жатқанымда да бір мәселе бар.
Dialogue: 0,0:04:08.70,0:04:09.70,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:04:11.12,0:04:12.71,Default,,0,0,0,,Көп емес, бірақ… міне.
Dialogue: 0,0:04:13.29,0:04:16.13,Default,,0,0,0,,Менің... менің Покемоным!
Dialogue: 0,0:04:17.67,0:04:19.96,Default,,0,0,0,,А, гага...
Dialogue: 0,0:04:20.05,0:04:22.22,Default,,0,0,0,,Уф... уф хаааааааа...
Dialogue: 0,0:04:23.30,0:04:25.14,Default,,0,0,0,,Ооо Пика
Dialogue: 0,0:04:25.22,0:04:26.22,Default,,0,0,0,,Ахх!
Dialogue: 0,0:04:26.55,0:04:29.85,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:30.72,0:04:31.73,Default,,0,0,0,,Пии
Dialogue: 0,0:04:32.39,0:04:33.89,Default,,0,0,0,,Пеккачу
Dialogue: 0,0:04:33.98,0:04:36.23,Default,,0,0,0,,Пикачу деген Покемон бар.
Dialogue: 0,0:04:36.31,0:04:37.94,Default,,0,0,0,,Әй, сүйкімді ча~
Dialogue: 0,0:04:38.02,0:04:39.61,Default,,0,0,0,,Ең жақсысы емес пе?
Dialogue: 0,0:04:39.69,0:04:42.11,Default,,0,0,0,,Солай ма? Бұл дұрыс
Dialogue: 0,0:04:42.19,0:04:45.74,Default,,0,0,0,,Менің атым Сатоши. Танысқаныма қуаныштымын, Пикачу.
Dialogue: 0,0:04:45.99,0:04:46.99,Default,,0,0,0,,Pi... ой
Dialogue: 0,0:04:47.07,0:04:48.12,Default,,0,0,0,,Пика…
Dialogue: 0,0:04:49.33,0:04:50.79,Default,,0,0,0,,Шайнаңыз! Уау...
Dialogue: 0,0:04:51.25,0:04:53.00,Default,,0,0,0,,«электрлік тінтуір» ретінде де белгілі
Dialogue: 0,0:04:53.08,0:04:55.29,Default,,0,0,0,,Ұялшақ, адамдарға үйрену қиын.
Dialogue: 0,0:04:55.37,0:04:58.50,Default,,0,0,0,,Егер сіз оны нашар ұстасаңыз, солай болады.
Dialogue: 0,0:04:58.59,0:05:00.75,Default,,0,0,0,,Пика Хмм
Dialogue: 0,0:05:00.84,0:05:02.30,Default,,0,0,0,,Бұл Хетчара.
Dialogue: 0,0:05:02.72,0:05:06.89,Default,,0,0,0,,Онда бұл Пикачу құбыжық добы.
Dialogue: 0,0:05:07.55,0:05:10.14,Default,,0,0,0,,Уау, көп рахмет.
Dialogue: 0,0:05:10.22,0:05:11.31,Default,,0,0,0,,Сатоси иә?
Dialogue: 0,0:05:12.18,0:05:15.85,Default,,0,0,0,,Покемонды алғаннан кейін кетуді жоспарлағансыз, солай ма?
Dialogue: 0,0:05:16.10,0:05:17.52,Default,,0,0,0,,...
Dialogue: 0,0:05:22.36,0:05:23.36,Default,,0,0,0,,Иә
Dialogue: 0,0:05:23.65,0:05:28.03,Default,,0,0,0,,Иә, мен көйлек, шалбар, сүлгі, тіс щеткасы және ұйықтайтын қапшықты жинадым.
Dialogue: 0,0:05:28.12,0:05:29.87,Default,,0,0,0,,Жарайды, кеттік, Пикачу.
Dialogue: 0,0:05:30.24,0:05:31.24,Default,,0,0,0,,Қарау...
Dialogue: 0,0:05:31.33,0:05:32.70,Default,,0,0,0,,Иә? Покемондар қалыпты.
Dialogue: 0,0:05:32.79,0:05:34.41,Default,,0,0,0,,Бұл құбыжық допта, солай ма?
Dialogue: 0,0:05:34.50,0:05:36.04,Default,,0,0,0,,Аа, әрине.
Dialogue: 0,0:05:36.46,0:05:38.25,Default,,0,0,0,,Пикачу, кір.
Dialogue: 0,0:05:38.33,0:05:40.46,Default,,0,0,0,,Пика, иә?
Dialogue: 0,0:05:41.67,0:05:43.63,Default,,0,0,0,,Кіріңіз, Пика.
Dialogue: 0,0:05:45.63,0:05:46.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:46.72,0:05:47.38,Default,,0,0,0,,Негізі бұл Пикачу құбыжық допқа кіреді.
Dialogue: 0,0:05:47.38,0:05:48.72,Default,,0,0,0,,Негізі бұл Пикачу құбыжық допқа кіреді... Ча~
Dialogue: 0,0:05:48.72,0:05:49.55,Default,,0,0,0,,Шын мәнінде, бұл Пикачу құбыжық допқа кіреді.
Dialogue: 0,0:05:49.64,0:05:50.97,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:05:51.06,0:05:52.81,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:53.39,0:05:54.73,Default,,0,0,0,,Кіріңіз!
Dialogue: 0,0:05:54.81,0:05:56.64,Default,,0,0,0,,Дыбыс... Жарайды...
Dialogue: 0,0:05:57.10,0:05:58.27,Default,,0,0,0,,...
Dialogue: 0,0:05:58.73,0:05:59.94,Default,,0,0,0,,Ho ho ho bip сигналы
Dialogue: 0,0:06:00.02,0:06:01.02,Default,,0,0,0,,Өте керемет...
Dialogue: 0,0:06:01.82,0:06:03.53,Default,,0,0,0,,Пикачу
Dialogue: 0,0:06:03.86,0:06:07.70,Default,,0,0,0,,Ендеше, біз көп аулап ойнасақ, соғұрлым жақсы араласамыз.
Dialogue: 0,0:06:07.78,0:06:08.78,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:06:09.07,0:06:10.82,Default,,0,0,0,,Пикачу екеуміз доспыз.
Dialogue: 0,0:06:10.91,0:06:12.03,Default,,0,0,0,,О, о... Не?
Dialogue: 0,0:06:12.12,0:06:13.54,Default,,0,0,0,,Пикер…
Dialogue: 0,0:06:13.62,0:06:16.71,Default,,0,0,0,,Шайнаңыз! (Сатоши мен оның достары айқайлайды)
Dialogue: 0,0:06:23.00,0:06:24.05,Default,,0,0,0,,Хаа…
Dialogue: 0,0:06:24.13,0:06:25.76,Default,,0,0,0,,Ча~ Сіз білесіз бе...
Dialogue: 0,0:06:25.84,0:06:27.67,Default,,0,0,0,,Осы күйде мәңгі қалғың келе ме?
Dialogue: 0,0:06:28.18,0:06:29.18,Default,,0,0,0,,Пикер
Dialogue: 0,0:06:29.93,0:06:31.18,Default,,0,0,0,,Хаа…
Dialogue: 0,0:06:32.10,0:06:34.01,Default,,0,0,0,,Сен мені жек көресің бе?
Dialogue: 0,0:06:34.10,0:06:35.60,Default,,0,0,0,,Пика Пика
Dialogue: 0,0:06:35.97,0:06:38.64,Default,,0,0,0,,Мен сені сүйемін, Пика.
Dialogue: 0,0:06:38.73,0:06:41.27,Default,,0,0,0,,Қалай болғанда да, мен жақсы араласқым келеді.
Dialogue: 0,0:06:41.36,0:06:43.11,Default,,0,0,0,,Пи... Осыны тоқтатайық.
Dialogue: 0,0:06:43.98,0:06:45.15,Default,,0,0,0,,Пика?
Dialogue: 0,0:06:45.86,0:06:47.53,Default,,0,0,0,,Қол алысу
Dialogue: 0,0:06:47.95,0:06:48.95,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:06:49.61,0:06:51.12,Default,,0,0,0,,Аа, мен қиналып қалдым...
Dialogue: 0,0:06:51.20,0:06:52.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:52.49,0:06:54.49,Default,,0,0,0,,(Поппоның айқайы)
Dialogue: 0,0:06:54.79,0:06:56.16,Default,,0,0,0,,Әй, Поппо.
Dialogue: 0,0:06:56.25,0:06:57.62,Default,,0,0,0,,Жарайсың ба, Пика?
Dialogue: 0,0:06:58.04,0:07:01.38,Default,,0,0,0,,Бірінші ұстау Бұл Покемон шебері болудың алғашқы қадамы.
Dialogue: 0,0:07:01.46,0:07:03.42,Default,,0,0,0,,Құбыжық допқа барыңыз
Dialogue: 0,0:07:04.38,0:07:05.59,Default,,0,0,0,,Попоп
Dialogue: 0,0:07:07.80,0:07:08.80,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:07:12.72,0:07:14.81,Default,,0,0,0,,(Поппоның айқайы)
Dialogue: 0,0:07:14.89,0:07:16.81,Default,,0,0,0,,Ах, Пикачу
Dialogue: 0,0:07:16.89,0:07:19.10,Default,,0,0,0,,Оны алу үшін сізге Покемон шайқасы қажет.
Dialogue: 0,0:07:19.18,0:07:21.31,Default,,0,0,0,,Пикачу Пикаға барыңыз
Dialogue: 0,0:07:21.40,0:07:23.23,Default,,0,0,0,,А... ынтымақтаспайсың ба?
Dialogue: 0,0:07:23.31,0:07:25.07,Default,,0,0,0,,Пикачу Жарайды.
Dialogue: 0,0:07:25.15,0:07:26.15,Default,,0,0,0,,Сонда мен... Пи?
Dialogue: 0,0:07:28.40,0:07:30.24,Default,,0,0,0,,Ei (жарылған дыбыс)
Dialogue: 0,0:07:32.28,0:07:33.74,Default,,0,0,0,,Aa
Dialogue: 0,0:07:34.24,0:07:36.37,Default,,0,0,0,,Жапон торғайы Пи… Пика
Dialogue: 0,0:07:36.62,0:07:37.74,Default,,0,0,0,,Ах (Пикачу күлкісі)
Dialogue: 0,0:07:38.29,0:07:40.21,Default,,0,0,0,,Жылтыр
Dialogue: 0,0:07:41.25,0:07:42.88,Default,,0,0,0,,Эй, Польнареф
Dialogue: 0,0:07:43.08,0:07:44.33,Default,,0,0,0,,Pi? Ааааааааааааааааааааааааа
Dialogue: 0,0:07:44.42,0:07:45.71,Default,,0,0,0,,Пика? Ахх
Dialogue: 0,0:07:45.79,0:07:47.55,Default,,0,0,0,,Дыбыстық сигнал...
Dialogue: 0,0:07:47.63,0:07:50.55,Default,,0,0,0,,Шайнаңыз! (Жапон торғайының айқайы)
Dialogue: 0,0:07:51.05,0:07:52.05,Default,,0,0,0,,Пикер
Dialogue: 0,0:07:55.18,0:07:56.89,Default,,0,0,0,,(Жапон торғайларының дыбыстары)
Dialogue: 0,0:07:57.22,0:07:58.27,Default,,0,0,0,,Пит а
Dialogue: 0,0:07:58.72,0:08:02.23,Default,,0,0,0,,(Жапон торғайларының дыбыстары)
Dialogue: 0,0:08:02.81,0:08:04.52,Default,,0,0,0,,Ха, қаш, Пикачу.
Dialogue: 0,0:08:04.61,0:08:06.02,Default,,0,0,0,,Пика Ах
Dialogue: 0,0:08:06.11,0:08:07.90,Default,,0,0,0,,(Жапон торғайларының дыбыстары)
Dialogue: 0,0:08:09.82,0:08:11.40,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:08:11.49,0:08:14.16,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:08:14.41,0:08:17.87,Default,,0,0,0,,Пика Пика Пикачу
Dialogue: 0,0:08:17.95,0:08:22.25,Default,,0,0,0,,Тоқта. Тас лақтырған мен болдым. Егер сіз шабуыл жасағыңыз келсе, оны маған жасаңыз.
Dialogue: 0,0:08:22.33,0:08:24.33,Default,,0,0,0,,(Жапон торғайларының дыбыстары)
Dialogue: 0,0:08:24.79,0:08:27.25,Default,,0,0,0,,(Сатошидің ыңырануы)
Dialogue: 0,0:08:27.34,0:08:29.46,Default,,0,0,0,,Пи… Ка… Чу…
Dialogue: 0,0:08:29.55,0:08:31.97,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:08:32.05,0:08:34.55,Default,,0,0,0,,(Жапон торғайларының дыбыстары)
Dialogue: 0,0:08:38.72,0:08:39.72,Default,,0,0,0,,Әй
Dialogue: 0,0:08:45.94,0:08:48.11,Default,,0,0,0,,(Гярадос ырылдады)
Dialogue: 0,0:08:48.86,0:08:50.78,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:08:53.86,0:08:55.28,Default,,0,0,0,,Амансың ба? пикачу
Dialogue: 0,0:08:55.49,0:08:57.78,Default,,0,0,0,,Pi… Ka… Pi…
Dialogue: 0,0:08:59.12,0:09:00.45,Default,,0,0,0,,Ах
Dialogue: 0,0:09:00.74,0:09:03.79,Default,,0,0,0,,(Жапон торғайларының дыбыстары)
Dialogue: 0,0:09:05.79,0:09:08.17,Default,,0,0,0,,Пикачу, мен сені міндетті түрде қорғаймын.
Dialogue: 0,0:09:08.84,0:09:10.09,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:09:10.59,0:09:12.80,Default,,0,0,0,,Пикер…
Dialogue: 0,0:09:14.01,0:09:17.39,Default,,0,0,0,,(Найзағай мен жапон торғайларының айқайы)
Dialogue: 0,0:09:17.84,0:09:20.39,Default,,0,0,0,,(Сатошидің ыңырсыуы)
Dialogue: 0,0:09:21.56,0:09:24.06,Default,,0,0,0,,Ааа! уф... уф
Dialogue: 0,0:09:25.98,0:09:27.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:28.65,0:09:29.65,Default,,0,0,0,,Пикачу
Dialogue: 0,0:09:32.28,0:09:34.07,Default,,0,0,0,,Ka… Pi… Ka…
Dialogue: 0,0:09:34.74,0:09:36.15,Default,,0,0,0,,Пикачу...
Dialogue: 0,0:09:36.99,0:09:38.57,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:09:39.41,0:09:41.08,Default,,0,0,0,,Pi… Ka…
Dialogue: 0,0:09:47.87,0:09:50.34,Default,,0,0,0,,Пикачу мұны осыған қойды
Dialogue: 0,0:09:50.42,0:09:51.92,Default,,0,0,0,,Pi… Ka…
Dialogue: 0,0:09:52.50,0:09:55.55,Default,,0,0,0,,Сенің мұнда болу ұнамайтынын білемін.
Dialogue: 0,0:09:55.97,0:09:59.55,Default,,0,0,0,,Бірақ егер сіз кірсеңіз, сізді құтқаруыңыз мүмкін.
Dialogue: 0,0:10:00.26,0:10:02.10,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:10:02.56,0:10:03.93,Default,,0,0,0,,Қалғанын маған қалдыр.
Dialogue: 0,0:10:09.56,0:10:12.90,Default,,0,0,0,,Балалар, мені кім деп ойлайсыңдар?
Dialogue: 0,0:10:13.11,0:10:15.32,Default,,0,0,0,,Мен Масала қаласынан келген Сатошимін
Dialogue: 0,0:10:15.40,0:10:18.28,Default,,0,0,0,,Әлемдегі ең жақсы Покемон шебері бол!
Dialogue: 0,0:10:18.66,0:10:20.32,Default,,0,0,0,,Мен сендерден жеңілмеймін.
Dialogue: 0,0:10:20.82,0:10:23.24,Default,,0,0,0,,Қане бәріміз бірге алайық
Dialogue: 0,0:10:23.33,0:10:25.62,Default,,0,0,0,,(Жапон торғайларының дыбыстары)
Dialogue: 0,0:10:25.95,0:10:29.00,Default,,0,0,0,,Пикачуды құбыжық допқа салыңыз
Dialogue: 0,0:10:29.08,0:10:31.46,Default,,0,0,0,,Жүр, үлкен торғай!
Dialogue: 0,0:10:31.92,0:10:38.09,Default,,0,0,0,,(Найзағай мен жапон торғайларының айқайы)
Dialogue: 0,0:10:48.60,0:10:53.73,Default,,0,0,0,,Пика Чу!
Dialogue: 0,0:10:55.57,0:11:00.36,Default,,0,0,0,,(Жапон торғайларының дыбыстары)
Dialogue: 0,0:11:10.87,0:11:13.25,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:11:16.34,0:11:18.01,Default,,0,0,0,,Пикапи
Dialogue: 0,0:11:18.42,0:11:19.67,Default,,0,0,0,,Пикачу
Dialogue: 0,0:11:19.76,0:11:21.30,Default,,0,0,0,,Пикер
Dialogue: 0,0:11:24.10,0:11:25.26,Default,,0,0,0,,Ча~
Dialogue: 0,0:11:25.35,0:11:27.39,Default,,0,0,0,,А... Пика?
Dialogue: 0,0:11:27.47,0:11:30.19,Default,,0,0,0,,Маған жақсы ма?
Dialogue: 0,0:11:30.27,0:11:31.85,Default,,0,0,0,,Пикер
Dialogue: 0,0:11:31.94,0:11:33.44,Default,,0,0,0,,Нуффуча~
Dialogue: 0,0:11:33.52,0:11:35.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:56.25,0:11:57.59,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:02.84,0:12:03.84,Default,,0,0,0,,Ах... Пика
Dialogue: 0,0:12:16.40,0:12:18.15,Default,,0,0,0,,Ах... Пика
Dialogue: 0,0:12:37.42,0:12:40.30,Default,,0,0,0,,Пикачу, оны бір күні көрейік.
Dialogue: 0,0:12:40.38,0:12:42.30,Default,,0,0,0,,Пикачу
Dialogue: 0,0:12:56.48,0:12:58.44,Default,,0,0,0,,Покемонды алыңыз!
Dialogue: 0,0:12:58.52,0:13:04.53,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:15:05.28,0:15:11.28,Default,,0,0,0,,~♪
Dialogue: 0,0:15:18.25,0:15:19.96,Default,,0,0,0,,Пикачу
Dialogue: 0,0:15:20.04,0:15:21.46,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:15:21.54,0:15:23.84,Default,,0,0,0,,Монжара Бұл жүзім қамшысы.
Dialogue: 0,0:15:23.92,0:15:25.30,Default,,0,0,0,,Мозье!
Dialogue: 0,0:15:25.55,0:15:27.71,Default,,0,0,0,,Дыбыстық сигнал сигналы
Dialogue: 0,0:15:27.80,0:15:30.47,Default,,0,0,0,,Пикка мо яаа
Dialogue: 0,0:15:33.72,0:15:34.72,Default,,0,0,0,,Моджа…
Dialogue: 0,0:15:34.80,0:15:36.43,Default,,0,0,0,,Монжара Ұрысуға қабілетсіз
Dialogue: 0,0:15:36.51,0:15:38.98,Default,,0,0,0,,Сондықтан, Масала Таун жеңімпазы Сатоси
Dialogue: 0,0:15:39.27,0:15:42.15,Default,,0,0,0,,Жарайсыңдар! Пикапи
Dialogue: 0,0:15:42.23,0:15:44.02,Default,,0,0,0,,Жарайсың Пикачу
Dialogue: 0,0:15:44.11,0:15:45.61,Default,,0,0,0,,Ча~
Dialogue: 0,0:15:46.02,0:15:49.40,Default,,0,0,0,,Енді жаттығу залының жетекшісін жеңгенінің дәлелі...
Dialogue: 0,0:15:49.49,0:15:53.49,Default,,0,0,0,,Мен сізге Pokemon League ресми кемпірқосақ белгісін беремін.
Dialogue: 0,0:15:55.49,0:15:57.49,Default,,0,0,0,,Кемпірқосақ белгісін алыңыз!
Dialogue: 0,0:15:57.58,0:15:59.41,Default,,0,0,0,,Пиппикачу!
Dialogue: 0,0:15:59.50,0:16:01.25,Default,,0,0,0,,Бұл неше бөлік?
Dialogue: 0,0:16:01.33,0:16:02.62,Default,,0,0,0,,Бұл үшінші.
Dialogue: 0,0:16:02.71,0:16:06.46,Default,,0,0,0,,8 бөлікті жинап, Покемон лигасына қарсы тұрыңыз.
Dialogue: 0,0:16:06.54,0:16:08.92,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:16:09.46,0:16:11.38,Default,,0,0,0,,Пикачу
Dialogue: 0,0:16:11.47,0:16:12.80,Default,,0,0,0,,Эхха~
Dialogue: 0,0:16:13.01,0:16:14.22,Default,,0,0,0,,...
Dialogue: 0,0:16:14.30,0:16:16.64,Default,,0,0,0,,Э-э, не істеп жатырсыз, мырза?
Dialogue: 0,0:16:19.60,0:16:20.73,Default,,0,0,0,,Анашым
Dialogue: 0,0:16:20.81,0:16:23.94,Default,,0,0,0,,Сатоши, сен менімен ақыры хабарластың.
Dialogue: 0,0:16:24.27,0:16:24.81,Default,,0,0,0,,Ал... жақсы...
Dialogue: 0,0:16:24.81,0:16:26.15,Default,,0,0,0,,Е... жақсы... Пикачу...
Dialogue: 0,0:16:26.15,0:16:26.23,Default,,0,0,0,,Пикачу…
Dialogue: 0,0:16:26.23,0:16:28.11,Default,,0,0,0,,Пикачу... Покемон орталығында сіз баруыңыз мүмкін.
Dialogue: 0,0:16:28.11,0:16:28.19,Default,,0,0,0,,Покемон орталығында сіз баруыңыз мүмкін -
Dialogue: 0,0:16:28.19,0:16:28.53,Default,,0,0,0,,Покемон орталығында сіз баратын шығарсыз— Пиппи?
Dialogue: 0,0:16:28.53,0:16:28.61,Default,,0,0,0,,Дыбыстық сигнал?
Dialogue: 0,0:16:28.61,0:16:29.90,Default,,0,0,0,,Пипи? Барлығынан хабарлама қалдыру қиын болды.
Dialogue: 0,0:16:29.90,0:16:30.53,Default,,0,0,0,,Барлығынан хабар қалдыру қиын болды.
Dialogue: 0,0:16:30.53,0:16:31.61,Default,,0,0,0,,Барлығынан хабар қалдыру соншалықты қиын болды, Соу?
Dialogue: 0,0:16:31.95,0:16:33.41,Default,,0,0,0,,...Ал маңызды оқиға қандай?
Dialogue: 0,0:16:33.49,0:16:34.11,Default,,0,0,0,,Пика Пика
Dialogue: 0,0:16:34.11,0:16:35.32,Default,,0,0,0,,Пика Пика Дегенмен, мен айтуым керек
Dialogue: 0,0:16:35.41,0:16:37.20,Default,,0,0,0,,Сіз менімен байланысқан жоқсыз, солай ма... Пикачу?
Dialogue: 0,0:16:37.20,0:16:37.28,Default,,0,0,0,,көрдім... Пикачу
Dialogue: 0,0:16:37.28,0:16:37.53,Default,,0,0,0,,Сонымен...Пикачу, сен және әке...
Dialogue: 0,0:16:37.53,0:16:37.62,Default,,0,0,0,,Дәл сіз және әке...
Dialogue: 0,0:16:37.62,0:16:38.49,Default,,0,0,0,,Дәл, әкең екеуің— Жылтыр
Dialogue: 0,0:16:38.49,0:16:38.58,Default,,0,0,0,,Пика Пика
Dialogue: 0,0:16:38.58,0:16:39.74,Default,,0,0,0,,Барсаң кетесің
Dialogue: 0,0:16:39.83,0:16:41.16,Default,,0,0,0,,Кішкене ғана байланыс— Пи... Сонда?
Dialogue: 0,0:16:41.16,0:16:41.25,Default,,0,0,0,,Pi... Сонымен?
Dialogue: 0,0:16:41.25,0:16:41.54,Default,,0,0,0,,Pi… So? Бұл мүмкін емес пе?
Dialogue: 0,0:16:41.54,0:16:42.71,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:16:42.75,0:16:45.46,Default,,0,0,0,,Ah, Pika-chan, how are you doing? пикер
Dialogue: 0,0:16:45.67,0:16:46.67,Default,,0,0,0,,Пика
Dialogue: 0,0:16:46.75,0:16:48.88,Default,,0,0,0,,Бұл не? Мен оны қазір кесемін.
Dialogue: 0,0:16:49.21,0:16:52.05,Default,,0,0,0,,Күте тұрыңыз, сіз дұрыс тамақтанып жатырсыз ба?
Dialogue: 0,0:16:52.13,0:16:53.30,Default,,0,0,0,,Иә, мен тамақтанып жатырмын.
Dialogue: 0,0:16:53.55,0:16:56.22,Default,,0,0,0,,Көкөністерді де жеткілікті жеу керек.
Dialogue: 0,0:16:56.30,0:16:59.81,Default,,0,0,0,,Пикачу Pika? Кір жуу ше? You're not wearing a dirty shirt, are you?
Dialogue: 0,0:16:59.81,0:17:00.14,Default,,0,0,0,,Кірді ше? Сіз лас көйлек киген жоқсыз, солай ма?
Dialogue: 0,0:17:00.47,0:17:02.48,Default,,0,0,0,,Жақсы ма, мама?
Dialogue: 0,0:17:02.85,0:17:04.35,Default,,0,0,0,,Ихе хи хи
Dialogue: 0,0:17:05.44,0:17:06.56,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:17:06.65,0:17:09.98,Default,,0,0,0,,Көріп отырғаныңыздай, сіз қабылдаған Покемон қазір сау.
Dialogue: 0,0:17:10.53,0:17:12.90,Default,,0,0,0,,Рахмет, Джой.
Dialogue: 0,0:17:13.11,0:17:14.90,Default,,0,0,0,,Иә? Бұл...
Dialogue: 0,0:17:15.16,0:17:16.61,Default,,0,0,0,,Бұл іздеуде жүрген хат па?
Dialogue: 0,0:17:16.70,0:17:18.66,Default,,0,0,0,,Ах, зымыран командасы.
Dialogue: 0,0:17:18.74,0:17:19.95,Default,,0,0,0,,Зымыран командасы?
Dialogue: 0,0:17:20.03,0:17:21.83,Default,,0,0,0,,Адамдарда сирек кездесетін покемон...
Dialogue: 0,0:17:21.91,0:17:24.62,Default,,0,0,0,,Күшті Покемонды ұрлайтын жаман жігіттер
Dialogue: 0,0:17:24.71,0:17:26.83,Default,,0,0,0,,Ху~ Маған қызық, бұл не...
Dialogue: 0,0:17:26.92,0:17:29.25,Default,,0,0,0,,«Қызық, бұл не» десең де...
Dialogue: 0,0:17:29.34,0:17:31.88,Default,,0,0,0,,Жауап беруге міндетті емес.
Dialogue: 0,0:17:32.09,0:17:34.97,Default,,0,0,0,,Күшті және сирек кездесетін Покемонды ұстаңыз—
Dialogue: 0,0:17:35.05,0:17:38.01,Default,,0,0,0,,Мен саған мияулардың қандай керемет екенін көрсетемін.
Dialogue: 0,0:17:38.09,0:17:39.26,Default,,0,0,0,,Нихи
Dialogue: 0,0:17:40.39,0:17:41.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:41.89,0:17:44.73,Default,,0,0,0,,Джой, маған мынаны беріңізші.
Dialogue: 0,0:17:45.73,0:17:47.27,Default,,0,0,0,,Менің Вапореоным...
Dialogue: 0,0:17:47.35,0:17:49.98,Default,,0,0,0,,Маған көрсетіңіз, бұл өте ауыр зиян.
Dialogue: 0,0:17:50.06,0:17:51.61,Default,,0,0,0,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:17:52.11,0:17:53.61,Default,,0,0,0,,Энтей пайда болады...
Dialogue: 0,0:17:54.40,0:17:55.74,Default,,0,0,0,,Энтей
Dialogue: 0,0:17:55.82,0:17:56.61,Default,,0,0,0,,Мама, кешіріңіз, мен оны үземін.
Dialogue: 0,0:17:56.61,0:17:57.95,Default,,0,0,0,,Мама, кешіріңіз, мен оны үземін. Әй...
Dialogue: 0,0:17:58.28,0:18:01.03,Default,,0,0,0,,Мен оны міндетті түрде аламын деп ойладым...
Dialogue: 0,0:18:01.12,0:18:03.70,Default,,0,0,0,,Жарайды, тез сауығып кетесің.
Dialogue: 0,0:18:03.79,0:18:05.29,Default,,0,0,0,,Сен басқа әлемнен келгеніңді айтасың ба?
Dialogue: 0,0:18:06.71,0:18:08.79,Default,,0,0,0,,Өтінемін (есік жабылған дыбыс)
Dialogue: 0,0:18:08.88,0:18:10.67,Default,,0,0,0,,Энтей дегеніміз не?
Dialogue: 0,0:18:10.84,0:18:14.01,Default,,0,0,0,,А, бұл аңызға айналған Покемон.
Dialogue: 0,0:18:14.09,0:18:17.05,Default,,0,0,0,,Бұл сирек кездесетін Покемон болса да...
Dialogue: 0,0:18:17.47,0:18:19.55,Default,,0,0,0,,Бұл өте күшті болды
Dialogue: 0,0:18:19.64,0:18:22.89,Default,,0,0,0,,Менің Вапореоным бір сәтте жеңіліп қалды
Dialogue: 0,0:18:23.64,0:18:25.64,Default,,0,0,0,,Ол орманда жоғалып кетті.
Dialogue: 0,0:18:25.89,0:18:26.89,Default,,0,0,0,,Әлі де жақын
Dialogue: 0,0:18:26.98,0:18:30.06,Default,,0,0,0,,Мен оны алатын адаммын (Пикси) Пиппи
Dialogue: 0,0:18:30.52,0:18:33.11,Default,,0,0,0,,Жүр, Пикачу, Пикачу
Dialogue: 0,0:18:33.65,0:18:36.69,Default,,0,0,0,,Мысықтар кішкентай, Покемон да кішкентай.
Dialogue: 0,0:18:36.78,0:18:38.66,Default,,0,0,0,,Нихитто
Dialogue: 0,0:18:39.20,0:18:41.24,Default,,0,0,0,,Ой, балалар...
Dialogue: 0,0:18:41.53,0:18:43.24,Default,,0,0,0,,Энтей алу...
Dialogue: 0,0:18:44.99,0:18:47.21,Default,,0,0,0,,Жақсы көрінеді!
Dialogue: 0,0:18:50.12,0:18:52.09,Default,,0,0,0,,Қайда? Энтей
Dialogue: 0,0:18:56.05,0:18:57.92,Default,,0,0,0,,Шұңқыр а
Dialogue: 0,0:19:00.47,0:19:01.47,Default,,0,0,0,,Ах
Dialogue: 0,0:19:01.76,0:19:04.14,Default,,0,0,0,,Міне болды! иә?
Dialogue: 0,0:19:05.43,0:19:06.52,Default,,0,0,0,,Ихихихихи
Dialogue: 0,0:19:08.14,0:19:09.94,Default,,0,0,0,,Ах! Пикер!
Dialogue: 0,0:19:11.35,0:19:12.69,Default,,0,0,0,,Piplup сұрауы
Dialogue: 0,0:19:15.28,0:19:16.78,Default,,0,0,0,,Поча~ Поча
Dialogue: 0,0:19:16.86,0:19:19.07,Default,,0,0,0,,Күте тұрыңыз, мен біріншімін.
Dialogue: 0,0:19:19.15,0:19:20.74,Default,,0,0,0,,Мен біріншімін
Dialogue: 0,0:19:20.82,0:19:23.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:25.62,0:19:26.62,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:19:28.29,0:19:29.58,Default,,0,0,0,,...
Dialogue: 0,0:19:29.66,0:19:31.92,Default,,0,0,0,,Ча~ Поча~
Dialogue: 0,0:19:34.50,0:19:35.50,Default,,0,0,0,,Pi…
Dialogue: 0,0:19:36.25,0:19:37.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:41.26,0:19:42.89,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:19:44.43,0:19:46.01,Default,,0,0,0,,Пикачу 10манвольт
Dialogue: 0,0:19:46.10,0:19:47.39,Default,,0,0,0,,Пикачу!
Dialogue: 0,0:19:48.35,0:19:49.93,Default,,0,0,0,,Уау, поча~ча
Dialogue: 0,0:19:58.28,0:19:59.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:59.61,0:20:01.20,Default,,0,0,0,,Ыстық ыстық ыстық
Dialogue: 0,0:20:01.28,0:20:04.12,Default,,0,0,0,,Хааааа... Ачии Ачии...
Dialogue: 0,0:20:08.79,0:20:11.66,Default,,0,0,0,,What about Лукарио?
Dialogue: 0,0:20:12.25,0:20:13.29,Default,,0,0,0,,Pi… ah…
Dialogue: 0,0:20:17.96,0:20:19.63,Default,,0,0,0,,(Лукарионың ыңырсыуы)
Dialogue: 0,0:20:19.71,0:20:20.72,Default,,0,0,0,,Ах
Dialogue: 0,0:20:20.80,0:20:23.38,Default,,0,0,0,,Жарайды, Piplup Bubble Kosen
Dialogue: 0,0:20:23.47,0:20:25.60,Default,,0,0,0,,Ча~ Поча!
Dialogue: 0,0:20:29.39,0:20:31.31,Default,,0,0,0,,Уау (Пиплуп пен Пикачу айқайлайды)
Dialogue: 0,0:20:31.39,0:20:32.48,Default,,0,0,0,,Уф
Dialogue: 0,0:20:39.07,0:20:41.15,Default,,0,0,0,,Ча... у...
Dialogue: 0,0:20:41.24,0:20:43.61,Default,,0,0,0,,Сіз қашып үлгердіңіз ғой, солай ма?
Dialogue: 0,0:20:43.70,0:20:44.70,Default,,0,0,0,,Почат
Dialogue: 0,0:20:44.78,0:20:45.87,Default,,0,0,0,,Сізге кедергі жасау керек—
Dialogue: 0,0:20:45.95,0:20:47.99,Default,,0,0,0,,Түсіндім, Пика.
Dialogue: 0,0:20:48.08,0:20:49.66,Default,,0,0,0,,Сізге кедергі болған адамсыз, солай ма?
Dialogue: 0,0:20:49.74,0:20:50.91,Default,,0,0,0,,Міне, солай емес пе?
Dialogue: 0,0:20:51.00,0:20:52.41,Default,,0,0,0,,Не, мотивацияңыз бар ма?
Dialogue: 0,0:20:52.50,0:20:55.25,Default,,0,0,0,,Жарайды, мен Масала қаласынан келген Сатошимін.
Dialogue: 0,0:20:55.54,0:20:57.17,Default,,0,0,0,,Пикачумен шайқасайық
Dialogue: 0,0:20:57.46,0:21:01.21,Default,,0,0,0,,Мен оны қабылдаймын. Мен Футаба қаласынан келген Макотомын.
Dialogue: 0,0:21:01.30,0:21:02.47,Default,,0,0,0,,Сол жерде бала
Dialogue: 0,0:21:02.55,0:21:05.09,Default,,0,0,0,,Мен бұл баланы жеңсем, келесі сенсің.
Dialogue: 0,0:21:05.64,0:21:07.39,Default,,0,0,0,,Менімен де шайқасайық.
Dialogue: 0,0:21:07.47,0:21:10.52,Default,,0,0,0,,...Мені жеңсең ше?
Dialogue: 0,0:21:11.10,0:21:14.81,Default,,0,0,0,,Мен Тобари қаласынан келген Соуджимен соғысудан аулақ боламын.
Dialogue: 0,0:21:15.06,0:21:16.60,Default,,0,0,0,,Қашып кеткің келе ме? Бұл дұрыс
Dialogue: 0,0:21:16.69,0:21:17.86,Default,,0,0,0,,Ұрысайық
Dialogue: 0,0:21:17.94,0:21:19.23,Default,,0,0,0,,Кеңес беру
Dialogue: 0,0:21:19.82,0:21:21.36,Default,,0,0,0,,Жақында дауыл болады
Dialogue: 0,0:21:21.44,0:21:24.11,Default,,0,0,0,,Жаңбырдан қорғанатын жер іздеңіз.
Dialogue: 0,0:21:25.49,0:21:26.70,Default,,0,0,0,,Дауыл?
Dialogue: 0,0:21:26.78,0:21:30.41,Default,,0,0,0,,Жаңбырдан пана алмас бұрын анама қоңырау шалу керек.
Dialogue: 0,0:21:30.49,0:21:33.00,Default,,0,0,0,,Ой... шулы, бастайық.
Dialogue: 0,0:21:33.08,0:21:34.58,Default,,0,0,0,,Бұл сіз қалаған нәрсе.
Dialogue: 0,0:21:35.21,0:21:36.42,Default,,0,0,0,,Сол жерден кел.
Dialogue: 0,0:21:36.50,0:21:39.79,Default,,0,0,0,,Әдемі көрінуге тырыссаң, өкінетініңді білмейсің.
Dialogue: 0,0:21:40.34,0:21:41.55,Default,,0,0,0,,...
Dialogue: 0,0:21:41.63,0:21:43.46,Default,,0,0,0,,Почапочапоча… Шар
Dialogue: 0,0:21:43.76,0:21:45.22,Default,,0,0,0,,Пикачу темір құйрығы
Dialogue: 0,0:21:45.30,0:21:46.30,Default,,0,0,0,,Пика
Dialogue: 0,0:21:46.38,0:21:48.72,Default,,0,0,0,,Пика Чааны шайнау
Dialogue: 0,0:21:48.80,0:21:49.93,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:21:50.01,0:21:52.35,Default,,0,0,0,,Денку Секка Пиппи Пиппи
Dialogue: 0,0:21:52.64,0:21:54.06,Default,,0,0,0,,Пикаппоча…
Dialogue: 0,0:21:54.14,0:21:55.64,Default,,0,0,0,,Пипика
Dialogue: 0,0:21:55.73,0:21:57.94,Default,,0,0,0,,Амансың ба? Почама Почапоча
Dialogue: 0,0:21:58.48,0:22:00.15,Default,,0,0,0,,Гидросорғы, поп...
Dialogue: 0,0:22:00.23,0:22:01.32,Default,,0,0,0,,Ча~ Поча
Dialogue: 0,0:22:01.40,0:22:02.73,Default,,0,0,0,,Кавасэ Пика
Dialogue: 0,0:22:09.62,0:22:10.62,Default,,0,0,0,,(Иуарктың айқайы)
Dialogue: 0,0:22:10.70,0:22:11.74,Default,,0,0,0,,Поча…
Dialogue: 0,0:22:13.62,0:22:15.71,Default,,0,0,0,,Ива~ Ахх
Dialogue: 0,0:22:15.79,0:22:17.83,Default,,0,0,0,,Уф Пиплап
Dialogue: 0,0:22:17.92,0:22:20.21,Default,,0,0,0,,Қашайық. Иә.
Dialogue: 0,0:22:20.29,0:22:22.92,Default,,0,0,0,,Ива~
Dialogue: 0,0:22:23.84,0:22:27.84,Default,,0,0,0,,қазу
Dialogue: 0,0:22:27.93,0:22:30.51,Default,,0,0,0,,Энтей қайда орналасқан?
Dialogue: 0,0:22:30.60,0:22:32.18,Default,,0,0,0,,О? Бұл...
Dialogue: 0,0:22:32.26,0:22:34.31,Default,,0,0,0,,Энтей келді.
Dialogue: 0,0:22:34.39,0:22:36.60,Default,,0,0,0,,О хахахаха
Dialogue: 0,0:22:37.81,0:22:39.90,Default,,0,0,0,,Ива~
Dialogue: 0,0:22:40.40,0:22:44.19,Default,,0,0,0,,Қандай сезім!
Dialogue: 0,0:22:44.90,0:22:47.99,Default,,0,0,0,,(Сатоши мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:22:53.58,0:22:56.83,Default,,0,0,0,,Ива~! Пикаа
Dialogue: 0,0:22:57.50,0:22:59.37,Default,,0,0,0,,(Сатоши мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:22:59.83,0:23:01.63,Default,,0,0,0,,Ива~!
Dialogue: 0,0:23:01.71,0:23:04.25,Default,,0,0,0,,Анау жартас, жоғары көтеріл!
Dialogue: 0,0:23:06.01,0:23:07.63,Default,,0,0,0,,Ива~!
Dialogue: 0,0:23:07.72,0:23:09.84,Default,,0,0,0,,Уау, жылтыр
Dialogue: 0,0:23:09.93,0:23:12.14,Default,,0,0,0,,Ива~ Ива~!
Dialogue: 0,0:23:12.22,0:23:14.85,Default,,0,0,0,,Ива~! Ахх
Dialogue: 0,0:23:14.93,0:23:16.31,Default,,0,0,0,,Ива~! Уф
Dialogue: 0,0:23:16.39,0:23:20.65,Default,,0,0,0,,Иуарк, тоқта! Осылай қалсаңыз, сізге қауіп төнеді.
Dialogue: 0,0:23:20.73,0:23:23.44,Default,,0,0,0,,Маған айқайласаң, мен одан бетер толқып кетемін.
Dialogue: 0,0:23:23.73,0:23:25.11,Default,,0,0,0,,Қарғыс атсын... Жарайды.
Dialogue: 0,0:23:26.03,0:23:29.45,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:23:30.15,0:23:31.36,Default,,0,0,0,,Ива~!
Dialogue: 0,0:23:32.62,0:23:34.24,Default,,0,0,0,,Пика! Эх, Сатоси
Dialogue: 0,0:23:34.33,0:23:36.66,Default,,0,0,0,,Ива~ Тоқта!
Dialogue: 0,0:23:36.74,0:23:38.08,Default,,0,0,0,,Ива~
Dialogue: 0,0:23:38.16,0:23:40.62,Default,,0,0,0,,Узушио Ча~ Поча
Dialogue: 0,0:23:40.92,0:23:43.54,Default,,0,0,0,,Ива~
Dialogue: 0,0:23:43.63,0:23:47.80,Default,,0,0,0,,Иуарк, сені қорқытқаным үшін кешір. Мен кешірім сұраймын, сондықтан тынышталыңыз.
Dialogue: 0,0:23:48.46,0:23:50.22,Default,,0,0,0,,(Иуарктың ырылдауы)
Dialogue: 0,0:23:53.55,0:23:54.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:56.22,0:23:57.85,Default,,0,0,0,,Ааа пика
Dialogue: 0,0:23:57.93,0:24:01.06,Default,,0,0,0,,Ива~ Ах... Ахх
Dialogue: 0,0:24:05.23,0:24:08.32,Default,,0,0,0,,Уф... Ха...
Dialogue: 0,0:24:11.11,0:24:13.16,Default,,0,0,0,,Мен жұмыс істеймін Кешіріңіз!
Dialogue: 0,0:24:13.24,0:24:15.12,Default,,0,0,0,,Почапоча~!
Dialogue: 0,0:24:15.20,0:24:17.54,Default,,0,0,0,,Пиплаптың құйындысы құтқарылды.
Dialogue: 0,0:24:17.62,0:24:19.25,Default,,0,0,0,,Поча
Dialogue: 0,0:24:19.45,0:24:22.04,Default,,0,0,0,,Бұл мүлдем абайсызда.
Dialogue: 0,0:24:22.12,0:24:24.58,Default,,0,0,0,,Бірақ мен оны сәл ғана қайта қарастырдым деп ойлаймын.
Dialogue: 0,0:24:24.75,0:24:26.88,Default,,0,0,0,,Иә? О, ештеңе емес
Dialogue: 0,0:24:27.17,0:24:28.30,Default,,0,0,0,,Жаңбыр жауып тұр, Пика?
Dialogue: 0,0:24:28.38,0:24:30.34,Default,,0,0,0,,Бала айтқандай ма?
Dialogue: 0,0:24:30.42,0:24:31.72,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:24:31.80,0:24:33.13,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:24:35.51,0:24:39.60,Default,,0,0,0,,Дыбыс сигналы дыбыстық сигнал сигналы дыбыстық сигнал сигналы дыбыстық сигнал сигналы сигналдық сигнал
Dialogue: 0,0:24:43.02,0:24:44.48,Default,,0,0,0,,Пи пика? Ах
Dialogue: 0,0:24:44.56,0:24:46.19,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:24:49.03,0:24:51.69,Default,,0,0,0,,Бұл Чармандер. Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:24:51.78,0:24:54.11,Default,,0,0,0,,Жаңбырда осылай не істеп жүрсің?
Dialogue: 0,0:24:54.20,0:24:55.20,Default,,0,0,0,,Пика?
Dialogue: 0,0:24:58.28,0:24:59.58,Default,,0,0,0,,Кейдж?
Dialogue: 0,0:24:59.66,0:25:01.54,Default,,0,0,0,,Кагеккагекка…
Dialogue: 0,0:25:01.62,0:25:04.04,Default,,0,0,0,,...
Dialogue: 0,0:25:04.12,0:25:05.88,Default,,0,0,0,,Кейдж Кейдж Кейдж
Dialogue: 0,0:25:06.46,0:25:07.79,Default,,0,0,0,,Жаттықтырушы болды.
Dialogue: 0,0:25:07.88,0:25:11.88,Default,,0,0,0,,Кейдж Кэйдж… Кейдж Кейдж…
Dialogue: 0,0:25:11.96,0:25:12.97,Default,,0,0,0,,Кейдж
Dialogue: 0,0:25:13.05,0:25:14.59,Default,,0,0,0,,А, өте жарқын!
Dialogue: 0,0:25:16.14,0:25:18.55,Default,,0,0,0,,Сіз әлі де сондасыз ба? Жоғалып кету.
Dialogue: 0,0:25:18.64,0:25:19.68,Default,,0,0,0,,Кейдж?
Dialogue: 0,0:25:19.76,0:25:22.18,Default,,0,0,0,,Сіз бұл баланың жаттықтырушысысыз ба?
Dialogue: 0,0:25:22.39,0:25:24.73,Default,,0,0,0,,Бұл не? Балалар, маған жауап беріңдерші.
Dialogue: 0,0:25:24.81,0:25:27.40,Default,,0,0,0,,Иә? не ыстық
Dialogue: 0,0:25:27.48,0:25:29.65,Default,,0,0,0,,А, бұл түпнұсқа болса да.
Dialogue: 0,0:25:29.73,0:25:32.32,Default,,0,0,0,,Түпнұсқа? Әлсіз болғандықтан лақтырып жібердім
Dialogue: 0,0:25:32.40,0:25:34.65,Default,,0,0,0,,Мұндай өлшемдегі көптеген Charmander бар.
Dialogue: 0,0:25:34.74,0:25:35.82,Default,,0,0,0,,Нпика
Dialogue: 0,0:25:35.91,0:25:38.28,Default,,0,0,0,,Бірақ ол мені табанды түрде аңдып жүр...
Dialogue: 0,0:25:38.37,0:25:39.95,Default,,0,0,0,,«Осы жерде күте тұрыңыз», - дедім.
Dialogue: 0,0:25:40.33,0:25:41.62,Default,,0,0,0,,Уф…
Dialogue: 0,0:25:41.70,0:25:45.29,Default,,0,0,0,,Дұрыс, мен Покемонға «күте тұр» дегенде, ұстадым...
Dialogue: 0,0:25:45.37,0:25:48.04,Default,,0,0,0,,Кейде өлгенше күтуге тура келеді.
Dialogue: 0,0:25:48.13,0:25:49.21,Default,,0,0,0,,ол даулы мәлімдемеге айналар еді
Dialogue: 0,0:25:50.46,0:25:52.46,Default,,0,0,0,,Күте тұрыңыз, иә?
Dialogue: 0,0:25:52.55,0:25:54.80,Default,,0,0,0,,Ру… Лугат
Dialogue: 0,0:25:54.88,0:25:56.38,Default,,0,0,0,,Әй
Dialogue: 0,0:25:56.47,0:25:58.72,Default,,0,0,0,,Сатоси Пикачу
Dialogue: 0,0:25:58.97,0:26:01.31,Default,,0,0,0,,Покемон үшін күш - бәрі (Лугарганның айқайы)
Dialogue: 0,0:26:01.31,0:26:01.60,Default,,0,0,0,,(Лугарганның ырылдауы)
Dialogue: 0,0:26:01.60,0:26:03.64,Default,,0,0,0,,Өлгің келмесе, күштірек бол
Dialogue: 0,0:26:03.98,0:26:04.98,Default,,0,0,0,,Не?
Dialogue: 0,0:26:05.06,0:26:07.23,Default,,0,0,0,,Покемонның күшті болуына көмектесу...
Dialogue: 0,0:26:07.31,0:26:08.44,Default,,0,0,0,,Жаттықтырушы емессіз бе?
Dialogue: 0,0:26:08.77,0:26:11.36,Default,,0,0,0,,Сонымен... жақсы нәрсе бар ма?
Dialogue: 0,0:26:13.28,0:26:14.65,Default,,0,0,0,,Біз дос бола аламыз
Dialogue: 0,0:26:14.74,0:26:15.82,Default,,0,0,0,,Ах
Dialogue: 0,0:26:15.90,0:26:17.45,Default,,0,0,0,,Сен тым наивсің.
Dialogue: 0,0:26:17.53,0:26:20.24,Default,,0,0,0,,Достық тек Покемонды әлсіретеді.
Dialogue: 0,0:26:21.66,0:26:25.83,Default,,0,0,0,,Менің атым Кросс, ол ең күшті жаттықтырушы болады.
Dialogue: 0,0:26:25.91,0:26:27.71,Default,,0,0,0,,Эй, күте тұрыңыз...
Dialogue: 0,0:26:27.79,0:26:29.13,Default,,0,0,0,,Ка... Каге... Ах...
Dialogue: 0,0:26:29.21,0:26:32.04,Default,,0,0,0,,Адам… а… у...
Dialogue: 0,0:26:32.50,0:26:34.05,Default,,0,0,0,,Ах, Чармандер...
Dialogue: 0,0:26:34.13,0:26:35.97,Default,,0,0,0,,Құйрықтағы жалын әлсірейді.
Dialogue: 0,0:26:36.05,0:26:38.68,Default,,0,0,0,,Егер ол жоғалып кетсе, сіз өлесіз.
Dialogue: 0,0:26:40.68,0:26:42.68,Default,,0,0,0,,Жаңбырдан бір жерді паналауым керек.
Dialogue: 0,0:26:42.76,0:26:43.81,Default,,0,0,0,,О
Dialogue: 0,0:26:44.68,0:26:45.93,Default,,0,0,0,,Дыбыстық сигнал сигналы
Dialogue: 0,0:26:58.36,0:26:59.91,Default,,0,0,0,,...
Dialogue: 0,0:26:59.99,0:27:01.37,Default,,0,0,0,,Поча Поча Поча Поча…
Dialogue: 0,0:27:01.45,0:27:02.99,Default,,0,0,0,,Пика? иә?
Dialogue: 0,0:27:09.62,0:27:10.92,Default,,0,0,0,,Ах... Уф.
Dialogue: 0,0:27:11.00,0:27:13.25,Default,,0,0,0,,Неліктен оның осы деңгейге жетуіне жол бердіңіз?
Dialogue: 0,0:27:13.34,0:27:15.13,Default,,0,0,0,,Бұл Сатосидің кінәсі емес.
Dialogue: 0,0:27:15.21,0:27:18.09,Default,,0,0,0,,Тастанды, Жаңбырда күттім
Dialogue: 0,0:27:18.17,0:27:21.59,Default,,0,0,0,,Жаттықтырушы сізді алып кетуге келетініне сеніңіз...
Dialogue: 0,0:27:25.51,0:27:26.77,Default,,0,0,0,,Оны емдеуге бола ма?
Dialogue: 0,0:27:26.85,0:27:28.35,Default,,0,0,0,,А, мен сені емдеймін.
Dialogue: 0,0:27:28.93,0:27:31.27,Default,,0,0,0,,Пика Поча…
Dialogue: 0,0:27:32.02,0:27:35.44,Default,,0,0,0,,Мен жаттықтырушы ретінде жақсы көретін Покемонның өлуіне жол бере алмаймын.
Dialogue: 0,0:27:37.15,0:27:38.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:43.74,0:27:45.91,Default,,0,0,0,,Бұл ащы болуы мүмкін, бірақ оған шыдаңыз.
Dialogue: 0,0:27:46.58,0:27:47.83,Default,,0,0,0,,Көлеңке…
Dialogue: 0,0:27:49.08,0:27:50.92,Default,,0,0,0,,Ой... жарайды.
Dialogue: 0,0:27:51.00,0:27:53.33,Default,,0,0,0,,Енді демалыңыз және қалпына келуді күтіңіз.
Dialogue: 0,0:27:54.09,0:27:56.00,Default,,0,0,0,,Менің денем суық.
Dialogue: 0,0:27:56.21,0:27:57.84,Default,,0,0,0,,Мен сені жылытамын.
Dialogue: 0,0:27:59.13,0:28:00.47,Default,,0,0,0,,Көлеңке…
Dialogue: 0,0:28:01.68,0:28:04.05,Default,,0,0,0,,Жарайды, Чармандер.
Dialogue: 0,0:28:13.02,0:28:15.06,Default,,0,0,0,,Кэйге…
Dialogue: 0,0:28:15.98,0:28:16.98,Default,,0,0,0,,Ha
Dialogue: 0,0:28:17.19,0:28:18.98,Default,,0,0,0,,Сіз қалай ойлайсыз? Әлі суық па?
Dialogue: 0,0:28:19.07,0:28:20.40,Default,,0,0,0,,Пика? Поча
Dialogue: 0,0:28:21.57,0:28:23.03,Default,,0,0,0,,Көлеңке…
Dialogue: 0,0:28:26.12,0:28:27.91,Default,,0,0,0,,Көп тынышталды.
Dialogue: 0,0:28:27.99,0:28:30.37,Default,,0,0,0,,Соуджиге рахмет. Рақмет сізге.
Dialogue: 0,0:28:30.45,0:28:32.71,Default,,0,0,0,,Покемон орталығында ол Джойға ұқсайтын.
Dialogue: 0,0:28:32.79,0:28:36.46,Default,,0,0,0,,Покемон дәрігері болғыңыз келсе, сізге медициналық білім де қажет.
Dialogue: 0,0:28:36.54,0:28:38.34,Default,,0,0,0,,Я~ Енді...
Dialogue: 0,0:28:38.42,0:28:42.17,Default,,0,0,0,,Әртүрлі аймақтарды аралау және адамдар мен Покемон туралы аңыздарды жинау
Dialogue: 0,0:28:42.59,0:28:45.09,Default,,0,0,0,,Ентеймен танысқаныма қуаныштымын.
Dialogue: 0,0:28:45.59,0:28:49.01,Default,,0,0,0,,А, менде құнды тәжірибе болды.
Dialogue: 0,0:28:49.39,0:28:51.52,Default,,0,0,0,,Аа, дұрыс. Неліктен Макото бұл аймақта?
Dialogue: 0,0:28:51.60,0:28:52.77,Default,,0,0,0,,Мен қай жерден...
Dialogue: 0,0:28:52.85,0:28:54.40,Default,,0,0,0,,Бұл өте алыс, солай емес пе? Ах...
Dialogue: 0,0:28:54.48,0:28:57.69,Default,,0,0,0,,Ал, көп нәрсе. Ах... ах... Эй.
Dialogue: 0,0:28:57.77,0:28:59.73,Default,,0,0,0,,Сатоси нені көздеп отыр?
Dialogue: 0,0:28:59.82,0:29:00.82,Default,,0,0,0,,Мен?
Dialogue: 0,0:29:00.90,0:29:03.11,Default,,0,0,0,,Мен әлемдегі ең жақсы Покемон шеберімін
Dialogue: 0,0:29:03.45,0:29:06.03,Default,,0,0,0,,Не, әлемдегі ең жақсы жаттықтырушы?
Dialogue: 0,0:29:06.12,0:29:08.08,Default,,0,0,0,,Ол жоғарырақ. Ол жоғарырақ.
Dialogue: 0,0:29:08.16,0:29:09.54,Default,,0,0,0,,Не? Ахахаха
Dialogue: 0,0:29:10.24,0:29:13.21,Default,,0,0,0,,Усабу...
Dialogue: 0,0:29:13.41,0:29:15.58,Default,,0,0,0,,Кімге… Кімге… Кімге…
Dialogue: 0,0:29:15.67,0:29:17.59,Default,,0,0,0,,Хексиш, жақсысың ба?
Dialogue: 0,0:29:17.67,0:29:20.05,Default,,0,0,0,,Иә, ол қалай болса солай тегіс.
Dialogue: 0,0:29:20.25,0:29:22.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:22.17,0:29:24.05,Default,,0,0,0,,О... Пикачу
Dialogue: 0,0:29:24.13,0:29:25.43,Default,,0,0,0,,Сіз мені жылыта аласыз ба?
Dialogue: 0,0:29:25.51,0:29:26.72,Default,,0,0,0,,Пикачу
Dialogue: 0,0:29:26.80,0:29:29.47,Default,,0,0,0,,Поча Поча Ча~
Dialogue: 0,0:29:29.56,0:29:31.22,Default,,0,0,0,,Почама Почапоча
Dialogue: 0,0:29:31.31,0:29:34.73,Default,,0,0,0,,Мен сізге ескертемін, оны құбыжық шарына салыңыз.
Dialogue: 0,0:29:34.81,0:29:37.23,Default,,0,0,0,,Покемонның өзі ғана сізді суықтан қорғай алады.
Dialogue: 0,0:29:37.31,0:29:39.65,Default,,0,0,0,,Иә, Piplup да.
Dialogue: 0,0:29:41.11,0:29:43.36,Default,,0,0,0,,Мен де солай жасағым келеді...
Dialogue: 0,0:29:43.44,0:29:45.86,Default,,0,0,0,,Менің Пикачум құбыжық допқа кіреді...
Dialogue: 0,0:29:45.95,0:29:47.95,Default,,0,0,0,,Мен жылтырды жек көремін
Dialogue: 0,0:29:48.45,0:29:49.49,Default,,0,0,0,,Сол жігіт… Көзіне латкі таққан Какужа ма?
Dialogue: 0,0:29:49.78,0:29:51.08,Default,,0,0,0,,Ча~ Поча
Dialogue: 0,0:29:51.16,0:29:52.62,Default,,0,0,0,,Жоқ, сіз суық тиіп қаласыз.
Dialogue: 0,0:29:52.70,0:29:54.37,Default,,0,0,0,,Артқа оралыңыз, у...
Dialogue: 0,0:29:54.46,0:29:56.33,Default,,0,0,0,,Поча Лукарио
Dialogue: 0,0:29:56.42,0:29:57.88,Default,,0,0,0,,Поча Почама
Dialogue: 0,0:29:58.58,0:29:59.92,Default,,0,0,0,,Пика
Dialogue: 0,0:30:00.00,0:30:01.50,Default,,0,0,0,,Пикачу хехе
Dialogue: 0,0:30:08.84,0:30:10.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:36.87,0:30:41.09,Default,,0,0,0,,Табиғат ғажайыптарының алдында адам мен Покемон бірдей.
Dialogue: 0,0:30:41.38,0:30:42.38,Default,,0,0,0,,Иә
Dialogue: 0,0:30:43.80,0:30:47.34,Default,,0,0,0,,Энтейге Хо-о өмір сыйлаған деген аңыз бар.
Dialogue: 0,0:30:47.42,0:30:48.68,Default,,0,0,0,,А... Хо-о?
Dialogue: 0,0:30:49.01,0:30:50.01,Default,,0,0,0,,Иә
Dialogue: 0,0:30:51.64,0:30:55.31,Default,,0,0,0,,(О-оның айқайы)
Dialogue: 0,0:30:59.44,0:31:01.11,Default,,0,0,0,,150 жыл бұрын…
Dialogue: 0,0:31:01.44,0:31:04.57,Default,,0,0,0,,Ақша мұнарасы, онда Хо-о адамдармен байланыста болды...
Dialogue: 0,0:31:04.65,0:31:06.94,Default,,0,0,0,,Найзағайдан шыққан өрттен жанып кеткен.
Dialogue: 0,0:31:08.36,0:31:10.53,Default,,0,0,0,,Өрт кенеттен жауған жаңбырмен сөндірілді.
Dialogue: 0,0:31:12.20,0:31:13.33,Default,,0,0,0,,Сол өртте —
Dialogue: 0,0:31:13.41,0:31:16.20,Default,,0,0,0,,Үш аты жоқ Покемон қайтыс болды.
Dialogue: 0,0:31:17.12,0:31:20.42,Default,,0,0,0,,Содан кейін Хо-о түсіп, өмір берді және оны тірілтті.
Dialogue: 0,0:31:20.42,0:31:21.75,Default,,0,0,0,,Содан кейін Хо-о түсіп, оған өмір берді және оны тірілтті (Хо-Оның айқайы)
Dialogue: 0,0:31:21.75,0:31:22.38,Default,,0,0,0,,(О-оның айқайы)
Dialogue: 0,0:31:23.71,0:31:26.67,Default,,0,0,0,,Үш дене мұнараны соққан найзағай.
Dialogue: 0,0:31:26.76,0:31:28.47,Default,,0,0,0,,Мұнараны өртеген жалын
Dialogue: 0,0:31:28.92,0:31:30.84,Default,,0,0,0,,Мұнараны сөндірген жаңбыр
Dialogue: 0,0:31:32.39,0:31:34.35,Default,,0,0,0,,Оның инкарнациясы деп айтылады
Dialogue: 0,0:31:39.31,0:31:41.73,Default,,0,0,0,,Райкоу Энтей
Dialogue: 0,0:31:42.10,0:31:43.15,Default,,0,0,0,,Бұл Суикун
Dialogue: 0,0:31:43.23,0:31:45.11,Default,,0,0,0,,Мен Суикюнді жақсы көремін
Dialogue: 0,0:31:45.19,0:31:48.65,Default,,0,0,0,,Покемонның өмірін басқарады деп айтылады.
Dialogue: 0,0:31:49.15,0:31:50.15,Default,,0,0,0,,Бұл Хо-о
Dialogue: 0,0:31:50.45,0:31:51.45,Default,,0,0,0,,А, өте жарқын!
Dialogue: 0,0:31:52.24,0:31:53.24,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:31:53.32,0:31:54.87,Default,,0,0,0,,Мен кеткен күні көрдім.
Dialogue: 0,0:31:54.95,0:31:56.37,Default,,0,0,0,,Иә? Шынымен бе?
Dialogue: 0,0:31:56.45,0:32:00.41,Default,,0,0,0,,Әй, мынау құлап қалды.
Dialogue: 0,0:32:00.50,0:32:02.46,Default,,0,0,0,,Чаа... Кемпірқосақ шашуы
Dialogue: 0,0:32:02.54,0:32:04.42,Default,,0,0,0,,Ех (Энтейдің ырылдауы)
Dialogue: 0,0:32:04.79,0:32:07.21,Default,,0,0,0,,Кемпірқосақ шашуы?
Dialogue: 0,0:32:07.30,0:32:10.59,Default,,0,0,0,,Хо-о көпшілік алдына сирек шығады, бірақ...
Dialogue: 0,0:32:10.67,0:32:14.76,Default,,0,0,0,,Шамасы, өте сирек жағдайда ұнатқан адамға кемпірқосақ түсті қауырсын сыйлайтын көрінеді.
Dialogue: 0,0:32:15.01,0:32:18.18,Default,,0,0,0,,Эй, онда Хо-о мені ұнатты.
Dialogue: 0,0:32:18.68,0:32:21.14,Default,,0,0,0,,Бірақ қауырсындар не үшін керек?
Dialogue: 0,0:32:21.52,0:32:23.10,Default,,0,0,0,,Осындай аңыз бар
Dialogue: 0,0:32:23.77,0:32:27.40,Default,,0,0,0,,«Кемпірқосақ шашырандысының жетегінде кетіп, Хо-оға жолыққан адам...»
Dialogue: 0,0:32:27.48,0:32:29.28,Default,,0,0,0,,«Кемпірқосақ батыры бол»
Dialogue: 0,0:32:30.11,0:32:31.82,Default,,0,0,0,,Кемпірқосақ батыры...
Dialogue: 0,0:32:31.90,0:32:33.95,Default,,0,0,0,,Мен оны шынымен түсінбеймін, бірақ ол керемет көрінеді.
Dialogue: 0,0:32:34.45,0:32:36.41,Default,,0,0,0,,...Бұл мен туралы емес.
Dialogue: 0,0:32:36.49,0:32:38.37,Default,,0,0,0,,А, мен түсіндім, хахахаха
Dialogue: 0,0:32:43.12,0:32:48.80,Default,,0,0,0,,(Сатоши мен оның достарының ұйқысы)
Dialogue: 0,0:32:54.01,0:32:56.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:33:07.02,0:33:08.19,Default,,0,0,0,,Пикер…
Dialogue: 0,0:33:08.27,0:33:09.69,Default,,0,0,0,,Пикачу аа... аа
Dialogue: 0,0:33:10.03,0:33:12.40,Default,,0,0,0,,(Макото Piplup Esne)
Dialogue: 0,0:33:12.49,0:33:15.11,Default,,0,0,0,,Қайырлы таң Почама Поча~
Dialogue: 0,0:33:15.20,0:33:17.37,Default,,0,0,0,,Пика? иә? Ах
Dialogue: 0,0:33:18.20,0:33:20.66,Default,,0,0,0,,Энтей және басқалары... а
Dialogue: 0,0:33:21.91,0:33:23.41,Default,,0,0,0,,Ка... Каге?
Dialogue: 0,0:33:23.79,0:33:26.42,Default,,0,0,0,,Ах, Чармандер, көңіл-күйің қалай?
Dialogue: 0,0:33:26.50,0:33:28.59,Default,,0,0,0,,Каге Кагекато
Dialogue: 0,0:33:29.17,0:33:30.46,Default,,0,0,0,,Кагето
Dialogue: 0,0:33:30.55,0:33:31.84,Default,,0,0,0,,Пика Пикачу
Dialogue: 0,0:33:31.92,0:33:34.63,Default,,0,0,0,,Почапоча жылтыр
Dialogue: 0,0:33:34.72,0:33:37.47,Default,,0,0,0,,Шармандер, маған құйрығыңды көрсет.
Dialogue: 0,0:33:38.60,0:33:41.52,Default,,0,0,0,,Иә, құйрықтағы жалын да күшті.
Dialogue: 0,0:33:41.89,0:33:43.06,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:33:43.14,0:33:44.85,Default,,0,0,0,,Сізге жақсы Чармандер
Dialogue: 0,0:33:44.94,0:33:45.94,Default,,0,0,0,,Кейдж
Dialogue: 0,0:33:46.35,0:33:47.52,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:33:48.31,0:33:49.48,Default,,0,0,0,,Менімен бірге келгің келе ме?
Dialogue: 0,0:33:49.57,0:33:50.94,Default,,0,0,0,,Кейдж?
Dialogue: 0,0:33:51.02,0:33:52.74,Default,,0,0,0,,Менің досым бол
Dialogue: 0,0:33:52.82,0:33:53.86,Default,,0,0,0,,Пикачу
Dialogue: 0,0:34:00.91,0:34:01.91,Default,,0,0,0,,На
Dialogue: 0,0:34:04.75,0:34:06.62,Default,,0,0,0,,Кагеха
Dialogue: 0,0:34:06.96,0:34:09.21,Default,,0,0,0,,Жарайды ма? Кагето
Dialogue: 0,0:34:12.55,0:34:13.88,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:34:15.13,0:34:16.59,Default,,0,0,0,,Көлік ойыны
Dialogue: 0,0:34:20.35,0:34:22.39,Default,,0,0,0,,Шармандер, алыңыз!
Dialogue: 0,0:34:22.47,0:34:24.14,Default,,0,0,0,,Пиппикачу!
Dialogue: 0,0:34:24.22,0:34:26.81,Default,,0,0,0,,Сізге жақсы Сатоси Пикачу
Dialogue: 0,0:34:27.85,0:34:29.35,Default,,0,0,0,,Пеекапика почапоча...
Dialogue: 0,0:34:29.44,0:34:31.02,Default,,0,0,0,,Пи пика? Ча ча ча?
Dialogue: 0,0:34:32.44,0:34:34.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:34.49,0:34:36.03,Default,,0,0,0,,Бұл кемпірқосақ
Dialogue: 0,0:34:36.11,0:34:37.99,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:34:38.82,0:34:41.66,Default,,0,0,0,,Хо-о кемпірқосақтың етегінде тұрады дейді.
Dialogue: 0,0:34:41.74,0:34:43.04,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:34:46.87,0:34:48.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:51.54,0:34:55.21,Default,,0,0,0,,Бұл аңызға айналған кемпірқосақ шашырауының нұсқауы ма?
Dialogue: 0,0:34:57.97,0:35:00.26,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:35:04.56,0:35:07.85,Default,,0,0,0,,Райсен таулары – тік таулар тізбегі.
Dialogue: 0,0:35:08.19,0:35:09.19,Default,,0,0,0,,Иә
Dialogue: 0,0:35:10.23,0:35:11.61,Default,,0,0,0,,Мен шештім, иә?
Dialogue: 0,0:35:11.69,0:35:14.36,Default,,0,0,0,,Хо-омен кездесіп, онымен шайқасайық.
Dialogue: 0,0:35:18.61,0:35:20.32,Default,,0,0,0,,Мен де Хо-омен кездескім келеді.
Dialogue: 0,0:35:20.74,0:35:21.74,Default,,0,0,0,,Егер «дәптер» сөзі Death Note-ты білдірсе,
Dialogue: 0,0:35:22.12,0:35:25.29,Default,,0,0,0,,Ал аты аңызға айналған «Кемпірқосақ батыр» кім?
Dialogue: 0,0:35:25.37,0:35:26.87,Default,,0,0,0,,Өз көзіммен көргім келеді
Dialogue: 0,0:35:26.95,0:35:28.16,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:35:28.87,0:35:31.58,Default,,0,0,0,,Бәріміз Хо-омен кездесуге жолға шығайық!
Dialogue: 0,0:35:31.67,0:35:34.04,Default,,0,0,0,,Пикачу! Поча!
Dialogue: 0,0:35:35.25,0:35:36.80,Default,,0,0,0,,Мен жақсы сөздер естідім
Dialogue: 0,0:35:36.88,0:35:38.72,Default,,0,0,0,,Мен Энтеймен кездесе алмадым, бірақ...
Dialogue: 0,0:35:38.80,0:35:40.34,Default,,0,0,0,,Ал...
Dialogue: 0,0:35:40.43,0:35:42.47,Default,,0,0,0,,Өзін жақсы сезінеді
Dialogue: 0,0:35:43.51,0:35:45.43,Default,,0,0,0,,...
Dialogue: 0,0:35:47.02,0:35:48.02,Default,,0,0,0,,Міне.
Dialogue: 0,0:35:49.85,0:35:52.44,Default,,0,0,0,,Поча~! Пикачу
Dialogue: 0,0:35:58.49,0:36:01.32,Default,,0,0,0,,Кеттік. Бұл қате түріне арналған қате түрі.
Dialogue: 0,0:36:01.41,0:36:03.53,Default,,0,0,0,,Caterpie Мен сені таңдаймын
Dialogue: 0,0:36:04.74,0:36:06.79,Default,,0,0,0,,Кя~ Кя~
Dialogue: 0,0:36:07.20,0:36:08.95,Default,,0,0,0,,Кай Кай Ка~
Dialogue: 0,0:36:09.04,0:36:10.62,Default,,0,0,0,,Катерпи киім киеді
Dialogue: 0,0:36:11.00,0:36:12.04,Default,,0,0,0,,Ка... (Катерпи) Қалпақ
Dialogue: 0,0:36:16.38,0:36:18.76,Default,,0,0,0,,Каа Каа…
Dialogue: 0,0:36:18.84,0:36:20.84,Default,,0,0,0,,Керемет! Ах...
Dialogue: 0,0:36:21.13,0:36:23.18,Default,,0,0,0,,Ах... эволюция.
Dialogue: 0,0:36:23.26,0:36:24.34,Default,,0,0,0,,Пикер порты…
Dialogue: 0,0:36:26.43,0:36:28.02,Default,,0,0,0,,Мен Трансельге айналдым (Суджи Макото) Уау...
Dialogue: 0,0:36:29.73,0:36:31.31,Default,,0,0,0,,Поча~
Dialogue: 0,0:36:31.69,0:36:33.65,Default,,0,0,0,,Кайрош кетіп қалды.
Dialogue: 0,0:36:33.73,0:36:34.73,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:36:35.15,0:36:38.07,Default,,0,0,0,,Құттықтаймыз Трансель
Dialogue: 0,0:36:38.15,0:36:39.15,Default,,0,0,0,,Лансель
Dialogue: 0,0:36:39.57,0:36:41.57,Default,,0,0,0,,Пика Пикачу
Dialogue: 0,0:36:59.96,0:37:02.17,Default,,0,0,0,,Уфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфу
Dialogue: 0,0:37:10.56,0:37:11.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:25.24,0:37:26.24,Default,,0,0,0,,Ha
Dialogue: 0,0:37:36.83,0:37:37.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:45.34,0:37:46.97,Default,,0,0,0,,Иә? Суикюн?
Dialogue: 0,0:37:47.05,0:37:48.64,Default,,0,0,0,,Иә, мен көрдім.
Dialogue: 0,0:37:48.72,0:37:50.89,Default,,0,0,0,,Неге мені оятпадың?
Dialogue: 0,0:37:50.97,0:37:53.81,Default,,0,0,0,,Хмм... көзіміз түйіскендей...
Dialogue: 0,0:37:54.39,0:37:57.23,Default,,0,0,0,,Уақыт тоқтап қалған сияқты...
Dialogue: 0,0:37:57.48,0:38:00.15,Default,,0,0,0,,Мен дыбыс шығара алмадым
Dialogue: 0,0:38:00.44,0:38:02.65,Default,,0,0,0,,Гепард, бұл жақсы.
Dialogue: 0,0:38:02.73,0:38:05.20,Default,,0,0,0,,Энтейден кейін Суикюнені кездестіру үшін...
Dialogue: 0,0:38:05.28,0:38:07.07,Default,,0,0,0,,Бұл біршама сәттілік.
Dialogue: 0,0:38:07.82,0:38:09.16,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:38:09.95,0:38:12.16,Default,,0,0,0,,Анам да бақытты болады деп сенемін.
Dialogue: 0,0:38:12.45,0:38:13.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:13.54,0:38:17.83,Default,,0,0,0,,А... менің анам – туған жерінде атақты жаттықтырушы.
Dialogue: 0,0:38:17.92,0:38:20.29,Default,,0,0,0,,Мынаны істе, мынаны істе, тым қатты.
Dialogue: 0,0:38:20.38,0:38:23.51,Default,,0,0,0,,Мен сапарға шыққаннан бері сізбен бір рет хабарласқан жоқпын.
Dialogue: 0,0:38:25.92,0:38:28.64,Default,,0,0,0,,Анаңның бақытты болатынына сенімдімін.
Dialogue: 0,0:38:28.72,0:38:30.39,Default,,0,0,0,,А, шешілді.
Dialogue: 0,0:38:33.47,0:38:34.47,Default,,0,0,0,,Иә
Dialogue: 0,0:38:35.52,0:38:38.31,Default,,0,0,0,,Офуку пудингі
Dialogue: 0,0:38:38.40,0:38:39.52,Default,,0,0,0,,Пуи Плут
Dialogue: 0,0:38:40.56,0:38:42.77,Default,,0,0,0,,Шармандер бақадан жалтарады
Dialogue: 0,0:38:42.86,0:38:44.44,Default,,0,0,0,,Автокөлік ойыны
Dialogue: 0,0:38:47.07,0:38:48.82,Default,,0,0,0,,Шаш (жұлдыз) фуууууук
Dialogue: 0,0:38:50.70,0:38:54.95,Default,,0,0,0,,P… ri… pu… ri… ri… ri…
Dialogue: 0,0:38:55.04,0:38:57.54,Default,,0,0,0,,Сатосимен күресе алмаған пудинг жеңеді
Dialogue: 0,0:38:57.62,0:38:59.88,Default,,0,0,0,,Жақсы, Шармандер Жылтыр
Dialogue: 0,0:39:00.13,0:39:02.21,Default,,0,0,0,,Каргекагето
Dialogue: 0,0:39:03.21,0:39:05.42,Default,,0,0,0,,Қаргет
Dialogue: 0,0:39:06.72,0:39:07.72,Default,,0,0,0,,Сол
Dialogue: 0,0:39:08.01,0:39:09.63,Default,,0,0,0,,Ахх (кесіртке) Задо
Dialogue: 0,0:39:10.80,0:39:13.06,Default,,0,0,0,,Кесірткеге айналды
Dialogue: 0,0:39:13.14,0:39:15.85,Default,,0,0,0,,Жарайсың (Кесіртке)зар
Dialogue: 0,0:39:18.60,0:39:19.94,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Макотомын.
Dialogue: 0,0:39:20.02,0:39:21.06,Default,,0,0,0,,Почапоча
Dialogue: 0,0:39:21.15,0:39:22.69,Default,,0,0,0,,Бұл Суджи Ау
Dialogue: 0,0:39:23.23,0:39:26.86,Default,,0,0,0,,Сатоши үнемі қиындық тудырады, кешіріңіз.
Dialogue: 0,0:39:27.19,0:39:29.70,Default,,0,0,0,,Ол асығыс шығар, бірақ жүрегінде ол жақсы қыз.
Dialogue: 0,0:39:29.78,0:39:31.82,Default,,0,0,0,,Өтінемін, ашуланбай жақсы араласыңыз.
Dialogue: 0,0:39:31.91,0:39:34.28,Default,,0,0,0,,Анашым, мұны доғарыңыз.
Dialogue: 0,0:39:45.25,0:39:47.38,Default,,0,0,0,,Соуджи Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:39:47.46,0:39:52.30,Default,,0,0,0,,О, бұл керемет. Бұл кітап жақсы зерттелген. Тыңда.
Dialogue: 0,0:39:53.72,0:39:55.60,Default,,0,0,0,,«Хо-о аспандағы биіктен...»
Dialogue: 0,0:39:55.68,0:40:00.10,Default,,0,0,0,,«Адамдардың және Покемондардың әрекетінен бөлінетін бақыт дірілдерін сезініңіз»
Dialogue: 0,0:40:00.19,0:40:02.23,Default,,0,0,0,,«Одан энергия алыңыз»
Dialogue: 0,0:40:03.61,0:40:07.98,Default,,0,0,0,,«Керісінше, зұлым толқындар менің күшімді тартып алады».
Dialogue: 0,0:40:10.86,0:40:12.03,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:40:12.74,0:40:15.95,Default,,0,0,0,,«Кемпірқосақ, зұлым жүрекке қол тигізгенде...»
Dialogue: 0,0:40:16.83,0:40:18.37,Default,,0,0,0,,«Түсті жоғалту»
Dialogue: 0,0:40:18.87,0:40:20.46,Default,,0,0,0,,Жаман жүрек пе?
Dialogue: 0,0:40:20.54,0:40:22.33,Default,,0,0,0,,Түс жоғалды ма?
Dialogue: 0,0:40:24.33,0:40:26.04,Default,,0,0,0,,Менікі жақсы.
Dialogue: 0,0:40:26.34,0:40:29.26,Default,,0,0,0,,Ал, Сатоси қарапайым және асығыс, бірақ...
Dialogue: 0,0:40:29.34,0:40:31.63,Default,,0,0,0,,Сенің жүрегің жаман емес.
Dialogue: 0,0:40:31.72,0:40:32.72,Default,,0,0,0,,О
Dialogue: 0,0:40:32.80,0:40:35.01,Default,,0,0,0,,Қарапайым, асығыс болсаңыз, ұтылмайсыз.
Dialogue: 0,0:40:35.10,0:40:36.76,Default,,0,0,0,,(Суджи Макотоның күлкісі)
Dialogue: 0,0:40:36.85,0:40:40.73,Default,,0,0,0,,Күлме! (Суджи Макотоның күлкісі)
Dialogue: 0,0:40:41.18,0:40:42.73,Default,,0,0,0,,Кабит (адамдардың шуы)
Dialogue: 0,0:40:42.81,0:40:44.69,Default,,0,0,0,,Пикапи…
Dialogue: 0,0:40:45.31,0:40:47.11,Default,,0,0,0,,Ка... биі
Dialogue: 0,0:40:47.19,0:40:48.78,Default,,0,0,0,,Пикачу темір құйрығы
Dialogue: 0,0:40:48.86,0:40:50.99,Default,,0,0,0,,Пикака пішіні
Dialogue: 0,0:40:51.44,0:40:52.70,Default,,0,0,0,,Ааа
Dialogue: 0,0:40:54.66,0:40:55.78,Default,,0,0,0,,Пикка Каби
Dialogue: 0,0:40:56.62,0:40:58.20,Default,,0,0,0,,Пикачу 10манвольт
Dialogue: 0,0:40:58.29,0:41:00.33,Default,,0,0,0,,Пикачу!
Dialogue: 0,0:41:00.41,0:41:02.66,Default,,0,0,0,,Кабби
Dialogue: 0,0:41:05.67,0:41:06.96,Default,,0,0,0,,Кааааа…
Dialogue: 0,0:41:07.04,0:41:08.75,Default,,0,0,0,,Соғысқа қабілетсіз Снорлакс
Dialogue: 0,0:41:09.34,0:41:10.71,Default,,0,0,0,,Сатоси жеңеді
Dialogue: 0,0:41:10.80,0:41:12.17,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:41:12.26,0:41:13.84,Default,,0,0,0,,Пика Пика Жарайды.
Dialogue: 0,0:41:14.22,0:41:15.51,Default,,0,0,0,,Ярай (сот) содан кейін—
Dialogue: 0,0:41:15.59,0:41:18.89,Default,,0,0,0,,Сатошидің келесі қарсыласы кім болады?
Dialogue: 0,0:41:18.97,0:41:20.43,Default,,0,0,0,,Почама, кеттік, Поча
Dialogue: 0,0:41:20.52,0:41:21.77,Default,,0,0,0,,Бұл менмін (бәрі) Иә?
Dialogue: 0,0:41:21.85,0:41:22.93,Default,,0,0,0,,Пика? Хмм...
Dialogue: 0,0:41:26.81,0:41:27.90,Default,,0,0,0,,Ах, Пика
Dialogue: 0,0:41:28.36,0:41:29.82,Default,,0,0,0,,Крест иә?
Dialogue: 0,0:41:29.90,0:41:31.23,Default,,0,0,0,,Сонда ол Чармандер...
Dialogue: 0,0:41:31.32,0:41:32.32,Default,,0,0,0,,Иә Ча
Dialogue: 0,0:41:32.99,0:41:36.62,Default,,0,0,0,,Демек, сіз әлгі пайдасыз Шармандерді алдыңыз ба?
Dialogue: 0,0:41:37.16,0:41:39.78,Default,,0,0,0,,Сіз пайдалана алмайтын Покемон бар ма?
Dialogue: 0,0:41:39.87,0:41:41.58,Default,,0,0,0,,Шық, кесіртке
Dialogue: 0,0:41:43.29,0:41:45.21,Default,,0,0,0,,Лизард нүктесі…
Dialogue: 0,0:41:45.62,0:41:47.42,Default,,0,0,0,,Ол дамыды ма?
Dialogue: 0,0:41:47.75,0:41:51.38,Default,,0,0,0,,Бірақ дамығаннан кейін де әлсіздер әлсіз болып қала береді.
Dialogue: 0,0:41:51.67,0:41:53.34,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:41:53.42,0:41:56.30,Default,,0,0,0,,Жаттықтырушымен бірге көп жұмыс жасасаң, мықты боласың.
Dialogue: 0,0:41:56.38,0:41:59.97,Default,,0,0,0,,Әй, шық, менің ең күшті от түрім.
Dialogue: 0,0:42:00.06,0:42:01.60,Default,,0,0,0,,Гао Гаен Екі қол
Dialogue: 0,0:42:05.81,0:42:08.23,Default,,0,0,0,,(Гаоганның айқайы)
Dialogue: 0,0:42:08.61,0:42:10.65,Default,,0,0,0,,Бұл... Гао Гаен.
Dialogue: 0,0:42:12.86,0:42:14.07,Default,,0,0,0,,Оқ жаудыр!
Dialogue: 0,0:42:14.78,0:42:16.45,Default,,0,0,0,,Кесіртке
Dialogue: 0,0:42:16.53,0:42:17.91,Default,,0,0,0,,Лилия
Dialogue: 0,0:42:18.66,0:42:21.70,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:42:21.79,0:42:22.87,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:42:24.50,0:42:25.79,Default,,0,0,0,,Гугуу
Dialogue: 0,0:42:25.87,0:42:26.96,Default,,0,0,0,,Кирисакуда
Dialogue: 0,0:42:27.04,0:42:28.29,Default,,0,0,0,,Нүкте
Dialogue: 0,0:42:28.67,0:42:31.21,Default,,0,0,0,,Жасаңыз... Заа!
Dialogue: 0,0:42:31.29,0:42:33.96,Default,,0,0,0,,Гаен Гууу...
Dialogue: 0,0:42:34.05,0:42:35.34,Default,,0,0,0,,Жарайды
Dialogue: 0,0:42:35.67,0:42:38.05,Default,,0,0,0,,(Гаоганның ырылдауы)
Dialogue: 0,0:42:38.97,0:42:40.89,Default,,0,0,0,,Бұл біртүрлі, иә?
Dialogue: 0,0:42:41.60,0:42:44.35,Default,,0,0,0,,...
Dialogue: 0,0:42:44.43,0:42:48.81,Default,,0,0,0,,Зааааааа…
Dialogue: 0,0:42:49.65,0:42:51.40,Default,,0,0,0,,Ит Гает
Dialogue: 0,0:42:51.48,0:42:56.82,Default,,0,0,0,,Зааааааа... нүкте
Dialogue: 0,0:42:56.90,0:42:59.53,Default,,0,0,0,,Гаен (адамдардың айқайы)
Dialogue: 0,0:43:01.53,0:43:03.91,Default,,0,0,0,,Гаин...
Dialogue: 0,0:43:03.99,0:43:05.87,Default,,0,0,0,,Уақыт келді, Гао Гаен.
Dialogue: 0,0:43:05.95,0:43:08.29,Default,,0,0,0,,Гау Гаен
Dialogue: 0,0:43:08.37,0:43:10.17,Default,,0,0,0,,Кесіртке Каенхоша
Dialogue: 0,0:43:10.25,0:43:11.25,Default,,0,0,0,,Лит
Dialogue: 0,0:43:11.58,0:43:12.96,Default,,0,0,0,,Бұл да Каенхуша
Dialogue: 0,0:43:13.04,0:43:15.92,Default,,0,0,0,,Ооооооо...
Dialogue: 0,0:43:17.97,0:43:18.97,Default,,0,0,0,,Бұл
Dialogue: 0,0:43:23.35,0:43:24.76,Default,,0,0,0,,Лизард Пика
Dialogue: 0,0:43:24.85,0:43:26.06,Default,,0,0,0,,У... бұл…
Dialogue: 0,0:43:26.27,0:43:27.89,Default,,0,0,0,,А... Түсіндім.
Dialogue: 0,0:43:27.98,0:43:28.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:29.69,0:43:31.23,Default,,0,0,0,,Бұл Гаоган —
Dialogue: 0,0:43:31.31,0:43:33.57,Default,,0,0,0,,Зақым алған кезде қуат артады.
Dialogue: 0,0:43:33.82,0:43:34.90,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:43:34.98,0:43:37.19,Default,,0,0,0,,Мен бір әдіспен соққыға баттым.
Dialogue: 0,0:43:37.99,0:43:40.36,Default,,0,0,0,,Кесіртке
Dialogue: 0,0:43:40.45,0:43:42.78,Default,,0,0,0,,Заа… нүкте нүкте... ааа
Dialogue: 0,0:43:42.87,0:43:44.49,Default,,0,0,0,,А, бұл тым жылдам.
Dialogue: 0,0:43:44.58,0:43:46.75,Default,,0,0,0,,Дамыған күшке ілесе алмаймын.
Dialogue: 0,0:43:46.83,0:43:48.00,Default,,0,0,0,,Не? Міне -
Dialogue: 0,0:43:48.08,0:43:49.79,Default,,0,0,0,,Күшке сенбеу
Dialogue: 0,0:43:50.00,0:43:51.12,Default,,0,0,0,,Өрт азу тістері
Dialogue: 0,0:43:51.21,0:43:54.59,Default,,0,0,0,,Отбасымнан алыста~!
Dialogue: 0,0:43:56.96,0:43:58.42,Default,,0,0,0,,Гао гах
Dialogue: 0,0:43:58.88,0:43:59.88,Default,,0,0,0,,Джигокузуки
Dialogue: 0,0:44:00.30,0:44:02.18,Default,,0,0,0,,Гаога…
Dialogue: 0,0:44:02.26,0:44:06.06,Default,,0,0,0,,Нүкте уууууууу...
Dialogue: 0,0:44:06.14,0:44:07.27,Default,,0,0,0,,Пикер
Dialogue: 0,0:44:09.89,0:44:12.02,Default,,0,0,0,,Зард…
Dialogue: 0,0:44:12.69,0:44:14.77,Default,,0,0,0,,Зард... Ах...
Dialogue: 0,0:44:14.86,0:44:16.61,Default,,0,0,0,,Риза... аа...
Dialogue: 0,0:44:16.69,0:44:17.86,Default,,0,0,0,,Аяқтаймыз
Dialogue: 0,0:44:17.94,0:44:19.49,Default,,0,0,0,,...
Dialogue: 0,0:44:19.94,0:44:23.41,Default,,0,0,0,,Мен жеңілуге шыдай алмаймын.
Dialogue: 0,0:44:23.49,0:44:24.49,Default,,0,0,0,,Жоқ, Сатоси
Dialogue: 0,0:44:25.24,0:44:27.12,Default,,0,0,0,,Гаоооооооо...
Dialogue: 0,0:44:27.20,0:44:28.62,Default,,0,0,0,,...
Dialogue: 0,0:44:28.70,0:44:30.50,Default,,0,0,0,,Гах... аа...
Dialogue: 0,0:44:31.66,0:44:32.75,Default,,0,0,0,,...
Dialogue: 0,0:44:32.83,0:44:34.42,Default,,0,0,0,,Жақсы
Dialogue: 0,0:44:34.50,0:44:37.17,Default,,0,0,0,,Заааааах
Dialogue: 0,0:44:40.63,0:44:42.09,Default,,0,0,0,,кесіртке
Dialogue: 0,0:44:42.18,0:44:45.01,Default,,0,0,0,,Уау… бұл…
Dialogue: 0,0:44:45.10,0:44:48.43,Default,,0,0,0,,Гаоганмен күресе алмаған кесіртке жеңеді
Dialogue: 0,0:44:48.52,0:44:50.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:50.48,0:44:52.48,Default,,0,0,0,,Зард…
Dialogue: 0,0:44:52.98,0:44:55.02,Default,,0,0,0,,Бұл тәтті, а
Dialogue: 0,0:44:55.31,0:44:57.15,Default,,0,0,0,,Арзан достық орнату -
Dialogue: 0,0:44:57.23,0:45:01.19,Default,,0,0,0,,Нашар нұсқаулармен Покемон жеңіліске ұшырады.
Dialogue: 0,0:45:01.28,0:45:03.99,Default,,0,0,0,,Сіз ең нашар жаттықтырушысыз.
Dialogue: 0,0:45:04.32,0:45:06.28,Default,,0,0,0,,Жаттықтырушы дисквалификацияланды
Dialogue: 0,0:45:06.66,0:45:08.49,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:45:09.91,0:45:12.21,Default,,0,0,0,,(қалпына келтіру қоңырауы)
Dialogue: 0,0:45:12.29,0:45:15.79,Default,,0,0,0,,Сіз қабылдаған Покемон қазір сау.
Dialogue: 0,0:45:15.88,0:45:17.63,Default,,0,0,0,,Рахмет
Dialogue: 0,0:45:18.42,0:45:21.34,Default,,0,0,0,,Көңіліңді көтер, Пика.
Dialogue: 0,0:45:23.26,0:45:26.47,Default,,0,0,0,,Дыбыстық сигнал сигналдық сигнал
Dialogue: 0,0:45:29.47,0:45:33.02,Default,,0,0,0,,Бұл жігіт жаттықтырушы ретінде қателеседі.
Dialogue: 0,0:45:33.31,0:45:35.44,Default,,0,0,0,,Сондықтан мен жеңіле алмаймын.
Dialogue: 0,0:45:35.52,0:45:36.81,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:45:37.23,0:45:40.48,Default,,0,0,0,,Бірақ оның өз сенімін жоққа шығаруға болмайды.
Dialogue: 0,0:45:40.57,0:45:42.24,Default,,0,0,0,,Шындығында ол Гао Гаен екеуі...
Dialogue: 0,0:45:42.32,0:45:45.03,Default,,0,0,0,,Бізді нығая түсеміз деген сенім біріктірді.
Dialogue: 0,0:45:45.41,0:45:49.16,Default,,0,0,0,,Бірақ мұндай жігіттің жеңетіні біртүрлі.
Dialogue: 0,0:45:49.37,0:45:52.20,Default,,0,0,0,,Біріншіден, жеңілгеніңізді мойындаңыз.
Dialogue: 0,0:45:52.29,0:45:54.12,Default,,0,0,0,,Себебі мен жеңілгеніме өкінемін —
Dialogue: 0,0:45:54.21,0:45:57.54,Default,,0,0,0,,Келесі жолы жеңгім келеді, бар күшімді салғым келеді.
Dialogue: 0,0:45:58.04,0:45:59.92,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:46:00.55,0:46:01.59,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:46:03.47,0:46:04.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:05.51,0:46:07.43,Default,,0,0,0,,Пикачу жеңуі мүмкін еді.
Dialogue: 0,0:46:07.51,0:46:09.05,Default,,0,0,0,,Pi? Олай десеңіз...
Dialogue: 0,0:46:09.14,0:46:10.89,Default,,0,0,0,,Кесірткіні аямайсың ба?
Dialogue: 0,0:46:10.97,0:46:11.97,Default,,0,0,0,,Пикер?
Dialogue: 0,0:46:12.81,0:46:13.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:15.77,0:46:17.31,Default,,0,0,0,,Егер сіз тек жеңіс туралы ойласаңыз —
Dialogue: 0,0:46:18.02,0:46:19.90,Default,,0,0,0,,Сіз Крест сияқтысыз.
Dialogue: 0,0:46:20.48,0:46:21.57,Default,,0,0,0,,Ку (Суджи Макото) Ах
Dialogue: 0,0:46:21.65,0:46:22.69,Default,,0,0,0,,Пикапи
Dialogue: 0,0:46:22.78,0:46:25.11,Default,,0,0,0,,Сатоси, күте тұрыңыз.
Dialogue: 0,0:46:35.91,0:46:38.29,Default,,0,0,0,,Олар неткен бастық?
Dialogue: 0,0:46:38.37,0:46:39.67,Default,,0,0,0,,Пикер
Dialogue: 0,0:46:40.04,0:46:41.96,Default,,0,0,0,,Пикачу да солай ойлайды, солай ма?
Dialogue: 0,0:46:42.05,0:46:43.13,Default,,0,0,0,,Пикачу
Dialogue: 0,0:46:43.21,0:46:44.63,Default,,0,0,0,,Сіз бұл менің кінәм деп айтасыз ба?
Dialogue: 0,0:46:44.71,0:46:46.09,Default,,0,0,0,,Пикер…
Dialogue: 0,0:46:47.88,0:46:50.09,Default,,0,0,0,,Қарғыс атсын, Пикачу не болды?
Dialogue: 0,0:46:50.18,0:46:51.18,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:46:57.10,0:46:58.52,Default,,0,0,0,,Пикер
Dialogue: 0,0:46:59.94,0:47:01.15,Default,,0,0,0,,Хаа…
Dialogue: 0,0:47:01.73,0:47:05.15,Default,,0,0,0,,Егер менің алғашқы Покемоным Сквиртл немесе Булбасавр болса ше?
Dialogue: 0,0:47:05.24,0:47:06.24,Default,,0,0,0,,Pi?
Dialogue: 0,0:47:06.74,0:47:07.82,Default,,0,0,0,,Пикер
Dialogue: 0,0:47:08.07,0:47:09.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:34.93,0:47:35.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:45.94,0:47:47.36,Default,,0,0,0,,Пикачу…
Dialogue: 0,0:47:48.36,0:47:49.95,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:47:57.16,0:48:00.67,Default,,0,0,0,,Мен Хо-Оның таңдаған жаттықтырушысымын.
Dialogue: 0,0:48:03.54,0:48:05.75,Default,,0,0,0,,Пикачу жоқ болса да...
Dialogue: 0,0:48:05.84,0:48:08.67,Default,,0,0,0,,Менде бәрі жақсы...
Dialogue: 0,0:48:33.78,0:48:35.70,Default,,0,0,0,,Сатоси, сен қанша ұйықтайсың?
Dialogue: 0,0:48:36.12,0:48:38.24,Default,,0,0,0,,Сіз сабаққа кешігіп қаласыз, солай ма?
Dialogue: 0,0:48:38.33,0:48:39.75,Default,,0,0,0,,Бірге үйге барамыз дедім, бірақ Ишикава-кун келмей-ақ қойды, түсінесің бе
Dialogue: 0,0:48:39.83,0:48:40.83,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:48:41.62,0:48:44.88,Default,,0,0,0,,Мама, мені неге оятпадың... Ахх
Dialogue: 0,0:48:44.96,0:48:48.30,Default,,0,0,0,,Сіз 10-ға толғанда өз бетіңізше оянамын дедіңіз.
Dialogue: 0,0:48:53.97,0:48:55.43,Default,,0,0,0,,Профессор Окидо
Dialogue: 0,0:48:55.51,0:48:57.22,Default,,0,0,0,,О, Сатоши-кун хахаха...
Dialogue: 0,0:48:57.31,0:48:59.14,Default,,0,0,0,,Сіз оны уақытында орындадыңыз ба?
Dialogue: 0,0:48:59.22,0:49:03.73,Default,,0,0,0,,Бүгін кешігіп келген төрт оқушы болды, ал сіз соңғы болып қалдыңыз.
Dialogue: 0,0:49:04.56,0:49:05.73,Default,,0,0,0,,Хаа…
Dialogue: 0,0:49:07.36,0:49:08.73,Default,,0,0,0,,Сатоси, сен кешігіп қалдың.
Dialogue: 0,0:49:09.15,0:49:10.74,Default,,0,0,0,,Мен біраз ұйықтап қалдым.
Dialogue: 0,0:49:10.82,0:49:11.82,Default,,0,0,0,,Үй тапсырмасы туралы не айтасыз?
Dialogue: 0,0:49:11.90,0:49:13.24,Default,,0,0,0,,А, мен ұмытып қалдым.
Dialogue: 0,0:49:13.32,0:49:15.82,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:49:16.32,0:49:17.70,Default,,0,0,0,,Хаа…
Dialogue: 0,0:49:17.78,0:49:18.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:20.08,0:49:21.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:21.33,0:49:22.91,Default,,0,0,0,,О? не болды?
Dialogue: 0,0:49:23.41,0:49:25.29,Default,,0,0,0,,Ештеңе емес.
Dialogue: 0,0:49:25.38,0:49:26.75,Default,,0,0,0,,Қызық екен
Dialogue: 0,0:49:26.92,0:49:31.09,Default,,0,0,0,,Кемпірқосақ күн сәулесінің атмосферадағы ылғалға ауысуынан пайда болады.
Dialogue: 0,0:49:31.17,0:49:35.59,Default,,0,0,0,,Рефракция Рефлексия арқылы жасалған
Dialogue: 0,0:49:35.89,0:49:37.51,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:49:40.22,0:49:41.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:52.69,0:49:54.78,Default,,0,0,0,,Сіз оны қанша уақыттан бері қарайсыз? иә?
Dialogue: 0,0:49:55.61,0:49:57.62,Default,,0,0,0,,Мен мұндай көріністі көруден шаршадым.
Dialogue: 0,0:49:57.70,0:49:59.08,Default,,0,0,0,,Сіз не ойладыңыз?
Dialogue: 0,0:49:59.28,0:50:00.28,Default,,0,0,0,,Иә
Dialogue: 0,0:50:01.41,0:50:04.00,Default,,0,0,0,,Алда не күтіп тұр деп ойлаймын
Dialogue: 0,0:50:04.54,0:50:05.83,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:50:05.92,0:50:08.92,Default,,0,0,0,,Орман, өзен, тау... бар.
Dialogue: 0,0:50:09.00,0:50:11.21,Default,,0,0,0,,Менің ойымша, басқа қала болады.
Dialogue: 0,0:50:11.46,0:50:12.92,Default,,0,0,0,,Төзімді бол, көмекші!
Dialogue: 0,0:50:13.01,0:50:16.93,Default,,0,0,0,,Сондай-ақ ормандар мен өзендер бар, олар көп ұзамай теңізге жетуі мүмкін.
Dialogue: 0,0:50:17.01,0:50:18.39,Default,,0,0,0,,Төзімді бол, көмекші!
Dialogue: 0,0:50:18.97,0:50:21.06,Default,,0,0,0,,Мен бұл қайта-қайта бірдей болатынына сенімдімін
Dialogue: 0,0:50:21.14,0:50:22.56,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:50:23.93,0:50:26.10,Default,,0,0,0,,Бармайынша білмейсің
Dialogue: 0,0:50:26.52,0:50:30.11,Default,,0,0,0,,Мен онда не бар екенін көргім келеді.
Dialogue: 0,0:50:30.19,0:50:32.36,Default,,0,0,0,,Саяхаттау көңілді естіледі.
Dialogue: 0,0:50:32.44,0:50:35.57,Default,,0,0,0,,Уақытты ойлама, еркін жүр
Dialogue: 0,0:50:35.65,0:50:39.37,Default,,0,0,0,,Белгісіз жерде әртүрлі заттарды бірінші рет кездестіру
Dialogue: 0,0:50:39.45,0:50:43.08,Default,,0,0,0,,Түнде жұлдыздарға қарап, жолдастарыңызбен сөйлесіңіз.
Dialogue: 0,0:50:43.16,0:50:44.16,Default,,0,0,0,,Және…
Dialogue: 0,0:50:44.62,0:50:47.29,Default,,0,0,0,,Егер ол менімен болса, мен кез келген жерге бара аламын.
Dialogue: 0,0:50:47.37,0:50:49.54,Default,,0,0,0,,Ол... Ол кім?
Dialogue: 0,0:50:49.63,0:50:53.30,Default,,0,0,0,,Бұл шешілді, солай ма? әрқашан менің жанымда
Dialogue: 0,0:50:53.59,0:50:55.51,Default,,0,0,0,,Мм... жанымда...
Dialogue: 0,0:50:55.59,0:50:56.67,Default,,0,0,0,,Пика
Dialogue: 0,0:51:03.06,0:51:05.27,Default,,0,0,0,,Мм... Сатоси, сен жылап тұрсың ба?
Dialogue: 0,0:51:05.35,0:51:07.10,Default,,0,0,0,,Жоқ, неге...
Dialogue: 0,0:51:07.19,0:51:08.48,Default,,0,0,0,,Қазір жақсы болыңыз.
Dialogue: 0,0:51:08.56,0:51:09.90,Default,,0,0,0,,Амансың ба? Сатоси
Dialogue: 0,0:51:15.32,0:51:16.32,Default,,0,0,0,,Ах
Dialogue: 0,0:51:19.32,0:51:20.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:21.03,0:51:22.37,Default,,0,0,0,,Пика?
Dialogue: 0,0:51:23.66,0:51:25.08,Default,,0,0,0,,Ha
Dialogue: 0,0:51:28.37,0:51:30.63,Default,,0,0,0,,О... күте тұрыңыз.
Dialogue: 0,0:51:32.46,0:51:39.01,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:51:43.22,0:51:46.56,Default,,0,0,0,,Иә, осылайша бірге жүгірдік.
Dialogue: 0,0:51:47.60,0:51:49.56,Default,,0,0,0,,Онда мен осы ниетті қабылдаймын.
Dialogue: 0,0:51:50.06,0:51:52.06,Default,,0,0,0,,Мен сені есіме түсіре алмаймын
Dialogue: 0,0:51:52.15,0:51:55.07,Default,,0,0,0,,Ол менің ең маңызды досым болды.
Dialogue: 0,0:51:55.15,0:51:59.99,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:52:00.86,0:52:02.82,Default,,0,0,0,,Уа, ау, ау...
Dialogue: 0,0:52:02.91,0:52:03.91,Default,,0,0,0,,Барма!
Dialogue: 0,0:52:12.33,0:52:14.34,Default,,0,0,0,,Пика га
Dialogue: 0,0:52:14.67,0:52:15.71,Default,,0,0,0,,Пикапи
Dialogue: 0,0:52:15.80,0:52:17.30,Default,,0,0,0,,Пикачу
Dialogue: 0,0:52:19.67,0:52:24.39,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,0:52:24.47,0:52:28.10,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:52:28.18,0:52:29.81,Default,,0,0,0,,Пикапи...
Dialogue: 0,0:52:31.02,0:52:32.23,Default,,0,0,0,,Пикачу?
Dialogue: 0,0:52:33.31,0:52:35.40,Default,,0,0,0,,Га Пикачу
Dialogue: 0,0:52:37.82,0:52:40.99,Default,,0,0,0,,Пикачу Бұл менің кінәм болды
Dialogue: 0,0:52:41.07,0:52:43.20,Default,,0,0,0,,Пика, кешіріңіз.
Dialogue: 0,0:52:44.12,0:52:46.95,Default,,0,0,0,,Мен... Мен...
Dialogue: 0,0:52:48.08,0:52:49.91,Default,,0,0,0,,Хэхе, ах
Dialogue: 0,0:52:54.04,0:52:55.84,Default,,0,0,0,,Сатоси Иә
Dialogue: 0,0:52:55.92,0:52:58.42,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:52:58.50,0:53:00.51,Default,,0,0,0,,Мен оны іздеп қойғанмын.
Dialogue: 0,0:53:00.59,0:53:01.67,Default,,0,0,0,,Поча
Dialogue: 0,0:53:02.34,0:53:03.97,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:53:04.05,0:53:06.76,Default,,0,0,0,,Сіз әр шайқаста жеңесіз бе?
Dialogue: 0,0:53:07.05,0:53:10.35,Default,,0,0,0,,Жаттықтырушының шынайы құндылығы жеңілген кезде тексеріледі.
Dialogue: 0,0:53:11.64,0:53:13.19,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:53:14.94,0:53:15.94,Default,,0,0,0,,Иә
Dialogue: 0,0:53:18.19,0:53:19.19,Default,,0,0,0,,Кесіртке…
Dialogue: 0,0:53:20.53,0:53:21.78,Default,,0,0,0,,(Шиозаки) «Кісі өлтіруші» дегенің не?
Dialogue: 0,0:53:23.45,0:53:26.53,Default,,0,0,0,,Покемонның бар екенін ұмытып кеткеніме де сене алмаймын...
Dialogue: 0,0:53:26.62,0:53:29.33,Default,,0,0,0,,Түсімде болса да, мен мұны мүлдем жек көремін.
Dialogue: 0,0:53:29.41,0:53:31.87,Default,,0,0,0,,Бірақ сіз Покемонды жоғалтуыңыз мүмкін.
Dialogue: 0,0:53:31.95,0:53:32.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:36.63,0:53:39.55,Default,,0,0,0,,Ата-анам жұмыста жиі болатын...
Dialogue: 0,0:53:39.63,0:53:41.80,Default,,0,0,0,,Жалға беруші әрқашан менің ата-анам болды.
Dialogue: 0,0:53:42.17,0:53:44.30,Default,,0,0,0,,Сен менімен бірге болдың.
Dialogue: 0,0:53:46.01,0:53:49.85,Default,,0,0,0,,Бірақ сол күні мен жалғыз шықтым...
Dialogue: 0,0:53:49.93,0:53:54.27,Default,,0,0,0,,(Лентлердің айқайы және есте сақтау)
Dialogue: 0,0:53:55.39,0:53:58.27,Default,,0,0,0,,(Лентлердің айқайы)
Dialogue: 0,0:53:58.65,0:53:59.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:54:06.20,0:54:07.87,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:54:07.95,0:54:10.45,Default,,0,0,0,,(Лентлердің айқайы)
Dialogue: 0,0:54:12.50,0:54:14.21,Default,,0,0,0,,Лентлер
Dialogue: 0,0:54:15.04,0:54:17.67,Default,,0,0,0,,(Жас Соуджидің ұйықтауы)
Dialogue: 0,0:54:24.30,0:54:25.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:26.76,0:54:27.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:36.23,0:54:37.69,Default,,0,0,0,,Лентлер?
Dialogue: 0,0:54:38.35,0:54:39.44,Default,,0,0,0,,Жалға алушы!
Dialogue: 0,0:54:40.90,0:54:44.19,Default,,0,0,0,,Жалға алушы!
Dialogue: 0,0:54:50.62,0:54:51.62,Default,,0,0,0,,Содан кейін—
Dialogue: 0,0:54:52.24,0:54:55.58,Default,,0,0,0,,Мен Покемонмен дос болудан қорқамын...
Dialogue: 0,0:54:57.00,0:55:01.13,Default,,0,0,0,,Мені құтқарған Лукариомен кездесуім болды.
Dialogue: 0,0:55:01.21,0:55:02.21,Default,,0,0,0,,Ау
Dialogue: 0,0:55:02.75,0:55:04.17,Default,,0,0,0,,көремін.
Dialogue: 0,0:55:04.26,0:55:06.38,Default,,0,0,0,,Поча Пикак
Dialogue: 0,0:55:09.89,0:55:11.60,Default,,0,0,0,,Пика? иә?
Dialogue: 0,0:55:12.18,0:55:13.26,Default,,0,0,0,,Жылтыр
Dialogue: 0,0:55:13.35,0:55:14.60,Default,,0,0,0,,Иә? Ал қазір ше?
Dialogue: 0,0:55:14.68,0:55:15.68,Default,,0,0,0,,Покемон?
Dialogue: 0,0:55:15.77,0:55:19.40,Default,,0,0,0,,Пикачу!
Dialogue: 0,0:55:22.82,0:55:24.61,Default,,0,0,0,,Иә
Dialogue: 0,0:55:24.69,0:55:27.15,Default,,0,0,0,,(Окоризалдардың айқайы)
Dialogue: 0,0:55:27.24,0:55:28.49,Default,,0,0,0,,Ой, бұл Окоризал.
Dialogue: 0,0:55:28.57,0:55:30.99,Default,,0,0,0,,Ашуланғаннан кейін ештеңе істей алмайсың.
Dialogue: 0,0:55:31.57,0:55:32.83,Default,,0,0,0,,(Окоризалдың айқайы)
Dialogue: 0,0:55:33.83,0:55:35.16,Default,,0,0,0,,Уау
Dialogue: 0,0:55:35.24,0:55:37.25,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:55:38.00,0:55:41.04,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:55:41.13,0:55:42.67,Default,,0,0,0,,Уау, Пика
Dialogue: 0,0:55:42.75,0:55:44.59,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:55:44.67,0:55:46.30,Default,,0,0,0,,Ух... Сатоши Трансель.
Dialogue: 0,0:55:46.38,0:55:47.88,Default,,0,0,0,,Иә, неге?
Dialogue: 0,0:55:47.97,0:55:50.80,Default,,0,0,0,,Нашар шабуыл жасасаңыз, одан бетер ашуланасыз.
Dialogue: 0,0:55:50.89,0:55:52.18,Default,,0,0,0,,Түсіндім, иә.
Dialogue: 0,0:55:58.85,0:56:00.23,Default,,0,0,0,,...
Dialogue: 0,0:56:01.90,0:56:03.44,Default,,0,0,0,,...
Dialogue: 0,0:56:03.52,0:56:04.52,Default,,0,0,0,,Транс
Dialogue: 0,0:56:11.91,0:56:14.33,Default,,0,0,0,,Ашуланба, Окоризал.
Dialogue: 0,0:56:14.41,0:56:16.04,Default,,0,0,0,,Жақсы жұмыс Transel
Dialogue: 0,0:56:16.12,0:56:17.41,Default,,0,0,0,,Лансель
Dialogue: 0,0:56:17.91,0:56:19.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:22.29,0:56:24.25,Default,,0,0,0,,Тегін ~ Тегін ~
Dialogue: 0,0:56:24.34,0:56:25.84,Default,,0,0,0,,Майсызға айналды
Dialogue: 0,0:56:26.25,0:56:28.51,Default,,0,0,0,,(Окоризалдардың ырылдаған дыбыстары)
Dialogue: 0,0:56:29.05,0:56:30.42,Default,,0,0,0,,Мен сізді бақылап жүрмін.
Dialogue: 0,0:56:30.97,0:56:32.72,Default,,0,0,0,,Майсыз ұйықтайтын гона
Dialogue: 0,0:56:32.80,0:56:33.80,Default,,0,0,0,,жұма
Dialogue: 0,0:56:37.68,0:56:44.61,Default,,0,0,0,,Тегін
Dialogue: 0,0:56:50.61,0:56:52.61,Default,,0,0,0,,Тегін ~ Тегін ~
Dialogue: 0,0:56:52.82,0:56:54.28,Default,,0,0,0,,Бұл таңғажайып Butterfree Wow!
Dialogue: 0,0:56:54.37,0:56:55.70,Default,,0,0,0,,Жылтыр
Dialogue: 0,0:56:55.78,0:56:57.74,Default,,0,0,0,,Қазір уақыт келді.
Dialogue: 0,0:56:57.83,0:56:59.54,Default,,0,0,0,,Тегін ~ Тегін ~
Dialogue: 0,0:56:59.62,0:57:01.29,Default,,0,0,0,,(Окоризалдың ұйықтау тынысы)
Dialogue: 0,0:57:01.37,0:57:04.38,Default,,0,0,0,,Мияу ня... мияу ня ня
Dialogue: 0,0:57:04.46,0:57:06.29,Default,,0,0,0,,Околи маймылдары көп
Dialogue: 0,0:57:06.38,0:57:08.21,Default,,0,0,0,,Олардың барлығы ұйықтап жатыр.
Dialogue: 0,0:57:08.30,0:57:10.13,Default,,0,0,0,,Барлығын біріктіріңіз.
Dialogue: 0,0:57:10.38,0:57:11.80,Default,,0,0,0,,О
Dialogue: 0,0:57:12.13,0:57:13.59,Default,,0,0,0,,Укья! иә?
Dialogue: 0,0:57:14.14,0:57:17.18,Default,,0,0,0,,Е-е, уау!
Dialogue: 0,0:57:18.85,0:57:19.89,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:57:19.97,0:57:22.81,Default,,0,0,0,,Қандай сезім!
Dialogue: 0,0:57:31.36,0:57:33.49,Default,,0,0,0,,Бұл өзен, оны маған қалдырыңыз.
Dialogue: 0,0:57:33.82,0:57:36.57,Default,,0,0,0,,Енді сіздің кезегіңіз, Лаплас.
Dialogue: 0,0:57:38.20,0:57:39.24,Default,,0,0,0,,Ei
Dialogue: 0,0:57:42.29,0:57:43.66,Default,,0,0,0,,Ла~
Dialogue: 0,0:57:43.75,0:57:46.08,Default,,0,0,0,,О, хехехе
Dialogue: 0,0:57:46.17,0:57:48.34,Default,,0,0,0,,Тегін ~ Тегін ~
Dialogue: 0,0:57:48.42,0:57:50.96,Default,,0,0,0,,Пика Пикка Поча~
Dialogue: 0,0:58:06.85,0:58:09.69,Default,,0,0,0,,Почача жылтыр
Dialogue: 0,0:58:09.77,0:58:11.19,Default,,0,0,0,,Пика?
Dialogue: 0,0:58:13.07,0:58:15.20,Default,,0,0,0,,Тегін! (Онидрилл дыбысы)
Dialogue: 0,0:58:17.32,0:58:20.12,Default,,0,0,0,,(Онидрилл Баттерфридің айқайы)
Dialogue: 0,0:58:20.49,0:58:22.04,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:58:22.29,0:58:24.79,Default,,0,0,0,,Жарайды, Сарымсақ, мен сені таңдадым.
Dialogue: 0,0:58:27.92,0:58:29.13,Default,,0,0,0,,Тегін ~ Тегін ~
Dialogue: 0,0:58:29.34,0:58:31.92,Default,,0,0,0,,Бос ~ беріліс ааааа
Dialogue: 0,0:58:32.21,0:58:33.84,Default,,0,0,0,,Тегін~
Dialogue: 0,0:58:34.13,0:58:35.67,Default,,0,0,0,,Тегін...
Dialogue: 0,0:58:36.68,0:58:39.01,Default,,0,0,0,,Гаааааааааааааа (майсыз) Ааа... Тегін~
Dialogue: 0,0:58:39.09,0:58:40.93,Default,,0,0,0,,Майсыз салқындатқыш
Dialogue: 0,0:58:41.01,0:58:42.60,Default,,0,0,0,,Фури Фури~
Dialogue: 0,0:58:42.68,0:58:46.60,Default,,0,0,0,,(Онидриллдің айқайы)
Dialogue: 0,0:58:46.69,0:58:47.85,Default,,0,0,0,,Тегін...
Dialogue: 0,0:58:47.94,0:58:50.06,Default,,0,0,0,,Тегін~ Фурифури~
Dialogue: 0,0:58:50.15,0:58:51.52,Default,,0,0,0,,Тегін
Dialogue: 0,0:58:51.61,0:58:53.57,Default,,0,0,0,,Жақсы пикачу
Dialogue: 0,0:58:53.65,0:58:55.82,Default,,0,0,0,,Сары майдың түсі басқа.
Dialogue: 0,0:58:55.90,0:58:57.45,Default,,0,0,0,,сүйкімді нәрсе
Dialogue: 0,0:58:57.53,0:58:59.49,Default,,0,0,0,,Фурифури
Dialogue: 0,0:58:59.57,0:59:01.37,Default,,0,0,0,,Фурифури~ (майсыз) Фурифури
Dialogue: 0,0:59:01.62,0:59:03.54,Default,,0,0,0,,А... анау қыз қыз ғой.
Dialogue: 0,0:59:03.62,0:59:05.45,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:59:05.70,0:59:06.71,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:59:06.79,0:59:11.71,Default,,0,0,0,,(Майдансыз айқай)
Dialogue: 0,0:59:20.80,0:59:22.97,Default,,0,0,0,,Поча Поча Пика Пика Пикка
Dialogue: 0,0:59:23.06,0:59:24.14,Default,,0,0,0,,Уау... болды.
Dialogue: 0,0:59:24.52,0:59:27.69,Default,,0,0,0,,Кемпірқосақ түбінде, Көтерілген таулар
Dialogue: 0,0:59:28.14,0:59:30.10,Default,,0,0,0,,Уау...
Dialogue: 0,0:59:31.81,0:59:32.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:36.53,0:59:37.53,Default,,0,0,0,,Ах
Dialogue: 0,0:59:40.20,0:59:42.91,Default,,0,0,0,,Тенсей тауы - ең биік тау сілемі.
Dialogue: 0,0:59:43.95,0:59:46.58,Default,,0,0,0,,О, сонда барғың келе ме?
Dialogue: 0,0:59:46.66,0:59:47.66,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:59:47.75,0:59:49.58,Default,,0,0,0,,Мен жақында Хо-омен кездесемін.
Dialogue: 0,0:59:49.67,0:59:50.75,Default,,0,0,0,,Пикер
Dialogue: 0,0:59:50.83,0:59:52.63,Default,,0,0,0,,Кеттік, Пикачу, Пикачу
Dialogue: 0,0:59:53.00,0:59:55.55,Default,,0,0,0,,Поча Поча Поча Сатоши
Dialogue: 0,0:59:56.09,0:59:57.09,Default,,0,0,0,,Сіз естідіңіз бе?
Dialogue: 0,0:59:57.17,0:59:58.63,Default,,0,0,0,,тыңдалды
Dialogue: 0,0:59:58.72,1:00:00.22,Default,,0,0,0,,Алу...
Dialogue: 0,1:00:00.30,1:00:01.97,Default,,0,0,0,,Өзін жақсы сезінеді
Dialogue: 0,1:00:05.01,1:00:08.31,Default,,0,0,0,,Чача Поча Пика~ Пип
Dialogue: 0,1:00:09.06,1:00:10.73,Default,,0,0,0,,Уау~ Керемет
Dialogue: 0,1:00:11.31,1:00:13.56,Default,,0,0,0,,Майсыз майлар көп
Dialogue: 0,1:00:13.65,1:00:14.65,Default,,0,0,0,,Поча
Dialogue: 0,1:00:14.94,1:00:17.44,Default,,0,0,0,,Жарайды, сіз де шыға аласыз.
Dialogue: 0,1:00:20.45,1:00:23.12,Default,,0,0,0,,Фури… Фури
Dialogue: 0,1:00:23.20,1:00:26.04,Default,,0,0,0,,(Майсыздың айқайы)
Dialogue: 0,1:00:26.12,1:00:27.24,Default,,0,0,0,,Иә? Осы уақыт ішінде-
Dialogue: 0,1:00:27.33,1:00:28.95,Default,,0,0,0,,Бұл сен құтқарған бала емес пе? Бұл рас
Dialogue: 0,1:00:30.08,1:00:31.79,Default,,0,0,0,,Осы уақытта, Майсыз...
Dialogue: 0,1:00:31.87,1:00:34.84,Default,,0,0,0,,Балалы болу үшін оңтүстікке топ-топ болып көшу.
Dialogue: 0,1:00:34.92,1:00:36.09,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,1:00:36.17,1:00:38.30,Default,,0,0,0,,Қараңызшы, Сатошидің майсыз майы да...
Dialogue: 0,1:00:38.38,1:00:39.59,Default,,0,0,0,,Тегін ~ Тегін ~
Dialogue: 0,1:00:39.67,1:00:41.51,Default,,0,0,0,,Бұл танысу биі.
Dialogue: 0,1:00:42.38,1:00:45.97,Default,,0,0,0,,Тегін ~ Тегін ~ Тегін ~ Тегін ~
Dialogue: 0,1:00:46.06,1:00:48.27,Default,,0,0,0,,Аа... жарайды.
Dialogue: 0,1:00:48.35,1:00:49.98,Default,,0,0,0,,Жарайсың майсыз
Dialogue: 0,1:00:50.06,1:00:55.11,Default,,0,0,0,,Бірақ оңтүстікті кесіп өтуді жалғастырсақ, қоштасуға тура келеді.
Dialogue: 0,1:00:55.40,1:00:56.44,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:58.40,1:01:02.24,Default,,0,0,0,,(Мазасыздың айқайы)
Dialogue: 0,1:01:02.99,1:01:05.95,Default,,0,0,0,,Мен... Маған бұл ұнамайды.
Dialogue: 0,1:01:06.83,1:01:09.45,Default,,0,0,0,,Майсыз – қымбатты дос.
Dialogue: 0,1:01:10.75,1:01:13.08,Default,,0,0,0,,Мен сенімен ажырасқым келмейді.
Dialogue: 0,1:01:13.92,1:01:16.29,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,1:01:16.63,1:01:18.50,Default,,0,0,0,,Шешетін адам - ​​Сатоси.
Dialogue: 0,1:01:21.47,1:01:23.47,Default,,0,0,0,,Фури Фури ~
Dialogue: 0,1:01:24.55,1:01:26.60,Default,,0,0,0,,Фури Фури Фури Фури Фури ~
Dialogue: 0,1:01:26.93,1:01:27.97,Default,,0,0,0,,Фу~
Dialogue: 0,1:01:28.06,1:01:30.93,Default,,0,0,0,,Эй, сен не істегің келеді?
Dialogue: 0,1:01:31.02,1:01:32.31,Default,,0,0,0,,Тегін?
Dialogue: 0,1:01:32.52,1:01:36.52,Default,,0,0,0,,Бізбен қоштасып, онымен оңтүстікке барғың келе ме?
Dialogue: 0,1:01:39.65,1:01:40.65,Default,,0,0,0,,Тегін...
Dialogue: 0,1:01:40.86,1:01:41.86,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,1:01:47.57,1:01:49.99,Default,,0,0,0,,Тегін~
Dialogue: 0,1:01:50.74,1:01:51.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:02.13,1:02:03.63,Default,,0,0,0,,Оңтүстікке барыңыз.
Dialogue: 0,1:02:04.01,1:02:05.22,Default,,0,0,0,,Тегін?
Dialogue: 0,1:02:05.43,1:02:08.64,Default,,0,0,0,,Қараңдар, асықпасақ, бәріміз де жоқ боламыз.
Dialogue: 0,1:02:09.64,1:02:12.72,Default,,0,0,0,,Бұл жігіт өте жақсы жігіт, сондықтан оған қамқорлық жасаңыз.
Dialogue: 0,1:02:12.98,1:02:14.94,Default,,0,0,0,,Фурифури~
Dialogue: 0,1:02:15.02,1:02:16.15,Default,,0,0,0,,Тегін...
Dialogue: 0,1:02:16.56,1:02:17.56,Default,,0,0,0,,Иә
Dialogue: 0,1:02:18.06,1:02:19.31,Default,,0,0,0,,Пикачу
Dialogue: 0,1:02:21.90,1:02:24.65,Default,,0,0,0,,Чут чат поча…
Dialogue: 0,1:02:27.45,1:02:28.57,Default,,0,0,0,,Тегін~
Dialogue: 0,1:02:28.95,1:02:30.37,Default,,0,0,0,,Жақсы араласыңыз!
Dialogue: 0,1:02:30.45,1:02:31.91,Default,,0,0,0,,Почапоча!
Dialogue: 0,1:02:31.99,1:02:34.00,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,1:02:37.79,1:02:39.79,Default,,0,0,0,,Пеекапика!
Dialogue: 0,1:02:39.88,1:02:41.46,Default,,0,0,0,,(Night Eye) Не істесең де, олар бізді сол жақта байқамай қалсын.
Dialogue: 0,1:02:41.55,1:02:44.84,Default,,0,0,0,,Майсыз, сау болыңыз!
Dialogue: 0,1:02:45.05,1:02:47.13,Default,,0,0,0,,Тегін ~ Тегін
Dialogue: 0,1:02:47.22,1:02:49.76,Default,,0,0,0,,Тегін ~ Тегін ~
Dialogue: 0,1:02:49.85,1:02:51.85,Default,,0,0,0,,Поча~
Dialogue: 0,1:02:51.93,1:02:53.89,Default,,0,0,0,,Пикачу
Dialogue: 0,1:02:55.06,1:02:56.69,Default,,0,0,0,,Пика уф...
Dialogue: 0,1:03:09.24,1:03:10.82,Default,,0,0,0,,Ол жоғалды.
Dialogue: 0,1:03:11.12,1:03:13.29,Default,,0,0,0,,Иә Пикапи
Dialogue: 0,1:03:13.37,1:03:14.37,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,1:03:14.91,1:03:16.91,Default,,0,0,0,,Мен оны кездестіргеніме қуаныштымын.
Dialogue: 0,1:03:17.21,1:03:20.67,Default,,0,0,0,,Біз бөлек болсақ та, біз әрқашан дос боламыз.
Dialogue: 0,1:03:20.75,1:03:22.17,Default,,0,0,0,,Пикер
Dialogue: 0,1:03:24.30,1:03:28.01,Default,,0,0,0,,Біз жаттықтырушылар жаттыға алатын болсақ та...
Dialogue: 0,1:03:28.09,1:03:29.84,Default,,0,0,0,,Өйткені оны өндіру мүмкін емес.
Dialogue: 0,1:03:31.26,1:03:32.26,Default,,0,0,0,,Иә
Dialogue: 0,1:03:32.72,1:03:34.39,Default,,0,0,0,,Пика пип?
Dialogue: 0,1:03:38.39,1:03:39.69,Default,,0,0,0,,А, бұл Райкоу.
Dialogue: 0,1:03:40.90,1:03:44.11,Default,,0,0,0,,(Райкоудың айқайы)
Dialogue: 0,1:03:44.19,1:03:45.36,Default,,0,0,0,,Уф
Dialogue: 0,1:03:46.78,1:03:47.78,Default,,0,0,0,,А, Пика?
Dialogue: 0,1:03:55.24,1:03:57.00,Default,,0,0,0,,Ча-ча-поп-пи-пи-пи-пика
Dialogue: 0,1:03:57.08,1:03:58.21,Default,,0,0,0,,Плоп пип пипі
Dialogue: 0,1:04:01.21,1:04:04.29,Default,,0,0,0,,(Покемонның айқайы)
Dialogue: 0,1:04:04.75,1:04:07.55,Default,,0,0,0,,Жабайы Покемон шу шығарып жатқан жоқ па?
Dialogue: 0,1:04:07.63,1:04:08.63,Default,,0,0,0,,Әрине
Dialogue: 0,1:04:08.72,1:04:10.22,Default,,0,0,0,,Бұл Хо-о емес пе?
Dialogue: 0,1:04:11.09,1:04:12.26,Default,,0,0,0,,Бұл жігіттер Хо-Одан...
Dialogue: 0,1:04:12.34,1:04:15.81,Default,,0,0,0,,Біз сіздермен өз күшімізді бөлісу үшін жиналдық.
Dialogue: 0,1:04:16.47,1:04:18.06,Default,,0,0,0,,Хо-ах
Dialogue: 0,1:04:18.14,1:04:19.89,Default,,0,0,0,,Хамф, хун, хун, ах...
Dialogue: 0,1:04:19.98,1:04:22.56,Default,,0,0,0,,По-оның иісі шамалы.
Dialogue: 0,1:04:22.65,1:04:24.73,Default,,0,0,0,,А, мүмкін...
Dialogue: 0,1:04:24.98,1:04:25.98,Default,,0,0,0,,Ах!
Dialogue: 0,1:04:26.78,1:04:28.15,Default,,0,0,0,,Кемпірқосақ шашырауы
Dialogue: 0,1:04:28.24,1:04:29.90,Default,,0,0,0,,Не, сен білесің бе?
Dialogue: 0,1:04:29.99,1:04:31.07,Default,,0,0,0,,Сол кітаптың авторы кім?
Dialogue: 0,1:04:32.11,1:04:33.99,Default,,0,0,0,,Менің ойымша, аты...
Dialogue: 0,1:04:34.07,1:04:36.41,Default,,0,0,0,,Мені «Бондзи» деп атаңыз
Dialogue: 0,1:04:37.66,1:04:39.83,Default,,0,0,0,,Менің 20 жыл өмірім
Dialogue: 0,1:04:40.21,1:04:42.75,Default,,0,0,0,,Сіз Хо-Оны мәңгі іздедіңіз.
Dialogue: 0,1:04:42.83,1:04:44.21,Default,,0,0,0,,20 жыл?
Dialogue: 0,1:04:44.29,1:04:46.09,Default,,0,0,0,,Әртүрлі деректерді біріктіру—
Dialogue: 0,1:04:46.17,1:04:48.42,Default,,0,0,0,,Келесі көрінетін нәрсе - бұл тау...
Dialogue: 0,1:04:48.51,1:04:50.01,Default,,0,0,0,,Мен мұнда тексеру үшін келдім.
Dialogue: 0,1:04:50.09,1:04:52.34,Default,,0,0,0,,Олай болса бірге барайық.
Dialogue: 0,1:04:52.55,1:04:54.55,Default,,0,0,0,,Мен қазір Хо-Оны көруге барамын.
Dialogue: 0,1:04:54.64,1:04:56.47,Default,,0,0,0,,Пикачу
Dialogue: 0,1:04:56.97,1:04:57.97,Default,,0,0,0,,Иә
Dialogue: 0,1:04:58.64,1:05:03.35,Default,,0,0,0,,Бірақ бұл жарқырау дәл балалық шақтың кереметі.
Dialogue: 0,1:05:03.77,1:05:06.52,Default,,0,0,0,,Мен үшін қазір тым әдемі
Dialogue: 0,1:05:08.65,1:05:10.49,Default,,0,0,0,,Сіз аңызға айналған Покемонсыз—
Dialogue: 0,1:05:10.57,1:05:13.28,Default,,0,0,0,,Энтей Суикун мен Райкоумен кездестім —
Dialogue: 0,1:05:13.36,1:05:15.45,Default,,0,0,0,,Кемпірқосақ шашырағандықтан шығар
Dialogue: 0,1:05:15.53,1:05:16.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:16.62,1:05:19.62,Default,,0,0,0,,Бала кемпірқосақ батыры болуға лайық па, жоқ па...
Dialogue: 0,1:05:19.70,1:05:21.33,Default,,0,0,0,,Менің ойымша, олар мұны әлдеқашан түсінді.
Dialogue: 0,1:05:21.41,1:05:22.46,Default,,0,0,0,,Мен?
Dialogue: 0,1:05:22.91,1:05:24.50,Default,,0,0,0,,Бұл дегеніміз-
Dialogue: 0,1:05:24.58,1:05:28.67,Default,,0,0,0,,Мүмкін сізде де көлеңкеден ары қарай бағыт беретін бір нәрсе бар шығар...
Dialogue: 0,1:05:28.75,1:05:31.80,Default,,0,0,0,,Көлеңкеден? Айтпақшы, не болды?
Dialogue: 0,1:05:32.55,1:05:34.55,Default,,0,0,0,,Сіз әлі осындасыз ба?
Dialogue: 0,1:05:34.64,1:05:37.89,Default,,0,0,0,,Бұл мифтік Pokemon Marshadow болуы керек.
Dialogue: 0,1:05:37.97,1:05:39.14,Default,,0,0,0,,Маршадоу?
Dialogue: 0,1:05:39.39,1:05:40.39,Default,,0,0,0,,Иә
Dialogue: 0,1:05:40.93,1:05:44.14,Default,,0,0,0,,«Кемпірқосақтың түсі жоғалған кезде, көлеңкеден басқаратын адам...»
Dialogue: 0,1:05:44.23,1:05:48.23,Default,,0,0,0,,«Бәрін жауып, бәрін түзет» дейді.
Dialogue: 0,1:05:48.86,1:05:49.90,Default,,0,0,0,,Ах
Dialogue: 0,1:05:49.98,1:05:51.90,Default,,0,0,0,,Әй, шың!
Dialogue: 0,1:05:51.99,1:05:53.74,Default,,0,0,0,,Сатоси Иә.
Dialogue: 0,1:05:55.07,1:05:56.41,Default,,0,0,0,,Уау~ Ммм
Dialogue: 0,1:06:09.71,1:06:12.51,Default,,0,0,0,,Кемпірқосақ түсті гүлдер кемпірқосақ түсті жартастарда гүлдегенде—
Dialogue: 0,1:06:12.59,1:06:14.42,Default,,0,0,0,,Хо-ох пайда болады
Dialogue: 0,1:06:15.05,1:06:17.26,Default,,0,0,0,,Мен енді бір орында отыра алмаймын.
Dialogue: 0,1:06:17.34,1:06:19.14,Default,,0,0,0,,Барайық Пикачу Пика
Dialogue: 0,1:06:19.22,1:06:21.18,Default,,0,0,0,,Почапоча~ А, күте тұрыңыз.
Dialogue: 0,1:06:22.02,1:06:23.52,Default,,0,0,0,,Хохохохохо
Dialogue: 0,1:06:24.02,1:06:27.52,Default,,0,0,0,,Жарық пен көлеңке, жебе сияқты, кемпірқосақ тез жоғалады.
Dialogue: 0,1:06:27.60,1:06:31.65,Default,,0,0,0,,Балалар, асығыңыздар хахахахахаха
Dialogue: 0,1:06:32.61,1:06:34.86,Default,,0,0,0,,Балалар, асығыңыздар!
Dialogue: 0,1:06:34.95,1:06:37.03,Default,,0,0,0,,Хмм, мен ұл емеспін...
Dialogue: 0,1:06:37.11,1:06:39.32,Default,,0,0,0,,Уф... Мен асықпаймын...
Dialogue: 0,1:06:39.41,1:06:41.08,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,1:06:41.16,1:06:43.37,Default,,0,0,0,,Менің қарным ашты...
Dialogue: 0,1:06:44.96,1:06:47.25,Default,,0,0,0,,(Поппоның айқайы)
Dialogue: 0,1:06:54.63,1:06:56.59,Default,,0,0,0,,Сен сонда қауырсын қоясың ба?
Dialogue: 0,1:06:57.97,1:06:59.34,Default,,0,0,0,,Мен дыбыстық сигнал беремін
Dialogue: 0,1:07:01.81,1:07:03.39,Default,,0,0,0,,(Гаоганның айқайы)
Dialogue: 0,1:07:03.97,1:07:05.23,Default,,0,0,0,,А, уау, пика? Пика~
Dialogue: 0,1:07:07.44,1:07:08.90,Default,,0,0,0,,Пикер Ах!
Dialogue: 0,1:07:09.56,1:07:10.73,Default,,0,0,0,,Гаен
Dialogue: 0,1:07:10.81,1:07:12.69,Default,,0,0,0,,Крест Бұл қандай ақша?
Dialogue: 0,1:07:12.98,1:07:14.36,Default,,0,0,0,,Маған берші
Dialogue: 0,1:07:14.44,1:07:15.94,Default,,0,0,0,,Хо-омен шайқас —
Dialogue: 0,1:07:16.03,1:07:18.07,Default,,0,0,0,,Бұл менмін, ең күшті жаттықтырушы.
Dialogue: 0,1:07:18.32,1:07:19.66,Default,,0,0,0,,Сіз қателесесіз
Dialogue: 0,1:07:19.74,1:07:21.99,Default,,0,0,0,,Дұрыс, сіз Хо-омен шайқаса аласыз...
Dialogue: 0,1:07:22.37,1:07:24.29,Default,,0,0,0,,Тек таңдалған кемпірқосақ кейіпкері
Dialogue: 0,1:07:24.37,1:07:25.54,Default,,0,0,0,,Сен тым наивсің.
Dialogue: 0,1:07:25.62,1:07:28.33,Default,,0,0,0,,Бір ғана дұрыс нәрсе – күш.
Dialogue: 0,1:07:28.71,1:07:30.17,Default,,0,0,0,,Сонда әлсіз адам ше?
Dialogue: 0,1:07:30.25,1:07:31.38,Default,,0,0,0,,Бұл қоқыс
Dialogue: 0,1:07:31.46,1:07:33.34,Default,,0,0,0,,Кім жеңілді? Одан аз
Dialogue: 0,1:07:33.63,1:07:37.67,Default,,0,0,0,,Қарғыс атсын... Мен сенен ұтыла алмаймын.
Dialogue: 0,1:07:37.76,1:07:38.76,Default,,0,0,0,,Ах
Dialogue: 0,1:07:42.39,1:07:43.60,Default,,0,0,0,,Ах Поча
Dialogue: 0,1:07:43.89,1:07:45.39,Default,,0,0,0,,А, Пика?
Dialogue: 0,1:07:45.64,1:07:47.93,Default,,0,0,0,,Сіз Маршадоусыз
Dialogue: 0,1:07:48.77,1:07:50.40,Default,,0,0,0,,Бұл мен сол түні көрген Покемон.
Dialogue: 0,1:07:50.48,1:07:52.02,Default,,0,0,0,,Бұл таңқаларлық сүйкімді болуы мүмкін
Dialogue: 0,1:07:52.31,1:07:54.82,Default,,0,0,0,,«Көлеңкеден жол көрсетуші»…
Dialogue: 0,1:07:59.49,1:08:02.66,Default,,0,0,0,,Маршадоу тек сізді бақылайтын ниетте.
Dialogue: 0,1:08:02.74,1:08:03.74,Default,,0,0,0,,Бондзи
Dialogue: 0,1:08:07.95,1:08:10.46,Default,,0,0,0,,Кесіртке Мен сені таңдаймын
Dialogue: 0,1:08:13.46,1:08:14.59,Default,,0,0,0,,Зард
Dialogue: 0,1:08:14.88,1:08:15.88,Default,,0,0,0,,Каенхуша
Dialogue: 0,1:08:15.96,1:08:17.80,Default,,0,0,0,,Ой!
Dialogue: 0,1:08:17.88,1:08:19.38,Default,,0,0,0,,Асыққан кесіртке
Dialogue: 0,1:08:19.47,1:08:20.93,Default,,0,0,0,,Зард
Dialogue: 0,1:08:22.22,1:08:23.60,Default,,0,0,0,,Лизард Кирисаку
Dialogue: 0,1:08:24.39,1:08:28.52,Default,,0,0,0,,Зардо Гагар!
Dialogue: 0,1:08:28.60,1:08:30.27,Default,,0,0,0,,Мен мұны Поча жасадым
Dialogue: 0,1:08:30.89,1:08:31.94,Default,,0,0,0,,Джигокузуки
Dialogue: 0,1:08:32.02,1:08:33.10,Default,,0,0,0,,Гаэ
Dialogue: 0,1:08:33.81,1:08:35.98,Default,,0,0,0,,Гаоооооооо (Кесіртке) Бұл
Dialogue: 0,1:08:36.07,1:08:37.40,Default,,0,0,0,,Гагает (кесіртке)
Dialogue: 0,1:08:38.53,1:08:40.07,Default,,0,0,0,,Гей (кесіртке)
Dialogue: 0,1:08:40.15,1:08:41.40,Default,,0,0,0,,Кирисаку
Dialogue: 0,1:08:42.11,1:08:43.99,Default,,0,0,0,,Уау (кесіртке) бұл
Dialogue: 0,1:08:46.99,1:08:48.04,Default,,0,0,0,,Каенхуша
Dialogue: 0,1:08:48.45,1:08:49.83,Default,,0,0,0,,Гаоооооо
Dialogue: 0,1:08:49.91,1:08:50.96,Default,,0,0,0,,Лизард!
Dialogue: 0,1:08:51.04,1:08:53.00,Default,,0,0,0,,Зард
Dialogue: 0,1:08:54.42,1:08:56.09,Default,,0,0,0,,Суық тиіп қалдың ба? Жағдайың қалай?
Dialogue: 0,1:08:56.17,1:08:58.51,Default,,0,0,0,,Зард!
Dialogue: 0,1:08:59.59,1:09:01.22,Default,,0,0,0,,Ах Пика
Dialogue: 0,1:09:10.31,1:09:14.23,Default,,0,0,0,,Уау... Риза
Dialogue: 0,1:09:14.44,1:09:16.06,Default,,0,0,0,,Шаризардқа айналды
Dialogue: 0,1:09:16.15,1:09:17.19,Default,,0,0,0,,Жылтыр
Dialogue: 0,1:09:17.27,1:09:18.61,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,1:09:18.69,1:09:19.94,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,1:09:20.03,1:09:22.78,Default,,0,0,0,,Біз дамылсақ та, әлсіздер әлсіз болып қала береді.
Dialogue: 0,1:09:22.86,1:09:24.53,Default,,0,0,0,,Джигокузуки Гугга
Dialogue: 0,1:09:24.61,1:09:26.28,Default,,0,0,0,,Чаризард Кирисаку
Dialogue: 0,1:09:26.83,1:09:28.83,Default,,0,0,0,,(Чаризардтың айқайы)
Dialogue: 0,1:09:29.29,1:09:30.45,Default,,0,0,0,,Гаук
Dialogue: 0,1:09:33.83,1:09:34.96,Default,,0,0,0,,Каенхуша
Dialogue: 0,1:09:35.04,1:09:37.13,Default,,0,0,0,,Гаааааах
Dialogue: 0,1:09:42.84,1:09:43.93,Default,,0,0,0,,Айдаһар якорь
Dialogue: 0,1:09:44.43,1:09:45.64,Default,,0,0,0,,(Чаризардтың айқайы)
Dialogue: 0,1:09:45.89,1:09:47.22,Default,,0,0,0,,Гаэгер
Dialogue: 0,1:09:48.89,1:09:50.47,Default,,0,0,0,,(Чаризардтың ұрыс айқайы)
Dialogue: 0,1:09:50.77,1:09:53.35,Default,,0,0,0,,Отбасымнан алыста~!
Dialogue: 0,1:09:53.44,1:09:54.90,Default,,0,0,0,,(Гаоганның айқайы)
Dialogue: 0,1:09:54.98,1:09:57.77,Default,,0,0,0,,Шаризард Егер ол ұзаққа созылса, біз қолайсыз жағдайға тап боламыз.
Dialogue: 0,1:09:57.86,1:10:01.07,Default,,0,0,0,,Күшіңізді жинаңыз, мүмкіндік туған кезде бірден шешесіз.
Dialogue: 0,1:10:01.15,1:10:02.19,Default,,0,0,0,,Гау
Dialogue: 0,1:10:02.28,1:10:03.61,Default,,0,0,0,,Өрт азу тістері
Dialogue: 0,1:10:03.86,1:10:05.53,Default,,0,0,0,,Гаогар!
Dialogue: 0,1:10:05.86,1:10:07.78,Default,,0,0,0,,Гау Додж!
Dialogue: 0,1:10:14.29,1:10:15.46,Default,,0,0,0,,Мені төмен сүйреңіз
Dialogue: 0,1:10:16.17,1:10:18.71,Default,,0,0,0,,Гает (Чаризард) садақ
Dialogue: 0,1:10:18.79,1:10:19.79,Default,,0,0,0,,Чикюнаж!
Dialogue: 0,1:10:20.17,1:10:22.30,Default,,0,0,0,,Гааааааа... Жылтыр
Dialogue: 0,1:10:22.55,1:10:25.01,Default,,0,0,0,,Гаин
Dialogue: 0,1:10:26.13,1:10:29.14,Default,,0,0,0,,Ууууууу...
Dialogue: 0,1:10:29.43,1:10:30.97,Default,,0,0,0,,Гаееен
Dialogue: 0,1:10:31.97,1:10:32.97,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,1:10:33.22,1:10:35.14,Default,,0,0,0,,Гаоган Каенхоша
Dialogue: 0,1:10:35.56,1:10:37.06,Default,,0,0,0,,Гаааоо!
Dialogue: 0,1:10:37.15,1:10:39.31,Default,,0,0,0,,Чаризард Каенхоша!
Dialogue: 0,1:10:39.98,1:10:41.65,Default,,0,0,0,,Уууууууу
Dialogue: 0,1:10:45.53,1:10:46.82,Default,,0,0,0,,Алға!
Dialogue: 0,1:10:50.78,1:10:53.79,Default,,0,0,0,,(Гаоганның ырылдауы)
Dialogue: 0,1:11:01.46,1:11:02.80,Default,,0,0,0,,Гау…
Dialogue: 0,1:11:05.67,1:11:07.76,Default,,0,0,0,,Га… Ууууу…
Dialogue: 0,1:11:09.22,1:11:10.22,Default,,0,0,0,,Құт
Dialogue: 0,1:11:11.26,1:11:12.64,Default,,0,0,0,,Жарайсың Чаризард
Dialogue: 0,1:11:12.72,1:11:13.97,Default,,0,0,0,,Гау
Dialogue: 0,1:11:33.54,1:11:35.62,Default,,0,0,0,,Мен Хо-Оны да көрдім
Dialogue: 0,1:11:36.04,1:11:37.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:38.21,1:11:40.88,Default,,0,0,0,,Бірақ мен кемпірқосақ шашырауын алмадым.
Dialogue: 0,1:11:40.96,1:11:43.13,Default,,0,0,0,,Ең күшті жаттықтырушы болу үшін...
Dialogue: 0,1:11:43.21,1:11:45.05,Default,,0,0,0,,Мен бәрін істесем де...
Dialogue: 0,1:11:46.55,1:11:47.97,Default,,0,0,0,,Неге сен!
Dialogue: 0,1:11:48.55,1:11:50.68,Default,,0,0,0,,Егер Хо-о мені ең мықты деп танымаса...
Dialogue: 0,1:11:50.76,1:11:51.97,Default,,0,0,0,,...
Dialogue: 0,1:11:52.05,1:11:53.26,Default,,0,0,0,,А крест...
Dialogue: 0,1:11:53.35,1:11:55.77,Default,,0,0,0,,Мен де күшті болғым келеді
Dialogue: 0,1:11:55.85,1:11:59.14,Default,,0,0,0,,Бірақ бәрімен бірге жұмыс жасау арқылы біз осы уақытқа дейін жеттік.
Dialogue: 0,1:11:59.60,1:12:01.56,Default,,0,0,0,,Бұл бәрі емес екен.
Dialogue: 0,1:12:01.98,1:12:03.90,Default,,0,0,0,,Сонда шайқас не үшін?
Dialogue: 0,1:12:03.98,1:12:04.98,Default,,0,0,0,,Бұл...
Dialogue: 0,1:12:06.48,1:12:08.03,Default,,0,0,0,,Себебі мен дос болғым келеді
Dialogue: 0,1:12:08.11,1:12:09.32,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:09.61,1:12:11.11,Default,,0,0,0,,Тек Хо-о емес
Dialogue: 0,1:12:11.20,1:12:13.74,Default,,0,0,0,,Мен барлық Покемондармен дос болғым келеді
Dialogue: 0,1:12:14.12,1:12:15.54,Default,,0,0,0,,Бұл менің шайқасым
Dialogue: 0,1:12:15.87,1:12:17.20,Default,,0,0,0,,Пикер
Dialogue: 0,1:12:18.71,1:12:20.37,Default,,0,0,0,,Ол «Рух толқынын» қолдануда — қалағанынша жоғалып, қайта пайда бола алады.
Dialogue: 0,1:12:20.46,1:12:21.46,Default,,0,0,0,,Бұл
Dialogue: 0,1:12:22.42,1:12:23.54,Default,,0,0,0,,Уф, жылтыр
Dialogue: 0,1:12:24.88,1:12:26.05,Default,,0,0,0,,Гау
Dialogue: 0,1:12:26.13,1:12:27.84,Default,,0,0,0,,Жоқ, ә
Dialogue: 0,1:12:32.89,1:12:35.26,Default,,0,0,0,,Жүр, хо-о!
Dialogue: 0,1:12:51.70,1:12:53.49,Default,,0,0,0,,Ах... Пика
Dialogue: 0,1:12:53.87,1:12:57.91,Default,,0,0,0,,«Кемпірқосақ, зұлым жүрекке қол тигізгенде...»
Dialogue: 0,1:12:58.12,1:12:59.50,Default,,0,0,0,,«Түсті жоғалту»
Dialogue: 0,1:13:04.54,1:13:05.84,Default,,0,0,0,,Мастер
Dialogue: 0,1:13:05.92,1:13:07.05,Default,,0,0,0,,Не?
Dialogue: 0,1:13:07.42,1:13:09.26,Default,,0,0,0,,Гуаааахх
Dialogue: 0,1:13:10.01,1:13:11.93,Default,,0,0,0,,Ой-оу...
Dialogue: 0,1:13:12.88,1:13:13.89,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:14.18,1:13:16.89,Default,,0,0,0,,Маршадоу бәрін жауып, бәрін жөндейді.
Dialogue: 0,1:13:21.02,1:13:22.81,Default,,0,0,0,,Мен де сені құртамын.
Dialogue: 0,1:13:22.89,1:13:25.19,Default,,0,0,0,,Лугарган сынуы
Dialogue: 0,1:13:25.94,1:13:27.44,Default,,0,0,0,,Машер
Dialogue: 0,1:13:28.32,1:13:29.32,Default,,0,0,0,,(ДжоДжо) Бұл таңқаларлық! Мен сен...
Dialogue: 0,1:13:29.73,1:13:31.03,Default,,0,0,0,,Ууууууу…
Dialogue: 0,1:13:32.70,1:13:34.78,Default,,0,0,0,,Гууу... Гаау
Dialogue: 0,1:13:34.86,1:13:36.95,Default,,0,0,0,,Ах (Лугарганның күркіреуі)
Dialogue: 0,1:13:37.03,1:13:38.20,Default,,0,0,0,,Не?
Dialogue: 0,1:13:38.28,1:13:40.25,Default,,0,0,0,,Маршадоу оны басқарады.
Dialogue: 0,1:13:40.75,1:13:43.00,Default,,0,0,0,,Адамдар мен Покемонды ажырату
Dialogue: 0,1:13:43.21,1:13:44.29,Default,,0,0,0,,Иә
Dialogue: 0,1:13:44.37,1:13:46.71,Default,,0,0,0,,Ууууу... Ааа
Dialogue: 0,1:13:46.79,1:13:47.79,Default,,0,0,0,,Ішек
Dialogue: 0,1:13:50.09,1:13:51.21,Default,,0,0,0,,Гау Ах
Dialogue: 0,1:13:52.80,1:13:54.09,Default,,0,0,0,,Сіз...
Dialogue: 0,1:13:54.18,1:13:56.01,Default,,0,0,0,,Ұмытпадым, а
Dialogue: 0,1:13:56.09,1:13:58.89,Default,,0,0,0,,Сіз менің жаттықтырушым болдыңыз
Dialogue: 0,1:13:59.14,1:14:00.68,Default,,0,0,0,,Міне, солай.
Dialogue: 0,1:14:00.77,1:14:02.31,Default,,0,0,0,,Бұл Пика
Dialogue: 0,1:14:03.73,1:14:04.73,Default,,0,0,0,,Гаук
Dialogue: 0,1:14:18.58,1:14:20.45,Default,,0,0,0,,Мынау!
Dialogue: 0,1:14:21.62,1:14:22.62,Default,,0,0,0,,Уау, жылтыр
Dialogue: 0,1:14:23.29,1:14:24.46,Default,,0,0,0,,Лукарио
Dialogue: 0,1:14:25.71,1:14:27.33,Default,,0,0,0,,Пикачу 10манвольт
Dialogue: 0,1:14:27.42,1:14:29.75,Default,,0,0,0,,Пикачу!
Dialogue: 0,1:14:35.84,1:14:38.39,Default,,0,0,0,,Маршадоу сені де жоюға тырысады.
Dialogue: 0,1:14:38.47,1:14:39.60,Default,,0,0,0,,Бізбен бірге жүр!
Dialogue: 0,1:14:39.93,1:14:42.52,Default,,0,0,0,,Егер бұл орын алса, Ho-oh енді пайда болмайды.
Dialogue: 0,1:14:42.60,1:14:44.35,Default,,0,0,0,,Маша гаааа
Dialogue: 0,1:14:44.43,1:14:45.60,Default,,0,0,0,,Сайт
Dialogue: 0,1:14:46.19,1:14:47.52,Default,,0,0,0,,Пикер
Dialogue: 0,1:14:51.57,1:14:52.65,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,1:14:52.73,1:14:54.36,Default,,0,0,0,,Әй, әйтеуір
Dialogue: 0,1:14:54.44,1:14:56.45,Default,,0,0,0,,(Покемонның айқайы)
Dialogue: 0,1:14:58.70,1:15:01.16,Default,,0,0,0,,Бала, мына қауырсындарды қайтар.
Dialogue: 0,1:15:01.24,1:15:02.24,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:03.04,1:15:06.33,Default,,0,0,0,,Маршадоу күшін сол қауырсындардан алады.
Dialogue: 0,1:15:06.96,1:15:10.00,Default,,0,0,0,,Оны қайтарып алу Хо-Оның таңдауы болды.
Dialogue: 0,1:15:10.08,1:15:11.79,Default,,0,0,0,,Мұны тек сіз жасай аласыз
Dialogue: 0,1:15:16.80,1:15:19.30,Default,,0,0,0,,Мен мұны істеуім керек, Пикачу.
Dialogue: 0,1:15:19.39,1:15:20.93,Default,,0,0,0,,Біз Сатосидің қолдаушысымыз.
Dialogue: 0,1:15:21.01,1:15:22.06,Default,,0,0,0,,Жарайды Поча
Dialogue: 0,1:15:22.14,1:15:23.35,Default,,0,0,0,,Осы жолмен
Dialogue: 0,1:15:25.52,1:15:27.64,Default,,0,0,0,,Чаризард Каенхоша
Dialogue: 0,1:15:28.10,1:15:31.15,Default,,0,0,0,,У... Гааааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,1:15:31.77,1:15:33.19,Default,,0,0,0,,Пиджеотто
Dialogue: 0,1:15:33.52,1:15:35.11,Default,,0,0,0,,Гидросорғы Pocha!
Dialogue: 0,1:15:35.90,1:15:37.28,Default,,0,0,0,,Джотто Ах!
Dialogue: 0,1:15:37.65,1:15:38.70,Default,,0,0,0,,Ша~
Dialogue: 0,1:15:38.78,1:15:40.41,Default,,0,0,0,,Ах (Арбок) Ах
Dialogue: 0,1:15:41.82,1:15:42.91,Default,,0,0,0,,Жабу
Dialogue: 0,1:15:43.91,1:15:44.91,Default,,0,0,0,,О, жылтыр
Dialogue: 0,1:15:45.83,1:15:46.83,Default,,0,0,0,,Пика Ах
Dialogue: 0,1:15:46.91,1:15:48.75,Default,,0,0,0,,Горон Горороро...
Dialogue: 0,1:15:48.83,1:15:50.17,Default,,0,0,0,,Ах
Dialogue: 0,1:15:50.25,1:15:52.38,Default,,0,0,0,,Поча!
Dialogue: 0,1:15:52.71,1:15:53.92,Default,,0,0,0,,Иә Ча
Dialogue: 0,1:15:54.17,1:15:55.55,Default,,0,0,0,,Иә, Пика
Dialogue: 0,1:15:57.55,1:15:58.55,Default,,0,0,0,,Уау сигналы
Dialogue: 0,1:16:01.01,1:16:03.05,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:16:06.64,1:16:08.23,Default,,0,0,0,,Кросс Гау
Dialogue: 0,1:16:09.10,1:16:12.15,Default,,0,0,0,,Бұл менің қарсыласым. Бар! Уф...
Dialogue: 0,1:16:12.61,1:16:13.82,Default,,0,0,0,,Құт сигналы
Dialogue: 0,1:16:16.48,1:16:19.24,Default,,0,0,0,,Біз кездескенде де мені осылай тістеп алдың...
Dialogue: 0,1:16:19.32,1:16:21.78,Default,,0,0,0,,біз төрт жылдан бері соғыста жүргеніміз?
Dialogue: 0,1:16:22.20,1:16:23.78,Default,,0,0,0,,Лугарганды есте сақтаңыз!
Dialogue: 0,1:16:23.87,1:16:25.70,Default,,0,0,0,,(Лугарганның ырылдауы)
Dialogue: 0,1:16:37.38,1:16:38.38,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:39.88,1:16:41.13,Default,,0,0,0,,Лугарган
Dialogue: 0,1:16:42.51,1:16:44.68,Default,,0,0,0,,Маршадоу, маған қауырсынымды қайтар.
Dialogue: 0,1:16:44.76,1:16:46.14,Default,,0,0,0,,Пикер
Dialogue: 0,1:16:48.27,1:16:50.69,Default,,0,0,0,,Марсиар
Dialogue: 0,1:16:50.77,1:16:52.31,Default,,0,0,0,,Темір құйрықпен кері соққы
Dialogue: 0,1:16:52.40,1:16:55.15,Default,,0,0,0,,Пикачу
Dialogue: 0,1:16:55.36,1:16:56.36,Default,,0,0,0,,Машер Машер
Dialogue: 0,1:16:57.40,1:16:58.40,Default,,0,0,0,,Пика!
Dialogue: 0,1:16:59.19,1:17:00.74,Default,,0,0,0,,Шар
Dialogue: 0,1:17:00.82,1:17:02.91,Default,,0,0,0,,Темір құйрық, жылтыр
Dialogue: 0,1:17:02.99,1:17:04.28,Default,,0,0,0,,Тынышсың ба пика
Dialogue: 0,1:17:04.37,1:17:05.91,Default,,0,0,0,,Шар пика!
Dialogue: 0,1:17:06.16,1:17:08.33,Default,,0,0,0,,Уаар Лукарио
Dialogue: 0,1:17:12.25,1:17:13.54,Default,,0,0,0,,Уау
Dialogue: 0,1:17:18.76,1:17:19.76,Default,,0,0,0,,Крест
Dialogue: 0,1:17:28.93,1:17:30.52,Default,,0,0,0,,Ша~ (Чаризард) Ау
Dialogue: 0,1:17:30.60,1:17:32.44,Default,,0,0,0,,Арбок (Чаризард) Гау
Dialogue: 0,1:17:32.89,1:17:34.60,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,1:17:35.10,1:17:36.31,Default,,0,0,0,,Каа…
Dialogue: 0,1:17:36.40,1:17:37.40,Default,,0,0,0,,Пикачу
Dialogue: 0,1:17:37.98,1:17:39.32,Default,,0,0,0,,Пикачу
Dialogue: 0,1:17:41.49,1:17:43.07,Default,,0,0,0,,Кеттік, Пикачу
Dialogue: 0,1:17:43.49,1:17:46.41,Default,,0,0,0,,Пика Пикер!
Dialogue: 0,1:17:47.66,1:17:52.66,Default,,0,0,0,,...
Dialogue: 0,1:17:52.75,1:17:53.92,Default,,0,0,0,,Шашашашашаша…
Dialogue: 0,1:17:55.00,1:17:56.50,Default,,0,0,0,,Додж! Пика
Dialogue: 0,1:17:56.58,1:17:57.96,Default,,0,0,0,,Пикапип…
Dialogue: 0,1:17:58.04,1:18:00.17,Default,,0,0,0,,Дыбыстық сигнал сигналдық сигнал
Dialogue: 0,1:18:00.25,1:18:01.92,Default,,0,0,0,,Пикачу 10манвольт
Dialogue: 0,1:18:02.34,1:18:04.09,Default,,0,0,0,,Пикачу!
Dialogue: 0,1:18:07.10,1:18:08.93,Default,,0,0,0,,Машер!
Dialogue: 0,1:18:22.65,1:18:24.90,Default,,0,0,0,,Маршер!
Dialogue: 0,1:18:25.49,1:18:26.82,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,1:18:27.24,1:18:28.53,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:18:31.12,1:18:32.70,Default,,0,0,0,,Pi… Ka…
Dialogue: 0,1:18:35.37,1:18:36.62,Default,,0,0,0,,Марсия…
Dialogue: 0,1:18:37.21,1:18:38.46,Default,,0,0,0,,Пикачу
Dialogue: 0,1:18:41.30,1:18:42.63,Default,,0,0,0,,Pi… Ka…
Dialogue: 0,1:18:43.13,1:18:44.80,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,1:18:52.14,1:18:53.35,Default,,0,0,0,,Уау
Dialogue: 0,1:19:01.90,1:19:03.19,Default,,0,0,0,,Уау!
Dialogue: 0,1:19:06.53,1:19:07.78,Default,,0,0,0,,Уф... Грррр.
Dialogue: 0,1:19:09.99,1:19:11.33,Default,,0,0,0,,Уау!
Dialogue: 0,1:19:13.08,1:19:15.00,Default,,0,0,0,,Сатоши... Поча...
Dialogue: 0,1:19:18.75,1:19:21.29,Default,,0,0,0,,Pi… Ka…
Dialogue: 0,1:19:21.38,1:19:23.75,Default,,0,0,0,,Пи… Качу…
Dialogue: 0,1:19:23.84,1:19:25.67,Default,,0,0,0,,...
Dialogue: 0,1:19:26.84,1:19:28.51,Default,,0,0,0,,Pi… Ka…
Dialogue: 0,1:19:34.43,1:19:36.43,Default,,0,0,0,,Мұны Пикачу қойды
Dialogue: 0,1:19:38.31,1:19:40.81,Default,,0,0,0,,Сенің кіруді ұнатпайтыныңды білемін.
Dialogue: 0,1:19:41.40,1:19:43.40,Default,,0,0,0,,Бірақ егер сіз кірсеңіз—
Dialogue: 0,1:19:43.73,1:19:45.78,Default,,0,0,0,,Сақталуыңыз мүмкін.
Dialogue: 0,1:19:45.86,1:19:48.07,Default,,0,0,0,,(Сидонның айқайы)
Dialogue: 0,1:19:52.03,1:19:53.49,Default,,0,0,0,,Уф
Dialogue: 0,1:19:56.45,1:19:58.92,Default,,0,0,0,,Балалар, мені кім деп ойлайсыңдар?
Dialogue: 0,1:20:01.79,1:20:04.25,Default,,0,0,0,,Мен Масала қаласынан келген Сатошимін
Dialogue: 0,1:20:04.34,1:20:06.67,Default,,0,0,0,,Әлемдегі ең жақсы Покемон шебері болыңыз.
Dialogue: 0,1:20:07.22,1:20:09.09,Default,,0,0,0,,Мен мұндай нәрседен жеңілмеймін!
Dialogue: 0,1:20:09.18,1:20:10.89,Default,,0,0,0,,(Сидондардың айқайы)
Dialogue: 0,1:20:30.07,1:20:31.07,Default,,0,0,0,,Пикер…
Dialogue: 0,1:20:31.74,1:20:34.16,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,1:20:34.83,1:20:35.91,Default,,0,0,0,,Пикер…
Dialogue: 0,1:20:36.29,1:20:37.91,Default,,0,0,0,,Пикачу...
Dialogue: 0,1:20:38.12,1:20:39.83,Default,,0,0,0,,Неге кірмейсің?
Dialogue: 0,1:20:42.17,1:20:43.25,Default,,0,0,0,,Әрқашан...
Dialogue: 0,1:20:45.17,1:20:46.17,Default,,0,0,0,,Әрқашан...
Dialogue: 0,1:20:46.96,1:20:48.42,Default,,0,0,0,,…
Dialogue: 0,1:20:48.92,1:20:50.51,Default,,0,0,0,,Себебі мен болғым келеді...
Dialogue: 0,1:20:50.93,1:20:53.76,Default,,0,0,0,,Га, Пикачу...
Dialogue: 0,1:20:54.01,1:20:55.35,Default,,0,0,0,,Сіз...
Dialogue: 0,1:21:11.74,1:21:13.20,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:14.62,1:21:16.58,Default,,0,0,0,,Гаау (Арбок) Арбок
Dialogue: 0,1:21:30.67,1:21:32.34,Default,,0,0,0,,Пи… Пикка…
Dialogue: 0,1:21:32.43,1:21:33.43,Default,,0,0,0,,Пика?
Dialogue: 0,1:21:36.97,1:21:38.26,Default,,0,0,0,,Пикер?
Dialogue: 0,1:21:48.52,1:21:49.61,Default,,0,0,0,,Pi…
Dialogue: 0,1:21:55.45,1:21:57.37,Default,,0,0,0,,Пикачу…
Dialogue: 0,1:22:06.75,1:22:08.21,Default,,0,0,0,,Пика?
Dialogue: 0,1:22:10.25,1:22:11.59,Default,,0,0,0,,Пикапи…
Dialogue: 0,1:22:12.80,1:22:15.34,Default,,0,0,0,,Пикер
Dialogue: 0,1:22:15.84,1:22:17.30,Default,,0,0,0,,Шайнаңыз!
Dialogue: 0,1:22:17.39,1:22:20.89,Default,,0,0,0,,(Покемонның айқайлары)
Dialogue: 0,1:22:20.97,1:22:22.60,Default,,0,0,0,,Уф... Поча!
Dialogue: 0,1:22:35.82,1:22:37.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:40.08,1:22:42.54,Default,,0,0,0,,Дыбыстық сигнал...
Dialogue: 0,1:22:42.62,1:22:44.71,Default,,0,0,0,,Пи… Пикка…
Dialogue: 0,1:22:45.58,1:22:49.75,Default,,0,0,0,,Пейкапи!
Dialogue: 0,1:22:58.22,1:22:59.60,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,1:23:04.93,1:23:08.31,Default,,0,0,0,,Пикачу, бәрі қайда?
Dialogue: 0,1:23:09.02,1:23:11.44,Default,,0,0,0,,Пи… Пикачу…
Dialogue: 0,1:23:14.57,1:23:15.74,Default,,0,0,0,,Пика?
Dialogue: 0,1:23:17.28,1:23:18.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:23.74,1:23:25.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:32.21,1:23:34.38,Default,,0,0,0,,Пикапи… Пикапи
Dialogue: 0,1:23:34.46,1:23:35.76,Default,,0,0,0,,Пикачу
Dialogue: 0,1:23:45.56,1:23:46.56,Default,,0,0,0,,Ах
Dialogue: 0,1:23:48.19,1:23:50.15,Default,,0,0,0,,Екеуміз осылай жүгірдік.
Dialogue: 0,1:23:52.77,1:23:54.15,Default,,0,0,0,,Пикер…
Dialogue: 0,1:24:16.05,1:24:17.92,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:26.64,1:24:28.89,Default,,0,0,0,,Пикапи!
Dialogue: 0,1:24:29.69,1:24:30.73,Default,,0,0,0,,Ах
Dialogue: 0,1:24:33.65,1:24:34.98,Default,,0,0,0,,Ах хаха
Dialogue: 0,1:24:35.36,1:24:36.65,Default,,0,0,0,,Пикапи!
Dialogue: 0,1:24:36.73,1:24:38.11,Default,,0,0,0,,Пикачу!
Dialogue: 0,1:24:38.74,1:24:39.74,Default,,0,0,0,,Хаха
Dialogue: 0,1:24:40.20,1:24:42.78,Default,,0,0,0,,Ахха Пикачу
Dialogue: 0,1:24:44.20,1:24:45.74,Default,,0,0,0,,Пика хаха
Dialogue: 0,1:24:47.08,1:24:49.12,Default,,0,0,0,,Ахха Пикачу
Dialogue: 0,1:24:51.54,1:24:52.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:59.59,1:25:00.59,Default,,0,0,0,,Пикачу
Dialogue: 0,1:25:00.67,1:25:01.76,Default,,0,0,0,,Пикапи
Dialogue: 0,1:25:02.18,1:25:03.34,Default,,0,0,0,,Сатоси
Dialogue: 0,1:25:03.43,1:25:04.76,Default,,0,0,0,,Сатоси
Dialogue: 0,1:25:05.43,1:25:07.68,Default,,0,0,0,,Макото Суджи
Dialogue: 0,1:25:07.89,1:25:09.60,Default,,0,0,0,,Гуау
Dialogue: 0,1:25:09.81,1:25:11.31,Default,,0,0,0,,Ах... Пика
Dialogue: 0,1:25:11.56,1:25:12.60,Default,,0,0,0,,Хахаха
Dialogue: 0,1:25:12.69,1:25:14.52,Default,,0,0,0,,О... Пи… Пикка?
Dialogue: 0,1:25:21.03,1:25:22.82,Default,,0,0,0,,Маршер
Dialogue: 0,1:25:25.32,1:25:28.29,Default,,0,0,0,,«Кемпірқосақ түсті гүлдер кемпірқосақ түсті жартастарда гүлдегенде...»
Dialogue: 0,1:25:29.12,1:25:30.87,Default,,0,0,0,,«Хо-о пайда болады»
Dialogue: 0,1:25:31.50,1:25:33.12,Default,,0,0,0,,Ах... Пика
Dialogue: 0,1:25:33.21,1:25:35.54,Default,,0,0,0,,Иә, кеттік, балам.
Dialogue: 0,1:25:48.18,1:25:49.47,Default,,0,0,0,,Пика
Dialogue: 0,1:26:00.65,1:26:02.11,Default,,0,0,0,,Ах... Пика
Dialogue: 0,1:26:02.19,1:26:03.65,Default,,0,0,0,,Уау...
Dialogue: 0,1:26:05.41,1:26:06.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:13.21,1:26:14.29,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,1:26:19.38,1:26:21.09,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:29.14,1:26:31.81,Default,,0,0,0,,«Кемпірқосақ шашырауын басқаратын адам»
Dialogue: 0,1:26:31.89,1:26:35.23,Default,,0,0,0,,«Хо-омен танысып, кемпірқосақ кейіпкері болыңыз».
Dialogue: 0,1:26:35.31,1:26:36.73,Default,,0,0,0,,Ах... Пика
Dialogue: 0,1:26:40.82,1:26:42.11,Default,,0,0,0,,ДжоДжо қарсы Вамуу—
Dialogue: 0,1:26:42.19,1:26:43.57,Default,,0,0,0,,ДжоДжо қарсы Вамуу—
Dialogue: 0,1:26:43.65,1:26:45.57,Default,,0,0,0,,Няндака өте...
Dialogue: 0,1:26:45.65,1:26:46.78,Default,,0,0,0,,Эй
Dialogue: 0,1:26:46.86,1:26:49.49,Default,,0,0,0,,Тип, тип, тип.
Dialogue: 0,1:26:49.58,1:26:51.49,Default,,0,0,0,,Біртүрлі сезім
Dialogue: 0,1:26:59.04,1:27:00.88,Default,,0,0,0,,Ах... Пика
Dialogue: 0,1:27:11.06,1:27:12.56,Default,,0,0,0,,О
Dialogue: 0,1:27:13.18,1:27:14.35,Default,,0,0,0,,Pi…
Dialogue: 0,1:27:16.31,1:27:17.31,Default,,0,0,0,,Пика хаха
Dialogue: 0,1:27:17.39,1:27:20.36,Default,,0,0,0,,(Покемон айқайлары)
Dialogue: 0,1:27:22.78,1:27:24.11,Default,,0,0,0,,Поча чаа ах
Dialogue: 0,1:27:24.19,1:27:25.78,Default,,0,0,0,,Поча Поча Поча (Чаризардтың шайқас айқайы)
Dialogue: 0,1:27:26.45,1:27:27.53,Default,,0,0,0,,Барлығы жақсарып келе жатқан сияқты.
Dialogue: 0,1:27:27.53,1:27:28.66,Default,,0,0,0,,Барлығы жақсарып келе жатқан сияқты.
Dialogue: 0,1:27:28.74,1:27:30.70,Default,,0,0,0,,Бұл Хо-оның күші
Dialogue: 0,1:27:31.12,1:27:33.16,Default,,0,0,0,,Пикачу Пикачу
Dialogue: 0,1:27:41.46,1:27:44.13,Default,,0,0,0,,Хо-о, шайқасайық
Dialogue: 0,1:27:44.21,1:27:45.71,Default,,0,0,0,,Пика Пика
Dialogue: 0,1:27:49.13,1:27:51.60,Default,,0,0,0,,(Хо-оның айқайы)
Dialogue: 0,1:28:08.90,1:28:10.91,Default,,0,0,0,,Пикачу мен сені таңдаймын
Dialogue: 0,1:28:10.99,1:28:12.20,Default,,0,0,0,,Пикачу
Dialogue: 0,1:28:12.28,1:28:14.58,Default,,0,0,0,,Ikkee 10ман болт
Dialogue: 0,1:28:14.66,1:28:16.12,Default,,0,0,0,,Пикер
Dialogue: 0,1:28:16.20,1:28:19.29,Default,,0,0,0,,Шайнаңыз!
Dialogue: 0,1:28:24.25,1:28:25.71,Default,,0,0,0,,Фи пика
Dialogue: 0,1:28:35.93,1:28:37.39,Default,,0,0,0,,Пикер
Dialogue: 0,1:28:37.47,1:28:40.60,Default,,0,0,0,,Шайнаңыз!
Dialogue: 0,1:28:56.54,1:28:57.87,Default,,0,0,0,,Өтінемін (Джой) Ах...
Dialogue: 0,1:28:58.45,1:28:59.66,Default,,0,0,0,,Пикачу
Dialogue: 0,1:28:59.75,1:29:02.04,Default,,0,0,0,,О, бізде шайқас болды.
Dialogue: 0,1:29:02.12,1:29:03.71,Default,,0,0,0,,Екінші тарап кім? Пика?
Dialogue: 0,1:29:04.00,1:29:05.04,Default,,0,0,0,,Бұл Хо-о
Dialogue: 0,1:29:05.13,1:29:06.75,Default,,0,0,0,,Эй Ча~
Dialogue: 0,1:29:06.84,1:29:08.26,Default,,0,0,0,,Уууу Пикачу
Dialogue: 0,1:29:08.34,1:29:09.63,Default,,0,0,0,,Э? Не? Мен тыңдамаппын.
Dialogue: 0,1:29:10.13,1:29:11.30,Default,,0,0,0,,Эххе
Dialogue: 0,1:29:13.68,1:29:16.64,Default,,0,0,0,,Ауа қаншалықты таза...
Dialogue: 0,1:29:17.14,1:29:21.89,Default,,0,0,0,,Бұл әлемнің бір жерінде кемпірқосақтың жаңа кейіпкері болатын біреу бар.
Dialogue: 0,1:29:22.64,1:29:25.90,Default,,0,0,0,,Ұлдар мен қыздар, өмір сүріңдер, тек өмір сүріңдер.
Dialogue: 0,1:29:26.32,1:29:28.28,Default,,0,0,0,,Сонда жол ашылады
Dialogue: 0,1:29:29.03,1:29:32.49,Default,,0,0,0,,Болашақ кемпірқосақ түсті нұрға толады.
Dialogue: 0,1:29:41.16,1:29:44.67,Default,,0,0,0,,Мен одан сайын күшейіп, саған қарсы шығамын.
Dialogue: 0,1:29:44.92,1:29:47.63,Default,,0,0,0,,А, онда мен бар күшімді салып күресемін.
Dialogue: 0,1:29:47.71,1:29:49.05,Default,,0,0,0,,Пикачу
Dialogue: 0,1:29:49.13,1:29:51.88,Default,,0,0,0,,Оған дейін ешкімнен жеңілме
Dialogue: 0,1:30:01.68,1:30:03.56,Default,,0,0,0,,Мен осы жерде қоштасамын.
Dialogue: 0,1:30:04.06,1:30:08.07,Default,,0,0,0,,Әрі қарай, мен отты найзағай мұздатқышы туралы аңызды зерттеймін.
Dialogue: 0,1:30:08.40,1:30:12.57,Default,,0,0,0,,Мен үйге бір рет қайтамын. Мен анамды көргім келеді.
Dialogue: 0,1:30:12.65,1:30:13.74,Default,,0,0,0,,Сатоси туралы не деуге болады?
Dialogue: 0,1:30:13.82,1:30:16.91,Default,,0,0,0,,Әрине мен өз жолыммен барамын
Dialogue: 0,1:30:16.99,1:30:18.66,Default,,0,0,0,,Покемон шебері болуды мақсат етіңіз.
Dialogue: 0,1:30:18.74,1:30:19.99,Default,,0,0,0,,Пика Пика
Dialogue: 0,1:30:20.54,1:30:22.91,Default,,0,0,0,,Егер мен сізді сапарымда тағы бір жерде кездестірсем...
Dialogue: 0,1:30:23.29,1:30:24.29,Default,,0,0,0,,Иә
Dialogue: 0,1:30:25.21,1:30:26.21,Default,,0,0,0,,Иә
Dialogue: 0,1:30:27.42,1:30:28.42,Default,,0,0,0,,Иә
Dialogue: 0,1:30:30.42,1:30:32.09,Default,,0,0,0,,Ұрысайық
Dialogue: 0,1:30:32.92,1:30:36.09,Default,,0,0,0,,(Сатоши мен оның достарының күлкісі)
Dialogue: 0,1:30:36.18,1:30:38.01,Default,,0,0,0,,Почапоча
Dialogue: 0,1:30:38.10,1:30:40.68,Default,,0,0,0,,Пика Пика Пикачу~
Dialogue: 0,1:31:10.75,1:31:13.38,Default,,0,0,0,,Барайық Пикачу Пикачу
Dialogue: 0,1:31:15.88,1:31:17.13,Default,,0,0,0,,Таңдаушы!
Dialogue: 0,1:31:20.22,1:31:23.39,Default,,0,0,0,,Покемон қысқа покемон
Dialogue: 0,1:31:23.47,1:31:26.77,Default,,0,0,0,,Бұл планетадағы жұмбақ, жұмбақ тіршілік иелері
Dialogue: 0,1:31:27.56,1:31:32.48,Default,,0,0,0,,Аспанда, теңізде, орманда, қалада—
Dialogue: 0,1:31:32.57,1:31:36.70,Default,,0,0,0,,Оны бүкіл дүние жүзінен көруге болады
Dialogue: 0,1:31:37.61,1:31:40.74,Default,,0,0,0,,Адамдар мен Покемон әртүрлі байланыстар құрайды.
Dialogue: 0,1:31:40.82,1:31:44.08,Default,,0,0,0,,Бұл дүниеде бірге бақытты өмір сүрдік.
Dialogue: 0,1:31:47.41,1:31:50.92,Default,,0,0,0,,Масала қаласынан келген Сатоши бала
Dialogue: 0,1:31:51.00,1:31:54.46,Default,,0,0,0,,Серіктес Пикачумен Покемон шебері болуды мақсат ету —
Dialogue: 0,1:31:54.55,1:31:56.97,Default,,0,0,0,,Жаттығу сапарын жалғастыру
Dialogue: 0,1:31:57.38,1:31:59.59,Default,,0,0,0,,Покемон қанша болса, сонша арман бар.
Dialogue: 0,1:31:59.68,1:32:03.47,Default,,0,0,0,,Сізді қанша Покемон күтіп тұрса, сонша шытырман оқиға бар.
Dialogue: 0,1:32:22.70,1:32:28.71,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:36:49.84,1:36:55.85,Default,,0,0,0,,~♪
