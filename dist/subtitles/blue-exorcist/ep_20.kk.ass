Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:35.51,0:00:37.57,Default,,0,0,0,,Мен монастырда болған кезім→
Dialogue: 0,0:00:37.57,0:00:39.62,Default,,0,0,0,,Ағам оралды ма деп ойлаймын→
Dialogue: 0,0:00:39.62,0:00:41.72,Default,,0,0,0,,Мен кірер алдында бірден білдім.
Dialogue: 0,0:00:44.36,0:00:47.98,Default,,0,0,0,,Сонымен ағам кешкі асқа кешігіп қалды →
Dialogue: 0,0:00:47.98,0:00:50.03,Default,,0,0,0,,Бұл өте тыныш...
Dialogue: 0,0:00:50.03,0:00:52.06,Default,,0,0,0,,≫ (Рин Окумура/Естелік) ((Мен үйдемін~)) (Нагатомо) ((Кеш болды, Рин))
Dialogue: 0,0:00:52.06,0:00:54.58,Default,,0,0,0,,(Марута) ((Қош келдіңіз, Рин-кун)) (Изуми) ((Бәрібір, басқа жерде →
Dialogue: 0,0:00:54.58,0:00:57.40,Default,,0,0,0,,Сіз ұрысып қалдыңыз ба? )) ((Бұл тітіркендіргіш →
Dialogue: 0,0:00:57.40,0:00:59.44,Default,,0,0,0,,Менің де істейтін істерім бар))
Dialogue: 0,0:00:59.44,0:01:02.21,Default,,0,0,0,,(Kyodo) ((бұл әйелдер туралы емес екеніне сенімдімін))
Dialogue: 0,0:01:02.21,0:01:04.28,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:04.28,0:01:15.49,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:15.49,0:01:17.54,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,0:01:17.54,0:01:21.24,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:22.63,0:02:02.61,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:05.90,0:02:51.26,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:04.65,0:03:07.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:07.77,0:03:09.87,Default,,0,0,0,,Не? Сонымен... Ха!
Dialogue: 0,0:03:09.87,0:03:14.42,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:14.42,0:03:17.79,Default,,0,0,0,,(2 адам) Ах! Киодо-сан… Нагатомо-сан….
Dialogue: 0,0:03:17.79,0:03:21.86,Default,,0,0,0,,Марута… Изуми…. (Медициналық рыцарь) Артында болыңыз →
Dialogue: 0,0:03:21.86,0:03:24.90,Default,,0,0,0,,Барлығы әлі де тыныс алуда. Түсіндіру кейінірек келеді.
Dialogue: 0,0:03:24.90,0:03:27.08,Default,,0,0,0,,Жер бетінде не...?
Dialogue: 0,0:03:27.08,0:03:29.07,Default,,0,0,0,,Бұл... Ах...
Dialogue: 0,0:03:29.07,0:03:32.57,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:32.57,0:03:34.63,Default,,0,0,0,,Бұл поляк сияқты. →
Dialogue: 0,0:03:34.63,0:03:37.14,Default,,0,0,0,,«Мен жындармен байланысқан ешкімді кешірмеймін»….
Dialogue: 0,0:03:37.14,0:03:39.14,Default,,0,0,0,,«Жындармен байланыстылар»….
Dialogue: 0,0:03:40.71,0:03:43.13,Default,,0,0,0,,Не, сен мен туралы айтып тұрсың ба?
Dialogue: 0,0:03:43.13,0:03:45.42,Default,,0,0,0,,Кім осындай нәрсені жасайды...?
Dialogue: 0,0:03:45.42,0:03:48.69,Default,,0,0,0,,Біз мұнда жеткенде, зардап шеккендердің бірі→
Dialogue: 0,0:03:48.69,0:03:51.69,Default,,0,0,0,,Сөйлей алмаймын...
Dialogue: 0,0:03:51.69,0:03:55.00,Default,,0,0,0,,Бетперде киген адам екенін айтты.
Dialogue: 0,0:03:55.00,0:03:57.87,Default,,0,0,0,,Бетперде киген адам?
Dialogue: 0,0:03:57.87,0:04:00.87,Default,,0,0,0,,(медициналық инженер Найт) Бұл жіп сиқырлы күшпен иірілген. →
Dialogue: 0,0:04:00.87,0:04:04.61,Default,,0,0,0,,Ол қатайып, бүкіл денені жауып, гипс сияқты болады.
Dialogue: 0,0:04:04.61,0:04:07.74,Default,,0,0,0,,Барлығы жақсы ма? (Медициналық инженер Найт) Дененің айналасында →
Dialogue: 0,0:04:07.74,0:04:10.14,Default,,0,0,0,,Жұқа қорғаныс қабатын жасайды. →
Dialogue: 0,0:04:10.14,0:04:12.73,Default,,0,0,0,,Шабуыл жасамас бұрын, өзіңізді қорғауға тырысыңыз →
Dialogue: 0,0:04:12.73,0:04:14.77,Default,,0,0,0,,Олар ән айтып жүрген болуы керек. →
Dialogue: 0,0:04:14.77,0:04:18.42,Default,,0,0,0,,Алайда оның тиімділігі бірте-бірте төмендейді. →
Dialogue: 0,0:04:18.42,0:04:20.82,Default,,0,0,0,,Сегіз сағат.
Dialogue: 0,0:04:20.82,0:04:22.82,Default,,0,0,0,,Ертең сағат 2-де….
Dialogue: 0,0:04:24.31,0:04:27.13,Default,,0,0,0,,(медициналық инженер Найт) Мен қолайлы сиқырлы сусынды анықтауға тырысамын.→
Dialogue: 0,0:04:27.13,0:04:29.91,Default,,0,0,0,,Бұрын-соңды болмаған затпен→
Dialogue: 0,0:04:29.91,0:04:32.21,Default,,0,0,0,,Менде қиындық бар. Қарғыс атқыр...
Dialogue: 0,0:04:34.27,0:04:36.27,Default,,0,0,0,,Сен
Dialogue: 0,0:04:38.41,0:04:42.01,Default,,0,0,0,,Тоқтама, Юкио! Қарсыластың нысанасы – менің ағам.
Dialogue: 0,0:04:42.01,0:04:44.35,Default,,0,0,0,,Сондықтан мен кетсем, жау міндетті түрде...
Dialogue: 0,0:04:44.35,0:04:46.93,Default,,0,0,0,,Ендеше, жаудың қалағаны осы!
Dialogue: 0,0:04:46.93,0:04:49.03,Default,,0,0,0,,Мен әкеме ант бердім→
Dialogue: 0,0:04:49.03,0:04:51.42,Default,,0,0,0,,Мен ағамды қорғаймын! Ах...
Dialogue: 0,0:04:51.42,0:04:54.19,Default,,0,0,0,,Неге мені тыңдамайсың!?
Dialogue: 0,0:04:54.19,0:04:57.54,Default,,0,0,0,,Оны жіберме! Мені қорғайтын ағам болмаса да →
Dialogue: 0,0:04:57.54,0:05:00.31,Default,,0,0,0,,Өзіңе қамқор бол! Ха!
Dialogue: 0,0:05:00.31,0:05:03.41,Default,,0,0,0,,Ах... Төбелесуге уақыт жоқ!
Dialogue: 0,0:05:04.97,0:05:06.97,Default,,0,0,0,,Сен
Dialogue: 0,0:05:06.97,0:05:11.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:11.21,0:05:13.51,Default,,0,0,0,,​​≪Қайда? Қайда бардың? ≫
Dialogue: 0,0:05:15.76,0:05:19.18,Default,,0,0,0,,Ха ха ха ха ха….
Dialogue: 0,0:05:19.18,0:05:22.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:22.53,0:05:24.53,Default,,0,0,0,,Ах... Хмм!
Dialogue: 0,0:05:25.95,0:05:29.02,Default,,0,0,0,,Тос! Қарғыс атсын! Сен кімсің!?
Dialogue: 0,0:05:29.02,0:05:31.84,Default,,0,0,0,,Басынан нысана мен болдым, солай ма?
Dialogue: 0,0:05:31.84,0:05:35.26,Default,,0,0,0,,(Беткі киген адам) Ойлан... иә?
Dialogue: 0,0:05:35.26,0:05:38.16,Default,,0,0,0,,Маңызды нәрсені жоғалтудың азабы.
Dialogue: 0,0:05:39.73,0:05:41.77,Default,,0,0,0,,Уфф хахахахаха
Dialogue: 0,0:05:41.77,0:05:44.62,Default,,0,0,0,,А, не!? Ах! Баши!
Dialogue: 0,0:05:44.62,0:05:47.63,Default,,0,0,0,,Уф... Уф! (Беткі киген адам) Хехехехе →
Dialogue: 0,0:05:47.63,0:05:49.78,Default,,0,0,0,,Мен сені оңай өлтірмеймін →
Dialogue: 0,0:05:49.78,0:05:52.30,Default,,0,0,0,,Мен сияқты азап →
Dialogue: 0,0:05:52.30,0:05:55.30,Default,,0,0,0,,Толық дәмін татқанша.
Dialogue: 0,0:05:57.77,0:05:59.99,Default,,0,0,0,,≫Ағайын! Ах...
Dialogue: 0,0:05:59.99,0:06:01.99,Default,,0,0,0,,Ол жын құдайының ұлының інісі ме?
Dialogue: 0,0:06:03.46,0:06:06.46,Default,,0,0,0,,Жарылыс! (мылтық) Юкио!
Dialogue: 0,0:06:06.46,0:06:09.10,Default,,0,0,0,,Хахахаха.
Dialogue: 0,0:06:09.10,0:06:11.15,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:11.15,0:06:14.08,Default,,0,0,0,,Әй, Шура. Маған үзіліс беріңіз →
Dialogue: 0,0:06:14.08,0:06:17.20,Default,,0,0,0,,Өзімшілдік жасаған сайын, сізді шақырады!
Dialogue: 0,0:06:17.20,0:06:20.14,Default,,0,0,0,,Қарғыс атсын! О... эй!
Dialogue: 0,0:06:20.14,0:06:31.85,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:31.85,0:06:35.27,Default,,0,0,0,,Күрсіну…. Ах...
Dialogue: 0,0:06:35.27,0:06:47.42,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:47.42,0:06:49.79,Default,,0,0,0,,Хмм….
Dialogue: 0,0:06:49.79,0:06:51.82,Default,,0,0,0,,Қозғалмаңыз! Ха...
Dialogue: 0,0:06:51.82,0:06:56.54,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:56.54,0:06:58.76,Default,,0,0,0,,Профессор Нейгаус….
Dialogue: 0,0:06:58.76,0:07:00.91,Default,,0,0,0,,((Джин мырза...→
Dialogue: 0,0:07:00.91,0:07:04.34,Default,,0,0,0,,Және шайтан деп аталатын барлық нәрсе! →
Dialogue: 0,0:07:04.34,0:07:07.79,Default,,0,0,0,,Жын құдайдың ұлы туралы сөз жоқ! ))
Dialogue: 0,0:07:07.79,0:07:10.39,Default,,0,0,0,,Ұстаз... сенің әлі ағаң бар!
Dialogue: 0,0:07:12.68,0:07:15.68,Default,,0,0,0,,Монастырға шабуыл жасаған сен болдың ғой?
Dialogue: 0,0:07:15.68,0:07:19.08,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Алдамаңыз!
Dialogue: 0,0:07:19.08,0:07:22.12,Default,,0,0,0,,Сол иыққа байланған жіп...→
Dialogue: 0,0:07:22.12,0:07:24.36,Default,,0,0,0,,Бұл сиқырлы күшпен иірілген жіп.
Dialogue: 0,0:07:24.36,0:07:28.23,Default,,0,0,0,,Жіп монастырь бойына созылған.
Dialogue: 0,0:07:28.23,0:07:31.50,Default,,0,0,0,,Юкио Окумура 0 ұпай. иә?
Dialogue: 0,0:07:31.50,0:07:34.08,Default,,0,0,0,,Бұл пайымдау бағалауға тұрарлық емес. →
Dialogue: 0,0:07:34.08,0:07:36.78,Default,,0,0,0,,Осыған ұқсас нәрсе. Өрмекші жібек барлық жерде. →
Dialogue: 0,0:07:36.78,0:07:40.09,Default,,0,0,0,,Бұл жерде де. Жалтарған дұрыс.
Dialogue: 0,0:07:40.09,0:07:43.99,Default,,0,0,0,,Қалған хабар еліңіздің тілінде болды.
Dialogue: 0,0:07:43.99,0:07:47.16,Default,,0,0,0,,Ал менің ағам екеумізде жын қаны бар.
Dialogue: 0,0:07:47.16,0:07:49.26,Default,,0,0,0,,Білетін адамдардың саны шектеулі.
Dialogue: 0,0:07:49.26,0:07:54.10,Default,,0,0,0,,Бұлыңғыр көзбен нені қарасаң да ақиқатқа жете алмайсың.
Dialogue: 0,0:07:54.10,0:07:56.14,Default,,0,0,0,,Мен сені мектепке шақырамын.
Dialogue: 0,0:07:56.14,0:07:58.39,Default,,0,0,0,,Сол жерде шындықты тыңдайық.
Dialogue: 0,0:07:58.39,0:08:01.44,Default,,0,0,0,,Жоқ десем ше?
Dialogue: 0,0:08:01.44,0:08:03.61,Default,,0,0,0,,Гррр…
Dialogue: 0,0:08:03.61,0:08:05.65,Default,,0,0,0,,Do-do-do-do... Ah!
Dialogue: 0,0:08:05.65,0:08:07.68,Default,,0,0,0,,Қол шапалақта! Қарғыс атсын!
Dialogue: 0,0:08:07.68,0:08:10.75,Default,,0,0,0,,Жарылыс! Жасау-істеу-істеу...
Dialogue: 0,0:08:10.75,0:08:13.45,Default,,0,0,0,,Таң! Таң!
Dialogue: 0,0:08:20.23,0:08:23.41,Default,,0,0,0,,Сіз қашып үлгердіңіз бе?
Dialogue: 0,0:08:23.41,0:08:26.80,Default,,0,0,0,,Хмм... Қарғыс атсын, мен одан шыға алмаймын!
Dialogue: 0,0:08:26.80,0:08:29.85,Default,,0,0,0,,Не болып жатыр? бұл.
Dialogue: 0,0:08:29.85,0:08:32.41,Default,,0,0,0,,Нейгаус ше? Иә →
Dialogue: 0,0:08:32.41,0:08:36.61,Default,,0,0,0,,Нейгаус мырзаның менің ағамды нысанаға алуының себебі бар екені рас.
Dialogue: 0,0:08:36.61,0:08:39.78,Default,,0,0,0,,​​Мен ол жерде кездейсоқ болуды елестете алмаймын.
Dialogue: 0,0:08:39.78,0:08:41.92,Default,,0,0,0,,Ол кісі мектепті тастап кетті→
Dialogue: 0,0:08:41.92,0:08:43.98,Default,,0,0,0,,Сенің туған жеріңе оралғаныңды естідім.
Dialogue: 0,0:08:43.98,0:08:46.95,Default,,0,0,0,,Әрине, бұл Мефистоның бейбақы туралы әңгіме →
Dialogue: 0,0:08:46.95,0:08:51.09,Default,,0,0,0,,Мен оған қаншалықты сенетінімді білмеймін. Күте тұрыңыз...→
Dialogue: 0,0:08:51.09,0:08:53.16,Default,,0,0,0,,Ол өткен күндегі кілт арқылы ашылды→
Dialogue: 0,0:08:53.16,0:08:57.43,Default,,0,0,0,,Мектеп шлагбаумындағы тесік... Мен сенімдімін →
Dialogue: 0,0:08:57.43,0:09:01.02,Default,,0,0,0,,Жасанды өмірге арналған ғылыми-зерттеу институты болғанын айттыңыз.
Dialogue: 0,0:09:01.02,0:09:04.32,Default,,0,0,0,,Адам мен жануардың мәйіттері біріктірілген→
Dialogue: 0,0:09:04.32,0:09:09.48,Default,,0,0,0,,Олар көбінесе жасанды өмірді зерттеу үшін және күзетші иттер ретінде пайдаланылады.
Dialogue: 0,0:09:09.48,0:09:12.25,Default,,0,0,0,,Бұл сізді профессор Нейгауспен байланыстырады.
Dialogue: 0,0:09:12.25,0:09:15.93,Default,,0,0,0,,Дегенмен, жасанды өмір туралы зерттеулер қазіргі уақытта →
Dialogue: 0,0:09:15.93,0:09:18.45,Default,,0,0,0,,Ватикан қатаң тыйым салған.
Dialogue: 0,0:09:18.45,0:09:20.45,Default,,0,0,0,,Хмм….
Dialogue: 0,0:09:21.91,0:09:25.21,Default,,0,0,0,,Қайда бара жатырсың? Аға. Мен оны тоқтатуым керек.
Dialogue: 0,0:09:25.21,0:09:28.86,Default,,0,0,0,,Егер сіз жын семсерін де пайдалана алмасаңыз, қалай күресуге болады?
Dialogue: 0,0:09:28.86,0:09:31.72,Default,,0,0,0,,Қарғыс атсын! Мен ілесемін.
Dialogue: 0,0:09:31.72,0:09:35.07,Default,,0,0,0,,Мен басқа мұғалімдерден қолдау сұрадым. Енді мен үшін жоқ →
Dialogue: 0,0:09:35.07,0:09:38.14,Default,,0,0,0,,Мен ешкімге зиян тигізе алмаймын!
Dialogue: 0,0:09:38.14,0:09:40.81,Default,,0,0,0,,Мен сені бүгін міндетті түрде жібермеймін. Уф...
Dialogue: 0,0:09:40.81,0:09:44.11,Default,,0,0,0,,Мен әрқашан ағамның қалағанын істей аламын деп ойлаған кезде→
Dialogue: 0,0:09:44.11,0:09:46.11,Default,,0,0,0,,Үлкен қате.
Dialogue: 0,0:09:47.85,0:09:51.45,Default,,0,0,0,,Сіз неге еліктеп жатырсыз? Юкио, қалжыңдама!
Dialogue: 0,0:09:51.45,0:09:55.89,Default,,0,0,0,,Мен байсалдымын, ағайын. Немесе қайтадан →
Dialogue: 0,0:09:55.89,0:09:58.16,Default,,0,0,0,,Мені ұрғың келе ме?
Dialogue: 0,0:09:58.16,0:10:02.46,Default,,0,0,0,,Сол шайтанның күшімен. Юкио... Эй!
Dialogue: 0,0:10:02.46,0:10:05.05,Default,,0,0,0,,Ей, Юкио, не асығып тұрсың?
Dialogue: 0,0:10:05.05,0:10:09.37,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:09.37,0:10:11.97,Default,,0,0,0,,Жарылыс! Уф! Аа….
Dialogue: 0,0:10:11.97,0:10:15.34,Default,,0,0,0,,Юкио! Бұл тез әсер ететін транквилизатор оқ.
Dialogue: 0,0:10:15.34,0:10:17.53,Default,,0,0,0,,Сіз тым итермелейсіз дейсіз...
Dialogue: 0,0:10:17.53,0:10:20.15,Default,,0,0,0,,Мен ағамды қорғауға міндеттімін.
Dialogue: 0,0:10:20.15,0:10:23.43,Default,,0,0,0,,Қалғаны өзіңізге байланысты. Әй, Юкио!
Dialogue: 0,0:10:23.43,0:10:28.04,Default,,0,0,0,,Ю… Юкио… Иә…. ≫Gacha bang (есік дыбысы)
Dialogue: 0,0:10:28.04,0:10:35.98,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:35.98,0:10:38.87,Default,,0,0,0,,Профессор Нейгаус осында ма?
Dialogue: 0,0:10:38.87,0:10:42.34,Default,,0,0,0,,Трекер реакциясы осы жерден төменнен келеді.
Dialogue: 0,0:10:42.34,0:10:45.74,Default,,0,0,0,,Екіге бөлейік. Саған бұрын берген амулетім →
Dialogue: 0,0:10:45.74,0:10:48.01,Default,,0,0,0,,Бұл жай сақтандыру.
Dialogue: 0,0:10:48.01,0:10:50.61,Default,,0,0,0,,Егер сізге жіппен шабуыл жасалса, мүмкіндігінше тырысыңыз →
Dialogue: 0,0:10:50.61,0:10:53.61,Default,,0,0,0,,Өлең айту арқылы тұншығудың алдын алу. (3 адам) Иә...
Dialogue: 0,0:10:55.65,0:10:59.62,Default,,0,0,0,,Кеңестер Кеңестер Кеңестер Кеңестер (аяқ дыбыстары)
Dialogue: 0,0:10:59.62,0:11:09.73,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:09.73,0:11:12.10,Default,,0,0,0,,(Юнокава) Иә? Мені естімей тұрсың ба?
Dialogue: 0,0:11:12.10,0:11:14.10,Default,,0,0,0,,(Юнокава) Иә? Тынш!
Dialogue: 0,0:11:15.47,0:11:19.79,Default,,0,0,0,,Кеңестер... Кеңестер Кеңестер Кеңестер...
Dialogue: 0,0:11:19.79,0:11:27.23,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:27.23,0:11:29.23,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:11:29.23,0:11:33.07,Default,,0,0,0,,Тск, сен табанды жігіт. (Юнокава) Мұғалім!
Dialogue: 0,0:11:33.07,0:11:35.11,Default,,0,0,0,,Тек қолыңызды көтеріңіз!
Dialogue: 0,0:11:35.11,0:11:40.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:40.21,0:11:42.35,Default,,0,0,0,,(Юнокава) Уф! Bang! Bang!
Dialogue: 0,0:11:42.35,0:11:44.80,Default,,0,0,0,,Жарылыс! Күте тұрыңыз!
Dialogue: 0,0:11:44.80,0:11:46.83,Default,,0,0,0,,Хмм….
Dialogue: 0,0:11:46.83,0:11:49.90,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:49.90,0:11:52.96,Default,,0,0,0,,Қарғыс атсын! ≪(Юнокава) Ахх!!
Dialogue: 0,0:11:52.96,0:11:54.96,Default,,0,0,0,,Ха...
Dialogue: 0,0:11:57.34,0:12:00.46,Default,,0,0,0,,Ах! Башан!
Dialogue: 0,0:12:00.46,0:12:04.66,Default,,0,0,0,,Ха, ұстаз! Юнокава мырза! (2 адам) Ах!
Dialogue: 0,0:14:14.46,0:14:17.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:17.58,0:14:22.02,Default,,0,0,0,,Ха! Хм... Юкио... О...
Dialogue: 0,0:14:22.02,0:14:24.17,Default,,0,0,0,,Няхаха, мен жартылай ұйықтап жатырмын.
Dialogue: 0,0:14:24.17,0:14:27.63,Default,,0,0,0,,Сізде әлі біраз наркоз бар, солай ма? Тыныш бол.
Dialogue: 0,0:14:27.63,0:14:30.41,Default,,0,0,0,,Қарғыс атсын әлгі Юкио жігіті...→
Dialogue: 0,0:14:30.41,0:14:32.71,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:34.07,0:14:36.42,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,0:14:36.42,0:14:40.19,Default,,0,0,0,,Ақыр соңында, бұл мен болдым ... Йосе Йосе.
Dialogue: 0,0:14:40.19,0:14:44.39,Default,,0,0,0,,Сондықтан сіз өз жалыныңызды қанағаттанарлықтай басқара алмайсыз →
Dialogue: 0,0:14:44.39,0:14:47.18,Default,,0,0,0,,Барсам да саған пайдасы жоқ.
Dialogue: 0,0:14:47.18,0:14:50.87,Default,,0,0,0,,Не…? Өйткені сіз жалынмен теңселіп жатырсыз →
Dialogue: 0,0:14:50.87,0:14:54.96,Default,,0,0,0,,Сіз бәрінің айла-шарғы жасап жатқанын түсінбейсіз бе? →
Dialogue: 0,0:14:54.96,0:14:58.19,Default,,0,0,0,,Сіз оны дұрыс басқара алатын болсаңыз, →
Dialogue: 0,0:14:58.19,0:15:01.50,Default,,0,0,0,,Сондай-ақ біреуді қорқытуы мүмкін→
Dialogue: 0,0:15:01.50,0:15:03.71,Default,,0,0,0,,Бұл сізді алаңдатуы мүмкін →
Dialogue: 0,0:15:03.71,0:15:07.10,Default,,0,0,0,,Мүмкін тіпті азап жойылады.
Dialogue: 0,0:15:07.10,0:15:10.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:10.82,0:15:13.49,Default,,0,0,0,,Жоқ, мен білемін! бірақ!
Dialogue: 0,0:15:13.49,0:15:16.13,Default,,0,0,0,,Білмесеңіз, бұл біріншісі.
Dialogue: 0,0:15:16.13,0:15:19.76,Default,,0,0,0,,Демек, бұл жаттығу жасайтын уақыт емес, солай ма?
Dialogue: 0,0:15:19.76,0:15:24.08,Default,,0,0,0,,Бұл жаттығу емес, бұл нақты ұрыс. иә?
Dialogue: 0,0:15:24.08,0:15:27.82,Default,,0,0,0,,Бұл шамдар сіздің маңызды адамдарыңыз. →
Dialogue: 0,0:15:27.82,0:15:30.44,Default,,0,0,0,,Жалынды басқара алмасаңыз →
Dialogue: 0,0:15:30.44,0:15:33.26,Default,,0,0,0,,Барлығы өледі.
Dialogue: 0,0:15:33.26,0:15:36.00,Default,,0,0,0,,Сізде бір ғана мүмкіндік бар.
Dialogue: 0,0:15:36.00,0:15:38.06,Default,,0,0,0,,Хмм….
Dialogue: 0,0:15:38.06,0:15:40.48,Default,,0,0,0,,Бұл жаттығу ма, әлде нақты ұрыс па маңызды емес.
Dialogue: 0,0:15:40.48,0:15:43.97,Default,,0,0,0,,Жалынды басқара алатыныңызды дәлелдей алмасаңыз →
Dialogue: 0,0:15:43.97,0:15:47.12,Default,,0,0,0,,Ешкімнің сеніміне кіре алмайсың.
Dialogue: 0,0:15:47.12,0:15:51.33,Default,,0,0,0,,Жалыныңды басу үшін ерік-жігеріңді пайдалан!
Dialogue: 0,0:15:51.33,0:15:54.33,Default,,0,0,0,,≪Менің қалауым бойынша...≫
Dialogue: 0,0:15:57.05,0:15:59.12,Default,,0,0,0,,Уф.
Dialogue: 0,0:15:59.12,0:16:02.02,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:03.81,0:16:06.33,Default,,0,0,0,,Тағзым!
Dialogue: 0,0:16:06.33,0:16:09.71,Default,,0,0,0,,(Цубаки) Бұл сіздің жалғыз емес екеніңізді білдіре ме?
Dialogue: 0,0:16:09.71,0:16:12.47,Default,,0,0,0,,Мен ауырып қалдым. [ТЕЛ]
Dialogue: 0,0:16:12.47,0:16:15.27,Default,,0,0,0,,А~ мен. Не!?→
Dialogue: 0,0:16:15.27,0:16:17.45,Default,,0,0,0,,Иә. Иә. Түсіндім →
Dialogue: 0,0:16:17.45,0:16:19.71,Default,,0,0,0,,Дереу сонда барыңыз. мұғалім.
Dialogue: 0,0:16:19.71,0:16:22.49,Default,,0,0,0,,(Цубаки) Мен оның ізін қадағалай алдым. Бұл қайда?
Dialogue: 0,0:16:22.49,0:16:26.18,Default,,0,0,0,,(Цубаки) Бұл Сэйцзюй академиясының ұлдар жатақханасы. Ха!
Dialogue: 0,0:16:26.18,0:16:28.92,Default,,0,0,0,,(Мива) Уау! (Шима) Котенка!
Dialogue: 0,0:16:28.92,0:16:32.22,Default,,0,0,0,,Иә! Сіз қандайсыз?
Dialogue: 0,0:16:32.22,0:16:34.14,Default,,0,0,0,,Бұл шайтан ба? Бұл адам ба?
Dialogue: 0,0:16:34.14,0:16:36.24,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:36.24,0:16:38.51,Default,,0,0,0,,Баши! (Шима) Қарғыс атсын!
Dialogue: 0,0:16:38.51,0:16:40.51,Default,,0,0,0,,(Кацуро) Эй. мылтық!
Dialogue: 0,0:16:41.93,0:16:44.33,Default,,0,0,0,,Уау! (Шима) Бо! Уф...
Dialogue: 0,0:16:46.77,0:16:49.32,Default,,0,0,0,,Ууууууууууууууууууу!
Dialogue: 0,0:16:49.32,0:16:52.22,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:16:54.17,0:16:56.34,Default,,0,0,0,,Зиянкесуші кім? (Күзетші) Куәгер болған студенттердің →
Dialogue: 0,0:16:56.34,0:17:00.21,Default,,0,0,0,,Айғақ бойынша: «Бетперде киген адам». (2 адам) Ха...
Dialogue: 0,0:17:00.21,0:17:02.85,Default,,0,0,0,,(Күзетші) Оқушылардың көбі қашып кеткен сияқты →
Dialogue: 0,0:17:02.85,0:17:05.52,Default,,0,0,0,,Асханада бірнеше студент қалды. →
Dialogue: 0,0:17:05.52,0:17:09.01,Default,,0,0,0,,Жын шығару мектебінің оқушылары... Крам мектебінде...
Dialogue: 0,0:17:09.01,0:17:11.12,Default,,0,0,0,,(Цубаки) Сұранысыңыз бар ма? (Күзетші) Кепіл →
Dialogue: 0,0:17:11.12,0:17:14.73,Default,,0,0,0,,Ешкім өлтірілгісі келмейінше кіруге рұқсат етілмейді. →
Dialogue: 0,0:17:14.73,0:17:17.61,Default,,0,0,0,,Тек... Бұл не?
Dialogue: 0,0:17:17.61,0:17:20.27,Default,,0,0,0,,Шайтанның ұлынан басқа.
Dialogue: 0,0:17:20.27,0:17:22.30,Default,,0,0,0,,Ха…. ≪Заза зазаза… (аяқ дыбысы)
Dialogue: 0,0:17:22.30,0:17:24.67,Default,,0,0,0,,Менің мектебіме шабуыл жасау →
Dialogue: 0,0:17:24.67,0:17:27.72,Default,,0,0,0,,Бұл үлкен батылдық. (Цубаки) Төраға!
Dialogue: 0,0:17:27.72,0:17:30.34,Default,,0,0,0,,Мен сені өкіндіремін.
Dialogue: 0,0:17:30.34,0:17:39.47,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:39.47,0:17:43.87,Default,,0,0,0,,(Цубаки) Бұл... төраға ақыры осыған байсалды келеді...
Dialogue: 0,0:17:45.59,0:17:47.59,Default,,0,0,0,,Bilibili! Жыртылған!
Dialogue: 0,0:17:49.16,0:17:52.73,Default,,0,0,0,,1… 2…. Заза!
Dialogue: 0,0:17:52.73,0:17:55.02,Default,,0,0,0,,Не!?
Dialogue: 0,0:17:55.02,0:17:58.67,Default,,0,0,0,,Түн ортасында отпен ойнау маған қатты әсер еткен жоқ.
Dialogue: 0,0:17:58.67,0:18:02.76,Default,,0,0,0,,Бұл сіз болдыңыз ба? Мұнымен не айтқың келеді?
Dialogue: 0,0:18:02.76,0:18:06.75,Default,,0,0,0,,Ватикан сізді қамауға алуға ордер берді. →
Dialogue: 0,0:18:06.75,0:18:10.65,Default,,0,0,0,,Жасанды өмір туралы зерттеулер сіз үшін тыйым болып саналады →
Dialogue: 0,0:18:10.65,0:18:13.20,Default,,0,0,0,,Мені қылмысқа қатысы бар деп күдіктенді.
Dialogue: 0,0:18:13.20,0:18:16.11,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,0:18:16.11,0:18:18.14,Default,,0,0,0,,Айтар сөзіңіз болса →
Dialogue: 0,0:18:18.14,0:18:20.61,Default,,0,0,0,,Сіз мұны Ватикан түрмесінде айтасыз. →
Dialogue: 0,0:18:20.61,0:18:22.98,Default,,0,0,0,,Мені өзіңізбен бірге алыңыз.
Dialogue: 0,0:18:22.98,0:18:26.60,Default,,0,0,0,,(2 адам) Уа…. Мен қашпаймын немесе жасырмаймын.
Dialogue: 0,0:18:26.60,0:18:31.47,Default,,0,0,0,,Неліктен бұл уақыт?
Dialogue: 0,0:18:31.47,0:18:35.54,Default,,0,0,0,,Хмм... Мен тез шешім қабылдаймын деп үміттенемін. →
Dialogue: 0,0:18:35.54,0:18:37.84,Default,,0,0,0,,Бізді мазаламаңыз.
Dialogue: 0,0:18:39.36,0:18:44.55,Default,,0,0,0,,Не болды? Жасанды өмір?
Dialogue: 0,0:18:44.55,0:18:49.74,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:49.74,0:18:52.38,Default,,0,0,0,,Окумура мырза, күте тұрыңыз!
Dialogue: 0,0:18:52.38,0:18:54.78,Default,,0,0,0,,Бір адам немесе бірнеше адам бар ма →
Dialogue: 0,0:18:54.78,0:18:58.80,Default,,0,0,0,,Осының өзі оны растайды. Енді ешқашан сәтсіздікке ұшырамаңыз ...
Dialogue: 0,0:18:58.80,0:19:01.50,Default,,0,0,0,,Қолдау келгенше күтіңіз. Және →
Dialogue: 0,0:19:01.50,0:19:04.62,Default,,0,0,0,,Бауырың үшін де... Жоқ!
Dialogue: 0,0:19:04.62,0:19:07.92,Default,,0,0,0,,Әй... Өтінемін, ағамды ешқашан шақырма.
Dialogue: 0,0:19:07.92,0:19:10.32,Default,,0,0,0,,О, Окумура мырза!
Dialogue: 0,0:19:13.63,0:19:16.63,Default,,0,0,0,,≫Түртпе ілмек...(аяқ дыбысы)
Dialogue: 0,0:19:19.90,0:19:22.87,Default,,0,0,0,,≪Күтілгендей, басқа сыныптарда басқа ешкім жоқ≫
Dialogue: 0,0:19:22.87,0:19:26.89,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:26.89,0:19:30.88,Default,,0,0,0,,(Сугуро) Неге? Неліктен сумакиді біз жалғыз жасамаймыз?
Dialogue: 0,0:19:30.88,0:19:32.92,Default,,0,0,0,,≪Ақырында бір адам...≫
Dialogue: 0,0:19:32.92,0:19:35.20,Default,,0,0,0,,Жын құдайдың баласына қатысы барлар→
Dialogue: 0,0:19:35.20,0:19:38.54,Default,,0,0,0,,Барлығын өлтір. (Кацуро) Не?
Dialogue: 0,0:19:38.54,0:19:43.24,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:43.24,0:19:47.04,Default,,0,0,0,,≫Кеңестер Кеңестер Кеңестер Кеңестер Hah….
Dialogue: 0,0:19:49.40,0:19:51.47,Default,,0,0,0,,(Шима) Әй, менің ұялы телефоным... Бип сигналы (ұялы телефон жұмысының дыбысы)
Dialogue: 0,0:19:51.47,0:19:53.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:53.54,0:19:56.39,Default,,0,0,0,,Уф... [ТЕЛ] (қоңырау үні)
Dialogue: 0,0:19:56.39,0:19:58.99,Default,,0,0,0,,Уф! Хмм?
Dialogue: 0,0:19:58.99,0:20:03.58,Default,,0,0,0,,[TEL] (қоңырау үні) [TEL] Шима? ше?
Dialogue: 0,0:20:03.58,0:20:06.68,Default,,0,0,0,,(Шима) Әй... Окумура-кун. Ха...
Dialogue: 0,0:20:06.68,0:20:10.04,Default,,0,0,0,,Сіз мені ести аласыз ба? Жынның баласы.
Dialogue: 0,0:20:10.04,0:20:13.99,Default,,0,0,0,,[TEL] Сіз бетперде киген бейбақсыз ба? Шимаға және басқаларға не істейсің?
Dialogue: 0,0:20:13.99,0:20:16.79,Default,,0,0,0,,Мен сені өлтірмеймін, тым болмаса→
Dialogue: 0,0:20:16.79,0:20:20.63,Default,,0,0,0,,Сен осында келгенше. [TEL] Не!?
Dialogue: 0,0:20:20.63,0:20:24.00,Default,,0,0,0,,≪Бауырыңызға қоңырау шалуды жоспарлап отырсыз ба? Мұндай еліктеу...≫
Dialogue: 0,0:20:24.00,0:20:26.52,Default,,0,0,0,,Маңызды нәрсені жоғалтудың азабы→
Dialogue: 0,0:20:26.52,0:20:29.84,Default,,0,0,0,,Көбірек дәм алғыңыз келе ме? Немесе...
Dialogue: 0,0:20:29.84,0:20:31.84,Default,,0,0,0,,[TEL] Эй! Дыбыстық сигнал
Dialogue: 0,0:20:33.24,0:20:35.28,Default,,0,0,0,,(Шима) А... хмм? Башун!
Dialogue: 0,0:20:35.28,0:20:37.38,Default,,0,0,0,,Жарылыс! Bang! (Маска киген адам) А...
Dialogue: 0,0:20:37.38,0:20:39.67,Default,,0,0,0,,≪Мен жасадым! ≫
Dialogue: 0,0:20:39.67,0:20:41.85,Default,,0,0,0,,≪Анестезия оқтары жұмыс істемейді! ≫
Dialogue: 0,0:20:41.85,0:20:43.95,Default,,0,0,0,,Уф... аа!
Dialogue: 0,0:20:43.95,0:20:46.59,Default,,0,0,0,,Ол оның інісі ме?
Dialogue: 0,0:20:46.59,0:20:49.78,Default,,0,0,0,,Ұстаз! (Беткі киген адам) Мен саған айтуым керек еді →
Dialogue: 0,0:20:49.78,0:20:52.58,Default,,0,0,0,,Шайтанның ұлынан басқа біреу жақындаса →
Dialogue: 0,0:20:52.58,0:20:55.92,Default,,0,0,0,,Кепілге алынған адамды өлтіру. Не?
Dialogue: 0,0:20:55.92,0:20:59.99,Default,,0,0,0,,(Мива) Бо! (Беткиші) Бұл маған тым көп еліктегенің үшін жазаң.
Dialogue: 0,0:20:59.99,0:21:02.06,Default,,0,0,0,,Тоқта! Егер сіз мұны жасағыңыз келсе, менімен бірге жасаңыз!
Dialogue: 0,0:21:02.06,0:21:04.72,Default,,0,0,0,,Кепілге алынғандар қажет. →
Dialogue: 0,0:21:04.72,0:21:07.92,Default,,0,0,0,,Менің інім әлдеқайда қызық. →
Dialogue: 0,0:21:09.80,0:21:12.62,Default,,0,0,0,,Өл. (Кацуро/Мива) Уау!
Dialogue: 0,0:21:12.62,0:21:15.39,Default,,0,0,0,,Тоқта! Парин!
Dialogue: 0,0:21:15.39,0:21:18.74,Default,,0,0,0,,Жоқ~! (Беткі киген адам) Келдің бе? Жын құдайының ұлы. →
Dialogue: 0,0:21:18.74,0:21:22.11,Default,,0,0,0,,Қылышым болмаса, қолымнан ештеңе келмейтін сияқты.
Dialogue: 0,0:21:22.11,0:21:26.01,Default,,0,0,0,,Парин! Бұл нағыз мәміле! →
Dialogue: 0,0:21:27.56,0:21:29.66,Default,,0,0,0,,Бос қарсылықты тоқтатыңыз.
Dialogue: 0,0:21:31.10,0:21:34.82,Default,,0,0,0,,(Маска киген адам) Сіз жеңдім деп ойлайсыз ба? не?
Dialogue: 0,0:21:34.82,0:21:37.64,Default,,0,0,0,,Уф! (Жын шығарушылар) Уф...
Dialogue: 0,0:21:37.64,0:21:39.56,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:39.56,0:21:42.68,Default,,0,0,0,,Бауырым! Жүгіріп кету! Егер мен қылышты қолдана алмасам...
Dialogue: 0,0:21:42.68,0:21:45.98,Default,,0,0,0,,Тыныш! (Маска киген адам) А...
Dialogue: 0,0:21:45.98,0:21:49.20,Default,,0,0,0,,Ах... Жалын жіптері...
Dialogue: 0,0:21:49.20,0:21:51.32,Default,,0,0,0,,Жарайды. Жаса! фосфор!
Dialogue: 0,0:21:51.32,0:21:53.64,Default,,0,0,0,,Жоқ! Әлі де ағама →
Dialogue: 0,0:21:53.64,0:21:55.94,Default,,0,0,0,,Жалынды басқару мүмкін емес! Ха...
Dialogue: 0,0:21:57.48,0:22:00.28,Default,,0,0,0,,Мен мәңгілік тебіреніп жүре алмаймын →
Dialogue: 0,0:22:00.28,0:22:02.93,Default,,0,0,0,,Мүмкін емес! Бон!
Dialogue: 0,0:22:02.93,0:22:05.57,Default,,0,0,0,,(Маска киген адам) Уау... (Мива) Көк жалын...
Dialogue: 0,0:22:05.57,0:22:08.15,Default,,0,0,0,,Қашқын... Бауырым!
Dialogue: 0,0:22:08.15,0:22:11.65,Default,,0,0,0,,Бон!! Ах! А... маған көмектесіңіз...
Dialogue: 0,0:22:13.79,0:22:16.89,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:22:19.97,0:22:22.55,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:22:22.55,0:22:24.55,Default,,0,0,0,,Бұл менің жалыным.
Dialogue: 0,0:22:26.16,0:22:28.94,Default,,0,0,0,,Мен оны басқара алмаймын →
Dialogue: 0,0:22:28.94,0:22:30.94,Default,,0,0,0,,Эй, менің ойымша!!
Dialogue: 0,0:22:32.51,0:22:36.27,Default,,0,0,0,,Ух... а... Иә!
Dialogue: 0,0:22:36.27,0:22:39.67,Default,,0,0,0,,Қарғыс атсын! Алақай! Догон!
Dialogue: 0,0:22:43.74,0:22:45.74,Default,,0,0,0,,Доссатсу
Dialogue: 0,0:22:48.56,0:22:53.60,Default,,0,0,0,,Мен ағамды қорғауға тырыстым.
Dialogue: 0,0:22:53.60,0:22:56.10,Default,,0,0,0,,Хехе, 10 жыл өте тез өтті.
Dialogue: 0,0:22:58.02,0:23:00.02,Default,,0,0,0,,≪Мен сені қорғай аламын деп ойладым...≫
Dialogue: 0,0:23:05.14,0:23:07.14,Default,,0,0,0,,Әй, әйел?
Dialogue: 0,0:23:08.87,0:23:10.97,Default,,0,0,0,,Ах! ≫Тоқта!
Dialogue: 0,0:23:10.97,0:23:12.97,Default,,0,0,0,,Туыстарым! Нейгаус!
Dialogue: 0,0:23:14.39,0:23:17.39,Default,,0,0,0,,Қарғыс атсын! Жылан азулары! Таң
Dialogue: 0,0:23:17.39,0:23:21.08,Default,,0,0,0,,Уф... Қарғыс атсын! →
Dialogue: 0,0:23:21.08,0:23:23.51,Default,,0,0,0,,Жібер! Менің жолыма кедергі болма!
Dialogue: 0,0:23:23.51,0:23:25.70,Default,,0,0,0,,​​Бұл жолға түскен адам, солай ма? →
Dialogue: 0,0:23:25.70,0:23:29.14,Default,,0,0,0,,Сіз бұл жынды басқарып, Ринді нысанаға алғыңыз келді...
Dialogue: 0,0:23:29.14,0:23:33.54,Default,,0,0,0,,Ол... ол менің әйелім.
Dialogue: 0,0:23:33.54,0:23:35.94,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:23:37.74,0:23:40.38,Default,,0,0,0,,Сіз жағдайды түсіндіре аласыз ба?
Dialogue: 0,0:23:40.38,0:23:45.54,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:45.54,0:23:48.96,Default,,0,0,0,,(Изуми) Нецучичичи! Уау, бұл асыра сілтеу.
Dialogue: 0,0:23:48.96,0:23:51.96,Default,,0,0,0,,(Изуми) Күн ыстық! Сіз мұны әдейі жасадыңыз!?
Dialogue: 0,0:23:51.96,0:23:56.50,Default,,0,0,0,,(медициналық инженер Найт) Оның әлсіздігі болса да, ауруханаға жатқызудың қажеті жоқ. →
Dialogue: 0,0:23:56.50,0:23:58.53,Default,,0,0,0,,Біраз демалыңыз.
Dialogue: 0,0:23:58.53,0:24:01.43,Default,,0,0,0,,(Киодо) Солай болса да, бұл пайдалы болды. Рақмет сізге.
Dialogue: 0,0:24:01.43,0:24:05.25,Default,,0,0,0,,(Нагатомо) Мен Фуджимото-сенсейге сіздің өсуіңізді көрсеткім келді.
Dialogue: 0,0:24:05.25,0:24:07.47,Default,,0,0,0,,Хехе.
Dialogue: 0,0:24:07.47,0:24:11.07,Default,,0,0,0,,(Марута) Айтпақшы, Юкио-кун ше? О? иә?
Dialogue: 0,0:24:16.60,0:24:22.17,Default,,0,0,0,,≪Заза зазазазаза
Dialogue: 0,0:24:22.17,0:24:26.69,Default,,0,0,0,,Иә? Юкио Окумура, солай ма?
Dialogue: 0,0:24:26.69,0:24:28.76,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:24:28.76,0:24:31.43,Default,,0,0,0,,Бізбен байланысқыңыз келсе, бізге хабарласыңыз.
Dialogue: 0,0:24:31.43,0:24:33.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:33.50,0:25:03.94,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:08.12,0:26:02.51,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:13.60,0:26:16.20,Default,,0,0,0,,Concon ≪Insertion.
Dialogue: 0,0:26:19.46,0:26:21.52,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:26:21.52,0:26:24.42,Default,,0,0,0,,Менің атым Эрнст Фредерик Эгин.
Dialogue: 0,0:26:25.85,0:26:29.95,Default,,0,0,0,,Қош келдің, немерем. Ха!
Dialogue: 0,0:28:03.79,0:28:07.10,Default,,0,0,0,,Бұл менің әйелім. Мен сені қорғауға келдім...
Dialogue: 0,0:28:07.10,0:28:10.10,Default,,0,0,0,,Жоқ! Мен сенен олай істе деп сұраған жоқпын!
Dialogue: 0,0:28:10.10,0:28:12.20,Default,,0,0,0,,Бұл ауқымды ма!? Жын құдайдың ұлы!
Dialogue: 0,0:28:12.20,0:28:14.00,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:30:42.82,0:30:45.30,Default,,0,0,0,,Ең алдымен ертең жаңа өкіл сайланады.
Dialogue: 0,0:30:45.30,0:30:47.24,Default,,0,0,0,,Демократиялық партияның өкілдік сайлауы.
Dialogue: 0,0:30:49.29,0:30:52.24,Default,,0,0,0,,Бес кандидат түстен кейін партияның қолдауымен өткен қоғамдық пікірталасқа қатысты.
Dialogue: 0,0:30:52.24,0:30:54.28,Default,,0,0,0,,Пікірталас басталды.
Dialogue: 0,0:30:58.22,0:31:00.50,Default,,0,0,0,,Пікірсайыс бес үміткерден басталды
Dialogue: 0,0:31:02.00,0:31:07.00,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
