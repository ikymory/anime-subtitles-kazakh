Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.04,0:00:35.06,Default,,0,0,0,,Хахахаха.
Dialogue: 0,0:00:35.06,0:00:37.86,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:37.86,0:00:39.90,Default,,0,0,0,,Гяхахахаха! →
Dialogue: 0,0:00:39.90,0:00:44.55,Default,,0,0,0,,Жын құдайының келуін тойлауға арналған мереке басталды! →
Dialogue: 0,0:00:44.55,0:00:47.67,Default,,0,0,0,,Гаааааахахахах!
Dialogue: 0,0:00:47.67,0:00:49.71,Default,,0,0,0,,(Рин Окумура) Ух... фосфор!
Dialogue: 0,0:00:49.71,0:00:51.75,Default,,0,0,0,,(Кацуро) Жақсысың ба? Уф...
Dialogue: 0,0:00:51.75,0:00:55.72,Default,,0,0,0,,Гяхахаха! Гяхахаха!
Dialogue: 0,0:00:55.72,0:00:59.19,Default,,0,0,0,,Юкио... Аа... Юкио ма?
Dialogue: 0,0:00:59.19,0:01:02.91,Default,,0,0,0,,Гяааахахахах. Қарғыс атсын!
Dialogue: 0,0:01:02.91,0:01:05.31,Default,,0,0,0,,Не істеп жатырсың!? Юкио!!
Dialogue: 0,0:01:06.81,0:01:10.65,Default,,0,0,0,,Ағасын ойлап, соған арнаған інімен →
Dialogue: 0,0:01:10.65,0:01:14.02,Default,,0,0,0,,Менің ағам өз сезімдерінен мүлдем бейхабар. →
Dialogue: 0,0:01:14.02,0:01:18.94,Default,,0,0,0,,Хехехе, біз соңғы трагедияға куә болатын сияқтымыз.
Dialogue: 0,0:01:18.94,0:01:58.90,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:02.23,0:02:47.64,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:01.76,0:03:04.49,Default,,0,0,0,,Қарғыс атсын, мен оны қия алмаймын!
Dialogue: 0,0:03:04.49,0:03:06.68,Default,,0,0,0,,Туыстарым! Қайда бара жатырсың?
Dialogue: 0,0:03:06.68,0:03:09.68,Default,,0,0,0,,Менің ойымша, бұл шешілді. Ол Риннің орнында.
Dialogue: 0,0:03:09.68,0:03:11.90,Default,,0,0,0,,«Осы жерден ешкімнің өтуіне жол берме» →
Dialogue: 0,0:03:11.90,0:03:14.30,Default,,0,0,0,,Міне, маған бұйырылған нәрсе.
Dialogue: 0,0:03:14.30,0:03:17.91,Default,,0,0,0,,Осыны айтып тұрсың! Мына күйге қара!
Dialogue: 0,0:03:17.91,0:03:20.91,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:20.91,0:03:23.06,Default,,0,0,0,,((Күтіңіз! Мәртебелі!→
Dialogue: 0,0:03:23.06,0:03:26.67,Default,,0,0,0,,Бұл рас па? Бос әлемнің өзін жою! ))
Dialogue: 0,0:03:26.67,0:03:30.05,Default,,0,0,0,,((Мәсіхтің өзі дайындалып қойған.→
Dialogue: 0,0:03:30.05,0:03:32.87,Default,,0,0,0,,Бос дүниенің қақпасын ашу ғана қалды))
Dialogue: 0,0:03:32.87,0:03:36.06,Default,,0,0,0,,((Алайда, түпкі қарумен жаппай өлтіру және т.б. →
Dialogue: 0,0:03:36.06,0:03:38.06,Default,,0,0,0,,Рыцарлар тобының рухына қарсы күресемін))
Dialogue: 0,0:03:39.71,0:03:42.50,Default,,0,0,0,,((Жарайды)) ((А...))
Dialogue: 0,0:03:42.50,0:03:46.07,Default,,0,0,0,,((Бұл операцияны Юкио Окумура басқарады.→
Dialogue: 0,0:03:46.07,0:03:48.37,Default,,0,0,0,,Сіз менің күзетшім ретінде де әрекет ете аласыз))
Dialogue: 0,0:03:50.87,0:03:52.87,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:03:54.74,0:03:58.42,Default,,0,0,0,,Шынында да, Ватикан дұрыс емес бағыт алған болуы мүмкін.
Dialogue: 0,0:03:58.42,0:04:01.38,Default,,0,0,0,,Бірақ мен Ватиканның рыцарімін.
Dialogue: 0,0:04:01.38,0:04:03.52,Default,,0,0,0,,Дүние жойылатын болса да→
Dialogue: 0,0:04:03.52,0:04:06.22,Default,,0,0,0,,Менің жаным Қасиетті Крест Рыцарларымен бірге. →
Dialogue: 0,0:04:06.22,0:04:08.93,Default,,0,0,0,,Кел Шура Артур О. Ангел→
Dialogue: 0,0:04:08.93,0:04:11.03,Default,,0,0,0,,Мүмкіндігінше көп серіктестікке ие болатын сияқтысыз.
Dialogue: 0,0:04:13.41,0:04:17.18,Default,,0,0,0,,Уф... Сен қатты қиналыпсың.
Dialogue: 0,0:04:17.18,0:04:19.24,Default,,0,0,0,,Сіз қашып кетесіз бе? Шура!
Dialogue: 0,0:04:19.24,0:04:22.52,Default,,0,0,0,,Қайсысы қашып жүр? Кесемін десеңіз, кесіңіз!
Dialogue: 0,0:04:22.52,0:04:24.81,Default,,0,0,0,,Мен енді саған ілесе алмаймын! Ха...
Dialogue: 0,0:04:24.81,0:04:35.37,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:35.37,0:04:37.59,Default,,0,0,0,,Сіз не істеп жатырсыз? Юкио...
Dialogue: 0,0:04:37.59,0:04:40.04,Default,,0,0,0,,Неліктен сенде көк жалын бар...?
Dialogue: 0,0:04:40.04,0:04:43.23,Default,,0,0,0,,Жын құдайдың құдіретін мұра еткен жалғыз мен емес едім!
Dialogue: 0,0:04:43.23,0:04:46.03,Default,,0,0,0,,Шулы! Уф... Ах!
Dialogue: 0,0:04:48.31,0:04:50.78,Default,,0,0,0,,Сен жынсың ба? (4 адам) Иә?
Dialogue: 0,0:04:50.78,0:04:53.42,Default,,0,0,0,,(Джин) тым кеш. Адамдардың байқамауы қиын →
Dialogue: 0,0:04:53.42,0:04:56.01,Default,,0,0,0,,Әке, мен өзімді жалғыз сезіндім. →
Dialogue: 0,0:04:56.01,0:04:58.11,Default,,0,0,0,,Gyahahahahahahahaha.
Dialogue: 0,0:04:58.11,0:05:00.38,Default,,0,0,0,,Бұл шайтан...
Dialogue: 0,0:05:00.38,0:05:04.16,Default,,0,0,0,,Неліктен... неге жын Юкиоға ие?
Dialogue: 0,0:05:04.16,0:05:07.70,Default,,0,0,0,,(Джин) Себебі оны бірінші осы жігіт аяқтаған →
Dialogue: 0,0:05:07.70,0:05:10.64,Default,,0,0,0,,Менің ыдысым ретінде. Не...
Dialogue: 0,0:05:10.64,0:05:13.41,Default,,0,0,0,,(Джин) Сіздің денелеріңіз менің қанымды мұра етті →
Dialogue: 0,0:05:13.41,0:05:16.83,Default,,0,0,0,,Бұл мен үшін өте қолайлы. Сонымен →
Dialogue: 0,0:05:16.83,0:05:20.26,Default,,0,0,0,,Мен сендердің есейгеніңді күттім.
Dialogue: 0,0:05:20.26,0:05:23.46,Default,,0,0,0,,Юкионың денесінен шығыңыз!
Dialogue: 0,0:05:24.85,0:05:26.99,Default,,0,0,0,,Аһ! фосфор!
Dialogue: 0,0:05:26.99,0:05:29.96,Default,,0,0,0,,(Ни-чан) Нии Нии! Уф...
Dialogue: 0,0:05:29.96,0:05:33.26,Default,,0,0,0,,Гррр. Фосфор Жақсысың ба?
Dialogue: 0,0:05:34.54,0:05:37.96,Default,,0,0,0,,(Джин) Адамдардың айтқанын соңына дейін тыңда. →
Dialogue: 0,0:05:37.96,0:05:41.80,Default,,0,0,0,,Соңғы 15 жыл бойы мен → армандадым
Dialogue: 0,0:05:41.80,0:05:43.90,Default,,0,0,0,,Материалдық әлем мен бос дүниені біртұтас етіңіз →
Dialogue: 0,0:05:43.90,0:05:46.91,Default,,0,0,0,,Жаңа әлем құруды армандаңыз.
Dialogue: 0,0:05:46.91,0:05:49.43,Default,,0,0,0,,Жаңа әлем?
Dialogue: 0,0:05:49.43,0:05:53.51,Default,,0,0,0,,(Джин) Мен материалдық әлемде еркін қозғалуға мүмкіндік беретін ыдысты да алдым. →
Dialogue: 0,0:05:53.51,0:05:57.87,Default,,0,0,0,,Тіпті бос жердің үлкен қақпалары сіздің өтінішіңізге ашылады. →
Dialogue: 0,0:05:57.87,0:06:02.01,Default,,0,0,0,,Бұл менің арманымды жүзеге асырудың тамаша мүмкіндігі. →
Dialogue: 0,0:06:02.01,0:06:07.39,Default,,0,0,0,,Бұл қақпаны тағы да бұзсаң, мен шыдамас едім. →
Dialogue: 0,0:06:07.39,0:06:09.59,Default,,0,0,0,,Кешіріңіз, бірақ мен сізді өлуге рұқсат етемін.
Dialogue: 0,0:06:11.46,0:06:13.82,Default,,0,0,0,,басыңыз… ≫ (Сугуро) Күте тұрыңыз! →
Dialogue: 0,0:06:13.82,0:06:16.87,Default,,0,0,0,,Оны жеңгенше, неге менімен соғыспайсың!
Dialogue: 0,0:06:16.87,0:06:19.87,Default,,0,0,0,,(Шима) Күте тұрыңыз… Бала…. (Миуа) Екінші адам жын ғой, солай ма? →
Dialogue: 0,0:06:19.87,0:06:23.06,Default,,0,0,0,,Бұлай болуы мүмкін емес! (Кацуро) Тырысып көрсең де түсінбейсің!
Dialogue: 0,0:06:23.06,0:06:25.45,Default,,0,0,0,,Бұл бейберекет және шулы!
Dialogue: 0,0:06:25.45,0:06:28.55,Default,,0,0,0,,(Цубаки) Жоқ! Апыр-ай! Цубаки мырза!
Dialogue: 0,0:06:28.55,0:06:30.95,Default,,0,0,0,,Жабайы күрішті тасып, тазарту →
Dialogue: 0,0:06:30.95,0:06:32.99,Default,,0,0,0,,Жапон күрішін ұстаңыз және жем →
Dialogue: 0,0:06:32.99,0:06:35.09,Default,,0,0,0,,Жаратушы Құдай Саке Хахимори→
Dialogue: 0,0:06:35.09,0:06:38.39,Default,,0,0,0,,Сегіз жалпақ қолдың дыбысы
Dialogue: 0,0:06:38.39,0:06:41.74,Default,,0,0,0,,Тәңірім, аспанның ұлы илаһи разылығын тыңдама!
Dialogue: 0,0:06:41.74,0:06:44.23,Default,,0,0,0,,Башан (Цубаки) Ух...
Dialogue: 0,0:06:44.23,0:06:46.30,Default,,0,0,0,,Жақсысың ба? мұғалім.
Dialogue: 0,0:06:46.30,0:06:49.17,Default,,0,0,0,,Күрсін... Тек қаш. →
Dialogue: 0,0:06:49.17,0:06:52.12,Default,,0,0,0,,Бұл сіз жеңе алатын қарсылас емес.
Dialogue: 0,0:06:52.12,0:06:54.21,Default,,0,0,0,,(Шима) Котенка! (Мива) Иә!
Dialogue: 0,0:06:54.21,0:06:57.21,Default,,0,0,0,,(2 адам) Басара Джини Хара Ненхатана Совака туралы. →
Dialogue: 0,0:06:57.21,0:07:00.13,Default,,0,0,0,,Өзін-өзі қорғау мөрі!
Dialogue: 0,0:07:00.13,0:07:03.03,Default,,0,0,0,,(Миуа) Біз сені қолдаймыз! (Шима) Бұл арада қаш!
Dialogue: 0,0:07:03.03,0:07:06.20,Default,,0,0,0,,(Сугуро) Шучири Кяроха Ункен Совака туралы!
Dialogue: 0,0:07:06.20,0:07:08.24,Default,,0,0,0,,Бала!
Dialogue: 0,0:07:08.24,0:07:10.64,Default,,0,0,0,,(Жүрегімдегі дауыс) ≪Жынды жеңу менің амбициям еді.≫
Dialogue: 0,0:07:10.64,0:07:12.91,Default,,0,0,0,,≪Мұны мұнда жасамаңыз! ≫
Dialogue: 0,0:07:12.91,0:07:15.19,Default,,0,0,0,,Бар, Киреек!
Dialogue: 0,0:07:15.19,0:07:17.23,Default,,0,0,0,,Канг! Ах!
Dialogue: 0,0:07:17.23,0:07:20.12,Default,,0,0,0,,Мені жаламаңдар, бауырлар!!
Dialogue: 0,0:07:20.12,0:07:22.15,Default,,0,0,0,,Bilibili! (Шима/Мива) Уау!
Dialogue: 0,0:07:22.15,0:07:24.55,Default,,0,0,0,,(Камики) Кя~! Барлығына!
Dialogue: 0,0:07:24.55,0:07:27.26,Default,,0,0,0,,(Кацуро) Ах... (Джин) Хаааа →
Dialogue: 0,0:07:27.26,0:07:29.29,Default,,0,0,0,,Олар көздің жауын алады.
Dialogue: 0,0:07:29.29,0:07:32.11,Default,,0,0,0,,Садақ (Джин) Мен олардың бәрін күлге айналдырамын.
Dialogue: 0,0:07:32.11,0:07:34.11,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:36.02,0:07:38.82,Default,,0,0,0,,​​Таң! а?
Dialogue: 0,0:07:38.82,0:07:42.02,Default,,0,0,0,,Сол себепті айттым. ≫Шура!
Dialogue: 0,0:07:42.02,0:07:45.51,Default,,0,0,0,,"Мистер" ақымақ. Морияма!
Dialogue: 0,0:07:45.51,0:07:48.49,Default,,0,0,0,,Иә! Мұны маған қалдырыңыз →
Dialogue: 0,0:07:48.49,0:07:51.05,Default,,0,0,0,,Зардап шеккендерді ең қауіпсіз жерге жеткізіңіз!
Dialogue: 0,0:07:51.05,0:07:55.13,Default,,0,0,0,,Иә. Не Чан. Nii Nii Nii →
Dialogue: 0,0:07:55.13,0:07:57.63,Default,,0,0,0,,Nii Nii
Dialogue: 0,0:07:59.79,0:08:01.82,Default,,0,0,0,,Сонда не? →
Dialogue: 0,0:08:01.82,0:08:04.09,Default,,0,0,0,,Бұл кішкентай қыз Митараши Дангоға ұқсайды.
Dialogue: 0,0:08:04.09,0:08:06.38,Default,,0,0,0,,Қанша жын түссе де →
Dialogue: 0,0:08:06.38,0:08:08.72,Default,,0,0,0,,Мінезіңіз тым өзгерді, мен қорқамын.
Dialogue: 0,0:08:08.72,0:08:12.02,Default,,0,0,0,,Бұл Юкио емес, оған жын кіріп кеткен!
Dialogue: 0,0:08:12.02,0:08:14.24,Default,,0,0,0,,Не!? Боун Боун
Dialogue: 0,0:08:14.24,0:08:16.39,Default,,0,0,0,,Қарғыс атсын! Алақай!
Dialogue: 0,0:08:16.39,0:08:20.78,Default,,0,0,0,,Мен мұны істей алмаймын, себебі (жын) менің алдымда пайда болады. →
Dialogue: 0,0:08:20.78,0:08:22.88,Default,,0,0,0,,Күлге айналдыр! Ұсқынсыз
Dialogue: 0,0:08:24.63,0:08:26.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:26.73,0:08:34.24,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:34.24,0:08:36.28,Default,,0,0,0,,Ой, Құдай-ай! Енді кеш болып барады.
Dialogue: 0,0:08:36.28,0:08:41.86,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:41.86,0:08:44.62,Default,,0,0,0,,Бұл ауырады ма? не?
Dialogue: 0,0:08:44.62,0:08:47.20,Default,,0,0,0,,Бос әлем мен материалдық әлемді біріктіру туралы не деуге болады?
Dialogue: 0,0:08:47.20,0:08:50.14,Default,,0,0,0,,Ах. ≪Таң!
Dialogue: 0,0:08:50.14,0:08:52.64,Default,,0,0,0,,Do-do-do-do... Бум! Бум!
Dialogue: 0,0:08:54.28,0:08:56.76,Default,,0,0,0,,Бұл жерде де қауіпті. Тез қашуымыз керек.
Dialogue: 0,0:08:56.76,0:08:59.07,Default,,0,0,0,,Жоқ, асығудың қажеті жоқ→
Dialogue: 0,0:08:59.07,0:09:01.93,Default,,0,0,0,,Джин қақпаның алдынан қозғалмайтын шығар.
Dialogue: 0,0:09:01.93,0:09:04.15,Default,,0,0,0,,Мұны қалай айта аласыз?
Dialogue: 0,0:09:04.15,0:09:07.64,Default,,0,0,0,,Бұл қақпа оның жоспары үшін өте маңызды. →
Dialogue: 0,0:09:07.64,0:09:10.64,Default,,0,0,0,,Әсіресе Рин, сен Широға көмектесуге тырыстың→
Dialogue: 0,0:09:10.64,0:09:13.34,Default,,0,0,0,,Мен бір кездері Бос әлемнің қақпасын қираттым.
Dialogue: 0,0:09:15.62,0:09:18.57,Default,,0,0,0,,Ол бұған сақтықпен қарайды.
Dialogue: 0,0:09:18.57,0:09:22.64,Default,,0,0,0,,Хаха, бұл банканы тепкен сияқты.
Dialogue: 0,0:09:22.64,0:09:25.09,Default,,0,0,0,,Банканы тепкіңіз бе? (Шима) Сен не істедің? →
Dialogue: 0,0:09:25.09,0:09:28.03,Default,,0,0,0,,Жын өзін тепкен адамды тапқысы келеді →
Dialogue: 0,0:09:28.03,0:09:31.70,Default,,0,0,0,,Егер сізді тепсе, ұтыласыз, сондықтан банканы тастап кете алмайсыз.
Dialogue: 0,0:09:31.70,0:09:35.35,Default,,0,0,0,,Шима айтқандай, бұл шайқаста кім шабуылдаса, сол артықшылыққа ие.
Dialogue: 0,0:09:35.35,0:09:39.01,Default,,0,0,0,,Егер олар бірден шабуылдаса, тіпті жындар да өздерін қорғай алмайды.
Dialogue: 0,0:09:39.01,0:09:41.36,Default,,0,0,0,,Күте тұрыңыз, Юкио ше?
Dialogue: 0,0:09:41.36,0:09:43.84,Default,,0,0,0,,Шайтанға қарсы бәріміз біріксек те→
Dialogue: 0,0:09:43.84,0:09:46.60,Default,,0,0,0,,Бұл мен жеңе алатын қарсылас емес. Одан гөрі қазір→
Dialogue: 0,0:09:46.60,0:09:50.47,Default,,0,0,0,,Бостың қақпасын бұзып, шайтан басқыншылығын тоқтатқан абзал.
Dialogue: 0,0:09:50.47,0:09:54.29,Default,,0,0,0,,Сіз маған Юкиодан бас тартуымды айтып тұрсыз ба? Мен де көмектескім келеді.
Dialogue: 0,0:09:54.29,0:09:57.94,Default,,0,0,0,,Алайда жын кірген адамды құтқарудың жолы жоқ →
Dialogue: 0,0:09:57.94,0:10:01.01,Default,,0,0,0,,Ол еш жерде жоқ. Бұл дұрыс емес!
Dialogue: 0,0:10:01.01,0:10:05.38,Default,,0,0,0,,Дәл осы кезде қарт есін жиды.
Dialogue: 0,0:10:05.38,0:10:09.40,Default,,0,0,0,,Юкионың жүрегі әлі де Юкионың ішінде болатынына сенімдімін.
Dialogue: 0,0:10:09.40,0:10:13.49,Default,,0,0,0,,Егер сен оны шақырсаң, ол есін жисын. фосфор….
Dialogue: 0,0:10:13.49,0:10:15.83,Default,,0,0,0,,Мен оған сенемін.
Dialogue: 0,0:10:15.83,0:10:17.93,Default,,0,0,0,,Хмм….
Dialogue: 0,0:10:17.93,0:10:20.98,Default,,0,0,0,,Эй... күте тұр, Рин!
Dialogue: 0,0:10:20.98,0:10:23.85,Default,,0,0,0,,(Сугуро) Ол тағы да жалғыз баруымды өтінді... →
Dialogue: 0,0:10:23.85,0:10:26.12,Default,,0,0,0,,Уф! Бұл әлі де жақсы емес.
Dialogue: 0,0:10:26.12,0:10:28.69,Default,,0,0,0,,Бұл соншалықты үлкен мәміле емес. →
Dialogue: 0,0:10:28.69,0:10:31.79,Default,,0,0,0,,Мен жынды жеңемін. Ол жерден кет.
Dialogue: 0,0:10:31.79,0:10:33.96,Default,,0,0,0,,​​Енді не істей аласыз?
Dialogue: 0,0:10:33.96,0:10:37.91,Default,,0,0,0,,Не... Камики, айтыңызшы!
Dialogue: 0,0:10:37.91,0:10:41.83,Default,,0,0,0,,(Камики) Жоқ, біз барсақ та жалғыз сен емессің →
Dialogue: 0,0:10:41.83,0:10:45.56,Default,,0,0,0,,Сайып келгенде, бұл жай ғана сүйрету емес. (Кацуро) А...
Dialogue: 0,0:10:45.56,0:10:49.53,Default,,0,0,0,,Мен бармаймын. Себебі Пак уайымдап жүр.
Dialogue: 0,0:10:49.53,0:10:51.86,Default,,0,0,0,,Аа….
Dialogue: 0,0:10:51.86,0:10:56.18,Default,,0,0,0,,(Цубаки) Камики-кун дұрыс айтады. (Кацуро) Сенсей.
Dialogue: 0,0:10:56.18,0:10:59.30,Default,,0,0,0,,(Tsubaki) There are people who need your help→
Dialogue: 0,0:10:59.30,0:11:02.80,Default,,0,0,0,,Бұл қалада көптеген адамдар бар. Хмм….
Dialogue: 0,0:11:04.46,0:11:07.46,Default,,0,0,0,,Күте тұрыңыз! Сіз маған күте тұрыңыз деп жатырсыз!
Dialogue: 0,0:11:07.46,0:11:10.96,Default,,0,0,0,,Жібер! Мен снеговикпін... Сіз көмектескіңіз келеді, солай ма?
Dialogue: 0,0:11:10.96,0:11:14.06,Default,,0,0,0,,Мен сіздің жоспарыңызға қосыламын. Шынымен бе?
Dialogue: 0,0:11:15.38,0:11:19.22,Default,,0,0,0,,The persuader calls out to Yukio from the west entrance. →
Dialogue: 0,0:11:19.22,0:11:22.88,Default,,0,0,0,,Шабуылшы шығыс қабырғаға көтеріліп, күтеді. →
Dialogue: 0,0:11:22.88,0:11:25.61,Default,,0,0,0,,When the persuader lures Yukio from the plaza→
Dialogue: 0,0:11:25.61,0:11:27.61,Default,,0,0,0,,Барлығын бірден орнатыңыз. →
Dialogue: 0,0:11:29.48,0:11:31.48,Default,,0,0,0,,Қамтылған адам - шабуылдаушы.
Dialogue: 0,0:11:33.70,0:11:35.70,Default,,0,0,0,,Бұл шешілді.
Dialogue: 0,0:11:37.11,0:11:40.46,Default,,0,0,0,,Hmm... If you have to convince me, I'll do it too...
Dialogue: 0,0:11:40.46,0:11:42.63,Default,,0,0,0,,Юкио сізге бұл туралы айтты, солай ма?
Dialogue: 0,0:11:42.63,0:11:45.93,Default,,0,0,0,,Жын шығарушы жалғыз күресе алмайды. Ах...
Dialogue: 0,0:11:45.93,0:11:48.99,Default,,0,0,0,,Trust and cooperation with colleagues is the first priority.
Dialogue: 0,0:11:48.99,0:11:52.67,Default,,0,0,0,,Ендеше, не болса да, жұмысыңды бітір.
Dialogue: 0,0:11:52.67,0:11:54.72,Default,,0,0,0,,Жарайды ма? Иә.
Dialogue: 0,0:11:54.72,0:11:58.52,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:07.62,0:14:09.66,Default,,0,0,0,,≪Уау! ≫Уау!
Dialogue: 0,0:14:09.66,0:14:18.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:18.35,0:14:22.20,Default,,0,0,0,,((Жаңа әлем...))
Dialogue: 0,0:14:22.20,0:14:24.36,Default,,0,0,0,,((Yes, there is no void world or material world →
Dialogue: 0,0:14:24.36,0:14:26.76,Default,,0,0,0,,A world where humans and demons can live together))
Dialogue: 0,0:14:26.76,0:14:29.88,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:29.88,0:14:33.00,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:14:33.00,0:14:36.60,Default,,0,0,0,,((But I'm sure I'll be able to create it someday. Even with you→
Dialogue: 0,0:14:36.60,0:14:39.30,Default,,0,0,0,,This is how we were able to understand each other. →
Dialogue: 0,0:14:40.67,0:14:45.11,Default,,0,0,0,,Эй, көзіңді жұмып, елестет. →
Dialogue: 0,0:14:45.11,0:14:47.16,Default,,0,0,0,,Мен бұл оңай екеніне сенімдімін))
Dialogue: 0,0:14:47.16,0:14:52.27,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:52.27,0:14:54.42,Default,,0,0,0,,Юрий дерлік →
Dialogue: 0,0:14:54.42,0:14:59.41,Default,,0,0,0,,The world we dreamed of will soon be created.
Dialogue: 0,0:14:59.41,0:15:01.63,Default,,0,0,0,,Ол меннен қанша есе мықты. (Очако) Ах…
Dialogue: 0,0:15:01.63,0:15:04.33,Default,,0,0,0,,(Джин) Бұл не? Бұрынғы Ни Чан емес пе? →
Dialogue: 0,0:15:04.33,0:15:06.37,Default,,0,0,0,,Жалғыз ба? Бұл дірілдеген көзілдірік өте шулы!
Dialogue: 0,0:15:06.37,0:15:08.77,Default,,0,0,0,,Мылтық! мылтық! (Джин) О?
Dialogue: 0,0:15:08.77,0:15:12.20,Default,,0,0,0,,Сіз сондасыз ба? Мен қашанға дейін жын құдайдың бақылауында боламын? →
Dialogue: 0,0:15:12.20,0:15:15.42,Default,,0,0,0,,Тез оян! Гяхахаха. →
Dialogue: 0,0:15:15.42,0:15:19.36,Default,,0,0,0,,Бұл жігіт жай ғана ыдыс. No matter how much I call out to you, it's no use.
Dialogue: 0,0:15:19.36,0:15:23.43,Default,,0,0,0,,Жоқ, мен сені оятамын, менің ыстықтығым →
Dialogue: 0,0:15:23.43,0:15:25.57,Default,,0,0,0,,Ояныңыз!
Dialogue: 0,0:15:25.57,0:15:27.90,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:15:27.90,0:15:31.09,Default,,0,0,0,,(Саябақ) Жарайды, енді жылама. (Қыз студент) Не? Бұл. →
Dialogue: 0,0:15:31.09,0:15:34.09,Default,,0,0,0,,Неліктен құбыжықтар көп?
Dialogue: 0,0:15:34.09,0:15:36.73,Default,,0,0,0,,Біз үшін бітті→
Dialogue: 0,0:15:36.73,0:15:38.83,Default,,0,0,0,,Бізді құбыжықтар жейтін болады.
Dialogue: 0,0:15:38.83,0:15:42.79,Default,,0,0,0,,(Саябақ) Бұл дұрыс емес. Мені бәрі қорғайтынына сенімдімін.
Dialogue: 0,0:15:42.79,0:15:46.09,Default,,0,0,0,,Парин! Пэйлин! (Барлығы) Кяах!
Dialogue: 0,0:15:46.09,0:15:48.09,Default,,0,0,0,,Ууууууууу….
Dialogue: 0,0:15:50.41,0:15:52.98,Default,,0,0,0,,(Сугуро) Ноукусанманда Басара Дункан!
Dialogue: 0,0:15:52.98,0:15:55.08,Default,,0,0,0,,Пішан!
Dialogue: 0,0:15:55.08,0:15:57.08,Default,,0,0,0,,(Камики) Мына жерде! иә?
Dialogue: 0,0:15:58.57,0:16:00.57,Default,,0,0,0,,​​Ей, мына жаққа кел! →
Dialogue: 0,0:16:02.17,0:16:04.21,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:16:04.21,0:16:06.73,Default,,0,0,0,,(Камики) саябағы! (Саябақ) Изумо-чан!
Dialogue: 0,0:16:06.73,0:16:09.66,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз. Әрине Изумо-чан →
Dialogue: 0,0:16:09.66,0:16:13.27,Default,,0,0,0,,Маған көмектесетіндеріңізге сендім. (Оқушы қыз) Бұл қайда?
Dialogue: 0,0:16:13.27,0:16:15.85,Default,,0,0,0,,Бұл Сейджуцу рыцарлары труппасының Жапониядағы бөлімшесі. →
Dialogue: 0,0:16:15.85,0:16:19.21,Default,,0,0,0,,Ватиканның бас кеңсесі бұл жерді эвакуациялау орны ретінде ашуды сұрады.
Dialogue: 0,0:16:19.21,0:16:23.91,Default,,0,0,0,,Бұйрық берілді. Мұнда сіз жындардың шабуылын болдырмай аласыз.
Dialogue: 0,0:16:26.35,0:16:28.40,Default,,0,0,0,,Не болды? Бала.
Dialogue: 0,0:16:28.40,0:16:30.43,Default,,0,0,0,,Морияма мырза, сіз оны көрдіңіз бе?
Dialogue: 0,0:16:30.43,0:16:33.32,Default,,0,0,0,,(Шима) Егер солай болса... қашан жақсы болады?
Dialogue: 0,0:16:33.32,0:16:35.59,Default,,0,0,0,,Мен адасып қалдым деп ойлаймын.
Dialogue: 0,0:16:35.59,0:16:38.89,Default,,0,0,0,,(Сугуро) Ұялы телефоныңыз ше? (Шима) Морияма мырза, оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:16:38.89,0:16:41.41,Default,,0,0,0,,Менде жағымсыз сезім бар.
Dialogue: 0,0:16:41.41,0:16:43.58,Default,,0,0,0,,Ал... күрсін...
Dialogue: 0,0:16:43.58,0:16:46.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:46.70,0:16:48.70,Default,,0,0,0,,Ооооооо...
Dialogue: 0,0:16:50.12,0:16:53.56,Default,,0,0,0,,≪Бұн! Бон!
Dialogue: 0,0:16:53.56,0:16:57.19,Default,,0,0,0,,Шура…. Бон! Бон! Бон!
Dialogue: 0,0:16:57.19,0:17:00.38,Default,,0,0,0,,Анау әйел, әкеңе жақсылық жасама.
Dialogue: 0,0:17:00.38,0:17:03.02,Default,,0,0,0,,Бірақ түптеп келгенде, олар нағыз адамдар.
Dialogue: 0,0:17:03.02,0:17:05.58,Default,,0,0,0,,Қаншалықты төзе алатынымыздың шегі бар.
Dialogue: 0,0:17:05.58,0:17:08.47,Default,,0,0,0,,Бля! Бон!!
Dialogue: 0,0:17:08.47,0:17:13.21,Default,,0,0,0,,Боун Боун Ку! Ах! Уф...
Dialogue: 0,0:17:13.21,0:17:15.36,Default,,0,0,0,,Қарғыс атсын! (Джин) Не болды? →
Dialogue: 0,0:17:15.36,0:17:17.73,Default,,0,0,0,,Бәрі бітті ме?
Dialogue: 0,0:17:17.73,0:17:20.53,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааааааа!
Dialogue: 0,0:17:22.05,0:17:24.45,Default,,0,0,0,,Бон! Алақай! Қарғыс атсын! →
Dialogue: 0,0:17:26.26,0:17:29.04,Default,,0,0,0,,Хахаха…. Чокомакато.
Dialogue: 0,0:17:29.04,0:17:35.92,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:35.92,0:17:38.55,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:17:38.55,0:17:40.72,Default,,0,0,0,,Не деген.
Dialogue: 0,0:17:40.72,0:17:43.12,Default,,0,0,0,,Манзара Сен ақымақсың ба? →
Dialogue: 0,0:17:43.12,0:17:46.32,Default,,0,0,0,,Бірақ мен сенімен бірге жүруім керек →
Dialogue: 0,0:17:47.74,0:17:49.90,Default,,0,0,0,,Мен қиындыққа тап болдым!
Dialogue: 0,0:17:49.90,0:17:54.10,Default,,0,0,0,,Киригакуре стиліндегі құпия техника! Сильфонды Хякжашо!
Dialogue: 0,0:17:54.10,0:17:56.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:58.60,0:18:02.21,Default,,0,0,0,,Хахаха…. Бон!
Dialogue: 0,0:18:02.21,0:18:06.35,Default,,0,0,0,,Ах! Уф... Шура!
Dialogue: 0,0:18:06.35,0:18:08.35,Default,,0,0,0,,≪Тоқта!
Dialogue: 0,0:18:10.37,0:18:12.47,Default,,0,0,0,,Әй? Келуші сияқты.
Dialogue: 0,0:18:12.47,0:18:16.42,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:16.42,0:18:18.52,Default,,0,0,0,,Шиеми…. Өтінемін →
Dialogue: 0,0:18:18.52,0:18:22.90,Default,,0,0,0,,Тоқта! Юки-чан мұндай сұмдық жасайтын адам емес.
Dialogue: 0,0:18:22.90,0:18:26.62,Default,,0,0,0,,(Джин) Не? Эй, сен мына жігіттің досысың ба?
Dialogue: 0,0:18:26.62,0:18:30.62,Default,,0,0,0,,Юки-чан... Юки-чан маңызды адам!
Dialogue: 0,0:18:30.62,0:18:34.12,Default,,0,0,0,,Маған Юки-чанды қайтар!
Dialogue: 0,0:18:34.12,0:18:36.26,Default,,0,0,0,,Мені күлдірме! Боун Боун
Dialogue: 0,0:18:36.26,0:18:39.08,Default,,0,0,0,,(Ни Чан) Ние! Дон! Дон!
Dialogue: 0,0:18:39.08,0:18:42.88,Default,,0,0,0,,(Хамстер) Әкемді жалыннан қорғады. Бұл роуэн.
Dialogue: 0,0:18:42.88,0:18:45.02,Default,,0,0,0,,7 рет Пешке салсаңыз да жанбайтын жерден →
Dialogue: 0,0:18:45.02,0:18:47.65,Default,,0,0,0,,Міне, осындай аты бар ағаш.
Dialogue: 0,0:18:47.65,0:18:50.06,Default,,0,0,0,,Бұл өте дәл пайымдау, бірақ...
Dialogue: 0,0:18:50.06,0:18:52.46,Default,,0,0,0,,Мишимаши Мишимаши... Ха!
Dialogue: 0,0:18:52.46,0:18:55.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:55.24,0:18:57.28,Default,,0,0,0,,Ni…
Dialogue: 0,0:18:57.28,0:19:00.37,Default,,0,0,0,,Егер сізге тікелей шабуыл жасалса, сіз қанша отты бөгесеңіз де →
Dialogue: 0,0:19:00.37,0:19:05.44,Default,,0,0,0,,Біз ештеңе істей алмаймыз, солай ма? Юки-чан... Уф!
Dialogue: 0,0:19:05.44,0:19:07.47,Default,,0,0,0,,Шиеми! Гооооооооооооооо
Dialogue: 0,0:19:07.47,0:19:09.91,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:19:09.91,0:19:12.01,Default,,0,0,0,,Уф….
Dialogue: 0,0:19:12.01,0:19:14.81,Default,,0,0,0,,Қарғыс атсын... Қол шапалақта!
Dialogue: 0,0:19:16.32,0:19:19.32,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:20.60,0:19:22.82,Default,,0,0,0,,Ақымақ... неге...?
Dialogue: 0,0:19:22.82,0:19:25.29,Default,,0,0,0,,Менің ойымша, ол жасырынып жүрді.
Dialogue: 0,0:19:25.29,0:19:28.18,Default,,0,0,0,,Енді ыңғайсыздық жойылды→
Dialogue: 0,0:19:28.18,0:19:30.48,Default,,0,0,0,,Тез басымызды біріктірейік.
Dialogue: 0,0:19:32.78,0:19:36.05,Default,,0,0,0,,Мен ағаммен соғыспаймын! (Джин) Не?
Dialogue: 0,0:19:36.05,0:19:39.05,Default,,0,0,0,,Юкио! Сен ондасың ба?! Оян!!
Dialogue: 0,0:19:39.05,0:19:41.09,Default,,0,0,0,,Gyahahahaha→
Dialogue: 0,0:19:41.09,0:19:44.48,Default,,0,0,0,,Сіз де ағаңызға көмектесуге дайынсыз ба? →
Dialogue: 0,0:19:44.48,0:19:47.70,Default,,0,0,0,,Мен жылай алмаймын! Уф! Гохо, гохо.
Dialogue: 0,0:19:47.70,0:19:49.73,Default,,0,0,0,,Юкио Бұл менмін! Оян!
Dialogue: 0,0:19:49.73,0:19:51.83,Default,,0,0,0,,Дока! Босқа, ысырап!
Dialogue: 0,0:19:51.83,0:19:53.99,Default,,0,0,0,,Бұл жігіт қазірдің өзінде менікі.
Dialogue: 0,0:19:53.99,0:19:56.27,Default,,0,0,0,,Саған қанша шақырайын десем де, жауап бермейсің!
Dialogue: 0,0:19:56.27,0:19:58.97,Default,,0,0,0,,Баки! Уф! Гррр….
Dialogue: 0,0:20:00.63,0:20:03.43,Default,,0,0,0,,Сіз мені естисіз, солай ма? Юкио...
Dialogue: 0,0:20:03.43,0:20:09.13,Default,,0,0,0,,Юкио～～～～!!
Dialogue: 0,0:20:14.19,0:20:16.24,Default,,0,0,0,,Хмм….
Dialogue: 0,0:20:16.24,0:20:21.40,Default,,0,0,0,,Ух... Юкио. Ей, ол табанды жігіт.
Dialogue: 0,0:20:21.40,0:20:24.30,Default,,0,0,0,,Юкиоға тағзым етіңіз….
Dialogue: 0,0:20:26.49,0:20:29.97,Default,,0,0,0,,Көзіңді аш!
Dialogue: 0,0:20:29.97,0:20:33.03,Default,,0,0,0,,Юкио~~!
Dialogue: 0,0:20:33.03,0:20:36.45,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:36.45,0:20:38.43,Default,,0,0,0,,Ха! Бауырым...
Dialogue: 0,0:20:38.43,0:20:41.60,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:41.60,0:20:43.60,Default,,0,0,0,,Сен
Dialogue: 0,0:20:46.29,0:20:48.27,Default,,0,0,0,,Мен сені жібермеймін. →
Dialogue: 0,0:20:48.27,0:20:51.63,Default,,0,0,0,,Сіз қашып құтыла алатын жалғыз адам деп ойлайсыз ба? →
Dialogue: 0,0:20:51.63,0:20:54.68,Default,,0,0,0,,Мен ағамды ұнатпасам да. →
Dialogue: 0,0:20:54.68,0:20:57.38,Default,,0,0,0,,Менің ағам ештеңе білмей өсті. →
Dialogue: 0,0:20:57.38,0:21:01.17,Default,,0,0,0,,Мен шайтанды есіме түсіргеннен бері көріп жүрмін.
Dialogue: 0,0:21:01.17,0:21:03.99,Default,,0,0,0,,Жоқ! Мен!
Dialogue: 0,0:21:03.99,0:21:06.09,Default,,0,0,0,,Менің інім мен істей алмайтын нәрселерді істей алады →
Dialogue: 0,0:21:06.09,0:21:08.61,Default,,0,0,0,,Оны алу оңай. Уф...
Dialogue: 0,0:21:08.61,0:21:11.31,Default,,0,0,0,,(Жас Юкио) Менің ағамда менде болмайтын нәрселер бар →
Dialogue: 0,0:21:11.31,0:21:13.53,Default,,0,0,0,,Сіз оны оңай ала аласыз. →
Dialogue: 0,0:21:13.53,0:21:15.62,Default,,0,0,0,,Нии-сан... Мен Хёнсанды жек көремін! →
Dialogue: 0,0:21:15.62,0:21:18.20,Default,,0,0,0,,Ағам болмаса ғой.
Dialogue: 0,0:21:18.20,0:21:20.31,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:21:20.31,0:21:22.83,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:21:22.83,0:21:28.40,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:28.40,0:21:31.52,Default,,0,0,0,,Бауырым... Ах!
Dialogue: 0,0:21:31.52,0:21:35.14,Default,,0,0,0,,Маған көмектесіңіз... ағайын.
Dialogue: 0,0:21:35.14,0:21:37.84,Default,,0,0,0,,Ха... Юкио!
Dialogue: 0,0:21:41.21,0:21:43.91,Default,,0,0,0,,Бауырым! Бауырым!
Dialogue: 0,0:21:45.58,0:21:47.62,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:47.62,0:21:50.17,Default,,0,0,0,,Хааааа... Уау!
Dialogue: 0,0:21:50.17,0:21:53.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:53.99,0:21:56.63,Default,,0,0,0,,Күрсін... Қарғыс атсын!
Dialogue: 0,0:21:56.63,0:22:01.45,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:01.45,0:22:03.45,Default,,0,0,0,,Жарылыс! (мылтық)
Dialogue: 0,0:22:15.56,0:22:19.26,Default,,0,0,0,,Фосфор! Аа… аа….
Dialogue: 0,0:22:20.90,0:22:25.90,Default,,0,0,0,,Ах... Ахххххххххххххххххххххххххххххххххххххххххххххххххххх#
Dialogue: 0,0:22:28.87,0:22:31.51,Default,,0,0,0,,​​Мен шынымен оянамын деп ешқашан ойламадым. →
Dialogue: 0,0:22:31.51,0:22:34.46,Default,,0,0,0,,Бірақ мен сенің қашуыңа жол бермеймін. Сен менікісің! →
Dialogue: 0,0:22:34.46,0:22:36.92,Default,,0,0,0,,Аяқтаңыз! Ол жігітті өлтіріңіз →
Dialogue: 0,0:22:36.92,0:22:40.94,Default,,0,0,0,,Біз елестеткен шынайы әлемді аяқтаймыз!
Dialogue: 0,0:22:40.94,0:22:42.86,Default,,0,0,0,,Аа….
Dialogue: 0,0:22:42.86,0:22:45.12,Default,,0,0,0,,Келіңіздер! →
Dialogue: 0,0:22:45.12,0:22:48.38,Default,,0,0,0,,Келіңіздер! мінеки біз!
Dialogue: 0,0:22:48.38,0:22:52.63,Default,,0,0,0,,Қарғыс атсын! Мен істей алмаймын! (Джин) Не?
Dialogue: 0,0:22:52.63,0:22:56.17,Default,,0,0,0,,Өлетін сен екеуміз!
Dialogue: 0,0:22:56.17,0:22:59.89,Default,,0,0,0,,(Джин) Ки... Сен! Юкио...
Dialogue: 0,0:22:59.89,0:23:02.67,Default,,0,0,0,,(Джин) Қарғыс атқыр бала! Сен де мені өзіңмен бірге ала кет →
Dialogue: 0,0:23:02.67,0:23:06.13,Default,,0,0,0,,Өз өміріңді қимақшысың ба? Мен сені күлдіремін!
Dialogue: 0,0:23:06.13,0:23:09.73,Default,,0,0,0,,Мен ант бердім! Бауырыңды қорға!
Dialogue: 0,0:23:09.73,0:23:12.85,Default,,0,0,0,,Ағамды қорғау үшін... бұл дүние→
Dialogue: 0,0:23:12.85,0:23:15.14,Default,,0,0,0,,Бұл мұны істеудің жалғыз жолы!
Dialogue: 0,0:23:15.14,0:23:17.24,Default,,0,0,0,,Тоқта! Юкио Асықпа! →
Dialogue: 0,0:23:17.24,0:23:19.88,Default,,0,0,0,,Сен өлгенде, Юрий екеуміз түс көреміз!
Dialogue: 0,0:23:19.88,0:23:24.08,Default,,0,0,0,,Оооооооооооооооооуу!
Dialogue: 0,0:23:24.08,0:23:28.18,Default,,0,0,0,,Бақы! Ах... Уф! Қарғыс атқыр...
Dialogue: 0,0:23:30.07,0:23:33.74,Default,,0,0,0,,Ей, неге жалғыз өзің салқын көрінуге тырысып жатырсың!
Dialogue: 0,0:23:33.74,0:23:38.08,Default,,0,0,0,,Өміріңіздің орнына жын-шайтанды жеңу сізді қанағаттандыра ма?
Dialogue: 0,0:23:38.08,0:23:40.63,Default,,0,0,0,,Қалжыңдама! Ха...
Dialogue: 0,0:23:40.63,0:23:43.00,Default,,0,0,0,,Артында қалғандардың сезімі →
Dialogue: 0,0:23:43.00,0:23:45.40,Default,,0,0,0,,Менің оны қаншалықты жек көретінімді білесіз бе?
Dialogue: 0,0:23:47.99,0:23:51.39,Default,,0,0,0,,Осы ойлармен мен қазірдің өзінде...→
Dialogue: 0,0:23:51.39,0:23:53.39,Default,,0,0,0,,Мен оның дәмін қайта көргім келмейді.
Dialogue: 0,0:23:55.11,0:23:57.16,Default,,0,0,0,,Ағай...
Dialogue: 0,0:23:57.16,0:24:03.50,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:03.50,0:24:08.47,Default,,0,0,0,,Уф... Кешіріңіз, ағайын. кешіріңіз….
Dialogue: 0,0:24:08.47,0:24:12.01,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:12.01,0:24:14.41,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:24:16.33,0:24:19.50,Default,,0,0,0,,≪Gogogogogo... Не?
Dialogue: 0,0:24:19.50,0:24:23.17,Default,,0,0,0,,(Джин) Гяхахахаха.
Dialogue: 0,0:24:23.17,0:24:26.04,Default,,0,0,0,,Бұл дауыс! Джин!
Dialogue: 0,0:24:26.04,0:24:29.29,Default,,0,0,0,,(Джини) Мен ешқашан желге ұшады деп ойламадым →
Dialogue: 0,0:24:29.29,0:24:31.90,Default,,0,0,0,,Бұл таңқаларлық. Бірақ →
Dialogue: 0,0:24:31.90,0:24:35.38,Default,,0,0,0,,Менің арманым әлі аяқталған жоқ!
Dialogue: 0,0:24:35.38,0:24:37.68,Default,,0,0,0,,Bilibili! Жыртылған!
Dialogue: 0,0:24:40.84,0:24:42.94,Default,,0,0,0,,Ха! Не?
Dialogue: 0,0:24:42.94,0:24:45.16,Default,,0,0,0,,Бос дүниенің қақпасы!
Dialogue: 0,0:24:45.16,0:24:47.45,Default,,0,0,0,,Фуфуфуфу→
Dialogue: 0,0:24:47.45,0:24:49.60,Default,,0,0,0,,Жындар мен адамдар арасындағы жаппай соғыс →
Dialogue: 0,0:24:49.60,0:24:51.88,Default,,0,0,0,,Ақырында, шарықтау шегі! →
Dialogue: 0,0:24:51.88,0:24:54.94,Default,,0,0,0,,Кәне, інілеріміз→
Dialogue: 0,0:24:54.94,0:24:58.54,Default,,0,0,0,,Қаһарлы әкеңе қарсы қалай аман қаласың?
Dialogue: 0,0:25:00.83,0:26:29.89,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:03.11,0:28:05.14,Default,,0,0,0,,Біз шынымен де осы дүниеде туылғанбыз →
Dialogue: 0,0:28:05.14,0:28:08.33,Default,,0,0,0,,Жақсы болды ма? Не? Сол жарық!
Dialogue: 0,0:28:08.33,0:28:12.63,Default,,0,0,0,,Келісімшарт жасалды. Сапарыңыз сәтті болсын.
Dialogue: 0,0:30:40.77,0:30:43.40,Default,,0,0,0,,Алдымен, шағын ұшақтың құлауы туралы жаңалықтардан бастайық.
Dialogue: 0,0:30:44.44,0:30:46.87,Default,,0,0,0,,Непал астанасы Катманду маңында
Dialogue: 0,0:30:50.14,0:30:53.14,Default,,0,0,0,,Шағын жеке ұшақ Гималайда көркем ұшудан кейін апатқа ұшырады.
Dialogue: 0,0:30:53.14,0:30:55.58,Default,,0,0,0,,Барлық 19 жолаушы мен экипаж қаза тапты.
Dialogue: 0,0:30:55.58,0:30:57.92,Default,,0,0,0,,Әуежай қызметкерлерінің айтуынша, олардың бірі
Dialogue: 0,0:30:57.92,0:31:00.22,Default,,0,0,0,,Жапон адамы көрінеді.
Dialogue: 0,0:31:01.72,0:31:06.72,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
