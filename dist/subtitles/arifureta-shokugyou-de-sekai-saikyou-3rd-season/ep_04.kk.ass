Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.33,0:00:06.71,Default,,0,0,0,,Аа, мұндай жерде мағынасыз патрульдерге барма.
Dialogue: 0,0:00:06.79,0:00:08.29,Default,,0,0,0,,Әйел, мені ұста~
Dialogue: 0,0:00:08.38,0:00:10.67,Default,,0,0,0,,Маған Усағын тайпасынан шыққан әйел ұнайды.
Dialogue: 0,0:00:11.26,0:00:13.84,Default,,0,0,0,,Мен сені жақсы көремін, қоян жарысының әйелі.
Dialogue: 0,0:00:13.93,0:00:17.64,Default,,0,0,0,,Себебі олар ең тітіркендіргіш.
Dialogue: 0,0:00:17.72,0:00:19.68,Default,,0,0,0,,Қатты жылау
Dialogue: 0,0:00:19.76,0:00:22.06,Default,,0,0,0,,Иә? Ей, енді не болып жатыр...
Dialogue: 0,0:00:22.14,0:00:24.27,Default,,0,0,0,,Не болды?
Dialogue: 0,0:00:33.70,0:00:36.78,Default,,0,0,0,,А... Жаман, қате түсіндім.
Dialogue: 0,0:00:36.87,0:00:37.70,Default,,0,0,0,,​​О?
Dialogue: 0,0:00:40.04,0:00:42.33,Default,,0,0,0,,Эй, сен қайдасың?
Dialogue: 0,0:00:42.41,0:00:43.96,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:01:10.48,0:01:12.32,Default,,0,0,0,,HQ Бұл Альфа
Dialogue: 0,0:01:12.40,0:01:13.90,Default,,0,0,0,,С нүктесі толық бағындырылды
Dialogue: 0,0:01:14.53,0:01:17.49,Default,,0,0,0,,Біз енді қамалға шабуыл жасай бастаймыз.
Dialogue: 0,0:01:17.99,0:01:22.99,Default,,0,0,0,,♪～
Dialogue: 0,0:02:42.95,0:02:47.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:58.05,0:03:00.26,Default,,0,0,0,,HQ Bravo осында
Dialogue: 0,0:03:00.34,0:03:03.05,Default,,0,0,0,,Барлық казармаларға ұйықтататын дәрілерді тарату аяқталды
Dialogue: 0,0:03:04.05,0:03:06.22,Default,,0,0,0,,Бас кеңсе Бұл Чарли
Dialogue: 0,0:03:06.31,0:03:10.48,Default,,0,0,0,,2 ханзада, 2 император немересі және 2 ханшайымды қорғау
Dialogue: 0,0:03:10.56,0:03:14.86,Default,,0,0,0,,Хое~ Дүниеде мұндай жерлер бар.
Dialogue: 0,0:03:14.94,0:03:17.11,Default,,0,0,0,,Ағаштар теңізінде елестету мүмкін емес
Dialogue: 0,0:03:17.19,0:03:19.24,Default,,0,0,0,,Тағам да жоғары деңгейде.
Dialogue: 0,0:03:19.32,0:03:22.82,Default,,0,0,0,,Қазір ләззат алсаң босқа.
Dialogue: 0,0:03:25.37,0:03:29.25,Default,,0,0,0,,Уау... Меніңше, бізге көп көңіл бөлінбейді.
Dialogue: 0,0:03:29.33,0:03:30.41,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:03:30.50,0:03:32.54,Default,,0,0,0,,Империяның асханасы да жақсы!
Dialogue: 0,0:03:32.62,0:03:35.00,Default,,0,0,0,,Бұл торт да дәмді.
Dialogue: 0,0:03:36.42,0:03:38.00,Default,,0,0,0,,- (ханым) О - (асыл адам) О...
Dialogue: 0,0:03:39.55,0:03:40.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:40.55,0:03:42.26,Default,,0,0,0,,Не? Сол көйлек
Dialogue: 0,0:03:42.34,0:03:49.27,Default,,0,0,0,,(Дворяндардың дауысы)
Dialogue: 0,0:03:49.35,0:03:52.39,Default,,0,0,0,,Биас мырзаның да жұмысы жақсы...
Dialogue: 0,0:03:57.11,0:04:00.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:04.11,0:04:10.04,Default,,0,0,0,,(Классикалық музыканы орындау)
Dialogue: 0,0:04:18.67,0:04:21.63,Default,,0,0,0,,Не айтайын, Лилияға ұқсамайды.
Dialogue: 0,0:04:21.71,0:04:25.18,Default,,0,0,0,,Әдетте, мен өзімнің ішкі сезімдерімді жүзеге асыратындай әрекет жасамас едім.
Dialogue: 0,0:04:25.68,0:04:27.60,Default,,0,0,0,,Ондай нәрсе болуы мүмкін.
Dialogue: 0,0:04:27.68,0:04:30.68,Default,,0,0,0,,Ханшайымның да ойында көп нәрсе болса керек.
Dialogue: 0,0:04:30.77,0:04:31.98,Default,,0,0,0,,Ондай сөздер ме?
Dialogue: 0,0:04:32.06,0:04:34.69,Default,,0,0,0,,Нагумо-кун, сен Лилиге не істедің?
Dialogue: 0,0:04:34.77,0:04:38.19,Default,,0,0,0,,Эй Йэгаши, бұл нені білдіреді?
Dialogue: 0,0:04:38.27,0:04:42.49,Default,,0,0,0,,Егер ақылсыз бірдеңе орын алса, бұл әдетте Нагумо-кунның кінәсі емес.
Dialogue: 0,0:04:42.57,0:04:44.03,Default,,0,0,0,,Бұл күтпеген жағдай.
Dialogue: 0,0:04:44.11,0:04:47.16,Default,,0,0,0,,Мен тек тақ мұрагері шабуылдағалы тұрған ханшайымды қорғағым келді.
Dialogue: 0,0:04:47.24,0:04:49.24,Default,,0,0,0,,Мен сізге өтіп бара жатқанда көмектестім.
Dialogue: 0,0:04:49.33,0:04:51.08,Default,,0,0,0,,Иә, Лили қатыгез...
Dialogue: 0,0:04:51.16,0:04:52.41,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:04:52.50,0:04:55.21,Default,,0,0,0,,Эй, Хаджиме-кун! Енді ше?
Dialogue: 0,0:04:55.29,0:04:57.75,Default,,0,0,0,,Ах... солай...
Dialogue: 0,0:04:58.46,0:05:00.88,Default,,0,0,0,,Юэ Бір әнге билегің келе ме?
Dialogue: 0,0:05:00.96,0:05:03.21,Default,,0,0,0,,Қуанышпен
Dialogue: 0,0:05:03.30,0:05:04.34,Default,,0,0,0,,- (Сидзуку) Не! -(Каори) Ах.
Dialogue: 0,0:05:04.42,0:05:05.68,Default,,0,0,0,,Сәлем Нагумо-кун!
Dialogue: 0,0:05:05.76,0:05:08.22,Default,,0,0,0,,Қиындыққа тап болдым деп қашпа! Ах...
Dialogue: 0,0:05:08.30,0:05:09.97,Default,,0,0,0,,Дұрыс түсіндіріп беріңізші!
Dialogue: 0,0:05:17.06,0:05:18.48,Default,,0,0,0,,Бұл көңілді ме? Юэ
Dialogue: 0,0:05:18.98,0:05:19.98,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:22.57,0:05:25.65,Default,,0,0,0,,Келесі кезегім міндетті түрде!
Dialogue: 0,0:05:25.74,0:05:27.03,Default,,0,0,0,,Бұл алдау!
Dialogue: 0,0:05:27.11,0:05:30.91,Default,,0,0,0,,Дұрыс, тас, қағаз, қайшымен әділ шешейік.
Dialogue: 0,0:05:30.99,0:05:32.49,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:05:32.58,0:05:33.41,Default,,0,0,0,,Шидзуку-чан?
Dialogue: 0,0:05:33.49,0:05:36.25,Default,,0,0,0,,Не? Мен... мен билемеймін!
Dialogue: 0,0:05:40.33,0:05:45.34,Default,,0,0,0,,(Орындау аяқталады)
Dialogue: 0,0:05:48.84,0:05:50.18,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:50.26,0:05:51.68,Default,,0,0,0,,Хажиме Нагумо
Dialogue: 0,0:05:51.76,0:05:52.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:53.35,0:05:56.10,Default,,0,0,0,,Бір әнге билей аласыз ба?
Dialogue: 0,0:05:56.85,0:05:59.23,Default,,0,0,0,,Мұрагер ханзаданы жалғыз қалдыра аламыз ба?
Dialogue: 0,0:05:59.31,0:06:03.02,Default,,0,0,0,,Сәлемдесу мәселесіне келетін болсақ, мен негізінен біттім.
Dialogue: 0,0:06:03.11,0:06:05.74,Default,,0,0,0,,Кештен ләззат алатын кез келді.
Dialogue: 0,0:06:05.82,0:06:08.32,Default,,0,0,0,,Аа... Кешіріңіз.
Dialogue: 0,0:06:09.32,0:06:14.24,Default,,0,0,0,,Хехе, одан гөрі тезірек қолымды алшы деп едім.
Dialogue: 0,0:06:14.33,0:06:16.58,Default,,0,0,0,,Не? Ах...
Dialogue: 0,0:06:17.62,0:06:19.08,Default,,0,0,0,,Иә, Юэ?
Dialogue: 0,0:06:19.58,0:06:23.04,Default,,0,0,0,,Көпшілік алдында өзіңізді ұятқа қалдырмаңыз
Dialogue: 0,0:06:23.13,0:06:25.00,Default,,0,0,0,,Уф... түсіндім.
Dialogue: 0,0:06:25.71,0:06:27.92,Default,,0,0,0,,Мен сізге қызмет етуге қуаныштымын, ханшайым.
Dialogue: 0,0:06:28.01,0:06:29.01,Default,,0,0,0,,Иә
Dialogue: 0,0:06:29.59,0:06:32.51,Default,,0,0,0,,Тынш! Тынш! Тынш!
Dialogue: 0,0:06:29.59,0:06:32.51,Default,,0,0,0,,(Классикалық музыканы орындау)
Dialogue: 0,0:06:34.26,0:06:36.68,Default,,0,0,0,,Алдын ала айтқаныңызға рахмет.
Dialogue: 0,0:06:36.77,0:06:39.02,Default,,0,0,0,,Ах... түсіндім.
Dialogue: 0,0:06:39.10,0:06:42.65,Default,,0,0,0,,Сіздің «қызыл» түсіңіз өте әдемі.
Dialogue: 0,0:06:42.73,0:06:44.77,Default,,0,0,0,,Мен қателесе алмаймын
Dialogue: 0,0:06:44.86,0:06:48.28,Default,,0,0,0,,Міне, бұл империяның бірінші князі.
Dialogue: 0,0:06:48.36,0:06:50.28,Default,,0,0,0,,Бұл жай ғана қолдан жасалған нәрсе.
Dialogue: 0,0:06:50.36,0:06:52.03,Default,,0,0,0,,Тіпті егер
Dialogue: 0,0:06:52.12,0:06:53.70,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,0:06:53.78,0:06:57.79,Default,,0,0,0,,Нагумо-санның оны құтқарған уақыты туралы Каориден естіңіз.
Dialogue: 0,0:06:57.87,0:07:00.58,Default,,0,0,0,,Мен оған аздап сүйсіндім.
Dialogue: 0,0:07:01.37,0:07:03.50,Default,,0,0,0,,Міне, мен барлығын дайындадым.
Dialogue: 0,0:07:03.58,0:07:05.34,Default,,0,0,0,,Сол мінез бен көйлек?
Dialogue: 0,0:07:05.42,0:07:07.05,Default,,0,0,0,,Сізге сәйкес емес пе?
Dialogue: 0,0:07:07.13,0:07:09.97,Default,,0,0,0,,Маған қызғылт көйлек ұнайды.
Dialogue: 0,0:07:10.05,0:07:12.39,Default,,0,0,0,,Бұл жай ғана болжам болды ма?
Dialogue: 0,0:07:13.14,0:07:14.93,Default,,0,0,0,,Өйткені, сол өрмекші арқылы
Dialogue: 0,0:07:15.01,0:07:16.68,Default,,0,0,0,,Сіз оны көре аласыз.
Dialogue: 0,0:07:16.76,0:07:19.06,Default,,0,0,0,,Менің кішіпейіл келбетім
Dialogue: 0,0:07:19.14,0:07:23.06,Default,,0,0,0,,Аа, мен енді тұрмысқа шыға алмаймын. Йойоёо~
Dialogue: 0,0:07:23.15,0:07:25.73,Default,,0,0,0,,Сіз менімен біраз уақыттан бері тым жақын байланыста болдыңыз.
Dialogue: 0,0:07:26.65,0:07:29.32,Default,,0,0,0,,Тәжі ханзада керемет көрінеді.
Dialogue: 0,0:07:30.15,0:07:32.36,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:07:32.45,0:07:36.62,Default,,0,0,0,,Бүгін кештен кейін мен мұрагер ханшайым боламын.
Dialogue: 0,0:07:36.70,0:07:39.33,Default,,0,0,0,,Маған әзірге қыз болуға рұқсат етіңізші.
Dialogue: 0,0:07:40.08,0:07:43.04,Default,,0,0,0,,Немесе сізге көп ұзамай шабуыл жасалады
Dialogue: 0,0:07:43.12,0:07:47.13,Default,,0,0,0,,Ғашықтары қорлаған бейшара ханшайымның ұсақ өзімшілдігі
Dialogue: 0,0:07:47.21,0:07:48.84,Default,,0,0,0,,Тыңдамайсың ба?
Dialogue: 0,0:07:50.01,0:07:51.84,Default,,0,0,0,,Шабуылдау және қорлау
Dialogue: 0,0:07:51.92,0:07:53.59,Default,,0,0,0,,Бұл расталды ма?
Dialogue: 0,0:07:53.68,0:07:55.68,Default,,0,0,0,,Бұл расталды...
Dialogue: 0,0:07:56.97,0:07:58.10,Default,,0,0,0,,Мен, Ишикава және…
Dialogue: 0,0:07:59.35,0:08:02.85,Default,,0,0,0,,Мен сенен көмек сұрасам не істер едің?
Dialogue: 0,0:08:08.65,0:08:12.07,Default,,0,0,0,,Ақыр соңында бұл көмектеседі деп ойлаймын, солай ма?
Dialogue: 0,0:08:12.70,0:08:15.91,Default,,0,0,0,,Қазіргі империя бүгін түнде аяқталуы мүмкін.
Dialogue: 0,0:08:16.41,0:08:20.12,Default,,0,0,0,,Кем дегенде, тақ мұрагері емес.
Dialogue: 0,0:08:20.20,0:08:21.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:22.41,0:08:23.71,Default,,0,0,0,,Және бұл
Dialogue: 0,0:08:24.21,0:08:26.83,Default,,0,0,0,,Егер сіз бүлінетін болсаңыз, оны түсінуді жеңілдетіңіз.
Dialogue: 0,0:08:26.92,0:08:29.46,Default,,0,0,0,,Менің болжауым нашар болғандықтан.
Dialogue: 0,0:08:29.55,0:08:32.22,Default,,0,0,0,,Мен кездейсоқ бірдеңе істеуім мүмкін.
Dialogue: 0,0:08:32.72,0:08:33.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:34.26,0:08:38.51,Default,,0,0,0,,Ханшайым бақытсыз болса мұңаятындар бар.
Dialogue: 0,0:08:40.18,0:08:44.60,Default,,0,0,0,,Бұл өтірік болса да, бұл сізге арналған деп айту керек емес пе?
Dialogue: 0,0:08:44.69,0:08:46.69,Default,,0,0,0,,Ал, әзірге.
Dialogue: 0,0:08:46.77,0:08:50.69,Default,,0,0,0,,Тек ханшайымның басынан өткеретін ең жаман нәрсе болмайды деп ойлау керек.
Dialogue: 0,0:08:51.69,0:08:54.70,Default,,0,0,0,,Мен олардың сүйікті досы болсам.
Dialogue: 0,0:08:54.78,0:08:57.87,Default,,0,0,0,,Сіз тайсалмайсыз, Нагумо-сан.
Dialogue: 0,0:08:57.95,0:09:00.70,Default,,0,0,0,,Мен Юэ-санды қатты қызғанамын.
Dialogue: 0,0:09:02.20,0:09:03.70,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:04.46,0:09:05.46,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:06.42,0:09:07.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:08.29,0:09:09.75,Default,,0,0,0,,Ах~
Dialogue: 0,0:09:08.29,0:09:09.75,Default,,0,0,0,,Хаджиме-кунның әйелдікке айналуы
Dialogue: 0,0:09:09.75,0:09:09.84,Default,,0,0,0,,Хаджиме-кунның әйелдікке айналуы
Dialogue: 0,0:09:09.84,0:09:10.54,Default,,0,0,0,,Хаджиме-кунның әйелдік әрекеті
Dialogue: 0,0:09:09.84,0:09:10.54,Default,,0,0,0,,Жақсы, жақсы~
Dialogue: 0,0:09:10.54,0:09:10.63,Default,,0,0,0,,Жақсы, жақсы~
Dialogue: 0,0:09:10.63,0:09:13.01,Default,,0,0,0,,Жақсы, жақсы~
Dialogue: 0,0:09:10.63,0:09:13.01,Default,,0,0,0,,Сақтыққа жол бермеңіз немесе тәуекелге бармаңыз.
Dialogue: 0,0:09:13.09,0:09:15.84,Default,,0,0,0,,Әй, сен не сыбырлап тұрсың?
Dialogue: 0,0:09:15.93,0:09:18.47,Default,,0,0,0,,Лили тұрмысқа шыққан әйел болады, түсіндің бе?
Dialogue: 0,0:09:18.55,0:09:21.56,Default,,0,0,0,,Мастер ақырында NETORI атрибутына жетеді
Dialogue: 0,0:09:21.64,0:09:24.27,Default,,0,0,0,,Аномальды да жақсы, хехехехе
Dialogue: 0,0:09:24.35,0:09:26.56,Default,,0,0,0,,Сіз алыс әлемге тым алыс кеттіңіз!
Dialogue: 0,0:09:26.64,0:09:29.23,Default,,0,0,0,,-(Suzu) Бұл Сузудің мүмкіндігінен асып кетті~ -Хмм.
Dialogue: 0,0:09:29.31,0:09:31.36,Default,,0,0,0,,Жарайды, мен білемін.
Dialogue: 0,0:09:31.44,0:09:32.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:33.36,0:09:36.49,Default,,0,0,0,,Барлық штабқа хабарландыру
Dialogue: 0,0:09:37.36,0:09:38.99,Default,,0,0,0,,Барлық орналастырулар аяқталды
Dialogue: 0,0:09:39.78,0:09:41.49,Default,,0,0,0,,Операция қазір басталады.
Dialogue: 0,0:09:42.33,0:09:43.49,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:45.54,0:09:47.12,Default,,0,0,0,,(Шиаттың терең демі)
Dialogue: 0,0:09:47.62,0:09:49.50,Default,,0,0,0,,Хаджимэ-сан Юэ-сан
Dialogue: 0,0:09:50.79,0:09:54.51,Default,,0,0,0,,Бұдан былай сен «Хаурия тайпасының көсемінің қызысың».
Dialogue: 0,0:09:55.42,0:09:56.76,Default,,0,0,0,,Жоспар
Dialogue: 0,0:09:57.76,0:10:00.47,Default,,0,0,0,,Хмм, иә, барамын!
Dialogue: 0,0:10:06.85,0:10:11.56,Default,,0,0,0,,Тағы да Лилиана ханшайымның елімізге сапары
Dialogue: 0,0:10:11.65,0:10:14.28,Default,,0,0,0,,Ұлыммен ресми араласуымды тойлау кешінде.
Dialogue: 0,0:10:14.36,0:10:17.28,Default,,0,0,0,,Бірге келгендеріңізге рахмет.
Dialogue: 0,0:10:18.20,0:10:20.28,Default,,0,0,0,,Әртүрлі тосын сыйлар бар.
Dialogue: 0,0:10:20.36,0:10:23.28,Default,,0,0,0,,Бұл қызықты оқиға болды.
Dialogue: 0,0:10:23.99,0:10:25.04,Default,,0,0,0,,Ha
Dialogue: 0,0:10:25.12,0:10:27.79,Default,,0,0,0,,Бүкіл бетке Бұл Альфа
Dialogue: 0,0:10:27.87,0:10:32.04,Default,,0,0,0,,Біз қазір жүздеген жылдарға созылған қуғын-сүргінге нүкте қойдық.
Dialogue: 0,0:10:32.13,0:10:34.55,Default,,0,0,0,,Бұл дүние тарихында өз есіміңді жазу
Dialogue: 0,0:10:35.13,0:10:37.09,Default,,0,0,0,,Қорқыныш сөзінің синонимі.
Dialogue: 0,0:10:37.59,0:10:39.80,Default,,0,0,0,,Бұл жер тағдырдың тоғысқан жері
Dialogue: 0,0:10:39.88,0:10:42.05,Default,,0,0,0,,Тозаққа түсесің бе, әлде болашаққа барасың ба?
Dialogue: 0,0:10:42.14,0:10:45.22,Default,,0,0,0,,үшін осы бір шайқасқа байланысты.
Dialogue: 0,0:10:45.31,0:10:47.73,Default,,0,0,0,,Ешқандай мейірім көрсетпеңіз
Dialogue: 0,0:10:47.81,0:10:52.19,Default,,0,0,0,,Кәне, ең әлсіз тырнақтардың не екенін көрсетейін.
Dialogue: 0,0:10:53.65,0:10:57.99,Default,,0,0,0,,Бастық, мені осы ұрыс алаңына жетелегеніңіз үшін рахмет.
Dialogue: 0,0:10:58.07,0:10:59.07,Default,,0,0,0,,О
Dialogue: 0,0:10:59.15,0:11:01.74,Default,,0,0,0,,Жарқыраған түрде орындаңыз
Dialogue: 0,0:11:04.87,0:11:06.58,Default,,0,0,0,,Осы неке бойынша
Dialogue: 0,0:11:06.66,0:11:09.66,Default,,0,0,0,,Адамзаттың бірлігі нығая түсті.
Dialogue: 0,0:11:09.75,0:11:12.29,Default,,0,0,0,,Қорқатын ештеңе жоқ
Dialogue: 0,0:11:12.38,0:11:15.09,Default,,0,0,0,,Даңқ біздерге
Dialogue: 0,0:11:15.17,0:11:17.51,Default,,0,0,0,,Даңқ!
Dialogue: 0,0:11:18.13,0:11:19.17,Default,,0,0,0,,-Мм? -(Асыл) А.
Dialogue: 0,0:11:19.26,0:11:20.47,Default,,0,0,0,,-(Ханым) Кя~ -(Ханым) Не?
Dialogue: 0,0:11:20.55,0:11:21.76,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:11:21.84,0:11:24.01,Default,,0,0,0,,Жоқ! не? Бұл не?
Dialogue: 0,0:11:24.10,0:11:26.39,Default,,0,0,0,,Дүрбелең емес! сиқырлы жарық
Dialogue: 0,0:11:26.47,0:11:27.47,Default,,0,0,0,,Ах~ бұл қорқынышты
Dialogue: 0,0:11:27.56,0:11:28.68,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:11:29.27,0:11:31.69,Default,,0,0,0,,Балалар! Сіз әлі империалистсіз бе?
Dialogue: 0,0:11:32.73,0:11:34.61,Default,,0,0,0,,-Мм! -(Ханымдар) Кя!
Dialogue: 0,0:11:35.98,0:11:38.57,Default,,0,0,0,,Tsk, жасырын және тітіркендіргіш!
Dialogue: 0,0:11:39.40,0:11:41.11,Default,,0,0,0,,Сен кімсің... Арх!
Dialogue: 0,0:11:41.20,0:11:42.07,Default,,0,0,0,,​​О?
Dialogue: 0,0:11:47.99,0:11:50.96,Default,,0,0,0,,Тәтті, бұл әбден әбігер.
Dialogue: 0,0:11:51.04,0:11:52.58,Default,,0,0,0,,Мен ешқандай белгілерді ұстай алмаймын.
Dialogue: 0,0:11:52.67,0:11:54.63,Default,,0,0,0,,Егер сіз шағымдансаңыз!
Dialogue: 0,0:11:54.71,0:11:57.25,Default,,0,0,0,,Сіз көрінуді қамтамасыз етуге басымдық бересіз!
Dialogue: 0,0:11:57.34,0:11:59.13,Default,,0,0,0,,Қалғандардың бәрі қорғаныста болуы керек!
Dialogue: 0,0:11:59.21,0:12:00.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:01.22,0:12:03.55,Default,,0,0,0,,Жарық шашыңыз
Dialogue: 0,0:12:06.68,0:12:07.51,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:12:09.60,0:12:11.73,Default,,0,0,0,,Мені енді сені жақсы көрме!
Dialogue: 0,0:12:11.81,0:12:12.94,Default,,0,0,0,,Қарсы шабуыл басталды!
Dialogue: 0,0:12:13.98,0:12:15.15,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:12:16.15,0:12:18.02,Default,,0,0,0,,Шашыраңқы жел қабырғасы
Dialogue: 0,0:12:20.32,0:12:22.24,Default,,0,0,0,,Жалын оқтан ат!
Dialogue: 0,0:12:28.41,0:12:30.79,Default,,0,0,0,,Хмф! О құдайым-ай!
Dialogue: 0,0:12:33.79,0:12:36.50,Default,,0,0,0,,Қарғыс атқыр, бұл императордың күші ме?
Dialogue: 0,0:12:36.58,0:12:38.96,Default,,0,0,0,,Бұл тамаша! Мен сізге баяу қиғаш сызық беремін!
Dialogue: 0,0:12:41.05,0:12:43.88,Default,,0,0,0,,Өлтіруді ұнататын ниетің бар, Хаурия!
Dialogue: 0,0:12:44.47,0:12:47.55,Default,,0,0,0,,О? «Қорқамын» деп те айта алмайсың ба?
Dialogue: 0,0:12:48.18,0:12:51.81,Default,,0,0,0,,Ұрыс даласында сөз түкке тұрғысыз. Жарып өтуге тырысыңыз!
Dialogue: 0,0:12:51.89,0:12:53.27,Default,,0,0,0,,Ха, бұл тамаша!
Dialogue: 0,0:12:53.35,0:12:57.40,Default,,0,0,0,,Жарайды... Мен қояндардың жарысы мұншалықты күшті болады деп күтпеген едім.
Dialogue: 0,0:12:57.48,0:12:58.77,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:13:01.36,0:13:03.90,Default,,0,0,0,,Полк командирі, басқа бөлімшелер ше?
Dialogue: 0,0:13:03.99,0:13:05.82,Default,,0,0,0,,Неліктен біз жалғызбыз?
Dialogue: 0,0:13:05.91,0:13:08.57,Default,,0,0,0,,Әйтеуір, қазір ұлы мәртебеліге асығыңыз.
Dialogue: 0,0:13:08.66,0:13:10.20,Default,,0,0,0,,Бұл империялық бұйрық.
Dialogue: 0,0:13:12.83,0:13:16.29,Default,,0,0,0,,Не деген... қандай игілік!
Dialogue: 0,0:13:16.37,0:13:18.71,Default,,0,0,0,,Сен келер деп ойламаппын.
Dialogue: 0,0:13:18.79,0:13:20.09,Default,,0,0,0,,Сіз...
Dialogue: 0,0:13:20.17,0:13:24.34,Default,,0,0,0,,Енді менің отбасым императорға шабуыл жасайды.
Dialogue: 0,0:13:24.42,0:13:27.72,Default,,0,0,0,,Маған көмектескің келсе, мені жеңуден басқа амалың жоқ.
Dialogue: 0,0:13:27.80,0:13:29.93,Default,,0,0,0,,- Не? - (Император солдаты) Полк командирі-доно!
Dialogue: 0,0:13:30.01,0:13:33.14,Default,,0,0,0,,Осы қоян жарысын елемейміз.
Dialogue: 0,0:13:35.18,0:13:36.31,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:13:36.39,0:13:38.10,Default,,0,0,0,,Жоқ! А?
Dialogue: 0,0:13:38.81,0:13:41.02,Default,,0,0,0,,Мені жеңуден басқа амалың жоқ
Dialogue: 0,0:13:41.11,0:13:42.36,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:13:42.44,0:13:43.11,Default,,0,0,0,,Ах... а... а...
Dialogue: 0,0:13:43.11,0:13:43.57,Default,,0,0,0,,Ах... а... а...
Dialogue: 0,0:13:43.11,0:13:43.57,Default,,0,0,0,,Егер сіз және сіздің бөлімше қарсылас болсаңыз
Dialogue: 0,0:13:43.57,0:13:43.65,Default,,0,0,0,,Егер сіз және сіздің бөлімшеңіз бір-біріне қарсы болса
Dialogue: 0,0:13:43.65,0:13:45.61,Default,,0,0,0,,Егер сіз және сіздің бөлімшеңіз бір-біріне қарсы болса
Dialogue: 0,0:13:43.65,0:13:45.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:45.69,0:13:47.36,Default,,0,0,0,,Атымды тағы да айтайын.
Dialogue: 0,0:13:47.45,0:13:49.28,Default,,0,0,0,,Мен Шимін
Dialogue: 0,0:13:50.87,0:13:52.20,Default,,0,0,0,,Ши Хаурия
Dialogue: 0,0:13:52.28,0:13:54.62,Default,,0,0,0,,Бірде сен және сенің адамдарың маған шабуыл жасады.
Dialogue: 0,0:13:54.70,0:13:56.71,Default,,0,0,0,,Бұл құбыжық
Dialogue: 0,0:13:59.96,0:14:01.63,Default,,0,0,0,,Құбыжық?
Dialogue: 0,0:14:01.71,0:14:03.80,Default,,0,0,0,,Қоян нәсілінің аузы жексұрын!
Dialogue: 0,0:14:03.88,0:14:07.51,Default,,0,0,0,,Балалар! Бұл қоян жарысын өлтіріп, әрі қарай жүріңіз!
Dialogue: 0,0:14:07.59,0:14:10.72,Default,,0,0,0,,Қанша күшті болса да, ол бәрібір жарты адам!
Dialogue: 0,0:14:10.80,0:14:11.93,Default,,0,0,0,,Оны сиқырмен өлтіріңіз!
Dialogue: 0,0:14:14.81,0:14:16.60,Default,,0,0,0,,Мені ренжітпеңіз
Dialogue: 0,0:14:17.18,0:14:18.31,Default,,0,0,0,,Десу!
Dialogue: 0,0:14:18.81,0:14:20.23,Default,,0,0,0,,-Ааа! - (Император солдаты) Уф!
Dialogue: 0,0:14:20.31,0:14:21.15,Default,,0,0,0,,2-раунд, 1-жекпе-жек
Dialogue: 0,0:14:21.23,0:14:22.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:22.27,0:14:24.65,Default,,0,0,0,,Тартыңыз! Таратыңыз!
Dialogue: 0,0:14:27.61,0:14:29.78,Default,,0,0,0,,- Уряа! - (Император солдаты) Уф!
Dialogue: 0,0:14:29.86,0:14:32.74,Default,,0,0,0,,Ей, ақымақ, сен қаруыңды лақтырасың ба?
Dialogue: 0,0:14:38.33,0:14:39.16,Default,,0,0,0,,- (Император солдаты) Уф! - (Император солдаты) Ах!
Dialogue: 0,0:14:39.25,0:14:40.08,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:42.04,0:14:44.63,Default,,0,0,0,,О, қандай ұят!
Dialogue: 0,0:14:44.71,0:14:45.88,Default,,0,0,0,,- (Император солдаты) Арх! -На...
Dialogue: 0,0:14:47.17,0:14:50.09,Default,,0,0,0,,Осындай нәрсе... көмектесуге болмайды!
Dialogue: 0,0:14:50.18,0:14:52.85,Default,,0,0,0,,Уау! О!
Dialogue: 0,0:14:53.35,0:14:54.31,Default,,0,0,0,,Не!
Dialogue: 0,0:14:56.06,0:14:57.39,Default,,0,0,0,,Гаха
Dialogue: 0,0:14:58.02,0:15:00.77,Default,,0,0,0,,Ух... уф... уф
Dialogue: 0,0:15:00.85,0:15:03.40,Default,,0,0,0,,Ух... ку... уф
Dialogue: 0,0:15:03.98,0:15:04.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:07.44,0:15:11.36,Default,,0,0,0,,Өтінемін... көмектесіңізші...
Dialogue: 0,0:15:11.86,0:15:12.99,Default,,0,0,0,,Уау
Dialogue: 0,0:15:13.49,0:15:14.33,Default,,0,0,0,,Аһ!
Dialogue: 0,0:15:16.79,0:15:18.50,Default,,0,0,0,,Айға ұшу
Dialogue: 0,0:15:18.58,0:15:20.04,Default,,0,0,0,,Десу!
Dialogue: 0,0:15:20.12,0:15:20.96,Default,,0,0,0,,Осы дүкеннен қанша адам ғайып болды екен?
Dialogue: 0,0:15:29.47,0:15:30.55,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:35.72,0:15:40.35,Default,,0,0,0,,үшінңыз өзіңізді аздап өтей алдыңыз ба?
Dialogue: 0,0:15:41.73,0:15:47.15,Default,,0,0,0,,Жоқ, яғни, ол қайда…
Dialogue: 0,0:15:52.07,0:15:52.91,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:53.95,0:15:55.49,Default,,0,0,0,,Әке! Әке~!!
Dialogue: 0,0:15:57.28,0:15:59.37,Default,,0,0,0,,Не? Менің денем...
Dialogue: 0,0:16:00.08,0:16:02.83,Default,,0,0,0,,Құбыжықтарға арналған парализдік у
Dialogue: 0,0:16:02.92,0:16:05.04,Default,,0,0,0,,Тәтті... шіркін.
Dialogue: 0,0:16:05.33,0:16:06.92,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:16:07.50,0:16:10.76,Default,,0,0,0,,Ахх!
Dialogue: 0,0:16:12.13,0:16:13.43,Default,,0,0,0,,Куу...
Dialogue: 0,0:16:16.43,0:16:19.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:25.48,0:16:26.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:26.61,0:16:28.11,Default,,0,0,0,,Антидот
Dialogue: 0,0:16:28.19,0:16:29.27,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:16:29.78,0:16:32.44,Default,,0,0,0,,- (ханым) А? -(Ханым) А...
Dialogue: 0,0:16:32.53,0:16:36.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:36.53,0:16:39.28,Default,,0,0,0,,Міне, міне... бұл жақсы... бұл не?
Dialogue: 0,0:16:39.37,0:16:42.20,Default,,0,0,0,,Жарайды, тыныштал, ханшайым.
Dialogue: 0,0:16:42.29,0:16:43.96,Default,,0,0,0,,Біз қазір шарықтау шегіне жеттік.
Dialogue: 0,0:16:45.00,0:16:46.29,Default,,0,0,0,,Иә...?
Dialogue: 0,0:16:48.96,0:16:51.76,Default,,0,0,0,,Енді, Гахард Д. Хоэлшер.
Dialogue: 0,0:16:51.84,0:16:54.72,Default,,0,0,0,,Сіз қазір не үшін тірі екеніңізді білесіз бе?
Dialogue: 0,0:16:54.80,0:16:58.05,Default,,0,0,0,,Хмф, менің сұрауыңыз бар деп ойлаймын.
Dialogue: 0,0:16:58.55,0:17:00.68,Default,,0,0,0,,Айтшы, мен тыңдаймын.
Dialogue: 0,0:17:00.76,0:17:04.52,Default,,0,0,0,,Ұпайлар шегеріледі. Сіздің ұстанымыңызды түсінуге рұқсат етіңіз.
Dialogue: 0,0:17:06.31,0:17:07.19,Default,,0,0,0,,Аһ!
Dialogue: 0,0:17:07.27,0:17:09.57,Default,,0,0,0,,- (ханым) Кя! - (Асыл) Уау!
Dialogue: 0,0:17:09.65,0:17:10.98,Default,,0,0,0,,Теме...
Dialogue: 0,0:17:11.73,0:17:15.03,Default,,0,0,0,,Жер жалау дегеннің мағынасын түсін.
Dialogue: 0,0:17:18.57,0:17:21.95,Default,,0,0,0,,Қазір осы жерде тірі жүргендердің өмірі.
Dialogue: 0,0:17:22.04,0:17:24.00,Default,,0,0,0,,үшін сіздің сөзіңіз бен әрекетіңізге байланысты.
Dialogue: 0,0:17:25.25,0:17:27.58,Default,,0,0,0,,Бұл кепіл жағасы
Dialogue: 0,0:17:28.58,0:17:30.13,Default,,0,0,0,,Сіз айтқан ант
Dialogue: 0,0:17:30.21,0:17:33.51,Default,,0,0,0,,Бұл сізді өз өміріңізге бағынуға мәжбүрлейтін артефакт.
Dialogue: 0,0:17:34.09,0:17:36.43,Default,,0,0,0,,Жандары саған жалғанғандар
Dialogue: 0,0:17:36.51,0:17:39.14,Default,,0,0,0,,Өмір бойы Оны кимесең, өлесің.
Dialogue: 0,0:17:39.22,0:17:41.76,Default,,0,0,0,,Антыңды бұзсаң да өлесің.
Dialogue: 0,0:17:41.85,0:17:44.02,Default,,0,0,0,,Кепіл...?
Dialogue: 0,0:17:44.10,0:17:46.27,Default,,0,0,0,,Төрт мазмұн бар.
Dialogue: 0,0:17:46.35,0:17:48.94,Default,,0,0,0,,1. Деми-адамдарды босату
Dialogue: 0,0:17:49.02,0:17:53.28,Default,,0,0,0,,Ағаштар теңізіне шабуыл жасамау және араласпау туралы екі уәде
Dialogue: 0,0:17:53.36,0:17:55.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:53.36,0:17:55.11,Default,,0,0,0,,Үшінші: Деми-адамдарды құлдыққа және қудалауға тыйым салу
Dialogue: 0,0:17:55.11,0:17:57.03,Default,,0,0,0,,Үшінші: Деми-адамдарды құлдыққа және қудалауға тыйым салу
Dialogue: 0,0:17:57.78,0:18:00.78,Default,,0,0,0,,4 Заңдастыру және заңдылықты сақтау
Dialogue: 0,0:18:01.83,0:18:03.33,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:18:03.41,0:18:07.33,Default,,0,0,0,,Мүмкін болса, «Мен Хеллшердің атынан ант етемін» деп айтыңыз.
Dialogue: 0,0:18:07.41,0:18:09.21,Default,,0,0,0,,Содан кейін ол іске қосылады
Dialogue: 0,0:18:09.29,0:18:10.79,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:18:10.88,0:18:13.21,Default,,0,0,0,,Офицердің басы ұшады
Dialogue: 0,0:18:13.30,0:18:16.51,Default,,0,0,0,,Батпақты өлтіру драмасы шексіз қайталанады.
Dialogue: 0,0:18:16.59,0:18:18.72,Default,,0,0,0,,Содан кейін бұл соғыс.
Dialogue: 0,0:18:18.80,0:18:21.89,Default,,0,0,0,,Мен ешқашан ант сияқты ештеңе айтпаймын.
Dialogue: 0,0:18:21.97,0:18:25.06,Default,,0,0,0,,Түсіндім, ұпайлар шегерілді, Гахарудо.
Dialogue: 0,0:18:25.89,0:18:27.73,Default,,0,0,0,,Жібер!
Dialogue: 0,0:18:27.81,0:18:30.06,Default,,0,0,0,,Сіз мені кім деп ойлайсыз?
Dialogue: 0,0:18:30.15,0:18:33.07,Default,,0,0,0,,Мына лас хайуандық атмосфера!
Dialogue: 0,0:18:33.15,0:18:37.32,Default,,0,0,0,,Олардың бәрін өлтіріңіз! Мен бәріңді өлтіремін!
Dialogue: 0,0:18:37.40,0:18:38.90,Default,,0,0,0,,Мен сені өлтіруге бел байладым...
Dialogue: 0,0:18:38.99,0:18:39.82,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:38.99,0:18:39.82,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:18:39.91,0:18:41.99,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:18:42.07,0:18:43.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:43.16,0:18:44.62,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:18:44.70,0:18:48.04,Default,,0,0,0,,Бәрі өлтірілсе де, ант бермеймін.
Dialogue: 0,0:18:48.12,0:18:51.08,Default,,0,0,0,,Ашулы империя талқандады
Dialogue: 0,0:18:51.17,0:18:53.42,Default,,0,0,0,,Соңғы кезде Рюкті көрмеппін, иә?
Dialogue: 0,0:18:53.50,0:18:56.59,Default,,0,0,0,,Дельта, бұл Альфа, мұны істе.
Dialogue: 0,0:18:56.67,0:18:58.59,Default,,0,0,0,,- (Сидзуку және т.б.) Ах... - (Аристократтар) Уау!
Dialogue: 0,0:18:58.67,0:19:00.51,Default,,0,0,0,,Не? Қазіргісі
Dialogue: 0,0:19:00.59,0:19:02.34,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:19:03.39,0:19:06.10,Default,,0,0,0,,Мен жаңа ғана құл күзетінің казармасын жарып жібердім.
Dialogue: 0,0:19:06.68,0:19:07.85,Default,,0,0,0,,Не?
Dialogue: 0,0:19:07.93,0:19:12.10,Default,,0,0,0,,Кем дегенде бірнеше жүз жауынгер қаза тапты.
Dialogue: 0,0:19:12.19,0:19:14.23,Default,,0,0,0,,Бұл сен кінәлі
Dialogue: 0,0:19:14.31,0:19:16.86,Default,,0,0,0,,Сіз мұны істедіңіз!
Dialogue: 0,0:19:16.94,0:19:20.61,Default,,0,0,0,,Жоқ, сіз Гахардты өлтірдіңіз.
Dialogue: 0,0:19:20.70,0:19:23.70,Default,,0,0,0,,Сіздің шешіміңіз солдаттың өмірін қиды.
Dialogue: 0,0:19:24.20,0:19:27.24,Default,,0,0,0,,Дельта, бұл Альфа, мұны істе.
Dialogue: 0,0:19:27.33,0:19:28.37,Default,,0,0,0,,Сәлем, Хаурия!
Dialogue: 0,0:19:28.37,0:19:28.95,Default,,0,0,0,,Сәлем, Хаурия!
Dialogue: 0,0:19:28.37,0:19:28.95,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:28.95,0:19:29.04,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:29.04,0:19:30.50,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:29.04,0:19:30.50,Default,,0,0,0,,- (Ханымдар) Сәлем! - (Асыл) Ол қайда?
Dialogue: 0,0:19:30.58,0:19:32.37,Default,,0,0,0,,Оны қай жерде жарып жібердің?
Dialogue: 0,0:19:32.46,0:19:35.38,Default,,0,0,0,,Уайымдамаңыз, бұл әскери нысан.
Dialogue: 0,0:19:35.46,0:19:37.38,Default,,0,0,0,,Тек солдаттар ғана қаза тапты
Dialogue: 0,0:19:37.46,0:19:40.13,Default,,0,0,0,,Немесе сізде қандай да бір сұраулар бар ма?
Dialogue: 0,0:19:40.22,0:19:41.47,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:41.55,0:19:44.34,Default,,0,0,0,,Иә немесе жоқ?
Dialogue: 0,0:19:44.97,0:19:46.10,Default,,0,0,0,,Delta мұны жасайды
Dialogue: 0,0:19:46.18,0:19:47.01,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:47.10,0:19:47.60,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:47.60,0:19:49.52,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:47.60,0:19:49.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:50.18,0:19:53.65,Default,,0,0,0,,Ант бермесең көмектеспейді.
Dialogue: 0,0:19:54.15,0:19:58.28,Default,,0,0,0,,Мен император астанасын жарып жіберемін және оны сендерге қарсы пайдаланамын.
Dialogue: 0,0:19:58.36,0:20:00.24,Default,,0,0,0,,Дельта Бұл Альфа...
Dialogue: 0,0:20:00.32,0:20:01.40,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:20:05.62,0:20:08.41,Default,,0,0,0,,Ууу...
Dialogue: 0,0:20:09.79,0:20:12.62,Default,,0,0,0,,Каа! Қарғыс атсын!
Dialogue: 0,0:20:13.12,0:20:14.29,Default,,0,0,0,,Бұл менің жоғалтуым
Dialogue: 0,0:20:15.17,0:20:16.29,Default,,0,0,0,,Өтінішті қабылдаңыз!
Dialogue: 0,0:20:17.09,0:20:18.05,Default,,0,0,0,,Енді болмайды
Dialogue: 0,0:20:19.13,0:20:21.80,Default,,0,0,0,,Таңдамай бомбалауды тоқтатыңыз!
Dialogue: 0,0:20:22.84,0:20:24.93,Default,,0,0,0,,Бұл суперпозиция
Dialogue: 0,0:20:25.01,0:20:26.80,Default,,0,0,0,,Енді ант беріңіз.
Dialogue: 0,0:20:28.31,0:20:29.31,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:30.27,0:20:31.31,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:20:31.81,0:20:35.19,Default,,0,0,0,,Бұл жолы... орындалды.
Dialogue: 0,0:20:36.65,0:20:39.36,Default,,0,0,0,,Империяда күш бәрінен жоғары!
Dialogue: 0,0:20:39.44,0:20:43.57,Default,,0,0,0,,Бұл қоян адамдар қамалды құлату арқылы көрсетті.
Dialogue: 0,0:20:43.65,0:20:44.49,Default,,0,0,0,,Сондықтан!
Dialogue: 0,0:20:44.57,0:20:45.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:46.24,0:20:48.83,Default,,0,0,0,,Гершер империясының атынан
Dialogue: 0,0:20:49.41,0:20:51.33,Default,,0,0,0,,Осымен ант етемін!
Dialogue: 0,0:20:51.41,0:20:53.58,Default,,0,0,0,,- (Асылдар) А... а... - Әй...
Dialogue: 0,0:20:53.66,0:20:55.33,Default,,0,0,0,,-Хаджиме-сан -Мм
Dialogue: 0,0:20:56.21,0:20:57.21,Default,,0,0,0,,Ши
Dialogue: 0,0:20:58.46,0:21:00.34,Default,,0,0,0,,Бәрі бітті.
Dialogue: 0,0:21:01.09,0:21:03.13,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:21:03.22,0:21:04.09,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:04.17,0:21:05.76,Default,,0,0,0,,Бастық Бұл Альфа
Dialogue: 0,0:21:05.84,0:21:06.84,Default,,0,0,0,,-Ммм -Ах
Dialogue: 0,0:21:07.43,0:21:08.72,Default,,0,0,0,,Шығу
Dialogue: 0,0:21:08.80,0:21:11.85,Default,,0,0,0,,Барлық көмегіңіз үшін сізге алғыс айта алмаймын.
Dialogue: 0,0:21:11.93,0:21:13.52,Default,,0,0,0,,Бұл шииттерге арналған.
Dialogue: 0,0:21:13.60,0:21:14.85,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:21:15.60,0:21:18.61,Default,,0,0,0,,Бірақ бәрі әлі біткен жоқ.
Dialogue: 0,0:21:19.19,0:21:22.32,Default,,0,0,0,,Керісінше, нағыз шайқас алда.
Dialogue: 0,0:21:22.40,0:21:24.36,Default,,0,0,0,,Түсіндім, бастық.
Dialogue: 0,0:21:24.44,0:21:27.74,Default,,0,0,0,,Мен күресуге басынан бастап дайынмын.
Dialogue: 0,0:21:28.45,0:21:33.37,Default,,0,0,0,,Бұл жаңа хаурия тайпасының жүруге бел байлаған жолы.
Dialogue: 0,0:21:34.16,0:21:38.50,Default,,0,0,0,,Шынында да, сіз жеткілікті шешім қабылдадыңыз.
Dialogue: 0,0:21:39.13,0:21:41.09,Default,,0,0,0,,Барлық хаулиа тайпаларына
Dialogue: 0,0:21:44.34,0:21:45.38,Default,,0,0,0,,Бұл тамаша болды.
Dialogue: 0,0:21:45.47,0:21:50.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:03.98,0:22:08.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.90,0:23:33.91,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.95,0:23:38.79,Default,,0,0,0,,Келесі жолы «Батырдың салтанатты оралуы»
Dialogue: 0,0:23:40.29,0:23:46.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
