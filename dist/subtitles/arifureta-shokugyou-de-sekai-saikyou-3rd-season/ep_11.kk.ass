Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.80,0:00:18.93,Default,,0,0,0,,Уау~ Мұнда не бар?
Dialogue: 0,0:00:19.60,0:00:22.52,Default,,0,0,0,,Бұл қазірдің өзінде айна үйі.
Dialogue: 0,0:00:23.94,0:00:26.56,Default,,0,0,0,,Менің ойымша, ол мұздан жасалған.
Dialogue: 0,0:00:26.65,0:00:28.86,Default,,0,0,0,,Шынында да, бұл қазір айна дерлік.
Dialogue: 0,0:00:28.94,0:00:30.82,Default,,0,0,0,,Кеттік, шатастырма.
Dialogue: 0,0:00:32.19,0:00:33.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:34.65,0:00:35.49,Default,,0,0,0,,Жарқырау?
Dialogue: 0,0:00:35.57,0:00:38.45,Default,,0,0,0,,А, жоқ, ештеңе.
Dialogue: 0,0:00:38.53,0:00:40.04,Default,,0,0,0,,Хмм?
Dialogue: 0,0:00:41.95,0:00:43.41,Default,,0,0,0,,Кез келген нәрсе...
Dialogue: 0,0:00:48.54,0:00:49.54,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:00:50.67,0:00:52.55,Default,,0,0,0,,Эй, не болды, Коуки?
Dialogue: 0,0:00:52.63,0:00:53.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:54.34,0:00:56.55,Default,,0,0,0,,Сіз бірдеңе естіген жоқсыз ба?
Dialogue: 0,0:00:56.63,0:00:59.55,Default,,0,0,0,,Не? жоқ? Не болса да
Dialogue: 0,0:01:00.81,0:01:02.43,Default,,0,0,0,,Мен...
Dialogue: 0,0:01:05.98,0:01:10.98,Default,,0,0,0,,♪～
Dialogue: 0,0:02:30.94,0:02:35.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:49.21,0:02:50.12,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:52.21,0:02:53.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:53.59,0:02:54.42,Default,,0,0,0,,(шу)
Dialogue: 0,0:02:54.50,0:02:55.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:55.55,0:02:56.80,Default,,0,0,0,,Не... не?
Dialogue: 0,0:02:56.88,0:03:00.76,Default,,0,0,0,,Мен сізді таң қалдырдым ба? Кешіріңіз
Dialogue: 0,0:03:01.55,0:03:02.59,Default,,0,0,0,,Чи…
Dialogue: 0,0:03:06.10,0:03:08.93,Default,,0,0,0,,Біреу... біреу бар ма?
Dialogue: 0,0:03:09.64,0:03:11.56,Default,,0,0,0,,- (Рютаро) А? -(Шидзуку) Хмм...
Dialogue: 0,0:03:16.94,0:03:19.61,Default,,0,0,0,,Сіз ештеңе естімейсіз бе?
Dialogue: 0,0:03:19.69,0:03:21.65,Default,,0,0,0,,Адам дауысы сияқты
Dialogue: 0,0:03:21.74,0:03:24.03,Default,,0,0,0,,Осындай сыбырмен
Dialogue: 0,0:03:24.12,0:03:27.66,Default,,0,0,0,,Әй... нұр аздап жарқырап тұр! Тоқта!
Dialogue: 0,0:03:28.54,0:03:31.04,Default,,0,0,0,,Басқа біреу бірдеңе естіді ме?
Dialogue: 0,0:03:31.12,0:03:32.17,Default,,0,0,0,,Шииттер ше?
Dialogue: 0,0:03:32.25,0:03:36.17,Default,,0,0,0,,Жоқ мен ештеңе естімедім
Dialogue: 0,0:03:36.25,0:03:38.71,Default,,0,0,0,,Мен естідім!
Dialogue: 0,0:03:38.80,0:03:41.63,Default,,0,0,0,,Мүмкін сіз тым шиеленісіп жатқан шығарсыз?
Dialogue: 0,0:03:41.72,0:03:43.76,Default,,0,0,0,,Иә... мүмкін
Dialogue: 0,0:03:44.26,0:03:49.27,Default,,0,0,0,,Шиа, егер сіз бірдеңе сезсеңіз немесе естісеңіз, маған хабарлаңыз.
Dialogue: 0,0:03:49.35,0:03:50.18,Default,,0,0,0,,Иә
Dialogue: 0,0:03:50.27,0:03:52.44,Default,,0,0,0,,- (Коуки) Ха... тағы да - (Рюутаро) Ах!
Dialogue: 0,0:03:52.52,0:03:55.69,Default,,0,0,0,,Бұл менің қиялым емес еді. Мен оны қайтадан естідім!
Dialogue: 0,0:03:56.27,0:03:57.73,Default,,0,0,0,,Бұл... Коуки?
Dialogue: 0,0:03:57.82,0:03:58.69,Default,,0,0,0,,Сіз бұл жолы анық естідіңіз!
Dialogue: 0,0:03:58.69,0:03:59.69,Default,,0,0,0,,Сіз бұл жолы анық естідіңіз!
Dialogue: 0,0:03:58.69,0:03:59.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:59.69,0:04:00.44,Default,,0,0,0,,Сіз бұл жолы анық естідіңіз!
Dialogue: 0,0:04:01.32,0:04:03.61,Default,,0,0,0,,«Бұл дұрыс па?»
Dialogue: 0,0:04:03.70,0:04:05.66,Default,,0,0,0,,Жоқ... жоқ Коуки
Dialogue: 0,0:04:05.74,0:04:07.66,Default,,0,0,0,,Мен ештеңе естімедім.
Dialogue: 0,0:04:07.74,0:04:11.41,Default,,0,0,0,,Ух... иә, мен тіпті қоңырауды да естімедім.
Dialogue: 0,0:04:11.50,0:04:15.04,Default,,0,0,0,,Иә, мен де байқамадым.
Dialogue: 0,0:04:15.12,0:04:17.54,Default,,0,0,0,,Бұл өтірік емес! Бұл рас!
Dialogue: 0,0:04:17.63,0:04:19.88,Default,,0,0,0,,Қарғыс атсын, бұл кім? сен қайдасың?
Dialogue: 0,0:04:19.96,0:04:23.26,Default,,0,0,0,,Қылмыскер болудың орнына неге өзіңді көрсетпейсің?
Dialogue: 0,0:04:23.34,0:04:24.18,Default,,0,0,0,,Жарқырау!
Dialogue: 0,0:04:24.26,0:04:26.14,Default,,0,0,0,,Сабыр ет, нұр жаусын!
Dialogue: 0,0:04:26.22,0:04:27.89,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:27.97,0:04:29.01,Default,,0,0,0,,Ши
Dialogue: 0,0:04:29.10,0:04:31.81,Default,,0,0,0,,Жоқ, мен де...
Dialogue: 0,0:04:31.89,0:04:34.44,Default,,0,0,0,,Хаджиме Сиқырлы реакция дегеніміз не?
Dialogue: 0,0:04:34.52,0:04:36.15,Default,,0,0,0,,Жоқ, әсіресе ештеңе.
Dialogue: 0,0:04:36.23,0:04:37.48,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:37.56,0:04:41.36,Default,,0,0,0,,Коукиге келсек, ол Ұлы лабиринттің қысымына көнді.
Dialogue: 0,0:04:41.44,0:04:44.11,Default,,0,0,0,,Оның психикалық ауру болуы мүмкін...
Dialogue: 0,0:04:44.20,0:04:47.03,Default,,0,0,0,,Бұл тым кенет емес пе?
Dialogue: 0,0:04:48.24,0:04:53.33,Default,,0,0,0,,(Кукидің ауыр демі)
Dialogue: 0,0:04:56.37,0:04:59.42,Default,,0,0,0,,(Коукидің ауыр демі)
Dialogue: 0,0:04:59.50,0:05:02.09,Default,,0,0,0,,Аманогава, әзірше сабыр етіңіз.
Dialogue: 0,0:05:02.17,0:05:04.55,Default,,0,0,0,,Нагумо Бұл рас!
Dialogue: 0,0:05:04.63,0:05:06.68,Default,,0,0,0,,Шынында да, мен...
Dialogue: 0,0:05:07.47,0:05:09.01,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:05:09.10,0:05:11.68,Default,,0,0,0,,Мен оны тек сіздің қиялыңыз үшін тазаламаймын.
Dialogue: 0,0:05:12.39,0:05:13.68,Default,,0,0,0,,Нагумо...
Dialogue: 0,0:05:13.77,0:05:16.52,Default,,0,0,0,,Қандай да бір араласу кезінде
Dialogue: 0,0:05:16.60,0:05:18.65,Default,,0,0,0,,Сіз солай ойлауыңыз керек.
Dialogue: 0,0:05:18.73,0:05:20.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:20.77,0:05:25.90,Default,,0,0,0,,Сол сыбырлаған дауыс осы лабиринттегі сынақтардың бірі болса.
Dialogue: 0,0:05:25.99,0:05:28.70,Default,,0,0,0,,Аманогава ғана емес, мұндағылардың бәрі.
Dialogue: 0,0:05:28.78,0:05:31.45,Default,,0,0,0,,Интерференцияға ұшырауы мүмкін
Dialogue: 0,0:05:32.45,0:05:35.37,Default,,0,0,0,,Мен мұнымен не айтқың келетінін білмеймін, бірақ...
Dialogue: 0,0:05:35.46,0:05:38.88,Default,,0,0,0,,Мен қазір оны болдырмаудың ешбір әдісін ойлай алмаймын.
Dialogue: 0,0:05:38.96,0:05:41.88,Default,,0,0,0,,Барлығыңыз сақ болыңыздар.
Dialogue: 0,0:05:45.97,0:05:47.63,Default,,0,0,0,,Мен сенбедім.
Dialogue: 0,0:05:47.72,0:05:48.84,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:49.68,0:05:51.35,Default,,0,0,0,,Ах, тағы да...
Dialogue: 0,0:05:52.31,0:05:53.97,Default,,0,0,0,,Бұл таныс естіледі.
Dialogue: 0,0:05:54.06,0:05:56.14,Default,,0,0,0,,Коуки, жақсысың ба?
Dialogue: 0,0:05:56.23,0:05:58.44,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:58.52,0:06:00.06,Default,,0,0,0,,Мен оны тағы естідім...
Dialogue: 0,0:06:00.15,0:06:00.98,Default,,0,0,0,,Бірақ?
Dialogue: 0,0:06:01.69,0:06:03.78,Default,,0,0,0,,Мүмкін бұл менің қиялым шығар, бірақ...
Dialogue: 0,0:06:03.86,0:06:06.53,Default,,0,0,0,,Мен бұл бір жерден естіген дауыс шығар деп ойладым...
Dialogue: 0,0:06:07.07,0:06:09.24,Default,,0,0,0,,Халзинадағыдай
Dialogue: 0,0:06:09.32,0:06:12.45,Default,,0,0,0,,Мүмкін олар біз білетін біреуді көшіріп жатқан шығар.
Dialogue: 0,0:06:12.53,0:06:14.70,Default,,0,0,0,,Коуки, алданып қалма.
Dialogue: 0,0:06:15.29,0:06:18.37,Default,,0,0,0,,Білемін, Шидзуку, абай бол.
Dialogue: 0,0:06:18.87,0:06:20.54,Default,,0,0,0,,Нагумо дұрыс айтса
Dialogue: 0,0:06:20.63,0:06:23.00,Default,,0,0,0,,Оны тіпті Шидзуку да естуі мүмкін.
Dialogue: 0,0:06:23.09,0:06:25.71,Default,,0,0,0,,Иә, мен абай боламын.
Dialogue: 0,0:06:26.55,0:06:27.63,Default,,0,0,0,,Сіз бұл туралы білесіз бе?
Dialogue: 0,0:06:27.72,0:06:29.01,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:29.09,0:06:31.22,Default,,0,0,0,,А? Ахх...
Dialogue: 0,0:06:32.10,0:06:34.18,Default,,0,0,0,,Шидзуку мүмкін...
Dialogue: 0,0:06:34.26,0:06:35.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:35.43,0:06:38.10,Default,,0,0,0,,Иә, мен де естідім.
Dialogue: 0,0:06:38.60,0:06:40.19,Default,,0,0,0,,Бұл әйел дауысы еді.
Dialogue: 0,0:06:40.98,0:06:43.36,Default,,0,0,0,,Бұл да әйтеуір таныс естіледі.
Dialogue: 0,0:06:43.86,0:06:46.86,Default,,0,0,0,,«Қайта қарап тұрсың ба?» Мен естідім.
Dialogue: 0,0:06:49.11,0:06:51.36,Default,,0,0,0,,Қайда қайтасыз?
Dialogue: 0,0:06:51.45,0:06:53.49,Default,,0,0,0,,А...а?
Dialogue: 0,0:06:53.57,0:06:55.91,Default,,0,0,0,,А... Сен де естідің бе, Хажиме-күн?
Dialogue: 0,0:06:55.99,0:06:56.87,Default,,0,0,0,,Қызғанғаным сонша, сені өлтіргім келеді
Dialogue: 0,0:06:56.87,0:06:57.87,Default,,0,0,0,,Қызғанғаным сонша, сені өлтіргім келеді
Dialogue: 0,0:06:56.87,0:06:57.87,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:57.87,0:06:58.79,Default,,0,0,0,,Қызғанғаным сонша, сені өлтіргім келеді
Dialogue: 0,0:06:58.87,0:06:59.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:02.46,0:07:05.84,Default,,0,0,0,,Аа, дұрыс, бұл менің дауысым.
Dialogue: 0,0:07:05.92,0:07:07.51,Default,,0,0,0,,Хажиме?
Dialogue: 0,0:07:07.59,0:07:11.84,Default,,0,0,0,,Аманогаваның айтуынша, сыбырлау таныс естіледі, солай ма?
Dialogue: 0,0:07:12.43,0:07:16.51,Default,,0,0,0,,Өз даусыңды естігенде біртүрлі сезім пайда болады.
Dialogue: 0,0:07:16.60,0:07:17.85,Default,,0,0,0,,Байқау қиын
Dialogue: 0,0:07:17.93,0:07:22.23,Default,,0,0,0,,Бірақ солай болса, бұл дауыс не дейді...
Dialogue: 0,0:07:22.31,0:07:25.44,Default,,0,0,0,,Барлығы естіген сияқты.
Dialogue: 0,0:07:25.52,0:07:28.90,Default,,0,0,0,,Мазмұнына қарағанда, сіз оны білмейсіз бе?
Dialogue: 0,0:07:28.99,0:07:29.86,Default,,0,0,0,,- (Сидзуку) Иә? -(Куки) А...
Dialogue: 0,0:07:29.94,0:07:31.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:31.95,0:07:33.87,Default,,0,0,0,,Нагумо-кун не айтты?
Dialogue: 0,0:07:33.95,0:07:35.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:35.37,0:07:38.20,Default,,0,0,0,,«Құбыжықтарға орын жоқ».
Dialogue: 0,0:07:38.29,0:07:43.08,Default,,0,0,0,,«Қалай ойлайсыңдар, кісі өлтіруші қалыпты өмір сүре алады ма?»
Dialogue: 0,0:07:44.21,0:07:47.50,Default,,0,0,0,,Міне, құлағымды ауыртқан сөздер.
Dialogue: 0,0:07:47.59,0:07:49.84,Default,,0,0,0,,Мені енді адам деуге болмайды.
Dialogue: 0,0:07:49.92,0:07:50.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:51.59,0:07:55.01,Default,,0,0,0,,Мүмкін, тереңде,
Dialogue: 0,0:07:55.09,0:07:57.14,Default,,0,0,0,,Мен ескі өміріме бейімделе алмаймын ба деп қорқамын.
Dialogue: 0,0:07:57.22,0:07:58.89,Default,,0,0,0,,Мүмкін сіз ойлап отырған шығарсыз
Dialogue: 0,0:08:00.14,0:08:01.56,Default,,0,0,0,,Нагумо-кун...
Dialogue: 0,0:08:05.15,0:08:07.32,Default,,0,0,0,,Алда бөлме тәрізді шағын орын бар.
Dialogue: 0,0:08:07.40,0:08:08.90,Default,,0,0,0,,Сол жерде кішкене үзіліс жасайық.
Dialogue: 0,0:08:09.90,0:08:10.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:18.16,0:08:19.45,Default,,0,0,0,,- (Қыз) Иә! -(Сидзуку) А?
Dialogue: 0,0:08:19.54,0:08:21.45,Default,,0,0,0,,Менің ойымша, Шидзуку-чан жақсы!
Dialogue: 0,0:08:21.54,0:08:22.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:23.46,0:08:25.92,Default,,0,0,0,,Эй, Шидзуку-чан
Dialogue: 0,0:08:26.00,0:08:29.00,Default,,0,0,0,,Сіз ханшайымсыз. Көріп көрейік.
Dialogue: 0,0:08:29.09,0:08:30.92,Default,,0,0,0,,Әлде… Каори?
Dialogue: 0,0:08:31.01,0:08:34.93,Default,,0,0,0,,Сидзуку-чан ханшайымы өте сүйкімді
Dialogue: 0,0:08:35.01,0:08:38.43,Default,,0,0,0,,Бастауыш мектеп туралы соңғы естеліктеріңіз үшін, солай ма?
Dialogue: 0,0:08:38.51,0:08:40.10,Default,,0,0,0,,Кофе жасау, яғни
Dialogue: 0,0:08:40.18,0:08:44.56,Default,,0,0,0,,Егер Шидзуку-чан ханшайымды ойнаса, мен рыцарь рөлін ойнағым келеді.
Dialogue: 0,0:08:44.64,0:08:45.56,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:45.65,0:08:47.06,Default,,0,0,0,,Кем дегенде хабарласып қойсаңыз болар еді!
Dialogue: 0,0:08:47.15,0:08:49.48,Default,,0,0,0,,-(Қыз) Ааа~ Керісінше~ -(Сидзуку) А?
Dialogue: 0,0:08:49.57,0:08:53.07,Default,,0,0,0,,Каори-чан - ханшайым, ал Шидзуку-чан - рыцарь, солай ма?
Dialogue: 0,0:08:53.15,0:08:54.78,Default,,0,0,0,,Не? Ер адамдар рыцарь болуы керек емес пе?
Dialogue: 0,0:08:54.78,0:08:55.82,Default,,0,0,0,,Не? Ер адамдар рыцарь болуы керек емес пе?
Dialogue: 0,0:08:54.78,0:08:55.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:55.91,0:08:57.53,Default,,0,0,0,,Йэгаши-сан жақсы таңдау болар еді!
Dialogue: 0,0:08:57.62,0:08:58.03,Default,,0,0,0,,Дұрыс. Ол кендодан да мықты. Ол әйел рыцарь!
Dialogue: 0,0:08:58.03,0:08:59.03,Default,,0,0,0,,Дұрыс. Ол кендодан да мықты. Ол әйел рыцарь!
Dialogue: 0,0:08:58.03,0:08:59.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:59.03,0:09:01.29,Default,,0,0,0,,Дұрыс. Ол кендодан да мықты. Ол әйел рыцарь!
Dialogue: 0,0:09:01.37,0:09:01.74,Default,,0,0,0,,Менің ойымша, Шидзуку ханшайым...
Dialogue: 0,0:09:01.74,0:09:02.75,Default,,0,0,0,,Менің ойымша, Шидзуку ханшайым...
Dialogue: 0,0:09:01.74,0:09:02.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:02.75,0:09:04.96,Default,,0,0,0,,Менің ойымша, Шидзуку ханшайым...
Dialogue: 0,0:09:05.04,0:09:08.58,Default,,0,0,0,,Қараңыздар, бәріңіз, Йэгаши мырзаны назардан тыс қалдырмаңыздар.
Dialogue: 0,0:09:08.67,0:09:11.09,Default,,0,0,0,,Йэгаши мырза, сіз қандай рөлді ойнағыңыз келеді?
Dialogue: 0,0:09:11.09,0:09:12.26,Default,,0,0,0,,Йэгаши мырза, сіз қандай рөлді ойнағыңыз келеді?
Dialogue: 0,0:09:11.09,0:09:12.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:14.59,0:09:15.88,Default,,0,0,0,,Мен рыцарь ойнағым келеді
Dialogue: 0,0:09:15.97,0:09:17.84,Default,,0,0,0,,Шидзуку-чан
Dialogue: 0,0:09:18.47,0:09:21.10,Default,,0,0,0,,Каоридің рыцарь рөлін ойнауы мүмкін емес.
Dialogue: 0,0:09:21.60,0:09:24.68,Default,,0,0,0,,Маған қылыш алып жүруге рұқсат етсеңіз, бәрі қорқынышты болады.
Dialogue: 0,0:09:24.77,0:09:26.52,Default,,0,0,0,,А... а...
Dialogue: 0,0:09:24.77,0:09:26.52,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:09:26.52,0:09:27.10,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:09:27.10,0:09:29.02,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:09:27.10,0:09:29.02,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:09:29.02,0:09:29.11,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:09:29.11,0:09:30.36,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:09:29.11,0:09:30.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:30.86,0:09:34.82,Default,,0,0,0,,Басқа біреуге басымдық беріп, өз ойларыңыздан бас тартыңыз
Dialogue: 0,0:09:34.90,0:09:36.53,Default,,0,0,0,,Осыған көңіліңіз тола ма?
Dialogue: 0,0:09:37.20,0:09:39.62,Default,,0,0,0,,Яэгаши мырза, өтінемін.
Dialogue: 0,0:09:39.70,0:09:41.87,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:09:42.79,0:09:44.79,Default,,0,0,0,,Йэгаши-сан жақсы болады, солай ма?
Dialogue: 0,0:09:44.87,0:09:45.96,Default,,0,0,0,,Әрине.
Dialogue: 0,0:09:46.04,0:09:48.96,Default,,0,0,0,,Шидзуку бәрін жасай алады, солай ма?
Dialogue: 0,0:09:49.04,0:09:50.54,Default,,0,0,0,,Аха…
Dialogue: 0,0:09:51.17,0:09:53.55,Default,,0,0,0,,Шидзуку ешқайда кетпейді, солай ма?
Dialogue: 0,0:09:53.63,0:09:54.96,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:09:59.80,0:10:03.89,Default,,0,0,0,,Дәл солай, мен қазірден бастап әрқашан арқа сүйер боламын.
Dialogue: 0,0:10:03.97,0:10:07.18,Default,,0,0,0,,Күте тұрыңыз, біреуді қорғаңыз ...
Dialogue: 0,0:10:07.27,0:10:08.10,Default,,0,0,0,,Тоқта
Dialogue: 0,0:10:08.19,0:10:10.15,Default,,0,0,0,,Сіз жалғыз боласыз
Dialogue: 0,0:10:10.23,0:10:11.98,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:10:12.06,0:10:12.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:16.99,0:10:18.36,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:18.45,0:10:20.16,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:20.91,0:10:24.91,Default,,0,0,0,,Қарашы, сен күн сәулесі түскен жерде жоқсың.
Dialogue: 0,0:10:30.58,0:10:32.04,Default,,0,0,0,,А... а...
Dialogue: 0,0:10:36.13,0:10:40.09,Default,,0,0,0,,Түсіндім, кішкене үзіліс жасауды жөн көрдім.
Dialogue: 0,0:10:40.18,0:10:41.39,Default,,0,0,0,,- (қоңырау) Шизу Шизу? -(Сидзуку) Ах...
Dialogue: 0,0:10:41.47,0:10:42.43,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:10:42.51,0:10:45.64,Default,,0,0,0,,Не? О, жоқ... бұл ештеңе емес.
Dialogue: 0,0:10:45.72,0:10:48.31,Default,,0,0,0,,Оның орнына Сузу ше? Сенімен бәрі жақсы ма?
Dialogue: 0,0:10:48.39,0:10:50.94,Default,,0,0,0,,Шизу Шизу Өзіңізді қатты итермеңіз
Dialogue: 0,0:10:51.02,0:10:53.31,Default,,0,0,0,,Сузуға қарсы болмасаң, мен сенің әңгімеңді тыңдаймын.
Dialogue: 0,0:10:53.40,0:10:56.48,Default,,0,0,0,,Қоңырау соғыла қалса, тым уайымдайсыз.
Dialogue: 0,0:10:56.57,0:10:59.24,Default,,0,0,0,,Негізінде, Сузу ауыррақ сияқты.
Dialogue: 0,0:10:59.32,0:11:01.07,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:11:01.61,0:11:03.91,Default,,0,0,0,,Сузу жақсы, бірақ...
Dialogue: 0,0:11:03.99,0:11:07.62,Default,,0,0,0,,Шидзуку-чан, сен өзімшіл болуды үйренуің керек.
Dialogue: 0,0:11:07.70,0:11:10.62,Default,,0,0,0,,А... не болды? кенеттен
Dialogue: 0,0:11:10.71,0:11:15.13,Default,,0,0,0,,Егер мен Шидзуку-чанның өзімшілдігінің орнында болсам, мен не болса да бақытты болар едім.
Dialogue: 0,0:11:15.21,0:11:16.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:17.80,0:11:18.84,Default,,0,0,0,,Я...
Dialogue: 0,0:11:18.92,0:11:20.05,Default,,0,0,0,,Сәлем Коуки
Dialogue: 0,0:11:20.13,0:11:20.97,Default,,0,0,0,,Не?
Dialogue: 0,0:11:21.05,0:11:24.10,Default,,0,0,0,,Жоқ, әсіресе ештеңе жоқ.
Dialogue: 0,0:11:24.60,0:11:28.43,Default,,0,0,0,,Осындай жиіркенішті жерден құтылсам ғой.
Dialogue: 0,0:11:29.68,0:11:30.94,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:42.99,0:11:44.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:44.12,0:11:46.49,Default,,0,0,0,,Сіз осы жерден тағы да көмек сұрауды жоспарлап отырсыз ба?
Dialogue: 0,0:11:46.58,0:11:47.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:47.49,0:11:48.83,Default,,0,0,0,,Сондықтан ұрланған
Dialogue: 0,0:11:48.91,0:11:49.91,Default,,0,0,0,,Чий!
Dialogue: 0,0:11:52.42,0:11:54.83,Default,,0,0,0,,Коуки, сабыр ет!
Dialogue: 0,0:11:55.33,0:11:57.38,Default,,0,0,0,,Мен тынышпын
Dialogue: 0,0:11:57.46,0:11:58.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:01.76,0:12:02.93,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:06.14,0:12:07.39,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:07.47,0:12:08.85,Default,,0,0,0,,- (Шиа Сузу) Ммм? -(Сидзуку) Бұл... Коуки?
Dialogue: 0,0:12:10.64,0:12:12.27,Default,,0,0,0,,Бұл... жау!
Dialogue: 0,0:12:12.85,0:12:16.40,Default,,0,0,0,,Қабырғада... Қабырғадағы шағылысқаным күлімдеп тұрды!
Dialogue: 0,0:12:16.48,0:12:18.19,Default,,0,0,0,,Мен күлмесем де...
Dialogue: 0,0:12:18.69,0:12:20.90,Default,,0,0,0,,Басқа біреу бар сияқты!
Dialogue: 0,0:12:22.90,0:12:24.41,Default,,0,0,0,,Сіз қателеспейсіз, солай ма?
Dialogue: 0,0:12:24.49,0:12:26.12,Default,,0,0,0,,Маған сенбейсіз бе?
Dialogue: 0,0:12:26.20,0:12:29.45,Default,,0,0,0,,А... Жоқ, менің күмәнім жоқ.
Dialogue: 0,0:12:29.54,0:12:31.54,Default,,0,0,0,,Егер бұл Нагумо болса...
Dialogue: 0,0:12:32.04,0:12:34.75,Default,,0,0,0,,Нагумо болса, оған оңай сенер еді!
Dialogue: 0,0:12:35.58,0:12:37.75,Default,,0,0,0,,Сіз шынымен не туралы айтып отырсыз?
Dialogue: 0,0:12:37.84,0:12:39.88,Default,,0,0,0,,Күмәнім жоқ дейсің.
Dialogue: 0,0:12:39.96,0:12:41.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:41.34,0:12:43.42,Default,,0,0,0,,Нашар құлау
Dialogue: 0,0:12:52.85,0:12:54.73,Default,,0,0,0,,Біз келген сияқтымыз.
Dialogue: 0,0:13:03.11,0:13:04.86,Default,,0,0,0,,Мынау көрші есік.
Dialogue: 0,0:13:04.95,0:13:07.62,Default,,0,0,0,,Хмм... бұл күдікті көрінеді.
Dialogue: 0,0:13:07.70,0:13:10.49,Default,,0,0,0,,Иә, менде бұл туралы өте жағымсыз сезім бар.
Dialogue: 0,0:13:10.58,0:13:11.99,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:13:12.08,0:13:15.04,Default,,0,0,0,,Егер сіз үлкен кеңістікке шықсаңыз, сізге шабуыл жасалады.
Dialogue: 0,0:13:15.12,0:13:16.79,Default,,0,0,0,,Бұл қазірдің өзінде теория.
Dialogue: 0,0:13:16.87,0:13:20.92,Default,,0,0,0,,Керісінше, олар шабуыл үшін үлкен кеңістік жасайды.
Dialogue: 0,0:13:21.00,0:13:23.51,Default,,0,0,0,,Жарайды, барудан басқа амалым жоқ.
Dialogue: 0,0:13:27.93,0:13:28.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:33.60,0:13:34.43,Default,,0,0,0,,Цк
Dialogue: 0,0:13:36.27,0:13:37.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:41.82,0:13:45.03,Default,,0,0,0,,(Құлаған мұз текшелерінің дыбысы)
Dialogue: 0,0:13:49.07,0:13:50.78,Default,,0,0,0,,Мен сені жол бойы тепкілеймін!
Dialogue: 0,0:13:52.87,0:13:54.75,Default,,0,0,0,,Бұл жай ғана мұз емес сияқты.
Dialogue: 0,0:13:54.83,0:13:55.66,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:13:55.75,0:14:00.08,Default,,0,0,0,,Егер сіз мұны бір соққымен орындай алмасаңыз, онда сіз оны кезекпен жасай аласыз!
Dialogue: 0,0:14:00.58,0:14:04.09,Default,,0,0,0,,Сабан тынысы сені мұздай қорғай ма?
Dialogue: 0,0:14:05.26,0:14:06.22,Default,,0,0,0,,Жарқыл!
Dialogue: 0,0:14:06.30,0:14:07.88,Default,,0,0,0,,Бөлшектеу!
Dialogue: 0,0:14:07.97,0:14:09.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:09.97,0:14:11.85,Default,,0,0,0,,Иккуё!
Dialogue: 0,0:14:11.93,0:14:13.97,Default,,0,0,0,,Теншо жарқылы!
Dialogue: 0,0:14:15.47,0:14:16.60,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:18.35,0:14:19.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:19.31,0:14:20.77,Default,,0,0,0,,Жоқ~!
Dialogue: 0,0:14:20.86,0:14:21.86,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:24.40,0:14:25.57,Default,,0,0,0,,Цк
Dialogue: 0,0:14:25.65,0:14:26.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:26.78,0:14:28.49,Default,,0,0,0,,Не істеп тұрсың?
Dialogue: 0,0:14:28.57,0:14:30.78,Default,,0,0,0,,Каори жақсы батылдық
Dialogue: 0,0:14:30.87,0:14:32.49,Default,,0,0,0,,Шидзуку-сан?
Dialogue: 0,0:14:32.58,0:14:34.91,Default,,0,0,0,,Мені мазалайтын нәрсе бар ма?
Dialogue: 0,0:14:34.99,0:14:36.50,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:14:36.58,0:14:39.46,Default,,0,0,0,,Мен бұлай істегім келмеді!
Dialogue: 0,0:14:39.54,0:14:40.83,Default,,0,0,0,,Байқасаңыз...
Dialogue: 0,0:14:41.33,0:14:42.33,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:14:42.42,0:14:44.59,Default,,0,0,0,,А... иә.
Dialogue: 0,0:14:44.67,0:14:47.34,Default,,0,0,0,,Нагумоға шабуыл жасау ниетің жоқ!
Dialogue: 0,0:14:47.42,0:14:48.42,Default,,0,0,0,,Әрине!
Dialogue: 0,0:14:48.51,0:14:50.26,Default,,0,0,0,,Кешіріңіз, Шиа
Dialogue: 0,0:14:50.34,0:14:53.01,Default,,0,0,0,,Бірақ мен оны өзім түсінбеймін.
Dialogue: 0,0:14:53.10,0:14:54.97,Default,,0,0,0,,Мен жауды өлтіруді жоспарлап едім...
Dialogue: 0,0:14:55.47,0:14:58.73,Default,,0,0,0,,Хаджиме-кун басшылыққа алған сияқты.
Dialogue: 0,0:14:58.81,0:14:59.81,Default,,0,0,0,,Шабуылдың алдында мен сыбыр естідім деп ойладым.
Dialogue: 0,0:14:59.81,0:15:02.81,Default,,0,0,0,,Шабуылдың алдында мен сыбыр естідім деп ойладым.
Dialogue: 0,0:14:59.81,0:15:02.81,Default,,0,0,0,,(Аяз големнің қадамдары)
Dialogue: 0,0:15:04.32,0:15:06.28,Default,,0,0,0,,Мазасыз, қожайын.
Dialogue: 0,0:15:06.86,0:15:10.28,Default,,0,0,0,,Бәлкім, бейсаналық аймаққа араласу.
Dialogue: 0,0:15:10.36,0:15:14.28,Default,,0,0,0,,Сол сыбырлаған дауыс бір із қалдырған шығар.
Dialogue: 0,0:15:15.03,0:15:18.12,Default,,0,0,0,,Аманогаваның және оның достарының шабуылдарының әртүрлілігінің себебі осы ма?
Dialogue: 0,0:15:18.83,0:15:20.58,Default,,0,0,0,,Олай болса, бас тарту...
Dialogue: 0,0:15:21.42,0:15:23.83,Default,,0,0,0,,Бұл жай ғана сиқырлы әсер емес шығар.
Dialogue: 0,0:15:23.92,0:15:25.34,Default,,0,0,0,,Бұл қиын болуы керек.
Dialogue: 0,0:15:25.42,0:15:26.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:27.05,0:15:28.59,Default,,0,0,0,,Шырышты қабықтар, ашық жаралар—
Dialogue: 0,0:15:29.51,0:15:30.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:30.59,0:15:32.84,Default,,0,0,0,,Барлығын бірден үрлеңіз
Dialogue: 0,0:15:32.93,0:15:34.93,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:49.19,0:15:50.15,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:56.28,0:15:57.99,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:15:56.28,0:15:57.99,Default,,0,0,0,,(Құлаған мұз текшелерінің дыбысы)
Dialogue: 0,0:16:02.87,0:16:06.34,Default,,0,0,0,,А, Хаджиме-сан, бір дене азайып кетті.
Dialogue: 0,0:16:06.42,0:16:07.80,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:07.88,0:16:10.42,Default,,0,0,0,,Әр адам біреуді жеңуі керек сияқты.
Dialogue: 0,0:16:10.51,0:16:12.76,Default,,0,0,0,,Мәңгілік қайта тірілетін сияқтысың.
Dialogue: 0,0:16:13.30,0:16:15.34,Default,,0,0,0,,Онда бұл жолы мен!
Dialogue: 0,0:16:15.43,0:16:17.35,Default,,0,0,0,,Теншо жарқылы!
Dialogue: 0,0:16:22.60,0:16:24.02,Default,,0,0,0,,А... а...
Dialogue: 0,0:16:24.10,0:16:25.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:31.28,0:16:33.32,Default,,0,0,0,,Соңында не істейсің?
Dialogue: 0,0:16:33.40,0:16:34.70,Default,,0,0,0,,Еш ойланбаңыз!
Dialogue: 0,0:16:34.78,0:16:36.95,Default,,0,0,0,,Бұл туралы уайымдамаңыз, оны жойыңыз!
Dialogue: 0,0:16:37.03,0:16:37.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:41.58,0:16:45.21,Default,,0,0,0,,Бұл мен сот процесін жойдым дегенді білдіре ме?
Dialogue: 0,0:16:45.29,0:16:49.80,Default,,0,0,0,,Шидзуку-чан! Сузу-чан! Рютаро-кун! Жарық жарқырайды!
Dialogue: 0,0:16:49.88,0:16:52.30,Default,,0,0,0,,Жарайды! өзіңізге көңіл бөліңіз
Dialogue: 0,0:16:52.38,0:16:53.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:55.43,0:16:57.89,Default,,0,0,0,,Сен менің серіктесімсің.
Dialogue: 0,0:16:57.97,0:16:58.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:59.39,0:17:01.27,Default,,0,0,0,,Өйткені, мен сыбыр естимін.
Dialogue: 0,0:17:01.35,0:17:02.18,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:03.60,0:17:04.89,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:04.98,0:17:05.81,Default,,0,0,0,,Құт
Dialogue: 0,0:17:07.10,0:17:07.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:09.69,0:17:12.48,Default,,0,0,0,,Каори! Ұялудың қажеті жоқ
Dialogue: 0,0:17:12.57,0:17:14.57,Default,,0,0,0,,Мен де өзімді ұстамаймын!
Dialogue: 0,0:17:14.65,0:17:16.32,Default,,0,0,0,,Кешіріңіз... Кешіріңіз!
Dialogue: 0,0:17:16.32,0:17:16.86,Default,,0,0,0,,Кешіріңіз... Кешіріңіз!
Dialogue: 0,0:17:16.32,0:17:16.86,Default,,0,0,0,,(Аяз големнің қадамдары)
Dialogue: 0,0:17:16.86,0:17:17.66,Default,,0,0,0,,(Аяз големнің қадамдары)
Dialogue: 0,0:17:20.28,0:17:23.83,Default,,0,0,0,,Егер бұл бөлшектеу бомбасы болса, ол әп-сәтте бітер еді.
Dialogue: 0,0:17:23.91,0:17:25.16,Default,,0,0,0,,Егер сіз қайтадан индукциялансаңыз...
Dialogue: 0,0:17:25.16,0:17:26.58,Default,,0,0,0,,Егер сіз қайтадан индукциялансаңыз...
Dialogue: 0,0:17:25.16,0:17:26.58,Default,,0,0,0,,(күн күркіреуі)
Dialogue: 0,0:17:26.58,0:17:26.67,Default,,0,0,0,,(күн күркіреуі)
Dialogue: 0,0:17:26.67,0:17:27.96,Default,,0,0,0,,(күн күркіреуі)
Dialogue: 0,0:17:26.67,0:17:27.96,Default,,0,0,0,,Ах
Dialogue: 0,0:17:28.04,0:17:29.67,Default,,0,0,0,,Юэ аяқталды ма?
Dialogue: 0,0:17:29.75,0:17:31.71,Default,,0,0,0,,Онда сіз араласуға болады...
Dialogue: 0,0:17:31.80,0:17:32.92,Default,,0,0,0,,Ах
Dialogue: 0,0:17:33.01,0:17:34.01,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:35.05,0:17:38.51,Default,,0,0,0,,Иә! 45 градус, өтінемін!
Dialogue: 0,0:17:43.81,0:17:44.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:48.40,0:17:50.81,Default,,0,0,0,,Ха... Жарайды...
Dialogue: 0,0:17:52.07,0:17:53.82,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:17:56.99,0:17:58.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:02.28,0:18:03.33,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:05.04,0:18:06.41,Default,,0,0,0,,Қиып, ұш!
Dialogue: 0,0:18:08.25,0:18:10.00,Default,,0,0,0,,Ах... Шиа!
Dialogue: 0,0:18:10.08,0:18:12.46,Default,,0,0,0,,Бұл туралы алаңдамаңыз!
Dialogue: 0,0:18:12.54,0:18:15.09,Default,,0,0,0,,Өйткені, сіз алыс қашықтыққа техниканы пайдалана алмайсыз.
Dialogue: 0,0:18:15.92,0:18:16.76,Default,,0,0,0,,Ал егер!
Dialogue: 0,0:18:17.38,0:18:18.76,Default,,0,0,0,,Слэш, Сенька!
Dialogue: 0,0:18:20.14,0:18:21.47,Default,,0,0,0,,Шатырау!
Dialogue: 0,0:18:23.31,0:18:25.10,Default,,0,0,0,,Ауыр жарқылды сындырыңыз!
Dialogue: 0,0:18:28.06,0:18:31.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:34.02,0:18:36.94,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:18:37.03,0:18:38.40,Default,,0,0,0,,Бітті
Dialogue: 0,0:18:39.03,0:18:39.91,Default,,0,0,0,,Әсер!
Dialogue: 0,0:18:45.04,0:18:47.50,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:18:48.12,0:18:50.83,Default,,0,0,0,,Жалғыз болсаңыз... әлі жоқ.
Dialogue: 0,0:18:50.92,0:18:52.42,Default,,0,0,0,,- (Каори) Шидзуку-чан! -(Сидзуку) Ах...
Dialogue: 0,0:18:53.04,0:18:54.13,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:57.55,0:18:58.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:59.97,0:19:03.10,Default,,0,0,0,,Не? Айтқыңыз келетін нәрсе бар ма?
Dialogue: 0,0:19:03.18,0:19:04.93,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:19:05.01,0:19:08.39,Default,,0,0,0,,Мен жай ғана сендерді өте жақсы достар деп ойладым.
Dialogue: 0,0:19:08.48,0:19:11.81,Default,,0,0,0,,Мм, қандай әдемі достық.
Dialogue: 0,0:19:11.90,0:19:13.15,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:19:13.23,0:19:15.65,Default,,0,0,0,,Бұл шынымен тыныштандыратын сезінеді.
Dialogue: 0,0:19:15.73,0:19:18.40,Default,,0,0,0,,Ғашық сияқты
Dialogue: 0,0:19:18.49,0:19:19.70,Default,,0,0,0,,- (Каори) Юэ! -(Сидзуку) Ах...
Dialogue: 0,0:19:19.78,0:19:21.91,Default,,0,0,0,,Тағы да айтыңызшы!
Dialogue: 0,0:19:21.99,0:19:24.24,Default,,0,0,0,,Каори, уайымдама.
Dialogue: 0,0:19:24.32,0:19:26.87,Default,,0,0,0,,Мен біржақты емеспін.
Dialogue: 0,0:19:26.95,0:19:30.00,Default,,0,0,0,,Меніңше екі қыз да жақсы.
Dialogue: 0,0:19:30.08,0:19:31.92,Default,,0,0,0,,Мәңгілік бақыт тілейміз
Dialogue: 0,0:19:32.00,0:19:33.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:33.75,0:19:36.09,Default,,0,0,0,,Әй, Нагумо-кун!
Dialogue: 0,0:19:36.17,0:19:37.84,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:19:41.38,0:19:44.60,Default,,0,0,0,,Аманогавалық жігіт шынымен қобалжыды.
Dialogue: 0,0:19:44.68,0:19:45.76,Default,,0,0,0,,Коуки және басқалар...
Dialogue: 0,0:19:46.39,0:19:49.27,Default,,0,0,0,,Шекті бұзудың туынды әдістері әлі де бар.
Dialogue: 0,0:19:49.35,0:19:52.90,Default,,0,0,0,,Бұл пайдаланылғанға дейін көп орын бар дегенді білдіреді.
Dialogue: 0,0:19:53.40,0:19:55.86,Default,,0,0,0,,Сіз оны бірнеше минут ішінде өшіре аласыз.
Dialogue: 0,0:19:56.36,0:19:58.53,Default,,0,0,0,,Сакагами мен Танигучи де
Dialogue: 0,0:20:05.12,0:20:06.87,Default,,0,0,0,,-(Судзу) Ух... -(Коуки) А...
Dialogue: 0,0:20:06.95,0:20:07.78,Default,,0,0,0,,Уф
Dialogue: 0,0:20:07.87,0:20:09.45,Default,,0,0,0,,Каориден сұраңыз
Dialogue: 0,0:20:09.54,0:20:11.54,Default,,0,0,0,,Иә! Маған қалдырыңыз
Dialogue: 0,0:20:17.29,0:20:20.63,Default,,0,0,0,,Шамасы, бұл шығу.
Dialogue: 0,0:20:21.13,0:20:23.38,Default,,0,0,0,,Қақпаға ұқсас
Dialogue: 0,0:20:23.47,0:20:25.55,Default,,0,0,0,,Тасымалдау жүйесінен шығу?
Dialogue: 0,0:20:25.64,0:20:28.22,Default,,0,0,0,,Менде бұл туралы жақсы сезім жоқ.
Dialogue: 0,0:20:28.31,0:20:29.89,Default,,0,0,0,,-Шия, -Хмм?
Dialogue: 0,0:20:29.97,0:20:33.35,Default,,0,0,0,,Менің ойымша, ешкім Ұлы лабиринтте жақсы болжамға ие болған жоқ.
Dialogue: 0,0:20:33.44,0:20:36.19,Default,,0,0,0,,Ахахаха... Әрине
Dialogue: 0,0:20:36.86,0:20:41.94,Default,,0,0,0,,Осы жерде біраз үзіліс жасаған дұрыс па, әлде ары қарай қозғалған дұрыс па?
Dialogue: 0,0:20:42.03,0:20:43.20,Default,,0,0,0,,Әрі қарай жүрейік
Dialogue: 0,0:20:45.28,0:20:48.20,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:20:57.67,0:20:58.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:01.34,0:21:03.05,Default,,0,0,0,,Бөлінген?
Dialogue: 0,0:21:03.13,0:21:05.59,Default,,0,0,0,,Мен мұны күткен едім.
Dialogue: 0,0:21:29.20,0:21:30.62,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:35.41,0:21:36.37,Default,,0,0,0,,Аһ!
Dialogue: 0,0:21:36.46,0:21:38.08,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:21:38.17,0:21:40.54,Default,,0,0,0,,Қайтадан түсінгенде ессіз
Dialogue: 0,0:21:41.13,0:21:43.38,Default,,0,0,0,,Қандай бейбақ...
Dialogue: 0,0:21:44.05,0:21:46.34,Default,,0,0,0,,Сыбырлар дұрыс.
Dialogue: 0,0:21:46.43,0:21:47.80,Default,,0,0,0,,Расында да менің орным Жапония.
Dialogue: 0,0:21:47.88,0:21:49.51,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:21:50.47,0:21:52.89,Default,,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 0,0:21:53.39,0:21:54.39,Default,,0,0,0,,Иә
Dialogue: 0,0:21:55.23,0:21:56.64,Default,,0,0,0,,Бұл бәрінен кейін шықты ма?
Dialogue: 0,0:22:03.98,0:22:08.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.90,0:23:33.91,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.95,0:23:38.75,Default,,0,0,0,,Келесі жолы «Шын жүрек»
Dialogue: 0,0:23:40.25,0:23:46.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
