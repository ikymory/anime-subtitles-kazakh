Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:05.42,0:00:07.04,Default,,0,0,0,,Кукко...
Dialogue: 0,0:00:09.00,0:00:10.21,Default,,0,0,0,,Аһ!
Dialogue: 0,0:00:12.01,0:00:14.93,Default,,0,0,0,,Әзірше тыныш болыңыз.
Dialogue: 0,0:00:17.01,0:00:22.02,Default,,0,0,0,,♪～
Dialogue: 0,0:01:41.93,0:01:46.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:54.19,0:01:55.19,Default,,0,0,0,,Ммм
Dialogue: 0,0:01:55.28,0:01:58.20,Default,,0,0,0,,Құспа, өлетіндей іш
Dialogue: 0,0:02:01.95,0:02:03.12,Default,,0,0,0,,Пуха
Dialogue: 0,0:02:03.20,0:02:04.99,Default,,0,0,0,,Бұл шынымен Нагумо-кун ба?
Dialogue: 0,0:02:05.08,0:02:06.96,Default,,0,0,0,,Ол тағы қандай көрінеді?
Dialogue: 0,0:02:07.04,0:02:09.33,Default,,0,0,0,,Бірақ... Бірақ неге...
Dialogue: 0,0:02:09.42,0:02:10.67,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:02:10.75,0:02:14.46,Default,,0,0,0,,Мен осында пайда болған және аяқталатын жолмен келе жатыр едім.
Dialogue: 0,0:02:14.55,0:02:16.30,Default,,0,0,0,,Ал... сонда
Dialogue: 0,0:02:17.17,0:02:19.26,Default,,0,0,0,,Нагумо-кун маған шынымен қамқор болды...
Dialogue: 0,0:02:19.34,0:02:20.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:20.89,0:02:22.43,Default,,0,0,0,,Я...
Dialogue: 0,0:02:22.51,0:02:23.72,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:26.98,0:02:27.98,Default,,0,0,0,,Фу…
Dialogue: 0,0:02:29.14,0:02:31.73,Default,,0,0,0,,А, қарағым, денең толық қалпына келді.
Dialogue: 0,0:02:31.81,0:02:35.07,Default,,0,0,0,,Бұл кек алу матчы. Оны тез жеңіңіз.
Dialogue: 0,0:02:35.15,0:02:39.28,Default,,0,0,0,,Сонымен... Бірақ мен оған қарсы жеңе алмадым...
Dialogue: 0,0:02:39.78,0:02:40.91,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:02:40.99,0:02:41.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:42.70,0:02:43.74,Default,,0,0,0,,Фу…
Dialogue: 0,0:02:44.74,0:02:47.00,Default,,0,0,0,,Йэгаши, уайымдама.
Dialogue: 0,0:02:47.08,0:02:48.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:48.25,0:02:50.00,Default,,0,0,0,,Енді алыңыз.
Dialogue: 0,0:02:50.08,0:02:52.79,Default,,0,0,0,,Сіз үшін қауіпсіздік және қауіпсіздік...
Dialogue: 0,0:02:52.88,0:02:54.46,Default,,0,0,0,,Нагумо-кун?
Dialogue: 0,0:02:56.80,0:02:59.05,Default,,0,0,0,,Бетперде киген қызғылт Марк II (екі)
Dialogue: 0,0:02:59.13,0:03:02.30,Default,,0,0,0,,Нагумо-кун, қазір қалжыңдайтын уақыт емес!
Dialogue: 0,0:03:02.39,0:03:04.97,Default,,0,0,0,,Бұл дөрекі. Мен қалжыңдамаймын.
Dialogue: 0,0:03:05.05,0:03:07.35,Default,,0,0,0,,Сублимациялық сиқыр арқылы эволюция
Dialogue: 0,0:03:07.43,0:03:10.27,Default,,0,0,0,,Сіздің маскаңыздың қызғылт түсі де ерекшелік емес.
Dialogue: 0,0:03:10.35,0:03:11.31,Default,,0,0,0,,Куу…
Dialogue: 0,0:03:11.39,0:03:12.98,Default,,0,0,0,,Тыңдаңыз және таң қалдырыңыз
Dialogue: 0,0:03:13.06,0:03:16.98,Default,,0,0,0,,Оны кию арқылы сенің қабылдау қабілетің үш есе артады.
Dialogue: 0,0:03:17.07,0:03:19.57,Default,,0,0,0,,Осы арқылы сіз де оны жеңе аласыз.
Dialogue: 0,0:03:20.07,0:03:23.49,Default,,0,0,0,,Ал... Бұл да ысырапшыл жоғары өнімділік...
Dialogue: 0,0:03:23.57,0:03:25.70,Default,,0,0,0,,Сіз оны қалай бастадыңыз, солай емес пе?
Dialogue: 0,0:03:25.78,0:03:27.16,Default,,0,0,0,,Жақсы, Яэгаши...
Dialogue: 0,0:03:27.24,0:03:30.71,Default,,0,0,0,,Мен сіз осы маскалы қызғылт түстің шебері болуға лайық екеніңізге келісемін...
Dialogue: 0,0:03:30.79,0:03:32.12,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:03:32.21,0:03:34.29,Default,,0,0,0,,Сіз ондай ештеңе кимеген болсаңыз да жеңе аласыз!
Dialogue: 0,0:03:34.38,0:03:38.30,Default,,0,0,0,,Негізі, мен оны кию үшін тозақтай күресемін!
Dialogue: 0,0:03:38.38,0:03:40.59,Default,,0,0,0,,Иә, сіз жеңе аласыз.
Dialogue: 0,0:03:40.67,0:03:42.30,Default,,0,0,0,,Тіпті мұндай нәрсе болмаса да
Dialogue: 0,0:03:42.38,0:03:43.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:43.76,0:03:44.80,Default,,0,0,0,,Ұмытпаңыз
Dialogue: 0,0:03:44.89,0:03:47.81,Default,,0,0,0,,Бұл сіздің басқа қырыңыз екені сөзсіз.
Dialogue: 0,0:03:47.89,0:03:49.39,Default,,0,0,0,,үшін емес
Dialogue: 0,0:03:49.89,0:03:54.06,Default,,0,0,0,,Бұл жағымсыз эмоциялардың бір бөлігі ғана.
Dialogue: 0,0:03:54.15,0:03:57.32,Default,,0,0,0,,Менің маңызды ойларым дәл көз алдымда.
Dialogue: 0,0:03:57.40,0:04:00.99,Default,,0,0,0,,Яэгаши Шидзукуда болуы керек, солай ма?
Dialogue: 0,0:04:01.07,0:04:03.32,Default,,0,0,0,,Менде бар...
Dialogue: 0,0:04:03.40,0:04:06.03,Default,,0,0,0,,Біреудің сөзінен күйзелу деген нені білдіреді?
Dialogue: 0,0:04:06.12,0:04:08.91,Default,,0,0,0,,Бұл да өзіңмен дұрыс бетпе-бет келе алатыныңды дәлелдейді.
Dialogue: 0,0:04:08.99,0:04:11.83,Default,,0,0,0,,Бейбақтар қайтадан ашылады.
Dialogue: 0,0:04:11.91,0:04:15.33,Default,,0,0,0,,Дегенмен, сіз тым байыптысыз.
Dialogue: 0,0:04:15.42,0:04:17.38,Default,,0,0,0,,Сәйкес болыңыз
Dialogue: 0,0:04:18.29,0:04:19.84,Default,,0,0,0,,Нагумо-кун...
Dialogue: 0,0:04:20.46,0:04:24.05,Default,,0,0,0,,Айтпақшы, мен бейбақпын.
Dialogue: 0,0:04:24.13,0:04:26.14,Default,,0,0,0,,Аа, мен оны қадағалаймын.
Dialogue: 0,0:04:26.89,0:04:28.93,Default,,0,0,0,,Жеңіске жеткенше көріңіз
Dialogue: 0,0:04:29.01,0:04:31.22,Default,,0,0,0,,Мен осында болғанша сен ешқашан өлмейсің
Dialogue: 0,0:04:31.72,0:04:34.14,Default,,0,0,0,,Мен сенің өлуге жол бермеймін
Dialogue: 0,0:04:34.23,0:04:35.60,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:04:36.69,0:04:40.48,Default,,0,0,0,,Хехе, бұл өлтіруші сөз.
Dialogue: 0,0:04:41.57,0:04:43.90,Default,,0,0,0,,Сіз қарайсыз ба? мен
Dialogue: 0,0:04:43.99,0:04:44.90,Default,,0,0,0,,О
Dialogue: 0,0:04:45.53,0:04:47.91,Default,,0,0,0,,Төтенше жағдайда мені қорғайсың ба?
Dialogue: 0,0:04:47.99,0:04:48.91,Default,,0,0,0,,О
Dialogue: 0,0:04:48.99,0:04:53.08,Default,,0,0,0,,Жүрегім тағы соғып кетсе де, қайта тұруға көмектесесің бе?
Dialogue: 0,0:04:53.16,0:04:54.58,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:04:54.66,0:04:55.67,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:56.25,0:04:57.29,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:04:57.38,0:04:59.34,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:05:01.80,0:05:04.92,Default,,0,0,0,,Жарайды, мен оның алдында жауыммен сырласамын.
Dialogue: 0,0:05:05.01,0:05:07.93,Default,,0,0,0,,Сіз өте жақсы көрінесіз.
Dialogue: 0,0:05:08.01,0:05:10.85,Default,,0,0,0,,Иә? Нагумо-кунға рахмет
Dialogue: 0,0:05:10.93,0:05:15.02,Default,,0,0,0,,Әй, сен ең жақын досыңа опасыздық жасадың.
Dialogue: 0,0:05:15.10,0:05:16.73,Default,,0,0,0,,Және махаббаттың жауы
Dialogue: 0,0:05:16.81,0:05:19.15,Default,,0,0,0,,Пайдасыз әңгімелерді доғарыңыз
Dialogue: 0,0:05:19.23,0:05:21.36,Default,,0,0,0,,Өзіңізге мұндай сұрақтар қоюдың қажеті жоқ.
Dialogue: 0,0:05:21.86,0:05:25.11,Default,,0,0,0,,Мен өмір сүріп, Каоримен және басқалармен қайта кездесемін.
Dialogue: 0,0:05:25.19,0:05:26.86,Default,,0,0,0,,үшін осыдан шығады.
Dialogue: 0,0:05:26.95,0:05:28.11,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:28.70,0:05:31.74,Default,,0,0,0,,Мен сізге не жақсы екенін көрсетемін
Dialogue: 0,0:05:31.83,0:05:33.45,Default,,0,0,0,,Ешқашан берілме
Dialogue: 0,0:05:33.95,0:05:37.87,Default,,0,0,0,,Соңында ол күрескер әйелге айналады.
Dialogue: 0,0:05:37.96,0:05:42.59,Default,,0,0,0,,Мен көп нәрсені басып өмір сүргенім рас, бірақ
Dialogue: 0,0:05:42.67,0:05:45.59,Default,,0,0,0,,Нәтижесінде біз көп нәрсеге қол жеткіздік.
Dialogue: 0,0:05:45.67,0:05:48.38,Default,,0,0,0,,үшінн лақтыру үшін тым маңызды
Dialogue: 0,0:05:49.26,0:05:50.68,Default,,0,0,0,,Тіпті төбелесетін әйел
Dialogue: 0,0:05:50.76,0:05:54.14,Default,,0,0,0,,Мені менен әлдеқайда күшті біреу қорғайтын сияқты.
Dialogue: 0,0:05:54.22,0:05:58.35,Default,,0,0,0,,Ол Каори үшін маңызды адам болғандықтан ғана.
Dialogue: 0,0:05:58.44,0:06:00.15,Default,,0,0,0,,Бұл жанама себеп.
Dialogue: 0,0:06:00.23,0:06:01.65,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:06:01.73,0:06:05.15,Default,,0,0,0,,Әзірше жақсы.
Dialogue: 0,0:06:05.23,0:06:07.65,Default,,0,0,0,,Осы соққыға бәрін салыңыз
Dialogue: 0,0:06:07.74,0:06:10.24,Default,,0,0,0,,Егер сіз одан асып түссеңіз, одан асып түсуге тырысыңыз.
Dialogue: 0,0:06:10.74,0:06:13.99,Default,,0,0,0,,Хехехе, ұлы рух.
Dialogue: 0,0:06:14.08,0:06:17.16,Default,,0,0,0,,Ол шынымен қай уақытта пайда болады деп ойлаймын.
Dialogue: 0,0:06:17.25,0:06:21.42,Default,,0,0,0,,Керек кезде қажет жерде болатын адам
Dialogue: 0,0:06:21.50,0:06:25.92,Default,,0,0,0,,Мен мұндай нәрселер тек әңгімелерде бар деп ойладым.
Dialogue: 0,0:06:26.01,0:06:27.76,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:28.51,0:06:30.93,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:06:38.94,0:06:39.94,Default,,0,0,0,,- (түсіру) Әй! -(Виртуалды кескіннің түсуі) Ах!
Dialogue: 0,0:06:57.29,0:06:58.50,Default,,0,0,0,,Тамаша жұмыс
Dialogue: 0,0:06:58.58,0:07:01.29,Default,,0,0,0,,Әдеттегідей, бұл таңғаларлық қылыш шеберлігі.
Dialogue: 0,0:07:01.37,0:07:02.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:02.71,0:07:03.71,Default,,0,0,0,,Ой
Dialogue: 0,0:07:03.79,0:07:05.34,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:05.42,0:07:08.09,Default,,0,0,0,,Мені жалғыз қалдырсаң жақсы.
Dialogue: 0,0:07:08.17,0:07:09.84,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:07:09.92,0:07:11.18,Default,,0,0,0,,Ято деген құдай?
Dialogue: 0,0:07:11.26,0:07:11.76,Default,,0,0,0,,(мұздың еріген дыбысы)
Dialogue: 0,0:07:11.76,0:07:12.59,Default,,0,0,0,,(мұздың еріген дыбысы)
Dialogue: 0,0:07:11.76,0:07:12.59,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:14.22,0:07:16.93,Default,,0,0,0,,Йэгаши жүру қиын ба?
Dialogue: 0,0:07:17.01,0:07:18.56,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:19.60,0:07:22.02,Default,,0,0,0,,Сонымен, Нагумо-кун, танысқаныма қуаныштымын.
Dialogue: 0,0:07:22.10,0:07:23.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:23.65,0:07:25.06,Default,,0,0,0,,Мені құшақтап алыңыз.
Dialogue: 0,0:07:25.15,0:07:28.86,Default,,0,0,0,,Йэгаши, сен бірдеңені өзгерттің бе?
Dialogue: 0,0:07:28.94,0:07:32.99,Default,,0,0,0,,Менде енді ешқандай ескертпе жоқ, дәлірек айтсам, мен батыл болдым...
Dialogue: 0,0:07:33.07,0:07:34.32,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:34.41,0:07:37.33,Default,,0,0,0,,Мен аздап шыншыл болуға тырыстым.
Dialogue: 0,0:07:37.41,0:07:40.83,Default,,0,0,0,,Дұрыс, регенерация сиқыры бар артефакт.
Dialogue: 0,0:07:40.91,0:07:42.46,Default,,0,0,0,,Маған жасап бере аласыз ба?
Dialogue: 0,0:07:42.96,0:07:45.33,Default,,0,0,0,,Шашқа әшекей ретінде қолдана аласыз ба?
Dialogue: 0,0:07:45.92,0:07:48.84,Default,,0,0,0,,Қарашы, шашымның жіптері үзіліп қалды.
Dialogue: 0,0:07:48.92,0:07:50.76,Default,,0,0,0,,Маған оның сүйкімді болғаны ұнайды
Dialogue: 0,0:07:50.84,0:07:53.30,Default,,0,0,0,,Тапсырысты көп алатын ол.
Dialogue: 0,0:07:54.43,0:07:58.47,Default,,0,0,0,,Аа... Шыныменде бірдеңе біткен сияқты.
Dialogue: 0,0:07:59.06,0:08:00.56,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:08:00.64,0:08:03.10,Default,,0,0,0,,Қараңызшы, бұл жақсы, солай ма?
Dialogue: 0,0:08:05.44,0:08:06.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:09.65,0:08:10.61,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:10.69,0:08:14.66,Default,,0,0,0,,Регенерация сиқырының өзінен алыс болса да.
Dialogue: 0,0:08:14.74,0:08:18.66,Default,,0,0,0,,Ағзаның регенерациялау қызметі еш қиындықсыз жұмыс істеп тұрған сияқты.
Dialogue: 0,0:08:19.16,0:08:21.75,Default,,0,0,0,,Менің айтайын дегенім бұл емес...
Dialogue: 0,0:08:21.83,0:08:23.46,Default,,0,0,0,,Тезірек барайық.
Dialogue: 0,0:08:23.54,0:08:24.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:25.00,0:08:27.59,Default,,0,0,0,,Ханшайым болған жақсы болар еді.
Dialogue: 0,0:08:28.09,0:08:29.71,Default,,0,0,0,,Біз көмектесе алмаймыз ба?
Dialogue: 0,0:08:31.38,0:08:33.17,Default,,0,0,0,,Сәлем, Нагумо-кун
Dialogue: 0,0:08:33.26,0:08:35.05,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:08:35.13,0:08:38.30,Default,,0,0,0,,Сен басқа менімен әңгімені естідің бе?
Dialogue: 0,0:08:38.39,0:08:42.73,Default,,0,0,0,,Жоқ, біз алыс едік, сенің дауыстарың аз еді.
Dialogue: 0,0:08:42.81,0:08:43.73,Default,,0,0,0,,Иә
Dialogue: 0,0:08:43.81,0:08:44.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.77,0:08:47.31,Default,,0,0,0,,Бұл қол семсерге толы, солай ма?
Dialogue: 0,0:08:47.40,0:08:52.07,Default,,0,0,0,,Әрқашан солай болды, бірақ мен Тасбақаға келгеннен бері қиындай түсті.
Dialogue: 0,0:08:52.69,0:08:56.16,Default,,0,0,0,,Бұл қыздың қолы емес екеніне сенімдісің бе?
Dialogue: 0,0:08:57.16,0:08:59.45,Default,,0,0,0,,Жұмсақ, дақсыз қолдар
Dialogue: 0,0:08:59.53,0:09:01.20,Default,,0,0,0,,«Әйелдің қолы» десеңіз
Dialogue: 0,0:09:01.29,0:09:03.33,Default,,0,0,0,,Әрине, олай емес сияқты.
Dialogue: 0,0:09:05.12,0:09:07.38,Default,,0,0,0,,Бірақ бұл жақсы қадам деп ойлаймын.
Dialogue: 0,0:09:07.46,0:09:08.33,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:09:08.42,0:09:09.59,Default,,0,0,0,,О
Dialogue: 0,0:09:09.67,0:09:13.26,Default,,0,0,0,,«Мен таяқшадан ауыр ештеңені көтере алмаймын».
Dialogue: 0,0:09:13.34,0:09:15.05,Default,,0,0,0,,Қолдар әлдеқайда таза.
Dialogue: 0,0:09:15.13,0:09:16.01,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:09:16.09,0:09:17.30,Default,,0,0,0,,Яэгаши?
Dialogue: 0,0:09:18.43,0:09:20.55,Default,,0,0,0,,Менің көмекке келгеніңіз үшін рахмет.
Dialogue: 0,0:09:20.64,0:09:22.81,Default,,0,0,0,,Бұл жай ғана болды.
Dialogue: 0,0:09:23.43,0:09:24.68,Default,,0,0,0,,Нагумо-кун
Dialogue: 0,0:09:24.77,0:09:27.35,Default,,0,0,0,,Мен Каоримен жақын арада кездескім келеді.
Dialogue: 0,0:09:27.44,0:09:30.23,Default,,0,0,0,,Мен де Юэ мен Ся Тиомен кездескім келеді.
Dialogue: 0,0:09:30.31,0:09:31.36,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:09:32.32,0:09:34.65,Default,,0,0,0,,Мен Нагумо-кунға ғашық болдым деймін.
Dialogue: 0,0:09:34.74,0:09:36.78,Default,,0,0,0,,Мен не болатынын білмеймін, бірақ...
Dialogue: 0,0:09:36.86,0:09:39.45,Default,,0,0,0,,Шыншылырақ болыңыз және бір-біріңізге соқтығысуға тырысыңыз.
Dialogue: 0,0:09:39.53,0:09:42.08,Default,,0,0,0,,Түсіндім, жақында кездесеміз...
Dialogue: 0,0:09:42.16,0:09:46.08,Default,,0,0,0,,О... Эй Йэгаши, енді сен...
Dialogue: 0,0:09:46.16,0:09:48.71,Default,,0,0,0,,Каори, күте тұрыңыз.
Dialogue: 0,0:09:49.21,0:09:52.92,Default,,0,0,0,,Мен қазір өзімшіл екенімді көрсетемін.
Dialogue: 0,0:09:55.17,0:09:58.38,Default,,0,0,0,,Хмм, бұл біртүрлі түс болды.
Dialogue: 0,0:09:59.43,0:10:01.85,Default,,0,0,0,,Бірақ неге мен Сузу туралы армандадым...
Dialogue: 0,0:10:01.93,0:10:04.22,Default,,0,0,0,,Кететін уақыт та аз қалды
Dialogue: 0,0:10:04.72,0:10:08.39,Default,,0,0,0,,О~ Сіз маған қоңырау шалу үшін келдіңіз.
Dialogue: 0,0:10:08.48,0:10:10.15,Default,,0,0,0,,Босатылған түрі
Dialogue: 0,0:10:10.23,0:10:13.90,Default,,0,0,0,,Өтінемін, жабайы жүгірме, артымнан ер.
Dialogue: 0,0:10:13.98,0:10:17.32,Default,,0,0,0,,Бұл қазір сені көметін бірнеше сүйек қана.
Dialogue: 0,0:10:17.40,0:10:19.91,Default,,0,0,0,,Иә, иә, мен білемін.
Dialogue: 0,0:10:19.99,0:10:20.99,Default,,0,0,0,,Кеттік
Dialogue: 0,0:10:22.41,0:10:23.49,Default,,0,0,0,,Нхухухуху
Dialogue: 0,0:10:24.29,0:10:26.00,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:29.54,0:10:33.96,Default,,0,0,0,,Сузу Көзіңді шындықтан бұр. Бұл сенің...
Dialogue: 0,0:10:34.05,0:10:35.34,Default,,0,0,0,,Бұл әлсіздік
Dialogue: 0,0:10:34.05,0:10:35.34,Default,,0,0,0,,(қоңырау қатты тыныс алуы)
Dialogue: 0,0:10:35.34,0:10:36.80,Default,,0,0,0,,(қоңырау ауыр тыныс алу)
Dialogue: 0,0:10:36.88,0:10:40.80,Default,,0,0,0,,Бұл менің әлсіздігім
Dialogue: 0,0:10:41.55,0:10:44.51,Default,,0,0,0,,Мм... Қасиетті Цетсу!
Dialogue: 0,0:10:45.89,0:10:46.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:47.48,0:10:48.48,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:49.14,0:10:50.73,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:51.31,0:10:52.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:52.52,0:10:55.82,Default,,0,0,0,,Қандай жағдай болмасын күліп жүру керек.
Dialogue: 0,0:10:55.90,0:10:59.28,Default,,0,0,0,,Сонда жалғыз қалудың қажеті жоқ.
Dialogue: 0,0:11:00.07,0:11:04.24,Default,,0,0,0,,Эй, сен шынымен жүзіңе күлімсіреуді қою керек деп ойладың ба?
Dialogue: 0,0:11:04.33,0:11:05.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:05.28,0:11:07.83,Default,,0,0,0,,Тек кең және таяз қатынастар
Dialogue: 0,0:11:07.91,0:11:11.21,Default,,0,0,0,,Ешкіммен араласпасам да.
Dialogue: 0,0:11:11.29,0:11:12.58,Default,,0,0,0,,Сіз жалғыз емеспін деп ойладыңыз ба?
Dialogue: 0,0:11:12.58,0:11:14.21,Default,,0,0,0,,Сіз жалғыз емеспін деп ойладыңыз ба?
Dialogue: 0,0:11:12.58,0:11:14.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:14.29,0:11:18.17,Default,,0,0,0,,Сузудың қандай адам екенін еске түсірейік.
Dialogue: 0,0:11:18.26,0:11:20.76,Default,,0,0,0,,Нәтижесінде ол өлімге әкелетін күнә жасады!
Dialogue: 0,0:11:20.84,0:11:23.05,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:11:23.14,0:11:25.14,Default,,0,0,0,,- (Виртуалды кескін қоңырауы) Басынан бастап, солай ма? -(Сузу) А?
Dialogue: 0,0:11:25.22,0:11:29.02,Default,,0,0,0,,Иә, басынан бастап, кездескен кезден...
Dialogue: 0,0:11:29.81,0:11:33.48,Default,,0,0,0,,Эри жай ғана тыныш және мейірімді қыз.
Dialogue: 0,0:11:33.56,0:11:35.02,Default,,0,0,0,,Мен олай ойламадым.
Dialogue: 0,0:11:35.11,0:11:38.86,Default,,0,0,0,,Иә, ұқсас адамдар бір-біріне жанашыр болды, солай ма?
Dialogue: 0,0:11:38.94,0:11:41.78,Default,,0,0,0,,Эридің есептеу және ойнау стилі!
Dialogue: 0,0:11:43.36,0:11:44.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:48.04,0:11:49.41,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:50.87,0:11:54.79,Default,,0,0,0,,Сондықтан Сузу Эридің де солай екеніне сенді.
Dialogue: 0,0:11:54.88,0:11:57.71,Default,,0,0,0,,Сен де маған жанашырсың деп естідім.
Dialogue: 0,0:11:58.42,0:12:02.76,Default,,0,0,0,,Мен өзімнің нағыз дос екеніме, ең жақын дос болғаныма еш күмәнданбадым.
Dialogue: 0,0:12:02.84,0:12:05.39,Default,,0,0,0,,Жоқ, мен сенгім келді.
Dialogue: 0,0:12:05.47,0:12:09.35,Default,,0,0,0,,Сузу ғана Эридің шынайы болмысын байқады.
Dialogue: 0,0:12:09.43,0:12:12.31,Default,,0,0,0,,Бұл трагедияны тек Сузу ғана тоқтата алар еді.
Dialogue: 0,0:12:12.39,0:12:13.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:13.31,0:12:15.56,Default,,0,0,0,,Мен Эриден сұрауым керек еді.
Dialogue: 0,0:12:15.65,0:12:18.23,Default,,0,0,0,,Мен қашудың орнына онымен бетпе-бет келуім керек еді.
Dialogue: 0,0:12:18.32,0:12:21.15,Default,,0,0,0,,Бірақ сен басқа жаққа қарадың!
Dialogue: 0,0:12:21.24,0:12:23.24,Default,,0,0,0,,Жүрегіңді қорғау үшін
Dialogue: 0,0:12:23.32,0:12:26.03,Default,,0,0,0,,Білгіңіз келмейтін шындықтан Ең жақын досыңыздан
Dialogue: 0,0:12:26.12,0:12:27.95,Default,,0,0,0,,Мен басқа жаққа қарадым!
Dialogue: 0,0:12:29.29,0:12:30.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:31.04,0:12:32.20,Default,,0,0,0,,ал Ол Майтпен шайқасу – қауіпті ғана емес,
Dialogue: 0,0:12:40.80,0:12:43.26,Default,,0,0,0,,Эримен қайта кездескенде не істейсің?
Dialogue: 0,0:12:43.34,0:12:47.76,Default,,0,0,0,,Тіпті не айтқым келетінін білмесем де
Dialogue: 0,0:12:48.26,0:12:51.52,Default,,0,0,0,,Осыны айтсам да күшеймейді.
Dialogue: 0,0:12:51.60,0:12:54.48,Default,,0,0,0,,Жоқ, арматура шығып жатыр.
Dialogue: 0,0:12:54.56,0:12:55.39,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:12:55.48,0:12:56.60,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:56.69,0:12:59.52,Default,,0,0,0,,Бұл ереже.
Dialogue: 0,0:12:59.61,0:13:02.53,Default,,0,0,0,,Сонда сіз ешқашан күшейе алмайсыз.
Dialogue: 0,0:13:03.11,0:13:07.03,Default,,0,0,0,,Түсіндім, сіз мүлдем қарсы болмадыңыз...
Dialogue: 0,0:13:07.70,0:13:10.53,Default,,0,0,0,,Өзіңізге дұрыс көзқараспен қарау
Dialogue: 0,0:13:11.04,0:13:13.95,Default,,0,0,0,,Айтқаныңыздың бәрі дұрыс.
Dialogue: 0,0:13:14.04,0:13:16.54,Default,,0,0,0,,Сузу шынымен де жақсы емес.
Dialogue: 0,0:13:16.62,0:13:20.88,Default,,0,0,0,,Бірақ, мен өзім үшін аяғымды басып біттім.
Dialogue: 0,0:13:21.50,0:13:25.38,Default,,0,0,0,,Мен Харзинаның Ұлы лабиринтінде түс көрген кезден бастап
Dialogue: 0,0:13:25.47,0:13:29.05,Default,,0,0,0,,Сузу маңызды нәрселерден қаншалықты бас тартты?
Dialogue: 0,0:13:29.14,0:13:30.30,Default,,0,0,0,,Себебі мен білетінмін
Dialogue: 0,0:13:30.39,0:13:33.93,Default,,0,0,0,,Біз Эриді тоқтатып, үнемі бірге күлетін әлем
Dialogue: 0,0:13:34.02,0:13:35.73,Default,,0,0,0,,Бұл ыңғайлы түс болды.
Dialogue: 0,0:13:35.81,0:13:39.23,Default,,0,0,0,,Мен сол арман әлемін алуым керек еді.
Dialogue: 0,0:13:39.31,0:13:42.65,Default,,0,0,0,,Сузу шындықты дұрыс қабылдаса.
Dialogue: 0,0:13:42.73,0:13:44.24,Default,,0,0,0,,Дұрыс айтасыз
Dialogue: 0,0:13:44.32,0:13:48.07,Default,,0,0,0,,Шынымды айтсам, тіпті Сузу Эримен кездескеннен кейін не істегісі келетінін білмейді.
Dialogue: 0,0:13:48.16,0:13:49.70,Default,,0,0,0,,Кінәлі болғың келе ме?
Dialogue: 0,0:13:49.78,0:13:52.24,Default,,0,0,0,,Алысқа қарағаныңыз үшін кешірім сұрағыңыз келе ме?
Dialogue: 0,0:13:52.33,0:13:53.99,Default,,0,0,0,,Сендіргің келе ме?
Dialogue: 0,0:13:55.04,0:13:56.37,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:13:56.87,0:13:58.33,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:13:58.42,0:14:01.34,Default,,0,0,0,,Мен тек кездесуіміз керек екенін білемін.
Dialogue: 0,0:14:01.42,0:14:03.84,Default,,0,0,0,,Детерминация шынайы, солай емес пе?
Dialogue: 0,0:14:03.92,0:14:07.22,Default,,0,0,0,,Иә, енді менің тәтті арманым жоқ.
Dialogue: 0,0:14:07.30,0:14:11.14,Default,,0,0,0,,Suzu сізден асып түседі және алдағы жолды жалғастырады!
Dialogue: 0,0:14:11.22,0:14:13.01,Default,,0,0,0,,Мен оны қабылдаймын.
Dialogue: 0,0:14:13.10,0:14:16.23,Default,,0,0,0,,Менің әлсіздігімді ерік-жігерге айналдырған күш
Dialogue: 0,0:14:16.31,0:14:18.35,Default,,0,0,0,,Маған оның қанша екенін көрсетіңіз!
Dialogue: 0,0:14:21.11,0:14:23.61,Default,,0,0,0,,Рахмет, Ордеал мырза.
Dialogue: 0,0:14:23.69,0:14:24.69,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:14:24.78,0:14:27.61,Default,,0,0,0,,Мың гүл болып, нұр шашып
Dialogue: 0,0:14:27.70,0:14:29.28,Default,,0,0,0,,Косанка!
Dialogue: 0,0:14:36.00,0:14:37.00,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:41.58,0:14:44.84,Default,,0,0,0,,Менің сезімім оған жетеді деп үміттенемін
Dialogue: 0,0:14:44.92,0:14:45.88,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:51.34,0:14:52.55,Default,,0,0,0,,Я...
Dialogue: 0,0:14:54.72,0:14:56.35,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:14:56.35,0:14:57.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:57.73,0:14:57.81,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:14:57.81,0:15:00.02,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:15:00.10,0:15:02.65,Default,,0,0,0,,Йо Сузу, ояусың ба?
Dialogue: 0,0:15:02.73,0:15:04.94,Default,,0,0,0,,? Рютаро-кун?
Dialogue: 0,0:15:05.02,0:15:06.94,Default,,0,0,0,,Эй, бұл менмін.
Dialogue: 0,0:15:07.03,0:15:09.65,Default,,0,0,0,,Мүмкін бұл сот залы шығар?
Dialogue: 0,0:15:09.74,0:15:11.99,Default,,0,0,0,,Сіз басқалармен байланыста болдыңыз ба?
Dialogue: 0,0:15:12.07,0:15:13.28,Default,,0,0,0,,Көру жақсы
Dialogue: 0,0:15:13.37,0:15:16.04,Default,,0,0,0,,Менің ойымша, алдымызда біреудің бөлмесі бар.
Dialogue: 0,0:15:16.12,0:15:18.79,Default,,0,0,0,,Мен бұл Каолин немесе Тио деп үміттенемін.
Dialogue: 0,0:15:18.87,0:15:22.33,Default,,0,0,0,,А, енді ойлап қарасам, Рютаро-кунның соты қалай өтті?
Dialogue: 0,0:15:22.42,0:15:23.58,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:15:23.67,0:15:25.38,Default,,0,0,0,,Жауап қиын болса жақсы.
Dialogue: 0,0:15:25.46,0:15:28.80,Default,,0,0,0,,Жоқ, бұл үлкен мәселе емес, маған бәрібір.
Dialogue: 0,0:15:28.88,0:15:32.80,Default,,0,0,0,,Оны жай ғана қорлап, қорлады.
Dialogue: 0,0:15:33.43,0:15:34.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:34.35,0:15:36.97,Default,,0,0,0,,Сен тек алдап жатырсың дейді.
Dialogue: 0,0:15:37.06,0:15:41.10,Default,,0,0,0,,Мен Коуки мен Нагумодан кейін екінші немесе үшінші орында болғаным жақсы.
Dialogue: 0,0:15:41.19,0:15:42.77,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:15:42.85,0:15:44.81,Default,,0,0,0,,Себебі мен жеңе алмаймын деп ойлаймын
Dialogue: 0,0:15:44.90,0:15:47.27,Default,,0,0,0,,Себебі мен жеңіліп, ұятқа қалғым келмейді.
Dialogue: 0,0:15:47.36,0:15:49.53,Default,,0,0,0,,Себебі мен оны мойындауға қорқамын
Dialogue: 0,0:15:50.11,0:15:53.99,Default,,0,0,0,,Мен тек қосалқы рөлді ойнай алатындай сезінемін.
Dialogue: 0,0:15:54.07,0:15:55.74,Default,,0,0,0,,Маған көп нәрсе айтылды.
Dialogue: 0,0:15:55.82,0:15:57.41,Default,,0,0,0,,Рютаро-кун, аянышты...
Dialogue: 0,0:15:57.49,0:15:59.33,Default,,0,0,0,,Сәлем! Уайымдама!
Dialogue: 0,0:15:59.41,0:16:01.58,Default,,0,0,0,,Мені қума!
Dialogue: 0,0:16:05.67,0:16:09.00,Default,,0,0,0,,Дәрменсізді осылай қорғамадыңыз ба?
Dialogue: 0,0:16:09.09,0:16:12.59,Default,,0,0,0,,Әлсізді сонша қолдамадың ба?
Dialogue: 0,0:16:12.68,0:16:14.18,Default,,0,0,0,,Жамандық көрінсе
Dialogue: 0,0:16:14.26,0:16:17.60,Default,,0,0,0,,Сен бәрінен бұрын шайқасты!
Dialogue: 0,0:16:20.56,0:16:22.31,Default,,0,0,0,,Мүмкін, мен кенеттен үйленуге ұсыныс жасағандықтан шығар—
Dialogue: 0,0:16:22.39,0:16:24.56,Default,,0,0,0,,Елге немесе нәсілге қарамастан
Dialogue: 0,0:16:24.65,0:16:27.94,Default,,0,0,0,,Біз, айдаһар тұқымы, бәрінің қамқоршысы болдық.
Dialogue: 0,0:16:28.02,0:16:30.94,Default,,0,0,0,,Сол күндерде біз ешқашан құтқара алмағандар болды.
Dialogue: 0,0:16:31.03,0:16:32.61,Default,,0,0,0,,Бұл қаншалықты жаман болды?
Dialogue: 0,0:16:32.70,0:16:35.53,Default,,0,0,0,,Біздің адамгершілік пен ізгі ниетімізге
Dialogue: 0,0:16:35.61,0:16:37.70,Default,,0,0,0,,Асыл болуға дайын болу
Dialogue: 0,0:16:37.78,0:16:41.12,Default,,0,0,0,,Қорықпағандар қаншама!
Dialogue: 0,0:16:44.37,0:16:47.71,Default,,0,0,0,,Ең күшті және ең жақсы ел деп аталды.
Dialogue: 0,0:16:48.63,0:16:50.71,Default,,0,0,0,,Бұл жұмақ болуы керек еді
Dialogue: 0,0:16:50.80,0:16:54.51,Default,,0,0,0,,Нәсіліне, тектілігіне қарамастан әлсіз де, күшті де.
Dialogue: 0,0:16:54.59,0:16:58.35,Default,,0,0,0,,Түрлі адамдар қатар өмір сүріп, гүлденген жұмақ болса керек.
Dialogue: 0,0:16:58.43,0:16:59.85,Default,,0,0,0,,Мүмкін, мен кенеттен үйленуге ұсыныс жасағандықтан шығар—
Dialogue: 0,0:16:59.93,0:17:01.27,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:08.40,0:17:13.74,Default,,0,0,0,,Құдай олардың бәрін күлге айналдырды.
Dialogue: 0,0:17:18.49,0:17:19.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:19.41,0:17:22.75,Default,,0,0,0,,Хехехехе, мен оны сеземін.
Dialogue: 0,0:17:22.83,0:17:27.04,Default,,0,0,0,,Жаратқан Иенің өшпенділігі мен қаһары, қорқыныш пен бас тарту
Dialogue: 0,0:17:28.04,0:17:31.67,Default,,0,0,0,,Қанша жүздеген жылдар өтсе де, сол қасіретті ұмытпаймын.
Dialogue: 0,0:17:31.75,0:17:35.55,Default,,0,0,0,,Мен қорғаған адамдардың сатқындығы
Dialogue: 0,0:17:35.63,0:17:38.05,Default,,0,0,0,,Менсінбеушілік пен үрейлі көзқарастар
Dialogue: 0,0:17:38.14,0:17:41.51,Default,,0,0,0,,Менің серіктерім, достарым, әкем мен шешем өлтірілді.
Dialogue: 0,0:17:41.60,0:17:44.93,Default,,0,0,0,,Мәйіттен қорлық көру
Dialogue: 0,0:17:45.02,0:17:46.52,Default,,0,0,0,,Мырза
Dialogue: 0,0:17:46.60,0:17:50.11,Default,,0,0,0,,Ол кезде өте сергітетін болса керек.
Dialogue: 0,0:17:50.19,0:17:54.03,Default,,0,0,0,,Қараңызшы, мен шіркеуді талқандадым.
Dialogue: 0,0:17:54.11,0:17:54.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:54.94,0:17:55.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:54.94,0:17:55.24,Default,,0,0,0,,Сол үлкен қуғын-сүргіннің орталығы да шіркеу болды.
Dialogue: 0,0:17:55.24,0:17:58.82,Default,,0,0,0,,Сол үлкен қуғын-сүргіннің орталығы да шіркеу болды.
Dialogue: 0,0:17:58.91,0:18:01.12,Default,,0,0,0,,Жек көретін жаудың қалай ыдырайтыны
Dialogue: 0,0:18:01.20,0:18:03.87,Default,,0,0,0,,Бұл сөзбен жеткізгісіз ләззат болды, солай емес пе?
Dialogue: 0,0:18:03.95,0:18:07.54,Default,,0,0,0,,Басында мен Хаджиме Нагумоның соңынан еруді ойладым.
Dialogue: 0,0:18:07.62,0:18:11.46,Default,,0,0,0,,Сіз оны қолдануға болады деп ойлағаныңыз үшін емес пе?
Dialogue: 0,0:18:11.54,0:18:15.38,Default,,0,0,0,,Құдай азу тістерін ашса, Хаджиме Нагумо да азу тістерін көрсетеді.
Dialogue: 0,0:18:15.46,0:18:20.05,Default,,0,0,0,,Бұл кек алудың тамаша қадамы болар еді.
Dialogue: 0,0:18:20.14,0:18:22.22,Default,,0,0,0,,Сен солай ойладың емес пе?
Dialogue: 0,0:18:22.30,0:18:23.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:23.76,0:18:28.14,Default,,0,0,0,,Адамдар, деми-адамдар, жындар және құдайлар
Dialogue: 0,0:18:28.23,0:18:30.23,Default,,0,0,0,,Сол кезде бір маңызды нәрсені алып кетіпті...
Dialogue: 0,0:18:30.31,0:18:31.86,Default,,0,0,0,,Мен бәрін жек көремін
Dialogue: 0,0:18:31.94,0:18:36.86,Default,,0,0,0,,Бұл өшпенділік, бұл ашу, Жаратқан Иеге лайық нәрсе.
Dialogue: 0,0:18:36.94,0:18:40.53,Default,,0,0,0,,Иә, кек - ​​Жаратқан Иенің құқығы!
Dialogue: 0,0:18:40.61,0:18:42.49,Default,,0,0,0,,Қолымды ал
Dialogue: 0,0:18:42.57,0:18:46.45,Default,,0,0,0,,Сонда мен кекімді аламын.
Dialogue: 0,0:18:47.33,0:18:51.96,Default,,0,0,0,,Енді менің ар-ұжданым кек тістерімді тұншықтырмайды.
Dialogue: 0,0:18:52.04,0:18:56.30,Default,,0,0,0,,Мен Хаджиме Нагумоға жақсы жол көрсетемін.
Dialogue: 0,0:18:56.38,0:18:58.84,Default,,0,0,0,,Тио-сан, сұрама!
Dialogue: 0,0:18:58.92,0:19:01.22,Default,,0,0,0,,Кәдімгі Тио-санға оралыңыз!
Dialogue: 0,0:19:01.30,0:19:02.26,Default,,0,0,0,,- (Сузу) Ммм - (Рюутаро) А...
Dialogue: 0,0:19:04.35,0:19:07.52,Default,,0,0,0,,Біз өз болмысымыздың мәнін білмейміз.
Dialogue: 0,0:19:07.60,0:19:11.15,Default,,0,0,0,,Бұл дене жануар ма, әлде адам ба?
Dialogue: 0,0:19:11.23,0:19:14.40,Default,,0,0,0,,Дүниедегі барлық нәрсенің мәні болса
Dialogue: 0,0:19:14.48,0:19:16.11,Default,,0,0,0,,Жауап қайда?
Dialogue: 0,0:19:17.07,0:19:18.53,Default,,0,0,0,,Бұл сөздер...
Dialogue: 0,0:19:18.61,0:19:20.70,Default,,0,0,0,,Икусей Шимо жауапсыз
Dialogue: 0,0:19:20.78,0:19:26.45,Default,,0,0,0,,Сонда ғана, адам ма, хайуан ма, жанымызды батыл көтереміз.
Dialogue: 0,0:19:26.54,0:19:28.79,Default,,0,0,0,,Қарғыс атсын... күш...
Dialogue: 0,0:19:28.87,0:19:31.21,Default,,0,0,0,,Ей, ақымақ, бұған не себеп болды!
Dialogue: 0,0:19:31.29,0:19:34.42,Default,,0,0,0,,Айдаһардың көзі Итироның шындығын көреді.
Dialogue: 0,0:19:34.50,0:19:36.63,Default,,0,0,0,,Алдау мен күдікті жеңу
Dialogue: 0,0:19:36.71,0:19:38.13,Default,,0,0,0,,А... айдаһардың тырнақтары темір қабырғаларды кесіп өтті.
Dialogue: 0,0:19:38.13,0:19:39.13,Default,,0,0,0,,Айдаһардың тырнақтары темір қабырғаны кесіп өтті.
Dialogue: 0,0:19:39.13,0:19:39.84,Default,,0,0,0,,Айдаһардың тырнақтары темір қабырғаны кесіп өтті (қоңырау) Уау...
Dialogue: 0,0:19:39.84,0:19:39.92,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:39.92,0:19:40.47,Default,,0,0,0,,Уау... Ұя салған зұлымдықты құрту
Dialogue: 0,0:19:40.47,0:19:41.55,Default,,0,0,0,,Ұя салатын зұлымдықты жою
Dialogue: 0,0:19:41.55,0:19:42.34,Default,,0,0,0,,Ұя салатын зұлымдықты жою (Virtual Image Tio) Уф...
Dialogue: 0,0:19:42.34,0:19:42.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:42.43,0:19:43.80,Default,,0,0,0,,Уф... Айдаһардың азулары өзінің әлсіз тұстарын шайнайды.
Dialogue: 0,0:19:43.80,0:19:45.26,Default,,0,0,0,,Айдаһардың азу тістері сенің әлсіз тұстарыңды шайнайды.
Dialogue: 0,0:19:45.35,0:19:47.89,Default,,0,0,0,,Жек көру мен ашуды жуыңыз
Dialogue: 0,0:19:47.97,0:19:52.19,Default,,0,0,0,,Рен Біз жеңілген кезде біз жай ғана хайуанбыз.
Dialogue: 0,0:19:52.27,0:19:55.81,Default,,0,0,0,,Әйтсе де мен ақылдың қылышын ұстай бергенше
Dialogue: 0,0:19:55.90,0:19:58.23,Default,,0,0,0,,Біз айдаһар адамдармыз!
Dialogue: 0,0:19:58.98,0:20:02.74,Default,,0,0,0,,Мырза, сіз бақылауда болдыңыз ба?
Dialogue: 0,0:20:03.24,0:20:06.07,Default,,0,0,0,,Рахмет, Ұлы лабиринт Ерік.
Dialogue: 0,0:20:06.16,0:20:10.75,Default,,0,0,0,,Тәңірлер заманының құдіретіне қарамастан, мен өз жүрегімді билей алдым.
Dialogue: 0,0:20:10.83,0:20:14.17,Default,,0,0,0,,Ондай жағдайда Құдайға қарсы болса да, жақсы болар еді.
Dialogue: 0,0:20:14.25,0:20:17.34,Default,,0,0,0,,Сіз сот процесінің өзін пайдаландыңыз ба?
Dialogue: 0,0:20:17.84,0:20:20.67,Default,,0,0,0,,Құдайдың азғыруына қарсы тұрамын ба?
Dialogue: 0,0:20:21.17,0:20:23.63,Default,,0,0,0,,Жоқ, бұл бәрі емес.
Dialogue: 0,0:20:23.72,0:20:26.55,Default,,0,0,0,,Құдайды алдай алатыныңды көруге тырыстың ба?
Dialogue: 0,0:20:26.64,0:20:29.47,Default,,0,0,0,,Бұл шын мәнінде мағыналы сынақ болды.
Dialogue: 0,0:20:29.56,0:20:32.35,Default,,0,0,0,,Джагавараваның айтқанында шындық жоқ.
Dialogue: 0,0:20:32.43,0:20:35.98,Default,,0,0,0,,Осындай күшті жағымсыз эмоцияларға қарамастан
Dialogue: 0,0:20:36.06,0:20:39.40,Default,,0,0,0,,Неліктен... Бұл қалай мүмкін?
Dialogue: 0,0:20:39.48,0:20:41.32,Default,,0,0,0,,Мені төмендетпе
Dialogue: 0,0:20:41.40,0:20:43.53,Default,,0,0,0,,Сабан кім деп ойлайсың?
Dialogue: 0,0:20:43.61,0:20:49.28,Default,,0,0,0,,Мақтаншақ айдаһар жарысы, Кларусу тайпасы аяқталды және Тио Кларусу болады!
Dialogue: 0,0:20:50.24,0:20:52.54,Default,,0,0,0,,«Кек азу» – бос сөз
Dialogue: 0,0:20:52.62,0:20:55.79,Default,,0,0,0,,Нағыз күштісі – айдаһардың азуы.
Dialogue: 0,0:20:55.87,0:20:59.29,Default,,0,0,0,,Өзіңіз дәмін татып көріңіз
Dialogue: 0,0:21:07.97,0:21:09.89,Default,,0,0,0,,- (Рютаро/Сузу) Ах... - Кешіріңіз.
Dialogue: 0,0:21:09.97,0:21:14.64,Default,,0,0,0,,Жоспарлағандай болса да, мен сені қатты алаңдаттым.
Dialogue: 0,0:21:14.73,0:21:17.65,Default,,0,0,0,,Бірақ бұл қуаныш мені қуантты.
Dialogue: 0,0:21:17.73,0:21:19.23,Default,,0,0,0,,Алғыс айту
Dialogue: 0,0:21:19.31,0:21:22.32,Default,,0,0,0,,А, жоқ, болды, хехехехе
Dialogue: 0,0:21:22.40,0:21:25.53,Default,,0,0,0,,Әй... Ой... Бұл шектен шыққан.
Dialogue: 0,0:21:25.61,0:21:28.20,Default,,0,0,0,,Бізге қосылдың тек екеуің бе?
Dialogue: 0,0:21:28.28,0:21:31.16,Default,,0,0,0,,Уф... Иә, басқа ешкімді көрген жоқпын.
Dialogue: 0,0:21:31.24,0:21:33.91,Default,,0,0,0,,Менің шеберім болса ғой
Dialogue: 0,0:21:34.00,0:21:36.96,Default,,0,0,0,,Менде аздап қаржылық ой болды.
Dialogue: 0,0:21:37.04,0:21:40.09,Default,,0,0,0,,Сіз мені бірден жазалауыңыз керек еді.
Dialogue: 0,0:21:40.17,0:21:42.88,Default,,0,0,0,,Бұл да ерекше жаза.
Dialogue: 0,0:21:42.96,0:21:44.80,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:21:44.88,0:21:46.93,Default,,0,0,0,,Ааах…
Dialogue: 0,0:21:47.01,0:21:50.26,Default,,0,0,0,,Бұл сен кінәлісің...
Dialogue: 0,0:21:51.01,0:21:56.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:15.89,0:23:20.89,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.99,0:23:40.29,Default,,0,0,0,,Келесі жолы «Алдау вампир ханшайымы мен қате қоян арасындағы үлкен жекпе-жек»
Dialogue: 0,0:23:41.79,0:23:47.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
