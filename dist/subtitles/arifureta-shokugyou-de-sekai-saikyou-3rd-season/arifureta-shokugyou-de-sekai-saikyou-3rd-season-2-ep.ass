Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.50,0:00:07.67,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:00:07.75,0:00:09.55,Default,,0,0,0,,Алкогольдің қалған бөлігін ала аласыз ба?
Dialogue: 0,0:00:09.63,0:00:11.88,Default,,0,0,0,,А... у...
Dialogue: 0,0:00:11.97,0:00:16.68,Default,,0,0,0,,Мен Империяның шынымен жағымсыз жер екенін естідім.
Dialogue: 0,0:00:16.76,0:00:19.18,Default,,0,0,0,,Бұл әскери мемлекет.
Dialogue: 0,0:00:21.52,0:00:22.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:23.81,0:00:25.94,Default,,0,0,0,,Бұл жын нәсілінің шабуылының қалдықтары ма?
Dialogue: 0,0:00:26.73,0:00:28.44,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:00:29.02,0:00:34.03,Default,,0,0,0,,♪～
Dialogue: 0,0:01:53.94,0:01:58.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:04.04,0:02:05.95,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:02:06.62,0:02:08.21,Default,,0,0,0,,Гррр... аааа
Dialogue: 0,0:02:08.29,0:02:09.17,Default,,0,0,0,,Ах
Dialogue: 0,0:02:11.00,0:02:12.67,Default,,0,0,0,,- (Император солдаты) Ху - (Бала) А...
Dialogue: 0,0:02:12.75,0:02:15.30,Default,,0,0,0,,Чит ха~
Dialogue: 0,0:02:16.34,0:02:17.17,Default,,0,0,0,,Ммм
Dialogue: 0,0:02:17.26,0:02:18.51,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:02:19.26,0:02:20.51,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:02:20.59,0:02:22.43,Default,,0,0,0,,Физикалық түрде ондай үстел жоқ.
Dialogue: 0,0:02:22.51,0:02:25.27,Default,,0,0,0,,Қиындыққа мұрнымды қағуға қарсы емеспін.
Dialogue: 0,0:02:25.93,0:02:28.81,Default,,0,0,0,,Бізге қиындық туғызбауыңызды өтінемін.
Dialogue: 0,0:02:28.89,0:02:31.60,Default,,0,0,0,,Шиа-санды жақсы көрсем де.
Dialogue: 0,0:02:31.69,0:02:33.77,Default,,0,0,0,,Осыншама азап шеккен жарты адамдар бізді тастап кете ме?
Dialogue: 0,0:02:34.65,0:02:36.65,Default,,0,0,0,,Ашық нәрсені тыңдама
Dialogue: 0,0:02:36.73,0:02:39.07,Default,,0,0,0,,Шииттердің басқа демиадамдармен бірдей деңгейде болуы мүмкін емес.
Dialogue: 0,0:02:39.15,0:02:40.24,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,0:02:40.32,0:02:42.78,Default,,0,0,0,,Әзірге тек ақпарат жинау.
Dialogue: 0,0:02:42.87,0:02:45.12,Default,,0,0,0,,- (Коуки) Қарғыс атсын... - (Рюутаро) Бұл жиіркенішті әңгіме.
Dialogue: 0,0:02:45.20,0:02:46.33,Default,,0,0,0,,Кеттік, Коуки
Dialogue: 0,0:02:46.41,0:02:48.83,Default,,0,0,0,,Дәл қазір Шиа отбасына басымдық беріңіз.
Dialogue: 0,0:02:48.91,0:02:50.25,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:02:52.04,0:02:53.00,Default,,0,0,0,,Я...
Dialogue: 0,0:02:53.08,0:02:54.50,Default,,0,0,0,,Көптеген қиындықтар бар.
Dialogue: 0,0:02:54.59,0:02:55.42,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:56.34,0:03:00.30,Default,,0,0,0,,Хаха, қарапайым адамдар көп емес.
Dialogue: 0,0:03:00.38,0:03:01.55,Default,,0,0,0,,Бұл ақылға қонымды емес.
Dialogue: 0,0:03:02.05,0:03:05.93,Default,,0,0,0,,Сіз үшін басқаларға қарағанда көбірек байқау қиын.
Dialogue: 0,0:03:06.89,0:03:09.73,Default,,0,0,0,,Мен оны жалғыз қалдыра алмаймын, оның ішінде оның тұлғасы.
Dialogue: 0,0:03:09.81,0:03:11.02,Default,,0,0,0,,Тио мырза
Dialogue: 0,0:03:11.52,0:03:15.48,Default,,0,0,0,,Үлкендерімнің сөзі ретінде маған жеткізсеңіздер болады.
Dialogue: 0,0:03:15.98,0:03:18.99,Default,,0,0,0,,Сіз сәл ықылас танытуыңыз керек.
Dialogue: 0,0:03:19.49,0:03:21.61,Default,,0,0,0,,Қалай болғанда да, келдің.
Dialogue: 0,0:03:21.70,0:03:23.62,Default,,0,0,0,,Сізді бұзатын біреу бар шығар.
Dialogue: 0,0:03:23.70,0:03:24.53,Default,,0,0,0,,А...
Dialogue: 0,0:03:27.12,0:03:27.74,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:03:27.74,0:03:28.58,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:03:27.74,0:03:28.58,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:28.66,0:03:30.50,Default,,0,0,0,,Эй... Уф!
Dialogue: 0,0:03:39.51,0:03:42.59,Default,,0,0,0,,Камералар өте жабайы шабуылға шыққан сияқты.
Dialogue: 0,0:03:42.68,0:03:43.80,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:03:43.89,0:03:47.10,Default,,0,0,0,,Қалада әке мен оның достары туралы қауесеттер болды.
Dialogue: 0,0:03:47.60,0:03:51.52,Default,,0,0,0,,Ақырында оларды қамалға алып кеткен сияқты...
Dialogue: 0,0:03:51.60,0:03:55.36,Default,,0,0,0,,Бұдан былай Юэ екеуміз ақпарат жинаймыз.
Dialogue: 0,0:03:55.44,0:03:58.15,Default,,0,0,0,,үшін? Неге тек екеуің?
Dialogue: 0,0:03:58.23,0:03:59.86,Default,,0,0,0,,Егер бәріміз барсақ...
Dialogue: 0,0:03:59.94,0:04:03.66,Default,,0,0,0,,Ха! Сіз шынымен Юэ-санға жабысқыңыз келе ме?
Dialogue: 0,0:04:03.74,0:04:05.78,Default,,0,0,0,,Жоқ! Солай ма? Хаджиме-кун
Dialogue: 0,0:04:05.87,0:04:07.58,Default,,0,0,0,,Жоқ! Мүлдем жоқ!
Dialogue: 0,0:04:07.66,0:04:09.66,Default,,0,0,0,,Сіз бұл жағдайда не ойлап отырсыз?
Dialogue: 0,0:04:09.74,0:04:12.54,Default,,0,0,0,,Хм, Юэ ғана алдады.
Dialogue: 0,0:04:12.62,0:04:15.50,Default,,0,0,0,,Ұстаз, Варава да соғысқа қатыса ала ма?
Dialogue: 0,0:04:15.58,0:04:16.67,Default,,0,0,0,,Мүмкін, қандай да бір бағдарлама коды шығар
Dialogue: 0,0:04:16.75,0:04:19.67,Default,,0,0,0,,Мынадай жерде не деп айқайлап тұрсың?
Dialogue: 0,0:04:19.75,0:04:20.92,Default,,0,0,0,,​​О?
Dialogue: 0,0:04:21.01,0:04:22.17,Default,,0,0,0,,Сіз сыртқа шығасыз ба?
Dialogue: 0,0:04:22.26,0:04:23.68,Default,,0,0,0,,Жоқ, алмаймын.
Dialogue: 0,0:04:23.76,0:04:25.93,Default,,0,0,0,,Олай болса, бір жерге барғың келе ме?
Dialogue: 0,0:04:26.01,0:04:28.18,Default,,0,0,0,,Жоқ, бұл орналасу мәселесі емес.
Dialogue: 0,0:04:28.26,0:04:31.72,Default,,0,0,0,,Ах... Ши... Шизу Шизу мен не істеуім керек?
Dialogue: 0,0:04:31.81,0:04:34.23,Default,,0,0,0,,Сіздің қасыңызда тамаша әңгіме бар.
Dialogue: 0,0:04:34.31,0:04:38.19,Default,,0,0,0,,Менің ойымша, сіз мұны істеп жатырсыз, бірақ Каори әлі де...?
Dialogue: 0,0:04:38.27,0:04:40.78,Default,,0,0,0,,Қат! Бұл сұмдық!
Dialogue: 0,0:04:41.78,0:04:44.24,Default,,0,0,0,,Балалар, қауіпсіз ойнаңдар.
Dialogue: 0,0:04:44.74,0:04:49.37,Default,,0,0,0,,Менің Юэмен жалғыз қалу себебім, мен араласатын адамға байланысты мен оларды қатты қинауым керек.
Dialogue: 0,0:04:49.95,0:04:52.29,Default,,0,0,0,,Ақыл-ой, балалар мұны істей алмайсыңдар.
Dialogue: 0,0:04:52.37,0:04:53.87,Default,,0,0,0,,Осындай нәрсе...
Dialogue: 0,0:04:53.96,0:04:55.83,Default,,0,0,0,,Олай болса, кейінірек.
Dialogue: 0,0:05:04.42,0:05:08.09,Default,,0,0,0,,Сіз өте көңілді болған сияқтысыз.
Dialogue: 0,0:05:08.18,0:05:11.31,Default,,0,0,0,,Юэ, сен жылтыр көрінесің. Мен үшін не істедің?
Dialogue: 0,0:05:11.39,0:05:13.73,Default,,0,0,0,,Сіз нені түсінбедіңіз?
Dialogue: 0,0:05:13.81,0:05:16.56,Default,,0,0,0,,Юэнің жылтыр болуының себебі ол менің қанымды сорды.
Dialogue: 0,0:05:16.64,0:05:17.48,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:05:17.56,0:05:21.23,Default,,0,0,0,,Сіз шынымен Юэді ұстап тұр деп ойладыңыз ба?
Dialogue: 0,0:05:21.73,0:05:23.48,Default,,0,0,0,,Мен жас кезімде итпін бе?
Dialogue: 0,0:05:23.57,0:05:26.15,Default,,0,0,0,,Бұл тамаша баға емес пе?
Dialogue: 0,0:05:26.24,0:05:28.41,Default,,0,0,0,,-Аха ахахаха... -(Каори) Хэхе...
Dialogue: 0,0:05:28.49,0:05:32.70,Default,,0,0,0,,Жоқ, мен мұны білдім.
Dialogue: 0,0:05:32.79,0:05:33.91,Default,,0,0,0,,Дұрыс? Каори-сан
Dialogue: 0,0:05:34.00,0:05:36.29,Default,,0,0,0,,Ух... иә! Әрине, Шиа.
Dialogue: 0,0:05:36.37,0:05:40.38,Default,,0,0,0,,Жақсы, жақсы. Қалай болғанда да, мен өзім қалаған ақпаратты алдым.
Dialogue: 0,0:05:40.46,0:05:43.59,Default,,0,0,0,,Бүгін түнде Кэм болуы мүмкін жерге еніп өтіңіз.
Dialogue: 0,0:05:44.55,0:05:47.43,Default,,0,0,0,,Мен, Юэ және Шиа ғана еніп кетеді.
Dialogue: 0,0:05:47.93,0:05:52.06,Default,,0,0,0,,Кез келген жағдайда қатысуды блоктау және телепортацияны қолданған дұрыс.
Dialogue: 0,0:05:52.14,0:05:53.10,Default,,0,0,0,,Сәлем Нагумо
Dialogue: 0,0:05:53.18,0:05:54.39,Default,,0,0,0,,Не?
Dialogue: 0,0:05:54.47,0:05:56.81,Default,,0,0,0,,Қазір тым кеш, бірақ Шиа мырзаның отбасы...
Dialogue: 0,0:05:56.89,0:05:58.77,Default,,0,0,0,,Империя басып алса
Dialogue: 0,0:05:58.85,0:06:01.56,Default,,0,0,0,,Мен оны әдеттегідей қайтарып алуым керек емес пе?
Dialogue: 0,0:06:01.65,0:06:05.11,Default,,0,0,0,,Лилия қазір құлыпта, ал мен батырмын.
Dialogue: 0,0:06:05.19,0:06:06.40,Default,,0,0,0,,Сөйлессең бірдеңе болады.
Dialogue: 0,0:06:06.49,0:06:10.70,Default,,0,0,0,,Кам және оның достары елге заңсыз кіріп қана қоймай, император сарбаздарын да өлтірді.
Dialogue: 0,0:06:11.49,0:06:14.83,Default,,0,0,0,,Сіз сұрағаныңыз үшін ол оны сізге мойынсұнып береді деп ойлайсыз ба?
Dialogue: 0,0:06:15.33,0:06:16.70,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:17.29,0:06:20.21,Default,,0,0,0,,Бұл ханшайымның келіссөздеріне де әсер етуі мүмкін.
Dialogue: 0,0:06:20.71,0:06:22.04,Default,,0,0,0,,Егер Хигучи ең кішкентай күдікті қимыл жасаса,
Dialogue: 0,0:06:22.13,0:06:23.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:24.00,0:06:26.38,Default,,0,0,0,,Лилияға не қиындық туғызады...
Dialogue: 0,0:06:26.46,0:06:28.63,Default,,0,0,0,,Әй... Эй Аманогава
Dialogue: 0,0:06:28.72,0:06:29.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:30.01,0:06:32.01,Default,,0,0,0,,Менің сенен бір өтінішім бар.
Dialogue: 0,0:06:32.10,0:06:34.35,Default,,0,0,0,,Не? Нагумо менен жақсылық сұрады ма?
Dialogue: 0,0:06:34.43,0:06:37.35,Default,,0,0,0,,А, жоқ, жақсы.
Dialogue: 0,0:06:37.43,0:06:39.64,Default,,0,0,0,,Мен сенен мұндай қауіпті нәрсе істеуді талап ете алмаймын.
Dialogue: 0,0:06:40.23,0:06:41.40,Default,,0,0,0,,Кешіріңіз, ұмытыңыз.
Dialogue: 0,0:06:41.48,0:06:42.98,Default,,0,0,0,,Тұр! Бір сәт!
Dialogue: 0,0:06:43.06,0:06:45.32,Default,,0,0,0,,Мама... Алдымен маған не істегіңіз келетінін айтыңыз.
Dialogue: 0,0:06:45.40,0:06:48.19,Default,,0,0,0,,Жоқ, еніп кетемін десем де...
Dialogue: 0,0:06:48.28,0:06:50.99,Default,,0,0,0,,Қауіпсіздік өте қатаң.
Dialogue: 0,0:06:51.07,0:06:54.74,Default,,0,0,0,,Сондықтан мен сенен императорлық сарбаздарға қарсы әрекет етуіңді қаладым.
Dialogue: 0,0:06:54.83,0:06:55.99,Default,,0,0,0,,Ян... жұмылдыру?
Dialogue: 0,0:06:56.08,0:07:00.54,Default,,0,0,0,,Мысалы, біреу деми-адамға көмектесемін деген желеумен төбелеске барады.
Dialogue: 0,0:07:00.62,0:07:02.83,Default,,0,0,0,,Император сарбаздарын тарту үшін шығар?
Dialogue: 0,0:07:02.92,0:07:06.05,Default,,0,0,0,,Жасай бер! Жасайық, Нагумо! Ауыстыруды маған қалдырыңыз
Dialogue: 0,0:07:06.13,0:07:08.55,Default,,0,0,0,,Иә, сіз оны қабылдайсыз ба?
Dialogue: 0,0:07:08.63,0:07:10.55,Default,,0,0,0,,Батырдан күткендей, иә.
Dialogue: 0,0:07:10.63,0:07:14.14,Default,,0,0,0,,Жарайды, онда мен саған ынтымақтастығың үшін өтемақы төлеуім керек.
Dialogue: 0,0:07:14.22,0:07:16.47,Default,,0,0,0,,Әділдік сезімі бар ержүрек ұжым
Dialogue: 0,0:07:16.56,0:07:18.72,Default,,0,0,0,,Мен сізге ерекше нәрсе беремін.
Dialogue: 0,0:07:18.81,0:07:20.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:27.61,0:07:28.82,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:28.90,0:07:30.82,Default,,0,0,0,,Көріп отырғаныңыздай, бұл маска.
Dialogue: 0,0:07:30.90,0:07:31.74,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:07:31.82,0:07:33.57,Default,,0,0,0,,Сен неге...
Dialogue: 0,0:07:33.66,0:07:37.29,Default,,0,0,0,,Батыр контекстсіз императорлық астанаға аттанса, жаман болар еді.
Dialogue: 0,0:07:37.37,0:07:38.83,Default,,0,0,0,,Мен өзімнің шынайы болмысымды жасыруым керек.
Dialogue: 0,0:07:38.91,0:07:42.04,Default,,0,0,0,,Ал шынайы болмысыңызды жасыруға келетін болсақ, бұл маска.
Dialogue: 0,0:07:42.12,0:07:43.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:43.08,0:07:46.88,Default,,0,0,0,,Дүние жүзіндегі батырлар бетперде киеді.
Dialogue: 0,0:07:46.96,0:07:49.80,Default,,0,0,0,,Олар түстермен кодталған, сондықтан сіз оларды ажырата аласыз, солай ма?
Dialogue: 0,0:07:49.88,0:07:52.59,Default,,0,0,0,,Жоқ... Кенет осылай талап етсеңіз де...
Dialogue: 0,0:07:52.68,0:07:56.64,Default,,0,0,0,,Мен сендерге көсемнің түсін беремін, қызыл.
Dialogue: 0,0:07:56.72,0:07:58.39,Default,,0,0,0,,Уайымдама, батыр!
Dialogue: 0,0:07:58.47,0:07:59.31,Default,,0,0,0,,Салқын күлкі
Dialogue: 0,0:08:00.31,0:08:01.14,Default,,0,0,0,,Сәлем, Какко...
Dialogue: 0,0:08:01.23,0:08:02.27,Default,,0,0,0,,- Сакагами - (Рютаро) Иә?
Dialogue: 0,0:08:02.35,0:08:05.65,Default,,0,0,0,,Сен көксің. Көк тыныштық пен байсалдылықты білдіреді.
Dialogue: 0,0:08:05.73,0:08:07.02,Default,,0,0,0,,А... ау
Dialogue: 0,0:08:07.11,0:08:09.19,Default,,0,0,0,,Ал Танигучи, сен...
Dialogue: 0,0:08:09.28,0:08:11.82,Default,,0,0,0,,Пи...Менің ойымша бұл қызғылт түсті. Бұл біраз ұят.
Dialogue: 0,0:08:11.90,0:08:13.24,Default,,0,0,0,,Бұл сары.
Dialogue: 0,0:08:13.32,0:08:16.07,Default,,0,0,0,,Сары - көп жағынан жіңішке есімдік.
Dialogue: 0,0:08:17.37,0:08:20.16,Default,,0,0,0,,Нагумо-кун Сузуды жек көре ме?
Dialogue: 0,0:08:20.24,0:08:22.21,Default,,0,0,0,,Соңында, Яэгаши...
Dialogue: 0,0:08:22.29,0:08:24.29,Default,,0,0,0,,Ха... күте тұрыңыз.
Dialogue: 0,0:08:24.37,0:08:27.71,Default,,0,0,0,,Бір ғана қалды, бірақ сене алмайсың, солай ма?
Dialogue: 0,0:08:27.79,0:08:28.67,Default,,0,0,0,,Әрине
Dialogue: 0,0:08:29.25,0:08:32.17,Default,,0,0,0,,Қызғылт сол жақта! Бұл сіздің түсіңіз!
Dialogue: 0,0:08:32.26,0:08:34.34,Default,,0,0,0,,Жоқ! Айтайын дегенім, маскадан басқа...
Dialogue: 0,0:08:34.43,0:08:37.55,Default,,0,0,0,,Шынайы болмысыңызды жасырудың көптеген жолдары бар!
Dialogue: 0,0:08:37.64,0:08:40.31,Default,,0,0,0,,Сіз міндетті түрде ойнайсыз!
Dialogue: 0,0:08:37.64,0:08:40.31,Default,,0,0,0,,(Юэ мен басқалардың жасырын күлкілері)
Dialogue: 0,0:08:40.39,0:08:44.44,Default,,0,0,0,,Тыңдаңыз, егер сіз өзіңіздің шынайы тұлғаңызды жасырғыңыз келсе, көз жеткізіңіз.
Dialogue: 0,0:08:44.52,0:08:46.31,Default,,0,0,0,,Және Яэгаши
Dialogue: 0,0:08:46.40,0:08:48.98,Default,,0,0,0,,Сіз сияқты әдемі сұлулық түрі
Dialogue: 0,0:08:49.07,0:08:51.98,Default,,0,0,0,,Негізі стандарт маған сүйкімді нәрселерді ұнатады.
Dialogue: 0,0:08:52.07,0:08:52.94,Default,,0,0,0,,Иә
Dialogue: 0,0:08:53.03,0:08:55.36,Default,,0,0,0,,Дәлірек айтсам, мен оны Каориден естідім.
Dialogue: 0,0:08:55.45,0:08:58.12,Default,,0,0,0,,Сондықтан мен оны қызғылт етіп жасау үшін барын салдым.
Dialogue: 0,0:08:58.20,0:08:59.12,Default,,0,0,0,,Алғыс айту
Dialogue: 0,0:08:59.20,0:09:01.20,Default,,0,0,0,,Ух... Не деген жоғарыдан төмен қараған.
Dialogue: 0,0:09:01.29,0:09:03.37,Default,,0,0,0,,Мен...Мен сүйкімді нәрселерге аса мән бермеймін...
Dialogue: 0,0:09:03.45,0:09:06.21,Default,,0,0,0,,Дәлірек айтсақ, Каори! Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:06.29,0:09:09.29,Default,,0,0,0,,Эххе, Шидзуку-чан сондай сүйкімді.
Dialogue: 0,0:09:09.38,0:09:11.05,Default,,0,0,0,,Сіздің бөлмеңіз тұлыптарға толы.
Dialogue: 0,0:09:11.13,0:09:11.96,Default,,0,0,0,,Мияу...
Dialogue: 0,0:09:12.05,0:09:15.59,Default,,0,0,0,,Ойлап қарасам, мен де жануарларды жақсы көретінмін.
Dialogue: 0,0:09:15.68,0:09:19.05,Default,,0,0,0,,Әсіресе қоян мен мысық сияқты кішкентай және сүйкімділер.
Dialogue: 0,0:09:19.14,0:09:19.97,Default,,0,0,0,,Няху
Dialogue: 0,0:09:20.05,0:09:21.26,Default,,0,0,0,,Өте көп
Dialogue: 0,0:09:21.35,0:09:25.31,Default,,0,0,0,,Сонымен, Шидзуку-сан, сен үнемі менің қоян құлағыма қарап отырдың.
Dialogue: 0,0:09:25.39,0:09:26.23,Default,,0,0,0,,Уф
Dialogue: 0,0:09:26.31,0:09:28.52,Default,,0,0,0,,Йэгаши Жүр, ал!
Dialogue: 0,0:09:28.60,0:09:30.23,Default,,0,0,0,,Қызғылт түс сіздікі!
Dialogue: 0,0:09:30.31,0:09:32.94,Default,,0,0,0,,Не... бұл қандай ауа?
Dialogue: 0,0:09:30.31,0:09:32.94,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:09:32.94,0:09:33.03,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:09:33.03,0:09:34.15,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:09:33.03,0:09:34.15,Default,,0,0,0,,Мен сізге айтайын
Dialogue: 0,0:09:34.24,0:09:37.86,Default,,0,0,0,,Мен қызғылт түсті ұнатпаймын.
Dialogue: 0,0:09:37.95,0:09:40.07,Default,,0,0,0,,Оны қабылдаудан басқа амалым жоқ.
Dialogue: 0,0:09:40.16,0:09:43.70,Default,,0,0,0,,Мені қате түсінбеңіз, мен бұған риза емеспін.
Dialogue: 0,0:09:43.79,0:09:45.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:46.04,0:09:49.71,Default,,0,0,0,,Егер сіз Шидзуку-сан болсаңыз, қоянның құлағын аздап тигізе аласыз.
Dialogue: 0,0:09:49.79,0:09:50.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:53.80,0:09:56.17,Default,,0,0,0,,Осы уақытқа дейін көсемдер де империя халқына шабуыл жасайды.
Dialogue: 0,0:09:56.26,0:09:58.26,Default,,0,0,0,,Менің ойымша, олар мұның бәрін жасайды.
Dialogue: 0,0:09:58.34,0:10:00.09,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:00.18,0:10:04.72,Default,,0,0,0,,Ей, неге мүмкіндікті пайдаланып, бастықтың жарақатына бәс тікпейміз?
Dialogue: 0,0:10:04.81,0:10:06.39,Default,,0,0,0,,Ха, жақсы
Dialogue: 0,0:10:06.48,0:10:08.89,Default,,0,0,0,,Содан мен қоян құлағымның бәрінен айырылдым.
Dialogue: 0,0:10:08.98,0:10:11.36,Default,,0,0,0,,Ей, сен тым үлкен тесік.
Dialogue: 0,0:10:11.44,0:10:13.40,Default,,0,0,0,,№ Соңғы басшылар —
Dialogue: 0,0:10:13.48,0:10:16.11,Default,,0,0,0,,Өйткені оның сөзі мен іс-әрекеті барған сайын бастыққа ұқсайды.
Dialogue: 0,0:10:16.19,0:10:19.86,Default,,0,0,0,,Ах~ Бастық мені иемденіп алған сияқты.
Dialogue: 0,0:10:19.95,0:10:22.16,Default,,0,0,0,,Егер сіз бастық болсаңыз, ұсталып қалсаңыз да...
Dialogue: 0,0:10:22.24,0:10:25.87,Default,,0,0,0,,Бәрін құртып, кәдімгідей шығатын сияқтысың.
Dialogue: 0,0:10:25.95,0:10:29.25,Default,,0,0,0,,Әй, Тейтоның көздері жасты.
Dialogue: 0,0:10:29.33,0:10:31.17,Default,,0,0,0,,Бастық аяусыз.
Dialogue: 0,0:10:31.25,0:10:32.29,Default,,0,0,0,,Өйткені бұл жын
Dialogue: 0,0:10:32.38,0:10:33.63,Default,,0,0,0,,Жоқ, бұл шайтан.
Dialogue: 0,0:10:33.71,0:10:35.96,Default,,0,0,0,,Ондай жағдайда Жын патшасы сізге көбірек жарасады.
Dialogue: 0,0:10:36.05,0:10:39.09,Default,,0,0,0,,Бұл «сис» балалар өте жақсы жұмыс істейді.
Dialogue: 0,0:10:39.18,0:10:39.68,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:39.68,0:10:40.34,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:39.68,0:10:40.34,Default,,0,0,0,,Арада көп уақыт өтсе де, айтасың ғой, ә?
Dialogue: 0,0:10:40.34,0:10:40.43,Default,,0,0,0,,Көп уақыт өтсе де, айтасың ғой, ә?
Dialogue: 0,0:10:40.43,0:10:41.59,Default,,0,0,0,,Біраз уақыт өтсе де, сен әлі де солай айтып тұрсың ғой, ә?
Dialogue: 0,0:10:40.43,0:10:41.59,Default,,0,0,0,,А...
Dialogue: 0,0:10:41.59,0:10:41.68,Default,,0,0,0,,Арада біраз уақыт өтсе де, айтасың ғой, ә?
Dialogue: 0,0:10:41.68,0:10:42.85,Default,,0,0,0,,Арада біраз уақыт өтсе де, айтасың ғой, ә?
Dialogue: 0,0:10:41.68,0:10:42.85,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:44.14,0:10:47.35,Default,,0,0,0,,Әй, сен неге үндемейсің?
Dialogue: 0,0:10:47.43,0:10:49.39,Default,,0,0,0,,Барлығы жаман
Dialogue: 0,0:10:49.48,0:10:51.81,Default,,0,0,0,,Мен үшін бәрі бар сияқты.
Dialogue: 0,0:10:51.90,0:10:53.77,Default,,0,0,0,,Ақырында, галлюцинация...
Dialogue: 0,0:10:54.27,0:10:54.86,Default,,0,0,0,,(Музика) Ал бұл кім? (Эмма) Кэрол. Оған небәрі бір жаста ғана.
Dialogue: 0,0:10:54.86,0:10:55.69,Default,,0,0,0,,(Музика) Ал бұл кім? (Эмма) Кэрол. Оған небәрі бір жаста ғана.
Dialogue: 0,0:10:54.86,0:10:55.69,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:55.78,0:10:58.19,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:10:58.99,0:11:01.16,Default,,0,0,0,,- (Хаулиа тайпасы) Уа! бастық? -(Хаурия тайпасы) Иә!
Dialogue: 0,0:11:01.24,0:11:02.53,Default,,0,0,0,,Неге Цуки камералар мен тыңшылық құрылғыларға сонша әуес?
Dialogue: 0,0:11:02.62,0:11:04.41,Default,,0,0,0,,Сіз таңқаларлықтай жақсысыз ба?
Dialogue: 0,0:11:05.08,0:11:07.33,Default,,0,0,0,,Бұл өте қорқынышты көрінеді.
Dialogue: 0,0:11:07.41,0:11:09.79,Default,,0,0,0,,Мен алаңдауға ерік-жігерімнен айырылдым.
Dialogue: 0,0:11:09.87,0:11:11.75,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:11:12.25,0:11:14.71,Default,,0,0,0,,Неге... мұндай жерде неге бастық бар?
Dialogue: 0,0:11:14.79,0:11:17.09,Default,,0,0,0,,Толық мәліметтер кейінірек.
Dialogue: 0,0:11:19.72,0:11:20.55,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:21.18,0:11:22.01,Default,,0,0,0,,- (Император солдаты) Уа! - (Император солдаты) Не?
Dialogue: 0,0:11:22.09,0:11:23.76,Default,,0,0,0,,- (Император солдаты) Бұл жаудың шабуылы ма? - (Император солдаты) Не болды?
Dialogue: 0,0:11:23.84,0:11:25.81,Default,,0,0,0,,Қайда? Бұл қайда!
Dialogue: 0,0:11:26.64,0:11:27.47,Default,,0,0,0,,Бұл — радио гимнастика.
Dialogue: 0,0:11:34.98,0:11:36.57,Default,,0,0,0,,Сіз кімсіз? Сіз жігіттер!
Dialogue: 0,0:11:36.65,0:11:39.44,Default,,0,0,0,,Мына ақымақ масканы киме!
Dialogue: 0,0:11:39.53,0:11:40.90,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:11:40.99,0:11:42.99,Default,,0,0,0,,Не? Жоқ, мен сені мазақ етіп тұрған жоқпын...
Dialogue: 0,0:11:43.07,0:11:44.37,Default,,0,0,0,,Қалай қарасаң да, мені мазақ ететін шығарсың!
Dialogue: 0,0:11:44.45,0:11:45.83,Default,,0,0,0,,Әсіресе қызғылт түсті!
Dialogue: 0,0:11:45.91,0:11:46.74,Default,,0,0,0,,Мияу!
Dialogue: 0,0:11:46.83,0:11:49.08,Default,,0,0,0,,Сіз өзіңіздің сүйкімділігіңізге жүгінуге тырысасыз ба?
Dialogue: 0,0:11:49.16,0:11:51.87,Default,,0,0,0,,Немесе... Мен сүйкімділікке жүгінуге тырыспаймын.
Dialogue: 0,0:11:51.96,0:11:53.42,Default,,0,0,0,,Бұл мәжбүр болды...
Dialogue: 0,0:11:53.50,0:11:55.50,Default,,0,0,0,,Бұл менің кінәм емес...
Dialogue: 0,0:11:55.58,0:11:58.46,Default,,0,0,0,,Сәлем! Ұсқынсыз қария болса да...
Dialogue: 0,0:11:58.55,0:12:01.34,Default,,0,0,0,,Сіз Пинкке не айтасыз! Сузу...
Dialogue: 0,0:12:01.42,0:12:03.13,Default,,0,0,0,,Сары шынымен ашулы!
Dialogue: 0,0:12:03.22,0:12:05.43,Default,,0,0,0,,Иә! Шизу... Қызғылт...
Dialogue: 0,0:12:05.51,0:12:07.43,Default,,0,0,0,,Сүйкімді заттарды ұнатудың несі жаман?
Dialogue: 0,0:12:07.51,0:12:11.35,Default,,0,0,0,,Қызғылт қызды бұдан былай ренжітсең, мен, Қызыл, сені кешірмеймін!
Dialogue: 0,0:12:11.43,0:12:14.44,Default,,0,0,0,,А... әзірше мен Маскалы Көкті де кешірмеймін.
Dialogue: 0,0:12:14.52,0:12:15.65,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:12:15.73,0:12:16.61,Default,,0,0,0,,О!
Dialogue: 0,0:12:17.19,0:12:19.11,Default,,0,0,0,,Не? Сол үлпілдек жұдырық!
Dialogue: 0,0:12:19.19,0:12:21.49,Default,,0,0,0,,-Аа... -Әйтеуір, сен император солдатысың!
Dialogue: 0,0:12:21.57,0:12:23.20,Default,,0,0,0,,Жамбасыңызды көбірек салыңыз!
Dialogue: 0,0:12:23.28,0:12:26.24,Default,,0,0,0,,Сен тек «бип» жасай алатын «бип» бейбақ!
Dialogue: 0,0:12:26.32,0:12:29.33,Default,,0,0,0,,Бұл дыбыстық сигнал сияқты!
Dialogue: 0,0:12:29.41,0:12:32.00,Default,,0,0,0,,Көңілің қалса, тым болмаса бір сүйегіңді сындыр!
Dialogue: 0,0:12:32.08,0:12:33.66,Default,,0,0,0,,Ух... өте шулы!
Dialogue: 0,0:12:33.75,0:12:36.25,Default,,0,0,0,,Неге маған бұлай айтуың керек?
Dialogue: 0,0:12:36.33,0:12:39.55,Default,,0,0,0,,Аузыңды қимылдатып үлгерсең, қолыңды қимылда!
Dialogue: 0,0:12:39.63,0:12:42.84,Default,,0,0,0,,Сіздің қолдарыңыз ғашық па, әлде тек «Пи» ғана істей алатын нәрсе ме?
Dialogue: 0,0:12:42.92,0:12:44.59,Default,,0,0,0,,-Қосулы ма? - (Жауап алушы) Мен!
Dialogue: 0,0:12:45.51,0:12:47.72,Default,,0,0,0,,Иә... Иә! Бұл жақсы емес!
Dialogue: 0,0:12:47.80,0:12:49.18,Default,,0,0,0,,Бұл жігіт өледі!
Dialogue: 0,0:12:49.26,0:12:51.52,Default,,0,0,0,,Сіз де «Р»сыз ба?
Dialogue: 0,0:12:51.60,0:12:54.44,Default,,0,0,0,,Оларды тізбе, ең болмағанда бір кісі өлтіру ниетін көрсет!
Dialogue: 0,0:12:54.52,0:12:55.60,Default,,0,0,0,,Жігіттер, «сийіп жатырсыңдар»!
Dialogue: 0,0:12:55.69,0:12:58.02,Default,,0,0,0,,Мына жігіт... Мынау не деген жігіт?
Dialogue: 0,0:12:58.11,0:13:01.98,Default,,0,0,0,,Маған да ұнамайды! Менің басым жынды болып барады!
Dialogue: 0,0:13:02.07,0:13:04.28,Default,,0,0,0,,Эй, маған көмектесу керек пе?
Dialogue: 0,0:13:04.36,0:13:05.28,Default,,0,0,0,,Үйге барасыз ба?
Dialogue: 0,0:13:05.36,0:13:09.12,Default,,0,0,0,,Жоқ, кешіріңіз, бірақ маған көмектесіңізші.
Dialogue: 0,0:13:09.20,0:13:11.83,Default,,0,0,0,,Бұл тұңғиық қараңғы аңшы жын-шайтан
Dialogue: 0,0:13:11.91,0:13:14.83,Default,,0,0,0,,Кармбантис Эльфарит Родерия Хаурия
Dialogue: 0,0:13:14.91,0:13:19.04,Default,,0,0,0,,Онымен күресуге әлі ерте сияқты!
Dialogue: 0,0:13:19.13,0:13:23.21,Default,,0,0,0,,Шиа, сенің әкеңмен таңғаларлық жағдай болып жатыр.
Dialogue: 0,0:13:19.13,0:13:23.21,Default,,0,0,0,,Әйтеуір, Лорд Тенген бізге жеуді айтып тұр.
Dialogue: 0,0:13:23.30,0:13:28.39,Default,,0,0,0,,Уф... әкесі ұяттан қызын өлтірмекші.
Dialogue: 0,0:13:29.01,0:13:31.10,Default,,0,0,0,,Маған енді ұнамайды! Мен үйге бара жатырмын!
Dialogue: 0,0:13:31.18,0:13:32.35,Default,,0,0,0,,Күте тұрыңыз, мен жұмыстамын!
Dialogue: 0,0:13:32.43,0:13:33.27,Default,,0,0,0,,Я...
Dialogue: 0,0:13:34.52,0:13:35.52,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:34.52,0:13:35.52,Default,,0,0,0,,- (Сұраушылар) Арх! -Хмм...
Dialogue: 0,0:13:35.52,0:13:36.60,Default,,0,0,0,,- (Сұраушылар) Арх! -Хмм...
Dialogue: 0,0:13:36.69,0:13:37.94,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:13:39.36,0:13:41.44,Default,,0,0,0,,Маған қамқор болған сен бе? Рақмет…
Dialogue: 0,0:13:41.52,0:13:43.36,Default,,0,0,0,,Бастық...?
Dialogue: 0,0:13:43.44,0:13:45.95,Default,,0,0,0,,А... қалай айтасың?
Dialogue: 0,0:13:46.03,0:13:50.87,Default,,0,0,0,,Міне, тозығы жеткен күйде сонша қорлықты айта алдың.
Dialogue: 0,0:13:50.95,0:13:52.08,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:13:52.58,0:13:55.41,Default,,0,0,0,,Бұл арман емес сияқты.
Dialogue: 0,0:13:55.50,0:13:58.67,Default,,0,0,0,,О, тіпті Юэ-доно мен шиа.
Dialogue: 0,0:13:58.75,0:14:01.79,Default,,0,0,0,,Қалғандарын бірінші жіберді.
Dialogue: 0,0:14:01.88,0:14:03.25,Default,,0,0,0,,Тезірек барайық.
Dialogue: 0,0:14:05.88,0:14:10.80,Default,,0,0,0,,(Гавриандықтардың қуанышты дауыстары)
Dialogue: 0,0:14:10.89,0:14:14.31,Default,,0,0,0,,Гуссууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:14:14.39,0:14:16.81,Default,,0,0,0,,Барлығының қауіпсіз болғанына қуаныштымын.
Dialogue: 0,0:14:16.89,0:14:19.98,Default,,0,0,0,,Рахмет, Хаджиме-сан мен Юэ-сан.
Dialogue: 0,0:14:20.06,0:14:22.57,Default,,0,0,0,,Мен оны уақытында орындағаныма қуаныштымын.
Dialogue: 0,0:14:22.65,0:14:24.44,Default,,0,0,0,,- (Сидзуку) Хмф! -Уау~
Dialogue: 0,0:14:25.94,0:14:27.61,Default,,0,0,0,,Сіз нені айтып тұрсыз, Йэгаши?
Dialogue: 0,0:14:28.49,0:14:32.28,Default,,0,0,0,,Мен жай ғана күйзелістен арылу үшін сізге жақсылық жасауға тырыстым.
Dialogue: 0,0:14:35.24,0:14:38.08,Default,,0,0,0,,Бастық Маған бір сәт болады ма?
Dialogue: 0,0:14:41.33,0:14:43.21,Default,,0,0,0,,Бізді тірідей тұтқынға алды
Dialogue: 0,0:14:43.29,0:14:46.01,Default,,0,0,0,,Одан күнде жауап алынды.
Dialogue: 0,0:14:46.09,0:14:47.97,Default,,0,0,0,,Сіздің негізгі қызығушылықтарыңыз
Dialogue: 0,0:14:48.05,0:14:52.34,Default,,0,0,0,,Хаурия тайпасының кенеттен өзгеруінің себебі және олардағы қару-жарақ көзі
Dialogue: 0,0:14:52.43,0:14:55.97,Default,,0,0,0,,Ал Вербергеннің ниеті қандай?
Dialogue: 0,0:14:56.64,0:14:58.52,Default,,0,0,0,,Мақсатқа тез жетіңіз.
Dialogue: 0,0:14:58.60,0:15:00.31,Default,,0,0,0,,Иә Бастық
Dialogue: 0,0:15:00.39,0:15:01.94,Default,,0,0,0,,Біз және хаурия тайпасы
Dialogue: 0,0:15:02.02,0:15:06.19,Default,,0,0,0,,Жаңа хаурия тайпасы, оның ішінде отбасына жаңадан қабылданғандар,
Dialogue: 0,0:15:07.69,0:15:09.86,Default,,0,0,0,,Империяға соғыс жүргізу
Dialogue: 0,0:15:09.95,0:15:13.12,Default,,0,0,0,,Иә? Ба... өтінемін, ақымақ ештеңе айтпа!
Dialogue: 0,0:15:13.20,0:15:14.95,Default,,0,0,0,,Менен туысқанымды тартып алды деген өшпенділіктен
Dialogue: 0,0:15:15.03,0:15:17.04,Default,,0,0,0,,Сіз енді дұрыс шешім қабылдай алмайсыз ба?
Dialogue: 0,0:15:17.12,0:15:19.16,Default,,0,0,0,,Біздің есі дұрыс! Сөйлесу...
Dialogue: 0,0:15:19.25,0:15:21.37,Default,,0,0,0,,Менің тыңдайтын қоян құлағым жоқ!
Dialogue: 0,0:15:21.46,0:15:23.88,Default,,0,0,0,,Мен сенің өз-өзіңе қол жұмсауға жол бермеймін!
Dialogue: 0,0:15:24.46,0:15:25.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:32.13,0:15:34.55,Default,,0,0,0,,Айқай? Ой жоқ~
Dialogue: 0,0:15:34.64,0:15:37.89,Default,,0,0,0,,Шоко жақсы емес, Хажиме-сан, тоқтат.
Dialogue: 0,0:15:37.97,0:15:41.19,Default,,0,0,0,,Иә, сіз қалай ойлайсыз? Кішкене тынышталдыңыз ба?
Dialogue: 0,0:15:41.27,0:15:43.94,Default,,0,0,0,,Кэмнің әңгімесін тыңдап, мені үрлеп алмаңыз.
Dialogue: 0,0:15:44.02,0:15:45.23,Default,,0,0,0,,Әлі де кеш емес, солай ма?
Dialogue: 0,0:15:45.31,0:15:48.44,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:15:48.53,0:15:50.28,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:15:50.99,0:15:53.95,Default,,0,0,0,,Әке де... Кешіріңіз.
Dialogue: 0,0:15:54.03,0:15:56.87,Default,,0,0,0,,Кам Мен олай ойламаймын...
Dialogue: 0,0:15:56.95,0:16:00.70,Default,,0,0,0,,Сіз мені соғысқа қатысуға шақыру үшін айтқан жоқсыз ба?
Dialogue: 0,0:16:00.79,0:16:03.75,Default,,0,0,0,,Хаха, бұл сенгісіз.
Dialogue: 0,0:16:03.83,0:16:06.25,Default,,0,0,0,,Мен бұл шешімді қабылдай алдым.
Dialogue: 0,0:16:06.34,0:16:08.96,Default,,0,0,0,,Мұның бәрі бастықтың үйреткенінің арқасында.
Dialogue: 0,0:16:09.55,0:16:14.55,Default,,0,0,0,,Сондықтан мен ең болмағанда өз шешімімді білдіргім келді.
Dialogue: 0,0:16:14.64,0:16:15.84,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:15.93,0:16:17.39,Default,,0,0,0,,Сіз мені тыңдайсыз ба?
Dialogue: 0,0:16:17.47,0:16:21.10,Default,,0,0,0,,Сіз бұл шешімді қабылдауға мүмкіндік алдыңыз, себебі сіз менімен дайындалғансыз
Dialogue: 0,0:16:21.18,0:16:23.60,Default,,0,0,0,,Балалар, сіздердің ұқыпсыз әрекет етулеріңіздің себебі неде?
Dialogue: 0,0:16:23.69,0:16:25.44,Default,,0,0,0,,Бұл менде де бар деген сөз.
Dialogue: 0,0:16:25.52,0:16:26.40,Default,,0,0,0,,Және...
Dialogue: 0,0:16:26.48,0:16:27.56,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:27.65,0:16:29.57,Default,,0,0,0,,Жоғарыда айтқанымдай
Dialogue: 0,0:16:29.65,0:16:33.57,Default,,0,0,0,,Біз, қоян халқы, императордың қызығушылығын тудырдық.
Dialogue: 0,0:16:33.65,0:16:36.32,Default,,0,0,0,,Оның да қызығушылығы өте күшті.
Dialogue: 0,0:16:36.41,0:16:39.66,Default,,0,0,0,,Император қоян нәсілін аулауға кіріседі дейсіз бе?
Dialogue: 0,0:16:39.74,0:16:40.79,Default,,0,0,0,,Иә
Dialogue: 0,0:16:40.87,0:16:43.21,Default,,0,0,0,,Император: «Мен сені ұстаймын», - деді.
Dialogue: 0,0:16:43.29,0:16:46.38,Default,,0,0,0,,Әрине, мен оған түкіріп жібердім.
Dialogue: 0,0:16:46.46,0:16:48.04,Default,,0,0,0,,- (Хаулиа тайпасы) О - Шектер
Dialogue: 0,0:16:48.54,0:16:51.71,Default,,0,0,0,,Бірақ соның арқасында маған ұнады.
Dialogue: 0,0:16:52.38,0:16:54.43,Default,,0,0,0,,«Барлық қоян адамдарды ұстаңыз...»
Dialogue: 0,0:16:54.51,0:16:58.35,Default,,0,0,0,,«Оны жаттықтыру қызықты болар еді» және т.б.
Dialogue: 0,0:16:58.43,0:17:00.60,Default,,0,0,0,,Ағаштар теңізіне қайта серуендеу
Dialogue: 0,0:17:00.68,0:17:03.98,Default,,0,0,0,,Келесі жолы олар қояндарға көбірек шабуыл жасауы мүмкін.
Dialogue: 0,0:17:04.06,0:17:05.06,Default,,0,0,0,,Иә
Dialogue: 0,0:17:05.56,0:17:08.23,Default,,0,0,0,,Вербергенде, ол әлі толық қайта салынбаған.
Dialogue: 0,0:17:08.31,0:17:10.48,Default,,0,0,0,,Келесі шабуылға төтеп бере алмау
Dialogue: 0,0:17:10.57,0:17:14.32,Default,,0,0,0,,Империядан жоғалғанның орнына
Dialogue: 0,0:17:14.40,0:17:17.49,Default,,0,0,0,,Усагинкинді тапсыру сұралса...
Dialogue: 0,0:17:18.49,0:17:20.91,Default,,0,0,0,,Егер сіз пассивті әрекет етсеңіз, сіз ештеңе істей алмайсыз
Dialogue: 0,0:17:20.99,0:17:24.33,Default,,0,0,0,,Сөзбе-сөз өз түріңіздің бәрі алынады...?
Dialogue: 0,0:17:24.41,0:17:25.50,Default,,0,0,0,,Мақұлдау
Dialogue: 0,0:17:25.58,0:17:29.59,Default,,0,0,0,,Хаурия тайпасы аман қалса, қиын емес.
Dialogue: 0,0:17:29.67,0:17:31.59,Default,,0,0,0,,Бірақ біз үшін
Dialogue: 0,0:17:31.67,0:17:34.21,Default,,0,0,0,,Басқа Усагындықтардың болашағын бізден тартып алу шыдамсыз.
Dialogue: 0,0:17:34.21,0:17:35.26,Default,,0,0,0,,Басқа Усагындықтардың болашағын бізден тартып алу шыдамсыз.
Dialogue: 0,0:17:34.21,0:17:35.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:35.26,0:17:35.67,Default,,0,0,0,,Басқа Усагиндіктердің болашағын бізден тартып алу шыдамсыз.
Dialogue: 0,0:17:35.76,0:17:37.09,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:37.84,0:17:39.89,Default,,0,0,0,,Мен 100-ге жуық адам бар деп шындап ойладым.
Dialogue: 0,0:17:39.97,0:17:42.68,Default,,0,0,0,,Император армиясымен бәсекеге түсе алмаймын деп ойлайсыз, солай ма?
Dialogue: 0,0:17:42.77,0:17:46.23,Default,,0,0,0,,Әрине, бетпе-бет соқтығыс болмайды.
Dialogue: 0,0:17:46.31,0:17:47.81,Default,,0,0,0,,Біз қоян халықпыз
Dialogue: 0,0:17:47.90,0:17:51.32,Default,,0,0,0,,Мен белгілерді өңдеуге келгенде ешқандай жарысты жеңе алмаймын.
Dialogue: 0,0:17:53.44,0:17:54.65,Default,,0,0,0,,Қастандық?
Dialogue: 0,0:17:55.15,0:17:56.49,Default,,0,0,0,,Мақұлдау
Dialogue: 0,0:17:56.57,0:17:57.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:58.45,0:18:03.24,Default,,0,0,0,,Қалай ойлайсыз, император отбасында өлтірушілерге қарсы шара жоқ па?
Dialogue: 0,0:18:03.33,0:18:06.46,Default,,0,0,0,,Біздің мақсатымыз императорлық отбасы емес.
Dialogue: 0,0:18:06.54,0:18:08.71,Default,,0,0,0,,Айналасындағы адамдар
Dialogue: 0,0:18:09.29,0:18:13.21,Default,,0,0,0,,Усагидзин тайпасы мұны істей алатын нәсіл болған кезде күштерін көрсетеді.
Dialogue: 0,0:18:13.30,0:18:14.92,Default,,0,0,0,,Соңында—
Dialogue: 0,0:18:15.01,0:18:19.26,Default,,0,0,0,,Егер біз оларды бізге араласпау саясатын қабылдауға итермелесек.
Dialogue: 0,0:18:19.34,0:18:20.72,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:18:20.80,0:18:25.18,Default,,0,0,0,,Империя Усагинжинге қарсы кең ауқымды қыру соғысын бастайды ма?
Dialogue: 0,0:18:25.27,0:18:27.60,Default,,0,0,0,,Еңбек үстемдігі жүйесі бойынша
Dialogue: 0,0:18:27.68,0:18:30.98,Default,,0,0,0,,Біз өз күшімізді мойындап, келіссөз үстеліне отыруымыз керек пе?
Dialogue: 0,0:18:31.61,0:18:33.82,Default,,0,0,0,,Бұл өте жаман ставка.
Dialogue: 0,0:18:34.32,0:18:36.74,Default,,0,0,0,,Сонда да, егер сіз мұны жасамасаңыз
Dialogue: 0,0:18:39.82,0:18:43.03,Default,,0,0,0,,Әке... Барлығы...
Dialogue: 0,0:18:44.41,0:18:46.75,Default,,0,0,0,,Шиа, бұл бетті жасама.
Dialogue: 0,0:18:47.25,0:18:50.58,Default,,0,0,0,,Қазір осылай күресе білу, сол ерік-жігерге ие болу
Dialogue: 0,0:18:50.67,0:18:53.59,Default,,0,0,0,,Біз бақытты бола алмас едік
Dialogue: 0,0:18:53.67,0:18:54.50,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:54.59,0:18:57.97,Default,,0,0,0,,Өмір сүру құқығы үшін күрес
Dialogue: 0,0:18:58.47,0:19:00.38,Default,,0,0,0,,Сіз қаншалықты күшті болсаңыз да
Dialogue: 0,0:19:00.47,0:19:03.85,Default,,0,0,0,,Егер сіз қазір сурет салсаңыз, сіз бұрынғыдай жеңіліске ұшырайсыз.
Dialogue: 0,0:19:04.35,0:19:06.64,Default,,0,0,0,,Мұның өзі мүлдем қабылданбайды.
Dialogue: 0,0:19:07.14,0:19:08.35,Default,,0,0,0,,Әке...
Dialogue: 0,0:19:09.39,0:19:11.44,Default,,0,0,0,,Алға қара, Шиа.
Dialogue: 0,0:19:11.52,0:19:13.90,Default,,0,0,0,,Енді бізге қарама
Dialogue: 0,0:19:13.98,0:19:15.86,Default,,0,0,0,,Сіз шешім қабылдаған болуыңыз керек.
Dialogue: 0,0:19:15.94,0:19:18.61,Default,,0,0,0,,Бастықпен бірге сыртқа шығып, алға жылжу.
Dialogue: 0,0:19:18.69,0:19:19.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:19.61,0:19:22.87,Default,,0,0,0,,Осы шешімді алға қарай жалғастырыңыз
Dialogue: 0,0:19:22.95,0:19:24.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:37.63,0:19:38.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:38.88,0:19:39.92,Default,,0,0,0,,Ши
Dialogue: 0,0:19:40.92,0:19:41.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:42.55,0:19:44.09,Default,,0,0,0,,Хаджиме-сан
Dialogue: 0,0:19:44.18,0:19:46.97,Default,,0,0,0,,Мен бұл жағдайда төбелеспеймін.
Dialogue: 0,0:19:47.06,0:19:48.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:48.35,0:19:51.48,Default,,0,0,0,,Иә... бұл дұрыс.
Dialogue: 0,0:19:51.56,0:19:52.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:52.69,0:19:53.90,Default,,0,0,0,,-Эй, міне, -и?
Dialogue: 0,0:19:53.98,0:19:55.31,Default,,0,0,0,,Шаңды шашуға асықпа
Dialogue: 0,0:19:55.40,0:19:56.44,Default,,0,0,0,,Хмм?
Dialogue: 0,0:19:56.52,0:19:59.99,Default,,0,0,0,,Мен ұрыспаймын, бірақ бұл көмектеспеймін дегенді білдірмейді, солай ма?
Dialogue: 0,0:20:00.07,0:20:00.94,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:20:01.03,0:20:01.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:02.07,0:20:06.83,Default,,0,0,0,,Бұл жағдайда хаурия тайпасы өз күшін көрсетуі керек.
Dialogue: 0,0:20:06.91,0:20:10.00,Default,,0,0,0,,Оңай болмайтын жау – Хаурия тайпасы.
Dialogue: 0,0:20:10.08,0:20:11.29,Default,,0,0,0,,Сізді ойландыруы керек
Dialogue: 0,0:20:12.16,0:20:15.38,Default,,0,0,0,,Деми-адамдарды кемсіту бұл дүниеде ақылға қонымды болғандықтан
Dialogue: 0,0:20:15.46,0:20:17.54,Default,,0,0,0,,Мен сенімен соғысып, қорғадым.
Dialogue: 0,0:20:17.63,0:20:22.09,Default,,0,0,0,,Дәл осындай жағдай мен кеткеннен кейін ғана болады.
Dialogue: 0,0:20:23.22,0:20:25.68,Default,,0,0,0,,Ең бастысы, Кэм мен оның достарының еркі бар.
Dialogue: 0,0:20:25.76,0:20:28.56,Default,,0,0,0,,Сол себепті ұрысуға ниетім жоқ.
Dialogue: 0,0:20:28.64,0:20:32.89,Default,,0,0,0,,Бірақ менің генки белгісі осылай көрінеді.
Dialogue: 0,0:20:32.98,0:20:35.60,Default,,0,0,0,,Мен аузымды жауып, кері шегінемін деп ойласаңыз, қателесесіз.
Dialogue: 0,0:20:35.69,0:20:37.56,Default,,0,0,0,,Бірақ... бірақ бастық
Dialogue: 0,0:20:38.07,0:20:39.27,Default,,0,0,0,,Сонда...?
Dialogue: 0,0:20:39.36,0:20:40.28,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:40.78,0:20:43.78,Default,,0,0,0,,Мына жігітті жылататын қандай ақымақ стратегия?
Dialogue: 0,0:20:43.86,0:20:44.95,Default,,0,0,0,,Барлығы қабылданбады.
Dialogue: 0,0:20:45.03,0:20:46.16,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:46.24,0:20:50.49,Default,,0,0,0,,Пышақтарды тікелей императордың мойнына ұстаңыз.
Dialogue: 0,0:20:50.58,0:20:52.83,Default,,0,0,0,,Менің шашымнан ұстап, сүйреңіз
Dialogue: 0,0:20:52.91,0:20:56.92,Default,,0,0,0,,Оның алдына барлық туыстарыңызды, достарыңызды, қол астындағыларды түсіріңіз.
Dialogue: 0,0:20:57.00,0:21:00.42,Default,,0,0,0,,Біз қамалды бағындырдық, көмек келмейді.
Dialogue: 0,0:21:00.50,0:21:03.51,Default,,0,0,0,,Олар империяның бір түнде жойылғанын білсін.
Dialogue: 0,0:21:04.01,0:21:08.51,Default,,0,0,0,,Егер хаурия тайпасын жауға айналдырсақ, бас кесу драмасы басталады.
Dialogue: 0,0:21:08.60,0:21:11.43,Default,,0,0,0,,Империя тарихында мұның дәлелі!
Dialogue: 0,0:21:11.52,0:21:14.35,Default,,0,0,0,,Сіз не деп жауап бересіз?
Dialogue: 0,0:21:14.43,0:21:15.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:15.64,0:21:18.11,Default,,0,0,0,,Са... Мырза, иә, сэр!
Dialogue: 0,0:21:18.19,0:21:20.48,Default,,0,0,0,,Балалар мен сендерді естімеймін!
Dialogue: 0,0:21:20.57,0:21:23.07,Default,,0,0,0,,Соғыс деп қалжыңдайтынсың ғой!
Dialogue: 0,0:21:23.15,0:21:25.49,Default,,0,0,0,,«Р» жинағы ма?
Dialogue: 0,0:21:25.57,0:21:27.20,Default,,0,0,0,,Мырза, жоқ, сэр!
Dialogue: 0,0:21:27.28,0:21:29.74,Default,,0,0,0,,Олай болса дәлелде!
Dialogue: 0,0:21:29.83,0:21:31.95,Default,,0,0,0,,Зако емес, Корольді ойнаңыз!
Dialogue: 0,0:21:32.04,0:21:34.96,Default,,0,0,0,,Гун Хо! Гун хо! Гун хо!
Dialogue: 0,0:21:35.54,0:21:38.00,Default,,0,0,0,,Кісі өлтіру ниеті мен ерік-жігерінің өткір жүзімен
Dialogue: 0,0:21:38.08,0:21:40.46,Default,,0,0,0,,Сіздің жолыңызға түскендердің бәрін кесіңіз!
Dialogue: 0,0:21:40.54,0:21:43.46,Default,,0,0,0,,Басыңды кес! Басын кес! Басын кес!
Dialogue: 0,0:21:43.55,0:21:45.38,Default,,0,0,0,,Сіз басты кейіпкерсіз!
Dialogue: 0,0:21:45.47,0:21:48.72,Default,,0,0,0,,Ұйымдастырушы мен болғанша, мен ешқандай заң бұзушылыққа жол бермеймін!
Dialogue: 0,0:21:48.80,0:21:50.39,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:21:50.47,0:21:53.39,Default,,0,0,0,,Иә, иә, сэр!
Dialogue: 0,0:21:53.47,0:21:56.18,Default,,0,0,0,,Жарайды, көңіл-күйлеріңді көтеріңдер.
Dialogue: 0,0:21:56.27,0:21:58.31,Default,,0,0,0,,122 адамы бар жаңа хаурия тайпасы
Dialogue: 0,0:21:59.15,0:22:00.69,Default,,0,0,0,,Мен императорлық қамалды құлатамын!
Dialogue: 0,0:22:00.77,0:22:03.98,Default,,0,0,0,,ЯХ!
Dialogue: 0,0:22:04.07,0:22:09.07,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.99,0:23:33.99,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.03,0:23:38.87,Default,,0,0,0,,Келесі жолы «Ханшайымның құмарлығы»
Dialogue: 0,0:23:40.37,0:23:46.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
