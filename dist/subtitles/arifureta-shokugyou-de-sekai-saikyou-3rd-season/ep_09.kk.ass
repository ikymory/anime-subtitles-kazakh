Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.66,0:00:03.58,Default,,0,0,0,,Солардың бірі
Dialogue: 0,0:00:03.67,0:00:06.71,Default,,0,0,0,,Саған берейік
Dialogue: 0,0:00:07.59,0:00:08.46,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:08.55,0:00:12.09,Default,,0,0,0,,«Трансценденттік компасы» деп аталады
Dialogue: 0,0:00:12.67,0:00:14.72,Default,,0,0,0,,Қатысқан ұғым
Dialogue: 0,0:00:14.80,0:00:17.72,Default,,0,0,0,,«қажетті орынды көрсетіңіз»
Dialogue: 0,0:00:17.80,0:00:18.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:18.93,0:00:23.39,Default,,0,0,0,,Қаласаң, сені сонда жетелейді.
Dialogue: 0,0:00:23.48,0:00:25.69,Default,,0,0,0,,Тіпті іздеуші орналасқан жер
Dialogue: 0,0:00:25.77,0:00:28.61,Default,,0,0,0,,Бірдеңе жасырын болса да
Dialogue: 0,0:00:29.19,0:00:30.78,Default,,0,0,0,,T: Бүгін айтатын сөздерім осы ғана.
Dialogue: 0,0:00:30.86,0:00:32.99,Default,,0,0,0,,Тіпті басқа әлемде де
Dialogue: 0,0:00:33.07,0:00:34.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:37.03,0:00:42.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:01.91,0:02:06.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:17.22,0:02:20.55,Default,,0,0,0,,Басқа… әлем…
Dialogue: 0,0:02:25.81,0:02:29.02,Default,,0,0,0,,Құдайдың барлық дәуірінің сиқырына ие болыңыз
Dialogue: 0,0:02:29.10,0:02:31.94,Default,,0,0,0,,Белгілі бір ерік болса
Dialogue: 0,0:02:32.02,0:02:35.36,Default,,0,0,0,,Сіз кез келген жерге бара аласыз.
Dialogue: 0,0:02:35.44,0:02:40.78,Default,,0,0,0,,Болашағыңды өз еркіңмен таңдай бер.
Dialogue: 0,0:02:40.86,0:02:46.20,Default,,0,0,0,,Сіздің жолыңызда сәттілік
Dialogue: 0,0:02:46.29,0:02:48.87,Default,,0,0,0,,Мен сен үшін шын жүректен дұға етемін.
Dialogue: 0,0:02:57.26,0:02:58.63,Default,,0,0,0,,-Юе -Ах...
Dialogue: 0,0:02:58.72,0:03:00.18,Default,,0,0,0,,Мен сенімді болу үшін сұраймын.
Dialogue: 0,0:03:00.26,0:03:03.97,Default,,0,0,0,,Егер сіз сублимациялық сиқырды қолдансаңыз, ғарыштық сиқырмен әлемді кесіп өте аласыз ба?
Dialogue: 0,0:03:04.47,0:03:06.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:06.14,0:03:08.52,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:03:08.60,0:03:10.52,Default,,0,0,0,,Мен бұл жақсы идея деп ойладым.
Dialogue: 0,0:03:10.60,0:03:12.85,Default,,0,0,0,,Құдайдың тағы бір сиқырлы дәуірі қажет
Dialogue: 0,0:03:12.94,0:03:15.44,Default,,0,0,0,,Тек оны алу керек.
Dialogue: 0,0:03:15.52,0:03:16.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:17.07,0:03:18.78,Default,,0,0,0,,Қандай болса да
Dialogue: 0,0:03:18.86,0:03:20.99,Default,,0,0,0,,Юэге ондай бет жасаудың қажеті жоқ.
Dialogue: 0,0:03:21.07,0:03:21.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:24.74,0:03:25.58,Default,,0,0,0,,Юе?
Dialogue: 0,0:03:25.66,0:03:27.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:27.74,0:03:29.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:31.29,0:03:33.25,Default,,0,0,0,,Эй... Эй Нагумо
Dialogue: 0,0:03:34.38,0:03:36.00,Default,,0,0,0,,Бұрынғы оқиға...
Dialogue: 0,0:03:36.71,0:03:40.26,Default,,0,0,0,,Егер сіз сол тұжырымдамалық сиқырды пайдалана алсаңыз...
Dialogue: 0,0:03:40.34,0:03:42.80,Default,,0,0,0,,А, мен үйге бара аламын деп ойлаймын.
Dialogue: 0,0:03:42.88,0:03:46.30,Default,,0,0,0,,Кем дегенде компас қайда тасымалдау керектігін айтады.
Dialogue: 0,0:03:46.39,0:03:49.14,Default,,0,0,0,,А... Түсіндім... Хм...
Dialogue: 0,0:03:49.22,0:03:50.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:51.14,0:03:52.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:53.06,0:03:55.02,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:03:55.10,0:03:59.32,Default,,0,0,0,,Нагумо-кун... ол кетіп бара жатқанда... у...
Dialogue: 0,0:03:59.40,0:04:00.65,Default,,0,0,0,,- Уайымдама - (Сузу) А?
Dialogue: 0,0:04:00.74,0:04:03.11,Default,,0,0,0,,Сыйымдылықты шектеу сияқты кемшіліктер болмаса.
Dialogue: 0,0:04:03.20,0:04:05.37,Default,,0,0,0,,Сол уақытта мен бәрін үйге апарамын.
Dialogue: 0,0:04:05.87,0:04:08.74,Default,,0,0,0,,Түсіндім... Түсіндім. Рахмет, Нагумо-кун.
Dialogue: 0,0:04:08.83,0:04:09.99,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:04:10.08,0:04:13.50,Default,,0,0,0,,Маған осындай сенімсіздікпен осындай сұрақ қойғаның мынаны білдіреді
Dialogue: 0,0:04:13.58,0:04:14.46,Default,,0,0,0,,Балалар сендер жақсы болмадыңдар, солай ма?
Dialogue: 0,0:04:14.54,0:04:15.38,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:16.21,0:04:19.50,Default,,0,0,0,,Йэгаши: Сіз стратегияға рұқсат алған сияқтысыз.
Dialogue: 0,0:04:19.59,0:04:20.88,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:20.96,0:04:22.63,Default,,0,0,0,,Иә, қолдануға болатын сияқты.
Dialogue: 0,0:04:22.72,0:04:24.55,Default,,0,0,0,,Бұл рас па? түсіру
Dialogue: 0,0:04:24.63,0:04:26.64,Default,,0,0,0,,Шынымен! Сіз жасадыңыз!
Dialogue: 0,0:04:26.72,0:04:29.06,Default,,0,0,0,,Шизу Шизу күткендей! Сузудың әйелі!
Dialogue: 0,0:04:29.14,0:04:30.56,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:04:30.64,0:04:33.39,Default,,0,0,0,,Фәрбергенге қайтайық, демалайық.
Dialogue: 0,0:04:33.48,0:04:37.19,Default,,0,0,0,,Менде әлі де шектеуді бұзудың кейбір салдары бар.
Dialogue: 0,0:04:37.27,0:04:39.02,Default,,0,0,0,,Мен Юэден емделгім келеді
Dialogue: 0,0:04:39.11,0:04:41.19,Default,,0,0,0,,Хехе, маған қалдырыңыз
Dialogue: 0,0:04:41.28,0:04:43.28,Default,,0,0,0,,Хажиме-сан! Емдеу туралы айтатын болсақ ...
Dialogue: 0,0:04:43.36,0:04:46.61,Default,,0,0,0,,Міне, мінсіз үлпілдек қоян құлақтары.
Dialogue: 0,0:04:46.70,0:04:50.20,Default,,0,0,0,,Емдеуге келгенде, бұл мен, Хажиме-күн, бұл менің шақыруым!
Dialogue: 0,0:04:50.29,0:04:51.62,Default,,0,0,0,,Мастер
Dialogue: 0,0:04:51.70,0:04:54.29,Default,,0,0,0,,Сабанды орындық ретінде пайдаланып, демалыңыз.
Dialogue: 0,0:04:54.37,0:04:55.33,Default,,0,0,0,,Омыртқам сықырласа да
Dialogue: 0,0:04:55.42,0:04:58.25,Default,,0,0,0,,Ұстазымыз үшін шыдаймыз.
Dialogue: 0,0:05:05.68,0:05:07.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:07.89,0:05:09.22,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:09.30,0:05:12.81,Default,,0,0,0,,Қараңдар, мен үйге бара жатырмын. Мені емдейтініңізге сенімдімін.
Dialogue: 0,0:05:13.85,0:05:16.14,Default,,0,0,0,,Козен есімді бір гуль болды…
Dialogue: 0,0:05:28.87,0:05:29.82,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:29.91,0:05:34.25,Default,,0,0,0,,Мен Каориге неге ғашық болғанымды түсіндім.
Dialogue: 0,0:05:34.33,0:05:35.71,Default,,0,0,0,,Юе…
Dialogue: 0,0:05:36.21,0:05:37.67,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:37.75,0:05:40.04,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:05:48.43,0:05:49.64,Default,,0,0,0,,Кел, Нагумо-доно.
Dialogue: 0,0:05:49.64,0:05:50.68,Default,,0,0,0,,Кел, Нагумо-доно.
Dialogue: 0,0:05:49.64,0:05:50.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:50.68,0:05:50.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:50.76,0:05:51.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:50.76,0:05:51.47,Default,,0,0,0,,Бұдан да рахат алыңыз.
Dialogue: 0,0:05:51.47,0:05:53.22,Default,,0,0,0,,Бұдан да рахат алыңыз.
Dialogue: 0,0:05:54.64,0:05:56.02,Default,,0,0,0,,Жоқ, мені бірден сонша тасымалдаса да...
Dialogue: 0,0:05:56.02,0:05:56.85,Default,,0,0,0,,Жоқ, мені бірден сонша тасымалдаса да...
Dialogue: 0,0:05:56.02,0:05:56.85,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:05:56.85,0:05:57.89,Default,,0,0,0,,Жоқ, мені бірден сонша тасымалдаса да...
Dialogue: 0,0:05:58.39,0:06:00.10,Default,,0,0,0,,Ұстамаңыз.
Dialogue: 0,0:06:00.19,0:06:02.52,Default,,0,0,0,,Иә, Нагумо-доно.
Dialogue: 0,0:06:02.61,0:06:04.86,Default,,0,0,0,,Сәлем! Жабысқақ болмаңыз!
Dialogue: 0,0:06:04.94,0:06:06.82,Default,,0,0,0,,Хаджиме-сан қиыншылыққа ұшырады, солай емес пе?
Dialogue: 0,0:06:07.78,0:06:08.61,Default,,0,0,0,,Уау
Dialogue: 0,0:06:08.70,0:06:09.86,Default,,0,0,0,,Шықыр!
Dialogue: 0,0:06:09.95,0:06:11.24,Default,,0,0,0,,Хамф!
Dialogue: 0,0:06:12.20,0:06:14.37,Default,,0,0,0,,(Шиаттың ауыр тыныс алуы)
Dialogue: 0,0:06:15.75,0:06:16.70,Default,,0,0,0,,Хамф!
Dialogue: 0,0:06:16.79,0:06:17.54,Default,,0,0,0,,(Шапалақ)
Dialogue: 0,0:06:17.54,0:06:17.83,Default,,0,0,0,,(Шапалақ)
Dialogue: 0,0:06:17.54,0:06:17.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:17.83,0:06:19.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:21.00,0:06:23.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:24.30,0:06:25.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:25.71,0:06:27.05,Default,,0,0,0,,Ах... ммм
Dialogue: 0,0:06:27.13,0:06:28.97,Default,,0,0,0,,А... Альтена ханым.
Dialogue: 0,0:06:29.05,0:06:32.30,Default,,0,0,0,,Альфрик ақсақалдың немересі, солай ма?
Dialogue: 0,0:06:32.39,0:06:34.97,Default,,0,0,0,,А... иә, мына орманның ханшайымы...
Dialogue: 0,0:06:35.06,0:06:36.72,Default,,0,0,0,,Шиа осылай деді.
Dialogue: 0,0:06:36.81,0:06:39.60,Default,,0,0,0,,Мм, оның кінәсіз түріне қарамастан.
Dialogue: 0,0:06:39.69,0:06:42.40,Default,,0,0,0,,Бұл өте арандатушы іш киім.
Dialogue: 0,0:06:43.27,0:06:46.32,Default,,0,0,0,,Ханшайымдардың көпшілігі іштей эротикалық.
Dialogue: 0,0:06:46.40,0:06:47.24,Default,,0,0,0,,Әрине
Dialogue: 0,0:06:47.86,0:06:49.65,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:06:49.74,0:06:52.20,Default,,0,0,0,,Позициялық нәрселерге де қатысты...
Dialogue: 0,0:06:49.74,0:06:52.20,Default,,0,0,0,,Ах... уф... уф...
Dialogue: 0,0:06:52.20,0:06:52.28,Default,,0,0,0,,Ах... у... у...
Dialogue: 0,0:06:52.28,0:06:53.45,Default,,0,0,0,,Ах... уф... уф...
Dialogue: 0,0:06:52.28,0:06:53.45,Default,,0,0,0,,Хмм, әдетте солай болар еді...
Dialogue: 0,0:06:53.45,0:06:55.58,Default,,0,0,0,,Хмм, әдетте солай болар еді...
Dialogue: 0,0:06:56.37,0:06:59.08,Default,,0,0,0,,Бірақ Альтенаның өрнекіне қараңызшы.
Dialogue: 0,0:06:59.16,0:07:00.75,Default,,0,0,0,,Не? Ах... иә?
Dialogue: 0,0:07:00.83,0:07:02.67,Default,,0,0,0,,Ол бақытты көрінеді...
Dialogue: 0,0:07:00.83,0:07:02.67,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:07:02.75,0:07:05.34,Default,,0,0,0,,Егер сіз Хаджиме-санға жақындасаңыз...
Dialogue: 0,0:07:05.42,0:07:07.59,Default,,0,0,0,,В... мен сені ұрдым!
Dialogue: 0,0:07:07.67,0:07:11.51,Default,,0,0,0,,Тіпті атам да мені ұрмаған.
Dialogue: 0,0:07:11.59,0:07:12.76,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:13.51,0:07:17.10,Default,,0,0,0,,Бізге нақты не көрсетілді?
Dialogue: 0,0:07:13.51,0:07:17.10,Default,,0,0,0,,Бет жағы~
Dialogue: 0,0:07:17.18,0:07:20.39,Default,,0,0,0,,Тио дос тапқан сияқты.
Dialogue: 0,0:07:17.18,0:07:20.39,Default,,0,0,0,,А~хаха е е е е? Эхе~
Dialogue: 0,0:07:20.39,0:07:20.48,Default,,0,0,0,,А~хаха е е е е? Эхе~
Dialogue: 0,0:07:20.48,0:07:22.35,Default,,0,0,0,,А~хаха е е е е? Эхе~
Dialogue: 0,0:07:20.48,0:07:22.35,Default,,0,0,0,,Мен басқаша ойлағым келеді.
Dialogue: 0,0:07:22.44,0:07:24.36,Default,,0,0,0,,Шиа, оны сонда қалдыр.
Dialogue: 0,0:07:24.44,0:07:27.40,Default,,0,0,0,,Бәсекелестердің саны бірінен соң бірі көбейіп жатса да.
Dialogue: 0,0:07:27.48,0:07:30.78,Default,,0,0,0,,Оның үстіне мен Мориджин тайпасының ханшайымы болудан мүлде бас тартамын!
Dialogue: 0,0:07:30.86,0:07:35.41,Default,,0,0,0,,Оның үстіне, неге екені белгісіз, бұл кісі мені біртүрлі біледі!
Dialogue: 0,0:07:35.49,0:07:36.45,Default,,0,0,0,,Хаджиме
Dialogue: 0,0:07:36.53,0:07:37.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:41.16,0:07:42.87,Default,,0,0,0,,-Уау! -(Сидзуку/Каори) Ах.
Dialogue: 0,0:07:45.04,0:07:46.29,Default,,0,0,0,,Сәлем, Шиа
Dialogue: 0,0:07:46.38,0:07:49.21,Default,,0,0,0,,Қарсыластарыңыз көбейіп жатыр дейсіз...
Dialogue: 0,0:07:49.30,0:07:51.55,Default,,0,0,0,,Дұрыс. Мысалы, Юэ туралы...
Dialogue: 0,0:07:51.63,0:07:53.51,Default,,0,0,0,,Сіз бізді қарсылас деп ойлайсыз ба?
Dialogue: 0,0:07:53.59,0:07:55.43,Default,,0,0,0,,Иә? Сіз Юэсіз бе?
Dialogue: 0,0:07:55.51,0:07:56.97,Default,,0,0,0,,Жоқ, жоқ, мүмкін емес!
Dialogue: 0,0:07:57.05,0:08:01.64,Default,,0,0,0,,Біз алғаш кездескенде жақсы болар еді, бірақ қазір олай ойламаймын.
Dialogue: 0,0:08:01.73,0:08:02.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:04.31,0:08:06.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:07.06,0:08:10.82,Default,,0,0,0,,Сонда сіз енді қарсыластарыңыз туралы алаңдамайсыз.
Dialogue: 0,0:08:11.40,0:08:12.74,Default,,0,0,0,,Шиа мен үшін
Dialogue: 0,0:08:13.61,0:08:15.45,Default,,0,0,0,,Өйткені бұл ерекше болмыс.
Dialogue: 0,0:08:15.53,0:08:16.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:16.74,0:08:18.70,Default,,0,0,0,,Ха... Хажиме-сан
Dialogue: 0,0:08:18.78,0:08:20.33,Default,,0,0,0,,Айтпақшы, шиа
Dialogue: 0,0:08:20.41,0:08:22.46,Default,,0,0,0,,Алтенаға келсек, бұл мен емес...
Dialogue: 0,0:08:22.54,0:08:25.33,Default,,0,0,0,,Керісінше, ол сенімен араласқысы келеді деп ойлаймын.
Dialogue: 0,0:08:25.42,0:08:27.84,Default,,0,0,0,,Айқай? Не... не?
Dialogue: 0,0:08:27.92,0:08:31.38,Default,,0,0,0,,Не, мен? Менен сұраңыз...
Dialogue: 0,0:08:31.46,0:08:33.47,Default,,0,0,0,,Тіпті бұл бір деми-адам болса да
Dialogue: 0,0:08:33.55,0:08:35.84,Default,,0,0,0,,Бұл маған Хаджиме-санның жақындағанын ұнатпайды дегенді білдірмейді...
Dialogue: 0,0:08:35.93,0:08:37.43,Default,,0,0,0,,Ах! Чичи... Бұл дұрыс емес!
Dialogue: 0,0:08:37.51,0:08:40.39,Default,,0,0,0,,Мен Шиа-сан туралы жаман ештеңе ойламаймын.
Dialogue: 0,0:08:40.47,0:08:42.39,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:08:42.48,0:08:44.10,Default,,0,0,0,,Шиа мырзаға тартынбаңыз.
Dialogue: 0,0:08:44.19,0:08:46.69,Default,,0,0,0,,Мен сенің осындай бірдеңе жасағаныңды қалаймын!
Dialogue: 0,0:08:51.03,0:08:52.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:52.53,0:08:54.07,Default,,0,0,0,,-ге... Бұзушылық?
Dialogue: 0,0:08:54.15,0:08:57.62,Default,,0,0,0,,Жоқ... бұл дұрыс емес! Шиа мырза қателеседі.
Dialogue: 0,0:08:57.70,0:09:01.20,Default,,0,0,0,,Мен тек Шиа-санмен тіл табысқым келеді!
Dialogue: 0,0:09:01.29,0:09:02.62,Default,,0,0,0,,Сіз достарды қалайсыз, солай ма?
Dialogue: 0,0:09:02.70,0:09:04.04,Default,,0,0,0,,А... мен?
Dialogue: 0,0:09:05.25,0:09:09.84,Default,,0,0,0,,Ал... Шиа-сан менің жасыма жақын.
Dialogue: 0,0:09:09.92,0:09:13.46,Default,,0,0,0,,Лауазымы жағынан ол орман халқының ханшайымы.
Dialogue: 0,0:09:13.55,0:09:15.88,Default,,0,0,0,,Ол хаурия тайпасының ханшайымы, сондықтан...
Dialogue: 0,0:09:15.97,0:09:20.85,Default,,0,0,0,,Менің тең дәрежедегі достарым жоқ.
Dialogue: 0,0:09:20.93,0:09:23.31,Default,,0,0,0,,Осындай досым бар деп айтуға ұяламын.
Dialogue: 0,0:09:23.39,0:09:26.27,Default,,0,0,0,,Мен оны қалай жасау керектігін білмеймін ...
Dialogue: 0,0:09:26.35,0:09:28.98,Default,,0,0,0,,Шиа-сан Хаджиме-санға жақындағанда,
Dialogue: 0,0:09:29.06,0:09:31.44,Default,,0,0,0,,Мен саған қамқор боламын, сондықтан...
Dialogue: 0,0:09:31.52,0:09:34.32,Default,,0,0,0,,Жоқ, мен ит емеспін, сондықтан мен ит емеспін.
Dialogue: 0,0:09:34.40,0:09:35.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:35.32,0:09:37.11,Default,,0,0,0,,Егер сіз оны әдеттегідей айтсаңыз...
Dialogue: 0,0:09:37.20,0:09:40.24,Default,,0,0,0,,Жоқ... ит... маған ит сияқты қарайды...
Dialogue: 0,0:09:40.32,0:09:42.58,Default,,0,0,0,,Не? Сіз бұған реакция жасайсыз ба?
Dialogue: 0,0:09:44.04,0:09:47.21,Default,,0,0,0,,Олай болса...онда мен сенің менің досым болғаныңды қалаймын.
Dialogue: 0,0:09:47.29,0:09:48.92,Default,,0,0,0,,Жауап бере аласыз ба?
Dialogue: 0,0:09:50.92,0:09:52.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:52.30,0:09:54.26,Default,,0,0,0,,Біреу маған дос болуды өтінді
Dialogue: 0,0:09:54.34,0:09:56.38,Default,,0,0,0,,Бас тартуға негіз жоқ.
Dialogue: 0,0:09:56.47,0:09:57.68,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:58.38,0:09:59.93,Default,,0,0,0,,А... а...
Dialogue: 0,0:10:01.10,0:10:02.10,Default,,0,0,0,,Енді
Dialogue: 0,0:10:02.18,0:10:05.06,Default,,0,0,0,,Менімен көбірек ойнаңызшы!
Dialogue: 0,0:10:05.14,0:10:07.18,Default,,0,0,0,,Ах~аххмм~
Dialogue: 0,0:10:05.14,0:10:07.18,Default,,0,0,0,,Тей! Неліктен ол «мен» болуы керек?
Dialogue: 0,0:10:07.18,0:10:08.48,Default,,0,0,0,,Тей! Неліктен ол «мен» болуы керек?
Dialogue: 0,0:10:08.56,0:10:11.94,Default,,0,0,0,,Ақыр соңында, сен жәй ғана бұзықсың!
Dialogue: 0,0:10:18.20,0:10:21.78,Default,,0,0,0,,Хаджиме-кун, дәл қазір не айтып тұрсың?
Dialogue: 0,0:10:22.33,0:10:25.75,Default,,0,0,0,,Мен мұны біраз уақыттан бері сезінемін.
Dialogue: 0,0:10:25.83,0:10:26.66,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:26.75,0:10:29.33,Default,,0,0,0,,Шиа да «ерекше» болды ма?
Dialogue: 0,0:10:29.42,0:10:31.00,Default,,0,0,0,,Қашан? Неліктен?
Dialogue: 0,0:10:31.08,0:10:32.88,Default,,0,0,0,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:10:33.59,0:10:35.46,Default,,0,0,0,,Мен не айта аламын?
Dialogue: 0,0:10:35.96,0:10:40.22,Default,,0,0,0,,Шамасы, мен әлі де Юэмен бір деңгейде сөйлесе алмаймын.
Dialogue: 0,0:10:40.30,0:10:43.35,Default,,0,0,0,,Десе де оның шиітке деген құштарлығы бар сияқты.
Dialogue: 0,0:10:43.93,0:10:45.85,Default,,0,0,0,,Мен мұны біраз бұрын түсіндім.
Dialogue: 0,0:10:46.35,0:10:48.43,Default,,0,0,0,,Юэнің кеңесімен
Dialogue: 0,0:10:48.52,0:10:51.94,Default,,0,0,0,,Мен шиіттерге тиісті түрде қарауды шештім.
Dialogue: 0,0:10:52.02,0:10:54.82,Default,,0,0,0,,Әсіресе ештеңе болған жоқ.
Dialogue: 0,0:10:54.90,0:10:59.24,Default,,0,0,0,,Сонымен... бұл сіздің шиаға деген романтикалық сезіміңіз бар дегенді білдіре ме?
Dialogue: 0,0:10:59.32,0:11:01.57,Default,,0,0,0,,Шынымды айтсам, мен түсінбеймін
Dialogue: 0,0:11:01.66,0:11:03.37,Default,,0,0,0,,Мен мұны басқаша сезінемін.
Dialogue: 0,0:11:03.99,0:11:06.29,Default,,0,0,0,,Менің ойымша, бұл тәтті.
Dialogue: 0,0:11:12.54,0:11:15.92,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:11:16.96,0:11:17.96,Default,,0,0,0,,Хажиме-кун
Dialogue: 0,0:11:18.05,0:11:19.13,Default,,0,0,0,,Не?
Dialogue: 0,0:11:21.68,0:11:23.30,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:11:23.39,0:11:24.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:24.60,0:11:25.72,Default,,0,0,0,,Иә
Dialogue: 0,0:11:25.81,0:11:30.14,Default,,0,0,0,,Шынымен де, мен үшін босқа кететін адамдар ғана бар.
Dialogue: 0,0:11:30.23,0:11:31.23,Default,,0,0,0,,Иә
Dialogue: 0,0:11:33.10,0:11:37.32,Default,,0,0,0,,Юэ, сіз нені айтып тұрсыз? кана?
Dialogue: 0,0:11:37.40,0:11:38.82,Default,,0,0,0,,Шиа жақсы
Dialogue: 0,0:11:38.90,0:11:41.49,Default,,0,0,0,,Бірақ Каори, мүмкін емес.
Dialogue: 0,0:11:41.57,0:11:43.36,Default,,0,0,0,,Құйрықты бүгіп, үйге қайт
Dialogue: 0,0:11:43.45,0:11:45.41,Default,,0,0,0,,Сондықтан мен сол болашақты өзгерту үшін өткенге ораламын.
Dialogue: 0,0:11:45.49,0:11:47.70,Default,,0,0,0,,Не істеп жатырсың, бейбақ?
Dialogue: 0,0:11:47.79,0:11:50.04,Default,,0,0,0,,Юэдің ақымақ! Мен жасаймын!
Dialogue: 0,0:11:50.12,0:11:52.75,Default,,0,0,0,,Біздің қарым-қатынасымыз жақсы ма, әлде жаман ба?
Dialogue: 0,0:11:52.83,0:11:54.96,Default,,0,0,0,,Сонымен, мырзам.
Dialogue: 0,0:11:55.04,0:11:58.30,Default,,0,0,0,,Шиалардан ақыры жеңілген сияқты.
Dialogue: 0,0:11:58.38,0:12:00.51,Default,,0,0,0,,Ал ше? Мұнда серпінмен жүру -
Dialogue: 0,0:12:00.59,0:12:04.09,Default,,0,0,0,,Сабан киелі таудан биік, су астындағы үйінділерден терең махаббат.
Dialogue: 0,0:12:04.18,0:12:05.85,Default,,0,0,0,,Оны қабылдайсыз ба?
Dialogue: 0,0:12:05.93,0:12:07.89,Default,,0,0,0,,Каори шетке, сен емес.
Dialogue: 0,0:12:08.51,0:12:10.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:10.39,0:12:12.89,Default,,0,0,0,,Не... қандай күшті сөздер!
Dialogue: 0,0:12:12.98,0:12:15.52,Default,,0,0,0,,Құрметті ұстазым!
Dialogue: 0,0:12:15.60,0:12:17.61,Default,,0,0,0,,Ауырсыну нүктелеріне дәл тигізіңіз!
Dialogue: 0,0:12:17.69,0:12:18.69,Default,,0,0,0,,А, мен көмектесе алмаймын!
Dialogue: 0,0:12:18.77,0:12:21.19,Default,,0,0,0,,Сіз шиацу-терапевт массажшысысыз!
Dialogue: 0,0:12:21.28,0:12:22.03,Default,,0,0,0,,Қысым нүктелері! Попопопон!
Dialogue: 0,0:12:22.03,0:12:23.49,Default,,0,0,0,,Қысым нүктелері! Попопопон!
Dialogue: 0,0:12:22.03,0:12:23.49,Default,,0,0,0,,Я...
Dialogue: 0,0:12:34.58,0:12:34.96,Default,,0,0,0,,(Шидің ізі)
Dialogue: 0,0:12:34.96,0:12:35.83,Default,,0,0,0,,(Шидің ізі)
Dialogue: 0,0:12:34.96,0:12:35.83,Default,,0,0,0,,Хаджиме-сан
Dialogue: 0,0:12:35.83,0:12:35.92,Default,,0,0,0,,(Шидің ізі)
Dialogue: 0,0:12:35.92,0:12:36.75,Default,,0,0,0,,(Шидің ізі)
Dialogue: 0,0:12:35.92,0:12:36.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:38.71,0:12:39.67,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:12:39.75,0:12:44.38,Default,,0,0,0,,Сол... Күндізгі айтқаның...
Dialogue: 0,0:12:44.47,0:12:45.59,Default,,0,0,0,,Ши
Dialogue: 0,0:12:47.47,0:12:49.60,Default,,0,0,0,,Дұрыс айттыңыз.
Dialogue: 0,0:12:50.76,0:12:52.60,Default,,0,0,0,,Болашақ белгісіз
Dialogue: 0,0:12:52.68,0:12:55.31,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:12:55.39,0:12:56.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:57.06,0:13:00.40,Default,,0,0,0,,Мен қазір сіздің сезімдеріңізді растамаймын.
Dialogue: 0,0:13:00.98,0:13:02.57,Default,,0,0,0,,Шиа құрметті
Dialogue: 0,0:13:03.24,0:13:04.82,Default,,0,0,0,,Мен оны ешкімге бергім келмейді
Dialogue: 0,0:13:04.90,0:13:06.86,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:13:07.36,0:13:09.03,Default,,0,0,0,,Хаджиме-сан...
Dialogue: 0,0:13:09.58,0:13:12.29,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін, сондықтан дайын бол.
Dialogue: 0,0:13:13.00,0:13:15.21,Default,,0,0,0,,Шиа – менің «ерекше»
Dialogue: 0,0:13:15.29,0:13:17.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:17.25,0:13:18.38,Default,,0,0,0,,Иә
Dialogue: 0,0:13:18.46,0:13:19.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:19.84,0:13:23.38,Default,,0,0,0,,Мен Хаджиме-санның «ерекше» адамымын!
Dialogue: 0,0:13:23.46,0:13:24.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:27.05,0:13:28.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:32.81,0:13:36.19,Default,,0,0,0,,Хэхе! Мына екеуі... сыртта осылай...
Dialogue: 0,0:13:36.27,0:13:38.77,Default,,0,0,0,,Эй... Сузу, сенің дауысың тым қатты!
Dialogue: 0,0:13:38.85,0:13:40.40,Default,,0,0,0,,Шидзуку-чанның мұндай түрі де үлкен.
Dialogue: 0,0:13:40.40,0:13:41.23,Default,,0,0,0,,Шидзуку-чанның мұндай түрі де үлкен.
Dialogue: 0,0:13:40.40,0:13:41.23,Default,,0,0,0,,Ах
Dialogue: 0,0:13:41.32,0:13:43.90,Default,,0,0,0,,Барлығы шулы. Шиаларға кедергі жасама.
Dialogue: 0,0:13:43.98,0:13:44.99,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:13:43.98,0:13:44.99,Default,,0,0,0,,Хм... Мені итерме, ақымақ!
Dialogue: 0,0:13:44.99,0:13:45.61,Default,,0,0,0,,Хм... Мені итерме, ақымақ!
Dialogue: 0,0:13:45.69,0:13:48.36,Default,,0,0,0,,Ахх! Уф...
Dialogue: 0,0:13:45.69,0:13:48.36,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:13:48.45,0:13:49.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:49.74,0:13:52.58,Default,,0,0,0,,Mi… mi mi mi… барлығына! Қашаннан бері сондасың?
Dialogue: 0,0:13:49.74,0:13:52.58,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:13:52.66,0:13:53.95,Default,,0,0,0,,Басынан бастап
Dialogue: 0,0:13:54.04,0:13:55.25,Default,,0,0,0,,Не!
Dialogue: 0,0:13:55.33,0:13:57.50,Default,,0,0,0,,Қараңыз... бәрін...
Dialogue: 0,0:13:57.58,0:13:59.92,Default,,0,0,0,,Маған неге айтпадың!
Dialogue: 0,0:14:00.00,0:14:02.38,Default,,0,0,0,,Бұл жасыратын нәрсе емес.
Dialogue: 0,0:14:02.46,0:14:04.88,Default,,0,0,0,,Бұл дұрыс болуы мүмкін, бірақ...
Dialogue: 0,0:14:04.96,0:14:05.38,Default,,0,0,0,,Сонымен, бұл қалай болды?
Dialogue: 0,0:14:05.38,0:14:06.51,Default,,0,0,0,,Сонымен, бұл қалай болды? Ах
Dialogue: 0,0:14:06.59,0:14:09.30,Default,,0,0,0,,Қожайыныңыздың құмарлығының дәмі
Dialogue: 0,0:14:09.39,0:14:10.51,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:14:10.59,0:14:11.93,Default,,0,0,0,,Иә? Эй, эй, маған айт.
Dialogue: 0,0:14:11.93,0:14:13.43,Default,,0,0,0,,Эй, эй, дауыстап айт.
Dialogue: 0,0:14:13.51,0:14:15.18,Default,,0,0,0,,Шиа-чанның тамаша өнері
Dialogue: 0,0:14:15.27,0:14:18.39,Default,,0,0,0,,Қуанышты және ұят оқиғаларыңыз туралы айтып беріңіз!
Dialogue: 0,0:14:18.48,0:14:19.60,Default,,0,0,0,,Қараңыз...
Dialogue: 0,0:14:19.69,0:14:22.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:22.61,0:14:25.11,Default,,0,0,0,,Өзіңе қамқор бол Дарью
Dialogue: 0,0:14:27.11,0:14:27.99,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:14:28.95,0:14:31.66,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:14:31.74,0:14:35.54,Default,,0,0,0,,Юэ-сан! Уф
Dialogue: 0,0:14:35.62,0:14:39.75,Default,,0,0,0,,Юэ-сан мен ақырында~ Уф...
Dialogue: 0,0:14:39.83,0:14:42.96,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:14:43.04,0:14:45.38,Default,,0,0,0,,Дегенмен, Ол Майт—
Dialogue: 0,0:14:45.46,0:14:47.59,Default,,0,0,0,,Bue~en
Dialogue: 0,0:14:47.67,0:14:50.22,Default,,0,0,0,,Юэ-сан, мен сені жақсы көремін.
Dialogue: 0,0:14:50.30,0:14:53.51,Default,,0,0,0,,Біз мәңгі бірге боламыз~
Dialogue: 0,0:14:53.60,0:14:56.89,Default,,0,0,0,,Сен маған қарағанда Юэге эмоционалды емессің бе?
Dialogue: 0,0:14:53.60,0:14:56.89,Default,,0,0,0,,(шиалардың айқайы)
Dialogue: 0,0:14:56.97,0:15:01.02,Default,,0,0,0,,Тио, келесі біздің кезегіміз. Барымызды салайық.
Dialogue: 0,0:15:01.10,0:15:02.77,Default,,0,0,0,,Хмм, солай емес пе?
Dialogue: 0,0:15:02.86,0:15:06.44,Default,,0,0,0,,Күйеуіңіз сізді белсенді түрде жазалайтын күнді армандау.
Dialogue: 0,0:15:06.53,0:15:07.78,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:15:07.86,0:15:09.99,Default,,0,0,0,,Тербелме, Тио...
Dialogue: 0,0:15:10.49,0:15:12.82,Default,,0,0,0,,Мені қатты азғырмаңыз.
Dialogue: 0,0:15:15.45,0:15:17.16,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:17.95,0:15:21.58,Default,,0,0,0,,Неліктен олардың барлығы тістерін көрсетті?
Dialogue: 0,0:15:21.67,0:15:24.50,Default,,0,0,0,,Кешкі асқа қоңырау шалуға әлі ерте.
Dialogue: 0,0:15:25.29,0:15:27.13,Default,,0,0,0,,Сіздің айналысатын бизнесіңіз болды ма?
Dialogue: 0,0:15:27.21,0:15:29.47,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:15:29.55,0:15:31.88,Default,,0,0,0,,Мен жаңа ғана Юэмен және басқалармен кездейсоқ кездестім.
Dialogue: 0,0:15:32.64,0:15:34.39,Default,,0,0,0,,Біз болсақ...
Dialogue: 0,0:15:35.97,0:15:36.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:42.65,0:15:44.77,Default,,0,0,0,,Нагумо-кун, көрдіңіз бе.
Dialogue: 0,0:15:44.86,0:15:48.69,Default,,0,0,0,,Сузуды келесі үлкен лабиринтке апарыңыз.
Dialogue: 0,0:15:48.78,0:15:50.11,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:15:51.86,0:15:53.36,Default,,0,0,0,,Сузу Бұл...
Dialogue: 0,0:15:53.45,0:15:54.99,Default,,0,0,0,,Коуки-кун, кешіріңіз.
Dialogue: 0,0:15:55.07,0:15:58.79,Default,,0,0,0,,Бұл Сузудің жеке өтініші, сондықтан кедергі жасамаңыз.
Dialogue: 0,0:15:58.87,0:15:59.70,Default,,0,0,0,,Физикалық түрде ондай үстел жоқ.
Dialogue: 0,0:16:00.50,0:16:02.50,Default,,0,0,0,,Неліктен бұл тағы да?
Dialogue: 0,0:16:02.58,0:16:05.67,Default,,0,0,0,,Менімен бірге келмесең де, мен сені Жапонияға қайтарамын.
Dialogue: 0,0:16:05.75,0:16:07.42,Default,,0,0,0,,Күшті болғың келсе де
Dialogue: 0,0:16:07.50,0:16:11.13,Default,,0,0,0,,Егер мен артефактты күшейтсем, бұл үлкен мәселе болмайды.
Dialogue: 0,0:16:11.22,0:16:13.63,Default,,0,0,0,,Иә, бұл рас.
Dialogue: 0,0:16:13.72,0:16:16.14,Default,,0,0,0,,Бірақ Нагумо-кун
Dialogue: 0,0:16:17.22,0:16:19.10,Default,,0,0,0,,Эри туралы
Dialogue: 0,0:16:19.18,0:16:21.85,Default,,0,0,0,,Маған қол ұшын созатын сияқты емес.
Dialogue: 0,0:16:21.93,0:16:24.14,Default,,0,0,0,,Накамура?
Dialogue: 0,0:16:24.23,0:16:25.98,Default,,0,0,0,,Қандай башаламандық
Dialogue: 0,0:16:26.06,0:16:27.86,Default,,0,0,0,,Керісінше, ол сіздің алдыңызда пайда болса
Dialogue: 0,0:16:27.94,0:16:30.86,Default,,0,0,0,,Ойланбастан атып өлтіретінім сонша.
Dialogue: 0,0:16:30.94,0:16:33.78,Default,,0,0,0,,Бұл да Каориді өлтірген факторлардың бірі болды.
Dialogue: 0,0:16:33.86,0:16:35.95,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:16:36.49,0:16:40.41,Default,,0,0,0,,Бірақ Сузу Эримен қайта кездесіп сөйлескісі келеді.
Dialogue: 0,0:16:40.49,0:16:42.45,Default,,0,0,0,,Ол үшін күш керек.
Dialogue: 0,0:16:43.04,0:16:46.75,Default,,0,0,0,,Сондықтан мен тағы да Ұлы лабиринтке қарсы шыққым келеді.
Dialogue: 0,0:16:46.83,0:16:50.38,Default,,0,0,0,,Сонымен, нәтиже қандай болса да, егер сіз тірі шыға алсаңыз.
Dialogue: 0,0:16:50.46,0:16:53.30,Default,,0,0,0,,Мен жын еліне барамын деп ойлаймын.
Dialogue: 0,0:16:53.38,0:16:54.30,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:54.38,0:16:56.26,Default,,0,0,0,,Сузу Бұл...
Dialogue: 0,0:16:58.80,0:17:02.85,Default,,0,0,0,,Жарайды, егер мен Эриді қайтарсам.
Dialogue: 0,0:17:02.93,0:17:05.89,Default,,0,0,0,,Сол кезде мен Эридің Жапонияға менімен бірге оралғанын қалаймын.
Dialogue: 0,0:17:06.48,0:17:08.81,Default,,0,0,0,,Өтінемін! өтінемін!
Dialogue: 0,0:17:14.45,0:17:16.78,Default,,0,0,0,,Нагумо мен де жақсылық сұраймын.
Dialogue: 0,0:17:16.86,0:17:19.03,Default,,0,0,0,,Эридің мақсаты мен
Dialogue: 0,0:17:19.12,0:17:22.70,Default,,0,0,0,,Мен де... Жоқ, мен онымен сөйлесуім керек.
Dialogue: 0,0:17:24.71,0:17:28.38,Default,,0,0,0,,Мен Сузуды жындар еліне Гарландқа жалғыз жібере алмаймын.
Dialogue: 0,0:17:29.38,0:17:31.04,Default,,0,0,0,,Және...
Dialogue: 0,0:17:32.30,0:17:34.51,Default,,0,0,0,,Бұлай аяқталуы мүмкін емес
Dialogue: 0,0:17:35.01,0:17:38.89,Default,,0,0,0,,Тіпті Шидзуку да құдайлардың жасынан сиқырға ие болды, бірақ мен...
Dialogue: 0,0:17:39.85,0:17:42.72,Default,,0,0,0,,Келесі жолы мен міндетті түрде қуат аламын!
Dialogue: 0,0:17:42.81,0:17:44.02,Default,,0,0,0,,Коуки…
Dialogue: 0,0:17:44.68,0:17:48.56,Default,,0,0,0,,Мен Сузуды жалғыз жібере алмаймын.
Dialogue: 0,0:17:49.15,0:17:52.90,Default,,0,0,0,,Егер Эри бір рет атпаса, мен тыныштала алмаймын.
Dialogue: 0,0:17:52.98,0:17:55.49,Default,,0,0,0,,Нагумо: Кешіріңіз, бірақ мен сізден бірдеңе сұрайын.
Dialogue: 0,0:17:55.57,0:17:56.90,Default,,0,0,0,,Көрсетілгендей
Dialogue: 0,0:17:57.70,0:18:00.28,Default,,0,0,0,,Нагумо-кун, бұл...
Dialogue: 0,0:18:00.99,0:18:02.41,Default,,0,0,0,,Маған жақсылық жасай аласыз ба?
Dialogue: 0,0:18:04.41,0:18:05.83,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:11.67,0:18:13.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:14.00,0:18:17.42,Default,,0,0,0,,Накамураны мен әкелген кезде оған қандай да бір дұшпандық болса.
Dialogue: 0,0:18:18.09,0:18:20.39,Default,,0,0,0,,Мен сені сол жерде атып тастаймын.
Dialogue: 0,0:18:21.39,0:18:24.39,Default,,0,0,0,,Нагумо-кун! рақмет сізге!
Dialogue: 0,0:18:26.23,0:18:28.81,Default,,0,0,0,,Тәтті болып қалса, өзімді ұстай аламын ба?
Dialogue: 0,0:18:29.52,0:18:33.15,Default,,0,0,0,,Әлде менің санам босаңсыды деп ойлауым керек пе?
Dialogue: 0,0:18:33.23,0:18:35.07,Default,,0,0,0,,Бұл қиын бөлік.
Dialogue: 0,0:18:35.15,0:18:37.74,Default,,0,0,0,,Тәтті немесе жомарт, екеуі де жақсы.
Dialogue: 0,0:18:37.82,0:18:41.16,Default,,0,0,0,,Қайтадан күшті болудың айырмашылығы жоқ.
Dialogue: 0,0:18:41.24,0:18:43.53,Default,,0,0,0,,Мен Хаджиманы қорғаймын
Dialogue: 0,0:18:43.62,0:18:45.58,Default,,0,0,0,,Хаджиме мені қорғайды
Dialogue: 0,0:18:45.66,0:18:47.62,Default,,0,0,0,,Бұл ең күшті
Dialogue: 0,0:18:48.12,0:18:49.00,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:18:49.58,0:18:50.42,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:50.50,0:18:53.42,Default,,0,0,0,,Олай болса! Мен сонда қосылсам...
Dialogue: 0,0:18:53.50,0:18:55.17,Default,,0,0,0,,Бұл қазірдің өзінде жеңілмейтін.
Dialogue: 0,0:18:55.25,0:18:58.51,Default,,0,0,0,,Өйткені мені Хажиме-сан қабылдады.
Dialogue: 0,0:18:58.59,0:19:00.51,Default,,0,0,0,,Өйткені ол жеңілмейді
Dialogue: 0,0:19:00.59,0:19:02.93,Default,,0,0,0,,Мен... мен де сені қорғаймын!
Dialogue: 0,0:19:03.01,0:19:07.06,Default,,0,0,0,,Жарайды! Қандай жағдай болмасын, мен бәрін талқандаймын
Dialogue: 0,0:19:07.14,0:19:08.56,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:19:08.64,0:19:10.64,Default,,0,0,0,,Мастер мен Юэ және басқалар
Dialogue: 0,0:19:10.73,0:19:13.73,Default,,0,0,0,,Менің қара таразысым барлығын бірге қорғайды.
Dialogue: 0,0:19:14.36,0:19:18.15,Default,,0,0,0,,Хехе, Шиа айтқандай, біз жеңілмейтінбіз.
Dialogue: 0,0:19:18.82,0:19:19.82,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:21.16,0:19:23.78,Default,,0,0,0,,Ұлы лабиринтті аяқтағаннан кейін
Dialogue: 0,0:19:23.87,0:19:25.99,Default,,0,0,0,,Мен барып Мюді алып кетуім керек.
Dialogue: 0,0:19:27.12,0:19:30.29,Default,,0,0,0,,Кешіріңіз, саяхат аяқталып жатқан сияқты...
Dialogue: 0,0:19:30.37,0:19:32.83,Default,,0,0,0,,Ойланатын нәрселер көп
Dialogue: 0,0:19:33.42,0:19:35.71,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:19:36.38,0:19:40.55,Default,,0,0,0,,Өлген патша солдаты мен демигуманның қосындысы болып табылатын өлі жануар сарбазы.
Dialogue: 0,0:19:42.09,0:19:45.89,Default,,0,0,0,,Адамдар мен жындар үшін мүмкін емес физикалық күшке ие болған кезде.
Dialogue: 0,0:19:46.47,0:19:49.52,Default,,0,0,0,,Сиқырды қолдана алатын химер солдат?
Dialogue: 0,0:19:49.60,0:19:51.39,Default,,0,0,0,,Бұл аянышты.
Dialogue: 0,0:19:51.89,0:19:55.23,Default,,0,0,0,,Не? Бостандық, не болды?
Dialogue: 0,0:19:55.31,0:19:57.65,Default,,0,0,0,,Менің нәтижелерімді көруге келдіңіз бе?
Dialogue: 0,0:19:58.73,0:20:01.95,Default,,0,0,0,,Эри Менің түсінігіме араласпа.
Dialogue: 0,0:20:02.03,0:20:04.20,Default,,0,0,0,,Сатқындыққа күдіктенгіңіз келе ме?
Dialogue: 0,0:20:04.28,0:20:07.37,Default,,0,0,0,,Жарайды, бұлай қытырлақ болма.
Dialogue: 0,0:20:07.45,0:20:10.33,Default,,0,0,0,,Мен әлсіз қызбын, солай ма?
Dialogue: 0,0:20:10.83,0:20:12.29,Default,,0,0,0,,Гррр!
Dialogue: 0,0:20:13.08,0:20:16.67,Default,,0,0,0,,Мәйіт жануары Солдат Саған ұнады ма?
Dialogue: 0,0:20:16.75,0:20:19.76,Default,,0,0,0,,Кемелді әскери күш
Dialogue: 0,0:20:19.84,0:20:21.84,Default,,0,0,0,,Бұлай жиіркенішті көрінбе.
Dialogue: 0,0:20:21.92,0:20:24.64,Default,,0,0,0,,Өйткені Фрид маған қол ұшын берді.
Dialogue: 0,0:20:24.72,0:20:27.01,Default,,0,0,0,,Ол сондай жақсы өсті.
Dialogue: 0,0:20:28.51,0:20:30.02,Default,,0,0,0,,Аа, мен бұл туралы ойласам
Dialogue: 0,0:20:30.10,0:20:32.68,Default,,0,0,0,,Бұл балалар өте шулы болды.
Dialogue: 0,0:20:32.77,0:20:35.02,Default,,0,0,0,,Таңертеңнен бері ешкімді көрмедім.
Dialogue: 0,0:20:35.10,0:20:37.44,Default,,0,0,0,,Шақырылған қонақтарды қарсы алды
Dialogue: 0,0:20:37.52,0:20:40.65,Default,,0,0,0,,Біріншіден, негізгіден басқа тұтынушыларға қамқорлық жасаңыз.
Dialogue: 0,0:20:40.73,0:20:42.36,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:42.44,0:20:44.28,Default,,0,0,0,,Олай болса, жақында
Dialogue: 0,0:20:44.36,0:20:47.28,Default,,0,0,0,,Көңілді де көңілді кеш басталғалы тұр.
Dialogue: 0,0:20:47.37,0:20:51.95,Default,,0,0,0,,Әй, мен тағы кездесетін күнді күте алмаймын.
Dialogue: 0,0:20:52.04,0:20:53.21,Default,,0,0,0,,Аха
Dialogue: 0,0:20:53.29,0:20:59.17,Default,,0,0,0,,Ахаха ахахаха…
Dialogue: 0,0:20:59.25,0:21:01.00,Default,,0,0,0,,- (Балалар) Уау! -(Бала) Керемет!
Dialogue: 0,0:21:01.09,0:21:04.05,Default,,0,0,0,,-(Бала) Ахаха -(Бала) Уау! Кяхаха
Dialogue: 0,0:21:04.13,0:21:07.34,Default,,0,0,0,,(Балалардың қошемет көрсетуі және қол шапалақтауы)
Dialogue: 0,0:21:07.43,0:21:08.43,Default,,0,0,0,,Иә
Dialogue: 0,0:21:10.81,0:21:11.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:12.77,0:21:15.60,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:21:17.31,0:21:19.69,Default,,0,0,0,,Бұл ақыры басталды.
Dialogue: 0,0:21:21.32,0:21:23.74,Default,,0,0,0,,Менің де ұзақ сапарым
Dialogue: 0,0:21:24.24,0:21:26.20,Default,,0,0,0,,Менің ойымша, бұл аяқталуға жақын
Dialogue: 0,0:21:26.70,0:21:28.37,Default,,0,0,0,,Миу~!
Dialogue: 0,0:21:28.45,0:21:31.08,Default,,0,0,0,,Түскі ас уақыты келді!
Dialogue: 0,0:21:32.70,0:21:33.91,Default,,0,0,0,,Ахаха
Dialogue: 0,0:21:37.04,0:21:39.84,Default,,0,0,0,,Анашым, түскі асқа не бар?
Dialogue: 0,0:21:39.92,0:21:42.34,Default,,0,0,0,,-Мюудың сүйікті тамағы -Шынымен бе?
Dialogue: 0,0:21:42.42,0:21:43.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:43.34,0:21:44.55,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:21:44.63,0:21:45.88,Default,,0,0,0,,Хмм?
Dialogue: 0,0:21:46.38,0:21:47.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:50.93,0:21:53.52,Default,,0,0,0,,Аспанда біреу бар ма?
Dialogue: 0,0:22:04.03,0:22:09.03,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:33.95,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.99,0:23:39.12,Default,,0,0,0,,Келесі жолы «Соңғы ұлы лабиринт»
Dialogue: 0,0:23:40.62,0:23:46.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
