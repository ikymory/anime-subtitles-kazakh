Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:04.83,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:00:06.17,0:00:06.50,Default,,0,0,0,,(Қақпаның дыбысы шығады)
Dialogue: 0,0:00:06.50,0:00:07.67,Default,,0,0,0,,(Қақпаның дыбысы шығады)
Dialogue: 0,0:00:06.50,0:00:07.67,Default,,0,0,0,,Тым болмаса қыздарды емдеңіз~!
Dialogue: 0,0:00:07.67,0:00:08.75,Default,,0,0,0,,Тым болмаса қыздарды емдеңіз~!
Dialogue: 0,0:00:08.84,0:00:09.67,Default,,0,0,0,,Хмм?
Dialogue: 0,0:00:09.75,0:00:12.26,Default,,0,0,0,,- (Лилиана) Ахх! -(Оқушылар) Ой!
Dialogue: 0,0:00:12.34,0:00:14.88,Default,,0,0,0,,- (Лилиана) Ух... уф... - (Айко) Не ​​болып жатыр?
Dialogue: 0,0:00:14.97,0:00:18.05,Default,,0,0,0,,Лилиана! Жарайды?
Dialogue: 0,0:00:18.14,0:00:20.72,Default,,0,0,0,,Бұл... жарайды.
Dialogue: 0,0:00:20.81,0:00:24.48,Default,,0,0,0,,Орнына келетін ханшайым қандай...
Dialogue: 0,0:00:24.56,0:00:26.23,Default,,0,0,0,,Мм... Лилия
Dialogue: 0,0:00:26.31,0:00:27.94,Default,,0,0,0,,Қалай болғанда да, қош келдіңіз бе?
Dialogue: 0,0:00:28.65,0:00:32.74,Default,,0,0,0,,Ах, Юка-сан және бәрі де.
Dialogue: 0,0:00:32.82,0:00:35.86,Default,,0,0,0,,Лилиана жаңа ғана оралды.
Dialogue: 0,0:00:38.37,0:00:40.04,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:40.12,0:00:42.83,Default,,0,0,0,,Сіз көп қиындық көрген сияқтысыз.
Dialogue: 0,0:00:42.91,0:00:46.79,Default,,0,0,0,,Лили, Нагумо сені тым көп бояуына жол берме, жарай ма?
Dialogue: 0,0:00:46.88,0:00:51.00,Default,,0,0,0,,Сонымен... Нагумо-сан боясын...
Dialogue: 0,0:00:51.09,0:00:53.21,Default,,0,0,0,,Әлі де осындай қарым-қатынаста...
Dialogue: 0,0:00:53.30,0:00:54.34,Default,,0,0,0,,«Әлі жоқ»?
Dialogue: 0,0:00:54.42,0:00:57.14,Default,,0,0,0,,А... жоқ, ерекше ештеңе жоқ.
Dialogue: 0,0:00:57.22,0:00:59.30,Default,,0,0,0,,Ум, Лилиана?
Dialogue: 0,0:00:59.39,0:01:01.43,Default,,0,0,0,,Нагумо-кунмен бірдеңе болды ма?
Dialogue: 0,0:01:01.51,0:01:04.77,Default,,0,0,0,,Жоқ... Сіз нені айтып тұрсыз?
Dialogue: 0,0:01:04.85,0:01:08.10,Default,,0,0,0,,Лилия, сенің үнің бұзылды.
Dialogue: 0,0:01:08.19,0:01:10.48,Default,,0,0,0,,Мені қате түсінбеуіңізді өтінемін.
Dialogue: 0,0:01:10.57,0:01:12.86,Default,,0,0,0,,Шынында да ештеңе жоқ.
Dialogue: 0,0:01:12.94,0:01:16.74,Default,,0,0,0,,Жалпы айтқанда, ол адам маған тым дөрекі.
Dialogue: 0,0:01:16.82,0:01:19.20,Default,,0,0,0,,Жақсы... әрине.
Dialogue: 0,0:01:19.70,0:01:20.28,Default,,0,0,0,,(тұру дыбысы)
Dialogue: 0,0:01:20.28,0:01:21.12,Default,,0,0,0,,(тұру дыбысы)
Dialogue: 0,0:01:20.28,0:01:21.12,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:21.20,0:01:23.33,Default,,0,0,0,,Ол өте қорқынышты адам!
Dialogue: 0,0:01:23.41,0:01:26.58,Default,,0,0,0,,Қиындыққа түсетінімді біле тұра, олар әбігерге сала береді.
Dialogue: 0,0:01:26.66,0:01:28.88,Default,,0,0,0,,Бірақ олар жағдайды түсіндірмейді!
Dialogue: 0,0:01:28.96,0:01:30.00,Default,,0,0,0,,Сабыр ет, Лили.
Dialogue: 0,0:01:30.09,0:01:31.75,Default,,0,0,0,,Сізге шабуыл жасалғалы жатқанда
Dialogue: 0,0:01:31.84,0:01:34.63,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:01:34.71,0:01:38.30,Default,,0,0,0,,Бірақ менің үмітсіз келбетіме қарап отырып,
Dialogue: 0,0:01:38.38,0:01:42.81,Default,,0,0,0,,Нені айтасыз, сізге мән бермеген сияқтысыз ба?
Dialogue: 0,0:01:42.89,0:01:44.27,Default,,0,0,0,,Не? Күте тұрыңыз...
Dialogue: 0,0:01:44.35,0:01:46.48,Default,,0,0,0,,Сонда да? Ауыстырылатын көйлек -
Dialogue: 0,0:01:46.56,0:01:49.60,Default,,0,0,0,,Маған жақсы көрінді десең қуанып қалдым.
Dialogue: 0,0:01:49.69,0:01:52.15,Default,,0,0,0,,Мен сенімен билей алдым.
Dialogue: 0,0:01:52.73,0:01:55.24,Default,,0,0,0,,Бірақ! Бірақ солай!
Dialogue: 0,0:01:55.32,0:01:56.44,Default,,0,0,0,,Неге көмектестіңіз?
Dialogue: 0,0:01:56.53,0:01:59.45,Default,,0,0,0,,«Себебі Каори уайымдайды» дегенді қалай түсінесіз?
Dialogue: 0,0:01:59.53,0:02:01.45,Default,,0,0,0,,Уф… уф…
Dialogue: 0,0:02:01.53,0:02:02.78,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:02:02.87,0:02:04.33,Default,,0,0,0,,Бұл «Лили үшін»
Dialogue: 0,0:02:04.41,0:02:07.04,Default,,0,0,0,,Бұл керемет емес пе!
Dialogue: 0,0:02:08.00,0:02:13.00,Default,,0,0,0,,♪～
Dialogue: 0,0:03:32.92,0:03:37.92,Default,,0,0,0,,～♪
Dialogue: 0,0:03:51.52,0:03:52.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:53.31,0:03:57.94,Default,,0,0,0,,Кэм Біз не болатынын білмейміз, сондықтан хаурилерден аулақ болыңыз.
Dialogue: 0,0:03:58.02,0:04:00.74,Default,,0,0,0,,Түсіндім, бастық, сәттілік.
Dialogue: 0,0:04:00.82,0:04:02.90,Default,,0,0,0,,(Камның ізі)
Dialogue: 0,0:04:11.00,0:04:13.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:13.08,0:04:16.29,Default,,0,0,0,,«Төрт айғақ: Жаңару күші»
Dialogue: 0,0:04:16.38,0:04:18.75,Default,,0,0,0,,«Айырылған облигациялар белгісі»
Dialogue: 0,0:04:18.84,0:04:20.67,Default,,0,0,0,,«үшін бар адамға...»
Dialogue: 0,0:04:20.76,0:04:24.18,Default,,0,0,0,,«Сынақтардың жаңа жолы ашылады...»
Dialogue: 0,0:04:24.26,0:04:26.01,Default,,0,0,0,,Бұрынғыдай.
Dialogue: 0,0:04:26.09,0:04:27.93,Default,,0,0,0,,Пайдаланылған дәлелдер...
Dialogue: 0,0:04:28.51,0:04:30.52,Default,,0,0,0,,Камиямадан басқа жерге баруға бола ма?
Dialogue: 0,0:04:42.53,0:04:44.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:44.61,0:04:47.41,Default,,0,0,0,,Иә? Үлкен ағашта да өрнектер пайда болды.
Dialogue: 0,0:04:47.49,0:04:50.45,Default,,0,0,0,,Хм, келесі регенерацияның күші ше?
Dialogue: 0,0:05:02.38,0:05:04.55,Default,,0,0,0,,А... а...
Dialogue: 0,0:05:10.93,0:05:13.73,Default,,0,0,0,,А... жапырақтар.
Dialogue: 0,0:05:29.87,0:05:30.91,Default,,0,0,0,,...
Dialogue: 0,0:05:39.38,0:05:40.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:43.46,0:05:44.88,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:05:47.47,0:05:48.93,Default,,0,0,0,,Бізге ілесіп жүруді қойып, тезірек кетші!
Dialogue: 0,0:05:49.01,0:05:50.80,Default,,0,0,0,,үшін жақсы ма?
Dialogue: 0,0:05:51.39,0:05:54.72,Default,,0,0,0,,Нагумо Бұл нағыз үлкен лабиринт.
Dialogue: 0,0:05:55.22,0:05:56.98,Default,,0,0,0,,Қай жолмен жүруім керек?
Dialogue: 0,0:05:58.27,0:06:01.06,Default,,0,0,0,,Ха... Әзірше оны іздеу керек шығар.
Dialogue: 0,0:06:01.15,0:06:04.48,Default,,0,0,0,,Түсіндім, мен жетекшілік етемін.
Dialogue: 0,0:06:04.57,0:06:07.49,Default,,0,0,0,,Егер сіз бірдеңе байқасаңыз, маған хабарлаңыз.
Dialogue: 0,0:06:13.83,0:06:14.87,Default,,0,0,0,,Хаджиме-сан? Жоқ...
Dialogue: 0,0:06:14.95,0:06:15.79,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:17.29,0:06:18.12,Default,,0,0,0,,Ммм
Dialogue: 0,0:06:18.21,0:06:19.25,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:06:19.33,0:06:20.67,Default,,0,0,0,,Сіз кенеттен не істеп жатырсыз?
Dialogue: 0,0:06:22.67,0:06:23.75,Default,,0,0,0,,- (Судзу/Каори) Ах... - (Коуки) Нагумо!
Dialogue: 0,0:06:25.42,0:06:27.84,Default,,0,0,0,,Хажиме? Неге...
Dialogue: 0,0:06:28.34,0:06:31.43,Default,,0,0,0,,Тек естігеніңізге жауап беріңіз, жалған.
Dialogue: 0,0:06:31.51,0:06:33.22,Default,,0,0,0,,Ха... Хажиме-кун?
Dialogue: 0,0:06:33.30,0:06:35.89,Default,,0,0,0,,Жоқ... Не істеп жатырсың, Нагумо-кун!
Dialogue: 0,0:06:35.97,0:06:37.85,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:06:37.93,0:06:40.10,Default,,0,0,0,,Нағыз Юэ қайда?
Dialogue: 0,0:06:40.90,0:06:42.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:42.90,0:06:43.98,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:45.86,0:06:47.36,Default,,0,0,0,,Жауап беруді қаламайсыз ба?
Dialogue: 0,0:06:47.44,0:06:51.11,Default,,0,0,0,,Жоқ, жауап беруге мүмкіндігіңіз жоқ...
Dialogue: 0,0:06:51.70,0:06:53.45,Default,,0,0,0,,Олай болса болды, өл.
Dialogue: 0,0:06:54.53,0:06:55.37,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:04.21,0:07:06.92,Default,,0,0,0,,Цк, бұл керемет лабиринт.
Dialogue: 0,0:07:07.00,0:07:08.76,Default,,0,0,0,,Мұны кенеттен орындаңыз
Dialogue: 0,0:07:08.84,0:07:11.68,Default,,0,0,0,,Хажимэ-сан Юэ-сан мен Тио-сан...
Dialogue: 0,0:07:11.76,0:07:15.56,Default,,0,0,0,,Менің ойымша, оны телепортация кезінде басқа жерге жіберген.
Dialogue: 0,0:07:15.64,0:07:18.18,Default,,0,0,0,,Қалай болғанда да, мен түсіндім.
Dialogue: 0,0:07:18.27,0:07:21.23,Default,,0,0,0,,Дұрыс. Сіз қалай білдіңіз?
Dialogue: 0,0:07:21.31,0:07:23.48,Default,,0,0,0,,Не айтсаң да
Dialogue: 0,0:07:23.56,0:07:26.15,Default,,0,0,0,,Менің айтарым, мен оны көргенде-ақ білдім.
Dialogue: 0,0:07:26.23,0:07:29.40,Default,,0,0,0,,Бұл менің алдымдағы адам менің Юэ емес.
Dialogue: 0,0:07:29.49,0:07:31.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:33.82,0:07:35.78,Default,,0,0,0,,(Хане)
Dialogue: 0,0:07:35.87,0:07:36.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:36.87,0:07:37.91,Default,,0,0,0,,Құбыжық!
Dialogue: 0,0:07:37.99,0:07:41.71,Default,,0,0,0,,Нагумо, ұрысамыз, маған тиіспе.
Dialogue: 0,0:07:41.79,0:07:44.21,Default,,0,0,0,,Бұл бірінші матч.
Dialogue: 0,0:07:44.29,0:07:47.21,Default,,0,0,0,,үшінңыз, сақ болыңыздар.
Dialogue: 0,0:07:47.30,0:07:49.55,Default,,0,0,0,,Шидзуку-чан, Сузу-чан, барыңды сал!
Dialogue: 0,0:07:49.63,0:07:51.59,Default,,0,0,0,,(Хане)
Dialogue: 0,0:07:51.59,0:07:53.63,Default,,0,0,0,,(Хане)
Dialogue: 0,0:07:51.59,0:07:53.63,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:07:53.63,0:07:54.43,Default,,0,0,0,,(Хане)
Dialogue: 0,0:07:59.68,0:08:01.06,Default,,0,0,0,,Сәлем! Бұл жиіркенішті!
Dialogue: 0,0:08:01.14,0:08:03.19,Default,,0,0,0,,Қоңырау! Жақсы жаса!
Dialogue: 0,0:08:03.27,0:08:04.15,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:08:04.23,0:08:05.48,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:05.56,0:08:06.40,Default,,0,0,0,,Қоңырау!
Dialogue: 0,0:08:07.90,0:08:09.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:09.40,0:08:10.23,Default,,0,0,0,,Жарық сөнді!
Dialogue: 0,0:08:13.20,0:08:14.99,Default,,0,0,0,,Теншо жарқылы!
Dialogue: 0,0:08:16.20,0:08:17.16,Default,,0,0,0,,Не!
Dialogue: 0,0:08:19.16,0:08:22.66,Default,,0,0,0,,Жарық сөнді! Жарық сөнді! Жарық сөнді!
Dialogue: 0,0:08:23.46,0:08:24.92,Default,,0,0,0,,Уф... шіркін!
Dialogue: 0,0:08:25.00,0:08:27.71,Default,,0,0,0,,Бұл жігіттер жын тұқымынан шыққан жындарға ұқсайды!
Dialogue: 0,0:08:27.79,0:08:30.00,Default,,0,0,0,,Жоқ, керісінше.
Dialogue: 0,0:08:30.09,0:08:33.80,Default,,0,0,0,,Бұл құбыжықтар Ұлы лабиринттегі құбыжықтарға ұқсайды.
Dialogue: 0,0:08:36.72,0:08:39.56,Default,,0,0,0,,Жалтарудың бұған қатысы жоқ... Сонымен!
Dialogue: 0,0:08:45.73,0:08:49.36,Default,,0,0,0,,Хм, мен айла таптым деп ойлаймын.
Dialogue: 0,0:08:49.44,0:08:51.28,Default,,0,0,0,,- (Коуки) Қарғыс атсын... - Аманогава
Dialogue: 0,0:08:51.36,0:08:53.11,Default,,0,0,0,,Жоқ... не?
Dialogue: 0,0:08:53.19,0:08:57.16,Default,,0,0,0,,Әзірге бала кездегі досыңызды табуды ойлаңыз.
Dialogue: 0,0:08:57.74,0:09:00.79,Default,,0,0,0,,Мен мұны айтпай-ақ білемін!
Dialogue: 0,0:09:02.04,0:09:03.33,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:09:04.16,0:09:05.25,Default,,0,0,0,,Гррр…
Dialogue: 0,0:09:05.75,0:09:08.83,Default,,0,0,0,,Жоқ, яғни, ол қайда…
Dialogue: 0,0:09:08.83,0:09:09.75,Default,,0,0,0,,Жоқ, яғни, ол қайда…
Dialogue: 0,0:09:08.83,0:09:09.75,Default,,0,0,0,,(бұтаның сыбдыры)
Dialogue: 0,0:09:09.75,0:09:09.84,Default,,0,0,0,,(бұтаның сыбдыры)
Dialogue: 0,0:09:09.84,0:09:10.67,Default,,0,0,0,,(бұтаның сыбдыры)
Dialogue: 0,0:09:09.84,0:09:10.67,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:11.42,0:09:14.01,Default,,0,0,0,,Енді ше? Не келе жатыр?
Dialogue: 0,0:09:20.43,0:09:21.64,Default,,0,0,0,,Гугя!
Dialogue: 0,0:09:21.72,0:09:23.27,Default,,0,0,0,,Ештеңеге жол берме!
Dialogue: 0,0:09:24.60,0:09:25.77,Default,,0,0,0,,Хааа!
Dialogue: 0,0:09:25.85,0:09:27.14,Default,,0,0,0,,-Кик - (Коуки) Арх!
Dialogue: 0,0:09:29.40,0:09:30.86,Default,,0,0,0,,Сәлем Нагумо-кун!
Dialogue: 0,0:09:30.94,0:09:33.82,Default,,0,0,0,,Коуки құбыжықты жеңуге тырысқан жоқ!
Dialogue: 0,0:09:34.44,0:09:36.53,Default,,0,0,0,,Уф... Нагумо!
Dialogue: 0,0:09:36.61,0:09:38.86,Default,,0,0,0,,Сіз нені айтасыз? Неге...
Dialogue: 0,0:09:38.95,0:09:40.07,Default,,0,0,0,,Құбыжық емес
Dialogue: 0,0:09:40.16,0:09:40.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:47.87,0:09:49.71,Default,,0,0,0,,Хаджиме-сан?
Dialogue: 0,0:09:49.79,0:09:52.13,Default,,0,0,0,,Иә... солай ма?
Dialogue: 0,0:09:52.21,0:09:53.55,Default,,0,0,0,,Гугя!
Dialogue: 0,0:09:53.63,0:09:54.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:54.76,0:09:56.55,Default,,0,0,0,,Гугя! Гугя!
Dialogue: 0,0:09:56.63,0:10:00.18,Default,,0,0,0,,Бұл маған құбыжық сияқты көрінеді...
Dialogue: 0,0:10:00.26,0:10:02.26,Default,,0,0,0,,Бұл шынымен Юэ ме?
Dialogue: 0,0:10:02.35,0:10:04.10,Default,,0,0,0,,Гугя! Гуйя!
Dialogue: 0,0:10:04.18,0:10:06.18,Default,,0,0,0,,Ммм...
Dialogue: 0,0:10:06.27,0:10:09.77,Default,,0,0,0,,Телепортациядан кейін, сіз оны білмей тұрып, сіз сол пішінге айналдыңыз ба?
Dialogue: 0,0:10:09.85,0:10:11.23,Default,,0,0,0,,Гугя!
Dialogue: 0,0:10:11.31,0:10:12.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:12.82,0:10:15.65,Default,,0,0,0,,Сонда дененің өзі өзгерді?
Dialogue: 0,0:10:15.74,0:10:17.78,Default,,0,0,0,,Гугья Гугья~Гяа
Dialogue: 0,0:10:17.86,0:10:20.78,Default,,0,0,0,,Түсіндім, сіз де техникаңызды жоғалтып алдыңыз ба?
Dialogue: 0,0:10:20.87,0:10:22.78,Default,,0,0,0,,Гуу...
Dialogue: 0,0:10:22.87,0:10:24.99,Default,,0,0,0,,Мен сиқырды да қолдана алмаймын
Dialogue: 0,0:10:25.08,0:10:29.08,Default,,0,0,0,,Бірақ сіз бұдан әрі өзгеретіндей сезінбейсіз бе?
Dialogue: 0,0:10:29.17,0:10:30.79,Default,,0,0,0,,Гигджи ​​гаа!
Dialogue: 0,0:10:30.88,0:10:32.92,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:10:33.00,0:10:35.63,Default,,0,0,0,,Бұл сынақтардың бірі шығар.
Dialogue: 0,0:10:35.71,0:10:38.47,Default,,0,0,0,,Әрқашан кері қайту жолы бар
Dialogue: 0,0:10:39.22,0:10:40.89,Default,,0,0,0,,Осымен
Dialogue: 0,0:10:40.97,0:10:42.14,Default,,0,0,0,,Олай болса, Каори.
Dialogue: 0,0:10:42.22,0:10:45.06,Default,,0,0,0,,Әзірге сіз регенерация сиқырын қолданып көре аласыз ба?
Dialogue: 0,0:10:45.64,0:10:46.72,Default,,0,0,0,,Жоқ, күтіңіз, күтіңіз
Dialogue: 0,0:10:46.81,0:10:48.64,Default,,0,0,0,,Жоқ, жоқ, Нагумо-кун
Dialogue: 0,0:10:48.73,0:10:50.39,Default,,0,0,0,,Біз қалай қарым-қатынас жасай аламыз?
Dialogue: 0,0:10:50.48,0:10:52.06,Default,,0,0,0,,Жоқ, ештеңе, ештеңе.
Dialogue: 0,0:10:52.15,0:10:54.98,Default,,0,0,0,,Сол әдемі көздерге қарасаң түсінесің.
Dialogue: 0,0:10:55.07,0:10:56.90,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:10:58.90,0:10:59.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:00.61,0:11:03.24,Default,,0,0,0,,Регенерация сиқыры жұмыс істемейді...
Dialogue: 0,0:11:04.12,0:11:06.16,Default,,0,0,0,,Юэ, мынаны ал.
Dialogue: 0,0:11:06.87,0:11:08.12,Default,,0,0,0,,Гууу?
Dialogue: 0,0:11:08.20,0:11:10.54,Default,,0,0,0,,(Артефакт операциясының дыбысы)
Dialogue: 0,0:11:10.62,0:11:13.58,Default,,0,0,0,,Хаджиме Хаджиме? есту?
Dialogue: 0,0:11:13.67,0:11:15.75,Default,,0,0,0,,О, мен оны естимін.
Dialogue: 0,0:11:15.84,0:11:19.17,Default,,0,0,0,,Хмм, мен Хаджиме байқайды деп ойладым.
Dialogue: 0,0:11:19.26,0:11:20.80,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:11:20.88,0:11:22.51,Default,,0,0,0,,Мен оны көптен бері қарап жүрмін
Dialogue: 0,0:11:22.59,0:11:23.84,Default,,0,0,0,,Түсінетіндеріңізге сенімдімін.
Dialogue: 0,0:11:23.93,0:11:27.39,Default,,0,0,0,,Мен оны жақсы көретініме қуаныштымын
Dialogue: 0,0:11:28.39,0:11:30.64,Default,,0,0,0,,Егер сіз осылай көрінсеңіз де
Dialogue: 0,0:11:30.73,0:11:32.81,Default,,0,0,0,,Мені жақсы көргенім үшін кешір.
Dialogue: 0,0:11:32.90,0:11:34.48,Default,,0,0,0,,-Muu...
Dialogue: 0,0:11:35.56,0:11:37.40,Default,,0,0,0,,(Шабуыл дыбыстары мен гоблиндердің дауыстары)
Dialogue: 0,0:11:38.03,0:11:38.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:38.94,0:11:41.45,Default,,0,0,0,,- Гя гья гя... - Гуг гугу гугё...
Dialogue: 0,0:11:41.53,0:11:43.53,Default,,0,0,0,,Гугий Гугий!
Dialogue: 0,0:11:43.61,0:11:47.58,Default,,0,0,0,,Хаджиме-сан, мен бұл жолы да түсінемін.
Dialogue: 0,0:11:47.66,0:11:49.45,Default,,0,0,0,,Бұл Тио-сан.
Dialogue: 0,0:11:49.54,0:11:50.87,Default,,0,0,0,,Гуу~
Dialogue: 0,0:11:51.62,0:11:53.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:53.96,0:11:55.50,Default,,0,0,0,,Мастер
Dialogue: 0,0:11:55.58,0:11:58.13,Default,,0,0,0,,Егер сіз шайқастағы жетістіктеріңізге шынымен мән бермесеңіз де...
Dialogue: 0,0:11:58.21,0:12:00.17,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:12:00.26,0:12:02.09,Default,,0,0,0,,Бұл мазаны алады.
Dialogue: 0,0:12:02.17,0:12:04.47,Default,,0,0,0,,Ұлы лабиринт ұғымын айтасыз ба?
Dialogue: 0,0:12:05.05,0:12:06.85,Default,,0,0,0,,Мүмкін картоп Халзина шығар.
Dialogue: 0,0:12:06.93,0:12:08.89,Default,,0,0,0,,Менің ойымша, олар байланыстарын сынап жатыр.
Dialogue: 0,0:12:08.97,0:12:10.27,Default,,0,0,0,,Облигациялар…
Dialogue: 0,0:12:10.77,0:12:14.94,Default,,0,0,0,,Ойлап қарасам, ол сөздер кіре берістегі тас тақтайшада да бар екен.
Dialogue: 0,0:12:15.02,0:12:16.23,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:12:16.31,0:12:19.57,Default,,0,0,0,,Бұл стратегия барысында біздің облигацияларымызды сынауды білдіреді.
Dialogue: 0,0:12:19.65,0:12:21.78,Default,,0,0,0,,Мүмкін болған шығар
Dialogue: 0,0:12:21.86,0:12:22.82,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:23.40,0:12:26.16,Default,,0,0,0,,Алаяқтарды анықтау
Dialogue: 0,0:12:26.24,0:12:29.29,Default,,0,0,0,,Толығымен өзгерген достарды қабылдау
Dialogue: 0,0:12:29.37,0:12:30.95,Default,,0,0,0,,Шынымен тоқылған байламдар
Dialogue: 0,0:12:31.04,0:12:33.25,Default,,0,0,0,,Мен өзімді сынап жатқандай сезінемін.
Dialogue: 0,0:12:34.54,0:12:35.83,Default,,0,0,0,,Егер
Dialogue: 0,0:12:35.92,0:12:39.71,Default,,0,0,0,,Мен оны қазірдің өзінде тазаласам, бұл мәселе болмауы мүмкін.
Dialogue: 0,0:12:43.76,0:12:44.97,Default,,0,0,0,,Я...
Dialogue: 0,0:12:45.84,0:12:46.64,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:12:46.64,0:12:47.89,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:12:46.64,0:12:47.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:48.47,0:12:50.81,Default,,0,0,0,,Шамасы, бұл қайтадан телепортация.
Dialogue: 0,0:13:00.27,0:13:01.11,Default,,0,0,0,,Гек!
Dialogue: 0,0:13:01.19,0:13:02.07,Default,,0,0,0,,Хаджиме
Dialogue: 0,0:13:02.15,0:13:03.99,Default,,0,0,0,,Йо~го~мастер!
Dialogue: 0,0:13:04.07,0:13:07.03,Default,,0,0,0,,Біреу сізге мейірімділік танытқанда әрекет ету қиын!
Dialogue: 0,0:13:07.11,0:13:09.41,Default,,0,0,0,,Екеуің ғана алдап жүрсіңдер!
Dialogue: 0,0:13:09.49,0:13:10.66,Default,,0,0,0,,Бұл алдау!
Dialogue: 0,0:13:10.74,0:13:11.95,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:16.71,0:13:17.92,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:13:18.00,0:13:21.75,Default,,0,0,0,,(Оятқыштың шырылдау дыбысы)
Dialogue: 0,0:13:21.75,0:13:23.59,Default,,0,0,0,,(Оятқыштың шырылдау дыбысы)
Dialogue: 0,0:13:21.75,0:13:23.59,Default,,0,0,0,,Хмм... у...
Dialogue: 0,0:13:23.59,0:13:24.97,Default,,0,0,0,,(Оятқыштың шырылдау дыбысы)
Dialogue: 0,0:13:25.05,0:13:25.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:25.97,0:13:29.14,Default,,0,0,0,,Хажиме тез оян!
Dialogue: 0,0:13:29.93,0:13:31.93,Default,,0,0,0,,Бұл әлі де жақсы емес.
Dialogue: 0,0:13:32.01,0:13:34.56,Default,,0,0,0,,Күн сайын таң сайын кешірім сұраймын.
Dialogue: 0,0:13:34.64,0:13:35.98,Default,,0,0,0,,Бүгін мен де сізден жақсылық сұрасам болады ма?
Dialogue: 0,0:13:39.48,0:13:40.94,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:42.73,0:13:44.69,Default,,0,0,0,,Хаджиманы оят
Dialogue: 0,0:13:44.78,0:13:48.86,Default,,0,0,0,,Оянбасаңыз... жыныстық шабуыл жасаңыз
Dialogue: 0,0:13:48.95,0:13:51.45,Default,,0,0,0,,Иә, мен қазір оянамын.
Dialogue: 0,0:13:53.04,0:13:54.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:54.87,0:13:56.62,Default,,0,0,0,,Қайырлы таң Юэ
Dialogue: 0,0:13:57.21,0:13:59.42,Default,,0,0,0,,Қайырлы таң Хажиме
Dialogue: 0,0:14:05.59,0:14:07.34,Default,,0,0,0,,Тағы да кеш ұйықтайсыз ба?
Dialogue: 0,0:14:08.38,0:14:10.01,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:14:10.09,0:14:11.51,Default,,0,0,0,,Ұйқының болмауы Жақсы емес
Dialogue: 0,0:14:11.60,0:14:14.43,Default,,0,0,0,,Ахаха, абай болыңыз
Dialogue: 0,0:14:14.52,0:14:15.77,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:14:16.43,0:14:18.77,Default,,0,0,0,,Хаджимэ-сан Юэ-сан!
Dialogue: 0,0:14:18.85,0:14:19.69,Default,,0,0,0,,Эххе
Dialogue: 0,0:14:20.60,0:14:22.11,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:14:22.19,0:14:24.73,Default,,0,0,0,,Қайырлы таң Шиа
Dialogue: 0,0:14:24.82,0:14:26.61,Default,,0,0,0,,Ши... Шиа-сан?
Dialogue: 0,0:14:26.69,0:14:29.28,Default,,0,0,0,,Сәлем берген сайын құшақтамауыңды өтінемін.
Dialogue: 0,0:14:29.36,0:14:31.07,Default,,0,0,0,,Сіз әрқашан осылай айтасыз!
Dialogue: 0,0:14:31.16,0:14:32.16,Default,,0,0,0,,Эй… эй…
Dialogue: 0,0:14:32.24,0:14:33.74,Default,,0,0,0,,(Йотаро Куджо) Өкінішті, бірақ осы сапарда… Какёинге жарыстан шығудан басқа амал қалмауы мүмкін.
Dialogue: 0,0:14:33.83,0:14:36.08,Default,,0,0,0,,Менің бақытымды тартып алуға батылы бармайсың ба?
Dialogue: 0,0:14:36.16,0:14:37.45,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:14:37.54,0:14:38.91,Default,,0,0,0,,Тек аулақ болыңыз!
Dialogue: 0,0:14:39.00,0:14:41.71,Default,,0,0,0,,Юэнің көзінен жарық жоғалып барады!
Dialogue: 0,0:14:41.79,0:14:43.17,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:14:43.25,0:14:46.38,Default,,0,0,0,,Саған бір уақытта екі қыз ғашық болу...
Dialogue: 0,0:14:46.88,0:14:51.76,Default,,0,0,0,,Иә? Ойлап қарасаңыз, Юэмен қай жерде кездестіңіз?
Dialogue: 0,0:14:52.26,0:14:55.14,Default,,0,0,0,,Шиа да басына осындай орамал тағып жүрді ме?
Dialogue: 0,0:14:56.14,0:14:59.31,Default,,0,0,0,,Таңертеңнен бері сіз қиын жүзді көрсеттіңіз. Не болды?
Dialogue: 0,0:14:59.39,0:15:02.90,Default,,0,0,0,,Сабаққа тезірек бармасаңыз, ескерту қоңырауы соғылады.
Dialogue: 0,0:15:02.98,0:15:05.98,Default,,0,0,0,,Мм, мұғалім маған тағы да дәріс оқиды.
Dialogue: 0,0:15:06.07,0:15:10.11,Default,,0,0,0,,Сынып… Алдын ала қоңырау… Мұғалім…
Dialogue: 0,0:15:10.20,0:15:12.24,Default,,0,0,0,,Не? бұл біртүрлі сезім
Dialogue: 0,0:15:12.74,0:15:16.83,Default,,0,0,0,,Біртүрлі ештеңе айтпағаныңызға сенімдімін...?
Dialogue: 0,0:15:16.91,0:15:20.83,Default,,0,0,0,,Жоқ, сөздердің өзі емес, екі адам айтқандықтан ба?
Dialogue: 0,0:15:23.83,0:15:26.00,Default,,0,0,0,,Хм... Қызық, бұл не?
Dialogue: 0,0:15:26.09,0:15:27.67,Default,,0,0,0,,Ностальгиялық...
Dialogue: 0,0:15:27.76,0:15:30.01,Default,,0,0,0,,Неліктен мен бұлай сезінемін?
Dialogue: 0,0:15:30.09,0:15:32.13,Default,,0,0,0,,Қайырлы таң, Хаджиме-кун
Dialogue: 0,0:15:32.22,0:15:33.84,Default,,0,0,0,,Бүгін де соңғы минут.
Dialogue: 0,0:15:33.93,0:15:35.60,Default,,0,0,0,,Тезірек келейік.
Dialogue: 0,0:15:35.68,0:15:38.35,Default,,0,0,0,,Бұл сөздер...бір жерде...
Dialogue: 0,0:15:38.85,0:15:41.02,Default,,0,0,0,,Не?
Dialogue: 0,0:15:41.10,0:15:43.90,Default,,0,0,0,,Сіз неге сонша сағыныш сезінесіз?
Dialogue: 0,0:15:43.98,0:15:45.65,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:15:45.73,0:15:47.27,Default,,0,0,0,,Бүгін бір қызық.
Dialogue: 0,0:15:47.36,0:15:48.86,Default,,0,0,0,,-(Каори) Хаджиме-кун -Уау!
Dialogue: 0,0:15:48.94,0:15:50.65,Default,,0,0,0,,Оны неге елемеу керек?
Dialogue: 0,0:15:50.74,0:15:53.20,Default,,0,0,0,,Мен сені ашуландыратын бірдеңе істедім бе?
Dialogue: 0,0:15:53.28,0:15:55.57,Default,,0,0,0,,А, жоқ, кешіріңіз.
Dialogue: 0,0:15:55.66,0:15:57.83,Default,,0,0,0,,Мен біраз ойланып қалдым.
Dialogue: 0,0:15:57.91,0:15:59.37,Default,,0,0,0,,Қайырлы таң Ширасаки-сан
Dialogue: 0,0:15:59.45,0:16:01.71,Default,,0,0,0,,Түсіндім, бұл жақсы.
Dialogue: 0,0:16:01.79,0:16:05.04,Default,,0,0,0,,Сондай-ақ, мені Каори деп атағаныңызды қалаймын.
Dialogue: 0,0:16:05.13,0:16:06.21,Default,,0,0,0,,Сіз үнемі осылай айтасыз.
Dialogue: 0,0:16:06.29,0:16:09.92,Default,,0,0,0,,Иә? О, бұл... Као...
Dialogue: 0,0:16:10.01,0:16:12.01,Default,,0,0,0,,Хажимені ұятқа қалдырмаңыз
Dialogue: 0,0:16:12.09,0:16:14.64,Default,,0,0,0,,Міне, Юэ.
Dialogue: 0,0:16:15.55,0:16:18.14,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:16:18.22,0:16:22.10,Default,,0,0,0,,Қайырлы таң, Каори.
Dialogue: 0,0:16:22.18,0:16:24.52,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,0:16:24.60,0:16:27.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:29.48,0:16:30.36,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:30.44,0:16:34.49,Default,,0,0,0,,Tsk, сіз бірден тәртіптік жұмыстан босатыласыз деп үміттенемін.
Dialogue: 0,0:16:34.57,0:16:35.74,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:35.82,0:16:37.95,Default,,0,0,0,,О, о...
Dialogue: 0,0:16:38.03,0:16:40.08,Default,,0,0,0,,А... жақсы... жақсы...
Dialogue: 0,0:16:40.70,0:16:44.25,Default,,0,0,0,,Иә? Бұл қазір шынымен жақсы сезіледі.
Dialogue: 0,0:16:46.83,0:16:49.46,Default,,0,0,0,,Мені Ремия бүгін қайтып келгенше қасында қалдырасың ба?
Dialogue: 0,0:16:49.55,0:16:50.38,Default,,0,0,0,,Иә
Dialogue: 0,0:16:50.46,0:16:51.80,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:16:51.88,0:16:54.09,Default,,0,0,0,,Шиа-оне-чан мен Юэ-оне-чан да!
Dialogue: 0,0:16:57.30,0:16:58.76,Default,,0,0,0,,Мью
Dialogue: 0,0:16:58.85,0:17:01.39,Default,,0,0,0,,Секірмеңіз, бұл қауіпті.
Dialogue: 0,0:17:01.47,0:17:02.73,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:17:03.39,0:17:05.23,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:17:05.31,0:17:06.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:07.23,0:17:09.19,Default,,0,0,0,,Қазірдің өзінде үлкен аға!
Dialogue: 0,0:17:09.27,0:17:11.36,Default,,0,0,0,,Сен Мюдің әңгімесін тыңдап тұрсың ба?
Dialogue: 0,0:17:11.44,0:17:14.40,Default,,0,0,0,,Иә? Аа... Кешіріңіз, кешіріңіз
Dialogue: 0,0:17:14.49,0:17:16.24,Default,,0,0,0,,Мен біраз аң-таң болдым.
Dialogue: 0,0:17:16.32,0:17:17.36,Default,,0,0,0,,Кяах!
Dialogue: 0,0:17:17.45,0:17:18.28,Default,,0,0,0,,Гухехе…
Dialogue: 0,0:17:18.37,0:17:22.12,Default,,0,0,0,,О? Хажиме-сан, мен бірдеңені естіп тұрмын.
Dialogue: 0,0:17:22.20,0:17:23.20,Default,,0,0,0,,(Косей) Аа, дұрыс. Шыны мен ауыстыратын киім—
Dialogue: 0,0:17:23.29,0:17:24.62,Default,,0,0,0,,Жарайды, кішкентай қыз.
Dialogue: 0,0:17:24.71,0:17:27.04,Default,,0,0,0,,Гахахаха гахаха...
Dialogue: 0,0:17:27.12,0:17:29.84,Default,,0,0,0,,Жарайды. Аузыңды жап. Эй.
Dialogue: 0,0:17:29.92,0:17:31.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:31.42,0:17:32.34,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:32.42,0:17:33.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:33.84,0:17:36.05,Default,,0,0,0,,О? Хехехе...
Dialogue: 0,0:17:36.13,0:17:37.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:38.30,0:17:39.34,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:39.93,0:17:40.76,Default,,0,0,0,,-Ах! -(Еркек) Гуаа!
Dialogue: 0,0:17:41.35,0:17:42.56,Default,,0,0,0,,-Тааа! -(Еркек) Уф!
Dialogue: 0,0:17:42.64,0:17:44.22,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:17:45.06,0:17:47.14,Default,,0,0,0,,Шиа болса, ешқандай проблема жоқ.
Dialogue: 0,0:17:47.23,0:17:50.56,Default,,0,0,0,,Шиа-оне-чан күшті! керемет!
Dialogue: 0,0:17:50.65,0:17:52.48,Default,,0,0,0,,Фуфуфу~
Dialogue: 0,0:17:52.57,0:17:53.73,Default,,0,0,0,,Шынын айтсам, аса ештеңе емес, бірақ…
Dialogue: 0,0:17:53.82,0:17:57.11,Default,,0,0,0,,Мен саған төбелестің не екенін үйретемін.
Dialogue: 0,0:17:57.20,0:18:00.32,Default,,0,0,0,,Ал, мен де саған көп нәрсені үйретемін.
Dialogue: 0,0:18:00.41,0:18:02.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:02.83,0:18:05.25,Default,,0,0,0,,Маған тым оғаш ештеңе айтпа.
Dialogue: 0,0:18:02.83,0:18:05.25,Default,,0,0,0,,Уау, иә, хе
Dialogue: 0,0:18:06.75,0:18:07.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:08.58,0:18:11.54,Default,,0,0,0,,Мен бұрын не іздедім?
Dialogue: 0,0:18:12.04,0:18:14.84,Default,,0,0,0,,Көз... жақсы...
Dialogue: 0,0:18:14.92,0:18:15.92,Default,,0,0,0,,Ах...!
Dialogue: 0,0:18:18.05,0:18:19.26,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:19.84,0:18:23.01,Default,,0,0,0,,Сіз не нәрсеге қанағаттанбайсыз?
Dialogue: 0,0:18:23.51,0:18:24.60,Default,,0,0,0,,Хажиме?
Dialogue: 0,0:18:24.68,0:18:26.73,Default,,0,0,0,,Иә, Юэ?
Dialogue: 0,0:18:26.81,0:18:28.52,Default,,0,0,0,,Кіруге болады.
Dialogue: 0,0:18:40.95,0:18:44.49,Default,,0,0,0,,Мені бар күшімен жақсы көретін қызым бар
Dialogue: 0,0:18:44.58,0:18:47.33,Default,,0,0,0,,Күнделікті өмірдің өзі қанағаттанарлық.
Dialogue: 0,0:18:47.83,0:18:52.17,Default,,0,0,0,,Бұл кім? Менің ішімде кім деп айқайлап тұрсың?
Dialogue: 0,0:18:52.25,0:18:55.25,Default,,0,0,0,,Жарайды, уайымдайтын ештеңе жоқ.
Dialogue: 0,0:18:55.34,0:18:57.80,Default,,0,0,0,,Мен Хаджиманы қуантамын.
Dialogue: 0,0:18:57.88,0:18:58.80,Default,,0,0,0,,Юе…
Dialogue: 0,0:18:58.88,0:19:03.18,Default,,0,0,0,,Хаджименің идеалындай, мен әрқашан жаныңда боламын.
Dialogue: 0,0:19:04.72,0:19:06.56,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:06.64,0:19:08.48,Default,,0,0,0,,Юэ осында.
Dialogue: 0,0:19:08.56,0:19:11.40,Default,,0,0,0,,Бұдан маңызды ештеңе жоқ
Dialogue: 0,0:19:12.10,0:19:13.65,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:14.15,0:19:17.94,Default,,0,0,0,,Менің қасымда идеалды ғашығым мен өмірім бар.
Dialogue: 0,0:19:18.44,0:19:20.03,Default,,0,0,0,,үшін осы...
Dialogue: 0,0:19:21.78,0:19:25.03,Default,,0,0,0,,Мен Юэді қорғаймын, Юэ мені қорғайды
Dialogue: 0,0:19:25.12,0:19:27.04,Default,,0,0,0,,Сондықтан біз ең күштіміз
Dialogue: 0,0:19:27.54,0:19:30.37,Default,,0,0,0,,Олардың бәрін жеңіп, дүниені кесіп өтейік
Dialogue: 0,0:19:30.46,0:19:31.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:31.67,0:19:35.92,Default,,0,0,0,,Дұрыс, мынау сол қараңғы түнектің қойнауында...
Dialogue: 0,0:19:37.38,0:19:39.67,Default,,0,0,0,,Идеал ғашық?
Dialogue: 0,0:19:39.76,0:19:41.68,Default,,0,0,0,,Тәтті де нәзік дүние?
Dialogue: 0,0:19:42.43,0:19:43.76,Default,,0,0,0,,Өмірдің құны—
Dialogue: 0,0:19:45.76,0:19:47.93,Default,,0,0,0,,Берген антыңызды ұмытыңыз
Dialogue: 0,0:19:48.02,0:19:50.85,Default,,0,0,0,,Таң әлеміне батып кете жаздағаныма сенбеймін
Dialogue: 0,0:19:50.93,0:19:53.02,Default,,0,0,0,,Басым ауыратын сияқты.
Dialogue: 0,0:19:54.27,0:19:55.77,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:19:58.86,0:20:00.11,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:00.19,0:20:04.91,Default,,0,0,0,,Мен Юэ, Хаджименің сүйіктісі, идеалды ғашықпын
Dialogue: 0,0:20:04.99,0:20:06.20,Default,,0,0,0,,Сіз не нәрсеге қанағаттанбайсыз?
Dialogue: 0,0:20:06.28,0:20:08.29,Default,,0,0,0,,Бәрі, ақымақ!
Dialogue: 0,0:20:08.37,0:20:13.25,Default,,0,0,0,,Менің айтқанымды тыңдайтын ыңғайлы, идеалды ғашық?
Dialogue: 0,0:20:13.33,0:20:15.83,Default,,0,0,0,,Бұл жай ғана қуыршақ шығар!
Dialogue: 0,0:20:15.92,0:20:18.59,Default,,0,0,0,,Жоқ! Қуыршақ емес
Dialogue: 0,0:20:18.67,0:20:20.92,Default,,0,0,0,,Барлық тұлғаларды иемденгеннен кейін
Dialogue: 0,0:20:21.01,0:20:23.59,Default,,0,0,0,,Мен Хаджиме идеалдарының іске асуымын
Dialogue: 0,0:20:23.68,0:20:24.51,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:25.59,0:20:27.18,Default,,0,0,0,,Мұны істеу қиын
Dialogue: 0,0:20:27.68,0:20:31.39,Default,,0,0,0,,Бұл таңқаларлық, бұл мені қынжылтады.
Dialogue: 0,0:20:32.27,0:20:33.73,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:33.81,0:20:35.90,Default,,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:20:35.98,0:20:39.61,Default,,0,0,0,,Нағыз Юэден артық ештеңе жоқ.
Dialogue: 0,0:20:40.53,0:20:42.03,Default,,0,0,0,,Басқалары да солай.
Dialogue: 0,0:20:42.61,0:20:44.45,Default,,0,0,0,,Іс әрқашан сіз қалағандай бола бермейді.
Dialogue: 0,0:20:44.53,0:20:46.66,Default,,0,0,0,,Мазасыз жігіттерге толы
Dialogue: 0,0:20:46.74,0:20:48.87,Default,,0,0,0,,Бірақ сол себепті...
Dialogue: 0,0:20:48.95,0:20:52.58,Default,,0,0,0,,Мен қазір кіммін, өйткені мен өз идеалдарыма сай емеспін.
Dialogue: 0,0:20:52.66,0:20:54.04,Default,,0,0,0,,Мені байлаңыз
Dialogue: 0,0:20:54.12,0:20:56.92,Default,,0,0,0,,Мені кім ететін солар!
Dialogue: 0,0:20:58.29,0:21:01.46,Default,,0,0,0,,Жай ғана идеал, бірақ шын мәнінде олар айналады
Dialogue: 0,0:21:01.55,0:21:03.80,Default,,0,0,0,,Мені ауыстыра аламын деп ойлама!
Dialogue: 0,0:21:03.88,0:21:05.51,Default,,0,0,0,,Шектеуден өту!
Dialogue: 0,0:21:11.39,0:21:13.35,Default,,0,0,0,,Мен өттім.
Dialogue: 0,0:21:13.85,0:21:16.94,Default,,0,0,0,,Тек тәтті және жұмсақ нәрсенің құны жоқ.
Dialogue: 0,0:21:17.02,0:21:19.44,Default,,0,0,0,,Жай ғана берілу мағынасыз.
Dialogue: 0,0:21:19.52,0:21:25.20,Default,,0,0,0,,Қиын немесе азапты болса да, шын мәнінде біздің жинақтағанымыз және айналдырғанымыз - біз жасаған нәрсе.
Dialogue: 0,0:21:25.28,0:21:27.86,Default,,0,0,0,,Бұл сізді бақытты етеді
Dialogue: 0,0:21:27.95,0:21:29.87,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:21:31.20,0:21:32.54,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:21:40.92,0:21:41.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:43.42,0:21:44.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:46.80,0:21:48.09,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:21:54.56,0:21:57.14,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:22:00.11,0:22:02.69,Default,,0,0,0,,Бұл кәріптас сияқты...
Dialogue: 0,0:22:04.03,0:22:09.03,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:33.95,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.03,0:23:38.83,Default,,0,0,0,,Келесі жолы «Ібілістің сынағы»
Dialogue: 0,0:23:40.33,0:23:46.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
