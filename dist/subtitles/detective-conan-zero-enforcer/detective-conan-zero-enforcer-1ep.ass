Dialogue: 0,1:17:04.53,1:17:08.28,Default,,0,0,0,,((Менің қателігім үшін сіз маған қоғамдық қауіпсіздік прокуроры мәртебесін бердіңіз→
Dialogue: 0,1:17:08.36,1:17:10.54,Default,,0,0,0,,Сіз оны алып кете алмайсыз))
Dialogue: 0,1:17:10.54,1:17:13.54,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:17:13.54,1:17:16.55,Default,,0,0,0,,((Сіздің әділ мәртебеңізді алып тастаудың азабы→
Dialogue: 0,1:17:16.55,1:17:19.55,Default,,0,0,0,,Мен бәрінен де көп білемін...))
