Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.53,0:00:16.93,Default,,0,0,0,,Менің ойымша, бұл Scence арқылы соққы беру уақыты
Dialogue: 0,0:00:17.36,0:00:18.90,Default,,0,0,0,,Барлығын бірге жинаңыз
Dialogue: 0,0:00:19.66,0:00:21.93,Default,,0,0,0,,Жарайды 3 2 1 Кептелейік
Dialogue: 0,0:01:50.93,0:01:51.80,Default,,0,0,0,,Немесе мен мәңгі осы жерде қалсам, ол мазалайды деп отырсың ба?
Dialogue: 0,0:01:52.10,0:01:53.36,Default,,0,0,0,,Енді қаша алмайсың
Dialogue: 0,0:01:53.63,0:01:54.20,Default,,0,0,0,,Мен сені атып тастаймын.
Dialogue: 0,0:01:56.13,0:01:56.90,Default,,0,0,0,,Серіктеріне сенгені өзінің қателігі екенін түсінген Эрен
Dialogue: 0,0:01:57.30,0:01:58.33,Default,,0,0,0,,Абдул Хаким
Dialogue: 0,0:01:59.26,0:01:59.80,Default,,0,0,0,,Уау
Dialogue: 0,0:02:02.53,0:02:03.26,Default,,0,0,0,,Буггарати
Dialogue: 0,0:02:03.43,0:02:04.46,Default,,0,0,0,,Кимисама
Dialogue: 0,0:02:06.80,0:02:08.06,Default,,0,0,0,,Уау Уау Уау
Dialogue: 0,0:03:34.26,0:03:35.53,Default,,0,0,0,,Амиго
Dialogue: 0,0:03:35.60,0:03:39.03,Default,,0,0,0,,Қалайсыңдар, Күн жүйесіндегі 300 000 марапат аңшылары?
Dialogue: 0,0:03:39.33,0:03:43.03,Default,,0,0,0,,Сізге іздеуде жүрген адамдар туралы ақпарат беретін үлкен кадрдың уақыты келді.
Dialogue: 0,0:03:43.16,0:03:45.73,Default,,0,0,0,,Сонымен, бүгінгі күннің ең жақсы соққысы
Dialogue: 0,0:03:46.50,0:03:47.50,Default,,0,0,0,,Бұл жігіт.
Dialogue: 0,0:03:47.66,0:03:48.80,Default,,0,0,0,,Абдул Хаким
Dialogue: 0,0:03:49.56,0:03:52.80,Default,,0,0,0,,Бастапқыда ол үй жануарларын ұрлаушы болды.
Dialogue: 0,0:03:53.06,0:03:56.96,Default,,0,0,0,,Бұл жолы ол ғылыми-зерттеу мекемесінен эксперименталды жануарларды ұрлап, қашып жүр.
Dialogue: 0,0:03:57.23,0:04:01.73,Default,,0,0,0,,Хмм, жақсы жаңалық - жүлде қоры таңғаларлық 8 миллион.
Dialogue: 0,0:04:02.73,0:04:04.13,Default,,0,0,0,,Әдеттегідей шарттар
Dialogue: 0,0:04:04.60,0:04:07.03,Default,,0,0,0,,Сыйлықты тірілтіңдер.
Dialogue: 0,0:04:07.60,0:04:09.36,Default,,0,0,0,,Егер мені өлтірсең, сыйлығың тең болады.
Dialogue: 0,0:04:10.13,0:04:12.96,Default,,0,0,0,,Менің үлкен ойын болғаныма көп уақыт болды. Оны алуға сәттілік.
Dialogue: 0,0:04:14.70,0:04:15.20,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:04:16.03,0:04:17.03,Default,,0,0,0,,Өмір сүру ұзақтығы
Dialogue: 0,0:04:17.80,0:04:19.56,Default,,0,0,0,,Бұлардың ешқайсысы
Dialogue: 0,0:04:21.96,0:04:22.60,Default,,0,0,0,,Кеттік
Dialogue: 0,0:04:22.96,0:04:23.56,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:04:23.93,0:04:24.50,Default,,0,0,0,,Ақпарат?
Dialogue: 0,0:04:25.03,0:04:26.53,Default,,0,0,0,,Абдул Хаким әңгімесі
Dialogue: 0,0:04:27.26,0:04:27.86,Default,,0,0,0,,Итадаки
Dialogue: 0,0:04:28.60,0:04:30.16,Default,,0,0,0,,Мен оны 300-ге қалдырамын.
Dialogue: 0,0:04:30.53,0:04:32.30,Default,,0,0,0,,Фото пластикалық операциядан кейінгі.
Dialogue: 0,0:04:32.66,0:04:33.26,Default,,0,0,0,,Жоғары
Dialogue: 0,0:04:33.50,0:04:34.36,Default,,0,0,0,,20 төмен
Dialogue: 0,0:04:34.86,0:04:37.23,Default,,0,0,0,,Га 280
Dialogue: 0,0:04:37.56,0:04:39.53,Default,,0,0,0,,Оның орнына бір шарт бар.
Dialogue: 0,0:04:40.23,0:04:40.76,Default,,0,0,0,,Не?
Dialogue: 0,0:04:41.06,0:04:42.53,Default,,0,0,0,,Маған бір соққы беріңіз.
Dialogue: 0,0:04:43.20,0:04:45.16,Default,,0,0,0,,Ол жігіт менің үстімнен басып кетті.
Dialogue: 0,0:04:45.60,0:04:47.73,Default,,0,0,0,,Қаласаңыз, маған 10 оқ бере аласыз.
Dialogue: 0,0:05:16.93,0:05:18.93,Default,,0,0,0,,Міне, мысал
Dialogue: 0,0:05:19.36,0:05:21.50,Default,,0,0,0,,Бұл жолы ол сапалы болуы керек.
Dialogue: 0,0:05:22.50,0:05:24.03,Default,,0,0,0,,Содан кейін 6 сағаттан кейін
Dialogue: 0,0:05:25.23,0:05:28.20,Default,,0,0,0,,Сіз біртүрлі көрінетін чемоданды алып жүрдіңіз.
Dialogue: 0,0:05:28.30,0:05:29.93,Default,,0,0,0,,Бұл ақпарат бағаға кіреді.
Dialogue: 0,0:05:30.63,0:05:31.90,Default,,0,0,0,,Мен оны жалғыз қалдырамын
Dialogue: 0,0:05:32.56,0:05:35.23,Default,,0,0,0,,Оны кішкентай әйел көтеріп алатын сияқты.
Dialogue: 0,0:05:35.66,0:05:36.76,Default,,0,0,0,,Бұл қазына ма?
Dialogue: 0,0:05:36.96,0:05:37.73,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:38.53,0:05:41.16,Default,,0,0,0,,Менің ойымша, бұл олай өңделмеген.
Dialogue: 0,0:05:55.50,0:05:56.06,Default,,0,0,0,,Nyiraira
Dialogue: 0,0:05:56.90,0:06:00.36,Default,,0,0,0,,Тұтынушының сәбіз мочи шайы 100 000 иен тұрады.
Dialogue: 0,0:06:00.43,0:06:02.10,Default,,0,0,0,,Бір аптаға созылады
Dialogue: 0,0:06:02.33,0:06:05.03,Default,,0,0,0,,Егер сіз шаршасаңыз, қант қамысы мочи шайын ішіп көріңіз.
Dialogue: 0,0:06:05.30,0:06:07.66,Default,,0,0,0,,Егер сіз тым көп жесеңіз, ананас мочи шайын қолданып көріңіз.
Dialogue: 0,0:06:08.60,0:06:09.66,Default,,0,0,0,,Бұл Лаочу
Dialogue: 0,0:06:10.16,0:06:10.73,Default,,0,0,0,,Шай Шей
Dialogue: 0,0:06:11.50,0:06:12.13,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:13.73,0:06:14.43,Default,,0,0,0,,Уау
Dialogue: 0,0:06:15.13,0:06:16.23,Default,,0,0,0,,олардың әрекеттерін күшейту қаупі бар.
Dialogue: 0,0:06:16.30,0:06:18.16,Default,,0,0,0,,Кешіріңіз, ағайын.
Dialogue: 0,0:06:20.90,0:06:22.86,Default,,0,0,0,,Сіз кешірім сұрап жатырсыз, солай емес пе?
Dialogue: 0,0:06:23.36,0:06:25.80,Default,,0,0,0,,Неге бірдеңе айтпайсың?
Dialogue: 0,0:06:30.23,0:06:32.96,Default,,0,0,0,,Ооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо
Dialogue: 0,0:06:35.60,0:06:36.63,Default,,0,0,0,,Бұл менің сыйлығым
Dialogue: 0,0:06:37.36,0:06:37.86,Default,,0,0,0,,Иә
Dialogue: 0,0:06:37.90,0:06:42.60,Default,,0,0,0,,Уаааааааааааааааааааааааааааа
Dialogue: 0,0:06:43.20,0:06:44.03,Default,,0,0,0,,Ішіңіз
Dialogue: 0,0:06:44.76,0:06:47.86,Default,,0,0,0,,Уа, һә, һә, һә, һә, һә
Dialogue: 0,0:06:47.93,0:06:50.33,Default,,0,0,0,,Еееееееееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:06:51.10,0:06:51.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:04.50,0:07:05.50,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:07:07.16,0:07:07.76,Default,,0,0,0,,Реңк
Dialogue: 0,0:07:08.03,0:07:09.73,Default,,0,0,0,,Хехехет
Dialogue: 0,0:07:10.66,0:07:12.80,Default,,0,0,0,,Ал, қазына қазына
Dialogue: 0,0:07:16.20,0:07:18.53,Default,,0,0,0,,Гуруру Руру
Dialogue: 0,0:07:18.60,0:07:19.76,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:07:20.36,0:07:22.50,Default,,0,0,0,,Кекккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккк
Dialogue: 0,0:07:41.73,0:07:44.26,Default,,0,0,0,,Егер сіз бүкіл ұшақты күрделі жөндеуден өткізсеңіз де, сіз балық аулай алмайсыз.
Dialogue: 0,0:07:45.20,0:07:46.63,Default,,0,0,0,,Пекин үйрегін жегіңіз келе ме?
Dialogue: 0,0:07:47.40,0:07:50.83,Default,,0,0,0,,«Кетпей тұрып балапаныңды санама» деген сөз бар.
Dialogue: 0,0:07:54.50,0:07:55.70,Default,,0,0,0,,Бұл жолы қиын
Dialogue: 0,0:07:55.96,0:07:57.40,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:08:06.86,0:08:08.13,Default,,0,0,0,,Олардың үшеуі де өлтірілді ме?
Dialogue: 0,0:08:08.76,0:08:09.43,Default,,0,0,0,,Бұл солай сияқты
Dialogue: 0,0:08:10.13,0:08:11.43,Default,,0,0,0,,Хакім осы жерде.
Dialogue: 0,0:08:12.00,0:08:12.56,Default,,0,0,0,,Солай көрінеді
Dialogue: 0,0:08:13.60,0:08:15.93,Default,,0,0,0,,Шын бағасын білмесем де
Dialogue: 0,0:08:18.00,0:08:19.36,Default,,0,0,0,,Үй жануарлары дүкенінде
Dialogue: 0,0:08:20.16,0:08:21.60,Default,,0,0,0,,Бұл да заңсыз.
Dialogue: 0,0:08:22.76,0:08:24.03,Default,,0,0,0,,Әй, ағайын.
Dialogue: 0,0:08:24.63,0:08:27.60,Default,,0,0,0,,Ақшаға Марста кез келген нәрсені сатып алуға болады.
Dialogue: 0,0:08:28.20,0:08:30.83,Default,,0,0,0,,Мылтықтан бастап адамдардың өміріне дейін.
Dialogue: 0,0:08:31.43,0:08:33.86,Default,,0,0,0,,Егер сіз ақпарат алғыңыз келсе, оны маған беріңіз.
Dialogue: 0,0:08:34.60,0:08:35.80,Default,,0,0,0,,Тізбек ұзын.
Dialogue: 0,0:08:36.43,0:08:37.93,Default,,0,0,0,,Айдаһар үлгісінің жолы?
Dialogue: 0,0:08:38.56,0:08:39.66,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:08:39.93,0:08:42.13,Default,,0,0,0,,Бұл 1930 жылдардағы сирек кездесетін зат.
Dialogue: 0,0:08:43.43,0:08:45.00,Default,,0,0,0,,Бұл зат антиквариат.
Dialogue: 0,0:08:46.03,0:08:50.10,Default,,0,0,0,,Кай Хонг жолының соңындағы Animal Treasure деп аталатын дүкенге барыңыз.
Dialogue: 0,0:08:50.86,0:08:52.40,Default,,0,0,0,,Сіз бірдеңе білетін боласыз.
Dialogue: 0,0:08:57.70,0:09:00.80,Default,,0,0,0,,Мен жай ғана қараймын
Dialogue: 0,0:09:01.30,0:09:02.83,Default,,0,0,0,,Мен оны сатып аламын ба, жоқ па, содан кейін шешемін.
Dialogue: 0,0:09:03.00,0:09:04.16,Default,,0,0,0,,Олай болса
Dialogue: 0,0:09:10.60,0:09:11.43,Default,,0,0,0,,Тізе
Dialogue: 0,0:09:11.66,0:09:13.23,Default,,0,0,0,,Ихихи
Dialogue: 0,0:09:17.73,0:09:18.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:18.70,0:09:21.23,Default,,0,0,0,,Тым көп пластикалық операцияға байланысты ақшаңыз таусылды ма?
Dialogue: 0,0:09:21.46,0:09:22.03,Default,,0,0,0,,Хакім
Dialogue: 0,0:09:22.10,0:09:23.26,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:09:23.43,0:09:24.73,Default,,0,0,0,,Ой, қозғалмаңыз.
Dialogue: 0,0:09:24.90,0:09:27.06,Default,,0,0,0,,Таку бетін өзгерте береді.
Dialogue: 0,0:09:27.36,0:09:28.50,Default,,0,0,0,,Ол мазасыз.
Dialogue: 0,0:09:28.76,0:09:29.26,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:09:29.76,0:09:32.53,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:09:32.63,0:09:34.50,Default,,0,0,0,,Менің балаларымның барлығы сезімтал.
Dialogue: 0,0:09:34.56,0:09:35.46,Default,,0,0,0,,Сіз оны ашасыз.
Dialogue: 0,0:09:36.20,0:09:37.10,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:37.76,0:09:38.83,Default,,0,0,0,,Мен қате түсіндім.
Dialogue: 0,0:09:39.23,0:09:39.73,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:09:41.90,0:09:42.40,Default,,0,0,0,,Иә
Dialogue: 0,0:09:44.96,0:09:45.93,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:09:48.80,0:09:49.43,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,0:09:52.26,0:09:52.90,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:55.26,0:09:55.90,Default,,0,0,0,,Уф
Dialogue: 0,0:09:57.70,0:10:00.16,Default,,0,0,0,,Уф, менің.
Dialogue: 0,0:10:01.06,0:10:01.70,Default,,0,0,0,,Құм
Dialogue: 0,0:10:03.23,0:10:04.36,Default,,0,0,0,,Ит
Dialogue: 0,0:10:04.80,0:10:06.33,Default,,0,0,0,,Уэльс Корги
Dialogue: 0,0:10:06.40,0:10:07.96,Default,,0,0,0,,Сүйкімді, бірақ қарапайым
Dialogue: 0,0:10:08.23,0:10:10.16,Default,,0,0,0,,Бұл сирек кездесетін түрі емес.
Dialogue: 0,0:10:10.53,0:10:12.50,Default,,0,0,0,,Демек, бұл иттің бағасы
Dialogue: 0,0:10:13.00,0:10:15.63,Default,,0,0,0,,Осыған ұқсас нәрсе, соның ішінде чемодан
Dialogue: 0,0:10:15.70,0:10:16.53,Default,,0,0,0,,200 000
Dialogue: 0,0:10:16.60,0:10:17.63,Default,,0,0,0,,200 жас 200
Dialogue: 0,0:10:17.90,0:10:19.10,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:10:19.30,0:10:21.36,Default,,0,0,0,,Егер бұл сізге ұнамаса, оны өзіңіз шешіңіз.
Dialogue: 0,0:10:21.50,0:10:22.46,Default,,0,0,0,,Егер сіз оны жесеңіз
Dialogue: 0,0:10:22.66,0:10:23.70,Default,,0,0,0,,Бұл Ақайну ғой.
Dialogue: 0,0:10:24.30,0:10:25.03,Default,,0,0,0,,Кешіріңіз, мазаладым.
Dialogue: 0,0:10:25.73,0:10:26.73,Default,,0,0,0,,Жалғастыруыңызды өтінеміз.
Dialogue: 0,0:10:28.03,0:10:29.56,Default,,0,0,0,,О, менің
Dialogue: 0,0:10:35.90,0:10:37.96,Default,,0,0,0,,Пекин үйрегі тым жұмсақ болды.
Dialogue: 0,0:10:38.46,0:10:39.90,Default,,0,0,0,,Кем дегенде 300-ге жуық
Dialogue: 0,0:10:39.96,0:10:40.63,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:10:41.93,0:10:43.06,Default,,0,0,0,,Көптеген жылдар бойы дәрігер болып—
Dialogue: 0,0:10:43.43,0:10:44.50,Default,,0,0,0,,250 Ah
Dialogue: 0,0:10:44.56,0:10:46.63,Default,,0,0,0,,Бұл 0. Мен оны сізге қайтарамын.
Dialogue: 0,0:10:47.26,0:10:49.50,Default,,0,0,0,,Тағы не? Келесі жолы ше?
Dialogue: 0,0:10:53.10,0:10:54.60,Default,,0,0,0,,Гуруру Руру
Dialogue: 0,0:10:54.66,0:10:55.16,Default,,0,0,0,,Әу
Dialogue: 0,0:10:55.90,0:10:56.53,Default,,0,0,0,,Иә
Dialogue: 0,0:10:58.76,0:11:01.46,Default,,0,0,0,,Әй, біреу менің баламды ұстап алсын.
Dialogue: 0,0:11:01.53,0:11:02.20,Default,,0,0,0,,А, мен оны жек көремін.
Dialogue: 0,0:11:02.56,0:11:03.06,Default,,0,0,0,,(Джунпей) Мен бұны үйге алып кетемін, аяғыңды алшы?
Dialogue: 0,0:11:03.20,0:11:03.70,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:06.06,0:11:06.56,Default,,0,0,0,,Уау
Dialogue: 0,0:11:09.50,0:11:10.86,Default,,0,0,0,,Әй Хаким
Dialogue: 0,0:11:11.63,0:11:13.56,Default,,0,0,0,,Қарғыс атсын, не болып жатыр?
Dialogue: 0,0:11:32.60,0:11:33.10,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:11:36.06,0:11:36.90,Default,,0,0,0,,Иә
Dialogue: 0,0:11:39.63,0:11:43.06,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:12:02.43,0:12:04.36,Default,,0,0,0,,Не болды
Dialogue: 0,0:12:04.53,0:12:06.36,Default,,0,0,0,,Күте тұрыңыз, күтіңіз, уау.
Dialogue: 0,0:12:07.00,0:12:08.56,Default,,0,0,0,,Бұл маринадталған тағаммен өте жақсы үйлесер еді.
Dialogue: 0,0:12:23.63,0:12:24.60,Default,,0,0,0,,Ой
Dialogue: 0,0:12:27.16,0:12:28.43,Default,,0,0,0,,Боунти аңшысы?
Dialogue: 0,0:12:28.96,0:12:30.53,Default,,0,0,0,,Жануарларды қорғау мафиясы?
Dialogue: 0,0:12:31.26,0:12:32.73,Default,,0,0,0,,Бұл сені жылататын әңгіме емес пе?
Dialogue: 0,0:12:33.36,0:12:36.16,Default,,0,0,0,,Бар болғаны 200 оолонг ит үшін өміріңізді қатерге тігесіз бе?
Dialogue: 0,0:12:36.73,0:12:37.53,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:12:38.10,0:12:42.53,Default,,0,0,0,,Менің қалағаным сегіз миллион улонг сіздің мойныңызда ілулі тұр.
Dialogue: 0,0:12:44.10,0:12:44.60,Default,,0,0,0,,Уууу
Dialogue: 0,0:12:45.03,0:12:46.76,Default,,0,0,0,,Ах
Dialogue: 0,0:12:48.26,0:12:49.56,Default,,0,0,0,,Гуа!
Dialogue: 0,0:12:55.20,0:12:56.06,Default,,0,0,0,,Жасайық
Dialogue: 0,0:12:57.53,0:12:58.03,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:58.36,0:12:58.86,Default,,0,0,0,,Не?
Dialogue: 0,0:13:00.40,0:13:01.30,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:13:02.86,0:13:04.20,Default,,0,0,0,,Иә
Dialogue: 0,0:13:05.60,0:13:06.10,Default,,0,0,0,,Бірақ олай болмас қой?
Dialogue: 0,0:13:12.50,0:13:14.16,Default,,0,0,0,,Уау
Dialogue: 0,0:13:14.26,0:13:16.23,Default,,0,0,0,,Ван Ван Ван Ван Ван
Dialogue: 0,0:13:18.10,0:13:21.00,Default,,0,0,0,,Уау, менің қазір көңіл-күйім нашар.
Dialogue: 0,0:13:22.06,0:13:23.06,Default,,0,0,0,,Куун
Dialogue: 0,0:13:37.43,0:13:38.23,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:13:38.30,0:13:40.23,Default,,0,0,0,,Оған жағаны кигізейік.
Dialogue: 0,0:13:40.43,0:13:40.96,Default,,0,0,0,,Ха ха
Dialogue: 0,0:13:41.50,0:13:43.53,Default,,0,0,0,,Бұл үйрек болуы керек, бірақ бұл ит емес.
Dialogue: 0,0:13:43.66,0:13:46.43,Default,,0,0,0,,Одан да көп түсіндіңіз бе?
Dialogue: 0,0:13:46.60,0:13:48.43,Default,,0,0,0,,А, мынау.
Dialogue: 0,0:13:49.20,0:13:51.83,Default,,0,0,0,,Welsh Corgi Керемет пайдасыз ит
Dialogue: 0,0:13:52.33,0:13:53.13,Default,,0,0,0,,Керемет пе?
Dialogue: 0,0:13:53.56,0:13:56.13,Default,,0,0,0,,тамаша
Dialogue: 0,0:13:56.70,0:13:59.23,Default,,0,0,0,,Қарғыс атсын, бұл жиіркенішті.
Dialogue: 0,0:13:59.56,0:14:00.26,Default,,0,0,0,,Мынау да
Dialogue: 0,0:14:00.63,0:14:01.43,Default,,0,0,0,,Мұның барлығына пайдасыз ит кінәлі
Dialogue: 0,0:14:01.80,0:14:02.96,Default,,0,0,0,,Дааа
Dialogue: 0,0:14:03.90,0:14:04.66,Default,,0,0,0,,Кукукукукку
Dialogue: 0,0:14:04.73,0:14:08.10,Default,,0,0,0,,Иттің құны болмаса да, иесінің құны бар.
Dialogue: 0,0:14:08.13,0:14:08.63,Default,,0,0,0,,​​О?
Dialogue: 0,0:14:09.46,0:14:12.33,Default,,0,0,0,,Ең жақсысы - бұл жігітпен дос болу.
Dialogue: 0,0:14:12.40,0:14:15.20,Default,,0,0,0,,Мен балалар мен аңдарды ұнатпаймын.
Dialogue: 0,0:14:16.53,0:14:18.43,Default,,0,0,0,,Өзіңе қамқорлық жасай алмасаң, жақсы боласың.
Dialogue: 0,0:14:20.16,0:14:20.66,Default,,0,0,0,,Ах
Dialogue: 0,0:14:21.13,0:14:21.76,Default,,0,0,0,,Бұл қажет болды
Dialogue: 0,0:14:21.83,0:14:23.23,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:14:23.70,0:14:24.56,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:14:24.63,0:14:25.16,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:14:25.33,0:14:26.03,Default,,0,0,0,,Жақынға жақын
Dialogue: 0,0:14:26.10,0:14:27.43,Default,,0,0,0,,Ааа
Dialogue: 0,0:14:27.63,0:14:29.30,Default,,0,0,0,,Ахх
Dialogue: 0,0:14:30.50,0:14:32.96,Default,,0,0,0,,Ахх
Dialogue: 0,0:14:33.03,0:14:34.13,Default,,0,0,0,,Қазір сағат қанша?
Dialogue: 0,0:14:34.46,0:14:37.10,Default,,0,0,0,,«Донэван мырза, сіз мүлде дұрыс айтасыз» де.
Dialogue: 0,0:14:37.16,0:14:37.96,Default,,0,0,0,,Аа, сағат 4 болды.
Dialogue: 0,0:14:39.06,0:14:40.40,Default,,0,0,0,,Екі сағаттан кейін бе?
Dialogue: 0,0:14:41.16,0:14:41.83,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:14:44.53,0:14:47.26,Default,,0,0,0,,Хакиммен бірге болған адам дос па?
Dialogue: 0,0:14:47.86,0:14:48.50,Default,,0,0,0,,Бұл солай сияқты
Dialogue: 0,0:14:49.63,0:14:50.83,Default,,0,0,0,,Сізде түсінік жоқ па?
Dialogue: 0,0:14:51.20,0:14:52.33,Default,,0,0,0,,Мен тез әрекет еткім келеді
Dialogue: 0,0:14:52.66,0:14:54.93,Default,,0,0,0,,Бұл полицияға барса жаман болар еді.
Dialogue: 0,0:14:55.33,0:14:56.03,Default,,0,0,0,,Бұл солай сияқты
Dialogue: 0,0:14:56.66,0:14:58.53,Default,,0,0,0,,Біздің зерттеулеріміз жарыққа шықса
Dialogue: 0,0:14:58.63,0:15:00.20,Default,,0,0,0,,Осы уақытқа дейін жасаған тынымсыз еңбегің бекер.
Dialogue: 0,0:15:01.36,0:15:02.13,Default,,0,0,0,,Бұл солай сияқты
Dialogue: 0,0:15:02.83,0:15:05.96,Default,,0,0,0,,Сіздің ойыңызша, олар бұл деректер итіне қанша ақша жұмсайды?
Dialogue: 0,0:15:08.26,0:15:10.03,Default,,0,0,0,,Неге мұны істемейсің?
Dialogue: 0,0:15:10.66,0:15:11.70,Default,,0,0,0,,Әжеге
Dialogue: 0,0:15:12.00,0:15:15.53,Default,,0,0,0,,Бастаған ісімді аяқта деп айтпадың ба?
Dialogue: 0,0:15:16.20,0:15:18.10,Default,,0,0,0,,Ол мен туылмай тұрып қайтыс болды
Dialogue: 0,0:15:18.40,0:15:19.33,Default,,0,0,0,,О, бұл дөрекі.
Dialogue: 0,0:15:19.70,0:15:22.70,Default,,0,0,0,,Қалай болғанда да, менде Джокер бар.
Dialogue: 0,0:15:23.26,0:15:24.83,Default,,0,0,0,,Жоспар бойынша сұраймын.
Dialogue: 0,0:15:26.66,0:15:28.53,Default,,0,0,0,,Snoop код атауын сұраңыз
Dialogue: 0,0:15:30.63,0:15:31.93,Default,,0,0,0,,Иә, бұл менмін.
Dialogue: 0,0:15:32.56,0:15:33.80,Default,,0,0,0,,Мәселе болды
Dialogue: 0,0:15:35.43,0:15:37.30,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:15:38.03,0:15:40.20,Default,,0,0,0,,-Иә? -Эй, күт, Майкл.
Dialogue: 0,0:15:42.30,0:15:44.46,Default,,0,0,0,,Мен сауда уақытының ұзартылуын қалаймын.
Dialogue: 0,0:15:45.53,0:15:47.03,Default,,0,0,0,,Жоқ, бұл үлкен мәселе емес.
Dialogue: 0,0:15:49.96,0:15:50.66,Default,,0,0,0,,Егер бұл мүмкін болмаса
Dialogue: 0,0:15:50.83,0:15:52.30,Default,,0,0,0,,Неліктен? Эй, күте тұрыңыз.
Dialogue: 0,0:15:54.66,0:15:55.63,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:00.60,0:16:02.13,Default,,0,0,0,,Бұл стратегия.
Dialogue: 0,0:16:06.80,0:16:08.30,Default,,0,0,0,,Сен сонда
Dialogue: 0,0:16:08.70,0:16:11.36,Default,,0,0,0,,Мен шынымен білгім келетін бір нәрсе бар.
Dialogue: 0,0:16:12.40,0:16:13.63,Default,,0,0,0,,Жоқ, жоқ, күте тұрыңыз.
Dialogue: 0,0:16:14.10,0:16:17.56,Default,,0,0,0,,Менің Пико-чаным кез келген нәрсеге жауап береді.
Dialogue: 0,0:16:18.53,0:16:21.30,Default,,0,0,0,,Тұтынушы: Сіз түсінбейтін нәрселер бар.
Dialogue: 0,0:16:21.90,0:16:24.60,Default,,0,0,0,,Қараңызшы, Пико-чан мұны айтып тұр.
Dialogue: 0,0:16:25.13,0:16:28.80,Default,,0,0,0,,Менің ойымша, сізде іздейтін нәрсе немесе сұрайтын адам бар.
Dialogue: 0,0:16:33.10,0:16:37.10,Default,,0,0,0,,Жүр, ит қайда, Хакім бар.
Dialogue: 0,0:16:38.13,0:16:39.43,Default,,0,0,0,,Жақсы сезімталдық
Dialogue: 0,0:16:40.63,0:16:42.76,Default,,0,0,0,,Мен оны сұрадым, ит.
Dialogue: 0,0:16:46.36,0:16:47.23,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:16:47.70,0:16:48.60,Default,,0,0,0,,Мен ит ысқырығын қолданамын.
Dialogue: 0,0:16:48.96,0:16:50.86,Default,,0,0,0,,Бірақ бұл қиын болды.
Dialogue: 0,0:16:51.16,0:16:51.80,Default,,0,0,0,,Уа!!
Dialogue: 0,0:16:52.23,0:16:53.23,Default,,0,0,0,,Ол көзге түседі.
Dialogue: 0,0:16:53.60,0:16:54.90,Default,,0,0,0,,Арқа мен қарынды ауыстыру мүмкін емес
Dialogue: 0,0:16:55.60,0:16:56.23,Default,,0,0,0,,Сіз мұны істегіңіз келе ме?
Dialogue: 0,0:16:56.73,0:16:57.30,Default,,0,0,0,,Жасаңыз.
Dialogue: 0,0:17:07.70,0:17:08.86,Default,,0,0,0,,Мен ештеңе естімеймін.
Dialogue: 0,0:17:09.23,0:17:11.33,Default,,0,0,0,,Сондықтан адамдар оны ести алмайды.
Dialogue: 0,0:17:11.80,0:17:13.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:14.30,0:17:16.93,Default,,0,0,0,,Бұл ақылсыз әңгіме, солай емес пе?
Dialogue: 0,0:17:18.20,0:17:20.50,Default,,0,0,0,,Сіз шынымен де осылай келе жатырсыз ба?
Dialogue: 0,0:17:21.20,0:17:21.73,Default,,0,0,0,,Ах
Dialogue: 0,0:17:27.30,0:17:29.60,Default,,0,0,0,,Бір нәрсе қозғала бастады.
Dialogue: 0,0:17:29.86,0:17:31.73,Default,,0,0,0,,Ван Ван Ван Ван
Dialogue: 0,0:17:31.80,0:17:33.73,Default,,0,0,0,,Ван Ван Ван
Dialogue: 0,0:17:34.06,0:17:38.26,Default,,0,0,0,,Күте тұрыңыз, балалар, сендерге не болды?
Dialogue: 0,0:17:39.90,0:17:41.93,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,0:17:42.03,0:17:42.60,Default,,0,0,0,,Ван Ван
Dialogue: 0,0:17:43.20,0:17:46.03,Default,,0,0,0,,Ван Ван Ван
Dialogue: 0,0:17:46.06,0:17:47.76,Default,,0,0,0,,Ван Ван
Dialogue: 0,0:17:48.16,0:17:49.36,Default,,0,0,0,,Реактивті ұшақ қашып кетті
Dialogue: 0,0:17:49.96,0:17:51.73,Default,,0,0,0,,Әй? Хаким?
Dialogue: 0,0:17:51.86,0:17:52.50,Default,,0,0,0,,Бұл ит.
Dialogue: 0,0:17:52.76,0:17:54.80,Default,,0,0,0,,Бұл өте жақын
Dialogue: 0,0:17:54.86,0:17:56.96,Default,,0,0,0,,Сіз іздеген нәрсе дерлік қалды.
Dialogue: 0,0:17:57.46,0:18:00.03,Default,,0,0,0,,Сіздің алдыңызда
Dialogue: 0,0:18:00.10,0:18:00.73,Default,,0,0,0,,Ван Ван Ван
Dialogue: 0,0:18:02.23,0:18:04.13,Default,,0,0,0,,О, ақша ше?
Dialogue: 0,0:18:04.66,0:18:05.73,Default,,0,0,0,,Бұл жарнама.
Dialogue: 0,0:18:06.43,0:18:07.80,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:18:11.36,0:18:12.73,Default,,0,0,0,,Ван Ван Ван
Dialogue: 0,0:18:17.66,0:18:18.96,Default,,0,0,0,,Ван Ван Ван
Dialogue: 0,0:18:19.16,0:18:21.46,Default,,0,0,0,,Қарғыс атсын, не болды?
Dialogue: 0,0:18:29.03,0:18:29.83,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:18:30.20,0:18:31.40,Default,,0,0,0,,Иә, өте
Dialogue: 0,0:18:32.26,0:18:32.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:35.26,0:18:35.76,Default,,0,0,0,,Бұл
Dialogue: 0,0:18:35.80,0:18:36.73,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:18:40.93,0:18:42.93,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:18:46.53,0:18:47.80,Default,,0,0,0,,Ха ха
Dialogue: 0,0:18:48.53,0:18:49.10,Default,,0,0,0,,Хакім
Dialogue: 0,0:18:50.33,0:18:51.63,Default,,0,0,0,,Уау
Dialogue: 0,0:19:01.63,0:19:02.20,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:19:04.56,0:19:05.06,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:19:05.43,0:19:06.76,Default,,0,0,0,,Шосен ит пе?
Dialogue: 0,0:19:13.83,0:19:14.33,Default,,0,0,0,,Хакім
Dialogue: 0,0:19:17.40,0:19:19.93,Default,,0,0,0,,Спайк Ол Интер 6-ға барады.
Dialogue: 0,0:19:20.80,0:19:21.53,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:19:22.06,0:19:23.53,Default,,0,0,0,,Егер қашып құтыла алсаң, қаш.
Dialogue: 0,0:19:24.03,0:19:25.66,Default,,0,0,0,,Тым қызып кетпеңіз.
Dialogue: 0,0:19:26.13,0:19:27.96,Default,,0,0,0,,Менің қай жерім ыстық?
Dialogue: 0,0:19:33.83,0:19:34.50,Default,,0,0,0,,Мен оны жек көрдім
Dialogue: 0,0:19:56.56,0:19:57.70,Default,,0,0,0,,Бұл менің бұрынғы оралуым.
Dialogue: 0,0:20:04.26,0:20:05.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:08.10,0:20:08.93,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:09.30,0:20:10.50,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:20:12.93,0:20:13.86,Default,,0,0,0,,Күрсін
Dialogue: 0,0:20:16.30,0:20:16.80,Default,,0,0,0,,Ит
Dialogue: 0,0:20:22.66,0:20:23.23,Default,,0,0,0,,Не?
Dialogue: 0,0:20:23.76,0:20:24.26,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:20:27.63,0:20:28.13,Default,,0,0,0,,Тоқта
Dialogue: 0,0:20:30.80,0:20:31.73,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:20:32.63,0:20:33.23,Default,,0,0,0,,Таяқ
Dialogue: 0,0:20:35.23,0:20:35.80,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:20:36.76,0:20:38.46,Default,,0,0,0,,Сондықтан мен Кедамонды жек көремін.
Dialogue: 0,0:20:54.16,0:20:58.56,Default,,0,0,0,,Уау
Dialogue: 0,0:21:04.63,0:21:05.90,Default,,0,0,0,,Амиго
Dialogue: 0,0:21:05.96,0:21:09.40,Default,,0,0,0,,Күн жүйесіндегі 300 000 сыйлы аңшылардың барлығы қалай?
Dialogue: 0,0:21:09.60,0:21:13.53,Default,,0,0,0,,Сізге іздеуде жүрген адамдар туралы ақпарат беретін үлкен кадрдың уақыты келді.
Dialogue: 0,0:21:13.86,0:21:15.36,Default,,0,0,0,,Өткен апта қорқынышты болды.
Dialogue: 0,0:21:15.40,0:21:19.36,Default,,0,0,0,,Әбділ Хакимнің өзін керемет түрде тапсырғанын еске түсіресіз.
Dialogue: 0,0:21:19.50,0:21:21.23,Default,,0,0,0,,Хмм, әрине.
Dialogue: 0,0:21:21.26,0:21:22.36,Default,,0,0,0,,Нені ұрлады
Dialogue: 0,0:21:22.86,0:21:25.43,Default,,0,0,0,,Ғылыми-зерттеу мекемесі заңсыз өсті
Dialogue: 0,0:21:25.70,0:21:28.50,Default,,0,0,0,,Шамасы, деректер ит ит болған.
Dialogue: 0,0:21:28.66,0:21:29.46,Default,,0,0,0,,Уау
Dialogue: 0,0:21:29.53,0:21:30.46,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:21:30.53,0:21:32.10,Default,,0,0,0,,А, мен де түсінбеймін.
Dialogue: 0,0:21:32.36,0:21:34.23,Default,,0,0,0,,Қысқасы, өте ақылды.
Dialogue: 0,0:21:34.30,0:21:35.13,Default,,0,0,0,,Сіз ит дейсіз бе?
Dialogue: 0,0:21:35.63,0:21:39.26,Default,,0,0,0,,Коллекционерлер арасында әр нәрсенің астрономиялық бағасы бар сияқты.
Dialogue: 0,0:21:39.46,0:21:41.06,Default,,0,0,0,,О, қандай тосын сый.
Dialogue: 0,0:21:41.30,0:21:44.03,Default,,0,0,0,,Мен осындай итке ие болғым келеді.
Dialogue: 0,0:21:44.26,0:21:46.60,Default,,0,0,0,,Ах, бірақ ол әлі де жоқ.
Dialogue: 0,0:21:46.76,0:21:48.73,Default,,0,0,0,,Қайда кетті деп ойлаймын.
Dialogue: 0,0:21:48.83,0:21:49.53,Default,,0,0,0,,Мүлдем емес.
Dialogue: 0,0:21:50.26,0:21:51.90,Default,,0,0,0,,Қазір коммерциялық уақыт
Dialogue: 0,0:21:52.96,0:21:53.83,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:55.30,0:21:56.56,Default,,0,0,0,,Егер ол ондаған күн бойы осылай көңілді жүретін болса, онда Киса қалыпты емес болар еді.
Dialogue: 0,0:21:57.06,0:21:57.96,Default,,0,0,0,,(Роко) Куфуфуфу. Мақтаның жараланды ма?
Dialogue: 0,0:21:58.06,0:22:01.30,Default,,0,0,0,,Тазалап болған соң, Комодо айдаһарын тамақтандырыңыз.
Dialogue: 0,0:22:02.10,0:22:03.83,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:22:04.16,0:22:05.00,Default,,0,0,0,,Эй
Dialogue: 0,0:22:06.36,0:22:06.86,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:22:07.46,0:22:08.50,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:22:11.96,0:22:14.03,Default,,0,0,0,,Ей, мен сонда көтерілемін.
Dialogue: 0,0:22:15.86,0:22:16.50,Default,,0,0,0,,Суық
Dialogue: 0,0:22:17.86,0:22:18.93,Default,,0,0,0,,Жақсы
Dialogue: 0,0:22:19.06,0:22:21.83,Default,,0,0,0,,Міне, осы керексіз итті қуып жіберейік дедім.
Dialogue: 0,0:22:22.30,0:22:24.03,Default,,0,0,0,,Сіз мені осында әкелдіңіз, солай ма?
Dialogue: 0,0:22:24.96,0:22:27.53,Default,,0,0,0,,​​Қалай болғанда да, кенелер туралы бірдеңе істеуім керек.
Dialogue: 0,0:22:28.16,0:22:29.80,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:22:30.13,0:22:31.63,Default,,0,0,0,,Мен оны тұзбен жеймін.
Dialogue: 0,0:22:32.36,0:22:34.93,Default,,0,0,0,,Келесі кездескенше
Dialogue: 0,0:22:35.20,0:22:35.96,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:22:52.66,0:22:57.86,Default,,0,0,0,,Мен сені сүйдім деп күйіну
Dialogue: 0,0:22:58.20,0:23:03.06,Default,,0,0,0,,Тым көп уақыт өтті
Dialogue: 0,0:23:04.60,0:23:09.63,Default,,0,0,0,,Менің жүрегім әлі де жаралы
Dialogue: 0,0:23:10.20,0:23:15.16,Default,,0,0,0,,Емсіз жел соғып тұр
Dialogue: 0,0:23:16.93,0:23:25.10,Default,,0,0,0,,Біреу құрғақ көзімен жыласын
Dialogue: 0,0:23:27.60,0:23:31.06,Default,,0,0,0,,НАҒЫЗ ХАЛЫҚТЫҚ КӨКТЕР
Dialogue: 0,0:23:31.20,0:23:39.46,Default,,0,0,0,,Мен жай ғана шынайы қайғыны білгім келеді
Dialogue: 0,0:23:39.56,0:23:51.43,Default,,0,0,0,,Балшық өзеніне батырылған өмір соншалықты жаман емес
Dialogue: 0,0:23:51.53,0:24:00.33,Default,,0,0,0,,Егер ол тек бір рет аяқталса
Dialogue: 0,0:24:18.03,0:24:20.60,Default,,0,0,0,,Тұрақтылық – бұл дүниенің заңы
Dialogue: 0,0:24:22.36,0:24:24.30,Default,,0,0,0,,Өркендеу мен сәтсіздік қоңырауы соғылады.
Dialogue: 0,0:24:24.86,0:24:27.10,Default,,0,0,0,,Ақша - әлемді айналдыратын нәрсе.
Dialogue: 0,0:24:27.96,0:24:30.60,Default,,0,0,0,,Бір күні таудай қарыз
Dialogue: 0,0:24:31.93,0:24:34.16,Default,,0,0,0,,Ғаламның сыртында ағып, ағып жатқан
Dialogue: 0,0:24:34.63,0:24:36.50,Default,,0,0,0,,Мен ковбойды кездестірдім
Dialogue: 0,0:24:37.50,0:24:39.46,Default,,0,0,0,,Күлсіз әуенмен
Dialogue: 0,0:24:40.13,0:24:41.53,Default,,0,0,0,,Ойнату сеансы
Dialogue: 0,0:24:42.43,0:24:43.76,Default,,0,0,0,,«Хонки Тонк әйелдері»
Dialogue: 0,0:24:45.26,0:24:50.26,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
