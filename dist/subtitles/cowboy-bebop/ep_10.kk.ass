Dialogue: 0,0:02:34.46,0:02:36.86,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:02:37.00,0:02:39.76,Default,,0,0,0,,-няаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:02:39.90,0:02:43.83,Default,,0,0,0,,-Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:03:11.53,0:03:12.46,Default,,0,0,0,,Эй Джет
Dialogue: 0,0:03:12.73,0:03:13.36,Default,,0,0,0,,Иә
Dialogue: 0,0:03:13.93,0:03:16.06,Default,,0,0,0,,Мен қонғанша қанша уақыт болатынын сұрадым.
Dialogue: 0,0:03:16.36,0:03:17.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:19.90,0:03:21.63,Default,,0,0,0,,Сіз сонда қанша уақыт болдыңыз?
Dialogue: 0,0:03:21.93,0:03:23.16,Default,,0,0,0,,Мен онда біраз уақыт болдым.
Dialogue: 0,0:03:23.73,0:03:24.56,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:24.76,0:03:26.53,Default,,0,0,0,,Неге сонша жалқаусың?
Dialogue: 0,0:03:26.96,0:03:28.96,Default,,0,0,0,,Менің жүлдем әлі бар ма?
Dialogue: 0,0:03:29.03,0:03:32.50,Default,,0,0,0,,Тез жағаға шығып, ыстық, ауырған мойынды бер.
Dialogue: 0,0:03:32.56,0:03:36.70,Default,,0,0,0,,Иә? Эй, сен әлі қонуға рұқсат алған жоқсың ба?
Dialogue: 0,0:03:37.23,0:03:40.20,Default,,0,0,0,,Білемін, сендер шулысыңдар.
Dialogue: 0,0:03:40.56,0:03:42.33,Default,,0,0,0,,Көп дүрбелеңге түспеңіз.
Dialogue: 0,0:03:43.46,0:03:44.90,Default,,0,0,0,,Мен әуежайға қамқор боламын.
Dialogue: 0,0:03:47.80,0:03:50.40,Default,,0,0,0,,Ганимед сіздің туған қалаңыз, солай ма?
Dialogue: 0,0:03:51.00,0:03:54.90,Default,,0,0,0,,Бір ғажабы, сен де баяғыда сені жылатып жіберген әйелді есіңе түсірдің, солай емес пе?
Dialogue: 0,0:03:55.06,0:03:55.60,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:04:00.63,0:04:03.10,Default,,0,0,0,,Немесе мені жылатқан әйел болды.
Dialogue: 0,0:04:03.66,0:04:05.30,Default,,0,0,0,,Менің айтқанымды естімей тұрсың ба?
Dialogue: 0,0:04:05.46,0:04:09.26,Default,,0,0,0,,Иә, бұл Ганимед полициясы.
Dialogue: 0,0:04:09.50,0:04:10.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:10.43,0:04:10.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.66,0:04:12.80,Default,,0,0,0,,Доннелли
Dialogue: 0,0:04:12.93,0:04:15.13,Default,,0,0,0,,Джет Джет?
Dialogue: 0,0:04:15.83,0:04:21.06,Default,,0,0,0,,Эй, мен күте алмаймын. Отсуму әбден сергітілді, бірақ бұл әрине реактивті ұшақ.
Dialogue: 0,0:04:21.96,0:04:24.03,Default,,0,0,0,,Біраз уақыт өтті, Доннелли.
Dialogue: 0,0:04:24.23,0:04:27.93,Default,,0,0,0,,Сіздің осында жұмыс істегеніңізге таң қалдым.
Dialogue: 0,0:04:28.56,0:04:33.10,Default,,0,0,0,,Бұл жеті-сегіз жыл бұрын болды. Жер бетінде кенеттен не болды?
Dialogue: 0,0:04:33.60,0:04:35.66,Default,,0,0,0,,Мен сыйлықты тапсырғым келеді.
Dialogue: 0,0:04:35.93,0:04:39.83,Default,,0,0,0,,Қалаған нөмір EX41285 Baker Panciorello
Dialogue: 0,0:04:41.36,0:04:44.10,Default,,0,0,0,,Ей, сен сыйлы аңшысың.
Dialogue: 0,0:04:45.56,0:04:50.36,Default,,0,0,0,,Қара ит атанған сен бе?
Dialogue: 0,0:04:50.76,0:04:54.16,Default,,0,0,0,,Мен сізді баяғыда зейнетке шықтым деп ойладым.
Dialogue: 0,0:04:54.23,0:04:59.86,Default,,0,0,0,,Не, бұл жігіттер әлі де белсенді. Бұл жылдамдықта уақытты босқа өткізе алмайсыз.
Dialogue: 0,0:04:59.93,0:05:01.36,Default,,0,0,0,,Сіз Рип Ван Винкл
Dialogue: 0,0:05:01.73,0:05:03.76,Default,,0,0,0,,-Не, сіз бұрынғы полиция қызметкері болдыңыз ба? - Аналогия кері.
Dialogue: 0,0:05:03.93,0:05:05.33,Default,,0,0,0,,-Бұл мағынасы бар -Жақсы, бұл екі жағдайда да жақсы.
Dialogue: 0,0:05:05.36,0:05:05.93,Default,,0,0,0,,Не?
Dialogue: 0,0:05:06.20,0:05:07.10,Default,,0,0,0,,Сіздің сау көрінгеніңізге қуаныштымын.
Dialogue: 0,0:05:07.13,0:05:08.76,Default,,0,0,0,,-Екеуміз жараспайды деп ойладым -Ой, сен де.
Dialogue: 0,0:05:09.80,0:05:12.06,Default,,0,0,0,,Иә, ол не деді?
Dialogue: 0,0:05:13.46,0:05:16.36,Default,,0,0,0,,​​Міне, дәл солай, Ариса.
Dialogue: 0,0:05:16.60,0:05:17.10,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:24.73,0:05:28.80,Default,,0,0,0,,Ол Малбис портында дүкен жұмыс істейді.
Dialogue: 0,0:05:29.06,0:05:31.83,Default,,0,0,0,,Бұл Лаффан деп аталатын шағын бар.
Dialogue: 0,0:05:32.60,0:05:37.10,Default,,0,0,0,,Бірақ бұл құлдырау, адамдар қарызбен күресіп жатқанын естідім.
Dialogue: 0,0:05:37.96,0:05:43.23,Default,,0,0,0,,Жалғыз тұратын әйелдің басынан өткеретін жағдайлар көп.
Dialogue: 0,0:06:32.30,0:06:34.26,Default,,0,0,0,,Бұл Нанивабуши, сөзсіз.
Dialogue: 0,0:06:34.93,0:06:37.13,Default,,0,0,0,,Бұл Таманың туған қаласы. Мен де оны көруге барамын.
Dialogue: 0,0:06:38.03,0:06:42.43,Default,,0,0,0,,Егер сіз бұрынғы әйел сізді әлі де ойлайды деп ойласаңыз, қателесесіз.
Dialogue: 0,0:06:44.26,0:06:48.26,Default,,0,0,0,,Егер сіз барлық әйелдерді өзіңіз сияқты деп ойласаңыз, сіз үлкен қателесесіз.
Dialogue: 0,0:06:48.33,0:06:50.90,Default,,0,0,0,,Нанива Буши Катсуобуши
Dialogue: 0,0:06:53.36,0:06:54.73,Default,,0,0,0,,Нағыз адам
Dialogue: 0,0:07:00.53,0:07:03.13,Default,,0,0,0,,Сіз үмітсіз романтиксіз.
Dialogue: 0,0:07:06.30,0:07:08.73,Default,,0,0,0,,Эй, эй, неге бояп жатырсың?
Dialogue: 0,0:07:10.06,0:07:15.76,Default,,0,0,0,,Пайдасыз болып көрінетін күш-жігердің жинақталуы әдемі теріні сақтайтынын түсінесіз бе?
Dialogue: 0,0:07:17.46,0:07:18.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:18.90,0:07:19.40,Default,,0,0,0,,Уф
Dialogue: 0,0:07:19.90,0:07:22.26,Default,,0,0,0,,Жарайды, пайда жоқ, пайда жоқ.
Dialogue: 0,0:07:22.60,0:07:23.10,Default,,0,0,0,,Ит
Dialogue: 0,0:07:24.03,0:07:24.90,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:36.73,0:07:37.23,Default,,0,0,0,,Га
Dialogue: 0,0:07:40.16,0:07:43.36,Default,,0,0,0,,Бұл Лафан.
Dialogue: 0,0:07:44.86,0:07:46.73,Default,,0,0,0,,О, сен ше?
Dialogue: 0,0:07:47.56,0:07:48.63,Default,,0,0,0,,Нни
Dialogue: 0,0:07:49.16,0:07:50.40,Default,,0,0,0,,Ескі таныс
Dialogue: 0,0:07:51.20,0:07:53.23,Default,,0,0,0,,Мұнда келгеніме біраз уақыт болды.
Dialogue: 0,0:07:54.13,0:07:56.43,Default,,0,0,0,,Ариса ол жерде жоқ
Dialogue: 0,0:07:58.33,0:07:58.93,Default,,0,0,0,,Ағын
Dialogue: 0,0:07:59.46,0:07:59.96,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:08:01.50,0:08:04.00,Default,,0,0,0,,Бұл шынымен реактивті ұшақ па?
Dialogue: 0,0:08:06.20,0:08:06.70,Default,,0,0,0,,О
Dialogue: 0,0:08:06.76,0:08:11.70,Default,,0,0,0,,Линдт Бұл адам менің тұтынушым. Жарайды.
Dialogue: 0,0:08:18.06,0:08:18.73,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:08:19.66,0:08:20.16,Default,,0,0,0,,Иә
Dialogue: 0,0:08:21.23,0:08:24.80,Default,,0,0,0,,Неліктен оның орнына ішуге болмайды?
Dialogue: 0,0:08:31.23,0:08:33.23,Default,,0,0,0,,Сіз соңғы тұтынушысыз
Dialogue: 0,0:08:33.76,0:08:34.63,Default,,0,0,0,,Хмм?
Dialogue: 0,0:08:34.86,0:08:35.96,Default,,0,0,0,,Дүкенді жабыңыз
Dialogue: 0,0:08:36.80,0:08:39.73,Default,,0,0,0,,Кемелердің азаюымен бұл аймақ жалғыз қалды.
Dialogue: 0,0:08:40.36,0:08:42.26,Default,,0,0,0,,Мен жаңа қалаға көшуді ойлап жүрмін.
Dialogue: 0,0:08:44.03,0:08:45.20,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:08:45.46,0:08:45.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:46.50,0:08:52.26,Default,,0,0,0,,Жаңа қалқымалы қалада құқық төлемдері қымбат және бұл қиын болуы керек.
Dialogue: 0,0:08:53.10,0:08:54.60,Default,,0,0,0,,Фуфуфуфу
Dialogue: 0,0:08:54.93,0:08:55.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:56.53,0:08:59.03,Default,,0,0,0,,Бұл да сіз сияқты, бұл туралы алаңдамаңыз.
Dialogue: 0,0:09:00.50,0:09:02.66,Default,,0,0,0,,Мен жаңа қалада көңіл-күйімді өзгертуді жоспарлап отырмын.
Dialogue: 0,0:09:03.56,0:09:05.83,Default,,0,0,0,,Уайымдамаңыз, Линт те осында.
Dialogue: 0,0:09:09.50,0:09:11.23,Default,,0,0,0,,Иә, бұл бұрынғы жігіт.
Dialogue: 0,0:09:11.60,0:09:12.36,Default,,0,0,0,,Сізге қызық па?
Dialogue: 0,0:09:12.46,0:09:14.96,Default,,0,0,0,,Иә? Бұл белгілі болды
Dialogue: 0,0:09:15.26,0:09:17.43,Default,,0,0,0,,Менің үш балам бар.
Dialogue: 0,0:09:17.66,0:09:18.16,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:09:19.06,0:09:21.80,Default,,0,0,0,,Хехехе, әзілдеп тұрмын. Жай ойнам айттым.
Dialogue: 0,0:09:22.60,0:09:24.30,Default,,0,0,0,,Линт - жай ғана ғашық
Dialogue: 0,0:09:25.46,0:09:28.43,Default,,0,0,0,,Сіз не істеп жатырсыз? Сіз әлі үйлендіңіз бе?
Dialogue: 0,0:09:29.06,0:09:31.53,Default,,0,0,0,,Бейтаныс адамдармен саяхаттау
Dialogue: 0,0:09:32.73,0:09:35.06,Default,,0,0,0,,Кішіпейіл сыйлы аңшы.
Dialogue: 0,0:09:35.43,0:09:35.93,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:09:45.20,0:09:46.30,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:09:53.56,0:09:54.13,Default,,0,0,0,,Джет туралы не деуге болады?
Dialogue: 0,0:09:55.06,0:09:56.20,Default,,0,0,0,,Бұл аз уақытқа.
Dialogue: 0,0:09:57.03,0:09:59.06,Default,,0,0,0,,Сен менің досымсың, солай ма?
Dialogue: 0,0:09:59.16,0:09:59.66,Default,,0,0,0,,О
Dialogue: 0,0:10:01.16,0:10:03.10,Default,,0,0,0,,Сыйлық басы туралы мәліметтер бар.
Dialogue: 0,0:10:04.26,0:10:06.20,Default,,0,0,0,,Ол әлі көпшілікке жарияланған жоқ.
Dialogue: 0,0:10:08.16,0:10:09.83,Default,,0,0,0,,Хмммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:10:10.63,0:10:11.83,Default,,0,0,0,,Линт Телониус
Dialogue: 0,0:10:12.66,0:10:14.96,Default,,0,0,0,,Мальбис портынан шыққан қаскөй.
Dialogue: 0,0:10:15.53,0:10:21.06,Default,,0,0,0,,Кеше түнде мен қаржы брокері Лоренцоны көрдім, ол өте зұлым еді.
Dialogue: 0,0:10:21.93,0:10:22.76,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:10:23.90,0:10:24.40,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:10:26.23,0:10:28.20,Default,,0,0,0,,Линт - Арисаның түсі
Dialogue: 0,0:10:30.10,0:10:31.73,Default,,0,0,0,,Сіз маған хабарлауыңыз керек деп ойлаймын.
Dialogue: 0,0:10:34.30,0:10:36.06,Default,,0,0,0,,Жүлде мөлшері қандай?
Dialogue: 0,0:11:09.06,0:11:09.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:10.06,0:11:10.73,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:24.43,0:11:25.23,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:11:41.06,0:11:44.10,Default,,0,0,0,,Ол кезде мен жұмыстан үйге келгенде
Dialogue: 0,0:11:44.63,0:11:46.30,Default,,0,0,0,,Сен мені үнемі күтіп жүрдің
Dialogue: 0,0:11:47.03,0:11:49.60,Default,,0,0,0,,Бұл мен үшін жеткілікті болды.
Dialogue: 0,0:11:52.46,0:11:53.50,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:11:53.93,0:11:55.23,Default,,0,0,0,,Бірақ сол күні
Dialogue: 0,0:12:00.40,0:12:04.03,Default,,0,0,0,,Мен қайтып келгенде, сол сағат қана қалды.
Dialogue: 0,0:12:05.20,0:12:09.53,Default,,0,0,0,,Жазылған хатпен бірге бір сөз, қош бол.
Dialogue: 0,0:12:12.23,0:12:16.23,Default,,0,0,0,,Бір қызығы, мен ешқандай мұңды сезінбедім.
Dialogue: 0,0:12:17.16,0:12:20.66,Default,,0,0,0,,Бұл жай ғана шынайы сезілген жоқ.
Dialogue: 0,0:12:22.16,0:12:28.06,Default,,0,0,0,,Мен ішімде бір нәрсенің бірте-бірте сал болып жатқанын сездім.
Dialogue: 0,0:12:31.20,0:12:33.70,Default,,0,0,0,,Жарты жылдан кейін мен ставка жасадым.
Dialogue: 0,0:12:34.50,0:12:39.10,Default,,0,0,0,,Егер бұл сағат тоқтаса және сіз әлі оралмасаңыз
Dialogue: 0,0:12:40.70,0:12:42.53,Default,,0,0,0,,Бұл планетаны тастап кетейік
Dialogue: 0,0:12:45.03,0:12:46.96,Default,,0,0,0,,Мен сені кінәлау үшін келген жоқпын.
Dialogue: 0,0:12:47.60,0:12:50.03,Default,,0,0,0,,Мен жай ғана білгім келді
Dialogue: 0,0:12:51.93,0:12:54.70,Default,,0,0,0,,Сенің сол кезде жоғалып кеткен себебің
Dialogue: 0,0:12:58.03,0:12:59.40,Default,,0,0,0,,Сіздің ішіңізде
Dialogue: 0,0:13:01.10,0:13:03.70,Default,,0,0,0,,Уақыт Ганимедке тоқтаған сияқты.
Dialogue: 0,0:13:07.03,0:13:08.76,Default,,0,0,0,,Бұл көп уақыт бұрын болды.
Dialogue: 0,0:13:11.60,0:13:13.90,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:13:18.30,0:13:20.00,Default,,0,0,0,,Маған қозғалмау үшін уақыт қажет емес.
Dialogue: 0,0:13:22.36,0:13:24.10,Default,,0,0,0,,Қош бол Джет
Dialogue: 0,0:13:57.53,0:13:58.70,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:13:58.86,0:13:59.36,Default,,0,0,0,,Га
Dialogue: 0,0:14:29.20,0:14:30.66,Default,,0,0,0,,Сыйлықты аңшы ма?
Dialogue: 0,0:14:31.30,0:14:31.90,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:33.83,0:14:35.96,Default,,0,0,0,,-Ринт -Ах, сен мені іздеп келдің.
Dialogue: 0,0:14:36.33,0:14:39.46,Default,,0,0,0,,Ха... қарғыс атсын, жолда сыйлық бар ма?
Dialogue: 0,0:14:40.50,0:14:44.13,Default,,0,0,0,,Артық емес, артық емес.
Dialogue: 0,0:14:44.70,0:14:45.86,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:14:46.60,0:14:47.96,Default,,0,0,0,,Бұл сенің кінәң емес.
Dialogue: 0,0:14:48.43,0:14:51.96,Default,,0,0,0,,Себебі мен ол жігіттен қарызға ақша алдым.
Dialogue: 0,0:14:53.66,0:14:55.80,Default,,0,0,0,,Сен мені қорғамадың.
Dialogue: 0,0:14:55.86,0:14:58.30,Default,,0,0,0,,Хехе, ұсталып қалсам, сені құтқара алмаймын.
Dialogue: 0,0:14:59.63,0:15:03.63,Default,,0,0,0,,Мен оны өлтірдім.
Dialogue: 0,0:15:06.30,0:15:07.10,Default,,0,0,0,,Қашайық
Dialogue: 0,0:15:08.40,0:15:08.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:09.60,0:15:11.10,Default,,0,0,0,,Екеуміз ғана қашайық.
Dialogue: 0,0:15:28.56,0:15:29.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:41.96,0:15:44.40,Default,,0,0,0,,Маған әдеттегі мінез-құлық ұнайды.
Dialogue: 0,0:15:49.60,0:15:50.83,Default,,0,0,0,,Кешіріңіз, бірақ бұл бизнес.
Dialogue: 0,0:16:04.56,0:16:06.73,Default,,0,0,0,,-Куун -Куккуу... Де...
Dialogue: 0,0:16:07.03,0:16:08.03,Default,,0,0,0,,Тұтқаны сұраңыз Хмм...
Dialogue: 0,0:16:25.50,0:16:26.00,Default,,0,0,0,,Ха
Dialogue: 0,0:16:34.50,0:16:35.00,Default,,0,0,0,,Уф
Dialogue: 0,0:16:35.20,0:16:35.70,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:16:37.30,0:16:37.80,Default,,0,0,0,,Ммм
Dialogue: 0,0:16:42.93,0:16:43.43,Default,,0,0,0,,Иә
Dialogue: 0,0:16:44.26,0:16:45.20,Default,,0,0,0,,Ей, не болып жатыр?
Dialogue: 0,0:16:45.90,0:16:47.76,Default,,0,0,0,,1,8 миллион басты қуып келеді
Dialogue: 0,0:16:48.13,0:16:48.86,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:16:49.33,0:16:50.50,Default,,0,0,0,,Мен оны қазір сол жерге жіберемін.
Dialogue: 0,0:16:52.30,0:16:53.90,Default,,0,0,0,,Yatsuga Bounty
Dialogue: 0,0:16:54.00,0:16:56.43,Default,,0,0,0,,Ах, Доннеллиден алынған ішкі ақпарат.
Dialogue: 0,0:16:56.80,0:16:58.40,Default,,0,0,0,,​​Қарыз беруден бас тартқанға ұқсайды.
Dialogue: 0,0:17:00.50,0:17:01.33,Default,,0,0,0,,Әй
Dialogue: 0,0:17:07.70,0:17:09.83,Default,,0,0,0,,Мен мұны істеймін, сен қайтасың.
Dialogue: 0,0:17:12.36,0:17:14.16,Default,,0,0,0,,Сіз оны жіберіп алмайсыз деп ойлаймын.
Dialogue: 0,0:17:14.96,0:17:17.30,Default,,0,0,0,,Бұл мен полиция қызметкері болған жер.
Dialogue: 0,0:17:18.36,0:17:21.06,Default,,0,0,0,,Бір тістесе жібермейтін қара ит.
Dialogue: 0,0:17:23.63,0:17:27.50,Default,,0,0,0,,Мен әйел ретінде еш өкінбеймін, бірақ мен бұл аралға жауапты боламын.
Dialogue: 0,0:17:29.23,0:17:31.46,Default,,0,0,0,,Бұл Нанива Буши.
Dialogue: 0,0:17:37.33,0:17:40.80,Default,,0,0,0,,Сіз мені ести аласыз ба? Қазір қайықты тоқтат.
Dialogue: 0,0:17:41.93,0:17:42.46,Default,,0,0,0,,Ұшақ?
Dialogue: 0,0:17:42.60,0:17:43.20,Default,,0,0,0,,Күй
Dialogue: 0,0:17:50.43,0:17:51.16,Default,,0,0,0,,Хуи чит
Dialogue: 0,0:18:01.36,0:18:01.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:14.36,0:18:16.10,Default,,0,0,0,,Фуфуфуфуфуфу…
Dialogue: 0,0:18:34.93,0:18:35.56,Default,,0,0,0,,-Уау -Уау
Dialogue: 0,0:18:39.80,0:18:40.30,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:18:49.33,0:18:50.23,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:53.13,0:18:54.03,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:57.03,0:18:59.23,Default,,0,0,0,,Кукукукухи
Dialogue: 0,0:19:36.06,0:19:36.70,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:37.43,0:19:38.26,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:19:39.53,0:19:41.56,Default,,0,0,0,,Хааааааааааа...
Dialogue: 0,0:19:50.33,0:19:51.26,Default,,0,0,0,,Келме
Dialogue: 0,0:19:54.40,0:19:55.96,Default,,0,0,0,,Өтінемін, жіберіп алмаңыз
Dialogue: 0,0:19:59.73,0:20:02.93,Default,,0,0,0,,Мұнда басқа да сыйақылар бар.
Dialogue: 0,0:20:04.73,0:20:09.20,Default,,0,0,0,,Сағынсам да, ақыры біреу келеді
Dialogue: 0,0:20:09.96,0:20:11.93,Default,,0,0,0,,Менімен қалсаң, сен де сыбайлас боласың.
Dialogue: 0,0:20:12.03,0:20:12.63,Default,,0,0,0,,Келме
Dialogue: 0,0:20:14.70,0:20:16.10,Default,,0,0,0,,Қазір әлі уақыт бар
Dialogue: 0,0:20:16.66,0:20:18.20,Default,,0,0,0,,Енді бұл туралы алаңдамаңыз
Dialogue: 0,0:20:24.50,0:20:29.40,Default,,0,0,0,,Ха ха ха ха... су... ха ха ха ха ха... ха...
Dialogue: 0,0:20:32.40,0:20:34.03,Default,,0,0,0,,Ол кезде де солай болған.
Dialogue: 0,0:20:34.30,0:20:34.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:35.76,0:20:39.90,Default,,0,0,0,,Қандай шешім қабылдасаңыз да, ол әрқашан дұрыс
Dialogue: 0,0:20:41.06,0:20:44.80,Default,,0,0,0,,Мен сенімен бірге болғанда, мен ештеңе істеудің қажеті жоқ
Dialogue: 0,0:20:45.70,0:20:50.33,Default,,0,0,0,,Баладай жазықсыз құшағыңа ілінсем ғой.
Dialogue: 0,0:20:53.40,0:20:56.96,Default,,0,0,0,,Мен өз өмір жолымды шешкім келді.
Dialogue: 0,0:20:59.06,0:21:01.36,Default,,0,0,0,,Тіпті қате болса да
Dialogue: 0,0:21:11.63,0:21:14.66,Default,,0,0,0,,Фуфууууууууууууу
Dialogue: 0,0:21:16.80,0:21:17.43,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:17.70,0:21:22.33,Default,,0,0,0,,-Хмм -Хмм... Уау, мені жібер. Мен ақымақ болғанды ​​ұнатпаймын. Мені жіберіңізші.
Dialogue: 0,0:21:22.36,0:21:25.33,Default,,0,0,0,,Хехехе, көмектесіңізші, өтінемін, көмектесіңізші, өтінемін
Dialogue: 0,0:21:25.36,0:21:26.13,Default,,0,0,0,,-Ммм ааа -хмм
Dialogue: 0,0:21:32.36,0:21:37.23,Default,,0,0,0,,Күшті бол және мені қорға
Dialogue: 0,0:21:37.46,0:21:38.70,Default,,0,0,0,,Хи хи хи хи... хи... хи...
Dialogue: 0,0:21:52.93,0:21:55.03,Default,,0,0,0,,Бұл өзін-өзі қорғау мәселесі сияқты.
Dialogue: 0,0:21:59.93,0:22:01.30,Default,,0,0,0,,Миста, мен ашпын.
Dialogue: 0,0:22:02.20,0:22:04.10,Default,,0,0,0,,Мен енді ешқайда кетпеймін
Dialogue: 0,0:22:05.86,0:22:08.53,Default,,0,0,0,,Мен Линдтті сол дүкенде күтемін.
Dialogue: 0,0:22:10.03,0:22:11.73,Default,,0,0,0,,Бұл көп уақытты қажет етпейді.
Dialogue: 0,0:22:12.76,0:22:14.83,Default,,0,0,0,,Уақыт өтіп жатыр ғой.
Dialogue: 0,0:22:16.33,0:22:16.83,Default,,0,0,0,,Иә
Dialogue: 0,0:22:17.96,0:22:18.46,Default,,0,0,0,,Га
Dialogue: 0,0:22:23.53,0:22:24.13,Default,,0,0,0,,Хмм?
Dialogue: 0,0:22:30.00,0:22:30.70,Default,,0,0,0,,Эххе
Dialogue: 0,0:22:52.76,0:22:57.66,Default,,0,0,0,,Мен сені сүйдім деп күйіну
Dialogue: 0,0:22:58.30,0:23:02.80,Default,,0,0,0,,Тым көп уақыт өтті
Dialogue: 0,0:23:04.70,0:23:09.76,Default,,0,0,0,,Менің жүрегім әлі де жаралы
Dialogue: 0,0:23:10.33,0:23:14.60,Default,,0,0,0,,Емсіз жел соғып тұр
Dialogue: 0,0:23:17.13,0:23:24.86,Default,,0,0,0,,Біреу құрғақ көзімен жыласын
Dialogue: 0,0:23:27.76,0:23:30.96,Default,,0,0,0,,НАҒЫЗ ХАЛЫҚТЫҚ КӨКТЕР
Dialogue: 0,0:23:31.23,0:23:39.60,Default,,0,0,0,,Мен жай ғана шынайы қайғыны білгім келеді
Dialogue: 0,0:23:39.70,0:23:51.66,Default,,0,0,0,,Балшық өзеніне батырылған өмір соншалықты жаман емес
Dialogue: 0,0:23:51.76,0:23:59.93,Default,,0,0,0,,Егер ол тек бір рет аяқталса
Dialogue: 0,0:24:16.46,0:24:19.66,Default,,0,0,0,,Бебопты бұрын-соңды болмаған үрей биледі
Dialogue: 0,0:24:19.80,0:24:20.73,Default,,0,0,0,,Хяаааааааааааа
Dialogue: 0,0:24:20.83,0:24:24.20,Default,,0,0,0,,Тағы бір құрбан көзге көрінбейтін жаудың улы азуының құрбаны болды.
Dialogue: 0,0:24:24.30,0:24:25.70,Default,,0,0,0,,Жооооооооооооо
Dialogue: 0,0:24:25.80,0:24:30.20,Default,,0,0,0,,Бұл қорқынышты көзге көрінбейтін жау кім?
Dialogue: 0,0:24:30.30,0:24:31.50,Default,,0,0,0,,Няаааааааааааааааааааааааааааааа
Dialogue: 0,0:24:31.60,0:24:36.10,Default,,0,0,0,,Сізді қорқыныштың тереңіне батыратын сұмдық симфония
Dialogue: 0,0:24:36.20,0:24:39.40,Default,,0,0,0,,Келесі жолы «Қараңғы түндегі ауыр рок»
Dialogue: 0,0:24:39.90,0:24:44.36,Default,,0,0,0,,Арнаны реттесеңіз, енді қашып құтыла алмайсыз
Dialogue: 0,0:24:45.86,0:24:50.86,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
