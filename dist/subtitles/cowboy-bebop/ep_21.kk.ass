Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.63,0:00:17.30,Default,,0,0,0,,Менің ойымша, бұл Scence арқылы соққы беру уақыты
Dialogue: 0,0:00:17.36,0:00:19.06,Default,,0,0,0,,Барлығын бірге жинаңыз
Dialogue: 0,0:00:19.66,0:00:22.00,Default,,0,0,0,,Жарайды 3 2 1 Кептелейік
Dialogue: 0,0:01:50.16,0:01:52.16,Default,,0,0,0,,Бұл оғаш оқиға қалай басталды?
Dialogue: 0,0:01:52.60,0:01:54.46,Default,,0,0,0,,Күн ызғарлы ыстық болды.
Dialogue: 0,0:01:55.46,0:01:58.80,Default,,0,0,0,,Мен кенеттен ескі танысымнан электрондық хат алдым.
Dialogue: 0,0:01:59.06,0:01:59.66,Default,,0,0,0,,Мәтін
Dialogue: 0,0:01:59.73,0:02:01.46,Default,,0,0,0,,Мұның бәрі осы болды.
Dialogue: 0,0:02:01.66,0:02:02.66,Default,,0,0,0,,Куун
Dialogue: 0,0:02:02.83,0:02:04.66,Default,,0,0,0,,«Қорқадан қасиетті аңды табыңыз
Dialogue: 0,0:02:05.50,0:02:07.70,Default,,0,0,0,,Мен төрт құдайға лайықпын.
Dialogue: 0,0:02:07.76,0:02:08.33,Default,,0,0,0,,Иә»
Dialogue: 0,0:02:22.83,0:02:23.90,Default,,0,0,0,,Жіберушінің паосы
Dialogue: 0,0:02:24.10,0:02:25.30,Default,,0,0,0,,Біз таныс болсақ та
Dialogue: 0,0:02:25.56,0:02:27.43,Default,,0,0,0,,Біз онша жақын емес едік.
Dialogue: 0,0:02:28.46,0:02:31.93,Default,,0,0,0,,Күдікті сезініп, мен Паоның қайда екенін зерттеуді шештім.
Dialogue: 0,0:02:32.86,0:02:34.13,Default,,0,0,0,,Пао осында, Марста
Dialogue: 0,0:02:34.40,0:02:37.46,Default,,0,0,0,,Ол үш саусақты фэн-шуйдің шебері дейді.
Dialogue: 0,0:02:38.06,0:02:39.73,Default,,0,0,0,,Мен қайда екенімді білгенде
Dialogue: 0,0:02:40.06,0:02:42.80,Default,,0,0,0,,Ол енді бұл дүниеде болмады.
Dialogue: 0,0:02:50.70,0:02:53.50,Default,,0,0,0,,Сіз маған электрондық поштаны жібердіңіз деп ойлаймын.
Dialogue: 0,0:02:54.00,0:02:55.73,Default,,0,0,0,,Ура жын қақпасынан келгендер
Dialogue: 0,0:02:56.76,0:03:00.20,Default,,0,0,0,,Мен аспанның дауысын естіп, сені Күн тасқа апарамын.
Dialogue: 0,0:03:01.43,0:03:02.70,Default,,0,0,0,,Хакке оракулына сәйкес
Dialogue: 0,0:03:02.93,0:03:03.66,Default,,0,0,0,,Э?
Dialogue: 0,0:03:04.03,0:03:04.60,Default,,0,0,0,,Ах
Dialogue: 0,0:03:05.00,0:03:05.53,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:03:06.26,0:03:06.76,Default,,0,0,0,,Бірақ олай болмас қой?
Dialogue: 0,0:03:07.96,0:03:08.93,Default,,0,0,0,,Сіз қайда ұрып жатырсыз?
Dialogue: 0,0:03:10.43,0:03:11.30,Default,,0,0,0,,Иә
Dialogue: 0,0:03:14.16,0:03:16.06,Default,,0,0,0,,Міне солар азапқа лайық адамдар.
Dialogue: 0,0:03:16.43,0:03:16.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:19.36,0:03:20.13,Default,,0,0,0,,Шығу жолына қарай
Dialogue: 0,0:03:21.86,0:03:22.36,Default,,0,0,0,,Ой
Dialogue: 0,0:03:23.26,0:03:24.10,Default,,0,0,0,,Ой ой
Dialogue: 0,0:03:27.80,0:03:28.40,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:03:28.50,0:03:29.03,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:03:31.66,0:03:32.80,Default,,0,0,0,,Эй, эй, эй
Dialogue: 0,0:03:38.76,0:03:40.76,Default,,0,0,0,,-nku -eii
Dialogue: 0,0:03:43.20,0:03:43.73,Default,,0,0,0,,Шығу жолы
Dialogue: 0,0:03:53.66,0:03:54.30,Default,,0,0,0,,Жердің Qi
Dialogue: 0,0:03:56.06,0:03:56.73,Default,,0,0,0,,Эй
Dialogue: 0,0:04:08.13,0:04:11.53,Default,,0,0,0,,Пва ха ха ха ха ха
Dialogue: 0,0:04:12.10,0:04:13.80,Default,,0,0,0,,Бұл жақын қоңырау.
Dialogue: 0,0:04:14.40,0:04:15.16,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:16.46,0:04:18.23,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:04:21.83,0:04:23.06,Default,,0,0,0,,Он алтылық
Dialogue: 0,0:04:33.76,0:04:34.66,Default,,0,0,0,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:04:34.93,0:04:36.90,Default,,0,0,0,,Әй, бұл кім?
Dialogue: 0,0:04:37.00,0:04:37.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:38.76,0:04:39.90,Default,,0,0,0,,Жарайды, кел.
Dialogue: 0,0:04:40.53,0:04:41.96,Default,,0,0,0,,Жаңа ғашық болуы мүмкін
Dialogue: 0,0:04:42.63,0:04:44.26,Default,,0,0,0,,Ол өте жас.
Dialogue: 0,0:04:44.33,0:04:46.53,Default,,0,0,0,,Біртүрлі Сәбіз Айджин
Dialogue: 0,0:04:46.60,0:04:47.53,Default,,0,0,0,,Жасырын бала т.б.
Dialogue: 0,0:04:48.33,0:04:49.76,Default,,0,0,0,,Ол өте кәрі қыз.
Dialogue: 0,0:04:49.83,0:04:52.23,Default,,0,0,0,,Бала жұмсақ Wildo
Dialogue: 0,0:04:54.40,0:04:56.33,Default,,0,0,0,,Бірақ мен таң қалдым.
Dialogue: 0,0:04:56.40,0:04:59.70,Default,,0,0,0,,Пао қызының соншалықты үлкен болғанына сене алмаймын.
Dialogue: 0,0:04:59.83,0:05:00.33,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:05:00.76,0:05:02.66,Default,,0,0,0,,Есіңізде жоқ шығар.
Dialogue: 0,0:05:03.03,0:05:06.06,Default,,0,0,0,,Мен сені әлі жас кезімде кездестірдім.
Dialogue: 0,0:05:07.76,0:05:10.26,Default,,0,0,0,,Әкеңді қайдан білесің?
Dialogue: 0,0:05:10.60,0:05:12.43,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:12.80,0:05:15.86,Default,,0,0,0,,Біз жай ғана таныспыз, 10 жыл өтті.
Dialogue: 0,0:05:16.76,0:05:20.20,Default,,0,0,0,,​​Бірақ қарттың жол-көлік оқиғасы да жолы болмайды.
Dialogue: 0,0:05:21.23,0:05:22.70,Default,,0,0,0,,Юпитерге барар жолда
Dialogue: 0,0:05:22.96,0:05:26.76,Default,,0,0,0,,Фазалар айырымы кеңістігінде кеңістік-уақыттың кенет бұрмалануы орын алады.
Dialogue: 0,0:05:27.46,0:05:29.43,Default,,0,0,0,,Мияу
Dialogue: 0,0:05:30.13,0:05:31.10,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:31.80,0:05:32.43,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:05:33.23,0:05:33.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:36.00,0:05:37.10,Default,,0,0,0,,Сіз қожайынсыз ба?
Dialogue: 0,0:05:37.16,0:05:37.76,Default,,0,0,0,,Буфууу
Dialogue: 0,0:05:38.10,0:05:38.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:39.10,0:05:40.76,Default,,0,0,0,,Сіз жасырын баласыз ба?
Dialogue: 0,0:05:40.80,0:05:42.73,Default,,0,0,0,,Жақсы, жақсы
Dialogue: 0,0:05:42.93,0:05:43.60,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:47.96,0:05:50.26,Default,,0,0,0,,Гёкусай
Dialogue: 0,0:05:54.40,0:05:56.23,Default,,0,0,0,,Джет мырза, неге зиратта?
Dialogue: 0,0:05:57.26,0:06:00.13,Default,,0,0,0,,Әкемнің апатқа ұшырағанын отбасымнан басқа ешкім білмеді.
Dialogue: 0,0:06:07.56,0:06:09.96,Default,,0,0,0,,«Қорқадан қасиетті аңды табыңыз
Dialogue: 0,0:06:10.56,0:06:13.03,Default,,0,0,0,,Мен төрт құдайға лайықпын».
Dialogue: 0,0:06:14.16,0:06:14.86,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:15.80,0:06:18.36,Default,,0,0,0,,Маған Паодан жіберілді
Dialogue: 0,0:06:18.43,0:06:19.26,Default,,0,0,0,,Қашан?
Dialogue: 0,0:06:19.46,0:06:20.60,Default,,0,0,0,,Үш күн бұрын
Dialogue: 0,0:06:20.96,0:06:22.46,Default,,0,0,0,,Оқиғаның алдында
Dialogue: 0,0:06:24.96,0:06:25.83,Default,,0,0,0,,Жарайды, мен кеттім. Қош бол.
Dialogue: 0,0:06:26.23,0:06:27.53,Default,,0,0,0,,Маған көмектесіңізші
Dialogue: 0,0:06:27.80,0:06:28.53,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:29.30,0:06:29.90,Default,,0,0,0,,Бұл болуы керек
Dialogue: 0,0:06:30.40,0:06:31.53,Default,,0,0,0,,Күн тасы қайда?
Dialogue: 0,0:06:31.93,0:06:33.26,Default,,0,0,0,,Күн тас?
Dialogue: 0,0:06:33.70,0:06:36.83,Default,,0,0,0,,Сіз пайда болған бағыт
Dialogue: 0,0:06:37.00,0:06:38.73,Default,,0,0,0,,Ай, күн және уақыт Фэн Шуй тұрғысынан ең жақсы.
Dialogue: 0,0:06:39.46,0:06:41.16,Default,,0,0,0,,Әсіресе бірдеңені іздегенде
Dialogue: 0,0:06:41.93,0:06:42.96,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:43.10,0:06:45.76,Default,,0,0,0,,Дұрыс, өтінемін, Джет мырза.
Dialogue: 0,0:06:47.96,0:06:49.90,Default,,0,0,0,,Иә, жақын арада
Dialogue: 0,0:06:50.83,0:06:52.20,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,0:06:52.80,0:06:54.06,Default,,0,0,0,,Бастықтың көңіл-күйі
Dialogue: 0,0:06:54.43,0:06:55.43,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:06:55.86,0:06:56.93,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:06:57.20,0:06:58.23,Default,,0,0,0,,Олай болса
Dialogue: 0,0:06:58.96,0:06:59.66,Default,,0,0,0,,Кеттік
Dialogue: 0,0:07:02.00,0:07:04.46,Default,,0,0,0,,Паода да, осы қызда да
Dialogue: 0,0:07:04.53,0:07:05.63,Default,,0,0,0,,Мен ерекше қарыздар сияқты емес едім.
Dialogue: 0,0:07:06.03,0:07:08.06,Default,,0,0,0,,Мен әзірше ынтымақтастық туралы шешім қабылдадым.
Dialogue: 0,0:07:08.93,0:07:11.63,Default,,0,0,0,,Жалғыз қалдыру үшін уайымдайтын нәрселер тым көп болды.
Dialogue: 0,0:07:12.66,0:07:13.16,Default,,0,0,0,,Неліктен Пао өлмес бұрын маған электрондық хат жіберді?
Dialogue: 0,0:07:13.26,0:07:15.63,Default,,0,0,0,,Өлер алдында неге маған электрондық хат жібердің?
Dialogue: 0,0:07:16.26,0:07:17.46,Default,,0,0,0,,Бұл сөздер
Dialogue: 0,0:07:17.63,0:07:18.23,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:07:19.10,0:07:21.40,Default,,0,0,0,,Бізге шабуыл жасаған адамдар кімдер?
Dialogue: 0,0:07:23.00,0:07:25.20,Default,,0,0,0,,Бұл қыздың да аты Майфа.
Dialogue: 0,0:07:25.36,0:07:27.03,Default,,0,0,0,,Мені алаңдатқан бір нәрсе болды.
Dialogue: 0,0:07:28.86,0:07:30.30,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:07:42.40,0:07:45.13,Default,,0,0,0,,Бұл ғалам үш Циден тұрады.
Dialogue: 0,0:07:45.80,0:07:47.00,Default,,0,0,0,,Бұл аспан рухы
Dialogue: 0,0:07:47.56,0:07:50.00,Default,,0,0,0,,Яғни күннен келетін энергия және
Dialogue: 0,0:07:50.63,0:07:51.20,Default,,0,0,0,,Жердің Qi
Dialogue: 0,0:07:51.83,0:07:54.86,Default,,0,0,0,,Басқаша айтқанда, сол планетаның жерден көтерілетін энергиясы
Dialogue: 0,0:07:55.53,0:07:56.40,Default,,0,0,0,,Және магнетизм
Dialogue: 0,0:07:57.13,0:08:00.10,Default,,0,0,0,,Басқаша айтқанда, ол тірі ағзалар ретінде бізден шығатын Ци.
Dialogue: 0,0:08:00.63,0:08:02.10,Default,,0,0,0,,Тірі заттардың киі?
Dialogue: 0,0:08:02.70,0:08:06.23,Default,,0,0,0,,Адам ағзасында әрқашан магнит өрісі болады.
Dialogue: 0,0:08:07.10,0:08:09.13,Default,,0,0,0,,Бұл магнит өрісі мен жердің магнит өрісі дегеніміз не?
Dialogue: 0,0:08:09.70,0:08:11.80,Default,,0,0,0,,Олар бір-бірімен әрекет ету арқылы әрекет етеді.
Dialogue: 0,0:08:12.70,0:08:15.06,Default,,0,0,0,,Табиғат энергиясын оқу
Dialogue: 0,0:08:15.26,0:08:16.73,Default,,0,0,0,,Қолданылатын технология
Dialogue: 0,0:08:16.80,0:08:17.93,Default,,0,0,0,,Бұл ғарыштық фэн шуй.
Dialogue: 0,0:08:22.26,0:08:22.76,Default,,0,0,0,,Сыртта ма, іште ме? Жоғары ма, төмен бе?
Dialogue: 0,0:08:23.20,0:08:23.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:24.13,0:08:24.63,Default,,0,0,0,,Ah, a juru
Dialogue: 0,0:08:26.33,0:08:28.06,Default,,0,0,0,,Ғарыштық фэн шуй
Dialogue: 0,0:08:29.00,0:08:30.90,Default,,0,0,0,,Оның болжау сияқты нәрседен айырмашылығы бар ма?
Dialogue: 0,0:08:31.60,0:08:35.13,Default,,0,0,0,,Сәуегейліктің басқа түрлері, ең көп дегенде, болжау және болжау.
Dialogue: 0,0:08:35.50,0:08:36.86,Default,,0,0,0,,Бірақ ғарыштық фэн шуй
Dialogue: 0,0:08:37.30,0:08:39.43,Default,,0,0,0,,Оның бақытсыздықты бақытқа айналдыратын күші бар.
Dialogue: 0,0:08:40.13,0:08:43.86,Default,,0,0,0,,Мысалы, егер сіз әкеңіз сияқты күшке ие фэн-шуй шебері болсаңыз.
Dialogue: 0,0:08:45.30,0:08:47.30,Default,,0,0,0,,Хмм, не болды?
Dialogue: 0,0:08:49.00,0:08:52.76,Default,,0,0,0,,Мен әкеммен бұлай уақыт өткізген емеспін деп ойлаймын.
Dialogue: 0,0:08:53.33,0:08:56.56,Default,,0,0,0,,Эй, эй, мен онша жас емеспін.
Dialogue: 0,0:08:56.86,0:08:59.20,Default,,0,0,0,,Ғашық сияқты
Dialogue: 0,0:09:01.10,0:09:03.63,Default,,0,0,0,,Иә, ғашықтар жаман.
Dialogue: 0,0:09:03.76,0:09:05.90,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:06.53,0:09:08.96,Default,,0,0,0,,Ең болмағанда ағасы немесе басқасы бар.
Dialogue: 0,0:09:09.93,0:09:10.63,Default,,0,0,0,,Сыртта ма, іште ме? Жоғары ма, төмен бе?
Dialogue: 0,0:09:11.03,0:09:11.53,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:09:11.96,0:09:12.90,Default,,0,0,0,,Мұз
Dialogue: 0,0:09:13.36,0:09:17.86,Default,,0,0,0,,Nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn
Dialogue: 0,0:09:19.46,0:09:21.10,Default,,0,0,0,,Уухо, кеттік, Джет-сан.
Dialogue: 0,0:09:26.43,0:09:28.86,Default,,0,0,0,,Қорқыныш дегеніміз не? Мүмкін осында.
Dialogue: 0,0:09:29.50,0:09:31.06,Default,,0,0,0,,Тау қонақ үйінің ғимараты туралы
Dialogue: 0,0:09:33.86,0:09:34.53,Default,,0,0,0,,Осымен.
Dialogue: 0,0:09:41.86,0:09:42.50,Default,,0,0,0,,Сейрю
Dialogue: 0,0:09:52.23,0:09:52.76,Default,,0,0,0,,Бякко
Dialogue: 0,0:09:56.23,0:09:56.76,Default,,0,0,0,,Генбу
Dialogue: 0,0:10:00.80,0:10:01.40,Default,,0,0,0,,Созаку
Dialogue: 0,0:10:01.96,0:10:02.83,Default,,0,0,0,,Ой
Dialogue: 0,0:10:03.43,0:10:05.70,Default,,0,0,0,,Мен Теншин крест заңын түсінемін
Dialogue: 0,0:10:13.53,0:10:14.86,Default,,0,0,0,,Күн тас осында
Dialogue: 0,0:10:15.23,0:10:16.46,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:10:26.56,0:10:28.60,Default,,0,0,0,,-nnnnnn -ititatashitaze
Dialogue: 0,0:10:28.66,0:10:29.50,Default,,0,0,0,,Йоши
Dialogue: 0,0:10:47.56,0:10:48.36,Default,,0,0,0,,Ммм
Dialogue: 0,0:10:49.60,0:10:51.03,Default,,0,0,0,,Хмм, ә
Dialogue: 0,0:10:51.43,0:10:52.20,Default,,0,0,0,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:10:54.86,0:10:56.00,Default,,0,0,0,,Ақырында мен оны таптым.
Dialogue: 0,0:10:57.20,0:10:58.53,Default,,0,0,0,,Бұл күн тасы.
Dialogue: 0,0:10:58.93,0:11:00.43,Default,,0,0,0,,Осыған ұқсас нәрсе бар ма?
Dialogue: 0,0:11:10.40,0:11:10.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:11.26,0:11:12.13,Default,,0,0,0,,Джет мырза?
Dialogue: 0,0:11:18.16,0:11:19.70,Default,,0,0,0,,-Хехехе Хэхехе -Ахаха Хахаха
Dialogue: 0,0:11:21.23,0:11:22.16,Default,,0,0,0,,-Ах -Ах
Dialogue: 0,0:11:22.20,0:11:23.10,Default,,0,0,0,,-Аа -Жолдан кет.
Dialogue: 0,0:11:23.53,0:11:24.70,Default,,0,0,0,,-Не істеп жатырсың? -Ах
Dialogue: 0,0:11:25.63,0:11:28.13,Default,,0,0,0,,Бір бөтелке ескі саке, шыны керек емес
Dialogue: 0,0:11:36.30,0:11:36.96,Default,,0,0,0,,Ммм
Dialogue: 0,0:11:37.03,0:11:37.76,Default,,0,0,0,,-Хун -Доаией
Dialogue: 0,0:11:38.26,0:11:39.60,Default,,0,0,0,,-Ой уау -Иә
Dialogue: 0,0:11:39.73,0:11:40.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:40.63,0:11:41.83,Default,,0,0,0,,-Міне, -Ууууууууууу
Dialogue: 0,0:11:45.06,0:11:47.06,Default,,0,0,0,,Уау
Dialogue: 0,0:11:47.83,0:11:48.33,Default,,0,0,0,,Иә
Dialogue: 0,0:11:49.03,0:11:51.06,Default,,0,0,0,,Эй, балалар, не істеп жатырсыңдар?
Dialogue: 0,0:11:51.53,0:11:54.83,Default,,0,0,0,,Ей, сіз оңай жұмыстан шығасыз деп ойлайсыз ба?
Dialogue: 0,0:11:54.90,0:11:59.56,Default,,0,0,0,,Уау! Бұл көк жыланның ісі.
Dialogue: 0,0:11:59.63,0:12:01.46,Default,,0,0,0,,​​Мұның бәрі ұйымға қатысты.
Dialogue: 0,0:12:02.06,0:12:03.83,Default,,0,0,0,,Неліктен бізді айналып жүрсің?
Dialogue: 0,0:12:04.20,0:12:08.00,Default,,0,0,0,,Мен өлтірілсем де айта алмайтын жалғыз нәрсе осы.
Dialogue: 0,0:12:08.16,0:12:09.26,Default,,0,0,0,,-Гррр -Мм
Dialogue: 0,0:12:09.33,0:12:11.83,Default,,0,0,0,,Мен Па Паоды сағындым.
Dialogue: 0,0:12:12.13,0:12:15.43,Default,,0,0,0,,Одан электрондық хатты алушыны табыңыз.
Dialogue: 0,0:12:16.50,0:12:18.70,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:12:18.80,0:12:22.16,Default,,0,0,0,,Біз төмен адамдармыз, сондықтан бұдан көп нәрсені білмейміз.
Dialogue: 0,0:12:22.23,0:12:23.46,Default,,0,0,0,,Гуи Куу Гу
Dialogue: 0,0:12:23.63,0:12:25.00,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:12:25.06,0:12:25.90,Default,,0,0,0,,-nnn -гуа
Dialogue: 0,0:12:27.96,0:12:30.33,Default,,0,0,0,,-Хехехехехехе -Хахахахахаха
Dialogue: 0,0:12:31.16,0:12:31.96,Default,,0,0,0,,Джет мырза
Dialogue: 0,0:12:32.26,0:12:32.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:33.80,0:12:36.06,Default,,0,0,0,,Менің әкем тірі ме?
Dialogue: 0,0:12:39.46,0:12:42.66,Default,,0,0,0,,Паоның сөздері бұл тастың орнын көрсетті.
Dialogue: 0,0:12:43.46,0:12:44.30,Default,,0,0,0,,Киіз үй әлі
Dialogue: 0,0:12:44.80,0:12:46.36,Default,,0,0,0,,Сіз бір жерде тірісіз бе?
Dialogue: 0,0:12:47.16,0:12:51.36,Default,,0,0,0,,Бұл тасты тапқанда не істеуімді қаладың?
Dialogue: 0,0:12:51.93,0:12:55.56,Default,,0,0,0,,Жұмбақ шешілгеннен гөрі тереңдей түскендей.
Dialogue: 0,0:12:56.66,0:12:57.50,Default,,0,0,0,,Әзірше мен
Dialogue: 0,0:12:58.30,0:13:01.66,Default,,0,0,0,,Мен бұл тасты зерттеуді жөн көрдім, бұл жалғыз анықтама болды.
Dialogue: 0,0:13:08.03,0:13:11.76,Default,,0,0,0,,50 жыл бұрын апатқа ұшыраған қақпадан айдың бір бөлігі
Dialogue: 0,0:13:12.33,0:13:16.30,Default,,0,0,0,,Біздің фэн-шуй шеберлерінің арасында ол Күн тасы деп аталады.
Dialogue: 0,0:13:17.06,0:13:19.90,Default,,0,0,0,,Кеңістік-уақыттың бұрмалануын сіңіру керемет
Dialogue: 0,0:13:19.96,0:13:21.40,Default,,0,0,0,,Оның жасырын энергиясы бар.
Dialogue: 0,0:13:22.10,0:13:22.90,Default,,0,0,0,,ау
Dialogue: 0,0:13:23.70,0:13:26.06,Default,,0,0,0,,-Тастан басқа ештеңеге ұқсамайды. - О, Кехо, Кехо.
Dialogue: 0,0:13:26.60,0:13:29.43,Default,,0,0,0,,-Сонымен? Мен оны сатсам, қанша тұрады?
Dialogue: 0,0:13:29.50,0:13:30.46,Default,,0,0,0,,Сәлем, балалар
Dialogue: 0,0:13:31.30,0:13:33.30,Default,,0,0,0,,Темекі тартқыңыз келсе, оны сыртта жасаңыз.
Dialogue: 0,0:13:33.46,0:13:36.70,Default,,0,0,0,,Эй, мен де үнемі темекі шекпеймін.
Dialogue: 0,0:13:36.80,0:13:38.93,Default,,0,0,0,,Бүгіннен бастап мұнда темекі шегуге тыйым салынады.
Dialogue: 0,0:13:39.20,0:13:40.76,Default,,0,0,0,,Эй, сен қалжыңдап тұрсың.
Dialogue: 0,0:13:41.60,0:13:45.00,Default,,0,0,0,,Бұл кеме менікі, сіз білесіз бе?
Dialogue: 0,0:13:54.16,0:13:54.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:55.40,0:13:56.23,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:56.86,0:13:57.40,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:13:58.03,0:13:59.86,Default,,0,0,0,,Бұл тасты не істейміз?
Dialogue: 0,0:14:00.40,0:14:01.00,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:14:01.73,0:14:02.96,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:14:03.80,0:14:06.20,Default,,0,0,0,,Менің әкем не ойлайды?
Dialogue: 0,0:14:07.03,0:14:07.53,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:14:08.36,0:14:09.73,Default,,0,0,0,,-Хахаха -н о ой мында
Dialogue: 0,0:14:10.03,0:14:11.26,Default,,0,0,0,,Күтемін
Dialogue: 0,0:14:14.86,0:14:15.63,Default,,0,0,0,,Мияу?
Dialogue: 0,0:14:18.76,0:14:19.66,Default,,0,0,0,,Луобанга
Dialogue: 0,0:14:20.03,0:14:20.83,Default,,0,0,0,,Не?
Dialogue: 0,0:14:21.13,0:14:22.16,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:14:22.23,0:14:23.73,Default,,0,0,0,,Магнит жойылса да
Dialogue: 0,0:14:26.00,0:14:28.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:28.53,0:14:29.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:29.53,0:14:30.83,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:31.33,0:14:32.20,Default,,0,0,0,,Няня?
Dialogue: 0,0:14:32.66,0:14:33.70,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:33.83,0:14:35.13,Default,,0,0,0,,Аун Хун
Dialogue: 0,0:14:45.20,0:14:47.83,Default,,0,0,0,,Менің әкемнің де күн тасы болғанына сенімдімін.
Dialogue: 0,0:14:48.63,0:14:51.00,Default,,0,0,0,,Бұл тастардың бір-бірін тартуынан туындаса керек.
Dialogue: 0,0:14:51.46,0:14:53.56,Default,,0,0,0,,Менің ойымша, бұл менің әкемнің қайда екенін көрсетеді.
Dialogue: 0,0:14:53.63,0:14:57.26,Default,,0,0,0,,Сонда Пао сізді осы тасты іздеуге мәжбүр етті ме?
Dialogue: 0,0:14:58.06,0:14:58.63,Default,,0,0,0,,Бірақ
Dialogue: 0,0:14:59.76,0:15:02.66,Default,,0,0,0,,​​Әкем Джетт мырзаға электрондық поштаны неліктен жіберді деп ойлаймын.
Dialogue: 0,0:15:04.03,0:15:05.96,Default,,0,0,0,,Мен емес
Dialogue: 0,0:15:12.73,0:15:13.83,Default,,0,0,0,,Ni?
Dialogue: 0,0:15:15.40,0:15:17.60,Default,,0,0,0,,Мяу мияу
Dialogue: 0,0:15:22.36,0:15:23.30,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:15:23.70,0:15:24.96,Default,,0,0,0,,Бұл жақсы комбинация емес пе?
Dialogue: 0,0:15:25.40,0:15:27.46,Default,,0,0,0,,Мұндай адам қауіпті емес пе?
Dialogue: 0,0:15:27.80,0:15:28.36,Default,,0,0,0,,Не
Dialogue: 0,0:15:29.06,0:15:31.43,Default,,0,0,0,,Жас кезінде байсалды болған еркектер көбірек
Dialogue: 0,0:15:31.86,0:15:35.06,Default,,0,0,0,,Жасы үлкен болса да, олар жас балаларға араласуға тырысады.
Dialogue: 0,0:15:35.60,0:15:36.20,Default,,0,0,0,,Ақыр соңында?
Dialogue: 0,0:15:36.76,0:15:39.13,Default,,0,0,0,,Ер адамдар да логикалық емес.
Dialogue: 0,0:15:40.76,0:15:41.53,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:15:42.33,0:15:45.66,Default,,0,0,0,,Ғарыштық фэн-шуйге ғана сеніңіз, адамдарға сенбеңіз
Dialogue: 0,0:15:46.16,0:15:47.23,Default,,0,0,0,,Ол сондай болды.
Dialogue: 0,0:15:48.36,0:15:49.20,Default,,0,0,0,,Сонымен менің анам
Dialogue: 0,0:15:49.70,0:15:51.60,Default,,0,0,0,,Ол мені өзімен бірге ертіп, үйден кетіп қалды.
Dialogue: 0,0:15:52.73,0:15:53.70,Default,,0,0,0,,7 жыл бұрын
Dialogue: 0,0:15:56.53,0:16:01.56,Default,,0,0,0,,Әкем біз тұрған жерді бірден тауып алар еді.
Dialogue: 0,0:16:02.40,0:16:04.70,Default,,0,0,0,,Әкем мені іздеген де жоқ.
Dialogue: 0,0:16:05.53,0:16:07.50,Default,,0,0,0,,Жағдайлар болған болуы керек.
Dialogue: 0,0:16:08.33,0:16:10.83,Default,,0,0,0,,Неліктен менің әкем сол адамдар тарапынан нысанаға алынды?
Dialogue: 0,0:16:11.36,0:16:12.40,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:16:12.50,0:16:14.23,Default,,0,0,0,,Жаман адамдармен дос болғаны үшін бе?
Dialogue: 0,0:16:15.76,0:16:18.13,Default,,0,0,0,,Өтінемін, маған шындықты айтыңыз.
Dialogue: 0,0:16:20.20,0:16:22.33,Default,,0,0,0,,Әкемнің шынайы келбеті
Dialogue: 0,0:16:24.70,0:16:25.73,Default,,0,0,0,,Киіз үй
Dialogue: 0,0:16:26.76,0:16:28.80,Default,,0,0,0,,Ұйымда кеңесші болып жұмыс істеді
Dialogue: 0,0:16:29.46,0:16:30.60,Default,,0,0,0,,Бұл факт
Dialogue: 0,0:16:31.56,0:16:35.70,Default,,0,0,0,,Пао маған детектив болған кезде ұйым туралы ақпаратты берді.
Dialogue: 0,0:16:36.36,0:16:39.63,Default,,0,0,0,,Сол кезде Пао ұйымнан кеткісі келді.
Dialogue: 0,0:16:40.20,0:16:40.80,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:41.46,0:16:47.00,Default,,0,0,0,,Ұйымның маңызды құпияларын білетін адамның қашып кетуі мүмкін емес.
Dialogue: 0,0:16:50.50,0:16:55.60,Default,,0,0,0,,Пао өз отбасына көбірек қиындық тудырудан қорықты.
Dialogue: 0,0:16:56.46,0:17:00.66,Default,,0,0,0,,Егер сіз оны кездестірсеңіз, оны өзіңіз тексеріңіз.
Dialogue: 0,0:17:09.96,0:17:11.83,Default,,0,0,0,,Ммм аа
Dialogue: 0,0:17:12.56,0:17:14.76,Default,,0,0,0,,Мяу мияу
Dialogue: 0,0:17:16.36,0:17:18.26,Default,,0,0,0,,Міне, осы жерде
Dialogue: 0,0:17:25.56,0:17:26.80,Default,,0,0,0,,Ештеңе.
Dialogue: 0,0:17:27.26,0:17:27.96,Default,,0,0,0,,Радар - бұл
Dialogue: 0,0:17:28.40,0:17:29.23,Default,,0,0,0,,Жауап жоқ
Dialogue: 0,0:17:29.30,0:17:32.33,Default,,0,0,0,,Бұл міндетті түрде осы жер болуы керек.
Dialogue: 0,0:17:33.26,0:17:33.76,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:17:34.10,0:17:34.60,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:35.33,0:17:35.83,Default,,0,0,0,,Қазірше тек сен мен мен ғана оралдық.
Dialogue: 0,0:17:39.96,0:17:40.63,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:41.30,0:17:41.96,Default,,0,0,0,,Сіз тұтынушысыз ба?
Dialogue: 0,0:17:42.40,0:17:43.90,Default,,0,0,0,,Олар табанды.
Dialogue: 0,0:17:44.06,0:17:45.63,Default,,0,0,0,,Спайк Fay сұрауы
Dialogue: 0,0:17:45.80,0:17:47.20,Default,,0,0,0,,Мен сіздің тұтынушыңыз емеспін.
Dialogue: 0,0:17:47.46,0:17:48.00,Default,,0,0,0,,О мм
Dialogue: 0,0:17:49.60,0:17:52.53,Default,,0,0,0,,Егер мен бұл кемемен өз-өзіме қол жұмсағым келмесе, мен ынтымақтасатын едім.
Dialogue: 0,0:17:58.76,0:18:00.23,Default,,0,0,0,,Бұл өте нашар лотерея.
Dialogue: 0,0:18:01.83,0:18:03.50,Default,,0,0,0,,Табыстар мен шығындарды анда-санда қысқарту жақсы.
Dialogue: 0,0:18:04.20,0:18:06.83,Default,,0,0,0,,Ол ханшайымдардың армандарын орындайтын пері.
Dialogue: 0,0:18:06.90,0:18:07.83,Default,,0,0,0,,Сіз?
Dialogue: 0,0:18:14.56,0:18:15.56,Default,,0,0,0,,​​Бұл дрон ма?
Dialogue: 0,0:18:16.10,0:18:18.33,Default,,0,0,0,,Жеті ергежейлі туралы бірдеңе?
Dialogue: 0,0:18:22.36,0:18:23.36,Default,,0,0,0,,-Ах аа -хмм хмм
Dialogue: 0,0:18:23.43,0:18:25.36,Default,,0,0,0,,Қарғыс атсын, мен оны тастаймын.
Dialogue: 0,0:18:25.43,0:18:26.73,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:18:34.83,0:18:35.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:41.03,0:18:42.50,Default,,0,0,0,,Спайк, қайтып кел.
Dialogue: 0,0:18:42.63,0:18:43.13,Default,,0,0,0,,Не?
Dialogue: 0,0:18:43.73,0:18:46.10,Default,,0,0,0,,Мысал тасқа жоғары энергия қолданылғанда,
Dialogue: 0,0:18:46.60,0:18:47.60,Default,,0,0,0,,Ішінде қамалған
Dialogue: 0,0:18:47.66,0:18:49.36,Default,,0,0,0,,Ол қуатты шығарып алатын сияқты.
Dialogue: 0,0:18:49.66,0:18:51.30,Default,,0,0,0,,Сонда мен не істеуім керек?
Dialogue: 0,0:18:51.56,0:18:54.00,Default,,0,0,0,,Бұл жоғары тәуекелді стратегия.
Dialogue: 0,0:19:00.06,0:19:01.93,Default,,0,0,0,,Не істесең де, тез істе.
Dialogue: 0,0:19:04.93,0:19:05.76,Default,,0,0,0,,Мен оны қойдым.
Dialogue: 0,0:19:06.06,0:19:06.76,Default,,0,0,0,,Йоши
Dialogue: 0,0:19:12.16,0:19:14.50,Default,,0,0,0,,Бұл тасты плазмалық зеңбірекпен жарып тастаңыз.
Dialogue: 0,0:19:15.10,0:19:16.86,Default,,0,0,0,,Бұл үлкен жоспар.
Dialogue: 0,0:20:10.90,0:20:11.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:15.26,0:20:17.10,Default,,0,0,0,,Сіз оны уақытында орындадыңыз ба, Джет?
Dialogue: 0,0:20:17.43,0:20:17.96,Default,,0,0,0,,Га
Dialogue: 0,0:20:18.40,0:20:19.93,Default,,0,0,0,,Сізге
Dialogue: 0,0:20:20.80,0:20:23.26,Default,,0,0,0,,Мейфа Біраз уақыт өтті.
Dialogue: 0,0:20:23.46,0:20:23.96,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:20:24.50,0:20:25.23,Default,,0,0,0,,Ахаха
Dialogue: 0,0:20:30.83,0:20:33.23,Default,,0,0,0,,Пао: Бұл тұрақсыз аймақ.
Dialogue: 0,0:20:33.50,0:20:34.86,Default,,0,0,0,,Мен бұдан артық жақындай алмаймын.
Dialogue: 0,0:20:35.46,0:20:39.03,Default,,0,0,0,,Білемін, бәрібір бізде оттегі таусылған.
Dialogue: 0,0:20:39.53,0:20:40.03,Default,,0,0,0,,Га
Dialogue: 0,0:20:40.96,0:20:46.63,Default,,0,0,0,,Қызымды осында әкелуіңізді қалағандықтан, мен сізге электрондық хат жібердім.
Dialogue: 0,0:20:47.66,0:20:50.33,Default,,0,0,0,,Сонымен, біз осылай көрінеміз
Dialogue: 0,0:20:51.16,0:20:53.56,Default,,0,0,0,,Бұл сіздің фэн шуйіңіздің үлгісі ме?
Dialogue: 0,0:20:54.10,0:20:55.16,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:04.06,0:21:07.93,Default,,0,0,0,,Жоқ, Пао, сіз оны орнатпадыңыз.
Dialogue: 0,0:21:08.73,0:21:10.46,Default,,0,0,0,,Мейфа осында.
Dialogue: 0,0:21:11.43,0:21:13.83,Default,,0,0,0,,Өйткені оның өзі осында келгісі келді.
Dialogue: 0,0:21:14.03,0:21:17.36,Default,,0,0,0,,Хмм, солай болуы мүмкін.
Dialogue: 0,0:21:18.53,0:21:21.10,Default,,0,0,0,,Мүмкін мен мақтанған болармын.
Dialogue: 0,0:21:24.93,0:21:29.76,Default,,0,0,0,,Мейфа Мен сені кездестіргеніме қуаныштымын.
Dialogue: 0,0:21:30.90,0:21:31.60,Default,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,0:21:33.13,0:21:34.63,Default,,0,0,0,,Мен сені жек көрдім
Dialogue: 0,0:21:36.96,0:21:37.60,Default,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,0:21:38.10,0:21:39.20,Default,,0,0,0,,Мен сені жек көрдім
Dialogue: 0,0:21:44.33,0:21:45.43,Default,,0,0,0,,Және де
Dialogue: 0,0:21:52.63,0:21:54.36,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:21:55.46,0:21:55.96,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:22:08.56,0:22:12.06,Default,,0,0,0,,Оны өзіммен бірге алып кету жақсы болды ма, әлде жаман болды ма?
Dialogue: 0,0:22:12.76,0:22:14.46,Default,,0,0,0,,сонымен бірге үнемі патрульде болдым.
Dialogue: 0,0:22:15.13,0:22:17.93,Default,,0,0,0,,Қалай болғанда да, бұл оғаш оқиға осылай аяқталады.
Dialogue: 0,0:22:18.73,0:22:20.63,Default,,0,0,0,,Ол Марсқа қайта оралды
Dialogue: 0,0:22:21.63,0:22:23.76,Default,,0,0,0,,Және қонақ бөлмеде темекі шегуге тыйым салынды.
Dialogue: 0,0:22:24.76,0:22:25.80,Default,,0,0,0,,Мен мазасызданып, ашушаң боламын
Dialogue: 0,0:22:26.43,0:22:28.23,Default,,0,0,0,,Ештеңе өзгермеген күндер қайта оралды.
Dialogue: 0,0:22:29.30,0:22:31.33,Default,,0,0,0,,Өзгерген жалғыз нәрсе
Dialogue: 0,0:22:32.26,0:22:35.06,Default,,0,0,0,,Жалғыз нәрсе болды, мен журналдардың болжамды беттерін оқуды тоқтаттым.
Dialogue: 0,0:22:52.70,0:22:57.66,Default,,0,0,0,,Мен сені сүйдім деп күйіну
Dialogue: 0,0:22:58.23,0:23:02.70,Default,,0,0,0,,Тым көп уақыт өтті
Dialogue: 0,0:23:04.63,0:23:09.66,Default,,0,0,0,,Менің жүрегім әлі де жаралы
Dialogue: 0,0:23:10.23,0:23:14.50,Default,,0,0,0,,Емсіз жел соғып тұр
Dialogue: 0,0:23:16.86,0:23:25.00,Default,,0,0,0,,Біреу құрғақ көзімен жыласын
Dialogue: 0,0:23:27.66,0:23:30.93,Default,,0,0,0,,НАҒЫЗ ХАЛЫҚТЫҚ КӨКТЕР
Dialogue: 0,0:23:31.26,0:23:39.43,Default,,0,0,0,,Мен жай ғана шынайы қайғыны білгім келеді
Dialogue: 0,0:23:39.50,0:23:51.66,Default,,0,0,0,,Балшық өзеніне батырылған өмір соншалықты жаман емес
Dialogue: 0,0:23:51.90,0:24:00.33,Default,,0,0,0,,Егер ол тек бір рет аяқталса
Dialogue: 0,0:24:15.90,0:24:16.63,Default,,0,0,0,,Жігіт
Dialogue: 0,0:24:17.30,0:24:18.80,Default,,0,0,0,,Ысқырықпен келді
Dialogue: 0,0:24:28.36,0:24:30.86,Default,,0,0,0,,Энди, кенеттен ат үстінде пайда болған адам
Dialogue: 0,0:24:31.53,0:24:32.90,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:24:33.30,0:24:34.60,Default,,0,0,0,,Жау ма әлде одақтас па?
Dialogue: 0,0:24:34.80,0:24:36.83,Default,,0,0,0,,Әлде бұл нағыз ковбой ма?
Dialogue: 0,0:24:37.53,0:24:38.03,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:24:38.16,0:24:40.03,Default,,0,0,0,,Шокерлік SF макаронының алып басылымы
Dialogue: 0,0:24:40.36,0:24:41.50,Default,,0,0,0,,«Ковбой Фанк»
Dialogue: 0,0:24:42.00,0:24:44.33,Default,,0,0,0,,Біздің дүниетанымымыз сәл басқаша емес пе?
Dialogue: 0,0:24:45.83,0:24:50.83,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
