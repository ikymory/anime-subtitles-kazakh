Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.53,0:00:17.13,Default,,0,0,0,,Менің ойымша, бұл Scence арқылы соққы беру уақыты
Dialogue: 0,0:00:17.26,0:00:18.73,Default,,0,0,0,,Барлығын бірге жинаңыз
Dialogue: 0,0:00:19.70,0:00:21.96,Default,,0,0,0,,Жарайды 3 2 1 Кептелейік
Dialogue: 0,0:01:59.10,0:02:00.20,Default,,0,0,0,,Fa
Dialogue: 0,0:02:00.33,0:02:00.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:15.43,0:02:16.66,Default,,0,0,0,,Әдемі қастар
Dialogue: 0,0:02:17.16,0:02:19.03,Default,,0,0,0,,Мөлдір тістер
Dialogue: 0,0:02:22.56,0:02:24.26,Default,,0,0,0,,Тез бай болыңыз
Dialogue: 0,0:02:25.46,0:02:26.46,Default,,0,0,0,,Уф
Dialogue: 0,0:02:27.00,0:02:28.46,Default,,0,0,0,,Бірінші тұтынушы банрай
Dialogue: 0,0:02:28.76,0:02:29.26,Default,,0,0,0,,Ах
Dialogue: 0,0:02:36.33,0:02:37.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:37.26,0:02:38.76,Default,,0,0,0,,Сіз жекпе-жек негіздерін білесіз бе?
Dialogue: 0,0:02:41.80,0:02:42.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:44.93,0:02:45.66,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:02:48.63,0:02:49.33,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:02:51.93,0:02:54.10,Default,,0,0,0,,Алдын ала соққы!
Dialogue: 0,0:02:56.43,0:02:57.20,Default,,0,0,0,,Ах
Dialogue: 0,0:02:58.10,0:02:59.46,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:02.80,0:03:06.86,Default,,0,0,0,,Иә, иә, иә
Dialogue: 0,0:03:12.36,0:03:14.53,Default,,0,0,0,,Әдептілікпен қарсы алу
Dialogue: 0,0:03:25.76,0:03:28.10,Default,,0,0,0,,Жылдам соққы және покер шебері
Dialogue: 0,0:03:29.43,0:03:32.60,Default,,0,0,0,,Аты аңызға айналған құмар ойыншы Покер Алиса?
Dialogue: 0,0:03:33.13,0:03:35.13,Default,,0,0,0,,Мен сенің тірі екеніңді білмедім.
Dialogue: 0,0:03:35.83,0:03:38.93,Default,,0,0,0,,Ол тірі болғанда 219 жаста болар еді.
Dialogue: 0,0:03:39.63,0:03:40.30,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:40.76,0:03:44.16,Default,,0,0,0,,200 жастан асқаныңызға сене алмаймын.
Dialogue: 0,0:03:44.86,0:03:47.03,Default,,0,0,0,,Уф
Dialogue: 0,0:03:48.13,0:03:50.60,Default,,0,0,0,,Ал Алиса өмірінде ешқашан жеңілген емес.
Dialogue: 0,0:03:51.23,0:03:53.36,Default,,0,0,0,,Алдамай ақша табуды жалғастырды
Dialogue: 0,0:03:54.06,0:03:56.13,Default,,0,0,0,,Бұлай деуге сенде дәлел бар ма деп ойлаймын.
Dialogue: 0,0:03:57.40,0:04:00.13,Default,,0,0,0,,Сізде үлкен көлемде қарыз бар деп естідім.
Dialogue: 0,0:04:02.43,0:04:06.30,Default,,0,0,0,,Сізге қайсысы ұнайды, полиция ма әлде менің дүкенім бе?
Dialogue: 0,0:04:29.90,0:04:31.13,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:04:32.36,0:04:33.83,Default,,0,0,0,,Чарли айтты
Dialogue: 0,0:04:34.20,0:04:36.10,Default,,0,0,0,,«Қолсыз қолды жууға болмайды.
Dialogue: 0,0:04:36.50,0:04:38.96,Default,,0,0,0,,Егер бірдеңе алғың келсе, алдымен бер».
Dialogue: 0,0:04:39.43,0:04:40.86,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:04:41.33,0:04:43.96,Default,,0,0,0,,Чарли саған мұны істе деп жатқан жоқ па?
Dialogue: 0,0:04:44.50,0:04:45.96,Default,,0,0,0,,Хехе, дұрыс айтасыз.
Dialogue: 0,0:04:46.30,0:04:49.30,Default,,0,0,0,,Чарли Паркер Гетенің нақыл сөздерін айта ма?
Dialogue: 0,0:04:49.66,0:04:52.06,Default,,0,0,0,,Жарайды, бұл арман оқиғасы.
Dialogue: 0,0:04:52.70,0:04:56.06,Default,,0,0,0,,Жолбарыстың күшігінің 5000 оолонғы да арман болып жоғалады.
Dialogue: 0,0:04:57.13,0:04:59.06,Default,,0,0,0,,Мен айтқандай, Спайк
Dialogue: 0,0:04:59.36,0:05:00.90,Default,,0,0,0,,Бұл жерде темекі шегуге болмайды.
Dialogue: 0,0:05:01.26,0:05:04.90,Default,,0,0,0,,Иә? Ааа
Dialogue: 0,0:05:05.50,0:05:06.13,Default,,0,0,0,,Иә
Dialogue: 0,0:05:31.06,0:05:32.33,Default,,0,0,0,,Сіз мұны жасамайсыз.
Dialogue: 0,0:05:32.80,0:05:34.23,Default,,0,0,0,,Менің көзім тым жақсы.
Dialogue: 0,0:05:34.83,0:05:36.80,Default,,0,0,0,,Егер сіз нашар ақша тапсаңыз, сізді қуып жібереді.
Dialogue: 0,0:05:38.30,0:05:39.63,Default,,0,0,0,,Олай болса мені де өзіңмен бірге ала кет.
Dialogue: 0,0:05:51.66,0:05:52.63,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,0:06:00.93,0:06:01.46,Default,,0,0,0,,Намаз
Dialogue: 0,0:06:01.53,0:06:02.03,Default,,0,0,0,,Уф
Dialogue: 0,0:06:03.76,0:06:05.03,Default,,0,0,0,,Уф
Dialogue: 0,0:06:05.53,0:06:06.13,Default,,0,0,0,,О
Dialogue: 0,0:06:08.63,0:06:09.86,Default,,0,0,0,,Ия, мен мұны істедім
Dialogue: 0,0:06:12.86,0:06:13.66,Default,,0,0,0,,Мен оны саған аламын.
Dialogue: 0,0:06:16.10,0:06:18.53,Default,,0,0,0,,Woohoohohoo
Dialogue: 0,0:06:29.53,0:06:30.53,Default,,0,0,0,,Кішкентай Джек
Dialogue: 0,0:06:32.13,0:06:33.70,Default,,0,0,0,,Бұл өкінішті мәңгі бойымен арқалап жүремін.
Dialogue: 0,0:06:38.90,0:06:40.10,Default,,0,0,0,,Маған ойнауға рұқсат етіңіз
Dialogue: 0,0:07:01.60,0:07:02.83,Default,,0,0,0,,Жақсы Джеки
Dialogue: 0,0:07:06.26,0:07:08.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:19.90,0:07:21.50,Default,,0,0,0,,Қарсылас блэкджек машинасына келеді.
Dialogue: 0,0:07:21.96,0:07:23.70,Default,,0,0,0,,Дұрыс жерде жоғалтыңыз
Dialogue: 0,0:07:24.96,0:07:27.20,Default,,0,0,0,,Әрине, сіз мұнымен ынтымақтасасыз.
Dialogue: 0,0:07:28.00,0:07:30.83,Default,,0,0,0,,Ал соңғы чип қалды
Dialogue: 0,0:07:31.03,0:07:33.46,Default,,0,0,0,,Мен оны сізге дилерлік чип ретінде беремін.
Dialogue: 0,0:07:34.33,0:07:35.66,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:37.13,0:07:38.46,Default,,0,0,0,,Сіздің қарызыңыз т.б.
Dialogue: 0,0:07:38.53,0:07:41.60,Default,,0,0,0,,Бұл ғаламдағы бір секундқа тең.
Dialogue: 0,0:07:42.10,0:07:42.76,Default,,0,0,0,,Ах
Dialogue: 0,0:08:00.63,0:08:01.50,Default,,0,0,0,,Бұл соңғысы
Dialogue: 0,0:08:03.30,0:08:06.43,Default,,0,0,0,,Менің жолым да жоқ, шебер де емеспін.
Dialogue: 0,0:08:07.96,0:08:09.06,Default,,0,0,0,,Сонда не?
Dialogue: 0,0:08:09.63,0:08:10.90,Default,,0,0,0,,Жақсы атмосфера
Dialogue: 0,0:08:11.53,0:08:12.03,Default,,0,0,0,,Иә
Dialogue: 0,0:08:19.46,0:08:20.56,Default,,0,0,0,,Қара Джек
Dialogue: 0,0:08:20.66,0:08:21.60,Default,,0,0,0,,Бұл өкінішті мәңгі бойымен арқалап жүремін.
Dialogue: 0,0:08:22.93,0:08:23.66,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:08:24.13,0:08:25.30,Default,,0,0,0,,Міне, осында
Dialogue: 0,0:08:26.06,0:08:26.83,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:27.40,0:08:28.46,Default,,0,0,0,,Мен оны кәдесый ретінде аламын.
Dialogue: 0,0:08:28.73,0:08:29.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:29.90,0:08:31.03,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:08:31.66,0:08:32.60,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:08:36.50,0:08:38.60,Default,,0,0,0,,Ахх
Dialogue: 0,0:08:45.80,0:08:46.36,Default,,0,0,0,,Иә
Dialogue: 0,0:08:54.93,0:08:55.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:56.60,0:09:01.30,Default,,0,0,0,,Иә
Dialogue: 0,0:09:01.80,0:09:02.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:11.50,0:09:12.10,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:09:13.33,0:09:14.23,Default,,0,0,0,,Сәлем сен
Dialogue: 0,0:09:14.86,0:09:16.40,Default,,0,0,0,,Ең жақсы атмосфера қандай?
Dialogue: 0,0:09:16.60,0:09:17.90,Default,,0,0,0,,Бұл басқа әңгіме.
Dialogue: 0,0:09:18.20,0:09:18.70,Default,,0,0,0,,​​О?
Dialogue: 0,0:09:18.73,0:09:21.30,Default,,0,0,0,,Соңғысы осында кетуі керек, солай ма?
Dialogue: 0,0:09:21.56,0:09:22.60,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:23.13,0:09:25.30,Default,,0,0,0,,Мен сенімен алдау ойынына бардым.
Dialogue: 0,0:09:25.60,0:09:26.10,Default,,0,0,0,,Ах
Dialogue: 0,0:09:29.06,0:09:30.13,Default,,0,0,0,,Эй, сен мұны естідің бе?
Dialogue: 0,0:09:30.63,0:09:31.53,Default,,0,0,0,,Бұл алдау.
Dialogue: 0,0:09:32.43,0:09:33.26,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:09:33.70,0:09:35.66,Default,,0,0,0,,Дилер алдап жатыр.
Dialogue: 0,0:09:36.63,0:09:37.73,Default,,0,0,0,,На
Dialogue: 0,0:09:38.43,0:09:39.46,Default,,0,0,0,,Гокури
Dialogue: 0,0:09:39.96,0:09:40.53,Default,,0,0,0,,Ах
Dialogue: 0,0:09:41.30,0:09:41.86,Default,,0,0,0,,Га
Dialogue: 0,0:09:50.40,0:09:52.96,Default,,0,0,0,,Бір сәтке менің кеңсеме келе аласыз ба?
Dialogue: 0,0:09:53.26,0:09:53.86,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:00.20,0:10:00.96,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:01.06,0:10:01.80,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:02.03,0:10:03.36,Default,,0,0,0,,Уау
Dialogue: 0,0:10:03.43,0:10:04.46,Default,,0,0,0,,Рух толқындарын қолдануды да ұмытып кеткенмін
Dialogue: 0,0:10:04.70,0:10:05.33,Default,,0,0,0,,Иә
Dialogue: 0,0:10:05.66,0:10:06.16,Default,,0,0,0,,Ах
Dialogue: 0,0:10:06.73,0:10:07.63,Default,,0,0,0,,Уау
Dialogue: 0,0:10:11.60,0:10:12.53,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:10:13.46,0:10:16.03,Default,,0,0,0,,Бұл казино тіпті фитнес ұсынады ма?
Dialogue: 0,0:10:23.60,0:10:24.53,Default,,0,0,0,,Қазір шоу уақыты
Dialogue: 0,0:10:34.16,0:10:34.66,Default,,0,0,0,,Уау
Dialogue: 0,0:10:35.26,0:10:35.86,Default,,0,0,0,,Уф
Dialogue: 0,0:10:36.16,0:10:38.36,Default,,0,0,0,,Уау
Dialogue: 0,0:10:42.36,0:10:44.20,Default,,0,0,0,,Хехе, кешіріңіз.
Dialogue: 0,0:10:44.73,0:10:45.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:45.63,0:10:48.03,Default,,0,0,0,,Сол кезде мен Кирамен есептесемін.
Dialogue: 0,0:10:49.20,0:10:50.30,Default,,0,0,0,,Спайк
Dialogue: 0,0:11:00.63,0:11:01.13,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:06.16,0:11:06.66,Default,,0,0,0,,Ағын
Dialogue: 0,0:11:06.80,0:11:08.53,Default,,0,0,0,,Сондықтан мен саған бұлай істеме дедім.
Dialogue: 0,0:11:08.60,0:11:09.40,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:11:09.76,0:11:10.70,Default,,0,0,0,,Тек қашып кет
Dialogue: 0,0:11:11.16,0:11:12.86,Default,,0,0,0,,Мен оны әлі ақшаға айналдырған жоқпын.
Dialogue: 0,0:11:13.03,0:11:13.60,Default,,0,0,0,,Эй
Dialogue: 0,0:11:20.83,0:11:22.56,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:11:29.53,0:11:32.16,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:11:39.76,0:11:40.26,Default,,0,0,0,,Уф
Dialogue: 0,0:11:42.03,0:11:43.30,Default,,0,0,0,,Уау
Dialogue: 0,0:11:47.26,0:11:48.53,Default,,0,0,0,,Менде ол әлі жоқ.
Dialogue: 0,0:11:48.90,0:11:50.30,Default,,0,0,0,,Чип жалған
Dialogue: 0,0:11:50.93,0:11:53.06,Default,,0,0,0,,Бұл фарсты не үшін жасадыңыз?
Dialogue: 0,0:11:53.40,0:11:56.50,Default,,0,0,0,,Сіз де, бастығыңыз да түсінбейтін сияқты.
Dialogue: 0,0:11:57.10,0:11:59.30,Default,,0,0,0,,Егер ол чип полицияның қолына түссе
Dialogue: 0,0:11:59.83,0:12:01.13,Default,,0,0,0,,Бәрі бітті
Dialogue: 0,0:12:02.36,0:12:05.13,Default,,0,0,0,,Босс, ол әйелді әлі таппадық.
Dialogue: 0,0:12:05.53,0:12:06.36,Default,,0,0,0,,Іздеу
Dialogue: 0,0:12:07.13,0:12:08.46,Default,,0,0,0,,Жүлде ақшаңызды желіге қоюыңызға болады.
Dialogue: 0,0:12:26.96,0:12:27.60,Default,,0,0,0,,Біраз
Dialogue: 0,0:12:27.93,0:12:29.60,Default,,0,0,0,,Мені осы уақытқа дейін жеткізгеніңіз үшін рахмет.
Dialogue: 0,0:12:29.93,0:12:32.26,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:12:33.13,0:12:34.03,Default,,0,0,0,,Куун-кун
Dialogue: 0,0:12:34.10,0:12:36.26,Default,,0,0,0,,Жоқ, шуш, шуш
Dialogue: 0,0:12:36.63,0:12:40.43,Default,,0,0,0,,Байқадым, бұл әпкеден ақшаның иісі бар.
Dialogue: 0,0:12:40.50,0:12:41.50,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:12:41.93,0:12:43.86,Default,,0,0,0,,Джет Сіз қанша ақша таптыңыз?
Dialogue: 0,0:12:44.43,0:12:46.33,Default,,0,0,0,,Бұл оңай 200 000 иен болды.
Dialogue: 0,0:12:46.96,0:12:48.36,Default,,0,0,0,,Оны кім тең етіп жасады?
Dialogue: 0,0:12:48.73,0:12:49.86,Default,,0,0,0,,Өз орныңды біл.
Dialogue: 0,0:12:51.56,0:12:53.20,Default,,0,0,0,,200 000 покчи дегеніміз не?
Dialogue: 0,0:12:53.86,0:12:55.56,Default,,0,0,0,,Менің қарызыммен салыстырғанда
Dialogue: 0,0:12:55.96,0:12:58.83,Default,,0,0,0,,Жалпы айтқанда, айтқандарыңызда шек жоқ.
Dialogue: 0,0:12:59.13,0:13:02.50,Default,,0,0,0,,Бұл зат/тасымалдаушы 400 000 иенге сата алады.
Dialogue: 0,0:13:02.56,0:13:05.93,Default,,0,0,0,,Егер сіз ұшты жай ғана тапсырсаңыз, ешқандай проблема болмас еді.
Dialogue: 0,0:13:06.50,0:13:07.40,Default,,0,0,0,,Кеңес пе?
Dialogue: 0,0:13:07.46,0:13:07.96,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:13:09.43,0:13:11.40,Default,,0,0,0,,Гаргар Пе
Dialogue: 0,0:13:12.13,0:13:14.56,Default,,0,0,0,,Жоқ, ол жоғалды.
Dialogue: 0,0:13:15.20,0:13:18.40,Default,,0,0,0,,Гордонға берсең, ол саған қалағанын береді.
Dialogue: 0,0:13:19.10,0:13:20.46,Default,,0,0,0,,Иә, солай істейік.
Dialogue: 0,0:13:21.16,0:13:23.23,Default,,0,0,0,,Мен Гордон деп аталатын ешкімді білмеймін.
Dialogue: 0,0:13:23.83,0:13:26.13,Default,,0,0,0,,Сіздің әңгімеңізге сенгім келмейді.
Dialogue: 0,0:13:26.70,0:13:27.66,Default,,0,0,0,,Біраз
Dialogue: 0,0:13:27.96,0:13:29.23,Default,,0,0,0,,Айн кеттік
Dialogue: 0,0:13:30.36,0:13:32.23,Default,,0,0,0,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:13:33.96,0:13:34.46,Default,,0,0,0,,Тет
Dialogue: 0,0:13:43.66,0:13:44.46,Default,,0,0,0,,Бұл чип.
Dialogue: 0,0:13:45.03,0:13:45.96,Default,,0,0,0,,Бұл чип.
Dialogue: 0,0:13:46.10,0:13:47.06,Default,,0,0,0,,Сукуна соған тұрарлық.
Dialogue: 0,0:13:47.46,0:13:50.16,Default,,0,0,0,,Оның ішінде микрочип орнатылған.
Dialogue: 0,0:13:50.73,0:13:51.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:59.83,0:14:02.86,Default,,0,0,0,,Амиго Сыйлықты маған қалдырыңыз
Dialogue: 0,0:14:02.93,0:14:05.23,Default,,0,0,0,,Күте тұрыңыз, үлкен кадрдың уақыты келді.
Dialogue: 0,0:14:12.96,0:14:13.70,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:14:13.76,0:14:16.16,Default,,0,0,0,,Сонымен, осы аптаның ең жақсы соққысы кім?
Dialogue: 0,0:14:16.50,0:14:18.76,Default,,0,0,0,,Оны полицияға беру ысырап болар еді
Dialogue: 0,0:14:18.80,0:14:20.13,Default,,0,0,0,,- Сыртқы түріне қарамастан, ол үйреншікті қылмыскер - Эй Спайк
Dialogue: 0,0:14:20.90,0:14:22.13,Default,,0,0,0,,Фей Валентин.
Dialogue: 0,0:14:22.23,0:14:25.66,Default,,0,0,0,,Хмм, жүлде қоры 6 миллион, бұл мәміле.
Dialogue: 0,0:14:25.76,0:14:26.63,Default,,0,0,0,,- Эй Джет - Кел, бірінші келді, бірінші қызмет етеді.
Dialogue: 0,0:14:27.50,0:14:29.56,Default,,0,0,0,,Сәттілік Ковбойлар
Dialogue: 0,0:14:31.33,0:14:32.66,Default,,0,0,0,,Мен сені сағындым
Dialogue: 0,0:14:33.13,0:14:33.76,Default,,0,0,0,,Сізге айтайын
Dialogue: 0,0:14:34.53,0:14:36.26,Default,,0,0,0,,Мен қашып кеткім келмеді.
Dialogue: 0,0:14:36.63,0:14:37.76,Default,,0,0,0,,Мен бұған сендім
Dialogue: 0,0:14:38.46,0:14:39.40,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:14:40.26,0:14:41.96,Default,,0,0,0,,Ескі үлгідегі балық аулайтын қайық қақпада
Dialogue: 0,0:14:42.50,0:14:44.03,Default,,0,0,0,,Оларда да чиптер бар.
Dialogue: 0,0:14:44.66,0:14:45.50,Default,,0,0,0,,Өте тез
Dialogue: 0,0:14:45.96,0:14:46.60,Default,,0,0,0,,Ах
Dialogue: 0,0:14:53.70,0:14:54.33,Default,,0,0,0,,Не?
Dialogue: 0,0:14:54.73,0:14:58.03,Default,,0,0,0,,Менің ойымша, біз де жетілмеген едік.
Dialogue: 0,0:14:58.36,0:15:01.76,Default,,0,0,0,,Жас, бос әйелді осындай жерге қалдыр.
Dialogue: 0,0:15:02.70,0:15:04.63,Default,,0,0,0,,​​Сіз біртүрлі нәрсе ойламағаныңызға сенімдімін.
Dialogue: 0,0:15:05.03,0:15:08.66,Default,,0,0,0,,Мен сізге ыңғайлырақ жерді көрсетемін.
Dialogue: 0,0:15:09.00,0:15:10.43,Default,,0,0,0,,Әй, қызық, ол қайда?
Dialogue: 0,0:15:10.76,0:15:11.83,Default,,0,0,0,,-Полиция -Полиция
Dialogue: 0,0:15:11.90,0:15:12.40,Default,,0,0,0,,Ах
Dialogue: 0,0:15:12.63,0:15:16.00,Default,,0,0,0,,200 000 иен деп айту маған өте жаман болды.
Dialogue: 0,0:15:16.36,0:15:17.63,Default,,0,0,0,,Фей Валентин
Dialogue: 0,0:15:18.23,0:15:20.03,Default,,0,0,0,,Тіпті менің жүлде ақшам да қауіп төніп тұр.
Dialogue: 0,0:15:20.46,0:15:21.93,Default,,0,0,0,,Керемет 6 миллион!
Dialogue: 0,0:15:22.96,0:15:25.30,Default,,0,0,0,,Не, 6 миллион томпақ?
Dialogue: 0,0:15:26.03,0:15:28.33,Default,,0,0,0,,Эй, сенің қанша қарызың бар?
Dialogue: 0,0:15:28.76,0:15:31.70,Default,,0,0,0,,Эй, өтінемін, мен полицияға барғым келмейді.
Dialogue: 0,0:15:31.96,0:15:34.10,Default,,0,0,0,,Сіз полиция қызметкері болмасаңыз, ақша ала алмайсыз.
Dialogue: 0,0:15:34.16,0:15:36.96,Default,,0,0,0,,Мен бір орында тұрмауым керек
Dialogue: 0,0:15:37.26,0:15:38.36,Default,,0,0,0,,Бұл анамның өсиеті.
Dialogue: 0,0:15:38.53,0:15:39.40,Default,,0,0,0,,Сатору мен жоғары лауазымды тұлғалар арасындағы қақтығыс осыны ұйымдастырды деген сыбыс бар, солай емес пе?
Dialogue: 0,0:15:40.03,0:15:41.26,Default,,0,0,0,,Біздің отбасымыз
Dialogue: 0,0:15:41.76,0:15:44.33,Default,,0,0,0,,Мен махаббат іздеп қаңғып жүрген румынмын.
Dialogue: 0,0:15:44.86,0:15:45.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:45.93,0:15:47.16,Default,,0,0,0,,Білімсіз адам.
Dialogue: 0,0:15:47.23,0:15:48.46,Default,,0,0,0,,Бұл сығандар туралы.
Dialogue: 0,0:15:49.03,0:15:51.86,Default,,0,0,0,,Басқа мақтанышы жоқ сен сияқты адамдар
Dialogue: 0,0:15:52.10,0:15:53.46,Default,,0,0,0,,Ол шатқал деп аталады.
Dialogue: 0,0:15:53.90,0:15:55.23,Default,,0,0,0,,Шатқал құрылымы
Dialogue: 0,0:15:55.33,0:15:55.90,Default,,0,0,0,,Ахх
Dialogue: 0,0:15:56.53,0:15:59.10,Default,,0,0,0,,Мен қоңырау шалып жатырмын. Табиғат мені шақырады.
Dialogue: 0,0:15:59.43,0:16:00.63,Default,,0,0,0,,Бұл полиция болуы керек пе?
Dialogue: 0,0:16:01.23,0:16:02.33,Default,,0,0,0,,Желкені, ұшатын
Dialogue: 0,0:16:02.46,0:16:04.06,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:16:04.20,0:16:04.90,Default,,0,0,0,,Өйткені мен қашпаймын
Dialogue: 0,0:16:05.23,0:16:06.73,Default,,0,0,0,,Шамамен бір қолды алыңыз.
Dialogue: 0,0:16:07.03,0:16:08.83,Default,,0,0,0,,Мұнымен тіпті дәретханаға да бара алмайсың.
Dialogue: 0,0:16:09.26,0:16:11.83,Default,,0,0,0,,Сен сондай шулы әйелсің.
Dialogue: 0,0:16:17.70,0:16:20.26,Default,,0,0,0,,Қолың суланғанда көбік деп айтасың ба?
Dialogue: 0,0:16:21.36,0:16:23.03,Default,,0,0,0,,Жеңілу арқылы ұтуға болады.
Dialogue: 0,0:16:23.83,0:16:25.40,Default,,0,0,0,,Чарли осылай деді.
Dialogue: 0,0:16:25.73,0:16:28.10,Default,,0,0,0,,«Бірдеңе алғың келсе, алдымен бер».
Dialogue: 0,0:16:28.73,0:16:31.76,Default,,0,0,0,,Мен арманымнан хабарды лақтырып жіберген жоқпын.
Dialogue: 0,0:16:32.46,0:16:32.96,Default,,0,0,0,,Уау
Dialogue: 0,0:16:33.16,0:16:35.63,Default,,0,0,0,,Утте
Dialogue: 0,0:16:40.03,0:16:40.93,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:43.90,0:16:46.06,Default,,0,0,0,,Мен сіздердің кім екендеріңізді білмеймін, бірақ
Dialogue: 0,0:16:46.90,0:16:48.93,Default,,0,0,0,,Ақшаны қайтара аламын ба?
Dialogue: 0,0:16:49.53,0:16:51.26,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін, бірақ
Dialogue: 0,0:16:51.56,0:16:52.50,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:16:53.13,0:16:56.13,Default,,0,0,0,,Бұл сендер үшін мағынасыз кеңес.
Dialogue: 0,0:16:56.30,0:16:58.63,Default,,0,0,0,,Ішіндегі заттар жақсы сатылуы мүмкін.
Dialogue: 0,0:17:00.53,0:17:02.03,Default,,0,0,0,,Менің ойымша, бұл шамамен үш жыл бұрын болды.
Dialogue: 0,0:17:02.33,0:17:05.46,Default,,0,0,0,,SIT-те жасалған кодты бұзу бағдарламасы
Dialogue: 0,0:17:06.10,0:17:07.80,Default,,0,0,0,,Криптовалюта бұзғыш бар.
Dialogue: 0,0:17:08.46,0:17:11.16,Default,,0,0,0,,Бағдарламашы аяқталғаннан кейін көп ұзамай өлтірілді.
Dialogue: 0,0:17:11.43,0:17:14.10,Default,,0,0,0,,Қараңғы жолға кетті деген қауесет бар.
Dialogue: 0,0:17:14.20,0:17:18.06,Default,,0,0,0,,Өйткені, көптеген кодтарды бұзып, қорғанысты алып тастауға болады.
Dialogue: 0,0:17:18.36,0:17:21.20,Default,,0,0,0,,Бұл сиқырлы кілт сияқты.
Dialogue: 0,0:17:21.46,0:17:25.10,Default,,0,0,0,,​​Дегенмен, бағдарламаның өзі шифрланған.
Dialogue: 0,0:17:25.60,0:17:28.36,Default,,0,0,0,,Өзін ашу үшін оған кілт керек.
Dialogue: 0,0:17:29.10,0:17:30.90,Default,,0,0,0,,Полиция мен I.S.S.P.
Dialogue: 0,0:17:30.96,0:17:34.43,Default,,0,0,0,,Олар оны қатты іздеген деген қауесет бар.
Dialogue: 0,0:17:35.06,0:17:37.76,Default,,0,0,0,,Мен сені мұндай жерде көремін деп ойламадым.
Dialogue: 0,0:17:38.93,0:17:41.66,Default,,0,0,0,,Ол мұны өте жақсы білетін сияқты.
Dialogue: 0,0:17:42.30,0:17:46.33,Default,,0,0,0,,Бұрын I.S.S.P якуза бизнесін жүргізетін.
Dialogue: 0,0:17:46.76,0:17:49.16,Default,,0,0,0,,Казинода үлкен сомамен айналыссаңыз да, сіз ерекшеленбейсіз.
Dialogue: 0,0:17:49.73,0:17:52.46,Default,,0,0,0,,Менің ойымша, полицияны алдау жеткілікті.
Dialogue: 0,0:17:53.06,0:17:54.53,Default,,0,0,0,,Бұл жаман күн болды.
Dialogue: 0,0:17:54.86,0:17:57.86,Default,,0,0,0,,Әрине, бұл бізге пайдасыз.
Dialogue: 0,0:17:58.40,0:18:00.36,Default,,0,0,0,,Оны полицияға тапсыру жақсы болар еді.
Dialogue: 0,0:18:00.76,0:18:01.80,Default,,0,0,0,,Төлейік
Dialogue: 0,0:18:03.06,0:18:04.16,Default,,0,0,0,,Мен 300 миллион деп айтпаймын.
Dialogue: 0,0:18:04.73,0:18:05.66,Default,,0,0,0,,30 миллион туралы не деуге болады?
Dialogue: 0,0:18:06.30,0:18:09.63,Default,,0,0,0,,Сиқырлы кілттің бағасы арзан шығар.
Dialogue: 0,0:18:12.00,0:18:13.13,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:18:34.03,0:18:34.83,Default,,0,0,0,,Олардың бірі… Кира ғой, иә?
Dialogue: 0,0:18:35.30,0:18:36.03,Default,,0,0,0,,6 млн
Dialogue: 0,0:18:36.10,0:18:37.03,Default,,0,0,0,,30 млн.
Dialogue: 0,0:18:37.23,0:18:38.40,Default,,0,0,0,,Сіз сабан адамсыз ба?
Dialogue: 0,0:18:38.96,0:18:39.96,Default,,0,0,0,,Лайланбаңыз
Dialogue: 0,0:18:40.70,0:18:41.76,Default,,0,0,0,,Окидоки
Dialogue: 0,0:19:22.86,0:19:23.56,Default,,0,0,0,,Уф
Dialogue: 0,0:19:23.63,0:19:25.03,Default,,0,0,0,,Уууу
Dialogue: 0,0:19:25.96,0:19:27.60,Default,,0,0,0,,-Ууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:19:28.03,0:19:30.93,Default,,0,0,0,,Ван Ван Ван Ван Ван
Dialogue: 0,0:19:31.36,0:19:33.93,Default,,0,0,0,,Қазіргі уақытта қолма-қол ақшаның ерекшелігі қандай?
Dialogue: 0,0:19:34.63,0:19:36.33,Default,,0,0,0,,Ол көне жігіт.
Dialogue: 0,0:19:41.83,0:19:43.03,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:19:43.56,0:19:45.20,Default,,0,0,0,,Екеуміз де үшке дейін санаймыз.
Dialogue: 0,0:19:46.13,0:19:48.80,Default,,0,0,0,,Сонымен, біз магистральдағы магнитті кесіп тастадық.
Dialogue: 0,0:19:49.40,0:19:50.50,Default,,0,0,0,,Онда ұшыңыз
Dialogue: 0,0:19:51.00,0:19:53.10,Default,,0,0,0,,Олар фишкаларын осында жібереді.
Dialogue: 0,0:19:53.56,0:19:54.36,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:55.43,0:19:56.90,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,0:19:59.16,0:20:01.26,Default,,0,0,0,,Чипті тексергеннен кейін бүкіл кемені тастаңыз.
Dialogue: 0,0:20:01.66,0:20:02.16,Default,,0,0,0,,Га
Dialogue: 0,0:20:03.23,0:20:04.06,Default,,0,0,0,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,0:20:08.13,0:20:08.76,Default,,0,0,0,,1
Dialogue: 0,0:20:10.36,0:20:11.06,Default,,0,0,0,,2
Dialogue: 0,0:20:12.13,0:20:12.63,Default,,0,0,0,,3
Dialogue: 0,0:20:17.33,0:20:18.76,Default,,0,0,0,,Га
Dialogue: 0,0:20:22.86,0:20:23.56,Default,,0,0,0,,Не?
Dialogue: 0,0:20:29.40,0:20:31.03,Default,,0,0,0,,Ысырманы ашуға болады.
Dialogue: 0,0:20:31.63,0:20:32.50,Default,,0,0,0,,Иә, хаа
Dialogue: 0,0:20:40.73,0:20:41.30,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:20:54.43,0:20:55.70,Default,,0,0,0,,Иә, Гордж
Dialogue: 0,0:20:57.16,0:20:58.50,Default,,0,0,0,,Йо Домани
Dialogue: 0,0:21:01.96,0:21:02.50,Default,,0,0,0,,Осы мақсатта алдымен маған өзіңнің Қирктеріңнің егжей-тегжейін айт.
Dialogue: 0,0:21:02.93,0:21:04.13,Default,,0,0,0,,Маған қашып кетпе, атып таста!
Dialogue: 0,0:21:08.70,0:21:09.20,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:21:16.30,0:21:16.80,Default,,0,0,0,,Ағын
Dialogue: 0,0:21:17.23,0:21:18.13,Default,,0,0,0,,Бұл тәртіпсіздік
Dialogue: 0,0:21:18.66,0:21:19.90,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:22.70,0:21:24.90,Default,,0,0,0,,Тамшы, таста, не істеп жатырсың?
Dialogue: 0,0:21:33.26,0:21:33.76,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:21:44.06,0:21:45.20,Default,,0,0,0,,Егілген саман
Dialogue: 0,0:21:45.46,0:21:46.06,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:21:46.30,0:21:47.16,Default,,0,0,0,,Зымыранмен жақындау
Dialogue: 0,0:21:47.30,0:21:47.80,Default,,0,0,0,,Ой
Dialogue: 0,0:22:08.06,0:22:09.30,Default,,0,0,0,,Сол әйел
Dialogue: 0,0:22:17.83,0:22:19.73,Default,,0,0,0,,Дұрыс жауап - оны пайдалану.
Dialogue: 0,0:22:20.60,0:22:22.80,Default,,0,0,0,,Бұл варашибехожаның қайталануы ма?
Dialogue: 0,0:22:30.23,0:22:31.23,Default,,0,0,0,,Алдау
Dialogue: 0,0:22:53.43,0:22:58.46,Default,,0,0,0,,Мен сені сүйдім деп күйіну
Dialogue: 0,0:22:59.46,0:23:03.50,Default,,0,0,0,,Тым көп уақыт өтті
Dialogue: 0,0:23:05.40,0:23:10.26,Default,,0,0,0,,Менің жүрегім әлі де жаралы
Dialogue: 0,0:23:11.03,0:23:15.40,Default,,0,0,0,,Емсіз жел соғып тұр
Dialogue: 0,0:23:17.76,0:23:25.90,Default,,0,0,0,,Біреу құрғақ көзімен жыласын
Dialogue: 0,0:23:28.46,0:23:31.70,Default,,0,0,0,,НАҒЫЗ ХАЛЫҚТЫҚ КӨКТЕР
Dialogue: 0,0:23:32.03,0:23:40.26,Default,,0,0,0,,Мен жай ғана шынайы қайғыны білгім келеді
Dialogue: 0,0:23:40.40,0:23:52.43,Default,,0,0,0,,Балшық өзенге батырылған өмір соншалықты жаман емес.
Dialogue: 0,0:23:52.56,0:24:01.13,Default,,0,0,0,,Егер ол тек бір рет аяқталса
Dialogue: 0,0:24:18.46,0:24:19.50,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:24:19.80,0:24:21.30,Default,,0,0,0,,Бұл қиын дүние
Dialogue: 0,0:24:21.53,0:24:24.03,Default,,0,0,0,,Рецессия салдарынан балалар жұмысынан айырыла ма?
Dialogue: 0,0:24:24.06,0:24:25.66,Default,,0,0,0,,Ей, егер сіз газет оқып жатсаңыз ше?
Dialogue: 0,0:24:26.16,0:24:28.93,Default,,0,0,0,,Бибопта бұдан да көп қиындықтар бар.
Dialogue: 0,0:24:29.43,0:24:31.06,Default,,0,0,0,,Менің ойымша, бұл сүйкімді
Dialogue: 0,0:24:31.46,0:24:31.96,Default,,0,0,0,,Мынаны қараңыз.
Dialogue: 0,0:24:32.60,0:24:33.30,Default,,0,0,0,,Бұл терроризм.
Dialogue: 0,0:24:33.76,0:24:35.66,Default,,0,0,0,,Ол Ганимедті ұшырып жібермекші сияқты.
Dialogue: 0,0:24:35.76,0:24:36.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:24:36.46,0:24:37.90,Default,,0,0,0,,Табиғатты қорғау ұйымы?
Dialogue: 0,0:24:38.40,0:24:38.90,Default,,0,0,0,,Бұл сәл ақымақтық емес пе?
Dialogue: 0,0:24:39.40,0:24:41.10,Default,,0,0,0,,Мына аңды алсын.
Dialogue: 0,0:24:41.60,0:24:43.36,Default,,0,0,0,,Келесі жолы “Шлюзді араластыру”
Dialogue: 0,0:24:43.80,0:24:45.06,Default,,0,0,0,,Бұл бұзылатын сияқты.
Dialogue: 0,0:24:46.56,0:24:51.56,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
