Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:02.80,0:01:04.30,Default,,0,0,0,,Менің ойымша, бұл Scence арқылы соққы беру уақыты
Dialogue: 0,0:01:04.66,0:01:06.16,Default,,0,0,0,,Барлығын бірге жинаңыз
Dialogue: 0,0:01:06.93,0:01:09.20,Default,,0,0,0,,Жарайды 3 2 1 Кептелейік
Dialogue: 0,0:03:15.50,0:03:16.73,Default,,0,0,0,,Эй, Спайк
Dialogue: 0,0:03:19.33,0:03:20.80,Default,,0,0,0,,Болды
Dialogue: 0,0:03:20.90,0:03:21.80,Default,,0,0,0,,Бұл да болды.
Dialogue: 0,0:03:22.46,0:03:23.03,Default,,0,0,0,,Мәзір мынада
Dialogue: 0,0:03:23.63,0:03:25.56,Default,,0,0,0,,Арнайы Чиньяолоза
Dialogue: 0,0:03:34.46,0:03:36.16,Default,,0,0,0,,Асимов Соренсан
Dialogue: 0,0:03:36.40,0:03:38.03,Default,,0,0,0,,Бұл келесі сыйлық.
Dialogue: 0,0:03:39.56,0:03:40.60,Default,,0,0,0,,Эй Джет
Dialogue: 0,0:03:41.33,0:03:44.83,Default,,0,0,0,,Ол бүкіл астероид аймағын бақылайтын ұйымның жауапты қызметкері.
Dialogue: 0,0:03:44.93,0:03:46.96,Default,,0,0,0,,Мен Чинджао белін таңдадым.
Dialogue: 0,0:03:47.26,0:03:50.30,Default,,0,0,0,,Бұл Асимов Соренсон. Сіз не тыңдап жатырсыз?
Dialogue: 0,0:03:50.76,0:03:52.90,Default,,0,0,0,,Етсіз Чинджао белі дегеніміз не?
Dialogue: 0,0:03:53.53,0:03:56.33,Default,,0,0,0,,Менің ойымша, сіз оны чиньяолоз деп атай алмайсыз.
Dialogue: 0,0:03:57.40,0:03:59.00,Default,,0,0,0,,Жоқ, мен айтамын.
Dialogue: 0,0:03:59.50,0:04:00.46,Default,,0,0,0,,Оны айтпа
Dialogue: 0,0:04:00.76,0:04:02.93,Default,,0,0,0,,Ақшаң жоқ кезде айтасың.
Dialogue: 0,0:04:03.26,0:04:06.33,Default,,0,0,0,,Бір күні 1 миллион оолонг жүлдесі қайда кетті?
Dialogue: 0,0:04:06.76,0:04:09.06,Default,,0,0,0,,Сіз жойған ұшақты жөндеу
Dialogue: 0,0:04:09.23,0:04:11.40,Default,,0,0,0,,Сіз жойған дүкенді жөндеу
Dialogue: 0,0:04:12.10,0:04:14.63,Default,,0,0,0,,Сіз жарақаттаған полиция қызметкерінің медициналық шығындары үшін.
Dialogue: 0,0:04:14.83,0:04:15.60,Default,,0,0,0,,Пар.
Dialogue: 0,0:04:18.53,0:04:20.50,Default,,0,0,0,,3 күн бұрын осы жігіттің ұйымымен
Dialogue: 0,0:04:20.80,0:04:23.23,Default,,0,0,0,,Бәсекелес ұйыммен қақтығыс болды.
Dialogue: 0,0:04:23.93,0:04:26.56,Default,,0,0,0,,Бұл жігіт достарын өлтіріп, тәртіпсіздік жасады.
Dialogue: 0,0:04:27.13,0:04:30.06,Default,,0,0,0,,Ол тихуана әйелін паналаған көрінеді.
Dialogue: 0,0:04:30.63,0:04:32.66,Default,,0,0,0,,Кішкентай шабақтар баратын жер.
Dialogue: 0,0:04:33.16,0:04:36.06,Default,,0,0,0,,Жүлде ақшасы кішкентай шабақ үшін 2,5 миллион иенді құрайды.
Dialogue: 0,0:04:36.33,0:04:37.53,Default,,0,0,0,,Мінбе
Dialogue: 0,0:04:38.06,0:04:40.36,Default,,0,0,0,,Тихуана, анау ана жақта ма?
Dialogue: 0,0:04:41.06,0:04:42.40,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:04:54.53,0:04:59.23,Default,,0,0,0,,Біз жақын арада қақпаға жетеміз.
Dialogue: 0,0:04:59.40,0:05:01.56,Default,,0,0,0,,Біз сізді қайтадан көргіміз келеді.
Dialogue: 0,0:05:02.66,0:05:03.96,Default,,0,0,0,,Қақпадан өткеннен кейін
Dialogue: 0,0:05:04.53,0:05:06.66,Default,,0,0,0,,Ақылы қақпада бір қатарға тұрыңыз.
Dialogue: 0,0:05:07.96,0:05:11.53,Default,,0,0,0,,Несие сенсорын дебет режиміне орнатып, өтуіңізді сұраймыз.
Dialogue: 0,0:05:22.60,0:05:24.96,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:05:25.03,0:05:26.33,Default,,0,0,0,,Әзірге міне.
Dialogue: 0,0:05:26.36,0:05:28.20,Default,,0,0,0,,Полициядан тексергеннен кейін барыңыз
Dialogue: 0,0:05:28.36,0:05:29.23,Default,,0,0,0,,Міне, біз келдік.
Dialogue: 0,0:05:29.63,0:05:31.60,Default,,0,0,0,,Мен де Бұқаның қартына барамын.
Dialogue: 0,0:05:32.26,0:05:34.60,Default,,0,0,0,,Не күтіп тұрғанын білмеймін, әлгі қарт.
Dialogue: 0,0:05:34.73,0:05:53.90,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:05:54.36,0:05:56.26,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:05:57.60,0:06:03.43,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:06:03.70,0:06:05.40,Default,,0,0,0,,Бұл алаңсыз ән.
Dialogue: 0,0:06:27.83,0:06:28.90,Default,,0,0,0,,Ұры
Dialogue: 0,0:06:39.16,0:06:41.66,Default,,0,0,0,,Тағы да қарғыс атсын, бейбақ.
Dialogue: 0,0:06:42.23,0:06:45.10,Default,,0,0,0,,Жігіттер мені осылай мазақ етіп отырсыңдар.
Dialogue: 0,0:06:45.33,0:06:47.83,Default,,0,0,0,,Қазір осында өмір сүру мүмкіндігі
Dialogue: 0,0:06:47.90,0:06:51.40,Default,,0,0,0,,Қақпаны қазу үшін көп еңбек еткендіктен.
Dialogue: 0,0:06:51.86,0:06:54.70,Default,,0,0,0,,Сіз ұтылған кезде осылай жасайсыз.
Dialogue: 0,0:06:55.00,0:06:57.70,Default,,0,0,0,,Менің ойымша, біз бәріміз қақпаны қаздық.
Dialogue: 0,0:06:58.33,0:07:01.63,Default,,0,0,0,,Сен қаздың. Амалсыз қазып алдың.
Dialogue: 0,0:07:02.06,0:07:04.50,Default,,0,0,0,,Ей ақымақ, бейбақ. Иә?
Dialogue: 0,0:07:18.83,0:07:19.70,Default,,0,0,0,,Маған сыра беріңіз
Dialogue: 0,0:07:20.30,0:07:22.80,Default,,0,0,0,,Маған қанды Мэри керек, өтінемін.
Dialogue: 0,0:07:26.06,0:07:29.46,Default,,0,0,0,,Менде арақ бар, бірақ өкінішке орай қызанақ шырыны таусылды.
Dialogue: 0,0:07:30.16,0:07:32.63,Default,,0,0,0,,Менің ойымша, артында бір банка бар.
Dialogue: 0,0:07:34.83,0:07:35.86,Default,,0,0,0,,Қарап көрейік
Dialogue: 0,0:07:48.70,0:07:50.70,Default,,0,0,0,,Бұл Red Eye компаниясының ең үздік өнімі.
Dialogue: 0,0:07:51.10,0:07:52.33,Default,,0,0,0,,Егер сіз дилер болсаңыз, түсінесіз.
Dialogue: 0,0:07:52.73,0:07:53.40,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:54.06,0:07:55.20,Default,,0,0,0,,Қанды көз
Dialogue: 0,0:08:00.16,0:08:01.83,Default,,0,0,0,,О
Dialogue: 0,0:08:04.03,0:08:06.86,Default,,0,0,0,,Оның шын екенін көрейін бе?
Dialogue: 0,0:08:20.23,0:08:21.20,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:08:31.53,0:08:33.70,Default,,0,0,0,,Мұқият қараңыз.
Dialogue: 0,0:08:34.36,0:08:35.06,Default,,0,0,0,,Беріліс~
Dialogue: 0,0:08:36.66,0:08:37.53,Default,,0,0,0,,О
Dialogue: 0,0:08:40.06,0:08:41.26,Default,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:08:52.26,0:08:52.76,Default,,0,0,0,,Әй
Dialogue: 0,0:08:55.93,0:08:56.60,Default,,0,0,0,,Эй… бір сәт, Джосуке!
Dialogue: 0,0:08:56.70,0:08:57.26,Default,,0,0,0,,Уау
Dialogue: 0,0:08:57.33,0:08:58.26,Default,,0,0,0,,Ах ха ха
Dialogue: 0,0:08:58.33,0:08:58.83,Default,,0,0,0,,Уау
Dialogue: 0,0:09:07.83,0:09:08.56,Default,,0,0,0,,Уау
Dialogue: 0,0:09:39.10,0:09:42.33,Default,,0,0,0,,Бұл да жақсы, бірақ мен оны жегім келмейді.
Dialogue: 0,0:09:45.63,0:09:47.73,Default,,0,0,0,,А, сонда.
Dialogue: 0,0:09:51.23,0:09:55.63,Default,,0,0,0,,Солтүстік қаланың шетінде қызыл көзді қоят пайда болды.
Dialogue: 0,0:09:55.73,0:09:57.16,Default,,0,0,0,,Онда осылай делінген
Dialogue: 0,0:09:57.86,0:09:59.83,Default,,0,0,0,,Қызыл көзді қасқыр
Dialogue: 0,0:09:59.90,0:10:01.26,Default,,0,0,0,,Жүзетін құс
Dialogue: 0,0:10:01.36,0:10:01.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:02.60,0:10:04.53,Default,,0,0,0,,Сіз бір әйелді кездестіресіз
Dialogue: 0,0:10:04.86,0:10:07.36,Default,,0,0,0,,Сізді әйел нысанаға алды
Dialogue: 0,0:10:07.90,0:10:08.73,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:10:09.10,0:10:09.93,Default,,0,0,0,,Өл
Dialogue: 0,0:10:11.26,0:10:12.30,Default,,0,0,0,,Ято ондай Қасиетті Құралды неге сақтап жүр?
Dialogue: 0,0:10:12.86,0:10:13.80,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:10:14.26,0:10:16.06,Default,,0,0,0,,Мен бір рет қайтыс болдым.
Dialogue: 0,0:10:16.73,0:10:18.06,Default,,0,0,0,,Әйел өлтірген
Dialogue: 0,0:10:18.90,0:10:21.60,Default,,0,0,0,,Сіз әйелдерге жеңіл қарайсыз
Dialogue: 0,0:10:22.10,0:10:22.93,Default,,0,0,0,,Кедергі-сан
Dialogue: 0,0:10:26.13,0:10:28.53,Default,,0,0,0,,Вакан Танка берекелі болсын
Dialogue: 0,0:10:28.66,0:10:29.66,Default,,0,0,0,,Иә
Dialogue: 0,0:10:40.46,0:10:41.90,Default,,0,0,0,,Президент?
Dialogue: 0,0:10:42.66,0:10:44.20,Default,,0,0,0,,Мен саған сусын сатып аламын.
Dialogue: 0,0:10:46.06,0:10:46.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:50.40,0:10:53.56,Default,,0,0,0,,Таку Асимовтың бейбақы көп кесіліп жатыр.
Dialogue: 0,0:10:53.63,0:10:55.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:55.16,0:10:57.63,Default,,0,0,0,,Сатсу қозғала бастағанға дейін бірдеңе істеуіміз керек.
Dialogue: 0,0:10:57.80,0:10:59.76,Default,,0,0,0,,Мен оны Сатсуға қалдыруым керек пе?
Dialogue: 0,0:10:59.90,0:11:01.96,Default,,0,0,0,,Ол сол көз тамшыларын қолданып жүрген.
Dialogue: 0,0:11:02.36,0:11:03.30,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:11:03.36,0:11:07.96,Default,,0,0,0,,Сондықтан менің ойымша, бұл қанды көзді қайтарудың қажеті жоқ.
Dialogue: 0,0:11:08.03,0:11:09.30,Default,,0,0,0,,Даттейо
Dialogue: 0,0:11:10.06,0:11:10.56,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:11:10.90,0:11:11.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:11.76,0:11:12.26,Default,,0,0,0,,Уау
Dialogue: 0,0:11:12.40,0:11:12.90,Default,,0,0,0,,На
Dialogue: 0,0:11:13.50,0:11:14.20,Default,,0,0,0,,Әй
Dialogue: 0,0:11:14.53,0:11:16.76,Default,,0,0,0,,Мен толығырақ мәліметтерді тыңдағым келеді.
Dialogue: 0,0:11:25.20,0:11:26.70,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:11:27.93,0:11:28.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:30.06,0:11:31.03,Default,,0,0,0,,Сен де
Dialogue: 0,0:11:35.20,0:11:38.86,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:11:39.33,0:11:42.73,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:11:45.50,0:11:49.06,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:11:51.46,0:11:58.53,Default,,0,0,0,,Ха ха ха ха ха ха ха
Dialogue: 0,0:12:09.40,0:12:11.76,Default,,0,0,0,,Оны су астында жүргізген дұрыс.
Dialogue: 0,0:12:15.50,0:12:16.36,Default,,0,0,0,,Өйткені ол бітеліп қалады
Dialogue: 0,0:12:17.93,0:12:23.46,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:12:24.06,0:12:24.93,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:12:25.00,0:12:30.86,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:12:34.36,0:12:35.00,Default,,0,0,0,,-Аа -Уау
Dialogue: 0,0:12:35.70,0:12:36.20,Default,,0,0,0,,Ой
Dialogue: 0,0:12:36.43,0:12:37.83,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:12:42.93,0:12:43.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:44.20,0:12:44.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:45.33,0:12:47.43,Default,,0,0,0,,Бұл
Dialogue: 0,0:12:51.96,0:12:53.23,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:53.53,0:12:56.40,Default,,0,0,0,,Мен оны енді қаламаймын, мен оны саған беремін
Dialogue: 0,0:12:56.60,0:12:58.46,Default,,0,0,0,,Бақытты Иә Иә Иә Иә Иә
Dialogue: 0,0:13:02.66,0:13:03.16,Default,,0,0,0,,Иә
Dialogue: 0,0:13:05.16,0:13:08.53,Default,,0,0,0,,Кешіріңіз, менің ішім мен арқам бір-біріне тиіп қала жаздады.
Dialogue: 0,0:13:08.96,0:13:11.56,Default,,0,0,0,,-Жарайды ахахаха -хахахаха
Dialogue: 0,0:13:16.10,0:13:17.20,Default,,0,0,0,,Жақсы ұшақ.
Dialogue: 0,0:13:17.33,0:13:18.20,Default,,0,0,0,,Ескі үлгі
Dialogue: 0,0:13:18.76,0:13:20.06,Default,,0,0,0,,Ол менің серіктесім болғанына 10 жыл болды.
Dialogue: 0,0:13:20.73,0:13:22.43,Default,,0,0,0,,Сіз көп жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:13:23.16,0:13:24.76,Default,,0,0,0,,Өйткені мен барлық жерде саяхаттаймын.
Dialogue: 0,0:13:25.96,0:13:27.73,Default,,0,0,0,,Мен іс жүзінде саяхатшымын.
Dialogue: 0,0:13:28.80,0:13:32.63,Default,,0,0,0,,Woohoo, ол әзілдеді ме, әлде байсалды ма, айта алмаймын.
Dialogue: 0,0:13:33.16,0:13:34.20,Default,,0,0,0,,Көбінесе айтылады
Dialogue: 0,0:13:35.50,0:13:36.56,Default,,0,0,0,,Сіз Марста болдыңыз ба?
Dialogue: 0,0:13:37.03,0:13:37.93,Default,,0,0,0,,Марста дүниеге келген
Dialogue: 0,0:13:39.00,0:13:40.66,Default,,0,0,0,,Менің ойымша, мұнда бәрі бар.
Dialogue: 0,0:13:41.36,0:13:42.83,Default,,0,0,0,,Мұндай жерлерден айырмашылығы
Dialogue: 0,0:13:43.16,0:13:45.93,Default,,0,0,0,,Әртүрлі адамдар және әртүрлі заттар бар.
Dialogue: 0,0:13:46.23,0:13:47.96,Default,,0,0,0,,Олар бақытты өмір сүріп жатырмыз дейді.
Dialogue: 0,0:13:49.03,0:13:50.33,Default,,0,0,0,,Тек ақшасы барлар
Dialogue: 0,0:13:51.60,0:13:53.86,Default,,0,0,0,,Сонда сенің бақытты болатыныңа сенімдімін.
Dialogue: 0,0:14:00.66,0:14:02.00,Default,,0,0,0,,Марсқа қашуды жоспарлап отырсыз ба?
Dialogue: 0,0:14:02.33,0:14:02.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:03.10,0:14:05.66,Default,,0,0,0,,Қашып кетсем де, қанша жерге барамын?
Dialogue: 0,0:14:06.43,0:14:07.06,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:14:08.03,0:14:09.93,Default,,0,0,0,,Ескі ковбой
Dialogue: 0,0:14:11.03,0:14:11.96,Default,,0,0,0,,Боунти аңшысы
Dialogue: 0,0:14:12.86,0:14:13.80,Default,,0,0,0,,Танымал жауаптар
Dialogue: 0,0:14:14.76,0:14:15.70,Default,,0,0,0,,Мен сені ұстай алмаймын
Dialogue: 0,0:14:16.90,0:14:18.86,Default,,0,0,0,,Сіздің серігіңіз денесіне көп зақым келтірді.
Dialogue: 0,0:14:19.66,0:14:21.53,Default,,0,0,0,,Мен әлсіз кішкентай шабақтармен айналыспаймын.
Dialogue: 0,0:14:23.10,0:14:24.23,Default,,0,0,0,,Бұл ақылды.
Dialogue: 0,0:14:24.76,0:14:25.26,Default,,0,0,0,,Уау
Dialogue: 0,0:14:26.93,0:14:28.56,Default,,0,0,0,,Сен кішкентай шабақсың.
Dialogue: 0,0:14:28.60,0:14:30.53,Default,,0,0,0,,Ахх
Dialogue: 0,0:14:31.70,0:14:33.96,Default,,0,0,0,,Ммм аа
Dialogue: 0,0:14:34.03,0:14:34.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:35.26,0:14:36.90,Default,,0,0,0,,Асимов Жетеді.
Dialogue: 0,0:14:49.16,0:14:50.40,Default,,0,0,0,,Адиос Ковбой
Dialogue: 0,0:15:04.36,0:15:05.30,Default,,0,0,0,,Неге тоқтадың?
Dialogue: 0,0:15:05.63,0:15:06.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:06.83,0:15:10.23,Default,,0,0,0,,Мен оның тыныс алуын 1 секундта тоқтата алдым.
Dialogue: 0,0:15:10.50,0:15:11.76,Default,,0,0,0,,Сіз шаршадыңыз.
Dialogue: 0,0:15:12.33,0:15:13.20,Default,,0,0,0,,Тоқтаңдар, екеуің де
Dialogue: 0,0:15:13.33,0:15:14.93,Default,,0,0,0,,Ол жас және жақсы адам еді.
Dialogue: 0,0:15:18.03,0:15:22.23,Default,,0,0,0,,Мен сені алып кетуіңді күттім
Dialogue: 0,0:15:22.96,0:15:25.40,Default,,0,0,0,,Мен бұл өмірден ақыры шыға аламын деп ойлаймын.
Dialogue: 0,0:15:27.43,0:15:29.33,Default,,0,0,0,,Біз Марста бақытты өмір сүре аламыз.
Dialogue: 0,0:15:40.26,0:15:42.20,Default,,0,0,0,,Ұйқы - талғампаз.
Dialogue: 0,0:15:42.70,0:15:43.96,Default,,0,0,0,,Мен жақсы түс көрдім
Dialogue: 0,0:15:44.06,0:15:45.73,Default,,0,0,0,,О, бұл жақсы.
Dialogue: 0,0:15:46.03,0:15:49.46,Default,,0,0,0,,Содан кейін Бебопқа оралыңыз және оны баяу қараңыз.
Dialogue: 0,0:15:49.80,0:15:51.70,Default,,0,0,0,,Бұл жолы мен де бас тарттым.
Dialogue: 0,0:15:51.83,0:15:53.93,Default,,0,0,0,,Оны ұстау мүмкін емес.
Dialogue: 0,0:15:54.26,0:15:55.96,Default,,0,0,0,,​​Оның орындалуы мүмкін емес.
Dialogue: 0,0:15:56.43,0:16:00.10,Default,,0,0,0,,Асимов ұйымнан қашқан кезде өзімен бірге бірдеңе алып кеткен.
Dialogue: 0,0:16:00.46,0:16:05.36,Default,,0,0,0,,Бұл ұйымды қаржыландыру көзі болған заңсыз көз тамшылары арасында ең жақсысы болды.
Dialogue: 0,0:16:06.03,0:16:09.96,Default,,0,0,0,,Олар осының бәрін алып қашып кетті, сондықтан олар шу шығарып жатыр.
Dialogue: 0,0:16:10.33,0:16:13.06,Default,,0,0,0,,Оларды ұстауға қанша тырысқанымызбен, өлім-жітім көбейе береді.
Dialogue: 0,0:16:13.63,0:16:17.20,Default,,0,0,0,,Асимов сол көз тамшыларын пайдаланады.
Dialogue: 0,0:16:17.66,0:16:19.10,Default,,0,0,0,,Қанды көздер
Dialogue: 0,0:16:19.26,0:16:21.46,Default,,0,0,0,,Олар Марсқа барады.
Dialogue: 0,0:16:21.56,0:16:22.53,Default,,0,0,0,,Марс?
Dialogue: 0,0:16:22.63,0:16:24.80,Default,,0,0,0,,Бұған дейін мына жігітті сат.
Dialogue: 0,0:16:25.26,0:16:26.80,Default,,0,0,0,,Иә? Яғни
Dialogue: 0,0:16:26.93,0:16:28.66,Default,,0,0,0,,Мен оны оның қалтасынан алдым.
Dialogue: 0,0:16:29.10,0:16:31.03,Default,,0,0,0,,Сіз кездестірдіңіз бе?
Dialogue: 0,0:16:31.66,0:16:32.86,Default,,0,0,0,,Бұл жаман түс
Dialogue: 0,0:16:33.56,0:16:35.26,Default,,0,0,0,,Иә, сен мұны істедің.
Dialogue: 0,0:16:35.76,0:16:39.53,Default,,0,0,0,,Қызыл көзді қояттар солтүстік қалалардың шетінде пайда болады делінеді.
Dialogue: 0,0:16:55.33,0:16:56.30,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:17:00.30,0:17:02.96,Default,,0,0,0,,Міне, тағы бар, қарғыс атқыр.
Dialogue: 0,0:17:03.56,0:17:06.46,Default,,0,0,0,,Балалар, мені осылай мазақ етесіңдер.
Dialogue: 0,0:17:06.70,0:17:09.20,Default,,0,0,0,,Осы маңдағы мейрамханаларда дәмді тағамдарды жеуге болады.
Dialogue: 0,0:17:09.33,0:17:11.43,Default,,0,0,0,,Мен және менің достарым
Dialogue: 0,0:17:11.50,0:17:13.13,Default,,0,0,0,,Мұның бәрі осы жерді өңдеудің арқасында.
Dialogue: 0,0:17:13.20,0:17:15.30,Default,,0,0,0,,Бұл біз.
Dialogue: 0,0:17:15.36,0:17:19.76,Default,,0,0,0,,Жер жырттың, егін ектің.
Dialogue: 0,0:17:19.83,0:17:22.83,Default,,0,0,0,,Сен басқа тұқымдарды септің.
Dialogue: 0,0:17:25.13,0:17:25.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:35.73,0:17:37.23,Default,,0,0,0,,Қанды Мэри бар ма?
Dialogue: 0,0:17:37.83,0:17:38.93,Default,,0,0,0,,Менде тек сыра бар.
Dialogue: 0,0:17:40.03,0:17:41.13,Default,,0,0,0,,Томат шырыны бар.
Dialogue: 0,0:17:41.86,0:17:42.53,Default,,0,0,0,,Бұл қанша?
Dialogue: 0,0:17:42.93,0:17:44.26,Default,,0,0,0,,300 000 оолонг.
Dialogue: 0,0:17:44.70,0:17:45.50,Default,,0,0,0,,50 қап бар.
Dialogue: 0,0:17:46.10,0:17:47.86,Default,,0,0,0,,15 миллион оолонг?
Dialogue: 0,0:17:48.30,0:17:48.80,Default,,0,0,0,,Мен асығып тұрмын
Dialogue: 0,0:17:49.53,0:17:50.50,Default,,0,0,0,,Егер ол жұмыс істемесе, басқа нәрсені көріңіз
Dialogue: 0,0:17:51.76,0:17:52.53,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:17:55.30,0:17:56.36,Default,,0,0,0,,Ах
Dialogue: 0,0:17:56.90,0:17:57.56,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:17:59.70,0:18:01.73,Default,,0,0,0,,Бағаңызды білесіз бе?
Dialogue: 0,0:18:02.63,0:18:03.13,Default,,0,0,0,,Не?
Dialogue: 0,0:18:03.70,0:18:06.06,Default,,0,0,0,,Бұл небәрі 2,5 миллион оолонг.
Dialogue: 0,0:18:06.73,0:18:08.13,Default,,0,0,0,,Ол арзан жігіт.
Dialogue: 0,0:18:11.33,0:18:12.20,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:18:12.46,0:18:13.86,Default,,0,0,0,,Сіз қашан дилер болдыңыз?
Dialogue: 0,0:18:14.23,0:18:15.66,Default,,0,0,0,,Сыйлыққа аң аулаудан бас тарттыңыз ба?
Dialogue: 0,0:18:16.36,0:18:18.93,Default,,0,0,0,,Арзан сыйлықтармен бәсекеге түсе алмайсыз.
Dialogue: 0,0:18:19.73,0:18:21.60,Default,,0,0,0,,Сіз жақсы ұры сияқтысыз.
Dialogue: 0,0:18:22.30,0:18:23.03,Default,,0,0,0,,Қайтарып алайық
Dialogue: 0,0:18:24.10,0:18:26.73,Default,,0,0,0,,Саған қайтарсам да, сен маған бір нәрсе бересің.
Dialogue: 0,0:18:28.43,0:18:28.93,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:18:30.23,0:18:31.16,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:18:31.76,0:18:32.53,Default,,0,0,0,,О, жоқ, уа, уа
Dialogue: 0,0:18:33.76,0:18:34.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:35.50,0:18:36.00,Default,,0,0,0,,Ахх
Dialogue: 0,0:18:36.76,0:18:38.43,Default,,0,0,0,,Фуфуфуа
Dialogue: 0,0:18:39.06,0:18:40.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:43.13,0:18:44.43,Default,,0,0,0,,Көздеріңізге тым көп сенесіз.
Dialogue: 0,0:18:45.06,0:18:46.30,Default,,0,0,0,,​​Бұл хамелеон емес.
Dialogue: 0,0:18:46.80,0:18:47.96,Default,,0,0,0,,Мен барлық жерден көре алмаймын
Dialogue: 0,0:18:48.33,0:18:50.33,Default,,0,0,0,,Уау Уау Уау
Dialogue: 0,0:18:52.03,0:18:53.90,Default,,0,0,0,,О аааааааааааааааааааа
Dialogue: 0,0:18:54.63,0:18:55.13,Default,,0,0,0,,Ах
Dialogue: 0,0:18:55.40,0:18:57.20,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:18:59.53,0:19:00.90,Default,,0,0,0,,Уау
Dialogue: 0,0:19:01.43,0:19:01.93,Default,,0,0,0,,О
Dialogue: 0,0:19:02.30,0:19:04.73,Default,,0,0,0,,Аххххххххххххххххххххххххххххххххххххххххххххххх.
Dialogue: 0,0:19:05.23,0:19:06.56,Default,,0,0,0,,Ааа
Dialogue: 0,0:19:07.23,0:19:07.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:10.90,0:19:11.50,Default,,0,0,0,,Уф, кеттік
Dialogue: 0,0:19:13.20,0:19:14.06,Default,,0,0,0,,Ха, солай.
Dialogue: 0,0:19:16.96,0:19:18.56,Default,,0,0,0,,Ана жақта, ана жақта, уау!
Dialogue: 0,0:19:18.70,0:19:19.90,Default,,0,0,0,,Бұл не? Апыр-ай.
Dialogue: 0,0:19:20.10,0:19:20.66,Default,,0,0,0,,Уау
Dialogue: 0,0:19:21.23,0:19:22.23,Default,,0,0,0,,-Қозғалма -Уа
Dialogue: 0,0:19:22.70,0:19:24.66,Default,,0,0,0,,Жарайды, тыныш бол.
Dialogue: 0,0:19:27.66,0:19:29.56,Default,,0,0,0,,Ах фу ах
Dialogue: 0,0:19:30.26,0:19:30.83,Default,,0,0,0,,О
Dialogue: 0,0:19:33.23,0:19:33.86,Default,,0,0,0,,Ах
Dialogue: 0,0:19:34.50,0:19:35.20,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:19:36.20,0:19:38.90,Default,,0,0,0,,Бұл жігіт құласа, бітті. Сақ болыңыз.
Dialogue: 0,0:19:42.30,0:19:43.80,Default,,0,0,0,,Бұны тәртіпке салу өте қиын.
Dialogue: 0,0:19:46.30,0:19:47.43,Default,,0,0,0,,Уау
Dialogue: 0,0:19:51.53,0:19:52.03,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:19:52.86,0:19:53.43,Default,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:19:57.30,0:19:59.13,Default,,0,0,0,,Хмм, күткенім үшін кешіріңіз.
Dialogue: 0,0:19:59.86,0:20:01.20,Default,,0,0,0,,Жасайық, Джет
Dialogue: 0,0:20:01.63,0:20:02.13,Default,,0,0,0,,Ах
Dialogue: 0,0:20:02.56,0:20:03.06,Default,,0,0,0,,Алға
Dialogue: 0,0:20:12.36,0:20:13.86,Default,,0,0,0,,- Фуфуфу - Асимов
Dialogue: 0,0:20:41.43,0:20:42.10,Default,,0,0,0,,Тоқта
Dialogue: 0,0:20:42.43,0:20:43.86,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:20:44.76,0:20:45.36,Default,,0,0,0,,- Уф - Жақсы емес.
Dialogue: 0,0:20:45.40,0:20:45.93,Default,,0,0,0,,Уау
Dialogue: 0,0:21:05.70,0:21:06.83,Default,,0,0,0,,Мен енді қаша алмаймын
Dialogue: 0,0:21:08.66,0:21:09.80,Default,,0,0,0,,Мен қашып құтыла алмаймын
Dialogue: 0,0:21:17.80,0:21:18.50,Default,,0,0,0,,Га
Dialogue: 0,0:21:33.06,0:21:33.96,Default,,0,0,0,,Adios
Dialogue: 0,0:21:52.16,0:21:54.20,Default,,0,0,0,,Ей, шыбықтар көтерілді.
Dialogue: 0,0:21:54.46,0:21:54.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:18.13,0:22:19.10,Default,,0,0,0,,Аяқталды
Dialogue: 0,0:22:19.43,0:22:20.03,Default,,0,0,0,,Мәзірде не бар?
Dialogue: 0,0:22:20.90,0:22:22.73,Default,,0,0,0,,Арнайы Чинджао белі
Dialogue: 0,0:22:28.26,0:22:29.40,Default,,0,0,0,,Уф
Dialogue: 0,0:22:52.63,0:22:57.56,Default,,0,0,0,,Мен сені сүйдім деп күйіну
Dialogue: 0,0:22:58.63,0:23:02.63,Default,,0,0,0,,Тым көп уақыт өтті
Dialogue: 0,0:23:04.56,0:23:09.93,Default,,0,0,0,,Менің жүрегім әлі де жаралы
Dialogue: 0,0:23:10.60,0:23:15.16,Default,,0,0,0,,Емсіз жел соғып тұр
Dialogue: 0,0:23:16.93,0:23:25.23,Default,,0,0,0,,Біреу көзі құрғап жылай берсін
Dialogue: 0,0:23:27.60,0:23:30.96,Default,,0,0,0,,НАҒЫЗ ХАЛЫҚТЫҚ КӨКТЕР
Dialogue: 0,0:23:31.13,0:23:39.36,Default,,0,0,0,,Мен жай ғана шынайы қайғыны білгім келеді
Dialogue: 0,0:23:39.60,0:23:51.36,Default,,0,0,0,,Балшық өзенге батырылған өмір соншалықты жаман емес.
Dialogue: 0,0:23:51.60,0:24:00.40,Default,,0,0,0,,Егер ол тек бір рет аяқталса
Dialogue: 0,0:24:16.53,0:24:17.23,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:24:17.36,0:24:18.90,Default,,0,0,0,,Бұл бағдарлама ақыры басталды
Dialogue: 0,0:24:18.96,0:24:20.23,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,0:24:20.30,0:24:22.63,Default,,0,0,0,,Келесі аптада біз оны отбасылық анимеге айналдырамыз.
Dialogue: 0,0:24:22.90,0:24:23.96,Default,,0,0,0,,Сіз бұл туралы айтып тұрсыз ба?
Dialogue: 0,0:24:24.13,0:24:25.76,Default,,0,0,0,,Күлкілі жануарлар аң-таң
Dialogue: 0,0:24:25.80,0:24:26.30,Default,,0,0,0,,Не?
Dialogue: 0,0:24:26.30,0:24:27.93,Default,,0,0,0,,Мұны айтсам да, Муцугоро мырза көрінбейді.
Dialogue: 0,0:24:28.30,0:24:30.30,Default,,0,0,0,,Балалардан малды жақсы көретін қарттарға дейін
Dialogue: 0,0:24:30.36,0:24:31.83,Default,,0,0,0,,Эй, сәл күте тұрыңыз, Спайк.
Dialogue: 0,0:24:31.90,0:24:33.63,Default,,0,0,0,,Барлығыңыз бірге көріңіздер.
Dialogue: 0,0:24:33.86,0:24:35.50,Default,,0,0,0,,Бұлай айту шынымен дұрыс па?
Dialogue: 0,0:24:36.03,0:24:36.93,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:24:37.00,0:24:38.43,Default,,0,0,0,,Бірақ менің саған бір өтінішім бар.
Dialogue: 0,0:24:38.63,0:24:40.76,Default,,0,0,0,,Барлық жақсы балалар, теледидардан аулақ болыңыз және оны көріңіз.
