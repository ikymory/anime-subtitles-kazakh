Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:04.92,Default,,0,0,0,,(велосипед қоңырауы)
Dialogue: 0,0:00:24.60,0:00:26.69,Default,,0,0,0,,Жаз аяқталуға жақын.
Dialogue: 0,0:00:27.11,0:00:31.24,Default,,0,0,0,,Осы жаз біткен соң, келесі жаз келгенше
Dialogue: 0,0:00:31.69,0:00:32.74,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:35.11,0:00:37.24,Default,,0,0,0,,Сіз қызықты нәрсе таптыңыз ба?
Dialogue: 0,0:00:38.28,0:00:39.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:40.62,0:00:41.50,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:44.58,0:00:47.79,Default,,0,0,0,,Аа, мен бұл туралы ойладым.
Dialogue: 0,0:00:49.50,0:00:52.38,Default,,0,0,0,,Бір қызығы, әр күнім қызық.
Dialogue: 0,0:00:53.30,0:00:54.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:06.35,0:01:08.11,Default,,0,0,0,,♪～
Dialogue: 0,0:01:08.23,0:01:11.23,Default,,0,0,0,,Сәлеметсіздер ме, қымбатты достарым
Dialogue: 0,0:01:11.53,0:01:14.11,Default,,0,0,0,,Маған армандарың туралы айтып бер
Dialogue: 0,0:01:14.28,0:01:19.20,Default,,0,0,0,,Сол күндер есіңізде ме?
Dialogue: 0,0:01:20.58,0:01:26.50,Default,,0,0,0,,Ересек болу қиын, солай емес пе?
Dialogue: 0,0:01:26.62,0:01:33.26,Default,,0,0,0,,Жасырылған нәрсені тауып алайық.
Dialogue: 0,0:01:34.63,0:01:35.63,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:01:44.35,0:01:50.31,Default,,0,0,0,,Өзіңіздің беймаза ойыңызды тастаңыз
Dialogue: 0,0:01:50.48,0:01:53.32,Default,,0,0,0,,Бұлттар жүзіп келеді
Dialogue: 0,0:01:53.44,0:01:57.36,Default,,0,0,0,,Жоғары қарап, секір!
Dialogue: 0,0:01:58.32,0:02:01.20,Default,,0,0,0,,Жаңбыр тоқтады
Dialogue: 0,0:02:01.41,0:02:04.37,Default,,0,0,0,,Ән айту
Dialogue: 0,0:02:04.58,0:02:07.96,Default,,0,0,0,,Қол ұстасу
Dialogue: 0,0:02:10.75,0:02:13.67,Default,,0,0,0,,Мен күлдім
Dialogue: 0,0:02:13.80,0:02:16.84,Default,,0,0,0,,Сен де күлесің
Dialogue: 0,0:02:16.97,0:02:20.22,Default,,0,0,0,,Әрине ұнайды
Dialogue: 0,0:02:20.34,0:02:26.18,Default,,0,0,0,,Тағы кездесейік
Dialogue: 0,0:02:32.73,0:02:35.11,Default,,0,0,0,,～♪
Dialogue: 0,0:02:37.95,0:02:39.95,Default,,0,0,0,,(домофон дыбысы)
Dialogue: 0,0:02:40.57,0:02:42.28,Default,,0,0,0,,(домофон дыбысы)
Dialogue: 0,0:02:42.37,0:02:44.95,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:02:46.16,0:02:49.00,Default,,0,0,0,,Ха ха
Dialogue: 0,0:02:49.12,0:02:52.00,Default,,0,0,0,,Ха, м... бұл өтірік...
Dialogue: 0,0:02:52.59,0:02:57.01,Default,,0,0,0,,Қайда? Мен мектепте немесе ғибадатханада болған жоқпын.
Dialogue: 0,0:02:57.13,0:02:58.84,Default,,0,0,0,,Хахаха
Dialogue: 0,0:02:58.92,0:02:59.84,Default,,0,0,0,,Кохон Ха
Dialogue: 0,0:03:02.51,0:03:04.81,Default,,0,0,0,,Ха, Риота-нии-чан?
Dialogue: 0,0:03:05.26,0:03:06.10,Default,,0,0,0,,Иә
Dialogue: 0,0:03:06.18,0:03:08.48,Default,,0,0,0,,Мацури-чан не іздейді?
Dialogue: 0,0:03:09.60,0:03:10.64,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:03:10.73,0:03:12.02,Default,,0,0,0,,Мүлде жоқ!
Dialogue: 0,0:03:18.07,0:03:20.07,Default,,0,0,0,,Өте ащы
Dialogue: 0,0:03:20.53,0:03:22.57,Default,,0,0,0,,Ішсең, барасың ба?
Dialogue: 0,0:03:22.91,0:03:23.74,Default,,0,0,0,,Қайда?
Dialogue: 0,0:03:24.41,0:03:26.08,Default,,0,0,0,,Экчан мырзаға барыңыз
Dialogue: 0,0:03:26.33,0:03:28.00,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:03:28.08,0:03:28.91,Default,,0,0,0,,Ой, тоқта! Төмендегі Коике үйінде су ағып жатыр!
Dialogue: 0,0:03:29.00,0:03:30.21,Default,,0,0,0,,Әлде Экчан мырза?
Dialogue: 0,0:03:30.75,0:03:33.21,Default,,0,0,0,,Экчан мырза, сіз оның қайда екенін білесіз бе?
Dialogue: 0,0:03:33.75,0:03:36.13,Default,,0,0,0,,Артымнан ерсең, түсінесің.
Dialogue: 0,0:03:36.25,0:03:38.01,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:42.30,0:03:43.47,Default,,0,0,0,,Ryota-nii-chan
Dialogue: 0,0:03:44.09,0:03:46.64,Default,,0,0,0,,Экчан мырзаның қайда екенін қайдан білесіз?
Dialogue: 0,0:03:47.60,0:03:49.27,Default,,0,0,0,,Өйткені мен бәрін көрдім
Dialogue: 0,0:03:51.39,0:03:52.60,Default,,0,0,0,,Оны қайдан көрдің?
Dialogue: 0,0:03:53.19,0:03:56.61,Default,,0,0,0,,Бірде орындықта, бірде бағана артында
Dialogue: 0,0:04:01.53,0:04:02.91,Default,,0,0,0,,Қандай қорқынышты!
Dialogue: 0,0:04:03.82,0:04:05.49,Default,,0,0,0,,Я, мен қорықпаймын.
Dialogue: 0,0:04:06.33,0:04:08.99,Default,,0,0,0,,Мысалы, желге айналады делік.
Dialogue: 0,0:04:09.20,0:04:11.83,Default,,0,0,0,,Қазір соғып тұрған жел қайдан пайда болды?
Dialogue: 0,0:04:11.96,0:04:14.04,Default,,0,0,0,,Оның қайда аяқталатынын білесіз бе?
Dialogue: 0,0:04:14.29,0:04:17.88,Default,,0,0,0,,Желдің орны да, ұшы да жоқ.
Dialogue: 0,0:04:18.13,0:04:20.01,Default,,0,0,0,,Әлі де ешкім мән бермейді
Dialogue: 0,0:04:20.51,0:04:22.38,Default,,0,0,0,,Желде отбасы тіркелімі жоқ.
Dialogue: 0,0:04:22.80,0:04:25.14,Default,,0,0,0,,Бұл жел/отбасы регистрінің теориясы.
Dialogue: 0,0:04:25.89,0:04:27.39,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:04:27.68,0:04:29.97,Default,,0,0,0,,Не, бәрі қорқынышты!
Dialogue: 0,0:04:30.56,0:04:33.31,Default,,0,0,0,,Сіз шынымен Экчанның орнына барасыз ба?
Dialogue: 0,0:04:33.48,0:04:34.31,Default,,0,0,0,,Сіз алаңдайсыз ба?
Dialogue: 0,0:04:34.40,0:04:36.23,Default,,0,0,0,,Мен уайымнан басқа ештеңе сезбеймін!
Dialogue: 0,0:04:36.31,0:04:38.73,Default,,0,0,0,,Дұрыс, жауап желде...
Dialogue: 0,0:04:38.82,0:04:39.86,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:04:39.94,0:04:42.15,Default,,0,0,0,,Жауабы желде билеу
Dialogue: 0,0:04:42.24,0:04:45.24,Default,,0,0,0,,Тоқта! Түсейік!
Dialogue: 0,0:04:49.12,0:04:50.66,Default,,0,0,0,,Біз сізге хабарлаймыз
Dialogue: 0,0:04:51.20,0:04:53.66,Default,,0,0,0,,Ұлыбританияға келесі тікелей рейс...
Dialogue: 0,0:04:53.91,0:04:57.67,Default,,0,0,0,,Дәл қазір капитан түшкіруді тоқтатқан жоқ, сондықтан біз ұшуды тоқтатамыз.
Dialogue: 0,0:04:58.21,0:05:00.38,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,0:05:00.50,0:05:01.88,Default,,0,0,0,,Мен кітап сатып алайын деп жатырмын (Эридің анасы)...
Dialogue: 0,0:05:02.38,0:05:04.84,Default,,0,0,0,,Қақпаның ішінде Ол әлдеқашан ішінде.
Dialogue: 0,0:05:05.22,0:05:06.14,Default,,0,0,0,,Whis
Dialogue: 0,0:05:07.14,0:05:11.64,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:05:12.02,0:05:15.06,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:05:15.69,0:05:17.06,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:05:23.90,0:05:28.95,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:05:35.96,0:05:39.46,Default,,0,0,0,,Түсіндім! неге үндемеуге тырысасың
Dialogue: 0,0:05:39.67,0:05:41.75,Default,,0,0,0,,Жалғыз өмір сүруім үшін.
Dialogue: 0,0:05:41.84,0:05:43.46,Default,,0,0,0,,Бұл жаттығу және қарау!
Dialogue: 0,0:05:44.30,0:05:45.13,Default,,0,0,0,,Уау
Dialogue: 0,0:05:45.55,0:05:47.68,Default,,0,0,0,,Уф
Dialogue: 0,0:05:52.35,0:05:54.14,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:54.27,0:05:57.60,Default,,0,0,0,,Бұл жай ғана ұяттың тұрақты еместігі.
Dialogue: 0,0:05:57.85,0:06:00.77,Default,,0,0,0,,Экчан жұлдыз туралы бірдеңе тапты!
Dialogue: 0,0:06:01.44,0:06:02.40,Default,,0,0,0,,Бууууууу~!
Dialogue: 0,0:06:03.94,0:06:04.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:11.83,0:06:14.12,Default,,0,0,0,,Га, Экчан мырза күткендей.
Dialogue: 0,0:06:14.70,0:06:19.42,Default,,0,0,0,,Мен ешқандай клубтық іс-шараларға қатыспадым, бірақ мен Айкидодан сырттай курстан өттім!
Dialogue: 0,0:06:21.09,0:06:21.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:27.67,0:06:28.63,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:29.05,0:06:31.22,Default,,0,0,0,,Ммммммммммм
Dialogue: 0,0:06:31.68,0:06:33.76,Default,,0,0,0,,Бір шешім қабылдасаңыз, оны өзгертпейсіз...
Dialogue: 0,0:06:34.26,0:06:36.93,Default,,0,0,0,,Менің ережелерім абсолютті екенін білемін.
Dialogue: 0,0:06:37.64,0:06:38.60,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:39.69,0:06:40.60,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:41.19,0:06:43.23,Default,,0,0,0,,Экчан туралы осындай нәрсе...
Dialogue: 0,0:06:45.78,0:06:48.49,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:06:48.57,0:06:50.95,Default,,0,0,0,,Капитан түшкіруді қойды, сондықтан...
Dialogue: 0,0:06:51.03,0:06:54.08,Default,,0,0,0,,Мен жақында Англияға кетемін.
Dialogue: 0,0:06:54.16,0:06:55.62,Default,,0,0,0,,Қақпаға асығыңыз
Dialogue: 0,0:06:56.16,0:06:58.62,Default,,0,0,0,,Мацури-чан, уақыт таяп қалды.
Dialogue: 0,0:07:01.17,0:07:02.00,Default,,0,0,0,,А...
Dialogue: 0,0:07:08.09,0:07:10.09,Default,,0,0,0,,Ух... Қош бол!
Dialogue: 0,0:07:10.30,0:07:14.22,Default,,0,0,0,,Экчан! Сау бол! Сау бол!
Dialogue: 0,0:07:14.30,0:07:18.14,Default,,0,0,0,,D Gate Boarding жақын арада жабылады.
Dialogue: 0,0:07:33.49,0:07:34.53,Default,,0,0,0,,Оны тастаңыз!
Dialogue: 0,0:07:34.83,0:07:38.25,Default,,0,0,0,,Эстетика! менің! Мен түсінбедім!
Dialogue: 0,0:07:38.33,0:07:39.58,Default,,0,0,0,,Өте жақсы болды!
Dialogue: 0,0:07:40.12,0:07:43.29,Default,,0,0,0,,Соңында танысқаныма қуаныштымын және біз қоштасқалы жатырмыз!
Dialogue: 0,0:07:44.25,0:07:46.75,Default,,0,0,0,,Жеке кездесіп, қоштасуға болмайды...
Dialogue: 0,0:07:47.09,0:07:48.92,Default,,0,0,0,,Бұл жалғыздық болуы керек!
Dialogue: 0,0:07:49.51,0:07:50.67,Default,,0,0,0,,Мен сені сағындым!
Dialogue: 0,0:07:50.76,0:07:53.43,Default,,0,0,0,,Кездессек те, кездестірмесек те, жалғыз қаламын.
Dialogue: 0,0:07:53.51,0:07:56.26,Default,,0,0,0,,Егер солай болса, кездесуге жарайды деп ойлаймын!
Dialogue: 0,0:07:56.60,0:07:57.56,Default,,0,0,0,,Фестиваль…
Dialogue: 0,0:07:58.31,0:08:00.23,Default,,0,0,0,,Ұшаққа мінсем сені кездестіре аламын, бірақ...
Dialogue: 0,0:08:00.43,0:08:03.40,Default,,0,0,0,,Мектепке барсам, Е-чан жоқ екен.
Dialogue: 0,0:08:03.81,0:08:05.90,Default,,0,0,0,,Ах! Мен енді түсіндім!
Dialogue: 0,0:08:06.23,0:08:10.61,Default,,0,0,0,,Экчан, сен маған мектепті таста деп айтқың келді ме?
Dialogue: 0,0:08:10.69,0:08:11.57,Default,,0,0,0,,Зузуцу
Dialogue: 0,0:08:11.74,0:08:15.99,Default,,0,0,0,,Мен дүкенде жұмыс істейтіндіктен, егер мен толық емес жұмыс күніммен айналыссам ...
Dialogue: 0,0:08:16.07,0:08:17.45,Default,,0,0,0,,Себебі мен Англияға көп барамын!
Dialogue: 0,0:08:17.45,0:08:18.74,Default,,0,0,0,,Себебі мен Англияға көп барамын!
Dialogue: 0,0:08:17.45,0:08:18.74,Default,,0,0,0,,Уф
Dialogue: 0,0:08:18.74,0:08:19.12,Default,,0,0,0,,Себебі мен Англияға көп барамын!
Dialogue: 0,0:08:19.20,0:08:22.54,Default,,0,0,0,,Түсіндім! Экчан күткендей!
Dialogue: 0,0:08:23.17,0:08:26.00,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:08:26.59,0:08:27.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:28.30,0:08:30.96,Default,,0,0,0,,Рико Бұл жаман. Біраз уақыт алатын сияқты.
Dialogue: 0,0:08:31.47,0:08:33.26,Default,,0,0,0,,Тағы бір рет өтінемін. Иә.
Dialogue: 0,0:08:49.07,0:08:50.69,Default,,0,0,0,,Стратегияны өзгерту
Dialogue: 0,0:08:51.65,0:08:55.36,Default,,0,0,0,,Құдық ішіндегі тыныштықты бірге қорғайық.
Dialogue: 0,0:08:55.45,0:08:56.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:56.53,0:08:59.53,Default,,0,0,0,,Бірақ бұл жолы мен оны жақсы кеңейтемін.
Dialogue: 0,0:09:00.41,0:09:01.29,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:09:02.33,0:09:03.25,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:03.91,0:09:06.12,Default,,0,0,0,,Мектеп өміріңізді қалыпты түрде өткізіңіз...
Dialogue: 0,0:09:07.00,0:09:07.83,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:08.67,0:09:11.21,Default,,0,0,0,,Фестиваль болса, жарайды...
Dialogue: 0,0:09:12.17,0:09:13.01,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:15.05,0:09:16.13,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:09:17.34,0:09:18.60,Default,,0,0,0,,Маған қоңырау шалғаныңызға рахмет...
Dialogue: 0,0:09:19.64,0:09:21.93,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:09:22.52,0:09:23.35,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:24.10,0:09:26.81,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:09:27.15,0:09:29.61,Default,,0,0,0,,Кешіріңіз, мен түсінбеймін.
Dialogue: 0,0:09:30.15,0:09:30.98,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:09:33.11,0:09:33.94,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:34.57,0:09:37.11,Default,,0,0,0,,Джайна фестивалі
Dialogue: 0,0:09:38.66,0:09:41.83,Default,,0,0,0,,Уф уф...
Dialogue: 0,0:09:42.70,0:09:43.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:44.20,0:09:46.08,Default,,0,0,0,,Жарайды, мен мұны істеймін.
Dialogue: 0,0:09:49.54,0:09:50.38,Default,,0,0,0,,Хакш!
Dialogue: 0,0:09:50.54,0:09:52.05,Default,,0,0,0,,Куш! Хакши!
Dialogue: 0,0:09:52.21,0:09:54.09,Default,,0,0,0,,Бұл не? Exc!
Dialogue: 0,0:09:54.17,0:09:55.38,Default,,0,0,0,,Түшкіру! Укши!
Dialogue: 0,0:09:55.47,0:09:56.84,Default,,0,0,0,,Тоқтатпа...Екш!
Dialogue: 0,0:09:56.97,0:09:58.09,Default,,0,0,0,,Ха-буши!
Dialogue: 0,0:09:58.22,0:09:59.80,Default,,0,0,0,,Ха-буши!
Dialogue: 0,0:10:00.10,0:10:01.81,Default,,0,0,0,,Оның бұтасы!
Dialogue: 0,0:10:03.81,0:10:04.68,Default,,0,0,0,,(Демін ала-шала)
Dialogue: 0,0:10:05.60,0:10:06.56,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:10:06.64,0:10:11.40,Default,,0,0,0,,(Барлығы түшкіреді)
Dialogue: 0,0:10:11.48,0:10:14.53,Default,,0,0,0,,Тәк ахахахахаха
Dialogue: 0,0:10:14.65,0:10:16.99,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:10:17.07,0:10:18.53,Default,,0,0,0,,Біз сізге хабарлаймыз
Dialogue: 0,0:10:19.16,0:10:21.37,Default,,0,0,0,,Мен Англияға ұшатын ұшатын болдым.
Dialogue: 0,0:10:21.37,0:10:22.20,Default,,0,0,0,,Мен Англияға ұшатын ұшатын болдым.
Dialogue: 0,0:10:21.37,0:10:22.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:22.20,0:10:22.58,Default,,0,0,0,,Мен Англияға ұшатын рейспен ұшпақшы болдым.
Dialogue: 0,0:10:22.74,0:10:25.12,Default,,0,0,0,,Ұшу жолағына біреу басып кіргендіктен...
Dialogue: 0,0:10:25.12,0:10:25.45,Default,,0,0,0,,Ұшу жолағына біреу басып кіргендіктен...
Dialogue: 0,0:10:25.12,0:10:25.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:25.45,0:10:25.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:25.54,0:10:26.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:25.54,0:10:26.16,Default,,0,0,0,,Көлік жүргізу уақытша тоқтатылды.
Dialogue: 0,0:10:26.16,0:10:28.17,Default,,0,0,0,,Көлік жүргізу уақытша тоқтатылды.
Dialogue: 0,0:10:34.09,0:10:35.38,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:35.88,0:10:37.59,Default,,0,0,0,,Мен оны Вако-саннан естідім.
Dialogue: 0,0:10:37.67,0:10:38.51,Default,,0,0,0,,Иә
Dialogue: 0,0:10:38.59,0:10:40.51,Default,,0,0,0,,Мен оны аңду деп ойладым.
Dialogue: 0,0:10:41.43,0:10:44.35,Default,,0,0,0,,Рахмет, Вако мырза мен Рико мырза...
Dialogue: 0,0:10:44.93,0:10:46.56,Default,,0,0,0,,Иә? Жоқ...
Dialogue: 0,0:10:47.39,0:10:49.35,Default,,0,0,0,,Риота-нии-чан!
Dialogue: 0,0:11:07.08,0:11:08.08,Default,,0,0,0,,Ахаха
Dialogue: 0,0:11:55.34,0:11:56.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:56.29,0:11:57.17,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:11:57.55,0:11:58.76,Default,,0,0,0,,Батыс тағамы макаби?
Dialogue: 0,0:11:58.96,0:12:00.51,Default,,0,0,0,,Бір жұлдызды дүкен?
Dialogue: 0,0:12:00.72,0:12:02.13,Default,,0,0,0,,Таңдалған?
Dialogue: 0,0:12:02.22,0:12:03.97,Default,,0,0,0,,Қандай да бір қате бар ма?
Dialogue: 0,0:12:04.26,0:12:05.76,Default,,0,0,0,,Қалай болғанда да!
Dialogue: 0,0:12:06.51,0:12:08.39,Default,,0,0,0,,Тыңдаймыз!
Dialogue: 0,0:12:08.97,0:12:09.93,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:12:11.06,0:12:12.64,Default,,0,0,0,,Хаха!
Dialogue: 0,0:12:12.94,0:12:16.65,Default,,0,0,0,,Тара Адачи! Арнайы сусын дайындаңыз
Dialogue: 0,0:12:17.02,0:12:17.86,Default,,0,0,0,,Мен көптен күттім!
Dialogue: 0,0:12:18.19,0:12:21.03,Default,,0,0,0,,Тачиваку Жаңа шыбықтар сатып алуым керек пе?
Dialogue: 0,0:12:21.32,0:12:22.32,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:22.78,0:12:25.70,Default,,0,0,0,,Мацури Мен сіздің рейсіңізді кез келген уақытта төлеймін!
Dialogue: 0,0:12:25.95,0:12:26.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:27.70,0:12:30.62,Default,,0,0,0,,Бас редактор! Келесі оқиға шешілді!
Dialogue: 0,0:12:30.91,0:12:32.00,Default,,0,0,0,,Цурубиши!
Dialogue: 0,0:12:32.08,0:12:34.29,Default,,0,0,0,,Нагумоның сағаттық жалақысы үш есе
Dialogue: 0,0:12:34.37,0:12:35.21,Default,,0,0,0,,Мамонт!
Dialogue: 0,0:12:35.58,0:12:37.29,Default,,0,0,0,,Неге сонша?
Dialogue: 0,0:12:38.50,0:12:41.13,Default,,0,0,0,,Өйткені бұл бір жұлдызды дүкен!
Dialogue: 0,0:12:41.38,0:12:44.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:44.72,0:12:46.76,Default,,0,0,0,,Мен... Мен ше?
Dialogue: 0,0:12:48.64,0:12:49.51,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:51.02,0:12:52.52,Default,,0,0,0,,Ха... (Цурубиши) Ха...
Dialogue: 0,0:12:52.89,0:12:54.02,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:12:54.14,0:12:55.77,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:12:56.73,0:12:58.06,Default,,0,0,0,,Ойлан!
Dialogue: 0,0:12:58.15,0:12:59.52,Default,,0,0,0,,Бақытты!
Dialogue: 0,0:12:59.90,0:13:04.32,Default,,0,0,0,,Жарайды! Бұл орын алғанда, кешке дайындалу уақыты келді!
Dialogue: 0,0:13:06.45,0:13:08.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:09.37,0:13:10.87,Default,,0,0,0,,Бір жұлдыз! (Нагумо) Хехе
Dialogue: 0,0:13:11.50,0:13:12.66,Default,,0,0,0,,Бір жұлдыз!
Dialogue: 0,0:13:13.25,0:13:14.66,Default,,0,0,0,,Бір жұлдыз!
Dialogue: 0,0:13:14.92,0:13:16.96,Default,,0,0,0,,Ихихихихи (Нагумо) Бір жұлдыз!
Dialogue: 0,0:13:17.29,0:13:19.09,Default,,0,0,0,,Бір жұлдыз!
Dialogue: 0,0:13:19.50,0:13:21.21,Default,,0,0,0,,Бір жұлдыз~!
Dialogue: 0,0:13:21.67,0:13:23.51,Default,,0,0,0,,Бір жұлдыз!
Dialogue: 0,0:13:24.13,0:13:27.43,Default,,0,0,0,,Бір жұлдыз~!
Dialogue: 0,0:13:27.55,0:13:29.22,Default,,0,0,0,,♪～
Dialogue: 0,0:13:29.39,0:13:32.18,Default,,0,0,0,,Мен бүгін өзімді өте бақытты сезінемін.
Dialogue: 0,0:13:32.43,0:13:35.23,Default,,0,0,0,,Батыс тағамы Макаби рұқсат етілген.
Dialogue: 0,0:13:35.35,0:13:38.94,Default,,0,0,0,,Мен бір жұлдыз алдым.
Dialogue: 0,0:13:39.06,0:13:42.28,Default,,0,0,0,,Үлкен өркендеуге кепілдік беріледі
Dialogue: 0,0:13:42.40,0:13:45.57,Default,,0,0,0,,Барлығын бақыт күтіп тұр!
Dialogue: 0,0:13:46.82,0:13:47.86,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:47.95,0:13:49.99,Default,,0,0,0,,Егер мен доктор Тара Адачидің тыңдау құрылғысын ұрып жатсам...
Dialogue: 0,0:13:50.20,0:13:52.45,Default,,0,0,0,,Той болып көрінді, мен келдім.
Dialogue: 0,0:13:52.87,0:13:54.96,Default,,0,0,0,,Неліктен Рико-чан?
Dialogue: 0,0:13:55.33,0:13:59.00,Default,,0,0,0,,Осы батыстық макаби тағамы үшін~
Dialogue: 0,0:14:00.21,0:14:02.21,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:14:02.38,0:14:04.84,Default,,0,0,0,,Мен туралы
Dialogue: 0,0:14:04.97,0:14:10.76,Default,,0,0,0,,Өйткені, егер сіз бұл туралы ойласаңыз, бұл жалғыз нәрсе~
Dialogue: 0,0:14:11.01,0:14:15.27,Default,,0,0,0,,Менің ойыма келе алмаймын.
Dialogue: 0,0:14:15.64,0:14:18.06,Default,,0,0,0,,Бұл кеудеде ол жоғалып кетпейді
Dialogue: 0,0:14:18.19,0:14:20.48,Default,,0,0,0,,Мен оны одан алдым.
Dialogue: 0,0:14:20.56,0:14:25.99,Default,,0,0,0,,Енді алауды қайтарайық.
Dialogue: 0,0:14:28.99,0:14:30.16,Default,,0,0,0,,Менімен бірге келіңізші
Dialogue: 0,0:14:30.28,0:14:31.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:31.28,0:14:32.33,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:14:33.03,0:14:34.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:34.66,0:14:36.16,Default,,0,0,0,,Ал, Тачиваку уайымдама
Dialogue: 0,0:14:36.25,0:14:37.62,Default,,0,0,0,,Көңіл көтер, ағайын!
Dialogue: 0,0:14:37.71,0:14:39.46,Default,,0,0,0,,Иә Осы аптаның сәтті элементі!
Dialogue: 0,0:14:40.08,0:14:41.50,Default,,0,0,0,,Неге бұл тағы!
Dialogue: 0,0:14:41.59,0:14:43.09,Default,,0,0,0,,Мен оны доппен соқтым.
Dialogue: 0,0:14:43.38,0:14:44.75,Default,,0,0,0,,Жоқ! Солай болды ма?
Dialogue: 0,0:14:44.84,0:14:45.80,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:14:45.88,0:14:46.92,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:47.05,0:14:49.22,Default,,0,0,0,,Балалар сендерге не болып жатыр!?
Dialogue: 0,0:14:49.34,0:14:50.68,Default,,0,0,0,,Міне, Тачиваку!
Dialogue: 0,0:14:51.39,0:14:53.89,Default,,0,0,0,,Энергияңызды күштеп сығыңыз! (Тачиваку) Ха
Dialogue: 0,0:14:54.26,0:14:57.81,Default,,0,0,0,,Солай етсең, көңілділік ар жақтан келеді!
Dialogue: 0,0:14:57.93,0:14:59.48,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:15:02.31,0:15:05.44,Default,,0,0,0,,Бәрібір билейік~
Dialogue: 0,0:15:05.90,0:15:09.03,Default,,0,0,0,,Егер бәріміз билесек~
Dialogue: 0,0:15:09.40,0:15:12.78,Default,,0,0,0,,Қоқыс тастағаннан кейін өзіңізді қай жерде сезінесіз?
Dialogue: 0,0:15:13.12,0:15:16.24,Default,,0,0,0,,Мен өзімді жақсы сезінемін~
Dialogue: 0,0:15:17.79,0:15:18.62,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:15:18.75,0:15:19.37,Default,,0,0,0,,Ах
Dialogue: 0,0:15:19.50,0:15:20.25,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:15:20.33,0:15:22.13,Default,,0,0,0,,Макабе, сен не істеп жатырсың?
Dialogue: 0,0:15:22.25,0:15:23.13,Default,,0,0,0,,Капитан!
Dialogue: 0,0:15:23.67,0:15:26.55,Default,,0,0,0,,Көптеген дәмді тағамдар!
Dialogue: 0,0:15:27.38,0:15:28.21,Default,,0,0,0,,Чивасу! Ах...
Dialogue: 0,0:15:28.30,0:15:29.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:29.47,0:15:31.13,Default,,0,0,0,,Мен мұны жеуге бола ма? Ухуху
Dialogue: 0,0:15:31.22,0:15:32.05,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:15:32.14,0:15:32.97,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:15:34.85,0:15:36.51,Default,,0,0,0,,Әке, қоймашы!
Dialogue: 0,0:15:37.10,0:15:38.14,Default,,0,0,0,,Ах... (Татешина Камуи) Ах...
Dialogue: 0,0:15:38.31,0:15:39.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:39.48,0:15:40.31,Default,,0,0,0,,Не?
Dialogue: 0,0:15:40.98,0:15:42.27,Default,,0,0,0,,Бұл Шиа Чан!
Dialogue: 0,0:15:42.48,0:15:43.90,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:15:44.44,0:15:46.57,Default,,0,0,0,,Міне, келдік!
Dialogue: 0,0:15:46.65,0:15:48.53,Default,,0,0,0,,Неліктен? Сіз сұхбатқа келдіңіз бе?
Dialogue: 0,0:15:48.69,0:15:49.69,Default,,0,0,0,,Шу бар ма?
Dialogue: 0,0:15:49.78,0:15:50.70,Default,,0,0,0,,Камера жоқ!
Dialogue: 0,0:15:50.78,0:15:51.86,Default,,0,0,0,,Бұл бір жерде болуы керек!
Dialogue: 0,0:15:51.95,0:15:53.70,Default,,0,0,0,,Бұл қауіпті! Мында кел!
Dialogue: 0,0:15:53.82,0:15:55.49,Default,,0,0,0,,Уау! (Барлығы) Не?
Dialogue: 0,0:15:55.66,0:15:56.49,Default,,0,0,0,,О
Dialogue: 0,0:15:56.66,0:15:57.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:57.66,0:15:58.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:58.87,0:15:59.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:59.87,0:16:01.00,Default,,0,0,0,,Пісіру...
Dialogue: 0,0:16:01.12,0:16:02.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:02.54,0:16:05.13,Default,,0,0,0,,Тамақ ішпесем де, арықтап жатырмын!
Dialogue: 0,0:16:05.63,0:16:07.55,Default,,0,0,0,,Мұнда тамақ жоқ
Dialogue: 0,0:16:07.63,0:16:08.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:08.84,0:16:09.67,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:16:09.76,0:16:10.67,Default,,0,0,0,,Ас әзірлеу де жоқ!
Dialogue: 0,0:16:10.80,0:16:11.76,Default,,0,0,0,,Не? Бар емес пе?
Dialogue: 0,0:16:12.26,0:16:14.01,Default,,0,0,0,,Тек табақ бар
Dialogue: 0,0:16:14.14,0:16:15.35,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:15.60,0:16:17.26,Default,,0,0,0,,Тек ауа бар
Dialogue: 0,0:16:17.47,0:16:18.60,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:18.77,0:16:19.60,Default,,0,0,0,,Бұл да!
Dialogue: 0,0:16:19.72,0:16:20.56,Default,,0,0,0,,Бұл да!
Dialogue: 0,0:16:20.98,0:16:22.44,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:22.56,0:16:25.52,Default,,0,0,0,,Аа, дұрыс, менде осындай нәрсе болуы мүмкін бе деп ойладым...
Dialogue: 0,0:16:25.65,0:16:27.36,Default,,0,0,0,,Мен тұзақ құрдым.
Dialogue: 0,0:16:27.44,0:16:30.36,Default,,0,0,0,,Жоқ, жоқ, жоқ, бұлай қақпанға кім түседі...
Dialogue: 0,0:16:30.36,0:16:30.69,Default,,0,0,0,,Жоқ, жоқ, жоқ, мұндай тұзаққа кім түседі...
Dialogue: 0,0:16:30.36,0:16:30.69,Default,,0,0,0,,Гюу
Dialogue: 0,0:16:30.69,0:16:31.74,Default,,0,0,0,,Гюу
Dialogue: 0,0:16:31.74,0:16:33.15,Default,,0,0,0,,Гюу
Dialogue: 0,0:16:31.74,0:16:33.15,Default,,0,0,0,,Ол кептеліп қалды!
Dialogue: 0,0:16:33.15,0:16:33.86,Default,,0,0,0,,Ол кептеліп қалды!
Dialogue: 0,0:16:34.53,0:16:37.33,Default,,0,0,0,,Менің қарным ашқаны сонша, тамақ ішпей қалдым.
Dialogue: 0,0:16:37.41,0:16:38.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:39.16,0:16:39.99,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:16:40.79,0:16:42.08,Default,,0,0,0,,Кешірім сұраймын
Dialogue: 0,0:16:42.87,0:16:43.71,Default,,0,0,0,,Мұның бәрі тек менің алаңдаған жүрегімді жылдамдатты
Dialogue: 0,0:16:44.04,0:16:44.87,Default,,0,0,0,,Икка
Dialogue: 0,0:16:45.21,0:16:46.29,Default,,0,0,0,,... (Цурубиши) Жарайды!
Dialogue: 0,0:16:46.38,0:16:48.29,Default,,0,0,0,,Егер бұл орын алса, барлығына көмектесіңіз!
Dialogue: 0,0:16:48.38,0:16:49.34,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:16:49.42,0:16:50.55,Default,,0,0,0,,Алдымен не істеуім керек?
Dialogue: 0,0:16:50.63,0:16:52.84,Default,,0,0,0,,Мен картопты тазалаймын
Dialogue: 0,0:16:53.22,0:16:55.64,Default,,0,0,0,,Мен қазір даши жасаймын.
Dialogue: 0,0:16:56.47,0:16:57.93,Default,,0,0,0,,Мен балық аулаймын.
Dialogue: 0,0:16:58.01,0:17:00.43,Default,,0,0,0,,Сіз сирек кездесетін балықты ғана ұстай аласыз, солай ма?
Dialogue: 0,0:17:00.68,0:17:01.60,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:17:01.68,0:17:04.39,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:17:06.40,0:17:08.11,Default,,0,0,0,,Ха! Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:17:08.77,0:17:12.03,Default,,0,0,0,,Мұны анаңызға электрондық пошта арқылы жіберіңіз.
Dialogue: 0,0:17:15.24,0:17:16.66,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:17:18.62,0:17:20.12,Default,,0,0,0,,Сәтті деген не?
Dialogue: 0,0:17:21.70,0:17:23.20,Default,,0,0,0,,Тікелей
Dialogue: 0,0:17:23.33,0:17:26.42,Default,,0,0,0,,Содан кейін түймені басыңыз
Dialogue: 0,0:17:27.13,0:17:29.42,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:17:31.13,0:17:33.67,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:17:35.93,0:17:37.14,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:17:37.22,0:17:41.35,Default,,0,0,0,,Шықпайды, шықпайды~
Dialogue: 0,0:17:41.60,0:17:48.61,Default,,0,0,0,,Мен телефонға мүлдем жауап бермеймін.
Dialogue: 0,0:17:49.02,0:17:54.15,Default,,0,0,0,,Мен бұл ұзақ күткеніне сене алар емеспін
Dialogue: 0,0:17:54.44,0:17:59.32,Default,,0,0,0,,Мен өзімді жынданып бара жатқандай сезінемін~
Dialogue: 0,0:17:59.45,0:18:01.45,Default,,0,0,0,,Сізде пошта бар!
Dialogue: 0,0:18:01.79,0:18:02.66,Default,,0,0,0,,Барлығына! (Барлығы) иә?
Dialogue: 0,0:18:02.74,0:18:05.33,Default,,0,0,0,,Анам жаңа нәсіл тапты!
Dialogue: 0,0:18:05.79,0:18:05.96,Default,,0,0,0,,Не? маған көрсет!
Dialogue: 0,0:18:05.96,0:18:07.12,Default,,0,0,0,,Не? маған көрсет!
Dialogue: 0,0:18:05.96,0:18:07.12,Default,,0,0,0,,Не?
Dialogue: 0,0:18:07.33,0:18:08.17,Default,,0,0,0,,О
Dialogue: 0,0:18:08.29,0:18:09.58,Default,,0,0,0,,Бұл не? (никкура) Бұл не?
Dialogue: 0,0:18:09.67,0:18:10.50,Default,,0,0,0,,Бұл не? (Татеваку) Бұл не?
Dialogue: 0,0:18:10.59,0:18:11.34,Default,,0,0,0,,Не?
Dialogue: 0,0:18:11.42,0:18:13.13,Default,,0,0,0,,Бұл қандай жарыс?
Dialogue: 0,0:18:13.25,0:18:14.13,Default,,0,0,0,,Не айт?
Dialogue: 0,0:18:14.55,0:18:16.26,Default,,0,0,0,,Адам емес
Dialogue: 0,0:18:16.34,0:18:17.18,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:18:17.26,0:18:19.14,Default,,0,0,0,,Толық адам емес
Dialogue: 0,0:18:19.68,0:18:20.72,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:18:20.97,0:18:22.56,Default,,0,0,0,,Бұл жануар ма, әлде құбыжық па?
Dialogue: 0,0:18:22.64,0:18:24.18,Default,,0,0,0,,Мен білмеймін~
Dialogue: 0,0:18:24.35,0:18:26.85,Default,,0,0,0,,Жұмбақ және жұмбақ тіршілік формасы
Dialogue: 0,0:18:26.94,0:18:30.40,Default,,0,0,0,,Жұмбақ~
Dialogue: 0,0:18:38.07,0:18:44.79,Default,,0,0,0,,Саясат туралы әңгіме басталды~
Dialogue: 0,0:18:45.79,0:18:49.42,Default,,0,0,0,,Келесі ҚАЛА жалпы сайлауы
Dialogue: 0,0:18:49.67,0:18:53.34,Default,,0,0,0,,Ауа салқындай бастады~
Dialogue: 0,0:18:53.63,0:18:57.01,Default,,0,0,0,,Үміт нұры өшіп барады~
Dialogue: 0,0:19:01.18,0:19:04.97,Default,,0,0,0,,Кеш біткені өкінішті~
Dialogue: 0,0:19:05.06,0:19:11.27,Default,,0,0,0,,Біреу кешті жарықтандырды~
Dialogue: 0,0:19:13.57,0:19:15.98,Default,,0,0,0,,Айтпақшы, жұлдыздар дегеніміз не?
Dialogue: 0,0:19:16.53,0:19:19.57,Default,,0,0,0,,Тыңдағандарыңызға көп рахмет~
Dialogue: 0,0:19:19.65,0:19:22.45,Default,,0,0,0,,Әдепті конвертте
Dialogue: 0,0:19:22.70,0:19:25.33,Default,,0,0,0,,Бір жұлдыз кіреді
Dialogue: 0,0:19:25.70,0:19:26.70,Default,,0,0,0,,Хикае! Хикае! Жасырайық!
Dialogue: 0,0:19:26.70,0:19:28.75,Default,,0,0,0,,Хикае! Хикае! Жасырайық!
Dialogue: 0,0:19:26.70,0:19:28.75,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:19:29.29,0:19:30.75,Default,,0,0,0,,Мына қымбат қағазбен...
Dialogue: 0,0:19:30.92,0:19:33.21,Default,,0,0,0,,Бір жұлдыз...
Dialogue: 0,0:19:33.50,0:19:35.25,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:19:35.34,0:19:38.34,Default,,0,0,0,,Бірақ жұлдыздарға келетін болсақ, бұл ғана ма?
Dialogue: 0,0:19:38.72,0:19:40.47,Default,,0,0,0,,Атақты гурман гид
Dialogue: 0,0:19:40.84,0:19:41.68,Default,,0,0,0,,Ми...
Dialogue: 0,0:19:41.76,0:19:44.01,Default,,0,0,0,,Мими ми ми...!
Dialogue: 0,0:19:44.14,0:19:45.01,Default,,0,0,0,,Мишра…
Dialogue: 0,0:19:45.35,0:19:47.27,Default,,0,0,0,,Керемет! Дәлел бар ма?
Dialogue: 0,0:19:47.47,0:19:50.14,Default,,0,0,0,,Бұл дәлел!
Dialogue: 0,0:19:52.15,0:19:54.98,Default,,0,0,0,,Сіздің атыңыз осында жазылған~
Dialogue: 0,0:19:55.23,0:19:58.15,Default,,0,0,0,,Байланыс ақпараты да жазылған.
Dialogue: 0,0:19:58.32,0:20:01.07,Default,,0,0,0,,Телефон нөмірі де жазылған.
Dialogue: 0,0:20:01.40,0:20:04.41,Default,,0,0,0,,Бұл дәлел, сөзсіз.
Dialogue: 0,0:20:04.53,0:20:07.41,Default,,0,0,0,,Бұл не? Сіз нөлдік дәлелмен көңіл көтересіз!
Dialogue: 0,0:20:07.49,0:20:09.33,Default,,0,0,0,,Англияға ұшу жоғалып кетті
Dialogue: 0,0:20:09.58,0:20:10.87,Default,,0,0,0,,Жақсы, жақсы.
Dialogue: 0,0:20:10.96,0:20:11.79,Default,,0,0,0,,Менеджер!
Dialogue: 0,0:20:11.92,0:20:14.25,Default,,0,0,0,,Хмм, телефон арқылы растаймын.
Dialogue: 0,0:20:15.46,0:20:18.38,Default,,0,0,0,,Пипопапаның Пипопапопи
Dialogue: 0,0:20:18.50,0:20:21.55,Default,,0,0,0,,Пурупуру Пурупуруны күту~
Dialogue: 0,0:20:22.26,0:20:22.88,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:20:23.01,0:20:29.56,Default,,0,0,0,,Офицердің денесінен шырылдап жатыр~
Dialogue: 0,0:20:30.64,0:20:32.60,Default,,0,0,0,,Ба Ба Ба ақымақ!
Dialogue: 0,0:20:32.73,0:20:35.27,Default,,0,0,0,,Бір минут күте тұрыңыз, мүмкін, мүмкін...
Dialogue: 0,0:20:35.52,0:20:38.48,Default,,0,0,0,,Уақытша жұмыс Бас офицер
Dialogue: 0,0:20:38.57,0:20:41.78,Default,,0,0,0,,Судья шын мәнінде талғампаз адам
Dialogue: 0,0:20:43.70,0:20:45.99,Default,,0,0,0,,Бұл мүлдем басқа.
Dialogue: 0,0:20:46.24,0:20:49.12,Default,,0,0,0,,Мен жеген тағам дәмді болатын мейрамхана.
Dialogue: 0,0:20:49.54,0:20:52.08,Default,,0,0,0,,Шенеунік рұқсатсыз беріп жатыр.
Dialogue: 0,0:20:52.25,0:20:56.21,Default,,0,0,0,,Бұл офицердің кеудесіндегі жұлдыз.
Dialogue: 0,0:20:57.09,0:21:00.00,Default,,0,0,0,,Қараңызшы, мен ештеңе айтып тұрған жоқпын.
Dialogue: 0,0:21:00.09,0:21:06.39,Default,,0,0,0,,Керемет жаман және соңы~
Dialogue: 0,0:21:06.84,0:21:09.22,Default,,0,0,0,,Жоқ, күте тұрыңыз! Мүмкін емес!
Dialogue: 0,0:21:09.35,0:21:11.31,Default,,0,0,0,,А... берілме!
Dialogue: 0,0:21:11.39,0:21:13.31,Default,,0,0,0,,Бұл жұлдыз шынайы
Dialogue: 0,0:21:13.43,0:21:15.69,Default,,0,0,0,,Өйткені... Өйткені...
Dialogue: 0,0:21:16.23,0:21:17.11,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:21:17.36,0:21:20.11,Default,,0,0,0,,Факті: Тағам дәмді~
Dialogue: 0,0:21:20.40,0:21:23.53,Default,,0,0,0,,Оны жегеннің бәрі той.
Dialogue: 0,0:21:24.99,0:21:30.87,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ!
Dialogue: 0,0:21:31.41,0:21:37.46,Default,,0,0,0,,Мен не істесем де, бұл жақсы емес~
Dialogue: 0,0:21:38.79,0:21:40.55,Default,,0,0,0,,(Телефон қоңырауының дыбысы)
Dialogue: 0,0:21:40.63,0:21:41.80,Default,,0,0,0,,Батыс тағамы макаби
Dialogue: 0,0:21:42.01,0:21:43.80,Default,,0,0,0,,Екі кәдімгі қуырылған күріш
Dialogue: 0,0:21:43.88,0:21:45.09,Default,,0,0,0,,Батыс тағамы макаби
Dialogue: 0,0:21:45.34,0:21:47.14,Default,,0,0,0,,Сиыр етінен жасалған строганов және салат
Dialogue: 0,0:21:47.51,0:21:48.72,Default,,0,0,0,,Бір қосымша сыра...
Dialogue: 0,0:21:48.80,0:21:49.85,Default,,0,0,0,,Екі қатты қуырылған кеспе
Dialogue: 0,0:21:49.97,0:21:51.31,Default,,0,0,0,,Иә! Бұл батыстық маккабе тағамы!
Dialogue: 0,0:21:51.43,0:21:52.52,Default,,0,0,0,,Палау 60 порция
Dialogue: 0,0:21:52.85,0:21:53.89,Default,,0,0,0,,Менчи (Сува) крокет
Dialogue: 0,0:21:54.10,0:21:55.35,Default,,0,0,0,,Лазанья Дория (Наруко) Ах!
Dialogue: 0,0:21:55.60,0:21:57.27,Default,,0,0,0,,Иә! Бұл батыстық маккабе тағамы!
Dialogue: 0,0:21:57.52,0:21:59.81,Default,,0,0,0,,Аздап ащы карри күріш...
Dialogue: 0,0:21:59.94,0:22:02.19,Default,,0,0,0,,Жеткізу қаншалықты алыс болуы мүмкін?
Dialogue: 0,0:22:03.65,0:22:06.03,Default,,0,0,0,,(Ұшақ дыбысы)
Dialogue: 0,0:22:06.15,0:22:08.36,Default,,0,0,0,,Жеткізу тапсырыстары бірінен соң бірі түсіп жатыр.
Dialogue: 0,0:22:08.45,0:22:10.12,Default,,0,0,0,,Барлығы 650 элемент!
Dialogue: 0,0:22:10.41,0:22:11.37,Default,,0,0,0,,Бұл тым көп!
Dialogue: 0,0:22:12.12,0:22:15.79,Default,,0,0,0,,Егер бұлай болса, мен көмектесе алмаймын.
Dialogue: 0,0:22:15.87,0:22:19.67,Default,,0,0,0,,Осыншама көп адам болса...
Dialogue: 0,0:22:19.75,0:22:23.05,Default,,0,0,0,,Сіз жасай алмайтын ештеңе жоқ~
Dialogue: 0,0:22:23.30,0:22:27.01,Default,,0,0,0,,Үлкен қимылдарды көрсетейік~
Dialogue: 0,0:22:27.34,0:22:30.93,Default,,0,0,0,,Қуыруға арналған табаны жағыңыз~
Dialogue: 0,0:22:32.14,0:22:34.22,Default,,0,0,0,,Жұмыртқаны секундтарда сындырып, араластырыңыз!
Dialogue: 0,0:22:34.85,0:22:38.64,Default,,0,0,0,,Қуырылған тағам майға батып кетсін~
Dialogue: 0,0:22:38.77,0:22:42.77,Default,,0,0,0,,Сонда да қара телефон шырылдап тұрады.
Dialogue: 0,0:22:43.15,0:22:44.48,Default,,0,0,0,,(Телефон қоңырауының дыбысы)
Dialogue: 0,0:22:44.69,0:22:48.03,Default,,0,0,0,,Неліктен ол соншалықты объективті?
Dialogue: 0,0:22:48.49,0:22:51.95,Default,,0,0,0,,Күні кешеге дейін мен тыныш құс болдым~
Dialogue: 0,0:22:52.37,0:22:55.70,Default,,0,0,0,,Қалай болғанда да, қазір телефон желісін ажыратыңыз~
Dialogue: 0,0:22:56.16,0:22:59.25,Default,,0,0,0,,Жеткізуге көңіл бөліңіз!
Dialogue: 0,0:22:59.37,0:23:00.00,Default,,0,0,0,,Га
Dialogue: 0,0:23:00.96,0:23:03.09,Default,,0,0,0,,Тачивакудан басқаның бәрі кетуі керек...
Dialogue: 0,0:23:03.17,0:23:05.00,Default,,0,0,0,,Жеткізу құралдары кесіледі!
Dialogue: 0,0:23:07.26,0:23:11.26,Default,,0,0,0,,Егер сізде бұл болса, жеткізуді алғанға дейін оралуға болады.
Dialogue: 0,0:23:11.64,0:23:15.06,Default,,0,0,0,,Оның аты Time Machine!
Dialogue: 0,0:23:15.22,0:23:16.06,Default,,0,0,0,,Не!
Dialogue: 0,0:23:16.18,0:23:17.39,Default,,0,0,0,,Уақыт машинасы?
Dialogue: 0,0:23:17.52,0:23:18.35,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:23:18.48,0:23:20.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:20.90,0:23:22.44,Default,,0,0,0,,Егер сізде бұл бар болса, тастап кетпей тұрып қайтуға болады!
Dialogue: 0,0:23:22.86,0:23:24.61,Default,,0,0,0,,Ат жарысы билетін жоғалтып алсаңыз да жеңілмейді!
Dialogue: 0,0:23:24.73,0:23:26.36,Default,,0,0,0,,Сол күндерге оралып, басынан бастауға болады!
Dialogue: 0,0:23:26.48,0:23:27.74,Default,,0,0,0,,Көңілді көрінеді~
Dialogue: 0,0:23:30.74,0:23:33.91,Default,,0,0,0,,Анау-мынау, бәрі.
Dialogue: 0,0:23:34.08,0:23:37.41,Default,,0,0,0,,Осы және бәрі.
Dialogue: 0,0:23:37.62,0:23:40.83,Default,,0,0,0,,Бұл болса, бәрі жеңілмейді
Dialogue: 0,0:23:40.92,0:23:44.17,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:23:44.29,0:23:47.30,Default,,0,0,0,,Енді шытырман оқиғаның уақыты келді
Dialogue: 0,0:23:47.42,0:23:51.22,Default,,0,0,0,,Дүкен менеджері алған бір жұлдыз болды
Dialogue: 0,0:23:51.30,0:23:54.47,Default,,0,0,0,,Бұл Мишу сияқты емес...
Dialogue: 0,0:23:54.97,0:23:58.10,Default,,0,0,0,,Егер бұл орын алса, оған көмектесу мүмкін емес.
Dialogue: 0,0:23:58.35,0:24:01.31,Default,,0,0,0,,Егер бұлай болса, мұны істеуден басқа амалымыз жоқ!
Dialogue: 0,0:24:01.60,0:24:04.77,Default,,0,0,0,,Бұл да, бұл да, бәрі.
Dialogue: 0,0:24:04.94,0:24:08.03,Default,,0,0,0,,Осы және бәрі.
