Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.46,0:00:06.29,Default,,0,0,0,,(Тікұшақтың дыбысы)
Dialogue: 0,0:00:06.88,0:00:08.55,Default,,0,0,0,,Қазір ол басталды
Dialogue: 0,0:00:08.67,0:00:10.46,Default,,0,0,0,,CITY жарысы төрт жылда бір рет
Dialogue: 0,0:00:10.55,0:00:12.72,Default,,0,0,0,,Интеллект Физикалық күш Уақыт сәті
Dialogue: 0,0:00:13.01,0:00:15.55,Default,,0,0,0,,Оны өз жағында барлығы барлар ғана ала алады.
Dialogue: 0,0:00:15.72,0:00:17.89,Default,,0,0,0,,Жеңімпаз жүлдесі: 1 миллион иен
Dialogue: 0,0:00:18.56,0:00:22.18,Default,,0,0,0,,Енді даңқты кім алады?
Dialogue: 0,0:00:22.69,0:00:24.27,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:00:31.57,0:00:35.07,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:35.57,0:00:36.70,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:00:37.12,0:00:38.45,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:00:38.53,0:00:41.12,Default,,0,0,0,,Хахаха
Dialogue: 0,0:00:42.58,0:00:45.00,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:00:45.08,0:00:46.58,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:00:47.42,0:00:49.17,Default,,0,0,0,,♪～
Dialogue: 0,0:00:49.30,0:00:52.30,Default,,0,0,0,,Сәлеметсіздер ме, қымбатты достарым
Dialogue: 0,0:00:52.59,0:00:55.18,Default,,0,0,0,,Маған армандарың туралы айтып бер
Dialogue: 0,0:00:55.34,0:01:00.26,Default,,0,0,0,,Сол күндер есіңізде ме?
Dialogue: 0,0:01:01.64,0:01:07.56,Default,,0,0,0,,Ересек болу қиын, солай емес пе?
Dialogue: 0,0:01:07.69,0:01:14.32,Default,,0,0,0,,Жасырылған нәрсені тауып алайық.
Dialogue: 0,0:01:15.70,0:01:16.70,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:01:25.41,0:01:31.38,Default,,0,0,0,,Өзіңіздің беймаза ойыңызды тастаңыз
Dialogue: 0,0:01:31.55,0:01:34.38,Default,,0,0,0,,Бұлттар жүзіп келеді
Dialogue: 0,0:01:34.51,0:01:38.43,Default,,0,0,0,,Жоғары қарап, секір!
Dialogue: 0,0:01:39.39,0:01:42.26,Default,,0,0,0,,Жаңбыр тоқтады
Dialogue: 0,0:01:42.47,0:01:45.43,Default,,0,0,0,,Ән айту
Dialogue: 0,0:01:45.64,0:01:49.02,Default,,0,0,0,,Қол ұстасу
Dialogue: 0,0:01:51.82,0:01:54.74,Default,,0,0,0,,Мен күлдім
Dialogue: 0,0:01:54.86,0:01:57.91,Default,,0,0,0,,Сен де күлесің
Dialogue: 0,0:01:58.03,0:02:01.28,Default,,0,0,0,,Әрине ұнайды
Dialogue: 0,0:02:01.41,0:02:07.25,Default,,0,0,0,,Тағы кездесейік
Dialogue: 0,0:02:13.80,0:02:16.17,Default,,0,0,0,,～♪
Dialogue: 0,0:02:17.72,0:02:18.97,Default,,0,0,0,,Ережелер қарапайым
Dialogue: 0,0:02:19.18,0:02:22.18,Default,,0,0,0,,Әр бақылау пунктінен екі адамнан жұп болып өту.
Dialogue: 0,0:02:22.26,0:02:24.77,Default,,0,0,0,,Бірінші аяқтаған жеңімпаз
Dialogue: 0,0:02:25.14,0:02:28.77,Default,,0,0,0,,Алайда! Сіз жұп болмасаңыз, бақылау пунктінен өте алмайсыз.
Dialogue: 0,0:02:28.85,0:02:30.90,Default,,0,0,0,,Әр жұп бірге жүгіріңіз.
Dialogue: 0,0:02:31.56,0:02:34.90,Default,,0,0,0,,Сонымен қатар, биылғы CITY жарысының тағы бір маңызды сәті
Dialogue: 0,0:02:34.98,0:02:39.03,Default,,0,0,0,,Бірінші орынды болжау арқылы 10 миллион иендік жүлдені бөлуге болады.
Dialogue: 0,0:02:39.20,0:02:41.03,Default,,0,0,0,,Аудиторияның қатысу түрі
Dialogue: 0,0:02:41.41,0:02:42.49,Default,,0,0,0,,Бекіту жоқ
Dialogue: 0,0:02:42.91,0:02:45.49,Default,,0,0,0,,Мен оны алмасам не істеуім керек?
Dialogue: 0,0:02:45.62,0:02:50.04,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:02:50.71,0:02:53.59,Default,,0,0,0,,Енді жарысқа қайта оралайық.
Dialogue: 0,0:02:54.25,0:02:55.55,Default,,0,0,0,,Қария
Dialogue: 0,0:02:54.25,0:02:55.55,Default,,0,0,0,,Қазіргі уақытта бірінші бөлімде
Dialogue: 0,0:02:55.55,0:02:55.63,Default,,0,0,0,,Қазіргі уақытта 1-ші бөлімде
Dialogue: 0,0:02:55.63,0:02:56.59,Default,,0,0,0,,Қазіргі уақытта 1-ші бөлімде
Dialogue: 0,0:02:55.63,0:02:56.59,Default,,0,0,0,,Джон Джоан!
Dialogue: 0,0:02:56.59,0:02:56.92,Default,,0,0,0,,Джон Джоан!
Dialogue: 0,0:02:56.92,0:02:57.38,Default,,0,0,0,,Джон Джоан!
Dialogue: 0,0:02:56.92,0:02:57.38,Default,,0,0,0,,Жарыс басынан-ақ көшбасшылық үшін кескілескен тартыс болды.
Dialogue: 0,0:02:57.38,0:02:57.46,Default,,0,0,0,,Жарыс басынан-ақ көшбасшылық үшін кескілескен тартыс болды.
Dialogue: 0,0:02:57.46,0:02:59.34,Default,,0,0,0,,Жарыс басынан-ақ көшбасшылық үшін кескілескен тартыс болды.
Dialogue: 0,0:02:57.46,0:02:59.34,Default,,0,0,0,,Tetetetetetete…
Dialogue: 0,0:02:59.43,0:03:01.76,Default,,0,0,0,,Бұл Мидори Нагумо мен Обаба болды...
Dialogue: 0,0:03:02.01,0:03:04.18,Default,,0,0,0,,Бұл жарысты тек жұппен аяқтауға болады.
Dialogue: 0,0:03:04.18,0:03:04.89,Default,,0,0,0,,Бұл жарысты тек жұппен аяқтауға болады.
Dialogue: 0,0:03:04.18,0:03:04.89,Default,,0,0,0,,Не?!
Dialogue: 0,0:03:04.89,0:03:05.18,Default,,0,0,0,,Не?!
Dialogue: 0,0:03:05.18,0:03:05.51,Default,,0,0,0,,Не?!
Dialogue: 0,0:03:05.18,0:03:05.51,Default,,0,0,0,,Мен саған түсіндірдім, бірақ сен тыңдамадың!
Dialogue: 0,0:03:05.51,0:03:06.18,Default,,0,0,0,,Мен саған түсіндірдім, бірақ сен тыңдамадың!
Dialogue: 0,0:03:06.18,0:03:07.22,Default,,0,0,0,,Мен саған түсіндірдім, бірақ сен тыңдамадың!
Dialogue: 0,0:03:06.18,0:03:07.22,Default,,0,0,0,,Хахаха
Dialogue: 0,0:03:07.22,0:03:07.47,Default,,0,0,0,,Хахаха
Dialogue: 0,0:03:07.89,0:03:10.90,Default,,0,0,0,,Екеуі шарасыздан жұпқа оралады.
Dialogue: 0,0:03:11.19,0:03:13.06,Default,,0,0,0,,Сен ақымақсың ба? Сен ақымақсың ба?
Dialogue: 0,0:03:13.27,0:03:14.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:15.86,0:03:17.23,Default,,0,0,0,,Хахаха
Dialogue: 0,0:03:19.11,0:03:21.45,Default,,0,0,0,,Бірінші бақылау бекетінен кім бірінші өтті?
Dialogue: 0,0:03:21.95,0:03:24.58,Default,,0,0,0,,Танабе және Тара Тацута Адачи жұбы.
Dialogue: 0,0:03:25.28,0:03:26.70,Default,,0,0,0,,Бұрынғы футболшыдан күткендей
Dialogue: 0,0:03:27.24,0:03:27.75,Default,,0,0,0,,Танабе миссті ақырын ұстаңыз.
Dialogue: 0,0:03:27.75,0:03:29.08,Default,,0,0,0,,Танабе миссті ақырын ұстаңыз.
Dialogue: 0,0:03:27.75,0:03:29.08,Default,,0,0,0,,Хэ-хэ
Dialogue: 0,0:03:29.08,0:03:29.20,Default,,0,0,0,,Танабе миссті ақырын ұстаңыз.
Dialogue: 0,0:03:29.20,0:03:29.46,Default,,0,0,0,,Танабе миссті ақырын ұстаңыз.
Dialogue: 0,0:03:29.20,0:03:29.46,Default,,0,0,0,,Ниини…
Dialogue: 0,0:03:29.46,0:03:29.54,Default,,0,0,0,,Ниини…
Dialogue: 0,0:03:29.54,0:03:30.41,Default,,0,0,0,,Ниини…
Dialogue: 0,0:03:29.54,0:03:30.41,Default,,0,0,0,,Бірінен соң бірі қойылатын сынақтарды оңай жеңіңіз.
Dialogue: 0,0:03:30.41,0:03:33.88,Default,,0,0,0,,Бірінен соң бірі дайындалатын сынақтарды оңай жеңу.
Dialogue: 0,0:03:34.00,0:03:34.29,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:03:34.29,0:03:36.21,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:03:34.29,0:03:36.21,Default,,0,0,0,,Бір нәрседен көріністі көргендей.
Dialogue: 0,0:03:36.21,0:03:37.71,Default,,0,0,0,,Бір нәрседен көріністі көргендей.
Dialogue: 0,0:03:38.71,0:03:40.38,Default,,0,0,0,,Сәлем! Бұл фол!
Dialogue: 0,0:03:40.47,0:03:42.09,Default,,0,0,0,,Танабе отбасының қызметшілері сізге көмектесуде!
Dialogue: 0,0:03:42.18,0:03:43.18,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:03:43.43,0:03:45.35,Default,,0,0,0,,Ату! Мен атылдым!
Dialogue: 0,0:03:45.85,0:03:47.43,Default,,0,0,0,,Ой! (Хотака) Иә?
Dialogue: 0,0:03:47.68,0:03:50.06,Default,,0,0,0,,Мұндағы таңғажайып оқиға...
Dialogue: 0,0:03:50.18,0:03:53.77,Default,,0,0,0,,2 орын Мистер X және Мицугаку жұбы
Dialogue: 0,0:03:50.18,0:03:53.77,Default,,0,0,0,,Фуфуфуфуфуфуфу…
Dialogue: 0,0:03:53.85,0:03:55.77,Default,,0,0,0,,Ой! Ах...
Dialogue: 0,0:03:56.19,0:03:57.61,Default,,0,0,0,,Менің денем жеңіл...
Dialogue: 0,0:03:58.36,0:04:00.99,Default,,0,0,0,,Бұл жүгірушінің биіктігі ме?
Dialogue: 0,0:04:01.95,0:04:04.37,Default,,0,0,0,,Құдай бізді қолдайды
Dialogue: 0,0:04:04.95,0:04:10.50,Default,,0,0,0,,Мен ақшалай сыйлықты алып, үлкенірек қорапта өнер көрсетемін!
Dialogue: 0,0:04:12.46,0:04:14.67,Default,,0,0,0,,На~ни~!
Dialogue: 0,0:04:17.00,0:04:18.63,Default,,0,0,0,,Grrgh...
Dialogue: 0,0:04:18.96,0:04:19.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:19.71,0:04:21.55,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:04:23.43,0:04:25.76,Default,,0,0,0,,Жүр! Барайық!
Dialogue: 0,0:04:26.18,0:04:27.01,Default,,0,0,0,,Уф
Dialogue: 0,0:04:27.18,0:04:29.56,Default,,0,0,0,,Кенеттен дисквалификация! (Мицугаку) Иә?
Dialogue: 0,0:04:32.73,0:04:34.31,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:04:35.02,0:04:36.56,Default,,0,0,0,,Жақсы, Никура!
Dialogue: 0,0:04:36.94,0:04:40.03,Default,,0,0,0,,Сіз ерекше ынталысыз! Міне солай!
Dialogue: 0,0:04:40.11,0:04:40.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:41.07,0:04:42.57,Default,,0,0,0,,Қалай...
Dialogue: 0,0:04:46.37,0:04:47.32,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:04:49.99,0:04:51.45,Default,,0,0,0,,Ух... мм
Dialogue: 0,0:04:53.16,0:04:56.33,Default,,0,0,0,,Хэгю... неге олай істедің...
Dialogue: 0,0:04:57.17,0:05:00.55,Default,,0,0,0,,Егер сіз оны қайтарғыңыз келсе, бір ғана шартыңыз бар.
Dialogue: 0,0:05:01.38,0:05:03.30,Default,,0,0,0,,Оны қайтару үшін...
Dialogue: 0,0:05:03.63,0:05:05.13,Default,,0,0,0,,Бізде жеңуден басқа амал жоқ!
Dialogue: 0,0:05:05.76,0:05:08.51,Default,,0,0,0,,Біз жеңеміз! Корра! (Нагумо) Эй!
Dialogue: 0,0:05:08.64,0:05:10.43,Default,,0,0,0,,Брун Брун!
Dialogue: 0,0:05:11.35,0:05:12.18,Default,,0,0,0,,Иә
Dialogue: 0,0:05:16.15,0:05:17.77,Default,,0,0,0,,Мыналардан картаны сал...
Dialogue: 0,0:05:18.19,0:05:20.61,Default,,0,0,0,,Парақта жазылған сұрақтардың жауабын жазыңыз.
Dialogue: 0,0:05:20.61,0:05:21.48,Default,,0,0,0,,Парақта жазылған сұрақтардың жауабын жазыңыз.
Dialogue: 0,0:05:20.61,0:05:21.48,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:05:22.28,0:05:24.28,Default,,0,0,0,,Екеуміз бірдей жауап алған кезде ғана
Dialogue: 0,0:05:24.36,0:05:25.74,Default,,0,0,0,,Дұрыс деп саналады
Dialogue: 0,0:05:25.86,0:05:29.99,Default,,0,0,0,,(сағаттың секунд тілінің дыбысы)
Dialogue: 0,0:05:30.33,0:05:31.99,Default,,0,0,0,,Хехе...
Dialogue: 0,0:05:35.54,0:05:36.50,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:05:36.83,0:05:37.75,Default,,0,0,0,,Жауап-
Dialogue: 0,0:05:38.46,0:05:39.29,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:39.71,0:05:40.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:41.17,0:05:42.00,Default,,0,0,0,,♬~
Dialogue: 0,0:05:45.26,0:05:47.13,Default,,0,0,0,,Мен жұмбақ ойнамаймын!
Dialogue: 0,0:05:47.26,0:05:48.09,Default,,0,0,0,,Цезарь Цеппели
Dialogue: 0,0:05:48.18,0:05:50.85,Default,,0,0,0,,Сіз бұл туралы жазып отырған жоқсыз!
Dialogue: 0,0:05:50.97,0:05:54.43,Default,,0,0,0,,Біз апалы жұпқа бәс тігеміз, бірақ...
Dialogue: 0,0:05:55.85,0:05:57.73,Default,,0,0,0,,Мүмкін бұл жақсы емес шығар
Dialogue: 0,0:06:00.86,0:06:01.98,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:02.07,0:06:03.15,Default,,0,0,0,,Ұлы күрес!
Dialogue: 0,0:06:03.23,0:06:06.07,Default,,0,0,0,,«Азайма ШОУ!» Екінші бақылау-өткізу пункті.
Dialogue: 0,0:06:06.40,0:06:09.70,Default,,0,0,0,,Жауапты бір кадрда тапқан Танабе мен Тацута жұбынан басқа.
Dialogue: 0,0:06:09.91,0:06:12.41,Default,,0,0,0,,Мен осында тұрып қалдым.
Dialogue: 0,0:06:12.49,0:06:13.70,Default,,0,0,0,,Сондықтан!
Dialogue: 0,0:06:13.79,0:06:15.75,Default,,0,0,0,,Неге суретпен жауап бересің, Оникама-сенсэй?
Dialogue: 0,0:06:15.83,0:06:18.00,Default,,0,0,0,,Бұл мен емес, Оникама-сенсэй!
Dialogue: 0,0:06:18.08,0:06:19.21,Default,,0,0,0,,Біз бәс тігудеміз!
Dialogue: 0,0:06:19.29,0:06:21.50,Default,,0,0,0,,Бізді ренжітпе!
Dialogue: 0,0:06:22.29,0:06:25.76,Default,,0,0,0,,Тығырыққа тірелген жүйріктерге бәс тіккен жанкүйерлер...
Dialogue: 0,0:06:26.05,0:06:28.09,Default,,0,0,0,,Айқаймен тозақтың суреті
Dialogue: 0,0:06:28.22,0:06:28.51,Default,,0,0,0,,(дұрыс жауап дыбысы)
Dialogue: 0,0:06:28.51,0:06:29.51,Default,,0,0,0,,(дұрыс жауап дыбысы)
Dialogue: 0,0:06:28.51,0:06:29.51,Default,,0,0,0,,Уау... (никкура) Уау...
Dialogue: 0,0:06:30.09,0:06:31.22,Default,,0,0,0,,О!
Dialogue: 0,0:06:32.60,0:06:33.56,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:06:33.97,0:06:34.68,Default,,0,0,0,,Эххе
Dialogue: 0,0:06:34.77,0:06:36.48,Default,,0,0,0,,Мацури және Экчан жұбы
Dialogue: 0,0:06:36.56,0:06:39.14,Default,,0,0,0,,Бірден 2 орынға көтерілді!
Dialogue: 0,0:06:39.23,0:06:40.98,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:06:42.69,0:06:45.65,Default,,0,0,0,,Бұл Эри Амакаши. Рақмет сізге.
Dialogue: 0,0:06:48.65,0:06:50.41,Default,,0,0,0,,Қайдан ауыстырдыңыз?
Dialogue: 0,0:06:50.49,0:06:52.03,Default,,0,0,0,,Сіз қандай музыканы тыңдайсыз?
Dialogue: 0,0:06:52.12,0:06:53.24,Default,,0,0,0,,Сіз аниме көресіз бе?
Dialogue: 0,0:06:54.03,0:06:57.33,Default,,0,0,0,,Иә, сұрағыңызға жауап беру үшін...
Dialogue: 0,0:06:57.70,0:06:59.79,Default,,0,0,0,,Міне
Dialogue: 0,0:07:00.75,0:07:04.21,Default,,0,0,0,,Мен осындай сұрақ туындауы мүмкін бе деп ойладым ...
Dialogue: 0,0:07:04.50,0:07:07.46,Default,,0,0,0,,Мен кеше түнде нұсқаулық жасадым.
Dialogue: 0,0:07:08.22,0:07:10.80,Default,,0,0,0,,Дегенмен, бұл шифрленген мәтін.
Dialogue: 0,0:07:11.14,0:07:13.18,Default,,0,0,0,,Шифрлау кезінде оқып шығыңыз
Dialogue: 0,0:07:13.72,0:07:15.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:13.72,0:07:15.39,Default,,0,0,0,,Менен басқаның бәрі ауысатын студент болса ше?
Dialogue: 0,0:07:15.39,0:07:16.18,Default,,0,0,0,,Менен басқасының бәрі ауысатын студент болса ше?
Dialogue: 0,0:07:16.27,0:07:20.19,Default,,0,0,0,,Егер мен қазіргі студент болсам, параметрлерді пайдаланып, мұны 10 минут бойы қолданар едім.
Dialogue: 0,0:07:20.69,0:07:24.73,Default,,0,0,0,,Сыныпқа кіре беріс әнге толқып кірсем ше...
Dialogue: 0,0:07:25.57,0:07:29.11,Default,,0,0,0,,Өшіргіштегі сөздер «таза ақтан тыс».
Dialogue: 0,0:07:29.19,0:07:30.32,Default,,0,0,0,,Иленген резеңке деген резеңке сөзі...
Dialogue: 0,0:07:30.32,0:07:31.16,Default,,0,0,0,,Иленген резеңке деген резеңке сөзі...
Dialogue: 0,0:07:30.32,0:07:31.16,Default,,0,0,0,,Ha
Dialogue: 0,0:07:31.86,0:07:33.49,Default,,0,0,0,,А, бүгінгі түскі ас қорабы
Dialogue: 0,0:07:35.03,0:07:35.87,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:38.37,0:07:39.20,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:41.46,0:07:43.42,Default,,0,0,0,,Бұл шөл даланың ортасында
Dialogue: 0,0:07:43.58,0:07:47.67,Default,,0,0,0,,Мен шығынға батқанда маған ұсынылған соңғы ас.
Dialogue: 0,0:07:48.01,0:07:48.84,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:07:49.88,0:07:52.05,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:07:52.13,0:07:53.30,Default,,0,0,0,,Бұл жігіт, солай ма?
Dialogue: 0,0:07:53.39,0:07:55.97,Default,,0,0,0,,Жоқ, менің толық емес жұмысымдағы аға
Dialogue: 0,0:07:56.05,0:07:58.56,Default,,0,0,0,,Эй Мацури, тыңдап тұрсың ба?
Dialogue: 0,0:07:59.06,0:07:59.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:01.23,0:08:05.27,Default,,0,0,0,,Бір қызық болса, біреуі қызық емес болса ше?
Dialogue: 0,0:08:05.61,0:08:06.69,Default,,0,0,0,,Сіз қайсысын таңдар едіңіз?
Dialogue: 0,0:08:07.27,0:08:09.90,Default,,0,0,0,,Бұл қызық болар, солай ма?
Dialogue: 0,0:08:09.99,0:08:11.11,Default,,0,0,0,,Өте көзге түседі.
Dialogue: 0,0:08:11.20,0:08:12.03,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:08:12.95,0:08:14.99,Default,,0,0,0,,…мойынының артына дәл осы пішіндегі дақ шыққан.
Dialogue: 0,0:08:15.53,0:08:16.87,Default,,0,0,0,,Бұл қай мереке?
Dialogue: 0,0:08:16.95,0:08:18.87,Default,,0,0,0,,Күлмеңіз және айтыңыз
Dialogue: 0,0:08:19.37,0:08:20.83,Default,,0,0,0,,Аа, мен де...
Dialogue: 0,0:08:20.91,0:08:21.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:22.79,0:08:24.63,Default,,0,0,0,,100% қызықты
Dialogue: 0,0:08:25.04,0:08:25.88,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:26.50,0:08:27.34,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:27.75,0:08:29.13,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:29.46,0:08:32.09,Default,,0,0,0,,Енді көп ұзамай орта мектептің бір жұбы болады.
Dialogue: 0,0:08:32.17,0:08:34.80,Default,,0,0,0,,Неге екені белгісіз, қалтамда ұстадым...
Dialogue: 0,0:08:34.89,0:08:36.72,Default,,0,0,0,,Үшінші бақылау пунктіне кіреміз.
Dialogue: 0,0:08:36.72,0:08:37.89,Default,,0,0,0,,Үшінші бақылау пунктіне кіреміз.
Dialogue: 0,0:08:36.72,0:08:37.89,Default,,0,0,0,,Дұрыс орындаңыз!
Dialogue: 0,0:08:38.39,0:08:39.22,Default,,0,0,0,,По
Dialogue: 0,0:08:41.31,0:08:42.68,Default,,0,0,0,,По Крукку
Dialogue: 0,0:08:43.31,0:08:44.69,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:08:49.57,0:08:51.11,Default,,0,0,0,,Жас ханым (Коми Танабе Сумире) Эй!
Dialogue: 0,0:08:51.86,0:08:56.11,Default,,0,0,0,,Сіз менімен алдын ала кеңескен биылғы CITY жарысына қатысты...
Dialogue: 0,0:08:56.20,0:08:57.12,Default,,0,0,0,,А... иә
Dialogue: 0,0:08:57.41,0:08:58.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.41,0:09:05.87,Default,,0,0,0,,Сұрағандай, біз Тацута Адачимен жұптастық ұйымдастырдық.
Dialogue: 0,0:09:06.75,0:09:09.80,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:09:11.09,0:09:11.92,Default,,0,0,0,,Ыстық
Dialogue: 0,0:09:12.05,0:09:13.42,Default,,0,0,0,,Жақсы ма, Хотака?
Dialogue: 0,0:09:14.26,0:09:15.88,Default,,0,0,0,,Осы жарыс кезінде I-
Dialogue: 0,0:09:15.97,0:09:19.05,Default,,0,0,0,,Мен Тацута мырзаны кешкі асқа шақырғым келеді.
Dialogue: 0,0:09:19.93,0:09:20.93,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:22.98,0:09:26.90,Default,,0,0,0,,Мен сізді шақырмайынша тоқтамаңыз.
Dialogue: 0,0:09:28.23,0:09:29.94,Default,,0,0,0,,(радио дыбысы)
Dialogue: 0,0:09:30.07,0:09:31.15,Default,,0,0,0,,Хотака мырза
Dialogue: 0,0:09:33.82,0:09:37.82,Default,,0,0,0,,Мен жас ханымның кедергілерін аман-есен алып тастап, оны жолға жібердім.
Dialogue: 0,0:09:38.24,0:09:39.53,Default,,0,0,0,,Әрі қарай не істеуіміз керек?
Dialogue: 0,0:09:40.24,0:09:42.66,Default,,0,0,0,,Брейд Соробан, еңбегіңіз үшін рахмет
Dialogue: 0,0:09:43.58,0:09:47.79,Default,,0,0,0,,Жас ханым бақыттан әлі ес-түссіз жатыр, бірақ бұдан былай ол жақсы болады.
Dialogue: 0,0:09:48.21,0:09:51.09,Default,,0,0,0,,Жас ханым байқаған бойда сізбен қайта хабарласамын.
Dialogue: 0,0:09:51.17,0:09:52.75,Default,,0,0,0,,Оған дейін демалу керек.
Dialogue: 0,0:09:52.96,0:09:54.84,Default,,0,0,0,,Арахора Сассер
Dialogue: 0,0:09:55.22,0:09:56.22,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:56.72,0:10:00.35,Default,,0,0,0,,Енді жарыс өзінің екінші жартысына аяқ басты.
Dialogue: 0,0:10:02.18,0:10:04.85,Default,,0,0,0,,Никурадан маған 1000 иен беруін өтініңіз.
Dialogue: 0,0:10:06.14,0:10:07.98,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:10:09.40,0:10:12.07,Default,,0,0,0,,Менің қарным ашты. Бірдеңе дұрыс емес пе?
Dialogue: 0,0:10:13.73,0:10:15.49,Default,,0,0,0,,Адамдар өмір бойы жүрек тереңдерін өзгелерден жасырып өтеді.
Dialogue: 0,0:10:16.90,0:10:19.99,Default,,0,0,0,,А, бұл қызық емес пе?
Dialogue: 0,0:10:21.33,0:10:24.20,Default,,0,0,0,,Нагумо! Нагумо!
Dialogue: 0,0:10:24.83,0:10:26.37,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:10:26.46,0:10:28.08,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:10:28.21,0:10:29.58,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:10:29.67,0:10:31.34,Default,,0,0,0,,Никура (Никура) Уау!
Dialogue: 0,0:10:31.42,0:10:33.09,Default,,0,0,0,,А, мен таң қалдым Иә!
Dialogue: 0,0:10:33.63,0:10:36.59,Default,,0,0,0,,Біраз уақыттан бері жол тым тар болған жоқ па?
Dialogue: 0,0:10:37.09,0:10:40.76,Default,,0,0,0,,Не? Ха! Бұл рас
Dialogue: 0,0:10:40.97,0:10:43.51,Default,,0,0,0,,Өзін-өзі қысып тұрғандай, бұл не...
Dialogue: 0,0:10:43.51,0:10:43.89,Default,,0,0,0,,Өзін қысып тұрғандай, бұл не...
Dialogue: 0,0:10:43.51,0:10:43.89,Default,,0,0,0,,Ал ол мақтаныш – шайқас мақтанышы, зорлық-зомбылық мақтанышы.
Dialogue: 0,0:10:43.89,0:10:43.97,Default,,0,0,0,,Ал ол мақтаныш – шайқас мақтанышы, зорлық-зомбылық мақтанышы.
Dialogue: 0,0:10:43.97,0:10:44.81,Default,,0,0,0,,Ал ол мақтаныш – шайқас мақтанышы, зорлық-зомбылық мақтанышы.
Dialogue: 0,0:10:43.97,0:10:44.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:44.89,0:10:45.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:46.02,0:10:47.73,Default,,0,0,0,,Эй, эй, қара!
Dialogue: 0,0:10:48.10,0:10:49.31,Default,,0,0,0,,Бұл тұйыққа тіреледі!
Dialogue: 0,0:10:49.39,0:10:50.31,Default,,0,0,0,,Не?!
Dialogue: 0,0:10:50.81,0:10:52.02,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:10:52.48,0:10:54.61,Default,,0,0,0,,Мен не болып жатқанын көремін.
Dialogue: 0,0:10:56.74,0:11:01.20,Default,,0,0,0,,Жоқ! Бұл не?!
Dialogue: 0,0:11:04.91,0:11:06.70,Default,,0,0,0,,Бұл лабиринт емес пе?
Dialogue: 0,0:11:07.12,0:11:08.16,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:08.71,0:11:10.25,Default,,0,0,0,,Бұл енді мүмкін емес...
Dialogue: 0,0:11:10.50,0:11:11.33,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:12.38,0:11:13.75,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:11:14.17,0:11:16.76,Default,,0,0,0,,Жоқ... өйткені...
Dialogue: 0,0:11:19.88,0:11:22.93,Default,,0,0,0,,Маған қалдырыңыз! Мен сізге міндетті түрде жеңіске жетуге мүмкіндік беремін!
Dialogue: 0,0:11:23.30,0:11:24.14,Default,,0,0,0,,Ha
Dialogue: 0,0:11:24.30,0:11:25.14,Default,,0,0,0,,Уф…
Dialogue: 0,0:11:25.35,0:11:26.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:26.77,0:11:29.48,Default,,0,0,0,,Күт, күт, күт, күт, күт...
Dialogue: 0,0:11:29.56,0:11:31.85,Default,,0,0,0,,Мықты бол Никура! Мықты және берік!
Dialogue: 0,0:11:32.31,0:11:34.11,Default,,0,0,0,,Не?
Dialogue: 0,0:11:34.19,0:11:38.36,Default,,0,0,0,,Дұрыс, мен сол кулонды қайтарып аламын да, бәрін нөлге қоямын...
Dialogue: 0,0:11:39.44,0:11:40.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:41.49,0:11:42.41,Default,,0,0,0,,Кккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккк
Dialogue: 0,0:11:42.61,0:11:46.54,Default,,0,0,0,,Ммммммм~ Тамақ~? Ммм
Dialogue: 0,0:11:46.62,0:11:48.29,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:11:48.41,0:11:52.67,Default,,0,0,0,,Бұл жақсы, бірақ~
Dialogue: 0,0:11:53.42,0:11:55.42,Default,,0,0,0,,Иә
Dialogue: 0,0:11:56.75,0:11:59.17,Default,,0,0,0,,Не болды? Біраз уақыттан бері аң-таң болып жүрмін
Dialogue: 0,0:11:59.30,0:12:02.55,Default,,0,0,0,,Аа... Кешіріңіз.
Dialogue: 0,0:12:02.93,0:12:03.76,Default,,0,0,0,,Сіз жеңесіз, солай ма?
Dialogue: 0,0:12:04.47,0:12:05.47,Default,,0,0,0,,Мен мүмкіндігінше тезірек барамын!
Dialogue: 0,0:12:05.97,0:12:10.31,Default,,0,0,0,,Ууууууууууууу!
Dialogue: 0,0:12:10.39,0:12:11.23,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:12.31,0:12:14.56,Default,,0,0,0,,Нагумо-санға қазір жетіспейтін нәрселер
Dialogue: 0,0:12:15.48,0:12:16.31,Default,,0,0,0,,Ui
Dialogue: 0,0:12:16.94,0:12:18.07,Default,,0,0,0,,Мақсат
Dialogue: 0,0:12:19.48,0:12:22.49,Default,,0,0,0,,Бұл жарыс ақшалай жүлдеге арналған, солай ма?
Dialogue: 0,0:12:22.82,0:12:24.82,Default,,0,0,0,,Басқа себеп бар ма?
Dialogue: 0,0:12:25.16,0:12:27.12,Default,,0,0,0,,Неліктен жеңгіңіз келеді?
Dialogue: 0,0:12:27.62,0:12:29.87,Default,,0,0,0,,Ха ха
Dialogue: 0,0:12:30.29,0:12:31.75,Default,,0,0,0,,Мен саған ешқашан айтпаймын!
Dialogue: 0,0:12:31.87,0:12:33.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:34.83,0:12:35.67,Default,,0,0,0,,Ha
Dialogue: 0,0:12:36.33,0:12:39.59,Default,,0,0,0,,Сол кездегі қарызымды өтейін.
Dialogue: 0,0:12:40.17,0:12:41.59,Default,,0,0,0,,Нагумо-сенпай!
Dialogue: 0,0:12:42.13,0:12:43.97,Default,,0,0,0,,Нагумо мен Никура жұбы
Dialogue: 0,0:12:44.05,0:12:47.47,Default,,0,0,0,,Үшінші бақылау бекетіндегі лабиринттен бірінші болып өттім!
Dialogue: 0,0:12:48.39,0:12:50.64,Default,,0,0,0,,Екінші жағынан, қазіргі уақытта ең төменгі орын ...
Dialogue: 0,0:12:50.72,0:12:53.69,Default,,0,0,0,,Цурубиши Макабе және Доктор Тара Адачи жұбы
Dialogue: 0,0:12:53.89,0:12:56.35,Default,,0,0,0,,Мен бірінші сот процесінде тұрып қалдым...
Dialogue: 0,0:12:56.73,0:12:59.15,Default,,0,0,0,,Хайку аяқталысымен ішімдік ішу тойы басталды.
Dialogue: 0,0:12:59.77,0:13:03.24,Default,,0,0,0,,Ой! Мұнда ешкім назар аударған жоқ.
Dialogue: 0,0:13:03.32,0:13:05.61,Default,,0,0,0,,Татешина мен Викторина Кинг жұбы-
Dialogue: 0,0:13:05.70,0:13:09.08,Default,,0,0,0,,Обаба ұстап алып, назарын аудармай тастап кетті
Dialogue: 0,0:13:09.28,0:13:11.58,Default,,0,0,0,,Екінші жағынан, Обаба жұбы Изумивако...
Dialogue: 0,0:13:11.66,0:13:14.83,Default,,0,0,0,,Бос уақыт парағын жайыңыз, ерте түскі астың уақыты келді.
Dialogue: 0,0:13:14.92,0:13:16.63,Default,,0,0,0,,Мына балалар не істеп жатыр?
Dialogue: 0,0:13:16.83,0:13:20.13,Default,,0,0,0,,Екеуіне бәс тіккен аудиториядан дауылдау дауылы жалғасты.
Dialogue: 0,0:13:27.01,0:13:29.30,Default,,0,0,0,,Хаа Сенсей (Оникама) Хаа Хаа
Dialogue: 0,0:13:29.68,0:13:32.31,Default,,0,0,0,,Осы жерден жеңе аламыз ба?
Dialogue: 0,0:13:32.97,0:13:35.31,Default,,0,0,0,,Осы жерден зейнетке шықсаңыз, міндетті түрде...
Dialogue: 0,0:13:35.60,0:13:37.23,Default,,0,0,0,,Жеңіске жету мүмкін емес
Dialogue: 0,0:13:37.94,0:13:41.98,Default,,0,0,0,,Бірақ бас тартпасаңыз, жеңу мүмкіндігі нөлге тең емес.
Dialogue: 0,0:13:42.44,0:13:45.99,Default,,0,0,0,,Жақсы, мен оны керемет етіп көрсетуге тырыстым.
Dialogue: 0,0:13:46.24,0:13:47.86,Default,,0,0,0,,Манга суретшісі күткендей
Dialogue: 0,0:13:48.20,0:13:50.87,Default,,0,0,0,,Аузымнан есімдер тамшылап жатыр
Dialogue: 0,0:13:52.12,0:13:52.95,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:13:53.16,0:13:54.00,Default,,0,0,0,,Иә
Dialogue: 0,0:13:55.25,0:13:57.25,Default,,0,0,0,,Сіз Оникамабоко-сенсэйсіз, солай ма?
Dialogue: 0,0:13:57.83,0:13:59.04,Default,,0,0,0,,Қол қойыңыз!
Dialogue: 0,0:14:00.88,0:14:02.55,Default,,0,0,0,,Осындай уақытта кешірім сұраймын.
Dialogue: 0,0:14:02.67,0:14:03.51,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:14:03.59,0:14:06.47,Default,,0,0,0,,Қолтаңба жазу – жаныма азық.
Dialogue: 0,0:14:06.68,0:14:07.51,Default,,0,0,0,,Иә
Dialogue: 0,0:14:08.97,0:14:11.47,Default,,0,0,0,,Сауда жасағыңыз келе ме? Изумивако-сан
Dialogue: 0,0:14:11.68,0:14:14.56,Default,,0,0,0,,Изуми Вако? Сол «Канки-кун»?
Dialogue: 0,0:14:14.85,0:14:16.85,Default,,0,0,0,,Қол қоюдың орнына--
Dialogue: 0,0:14:17.73,0:14:19.06,Default,,0,0,0,,Оны серияға айналдырыңыз!
Dialogue: 0,0:14:19.69,0:14:21.06,Default,,0,0,0,,Не?!
Dialogue: 0,0:14:21.36,0:14:24.32,Default,,0,0,0,,Ондай нәрсе... Не болса да, анау мәміле...
Dialogue: 0,0:14:24.53,0:14:25.69,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:25.78,0:14:27.07,Default,,0,0,0,,Не?!
Dialogue: 0,0:14:27.45,0:14:31.37,Default,,0,0,0,,Оникамабоко-сенсэйдің қолтаңбасын алсаңыз, мен жазамын!
Dialogue: 0,0:14:31.45,0:14:32.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:32.87,0:14:34.41,Default,,0,0,0,,Олай болса, қол қоймаймын!
Dialogue: 0,0:14:34.49,0:14:35.50,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:35.91,0:14:38.33,Default,,0,0,0,,Белгілер жан азығы деп жоғарыда айттым.
Dialogue: 0,0:14:38.46,0:14:41.13,Default,,0,0,0,,Мен жаңадан келген таланттылардан қорқамын.
Dialogue: 0,0:14:41.54,0:14:43.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:47.80,0:14:51.26,Default,,0,0,0,,«Гакутсу-куннан» қолтаңба алсаңыз, жазасыз, солай ма?
Dialogue: 0,0:14:51.89,0:14:52.72,Default,,0,0,0,,Иә
Dialogue: 0,0:14:54.26,0:14:55.60,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:56.22,0:14:57.73,Default,,0,0,0,,Мен болсам
Dialogue: 0,0:14:57.98,0:14:59.48,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:00.06,0:15:01.10,Default,,0,0,0,,Хахаха
Dialogue: 0,0:15:02.11,0:15:02.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:03.48,0:15:05.61,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:07.07,0:15:09.07,Default,,0,0,0,,Уф, мен оны сериялаймын.
Dialogue: 0,0:15:09.24,0:15:10.32,Default,,0,0,0,,…Бұл мүмкін емес қой?
Dialogue: 0,0:15:10.57,0:15:13.62,Default,,0,0,0,,Күте тұрыңыз! Изуми Вако!
Dialogue: 0,0:15:14.08,0:15:14.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:14.99,0:15:16.91,Default,,0,0,0,,Мұғалім! Сенсей!
Dialogue: 0,0:15:17.41,0:15:21.42,Default,,0,0,0,,Тұрыңыз! Егер сіз бас тартпасаңыз, мүмкіндік нөлге тең емес
Dialogue: 0,0:15:21.58,0:15:24.04,Default,,0,0,0,,Саған сабақ берген ұстазың болды!
Dialogue: 0,0:15:24.46,0:15:26.63,Default,,0,0,0,,Мен бас тартамын және оны нөлге дейін азайтамын!
Dialogue: 0,0:15:31.30,0:15:33.22,Default,,0,0,0,,Төрт! (Оникама) Лулулулу
Dialogue: 0,0:15:34.47,0:15:36.47,Default,,0,0,0,,Төрт!
Dialogue: 0,0:15:36.60,0:15:37.43,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:15:37.52,0:15:39.98,Default,,0,0,0,,Мұнда келіңіз, бұл үлкен камбэк!
Dialogue: 0,0:15:40.06,0:15:41.10,Default,,0,0,0,,Не!
Dialogue: 0,0:15:41.19,0:15:42.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:42.48,0:15:46.73,Default,,0,0,0,,Міне, жаңа оқиға!
Dialogue: 0,0:15:46.86,0:15:49.69,Default,,0,0,0,,Мұнда шыңға көтерілетін нәрсе ...
Dialogue: 0,0:15:49.78,0:15:52.32,Default,,0,0,0,,Мен ойлаған 5 саны төбет жоғалып кетті
Dialogue: 0,0:15:53.62,0:15:55.08,Default,,0,0,0,,Төрт!
Dialogue: 0,0:15:53.62,0:15:55.08,Default,,0,0,0,,Доктор Тара Адачи және Цурубиши жұбы
Dialogue: 0,0:15:55.08,0:15:56.03,Default,,0,0,0,,Доктор Тара Адачи және Цурубиши жұбы
Dialogue: 0,0:15:56.95,0:15:57.33,Default,,0,0,0,,жылдам жылдам жылдам жылдам
Dialogue: 0,0:15:57.33,0:15:59.00,Default,,0,0,0,,жылдам жылдам жылдам жылдам
Dialogue: 0,0:15:57.33,0:15:59.00,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:59.20,0:16:02.29,Default,,0,0,0,,Ессіз машинамен бақылау бекеттерін бірінен соң бірін жойыңыз!
Dialogue: 0,0:16:02.71,0:16:04.92,Default,,0,0,0,,Бірден шыңға секірді!
Dialogue: 0,0:16:05.46,0:16:06.29,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:06.67,0:16:09.05,Default,,0,0,0,,Не... Болды!
Dialogue: 0,0:16:09.13,0:16:11.59,Default,,0,0,0,,Эй, эй! Бұл фол!
Dialogue: 0,0:16:11.72,0:16:13.64,Default,,0,0,0,,Бақылау пункті жойылуда!
Dialogue: 0,0:16:13.72,0:16:17.14,Default,,0,0,0,,Екі адам бір уақытта өтсе, ешқандай проблема болмайды.
Dialogue: 0,0:16:17.39,0:16:18.64,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:18.72,0:16:20.81,Default,,0,0,0,,Оның үстіне көлік міну... Иә?
Dialogue: 0,0:16:22.23,0:16:24.60,Default,,0,0,0,,Ах... хахаха...
Dialogue: 0,0:16:27.82,0:16:27.98,Default,,0,0,0,,(Қолдаушылар дауысы)
Dialogue: 0,0:16:27.98,0:16:30.19,Default,,0,0,0,,(қолдаушылардың дауысы)
Dialogue: 0,0:16:27.98,0:16:30.19,Default,,0,0,0,,Мен оны кіргізе алатынымды білдім. Мұнда не болды?
Dialogue: 0,0:16:30.28,0:16:32.32,Default,,0,0,0,,Дисквалификацияланған жұптар ғана емес
Dialogue: 0,0:16:32.40,0:16:35.28,Default,,0,0,0,,Тіпті жақтаушылар да уәждерін айтты...
Dialogue: 0,0:16:35.37,0:16:37.45,Default,,0,0,0,,Бұл үлкен шайқас!
Dialogue: 0,0:16:38.08,0:16:40.25,Default,,0,0,0,,CITY жарысы қызық болып барады
Dialogue: 0,0:16:40.50,0:16:42.41,Default,,0,0,0,,Кез келген нәрсе баратын жарыста жеңген адам...
Dialogue: 0,0:16:42.50,0:16:44.50,Default,,0,0,0,,Амансың ба? Хотака мырза
Dialogue: 0,0:16:44.75,0:16:46.21,Default,,0,0,0,,Бұл қазірдің өзінде тәртіпсіздік
Dialogue: 0,0:16:46.79,0:16:47.75,Default,,0,0,0,,Уа!!
Dialogue: 0,0:16:48.29,0:16:53.38,Default,,0,0,0,,Бастапқыда шілтер жас ханым мен Тацута-дононы жақындату үшін жасалған.
Dialogue: 0,0:16:53.55,0:16:57.47,Default,,0,0,0,,Ал егер жас ханым сізді кешкі асқа шақырған болса...
Dialogue: 0,0:16:58.72,0:17:00.27,Default,,0,0,0,,Мен мұны енді білмеймін
Dialogue: 0,0:17:05.15,0:17:06.44,Default,,0,0,0,,Нагумо-сан...
Dialogue: 0,0:17:07.02,0:17:07.86,Default,,0,0,0,,Күрсін... (Никкура) Уф...
Dialogue: 0,0:17:09.44,0:17:11.69,Default,,0,0,0,,А-а... (Нагумо) Бұл әлдеқашан әбігер болып қалды ғой, солай емес пе?
Dialogue: 0,0:17:12.03,0:17:13.65,Default,,0,0,0,,Бұлай жеңу мүмкін емес.
Dialogue: 0,0:17:13.90,0:17:14.74,Default,,0,0,0,,Ha
Dialogue: 0,0:17:14.86,0:17:17.82,Default,,0,0,0,,Бұл мүлдем мүмкін емес болса да, жалғастырудың қажеті жоқ.
Dialogue: 0,0:17:21.54,0:17:22.37,Default,,0,0,0,,Уф
Dialogue: 0,0:17:23.66,0:17:26.58,Default,,0,0,0,,Мен тастадым, тастадым, үйге қайтайық Никура
Dialogue: 0,0:17:29.88,0:17:32.05,Default,,0,0,0,,Қарғыс атсын... Нагумо-сан!
Dialogue: 0,0:17:32.13,0:17:33.72,Default,,0,0,0,,Мақсат! (Нагумо) Иә?
Dialogue: 0,0:17:36.59,0:17:37.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:37.39,0:17:40.60,Default,,0,0,0,,Сіз ұмыттыңыз ба? Жеңімпаз жүлде – 1 миллион иен!
Dialogue: 0,0:17:40.72,0:17:41.56,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:41.77,0:17:44.39,Default,,0,0,0,,Қазір сізде бар нәрсе - ақша!
Dialogue: 0,0:17:44.52,0:17:46.23,Default,,0,0,0,,Бұл мақсат!
Dialogue: 0,0:17:46.60,0:17:48.06,Default,,0,0,0,,Егер сізге осы ғана керек болса...
Dialogue: 0,0:17:48.35,0:17:49.44,Default,,0,0,0,,Жаман бол!
Dialogue: 0,0:17:49.90,0:17:52.57,Default,,0,0,0,,Еңкейіп қан құссам да...
Dialogue: 0,0:17:53.19,0:17:55.24,Default,,0,0,0,,Олардың бәрін өлтіріп, жалғастырыңыз!
Dialogue: 0,0:17:55.49,0:17:58.32,Default,,0,0,0,,Бұл Мидори Нагумо! Дұрыс па?
Dialogue: 0,0:17:58.66,0:18:01.20,Default,,0,0,0,,Бұл мүмкін емес. Оны төңкеріп қойған дұрыс.
Dialogue: 0,0:18:01.41,0:18:05.04,Default,,0,0,0,,Бұл өте қызықты болар еді!
Dialogue: 0,0:18:07.54,0:18:08.50,Default,,0,0,0,,Сіздің жауабыңыз қандай?
Dialogue: 0,0:18:09.00,0:18:12.55,Default,,0,0,0,,Шулы! (Никкура) Мен тым көп айттым!
Dialogue: 0,0:18:12.75,0:18:14.21,Default,,0,0,0,,Айтпасаң да... (Никкура) Уф
Dialogue: 0,0:18:15.17,0:18:18.26,Default,,0,0,0,,Жаса!
Dialogue: 0,0:18:18.34,0:18:19.18,Default,,0,0,0,,Уф
Dialogue: 0,0:18:22.51,0:18:23.89,Default,,0,0,0,,(радио дыбысы)
Dialogue: 0,0:18:23.97,0:18:25.43,Default,,0,0,0,,Хотака мырза!
Dialogue: 0,0:18:26.43,0:18:29.69,Default,,0,0,0,,Бұл Хотака, сенің қазір не істейтінің маған бәрібір.
Dialogue: 0,0:18:30.40,0:18:31.65,Default,,0,0,0,,Жоқ, сэр.
Dialogue: 0,0:18:31.73,0:18:32.15,Default,,0,0,0,,Ммммммм...
Dialogue: 0,0:18:32.15,0:18:34.82,Default,,0,0,0,,Ммммммм...
Dialogue: 0,0:18:32.15,0:18:34.82,Default,,0,0,0,,Мен Тацута Адачи, жұп жас ханымдармын...
Dialogue: 0,0:18:34.90,0:18:35.74,Default,,0,0,0,,Не?
Dialogue: 0,0:18:36.15,0:18:37.49,Default,,0,0,0,,Оның әлі де ынтасы бар сияқты.
Dialogue: 0,0:18:37.57,0:18:40.37,Default,,0,0,0,,Ол қыздың да жеңіске жетуі үшін оған қолдау көрсеткісі келеді.
Dialogue: 0,0:18:40.45,0:18:41.49,Default,,0,0,0,,Уф…
Dialogue: 0,0:18:43.95,0:18:45.16,Default,,0,0,0,,(радио дыбысы)
Dialogue: 0,0:18:45.58,0:18:46.41,Default,,0,0,0,,Бұл Хотака.
Dialogue: 0,0:18:46.79,0:18:48.29,Default,,0,0,0,,Бір жұп жас ханымдардан басқа -
Dialogue: 0,0:18:48.71,0:18:50.33,Default,,0,0,0,,Барлығын тоқтатыңыз!
Dialogue: 0,0:18:50.92,0:18:53.38,Default,,0,0,0,,Соңында барлық жүгірушілер финалдық бөлімге өтті!
Dialogue: 0,0:18:53.63,0:18:54.71,Default,,0,0,0,,Дегенмен, Цурубиши жұбы әлі де көш басында
Dialogue: 0,0:18:54.71,0:18:56.38,Default,,0,0,0,,Дегенмен, Цурубиши жұбы әлі де көш бастап тұр
Dialogue: 0,0:18:54.71,0:18:56.38,Default,,0,0,0,,Төрт!
Dialogue: 0,0:18:56.38,0:18:56.59,Default,,0,0,0,,Төрт!
Dialogue: 0,0:18:56.59,0:18:59.26,Default,,0,0,0,,Төрт!
Dialogue: 0,0:18:56.59,0:18:59.26,Default,,0,0,0,,Осылай жүре берсем, чемпиондықты жеңетін сияқтымын...
Dialogue: 0,0:18:59.34,0:19:00.18,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:19:02.26,0:19:05.39,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:19:08.35,0:19:09.94,Default,,0,0,0,,Ха ха
Dialogue: 0,0:19:10.69,0:19:11.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:11.69,0:19:13.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:18.07,0:19:21.16,Default,,0,0,0,,Күтіңіз, күтіңіз, күтіңіз... (4-қолдаушы) Бірақ!
Dialogue: 0,0:19:21.45,0:19:23.99,Default,,0,0,0,,Сіз сыйлық аласыз!
Dialogue: 0,0:19:24.12,0:19:25.95,Default,,0,0,0,,Тоқта Тоқта! (7-қолдаушы) Не болды?
Dialogue: 0,0:19:26.04,0:19:27.50,Default,,0,0,0,,Оникама жоқ
Dialogue: 0,0:19:27.66,0:19:28.50,Default,,0,0,0,,Не?
Dialogue: 0,0:19:28.62,0:19:29.50,Default,,0,0,0,,Ішек
Dialogue: 0,0:19:29.62,0:19:30.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:33.54,0:19:35.92,Default,,0,0,0,,Ахахахахаха
Dialogue: 0,0:19:36.13,0:19:37.63,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:19:37.71,0:19:39.01,Default,,0,0,0,,Қандай жарылыс!
Dialogue: 0,0:19:39.09,0:19:40.47,Default,,0,0,0,,Мен білмеймін Уау!
Dialogue: 0,0:19:40.72,0:19:43.43,Default,,0,0,0,,Уау! Барлығы отыз алты!
Dialogue: 0,0:19:45.10,0:19:45.93,Default,,0,0,0,,Дахаха
Dialogue: 0,0:19:46.01,0:19:47.60,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:19:47.68,0:19:48.52,Default,,0,0,0,,Қарсы емес!
Dialogue: 0,0:19:48.60,0:19:51.69,Default,,0,0,0,,Төраға Хотаканың нұсқауы жас ханымнан басқаның бәрін тоқтату...
Dialogue: 0,0:19:51.77,0:19:55.44,Default,,0,0,0,,Уау! (Мицугаку) Уау! Барлығымыз кеттік!
Dialogue: 0,0:19:55.57,0:19:56.77,Default,,0,0,0,,Гагага (труппа мүшесі) Чу
Dialogue: 0,0:19:57.11,0:19:57.98,Default,,0,0,0,,Кики
Dialogue: 0,0:19:58.19,0:19:59.44,Default,,0,0,0,,Пурулуру…
Dialogue: 0,0:19:59.53,0:20:00.65,Default,,0,0,0,,Куу
Dialogue: 0,0:20:01.28,0:20:04.20,Default,,0,0,0,,Абаба ах аа~
Dialogue: 0,0:20:04.28,0:20:05.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:08.70,0:20:10.25,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:20:10.33,0:20:12.50,Default,,0,0,0,,Не? Апыр-ай! Бұл жолмен?
Dialogue: 0,0:20:13.08,0:20:14.25,Default,,0,0,0,,Ой!
Dialogue: 0,0:20:14.46,0:20:16.00,Default,,0,0,0,,Намсаан!
Dialogue: 0,0:20:16.25,0:20:17.75,Default,,0,0,0,,Апа... (Обина) Сан!
Dialogue: 0,0:20:18.63,0:20:20.01,Default,,0,0,0,,Ааа?
Dialogue: 0,0:20:22.26,0:20:23.09,Default,,0,0,0,,Не!
Dialogue: 0,0:20:23.18,0:20:26.10,Default,,0,0,0,,Бұл жалған! Күтіңіз, Корра!
Dialogue: 0,0:20:26.64,0:20:28.10,Default,,0,0,0,,Неше жұп қалды?
Dialogue: 0,0:20:28.26,0:20:29.10,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:20:29.43,0:20:31.02,Default,,0,0,0,,Әйтеуір, қарттың машинасын тоқтатуым керек.
Dialogue: 0,0:20:31.10,0:20:31.94,Default,,0,0,0,,Эй!
Dialogue: 0,0:20:32.02,0:20:33.48,Default,,0,0,0,,Маған бір нәрсе ұшып келді!
Dialogue: 0,0:20:33.77,0:20:35.90,Default,,0,0,0,,Уау! (8 қауіпсіздік) Бұл жігіт кім?
Dialogue: 0,0:20:36.73,0:20:37.61,Default,,0,0,0,,Жіберме!
Dialogue: 0,0:20:37.86,0:20:42.11,Default,,0,0,0,,1 миллион ех! (Күзетшілер) Уа!
Dialogue: 0,0:20:42.20,0:20:43.32,Default,,0,0,0,,және Тоқта!
Dialogue: 0,0:20:43.40,0:20:44.41,Default,,0,0,0,,Түсірейік!
Dialogue: 0,0:20:45.11,0:20:48.08,Default,,0,0,0,,Төраға Ходака, атуға рұқсат
Dialogue: 0,0:20:50.91,0:20:52.04,Default,,0,0,0,,Машиналар туралы не деуге болады?
Dialogue: 0,0:20:52.12,0:20:54.79,Default,,0,0,0,,Ол бақылаудан шықты...
Dialogue: 0,0:20:52.12,0:20:54.79,Default,,0,0,0,,(канпоккури дыбысы)
Dialogue: 0,0:20:55.08,0:20:58.46,Default,,0,0,0,,Бір нәрсе... жарылып кетті.
Dialogue: 0,0:20:58.71,0:20:59.55,Default,,0,0,0,,Донго…
Dialogue: 0,0:21:00.13,0:21:01.17,Default,,0,0,0,,Га… Га…
Dialogue: 0,0:21:01.46,0:21:03.09,Default,,0,0,0,,Иә? (Күзетшілердің шуы)
Dialogue: 0,0:21:05.26,0:21:07.51,Default,,0,0,0,,(канпоккури дыбысы)
Dialogue: 0,0:21:07.60,0:21:08.60,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:21:09.06,0:21:12.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:15.19,0:21:16.23,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:21:16.31,0:21:19.65,Default,,0,0,0,,Мацури мен Экчан жұбы жеңді
Dialogue: 0,0:21:23.15,0:21:24.20,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:24.28,0:21:26.45,Default,,0,0,0,,Келіңдер, Мацури мен Экчан жұп болып.
Dialogue: 0,0:21:26.53,0:21:29.03,Default,,0,0,0,,1 миллион иен көлеміндегі жүлде беріледі.
Dialogue: 0,0:21:29.62,0:21:31.49,Default,,0,0,0,,1 миллион иенді не үшін пайдаланасыз?
Dialogue: 0,0:21:31.62,0:21:34.00,Default,,0,0,0,,Ал, мен алдымен шырын сатып алайын.
Dialogue: 0,0:21:34.08,0:21:36.42,Default,,0,0,0,,Мен тәттілер мен «достық» сатып алдым...
Dialogue: 0,0:21:36.58,0:21:38.54,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:21:38.63,0:21:40.71,Default,,0,0,0,,Бұл шатасқан жарыс дегеніміз не?
Dialogue: 0,0:21:40.80,0:21:41.75,Default,,0,0,0,,Келісесіз бе?
Dialogue: 0,0:21:41.84,0:21:43.13,Default,,0,0,0,,Тыныштанып, тынышталыңыз.
Dialogue: 0,0:21:43.26,0:21:46.34,Default,,0,0,0,,Амансың ба? Бұл 1 миллион иен!
Dialogue: 0,0:21:46.43,0:21:48.59,Default,,0,0,0,,Маған ақшалай сыйлық қажет емес
Dialogue: 0,0:21:48.85,0:21:51.47,Default,,0,0,0,,Сонда неге шықтың?
Dialogue: 0,0:21:51.56,0:21:52.93,Default,,0,0,0,,Сол екі адам.
Dialogue: 0,0:21:53.02,0:21:54.73,Default,,0,0,0,,Себебі мен оның жеңіске жетуін қаладым.
Dialogue: 0,0:21:55.35,0:21:56.48,Default,,0,0,0,,Экчан жақсырақ
Dialogue: 0,0:21:56.56,0:21:59.23,Default,,0,0,0,,Мен сіздің Англияға көшіп бара жатқаныңызды естідім.
Dialogue: 0,0:21:59.69,0:22:02.94,Default,,0,0,0,,Екеуің бөлек кететін сияқтысыңдар.
Dialogue: 0,0:22:03.53,0:22:05.86,Default,,0,0,0,,Бұл атау.
Dialogue: 0,0:22:06.61,0:22:09.49,Default,,0,0,0,,Ол үшін мен механизм жасадым...
Dialogue: 0,0:22:09.57,0:22:11.20,Default,,0,0,0,,Дайындықпен айналыстым.
Dialogue: 0,0:22:11.28,0:22:12.12,Default,,0,0,0,,Бұл сен бе!
Dialogue: 0,0:22:12.91,0:22:15.54,Default,,0,0,0,,А, бірақ дәрігер өзгерткен Маккаби...
Dialogue: 0,0:22:15.62,0:22:16.87,Default,,0,0,0,,Бұл күтпеген жағдай болды.
Dialogue: 0,0:22:17.50,0:22:21.29,Default,,0,0,0,,Бірақ менің әпкем Рико оны мен үшін бұзды...
Dialogue: 0,0:22:22.13,0:22:22.96,Default,,0,0,0,,Никура…
Dialogue: 0,0:22:23.30,0:22:24.63,Default,,0,0,0,,Екі Платон келе жатыр!
Dialogue: 0,0:22:24.71,0:22:25.34,Default,,0,0,0,,Иә
Dialogue: 0,0:22:25.42,0:22:28.63,Default,,0,0,0,,Не? Ахахахаха
Dialogue: 0,0:22:29.68,0:22:30.97,Default,,0,0,0,,♪～
Dialogue: 0,0:22:31.10,0:22:34.52,Default,,0,0,0,,Мен таң қалдым! Маусым
Dialogue: 0,0:22:34.85,0:22:38.56,Default,,0,0,0,,Еш ойланбастан ерітіңіз
Dialogue: 0,0:22:39.10,0:22:43.02,Default,,0,0,0,,Қайнап жатқан көшемен Гойнонға бару
Dialogue: 0,0:22:43.15,0:22:47.03,Default,,0,0,0,,Түс пе, әлде бір нәрсе ме, білмеймін
Dialogue: 0,0:22:47.15,0:22:50.70,Default,,0,0,0,,Шамадан тыс ұйықтаудан туындаған шымшу
Dialogue: 0,0:22:51.28,0:22:54.87,Default,,0,0,0,,Таң қалдыратын сараңдық та солай.
Dialogue: 0,0:22:55.41,0:22:59.33,Default,,0,0,0,,Бұл ұят және тітіркендіргіш.
Dialogue: 0,0:22:59.46,0:23:02.71,Default,,0,0,0,,Қазір оны жеудің ең жақсы уақыты сияқты.
Dialogue: 0,0:23:03.13,0:23:10.09,Default,,0,0,0,,Кәдімгідей болып көріну
Dialogue: 0,0:23:11.30,0:23:18.27,Default,,0,0,0,,Өткен жылғыдан басқа жаз.
Dialogue: 0,0:23:19.35,0:23:23.98,Default,,0,0,0,,Мәселе! Бірақ қызық
Dialogue: 0,0:23:27.61,0:23:32.07,Default,,0,0,0,,Сіз өзіңізсіз
Dialogue: 0,0:23:34.99,0:23:39.37,Default,,0,0,0,,Бұл қалада мысықтар да, шөміштер де жүгіреді
Dialogue: 0,0:23:39.75,0:23:42.54,Default,,0,0,0,,Мен де бүгін сенімен бірге болғым келеді
Dialogue: 0,0:23:42.75,0:23:49.72,Default,,0,0,0,,Шатырдың артына тығылған күн
Dialogue: 0,0:23:50.26,0:23:52.72,Default,,0,0,0,,Әй, жаз келе жатыр
Dialogue: 0,0:23:55.43,0:23:58.27,Default,,0,0,0,,～♪
Dialogue: 0,0:23:59.81,0:24:02.52,Default,,0,0,0,,Мен Канпоккуримен естеліктер жасағым келді, бірақ...
Dialogue: 0,0:24:02.73,0:24:04.98,Default,,0,0,0,,Мен одан да көп алдым.
Dialogue: 0,0:24:05.98,0:24:07.15,Default,,0,0,0,,1 миллион иен
Dialogue: 0,0:24:07.82,0:24:08.99,Default,,0,0,0,,Бұл білдіреді
Dialogue: 0,0:24:09.15,0:24:10.82,Default,,0,0,0,,Әлемді жаулап алу
Dialogue: 0,0:24:11.24,0:24:12.11,Default,,0,0,0,,Уақыт құмы арқылы саяхат
Dialogue: 0,0:24:14.12,0:24:16.74,Default,,0,0,0,,Бұл есте қаларлық.
Dialogue: 0,0:24:16.83,0:24:18.49,Default,,0,0,0,,Ол қалады.
Dialogue: 0,0:24:21.00,0:24:22.71,Default,,0,0,0,,Бір кальмар фестивалі
Dialogue: 0,0:24:22.79,0:24:24.71,Default,,0,0,0,,Не? Экчан Даймау
Dialogue: 0,0:24:25.21,0:24:26.09,Default,,0,0,0,,Ұлы жын патша!
Dialogue: 0,0:24:26.88,0:24:30.76,Default,,0,0,0,,Дүниені бағындырсам да, Қорқыныш тереңіне түспеймін.
Dialogue: 0,0:24:30.84,0:24:33.22,Default,,0,0,0,,Ах, кешіріңіз, Ұлы жын патша.
Dialogue: 0,0:24:33.63,0:24:35.47,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:24:35.93,0:24:37.72,Default,,0,0,0,,Жоғары мәртебелі император?
Dialogue: 0,0:24:38.06,0:24:39.72,Default,,0,0,0,,Жоғары мәртебелі император?
Dialogue: 0,0:24:40.22,0:24:44.19,Default,,0,0,0,,Мәртебелі Император Император Жоғары Мәртебелі Император Император
Dialogue: 0,0:24:44.31,0:24:46.98,Default,,0,0,0,,Император
Dialogue: 0,0:24:47.40,0:24:48.44,Default,,0,0,0,,жаңалық
Dialogue: 0,0:24:48.77,0:24:49.61,Default,,0,0,0,,Үйсу
Dialogue: 0,0:24:50.23,0:24:53.91,Default,,0,0,0,,Жоғары мәртебелі императордан бірнеше сөз айтқым келеді.
Dialogue: 0,0:24:54.36,0:24:55.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:56.32,0:24:59.62,Default,,0,0,0,,Біз алдыңғы жарыста 1 миллион иен ұтып алдық.
Dialogue: 0,0:24:59.70,0:25:00.54,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:25:00.83,0:25:03.21,Default,,0,0,0,,Бұл естеліктер тым күшті
Dialogue: 0,0:25:03.29,0:25:04.33,Default,,0,0,0,,Тым күшті ме?
Dialogue: 0,0:25:06.33,0:25:09.59,Default,,0,0,0,,Осыдан кейін сізде ешқандай естелік қалмауы мүмкін!
Dialogue: 0,0:25:09.92,0:25:12.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:13.38,0:25:16.30,Default,,0,0,0,,Мен не істеуім керек? Император император
Dialogue: 0,0:25:16.80,0:25:19.81,Default,,0,0,0,,Дүрбелең емес, бұл біздің...
Dialogue: 0,0:25:20.06,0:25:21.97,Default,,0,0,0,,Өйткені менде 1 миллион иен бар
Dialogue: 0,0:25:22.18,0:25:25.81,Default,,0,0,0,,Егер сіз мұны таң қалдыратын нәрсе үшін қолдансаңыз, әлі де үміт бар.
Dialogue: 0,0:25:26.02,0:25:27.56,Default,,0,0,0,,Таң қалдырды ма?
Dialogue: 0,0:25:28.15,0:25:30.61,Default,,0,0,0,,Иә, бұл күшті қолдану.
Dialogue: 0,0:25:30.90,0:25:33.36,Default,,0,0,0,,Оны жай ғана лақтырып тастау жақсы емес.
Dialogue: 0,0:25:34.07,0:25:38.20,Default,,0,0,0,,Тыңдаңыздар, біз оны өзімізге пайдалы бола отырып, таң қалдырамыз.
Dialogue: 0,0:25:38.53,0:25:40.08,Default,,0,0,0,,шықты Иә, Нянко-чан
Dialogue: 0,0:25:40.99,0:25:42.25,Default,,0,0,0,,Нянянянянко-чан
Dialogue: 0,0:25:42.58,0:25:43.79,Default,,0,0,0,,Түсіндірейін
Dialogue: 0,0:25:43.87,0:25:45.62,Default,,0,0,0,,Нянко-чан – виртуалды мысық
Dialogue: 0,0:25:45.71,0:25:47.92,Default,,0,0,0,,Олар олжасын көзінің сәулелерімен ұстайды.
Dialogue: 0,0:25:48.00,0:25:49.00,Default,,0,0,0,,Қандай кибер
Dialogue: 0,0:25:50.34,0:25:53.13,Default,,0,0,0,,Олай болса, ойыңды тыңдайық.
Dialogue: 0,0:25:53.38,0:25:55.51,Default,,0,0,0,,Ой... мен ұмытып кетіппін.
Dialogue: 0,0:25:55.63,0:25:58.43,Default,,0,0,0,,Менің ойымша, бұл өте жақсы идея болды!
Dialogue: 0,0:25:59.51,0:26:03.27,Default,,0,0,0,,Қажетсіз параметрлерді қосқанымыз үшін кешірім сұраймыз.
Dialogue: 0,0:26:04.48,0:26:07.40,Default,,0,0,0,,Ой... жоқ, бір қадақ шаң шықпайды.
Dialogue: 0,0:26:07.65,0:26:10.19,Default,,0,0,0,,Жаңа ғана виртуалды параметрлер қосылды
Dialogue: 0,0:26:10.98,0:26:15.24,Default,,0,0,0,,Енді Мацури-кунның жауабы жоқ сияқты, мен бірінші барамын.
Dialogue: 0,0:26:15.74,0:26:20.07,Default,,0,0,0,,Мәселе мынада, мен соңғы естеліктерімді жасауға тырысамын, сондықтан бұл ақылсыз.
Dialogue: 0,0:26:20.83,0:26:21.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:22.24,0:26:23.79,Default,,0,0,0,,Менде бұл 500 000...
Dialogue: 0,0:26:26.71,0:26:29.17,Default,,0,0,0,,Ұшақпен ұшып, мені көруге барыңыз.
Dialogue: 0,0:26:30.42,0:26:32.34,Default,,0,0,0,,Сондықтан фестиваль құны 500 000 иен...
Dialogue: 0,0:26:32.59,0:26:33.88,Default,,0,0,0,,Кел мені көр
Dialogue: 0,0:26:35.38,0:26:38.09,Default,,0,0,0,,Жадтың үздіксіз өзгеруі туралы не айтасыз?
Dialogue: 0,0:26:42.47,0:26:44.22,Default,,0,0,0,,Жаңа есіме түсті
Dialogue: 0,0:26:45.43,0:26:47.27,Default,,0,0,0,,Мен ойлаған идеялар
Dialogue: 0,0:26:47.60,0:26:51.48,Default,,0,0,0,,Дәл қазір мен сол аралықта мұңдан жылап отырмын.
Dialogue: 0,0:26:51.56,0:26:52.73,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:26:53.82,0:26:57.90,Default,,0,0,0,,Айтпақшы, ол қандай идея екенін айта аласыз ба?
Dialogue: 0,0:27:02.12,0:27:04.37,Default,,0,0,0,,Барлық соманы Читараға айналдырыңыз
Dialogue: 0,0:27:05.20,0:27:06.54,Default,,0,0,0,,Читара...
Dialogue: 0,0:27:08.04,0:27:14.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory