Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.66,0:00:03.62,Default,,0,0,0,,♪～
Dialogue: 0,0:01:24.45,0:01:27.42,Default,,0,0,0,,～♪
Dialogue: 0,0:01:41.10,0:01:42.18,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:42.51,0:01:44.06,Default,,0,0,0,,Екі адамға сенейік
Dialogue: 0,0:01:45.98,0:01:49.35,Default,,0,0,0,,Сейка-сан және Шигеру-сан
Dialogue: 0,0:01:55.74,0:01:58.99,Default,,0,0,0,,Жалғастырыңыз, Сейка-сама.
Dialogue: 0,0:02:03.20,0:02:06.71,Default,,0,0,0,,<Мен Каджита мырзаға Сейка атын ғана айттым>
Dialogue: 0,0:02:07.25,0:02:10.96,Default,,0,0,0,,<Себебі бұл сіз картаны тіркеу формасында толтырған жалғыз нәрсе>
Dialogue: 0,0:02:11.34,0:02:14.76,Default,,0,0,0,,Бұл қосымша кезең.
Dialogue: 0,0:02:14.88,0:02:17.59,Default,,0,0,0,,Картаны кіре берісте көрсетіңіз
Dialogue: 0,0:02:17.72,0:02:18.97,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:02:19.34,0:02:22.97,Default,,0,0,0,,<мырза Кажита өтірікті байқап, қабілетін іске қосады>
Dialogue: 0,0:02:23.10,0:02:27.98,Default,,0,0,0,,＜Онда бұл өтірік болуы мүмкін емес, ең аз ақпаратпен қарсы тұрудан басқа амалыңыз жоқ＞
Dialogue: 0,0:02:28.35,0:02:30.90,Default,,0,0,0,,Бүгін қанша ойнайсың?
Dialogue: 0,0:02:31.02,0:02:32.23,Default,,0,0,0,,1 миллион лир?
Dialogue: 0,0:02:32.61,0:02:34.98,Default,,0,0,0,,Әй, сені менсінбей жатыр ма?
Dialogue: 0,0:02:35.36,0:02:37.40,Default,,0,0,0,,Ах... цк
Dialogue: 0,0:02:37.69,0:02:39.49,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:02:46.12,0:02:51.46,Default,,0,0,0,,Қосымша кезеңнен толық рахат алыңыз.
Dialogue: 0,0:03:04.05,0:03:07.18,Default,,0,0,0,,Керемет! Маған бұл атмосфера ұнайды
Dialogue: 0,0:03:07.31,0:03:08.77,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:09.02,0:03:11.27,Default,,0,0,0,,<Клиенттерге қарағанда қызметкерлер көп>
Dialogue: 0,0:03:11.65,0:03:14.27,Default,,0,0,0,,<Жоғарыдағы еденнен мүлде басқаша.>
Dialogue: 0,0:03:14.48,0:03:17.15,Default,,0,0,0,,Бұдан былай мен саған бағыт-бағдар беремін.
Dialogue: 0,0:03:17.32,0:03:19.36,Default,,0,0,0,,Бұл Като! Сізге көп рахмет...
Dialogue: 0,0:03:19.53,0:03:21.03,Default,,0,0,0,,Иә, аламын!
Dialogue: 0,0:03:21.15,0:03:22.11,Default,,0,0,0,,<Тістеп алдың ба? ＞
Dialogue: 0,0:03:22.24,0:03:24.83,Default,,0,0,0,,Алдымен мөлшерлемені түсіндіріп берейін...
Dialogue: 0,0:03:24.95,0:03:27.37,Default,,0,0,0,,Иә, аламын.
Dialogue: 0,0:03:27.49,0:03:30.16,Default,,0,0,0,,Ең төменгі мөлшерлеме 100 лирадан басталады...
Dialogue: 0,0:03:30.29,0:03:32.17,Default,,0,0,0,,<Като-кун, мүмкін жаңадан түлек...>
Dialogue: 0,0:03:32.29,0:03:34.79,Default,,0,0,0,,Бұл Шигеру-сан болды, солай ма?
Dialogue: 0,0:03:34.92,0:03:37.05,Default,,0,0,0,,Оққағар Иә
Dialogue: 0,0:03:37.55,0:03:39.67,Default,,0,0,0,,Сізге қалай ұнайды? Ойын үшін
Dialogue: 0,0:03:39.80,0:03:43.93,Default,,0,0,0,,<Сейка-сан ақпаратты тастамағаны үшін маған келдің бе? ＞
Dialogue: 0,0:03:44.26,0:03:47.56,Default,,0,0,0,,Хмм, менде ақша жоқ.
Dialogue: 0,0:03:48.01,0:03:51.81,Default,,0,0,0,,<Skill activation super vision динамикалық көруді түзету>
Dialogue: 0,0:03:52.35,0:03:55.23,Default,,0,0,0,,<Қосымша ақпаратты нүкте бойынша қосу>
Dialogue: 0,0:03:55.65,0:03:57.94,Default,,0,0,0,,<Ол Абсолюттік Құдайдың көзіне толығымен көрінеді.>
Dialogue: 0,0:03:58.07,0:04:00.69,Default,,0,0,0,,Сонда да оның дене бітімі тамаша...
Dialogue: 0,0:04:00.82,0:04:02.70,Default,,0,0,0,,Бұл өте күшті емес пе?
Dialogue: 0,0:04:02.82,0:04:05.07,Default,,0,0,0,,Жақсы, деңгейі орынды.
Dialogue: 0,0:04:05.20,0:04:06.45,Default,,0,0,0,,70-тен көп пе?
Dialogue: 0,0:04:06.83,0:04:08.29,Default,,0,0,0,,<Өтірік айтпа>
Dialogue: 0,0:04:08.41,0:04:10.33,Default,,0,0,0,,<Мен мұны сатушы болған кезімде өсірдім>
Dialogue: 0,0:04:10.45,0:04:14.46,Default,,0,0,0,,<Растау немесе бас тарту ретінде қабылдануы мүмкін түсініксіз және күрделі жауап>
Dialogue: 0,0:04:14.79,0:04:17.00,Default,,0,0,0,,Хмм, сіз қалай ойлайсыз?
Dialogue: 0,0:04:17.13,0:04:20.26,Default,,0,0,0,,Бірақ мәртебе жоғары баға емес пе?
Dialogue: 0,0:04:20.42,0:04:22.72,Default,,0,0,0,,Параметрлерді дұрыс таратқаннан кейін
Dialogue: 0,0:04:22.84,0:04:24.80,Default,,0,0,0,,Нөлдер көп.
Dialogue: 0,0:04:24.93,0:04:26.43,Default,,0,0,0,,Сиқырлы қорғаныс т.б.
Dialogue: 0,0:04:26.68,0:04:29.97,Default,,0,0,0,,<Өтірік айтпаймын, нөлдердің көп екені рас>
Dialogue: 0,0:04:30.35,0:04:34.10,Default,,0,0,0,,Бұл асыл, сен жауынгер типсің.
Dialogue: 0,0:04:34.23,0:04:36.23,Default,,0,0,0,,<Иә, мен нағыз күрескермін>
Dialogue: 0,0:04:38.86,0:04:41.78,Default,,0,0,0,,<Уау, бұл өте өрескел...>
Dialogue: 0,0:04:41.90,0:04:44.74,Default,,0,0,0,,Магистр № 48...
Dialogue: 0,0:04:45.95,0:04:49.70,Default,,0,0,0,,Құрметті Сейка, кешіріңіз, бірақ мен осылай істеп жатырмын.
Dialogue: 0,0:04:49.83,0:04:50.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:50.74,0:04:52.66,Default,,0,0,0,,Сейка-сама қаласа
Dialogue: 0,0:04:52.83,0:04:55.87,Default,,0,0,0,,Мен сені өмір сүретін жерге апарамын.
Dialogue: 0,0:04:56.00,0:05:00.13,Default,,0,0,0,,Мысалы, құбыжық шайқасы
Dialogue: 0,0:05:00.59,0:05:03.13,Default,,0,0,0,,Иә, қаласа барамын.
Dialogue: 0,0:05:03.34,0:05:05.68,Default,,0,0,0,,...
Dialogue: 0,0:05:10.51,0:05:12.81,Default,,0,0,0,,Қалғандарын Като алып жүреді.
Dialogue: 0,0:05:12.93,0:05:16.23,Default,,0,0,0,,Тек бұйрық беріңіз. Өтінемін, тапсырысыңызды беріңізші!
Dialogue: 0,0:05:16.35,0:05:18.27,Default,,0,0,0,,<Жақсысың ба, Катокун?>
Dialogue: 0,0:05:18.65,0:05:20.82,Default,,0,0,0,,Сонымен, сіз ұсынатын ойындар бар ма?
Dialogue: 0,0:05:20.94,0:05:22.44,Default,,0,0,0,,А, иә, дұрыс...
Dialogue: 0,0:05:22.57,0:05:24.24,Default,,0,0,0,,Баккара туралы не айтасыз? (Сакурайдың күлкісі)
Dialogue: 0,0:05:24.40,0:05:26.03,Default,,0,0,0,,Баккара? иә?
Dialogue: 0,0:05:26.15,0:05:27.74,Default,,0,0,0,,Гехахаха~ (Әйелдердің күлкісі)
Dialogue: 0,0:05:27.95,0:05:29.28,Default,,0,0,0,,<Гах! ＞
Dialogue: 0,0:05:29.41,0:05:32.70,Default,,0,0,0,,<Таныс, дәлірек айтсақ, компанияның құлы болған күндерімдегі бастығым сияқты>
Dialogue: 0,0:05:33.04,0:05:36.50,Default,,0,0,0,,<Ол емес екеніне сенімдімін, бірақ оның жүрегіне тым ауыр...>
Dialogue: 0,0:05:36.75,0:05:37.54,Default,,0,0,0,,<Хмм? ＞
Dialogue: 0,0:05:39.54,0:05:41.04,Default,,0,0,0,,<«Азат ету жоспары»? ＞
Dialogue: 0,0:05:42.46,0:05:45.55,Default,,0,0,0,,(Сакурай мен оның достарының күлкісі)
Dialogue: 0,0:05:45.80,0:05:48.80,Default,,0,0,0,,Баккарада дилер бәрін жасай ма?
Dialogue: 0,0:05:49.01,0:05:52.51,Default,,0,0,0,,Иә, тұтынушылар екінің бірін таңдай алады.
Dialogue: 0,0:05:52.68,0:05:55.18,Default,,0,0,0,,Сіз карточкаларды өзіңіз салмайсыз ба?
Dialogue: 0,0:05:55.35,0:05:58.81,Default,,0,0,0,,Не? Сонымен банкир мен ойыншы бар...
Dialogue: 0,0:05:58.94,0:06:00.36,Default,,0,0,0,,Мен ережелерді түсінемін
Dialogue: 0,0:06:00.48,0:06:02.61,Default,,0,0,0,,Оның қаншалықты қызықты екенін айтқым келеді!
Dialogue: 0,0:06:02.73,0:06:05.44,Default,,0,0,0,,<Жарайды, Като-кунды одан бетер қиындатып жіберейік.>
Dialogue: 0,0:06:06.24,0:06:09.74,Default,,0,0,0,,<Сейка-санның міндеті - ақшаны ысырап етпей ұзақ тұру>
Dialogue: 0,0:06:09.87,0:06:12.70,Default,,0,0,0,,<Олардан Даданы илеуді жалғастыруды сұраңыз>
Dialogue: 0,0:06:12.95,0:06:14.95,Default,,0,0,0,,<Мен бұл мүмкіндікті пайдаландым...>
Dialogue: 0,0:06:16.58,0:06:18.58,Default,,0,0,0,,Уф, мен кенеттен аштық сезіндім (асқазанның түсіп кеткен дыбысы)
Dialogue: 0,0:06:18.71,0:06:20.96,Default,,0,0,0,,Кешіріңіз, дәретхана қайда?
Dialogue: 0,0:06:21.29,0:06:22.50,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:06:22.63,0:06:25.67,Default,,0,0,0,,Қазірдің өзінде! менің сұрағыма жауап бересіз!
Dialogue: 0,0:06:25.80,0:06:26.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:27.05,0:06:28.93,Default,,0,0,0,,Кешіріңіз, өтінемін.
Dialogue: 0,0:06:33.60,0:06:36.98,Default,,0,0,0,,Аа, мм, осындай кездер...
Dialogue: 0,0:06:39.27,0:06:40.48,Default,,0,0,0,,А...
Dialogue: 0,0:06:44.61,0:06:45.82,Default,,0,0,0,,<Трансформация>
Dialogue: 0,0:06:50.82,0:06:52.87,Default,,0,0,0,,<Мырза. Кажита... Ах! ＞
Dialogue: 0,0:06:53.37,0:06:54.37,Default,,0,0,0,,< Міне! ＞
Dialogue: 0,0:06:59.54,0:07:01.63,Default,,0,0,0,,<Жарайды, сәтті шабуыл>
Dialogue: 0,0:07:01.88,0:07:04.13,Default,,0,0,0,,<Сейка-сан қалай...>
Dialogue: 0,0:07:04.42,0:07:06.59,Default,,0,0,0,,<Әртүрлі ғарыш сиқыры Басқа Габе>
Dialogue: 0,0:07:07.17,0:07:09.88,Default,,0,0,0,,<Егер бірдеңе болып қалса, сіз бұл кеңістік арқылы асыға аласыз>
Dialogue: 0,0:07:10.59,0:07:12.89,Default,,0,0,0,,<Абсолюттік құдайдан күткендей>
Dialogue: 0,0:07:15.85,0:07:17.60,Default,,0,0,0,,<Бәрібір...>
Dialogue: 0,0:07:18.10,0:07:20.35,Default,,0,0,0,,<Бұл қандай кеңістік? ＞
Dialogue: 0,0:07:26.27,0:07:28.61,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:07:28.74,0:07:30.78,Default,,0,0,0,,Жоспарлар бірқалыпты орындалуда
Dialogue: 0,0:07:31.86,0:07:34.78,Default,,0,0,0,,<Жігіттер үнемі осылай айтатынсыңдар>
Dialogue: 0,0:07:34.91,0:07:38.29,Default,,0,0,0,,<Бұл дүниеде ақшадан да маңызды нәрселер бар>
Dialogue: 0,0:07:38.83,0:07:41.58,Default,,0,0,0,,<Біз ешқашан бай болған емеспіз>
Dialogue: 0,0:07:41.75,0:07:46.29,Default,,0,0,0,,＜Сонда да сен маған адалдықпен өмір сүру бақытын үйреттің＞
Dialogue: 0,0:07:46.67,0:07:49.84,Default,,0,0,0,,Мен сізді құрметтедім
Dialogue: 0,0:07:49.96,0:07:51.55,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:07:52.55,0:07:55.39,Default,,0,0,0,,<Көшіру туралы өтінішті орындамағаны үшін>
Dialogue: 0,0:07:55.51,0:07:58.97,Default,,0,0,0,,<Жылжымайтын мүлік компаниясы мен жер салушы бірге жұмыс істейді>
Dialogue: 0,0:07:59.10,0:08:01.39,Default,,0,0,0,,<Бәрі...>
Dialogue: 0,0:08:01.98,0:08:05.36,Default,,0,0,0,,<Сараңдыққа жамылған байлар>
Dialogue: 0,0:08:05.65,0:08:09.48,Default,,0,0,0,,<Оларды жоюға бірнеше жыл қажет болды>
Dialogue: 0,0:08:09.69,0:08:14.07,Default,,0,0,0,,<Бәрін істеп, өмірімді аяқтамақ болған сол сәт>
Dialogue: 0,0:08:14.91,0:08:15.82,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,0:08:18.33,0:08:23.04,Default,,0,0,0,,<Сен мені шақырғанда менде солай болды>
Dialogue: 0,0:08:23.16,0:08:26.08,Default,,0,0,0,,<Бірақ бұл әлемде мен де болдым>
Dialogue: 0,0:08:26.21,0:08:30.09,Default,,0,0,0,,<Байлар әлсізді таптайтын әділетсіз дүние>
Dialogue: 0,0:08:30.21,0:08:33.17,Default,,0,0,0,,Ақша адам жанын ластайды
Dialogue: 0,0:08:33.38,0:08:36.59,Default,,0,0,0,,Нашар жан тазару керек.
Dialogue: 0,0:08:36.97,0:08:40.81,Default,,0,0,0,,Жазалау және азап шегу арқылы босату.
Dialogue: 0,0:08:40.93,0:08:43.10,Default,,0,0,0,,Бұл менің миссиям
Dialogue: 0,0:08:43.44,0:08:44.48,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:44.98,0:08:47.69,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:08:47.81,0:08:51.74,Default,,0,0,0,,<Байдан кек алу - енді өмір сүрудің жалғыз себебі...>
Dialogue: 0,0:08:51.86,0:08:53.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:56.16,0:08:57.99,Default,,0,0,0,,Ұстаз, кешіріңіз.
Dialogue: 0,0:08:58.16,0:09:01.83,Default,,0,0,0,,Негізі мен Сейка-саманың қайтып келетінін айта бастадым...
Dialogue: 0,0:09:02.00,0:09:03.12,Default,,0,0,0,,А? (Като) Ах!
Dialogue: 0,0:09:03.71,0:09:05.62,Default,,0,0,0,,<Бұл... «Бұл жерде қызықсыз және мағынасыз»>
Dialogue: 0,0:09:05.75,0:09:08.38,Default,,0,0,0,,<"Сіз мені дұрыс алып жүрмегеніңіз үшін"...>
Dialogue: 0,0:09:08.67,0:09:10.13,Default,,0,0,0,,Хмф, кішкентай қыз.
Dialogue: 0,0:09:10.42,0:09:12.51,Default,,0,0,0,,Біз бұрыштарды кесіп жатқан жоқпыз! Бұл рас!
Dialogue: 0,0:09:12.67,0:09:15.84,Default,,0,0,0,,<Мен үмітсізмін, өйткені өтірік пен алдау жұмыс істемейді.>
Dialogue: 0,0:09:15.97,0:09:20.39,Default,,0,0,0,,Жас ханым ерекше жоғары көрсеткіштен қашып тұр.
Dialogue: 0,0:09:20.60,0:09:25.60,Default,,0,0,0,,Тәтті шырынды аздап соруға рұқсат етсеңіз, ол өзегіне ілінеді.
Dialogue: 0,0:09:25.73,0:09:28.98,Default,,0,0,0,,Тактика Он үшінші! Міндетті түрде құлаңыз!
Dialogue: 0,0:09:29.27,0:09:30.27,Default,,0,0,0,,Иә! (Игашира) Иә!
Dialogue: 0,0:09:31.36,0:09:32.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:32.61,0:09:33.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:33.69,0:09:35.32,Default,,0,0,0,,Сәлем, Игашира
Dialogue: 0,0:09:35.49,0:09:38.49,Default,,0,0,0,,Жоспардың не екенін нақты білесіз бе?
Dialogue: 0,0:09:38.62,0:09:40.16,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:09:40.37,0:09:42.62,Default,,0,0,0,,Мен өтірік айта алмаймын!
Dialogue: 0,0:09:42.74,0:09:46.00,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,0:09:50.29,0:09:52.75,Default,,0,0,0,,<Адамдарды мумияға айналдырайық! ＞
Dialogue: 0,0:09:54.09,0:09:55.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:56.72,0:09:57.55,Default,,0,0,0,,Эй
Dialogue: 0,0:09:58.26,0:09:59.30,Default,,0,0,0,,Маған қоңырау шалыңыз ба?
Dialogue: 0,0:09:59.47,0:10:01.39,Default,,0,0,0,,Сол қоқысты тазалаңыз.
Dialogue: 0,0:10:01.51,0:10:02.81,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:10:04.06,0:10:06.27,Default,,0,0,0,,(темекі түтінінің дыбысы)
Dialogue: 0,0:10:09.15,0:10:09.94,Default,,0,0,0,,Йо Като
Dialogue: 0,0:10:10.15,0:10:11.52,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:10:11.65,0:10:15.74,Default,,0,0,0,,Игашира өтірік айтқандықтан қоқысқа айналды.
Dialogue: 0,0:10:16.65,0:10:18.11,Default,,0,0,0,,Теме туралы не деуге болады?
Dialogue: 0,0:10:18.24,0:10:22.91,Default,,0,0,0,,Сіздің бұрынғы «иә» жауабыңыз стратегияны білуге ​​негізделген бе?
Dialogue: 0,0:10:23.45,0:10:26.83,Default,,0,0,0,,Тактика Он үшінші Бүгін мен жеңуге рұқсат етіңіз.
Dialogue: 0,0:10:27.66,0:10:31.33,Default,,0,0,0,,<Бұл оларға жоғары тарифтердің дәмін үйрету және оларды ойынға қызықтыру стратегиясы>
Dialogue: 0,0:10:31.46,0:10:32.84,Default,,0,0,0,,Като Йо!
Dialogue: 0,0:10:32.96,0:10:35.09,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:10:35.21,0:10:36.26,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:36.38,0:10:39.43,Default,,0,0,0,,Сен мен саған үйреткен кезде есте сақтайтын адамсың.
Dialogue: 0,0:10:39.55,0:10:41.34,Default,,0,0,0,,Мұны есте сақтаңыз.
Dialogue: 0,0:10:41.72,0:10:45.35,Default,,0,0,0,,<Мойынсұнғыш серіктестік жануарларын дәл осылай жасау керек>
Dialogue: 0,0:10:46.77,0:10:50.35,Default,,0,0,0,,<Енді, кейбір ақпарат расталды>
Dialogue: 0,0:10:50.69,0:10:54.86,Default,,0,0,0,,<Мырза. Кажитаның мақсаты - байларды жазалап, босату>
Dialogue: 0,0:10:55.69,0:10:58.49,Default,,0,0,0,,<Каджита мырзаға өтірік айтсаң, мумияланып кетесің>
Dialogue: 0,0:10:59.36,0:11:03.87,Default,,0,0,0,,<Жұмыс туралы ақпаратта айтылған қоқысты тазалау мәйітті жоюға қатысты>
Dialogue: 0,0:11:08.50,0:11:10.21,Default,,0,0,0,,Қызыл 23…
Dialogue: 0,0:11:10.33,0:11:13.46,Default,,0,0,0,,Сейка-сама жеңді (Сейка) Охохохохо~
Dialogue: 0,0:11:13.71,0:11:16.30,Default,,0,0,0,,<Мен біреудің өлгенін бірінші рет көріп тұрмын>
Dialogue: 0,0:11:16.42,0:11:18.80,Default,,0,0,0,,<Дәмі соншалықты нашар...>
Dialogue: 0,0:11:18.92,0:11:21.34,Default,,0,0,0,,<Мырза. Кажита мұны ойланбастан жасады...>
Dialogue: 0,0:11:21.47,0:11:22.76,Default,,0,0,0,,Шигеру-сан! Ах
Dialogue: 0,0:11:23.14,0:11:26.01,Default,,0,0,0,,Мен жеңсем де, сен көрмедің бе?
Dialogue: 0,0:11:26.31,0:11:28.02,Default,,0,0,0,,Мен тіпті қатарынан 6 ойында жеңіске жеттім!
Dialogue: 0,0:11:28.18,0:11:30.89,Default,,0,0,0,,Кешіріңіз. Сіз қанша жеңдіңіз?
Dialogue: 0,0:11:31.19,0:11:32.56,Default,,0,0,0,,Шамамен 2 миллион лир!
Dialogue: 0,0:11:32.69,0:11:34.19,Default,,0,0,0,,<Уау, бұл керемет>
Dialogue: 0,0:11:34.31,0:11:37.86,Default,,0,0,0,,Құрметті Сейка, сізге барлық соманы бір ұпайға қоюдың қажеті жоқ...
Dialogue: 0,0:11:37.98,0:11:40.40,Default,,0,0,0,,Менің принциптерім! (Като) А, аа...
Dialogue: 0,0:11:40.53,0:11:42.20,Default,,0,0,0,,<Еңбегіңіз үшін рахмет>
Dialogue: 0,0:11:42.32,0:11:44.78,Default,,0,0,0,,<Сейка-санның бәс тігу тәсілі: егер ол жеңілсе, жеңіледі...>
Dialogue: 0,0:11:45.24,0:11:48.54,Default,,0,0,0,,<Стратегияны жүзеге асырудың жалғыз жолы - жеңісті жалғастыру>
Dialogue: 0,0:11:48.83,0:11:51.00,Default,,0,0,0,,Келесі жолы мен сандарға бәс тігемін!
Dialogue: 0,0:11:51.12,0:11:53.08,Default,,0,0,0,,36 есе жақсы
Dialogue: 0,0:11:53.25,0:11:54.83,Default,,0,0,0,,Иә, у-о
Dialogue: 0,0:11:55.21,0:11:57.05,Default,,0,0,0,,<Каджита мырзаға есеп беру...>
Dialogue: 0,0:11:57.67,0:12:02.55,Default,,0,0,0,,<Солай болса да, казино монеталары «1/10 000 депозит мөлшерлемесін» көрсетпейді>
Dialogue: 0,0:12:03.68,0:12:06.30,Default,,0,0,0,,<Ақша болмаса, қауіпсіз бе? ＞
Dialogue: 0,0:12:08.51,0:12:11.31,Default,,0,0,0,,Шигеру-сан, сен тағы да ессіз қалдың ба?
Dialogue: 0,0:12:11.60,0:12:12.89,Default,,0,0,0,,А, жай...
Dialogue: 0,0:12:13.14,0:12:16.31,Default,,0,0,0,,Ендеше, бұл таңқаларлық емес пе!
Dialogue: 0,0:12:16.65,0:12:18.27,Default,,0,0,0,,Кажита мырза
Dialogue: 0,0:12:19.69,0:12:21.19,Default,,0,0,0,,Жеңіс көп
Dialogue: 0,0:12:21.32,0:12:23.82,Default,,0,0,0,,Сәтті көре алатын өткір көзі бар.
Dialogue: 0,0:12:24.07,0:12:26.87,Default,,0,0,0,,Мен сені тапқанда менің көзімде жындылық болмады
Dialogue: 0,0:12:26.99,0:12:28.37,Default,,0,0,0,,О хо хо хо
Dialogue: 0,0:12:28.49,0:12:30.33,Default,,0,0,0,,<Мырза. Каджита мені ұрды>
Dialogue: 0,0:12:30.45,0:12:32.29,Default,,0,0,0,,Қалай ойлайсың, Сейка-сама?
Dialogue: 0,0:12:32.41,0:12:35.33,Default,,0,0,0,,Қолайлы ойын қызықтырады ма?
Dialogue: 0,0:12:35.63,0:12:37.25,Default,,0,0,0,,Қолайлы ойын?
Dialogue: 0,0:12:37.38,0:12:39.50,Default,,0,0,0,,Тариф қайтадан көтеріле ме?
Dialogue: 0,0:12:39.63,0:12:42.05,Default,,0,0,0,,Бұл бәрі емес (Seika) Иә?
Dialogue: 0,0:12:42.17,0:12:45.18,Default,,0,0,0,,Ойынның өзі арнайы шығарылым болады.
Dialogue: 0,0:12:45.30,0:12:48.93,Default,,0,0,0,,Сахна қосымша кезеңнен әлдеқайда артта...
Dialogue: 0,0:12:49.06,0:12:52.10,Default,,0,0,0,,Бұл Колизей.
Dialogue: 0,0:12:54.85,0:12:56.10,Default,,0,0,0,,(лифттің келу дыбысы)
Dialogue: 0,0:12:59.40,0:13:00.98,Default,,0,0,0,,(Аңның ырылдауы)
Dialogue: 0,0:13:01.15,0:13:02.36,Default,,0,0,0,,<Үрілу? ＞
Dialogue: 0,0:13:02.53,0:13:03.86,Default,,0,0,0,,(Жын-шайтанның айқайы)
Dialogue: 0,0:13:04.03,0:13:04.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:04.95,0:13:06.45,Default,,0,0,0,,Құбыжық шайқасы
Dialogue: 0,0:13:06.57,0:13:09.78,Default,,0,0,0,,Бұл басқа еш жерден таба алмайтын ерекше ойын.
Dialogue: 0,0:13:09.91,0:13:13.50,Default,,0,0,0,,Құбыжық шайқасы... Мен осында соғысайын ба?
Dialogue: 0,0:13:14.00,0:13:17.42,Default,,0,0,0,,Бұл мүмкін, бірақ мен оны ұсынбаймын.
Dialogue: 0,0:13:17.71,0:13:22.21,Default,,0,0,0,,Бұл құбыжықтар сен үшін өз өмірімен күреседі.
Dialogue: 0,0:13:22.34,0:13:26.26,Default,,0,0,0,,Өміріңді қияға салатын қандай шайқас?
Dialogue: 0,0:13:26.47,0:13:29.97,Default,,0,0,0,,Бұл сезім жаңа есік ашылғандай.
Dialogue: 0,0:13:32.10,0:13:33.43,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:33.73,0:13:36.98,Default,,0,0,0,,Әй, құбыжық кешірші.
Dialogue: 0,0:13:37.10,0:13:40.69,Default,,0,0,0,,Уайымдама, бұл мойынсұнғыш сияқты.
Dialogue: 0,0:13:41.77,0:13:44.44,Default,,0,0,0,,Мына сиқырлы аңды қайда әкелдің?
Dialogue: 0,0:13:44.57,0:13:46.57,Default,,0,0,0,,Сыртта мен көрмеген ештеңе сияқты...
Dialogue: 0,0:13:46.70,0:13:48.28,Default,,0,0,0,,Сақ болыңыз
Dialogue: 0,0:13:48.41,0:13:52.79,Default,,0,0,0,,Бұл жігіттер біздің казино синтездеген ерекше құбыжықтар.
Dialogue: 0,0:13:53.16,0:13:54.16,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:54.62,0:13:55.91,Default,,0,0,0,,<Қосылды! ＞
Dialogue: 0,0:13:56.50,0:14:00.92,Default,,0,0,0,,Құрметті Сейка, сіз жаңа есік ашқыңыз келе ме?
Dialogue: 0,0:14:01.25,0:14:02.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:02.75,0:14:04.55,Default,,0,0,0,,<Бұл жерде уақыт болды.>
Dialogue: 0,0:14:04.84,0:14:06.34,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:14:06.47,0:14:08.34,Default,,0,0,0,,Мен оны Сейджиге де көрсеткім келеді.
Dialogue: 0,0:14:08.47,0:14:09.72,Default,,0,0,0,,Сәлем Сейка-сан!
Dialogue: 0,0:14:09.89,0:14:10.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:10.89,0:14:12.51,Default,,0,0,0,,Сейджи мырза...
Dialogue: 0,0:14:12.64,0:14:16.06,Default,,0,0,0,,Сіз бұрын доспыз дедіңіз ғой, солай ма? Бай...
Dialogue: 0,0:14:16.18,0:14:17.06,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:14:17.27,0:14:19.31,Default,,0,0,0,,Мұны көріп таң қалуыңыз мүмкін
Dialogue: 0,0:14:19.52,0:14:21.44,Default,,0,0,0,,Мен сізге бірден айтқым келеді!
Dialogue: 0,0:14:22.23,0:14:23.15,Default,,0,0,0,,Хмм…
Dialogue: 0,0:14:23.36,0:14:25.94,Default,,0,0,0,,Кажита мырза, мен жақында үйге барамын.
Dialogue: 0,0:14:26.15,0:14:27.70,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:14:27.82,0:14:29.57,Default,,0,0,0,,Като, қоштасу
Dialogue: 0,0:14:29.74,0:14:31.07,Default,,0,0,0,,(Кёсукэ Хори) Егер әке кетіп қалса—
Dialogue: 0,0:14:31.45,0:14:34.45,Default,,0,0,0,,Келесі жолы достарыңызды өзіңізбен бірге алып келіңіз.
Dialogue: 0,0:14:35.66,0:14:38.92,Default,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:14:41.79,0:14:44.46,Default,,0,0,0,,Като мырза? Сол бет...
Dialogue: 0,0:14:44.71,0:14:46.59,Default,,0,0,0,,Мен аздап ебедеймін...
Dialogue: 0,0:14:46.76,0:14:49.05,Default,,0,0,0,,Бірақ бәрібір, кешіріңіз...
Dialogue: 0,0:14:49.18,0:14:51.72,Default,,0,0,0,,<Мен мұны маған Кажита мырза жасады деп айта алмаймын>
Dialogue: 0,0:14:51.97,0:14:53.51,Default,,0,0,0,,Сәл еңкейіңіз.
Dialogue: 0,0:14:53.64,0:14:54.47,Default,,0,0,0,,(Кёко) Қыз ба? (Юки) Ұл ба?
Dialogue: 0,0:14:57.60,0:14:59.64,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,0:15:00.10,0:15:01.48,Default,,0,0,0,,Қалпына келтіру сиқыры?
Dialogue: 0,0:15:01.60,0:15:03.48,Default,,0,0,0,,Енді ауырмайды ма?
Dialogue: 0,0:15:03.61,0:15:04.73,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:04.98,0:15:06.61,Default,,0,0,0,,Менен неге сұрадың...
Dialogue: 0,0:15:06.73,0:15:09.65,Default,,0,0,0,,Себебі мен керемет сиқыршымын!
Dialogue: 0,0:15:09.78,0:15:11.57,Default,,0,0,0,,Сейка-сан керемет (қол шапалақтау)
Dialogue: 0,0:15:11.70,0:15:13.07,Default,,0,0,0,,Сіз мені көбірек мақтай аласыз.
Dialogue: 0,0:15:13.20,0:15:14.62,Default,,0,0,0,,Ғажайып таңғажайып
Dialogue: 0,0:15:16.16,0:15:17.37,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:20.37,0:15:23.63,Default,,0,0,0,,Келесі қабатта монеталарды қолма-қол ақшаға айырбастайтын боласыз, солай ма?
Dialogue: 0,0:15:24.79,0:15:25.88,Default,,0,0,0,,Сейка-сама...
Dialogue: 0,0:15:26.46,0:15:29.13,Default,,0,0,0,,Қаш! Енді казиноға келмеңіз!
Dialogue: 0,0:15:29.47,0:15:31.13,Default,,0,0,0,,Като мырза?
Dialogue: 0,0:15:31.34,0:15:33.05,Default,,0,0,0,,(лифттің келу дыбысы)
Dialogue: 0,0:15:34.10,0:15:36.64,Default,,0,0,0,,Каджита мырза біздің өмірімізді алып жатыр!?
Dialogue: 0,0:15:36.76,0:15:37.56,Default,,0,0,0,,Иә
Dialogue: 0,0:15:37.68,0:15:41.89,Default,,0,0,0,,Бай тұтынушылар ғана емес, сонымен қатар көптеген әріптестер.
Dialogue: 0,0:15:42.15,0:15:45.23,Default,,0,0,0,,Шынымды айтсам, мен бұл жұмысты жек көретінмін және оған көмектесе алмадым.
Dialogue: 0,0:15:45.44,0:15:47.90,Default,,0,0,0,,Бірақ мен өлтірілуден қорқамын...
Dialogue: 0,0:15:49.32,0:15:52.57,Default,,0,0,0,,Ұстаз... Кажита мырзаның не істеп жатқанын білу.
Dialogue: 0,0:15:52.70,0:15:54.78,Default,,0,0,0,,Сонда да менің бағынудан басқа амалым қалмады.
Dialogue: 0,0:15:55.20,0:15:57.29,Default,,0,0,0,,Мен қорқақпын
Dialogue: 0,0:15:57.45,0:16:00.41,Default,,0,0,0,,Като-кун, сенің де қашуың керек.
Dialogue: 0,0:16:00.54,0:16:04.08,Default,,0,0,0,,Бастықтың сырын ашсаң, өміріңе қауіп төнеді...
Dialogue: 0,0:16:04.42,0:16:06.04,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:16:06.34,0:16:08.55,Default,,0,0,0,,Өйткені барлық ақпарат солардың қолында
Dialogue: 0,0:16:08.71,0:16:09.63,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:10.42,0:16:13.01,Default,,0,0,0,,Осы қабаттан артқы есіктен шығуға болады.
Dialogue: 0,0:16:13.18,0:16:16.18,Default,,0,0,0,,Казинолардың қараңғылығын сыртқы әлемге танытыңыз.
Dialogue: 0,0:16:16.39,0:16:18.56,Default,,0,0,0,,Бір күні батыр келсін
Dialogue: 0,0:16:18.68,0:16:19.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:19.60,0:16:22.94,Default,,0,0,0,,Осындай нәрселерді ұнататын батыр болса ғой...
Dialogue: 0,0:16:23.14,0:16:23.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:24.23,0:16:25.86,Default,,0,0,0,,<Иә~? ＞
Dialogue: 0,0:16:26.73,0:16:28.23,Default,,0,0,0,,<Иә!?>
Dialogue: 0,0:16:29.07,0:16:31.99,Default,,0,0,0,,Сен қаңғыбас батыр Әлдинсің!
Dialogue: 0,0:16:32.15,0:16:32.95,Default,,0,0,0,,Батыр?
Dialogue: 0,0:16:33.24,0:16:34.74,Default,,0,0,0,,Екеуің де амансыңдар ма?
Dialogue: 0,0:16:34.86,0:16:36.78,Default,,0,0,0,,Ах, Лидс мырза да, неге?
Dialogue: 0,0:16:36.91,0:16:37.70,Default,,0,0,0,,Фе!?
Dialogue: 0,0:16:37.83,0:16:42.41,Default,,0,0,0,,Егер мен жасырын болсам.
Dialogue: 0,0:16:42.66,0:16:44.46,Default,,0,0,0,,<Эмоциялар өлді>
Dialogue: 0,0:16:44.79,0:16:46.71,Default,,0,0,0,,Сіз шынымен батырсыз ба?
Dialogue: 0,0:16:47.00,0:16:47.84,Default,,0,0,0,,Иә
Dialogue: 0,0:16:47.96,0:16:50.59,Default,,0,0,0,,Мен осы казиноның менеджеріне балға түсіруге келдім.
Dialogue: 0,0:16:50.71,0:16:52.72,Default,,0,0,0,,Ол өте күшті!
Dialogue: 0,0:16:55.26,0:16:57.09,Default,,0,0,0,,Бір батыр болды!
Dialogue: 0,0:16:57.22,0:16:59.01,Default,,0,0,0,,Сіз қиын уақытты бастан өткерген болуыңыз керек.
Dialogue: 0,0:16:59.22,0:17:00.35,Default,,0,0,0,,<НаниКолле>
Dialogue: 0,0:17:00.56,0:17:01.97,Default,,0,0,0,,Бұл кім? Қандай әбігер!
Dialogue: 0,0:17:02.81,0:17:04.23,Default,,0,0,0,,Хо Тағы бір қызметкер келе жатыр!
Dialogue: 0,0:17:05.14,0:17:07.52,Default,,0,0,0,,Барлығыңыз баспалдақпен қонақ үйге көшіңіз.
Dialogue: 0,0:17:07.73,0:17:11.11,Default,,0,0,0,,Мен оларды тарту үшін залға қайтамын.
Dialogue: 0,0:17:11.40,0:17:12.40,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:17:12.53,0:17:14.36,Default,,0,0,0,,Рахмет, бұл сендіреді.
Dialogue: 0,0:17:17.24,0:17:18.62,Default,,0,0,0,,Иә!?
Dialogue: 0,0:17:19.74,0:17:22.12,Default,,0,0,0,,Като-сан, бұл рас па?
Dialogue: 0,0:17:22.33,0:17:23.33,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:23.45,0:17:27.96,Default,,0,0,0,,Егер сіз Каджитаға өтірік айтсаңыз, жаза ретінде сіздің қабілеттеріңіз бен өміріңіз жойылады.
Dialogue: 0,0:17:28.17,0:17:30.55,Default,,0,0,0,,Өтірікті әрқашан ашуға бола ма?
Dialogue: 0,0:17:30.71,0:17:32.21,Default,,0,0,0,,Менің көргенім...
Dialogue: 0,0:17:32.55,0:17:35.42,Default,,0,0,0,,Нысан қызыл болып жанып тұрған сияқты.
Dialogue: 0,0:17:35.59,0:17:37.39,Default,,0,0,0,,<Демек, бұл мүлдем өтірік>
Dialogue: 0,0:17:38.09,0:17:40.64,Default,,0,0,0,,Өтірік аз болса да сұрақ қойылмайды.
Dialogue: 0,0:17:40.76,0:17:43.02,Default,,0,0,0,,Айтқаныңызға абай болыңыз.
Dialogue: 0,0:17:43.14,0:17:44.68,Default,,0,0,0,,(лифттің келу дыбысы)
Dialogue: 0,0:17:49.11,0:17:50.40,Default,,0,0,0,,Сіз кімсіз!
Dialogue: 0,0:17:50.52,0:17:51.90,Default,,0,0,0,,Қару алып жүру
Dialogue: 0,0:17:52.07,0:17:53.36,Default,,0,0,0,,Като Не болды!
Dialogue: 0,0:17:53.48,0:17:55.53,Default,,0,0,0,,<Серпіліс жасауға мәжбүрлеуден басқа амал жоқ па...>
Dialogue: 0,0:17:56.03,0:17:57.20,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:57.36,0:18:00.03,Default,,0,0,0,,Тұтынушы! Өтінемін, дереу эвакуациялаңыз!
Dialogue: 0,0:18:00.87,0:18:03.12,Default,,0,0,0,,Жер асты құбыжықтарының жабайы болуы мүмкін!
Dialogue: 0,0:18:03.24,0:18:04.29,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:18:04.41,0:18:06.79,Default,,0,0,0,,(Тұтынушылардың үрейленетін дауыстары)
Dialogue: 0,0:18:06.91,0:18:09.04,Default,,0,0,0,,Тыныш, тыныш бол!
Dialogue: 0,0:18:09.96,0:18:11.21,Default,,0,0,0,,Әлде Като ма?
Dialogue: 0,0:18:11.34,0:18:13.71,Default,,0,0,0,,Асығыңыз! Клиенттеріңізді бағыттаңыз!
Dialogue: 0,0:18:15.05,0:18:16.22,Default,,0,0,0,,Жасайық
Dialogue: 0,0:18:16.34,0:18:20.51,Default,,0,0,0,,Менеджер жер асты аренасына шығу жоспарын дайындауы керек.
Dialogue: 0,0:18:20.68,0:18:22.18,Default,,0,0,0,,Азат ету жоспары?
Dialogue: 0,0:18:22.31,0:18:24.89,Default,,0,0,0,,Арам жанды алтынмен жазала
Dialogue: 0,0:18:25.02,0:18:27.44,Default,,0,0,0,,Бұл денеден босату туралы.
Dialogue: 0,0:18:27.77,0:18:29.90,Default,,0,0,0,,Сіз соншалықты зерттедіңіз бе... (Лифттің келген дыбысы)
Dialogue: 0,0:18:30.02,0:18:32.23,Default,,0,0,0,,Әй, Шимизу!
Dialogue: 0,0:18:32.77,0:18:34.19,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:18:34.36,0:18:36.07,Default,,0,0,0,,Басқа маршруттар бар ма?
Dialogue: 0,0:18:36.53,0:18:38.78,Default,,0,0,0,,Бұл жалғыз тікелей лифт
Dialogue: 0,0:18:39.03,0:18:40.57,Default,,0,0,0,,Қызметкерлер қазірдің өзінде бар...
Dialogue: 0,0:18:41.28,0:18:42.16,Default,,0,0,0,,Сәлем
Dialogue: 0,0:18:42.28,0:18:44.33,Default,,0,0,0,,Жоқ! <Ех! Сейка-сан!?＞
Dialogue: 0,0:18:44.54,0:18:45.62,Default,,0,0,0,,<Неге? ＞
Dialogue: 0,0:18:45.75,0:18:47.87,Default,,0,0,0,,Сіз кімсіз! (Сейка) А...
Dialogue: 0,0:18:48.04,0:18:51.21,Default,,0,0,0,,<Ал, Сэйджи-сан, мен оны мұндайды ешқашан көрген емеспін.>
Dialogue: 0,0:18:51.33,0:18:53.84,Default,,0,0,0,,Тынш... хмм...
Dialogue: 0,0:18:54.25,0:18:57.92,Default,,0,0,0,,Мен Элькаронмын, Күннің Әулиесі!
Dialogue: 0,0:18:58.05,0:19:00.59,Default,,0,0,0,,<Мороға Альдеан әсер етті! ＞
Dialogue: 0,0:19:00.76,0:19:03.30,Default,,0,0,0,,Эй, сен неге мұндасың...
Dialogue: 0,0:19:04.06,0:19:05.68,Default,,0,0,0,,Өйткені менде мүшелік билет бар!
Dialogue: 0,0:19:05.81,0:19:06.97,Default,,0,0,0,,<Олай емес>
Dialogue: 0,0:19:07.35,0:19:09.48,Default,,0,0,0,,Мен көмектесуге келдім.
Dialogue: 0,0:19:09.64,0:19:14.19,Default,,0,0,0,,Қара шашты қыз досына көмектесуімді өтінді.
Dialogue: 0,0:19:16.98,0:19:21.24,Default,,0,0,0,,Емдік күшін пайдалана аламын, мені өзіңізбен бірге алып кетіңізші.
Dialogue: 0,0:19:21.49,0:19:23.45,Default,,0,0,0,,Элкароне мырза...
Dialogue: 0,0:19:23.70,0:19:25.37,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:19:25.62,0:19:26.79,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:19:26.91,0:19:28.25,Default,,0,0,0,,Иә! (Сейка) Әй!
Dialogue: 0,0:19:28.83,0:19:31.42,Default,,0,0,0,,<Осы екеуінің толқын ұзындығы ұқсас па...>
Dialogue: 0,0:19:31.54,0:19:34.50,Default,,0,0,0,,Қызық көрінеді, мен де қосылайын.
Dialogue: 0,0:19:37.34,0:19:38.51,Default,,0,0,0,,<Қайсысы? ＞
Dialogue: 0,0:19:38.63,0:19:39.51,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:19:39.88,0:19:40.93,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:19:41.05,0:19:42.01,Default,,0,0,0,,<Сен кімсің! ＞
Dialogue: 0,0:19:42.39,0:19:44.39,Default,,0,0,0,,Біз оны жаңа ғана таптық.
Dialogue: 0,0:19:45.43,0:19:48.02,Default,,0,0,0,,Иә? Онда, мүмкін емес.
Dialogue: 0,0:19:48.18,0:19:51.39,Default,,0,0,0,,<Иә! Сіз өзіңіздің шынайы болмысыңызды жасырасыз ба? ＞
Dialogue: 0,0:19:51.60,0:19:53.23,Default,,0,0,0,,<Е, менің ағам осындай.>
Dialogue: 0,0:19:53.35,0:19:55.06,Default,,0,0,0,,Қару-жарақты қайдан аласыз?
Dialogue: 0,0:19:55.19,0:19:57.02,Default,,0,0,0,,<Цуккомидегі бірегей>
Dialogue: 0,0:19:57.23,0:19:59.03,Default,,0,0,0,,Қару жасау дағдысы
Dialogue: 0,0:19:59.15,0:20:01.40,Default,,0,0,0,,Керемет! Бұл менде жоқ өнер!
Dialogue: 0,0:20:01.53,0:20:04.03,Default,,0,0,0,,Керемет! Уау керемет! (Сэйджи) Керемет! Күрсін, бұл таңқаларлық!
Dialogue: 0,0:20:04.28,0:20:06.28,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:20:06.49,0:20:08.79,Default,,0,0,0,,Осыншама талап етсең, қарызға беремін.
Dialogue: 0,0:20:08.91,0:20:10.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:10.54,0:20:11.87,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:12.50,0:20:13.87,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:20:14.00,0:20:16.84,Default,,0,0,0,,Мен Әлдинмін, қаңғыбас батырмын.
Dialogue: 0,0:20:16.96,0:20:18.17,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:20:18.50,0:20:20.09,Default,,0,0,0,,Сіз маған қалағаныңызша қоңырау шала аласыз.
Dialogue: 0,0:20:20.21,0:20:22.55,Default,,0,0,0,,Аты жоқ немесе жасырын
Dialogue: 0,0:20:23.22,0:20:25.80,Default,,0,0,0,,Түсінікті! Сәлем, шайтан!
Dialogue: 0,0:20:25.93,0:20:26.76,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:26.89,0:20:29.06,Default,,0,0,0,,<Нөлдік бұралған нольбол>
Dialogue: 0,0:20:29.18,0:20:31.43,Default,,0,0,0,,<Сен ағаңның мағынасына тым сенімді болдың>
Dialogue: 0,0:20:32.35,0:20:33.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:33.94,0:20:35.69,Default,,0,0,0,,Барлығы, лифт бар!
Dialogue: 0,0:20:38.40,0:20:40.86,Default,,0,0,0,,Като мырза, қалғанын бізге қалдырыңыз.
Dialogue: 0,0:20:40.99,0:20:42.45,Default,,0,0,0,,Сіз эвакуациялауыңыз керек.
Dialogue: 0,0:20:42.57,0:20:43.82,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:44.03,0:20:45.03,Default,,0,0,0,,Като мырза
Dialogue: 0,0:20:45.16,0:20:47.53,Default,,0,0,0,,Менің куәгер болғаныңызды қалаймын.
Dialogue: 0,0:20:47.70,0:20:48.70,Default,,0,0,0,,А...
Dialogue: 0,0:20:48.83,0:20:51.58,Default,,0,0,0,,Бұл казиноның мемлекеттік мекемелерге де қатысы бар емес пе?
Dialogue: 0,0:20:51.70,0:20:55.17,Default,,0,0,0,,Әйтпесе, адамды отбасылық тіркеуден шығару мүмкін емес еді.
Dialogue: 0,0:20:55.79,0:20:58.96,Default,,0,0,0,,Бұл жерді бұзсаң, имозуру стилінде зұлымдық әшкере болады.
Dialogue: 0,0:20:59.09,0:21:02.59,Default,,0,0,0,,Дәлелдерді сол уақытқа қалдырғаныңызды қалаймын.
Dialogue: 0,0:21:02.72,0:21:05.47,Default,,0,0,0,,Иә, егер солай болса.
Dialogue: 0,0:21:09.10,0:21:11.27,Default,,0,0,0,,Сау болыңыз.
Dialogue: 0,0:21:21.23,0:21:23.36,Default,,0,0,0,,Бұдан былай сақ болыңыз
Dialogue: 0,0:21:23.61,0:21:24.70,Default,,0,0,0,,Кешкі ас ішейік пе? О…
Dialogue: 0,0:21:24.82,0:21:26.86,Default,,0,0,0,,Каджита мырзаны маған қалдырыңыз.
Dialogue: 0,0:21:26.99,0:21:28.45,Default,,0,0,0,,Мен сенің қашуыңа ешқашан жол бермеймін
Dialogue: 0,0:21:28.57,0:21:29.37,Default,,0,0,0,,Иә
Dialogue: 0,0:21:29.74,0:21:34.12,Default,,0,0,0,,<Ол байлардан басқа адамдарды өз мақсатына пайдаланады.>
Dialogue: 0,0:21:34.66,0:21:38.38,Default,,0,0,0,,<Мен аздаған өкініш пен кінәні сезбедім.>
Dialogue: 0,0:21:38.58,0:21:42.13,Default,,0,0,0,,<Өзгелерге сену жолын жоғалтқан адам баласының ақыры.>
Dialogue: 0,0:21:42.67,0:21:45.63,Default,,0,0,0,,<Като сияқты біреуден түбегейлі өзгеше>
Dialogue: 0,0:21:45.93,0:21:49.09,Default,,0,0,0,,<Оның өз ойын өзгертуге мүмкіндігі жоқ>
Dialogue: 0,0:21:50.85,0:21:53.52,Default,,0,0,0,,<Жақсы адамдарға Сейка-сан мен Сейджи-сан> (Сейка мен Сейджи сөйлеседі)
Dialogue: 0,0:21:53.64,0:21:55.14,Default,,0,0,0,,<Мүмкіндігінше онымен бетпе-бет келгім келмейді>
Dialogue: 0,0:21:55.27,0:21:56.64,Default,,0,0,0,,Ах
Dialogue: 0,0:21:57.39,0:21:59.15,Default,,0,0,0,,<Сонымен...>
Dialogue: 0,0:21:59.94,0:22:01.65,Default,,0,0,0,,<Мен барамын>
Dialogue: 0,0:22:06.78,0:22:09.87,Default,,0,0,0,,Ух... хахахаха...
Dialogue: 0,0:22:10.16,0:22:13.12,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.58,0:23:38.54,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.04,0:23:46.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory