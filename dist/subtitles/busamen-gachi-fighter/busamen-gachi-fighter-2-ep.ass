Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.87,0:00:02.66,Default,,0,0,0,,Маған басқа бума керек.
Dialogue: 0,0:00:03.25,0:00:05.33,Default,,0,0,0,,Мен баймын
Dialogue: 0,0:00:05.63,0:00:07.59,Default,,0,0,0,,Осыны айтқан соң...
Dialogue: 0,0:00:08.09,0:00:09.84,Default,,0,0,0,,<Ол әлдеқашан толы емес пе?>
Dialogue: 0,0:00:11.80,0:00:15.59,Default,,0,0,0,,<Мен өз шеберлігіммен жебелерді жаппай шығара аламын> (Сейканың гуілдеуі)
Dialogue: 0,0:00:16.30,0:00:18.68,Default,,0,0,0,,Шигеру-сан, сатып алмайсың ба?
Dialogue: 0,0:00:18.81,0:00:21.56,Default,,0,0,0,,А, сен кедейсің ғой, сатып ала алмайсың.
Dialogue: 0,0:00:21.68,0:00:22.81,Default,,0,0,0,,<Жылдам доп>
Dialogue: 0,0:00:23.19,0:00:25.48,Default,,0,0,0,,Мен жақсы баспана таптым.
Dialogue: 0,0:00:25.65,0:00:27.90,Default,,0,0,0,,Бүгін сонда бір түн болайық.
Dialogue: 0,0:00:28.15,0:00:31.86,Default,,0,0,0,,Мен оны асыға күтемін! Кенеттен...
Dialogue: 0,0:00:31.99,0:00:35.11,Default,,0,0,0,,Кешіріңіз, мен саябақтамын...
Dialogue: 0,0:00:35.57,0:00:38.37,Default,,0,0,0,,Жатқан жеріңді төлеймін!
Dialogue: 0,0:00:38.58,0:00:41.12,Default,,0,0,0,,Не? Бұл жақсы емес
Dialogue: 0,0:00:41.45,0:00:44.87,Default,,0,0,0,,Менің ысырапшылдығым саған ұнамайды ғой.
Dialogue: 0,0:00:45.00,0:00:47.38,Default,,0,0,0,,А, жоқ, олай емес.
Dialogue: 0,0:00:47.50,0:00:48.88,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:00:49.46,0:00:50.88,Default,,0,0,0,,Осы жолмен! Ха!
Dialogue: 0,0:00:51.67,0:00:54.13,Default,,0,0,0,,<Матадан сүртсем зақым бола ма?>
Dialogue: 0,0:00:54.80,0:00:57.14,Default,,0,0,0,,<Бірақ әйтеуір бәрі тәртіпсіз болып барады>
Dialogue: 0,0:00:58.05,0:01:00.93,Default,,0,0,0,,<Ол қауіпті және оны зұлым етуге болмайды>
Dialogue: 0,0:01:01.18,0:01:04.85,Default,,0,0,0,,<Маған жол көрсетер басшы болса...>
Dialogue: 0,0:01:06.10,0:01:09.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:29.94,0:02:32.90,Default,,0,0,0,,～♪
Dialogue: 0,0:02:36.78,0:02:37.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:44.95,0:02:49.08,Default,,0,0,0,,(Қыздың күлкісі)
Dialogue: 0,0:02:50.25,0:02:53.38,Default,,0,0,0,,<Менің бұдан артық қарызым жоқ>
Dialogue: 0,0:02:53.63,0:02:58.05,Default,,0,0,0,,<Мен қазір 1/10 000 депозит мөлшерлемесі бар тиынсызмын...>
Dialogue: 0,0:02:58.17,0:03:02.30,Default,,0,0,0,,<Сенімді табыс құралы болмаса, ақшаңыз тез таусылады>
Dialogue: 0,0:03:02.47,0:03:04.10,Default,,0,0,0,,<Егер ол кептеліп қалса...>
Dialogue: 0,0:03:04.51,0:03:07.35,Default,,0,0,0,,<Жағдайымыз өте нашар болатын сияқты>
Dialogue: 0,0:03:07.47,0:03:11.60,Default,,0,0,0,,<Осы дүниеден қашқым келгені сонша, мен кездесіп қалуым керек еді...>
Dialogue: 0,0:03:11.90,0:03:14.61,Default,,0,0,0,,<Енді не істеуіміз керек...>
Dialogue: 0,0:03:16.48,0:03:17.61,Default,,0,0,0,,(үстелге бірдеңе қойған дыбыс)
Dialogue: 0,0:03:17.90,0:03:19.57,Default,,0,0,0,,(ДжоДжо) Х… Ол менің киімімді жыртып, тікелей теріме еніп барады.
Dialogue: 0,0:03:19.90,0:03:23.24,Default,,0,0,0,,Өтінемін, мен өзім тамақ жей алмаймын.
Dialogue: 0,0:03:23.57,0:03:25.28,Default,,0,0,0,,Мен оны ала аламын ба?
Dialogue: 0,0:03:25.45,0:03:27.91,Default,,0,0,0,,Бұл шоколадты печенье! сүйкімді!
Dialogue: 0,0:03:28.04,0:03:29.75,Default,,0,0,0,,Шигеру-сан, бұл не?
Dialogue: 0,0:03:30.16,0:03:32.42,Default,,0,0,0,,Мейірімді адам берді.
Dialogue: 0,0:03:32.58,0:03:35.63,Default,,0,0,0,,Мен «соңғы пойыздағы компанияның құлына» еліктеуге тырыстым
Dialogue: 0,0:03:35.75,0:03:37.63,Default,,0,0,0,,Соңғы пойыз өлтіруші кит?
Dialogue: 0,0:03:37.96,0:03:40.55,Default,,0,0,0,,<Сіз білмейсіз бе? Сіз аңғалсыз.>
Dialogue: 0,0:03:40.76,0:03:42.13,Default,,0,0,0,,Осы сияқты...
Dialogue: 0,0:03:43.01,0:03:46.01,Default,,0,0,0,,Бұл... саған бірдеңе бергім келеді.
Dialogue: 0,0:03:46.76,0:03:50.48,Default,,0,0,0,,Бірақ сіз кедей болсаңыз, бұл оған тұрарлық дегенді білдірмейді.
Dialogue: 0,0:03:50.81,0:03:53.10,Default,,0,0,0,,Қиындық болса айтыңызшы, кім бай?
Dialogue: 0,0:03:53.23,0:03:54.15,Default,,0,0,0,,Сәлем Сәлем
Dialogue: 0,0:03:54.52,0:03:55.77,Default,,0,0,0,,Бұл дәмді
Dialogue: 0,0:03:55.94,0:03:57.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:57.86,0:04:00.57,Default,,0,0,0,,<Ал, мен оны сатып алдым.>
Dialogue: 0,0:04:00.69,0:04:03.16,Default,,0,0,0,,<Оны түсінгеннен кейін бұл қарапайым қулық>
Dialogue: 0,0:04:03.49,0:04:04.53,Default,,0,0,0,,<Бұл...>
Dialogue: 0,0:04:05.41,0:04:06.78,Default,,0,0,0,,<Бартер>
Dialogue: 0,0:04:07.37,0:04:09.95,Default,,0,0,0,,<Ең алдымен, жебелердің күлкілі мөлшерін жасау үшін дағдыны қолданыңыз>
Dialogue: 0,0:04:10.08,0:04:11.91,Default,,0,0,0,,<Оны қару дүкеніне апарыңыз>
Dialogue: 0,0:04:12.08,0:04:15.92,Default,,0,0,0,,<Ақшаның орнына өнім беріңіз, себебі мен тек 4 рет төлеуім керек>
Dialogue: 0,0:04:16.04,0:04:19.30,Default,,0,0,0,,<Жақсы, мен біраз іскерлік келіссөздер жүргіздім.>
Dialogue: 0,0:04:19.92,0:04:23.43,Default,,0,0,0,,<Бәрібір, Сейка-сан, мен бір қарызымды өтедім.>
Dialogue: 0,0:04:23.55,0:04:25.05,Default,,0,0,0,,Дәмді~
Dialogue: 0,0:04:25.97,0:04:27.93,Default,,0,0,0,,Қарын тоқ болғанда
Dialogue: 0,0:04:28.72,0:04:31.06,Default,,0,0,0,,Мен өзімнің келесі шытырман оқиғам туралы айтқым келеді.
Dialogue: 0,0:04:31.18,0:04:34.31,Default,,0,0,0,,Ал, мен қаланы көбірек зерттегім келеді.
Dialogue: 0,0:04:34.60,0:04:37.52,Default,,0,0,0,,Біріншіден, біз кірісті қамтамасыз етуіміз керек.
Dialogue: 0,0:04:37.86,0:04:40.48,Default,,0,0,0,,Өйткені құбыжық ақшаны түсірген жоқ...
Dialogue: 0,0:04:40.61,0:04:42.24,Default,,0,0,0,,<Оны байқадың ба?>
Dialogue: 0,0:04:42.36,0:04:43.78,Default,,0,0,0,,<Күтілгендей...>
Dialogue: 0,0:04:44.70,0:04:47.74,Default,,0,0,0,,Осы қаланың жанында үңгір бар сияқты.
Dialogue: 0,0:04:47.99,0:04:50.83,Default,,0,0,0,,Мен оны бүгін қарастырамын деп ойлаймын.
Dialogue: 0,0:04:50.99,0:04:53.50,Default,,0,0,0,,Үңгір! Көңілді сияқты
Dialogue: 0,0:04:53.62,0:04:55.62,Default,,0,0,0,,Бірақ бұл қауіпті...
Dialogue: 0,0:04:55.87,0:04:57.96,Default,,0,0,0,,Алғаның үңгіріне барасың ба?
Dialogue: 0,0:04:58.08,0:04:59.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:59.21,0:05:01.05,Default,,0,0,0,,Сізге навигациялық жүйе қажет емес пе?
Dialogue: 0,0:05:01.38,0:05:04.34,Default,,0,0,0,,Мен де сіз сияқты реинкарнацияланған адаммын.
Dialogue: 0,0:05:04.63,0:05:06.05,Default,,0,0,0,,<Реинкарнацияланған адам? ＞
Dialogue: 0,0:05:06.30,0:05:08.89,Default,,0,0,0,,Уау, сен өте...
Dialogue: 0,0:05:09.01,0:05:11.14,Default,,0,0,0,,<Иә, бұл Бусамен.>
Dialogue: 0,0:05:11.35,0:05:13.23,Default,,0,0,0,,Сенің жүзіңді бірінші рет көріп тұрмын
Dialogue: 0,0:05:13.35,0:05:15.23,Default,,0,0,0,,Сіз жаңа ғана «мұнда» келдіңіз, солай ма?
Dialogue: 0,0:05:16.19,0:05:17.23,Default,,0,0,0,,Иә
Dialogue: 0,0:05:17.65,0:05:19.73,Default,,0,0,0,,<Сэйджи абайлап отыр>
Dialogue: 0,0:05:19.98,0:05:22.07,Default,,0,0,0,,Сонда сіз мұны білесіз бе?
Dialogue: 0,0:05:22.19,0:05:23.94,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:24.28,0:05:26.36,Default,,0,0,0,,<Сейка-сан тым кінәсіз>
Dialogue: 0,0:05:26.82,0:05:29.62,Default,,0,0,0,,Бірінші бөрене үйден табылған зат.
Dialogue: 0,0:05:29.99,0:05:33.08,Default,,0,0,0,,Сіз тұру ақысына бір реттік жеңілдік ала аласыз.
Dialogue: 0,0:05:33.20,0:05:35.37,Default,,0,0,0,,Е, мен оны таппадым!
Dialogue: 0,0:05:35.50,0:05:37.50,Default,,0,0,0,,Әй, неткен ысырап.
Dialogue: 0,0:05:37.67,0:05:41.38,Default,,0,0,0,,Мен мұнымен айналысамын, сондықтан қабылдау бөліміне барып, ақшаңызды қайтарыңыз.
Dialogue: 0,0:05:41.50,0:05:42.63,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:42.75,0:05:44.46,Default,,0,0,0,,Эй... Сейка-сан!
Dialogue: 0,0:05:45.09,0:05:46.47,Default,,0,0,0,,Керемет!
Dialogue: 0,0:05:46.59,0:05:47.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:48.01,0:05:50.14,Default,,0,0,0,,Кешіріңіз, бірақ сіз
Dialogue: 0,0:05:50.55,0:05:51.97,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:05:52.18,0:05:53.85,Default,,0,0,0,,Мен Киоширомын
Dialogue: 0,0:05:54.02,0:05:57.39,Default,,0,0,0,,Мен сен сияқты жаңадан бастағандарға жол сілтейтін адаммын.
Dialogue: 0,0:05:57.98,0:06:00.40,Default,,0,0,0,,Мені жұмысқа алсаңыз, сізге көбірек жеңілдіктер беріледі.
Dialogue: 0,0:06:00.61,0:06:05.03,Default,,0,0,0,,<Тым күдікті... 10-ның 9-ы, бұл жаңадан бастаушы аң.>
Dialogue: 0,0:06:05.24,0:06:08.66,Default,,0,0,0,,<Егер бірдеңе болса, Құдайдың абсолютті құдіреті бар.>
Dialogue: 0,0:06:08.86,0:06:11.74,Default,,0,0,0,,<Мұны Сейджи-санға қалдырайық>
Dialogue: 0,0:06:12.12,0:06:14.16,Default,,0,0,0,,Ақша қымбат, бірақ...
Dialogue: 0,0:06:14.33,0:06:18.16,Default,,0,0,0,,Біліміңіз бен тәжірибеңізді жетілдіру Оны инвестиция ретінде қарастырыңыз...
Dialogue: 0,0:06:19.83,0:06:23.46,Default,,0,0,0,,Күніне 120 лира плюс табыс ақысы туралы не айтасыз?
Dialogue: 0,0:06:23.71,0:06:25.76,Default,,0,0,0,,Егер сіз шарттармен келісесіз
Dialogue: 0,0:06:25.88,0:06:27.80,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:06:29.09,0:06:30.64,Default,,0,0,0,,Ха! Ха!
Dialogue: 0,0:06:30.93,0:06:34.10,Default,,0,0,0,,Алғаның үңгіріне барайық!
Dialogue: 0,0:06:35.43,0:06:37.43,Default,,0,0,0,,(Гоблиндердің айқайы)
Dialogue: 0,0:06:37.68,0:06:39.73,Default,,0,0,0,,А, гоблин
Dialogue: 0,0:06:39.85,0:06:42.36,Default,,0,0,0,,Ммммммммммммммммммммммммммм
Dialogue: 0,0:06:44.44,0:06:45.98,Default,,0,0,0,,<Бірде-бір оқ тиген жоқ! ＞
Dialogue: 0,0:06:46.11,0:06:49.99,Default,,0,0,0,,Бұл Сейка-сан болды ма? Көрсеткілерді мұқият пайдаланыңыз.
Dialogue: 0,0:06:50.36,0:06:52.99,Default,,0,0,0,,Жарайды! Олардың саны өте көп
Dialogue: 0,0:06:53.16,0:06:54.03,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:06:54.16,0:06:57.12,Default,,0,0,0,,Дәлдікті одан да арттырған дұрыс.
Dialogue: 0,0:06:57.25,0:07:00.25,Default,,0,0,0,,Сол бір жебені 100 миллион иен деп ойлап, оны атыңыз.
Dialogue: 0,0:07:00.37,0:07:03.00,Default,,0,0,0,,Байларды да сақтыққа шақырады
Dialogue: 0,0:07:05.42,0:07:07.17,Default,,0,0,0,,<100 миллион иен…>
Dialogue: 0,0:07:07.84,0:07:08.88,Default,,0,0,0,,《Міне, басталды!》
Dialogue: 0,0:07:09.09,0:07:10.30,Default,,0,0,0,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,0:07:10.43,0:07:12.26,Default,,0,0,0,,Бұл өте жақсы сюжет.
Dialogue: 0,0:07:12.68,0:07:15.60,Default,,0,0,0,,Менде солай болды!
Dialogue: 0,0:07:15.76,0:07:18.81,Default,,0,0,0,,Ол қазір садақ ату үйірмесіндегі Шигеру-саннан асып түсті.
Dialogue: 0,0:07:18.93,0:07:20.52,Default,,0,0,0,,<Сіз байсалдысыз ба>
Dialogue: 0,0:07:20.89,0:07:22.19,Default,,0,0,0,,Кай-джин…
Dialogue: 0,0:07:22.31,0:07:24.06,Default,,0,0,0,,Иә (Сейка) Мен де!
Dialogue: 0,0:07:25.19,0:07:27.86,Default,,0,0,0,,<Таңғажайып, олар жақсы нұсқау беріп жатыр>
Dialogue: 0,0:07:28.03,0:07:30.57,Default,,0,0,0,,<Мен бизнестің иісін сезгенде, мен күдіктенемін>
Dialogue: 0,0:07:30.70,0:07:33.57,Default,,0,0,0,,<Бұрынғы сатушының мұңды мінезі.>
Dialogue: 0,0:07:33.70,0:07:36.20,Default,,0,0,0,,<Бұл дулыға да қарт ұсынған бұйым болатын>
Dialogue: 0,0:07:36.33,0:07:39.50,Default,,0,0,0,,<Оны бұрын келген реинкарнация жасаған адам жасаған сияқты.>
Dialogue: 0,0:07:39.79,0:07:43.33,Default,,0,0,0,,<Сейка-сан алға жүгіріп, 60 лирді канализацияға лақтырып жіберді>
Dialogue: 0,0:07:44.25,0:07:45.84,Default,,0,0,0,,<Гасшо>
Dialogue: 0,0:07:45.96,0:07:48.09,Default,,0,0,0,,(Сейджи мен қыздың жаттығу дауысы)
Dialogue: 0,0:07:48.92,0:07:51.38,Default,,0,0,0,,Сэйджи-сан, білегіңізді көбірек тұрақтандырыңыз.
Dialogue: 0,0:07:51.51,0:07:53.39,Default,,0,0,0,,Қарудың салмағымен кесіп көріңіз.
Dialogue: 0,0:07:53.64,0:07:55.01,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:07:55.60,0:07:58.97,Default,,0,0,0,,Қанжарды қолданғанда ұшын жұлып алғандай кескен дұрыс.
Dialogue: 0,0:07:59.22,0:08:02.02,Default,,0,0,0,,Өйткені жылдамдық пен жеңілдік оның күшті жақтары.
Dialogue: 0,0:08:02.19,0:08:03.85,Default,,0,0,0,,Иә, тәа!
Dialogue: 0,0:08:04.44,0:08:07.44,Default,,0,0,0,,Ei Ei Ei
Dialogue: 0,0:08:07.73,0:08:08.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:09.40,0:08:11.11,Default,,0,0,0,,Сіз қатыспайсыз ба?
Dialogue: 0,0:08:11.32,0:08:13.45,Default,,0,0,0,,Менде дұрыс дағдылар жоқ.
Dialogue: 0,0:08:13.78,0:08:15.45,Default,,0,0,0,,<Мен өтірік айтпадым>
Dialogue: 0,0:08:15.57,0:08:18.37,Default,,0,0,0,,Таяқпен тәжірибе ұпайларын көбейту қиын.
Dialogue: 0,0:08:18.54,0:08:21.41,Default,,0,0,0,,<Кешіріңіз, мен қазірдің өзінде 61-деңгеймін>
Dialogue: 0,0:08:21.58,0:08:23.50,Default,,0,0,0,,Көңіліңді түсірме
Dialogue: 0,0:08:23.67,0:08:26.79,Default,,0,0,0,,Таяқтың соңғы шеберлігі ғажап деген қауесет бар.
Dialogue: 0,0:08:27.09,0:08:28.17,Default,,0,0,0,,<Шынында...>
Dialogue: 0,0:08:29.46,0:08:33.59,Default,,0,0,0,,<Мен бүгін таңертең қала сыртына жебе жасауға шыққанда>
Dialogue: 0,0:08:35.76,0:08:38.64,Default,,0,0,0,,<Алып оркпен кездесу>
Dialogue: 0,0:08:38.76,0:08:42.85,Default,,0,0,0,,<Мен қызметкерлердің ең күшті шеберлігін байқаған кезде...>
Dialogue: 0,0:08:42.98,0:08:44.85,Default,,0,0,0,,О
Dialogue: 0,0:08:46.19,0:08:49.11,Default,,0,0,0,,<200 км радиус жоғалады! ＞
Dialogue: 0,0:08:49.69,0:08:52.49,Default,,0,0,0,,<Егер ол Сайтама префектурасында жүзеге асырылатын болса>
Dialogue: 0,0:08:52.69,0:08:55.53,Default,,0,0,0,,<Тынық мұхиты мен Жапон теңізі қосылады>
Dialogue: 0,0:08:56.07,0:08:58.37,Default,,0,0,0,,<Әрине мен оны бірден тоқтаттым>
Dialogue: 0,0:08:59.91,0:09:02.41,Default,,0,0,0,,Ұрысқа белсене қатысыңыз, жарай ма?
Dialogue: 0,0:09:02.58,0:09:05.21,Default,,0,0,0,,Әйтпесе мен сияқты зейнетке шығасың.
Dialogue: 0,0:09:05.42,0:09:06.58,Default,,0,0,0,,Зейнеткерлікке шығу?
Dialogue: 0,0:09:06.71,0:09:09.63,Default,,0,0,0,,Мен бұрын жалдамалы топтың мүшесі едім.
Dialogue: 0,0:09:10.75,0:09:15.63,Default,,0,0,0,,<Көшбасшы менің әріптесім еді, бірақ билік айырмашылығынан сүрініп, зейнетке шықтым>
Dialogue: 0,0:09:16.18,0:09:19.64,Default,,0,0,0,,<Сол дәуірдегі адам патша болып көтерілді>
Dialogue: 0,0:09:20.01,0:09:21.18,Default,,0,0,0,,<Қорқасың ба? ＞
Dialogue: 0,0:09:21.31,0:09:25.14,Default,,0,0,0,,<Деңгей шамамен 80 және параметрлері орташа 160>
Dialogue: 0,0:09:25.39,0:09:27.90,Default,,0,0,0,,<3 цифр!? Жоқ, әлсіз>
Dialogue: 0,0:09:28.02,0:09:30.44,Default,,0,0,0,,Ой, мен сені таң қалдырдым.
Dialogue: 0,0:09:30.65,0:09:33.90,Default,,0,0,0,,Жарайды, берілме, барыңды сал.
Dialogue: 0,0:09:34.57,0:09:36.20,Default,,0,0,0,,<Алға үңгірі>
Dialogue: 0,0:09:36.32,0:09:40.16,Default,,0,0,0,,<Таңқаларлықтай қызық көрінеді, қирандылар атмосферасымен.>
Dialogue: 0,0:09:40.28,0:09:41.99,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:09:42.12,0:09:43.29,Default,,0,0,0,,<Сейка-сан...>
Dialogue: 0,0:09:43.41,0:09:46.00,Default,,0,0,0,,<Қорқыныш және алға қадам жасамау>
Dialogue: 0,0:09:46.12,0:09:49.08,Default,,0,0,0,,Қол ұстасайық, ендеше бірге барайық. эй?
Dialogue: 0,0:09:49.21,0:09:50.54,Default,,0,0,0,,<Балалар?>
Dialogue: 0,0:09:50.96,0:09:52.17,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:52.55,0:09:56.09,Default,,0,0,0,,Керемет, бұл сталактит, солай емес пе?
Dialogue: 0,0:09:56.26,0:09:58.43,Default,,0,0,0,,Қауіпті! Құлап жатыр!
Dialogue: 0,0:09:58.80,0:09:59.93,Default,,0,0,0,,Боо…
Dialogue: 0,0:10:00.05,0:10:02.43,Default,,0,0,0,,<Сен неше жастасың>
Dialogue: 0,0:10:03.10,0:10:06.35,Default,,0,0,0,,Сейка мырза, сіздің жасыңызды сұрасам бола ма?
Dialogue: 0,0:10:06.56,0:10:09.35,Default,,0,0,0,,Стратегияны құрастыру керек деп ойлаймын.
Dialogue: 0,0:10:09.48,0:10:11.19,Default,,0,0,0,,<Жарайсың, Сэйджи-сан! ＞
Dialogue: 0,0:10:11.40,0:10:13.19,Default,,0,0,0,,Жасы?
Dialogue: 0,0:10:13.44,0:10:15.99,Default,,0,0,0,,Айтпақшы, жасым 30-ға таяп қалды.
Dialogue: 0,0:10:16.15,0:10:17.95,Default,,0,0,0,,<Иә~ Таңқаларлық~>
Dialogue: 0,0:10:18.11,0:10:19.78,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:10:20.03,0:10:23.20,Default,,0,0,0,,Негізі менің жасым 16-да емес.
Dialogue: 0,0:10:23.45,0:10:24.95,Default,,0,0,0,,<Олай емес пе?>
Dialogue: 0,0:10:25.25,0:10:26.66,Default,,0,0,0,,Мен 17 жастамын
Dialogue: 0,0:10:26.79,0:10:28.16,Default,,0,0,0,,<Сіз қалжыңдап тұрсыз ба? ＞
Dialogue: 0,0:10:29.00,0:10:30.58,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:10:30.71,0:10:34.17,Default,,0,0,0,,Қазір Pi 3 тілінде сабақ беріп жатқанымыз рас па?
Dialogue: 0,0:10:34.30,0:10:36.71,Default,,0,0,0,,Негізгі 3.14
Dialogue: 0,0:10:36.88,0:10:39.34,Default,,0,0,0,,Шамамен, жақсы болғанда 3 болады.
Dialogue: 0,0:10:39.63,0:10:41.43,Default,,0,0,0,,Did you prepare for entrance exams?
Dialogue: 0,0:10:41.55,0:10:44.39,Default,,0,0,0,,Иә, бұл негізінен А бағасы болды.
Dialogue: 0,0:10:44.68,0:10:46.98,Default,,0,0,0,,<Жай ғана оқуға болатын сияқты>
Dialogue: 0,0:10:47.10,0:10:49.89,Default,,0,0,0,,<Мен сәл жеңілдеп қалдым, жас ханым...>
Dialogue: 0,0:10:51.73,0:10:56.07,Default,,0,0,0,,<Ол жерден бізге Киоширо мырза басшылық етті...>
Dialogue: 0,0:10:56.69,0:10:57.90,Default,,0,0,0,,(ұшатын түлкі жылайды)
Dialogue: 0,0:10:58.03,0:11:00.36,Default,,0,0,0,,<Ұшатын түлкімен соғысқанда>
Dialogue: 0,0:11:01.49,0:11:03.87,Default,,0,0,0,,<Reached to the deepest part>
Dialogue: 0,0:11:04.12,0:11:06.04,Default,,0,0,0,,Уау...хехе
Dialogue: 0,0:11:06.62,0:11:07.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:08.66,0:11:11.62,Default,,0,0,0,,<Бүгін мен өзімнен озып кетпеуді үйрендім.>
Dialogue: 0,0:11:11.75,0:11:12.79,Default,,0,0,0,,<Тамаша>
Dialogue: 0,0:11:13.08,0:11:15.67,Default,,0,0,0,,Seika-san, what is your level?
Dialogue: 0,0:11:15.88,0:11:17.09,Default,,0,0,0,,3
Dialogue: 0,0:11:17.21,0:11:18.92,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:11:19.05,0:11:22.43,Default,,0,0,0,,Бұл бастық бөлмесі. Сізді дәл қазір бірнеше секундта өлтіреді, солай ма?
Dialogue: 0,0:11:22.72,0:11:24.18,Default,,0,0,0,,Иә! Уф
Dialogue: 0,0:11:25.93,0:11:27.14,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:11:27.31,0:11:28.93,Default,,0,0,0,,Бүгінгі күннің бәрі осы.
Dialogue: 0,0:11:29.18,0:11:33.27,Default,,0,0,0,,<Ал, біреу маған ерте кезеңде ортаңғы бастық екенін айтты...>
Dialogue: 0,0:11:33.77,0:11:35.40,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:35.69,0:11:39.19,Default,,0,0,0,,Мен Киоширо-санның арқасында осы уақытқа дейін аман-есен жеттім.
Dialogue: 0,0:11:39.32,0:11:41.32,Default,,0,0,0,,Әй, жақсы.
Dialogue: 0,0:11:41.49,0:11:43.70,Default,,0,0,0,,You'll make a good leader.
Dialogue: 0,0:11:44.41,0:11:48.58,Default,,0,0,0,,Бірақ үйге барар алдында ерекше оқиға күтіп тұр.
Dialogue: 0,0:11:50.66,0:11:51.58,Default,,0,0,0,,Мұнда
Dialogue: 0,0:11:52.04,0:11:54.83,Default,,0,0,0,,<Уф, жад есігі ашылады...>
Dialogue: 0,0:11:55.04,0:11:57.63,Default,,0,0,0,,Is Kyoshiro in this room?
Dialogue: 0,0:11:57.75,0:12:00.59,Default,,0,0,0,,Жоқ, оны басқа реинкарнация жасаған адам жасаған сияқты.
Dialogue: 0,0:12:01.30,0:12:04.14,Default,,0,0,0,,Мұнда құбыжықтар да, сиқырлар да баса алмайды.
Dialogue: 0,0:12:04.26,0:12:06.22,Default,,0,0,0,,Ironclad safety point
Dialogue: 0,0:12:06.80,0:12:08.93,Default,,0,0,0,,<Yes, Mr. Kyoshiro Doubt>
Dialogue: 0,0:12:09.77,0:12:14.69,Default,,0,0,0,,<Ирия қаласынан 200 км радиуста қауіпсіздік пункттері жоқ>
Dialogue: 0,0:12:14.98,0:12:16.48,Default,,0,0,0,,<Of course here too>
Dialogue: 0,0:12:16.86,0:12:19.23,Default,,0,0,0,,Wow, it looks like a party!
Dialogue: 0,0:12:19.48,0:12:20.57,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:12:20.74,0:12:24.86,Default,,0,0,0,,Бұл осы уақытқа дейін келген реинкарнацияланған адамдар үшін құттықтау кеші!
Dialogue: 0,0:12:26.57,0:12:27.87,Default,,0,0,0,,<Хмм…>
Dialogue: 0,0:12:27.99,0:12:31.08,Default,,0,0,0,,<Ауызда дәрі бар... ұйықтататын дәрі бар ма?>
Dialogue: 0,0:12:31.20,0:12:33.29,Default,,0,0,0,,<Ал, бұл мен үшін жұмыс істемейді.>
Dialogue: 0,0:12:34.29,0:12:36.33,Default,,0,0,0,,Сезімдеріңе қуаныштымын.
Dialogue: 0,0:12:36.46,0:12:38.84,Default,,0,0,0,,Күн әлі көтерілгенше қалаға қайтуым керек...
Dialogue: 0,0:12:39.05,0:12:40.76,Default,,0,0,0,,<Жақсы, Сэйджи-сан>
Dialogue: 0,0:12:40.88,0:12:44.13,Default,,0,0,0,,Ал, сіз тойлап жатырсыз.
Dialogue: 0,0:12:44.30,0:12:47.05,Default,,0,0,0,,Түсіндім, сен тым мейірімді едің...
Dialogue: 0,0:12:47.18,0:12:49.72,Default,,0,0,0,,Мен мұны мәжбүрлі деп айтпас едім.
Dialogue: 0,0:12:49.85,0:12:51.60,Default,,0,0,0,,Тезірек қалаға қайтайық
Dialogue: 0,0:12:51.72,0:12:54.02,Default,,0,0,0,,Ендеше қайтадан бастайық...
Dialogue: 0,0:12:54.14,0:12:55.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:56.90,0:13:00.53,Default,,0,0,0,,Кешіріңіз! Мен саған күмәндандым!
Dialogue: 0,0:13:00.90,0:13:03.78,Default,,0,0,0,,<Аа... бұл кісі «жақсы адам»...>
Dialogue: 0,0:13:04.40,0:13:07.78,Default,,0,0,0,,Сіз маған соншалықты мейірімді болсаңыз да, мен...
Dialogue: 0,0:13:07.91,0:13:10.12,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:13:10.24,0:13:13.54,Default,,0,0,0,,Көшбасшы ретінде сіз күткен нәрсені орындадыңыз.
Dialogue: 0,0:13:13.96,0:13:16.04,Default,,0,0,0,,Эй, сен оны ала аласың ба?
Dialogue: 0,0:13:17.46,0:13:20.92,Default,,0,0,0,,Иә! <Сонымен қатар, бұл өте ыстық>
Dialogue: 0,0:13:21.63,0:13:23.55,Default,,0,0,0,,А, бұл оған тұрарлық емес ...
Dialogue: 0,0:13:23.84,0:13:26.05,Default,,0,0,0,,Біреудің мейірімділігіне күмәндану...
Dialogue: 0,0:13:26.18,0:13:28.97,Default,,0,0,0,,Маған тағы біреуін беріңізші. (Қыз) Бұл дәмді.
Dialogue: 0,0:13:29.22,0:13:31.31,Default,,0,0,0,,<Е... жақсысыңдар ма, мына балалар...>
Dialogue: 0,0:13:32.14,0:13:34.23,Default,,0,0,0,,<Дитоксикация сиқыры жарқырап, айқын болады>
Dialogue: 0,0:13:34.35,0:13:37.15,Default,,0,0,0,,<Әңгімелесу арқылы баяулағыңыз келе ме...>
Dialogue: 0,0:13:37.48,0:13:38.56,Default,,0,0,0,,Уфх~
Dialogue: 0,0:13:38.98,0:13:42.44,Default,,0,0,0,,Әй, бәрің бұл дүниеге келгенше.
Dialogue: 0,0:13:42.65,0:13:45.32,Default,,0,0,0,,Сіз не істеп жүрсіз? (3 адам) Әй!
Dialogue: 0,0:13:45.78,0:13:47.11,Default,,0,0,0,,Шигеру-сан...
Dialogue: 0,0:13:47.45,0:13:48.32,Default,,0,0,0,,<Ол кетті! ＞
Dialogue: 0,0:13:49.07,0:13:53.29,Default,,0,0,0,,<Барлығы, соның ішінде мен де, бұл дүниеге қашты>
Dialogue: 0,0:13:53.62,0:13:56.41,Default,,0,0,0,,Кешіріңіз, бұл бос сөз болды.
Dialogue: 0,0:13:56.54,0:13:57.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:58.21,0:14:01.42,Default,,0,0,0,,Бұл ескі әңгіме, бірақ тыңдай аласыз ба?
Dialogue: 0,0:14:01.54,0:14:02.67,Default,,0,0,0,,А... иә
Dialogue: 0,0:14:03.59,0:14:05.34,Default,,0,0,0,,<Студент кезімде>
Dialogue: 0,0:14:05.51,0:14:08.55,Default,,0,0,0,,<Бәрін жек көріп, үйден қаштым>
Dialogue: 0,0:14:09.26,0:14:11.55,Default,,0,0,0,,<Ал мен компания аштым>
Dialogue: 0,0:14:11.72,0:14:14.10,Default,,0,0,0,,<Компанияның атауы - Success Life>
Dialogue: 0,0:14:14.27,0:14:15.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:15.73,0:14:18.27,Default,,0,0,0,,<Мен сатуда болғаныма сенімдімін.>
Dialogue: 0,0:14:18.44,0:14:21.31,Default,,0,0,0,,<Енді ойлап қарасам, президент осындай...>
Dialogue: 0,0:14:21.94,0:14:26.07,Default,,0,0,0,,Компания жаңадан ашылғанда бізге қонаққа сатушы келді.
Dialogue: 0,0:14:26.28,0:14:29.07,Default,,0,0,0,,«Мистер Ү» деп атайық.
Dialogue: 0,0:14:29.41,0:14:32.87,Default,,0,0,0,,Y мырза маған өте қымбат көшірме машинасын сатты.
Dialogue: 0,0:14:33.24,0:14:34.45,Default,,0,0,0,,<Бұл менмін...>
Dialogue: 0,0:14:35.62,0:14:38.71,Default,,0,0,0,,<Әрине мен жеңілдік туралы келіссөз жүргіздім>
Dialogue: 0,0:14:38.83,0:14:40.58,Default,,0,0,0,,<Онда мистер Ю...>
Dialogue: 0,0:14:40.96,0:14:43.46,Default,,0,0,0,,<"Мен сені күлдіремін">
Dialogue: 0,0:14:43.67,0:14:47.13,Default,,0,0,0,,<“Біз ешқашан көңілімізді қалдырмаймыз”...>
Dialogue: 0,0:14:47.59,0:14:51.18,Default,,0,0,0,,<Сонымен қатар, «Сіз, президент, көбірек ойнауыңыз керек»>
Dialogue: 0,0:14:51.30,0:14:53.22,Default,,0,0,0,,＜Бұл тіпті айтылды＞
Dialogue: 0,0:14:53.64,0:14:55.26,Default,,0,0,0,,<Ы мырзаның ынтасымен итеріп жіберді>
Dialogue: 0,0:14:55.39,0:14:57.89,Default,,0,0,0,,<Біз жұмыс орнындағы жұмысты қызметкерлерімізге тапсыруды шештік>
Dialogue: 0,0:14:58.94,0:15:02.77,Default,,0,0,0,,<Көзімді сыртқа бұрып, «ойнауға» тырыстым>
Dialogue: 0,0:15:03.44,0:15:05.98,Default,,0,0,0,,<Осыдан кейін көп ұзамай компания кеңейді>
Dialogue: 0,0:15:06.11,0:15:08.07,Default,,0,0,0,,<Жетістіктер тізімі>
Dialogue: 0,0:15:08.24,0:15:10.91,Default,,0,0,0,,<Мен ол кезде NEET едім>
Dialogue: 0,0:15:11.28,0:15:13.07,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,0:15:13.24,0:15:16.04,Default,,0,0,0,,Мен өз компаниямды банкротқа ұшыраттым.
Dialogue: 0,0:15:16.20,0:15:17.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:19.62,0:15:21.12,Default,,0,0,0,,<Банкроттықтың себебі...>
Dialogue: 0,0:15:21.25,0:15:24.96,Default,,0,0,0,,<Бұл жасанды интеллектке қатысты апат болды, ол әзірленуде болды>
Dialogue: 0,0:15:25.38,0:15:26.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:26.96,0:15:29.55,Default,,0,0,0,,Қатысқандардың барлығы бақытсыз болады...
Dialogue: 0,0:15:29.72,0:15:31.59,Default,,0,0,0,,Мен психикалық ауруға ұшырадым
Dialogue: 0,0:15:31.80,0:15:32.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:33.30,0:15:35.56,Default,,0,0,0,,Маған берген мүмкіндікке рахмет.
Dialogue: 0,0:15:35.68,0:15:37.72,Default,,0,0,0,,Кек қайтара алмай...
Dialogue: 0,0:15:38.06,0:15:39.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:39.98,0:15:43.90,Default,,0,0,0,,Сондықтан мен бұл дүниеге келгенде ант бердім.
Dialogue: 0,0:15:44.36,0:15:47.48,Default,,0,0,0,,Мен ешкімді ешқашан сатпаймын.
Dialogue: 0,0:15:50.11,0:15:52.66,Default,,0,0,0,,<Сен жақсы адамсың...>
Dialogue: 0,0:15:53.03,0:15:55.87,Default,,0,0,0,,Негізінде, Y мырзаның аты...
Dialogue: 0,0:15:56.16,0:15:57.74,Default,,0,0,0,,Ол Шигеру деп аталады.
Dialogue: 0,0:15:57.87,0:15:58.74,Default,,0,0,0,,Уф
Dialogue: 0,0:15:59.12,0:16:00.37,Default,,0,0,0,,Шигеру-сан
Dialogue: 0,0:16:00.54,0:16:02.67,Default,,0,0,0,,Маған фамилияңызды айта аласыз ба?
Dialogue: 0,0:16:02.79,0:16:04.83,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:16:05.46,0:16:06.84,Default,,0,0,0,,Бұл Сасаки
Dialogue: 0,0:16:11.22,0:16:13.47,Default,,0,0,0,,(Төрт адам ұйықтап жатыр)
Dialogue: 0,0:16:15.64,0:16:19.43,Default,,0,0,0,,Ооо, мен осындай жерде ұйықтап қалдым.
Dialogue: 0,0:16:19.56,0:16:21.60,Default,,0,0,0,,Суық тиіп қалсаң да білмейсің.
Dialogue: 0,0:16:21.73,0:16:25.52,Default,,0,0,0,,Бауырым, сен бүгін тиімдірек.
Dialogue: 0,0:16:25.65,0:16:28.07,Default,,0,0,0,,Бүгінгі үйрек ақымақ адал болды.
Dialogue: 0,0:16:28.23,0:16:30.07,Default,,0,0,0,,Бұл оңай жұмыс болды.
Dialogue: 0,0:16:30.23,0:16:32.95,Default,,0,0,0,,<Уайымдама, мен ояумын>
Dialogue: 0,0:16:33.53,0:16:34.99,Default,,0,0,0,,Жоғарыда айтылғандардың барлығы толық.
Dialogue: 0,0:16:35.16,0:16:37.24,Default,,0,0,0,,Мұқият орау.
Dialogue: 0,0:16:38.74,0:16:43.29,Default,,0,0,0,,<Бұл сезім... маған бір жағымсыз нәрсені есіме түсірді>
Dialogue: 0,0:16:43.46,0:16:45.96,Default,,0,0,0,,Шошқаны чар сиуға айналдырамыз ба (бағыныңқылар күледі)?
Dialogue: 0,0:16:46.08,0:16:47.13,Default,,0,0,0,,<Егецуна>
Dialogue: 0,0:16:48.79,0:16:51.92,Default,,0,0,0,,<Жарайды, осыған менің толық күшімді пайдалануға болады>
Dialogue: 0,0:16:52.05,0:16:53.76,Default,,0,0,0,,<Хмм>
Dialogue: 0,0:16:54.05,0:16:55.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:56.30,0:16:58.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:58.64,0:17:00.01,Default,,0,0,0,,<Сэйдзи-сан! ＞
Dialogue: 0,0:17:00.43,0:17:02.02,Default,,0,0,0,,Барлығына...
Dialogue: 0,0:17:02.23,0:17:03.77,Default,,0,0,0,,Маған тиіспе...
Dialogue: 0,0:17:04.06,0:17:04.98,Default,,0,0,0,,Иә
Dialogue: 0,0:17:05.10,0:17:09.27,Default,,0,0,0,,Мен ішегіме қараймын, бірақ менің қолымнан бәрі тұру үшін ғана жетеді деп ойлаймын.
Dialogue: 0,0:17:09.44,0:17:10.69,Default,,0,0,0,,Жұмысты жалғастыру
Dialogue: 0,0:17:10.82,0:17:11.65,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:17:12.24,0:17:13.99,Default,,0,0,0,,Иә, тоқтатыңыз!
Dialogue: 0,0:17:14.74,0:17:15.66,Default,,0,0,0,,Хмм (Сэйджи) Ах.
Dialogue: 0,0:17:15.78,0:17:17.41,Default,,0,0,0,,Хмф (Сейджи) Уф
Dialogue: 0,0:17:17.78,0:17:22.20,Default,,0,0,0,,Ең соңында маған сенгеніңіз сіздің бақытыңыз болды.
Dialogue: 0,0:17:22.33,0:17:24.58,Default,,0,0,0,,Ал, қарсы жақ жаман болды.
Dialogue: 0,0:17:24.75,0:17:25.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:25.96,0:17:27.08,Default,,0,0,0,,<Жаман...>
Dialogue: 0,0:17:27.29,0:17:32.13,Default,,0,0,0,,<Бірақ менің алдау статусыма тіпті Сейджи де қатысты...>
Dialogue: 0,0:17:32.30,0:17:33.38,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:33.51,0:17:35.38,Default,,0,0,0,,Алға (Сэйджи)
Dialogue: 0,0:17:35.59,0:17:37.51,Default,,0,0,0,,<Сэйджи-сан жақсы! ＞
Dialogue: 0,0:17:37.64,0:17:39.05,Default,,0,0,0,,(Сейдзидің ыңырсыуы)
Dialogue: 0,0:17:39.55,0:17:41.76,Default,,0,0,0,,Мені ренжітпе! мәні төмендейді
Dialogue: 0,0:17:42.22,0:17:43.47,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:17:43.60,0:17:46.48,Default,,0,0,0,,Адамдарды осылай ұрладың ба?
Dialogue: 0,0:17:47.06,0:17:49.77,Default,,0,0,0,,Сіз қандай сұмдық адамсыз...
Dialogue: 0,0:17:50.19,0:17:55.95,Default,,0,0,0,,Бұл дүниеге келгендердің көбі, бәлкім, өз дүниесінде жүрегі жараланған адамдар шығар.
Dialogue: 0,0:17:56.20,0:18:00.78,Default,,0,0,0,,Аяғыңызға тұруға тырысқаныңызда, сізді төмен түсіре алу үшін...
Dialogue: 0,0:18:01.28,0:18:06.12,Default,,0,0,0,,Тіршіліктен адасушылар келетін дүние осы ғой?
Dialogue: 0,0:18:06.25,0:18:09.04,Default,,0,0,0,,Сіз аздап аңғал болдыңыз.
Dialogue: 0,0:18:09.17,0:18:10.54,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:18:10.67,0:18:13.09,Default,,0,0,0,,Мен саған достарыммен араласуға жол бермеймін!
Dialogue: 0,0:18:13.21,0:18:14.92,Default,,0,0,0,,Мен оларды қорғаймын!
Dialogue: 0,0:18:15.21,0:18:18.26,Default,,0,0,0,,Ха, ондай боқтықпен не істей аласың?
Dialogue: 0,0:18:18.43,0:18:20.68,Default,,0,0,0,,Тезірек мына нәрсені жинап ал!
Dialogue: 0,0:18:20.80,0:18:21.64,Default,,0,0,0,,Эй
Dialogue: 0,0:18:21.85,0:18:22.89,Default,,0,0,0,,<Қазір! ＞
Dialogue: 0,0:18:23.43,0:18:25.10,Default,,0,0,0,,Сэйдзи-сан! (Сэйджи) Ах!
Dialogue: 0,0:18:25.22,0:18:26.14,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:26.27,0:18:27.14,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:18:30.06,0:18:30.98,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:31.15,0:18:33.61,Default,,0,0,0,,<Шошқаға жылдам секіру! ＞
Dialogue: 0,0:18:34.48,0:18:37.45,Default,,0,0,0,,<Мен жай ғана өз салмағымды пайдаланып секірдім.>
Dialogue: 0,0:18:37.61,0:18:42.37,Default,,0,0,0,,<Егер сіз менің статусыммен нашар шабуыл жасасаңыз, сіз бәрін тастай аласыз>
Dialogue: 0,0:18:42.49,0:18:44.66,Default,,0,0,0,,Не, қаншалықты негізсіз?
Dialogue: 0,0:18:44.83,0:18:46.87,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:18:47.25,0:18:48.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:48.54,0:18:51.58,Default,,0,0,0,,Біз Шигеру-санның жалғыз соғысуына жол бере алмаймыз!
Dialogue: 0,0:18:51.71,0:18:54.84,Default,,0,0,0,,<Аа, бұл жігіт өте қызық еді...>
Dialogue: 0,0:18:54.96,0:18:56.13,Default,,0,0,0,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,0:18:56.26,0:18:57.88,Default,,0,0,0,,Отбасымнан алыста~!
Dialogue: 0,0:18:58.26,0:18:59.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:59.34,0:19:01.47,Default,,0,0,0,,Мен саған айтамын, мен күштімін.
Dialogue: 0,0:19:01.59,0:19:02.39,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:02.80,0:19:05.39,Default,,0,0,0,,Бір соққы сені өлтіреді
Dialogue: 0,0:19:05.64,0:19:07.64,Default,,0,0,0,,Иә? соққы?
Dialogue: 0,0:19:07.85,0:19:10.35,Default,,0,0,0,,Дүниелік сөздеріңді байлап ал!
Dialogue: 0,0:19:10.48,0:19:11.48,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:11.60,0:19:12.94,Default,,0,0,0,,＜Маған орындауға рұқсат бересің бе＞
Dialogue: 0,0:19:13.56,0:19:14.48,Default,,0,0,0,,Уау
Dialogue: 0,0:19:14.77,0:19:17.40,Default,,0,0,0,,Бұл ыңғайсыздық! Күш 80 соққы!
Dialogue: 0,0:19:17.53,0:19:18.49,Default,,0,0,0,,Ах
Dialogue: 0,0:19:18.65,0:19:19.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:20.40,0:19:21.36,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:19:22.20,0:19:23.95,Default,,0,0,0,,Бұл шошқа кім?
Dialogue: 0,0:19:24.66,0:19:26.79,Default,,0,0,0,,<Егер сіз маған зиян келтіргіңіз келсе>
Dialogue: 0,0:19:26.91,0:19:28.62,Default,,0,0,0,,<Қызды әкел>
Dialogue: 0,0:19:29.75,0:19:32.42,Default,,0,0,0,,Қарғыс атсын, алдымен анау шошқаны істе.
Dialogue: 0,0:19:32.63,0:19:33.63,Default,,0,0,0,,<Ёшикой>
Dialogue: 0,0:19:33.79,0:19:36.05,Default,,0,0,0,,Шигеру-сан! өтінемін қаш
Dialogue: 0,0:19:36.17,0:19:38.38,Default,,0,0,0,,<Мен сенің қашуыңды қалаймын>
Dialogue: 0,0:19:38.51,0:19:40.84,Default,,0,0,0,,Мен сені бір соққыда жеңемін!
Dialogue: 0,0:19:40.97,0:19:43.39,Default,,0,0,0,,<Соққыға не негіз болады?>
Dialogue: 0,0:19:43.51,0:19:44.85,Default,,0,0,0,,(миниондардың шайқас айқайы)
Dialogue: 0,0:19:45.43,0:19:47.39,Default,,0,0,0,,<Әй, шаш жасауды доғар>
Dialogue: 0,0:19:47.52,0:19:51.19,Default,,0,0,0,,Сэйдзи-сан, осылай жалғаса берсе, шошқа өледі, солай ма?
Dialogue: 0,0:19:51.31,0:19:53.02,Default,,0,0,0,,Тез берілмесең...
Dialogue: 0,0:19:53.15,0:19:53.94,Default,,0,0,0,,Хебу
Dialogue: 0,0:19:54.15,0:19:54.98,Default,,0,0,0,,<Тыныш>
Dialogue: 0,0:19:55.11,0:19:57.15,Default,,0,0,0,,Хмф! Деде деде…
Dialogue: 0,0:19:57.78,0:19:58.90,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:59.19,0:20:00.24,Default,,0,0,0,,Хмм (Кёсиро) Ммм
Dialogue: 0,0:20:01.45,0:20:03.57,Default,,0,0,0,,Бұл жарық түрі
Dialogue: 0,0:20:03.70,0:20:06.16,Default,,0,0,0,,Кез келген зұлымдықты жеңу
Dialogue: 0,0:20:06.28,0:20:08.54,Default,,0,0,0,,Зейнетке шыққыңыз келсе, қазір.
Dialogue: 0,0:20:08.74,0:20:11.29,Default,,0,0,0,,Бұл қандай шеберлік...
Dialogue: 0,0:20:11.75,0:20:12.92,Default,,0,0,0,,Арнайы ескертулер…
Dialogue: 0,0:20:13.04,0:20:16.04,Default,,0,0,0,,Мен ерекше жазбаларға ант бердім.
Dialogue: 0,0:20:16.84,0:20:19.13,Default,,0,0,0,,<"Достарыңа ешқашан опасыздық жасама">
Dialogue: 0,0:20:19.30,0:20:24.93,Default,,0,0,0,,<"Егер мен бұл антымды бұзсам, оның салдарын көремін">
Dialogue: 0,0:20:25.85,0:20:29.89,Default,,0,0,0,,Осы анттан алған барлық бонус ұпайларының орнына.
Dialogue: 0,0:20:30.02,0:20:32.31,Default,,0,0,0,,Мен бұл күшке ие болдым.
Dialogue: 0,0:20:32.48,0:20:34.48,Default,,0,0,0,,<Дәлірек айтсақ, Сэйджи-сан...>
Dialogue: 0,0:20:34.60,0:20:37.15,Default,,0,0,0,,<Бонустың арнайы қозғалысына толық серпіліс!?>
Dialogue: 0,0:20:37.27,0:20:38.94,Default,,0,0,0,,<Қосымша баланс...>
Dialogue: 0,0:20:39.19,0:20:42.11,Default,,0,0,0,,Бұл ерекше қимыл ашудан туындайды.
Dialogue: 0,0:20:42.24,0:20:46.82,Default,,0,0,0,,Ашуым шыңға жеткенде, Ашық қызыл жарқырайды
Dialogue: 0,0:20:47.03,0:20:50.58,Default,,0,0,0,,Қаруларыңызды тастап, шегініңіздер.
Dialogue: 0,0:20:50.70,0:20:54.29,Default,,0,0,0,,Ха, егер сіз оң қолыңызды мөрмен бекітсеңіз, ештеңе болмайды.
Dialogue: 0,0:20:54.42,0:20:56.83,Default,,0,0,0,,Ол аздап бүлінген шығар, бірақ...
Dialogue: 0,0:20:57.00,0:20:59.25,Default,,0,0,0,,Жай ғана ұрыс...
Dialogue: 0,0:20:59.46,0:21:00.88,Default,,0,0,0,,Мен көмектесе алмаймын ...
Dialogue: 0,0:21:01.21,0:21:05.84,Default,,0,0,0,,＜Қорғаныс күшіңізді бір жаққа тастаңыз, бұл қалай қарасаңыз да, абайсызда...＞
Dialogue: 0,0:21:06.05,0:21:08.72,Default,,0,0,0,,<Мен мұндай нәрсені жек көрмеймін>
Dialogue: 0,0:21:09.01,0:21:10.72,Default,,0,0,0,,Тааааааааааааа!
Dialogue: 0,0:21:10.85,0:21:12.10,Default,,0,0,0,,Иә! (Сэйджи) Эй!
Dialogue: 0,0:21:12.31,0:21:14.14,Default,,0,0,0,,Қарғыс атсын! Шошқа
Dialogue: 0,0:21:14.27,0:21:16.40,Default,,0,0,0,,Шигеру-сан! Артқа тұрыңыз!
Dialogue: 0,0:21:16.52,0:21:19.36,Default,,0,0,0,,Сан көп! Мен сенің қалқаның боламын...
Dialogue: 0,0:21:19.48,0:21:20.57,Default,,0,0,0,,Бухо
Dialogue: 0,0:21:20.69,0:21:22.78,Default,,0,0,0,,Неге сонша...
Dialogue: 0,0:21:23.03,0:21:24.11,Default,,0,0,0,,<Мен...>
Dialogue: 0,0:21:24.49,0:21:27.41,Default,,0,0,0,,<Нақты әлемде «жақсы адамдар» көбірек жоғалтады>
Dialogue: 0,0:21:27.66,0:21:31.37,Default,,0,0,0,,<Сондықтан да «жақсы адамдардың» басқа дүниеде марапатталуы дұрыс...>
Dialogue: 0,0:21:32.70,0:21:34.91,Default,,0,0,0,,Мен енді қашқым келмейді
Dialogue: 0,0:21:35.87,0:21:38.92,Default,,0,0,0,,Ашуыңызды өтінемін, Көшбасшы!
Dialogue: 0,0:21:39.08,0:21:40.09,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:40.29,0:21:42.34,Default,,0,0,0,,Жарқыраңыз
Dialogue: 0,0:21:42.46,0:21:44.13,Default,,0,0,0,,Менің жұдырығым!
Dialogue: 0,0:21:44.34,0:21:48.47,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:21:54.64,0:21:56.60,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:21:58.77,0:22:00.65,Default,,0,0,0,,Трансформация!? Сен кімсің!
Dialogue: 0,0:22:00.86,0:22:02.90,Default,,0,0,0,,<Жоқ, бұл Сэйджи-сан>
Dialogue: 0,0:22:03.15,0:22:04.86,Default,,0,0,0,,Қайсар батыр...
Dialogue: 0,0:22:07.11,0:22:08.53,Default,,0,0,0,,Альдин
Dialogue: 0,0:22:08.66,0:22:09.87,Default,,0,0,0,,<Неге?>
Dialogue: 0,0:22:10.20,0:22:13.16,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.62,0:23:38.58,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.08,0:23:46.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory