Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.96,0:00:04.63,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:00:04.79,0:00:06.63,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:06.92,0:00:09.05,Default,,0,0,0,,А, бәрі?
Dialogue: 0,0:00:23.02,0:00:24.73,Default,,0,0,0,,Кууууу
Dialogue: 0,0:00:24.90,0:00:26.56,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:00:26.77,0:00:29.73,Default,,0,0,0,,Жоқ, менің күшім мүлде жоқ.
Dialogue: 0,0:00:29.90,0:00:31.69,Default,,0,0,0,,Әй, батыр-күн
Dialogue: 0,0:00:31.82,0:00:34.95,Default,,0,0,0,,Сіз әділдіктің одақтасысыз, солай ма?
Dialogue: 0,0:00:35.11,0:00:38.33,Default,,0,0,0,,Олай болса, неге айтпайсың?
Dialogue: 0,0:00:38.78,0:00:40.66,Default,,0,0,0,,О... маған үйретші?
Dialogue: 0,0:00:41.04,0:00:42.87,Default,,0,0,0,,Әділдік деген не?
Dialogue: 0,0:00:43.25,0:00:44.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:45.37,0:00:49.67,Default,,0,0,0,,Осы уақытқа дейін олардан менсінбей, жерге домалап түстім.
Dialogue: 0,0:00:50.34,0:00:53.63,Default,,0,0,0,,Бұл масқара болды.
Dialogue: 0,0:00:53.76,0:00:56.26,Default,,0,0,0,,Бірақ мен ғана шыдаймын ба?
Dialogue: 0,0:00:56.55,0:01:00.14,Default,,0,0,0,,Бұл әділдік болса, онда бұл сұмдық, солай ма?
Dialogue: 0,0:01:02.27,0:01:04.14,Default,,0,0,0,,Әрқашан солай
Dialogue: 0,0:01:04.27,0:01:07.60,Default,,0,0,0,,Мен езіліп, таптадым
Dialogue: 0,0:01:07.77,0:01:10.57,Default,,0,0,0,,Мен көптен бері ұстадым
Dialogue: 0,0:01:11.98,0:01:15.95,Default,,0,0,0,,Кек алу табиғи емес пе?
Dialogue: 0,0:01:18.32,0:01:20.58,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,0:01:20.78,0:01:23.79,Default,,0,0,0,,Айтшы, әділдік одақтасы.
Dialogue: 0,0:01:24.45,0:01:28.83,Default,,0,0,0,,Мен өзіңізді дәрменсіз сезіну және ашулану сезімін түсінемін.
Dialogue: 0,0:01:29.29,0:01:31.34,Default,,0,0,0,,Бірақ тіпті
Dialogue: 0,0:01:31.46,0:01:33.55,Default,,0,0,0,,Оны жалғыз алып жүрмеңіз
Dialogue: 0,0:01:35.47,0:01:38.68,Default,,0,0,0,,Мен сенің ашуыңды аламын.
Dialogue: 0,0:01:38.80,0:01:39.93,Default,,0,0,0,,Ха...
Dialogue: 0,0:01:40.14,0:01:42.51,Default,,0,0,0,,Құдайдың қаһарын қабылдау деген нені білдіреді?
Dialogue: 0,0:01:42.64,0:01:46.56,Default,,0,0,0,,Иә, мен сенетін әділдік осы.
Dialogue: 0,0:01:51.40,0:01:54.57,Default,,0,0,0,,Әділдік туралы әлсіздер айтпасын!!
Dialogue: 0,0:01:54.74,0:01:55.61,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:55.78,0:01:59.03,Default,,0,0,0,,Ей, мен шынымен құлай алмаймын.
Dialogue: 0,0:01:59.16,0:02:01.45,Default,,0,0,0,,Осы жерде оңай құлап қалсаңыз
Dialogue: 0,0:02:01.58,0:02:04.37,Default,,0,0,0,,Мен достарыма опасыздық жасаймын
Dialogue: 0,0:02:04.79,0:02:07.12,Default,,0,0,0,,«Достарыңа ешқашан опасыздық жасама»
Dialogue: 0,0:02:07.37,0:02:12.17,Default,,0,0,0,,Егер мен бұл антты бұзсам, оның салдарын көремін.
Dialogue: 0,0:02:12.29,0:02:15.09,Default,,0,0,0,,Бұл менің антым!
Dialogue: 0,0:02:15.21,0:02:17.42,Default,,0,0,0,,Шулы Шулы Шулы!
Dialogue: 0,0:02:18.51,0:02:20.97,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:02:21.47,0:02:23.14,Default,,0,0,0,,Сіз осында келгенде
Dialogue: 0,0:02:23.31,0:02:25.72,Default,,0,0,0,,Мен
Dialogue: 0,0:02:25.97,0:02:29.23,Default,,0,0,0,,Мен ұзақ мойындаудан кейін дұға еттім.
Dialogue: 0,0:02:29.77,0:02:34.73,Default,,0,0,0,,<Осы дүниеде бәріміз кездесерміз деп үміттенемін...>
Dialogue: 0,0:02:35.57,0:02:38.03,Default,,0,0,0,,Ешкімге кедергі жасамаңыз
Dialogue: 0,0:02:38.24,0:02:40.78,Default,,0,0,0,,Бұл менің дұғам
Dialogue: 0,0:02:41.03,0:02:43.99,Default,,0,0,0,,Сізбен тағы да кездескеніме қуаныштымын, Макото-чан.
Dialogue: 0,0:02:44.16,0:02:47.00,Default,,0,0,0,,Ха! Мен сенен күтпедім...
Dialogue: 0,0:02:49.58,0:02:51.00,Default,,0,0,0,,Қолайсыздық…
Dialogue: 0,0:02:52.29,0:02:53.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:58.63,0:02:59.67,Default,,0,0,0,,Бұл тітіркендіргіш!
Dialogue: 0,0:03:01.13,0:03:01.93,Default,,0,0,0,,Тітіркендіргіш!
Dialogue: 0,0:03:03.14,0:03:06.39,Default,,0,0,0,,Жек көру, жек көру, жек көру, жек көру, жек көру, жек көру!
Dialogue: 0,0:03:06.56,0:03:09.18,Default,,0,0,0,,Құдай-ай… Ұстаңдар! Жылдам! Жылдамдаңдар!
Dialogue: 0,0:03:09.52,0:03:10.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:10.56,0:03:12.40,Default,,0,0,0,,Мен оны жек көремін! жек көру!
Dialogue: 0,0:03:12.60,0:03:15.90,Default,,0,0,0,,Allies of justice and friends!
Dialogue: 0,0:03:16.02,0:03:17.69,Default,,0,0,0,,Құдай да!
Dialogue: 0,0:03:24.74,0:03:28.45,Default,,0,0,0,,Қат! Мен ешкімді қорғай алмаймын ба?
Dialogue: 0,0:03:28.70,0:03:33.00,Default,,0,0,0,,Абсолютті Құдай дегеніміз не? Оларды не бағыттайды...
Dialogue: 0,0:03:34.08,0:03:35.34,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:03:35.96,0:03:37.59,Default,,0,0,0,,<Seika-san…>
Dialogue: 0,0:03:37.71,0:03:42.43,Default,,0,0,0,,Досыңның жүрегінен ренжісе
Dialogue: 0,0:03:42.59,0:03:45.60,Default,,0,0,0,,I want to become an angel and heal you.
Dialogue: 0,0:03:46.39,0:03:49.31,Default,,0,0,0,,Мен жоғалтқанымды қайтарғым келеді
Dialogue: 0,0:03:55.02,0:03:58.82,Default,,0,0,0,,Бұл менің тілегім
Dialogue: 0,0:03:58.94,0:04:01.32,Default,,0,0,0,,Ұнатпау, ұнатпау
Dialogue: 0,0:04:01.45,0:04:05.12,Default,,0,0,0,,Everyone, everyone, everyone, die!
Dialogue: 0,0:04:06.07,0:04:07.12,Default,,0,0,0,,Лия мырза
Dialogue: 0,0:04:07.95,0:04:12.16,Default,,0,0,0,,Негізі жел саяхатшысын мен де кездестірдім.
Dialogue: 0,0:04:12.29,0:04:14.00,Default,,0,0,0,,Әй
Dialogue: 0,0:04:17.50,0:04:21.38,Default,,0,0,0,,(Жедел жәрдем сиренасы)
Dialogue: 0,0:04:21.80,0:04:25.39,Default,,0,0,0,,Оның ата-анасы болып көрінген екі ересек адам қайтыс болды. Қыздың да жағдайы ауыр!
Dialogue: 0,0:04:25.51,0:04:27.39,Default,,0,0,0,,Immediately prepare for acceptance!
Dialogue: 0,0:04:37.36,0:04:41.11,Default,,0,0,0,,Рахмет, ағай.
Dialogue: 0,0:05:08.09,0:05:10.26,Default,,0,0,0,,Қараңдар! (Бала) Бұл құбыжық!
Dialogue: 0,0:05:10.51,0:05:11.89,Default,,0,0,0,,Мама! (Бала) Бұл зомби!
Dialogue: 0,0:05:12.02,0:05:15.56,Default,,0,0,0,,Шағып алсаң, жұғасың. (Бала) Оны жеңейік! Оны жеңейік!
Dialogue: 0,0:05:15.73,0:05:18.81,Default,,0,0,0,,I... I'm not a zombie.
Dialogue: 0,0:05:18.94,0:05:20.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:20.27,0:05:23.19,Default,,0,0,0,,Әй, мен сөйлестім! (Child) If so, show me the evidence!
Dialogue: 0,0:05:23.32,0:05:27.20,Default,,0,0,0,,See, see, see (Seika's cry)
Dialogue: 0,0:05:27.41,0:05:29.62,Default,,0,0,0,,Take off my bandage!
Dialogue: 0,0:05:29.95,0:05:31.70,Default,,0,0,0,,Иә? (Балалар) Ой?
Dialogue: 0,0:05:32.08,0:05:34.25,Default,,0,0,0,,Don't do anything uncool!
Dialogue: 0,0:05:34.37,0:05:36.21,Default,,0,0,0,,Noisy, ugly bald man!
Dialogue: 0,0:05:36.33,0:05:40.17,Default,,0,0,0,,Ұсқынсыз екені рас, бірақ шашы сәл ғана жұқа.
Dialogue: 0,0:05:40.29,0:05:42.50,Default,,0,0,0,,Ұсқынсыз адам болсаң да, қызусың!
Dialogue: 0,0:05:42.63,0:05:44.09,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:45.55,0:05:47.97,Default,,0,0,0,,Is your daughter okay?
Dialogue: 0,0:05:48.22,0:05:50.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:50.18,0:05:54.60,Default,,0,0,0,,Сіз адасып қалдыңыз ба? If you're okay with me, I'll be your strength
Dialogue: 0,0:05:57.35,0:05:58.73,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:58.85,0:06:01.94,Default,,0,0,0,,Мен үйге барғым келеді
Dialogue: 0,0:06:04.11,0:06:08.20,Default,,0,0,0,,Beautiful young lady, is this your home?
Dialogue: 0,0:06:08.57,0:06:10.20,Default,,0,0,0,,Жас ханым?
Dialogue: 0,0:06:10.32,0:06:12.62,Default,,0,0,0,,Мен әдемі емеспін
Dialogue: 0,0:06:12.74,0:06:13.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:14.08,0:06:16.58,Default,,0,0,0,,Tattered under bandage
Dialogue: 0,0:06:16.75,0:06:18.25,Default,,0,0,0,,Looks like a ghost...
Dialogue: 0,0:06:18.54,0:06:21.46,Default,,0,0,0,,It's okay, you're a beautiful person.
Dialogue: 0,0:06:22.13,0:06:23.25,Default,,0,0,0,,Е...
Dialogue: 0,0:06:23.55,0:06:25.26,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:06:25.55,0:06:29.30,Default,,0,0,0,,Менің басымды да, бетімді де мазақ еткен жоқсың.
Dialogue: 0,0:06:29.43,0:06:32.14,Default,,0,0,0,,Кім көрсе де, шіркін
Dialogue: 0,0:06:33.89,0:06:38.02,Default,,0,0,0,,Оның үстіне мен бұрынғы ұлдар туралы жаман сөз айтпаймын.
Dialogue: 0,0:06:38.77,0:06:42.48,Default,,0,0,0,,Кек пен жек көру табиғи нәрсе болса да
Dialogue: 0,0:06:42.77,0:06:47.03,Default,,0,0,0,,Қанша қиын болса да, Ешкімді жек көрмеймін.
Dialogue: 0,0:06:47.24,0:06:51.16,Default,,0,0,0,,Күндей жылы болғандар сол
Dialogue: 0,0:06:51.32,0:06:55.16,Default,,0,0,0,,Менің ойымша, бұл өте әдемі
Dialogue: 0,0:06:56.95,0:06:58.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:01.46,0:07:04.46,Default,,0,0,0,,Қайтадан адасып қалсаңыз, мынаны оқыңыз
Dialogue: 0,0:07:04.59,0:07:05.75,Default,,0,0,0,,Бұл бойтұмар.
Dialogue: 0,0:07:12.18,0:07:14.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:31.53,0:07:34.03,Default,,0,0,0,,<Егер сіз еркіндік алғыңыз келсе>
Dialogue: 0,0:07:34.16,0:07:36.53,Default,,0,0,0,,<Көп нәрсені білген жақсы>
Dialogue: 0,0:07:36.66,0:07:41.29,Default,,0,0,0,,<Мысалы, сабақ оқымаса да, өзіңізге ұнайтын нәрсені табыңыз>
Dialogue: 0,0:07:41.41,0:07:43.83,Default,,0,0,0,,<Сол жолды жалғастырғаныңызды қалаймын>
Dialogue: 0,0:07:44.08,0:07:48.84,Default,,0,0,0,,<Сізді ойлайтын адамдар міндетті түрде күш береді>
Dialogue: 0,0:07:49.01,0:07:53.64,Default,,0,0,0,,<Осы билікті қарызға алып, еркіндікке ие болыңыз>
Dialogue: 0,0:07:53.76,0:07:56.60,Default,,0,0,0,,<Мен де сенімен бір күні кездесемін>
Dialogue: 0,0:07:56.72,0:08:00.39,Default,,0,0,0,,<Сенің жолыңда көмектесемін деп үміттенемін>
Dialogue: 0,0:08:00.52,0:08:03.94,Default,,0,0,0,,＜Ал мен сені күлдіремін＞
Dialogue: 0,0:08:04.35,0:08:06.52,Default,,0,0,0,,<Біз ешқашан көңілімізді қалдырмаймыз>
Dialogue: 0,0:08:06.69,0:08:08.61,Default,,0,0,0,,<Күн әулиесіне>
Dialogue: 0,0:08:08.73,0:08:10.78,Default,,0,0,0,,<Жел саяхатшысынан>
Dialogue: 0,0:08:11.86,0:08:15.45,Default,,0,0,0,,(Сейканың жылаған дауысы)
Dialogue: 0,0:08:32.72,0:08:36.01,Default,,0,0,0,,Керемет... Дүние кең.
Dialogue: 0,0:09:00.62,0:09:03.96,Default,,0,0,0,,Ешқандай маңызды ақпарат әлі алынған жоқ.
Dialogue: 0,0:09:04.08,0:09:07.58,Default,,0,0,0,,Менің ойымша, осы аптада мекемеден біреу сізбен кеңесуге келеді.
Dialogue: 0,0:09:10.38,0:09:11.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:18.39,0:09:22.02,Default,,0,0,0,,Ағай, қайда барасыз?
Dialogue: 0,0:09:22.52,0:09:25.52,Default,,0,0,0,,Ақыры емтиханды тапсырдым.
Dialogue: 0,0:09:25.98,0:09:30.02,Default,,0,0,0,,Ағай, мен не істеймін...
Dialogue: 0,0:09:32.32,0:09:36.03,Default,,0,0,0,,<Ол кезде шайтан кінәлі болғанына сенімдімін.>
Dialogue: 0,0:09:36.32,0:09:37.49,Default,,0,0,0,,<Байқаған кезде>
Dialogue: 0,0:09:37.61,0:09:41.53,Default,,0,0,0,,<Мен интернетте айтылған әдісті қолданып көрдім>
Dialogue: 0,0:09:41.99,0:09:45.54,Default,,0,0,0,,<Бірақ жел саяхатшысы дұрыс айтты>
Dialogue: 0,0:09:46.21,0:09:50.79,Default,,0,0,0,,<Алғалы тұрған жолда маған күш берген біреу болды.>
Dialogue: 0,0:09:51.21,0:09:55.55,Default,,0,0,0,,<Ақырында мен бостандыққа қол жеткіздім...>
Dialogue: 0,0:09:55.80,0:09:58.89,Default,,0,0,0,,Сондықтан мен жақсылықты қайтарғым келеді
Dialogue: 0,0:09:59.01,0:10:01.55,Default,,0,0,0,,Мен де біреуге көмектескім келеді
Dialogue: 0,0:10:02.14,0:10:05.23,Default,,0,0,0,,<«Күн әулие Элькарон»...>
Dialogue: 0,0:10:05.43,0:10:08.06,Default,,0,0,0,,<Күн әулие! ＞
Dialogue: 0,0:10:14.78,0:10:17.03,Default,,0,0,0,,♬~
Dialogue: 0,0:10:21.24,0:10:22.49,Default,,0,0,0,,Га
Dialogue: 0,0:10:23.49,0:10:25.83,Default,,0,0,0,,Ахх!
Dialogue: 0,0:10:43.85,0:10:47.35,Default,,0,0,0,,Ах, ақыры есіме түсті.
Dialogue: 0,0:10:47.60,0:10:50.48,Default,,0,0,0,,<Менің атым Шигеру Йошиока>
Dialogue: 0,0:10:50.65,0:10:53.36,Default,,0,0,0,,<Мен өзім де, өзгелер де мойындайтын ұсқынсыз адаммын>
Dialogue: 0,0:10:53.77,0:10:58.11,Default,,0,0,0,,<Осы шіркіннің жүзіне мақтанышпен өмір сүрдім>
Dialogue: 0,0:11:04.99,0:11:07.33,Default,,0,0,0,,<Иә, мен...>
Dialogue: 0,0:11:07.45,0:11:10.46,Default,,0,0,0,,<Бұл шіркін күрескер>
Dialogue: 0,0:11:12.42,0:11:14.09,Default,,0,0,0,,♬~
Dialogue: 0,0:11:18.88,0:11:19.92,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:20.09,0:11:21.93,Default,,0,0,0,,Шигеру-сан! Ха
Dialogue: 0,0:11:25.26,0:11:28.64,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:11:29.98,0:11:32.48,Default,,0,0,0,,Қалғанын маған қалдырыңыз.
Dialogue: 0,0:11:32.60,0:11:34.94,Default,,0,0,0,,Бірақ Шигеру ше?
Dialogue: 0,0:11:35.23,0:11:36.32,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:36.44,0:11:39.90,Default,,0,0,0,,Мен әркімнің сезімін мұра етіп алып, саған жеткіземін.
Dialogue: 0,0:11:40.07,0:11:41.15,Default,,0,0,0,,Е...
Dialogue: 0,0:11:41.36,0:11:43.11,Default,,0,0,0,,Шигеру-сан…
Dialogue: 0,0:11:46.45,0:11:47.91,Default,,0,0,0,,Тағы бір Габе
Dialogue: 0,0:12:11.77,0:12:13.60,Default,,0,0,0,,Шигеру-кун...
Dialogue: 0,0:12:13.73,0:12:18.27,Default,,0,0,0,,Аха, бұл түрі саған жақсырақ жарасады.
Dialogue: 0,0:12:20.86,0:12:24.99,Default,,0,0,0,,Осы кезеңде де мен барлығын қорғауға тырысамын.
Dialogue: 0,0:12:25.24,0:12:29.49,Default,,0,0,0,,Бұдан былай бұл менің сен сияқты абсолютті құдай ретіндегі рөлім.
Dialogue: 0,0:12:29.79,0:12:33.67,Default,,0,0,0,,Иә? Сіз мен сияқты екеніңізге келісесіз бе?
Dialogue: 0,0:12:34.00,0:12:35.29,Default,,0,0,0,,О
Dialogue: 0,0:12:43.72,0:12:45.34,Default,,0,0,0,,От шары
Dialogue: 0,0:13:11.62,0:13:14.83,Default,,0,0,0,,<Менің кішіпейіл өзін-өзі бағалауым бұрмаланған>
Dialogue: 0,0:13:15.08,0:13:18.08,Default,,0,0,0,,<Құдайдың құдіретін еш себепсіз алған>
Dialogue: 0,0:13:18.54,0:13:20.80,Default,,0,0,0,,<Ал біреуді аулақ ұста...>
Dialogue: 0,0:13:20.96,0:13:22.34,Default,,0,0,0,,Ахахахаха
Dialogue: 0,0:13:22.63,0:13:23.67,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:26.26,0:13:28.43,Default,,0,0,0,,Аха ха ха ха
Dialogue: 0,0:13:35.10,0:13:37.85,Default,,0,0,0,,Сен екеуміз бірдейміз...
Dialogue: 0,0:13:37.98,0:13:40.98,Default,,0,0,0,,Құдай деген атқа лайық емес
Dialogue: 0,0:13:41.11,0:13:42.86,Default,,0,0,0,,Бұл екінші өмір...
Dialogue: 0,0:13:42.98,0:13:45.32,Default,,0,0,0,,Біз өзімізге...
Dialogue: 0,0:13:45.45,0:13:48.20,Default,,0,0,0,,Қайталап көруіміз керек емес пе?
Dialogue: 0,0:13:48.32,0:13:49.53,Default,,0,0,0,,Карина
Dialogue: 0,0:13:49.66,0:13:51.70,Default,,0,0,0,,Жоқ, Рейко Ширатори
Dialogue: 0,0:13:51.83,0:13:52.74,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:53.37,0:13:56.41,Default,,0,0,0,,Сіз мені осы атпен атайсыз!
Dialogue: 0,0:13:57.21,0:13:59.25,Default,,0,0,0,,Үлкен жарылыс үзіліс!
Dialogue: 0,0:14:00.50,0:14:03.34,Default,,0,0,0,,＜Қарғыс атсын, мен одан бас тарта алмаймын＞
Dialogue: 0,0:14:06.34,0:14:08.26,Default,,0,0,0,,<Сиқырлы күш басқа деңгейде>
Dialogue: 0,0:14:08.38,0:14:10.39,Default,,0,0,0,,<Басқа қабілет мәндері де болуы мүмкін...>
Dialogue: 0,0:14:13.01,0:14:14.14,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:14.27,0:14:16.02,Default,,0,0,0,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:14:16.14,0:14:21.36,Default,,0,0,0,,Тоқта, тоқта, тоқта, Алла разы болсын, анау бала...
Dialogue: 0,0:14:21.56,0:14:23.86,Default,,0,0,0,,Киоконы өлтір!
Dialogue: 0,0:14:26.74,0:14:27.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:30.87,0:14:32.12,Default,,0,0,0,,Рейко Ширатори!
Dialogue: 0,0:14:32.45,0:14:34.66,Default,,0,0,0,,Мен де Киоконың құрбаны болдым!
Dialogue: 0,0:14:34.83,0:14:36.16,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:36.29,0:14:39.04,Default,,0,0,0,,Иә, жалған жала жабу...
Dialogue: 0,0:14:39.17,0:14:43.17,Default,,0,0,0,,Ах, Киоко Ширатори менің өмірімді жойды.
Dialogue: 0,0:14:43.29,0:14:46.42,Default,,0,0,0,,Сондықтан мен реинкарнацияланып, басқа адамға айналдым.
Dialogue: 0,0:14:48.93,0:14:50.22,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:14:50.34,0:14:54.18,Default,,0,0,0,,Реинкарнациядан кейін де, сіз әлі де қарындасыңыздың арбауындасыз ба?
Dialogue: 0,0:14:55.85,0:14:57.27,Default,,0,0,0,,Эй, Шигеру-кун
Dialogue: 0,0:14:57.39,0:15:00.90,Default,,0,0,0,,Сен екеуміз бірдейміз, солай ма? Бірақ...
Dialogue: 0,0:15:01.90,0:15:05.19,Default,,0,0,0,,Неліктен мұндай айырмашылық бар?
Dialogue: 0,0:15:05.44,0:15:09.40,Default,,0,0,0,,Ал, мен білетін бір ғана нәрсе бар
Dialogue: 0,0:15:10.15,0:15:11.91,Default,,0,0,0,,<Мен олармен кездесе алдым>
Dialogue: 0,0:15:12.45,0:15:13.91,Default,,0,0,0,,Осымен
Dialogue: 0,0:15:14.95,0:15:15.95,Default,,0,0,0,,Ахаха
Dialogue: 0,0:15:16.12,0:15:19.00,Default,,0,0,0,,Егер сіз реинкарнация болсаңыз да, бұл бәрібір ақымақ ойын!
Dialogue: 0,0:15:19.12,0:15:23.33,Default,,0,0,0,,Жетеді! Менің қасымнан жоғал!
Dialogue: 0,0:15:23.46,0:15:26.30,Default,,0,0,0,,<Бәрекелді, оқтың саны мен күші шектен шығады>
Dialogue: 0,0:15:28.51,0:15:30.84,Default,,0,0,0,,Жұлдызды шаңның финалы!
Dialogue: 0,0:15:35.85,0:15:37.14,Default,,0,0,0,,♬~
Dialogue: 0,0:15:40.02,0:15:41.23,Default,,0,0,0,,Уф
Dialogue: 0,0:15:47.15,0:15:49.82,Default,,0,0,0,,Бұл пайдасыз қарсылық деп ойламайсыз ба?
Dialogue: 0,0:15:49.94,0:15:53.24,Default,,0,0,0,,Мен кез келген шеберлікте жақсымын, солай ма?
Dialogue: 0,0:15:53.41,0:15:55.62,Default,,0,0,0,,Жоқ, жеткілікті
Dialogue: 0,0:15:55.74,0:15:59.70,Default,,0,0,0,,Енді тексеру. Тіпті бұл кеңістікте сіз жұлдыздарды шақыра аласыз.
Dialogue: 0,0:15:59.83,0:16:01.75,Default,,0,0,0,,Метеордың соғуы!
Dialogue: 0,0:16:02.25,0:16:03.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:05.42,0:16:06.79,Default,,0,0,0,,Иә
Dialogue: 0,0:16:06.92,0:16:11.26,Default,,0,0,0,,Сіз менің сиқырыма үлкен метеоритпен қарсы тұрғыңыз келе ме?
Dialogue: 0,0:16:11.51,0:16:13.76,Default,,0,0,0,,Бірақ сіз не білесіз?
Dialogue: 0,0:16:13.89,0:16:15.89,Default,,0,0,0,,Канның ең жоғары деңгейдегі шеберлігі
Dialogue: 0,0:16:16.05,0:16:18.47,Default,,0,0,0,,«Соңғы мақсат Кай 2 (екі)» болып табылады
Dialogue: 0,0:16:18.97,0:16:23.23,Default,,0,0,0,,Кез келген зат ізсіз жоғалып кетуі мүмкін.
Dialogue: 0,0:16:23.35,0:16:26.77,Default,,0,0,0,,Мен жеңгенім өкінішті.
Dialogue: 0,0:16:27.11,0:16:30.23,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:16:30.57,0:16:33.24,Default,,0,0,0,,<Мен осы сәтті күттім! ＞
Dialogue: 0,0:16:33.99,0:16:36.24,Default,,0,0,0,,<Ол трюк мен ешқашан ұмытпаймын>
Dialogue: 0,0:16:36.37,0:16:40.04,Default,,0,0,0,,<Растау кідірісі тым күшті болғандықтан пайда болады! ＞
Dialogue: 0,0:16:40.16,0:16:45.25,Default,,0,0,0,,<Сонымен қатар, мен пайдаланылмаған 10 квинтиллион бонустық ұпайларды пайдаландым>
Dialogue: 0,0:16:45.37,0:16:47.71,Default,,0,0,0,,<"Жылдамдығыңызды" арттырыңыз! ＞
Dialogue: 0,0:16:48.63,0:16:53.30,Default,,0,0,0,,<Соқыр нүктеден растау сәтінде, соққы беріңіз! ＞
Dialogue: 0,0:16:56.47,0:17:01.93,Default,,0,0,0,,Бұл 10 квинтиллион, 5 триллион қосылған қуатпен лездік дағды.
Dialogue: 0,0:17:02.31,0:17:05.39,Default,,0,0,0,,Метеордың құлауы!!
Dialogue: 0,0:17:06.69,0:17:10.27,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:17:27.33,0:17:28.67,Default,,0,0,0,,Қош бол
Dialogue: 0,0:17:42.39,0:17:44.27,Default,,0,0,0,,Уф
Dialogue: 0,0:17:44.60,0:17:47.44,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:17:49.31,0:17:52.23,Default,,0,0,0,,(Сейджи мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:17:52.65,0:17:54.40,Default,,0,0,0,,Шигеру-сан!
Dialogue: 0,0:17:55.28,0:17:56.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:58.78,0:18:00.78,Default,,0,0,0,,Жақсы, жақсы болдыңыз ба?
Dialogue: 0,0:18:00.95,0:18:02.95,Default,,0,0,0,,Иә, әйтеуір
Dialogue: 0,0:18:03.08,0:18:06.62,Default,,0,0,0,,Абсолютті құдай Карина бір жерде жоғалып кеткен сияқты.
Dialogue: 0,0:18:06.79,0:18:08.58,Default,,0,0,0,,Күткендей, Шигеру-сан...
Dialogue: 0,0:18:08.75,0:18:11.04,Default,,0,0,0,,А, жоқ, менде ештеңе жоқ...
Dialogue: 0,0:18:11.46,0:18:15.38,Default,,0,0,0,,Мүмкін бұл Зиг Шнайдер деген жігіттің арқасы шығар?
Dialogue: 0,0:18:15.51,0:18:16.97,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:17.30,0:18:18.68,Default,,0,0,0,,Ол біртүрлі адам еді.
Dialogue: 0,0:18:18.80,0:18:21.47,Default,,0,0,0,,Күткендей, сен менің ханзадамсың!
Dialogue: 0,0:18:21.60,0:18:23.76,Default,,0,0,0,,Бір күні тағы кездесетінімізге сенемін!
Dialogue: 0,0:18:24.14,0:18:26.98,Default,,0,0,0,,＜Жоқ, ол енді ешқашан пайда болмайды＞
Dialogue: 0,0:18:27.81,0:18:30.44,Default,,0,0,0,,Мен бұл шайқаста дәрменсіз қалдым.
Dialogue: 0,0:18:30.65,0:18:31.81,Default,,0,0,0,,Мен де
Dialogue: 0,0:18:31.94,0:18:34.03,Default,,0,0,0,,Мен де
Dialogue: 0,0:18:34.15,0:18:35.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:36.82,0:18:39.66,Default,,0,0,0,,Мен күштірек болуым керек.
Dialogue: 0,0:18:39.78,0:18:42.74,Default,,0,0,0,,Сезіміміз бір күні саған жетсін
Dialogue: 0,0:18:49.29,0:18:51.38,Default,,0,0,0,,Мен оның келгеніне сенімдімін.
Dialogue: 0,0:18:51.50,0:18:54.67,Default,,0,0,0,,Мен сенемін.
Dialogue: 0,0:18:56.96,0:18:59.80,Default,,0,0,0,,<Осыдан кейін Валерия княздігінің әскері ішке кірді>
Dialogue: 0,0:19:00.18,0:19:05.01,Default,,0,0,0,,<Ұйым мүшелері тапсырылып, шайқас аяқталды>
Dialogue: 0,0:19:10.64,0:19:15.02,Default,,0,0,0,,<Біздің «Висбридж» компаниясы да жолға шыға бастады>
Dialogue: 0,0:19:15.69,0:19:19.78,Default,,0,0,0,,<Соңғы уақытта мен әлеуметтік аударымдарға баса назар аудардым>
Dialogue: 0,0:19:21.11,0:19:23.78,Default,,0,0,0,,<Арнайы жазбалардың кемшіліктерін жеңу>
Dialogue: 0,0:19:24.28,0:19:29.29,Default,,0,0,0,,<Мұндай корпоративтік философия бірте-бірте таралып бара жатқан сияқты.>
Dialogue: 0,0:19:30.00,0:19:33.58,Default,,0,0,0,,<Оған дейін қиналғандар...>
Dialogue: 0,0:19:34.00,0:19:39.42,Default,,0,0,0,,＜Мүмкін бұл жолы мен екінші өмір сүре бастаған шығармын.＞
Dialogue: 0,0:19:47.68,0:19:50.10,Default,,0,0,0,,Шигеру-кун...
Dialogue: 0,0:19:50.81,0:19:54.11,Default,,0,0,0,,Бір күні мен сені артқа қаратамын
Dialogue: 0,0:19:57.32,0:19:58.61,Default,,0,0,0,,Лидс
Dialogue: 0,0:19:58.78,0:19:59.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:01.03,0:20:02.36,Default,,0,0,0,,Мүмкін сіз солай шығарсыз
Dialogue: 0,0:20:02.53,0:20:04.49,Default,,0,0,0,,Әли... (Като) Төраға! Мен тұтынушымын!
Dialogue: 0,0:20:04.62,0:20:06.33,Default,,0,0,0,,Сезане қаласынан!
Dialogue: 0,0:20:06.53,0:20:10.37,Default,,0,0,0,,Тұтынушы? Сезан туралы айтатын болсақ ...
Dialogue: 0,0:20:10.50,0:20:13.87,Default,,0,0,0,,(Сакурайдың ауыр тыныс алуы)
Dialogue: 0,0:20:14.08,0:20:16.63,Default,,0,0,0,,Шигеру-сан! Бұл не?
Dialogue: 0,0:20:16.84,0:20:18.88,Default,,0,0,0,,Иә! Бұл гамбургер
Dialogue: 0,0:20:19.26,0:20:22.97,Default,,0,0,0,,<Сейка-сан, сен бұрынғыдай сенімдісің>
Dialogue: 0,0:20:23.09,0:20:26.89,Default,,0,0,0,,Қазір тамақтанайық. Түскі үзіліс қысқа.
Dialogue: 0,0:20:27.01,0:20:28.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:29.77,0:20:31.89,Default,,0,0,0,,<Бұл әлі де Букичо>
Dialogue: 0,0:20:32.10,0:20:36.36,Default,,0,0,0,,<Сейка-сан менің «жел саяхатшысы» екенімді түсінбейді>
Dialogue: 0,0:20:37.15,0:20:39.90,Default,,0,0,0,,<Сол күні мен Халловаға бара жатыр едім>
Dialogue: 0,0:20:40.65,0:20:44.16,Default,,0,0,0,,<Бірақ жолда мен адамдармен кездесуден қорықтым.>
Dialogue: 0,0:20:44.36,0:20:46.03,Default,,0,0,0,,(Балалар дауысы)
Dialogue: 0,0:20:46.24,0:20:47.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:47.78,0:20:53.41,Default,,0,0,0,,Қара, көр, көр, көр.
Dialogue: 0,0:20:53.79,0:20:55.54,Default,,0,0,0,,Таңғышты шешіңіз!
Dialogue: 0,0:20:56.42,0:21:00.46,Default,,0,0,0,,<Сол кездегі батылдық лаулаған күнде де>
Dialogue: 0,0:21:00.59,0:21:02.92,Default,,0,0,0,,<Ол менің жалғыз мақтанышым болып қалды>
Dialogue: 0,0:21:03.80,0:21:07.18,Default,,0,0,0,,<Лидс айтқандай, төртеуміз кездесе алдық>
Dialogue: 0,0:21:07.30,0:21:08.93,Default,,0,0,0,,<Бұл кездейсоқтық емес>
Dialogue: 0,0:21:09.68,0:21:13.89,Default,,0,0,0,,<Жылдар бойы жинақталған ант, тілек, дұға>
Dialogue: 0,0:21:14.06,0:21:16.40,Default,,0,0,0,,<Ол жеміс берудің нәтижесі болуы керек...>
Dialogue: 0,0:21:20.23,0:21:22.94,Default,,0,0,0,,Екеуің де! Бұл кезек күттірмейтін мәселе
Dialogue: 0,0:21:23.15,0:21:26.82,Default,,0,0,0,,Президент Сакурайдан Орднунг Найза туралы ақпарат.
Dialogue: 0,0:21:27.11,0:21:28.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:28.66,0:21:32.16,Default,,0,0,0,,<Сейджи патша болу үшін сөзсіз қиындықтар>
Dialogue: 0,0:21:32.41,0:21:35.50,Default,,0,0,0,,Қазір жұмысқа барыңыз! Стратегиялық кездесу өткізіңіз!
Dialogue: 0,0:21:36.96,0:21:39.54,Default,,0,0,0,,Шигеру-сан! кеттік
Dialogue: 0,0:21:39.67,0:21:41.59,Default,,0,0,0,,<Шимауууууу>
Dialogue: 0,0:21:43.67,0:21:49.55,Default,,0,0,0,,<Гоооооооо~>
Dialogue: 0,0:21:49.89,0:21:51.60,Default,,0,0,0,,А, Шигеру-сан?
Dialogue: 0,0:21:51.76,0:21:54.31,Default,,0,0,0,,Жоқ, ештеңе...
Dialogue: 0,0:21:54.60,0:21:59.10,Default,,0,0,0,,＜Болашақта көп қиындық болатын сияқты.＞
Dialogue: 0,0:22:04.07,0:22:05.90,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:22:07.45,0:22:09.99,Default,,0,0,0,,<Мен сені бақытты етемін>
Dialogue: 0,0:22:10.62,0:22:14.04,Default,,0,0,0,,<Біз ешқашан көңілімізді қалдырмаймыз>
Dialogue: 0,0:22:19.96,0:22:22.92,Default,,0,0,0,,♪～
Dialogue: 0,0:23:34.16,0:23:37.12,Default,,0,0,0,,～♪
