Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.21,0:00:05.54,Default,,0,0,0,,<Менің атым Шигеру Йошиока>
Dialogue: 0,0:00:06.00,0:00:08.55,Default,,0,0,0,,<Мен өзім де, өзгелер де мойындайтын ұсқынсыз адаммын>
Dialogue: 0,0:00:09.30,0:00:12.80,Default,,0,0,0,,<Осы шіркіннің жүзіне мақтанышпен өмір сүрдім>
Dialogue: 0,0:00:13.47,0:00:16.05,Default,,0,0,0,,Бастық! Бастықтың нұсқауы қанша болса да
Dialogue: 0,0:00:16.35,0:00:17.76,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:00:17.89,0:00:20.81,Default,,0,0,0,,Егер сіз жақсы жұмыс жасасаңыз, тұтынушылар міндетті түрде сізге ереді!
Dialogue: 0,0:00:22.06,0:00:25.81,Default,,0,0,0,,<Мен шіркін ішегіммен сату жұмысына жабысып қалдым>
Dialogue: 0,0:00:26.31,0:00:28.52,Default,,0,0,0,,<Менің ұраным - тұтынушы...>
Dialogue: 0,0:00:28.65,0:00:30.78,Default,,0,0,0,,<Біреуді күлдірту үшін>
Dialogue: 0,0:00:31.36,0:00:33.65,Default,,0,0,0,,<Үміт ешқашан ақталмайды>
Dialogue: 0,0:00:36.16,0:00:41.04,Default,,0,0,0,,<Әрине, ол әйелдер арасында танымал емес еді, бірақ ол қанағаттанарлық өмір сүрді>
Dialogue: 0,0:00:41.16,0:00:42.04,Default,,0,0,0,,(поезд мүйізі)
Dialogue: 0,0:00:42.16,0:00:43.58,Default,,0,0,0,,<Сол күнге дейін...>
Dialogue: 0,0:00:44.54,0:00:46.42,Default,,0,0,0,,Мына жігіт азғын!
Dialogue: 0,0:00:46.54,0:00:48.63,Default,,0,0,0,,Не!? Мен мұны істемедім!
Dialogue: 0,0:00:48.75,0:00:50.46,Default,,0,0,0,,Қолдарыңыз толық!
Dialogue: 0,0:00:51.09,0:00:52.42,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:53.88,0:00:58.47,Default,,0,0,0,,(Халықтың қарғысы)
Dialogue: 0,0:00:58.60,0:01:01.81,Default,,0,0,0,,<Көп мөлшердегі эротикалық ойындары бар шіркіннің сөзі>
Dialogue: 0,0:01:01.93,0:01:03.48,Default,,0,0,0,,<Ешкім сенбейді>
Dialogue: 0,0:01:04.06,0:01:06.69,Default,,0,0,0,,<Дүние шіркіндерге қатыгез>
Dialogue: 0,0:01:08.44,0:01:11.61,Default,,0,0,0,,«Негізгі мәтін Айыпталушы Шигеру Йошиока»
Dialogue: 0,0:01:11.78,0:01:16.24,Default,,0,0,0,,«Қиындықтың алдын алу туралы ережені бұзғаны үшін 300 000 иен көлемінде айыппұл салынады».
Dialogue: 0,0:01:17.11,0:01:22.29,Default,,0,0,0,,<Сот отырысының уақытын сатып алғандай кінәмді мойындадым>
Dialogue: 0,0:01:23.04,0:01:24.16,Default,,0,0,0,,<Бірақ...>
Dialogue: 0,0:01:24.45,0:01:27.50,Default,,0,0,0,,<Осы кезде менің өмірім тоқырауға ұшырады>
Dialogue: 0,0:01:29.17,0:01:30.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:31.42,0:01:35.51,Default,,0,0,0,,<Бірнеше жылдан кейін мені жерге қаратқан әйел ұсталды>
Dialogue: 0,0:01:35.76,0:01:37.26,Default,,0,0,0,,Бол
Dialogue: 0,0:01:37.38,0:01:39.80,Default,,0,0,0,,<Қылмыскерді жалған қорлауды қайталау>
Dialogue: 0,0:01:39.93,0:01:43.27,Default,,0,0,0,,<«Мен шіркін сасық демге шыдай алмадым». Бұл дұрыс.
Dialogue: 0,0:01:43.85,0:01:47.52,Default,,0,0,0,,<Әйел кәмелетке толмағандықтан оған қорғаныс шаралары қолданылды.>
Dialogue: 0,0:01:47.98,0:01:51.52,Default,,0,0,0,,<Мен ашуландым, бірақ ештеңе істей алмадым>
Dialogue: 0,0:01:51.77,0:01:52.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:53.65,0:01:56.99,Default,,0,0,0,,(Балалар дауысы)
Dialogue: 0,0:01:57.11,0:02:00.53,Default,,0,0,0,,Сен жиіркеніштісің, (бала) Бут!
Dialogue: 0,0:02:00.78,0:02:02.74,Default,,0,0,0,,<Мен мақтанған шіркін>
Dialogue: 0,0:02:02.87,0:02:04.24,Default,,0,0,0,,<Мені азаптау>
Dialogue: 0,0:02:04.41,0:02:06.75,Default,,0,0,0,,<Қарғыс сияқты>
Dialogue: 0,0:02:07.04,0:02:11.67,Default,,0,0,0,,<Мен жалған айып тағылудың салдарынан лайықты өмір сүре алмаймын.>
Dialogue: 0,0:02:11.92,0:02:14.63,Default,,0,0,0,,Йошиока мырза, не болды?
Dialogue: 0,0:02:15.63,0:02:16.42,Default,,0,0,0,,<Кейде>
Dialogue: 0,0:02:16.55,0:02:19.55,Default,,0,0,0,,<Қарым-қатынасы бұзылған ұсқынсыз адам ретінде менсінбей қалды>
Dialogue: 0,0:02:20.39,0:02:22.18,Default,,0,0,0,,<Білмей тұрып, 6 жыл өтті>
Dialogue: 0,0:02:22.35,0:02:25.56,Default,,0,0,0,,<Мен жұмыссыз хикикомори болдым.>
Dialogue: 0,0:02:25.97,0:02:30.52,Default,,0,0,0,,<Жинағанымды бітіріп, ата-анамның ақшасын ысырап еткен күндерім>
Dialogue: 0,0:02:30.90,0:02:32.52,Default,,0,0,0,,<Мал асты>
Dialogue: 0,0:02:33.73,0:02:35.07,Default,,0,0,0,,<Сол кезде>
Dialogue: 0,0:02:35.78,0:02:37.90,Default,,0,0,0,,Тағы бір жоғалып кету...
Dialogue: 0,0:02:38.03,0:02:40.57,Default,,0,0,0,,Мен де жоғалып кеттім хаха...
Dialogue: 0,0:02:41.37,0:02:43.91,Default,,0,0,0,,Ұрлау Адамның эксперименті
Dialogue: 0,0:02:44.03,0:02:46.91,Default,,0,0,0,,Үкіметтің NEET жұқарту теориясы біршама қызық, бірақ...
Dialogue: 0,0:02:47.95,0:02:48.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:49.33,0:02:51.17,Default,,0,0,0,,«Мен сәтсіздікке ұшырадым»
Dialogue: 0,0:02:51.33,0:02:54.17,Default,,0,0,0,,«Мен бонустық ұпайларды бөлуде қателік жібердім»
Dialogue: 0,0:02:54.34,0:02:56.59,Default,,0,0,0,,«Бастау - ең маңызды нәрсе».
Dialogue: 0,0:02:56.96,0:03:00.80,Default,,0,0,0,,«Бастапқы әлемге оралу үшін өміріңіздің жартысы қажет».
Dialogue: 0,0:03:00.97,0:03:02.59,Default,,0,0,0,,«Балалар, сендер жақсы жұмыс істеулерің керек».
Dialogue: 0,0:03:03.05,0:03:06.06,Default,,0,0,0,,Тағы бір дүние екінші өмір...
Dialogue: 0,0:03:06.31,0:03:09.06,Default,,0,0,0,,Хаха! Амал жоқ
Dialogue: 0,0:03:09.23,0:03:10.60,Default,,0,0,0,,Параметрлер тым күрделі
Dialogue: 0,0:03:14.69,0:03:18.61,Default,,0,0,0,,Артымнан!!
Dialogue: 0,0:03:18.90,0:03:20.86,Default,,0,0,0,,<сағат 2...>
Dialogue: 0,0:03:22.61,0:03:26.37,Default,,0,0,0,,<Компьютерді солтүстікке бұрып, терезені ашыңыз>
Dialogue: 0,0:03:26.54,0:03:29.37,Default,,0,0,0,,<Қолдарыңызды көтеріп, күтіңіз>
Dialogue: 0,0:03:29.54,0:03:32.37,Default,,0,0,0,,<Мен басқа әлемнен ештеңе күтпедім>
Dialogue: 0,0:03:32.50,0:03:35.29,Default,,0,0,0,,<Тек осы жаман күнде>
Dialogue: 0,0:03:35.42,0:03:38.30,Default,,0,0,0,,<Мен аздап бағымды сынап көргім келді>
Dialogue: 0,0:03:39.88,0:03:41.30,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:03:44.39,0:03:45.55,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:45.97,0:03:47.43,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:03:48.22,0:03:49.18,Default,,0,0,0,,<Вирус? ＞
Dialogue: 0,0:03:49.31,0:03:52.31,Default,,0,0,0,,<Төтенше жағдайда оны инициализациялаңыз>
Dialogue: 0,0:03:55.23,0:03:56.82,Default,,0,0,0,,<Бұл...>
Dialogue: 0,0:03:57.19,0:04:00.11,Default,,0,0,0,,<Сіз ДК-ден деректерді шығардыңыз ба? ＞
Dialogue: 0,0:04:00.49,0:04:04.32,Default,,0,0,0,,<Мен шынымен 16 жастан бастап қайта бастасам, риза болар едім>
Dialogue: 0,0:04:04.78,0:04:07.20,Default,,0,0,0,,<Жарайды, мен ұстаймын.>
Dialogue: 0,0:04:08.12,0:04:09.66,Default,,0,0,0,,<Көрініс...>
Dialogue: 0,0:04:09.87,0:04:11.83,Default,,0,0,0,,<Бұл мәнді өзгертуге бола ма?>
Dialogue: 0,0:04:12.16,0:04:14.42,Default,,0,0,0,,<Әзірше төмендетейік>
Dialogue: 0,0:04:18.38,0:04:19.46,Default,,0,0,0,,<Oh>
Dialogue: 0,0:04:19.88,0:04:22.22,Default,,0,0,0,,<13000 бонус>
Dialogue: 0,0:04:22.59,0:04:25.97,Default,,0,0,0,,<Көрінісімді төмендетсем, ұпай ала аламын ба?>
Dialogue: 0,0:04:26.34,0:04:28.68,Default,,0,0,0,,<Бұл ерекше ескерту ме? ＞
Dialogue: 0,0:04:29.60,0:04:33.23,Default,,0,0,0,,<Әдетте мен жақсы нәрсе жазар едім.>
Dialogue: 0,0:04:33.35,0:04:35.98,Default,,0,0,0,,<Егер сіз өзіңіздің әлсіз жақтарыңызды жазуға батыл болсаңыз...>
Dialogue: 0,0:04:38.06,0:04:40.44,Default,,0,0,0,,<"Депозит мөлшерлемесі 1/10 000">
Dialogue: 0,0:04:40.57,0:04:43.70,Default,,0,0,0,,<"Қызға қол тигізсеңіз, HP 10%-ға азаяды">
Dialogue: 0,0:04:44.15,0:04:48.24,Default,,0,0,0,,<"Жыныстық қатынас болса, шашылып өлесің">
Dialogue: 0,0:04:48.41,0:04:49.37,Default,,0,0,0,,<Иә>
Dialogue: 0,0:04:49.70,0:04:51.37,Default,,0,0,0,,<Бұл туралы не айтасыз! ＞
Dialogue: 0,0:04:57.58,0:05:01.09,Default,,0,0,0,,<Бонус ұпайлары 100 триллионнан 5100-ге дейін! ＞
Dialogue: 0,0:05:01.21,0:05:05.34,Default,,0,0,0,,<Енді біз бұл 100 триллионды қалай бөлуіміз керек?>
Dialogue: 0,0:05:09.14,0:05:10.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:16.60,0:05:19.56,Default,,0,0,0,,♪～
Dialogue: 0,0:06:40.44,0:06:43.40,Default,,0,0,0,,～♪
Dialogue: 0,0:06:46.69,0:06:47.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:48.53,0:06:49.40,Default,,0,0,0,,Е...
Dialogue: 0,0:06:49.82,0:06:52.32,Default,,0,0,0,,<Аа... бұл...>
Dialogue: 0,0:06:54.08,0:06:55.45,Default,,0,0,0,,<Арман? ＞
Dialogue: 0,0:06:57.70,0:06:58.71,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:00.96,0:07:01.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:02.08,0:07:04.09,Default,,0,0,0,,<Бұл мен...>
Dialogue: 0,0:07:04.29,0:07:06.67,Default,,0,0,0,,<Минус 255 көрініс...>
Dialogue: 0,0:07:08.05,0:07:10.05,Default,,0,0,0,,<Үмітсіздіктен басқа ештеңе жоқ...>
Dialogue: 0,0:07:10.26,0:07:12.80,Default,,0,0,0,,А, сен ояндың.
Dialogue: 0,0:07:13.64,0:07:16.31,Default,,0,0,0,,<Кім? Ал неге іш киім? ＞
Dialogue: 0,0:07:18.39,0:07:19.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:19.68,0:07:21.35,Default,,0,0,0,,Соншалықты немқұрайлы болғаным үшін кешіріңіз <Жоқ...>
Dialogue: 0,0:07:21.48,0:07:23.40,Default,,0,0,0,,<Бұл шынымен басқа дүние ме? ＞
Dialogue: 0,0:07:24.23,0:07:26.57,Default,,0,0,0,,Ах, рақмет.
Dialogue: 0,0:07:30.61,0:07:31.82,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:34.41,0:07:35.99,Default,,0,0,0,,Өзіңізді жақсы сезінетін нәрсе.
Dialogue: 0,0:07:36.12,0:07:40.08,Default,,0,0,0,,<Осы дүниеде де әдемі еркектер мен ұсқынсыз еркектер арасындағы айырмашылық сол күйінде қалады>
Dialogue: 0,0:07:40.25,0:07:43.46,Default,,0,0,0,,Менің атым Сейджи.
Dialogue: 0,0:07:43.63,0:07:45.84,Default,,0,0,0,,16 жаста болуы керек
Dialogue: 0,0:07:45.96,0:07:47.34,Default,,0,0,0,,<Сергітетін әдемі>
Dialogue: 0,0:07:47.71,0:07:50.13,Default,,0,0,0,,Менің де жасым 16-да
Dialogue: 0,0:07:50.26,0:07:51.30,Default,,0,0,0,,<Лори бала>
Dialogue: 0,0:07:51.42,0:07:53.34,Default,,0,0,0,,<Аты-жөніңізді айтқыңыз келмейтін сияқты>
Dialogue: 0,0:07:53.68,0:07:57.10,Default,,0,0,0,,Мен де... Менің атым Сейка.
Dialogue: 0,0:07:57.22,0:07:59.06,Default,,0,0,0,,<Цундере жас ханым>
Dialogue: 0,0:07:59.18,0:08:01.43,Default,,0,0,0,,<Бәрінің жасы белгіленген жаспен бірдей ме...>
Dialogue: 0,0:08:02.02,0:08:04.35,Default,,0,0,0,,Мен де... 16 жастамын.
Dialogue: 0,0:08:04.48,0:08:06.36,Default,,0,0,0,,Я, мен оны шынымен көре алмаймын.
Dialogue: 0,0:08:06.48,0:08:07.94,Default,,0,0,0,,<Шынымен бе?>
Dialogue: 0,0:08:08.07,0:08:09.03,Default,,0,0,0,,Оның қадір-қасиеті бар!
Dialogue: 0,0:08:09.15,0:08:11.11,Default,,0,0,0,,<Күтпеген оқиға>
Dialogue: 0,0:08:11.40,0:08:13.99,Default,,0,0,0,,Сонымен, балалар, сендер де интернетті пайдаланасыңдар ма?
Dialogue: 0,0:08:14.49,0:08:17.12,Default,,0,0,0,,«Сағат 2, компьютерді солтүстікке бұрыңыз»
Dialogue: 0,0:08:17.37,0:08:19.24,Default,,0,0,0,,А, мен мұны істедім.
Dialogue: 0,0:08:19.45,0:08:20.50,Default,,0,0,0,,Мен де
Dialogue: 0,0:08:20.95,0:08:23.71,Default,,0,0,0,,Иә, мен де.
Dialogue: 0,0:08:23.96,0:08:28.00,Default,,0,0,0,,Сонда бұл шынымен екінші өмір...басқа әлемге келдің бе?
Dialogue: 0,0:08:28.13,0:08:30.34,Default,,0,0,0,,Мен оның жартылай жалаңаш болады деп күтпедім.
Dialogue: 0,0:08:30.46,0:08:31.72,Default,,0,0,0,,Дұрыс (Сейка) Хэхе...
Dialogue: 0,0:08:31.84,0:08:34.01,Default,,0,0,0,,Суық емес пе? (Сейка) Хе, жарайды.
Dialogue: 0,0:08:34.18,0:08:36.51,Default,,0,0,0,,<Кешіріңіз, бірақ үйреніп кетейін деген ойым жоқ>
Dialogue: 0,0:08:36.72,0:08:40.39,Default,,0,0,0,,<Дос болсақ та, бәрібір...>
Dialogue: 0,0:08:40.85,0:08:41.64,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:45.73,0:08:49.73,Default,,0,0,0,,<Түсіндім, менің депозит мөлшерлемесі 1/10 000>
Dialogue: 0,0:08:49.86,0:08:51.82,Default,,0,0,0,,<Сонымен қатар, бөлшектер төмен дөңгелектенеді...>
Dialogue: 0,0:08:51.94,0:08:53.53,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:08:53.86,0:08:55.53,Default,,0,0,0,,ештеңе
Dialogue: 0,0:08:55.74,0:08:57.82,Default,,0,0,0,,Сен бе, әм...
Dialogue: 0,0:08:57.95,0:08:59.28,Default,,0,0,0,,Бұл Шигеру
Dialogue: 0,0:08:59.74,0:09:02.04,Default,,0,0,0,,Сізге көп рахмет, Шигеру-сан.
Dialogue: 0,0:09:05.42,0:09:06.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:06.96,0:09:09.54,Default,,0,0,0,,Төрт нәрсені тең бөлеміз бе?
Dialogue: 0,0:09:10.46,0:09:13.55,Default,,0,0,0,,<Мен бұл киімді кие алмаймын...>
Dialogue: 0,0:09:13.67,0:09:15.93,Default,,0,0,0,,<Мен түсіндім. Не болып жатыр? ＞
Dialogue: 0,0:09:16.05,0:09:18.05,Default,,0,0,0,,Уау, тамаша өлшем
Dialogue: 0,0:09:18.26,0:09:20.31,Default,,0,0,0,,Бұл шынымен басқа әлем.
Dialogue: 0,0:09:20.47,0:09:21.72,Default,,0,0,0,,<Реттеу жақсы>
Dialogue: 0,0:09:21.85,0:09:23.56,Default,,0,0,0,,Бірақ бұл біртүрлі (Seika/Girl) иә?
Dialogue: 0,0:09:23.77,0:09:28.06,Default,,0,0,0,,Заттар мен қаруларды 4 тең бөлікке бөлуге болады, бірақ тек 7 алтын монета...
Dialogue: 0,0:09:28.31,0:09:30.40,Default,,0,0,0,,Оны тең төрт бөлікке бөлуге болмайды.
Dialogue: 0,0:09:30.52,0:09:32.61,Default,,0,0,0,,Біреу мысықпен араласып кетті ме?
Dialogue: 0,0:09:32.73,0:09:34.03,Default,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,0:09:34.15,0:09:35.82,Default,,0,0,0,,Эй, Шигеру-сан
Dialogue: 0,0:09:35.99,0:09:37.53,Default,,0,0,0,,<Мен бұған қатты күмәнданамын>
Dialogue: 0,0:09:37.66,0:09:40.24,Default,,0,0,0,,<Бір картаны өшіргенім рас, бірақ...>
Dialogue: 0,0:09:40.53,0:09:42.83,Default,,0,0,0,,Маған ақша керек емес, барлығымен бөліс.
Dialogue: 0,0:09:42.99,0:09:44.66,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:09:44.79,0:09:48.04,Default,,0,0,0,,Бұл жақсы емес пе? Мен ризамын және оны аламын.
Dialogue: 0,0:09:48.25,0:09:51.84,Default,,0,0,0,,Жеті алтынның барлығын Шигеруден басқа біреу тапқан.
Dialogue: 0,0:09:51.96,0:09:53.42,Default,,0,0,0,,<Дұрыс>
Dialogue: 0,0:09:53.55,0:09:56.59,Default,,0,0,0,,<Алтын тиынды тапсам да, елемей қалдым.> (Сейка) Шигеру-сан! Оны дұрыстап іздеңіз!
Dialogue: 0,0:09:56.84,0:10:00.43,Default,,0,0,0,,Мен оның жалаңаш қыздарға құмар болғаны сонша, тіпті оларды іздей алмайтынына сенімдімін.
Dialogue: 0,0:10:00.55,0:10:02.60,Default,,0,0,0,,＜Мұны айту қорқынышты нәрсе сияқты＞
Dialogue: 0,0:10:03.06,0:10:06.14,Default,,0,0,0,,Ақшаның орнына балта бере аласыз ба?
Dialogue: 0,0:10:06.27,0:10:08.23,Default,,0,0,0,,Өтінемін, өзімшіл ештеңе айтпаңыз!
Dialogue: 0,0:10:08.48,0:10:09.65,Default,,0,0,0,,Шигеру-сан
Dialogue: 0,0:10:09.77,0:10:12.69,Default,,0,0,0,,Егер сіз тым көп тұрсаңыз, сіз қайтадан сәтсіздікке ұшырайсыз.
Dialogue: 0,0:10:12.82,0:10:14.48,Default,,0,0,0,,Тағы да? (Сэйджи) А...
Dialogue: 0,0:10:14.69,0:10:18.03,Default,,0,0,0,,Кешіріңіз, бұл мен ғана.
Dialogue: 0,0:10:18.20,0:10:22.78,Default,,0,0,0,,Менің қарым-қатынасым бұзылған және өзімшіл мінез-құлқым айналамдағыларға қиындық туғызады...
Dialogue: 0,0:10:23.08,0:10:24.83,Default,,0,0,0,,<Мен мүлде көрмеймін...>
Dialogue: 0,0:10:24.95,0:10:29.54,Default,,0,0,0,,Мен осы екінші өмірді оны жеңу мүмкіндігі ретінде қабылдағым келеді.
Dialogue: 0,0:10:29.75,0:10:32.42,Default,,0,0,0,,Сондықтан мен Шигеру-санды да назардан тыс қалдыра алмаймын.
Dialogue: 0,0:10:32.54,0:10:33.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:33.55,0:10:35.63,Default,,0,0,0,,Шигеру-санның да қарым-қатынасы бұзылған, солай ма?
Dialogue: 0,0:10:36.05,0:10:37.84,Default,,0,0,0,,Осы мүмкіндікті жеңу үшін пайдаланыңыз!
Dialogue: 0,0:10:37.97,0:10:40.22,Default,,0,0,0,,<Сіз шынымен қарым-қатынас бұзылысысыз ба? ＞
Dialogue: 0,0:10:40.72,0:10:41.85,Default,,0,0,0,,(Исуми Миямура) Иә (Ишикава) Маған беріп тұрсың ба?
Dialogue: 0,0:10:41.97,0:10:45.06,Default,,0,0,0,,<Соңында қару тарату тас-қағаз-қайшыға айналды...>
Dialogue: 0,0:10:45.22,0:10:48.10,Default,,0,0,0,,<Мен қалған қызметкерлерді алып шықтым...>
Dialogue: 0,0:10:48.56,0:10:51.40,Default,,0,0,0,,Шигеру-сан, мойындап қол алысайық.
Dialogue: 0,0:10:52.65,0:10:54.19,Default,,0,0,0,,Мен олай істемеймін.
Dialogue: 0,0:10:54.48,0:10:57.15,Default,,0,0,0,,<Екінші өміріме дейін қиналғым келмейді>
Dialogue: 0,0:10:57.28,0:10:59.53,Default,,0,0,0,,<Мен жалғыз өмір сүремін...>
Dialogue: 0,0:11:00.45,0:11:01.66,Default,,0,0,0,,...
Dialogue: 0,0:11:02.41,0:11:06.37,Default,,0,0,0,,<Осы көзқарастың орнына алдым>
Dialogue: 0,0:11:06.49,0:11:09.46,Default,,0,0,0,,<Супер алдау күйі>
Dialogue: 0,0:11:11.71,0:11:14.54,Default,,0,0,0,,Олай болса Ирия қаласына барайық.
Dialogue: 0,0:11:14.79,0:11:16.88,Default,,0,0,0,,Карта бойынша бұл ең жақын қала.
Dialogue: 0,0:11:17.01,0:11:18.38,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,0:11:18.55,0:11:20.68,Default,,0,0,0,,Шигеру-сан! Мен сапарға кетемін
Dialogue: 0,0:11:20.97,0:11:24.05,Default,,0,0,0,,<Қолымнан келмейді, жолда сақтық көшіремін...>
Dialogue: 0,0:11:24.76,0:11:26.93,Default,,0,0,0,,Шуппацу!
Dialogue: 0,0:11:27.39,0:11:29.64,Default,,0,0,0,,Иә! (гоблин жылайды)
Dialogue: 0,0:11:29.89,0:11:31.44,Default,,0,0,0,,Кяах!
Dialogue: 0,0:11:31.56,0:11:33.81,Default,,0,0,0,,Фуууууууууу! (Гоблин айқайлайды)
Dialogue: 0,0:11:35.27,0:11:36.65,Default,,0,0,0,,<Үкім тез! ＞
Dialogue: 0,0:11:36.77,0:11:37.73,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:11:37.86,0:11:39.32,Default,,0,0,0,,(Кёсукэ Хори) Егер әке кетіп қалса—
Dialogue: 0,0:11:39.53,0:11:40.95,Default,,0,0,0,,А, бұл!
Dialogue: 0,0:11:44.16,0:11:46.49,Default,,0,0,0,,Біз қару-жарақпен оны тоқтатамыз!
Dialogue: 0,0:11:46.62,0:11:49.25,Default,,0,0,0,,Осы кезде Сейка-сан садағын тартады!
Dialogue: 0,0:11:49.37,0:11:50.62,Default,,0,0,0,,Иә
Dialogue: 0,0:11:50.75,0:11:53.33,Default,,0,0,0,,Шигеру-сан, Сейка-санды қолда!
Dialogue: 0,0:11:53.50,0:11:56.13,Default,,0,0,0,,Солға бұрылыңыз! Мен оң жақтамын!
Dialogue: 0,0:11:57.42,0:11:58.71,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:58.88,0:12:01.42,Default,,0,0,0,,<Қарым-қатынас бұзылысы қайда? ＞
Dialogue: 0,0:12:01.55,0:12:03.38,Default,,0,0,0,,Иә! (Қыз) Ха!
Dialogue: 0,0:12:03.55,0:12:06.01,Default,,0,0,0,,Ха! (Қыз) Хмф!
Dialogue: 0,0:12:06.18,0:12:08.47,Default,,0,0,0,,(Сейканың күшті дауысы)
Dialogue: 0,0:12:09.10,0:12:10.64,Default,,0,0,0,,Ммммммммммм
Dialogue: 0,0:12:10.77,0:12:13.73,Default,,0,0,0,,<Алдымен садақ таңдадың, бірақ сен сондай әуесқойсың...>
Dialogue: 0,0:12:13.85,0:12:16.56,Default,,0,0,0,,Бұл не? Сіз де баруыңыз керек!
Dialogue: 0,0:12:16.69,0:12:18.98,Default,,0,0,0,,<Оны айтсаң да>
Dialogue: 0,0:12:19.19,0:12:20.53,Default,,0,0,0,,Шааааа!
Dialogue: 0,0:12:20.65,0:12:22.61,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:12:22.82,0:12:24.99,Default,,0,0,0,,Ха! Біреуі кетті! өтінемін
Dialogue: 0,0:12:25.16,0:12:27.33,Default,,0,0,0,,Тым кеш! Жеткілікті әділ
Dialogue: 0,0:12:27.45,0:12:29.87,Default,,0,0,0,,Мен саған шынайы күшімді көрсетемін
Dialogue: 0,0:12:30.16,0:12:31.37,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:31.50,0:12:32.46,Default,,0,0,0,,Инд өзені дельта аймағында орналасқан—
Dialogue: 0,0:12:32.66,0:12:34.12,Default,,0,0,0,,A? Гишааа!
Dialogue: 0,0:12:34.33,0:12:37.67,Default,,0,0,0,,Не? Не? Не айтқың келеді?
Dialogue: 0,0:12:38.75,0:12:39.67,Default,,0,0,0,,Йова…
Dialogue: 0,0:12:39.80,0:12:41.38,Default,,0,0,0,,<Бұл мен...>
Dialogue: 0,0:12:41.51,0:12:42.42,Default,,0,0,0,,Char! Жақсы
Dialogue: 0,0:12:42.97,0:12:44.13,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:12:44.38,0:12:45.39,Default,,0,0,0,,(Гоблин айқайы)
Dialogue: 0,0:12:45.51,0:12:47.01,Default,,0,0,0,,Көп уақыт өтті...
Dialogue: 0,0:12:47.26,0:12:50.01,Default,,0,0,0,,Өйткені, бұл менің екінші өмірім болады...
Dialogue: 0,0:12:50.60,0:12:51.56,Default,,0,0,0,,<Ха! ＞
Dialogue: 0,0:12:52.14,0:12:54.31,Default,,0,0,0,,Ол кезде менің уақытым таусылатын...
Dialogue: 0,0:12:54.44,0:12:58.06,Default,,0,0,0,,<Мен үлкен бонус ұпайларын таратқан жоқпын! ＞
Dialogue: 0,0:12:58.69,0:13:00.07,Default,,0,0,0,,Уа!
Dialogue: 0,0:13:00.36,0:13:01.19,Default,,0,0,0,,(Гоблин айқайы)
Dialogue: 0,0:13:01.36,0:13:04.40,Default,,0,0,0,,Ааааааааааааааааааааааааааааа
Dialogue: 0,0:13:08.49,0:13:09.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:09.70,0:13:10.99,Default,,0,0,0,,<Деңгейді көтер! ＞
Dialogue: 0,0:13:11.12,0:13:13.33,Default,,0,0,0,,<Бір гоблинді жеңу арқылы ма? ＞
Dialogue: 0,0:13:13.58,0:13:15.71,Default,,0,0,0,,<Ал 31? ＞
Dialogue: 0,0:13:15.87,0:13:19.21,Default,,0,0,0,,<Осы ерекше жазбаның арқасында түсіндім>
Dialogue: 0,0:13:19.34,0:13:20.46,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:13:22.46,0:13:24.63,Default,,0,0,0,,Иә! Деңгейді көтер!
Dialogue: 0,0:13:24.84,0:13:25.72,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:25.97,0:13:27.59,Default,,0,0,0,,Мен де көтерілдім!
Dialogue: 0,0:13:27.72,0:13:29.97,Default,,0,0,0,,Оны қандай параметрге тағайындауым керек?
Dialogue: 0,0:13:30.10,0:13:32.89,Default,,0,0,0,,Әрине бұл физикалық күш пен бұлшықет күші.
Dialogue: 0,0:13:33.60,0:13:36.14,Default,,0,0,0,,<Басқалардың экрандарын көру мүмкін емес...>
Dialogue: 0,0:13:36.44,0:13:39.36,Default,,0,0,0,,<Әзірге 1 триллионды салыңыз...>
Dialogue: 0,0:13:44.53,0:13:45.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:48.32,0:13:51.08,Default,,0,0,0,,Ендеше менің қалпына келу қабілетім…
Dialogue: 0,0:14:02.67,0:14:05.13,Default,,0,0,0,,<Абсолютті Құдай...>
Dialogue: 0,0:14:05.92,0:14:07.38,Default,,0,0,0,,<Мен? ＞
Dialogue: 0,0:14:07.51,0:14:09.09,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:09.22,0:14:12.39,Default,,0,0,0,,(Гоблин айқайы)
Dialogue: 0,0:14:13.01,0:14:15.39,Default,,0,0,0,,<Бұрын қиналсам да...>
Dialogue: 0,0:14:15.81,0:14:18.39,Default,,0,0,0,,<1 триллион бұлшықет күші...>
Dialogue: 0,0:14:19.23,0:14:21.11,Default,,0,0,0,,<Көріп көрейін>
Dialogue: 0,0:14:21.23,0:14:23.19,Default,,0,0,0,,(Гоблин айқайы)
Dialogue: 0,0:14:24.48,0:14:25.36,Default,,0,0,0,,Уф
Dialogue: 0,0:14:29.49,0:14:30.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:45.13,0:14:46.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:46.76,0:14:49.43,Default,,0,0,0,,(Сейканың күшті дауысы)
Dialogue: 0,0:14:49.55,0:14:50.59,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:14:50.80,0:14:52.64,Default,,0,0,0,,Бұл 16-шы
Dialogue: 0,0:14:52.80,0:14:54.68,Default,,0,0,0,,Менің жасым 13-те!
Dialogue: 0,0:14:54.81,0:14:58.64,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:14:58.77,0:15:00.94,Default,,0,0,0,,<Мен оны көрмеймін...>
Dialogue: 0,0:15:02.40,0:15:03.61,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:15:03.73,0:15:05.32,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:05.48,0:15:06.44,Default,,0,0,0,,Уф (Сейка) Ах
Dialogue: 0,0:15:06.61,0:15:09.95,Default,,0,0,0,,Юю Садақты байлауға рұқсат етіңіз...
Dialogue: 0,0:15:10.11,0:15:11.70,Default,,0,0,0,,Не болды!? Өтінемін...
Dialogue: 0,0:15:11.82,0:15:14.95,Default,,0,0,0,,Ю… Бұл садақ созу синдромы.
Dialogue: 0,0:15:15.24,0:15:16.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:16.41,0:15:19.16,Default,,0,0,0,,Уф, менің миыма...
Dialogue: 0,0:15:19.37,0:15:21.08,Default,,0,0,0,,Садақ сөйлейді
Dialogue: 0,0:15:21.21,0:15:24.71,Default,,0,0,0,,«Шигеру, садағыңды қазір байла...»
Dialogue: 0,0:15:24.84,0:15:25.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:25.96,0:15:28.46,Default,,0,0,0,,Сейка-сан... маған...
Dialogue: 0,0:15:28.59,0:15:29.92,Default,,0,0,0,,Жол...
Dialogue: 0,0:15:30.05,0:15:32.59,Default,,0,0,0,,Мен саған оны іліп қоюға рұқсат етемін.
Dialogue: 0,0:15:33.72,0:15:36.06,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:15:36.43,0:15:39.77,Default,,0,0,0,,<Хикикомори күндерінде көрген бейнелер туралы естеліктер>
Dialogue: 0,0:15:40.23,0:15:43.23,Default,,0,0,0,,<және 1 триллионнан 5-ке дейін ептілік>
Dialogue: 0,0:15:46.19,0:15:48.69,Default,,0,0,0,,Керемет! Бұл садақ ату клубы болды ма?
Dialogue: 0,0:15:48.82,0:15:49.74,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:15:49.94,0:15:51.49,Default,,0,0,0,,Содан кейін бір ғана ату
Dialogue: 0,0:15:51.65,0:15:53.36,Default,,0,0,0,,Мен сізге соғуға рұқсат етемін Иә.
Dialogue: 0,0:15:53.49,0:15:55.32,Default,,0,0,0,,Е, жарайды, мәселе жоқ.
Dialogue: 0,0:15:55.45,0:15:56.87,Default,,0,0,0,,Сіз оны ұрғыңыз келеді, солай ма?
Dialogue: 0,0:15:57.03,0:15:59.33,Default,,0,0,0,,<Маған тиіспе...>
Dialogue: 0,0:15:59.50,0:16:01.37,Default,,0,0,0,,<Оған көмектесу мүмкін емес>
Dialogue: 0,0:16:01.79,0:16:04.63,Default,,0,0,0,,<Деңгейді көтеру арқылы алынатын дағдылар>
Dialogue: 0,0:16:05.08,0:16:07.00,Default,,0,0,0,,<Мұны қолданып көргіңіз келе ме?>
Dialogue: 0,0:16:13.72,0:16:14.80,Default,,0,0,0,,<Солай ма? ＞
Dialogue: 0,0:16:15.55,0:16:18.06,Default,,0,0,0,,<Дәлдігі төмен шығар? ＞
Dialogue: 0,0:16:20.22,0:16:21.85,Default,,0,0,0,,(Барлығының таңданған дауысы)
Dialogue: 0,0:16:21.98,0:16:24.40,Default,,0,0,0,,(Гоблиндердің айқайы)
Dialogue: 0,0:16:30.61,0:16:32.45,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:16:35.99,0:16:38.33,Default,,0,0,0,,Мынау не деген... (Қыз) Уф
Dialogue: 0,0:16:38.45,0:16:40.33,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:16:54.97,0:16:57.26,Default,,0,0,0,,Бұл не? Қазір...
Dialogue: 0,0:16:57.39,0:17:00.22,Default,,0,0,0,,Аа, жоқ, мен садақ ату үйірмесінде болдым.
Dialogue: 0,0:17:00.39,0:17:03.35,Default,,0,0,0,,Дұрыс! Сосын қалғанын өзім шешемін.
Dialogue: 0,0:17:03.48,0:17:05.39,Default,,0,0,0,,<Сіз келісесіз бе...>
Dialogue: 0,0:17:05.69,0:17:06.94,Default,,0,0,0,,Жаулар әлі де бар!
Dialogue: 0,0:17:07.06,0:17:08.77,Default,,0,0,0,,Сейка-сан, көмектесіңізші!
Dialogue: 0,0:17:09.07,0:17:10.73,Default,,0,0,0,,Оны маған қалдыр!
Dialogue: 0,0:17:10.90,0:17:13.15,Default,,0,0,0,,О... және...
Dialogue: 0,0:17:13.65,0:17:15.49,Default,,0,0,0,,Кеттік...
Dialogue: 0,0:17:15.61,0:17:17.28,Default,,0,0,0,,Құла, құла, құла!
Dialogue: 0,0:17:17.41,0:17:19.16,Default,,0,0,0,,Құлау~
Dialogue: 0,0:17:19.28,0:17:21.29,Default,,0,0,0,,<Жоқ, мен тым алыс аттап кеттім...>
Dialogue: 0,0:17:23.41,0:17:24.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:24.87,0:17:26.96,Default,,0,0,0,,Өйткені, бұл біз ғана.
Dialogue: 0,0:17:27.08,0:17:28.46,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:17:30.46,0:17:33.13,Default,,0,0,0,,Жарайды, бәрібір маған бәрібір... (Шөптің жұлынған дыбысы)
Dialogue: 0,0:17:33.26,0:17:36.72,Default,,0,0,0,,<Сіз әлі барлық көрсеткілерді қолдандыңыз ба?>
Dialogue: 0,0:17:38.09,0:17:40.81,Default,,0,0,0,,Мм... Әй?
Dialogue: 0,0:17:49.56,0:17:52.07,Default,,0,0,0,,Эй, заттар түсіп жатыр.
Dialogue: 0,0:17:52.23,0:17:53.32,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:17:53.44,0:17:56.07,Default,,0,0,0,,Әй, құла, құла!
Dialogue: 0,0:17:56.20,0:17:58.03,Default,,0,0,0,,Құла! <Пайдасыз...>
Dialogue: 0,0:17:58.16,0:17:59.70,Default,,0,0,0,,Тааааа! Гаа!
Dialogue: 0,0:18:00.45,0:18:02.45,Default,,0,0,0,,Иә! Барлығы осы
Dialogue: 0,0:18:02.58,0:18:05.33,Default,,0,0,0,,Уф... Мен қалаға бара аламын.
Dialogue: 0,0:18:05.83,0:18:07.79,Default,,0,0,0,,Барлығына! Сіз жасадыңыз!
Dialogue: 0,0:18:08.21,0:18:11.84,Default,,0,0,0,,<Қазір бірге қалаға барайық...>
Dialogue: 0,0:18:14.21,0:18:15.59,Default,,0,0,0,,Илия…
Dialogue: 0,0:18:16.09,0:18:18.55,Default,,0,0,0,,Карта дұрыс сияқты.
Dialogue: 0,0:18:18.76,0:18:20.80,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:18:20.93,0:18:23.06,Default,,0,0,0,,Мен көп жүрдім.
Dialogue: 0,0:18:23.26,0:18:24.22,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:25.02,0:18:27.31,Default,,0,0,0,,Ах! Соған қараңызшы
Dialogue: 0,0:18:28.14,0:18:29.31,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:18:29.60,0:18:32.19,Default,,0,0,0,,Бұл әлемде де гамбургерлер бар.
Dialogue: 0,0:18:32.32,0:18:33.94,Default,,0,0,0,,Картоптың жағымды иісі...
Dialogue: 0,0:18:34.07,0:18:36.07,Default,,0,0,0,,Кеттік! (3 адам күледі)
Dialogue: 0,0:18:39.49,0:18:41.91,Default,,0,0,0,,<Олар жаман адамдар емес, бірақ...>
Dialogue: 0,0:18:42.28,0:18:43.99,Default,,0,0,0,,<Бұл қоштасу>
Dialogue: 0,0:18:54.84,0:18:56.84,Default,,0,0,0,,(Асқазанның айқайлауы)
Dialogue: 0,0:18:57.55,0:19:00.01,Default,,0,0,0,,Сонда да қарным ашты.
Dialogue: 0,0:19:00.38,0:19:03.35,Default,,0,0,0,,Мен тамақ алғым келеді, бірақ...
Dialogue: 0,0:19:05.47,0:19:07.35,Default,,0,0,0,,Әке, мен кеттім!
Dialogue: 0,0:19:07.81,0:19:10.14,Default,,0,0,0,,Хе, сен де жалғызсың ба...
Dialogue: 0,0:19:10.94,0:19:11.85,Default,,0,0,0,,Қап…
Dialogue: 0,0:19:13.56,0:19:15.90,Default,,0,0,0,,Бұл әйел емес, солай емес пе?
Dialogue: 0,0:19:16.03,0:19:17.99,Default,,0,0,0,,Бейшара Шигеру! Уау
Dialogue: 0,0:19:18.11,0:19:20.36,Default,,0,0,0,,Увааааааааааааааааааааааааа
Dialogue: 0,0:19:21.28,0:19:22.49,Default,,0,0,0,,Уау
Dialogue: 0,0:19:23.41,0:19:25.49,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:19:25.74,0:19:28.45,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:19:28.58,0:19:29.91,Default,,0,0,0,,Айтпақшы, Шигеру-сан!
Dialogue: 0,0:19:30.12,0:19:31.96,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:32.08,0:19:33.29,Default,,0,0,0,,Бұл гамбургер!
Dialogue: 0,0:19:33.42,0:19:35.63,Default,,0,0,0,,<Мен сізге жауап бердім>
Dialogue: 0,0:19:35.84,0:19:38.30,Default,,0,0,0,,Бұл үлкен. Бұл дәмді көрінеді.
Dialogue: 0,0:19:38.42,0:19:40.38,Default,,0,0,0,,Дұрыс па? Хмф!
Dialogue: 0,0:19:40.51,0:19:42.34,Default,,0,0,0,,<Супер масқара бет...>
Dialogue: 0,0:19:42.93,0:19:44.14,Default,,0,0,0,,Иә! сурет?
Dialogue: 0,0:19:44.76,0:19:47.93,Default,,0,0,0,,Садағымды ертерек байлағаныңызға рахмет.
Dialogue: 0,0:19:48.10,0:19:50.10,Default,,0,0,0,,Рахметпен қабыл алыңыздар!
Dialogue: 0,0:19:50.23,0:19:53.27,Default,,0,0,0,,<Сейка-сан... Түрің осылай болса да мойынсұнғышсың ба? ＞
Dialogue: 0,0:19:53.40,0:19:55.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:55.56,0:19:57.90,Default,,0,0,0,,Қараңызшы, қарныңыз ашты емес пе?
Dialogue: 0,0:19:58.03,0:20:00.49,Default,,0,0,0,,Кедейсің деп кідірме
Dialogue: 0,0:20:00.61,0:20:02.07,Default,,0,0,0,,<Кедейлік қажет емес...>
Dialogue: 0,0:20:02.74,0:20:06.28,Default,,0,0,0,,<Бірақ дәмді терияки соусының иісі...>
Dialogue: 0,0:20:08.37,0:20:10.29,Default,,0,0,0,,Ууууууууууу
Dialogue: 0,0:20:10.41,0:20:12.75,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:20:13.42,0:20:14.75,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:20:14.88,0:20:20.26,Default,,0,0,0,,(Шигерудің мазасыз дауысы)
Dialogue: 0,0:20:23.13,0:20:24.97,Default,,0,0,0,,Уф
Dialogue: 0,0:20:25.09,0:20:26.89,Default,,0,0,0,,<58 триллион шығын! ＞
Dialogue: 0,0:20:27.01,0:20:30.81,Default,,0,0,0,,<Біраз өрескел есептеулер жасасаңыз да, жер бетіндегі 300 адам өледі! ＞
Dialogue: 0,0:20:33.14,0:20:34.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:34.48,0:20:35.40,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:20:35.52,0:20:37.65,Default,,0,0,0,,<Одан да сорақысы, құртатын құдай>
Dialogue: 0,0:20:37.77,0:20:38.57,Default,,0,0,0,,Ах
Dialogue: 0,0:20:38.73,0:20:42.07,Default,,0,0,0,,Мен... Шигеру-санға сатып алудың қиындығына бардым...
Dialogue: 0,0:20:42.70,0:20:45.28,Default,,0,0,0,,<Олай жасағым келмеді, бірақ...>
Dialogue: 0,0:20:45.74,0:20:46.78,Default,,0,0,0,,<Күрсіну...>
Dialogue: 0,0:20:47.20,0:20:48.41,Default,,0,0,0,,<Сізге көрсетейін>
Dialogue: 0,0:20:48.53,0:20:51.58,Default,,0,0,0,,<Бір кездері жоғары сатылымдармен мақтанған менің шынайылығым! ＞
Dialogue: 0,0:20:51.70,0:20:52.87,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:53.00,0:20:56.17,Default,,0,0,0,,Сейка-санның әдемі болғаны сонша, менің қолым дірілдеп кетті!
Dialogue: 0,0:20:56.29,0:20:57.17,Default,,0,0,0,,Е...
Dialogue: 0,0:20:57.29,0:20:59.55,Default,,0,0,0,,Бұл үшін рахмет.
Dialogue: 0,0:20:59.67,0:21:01.17,Default,,0,0,0,,Міне! Бұл тамаша
Dialogue: 0,0:21:01.30,0:21:03.05,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:21:03.42,0:21:06.68,Default,,0,0,0,,<Леман дәуірінің ұраны біреуді күлдірту болды>
Dialogue: 0,0:21:06.80,0:21:08.85,Default,,0,0,0,,＜Біз сіздің үміттеріңізді ешқашан ақтамаймыз＞
Dialogue: 0,0:21:09.14,0:21:12.81,Default,,0,0,0,,<Ол қолында бар ресурстарды осы мақсатқа арнаған адам.>
Dialogue: 0,0:21:13.18,0:21:14.85,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:21:15.14,0:21:16.77,Default,,0,0,0,,Мен саған мынаны беремін!
Dialogue: 0,0:21:16.90,0:21:19.19,Default,,0,0,0,,Кешіріңіз, себебі мен әдемімін.
Dialogue: 0,0:21:19.32,0:21:21.15,Default,,0,0,0,,<Сіз мұны жоққа шығармайсыз, солай ма?>
Dialogue: 0,0:21:21.44,0:21:23.74,Default,,0,0,0,,Бірақ бұл Сейканың тамағы.
Dialogue: 0,0:21:23.86,0:21:26.53,Default,,0,0,0,,Жарайды, мен баймын.
Dialogue: 0,0:21:26.66,0:21:28.12,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:21:28.62,0:21:31.41,Default,,0,0,0,,Шигеру-сан, сен жай ғана садақыңды орнаттың.
Dialogue: 0,0:21:31.54,0:21:35.37,Default,,0,0,0,,Сіз де жебені тауып алып, маған жасырын бердіңіз ғой?
Dialogue: 0,0:21:35.75,0:21:37.37,Default,,0,0,0,,<Байқадыңыз ба...>
Dialogue: 0,0:21:38.04,0:21:41.63,Default,,0,0,0,,<Мен бұл туралы ештеңе білмедім, мен бұл жай ғана жылыжайда өсірілген нәрсе деп ойладым...>
Dialogue: 0,0:21:45.05,0:21:46.59,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:46.84,0:21:50.14,Default,,0,0,0,,＜Менің қарызым бар сияқты＞
Dialogue: 0,0:21:50.64,0:21:53.77,Default,,0,0,0,,<Осы кісіге ең болмағанда қарызымды өтеуім керек...>
Dialogue: 0,0:21:53.89,0:21:55.64,Default,,0,0,0,,Міне, сіз!
Dialogue: 0,0:21:55.81,0:21:58.69,Default,,0,0,0,,Шигеру-сан, міне, міне!
Dialogue: 0,0:21:58.81,0:22:00.15,Default,,0,0,0,,Ухуху хухуху
Dialogue: 0,0:22:01.36,0:22:02.40,Default,,0,0,0,,Фу…
Dialogue: 0,0:22:02.53,0:22:06.45,Default,,0,0,0,,<Оған дейін солоны сізге қалдырамын>
Dialogue: 0,0:22:10.20,0:22:13.16,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.62,0:23:38.58,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.08,0:23:46.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory