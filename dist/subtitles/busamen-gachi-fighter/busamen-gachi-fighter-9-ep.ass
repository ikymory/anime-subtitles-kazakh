Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.64,0:00:25.60,Default,,0,0,0,,♪～
Dialogue: 0,0:01:46.48,0:01:49.44,Default,,0,0,0,,～♪
Dialogue: 0,0:01:52.65,0:01:54.90,Default,,0,0,0,,Жасырын тергеудегі қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:01:55.82,0:01:57.95,Default,,0,0,0,,Барлығымыз осы жеңісті тойлайық
Dialogue: 0,0:02:00.03,0:02:02.16,Default,,0,0,0,,Сонымен... Сәттілік!
Dialogue: 0,0:02:02.33,0:02:03.70,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:04.41,0:02:07.66,Default,,0,0,0,,<Кісі өлтіру казиносына кіргенімізге бір апта>
Dialogue: 0,0:02:08.17,0:02:09.96,Default,,0,0,0,,<Ақырында жайғасты>
Dialogue: 0,0:02:10.92,0:02:12.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:12.63,0:02:15.17,Default,,0,0,0,,Дәмді~ (Ли-зу) Ммм~ Бұл дәмді.
Dialogue: 0,0:02:15.38,0:02:16.92,Default,,0,0,0,,<Солай болса да>
Dialogue: 0,0:02:17.05,0:02:20.43,Default,,0,0,0,,<Сыйлықтармен және басқаларымен таудай ақша алыңыз>
Dialogue: 0,0:02:21.01,0:02:23.93,Default,,0,0,0,,<Ал, мен оны алған кезде біраз абдырап қалдым, бірақ...>
Dialogue: 0,0:02:24.93,0:02:28.56,Default,,0,0,0,,Бұл сыйлық ақшасы.
Dialogue: 0,0:02:28.77,0:02:29.81,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:02:30.02,0:02:32.52,Default,,0,0,0,,Өйткені біз тек әділдік үшін әрекет еттік...
Dialogue: 0,0:02:32.69,0:02:34.07,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:02:35.15,0:02:37.15,Default,,0,0,0,,Сіз бас тартуды жоспарлап отырған жоқсыз, солай ма?
Dialogue: 0,0:02:37.28,0:02:40.20,Default,,0,0,0,,Бірақ мен мұны ақша үшін жасаған жоқпын...
Dialogue: 0,0:02:40.45,0:02:42.45,Default,,0,0,0,,Бұл әділетті марапат
Dialogue: 0,0:02:42.62,0:02:47.20,Default,,0,0,0,,Мұндай ақшаның баратын жері жоқ болса, мемлекеттік мекемелерге қиындық тудырмай ма?
Dialogue: 0,0:02:47.79,0:02:51.88,Default,,0,0,0,,<Аа, қарашы, мазасыз жүзді артқа тастап, енді сізде жоқтық бар>
Dialogue: 0,0:02:52.83,0:02:57.21,Default,,0,0,0,,<Айтпақшы, бастапқы алушылар батыр Алдеан және тағы екі адам болды>
Dialogue: 0,0:02:57.34,0:02:58.63,Default,,0,0,0,,<Орналасқан жері белгісіз>
Dialogue: 0,0:02:58.76,0:03:01.76,Default,,0,0,0,,<Бағаның жартысы қатысқан бізге төленді.>
Dialogue: 0,0:03:02.47,0:03:05.01,Default,,0,0,0,,Бірақ сол Кажита деген адам...
Dialogue: 0,0:03:05.51,0:03:08.48,Default,,0,0,0,,Мен салған құлыптың үңгіріне түсу.
Dialogue: 0,0:03:09.02,0:03:10.98,Default,,0,0,0,,Қандай себеп-салдарлық нәтиже.
Dialogue: 0,0:03:11.73,0:03:14.77,Default,,0,0,0,,<Оның өлімін үңгірдей етіп көрсеткен мен едім>
Dialogue: 0,0:03:15.07,0:03:16.98,Default,,0,0,0,,<Соңғы соққыны берген...>
Dialogue: 0,0:03:22.20,0:03:25.12,Default,,0,0,0,,<Тағы бір абсолютті Құдай Карина>
Dialogue: 0,0:03:25.28,0:03:30.41,Default,,0,0,0,,<Және Кажита мырза да мүше болған жұмбақ Ordnung Spear ұйымы>
Dialogue: 0,0:03:31.75,0:03:35.71,Default,,0,0,0,,<Оның бар екені туралы әлі ешкімге айтқан жоқпын>
Dialogue: 0,0:03:36.50,0:03:38.13,Default,,0,0,0,,Шигеру-сан! иә?
Dialogue: 0,0:03:38.71,0:03:39.67,Default,,0,0,0,,Бааа
Dialogue: 0,0:03:39.84,0:03:42.55,Default,,0,0,0,,Уф! (Сейка) Сіз дұрыс тамақтанып жатырсыз ба?
Dialogue: 0,0:03:42.68,0:03:44.93,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:03:45.05,0:03:47.01,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:03:47.89,0:03:51.10,Default,,0,0,0,,Біз шынымен де байып алдық, солай емес пе?
Dialogue: 0,0:03:51.23,0:03:53.52,Default,,0,0,0,,Оны қалай пайдалану керектігін бәріміз ойланайық!
Dialogue: 0,0:03:53.85,0:03:56.31,Default,,0,0,0,,Сыйақы 400 000 лир.
Dialogue: 0,0:03:56.48,0:04:00.69,Default,,0,0,0,,Қалған 2 миллион лира Сейканың казинода ұтқан сомасы ма?
Dialogue: 0,0:04:00.82,0:04:02.03,Default,,0,0,0,,қателеспеген еді
Dialogue: 0,0:04:02.15,0:04:05.74,Default,,0,0,0,,Мені казино ханшайымы Охохохо деп атаңыз
Dialogue: 0,0:04:05.87,0:04:08.58,Default,,0,0,0,,<Сізге сол атақты кейіпкер ұнай ма?>
Dialogue: 0,0:04:08.83,0:04:12.54,Default,,0,0,0,,Көп ақша болса да, қолданбасаң тез бітеді.
Dialogue: 0,0:04:12.66,0:04:14.58,Default,,0,0,0,,Оны абайлап пайдаланыңыз.
Dialogue: 0,0:04:14.71,0:04:15.83,Default,,0,0,0,,Бұл (Сэйджи) Ах.
Dialogue: 0,0:04:16.08,0:04:20.09,Default,,0,0,0,,Осы ақшаны төртеуміздің ортақ меншігі етіп беруіңізді өтінемін.
Dialogue: 0,0:04:20.30,0:04:21.72,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:04:21.84,0:04:23.68,Default,,0,0,0,,The original is Seiji's money.
Dialogue: 0,0:04:23.80,0:04:26.72,Default,,0,0,0,,Сіз оны маған партияңызды нығайтуға қаражат ретінде бердіңіз, солай ма?
Dialogue: 0,0:04:26.85,0:04:28.10,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:04:28.35,0:04:29.97,Default,,0,0,0,,Енді менің кезегім!
Dialogue: 0,0:04:30.31,0:04:33.19,Default,,0,0,0,,Бұл ақшамен біз бәрін күшейтеміз!
Dialogue: 0,0:04:33.31,0:04:34.35,Default,,0,0,0,,Сейка-сан...
Dialogue: 0,0:04:35.06,0:04:38.44,Default,,0,0,0,,Оның үстіне ақшаның жартысы Шигерудің ақшасы.
Dialogue: 0,0:04:38.57,0:04:40.57,Default,,0,0,0,,Мен оған жетекшілік еттім, бірақ...
Dialogue: 0,0:04:40.69,0:04:42.24,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:04:42.61,0:04:45.74,Default,,0,0,0,,Әркім оны пайдаланса жақсы болар еді.
Dialogue: 0,0:04:46.32,0:04:47.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:47.66,0:04:49.58,Default,,0,0,0,,Олай болса, тағы да көңіл көтерейік.
Dialogue: 0,0:04:49.70,0:04:51.12,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:04:51.83,0:04:55.83,Default,,0,0,0,,<Көп ақшаны көргенде кенет өзгеретін адамдар көп>
Dialogue: 0,0:04:56.17,0:04:58.84,Default,,0,0,0,,<Бұл адамдар өзгерген жоқ>
Dialogue: 0,0:05:02.88,0:05:05.05,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:08.76,0:05:11.22,Default,,0,0,0,,Орднунг найза...?
Dialogue: 0,0:05:11.72,0:05:15.56,Default,,0,0,0,,Иә, Кажита мырза сол ұйымның мүшесі болатын.
Dialogue: 0,0:05:15.81,0:05:19.48,Default,,0,0,0,,Қарапайым адам бола алмаған реинкарнацияланған адамдардың одағы сияқты.
Dialogue: 0,0:05:19.77,0:05:24.57,Default,,0,0,0,,Ол өзінің жасырын билеуші ​​екенін және тәртіпті сақтау үшін келгенін айтты.
Dialogue: 0,0:05:24.74,0:05:28.24,Default,,0,0,0,,Адам өміріне мән бермейтін бөлімдер бар.
Dialogue: 0,0:05:28.95,0:05:32.95,Default,,0,0,0,,Сейджи мырза батыр болуды мақсат еткендіктен, ол міндетті түрде кедергі болады.
Dialogue: 0,0:05:33.12,0:05:36.00,Default,,0,0,0,,Сондықтан мен қазір айтайын деп ойладым...
Dialogue: 0,0:05:37.00,0:05:40.46,Default,,0,0,0,,Black flag... what is it?
Dialogue: 0,0:05:40.59,0:05:43.67,Default,,0,0,0,,Ол ұйымның белгісі деп аталатын найзаға бекітілді.
Dialogue: 0,0:05:43.80,0:05:46.88,Default,,0,0,0,,Ұйымды білетін адам көрсе...
Dialogue: 0,0:05:47.09,0:05:49.26,Default,,0,0,0,,Байқап көруге тұрарлық болуы мүмкін
Dialogue: 0,0:05:49.39,0:05:50.89,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:51.81,0:05:52.97,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:53.22,0:05:54.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:55.10,0:05:59.10,Default,,0,0,0,,<Като-кун, казино туралы сұрау әлдеқашан біткен сияқты>
Dialogue: 0,0:05:59.23,0:06:01.94,Default,,0,0,0,,Батыр мырза, шынымен де сізге айтатын әңгімем бар.
Dialogue: 0,0:06:02.07,0:06:02.90,Default,,0,0,0,,Като-сан (Като)!
Dialogue: 0,0:06:03.23,0:06:05.94,Default,,0,0,0,,Айтайын, мен Альдеан емеспін.
Dialogue: 0,0:06:06.07,0:06:06.95,Default,,0,0,0,,Жақсы естіледі ме?
Dialogue: 0,0:06:07.11,0:06:08.66,Default,,0,0,0,,(Кёко) Қыз ба? (Юки) Ұл ба?
Dialogue: 0,0:06:08.78,0:06:10.74,Default,,0,0,0,,<Ол шын мәнінде кім екенін біледі>
Dialogue: 0,0:06:10.87,0:06:13.66,Default,,0,0,0,,<Usually they find out, though.>
Dialogue: 0,0:06:13.91,0:06:16.16,Default,,0,0,0,,So the story is...
Dialogue: 0,0:06:16.29,0:06:18.42,Default,,0,0,0,,Колизей казиносынан құтқарылды
Dialogue: 0,0:06:18.54,0:06:20.67,Default,,0,0,0,,You had a rich customer.
Dialogue: 0,0:06:21.25,0:06:25.09,Default,,0,0,0,,<Ол туған қаласына қайту үшін жолсерік іздейді.>
Dialogue: 0,0:06:25.51,0:06:29.72,Default,,0,0,0,,Сезане қаласының президентінде қару жасау және сату.
Dialogue: 0,0:06:29.93,0:06:32.35,Default,,0,0,0,,Roughly speaking, I'm an arms dealer...
Dialogue: 0,0:06:32.80,0:06:34.47,Default,,0,0,0,,Қару сатушы...
Dialogue: 0,0:06:35.68,0:06:38.35,Default,,0,0,0,,Като мырза, мен сіздің өтінішіңізді қабылдаймын.
Dialogue: 0,0:06:38.48,0:06:40.10,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:40.23,0:06:42.61,Default,,0,0,0,,The client's name is, um...
Dialogue: 0,0:06:42.73,0:06:46.36,Default,,0,0,0,,<Мен қарт өзінің бұрынғы бастығына мінезі жағынан да ұқсамайды деп үміттенемін...>
Dialogue: 0,0:06:46.86,0:06:48.61,Default,,0,0,0,,This is Heizo Sakurai.
Dialogue: 0,0:06:48.95,0:06:50.32,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:06:50.49,0:06:52.12,Default,,0,0,0,,<Сен емес пе! ＞
Dialogue: 0,0:06:52.74,0:06:56.12,Default,,0,0,0,,<Менің шынайы тұлғамның ашылуына жол бермеңіз...>
Dialogue: 0,0:06:56.45,0:06:57.79,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:06:58.12,0:07:00.12,Default,,0,0,0,,Сіздер менің құтқарушыларымсыздар!
Dialogue: 0,0:07:00.58,0:07:03.38,Default,,0,0,0,,Бұл жеті жұлдыздың адамы! Кейн!
Dialogue: 0,0:07:03.84,0:07:06.30,Default,,0,0,0,,Мен бұл жақсылықты ешқашан ұмытпаймын! Ха ха!
Dialogue: 0,0:07:06.42,0:07:07.63,Default,,0,0,0,,<Узза> (Сакурай) Иә!
Dialogue: 0,0:07:08.76,0:07:09.88,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:11.59,0:07:14.22,Default,,0,0,0,,Сізге көп рахмет (Сейка) иә?
Dialogue: 0,0:07:14.35,0:07:16.64,Default,,0,0,0,,<Ойқора, сенің қыздарға деген қарым-қатынасың тым бөлек>
Dialogue: 0,0:07:17.06,0:07:21.27,Default,,0,0,0,,<Ол бастапқы әлемде жыныстық қудалау мен билікті қудалаудың үштік патшасы болғанымен>
Dialogue: 0,0:07:21.56,0:07:25.07,Default,,0,0,0,,Барлығымыз, біз осы жалға алынған арбамен жол бойымен жүреміз.
Dialogue: 0,0:07:25.57,0:07:27.48,Default,,0,0,0,,Сұрақтарыңыз болса, маған хабарласыңыз.
Dialogue: 0,0:07:27.61,0:07:28.53,Default,,0,0,0,,Иә
Dialogue: 0,0:07:28.69,0:07:30.03,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:07:31.78,0:07:35.70,Default,,0,0,0,,<Олар менің Сакурай-санның бұрынғы бағыныштысы екенімді байқамағанына қуаныштымын...>
Dialogue: 0,0:07:41.54,0:07:46.04,Default,,0,0,0,,Иә, бұл Шигерудің кеші ме?
Dialogue: 0,0:07:46.17,0:07:49.09,Default,,0,0,0,,Сіз сондай екіжүзді сияқтысыз.
Dialogue: 0,0:07:49.21,0:07:50.09,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,0:07:52.47,0:07:53.84,Default,,0,0,0,,<Сонымен>
Dialogue: 0,0:07:54.26,0:07:56.55,Default,,0,0,0,,<Сезан қаласына келу>
Dialogue: 0,0:07:56.81,0:07:58.81,Default,,0,0,0,,<Еңбегіңіз үшін рахмет>
Dialogue: 0,0:08:00.93,0:08:03.81,Default,,0,0,0,,Балалар сендерге көп рахмет.
Dialogue: 0,0:08:04.19,0:08:07.32,Default,,0,0,0,,Бұл кішкентай нәрсе, бірақ қарныңызды толтырыңыз.
Dialogue: 0,0:08:07.77,0:08:10.65,Default,,0,0,0,,Шигеру-сан! Бұл тұтас қуырылған құс!
Dialogue: 0,0:08:10.78,0:08:12.53,Default,,0,0,0,,Байларға арналған той!
Dialogue: 0,0:08:12.65,0:08:15.12,Default,,0,0,0,,Уау, бұл сән-салтанаттың шыңы.
Dialogue: 0,0:08:15.24,0:08:20.00,Default,,0,0,0,,<Сакурай-сан, өзімнің бастапқы әлемімде мен несеп қышқылының деңгейіне алаңдап, ауыр диета жедім>
Dialogue: 0,0:08:20.25,0:08:21.96,Default,,0,0,0,,Бұха!
Dialogue: 0,0:08:22.08,0:08:23.87,Default,,0,0,0,,Мацузака-кун, әдеттегідей
Dialogue: 0,0:08:24.00,0:08:25.33,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:25.63,0:08:27.13,Default,,0,0,0,,Денсаулықты қалпына келтіру
Dialogue: 0,0:08:27.25,0:08:28.34,Default,,0,0,0,,Ммм...
Dialogue: 0,0:08:28.59,0:08:31.34,Default,,0,0,0,,<Нәр қышқылы деңгейін қалпына келтіру шеберлігімен жою!?>
Dialogue: 0,0:08:32.01,0:08:33.76,Default,,0,0,0,,Пхуха~
Dialogue: 0,0:08:33.93,0:08:35.43,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:08:35.55,0:08:37.47,Default,,0,0,0,,Тері қытырлақ және шырынды!
Dialogue: 0,0:08:38.05,0:08:40.93,Default,,0,0,0,,Мен мұндай тағамды бірінші рет жеп отырмын! (Ли) Бұл керемет.
Dialogue: 0,0:08:41.06,0:08:42.73,Default,,0,0,0,,Хахахаха! (Сейка/Лиз) Иә?
Dialogue: 0,0:08:42.98,0:08:46.77,Default,,0,0,0,,Маған жұмыс жасасаң, күнде тамақтандырамын.
Dialogue: 0,0:08:46.90,0:08:48.02,Default,,0,0,0,,<Сұрамаңыз>
Dialogue: 0,0:08:48.31,0:08:50.19,Default,,0,0,0,,Күн сайын мен гамбургер алғым келеді!
Dialogue: 0,0:08:50.36,0:08:53.70,Default,,0,0,0,,Хахахаха Қандай қарапайым жас ханым.
Dialogue: 0,0:08:53.90,0:08:54.74,Default,,0,0,0,,Хо…
Dialogue: 0,0:08:55.41,0:08:57.49,Default,,0,0,0,,Айтпақшы, Сейджи-кун (Сейджи), иә.
Dialogue: 0,0:08:57.78,0:08:59.53,Default,,0,0,0,,Сіз не айттыңыз
Dialogue: 0,0:08:59.66,0:09:02.04,Default,,0,0,0,,Қара ту осыдан шықты ма?
Dialogue: 0,0:09:02.16,0:09:05.37,Default,,0,0,0,,Кешіріңіз, бірақ есімде жоқ.
Dialogue: 0,0:09:06.04,0:09:07.38,Default,,0,0,0,,Иә? (Жоғары) Хмм...
Dialogue: 0,0:09:07.50,0:09:08.79,Default,,0,0,0,,<Ұйым мәселелері…>
Dialogue: 0,0:09:08.92,0:09:12.88,Default,,0,0,0,,<Мен Лидске айттым, бірақ Сейка-санға әлі айтқан жоқпын>
Dialogue: 0,0:09:13.05,0:09:17.39,Default,,0,0,0,,Дегенмен, біздің кейбір қызметкерлер білуі мүмкін.
Dialogue: 0,0:09:17.68,0:09:21.06,Default,,0,0,0,,Қаласаңыз, ертең біздің компанияға келіңіз.
Dialogue: 0,0:09:21.18,0:09:23.27,Default,,0,0,0,,Come on! рақмет сізге!
Dialogue: 0,0:09:23.68,0:09:26.56,Default,,0,0,0,,Шигеру-сан, Сейджи-сан, сен не айтып тұрсың?
Dialogue: 0,0:09:26.69,0:09:29.81,Default,,0,0,0,,Сіз әлеуметтік зерттеулер турына тапсырыс бересіз бе?
Dialogue: 0,0:09:30.19,0:09:31.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:33.69,0:09:35.65,Default,,0,0,0,,Көйлектер өте көп!
Dialogue: 0,0:09:35.78,0:09:38.16,Default,,0,0,0,,Сіз кие аламын дедіңіз, енді киейік!
Dialogue: 0,0:09:38.28,0:09:39.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:47.29,0:09:49.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:52.17,0:09:55.01,Default,,0,0,0,,Қош келдіңіз! Сакурай қару-жарақ компаниясына
Dialogue: 0,0:09:55.42,0:09:58.05,Default,,0,0,0,,Менің атым Сабуро Сузуки, мен сенің жолбасшыңмын.
Dialogue: 0,0:09:58.18,0:09:59.51,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:09:59.64,0:10:02.10,Default,,0,0,0,,Бұл менің әлеуметтік зерттеулерге алғаш рет шығуым!
Dialogue: 0,0:10:02.68,0:10:06.60,Default,,0,0,0,,<Біздің әрбір бұйым қолөнер шеберлерінің қолымен жасалған>
Dialogue: 0,0:10:06.73,0:10:11.61,Default,,0,0,0,,<Оны жаппай өндіру арқылы біз қолайлы бағаға қол жеткіздік.>
Dialogue: 0,0:10:11.94,0:10:13.98,Default,,0,0,0,,Бұл не істеп жатыр?
Dialogue: 0,0:10:14.11,0:10:15.36,Default,,0,0,0,,Оның қабығы тазартылып жатқан сияқты.
Dialogue: 0,0:10:15.69,0:10:17.82,Default,,0,0,0,,<Бұл өте қызық сияқты>
Dialogue: 0,0:10:17.95,0:10:22.58,Default,,0,0,0,,Мына пышақтың бірін басқа компания жасаған...
Dialogue: 0,0:10:23.12,0:10:24.33,Default,,0,0,0,,О, қандай тосынсый!
Dialogue: 0,0:10:24.66,0:10:26.62,Default,,0,0,0,,Қызанақтарды жасау оңай!
Dialogue: 0,0:10:26.75,0:10:27.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:28.08,0:10:30.00,Default,,0,0,0,,Керемет! Мен оны тілеймін!
Dialogue: 0,0:10:30.13,0:10:31.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:10:31.42,0:10:33.29,Default,,0,0,0,,Мен көбірек көргім келеді!
Dialogue: 0,0:10:33.42,0:10:36.71,Default,,0,0,0,,Егер сіз демонстрацияны қаласаңыз, оны тікелей сату бұрышында да жасай аласыз.
Dialogue: 0,0:10:36.84,0:10:38.47,Default,,0,0,0,,Кеттік! (Лиз) О, күте тұрыңыз!
Dialogue: 0,0:10:39.13,0:10:41.51,Default,,0,0,0,,＜Біртүрлі заттар, мені оларды сатып алуға мәжбүрлемейсіз деп үміттенемін...＞
Dialogue: 0,0:10:42.26,0:10:43.47,Default,,0,0,0,,Сузуки мырза (Suzuki)
Dialogue: 0,0:10:43.85,0:10:46.89,Default,,0,0,0,,Мен президент Сакурай мырзадан да сұрадым.
Dialogue: 0,0:10:47.02,0:10:49.98,Default,,0,0,0,,Біз бұл тудың қайнар көзін іздейміз...
Dialogue: 0,0:10:50.40,0:10:53.90,Default,,0,0,0,,Бұл вымпел сияқты нәрсе ме?
Dialogue: 0,0:10:54.02,0:10:57.07,Default,,0,0,0,,Егер сіздің компания қару-жарақпен айналысатын болса, сіз бірдеңе білетініңізге сенімдімін.
Dialogue: 0,0:10:57.19,0:10:59.99,Default,,0,0,0,,Мен сені танымаймын...бірақ
Dialogue: 0,0:11:00.36,0:11:03.32,Default,,0,0,0,,Дегенмен, мен бұған ұқсас нәрсені көрдім.
Dialogue: 0,0:11:04.03,0:11:06.66,Default,,0,0,0,,Біз сондай-ақ тапсырыс бойынша жасалған өнімдерді қабылдаймыз.
Dialogue: 0,0:11:06.79,0:11:10.87,Default,,0,0,0,,Бірде бірден 1000 найзаға тапсырыс берген біреу болды...
Dialogue: 0,0:11:11.00,0:11:16.46,Default,,0,0,0,,<Ол адамдар сенің киімің сияқты қара фонда алтын дақтары бар плащ киеді...>
Dialogue: 0,0:11:16.59,0:11:18.42,Default,,0,0,0,,Дегенмен, тұтынушы
Dialogue: 0,0:11:18.67,0:11:19.92,Default,,0,0,0,,Ол жоғалып кетті.
Dialogue: 0,0:11:20.09,0:11:21.38,Default,,0,0,0,,Не? It disappeared?
Dialogue: 0,0:11:21.63,0:11:24.14,Default,,0,0,0,,Босанғаннан кейін мен сіздің үйіңізге бардым...
Dialogue: 0,0:11:24.39,0:11:26.14,Default,,0,0,0,,＜Монук Кара＞
Dialogue: 0,0:11:26.26,0:11:29.93,Default,,0,0,0,,<Көршілерден сұрасам, үй басында бос тұрған...>
Dialogue: 0,0:11:30.52,0:11:32.73,Default,,0,0,0,,Бұл қандай оғаш мәміле болды.
Dialogue: 0,0:11:32.85,0:11:35.86,Default,,0,0,0,,Мен сол найза туралы барғанша сұраймын.
Dialogue: 0,0:11:35.98,0:11:39.28,Default,,0,0,0,,Сіз Орднунг Найзасы туралы естідіңіз бе?
Dialogue: 0,0:11:39.40,0:11:40.82,Default,,0,0,0,,Ордо…
Dialogue: 0,0:11:40.95,0:11:44.41,Default,,0,0,0,,Мен бұл туралы бірінші рет естіп тұрмын. Бұл аты аңызға айналған қару ма, әлде бір нәрсе ме?
Dialogue: 0,0:11:46.16,0:11:47.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:47.83,0:11:49.45,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:11:49.75,0:11:50.91,Default,,0,0,0,,Сейка-сан!
Dialogue: 0,0:11:51.08,0:11:52.17,Default,,0,0,0,,Уф, суық қой!
Dialogue: 0,0:11:52.42,0:11:56.21,Default,,0,0,0,,Енді міне екі пышақ пен қызанақ.
Dialogue: 0,0:11:56.71,0:12:00.72,Default,,0,0,0,,О, қандай тосынсый! Томатты жасау оңай!
Dialogue: 0,0:12:00.88,0:12:02.22,Default,,0,0,0,,Жақсы~ (қол шапалақтау)
Dialogue: 0,0:12:02.47,0:12:04.43,Default,,0,0,0,,<Сатылымдағы демонстрация? ＞
Dialogue: 0,0:12:04.89,0:12:05.68,Default,,0,0,0,,Хо
Dialogue: 0,0:12:06.01,0:12:09.60,Default,,0,0,0,,Бұл өте жақсы дәм, жас ханым. Сіз жұмысқа тұрғыңыз келе ме?
Dialogue: 0,0:12:09.77,0:12:11.94,Default,,0,0,0,,<Сұрамаңыз! ＞
Dialogue: 0,0:12:15.19,0:12:16.44,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:12:16.77,0:12:19.23,Default,,0,0,0,,Зауыттағы экскурсия да сергітті.
Dialogue: 0,0:12:19.36,0:12:21.95,Default,,0,0,0,,Иә, әсіресе аты аңызға айналған мерген
Dialogue: 0,0:12:22.07,0:12:24.78,Default,,0,0,0,,Моро Хейяның қылышы жүрегімді дір еткізді.
Dialogue: 0,0:12:24.91,0:12:27.33,Default,,0,0,0,,Досы опасыздық жасап, елден қашуға мәжбүр болған соң,
Dialogue: 0,0:12:27.45,0:12:30.33,Default,,0,0,0,,Миллион жаумен соғысып, бытырап кеткен дейді.
Dialogue: 0,0:12:30.45,0:12:31.25,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:12:31.37,0:12:33.75,Default,,0,0,0,,<Ол неге қылыш ұстаған мерген? ＞
Dialogue: 0,0:12:36.63,0:12:38.46,Default,,0,0,0,,Айтпақшы, Шигеру-сан...
Dialogue: 0,0:12:41.13,0:12:43.26,Default,,0,0,0,,Біраз сөйлескіңіз келе ме?
Dialogue: 0,0:12:46.14,0:12:47.72,Default,,0,0,0,,Компания ашу?
Dialogue: 0,0:12:48.01,0:12:52.23,Default,,0,0,0,,Иә, мен болашақты өзінше ойладым.
Dialogue: 0,0:12:52.60,0:12:55.52,Default,,0,0,0,,Біріншіден, бірнеше миллион лирадан тұратын шоқ.
Dialogue: 0,0:12:55.65,0:12:58.23,Default,,0,0,0,,Физикалық бұғауға айналу
Dialogue: 0,0:12:58.86,0:13:00.78,Default,,0,0,0,,Қаржы институттары да болуы мүмкін.
Dialogue: 0,0:13:00.90,0:13:04.03,Default,,0,0,0,,Менің ойымша, бұл дүниенің қауіпсіздігінде көп алаңдаушылық бар.
Dialogue: 0,0:13:04.20,0:13:05.24,Default,,0,0,0,,<Мен көремін>
Dialogue: 0,0:13:05.36,0:13:08.74,Default,,0,0,0,,<Ұмытып қалдым, өйткені менде ақшаның өзі жоқ...>
Dialogue: 0,0:13:08.95,0:13:11.33,Default,,0,0,0,,Және Орднунг Найзасы
Dialogue: 0,0:13:11.49,0:13:13.62,Default,,0,0,0,,Ұйымның нақты жағдайына жеткенше...
Dialogue: 0,0:13:13.75,0:13:15.96,Default,,0,0,0,,Біраз уақыт алатын сияқты.
Dialogue: 0,0:13:17.83,0:13:20.63,Default,,0,0,0,,Сондықтан мен қарама-қарсы идеяны қолданып көрдім.
Dialogue: 0,0:13:21.13,0:13:23.05,Default,,0,0,0,,Олардың қарсы күші ретінде
Dialogue: 0,0:13:23.17,0:13:26.38,Default,,0,0,0,,Өлейін деп жатқан адамдар үшін ыдыс жасау туралы не айтасыз?
Dialogue: 0,0:13:26.63,0:13:28.68,Default,,0,0,0,,Мен бұл компания екеніне сене алмаймын...
Dialogue: 0,0:13:28.97,0:13:29.89,Default,,0,0,0,,Иә
Dialogue: 0,0:13:30.05,0:13:32.52,Default,,0,0,0,,Жау болып қалса, айбатты болатын адамдар
Dialogue: 0,0:13:32.64,0:13:36.44,Default,,0,0,0,,Олар ұйымға түспес бұрын, жұмысқа орналасу түрінде олардың одақтастарына айналады.
Dialogue: 0,0:13:36.77,0:13:38.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:38.48,0:13:40.86,Default,,0,0,0,,Мен бұған қарсымын.
Dialogue: 0,0:13:41.07,0:13:43.19,Default,,0,0,0,,Тым қауіпті
Dialogue: 0,0:13:44.24,0:13:49.03,Default,,0,0,0,,Түпнұсқа дүниеден айырмашылығы бұл дүниеде ерекше ноталар бар.
Dialogue: 0,0:13:49.16,0:13:52.45,Default,,0,0,0,,Мен қандай қауіпті жігіт екенін білмеймін.
Dialogue: 0,0:13:52.58,0:13:55.08,Default,,0,0,0,,Неліктен мен компания ашуды шештім
Dialogue: 0,0:13:55.29,0:13:57.79,Default,,0,0,0,,Бұл арнайы ескертпелерді пайдалану үшін.
Dialogue: 0,0:13:57.92,0:13:58.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:58.92,0:14:02.42,Default,,0,0,0,,Арнайы жазбалардың қаупін түсіндім деп ойлаймын.
Dialogue: 0,0:14:03.13,0:14:07.43,Default,,0,0,0,,<Мазмұнын қайта жазу мүмкін емес және оның мәжбүрлеу күшіне ешкім қарсы тұра алмайды>
Dialogue: 0,0:14:08.30,0:14:11.55,Default,,0,0,0,,Біз осындай сиқырдан зардап шеккен адамдарға көмектесу үшін бірдеңе жасай аламыз ба?
Dialogue: 0,0:14:11.68,0:14:15.60,Default,,0,0,0,,Арнайы жазбаларды бірге пайдаланудың жолын табайық және дос бола алатынымызды көрейік...
Dialogue: 0,0:14:15.81,0:14:17.56,Default,,0,0,0,,Сонда да мен қарсымын.
Dialogue: 0,0:14:17.69,0:14:20.65,Default,,0,0,0,,Неліктен? Себебін айтыңызшы
Dialogue: 0,0:14:22.15,0:14:23.44,Default,,0,0,0,,Мәселе мынада
Dialogue: 0,0:14:23.57,0:14:26.40,Default,,0,0,0,,Сейджи мырза, бұл сіздің ерекше жазбаңыз.
Dialogue: 0,0:14:26.57,0:14:27.45,Default,,0,0,0,,Демек, сен болған болашаққа қайта орала алмаймын дегің келе ме?
Dialogue: 0,0:14:27.90,0:14:29.82,Default,,0,0,0,,<"Достарыңа ешқашан опасыздық жасама">
Dialogue: 0,0:14:30.20,0:14:31.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:31.37,0:14:35.83,Default,,0,0,0,,Әріптестеріңіздің арасында диссидент пайда болса ше...?
Dialogue: 0,0:14:37.33,0:14:38.87,Default,,0,0,0,,Дос болған соң
Dialogue: 0,0:14:39.04,0:14:41.92,Default,,0,0,0,,Сэйджи-сан ажырамас емес пе?
Dialogue: 0,0:14:42.50,0:14:44.75,Default,,0,0,0,,Олай болса, мен не істеуім керек...
Dialogue: 0,0:14:44.92,0:14:46.96,Default,,0,0,0,,Мен әрқашан ойладым
Dialogue: 0,0:14:47.55,0:14:50.68,Default,,0,0,0,,Сейджи патша болуы керек.
Dialogue: 0,0:14:50.84,0:14:52.47,Default,,0,0,0,,Мен патша боламын ба?
Dialogue: 0,0:14:52.93,0:14:56.06,Default,,0,0,0,,Сіз бір кездері листингілік компанияның президенті болдыңыз.
Dialogue: 0,0:14:56.22,0:14:58.52,Default,,0,0,0,,Бұл мүмкін емес деп ойлаймын
Dialogue: 0,0:15:00.85,0:15:04.98,Default,,0,0,0,,<Біріншіден, сенуге болатын сенімді адам жинаңыз.>
Dialogue: 0,0:15:05.36,0:15:08.03,Default,,0,0,0,,<Халықты басқаруды соларға қалдыр>
Dialogue: 0,0:15:08.15,0:15:11.24,Default,,0,0,0,,<Сэйджи-сан, мен сенің бәрін бақылап жүргеніңді қалаймын>
Dialogue: 0,0:15:11.66,0:15:13.03,Default,,0,0,0,,<Егер бұл форма>
Dialogue: 0,0:15:13.16,0:15:16.74,Default,,0,0,0,,<Мырза. Сейджи де арнайы ескертулермен байланысты емес>
Dialogue: 0,0:15:17.62,0:15:20.00,Default,,0,0,0,,Мен көремін. Сонымен... Иә?
Dialogue: 0,0:15:20.29,0:15:23.25,Default,,0,0,0,,Сіз компанияны басқаруды қалайсыз, иә?
Dialogue: 0,0:15:23.54,0:15:25.09,Default,,0,0,0,,Мен президентті жұмысқа алдым.
Dialogue: 0,0:15:25.21,0:15:27.88,Default,,0,0,0,,Егер адам қызметкерді қатаң бақылауда жұмысқа алса.
Dialogue: 0,0:15:28.01,0:15:29.76,Default,,0,0,0,,<Иә? ＞
Dialogue: 0,0:15:30.13,0:15:31.76,Default,,0,0,0,,Рахмет, Шигеру-сан!
Dialogue: 0,0:15:32.18,0:15:34.26,Default,,0,0,0,,Мені тыңдағаныңызға қуаныштымын!
Dialogue: 0,0:15:34.39,0:15:37.27,Default,,0,0,0,,<Неге бұл болып жатыр...>
Dialogue: 0,0:15:37.77,0:15:42.02,Default,,0,0,0,,<Айтпақшы, бастапқы әлемде Сейджи компаниясы қор биржасында листингке қойылған.>
Dialogue: 0,0:15:42.15,0:15:46.07,Default,,0,0,0,,<Бұл менің сөздерімді қиғаш түсіндірудің нәтижесі еді...>
Dialogue: 0,0:15:46.73,0:15:48.15,Default,,0,0,0,,<Жоқ, бірақ>
Dialogue: 0,0:15:48.28,0:15:51.53,Default,,0,0,0,,<Компаниядан бастаған дұрыс па? ＞
Dialogue: 0,0:15:51.65,0:15:54.95,Default,,0,0,0,,Шигеру-санның арқасында мен дайындалдым.
Dialogue: 0,0:15:55.24,0:15:59.70,Default,,0,0,0,,Сондықтан компанияның негізін қалаушы мүшелеріне өз атыңызды қоса аласыз ба?
Dialogue: 0,0:15:59.83,0:16:00.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:00.83,0:16:02.96,Default,,0,0,0,,Сенімді сенімді адам…
Dialogue: 0,0:16:03.08,0:16:05.59,Default,,0,0,0,,Шигеру-сан дәл осындай адам.
Dialogue: 0,0:16:07.71,0:16:09.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:09.80,0:16:10.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:11.63,0:16:15.80,Default,,0,0,0,,Мен компания деп аталатын ұйымда болмауы керек адаммын.
Dialogue: 0,0:16:15.93,0:16:16.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:17.10,0:16:18.81,Default,,0,0,0,,Арнайы ескерту
Dialogue: 0,0:16:18.97,0:16:21.39,Default,,0,0,0,,Алтынды ұстасам, ол жоғалады.
Dialogue: 0,0:16:21.52,0:16:23.31,Default,,0,0,0,,Нақты не?
Dialogue: 0,0:16:23.44,0:16:25.48,Default,,0,0,0,,«Депозит мөлшерлемесі 1/10 000»
Dialogue: 0,0:16:25.61,0:16:28.90,Default,,0,0,0,,Қанша ақша тапсаң да, тиіп кетсем, бәрі бекер.
Dialogue: 0,0:16:29.03,0:16:32.57,Default,,0,0,0,,Компанияға тиесілі болу тым қауіпті ме?
Dialogue: 0,0:16:32.74,0:16:33.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:33.86,0:16:36.91,Default,,0,0,0,,Сейджи-санның бұлдыр ойы болар еді, солай ма?
Dialogue: 0,0:16:37.03,0:16:39.08,Default,,0,0,0,,Тіпті бірінші бөрене үйі кезінде
Dialogue: 0,0:16:39.70,0:16:42.96,Default,,0,0,0,,Барлығының көшеде адасып кеткенін қаламаймын.
Dialogue: 0,0:16:43.08,0:16:45.08,Default,,0,0,0,,Сондықтан, бас тартыңыз.
Dialogue: 0,0:16:45.75,0:16:48.75,Default,,0,0,0,,Неліктен Шигеру мырза бұл ерекше жазбаны қосты?
Dialogue: 0,0:16:48.88,0:16:51.55,Default,,0,0,0,,Біздегі ақшаны өшіруге тырыспадың ба?
Dialogue: 0,0:16:51.67,0:16:52.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:55.76,0:16:57.26,Default,,0,0,0,,Неге...
Dialogue: 0,0:16:57.39,0:16:59.72,Default,,0,0,0,,Мұны істеуге ешқандай себеп жоқ.
Dialogue: 0,0:16:59.89,0:17:03.39,Default,,0,0,0,,Алайда бұл дүниеде ондай емес адамдар бар.
Dialogue: 0,0:17:03.52,0:17:05.14,Default,,0,0,0,,Өкінішке орай, ерекше ескертулер
Dialogue: 0,0:17:05.27,0:17:08.48,Default,,0,0,0,,Бұл өзіңнен де бақыты төмен адамды құруға тырысу сияқты...
Dialogue: 0,0:17:09.82,0:17:12.36,Default,,0,0,0,,Бірақ Шигеру олай етпеді.
Dialogue: 0,0:17:14.36,0:17:16.99,Default,,0,0,0,,Сіздің бар екендігіңіз дәлел
Dialogue: 0,0:17:17.20,0:17:21.41,Default,,0,0,0,,Қандай ерекше ескертулер болса да, адамдар өз қадір-қасиетін жоғалтпауы керек.
Dialogue: 0,0:17:22.37,0:17:24.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:24.12,0:17:25.96,Default,,0,0,0,,Маған күшіңізді беріңізші
Dialogue: 0,0:17:29.42,0:17:33.13,Default,,0,0,0,,<О, құдай, мен саған тең келер емеспін>
Dialogue: 0,0:17:33.59,0:17:37.13,Default,,0,0,0,,<Оны жақсы компанияға айналдырыңыз, Көшбасшы>
Dialogue: 0,0:17:37.30,0:17:39.64,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:17:40.05,0:17:41.89,Default,,0,0,0,,Сіз компаниясыз ба?
Dialogue: 0,0:17:42.22,0:17:43.22,Default,,0,0,0,,Иә
Dialogue: 0,0:17:43.35,0:17:46.64,Default,,0,0,0,,Арнайы жазбаларға ренжігендерге көмектесе аламын деп үміттенемін.
Dialogue: 0,0:17:46.77,0:17:48.31,Default,,0,0,0,,Жоғарыда айтқанымдай
Dialogue: 0,0:17:48.44,0:17:50.98,Default,,0,0,0,,Сондай-ақ қауіпті ұйымдарға қарсы тұру.
Dialogue: 0,0:17:51.11,0:17:52.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:52.61,0:17:55.36,Default,,0,0,0,,Әрине, мен оны мәжбүрлемеймін, бірақ...
Dialogue: 0,0:17:55.49,0:17:57.66,Default,,0,0,0,,Мен де партияның мүшесімін! (Сейджи/Шигеру) Ах...
Dialogue: 0,0:17:57.99,0:17:59.91,Default,,0,0,0,,Барымызды бірге жасайық!
Dialogue: 0,0:18:00.03,0:18:01.91,Default,,0,0,0,,Бұл қауіпті жұмыс емес пе?
Dialogue: 0,0:18:02.08,0:18:03.49,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,0:18:03.62,0:18:05.45,Default,,0,0,0,,Мен де!
Dialogue: 0,0:18:08.04,0:18:10.46,Default,,0,0,0,,Екеуіңізге де көп рахмет!
Dialogue: 0,0:18:11.09,0:18:12.50,Default,,0,0,0,,Макото-чан...
Dialogue: 0,0:18:13.00,0:18:16.13,Default,,0,0,0,,Сонымен, сіз өз компанияңызды қандай атаумен атағыңыз келеді?
Dialogue: 0,0:18:16.30,0:18:17.72,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:18:19.39,0:18:23.93,Default,,0,0,0,,Жанып тұрған алау адамдар!
Dialogue: 0,0:18:24.18,0:18:25.06,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:25.18,0:18:26.18,Default,,0,0,0,,<Эй~йо>
Dialogue: 0,0:18:26.31,0:18:27.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:27.56,0:18:28.69,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:18:31.81,0:18:32.73,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:33.11,0:18:34.69,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:18:35.32,0:18:39.03,Default,,0,0,0,,<Осылайша біз Сакурай мырзамен жолдарымызды ажыраттық>
Dialogue: 0,0:18:40.49,0:18:43.83,Default,,0,0,0,,<Валерия Князьдігіне оралғанына бір ай өтті>
Dialogue: 0,0:18:44.12,0:18:45.62,Default,,0,0,0,,Барлығына рахмет
Dialogue: 0,0:18:45.75,0:18:48.46,Default,,0,0,0,,Осылайша серіктестіктің құрылған күні аталып өтілді.
Dialogue: 0,0:18:49.00,0:18:50.46,Default,,0,0,0,,Ал ол... Иә?
Dialogue: 0,0:18:51.21,0:18:52.46,Default,,0,0,0,,Мен компаниямыздың президентімін.
Dialogue: 0,0:18:52.84,0:18:54.30,Default,,0,0,0,,<Бұл кім? ＞
Dialogue: 0,0:18:54.59,0:18:57.67,Default,,0,0,0,,Ол Йошио Кай, ол есіңде ме?
Dialogue: 0,0:18:57.80,0:19:00.30,Default,,0,0,0,,Казиноға қатысты ақпарат берілген...
Dialogue: 0,0:19:01.01,0:19:02.39,Default,,0,0,0,,<О, мүмкін>
Dialogue: 0,0:19:02.93,0:19:05.35,Default,,0,0,0,,Сіз казинода жұмыс істеген жоқсыз ба?
Dialogue: 0,0:19:05.56,0:19:08.27,Default,,0,0,0,,Иә, Сэйджи-сан сұрады.
Dialogue: 0,0:19:08.39,0:19:11.15,Default,,0,0,0,,Жалдамалы болып көрініп, ішке кіріп кету
Dialogue: 0,0:19:11.44,0:19:14.77,Default,,0,0,0,,Өтірікті көре білетін Кажита мырзаға сәттілік...
Dialogue: 0,0:19:14.90,0:19:17.15,Default,,0,0,0,,Көзге түспеу – ерекше шеберлік.
Dialogue: 0,0:19:17.28,0:19:19.24,Default,,0,0,0,,<Ол өте керемет адам емес пе? ＞
Dialogue: 0,0:19:19.36,0:19:23.45,Default,,0,0,0,,Шигеру-санның кеңесіне сүйене отырып, мен басқаруды Кай-санға тапсырамын.
Dialogue: 0,0:19:23.57,0:19:26.16,Default,,0,0,0,,Осылайша мен оңайырақ қозғала аламын...
Dialogue: 0,0:19:26.29,0:19:27.37,Default,,0,0,0,,Ах
Dialogue: 0,0:19:27.50,0:19:29.91,Default,,0,0,0,,Кешіріңіз! Кеш!
Dialogue: 0,0:19:30.12,0:19:31.33,Default,,0,0,0,,Като мырза!
Dialogue: 0,0:19:31.46,0:19:32.96,Default,,0,0,0,,Сіз де осы компанияда жұмыс істейсіз бе?
Dialogue: 0,0:19:33.13,0:19:35.13,Default,,0,0,0,,Иә, бәрі, біраз болды.
Dialogue: 0,0:19:35.67,0:19:37.63,Default,,0,0,0,,Қазір барлығы осында.
Dialogue: 0,0:19:40.59,0:19:43.89,Default,,0,0,0,,Сәлеметсіз бе, бұл Висбридж төрағасы Сейджи.
Dialogue: 0,0:19:44.35,0:19:46.06,Default,,0,0,0,,Бұл компанияның қызметі қандай?
Dialogue: 0,0:19:46.18,0:19:49.10,Default,,0,0,0,,Жұмысқа орналастыру және жұмысшыларды жіберу
Dialogue: 0,0:19:49.23,0:19:52.40,Default,,0,0,0,,Арнайы жазбаларда жазылған сөздерден зардап шеккендерге
Dialogue: 0,0:19:52.52,0:19:55.94,Default,,0,0,0,,Біздің корпоративтік мақсатымыз – дұрыс өмір сүруге жол көрсету.
Dialogue: 0,0:19:57.61,0:19:59.82,Default,,0,0,0,,Висбридж Vis - көрінетін жарық
Dialogue: 0,0:19:59.94,0:20:01.32,Default,,0,0,0,,Көпір – көпір
Dialogue: 0,0:20:01.45,0:20:04.57,Default,,0,0,0,,Жарыққа апаратын көпір мағынасында аталған.
Dialogue: 0,0:20:04.70,0:20:06.91,Default,,0,0,0,,<Бұл жақсы компания атауына қуаныштымын>
Dialogue: 0,0:20:07.45,0:20:09.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:10.50,0:20:13.75,Default,,0,0,0,,<Жақсы жұмыс, компания атауы идеясына лотерея ұтып алған Сейка-сан! ＞
Dialogue: 0,0:20:13.92,0:20:16.50,Default,,0,0,0,,Және тағы бір мақсат
Dialogue: 0,0:20:16.63,0:20:19.55,Default,,0,0,0,,Біз үшін өте құпия тапсырма ретінде...
Dialogue: 0,0:20:20.26,0:20:21.88,Default,,0,0,0,,Орднунг найзасы
Dialogue: 0,0:20:22.05,0:20:25.30,Default,,0,0,0,,Таңбасы осы жалау болып табылатын ұйымдар туралы ақпарат жинау
Dialogue: 0,0:20:25.59,0:20:28.06,Default,,0,0,0,,<Біз барлығын ұйым туралы хабардар еттік>
Dialogue: 0,0:20:28.76,0:20:32.73,Default,,0,0,0,,<Мен басқа абсолютті құдай Карина туралы ештеңе айта алмадым.>
Dialogue: 0,0:20:33.35,0:20:34.81,Default,,0,0,0,,Олай болса, бәріңе.
Dialogue: 0,0:20:35.19,0:20:37.15,Default,,0,0,0,,Бүгіннен бастап қолдау көрсеткеніңіз үшін рахмет!
Dialogue: 0,0:20:37.27,0:20:39.32,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:20:41.65,0:20:45.07,Default,,0,0,0,,<Әзірге мен Сейка-санның қызметкерін оқытамын>
Dialogue: 0,0:20:45.49,0:20:49.99,Default,,0,0,0,,<мырза Сейджи тіркелгісі келетіндердің құжаттарын тексеріп, таңдайды>
Dialogue: 0,0:20:50.20,0:20:53.62,Default,,0,0,0,,<Лис өзінің басқа адамдардың терезелерін оқу мүмкіндігін пайдаланады>
Dialogue: 0,0:20:53.75,0:20:57.59,Default,,0,0,0,,<Қаладағы алдын ала тергеу және тіркеуге өтініш берушілерді зерттеу>
Dialogue: 0,0:20:58.34,0:21:01.17,Default,,0,0,0,,<Ordnung Spear туралы ақпаратты алу мүмкін болмады>
Dialogue: 0,0:21:01.30,0:21:04.09,Default,,0,0,0,,<Бизнес қалпына келе бастады>
Dialogue: 0,0:21:06.01,0:21:07.30,Default,,0,0,0,,Арнайы ескертулер
Dialogue: 0,0:21:07.43,0:21:09.89,Default,,0,0,0,,«Маған ақша керек емес» деп жаздым
Dialogue: 0,0:21:10.06,0:21:12.68,Default,,0,0,0,,Отбасылық мұрагерлік даулардан шаршадым...
Dialogue: 0,0:21:12.81,0:21:14.64,Default,,0,0,0,,<Сіз жақсы өмір сүрдіңіз...>
Dialogue: 0,0:21:14.89,0:21:18.19,Default,,0,0,0,,Қолма-қол ақша болмаса жақсы ма?
Dialogue: 0,0:21:18.31,0:21:22.15,Default,,0,0,0,,Мысалы, сонымен қатар тауар түрінде өтемақы беруге болады және т.б.
Dialogue: 0,0:21:22.53,0:21:24.32,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:21:24.45,0:21:25.40,Default,,0,0,0,,Әрине!
Dialogue: 0,0:21:25.53,0:21:28.12,Default,,0,0,0,,Арнайы ескертпелер Біз сізге жақсы араласуға көмектесетін компаниямыз!
Dialogue: 0,0:21:28.53,0:21:30.03,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:21:30.16,0:21:32.16,Default,,0,0,0,,Хехе, үйге бара жатырсың
Dialogue: 0,0:21:32.29,0:21:34.87,Default,,0,0,0,,Қабылдау бөліміне кіру парағын тапсырыңыз.
Dialogue: 0,0:21:35.79,0:21:36.87,Default,,0,0,0,,<Сейка-сан>
Dialogue: 0,0:21:39.59,0:21:41.71,Default,,0,0,0,,<Бірдеңе болса бірден жылар едім>
Dialogue: 0,0:21:41.84,0:21:43.92,Default,,0,0,0,,<Мен толық сенімді болдым...>
Dialogue: 0,0:21:44.05,0:21:46.18,Default,,0,0,0,,Келесі адам бүгінгі соңғысы.
Dialogue: 0,0:21:46.30,0:21:48.39,Default,,0,0,0,,Иә! Келесі адам өтінемін!
Dialogue: 0,0:21:51.39,0:21:52.39,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:52.56,0:21:53.64,Default,,0,0,0,,<Уф...>
Dialogue: 0,0:21:55.52,0:21:57.52,Default,,0,0,0,,<Жас әйел? ＞
Dialogue: 0,0:21:58.90,0:22:00.15,Default,,0,0,0,,<Ку…>
Dialogue: 0,0:22:00.27,0:22:01.65,Default,,0,0,0,,<Ол не екені қызық...> (жүрек соғысы)
Dialogue: 0,0:22:02.44,0:22:04.86,Default,,0,0,0,,<Түргенде үлкен зиян келтіруден басқа>
Dialogue: 0,0:22:06.11,0:22:08.82,Default,,0,0,0,,<Мені бірдеңе мазалайды...>
