Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:03.71,Default,,0,0,0,,Мен сенен мұны тікелей жасайды деп күтпедім.
Dialogue: 0,0:00:03.79,0:00:05.63,Default,,0,0,0,,Мен Жапония филиалына келемін деп ойламадым.
Dialogue: 0,0:00:05.71,0:00:06.88,Default,,0,0,0,,Ахаха
Dialogue: 0,0:00:06.96,0:00:08.21,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:00:08.29,0:00:10.30,Default,,0,0,0,,Бірақ іштей жеңілдеп қалдың, солай ма?
Dialogue: 0,0:00:10.38,0:00:11.55,Default,,0,0,0,,Жақсы
Dialogue: 0,0:00:12.22,0:00:15.14,Default,,0,0,0,,Бірақ періште мені жиі кешіретін.
Dialogue: 0,0:00:15.22,0:00:17.68,Default,,0,0,0,,Бұл қазір төтенше жағдай.
Dialogue: 0,0:00:17.76,0:00:21.31,Default,,0,0,0,,Иә, Иллюминати жын жегіштерді пайдаланады.
Dialogue: 0,0:00:21.39,0:00:25.56,Default,,0,0,0,,Сіз олардың өлмейтіндігі мен қалпына келу қабілеті жоғары жындарды нысанаға алғанын естідіңіз бе?
Dialogue: 0,0:00:26.31,0:00:27.36,Default,,0,0,0,,О
Dialogue: 0,0:00:27.44,0:00:30.23,Default,,0,0,0,,Рыцарлар тобында тіркелмеген шайтан болса
Dialogue: 0,0:00:30.32,0:00:33.24,Default,,0,0,0,,Мен оны хабарлауды сұрадым.
Dialogue: 0,0:00:33.32,0:00:34.82,Default,,0,0,0,,Шура Сіз білмейсіз бе?
Dialogue: 0,0:00:34.90,0:00:37.49,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:00:37.57,0:00:38.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:38.66,0:00:41.95,Default,,0,0,0,,Себебі сізге таныс жылан (Нага) бар, солай ма?
Dialogue: 0,0:00:42.04,0:00:45.75,Default,,0,0,0,,Жетілдірілген нагалар көбінесе өлмейді.
Dialogue: 0,0:00:48.08,0:00:49.46,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:00:50.13,0:00:53.47,Default,,0,0,0,,Мен білетін ешкімнің өлместігі жоқ.
Dialogue: 0,0:01:15.61,0:01:18.78,Default,,0,0,0,,Осы уақытқа дейін мен бұл көздерден соқыр қорқатынмын.
Dialogue: 0,0:01:20.74,0:01:24.58,Default,,0,0,0,,Юкио қараңғылықтан қорқудың орнына
Dialogue: 0,0:01:24.66,0:01:27.83,Default,,0,0,0,,Күшті болыңыз және басқаларды және бауырыңызды қорғаңыз ...
Dialogue: 0,0:01:28.42,0:01:30.04,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:01:32.21,0:01:33.67,Default,,0,0,0,,Менің ағамнан артық
Dialogue: 0,0:01:36.67,0:01:38.68,Default,,0,0,0,,♪～
Dialogue: 0,0:03:04.01,0:03:06.01,Default,,0,0,0,,～♪
Dialogue: 0,0:03:10.48,0:03:13.52,Default,,0,0,0,,Біз бұл көздердің нақты не екенін тексеруіміз керек.
Dialogue: 0,0:03:15.32,0:03:17.73,Default,,0,0,0,,Рыцарьлар тобының егжей-тегжейлі тексеруі жойылды.
Dialogue: 0,0:03:17.82,0:03:21.07,Default,,0,0,0,,Егер сіздің ағаңыз сияқты генетика болса да,
Dialogue: 0,0:03:21.15,0:03:24.74,Default,,0,0,0,,Бұл тіпті менде де емес.
Dialogue: 0,0:03:33.17,0:03:37.75,Default,,0,0,0,,Біріншіден, көздің күші көрінген жағдайды қайта жасаудан басқа амалымыз жоқ.
Dialogue: 0,0:03:38.84,0:03:41.76,Default,,0,0,0,,Барлығы Тодомен шайқаста басталды.
Dialogue: 0,0:03:43.22,0:03:46.22,Default,,0,0,0,,Екінші рет Люцифермен кездескенімде болды.
Dialogue: 0,0:03:50.06,0:03:53.52,Default,,0,0,0,,Екі жағдайда да ортақ нәрсе бар
Dialogue: 0,0:03:54.02,0:03:58.15,Default,,0,0,0,,Қорқыныш Бұл да өлім алдындағы қорқыныш
Dialogue: 0,0:03:59.07,0:04:03.86,Default,,0,0,0,,Басқаша айтқанда, өмір немесе өлім қорқынышын өзіміз жасаудан басқа амалымыз жоқ.
Dialogue: 0,0:04:07.24,0:04:08.99,Default,,0,0,0,,Корихия Мелайна
Dialogue: 0,0:04:09.08,0:04:11.25,Default,,0,0,0,,Клеодора Клео Карея
Dialogue: 0,0:04:11.33,0:04:14.83,Default,,0,0,0,,...
Dialogue: 0,0:04:15.83,0:04:17.71,Default,,0,0,0,,Хехе...
Dialogue: 0,0:04:18.84,0:04:20.30,Default,,0,0,0,,Су рухының су түрмесі (Наиадес Карсель)
Dialogue: 0,0:04:48.99,0:04:50.08,Default,,0,0,0,,Gobo!
Dialogue: 0,0:04:57.33,0:04:58.33,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:05:01.55,0:05:02.63,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:05:07.72,0:05:10.51,Default,,0,0,0,,Гохогохо! Гехо...
Dialogue: 0,0:05:11.01,0:05:13.39,Default,,0,0,0,,Ха ха ха... Уф...
Dialogue: 0,0:05:14.10,0:05:17.65,Default,,0,0,0,,Ха ха ха... хехе хехе
Dialogue: 0,0:05:19.36,0:05:20.90,Default,,0,0,0,,Егер бұл әдіс
Dialogue: 0,0:05:20.98,0:05:23.61,Default,,0,0,0,,Өлім аузына ілінсем де
Dialogue: 0,0:05:23.69,0:05:26.78,Default,,0,0,0,,Мен оны қолданып көрдім, өйткені мен тірі қалуға мүмкіндік бар деп ойладым.
Dialogue: 0,0:05:27.36,0:05:30.37,Default,,0,0,0,,Иа... хех
Dialogue: 0,0:05:31.03,0:05:34.29,Default,,0,0,0,,Бұл қауіпсіздік тақтайшалары жылы ма?
Dialogue: 0,0:05:41.88,0:05:44.42,Default,,0,0,0,,Сугуро, Пон-чан, барасың ба?
Dialogue: 0,0:05:44.51,0:05:47.34,Default,,0,0,0,,Мен бүгін мектепке жиналып, емтиханға дайындаламын.
Dialogue: 0,0:05:47.43,0:05:49.30,Default,,0,0,0,,Монджа ұрып жатқанда
Dialogue: 0,0:05:49.39,0:05:50.97,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:05:51.05,0:05:52.72,Default,,0,0,0,,Магистратураны аяқтағаннан кейін...
Dialogue: 0,0:05:52.81,0:05:53.56,Default,,0,0,0,,(қатты шу)
Dialogue: 0,0:05:53.64,0:05:55.31,Default,,0,0,0,,А, мен жасадым.
Dialogue: 0,0:05:55.39,0:05:56.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:56.64,0:05:58.90,Default,,0,0,0,,Кешіріңіз! Қожайыным қиналып қалса, мен оны кесіп тастаймын.
Dialogue: 0,0:05:58.98,0:06:00.15,Default,,0,0,0,,Оқу
Dialogue: 0,0:06:00.65,0:06:02.86,Default,,0,0,0,,Сугуро бос емес сияқты.
Dialogue: 0,0:06:02.94,0:06:04.82,Default,,0,0,0,,Ол қазірдің өзінде толық неміс!
Dialogue: 0,0:06:06.65,0:06:10.45,Default,,0,0,0,,«Сол күні Ешуа Сихемде болды...»
Dialogue: 0,0:06:10.53,0:06:12.91,Default,,0,0,0,,Иә? Шекем дегеніміз не?
Dialogue: 0,0:06:13.41,0:06:16.04,Default,,0,0,0,,Мен де жеткіліксіз оқимын деп ойлаймын.
Dialogue: 0,0:06:16.12,0:06:17.87,Default,,0,0,0,,Соңғы кездері мен ешқандай алға жылжымаймын.
Dialogue: 0,0:06:17.96,0:06:18.79,Default,,0,0,0,,Хаа…
Dialogue: 0,0:06:18.87,0:06:21.83,Default,,0,0,0,,Сізге дәл осындай уақытта хабарлассам ыңғайлы болар еді.
Dialogue: 0,0:06:21.92,0:06:23.88,Default,,0,0,0,,Тек жаттау ғана емес
Dialogue: 0,0:06:23.96,0:06:27.05,Default,,0,0,0,,Сөздердің мағынасын, шығу тарихын да зерттедім.
Dialogue: 0,0:06:27.13,0:06:29.22,Default,,0,0,0,,Ол таңқаларлықтай жақсы сабақ береді.
Dialogue: 0,0:06:29.30,0:06:31.59,Default,,0,0,0,,Сіз әлі де солай айтасыз ба? бас тарт.
Dialogue: 0,0:06:31.68,0:06:34.35,Default,,0,0,0,,Сугуро енді Lightning-тің неміс менеджері.
Dialogue: 0,0:06:35.06,0:06:36.85,Default,,0,0,0,,Бала неміс!
Dialogue: 0,0:06:36.93,0:06:38.94,Default,,0,0,0,,Сіз шынымен сонда сүйреп бара жатырсыз.
Dialogue: 0,0:06:39.02,0:06:42.86,Default,,0,0,0,,Шима-сан, біз саған мәңгілік сене алмаймыз.
Dialogue: 0,0:06:44.19,0:06:45.19,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:06:45.69,0:06:51.91,Default,,0,0,0,,Мен қазір жүйені дамытуды оқып жатырмын.
Dialogue: 0,0:06:51.99,0:06:52.78,Default,,0,0,0,,- (фосфор) Әй? -(Шима) Аа...
Dialogue: 0,0:06:52.87,0:06:57.12,Default,,0,0,0,,Біріншіден, жындармен шайқас деректерін жіктеу ақыры аяқталды.
Dialogue: 0,0:06:57.20,0:07:01.12,Default,,0,0,0,,Мен бұл деректерді көбірек пайдалану керек деп ойлай бастадым.
Dialogue: 0,0:07:01.83,0:07:04.88,Default,,0,0,0,,Шайтанның бейнесі смартфон арқылы танылған кезде
Dialogue: 0,0:07:05.96,0:07:10.13,Default,,0,0,0,,Әлсіз және өлімге әкелетін нүктелерді лезде іздеу мүмкіндігі
Dialogue: 0,0:07:10.22,0:07:14.64,Default,,0,0,0,,Мен сол қолданба сияқты нәрсені жасауға болады ма деп ойлаймын.
Dialogue: 0,0:07:14.72,0:07:16.31,Default,,0,0,0,,Яғни, егер ол болса
Dialogue: 0,0:07:16.39,0:07:19.10,Default,,0,0,0,,Бұл бізге оқудың қажеті жоқ дегенді білдіре ме?
Dialogue: 0,0:07:19.68,0:07:21.31,Default,,0,0,0,,Мұны істеу үшін бар күшіңізді салыңыз!
Dialogue: 0,0:07:21.39,0:07:24.19,Default,,0,0,0,,Жоқ, жоқ, бұл жай ғана көмекші пайда.
Dialogue: 0,0:07:24.27,0:07:26.11,Default,,0,0,0,,Сіз оқуға болмайды.
Dialogue: 0,0:07:26.61,0:07:27.86,Default,,0,0,0,,Бірақ мен бар күшімді саламын.
Dialogue: 0,0:07:27.94,0:07:28.82,Default,,0,0,0,,О!
Dialogue: 0,0:07:28.90,0:07:32.32,Default,,0,0,0,,Котенка да алға жылжиды.
Dialogue: 0,0:07:32.41,0:07:36.83,Default,,0,0,0,,Осылайша әркім өз жолымен жүреді.
Dialogue: 0,0:07:36.91,0:07:39.95,Default,,0,0,0,,Мен де сенбеймін деп ойлаймын.
Dialogue: 0,0:07:40.04,0:07:41.21,Default,,0,0,0,,(Сүйек сынуының дыбысы)
Dialogue: 0,0:07:41.29,0:07:43.88,Default,,0,0,0,,Сіз ең көп бұзылған жолға түскен адамсыз.
Dialogue: 0,0:07:43.96,0:07:44.83,Default,,0,0,0,,Техехе
Dialogue: 0,0:07:44.92,0:07:47.21,Default,,0,0,0,,Жоқ, мен де.
Dialogue: 0,0:07:47.30,0:07:51.38,Default,,0,0,0,,Котенка бұрын айтқандай, мен рыцарьларды жырлаудан бас тарттым.
Dialogue: 0,0:07:51.47,0:07:51.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:53.47,0:07:56.55,Default,,0,0,0,,Рыцарь және қол рыцарь (үйретуші) Мен оны аламын деп ойлаймын.
Dialogue: 0,0:07:57.05,0:08:00.31,Default,,0,0,0,,Бұрын мен мұнда бәрібір қайтып келе алмайтын едім.
Dialogue: 0,0:08:00.39,0:08:03.64,Default,,0,0,0,,Мен жай ғана бір нәрсе туралы ойладым.
Dialogue: 0,0:08:03.73,0:08:05.52,Default,,0,0,0,,Қайтып келгеніңізге қуаныштымын.
Dialogue: 0,0:08:05.61,0:08:08.86,Default,,0,0,0,,Мен біраз уақытқа бар күшімді салуым керек деп ойладым.
Dialogue: 0,0:08:08.94,0:08:10.36,Default,,0,0,0,,Шима мырза...
Dialogue: 0,0:08:10.44,0:08:13.40,Default,,0,0,0,,Бірақ оқу өте қиын.
Dialogue: 0,0:08:13.49,0:08:15.99,Default,,0,0,0,,Отыруды жалғастыру онсыз да қиын.
Dialogue: 0,0:08:16.07,0:08:16.87,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:08:16.95,0:08:19.62,Default,,0,0,0,,Ооо, сен әлі ауырып жатырсың ба?
Dialogue: 0,0:08:19.70,0:08:21.50,Default,,0,0,0,,А, қарным ашты.
Dialogue: 0,0:08:21.58,0:08:23.54,Default,,0,0,0,,Қария 1 үлкен порция якисоба
Dialogue: 0,0:08:23.62,0:08:24.12,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:24.71,0:08:27.63,Default,,0,0,0,,Уау! Ұстаз, маған оқуға көмектесіңіз~
Dialogue: 0,0:08:27.71,0:08:29.96,Default,,0,0,0,,Сугуро Мен сені күттім! Шехем дегеніміз не?
Dialogue: 0,0:08:30.05,0:08:31.26,Default,,0,0,0,,Не... балалар сендер кімсіңдер?
Dialogue: 0,0:08:31.34,0:08:35.68,Default,,0,0,0,,Шехем — қазіргі Палестинада Наблус деген жер атауы.
Dialogue: 0,0:08:35.76,0:08:38.22,Default,,0,0,0,,Өйткені, бала қиын сияқты.
Dialogue: 0,0:08:38.30,0:08:39.43,Default,,0,0,0,,Бірінші орында, Бо
Dialogue: 0,0:08:39.51,0:08:42.27,Default,,0,0,0,,Германдық темперамент Мен мұны істеген болармын.
Dialogue: 0,0:08:43.94,0:08:45.81,Default,,0,0,0,,Басына дейін бүгілген
Dialogue: 0,0:08:45.90,0:08:47.56,Default,,0,0,0,,Оны орамаңыз.
Dialogue: 0,0:08:47.65,0:08:49.82,Default,,0,0,0,,Бұл домалақ болса да солай!
Dialogue: 0,0:08:49.90,0:08:52.99,Default,,0,0,0,,Шәкірт болдым, тың бастама.
Dialogue: 0,0:08:53.07,0:08:55.66,Default,,0,0,0,,Бала, сен неге сонша...
Dialogue: 0,0:08:55.74,0:08:59.37,Default,,0,0,0,,Хаа... Ол кісі, Найзағай.
Dialogue: 0,0:08:59.45,0:09:03.79,Default,,0,0,0,,Қабілет пен психикалық денсаулық жағынан мен қазір жетіспейтін нәрсені аламын.
Dialogue: 0,0:09:04.41,0:09:06.87,Default,,0,0,0,,Бұл дегеніміз...
Dialogue: 0,0:09:07.46,0:09:08.50,Default,,0,0,0,,Хоретания
Dialogue: 0,0:09:08.58,0:09:09.67,Default,,0,0,0,,Не!
Dialogue: 0,0:09:09.75,0:09:12.51,Default,,0,0,0,,Мен оны логикалық тұрғыдан түсіндіре алмаймын, бірақ
Dialogue: 0,0:09:13.30,0:09:17.09,Default,,0,0,0,,Бұл... Маған біреу ғашық болады дегенге сене алар емеспін.
Dialogue: 0,0:09:17.18,0:09:18.55,Default,,0,0,0,,Мен қатты таң қалдым.
Dialogue: 0,0:09:18.64,0:09:19.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:19.68,0:09:23.31,Default,,0,0,0,,Ол әрқашан біздің бастық сияқты болды.
Dialogue: 0,0:09:23.39,0:09:26.52,Default,,0,0,0,,Төменгі жағында болу мүлдем мүмкін емес.
Dialogue: 0,0:09:27.10,0:09:27.65,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:28.35,0:09:32.15,Default,,0,0,0,,Кішкентай кезімнен мені үлкен атақ деп өсірді.
Dialogue: 0,0:09:32.23,0:09:35.03,Default,,0,0,0,,Шынымды айтсам, басқа ештеңе білмеймін.
Dialogue: 0,0:09:35.11,0:09:39.28,Default,,0,0,0,,Мен өз жолымда басқа адамдардың қол астында жұмыс істегім келеді.
Dialogue: 0,0:09:40.37,0:09:41.28,Default,,0,0,0,,Бала…
Dialogue: 0,0:09:41.37,0:09:43.33,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:09:43.41,0:09:44.95,Default,,0,0,0,,Жылама, Китенмару
Dialogue: 0,0:09:45.04,0:09:47.75,Default,,0,0,0,,Сугуро – шыншыл адам.
Dialogue: 0,0:09:47.83,0:09:49.08,Default,,0,0,0,,Мен сізді қолдаймын
Dialogue: 0,0:09:49.17,0:09:51.42,Default,,0,0,0,,Бұл біздің бастық маймыл емес!
Dialogue: 0,0:09:51.50,0:09:54.55,Default,,0,0,0,,Өтінемін, аузыңызды жауып тастай аласыз ба?
Dialogue: 0,0:09:58.93,0:10:03.39,Default,,0,0,0,,Мен бірнеше күннен бері шешім қабылдай алмай жүрмін...
Dialogue: 0,0:10:04.52,0:10:08.14,Default,,0,0,0,,Мен ешқашан қайтып оралмаспын деп ойлаған кезде...
Dialogue: 0,0:10:13.77,0:10:15.86,Default,,0,0,0,,Олай болса өмір бойы осылай жүре бер.
Dialogue: 0,0:10:15.94,0:10:19.11,Default,,0,0,0,,Сіз өзіңіздің шыққан тегіңізден және Иллюминатиден қорқумен өмір сүресіз бе?
Dialogue: 0,0:10:19.20,0:10:22.49,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:10:22.58,0:10:24.08,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:10:26.16,0:10:29.12,Default,,0,0,0,,Менің қазір істеуден басқа амалым жоқ.
Dialogue: 0,0:10:30.17,0:10:31.83,Default,,0,0,0,,Тек орындаңыз!
Dialogue: 0,0:10:31.92,0:10:38.47,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:10:44.06,0:10:45.18,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:46.77,0:10:49.06,Default,,0,0,0,,Маған ұнамайды! қорқады!
Dialogue: 0,0:10:49.14,0:10:51.52,Default,,0,0,0,,Қорқынышты! қорқады!
Dialogue: 0,0:10:51.60,0:10:52.98,Default,,0,0,0,,Менің өлгім келмейді!
Dialogue: 0,0:10:58.28,0:10:59.28,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:06.04,0:11:06.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:07.54,0:11:10.50,Default,,0,0,0,,Қайырлы таң анашым, сіз әлі шығасыз ба?
Dialogue: 0,0:11:10.58,0:11:12.54,Default,,0,0,0,,Жеткізуші қиындыққа тап болды.
Dialogue: 0,0:11:13.17,0:11:14.25,Default,,0,0,0,,Оның түйреуіш бар.
Dialogue: 0,0:11:14.34,0:11:15.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:15.29,0:11:17.00,Default,,0,0,0,,Осы уақыт аралығындағы жаралар
Dialogue: 0,0:11:17.09,0:11:20.42,Default,,0,0,0,,Таңғыш шешілді, бірақ тыртық қалды.
Dialogue: 0,0:11:20.51,0:11:23.34,Default,,0,0,0,,Бұл менің шаштарымнан жасырылған, сондықтан мен жақсымын.
Dialogue: 0,0:11:25.05,0:11:26.39,Default,,0,0,0,,-Иә - (Шиемінің анасы) А?
Dialogue: 0,0:11:26.47,0:11:32.06,Default,,0,0,0,,Мен әлі күнге дейін Exorcist сертификаттау емтиханына қандай атақ (Мейстер) тапсыру керектігін ойлап жүрмін.
Dialogue: 0,0:11:32.90,0:11:34.40,Default,,0,0,0,,Оны қабылдауға болады ма?
Dialogue: 0,0:11:36.07,0:11:37.69,Default,,0,0,0,,- (Шиемінің анасы) Ха... - А?
Dialogue: 0,0:11:37.78,0:11:38.82,Default,,0,0,0,,Сіз
Dialogue: 0,0:11:38.90,0:11:42.78,Default,,0,0,0,,Сіз шынымен де эксзорцист болуды мақсат еткен жоқсыз, солай ма?
Dialogue: 0,0:11:42.86,0:11:43.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:44.12,0:11:46.99,Default,,0,0,0,,Жоқ, сіз агрессивті болып жатырсыз.
Dialogue: 0,0:11:47.08,0:11:49.70,Default,,0,0,0,,Менің ойымша, бұл өте жақсы болды.
Dialogue: 0,0:11:50.20,0:11:53.75,Default,,0,0,0,,Мен сенің соңғы алты айда қатты жұмыс істегеніңді көрдім.
Dialogue: 0,0:11:54.50,0:11:57.71,Default,,0,0,0,,Бірақ... бұл қауіпті жұмыс, солай емес пе?
Dialogue: 0,0:11:58.21,0:12:03.47,Default,,0,0,0,,Сіз шынымен де болашақта эксорцист болғыңыз келе ме?
Dialogue: 0,0:12:10.14,0:12:13.44,Default,,0,0,0,,Екеуміз ғана миссияда жүргенімізге біраз болды.
Dialogue: 0,0:12:13.52,0:12:14.60,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:15.86,0:12:17.11,Default,,0,0,0,,Тіпті егер...
Dialogue: 0,0:12:17.19,0:12:20.40,Default,,0,0,0,,Бұл жігіт маған түк те ойламайды.
Dialogue: 0,0:12:20.90,0:12:22.28,Default,,0,0,0,,Бакака Бакака
Dialogue: 0,0:12:22.36,0:12:24.24,Default,,0,0,0,,-(Фосфор) А... -Мм?
Dialogue: 0,0:12:24.91,0:12:26.70,Default,,0,0,0,,- (Каванака) А, міне келдік! -(Рин) Ах...
Dialogue: 0,0:12:26.78,0:12:29.08,Default,,0,0,0,,Бұл үміткерлер, солай емес пе?
Dialogue: 0,0:12:29.58,0:12:32.29,Default,,0,0,0,,Маған жұмыс күші жетпегендіктен қиналдым. Өтінемін маған көмектесіңіз.
Dialogue: 0,0:12:32.37,0:12:34.58,Default,,0,0,0,,Бұл көрініс.
Dialogue: 0,0:12:35.67,0:12:38.21,Default,,0,0,0,,Олар үйдің мүмкіндігінше бүтін болғанын және тек жындардың қуылғанын қалайды.
Dialogue: 0,0:12:38.29,0:12:40.00,Default,,0,0,0,,Бұл күшті ниет.
Dialogue: 0,0:12:40.09,0:12:41.71,Default,,0,0,0,,Мен үйдің ішін жылдам қарап шықтым.
Dialogue: 0,0:12:41.80,0:12:44.68,Default,,0,0,0,,Көмір шайыры көп өндіріліп жатқан сияқты.
Dialogue: 0,0:12:45.47,0:12:47.05,Default,,0,0,0,,Иә, бұл қасиетті су бүріккіш
Dialogue: 0,0:12:47.64,0:12:49.18,Default,,0,0,0,,Бұл толтыру резервуары.
Dialogue: 0,0:12:49.26,0:12:50.60,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:12:50.68,0:12:52.52,Default,,0,0,0,,Мен кейінірек келемін!
Dialogue: 0,0:12:53.18,0:12:54.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:04.32,0:13:07.62,Default,,0,0,0,,Уау... керемет сома
Dialogue: 0,0:13:07.70,0:13:09.87,Default,,0,0,0,,Фосфор Қасиетті су қауіпсіз бе?
Dialogue: 0,0:13:09.95,0:13:13.83,Default,,0,0,0,,Иә, егер ол тұман түрінде болса, аздап дірілдейді.
Dialogue: 0,0:13:15.87,0:13:18.46,Default,,0,0,0,,Бак алып жүру кезінде багаж кедергі болып табылады
Dialogue: 0,0:13:18.54,0:13:20.96,Default,,0,0,0,,Ни Чан, сен мені бақылай аласың ба?
Dialogue: 0,0:13:21.05,0:13:22.92,Default,,0,0,0,,Ni~ Ni~!
Dialogue: 0,0:13:24.34,0:13:25.38,Default,,0,0,0,,(шашу дыбысы)
Dialogue: 0,0:13:26.93,0:13:30.47,Default,,0,0,0,,Айтпақшы, Шиеми қандай Мейстер емтиханын тапсырады?
Dialogue: 0,0:13:30.55,0:13:32.89,Default,,0,0,0,,Не? Фосфор туралы не деуге болады?
Dialogue: 0,0:13:32.97,0:13:36.73,Default,,0,0,0,,Мен рыцарьмын, сондықтан мен бәрібір тек қылыш қолдана аламын.
Dialogue: 0,0:13:37.44,0:13:41.11,Default,,0,0,0,,Түсіндім, фосфор өзгермейді.
Dialogue: 0,0:13:43.69,0:13:45.74,Default,,0,0,0,,Мен әлі ойланып жүрмін
Dialogue: 0,0:13:45.82,0:13:47.49,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:47.99,0:13:48.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:51.08,0:13:52.70,Default,,0,0,0,,Реңк! Кешіріңіз
Dialogue: 0,0:13:53.20,0:13:55.16,Default,,0,0,0,,Бұл үйде не болып жатыр?
Dialogue: 0,0:13:55.25,0:13:55.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:55.87,0:13:58.46,Default,,0,0,0,,Мен оны төменнен сезінемін. Бұл кокс болуы мүмкін.
Dialogue: 0,0:13:58.54,0:14:00.33,Default,,0,0,0,,Ал, қазір сыртқа шығайық.
Dialogue: 0,0:14:00.42,0:14:02.75,Default,,0,0,0,,Мен капитанға ертерек хабарласуым керек.
Dialogue: 0,0:14:02.84,0:14:03.67,Default,,0,0,0,,Кокс, солай ма?
Dialogue: 0,0:14:03.75,0:14:06.51,Default,,0,0,0,,Бұл тек көмір шайырының жиынтығы.
Dialogue: 0,0:14:07.01,0:14:09.93,Default,,0,0,0,,Жарайды. Шыққан күнде де оңай...
Dialogue: 0,0:14:10.01,0:14:11.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:13.01,0:14:14.35,Default,,0,0,0,,- (фосфор) Уау! - фосфор!
Dialogue: 0,0:14:14.43,0:14:16.10,Default,,0,0,0,,Оянып қалдым да, бүкіл денем ауырады~!
Dialogue: 0,0:14:16.18,0:14:17.31,Default,,0,0,0,,(Нәрсенің құлаған дыбысы)
Dialogue: 0,0:14:21.52,0:14:22.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:23.94,0:14:26.40,Default,,0,0,0,,Рин Жақсысың ба?
Dialogue: 0,0:14:26.90,0:14:29.15,Default,,0,0,0,,А, онда ағаш таяқ ілініп тұр!
Dialogue: 0,0:14:29.74,0:14:30.49,Default,,0,0,0,,Эмма…
Dialogue: 0,0:14:30.99,0:14:32.66,Default,,0,0,0,,-Уф... -(Рин) Жақсысың ба?
Dialogue: 0,0:14:32.74,0:14:35.33,Default,,0,0,0,,Осындай уақытта не істеуім керек?
Dialogue: 0,0:14:35.41,0:14:37.96,Default,,0,0,0,,Мен Ни Чан мен жүктерімді артта қалдырдым.
Dialogue: 0,0:14:38.04,0:14:40.62,Default,,0,0,0,,Жарайды, бұл тез жазылады.
Dialogue: 0,0:14:41.13,0:14:43.92,Default,,0,0,0,,Оның үстіне сен жараланған емессің бе?
Dialogue: 0,0:14:44.00,0:14:45.05,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:14:45.13,0:14:48.72,Default,,0,0,0,,Саған бұлай болмағанына қуаныштымын.
Dialogue: 0,0:14:50.43,0:14:52.51,Default,,0,0,0,,Маған тез арада көмек шақыру керек.
Dialogue: 0,0:14:52.60,0:14:53.55,Default,,0,0,0,,Риннің ұялы телефоны ше?
Dialogue: 0,0:14:56.39,0:14:57.47,Default,,0,0,0,,Ауқымнан тыс
Dialogue: 0,0:14:59.64,0:15:02.19,Default,,0,0,0,,Сіз әбден тереңге түстіңіз, солай емес пе?
Dialogue: 0,0:15:05.36,0:15:06.69,Default,,0,0,0,,Олар әдемі әйелдер.
Dialogue: 0,0:15:06.78,0:15:08.90,Default,,0,0,0,,Мынаны алып тастаңыз, мен көмекке шақырамын...
Dialogue: 0,0:15:10.24,0:15:11.70,Default,,0,0,0,,-(Рин) Ах... -Хьяа
Dialogue: 0,0:15:12.66,0:15:17.04,Default,,0,0,0,,Жоқ, егер мен бұл ағашты жылжытсам, жоғарыдағы үйінділер құлап қалады.
Dialogue: 0,0:15:17.54,0:15:20.21,Default,,0,0,0,,Сәлем! Біреу маған көмектес!
Dialogue: 0,0:15:22.17,0:15:25.88,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,0:15:26.38,0:15:27.96,Default,,0,0,0,,Эй
Dialogue: 0,0:15:28.05,0:15:29.80,Default,,0,0,0,,(Ни Чанның ұйықтап жатқан тынысы)
Dialogue: 0,0:15:29.88,0:15:33.55,Default,,0,0,0,,Эй, сәлем…
Dialogue: 0,0:15:36.51,0:15:39.93,Default,,0,0,0,,Капитан, сіз жақында қайтасыз.
Dialogue: 0,0:15:40.02,0:15:41.31,Default,,0,0,0,,Сәттілік, Рин
Dialogue: 0,0:15:41.81,0:15:45.44,Default,,0,0,0,,Менің кесірімнен осындай болғаныңа өкінемін.
Dialogue: 0,0:15:46.07,0:15:47.82,Default,,0,0,0,,Мен әрқашан осылай болдым
Dialogue: 0,0:15:48.32,0:15:50.82,Default,,0,0,0,,Юкио да осындай нәрселерге ашуланады.
Dialogue: 0,0:15:50.90,0:15:52.49,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:15:52.57,0:15:54.99,Default,,0,0,0,,Егер Юки Чан осында болса, ол ашулы болар еді.
Dialogue: 0,0:15:55.07,0:15:55.91,Default,,0,0,0,,Сен
Dialogue: 0,0:15:55.99,0:15:56.74,Default,,0,0,0,,...
Dialogue: 0,0:15:56.83,0:15:58.83,Default,,0,0,0,,Әй, қай жерде айттың?
Dialogue: 0,0:15:59.45,0:16:02.21,Default,,0,0,0,,Мен Рин үшін уайымдап тұрмын, оның ашуланатынына сенімдімін.
Dialogue: 0,0:16:03.92,0:16:07.67,Default,,0,0,0,,Мен анамның қазір уайымдағанына сенімдімін.
Dialogue: 0,0:16:08.17,0:16:11.67,Default,,0,0,0,,Сен уайымда, сен отбасысың.
Dialogue: 0,0:16:13.80,0:16:17.55,Default,,0,0,0,,А, жоқ, күн батып, күн суытып барады.
Dialogue: 0,0:16:17.64,0:16:19.10,Default,,0,0,0,,Фосфор суық...
Dialogue: 0,0:16:19.93,0:16:21.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:22.31,0:16:24.56,Default,,0,0,0,,Уау~ Өте жылы
Dialogue: 0,0:16:24.65,0:16:26.94,Default,,0,0,0,,Бұл сізді аздап жылытады.
Dialogue: 0,0:16:29.07,0:16:30.61,Default,,0,0,0,,Жақын кел
Dialogue: 0,0:16:30.69,0:16:31.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:31.28,0:16:33.07,Default,,0,0,0,,Мен осы құдай таңдаған ессіз ғалыммын…
Dialogue: 0,0:16:33.70,0:16:34.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:34.78,0:16:35.74,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:16:35.82,0:16:38.20,Default,,0,0,0,,-Кешіріңіз! -(Рин) О...о
Dialogue: 0,0:16:39.79,0:16:44.16,Default,,0,0,0,,Хмм... Мен бұрынғыдан әлдеқайда басқарылатын болдым.
Dialogue: 0,0:16:44.25,0:16:46.79,Default,,0,0,0,,Пішінді өте еркін пішіндеуге болады.
Dialogue: 0,0:16:46.88,0:16:48.92,Default,,0,0,0,,Шынымен бе? Мен оны көргім келеді
Dialogue: 0,0:16:49.00,0:16:50.59,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:16:50.67,0:16:52.72,Default,,0,0,0,,Онда мен сені 18-ші қара қыламын.
Dialogue: 0,0:16:56.47,0:16:58.64,Default,,0,0,0,,Уау~ сүйкімді сегізаяқ
Dialogue: 0,0:16:58.72,0:17:00.47,Default,,0,0,0,,Бұл қара!
Dialogue: 0,0:17:01.89,0:17:03.43,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:17:04.06,0:17:07.94,Default,,0,0,0,,Маған фосфорлы жалын ұнайды
Dialogue: 0,0:17:08.02,0:17:08.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:09.48,0:17:11.98,Default,,0,0,0,,Бұл жылы және босаңсытады
Dialogue: 0,0:17:13.28,0:17:14.45,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:17:18.53,0:17:21.58,Default,,0,0,0,,Мен де сені жақсы көремін
Dialogue: 0,0:17:22.79,0:17:23.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:26.58,0:17:28.75,Default,,0,0,0,,Мен... мен... А, рахмет.
Dialogue: 0,0:17:29.25,0:17:30.46,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,0:17:36.84,0:17:38.34,Default,,0,0,0,,Фосфор?
Dialogue: 0,0:17:40.85,0:17:45.27,Default,,0,0,0,,О... бұл саған ұнайды, солай ма? Тек дос ретінде
Dialogue: 0,0:17:45.35,0:17:47.27,Default,,0,0,0,,Нахахахаха!
Dialogue: 0,0:17:51.19,0:17:52.86,Default,,0,0,0,,Сізге Юкио ұнайды, солай ма?
Dialogue: 0,0:17:53.36,0:17:56.28,Default,,0,0,0,,Мм... Иә, әрине маған Юки Чан ұнайды.
Dialogue: 0,0:17:56.90,0:17:58.91,Default,,0,0,0,,Рин мен Юки Чан екеуі дос.
Dialogue: 0,0:17:59.49,0:18:01.28,Default,,0,0,0,,Иә? Бұл дұрыс емес, Юкио.
Dialogue: 0,0:18:01.37,0:18:03.54,Default,,0,0,0,,Мен әрқашан Юкио үшін алаңдаймын.
Dialogue: 0,0:18:03.62,0:18:07.04,Default,,0,0,0,,Достарыңызға «Юки-чан...» деп не айтасыз?
Dialogue: 0,0:18:07.12,0:18:10.29,Default,,0,0,0,,Ю... Юки-чан менің кейіпкерім болды.
Dialogue: 0,0:18:10.79,0:18:12.34,Default,,0,0,0,,Бірақ қазір бәрі басқаша.
Dialogue: 0,0:18:12.92,0:18:16.84,Default,,0,0,0,,Юки-чанның досы ретінде мен оған көмектескім келеді.
Dialogue: 0,0:18:17.55,0:18:20.22,Default,,0,0,0,,Менің күшім жетпеуі мүмкін, бірақ
Dialogue: 0,0:18:20.72,0:18:22.76,Default,,0,0,0,,Не? Жарайды... болмайды, сен
Dialogue: 0,0:18:22.85,0:18:26.48,Default,,0,0,0,,Бұл маған Юкио немесе Юкио романтикалық қарым-қатынас ретінде ұнамайды дегенді білдіре ме?
Dialogue: 0,0:18:26.56,0:18:29.14,Default,,0,0,0,,Махаббат? мен?
Dialogue: 0,0:18:29.23,0:18:33.11,Default,,0,0,0,,Хмм... Бұл мүмкін емес. Мен әлі баламын.
Dialogue: 0,0:18:33.19,0:18:35.53,Default,,0,0,0,,Махаббат бұл...
Dialogue: 0,0:18:36.11,0:18:36.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:37.44,0:18:39.61,Default,,0,0,0,,-(Фосфор) Ух... -Фосфор нені жақсы көреді...
Dialogue: 0,0:18:40.70,0:18:43.37,Default,,0,0,0,,Махаббат... Сізге ұнай ма?
Dialogue: 0,0:18:43.45,0:18:44.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:50.50,0:18:51.13,Default,,0,0,0,,Ах
Dialogue: 0,0:18:51.71,0:18:55.63,Default,,0,0,0,,Бұл көмір шайыры ма? Ол төменнен ағып жатыр
Dialogue: 0,0:18:56.59,0:18:58.76,Default,,0,0,0,,Бұл оның жерде паразиттік тіршілік ететінін білдіре ме?
Dialogue: 0,0:18:58.84,0:19:01.18,Default,,0,0,0,,Егер солай болса, бұл өте үлкен.
Dialogue: 0,0:19:01.26,0:19:02.64,Default,,0,0,0,,Бұл кокс...
Dialogue: 0,0:19:02.72,0:19:06.14,Default,,0,0,0,,Tsk, егер бұлай болса, менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:19:08.18,0:19:09.14,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:09.23,0:19:11.15,Default,,0,0,0,,- (Тұрғындар) Уау! - (тұрғын) Не болды?
Dialogue: 0,0:19:11.23,0:19:14.31,Default,,0,0,0,,- (Тұрғын) Жанып жатыр! - (Тұрғын) Елес жарылды ма?
Dialogue: 0,0:19:14.40,0:19:16.69,Default,,0,0,0,,Мен дереу аяғыма күтім жасауым керек.
Dialogue: 0,0:19:16.78,0:19:20.65,Default,,0,0,0,,Жарайды. Ол бәрібір тағы бір сағатта жазылады.
Dialogue: 0,0:19:24.66,0:19:26.83,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:19:26.91,0:19:30.21,Default,,0,0,0,,Жоқ, жоқ, жоқ, бұл ұят. Бұл ұят.
Dialogue: 0,0:19:30.29,0:19:33.33,Default,,0,0,0,,Мен Риннің бетін дұрыс көре алмаймын. Не болды?
Dialogue: 0,0:19:33.42,0:19:35.63,Default,,0,0,0,,Е... Иә!
Dialogue: 0,0:19:35.71,0:19:38.17,Default,,0,0,0,,Аа... Кешіріңіз, мен жасадым.
Dialogue: 0,0:19:38.26,0:19:40.51,Default,,0,0,0,,Бұл «мен жасадым» емес!
Dialogue: 0,0:19:40.59,0:19:42.38,Default,,0,0,0,,Сәлеметсіз бе, өрт сөндіруші? Өрт сөндіру машинасы?
Dialogue: 0,0:19:42.47,0:19:43.18,Default,,0,0,0,,Фосфор!
Dialogue: 0,0:19:43.68,0:19:47.10,Default,,0,0,0,,Иә, бұл жерде отыра бермей, өзіңізді күштеп салмаңыз.
Dialogue: 0,0:19:48.39,0:19:49.35,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:19:49.93,0:19:52.35,Default,,0,0,0,,Бұндай жағдай бұрын да болған.
Dialogue: 0,0:19:53.98,0:19:54.61,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:55.36,0:19:57.86,Default,,0,0,0,,Фосфор Мен шештім
Dialogue: 0,0:19:58.48,0:20:00.40,Default,,0,0,0,,Барлығына көмектесіңіз!
Dialogue: 0,0:20:01.24,0:20:03.49,Default,,0,0,0,,Бұл триггер болды.
Dialogue: 0,0:20:05.03,0:20:09.16,Default,,0,0,0,,Не... не ойлап отырсың? ыңғайсыз
Dialogue: 0,0:20:09.24,0:20:12.21,Default,,0,0,0,,Әй... не?
Dialogue: 0,0:20:16.71,0:20:17.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:24.51,0:20:25.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:26.93,0:20:28.18,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:29.18,0:20:32.94,Default,,0,0,0,,Не болды? Есінен танып қалдың ба?
Dialogue: 0,0:20:33.60,0:20:34.81,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:20:36.36,0:20:38.90,Default,,0,0,0,,Бірақ бірдеңе болды
Dialogue: 0,0:20:39.65,0:20:42.28,Default,,0,0,0,,Күткендей бұл көздер мені қорғап тұр.
Dialogue: 0,0:20:42.95,0:20:43.86,Default,,0,0,0,,(мылтық құлаған дыбыс)
Dialogue: 0,0:21:03.63,0:21:07.93,Default,,0,0,0,,Әу бастан осылай жасалса жақсы болар еді.
Dialogue: 0,0:21:10.43,0:21:14.35,Default,,0,0,0,,Өзіңді көрсет! құбыжық!
Dialogue: 0,0:21:14.43,0:21:21.32,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:21:31.83,0:21:32.87,Default,,0,0,0,,Иә
Dialogue: 0,0:21:32.95,0:21:34.96,Default,,0,0,0,,♪～
Dialogue: 0,0:23:00.83,0:23:02.83,Default,,0,0,0,,～♪
Dialogue: 0,0:23:04.21,0:23:05.92,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:23:06.42,0:23:08.09,Default,,0,0,0,,Юкио!
Dialogue: 0,0:23:08.59,0:23:10.09,Default,,0,0,0,,Сіз де осындасыз
Dialogue: 0,0:23:10.93,0:23:15.18,Default,,0,0,0,,Шындығында, Киригакурэ-сенсэй кешеден бері жоғалып кетті.
Dialogue: 0,0:23:15.26,0:23:16.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:16.10,0:23:19.52,Default,,0,0,0,,Балалар, олардың қайда екенін білесіңдер ме?
Dialogue: 0,0:23:19.60,0:23:20.69,Default,,0,0,0,,Жоқ
Dialogue: 0,0:23:21.65,0:23:22.65,Default,,0,0,0,,Осыншама ма?
Dialogue: 0,0:23:22.73,0:23:24.65,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:23:24.73,0:23:26.15,Default,,0,0,0,,Менде бар
Dialogue: 0,0:23:26.23,0:23:27.65,Default,,0,0,0,,Сіз мені не үшін шақырдыңыз?
Dialogue: 0,0:23:27.73,0:23:28.99,Default,,0,0,0,,Фу…
Dialogue: 0,0:23:29.07,0:23:34.78,Default,,0,0,0,,Мен бәріңнің Киригакуре-сенсэйді іздеу үшін Аомориге баруларыңды қалаймын.
Dialogue: 0,0:23:36.28,0:23:42.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
