Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.12,0:00:03.46,Default,,0,0,0,,Найзағай!
Dialogue: 0,0:00:03.54,0:00:04.67,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:00:06.00,0:00:07.25,Default,,0,0,0,,Періште
Dialogue: 0,0:00:07.34,0:00:09.34,Default,,0,0,0,,Іс жүзінде тергеуде біршама ілгерілеушілік бар.
Dialogue: 0,0:00:09.42,0:00:09.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:10.01,0:00:11.13,Default,,0,0,0,,Не?
Dialogue: 0,0:00:11.21,0:00:13.13,Default,,0,0,0,,Көк түннің алдында Жапон тармағы
Dialogue: 0,0:00:13.22,0:00:15.97,Default,,0,0,0,,13-ші бөлім деп аталатын нысан болды.
Dialogue: 0,0:00:16.05,0:00:17.43,Default,,0,0,0,,Сіз бұл туралы ешқашан естімегенсіз бе?
Dialogue: 0,0:00:17.51,0:00:19.72,Default,,0,0,0,,13-бөлім...
Dialogue: 0,0:00:20.22,0:00:21.31,Default,,0,0,0,,Урарака ханым мен Кошио-куннің көмегі арқасында,
Dialogue: 0,0:00:21.39,0:00:22.31,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:00:22.39,0:00:23.98,Default,,0,0,0,,Шамасы, нысан
Dialogue: 0,0:00:24.06,0:00:27.52,Default,,0,0,0,,Иллюминати құрумен байланысты болуы мүмкін
Dialogue: 0,0:00:27.61,0:00:30.57,Default,,0,0,0,,Мен тағы біраз зерттеп, жазып беремін, күте тұрыңыз.
Dialogue: 0,0:00:30.65,0:00:33.19,Default,,0,0,0,,Жарайды, абай болыңыз.
Dialogue: 0,0:00:34.78,0:00:37.49,Default,,0,0,0,,Есіңде ештеңе жоқ па?
Dialogue: 0,0:00:38.28,0:00:41.20,Default,,0,0,0,,Бұл... бұл Ватиканның штаб-пәтері, солай ма?
Dialogue: 0,0:00:41.29,0:00:43.50,Default,,0,0,0,,Сіз Қасиетті Рыцарьды көруге келдіңіз бе?
Dialogue: 0,0:00:43.58,0:00:46.37,Default,,0,0,0,,Жоқ, мен сәл тынышталғым келеді.
Dialogue: 0,0:00:46.46,0:00:47.46,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:00:49.00,0:00:49.63,Default,,0,0,0,,Күн ыстық!
Dialogue: 0,0:00:50.42,0:00:52.21,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:00:52.30,0:00:55.55,Default,,0,0,0,,Бұл үш данышпанның бірі Азазелдің ғибадатханасы.
Dialogue: 0,0:00:55.63,0:00:58.64,Default,,0,0,0,,Иә? Бұл патша Азазель Григорий ме?
Dialogue: 0,0:00:59.22,0:01:00.97,Default,,0,0,0,,Лорд Ферес осылай деді.
Dialogue: 0,0:01:01.06,0:01:05.48,Default,,0,0,0,,Адамдар жағына шығып, жын-шайтандармен күресу үшін ақыл берген патша бар дейді.
Dialogue: 0,0:01:05.56,0:01:08.69,Default,,0,0,0,,Кешіріңіз, бірақ мен ешқашан Григорий Баал болады деп ойламадым.
Dialogue: 0,0:01:08.77,0:01:10.82,Default,,0,0,0,,Бастапқыда Бос әлемде Бағалдан басқа да адамдар болған.
Dialogue: 0,0:01:10.90,0:01:12.90,Default,,0,0,0,,Қос жұлдыз (Табан) деген император болған.
Dialogue: 0,0:01:13.49,0:01:15.49,Default,,0,0,0,,Жаратушы Шемихаза
Dialogue: 0,0:01:15.57,0:01:17.41,Default,,0,0,0,,Жарамсыз император Альмахер
Dialogue: 0,0:01:17.49,0:01:19.57,Default,,0,0,0,,Азазель Солемен резонанс жасады
Dialogue: 0,0:01:20.16,0:01:23.91,Default,,0,0,0,,Оларға инкарнациядан кейін шайтанмен қалай күресу керектігін үйрету
Dialogue: 0,0:01:24.00,0:01:27.67,Default,,0,0,0,,Адаммен қарым-қатынаста қалған ұрпақ: Алпауыттарға
Dialogue: 0,0:01:27.75,0:01:29.33,Default,,0,0,0,,Рыцарлар тобын құрды
Dialogue: 0,0:01:30.75,0:01:33.00,Default,,0,0,0,,Бұл Ки патшасы Азазель.
Dialogue: 0,0:01:34.05,0:01:38.38,Default,,0,0,0,,Адамдар жағына шыққан Азазель Шемихаза Альммахер
Dialogue: 0,0:01:38.47,0:01:42.72,Default,,0,0,0,,Алғашқы инкарнацияланған дене бұзылса да, біз басқа денені іздемейміз.
Dialogue: 0,0:01:42.81,0:01:46.39,Default,,0,0,0,,Мен табиғи жолмен ыдырап, ғаламға оралуды таңдадым.
Dialogue: 0,0:01:46.89,0:01:50.90,Default,,0,0,0,,Ішінде әлі де дененің тірі бөлігі бар.
Dialogue: 0,0:01:51.40,0:01:55.57,Default,,0,0,0,,Алғаш кездескенімізде әлі де аздап сөйлесетінбіз...
Dialogue: 0,0:01:55.65,0:01:59.70,Default,,0,0,0,,Жүз жыл бұрын дененің одан да көп бөліктері қалған болар еді.
Dialogue: 0,0:01:59.78,0:02:04.16,Default,,0,0,0,,13-бөлімнің жігіттері осы жерден ұяшықтарды жинайды.
Dialogue: 0,0:02:04.24,0:02:06.75,Default,,0,0,0,,Ол Азазельдің клонын жасаған болуы мүмкін.
Dialogue: 0,0:02:07.25,0:02:09.87,Default,,0,0,0,,«Азазель» кооперативі болды ма?
Dialogue: 0,0:02:10.54,0:02:14.05,Default,,0,0,0,,Қалай болғанда да, мен қозғала алмаймын, сондықтан маңызды емес.
Dialogue: 0,0:02:15.92,0:02:17.17,Default,,0,0,0,,Найзағай?
Dialogue: 0,0:02:17.26,0:02:18.80,Default,,0,0,0,,Мен өзімді аздап жалғыз сезінемін.
Dialogue: 0,0:02:18.88,0:02:21.39,Default,,0,0,0,,Қаласаңыз, үйге бара аласыз.
Dialogue: 0,0:02:21.47,0:02:23.89,Default,,0,0,0,,-(Сугуро) Жоқ, күтемін. -Иә.
Dialogue: 0,0:02:24.97,0:02:27.64,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:02:31.98,0:02:33.77,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:02:42.24,0:02:43.37,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:02:44.78,0:02:47.12,Default,,0,0,0,,Менің дауысымды әлі ести аласыз ба?
Dialogue: 0,0:02:52.71,0:02:53.38,Default,,0,0,0,,Эй
Dialogue: 0,0:02:54.38,0:02:56.84,Default,,0,0,0,,Ата адам жағында, солай ма?
Dialogue: 0,0:02:59.72,0:03:01.72,Default,,0,0,0,,♪～
Dialogue: 0,0:04:26.51,0:04:28.51,Default,,0,0,0,,～♪
Dialogue: 0,0:05:11.89,0:05:12.68,Default,,0,0,0,,Ni~
Dialogue: 0,0:05:29.28,0:05:29.95,Default,,0,0,0,,Э-э, не істеп жатырсыз, мырза?
Dialogue: 0,0:05:41.50,0:05:43.59,Default,,0,0,0,,Қысқы демалыста барлығы не істейді?
Dialogue: 0,0:05:43.67,0:05:45.67,Default,,0,0,0,,Мен ата-анамның үйіне қайтып бармаймын.
Dialogue: 0,0:05:45.76,0:05:47.55,Default,,0,0,0,,Мен де бос емеспін.
Dialogue: 0,0:05:47.63,0:05:49.64,Default,,0,0,0,,Онда мен де қалатын шығармын.
Dialogue: 0,0:05:49.72,0:05:52.72,Default,,0,0,0,,Егер бәрі қалатын болса, неге сертификаттау емтиханы үшін оқу сессиясын өткізбеске?
Dialogue: 0,0:05:52.81,0:05:54.52,Default,,0,0,0,,- (Китонемару) Иә. - (Шима) А?
Dialogue: 0,0:05:54.60,0:05:57.23,Default,,0,0,0,,Біз бәрібір жиналатын болсақ, неге Рождество кешін өткізбеске?
Dialogue: 0,0:05:57.31,0:06:00.48,Default,,0,0,0,,Рождество туралы айтатын болсақ, бұл менің және Юкионың туған күні.
Dialogue: 0,0:06:00.56,0:06:03.69,Default,,0,0,0,,Окумура-кун, сен Рождествода тудың ба?
Dialogue: 0,0:06:03.78,0:06:07.49,Default,,0,0,0,,Жоқ, бұл 27-сі, бірақ олар көбінесе бірге тойланды.
Dialogue: 0,0:06:07.57,0:06:10.28,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,0:06:10.37,0:06:13.12,Default,,0,0,0,,Мен үшін бұл жыл мен оны түсінгенше өтті.
Dialogue: 0,0:06:13.20,0:06:14.24,Default,,0,0,0,,Ешкім тойламайды
Dialogue: 0,0:06:14.33,0:06:16.50,Default,,0,0,0,,Бұл мен үшін тым көп.
Dialogue: 0,0:06:16.58,0:06:18.46,Default,,0,0,0,,- (Изумо) Мен де Шиманеде болғанда... -Туған күн
Dialogue: 0,0:06:18.96,0:06:20.12,Default,,0,0,0,,Сосын барлығы
Dialogue: 0,0:06:20.21,0:06:22.75,Default,,0,0,0,,Рождестволық бірлескен туған күн кеші Яруя
Dialogue: 0,0:06:22.84,0:06:24.13,Default,,0,0,0,,Шиеми-сан
Dialogue: 0,0:06:24.71,0:06:25.88,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:25.96,0:06:28.63,Default,,0,0,0,,Сіз экзорцист сертификаттау емтиханын өткізбейтініңіз рас па?
Dialogue: 0,0:06:28.72,0:06:29.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:29.55,0:06:33.47,Default,,0,0,0,,Мен бүгін таңертең біреу емтиханнан шығу үшін бланк тапсырғанын естідім.
Dialogue: 0,0:06:34.01,0:06:34.93,Default,,0,0,0,,Иә
Dialogue: 0,0:06:35.01,0:06:36.93,Default,,0,0,0,,Мен жын шығарушы болуды қойдым.
Dialogue: 0,0:06:37.52,0:06:39.44,Default,,0,0,0,,Мен жын шығару дүкенін өз қолыма алғым келді.
Dialogue: 0,0:06:39.52,0:06:40.06,Default,,0,0,0,,Е...
Dialogue: 0,0:06:40.14,0:06:41.19,Default,,0,0,0,,Сол себепті мектепті қысып тастаңыз
Dialogue: 0,0:06:41.27,0:06:43.73,Default,,0,0,0,,Сертификаттау емтиханының уақыты келгенде жұмыстан шығуды жоспарлап отырмын.
Dialogue: 0,0:06:43.82,0:06:45.32,Default,,0,0,0,,Өйткені сіз өткен күні...
Dialogue: 0,0:06:45.40,0:06:47.03,Default,,0,0,0,,Қалжыңдамаңыз!
Dialogue: 0,0:06:47.11,0:06:49.11,Default,,0,0,0,,Анаң бәрібір қарсы болды, солай ма?
Dialogue: 0,0:06:49.20,0:06:51.86,Default,,0,0,0,,Бүгін сабақтан кейін мен сені көндіремін...
Dialogue: 0,0:06:53.57,0:06:55.70,Default,,0,0,0,,Рахмет саған Камики-сан
Dialogue: 0,0:06:55.79,0:06:56.37,Default,,0,0,0,,Е...
Dialogue: 0,0:06:57.50,0:06:59.12,Default,,0,0,0,,Бірақ мен шештім
Dialogue: 0,0:06:59.83,0:07:01.79,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:07:02.29,0:07:04.71,Default,,0,0,0,,Рин, уәдеңізді бұзғаным үшін кешіріңіз.
Dialogue: 0,0:07:04.79,0:07:06.96,Default,,0,0,0,,Жоқ... олай емес.
Dialogue: 0,0:07:07.59,0:07:09.05,Default,,0,0,0,,Мен мектепті тастаймын, бірақ
Dialogue: 0,0:07:09.13,0:07:12.22,Default,,0,0,0,,Мен әдеттегідей мектепке барамын, сондықтан маған қамқорлық жасаңыз.
Dialogue: 0,0:07:12.30,0:07:14.22,Default,,0,0,0,,Әрине, бірақ...
Dialogue: 0,0:07:14.30,0:07:15.76,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:07:15.85,0:07:19.27,Default,,0,0,0,,Сонымен... одан да Шима-кунның ұсынысымен келісемін.
Dialogue: 0,0:07:19.35,0:07:19.89,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:07:19.98,0:07:23.27,Default,,0,0,0,,Қысқы демалыс басталғанда бәріміз туған күн кешін өткіземіз бе?
Dialogue: 0,0:07:23.35,0:07:25.61,Default,,0,0,0,,Рождество мен туған күнді бірге тойлау
Dialogue: 0,0:07:25.69,0:07:27.11,Default,,0,0,0,,Бұл қызық болатыны сөзсіз
Dialogue: 0,0:07:27.19,0:07:28.86,Default,,0,0,0,,Ах... анау Шиеми-сан
Dialogue: 0,0:07:28.94,0:07:31.74,Default,,0,0,0,,Юки-чан да қатысады! Мүлдем
Dialogue: 0,0:07:31.82,0:07:33.24,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:07:33.32,0:07:35.53,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,0:07:37.54,0:07:39.62,Default,,0,0,0,,Ол жігітке не болды?
Dialogue: 0,0:07:39.70,0:07:42.75,Default,,0,0,0,,Юкиоға қарсы мықты шыққан Шиемиді бірінші рет көріп тұрмын.
Dialogue: 0,0:07:42.83,0:07:44.00,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:44.08,0:07:46.63,Default,,0,0,0,,Бірақ сіз көңілсіз сияқтысыз.
Dialogue: 0,0:07:46.71,0:07:48.46,Default,,0,0,0,,Мүмкін бұл жақсы өзгеріс шығар
Dialogue: 0,0:07:49.84,0:07:53.68,Default,,0,0,0,,Эй, мен бұл туралы ойладым.
Dialogue: 0,0:07:54.43,0:07:56.30,Default,,0,0,0,,Жоқ, ол жігіт...
Dialogue: 0,0:07:56.39,0:07:58.01,Default,,0,0,0,,Өлмейсің бе?
Dialogue: 0,0:08:00.06,0:08:01.18,Default,,0,0,0,,Бірдеңе айт
Dialogue: 0,0:08:01.27,0:08:02.89,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:08:02.98,0:08:04.40,Default,,0,0,0,,Не, Изумо да?
Dialogue: 0,0:08:04.48,0:08:06.94,Default,,0,0,0,,- (Сугуро) Әй, мен де бір қарадым... - (Кономару) Балаға да?
Dialogue: 0,0:08:07.02,0:08:09.44,Default,,0,0,0,,Жоқ, басымды әрең жайдым.
Dialogue: 0,0:08:10.03,0:08:11.19,Default,,0,0,0,,Мен өте байсалдымын.
Dialogue: 0,0:08:11.90,0:08:14.07,Default,,0,0,0,,Себебі мен эксорцист болуға ерекше көңіл бөлдім.
Dialogue: 0,0:08:14.16,0:08:15.91,Default,,0,0,0,,Мен қарсылықтан уайымдадым.
Dialogue: 0,0:08:15.99,0:08:18.58,Default,,0,0,0,,Мен бір шешімге келгенімді және енді иілмейтінімді сезіндім.
Dialogue: 0,0:08:18.66,0:08:22.29,Default,,0,0,0,,Бір күннің ішінде не болуы мүмкін еді?
Dialogue: 0,0:08:22.37,0:08:24.71,Default,,0,0,0,,Барлығыңыз, сәл тынышталыңыздар.
Dialogue: 0,0:08:24.79,0:08:27.34,Default,,0,0,0,,Шынайы түрде ойласаңыз да, мүмкін емес.
Dialogue: 0,0:08:27.42,0:08:30.59,Default,,0,0,0,,Морияма мырзаның медициналық тексеруі өте жақсы.
Dialogue: 0,0:08:30.67,0:08:33.34,Default,,0,0,0,,Бірінші Неге өлесің?
Dialogue: 0,0:08:33.42,0:08:35.09,Default,,0,0,0,,Сонымен... дұрыс.
Dialogue: 0,0:08:35.18,0:08:37.35,Default,,0,0,0,,Барлығы~ Осылай!
Dialogue: 0,0:08:38.05,0:08:41.39,Default,,0,0,0,,Иә! Шиемиден жеке сұрау тезірек болар еді.
Dialogue: 0,0:08:42.06,0:08:44.52,Default,,0,0,0,,Сіз ақымақ емессіз. Бұл сөзсіз құпия.
Dialogue: 0,0:08:44.60,0:08:45.98,Default,,0,0,0,,Бұл адамның өзі туралы емес.
Dialogue: 0,0:08:47.31,0:08:49.69,Default,,0,0,0,,Шима-кун мен Саку-чаннан сізге көмектесуін сұраңыз.
Dialogue: 0,0:08:49.77,0:08:51.48,Default,,0,0,0,,Мен дүкен аралап, топты бөлуді шештім.
Dialogue: 0,0:08:51.57,0:08:53.69,Default,,0,0,0,,Мерекелік топ Рин мен Мивакун.
Dialogue: 0,0:08:53.78,0:08:54.49,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:08:54.57,0:08:56.86,Default,,0,0,0,,Безендіру тобы - Сугуро-кун мен Юки-чан.
Dialogue: 0,0:08:56.95,0:08:58.74,Default,,0,0,0,,Торт командасы - Камики-сан мен Шима-кун.
Dialogue: 0,0:08:58.82,0:09:00.03,Default,,0,0,0,,- (Изумо) Иә? Бұл жігітпен бе? -(Шима) Эххехе
Dialogue: 0,0:09:00.12,0:09:01.83,Default,,0,0,0,,Мен ағаш командасының мүшесімін.
Dialogue: 0,0:09:01.91,0:09:03.66,Default,,0,0,0,,Мен де саған аздап көмектесемін.
Dialogue: 0,0:09:03.75,0:09:06.21,Default,,0,0,0,,Бір минут күтіңіз, Пак мырза, бізге қосылғыңыз келе ме?
Dialogue: 0,0:09:06.29,0:09:09.09,Default,,0,0,0,,Иә, бүгін мен ертең кездесуім бар.
Dialogue: 0,0:09:09.17,0:09:10.09,Default,,0,0,0,,- (Шима) А? -Ах
Dialogue: 0,0:09:10.17,0:09:12.84,Default,,0,0,0,,Сондай-ақ, менің уақытым жоқ, сондықтан бұл біраз жұмыс.
Dialogue: 0,0:09:12.92,0:09:14.84,Default,,0,0,0,,Мен мерекелік бетбелгі жасадым
Dialogue: 0,0:09:14.92,0:09:17.43,Default,,0,0,0,,Сенің бұлай толқығаныңа не болды?
Dialogue: 0,0:09:17.51,0:09:18.18,Default,,0,0,0,,Мен оның өледі деп ойламаппын...
Dialogue: 0,0:09:18.26,0:09:19.80,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:19.89,0:09:21.35,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:09:21.97,0:09:23.89,Default,,0,0,0,,Бұл өте танымал.
Dialogue: 0,0:09:23.98,0:09:25.69,Default,,0,0,0,,Менің бұл жерде тортты жеуге мүмкіндігім болмады.
Dialogue: 0,0:09:25.77,0:09:26.89,Default,,0,0,0,,Өйткені бұл сирек
Dialogue: 0,0:09:26.98,0:09:28.35,Default,,0,0,0,,Үйге барғың келсе, үйге неге бармайсың?
Dialogue: 0,0:09:28.44,0:09:30.06,Default,,0,0,0,,Мен үйге бармаймын
Dialogue: 0,0:09:30.15,0:09:32.90,Default,,0,0,0,,Бұл менің Изумо-чанмен кездесуге мүмкіндігім.
Dialogue: 0,0:09:32.98,0:09:36.36,Default,,0,0,0,,Ха, сонда сен мені әлі де бақылап отыруың керек пе?
Dialogue: 0,0:09:36.45,0:09:39.37,Default,,0,0,0,,Шпионға әлі де ашулысың ғой.
Dialogue: 0,0:09:39.45,0:09:42.87,Default,,0,0,0,,Әрине, мен басқа жігіттердің жұмсақ болғанына қуаныштымын.
Dialogue: 0,0:09:42.95,0:09:45.00,Default,,0,0,0,,Хаха... Мен шынымен солай деп үміттенемін.
Dialogue: 0,0:09:45.08,0:09:47.50,Default,,0,0,0,,Білсем бәрі бітеді деп ойладым.
Dialogue: 0,0:09:47.58,0:09:49.83,Default,,0,0,0,,Шынымды айтсам, мен жынды болып бара жатырмын.
Dialogue: 0,0:09:50.33,0:09:52.17,Default,,0,0,0,,Ендеше, енді біз сол орта мектепті тексереміз және—
Dialogue: 0,0:09:52.25,0:09:55.09,Default,,0,0,0,,Мен де бұлай болады деп ойламаппын.
Dialogue: 0,0:09:55.17,0:09:58.43,Default,,0,0,0,,Торт алу үшін кезек күтіп, Шиеми Морияма туралы уайымдады
Dialogue: 0,0:09:58.51,0:09:59.51,Default,,0,0,0,,Хаха
Dialogue: 0,0:09:59.59,0:10:02.76,Default,,0,0,0,,Бірақ Изумо-чан маған ұқсамайды.
Dialogue: 0,0:10:04.81,0:10:08.39,Default,,0,0,0,,Жоқ, сен бәрібір мен сияқтысың.
Dialogue: 0,0:10:08.48,0:10:09.10,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:10:09.19,0:10:11.73,Default,,0,0,0,,Маған ұнаса да, олар
Dialogue: 0,0:10:13.82,0:10:15.94,Default,,0,0,0,,Сонда да, сен ақымақ
Dialogue: 0,0:10:16.03,0:10:18.15,Default,,0,0,0,,Алда көптеген қиын істер күтіп тұр.
Dialogue: 0,0:10:18.24,0:10:19.74,Default,,0,0,0,,Тек сақ болыңыз.
Dialogue: 0,0:10:19.82,0:10:22.37,Default,,0,0,0,,Мұны қайталау
Dialogue: 0,0:10:22.45,0:10:24.62,Default,,0,0,0,,Сіз маған төтенше жағдайда көмектесесіз, солай ма?
Dialogue: 0,0:10:24.70,0:10:27.33,Default,,0,0,0,,Мен өте тәтті жігіттердің қандай екенін білмеймін.
Dialogue: 0,0:10:27.41,0:10:30.75,Default,,0,0,0,,Келесі жолы сен менің жауым болсаң, мен сені ешқашан кешірмеймін.
Dialogue: 0,0:10:30.83,0:10:32.71,Default,,0,0,0,,Пир~ Өте қорқынышты!
Dialogue: 0,0:10:32.79,0:10:37.76,Default,,0,0,0,,Осындай беймаза адамға мейірімді бол~
Dialogue: 0,0:10:39.34,0:10:41.51,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:10:41.59,0:10:43.35,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:10:44.89,0:10:45.85,Default,,0,0,0,,Арзан
Dialogue: 0,0:10:45.93,0:10:46.97,Default,,0,0,0,,Маған бұл ұнайды
Dialogue: 0,0:10:47.06,0:10:48.60,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:10:48.68,0:10:49.77,Default,,0,0,0,,Бірінші адамның атын жазғаныңыздан бері қанша секунд өтті?
Dialogue: 0,0:10:49.85,0:10:53.06,Default,,0,0,0,,Егер сіз бос емес сияқты болсаңыз, мен келемін.
Dialogue: 0,0:10:53.15,0:10:54.44,Default,,0,0,0,,Әлі де жараланған
Dialogue: 0,0:10:54.52,0:10:56.61,Default,,0,0,0,,Жоқ, мен қолымды пайдалана аламын.
Dialogue: 0,0:10:56.69,0:11:00.36,Default,,0,0,0,,Соған қарағанда, Сугуро-кун соңғы кездері бос емес сияқты, солай емес пе?
Dialogue: 0,0:11:00.86,0:11:03.78,Default,,0,0,0,,Мен Найзағай мені айналып бара жатыр деп естідім.
Dialogue: 0,0:11:04.28,0:11:05.16,Default,,0,0,0,,Бұл қиын болады
Dialogue: 0,0:11:05.74,0:11:09.75,Default,,0,0,0,,Жоқ... жоқ, ол мені ұнатады, артымнан ереді.
Dialogue: 0,0:11:14.21,0:11:17.76,Default,,0,0,0,,(Найзағайдың тынысы)
Dialogue: 0,0:11:22.51,0:11:23.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:24.26,0:11:25.68,Default,,0,0,0,,«Широ»?
Dialogue: 0,0:11:27.52,0:11:28.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:28.72,0:11:30.35,Default,,0,0,0,,Широ Фуджимото?
Dialogue: 0,0:11:30.43,0:11:32.90,Default,,0,0,0,,Мен де күткендей бұрынғы Паладиннің бетін танимын.
Dialogue: 0,0:11:33.52,0:11:34.94,Default,,0,0,0,,Жас, бірақ сөзсіз
Dialogue: 0,0:11:35.44,0:11:38.23,Default,,0,0,0,,Широ Фуджимото Азазельдің клоны ма?
Dialogue: 0,0:11:38.73,0:11:41.28,Default,,0,0,0,,Не... не болады?
Dialogue: 0,0:11:41.36,0:11:42.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:43.99,0:11:46.91,Default,,0,0,0,,Бет Широдан Широға секіреді.
Dialogue: 0,0:11:58.25,0:12:01.42,Default,,0,0,0,,Тек Джироның эксперимент жазбалары еш жерде жоқ.
Dialogue: 0,0:12:01.51,0:12:05.09,Default,,0,0,0,,Басқа клондардың жазбаларында бос орындар жоқ.
Dialogue: 0,0:12:05.18,0:12:06.47,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:12:06.55,0:12:08.18,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,0:12:08.26,0:12:10.93,Default,,0,0,0,,Мүмкін бұл Джиро шайтан шығар!
Dialogue: 0,0:12:11.02,0:12:13.44,Default,,0,0,0,,Өкінішке орай, барлық материалдар алынып тасталды.
Dialogue: 0,0:12:14.10,0:12:15.44,Default,,0,0,0,,Я~
Dialogue: 0,0:12:16.02,0:12:19.02,Default,,0,0,0,,Шайтан - Азазельдің клоны
Dialogue: 0,0:12:19.11,0:12:20.07,Default,,0,0,0,,Басқаша айтқанда, Окумура т.б.
Dialogue: 0,0:12:20.15,0:12:23.36,Default,,0,0,0,,Өйткені мен Азазельдің нефилімінің қанын мұра еттім.
Dialogue: 0,0:12:23.45,0:12:25.95,Default,,0,0,0,,Сонымен қатар, материалдық әлем (Usher) және Gehenna...
Dialogue: 0,0:12:26.03,0:12:27.83,Default,,0,0,0,,Бұл дүние...
Dialogue: 0,0:12:28.33,0:12:30.04,Default,,0,0,0,,-Рюуши- (Кацуро) Ах...
Dialogue: 0,0:12:30.12,0:12:31.95,Default,,0,0,0,,- Сәл демалу керек - (Сугуро) А?
Dialogue: 0,0:12:32.04,0:12:34.54,Default,,0,0,0,,Қалғанын маған қалдырыңыз.
Dialogue: 0,0:12:35.04,0:12:36.83,Default,,0,0,0,,- (Сугуро) Күте тұрыңыз! -Уау
Dialogue: 0,0:12:37.54,0:12:38.96,Default,,0,0,0,,Сіз қайтып келгеннен бері
Dialogue: 0,0:12:39.04,0:12:40.96,Default,,0,0,0,,Тек ұйықта, тамақ же, ұйықта және ұйықта.
Dialogue: 0,0:12:41.05,0:12:42.17,Default,,0,0,0,,Кішкене болжап көрейік!
Dialogue: 0,0:12:42.26,0:12:43.97,Default,,0,0,0,,Менің ойым тығырыққа тірелгенде
Dialogue: 0,0:12:44.05,0:12:45.84,Default,,0,0,0,,Мен ұйықтайын деп жатырмын.
Dialogue: 0,0:12:45.93,0:12:47.76,Default,,0,0,0,,Сондықтан мен әзірше ұйықтап жатырмын.
Dialogue: 0,0:12:48.72,0:12:52.81,Default,,0,0,0,,Ал, мен ертең өз мектебімдегі балалармен жаңа жылдық кеш өткіземін.
Dialogue: 0,0:12:52.89,0:12:54.14,Default,,0,0,0,,Барсам болады ма?
Dialogue: 0,0:12:54.23,0:12:56.10,Default,,0,0,0,,Жақсы, кеттік.
Dialogue: 0,0:12:57.02,0:13:00.27,Default,,0,0,0,,Мен саған бұйрық берсем де білесің
Dialogue: 0,0:13:00.36,0:13:02.32,Default,,0,0,0,,Міндетті түрде мойынсұнғыш емес
Dialogue: 0,0:13:02.40,0:13:03.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:03.28,0:13:05.65,Default,,0,0,0,,Бұл абайсыздық маңызды екенін білдіреді.
Dialogue: 0,0:13:05.74,0:13:09.28,Default,,0,0,0,,Егер мен осындай нәрсеге бетпе-бет келсем, мен жынды болар едім.
Dialogue: 0,0:13:11.70,0:13:12.75,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:14.12,0:13:16.08,Default,,0,0,0,,Олай болса, мен үзіліс жасайын.
Dialogue: 0,0:13:16.58,0:13:18.08,Default,,0,0,0,,Қайырлы түн~
Dialogue: 0,0:13:21.09,0:13:22.51,Default,,0,0,0,,Ағаш дайын!
Dialogue: 0,0:13:23.09,0:13:24.34,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:24.42,0:13:26.22,Default,,0,0,0,,Дұрыс, Ни Чан.
Dialogue: 0,0:13:26.30,0:13:28.26,Default,,0,0,0,,-(Изумо) Бұл шынайы емес -(Ни-чан) Ни~
Dialogue: 0,0:13:28.84,0:13:30.26,Default,,0,0,0,,Сугуро-кун, сен жақсысың.
Dialogue: 0,0:13:30.35,0:13:34.43,Default,,0,0,0,,Бала кезімізде осындай заттарды көп жасайтынбыз.
Dialogue: 0,0:13:34.93,0:13:36.02,Default,,0,0,0,,Сондай ностальгиялық
Dialogue: 0,0:13:37.19,0:13:41.19,Default,,0,0,0,,Мен де, ағам да нашар, сондықтан біз таңғажайып нәрсеге тап болдық.
Dialogue: 0,0:13:41.27,0:13:43.03,Default,,0,0,0,,Әкем оны алаңдатпай безендіреді.
Dialogue: 0,0:13:43.82,0:13:45.53,Default,,0,0,0,,«Сападан гөрі сан» сияқты сөздерді айту
Dialogue: 0,0:13:46.49,0:13:49.41,Default,,0,0,0,,Сондықтан мен мүлде жақсарған жоқпын.
Dialogue: 0,0:13:52.54,0:13:54.29,Default,,0,0,0,,- (Юкио) Не ​​болды? -(Кацуро) Аа...
Dialogue: 0,0:13:54.37,0:13:57.21,Default,,0,0,0,,Жоқ... Жоқ, бұл әңгіме деп ойладым.
Dialogue: 0,0:13:57.79,0:14:00.42,Default,,0,0,0,,Бұл әшекейлер ағашқа бекітіледі.
Dialogue: 0,0:14:01.88,0:14:03.05,Default,,0,0,0,,Әке.
Dialogue: 0,0:14:03.55,0:14:04.21,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,0:14:04.80,0:14:07.47,Default,,0,0,0,,Біздің нағыз ата-анамыз қайда?
Dialogue: 0,0:14:08.80,0:14:12.97,Default,,0,0,0,,Түсіндім... бұл күн де ​​келді.
Dialogue: 0,0:14:14.64,0:14:16.31,Default,,0,0,0,,Ммм
Dialogue: 0,0:14:16.81,0:14:21.81,Default,,0,0,0,,Мен сені 27 желтоқсанның салқын таңында көпірдің астынан алып кеттім.
Dialogue: 0,0:14:22.31,0:14:24.28,Default,,0,0,0,,Сондықтан мен өз ата-анамды білмеймін.
Dialogue: 0,0:14:25.65,0:14:29.78,Default,,0,0,0,,Ал, мен оны алғандықтан, алаңдайтын ештеңе жоқ.
Dialogue: 0,0:14:29.86,0:14:31.53,Default,,0,0,0,,Тамақ ішкеннен кейін тісіңізді тазалап, ұйықтаңыз.
Dialogue: 0,0:14:31.62,0:14:32.62,Default,,0,0,0,,Ммм
Dialogue: 0,0:14:33.20,0:14:33.99,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:14:34.08,0:14:35.04,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:14:35.54,0:14:38.96,Default,,0,0,0,,Әкем анық біледі, сен оны неге жасырасың?
Dialogue: 0,0:14:39.46,0:14:41.00,Default,,0,0,0,,Әкең білмеймін десе
Dialogue: 0,0:14:41.08,0:14:42.50,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:14:42.59,0:14:43.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:43.42,0:14:45.42,Default,,0,0,0,,Маған білудің қажеті жоқ
Dialogue: 0,0:14:46.71,0:14:48.05,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:48.55,0:14:51.51,Default,,0,0,0,,Менің ағам білгісі келмейді.
Dialogue: 0,0:14:55.01,0:14:56.14,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:14:57.56,0:14:58.81,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:15:07.15,0:15:08.49,Default,,0,0,0,,(Ни Чанның ұйықтап жатқан тынысы)
Dialogue: 0,0:15:08.57,0:15:10.74,Default,,0,0,0,,Мен біріншімін
Dialogue: 0,0:15:11.86,0:15:13.57,Default,,0,0,0,,Рахмет сізге Ни Чан
Dialogue: 0,0:15:14.07,0:15:15.91,Default,,0,0,0,,Мен қазір саған су беремін.
Dialogue: 0,0:15:16.54,0:15:18.12,Default,,0,0,0,,Ni…
Dialogue: 0,0:15:18.20,0:15:19.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:23.75,0:15:26.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:26.13,0:15:27.46,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:28.63,0:15:30.22,Default,,0,0,0,,- (Юкио)... Уау! -(Рин) О, Құдайым!
Dialogue: 0,0:15:31.30,0:15:32.30,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:15:32.38,0:15:33.39,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:15:36.22,0:15:36.85,Default,,0,0,0,,- (Юкио) Уау! -(Рин) Шиеми!
Dialogue: 0,0:15:36.93,0:15:38.22,Default,,0,0,0,,- (Китонемару) Не болды? -(Сугуро) Өрт пе?
Dialogue: 0,0:15:39.31,0:15:40.98,Default,,0,0,0,,-(Рин) Уау, уау, уау... -(Изумо) Торт ше?
Dialogue: 0,0:15:41.06,0:15:42.60,Default,,0,0,0,,Жақсы
Dialogue: 0,0:15:42.69,0:15:43.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:47.27,0:15:49.15,Default,,0,0,0,,Әй, Изумо-чан!
Dialogue: 0,0:15:53.78,0:15:58.33,Default,,0,0,0,,Ни Чан - бұл... тірі зат.
Dialogue: 0,0:15:59.29,0:16:01.83,Default,,0,0,0,,Лақтыру, бұрылу табиғи нәрсе...
Dialogue: 0,0:16:01.91,0:16:02.92,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:16:03.00,0:16:04.71,Default,,0,0,0,,Не-чан... Ах.
Dialogue: 0,0:16:04.79,0:16:07.96,Default,,0,0,0,,Мен сиқыр жасаймын.
Dialogue: 0,0:16:08.63,0:16:12.97,Default,,0,0,0,,Сене алар емеспін... әп-сәтте бәрі ғайып болды.
Dialogue: 0,0:16:13.84,0:16:15.97,Default,,0,0,0,,Неліктен? Неге...
Dialogue: 0,0:16:16.05,0:16:17.26,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:16:17.35,0:16:19.64,Default,,0,0,0,,Шынымен, ер адамдар...
Dialogue: 0,0:16:19.72,0:16:20.98,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:16:22.10,0:16:22.94,Default,,0,0,0,,Иә
Dialogue: 0,0:16:23.44,0:16:25.48,Default,,0,0,0,,Қолымнан келмейді, аман қалдым...
Dialogue: 0,0:16:25.56,0:16:27.48,Default,,0,0,0,,Бұл ыстық кеш.
Dialogue: 0,0:16:28.07,0:16:31.61,Default,,0,0,0,,Бізді Рождество мерекесімен құттықтаймыз!
Dialogue: 0,0:16:31.69,0:16:32.99,Default,,0,0,0,,Бұл тым көп емес пе?
Dialogue: 0,0:16:34.32,0:16:35.99,Default,,0,0,0,,- (Китамару) Уау... - (Рин) Хэхехехе
Dialogue: 0,0:16:51.38,0:16:52.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:52.09,0:16:53.51,Default,,0,0,0,,Ой…
Dialogue: 0,0:16:53.59,0:16:57.34,Default,,0,0,0,,Негізі менде Виперден бала болды.
Dialogue: 0,0:16:57.43,0:16:59.39,Default,,0,0,0,,Шынымен бе? Құттықтаймыз!
Dialogue: 0,0:16:59.47,0:17:01.22,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:17:01.31,0:17:02.47,Default,,0,0,0,,Барлығы~
Dialogue: 0,0:17:02.56,0:17:05.23,Default,,0,0,0,,-Саку-чан - (Шима) Бұл кім?
Dialogue: 0,0:17:06.69,0:17:09.15,Default,,0,0,0,,-(Рин) Жақында кездескенше~ -(Китонемару) Қайырлы түн
Dialogue: 0,0:17:09.23,0:17:10.57,Default,,0,0,0,,Өкінішке орай, мұнда көп нәрсе жоқ.
Dialogue: 0,0:17:10.65,0:17:13.03,Default,,0,0,0,,Менің барлығына сыйлығым бар.
Dialogue: 0,0:17:13.11,0:17:15.07,Default,,0,0,0,,Мен оны кеше таңдадым, сондықтан ол әлі шикі.
Dialogue: 0,0:17:15.99,0:17:18.32,Default,,0,0,0,,Төрт жапырақты беде тұмары
Dialogue: 0,0:17:18.41,0:17:20.83,Default,,0,0,0,,Болашақта пайдалы болатынына сенімдімін.
Dialogue: 0,0:17:20.91,0:17:23.08,Default,,0,0,0,,Емтиханға сәттілік, барлығына.
Dialogue: 0,0:17:24.00,0:17:25.58,Default,,0,0,0,,- (Фосфор) Бұл не... - А?
Dialogue: 0,0:17:25.66,0:17:27.62,Default,,0,0,0,,Бұл өмірмен қоштасу ма?
Dialogue: 0,0:17:27.71,0:17:28.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:28.75,0:17:31.67,Default,,0,0,0,,Мен жын шығарушы атанғанымда осымен ғана айналыстым.
Dialogue: 0,0:17:31.75,0:17:33.55,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:17:33.63,0:17:36.72,Default,,0,0,0,,Тш... Мен өлмеймін!
Dialogue: 0,0:17:36.80,0:17:38.97,Default,,0,0,0,,Кешіріңіз, себебін айта алмаймын.
Dialogue: 0,0:17:39.05,0:17:41.89,Default,,0,0,0,,Бірақ мен өлмеймін, жоғалмаймын
Dialogue: 0,0:17:42.39,0:17:44.14,Default,,0,0,0,,Мен дәл осындамын.
Dialogue: 0,0:17:44.85,0:17:49.56,Default,,0,0,0,,Мен сенің жаныңда күресе алмасам да, Мен сені Жыншыдан қолдаймын.
Dialogue: 0,0:17:52.19,0:17:54.32,Default,,0,0,0,,Шиеми, маған қатты қызық.
Dialogue: 0,0:17:54.40,0:17:56.03,Default,,0,0,0,,Бірақ қызық болды
Dialogue: 0,0:17:56.53,0:17:57.61,Default,,0,0,0,,Біз 28 шілдедегі түскі 12-ге сәл қалған сәтке бет алып келеміз
Dialogue: 0,0:17:58.11,0:18:00.70,Default,,0,0,0,,Ондай нәрсені анда-санда жасау жақсы.
Dialogue: 0,0:18:01.20,0:18:02.70,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:18:03.20,0:18:04.24,Default,,0,0,0,,Уау
Dialogue: 0,0:18:04.33,0:18:07.75,Default,,0,0,0,,Мен көп ішкеніме біраз болды, сондықтан суды аз ішпедім~
Dialogue: 0,0:18:08.42,0:18:09.25,Default,,0,0,0,,Аа...
Dialogue: 0,0:18:09.33,0:18:12.21,Default,,0,0,0,,Балалар сендер 16 жастасыңдар ма?
Dialogue: 0,0:18:12.29,0:18:14.96,Default,,0,0,0,,Сен осылай киінгендіктен, Шура-чан Аяз атадан екен.
Dialogue: 0,0:18:15.05,0:18:17.76,Default,,0,0,0,,Балалар мен сендерге сыйлық ретінде бірдеңе беруім керек~
Dialogue: 0,0:18:17.84,0:18:18.88,Default,,0,0,0,,Не!
Dialogue: 0,0:18:18.97,0:18:21.47,Default,,0,0,0,,Жоқ, ол эротикалық жігіт емес.
Dialogue: 0,0:18:23.89,0:18:27.68,Default,,0,0,0,,Мен сенің анаңмен таныстым.
Dialogue: 0,0:18:28.39,0:18:29.69,Default,,0,0,0,,Тек бір рет
Dialogue: 0,0:18:30.77,0:18:32.44,Default,,0,0,0,,Бұл Юрий Егин болды ма?
Dialogue: 0,0:18:34.69,0:18:36.24,Default,,0,0,0,,- (Юкио) Бұл рас па! -Аа...
Dialogue: 0,0:18:36.32,0:18:39.24,Default,,0,0,0,,Жоқ, бұл соншалықты үлкен мәселе емес.
Dialogue: 0,0:18:39.32,0:18:41.49,Default,,0,0,0,,Біз кішкентай кезімізде ғана кездестік.
Dialogue: 0,0:18:41.57,0:18:42.83,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз тыңдағыңыз келе ме?
Dialogue: 0,0:18:42.91,0:18:46.25,Default,,0,0,0,,Әрине! Анаммен тікелей танысқан адамдардың әңгімелері құнды.
Dialogue: 0,0:18:47.29,0:18:48.29,Default,,0,0,0,,О
Dialogue: 0,0:18:48.83,0:18:54.00,Default,,0,0,0,,18 жыл бұрын Широ мені Хачиродан қорғай алмады.
Dialogue: 0,0:18:54.09,0:18:56.51,Default,,0,0,0,,Алдымен мен сені Юрийге апардым.
Dialogue: 0,0:18:57.09,0:18:59.09,Default,,0,0,0,,Лилия! Менің сенен бір жақсылығым бар
Dialogue: 0,0:18:59.59,0:19:00.63,Default,,0,0,0,,Э~?
Dialogue: 0,0:19:01.26,0:19:02.93,Default,,0,0,0,,Мен саған біреуін беремін.
Dialogue: 0,0:19:03.47,0:19:06.85,Default,,0,0,0,,Эй, өтінемін, бұл жігіт туралы бірдеңе жасаңыз.
Dialogue: 0,0:19:06.93,0:19:09.39,Default,,0,0,0,,Ол әйел, сондықтан оны қалай ұстау керектігін білмеймін.
Dialogue: 0,0:19:09.48,0:19:10.64,Default,,0,0,0,,Арама
Dialogue: 0,0:19:11.23,0:19:13.61,Default,,0,0,0,,А... біртүрлі екен.
Dialogue: 0,0:19:13.69,0:19:14.73,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:14.82,0:19:17.23,Default,,0,0,0,,Мен жуынайын деп жатыр едім.
Dialogue: 0,0:19:17.32,0:19:18.15,Default,,0,0,0,,Міне.
Dialogue: 0,0:19:19.65,0:19:22.66,Default,,0,0,0,,Қызыл шаш, әдемі емес пе?
Dialogue: 0,0:19:24.49,0:19:24.99,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:25.08,0:19:26.66,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:19:28.50,0:19:30.50,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:31.04,0:19:32.29,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:19:36.59,0:19:38.09,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:19:38.59,0:19:39.55,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:19:39.63,0:19:40.76,Default,,0,0,0,,- (Широ) Юрий - А?
Dialogue: 0,0:19:40.84,0:19:43.93,Default,,0,0,0,,Сен бұл жігітке қамқор боласың ба?
Dialogue: 0,0:19:44.60,0:19:46.76,Default,,0,0,0,,Менің қолымнан келмейді, сен білесің.
Dialogue: 0,0:19:46.85,0:19:50.02,Default,,0,0,0,,Әйтпесе, сізді баспанаға жібереді.
Dialogue: 0,0:19:50.10,0:19:51.27,Default,,0,0,0,,Бұл да менмін...
Dialogue: 0,0:19:51.35,0:19:53.27,Default,,0,0,0,,-Жоқ! - (Широ) Мына жындыны жібер.
Dialogue: 0,0:19:53.35,0:19:56.32,Default,,0,0,0,,Хэхехе, Широ жақсы.
Dialogue: 0,0:19:56.40,0:19:58.57,Default,,0,0,0,,Егер сен мені ажыратсаң, мен сені жек көремін
Dialogue: 0,0:19:58.65,0:19:59.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:59.61,0:20:02.53,Default,,0,0,0,,Әлде біз осында бірге тұрамыз ба?
Dialogue: 0,0:20:03.41,0:20:07.33,Default,,0,0,0,,Широ әке рөлін, мен шешенің рөлін сомдаймын.
Dialogue: 0,0:20:07.41,0:20:09.12,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:20:10.83,0:20:12.46,Default,,0,0,0,,Бұл қызық емес.
Dialogue: 0,0:20:13.58,0:20:16.13,Default,,0,0,0,,Қалжыңдама, бұзық әйел.
Dialogue: 0,0:20:16.63,0:20:17.84,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:20:18.34,0:20:20.63,Default,,0,0,0,,Оның керемет екеніне сенімдімін.
Dialogue: 0,0:20:21.92,0:20:26.55,Default,,0,0,0,,Сенің анаң ақкөңіл, мейірімді, сұлу адам болған.
Dialogue: 0,0:20:27.51,0:20:30.56,Default,,0,0,0,,Мен саған ешқашан тең келе алмаймын деп ойладым.
Dialogue: 0,0:20:31.39,0:20:33.89,Default,,0,0,0,,Менің ойымша, көздер фосфорға ұқсайды.
Dialogue: 0,0:20:34.39,0:20:37.56,Default,,0,0,0,,Ол Юкиоға ұқсаған болуы мүмкін, өйткені оның меңдері көп.
Dialogue: 0,0:20:38.19,0:20:40.32,Default,,0,0,0,,Міне, әңгіменің соңы.
Dialogue: 0,0:20:41.99,0:20:45.57,Default,,0,0,0,,Туған күніңмен Юкио Рин
Dialogue: 0,0:20:48.37,0:20:49.95,Default,,0,0,0,,Бауырым, ояусың ба?
Dialogue: 0,0:20:50.45,0:20:51.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:52.20,0:20:54.67,Default,,0,0,0,,Анаңның әңгімесінен қандай ой түйдің?
Dialogue: 0,0:20:55.17,0:20:56.83,Default,,0,0,0,,Қалай...
Dialogue: 0,0:20:56.92,0:21:00.38,Default,,0,0,0,,Мен анамның атын да білмедім.
Dialogue: 0,0:21:00.46,0:21:04.51,Default,,0,0,0,,Оның шынымен болғанын білгеніме қуаныштымын.
Dialogue: 0,0:21:06.26,0:21:07.30,Default,,0,0,0,,Аға
Dialogue: 0,0:21:07.89,0:21:10.22,Default,,0,0,0,,Біздің қалай дүниеге келгенімізді білгің келмей ме?
Dialogue: 0,0:21:12.56,0:21:16.81,Default,,0,0,0,,Юрий Егин рыцарьлар шеңберінің ішінде Шайтанның баласын алып жүрген қылмыскер болды.
Dialogue: 0,0:21:16.90,0:21:19.48,Default,,0,0,0,,Деректердің көпшілігі жіктеледі
Dialogue: 0,0:21:20.07,0:21:21.73,Default,,0,0,0,,Бірақ мен білгім келеді
Dialogue: 0,0:21:21.82,0:21:25.53,Default,,0,0,0,,Мен қалай дүниеге келдім және ол неге құпия сақталады?
Dialogue: 0,0:21:26.99,0:21:29.78,Default,,0,0,0,,Сіз әлі де білудің қажеті жоқ деп ойлайсыз ба?
Dialogue: 0,0:21:31.08,0:21:32.79,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:32.87,0:21:35.46,Default,,0,0,0,,Мен бұл қызықты оқиға емес екенін білемін.
Dialogue: 0,0:21:35.54,0:21:38.29,Default,,0,0,0,,Мұны білудің жақсы ештеңесі жоқ.
Dialogue: 0,0:21:38.38,0:21:42.30,Default,,0,0,0,,Туған күнімде анамның сұлу, мейірімді екенін енді білдім.
Dialogue: 0,0:21:42.38,0:21:44.01,Default,,0,0,0,,Мен жеткілікті болдым
Dialogue: 0,0:21:45.13,0:21:46.43,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:21:47.01,0:21:47.76,Default,,0,0,0,,Зәр шығару
Dialogue: 0,0:21:47.84,0:21:49.39,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:21:49.89,0:21:51.43,Default,,0,0,0,,Сіздің туған күніңіз қандай?
Dialogue: 0,0:21:51.51,0:21:54.22,Default,,0,0,0,,Негізі мен қашан туғанымды да білмеймін.
Dialogue: 0,0:21:54.73,0:21:58.15,Default,,0,0,0,,Мен әдетте ойланбастан алға ұмтыламын, бірақ неге...
Dialogue: 0,0:21:58.23,0:22:00.94,Default,,0,0,0,,Неліктен бұл бөлікке соншалықты енжарсыз?
Dialogue: 0,0:22:01.02,0:22:02.94,Default,,0,0,0,,Қайсысы сөйлесуші?
Dialogue: 0,0:22:06.03,0:22:08.03,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.95,0:23:35.95,Default,,0,0,0,,～♪
