Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.13,0:00:06.47,Default,,0,0,0,,Маған ұнайсың.
Dialogue: 0,0:00:06.47,0:00:10.27,Default,,0,0,0,,Мен кенеттен кешірім сұраймын. Бүгін үйге барма.
Dialogue: 0,0:00:12.27,0:00:14.44,Default,,0,0,0,,《Адачи: Біз оны тоқтатуымыз керек.
Dialogue: 0,0:00:14.44,0:00:18.95,Default,,0,0,0,,Бірақ оны тоқтату үшін не айтуым керек?
Dialogue: 0,0:00:18.95,0:00:24.12,Default,,0,0,0,,Маған Куросава шынымен ұнай ма...?
Dialogue: 0,0:02:08.09,0:02:10.59,Default,,0,0,0,,《Іссапар?
Dialogue: 0,0:02:10.59,0:02:12.73,Default,,0,0,0,,Егер сіз оны көргіңіз келмесе.
Dialogue: 0,0:02:12.73,0:02:16.43,Default,,0,0,0,,Шынымды айтсам, бетпе-бет кездеспейтіндігім үшін жеңілдеп қалдым.
Dialogue: 0,0:02:16.43,0:02:18.43,Default,,0,0,0,,Га.
Dialogue: 0,0:02:18.43,0:02:21.07,Default,,0,0,0,,《Мен ең нашармын...
Dialogue: 0,0:02:21.07,0:02:23.17,Default,,0,0,0,,Бірақ…》
Dialogue: 0,0:02:26.24,0:02:30.75,Default,,0,0,0,,Ах. Ittete...
Dialogue: 0,0:02:30.75,0:02:33.08,Default,,0,0,0,,Кешіріңіз. Жоқ, бұл➡
Dialogue: 0,0:02:33.08,0:02:35.62,Default,,0,0,0,,Таң қалды. Сенімен бәрі жақсы ма?
Dialogue: 0,0:02:35.62,0:02:38.42,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:02:38.42,0:02:42.26,Default,,0,0,0,,《Аа, мен уақытында үлгермеймін》
Dialogue: 0,0:02:42.26,0:02:45.09,Default,,0,0,0,,Фудзисаки мырза, қиналсаңыз➡
Dialogue: 0,0:02:45.09,0:02:49.77,Default,,0,0,0,,Мен саған көмектесемін, бірақ... Жарайды ма?
Dialogue: 0,0:02:49.77,0:02:52.10,Default,,0,0,0,,Шындығында, бұл бұдан кейін жиналыс материалдарында болады➡
Dialogue: 0,0:02:52.10,0:02:55.24,Default,,0,0,0,,Соңғы минутта түзету енгізілді...
Dialogue: 0,0:02:55.24,0:02:57.44,Default,,0,0,0,,Екі адам жасаса, тез бітеді.
Dialogue: 0,0:02:57.44,0:03:01.91,Default,,0,0,0,,Кешіріңіз. рақмет сізге.
Dialogue: 0,0:03:01.91,0:03:06.08,Default,,0,0,0,,Қазір ойлап қарасам, Адачи-сан мен Куросава-сан жақсы достар.
Dialogue: 0,0:03:06.08,0:03:08.08,Default,,0,0,0,,《Сен доссың ба? 》
Dialogue: 0,0:03:08.08,0:03:10.95,Default,,0,0,0,,Мен бүгін іссапардамын, сондықтан бұл бір күндік сапар сияқты➡
Dialogue: 0,0:03:10.95,0:03:14.72,Default,,0,0,0,,Куросава мырзаға маған түбіртек беруін айта аласыз ба?
Dialogue: 0,0:03:14.72,0:03:19.06,Default,,0,0,0,,Жарайды. рақмет сізге!
Dialogue: 0,0:03:19.06,0:03:22.13,Default,,0,0,0,,《Бұл шынымен сүйкімді.
Dialogue: 0,0:03:22.13,0:03:25.73,Default,,0,0,0,,Мен оның мінезі туралы көп білмеймін, бірақ ол байсалды сияқты.
Dialogue: 0,0:03:25.73,0:03:30.11,Default,,0,0,0,,Ол үнемі кітап оқиды, зерделі, жақсы бала.
Dialogue: 0,0:03:30.11,0:03:32.97,Default,,0,0,0,,｟《Бұл жаңа кітап хит болды!
Dialogue: 0,0:03:32.97,0:03:35.14,Default,,0,0,0,,Қара шаш - ең жақсысы! 》｠
Dialogue: 0,0:03:38.08,0:03:41.08,Default,,0,0,0,,Ах. кешіріңіз.
Dialogue: 0,0:03:41.08,0:03:43.62,Default,,0,0,0,,А, жарайды, мен...
Dialogue: 0,0:03:43.62,0:03:47.19,Default,,0,0,0,,《Фудзисаки: Адачи-сан, бүгін өзіңді сәл ыңғайсыз сезініп тұрсың ба? 》
Dialogue: 0,0:03:47.19,0:03:53.10,Default,,0,0,0,,Ах. «Мырза. Куросава бүгін жоқ》
Dialogue: 0,0:03:53.10,0:03:58.27,Default,,0,0,0,,《Мистер. Фудзисаки, сен мен үшін уайымдап тұрсың.
Dialogue: 0,0:03:58.27,0:04:02.14,Default,,0,0,0,,Ух... бұл мен туралы➡
Dialogue: 0,0:04:02.14,0:04:05.21,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:04:05.21,0:04:07.08,Default,,0,0,0,,Га.
Dialogue: 0,0:04:07.08,0:04:11.08,Default,,0,0,0,,《Мен 30 жыл өмірімде мұндай жағдай бірінші рет болып тұр.》
Dialogue: 0,0:04:14.48,0:04:18.09,Default,,0,0,0,,《Фудзисаки мырзамен қарым-қатынас дамитын болса➡
Dialogue: 0,0:04:18.09,0:04:21.26,Default,,0,0,0,,Пәктігіңді тастап, мына оғаш сиқырды қолдан➡
Dialogue: 0,0:04:21.26,0:04:23.23,Default,,0,0,0,,Ол жоғалып кетуі мүмкін》
Dialogue: 0,0:04:25.26,0:04:29.43,Default,,0,0,0,,《Куросавамен бұлай болмас еді.
Dialogue: 0,0:04:29.43,0:04:31.90,Default,,0,0,0,,Куросава менен үлкен➡
Dialogue: 0,0:04:31.90,0:04:34.40,Default,,0,0,0,,Ол сондай әдемі, ренжітеді.
Dialogue: 0,0:04:34.40,0:04:36.57,Default,,0,0,0,,Қол тигізген сайын шу шығады➡
Dialogue: 0,0:04:36.57,0:04:38.94,Default,,0,0,0,,Бұл өте жиіркенішті.
Dialogue: 0,0:04:38.94,0:04:40.91,Default,,0,0,0,,Мен қызғаншақпын...》
Dialogue: 0,0:04:43.08,0:04:45.08,Default,,0,0,0,,《Ер》
Dialogue: 0,0:04:47.25,0:04:50.75,Default,,0,0,0,,《Бірге араласатын болсақ, бәрі қиын әрі қиын болатынына сенімдімін➡
Dialogue: 0,0:04:50.75,0:04:52.75,Default,,0,0,0,,болады》
Dialogue: 0,0:04:52.75,0:05:06.07,Default,,0,0,0,,♬～
Dialogue: 0,0:05:06.07,0:05:10.27,Default,,0,0,0,,《Ұзақ уақыт бойы бұл сезім маған ешқашан жетпейді деп ойладым.
Dialogue: 0,0:05:10.27,0:05:14.74,Default,,0,0,0,,Адачи мейірімді және бейкүнә қыздарды ұнатады➡
Dialogue: 0,0:05:14.74,0:05:17.25,Default,,0,0,0,,Себебі мен білетінмін.
Dialogue: 0,0:05:17.25,0:05:20.75,Default,,0,0,0,,Егер әріптесім кенеттен маған кінәсін мойындаса, қиын болар еді➡
Dialogue: 0,0:05:20.75,0:05:25.59,Default,,0,0,0,,Мен сенің жаныңда мәңгі болсам жақсы болар еді деп ойладым.
Dialogue: 0,0:05:25.59,0:05:29.42,Default,,0,0,0,,Бірақ сол түнде...
Dialogue: 0,0:05:29.42,0:05:31.93,Default,,0,0,0,,Адачи менің үйіме қонаққа келген күннен бастап➡
Dialogue: 0,0:05:31.93,0:05:35.56,Default,,0,0,0,,Неге екені белгісіз, Адачи мені байқай бастады➡
Dialogue: 0,0:05:35.56,0:05:38.07,Default,,0,0,0,,Мен сараң болдым.
Dialogue: 0,0:05:38.07,0:05:40.90,Default,,0,0,0,,Мен сенімен көбірек болғым келеді. Мен оған қол тигізгім келеді.
Dialogue: 0,0:05:40.90,0:05:43.74,Default,,0,0,0,,Мен сізге ұнағаныңызды қалаймын.
Dialogue: 0,0:05:43.74,0:05:48.08,Default,,0,0,0,,Мен біреу туралы бірінші рет көп ойладым...
Dialogue: 0,0:05:48.08,0:05:50.95,Default,,0,0,0,,Осылайша мен саған ғашық болған сәттен бастап➡
Dialogue: 0,0:05:50.95,0:05:54.48,Default,,0,0,0,,Мен оны көптен бері көріп жүргендіктен білдім.
Dialogue: 0,0:05:54.48,0:05:58.29,Default,,0,0,0,,Адачи Фудзисаки-санға ғашық болатынына сенімдімін.
Dialogue: 0,0:06:00.26,0:06:03.12,Default,,0,0,0,,《Олай болса, өз сезімдеріңізді мойындаңыз➡
Dialogue: 0,0:06:03.12,0:06:06.73,Default,,0,0,0,,Мен бас тартсам деп ойладым...》
Dialogue: 0,0:06:08.73,0:06:11.93,Default,,0,0,0,,《Мен сені қиындыққа душар еттім》
Dialogue: 0,0:06:11.93,0:06:14.80,Default,,0,0,0,,Га. (Асахина) Не болды? Куросава.
Dialogue: 0,0:06:14.80,0:06:17.44,Default,,0,0,0,,Ах. Ах... кешіріңіз.
Dialogue: 0,0:06:17.44,0:06:19.41,Default,,0,0,0,,Бұл ештеңе емес, Асахина-сан.
Dialogue: 0,0:06:23.45,0:06:25.95,Default,,0,0,0,,《Мен Куросава үшін ренжідім➡
Dialogue: 0,0:06:25.95,0:06:29.22,Default,,0,0,0,,Кешірім сұра және бұрынғыдай қарым-қатынасымызды жалғастырайық》
Dialogue: 0,0:06:32.92,0:06:34.89,Default,,0,0,0,,《Бұрынғыдай...》
Dialogue: 0,0:06:38.43,0:06:40.90,Default,,0,0,0,,《Мүмкін емес》
Dialogue: 0,0:06:40.90,0:06:45.57,Default,,0,0,0,,｟《Кешіріңіз. Мен... менің қолымнан келмейді》｠
Dialogue: 0,0:06:48.74,0:06:50.91,Default,,0,0,0,,《Мүмкін емес》
Dialogue: 0,0:06:50.91,0:06:54.31,Default,,0,0,0,,｟Сізбен кездескеніме қуаныштымын.
Dialogue: 0,0:06:54.31,0:06:56.28,Default,,0,0,0,,《Егер мен болсам》
Dialogue: 0,0:06:58.35,0:07:01.92,Default,,0,0,0,,Адачи…｠
Dialogue: 0,0:07:01.92,0:07:03.92,Default,,0,0,0,,Мұның бәрі аяқталды!
Dialogue: 0,0:07:03.92,0:07:06.25,Default,,0,0,0,,Сізге көп рахмет, Адачи-сан...
Dialogue: 0,0:07:06.25,0:07:09.09,Default,,0,0,0,,Ах. Не болды?
Dialogue: 0,0:07:09.09,0:07:11.36,Default,,0,0,0,,Кешіріңіз, мен енді шығамын!
Dialogue: 0,0:07:17.77,0:07:21.74,Default,,0,0,0,,《Олай болуы мүмкін емес деп қайта-қайта жоққа шығардым.》
Dialogue: 0,0:07:25.11,0:07:28.01,Default,,0,0,0,,《Бірақ мен оны ұстаған сайын естідім➡
Dialogue: 0,0:07:28.01,0:07:31.78,Default,,0,0,0,,Куросаваның ішкі дауысы құлағымнан кетпейді.
Dialogue: 0,0:07:33.75,0:07:35.75,Default,,0,0,0,,《Куросава…》
Dialogue: 0,0:07:38.42,0:07:40.39,Default,,0,0,0,,《Куросава…》
Dialogue: 0,0:07:46.83,0:07:49.20,Default,,0,0,0,,Куросава! Ах.
Dialogue: 0,0:07:51.43,0:07:55.90,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:07:57.94,0:08:00.58,Default,,0,0,0,,болды.
Dialogue: 0,0:08:00.58,0:08:02.91,Default,,0,0,0,,Адачи мұнда неге жүр?
Dialogue: 0,0:08:02.91,0:08:05.41,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:08:05.41,0:08:07.42,Default,,0,0,0,,Жоқ….
Dialogue: 0,0:08:12.09,0:08:15.92,Default,,0,0,0,,Осы уақытқа дейін қашып кеткенім үшін кешірім сұраймын.
Dialogue: 0,0:08:15.92,0:08:17.89,Default,,0,0,0,,Мен….
Dialogue: 0,0:08:21.26,0:08:23.93,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:23.93,0:08:25.90,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:08:28.40,0:08:31.81,Default,,0,0,0,,《Куросава – адам➡
Dialogue: 0,0:08:31.81,0:08:35.58,Default,,0,0,0,,Мен кейде қорқамын, сондықтан бұрынғыдай әріптес ретінде араласқанды жөн көремін➡
Dialogue: 0,0:08:35.58,0:08:38.41,Default,,0,0,0,,Бұл оңай болатынына сенімдімін.
Dialogue: 0,0:08:38.41,0:08:41.75,Default,,0,0,0,,Бірақ мен ➡
Dialogue: 0,0:08:41.75,0:08:44.65,Default,,0,0,0,,Куросаваның ешкім ұстай алмаған жүрегі...
Dialogue: 0,0:08:47.46,0:08:49.42,Default,,0,0,0,,《Мен оны көбірек қозғағым келеді》
Dialogue: 0,0:08:52.79,0:08:55.80,Default,,0,0,0,,《Куросава бәрін бағалағысы келетінін айтты...》
Dialogue: 0,0:08:57.93,0:09:01.57,Default,,0,0,0,,《Мен де оны қастерлей бергім келеді➡
Dialogue: 0,0:09:01.57,0:09:04.47,Default,,0,0,0,,Мен ойладым》
Dialogue: 0,0:09:04.47,0:09:08.48,Default,,0,0,0,,Мен де. Не?
Dialogue: 0,0:09:14.08,0:09:17.09,Default,,0,0,0,,Мен де Куросаваны жақсы көремін!
Dialogue: 0,0:09:22.76,0:09:24.93,Default,,0,0,0,,Уау.
Dialogue: 0,0:09:31.83,0:09:34.87,Default,,0,0,0,,《Куросаваның➡
Dialogue: 0,0:09:34.87,0:09:38.61,Default,,0,0,0,,Сөзбен жеткізу мүмкін емес эмоциялар➡
Dialogue: 0,0:09:38.61,0:09:40.88,Default,,0,0,0,,Маған ағып жатыр》
Dialogue: 0,0:09:46.25,0:09:49.25,Default,,0,0,0,,《Таңғажайып жылдам жүрек》
Dialogue: 0,0:09:52.12,0:09:56.66,Default,,0,0,0,,《30 жасқа дейін қыз болсаң, сиқыршы бола аласың➡
Dialogue: 0,0:09:56.66,0:09:58.76,Default,,0,0,0,,Бұл шынымен ақымақтық.
Dialogue: 0,0:10:01.93,0:10:04.27,Default,,0,0,0,,《Бірақ➡
Dialogue: 0,0:10:04.27,0:10:07.17,Default,,0,0,0,,Куросаваның жүрегін қозғау үшін...》
Dialogue: 0,0:10:10.57,0:10:15.08,Default,,0,0,0,,《Мүмкін мен сиқыршы болған шығармын》
Dialogue: 0,0:10:30.09,0:10:32.89,Default,,0,0,0,,О, менің…. Ах.
Dialogue: 0,0:10:36.23,0:10:39.60,Default,,0,0,0,,《Қасиетті! Біз шынымен ұят нәрсе істеп жатырмыз! 》
Dialogue: 0,0:10:39.60,0:10:43.40,Default,,0,0,0,,Куросава….
Dialogue: 0,0:10:43.40,0:10:45.57,Default,,0,0,0,,《Мен жібергім келмейді.
Dialogue: 0,0:10:45.57,0:10:48.24,Default,,0,0,0,,Бірақ Адачи ұялып қалуы мүмкін.
Dialogue: 0,0:10:48.24,0:10:51.61,Default,,0,0,0,,Кету уақыты келді... бәрібір!
Dialogue: 0,0:10:51.61,0:10:53.75,Default,,0,0,0,,Ақыры екеуміз де ғашық болдық!
Dialogue: 0,0:10:53.75,0:10:55.92,Default,,0,0,0,,Жоқ, менде бәрі жақсы болуы мүмкін》
Dialogue: 0,0:10:55.92,0:10:57.92,Default,,0,0,0,,《Бұл ауыр және шулы》
Dialogue: 0,0:10:57.92,0:11:00.79,Default,,0,0,0,,《Мен Асахина-сан➡мен іссапарға бардым
Dialogue: 0,0:11:00.79,0:11:04.43,Default,,0,0,0,,Көрсең...》《Не! ? Ах》
Dialogue: 0,0:11:04.43,0:11:07.90,Default,,0,0,0,,《Жақсы сөз айтпа! Адачидің дене температурасы мен иісі➡
Dialogue: 0,0:11:07.90,0:11:10.57,Default,,0,0,0,,Көлемнен бөлек тұруға шыдай алмайсың ба? ?
Dialogue: 0,0:11:10.57,0:11:12.60,Default,,0,0,0,,Бұл, әрине, мүмкін емес! 》
Dialogue: 0,0:11:12.60,0:11:15.57,Default,,0,0,0,,《Ей, ақыл, барыңды сал! 》
Dialogue: 0,0:11:15.57,0:11:18.27,Default,,0,0,0,,Куросава Уақыт келді...
Dialogue: 0,0:11:18.27,0:11:20.58,Default,,0,0,0,,Куросава: Мен сені күттім.
Dialogue: 0,0:11:20.58,0:11:24.25,Default,,0,0,0,,Ах! (итеру дыбысы)
Dialogue: 0,0:11:24.25,0:11:26.25,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:28.25,0:11:31.75,Default,,0,0,0,,Albireo компаниясына қатысты Сіз сонда дүкен ашуға болатын сияқты.
Dialogue: 0,0:11:31.75,0:11:36.09,Default,,0,0,0,,О, түсіндім! Куросава-кун күткендей!
Dialogue: 0,0:11:36.09,0:11:38.76,Default,,0,0,0,,Асахина да! Бұл көп жұмыс болса керек.
Dialogue: 0,0:11:38.76,0:11:40.76,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:11:44.13,0:11:47.70,Default,,0,0,0,,Adachi деректерінің қысқаша мазмұны Рахмет.
Dialogue: 0,0:11:47.70,0:11:50.91,Default,,0,0,0,,Сәлеметсіз бе. Аа, Фудзисаки мырза➡
Dialogue: 0,0:11:50.91,0:11:53.61,Default,,0,0,0,,Ол маған бүгін түбіртек жіберуімді айтты.
Dialogue: 0,0:11:53.61,0:11:56.08,Default,,0,0,0,,Аа, кешіріңіз. Оны бірден шығарыңыз.
Dialogue: 0,0:12:00.62,0:12:04.75,Default,,0,0,0,,《Мен қобалжыдым~! Қазір ғана тыныш болды, солай емес пе?
Dialogue: 0,0:12:04.75,0:12:08.12,Default,,0,0,0,,Мен бұрынғыдай жұмыста қалуды ойладым➡
Dialogue: 0,0:12:08.12,0:12:11.16,Default,,0,0,0,,Мен бұл туралы біле бастағанда, мен қатты қобалжыдым➡
Dialogue: 0,0:12:11.16,0:12:16.03,Default,,0,0,0,,Күрделі. Қаншама адамдар кеңселік романстарға ие болғаны таң қалдырады.
Dialogue: 0,0:12:16.03,0:12:17.93,Default,,0,0,0,,｟Рахмет｠
Dialogue: 0,0:12:17.93,0:12:20.60,Default,,0,0,0,,《Қарғыс атсын, менімен санаспа! 》
Dialogue: 0,0:12:26.94,0:12:30.08,Default,,0,0,0,,Адачи мырза. Хмм... Ах.
Dialogue: 0,0:12:30.08,0:12:33.25,Default,,0,0,0,,Куросава мырзаға түбіртек туралы айтып беріңізші➡
Dialogue: 0,0:12:33.25,0:12:36.28,Default,,0,0,0,,Рахмет. жоқ….
Dialogue: 0,0:12:36.28,0:12:38.42,Default,,0,0,0,,《Дұрыс. Фудзисаки мырза➡
Dialogue: 0,0:12:38.42,0:12:41.09,Default,,0,0,0,,Мен сізге ұнайсыз.》
Dialogue: 0,0:12:41.09,0:12:44.93,Default,,0,0,0,,Бұдан былай мен Куросава-сан туралы барлық нәрседе Адачи-санға сенемін деп ойлаймын.
Dialogue: 0,0:12:44.93,0:12:48.13,Default,,0,0,0,,Е-е, мен болсам, бәрі жақсы.
Dialogue: 0,0:12:48.13,0:12:50.63,Default,,0,0,0,,Уау, көп рахмет.
Dialogue: 0,0:12:50.63,0:12:53.70,Default,,0,0,0,,Бұл пайдалы. Фуфуфу….
Dialogue: 0,0:12:56.74,0:12:59.11,Default,,0,0,0,,《Кешіріңіз! Мен туралы➡
Dialogue: 0,0:12:59.11,0:13:01.24,Default,,0,0,0,,Сен маған ғашық болсаң да...》
Dialogue: 0,0:13:01.24,0:13:03.68,Default,,0,0,0,,Біз шынымен жақсы араласамыз.
Dialogue: 0,0:13:03.68,0:13:05.58,Default,,0,0,0,,《Мистер. Адачи және Куросава мырза➡
Dialogue: 0,0:13:05.58,0:13:08.38,Default,,0,0,0,,Бірдеңе болды! Сенімді! 》
Dialogue: 0,0:13:12.45,0:13:15.59,Default,,0,0,0,,Куросава: Бұл маған бұйырды.
Dialogue: 0,0:13:15.59,0:13:19.19,Default,,0,0,0,,А, рахмет. Бұл тез және пайдалы.
Dialogue: 0,0:13:22.10,0:13:25.90,Default,,0,0,0,,Гэез. Жарайды, мен қазір барамын.
Dialogue: 0,0:13:25.90,0:13:28.07,Default,,0,0,0,,А, мен күттім.
Dialogue: 0,0:13:28.07,0:13:31.61,Default,,0,0,0,,Бұл. Сіз тәттілерді ұнатасыз, солай ма?
Dialogue: 0,0:13:31.61,0:13:36.11,Default,,0,0,0,,Ей…. Ах, рахмет.
Dialogue: 0,0:13:36.11,0:13:38.08,Default,,0,0,0,,《Алтыбұрыш: Бұл екеуі, қандай да бір себептермен жақында➡
Dialogue: 0,0:13:38.08,0:13:42.62,Default,,0,0,0,,Айтайын дегенім, біз көп уақытты бірге өткіземіз...
Dialogue: 0,0:13:42.62,0:13:46.59,Default,,0,0,0,,Егер Адачи-сан екеуміз сонда болсақ, Куросава-сенпайдың сізге қоңырау шалу ықтималдығы ➡
Dialogue: 0,0:13:46.59,0:13:49.26,Default,,0,0,0,,Қымбат көрінеді...
Dialogue: 0,0:13:49.26,0:13:51.33,Default,,0,0,0,,Өткен күні...》
Dialogue: 0,0:13:51.33,0:13:53.26,Default,,0,0,0,,｟Алтыбұрыш｠
Dialogue: 0,0:13:53.26,0:13:55.33,Default,,0,0,0,,《Алтыбұрыш: Өткен күні...》
Dialogue: 0,0:13:55.33,0:13:57.27,Default,,0,0,0,,｜Алтыбұрыш｠
Dialogue: 0,0:13:57.27,0:14:00.94,Default,,0,0,0,,《Алтыбұрыш: Дәл қазір бір-бірімізге қаншалықты жақын болғанымыз таң қалдырды...
Dialogue: 0,0:14:00.94,0:14:02.90,Default,,0,0,0,,Бұл болуы мүмкін...》
Dialogue: 0,0:14:02.90,0:14:05.44,Default,,0,0,0,,Алтыбұрыш. Иә.
Dialogue: 0,0:14:05.44,0:14:08.34,Default,,0,0,0,,Бұл электрондық пошта, бірақ сіздің қатеңіз➡
Dialogue: 0,0:14:08.34,0:14:10.24,Default,,0,0,0,,Адачи оны тексеріп жатыр.
Dialogue: 0,0:14:10.24,0:14:13.92,Default,,0,0,0,,Сақ болыңыз. иә!
Dialogue: 0,0:14:13.92,0:14:16.08,Default,,0,0,0,,Адачи де бос емес.
Dialogue: 0,0:14:16.08,0:14:19.45,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:14:19.45,0:14:22.76,Default,,0,0,0,,《Куросава-сан керемет, Адачи-сан және мен➡
Dialogue: 0,0:14:22.76,0:14:25.93,Default,,0,0,0,,Сіз оны көрдіңіз.
Dialogue: 0,0:14:25.93,0:14:29.06,Default,,0,0,0,,Менде бұл сезім біраздан бері болды➡
Dialogue: 0,0:14:29.06,0:14:31.60,Default,,0,0,0,,Мен ақыры түсіндім.
Dialogue: 0,0:14:31.60,0:14:34.10,Default,,0,0,0,,А, мен тым сезімтал емеспін!
Dialogue: 0,0:14:34.10,0:14:36.47,Default,,0,0,0,,Мен неге байқамадым деп ойлаймын!
Dialogue: 0,0:14:36.47,0:14:38.64,Default,,0,0,0,,Куросава және Адачи мырза...》
Dialogue: 0,0:14:40.74,0:14:43.24,Default,,0,0,0,,《Маған сәбіз, таяқшамен бірге жұмыс жасаңдар➡
Dialogue: 0,0:14:43.24,0:14:46.15,Default,,0,0,0,,Ол мені өсірмекші!
Dialogue: 0,0:14:46.15,0:14:49.18,Default,,0,0,0,,Мен өте жақсы көремін!
Dialogue: 0,0:14:49.18,0:14:51.75,Default,,0,0,0,,Мен осы компанияға қосылғаныма қуаныштымын! 》
Dialogue: 0,0:14:51.75,0:14:53.92,Default,,0,0,0,,《Білмедің бе? 》
Dialogue: 0,0:14:53.92,0:14:58.09,Default,,0,0,0,,《Цюге: «Адамдар ғашық болған кезде ақымақ болады» деп кім айтты➡
Dialogue: 0,0:14:58.09,0:15:01.90,Default,,0,0,0,,Бұл Ницше немесе Шекспир ме...》 📱 (хабарландыру дыбысы)
Dialogue: 0,0:15:15.24,0:15:18.41,Default,,0,0,0,,《Әрине. Қайтадан оқимын➡
Dialogue: 0,0:15:18.41,0:15:21.42,Default,,0,0,0,,Ол жеткізушіге қатты ұқсайды.
Dialogue: 0,0:15:21.42,0:15:25.59,Default,,0,0,0,,Бұл ақымақтық. Бірақ ➡ деп есептесек
Dialogue: 0,0:15:25.59,0:15:28.26,Default,,0,0,0,,Кейде мен төбелеске түсіп қаламын.
Dialogue: 0,0:15:28.26,0:15:30.76,Default,,0,0,0,,Пошталық тапсырыс бойынша сатылымдар анық өсті.
Dialogue: 0,0:15:30.76,0:15:33.93,Default,,0,0,0,,Басқа жеткізушілер келген кездегі бос сезім.
Dialogue: 0,0:15:33.93,0:15:39.10,Default,,0,0,0,,Ал оны көргенде жүрегім жиілейді.
Dialogue: 0,0:15:39.10,0:15:41.17,Default,,0,0,0,,Бұл махаббат па? ? 》
Dialogue: 0,0:15:43.44,0:15:46.61,Default,,0,0,0,,《Бұл мүмкін емес.
Dialogue: 0,0:15:46.61,0:15:49.74,Default,,0,0,0,,Басқа адам ер адам, сондай Янки➡
Dialogue: 0,0:15:49.74,0:15:51.75,Default,,0,0,0,,Мен әлі атын білмесем де...》
Dialogue: 0,0:15:57.42,0:15:59.42,Default,,0,0,0,,Ах.
Dialogue: 0,0:15:59.42,0:16:04.09,Default,,0,0,0,,《Ұятсыз! Әдістемелік кітаптарға сену – ақымақтықтың шыңы! 》
Dialogue: 0,0:16:04.09,0:16:06.39,Default,,0,0,0,,Мәңгі солай бол. Қорқынышты.
Dialogue: 0,0:16:09.76,0:16:13.73,Default,,0,0,0,,《Енді ойлап қарасам, ол шабарман➡
Dialogue: 0,0:16:13.73,0:16:16.74,Default,,0,0,0,,Мен мысықтарды жақсы көремін дегеннен басқа ештеңе білмеймін.
Dialogue: 0,0:16:16.74,0:16:18.74,Default,,0,0,0,,Тіпті аты...》
Dialogue: 0,0:16:18.74,0:16:20.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.74,0:16:23.28,Default,,0,0,0,,《Бірақ мен оның түрін көргенде дірілдеп тұра алмаймын➡
Dialogue: 0,0:16:23.28,0:16:25.41,Default,,0,0,0,,Жазу әрекеттеріне де әсер етті》
Dialogue: 0,0:16:25.41,0:16:27.42,Default,,0,0,0,,Чивассу.
Dialogue: 0,0:16:27.42,0:16:29.42,Default,,0,0,0,,《Ең тәтті галлюцинациялар да...》
Dialogue: 0,0:16:29.42,0:16:32.45,Default,,0,0,0,,Сәлеметсіз бе. Хмм.
Dialogue: 0,0:16:32.45,0:16:35.09,Default,,0,0,0,,《Нағыз! ? 》
Dialogue: 0,0:16:35.09,0:16:39.09,Default,,0,0,0,,Қандай таңғаларлық сәйкестік. Ах, ах.
Dialogue: 0,0:16:39.09,0:16:42.10,Default,,0,0,0,,《Тыныштал! Бұл сіздің мүмкіндігіңіз!
Dialogue: 0,0:16:42.10,0:16:44.93,Default,,0,0,0,,Оның қалауын мұқият зерттеп, оны ақылды түрде шақыру арқылы➡
Dialogue: 0,0:16:44.93,0:16:46.93,Default,,0,0,0,,Ұнайтындығыңызды арттырыңыз! 》
Dialogue: 0,0:16:46.93,0:16:49.27,Default,,0,0,0,,Иә? Не… оның үстіне қоқысты салып жатырсыз ба?
Dialogue: 0,0:16:49.27,0:16:51.31,Default,,0,0,0,,《Ға! 》
Dialogue: 0,0:16:51.31,0:16:55.11,Default,,0,0,0,,《А... мен шөлдедім》
Dialogue: 0,0:16:55.11,0:16:57.95,Default,,0,0,0,,Tsk tsk tsk… Шайға ше?
Dialogue: 0,0:16:57.95,0:17:00.98,Default,,0,0,0,,Иә? Кенеттен бірдеңе. Мен бармаймын.
Dialogue: 0,0:17:00.98,0:17:02.98,Default,,0,0,0,,《Ку》
Dialogue: 0,0:17:02.98,0:17:04.95,Default,,0,0,0,,《Әлі біртүрлі жігіт》
Dialogue: 0,0:17:08.09,0:17:11.26,Default,,0,0,0,,Сен де бірдеңе алуға келдің бе?
Dialogue: 0,0:17:11.26,0:17:13.59,Default,,0,0,0,,А, кроссовкалар.
Dialogue: 0,0:17:13.59,0:17:16.76,Default,,0,0,0,,Мен билеп жүргенмін, сондықтан бірден ауырып қалдым.
Dialogue: 0,0:17:16.76,0:17:20.27,Default,,0,0,0,,Би? Сіз басқа нәрсені елестететініңізге сенімдімін.
Dialogue: 0,0:17:24.94,0:17:27.81,Default,,0,0,0,,Аяқ киім тез бұзылады ма?
Dialogue: 0,0:17:27.81,0:17:30.34,Default,,0,0,0,,Мен кәсіби маман болуды мақсат етіп отырмын.
Dialogue: 0,0:17:30.34,0:17:32.78,Default,,0,0,0,,Кейде әншілермен билеймін.
Dialogue: 0,0:17:32.78,0:17:35.12,Default,,0,0,0,,Уау, бұл керемет емес пе!
Dialogue: 0,0:17:35.12,0:17:38.75,Default,,0,0,0,,Бөлек. Менің колледж клубымның жігіттері➡
Dialogue: 0,0:17:38.75,0:17:41.22,Default,,0,0,0,,үшін жұмысқа орналасқан және жұмыс істейді➡
Dialogue: 0,0:17:41.22,0:17:44.13,Default,,0,0,0,,Мен ғана бас тарта алмаймын.
Dialogue: 0,0:17:44.13,0:17:48.00,Default,,0,0,0,,Бұл мәңгі қалуы мүмкін емес...
Dialogue: 0,0:17:48.00,0:17:51.47,Default,,0,0,0,,Шынымды айтсам, уақыт келді деп ойлаймын.
Dialogue: 0,0:17:55.14,0:17:58.97,Default,,0,0,0,,Түсіндім! иә? Мен де романист болғым келеді➡
Dialogue: 0,0:17:58.97,0:18:01.94,Default,,0,0,0,,Университетте жүрген күндерімде рөлге тағайындалған соң жақсы көңіл-күйде болдым➡
Dialogue: 0,0:18:01.94,0:18:04.78,Default,,0,0,0,,Мен жұмысқа тұрмай-ақ роман жазуды жалғастырдым➡
Dialogue: 0,0:18:04.78,0:18:07.15,Default,,0,0,0,,Қанша шығарма жазсам да жүлде ала алмаймын➡
Dialogue: 0,0:18:07.15,0:18:10.42,Default,,0,0,0,,Қажетсіз қартаюдың болашағына алаңдау➡
Dialogue: 0,0:18:10.42,0:18:12.42,Default,,0,0,0,,Өз талантына сенбеу➡
Dialogue: 0,0:18:12.42,0:18:15.86,Default,,0,0,0,,Мен қоғамға кірмеу қорқынышын түсінемін!
Dialogue: 0,0:18:15.86,0:18:18.26,Default,,0,0,0,,Бірақ! Сіз әлі➡
Dialogue: 0,0:18:18.26,0:18:22.30,Default,,0,0,0,,Сіз шынымен бас тартқыңыз келмейді, солай ма?
Dialogue: 0,0:18:22.30,0:18:25.67,Default,,0,0,0,,Неліктен бұлай...? Болмаса ➡
Dialogue: 0,0:18:25.67,0:18:29.44,Default,,0,0,0,,Мен аяқ киімім бүлінетіндей қатты жаттығу жасамас едім.
Dialogue: 0,0:18:29.44,0:18:31.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:33.94,0:18:35.91,Default,,0,0,0,,《Уа, құдай! Кенеттен➡
Dialogue: 0,0:18:35.91,0:18:37.95,Default,,0,0,0,,Мен уағыздай көрінетін бірдеңе айттым!
Dialogue: 0,0:18:37.95,0:18:41.28,Default,,0,0,0,,Бұл жастардың ең жек көретін мінез-құлқы емес пе?
Dialogue: 0,0:18:41.28,0:18:43.42,Default,,0,0,0,,Ававава…》
Dialogue: 0,0:18:43.42,0:18:46.59,Default,,0,0,0,,Көгеру. иә?
Dialogue: 0,0:18:46.59,0:18:48.59,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:18:48.59,0:18:53.13,Default,,0,0,0,,Ал, қазір жаттығу жасаймыз, бітті.
Dialogue: 0,0:18:53.13,0:18:56.13,Default,,0,0,0,,Сондай-ақ, менің атым "Кими" емес➡
Dialogue: 0,0:18:56.13,0:18:58.27,Default,,0,0,0,,«Минато» деп аталады.
Dialogue: 0,0:18:58.27,0:19:00.27,Default,,0,0,0,,Удонға сәлем айт!
Dialogue: 0,0:19:04.27,0:19:07.31,Default,,0,0,0,,《Аты да сүйкімді! 》
Dialogue: 0,0:19:07.31,0:19:09.78,Default,,0,0,0,,<Цюге: Мен саған қанша қаласаң сонша аяқ киім алғым келеді➡
Dialogue: 0,0:19:09.78,0:19:11.75,Default,,0,0,0,,Мен қауіпті деп ойладым＞
Dialogue: 0,0:19:13.95,0:19:18.35,Default,,0,0,0,,《Кё мен бүгін шаршадым.
Dialogue: 0,0:19:18.35,0:19:21.46,Default,,0,0,0,,Қайта ойланып, көшеде мойындап➡
Dialogue: 0,0:19:21.46,0:19:24.26,Default,,0,0,0,,Не керек, бір-бірін құшақтайды...
Dialogue: 0,0:19:24.26,0:19:26.26,Default,,0,0,0,,Уау! 》
Dialogue: 0,0:19:26.26,0:19:28.66,Default,,0,0,0,,📱
Dialogue: 0,0:19:28.66,0:19:31.43,Default,,0,0,0,,Ах! 📱
Dialogue: 0,0:19:34.10,0:19:37.77,Default,,0,0,0,,Сәлеметсіз бе. 📱Адачи?
Dialogue: 0,0:19:37.77,0:19:41.68,Default,,0,0,0,,📱Түн кеш болғаным үшін кешіріңіз. Мен қайтадан сөйлескім келеді.
Dialogue: 0,0:19:41.68,0:19:45.28,Default,,0,0,0,,Жоқ, бәрі жақсы. Ха….
Dialogue: 0,0:19:45.28,0:19:48.12,Default,,0,0,0,,📱Жақсы. иә?
Dialogue: 0,0:19:48.12,0:19:50.48,Default,,0,0,0,,Адачи де мені ұнатады➡
Dialogue: 0,0:19:50.48,0:19:54.09,Default,,0,0,0,,Түс болған шығар деп ойладым.
Dialogue: 0,0:19:54.09,0:19:56.12,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:19:56.12,0:19:59.93,Default,,0,0,0,,《Куросава, сен қазір қандай екенсің.
Dialogue: 0,0:19:59.93,0:20:03.60,Default,,0,0,0,,Телефондағы дауыс керемет, жүрегімді елжіретеді.
Dialogue: 0,0:20:03.60,0:20:06.77,Default,,0,0,0,,Ой оқи алмағандықтан ба деп ойлаймын.
Dialogue: 0,0:20:06.77,0:20:09.74,Default,,0,0,0,,📱Дұрыс. Хмм, не?
Dialogue: 0,0:20:09.74,0:20:11.94,Default,,0,0,0,,📱Мен көп нәрсе туралы айтқым келеді➡
Dialogue: 0,0:20:11.94,0:20:15.78,Default,,0,0,0,,Демалыс күндері бірге қыдырғыларыңыз келе ме? иә?
Dialogue: 0,0:20:15.78,0:20:19.68,Default,,0,0,0,,📱Мені қалуға рұқсат бергеніңіз үшін әлі алғыс айтқан жоқпын. Иә….
Dialogue: 0,0:20:19.68,0:20:22.08,Default,,0,0,0,,《Рахмет? 》 📱Сосын, орналасқан жері➡
Dialogue: 0,0:20:22.08,0:20:24.52,Default,,0,0,0,,Біз сізбен қайта хабарласамыз.
Dialogue: 0,0:20:24.52,0:20:26.75,Default,,0,0,0,,Қайырлы түн, ертең кездескенше.
Dialogue: 0,0:20:26.75,0:20:29.16,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:20:31.93,0:20:35.76,Default,,0,0,0,,Иә, бұл өте керемет ...
Dialogue: 0,0:20:35.76,0:20:38.60,Default,,0,0,0,,Жүзіңді көрсем де, жүзің ақиқат емес➡
Dialogue: 0,0:20:38.60,0:20:42.27,Default,,0,0,0,,Көре алмасам, көрмегендіктен қобалжыйтынмын.
Dialogue: 0,0:20:42.27,0:20:47.27,Default,,0,0,0,,Дәлірек айтқанда, олар бірге шығу туралы бірдеңе деді...
Dialogue: 0,0:20:47.27,0:20:50.14,Default,,0,0,0,,《Бұл мүмкін бе?➡
Dialogue: 0,0:20:50.14,0:20:54.15,Default,,0,0,0,,Біз оны әдетте кездесу деп атаймыз емес пе? 》
Dialogue: 0,0:20:58.42,0:21:01.32,Default,,0,0,0,,Тынш!
Dialogue: 0,0:21:01.32,0:21:05.59,Default,,0,0,0,,《Соңында! Адачимен кездесу!
Dialogue: 0,0:21:05.59,0:21:09.60,Default,,0,0,0,,Бұл қауіпті. Қиялымда бұл туралы жүздеген...жоқ, мыңдаған рет ойладым➡
Dialogue: 0,0:21:09.60,0:21:13.00,Default,,0,0,0,,Мен кездесуге баратын күн келеді деп ешқашан ойламадым.
Dialogue: 0,0:21:13.00,0:21:16.67,Default,,0,0,0,,Түс сияқты, бірақ... Иә, бұл түс емес.
Dialogue: 0,0:21:16.67,0:21:21.28,Default,,0,0,0,,｟Мен де Куросаваны жақсы көремін! ｠
Dialogue: 0,0:21:21.28,0:21:24.25,Default,,0,0,0,,《Сол байсалды Адачи жұмыстан тайып кетті➡
Dialogue: 0,0:21:24.25,0:21:27.45,Default,,0,0,0,,Сен маған сезіміңді айтуға келдің.
Dialogue: 0,0:21:27.45,0:21:30.65,Default,,0,0,0,,Маған қатты ұнайды. Мен саған алғаш ғашық болған кезімнен➡
Dialogue: 0,0:21:30.65,0:21:34.59,Default,,0,0,0,,Мәңгі. Мен сені одан сайын ұната бастадым.
Dialogue: 0,0:21:34.59,0:21:40.26,Default,,0,0,0,,Ха... Ойланып қарасам, бұл біздің бірінші кездесуіміз ғой, солай ма?
Dialogue: 0,0:21:40.26,0:21:42.93,Default,,0,0,0,,Мен оны ұмытылмас датаға айналдыруым керек》
Dialogue: 0,0:21:42.93,0:21:44.93,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:44.93,0:21:47.90,Default,,0,0,0,,Кездесуге не киюім керек?
Dialogue: 0,0:21:47.90,0:21:50.60,Default,,0,0,0,,Дәлірек айтқанда, дата дегеніміз не?
Dialogue: 0,0:21:50.60,0:21:53.27,Default,,0,0,0,,Жоқ... Жаңа ғана түсіндім➡
Dialogue: 0,0:21:53.27,0:21:56.41,Default,,0,0,0,,Мен не дайындайтынымды білмеймін.
Dialogue: 0,0:21:56.41,0:22:00.25,Default,,0,0,0,,《Мен бәрібір іздеуге тырыстым》
Dialogue: 0,0:22:00.25,0:22:04.12,Default,,0,0,0,,Тәтті, Риа Мицуруның барлық суреттері шығады!
Dialogue: 0,0:22:05.62,0:22:11.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
