Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.13,0:00:06.13,Default,,0,0,0,,Уау! Мен ұйықтап қалдым!
Dialogue: 0,0:00:06.13,0:00:09.61,Default,,0,0,0,,Әй, ұйықтау әдеті, ұйықтау әдеті!
Dialogue: 0,0:00:09.61,0:00:11.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:11.77,0:00:14.44,Default,,0,0,0,,Мен не киюім керек?
Dialogue: 0,0:00:14.44,0:00:16.45,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:00:16.45,0:00:20.15,Default,,0,0,0,,Кейбір керек-жарақтарды алуым керек пе?
Dialogue: 0,0:00:20.15,0:00:23.12,Default,,0,0,0,,Жоқ, менде жоқ!
Dialogue: 0,0:02:05.12,0:02:09.93,Default,,0,0,0,,《Мен әдеттегі киімімді кидім》
Dialogue: 0,0:02:13.13,0:02:15.13,Default,,0,0,0,,《Таң атқанша мүлдем ұйықтай алмадым➡
Dialogue: 0,0:02:15.13,0:02:18.20,Default,,0,0,0,,Сіз шамадан тыс ұйықтап қалған бастауыш сынып оқушысысыз ба?
Dialogue: 0,0:02:23.61,0:02:26.91,Default,,0,0,0,,《Аа~ кешіріңіз》
Dialogue: 0,0:02:29.28,0:02:32.28,Default,,0,0,0,,Кешіріңіз! Күткеніңізге рахмет!
Dialogue: 0,0:02:32.28,0:02:34.58,Default,,0,0,0,,Уа.
Dialogue: 0,0:02:34.58,0:02:38.45,Default,,0,0,0,,Жоқ. Мен де жаңа ғана келдім.
Dialogue: 0,0:02:38.45,0:02:40.46,Default,,0,0,0,,《Уау!
Dialogue: 0,0:02:40.46,0:02:42.62,Default,,0,0,0,,Қандай айырмашылық! Сіз модельсіз бе?
Dialogue: 0,0:02:42.62,0:02:45.26,Default,,0,0,0,,Мен шынымен де кезекте тұрғым келмейді...
Dialogue: 0,0:02:45.26,0:02:49.93,Default,,0,0,0,,А, менің ойымша, мен тым болмаса киінуім керек...》
Dialogue: 0,0:02:49.93,0:02:52.60,Default,,0,0,0,,Менде тағы да нашар ұйықтайтын әдет пайда болды.
Dialogue: 0,0:02:52.60,0:02:56.27,Default,,0,0,0,,《Жеке киім шынымен сүйкімді...
Dialogue: 0,0:02:56.27,0:02:59.94,Default,,0,0,0,,Парка Сәйкес келбетке ұқсайды, сондықтан мен өте қуаныштымын》
Dialogue: 0,0:02:59.94,0:03:02.44,Default,,0,0,0,,《Бұл рас》
Dialogue: 0,0:03:02.44,0:03:05.28,Default,,0,0,0,,Ұйықтау әдеті Таңертең... Мен қатты қобалжыдым...
Dialogue: 0,0:03:05.28,0:03:10.45,Default,,0,0,0,,《Адачи, сенің үнемі бір орында ұйықтайтын әдетің бар. Сүйкімді》
Dialogue: 0,0:03:10.45,0:03:13.76,Default,,0,0,0,,《Бірақ ұйықтау қалпы есімде де жоқ➡
Dialogue: 0,0:03:13.76,0:03:17.59,Default,,0,0,0,,Бұл өте ауыр болуы мүмкін》
Dialogue: 0,0:03:17.59,0:03:19.93,Default,,0,0,0,,Енді бірінші қайда барғың келеді?
Dialogue: 0,0:03:19.93,0:03:24.27,Default,,0,0,0,,Не? Кешіріңіз, мен ештеңе ойламадым ...
Dialogue: 0,0:03:24.27,0:03:26.97,Default,,0,0,0,,Олай болса, бүгін маған қалдыра аласың ба?
Dialogue: 0,0:03:26.97,0:03:30.11,Default,,0,0,0,,Иә. Содан кейін осы жолмен.
Dialogue: 0,0:03:30.11,0:03:32.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:54.76,0:03:56.77,Default,,0,0,0,,Боу!
Dialogue: 0,0:03:56.77,0:03:59.10,Default,,0,0,0,,Уа... не болды?
Dialogue: 0,0:03:59.10,0:04:03.61,Default,,0,0,0,,《Сөзі ақылсыз болса да, әні сондай жақсы! 》
Dialogue: 0,0:04:03.61,0:04:07.01,Default,,0,0,0,,Амансың ба? О, жоқ...
Dialogue: 0,0:04:07.01,0:04:10.15,Default,,0,0,0,,Ку... Куросава сондай сәнді.
Dialogue: 0,0:04:10.15,0:04:14.28,Default,,0,0,0,,Мен солай ойлаймын. Мен... Шынымен не киюім керек?
Dialogue: 0,0:04:14.28,0:04:18.19,Default,,0,0,0,,Мен оны мүлдем түсінбеймін. Сондай сүйкімді...
Dialogue: 0,0:04:18.19,0:04:20.79,Default,,0,0,0,,Адачиге жарасады деп ойлаймын➡
Dialogue: 0,0:04:20.79,0:04:22.96,Default,,0,0,0,,Егер сізді қызықтырса, киімдерді көргіңіз келе ме?
Dialogue: 0,0:04:22.96,0:04:26.80,Default,,0,0,0,,О... Шынымен! ?
Dialogue: 0,0:04:26.80,0:04:30.63,Default,,0,0,0,,Ал, Куросава, үйлестіріңізші!
Dialogue: 0,0:04:30.63,0:04:32.63,Default,,0,0,0,,《I➡
Dialogue: 0,0:04:32.63,0:04:34.60,Default,,0,0,0,,Адачиді үйлестіріңіз! ? 》
Dialogue: 0,0:04:38.61,0:04:43.31,Default,,0,0,0,,｟Адасып қалмаңыз. Екеуі де маған жақсы көрінеді.
Dialogue: 0,0:04:43.31,0:04:45.48,Default,,0,0,0,,Қайсысы да жақсы➡
Dialogue: 0,0:04:45.48,0:04:48.68,Default,,0,0,0,,Оны тез арада Куросаваның түсіне бояңыз.
Dialogue: 0,0:04:51.29,0:04:54.49,Default,,0,0,0,,Тоқтау керек шығар... А-а!
Dialogue: 0,0:04:56.96,0:04:59.13,Default,,0,0,0,,《Күшік…》
Dialogue: 0,0:04:59.13,0:05:01.33,Default,,0,0,0,,Мен сенен бір жақсылық сұраймын.
Dialogue: 0,0:05:01.33,0:05:03.70,Default,,0,0,0,,О! Маған қалдырыңыз!
Dialogue: 0,0:05:05.97,0:05:08.47,Default,,0,0,0,,《О...》
Dialogue: 0,0:05:11.61,0:05:15.28,Default,,0,0,0,,《Мен өзімді орынсыз сезінемін бе? 》
Dialogue: 0,0:05:15.28,0:05:17.78,Default,,0,0,0,,Осыған ұқсас киімдер бар ма?
Dialogue: 0,0:05:17.78,0:05:22.68,Default,,0,0,0,,Ах... Қозғалу оңай, жасыңызға сай болса.
Dialogue: 0,0:05:22.68,0:05:26.29,Default,,0,0,0,,Сонда жеңіл күрте болуы мүмкін бе?
Dialogue: 0,0:05:26.29,0:05:30.29,Default,,0,0,0,,Мұны қайта пайдалануға болады. О.
Dialogue: 0,0:05:30.29,0:05:33.13,Default,,0,0,0,,Әртүрлі түстер де бар.
Dialogue: 0,0:05:33.13,0:05:35.80,Default,,0,0,0,,Мен осы екі киімді киіп көргім келеді...
Dialogue: 0,0:05:35.80,0:05:38.17,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:05:40.77,0:05:43.27,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:43.27,0:05:45.27,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:05:45.27,0:05:49.78,Default,,0,0,0,,Адачи Теріңіз ақшыл және қара теріңіз бар, менің ойымша, бұл сізге керемет көрінеді.
Dialogue: 0,0:05:49.78,0:05:53.82,Default,,0,0,0,,Сонда мен оны осылай киетін шығармын.
Dialogue: 0,0:05:53.82,0:05:56.62,Default,,0,0,0,,《Алайда, күткендей, олар сәнді киімдер.
Dialogue: 0,0:05:56.62,0:05:58.95,Default,,0,0,0,,Әдеттегі сомадан екі есе көп》
Dialogue: 0,0:05:58.95,0:06:00.96,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:00.96,0:06:03.12,Default,,0,0,0,,...
Dialogue: 0,0:06:03.12,0:06:07.10,Default,,0,0,0,,Неге оны сатып алмақшысыз! Жақсы, кәдесый ретінде.
Dialogue: 0,0:06:07.10,0:06:09.30,Default,,0,0,0,,Қандай естелік!
Dialogue: 0,0:06:09.30,0:06:12.67,Default,,0,0,0,,Не?➡
Dialogue: 0,0:06:12.67,0:06:15.77,Default,,0,0,0,,Мен және Адачидің алғашқы кездесуі➡
Dialogue: 0,0:06:15.77,0:06:18.47,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:06:18.47,0:06:21.11,Default,,0,0,0,,《Мен таңдаған киімді киіп алсаң да➡
Dialogue: 0,0:06:21.11,0:06:24.61,Default,,0,0,0,,Себебі мен бақыттымын》
Dialogue: 0,0:06:24.61,0:06:27.42,Default,,0,0,0,,Жоқ! Мен төлеймін!
Dialogue: 0,0:06:30.05,0:06:32.79,Default,,0,0,0,,Картаны пайдаланыңыз. иә.
Dialogue: 0,0:06:32.79,0:06:34.79,Default,,0,0,0,,Тексеру.
Dialogue: 0,0:06:34.79,0:06:37.46,Default,,0,0,0,,《Ер адам киім бергенде➡
Dialogue: 0,0:06:37.46,0:06:41.80,Default,,0,0,0,,Бұл сіздің оны шешкеніңізді қалаймын дегенді білдіреді.
Dialogue: 0,0:06:41.80,0:06:44.63,Default,,0,0,0,,Абайлаңыз, балам》
Dialogue: 0,0:06:44.63,0:06:47.97,Default,,0,0,0,,《Ух... міне дегені осы! ?
Dialogue: 0,0:06:47.97,0:06:50.27,Default,,0,0,0,,Мен оны өзім сатып алғаныма қуаныштымын》
Dialogue: 0,0:06:50.27,0:06:52.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:52.47,0:07:33.32,Default,,0,0,0,,♬～
Dialogue: 0,0:07:33.32,0:07:37.89,Default,,0,0,0,,Кешкі ас Мен теңіз көрінісі бар итальяндық мейрамханаға тапсырыс бердім➡
Dialogue: 0,0:07:37.89,0:07:39.95,Default,,0,0,0,,Түскі асқа жеңіл нәрсе сатып алыңыз.
Dialogue: 0,0:07:39.95,0:07:42.22,Default,,0,0,0,,Жақсы. Маған мұндай нәрсе ұнайды.
Dialogue: 0,0:07:45.59,0:07:48.03,Default,,0,0,0,,Әй, маған сусын сатып ал.
Dialogue: 0,0:07:48.03,0:07:50.77,Default,,0,0,0,,Хмм... Рахмет.
Dialogue: 0,0:07:50.77,0:07:53.64,Default,,0,0,0,,Сіз оны жаңа ғана көрдіңіз бе? Сондай әдемі!
Dialogue: 0,0:07:53.64,0:07:56.77,Default,,0,0,0,,Ах. Мүмкін модель немесе бір нәрсе.
Dialogue: 0,0:07:56.77,0:07:59.94,Default,,0,0,0,,Қайтып келгенде маған хабарласқыңыз келе ме?
Dialogue: 0,0:07:59.94,0:08:03.28,Default,,0,0,0,,《Әдеттегідей таңқаларлық》
Dialogue: 0,0:08:03.28,0:08:07.45,Default,,0,0,0,,Бірақ бұл екеуі дос болуға жақын емес пе еді?
Dialogue: 0,0:08:07.45,0:08:09.95,Default,,0,0,0,,Ерлі-зайыптыларға ұқсайды... Ах.
Dialogue: 0,0:08:09.95,0:08:12.65,Default,,0,0,0,,Жоқ. Ол сәйкес келмейді.
Dialogue: 0,0:08:12.65,0:08:15.29,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:08:15.29,0:08:18.49,Default,,0,0,0,,《Енді ойлап қарасам, ертерек дүкенде...》
Dialogue: 0,0:08:21.46,0:08:25.13,Default,,0,0,0,,《Бір себептермен мен байқадым...》
Dialogue: 0,0:08:25.13,0:08:27.30,Default,,0,0,0,,Күткеніңізге рахмет.
Dialogue: 0,0:08:27.30,0:08:29.27,Default,,0,0,0,,А... Адачи?
Dialogue: 0,0:08:34.48,0:08:37.28,Default,,0,0,0,,Иә? Аа….
Dialogue: 0,0:08:37.28,0:08:41.12,Default,,0,0,0,,Кешіріңіз! Мен... таң қалдым.
Dialogue: 0,0:08:41.12,0:08:43.45,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:43.45,0:08:45.95,Default,,0,0,0,,Кенеттен ұстап алсаңыз, таң қаласыз.
Dialogue: 0,0:08:48.12,0:08:50.96,Default,,0,0,0,,《Иә. Біз➡
Dialogue: 0,0:08:50.96,0:08:54.30,Default,,0,0,0,,Мен бүгін кездесуде болдым.
Dialogue: 0,0:08:54.30,0:08:59.47,Default,,0,0,0,,Қайтадан сөзбен айтсақ, арақашықтықтың дұрыс мағынасы қандай?➡
Dialogue: 0,0:08:59.47,0:09:01.67,Default,,0,0,0,,Түсінікті жоғалту》
Dialogue: 0,0:09:05.64,0:09:09.51,Default,,0,0,0,,《Бұрынғыдай әрекет етуге тырыссам да➡
Dialogue: 0,0:09:09.51,0:09:14.32,Default,,0,0,0,,Куросаваның даусын естігенде жүрегім лүпілдейді...
Dialogue: 0,0:09:14.32,0:09:20.46,Default,,0,0,0,,Мен жай ғана әріптес болған кезге қайта орала алмаймын деп ойлаймын.
Dialogue: 0,0:09:20.46,0:09:23.16,Default,,0,0,0,,Кешкі астың алдында кішкене бірдеңе алғыңыз келе ме?
Dialogue: 0,0:09:29.90,0:09:32.47,Default,,0,0,0,,​​Қайда бара жатырсың?
Dialogue: 0,0:09:32.47,0:09:34.64,Default,,0,0,0,,Кішкене серуендеу.
Dialogue: 0,0:09:38.61,0:09:42.61,Default,,0,0,0,,Не... бұл не! ?
Dialogue: 0,0:09:42.61,0:09:45.78,Default,,0,0,0,,Сонымен серуендеу.
Dialogue: 0,0:09:45.78,0:09:48.95,Default,,0,0,0,,Ол бос.
Dialogue: 0,0:09:48.95,0:09:52.62,Default,,0,0,0,,《Раушан! ? Сізге өте жақсы көрінеді》
Dialogue: 0,0:09:52.62,0:09:56.29,Default,,0,0,0,,Мен кенеттен кешірім сұраймын. Мен жалғыз сөйлескім келді.
Dialogue: 0,0:09:56.29,0:09:58.63,Default,,0,0,0,,《Жоқ, олай емес. Бұл Шоу дәуіріндегі сәнді драма ма?
Dialogue: 0,0:09:58.63,0:10:02.13,Default,,0,0,0,,Бұл жағдай 30 жастағы ер адам үшін оғаш. Шынымды айтсам, тікұшақтар қорқынышты➡
Dialogue: 0,0:10:02.13,0:10:05.27,Default,,0,0,0,,Біріншіден, мен сіздің айтқаныңызды естімеймін! 》
Dialogue: 0,0:10:05.27,0:10:08.44,Default,,0,0,0,,Менімен бірге жүре аласың ба? Иә….
Dialogue: 0,0:10:08.44,0:10:10.44,Default,,0,0,0,,Керемет!
Dialogue: 0,0:10:10.44,0:10:13.91,Default,,0,0,0,,《Қасиетті! Мен жай ғана дұрыс жауап бердім! 》
Dialogue: 0,0:10:16.61,0:10:18.61,Default,,0,0,0,,《Неге...》
Dialogue: 0,0:10:18.61,0:10:22.98,Default,,0,0,0,,📱Ең алдымен Йокогама теңізі мен қаласының түнгі көрінісін тамашалаңыз.
Dialogue: 0,0:10:22.98,0:10:25.69,Default,,0,0,0,,Адачи Мына жаққа қара!
Dialogue: 0,0:10:29.62,0:10:33.43,Default,,0,0,0,,《Уау... биік... қорқынышты...》
Dialogue: 0,0:10:33.43,0:10:35.80,Default,,0,0,0,,Уау! Сенімен бәрі жақсы ма?
Dialogue: 0,0:10:35.80,0:10:37.77,Default,,0,0,0,,А... иә.
Dialogue: 0,0:10:37.77,0:10:42.10,Default,,0,0,0,,Кирей Дана….
Dialogue: 0,0:10:42.10,0:10:44.27,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:10:44.27,0:10:46.44,Default,,0,0,0,,Бүгінгі күн ұнады деп үміттенемін.
Dialogue: 0,0:10:46.44,0:10:50.61,Default,,0,0,0,,Бұл Адачидің бірінші кездесуі.
Dialogue: 0,0:10:50.61,0:10:54.38,Default,,0,0,0,,Маған Адачидің күлкісі ұнайды.
Dialogue: 0,0:10:57.25,0:11:01.12,Default,,0,0,0,,Иә? Куросава...
Dialogue: 0,0:11:01.12,0:11:04.93,Default,,0,0,0,,Кешіріңіз. Бұл менмін➡
Dialogue: 0,0:11:04.93,0:11:09.10,Default,,0,0,0,,Тікұшақ мүмкін емес...
Dialogue: 0,0:11:09.10,0:11:11.10,Default,,0,0,0,,Түсіңіз….
Dialogue: 0,0:11:11.10,0:11:16.97,Default,,0,0,0,,Өтінемін! Өтінемін, қазір түсіріңіз!
Dialogue: 0,0:11:16.97,0:11:20.78,Default,,0,0,0,,《А, мен жасадым...》
Dialogue: 0,0:11:20.78,0:11:23.28,Default,,0,0,0,,Өзіңізді итеріп жібергенім үшін кешіріңіз.
Dialogue: 0,0:11:23.28,0:11:26.92,Default,,0,0,0,,Жоқ, мен жай тауықпын.
Dialogue: 0,0:11:26.92,0:11:30.95,Default,,0,0,0,,Мен оның бұлай шайқалады деп күткен жоқпын...
Dialogue: 0,0:11:30.95,0:11:34.62,Default,,0,0,0,,А... мейрамхана уақыты...
Dialogue: 0,0:11:34.62,0:11:37.29,Default,,0,0,0,,Жарайды, өйткені мен одан бас тарттым.
Dialogue: 0,0:11:37.29,0:11:40.16,Default,,0,0,0,,Адачи: Ауырған сияқты➡
Dialogue: 0,0:11:40.16,0:11:42.13,Default,,0,0,0,,Бүгін үйге қайтайық.
Dialogue: 0,0:12:02.08,0:12:04.25,Default,,0,0,0,,《Куросава бұл➡
Dialogue: 0,0:12:04.25,0:12:07.92,Default,,0,0,0,,Мен кешіксем де, ол мүлдем ашуланбайды➡
Dialogue: 0,0:12:07.92,0:12:11.26,Default,,0,0,0,,Ол әрқашан мейірімді және ақылды болса да...
Dialogue: 0,0:12:11.26,0:12:13.43,Default,,0,0,0,,Мен өзім қобалжыдым➡
Dialogue: 0,0:12:13.43,0:12:15.93,Default,,0,0,0,,Күн жоспарын бізге қалдырыңыз➡
Dialogue: 0,0:12:15.93,0:12:20.10,Default,,0,0,0,,Менің киімім жабысқақ, тіпті қолымды ұстай алмаймын ➡
Dialogue: 0,0:12:20.10,0:12:23.84,Default,,0,0,0,,Бұл сіз көп еңбектенген жоспарларыңызды бұзады...》
Dialogue: 0,0:12:23.84,0:12:27.28,Default,,0,0,0,,｟Бұл пропорционалды емес! Бұл дұрыс! ｠
Dialogue: 0,0:12:27.28,0:12:31.11,Default,,0,0,0,,《Шынымен, бұл мүлдем пропорционалды емес.
Dialogue: 0,0:12:31.11,0:12:34.28,Default,,0,0,0,,Мен Куросавамен кездесіп жүргеніме сене алар емеспін...
Dialogue: 0,0:12:34.28,0:12:37.92,Default,,0,0,0,,《Аа, бұл ең нашар》
Dialogue: 0,0:12:37.92,0:12:42.62,Default,,0,0,0,,《Мен қатты таң қалдым. Бұл соңы》
Dialogue: 0,0:12:42.62,0:12:46.49,Default,,0,0,0,,《Адачидің қорқып кеткенін ешқашан байқамадың➡
Dialogue: 0,0:12:46.49,0:12:48.93,Default,,0,0,0,,Менің ақымақ!
Dialogue: 0,0:12:48.93,0:12:53.60,Default,,0,0,0,,Бұл біздің алғашқы кездесуіміз болса да, біз қатты толқып, қуандық.
Dialogue: 0,0:12:53.60,0:12:57.77,Default,,0,0,0,,Қарсыласыңыздың қарқынын оқи алмау өте жағымсыз.
Dialogue: 0,0:12:57.77,0:13:00.44,Default,,0,0,0,,Мен кеше қатты қобалжыдым, ұйықтай алмадым...》
Dialogue: 0,0:13:04.25,0:13:09.08,Default,,0,0,0,,Бүгінгі күн үшін кешіріңіз. Жоқ, менмін.
Dialogue: 0,0:13:09.08,0:13:11.79,Default,,0,0,0,,Сіз білесіз...
Dialogue: 0,0:13:11.79,0:13:14.92,Default,,0,0,0,,Тұтынушы…. Аа, кешіріңіз.
Dialogue: 0,0:13:14.92,0:13:17.23,Default,,0,0,0,,Олай болса кеңседе кездескенше.
Dialogue: 0,0:13:19.26,0:13:21.43,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:13:21.43,0:13:24.37,Default,,0,0,0,,Ах.
Dialogue: 0,0:13:24.37,0:13:27.57,Default,,0,0,0,,《Куросава да қобалжыды.
Dialogue: 0,0:13:27.57,0:13:30.44,Default,,0,0,0,,Дәл мен сияқты》
Dialogue: 0,0:13:30.44,0:13:33.78,Default,,0,0,0,,Уау, шынымен...?
Dialogue: 0,0:13:33.78,0:13:38.45,Default,,0,0,0,,《Бүгін көңілім көтерілген болар.
Dialogue: 0,0:13:38.45,0:13:41.62,Default,,0,0,0,,Куросава: Ол шынымен қисық болды》
Dialogue: 0,0:13:44.32,0:13:49.62,Default,,0,0,0,,《Мұндай ауыр дауысты естімегеніме көп болған шығар.
Dialogue: 0,0:13:49.62,0:13:52.59,Default,,0,0,0,,Түсіндім, өйткені менде осындай күш бар➡
Dialogue: 0,0:13:52.59,0:13:54.70,Default,,0,0,0,,Мен Куросаваның алаңдайтынына сенімдімін...》
Dialogue: 0,0:13:57.93,0:14:00.44,Default,,0,0,0,,《Мен...бұл жолы мен Куросава боламын➡
Dialogue: 0,0:14:00.44,0:14:03.44,Default,,0,0,0,,Мен өз сезімімді дұрыс жеткізуім керек!
Dialogue: 0,0:14:03.44,0:14:07.61,Default,,0,0,0,,Мен әрқашан ұнатпаймын деп қорқатынмын...
Dialogue: 0,0:14:07.61,0:14:11.51,Default,,0,0,0,,Бірде бәрі жақсы болмаған соң, мен қашуға бел будым➡
Dialogue: 0,0:14:11.51,0:14:15.42,Default,,0,0,0,,Мен өз бетімше адамдармен араласуға тырыспадым.
Dialogue: 0,0:14:15.42,0:14:19.22,Default,,0,0,0,,Бірақ мен Куросаваның ауыртпалығын қалдыра алмаймын.
Dialogue: 0,0:14:21.46,0:14:23.42,Default,,0,0,0,,Аа...
Dialogue: 0,0:14:23.42,0:14:27.13,Default,,0,0,0,,《Куросава тым қатты тырысады және салқын емес➡
Dialogue: 0,0:14:27.13,0:14:29.20,Default,,0,0,0,,Өте сүйкімді болды》
Dialogue: 0,0:14:33.50,0:14:38.41,Default,,0,0,0,,Асахина-сан. Albireo компаниясының жауабына қатысты...
Dialogue: 0,0:14:38.41,0:14:40.94,Default,,0,0,0,,О, дұрыс жерде...
Dialogue: 0,0:14:40.94,0:14:43.78,Default,,0,0,0,,Уау! Не болды, Куросава? ?
Dialogue: 0,0:14:43.78,0:14:47.08,Default,,0,0,0,,Хаха…. Мықты болыңыз.
Dialogue: 0,0:14:47.08,0:14:50.92,Default,,0,0,0,,Альбирео сізге байланысты.
Dialogue: 0,0:14:50.92,0:14:53.59,Default,,0,0,0,,Куросава….
Dialogue: 0,0:14:53.59,0:14:56.26,Default,,0,0,0,,Адачи!
Dialogue: 0,0:14:56.26,0:14:58.73,Default,,0,0,0,,Кешегі күн үшін кешіріңіз.
Dialogue: 0,0:14:58.73,0:15:01.40,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:15:01.40,0:15:03.40,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:15:03.40,0:15:06.10,Default,,0,0,0,,А... иә.
Dialogue: 0,0:15:06.10,0:15:09.10,Default,,0,0,0,,Бұл бүгін➡
Dialogue: 0,0:15:09.10,0:15:11.07,Default,,0,0,0,,Жұмыстан кейін боссыз ба?
Dialogue: 0,0:15:17.91,0:15:20.41,Default,,0,0,0,,《Олар не дейді?
Dialogue: 0,0:15:20.41,0:15:26.09,Default,,0,0,0,,Кешегі күн... Мені тастап кетсе де...》
Dialogue: 0,0:15:26.09,0:15:29.26,Default,,0,0,0,,Келді.
Dialogue: 0,0:15:29.26,0:15:34.23,Default,,0,0,0,,Бүгін «Зомби өлі» фильмінің шығу күні, солай ма? Ах.
Dialogue: 0,0:15:34.23,0:15:37.40,Default,,0,0,0,,《Мен күнмен әлек болғаным сонша, ұмытып қалдым.》
Dialogue: 0,0:15:37.40,0:15:41.27,Default,,0,0,0,,15-том Домилдің басы ұшып кетумен аяқталды➡
Dialogue: 0,0:15:41.27,0:15:45.57,Default,,0,0,0,,Мен ол міндетті түрде өлмейді деп ойлаймын.
Dialogue: 0,0:15:45.57,0:15:49.08,Default,,0,0,0,,Мен түсіндім. Әйтпесе біртүрлі болар еді.
Dialogue: 0,0:15:51.58,0:15:55.25,Default,,0,0,0,,《Жоқ... бұл шынымен қызық.
Dialogue: 0,0:15:55.25,0:15:57.92,Default,,0,0,0,,Бірақ бұл не...》
Dialogue: 0,0:16:05.16,0:16:07.73,Default,,0,0,0,,《Адачи, сен не ойлап тұрсың?》
Dialogue: 0,0:16:09.90,0:16:13.90,Default,,0,0,0,,Бұл дәмді болды. О, жақсы.
Dialogue: 0,0:16:13.90,0:16:17.57,Default,,0,0,0,,Ол жақта арзан әрі дәмді, сондықтан мен көптен бері жиі барып жүрмін➡
Dialogue: 0,0:16:17.57,0:16:19.57,Default,,0,0,0,,Ыңғайлы, солай емес пе?
Dialogue: 0,0:16:19.57,0:16:21.58,Default,,0,0,0,,《Бұл Адачидің тұрақты орны》
Dialogue: 0,0:16:23.74,0:16:25.91,Default,,0,0,0,,Адачи кеше...
Dialogue: 0,0:16:25.91,0:16:28.42,Default,,0,0,0,,Бұл мен➡
Dialogue: 0,0:16:28.42,0:16:30.92,Default,,0,0,0,,Неліктен жұптар кездесуге барады➡
Dialogue: 0,0:16:30.92,0:16:33.92,Default,,0,0,0,,Мен оны мүлдем түсінбедім.
Dialogue: 0,0:16:33.92,0:16:39.63,Default,,0,0,0,,Шынымды айтсам, жарылыңыз! Мен солай ойладым.
Dialogue: 0,0:16:39.63,0:16:43.26,Default,,0,0,0,,Ахаха... Әйтеуір, тітіркендіреді.
Dialogue: 0,0:16:43.26,0:16:45.93,Default,,0,0,0,,《Неге кездесеміз...?
Dialogue: 0,0:16:45.93,0:16:50.10,Default,,0,0,0,,Мен бұл туралы ешқашан ойламаппын.
Dialogue: 0,0:16:50.10,0:16:53.98,Default,,0,0,0,,Мен басқа адамды бақытты ету үшін ұзақ уақыт зерттеумен айналыстым➡
Dialogue: 0,0:16:53.98,0:16:57.41,Default,,0,0,0,,Сондықтан мен бәрі жақсы болып жатыр деп ойладым.
Dialogue: 0,0:16:57.41,0:17:00.08,Default,,0,0,0,,Бірақ соңында маған бәрібір➡
Dialogue: 0,0:17:00.08,0:17:02.58,Default,,0,0,0,,Себебі мен басқа адаммен ештеңе істегім келмеді...》
Dialogue: 0,0:17:05.42,0:17:08.26,Default,,0,0,0,,Мен, кешегі кездесуде➡
Dialogue: 0,0:17:08.26,0:17:10.59,Default,,0,0,0,,Басқалар сіз туралы не ойлайды➡
Dialogue: 0,0:17:10.59,0:17:12.59,Default,,0,0,0,,Мен осыны ғана ойладым.
Dialogue: 0,0:17:14.63,0:17:17.43,Default,,0,0,0,,Бірақ бұл маңызды емес.
Dialogue: 0,0:17:19.77,0:17:25.07,Default,,0,0,0,,Куросава менің көңілімді көтеруге тырысты➡
Dialogue: 0,0:17:25.07,0:17:28.41,Default,,0,0,0,,​​Мен бақытты болдым.
Dialogue: 0,0:17:28.41,0:17:31.78,Default,,0,0,0,,Бірақ... Бірақ?
Dialogue: 0,0:17:31.78,0:17:34.65,Default,,0,0,0,,Бұл жай мен, көңілді емес➡
Dialogue: 0,0:17:34.65,0:17:36.75,Default,,0,0,0,,Куросава да көңілді болуы керек➡
Dialogue: 0,0:17:36.75,0:17:39.25,Default,,0,0,0,,Менің ойымша, танысудың мағынасы жоқ.
Dialogue: 0,0:17:41.76,0:17:44.09,Default,,0,0,0,,Басқа адамдар не ойлайды➡
Dialogue: 0,0:17:44.09,0:17:47.60,Default,,0,0,0,,Сен жақсысың ба, жамансың ба бәрібір...
Dialogue: 0,0:17:47.60,0:17:50.60,Default,,0,0,0,,Мен➡
Dialogue: 0,0:17:50.60,0:17:53.77,Default,,0,0,0,,Мен Куросавамен қызық істегім келеді.
Dialogue: 0,0:17:53.77,0:17:56.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:56.90,0:17:59.61,Default,,0,0,0,,Сонымен бүгінгі кітап дүкені мен изакая?
Dialogue: 0,0:17:59.61,0:18:02.78,Default,,0,0,0,,А... дәл қазір, бізде қандай ортақ нәрсе бар?➡
Dialogue: 0,0:18:02.78,0:18:06.11,Default,,0,0,0,,Менің білетінім осы ғана.
Dialogue: 0,0:18:06.11,0:18:08.15,Default,,0,0,0,,Шағымдарыңыз бар ма?
Dialogue: 0,0:18:08.15,0:18:12.72,Default,,0,0,0,,Жоқ, бұл өте қызық болды.
Dialogue: 0,0:18:12.72,0:18:14.62,Default,,0,0,0,,《Адачи мен туралы➡
Dialogue: 0,0:18:14.62,0:18:18.13,Default,,0,0,0,,Тәжірибе болмағандықтан немесе сол сияқты бірдеңе жоқ дейді.➡
Dialogue: 0,0:18:18.13,0:18:21.20,Default,,0,0,0,,Қашанда жай сөздеріңмен құтқарасың.
Dialogue: 0,0:18:23.60,0:18:27.60,Default,,0,0,0,,《Ол шынымен сиқыршы ма деп ойлаймын.
Dialogue: 0,0:18:27.60,0:18:29.70,Default,,0,0,0,,Не болды...》
Dialogue: 0,0:18:31.94,0:18:35.44,Default,,0,0,0,,《Мен сізді шақыруға батылдық тапқаныма қуаныштымын.》
Dialogue: 0,0:18:35.44,0:18:38.81,Default,,0,0,0,,Мен Адачимен не істегім келеді және қайда барғым келеді➡
Dialogue: 0,0:18:38.81,0:18:40.92,Default,,0,0,0,,Олар өте көп.
Dialogue: 0,0:18:40.92,0:18:44.62,Default,,0,0,0,,Мен осы уақытқа дейін көп армандадым.
Dialogue: 0,0:18:44.62,0:18:46.59,Default,,0,0,0,,《Мен білемін...》
Dialogue: 0,0:18:46.59,0:18:50.99,Default,,0,0,0,,Себебі мен оған тек адасу арқылы жетуге болады деп ойладым...
Dialogue: 0,0:18:50.99,0:18:56.60,Default,,0,0,0,,Бірақ мен бұлай айтқаным үшін Адачи мені жек көреді деп қорықтым.
Dialogue: 0,0:18:56.60,0:18:58.60,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:18:58.60,0:19:01.44,Default,,0,0,0,,Сіз айтқаныңыздан қайтпайсыз ба? Мазмұнына байланысты.
Dialogue: 0,0:19:01.44,0:19:04.74,Default,,0,0,0,,Иә. Аа….
Dialogue: 0,0:19:04.74,0:19:08.91,Default,,0,0,0,,Жарайды... бұл бірден мүмкін емес, бірақ➡
Dialogue: 0,0:19:08.91,0:19:11.58,Default,,0,0,0,,Ей, мен де барын саламын.
Dialogue: 0,0:19:11.58,0:19:15.42,Default,,0,0,0,,Иә! Әй, жүр!
Dialogue: 0,0:19:15.42,0:19:21.49,Default,,0,0,0,,Бұдан былай екеуміздің арамызда шешім қабылдайық...
Dialogue: 0,0:19:21.49,0:19:25.06,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:25.06,0:19:29.40,Default,,0,0,0,,Ой…. Қауіп!
Dialogue: 0,0:19:29.40,0:19:31.77,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:19:31.77,0:19:35.40,Default,,0,0,0,,Сіз массыз ба? Ой... ой.
Dialogue: 0,0:19:35.40,0:19:38.41,Default,,0,0,0,,Рахмет. Мен аздап іштім.
Dialogue: 0,0:19:44.58,0:19:46.55,Default,,0,0,0,,《Аа...》
Dialogue: 0,0:19:49.75,0:19:53.42,Default,,0,0,0,,《Иә, мен айттым》
Dialogue: 0,0:19:53.42,0:19:55.69,Default,,0,0,0,,Абайлаңыз.
Dialogue: 0,0:20:05.60,0:20:07.57,Default,,0,0,0,,Станцияға.
Dialogue: 0,0:20:10.57,0:20:12.67,Default,,0,0,0,,《Иә!》
Dialogue: 0,0:20:16.91,0:20:21.08,Default,,0,0,0,,《Мен енді сенің айтқаныңды ести алмаймын.
Dialogue: 0,0:20:21.08,0:20:24.92,Default,,0,0,0,,Жақсы, жарайды》
Dialogue: 0,0:20:24.92,0:20:27.76,Default,,0,0,0,,Аа, бүгін толық ай бар.
Dialogue: 0,0:20:27.76,0:20:29.72,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,0:20:32.59,0:20:36.63,Default,,0,0,0,,《``Ай әдемі ғой, солай емес пе?'' - алып кететін желі➡
Dialogue: 0,0:20:36.63,0:20:38.67,Default,,0,0,0,,Мен Адачиге хабарлаймын деп ойламаймын.
Dialogue: 0,0:20:38.67,0:20:42.24,Default,,0,0,0,,Жоқ, мен білетінім осы ғана. иә?
Dialogue: 0,0:20:42.24,0:20:45.41,Default,,0,0,0,,《Мен жаңа ғана айттым ба? ? 》
Dialogue: 0,0:20:45.41,0:20:48.41,Default,,0,0,0,,《Жоқ, мен абайсызда болдым! 》
Dialogue: 0,0:20:48.41,0:20:51.08,Default,,0,0,0,,Куросава: Сен тым көп іштің!
Dialogue: 0,0:20:51.08,0:20:53.08,Default,,0,0,0,,Мұның бәрі сіздің аузыңызда!
Dialogue: 0,0:20:53.08,0:20:56.45,Default,,0,0,0,,көремін. Мүмкін мен көп ішкен шығармын.
Dialogue: 0,0:20:56.45,0:20:58.52,Default,,0,0,0,,《Аа….
Dialogue: 0,0:20:58.52,0:21:01.59,Default,,0,0,0,,Бұл қауіпті. Соңғы кездері жүрегімді тым көп тыңдап жүрмін➡
Dialogue: 0,0:21:01.59,0:21:04.93,Default,,0,0,0,,Біз қалыпты сөйлестік》
Dialogue: 0,0:21:04.93,0:21:07.93,Default,,0,0,0,,《Ойымды оқыдым деп ойладым➡
Dialogue: 0,0:21:07.93,0:21:10.83,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:21:10.83,0:21:13.23,Default,,0,0,0,,《Дұрыс》
Dialogue: 0,0:21:13.23,0:21:16.44,Default,,0,0,0,,《Оқылған болса, мен...》
Dialogue: 0,0:21:16.44,0:21:18.41,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:21:18.41,0:21:21.58,Default,,0,0,0,,Кешіріңіз... кешіріңіз! Алтыбұрышқа ұқсайтын нәрсені табыңыз!
Dialogue: 0,0:21:21.58,0:21:23.91,Default,,0,0,0,,А... қайда, қайда? иә?
Dialogue: 0,0:21:23.91,0:21:26.95,Default,,0,0,0,,Бұл дұрыс емес адам ба? Хаха….
Dialogue: 0,0:21:26.95,0:21:30.42,Default,,0,0,0,,《Егер мен болсам, мен оны жек көретін едім және маған тиіскім келмейді.》
Dialogue: 0,0:21:32.52,0:21:34.69,Default,,0,0,0,,《Куросава да...》
Dialogue: 0,0:21:36.76,0:21:40.13,Default,,0,0,0,,Не болды? Өзіңізді нашар сезіндіңіз бе?
Dialogue: 0,0:21:40.13,0:21:42.43,Default,,0,0,0,,Жоқ, жақсы...
Dialogue: 0,0:21:45.43,0:21:48.80,Default,,0,0,0,,《Танысуды жасырын ұстау➡
Dialogue: 0,0:21:48.80,0:21:51.27,Default,,0,0,0,,Бұл шынымен жақсы ма?》
Dialogue: 0,0:21:54.07,0:21:56.74,Default,,0,0,0,,《Куросава….
Dialogue: 0,0:21:56.74,0:22:00.11,Default,,0,0,0,,Егер мен сізге сиқыршы болғанымды айтсам➡
Dialogue: 0,0:22:00.11,0:22:02.08,Default,,0,0,0,,Не істеу керек? 》
Dialogue: 0,0:22:03.58,0:22:09.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
