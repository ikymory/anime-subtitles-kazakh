Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.17,0:00:11.34,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:11.34,0:00:16.21,Default,,0,0,0,,《Адачи: Дарий. Неліктен қоғамдық жиында караоке бар?
Dialogue: 0,0:00:16.21,0:00:18.28,Default,,0,0,0,,Жақында аяқталады деп үміттенемін》
Dialogue: 0,0:00:23.32,0:00:25.49,Default,,0,0,0,,《Танымал болу өте қиын》
Dialogue: 0,0:00:25.49,0:00:28.66,Default,,0,0,0,,Әне~? Ана жерде! иә?
Dialogue: 0,0:00:28.66,0:00:30.83,Default,,0,0,0,,Онда ешкім жоқ, солай ма?
Dialogue: 0,0:00:30.83,0:00:34.20,Default,,0,0,0,,《Геһ, жаңа түлек алтыбұрыш》
Dialogue: 0,0:02:17.10,0:02:19.30,Default,,0,0,0,,Адачи мырза, сіз осындай жерде болдыңыз ба?
Dialogue: 0,0:02:19.30,0:02:22.64,Default,,0,0,0,,Міне болды. Аураның аз болғаны сонша, мен байқамай қалдым.
Dialogue: 0,0:02:22.64,0:02:25.44,Default,,0,0,0,,《Мен бұл жігітті ұнатпаймын, себебі ол өте күлкілі.》
Dialogue: 0,0:02:25.44,0:02:28.11,Default,,0,0,0,,Кешіріңіз көрші. Ах.
Dialogue: 0,0:02:28.11,0:02:30.11,Default,,0,0,0,,《Неге отырсың! ? "Ой!
Dialogue: 0,0:02:30.11,0:02:32.28,Default,,0,0,0,,Одан да қызық болайық!
Dialogue: 0,0:02:32.28,0:02:36.12,Default,,0,0,0,,《Уф, ішім ауырып тұр... Мен аздап ішіп алған шығармын.
Dialogue: 0,0:02:36.12,0:02:38.95,Default,,0,0,0,,Бірақ мен оны жандандыруым керек! 》
Dialogue: 0,0:02:38.95,0:02:40.96,Default,,0,0,0,,《Бұл жігіт...》
Dialogue: 0,0:02:43.79,0:02:47.63,Default,,0,0,0,,Не? Анзай мырза. Адачи.
Dialogue: 0,0:02:47.63,0:02:50.10,Default,,0,0,0,,Сіз аздап көп ішкен боларсыз.
Dialogue: 0,0:02:50.10,0:02:52.47,Default,,0,0,0,,Оны мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:02:52.47,0:02:56.61,Default,,0,0,0,,Иә? Неліктен сізде бұл бар?
Dialogue: 0,0:02:56.61,0:02:59.44,Default,,0,0,0,,Мен де көп ішетін емеспін.
Dialogue: 0,0:02:59.44,0:03:01.94,Default,,0,0,0,,Кез келген жағдайда.
Dialogue: 0,0:03:01.94,0:03:04.85,Default,,0,0,0,,Аа... бұл ұят.
Dialogue: 0,0:03:04.85,0:03:07.15,Default,,0,0,0,,Сіз өте мұқият екенсіз, Андо-сан.
Dialogue: 0,0:03:07.15,0:03:11.02,Default,,0,0,0,,Бұл Адачи. Сондықтан оны қабылдаңыз ...
Dialogue: 0,0:03:11.02,0:03:14.06,Default,,0,0,0,,Күте тұрыңыз! иә? Бұл алкоголь!
Dialogue: 0,0:03:14.06,0:03:17.09,Default,,0,0,0,,Не? Суды көп ішіңіз.
Dialogue: 0,0:03:17.09,0:03:20.63,Default,,0,0,0,,Сәлем! Сіз шынымен мейірімдісіз!
Dialogue: 0,0:03:20.63,0:03:23.50,Default,,0,0,0,,Аа, ол төгіліп жатыр.
Dialogue: 0,0:03:23.50,0:03:26.33,Default,,0,0,0,,Қараңызшы, бұл сізге арналған. Таку….
Dialogue: 0,0:03:26.33,0:03:29.67,Default,,0,0,0,,Кешіріңіз. Азассу Ясуно-сан.
Dialogue: 0,0:03:29.67,0:03:32.51,Default,,0,0,0,,Адачи... Сіз мұны әдейі істеп жатқан боларсыз!
Dialogue: 0,0:03:32.51,0:03:35.31,Default,,0,0,0,,Иә? Бұл не? (Куросава) Кешіріңіз.
Dialogue: 0,0:03:38.65,0:03:41.12,Default,,0,0,0,,Куросава мырза, не болды?
Dialogue: 0,0:03:41.12,0:03:45.15,Default,,0,0,0,,《Ей, сенің көзқарасың мен болған кездегіден басқаша.》
Dialogue: 0,0:03:45.15,0:03:47.96,Default,,0,0,0,,Менің қасымдағы бала алтыбұрышқа қызығатын сияқты...
Dialogue: 0,0:03:47.96,0:03:51.46,Default,,0,0,0,,Иә! Шынайы ма? Қаласаң барамын.
Dialogue: 0,0:03:51.46,0:03:53.63,Default,,0,0,0,,Қалай болғанда да! Ой!
Dialogue: 0,0:03:56.60,0:03:59.43,Default,,0,0,0,,Иә? Сәлем көрші үй.
Dialogue: 0,0:03:59.43,0:04:01.44,Default,,0,0,0,,《Жоқ, жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:04:01.44,0:04:05.27,Default,,0,0,0,,Менің ойымша, бұл балалар алтыбұрыштар туралы ойламайды.
Dialogue: 0,0:04:05.27,0:04:08.28,Default,,0,0,0,,Жоқ, бірақ бұл жігіт туралы➡
Dialogue: 0,0:04:08.28,0:04:10.78,Default,,0,0,0,,Бұл өте мейірімді...
Dialogue: 0,0:04:10.78,0:04:12.78,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:04:12.78,0:04:15.28,Default,,0,0,0,,Иә, оны түрту арқылы білуге болады.
Dialogue: 0,0:04:18.29,0:04:20.32,Default,,0,0,0,,《Жоқ, мен мұны қалай істей аламын?➡
Dialogue: 0,0:04:20.32,0:04:22.46,Default,,0,0,0,,Оған қол тигізсеңіз болғаны.
Dialogue: 0,0:04:22.46,0:04:24.63,Default,,0,0,0,,Эй, қал...》
Dialogue: 0,0:04:24.63,0:04:26.96,Default,,0,0,0,,Енді ойлап қарасам, бүгін... Әй!
Dialogue: 0,0:04:26.96,0:04:29.00,Default,,0,0,0,,Не?
Dialogue: 0,0:04:29.00,0:04:31.70,Default,,0,0,0,,《Жақын қалды! Мүмкін емес. Сіз күдікті адамсыз.
Dialogue: 0,0:04:33.60,0:04:35.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:35.77,0:04:39.17,Default,,0,0,0,,♬ «Бақытты аяқталу жолында»
Dialogue: 0,0:04:39.17,0:04:42.78,Default,,0,0,0,,Куросава-кун ән айтпай ма? Мен кішкене...
Dialogue: 0,0:04:42.78,0:04:45.31,Default,,0,0,0,,《Бұл ән айтпайды.
Dialogue: 0,0:04:45.31,0:04:48.45,Default,,0,0,0,,Ол кез келген нәрсенің қолынан келетін, тіпті караокеде де жеңіл жүретін жігіт➡
Dialogue: 0,0:04:48.45,0:04:50.62,Default,,0,0,0,,Мен ойладым... Ха.
Dialogue: 0,0:04:50.62,0:04:53.46,Default,,0,0,0,,Егер саңырау болсаң! ? Эх➡
Dialogue: 0,0:04:53.46,0:04:56.02,Default,,0,0,0,,Бұл бет-әлпеті бар адамның саңырау болғаны өте күлкілі.
Dialogue: 0,0:04:56.02,0:04:58.06,Default,,0,0,0,,Мен оны қатты естігім келеді》 Яй!
Dialogue: 0,0:04:58.06,0:05:00.93,Default,,0,0,0,,Сізге көп рахмет! (қуаныш)
Dialogue: 0,0:05:00.93,0:05:04.63,Default,,0,0,0,,Алтыбұрыш Өте дәмді болды. Ах.
Dialogue: 0,0:05:04.63,0:05:07.64,Default,,0,0,0,,Кешіріңіз. Маған да жарайды ма?
Dialogue: 0,0:05:07.64,0:05:09.91,Default,,0,0,0,,Уа. ⚟ Байқап көріңіз! иә?
Dialogue: 0,0:05:15.81,0:05:17.78,Default,,0,0,0,,《О. Бұл ән➡
Dialogue: 0,0:05:17.78,0:05:21.78,Default,,0,0,0,,Бұл қиын сияқты, бірақ жақсы ма? 》
Dialogue: 0,0:05:21.78,0:05:27.16,Default,,0,0,0,,♬ «Бұл жерде мен қарсы тұра алмайтын сезім бар».
Dialogue: 0,0:05:27.16,0:05:33.33,Default,,0,0,0,,♬ «Суретті аспан сияқты махаббат бар».
Dialogue: 0,0:05:33.33,0:05:35.96,Default,,0,0,0,,Бұл қауіпті. Ikebo сатуы Куросава Сенпайдың ➡
Dialogue: 0,0:05:35.96,0:05:40.14,Default,,0,0,0,,Аңызға айналған ән дауысын естігенде қатты әсер еттім.
Dialogue: 0,0:05:40.14,0:05:42.34,Default,,0,0,0,,《Кемел адам...》
Dialogue: 0,0:05:42.34,0:05:46.21,Default,,0,0,0,,♬ «Бұл сезім жоғалды»
Dialogue: 0,0:05:46.21,0:05:48.31,Default,,0,0,0,,《Бұл мені тітіркендіреді》 ♬ “Себебі ол тоқтамайды.”
Dialogue: 0,0:05:51.48,0:05:53.98,Default,,0,0,0,,《Қашанға дейін жаныңда боламын?》
Dialogue: 0,0:05:53.98,0:05:57.19,Default,,0,0,0,,Адачи Бұл пицца өте жақсы. иә?
Dialogue: 0,0:05:59.79,0:06:02.69,Default,,0,0,0,,《Бұл рас》 ⚟Мистер. Куросава.
Dialogue: 0,0:06:02.69,0:06:04.99,Default,,0,0,0,,Көршіңіз жақсы ма?
Dialogue: 0,0:06:04.99,0:06:06.96,Default,,0,0,0,,《Уф! Бір нәрсе келді! 》
Dialogue: 0,0:06:09.63,0:06:12.50,Default,,0,0,0,,《Мазасыздық. Бұл жігіт неге мұндай➡
Dialogue: 0,0:06:12.50,0:06:15.80,Default,,0,0,0,,Куросава-санның қасында》《Қорқынышты! 》
Dialogue: 0,0:06:15.80,0:06:19.14,Default,,0,0,0,,Мен... Мен сонда барып ішейін. Адачи...
Dialogue: 0,0:06:19.14,0:06:21.31,Default,,0,0,0,,Куросава-кун, сен ішіп тұрсың ба?
Dialogue: 0,0:06:21.31,0:06:23.28,Default,,0,0,0,,А, иә.
Dialogue: 0,0:06:25.81,0:06:28.98,Default,,0,0,0,,《Бұл жігіт неге мұндай?
Dialogue: 0,0:06:28.98,0:06:31.82,Default,,0,0,0,,Бұл, әрине, дұрыс.
Dialogue: 0,0:06:31.82,0:06:34.49,Default,,0,0,0,,Неліктен осындай әдемі жігіт мені таңдайды...?
Dialogue: 0,0:06:36.86,0:06:38.96,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:06:38.96,0:06:41.13,Default,,0,0,0,,《Жоқ. Мен ессіз қалған шығармын》
Dialogue: 0,0:06:41.13,0:06:43.13,Default,,0,0,0,,《Мистер Фудзисаки кеңседен》
Dialogue: 0,0:06:43.13,0:06:46.30,Default,,0,0,0,,Жоқ, қош келдіңіз. үшінна қосымша тапсырыс➡
Dialogue: 0,0:06:46.30,0:06:49.97,Default,,0,0,0,,Мен сенен сұраймын, Адачи-сан, саған да бірдеңе керек пе?
Dialogue: 0,0:06:49.97,0:06:53.48,Default,,0,0,0,,Иә? Мен мұны әрқайсымыз өзіміз жасай алсақ екен.
Dialogue: 0,0:06:53.48,0:06:56.65,Default,,0,0,0,,Хехе. Өйткені менің де ішкім келеді➡
Dialogue: 0,0:06:56.65,0:06:59.48,Default,,0,0,0,,Айтпақшы, бұл барлығына арналған деп айтып отырмын.
Dialogue: 0,0:06:59.48,0:07:02.78,Default,,0,0,0,,Солай ма? Ал, улонг шай ішейік.
Dialogue: 0,0:07:02.78,0:07:05.62,Default,,0,0,0,,Иә, бұл оолонг шайы.
Dialogue: 0,0:07:05.62,0:07:09.19,Default,,0,0,0,,《Мен сенің жақсы адам екеніңді байқадым➡
Dialogue: 0,0:07:09.19,0:07:11.76,Default,,0,0,0,,Сіз өте мейірімдісіз.
Dialogue: 0,0:07:11.76,0:07:14.00,Default,,0,0,0,,Мен... Мен бір сәт ваннаға барамын.
Dialogue: 0,0:07:14.00,0:07:16.26,Default,,0,0,0,,А, иә.
Dialogue: 0,0:07:18.47,0:07:21.37,Default,,0,0,0,,《Егер ол қыз мені ұнатса...
Dialogue: 0,0:07:21.37,0:07:25.14,Default,,0,0,0,,Мұндай ыңғайлы нәрсе болуы мүмкін емес.
Dialogue: 0,0:07:25.14,0:07:28.81,Default,,0,0,0,,Андо-сан! Мен соңғы кездері сауналарға құмар болдым!
Dialogue: 0,0:07:28.81,0:07:30.81,Default,,0,0,0,,Келесі жолы бірге не істеуіміз керек?
Dialogue: 0,0:07:30.81,0:07:33.68,Default,,0,0,0,,Сонымен Адачи.
Dialogue: 0,0:07:33.68,0:07:37.75,Default,,0,0,0,,《Аа... Мен мұндай кештерді ішкенді ұнатпаймын.》
Dialogue: 0,0:07:37.75,0:07:40.66,Default,,0,0,0,,⚟Кішкене болса да жақсы. (Фудзисаки) Өтінемін, тоқтатыңыз.
Dialogue: 0,0:07:40.66,0:07:43.16,Default,,0,0,0,,Маған соқтығысқан сол болды.
Dialogue: 0,0:07:43.16,0:07:46.33,Default,,0,0,0,,А, кешіріңіз. Бірге ән айтайық.
Dialogue: 0,0:07:46.33,0:07:48.73,Default,,0,0,0,,《Мм? 》 Әй, Адачи-сан!
Dialogue: 0,0:07:51.00,0:07:53.64,Default,,0,0,0,,Ах. 《Фудзисаки: Маған көмектесші...》
Dialogue: 0,0:07:53.64,0:07:56.14,Default,,0,0,0,,《Не! ? « Не? сен.
Dialogue: 0,0:07:56.14,0:08:00.04,Default,,0,0,0,,《Уау, мас сияқтысың!
Dialogue: 0,0:08:00.04,0:08:03.08,Default,,0,0,0,,Қорқынышты, мүмкін емес!
Dialogue: 0,0:08:03.08,0:08:07.18,Default,,0,0,0,,Бірақ бұл жерден қашсаң, еркек емессің.
Dialogue: 0,0:08:07.18,0:08:09.82,Default,,0,0,0,,Оған ұнамайды➡
Dialogue: 0,0:08:09.82,0:08:12.99,Default,,0,0,0,,Тоқтата аласыз ба?
Dialogue: 0,0:08:12.99,0:08:16.16,Default,,0,0,0,,Уф! Ах! ? Оның саған қатысы жоқ!
Dialogue: 0,0:08:16.16,0:08:18.33,Default,,0,0,0,,Деде деде... Бірақ! Оны мәжбүрлеме➡
Dialogue: 0,0:08:18.33,0:08:20.83,Default,,0,0,0,,Менің ойымша, бұл жақсы емес! Шулы!
Dialogue: 0,0:08:20.83,0:08:23.20,Default,,0,0,0,,Мақтаншақ болмаңдар!
Dialogue: 0,0:08:23.20,0:08:25.23,Default,,0,0,0,,《Сәлеметсіз бе! Күткендей➡
Dialogue: 0,0:08:25.23,0:08:27.77,Default,,0,0,0,,Өзің үйренбеген іспен айналыспа! 》
Dialogue: 0,0:08:27.77,0:08:29.97,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:29.97,0:08:33.48,Default,,0,0,0,,《Адачиге тиіспе! 》
Dialogue: 0,0:08:33.48,0:08:35.68,Default,,0,0,0,,《Куросава! ? 》
Dialogue: 0,0:08:35.68,0:08:37.95,Default,,0,0,0,,Уф, сен несің...?
Dialogue: 0,0:08:40.35,0:08:43.82,Default,,0,0,0,,Эй, сен Narasaki корпорациясынансың ба?
Dialogue: 0,0:08:43.82,0:08:45.82,Default,,0,0,0,,Уф. Бір-бірімен➡
Dialogue: 0,0:08:45.82,0:08:49.32,Default,,0,0,0,,Қанатымды созуға келдім➡
Dialogue: 0,0:08:49.32,0:08:52.99,Default,,0,0,0,,Сіз әзілдеріңізді шектей аласыз ба?
Dialogue: 0,0:08:52.99,0:08:55.90,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:08:55.90,0:08:59.47,Default,,0,0,0,,Иә. кешіріңіз! Көмегіңіз үшін рақмет.
Dialogue: 0,0:08:59.47,0:09:02.80,Default,,0,0,0,,Жоқ, менде ештеңе жоқ...
Dialogue: 0,0:09:02.80,0:09:05.67,Default,,0,0,0,,Бұл апат болды. Сенімен бәрі жақсы ма?
Dialogue: 0,0:09:05.67,0:09:07.98,Default,,0,0,0,,А, иә.
Dialogue: 0,0:09:07.98,0:09:09.98,Default,,0,0,0,,《Ой》
Dialogue: 0,0:09:09.98,0:09:13.18,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:09:13.18,0:09:17.15,Default,,0,0,0,,《Күрделі…. Көмек алдым ➡
Dialogue: 0,0:09:17.15,0:09:19.99,Default,,0,0,0,,Ештеңе істей алмаған менімен ➡
Dialogue: 0,0:09:19.99,0:09:24.36,Default,,0,0,0,,Куросава не істесе де жақсы көрінеді.
Dialogue: 0,0:09:24.36,0:09:28.00,Default,,0,0,0,,Мен ренжідім, өйткені менде бос орын бар.
Dialogue: 0,0:09:28.00,0:09:30.00,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:09:30.00,0:09:32.83,Default,,0,0,0,,Адачи: Өйткені сен ауырып қалдың➡
Dialogue: 0,0:09:32.83,0:09:35.30,Default,,0,0,0,,Жарайды ма екен... А?
Dialogue: 0,0:09:35.30,0:09:37.34,Default,,0,0,0,,Адачи мен ренжідім.
Dialogue: 0,0:09:37.34,0:09:39.47,Default,,0,0,0,,А, қайда? Мұнда.
Dialogue: 0,0:09:39.47,0:09:44.15,Default,,0,0,0,,Иә? Менің галстугымды біреу тартып алғанда, тырнақтарыммен тырнап алдым деп ойлаймын.
Dialogue: 0,0:09:44.15,0:09:46.21,Default,,0,0,0,,Бір минут күтіңіз. Әмиянымда шығар...
Dialogue: 0,0:09:49.82,0:09:53.29,Default,,0,0,0,,Иә. О, ой.
Dialogue: 0,0:09:53.29,0:09:55.32,Default,,0,0,0,,《Дайын》
Dialogue: 0,0:09:55.32,0:09:58.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:58.29,0:10:01.13,Default,,0,0,0,,Хмм? иә?
Dialogue: 0,0:10:01.13,0:10:04.80,Default,,0,0,0,,Қарыз беру. Ах.
Dialogue: 0,0:10:04.80,0:10:08.47,Default,,0,0,0,,《Сіз сәтсіздікке ұшырадыңыз...》 《Не? 》
Dialogue: 0,0:10:08.47,0:10:12.47,Default,,0,0,0,,《Мен сені бұл жерге не болса да қуамын➡
Dialogue: 0,0:10:12.47,0:10:17.15,Default,,0,0,0,,Орындарды ауыстырыңыз, караокеде бір-бірімен жарысыңыз...
Dialogue: 0,0:10:17.15,0:10:21.12,Default,,0,0,0,,Сіз мұны күшті деп атауға болады, бірақ тіпті Адачи кері шегінді.
Dialogue: 0,0:10:21.12,0:10:23.52,Default,,0,0,0,,《Әлде шегерілгенін айту керек пе...》
Dialogue: 0,0:10:23.52,0:10:28.92,Default,,0,0,0,,《Шынымен де, Адачиге келгенде менің қолымнан келмейді...
Dialogue: 0,0:10:28.92,0:10:31.96,Default,,0,0,0,,Роккаку мен Фудзисакиді қалай қызғануға болады?
Dialogue: 0,0:10:31.96,0:10:35.36,Default,,0,0,0,,《Не? Апыр-ай! ?
Dialogue: 0,0:10:35.36,0:10:37.37,Default,,0,0,0,,Роккаку мен Фудзисаки-санның маған еш қатысы жоқ➡
Dialogue: 0,0:10:37.37,0:10:39.67,Default,,0,0,0,,Олай ойлама! ? 》
Dialogue: 0,0:10:39.67,0:10:44.14,Default,,0,0,0,,《Аа, мен өзімнің соншалықты тар ойлы болғаныма сене алар емеспін➡
Dialogue: 0,0:10:44.14,0:10:46.11,Default,,0,0,0,,Мен білмедім》
Dialogue: 0,0:10:51.68,0:10:53.65,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:10:57.82,0:11:00.46,Default,,0,0,0,,《Куросава туралы осы уақытқа дейін➡
Dialogue: 0,0:11:00.46,0:11:05.13,Default,,0,0,0,,Мен оны мінсіз және әрқашан уақыты көп деп ойладым.
Dialogue: 0,0:11:05.13,0:11:08.03,Default,,0,0,0,,Бірақ олай емес➡
Dialogue: 0,0:11:08.03,0:11:11.63,Default,,0,0,0,,Мен уайымдап, қобалжыдым.
Dialogue: 0,0:11:11.63,0:11:13.97,Default,,0,0,0,,Дәл мен сияқты》
Dialogue: 0,0:11:13.97,0:11:16.30,Default,,0,0,0,,Бұл қауіпті...
Dialogue: 0,0:11:16.30,0:11:20.48,Default,,0,0,0,,Біз де қайтамыз ба? Ах, ах.
Dialogue: 0,0:11:20.48,0:11:22.48,Default,,0,0,0,,《Бұл кішкене сүйкімді шығар➡\NМен
Dialogue: 0,0:11:22.48,0:11:24.48,Default,,0,0,0,,》 сияқты нәрсе ойладым.
Dialogue: 0,0:11:24.48,0:11:27.82,Default,,0,0,0,,Куросава! иә?
Dialogue: 0,0:11:27.82,0:11:29.98,Default,,0,0,0,,Бұл….
Dialogue: 0,0:11:29.98,0:11:31.99,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:11:34.66,0:11:37.23,Default,,0,0,0,,Әй, бұл асыра сілтеу.
Dialogue: 0,0:11:39.29,0:11:41.96,Default,,0,0,0,,《Тіпті ұстамай-ақ айта аласыз.
Dialogue: 0,0:11:41.96,0:11:43.97,Default,,0,0,0,,Бақытты көрінеді》
Dialogue: 0,0:11:43.97,0:11:46.47,Default,,0,0,0,,Эй, балмұздақ жегің келе ме?
Dialogue: 0,0:11:46.47,0:11:48.97,Default,,0,0,0,,О. Біз жасырын тамақтанамыз ба?
Dialogue: 0,0:11:48.97,0:11:51.14,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:01.12,0:12:04.02,Default,,0,0,0,,Сауна өте жақсы. Өтінемін, менімен бірге жүріңіз➡
Dialogue: 0,0:12:04.02,0:12:07.59,Default,,0,0,0,,Мен өте қуаныштымын! Демалыс күндері жұмыс➡
Dialogue: 0,0:12:07.59,0:12:09.96,Default,,0,0,0,,Ерте тұрсам ғой.
Dialogue: 0,0:12:09.96,0:12:12.43,Default,,0,0,0,,Ал, мен тегін билет алдым!
Dialogue: 0,0:12:12.43,0:12:15.10,Default,,0,0,0,,Емделейік!
Dialogue: 0,0:12:15.10,0:12:18.43,Default,,0,0,0,,Уау! Куросава-сан, сенің денең керемет.
Dialogue: 0,0:12:18.43,0:12:20.77,Default,,0,0,0,,《Үлгіге қараңыз》 Шынымен бе?
Dialogue: 0,0:12:20.77,0:12:22.80,Default,,0,0,0,,Сіз қандай да бір спорт түрімен айналысасыз ба?
Dialogue: 0,0:12:22.80,0:12:25.94,Default,,0,0,0,,Кез келген жағдайда спортзалға барыңыз. Қазірдің өзінде 30➡
Dialogue: 0,0:12:25.94,0:12:29.14,Default,,0,0,0,,Сіздің денсаулығыңыз үшін. Шынайы ма? Мен де...
Dialogue: 0,0:12:29.14,0:12:33.11,Default,,0,0,0,,《О, Құдайым... Бұл күн кез келген уақытта келеді деп үміттенемін➡
Dialogue: 0,0:12:33.11,0:12:35.95,Default,,0,0,0,,Сіз бұлшық еттерді жаттықтыруда көп жұмыс жасадыңыз, солай емес пе?
Dialogue: 0,0:12:35.95,0:12:38.65,Default,,0,0,0,,Өйткені Адачидің денесі шала➡
Dialogue: 0,0:12:38.65,0:12:40.62,Default,,0,0,0,,Мен оны көрсеткім келмейді.
Dialogue: 0,0:12:43.63,0:12:47.30,Default,,0,0,0,,《Ал, Адачи менің денемді қызықтырмайды➡
Dialogue: 0,0:12:47.30,0:12:49.50,Default,,0,0,0,,түсіндім》
Dialogue: 0,0:12:52.70,0:12:55.47,Default,,0,0,0,,Уф….
Dialogue: 0,0:12:55.47,0:12:59.47,Default,,0,0,0,,《Мен соншалықты жақын қорғансыз Адачи бар екеніне сене алмаймын...
Dialogue: 0,0:12:59.47,0:13:02.61,Default,,0,0,0,,Мен мұны білдім, бірақ уақыты келгенде➡
Dialogue: 0,0:13:02.61,0:13:05.15,Default,,0,0,0,,Мен Адачиге тура қарай алмаймын.
Dialogue: 0,0:13:05.15,0:13:08.32,Default,,0,0,0,,Шынымды айтсам, аздап уайымдап тұрмын.
Dialogue: 0,0:13:08.32,0:13:11.79,Default,,0,0,0,,Осыдан кейін Адачи туралы бәрін көрсем ше?
Dialogue: 0,0:13:11.79,0:13:15.29,Default,,0,0,0,,Адачидің адам екеніне тағы да көзім жетті.
Dialogue: 0,0:13:17.46,0:13:19.63,Default,,0,0,0,,《Маған Адачи ұнайды➡
Dialogue: 0,0:13:19.63,0:13:22.80,Default,,0,0,0,,Осы уақытқа дейін қиялдадым➡
Dialogue: 0,0:13:22.80,0:13:27.17,Default,,0,0,0,,Осы уақытқа дейін мен тек әйелдермен болдым...
Dialogue: 0,0:13:27.17,0:13:29.94,Default,,0,0,0,,Егер сіз оны шынымен көрген болсаңыз, не ойлайсыз.》
Dialogue: 0,0:13:29.94,0:13:33.11,Default,,0,0,0,,Ах! иә? Мен енді мұны істей алмаймын! Тым ыстық!
Dialogue: 0,0:13:33.11,0:13:35.78,Default,,0,0,0,,Мен кетемін! Ах.
Dialogue: 0,0:13:35.78,0:13:39.28,Default,,0,0,0,,Уф... Ах...
Dialogue: 0,0:13:39.28,0:13:41.78,Default,,0,0,0,,《Уау. Менің ішім аздап ісіп кетті➡
Dialogue: 0,0:13:41.78,0:13:45.72,Default,,0,0,0,,Өте сүйкімді. Ол ақ және тегіс. Ол ақ па?
Dialogue: 0,0:13:45.72,0:13:47.79,Default,,0,0,0,,Пойопойо өзін жақсы сезінеді!
Dialogue: 0,0:13:47.79,0:13:51.33,Default,,0,0,0,,Жоқ, бұл сөзсіз жақсы! 》
Dialogue: 0,0:13:51.33,0:13:53.29,Default,,0,0,0,,《Қарғыс атсын! 》
Dialogue: 0,0:13:58.47,0:14:00.97,Default,,0,0,0,,《Оны түртіңіз~》
Dialogue: 0,0:14:04.51,0:14:06.67,Default,,0,0,0,,《Жаттығу…》
Dialogue: 0,0:14:09.28,0:14:13.48,Default,,0,0,0,,Онда мен сонда боламын. Жақсы жұмыс!
Dialogue: 0,0:14:13.48,0:14:16.32,Default,,0,0,0,,О.
Dialogue: 0,0:14:16.32,0:14:19.52,Default,,0,0,0,,Адачи осында болды. Иә.
Dialogue: 0,0:14:25.29,0:14:28.63,Default,,0,0,0,,Жел жақсы сезіледі. Иә.
Dialogue: 0,0:14:28.63,0:14:32.30,Default,,0,0,0,,Саунаның да жаман болғаны таңқаларлық емес.
Dialogue: 0,0:14:32.30,0:14:34.50,Default,,0,0,0,,Га.
Dialogue: 0,0:14:37.47,0:14:39.64,Default,,0,0,0,,Адачи Бұл жолмен, былайша. иә?
Dialogue: 0,0:14:39.64,0:14:41.81,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:14:41.81,0:14:43.95,Default,,0,0,0,,Эй, сен неге суретке түсіп жатырсың?
Dialogue: 0,0:14:43.95,0:14:48.82,Default,,0,0,0,,Хэхехе. Оны өшіріңіз. Мүмкін емес.
Dialogue: 0,0:14:48.82,0:14:53.45,Default,,0,0,0,,《Егер олар ғашық болса, фотоға рұқсат етіледі...
Dialogue: 0,0:14:53.45,0:14:57.79,Default,,0,0,0,,Менің ойымша, олар әріптес болғанымен суретке түсу біртүрлі.
Dialogue: 0,0:14:57.79,0:15:00.46,Default,,0,0,0,,Бастапқыда мен сенің жаныңда болғым келді➡
Dialogue: 0,0:15:00.46,0:15:02.80,Default,,0,0,0,,Мен жай ғана ойладым...
Dialogue: 0,0:15:02.80,0:15:05.83,Default,,0,0,0,,Барған сайын сараңдық танытпа.
Dialogue: 0,0:15:05.83,0:15:09.44,Default,,0,0,0,,Маңдайымнан сүйгенге қарсы емес екенін айтты➡
Dialogue: 0,0:15:09.44,0:15:12.61,Default,,0,0,0,,Бұрынғыға қарағанда көбірек уақыт өткізетін болсақ та➡
Dialogue: 0,0:15:12.61,0:15:17.01,Default,,0,0,0,,Мен Адачиді дос ретінде ұнататыныма сенімдімін➡
Dialogue: 0,0:15:17.01,0:15:19.05,Default,,0,0,0,,Менен өзгеше.
Dialogue: 0,0:15:19.05,0:15:21.95,Default,,0,0,0,,Мен білемін, бірақ бәрібір ауырады.
Dialogue: 0,0:15:21.95,0:15:24.45,Default,,0,0,0,,⚟Уау! Ой!
Dialogue: 0,0:15:24.45,0:15:27.89,Default,,0,0,0,,Амансың ба? иә!
Dialogue: 0,0:15:27.89,0:15:30.36,Default,,0,0,0,,《Адачи өте мейірімді》
Dialogue: 0,0:15:32.63,0:15:36.60,Default,,0,0,0,,《Сол кезде...》
Dialogue: 0,0:15:36.60,0:15:39.27,Default,,0,0,0,,｟Куросава-кун, ойнайық! менімен ойна! ｠
Dialogue: 0,0:15:39.27,0:15:43.20,Default,,0,0,0,,<Мен әрқашан бұл бет-әлпетпен көп жақсы істер атқардым.>
Dialogue: 0,0:15:43.20,0:15:46.17,Default,,0,0,0,,｟Маған ұнайды! Сіздің тұтынушыларыңыз сияқты...｠
Dialogue: 0,0:15:46.17,0:15:48.71,Default,,0,0,0,,＜ Дегенмен, қоғамға кіргеннен кейін➡
Dialogue: 0,0:15:48.71,0:15:51.45,Default,,0,0,0,,Антипатия күшейді>
Dialogue: 0,0:15:51.45,0:15:54.12,Default,,0,0,0,,｟Чарашара. Бұл жай ғана жүз болса да.
Dialogue: 0,0:15:54.12,0:15:58.02,Default,,0,0,0,,Бұл еркектік емес.
Dialogue: 0,0:15:58.02,0:16:00.79,Default,,0,0,0,,＜ Бар күш-жігермен ➡
Dialogue: 0,0:16:00.79,0:16:02.76,Default,,0,0,0,,Нәтижелер де шықты...>
Dialogue: 0,0:16:06.16,0:16:09.76,Default,,0,0,0,,｟Бүгін мені шақырғаныңызға рахмет.
Dialogue: 0,0:16:09.76,0:16:13.77,Default,,0,0,0,,Сәлеметсіз бе, менің атым Куросава, сату бөлімінен.
Dialogue: 0,0:16:13.77,0:16:16.44,Default,,0,0,0,,О, сен...
Dialogue: 0,0:16:16.44,0:16:19.94,Default,,0,0,0,,Біраздан бері қауесеттер болды. Хох, қош келдіңіз.
Dialogue: 0,0:16:19.94,0:16:22.44,Default,,0,0,0,,Мен президент Мацуурамен мұнша тез кездесемін деп ойламадым➡
Dialogue: 0,0:16:22.44,0:16:25.28,Default,,0,0,0,,Мен сенімен кездесуді шыдамаймын. Сіздің компанияңыз өткен айда жарияланды➡
Dialogue: 0,0:16:25.28,0:16:29.12,Default,,0,0,0,,Жаңа өнім туралы түсінік... Әй, бұл туралы.
Dialogue: 0,0:16:29.12,0:16:32.19,Default,,0,0,0,,Бұл формальды. Күрделі.
Dialogue: 0,0:16:32.19,0:16:36.76,Default,,0,0,0,,Мен бүгін жұмыссызмын, сондықтан жұмыс туралы сөйлесуді доғар.
Dialogue: 0,0:16:36.76,0:16:40.33,Default,,0,0,0,,Жарайды. Олай болса, Юкико-сама.
Dialogue: 0,0:16:40.33,0:16:42.83,Default,,0,0,0,,Жақсы! Бұл жақсы көңіл-күй.
Dialogue: 0,0:16:42.83,0:16:45.37,Default,,0,0,0,,Менің хатшым болуды қалайсыз ба?
Dialogue: 0,0:16:45.37,0:16:47.64,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:16:47.64,0:16:51.47,Default,,0,0,0,,Өте сүйкімді! Маған ұнады.
Dialogue: 0,0:16:51.47,0:16:56.28,Default,,0,0,0,,Олай болса... (Куросава және т.б.) Сәлем!
Dialogue: 0,0:16:56.28,0:17:00.15,Default,,0,0,0,,Ей, сен мүлдем ішкен жоқсың.
Dialogue: 0,0:17:00.15,0:17:02.78,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:17:02.78,0:17:04.95,Default,,0,0,0,,Мен... Мен онша күшті емеспін.
Dialogue: 0,0:17:04.95,0:17:07.96,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Ішуге дағдыланыңыз.
Dialogue: 0,0:17:07.96,0:17:11.86,Default,,0,0,0,,《Адачи... Ол сондай дөрекі еді➡
Dialogue: 0,0:17:11.86,0:17:13.96,Default,,0,0,0,,Сіз одан жақсы құтыла алмайсыз》
Dialogue: 0,0:17:13.96,0:17:16.60,Default,,0,0,0,,О, күте тұрыңыз... Не?
Dialogue: 0,0:17:16.60,0:17:18.93,Default,,0,0,0,,Сіз менің алкогольді іше алмайсыз ба?
Dialogue: 0,0:17:18.93,0:17:22.30,Default,,0,0,0,,Кешіріңіз. Бұл жігіттің көңіл-күйі нашар.
Dialogue: 0,0:17:22.30,0:17:24.47,Default,,0,0,0,,Мен оны орнына аламын.
Dialogue: 0,0:17:24.47,0:17:26.44,Default,,0,0,0,,Ах.
Dialogue: 0,0:17:28.81,0:17:31.88,Default,,0,0,0,,О, Куросава-кун күткендей!
Dialogue: 0,0:17:31.88,0:17:35.15,Default,,0,0,0,,Бұл тек бетке қатысты емес!
Dialogue: 0,0:17:35.15,0:17:38.29,Default,,0,0,0,,Иә….
Dialogue: 0,0:17:38.29,0:17:41.12,Default,,0,0,0,,Сәлем саған.
Dialogue: 0,0:17:41.12,0:17:43.69,Default,,0,0,0,,Маған қатты ұнады.
Dialogue: 0,0:17:43.69,0:17:45.66,Default,,0,0,0,,Осыдан кейін менімен ақырын...
Dialogue: 0,0:17:47.60,0:17:49.60,Default,,0,0,0,,Уф... Кя!
Dialogue: 0,0:17:49.60,0:17:52.43,Default,,0,0,0,,Кешіріңіз. Бір сәт кешіріңіз.
Dialogue: 0,0:17:52.43,0:17:55.77,Default,,0,0,0,,Иә! ? Қазірдің өзінде ол не? Кешіріңіз, Президент мырза!
Dialogue: 0,0:17:55.77,0:17:57.94,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:18:00.91,0:18:04.61,Default,,0,0,0,,Уф….
Dialogue: 0,0:18:04.61,0:18:09.08,Default,,0,0,0,,Куросаваның жігіті президенттің көңілінен шықпауға тырысады.
Dialogue: 0,0:18:09.08,0:18:12.59,Default,,0,0,0,,Бет жалғыз болса да, қажет емес.
Dialogue: 0,0:18:12.59,0:18:14.92,Default,,0,0,0,,Егер сіз күліп, сатқыңыз келсе, сіз сатуға жауаптысыз➡
Dialogue: 0,0:18:14.92,0:18:17.43,Default,,0,0,0,,Сізде батылдық жоқ.
Dialogue: 0,0:18:17.43,0:18:21.30,Default,,0,0,0,,《Осындай…》｠
Dialogue: 0,0:18:21.30,0:18:24.10,Default,,0,0,0,,< Мен кенеттен тынысым тарылды...
Dialogue: 0,0:18:24.10,0:18:26.37,Default,,0,0,0,,Бірақ мұндай жағдайда...>
Dialogue: 0,0:18:28.44,0:18:30.77,Default,,0,0,0,,｟Жақсысың ба?
Dialogue: 0,0:18:30.77,0:18:32.74,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:18:35.74,0:18:38.45,Default,,0,0,0,,үшін... Мен үйдемін.
Dialogue: 0,0:18:38.45,0:18:41.08,Default,,0,0,0,,Мен көремін. Сонда біз де...
Dialogue: 0,0:18:41.08,0:18:43.75,Default,,0,0,0,,Уф... Әй, бұлай дөрекі болма.
Dialogue: 0,0:18:43.75,0:18:47.09,Default,,0,0,0,,Біраз жат. Жоқ, бірақ...
Dialogue: 0,0:18:47.09,0:18:50.63,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:50.63,0:18:53.13,Default,,0,0,0,,Мен не істеп жатырмын деп ойлаймын...
Dialogue: 0,0:18:55.10,0:18:57.97,Default,,0,0,0,,Мен жай ғана бет жұмысшы болсам да➡
Dialogue: 0,0:18:57.97,0:19:01.97,Default,,0,0,0,,Президентті ашуландырып... Бұл шынымен бекер.
Dialogue: 0,0:19:03.90,0:19:08.78,Default,,0,0,0,,《Хаха... Жай әріптеске не айтып тұрсың?》
Dialogue: 0,0:19:08.78,0:19:11.81,Default,,0,0,0,,Бұл дұрыс емес. иә?
Dialogue: 0,0:19:11.81,0:19:15.25,Default,,0,0,0,,Әрқашан іскер серіктестер туралы көп зерттеулер жасаңыз➡
Dialogue: 0,0:19:15.25,0:19:18.42,Default,,0,0,0,,Өнім туралы бәрін есте сақтаңыз➡
Dialogue: 0,0:19:18.42,0:19:21.32,Default,,0,0,0,,Бүгін де ішімдік іше алмаймын➡
Dialogue: 0,0:19:21.32,0:19:24.33,Default,,0,0,0,,Ол мен үшін ішкен...
Dialogue: 0,0:19:24.33,0:19:26.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:30.60,0:19:33.53,Default,,0,0,0,,Хехе. Бұл не?
Dialogue: 0,0:19:33.53,0:19:35.40,Default,,0,0,0,,Жоқ, бұл Куросава➡
Dialogue: 0,0:19:35.40,0:19:39.61,Default,,0,0,0,,Өйткені менде әрқашан кемелдік бейнесі бар.
Dialogue: 0,0:19:39.61,0:19:44.08,Default,,0,0,0,,Сенің әлсіз екеніңді көргенде сергітеді.
Dialogue: 0,0:19:44.08,0:19:46.08,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:19:52.42,0:19:54.76,Default,,0,0,0,,《Не! ? Не?
Dialogue: 0,0:19:54.76,0:19:57.43,Default,,0,0,0,,Мен қазір қатты толқып тұрмын...
Dialogue: 0,0:19:57.43,0:19:59.43,Default,,0,0,0,,Біртүрлі емес пе? 》
Dialogue: 0,0:19:59.43,0:20:02.36,Default,,0,0,0,,Иә? Менің бетім қызарып кетті.
Dialogue: 0,0:20:02.36,0:20:06.13,Default,,0,0,0,,Амансың ба? Әй, жарайды, жарайды.
Dialogue: 0,0:20:06.13,0:20:09.04,Default,,0,0,0,,Шынымен бе? Бетіңіз қызарған ба?
Dialogue: 0,0:20:09.04,0:20:12.31,Default,,0,0,0,,《Мен сенімдімін➡
Dialogue: 0,0:20:12.31,0:20:14.31,Default,,0,0,0,,Бұл алкогольдің кесірінен.
Dialogue: 0,0:20:16.68,0:20:19.81,Default,,0,0,0,,《Менің жүрегім шулы➡
Dialogue: 0,0:20:19.81,0:20:22.22,Default,,0,0,0,,Мені жылататын нәрсе...》｠
Dialogue: 0,0:20:27.62,0:20:31.13,Default,,0,0,0,,《Содан бері бірнеше ай өтті.
Dialogue: 0,0:20:31.13,0:20:35.03,Default,,0,0,0,,Мен білмей тұрып, Адачиге көзіммен ілесе бастадым.
Dialogue: 0,0:20:35.03,0:20:37.26,Default,,0,0,0,,Сене алар емеспін биыл➡
Dialogue: 0,0:20:37.26,0:20:41.27,Default,,0,0,0,,Бұл менің алғашқы махаббатым сияқты сезілетініне сене алар емеспін.
Dialogue: 0,0:20:41.27,0:20:43.74,Default,,0,0,0,,Мен не болып жатқанын білмеймін.
Dialogue: 0,0:20:43.74,0:20:46.94,Default,,0,0,0,,Иә. Эй, сау бол?
Dialogue: 0,0:20:46.94,0:20:51.75,Default,,0,0,0,,Қош бол. Адачи шынымен мейірімді.
Dialogue: 0,0:20:51.75,0:20:53.81,Default,,0,0,0,,Ол үнемі жан-жағына қарайды.
Dialogue: 0,0:20:53.81,0:20:55.92,Default,,0,0,0,,《Маған мұндай нәрсе қатты ұнайды》
Dialogue: 0,0:20:55.92,0:20:58.45,Default,,0,0,0,,Түрлі? Солай ма?
Dialogue: 0,0:20:58.45,0:21:02.12,Default,,0,0,0,,Не? Бұл мен➡
Dialogue: 0,0:21:02.12,0:21:05.13,Default,,0,0,0,,Шынымды айтсам, бұл құпия.
Dialogue: 0,0:21:05.13,0:21:09.56,Default,,0,0,0,,Мынадай жігіттің көмегі тиер ма екен...
Dialogue: 0,0:21:09.56,0:21:11.87,Default,,0,0,0,,Бұған дейін қозғала алмай қалған кезім көп болды.
Dialogue: 0,0:21:13.80,0:21:17.97,Default,,0,0,0,,Бірақ иә. Жақында Куросава...
Dialogue: 0,0:21:17.97,0:21:21.61,Default,,0,0,0,,Жоқ... Мен Куросавамен көп уақыт өткіземін➡
Dialogue: 0,0:21:21.61,0:21:23.61,Default,,0,0,0,,Мүмкін менде сенімділік пайда болды.
Dialogue: 0,0:21:23.61,0:21:27.65,Default,,0,0,0,,《Аа... қазірдің өзінде жасырын》
Dialogue: 0,0:21:27.65,0:21:30.05,Default,,0,0,0,,Рахмет. 《Тағы да солай➡
Dialogue: 0,0:21:30.05,0:21:33.29,Default,,0,0,0,,Мені одан да көп күтуге мәжбүр ет... Мені одан да жақсы көремін➡
Dialogue: 0,0:21:33.29,0:21:35.29,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:21:35.29,0:21:37.96,Default,,0,0,0,,Мұның маған қатысы жоқ па?
Dialogue: 0,0:21:37.96,0:21:42.13,Default,,0,0,0,,Ахаха, иә. Мүмкін.
Dialogue: 0,0:21:42.13,0:21:46.57,Default,,0,0,0,,《Адачи кейде мені ұсақ-түйекке алаңдатады➡
Dialogue: 0,0:21:46.57,0:21:49.64,Default,,0,0,0,,Сізді өте бақытты етіңіз》
Dialogue: 0,0:21:49.64,0:21:53.17,Default,,0,0,0,,Олай болса, мен сізге екі рет түсірілген фотосуретпен рахмет айтқым келеді. Ха! ?
Dialogue: 0,0:21:53.17,0:21:55.64,Default,,0,0,0,,《Сиқыр сияқты десең...》
Dialogue: 0,0:21:57.71,0:21:59.58,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:21:59.58,0:22:02.08,Default,,0,0,0,,《Адачи күле ме?》
Dialogue: 0,0:22:03.58,0:22:09.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
