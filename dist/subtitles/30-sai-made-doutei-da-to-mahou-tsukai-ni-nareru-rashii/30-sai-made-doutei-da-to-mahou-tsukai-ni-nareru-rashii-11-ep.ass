Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.13,0:00:08.24,Default,,0,0,0,,Құттықтаймыз...
Dialogue: 0,0:00:16.65,0:00:20.62,Default,,0,0,0,,《Куросава: Адачи... Бүгін іссапарға барасың ба?
Dialogue: 0,0:00:20.62,0:00:22.92,Default,,0,0,0,,10 күн бойы...》
Dialogue: 0,0:00:27.79,0:00:30.16,Default,,0,0,0,,《Адачи: Куросаваға айт.
Dialogue: 0,0:00:30.16,0:00:33.30,Default,,0,0,0,,Менің сезімдерім➡
Dialogue: 0,0:00:33.30,0:00:36.20,Default,,0,0,0,,Куросаваға айтыңыз.
Dialogue: 0,0:02:33.12,0:02:35.12,Default,,0,0,0,,Аа...
Dialogue: 0,0:02:42.29,0:02:46.63,Default,,0,0,0,,｟Адачиге ұқсамай, мен не ойлап отырмын?➡
Dialogue: 0,0:02:46.63,0:02:48.93,Default,,0,0,0,,Сөзбен жеткізбейінше түсінбеймін｠
Dialogue: 0,0:02:56.30,0:02:59.27,Default,,0,0,0,,《Сол түннен бері➡
Dialogue: 0,0:02:59.27,0:03:02.71,Default,,0,0,0,,Мен Адачидің жүзін басымнан ала алмаймын.
Dialogue: 0,0:03:02.71,0:03:06.15,Default,,0,0,0,,Неге олай айттыңыз деп ойлаймын.
Dialogue: 0,0:03:06.15,0:03:08.65,Default,,0,0,0,,№➡
Dialogue: 0,0:03:08.65,0:03:11.32,Default,,0,0,0,,Адачи қалай айтарын білмейді➡
Dialogue: 0,0:03:11.32,0:03:15.69,Default,,0,0,0,,Менің барлық ойларым мүлдем орынсыз...
Dialogue: 0,0:03:15.69,0:03:17.99,Default,,0,0,0,,Әрине➡
Dialogue: 0,0:03:17.99,0:03:20.36,Default,,0,0,0,,Сол кездегі өзімшіл ашуым мен қызғанышым➡
Dialogue: 0,0:03:20.36,0:03:23.93,Default,,0,0,0,,Сіз оны алуыңыз керек еді.
Dialogue: 0,0:03:23.93,0:03:27.34,Default,,0,0,0,,Мен қатты қорықтым.
Dialogue: 0,0:03:27.34,0:03:30.71,Default,,0,0,0,,Осы уақытқа дейін жүрегімнің үнін көп тыңдаған соң➡
Dialogue: 0,0:03:30.71,0:03:32.77,Default,,0,0,0,,Сонда да сенің мені жақсы көргенің➡
Dialogue: 0,0:03:32.77,0:03:35.84,Default,,0,0,0,,Қуанып, бұзылдым.
Dialogue: 0,0:03:35.84,0:03:38.15,Default,,0,0,0,,Қанша кездессек те➡
Dialogue: 0,0:03:38.15,0:03:41.55,Default,,0,0,0,,Адачидің таңдауына араласуға қандай құқығыңыз бар?
Dialogue: 0,0:03:41.55,0:03:44.69,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:03:44.69,0:03:47.16,Default,,0,0,0,,Мен Адачиден кешірім сұрауға тырыстым➡
Dialogue: 0,0:03:47.16,0:03:49.83,Default,,0,0,0,,Бұл туралы сан рет ойланып отырып➡
Dialogue: 0,0:03:49.83,0:03:53.23,Default,,0,0,0,,Мен айта алмадым.
Dialogue: 0,0:03:53.23,0:03:56.70,Default,,0,0,0,,Өйткені іссапарлар мен саяхаттарда үнемі бір-бірімізден өтіп кететінбіз...》
Dialogue: 0,0:03:59.63,0:04:02.14,Default,,0,0,0,,《Жоқ, олай емес.
Dialogue: 0,0:04:02.14,0:04:04.51,Default,,0,0,0,,Себебі мен қорықтым.
Dialogue: 0,0:04:04.51,0:04:07.58,Default,,0,0,0,,Адачиден бас тарту...》
Dialogue: 0,0:04:07.58,0:04:09.75,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:04:16.69,0:04:18.69,Default,,0,0,0,,Адачи?
Dialogue: 0,0:04:21.89,0:04:25.33,Default,,0,0,0,,｟Куросаваға. Менің сөйлегенім жақсы емес➡
Dialogue: 0,0:04:25.33,0:04:28.63,Default,,0,0,0,,Сөзбен айтып жеткізе алмаймын➡
Dialogue: 0,0:04:28.63,0:04:34.14,Default,,0,0,0,,Электрондық пошта тым жеңіл болатын сияқты болды, сондықтан мен хат жазамын.
Dialogue: 0,0:04:34.14,0:04:37.04,Default,,0,0,0,,Қазір Нагасакидегі қонақүйде.
Dialogue: 0,0:04:37.04,0:04:41.48,Default,,0,0,0,,Аудару туралы Бұл шешімді өз бетіммен қабылдағаным үшін кешірім сұраймын.
Dialogue: 0,0:04:41.48,0:04:46.41,Default,,0,0,0,,Мен мұны білмей тұрып, сиқырдың күшіне тым көп сүйендім➡
Dialogue: 0,0:04:46.41,0:04:50.49,Default,,0,0,0,,Куросава жүрегін естімей тұрғанда не ойлап отыр?➡
Dialogue: 0,0:04:50.49,0:04:54.76,Default,,0,0,0,,Түсінбедім, қобалжыдым, кетуге қорықтым.
Dialogue: 0,0:04:59.56,0:05:02.96,Default,,0,0,0,,Куросава өзінің сезімін соншалықты жеткізді➡
Dialogue: 0,0:05:02.96,0:05:06.67,Default,,0,0,0,,Сізді алаңдатқаным немесе ұялшақ болғаным үшін кешіріңіз.
Dialogue: 0,0:05:06.67,0:05:11.07,Default,,0,0,0,,Бірақ бір нәрсеге сенгім келеді➡
Dialogue: 0,0:05:11.07,0:05:14.31,Default,,0,0,0,,Мен кетемін деп қатты уайымдап жүрмін➡
Dialogue: 0,0:05:14.31,0:05:17.31,Default,,0,0,0,,Маған Куросава қатты ұнайды｠
Dialogue: 0,0:05:19.31,0:05:22.32,Default,,0,0,0,,«Қайтып келген соң жай сөйлесейік».
Dialogue: 0,0:05:25.32,0:05:27.29,Default,,0,0,0,,Адачи….
Dialogue: 0,0:05:29.32,0:05:33.63,Default,,0,0,0,,《Куросава: Сіз оны әлі оқыдыңыз ба?
Dialogue: 0,0:05:33.63,0:05:38.63,Default,,0,0,0,,Ойлап қарасам, мен сені сүйетінімді алғаш рет хатқа жазып едім.
Dialogue: 0,0:05:38.63,0:05:41.04,Default,,0,0,0,,｜Қолжазба хат жіберу.
Dialogue: 0,0:05:41.04,0:05:43.47,Default,,0,0,0,,Сонда жүрегіңнің дауысын тыңдаудың қажеті жоқ➡
Dialogue: 0,0:05:43.47,0:05:46.14,Default,,0,0,0,,Ол хабарламаны электрондық поштаға қарағанда жақсы жеткізеді.
Dialogue: 0,0:05:46.14,0:05:49.61,Default,,0,0,0,,Хат...｠
Dialogue: 0,0:05:49.61,0:05:53.28,Default,,0,0,0,,《Алғашқы махаббат хаты 30 жаста》
Dialogue: 0,0:05:53.28,0:05:55.82,Default,,0,0,0,,Кешіріңіз, бүгін жексенбі.
Dialogue: 0,0:05:55.82,0:05:59.49,Default,,0,0,0,,А... жоқ, мен іссапардамын.
Dialogue: 0,0:05:59.49,0:06:01.82,Default,,0,0,0,,Кусумото-сан, еңбегіңіз үшін рахмет.
Dialogue: 0,0:06:01.82,0:06:05.16,Default,,0,0,0,,№. Нагасаки дүкенін ашуға жауапты➡
Dialogue: 0,0:06:05.16,0:06:07.83,Default,,0,0,0,,Мен де толық қуатта жұмыс істеп жатырмын.
Dialogue: 0,0:06:07.83,0:06:09.80,Default,,0,0,0,,Сол жерде.
Dialogue: 0,0:06:13.47,0:06:16.14,Default,,0,0,0,,Хиро! Қала орталығындағы Тоёкава ➡
Dialogue: 0,0:06:16.14,0:06:19.64,Default,,0,0,0,,Станция ішінде және жанында көптеген шағын және орта дүкендер бар➡
Dialogue: 0,0:06:19.64,0:06:22.64,Default,,0,0,0,,Нагасаки дүкені вокзалдан алыс орналасқан➡
Dialogue: 0,0:06:22.64,0:06:25.28,Default,,0,0,0,,Сіз осыншама орынды ала аласыз.
Dialogue: 0,0:06:25.28,0:06:29.65,Default,,0,0,0,,Олай болса, біз қала орталығындағы өнімдерден өзгеше өнімдерді әзірлеуіміз керек.
Dialogue: 0,0:06:29.65,0:06:31.79,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:06:31.79,0:06:34.96,Default,,0,0,0,,Сауда орталығының өзінде тұтынушылардың ауқымы кең➡
Dialogue: 0,0:06:34.96,0:06:38.46,Default,,0,0,0,,Бізде көлік тұрағы да бар, сондықтан үлкен заттарды сақтауға болады!
Dialogue: 0,0:06:38.46,0:06:42.13,Default,,0,0,0,,Осы кеңдікті пайдалану арқылы сіз көп нәрсені жасай алатын сияқтысыз.
Dialogue: 0,0:06:42.13,0:06:45.00,Default,,0,0,0,,Кедергісіз тәжірибе кеңістігін құру➡
Dialogue: 0,0:06:45.00,0:06:48.30,Default,,0,0,0,,SNS➡ жүйесінде тамаша көрінетін маусымдық дисплейлер
Dialogue: 0,0:06:48.30,0:06:51.11,Default,,0,0,0,,Жергілікті дүкендермен ынтымақтастық.
Dialogue: 0,0:06:51.11,0:06:54.48,Default,,0,0,0,,Қоғамдық дүкендер қызықты болуы мүмкін...
Dialogue: 0,0:06:54.48,0:06:57.11,Default,,0,0,0,,Ах…. Сіз шынымен мотивациясыз ба?
Dialogue: 0,0:06:57.11,0:06:59.95,Default,,0,0,0,,Адачи-сан! Е, жоқ, солай...
Dialogue: 0,0:06:59.95,0:07:04.12,Default,,0,0,0,,Бұл жақсы емес пе? Идеяларды жалғастырайық.
Dialogue: 0,0:07:04.12,0:07:06.59,Default,,0,0,0,,Мен саған сенемін.
Dialogue: 0,0:07:06.59,0:07:09.96,Default,,0,0,0,,Содан кейін кіреберістен. Егер сіз тұтынушылар ағыны туралы ойласаңыз ...
Dialogue: 0,0:07:09.96,0:07:13.13,Default,,0,0,0,,《Бұрын мен болсам, осылай позитивті болар едім➡
Dialogue: 0,0:07:13.13,0:07:15.63,Default,,0,0,0,,Ойламау.
Dialogue: 0,0:07:15.63,0:07:20.64,Default,,0,0,0,,Бұған да Куросава әсер етті ме деп ойлаймын...
Dialogue: 0,0:07:20.64,0:07:24.71,Default,,0,0,0,,А... алшақ болсақ та... Мен тек Куросава туралы ойлап отырмын.
Dialogue: 0,0:07:39.99,0:07:42.16,Default,,0,0,0,,Уф….
Dialogue: 0,0:07:46.63,0:07:48.60,Default,,0,0,0,,Мен жазушымын.
Dialogue: 0,0:07:51.80,0:07:54.27,Default,,0,0,0,,Ешқашан орындалмаған сезімдер➡
Dialogue: 0,0:07:54.27,0:07:56.30,Default,,0,0,0,,Оны романға айналдыруым керек пе?
Dialogue: 0,0:07:56.30,0:07:59.77,Default,,0,0,0,,(пернетақта дыбысы)
Dialogue: 0,0:08:13.12,0:08:16.62,Default,,0,0,0,,《Цугэ: Соңында кез келген сөз➡
Dialogue: 0,0:08:16.62,0:08:19.63,Default,,0,0,0,,Минатоны білдіру➡
Dialogue: 0,0:08:19.63,0:08:21.63,Default,,0,0,0,,істей алмадым》
Dialogue: 0,0:08:30.94,0:08:34.11,Default,,0,0,0,,Жақсы жұмыс! (Минато) Еңбегіңізге рахмет!
Dialogue: 0,0:08:34.11,0:08:37.95,Default,,0,0,0,,Бірінші күннен қызықты болды. Өте ыстық болды!
Dialogue: 0,0:08:37.95,0:08:41.62,Default,,0,0,0,,Сахнадан көрініс керемет әсер қалдырады! (есіктің ашылған дыбысы)
Dialogue: 0,0:08:41.62,0:08:46.45,Default,,0,0,0,,Минато-кун! иә. Бұл сыйлық.
Dialogue: 0,0:08:46.45,0:08:49.82,Default,,0,0,0,,Мен үшін? Қойылымнан кейін Минато-кун➡ танысыңыз
Dialogue: 0,0:08:49.82,0:08:52.46,Default,,0,0,0,,Оны қабылдау бөлмесіне қалдырып кеткен біреу бар еді.
Dialogue: 0,0:08:52.46,0:08:54.63,Default,,0,0,0,,Бұл керемет! Жанкүйер №1!
Dialogue: 0,0:08:54.63,0:08:56.63,Default,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,0:08:56.63,0:08:58.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.64,0:09:03.64,Default,,0,0,0,,Ум, маған бұны берген адам...
Dialogue: 0,0:09:03.64,0:09:08.11,Default,,0,0,0,,Аа, есімде болса, көзілдірік киген ұзын бойлы адам еді.
Dialogue: 0,0:09:12.45,0:09:15.45,Default,,0,0,0,,Кешіріңіз! Мен бір сәтте шығамын!
Dialogue: 0,0:09:15.45,0:09:17.45,Default,,0,0,0,,Не? Минато-кун! ?
Dialogue: 0,0:09:31.97,0:09:34.00,Default,,0,0,0,,《Менің ойымша, мен оны жақсы меңгермеген сияқтымын➡
Dialogue: 0,0:09:34.00,0:09:36.10,Default,,0,0,0,,келді》
Dialogue: 0,0:09:36.10,0:09:41.94,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:41.94,0:09:43.95,Default,,0,0,0,,｟《Жақсы.
Dialogue: 0,0:09:43.95,0:09:48.15,Default,,0,0,0,,Минато арманын орындады》｠
Dialogue: 0,0:09:51.39,0:09:53.29,Default,,0,0,0,,📱 (дірілдеген дыбыс)
Dialogue: 0,0:09:53.29,0:09:56.79,Default,,0,0,0,,Бұл кім? Адамдар сондай сентиментальды...
Dialogue: 0,0:09:59.79,0:10:02.73,Default,,0,0,0,,Е, Минато! ? неге! ?
Dialogue: 0,0:10:02.73,0:10:04.83,Default,,0,0,0,,Жоқ, мен одан тезірек шығуым керек...
Dialogue: 0,0:10:06.97,0:10:09.30,Default,,0,0,0,,Иә. 📱 (Минато) Цуге! Қазір қайдасың? ?
Dialogue: 0,0:10:09.30,0:10:11.94,Default,,0,0,0,,Не? 📱(Минато) Сіз тікелей эфирге келдіңіз!
Dialogue: 0,0:10:11.94,0:10:14.91,Default,,0,0,0,,Кешіріңіз. Мен қазірдің өзінде... 📱 (Минато) Жарайды!
Dialogue: 0,0:10:14.91,0:10:18.61,Default,,0,0,0,,📱Қазір қайда екеніңізді айтыңыз! Онда қозғалма!
Dialogue: 0,0:10:18.61,0:10:21.12,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:10:23.52,0:10:29.62,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:10:29.62,0:10:34.70,Default,,0,0,0,,Минато... Осы уақытқа дейін келгенім үшін кешірім сұраймын.
Dialogue: 0,0:10:34.70,0:10:36.97,Default,,0,0,0,,Күтілгендей➡
Dialogue: 0,0:10:36.97,0:10:39.13,Default,,0,0,0,,Маған аяқ киімді берген сен бе?
Dialogue: 0,0:10:44.61,0:10:47.41,Default,,0,0,0,,Байланыс Сізге назар аудармағаным үшін кешіріңіз.
Dialogue: 0,0:10:51.31,0:10:54.78,Default,,0,0,0,,Тыңдаудың соңғы турынан өте алмаған соң➡
Dialogue: 0,0:10:54.78,0:10:58.79,Default,,0,0,0,,SHOWTA бірлік құру туралы әңгіме бар дейді➡
Dialogue: 0,0:10:58.79,0:11:01.29,Default,,0,0,0,,Ол мені шақырды.
Dialogue: 0,0:11:01.29,0:11:04.46,Default,,0,0,0,,Бірақ әңгіме кенет болды➡
Dialogue: 0,0:11:04.46,0:11:07.46,Default,,0,0,0,,Бірліктің құрылуы өте құпия болды➡
Dialogue: 0,0:11:07.46,0:11:09.43,Default,,0,0,0,,Мен айта алмадым.
Dialogue: 0,0:11:09.43,0:11:13.13,Default,,0,0,0,,Сонымен... болды ма?
Dialogue: 0,0:11:13.13,0:11:15.60,Default,,0,0,0,,Құттықтаймыз.
Dialogue: 0,0:11:15.60,0:11:18.27,Default,,0,0,0,,Минатоның арманы орындалғанына қуаныштымын.
Dialogue: 0,0:11:18.27,0:11:20.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:20.78,0:11:24.45,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:11:24.45,0:11:27.78,Default,,0,0,0,,Негізі бұл менмін...
Dialogue: 0,0:11:27.78,0:11:32.62,Default,,0,0,0,,Баяғыдан бері айтып келе жатқан осы жасырын ниет➡
Dialogue: 0,0:11:32.62,0:11:35.79,Default,,0,0,0,,Сюжет болсын, жақсылық болсын➡
Dialogue: 0,0:11:35.79,0:11:38.29,Default,,0,0,0,,Мен қалай жауап беруім керек?➡
Dialogue: 0,0:11:38.29,0:11:41.30,Default,,0,0,0,,Мен қалай жақындауым керек...
Dialogue: 0,0:11:41.30,0:11:44.17,Default,,0,0,0,,Мен өзімді қалай сезінетінімді білмеймін...
Dialogue: 0,0:11:49.30,0:11:51.27,Default,,0,0,0,,Байланыс мүмкін емес.
Dialogue: 0,0:11:53.84,0:11:56.01,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:02.12,0:12:06.79,Default,,0,0,0,,《Минато менің соңынан осында жүрді.
Dialogue: 0,0:12:06.79,0:12:09.46,Default,,0,0,0,,Бұл сөздің айласы...
Dialogue: 0,0:12:09.46,0:12:12.63,Default,,0,0,0,,Мен жай ғана сені сүйем➡
Dialogue: 0,0:12:12.63,0:12:16.13,Default,,0,0,0,,Мұны мен парасатты ересек адам ретінде айтуым керек.
Dialogue: 0,0:12:18.30,0:12:21.14,Default,,0,0,0,,《Алғашында➡
Dialogue: 0,0:12:21.14,0:12:25.47,Default,,0,0,0,,Мен оны жай ғана жаман курьер деп ойладым.
Dialogue: 0,0:12:25.47,0:12:29.14,Default,,0,0,0,,Ол арам және дөрекі...
Dialogue: 0,0:12:29.14,0:12:31.21,Default,,0,0,0,,Бірақ…》
Dialogue: 0,0:12:39.79,0:12:42.26,Default,,0,0,0,,Кешіріңіз. Дәл сіз айтқандай.
Dialogue: 0,0:12:45.46,0:12:49.30,Default,,0,0,0,,Мен сізге ұнағаныңызды қалағандықтан, мен сізге мейірімді болдым.
Dialogue: 0,0:12:49.30,0:12:52.13,Default,,0,0,0,,Сіз бұрын оқыған кітаптағы биші➡
Dialogue: 0,0:12:52.13,0:12:54.97,Default,,0,0,0,,Сіз үлгісіз.
Dialogue: 0,0:12:54.97,0:12:57.14,Default,,0,0,0,,Мұны рұқсатсыз жазғаным үшін кешіріңіз.
Dialogue: 0,0:12:57.14,0:12:59.21,Default,,0,0,0,,Мен мұны енді ешқашан жасамаймын.
Dialogue: 0,0:13:02.11,0:13:05.11,Default,,0,0,0,,Осы уақытқа дейін ғашық болсам да➡
Dialogue: 0,0:13:05.11,0:13:07.78,Default,,0,0,0,,Беріліңіз және ол ешқашан орындалмайды деп ойлаңыз➡
Dialogue: 0,0:13:07.78,0:13:11.65,Default,,0,0,0,,Романда басқа тұлғаны үлгі ретінде пайдалану➡
Dialogue: 0,0:13:11.65,0:13:15.26,Default,,0,0,0,,Әңгімеге айналдырып, өзім аяқтадым.
Dialogue: 0,0:13:18.29,0:13:22.46,Default,,0,0,0,,Әңгіме ішінде махаббаттың кез келген түрі болуы мүмкін➡
Dialogue: 0,0:13:22.46,0:13:25.63,Default,,0,0,0,,Өйткені мен зардап шекпеймін.
Dialogue: 0,0:13:25.63,0:13:28.20,Default,,0,0,0,,Бірақ мен Минатоны кездестіргенде...
Dialogue: 0,0:13:30.47,0:13:32.64,Default,,0,0,0,,Бұл енді мені қанағаттандырмайды.
Dialogue: 0,0:13:35.68,0:13:39.75,Default,,0,0,0,,Қандай оқиға болмасын, ол шынайы сенімен салыстыруға келмейді.
Dialogue: 0,0:13:42.32,0:13:45.95,Default,,0,0,0,,Минато….
Dialogue: 0,0:13:45.95,0:13:50.12,Default,,0,0,0,,Мен сені жақсы көремін.
Dialogue: 0,0:14:02.20,0:14:06.47,Default,,0,0,0,,Қандай оқиға болса да, ол сіздің шындыққа сәйкес келмейді.
Dialogue: 0,0:14:06.47,0:14:09.84,Default,,0,0,0,,Минато….
Dialogue: 0,0:14:09.84,0:14:13.05,Default,,0,0,0,,Мен сені сүйемін.
Dialogue: 0,0:14:19.29,0:14:22.16,Default,,0,0,0,,Мен кенеттен кешірім сұраймын.
Dialogue: 0,0:14:22.16,0:14:24.63,Default,,0,0,0,,Минато үшін маңызды уақыт➡
Dialogue: 0,0:14:24.63,0:14:28.46,Default,,0,0,0,,Біз енді ешқашан кездеспейміз... Ей, эй!
Dialogue: 0,0:14:28.46,0:14:30.80,Default,,0,0,0,,Сіз тым ерте бас тартқан болуыңыз керек!
Dialogue: 0,0:14:30.80,0:14:33.84,Default,,0,0,0,,Оны өзіңіз аяқтауға жол бермеңіз!
Dialogue: 0,0:14:33.84,0:14:36.10,Default,,0,0,0,,Сіз не айтқаныңызды ұмытып қалдыңыз ба?
Dialogue: 0,0:14:36.10,0:14:39.61,Default,,0,0,0,,«Берілме»! Бұл дұрыс...
Dialogue: 0,0:14:43.51,0:14:48.28,Default,,0,0,0,,Басында мен сені біртүрлі жігіт деп ойлайтынмын.
Dialogue: 0,0:14:48.28,0:14:51.99,Default,,0,0,0,,Бірақ әрқашан!
Dialogue: 0,0:14:51.99,0:14:55.62,Default,,0,0,0,,Мен бас тартқым келген кезде мені итеріп жіберген адам➡ болды
Dialogue: 0,0:14:55.62,0:14:57.63,Default,,0,0,0,,Бұл сен едің.
Dialogue: 0,0:14:59.66,0:15:02.00,Default,,0,0,0,,Тыңдау кезінде билеу➡
Dialogue: 0,0:15:02.00,0:15:04.80,Default,,0,0,0,,Мен биледім, өйткені Цюге оны көрсін деп.
Dialogue: 0,0:15:04.80,0:15:07.80,Default,,0,0,0,,Сонымен➡
Dialogue: 0,0:15:07.80,0:15:10.81,Default,,0,0,0,,Рұқсатсыз жоғалып кетсем... Бәлеге қалар едім.
Dialogue: 0,0:15:10.81,0:15:13.27,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:15:13.27,0:15:16.64,Default,,0,0,0,,А, қазірдің өзінде! Ойлан, ақымақ!
Dialogue: 0,0:15:16.64,0:15:21.28,Default,,0,0,0,,Сіз романтикалық романистсіз! Эх...
Dialogue: 0,0:15:21.28,0:15:23.62,Default,,0,0,0,,Ха…. Ах! О, күт!
Dialogue: 0,0:15:23.62,0:15:25.95,Default,,0,0,0,,Жақсысың ба??
Dialogue: 0,0:15:25.95,0:15:29.12,Default,,0,0,0,,Аа….
Dialogue: 0,0:15:29.12,0:15:31.09,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:15:33.13,0:15:36.00,Default,,0,0,0,,Мен сені құшақтай аламын ба?
Dialogue: 0,0:15:36.00,0:15:38.80,Default,,0,0,0,,Бұл... жақсы...
Dialogue: 0,0:15:48.18,0:15:52.25,Default,,0,0,0,,Жақсы немесе жаман➡
Dialogue: 0,0:15:52.25,0:15:56.15,Default,,0,0,0,,Мені тыңдама, ақымақ.
Dialogue: 0,0:15:56.15,0:16:01.29,Default,,0,0,0,,《Цюге: Мен осы уақытқа дейін көптеген романтикалық романдар жаздым➡
Dialogue: 0,0:16:01.29,0:16:04.46,Default,,0,0,0,,Шындықтың жауаптары мен сюжеті жоқ.
Dialogue: 0,0:16:04.46,0:16:06.66,Default,,0,0,0,,Махаббат адамдарды ақымақ етеді》
Dialogue: 0,0:16:08.96,0:16:12.93,Default,,0,0,0,,《Цюге: Бұл әрине жаман емес》
Dialogue: 0,0:16:21.14,0:16:23.28,Default,,0,0,0,,《30 жасқа дейін➡
Dialogue: 0,0:16:23.28,0:16:27.48,Default,,0,0,0,,Мен ешкіммен кездескен емеспін және пәкпін...
Dialogue: 0,0:16:27.48,0:16:30.49,Default,,0,0,0,,Мен біреуге осылай ғашық болдым➡
Dialogue: 0,0:16:30.49,0:16:33.62,Default,,0,0,0,,Басқа адам да маған ғашық болады деп үміттенемін➡
Dialogue: 0,0:16:33.62,0:16:37.79,Default,,0,0,0,,Мен мұндай керемет мүмкін емес деп ойладым.
Dialogue: 0,0:16:37.79,0:16:41.66,Default,,0,0,0,,Мені алғаш сүйген адам➡
Dialogue: 0,0:16:41.66,0:16:46.23,Default,,0,0,0,,Куросава ер адам, ол маған қарағанда бұлшықетті➡
Dialogue: 0,0:16:46.23,0:16:50.30,Default,,0,0,0,,Мен әдетте салқынмын, бірақ іштей қатты толқыдым...》
Dialogue: 0,0:16:50.30,0:16:52.47,Default,,0,0,0,,｟《Жақын, сондай бақытты!
Dialogue: 0,0:16:52.47,0:16:56.11,Default,,0,0,0,,Қолжазбаның сүйкімді екенін бірінші рет естіп тұрмын. сәттілік! 》｠
Dialogue: 0,0:16:56.11,0:17:00.31,Default,,0,0,0,,《Шынымды айтсам, бұл күтпеген жерден қатты қорықтым.
Dialogue: 0,0:17:00.31,0:17:03.95,Default,,0,0,0,,Бірақ бір қызығы, дауысты жүрегімде бірінші рет сезіндім➡
Dialogue: 0,0:17:03.95,0:17:08.82,Default,,0,0,0,,Сол сәттен бастап мен оны жек көремін деп ойламадым.
Dialogue: 0,0:17:08.82,0:17:10.99,Default,,0,0,0,,Бұл әрқашан Куросава болды...》
Dialogue: 0,0:17:13.63,0:17:15.63,Default,,0,0,0,,《Ол байсалды болғандықтан》
Dialogue: 0,0:17:15.63,0:17:18.20,Default,,0,0,0,,Хахаха... Ах!
Dialogue: 0,0:17:25.64,0:17:28.41,Default,,0,0,0,,Куросава! ? Ах... Адачи.
Dialogue: 0,0:17:31.45,0:17:35.98,Default,,0,0,0,,Кешіріңіз, кенеттен. Жарайды. Ылғалды.
Dialogue: 0,0:17:35.98,0:17:37.95,Default,,0,0,0,,Ішке кіріңіз.
Dialogue: 0,0:17:41.12,0:17:45.29,Default,,0,0,0,,Ха, өте ылғалды. Кенеттен келгенім үшін кешіріңіз.
Dialogue: 0,0:17:45.29,0:17:49.46,Default,,0,0,0,,Жарайды, шомылыңыз. Адачи бірінші келеді, солай ма?
Dialogue: 0,0:17:49.46,0:17:52.77,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Куросава суық болуы керек!
Dialogue: 0,0:17:56.64,0:17:59.14,Default,,0,0,0,,Уау…. Адачи не...
Dialogue: 0,0:17:59.14,0:18:01.31,Default,,0,0,0,,Бұл туралы ештеңе істей алмайсыз. Куросава не дейді➡
Dialogue: 0,0:18:01.31,0:18:04.81,Default,,0,0,0,,Өйткені сіз тыңдамайсыз. қарақат….
Dialogue: 0,0:18:04.81,0:18:08.48,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:18:08.48,0:18:12.35,Default,,0,0,0,,Ах…. Хатты оқығаннан кейін➡
Dialogue: 0,0:18:12.35,0:18:15.16,Default,,0,0,0,,Мен Адачидің түрін көргім келді.
Dialogue: 0,0:18:15.16,0:18:18.63,Default,,0,0,0,,Куросава…. Тікелей➡
Dialogue: 0,0:18:18.63,0:18:21.56,Default,,0,0,0,,Мен Адачи айтқанын қалаймын.
Dialogue: 0,0:18:21.56,0:18:25.33,Default,,0,0,0,,Тч… Тікелей! ? Аа….
Dialogue: 0,0:18:29.80,0:18:32.47,Default,,0,0,0,,Мен де сиқырды қолдансам деп едім.
Dialogue: 0,0:18:38.48,0:18:41.35,Default,,0,0,0,,Сонда Адачи не ойлап отыр➡
Dialogue: 0,0:18:41.35,0:18:44.12,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:18:44.12,0:18:47.29,Default,,0,0,0,,《Жақсы деп айтудың қажеті жоқ.
Dialogue: 0,0:18:47.29,0:18:50.12,Default,,0,0,0,,Мен сізге айтуым керек.
Dialogue: 0,0:18:50.12,0:18:53.29,Default,,0,0,0,,Ку... Куросаваның шынында кірпігі жоқ.
Dialogue: 0,0:18:53.29,0:18:55.30,Default,,0,0,0,,Иә? Компанияға қосылғаннан бері➡
Dialogue: 0,0:18:55.30,0:18:58.73,Default,,0,0,0,,Мен әдемі жүзді жігіттер бар деп ойладым➡
Dialogue: 0,0:18:58.73,0:19:00.94,Default,,0,0,0,,Мен қазір бұрынғыға қарағанда салқынмын➡
Dialogue: 0,0:19:00.94,0:19:04.14,Default,,0,0,0,,Менің ойымша, бұл керемет. иә?
Dialogue: 0,0:19:04.14,0:19:09.31,Default,,0,0,0,,Мен іс жүзінде жұмысымды алдын ала зерттеп, аяғымды қолдансам да➡
Dialogue: 0,0:19:09.31,0:19:12.78,Default,,0,0,0,,Мұндай күш-жігерді көрсетпесеңіз, жақсы болады➡
Dialogue: 0,0:19:12.78,0:19:16.45,Default,,0,0,0,,Мен ешкімнің біреу туралы жаман сөз айтқанын естіген емеспін.
Dialogue: 0,0:19:16.45,0:19:19.32,Default,,0,0,0,,Сондай-ақ, мен әдетте өте сабырлымын➡
Dialogue: 0,0:19:19.32,0:19:22.46,Default,,0,0,0,,Жүрегімдегі дауысты естісем, Толқып қаламын.
Dialogue: 0,0:19:22.46,0:19:25.29,Default,,0,0,0,,Куросава әрқашан мінсіз адам болды➡
Dialogue: 0,0:19:25.29,0:19:28.80,Default,,0,0,0,,Мен не ойладым, бірақ таңқаларлық, мен ойлап отырмын➡
Dialogue: 0,0:19:28.80,0:19:32.30,Default,,0,0,0,,Бет-әлпетіңізден көрініп тұр және сіздің ойыңыз тар болып көрінеді➡
Dialogue: 0,0:19:32.30,0:19:34.64,Default,,0,0,0,,Қызғаншақ болу.
Dialogue: 0,0:19:34.64,0:19:38.51,Default,,0,0,0,,Сіз шынымен керемет болуға тырыссаңыз, бірақ сіз мүлдем салқын емессіз➡
Dialogue: 0,0:19:38.51,0:19:40.47,Default,,0,0,0,,Кейде...
Dialogue: 0,0:19:43.48,0:19:46.31,Default,,0,0,0,,Менің ойымша, бұл сүйкімді.
Dialogue: 0,0:19:46.31,0:19:49.85,Default,,0,0,0,,Не? Кенеттен. Бұл не➡
Dialogue: 0,0:19:49.85,0:19:53.49,Default,,0,0,0,,Куросава туралы менің сүйікті ісім... Ах.
Dialogue: 0,0:19:53.49,0:19:57.96,Default,,0,0,0,,《Куросава маған осы уақытқа дейін жеткізген ойлары➡
Dialogue: 0,0:19:57.96,0:20:00.23,Default,,0,0,0,,Бұл тіпті ондық емес, бірақ...》
Dialogue: 0,0:20:02.53,0:20:05.13,Default,,0,0,0,,Сондай-ақ... Ей... күте тұр, күт!
Dialogue: 0,0:20:05.13,0:20:07.47,Default,,0,0,0,,《Бұл өте қауіпті.
Dialogue: 0,0:20:07.47,0:20:10.30,Default,,0,0,0,,Мен өте қуаныштымын, дәлірек айтсам, таң қалдым➡
Dialogue: 0,0:20:10.30,0:20:14.11,Default,,0,0,0,,Мен бәрі дұрыс есімде жоқ. Бұл босқа. Жазғым келеді.
Dialogue: 0,0:20:14.11,0:20:18.98,Default,,0,0,0,,Жоқ, қайта тыңдағаныңызды қалаймын》
Dialogue: 0,0:20:18.98,0:20:21.48,Default,,0,0,0,,《Түрген саусақтан➡
Dialogue: 0,0:20:21.48,0:20:26.99,Default,,0,0,0,,Мен бақыланбайтын қуаныш пен ыңғайсыздықты сезінемін.
Dialogue: 0,0:20:26.99,0:20:32.46,Default,,0,0,0,,Бұл жақсылықты қалай жеткізе аламын?
Dialogue: 0,0:20:32.46,0:20:34.46,Default,,0,0,0,,Сөздер жеткіліксіз》
Dialogue: 0,0:20:36.96,0:20:40.97,Default,,0,0,0,,Мұны сөздің өзі жеткізе алмайды.
Dialogue: 0,0:20:40.97,0:20:45.64,Default,,0,0,0,,Мен Куросаваның жүрегін қозғағандай болдым➡
Dialogue: 0,0:20:45.64,0:20:48.71,Default,,0,0,0,,Куросава, менің жүрегімде көбірек...
Dialogue: 0,0:20:51.65,0:20:53.61,Default,,0,0,0,,Маған тиіскеніңді қалаймын.
