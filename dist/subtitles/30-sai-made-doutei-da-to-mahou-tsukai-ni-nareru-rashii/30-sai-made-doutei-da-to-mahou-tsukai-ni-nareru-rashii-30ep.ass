Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:14.00,0:01:16.61,Default,,0,0,0,,<Адачи: Менің атым Киёши Адачи>
Dialogue: 0,0:01:18.67,0:01:22.34,Default,,0,0,0,,<Себебі мен 30 жасқа дейін пәк болдым➡
Dialogue: 0,0:01:22.34,0:01:24.85,Default,,0,0,0,,Мен енді сиқырды қолдана аламын>
Dialogue: 0,0:01:27.85,0:01:30.85,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:01:30.85,0:01:33.36,Default,,0,0,0,,＜ Дегенмен➡
Dialogue: 0,0:01:33.36,0:01:35.86,Default,,0,0,0,,Бұл мені өлтіретіндей түсінікті>
Dialogue: 0,0:01:35.86,0:01:39.36,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:01:39.36,0:01:41.70,Default,,0,0,0,,《Ой, мен тигіздім.
Dialogue: 0,0:01:41.70,0:01:44.03,Default,,0,0,0,,Мүлдем мүмкін емес》
Dialogue: 0,0:01:44.03,0:01:46.84,Default,,0,0,0,,<Түріп тұрған адамның не ойлайтынын түсінуге болады>
Dialogue: 0,0:01:50.54,0:01:52.54,Default,,0,0,0,,<Бәрі>
Dialogue: 0,0:01:54.54,0:01:57.55,Default,,0,0,0,,< Бұл өте пайдалы сиқыр емес.
Dialogue: 0,0:01:57.55,0:02:00.05,Default,,0,0,0,,Қала маңындағы пойыздар - тозақ＞
Dialogue: 0,0:02:00.05,0:02:04.22,Default,,0,0,0,,《Аяғым басылды》 《Ақша алғым келеді》 《Аа, нағыз жігіт...》
Dialogue: 0,0:02:04.22,0:02:07.82,Default,,0,0,0,,《Кім менің бөксесіме тиді?》 《Мынау》
Dialogue: 0,0:02:07.82,0:02:11.49,Default,,0,0,0,,<Қызықтыратын қызды түртіп, оның сезімін тексеріңіз➡\NМен
Dialogue: 0,0:02:11.49,0:02:13.50,Default,,0,0,0,,туралы ойладым, бірақ...>
Dialogue: 0,0:02:16.50,0:02:19.00,Default,,0,0,0,,＜Егер сіз бірінші кезекте қол тигізетін адам болсаңыз➡
Dialogue: 0,0:02:19.00,0:02:21.84,Default,,0,0,0,,Осы жасқа дейін қыздығымды жоғалтқан жоқпын>
Dialogue: 0,0:02:21.84,0:02:23.84,Default,,0,0,0,,Га.
Dialogue: 0,0:02:28.01,0:02:31.51,Default,,0,0,0,,Га. (Куросава) Қайырлы таң, Адачи.
Dialogue: 0,0:02:31.51,0:02:34.18,Default,,0,0,0,,Ах. Ах.
Dialogue: 0,0:02:34.18,0:02:37.19,Default,,0,0,0,,Қайырлы таң. ше?
Dialogue: 0,0:02:37.19,0:02:40.86,Default,,0,0,0,,Мен қатты күрсіндім.
Dialogue: 0,0:02:40.86,0:02:45.86,Default,,0,0,0,,Бөлек. Мен күнде таңертең толып жатқан лифтілерді жек көремін.
Dialogue: 0,0:02:45.86,0:02:49.36,Default,,0,0,0,,Олай болса, менімен бірге 17-ші қабатқа баспалдақпен көтерілгің келе ме?
Dialogue: 0,0:02:49.36,0:02:51.37,Default,,0,0,0,,Бұл жақсы жаттығу.
Dialogue: 0,0:02:51.37,0:02:53.37,Default,,0,0,0,,《Мабуши》
Dialogue: 0,0:02:53.37,0:02:55.87,Default,,0,0,0,,<Бұл жігіт Куросава, ол сол дәуірде болған.
Dialogue: 0,0:02:55.87,0:02:58.04,Default,,0,0,0,,Сымбатты және жұмысқа жақсы➡
Dialogue: 0,0:02:58.04,0:03:00.54,Default,,0,0,0,,Мен сияқты қарапайым адамдарға да мейірімді ➡
Dialogue: 0,0:03:00.54,0:03:02.71,Default,,0,0,0,,Барлығына мейірімді бол＞
Dialogue: 0,0:03:02.71,0:03:04.98,Default,,0,0,0,,Куросава-сенпай, бүгін де тамаша!
Dialogue: 0,0:03:04.98,0:03:09.65,Default,,0,0,0,,Сіздің қызыңыз бар деп ойлайсыз ба? Иә әрине.
Dialogue: 0,0:03:09.65,0:03:12.15,Default,,0,0,0,,<Өлімге дейін танымал>
Dialogue: 0,0:03:12.15,0:03:15.99,Default,,0,0,0,,《Ол жасөспірім кезінде пәктігін жоғалтқанына сенімдімін.》
Dialogue: 0,0:03:15.99,0:03:18.99,Default,,0,0,0,,Қайырлы таң! қайырлы таң.
Dialogue: 0,0:03:18.99,0:03:22.16,Default,,0,0,0,,《Ирааа! Кішкене➡
Dialogue: 0,0:03:22.16,0:03:24.50,Default,,0,0,0,,Қарап шығуға болмайды.
Dialogue: 0,0:03:24.50,0:03:27.67,Default,,0,0,0,,Мінезі жаман болсын! 》
Dialogue: 0,0:03:27.67,0:03:31.84,Default,,0,0,0,,《Бақыт. Таңертең сені көремін деп ойламаппын.
Dialogue: 0,0:03:31.84,0:03:34.51,Default,,0,0,0,,Маған қарап отыра берсең, мен күдіктенемін.
Dialogue: 0,0:03:34.51,0:03:36.68,Default,,0,0,0,,А, бірақ мен ұйықтаудан шаршадым.
Dialogue: 0,0:03:36.68,0:03:39.01,Default,,0,0,0,,Өте сүйкімді》《Уау!
Dialogue: 0,0:03:39.01,0:03:41.52,Default,,0,0,0,,Бұл жігіт Жұмыста сізге ұнайтын адам бар ма?
Dialogue: 0,0:03:41.52,0:03:43.52,Default,,0,0,0,,Мен қызым бар деп ойладым》
Dialogue: 0,0:03:45.69,0:03:49.52,Default,,0,0,0,,《Бұл кім? Ұйқыдан шаршаған бала➡
Dialogue: 0,0:03:49.52,0:03:52.86,Default,,0,0,0,,Сіз сондасыз ба? 》 (есіктің ашылған дыбысы)
Dialogue: 0,0:03:52.86,0:03:54.86,Default,,0,0,0,,Ой! Ах.
Dialogue: 0,0:03:54.86,0:03:57.53,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:57.53,0:03:59.53,Default,,0,0,0,,《Уау~》
Dialogue: 0,0:03:59.53,0:04:01.54,Default,,0,0,0,,《Не?》
Dialogue: 0,0:04:13.48,0:04:15.98,Default,,0,0,0,,Адачи?
Dialogue: 0,0:04:15.98,0:04:17.99,Default,,0,0,0,,《Шынымен бе?》
Dialogue: 0,0:05:59.02,0:06:03.53,Default,,0,0,0,,《Мүмкін емес... Бұл мүмкін емес!
Dialogue: 0,0:06:03.53,0:06:06.13,Default,,0,0,0,,Күтіңіз. Енді мен сиқырды қолдана аламын➡
Dialogue: 0,0:06:06.13,0:06:10.63,Default,,0,0,0,,Мен солай ойладым, бірақ бірінші кезекте мұның бәрі менің қиялым еді➡
Dialogue: 0,0:06:10.63,0:06:14.64,Default,,0,0,0,,Сіз естіген дауыс галлюцинация ма?
Dialogue: 0,0:06:14.64,0:06:16.81,Default,,0,0,0,,Иә. Солай болуы керек!
Dialogue: 0,0:06:16.81,0:06:18.97,Default,,0,0,0,,Өйткені бұл біртүрлі. Сиқыр және т.
Dialogue: 0,0:06:18.97,0:06:21.64,Default,,0,0,0,,Куросава мен туралы айтып жатыр➡
Dialogue: 0,0:06:21.64,0:06:24.48,Default,,0,0,0,,Маған ұнайды... және т.б.
Dialogue: 0,0:06:24.48,0:06:26.48,Default,,0,0,0,,Келесі жолы мен де президент болғанын қалаймын.
Dialogue: 0,0:06:26.48,0:06:29.65,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:06:29.65,0:06:32.49,Default,,0,0,0,,《Бірақ бұл тым тамаша.
Dialogue: 0,0:06:32.49,0:06:35.49,Default,,0,0,0,,Әлгі ашулы президент жынды екен.
Dialogue: 0,0:06:35.49,0:06:39.16,Default,,0,0,0,,Адачи-кун. Иә, менеджер.
Dialogue: 0,0:06:39.16,0:06:41.83,Default,,0,0,0,,Өткен күні мен сұраған Albireo компаниясына қатысты материалдар➡
Dialogue: 0,0:06:41.83,0:06:43.83,Default,,0,0,0,,Сіз орындадыңыз ба? иә?
Dialogue: 0,0:06:43.83,0:06:46.84,Default,,0,0,0,,Мен оны бүгін сұраймын. Бұл➡
Dialogue: 0,0:06:46.84,0:06:49.67,Default,,0,0,0,,Келесі аптаға дейін... иә?
Dialogue: 0,0:06:49.67,0:06:53.01,Default,,0,0,0,,Менеджер…. иә! ?
Dialogue: 0,0:06:53.01,0:06:55.34,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:06:55.34,0:06:57.51,Default,,0,0,0,,Бұл менің түсінбеуім болды.
Dialogue: 0,0:06:57.51,0:07:00.18,Default,,0,0,0,,《Мүмкін емес.
Dialogue: 0,0:07:00.18,0:07:02.85,Default,,0,0,0,,Мен қайдамын, сонша мұңайып?
Dialogue: 0,0:07:02.85,0:07:06.45,Default,,0,0,0,,Бұл жерде сізге ұнайтын нәрсе бар.
Dialogue: 0,0:07:06.45,0:07:08.46,Default,,0,0,0,,Сол Куросава! 》
Dialogue: 0,0:07:14.96,0:07:17.80,Default,,0,0,0,,《А, бұл бітпейді》
Dialogue: 0,0:07:17.80,0:07:19.80,Default,,0,0,0,,Ах.
Dialogue: 0,0:07:19.80,0:07:21.80,Default,,0,0,0,,Қалғандары бар ма?
Dialogue: 0,0:07:21.80,0:07:27.14,Default,,0,0,0,,《Сіз шынымен байсалды екенсіз. Мен адамдарға көбірек сенім артқанымды қалаймын.
Dialogue: 0,0:07:27.14,0:07:29.64,Default,,0,0,0,,Бұл маңызды емес. Мен саған көмектесемін.
Dialogue: 0,0:07:29.64,0:07:32.98,Default,,0,0,0,,《Менің айтайын дегенім, маған сену керек.》
Dialogue: 0,0:07:32.98,0:07:34.98,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:07:34.98,0:07:36.99,Default,,0,0,0,,《Есту галлюцинациясы》
Dialogue: 0,0:07:36.99,0:07:39.82,Default,,0,0,0,,Олай болса мен сенен мынаны сұраймын. Оу.
Dialogue: 0,0:07:39.82,0:07:42.32,Default,,0,0,0,,《Аа, желкедегі мең》
Dialogue: 0,0:07:42.32,0:07:44.33,Default,,0,0,0,,Иә? Эй.
Dialogue: 0,0:07:44.33,0:07:46.33,Default,,0,0,0,,《Бұл біртүрлі жерде》
Dialogue: 0,0:07:46.33,0:07:49.00,Default,,0,0,0,,Бұл сандар біртүрлі ме?
Dialogue: 0,0:07:49.00,0:07:51.00,Default,,0,0,0,,《Жалап...》 Уау!
Dialogue: 0,0:07:51.00,0:07:53.50,Default,,0,0,0,,Эй, әжетхана!
Dialogue: 0,0:07:56.34,0:07:59.34,Default,,0,0,0,,Уау, бұл рас!
Dialogue: 0,0:07:59.34,0:08:02.34,Default,,0,0,0,,Бұл галлюцинация емес еді.
Dialogue: 0,0:08:02.34,0:08:05.11,Default,,0,0,0,,Ах, ақыры аяқталды.
Dialogue: 0,0:08:05.11,0:08:07.62,Default,,0,0,0,,《Әріптесім байсалды сияқты》
Dialogue: 0,0:08:10.79,0:08:13.79,Default,,0,0,0,,Мен енді компанияда жалғызбын деп ойлаймын.
Dialogue: 0,0:08:13.79,0:08:15.96,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:15.96,0:08:19.26,Default,,0,0,0,,《Маған шабуыл жасалса да, ешкім келмейді...》
Dialogue: 0,0:08:21.80,0:08:23.80,Default,,0,0,0,,Бүгін суық.
Dialogue: 0,0:08:32.47,0:08:34.48,Default,,0,0,0,,Мен оны саған қарызға беремін.
Dialogue: 0,0:08:34.48,0:08:37.48,Default,,0,0,0,,《Аа, мен бүгін дыбыс өшіргіш әкелгеніме қуаныштымын》
Dialogue: 0,0:08:37.48,0:08:39.98,Default,,0,0,0,,Бұл жаман. Жарайды.
Dialogue: 0,0:08:39.98,0:08:42.82,Default,,0,0,0,,《Менің көзім... шынымен қансырап тұр.
Dialogue: 0,0:08:42.82,0:08:45.32,Default,,0,0,0,,Ол байсалды болғандықтан, оның жұмысы менеджерге де ұнайды➡
Dialogue: 0,0:08:45.32,0:08:48.82,Default,,0,0,0,,Сіз мені тым мәжбүрлеп жатырсыз》
Dialogue: 0,0:08:48.82,0:08:52.66,Default,,0,0,0,,Суық тиіп қалсаң, жұмысым артады.
Dialogue: 0,0:08:52.66,0:08:55.66,Default,,0,0,0,,《Мен оны жалғыз қалдыра алмаймын》
Dialogue: 0,0:08:55.66,0:08:58.83,Default,,0,0,0,,《S... Ол сондай жақсы жігіт.
Dialogue: 0,0:08:58.83,0:09:01.00,Default,,0,0,0,,Сізге шабуыл жасайды деп ойлағаныңыз үшін кешіріңіз.
Dialogue: 0,0:09:01.00,0:09:03.00,Default,,0,0,0,,Мм. Үйге ерте қайтайық.
Dialogue: 0,0:09:07.44,0:09:11.05,Default,,0,0,0,,Рахмет. Куросаваның сонда болуы маған көмектесті.
Dialogue: 0,0:09:13.78,0:09:15.95,Default,,0,0,0,,Ахаха... бұл асыра сілтеу.
Dialogue: 0,0:09:15.95,0:09:18.95,Default,,0,0,0,,Жоқ, бұл шынымен көмектесті.
Dialogue: 0,0:09:18.95,0:09:21.46,Default,,0,0,0,,Келесі кездескенше➡
Dialogue: 0,0:09:21.46,0:09:23.46,Default,,0,0,0,,Саған денеммен алғыс айтуым керек пе?
Dialogue: 0,0:09:25.46,0:09:27.96,Default,,0,0,0,,Не елестетесің, бұзық?
Dialogue: 0,0:09:27.96,0:09:31.63,Default,,0,0,0,,Келесіде тамақ ішейік. Уф иә.
Dialogue: 0,0:09:31.63,0:09:34.97,Default,,0,0,0,,《Сен байсалдысың ба, әлде қалжыңдадың ба? ? 》
Dialogue: 0,0:09:34.97,0:09:37.47,Default,,0,0,0,,Айтпақшы, соңғы пойызда жақсысың ба?
Dialogue: 0,0:09:37.47,0:09:39.47,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:09:39.47,0:09:42.31,Default,,0,0,0,,Бітті... уақыт таяп қалды.
Dialogue: 0,0:09:42.31,0:09:46.15,Default,,0,0,0,,Шынайы ма? Әй, такси ақысы...
Dialogue: 0,0:09:46.15,0:09:48.15,Default,,0,0,0,,Хмм, содан кейін➡
Dialogue: 0,0:09:48.15,0:09:50.15,Default,,0,0,0,,Менің үйімде қалғың келе ме?
Dialogue: 0,0:09:54.32,0:09:56.32,Default,,0,0,0,,Иә! ? Жақын➡
Dialogue: 0,0:09:56.32,0:09:59.83,Default,,0,0,0,,Такси жақсы. ``Мен не істеуім керек...?
Dialogue: 0,0:09:59.83,0:10:02.16,Default,,0,0,0,,Куросава мені ұнатса да➡
Dialogue: 0,0:10:02.16,0:10:04.93,Default,,0,0,0,,Ноконоко Сіздің үйіңізге баруға болады ма?
Dialogue: 0,0:10:04.93,0:10:07.27,Default,,0,0,0,,Жоқ, бірақ ол жақсы жігіт.
Dialogue: 0,0:10:07.27,0:10:09.77,Default,,0,0,0,,Осы уақытқа дейін ештеңе болған жоқ...
Dialogue: 0,0:10:09.77,0:10:13.44,Default,,0,0,0,,Әй, сенде арам ниет бар ма, жоқ па?
Dialogue: 0,0:10:13.44,0:10:16.44,Default,,0,0,0,,Иә, оны түрткен кезде білесің.
Dialogue: 0,0:10:16.44,0:10:18.95,Default,,0,0,0,,Жарайды, кездейсоқ сурет...》
Dialogue: 0,0:10:18.95,0:10:20.95,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:10:20.95,0:10:22.95,Default,,0,0,0,,《Қазір! 》 📱 (рингтон)
Dialogue: 0,0:10:22.95,0:10:25.45,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:10:25.45,0:10:29.12,Default,,0,0,0,,Амансың ба? Уф иә.
Dialogue: 0,0:10:29.12,0:10:32.13,Default,,0,0,0,,《Уф, есек...》
Dialogue: 0,0:10:32.13,0:10:34.53,Default,,0,0,0,,Қараңыз. Ах.
Dialogue: 0,0:10:39.80,0:10:43.14,Default,,0,0,0,,《Ол қатты шу шығарды, бірақ мен зардап шеккен жоқпын деп үміттенемін》
Dialogue: 0,0:10:43.14,0:10:45.47,Default,,0,0,0,,《Ол өте жақсы жігіт.
Dialogue: 0,0:10:45.47,0:10:48.98,Default,,0,0,0,,Сақ болғаным үшін кешіріңіз》
Dialogue: 0,0:10:48.98,0:10:50.98,Default,,0,0,0,,Куросава. иә?
Dialogue: 0,0:10:56.65,0:10:58.82,Default,,0,0,0,,Мазасыздық тудырмаса➡
Dialogue: 0,0:10:58.82,0:11:01.02,Default,,0,0,0,,Бүгін түнеуге бола ма?
Dialogue: 0,0:11:03.83,0:11:05.83,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:11:05.83,0:11:11.17,Default,,0,0,0,,((Куросава? Куросава. Куросава…)
Dialogue: 0,0:11:11.17,0:11:14.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:14.00,0:11:16.00,Default,,0,0,0,,《Ол қазір не?》
Dialogue: 0,0:11:26.01,0:11:28.52,Default,,0,0,0,,Өтінемін. Онда отырыңыз.
Dialogue: 0,0:11:32.69,0:11:35.39,Default,,0,0,0,,《Тек танымал аурасы бар бұл қандай бөлме?》
Dialogue: 0,0:11:38.19,0:11:40.90,Default,,0,0,0,,《Мен тыныштала алмаймын》 (шу)
Dialogue: 0,0:11:44.70,0:11:47.20,Default,,0,0,0,,Бұл манга…. Ах!
Dialogue: 0,0:11:49.54,0:11:53.04,Default,,0,0,0,,Мен оны кеше оқи бастадым, тоқтай алмадым.
Dialogue: 0,0:11:53.04,0:11:55.04,Default,,0,0,0,,Сіз балаға ұқсайсыз.
Dialogue: 0,0:12:00.38,0:12:04.99,Default,,0,0,0,,Мен де. иә? Маған да бұл манга ұнайды.
Dialogue: 0,0:12:04.99,0:12:08.49,Default,,0,0,0,,Он екі сынақ доғасы ортасында тоқтамайды.
Dialogue: 0,0:12:08.49,0:12:11.99,Default,,0,0,0,,Дұрыс! Маған ең алдымен сынақ нұсқасы ұнайды!
Dialogue: 0,0:12:11.99,0:12:14.50,Default,,0,0,0,,Бұл трюк таңқаларлық.
Dialogue: 0,0:12:14.50,0:12:17.83,Default,,0,0,0,,《Бұл жігіттің қызығушылықтары таң қалдырады》
Dialogue: 0,0:12:17.83,0:12:21.84,Default,,0,0,0,,Аа, дұрыс. Ванна қайнап жатыр, кіріңіз.
Dialogue: 0,0:12:21.84,0:12:25.01,Default,,0,0,0,,Бұл киім ауыстыру. Ах, рахмет.
Dialogue: 0,0:12:25.01,0:12:28.51,Default,,0,0,0,,《Нәзік》 《Адачи кисе сүйкімді болар еді➡
Dialogue: 0,0:12:28.51,0:12:31.85,Default,,0,0,0,,Мен армандау үшін пижама сатып алдым➡
Dialogue: 0,0:12:31.85,0:12:34.35,Default,,0,0,0,,Пайдалы болады деп ойламаппын...》
Dialogue: 0,0:12:34.35,0:12:36.35,Default,,0,0,0,,Уф….
Dialogue: 0,0:12:36.35,0:12:39.02,Default,,0,0,0,,《Мен пижама кигім келмейді~! 》
Dialogue: 0,0:12:39.02,0:12:44.36,Default,,0,0,0,,Мен жақсы ваннаға түссем де, ол мүлдем жылынбайды...
Dialogue: 0,0:12:44.36,0:12:47.03,Default,,0,0,0,,《Уф... Көлемі тамаша.
Dialogue: 0,0:12:47.03,0:12:51.37,Default,,0,0,0,,Мен әр түрлі эмоцияларға толы болғандай сезінемін.
Dialogue: 0,0:12:51.37,0:12:53.87,Default,,0,0,0,,Ванна Сәлем.
Dialogue: 0,0:12:53.87,0:12:56.20,Default,,0,0,0,,Менде сыра бар. Сіз оны ішкіңіз келе ме?
Dialogue: 0,0:12:56.20,0:12:58.21,Default,,0,0,0,,《Мені мас қылып не істемексің? 》
Dialogue: 0,0:12:58.21,0:13:01.88,Default,,0,0,0,,Сумен.
Dialogue: 0,0:13:01.88,0:13:04.21,Default,,0,0,0,,Жарайды, мен де суға түсейін.
Dialogue: 0,0:13:04.21,0:13:07.65,Default,,0,0,0,,Ах. Мен футонды артқа қалдырдым.
Dialogue: 0,0:13:07.65,0:13:11.05,Default,,0,0,0,,Рахмет. Ұйқыңыз келсе, алдымен ұйықтаңыз.
Dialogue: 0,0:13:20.66,0:13:23.50,Default,,0,0,0,,《Егер мен немесе ол әйел болсам➡
Dialogue: 0,0:13:23.50,0:13:25.80,Default,,0,0,0,,Бұл оңайырақ болуы мүмкін бе?
Dialogue: 0,0:13:28.67,0:13:34.01,Default,,0,0,0,,《30 жыл өмір сүргеннен кейін менде махаббат сезімі мүлдем жоқ➡
Dialogue: 0,0:13:34.01,0:13:36.68,Default,,0,0,0,,Басқа адамның жүрегін түсінгеннен кейін➡
Dialogue: 0,0:13:36.68,0:13:38.88,Default,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:13:49.86,0:13:52.19,Default,,0,0,0,,Сіз әлі ұйықтадыңыз ба?
Dialogue: 0,0:13:52.19,0:13:55.03,Default,,0,0,0,,《Ұйықтап жатырмын деп тұрмын. Қандай бет жасауым керек➡
Dialogue: 0,0:13:55.03,0:13:59.37,Default,,0,0,0,,Себебі мен білмеймін》 (аяқ дыбысы)
Dialogue: 0,0:13:59.37,0:14:01.37,Default,,0,0,0,,《Не?
Dialogue: 0,0:14:01.37,0:14:04.21,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:14:04.21,0:14:06.21,Default,,0,0,0,,Эй, эй! 》
Dialogue: 0,0:14:19.32,0:14:21.99,Default,,0,0,0,,《Жақын.
Dialogue: 0,0:14:21.99,0:14:25.83,Default,,0,0,0,,Бұл қауіпті. Куросава не істеп жатқанын білмеймін➡
Dialogue: 0,0:14:25.83,0:14:27.83,Default,,0,0,0,,Өте қорқынышты》
Dialogue: 0,0:14:29.83,0:14:32.83,Default,,0,0,0,,《Иә. Егер сіз оны ұстасаңыз, ол сиқырлы болады...》
Dialogue: 0,0:14:44.35,0:14:48.02,Default,,0,0,0,,《Мен таң қалдым.
Dialogue: 0,0:14:48.02,0:14:50.32,Default,,0,0,0,,Жаңа ғана смартфоныңызды алуға келдіңіз бе?
Dialogue: 0,0:14:54.02,0:14:56.86,Default,,0,0,0,,《Куросава мені ұнатады➡
Dialogue: 0,0:14:56.86,0:14:59.86,Default,,0,0,0,,Бұл не? Бірақ ➡
Dialogue: 0,0:14:59.86,0:15:01.86,Default,,0,0,0,,Неге ештеңе істемедің?
Dialogue: 0,0:15:05.13,0:15:07.14,Default,,0,0,0,,Ах.
Dialogue: 0,0:15:07.14,0:15:09.97,Default,,0,0,0,,《Мен сенің бұл туралы бірдеңе істеуіңді қалаған сияқтымын! 》
Dialogue: 0,0:15:09.97,0:15:14.14,Default,,0,0,0,,Олай емес! Аа….
Dialogue: 0,0:15:14.14,0:15:17.65,Default,,0,0,0,,Көп нәрсе болып жатқаны сонша, менің басым тырнақалды.
Dialogue: 0,0:15:19.98,0:15:23.65,Default,,0,0,0,,《Мен сияқты пәк қыз үшін тым көп》
Dialogue: 0,0:15:23.65,0:15:25.65,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:39.67,0:15:42.50,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:15:42.50,0:15:44.51,Default,,0,0,0,,Мен ұйықтай алмаймын.
Dialogue: 0,0:15:47.34,0:15:53.18,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,0:15:53.18,0:15:56.02,Default,,0,0,0,,(қайнаған судың дыбысы)
Dialogue: 0,0:15:56.02,0:15:59.69,Default,,0,0,0,,Жағымды иіс... қайырлы таң!
Dialogue: 0,0:15:59.69,0:16:01.69,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:16:01.69,0:16:04.36,Default,,0,0,0,,Таңғы ас ішкіңіз келе ме?
Dialogue: 0,0:16:04.36,0:16:06.79,Default,,0,0,0,,Тамақтану.
Dialogue: 0,0:16:06.79,0:16:09.63,Default,,0,0,0,,О!
Dialogue: 0,0:16:09.63,0:16:11.63,Default,,0,0,0,,Итадакимасу.
Dialogue: 0,0:16:13.97,0:16:16.30,Default,,0,0,0,,Дәмді.
Dialogue: 0,0:16:16.30,0:16:18.97,Default,,0,0,0,,Бұл керемет, Куросава. Таңертеңнен осылай➡
Dialogue: 0,0:16:18.97,0:16:21.31,Default,,0,0,0,,Тамақты дұрыс дайындау.
Dialogue: 0,0:16:21.31,0:16:24.31,Default,,0,0,0,,Мен емес.
Dialogue: 0,0:16:24.31,0:16:26.81,Default,,0,0,0,,Сонымен, сіз күнде тамақ ішуге келесіз бе?
Dialogue: 0,0:16:26.81,0:16:28.98,Default,,0,0,0,,Не!
Dialogue: 0,0:16:28.98,0:16:32.99,Default,,0,0,0,,Жоқ, бұл жаман.
Dialogue: 0,0:16:32.99,0:16:36.16,Default,,0,0,0,,《Бір сәт бұл жақсы идея болар деп ойладым.
Dialogue: 0,0:16:36.16,0:16:38.83,Default,,0,0,0,,Бұл шындық болу үшін тым жақсы.
Dialogue: 0,0:16:38.83,0:16:40.83,Default,,0,0,0,,Омлет дүкенін қараңыз》
Dialogue: 0,0:16:47.67,0:16:51.51,Default,,0,0,0,,《Біраз уақыт арақашықтықты сақтаңыз!
Dialogue: 0,0:16:51.51,0:16:54.18,Default,,0,0,0,,Махаббат тәжірибесі нөлдік маған➡
Dialogue: 0,0:16:54.18,0:16:57.35,Default,,0,0,0,,Куросаваның махаббаты тым ауыр жүк》
Dialogue: 0,0:16:57.35,0:17:00.35,Default,,0,0,0,,Га. Уау….
Dialogue: 0,0:17:00.35,0:17:03.02,Default,,0,0,0,,Сәлем Адачи! Директор.
Dialogue: 0,0:17:03.02,0:17:06.12,Default,,0,0,0,,Таңертеңнен бері болды. Мен араласамын.
Dialogue: 0,0:17:06.12,0:17:08.79,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:08.79,0:17:12.96,Default,,0,0,0,,《Басында менеджер қосымша жұмыс істеуімді өтінді...》
Dialogue: 0,0:17:12.96,0:17:16.80,Default,,0,0,0,,Айтпақшы, кешегі құжат жақсы жасалған.
Dialogue: 0,0:17:16.80,0:17:19.97,Default,,0,0,0,,Сіз мұны өзіңіз жасадыңыз ба? Негізі➡
Dialogue: 0,0:17:19.97,0:17:22.80,Default,,0,0,0,,Куросавадан сізге көмектесуін сұраңыз. Не?
Dialogue: 0,0:17:22.80,0:17:26.81,Default,,0,0,0,,Алдымен соны айт. Эй, Куросава-кун!
Dialogue: 0,0:17:26.81,0:17:29.81,Default,,0,0,0,,《Сәлем! қашықтық! 》
Dialogue: 0,0:17:29.81,0:17:32.81,Default,,0,0,0,,Бұл не? Кеше менің Адачим болды➡
Dialogue: 0,0:17:32.81,0:17:35.48,Default,,0,0,0,,Саған жүк болып көрінгенім үшін кешір.
Dialogue: 0,0:17:35.48,0:17:38.82,Default,,0,0,0,,Жоқ, жоқ. Құжаттардың көбін өзі жасады➡
Dialogue: 0,0:17:38.82,0:17:41.49,Default,,0,0,0,,Мен аз ғана көмектестім.
Dialogue: 0,0:17:41.49,0:17:44.16,Default,,0,0,0,,《Куросава…》 Хахахаха….
Dialogue: 0,0:17:44.16,0:17:47.50,Default,,0,0,0,,Куросава-кун кішіпейілділікке жақсы.
Dialogue: 0,0:17:47.50,0:17:50.16,Default,,0,0,0,,Дұрыс тағзым еттіңіз бе? Аа….
Dialogue: 0,0:17:50.16,0:17:54.67,Default,,0,0,0,,Бұл өз уақытында болады. 《Тоқта, бұл туралы...》
Dialogue: 0,0:17:54.67,0:17:58.34,Default,,0,0,0,,Иә. Жақын жерде жақсы якинику мейрамханасы бар.
Dialogue: 0,0:17:58.34,0:18:00.84,Default,,0,0,0,,Солай ма? «бір минут күте тұрыңыз.
Dialogue: 0,0:18:00.84,0:18:03.68,Default,,0,0,0,,Бұл ағын нашар! 》
Dialogue: 0,0:18:03.68,0:18:05.95,Default,,0,0,0,,Қаласаңыз, екеуіңіз бірге жүре аласыздар.
Dialogue: 0,0:18:05.95,0:18:09.45,Default,,0,0,0,,Бұл тегін билет. 《Оны орнатпаңыз! 》
Dialogue: 0,0:18:09.45,0:18:12.29,Default,,0,0,0,,Мен сізден тұрақты қолдау күтемін.
Dialogue: 0,0:18:12.29,0:18:15.62,Default,,0,0,0,,Жақсы араласыңыз! 《Куросава/Адачи: Шынымен бе?
Dialogue: 0,0:18:15.62,0:18:18.83,Default,,0,0,0,,Менеджер байыпты түрде...》《Оба құдайы! 》 《Купида》
Dialogue: 0,0:18:24.63,0:18:27.97,Default,,0,0,0,,《Мен бас тарта алмадым. менің ақымақ
Dialogue: 0,0:18:27.97,0:18:31.97,Default,,0,0,0,,Мен біраз уақытқа қашықтықты сақтауды жоспарлап отырмын, бірақ...
Dialogue: 0,0:18:31.97,0:18:35.14,Default,,0,0,0,,Иә! (2 адам) Дәмді!
Dialogue: 0,0:18:35.14,0:18:37.81,Default,,0,0,0,,Бұл қауіпті. Аузыңда еріп кетті.
Dialogue: 0,0:18:37.81,0:18:39.81,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:18:45.82,0:18:48.02,Default,,0,0,0,,Пуха.
Dialogue: 0,0:18:52.33,0:18:55.83,Default,,0,0,0,,Хехе. иә? Бұл не?
Dialogue: 0,0:18:55.83,0:19:00.50,Default,,0,0,0,,Жоқ, мен Адачи жақсы тамақтанатын сияқты деп ойладым.
Dialogue: 0,0:19:00.50,0:19:03.34,Default,,0,0,0,,Шынымен бе? Сіз аузыңызды толтырып жатырсыз ба?
Dialogue: 0,0:19:03.34,0:19:06.11,Default,,0,0,0,,Жақсы... бұл керемет.
Dialogue: 0,0:19:06.11,0:19:09.28,Default,,0,0,0,,《Мм? Қазір не болды?
Dialogue: 0,0:19:09.28,0:19:11.78,Default,,0,0,0,,《Яба. Мен оны сүйкімді деп айта жаздадым》
Dialogue: 0,0:19:16.12,0:19:20.45,Default,,0,0,0,,Тіпті мен өзімді әдеттегіден жақсы сезінемін.
Dialogue: 0,0:19:20.45,0:19:23.46,Default,,0,0,0,,Иә? Бұл жақсы ет.
Dialogue: 0,0:19:23.46,0:19:26.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:26.46,0:19:28.96,Default,,0,0,0,,Мен сенімдімін.
Dialogue: 0,0:19:28.96,0:19:31.30,Default,,0,0,0,,Салқын кеспе мен бибимбапқа тапсырыс беріп, бөліскіңіз келе ме?
Dialogue: 0,0:19:31.30,0:19:34.80,Default,,0,0,0,,Жақсы. Кешіріңіз.
Dialogue: 0,0:19:34.80,0:19:37.81,Default,,0,0,0,,《Тек көңілді.
Dialogue: 0,0:19:37.81,0:19:41.14,Default,,0,0,0,,Куросава да көңілді жүрген сияқты.
Dialogue: 0,0:19:41.14,0:19:43.14,Default,,0,0,0,,Бұл қызық》
Dialogue: 0,0:19:45.15,0:19:48.98,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет. Сіздің шотыңыз осында болады.
Dialogue: 0,0:19:48.98,0:19:52.49,Default,,0,0,0,,Қазір төлеңіз. иә.
Dialogue: 0,0:19:52.49,0:19:54.99,Default,,0,0,0,,О? кешіріңіз.
Dialogue: 0,0:19:54.99,0:19:58.33,Default,,0,0,0,,Бұл мерзімі аяқталды. Ха!
Dialogue: 0,0:19:58.33,0:20:01.16,Default,,0,0,0,,《Бастық! 》
Dialogue: 0,0:20:01.16,0:20:05.43,Default,,0,0,0,,《Жоқ》 Шынымен, сіз тегін купондарды пайдалана алмайсыз ба?
Dialogue: 0,0:20:05.43,0:20:08.44,Default,,0,0,0,,Сізде ақша жеткілікті ме? Ах.
Dialogue: 0,0:20:08.44,0:20:12.27,Default,,0,0,0,,Иә….
Dialogue: 0,0:20:12.27,0:20:14.94,Default,,0,0,0,,Карточка бойынша. иә. Е, онда➡
Dialogue: 0,0:20:14.94,0:20:17.78,Default,,0,0,0,,Рахмет айту деген нені білдіреді? Кем дегенде Варикан!
Dialogue: 0,0:20:17.78,0:20:21.12,Default,,0,0,0,,Жарайды. Жарайды.
Dialogue: 0,0:20:21.12,0:20:23.95,Default,,0,0,0,,Келесіде айлық алған кезде өзіңізді емдеңіз.
Dialogue: 0,0:20:23.95,0:20:26.12,Default,,0,0,0,,Ах.
Dialogue: 0,0:20:26.12,0:20:29.29,Default,,0,0,0,,《Куросава мені ұнататын сияқты➡
Dialogue: 0,0:20:29.29,0:20:32.63,Default,,0,0,0,,Мен ерекше ештеңе істеп жатқан сияқты емеспін...
Dialogue: 0,0:20:32.63,0:20:34.63,Default,,0,0,0,,Маған жұмысқа көмектесіңіз➡
Dialogue: 0,0:20:34.63,0:20:38.63,Default,,0,0,0,,Маған осылай мейірімді бола алсаңыз➡
Dialogue: 0,0:20:38.63,0:20:42.30,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:20:42.30,0:20:45.97,Default,,0,0,0,,Дос ретінде ол өте жақсы жігіт.
Dialogue: 0,0:20:45.97,0:20:49.31,Default,,0,0,0,,Бірге болу қызық》
Dialogue: 0,0:20:49.31,0:20:52.65,Default,,0,0,0,,Мен кәмпит алдым. Рақмет сізге.
Dialogue: 0,0:20:52.65,0:20:55.15,Default,,0,0,0,,《Бұл шынымен де арман сияқты》
Dialogue: 0,0:20:55.15,0:20:57.49,Default,,0,0,0,,Ах. 《Міне, біз тағы да Адачимен біргеміз➡
Dialogue: 0,0:20:57.49,0:20:59.99,Default,,0,0,0,,Енді кешкі асқа шығуға сылтауым бар.
Dialogue: 0,0:20:59.99,0:21:03.32,Default,,0,0,0,,Мен... Мен қатты ренжідім.
Dialogue: 0,0:21:03.32,0:21:06.66,Default,,0,0,0,,Маған қатты ұнайды. Мен сондай қуаныштымын.
Dialogue: 0,0:21:06.66,0:21:09.83,Default,,0,0,0,,Бүгін үйге барғым келмейді.
Dialogue: 0,0:21:09.83,0:21:12.03,Default,,0,0,0,,Менің үйге барғым келмейді》
Dialogue: 0,0:21:14.34,0:21:17.17,Default,,0,0,0,,А, кешіріңіз!
Dialogue: 0,0:21:17.17,0:21:19.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:19.34,0:21:21.51,Default,,0,0,0,,Кешіріңіз, Куросава.
Dialogue: 0,0:21:21.51,0:21:25.35,Default,,0,0,0,,《Мен... ең нашармын》
Dialogue: 0,0:21:25.35,0:21:28.68,Default,,0,0,0,,Мен шынымен кешірім сұраймын. Не болды, Адачи?
Dialogue: 0,0:21:28.68,0:21:31.02,Default,,0,0,0,,Сіз массыз ба?
Dialogue: 0,0:21:31.02,0:21:33.19,Default,,0,0,0,,《Бұл ең нашар.
Dialogue: 0,0:21:33.19,0:21:38.19,Default,,0,0,0,,Мен шынымен қулық туралы ойладым.
Dialogue: 0,0:21:38.19,0:21:40.90,Default,,0,0,0,,Мен Куросаваның байыптылығына жауап бере алмасам да》
Dialogue: 0,0:21:43.53,0:21:46.03,Default,,0,0,0,,Кешіріңіз, мен дүкенге тоқтай аламын ба?
Dialogue: 0,0:21:50.20,0:21:53.71,Default,,0,0,0,,Иә. иә?
Dialogue: 0,0:21:53.71,0:21:55.88,Default,,0,0,0,,Өйткені, бұл менің алғысым➡
Dialogue: 0,0:21:55.88,0:21:59.05,Default,,0,0,0,,Жақсылық сұрау жаман. Эх, жарайды, солай.
Dialogue: 0,0:21:59.05,0:22:02.05,Default,,0,0,0,,Ол үшін уайымдамаңыз... Жұмысыма көмектескеніңіз үшін рахмет➡
Dialogue: 0,0:22:02.05,0:22:04.22,Default,,0,0,0,,Маған қалуға рұқсат бергеніңіз үшін рахмет.
Dialogue: 0,0:22:04.22,0:22:06.99,Default,,0,0,0,,Бірақ мен енді тым жұмсақ болғым келмейді...
Dialogue: 0,0:22:06.99,0:22:09.09,Default,,0,0,0,,Ах.
Dialogue: 0,0:22:11.66,0:22:13.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:13.99,0:22:16.50,Default,,0,0,0,,Қалай болғанда да, кешіріңіз! Ах.
Dialogue: 0,0:22:26.51,0:22:29.01,Default,,0,0,0,,《Мен не істеуім керек?
Dialogue: 0,0:22:29.01,0:22:31.35,Default,,0,0,0,,Мен не істеуім керек еді➡
Dialogue: 0,0:22:31.35,0:22:34.85,Default,,0,0,0,,Менде ештеңе жоқ.
Dialogue: 0,0:22:34.85,0:22:38.35,Default,,0,0,0,,Куросаваның сол беті➡
Dialogue: 0,0:22:38.35,0:22:40.55,Default,,0,0,0,,Бірінші рет көрдім》
Dialogue: 0,0:22:43.19,0:22:46.09,Default,,0,0,0,,《Мен не істеуім керек...》
Dialogue: 0,0:24:20.99,0:24:29.50,Default,,0,0,0,,(Пернетақтаны түрту дыбысы)
Dialogue: 0,0:24:29.50,0:24:33.17,Default,,0,0,0,,Не болды? Осындай уақытта.
Dialogue: 0,0:24:33.17,0:24:36.84,Default,,0,0,0,,Маған бәрібір. Егер ол сіз туралы болса➡
Dialogue: 0,0:24:36.84,0:24:39.04,Default,,0,0,0,,Өйткені мен бәрінен де жақсы білемін.
Dialogue: 0,0:24:40.54,0:24:46.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
