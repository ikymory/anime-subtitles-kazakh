Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.13,0:00:13.98,Default,,0,0,0,,♬～
Dialogue: 0,0:00:13.98,0:00:16.18,Default,,0,0,0,,Басқаша айтқанда….
Dialogue: 0,0:00:18.65,0:00:21.05,Default,,0,0,0,,30 жасқа дейін пәк болдым➡
Dialogue: 0,0:00:21.05,0:00:24.29,Default,,0,0,0,,Енді сіз адамдардың ойын оқуға мүмкіндік беретін сиқырды пайдалана аласыз➡
Dialogue: 0,0:00:24.29,0:00:27.96,Default,,0,0,0,,Компаниядағы бір жігіт мені ұнататынын кездейсоқ білдім➡
Dialogue: 0,0:00:27.96,0:00:31.13,Default,,0,0,0,,Және….
Dialogue: 0,0:00:31.13,0:00:34.80,Default,,0,0,0,,Га. Сен не туралы айтып тұрсың?
Dialogue: 0,0:00:34.80,0:00:38.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:38.17,0:00:41.24,Default,,0,0,0,,Ха... бұл қоқыс.
Dialogue: 0,0:00:44.01,0:00:47.98,Default,,0,0,0,,Қыздар қиындатқанда қорқынышты.
Dialogue: 0,0:00:47.98,0:00:51.68,Default,,0,0,0,,Демек, бұл алдау емес!
Dialogue: 0,0:02:35.08,0:02:38.59,Default,,0,0,0,,Маған неге айтып тұрсың?
Dialogue: 0,0:02:38.59,0:02:41.39,Default,,0,0,0,,Өйткені Цюге романист➡
Dialogue: 0,0:02:41.39,0:02:44.23,Default,,0,0,0,,Сіздің тәжірибеңіз көп сияқты ма?
Dialogue: 0,0:02:44.23,0:02:46.90,Default,,0,0,0,,Сен менің колледжде болған жалғыз сыныптасымсың➡
Dialogue: 0,0:02:46.90,0:02:49.90,Default,,0,0,0,,Мен сөйлесетін ешкім жоқ.
Dialogue: 0,0:02:49.90,0:02:52.33,Default,,0,0,0,,Хмм….
Dialogue: 0,0:02:52.33,0:02:54.90,Default,,0,0,0,,Ал, сиқырды былай қойғанда➡
Dialogue: 0,0:02:54.90,0:02:59.44,Default,,0,0,0,,Менің ойымша, бұл үлкен мәселе емес. Білмейтіндей кейіп танытып, маған хабарлаңыз.
Dialogue: 0,0:02:59.44,0:03:04.01,Default,,0,0,0,,Олар сізге мейірімділік танытатын сияқты, сондықтан оларды жақсылап қарайық.
Dialogue: 0,0:03:04.01,0:03:07.42,Default,,0,0,0,,Иә? Бұл жақсы емес.
Dialogue: 0,0:03:07.42,0:03:12.42,Default,,0,0,0,,Неліктен? Мұны тіпті әйелдер де жасайды.
Dialogue: 0,0:03:12.42,0:03:14.62,Default,,0,0,0,,Бұл рас болуы мүмкін, бірақ...
Dialogue: 0,0:03:17.93,0:03:21.40,Default,,0,0,0,,《Мен Куросаваның ықыласына сене аламын ба? ➡
Dialogue: 0,0:03:21.40,0:03:24.77,Default,,0,0,0,,Мен де бұл туралы ойладым.
Dialogue: 0,0:03:24.77,0:03:29.74,Default,,0,0,0,,Жай ғана жақсы болу сіздің ерекше нәрсе істеп жатқаныңызды білдірмейді.
Dialogue: 0,0:03:29.74,0:03:31.77,Default,,0,0,0,,Бірақ…》
Dialogue: 0,0:03:31.77,0:03:36.61,Default,,0,0,0,,｟Менің ризашылығым болса да, саған біреудің қарауы жаман.
Dialogue: 0,0:03:36.61,0:03:38.61,Default,,0,0,0,,Қалай болғанда да, кешіріңіз! ｠
Dialogue: 0,0:03:41.58,0:03:44.12,Default,,0,0,0,,Га.
Dialogue: 0,0:03:44.12,0:03:47.76,Default,,0,0,0,,Басқа адам байсалды болса да, оның сезімін пайдаланып жатқан сияқты➡
Dialogue: 0,0:03:47.76,0:03:51.76,Default,,0,0,0,,Жаман емес...қолымнан келмейді.
Dialogue: 0,0:03:54.76,0:03:57.27,Default,,0,0,0,,Сондықтан сіз танымал емессіз.
Dialogue: 0,0:03:57.27,0:03:59.40,Default,,0,0,0,,Уф! Тым байыпты.
Dialogue: 0,0:03:59.40,0:04:01.44,Default,,0,0,0,,Арх! Тым ебедейсіз. Уф!
Dialogue: 0,0:04:01.44,0:04:04.57,Default,,0,0,0,,Тым сезімтал емес. Арх!
Dialogue: 0,0:04:04.57,0:04:07.58,Default,,0,0,0,,Шынымды айтсам, мен не істеуім керек еді? Не істеуім керек еді?➡
Dialogue: 0,0:04:07.58,0:04:11.01,Default,,0,0,0,,Мен оны мүлдем түсінбеймін.
Dialogue: 0,0:04:11.01,0:04:13.92,Default,,0,0,0,,Ал, басқа адам да сен туралы солай➡
Dialogue: 0,0:04:13.92,0:04:16.18,Default,,0,0,0,,Сізге ұнады деп ойлаймын.
Dialogue: 0,0:04:19.29,0:04:22.92,Default,,0,0,0,,Не істеу керектігін емес, басқа адам туралы көбірек ойлау керек➡
Dialogue: 0,0:04:22.92,0:04:26.39,Default,,0,0,0,,Мүмкін сіз не ойлайтыныңыз туралы ойлануыңыз керек.
Dialogue: 0,0:04:28.43,0:04:30.93,Default,,0,0,0,,Мен өзім...
Dialogue: 0,0:04:30.93,0:04:33.24,Default,,0,0,0,,Сонымен қатар, егер бұл әбігерге түссе ➡
Dialogue: 0,0:04:33.24,0:04:35.74,Default,,0,0,0,,Адамдар сізді ұнатпайтындай әрекет етудің де жолы бар.
Dialogue: 0,0:04:35.74,0:04:38.24,Default,,0,0,0,,Әй, күлшіл, күлшіл.
Dialogue: 0,0:04:38.24,0:04:40.44,Default,,0,0,0,,《Таңғажайып Цюге.
Dialogue: 0,0:04:40.44,0:04:43.08,Default,,0,0,0,,Роман жазушысы күткендей.
Dialogue: 0,0:04:43.08,0:04:45.75,Default,,0,0,0,,Сізбен кеңескеніме қуаныштымын》
Dialogue: 0,0:04:45.75,0:04:50.05,Default,,0,0,0,,Рахмет сізге Цюге. А, сен тайякиді жақсы көресің.
Dialogue: 0,0:04:50.05,0:04:53.92,Default,,0,0,0,,Тамақ іш, же. Хмм.
Dialogue: 0,0:04:53.92,0:04:56.42,Default,,0,0,0,,《Цюге: А, мен таң қалдым.
Dialogue: 0,0:04:56.42,0:04:59.59,Default,,0,0,0,,Бұл жігітке мен махаббатпен байланысы жоқ пәк қыз деп ойладым➡
Dialogue: 0,0:04:59.59,0:05:02.93,Default,,0,0,0,,Махаббат туралы кеңес беру туралы не ойлайсыз?
Dialogue: 0,0:05:02.93,0:05:04.93,Default,,0,0,0,,Ал, мен де➡
Dialogue: 0,0:05:04.93,0:05:07.44,Default,,0,0,0,,Мен қызбын.
Dialogue: 0,0:05:10.24,0:05:12.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:17.91,0:05:22.42,Default,,0,0,0,,《Жаңа ғана пәк қыз қыздан махаббат туралы сұрады.》
Dialogue: 0,0:05:22.42,0:05:25.09,Default,,0,0,0,,Оның мағынасы жоқ. иә?
Dialogue: 0,0:05:31.33,0:05:34.76,Default,,0,0,0,,｟Цюге: Сіз басқа адам туралы не ойлайсыз➡
Dialogue: 0,0:05:34.76,0:05:36.77,Default,,0,0,0,,Бұл туралы ойлану керек шығар｠
Dialogue: 0,0:05:39.73,0:05:43.61,Default,,0,0,0,,《Куросава туралы не ойлаймын?
Dialogue: 0,0:05:43.61,0:05:48.08,Default,,0,0,0,,Ол өте жақсы жігіт, мен онымен бірге болғанды ұнатамын➡
Dialogue: 0,0:05:48.08,0:05:50.58,Default,,0,0,0,,Ер адамның көзқарасы бойынша да керемет➡
Dialogue: 0,0:05:50.58,0:05:52.68,Default,,0,0,0,,Ол мейірімді...》
Dialogue: 0,0:05:54.92,0:05:58.09,Default,,0,0,0,,Жоқ. Тағы да айтамын, бұл жерде маған ұнамайтын нәрсе жоқ!
Dialogue: 0,0:06:08.93,0:06:14.07,Default,,0,0,0,,《Егер менімен аралассаң, шынымен мейірімді болатыныңа сенімдімін.
Dialogue: 0,0:06:14.07,0:06:16.67,Default,,0,0,0,,Мен сонда қалған күннің өзінде ол маған таңғы ас дайындады...》
Dialogue: 0,0:06:20.51,0:06:22.71,Default,,0,0,0,,｟Ахмм.
Dialogue: 0,0:06:25.41,0:06:28.25,Default,,0,0,0,,Адачи Мен осындамын.
Dialogue: 0,0:06:28.25,0:06:30.42,Default,,0,0,0,,Иә? ｠
Dialogue: 0,0:06:35.89,0:06:37.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:37.93,0:06:41.76,Default,,0,0,0,,Мүмкін емес! Мүмкін емес! Бұл тым қатты, Адачи.
Dialogue: 0,0:06:41.76,0:06:44.43,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:06:48.64,0:06:50.71,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:07:05.92,0:07:09.09,Default,,0,0,0,,《Мен кеше үйге осылай бардым》
Dialogue: 0,0:07:12.76,0:07:16.26,Default,,0,0,0,,《Куросава неге сонша күлкілі?》
Dialogue: 0,0:07:16.26,0:07:18.27,Default,,0,0,0,,Күткеніңізге рахмет.
Dialogue: 0,0:07:18.27,0:07:21.20,Default,,0,0,0,,《Мен ешкімнен бос емес болсам да➡
Dialogue: 0,0:07:21.20,0:07:24.94,Default,,0,0,0,,Ол сондай жақсы жігіт➡
Dialogue: 0,0:07:24.94,0:07:27.11,Default,,0,0,0,,Депрессия…》
Dialogue: 0,0:07:32.11,0:07:34.62,Default,,0,0,0,,Сіз ауыстыруды ұсына аласыз ба? (Фудзисаки) Иә.
Dialogue: 0,0:07:36.58,0:07:38.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:45.43,0:07:49.26,Default,,0,0,0,,Сен берген шайды неге қайтарып алдың?
Dialogue: 0,0:07:49.26,0:07:52.90,Default,,0,0,0,,Тәжірибесіздігім үшін кешірім сұраймын.
Dialogue: 0,0:07:52.90,0:07:57.07,Default,,0,0,0,,《Куросава, бірдеңе дұрыс емес пе? 》
Dialogue: 0,0:07:57.07,0:08:00.94,Default,,0,0,0,,Кешірім сұраймыз. Сен де түсінбейсің.
Dialogue: 0,0:08:00.94,0:08:04.48,Default,,0,0,0,,Менің айтқым келгені бұл емес!
Dialogue: 0,0:08:04.48,0:08:07.28,Default,,0,0,0,,Не болып жатыр? Бұл Куросаваның орны сияқты.
Dialogue: 0,0:08:07.28,0:08:11.62,Default,,0,0,0,,Иә? Фудзисаки.
Dialogue: 0,0:08:11.62,0:08:16.26,Default,,0,0,0,,Куросава, не болды? Тұтынушы кенеттен бақытсыз болып қалады...
Dialogue: 0,0:08:16.26,0:08:18.76,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:08:18.76,0:08:21.93,Default,,0,0,0,,Сату бөлімінің эйси сирек кездеседі.
Dialogue: 0,0:08:21.93,0:08:26.60,Default,,0,0,0,,Куросава мырза себебін білмегендіктен қиналып жатқан сияқты...
Dialogue: 0,0:08:26.60,0:08:30.11,Default,,0,0,0,,Бұл оқиға ешқашан болмаған сияқты көрейік.
Dialogue: 0,0:08:30.11,0:08:32.74,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:08:32.74,0:08:35.74,Default,,0,0,0,,Кедей Куросава-сенпай.
Dialogue: 0,0:08:35.74,0:08:40.42,Default,,0,0,0,,Саған кофе берсем болады ма?
Dialogue: 0,0:08:40.42,0:08:42.42,Default,,0,0,0,,Мен барамын. иә?
Dialogue: 0,0:08:44.79,0:08:46.99,Default,,0,0,0,,Тш, кешіріңіз.
Dialogue: 0,0:08:50.39,0:08:54.06,Default,,0,0,0,,Адачи…. Кофе.
Dialogue: 0,0:09:03.81,0:09:06.11,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:06.11,0:09:08.94,Default,,0,0,0,,Біз сізге бірден әдеттегі заттарды дайындаймыз.
Dialogue: 0,0:09:08.94,0:09:11.61,Default,,0,0,0,,Күте тұрыңыз. Хмм.
Dialogue: 0,0:09:24.59,0:09:29.10,Default,,0,0,0,,Мен бұл оқиғаны жалғастырсам да...
Dialogue: 0,0:09:29.10,0:09:33.03,Default,,0,0,0,,Ал, мен қарсы емеспін.
Dialogue: 0,0:09:33.03,0:09:35.10,Default,,0,0,0,,Хаха….
Dialogue: 0,0:09:35.10,0:09:38.64,Default,,0,0,0,,Шамасы, оның шын мәнінде тәтті тістері бар. Сол президент.
Dialogue: 0,0:09:38.64,0:09:40.78,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:09:40.78,0:09:44.18,Default,,0,0,0,,Мен оны бұлай көре алмаймын, өйткені ол өте қорқынышты.
Dialogue: 0,0:09:48.58,0:09:51.29,Default,,0,0,0,,Менің үйімде біз үнемі торт аламыз➡
Dialogue: 0,0:09:51.29,0:09:54.66,Default,,0,0,0,,Сіз оны асыға күткен сияқтысыз.
Dialogue: 0,0:09:54.66,0:09:58.16,Default,,0,0,0,,Мен ешқашан ренішімнің себебі торт деп күткен емеспін.
Dialogue: 0,0:09:58.16,0:10:02.60,Default,,0,0,0,,Керісінше, ол тамақ ішкенде үнемі ашулы көрінеді...
Dialogue: 0,0:10:02.60,0:10:05.43,Default,,0,0,0,,Менің ойымша, сіз тәттілерді ұнатпайсыз.
Dialogue: 0,0:10:05.43,0:10:09.00,Default,,0,0,0,,Сонда да мен тәттілерді жақсы көремін!
Dialogue: 0,0:10:09.00,0:10:11.61,Default,,0,0,0,,Сіз мұны өте жақсы байқадыңыз, Адачи.
Dialogue: 0,0:10:11.61,0:10:13.88,Default,,0,0,0,,А... бұл жай ғана болжам.
Dialogue: 0,0:10:17.78,0:10:20.12,Default,,0,0,0,,Ах.
Dialogue: 0,0:10:20.12,0:10:22.12,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:10:25.19,0:10:27.49,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:10:36.10,0:10:38.17,Default,,0,0,0,,Мен материалдарды әкелдім.
Dialogue: 0,0:10:40.74,0:10:43.74,Default,,0,0,0,,Жоқ. Маған тағы да артық жұмыс істеуге тура келеді.
Dialogue: 0,0:10:46.61,0:10:49.74,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:10:49.74,0:10:52.91,Default,,0,0,0,,Адачи, бүгінгі еңбек сіңірген қайраткер!
Dialogue: 0,0:10:52.91,0:10:54.92,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:58.79,0:11:02.86,Default,,0,0,0,,Куросава-сенпай, еңбегіңіз үшін рахмет.
Dialogue: 0,0:11:02.86,0:11:06.39,Default,,0,0,0,,Біраз уақыт болды менің басымнан тайып.
Dialogue: 0,0:11:06.39,0:11:09.46,Default,,0,0,0,,Сізге рахмет, бұл мені шынымен құтқарды.
Dialogue: 0,0:11:09.46,0:11:12.07,Default,,0,0,0,,А... иә.
Dialogue: 0,0:11:12.07,0:11:16.07,Default,,0,0,0,,Әй, ойын ойнайық? Қандай ойын?
Dialogue: 0,0:11:16.07,0:11:18.91,Default,,0,0,0,,Бұл 4-4 жыныс!
Dialogue: 0,0:11:18.91,0:11:22.58,Default,,0,0,0,,Қараңызшы, мұнда да бір рет қолданылатын таяқшалар бар!
Dialogue: 0,0:11:22.58,0:11:26.48,Default,,0,0,0,,《Алғашында мен ойладым, шынымен, бұл неге соншалықты ақымақ сиқыр?➡
Dialogue: 0,0:11:26.48,0:11:28.75,Default,,0,0,0,,Мен солай ойладым➡
Dialogue: 0,0:11:28.75,0:11:31.75,Default,,0,0,0,,Мен алғаш рет осындай күшке ие болғаныма қуаныштымын.
Dialogue: 0,0:11:38.76,0:11:42.23,Default,,0,0,0,,Бұл патша ма?
Dialogue: 0,0:11:42.23,0:11:44.93,Default,,0,0,0,,Иә, мен!
Dialogue: 0,0:11:44.93,0:11:46.94,Default,,0,0,0,,Онда мен саған бұйрық беремін!
Dialogue: 0,0:11:46.94,0:11:49.90,Default,,0,0,0,,Ал, 3 саны мен 8 саны➡
Dialogue: 0,0:11:49.90,0:11:52.91,Default,,0,0,0,,Поцелу!
Dialogue: 0,0:11:52.91,0:11:56.98,Default,,0,0,0,,Мен... Мен 3-ші нөмірмін. (Қызметкерлер) О.
Dialogue: 0,0:11:56.98,0:12:00.25,Default,,0,0,0,,8 саны ше? Е, кім?
Dialogue: 0,0:12:00.25,0:12:02.65,Default,,0,0,0,,Кім?
Dialogue: 0,0:12:06.12,0:12:08.69,Default,,0,0,0,,Иә! ? мен?
Dialogue: 0,0:12:11.39,0:12:14.26,Default,,0,0,0,,О!
Dialogue: 0,0:12:14.26,0:12:18.93,Default,,0,0,0,,Поцелу! Сүйіңіз! ''Бұл менің алғашқы сүйісім!
Dialogue: 0,0:12:18.93,0:12:21.20,Default,,0,0,0,,Оның үстіне қарсылас – Куросава...》
Dialogue: 0,0:12:23.57,0:12:26.24,Default,,0,0,0,,Барлығымыз көп ішіп жатқан жоқпыз ба?
Dialogue: 0,0:12:26.24,0:12:30.75,Default,,0,0,0,,《Сіз оны ала аласыз ба, бұл танымал адам?》
Dialogue: 0,0:12:30.75,0:12:33.65,Default,,0,0,0,,Патшаның бұйрықтары абсолютті!
Dialogue: 0,0:12:33.65,0:12:38.59,Default,,0,0,0,,Zettai! Сүйіңіз! Сүйіңіз!
Dialogue: 0,0:12:38.59,0:12:44.96,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:12:44.96,0:12:47.60,Default,,0,0,0,,Бұл ойын, ендеше тез ойнайық.
Dialogue: 0,0:12:47.60,0:12:49.66,Default,,0,0,0,,А... не?
Dialogue: 0,0:13:06.61,0:13:08.62,Default,,0,0,0,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:13:10.62,0:13:13.29,Default,,0,0,0,,Жарайды, болды!
Dialogue: 0,0:13:13.29,0:13:16.16,Default,,0,0,0,,Иә. Маңдай.
Dialogue: 0,0:13:16.16,0:13:21.20,Default,,0,0,0,,Бұл қызықсыз. Патша ойынында сүйіңіз➡
Dialogue: 0,0:13:21.20,0:13:24.10,Default,,0,0,0,,Бұл күндері шықты.
Dialogue: 0,0:13:24.10,0:13:26.10,Default,,0,0,0,,Мен телефон соғамын.
Dialogue: 0,0:13:32.04,0:13:34.58,Default,,0,0,0,,｟《Кешіріңіз》｠
Dialogue: 0,0:13:34.58,0:13:36.64,Default,,0,0,0,,《Куросава…》
Dialogue: 0,0:14:14.08,0:14:18.02,Default,,0,0,0,,болды. Куросава?
Dialogue: 0,0:14:18.02,0:14:21.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:21.06,0:14:24.33,Default,,0,0,0,,Мм... жақсысың ба?
Dialogue: 0,0:14:28.03,0:14:30.63,Default,,0,0,0,,Ах. Мен аздап көп ішіп алдым деп ойлаймын.
Dialogue: 0,0:14:36.20,0:14:38.21,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:14:46.68,0:14:51.39,Default,,0,0,0,,Дегенмен, бәрі тым қатты қадалып жатыр.
Dialogue: 0,0:14:51.39,0:14:55.36,Default,,0,0,0,,《Жақсы идея болар деп ойладым...》
Dialogue: 0,0:14:55.36,0:14:57.66,Default,,0,0,0,,Ер адамдар арасындағы сүйісу.
Dialogue: 0,0:15:01.20,0:15:04.20,Default,,0,0,0,,《Мен сенің соншалықты қатып қалғаныңа сене алар емеспін➡
Dialogue: 0,0:15:04.20,0:15:07.07,Default,,0,0,0,,Ер адаммен...》
Dialogue: 0,0:15:07.07,0:15:09.67,Default,,0,0,0,,Әдетте маған ұнамайды. Эй?
Dialogue: 0,0:15:11.87,0:15:15.88,Default,,0,0,0,,《Кешіріңіз Адачи.
Dialogue: 0,0:15:15.88,0:15:18.05,Default,,0,0,0,,Ғашық болу...》
Dialogue: 0,0:15:21.05,0:15:23.02,Default,,0,0,0,,《》
Dialogue: 0,0:15:26.55,0:15:28.62,Default,,0,0,0,,Маған ұнамады.
Dialogue: 0,0:15:31.23,0:15:33.59,Default,,0,0,0,,Маған ұнамады.
Dialogue: 0,0:15:37.06,0:15:40.64,Default,,0,0,0,,《Мен де таң қалдым➡
Dialogue: 0,0:15:40.64,0:15:42.90,Default,,0,0,0,,Маған ұнамады》
Dialogue: 0,0:15:45.54,0:15:49.04,Default,,0,0,0,,Мен... Негізі мен сені ешқашан сүйген емеспін.
Dialogue: 0,0:15:49.04,0:15:51.55,Default,,0,0,0,,Иә? О, күлме.
Dialogue: 0,0:15:53.75,0:15:56.62,Default,,0,0,0,,Жоқ, шынымен, көріп тұрғаныңыздай➡
Dialogue: 0,0:15:56.62,0:15:59.22,Default,,0,0,0,,Мен... Мен танымал емеспін.
Dialogue: 0,0:15:59.22,0:16:01.62,Default,,0,0,0,,Менде махаббат тәжірибесі жоқ.
Dialogue: 0,0:16:04.56,0:16:10.03,Default,,0,0,0,,Бұл мені қатты қобалжытты➡
Dialogue: 0,0:16:10.03,0:16:12.73,Default,,0,0,0,,Мен қорқып кеттім.
Dialogue: 0,0:16:12.73,0:16:16.87,Default,,0,0,0,,《Мен... сен не айтып тұрсың?
Dialogue: 0,0:16:16.87,0:16:19.57,Default,,0,0,0,,Егер мен осындай нәрсені айтсам, мен сенімдімін➡
Dialogue: 0,0:16:19.57,0:16:23.21,Default,,0,0,0,,Енді артқа жол жоқ. Бірақ…》
Dialogue: 0,0:16:23.21,0:16:26.55,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:16:26.55,0:16:29.35,Default,,0,0,0,,Бұл маған ұнамайтын сияқты...
Dialogue: 0,0:16:45.40,0:16:49.07,Default,,0,0,0,,Бұл нені білдіреді➡
Dialogue: 0,0:16:49.07,0:16:51.14,Default,,0,0,0,,Сіз түсіндім дейсіз бе?
Dialogue: 0,0:16:58.58,0:17:02.38,Default,,0,0,0,,``Бұл нені білдіреді?''
Dialogue: 0,0:17:02.38,0:17:07.29,Default,,0,0,0,,Мен бұл туралы Цюге айтқаннан бері ойлап келемін.
Dialogue: 0,0:17:07.29,0:17:10.89,Default,,0,0,0,,Мен Куросава туралы не ойлаймын➡
Dialogue: 0,0:17:10.89,0:17:13.43,Default,,0,0,0,,Мәңгі.
Dialogue: 0,0:17:13.43,0:17:15.90,Default,,0,0,0,,Мен де Куросаваға көмектескім келді...》
Dialogue: 0,0:17:18.07,0:17:22.00,Default,,0,0,0,,《Мен өзімді жаман сезінбедім➡
Dialogue: 0,0:17:22.00,0:17:26.41,Default,,0,0,0,,Мен Куросаваның мұңды түрін көргім келмеді➡
Dialogue: 0,0:17:26.41,0:17:29.08,Default,,0,0,0,,Мұның бәрі өтірік емес》
Dialogue: 0,0:17:35.42,0:17:39.75,Default,,0,0,0,,《Сиқырмен енді жүрегімнің дауысын естідім➡
Dialogue: 0,0:17:39.75,0:17:45.56,Default,,0,0,0,,Алғашында оның мұндай күш-қуаты неліктен бар деп ойладым➡
Dialogue: 0,0:17:45.56,0:17:49.76,Default,,0,0,0,,Мен Куросаваның жүрегіне қайта-қайта тиген сайын➡
Dialogue: 0,0:17:49.76,0:17:54.24,Default,,0,0,0,,Мен алғаш рет бұл жігіт туралы көбірек білгім келді.
Dialogue: 0,0:18:01.91,0:18:03.91,Default,,0,0,0,,Ах.
Dialogue: 0,0:18:03.91,0:18:08.28,Default,,0,0,0,,Куросава…. Адачи….
Dialogue: 0,0:18:08.28,0:18:11.32,Default,,0,0,0,,Мен…. (есіктің ашылған дыбысы)
Dialogue: 0,0:18:11.32,0:18:14.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:14.19,0:18:18.06,Default,,0,0,0,,Ах! Мен осындай жерде болдым!
Dialogue: 0,0:18:18.06,0:18:20.60,Default,,0,0,0,,Куросава-сенпай!
Dialogue: 0,0:18:20.60,0:18:24.13,Default,,0,0,0,,Иә? Сен не істеп жатырсың?
Dialogue: 0,0:18:24.13,0:18:27.37,Default,,0,0,0,,А... шынымен емес...
Dialogue: 0,0:18:27.37,0:18:29.74,Default,,0,0,0,,Ол ашылғалы тұрған сияқты.
Dialogue: 0,0:18:29.74,0:18:32.54,Default,,0,0,0,,Кассаға өтіңіз!
Dialogue: 0,0:18:32.54,0:18:35.21,Default,,0,0,0,,Ах.
Dialogue: 0,0:18:35.21,0:18:38.55,Default,,0,0,0,,Сіз байсалдысыз ба? Басқасына барайық!
Dialogue: 0,0:18:38.55,0:18:41.12,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:18:44.72,0:18:47.22,Default,,0,0,0,,《Жаңа не айттың?》
Dialogue: 0,0:18:49.79,0:18:53.09,Default,,0,0,0,,｟Адачи I...｠
Dialogue: 0,0:18:53.09,0:18:57.06,Default,,0,0,0,,《Мен саған тиісе алмаймын деп жеңілдеп қалдым...》
Dialogue: 0,0:18:57.06,0:19:01.00,Default,,0,0,0,,Адачи Соңғы пойыздың уақыты жақсы ма?
Dialogue: 0,0:19:01.00,0:19:03.07,Default,,0,0,0,,《Білгім келеді...》
Dialogue: 0,0:19:03.07,0:19:06.57,Default,,0,0,0,,Әй, асығыс болсаң, жақсы болады...
Dialogue: 0,0:19:08.61,0:19:12.15,Default,,0,0,0,,Жақсы. Енді менімен бірге қалма.
Dialogue: 0,0:19:12.15,0:19:14.88,Default,,0,0,0,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:19:14.88,0:19:18.79,Default,,0,0,0,,《Мен сені бүгін кешке үйге жібермеймін.》
Dialogue: 0,0:19:18.79,0:19:23.52,Default,,0,0,0,,Эй... Мен үйге бара жатырмын!
Dialogue: 0,0:19:23.52,0:19:26.03,Default,,0,0,0,,Мен үйге бара жатырмын!
Dialogue: 0,0:19:30.53,0:19:34.20,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:34.20,0:19:36.90,Default,,0,0,0,,Күте тұрыңыз, келесі кездескенімізде сұраймын.
Dialogue: 0,0:19:41.08,0:19:44.38,Default,,0,0,0,,☎
Dialogue: 0,0:19:44.38,0:19:47.72,Default,,0,0,0,,Иә, бұл Тоёкаваның сату бөлімі.
Dialogue: 0,0:19:47.72,0:19:50.55,Default,,0,0,0,,Көмегің үшін рахмет. Сәлем Адачи.
Dialogue: 0,0:19:50.55,0:19:53.92,Default,,0,0,0,,Albireo компаниясына жіберілетін келісімшарт дайын ба?
Dialogue: 0,0:19:53.92,0:19:57.49,Default,,0,0,0,,Иә. Мен қазір жіберемін.
Dialogue: 0,0:19:57.49,0:20:00.76,Default,,0,0,0,,Күте тұрыңыз. Куросава мырза➡
Dialogue: 0,0:20:00.76,0:20:04.40,Default,,0,0,0,,Бұл Наганума Шоджидің қоңырауы.
Dialogue: 0,0:20:04.40,0:20:07.77,Default,,0,0,0,,Күткеніңізге рахмет.
Dialogue: 0,0:20:07.77,0:20:10.77,Default,,0,0,0,,Иә. Бұл өткен аптада мен айтқан нәрсе.
Dialogue: 0,0:20:10.77,0:20:14.38,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:14.38,0:20:17.68,Default,,0,0,0,,《Жапонияда көп нәрсе болды》
Dialogue: 0,0:20:23.12,0:20:25.02,Default,,0,0,0,,｟Мен оны ұнатпаймын дедім➡
Dialogue: 0,0:20:25.02,0:20:28.89,Default,,0,0,0,,Ауыз емес, маңдайда деген мағына береді!
Dialogue: 0,0:20:28.89,0:20:30.86,Default,,0,0,0,,Ах...｠
Dialogue: 0,0:20:37.73,0:20:41.74,Default,,0,0,0,,《Бүгін таң қаларлықтай әдеттегідей.
Dialogue: 0,0:20:41.74,0:20:45.71,Default,,0,0,0,,Бұл әдеттегіден көп айырмашылығы жоқ➡
Dialogue: 0,0:20:45.71,0:20:50.21,Default,,0,0,0,,Куросава: Сіз не ойлап отырсыз?
Dialogue: 0,0:20:50.21,0:20:53.78,Default,,0,0,0,,Мен қатты уайымдасам да...》
Dialogue: 0,0:20:53.78,0:20:58.35,Default,,0,0,0,,Адачи? Ах. О, ой.
Dialogue: 0,0:20:58.35,0:21:02.02,Default,,0,0,0,,Маған Albireo-ға жіберу үшін деректерді көрсете аласыз ба?
Dialogue: 0,0:21:02.02,0:21:05.63,Default,,0,0,0,,А, мен оны қазір басып шығарғалы жатырмын.
Dialogue: 0,0:21:16.90,0:21:19.87,Default,,0,0,0,,《Кеше мен жек көрмейтінімді білдім➡
Dialogue: 0,0:21:19.87,0:21:24.04,Default,,0,0,0,,Қуансам да, тым асықтым.
Dialogue: 0,0:21:26.21,0:21:28.58,Default,,0,0,0,,《Мен қиындық тудырғым келмейді➡
Dialogue: 0,0:21:28.58,0:21:30.85,Default,,0,0,0,,Жұмыста әдеттегідей болыңыз》
Dialogue: 0,0:21:33.22,0:21:37.86,Default,,0,0,0,,《Куросава... Мен әр уақытта әрекет етуде қиналамын➡
Dialogue: 0,0:21:37.86,0:21:41.03,Default,,0,0,0,,Бұл мен үшін шынымен босқа кетті➡
Dialogue: 0,0:21:41.03,0:21:43.36,Default,,0,0,0,,Ол жақсы жігіт》
Dialogue: 0,0:21:43.36,0:21:46.03,Default,,0,0,0,,Рахмет. иә?
Dialogue: 0,0:21:46.03,0:21:48.04,Default,,0,0,0,,Аа, ол емес.
Dialogue: 0,0:21:50.47,0:21:53.54,Default,,0,0,0,,《Махаббатта тәжірибесі жоқ деді...》
Dialogue: 0,0:21:53.54,0:21:55.58,Default,,0,0,0,,Ах.
Dialogue: 0,0:21:55.58,0:21:58.21,Default,,0,0,0,,《Асықпа, баяу қабылда➡
Dialogue: 0,0:21:58.21,0:22:01.38,Default,,0,0,0,,Уақытыңызды бөліп, оның құлап кетуіне көз жеткізіңіз》
Dialogue: 0,0:22:06.05,0:22:08.02,Default,,0,0,0,,Осы жолмен.
Dialogue: 0,0:22:13.19,0:22:17.06,Default,,0,0,0,,《Бас тартатын сымбатты жігіт➡
Dialogue: 0,0:22:17.06,0:22:19.07,Default,,0,0,0,,Өте қорқынышты》
Dialogue: 0,0:22:20.57,0:22:26.57,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
