Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:38.96,0:01:42.93,Default,,0,0,0,,Ах…. Менің жүрегім енді күшті емес!
Dialogue: 0,0:01:42.93,0:01:45.93,Default,,0,0,0,,Мен тезірек оралуым керек.
Dialogue: 0,0:01:45.93,0:01:48.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:01:50.10,0:01:53.47,Default,,0,0,0,,Бүгін алған құлаққап шығар➡
Dialogue: 0,0:01:53.47,0:01:55.78,Default,,0,0,0,,Сіз оны жоғалтқанымды білесіз бе?
Dialogue: 0,0:01:55.78,0:01:59.75,Default,,0,0,0,,Ах... ой-о.
Dialogue: 0,0:01:59.75,0:02:03.18,Default,,0,0,0,,Мен солай ойлаймын. Мен таң қалдым.
Dialogue: 0,0:02:03.18,0:02:05.95,Default,,0,0,0,,Кешіріңіз. Бұл жай ғана менің сезімім➡
Dialogue: 0,0:02:05.95,0:02:08.92,Default,,0,0,0,,Мен ненің жақсы екенін білмеймін ...
Dialogue: 0,0:02:08.92,0:02:12.09,Default,,0,0,0,,Адачи.
Dialogue: 0,0:02:12.09,0:02:16.43,Default,,0,0,0,,Мен Адачи таңдағанына риза болар едім.
Dialogue: 0,0:02:16.43,0:02:18.63,Default,,0,0,0,,О, ой.
Dialogue: 0,0:02:18.63,0:02:23.04,Default,,0,0,0,,Сондай-ақ, Адачи бірден ``маған бұл ұнамайды''➡ дейді
Dialogue: 0,0:02:23.04,0:02:25.10,Default,,0,0,0,,Бір жақсысы сіз оны түсінбейсіз➡
Dialogue: 0,0:02:25.10,0:02:30.11,Default,,0,0,0,,Олар көп, олай айтпа.
Dialogue: 0,0:02:30.11,0:02:32.14,Default,,0,0,0,,Эй.
Dialogue: 0,0:02:32.14,0:02:34.18,Default,,0,0,0,,《Сенімділікпен》
Dialogue: 0,0:02:34.18,0:02:36.22,Default,,0,0,0,,Сену. Ах!
Dialogue: 0,0:02:36.22,0:02:38.95,Default,,0,0,0,,《Мен саған Адачи туралы жақсы нәрселерді айтамын》
Dialogue: 0,0:02:38.95,0:02:42.29,Default,,0,0,0,,Уау! Түсінікті! сеніңіз сеніңіз!
Dialogue: 0,0:02:42.29,0:02:45.63,Default,,0,0,0,,《Менің қайшылықтарым қандай болды...》
Dialogue: 0,0:02:45.63,0:02:48.59,Default,,0,0,0,,Сонымен, мен ең қалайтын сыйлық➡
Dialogue: 0,0:02:48.59,0:02:51.30,Default,,0,0,0,,Мен түсіндім. иә?
Dialogue: 0,0:02:51.30,0:02:54.27,Default,,0,0,0,,Бірінші поцелу... солай ма?
Dialogue: 0,0:02:57.17,0:03:00.21,Default,,0,0,0,,《Мүмкін емес...》
Dialogue: 0,0:03:00.21,0:03:03.91,Default,,0,0,0,,Сауалнама толтырған болсаңыз, сыйлығыңызды алыңыз.
Dialogue: 0,0:03:03.91,0:03:06.45,Default,,0,0,0,,Кешіріңіз. Иә.
Dialogue: 0,0:03:06.45,0:03:08.61,Default,,0,0,0,,Сауалнаманы әлі толтырған жоқсыз, солай ма?
Dialogue: 0,0:03:08.61,0:03:11.48,Default,,0,0,0,,Мен тез жауап беремін. (Цуге) А-а, бұл жаман.
Dialogue: 0,0:03:13.79,0:03:18.42,Default,,0,0,0,,《Цюге: Бұл біртүрлі. Біз колледжден бері доспыз➡
Dialogue: 0,0:03:18.42,0:03:20.96,Default,,0,0,0,,Тым алыс.
Dialogue: 0,0:03:20.96,0:03:25.43,Default,,0,0,0,,Дәлірек айтсақ, Минато біржақты түрде одан аулақ болатын бөлім бар.
Dialogue: 0,0:03:25.43,0:03:29.40,Default,,0,0,0,,Егер атмосфера соншалықты оғаш болса, Минатоны шақыру үшін мониторды сылтау ретінде пайдаланыңыз➡
Dialogue: 0,0:03:29.40,0:03:32.27,Default,,0,0,0,,Осыншама қулық-сұм болмасам ғой.
Dialogue: 0,0:03:32.27,0:03:35.91,Default,,0,0,0,,Схемаларға тәуелді, стратег болу деген осы.
Dialogue: 0,0:03:35.91,0:03:38.61,Default,,0,0,0,,Сізде қиындық бар ма? Ах.
Dialogue: 0,0:03:38.61,0:03:42.11,Default,,0,0,0,,А, а. Бұл туралы не істеуім керек?
Dialogue: 0,0:03:42.11,0:03:45.79,Default,,0,0,0,,Ал, ең алдымен... кешіріңіз.
Dialogue: 0,0:03:45.79,0:03:49.42,Default,,0,0,0,,Цюге: Мен бірінші боламын. Ах.
Dialogue: 0,0:03:49.42,0:03:51.46,Default,,0,0,0,,《Цугэ: Бұл анық》
Dialogue: 0,0:03:51.46,0:03:56.10,Default,,0,0,0,,《Алтыбұрыш: Хмм, мұны болдырмауға болады деп ойлаймын.》
Dialogue: 0,0:03:56.10,0:03:58.76,Default,,0,0,0,,Осы арқылы пішінге өту мүмкін болса...
Dialogue: 0,0:03:58.76,0:04:03.44,Default,,0,0,0,,《Алтыбұрыш: Әрине. Мен жұмыс іздеу себептерімен клубты тастаған адам болдым.
Dialogue: 0,0:04:03.44,0:04:05.61,Default,,0,0,0,,《Солай ма?》
Dialogue: 0,0:04:05.61,0:04:09.61,Default,,0,0,0,,《Алтыбұрыш: Біріншіден, ол сияқты менің талантым жоқ еді...》
Dialogue: 0,0:04:09.61,0:04:13.28,Default,,0,0,0,,Осы жерге енгізіңіз….
Dialogue: 0,0:04:13.28,0:04:16.78,Default,,0,0,0,,Бұл жақсы! А, сәлем.
Dialogue: 0,0:04:16.78,0:04:19.09,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:04:21.19,0:04:23.56,Default,,0,0,0,,Сыйлық затын қабылдаңыз!
Dialogue: 0,0:04:26.43,0:04:29.10,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:29.10,0:04:31.60,Default,,0,0,0,,Жақсы жұмыс. Монитор қалай болды?
Dialogue: 0,0:04:31.60,0:04:33.77,Default,,0,0,0,,Аа, ол сәтті аяқталды.
Dialogue: 0,0:04:33.77,0:04:37.10,Default,,0,0,0,,Кешіріңіз, бірақ мен сауалнама нәтижелерін бірден ала аламын ба?
Dialogue: 0,0:04:37.10,0:04:39.94,Default,,0,0,0,,Сіз аласыз. Адачи мырза жасаған пішін➡
Dialogue: 0,0:04:39.94,0:04:43.11,Default,,0,0,0,,Иә. Бұл рас па? Ол көмектеседі.
Dialogue: 0,0:04:43.11,0:04:45.24,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:04:45.24,0:04:48.28,Default,,0,0,0,,Адачи мұны жасады ма? Бұл дұрыс.
Dialogue: 0,0:04:48.28,0:04:50.92,Default,,0,0,0,,Деректерді кестелеу қиындықтарын үнемдеу әлдеқайда оңай.
Dialogue: 0,0:04:50.92,0:04:53.45,Default,,0,0,0,,Иә. Сол Адачи-сан➡
Dialogue: 0,0:04:53.45,0:04:56.82,Default,,0,0,0,,Мен бір жерге бара алмаймын.
Dialogue: 0,0:04:56.82,0:04:59.93,Default,,0,0,0,,Кешіріңіз, алтыбұрыш. Ах! Куросава да!
Dialogue: 0,0:04:59.93,0:05:03.43,Default,,0,0,0,,Сіз қайда болдыңыз? Мен тазалауды бастаймын.
Dialogue: 0,0:05:03.43,0:05:05.77,Default,,0,0,0,,Нашар Мен мұны бірден жасаймын.
Dialogue: 0,0:05:05.77,0:05:10.44,Default,,0,0,0,,Мен сізге деректерді жібердім. О, рахмет.
Dialogue: 0,0:05:10.44,0:05:12.74,Default,,0,0,0,,Түсіндім, Адачи...
Dialogue: 0,0:05:15.44,0:05:17.41,Default,,0,0,0,,А, бұл….
Dialogue: 0,0:05:22.08,0:05:24.42,Default,,0,0,0,,Кеш болды. Кешіріңіз.
Dialogue: 0,0:05:24.42,0:05:28.25,Default,,0,0,0,,Хмм... Минато... Сыйлық ше?
Dialogue: 0,0:05:28.25,0:05:32.93,Default,,0,0,0,,Аа, ұмытып кетіппін. Бірақ жақсы.
Dialogue: 0,0:05:32.93,0:05:36.56,Default,,0,0,0,,Мен Минатоның сыныптасы сонда болады деп ешқашан ойламадым...
Dialogue: 0,0:05:36.56,0:05:41.10,Default,,0,0,0,,Қандай керемет сәйкестік. Бұл дұрыс.
Dialogue: 0,0:05:41.10,0:05:43.77,Default,,0,0,0,,Бұл таңқаларлық. Университетте оқып жүрген кезім➡
Dialogue: 0,0:05:43.77,0:05:46.11,Default,,0,0,0,,Біз бірге ақымақ істермен айналыстық.
Dialogue: 0,0:05:46.11,0:05:49.01,Default,,0,0,0,,Осы үлкен ғимаратта костюм киіп жұмыс істеу...
Dialogue: 0,0:05:51.21,0:05:55.28,Default,,0,0,0,,Менен айырмашылығы, ол әлі күнге дейін толық емес жұмыс күні.
Dialogue: 0,0:05:55.28,0:05:57.45,Default,,0,0,0,,《Бұл сезім есімде》
Dialogue: 0,0:05:59.59,0:06:01.95,Default,,0,0,0,,《Цюге: Сатылғанға дейін мен қатты жұмыс істедім➡
Dialogue: 0,0:06:01.95,0:06:05.26,Default,,0,0,0,,Адачимен салыстырғанда менде ➡ ештеңе жоқ
Dialogue: 0,0:06:05.26,0:06:10.50,Default,,0,0,0,,Оны аяп, кездесуден қашқақтаған кезім болды.
Dialogue: 0,0:06:10.50,0:06:15.60,Default,,0,0,0,,｟《Алтыбұрыш: Әрине. Мен жұмыс іздеу себептерімен клубты тастаған адам болдым》｠
Dialogue: 0,0:06:15.60,0:06:18.97,Default,,0,0,0,,《Бірақ ол кісі мұны өз кінәсі деп ойлады➡
Dialogue: 0,0:06:18.97,0:06:21.07,Default,,0,0,0,,Өзара түсініспеушілік... Жоқ, жоқ, жоқ!
Dialogue: 0,0:06:21.07,0:06:23.51,Default,,0,0,0,,Осы екі адамның қарым-қатынасына делдалдық жасаудың мәні неде?
Dialogue: 0,0:06:23.51,0:06:25.41,Default,,0,0,0,,Біз енді дос болып қалуымыз мүмкін➡
Dialogue: 0,0:06:25.41,0:06:29.75,Default,,0,0,0,,Менен 8 жас үлкен маған қарағанда әлдеқайда көп мүмкіндік бар...
Dialogue: 0,0:06:29.75,0:06:32.12,Default,,0,0,0,,Ешқашан жауларыңызға тұз жібермеңіз.
Dialogue: 0,0:06:32.12,0:06:34.12,Default,,0,0,0,,Керісінше, компания емес аға қызметкер ретінде➡
Dialogue: 0,0:06:34.12,0:06:36.59,Default,,0,0,0,,Бұл сіздің ұнамдылығыңызды арттырудың тамаша мүмкіндігі емес пе? 》
Dialogue: 0,0:06:38.59,0:06:41.46,Default,,0,0,0,,《Мен мұнда кездейсоқ көңіл айтамын...》
Dialogue: 0,0:06:41.46,0:06:43.73,Default,,0,0,0,,Уф….
Dialogue: 0,0:06:47.33,0:06:51.10,Default,,0,0,0,,Мен Минатоның сезімін түсінемін.
Dialogue: 0,0:06:51.10,0:06:53.47,Default,,0,0,0,,Не? Мен де баяғыда➡
Dialogue: 0,0:06:53.47,0:06:57.51,Default,,0,0,0,,Толық жұмыс істейтін достардан қашатын кезім болды.
Dialogue: 0,0:06:57.51,0:07:01.61,Default,,0,0,0,,Жанымыздағы шөп жасылырақ көрінеді.
Dialogue: 0,0:07:01.61,0:07:03.78,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:03.78,0:07:05.95,Default,,0,0,0,,｟Цюге! Мен оны оқыдым!
Dialogue: 0,0:07:05.95,0:07:08.09,Default,,0,0,0,,Бұл жолы өте қызықты болды!
Dialogue: 0,0:07:08.09,0:07:10.09,Default,,0,0,0,,Күткендей, Цюге керемет! ｠
Dialogue: 0,0:07:12.26,0:07:15.43,Default,,0,0,0,,Ересек болған соң да достасуға болады➡
Dialogue: 0,0:07:15.43,0:07:18.93,Default,,0,0,0,,Мен туралы ашық айта алатын мектептегі досым➡
Dialogue: 0,0:07:18.93,0:07:21.10,Default,,0,0,0,,Оны алу қиын.
Dialogue: 0,0:07:21.10,0:07:24.60,Default,,0,0,0,,Минато үшін де, оған да.
Dialogue: 0,0:07:26.97,0:07:30.78,Default,,0,0,0,,Минато! Ах.
Dialogue: 0,0:07:30.78,0:07:33.95,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:07:33.95,0:07:37.42,Default,,0,0,0,,Юта…. Сыйлықты беруді ұмытып қалсаңыз да➡
Dialogue: 0,0:07:37.42,0:07:39.52,Default,,0,0,0,,Ойлау...
Dialogue: 0,0:07:43.62,0:07:45.59,Default,,0,0,0,,Сіз күш-қуатыңыздан айырылдыңыз.
Dialogue: 0,0:07:45.59,0:07:47.59,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:07:47.59,0:07:52.50,Default,,0,0,0,,А, мен білдім! ? Уау, мен жаттығулардан қатты жетіспедім.
Dialogue: 0,0:07:52.50,0:07:55.30,Default,,0,0,0,,Кел анда-санда билей бер.
Dialogue: 0,0:07:55.30,0:07:57.27,Default,,0,0,0,,Хмм….
Dialogue: 0,0:07:57.27,0:07:59.97,Default,,0,0,0,,Мен сенің аяқ киіміңді сақтаймын.
Dialogue: 0,0:08:04.44,0:08:07.58,Default,,0,0,0,,Шынымен! ? Мен оны жай ғана ұстаймын.
Dialogue: 0,0:08:07.58,0:08:11.45,Default,,0,0,0,,Зең болса да, білмеймін. Эх...
Dialogue: 0,0:08:11.45,0:08:13.59,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:08:13.59,0:08:19.26,Default,,0,0,0,,Мен... Минатоны меннен қашқақтап жүр ме деп ойлайтынмын.
Dialogue: 0,0:08:19.26,0:08:23.76,Default,,0,0,0,,Кешіріңіз! Ей, мен қателессем, бәрі жақсы!
Dialogue: 0,0:08:23.76,0:08:27.63,Default,,0,0,0,,Мен сізге қайта хабарласамын! Олай болса!
Dialogue: 0,0:08:27.63,0:08:30.94,Default,,0,0,0,,Ол бұрынғыдай жанды.
Dialogue: 0,0:08:30.94,0:08:34.61,Default,,0,0,0,,《Цюге: Иә. Жағдай қолайсыз болса да➡
Dialogue: 0,0:08:34.61,0:08:36.58,Default,,0,0,0,,Мен Минатоның күлгенін қалаймын》
Dialogue: 0,0:08:40.45,0:08:42.75,Default,,0,0,0,,А, белок.
Dialogue: 0,0:08:42.75,0:08:45.58,Default,,0,0,0,,Денемді қозғалтқаннан кейін қарным ашылды.
Dialogue: 0,0:08:45.58,0:08:47.59,Default,,0,0,0,,Бірдеңе жеуге барайық па?
Dialogue: 0,0:08:54.26,0:08:57.23,Default,,0,0,0,,Рахмет. Цюге дұрыс айтты.
Dialogue: 0,0:08:59.93,0:09:03.94,Default,,0,0,0,,Бұл Минатоның батылдық танытқаны үшін болса керек.
Dialogue: 0,0:09:03.94,0:09:06.34,Default,,0,0,0,,《Минато: Неліктен бұл жігітте менің ойым бар?➡
Dialogue: 0,0:09:06.34,0:09:08.27,Default,,0,0,0,,Сіз түсінесіз.
Dialogue: 0,0:09:08.27,0:09:11.64,Default,,0,0,0,,Басында біртүрлі жігіт деп ойладым➡
Dialogue: 0,0:09:11.64,0:09:15.81,Default,,0,0,0,,Ол мейірімді, сонымен бірге таңқаларлық ер адам.》
Dialogue: 0,0:09:17.95,0:09:21.05,Default,,0,0,0,,《Минато: Мен де Цюгеге өзімнің осал тұстарымды көрсете аламын...》
Dialogue: 0,0:09:23.36,0:09:25.42,Default,,0,0,0,,《Цугэ: Ух》
Dialogue: 0,0:09:25.42,0:09:28.26,Default,,0,0,0,,《Минато: Бірдеңе➡
Dialogue: 0,0:09:28.26,0:09:30.60,Default,,0,0,0,,Мен өзімді еркін сезінемін, өйткені ол қарт адамға ұқсайды.》
Dialogue: 0,0:09:30.60,0:09:32.60,Default,,0,0,0,,Хмм….
Dialogue: 0,0:09:32.60,0:09:35.10,Default,,0,0,0,,<Цюге: Мен ең болмаса маған үлкен аға ретінде қарау керек деп ойладым>
Dialogue: 0,0:09:37.67,0:09:41.17,Default,,0,0,0,,Мен... гриль ет жегім келеді. Қалағаныңызша жеңіз.
Dialogue: 0,0:09:47.28,0:09:50.85,Default,,0,0,0,,Бұл жолы алтыбұрыш бір жерге кетіп қалды.
Dialogue: 0,0:09:50.85,0:09:52.75,Default,,0,0,0,,Мен екі адамға қарсы емеспін.
Dialogue: 0,0:09:52.75,0:09:54.82,Default,,0,0,0,,Эй, сен!
Dialogue: 0,0:09:54.82,0:09:56.76,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:56.76,0:10:00.26,Default,,0,0,0,,Не болды? Жоқ, ештеңе!
Dialogue: 0,0:10:00.26,0:10:04.10,Default,,0,0,0,,О, Адачиде бұл жүйе бар.
Dialogue: 0,0:10:04.10,0:10:06.80,Default,,0,0,0,,Ол компанияға келгеннен бері байсалды➡
Dialogue: 0,0:10:06.80,0:10:10.80,Default,,0,0,0,,Қараңғы, көлеңке жұқа, сондықтан не болар екен деп ойладым.➡
Dialogue: 0,0:10:10.80,0:10:13.27,Default,,0,0,0,,Соңғы кездері мен біртүрлі зейінді болып кеттім➡
Dialogue: 0,0:10:13.27,0:10:16.44,Default,,0,0,0,,Енді мен оны оңай пайдалана аламын.
Dialogue: 0,0:10:16.44,0:10:20.48,Default,,0,0,0,,Хмм…. Адачи әлі бойдақ еді.
Dialogue: 0,0:10:20.48,0:10:25.08,Default,,0,0,0,,Иә. Жақында жаңа Нагасаки филиалында ➡
Dialogue: 0,0:10:25.08,0:10:27.79,Default,,0,0,0,,Біз тәжірибелі адамдарды пайдалануды шештік.
Dialogue: 0,0:10:27.79,0:10:30.42,Default,,0,0,0,,Хахаха... иә? иә? Хе...
Dialogue: 0,0:10:30.42,0:10:33.93,Default,,0,0,0,,Сіз қалай ойлайсыз? Менің ойымша, Адачи бұл жұмысқа лайықты адам.
Dialogue: 0,0:10:45.90,0:10:50.88,Default,,0,0,0,,《Мен Куросаваға сиқыр туралы айттым. Содан бастап…》
Dialogue: 0,0:10:50.88,0:10:52.88,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:10:52.88,0:10:55.31,Default,,0,0,0,,《Бүгінгі түнгі уәде есіңде ме? 》
Dialogue: 0,0:10:55.31,0:10:57.72,Default,,0,0,0,,Сәлем! Не болды?
Dialogue: 0,0:10:57.72,0:11:01.72,Default,,0,0,0,,Кенет біртүрлі дыбыс шығады. Жоқ, ештеңе...
Dialogue: 0,0:11:01.72,0:11:03.72,Default,,0,0,0,,《Сен бейбақ...》
Dialogue: 0,0:11:03.72,0:11:05.92,Default,,0,0,0,,《Кешіріңіз, кешіріңіз.
Dialogue: 0,0:11:05.92,0:11:09.40,Default,,0,0,0,,Мен Адачимен бірге концертке баруды асыға күттім》
Dialogue: 0,0:11:09.40,0:11:11.80,Default,,0,0,0,,Аа, дұрыс. Кешегі кездесу туралы➡
Dialogue: 0,0:11:11.80,0:11:15.33,Default,,0,0,0,,Не болды? Ах.
Dialogue: 0,0:11:15.33,0:11:17.90,Default,,0,0,0,,Бізге қосымша деректер керек.
Dialogue: 0,0:11:17.90,0:11:19.87,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:23.91,0:11:26.08,Default,,0,0,0,,《Тыныш бол...》
Dialogue: 0,0:11:26.08,0:11:29.11,Default,,0,0,0,,Ах. Мен жасаған ем➡
Dialogue: 0,0:11:29.11,0:11:34.09,Default,,0,0,0,,Олар оны пайдаланып жатыр. Жақсы. Ол жақсы жігіт.
Dialogue: 0,0:11:34.09,0:11:36.09,Default,,0,0,0,,Кейін кездескенше.
Dialogue: 0,0:11:36.09,0:11:40.43,Default,,0,0,0,,《Жағымды иіс. Өйткені, бұл Адачиге жарасады.
Dialogue: 0,0:11:40.43,0:11:42.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:42.76,0:11:45.40,Default,,0,0,0,,《Ол оны жақсырақ пайдаланып жатқан сияқты.
Dialogue: 0,0:11:45.40,0:11:47.40,Default,,0,0,0,,Бұл менің сиқырым болса да! 》
Dialogue: 0,0:11:50.07,0:11:52.04,Default,,0,0,0,,Адачи: Бір сәтке болады ма?
Dialogue: 0,0:11:55.07,0:11:57.94,Default,,0,0,0,,Ал, отырыңыз.
Dialogue: 0,0:11:57.94,0:12:03.08,Default,,0,0,0,,《Әй, мен бірдеңе істедім бе?
Dialogue: 0,0:12:03.08,0:12:06.42,Default,,0,0,0,,Сакуенидің материалдары әлі тапсырылған жоқ➡
Dialogue: 0,0:12:06.42,0:12:08.55,Default,,0,0,0,,Мүмкін өткен аптада Сату деректер базасы туралы➡
Dialogue: 0,0:12:08.55,0:12:11.06,Default,,0,0,0,,Сіздің пікіріңіз болды ма?
Dialogue: 0,0:12:11.06,0:12:13.83,Default,,0,0,0,,Немесе мен Куросава туралы білген шығармын! ? 》
Dialogue: 0,0:12:13.83,0:12:18.23,Default,,0,0,0,,｟Адачи! Неге менің эйсеммен араласып жатырсың! ｠
Dialogue: 0,0:12:18.23,0:12:22.73,Default,,0,0,0,,《Жоқ, мен мұндай жеке адам туралы ештеңе айтпауым керек еді...》
Dialogue: 0,0:12:22.73,0:12:26.77,Default,,0,0,0,,Сіз жақында өзгердіңіз. иә?
Dialogue: 0,0:12:26.77,0:12:30.08,Default,,0,0,0,,Сіз шынымен жиіркеніштісіз және сіз үнемі шошып кетесіз➡
Dialogue: 0,0:12:30.08,0:12:32.91,Default,,0,0,0,,Не болар екен деп ойладым.
Dialogue: 0,0:12:32.91,0:12:35.25,Default,,0,0,0,,《Жаман айтайық》
Dialogue: 0,0:12:35.25,0:12:39.42,Default,,0,0,0,,Менің ойымша, соңғы кездері Куросавамен көбірек уақыт өткізгендіктен болар.
Dialogue: 0,0:12:39.42,0:12:42.09,Default,,0,0,0,,Мен әлдеқайда мұқият болдым.
Dialogue: 0,0:12:42.09,0:12:44.56,Default,,0,0,0,,Оған Куросава әсер етті ме?
Dialogue: 0,0:12:44.56,0:12:47.73,Default,,0,0,0,,《Қасиетті, мен білдім! 》
Dialogue: 0,0:12:47.73,0:12:49.76,Default,,0,0,0,,Осы уақыт аралығындағы оқиғаларды да бақылаңыз...
Dialogue: 0,0:12:49.76,0:12:52.23,Default,,0,0,0,,《Жоқ, бірақ мен компанияда ешқашан ештеңе айтқан емеспін➡
Dialogue: 0,0:12:52.23,0:12:55.17,Default,,0,0,0,,Қорытындылау дегеніміз не?
Dialogue: 0,0:12:55.17,0:12:57.90,Default,,0,0,0,,Жоқ, ол жерде жоқ деп айта алмаймын...》
Dialogue: 0,0:12:57.90,0:13:00.07,Default,,0,0,0,,Мұны істеу өте оңай, солай емес пе?
Dialogue: 0,0:13:00.07,0:13:04.08,Default,,0,0,0,,《Шіркін, мен саған жұмыста бұлай істеме дедім ғой...》
Dialogue: 0,0:13:04.08,0:13:06.58,Default,,0,0,0,,Адачи. Ах!
Dialogue: 0,0:13:06.58,0:13:09.48,Default,,0,0,0,,Кешіріңіз! Енді ешқашан кеңседе болмайды!
Dialogue: 0,0:13:09.48,0:13:12.58,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:13:12.58,0:13:16.59,Default,,0,0,0,,Жоқ, келесі жолы Нагасакиде жаңа дүкен ашылады.
Dialogue: 0,0:13:16.59,0:13:18.89,Default,,0,0,0,,Сондықтан бас кеңсе қызметкерлері біраз уақыт сонда болды➡
Dialogue: 0,0:13:18.89,0:13:22.06,Default,,0,0,0,,Мен оны жіберуді шештім...
Dialogue: 0,0:13:22.06,0:13:24.10,Default,,0,0,0,,Иә? Нагасаки?
Dialogue: 0,0:13:24.10,0:13:27.57,Default,,0,0,0,,Неге бармайсың, Адачи?
Dialogue: 0,0:13:29.57,0:13:33.51,Default,,0,0,0,,Бұл сіздің ауыстырылғаныңызды білдіре ме?
Dialogue: 0,0:13:33.51,0:13:36.41,Default,,0,0,0,,Ах.
Dialogue: 0,0:13:36.41,0:13:40.78,Default,,0,0,0,,Бұл Фукуокадан кейінгі Кюсю аймағында ашылатын екінші дүкен.
Dialogue: 0,0:13:40.78,0:13:44.95,Default,,0,0,0,,Адачидің соңғы жұмысына қарап, мен оны осы лауазымға лайықты деп бағаладым.
Dialogue: 0,0:13:47.22,0:13:49.22,Default,,0,0,0,,Нагасаки керемет!
Dialogue: 0,0:13:49.22,0:13:52.76,Default,,0,0,0,,Климаты жұмсақ, тағамы дәмді.
Dialogue: 0,0:13:52.76,0:13:55.66,Default,,0,0,0,,Менің ойымша, бұл жаман оқиға емес.
Dialogue: 0,0:13:55.66,0:13:57.63,Default,,0,0,0,,Ойлан.
Dialogue: 0,0:14:00.90,0:14:04.57,Default,,0,0,0,,《Шынымен бе? Айтайын дегенім, емі керемет.
Dialogue: 0,0:14:04.57,0:14:07.74,Default,,0,0,0,,Жалақыны көтеруден тұрғын үй жәрдемақысына дейін...》
Dialogue: 0,0:14:07.74,0:14:12.61,Default,,0,0,0,,Мен біреу маған мұндай нәрсе айтады деп ешқашан күтпедім...
Dialogue: 0,0:14:12.61,0:14:17.42,Default,,0,0,0,,《Мұның бәрі сиқыр мен Куросаваның арқасында.
Dialogue: 0,0:14:17.42,0:14:20.09,Default,,0,0,0,,Бірақ тасымалдау ➡ дегенді білдіреді
Dialogue: 0,0:14:20.09,0:14:22.55,Default,,0,0,0,,Әрине, мен Куросавадан бөліндім...》
Dialogue: 0,0:14:25.56,0:14:27.56,Default,,0,0,0,,《Жұмысыңды істе, ақымақ! 》
Dialogue: 0,0:14:33.57,0:14:44.08,Default,,0,0,0,,♬～
Dialogue: 0,0:14:44.08,0:14:46.08,Default,,0,0,0,,《Мен оны елестете алмаймын.
Dialogue: 0,0:14:46.08,0:14:48.25,Default,,0,0,0,,Мен Куросавадан қалай кете аламын?
Dialogue: 0,0:14:53.75,0:14:57.72,Default,,0,0,0,,《Уау... Жол жүруге 10 сағат қалды.
Dialogue: 0,0:14:57.72,0:15:01.23,Default,,0,0,0,,Оңай алға-артқа кететін қашықтық емес.
Dialogue: 0,0:15:01.23,0:15:05.90,Default,,0,0,0,,Бұл алыс-жақын қарым-қатынас деп аталатын... драма ма?
Dialogue: 0,0:15:05.90,0:15:08.23,Default,,0,0,0,,Адачи мырза. Оу.
Dialogue: 0,0:15:08.23,0:15:10.77,Default,,0,0,0,,Сакуениге жіберу үшін құжаттарды дайындадыңыз ба?
Dialogue: 0,0:15:10.77,0:15:12.80,Default,,0,0,0,,А, мен оны қазір шығарамын.
Dialogue: 0,0:15:12.80,0:15:15.07,Default,,0,0,0,,《Мен жұмысқа баруым керек.
Dialogue: 0,0:15:15.07,0:15:17.94,Default,,0,0,0,,Қалай болғанда да мен бүгін Куросаваға уәде бердім➡
Dialogue: 0,0:15:17.94,0:15:20.48,Default,,0,0,0,,Менімен кейінірек сөйлесіңіз...》
Dialogue: 0,0:15:20.48,0:15:24.08,Default,,0,0,0,,Адачи мырза, бұл биылғы емес, былтырғы деректер емес пе?
Dialogue: 0,0:15:24.08,0:15:26.05,Default,,0,0,0,,《Не?
Dialogue: 0,0:15:26.05,0:15:28.05,Default,,0,0,0,,Не! ? 》
Dialogue: 0,0:15:32.19,0:15:35.93,Default,,0,0,0,,《Ойланып жүрсем де, негізгі қателік жібердім...》
Dialogue: 0,0:15:35.93,0:15:39.40,Default,,0,0,0,,📱 (дірілдеген дыбыс)
Dialogue: 0,0:15:39.40,0:15:41.43,Default,,0,0,0,,Сәлеметсіз бе Адачи?
Dialogue: 0,0:15:41.43,0:15:43.90,Default,,0,0,0,,Мен жаңа ғана жұмысты аяқтадым және электрондық поштаны көрдім➡
Dialogue: 0,0:15:43.90,0:15:47.91,Default,,0,0,0,,Кенеттен үстеме жұмыс істеуге болады ма? 📱Иә.
Dialogue: 0,0:15:47.91,0:15:50.24,Default,,0,0,0,,Мен кеңсеге оралып, сізге көмектесейін бе?
Dialogue: 0,0:15:50.24,0:15:53.11,Default,,0,0,0,,📱Жоқ, бәрі жақсы. Бұл менің қателігім.
Dialogue: 0,0:15:53.11,0:15:56.98,Default,,0,0,0,,📱Гексаграмма маған көмектесуде. Мен түсінемін.
Dialogue: 0,0:15:56.98,0:16:00.42,Default,,0,0,0,,📱Кешіріңіз. Куросава бүгін барғысы келген концерт➡
Dialogue: 0,0:16:00.42,0:16:03.92,Default,,0,0,0,,Ақыры билет алдым... Шынымен кешіріңіз.
Dialogue: 0,0:16:03.92,0:16:07.76,Default,,0,0,0,,Бұл туралы алаңдамаңыз. Келесі жолы оның орнын толтырамын...
Dialogue: 0,0:16:07.76,0:16:10.23,Default,,0,0,0,,Адачи-сан! Сурет дайын!
Dialogue: 0,0:16:10.23,0:16:12.76,Default,,0,0,0,,📱Рахмет!
Dialogue: 0,0:16:12.76,0:16:16.74,Default,,0,0,0,,📱Кешіріңіз. Егер солай болса, мен сенен жалғыз баруыңды сұрар едім...
Dialogue: 0,0:16:16.74,0:16:19.40,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:16:19.40,0:16:22.24,Default,,0,0,0,,Мен жай ғана Адачимен барғым келді.
Dialogue: 0,0:16:22.24,0:16:25.41,Default,,0,0,0,,📱Келесі жолы тағы барайық. Иә, түсінемін.
Dialogue: 0,0:16:25.41,0:16:28.41,Default,,0,0,0,,Кейін кездескенше.
Dialogue: 0,0:16:28.41,0:16:32.08,Default,,0,0,0,,《Мен сенімен баруды асыға күттім.
Dialogue: 0,0:16:32.08,0:16:34.05,Default,,0,0,0,,Сен Куросаваға жамандық жасадың.
Dialogue: 0,0:16:36.59,0:16:40.76,Default,,0,0,0,,《Жақсы ма екен... Жүзіңді көрмей мазасызданамын.
Dialogue: 0,0:16:42.76,0:16:47.73,Default,,0,0,0,,《Куросава өзін мінсіз етіп көрсетуге шебер...
Dialogue: 0,0:16:47.73,0:16:51.24,Default,,0,0,0,,Мен ауысқаннан кейін мен әлі алыс едім...
Dialogue: 0,0:16:51.24,0:16:54.41,Default,,0,0,0,,Мен түтіккенмін, сондықтан мен Куросаваға қол тигізуім керек➡
Dialogue: 0,0:16:54.41,0:16:57.74,Default,,0,0,0,,Мен өзімді қалай сезінетінімді білмеймін》 (есіктің ашылған дыбысы)
Dialogue: 0,0:16:57.74,0:16:59.75,Default,,0,0,0,,О...
Dialogue: 0,0:16:59.75,0:17:03.58,Default,,0,0,0,,Балалар сендерде әлі қалды ма?
Dialogue: 0,0:17:03.58,0:17:06.38,Default,,0,0,0,,Кешіріңіз. Мен қателік жасадым.
Dialogue: 0,0:17:06.38,0:17:10.06,Default,,0,0,0,,Адачи: Менің ойымша, сіз келесі жолы Нагасаки филиалын іске қосасыз.
Dialogue: 0,0:17:10.06,0:17:12.22,Default,,0,0,0,,Мықты болыңыз.
Dialogue: 0,0:17:12.22,0:17:15.23,Default,,0,0,0,,Нагасаки? Күшті.
Dialogue: 0,0:17:18.73,0:17:21.40,Default,,0,0,0,,Сол Асахина-сан.
Dialogue: 0,0:17:21.40,0:17:24.00,Default,,0,0,0,,Бүгін келгің келе ме? иә?
Dialogue: 0,0:17:27.27,0:17:29.57,Default,,0,0,0,,Қайырлы таң. ⚟Қайырлы таң.
Dialogue: 0,0:17:29.57,0:17:31.58,Default,,0,0,0,,⚟Қайырлы таң.
Dialogue: 0,0:17:31.58,0:17:34.75,Default,,0,0,0,,《Адачи әлі осында ма?
Dialogue: 0,0:17:34.75,0:17:39.25,Default,,0,0,0,,Кешегі күн туралы алаңдамайсыз деп үміттенемін...》
Dialogue: 0,0:17:39.25,0:17:42.25,Default,,0,0,0,,О, Куросава. Асахина мырза.
Dialogue: 0,0:17:42.25,0:17:45.66,Default,,0,0,0,,Қайырлы таң. Аша қалдыңыз ба?
Dialogue: 0,0:17:45.66,0:17:49.39,Default,,0,0,0,,О, мен кеше алғаш рет ішіп алдым.
Dialogue: 0,0:17:49.39,0:17:53.93,Default,,0,0,0,,Адачидің кеңесі. Е, кеңесу...
Dialogue: 0,0:17:53.93,0:17:56.40,Default,,0,0,0,,Ах, трансфер тарихы➡
Dialogue: 0,0:17:56.40,0:18:00.07,Default,,0,0,0,,Қалай бас тартуға болады?
Dialogue: 0,0:18:00.07,0:18:03.44,Default,,0,0,0,,Негізі менеджерден де естідім.
Dialogue: 0,0:18:03.44,0:18:06.55,Default,,0,0,0,,Адачи үлкен үміт күтеді, сондықтан бұл босқа➡
Dialogue: 0,0:18:06.55,0:18:09.58,Default,,0,0,0,,Мен айттым...
Dialogue: 0,0:18:09.58,0:18:13.25,Default,,0,0,0,,Ойланып қарашы, Адачи екеуің жақсы доссыңдар.
Dialogue: 0,0:18:13.25,0:18:15.42,Default,,0,0,0,,Сіз бірдеңе тыңдап тұрсыз ба?
Dialogue: 0,0:18:15.42,0:18:17.56,Default,,0,0,0,,№➡
Dialogue: 0,0:18:17.56,0:18:19.56,Default,,0,0,0,,Ештеңе….
Dialogue: 0,0:18:19.56,0:18:21.56,Default,,0,0,0,,Жоғары….
Dialogue: 0,0:18:21.56,0:18:24.73,Default,,0,0,0,,《Аа, көп ішкеніме біраз болды.
Dialogue: 0,0:18:24.73,0:18:29.57,Default,,0,0,0,,Асахина-сан таңғаларлық ішуші》
Dialogue: 0,0:18:29.57,0:18:33.14,Default,,0,0,0,,｟Ішіп отырып тыңдаймын.
Dialogue: 0,0:18:33.14,0:18:36.24,Default,,0,0,0,,Алдын ала қарап, содан кейін шешім қабылдаған дұрыс деп ойлаймын.
Dialogue: 0,0:18:36.24,0:18:39.58,Default,,0,0,0,,Мен оны әзірше сақтаймын.
Dialogue: 0,0:18:39.58,0:18:42.58,Default,,0,0,0,,《Мен сонда ғана бардым》
Dialogue: 0,0:18:42.58,0:18:44.58,Default,,0,0,0,,А…?
Dialogue: 0,0:18:46.59,0:18:48.75,Default,,0,0,0,,《Куросава? 》
Dialogue: 0,0:18:56.09,0:18:58.63,Default,,0,0,0,,Куросава!
Dialogue: 0,0:18:58.63,0:19:02.17,Default,,0,0,0,,Сіз күттіңіз бе? Сенімен бәрі жақсы ма.
Dialogue: 0,0:19:02.17,0:19:05.57,Default,,0,0,0,,Кешегі күн үшін кешіріңіз! Мен оны асыға күттім.
Dialogue: 0,0:19:05.57,0:19:08.57,Default,,0,0,0,,Жоқ, бұл жұмыс, сондықтан менің амалым жоқ.
Dialogue: 0,0:19:08.57,0:19:11.44,Default,,0,0,0,,Сіз оны уақытында орындадыңыз ба? Әй, қалай болғанда да.
Dialogue: 0,0:19:11.44,0:19:14.08,Default,,0,0,0,,Мен көремін. Жақсы.
Dialogue: 0,0:19:14.08,0:19:17.55,Default,,0,0,0,,Live Келесі жолы міндетті түрде барамын.
Dialogue: 0,0:19:17.55,0:19:20.05,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:20.05,0:19:22.75,Default,,0,0,0,,《Жақсы, әдеттегідей.
Dialogue: 0,0:19:22.75,0:19:26.12,Default,,0,0,0,,Оның жүзін тікелей көргеннен кейін мен өзімді еркін сезіндім.
Dialogue: 0,0:19:26.12,0:19:31.76,Default,,0,0,0,,Өйткені, мен Куросавадан кетемін деген ойға да келмейді.
Dialogue: 0,0:19:31.76,0:19:33.93,Default,,0,0,0,,Адачи. иә?
Dialogue: 0,0:19:36.07,0:19:40.61,Default,,0,0,0,,Нагасакиге ауысу туралы ұсыныстан бас тартқаныңыз рас па?
Dialogue: 0,0:19:40.61,0:19:44.51,Default,,0,0,0,,А... Қайдан білесің...
Dialogue: 0,0:19:44.51,0:19:48.41,Default,,0,0,0,,Мен Асахина-саннан естідім. Ол кеңес алғанын айтты.
Dialogue: 0,0:19:48.41,0:19:51.92,Default,,0,0,0,,Мен Асахинаның ысырап деп айтқанын естідім.
Dialogue: 0,0:19:51.92,0:19:55.92,Default,,0,0,0,,А, жоқ, мен жаңа дүкенде жұмыс істей алмаймын...
Dialogue: 0,0:19:55.92,0:19:58.86,Default,,0,0,0,,Неліктен? а….
Dialogue: 0,0:19:58.86,0:20:02.26,Default,,0,0,0,,Біз жаңа ғана кездессек те...
Dialogue: 0,0:20:02.26,0:20:06.26,Default,,0,0,0,,Неге... Неге сонша маңызды➡
Dialogue: 0,0:20:06.26,0:20:08.43,Default,,0,0,0,,Сіз өзіңіз шешім қабылдайсыз!
Dialogue: 0,0:20:10.77,0:20:13.94,Default,,0,0,0,,Тіпті мен Адачиден айырылғым келмейді.
Dialogue: 0,0:20:13.94,0:20:17.41,Default,,0,0,0,,Бірақ жаңа дүкенге басынан бастап араласу➡
Dialogue: 0,0:20:17.41,0:20:19.58,Default,,0,0,0,,Бұл Адачи➡ үшін де мүмкіндік
Dialogue: 0,0:20:19.58,0:20:23.08,Default,,0,0,0,,Егер сіз бас тартсаңыз, болашақта ілгерілеу мүмкіндігі болмауы мүмкін.
Dialogue: 0,0:20:23.08,0:20:26.59,Default,,0,0,0,,Бір сөзбен дегенде менімен ақылдасты...
Dialogue: 0,0:20:29.25,0:20:33.59,Default,,0,0,0,,Біз кездесіп жатқан жоқпыз ба?
Dialogue: 0,0:20:33.59,0:20:35.89,Default,,0,0,0,,《Мен соншалықты сенімсізмін бе?
Dialogue: 0,0:20:35.89,0:20:39.23,Default,,0,0,0,,Сіз маған сенбейсіз бе?》 Жоқ...
Dialogue: 0,0:20:39.23,0:20:42.57,Default,,0,0,0,,《Жоқ, олай емес.
Dialogue: 0,0:20:42.57,0:20:44.77,Default,,0,0,0,,Егер мен Куросаваға қол тигізе алмасам➡
Dialogue: 0,0:20:44.77,0:20:47.91,Default,,0,0,0,,Жүрегіңіздегі дауыс естілмесе, мазасызданасыз➡
Dialogue: 0,0:20:47.91,0:20:51.01,Default,,0,0,0,,Куросаваға сенбеймін деп айтуға да қатысты.
Dialogue: 0,0:20:53.41,0:20:55.55,Default,,0,0,0,,Алыста жүргенше➡
Dialogue: 0,0:20:55.55,0:20:59.88,Default,,0,0,0,,Мен сені енді ғана менімен ажырасатын шығар деп ойладым.
Dialogue: 0,0:20:59.88,0:21:02.42,Default,,0,0,0,,《Мен не айтуым керек?》
Dialogue: 0,0:21:02.42,0:21:05.09,Default,,0,0,0,,《Ондай нәрсеге қандай себеп болғанына қарамастан➡
Dialogue: 0,0:21:05.09,0:21:07.09,Default,,0,0,0,,Мен сізге айтпаймын.
Dialogue: 0,0:21:07.09,0:21:09.06,Default,,0,0,0,,《Куросава ашулы➡
Dialogue: 0,0:21:09.06,0:21:12.23,Default,,0,0,0,,Мен қайғылымын.
Dialogue: 0,0:21:12.23,0:21:14.40,Default,,0,0,0,,Мен мұндай сезімді бірінші рет көріп тұрмын➡
Dialogue: 0,0:21:14.40,0:21:17.40,Default,,0,0,0,,Мен абдырап қалдым, өз ойымды дұрыс жеткізе алмаймын.
Dialogue: 0,0:21:17.40,0:21:19.90,Default,,0,0,0,,Мен не айтсам да, сені ренжітетін сияқтымын...》
Dialogue: 0,0:21:24.84,0:21:28.58,Default,,0,0,0,,Адачи. Ах.
Dialogue: 0,0:21:28.58,0:21:33.05,Default,,0,0,0,,Мен Адачиге ұқсамай, не ойлап отырмын?➡
Dialogue: 0,0:21:33.05,0:21:35.95,Default,,0,0,0,,Сөзбен жеткізбейінше түсінбеймін.
Dialogue: 0,0:21:37.45,0:21:43.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
