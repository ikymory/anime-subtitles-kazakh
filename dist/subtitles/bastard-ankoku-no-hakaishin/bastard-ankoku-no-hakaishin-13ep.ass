Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.88,0:00:16.39,Default,,0,0,0,,Ааааааааааааааа ханшайым!
Dialogue: 0,0:00:16.47,0:00:18.47,Default,,0,0,0,,Ах, уф... мөр!
Dialogue: 0,0:00:19.14,0:00:20.89,Default,,0,0,0,,Шейла мөрі...
Dialogue: 0,0:00:21.39,0:00:24.27,Default,,0,0,0,,Ааааааааааааааа!
Dialogue: 0,0:00:26.52,0:00:29.94,Default,,0,0,0,,Я... мөр
Dialogue: 0,0:00:30.03,0:00:31.90,Default,,0,0,0,,Ахх
Dialogue: 0,0:00:31.99,0:00:34.32,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:00:34.41,0:00:35.61,Default,,0,0,0,,Егер оны жақында жоймасақ...
Dialogue: 0,0:00:37.57,0:00:44.29,Default,,0,0,0,,Уууу!
Dialogue: 0,0:00:47.88,0:00:49.88,Default,,0,0,0,,♪～
Dialogue: 0,0:02:13.05,0:02:15.05,Default,,0,0,0,,～♪
Dialogue: 0,0:02:34.15,0:02:35.78,Default,,0,0,0,,Мен түс көрдім
Dialogue: 0,0:02:37.69,0:02:39.20,Default,,0,0,0,,Ескі армандар
Dialogue: 0,0:02:46.62,0:02:49.96,Default,,0,0,0,,Кал!
Dialogue: 0,0:02:53.00,0:02:55.63,Default,,0,0,0,,А... есімде.
Dialogue: 0,0:02:56.71,0:02:57.92,Default,,0,0,0,,Кал! Сен не істеп жатырсың?
Dialogue: 0,0:02:57.92,0:02:59.59,Default,,0,0,0,,Кал! Сен не істеп жатырсың?
Dialogue: 0,0:02:57.92,0:02:59.59,Default,,0,0,0,,Барлығы
Dialogue: 0,0:02:59.68,0:03:01.89,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:03:03.72,0:03:05.06,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:03:07.18,0:03:09.94,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:03:11.06,0:03:12.94,Default,,0,0,0,,Ах... да...
Dialogue: 0,0:03:13.02,0:03:15.90,Default,,0,0,0,,Сөйлеме, мен саған қазір көмектесемін.
Dialogue: 0,0:03:16.48,0:03:17.78,Default,,0,0,0,,Мынадай қылыш...
Dialogue: 0,0:03:21.32,0:03:22.32,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:03:23.12,0:03:27.24,Default,,0,0,0,,17 жыл бұрын...сен өлген күні шығар...
Dialogue: 0,0:03:27.33,0:03:32.17,Default,,0,0,0,,Мен өлген едім.
Dialogue: 0,0:03:33.00,0:03:36.92,Default,,0,0,0,,Сол Голем соғысында сіз және Раның Ур Мета Ликана.
Dialogue: 0,0:03:37.00,0:03:39.13,Default,,0,0,0,,Сауда болған кезден бастап
Dialogue: 0,0:03:39.21,0:03:41.84,Default,,0,0,0,,Идиот! Мен енді өлмеймін...
Dialogue: 0,0:03:41.93,0:03:45.55,Default,,0,0,0,,Мен бірінші рет білдім
Dialogue: 0,0:03:46.60,0:03:49.14,Default,,0,0,0,,Денеңіздің жартысы болу
Dialogue: 0,0:03:49.68,0:03:52.52,Default,,0,0,0,,Бұл мен үшін бәрі болды
Dialogue: 0,0:03:53.10,0:03:54.73,Default,,0,0,0,,Барлығын жоғалтты
Dialogue: 0,0:03:55.48,0:03:56.82,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:03:57.32,0:03:59.65,Default,,0,0,0,,Мен дүниені ғана түсінгім келді
Dialogue: 0,0:04:00.78,0:04:02.99,Default,,0,0,0,,Сізбен бөліскен арманымды мұраға алып
Dialogue: 0,0:04:03.49,0:04:05.66,Default,,0,0,0,,Мен уәдемді орындағым келді.
Dialogue: 0,0:04:05.74,0:04:07.12,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:07.20,0:04:10.08,Default,,0,0,0,,Кал! Жетер, сөйлесуді доғар!
Dialogue: 0,0:04:10.16,0:04:12.92,Default,,0,0,0,,Се... Дүниені басып алу үшін
Dialogue: 0,0:04:13.00,0:04:15.00,Default,,0,0,0,,Мен жойқын Құдаймын...
Dialogue: 0,0:04:15.50,0:04:20.80,Default,,0,0,0,,Бірақ Антрасакстың күші қиялдан тыс еді.
Dialogue: 0,0:04:21.51,0:04:24.43,Default,,0,0,0,,Ол менің жарақатымды пайдаланды.
Dialogue: 0,0:04:24.51,0:04:26.89,Default,,0,0,0,,Жүрегімді жаулап алды
Dialogue: 0,0:04:30.10,0:04:31.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:31.93,0:04:35.48,Default,,0,0,0,,Неге... қайтып келмедің?
Dialogue: 0,0:04:36.86,0:04:40.19,Default,,0,0,0,,Даңқ та, арман да, утопия да жоқ
Dialogue: 0,0:04:40.28,0:04:41.69,Default,,0,0,0,,Сенсіз
Dialogue: 0,0:04:42.40,0:04:45.78,Default,,0,0,0,,Бұл бос иллюзиядан басқа ештеңе емес...
Dialogue: 0,0:04:45.86,0:04:46.70,Default,,0,0,0,,Каа!
Dialogue: 0,0:04:52.96,0:04:54.46,Default,,0,0,0,,Кал!
Dialogue: 0,0:04:56.12,0:04:59.46,Default,,0,0,0,,Ооооооооо!
Dialogue: 0,0:05:00.21,0:05:02.38,Default,,0,0,0,,Әлі өлме!
Dialogue: 0,0:05:03.01,0:05:05.34,Default,,0,0,0,,Өлуме жол берме!
Dialogue: 0,0:05:06.09,0:05:08.05,Default,,0,0,0,,Темені көтеріп алған мен едім!
Dialogue: 0,0:05:08.14,0:05:10.26,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:05:10.35,0:05:12.22,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:05:12.31,0:05:14.23,Default,,0,0,0,,Өз бетімен өлме!
Dialogue: 0,0:05:14.77,0:05:18.15,Default,,0,0,0,,Менің бұйрықтарымды естімейсіз бе?
Dialogue: 0,0:05:22.32,0:05:24.82,Default,,0,0,0,,Маған қамқор болған сен бе? Рақмет…
Dialogue: 0,0:05:26.15,0:05:27.91,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:05:28.78,0:05:29.78,Default,,0,0,0,,Көз жасы...
Dialogue: 0,0:05:31.45,0:05:34.79,Default,,0,0,0,,Менің жүрегімде махаббат жоқ сияқты
Dialogue: 0,0:05:34.87,0:05:36.79,Default,,0,0,0,,Бірақ бұл аса қайғылы емес.
Dialogue: 0,0:05:37.46,0:05:39.58,Default,,0,0,0,,Көз жасы деген жоқ
Dialogue: 0,0:05:40.92,0:05:42.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:43.55,0:05:47.05,Default,,0,0,0,,Сіз жоғалған жартыңызды таптыңыз.
Dialogue: 0,0:05:48.30,0:05:49.72,Default,,0,0,0,,Жылы көз жас...
Dialogue: 0,0:05:51.10,0:05:53.31,Default,,0,0,0,,Мен оны тапқанша, Кал...
Dialogue: 0,0:05:53.39,0:05:55.60,Default,,0,0,0,,Сен менің екінші жартым болдың
Dialogue: 0,0:06:00.02,0:06:01.36,Default,,0,0,0,,Енді...
Dialogue: 0,0:06:01.94,0:06:04.28,Default,,0,0,0,,Мені қажет ететіндер
Dialogue: 0,0:06:04.78,0:06:07.03,Default,,0,0,0,,Бірде-бір адам кеткен жоқ.
Dialogue: 0,0:06:07.53,0:06:08.41,Default,,0,0,0,,Кал!
Dialogue: 0,0:06:08.99,0:06:10.41,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:06:11.07,0:06:16.20,Default,,0,0,0,,Менің... өмірімдегі бірінші және жалғыз досым
Dialogue: 0,0:06:17.41,0:06:20.17,Default,,0,0,0,,Мен сен үшін өлгеніме қуаныштымын...
Dialogue: 0,0:06:20.79,0:06:22.00,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:31.43,0:06:32.76,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:47.53,0:06:48.53,Default,,0,0,0,,Қар?
Dialogue: 0,0:06:49.28,0:06:50.78,Default,,0,0,0,,Cal… Құрметті Кал
Dialogue: 0,0:06:50.86,0:06:52.07,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:06:52.16,0:06:55.91,Default,,0,0,0,,Дарк Шнайдермен байланыста болған естеліктер
Dialogue: 0,0:06:55.99,0:06:59.21,Default,,0,0,0,,Бұл Калдың жүрегіндегі бос орынды толтырған шығар.
Dialogue: 0,0:06:59.96,0:07:04.71,Default,,0,0,0,,Сол кезде Каль жеккөрініш сезімін күшейте түсті...
Dialogue: 0,0:07:05.21,0:07:07.92,Default,,0,0,0,,Мен Жоюшы Құдайдың қарғысын жеңдім.
Dialogue: 0,0:07:08.42,0:07:12.18,Default,,0,0,0,,Лорд Калды Жою Құдайы басқарды.
Dialogue: 0,0:07:12.76,0:07:14.14,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:07:14.22,0:07:16.85,Default,,0,0,0,,Осы уақытқа дейін не істедік
Dialogue: 0,0:07:16.93,0:07:18.77,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:19.39,0:07:22.52,Default,,0,0,0,,Олардың достығы Жоюшы Құдайдың күшіне айналады
Dialogue: 0,0:07:23.19,0:07:24.40,Default,,0,0,0,,Сіз жеңдіңіз, солай ма?
Dialogue: 0,0:07:24.98,0:07:29.86,Default,,0,0,0,,Ух... Ка... Кал-сама... Кал-сама!
Dialogue: 0,0:07:30.82,0:07:33.32,Default,,0,0,0,,Мен бірдеңе дұрыс емес екенін білдім.
Dialogue: 0,0:07:33.41,0:07:35.33,Default,,0,0,0,,Мен білуім керек еді
Dialogue: 0,0:07:36.37,0:07:38.79,Default,,0,0,0,,Шындыққа бет бұру
Dialogue: 0,0:07:39.62,0:07:42.29,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:07:42.37,0:07:44.75,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:07:44.84,0:07:46.42,Default,,0,0,0,,Хмм... не?
Dialogue: 0,0:07:46.50,0:07:47.42,Default,,0,0,0,,Сыбыс?
Dialogue: 0,0:07:47.50,0:07:49.51,Default,,0,0,0,,Аспандағы қала қозғала бастады ма?
Dialogue: 0,0:07:50.05,0:07:52.13,Default,,0,0,0,,Жоқ, жоқ, бұл...
Dialogue: 0,0:07:52.22,0:07:53.59,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:53.68,0:07:54.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:55.89,0:07:56.76,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,0:07:56.85,0:07:59.47,Default,,0,0,0,,Ах ка кааааааааааааааааааааааааааа...
Dialogue: 0,0:07:59.56,0:08:02.44,Default,,0,0,0,,(Кал Судың айқайы)
Dialogue: 0,0:08:02.52,0:08:05.06,Default,,0,0,0,,Кал!
Dialogue: 0,0:08:06.19,0:08:08.82,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:08:08.90,0:08:11.32,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Cal's.
Dialogue: 0,0:08:11.90,0:08:15.32,Default,,0,0,0,,Сіздің рөліңіз аяқталды.
Dialogue: 0,0:08:15.41,0:08:17.03,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:08:18.24,0:08:22.25,Default,,0,0,0,,Өлтір... тез... мені.
Dialogue: 0,0:08:22.33,0:08:25.67,Default,,0,0,0,,Сіздің сүйікті Дирк Шнайдермен
Dialogue: 0,0:08:25.75,0:08:27.21,Default,,0,0,0,,Өлген жөн
Dialogue: 0,0:08:27.29,0:08:29.71,Default,,0,0,0,,Ахахахаха!
Dialogue: 0,0:08:29.80,0:08:32.92,Default,,0,0,0,,Мені өлтір! Дирк Шнайдер!
Dialogue: 0,0:08:45.02,0:08:47.73,Default,,0,0,0,,Нуааааааах... арғх... арғ
Dialogue: 0,0:08:47.81,0:08:50.98,Default,,0,0,0,,Ааааааааааааааааааа!
Dialogue: 0,0:08:51.07,0:08:52.44,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:08:52.53,0:08:53.86,Default,,0,0,0,,Қаха…
Dialogue: 0,0:08:53.95,0:08:55.41,Default,,0,0,0,,Құрметті Кал!
Dialogue: 0,0:09:09.34,0:09:11.21,Default,,0,0,0,,Уф... аааа
Dialogue: 0,0:09:11.30,0:09:15.72,Default,,0,0,0,,Шүкір, бұл менікі.
Dialogue: 0,0:09:16.84,0:09:18.89,Default,,0,0,0,,Бұл менікі!
Dialogue: 0,0:09:18.97,0:09:20.47,Default,,0,0,0,,Гууууууууууууу
Dialogue: 0,0:09:20.56,0:09:23.68,Default,,0,0,0,,Кал!
Dialogue: 0,0:09:23.77,0:09:27.15,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:09:27.23,0:09:29.36,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:09:29.44,0:09:31.57,Default,,0,0,0,,Жоқ! Ах...
Dialogue: 0,0:09:31.65,0:09:34.03,Default,,0,0,0,,Ааа...
Dialogue: 0,0:09:34.11,0:09:36.07,Default,,0,0,0,,Шейла! Шейла!
Dialogue: 0,0:09:36.15,0:09:39.45,Default,,0,0,0,,Әй... екі жыл бұрынғыдай.
Dialogue: 0,0:09:39.53,0:09:41.66,Default,,0,0,0,,Мета-Ликанадағы Абигейлмен
Dialogue: 0,0:09:41.74,0:09:44.37,Default,,0,0,0,,Қараңғы Шнайдер соғысқанда
Dialogue: 0,0:09:44.45,0:09:46.37,Default,,0,0,0,,Мынау... мына жер шуылдады
Dialogue: 0,0:09:46.46,0:09:48.67,Default,,0,0,0,,Әй, бұл ғибадатханадан болып жатыр.
Dialogue: 0,0:09:49.92,0:09:50.79,Default,,0,0,0,,Га
Dialogue: 0,0:09:50.88,0:09:54.63,Default,,0,0,0,,Маған не болды...
Dialogue: 0,0:09:54.71,0:09:57.84,Default,,0,0,0,,Мен мұндай қарапайым нәрсені назардан тыс қалдырғаныма сене алар емеспін...
Dialogue: 0,0:09:57.93,0:09:59.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:59.84,0:10:00.76,Default,,0,0,0,,Йоко?
Dialogue: 0,0:10:00.85,0:10:02.81,Default,,0,0,0,,Ши… Құрметті Шейла
Dialogue: 0,0:10:02.89,0:10:07.98,Default,,0,0,0,,Хаа ха... Шейла-сама!
Dialogue: 0,0:10:08.06,0:10:09.60,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:10:11.15,0:10:14.40,Default,,0,0,0,,Өтінемін, Дирк Шнайдер
Dialogue: 0,0:10:17.61,0:10:18.82,Default,,0,0,0,,Бұл дүние
Dialogue: 0,0:10:19.91,0:10:22.66,Default,,0,0,0,,Қарапайым өмір сүретіндерге бақыт
Dialogue: 0,0:10:23.29,0:10:27.66,Default,,0,0,0,,Сізді қорғай алатын жалғыз адамсыз
Dialogue: 0,0:10:28.83,0:10:33.25,Default,,0,0,0,,Дүниеде туып, ауыр күн кешкендер
Dialogue: 0,0:10:34.63,0:10:36.51,Default,,0,0,0,,Барлық әлсіздер
Dialogue: 0,0:10:37.51,0:10:40.34,Default,,0,0,0,,Өтінемін, мені құтқарыңыз.
Dialogue: 0,0:10:42.22,0:10:44.39,Default,,0,0,0,,Мен ханшайым болып өстім
Dialogue: 0,0:10:45.14,0:10:47.14,Default,,0,0,0,,Алғаш рет тең дәрежеде
Dialogue: 0,0:10:47.81,0:10:52.44,Default,,0,0,0,,Ал маған әйел ретінде қараған алғашқы ер адам
Dialogue: 0,0:10:53.11,0:10:56.11,Default,,0,0,0,,Жақсы, мен сені қорғаймын.
Dialogue: 0,0:10:59.28,0:11:03.41,Default,,0,0,0,,Мен сені кездестірдім
Dialogue: 0,0:11:04.87,0:11:05.87,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:14.88,0:11:16.00,Default,,0,0,0,,Уф
Dialogue: 0,0:11:16.09,0:11:17.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:17.30,0:11:20.76,Default,,0,0,0,,Шыу!
Dialogue: 0,0:11:24.05,0:11:27.43,Default,,0,0,0,,Шейла!
Dialogue: 0,0:11:33.98,0:11:35.40,Default,,0,0,0,,Уф
Dialogue: 0,0:11:36.27,0:11:37.28,Default,,0,0,0,,Ғибадатхана
Dialogue: 0,0:11:37.90,0:11:38.99,Default,,0,0,0,,Өте рахмет! (Ол Майт) Ахахаха!
Dialogue: 0,0:11:39.49,0:11:41.36,Default,,0,0,0,,Соңғы мөр...
Dialogue: 0,0:11:41.45,0:11:42.86,Default,,0,0,0,,Сіз оны шештіңіз бе?
Dialogue: 0,0:11:51.29,0:11:53.17,Default,,0,0,0,,(Самурайдың айқайы)
Dialogue: 0,0:11:53.25,0:11:55.63,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:11:57.92,0:11:59.30,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:59.38,0:12:01.51,Default,,0,0,0,,Жақсарып келеді.
Dialogue: 0,0:12:02.80,0:12:03.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:04.01,0:12:06.68,Default,,0,0,0,,Құрметті Мифуне, бұл... бұл
Dialogue: 0,0:12:06.76,0:12:10.06,Default,,0,0,0,,Хахахаха! Мен жасадым
Dialogue: 0,0:12:10.56,0:12:14.65,Default,,0,0,0,,Мен одан бұрын бұл шынжырлардан босатылдым.
Dialogue: 0,0:12:15.23,0:12:20.11,Default,,0,0,0,,Қараңғылық заманы жерге қайтады.
Dialogue: 0,0:12:20.19,0:12:22.03,Default,,0,0,0,,Геодоно, бұл не?
Dialogue: 0,0:12:22.11,0:12:25.66,Default,,0,0,0,,Соңғы пломба бұзылған болуы мүмкін бе?
Dialogue: 0,0:12:26.83,0:12:29.41,Default,,0,0,0,,Жоқ, көтерілісшілер әскерін көшіріңіз.
Dialogue: 0,0:12:29.49,0:12:31.71,Default,,0,0,0,,Гаммет Бұл жерде қауіпті.
Dialogue: 0,0:12:31.79,0:12:34.25,Default,,0,0,0,,Құрметті Мифуне, Иуда сарайы
Dialogue: 0,0:12:35.75,0:12:36.75,Default,,0,0,0,,Ұш!
Dialogue: 0,0:12:42.30,0:12:44.68,Default,,0,0,0,,Мен... сене алар емеспін.
Dialogue: 0,0:12:44.76,0:12:47.68,Default,,0,0,0,,Қамал бүкіл жермен бірге жүзеді!
Dialogue: 0,0:12:48.18,0:12:50.35,Default,,0,0,0,,Бұл ескі дүние сиқыры
Dialogue: 0,0:12:50.43,0:12:53.94,Default,,0,0,0,,Жер асты ғибадатханасының айналасындағы ауырлық күші жабылды.
Dialogue: 0,0:12:54.64,0:12:57.56,Default,,0,0,0,,Тозақтың қақпағы ашылғандай.
Dialogue: 0,0:12:58.06,0:13:01.94,Default,,0,0,0,,Қараңызшы, Батори, найзағайлар бір-біріне жақындап, қамал қирап жатыр.
Dialogue: 0,0:13:02.03,0:13:04.95,Default,,0,0,0,,Жер асты тау жыныстарымен бірге ұшып жатыр.
Dialogue: 0,0:13:05.03,0:13:08.78,Default,,0,0,0,,Қара энергия сол бір нүктеде шоғырланған.
Dialogue: 0,0:13:09.95,0:13:11.04,Default,,0,0,0,,Сол жерде.
Dialogue: 0,0:13:11.12,0:13:14.00,Default,,0,0,0,,Жоюшы Құдай сонда пайда болады.
Dialogue: 0,0:13:15.67,0:13:18.54,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:13:18.63,0:13:25.63,Default,,0,0,0,,(Антрасакстың айқайы)
Dialogue: 0,0:13:27.05,0:13:28.89,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:13:28.97,0:13:30.43,Default,,0,0,0,,Бейкемоно
Dialogue: 0,0:13:30.51,0:13:32.89,Default,,0,0,0,,А... а... мінекей.
Dialogue: 0,0:13:32.97,0:13:36.77,Default,,0,0,0,,Жоюдың қара құдайы Сібір жарасы?
Dialogue: 0,0:13:38.06,0:13:40.27,Default,,0,0,0,,Жәндіктер!
Dialogue: 0,0:13:40.90,0:13:45.53,Default,,0,0,0,,400 жылдан кейін қайта тірілмеймін.
Dialogue: 0,0:13:46.65,0:13:52.54,Default,,0,0,0,,Енді Құдайдың ақымақ адамзатты тағы да соттайтын кезі.
Dialogue: 0,0:13:53.50,0:13:55.79,Default,,0,0,0,,Барлығына өлім жазасы
Dialogue: 0,0:13:57.00,0:13:58.50,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:13:59.08,0:14:01.42,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:01.50,0:14:03.38,Default,,0,0,0,,(сарбаздардың айқайы)
Dialogue: 0,0:14:03.46,0:14:05.80,Default,,0,0,0,,Ал... соққы толқыны келе жатыр.
Dialogue: 0,0:14:05.88,0:14:07.34,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:14:07.43,0:14:09.14,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:14:09.22,0:14:12.10,Default,,0,0,0,,Уф... ну...
Dialogue: 0,0:14:12.18,0:14:14.60,Default,,0,0,0,,Қандай жойқын күш!
Dialogue: 0,0:14:15.14,0:14:16.56,Default,,0,0,0,,Бұл жер де қорқынышты.
Dialogue: 0,0:14:16.64,0:14:17.64,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:14:17.73,0:14:20.06,Default,,0,0,0,,Ол кісінің айтқаны рас па?
Dialogue: 0,0:14:20.15,0:14:22.77,Default,,0,0,0,,А... бұл Құдай емес.
Dialogue: 0,0:14:22.86,0:14:25.74,Default,,0,0,0,,Ол... Ол...
Dialogue: 0,0:14:25.82,0:14:28.66,Default,,0,0,0,,Тозақтан қайтып келген құбыжық.
Dialogue: 0,0:14:30.28,0:14:34.16,Default,,0,0,0,,Хмм... хахахаха
Dialogue: 0,0:14:35.12,0:14:38.12,Default,,0,0,0,,Біз ең жоғарғы күшпіз
Dialogue: 0,0:14:38.87,0:14:41.63,Default,,0,0,0,,Мен жоюға ерік-жігермін
Dialogue: 0,0:14:42.17,0:14:46.30,Default,,0,0,0,,Мен қайта тірілген Ақиқат Иесімін
Dialogue: 0,0:14:46.84,0:14:50.26,Default,,0,0,0,,Қанның, еттің, аштық пен қалаудың Құдайы
Dialogue: 0,0:14:50.84,0:14:54.06,Default,,0,0,0,,Көптен күткен күн де келді
Dialogue: 0,0:14:54.14,0:14:57.02,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:14:57.10,0:15:01.73,Default,,0,0,0,,400 жыл күттім жер қойнауында
Dialogue: 0,0:15:02.31,0:15:05.65,Default,,0,0,0,,Сендер жерде жорғалап жүрген жәндіктер
Dialogue: 0,0:15:05.73,0:15:10.36,Default,,0,0,0,,Бұрандаларды өлтіруді ғана армандап, таптау
Dialogue: 0,0:15:10.45,0:15:13.45,Default,,0,0,0,,Қорқыныш айқайы Үмітсіздік көз жасы
Dialogue: 0,0:15:13.53,0:15:17.75,Default,,0,0,0,,Қанды ет пен сүйектің үйіндісі
Dialogue: 0,0:15:18.50,0:15:22.83,Default,,0,0,0,,Ал сендерді құрттарды жейтін тозақ оты⸺
Dialogue: 0,0:15:22.92,0:15:24.92,Default,,0,0,0,,Еттің жеп бара жатқан дыбысы
Dialogue: 0,0:15:25.00,0:15:28.88,Default,,0,0,0,,Олардың барлығы Маған арналған тартулар.
Dialogue: 0,0:15:28.97,0:15:30.80,Default,,0,0,0,,Фуфухахахахаха
Dialogue: 0,0:15:30.88,0:15:33.80,Default,,0,0,0,,Барлық тірі заттарды өлтіріңіз
Dialogue: 0,0:15:33.89,0:15:37.64,Default,,0,0,0,,Мен пішіні бар нәрсені бөлшектеймін.
Dialogue: 0,0:15:38.18,0:15:43.73,Default,,0,0,0,,Мен саған тозақ азабы мен рахатын беремін.
Dialogue: 0,0:15:44.40,0:15:46.32,Default,,0,0,0,,Алланың құдіретімен
Dialogue: 0,0:15:46.40,0:15:47.94,Default,,0,0,0,,Хэхехе... хахахаха!
Dialogue: 0,0:15:48.03,0:15:50.03,Default,,0,0,0,,Міне... аспанда жүз бар
Dialogue: 0,0:15:51.49,0:15:53.74,Default,,0,0,0,,Ах... бұл Жою Құдайы.
Dialogue: 0,0:15:54.24,0:15:55.87,Default,,0,0,0,,Сібір жарасы
Dialogue: 0,0:15:55.95,0:15:57.74,Default,,0,0,0,,Егер осылай салқынқанды болып жүре берсең, сүйкімді жүзіңді бүлдіріп аласың.
Dialogue: 0,0:15:57.83,0:16:03.83,Default,,0,0,0,,Мен, жын соғысының генералы... қорқыныштан денем дірілдейді.
Dialogue: 0,0:16:03.92,0:16:07.05,Default,,0,0,0,,Қандай жаман көрініс!
Dialogue: 0,0:16:07.13,0:16:09.05,Default,,0,0,0,,Ол дамып келеді
Dialogue: 0,0:16:09.13,0:16:12.51,Default,,0,0,0,,Мен Яһуда сарайының жерасты ғибадатханасында болғаннан да көп.
Dialogue: 0,0:16:12.59,0:16:15.72,Default,,0,0,0,,Өте алып құдай Сібір жарасы
Dialogue: 0,0:16:16.68,0:16:21.98,Default,,0,0,0,,Бұл әлемге жойылу, өлім және қорқыныш әкелу үшін ғана бар біреу.
Dialogue: 0,0:16:22.06,0:16:25.36,Default,,0,0,0,,Оның қорқынышты супер-деструктивті қабілеті бір кездері болған
Dialogue: 0,0:16:25.44,0:16:31.07,Default,,0,0,0,,Жер бетінде гүлденген адамзат жеті күнде жойылды дейді.
Dialogue: 0,0:16:32.45,0:16:34.78,Default,,0,0,0,,Барлық тірі заттар жойылғанға дейін
Dialogue: 0,0:16:34.86,0:16:38.08,Default,,0,0,0,,Оның қызметі ешқашан тоқтамайды.
Dialogue: 0,0:16:39.45,0:16:43.87,Default,,0,0,0,,Ескі дүниенің сиқыры қараңғылықтан біртүрлі зұлым құдайды шығарды.
Dialogue: 0,0:16:43.96,0:16:46.96,Default,,0,0,0,,Ақыры бұл дүниеде қайта тірілдім.
Dialogue: 0,0:16:47.04,0:16:50.05,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:16:50.13,0:16:51.34,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:16:51.84,0:16:53.26,Default,,0,0,0,,Қал болса
Dialogue: 0,0:16:53.34,0:16:55.76,Default,,0,0,0,,Мен Дарк Шнайдерді жеңе алмасам да
Dialogue: 0,0:16:55.84,0:16:58.64,Default,,0,0,0,,Екі қара күш соқтығысса
Dialogue: 0,0:16:58.72,0:17:01.72,Default,,0,0,0,,Пломба бәрібір сынып қалады
Dialogue: 0,0:17:02.48,0:17:03.73,Default,,0,0,0,,Мен ауырдым
Dialogue: 0,0:17:03.81,0:17:07.23,Default,,0,0,0,,Бұл Қиратушы Құдайдың шынайы мақсаты болды.
Dialogue: 0,0:17:07.31,0:17:10.15,Default,,0,0,0,,Енді бәрі бітті
Dialogue: 0,0:17:10.23,0:17:11.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:11.53,0:17:15.95,Default,,0,0,0,,Қарғыс атқыр, адамзат осымен жойыла ма?
Dialogue: 0,0:17:17.62,0:17:20.54,Default,,0,0,0,,Әлі жеңілетініміз шешілген жоқ.
Dialogue: 0,0:17:21.04,0:17:23.91,Default,,0,0,0,,Адамзат әлі өлген жоқ.
Dialogue: 0,0:17:25.71,0:17:26.92,Default,,0,0,0,,Йоко
Dialogue: 0,0:17:27.42,0:17:30.63,Default,,0,0,0,,Өмірден өткен жақындары үшін
Dialogue: 0,0:17:31.25,0:17:34.92,Default,,0,0,0,,Біз де жақын адамдарымызды қорғауымыз керек.
Dialogue: 0,0:17:35.01,0:17:37.34,Default,,0,0,0,,Біз ұтыла алмаймыз
Dialogue: 0,0:17:38.34,0:17:41.18,Default,,0,0,0,,Жау Құдай болса да!
Dialogue: 0,0:17:48.27,0:17:51.27,Default,,0,0,0,,(Аня) Аня, маған бұлар ұнамайды.
Dialogue: 0,0:17:51.36,0:17:55.24,Default,,0,0,0,,Уууу!
Dialogue: 0,0:17:55.32,0:17:59.20,Default,,0,0,0,,Мен сені кешірмеймін.
Dialogue: 0,0:17:59.28,0:18:03.24,Default,,0,0,0,,А... анау жігіт мұндай денені не қылмақ?
Dialogue: 0,0:18:03.75,0:18:07.29,Default,,0,0,0,,Хэхехе! Дирк Шнайдер
Dialogue: 0,0:18:07.37,0:18:11.21,Default,,0,0,0,,Сіз жеңу мүмкіндігіңіз жоқ шайқаста күресуге тырысып жатырсыз.
Dialogue: 0,0:18:11.29,0:18:12.88,Default,,0,0,0,,Жалғыз
Dialogue: 0,0:18:12.96,0:18:16.97,Default,,0,0,0,,Шүкір, мен күш-қуатымды жоғалтып жатырмын.
Dialogue: 0,0:18:17.05,0:18:18.59,Default,,0,0,0,,Қан жеткіліксіз
Dialogue: 0,0:18:18.68,0:18:23.22,Default,,0,0,0,,Керемет, сен осы уақытқа дейін шайқасты.
Dialogue: 0,0:18:23.31,0:18:28.06,Default,,0,0,0,,Хехехе... Сауап ретінде сені 1000 ет кесемін.
Dialogue: 0,0:18:28.14,0:18:31.15,Default,,0,0,0,,Хахахаха! Мен сені қинаймын
Dialogue: 0,0:18:31.23,0:18:33.23,Default,,0,0,0,,Мен сені қинаймын
Dialogue: 0,0:18:33.32,0:18:37.45,Default,,0,0,0,,Сенің азаптарың тозақта аңызға айналады.
Dialogue: 0,0:18:37.53,0:18:42.95,Default,,0,0,0,,Ал Кал сияқты, менің денемнің бір бөлігі бол.
Dialogue: 0,0:18:43.03,0:18:44.91,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:46.08,0:18:47.33,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:18:47.41,0:18:48.79,Default,,0,0,0,,Руше
Dialogue: 0,0:18:48.87,0:18:50.29,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:18:50.37,0:18:56.38,Default,,0,0,0,,Бұл мұз айдаһары менің жасушаларымның біріндей ғана күшті.
Dialogue: 0,0:18:56.46,0:19:01.47,Default,,0,0,0,,Бірақ сені өз бетімен басып кетуге жеткілікті болды.
Dialogue: 0,0:19:01.55,0:19:03.97,Default,,0,0,0,,Таң қалдырады, ауырады ма?
Dialogue: 0,0:19:04.06,0:19:07.18,Default,,0,0,0,,Бұл ауырады ма? Ауырды ма?
Dialogue: 0,0:19:07.27,0:19:09.48,Default,,0,0,0,,Мияу~ Мен шыдай алмаймын.
Dialogue: 0,0:19:09.56,0:19:12.40,Default,,0,0,0,,Кел, Құдайдың ақыры
Dialogue: 0,0:19:12.48,0:19:14.90,Default,,0,0,0,,Өлсең...
Dialogue: 0,0:19:15.69,0:19:20.20,Default,,0,0,0,,Бұл Сібір жарасын кім жоя алады?
Dialogue: 0,0:19:20.28,0:19:23.28,Default,,0,0,0,,Жерде болмағанмен бірдей
Dialogue: 0,0:19:23.37,0:19:25.28,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:19:27.45,0:19:28.45,Default,,0,0,0,,Кал!
Dialogue: 0,0:19:30.25,0:19:32.58,Default,,0,0,0,,Ларстың сұмдығы қорқынышты.
Dialogue: 0,0:19:32.67,0:19:36.05,Default,,0,0,0,,Ол менімен саудаласпақшы.
Dialogue: 0,0:19:36.80,0:19:38.13,Default,,0,0,0,,Мен өліп қалуым мүмкін
Dialogue: 0,0:19:38.63,0:19:40.01,Default,,0,0,0,,Бірақ егер бұл орын алса
Dialogue: 0,0:19:40.09,0:19:41.84,Default,,0,0,0,,Осы уақытқа дейін.
Dialogue: 0,0:19:42.34,0:19:44.10,Default,,0,0,0,,Мен қорықпаймын.
Dialogue: 0,0:19:44.85,0:19:46.68,Default,,0,0,0,,Содан кейін Дирк Шнайдер
Dialogue: 0,0:19:47.56,0:19:50.18,Default,,0,0,0,,Мен сені өміріммен міндетті түрде қорғаймын
Dialogue: 0,0:19:58.23,0:19:59.94,Default,,0,0,0,,Әрине!
Dialogue: 0,0:20:00.03,0:20:03.11,Default,,0,0,0,,Сенің өмірің менікі.
Dialogue: 0,0:20:03.20,0:20:04.53,Default,,0,0,0,,Ұмытпаңыз
Dialogue: 0,0:20:05.03,0:20:07.70,Default,,0,0,0,,Сен мен үшін өлуің керек
Dialogue: 0,0:20:08.58,0:20:11.00,Default,,0,0,0,,Мен Кал
Dialogue: 0,0:20:14.96,0:20:17.34,Default,,0,0,0,,Уууу!
Dialogue: 0,0:20:17.42,0:20:20.30,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:20:22.43,0:20:26.26,Default,,0,0,0,,17 жыл бұрын орындай алмаған саған берген антымды
Dialogue: 0,0:20:26.35,0:20:28.26,Default,,0,0,0,,Қал қорғалды.
Dialogue: 0,0:20:30.81,0:20:34.73,Default,,0,0,0,,Қарғыс атсын... Мен өлмеймін!
Dialogue: 0,0:20:35.31,0:20:37.94,Default,,0,0,0,,Каль Сізде бар!
Dialogue: 0,0:20:38.02,0:20:40.78,Default,,0,0,0,,Няхаха баака
Dialogue: 0,0:20:40.86,0:20:47.16,Default,,0,0,0,,Егер бәріңіз ұсақталған болсаңыз да, Құдайға жалғыз өзіңіз бәрін жасай аласыз.
Dialogue: 0,0:20:47.24,0:20:49.12,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:20:49.20,0:20:53.00,Default,,0,0,0,,Әй, өл.
Dialogue: 0,0:20:53.08,0:20:54.25,Default,,0,0,0,,Ах
Dialogue: 0,0:20:54.33,0:20:56.54,Default,,0,0,0,,Антра сәулесі!
Dialogue: 0,0:20:58.13,0:20:59.71,Default,,0,0,0,,Сіз жалғыз емессіз!
Dialogue: 0,0:21:00.21,0:21:01.05,Default,,0,0,0,,Нин!
Dialogue: 0,0:21:03.42,0:21:05.64,Default,,0,0,0,,Жарық сәулесінің ақ жүзін алып тастау!
Dialogue: 0,0:21:05.72,0:21:06.59,Default,,0,0,0,,Не!
Dialogue: 0,0:21:06.68,0:21:09.01,Default,,0,0,0,,Не~!
Dialogue: 0,0:21:09.56,0:21:11.56,Default,,0,0,0,,Ммм... әдемі
Dialogue: 0,0:21:11.64,0:21:13.77,Default,,0,0,0,,Эй, мен оны қайтарамын.
Dialogue: 0,0:21:13.85,0:21:14.94,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:21:17.02,0:21:22.57,Default,,0,0,0,,«Камен Ниндзя πr2» мүлдем жеңілмейтін жұмбақ қаһарманмен танысыңыз!
Dialogue: 0,0:21:23.19,0:21:24.40,Default,,0,0,0,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,0:21:24.49,0:21:25.49,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:26.49,0:21:27.37,Default,,0,0,0,,Гала?
Dialogue: 0,0:21:27.95,0:21:30.87,Default,,0,0,0,,Неге! Сіз қалай білесіз!
Dialogue: 0,0:21:30.95,0:21:32.58,Default,,0,0,0,,Бетперде болса да
Dialogue: 0,0:21:33.12,0:21:35.46,Default,,0,0,0,,Мына жігіттің бетпердесі сұмдық.
Dialogue: 0,0:21:40.25,0:21:43.38,Default,,0,0,0,,Райджин патшасы құйрықты жұлдызы!
Dialogue: 0,0:21:43.88,0:21:45.09,Default,,0,0,0,,Аа...
Dialogue: 0,0:21:47.39,0:21:52.85,Default,,0,0,0,,Енді Даршқа шаштың көлеміндей жара да бере алмайсың.
Dialogue: 0,0:21:52.93,0:21:54.27,Default,,0,0,0,,Күл...
Dialogue: 0,0:21:54.85,0:21:55.98,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:56.85,0:21:58.98,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:22:03.53,0:22:04.57,Default,,0,0,0,,Хмм!
Dialogue: 0,0:22:05.11,0:22:08.11,Default,,0,0,0,,Өлі рух зеңбіректерін түрмеге жабу (Фо Бе Дун)!
Dialogue: 0,0:22:10.12,0:22:13.12,Default,,0,0,0,,Сиқыршы патша Дарк Шнайдер үнемі
Dialogue: 0,0:22:13.20,0:22:18.21,Default,,0,0,0,,Сізге ең күшті және жеңілмейтін Төрт Аспан Патшасы ереді!
Dialogue: 0,0:22:21.00,0:22:23.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:47.88,0:23:49.88,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.38,0:23:57.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory