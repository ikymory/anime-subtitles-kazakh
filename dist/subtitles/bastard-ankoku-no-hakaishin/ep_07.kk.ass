Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.10,0:00:22.10,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:00:22.18,0:00:23.77,Default,,0,0,0,,Күтіңіз~ (Бала) Күтіңіз.
Dialogue: 0,0:00:23.85,0:00:26.56,Default,,0,0,0,,Қарашы (бала) Шера-сама!
Dialogue: 0,0:00:26.65,0:00:28.98,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:00:32.03,0:00:33.86,Default,,0,0,0,,Сіз қашан кетесіз?
Dialogue: 0,0:00:34.95,0:00:37.28,Default,,0,0,0,,дирижабль дайын болғаннан кейін
Dialogue: 0,0:00:38.20,0:00:41.41,Default,,0,0,0,,Шера Біз жоқта
Dialogue: 0,0:00:41.50,0:00:43.91,Default,,0,0,0,,Қалсу мырза мен балаларды сұраңыз.
Dialogue: 0,0:00:44.92,0:00:45.92,Default,,0,0,0,,Иә
Dialogue: 0,0:00:48.42,0:00:50.17,Default,,0,0,0,,Аман-есен оралыңыз.
Dialogue: 0,0:00:51.51,0:00:52.72,Default,,0,0,0,,Ынви
Dialogue: 0,0:00:55.13,0:00:58.55,Default,,0,0,0,,Сіз қолдайтын балаларыңыз үшін
Dialogue: 0,0:01:06.90,0:01:08.90,Default,,0,0,0,,♪～
Dialogue: 0,0:02:32.06,0:02:34.07,Default,,0,0,0,,～♪
Dialogue: 0,0:02:37.78,0:02:39.40,Default,,0,0,0,,Мен сөйлесе аламын ба?
Dialogue: 0,0:02:39.49,0:02:42.41,Default,,0,0,0,,Неліктен Жындар қолбасшысы экспедициялық күште жоқ?
Dialogue: 0,0:02:42.49,0:02:44.33,Default,,0,0,0,,Сіз қайда және не істеп жатырсыз?
Dialogue: 0,0:02:44.83,0:02:46.75,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:02:46.83,0:02:49.41,Default,,0,0,0,,Ал... жын соғысының генералдары
Dialogue: 0,0:02:49.50,0:02:52.21,Default,,0,0,0,,Орктар бұл континентте емес
Dialogue: 0,0:02:52.29,0:02:53.50,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:02:53.59,0:02:54.92,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:02:55.00,0:02:55.84,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:02:56.34,0:02:59.38,Default,,0,0,0,,Қанқызыл Патша Орк Даңқы
Dialogue: 0,0:03:00.01,0:03:01.22,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:03:01.30,0:03:04.85,Default,,0,0,0,,Король Кримсон Даңқы?
Dialogue: 0,0:03:04.93,0:03:08.35,Default,,0,0,0,,Гуфагуфа! Мен енді жете алмаймын
Dialogue: 0,0:03:08.43,0:03:12.86,Default,,0,0,0,,Жын соғысының генералдары орктарға шабуыл жасау үшін дирижабльдерді пайдаланады.
Dialogue: 0,0:03:12.94,0:03:16.82,Default,,0,0,0,,Бұл жойылу құдайы Сібір жарасын оятады.
Dialogue: 0,0:03:16.90,0:03:20.03,Default,,0,0,0,,Сіз үшін бітті, Орктар.
Dialogue: 0,0:03:20.53,0:03:22.87,Default,,0,0,0,,Қарғыс атсын... Патша?
Dialogue: 0,0:03:22.95,0:03:24.53,Default,,0,0,0,,Бұл аңызға айналған қираған астана.
Dialogue: 0,0:03:24.62,0:03:26.99,Default,,0,0,0,,Кезінде эльфтер гүлденген дейді.
Dialogue: 0,0:03:27.08,0:03:27.91,Default,,0,0,0,,Онда Жибрилмен кім шайқасқан?
Dialogue: 0,0:03:28.00,0:03:29.83,Default,,0,0,0,,Мен де естідім.
Dialogue: 0,0:03:30.50,0:03:33.25,Default,,0,0,0,,Олар жеткілікті дамыған сиқырлы өркениетке ие болса керек.
Dialogue: 0,0:03:33.79,0:03:36.71,Default,,0,0,0,,Бұл шамамен 100 жыл бұрын бір күн болды.
Dialogue: 0,0:03:36.80,0:03:39.13,Default,,0,0,0,,Барлық тұрғындар жоғалып кетті...
Dialogue: 0,0:03:39.76,0:03:41.34,Default,,0,0,0,,және дәстүр дейді
Dialogue: 0,0:03:41.93,0:03:43.93,Default,,0,0,0,,Жою Құдайы оянады
Dialogue: 0,0:03:44.47,0:03:48.06,Default,,0,0,0,,Бұл соңғы мөрдің бар екенін білдіре ме?
Dialogue: 0,0:03:48.14,0:03:50.52,Default,,0,0,0,,Шейла-сама осындай зерттелмеген аймақта ма?
Dialogue: 0,0:03:51.52,0:03:54.81,Default,,0,0,0,,Бұл мен және Люси-кун кездегідей телепортация
Dialogue: 0,0:03:54.90,0:03:58.32,Default,,0,0,0,,Дарк Шнайдер Шейла ханымды ауыстырды.
Dialogue: 0,0:04:03.57,0:04:07.33,Default,,0,0,0,,Бірақ эльвен қалаларын адамдар таба алмайды.
Dialogue: 0,0:04:07.41,0:04:10.41,Default,,0,0,0,,Тіршілік орындары әртүрлі және сиқырлы тосқауыл бар.
Dialogue: 0,0:04:10.95,0:04:14.08,Default,,0,0,0,,Эльфтер адамдармен араласуды жек көретін.
Dialogue: 0,0:04:14.58,0:04:17.21,Default,,0,0,0,,Сонда қираған қаланың орнын қалай тапты?
Dialogue: 0,0:04:17.79,0:04:21.55,Default,,0,0,0,,Ал қазір мөр бар екенін қайдан білесің?
Dialogue: 0,0:04:22.30,0:04:23.30,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:04:23.38,0:04:27.85,Default,,0,0,0,,Бірақ біз мүмкіндігінше тезірек Шейла ханшайымға баруымыз керек.
Dialogue: 0,0:04:28.93,0:04:29.93,Default,,0,0,0,,Асығу керек
Dialogue: 0,0:04:30.77,0:04:34.98,Default,,0,0,0,,Мәселе қираған астанаға олардан тезірек жетуде...
Dialogue: 0,0:04:35.48,0:04:39.61,Default,,0,0,0,,Егер соңғы мөр бұзылса және Жоюшы Құдай көтерілсе,
Dialogue: 0,0:04:39.69,0:04:41.11,Default,,0,0,0,,Адамзат жойылады
Dialogue: 0,0:04:42.15,0:04:45.99,Default,,0,0,0,,Бірақ олар қираған астананың қайда екенін білмейді деп ойлаймын.
Dialogue: 0,0:04:47.20,0:04:49.62,Default,,0,0,0,,Себебі мен Шейла-саманы ауыстырдым.
Dialogue: 0,0:04:49.70,0:04:52.00,Default,,0,0,0,,Люс... Дирк Шнайдер
Dialogue: 0,0:04:52.08,0:04:54.50,Default,,0,0,0,,Мен қираған астананың қайда екенін білемін деп ойлаймын.
Dialogue: 0,0:04:55.29,0:04:56.96,Default,,0,0,0,,Ах! (Йоко) Ах!
Dialogue: 0,0:04:57.04,0:04:58.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:59.04,0:05:00.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:00.67,0:05:03.01,Default,,0,0,0,,Осы төтенше жағдайда не ойлайсыз?
Dialogue: 0,0:05:03.09,0:05:05.55,Default,,0,0,0,,Сіз әлі үйренген жоқсыз ба?
Dialogue: 0,0:05:05.63,0:05:06.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:07.05,0:05:09.39,Default,,0,0,0,,Әлгі ақымақ...
Dialogue: 0,0:05:09.47,0:05:11.52,Default,,0,0,0,,Сіз менімен шындап айналысқыңыз келе ме?
Dialogue: 0,0:05:12.89,0:05:15.02,Default,,0,0,0,,Әлде басқа аудармасы бар ма?
Dialogue: 0,0:05:17.35,0:05:19.27,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:05:19.90,0:05:21.23,Default,,0,0,0,,Дауыл?
Dialogue: 0,0:05:24.86,0:05:28.07,Default,,0,0,0,,Әй, жараларың жақсы ма?
Dialogue: 0,0:05:28.91,0:05:30.91,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:30.99,0:05:34.20,Default,,0,0,0,,Жасыратын жер осында. Іске сәт.
Dialogue: 0,0:05:35.25,0:05:36.67,Default,,0,0,0,,Күтпеген жағдайлар болған жағдайда
Dialogue: 0,0:05:36.75,0:05:39.75,Default,,0,0,0,,Заттар бұзылған кезде, міндетті түрде осында жиналыңыз.
Dialogue: 0,0:05:39.84,0:05:42.25,Default,,0,0,0,,Әй, түсіндің, ақымақ!
Dialogue: 0,0:05:42.34,0:05:43.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:43.59,0:05:47.22,Default,,0,0,0,,Цк... Ұнамайтын адамның қыры есіме түсті.
Dialogue: 0,0:05:50.80,0:05:54.43,Default,,0,0,0,,Тоқта, содан бері екі жыл өтті.
Dialogue: 0,0:05:54.52,0:05:57.52,Default,,0,0,0,,Мен ешкім күтпейді деп ойлаймын.
Dialogue: 0,0:05:58.48,0:06:00.40,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:06:00.48,0:06:02.82,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:06:13.37,0:06:14.58,Default,,0,0,0,,Дарш…
Dialogue: 0,0:06:33.39,0:06:37.35,Default,,0,0,0,,(Музыкалық аспаптарда ойнау)
Dialogue: 0,0:06:38.98,0:06:40.31,Default,,0,0,0,,Ха...
Dialogue: 0,0:06:41.40,0:06:44.23,Default,,0,0,0,,(ою-өрнек дыбысы)
Dialogue: 0,0:06:53.45,0:06:54.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:57.45,0:06:59.33,Default,,0,0,0,,О...
Dialogue: 0,0:07:05.13,0:07:07.05,Default,,0,0,0,,Не болды...
Dialogue: 0,0:07:10.22,0:07:13.05,Default,,0,0,0,,Менде... біртүрлі нәрсе бар.
Dialogue: 0,0:07:13.60,0:07:14.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:19.18,0:07:22.44,Default,,0,0,0,,Мен Люстің маған қарап тұрғанына ұялып тұрмын.
Dialogue: 0,0:07:24.48,0:07:26.15,Default,,0,0,0,,Саналы болу
Dialogue: 0,0:07:29.11,0:07:30.11,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:07:32.16,0:07:35.78,Default,,0,0,0,,Сенің махаббатың он миллиард өлімнен артық.
Dialogue: 0,0:07:37.95,0:07:38.87,Default,,0,0,0,,Мен сені ұстаймын
Dialogue: 0,0:07:39.58,0:07:41.33,Default,,0,0,0,,Да... жоқ!
Dialogue: 0,0:07:44.92,0:07:48.63,Default,,0,0,0,,Ол маған сондай күшпен келе жатса да...
Dialogue: 0,0:07:48.71,0:07:49.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:50.42,0:07:51.51,Default,,0,0,0,,Гухаа
Dialogue: 0,0:08:00.68,0:08:03.27,Default,,0,0,0,,Бұл кез келген қыз болуы мүмкін бе?
Dialogue: 0,0:08:05.23,0:08:06.65,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:08:07.40,0:08:09.73,Default,,0,0,0,,Мен әрқашан бас тартқандықтан ба?
Dialogue: 0,0:08:14.66,0:08:16.87,Default,,0,0,0,,Жеңіс тілеу үшін арнау биі
Dialogue: 0,0:08:17.58,0:08:20.12,Default,,0,0,0,,Бүгін сен бұрынғыдан да құмарсың.
Dialogue: 0,0:08:20.62,0:08:24.17,Default,,0,0,0,,Аа, мен біреуге ғашық болғаныма сенімдімін
Dialogue: 0,0:08:28.04,0:08:30.96,Default,,0,0,0,,(ою-өрнек дыбысы)
Dialogue: 0,0:08:33.05,0:08:35.68,Default,,0,0,0,,(ою-өрнек дыбысы)
Dialogue: 0,0:08:38.05,0:08:41.93,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:08:42.02,0:08:47.52,Default,,0,0,0,,(Самурайлар шапалақтау және қошемет көрсету)
Dialogue: 0,0:08:48.57,0:08:49.98,Default,,0,0,0,,Йоко…
Dialogue: 0,0:08:56.16,0:08:58.16,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:08:58.78,0:09:00.70,Default,,0,0,0,,Ханзада нұсқауы
Dialogue: 0,0:09:01.29,0:09:04.66,Default,,0,0,0,,(Бірнеше қадам)
Dialogue: 0,0:09:05.92,0:09:07.25,Default,,0,0,0,,Сәлем Джошуа
Dialogue: 0,0:09:07.33,0:09:10.63,Default,,0,0,0,,Ханзада бізді не үшін шақырды?
Dialogue: 0,0:09:11.21,0:09:12.42,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:09:12.51,0:09:14.76,Default,,0,0,0,,Мен жаңа ғана жертөлеге келу туралы нұсқау алдым.
Dialogue: 0,0:09:15.26,0:09:16.26,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:16.34,0:09:19.26,Default,,0,0,0,,Ке! Бұл көгерген және мұңды жертөледе
Dialogue: 0,0:09:19.35,0:09:22.14,Default,,0,0,0,,Сіз маған ұялмай қоңырау шалдыңыз
Dialogue: 0,0:09:22.22,0:09:25.94,Default,,0,0,0,,Мен сияқты сұлуға жараспайды.
Dialogue: 0,0:09:26.02,0:09:29.94,Default,,0,0,0,,Сіздің жаңа салқын киіміңіз кірленеді, солай ма?
Dialogue: 0,0:09:30.02,0:09:32.28,Default,,0,0,0,,Ненене~ Йоко-сан~
Dialogue: 0,0:09:32.86,0:09:33.61,Default,,0,0,0,,Хун
Dialogue: 0,0:09:33.69,0:09:36.70,Default,,0,0,0,,Одан аулақ болуға болады~
Dialogue: 0,0:09:36.78,0:09:38.49,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:09:49.46,0:09:50.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:53.21,0:09:54.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:55.01,0:09:56.76,Default,,0,0,0,,Бұл құрылғының қандай да бір түрі ме?
Dialogue: 0,0:09:58.72,0:10:00.05,Default,,0,0,0,,Қақпа…
Dialogue: 0,0:10:09.19,0:10:10.77,Default,,0,0,0,,Бұл қақпа
Dialogue: 0,0:10:10.86,0:10:11.86,Default,,0,0,0,,Қақпа дегеніміз не?
Dialogue: 0,0:10:13.02,0:10:14.03,Default,,0,0,0,,Телепортация қақпасы
Dialogue: 0,0:10:14.61,0:10:16.24,Default,,0,0,0,,Бұл эльфтер.
Dialogue: 0,0:10:16.32,0:10:17.99,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:10:18.07,0:10:19.82,Default,,0,0,0,,Куккуккукку
Dialogue: 0,0:10:20.41,0:10:24.12,Default,,0,0,0,,Дұрыс, күткендей, Дирк Шнайдер.
Dialogue: 0,0:10:25.33,0:10:26.87,Default,,0,0,0,,Ханзада Мерси
Dialogue: 0,0:10:26.96,0:10:28.37,Default,,0,0,0,,Хехехе
Dialogue: 0,0:10:29.33,0:10:33.09,Default,,0,0,0,,Бұл қамал бір кездері эльфтердің иелігі болған.
Dialogue: 0,0:10:33.17,0:10:35.92,Default,,0,0,0,,Оны ата-бабаларымыз тартып алған.
Dialogue: 0,0:10:36.42,0:10:38.05,Default,,0,0,0,,Кех, осындай нәрсе
Dialogue: 0,0:10:38.13,0:10:40.01,Default,,0,0,0,,Әлі қалды ма?
Dialogue: 0,0:10:40.09,0:10:42.30,Default,,0,0,0,,Бұл сиқырлы механизм бе?
Dialogue: 0,0:10:43.01,0:10:45.31,Default,,0,0,0,,Бұл не үшін пайдаланылады?
Dialogue: 0,0:10:45.39,0:10:48.06,Default,,0,0,0,,А... қараңдар, оның ішіне әріп қашап жазылған.
Dialogue: 0,0:10:48.64,0:10:53.65,Default,,0,0,0,,Хмм... «Биік жер, жұлдызды жол»
Dialogue: 0,0:10:54.23,0:10:55.69,Default,,0,0,0,,Сіз Йоконы оқи аласыз ба?
Dialogue: 0,0:10:55.78,0:10:57.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:58.36,0:11:02.12,Default,,0,0,0,,Бұл қасиетті жазуға жақын, бірақ мүлде басқаша сияқты.
Dialogue: 0,0:11:03.33,0:11:05.95,Default,,0,0,0,,Мүмкін бұл элвишше?
Dialogue: 0,0:11:06.45,0:11:08.04,Default,,0,0,0,,Грамматика да өзгертілді.
Dialogue: 0,0:11:09.29,0:11:10.62,Default,,0,0,0,,Анаграмма болуы мүмкін...
Dialogue: 0,0:11:12.13,0:11:13.46,Default,,0,0,0,,Мен бұған сене алмаймын
Dialogue: 0,0:11:13.96,0:11:16.96,Default,,0,0,0,,Мен мұндай күрделі заңды мөрді ешқашан көрген емеспін.
Dialogue: 0,0:11:17.05,0:11:18.80,Default,,0,0,0,,Да… жоқ.
Dialogue: 0,0:11:18.88,0:11:22.43,Default,,0,0,0,,Ол элвиш тілінен де көне тілде жазылған.
Dialogue: 0,0:11:23.51,0:11:25.35,Default,,0,0,0,,Ақылды немесе діни қызметкер болуы керек
Dialogue: 0,0:11:25.43,0:11:28.18,Default,,0,0,0,,Шындығында емес, бірақ мен мұны шеше алмаймын.
Dialogue: 0,0:11:28.27,0:11:29.85,Default,,0,0,0,,Өте тітіркендіргіш
Dialogue: 0,0:11:29.93,0:11:31.14,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:11:32.19,0:11:33.90,Default,,0,0,0,,«Саяхат есігі»
Dialogue: 0,0:11:33.98,0:11:37.40,Default,,0,0,0,,«Биік жерлерде жұлдыздар жолына бағыттаушы тірек орнат»
Dialogue: 0,0:11:38.65,0:11:42.36,Default,,0,0,0,,«Жарық бол және алысқа жет»
Dialogue: 0,0:11:43.07,0:11:46.62,Default,,0,0,0,,«Осы жерден алысқа баратындарды апарады».
Dialogue: 0,0:11:47.95,0:11:51.54,Default,,0,0,0,,Бұл құдайлардың жойылған тілі, Энохия жазуы.
Dialogue: 0,0:11:52.17,0:11:54.38,Default,,0,0,0,,Заң мөрлерін жоғары эльфтер пайдаланады.
Dialogue: 0,0:11:55.09,0:11:56.92,Default,,0,0,0,,Бұл құрылғыға арналған нұсқаулық.
Dialogue: 0,0:11:57.00,0:11:58.84,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:59.42,0:12:00.80,Default,,0,0,0,,Мұздатқышта мәйіттер болмаса екен… Ол енді ешқашан осы жерге жақындамайды
Dialogue: 0,0:12:00.88,0:12:02.38,Default,,0,0,0,,Сіз оны оқи аласыз ба?
Dialogue: 0,0:12:03.84,0:12:06.39,Default,,0,0,0,,Әдемі болу мүмкін емес нәрсе жоқ
Dialogue: 0,0:12:06.47,0:12:10.10,Default,,0,0,0,,Лушқа? иә? Шынайы ма?
Dialogue: 0,0:12:10.18,0:12:15.40,Default,,0,0,0,,Йоко-сан, мені кездейсоқ ақымақ деп ойламайсың ба?
Dialogue: 0,0:12:15.48,0:12:16.52,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:12:16.61,0:12:18.02,Default,,0,0,0,,Жетеді
Dialogue: 0,0:12:18.11,0:12:18.90,Default,,0,0,0,,Бұл болар ма…
Dialogue: 0,0:12:20.36,0:12:22.36,Default,,0,0,0,,Тыңда, ақымақ!
Dialogue: 0,0:12:22.45,0:12:26.41,Default,,0,0,0,,Бұл эльвеннің арша магиялары.
Dialogue: 0,0:12:26.49,0:12:29.91,Default,,0,0,0,,Белгілі бір дәуірде көп мөлшерде өндірілген деп айтылатын заттардың ішінде
Dialogue: 0,0:12:29.99,0:12:32.50,Default,,0,0,0,,Бар санаулылардың бірі
Dialogue: 0,0:12:33.08,0:12:36.21,Default,,0,0,0,,Уақыт пен кеңістіктен секіріп өтетін қақпаны ашу
Dialogue: 0,0:12:36.29,0:12:39.46,Default,,0,0,0,,Қажетті сиқырлы күш сақталуы керек.
Dialogue: 0,0:12:39.55,0:12:42.42,Default,,0,0,0,,Бір сәтте ондаған мың шақырым қашықтықта
Dialogue: 0,0:12:42.51,0:12:45.93,Default,,0,0,0,,Балалар, боқыңды көтересіңдер.
Dialogue: 0,0:12:46.01,0:12:47.60,Default,,0,0,0,,Міне, ескі күндер
Dialogue: 0,0:12:47.68,0:12:51.14,Default,,0,0,0,,Егер бұл перілер сарайы болса, онда баратын жер, бәлкім...
Dialogue: 0,0:12:51.98,0:12:55.10,Default,,0,0,0,,Капитал патшасы Crimson Glory
Dialogue: 0,0:12:55.19,0:12:56.60,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:56.69,0:12:58.06,Default,,0,0,0,,О!
Dialogue: 0,0:12:58.15,0:13:00.36,Default,,0,0,0,,Иә! (Самурай) Міне!
Dialogue: 0,0:13:00.44,0:13:03.86,Default,,0,0,0,,Енді сіз демон генералдан алда тұра аласыз!
Dialogue: 0,0:13:03.95,0:13:05.95,Default,,0,0,0,,Ах... (Йоко) Ах... хехе
Dialogue: 0,0:13:06.91,0:13:08.66,Default,,0,0,0,,Шокерлік
Dialogue: 0,0:13:08.74,0:13:11.37,Default,,0,0,0,,Акякья! Солай ма?
Dialogue: 0,0:13:11.45,0:13:14.21,Default,,0,0,0,,Жақсы жұмыс, Дирк Шнайдер.
Dialogue: 0,0:13:14.29,0:13:17.96,Default,,0,0,0,,Мен әсіресе патша әулетінің мүшесі ретінде маған қарсы қол көтергендерді кешіремін.
Dialogue: 0,0:13:18.04,0:13:20.63,Default,,0,0,0,,Бұдан былай маған адал бол.
Dialogue: 0,0:13:24.13,0:13:27.34,Default,,0,0,0,,Енді мен саған бұйрық беремін.
Dialogue: 0,0:13:27.43,0:13:30.76,Default,,0,0,0,,Жарайды, дәл қазір осы құрылғыны қолданайық.
Dialogue: 0,0:13:30.85,0:13:34.27,Default,,0,0,0,,Шилаға жіберіңіз!
Dialogue: 0,0:13:34.35,0:13:36.19,Default,,0,0,0,,Жоқ (Мерси ханзада) Хахаха...
Dialogue: 0,0:13:38.90,0:13:42.82,Default,,0,0,0,,Жаңа ғана не айттыңыз?
Dialogue: 0,0:13:42.90,0:13:45.15,Default,,0,0,0,,Мен оны ұнатпаймын дедім.
Dialogue: 0,0:13:45.24,0:13:45.99,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:46.07,0:13:48.11,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:48.20,0:13:50.41,Default,,0,0,0,,Бұл... бұл...
Dialogue: 0,0:13:50.49,0:13:52.33,Default,,0,0,0,,Сіз!
Dialogue: 0,0:13:52.41,0:13:54.12,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:54.20,0:13:55.12,Default,,0,0,0,,Хун
Dialogue: 0,0:13:55.21,0:13:59.63,Default,,0,0,0,,Хо... хо, бұл мені таң қалдырды.
Dialogue: 0,0:14:00.25,0:14:03.88,Default,,0,0,0,,Әлде мен қате естіген шығармын?
Dialogue: 0,0:14:04.42,0:14:07.01,Default,,0,0,0,,Сонда, біздің кейіпкеріміз,
Dialogue: 0,0:14:07.09,0:14:09.09,Default,,0,0,0,,Тіпті жойылатын Құдай қайта тірілсе де
Dialogue: 0,0:14:09.18,0:14:14.14,Default,,0,0,0,,Дүниенің тағдыры не болғаны маңызды емес дейсіз бе? а?
Dialogue: 0,0:14:14.22,0:14:17.48,Default,,0,0,0,,Жазықсыз адамдар тозаққа түссе де
Dialogue: 0,0:14:17.56,0:14:20.90,Default,,0,0,0,,Әдемі Шейла ханшайымға не болғаны маңызды ма?
Dialogue: 0,0:14:20.98,0:14:24.28,Default,,0,0,0,,Сіз бұл құрылғыны басқара алатын жалғыз адамсыз.
Dialogue: 0,0:14:24.36,0:14:25.44,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:14:25.53,0:14:27.86,Default,,0,0,0,,Сіз, сізде бар күш
Dialogue: 0,0:14:27.95,0:14:32.16,Default,,0,0,0,,Дүниенің адамдарына және ісіне көмектескіңіз келмейді ме?
Dialogue: 0,0:14:32.24,0:14:33.41,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:33.49,0:14:34.79,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:14:35.37,0:14:36.87,Default,,0,0,0,,Гела Гела Гела
Dialogue: 0,0:14:36.96,0:14:40.63,Default,,0,0,0,,Күлкілі екеніне сенімдімін, бірақ мына пальто киген жігіт!
Dialogue: 0,0:14:40.71,0:14:44.05,Default,,0,0,0,,Ақымақтардың басы не болса да, менің білгенім осы ма?
Dialogue: 0,0:14:44.13,0:14:46.01,Default,,0,0,0,,Әлсіздер өледі!
Dialogue: 0,0:14:46.09,0:14:47.13,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:47.22,0:14:49.63,Default,,0,0,0,,Сәлем! ең жаман адам
Dialogue: 0,0:14:50.30,0:14:51.51,Default,,0,0,0,,Люс...
Dialogue: 0,0:14:51.59,0:14:53.60,Default,,0,0,0,,Кухахаха
Dialogue: 0,0:14:53.68,0:14:57.56,Default,,0,0,0,,Каль немесе Жою Құдайы не істейтіні маңызды емес.
Dialogue: 0,0:14:58.23,0:14:59.56,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:14:59.64,0:15:03.52,Default,,0,0,0,,Бұл Қараңғы Шнайдер әлемді жаулап алу үшін үлкен соғысты бастайды.
Dialogue: 0,0:15:03.61,0:15:06.15,Default,,0,0,0,,Сіздің жауыңызға айналғандардың барлығын өлтіріңіз!
Dialogue: 0,0:15:06.94,0:15:08.24,Default,,0,0,0,,Ал мен...
Dialogue: 0,0:15:08.32,0:15:11.66,Default,,0,0,0,,Сиқыршы король Лорд Дарк Шнайдер ретінде
Dialogue: 0,0:15:11.74,0:15:16.54,Default,,0,0,0,,Мен бұл әлемді мәңгі билеймін!
Dialogue: 0,0:15:16.62,0:15:18.79,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:15:18.87,0:15:20.83,Default,,0,0,0,,Ал... тағы да
Dialogue: 0,0:15:20.92,0:15:22.25,Default,,0,0,0,,Бұл басталды ма?
Dialogue: 0,0:15:22.83,0:15:23.96,Default,,0,0,0,,Әйелдердің менімен әзілдескеніне шыдамаймын, білесің бе
Dialogue: 0,0:15:24.46,0:15:26.55,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:15:26.63,0:15:29.72,Default,,0,0,0,,Алғысымды айтсам да... Сол ой мені аңдып жібереді.
Dialogue: 0,0:15:29.80,0:15:31.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.72,0:15:33.14,Default,,0,0,0,,Күте тұрыңыз! (Йоко) Иә?
Dialogue: 0,0:15:35.43,0:15:37.18,Default,,0,0,0,,Әй... апай?
Dialogue: 0,0:15:37.27,0:15:39.89,Default,,0,0,0,,Олар шынымен де ақымақ балалар.
Dialogue: 0,0:15:39.98,0:15:41.52,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:15:41.60,0:15:42.60,Default,,0,0,0,,Апай
Dialogue: 0,0:15:42.69,0:15:44.61,Default,,0,0,0,,Ка...Анашым
Dialogue: 0,0:15:45.19,0:15:47.69,Default,,0,0,0,,Баланың айтқанының бәрін байыппен қабылдаңыз.
Dialogue: 0,0:15:47.78,0:15:49.69,Default,,0,0,0,,Өлтіруші болма
Dialogue: 0,0:15:49.78,0:15:51.86,Default,,0,0,0,,Сонда... бұл бала?
Dialogue: 0,0:15:53.36,0:15:57.20,Default,,0,0,0,,Мына бала біраз шірік екен.
Dialogue: 0,0:15:57.29,0:16:00.04,Default,,0,0,0,,Мен мұны жалғыз айта аламын.
Dialogue: 0,0:16:00.62,0:16:02.87,Default,,0,0,0,,Менің жүрегім жай ғана бұзылды.
Dialogue: 0,0:16:02.96,0:16:05.59,Default,,0,0,0,,Сіз соншалықты көп білмейсіз бе?
Dialogue: 0,0:16:07.88,0:16:10.09,Default,,0,0,0,,Бұл кейінгі емес...
Dialogue: 0,0:16:10.17,0:16:11.80,Default,,0,0,0,,Мынадай...
Dialogue: 0,0:16:11.88,0:16:15.35,Default,,0,0,0,,Бірақ ол жақсы бала.
Dialogue: 0,0:16:16.43,0:16:17.72,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:16:17.81,0:16:20.43,Default,,0,0,0,,Сен мені жауларымнан қорғадың.
Dialogue: 0,0:16:21.27,0:16:23.94,Default,,0,0,0,,Дұрыс. Рубо: Иә?
Dialogue: 0,0:16:24.02,0:16:28.15,Default,,0,0,0,,Ах... Ку... Ммм... Тексер...
Dialogue: 0,0:16:28.73,0:16:30.94,Default,,0,0,0,,Түсіндім! Қарғыс атсын
Dialogue: 0,0:16:31.44,0:16:33.11,Default,,0,0,0,,(Самурайдың рельеф дыбыстары)
Dialogue: 0,0:16:34.11,0:16:35.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:36.78,0:16:37.91,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:38.53,0:16:42.08,Default,,0,0,0,,Апай, мен жуынып біттім~
Dialogue: 0,0:16:43.62,0:16:45.96,Default,,0,0,0,,Түсіндім, бұл керемет, Любо.
Dialogue: 0,0:16:46.04,0:16:47.46,Default,,0,0,0,,Хэхехе~
Dialogue: 0,0:16:52.84,0:16:55.64,Default,,0,0,0,,Da thermospagea
Dialogue: 0,0:16:52.84,0:16:55.64,Default,,0,0,0,,Бірінші рет...
Dialogue: 0,0:16:55.72,0:16:57.76,Default,,0,0,0,,Эвовоас Питиндахама
Dialogue: 0,0:16:57.76,0:16:59.18,Default,,0,0,0,,Эвовоас Питиндахама
Dialogue: 0,0:16:57.76,0:16:59.18,Default,,0,0,0,,Екі адам...
Dialogue: 0,0:16:59.81,0:17:01.39,Default,,0,0,0,,қабаттасатын көрінеді
Dialogue: 0,0:17:03.69,0:17:04.81,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:13.49,0:17:15.32,Default,,0,0,0,,Унданбиуру!
Dialogue: 0,0:17:16.41,0:17:19.62,Default,,0,0,0,,Бұл перілер магия ғылымының күші.
Dialogue: 0,0:17:20.28,0:17:23.41,Default,,0,0,0,,Мен мұндай нәрсенің жүздеген жылдар бұрын салынғанына сене алмаймын.
Dialogue: 0,0:17:23.50,0:17:25.00,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:17:26.50,0:17:27.54,Default,,0,0,0,,Мен оны… есептей алмаймын.
Dialogue: 0,0:17:28.46,0:17:29.46,Default,,0,0,0,,Иә
Dialogue: 0,0:17:30.42,0:17:33.51,Default,,0,0,0,,Самурайлар, заң сақшылары
Dialogue: 0,0:17:34.09,0:17:38.80,Default,,0,0,0,,Әлемдегі жоғалған тәртіпті қалпына келтірудің соңғы мүмкіндігі келді.
Dialogue: 0,0:17:39.80,0:17:44.68,Default,,0,0,0,,Сізге, таңдалғандарға жүктелген миссияның маңыздылығын есте сақтаңыз.
Dialogue: 0,0:17:45.56,0:17:49.31,Default,,0,0,0,,Ол жойылу құдайы Антрасакстың мөрінің иесі.
Dialogue: 0,0:17:49.40,0:17:51.94,Default,,0,0,0,,Шейла ханшайымның денесі жау қолына түссе
Dialogue: 0,0:17:52.02,0:17:54.24,Default,,0,0,0,,Адамзат жойылады!
Dialogue: 0,0:17:55.28,0:17:59.87,Default,,0,0,0,,Бұл шайқас қатты және қатал болады!
Dialogue: 0,0:17:59.95,0:18:02.74,Default,,0,0,0,,Бірақ сіздің иығыңызда
Dialogue: 0,0:18:02.83,0:18:05.62,Default,,0,0,0,,Тағдырың өз қолыңда екенін ұмытпа
Dialogue: 0,0:18:05.71,0:18:08.21,Default,,0,0,0,,Калдың амбициясын жойыңыз!
Dialogue: 0,0:18:08.29,0:18:09.88,Default,,0,0,0,,О
Dialogue: 0,0:18:09.96,0:18:12.09,Default,,0,0,0,,Иә? Хмм?
Dialogue: 0,0:18:12.75,0:18:15.09,Default,,0,0,0,,Ларс жоқ. Ол қайда?
Dialogue: 0,0:18:15.17,0:18:16.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:16.92,0:18:17.93,Default,,0,0,0,,Иә
Dialogue: 0,0:18:18.51,0:18:20.26,Default,,0,0,0,,Сау бол, Ешуа.
Dialogue: 0,0:18:20.97,0:18:24.64,Default,,0,0,0,,Ертең көтерілген көтерілісшілерге қосылдық.
Dialogue: 0,0:18:24.72,0:18:27.23,Default,,0,0,0,,жетіспейтін Иуда сарайына шабуыл.
Dialogue: 0,0:18:27.73,0:18:28.56,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:29.27,0:18:30.86,Default,,0,0,0,,Міне, Гамметт
Dialogue: 0,0:18:31.86,0:18:34.48,Default,,0,0,0,,Бірақ Яһудада Кал-Су бар.
Dialogue: 0,0:18:35.23,0:18:36.24,Default,,0,0,0,,Өлме
Dialogue: 0,0:18:36.82,0:18:40.66,Default,,0,0,0,,Хм... Негізі бұл әлі құпия.
Dialogue: 0,0:18:40.74,0:18:43.58,Default,,0,0,0,,Бұл операция үшін Мета-Ликана бас діни қызметкері
Dialogue: 0,0:18:44.16,0:18:46.50,Default,,0,0,0,,Geo Note Sort мырза бізге қосылатын сияқты.
Dialogue: 0,0:18:49.29,0:18:53.21,Default,,0,0,0,,Ұлы соғыстың батырлары Гео-сама мен Мифуне-сама осында болса,
Dialogue: 0,0:18:53.71,0:18:55.80,Default,,0,0,0,,Калдың қорқыныштылығы жеткіліксіз
Dialogue: 0,0:18:55.88,0:18:59.59,Default,,0,0,0,,Ой... Йоконың әкесі әлі тірі ме?
Dialogue: 0,0:18:59.68,0:19:00.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:00.93,0:19:04.35,Default,,0,0,0,,Ол Еуропаның он данышпанымен бірге тұрады дейді.
Dialogue: 0,0:19:05.06,0:19:06.89,Default,,0,0,0,,Еуропаның он данагөйі...
Dialogue: 0,0:19:08.77,0:19:10.98,Default,,0,0,0,,Оны Йокодан құпия сақтаңыз.
Dialogue: 0,0:19:11.52,0:19:13.94,Default,,0,0,0,,Өмірі мен өлімі белгісіз әкем туралы білгенде.
Dialogue: 0,0:19:14.02,0:19:16.03,Default,,0,0,0,,Сізді ренжітетініне сенімдімін.
Dialogue: 0,0:19:16.11,0:19:17.53,Default,,0,0,0,,Мен алаңдағым келмейді
Dialogue: 0,0:19:18.57,0:19:22.70,Default,,0,0,0,,Ол еркекті басқара алатын жалғыз адам.
Dialogue: 0,0:19:23.57,0:19:25.41,Default,,0,0,0,,Агия...
Dialogue: 0,0:19:25.49,0:19:28.50,Default,,0,0,0,,Калды жең, мен сені Яһуда сарайында күтемін.
Dialogue: 0,0:19:28.58,0:19:29.50,Default,,0,0,0,,фирма
Dialogue: 0,0:19:30.33,0:19:35.46,Default,,0,0,0,,Жаудың штабы Яһуда және Жын патшасы Қырмызы Даңқ
Dialogue: 0,0:19:35.55,0:19:38.09,Default,,0,0,0,,Бұл шайқас шығар
Dialogue: 0,0:19:38.59,0:19:40.93,Default,,0,0,0,,Біз бұрын ешқашан бастан кешірмеген нәрсе
Dialogue: 0,0:19:41.01,0:19:42.93,Default,,0,0,0,,Бұл керемет болады
Dialogue: 0,0:19:43.68,0:19:46.89,Default,,0,0,0,,Олардың қаншасы аман қалады?
Dialogue: 0,0:19:48.47,0:19:50.56,Default,,0,0,0,,Адамзат жойылып кете ме?
Dialogue: 0,0:19:50.64,0:19:53.77,Default,,0,0,0,,Ескі дүниенің артына қалдырған түні жойыла ма?
Dialogue: 0,0:19:54.98,0:19:59.11,Default,,0,0,0,,Бұл шынымен де тозақтың соңғы және соңғы шайқасы.
Dialogue: 0,0:20:01.03,0:20:02.24,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:20:03.16,0:20:04.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:05.53,0:20:06.78,Default,,0,0,0,,Біз бәріміз...
Dialogue: 0,0:20:07.91,0:20:10.54,Default,,0,0,0,,Өмір сүру мен өлу бірдей.
Dialogue: 0,0:20:11.29,0:20:13.50,Default,,0,0,0,,Сіз шынымен үнсізсіз!
Dialogue: 0,0:20:14.25,0:20:15.25,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:16.59,0:20:18.84,Default,,0,0,0,,Тоқта, ақымақ!
Dialogue: 0,0:20:18.92,0:20:22.76,Default,,0,0,0,,Аяғы сасыған қорқақпен кім өледі?
Dialogue: 0,0:20:22.84,0:20:24.64,Default,,0,0,0,,Кола! (Дирк Шнайдер) Ой!
Dialogue: 0,0:20:24.72,0:20:27.93,Default,,0,0,0,,Сіз өзіңізді нашар ұстайсыз. Сізге көбірек мотивация болуы керек.
Dialogue: 0,0:20:28.01,0:20:29.27,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:20:29.35,0:20:30.68,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:31.27,0:20:34.90,Default,,0,0,0,,Сіз менімен сөйлескіңіз келе ме? Мен саған бұдан былай жеңіл тамақ бермеймін!
Dialogue: 0,0:20:34.98,0:20:39.07,Default,,0,0,0,,Сонымен... сіз соншалықты ашулысыз ба? Ашулы қате~
Dialogue: 0,0:20:39.15,0:20:40.15,Default,,0,0,0,,«Иә»?
Dialogue: 0,0:20:40.23,0:20:41.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:42.20,0:20:43.20,Default,,0,0,0,,Біраз қорқынышты, иә?
Dialogue: 0,0:20:44.45,0:20:45.36,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:47.37,0:20:48.37,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:48.87,0:20:49.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:50.54,0:20:53.87,Default,,0,0,0,,Мен жеңілдеп қалдым... Йоко қалыпты жағдайға оралды.
Dialogue: 0,0:20:53.96,0:20:55.08,Default,,0,0,0,,Бірақ егер сол адам—
Dialogue: 0,0:20:55.17,0:20:56.92,Default,,0,0,0,,А, не?
Dialogue: 0,0:20:57.00,0:20:58.79,Default,,0,0,0,,Тексеріңіз, бұл күлкілі.
Dialogue: 0,0:20:58.88,0:20:59.84,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:59.92,0:21:03.05,Default,,0,0,0,,Уау, мен әлі де уайымдап жүрмін.
Dialogue: 0,0:21:03.13,0:21:05.68,Default,,0,0,0,,Мен баруды жоспарлаған жоқпын, бірақ
Dialogue: 0,0:21:05.76,0:21:09.06,Default,,0,0,0,,Мен Шейлаға осындай нәрселерді сеніп тапсырамын деп уайымдамаймын.
Dialogue: 0,0:21:09.14,0:21:10.22,Default,,0,0,0,,Агия Агия
Dialogue: 0,0:21:10.31,0:21:12.77,Default,,0,0,0,,Иә? О, бұл Ларс!
Dialogue: 0,0:21:12.85,0:21:13.77,Default,,0,0,0,,Агия
Dialogue: 0,0:21:13.85,0:21:16.31,Default,,0,0,0,,Мына бейбақ қайда кетті!
Dialogue: 0,0:21:16.40,0:21:17.52,Default,,0,0,0,,Люс!
Dialogue: 0,0:21:22.53,0:21:23.90,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:23.99,0:21:27.45,Default,,0,0,0,,Олай болса кеттік! Мен команда қабылдаймын
Dialogue: 0,0:21:27.53,0:21:29.66,Default,,0,0,0,,А-Иан-Мейде князі Мерси.
Dialogue: 0,0:21:29.74,0:21:32.87,Default,,0,0,0,,Батыр ретінде кеңінен танымал...
Dialogue: 0,0:21:32.95,0:21:35.58,Default,,0,0,0,,Букья (көмекші) ханзада! ханзада!
Dialogue: 0,0:21:35.67,0:21:37.71,Default,,0,0,0,,Көмек! Мен жүзе алмаймын
Dialogue: 0,0:21:37.79,0:21:39.63,Default,,0,0,0,,Сенің аяғың ханзадаға тиеді
Dialogue: 0,0:21:39.71,0:21:41.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:41.71,0:21:43.34,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:21:43.92,0:21:47.34,Default,,0,0,0,,Құрметті Шейла, мен сізге көмектесуге келдім.
Dialogue: 0,0:21:47.43,0:21:48.84,Default,,0,0,0,,Бізді күтіңіздер.
Dialogue: 0,0:21:50.55,0:21:52.97,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:21:53.56,0:21:55.06,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:56.56,0:21:57.56,Default,,0,0,0,,Тақырып...
Dialogue: 0,0:21:58.06,0:22:01.19,Default,,0,0,0,,Король Кримсон Даңқы
Dialogue: 0,0:22:06.24,0:22:07.78,Default,,0,0,0,,Ол кетті.
Dialogue: 0,0:22:08.57,0:22:10.99,Default,,0,0,0,,Гаммет Соғысқа дайындалу
Dialogue: 0,0:22:11.08,0:22:11.99,Default,,0,0,0,,Га
Dialogue: 0,0:22:13.04,0:22:15.08,Default,,0,0,0,,Мен саған жалындым, самурай.
Dialogue: 0,0:22:16.12,0:22:16.96,Default,,0,0,0,,Және…
Dialogue: 0,0:22:17.71,0:22:19.54,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:22:21.00,0:22:23.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:48.13,0:23:50.13,Default,,0,0,0,,～♪
