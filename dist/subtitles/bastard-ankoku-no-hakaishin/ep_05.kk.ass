Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:20.47,0:00:22.31,Default,,0,0,0,,Осыдан екі жыл бұрын...
Dialogue: 0,0:00:28.19,0:00:31.07,Default,,0,0,0,,Агия агья! Аги
Dialogue: 0,0:00:32.70,0:00:34.61,Default,,0,0,0,,Бәрі жоғалып кеткенде...
Dialogue: 0,0:01:02.35,0:01:03.52,Default,,0,0,0,,Агия!
Dialogue: 0,0:01:03.60,0:01:06.23,Default,,0,0,0,,Не... Не? Не!
Dialogue: 0,0:01:10.52,0:01:13.44,Default,,0,0,0,,Бізді телепортация сиқырымен құтқарған адам болды
Dialogue: 0,0:01:20.16,0:01:21.79,Default,,0,0,0,,Бұл сіз болуыңыз керек.
Dialogue: 0,0:01:23.79,0:01:25.29,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:01:27.83,0:01:29.96,Default,,0,0,0,,Шиеленіс атмосферасы енді жеңілдеді.
Dialogue: 0,0:01:31.04,0:01:34.05,Default,,0,0,0,,Қыс аяқталды.
Dialogue: 0,0:01:37.84,0:01:39.85,Default,,0,0,0,,♪～
Dialogue: 0,0:03:03.01,0:03:05.01,Default,,0,0,0,,～♪
Dialogue: 0,0:03:06.56,0:03:07.47,Default,,0,0,0,,Иә
Dialogue: 0,0:03:07.56,0:03:09.77,Default,,0,0,0,,Жаз болса да, мен суып барамын
Dialogue: 0,0:03:10.52,0:03:13.36,Default,,0,0,0,,Айтпақшы, естідің бе?
Dialogue: 0,0:03:13.44,0:03:16.69,Default,,0,0,0,,Күзет бөлмесінде осылай болып жатыр.
Dialogue: 0,0:03:16.78,0:03:19.70,Default,,0,0,0,,Лорд Кэл осы жер асты ғибадатханасында жатыр.
Dialogue: 0,0:03:20.20,0:03:22.61,Default,,0,0,0,,Бұл дүниеден шыққан қорқынышты дауыс
Dialogue: 0,0:03:22.70,0:03:24.07,Default,,0,0,0,,Есіктің арғы жағынан...
Dialogue: 0,0:03:24.16,0:03:26.70,Default,,0,0,0,,Бррррр... Ақымақ болма!
Dialogue: 0,0:03:26.79,0:03:30.37,Default,,0,0,0,,Соңғы мөрге байланысты жойылу Құдайы әлі ұйықтап жатыр.
Dialogue: 0,0:03:30.46,0:03:32.00,Default,,0,0,0,,Біз не туралы сөйлесуіміз керек?
Dialogue: 0,0:03:32.08,0:03:36.09,Default,,0,0,0,,Бұл туралы жын генерал білсе, үлкен іс болар еді.
Dialogue: 0,0:03:47.97,0:03:52.64,Default,,0,0,0,,Аяулы анашым, Шыдамдылығыңызға рахмет.
Dialogue: 0,0:03:53.48,0:03:56.69,Default,,0,0,0,,Мен сені міндетті түрде босатамын.
Dialogue: 0,0:03:58.19,0:04:02.20,Default,,0,0,0,,Әй... менің тәтті Кәлім
Dialogue: 0,0:04:03.45,0:04:04.78,Default,,0,0,0,,Осы жолы…
Dialogue: 0,0:04:07.28,0:04:14.17,Default,,0,0,0,,(Арфа үні)
Dialogue: 0,0:04:24.93,0:04:25.93,Default,,0,0,0,,Мен сен үшін сол мысықты көміп қояйын, аздап ақша берші, иә?
Dialogue: 0,0:04:27.51,0:04:28.85,Default,,0,0,0,,Мен дыбыс естимін
Dialogue: 0,0:04:31.18,0:04:32.52,Default,,0,0,0,,Толқын сияқты
Dialogue: 0,0:04:37.15,0:04:38.98,Default,,0,0,0,,Ол Калма?
Dialogue: 0,0:04:40.53,0:04:41.36,Default,,0,0,0,,Кал
Dialogue: 0,0:04:41.44,0:04:42.78,Default,,0,0,0,,Сиқырлы бала
Dialogue: 0,0:04:42.86,0:04:44.95,Default,,0,0,0,,Кальмен ойнамаңыз
Dialogue: 0,0:04:45.03,0:04:47.16,Default,,0,0,0,,Жақын келсең қауіпті.
Dialogue: 0,0:04:47.24,0:04:48.62,Default,,0,0,0,,Бұл Каль, мен қорқып тұрмын.
Dialogue: 0,0:04:49.24,0:04:51.54,Default,,0,0,0,,(Калдың анасының жылауы)
Dialogue: 0,0:04:52.12,0:04:55.12,Default,,0,0,0,,Анашым, неге жылайсыз?
Dialogue: 0,0:04:55.83,0:04:57.25,Default,,0,0,0,,№.
Dialogue: 0,0:04:58.09,0:05:00.92,Default,,0,0,0,,Мені кешіріңіз, менің Калем.
Dialogue: 0,0:05:01.55,0:05:04.97,Default,,0,0,0,,Анашым, мен нені кешіруім керек?
Dialogue: 0,0:05:06.30,0:05:08.72,Default,,0,0,0,,Сіз мені сүйе алмайсыз ба?
Dialogue: 0,0:05:10.01,0:05:11.22,Default,,0,0,0,,Бұл арман
Dialogue: 0,0:05:12.39,0:05:15.06,Default,,0,0,0,,Көз жасы әлдеқашан кеуіп қалған болуы керек.
Dialogue: 0,0:05:20.07,0:05:21.40,Default,,0,0,0,,Адамдар қаласы
Dialogue: 0,0:05:22.40,0:05:23.74,Default,,0,0,0,,Яһуда қаласы
Dialogue: 0,0:05:24.53,0:05:28.87,Default,,0,0,0,,Материктің орталығы Металлиондағы ең қуатты және ең бай қала.
Dialogue: 0,0:05:29.37,0:05:33.29,Default,,0,0,0,,Соңғы екі жылда ол шалғайлар сияқты өзгерді.
Dialogue: 0,0:05:34.00,0:05:34.75,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:05:34.83,0:05:40.25,Default,,0,0,0,,Қамалдың жерасты ғибадатханасында қайта жаңғырып жатқан жойқын Құдайдың құдіреті ме?
Dialogue: 0,0:05:40.79,0:05:41.71,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:05:44.67,0:05:47.38,Default,,0,0,0,,Зығыр сияқты бейберекет адам әлемінде
Dialogue: 0,0:05:47.47,0:05:51.39,Default,,0,0,0,,Жарық әкелетін Құтқарушыны іздеңіз және оны атап өтіңіз
Dialogue: 0,0:05:52.39,0:05:57.06,Default,,0,0,0,,Мәсіх – Бес Батырдың бірі: Ра’с-ул-Мета-Ликана.
Dialogue: 0,0:05:57.85,0:06:01.57,Default,,0,0,0,,Алайда Голем соғысы кезінде Ларс хабарсыз кетті.
Dialogue: 0,0:06:02.19,0:06:04.82,Default,,0,0,0,,Жаңа Мәсіх дүниеге келеді
Dialogue: 0,0:06:05.94,0:06:09.78,Default,,0,0,0,,Мен Мәсіхтің Лорд Кал екеніне сендім.
Dialogue: 0,0:06:10.82,0:06:11.74,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:06:12.83,0:06:14.45,Default,,0,0,0,,Мен қорқамын
Dialogue: 0,0:06:15.54,0:06:18.04,Default,,0,0,0,,Барлығымыз он екі жын соғысының генералы
Dialogue: 0,0:06:18.12,0:06:21.13,Default,,0,0,0,,Мен ол үшін кез келген уақытта өлуге дайын едім.
Dialogue: 0,0:06:22.00,0:06:26.01,Default,,0,0,0,,Бірақ Каль-сама күнде басқа адам сияқты өзгереді.
Dialogue: 0,0:06:27.05,0:06:30.26,Default,,0,0,0,,Мен Каль емес адам үшін өлгім келмейді.
Dialogue: 0,0:06:31.34,0:06:35.10,Default,,0,0,0,,Лорд Кал, бізді тыныштандырыңыз.
Dialogue: 0,0:06:36.35,0:06:40.90,Default,,0,0,0,,Біз бүкіл тағдырымызды саған сеніп тапсырдық.
Dialogue: 0,0:06:42.02,0:06:45.44,Default,,0,0,0,,Маған ертеңгі утопияға жол көрсетіңізші
Dialogue: 0,0:06:50.07,0:06:51.24,Default,,0,0,0,,(Жарқанат ызылдайды)
Dialogue: 0,0:06:51.32,0:06:52.87,Default,,0,0,0,,Иә? (Байқау) О
Dialogue: 0,0:06:54.66,0:06:58.29,Default,,0,0,0,,Не? Бұл күдікті жарғанат
Dialogue: 0,0:06:58.37,0:06:59.87,Default,,0,0,0,,Және... Үлкен!
Dialogue: 0,0:06:59.96,0:07:02.21,Default,,0,0,0,,Мен мұндай күдікті ештеңе көрген емеспін.
Dialogue: 0,0:07:02.29,0:07:03.79,Default,,0,0,0,,Гух (күзетші) Гухе
Dialogue: 0,0:07:06.13,0:07:08.76,Default,,0,0,0,,Мияу мияу галуруруру
Dialogue: 0,0:07:09.67,0:07:11.30,Default,,0,0,0,,қатысуды сезіну
Dialogue: 0,0:07:11.89,0:07:14.64,Default,,0,0,0,,Жау? басып алған
Dialogue: 0,0:07:15.14,0:07:16.14,Default,,0,0,0,,Жалпы білім беру бөлімінің Шинсоу
Dialogue: 0,0:07:16.68,0:07:19.81,Default,,0,0,0,,Бұл қуатты жындық қуат... бұл адам емес.
Dialogue: 0,0:07:20.64,0:07:22.23,Default,,0,0,0,,Жындық қуат күшейді.
Dialogue: 0,0:07:25.02,0:07:25.94,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:07:26.48,0:07:27.65,Default,,0,0,0,,Угаааа!
Dialogue: 0,0:07:27.73,0:07:29.36,Default,,0,0,0,,Қасқыр жолбарыс болды
Dialogue: 0,0:07:29.44,0:07:31.82,Default,,0,0,0,,Балалар сендер қандай адамдарсыңдар?
Dialogue: 0,0:07:31.91,0:07:34.78,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:35.78,0:07:38.87,Default,,0,0,0,,Дирк Шнайдер мырзадан кейінгі ең керемет.
Dialogue: 0,0:07:39.75,0:07:43.33,Default,,0,0,0,,Дирк Шнайдер мырзаның жанындағы ең ақылды адам.
Dialogue: 0,0:07:43.42,0:07:44.92,Default,,0,0,0,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:07:45.00,0:07:48.30,Default,,0,0,0,,Дирк Шнайдер мырзадан кейінгі ең әдемі нәрсе!
Dialogue: 0,0:07:48.38,0:07:50.59,Default,,0,0,0,,Жер бетіндегі ең күшті граф
Dialogue: 0,0:07:50.67,0:07:54.01,Default,,0,0,0,,Лорд Дарк Шнайдердің бірінші қызметшісі
Dialogue: 0,0:07:54.09,0:07:57.47,Default,,0,0,0,,Ба... ақымақ, сен неге мұндасың?
Dialogue: 0,0:07:57.56,0:07:58.97,Default,,0,0,0,,Сүйікті Ұстаз
Dialogue: 0,0:07:59.06,0:08:03.40,Default,,0,0,0,,Мен Дирк Шнайдер мырзаға дұшпандық жасаған кез келген адамды кешіре алмаймын.
Dialogue: 0,0:08:03.48,0:08:07.69,Default,,0,0,0,,Мен, Дай-Амон, сенің қаныңды сорамын!
Dialogue: 0,0:08:09.11,0:08:12.99,Default,,0,0,0,,Дай-Амон Өлмейтін дерлік адам
Dialogue: 0,0:08:13.74,0:08:17.45,Default,,0,0,0,,Оны бір кездері Каль-саманың жындармен соғысқан генералымен салыстыруға болады⸺
Dialogue: 0,0:08:17.53,0:08:19.45,Default,,0,0,0,,Сиқырлы Кидошу тобы
Dialogue: 0,0:08:20.20,0:08:24.21,Default,,0,0,0,,Олардың ішінде ол Найзағай императоры Нейдің жақын көмекшісі ретінде таңдалды⸺
Dialogue: 0,0:08:24.29,0:08:28.30,Default,,0,0,0,,Ең күшті сиқыршы, Кидо триосы
Dialogue: 0,0:08:28.84,0:08:30.96,Default,,0,0,0,,Оның шынайы тұлғасы - вампир!
Dialogue: 0,0:08:32.63,0:08:34.97,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:08:35.05,0:08:37.89,Default,,0,0,0,,Жарқыраңыз! Найзағай күркіреді!
Dialogue: 0,0:08:37.97,0:08:40.97,Default,,0,0,0,,Дауыл соқты! Арашиге қоңырау шал!
Dialogue: 0,0:08:41.06,0:08:45.90,Default,,0,0,0,,Мен қазір сөзсіз әдемімін!
Dialogue: 0,0:08:47.06,0:08:52.03,Default,,0,0,0,,-де? Каль-саманың жатын бөлмесіндегі вампирдің мақсаты қандай?
Dialogue: 0,0:08:52.11,0:08:55.32,Default,,0,0,0,,Дахахаха ақымақ
Dialogue: 0,0:08:55.41,0:08:56.49,Default,,0,0,0,,Вампирдің мақсаты қандай?
Dialogue: 0,0:08:56.57,0:09:00.16,Default,,0,0,0,,Қан сорып бітетініне сенімдімін.
Dialogue: 0,0:09:00.66,0:09:01.62,Default,,0,0,0,,Мен сені жіберейін бе?
Dialogue: 0,0:09:01.70,0:09:05.33,Default,,0,0,0,,Енді, егер жараланғың келмесе, ол жерден кет.
Dialogue: 0,0:09:05.42,0:09:07.58,Default,,0,0,0,,Әдемі жас ханым!
Dialogue: 0,0:09:07.67,0:09:09.88,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:09:09.96,0:09:11.84,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:09:11.92,0:09:12.92,Default,,0,0,0,,Бұл ер адам!
Dialogue: 0,0:09:13.01,0:09:14.59,Default,,0,0,0,,Ой
Dialogue: 0,0:09:15.88,0:09:18.51,Default,,0,0,0,,Қандай дөрекі!
Dialogue: 0,0:09:19.01,0:09:21.01,Default,,0,0,0,,Бірақ бұл біртүрлі...
Dialogue: 0,0:09:21.10,0:09:23.85,Default,,0,0,0,,Енді пәк Нихуи бар екені сөзсіз.
Dialogue: 0,0:09:23.93,0:09:24.68,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:09:25.19,0:09:26.81,Default,,0,0,0,,Әйелдерді жек көретін Кал
Dialogue: 0,0:09:26.90,0:09:30.23,Default,,0,0,0,,Менің көмекшімде жын-генералдардың қатарына әйелді қосуға ешқандай мүмкіндік жоқ.
Dialogue: 0,0:09:30.32,0:09:34.15,Default,,0,0,0,,Мм, қазір ойлап қарасам, солай шығар.
Dialogue: 0,0:09:34.65,0:09:37.32,Default,,0,0,0,,Хаха, онда ұстап тұрудың қажеті жоқ.
Dialogue: 0,0:09:37.41,0:09:38.91,Default,,0,0,0,,Сәлем, балалар
Dialogue: 0,0:09:38.99,0:09:42.91,Default,,0,0,0,,Мына балаға аздап ұрып бер.
Dialogue: 0,0:09:42.99,0:09:45.29,Default,,0,0,0,,Құрметті Эрл!
Dialogue: 0,0:09:45.37,0:09:48.75,Default,,0,0,0,,Менің атым Марон.
Dialogue: 0,0:09:48.83,0:09:51.21,Default,,0,0,0,,Мен Пилонмын.
Dialogue: 0,0:09:51.96,0:09:54.88,Default,,0,0,0,,Менің міндетім - сенің өміріңді қабылдау.
Dialogue: 0,0:09:54.97,0:09:56.93,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:09:57.01,0:09:58.72,Default,,0,0,0,,Міне кеттік
Dialogue: 0,0:09:59.22,0:10:01.35,Default,,0,0,0,,Өл!
Dialogue: 0,0:10:01.43,0:10:02.10,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:10:03.35,0:10:05.48,Default,,0,0,0,,Гяван! Нигьяа!
Dialogue: 0,0:10:06.35,0:10:08.35,Default,,0,0,0,,Міне! Ақымақтар
Dialogue: 0,0:10:08.44,0:10:09.81,Default,,0,0,0,,Жарық жылдамдығының семсері...
Dialogue: 0,0:10:10.31,0:10:13.02,Default,,0,0,0,,Ингви фон Малмстин?
Dialogue: 0,0:10:13.11,0:10:15.86,Default,,0,0,0,,Кешіктің, Ынви, сен не істеп жүрсің?
Dialogue: 0,0:10:16.44,0:10:17.86,Default,,0,0,0,,Амал жоқ, үш адам ғана
Dialogue: 0,0:10:17.95,0:10:20.07,Default,,0,0,0,,Мен Яһуда сарайына жасырын кіремін деп ешқашан ойламадым.
Dialogue: 0,0:10:20.91,0:10:22.28,Default,,0,0,0,,Үлкен жігіттер.
Dialogue: 0,0:10:22.83,0:10:26.08,Default,,0,0,0,,Бірақ бұдан былай ешқандай прогресс болмайды.
Dialogue: 0,0:10:26.16,0:10:29.67,Default,,0,0,0,,Король сарайына Койой және басқа жын генералдары да келеді.
Dialogue: 0,0:10:30.29,0:10:32.09,Default,,0,0,0,,Енді қашып құтыла алмайсың
Dialogue: 0,0:10:32.17,0:10:33.84,Default,,0,0,0,,Сатқын Дай-Амон!
Dialogue: 0,0:10:33.92,0:10:38.80,Default,,0,0,0,,Үлкен жорықтың алдындағы түнді таңдау бақытсыз адам болар еді.
Dialogue: 0,0:10:38.88,0:10:41.76,Default,,0,0,0,,Жарқанаттар сені жыртып тастайды.
Dialogue: 0,0:10:41.85,0:10:42.85,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:43.43,0:10:45.72,Default,,0,0,0,,Ах ха ха...
Dialogue: 0,0:10:45.81,0:10:48.31,Default,,0,0,0,,Қымбаттым... не болды?
Dialogue: 0,0:10:48.39,0:10:50.40,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:10:50.48,0:10:53.65,Default,,0,0,0,,Менің не айтқым келгенін білесің бе?
Dialogue: 0,0:10:53.73,0:10:57.11,Default,,0,0,0,,Хаа, бұл толық ай
Dialogue: 0,0:10:57.19,0:11:02.03,Default,,0,0,0,,Толық ай біздің жын-перілеріміздің қабілеттерін арттырсын.
Dialogue: 0,0:11:02.12,0:11:05.54,Default,,0,0,0,,Білмейсің бе, ақымақ!
Dialogue: 0,0:11:06.08,0:11:07.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:07.25,0:11:11.88,Default,,0,0,0,,Араларыңызда қанша жексұрын адамдар келсе де~аа~
Dialogue: 0,0:11:11.96,0:11:17.13,Default,,0,0,0,,Ол асыл Дарк Шнайдерден кейінгі екінші күшті және ол менің жауым емес.
Dialogue: 0,0:11:17.21,0:11:18.05,Default,,0,0,0,,Құт
Dialogue: 0,0:11:18.13,0:11:19.97,Default,,0,0,0,,Қандай сиқырлы күш
Dialogue: 0,0:11:20.05,0:11:21.09,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,0:11:21.18,0:11:23.05,Default,,0,0,0,,Дахахахаха...
Dialogue: 0,0:11:23.64,0:11:26.89,Default,,0,0,0,,Ха-ха-ха-ха…
Dialogue: 0,0:11:28.02,0:11:29.77,Default,,0,0,0,,Не... Бұл не!
Dialogue: 0,0:11:29.85,0:11:32.44,Default,,0,0,0,,Қабырғалар... еден...
Dialogue: 0,0:11:32.52,0:11:35.36,Default,,0,0,0,,Тірі заттың ішек-қарнындай қыбырлап жүр.
Dialogue: 0,0:11:35.94,0:11:37.44,Default,,0,0,0,,Алдау...
Dialogue: 0,0:11:37.53,0:11:39.57,Default,,0,0,0,,Дай-Амонға не еліктейсің?
Dialogue: 0,0:11:39.65,0:11:42.74,Default,,0,0,0,,Алаяқтық? шектен шыққан
Dialogue: 0,0:11:42.82,0:11:46.41,Default,,0,0,0,,Бұл Яһуда сарайының бүгінгі шынайы күйі.
Dialogue: 0,0:11:46.49,0:11:48.37,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:11:48.45,0:11:53.29,Default,,0,0,0,,Әдемі! Нағыз сұлу, дәл мен сияқты
Dialogue: 0,0:11:53.38,0:11:58.21,Default,,0,0,0,,Хехе... Бұл келе жатыр. Біраз келе жатыр~
Dialogue: 0,0:11:58.30,0:12:01.93,Default,,0,0,0,,Осы кезеңде Жою құдайы өзінің ең жоғарғы деңгейіне қайта жанданды.
Dialogue: 0,0:12:02.01,0:12:04.84,Default,,0,0,0,,Бұл қамалға тамыр жайған.
Бұл
Dialogue: 0,0:12:04.93,0:12:07.56,Default,,0,0,0,,сияқты нәрсе ме?
Dialogue: 0,0:12:07.64,0:12:08.64,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:09.85,0:12:12.02,Default,,0,0,0,,Ингви Шера
Dialogue: 0,0:12:12.77,0:12:14.27,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:12:14.35,0:12:16.36,Default,,0,0,0,,Олар сәйкес келеді.
Dialogue: 0,0:12:16.44,0:12:20.36,Default,,0,0,0,,Осы уақытқа дейін қалыпты болып көрінген нәрсе күшті иллюзия болды.
Dialogue: 0,0:12:20.44,0:12:23.91,Default,,0,0,0,,Бұл жасырылғандықтан ғана.
Dialogue: 0,0:12:23.99,0:12:26.03,Default,,0,0,0,,Ха, бұл менмін.
Dialogue: 0,0:12:26.12,0:12:31.16,Default,,0,0,0,,Оны сұлулықтың бейнесі Дай-Амонның сиқыры ғана бұзды.
Dialogue: 0,0:12:31.25,0:12:32.54,Default,,0,0,0,,Егер осылай салқынқанды болып жүре берсең, сүйкімді жүзіңді бүлдіріп аласың.
Dialogue: 0,0:12:32.62,0:12:35.38,Default,,0,0,0,,Содан кейін бұл иллюзияны Каль...
Dialogue: 0,0:12:35.46,0:12:39.46,Default,,0,0,0,,Мен мұны өзінің сенімді адамы, генерал жын-шайтаннан жасырғанын білмедім.
Dialogue: 0,0:12:39.55,0:12:44.59,Default,,0,0,0,,Кэльде шынымен қараңғылық бар ма?
Dialogue: 0,0:12:44.68,0:12:48.18,Default,,0,0,0,,Аузыңды жап, ақымақ! Кал-самадан бас тарту керек пе?
Dialogue: 0,0:12:48.26,0:12:51.64,Default,,0,0,0,,Қарақшылардың сөзінен абдырап қалдың ба? Біздікі деп ойлайсың ба?
Dialogue: 0,0:12:51.73,0:12:53.14,Default,,0,0,0,,Өл!
Dialogue: 0,0:12:53.23,0:12:54.60,Default,,0,0,0,,Дай-Амон
Dialogue: 0,0:12:54.69,0:12:57.56,Default,,0,0,0,,Биіктікке секіру лақтыратын алып айналдыру асшаяндары Вампирді жою сәулесі (Ассер көрінісі)!
Dialogue: 0,0:12:57.65,0:12:59.52,Default,,0,0,0,,Уау
Dialogue: 0,0:12:59.61,0:13:00.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:01.82,0:13:03.19,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:13:03.28,0:13:06.11,Default,,0,0,0,,Әй, асыл ай
Dialogue: 0,0:13:06.61,0:13:09.45,Default,,0,0,0,,Менің сүйікті шеберіммен байланысымның белгісі.
Dialogue: 0,0:13:09.53,0:13:13.04,Default,,0,0,0,,Көгілдір, көк түсте жарқырай берсін!
Dialogue: 0,0:13:13.54,0:13:18.42,Default,,0,0,0,,Мына тырнақтардың көгілдір болуы менің адалдығымның дәлелі.
Dialogue: 0,0:13:18.50,0:13:22.34,Default,,0,0,0,,Қараңызшы, бұл өте көк!
Dialogue: 0,0:13:22.42,0:13:27.51,Default,,0,0,0,,Қараңғы ай жауым Қалсудың қызыл қанына боялған.
Dialogue: 0,0:13:27.59,0:13:30.31,Default,,0,0,0,,Ұлы менің сүйікті әкем
Dialogue: 0,0:13:30.39,0:13:35.23,Default,,0,0,0,,Оны Дарк Шнайдердің қайта тірілуіне арнаңыз!
Dialogue: 0,0:13:36.81,0:13:38.06,Default,,0,0,0,,Хмм? Бұл не…
Dialogue: 0,0:13:38.15,0:13:39.90,Default,,0,0,0,,Қайта тірілгенімді айттыңыз ба?
Dialogue: 0,0:13:40.44,0:13:42.28,Default,,0,0,0,,Дирк Шнайдер!
Dialogue: 0,0:13:55.83,0:13:57.08,Default,,0,0,0,,Не... не?
Dialogue: 0,0:13:57.17,0:13:59.46,Default,,0,0,0,,Бөлме температурасы тез төмендейді
Dialogue: 0,0:13:59.54,0:14:01.54,Default,,0,0,0,,және осы адаммен шайқасуға рұқсат етті—
Dialogue: 0,0:14:01.63,0:14:03.17,Default,,0,0,0,,Мұз кристалдары
Dialogue: 0,0:14:08.93,0:14:10.51,Default,,0,0,0,,О, ау!
Dialogue: 0,0:14:13.14,0:14:15.77,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:14:21.27,0:14:23.78,Default,,0,0,0,,Ах... Ка... Кал-сама...
Dialogue: 0,0:14:23.86,0:14:28.40,Default,,0,0,0,,Тұрақты зұлым жын қайта тірілді ме?
Dialogue: 0,0:14:29.07,0:14:31.32,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:14:31.41,0:14:34.95,Default,,0,0,0,,Сіз маған бағынбауды жоспарлап отырсыз ба?
Dialogue: 0,0:14:35.04,0:14:37.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:38.46,0:14:41.00,Default,,0,0,0,,Немесе… қабырға қалыпты жағдайға оралды.
Dialogue: 0,0:14:41.08,0:14:44.96,Default,,0,0,0,,Ха, біраз болды, Кальдікі.
Dialogue: 0,0:14:45.05,0:14:48.30,Default,,0,0,0,,Бірақ маған бағынбай жүрген сенсің!
Dialogue: 0,0:14:48.38,0:14:51.59,Default,,0,0,0,,Сіздің әкеңіз Дирк Шнайдер
Dialogue: 0,0:14:51.68,0:14:56.52,Default,,0,0,0,,Мені Жою Құдайы сияқты ескі дүние қоқыстары қызықтырмайды.
Dialogue: 0,0:14:56.60,0:15:01.19,Default,,0,0,0,,Ал қазір сен отырған тағың әуелгіде болды
Dialogue: 0,0:15:01.27,0:15:04.77,Default,,0,0,0,,Ұлы Қараңғы Шнайдерге тиесілі!
Dialogue: 0,0:15:06.57,0:15:07.24,Default,,0,0,0,,Иә
Dialogue: 0,0:15:07.32,0:15:08.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:08.40,0:15:10.70,Default,,0,0,0,,«Шық, жыртқыш!»
Dialogue: 0,0:15:13.03,0:15:14.58,Default,,0,0,0,,Қар қасқыры ақырған жаулаушы (Вай апай)!
Dialogue: 0,0:15:15.62,0:15:16.70,Default,,0,0,0,,Nuo
Dialogue: 0,0:15:16.79,0:15:17.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:18.04,0:15:18.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:19.00,0:15:20.62,Default,,0,0,0,,Гяааах!
Dialogue: 0,0:15:23.17,0:15:25.30,Default,,0,0,0,,Құпия неғұрлым ауыр болса, жүрек соғұрлым азап шегіп, зар илейді.
Dialogue: 0,0:15:25.38,0:15:26.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:26.38,0:15:28.26,Default,,0,0,0,,Өте қиын болды… Өтінемін, мені жалғыз қалдыр.
Dialogue: 0,0:15:28.34,0:15:32.76,Default,,0,0,0,,Менің сүйкімді үй жануарларым...
Dialogue: 0,0:15:32.84,0:15:35.64,Default,,0,0,0,,Не... Каль-саманың сиқырына төтеп беру үшін?
Dialogue: 0,0:15:35.72,0:15:37.72,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:15:37.81,0:15:42.73,Default,,0,0,0,,Төменгі адам деңгейінде, Мен асылмын!
Dialogue: 0,0:15:42.81,0:15:46.23,Default,,0,0,0,,Қараңдар! Дай-Амонның бетіндегі өрнек...
Dialogue: 0,0:15:47.15,0:15:50.28,Default,,0,0,0,,Тізбектелген Дай-Амон!
Dialogue: 0,0:15:51.11,0:15:56.08,Default,,0,0,0,,Ооо... одан да қорқынышты әрі күшті болып кетті⸺
Dialogue: 0,0:15:56.58,0:15:59.87,Default,,0,0,0,,Вампирлердің шынайы күшін сезініңіз!
Dialogue: 0,0:15:59.95,0:16:00.91,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:01.00,0:16:02.83,Default,,0,0,0,,Ең күшті вампирді жою зеңбірегі
Dialogue: 0,0:16:03.37,0:16:04.92,Default,,0,0,0,,Құрметті Кал!
Dialogue: 0,0:16:05.63,0:16:06.46,Default,,0,0,0,,Хун
Dialogue: 0,0:16:07.05,0:16:07.80,Default,,0,0,0,,Йохё қалқаны!
Dialogue: 0,0:16:07.88,0:16:10.09,Default,,0,0,0,,Арх... Арх!
Dialogue: 0,0:16:11.84,0:16:12.97,Default,,0,0,0,,Ол кері қайтты!
Dialogue: 0,0:16:13.05,0:16:14.09,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:16:18.10,0:16:20.48,Default,,0,0,0,,(Джозеф) Бір, екі. (Абдул) Бір, екі.
Dialogue: 0,0:16:20.56,0:16:21.98,Default,,0,0,0,,О, уәаа!
Dialogue: 0,0:16:23.23,0:16:24.65,Default,,0,0,0,,О...
Dialogue: 0,0:16:24.73,0:16:27.52,Default,,0,0,0,,Ынви, жақсысың ба? Мықты бол
Dialogue: 0,0:16:27.61,0:16:28.61,Default,,0,0,0,,Ынви
Dialogue: 0,0:16:28.69,0:16:30.69,Default,,0,0,0,,Бұл... жарайды.
Dialogue: 0,0:16:31.28,0:16:34.03,Default,,0,0,0,,Ал... Каль-сама ше?
Dialogue: 0,0:16:42.87,0:16:43.79,Default,,0,0,0,,Құрметті Кал
Dialogue: 0,0:16:45.92,0:16:46.92,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:16:47.00,0:16:50.63,Default,,0,0,0,,Өз сиқырыммен басылған кресттің дәмі
Dialogue: 0,0:16:51.34,0:16:55.72,Default,,0,0,0,,Әй, сиқырлы күшін жоғалтқан дене шынында да кішкентай ма?
Dialogue: 0,0:16:55.80,0:16:59.64,Default,,0,0,0,,Қарғыс атқыр... Мұзды айнамен және линзамен шағылыстыру дегенді қалай түсінесіңдер?
Dialogue: 0,0:17:00.39,0:17:02.18,Default,,0,0,0,,Калдан күткендей
Dialogue: 0,0:17:03.35,0:17:08.23,Default,,0,0,0,,Менің осы жағымсыз жағымды әшкерелеп, үлкен жұмыс жасадың.
Dialogue: 0,0:17:08.31,0:17:10.19,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:17:10.27,0:17:14.49,Default,,0,0,0,,Хахаха, уайымдама, мен саған қазір аяқтаймын.
Dialogue: 0,0:17:14.57,0:17:16.49,Default,,0,0,0,,Ал... күте тұрыңыз, Кал.
Dialogue: 0,0:17:16.57,0:17:19.20,Default,,0,0,0,,Пайдасы жоқ, пайдасы жоқ, пайдасы жоқ!
Dialogue: 0,0:17:19.28,0:17:20.41,Default,,0,0,0,,Не?
Dialogue: 0,0:17:20.49,0:17:22.04,Default,,0,0,0,,Беру
Dialogue: 0,0:17:22.12,0:17:25.46,Default,,0,0,0,,Шын жүректен кешірім сұрасаң, кешірмейді.
Dialogue: 0,0:17:25.54,0:17:29.96,Default,,0,0,0,,Енді ойыңды өзгертіп, менің айтқанымды істе...
Dialogue: 0,0:17:30.04,0:17:30.88,Default,,0,0,0,,Дохьяаа!
Dialogue: 0,0:17:30.96,0:17:31.80,Default,,0,0,0,,Шулы!
Dialogue: 0,0:17:31.88,0:17:33.88,Default,,0,0,0,,Уау, аа... жақсы...
Dialogue: 0,0:17:33.97,0:17:35.84,Default,,0,0,0,,О, эй!
Dialogue: 0,0:17:35.93,0:17:38.55,Default,,0,0,0,,Мен сені кешіремін, сондықтан оны доғар~
Dialogue: 0,0:17:38.64,0:17:39.47,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:39.55,0:17:41.01,Default,,0,0,0,,Гябаха!
Dialogue: 0,0:17:44.93,0:17:47.35,Default,,0,0,0,,Бәрі бар, генерал жын.
Dialogue: 0,0:17:47.44,0:17:49.86,Default,,0,0,0,,5 минуттан кейін төтенше әскери кеңес өткізіңіз.
Dialogue: 0,0:17:49.94,0:17:54.61,Default,,0,0,0,,Енді ол адам қайта тірілгеннен кейін босқа уақыт қалмайды.
Dialogue: 0,0:17:55.19,0:17:56.53,Default,,0,0,0,,Хаха
Dialogue: 0,0:17:56.61,0:18:00.20,Default,,0,0,0,,Не... не?
Dialogue: 0,0:18:00.28,0:18:01.74,Default,,0,0,0,,ақымақ
Dialogue: 0,0:18:01.83,0:18:03.75,Default,,0,0,0,,Қазірдің өзінде екі адам бар.
Dialogue: 0,0:18:03.83,0:18:07.67,Default,,0,0,0,,Оны Дирк Шнайдер мырза өшірген жоқ па?
Dialogue: 0,0:18:07.75,0:18:09.25,Default,,0,0,0,,Хмм? Бұл не…
Dialogue: 0,0:18:09.33,0:18:10.96,Default,,0,0,0,,Ол жойылды ма?
Dialogue: 0,0:18:11.04,0:18:14.13,Default,,0,0,0,,Макапин мен Батори туралы не деуге болады? Ақымақ!
Dialogue: 0,0:18:14.21,0:18:17.68,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:18:17.76,0:18:21.97,Default,,0,0,0,,Сіздің жеңу мүмкіндігіңіз жоқ.
Dialogue: 0,0:18:22.05,0:18:23.26,Default,,0,0,0,,Хехе...
Dialogue: 0,0:18:23.35,0:18:26.48,Default,,0,0,0,,Мууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу амау!
Dialogue: 0,0:18:26.56,0:18:28.31,Default,,0,0,0,,Аха…
Dialogue: 0,0:18:28.39,0:18:30.98,Default,,0,0,0,,Қал Әзірге, бүгінге.
Dialogue: 0,0:18:31.06,0:18:34.19,Default,,0,0,0,,Оны ұтыс ойыны дейік.
Dialogue: 0,0:18:34.69,0:18:35.82,Default,,0,0,0,,De!
Dialogue: 0,0:18:35.90,0:18:38.20,Default,,0,0,0,,Мен, құбыжық!
Dialogue: 0,0:18:38.28,0:18:40.16,Default,,0,0,0,,Hyohyohhyohyo...
Dialogue: 0,0:18:40.24,0:18:43.62,Default,,0,0,0,,Сізді бір күні көруді асыға күтемін.
Dialogue: 0,0:18:43.70,0:18:46.20,Default,,0,0,0,,Қат! Қайтып кел!
Dialogue: 0,0:18:49.29,0:18:54.09,Default,,0,0,0,,Жоқ... бұл кісі мен білетін Қал-сама емес.
Dialogue: 0,0:18:54.96,0:18:56.05,Default,,0,0,0,,Егер сіз Кал
Dialogue: 0,0:18:56.13,0:18:58.88,Default,,0,0,0,,Қорғау үшін сыртқа секірген бағыныңқыға мән бермеу
Dialogue: 0,0:18:58.97,0:19:01.93,Default,,0,0,0,,Ешқашан жаудың сиқырына тойтарыс бермеңіз, т.б.
Dialogue: 0,0:19:02.60,0:19:03.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:05.72,0:19:07.89,Default,,0,0,0,,Қайда бара жатырсың, Шера?
Dialogue: 0,0:19:08.48,0:19:11.23,Default,,0,0,0,,Жақында әскери кеңес басталады.
Dialogue: 0,0:19:12.40,0:19:16.03,Default,,0,0,0,,Асыл адам... сен ойламадың ба?
Dialogue: 0,0:19:17.03,0:19:18.03,Default,,0,0,0,,Қазір...
Dialogue: 0,0:19:18.11,0:19:20.11,Default,,0,0,0,,Ағымдағы кал...
Dialogue: 0,0:19:31.79,0:19:34.42,Default,,0,0,0,,(Жыйрау дыбысы)
Dialogue: 0,0:19:34.50,0:19:36.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:36.50,0:19:39.72,Default,,0,0,0,,Ка... Каль (Орк солдаты) Жартас! Жол!
Dialogue: 0,0:19:41.05,0:19:43.59,Default,,0,0,0,,Рыцарьдан оның керемет құрметтемеуі үшін кешірім сұраңыз.
Dialogue: 0,0:19:44.80,0:19:46.18,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:19:46.26,0:19:48.60,Default,,0,0,0,,Тұтылу елінің рыцарь командирі
Dialogue: 0,0:19:48.68,0:19:50.60,Default,,0,0,0,,Ингви фон Малмстин
Dialogue: 0,0:19:51.48,0:19:52.81,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,0:19:53.40,0:19:56.44,Default,,0,0,0,,Уф, түн патшасы қылыш!
Dialogue: 0,0:19:57.23,0:19:58.15,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:59.24,0:20:01.15,Default,,0,0,0,,Қандай сиқыр...
Dialogue: 0,0:20:01.24,0:20:04.37,Default,,0,0,0,,Қылышым осыншама жетеді деп ойламадым.
Dialogue: 0,0:20:05.28,0:20:08.12,Default,,0,0,0,,Неге менімен жалғыз күрестің?
Dialogue: 0,0:20:08.62,0:20:13.58,Default,,0,0,0,,Мен өлтіруші деген стигманы көтеруге тура келсе де...
Dialogue: 0,0:20:13.67,0:20:16.75,Default,,0,0,0,,Соғыста көп адамның өмірін жоғалтқаннан гөрі
Dialogue: 0,0:20:17.25,0:20:20.88,Default,,0,0,0,,Мен сені жалғыз қалдырғаным дұрыс деп ойладым.
Dialogue: 0,0:20:20.97,0:20:23.26,Default,,0,0,0,,Иә, бұл орынды.
Dialogue: 0,0:20:23.84,0:20:28.43,Default,,0,0,0,,Менің мақсатым - Eclipse ақсүйектерінің әскери күшін азайту.
Dialogue: 0,0:20:28.51,0:20:31.35,Default,,0,0,0,,Бұл бізге қарсы тұруға ерік-жігерді алып тастау болды.
Dialogue: 0,0:20:31.85,0:20:33.81,Default,,0,0,0,,Операциялық мақсатқа қол жеткізілді.
Dialogue: 0,0:20:34.31,0:20:39.57,Default,,0,0,0,,Әрине, мақсат адам өмірін тонау немесе жою емес еді.
Dialogue: 0,0:20:39.65,0:20:40.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:41.15,0:20:43.45,Default,,0,0,0,,Соғысты одан әрі таратпа.
Dialogue: 0,0:20:43.53,0:20:46.24,Default,,0,0,0,,Ауылшаруашылық жерлеріне келтірілген залалды назардан тыс қалдыруға болмайды.
Dialogue: 0,0:20:46.74,0:20:51.16,Default,,0,0,0,,Егінге әсер етеді, ал кейбір адамдар қыстан шыға алмайды.
Dialogue: 0,0:20:53.71,0:20:57.71,Default,,0,0,0,,Ашаршылыққа ұшыраған халықты басқару көп қиыншылық болар еді.
Dialogue: 0,0:20:58.29,0:21:00.50,Default,,0,0,0,,Неге мені өлтірмейсің?
Dialogue: 0,0:21:01.09,0:21:03.38,Default,,0,0,0,,Себебі ол тиімсіз
Dialogue: 0,0:21:03.47,0:21:04.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:04.93,0:21:06.76,Default,,0,0,0,,Сіз өзіңізсіз
Dialogue: 0,0:21:06.84,0:21:10.81,Default,,0,0,0,,Адамдарға тиімді көмектеседі деп ойлайтын нәрсені жасаңыз.
Dialogue: 0,0:21:12.64,0:21:16.06,Default,,0,0,0,,Бұл адам жай ғана ұтымды болды.
Dialogue: 0,0:21:16.65,0:21:21.98,Default,,0,0,0,,Осы елдің халқына қыстан аман шығуға көмектесу үшін біз патша сарайына азық-түлік қорын жібердік.
Dialogue: 0,0:21:22.07,0:21:24.90,Default,,0,0,0,,Олар тіпті дворяндардан тәркіленген мүліктерді де пайдаланды.
Dialogue: 0,0:21:25.99,0:21:27.91,Default,,0,0,0,,Ойлану керек
Dialogue: 0,0:21:27.99,0:21:31.41,Default,,0,0,0,,Бұл ел үшін... жоқ, бұл дүние үшін.
Dialogue: 0,0:21:31.49,0:21:33.83,Default,,0,0,0,,Ең тиімді әдіс қандай...
Dialogue: 0,0:21:35.29,0:21:36.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:42.63,0:21:46.63,Default,,0,0,0,,Жарайды, мен саған генерал жынмен бір қатарда тұруға рұқсат етемін.
Dialogue: 0,0:21:47.13,0:21:49.26,Default,,0,0,0,,Бұдан былай адал бол.
Dialogue: 0,0:21:50.51,0:21:52.72,Default,,0,0,0,,Жаратқан Ие неге сенеді
Dialogue: 0,0:21:55.27,0:21:56.27,Default,,0,0,0,,Хаха!
Dialogue: 0,0:22:00.48,0:22:02.32,Default,,0,0,0,,Жарайды, Шера.
Dialogue: 0,0:22:02.40,0:22:04.86,Default,,0,0,0,,Ол адам аман емес пе еді?
Dialogue: 0,0:22:05.57,0:22:06.70,Default,,0,0,0,,Ынви…
Dialogue: 0,0:22:07.41,0:22:09.03,Default,,0,0,0,,Мен мұнымен жақсымын.
Dialogue: 0,0:22:10.53,0:22:12.16,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:22:13.83,0:22:16.08,Default,,0,0,0,,Лорд Калға адал болыңыз
Dialogue: 0,0:22:16.91,0:22:19.33,Default,,0,0,0,,Мен сенетінім үшін
Dialogue: 0,0:22:21.13,0:22:23.13,Default,,0,0,0,,♪～
Dialogue: 0,0:23:48.09,0:23:50.09,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.59,0:23:57.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory