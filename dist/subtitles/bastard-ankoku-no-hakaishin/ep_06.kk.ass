Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.43,0:00:18.14,Default,,0,0,0,,Металионның орталық континентінде шашыраңқы.
Dialogue: 0,0:00:18.22,0:00:20.18,Default,,0,0,0,,Қарсылықты жалғастыру⸺
Dialogue: 0,0:00:20.27,0:00:23.60,Default,,0,0,0,,Автономды коммерциялық және коммерциялық қалалар мен олардың серіктес қалалары үшін
Dialogue: 0,0:00:25.19,0:00:28.73,Default,,0,0,0,,Деми-адамдардан құралған одақтас күштерді жіберіңіз.
Dialogue: 0,0:00:28.82,0:00:32.19,Default,,0,0,0,,Көтерілісшілердің қоқысын тазалаңыз
Dialogue: 0,0:00:32.28,0:00:33.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:33.99,0:00:38.74,Default,,0,0,0,,Дегенмен демон генералдың бұл операцияға қатысуының қажеті жоқ.
Dialogue: 0,0:00:38.83,0:00:40.83,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:00:40.91,0:00:44.08,Default,,0,0,0,,Демон генералға басқа тапсырма беріңіз.
Dialogue: 0,0:00:44.67,0:00:45.83,Default,,0,0,0,,Жолда жүр
Dialogue: 0,0:00:47.67,0:00:52.80,Default,,0,0,0,,Кримсон Даңқының жоғалған эльф қаласына
Dialogue: 0,0:00:55.88,0:00:57.89,Default,,0,0,0,,♪～
Dialogue: 0,0:02:20.97,0:02:22.97,Default,,0,0,0,,～♪
Dialogue: 0,0:02:29.02,0:02:30.94,Default,,0,0,0,,Әрқашанғыдай, сенің бұл бейқам мінезің—
Dialogue: 0,0:02:31.02,0:02:32.06,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:02:32.15,0:02:34.44,Default,,0,0,0,,Ою… Мені кешіріңіз!
Dialogue: 0,0:02:34.53,0:02:37.40,Default,,0,0,0,,Getageta Getageta
Dialogue: 0,0:02:37.49,0:02:39.11,Default,,0,0,0,,Уау, эй, эй...
Dialogue: 0,0:02:39.20,0:02:40.82,Default,,0,0,0,,Тоқта! Тоқта...
Dialogue: 0,0:02:40.91,0:02:43.53,Default,,0,0,0,,Гяаааааааааааааааааааааааа
Dialogue: 0,0:02:45.24,0:02:47.12,Default,,0,0,0,,(Орк сарбаздарының күлкісі)
Dialogue: 0,0:02:47.20,0:02:51.08,Default,,0,0,0,,Қызықты орк (орк солдаты) Келесі! Келесі!
Dialogue: 0,0:02:51.17,0:02:52.88,Default,,0,0,0,,Па... Папа!
Dialogue: 0,0:02:53.63,0:02:58.30,Default,,0,0,0,,Nihahaha Келесі - әйел мен брат, орк.
Dialogue: 0,0:03:00.84,0:03:04.10,Default,,0,0,0,,Орктар - Гидраның тамағы.
Dialogue: 0,0:03:04.18,0:03:05.47,Default,,0,0,0,,Әпке...
Dialogue: 0,0:03:05.56,0:03:07.68,Default,,0,0,0,,Тоқта... Тоқта!
Dialogue: 0,0:03:07.77,0:03:09.85,Default,,0,0,0,,Ой (апа) Ах.
Dialogue: 0,0:03:09.94,0:03:13.40,Default,,0,0,0,,Аналықтарды тамақтандырмас бұрын сиқытатын орктар.
Dialogue: 0,0:03:15.98,0:03:17.86,Default,,0,0,0,,Кяааааааааааа (Орк солдаты) Ууууу
Dialogue: 0,0:03:17.94,0:03:20.32,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:20.40,0:03:23.99,Default,,0,0,0,,Гахахаха (апа) Яаааааааааааааааааа
Dialogue: 0,0:03:24.07,0:03:28.12,Default,,0,0,0,,Орктардың бәрі осы, хобгоб.
Dialogue: 0,0:03:28.20,0:03:33.33,Default,,0,0,0,,Осы көзқараспен Хобгоб барлық тұтқындарды өлтіру үшін қорқытады.
Dialogue: 0,0:03:33.42,0:03:36.30,Default,,0,0,0,,Біз ол жаққа барғанда, біз гоблиндерді пісіреміз
Dialogue: 0,0:03:36.38,0:03:38.46,Default,,0,0,0,,Хобгоб – асыл нәсіл.
Dialogue: 0,0:03:40.63,0:03:44.34,Default,,0,0,0,,Қараңдар, қараңдар, бұл топтама Хобгоб
Dialogue: 0,0:03:44.43,0:03:47.22,Default,,0,0,0,,Уау, таңғажайып хобгоб
Dialogue: 0,0:03:47.31,0:03:50.14,Default,,0,0,0,,Сәлем, қоб.
Dialogue: 0,0:03:50.23,0:03:51.56,Default,,0,0,0,,Қарашы, Хобгоб.
Dialogue: 0,0:03:51.64,0:03:53.69,Default,,0,0,0,,Охо~Хобгоб
Dialogue: 0,0:03:53.77,0:03:57.57,Default,,0,0,0,,Тоқта, күт, хехехе Емен
Dialogue: 0,0:03:57.65,0:03:59.90,Default,,0,0,0,,Көмектесіңіз! Ах
Dialogue: 0,0:03:59.99,0:04:03.11,Default,,0,0,0,,(бір нәрсені сүйреп бара жатқан дыбыс)
Dialogue: 0,0:04:03.20,0:04:04.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:04.11,0:04:08.37,Default,,0,0,0,,Бұл ненің дыбысы? Бұл шлам - хобгоб
Dialogue: 0,0:04:08.45,0:04:11.83,Default,,0,0,0,,Гухехехе (апа) Яаааааа
Dialogue: 0,0:04:13.37,0:04:16.00,Default,,0,0,0,,Нана... Нана...
Dialogue: 0,0:04:16.67,0:04:19.46,Default,,0,0,0,,Оның шабуылдары ерекше төмен!
Dialogue: 0,0:04:20.46,0:04:22.42,Default,,0,0,0,,Әдемі
Dialogue: 0,0:04:22.51,0:04:23.38,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:23.47,0:04:25.84,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:25.93,0:04:27.80,Default,,0,0,0,,Вааааааааааааааааааааааааааа
Dialogue: 0,0:04:27.89,0:04:29.51,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:04:29.60,0:04:33.19,Default,,0,0,0,,Сәлем Hii Ii Neck... Мойын!
Dialogue: 0,0:04:33.27,0:04:34.48,Default,,0,0,0,,Бухаха
Dialogue: 0,0:04:34.56,0:04:38.19,Default,,0,0,0,,Ка~хахаха Бұл не, төменгі жаратылыстар?
Dialogue: 0,0:04:38.27,0:04:43.07,Default,,0,0,0,,Сен бейбақ болсаң да, достарың өлгенде ашуланасың ба, қайғырасың ба?
Dialogue: 0,0:04:43.15,0:04:46.82,Default,,0,0,0,,Те... Теме, не деген сұмдық орк!
Dialogue: 0,0:04:46.91,0:04:50.20,Default,,0,0,0,,Қалжың, сен жалғызсың, Орк.
Dialogue: 0,0:04:50.29,0:04:51.41,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:04:51.50,0:04:55.17,Default,,0,0,0,,Сен жындысың ба? Бұл жігіт Хобгоб
Dialogue: 0,0:04:55.25,0:04:57.21,Default,,0,0,0,,Гехьяхьяхя
Dialogue: 0,0:04:57.29,0:05:01.21,Default,,0,0,0,,Сіз 1 миллион адамнан тұратын армиямен жеке күресуге ниетіңіз бар ма?
Dialogue: 0,0:05:01.30,0:05:03.97,Default,,0,0,0,,Бұл бұла~ка хобгоб
Dialogue: 0,0:05:04.05,0:05:05.80,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:05:05.88,0:05:07.76,Default,,0,0,0,,Куку кунуууууу!
Dialogue: 0,0:05:07.84,0:05:11.72,Default,,0,0,0,,(Уақыт дауысы)
Dialogue: 0,0:05:11.81,0:05:14.06,Default,,0,0,0,,Кайзард Альзадо
Dialogue: 0,0:05:14.14,0:05:16.85,Default,,0,0,0,,Ки Сук Ханс Жалпы жібек
Dialogue: 0,0:05:16.94,0:05:18.36,Default,,0,0,0,,Не… Не істеп жатырсың!?
Dialogue: 0,0:05:18.44,0:05:21.07,Default,,0,0,0,,Күлге айнал, Аспан асты ғұламасы
Dialogue: 0,0:05:21.15,0:05:24.61,Default,,0,0,0,,Жеті кілтпен тозақ есігін аш
Dialogue: 0,0:05:24.70,0:05:28.87,Default,,0,0,0,,Хехекку~табаре~
Dialogue: 0,0:05:28.95,0:05:31.08,Default,,0,0,0,,Жеті кілттің сақшысы (Харо Еен)!
Dialogue: 0,0:05:32.87,0:05:35.16,Default,,0,0,0,,Уаааааааааааааааааааааааа
Dialogue: 0,0:05:35.25,0:05:36.67,Default,,0,0,0,,Ха~хахаха
Dialogue: 0,0:05:36.75,0:05:40.13,Default,,0,0,0,,Өл, өл, өл!
Dialogue: 0,0:05:51.14,0:05:54.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:54.10,0:05:56.89,Default,,0,0,0,,Не... не болды?
Dialogue: 0,0:05:56.98,0:06:01.69,Default,,0,0,0,,Менің үлкен әскерім Лорд Калдан алды.
Dialogue: 0,0:06:01.77,0:06:03.98,Default,,0,0,0,,Немесе… Жою…
Dialogue: 0,0:06:04.07,0:06:05.49,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:06:05.57,0:06:10.45,Default,,0,0,0,,Хехен Жарайды, самурай, қалған жауларды жой!
Dialogue: 0,0:06:10.53,0:06:12.87,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:06:12.95,0:06:15.87,Default,,0,0,0,,А... бастық па?
Dialogue: 0,0:06:15.95,0:06:19.12,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:06:19.21,0:06:20.83,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:20.92,0:06:22.84,Default,,0,0,0,,Йоко Вау
Dialogue: 0,0:06:22.92,0:06:27.09,Default,,0,0,0,,Мен сіз сұрағандай көмектестім, маған сыйлық беріңіз. Сыйақы.
Dialogue: 0,0:06:27.17,0:06:30.72,Default,,0,0,0,,Гах~шщ~ Мына жаққа қара.
Dialogue: 0,0:06:30.80,0:06:33.68,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:06:34.77,0:06:36.73,Default,,0,0,0,,Бұйрық тізбегі жоғалған сияқты.
Dialogue: 0,0:06:36.81,0:06:38.64,Default,,0,0,0,,Шаңға айналады
Dialogue: 0,0:06:38.73,0:06:42.73,Default,,0,0,0,,Орктар мен гоблиндерде адалдық ұғымы жоқ.
Dialogue: 0,0:06:43.69,0:06:46.03,Default,,0,0,0,,Көпшілік шешілді ме?
Dialogue: 0,0:06:46.11,0:06:51.62,Default,,0,0,0,,Бірақ сол үлкен армияның жартысынан көбін әп-сәтте өртеп жіберуге бола ма?
Dialogue: 0,0:06:52.53,0:06:55.04,Default,,0,0,0,,Ол кісінің жауым болмағанына қуанамын.
Dialogue: 0,0:06:55.12,0:06:56.16,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:06:57.62,0:07:00.29,Default,,0,0,0,,Біз әлі сіз тарапта емеспіз.
Dialogue: 0,0:07:00.37,0:07:02.50,Default,,0,0,0,,Сәлем! Қазірдің өзінде
Dialogue: 0,0:07:05.55,0:07:09.22,Default,,0,0,0,,Автономиялық сауда және сауда қалаларына экспедицияға жіберілген Қал әскері
Dialogue: 0,0:07:09.30,0:07:12.18,Default,,0,0,0,,Барлығы жарты адамдардан тұрады
Dialogue: 0,0:07:12.26,0:07:16.77,Default,,0,0,0,,Барлау деректері бойынша генерал жынның ізі табылмады.
Dialogue: 0,0:07:16.85,0:07:18.14,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:18.23,0:07:20.06,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:07:20.14,0:07:22.31,Default,,0,0,0,,Майдан командирі, шайтанның генералы,
Dialogue: 0,0:07:22.40,0:07:26.19,Default,,0,0,0,,Мен мұндай үлкен экспедицияның авангардында ешкім жоқ екеніне сене алмаймын.
Dialogue: 0,0:07:26.27,0:07:28.11,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:07:28.19,0:07:31.91,Default,,0,0,0,,Осыған байланысты біз қазір тұтқындардан жауап алып жатырмыз.
Dialogue: 0,0:07:32.45,0:07:36.62,Default,,0,0,0,,Люс туралы бірдеңе жауға ағып кеткен болар...?
Dialogue: 0,0:07:36.70,0:07:38.29,Default,,0,0,0,,Бұл ақымақ, олай болуы мүмкін емес...
Dialogue: 0,0:07:38.37,0:07:40.58,Default,,0,0,0,,(Дирк Шнайдердің күлкісі)
Dialogue: 0,0:07:40.66,0:07:42.58,Default,,0,0,0,,Сен самурайсың
Dialogue: 0,0:07:42.67,0:07:46.75,Default,,0,0,0,,17 жыл бұрын болған оқиғаны әзірге бір жаққа қояйын.
Dialogue: 0,0:07:46.84,0:07:49.34,Default,,0,0,0,,Әдетте мен оны өлтіретін едім.
Dialogue: 0,0:07:49.42,0:07:54.51,Default,,0,0,0,,Гео, әже және Ми - жай ғана бақытты бейбақтар.
Dialogue: 0,0:07:54.59,0:07:59.31,Default,,0,0,0,,Бұл әдемі, ақылды және күшті Қараңғы Шнайдер-сама...
Dialogue: 0,0:07:59.39,0:08:03.10,Default,,0,0,0,,Үлкен жүректі, жанашыр адам бол.
Dialogue: 0,0:08:03.19,0:08:04.23,Default,,0,0,0,,Агия
Dialogue: 0,0:08:04.31,0:08:07.69,Default,,0,0,0,,Солай бола тұра, сен кәрі көрінесің.
Dialogue: 0,0:08:07.77,0:08:10.15,Default,,0,0,0,,Буа~хахаха
Dialogue: 0,0:08:10.24,0:08:14.87,Default,,0,0,0,,Бұл бұрынғыдан ерекше...
Dialogue: 0,0:08:14.95,0:08:17.83,Default,,0,0,0,,Корат (Дирк Шнайдер)
Dialogue: 0,0:08:17.91,0:08:21.37,Default,,0,0,0,,Шулы, Люс. Бұл жиналысқа кедергі келтірмей ме?
Dialogue: 0,0:08:21.45,0:08:24.08,Default,,0,0,0,,Әй, Иоко-сан!
Dialogue: 0,0:08:24.17,0:08:25.83,Default,,0,0,0,,Кяаааааааааааааааааааааааааа
Dialogue: 0,0:08:25.92,0:08:28.30,Default,,0,0,0,,Жоқ! (Вай) Әй... Әй, қария!
Dialogue: 0,0:08:28.38,0:08:30.26,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,0:08:32.30,0:08:35.84,Default,,0,0,0,,Егер келесі жолы солай істесең, мен сені қатты үрлеймін!
Dialogue: 0,0:08:35.93,0:08:38.68,Default,,0,0,0,,Сіз оны әлдеқашан үрлеп жатырсыз...
Dialogue: 0,0:08:38.76,0:08:40.35,Default,,0,0,0,,(Йоконың қатты тыныс алуы)
Dialogue: 0,0:08:40.43,0:08:41.43,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:41.52,0:08:45.65,Default,,0,0,0,,Эй... Йоко сәл өзгерген сияқты.
Dialogue: 0,0:08:46.31,0:08:49.27,Default,,0,0,0,,Бұрынғы шиеленісті атмосфера жойылды.
Dialogue: 0,0:08:49.36,0:08:51.74,Default,,0,0,0,,Сиқырдан құтылғандай.
Dialogue: 0,0:08:51.82,0:08:56.95,Default,,0,0,0,,Ааа, ондай жастағы қыздар сондай шығар.
Dialogue: 0,0:08:57.03,0:08:59.08,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:59.16,0:09:01.58,Default,,0,0,0,,Неге үнемі осылай айтасың...
Dialogue: 0,0:09:01.66,0:09:03.29,Default,,0,0,0,,Менің көзіме қара!
Dialogue: 0,0:09:03.37,0:09:06.54,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:09.38,0:09:11.30,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:09:13.30,0:09:16.18,Default,,0,0,0,,«Суға шомылып жатқан қыз!»
Dialogue: 0,0:09:17.30,0:09:20.14,Default,,0,0,0,,Ол жай ғана ақымақ.
Dialogue: 0,0:09:21.18,0:09:24.94,Default,,0,0,0,,Люс шыққаннан бері менің демалуға уақытым болмады.
Dialogue: 0,0:09:37.99,0:09:39.07,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:09:39.16,0:09:42.54,Default,,0,0,0,,Кім? Жоқ, тағы Ви?
Dialogue: 0,0:09:43.20,0:09:44.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:44.70,0:09:46.08,Default,,0,0,0,,Ей!
Dialogue: 0,0:09:51.88,0:09:54.26,Default,,0,0,0,,Жоқ... Люс!
Dialogue: 0,0:09:54.34,0:09:57.47,Default,,0,0,0,,Әй, Йоко-сан!
Dialogue: 0,0:09:57.55,0:09:59.26,Default,,0,0,0,,Йоко-сан
Dialogue: 0,0:09:59.34,0:10:00.55,Default,,0,0,0,,А, аа!
Dialogue: 0,0:10:00.64,0:10:03.27,Default,,0,0,0,,А, жоқ! Келме!
Dialogue: 0,0:10:04.60,0:10:05.60,Default,,0,0,0,,Ах
Dialogue: 0,0:10:05.68,0:10:09.73,Default,,0,0,0,,Йоко-сан, сен менің махаббатымды қабылдауға шешім қабылдадың.
Dialogue: 0,0:10:09.81,0:10:11.31,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:12.90,0:10:14.03,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:10:14.11,0:10:16.24,Default,,0,0,0,,Да... жоқ! Жоқ!
Dialogue: 0,0:10:16.32,0:10:19.24,Default,,0,0,0,,Жоқ, бұл дұрыс емес... иә
Dialogue: 0,0:10:20.20,0:10:23.08,Default,,0,0,0,,Жарайды... енді келе алмайсың.
Dialogue: 0,0:10:26.58,0:10:29.46,Default,,0,0,0,,А, жоқ!
Dialogue: 0,0:10:29.54,0:10:30.54,Default,,0,0,0,,Йоко-сан
Dialogue: 0,0:10:30.63,0:10:31.96,Default,,0,0,0,,Да... жоқ.
Dialogue: 0,0:10:32.04,0:10:34.30,Default,,0,0,0,,Люс, өтінемін!
Dialogue: 0,0:10:34.38,0:10:37.26,Default,,0,0,0,,Бізге ілесіп жүруді қойып, тезірек кетші!
Dialogue: 0,0:10:37.34,0:10:40.72,Default,,0,0,0,,Жарайды... Мен сені пышақтаймын! Мен байсалдымын!
Dialogue: 0,0:10:43.22,0:10:44.60,Default,,0,0,0,,Иә
Dialogue: 0,0:10:46.47,0:10:50.44,Default,,0,0,0,,Сіздің махаббатыңыз 10 миллиард өлімнен артық
Dialogue: 0,0:10:55.07,0:10:56.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:02.16,0:11:04.28,Default,,0,0,0,,Ле… Луш
Dialogue: 0,0:11:04.37,0:11:05.45,Default,,0,0,0,,Йоко-сан
Dialogue: 0,0:11:07.29,0:11:08.50,Default,,0,0,0,,Йоко-сан
Dialogue: 0,0:11:09.08,0:11:10.67,Default,,0,0,0,,Руше
Dialogue: 0,0:11:13.71,0:11:14.79,Default,,0,0,0,,Ха...
Dialogue: 0,0:11:14.88,0:11:18.51,Default,,0,0,0,,Ах... мен...
Dialogue: 0,0:11:18.59,0:11:19.92,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:21.09,0:11:24.30,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:11:31.31,0:11:32.52,Default,,0,0,0,,Аа...
Dialogue: 0,0:11:39.57,0:11:42.99,Default,,0,0,0,,Алдымен уды сорып алуымыз керек.
Dialogue: 0,0:11:43.07,0:11:46.83,Default,,0,0,0,,Жақсы әйел болмасаң, мен оны қабылдамаймын!
Dialogue: 0,0:11:48.24,0:11:51.41,Default,,0,0,0,,Әй, ақымақ, не болды?
Dialogue: 0,0:11:52.04,0:11:55.38,Default,,0,0,0,,Кай-Херн еркектерді жек көруі керек... солай ма?
Dialogue: 0,0:11:56.13,0:11:57.63,Default,,0,0,0,,Ондай адамға...
Dialogue: 0,0:11:57.71,0:11:59.30,Default,,0,0,0,,Мен бұл адамды қорғаймын!
Dialogue: 0,0:11:59.38,0:12:01.42,Default,,0,0,0,,Ней-самаға бағынбаса да.
Dialogue: 0,0:12:01.51,0:12:04.05,Default,,0,0,0,,Саған опасыздық жасаса да!
Dialogue: 0,0:12:04.64,0:12:06.39,Default,,0,0,0,,Қандай адам...
Dialogue: 0,0:12:07.14,0:12:08.89,Default,,0,0,0,,Ойланып жүрсіз бе?
Dialogue: 0,0:12:11.94,0:12:13.81,Default,,0,0,0,,Ешуа?
Dialogue: 0,0:12:13.90,0:12:15.19,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:18.82,0:12:21.49,Default,,0,0,0,,Өзіңді кіммін деп ойладың? Ха
Dialogue: 0,0:12:22.36,0:12:24.91,Default,,0,0,0,,Содан бері сіздің денеңіз қалай болды?
Dialogue: 0,0:12:24.99,0:12:27.87,Default,,0,0,0,,Аа, мен бәрі жақсы істеп жатырмын.
Dialogue: 0,0:12:28.37,0:12:30.66,Default,,0,0,0,,Менің денем бұрынғыдан жеңілірек болды.
Dialogue: 0,0:12:31.29,0:12:32.91,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:12:33.54,0:12:37.25,Default,,0,0,0,,Ол тіпті жаудың жәндіктерге қарсы қабілеттерін пайдаланады.
Dialogue: 0,0:12:38.09,0:12:40.84,Default,,0,0,0,,Бұл әрқашан таң қалдырады.
Dialogue: 0,0:12:42.26,0:12:45.97,Default,,0,0,0,,Люси Ренреннің 17 жыл бұрын соғыста қаза тапқаны.
Dialogue: 0,0:12:46.05,0:12:48.60,Default,,0,0,0,,Батыр ханзада Ларс пен лорд Мифунеге қарсы шайқасты⸺
Dialogue: 0,0:12:48.68,0:12:51.89,Default,,0,0,0,,Аңызға айналған сиқыршы Дирк Шнайдер
Dialogue: 0,0:12:52.85,0:12:56.40,Default,,0,0,0,,Оның сиқырлы күші үлкен әскерді де жеңе алады.
Dialogue: 0,0:12:56.48,0:13:00.23,Default,,0,0,0,,Ешбір күш оны тізе бүктірмейді.
Dialogue: 0,0:13:00.94,0:13:07.03,Default,,0,0,0,,Олар бізден мүлдем басқа. Олардың ойлау тәсілі, өмір салты және күресу тәсілі.
Dialogue: 0,0:13:08.03,0:13:11.41,Default,,0,0,0,,Олар конвенция мен тәртіпке бағынған самурайлар мен рыцарьларға мүлдем қарама-қайшы.
Dialogue: 0,0:13:12.25,0:13:15.83,Default,,0,0,0,,Жеңіске жету үшін не қажет болса да істеу еркіндігі...
Dialogue: 0,0:13:16.33,0:13:19.88,Default,,0,0,0,,Макапин және басқалары демон генералдарына жақын болуы мүмкін.
Dialogue: 0,0:13:20.80,0:13:22.51,Default,,0,0,0,,Мен сондай қызғаншақпын
Dialogue: 0,0:13:27.09,0:13:31.01,Default,,0,0,0,,Жын генералы ретінде мен әртүрлі себептер мен салдарға байланыстымын.
Dialogue: 0,0:13:31.51,0:13:34.48,Default,,0,0,0,,Әу, бірінші, сол жігіт.
Dialogue: 0,0:13:35.52,0:13:40.15,Default,,0,0,0,,Оларда әділеттілік пен адамгершілік сезімдері жоқ.
Dialogue: 0,0:13:40.23,0:13:41.77,Default,,0,0,0,,Нөлдік өзін-өзі бақылау
Dialogue: 0,0:13:41.86,0:13:44.53,Default,,0,0,0,,Бар болғаны – адамның өз қалауы
Dialogue: 0,0:13:44.61,0:13:49.20,Default,,0,0,0,,Мұндай нәрселермен салыстырғанда бізге ұялудың қажеті жоқ!
Dialogue: 0,0:13:49.99,0:13:51.24,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:51.33,0:13:52.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:58.96,0:14:02.75,Default,,0,0,0,,Кидошулардың бірін самурай резиденциясында қарсы алғыңыз келе ме?
Dialogue: 0,0:14:02.84,0:14:07.63,Default,,0,0,0,,Ақымақ! Кидошу туралы айтатын болсақ, олар көтерілісшілер армиясында рөл атқаратын құрылым.
Dialogue: 0,0:14:07.72,0:14:09.34,Default,,0,0,0,,Сен біздің жауымыз емессің бе?
Dialogue: 0,0:14:09.43,0:14:11.80,Default,,0,0,0,,Ол кісі Кидошудан бөлініп кетті.
Dialogue: 0,0:14:11.89,0:14:13.14,Default,,0,0,0,,Мета-Ликанада
Dialogue: 0,0:14:13.22,0:14:16.39,Default,,0,0,0,,Бізбен бірге көтерілісшілер әскеріне қарсы соғыстың.
Dialogue: 0,0:14:16.48,0:14:18.56,Default,,0,0,0,,Тамаша сиқырлы жауынгер
Dialogue: 0,0:14:18.65,0:14:21.11,Default,,0,0,0,,Ол біз үшін міндетті түрде күшке айналады.
Dialogue: 0,0:14:21.19,0:14:22.90,Default,,0,0,0,,Бірақ... Бірақ...
Dialogue: 0,0:14:22.98,0:14:25.36,Default,,0,0,0,,Бұл жеткілікті Йоко (Йоко) Ах.
Dialogue: 0,0:14:25.44,0:14:28.82,Default,,0,0,0,,Маған әсіресе самурай қамқорлық көрсеткенін қаламаймын.
Dialogue: 0,0:14:29.41,0:14:33.03,Default,,0,0,0,,Мен Йоко сұрағандықтан келуден басқа амалым қалмады.
Dialogue: 0,0:14:33.12,0:14:35.12,Default,,0,0,0,,Керек емес десең, кет.
Dialogue: 0,0:14:35.20,0:14:38.79,Default,,0,0,0,,Ал... күте тұр, сенің атың кім?
Dialogue: 0,0:14:38.87,0:14:40.54,Default,,0,0,0,,Бұл Кай Хан.
Dialogue: 0,0:14:43.29,0:14:44.59,Default,,0,0,0,,Кай
Dialogue: 0,0:14:44.67,0:14:46.84,Default,,0,0,0,,Мені таң қалдыратын тағы бір жайттар бар.
Dialogue: 0,0:14:46.92,0:14:48.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:49.09,0:14:50.80,Default,,0,0,0,,Бүгін түн өте...
Dialogue: 0,0:14:55.47,0:14:56.77,Default,,0,0,0,,Не?
Dialogue: 0,0:14:58.52,0:14:59.81,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:00.65,0:15:02.02,Default,,0,0,0,,Бұл жақсы жел.
Dialogue: 0,0:15:05.36,0:15:07.19,Default,,0,0,0,,(Сынған нәрсенің дыбысы)
Dialogue: 0,0:15:07.28,0:15:09.90,Default,,0,0,0,,(Йоконың ауыр тыныс алуы)
Dialogue: 0,0:15:09.99,0:15:13.87,Default,,0,0,0,,А... бұл қауіпті болды, мен сол жерде болдым...
Dialogue: 0,0:15:18.54,0:15:19.66,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:20.25,0:15:24.75,Default,,0,0,0,,Тым болмаса тағы... онда...
Dialogue: 0,0:15:26.75,0:15:31.13,Default,,0,0,0,,Құрметті Ынви, әрбір жетек жүйесі мен қаруда ешқандай проблема жоқ.
Dialogue: 0,0:15:31.63,0:15:33.68,Default,,0,0,0,,Ертең таңертең, күн шыққанда жолға шығыңыз
Dialogue: 0,0:15:33.76,0:15:35.85,Default,,0,0,0,,Жоқ, мен қазір кетемін.
Dialogue: 0,0:15:35.93,0:15:37.56,Default,,0,0,0,,Қазір ме?
Dialogue: 0,0:15:37.64,0:15:39.98,Default,,0,0,0,,Лорд Калдың білімі абсолютті.
Dialogue: 0,0:15:40.06,0:15:43.61,Default,,0,0,0,,Басқа жын генералдары да жүзуге дайындалуы керек.
Dialogue: 0,0:15:43.69,0:15:44.86,Default,,0,0,0,,артта қалмаңыз
Dialogue: 0,0:15:44.94,0:15:45.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:49.78,0:15:52.24,Default,,0,0,0,,Пломба ақыры бұзылды
Dialogue: 0,0:15:52.32,0:15:55.99,Default,,0,0,0,,Жою құдайы Антрасакс қайта тіріледі.
Dialogue: 0,0:16:06.67,0:16:10.05,Default,,0,0,0,,Барлығы ұйықтап қалған сияқты~
Dialogue: 0,0:16:10.59,0:16:12.68,Default,,0,0,0,,Йоко-санның сол сезімі
Dialogue: 0,0:16:12.76,0:16:14.68,Default,,0,0,0,,Мен бүгін түнде құлаймын!
Dialogue: 0,0:16:14.76,0:16:17.89,Default,,0,0,0,,Мен түнде жасырын кіріп, Йоко-санға соңғы соққыны беремін.
Dialogue: 0,0:16:17.97,0:16:22.85,Default,,0,0,0,,Хахаха~ха мен сені сүйемін, Йоко-сан~
Dialogue: 0,0:16:23.52,0:16:25.81,Default,,0,0,0,,Осы түнде менің махаббатыммен...
Dialogue: 0,0:16:25.90,0:16:30.78,Default,,0,0,0,,Мен Йоко-санның пирогын жұлып алып, саған беремін~
Dialogue: 0,0:16:30.86,0:16:35.24,Default,,0,0,0,,Ух... у... а...
Dialogue: 0,0:16:35.32,0:16:38.53,Default,,0,0,0,,Әй, бұл тағы да арман.
Dialogue: 0,0:16:41.20,0:16:44.58,Default,,0,0,0,,Кант ғибадатханасында емделу кезінде бірнеше рет көрген түс.
Dialogue: 0,0:16:47.71,0:16:50.42,Default,,0,0,0,,А, а... тоқтат.
Dialogue: 0,0:16:50.51,0:16:51.88,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:16:52.67,0:16:56.55,Default,,0,0,0,,А-а... А-а... А-а-а...
Dialogue: 0,0:16:56.64,0:16:59.51,Default,,0,0,0,,Ах! Міне... мінекей...
Dialogue: 0,0:16:59.60,0:17:03.23,Default,,0,0,0,,Бұл кім? бұл адам
Dialogue: 0,0:17:03.85,0:17:04.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:05.06,0:17:06.69,Default,,0,0,0,,Куку куку
Dialogue: 0,0:17:07.65,0:17:10.65,Default,,0,0,0,,Бұл жақсы сезіне ме?
Dialogue: 0,0:17:10.73,0:17:15.57,Default,,0,0,0,,Олай болса, мен саған қазір соңғы соққыны беремін.
Dialogue: 0,0:17:15.66,0:17:16.49,Default,,0,0,0,,Ха...
Dialogue: 0,0:17:17.53,0:17:18.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:18.99,0:17:20.37,Default,,0,0,0,,Жоқ... тоқта...
Dialogue: 0,0:17:20.45,0:17:22.45,Default,,0,0,0,,Ах ха...
Dialogue: 0,0:17:22.54,0:17:25.54,Default,,0,0,0,,Жоқ... жоқ, мен қарсы тұра алмаймын.
Dialogue: 0,0:17:26.42,0:17:30.88,Default,,0,0,0,,Менің денем ыстық! Бұл... тек осылай қал...
Dialogue: 0,0:17:32.38,0:17:33.76,Default,,0,0,0,,Га
Dialogue: 0,0:17:33.84,0:17:36.22,Default,,0,0,0,,Эмма!
Dialogue: 0,0:17:36.30,0:17:39.60,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:39.68,0:17:40.51,Default,,0,0,0,,Ах
Dialogue: 0,0:17:40.60,0:17:42.97,Default,,0,0,0,,Не? Сіз бе?
Dialogue: 0,0:17:43.06,0:17:45.94,Default,,0,0,0,,Мен оны Йоко-санның бөлмесімен қателесіп алдым деп ойлаймын.
Dialogue: 0,0:17:46.02,0:17:48.94,Default,,0,0,0,,Кукукуку, жарай ма?
Dialogue: 0,0:17:49.02,0:17:51.07,Default,,0,0,0,,Бар болғанша алайық.
Dialogue: 0,0:17:51.15,0:17:52.61,Default,,0,0,0,,Не!
Dialogue: 0,0:17:52.69,0:17:53.57,Default,,0,0,0,,Сендер-ай, шіркін!
Dialogue: 0,0:17:53.65,0:17:55.53,Default,,0,0,0,,Иә
Dialogue: 0,0:17:55.61,0:17:59.16,Default,,0,0,0,,Егер есімде дұрыс болса, сіз маған екі нәрсеге қарыз болдыңыз.
Dialogue: 0,0:17:59.24,0:18:00.07,Default,,0,0,0,,Ах
Dialogue: 0,0:18:00.16,0:18:02.41,Default,,0,0,0,,Қаласаң мені өлтіре аласың.
Dialogue: 0,0:18:02.49,0:18:05.46,Default,,0,0,0,,Мен сенімен әлі ұрысқан жоқпын.
Dialogue: 0,0:18:05.54,0:18:08.67,Default,,0,0,0,,Кукукуку ух... кук...
Dialogue: 0,0:18:08.75,0:18:10.84,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:18:10.92,0:18:14.01,Default,,0,0,0,,Сіз қарызыңызды дұрыс өтеуіңіз керек, солай ма?
Dialogue: 0,0:18:14.09,0:18:16.34,Default,,0,0,0,,Хмм? Адам ретінде
Dialogue: 0,0:18:16.97,0:18:20.18,Default,,0,0,0,,Оны қалай қайтаруға болады?
Dialogue: 0,0:18:20.26,0:18:22.89,Default,,0,0,0,,Иә, шешілді.
Dialogue: 0,0:18:23.72,0:18:26.85,Default,,0,0,0,,«Сумо» сумосы! Мен мұны істеймін!
Dialogue: 0,0:18:26.93,0:18:29.77,Default,,0,0,0,,Ах, а, а...
Dialogue: 0,0:18:29.85,0:18:31.23,Default,,0,0,0,,Да... жоқ!
Dialogue: 0,0:18:31.31,0:18:35.44,Default,,0,0,0,,Йо... Оны Йоко естиді.
Dialogue: 0,0:18:35.53,0:18:37.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:37.86,0:18:40.95,Default,,0,0,0,,Гуха (Йоко) Ей, бейбақ!
Dialogue: 0,0:18:41.03,0:18:42.62,Default,,0,0,0,,Жо… Жо…
Dialogue: 0,0:18:42.70,0:18:44.29,Default,,0,0,0,,Йоко-сан!
Dialogue: 0,0:18:44.95,0:18:47.21,Default,,0,0,0,,Сіз ер адамсыз ба?
Dialogue: 0,0:18:47.29,0:18:51.71,Default,,0,0,0,,«10 миллиард өлімнен артық» деген не?
Dialogue: 0,0:18:51.79,0:18:55.17,Default,,0,0,0,,Ха ха ха хаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:18:55.25,0:18:58.84,Default,,0,0,0,,Бұл не? А, өте шулы
Dialogue: 0,0:19:00.97,0:19:03.85,Default,,0,0,0,,Егер сіз көршіңізді тым шулы деп ойласаңыз!
Dialogue: 0,0:19:03.93,0:19:07.81,Default,,0,0,0,,Кайға не істемек болдың!
Dialogue: 0,0:19:07.89,0:19:09.64,Default,,0,0,0,,Кан Кан Кан
Dialogue: 0,0:19:09.73,0:19:12.44,Default,,0,0,0,,Мынау... бұл Кайдың жатын бөлмесі!
Dialogue: 0,0:19:12.52,0:19:16.53,Default,,0,0,0,,А... не істеп жатырсың!?
Dialogue: 0,0:19:16.61,0:19:18.90,Default,,0,0,0,,Тек Йоко емес, тіпті Кай!
Dialogue: 0,0:19:18.99,0:19:20.24,Default,,0,0,0,,Мен сені енді кешіре алмаймын!
Dialogue: 0,0:19:20.32,0:19:21.53,Default,,0,0,0,,Кан Кан Кан
Dialogue: 0,0:19:21.61,0:19:25.66,Default,,0,0,0,,А, бұлай болуы мүмкін емес, Джошуа, біз Вайды және басқаларды тоқтатуымыз керек...
Dialogue: 0,0:19:25.74,0:19:28.00,Default,,0,0,0,,Ешуа!
Dialogue: 0,0:19:28.08,0:19:30.58,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:19:30.67,0:19:32.71,Default,,0,0,0,,Ол да тез жүгіреді.
Dialogue: 0,0:19:32.79,0:19:36.34,Default,,0,0,0,,Люси-кун баяу болса да.
Dialogue: 0,0:19:36.42,0:19:38.30,Default,,0,0,0,,Ах... Йоко
Dialogue: 0,0:19:38.38,0:19:40.93,Default,,0,0,0,,Шындығында, бұл... қазір...
Dialogue: 0,0:19:41.01,0:19:42.64,Default,,0,0,0,,Жоқ, абай болу керек!
Dialogue: 0,0:19:42.72,0:19:43.76,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:19:45.51,0:19:47.60,Default,,0,0,0,,Кай әдемі
Dialogue: 0,0:19:47.68,0:19:50.43,Default,,0,0,0,,Ер адамдар барлығын нысанаға алады.
Dialogue: 0,0:19:50.52,0:19:51.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:52.90,0:19:55.11,Default,,0,0,0,,Ешқандай адам жоқ!
Dialogue: 0,0:19:55.19,0:19:56.94,Default,,0,0,0,,Аузыңызбен тәтті сөздер айтыңыз
Dialogue: 0,0:19:57.02,0:19:58.73,Default,,0,0,0,,Қыз: Менің бар болғаны жеңіл тамақ жегім келеді.
Dialogue: 0,0:19:58.82,0:20:00.28,Default,,0,0,0,,Өйткені бұл менің басымда емес
Dialogue: 0,0:20:00.36,0:20:04.62,Default,,0,0,0,,Егер сіз еркекті осылай кешірсеңіз... бұл шын мәнінде әйел ретінде сіз үшін ақырзаман.
Dialogue: 0,0:20:04.70,0:20:06.08,Default,,0,0,0,,Лас!
Dialogue: 0,0:20:07.74,0:20:08.91,Default,,0,0,0,,Иә
Dialogue: 0,0:20:10.20,0:20:12.96,Default,,0,0,0,,О, мүлде.
Dialogue: 0,0:20:16.54,0:20:19.51,Default,,0,0,0,,Сәлем! Самурайдың фукуро киюі дұрыс па?
Dialogue: 0,0:20:19.59,0:20:21.59,Default,,0,0,0,,Жоқ... үндеме! Иә... Иә!
Dialogue: 0,0:20:21.67,0:20:23.22,Default,,0,0,0,,Не болды, Джошуа?
Dialogue: 0,0:20:24.64,0:20:27.43,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:20:30.43,0:20:32.52,Default,,0,0,0,,Биіктік пен бағытты растау
Dialogue: 0,0:20:33.85,0:20:35.81,Default,,0,0,0,,Ауа ішілік қысым қалыпты
Dialogue: 0,0:20:42.24,0:20:44.20,Default,,0,0,0,,Барлық кемелер қалыпты қозғалыста
Dialogue: 0,0:20:45.03,0:20:48.37,Default,,0,0,0,,Лорд Ынви Мен алда найзағай бұлттарын көріп тұрмын.
Dialogue: 0,0:20:48.45,0:20:50.49,Default,,0,0,0,,Дауыл аймағы жақындап келеді
Dialogue: 0,0:20:50.58,0:20:52.41,Default,,0,0,0,,Айналмалы жолмен жүргіңіз келе ме? (Ынви) Жоқ!
Dialogue: 0,0:20:52.50,0:20:55.83,Default,,0,0,0,,Бүкіл жындар соғысы генералымен бірге үлкен экспедицияның ортасында
Dialogue: 0,0:20:55.92,0:20:59.30,Default,,0,0,0,,Бұл жоспары сонша, олар тіпті жолбарыс дирижабльдерін жіберді.
Dialogue: 0,0:20:59.80,0:21:03.01,Default,,0,0,0,,Біз межелі жерге мүмкіндігінше тез жетуіміз керек.
Dialogue: 0,0:21:05.47,0:21:07.39,Default,,0,0,0,,Бұл «Әлемнің көзі»
Dialogue: 0,0:21:07.47,0:21:11.14,Default,,0,0,0,,Өйткені соңғы мөр бізді ұйықтайтын жерге апарады.
Dialogue: 0,0:21:12.31,0:21:14.77,Default,,0,0,0,,Мен Yngwie кемесінен телепатия алдым.
Dialogue: 0,0:21:14.85,0:21:16.27,Default,,0,0,0,,«Барлық кемелер, тура алға!»
Dialogue: 0,0:21:16.35,0:21:19.98,Default,,0,0,0,,Хмм, Ынвиден артта қалма!
Dialogue: 0,0:21:20.07,0:21:22.86,Default,,0,0,0,,Дауылды жеңеміз! Алға ұмтыл!
Dialogue: 0,0:21:22.94,0:21:23.95,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:24.03,0:21:26.61,Default,,0,0,0,,Аа, шындықты елемеу
Dialogue: 0,0:21:26.70,0:21:29.91,Default,,0,0,0,,Заң сақшысы болып көрінетін самурайлар
Dialogue: 0,0:21:29.99,0:21:32.91,Default,,0,0,0,,Хехе, ең көбі жерде
Dialogue: 0,0:21:33.00,0:21:36.37,Default,,0,0,0,,Тек лас деми-адамдармен айналысыңыз.
Dialogue: 0,0:21:36.46,0:21:38.88,Default,,0,0,0,,Тіпті бұл Дирк Шнайдер болса да
Dialogue: 0,0:21:38.96,0:21:41.34,Default,,0,0,0,,Біз енді ешқашан жете алмаймыз
Dialogue: 0,0:21:41.42,0:21:42.80,Default,,0,0,0,,Ұзақ қашықтыққа ұшуда
Dialogue: 0,0:21:42.88,0:21:45.34,Default,,0,0,0,,Демалыс қажет емес, дирижабльмен салыстыруға болады⸺
Dialogue: 0,0:21:45.42,0:21:49.10,Default,,0,0,0,,Ұшатын тіршілік иелері жоқ шығар.
Dialogue: 0,0:21:49.18,0:21:54.68,Default,,0,0,0,,Сібірдіктің соңғы мөрі, бүкіл әлемді тазартатын жойылу құдайы.
Dialogue: 0,0:21:54.77,0:21:58.40,Default,,0,0,0,,Бұл мөр Мета-Ликана патшалығының бұрынғы ханшайымы.
Dialogue: 0,0:21:58.48,0:22:02.90,Default,,0,0,0,,Біз оның Шейла Тоэль Мета-Ликана денесінің ішінде екенін білеміз.
Dialogue: 0,0:22:02.98,0:22:06.90,Default,,0,0,0,,Ішің ашылып кетсе де сүйреп шығарамын!
Dialogue: 0,0:22:07.57,0:22:08.74,Default,,0,0,0,,Мақсат
Dialogue: 0,0:22:08.82,0:22:11.33,Default,,0,0,0,,Оның қайда екенін ешкім білмеді⸺
Dialogue: 0,0:22:11.41,0:22:13.95,Default,,0,0,0,,Зерттелмеген, аңызға айналған зерттелмеген аймақ
Dialogue: 0,0:22:14.62,0:22:18.75,Default,,0,0,0,,Жоғалған Эльф-Сити патшасының Қызыл даңқы!
Dialogue: 0,0:22:21.00,0:22:23.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:47.84,0:23:49.84,Default,,0,0,0,,～♪
