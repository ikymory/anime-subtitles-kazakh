Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.63,0:00:17.85,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:00:28.52,0:00:29.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:30.57,0:00:32.69,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:00:33.19,0:00:35.41,Default,,0,0,0,,Сіздің құрбандықыңыз үшін
Dialogue: 0,0:00:36.36,0:00:39.74,Default,,0,0,0,,Бұл ұлы жоспар орындалады
Dialogue: 0,0:00:40.95,0:00:42.79,Default,,0,0,0,,Маған олай қарама.
Dialogue: 0,0:00:44.37,0:00:45.46,Default,,0,0,0,,Мен қазір кетемін...
Dialogue: 0,0:00:45.54,0:00:46.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:48.38,0:00:50.92,Default,,0,0,0,,Ой... а
Dialogue: 0,0:00:53.13,0:00:54.22,Default,,0,0,0,,Уф аааа...
Dialogue: 0,0:00:54.30,0:00:55.76,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:00:55.84,0:00:56.93,Default,,0,0,0,,Һм? Бұл не?
Dialogue: 0,0:00:57.05,0:00:58.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:58.55,0:00:59.72,Default,,0,0,0,,Умм...
Dialogue: 0,0:01:00.97,0:01:02.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:03.39,0:01:06.10,Default,,0,0,0,,Не! Бұл жерде күлкілі ештеңе жоқ!
Dialogue: 0,0:01:06.90,0:01:09.56,Default,,0,0,0,,Кешіріңіз, оған көмектесу мүмкін емес.
Dialogue: 0,0:01:09.94,0:01:14.53,Default,,0,0,0,,Бұл ұлы жоспар тек сіздің құрбандығыңыз арқылы жүзеге асады.
Dialogue: 0,0:01:15.24,0:01:16.70,Default,,0,0,0,,Өйткені
Dialogue: 0,0:01:17.32,0:01:20.12,Default,,0,0,0,,Хехехе, мені кешіріңізші.
Dialogue: 0,0:01:20.45,0:01:22.54,Default,,0,0,0,,Сары мырза
Dialogue: 0,0:01:22.95,0:01:24.95,Default,,0,0,0,,(Газдың ағу дыбысы)
Dialogue: 0,0:01:25.75,0:01:27.58,Default,,0,0,0,,Енді басынан бастап...
Dialogue: 0,0:01:29.04,0:01:31.88,Default,,0,0,0,,Хидео, бірге... аа...
Dialogue: 0,0:01:32.17,0:01:34.55,Default,,0,0,0,,Кей… жазу…
Dialogue: 0,0:01:35.67,0:01:37.05,Default,,0,0,0,,Биыл ғана дебют жасаған –
Dialogue: 0,0:01:39.30,0:01:42.85,Default,,0,0,0,,Накама... аааа
Dialogue: 0,0:01:45.18,0:01:48.56,Default,,0,0,0,,1 кезең Химия эксперименті аяқталды
Dialogue: 0,0:01:48.69,0:01:51.69,Default,,0,0,0,,2-кезең Адамгершілік уақыты Хэхе
Dialogue: 0,0:01:52.48,0:01:55.40,Default,,0,0,0,,Мен сені аяймын! Хахаха
Dialogue: 0,0:01:55.94,0:01:58.61,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:02:03.20,0:02:09.21,Default,,0,0,0,,♪〜
Dialogue: 0,0:02:12.09,0:02:18.09,Default,,0,0,0,,〜♪
Dialogue: 0,0:02:18.26,0:02:25.27,Default,,0,0,0,,Косэй тағы да күйреуге ұшырайды.
Dialogue: 0,0:02:26.81,0:02:28.73,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:02:28.81,0:02:30.52,Default,,0,0,0,,Күтілгендей, бұл керемет! (қол шапалақтау)
Dialogue: 0,0:02:30.60,0:02:31.90,Default,,0,0,0,,Хмм хмм
Dialogue: 0,0:02:32.27,0:02:33.86,Default,,0,0,0,,Үйде қолөнерші болып жұмыс істегеннен гөрі
Dialogue: 0,0:02:33.98,0:02:36.44,Default,,0,0,0,,Скрипкашы болған дұрыс емес пе?
Dialogue: 0,0:02:37.74,0:02:40.32,Default,,0,0,0,,Мен қалпына келтіруді ұнатамын.
Dialogue: 0,0:02:41.03,0:02:46.08,Default,,0,0,0,,Шынымен бе? Мен оны осы жердегі профессионалдардан әлдеқайда жақсы ойнай алатын сияқтымын.
Dialogue: 0,0:02:46.74,0:02:48.00,Default,,0,0,0,,Өйткені бұл жақсы...
Dialogue: 0,0:02:48.96,0:02:51.08,Default,,0,0,0,,Өйткені бұл Гальяно.
Dialogue: 0,0:02:51.92,0:02:54.84,Default,,0,0,0,,Бұл 300 жыл бұрынғы жұмыс, солай ма?
Dialogue: 0,0:02:55.13,0:02:58.76,Default,,0,0,0,,Оның үстіне ол жай ғана сақталып қалмады, ұқыпты пайдаланылды.
Dialogue: 0,0:02:59.55,0:03:02.76,Default,,0,0,0,,Қалпына келтіру кезінде ол бүгінгі күнге дейін жеткізілді.
Dialogue: 0,0:03:04.85,0:03:07.93,Default,,0,0,0,,Менің ойымша, бұл өте керемет.
Dialogue: 0,0:03:09.18,0:03:12.10,Default,,0,0,0,,Аа, егер сіз бұл туралы ойласаңыз, бұл керемет болуы мүмкін.
Dialogue: 0,0:03:12.19,0:03:14.06,Default,,0,0,0,,Егер сізге бұйырса не істейсіз?
Dialogue: 0,0:03:14.86,0:03:17.07,Default,,0,0,0,,Қорғалған және мұраға қалған өмірлер
Dialogue: 0,0:03:17.40,0:03:20.74,Default,,0,0,0,,Қалпына келтіру, оны келесі 300 жылға қалдыруға болады
Dialogue: 0,0:03:21.86,0:03:24.12,Default,,0,0,0,,Керемет жұмыс сияқты.
Dialogue: 0,0:03:26.28,0:03:27.45,Default,,0,0,0,,Мен өлсем де...
Dialogue: 0,0:03:27.87,0:03:29.62,Default,,0,0,0,,Менің сезімдерім өмір сүре береді
Dialogue: 0,0:03:30.25,0:03:32.29,Default,,0,0,0,,Керемет! Жақсы айтылған!
Dialogue: 0,0:03:32.37,0:03:34.38,Default,,0,0,0,,Шебер болу дегеннің не екенін түсін!
Dialogue: 0,0:03:34.46,0:03:37.96,Default,,0,0,0,,Детектив мамандығын таңдау ақымақ қыз болудан мүлде бөлек!
Dialogue: 0,0:03:38.13,0:03:40.30,Default,,0,0,0,,Сен менің мақтанатын жалғыз ұлымсың!
Dialogue: 0,0:03:40.38,0:03:41.84,Default,,0,0,0,,Жоқ, менің ұлым менікі.
Dialogue: 0,0:03:42.59,0:03:43.59,Default,,0,0,0,,Рұқсат етілмейді!
Dialogue: 0,0:03:45.30,0:03:46.64,Default,,0,0,0,,«Маркет-мейкер»
Dialogue: 0,0:03:46.76,0:03:49.89,Default,,0,0,0,,«Қылмыс пен соғысты ұйымдастыратын жұмбақ топ»
Dialogue: 0,0:03:50.52,0:03:55.69,Default,,0,0,0,,«Патша әулетінің нұсқауы бойынша жасырын операцияларды, өлтіруді, жоюды және инфильтрацияны жүргізу».
Dialogue: 0,0:03:55.86,0:03:58.11,Default,,0,0,0,,«Жеке адамның немесе топтың аты»
Dialogue: 0,0:03:58.52,0:04:00.82,Default,,0,0,0,,«Мүшелердің оң қолдарында бас сүйектері ойылған».
Dialogue: 0,0:04:00.90,0:04:03.78,Default,,0,0,0,,«Оны ешкім көрген жоқ».
Dialogue: 0,0:04:04.99,0:04:08.28,Default,,0,0,0,,«Тарих кітаптарында әрең аталмаған жұмбақ ұйым».
Dialogue: 0,0:04:09.16,0:04:11.04,Default,,0,0,0,,Бұл рас па? Каэла
Dialogue: 0,0:04:11.75,0:04:13.21,Default,,0,0,0,,Жоқ~
Dialogue: 0,0:04:13.83,0:04:15.92,Default,,0,0,0,,Мені мұнда әдейі шақырған кім?
Dialogue: 0,0:04:16.00,0:04:19.25,Default,,0,0,0,,Бұл сұмдық, бұл жалған мақала. Бұл жай ғана шоу үшін емес, солай емес пе?
Dialogue: 0,0:04:19.34,0:04:20.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:20.88,0:04:22.38,Default,,0,0,0,,Оқиға орнына барайық~ Бран
Dialogue: 0,0:04:32.60,0:04:34.23,Default,,0,0,0,,Іздері әлсіз.
Dialogue: 0,0:04:34.52,0:04:35.35,Default,,0,0,0,,(Ранпа) Зұлымдар Альянсы, иә? Тамаша! Кел, байқап көрейік!
Dialogue: 0,0:04:35.65,0:04:36.98,Default,,0,0,0,,Өшуге жақын.
Dialogue: 0,0:04:38.31,0:04:39.19,Default,,0,0,0,,Бастық туралы не деуге болады?
Dialogue: 0,0:04:39.27,0:04:40.94,Default,,0,0,0,,Мен жаңа ғана жоғарыға көтерілдім.
Dialogue: 0,0:04:41.03,0:04:41.86,Default,,0,0,0,,О
Dialogue: 0,0:04:41.94,0:04:43.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:44.28,0:04:45.99,Default,,0,0,0,,Ах~ Не істеп жатырсың?
Dialogue: 0,0:04:46.07,0:04:49.12,Default,,0,0,0,,Кісі өлтіру орындарына бейбіт тұрғындарды қосу заңсыз емес пе?
Dialogue: 0,0:04:49.62,0:04:52.41,Default,,0,0,0,,Жоқ, бұл адам... сол
Dialogue: 0,0:04:53.04,0:04:55.79,Default,,0,0,0,,Сіз... не істеп жатқаныңызды білесіз бе?
Dialogue: 0,0:04:56.33,0:04:57.38,Default,,0,0,0,,Уау
Dialogue: 0,0:04:59.96,0:05:02.92,Default,,0,0,0,,Ақырында сіз бұрынғы күйіңізге оралдыңыз ба?
Dialogue: 0,0:05:04.38,0:05:05.93,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,0:05:07.72,0:05:11.31,Default,,0,0,0,,Өлтірілген депутат бітпейтін өсек-аяңға толы адам болған.
Dialogue: 0,0:05:12.47,0:05:13.68,Default,,0,0,0,,Тіпті соңғы жаңалықтарда
Dialogue: 0,0:05:13.77,0:05:17.35,Default,,0,0,0,,Корпорациялардың заңсыз қайырымдылықтары мәселесі енді ғана қызу тақырыпқа айналды.
Dialogue: 0,0:05:18.27,0:05:20.65,Default,,0,0,0,,Сондықтан да оны нысанаға алған болуы керек.
Dialogue: 0,0:05:21.11,0:05:24.28,Default,,0,0,0,,Тағы бір «түсінбеген сегізаяқ шошқа жігіті»?
Dialogue: 0,0:05:24.49,0:05:26.49,Default,,0,0,0,,Сұмдық Шиору~
Dialogue: 0,0:05:26.86,0:05:29.20,Default,,0,0,0,,Отбасыңа бұлай жасамасаң жақсы...
Dialogue: 0,0:05:31.16,0:05:32.20,Default,,0,0,0,,Сегізаяқ...
Dialogue: 0,0:05:32.87,0:05:34.79,Default,,0,0,0,,Өйткені сөз тіркесі әр кезде сәл өзгеше
Dialogue: 0,0:05:35.00,0:05:36.21,Default,,0,0,0,,Ол жабыспайды.
Dialogue: 0,0:05:36.29,0:05:37.21,Default,,0,0,0,,Сіз қателесесіз бе?
Dialogue: 0,0:05:37.29,0:05:38.79,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:05:39.04,0:05:40.88,Default,,0,0,0,,Сууу ха~
Dialogue: 0,0:05:41.21,0:05:43.13,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:05:43.21,0:05:45.59,Default,,0,0,0,,Өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:05:45.67,0:05:47.80,Default,,0,0,0,,Бұл өлтіруші В ісі емес.
Dialogue: 0,0:05:47.88,0:05:48.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:49.26,0:05:50.43,Default,,0,0,0,,Ненің негізінде?
Dialogue: 0,0:05:50.93,0:05:53.60,Default,,0,0,0,,Расында, әдеттегідей таңба қалды.
Dialogue: 0,0:05:54.10,0:05:56.39,Default,,0,0,0,,Кит, сен неге олай ойлайсың?
Dialogue: 0,0:05:56.48,0:05:58.94,Default,,0,0,0,,Хмм, әр түрлі
Dialogue: 0,0:05:59.60,0:06:02.69,Default,,0,0,0,,Оны аздап нақтырақ түсіндіре аласыз ба?
Dialogue: 0,0:06:02.90,0:06:04.07,Default,,0,0,0,,Бұрыштар аңғал емес
Dialogue: 0,0:06:04.73,0:06:06.53,Default,,0,0,0,,Бұл адам не айтып тұр?
Dialogue: 0,0:06:06.61,0:06:09.53,Default,,0,0,0,,Мен Гени тілін шынымен түсінбеймін.
Dialogue: 0,0:06:10.03,0:06:11.45,Default,,0,0,0,,Эрик, бір секундқа осында кел.
Dialogue: 0,0:06:12.33,0:06:13.53,Default,,0,0,0,,Мен сенің көргеніңді қалаймын.
Dialogue: 0,0:06:26.84,0:06:28.72,Default,,0,0,0,,Одан жақын келме. Уа... Иә.
Dialogue: 0,0:06:29.43,0:06:31.76,Default,,0,0,0,,Кит Бұл мүмкін бе...
Dialogue: 0,0:06:33.47,0:06:34.56,Default,,0,0,0,,О
Dialogue: 0,0:06:40.44,0:06:41.77,Default,,0,0,0,,Бұл қиын...
Dialogue: 0,0:06:42.81,0:06:44.82,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:06:45.48,0:06:48.90,Default,,0,0,0,,Бұл дененің улы газбен өлгені анық.
Dialogue: 0,0:06:49.20,0:06:52.82,Default,,0,0,0,,Сонымен қатар, жүйке газдары мен эрозиялық агенттерден туындаған белгілер пайда болады.
Dialogue: 0,0:06:55.79,0:06:59.50,Default,,0,0,0,,Кінәлі әр мінездемені аралас газбен жасаған шығар.
Dialogue: 0,0:07:00.21,0:07:04.29,Default,,0,0,0,,Нерв газы сияқты тез әсер ететін де, көпіршікті агент сияқты баяу әрекет ететін де емес.
Dialogue: 0,0:07:05.29,0:07:08.17,Default,,0,0,0,,Оны жасаған жігіттің мінезі өте жақсы.
Dialogue: 0,0:07:09.09,0:07:12.14,Default,,0,0,0,,Мен басқа адамды қинап, сосын өлтіруім керек сияқты.
Dialogue: 0,0:07:12.39,0:07:14.10,Default,,0,0,0,,Ол қатты және анық өтіп жатыр
Dialogue: 0,0:07:18.31,0:07:20.02,Default,,0,0,0,,Сонымен, қарсы шаралар қандай?
Dialogue: 0,0:07:20.48,0:07:22.56,Default,,0,0,0,,Қарапайым тілмен айтқанда... жоқ
Dialogue: 0,0:07:24.06,0:07:27.73,Default,,0,0,0,,Егер ол бар газ болса, кейбір қарсы шаралар бар.
Dialogue: 0,0:07:28.15,0:07:30.45,Default,,0,0,0,,Бұл жақсартулары бар жаңа үлгі.
Dialogue: 0,0:07:31.36,0:07:33.53,Default,,0,0,0,,Біз Армия медициналық ғылыми-зерттеу институтынан ынтымақтастықты сұрадық.
Dialogue: 0,0:07:34.87,0:07:38.83,Default,,0,0,0,,Біз сенімді бейтараптандыру агентін жасау үшін қанша уақыт кететінін білмейміз.
Dialogue: 0,0:07:39.66,0:07:41.54,Default,,0,0,0,,Мұнда қандай жол салуға болмайды?
Dialogue: 0,0:07:42.67,0:07:45.50,Default,,0,0,0,,Мен сізге әлі де жақсырақ профилактикалық дәрі бере аламын.
Dialogue: 0,0:07:45.59,0:07:46.88,Default,,0,0,0,,Жай дайындаңыз.
Dialogue: 0,0:07:48.25,0:07:49.17,Default,,0,0,0,,Бұл қаншалықты тиімді?
Dialogue: 0,0:07:49.26,0:07:50.09,Default,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:07:50.59,0:07:51.63,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:52.18,0:07:53.13,Default,,0,0,0,,Мен оны ешқашан салған емеспін
Dialogue: 0,0:07:53.22,0:07:55.43,Default,,0,0,0,,Оның тиімді немесе тиімсіз екенін білудің ешқандай жолы жоқ.
Dialogue: 0,0:07:55.93,0:07:57.60,Default,,0,0,0,,Ықтималдық тұрғысынан айту керек пе?
Dialogue: 0,0:07:58.93,0:08:00.14,Default,,0,0,0,,Мен бүгін бас тартамын.
Dialogue: 0,0:08:00.77,0:08:02.94,Default,,0,0,0,,Санмен айтсам, үмітім үзілетіндей болады.
Dialogue: 0,0:08:03.39,0:08:06.15,Default,,0,0,0,,Менің ойымша, бұл нөл емес болғандықтан, бұл таң қалдырады, солай ма?
Dialogue: 0,0:08:07.86,0:08:10.57,Default,,0,0,0,,«Дәрігер» деп әлі солай айтасыз.
Dialogue: 0,0:08:10.94,0:08:15.07,Default,,0,0,0,,Егер сізге ұнамаса, қылмыскер сізге газ қолданбас бұрын ұстаңыз.
Dialogue: 0,0:08:15.16,0:08:16.57,Default,,0,0,0,,Эрикке айтыңыз
Dialogue: 0,0:08:17.03,0:08:18.49,Default,,0,0,0,,Түсінген дәрігер
Dialogue: 0,0:08:19.74,0:08:20.58,Default,,0,0,0,,Гени
Dialogue: 0,0:08:22.79,0:08:24.21,Default,,0,0,0,,Сіз әлі іздеп жүрсіз бе?
Dialogue: 0,0:08:25.25,0:08:26.79,Default,,0,0,0,,Жеті жыл болды.
Dialogue: 0,0:08:27.38,0:08:29.46,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:08:30.84,0:08:32.34,Default,,0,0,0,,Мен әлі білмеймін
Dialogue: 0,0:08:32.59,0:08:33.59,Default,,0,0,0,,Егер
Dialogue: 0,0:08:34.88,0:08:38.89,Default,,0,0,0,,Бірақ... Мен қылмыскерге жетелейтін із таптым.
Dialogue: 0,0:08:47.61,0:08:50.94,Default,,0,0,0,,Мұны мэр өлтірілген кеңесшіге жіберді -
Dialogue: 0,0:08:51.03,0:08:53.07,Default,,0,0,0,,Бұл қайырымдылық кешіне шақыру.
Dialogue: 0,0:08:53.53,0:08:55.82,Default,,0,0,0,,Бұл олардың соны мақсат еткені туралы ескерту болды ма?
Dialogue: 0,0:08:56.07,0:08:57.41,Default,,0,0,0,,Тегіс сызық жоқ па?
Dialogue: 0,0:08:58.37,0:09:00.99,Default,,0,0,0,,Мәйітпен бірге қалған қорапты зерттегеннен кейін.
Dialogue: 0,0:09:01.58,0:09:03.20,Default,,0,0,0,,Ішінде болған ыдыстан
Dialogue: 0,0:09:03.33,0:09:07.00,Default,,0,0,0,,Аз мөлшерде болса да нағыз улы газ анықталды
Dialogue: 0,0:09:07.33,0:09:10.88,Default,,0,0,0,,Корольдік медицина институтының зерттеу есебіне сәйкес
Dialogue: 0,0:09:11.09,0:09:14.34,Default,,0,0,0,,Бұл өте күшті өлтіру қабілеті бар жаңа модель сияқты.
Dialogue: 0,0:09:14.97,0:09:18.30,Default,,0,0,0,,Кеш өтетін жерде олай емес.
Dialogue: 0,0:09:18.59,0:09:20.60,Default,,0,0,0,,Бүкіл аймаққа әсер етеді
Dialogue: 0,0:09:21.60,0:09:25.18,Default,,0,0,0,,Ауа райы жағдайына байланысты миллиондаған құрбандар болуы мүмкін.
Dialogue: 0,0:09:25.77,0:09:29.06,Default,,0,0,0,,Бірақ кінәлі қайда? Бұл қорқынышты газ.
Dialogue: 0,0:09:29.15,0:09:30.06,Default,,0,0,0,,Түсіндіңіз.
Dialogue: 0,0:09:30.98,0:09:33.78,Default,,0,0,0,,Ол жерде ештеңе сатпайды деп ойлаймын.
Dialogue: 0,0:09:34.69,0:09:39.57,Default,,0,0,0,,Шатырдан табылған жәбірленуші Ян Рейс, 42 жастағы ер адам.
Dialogue: 0,0:09:39.78,0:09:42.58,Default,,0,0,0,,Premium Pharmaceuticals компаниясында бас ғылыми қызметкер болып жұмыс істеді
Dialogue: 0,0:09:43.04,0:09:47.58,Default,,0,0,0,,Алайда оның хабарсыз кеткеніне жарты жыл болды, сондықтан оның отбасы іздестіруді сұрады.
Dialogue: 0,0:09:48.29,0:09:50.38,Default,,0,0,0,,Бұл жігіт мұны жасады...
Dialogue: 0,0:09:50.46,0:09:53.17,Default,,0,0,0,,Ерікті ме, әлде міндетті ме, түсініксіз.
Dialogue: 0,0:09:53.25,0:09:55.63,Default,,0,0,0,,Ол ескіруіне байланысты жойылды ма?
Dialogue: 0,0:09:56.01,0:09:58.76,Default,,0,0,0,,Джонатан барлық қатысы бар Ян Рейстің жолынан тазартуы керек.
Dialogue: 0,0:09:59.47,0:10:00.34,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:00.68,0:10:03.76,Default,,0,0,0,,Каэла тиісті министрліктермен, ғылыми мекемелермен және т.б. байланысады.
Dialogue: 0,0:10:04.22,0:10:09.06,Default,,0,0,0,,Улы газ өндіруге байланысты керек-жарақтарды, жабдықтарды және т.б. ұрлау Жоғалмауын тексеру.
Dialogue: 0,0:10:09.15,0:10:09.98,Default,,0,0,0,,Иә
Dialogue: 0,0:10:10.90,0:10:13.36,Default,,0,0,0,,Марио мен оның достары бүгінгі кешке асығады.
Dialogue: 0,0:10:13.98,0:10:17.99,Default,,0,0,0,,Күдікті адамдар мен заттардың бар-жоғын тексеріп, өткізілетін орынның қауіпсіздігінің жоспарын жасаңыз
Dialogue: 0,0:10:18.86,0:10:21.03,Default,,0,0,0,,Қажетсіз шатастырмау үшін,
Dialogue: 0,0:10:21.16,0:10:24.33,Default,,0,0,0,,Бізге газ мәселесін жария етпеу керектігін айтты.
Dialogue: 0,0:10:24.99,0:10:29.17,Default,,0,0,0,,Хаа~ Бірақ ол осындай көлемдегі ғимаратты түгелдей жаба ала ма деп ойлаймын...
Dialogue: 0,0:10:29.92,0:10:32.63,Default,,0,0,0,,Мм, егер мен сәтсіз болсам...
Dialogue: 0,0:10:33.04,0:10:36.17,Default,,0,0,0,,«Егер» жоқ. Егер жол болмаса, біреуін жасаңыз.
Dialogue: 0,0:10:36.76,0:10:38.63,Default,,0,0,0,,Бұл біздің жұмысымыз
Dialogue: 0,0:10:59.07,0:11:05.91,Default,,0,0,0,,(Радиода ойналатын музыка)
Dialogue: 0,0:11:06.62,0:11:07.66,Default,,0,0,0,,Біз сізге жаңалық әкелеміз.
Dialogue: 0,0:11:07.75,0:11:09.33,Default,,0,0,0,,(ағаш кесу дыбысы)
Dialogue: 0,0:11:09.41,0:11:11.67,Default,,0,0,0,,Бір күні ерте конгрессмен Эд Кайл және оның отбасы
Dialogue: 0,0:11:11.75,0:11:14.13,Default,,0,0,0,,Үйде кісі өлтіру ісіне қатысты
Dialogue: 0,0:11:14.46,0:11:18.51,Default,,0,0,0,,Корольдік полиция өлтіруші В-ның бірқатар қылмыстарға жауапты екенін анықтады.
Dialogue: 0,0:11:19.97,0:11:23.89,Default,,0,0,0,,Біз басқа оқиғалармен байланысын зерттеуді жалғастырамыз.
Dialogue: 0,0:11:24.55,0:11:25.39,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:11:25.47,0:11:26.76,Default,,0,0,0,,Иә? (Лилидің әкесі) Не?
Dialogue: 0,0:11:27.26,0:11:29.89,Default,,0,0,0,,Кешіріңіз, мен оны аздап кесіп тастадым.
Dialogue: 0,0:11:29.98,0:11:31.27,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:11:31.69,0:11:33.40,Default,,0,0,0,,Уау... бұл өте терең.
Dialogue: 0,0:11:34.15,0:11:37.27,Default,,0,0,0,,Бірақ... онша ауыртпайды.
Dialogue: 0,0:11:38.48,0:11:39.99,Default,,0,0,0,,Йошитто~
Dialogue: 0,0:11:42.28,0:11:44.78,Default,,0,0,0,,Иә... бұл көп қан.
Dialogue: 0,0:11:45.03,0:11:47.41,Default,,0,0,0,,Анаңа айт, сені ауруханаға апарсын.
Dialogue: 0,0:11:47.49,0:11:48.99,Default,,0,0,0,,Өте жақсы.
Dialogue: 0,0:11:49.12,0:11:52.67,Default,,0,0,0,,Олай болса тез кет, қайтып келудің қажеті жоқ.
Dialogue: 0,0:11:52.75,0:11:55.13,Default,,0,0,0,,Не! Бұл қандай суық сөз!
Dialogue: 0,0:11:55.29,0:11:58.75,Default,,0,0,0,,Менің айтқым келгені бұл емес! Сен тым ауырсың!
Dialogue: 0,0:11:58.84,0:11:59.67,Default,,0,0,0,,Құдай-ай, бірдеңе...
Dialogue: 0,0:11:59.76,0:12:00.76,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:12:16.31,0:12:18.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:18.65,0:12:20.15,Default,,0,0,0,,Тамақ ішпе, Лили
Dialogue: 0,0:12:20.23,0:12:21.28,Default,,0,0,0,,Мен оны жемеймін...
Dialogue: 0,0:12:21.65,0:12:23.65,Default,,0,0,0,,Мен тамақ жеген дыбысты ғана естимін.
Dialogue: 0,0:12:23.74,0:12:25.32,Default,,0,0,0,,Бұл физиологиялық құбылыс.
Dialogue: 0,0:12:25.74,0:12:27.66,Default,,0,0,0,,Ештеңені осылай жоққа шығармаңыз.
Dialogue: 0,0:12:28.16,0:12:29.41,Default,,0,0,0,,Сонда бұл инстинкт.
Dialogue: 0,0:12:29.62,0:12:33.41,Default,,0,0,0,,Мен саған сол инстинктпен бірдеңе істеу керектігін айтып отырмын.
Dialogue: 0,0:12:33.87,0:12:37.50,Default,,0,0,0,,Оған микрофон қойғанда, адам шығаратын дыбыстарды ести алмайсыз.
Dialogue: 0,0:12:37.67,0:12:39.04,Default,,0,0,0,,Шиеленіс жойылды!
Dialogue: 0,0:12:39.84,0:12:41.71,Default,,0,0,0,,Микрофонның нашар орналасуы
Dialogue: 0,0:12:48.64,0:12:49.85,Default,,0,0,0,,Оу!
Dialogue: 0,0:12:49.93,0:12:50.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:50.97,0:12:52.22,Default,,0,0,0,,Керемет
Dialogue: 0,0:13:00.86,0:13:02.36,Default,,0,0,0,,О!
Dialogue: 0,0:13:17.25,0:13:20.17,Default,,0,0,0,,Уау~ Бұл не?
Dialogue: 0,0:13:20.25,0:13:21.09,Default,,0,0,0,,Ойран
Dialogue: 0,0:13:21.63,0:13:23.38,Default,,0,0,0,,Классикалық жапон костюмдерінің бірі
Dialogue: 0,0:13:23.76,0:13:27.93,Default,,0,0,0,,Айтпақшы, егер бұл костюм шынайы болса, оның құны Кейенмен бірдей болар еді.
Dialogue: 0,0:13:28.26,0:13:29.68,Default,,0,0,0,,Керемет!
Dialogue: 0,0:13:29.76,0:13:33.02,Default,,0,0,0,,Мен Хаммерді ұнатсам да, Кайенді қалаймын.
Dialogue: 0,0:13:34.73,0:13:36.64,Default,,0,0,0,,Синхрондау аяқталды. Көре аласыз
Dialogue: 0,0:13:38.94,0:13:44.40,Default,,0,0,0,,Көпшілік ортасындағы адамдардың мінез-құлық қисығын қадағалайтын және талдайтын бағдарлама.
Dialogue: 0,0:13:44.57,0:13:45.44,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:46.40,0:13:50.66,Default,,0,0,0,,Ағысқа қарсы қозғалыс, қозғалыстың кенет өзгеруі және т.б.
Dialogue: 0,0:13:50.78,0:13:53.62,Default,,0,0,0,,Күдікті адамдарды анықтап, болжай алады
Dialogue: 0,0:13:54.04,0:13:57.08,Default,,0,0,0,,Лездік үкім шығару мүмкін бе? Бұл мүмкін
Dialogue: 0,0:13:58.50,0:14:02.21,Default,,0,0,0,,Өткізілетін жерде команданы тапсырыңыз. Оған кез келген жағдайда жол бермеңіз.
Dialogue: 0,0:14:04.80,0:14:06.30,Default,,0,0,0,,Барлығының күйі туралы есеп
Dialogue: 0,0:14:07.38,0:14:08.97,Default,,0,0,0,,1-аудан Мұнда ауытқу жоқ
Dialogue: 0,0:14:09.76,0:14:11.55,Default,,0,0,0,,2-аймақ Мұнда да ауытқулар жоқ.
Dialogue: 0,0:14:12.26,0:14:13.14,Default,,0,0,0,,(Фушигиро) Түпкі Дала жабылды! Арнайы сынып жойылды.
Dialogue: 0,0:14:13.22,0:14:14.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:19.65,0:14:21.15,Default,,0,0,0,,Кит Борис Жағдай қандай?
Dialogue: 0,0:14:23.86,0:14:25.03,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:14:25.11,0:14:25.94,Default,,0,0,0,,Адамды басынан-ақ жаман деп есептеу дұрыс емес деп ойлаймын.
Dialogue: 0,0:14:30.87,0:14:35.16,Default,,0,0,0,,Ғимараттың алдыңғы бөлігі Кит Фриктен басқа ауытқулар жоқ
Dialogue: 0,0:14:35.62,0:14:36.50,Default,,0,0,0,,Хмм…
Dialogue: 0,0:14:37.08,0:14:38.00,Default,,0,0,0,,Әрбір іздеу тобы
Dialogue: 0,0:14:38.46,0:14:39.37,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:14:39.50,0:14:41.33,Default,,0,0,0,,15-аймақ ауытқулар жоқ
Dialogue: 0,0:14:41.71,0:14:44.46,Default,,0,0,0,,16-аймақ Мен де оны әлі таба алмай жүрмін.
Dialogue: 0,0:14:45.63,0:14:47.55,Default,,0,0,0,,20-аймақ ауытқулар жоқ
Dialogue: 0,0:14:48.01,0:14:50.43,Default,,0,0,0,,22-аудан ауытқулар жоқ
Dialogue: 0,0:14:51.80,0:14:54.10,Default,,0,0,0,,24-аудан Күдікті адам Күдікті зат
Dialogue: 0,0:14:54.68,0:14:55.89,Default,,0,0,0,,Екеуі де табылмады
Dialogue: 0,0:14:58.48,0:15:00.69,Default,,0,0,0,,27-аймақ ауытқулар жоқ
Dialogue: 0,0:15:01.10,0:15:03.77,Default,,0,0,0,,Түсінікті. Іздеуді жалғастырыңыз.
Dialogue: 0,0:15:04.40,0:15:06.53,Default,,0,0,0,,Ешбір бөлшекті назардан тыс қалдырмаңыз
Dialogue: 0,0:15:06.86,0:15:09.45,Default,,0,0,0,,Газ ауаны баптаумен байланысты аймақта болуы керек.
Dialogue: 0,0:15:11.66,0:15:13.45,Default,,0,0,0,,Түсінгеніңізге рахмет.
Dialogue: 0,0:15:30.72,0:15:31.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:35.14,0:15:36.43,Default,,0,0,0,,Уау (Куроба) Кешіріңіз.
Dialogue: 0,0:15:46.61,0:15:47.90,Default,,0,0,0,,(Изанамидің ерін үндесуі)
Dialogue: 0,0:15:48.65,0:15:49.61,Default,,0,0,0,,Ha
Dialogue: 0,0:15:49.94,0:15:51.82,Default,,0,0,0,,(Изанамидің ерін үндесуі)
Dialogue: 0,0:15:53.74,0:15:56.53,Default,,0,0,0,,Хмм? Күдікті адамға арналған қосымша
Dialogue: 0,0:15:57.70,0:15:58.95,Default,,0,0,0,,Өткізу орнының ішіндегі 12-аудан
Dialogue: 0,0:15:59.16,0:16:01.46,Default,,0,0,0,,Оң жақтағы сары шашы жұқа даяшы
Dialogue: 0,0:16:01.71,0:16:02.54,Default,,0,0,0,,Әкімге қарай бет алды!
Dialogue: 0,0:16:02.67,0:16:03.54,Default,,0,0,0,,Айтайын дегенім, мен бұл туралы ештеңе білмеймін.
Dialogue: 0,0:16:06.54,0:16:07.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:08.59,0:16:09.80,Default,,0,0,0,,Ei
Dialogue: 0,0:16:12.97,0:16:14.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:19.47,0:16:20.47,Default,,0,0,0,,Күдікті қамауға алынды
Dialogue: 0,0:16:21.89,0:16:22.94,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:16:23.02,0:16:24.44,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:16:25.44,0:16:27.06,Default,,0,0,0,,Бұл адам да қауіпсіз.
Dialogue: 0,0:16:28.23,0:16:30.94,Default,,0,0,0,,Пышақ өте жаман болды.
Dialogue: 0,0:16:31.86,0:16:34.15,Default,,0,0,0,,Сіз оны пайдалануыңыз керек емес пе еді?
Dialogue: 0,0:16:34.36,0:16:35.49,Default,,0,0,0,,Кукккккккккккккккккккккккккккккккккккккккккккккккккк
Dialogue: 0,0:16:35.61,0:16:38.87,Default,,0,0,0,,Мен ол келмейтін шығар деп қорықтым. Хаха.
Dialogue: 0,0:16:38.95,0:16:39.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:39.87,0:16:43.12,Default,,0,0,0,,Күтілгендей, сіз енді 5-ші кезеңде боласыз.
Dialogue: 0,0:16:43.71,0:16:47.58,Default,,0,0,0,,Сен ақымақсың ба? Бұл соңы. Бастапқыда газ жоқ еді.
Dialogue: 0,0:16:48.67,0:16:51.71,Default,,0,0,0,,Енді 5-кезең басталады.
Dialogue: 0,0:16:52.05,0:16:54.55,Default,,0,0,0,,Мен сабақтан кейін көңіл көтеремін.
Dialogue: 0,0:16:54.63,0:16:55.72,Default,,0,0,0,,Көк!
Dialogue: 0,0:16:55.88,0:16:57.22,Default,,0,0,0,,Құс торын таста!
Dialogue: 0,0:16:57.34,0:16:59.93,Default,,0,0,0,,Хехехе, міне, осында
Dialogue: 0,0:17:00.68,0:17:02.14,Default,,0,0,0,,Құйрық ұшты!
Dialogue: 0,0:17:06.73,0:17:07.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:15.49,0:17:19.20,Default,,0,0,0,,Штаб-пәтер Жауап беріңіз. Бұл негізгі кіреберіс Штаб!
Dialogue: 0,0:17:21.41,0:17:23.00,Default,,0,0,0,,Жоқ, ол ашылмайды.
Dialogue: 0,0:17:23.08,0:17:25.41,Default,,0,0,0,,Мм... Мұнда да жақсы емес!
Dialogue: 0,0:17:27.08,0:17:28.54,Default,,0,0,0,,Бұл да ашылмайды.
Dialogue: 0,0:17:29.46,0:17:32.46,Default,,0,0,0,,Марио Барлық кірулер мен шығулар жабық.
Dialogue: 0,0:17:32.80,0:17:34.42,Default,,0,0,0,,Толығымен шектелген
Dialogue: 0,0:17:35.51,0:17:37.09,Default,,0,0,0,,Өйткені екеуіңде де бірдей квирк бар ма?
Dialogue: 0,0:17:37.68,0:17:40.76,Default,,0,0,0,,Біз бұл қонақүйдің жүйесін өз қолымызға алдық.
Dialogue: 0,0:17:41.10,0:17:43.77,Default,,0,0,0,,Сіз бұл жерден кете алмайсыз!
Dialogue: 0,0:17:45.18,0:17:46.64,Default,,0,0,0,,Каэла? (Радио: Каэла) Рас...
Dialogue: 0,0:17:47.06,0:17:49.19,Default,,0,0,0,,Құрылыс жүйелеріне қол жеткізу мүмкін емес
Dialogue: 0,0:17:49.44,0:17:50.73,Default,,0,0,0,,қайтарылды
Dialogue: 0,0:17:51.57,0:17:54.57,Default,,0,0,0,,Хехехе, құйрықты түсіру аяқталды
Dialogue: 0,0:17:55.82,0:17:58.49,Default,,0,0,0,,Бұл қонақүйдің ішіне улы газ қойылған.
Dialogue: 0,0:17:58.61,0:18:03.70,Default,,0,0,0,,Бұл жерде бәрі былай тұрсын, қаладағылардың бәрін өлтіруге жеткілікті.
Dialogue: 0,0:18:04.45,0:18:08.96,Default,,0,0,0,,Сағат 9-да сенің өмірің аяқталды!
Dialogue: 0,0:18:10.13,0:18:13.71,Default,,0,0,0,,Кез келген адам құрылғыны тоқтатқысы келеді!
Dialogue: 0,0:18:14.17,0:18:16.84,Default,,0,0,0,,Әкімді сонда өлтіріңіз!
Dialogue: 0,0:18:17.22,0:18:19.26,Default,,0,0,0,,Содан кейін құрылғы
Dialogue: 0,0:18:19.84,0:18:20.80,Default,,0,0,0,,Тоқта
Dialogue: 0,0:18:22.22,0:18:23.56,Default,,0,0,0,,Уа, ау...
Dialogue: 0,0:18:25.18,0:18:29.85,Default,,0,0,0,,Сенбесеңіз, жарайды, уақыт өте келе түсінесіз.
Dialogue: 0,0:18:30.23,0:18:33.11,Default,,0,0,0,,Бұлай болғанда, бәрі осылай болады.
Dialogue: 0,0:18:33.23,0:18:36.57,Default,,0,0,0,,Ааааааааааааааааааааааааааааааа...
Dialogue: 0,0:18:36.69,0:18:40.32,Default,,0,0,0,,Бірге... аа... кей... кук...
Dialogue: 0,0:18:41.62,0:18:43.58,Default,,0,0,0,,Биыл ғана дебют жасаған –
Dialogue: 0,0:18:47.20,0:18:48.25,Default,,0,0,0,,(Дон!)
Dialogue: 0,0:18:49.87,0:18:51.96,Default,,0,0,0,,Барлығыңыз тынышталыңыздар!
Dialogue: 0,0:18:52.29,0:18:56.38,Default,,0,0,0,,Мені итермеңіз... Әй, енді ғана кеудеме тиген жігіт кім еді?
Dialogue: 0,0:18:56.51,0:18:58.17,Default,,0,0,0,,Қамау! Қамау!
Dialogue: 0,0:18:59.17,0:19:00.38,Default,,0,0,0,,Сен де өлесің.
Dialogue: 0,0:19:00.47,0:19:03.14,Default,,0,0,0,,Хи хи хи онда мэрді өлтіру керек.
Dialogue: 0,0:19:03.55,0:19:06.31,Default,,0,0,0,,Осылай жасасаң, барлығы құтқарылады.
Dialogue: 0,0:19:06.39,0:19:08.77,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:09.31,0:19:13.36,Default,,0,0,0,,Тыңда, бәріміз осында өлеміз, соның ішінде мен де.
Dialogue: 0,0:19:13.44,0:19:14.69,Default,,0,0,0,,Бұл апат.
Dialogue: 0,0:19:15.11,0:19:18.90,Default,,0,0,0,,Оқиға мәңгі сұмдық болып, ұрпақтан-ұрпаққа жалғасады.
Dialogue: 0,0:19:19.19,0:19:21.95,Default,,0,0,0,,Бірақ сіздің құрбандарыңыздың есімдері шаң сияқты өшті.
Dialogue: 0,0:19:22.03,0:19:24.32,Default,,0,0,0,,Ұмытылу
Dialogue: 0,0:19:24.99,0:19:30.12,Default,,0,0,0,,Былайша айтқанда, ұрпақ жадында сақталатын жалғыз нәрсе – менің атым, қылмыскер.
Dialogue: 0,0:19:30.21,0:19:31.46,Default,,0,0,0,,Ал, бәрін айтып таста
Dialogue: 0,0:19:31.54,0:19:34.04,Default,,0,0,0,,Бұл мен ғана... Хаха...
Dialogue: 0,0:19:34.13,0:19:35.50,Default,,0,0,0,,Сен
Dialogue: 0,0:19:36.00,0:19:39.34,Default,,0,0,0,,Жақында менің атым ақпараттың бос жерінде өтеді.
Dialogue: 0,0:19:39.42,0:19:41.34,Default,,0,0,0,,Жақында аңызға айналады
Dialogue: 0,0:19:42.55,0:19:44.26,Default,,0,0,0,,Тақырып келесідей болуы керек
Dialogue: 0,0:19:45.05,0:19:48.31,Default,,0,0,0,,«Баланың әдемі үмітсіздігі»
Dialogue: 0,0:19:49.06,0:19:50.56,Default,,0,0,0,,Психо жігіт
Dialogue: 0,0:19:51.14,0:19:54.10,Default,,0,0,0,,Сіз ренжідіңіз бе? Аты жоқ детектив
Dialogue: 0,0:19:54.73,0:19:56.77,Default,,0,0,0,,Осы ақымақ болжаммен!
Dialogue: 0,0:19:56.94,0:20:00.07,Default,,0,0,0,,Сол бос сөзге ұтылып қал, бейшара.
Dialogue: 0,0:20:00.15,0:20:01.70,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:20:03.78,0:20:07.03,Default,,0,0,0,,Мен сені ақымақ жүзіңмен, атыңды қалдырамын.
Dialogue: 0,0:20:07.87,0:20:11.79,Default,,0,0,0,,Мен ақымақ қылмыскер ретінде ештеңе істеген жоқпын.
Dialogue: 0,0:20:12.37,0:20:13.29,Default,,0,0,0,,Каэла!
Dialogue: 0,0:20:13.37,0:20:14.29,Default,,0,0,0,,Мен тыңдадым.
Dialogue: 0,0:20:14.37,0:20:16.59,Default,,0,0,0,,Мен де ренжіп қалдым, сәл үндемеңіз.
Dialogue: 0,0:20:16.71,0:20:19.55,Default,,0,0,0,,Тарақанға қарағанда, әдепсіз бәйбіше тітіркендіреді.
Dialogue: 0,0:20:19.92,0:20:23.01,Default,,0,0,0,,Қоғамға налыған баланың өзі өлгенше ызаланады.
Dialogue: 0,0:20:23.22,0:20:24.09,Default,,0,0,0,,Каэла?
Dialogue: 0,0:20:24.18,0:20:25.93,Default,,0,0,0,,Мен саған аузыңды жабуды айттым!
Dialogue: 0,0:20:26.76,0:20:28.97,Default,,0,0,0,,А, мен қаламаймын.
Dialogue: 0,0:20:29.81,0:20:33.06,Default,,0,0,0,,Әпкемізді ренжіткен сияқтысыңдар.
Dialogue: 0,0:20:33.64,0:20:35.56,Default,,0,0,0,,Мен не болатынын білмеймін.
Dialogue: 0,0:20:36.61,0:20:40.40,Default,,0,0,0,,Бұл мен ойлағаннан да күрделі... Сонда бұл соншалықты ақымақ емес пе?
Dialogue: 0,0:20:41.53,0:20:43.70,Default,,0,0,0,,Мен ақылды емеспін, бірақ...
Dialogue: 0,0:20:59.38,0:21:00.88,Default,,0,0,0,,Сіз бәрібір келдіңіз.
Dialogue: 0,0:21:05.72,0:21:11.22,Default,,0,0,0,,Ол жылдам соққымен белгіге түседі, тіпті таңқаларлық арзан жасанды жемді де тістеп алады.
Dialogue: 0,0:21:11.81,0:21:13.93,Default,,0,0,0,,Бұл адам керемет болуы мүмкін.
Dialogue: 0,0:21:14.35,0:21:18.02,Default,,0,0,0,,А... Сіз оның кім екенін білмейсіз ғой.
Dialogue: 0,0:21:18.56,0:21:21.73,Default,,0,0,0,,Сізге қызық па? Сіз қызықсыз ба?
Dialogue: 0,0:21:22.23,0:21:24.74,Default,,0,0,0,,Бірақ мен сізге әлі айтпаймын.
Dialogue: 0,0:21:26.24,0:21:29.32,Default,,0,0,0,,Менің артымнан мойынсұнып жүрсең, сенімен таныстырамын.
Dialogue: 0,0:21:29.66,0:21:31.58,Default,,0,0,0,,Сізге бұл ұнамайды, солай ма?
Dialogue: 0,0:21:32.58,0:21:33.41,Default,,0,0,0,,Ах
Dialogue: 0,0:21:34.08,0:21:35.87,Default,,0,0,0,,Ах~ Қорқынышты қорқынышты
Dialogue: 0,0:21:37.33,0:21:41.46,Default,,0,0,0,,Сен мені осылай ренжітіп, Кэнь сияқты құртасың ба?
Dialogue: 0,0:21:42.96,0:21:44.72,Default,,0,0,0,,Куэн өлді
Dialogue: 0,0:21:45.26,0:21:49.80,Default,,0,0,0,,Өлемін деп ойламаймын, сәл ерте.
Dialogue: 0,0:21:50.22,0:21:51.81,Default,,0,0,0,,Аз ғана...
Dialogue: 0,0:21:52.85,0:21:55.18,Default,,0,0,0,,Бізге сен керексің
Dialogue: 0,0:21:55.77,0:21:58.23,Default,,0,0,0,,Бұл сенің өмірің емес...
Dialogue: 0,0:21:59.86,0:22:01.52,Default,,0,0,0,,Бұл нені білдіретінін түсінесіз бе?
Dialogue: 0,0:22:13.49,0:22:14.58,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:22:15.33,0:22:16.29,Default,,0,0,0,,Фу…
Dialogue: 0,0:22:28.47,0:22:34.47,Default,,0,0,0,,♪〜
Dialogue: 0,0:24:18.45,0:24:24.46,Default,,0,0,0,,〜♪
Dialogue: 0,0:24:25.96,0:24:31.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory