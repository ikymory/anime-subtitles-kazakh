Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:13.34,0:00:17.35,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:00:35.28,0:00:38.03,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:00:38.41,0:00:39.24,Default,,0,0,0,,келді
Dialogue: 0,0:00:51.05,0:00:57.05,Default,,0,0,0,,♪〜
Dialogue: 0,0:00:59.93,0:01:05.94,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:19.74,0:01:20.58,Default,,0,0,0,,Эй!
Dialogue: 0,0:02:13.34,0:02:14.75,Default,,0,0,0,,Кит…
Dialogue: 0,0:02:16.71,0:02:20.76,Default,,0,0,0,,Сіз кереметсіз, бірақ бәрі осы.
Dialogue: 0,0:02:22.01,0:02:24.18,Default,,0,0,0,,Қалғанын өзім шешемін
Dialogue: 0,0:02:26.22,0:02:27.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:29.39,0:02:31.06,Default,,0,0,0,,Кит...?
Dialogue: 0,0:02:32.31,0:02:33.23,Default,,0,0,0,,Уау! а!
Dialogue: 0,0:02:33.52,0:02:34.48,Default,,0,0,0,,Лилия!
Dialogue: 0,0:02:35.73,0:02:38.49,Default,,0,0,0,,Кебек Жақсысың ба?
Dialogue: 0,0:02:39.32,0:02:40.95,Default,,0,0,0,,Ах... бұл сызық.
Dialogue: 0,0:02:41.57,0:02:43.62,Default,,0,0,0,,Сізге әлі де ұйықтау керек, солай ма?
Dialogue: 0,0:02:44.03,0:02:47.66,Default,,0,0,0,,А... Мен қанша ұйықтадым?
Dialogue: 0,0:02:48.12,0:02:49.66,Default,,0,0,0,,Бірнеше сағат
Dialogue: 0,0:02:50.58,0:02:54.00,Default,,0,0,0,,Не!? Лили, күте тұрыңыз! Апыр-ай!
Dialogue: 0,0:02:54.09,0:02:57.13,Default,,0,0,0,,Киіміңді ауыстыр! Қай жерде өзгеріп жатырсың?
Dialogue: 0,0:03:18.03,0:03:21.11,Default,,0,0,0,,Келе жатыр Куробане келе жатыр
Dialogue: 0,0:03:21.53,0:03:22.36,Default,,0,0,0,,Келеді...
Dialogue: 0,0:03:22.45,0:03:23.28,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:24.28,0:03:25.91,Default,,0,0,0,,(Юнаның ыңырануы)
Dialogue: 0,0:04:08.66,0:04:11.29,Default,,0,0,0,,Жұлдыздарға тығылған кеме
Dialogue: 0,0:04:22.76,0:04:25.64,Default,,0,0,0,,(Юнаның ыңырануы)
Dialogue: 0,0:04:34.27,0:04:37.11,Default,,0,0,0,,Тоқта, Миназуки, басыңды суыт.
Dialogue: 0,0:04:38.23,0:04:42.44,Default,,0,0,0,,Сіз сиреналарды естімейсіз бе? Ол жақында қалды.
Dialogue: 0,0:04:45.66,0:04:49.74,Default,,0,0,0,,Келе жатыр... Кім?
Dialogue: 0,0:04:50.79,0:04:51.66,Default,,0,0,0,,Минадзуки?
Dialogue: 0,0:04:52.50,0:04:53.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:55.92,0:04:57.08,Default,,0,0,0,,Шекара Regalia-ның қалқаны әрі жалғыз қаруы болып табылады.
Dialogue: 0,0:04:58.63,0:04:59.59,Default,,0,0,0,,Сіз...
Dialogue: 0,0:05:01.38,0:05:05.84,Default,,0,0,0,,Жаман Жаман Мен ол жігітті өлтіретінімді есіме түсірдім.
Dialogue: 0,0:05:07.09,0:05:11.93,Default,,0,0,0,,Өлтіру Олардың бәрін өлтіру
Dialogue: 0,0:05:13.31,0:05:19.15,Default,,0,0,0,,Өлтір, өлтір, өлтір...
Dialogue: 0,0:05:22.73,0:05:25.07,Default,,0,0,0,,Уақытты сатып алу жеткілікті ме?
Dialogue: 0,0:05:27.11,0:05:28.99,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:05:29.07,0:05:30.70,Default,,0,0,0,,Миф сияқты.
Dialogue: 0,0:05:31.87,0:05:34.62,Default,,0,0,0,,Күтілгендей, мұнымен бітпейді.
Dialogue: 0,0:05:37.96,0:05:42.25,Default,,0,0,0,,Жазбаның осымен аяқталуын қалайды.
Dialogue: 0,0:05:57.64,0:05:58.48,Default,,0,0,0,,Осымен.
Dialogue: 0,0:06:15.79,0:06:16.62,Default,,0,0,0,,Юна...
Dialogue: 0,0:06:17.00,0:06:20.88,Default,,0,0,0,,(Юнаның ыңырануы)
Dialogue: 0,0:06:28.01,0:06:30.13,Default,,0,0,0,,Үйлену тойының платина түсі
Dialogue: 0,0:06:32.30,0:06:34.47,Default,,0,0,0,,Аяқтаудың басы
Dialogue: 0,0:06:36.31,0:06:41.15,Default,,0,0,0,,Қара қауырсын патшасының жаңа тәжін киетін кез келді.
Dialogue: 0,0:06:49.90,0:06:51.95,Default,,0,0,0,,Моби Дикке қош келдіңіз
Dialogue: 0,0:06:53.78,0:06:57.54,Default,,0,0,0,,Күтуден шаршадым, Қара қауырсынның патшасы.
Dialogue: 0,0:07:00.04,0:07:02.96,Default,,0,0,0,,Мен сенен барлығын дәл осы жерде және қазір аламын.
Dialogue: 0,0:07:03.67,0:07:05.96,Default,,0,0,0,,Мен барлық нәрсенің патшасы боламын!
Dialogue: 0,0:07:15.47,0:07:17.35,Default,,0,0,0,,Сіз сенімдісіз бе? (Криминалист) Иә.
Dialogue: 0,0:07:17.93,0:07:19.23,Default,,0,0,0,,Борис иә?
Dialogue: 0,0:07:19.81,0:07:23.65,Default,,0,0,0,,Күтілгендей, барлық мәйіттер бальзамдалған.
Dialogue: 0,0:07:24.36,0:07:28.69,Default,,0,0,0,,Осыншама көп бірлікпен жылдық техникалық қызмет көрсету шығындары сегіз санды құрайды.
Dialogue: 0,0:07:29.36,0:07:31.49,Default,,0,0,0,,Эрик айтқандай
Dialogue: 0,0:07:31.74,0:07:35.16,Default,,0,0,0,,Бұл жеке адам ұстай алатын нысан емес.
Dialogue: 0,0:07:35.24,0:07:36.08,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:07:36.16,0:07:38.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:39.25,0:07:41.66,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:07:41.75,0:07:42.67,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:44.67,0:07:46.09,Default,,0,0,0,,Эрик Лили
Dialogue: 0,0:07:46.67,0:07:47.50,Default,,0,0,0,,Лилия?
Dialogue: 0,0:07:47.63,0:07:49.05,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:07:52.43,0:07:53.93,Default,,0,0,0,,Сәлеметсіз бе! сәлем!
Dialogue: 0,0:07:54.18,0:07:55.51,Default,,0,0,0,,Лили Борис қазір...
Dialogue: 0,0:07:55.60,0:07:56.64,Default,,0,0,0,,Кит, сен қайдасың?
Dialogue: 0,0:07:57.26,0:07:58.31,Default,,0,0,0,,Иә? Кит?
Dialogue: 0,0:08:00.48,0:08:04.06,Default,,0,0,0,,Кит ауруханада, солай ма? Ол сенімен бірге емес пе?
Dialogue: 0,0:08:04.52,0:08:07.44,Default,,0,0,0,,Мен оқиға орнына қайтып бардым...шамамен 3 сағат бұрын.
Dialogue: 0,0:08:07.82,0:08:08.65,Default,,0,0,0,,Не? Ах...
Dialogue: 0,0:08:09.15,0:08:11.07,Default,,0,0,0,,Гилберт қашып кетер алдында
Dialogue: 0,0:08:11.24,0:08:14.16,Default,,0,0,0,,Олар менің аузыма капсула тәрізді бірдеңе салды.\NКит мені
Dialogue: 0,0:08:14.74,0:08:17.12,Default,,0,0,0,,-де көтерген кезде
Dialogue: 0,0:08:17.28,0:08:19.62,Default,,0,0,0,,Оны шығарып, маған айтты
Dialogue: 0,0:08:20.24,0:08:21.08,Default,,0,0,0,,Сәлем Эрик
Dialogue: 0,0:08:22.16,0:08:25.29,Default,,0,0,0,,Лили, сонда жүр, күте тұр.
Dialogue: 0,0:08:25.37,0:08:26.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:06.92,0:09:07.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:17.09,0:09:18.47,Default,,0,0,0,,Юна қайда?
Dialogue: 0,0:09:19.93,0:09:22.35,Default,,0,0,0,,Жауап берсең, қиналмай өлтіремін.
Dialogue: 0,0:09:26.39,0:09:27.23,Default,,0,0,0,,Юна?
Dialogue: 0,0:09:28.48,0:09:30.36,Default,,0,0,0,,Бұл кім? ол
Dialogue: 0,0:09:30.69,0:09:31.52,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:09:32.32,0:09:33.44,Default,,0,0,0,,Абдул сен үшін өлді.
Dialogue: 0,0:09:33.99,0:09:34.82,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:37.53,0:09:40.99,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:09:41.62,0:09:42.45,Default,,0,0,0,,Реджи
Dialogue: 0,0:09:46.33,0:09:48.96,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:09:52.71,0:09:57.72,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:10:03.10,0:10:03.93,Default,,0,0,0,,Реджи
Dialogue: 0,0:10:07.39,0:10:08.85,Default,,0,0,0,,Тоқтату белгілері…
Dialogue: 0,0:10:10.15,0:10:12.15,Default,,0,0,0,,Сіз Реджисіз бе?
Dialogue: 0,0:10:13.77,0:10:14.78,Default,,0,0,0,,Реджи?
Dialogue: 0,0:10:16.57,0:10:19.36,Default,,0,0,0,,Маған Реджи керек емес, олардың бәрін өлтір.
Dialogue: 0,0:10:20.95,0:10:23.49,Default,,0,0,0,,Дәл осы Реджиді қолданайық
Dialogue: 0,0:10:23.58,0:10:24.45,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:26.20,0:10:27.83,Default,,0,0,0,,Олардың көздерінің түсі бірдей
Dialogue: 0,0:10:30.04,0:10:31.42,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:10:32.50,0:10:38.51,Default,,0,0,0,,Мен бұл көздерді білемін...
Dialogue: 0,0:10:39.72,0:10:40.76,Default,,0,0,0,,Мен білемін...
Dialogue: 0,0:10:41.93,0:10:43.39,Default,,0,0,0,,Мен білемін...
Dialogue: 0,0:10:44.22,0:10:45.47,Default,,0,0,0,,Мен білемін...
Dialogue: 0,0:10:46.14,0:10:47.64,Default,,0,0,0,,Мен білемін...
Dialogue: 0,0:10:47.89,0:10:49.06,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:11:04.62,0:11:08.66,Default,,0,0,0,,Қорықпа, көзіме мұқият қара
Dialogue: 0,0:11:09.83,0:11:13.46,Default,,0,0,0,,Бұдан былай сен менің иллюзияма айналасың.
Dialogue: 0,0:11:18.21,0:11:21.26,Default,,0,0,0,,Мен оның иллюзиясы сияқтымын.
Dialogue: 0,0:11:24.05,0:11:26.93,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:30.81,0:11:31.69,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:11:33.60,0:11:34.44,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:36.27,0:11:39.32,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:11:52.08,0:11:53.42,Default,,0,0,0,,Осы жерде тоқтап қалмаңыз
Dialogue: 0,0:12:13.31,0:12:14.48,Default,,0,0,0,,Бұл емес
Dialogue: 0,0:12:16.90,0:12:17.73,Default,,0,0,0,,Юна...
Dialogue: 0,0:13:19.34,0:13:20.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:25.01,0:13:25.84,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:13:31.35,0:13:32.18,Default,,0,0,0,,Юна...
Dialogue: 0,0:13:32.93,0:13:34.31,Default,,0,0,0,,Мені күту
Dialogue: 0,0:13:40.90,0:13:43.28,Default,,0,0,0,,Мені күт... маған бер...
Dialogue: 0,0:13:44.94,0:13:46.53,Default,,0,0,0,,Сен мені күтіп тұрдың...
Dialogue: 0,0:13:47.82,0:13:49.99,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:00.58,0:14:03.59,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:13.89,0:14:16.89,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,0:14:24.82,0:14:26.40,Default,,0,0,0,,Кеш емес пе?
Dialogue: 0,0:14:28.36,0:14:30.70,Default,,0,0,0,,Ол шешілмей қала ма деп уайымдадым.
Dialogue: 0,0:14:38.21,0:14:42.46,Default,,0,0,0,,Біз бұл код туралы сабақ барысында жиі айтатынбыз.
Dialogue: 0,0:14:48.22,0:14:49.88,Default,,0,0,0,,Сондай ностальгиялық
Dialogue: 0,0:14:52.85,0:14:57.81,Default,,0,0,0,,Профессордың жаман сөздері Неместің болуы Сүйікті жазба
Dialogue: 0,0:14:59.06,0:15:03.61,Default,,0,0,0,,Сіз көк устрица табынушысыз, мен жұқа Лиззимін
Dialogue: 0,0:15:04.57,0:15:06.53,Default,,0,0,0,,Сіз Кейт Бушсыз ба?
Dialogue: 0,0:15:10.07,0:15:11.20,Default,,0,0,0,,Тез кел!
Dialogue: 0,0:15:12.20,0:15:15.87,Default,,0,0,0,,Сәл тозғанымен, бұл жер сол кездегідей.
Dialogue: 0,0:15:19.54,0:15:21.71,Default,,0,0,0,,Қалғанын өзім шешемін.
Dialogue: 0,0:15:22.83,0:15:24.63,Default,,0,0,0,,Кит осылай деді, солай ма?
Dialogue: 0,0:15:24.88,0:15:25.71,Default,,0,0,0,,Иә
Dialogue: 0,0:15:25.79,0:15:28.55,Default,,0,0,0,,Егер мен ол жаққа баратын болсам, бұл кісі өлтіру оқиғасы болмай ма?
Dialogue: 0,0:15:28.63,0:15:29.84,Default,,0,0,0,,Тауда...
Dialogue: 0,0:15:30.26,0:15:33.55,Default,,0,0,0,,Бұл қылмыс болған жер емес, қараусыз қалған жер.
Dialogue: 0,0:15:34.80,0:15:36.89,Default,,0,0,0,,Эрика өлтірілген жер...
Dialogue: 0,0:15:40.68,0:15:41.94,Default,,0,0,0,,Сол бетті таққандықтан бәрін жеп қойды.
Dialogue: 0,0:15:42.81,0:15:43.65,Default,,0,0,0,,Не?
Dialogue: 0,0:15:44.48,0:15:46.69,Default,,0,0,0,,Бұл өз бетімен жасай алатын нәрсе емес.
Dialogue: 0,0:15:47.65,0:15:48.90,Default,,0,0,0,,Бұл кімнің бұйрығы?
Dialogue: 0,0:15:49.15,0:15:52.03,Default,,0,0,0,,Иә? О... шабуыл дейсіз бе?
Dialogue: 0,0:15:53.24,0:15:54.28,Default,,0,0,0,,Қарапайымдылық
Dialogue: 0,0:15:55.12,0:15:59.66,Default,,0,0,0,,Фаура Бранканың негізгі өнімі - Реджи деп аталатын адам қаруы.
Dialogue: 0,0:16:00.70,0:16:04.54,Default,,0,0,0,,Патша мен әскерилер Құдайдың қайта тірілуін қалайды.
Dialogue: 0,0:16:05.00,0:16:06.92,Default,,0,0,0,,Сәтті болсаң, қиыншылыққа тап боласың.
Dialogue: 0,0:16:10.71,0:16:12.76,Default,,0,0,0,,Айтпақшы, мен сізге хабарлаймын.
Dialogue: 0,0:16:13.63,0:16:17.85,Default,,0,0,0,,Сол шабуылды ұсынған мен болдым, оны басқарған да мен болдым.
Dialogue: 0,0:16:19.97,0:16:23.35,Default,,0,0,0,,Доктор Казама Минацукиге оны өлтіруді бұйырды.
Dialogue: 0,0:16:24.77,0:16:27.61,Default,,0,0,0,,Мм... Балалар біртүрлі екен.
Dialogue: 0,0:16:28.32,0:16:30.23,Default,,0,0,0,,Өтірік болса, сізге ыңғайлы
Dialogue: 0,0:16:30.86,0:16:32.49,Default,,0,0,0,,Кез келген нәрсеге сеніңіз
Dialogue: 0,0:16:39.87,0:16:42.87,Default,,0,0,0,,Неліктен сізге айла жасалмады?
Dialogue: 0,0:16:44.46,0:16:48.54,Default,,0,0,0,,Ах... Миназукидің оң көзінің қабілетін айтасыз ба?
Dialogue: 0,0:16:50.13,0:16:53.01,Default,,0,0,0,,Сіз мұны білесіз бе? Сіз сұрауға батылыңыз бар ма?
Dialogue: 0,0:16:54.97,0:16:57.30,Default,,0,0,0,,Себебі сен оны басқарып тұрдың.
Dialogue: 0,0:16:58.30,0:16:59.14,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:01.97,0:17:04.14,Default,,0,0,0,,Балалық шақтағы сенімдер
Dialogue: 0,0:17:04.64,0:17:08.23,Default,,0,0,0,,Біз нақты шындықтың куәсі болғанша
Dialogue: 0,0:17:08.48,0:17:09.86,Default,,0,0,0,,Ешқашан жоғалмайды
Dialogue: 0,0:17:10.69,0:17:12.69,Default,,0,0,0,,Бұл гипноздың бір түрі.
Dialogue: 0,0:17:13.82,0:17:15.53,Default,,0,0,0,,Баланың өтірігі.
Dialogue: 0,0:17:16.20,0:17:17.70,Default,,0,0,0,,Ол сенді
Dialogue: 0,0:17:18.53,0:17:20.70,Default,,0,0,0,,Қазірдің өзінде жазуда сипатталған тәртіп бойынша
Dialogue: 0,0:17:20.83,0:17:22.08,Default,,0,0,0,,Егер сіз Куроханы өлтірсеңіз
Dialogue: 0,0:17:22.41,0:17:26.58,Default,,0,0,0,,Мен жаңа әлемде жеңілмейтін патша ретінде билік ете алатыныма сенемін.
Dialogue: 0,0:17:28.83,0:17:29.96,Default,,0,0,0,,Қанша...
Dialogue: 0,0:17:31.96,0:17:35.22,Default,,0,0,0,,Қанағаттанбай тұрып, адамдардың өмірімен неше рет ойнау керек?
Dialogue: 0,0:17:41.51,0:17:42.81,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:17:43.97,0:17:46.27,Default,,0,0,0,,Жеңілдейтін ештеңе жоқ.
Dialogue: 0,0:17:48.40,0:17:49.23,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:50.69,0:17:52.86,Default,,0,0,0,,Өлтірмей өмір сүре алмайсың.
Dialogue: 0,0:17:56.40,0:18:00.37,Default,,0,0,0,,Бірақ, Кит, ойланыңыз.
Dialogue: 0,0:18:00.74,0:18:03.87,Default,,0,0,0,,Сіз де, солай ма? Жоқ?
Dialogue: 0,0:18:06.04,0:18:09.21,Default,,0,0,0,,Менің өлтіретін құштарлығым және сенің сұраушы ақылың
Dialogue: 0,0:18:10.17,0:18:13.42,Default,,0,0,0,,Өзіңізді ұстай алмағаныңыз бірдей емес пе?
Dialogue: 0,0:18:16.59,0:18:19.05,Default,,0,0,0,,Бұл Фрик отбасына тән қасиет.
Dialogue: 0,0:18:20.09,0:18:23.68,Default,,0,0,0,,Эрика өз эмоциясын ұстай алмады
Dialogue: 0,0:18:24.52,0:18:25.35,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:29.44,0:18:30.27,Default,,0,0,0,,Иә
Dialogue: 0,0:18:32.27,0:18:34.07,Default,,0,0,0,,Екеумізде де қарғыс қан.
Dialogue: 0,0:18:35.40,0:18:36.86,Default,,0,0,0,,Осыған нүкте қояйық
Dialogue: 0,0:19:31.71,0:19:36.80,Default,,0,0,0,,«Қара» сөзі мұнда «толық» сөзінің синонимі ретінде қайта-қайта кездеседі.
Dialogue: 0,0:19:39.21,0:19:41.26,Default,,0,0,0,,Сіз қара түсті жасауды білесіз бе?
Dialogue: 0,0:19:42.93,0:19:45.30,Default,,0,0,0,,Барлық түстерді араластырыңыз
Dialogue: 0,0:19:47.64,0:19:51.14,Default,,0,0,0,,Сондықтан қара түсті басқа түспен бояуға болмайды.
Dialogue: 0,0:19:52.19,0:19:55.81,Default,,0,0,0,,Керемет түс Патшаның түсі
Dialogue: 0,0:20:00.90,0:20:02.49,Default,,0,0,0,,Сіз түсінбейсіз бе?
Dialogue: 0,0:20:03.66,0:20:06.07,Default,,0,0,0,,Мен мұны не үшін істеп жатырмын?
Dialogue: 0,0:20:09.29,0:20:10.37,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:20:11.87,0:20:15.75,Default,,0,0,0,,Терезеден сенің алыстағы дауыстарыңды естідім.
Dialogue: 0,0:20:17.71,0:20:20.26,Default,,0,0,0,,Мен сені елестетумен уақыт өткіздім.
Dialogue: 0,0:20:21.63,0:20:24.76,Default,,0,0,0,,Изанами келгенше ұзақ уақыт жалғыз қалдым.
Dialogue: 0,0:20:26.72,0:20:28.14,Default,,0,0,0,,Мен білгім келді
Dialogue: 0,0:20:28.97,0:20:31.39,Default,,0,0,0,,Неліктен жалғыз мен оқшауландым?
Dialogue: 0,0:20:36.19,0:20:40.07,Default,,0,0,0,,Ол маған сол аласапыран түнді айтты
Dialogue: 0,0:20:42.03,0:20:45.70,Default,,0,0,0,,Мен Куробаненің қосалқы бөлігі ретінде жаратылып, тірі қалдым.
Dialogue: 0,0:20:46.62,0:20:48.74,Default,,0,0,0,,Өскен сайын туралған
Dialogue: 0,0:20:48.91,0:20:52.20,Default,,0,0,0,,Тағайындалған ит сияқты тасталған
Dialogue: 0,0:20:53.00,0:20:57.21,Default,,0,0,0,,Сондықтан менің бар екенім жазуда да айтылмаған.
Dialogue: 0,0:20:58.46,0:21:01.92,Default,,0,0,0,,Мен жай ғана елес болдым
Dialogue: 0,0:21:06.84,0:21:11.31,Default,,0,0,0,,Ол Куробаның көзінен ешбір бас тартуды көрсетпеді.
Dialogue: 0,0:21:11.52,0:21:14.69,Default,,0,0,0,,Емдеу арқылы қалыпқа келген жалғыз регги
Dialogue: 0,0:21:15.94,0:21:19.61,Default,,0,0,0,,Ол, әрине, қатаң оқшауланған болатын.
Dialogue: 0,0:21:20.36,0:21:23.24,Default,,0,0,0,,Егер сіздің бар екеніңізді әскерилер білсе, сіз жойыласыз.
Dialogue: 0,0:21:24.90,0:21:27.95,Default,,0,0,0,,Реджидің қалыпқа келудегі соңғы үміті
Dialogue: 0,0:21:30.03,0:21:31.20,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:32.83,0:21:37.04,Default,,0,0,0,,Бұл шабуылдың нақты мақсаты Миназуки болды ма?
Dialogue: 0,0:21:39.84,0:21:41.46,Default,,0,0,0,,Оған сенгім келмеді
Dialogue: 0,0:21:42.59,0:21:44.97,Default,,0,0,0,,Жазумен күресуге тырысты
Dialogue: 0,0:21:46.01,0:21:47.88,Default,,0,0,0,,Бірақ бұл пайдасыз болды.
Dialogue: 0,0:21:52.01,0:21:56.10,Default,,0,0,0,,Мен бұл көздерді алғаш көргенде бәрін білдім.
Dialogue: 0,0:21:57.14,0:21:58.81,Default,,0,0,0,,Мен ант бердім
Dialogue: 0,0:22:00.40,0:22:04.40,Default,,0,0,0,,Ол жігіттен құтылу үшін міндетті түрде қолымды қолданамын...
Dialogue: 0,0:22:05.49,0:22:07.20,Default,,0,0,0,,Барлығын алып кетіңіз
Dialogue: 0,0:22:09.03,0:22:09.87,Default,,0,0,0,,Сол жылы тағы бір үрей басталды
Dialogue: 0,0:22:17.41,0:22:19.50,Default,,0,0,0,,Куробане ешқашан жеңілмейді
Dialogue: 0,0:22:20.38,0:22:23.67,Default,,0,0,0,,Сондықтан сіз ештеңені алып кете алмайсыз
Dialogue: 0,0:22:26.09,0:22:27.47,Default,,0,0,0,,...
Dialogue: 0,0:22:29.68,0:22:30.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:33.14,0:22:33.97,Default,,0,0,0,,бұл...!
Dialogue: 0,0:22:35.27,0:22:36.43,Default,,0,0,0,,Байқамайсың ба?
Dialogue: 0,0:22:37.14,0:22:40.81,Default,,0,0,0,,Бізді бұл тас тақта қалағандай басқарады.
Dialogue: 0,0:22:41.27,0:22:43.57,Default,,0,0,0,,Өмір, өлім, бәрі
Dialogue: 0,0:22:44.27,0:22:46.23,Default,,0,0,0,,Мен шағымдана алмаймын
Dialogue: 0,0:22:47.44,0:22:50.91,Default,,0,0,0,,Қайталанатын оқиғада барлығы қосалқы рөл ғана.
Dialogue: 0,0:22:51.66,0:22:54.33,Default,,0,0,0,,Сондықтан сіз және Куроба
Dialogue: 0,0:22:55.83,0:22:57.12,Default,,0,0,0,,Осы жерде өл
Dialogue: 0,0:22:58.00,0:22:59.75,Default,,0,0,0,,Юнар!
Dialogue: 0,0:23:02.38,0:23:08.38,Default,,0,0,0,,♪〜
Dialogue: 0,0:24:54.03,0:25:00.04,Default,,0,0,0,,〜♪
