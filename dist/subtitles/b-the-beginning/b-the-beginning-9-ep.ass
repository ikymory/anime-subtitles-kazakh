Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:12.59,0:00:19.14,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:19.85,0:00:22.14,Default,,0,0,0,,Мен мұны өзім істей аламын!
Dialogue: 0,0:00:23.98,0:00:25.56,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:32.15,0:00:33.32,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:00:39.20,0:00:41.79,Default,,0,0,0,,Лили, не болатынын есіңе ал!
Dialogue: 0,0:00:45.37,0:00:47.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:57.39,0:01:01.93,Default,,0,0,0,,А... а...
Dialogue: 0,0:01:02.06,0:01:08.06,Default,,0,0,0,,♪〜
Dialogue: 0,0:01:10.94,0:01:16.95,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:18.11,0:01:19.45,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:01:20.12,0:01:21.95,Default,,0,0,0,,Лилияны пайдалану туралы не деуге болады?
Dialogue: 0,0:01:22.70,0:01:23.91,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:01:24.70,0:01:25.54,Default,,0,0,0,,Бөлек
Dialogue: 0,0:01:29.33,0:01:33.38,Default,,0,0,0,,Сіз менімен сөйлесе аласыз, солай ма? Оңай берілудегі мақсат
Dialogue: 0,0:01:34.38,0:01:38.72,Default,,0,0,0,,Мақсаты? Менің ойымша, мен өте күмәнмен өстім.
Dialogue: 0,0:01:39.22,0:01:40.76,Default,,0,0,0,,Кім кінәлі?
Dialogue: 0,0:01:47.85,0:01:49.35,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:01:51.90,0:01:55.24,Default,,0,0,0,,Бұл туралы ешкім білмейді.
Dialogue: 0,0:01:57.95,0:01:59.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:01.20,0:02:02.49,Default,,0,0,0,,Қорытындыда
Dialogue: 0,0:02:02.78,0:02:04.99,Default,,0,0,0,,Маркет-мейкерлер қатысқан кезде
Dialogue: 0,0:02:05.08,0:02:06.87,Default,,0,0,0,,Фактілерді нақтылаудың мәні жоқ.
Dialogue: 0,0:02:07.71,0:02:11.38,Default,,0,0,0,,Сондықтан мен бұл елге ыңғайсыз жерлерін ғана ашамын.
Dialogue: 0,0:02:11.75,0:02:12.59,Default,,0,0,0,,Хо
Dialogue: 0,0:02:13.21,0:02:17.01,Default,,0,0,0,,Маркет-мейкерді басқаратын адам есінен танып қалды.
Dialogue: 0,0:02:17.30,0:02:20.39,Default,,0,0,0,,Егер сіз лауазымыңызды асыра пайдалансаңыз не істер едіңіз?
Dialogue: 0,0:02:21.22,0:02:25.35,Default,,0,0,0,,Ол менің әпкемді өлтіріп, мені азапқа салудан ләззат алады.
Dialogue: 0,0:02:25.64,0:02:28.77,Default,,0,0,0,,Үздік маркет-мейкер ретіндегі позицияңызды пайдаланыңыз
Dialogue: 0,0:02:29.35,0:02:32.44,Default,,0,0,0,,Жеке пайда үшін сериялық кісі өлтіруді жалғастыру
Dialogue: 0,0:02:33.19,0:02:35.78,Default,,0,0,0,,Елді осы фактімен қарсы алыңыз.
Dialogue: 0,0:02:35.86,0:02:36.69,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:02:36.90,0:02:38.99,Default,,0,0,0,,Бұл басқа жерге қарағанда әлдеқайда нәзік ұйым болуы керек.
Dialogue: 0,0:02:39.15,0:02:40.41,Default,,0,0,0,,Сонымен, біз ақыры Үндістанды кесіп өтеміз—
Dialogue: 0,0:02:41.16,0:02:43.41,Default,,0,0,0,,Ақылсыздықты тудыратын ұйымға
Dialogue: 0,0:02:43.87,0:02:46.41,Default,,0,0,0,,Ешкім ессіздік індеті бар деп ойламайды.
Dialogue: 0,0:02:47.87,0:02:50.75,Default,,0,0,0,,Егер бұл дұрыс болса, онда бір ғана зақымдану бар.
Dialogue: 0,0:02:51.33,0:02:56.05,Default,,0,0,0,,Сіз оның кім екенін түсіндіңіз.
Dialogue: 0,0:02:57.51,0:02:58.88,Default,,0,0,0,,Неліктен әрекет етпеске?
Dialogue: 0,0:03:01.68,0:03:03.80,Default,,0,0,0,,Нақты дәлелдер жоқ
Dialogue: 0,0:03:05.10,0:03:08.35,Default,,0,0,0,,Менің білуімше, ол жерде сегіз жыл болды.
Dialogue: 0,0:03:08.43,0:03:11.44,Default,,0,0,0,,Бір минуттық қателіксіз бір күндік тәртіпті қайталау
Dialogue: 0,0:03:12.15,0:03:15.40,Default,,0,0,0,,Адам өлтіру импульсінен құтыла алмайды деп есептей отырып
Dialogue: 0,0:03:15.73,0:03:18.19,Default,,0,0,0,,Мен оның қайда және қашан жұмыс істейтінін білмеймін
Dialogue: 0,0:03:18.90,0:03:20.32,Default,,0,0,0,,Өлтіруші импульс?
Dialogue: 0,0:03:21.32,0:03:23.82,Default,,0,0,0,,Кінәліде импульстік бақылаудың бұзылуы бар
Dialogue: 0,0:03:24.99,0:03:27.91,Default,,0,0,0,,О, сен жалғыз емессің.
Dialogue: 0,0:03:28.49,0:03:30.71,Default,,0,0,0,,Сіз бірнеше қылмыскерді айтасыз ба?
Dialogue: 0,0:03:30.91,0:03:33.42,Default,,0,0,0,,Бұл да дұрыс емес шығар.
Dialogue: 0,0:03:33.54,0:03:34.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:34.83,0:03:36.34,Default,,0,0,0,,Мен де абдырап қалдым.
Dialogue: 0,0:03:37.13,0:03:40.05,Default,,0,0,0,,Сондықтан мен өз көзіммен білу үшін қайтып келдім.
Dialogue: 0,0:03:40.88,0:03:42.97,Default,,0,0,0,,Жоқ... (Кит) О.
Dialogue: 0,0:03:47.39,0:03:49.06,Default,,0,0,0,,Ол жақын жерде.
Dialogue: 0,0:03:56.40,0:03:59.28,Default,,0,0,0,,Сіз таба алмаған сегіз жыл бойы дәлелдер.
Dialogue: 0,0:03:59.57,0:04:01.74,Default,,0,0,0,,Санаулы сағаттар қалғанда қалай білуге ​​болады?
Dialogue: 0,0:04:06.53,0:04:10.33,Default,,0,0,0,,Сол әйнектің артындағы кішкентай жігіттің арқасында бәрі жоспарсыз өтті.
Dialogue: 0,0:04:11.12,0:04:12.79,Default,,0,0,0,,Бұл жағдайда өз бетімен ештеңе істей алмайсың...
Dialogue: 0,0:04:12.91,0:04:15.38,Default,,0,0,0,,Түсінуге тым кеш!
Dialogue: 0,0:04:15.83,0:04:18.29,Default,,0,0,0,,«Осылай не болады?» Бұл оқиға болғанға дейін!
Dialogue: 0,0:04:18.67,0:04:21.26,Default,,0,0,0,,Сіз жай ғана ақылдысыз және конституцияңыз әлсіз!
Dialogue: 0,0:04:21.97,0:04:23.93,Default,,0,0,0,,Сіз өзіңіз ештеңе істей алмайсыз!
Dialogue: 0,0:04:24.34,0:04:26.18,Default,,0,0,0,,Сіз байқадыңыз ба? Бонкура!
Dialogue: 0,0:04:26.80,0:04:28.89,Default,,0,0,0,,А, бұл нағыз Эрик.
Dialogue: 0,0:04:29.26,0:04:31.85,Default,,0,0,0,,Әлі де ішіп алғанымда аламын, кейде.
Dialogue: 0,0:04:31.98,0:04:34.23,Default,,0,0,0,,Таңқаларлық...
Dialogue: 0,0:04:34.52,0:04:36.10,Default,,0,0,0,,Сіз оны одан да қиындаттыңыз!
Dialogue: 0,0:04:36.19,0:04:37.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:41.19,0:04:42.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:44.03,0:04:46.91,Default,,0,0,0,,Мен мұнда сізден АВС-ті үйрендім.
Dialogue: 0,0:04:47.20,0:04:48.28,Default,,0,0,0,,Бұл менің мақтанышым
Dialogue: 0,0:04:49.37,0:04:52.75,Default,,0,0,0,,Әрқашан өзімнен Кит Фрик не ойлайтынын сұраймын.
Dialogue: 0,0:04:52.83,0:04:54.12,Default,,0,0,0,,Біз бүгінге дейін әрекет еттік.
Dialogue: 0,0:04:57.00,0:04:58.67,Default,,0,0,0,,Ақыры менің кезегім келді
Dialogue: 0,0:04:58.75,0:05:00.09,Default,,0,0,0,,Ұзақ болыңыз
Dialogue: 0,0:05:09.68,0:05:11.10,Default,,0,0,0,,Не істеп тұрсың?
Dialogue: 0,0:05:11.68,0:05:13.18,Default,,0,0,0,,Мұндағы еркектердің бәрі
Dialogue: 0,0:05:13.31,0:05:16.85,Default,,0,0,0,,Мен сіздің қисынсыз нұсқауларыңызға дәл жауап бере аламын.
Dialogue: 0,0:05:17.60,0:05:19.27,Default,,0,0,0,,Ең жақсы талантты тарту
Dialogue: 0,0:05:19.56,0:05:21.90,Default,,0,0,0,,Сен маған үйреткеннің бәрін бойыма сіңірдім.
Dialogue: 0,0:05:23.11,0:05:24.44,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:05:29.70,0:05:33.70,Default,,0,0,0,,Сегіз жыл бұрын алдын ала тағайындалған сот процесі бізді ренжітті.
Dialogue: 0,0:05:34.16,0:05:35.79,Default,,0,0,0,,Өлі Кайлды ұрлау
Dialogue: 0,0:05:35.96,0:05:38.92,Default,,0,0,0,,Мен ашқан қылмыстарымды жарыққа шығаруды жоспарладым.
Dialogue: 0,0:05:40.08,0:05:42.96,Default,,0,0,0,,Мұның бәрі біріншіден менің ойым еді.
Dialogue: 0,0:05:43.96,0:05:46.67,Default,,0,0,0,,Бірақ сіз жалғыз әрекет етесіз
Dialogue: 0,0:05:46.84,0:05:51.60,Default,,0,0,0,,Осының нәтижесінде мен сізді тұтқындадым.
Dialogue: 0,0:05:53.43,0:05:55.27,Default,,0,0,0,,Неліктен мұндай әрекетке бардыңыз?
Dialogue: 0,0:05:57.64,0:06:00.86,Default,,0,0,0,,Мені қорғау үшін бе, әлде ессіз қалды ма?
Dialogue: 0,0:06:01.36,0:06:03.07,Default,,0,0,0,,Мен әлі түсінбеймін
Dialogue: 0,0:06:03.90,0:06:06.44,Default,,0,0,0,,Бірақ сол күні саған және маған
Dialogue: 0,0:06:06.53,0:06:08.70,Default,,0,0,0,,Мен не жетіспейтінін түсіндім.
Dialogue: 0,0:06:09.45,0:06:10.28,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:06:11.24,0:06:12.08,Default,,0,0,0,,Топ
Dialogue: 0,0:06:15.66,0:06:16.83,Default,,0,0,0,,Көрсетіңіз
Dialogue: 0,0:06:17.46,0:06:21.17,Default,,0,0,0,,Біз келесі бірнеше сағатта сіздің жеке командамызбыз.
Dialogue: 0,0:06:24.92,0:06:30.38,Default,,0,0,0,,Мен сені бәрібір тергеу изоляторына жіберсем, РИС таратылады.
Dialogue: 0,0:06:31.22,0:06:34.35,Default,,0,0,0,,Айналайық, Алып өлтіру.
Dialogue: 0,0:06:38.94,0:06:40.98,Default,,0,0,0,,Алдымен қол кісендерін шешіңіз.
Dialogue: 0,0:06:41.40,0:06:44.23,Default,,0,0,0,,Бұл жақсы емес, ол әлі де күдікті.
Dialogue: 0,0:06:45.61,0:06:47.74,Default,,0,0,0,,Маркет-мейкерлер не істейді?
Dialogue: 0,0:06:48.03,0:06:49.53,Default,,0,0,0,,Ол міндетті түрде іске қосылады
Dialogue: 0,0:06:49.61,0:06:51.57,Default,,0,0,0,,Жарайды, мен оны шешіп алдым.
Dialogue: 0,0:07:07.76,0:07:09.97,Default,,0,0,0,,Лилияны азғын ретінде пайдаланыңыз
Dialogue: 0,0:07:10.68,0:07:12.30,Default,,0,0,0,,Оған қарсы шығу тым қауіпті.
Dialogue: 0,0:07:12.89,0:07:14.68,Default,,0,0,0,,Мен мұны істеме десе де істеймін.
Dialogue: 0,0:07:15.43,0:07:16.26,Default,,0,0,0,,Дәлел дегеніміз не?
Dialogue: 0,0:07:16.93,0:07:19.60,Default,,0,0,0,,Мен оны қайтып келгенімнің бірінші күні тыңдадым.
Dialogue: 0,0:07:24.86,0:07:26.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:26.69,0:07:28.78,Default,,0,0,0,,Егер бұл жоғалып бара жатқан зат болса, оны байқау қиын.
Dialogue: 0,0:07:29.07,0:07:30.82,Default,,0,0,0,,Ол бір күнге ғана созылды.
Dialogue: 0,0:07:31.45,0:07:33.24,Default,,0,0,0,,Мен күткеннен де көп темекі тарттым.
Dialogue: 0,0:07:33.57,0:07:34.99,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:07:36.20,0:07:37.03,Default,,0,0,0,,Бір ғана
Dialogue: 0,0:07:37.41,0:07:38.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:40.16,0:07:42.58,Default,,0,0,0,,Ол әлі Эрикамен сөйлесіп жатыр.
Dialogue: 0,0:07:43.33,0:07:44.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:44.83,0:07:45.92,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:07:46.96,0:07:47.92,Default,,0,0,0,,Каэла иә?
Dialogue: 0,0:07:48.00,0:07:49.34,Default,,0,0,0,,Маған көз контурлағышыңызды беріңіз.
Dialogue: 0,0:07:50.09,0:07:51.34,Default,,0,0,0,,Лили, күртешеңді шеш.
Dialogue: 0,0:07:51.88,0:07:52.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:55.01,0:07:56.55,Default,,0,0,0,,О? Хошина мырза
Dialogue: 0,0:07:56.64,0:07:58.31,Default,,0,0,0,,Сіз бұл сағатта не істеп жатырсыз?
Dialogue: 0,0:07:59.02,0:08:01.35,Default,,0,0,0,,Оған қол қоя аласыз ба?
Dialogue: 0,0:08:02.02,0:08:02.89,Default,,0,0,0,,(Фушигуро) Сиқырдың ауқымы, құрбандар саны, бөгет — алаңдаушылық тудырған барлық нәрсе —
Dialogue: 0,0:08:03.39,0:08:06.56,Default,,0,0,0,,Көп нәрсе болып жатыр, сондықтан қолдары бос менің жалғызым.
Dialogue: 0,0:08:07.06,0:08:10.28,Default,,0,0,0,,А, Генидің ісі ауыр сияқты.
Dialogue: 0,0:08:13.99,0:08:16.32,Default,,0,0,0,,Бұл әдеттен тыс рентген сәулесі.
Dialogue: 0,0:08:16.41,0:08:17.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:18.16,0:08:19.91,Default,,0,0,0,,О, бұл сирек.
Dialogue: 0,0:08:20.33,0:08:21.45,Default,,0,0,0,,Жағдайлар көп емес...
Dialogue: 0,0:08:29.46,0:08:31.30,Default,,0,0,0,,Корпуссыз қаңқасы бар.
Dialogue: 0,0:08:32.51,0:08:33.93,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:08:36.05,0:08:38.43,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:08:40.68,0:08:42.73,Default,,0,0,0,,Сіз оған әлі де сенесіз бе?
Dialogue: 0,0:08:43.89,0:08:46.90,Default,,0,0,0,,Мен сенімді емеспін, бірақ...
Dialogue: 0,0:08:47.56,0:08:48.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:49.90,0:08:52.65,Default,,0,0,0,,Мен Китке соңына дейін сенемін.
Dialogue: 0,0:08:53.24,0:08:57.87,Default,,0,0,0,,Танысқанымызға аз ғана уақыт болса да, сен оған үлкен сенім арттың.
Dialogue: 0,0:08:58.24,0:09:01.16,Default,,0,0,0,,Неге екенін білмеймін, бірақ...
Dialogue: 0,0:09:02.95,0:09:04.96,Default,,0,0,0,,Мен ол туралы ойлаймын.
Dialogue: 0,0:09:08.13,0:09:10.13,Default,,0,0,0,,Мүмкін ол маған ұнайтын шығар.
Dialogue: 0,0:09:10.55,0:09:11.42,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:11.75,0:09:14.17,Default,,0,0,0,,Ммммммммм
Dialogue: 0,0:09:14.26,0:09:16.38,Default,,0,0,0,,Ммм мммм
Dialogue: 0,0:09:17.22,0:09:19.47,Default,,0,0,0,,Не? Бұл ойын! Бұл ойын!
Dialogue: 0,0:09:20.14,0:09:21.89,Default,,0,0,0,,Не? Уа, балалар!
Dialogue: 0,0:09:23.14,0:09:25.98,Default,,0,0,0,,Тамақты әзірге шашып қойдым, сосын...
Dialogue: 0,0:09:26.06,0:09:28.35,Default,,0,0,0,,Хмм... Кит?
Dialogue: 0,0:09:29.44,0:09:31.40,Default,,0,0,0,,Қызарып кетті.
Dialogue: 0,0:09:37.53,0:09:40.62,Default,,0,0,0,,Генидің тұзағы немесе...
Dialogue: 0,0:09:43.04,0:09:44.79,Default,,0,0,0,,Сіз қалай ойлайсыз? Эрика
Dialogue: 0,0:09:46.66,0:09:47.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:50.50,0:09:51.34,Default,,0,0,0,,Эрика?
Dialogue: 0,0:09:54.17,0:09:55.92,Default,,0,0,0,,Қайда? Эрика
Dialogue: 0,0:09:59.05,0:10:00.30,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:10:01.76,0:10:05.35,Default,,0,0,0,,Құтқарушы дегеніміз не? Сіз жай ғана өлім құдайсыз!
Dialogue: 0,0:10:06.31,0:10:07.14,Default,,0,0,0,,Кукри
Dialogue: 0,0:10:07.69,0:10:10.23,Default,,0,0,0,,Куэн Изанами Камуи Такеру
Dialogue: 0,0:10:10.40,0:10:12.27,Default,,0,0,0,,Сен үшін бәрі өлді!
Dialogue: 0,0:10:13.11,0:10:13.94,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:10:14.90,0:10:16.69,Default,,0,0,0,,Себебі мен білемін.
Dialogue: 0,0:10:16.82,0:10:18.74,Default,,0,0,0,,Сіз не істемексіз
Dialogue: 0,0:10:19.24,0:10:22.07,Default,,0,0,0,,Егер Regulus білсе, сіз аяқтайсыз...
Dialogue: 0,0:10:22.37,0:10:26.50,Default,,0,0,0,,(Кукридің ыңырсыуы)
Dialogue: 0,0:10:40.80,0:10:41.68,Default,,0,0,0,,Өлген
Dialogue: 0,0:10:48.68,0:10:51.69,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:12.17,0:11:14.34,Default,,0,0,0,,Шынымды айтсам, мен уайымдамаймын.
Dialogue: 0,0:11:14.50,0:11:17.09,Default,,0,0,0,,Басқа амал жоқ па? Эрик
Dialogue: 0,0:11:17.17,0:11:19.97,Default,,0,0,0,,Ол РИЖ-нің дайындалған мүшесі.
Dialogue: 0,0:11:20.22,0:11:21.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:21.13,0:11:23.39,Default,,0,0,0,,Хмм Кит?
Dialogue: 0,0:11:23.47,0:11:24.30,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:11:24.80,0:11:26.39,Default,,0,0,0,,Сіз жай ғана тыныштандыратын бірдеңе айта алмайсыз ба?
Dialogue: 0,0:11:32.02,0:11:34.15,Default,,0,0,0,,Борис маған хабарласты.
Dialogue: 0,0:11:34.23,0:11:35.06,Default,,0,0,0,,О!
Dialogue: 0,0:11:36.02,0:11:38.15,Default,,0,0,0,,Эрик, мені тістеп алды.
Dialogue: 0,0:11:40.24,0:11:41.61,Default,,0,0,0,,Сіз автобуспен барасыз ба?
Dialogue: 0,0:11:41.86,0:11:43.70,Default,,0,0,0,,А... тек бүгінге.
Dialogue: 0,0:11:44.07,0:11:45.95,Default,,0,0,0,,Менің көлігім қирап қалды.
Dialogue: 0,0:11:46.53,0:11:47.37,Default,,0,0,0,,Үлкен зиян?
Dialogue: 0,0:11:48.54,0:11:49.91,Default,,0,0,0,,Әртүрлі заттар бар.
Dialogue: 0,0:11:53.29,0:11:56.09,Default,,0,0,0,,Қаласаң мен сені тастап кетемін. Сіз мінгіңіз келе ме?
Dialogue: 0,0:11:56.63,0:11:57.84,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:12:13.27,0:12:17.23,Default,,0,0,0,,Хмм, 11-маршрут бойынша батысқа қарай жылжиды
Dialogue: 0,0:12:17.48,0:12:19.90,Default,,0,0,0,,Ол тікелей Лилидің үйіне бара жатқан сияқты.
Dialogue: 0,0:12:20.44,0:12:22.49,Default,,0,0,0,,Түсінікті, мына жерден де тексеріңіз
Dialogue: 0,0:12:22.70,0:12:24.61,Default,,0,0,0,,Бізге жазылуды жалғастырыңыз
Dialogue: 0,0:12:25.53,0:12:27.62,Default,,0,0,0,,Жоқ, мен құтқарылдым. Мен құтқарылдым.
Dialogue: 0,0:12:28.16,0:12:30.08,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:12:30.24,0:12:33.25,Default,,0,0,0,,Біз үйге бір бағытта келе жатырмыз, солай ма?
Dialogue: 0,0:12:33.50,0:12:37.00,Default,,0,0,0,,Хаха~ Суық болғаны сонша, саусақтарым жарылып кететіндей болды.
Dialogue: 0,0:12:37.08,0:12:38.09,Default,,0,0,0,,Бұл асыра сілтеу.
Dialogue: 0,0:12:38.96,0:12:41.30,Default,,0,0,0,,Бүгінгі күннің бір ерекшелігі бар, солай емес пе?
Dialogue: 0,0:12:42.21,0:12:44.05,Default,,0,0,0,,Бұл жақсы сәйкестік пе?
Dialogue: 0,0:12:46.47,0:12:50.51,Default,,0,0,0,,Осылай жаңбыр жауса, қарға айналуы мүмкін.
Dialogue: 0,0:12:51.77,0:12:52.98,Default,,0,0,0,,Бір ұйым оған назар аударды
Dialogue: 0,0:12:53.77,0:12:55.23,Default,,0,0,0,,Естеліктеріңіз бар ма?
Dialogue: 0,0:12:56.15,0:12:58.69,Default,,0,0,0,,Осы жылы көп нәрсе орын алды.
Dialogue: 0,0:12:59.19,0:13:00.27,Default,,0,0,0,,Мен сұрағым келеді
Dialogue: 0,0:13:00.98,0:13:02.15,Default,,0,0,0,,кейде
Dialogue: 0,0:13:02.65,0:13:06.20,Default,,0,0,0,,Айтпасаң, мен шағымданатын түріммін.
Dialogue: 0,0:13:06.78,0:13:07.62,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:13:23.26,0:13:24.47,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:13:27.26,0:13:28.18,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:13:28.43,0:13:33.10,Default,,0,0,0,,Мен әдетте контактілерді киемін, бірақ дәл қазір бұлыңғыр, өйткені мен жалаңашпын.
Dialogue: 0,0:13:35.02,0:13:37.06,Default,,0,0,0,,Аа, мен радио тыңдай аламын ба?
Dialogue: 0,0:13:37.19,0:13:38.35,Default,,0,0,0,,Ууух!
Dialogue: 0,0:13:40.44,0:13:45.44,Default,,0,0,0,,(Радиода ойналатын музыка)
Dialogue: 0,0:13:48.74,0:13:49.74,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:13:49.95,0:13:53.24,Default,,0,0,0,,(Лилияның гуілдеуі)
Dialogue: 0,0:13:55.66,0:13:57.46,Default,,0,0,0,,Мен сенің ызылдағаныңды естимін
Dialogue: 0,0:13:58.25,0:14:00.63,Default,,0,0,0,,Бұл техноға ұқсас әуен, сондықтан бұл Лили.
Dialogue: 0,0:14:01.38,0:14:02.21,Default,,0,0,0,,Техно?
Dialogue: 0,0:14:02.92,0:14:04.17,Default,,0,0,0,,Мен сені сүйемін, Лили.
Dialogue: 0,0:14:04.46,0:14:05.34,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:14:05.97,0:14:06.80,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:14:07.80,0:14:10.51,Default,,0,0,0,,А... жоқ, ештеңе.
Dialogue: 0,0:14:10.80,0:14:11.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:12.10,0:14:15.43,Default,,0,0,0,,(Лилияның гуілдеуі)
Dialogue: 0,0:14:15.56,0:14:17.89,Default,,0,0,0,,(Радиода ойналатын музыка)
Dialogue: 0,0:14:18.02,0:14:23.15,Default,,0,0,0,,(Лили әнмен бірге ызылдайды)
Dialogue: 0,0:14:24.23,0:14:26.36,Default,,0,0,0,,Біртүрлі әндерді тыңдаңыз, солай емес пе?
Dialogue: 0,0:14:26.69,0:14:29.15,Default,,0,0,0,,Не? Бұл әйгілі ән
Dialogue: 0,0:14:34.79,0:14:37.29,Default,,0,0,0,,Эрика мұны тыңдамайды.
Dialogue: 0,0:14:44.38,0:14:45.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:52.68,0:14:55.76,Default,,0,0,0,,Эрик Көлік көлік жууға кірді.
Dialogue: 0,0:14:55.97,0:14:57.02,Default,,0,0,0,,Көлік жуу?
Dialogue: 0,0:15:27.38,0:15:29.55,Default,,0,0,0,,Эрик, ол қазір қозғала бастады.
Dialogue: 0,0:15:43.77,0:15:47.32,Default,,0,0,0,,Тек сенімді болу үшін қашықтықты жауып, Лилидің қауіпсіз екеніне көз жеткізіңіз.
Dialogue: 0,0:15:48.19,0:15:49.03,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:15:54.28,0:15:56.20,Default,,0,0,0,,Қалыпты ештеңе жоқ сияқты, бірақ...
Dialogue: 0,0:16:10.46,0:16:12.05,Default,,0,0,0,,Мен ғимаратқа барамын.
Dialogue: 0,0:16:12.97,0:16:14.51,Default,,0,0,0,,Лилидің үйі емес
Dialogue: 0,0:16:15.89,0:16:17.01,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:16:17.30,0:16:18.43,Default,,0,0,0,,Гилберттің үйі.
Dialogue: 0,0:16:18.89,0:16:19.89,Default,,0,0,0,,Е...
Dialogue: 0,0:16:20.77,0:16:23.10,Default,,0,0,0,,Әдеттегідей өзгеріс жоқ
Dialogue: 0,0:16:25.19,0:16:26.56,Default,,0,0,0,,Бірақ Лили бар.
Dialogue: 0,0:16:31.69,0:16:34.24,Default,,0,0,0,,Көліктің іші бос. Лили де іште ме?
Dialogue: 0,0:16:35.03,0:16:36.91,Default,,0,0,0,,Мен іштемін, қозғаламын.
Dialogue: 0,0:16:39.33,0:16:42.00,Default,,0,0,0,,Бөлмелердің ешқайсысында жарық жоқ. Бұл біртүрлі.
Dialogue: 0,0:16:43.00,0:16:43.83,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:16:44.42,0:16:50.21,Default,,0,0,0,,Лили техно деп күбірледі. Осыдан кейін қарым-қатынас бұлыңғыр болды.
Dialogue: 0,0:16:51.13,0:16:51.96,Default,,0,0,0,,Кит…
Dialogue: 0,0:17:21.04,0:17:21.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:24.33,0:17:25.16,Default,,0,0,0,,Таза
Dialogue: 0,0:17:35.72,0:17:36.55,Default,,0,0,0,,Таза
Dialogue: 0,0:17:37.76,0:17:40.05,Default,,0,0,0,,(ұқыпты жүру дыбысы)
Dialogue: 0,0:17:46.94,0:17:48.15,Default,,0,0,0,,О!
Dialogue: 0,0:18:16.84,0:18:17.67,Default,,0,0,0,,Гилберт Росс!
Dialogue: 0,0:18:18.26,0:18:20.43,Default,,0,0,0,,Қолдарыңызды басыңыздың артына қойып, тізеңізге отырыңыз!
Dialogue: 0,0:18:23.51,0:18:24.35,Default,,0,0,0,,Кешіктіріңіз
Dialogue: 0,0:18:25.97,0:18:26.81,Default,,0,0,0,,Гилберт…
Dialogue: 0,0:18:28.19,0:18:31.23,Default,,0,0,0,,Кеш қалды.
Dialogue: 0,0:18:32.52,0:18:33.86,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:18:35.32,0:18:36.86,Default,,0,0,0,,Сегіз жыл.
Dialogue: 0,0:18:38.32,0:18:39.82,Default,,0,0,0,,8 жыл.
Dialogue: 0,0:18:44.66,0:18:46.12,Default,,0,0,0,,Енді ақыры
Dialogue: 0,0:18:46.79,0:18:48.37,Default,,0,0,0,,Шығарылды
Dialogue: 0,0:18:56.71,0:18:58.55,Default,,0,0,0,,А... қаш! Борис!
Dialogue: 0,0:18:59.22,0:19:00.55,Default,,0,0,0,,Марио! тез!
Dialogue: 0,0:19:02.14,0:19:02.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:03.10,0:19:03.93,Default,,0,0,0,,О...
Dialogue: 0,0:19:10.39,0:19:11.81,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:19:12.86,0:19:14.31,Default,,0,0,0,,Бұл реинкарнация сияқты...
Dialogue: 0,0:19:14.44,0:19:17.94,Default,,0,0,0,,Қайталау, мәңгілікке жалғастыру
Dialogue: 0,0:19:18.57,0:19:22.24,Default,,0,0,0,,Мен саған өшірілмейтін кодты ойып аламын!
Dialogue: 0,0:19:23.66,0:19:28.25,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:37.67,0:19:38.51,Default,,0,0,0,,Ха...
Dialogue: 0,0:19:38.59,0:19:40.09,Default,,0,0,0,,А... а...
Dialogue: 0,0:19:42.18,0:19:43.01,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:19:45.22,0:19:48.31,Default,,0,0,0,,Барлық сигналдар жоғалды…
Dialogue: 0,0:19:48.93,0:19:50.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:56.82,0:19:58.94,Default,,0,0,0,,Борис Жауап беріңізші!
Dialogue: 0,0:19:59.74,0:20:01.78,Default,,0,0,0,,Марио күйінің есебі!
Dialogue: 0,0:20:03.03,0:20:06.83,Default,,0,0,0,,Борис Борис! Өтінемін жауап беріңіз!
Dialogue: 0,0:20:08.99,0:20:11.04,Default,,0,0,0,,Борис Жауап беріңізші!
Dialogue: 0,0:20:13.04,0:20:13.87,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:20:19.38,0:20:20.92,Default,,0,0,0,,Кешіріңіз Эрик
Dialogue: 0,0:20:21.34,0:20:22.17,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:20:24.26,0:20:25.09,Default,,0,0,0,,Борис ше?
Dialogue: 0,0:20:25.18,0:20:30.31,Default,,0,0,0,,Уф... әйтеуір мен аман қаламын! Мен жақсы ести алмаймын
Dialogue: 0,0:20:30.47,0:20:31.77,Default,,0,0,0,,Жер бетінде не?
Dialogue: 0,0:20:32.18,0:20:34.52,Default,,0,0,0,,Бұл Гилберт емес, басқа біреу болды.
Dialogue: 0,0:20:34.60,0:20:35.44,Default,,0,0,0,,Не!?
Dialogue: 0,0:20:40.40,0:20:42.86,Default,,0,0,0,,Бұрын дайындалған Реджимен ауыстырылды
Dialogue: 0,0:20:44.20,0:20:45.45,Default,,0,0,0,,8 жыл болуы мүмкін
Dialogue: 0,0:20:45.95,0:20:49.37,Default,,0,0,0,,Қылмыс жасалғанға дейін бірнеше рет қайталанған.
Dialogue: 0,0:20:49.91,0:20:51.79,Default,,0,0,0,,Реджи? Бұл шын ба?
Dialogue: 0,0:20:57.42,0:20:58.75,Default,,0,0,0,,Барлық қызметкерлерге хабарлама
Dialogue: 0,0:20:59.00,0:21:02.80,Default,,0,0,0,,Тергеушінің ұрланған болуы мүмкін. Аймақты мүмкіндігінше тез іздеңіз.
Dialogue: 0,0:21:02.88,0:21:04.88,Default,,0,0,0,,Бірақ бұл тергеудің өзі құпия.
Dialogue: 0,0:21:04.97,0:21:06.55,Default,,0,0,0,,Мен толық жауапкершілікті аламын. Бірден...
Dialogue: 0,0:21:06.64,0:21:07.47,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:21:08.80,0:21:11.01,Default,,0,0,0,,Әлі жолда Осылай жалғастырыңыз
Dialogue: 0,0:21:11.43,0:21:13.39,Default,,0,0,0,,Бұл қиындық. Осылай жалғаса берсе...
Dialogue: 0,0:21:13.52,0:21:14.35,Default,,0,0,0,,Эрик!
Dialogue: 0,0:21:16.85,0:21:18.94,Default,,0,0,0,,Ақаулық - бұл процесс.
Dialogue: 0,0:21:19.73,0:21:22.78,Default,,0,0,0,,Бұрын біз проблемаларды алдын ала шешетінбіз.
Dialogue: 0,0:21:23.40,0:21:26.41,Default,,0,0,0,,Бұл қате болды, сондықтан мен сәтсіздікке ұшырадым.
Dialogue: 0,0:21:26.91,0:21:27.74,Default,,0,0,0,,Кит…
Dialogue: 0,0:21:28.20,0:21:32.16,Default,,0,0,0,,Қиындықтар мен бұзушылықтар сөзсіз және элементтер.
Dialogue: 0,0:21:32.54,0:21:33.79,Default,,0,0,0,,Сіз оны жоққа шығара алмайсыз.
Dialogue: 0,0:21:34.25,0:21:37.71,Default,,0,0,0,,Әр нәрсенің мәні бар, ол әрқашан бір нәрсеге әкеледі
Dialogue: 0,0:21:38.63,0:21:40.13,Default,,0,0,0,,Бірақ Лили...
Dialogue: 0,0:21:40.25,0:21:41.75,Default,,0,0,0,,Маған ешқашан өлуге жол берме
Dialogue: 0,0:21:43.34,0:21:45.42,Default,,0,0,0,,Өтінемін, маған сеніңіз.
Dialogue: 0,0:22:35.14,0:22:36.27,Default,,0,0,0,,Кит?
Dialogue: 0,0:22:41.56,0:22:44.11,Default,,0,0,0,,Сіз қайда болдыңыз? Мен уайымдадым
Dialogue: 0,0:22:44.65,0:22:45.48,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:22:47.74,0:22:48.86,Default,,0,0,0,,Байқалған
Dialogue: 0,0:22:49.15,0:22:52.45,Default,,0,0,0,,Менің ойымша, оны шығаруға әлі уақыт бар.
Dialogue: 0,0:22:53.08,0:22:55.66,Default,,0,0,0,,Мен бұл жерді біраз уақытқа дейін таба алмаймын.
Dialogue: 0,0:22:57.41,0:23:02.42,Default,,0,0,0,,Кит мұнда миын көрсетіп, мақтанышпен келген кезде.
Dialogue: 0,0:23:03.21,0:23:07.21,Default,,0,0,0,,Өсіп келе жатқан әлсіз үміт сөнді.
Dialogue: 0,0:23:07.46,0:23:09.80,Default,,0,0,0,,Жаңа үмітсіздік қайтадан басталады
Dialogue: 0,0:23:15.39,0:23:20.27,Default,,0,0,0,,Бір түс, бір сезім
Dialogue: 0,0:23:20.39,0:23:26.40,Default,,0,0,0,,♪〜
Dialogue: 0,0:25:12.17,0:25:18.18,Default,,0,0,0,,〜♪
