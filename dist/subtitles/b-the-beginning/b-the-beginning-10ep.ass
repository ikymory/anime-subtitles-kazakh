Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:26.73,0:00:28.52,Default,,0,0,0,,Қызыл тәжді тырна деген құс бар.
Dialogue: 0,0:00:29.32,0:00:32.15,Default,,0,0,0,,Қыстауға Гималайдан өтеді. Олар керемет.
Dialogue: 0,0:00:33.28,0:00:35.66,Default,,0,0,0,,Сіз мұны дәл осылай жасай аласыз.
Dialogue: 0,0:00:36.28,0:00:37.16,Default,,0,0,0,,Крандармен?
Dialogue: 0,0:00:38.37,0:00:39.95,Default,,0,0,0,,Солтүстік қабырға
Dialogue: 0,0:00:40.79,0:00:41.87,Default,,0,0,0,,Солтүстік қабырға?
Dialogue: 0,0:00:42.20,0:00:47.13,Default,,0,0,0,,Дұрыс, солтүстік бағытта 15 км/сағ жылдамдықпен секіріңіз.
Dialogue: 0,0:00:48.08,0:00:51.21,Default,,0,0,0,,Осылай 2 секунд құлаған соң, мұнда...
Dialogue: 0,0:00:51.67,0:00:53.01,Default,,0,0,0,,Бррр…
Dialogue: 0,0:00:53.80,0:00:55.26,Default,,0,0,0,,Қанаттарыңды жайыңдар
Dialogue: 0,0:00:57.14,0:01:01.22,Default,,0,0,0,,Егер біз осы кезеңде орын алған жоғарылауды ұстасақ,
Dialogue: 0,0:01:02.31,0:01:04.60,Default,,0,0,0,,Қалғаны автоматты түрде бұлттардың үстінде болады.
Dialogue: 0,0:01:07.31,0:01:11.11,Default,,0,0,0,,Бұлттардың үстінде болғаннан кейін, Канопусқа қарай ұшыңыз.
Dialogue: 0,0:01:11.86,0:01:14.36,Default,,0,0,0,,Канопус... Сізде не бар?
Dialogue: 0,0:01:15.28,0:01:17.45,Default,,0,0,0,,Жұлдыздарға тығылған ақ кеме
Dialogue: 0,0:01:18.62,0:01:19.45,Default,,0,0,0,,Кеме…
Dialogue: 0,0:01:21.12,0:01:25.83,Default,,0,0,0,,Соғыс кезінде жасалған Моби Дик атты үлкен дирижабль.
Dialogue: 0,0:01:26.79,0:01:29.25,Default,,0,0,0,,Маркет-мейкер орналасқан жер
Dialogue: 0,0:01:31.00,0:01:33.42,Default,,0,0,0,,Егер қыз бар болса, ол сонда.
Dialogue: 0,0:01:35.84,0:01:36.72,Default,,0,0,0,,Юна
Dialogue: 0,0:01:39.09,0:01:40.97,Default,,0,0,0,,Сіз мені күтіп отыр деп ойлайсыз ба?
Dialogue: 0,0:01:44.31,0:01:45.48,Default,,0,0,0,,Мен мұны бұрын да айтқанмын.
Dialogue: 0,0:01:46.31,0:01:49.40,Default,,0,0,0,,Қара түсті жазуды ашқан мен болдым.
Dialogue: 0,0:01:49.77,0:01:50.61,Default,,0,0,0,,О
Dialogue: 0,0:01:50.69,0:01:53.15,Default,,0,0,0,,Бұл кейіпкерді ашу мүмкін емес деп айтылды.
Dialogue: 0,0:01:53.69,0:01:56.03,Default,,0,0,0,,Біріктіру және оқу бағытына байланысты
Dialogue: 0,0:01:56.36,0:01:58.53,Default,,0,0,0,,Себебі мағына еркін өзгереді.
Dialogue: 0,0:01:59.61,0:02:06.54,Default,,0,0,0,,Тік Көлденең диагональ тақ жұп негізгі түбір Сансыз үлгілер бар.
Dialogue: 0,0:02:07.41,0:02:10.04,Default,,0,0,0,,Барлығы сөйлем ретінде жарамды
Dialogue: 0,0:02:11.63,0:02:12.75,Default,,0,0,0,,Білетіндер аз болса да
Dialogue: 0,0:02:13.71,0:02:16.71,Default,,0,0,0,,Бір тас тақтайшаны Киелі кітаппен салыстыруға болады.
Dialogue: 0,0:02:16.80,0:02:19.80,Default,,0,0,0,,Онда көптеген ақпараттар мен мифтер жазылған.
Dialogue: 0,0:02:23.01,0:02:25.64,Default,,0,0,0,,Жарайды, ол теңеу мен метафораға толы.
Dialogue: 0,0:02:25.72,0:02:28.89,Default,,0,0,0,,Не болса да алуға болатын мазмұн көп.
Dialogue: 0,0:02:31.06,0:02:33.23,Default,,0,0,0,,Кейбір үзінділерді елемеу қиын.
Dialogue: 0,0:02:35.19,0:02:37.03,Default,,0,0,0,,«Екі әулие қыз» тарауы
Dialogue: 0,0:02:38.65,0:02:40.45,Default,,0,0,0,,«Толық айдың 13-ші түні»
Dialogue: 0,0:02:40.86,0:02:42.78,Default,,0,0,0,,``Екі әулие қыз таңдаған адам''
Dialogue: 0,0:02:42.87,0:02:47.12,Default,,0,0,0,,``Күш, серік, қанатқа ие болып, қара қауырсындардың патшасы болды.''
Dialogue: 0,0:02:48.54,0:02:50.08,Default,,0,0,0,,«Екі ғибадатхана өз міндеттерін аяқтады».
Dialogue: 0,0:02:50.16,0:02:53.50,Default,,0,0,0,,«Көк семсерді патшаның алдына көрсет».
Dialogue: 0,0:02:54.38,0:02:56.46,Default,,0,0,0,,«Мен саған бір басыңды кесіп ал деп айттым».
Dialogue: 0,0:02:58.13,0:02:59.88,Default,,0,0,0,,«Басы кесілген әулие қыз»
Dialogue: 0,0:03:00.05,0:03:04.35,Default,,0,0,0,,«Күлге айнал және патшамен ассимиляциялан, оған жаңа билік бер».
Dialogue: 0,0:03:05.81,0:03:10.18,Default,,0,0,0,,«Таңдалған діни қызметкер менің әйелім болып, Кремонаның шыңында шайқасады».
Dialogue: 0,0:03:10.44,0:03:12.85,Default,,0,0,0,,«Тағдырымызды соңына дейін бөлістік»
Dialogue: 0,0:03:14.94,0:03:15.77,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:03:17.44,0:03:19.57,Default,,0,0,0,,Сіздің ойыңыз жоқ па?
Dialogue: 0,0:03:23.45,0:03:28.83,Default,,0,0,0,,Мен және менің әкем, жоқ... бұған барлығы қатысты.
Dialogue: 0,0:03:29.62,0:03:31.79,Default,,0,0,0,,Сол тас тақта мені қозғап тұр.
Dialogue: 0,0:03:32.92,0:03:34.58,Default,,0,0,0,,Мәңгілік уақыт
Dialogue: 0,0:03:34.67,0:03:37.67,Default,,0,0,0,,Тағдырды еркін басқаратын адамды құдай десеңіз.
Dialogue: 0,0:03:38.67,0:03:41.63,Default,,0,0,0,,Сол тас тақта Құдайдың өзі.
Dialogue: 0,0:03:48.85,0:03:51.64,Default,,0,0,0,,Жазу бізді қозғаса ше?
Dialogue: 0,0:03:53.35,0:03:55.10,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:03:56.40,0:03:58.23,Default,,0,0,0,,Юна... өледі
Dialogue: 0,0:04:06.24,0:04:08.41,Default,,0,0,0,,Тағдыр деген бар болса
Dialogue: 0,0:04:09.08,0:04:10.54,Default,,0,0,0,,Барлығын қабылдаңыз
Dialogue: 0,0:04:11.29,0:04:14.33,Default,,0,0,0,,Ұнамаса, қарсы тұр.
Dialogue: 0,0:04:17.34,0:04:18.17,Default,,0,0,0,,Куробане
Dialogue: 0,0:04:19.38,0:04:20.92,Default,,0,0,0,,Болашақтан қорықпа
Dialogue: 0,0:04:22.13,0:04:26.34,Default,,0,0,0,,Үмітті де, үмітсіздікті де өз көзіңмен көр
Dialogue: 0,0:04:55.00,0:04:56.08,Default,,0,0,0,,Бұл бастама
Dialogue: 0,0:05:00.50,0:05:03.17,Default,,0,0,0,,Сен екеуміз халқымызды құтқарамыз.
Dialogue: 0,0:05:03.76,0:05:04.76,Default,,0,0,0,,Мұндай жағдайға жол беруге болмайды!
Dialogue: 0,0:05:06.97,0:05:10.05,Default,,0,0,0,,Оның әлемі бұлттардың астында
Dialogue: 0,0:05:11.01,0:05:13.60,Default,,0,0,0,,Жұлдыздарға қарай қалықтасам да
Dialogue: 0,0:05:14.77,0:05:17.90,Default,,0,0,0,,Мұз қанаттарыңды күйдіріп, құлайсың.
Dialogue: 0,0:05:21.40,0:05:23.28,Default,,0,0,0,,Икар сияқты
Dialogue: 0,0:05:26.36,0:05:27.66,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:05:29.66,0:05:31.95,Default,,0,0,0,,Куробан болуы керек...
Dialogue: 0,0:05:42.34,0:05:48.34,Default,,0,0,0,,♪〜
Dialogue: 0,0:05:51.22,0:05:57.23,Default,,0,0,0,,〜♪
Dialogue: 0,0:06:00.73,0:06:04.78,Default,,0,0,0,,Мен үлкен көшені пайдаланбас едім. Мен уақытты есептей алмаймын.
Dialogue: 0,0:06:05.11,0:06:07.74,Default,,0,0,0,,Бұны таңдау сенімдірек.
Dialogue: 0,0:06:08.11,0:06:09.70,Default,,0,0,0,,Аллеяда көбірек байқалады.
Dialogue: 0,0:06:10.45,0:06:11.87,Default,,0,0,0,,Ол қашып жүр.
Dialogue: 0,0:06:12.41,0:06:15.37,Default,,0,0,0,,Сіз кептеліс болатынын білетін жолға барасыз ба?
Dialogue: 0,0:06:15.79,0:06:20.75,Default,,0,0,0,,Ештеңе етпейді, ол үшін күнделікті жұмыс.
Dialogue: 0,0:06:21.21,0:06:23.71,Default,,0,0,0,,Күнделікті мінсіз өмір деуге бола ма...
Dialogue: 0,0:06:24.67,0:06:28.47,Default,,0,0,0,,Хмм, қалай болғанда да, нәтиже қазіргідей түсініксіз.
Dialogue: 0,0:06:28.63,0:06:30.26,Default,,0,0,0,,Біз ауқымды одан әрі тарылтуымыз керек.
Dialogue: 0,0:06:30.34,0:06:31.97,Default,,0,0,0,,Ааааах!!
Dialogue: 0,0:06:32.26,0:06:34.47,Default,,0,0,0,,Бұрын қолданылған топтық іздеу бағдарламалық құралы
Dialogue: 0,0:06:37.43,0:06:38.77,Default,,0,0,0,,Бұл жұмыс істеуі мүмкін
Dialogue: 0,0:06:39.69,0:06:40.52,Default,,0,0,0,,О
Dialogue: 0,0:06:41.60,0:06:45.23,Default,,0,0,0,,Тұрақты емес қозғалатын көліктерге әрекет ету үшін оны жай ғана реттеңіз.
Dialogue: 0,0:06:45.61,0:06:46.44,Default,,0,0,0,,«Лайт» жарайды.
Dialogue: 0,0:06:46.61,0:06:49.24,Default,,0,0,0,,Менің қолымнан келеді, бірақ... бұл біраз мәселе.
Dialogue: 0,0:06:50.20,0:06:51.66,Default,,0,0,0,,Жерсерік жеткіліксіз
Dialogue: 0,0:06:52.12,0:06:56.37,Default,,0,0,0,,Мен Жерді кем дегенде 200 миллион 1,8 км шаршыға бөлінгенін түсінгім келеді.
Dialogue: 0,0:06:56.66,0:06:57.75,Default,,0,0,0,,Сізге қанша керек?
Dialogue: 0,0:06:58.00,0:06:59.04,Default,,0,0,0,,Тағы екі
Dialogue: 0,0:07:00.79,0:07:01.62,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:07:02.88,0:07:03.79,Default,,0,0,0,,Жақсы, солай ма?
Dialogue: 0,0:07:06.17,0:07:07.00,Default,,0,0,0,,Қап…
Dialogue: 0,0:07:08.80,0:07:09.63,Default,,0,0,0,,Сіз бара аласыз ба?
Dialogue: 0,0:07:10.05,0:07:11.22,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:12.05,0:07:14.22,Default,,0,0,0,,Мен мұны баяғыда сол жердегі бір қариядан білдім.
Dialogue: 0,0:07:16.35,0:07:18.72,Default,,0,0,0,,Лилидің өміріне қауіп төніп тұр, асығыңыз!
Dialogue: 0,0:07:29.15,0:07:30.49,Default,,0,0,0,,Ешқандай көмек келмейді
Dialogue: 0,0:07:32.57,0:07:34.95,Default,,0,0,0,,Ол бұл жерді қалай тапты?
Dialogue: 0,0:07:35.53,0:07:38.24,Default,,0,0,0,,Менің уақытым жеткіліксіз.
Dialogue: 0,0:07:41.66,0:07:42.50,Default,,0,0,0,,шықты
Dialogue: 0,0:07:43.08,0:07:43.92,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:07:44.17,0:07:46.21,Default,,0,0,0,,Портқа, теңізге қарай бет алды ма?
Dialogue: 0,0:07:46.92,0:07:50.47,Default,,0,0,0,,Каэла, маған осы нүктенің айналасындағы қозғалыс ауқымын көрсетіңізші.
Dialogue: 0,0:07:50.55,0:07:51.92,Default,,0,0,0,,Бұл кеме. (Кейт) Иә.
Dialogue: 0,0:07:52.30,0:07:53.13,Default,,0,0,0,,Жылдамдық дегеніміз не?
Dialogue: 0,0:07:53.22,0:07:55.60,Default,,0,0,0,,Орташа мән жақсы. Теңізде кептеліс жоқ.
Dialogue: 0,0:07:56.22,0:07:57.43,Default,,0,0,0,,22 түйін
Dialogue: 0,0:07:57.51,0:08:00.18,Default,,0,0,0,,Сіз 0,5 миль дейсіз бе? Қате қандай?
Dialogue: 0,0:08:00.56,0:08:01.60,Default,,0,0,0,,Басқа түспен көрсету
Dialogue: 0,0:08:04.44,0:08:05.27,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:08:05.40,0:08:10.03,Default,,0,0,0,,Рамон портының аймағы Әскери мүлік және негізінен жұртшылық үшін жабық.
Dialogue: 0,0:08:10.49,0:08:13.57,Default,,0,0,0,,Рамон? Мен бірдеңе естідім...
Dialogue: 0,0:08:13.91,0:08:15.91,Default,,0,0,0,,Бұл Рамон психиатриялық ауруханасы емес пе?
Dialogue: 0,0:08:16.91,0:08:18.03,Default,,0,0,0,,Өлі Кайл...
Dialogue: 0,0:08:20.08,0:08:22.79,Default,,0,0,0,,Иә, бұл мен барған аурухана.
Dialogue: 0,0:08:22.96,0:08:23.83,Default,,0,0,0,,Аурухана…
Dialogue: 0,0:08:24.17,0:08:26.83,Default,,0,0,0,,Өйткені Кайлдың асырап алған әкесі Әскери-теңіз күштерінде болған.
Dialogue: 0,0:08:27.08,0:08:30.13,Default,,0,0,0,,Бұл сіздің айтып тұрғаныңыз емес пе?
Dialogue: 0,0:08:30.88,0:08:32.72,Default,,0,0,0,,Олардың бізге қатысы бар сияқты.
Dialogue: 0,0:08:32.80,0:08:33.63,Default,,0,0,0,,Не?
Dialogue: 0,0:08:34.30,0:08:35.13,Default,,0,0,0,,Өзі құдаймын деп айтқан адаммен кездескен сол күннен бері
Dialogue: 0,0:08:35.93,0:08:37.60,Default,,0,0,0,,Талап етілмеген органдар
Dialogue: 0,0:08:37.68,0:08:41.10,Default,,0,0,0,,Үлгілерді зертханаларға үлгі ретінде жеткізуге болатын сияқты.
Dialogue: 0,0:08:41.47,0:08:43.52,Default,,0,0,0,,Мәйіт? материалдарды жеткізу?
Dialogue: 0,0:08:49.07,0:08:51.94,Default,,0,0,0,,Қайтыс болғанына бір жыл толды... Бір жыл ерте.
Dialogue: 0,0:08:53.36,0:08:56.66,Default,,0,0,0,,Сіз әлі іздеп жүрсіз бе? Жеті жыл болды.
Dialogue: 0,0:08:57.28,0:08:59.28,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:09:00.66,0:09:04.96,Default,,0,0,0,,Сізбен сөйлескенім шынымен темекі тартқым келеді.
Dialogue: 0,0:09:05.92,0:09:06.96,Default,,0,0,0,,Эрика...
Dialogue: 0,0:10:21.57,0:10:25.45,Default,,0,0,0,,Бұл ел сіз ойлағаннан да көп тастанды реггилерге толы.
Dialogue: 0,0:10:28.16,0:10:31.38,Default,,0,0,0,,Бұл туралы ешкім білмейді.
Dialogue: 0,0:10:33.59,0:10:34.42,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:10:59.90,0:11:00.74,Default,,0,0,0,,Бұл үлгі.
Dialogue: 0,0:11:05.37,0:11:06.20,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:08.33,0:11:09.16,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:11:24.39,0:11:25.22,Default,,0,0,0,,Бұл үлгі.
Dialogue: 0,0:11:34.31,0:11:35.15,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:57.63,0:12:00.46,Default,,0,0,0,,Каэла Гилберттің шығу жазбасын тексеріңіз.
Dialogue: 0,0:12:00.80,0:12:03.26,Default,,0,0,0,,Не? Зертханада? Иә
Dialogue: 0,0:12:04.93,0:12:06.14,Default,,0,0,0,,Иә!? Өтірік...
Dialogue: 0,0:12:07.35,0:12:11.60,Default,,0,0,0,,Гилберт Росс зертханадан шыққан жоқ.
Dialogue: 0,0:12:11.81,0:12:12.64,Default,,0,0,0,,Не!?
Dialogue: 0,0:12:12.73,0:12:16.69,Default,,0,0,0,,Гилберт соңғы 8 жылда неше рет 24 сағаттан артық жұмыс істеді?
Dialogue: 0,0:12:17.31,0:12:18.52,Default,,0,0,0,,37 рет
Dialogue: 0,0:12:19.82,0:12:24.24,Default,,0,0,0,,Шашы қара, терісі ақ, көзі қоңыр
Dialogue: 0,0:12:24.82,0:12:27.78,Default,,0,0,0,,25 жас шамасындағы және 160 см-ден төмен әйелдер
Dialogue: 0,0:12:28.53,0:12:31.08,Default,,0,0,0,,Осы шартқа қанша шешілмеген жоғалулар сәйкес келеді?
Dialogue: 0,0:12:31.62,0:12:32.96,Default,,0,0,0,,37 пункт
Dialogue: 0,0:12:33.08,0:12:33.91,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:12:34.92,0:12:38.46,Default,,0,0,0,,Гилберттің ұясы екені даусыз
Dialogue: 0,0:12:40.30,0:12:41.17,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:13:05.07,0:13:07.53,Default,,0,0,0,,Каэла Маған осы жердің суретін бере аласыз ба?
Dialogue: 0,0:13:09.53,0:13:11.54,Default,,0,0,0,,Бірнеше бар сияқты, бірақ қайсысы?
Dialogue: 0,0:13:11.62,0:13:12.45,Default,,0,0,0,,Барлығы.
Dialogue: 0,0:13:15.54,0:13:17.04,Default,,0,0,0,,Өте ерекше
Dialogue: 0,0:13:17.25,0:13:19.79,Default,,0,0,0,,Оның кеңейтілгеніне 300 жыл болды.
Dialogue: 0,0:13:20.42,0:13:23.42,Default,,0,0,0,,Сонда әр қабаттың стилі әртүрлі?
Dialogue: 0,0:13:24.63,0:13:25.47,Default,,0,0,0,,Каэла
Dialogue: 0,0:13:25.67,0:13:28.26,Default,,0,0,0,,Сызбаларды жылдарға бөліп көрсетіңіз.
Dialogue: 0,0:13:28.39,0:13:29.93,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:13:30.01,0:13:34.35,Default,,0,0,0,,Шатыр мен еденді қоса алғанда, бос орын қосылды
Dialogue: 0,0:13:34.48,0:13:37.77,Default,,0,0,0,,Өлі кеңістікті 180 см немесе одан жоғары биіктікте көрсету
Dialogue: 0,0:13:37.85,0:13:40.65,Default,,0,0,0,,Міне... иә
Dialogue: 0,0:13:41.32,0:13:42.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:42.73,0:13:45.90,Default,,0,0,0,,Дәл менің алдымда, бірақ оны ешкім байқамайды
Dialogue: 0,0:13:46.45,0:13:47.70,Default,,0,0,0,,Каэла Қолдау шақыру
Dialogue: 0,0:13:47.95,0:13:49.37,Default,,0,0,0,,Жоқ, неге?
Dialogue: 0,0:13:50.03,0:13:53.58,Default,,0,0,0,,Мұқият ойлан. Оның барлығын өзі жасай ала ма?
Dialogue: 0,0:13:53.91,0:13:54.83,Default,,0,0,0,,Мүлде мүмкін емес.
Dialogue: 0,0:13:56.00,0:13:56.83,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:13:57.87,0:14:00.75,Default,,0,0,0,,Ол жерде қанша инсайдер тығылып жатқанын білмейміз.
Dialogue: 0,0:14:01.17,0:14:04.67,Default,,0,0,0,,Мүмкін біз азшылықта шығармыз.
Dialogue: 0,0:14:05.01,0:14:07.72,Default,,0,0,0,,Шешуші соққыны тигізбесең, бірінші болып тастайсың.
Dialogue: 0,0:14:07.80,0:14:09.09,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:14:10.30,0:14:12.39,Default,,0,0,0,,Бәрін өзіміз бітіреміз
Dialogue: 0,0:14:14.52,0:14:15.35,Default,,0,0,0,,Оны шешіңіз.
Dialogue: 0,0:15:11.70,0:15:13.82,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:15:16.95,0:15:17.79,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:19.46,0:15:20.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:20.66,0:15:21.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:34.26,0:15:37.72,Default,,0,0,0,,Гилбертті қорғағаннан кейін не істеуді жоспарлайсыз?
Dialogue: 0,0:15:53.53,0:15:54.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:56.74,0:15:57.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:03.75,0:16:04.79,Default,,0,0,0,,Полиция бөлімінде...
Dialogue: 0,0:16:05.58,0:16:07.17,Default,,0,0,0,,Мынадай кеңістік...
Dialogue: 0,0:16:10.59,0:16:13.01,Default,,0,0,0,,Мынадай... осылай!
Dialogue: 0,0:16:25.10,0:16:26.15,Default,,0,0,0,,Пузо...
Dialogue: 0,0:16:26.98,0:16:27.82,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:16:28.57,0:16:31.69,Default,,0,0,0,,Тәңірлік қанды жаңғырту ұйымы
Dialogue: 0,0:16:32.19,0:16:36.07,Default,,0,0,0,,Фаура Бранка институтының соңғы басшысы
Dialogue: 0,0:16:36.53,0:16:37.91,Default,,0,0,0,,Альберт Пузо
Dialogue: 0,0:16:38.66,0:16:43.04,Default,,0,0,0,,Гилберт Росстың әкесі және өлтірілген бірінші адам.
Dialogue: 0,0:16:46.00,0:16:48.04,Default,,0,0,0,,Ол осылай бастады.
Dialogue: 0,0:16:52.51,0:16:54.43,Default,,0,0,0,,Мұнда барлығын өз бетімен жасайсың!?
Dialogue: 0,0:16:54.97,0:16:58.22,Default,,0,0,0,,37 Тіпті бір адам емес.Не үшін?
Dialogue: 0,0:16:58.35,0:16:59.22,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:16:59.30,0:17:04.02,Default,,0,0,0,,Білмейсіз бе? Бұл әзіл емес! Бұл ақылсыз! Кит!
Dialogue: 0,0:17:04.85,0:17:06.35,Default,,0,0,0,,Бұл жай ғана ақылсыздық!
Dialogue: 0,0:17:08.23,0:17:10.36,Default,,0,0,0,,Мен оны көптен бері қарап жүрмін.
Dialogue: 0,0:17:11.03,0:17:13.44,Default,,0,0,0,,Оны да байқаған болар.
Dialogue: 0,0:17:14.53,0:17:16.16,Default,,0,0,0,,Бірақ ештеңе өзгермейді
Dialogue: 0,0:17:17.24,0:17:22.75,Default,,0,0,0,,Адамдарды тыныс алғандай өлтіріп, ештеңе болмағандай күнделікті өмірге қайта оралу.
Dialogue: 0,0:17:24.54,0:17:27.46,Default,,0,0,0,,Бірнеше күннен кейін тағы біреу қамауға алынды.
Dialogue: 0,0:17:27.88,0:17:30.75,Default,,0,0,0,,Мойындағаннан кейін қандай да бір жолмен өліңіз
Dialogue: 0,0:17:31.55,0:17:34.47,Default,,0,0,0,,Өзін-өзі өлтіру Аурудан өлім
Dialogue: 0,0:17:36.01,0:17:37.76,Default,,0,0,0,,Барлығын қалпына келтіргеннен кейін
Dialogue: 0,0:17:38.80,0:17:41.85,Default,,0,0,0,,Сол бір күнделікті өмірді қайталайды
Dialogue: 0,0:17:44.43,0:17:47.27,Default,,0,0,0,,Сіз соншалықты ақымақ бола алмайсыз ...
Dialogue: 0,0:17:47.48,0:17:48.31,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:17:49.19,0:17:53.19,Default,,0,0,0,,Ұлы күш, жазықсыз жүрек және...
Dialogue: 0,0:17:54.07,0:17:56.82,Default,,0,0,0,,Сізге тек адамнан тыс ми қажет
Dialogue: 0,0:17:57.45,0:17:58.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:59.16,0:18:01.08,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:18:06.66,0:18:09.79,Default,,0,0,0,,Эй, Кит, сен әлі сондасың ба?
Dialogue: 0,0:18:11.67,0:18:12.59,Default,,0,0,0,,Лили ше?
Dialogue: 0,0:18:13.09,0:18:15.59,Default,,0,0,0,,Сіз шынымен Эрикаға ұқсайсыз.
Dialogue: 0,0:18:16.22,0:18:18.80,Default,,0,0,0,,Терінің түсі мен көзінің түсі бірдей
Dialogue: 0,0:18:19.93,0:18:22.89,Default,,0,0,0,,Енді менің не істегенімді қалайсың?
Dialogue: 0,0:18:24.43,0:18:25.43,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:18:25.72,0:18:26.56,Default,,0,0,0,,Е...
Dialogue: 0,0:18:31.48,0:18:33.61,Default,,0,0,0,,Сіз тек бір скальпель қолдандыңыз ба?
Dialogue: 0,0:18:35.07,0:18:38.03,Default,,0,0,0,,Сіз қатты үрейленіп қашып кеткен сияқтысыз.
Dialogue: 0,0:18:40.16,0:18:41.70,Default,,0,0,0,,Сіз тым ерте келдіңіз бе?
Dialogue: 0,0:18:42.87,0:18:44.28,Default,,0,0,0,,Лили жоқ
Dialogue: 0,0:18:44.62,0:18:45.91,Default,,0,0,0,,Тіпті өлген жоқ
Dialogue: 0,0:18:46.79,0:18:50.37,Default,,0,0,0,,Өлген Лилия мені тоқтата алмайды.
Dialogue: 0,0:18:52.04,0:18:55.38,Default,,0,0,0,,Гилберт Мен қазір бұрынғыдан басқашамын.
Dialogue: 0,0:18:56.71,0:18:58.22,Default,,0,0,0,,Менің достарым бар.
Dialogue: 0,0:18:58.51,0:19:01.26,Default,,0,0,0,,(Гильберттің күлкісі)
Dialogue: 0,0:19:01.34,0:19:03.64,Default,,0,0,0,,Мені күлдірмеші, досым?
Dialogue: 0,0:19:04.43,0:19:06.56,Default,,0,0,0,,(Гильберттің күлкісі)
Dialogue: 0,0:19:06.64,0:19:09.14,Default,,0,0,0,,Сен бүгін түнде қашып кетесің
Dialogue: 0,0:19:09.98,0:19:11.94,Default,,0,0,0,,Әзірше жақсы, қаш.
Dialogue: 0,0:19:13.19,0:19:18.99,Default,,0,0,0,,Бірақ қанша жүрсек те, алда бар нәрсе – үмітсіздік пен қараңғылық.
Dialogue: 0,0:19:20.36,0:19:23.16,Default,,0,0,0,,Мен оны міндетті түрде тауып, бұрышқа саламын.
Dialogue: 0,0:19:23.78,0:19:27.20,Default,,0,0,0,,Ал мен сені өз қолыммен өлтіремін
Dialogue: 0,0:19:27.74,0:19:30.00,Default,,0,0,0,,Мен бұл сөздерді естігеніме қуаныштымын.
Dialogue: 0,0:19:30.37,0:19:32.58,Default,,0,0,0,,Менің досым Кит Фрик
Dialogue: 0,0:19:46.01,0:19:47.47,Default,,0,0,0,,О, кешіріңіз, бұл...
Dialogue: 0,0:19:47.56,0:19:48.81,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:49.27,0:19:51.06,Default,,0,0,0,,Ах... (мылтық атылды)
Dialogue: 0,0:19:53.10,0:19:54.10,Default,,0,0,0,,Лилия!
Dialogue: 0,0:19:54.31,0:19:55.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:58.65,0:20:01.20,Default,,0,0,0,,бұл...уф!
Dialogue: 0,0:20:09.33,0:20:10.16,Default,,0,0,0,,Лилия!
Dialogue: 0,0:20:12.87,0:20:13.79,Default,,0,0,0,,Кит (Кит) Міне!
Dialogue: 0,0:20:15.96,0:20:17.17,Default,,0,0,0,,Маған бірдеңе соғып жатыр
Dialogue: 0,0:20:17.88,0:20:20.71,Default,,0,0,0,,Лилия! Лилия! Мықты болыңыз!
Dialogue: 0,0:20:21.05,0:20:22.38,Default,,0,0,0,,Жарайды, мені жібер!
Dialogue: 0,0:20:25.30,0:20:26.14,Default,,0,0,0,,Лилия!
Dialogue: 0,0:20:26.51,0:20:27.39,Default,,0,0,0,,Келесі орын – оңтүстік-оңтүстік-шығыс!
Dialogue: 0,0:20:27.55,0:20:29.68,Default,,0,0,0,,Қазір желіні тастаңыз! Және жедел жәрдем!
Dialogue: 0,0:20:30.06,0:20:30.89,Default,,0,0,0,,Каэла!
Dialogue: 0,0:20:30.97,0:20:32.31,Default,,0,0,0,,Ах! иә!
Dialogue: 0,0:20:32.77,0:20:36.69,Default,,0,0,0,,Гилберт қашып кетті. Полиция бөлімшесінің айналасын дереу бекітіңіз.
Dialogue: 0,0:20:36.94,0:20:38.27,Default,,0,0,0,,Ол, бәлкім, өліп қалар.
Dialogue: 0,0:20:38.73,0:20:40.48,Default,,0,0,0,,Лилия қауіпсіз түрде қорғалды.
Dialogue: 0,0:20:40.86,0:20:41.69,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:20:42.32,0:20:46.70,Default,,0,0,0,,Бірақ есірткі беріп жатқан Широны ұйымдастырыңыз.
Dialogue: 0,0:20:46.78,0:20:47.62,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:20:52.16,0:20:53.87,Default,,0,0,0,,Сіз бұл жерден қашып кеттіңіз бе?
Dialogue: 0,0:21:00.46,0:21:02.59,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:21:05.84,0:21:06.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:13.23,0:21:14.89,Default,,0,0,0,,Алдын ала кесте
Dialogue: 0,0:21:15.35,0:21:18.40,Default,,0,0,0,,Корольдік полициямен байланысты барлық адамдарды өлтіріңіз.
Dialogue: 0,0:21:18.48,0:21:21.32,Default,,0,0,0,,Қазір! Сіз газды пайдалана аласыз!
Dialogue: 0,0:21:22.78,0:21:24.11,Default,,0,0,0,,Қазір бос емес
Dialogue: 0,0:21:24.28,0:21:25.11,Default,,0,0,0,,Не?
Dialogue: 0,0:21:25.82,0:21:27.53,Default,,0,0,0,,Менің де қолым тоқ.
Dialogue: 0,0:21:28.24,0:21:30.20,Default,,0,0,0,,Менің бұған араласуға уақытым жоқ.
Dialogue: 0,0:21:30.66,0:21:33.00,Default,,0,0,0,,Сіз мені қалжыңдап тұрсыз ба?
Dialogue: 0,0:21:33.08,0:21:34.79,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:21:37.62,0:21:40.67,Default,,0,0,0,,Маған көмектескеніңіз үшін ризамын.
Dialogue: 0,0:21:42.25,0:21:43.09,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:43.63,0:21:46.43,Default,,0,0,0,,Біз сізге де көмектестік.
Dialogue: 0,0:21:47.22,0:21:48.14,Default,,0,0,0,,Миназуки...
Dialogue: 0,0:21:48.47,0:21:50.72,Default,,0,0,0,,Кешіріңіз, менің бір ісім бар.
Dialogue: 0,0:21:51.31,0:21:52.97,Default,,0,0,0,,Эй, күте тұр, Минадзуки!
Dialogue: 0,0:22:16.33,0:22:19.29,Default,,0,0,0,,Сенің тілектеріңді орындау үшін!
Dialogue: 0,0:22:20.04,0:22:22.17,Default,,0,0,0,,Қат! Қарғы сатқыр!
Dialogue: 0,0:22:22.59,0:22:24.59,Default,,0,0,0,,Қат! Қарғы сатқыр! Қарғы сатқыр!
Dialogue: 0,0:22:26.42,0:22:28.22,Default,,0,0,0,,Хаа…
Dialogue: 0,0:22:29.30,0:22:31.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:32.14,0:22:34.06,Default,,0,0,0,,(терең тыныс алу дыбысы)
Dialogue: 0,0:22:34.64,0:22:37.35,Default,,0,0,0,,Бірақ бұл демондарға да қатысты.
Dialogue: 0,0:22:47.03,0:22:50.16,Default,,0,0,0,,Мен Китті жеңе алмайтынымды білдім.
Dialogue: 0,0:22:51.07,0:22:52.32,Default,,0,0,0,,Мен оны білдім.
Dialogue: 0,0:22:54.79,0:22:56.95,Default,,0,0,0,,Бірақ ол жігіт...
Dialogue: 0,0:23:00.75,0:23:01.92,Default,,0,0,0,,Эрика, барма.
Dialogue: 0,0:23:02.75,0:23:05.09,Default,,0,0,0,,бұл... Эрика!
Dialogue: 0,0:23:05.42,0:23:06.25,Default,,0,0,0,,Эрика!
Dialogue: 0,0:23:07.17,0:23:09.51,Default,,0,0,0,,Эрика! Эрика!
Dialogue: 0,0:23:09.88,0:23:11.59,Default,,0,0,0,,Эрика! Эрика!
Dialogue: 0,0:23:12.22,0:23:13.05,Default,,0,0,0,,Барма...
Dialogue: 0,0:23:18.10,0:23:20.56,Default,,0,0,0,,Мені жалғыз қалдырмаңыз
Dialogue: 0,0:23:22.31,0:23:23.15,Default,,0,0,0,,Эрика...
Dialogue: 0,0:23:31.57,0:23:33.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:34.12,0:23:36.70,Default,,0,0,0,,Ақыры өлді ме? иә?
Dialogue: 0,0:23:43.00,0:23:44.46,Default,,0,0,0,,Ммм... Мм.
Dialogue: 0,0:23:46.92,0:23:51.68,Default,,0,0,0,,Барлығы, мынау, болжамды түрде қозғалатыны сонша, бұл күлкілі.
Dialogue: 0,0:23:52.68,0:23:53.72,Default,,0,0,0,,Бұл қарапайым
Dialogue: 0,0:24:00.64,0:24:02.39,Default,,0,0,0,,Эпилог қана қалды
Dialogue: 0,0:24:03.69,0:24:05.77,Default,,0,0,0,,Аяқтаймыз, Гени.
Dialogue: 0,0:24:06.52,0:24:12.53,Default,,0,0,0,,♪〜
Dialogue: 0,0:25:58.09,0:26:04.10,Default,,0,0,0,,〜♪
