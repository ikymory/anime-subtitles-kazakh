Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:30.40,0:00:32.19,Default,,0,0,0,,Бұл таза ақ~
Dialogue: 0,0:00:36.16,0:00:39.70,Default,,0,0,0,,Йоккора Шотто
Dialogue: 0,0:00:40.20,0:00:42.37,Default,,0,0,0,,Ол ақ түске боялмаған.
Dialogue: 0,0:00:43.41,0:00:47.33,Default,,0,0,0,,Сансыз математикалық формулалар мен фигуралар қабаттасып ақ түсті.
Dialogue: 0,0:00:48.79,0:00:50.88,Default,,0,0,0,,Басында қарамен жазылған шығар.
Dialogue: 0,0:00:51.71,0:00:54.30,Default,,0,0,0,,Ол қою қара түске боялған, сондықтан мен оны ақ түспен жаза бастадым.
Dialogue: 0,0:00:55.59,0:00:56.93,Default,,0,0,0,,Әлі де жеткіліксіз
Dialogue: 0,0:00:57.18,0:01:00.06,Default,,0,0,0,,Уақыт өте келе таза тақталардың саны өсті.
Dialogue: 0,0:01:01.39,0:01:02.47,Default,,0,0,0,,Бір нәрсе...
Dialogue: 0,0:01:03.06,0:01:05.06,Default,,0,0,0,,Осыған қарасам, әрқайсысы
Dialogue: 0,0:01:05.14,0:01:07.40,Default,,0,0,0,,Бұл Киттің айқайына ұқсай бастайды.
Dialogue: 0,0:01:09.19,0:01:10.02,Default,,0,0,0,,Хаа…
Dialogue: 0,0:01:11.73,0:01:12.65,Default,,0,0,0,,Лилия…
Dialogue: 0,0:01:23.24,0:01:25.91,Default,,0,0,0,,Кит қандай жауапты іздейді?
Dialogue: 0,0:01:26.83,0:01:28.00,Default,,0,0,0,,Маған қызық, бұл не...
Dialogue: 0,0:01:43.35,0:01:45.68,Default,,0,0,0,,(толқындардың дыбысы)
Dialogue: 0,0:01:51.86,0:01:53.27,Default,,0,0,0,,Аа...
Dialogue: 0,0:02:02.12,0:02:08.12,Default,,0,0,0,,♪〜
Dialogue: 0,0:02:11.00,0:02:17.01,Default,,0,0,0,,〜♪
Dialogue: 0,0:02:33.27,0:02:35.69,Default,,0,0,0,,Неге... көмектестің?
Dialogue: 0,0:02:36.65,0:02:39.32,Default,,0,0,0,,Мен сізден тағы бір нәрсе сұрағым келеді.
Dialogue: 0,0:02:39.45,0:02:40.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:40.74,0:02:44.99,Default,,0,0,0,,Ей, қазір тамақтанып алайық. Кейін сөйлесейік.
Dialogue: 0,0:02:46.20,0:02:50.08,Default,,0,0,0,,(толқындардың дыбысы)
Dialogue: 0,0:02:51.58,0:02:52.75,Default,,0,0,0,,туындаған сияқты,
Dialogue: 0,0:02:56.92,0:02:57.76,Default,,0,0,0,,Харизма!
Dialogue: 0,0:02:58.92,0:03:01.68,Default,,0,0,0,,Сериялық өлтіруші Өлі Кайл
Dialogue: 0,0:03:02.43,0:03:04.72,Default,,0,0,0,,Әдетте «қара шашты өлтіруші» ретінде белгілі
Dialogue: 0,0:03:06.14,0:03:09.73,Default,,0,0,0,,Менің әпкемді де өлтірді...
Dialogue: 0,0:03:10.14,0:03:11.56,Default,,0,0,0,,Айтылатын адам
Dialogue: 0,0:03:12.52,0:03:13.48,Default,,0,0,0,,«Орындалды ма»?
Dialogue: 0,0:03:20.99,0:03:23.41,Default,,0,0,0,,Бұл туралы естігіңіз келеді ме?
Dialogue: 0,0:03:24.12,0:03:29.25,Default,,0,0,0,,Сот талқылауы кезінде ол өзі жатқан психиатриялық ауруханадан қашып кеткен.
Dialogue: 0,0:03:29.95,0:03:34.29,Default,,0,0,0,,Жаңа қылмыс жасамас бұрын біреу өлтірген
Dialogue: 0,0:03:35.96,0:03:36.79,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:03:36.88,0:03:39.09,Default,,0,0,0,,Мен егжей-тегжейге мән бермеймін.
Dialogue: 0,0:03:41.05,0:03:43.68,Default,,0,0,0,,Мен Кайлдың әпкемді өлтірмегенін білемін.
Dialogue: 0,0:03:44.39,0:03:47.43,Default,,0,0,0,,Өйткені өлтіру әдісі басқалардан мүлде бөлек.
Dialogue: 0,0:03:48.56,0:03:51.98,Default,,0,0,0,,Неліктен ол өз әпкесін өлтіргенін мойындады?
Dialogue: 0,0:03:53.44,0:03:56.65,Default,,0,0,0,,Қылмыс болған жерді және кісі өлтіру қаруының қайда тасталғанын қайдан білдіңіз?
Dialogue: 0,0:03:57.73,0:03:59.65,Default,,0,0,0,,Полиграфтан қалай аман қалдыңыз?
Dialogue: 0,0:04:00.40,0:04:01.90,Default,,0,0,0,,Сіз кімді қорғайсыз?
Dialogue: 0,0:04:04.91,0:04:05.91,Default,,0,0,0,,Бірінші кезекте...
Dialogue: 0,0:04:07.41,0:04:09.62,Default,,0,0,0,,Өлі Кайл деген кім?
Dialogue: 0,0:04:12.83,0:04:15.71,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:04:18.54,0:04:21.34,Default,,0,0,0,,Мен олардың қазіргі күйінде Элкияны құтқара алатынына сенбеймін.
Dialogue: 0,0:04:22.42,0:04:24.76,Default,,0,0,0,,Бұл Реджи шығарылды.
Dialogue: 0,0:04:25.59,0:04:27.35,Default,,0,0,0,,Көріп отырғаныңыздай, бұл адам емес.
Dialogue: 0,0:04:28.47,0:04:29.51,Default,,0,0,0,,Реджи?
Dialogue: 0,0:04:30.56,0:04:34.73,Default,,0,0,0,,Тек ұрыс үшін жасалған ежелгі деми-нәсіл.
Dialogue: 0,0:04:35.52,0:04:39.86,Default,,0,0,0,,Сол күні институтқа шабуыл жасаған реггилердің бірі.
Dialogue: 0,0:04:44.40,0:04:45.61,Default,,0,0,0,,Мен оны өлтірдім.
Dialogue: 0,0:04:47.49,0:04:50.83,Default,,0,0,0,,Өлтіруші В-ның мақсаты кек алу болды.
Dialogue: 0,0:04:51.12,0:04:52.12,Default,,0,0,0,,Чанчан♪
Dialogue: 0,0:04:53.66,0:04:56.17,Default,,0,0,0,,Осы уақытқа дейін қандай қылмыскерлерді өлтірдіңіз?
Dialogue: 0,0:04:56.62,0:05:00.17,Default,,0,0,0,,Олардың әрқайсысы шабуылға қосылды, солай ма?
Dialogue: 0,0:05:02.71,0:05:04.22,Default,,0,0,0,,Күйіктің иісі шықты.
Dialogue: 0,0:05:06.13,0:05:10.97,Default,,0,0,0,,Сол күні күл мен үмітсіздікте мен ант бердім
Dialogue: 0,0:05:12.39,0:05:14.10,Default,,0,0,0,,Қалғандардың барлығын өлтіріңіз
Dialogue: 0,0:05:14.73,0:05:17.98,Default,,0,0,0,,Ал мен Юнаны міндетті түрде табамын
Dialogue: 0,0:05:20.19,0:05:22.98,Default,,0,0,0,,Оған дейін кім болса да
Dialogue: 0,0:05:23.90,0:05:25.65,Default,,0,0,0,,Ешқашан мазаламау
Dialogue: 0,0:05:32.79,0:05:34.87,Default,,0,0,0,,«Маркет-мейкер күрескерлерінің арасында»
Dialogue: 0,0:05:35.66,0:05:38.50,Default,,0,0,0,,«Моби Дик деп аталатын флагманға жиналды»
Dialogue: 0,0:05:38.79,0:05:42.55,Default,,0,0,0,,«Әлеуметтік хаосты басқаруға сеніп тапсырылған команда бар».
Dialogue: 0,0:05:43.55,0:05:46.51,Default,,0,0,0,,«Кейде олар адамның миын жуып, оларды пайдаланады».
Dialogue: 0,0:05:46.88,0:05:49.30,Default,,0,0,0,,«Бұл сақтықты қажет ететін топ деп айтуға болады».
Dialogue: 0,0:05:53.35,0:05:55.81,Default,,0,0,0,,Сағаттан жасалған туынды сөздер
Dialogue: 0,0:05:57.02,0:05:59.19,Default,,0,0,0,,Ｊ Ｈ Ｒ
Dialogue: 0,0:06:00.73,0:06:02.27,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:06:03.78,0:06:05.65,Default,,0,0,0,,Біраз уақыттан бері жаңартылмаған сияқты.
Dialogue: 0,0:06:05.74,0:06:06.69,Default,,0,0,0,,Сол сайт
Dialogue: 0,0:06:06.86,0:06:08.03,Default,,0,0,0,,А... бұл
Dialogue: 0,0:06:08.74,0:06:11.32,Default,,0,0,0,,Егер сіз олардың көзіне түссеңіз
Dialogue: 0,0:06:11.41,0:06:13.66,Default,,0,0,0,,Мен ол менімен байланысуы мүмкін деп ойладым.
Dialogue: 0,0:06:13.74,0:06:15.83,Default,,0,0,0,,Мен оны жаңа ғана ойлап таптым.
Dialogue: 0,0:06:16.45,0:06:17.75,Default,,0,0,0,,Мен сағатқа қарадым.
Dialogue: 0,0:06:18.12,0:06:20.25,Default,,0,0,0,,Бранға шабуыл жасаған Жан болды.
Dialogue: 0,0:06:20.88,0:06:21.71,Default,,0,0,0,,О
Dialogue: 0,0:06:21.92,0:06:24.92,Default,,0,0,0,,Кит, өзіңізді тапсырыңыз. Қазір...
Dialogue: 0,0:06:25.00,0:06:27.42,Default,,0,0,0,,Біз қазір біргеміз.
Dialogue: 0,0:06:28.09,0:06:31.51,Default,,0,0,0,,Бұл өлтіруші В ме? Менің ойымша, сіз онымен сөйлескенсіз.
Dialogue: 0,0:06:32.43,0:06:35.26,Default,,0,0,0,,Кайл Эриканы өлтірген емес.
Dialogue: 0,0:06:35.68,0:06:36.56,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:06:37.60,0:06:41.35,Default,,0,0,0,,Айтпақшы, гипотеза бойынша ол тіпті адам емес еді.
Dialogue: 0,0:06:43.69,0:06:46.32,Default,,0,0,0,,Айтса да сене алар емеспін.
Dialogue: 0,0:06:48.03,0:06:51.16,Default,,0,0,0,,Аяқтауға жақын қалды
Dialogue: 0,0:06:53.12,0:06:59.04,Default,,0,0,0,,Жазуды шешкен кезде басталған сорақылықтың бәрі аяқталады.
Dialogue: 0,0:07:00.29,0:07:02.50,Default,,0,0,0,,Барлық жауаптарды табыңыз
Dialogue: 0,0:07:04.25,0:07:08.17,Default,,0,0,0,,Жауап әлдеқашан берілуі керек еді.
Dialogue: 0,0:07:11.47,0:07:14.47,Default,,0,0,0,,Енді сізде кері ұштар мен құралдар бар.
Dialogue: 0,0:07:14.55,0:07:16.10,Default,,0,0,0,,Қыдыруға кірісу
Dialogue: 0,0:07:16.31,0:07:17.27,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:07:20.44,0:07:21.27,Default,,0,0,0,,Кит
Dialogue: 0,0:07:21.60,0:07:23.81,Default,,0,0,0,,Брэн мұның құрбаны болуы мүмкін.
Dialogue: 0,0:07:24.65,0:07:27.69,Default,,0,0,0,,Қалай болғанда да, бір рет қайтып, қарсы шараны ойлап көрейік.
Dialogue: 0,0:07:30.90,0:07:32.49,Default,,0,0,0,,Ол қозғала бастады.
Dialogue: 0,0:07:34.53,0:07:36.20,Default,,0,0,0,,Менен құтылу үшін
Dialogue: 0,0:07:36.37,0:07:40.00,Default,,0,0,0,,Сол жігіттер, маркет-мейкерлер қозғала бастады.
Dialogue: 0,0:07:41.04,0:07:41.87,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:07:46.29,0:07:49.17,Default,,0,0,0,,Бұл да кесте бойынша ма?
Dialogue: 0,0:07:54.34,0:07:55.18,Default,,0,0,0,,Эрик
Dialogue: 0,0:07:56.68,0:07:57.51,Default,,0,0,0,,Иә
Dialogue: 0,0:07:59.02,0:08:01.27,Default,,0,0,0,,Сіз маған шынымен көмектестіңіз.
Dialogue: 0,0:08:02.39,0:08:03.64,Default,,0,0,0,,Менің саған айтқым келгені осы ғана.
Dialogue: 0,0:08:05.48,0:08:07.44,Default,,0,0,0,,Кит Кит!
Dialogue: 0,0:08:07.86,0:08:09.48,Default,,0,0,0,,Бір минут күтіңіз, Кит!
Dialogue: 0,0:08:15.62,0:08:16.82,Default,,0,0,0,,Бұл бастама
Dialogue: 0,0:08:28.38,0:08:31.13,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:08:31.96,0:08:36.30,Default,,0,0,0,,Неге мені таң ата осындай жерге шақырдың?
Dialogue: 0,0:08:38.85,0:08:40.81,Default,,0,0,0,,Хмм... мм.
Dialogue: 0,0:08:43.52,0:08:44.35,Default,,0,0,0,,Хмм?
Dialogue: 0,0:08:58.07,0:08:58.91,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:00.08,0:09:02.37,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ бітті ме?
Dialogue: 0,0:09:04.62,0:09:05.46,Default,,0,0,0,,Хмм?
Dialogue: 0,0:09:06.21,0:09:08.50,Default,,0,0,0,,Төбеге жазылған қызыл әріптер
Dialogue: 0,0:09:09.04,0:09:11.55,Default,,0,0,0,,Бұл шындыққа сәйкес келетін жалғыз формула
Dialogue: 0,0:09:12.84,0:09:16.34,Default,,0,0,0,,Қате деп ойлап, үш рет қайталадым.
Dialogue: 0,0:09:30.02,0:09:30.86,Default,,0,0,0,,Борис
Dialogue: 0,0:09:33.44,0:09:36.07,Default,,0,0,0,,Киттің маған соншалықты алшақ болуының себебі осы ма?
Dialogue: 0,0:09:37.61,0:09:40.24,Default,,0,0,0,,Бұл кім? Сіз білесіз бе?
Dialogue: 0,0:09:40.70,0:09:41.83,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:42.49,0:09:45.29,Default,,0,0,0,,Бұл адам мен Киттің қайтып келуі?
Dialogue: 0,0:09:45.37,0:09:46.75,Default,,0,0,0,,Бұған қатысы бар ма?
Dialogue: 0,0:09:47.29,0:09:49.08,Default,,0,0,0,,Кит не істемекші?
Dialogue: 0,0:09:50.79,0:09:52.00,Default,,0,0,0,,Бала
Dialogue: 0,0:09:53.21,0:09:58.13,Default,,0,0,0,,Осыдан сегіз жыл бұрын қыста бүкіл денемді кесіп, тауға тастап кеткен...
Dialogue: 0,0:09:58.43,0:10:00.89,Default,,0,0,0,,Киттің әпкесі
Dialogue: 0,0:10:06.48,0:10:10.27,Default,,0,0,0,,Басқаша айтқанда, жойылған реггилерді қайта пайдалану.
Dialogue: 0,0:10:10.40,0:10:12.36,Default,,0,0,0,,Бұл сізге алтын ерітіндісі қажет дегенді білдіре ме?
Dialogue: 0,0:10:13.02,0:10:16.53,Default,,0,0,0,,Ол тестостерон мен дофаминді реттеу үшін қолданылады.
Dialogue: 0,0:10:16.94,0:10:20.32,Default,,0,0,0,,Басқа да көп нәрсе бар сияқты, бірақ мен егжей-тегжейін білмеймін.
Dialogue: 0,0:10:21.49,0:10:23.28,Default,,0,0,0,,Бас тартуға не себеп болады?
Dialogue: 0,0:10:24.12,0:10:25.54,Default,,0,0,0,,Реджи шамамен жиырма жаста еді.
Dialogue: 0,0:10:25.62,0:10:28.75,Default,,0,0,0,,Көптеген қабілеттерді жоғалту және ойларды басқару
Dialogue: 0,0:10:29.12,0:10:31.25,Default,,0,0,0,,Стандартты мәннен төмен түссе, жойылады
Dialogue: 0,0:10:31.88,0:10:35.34,Default,,0,0,0,,Жою қоғамға босатуды білдіреді ме?
Dialogue: 0,0:10:35.76,0:10:36.59,Default,,0,0,0,,О
Dialogue: 0,0:10:37.51,0:10:41.64,Default,,0,0,0,,-де? Оған қанша уақыт кетеді? Кайл сияқты C класындағы өнімдер
Dialogue: 0,0:10:42.14,0:10:43.22,Default,,0,0,0,,Көп
Dialogue: 0,0:10:44.35,0:10:48.18,Default,,0,0,0,,Бұл ел сіз ойлағаннан да көп тастанды реггилерге толы.
Dialogue: 0,0:10:49.27,0:10:53.44,Default,,0,0,0,,Олар бір белгі арқылы ашуланған қаруға айналады.
Dialogue: 0,0:10:54.11,0:10:56.90,Default,,0,0,0,,Өлтіруді өмірінің соңына дейін қайталаңыз
Dialogue: 0,0:10:57.74,0:11:00.40,Default,,0,0,0,,Оны тоқтатудың өлтіруден басқа жолы жоқ.
Dialogue: 0,0:11:02.74,0:11:04.12,Default,,0,0,0,,Мен қызыл бұршақ пастасын сатып алайын деп жатырмын.
Dialogue: 0,0:11:04.70,0:11:05.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:18.05,0:11:20.38,Default,,0,0,0,,Мен тергеуге қатысты кез келген сұрақтарға жауап беремін.
Dialogue: 0,0:11:21.18,0:11:24.22,Default,,0,0,0,,Осы тергеу саясатына қатысты пікірім бар.
Dialogue: 0,0:11:24.30,0:11:26.06,Default,,0,0,0,,Мен бос емеспін, мені кейінірек қалдырыңыз.
Dialogue: 0,0:11:27.01,0:11:27.93,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:28.64,0:11:32.19,Default,,0,0,0,,Осылай жүре берсек, Китті ешқашан таба алмаймыз деп ойлаймын.
Dialogue: 0,0:11:32.52,0:11:34.36,Default,,0,0,0,,Бұл бұйрық, жалғастыр.
Dialogue: 0,0:11:34.69,0:11:35.56,Default,,0,0,0,,Мен оны естімеймін
Dialogue: 0,0:11:35.65,0:11:36.73,Default,,0,0,0,,Содан кейін шығыңыз.
Dialogue: 0,0:11:36.82,0:11:37.90,Default,,0,0,0,,Иә!?
Dialogue: 0,0:11:38.40,0:11:41.28,Default,,0,0,0,,Сіз тергеуге араласып жатырсыз. Белгіңізді қалдырыңыз және кетіңіз.
Dialogue: 0,0:11:41.36,0:11:42.41,Default,,0,0,0,,Иә!?
Dialogue: 0,0:11:43.16,0:11:45.83,Default,,0,0,0,,Сіз мені естіген жоқсыз ба? Мен жұмыстан уақытша шеттетілдім
Dialogue: 0,0:11:46.37,0:11:49.41,Default,,0,0,0,,Бұйрықты орындай алмайтын ақымақтардың керегі жоқ деймін.
Dialogue: 0,0:11:50.20,0:11:51.46,Default,,0,0,0,,Қазір шық!
Dialogue: 0,0:11:51.58,0:11:52.42,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:54.58,0:11:56.42,Default,,0,0,0,,Өл! Көзілдірік! Барка!
Dialogue: 0,0:11:56.84,0:11:58.50,Default,,0,0,0,,Бастықты бәрі осылай атайды!
Dialogue: 0,0:11:58.67,0:11:59.92,Default,,0,0,0,,Барқа!
Dialogue: 0,0:12:03.13,0:12:06.05,Default,,0,0,0,,Эрик Лили қозғала бастады.
Dialogue: 0,0:12:06.51,0:12:10.31,Default,,0,0,0,,Бұл шынымен жақсы ма? Мен уайымдап тұрмын
Dialogue: 0,0:12:10.93,0:12:13.56,Default,,0,0,0,,RIS маркет-мейкерлердің бақылауында
Dialogue: 0,0:12:14.15,0:12:17.65,Default,,0,0,0,,Олардан озып кеткіміз келсе, басқа амалымыз жоқ.
Dialogue: 0,0:12:17.94,0:12:20.78,Default,,0,0,0,,Картоп лалагүлі қатысуы мүмкін.
Dialogue: 0,0:12:20.94,0:12:23.07,Default,,0,0,0,,Мен бұл туралы алаңдаймын.
Dialogue: 0,0:12:23.20,0:12:25.45,Default,,0,0,0,,Борис ол кәсіпқой
Dialogue: 0,0:12:26.28,0:12:27.91,Default,,0,0,0,,Сіз байқаған боларсыз
Dialogue: 0,0:12:28.58,0:12:30.87,Default,,0,0,0,,Лили мен Кит бір-біріне ұқсайды
Dialogue: 0,0:12:31.62,0:12:35.83,Default,,0,0,0,,Ойлау, Шабыт, Іс-әрекет күші, Іздену
Dialogue: 0,0:12:36.75,0:12:38.88,Default,,0,0,0,,Айналадағылардың қарсылығын жеңдім.
Dialogue: 0,0:12:39.04,0:12:40.84,Default,,0,0,0,,Лилиді RIS-ке кім барды?
Dialogue: 0,0:12:41.42,0:12:44.26,Default,,0,0,0,,Оның Китпен салыстыруға болатын жасырын қабілеттері бар...
Dialogue: 0,0:12:44.93,0:12:46.39,Default,,0,0,0,,Өйткені менде солай болды.
Dialogue: 0,0:12:47.26,0:12:48.10,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:12:48.85,0:12:52.85,Default,,0,0,0,,Борис, мен ол жерден Китті таба алмаймын.
Dialogue: 0,0:12:53.98,0:12:55.39,Default,,0,0,0,,Мен Лилияға бәс тігемін
Dialogue: 0,0:12:58.27,0:12:59.40,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:06.20,0:13:09.20,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:13:13.66,0:13:15.08,Default,,0,0,0,,Каэла аяқталды ма?
Dialogue: 0,0:13:15.21,0:13:16.25,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:13:17.37,0:13:18.46,Default,,0,0,0,,Иә Жарайды
Dialogue: 0,0:13:28.64,0:13:29.89,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:13:29.97,0:13:31.35,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:13:31.51,0:13:33.85,Default,,0,0,0,,Бірақ олар біраз уақытқа кіре алмайды деп ойлаймын.
Dialogue: 0,0:13:37.31,0:13:39.81,Default,,0,0,0,,Мына қызыл - Лилия.
Dialogue: 0,0:13:40.90,0:13:42.90,Default,,0,0,0,,Маркер Оны кім қойды?
Dialogue: 0,0:13:43.15,0:13:44.07,Default,,0,0,0,,Бұл Борис.
Dialogue: 0,0:13:44.32,0:13:46.45,Default,,0,0,0,,Білсең ашуланасың.
Dialogue: 0,0:13:46.53,0:13:47.49,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:13:47.74,0:13:50.49,Default,,0,0,0,,Менің ойымша, ол әрекет ете алмайды.
Dialogue: 0,0:13:50.66,0:13:52.41,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:52.95,0:13:54.58,Default,,0,0,0,,Өйткені сен ақымақсың
Dialogue: 0,0:14:28.07,0:14:29.86,Default,,0,0,0,,Қызыл бұршақ пастасын жеп қойыңыз
Dialogue: 0,0:14:30.82,0:14:31.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:33.62,0:14:36.08,Default,,0,0,0,,Анықтамалар жоқ.
Dialogue: 0,0:14:36.70,0:14:38.79,Default,,0,0,0,,Қайда қарасаң да, бәрі бірдей...
Dialogue: 0,0:14:40.12,0:14:41.13,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:14:41.54,0:14:44.21,Default,,0,0,0,,Мен жақсы тамақтанатын жерге баруым керек еді.
Dialogue: 0,0:14:44.59,0:14:45.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:49.59,0:14:52.30,Default,,0,0,0,,Дәмдеуіштердің біртүрлі иісі
Dialogue: 0,0:15:12.91,0:15:16.37,Default,,0,0,0,,Сіз неліктен көк болат Реджидің әлсіздігі екенін білесіз бе?
Dialogue: 0,0:15:18.08,0:15:19.83,Default,,0,0,0,,Мен сенімен біргемін
Dialogue: 0,0:15:20.92,0:15:22.37,Default,,0,0,0,,Әкенің дәптері
Dialogue: 0,0:15:27.38,0:15:29.92,Default,,0,0,0,,Қашанғы мақсатсыз қаңғып жүре бересің?
Dialogue: 0,0:15:32.51,0:15:34.68,Default,,0,0,0,,Мақсатсыз кезіп жүргендей емес.
Dialogue: 0,0:15:35.10,0:15:38.02,Default,,0,0,0,,Тағамдары дәмді қалаларды аралайтыныңызға сенімдімін.
Dialogue: 0,0:15:38.10,0:15:39.31,Default,,0,0,0,,«дейін» деді
Dialogue: 0,0:15:39.39,0:15:41.35,Default,,0,0,0,,Денеңіз толық сауығып кеткенше.
Dialogue: 0,0:15:42.10,0:15:45.02,Default,,0,0,0,,Қол соғуға уақыт болса, жай жатып, ұйықта.
Dialogue: 0,0:15:50.86,0:15:53.11,Default,,0,0,0,,Сіз біршама қалпына келдіңіз, солай емес пе?
Dialogue: 0,0:15:53.91,0:15:56.03,Default,,0,0,0,,Енді күресуге болатын сияқты.
Dialogue: 0,0:15:57.24,0:16:00.37,Default,,0,0,0,,Маған көмектесудің шынайы мақсаты болуы керек.
Dialogue: 0,0:16:01.29,0:16:02.12,Default,,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 0,0:16:05.88,0:16:08.05,Default,,0,0,0,,Кейде маған көмек келеді.
Dialogue: 0,0:16:09.34,0:16:11.51,Default,,0,0,0,,Менің сізге көмектесуге ешқандай себеп жоқ...
Dialogue: 0,0:16:11.59,0:16:12.68,Default,,0,0,0,,Бар
Dialogue: 0,0:16:13.18,0:16:15.18,Default,,0,0,0,,Осыны әзірге қалдырыңыз.
Dialogue: 0,0:16:16.05,0:16:16.89,Default,,0,0,0,,Кедергі
Dialogue: 0,0:16:25.98,0:16:27.65,Default,,0,0,0,,Түсіндіре аласыз ба?
Dialogue: 0,0:16:28.86,0:16:31.86,Default,,0,0,0,,Мен екі адамды тергедім.
Dialogue: 0,0:16:32.28,0:16:34.49,Default,,0,0,0,,Сондықтан мен далаға қайта оралдым.
Dialogue: 0,0:16:35.36,0:16:38.20,Default,,0,0,0,,Мен бәрін өз көзіммен көруім керек болды.
Dialogue: 0,0:16:41.91,0:16:43.87,Default,,0,0,0,,Осылай жүрсек, Хорус аралына жетеміз.
Dialogue: 0,0:16:44.16,0:16:47.29,Default,,0,0,0,,Мен Киттің мұндай жерде болғанын елестете алмаймын.
Dialogue: 0,0:16:47.38,0:16:51.09,Default,,0,0,0,,Ол кемпірлерге толы және бұл туристік орын.
Dialogue: 0,0:16:51.30,0:16:54.55,Default,,0,0,0,,Менің ойымша, егер Кит жүрсе, бұл айтарлықтай байқалады.
Dialogue: 0,0:16:56.64,0:16:59.26,Default,,0,0,0,,Каэла тікұшақ келісімін сұрау
Dialogue: 0,0:17:01.14,0:17:03.85,Default,,0,0,0,,Мен оны зерттеуге көп уақыт жұмсадым.
Dialogue: 0,0:17:04.73,0:17:07.44,Default,,0,0,0,,Бірақ қанша тексерсек те
Dialogue: 0,0:17:07.52,0:17:10.40,Default,,0,0,0,,Ойдан шығарылған түйінді сөздер жауаптарға кедергі жасайды
Dialogue: 0,0:17:10.98,0:17:11.86,Default,,0,0,0,,Мазасыздық?
Dialogue: 0,0:17:12.23,0:17:16.86,Default,,0,0,0,,А, бірінші мүмкіндік адамнан басқа нәрсе.
Dialogue: 0,0:17:17.95,0:17:19.37,Default,,0,0,0,,Бұл сіздің бар екеніңізді білдіреді.
Dialogue: 0,0:17:19.53,0:17:22.75,Default,,0,0,0,,Сіз түсінбейтін сияқтысыз, бірақ Юна екеуміз Реджиміз...
Dialogue: 0,0:17:22.83,0:17:24.33,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:17:24.96,0:17:26.37,Default,,0,0,0,,Жүр тамақ ішейік.
Dialogue: 0,0:17:30.50,0:17:31.38,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:17:31.92,0:17:34.38,Default,,0,0,0,,Бұған дейін мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:17:35.42,0:17:38.01,Default,,0,0,0,,Юна сен білетін Юна болды ма?
Dialogue: 0,0:17:41.14,0:17:43.31,Default,,0,0,0,,Басында басқаша болды.
Dialogue: 0,0:17:44.18,0:17:45.52,Default,,0,0,0,,деп ойладым
Dialogue: 0,0:17:48.23,0:17:52.15,Default,,0,0,0,,Мүмкін бірінші адам естеліктерді басқарған шығар.
Dialogue: 0,0:17:52.23,0:17:55.15,Default,,0,0,0,,Адамдарды еркін басқару қабілеті бар.
Dialogue: 0,0:17:56.74,0:17:59.99,Default,,0,0,0,,Естеліктеріңізді өзіңіз бекіттіңіз.
Dialogue: 0,0:18:00.82,0:18:02.41,Default,,0,0,0,,Дәл сол қабілет емес пе?
Dialogue: 0,0:18:08.12,0:18:11.92,Default,,0,0,0,,Басқаша айтқанда, ол адам менімен бірдей.
Dialogue: 0,0:18:12.21,0:18:13.05,Default,,0,0,0,,О
Dialogue: 0,0:18:13.80,0:18:16.92,Default,,0,0,0,,Әкемді өлтіріп, Юнаны тонап кетті.
Dialogue: 0,0:18:17.22,0:18:20.39,Default,,0,0,0,,Сізді қолға түсірмек болған қылмыскер, бәлкім...
Dialogue: 0,0:18:22.18,0:18:23.31,Default,,0,0,0,,Біз қашып кете аламыз. Бұл оңай болады.
Dialogue: 0,0:18:29.77,0:18:31.11,Default,,0,0,0,,Ол соншалықты керемет пианист болса да—
Dialogue: 0,0:18:31.65,0:18:35.98,Default,,0,0,0,,Бұл рас. Сіз жаңа бақылау құрылғысын қолдандыңыз ба?
Dialogue: 0,0:18:36.28,0:18:37.78,Default,,0,0,0,,Сондықтан мен оны таба алмаймын.
Dialogue: 0,0:18:38.49,0:18:41.32,Default,,0,0,0,,Модуль GPS қолданбайды.
Dialogue: 0,0:18:41.70,0:18:44.33,Default,,0,0,0,,Тек ұялы телефон базалық станциялары арқылы орынды анықтау
Dialogue: 0,0:18:44.58,0:18:46.83,Default,,0,0,0,,Эпицентрді табу әдісімен бірдей
Dialogue: 0,0:18:47.12,0:18:47.96,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:18:48.04,0:18:52.17,Default,,0,0,0,,Мәселе жоқ Ескертулерді алыңыз және карталарға қол жеткізіңіз
Dialogue: 0,0:18:52.58,0:18:53.50,Default,,0,0,0,,Қараңызшы, шықты.
Dialogue: 0,0:18:54.09,0:18:56.17,Default,,0,0,0,,Мен барып тексерейін, жарай ма?
Dialogue: 0,0:18:57.88,0:18:58.84,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:18:59.76,0:19:02.72,Default,,0,0,0,,Сіз оны ешқашан ұстамаймын деп ант ете аласыз ба?
Dialogue: 0,0:19:04.93,0:19:06.56,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:13.02,0:19:16.28,Default,,0,0,0,,Өйткені, бұл аралдың ерекшелігі.
Dialogue: 0,0:19:17.36,0:19:20.15,Default,,0,0,0,,Кит шынымен де осында ма?
Dialogue: 0,0:19:20.86,0:19:23.07,Default,,0,0,0,,Бұл батыл әрекет болды деп ойлаймын~
Dialogue: 0,0:19:25.58,0:19:27.45,Default,,0,0,0,,Екі кесек тауық еті.
Dialogue: 0,0:19:27.70,0:19:31.54,Default,,0,0,0,,Иә, екі Чикигар.
Dialogue: 0,0:19:32.08,0:19:35.09,Default,,0,0,0,,Дәл қазір бұл ең жақсысы.
Dialogue: 0,0:19:36.04,0:19:37.84,Default,,0,0,0,,Екінші адамды тыңдамау
Dialogue: 0,0:19:37.92,0:19:38.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:40.38,0:19:42.47,Default,,0,0,0,,Бұл сізге маңызды емес.
Dialogue: 0,0:19:42.55,0:19:43.68,Default,,0,0,0,,Нені білу керек
Dialogue: 0,0:19:43.89,0:19:46.85,Default,,0,0,0,,Мүмкін солай шығар, бірақ мен олай ойламаймын.
Dialogue: 0,0:19:47.85,0:19:49.81,Default,,0,0,0,,Бұл сенің әпкеңді өлтірген адам ма?
Dialogue: 0,0:19:52.02,0:19:52.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:52.94,0:19:54.23,Default,,0,0,0,,Адам
Dialogue: 0,0:19:55.23,0:19:56.06,Default,,0,0,0,,(Ана) Сені мықты денемен қамтамасыз ете алмағаныма өкінемін… Кешір мені.
Dialogue: 0,0:19:56.15,0:19:59.11,Default,,0,0,0,,Мен білемін, мағынасы жоқ.
Dialogue: 0,0:20:00.19,0:20:03.16,Default,,0,0,0,,Бірінші адам миды жуу қабілеті бар жарты адам болса.
Dialogue: 0,0:20:03.61,0:20:05.66,Default,,0,0,0,,Екінші адам адам болғаны қызық.
Dialogue: 0,0:20:06.12,0:20:10.00,Default,,0,0,0,,Мен бір-бірімізбен ынтымақтасудың мәнін түсінбеймін, өйткені бір-бірін бақылау жақсы идея.
Dialogue: 0,0:20:10.62,0:20:11.83,Default,,0,0,0,,Қанша уақыт күтуімді күтесің? Жылдам бол.
Dialogue: 0,0:20:12.08,0:20:15.13,Default,,0,0,0,,Сіз бұл екеуінің кім екенін түсіндіңіз.
Dialogue: 0,0:20:23.88,0:20:25.68,Default,,0,0,0,,Мен абдырап қалдым
Dialogue: 0,0:20:26.64,0:20:29.85,Default,,0,0,0,,Сондықтан мен оны өз көзіммен көруім керек.
Dialogue: 0,0:20:31.85,0:20:33.81,Default,,0,0,0,,Түсіндім, ынтымақтастықта боламын.
Dialogue: 0,0:20:34.27,0:20:38.82,Default,,0,0,0,,Бірінші адам, мен доктор Хиттің жауына қамқор боламын.
Dialogue: 0,0:20:39.78,0:20:40.78,Default,,0,0,0,,Бізге жақсылап сөйлесу керек!
Dialogue: 0,0:20:41.36,0:20:42.99,Default,,0,0,0,,Юна қайда?
Dialogue: 0,0:20:46.95,0:20:49.20,Default,,0,0,0,,Олар жұлдыз жарығында жасырынып жатыр
Dialogue: 0,0:20:51.70,0:20:53.58,Default,,0,0,0,,Канопусқа қарай ұшыңыз
Dialogue: 0,0:20:53.91,0:20:54.75,Default,,0,0,0,,Аа...
Dialogue: 0,0:20:55.25,0:20:56.50,Default,,0,0,0,,Канопус…
Dialogue: 0,0:20:57.17,0:20:58.09,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:58.42,0:20:59.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:00.09,0:21:00.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:03.51,0:21:07.09,Default,,0,0,0,,Сіз не істеп жатырсыз? Осындай жерде
Dialogue: 0,0:21:07.64,0:21:10.31,Default,,0,0,0,,А... жоқ, бұл...
Dialogue: 0,0:21:10.51,0:21:11.52,Default,,0,0,0,,Түсінесіз бе! (Кейт) Ах!
Dialogue: 0,0:21:15.64,0:21:18.86,Default,,0,0,0,,Екі адам сұрай отырып тапты.
Dialogue: 0,0:21:19.90,0:21:23.78,Default,,0,0,0,,Бір-біріңді танысаңдар да неге үндемедіңдер?
Dialogue: 0,0:21:23.94,0:21:26.91,Default,,0,0,0,,Оны айтуға уақытым болмады...
Dialogue: 0,0:21:27.16,0:21:30.99,Default,,0,0,0,,Бұл мен күлуді жоспарлаған нәрсе емес. Бұл...
Dialogue: 0,0:21:31.16,0:21:32.62,Default,,0,0,0,,Бұл менің кінәм емес...
Dialogue: 0,0:21:33.25,0:21:34.54,Default,,0,0,0,,Балалар тыңдап тұрсыңдар ма?
Dialogue: 0,0:21:35.12,0:21:36.79,Default,,0,0,0,,Куроба-кун! (Куроба) А, иә!
Dialogue: 0,0:21:36.96,0:21:40.00,Default,,0,0,0,,Бұл нені білдіреді? Мұның мына қартқа қандай қатысы бар?
Dialogue: 0,0:21:40.25,0:21:42.09,Default,,0,0,0,,Кіші інісі?
Dialogue: 0,0:21:42.17,0:21:44.34,Default,,0,0,0,,Соңғы уақытқа дейін мен де білмедім.
Dialogue: 0,0:21:45.42,0:21:46.26,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:21:47.93,0:21:48.76,Default,,0,0,0,,Иә...
Dialogue: 0,0:21:49.43,0:21:52.93,Default,,0,0,0,,Менің көзіме қарап, өтірік айтпаймын деп ант ет.
Dialogue: 0,0:21:54.43,0:21:58.44,Default,,0,0,0,,Мен әртүрлі сатып алуларды сұрадым. Басқа көмегім болмады.
Dialogue: 0,0:21:59.31,0:22:02.36,Default,,0,0,0,,Қазір бірге жүргеніміз уақытша.
Dialogue: 0,0:22:02.52,0:22:04.57,Default,,0,0,0,,Олар бір-біріне мүлде ұқсамайды, солай ма?
Dialogue: 0,0:22:04.90,0:22:05.90,Default,,0,0,0,,Жартысы
Dialogue: 0,0:22:06.15,0:22:09.45,Default,,0,0,0,,Айтпақшы, мен әкеме ұқсаймын, мен анама ұқсаймын.
Dialogue: 0,0:22:10.57,0:22:14.20,Default,,0,0,0,,Сіздің сіңліңізден басқа, бір-біріне ұқсамайтын бауырларыңыз да болды.
Dialogue: 0,0:22:16.62,0:22:20.13,Default,,0,0,0,,Білемін, Бористен бәрін сұрадым.
Dialogue: 0,0:22:20.75,0:22:23.09,Default,,0,0,0,,Мен төбедегі формуланың портретін де көрдім.
Dialogue: 0,0:22:24.05,0:22:26.55,Default,,0,0,0,,Енді ақымақ болу мүмкін емес.
Dialogue: 0,0:22:33.56,0:22:35.52,Default,,0,0,0,,Әрқашан ақымақ сияқты әрекет ету
Dialogue: 0,0:22:36.98,0:22:38.81,Default,,0,0,0,,Тіпті мен мұны өзім істей аламын
Dialogue: 0,0:22:40.19,0:22:42.69,Default,,0,0,0,,Қараңдаршы, Минадзуки.
Dialogue: 0,0:22:43.94,0:22:47.11,Default,,0,0,0,,Мені неге жек көретініңді түсіндім.
Dialogue: 0,0:22:47.82,0:22:50.70,Default,,0,0,0,,Кішкентай, қара шашты, солақай, шығыс адам
Dialogue: 0,0:22:51.82,0:22:54.24,Default,,0,0,0,,Себебі мен Эриканы еске түсіремін.
Dialogue: 0,0:22:54.70,0:22:55.70,Default,,0,0,0,,Дұрыс айттың, иә?
Dialogue: 0,0:22:58.25,0:23:00.75,Default,,0,0,0,,Жауап бергің келмесе, жақсы.
Dialogue: 0,0:23:01.50,0:23:05.09,Default,,0,0,0,,Бірақ сіздің мақсатыңыз кек алу болса.
Dialogue: 0,0:23:05.59,0:23:08.92,Default,,0,0,0,,Заңы бар елге қызмет ететін адам ретінде мен бұған шыдай алмаймын.
Dialogue: 0,0:23:09.05,0:23:10.05,Default,,0,0,0,,О... және...
Dialogue: 0,0:23:10.63,0:23:15.18,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:23:15.31,0:23:17.56,Default,,0,0,0,,Не, не, не, бұл не!?
Dialogue: 0,0:23:17.68,0:23:19.52,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:23:19.81,0:23:22.98,Default,,0,0,0,,Мен мұны өзім істей аламын! Хи хи
Dialogue: 0,0:23:24.36,0:23:27.28,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:23:27.36,0:23:28.90,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:23:48.88,0:23:51.13,Default,,0,0,0,,Куроба-кун...
Dialogue: 0,0:23:51.97,0:23:53.43,Default,,0,0,0,,Лилия, мұқият тыңда.
Dialogue: 0,0:23:53.97,0:23:56.26,Default,,0,0,0,,Мен осыдан өткен соң бәрін айтып беремін.
Dialogue: 0,0:24:02.52,0:24:08.53,Default,,0,0,0,,♪〜
Dialogue: 0,0:25:54.34,0:26:00.35,Default,,0,0,0,,〜♪
Dialogue: 0,0:26:01.85,0:26:07.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory