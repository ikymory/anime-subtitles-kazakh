Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:24.64,0:00:27.19,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:00:37.16,0:00:38.24,Default,,0,0,0,,Куроба…
Dialogue: 0,0:00:39.41,0:00:43.25,Default,,0,0,0,,Сіз қайда болдыңыз? Мен күттім...
Dialogue: 0,0:00:43.91,0:00:44.75,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:50.59,0:00:53.63,Default,,0,0,0,,Ааааааааааааааааааааааааааа!
Dialogue: 0,0:00:53.88,0:00:59.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:11.48,0:01:14.40,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:01:23.87,0:01:25.00,Default,,0,0,0,,Юна...
Dialogue: 0,0:01:31.59,0:01:32.71,Default,,0,0,0,,Юна...
Dialogue: 0,0:01:33.55,0:01:35.05,Default,,0,0,0,,Юнаны қайтар!
Dialogue: 0,0:01:41.97,0:01:43.10,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:01:43.35,0:01:46.06,Default,,0,0,0,,Жүрек пен басты алып тастау керек пе?
Dialogue: 0,0:01:49.06,0:01:50.73,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:52.69,0:01:57.32,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:02:09.62,0:02:10.96,Default,,0,0,0,,Юна...
Dialogue: 0,0:02:12.17,0:02:18.09,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:02:19.47,0:02:20.76,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:02:39.61,0:02:43.03,Default,,0,0,0,,Неге қарап тұрсың! Мына жаққа!
Dialogue: 0,0:02:43.16,0:02:49.16,Default,,0,0,0,,♪〜
Dialogue: 0,0:02:52.04,0:02:58.05,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:02.01,0:03:03.22,Default,,0,0,0,,Хи хи
Dialogue: 0,0:03:08.89,0:03:09.77,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:23.28,0:03:26.66,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:03:26.74,0:03:28.91,Default,,0,0,0,,Бұл не? Кез келген уақытта бара аласыз
Dialogue: 0,0:03:45.39,0:03:52.39,Default,,0,0,0,,(Камуйдың ыңырануы)
Dialogue: 0,0:03:59.03,0:04:05.82,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:04:08.83,0:04:11.00,Default,,0,0,0,,Куку... Юнаны маған қайтар!
Dialogue: 0,0:04:11.87,0:04:13.37,Default,,0,0,0,,(Каэбуки) Күтпегендей, дайындықты ескерсек, аса әсерлі болған жоқ.
Dialogue: 0,0:04:16.38,0:04:19.55,Default,,0,0,0,,Бұл тітіркендіргіш, оны көтеріңіз.
Dialogue: 0,0:04:26.01,0:04:27.47,Default,,0,0,0,,Ах... Гухо!
Dialogue: 0,0:04:29.56,0:04:32.10,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:04:37.73,0:04:41.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:42.24,0:04:45.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:51.74,0:04:52.58,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:59.13,0:04:59.96,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:01.00,0:05:01.96,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:05:06.59,0:05:07.43,Default,,0,0,0,,Минадзуки!
Dialogue: 0,0:05:15.35,0:05:17.10,Default,,0,0,0,,Демек, ойлағанымдай…
Dialogue: 0,0:05:18.56,0:05:20.52,Default,,0,0,0,,Тоқта! Оны өлтірме!
Dialogue: 0,0:05:23.11,0:05:24.74,Default,,0,0,0,,Минадзуки, қазір шығарып алайық.
Dialogue: 0,0:05:25.11,0:05:27.95,Default,,0,0,0,,Қайтып емдемесең қайтымсыз болады.
Dialogue: 0,0:05:29.03,0:05:31.45,Default,,0,0,0,,Минадзуки! Эй, сен мені естисің бе!
Dialogue: 0,0:05:32.33,0:05:34.25,Default,,0,0,0,,Минадзуки! Барлық айлар!
Dialogue: 0,0:05:44.59,0:05:45.59,Default,,0,0,0,,Канопус
Dialogue: 0,0:05:50.64,0:05:53.06,Default,,0,0,0,,Куробане! Сенімен бәрі жақсы ма?
Dialogue: 0,0:06:12.87,0:06:14.29,Default,,0,0,0,,(Дәптерді парақтау дыбысы)
Dialogue: 0,0:06:19.67,0:06:21.08,Default,,0,0,0,,Иә, бәрі дұрыс.
Dialogue: 0,0:06:29.80,0:06:30.64,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:06:36.97,0:06:37.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:38.23,0:06:42.27,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:07:09.42,0:07:11.30,Default,,0,0,0,,Біз кімнің кесірінен жеңіліп қалдық?
Dialogue: 0,0:07:12.18,0:07:13.68,Default,,0,0,0,,Кім кінәлі?
Dialogue: 0,0:07:13.97,0:07:16.06,Default,,0,0,0,,Әлсіздер, кетіңдер!
Dialogue: 0,0:07:16.14,0:07:16.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:17.10,0:07:18.02,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:07:20.94,0:07:22.48,Default,,0,0,0,,Юнаны босатыңыз
Dialogue: 0,0:07:25.15,0:07:29.49,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:07:29.57,0:07:33.99,Default,,0,0,0,,Қараңдаршы, Юна жылағанда мына жігіт маған ұшып келеді!
Dialogue: 0,0:07:34.07,0:07:36.28,Default,,0,0,0,,Бұл рас (А бала) Ух~ух~
Dialogue: 0,0:07:36.37,0:07:37.45,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:37.54,0:07:40.83,Default,,0,0,0,,Маған көмектесіңіз~ Мистер Найт~ (Үш адам күледі)
Dialogue: 0,0:07:40.91,0:07:44.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:44.75,0:07:49.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:01.10,0:08:03.52,Default,,0,0,0,,Кирисаме мен басқалары оны маған әкелді.
Dialogue: 0,0:08:04.15,0:08:06.11,Default,,0,0,0,,Маған кейінірек рахмет
Dialogue: 0,0:08:11.53,0:08:12.36,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:08:13.53,0:08:15.78,Default,,0,0,0,,Өйткені бәрі бізді мазақ етеді
Dialogue: 0,0:08:17.45,0:08:18.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:19.20,0:08:20.29,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:08:21.00,0:08:22.66,Default,,0,0,0,,Барлығы сондай күшті
Dialogue: 0,0:08:23.16,0:08:26.58,Default,,0,0,0,,Менің сол көзім ғана бар, оны қолданбау керек деген.
Dialogue: 0,0:08:27.59,0:08:29.59,Default,,0,0,0,,Мен мұнда не үшін келдім?
Dialogue: 0,0:08:30.34,0:08:33.80,Default,,0,0,0,,Куроба Өте жақсы физикалық қабілет және
Dialogue: 0,0:08:33.88,0:08:37.76,Default,,0,0,0,,Күш тек ерекше күштерге ие болу ғана емес.
Dialogue: 0,0:08:38.10,0:08:40.26,Default,,0,0,0,,Мен саған бұрын айтқан жоқпын ба?
Dialogue: 0,0:08:40.81,0:08:44.35,Default,,0,0,0,,Үлкендердің бәрі айтады, бұл әдемі нәрсе.
Dialogue: 0,0:08:45.14,0:08:47.02,Default,,0,0,0,,Мықты болмасаң ешкімді қорғай алмайсың
Dialogue: 0,0:08:49.02,0:08:50.98,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:08:51.94,0:08:54.82,Default,,0,0,0,,Бірақ мүмкін емес.
Dialogue: 0,0:08:55.66,0:08:58.49,Default,,0,0,0,,Жарайды, түсінетін кезің келеді.
Dialogue: 0,0:08:59.53,0:09:02.20,Default,,0,0,0,,Қазір алаңдау маңызды.
Dialogue: 0,0:09:11.46,0:09:12.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:12.96,0:09:13.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:14.01,0:09:15.80,Default,,0,0,0,,Сіз маған ертерек көмектестіңіз.
Dialogue: 0,0:09:16.47,0:09:19.22,Default,,0,0,0,,Иә, көмектестім... Сонда?
Dialogue: 0,0:09:19.55,0:09:20.39,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:09:20.81,0:09:21.72,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:09:21.93,0:09:22.77,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:09:23.81,0:09:26.39,Default,,0,0,0,,Мұны мектепте айту керек емес пе?
Dialogue: 0,0:09:26.89,0:09:28.77,Default,,0,0,0,,Мені осы уақытқа дейін шақырма.
Dialogue: 0,0:09:29.27,0:09:32.48,Default,,0,0,0,,Мектепте бірге болсақ, тағы да қорқытуларымыз мүмкін.
Dialogue: 0,0:09:32.82,0:09:34.36,Default,,0,0,0,,Мені қорлаған жоқпын
Dialogue: 0,0:09:35.03,0:09:39.32,Default,,0,0,0,,Эй, неге Куроба маған үнемі көмектеседі?
Dialogue: 0,0:09:39.66,0:09:42.70,Default,,0,0,0,,Неге... Бұл түсінікті, солай ма?
Dialogue: 0,0:09:42.79,0:09:43.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:44.45,0:09:45.45,Default,,0,0,0,,Мен білмеймін, бірақ...
Dialogue: 0,0:09:46.08,0:09:49.42,Default,,0,0,0,,Юна өзін жалғыз сезінсе, бірдеңені сезінеді.
Dialogue: 0,0:09:49.67,0:09:50.50,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:50.67,0:09:53.13,Default,,0,0,0,,Бұл мені қорғап жатқаныңды білдіре ме?
Dialogue: 0,0:09:53.21,0:09:54.17,Default,,0,0,0,,Біртүрлі ме?
Dialogue: 0,0:09:55.17,0:09:56.47,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:59.97,0:10:01.93,Default,,0,0,0,,Онда мен де сені қорғаймын.
Dialogue: 0,0:10:02.01,0:10:02.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:02.97,0:10:07.06,Default,,0,0,0,,Куроба жалғыз қалғанда мен оны күлдіремін
Dialogue: 0,0:10:07.14,0:10:09.81,Default,,0,0,0,,Хмм... Ах...
Dialogue: 0,0:10:10.27,0:10:11.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:12.11,0:10:13.48,Default,,0,0,0,,Мен жақсы нәрсе ойладым
Dialogue: 0,0:10:14.48,0:10:15.32,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:10:17.49,0:10:20.24,Default,,0,0,0,,Бізде арнайы нөмір бар дейді.
Dialogue: 0,0:10:21.74,0:10:25.24,Default,,0,0,0,,Юна – «4» бірақ бұл жай «4» емес
Dialogue: 0,0:10:25.83,0:10:27.87,Default,,0,0,0,,Бұл Юнаның ерекше «4»
Dialogue: 0,0:10:28.29,0:10:30.54,Default,,0,0,0,,«4» тек уақыт үшін қолданылады.
Dialogue: 0,0:10:31.21,0:10:32.75,Default,,0,0,0,,Сонымен... мен «13»мін
Dialogue: 0,0:10:33.38,0:10:35.00,Default,,0,0,0,,Осы екеуін қоссаңыз...
Dialogue: 0,0:10:37.17,0:10:39.51,Default,,0,0,0,,Мұны біздің кодқа айналдырайық.
Dialogue: 0,0:10:40.09,0:10:43.14,Default,,0,0,0,,Келесіде сізді қорқытқанда, оны көретін жерге жазыңыз.
Dialogue: 0,0:10:43.76,0:10:47.48,Default,,0,0,0,,Онда мен бірден ұшып Юнаны құтқарамын.
Dialogue: 0,0:10:47.68,0:10:51.60,Default,,0,0,0,,Ал мен осыны жазғанда маған Юна да келді.
Dialogue: 0,0:10:52.61,0:10:55.61,Default,,0,0,0,,Иә, бірақ сіз шынымен келесіз бе?
Dialogue: 0,0:10:55.69,0:10:56.69,Default,,0,0,0,,Әрине
Dialogue: 0,0:10:57.19,0:10:58.65,Default,,0,0,0,,Мен де міндетті түрде барамын.
Dialogue: 0,0:10:58.74,0:10:59.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:00.57,0:11:01.66,Default,,0,0,0,,Юнаны да шығар.
Dialogue: 0,0:11:02.32,0:11:03.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:06.45,0:11:08.20,Default,,0,0,0,,Уәде беремін хехе...
Dialogue: 0,0:11:09.33,0:11:10.16,Default,,0,0,0,,Иә
Dialogue: 0,0:11:21.47,0:11:23.01,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:23.09,0:11:24.05,Default,,0,0,0,,Ха...
Dialogue: 0,0:11:25.05,0:11:26.01,Default,,0,0,0,,Юна!
Dialogue: 0,0:11:26.60,0:11:32.06,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:34.52,0:11:35.82,Default,,0,0,0,,Юнар!
Dialogue: 0,0:11:36.27,0:11:37.32,Default,,0,0,0,,Куробане...
Dialogue: 0,0:11:37.40,0:11:38.32,Default,,0,0,0,,Юна!
Dialogue: 0,0:11:38.73,0:11:42.61,Default,,0,0,0,,Баспана орнына Кирисаме Куроба
Dialogue: 0,0:11:42.70,0:11:44.74,Default,,0,0,0,,Мені осы жерде айтылған жерге апарыңыз.
Dialogue: 0,0:11:45.45,0:11:48.95,Default,,0,0,0,,Ол жерді менен басқа ешкім білмейді. Бұл қауіпсіз.
Dialogue: 0,0:11:56.13,0:11:57.13,Default,,0,0,0,,Куробане
Dialogue: 0,0:11:58.84,0:11:59.92,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:00.59,0:12:02.55,Default,,0,0,0,,Тезірек Кирисамэмен бірге жүр.
Dialogue: 0,0:12:02.63,0:12:04.01,Default,,0,0,0,,Бірақ Юна...
Dialogue: 0,0:12:04.39,0:12:08.01,Default,,0,0,0,,Жарайды, мен Юна туралы бірдеңе істеймін.
Dialogue: 0,0:12:08.22,0:12:09.60,Default,,0,0,0,,Тезірек (Куроба), бірақ...
Dialogue: 0,0:12:09.85,0:12:10.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:11.81,0:12:14.77,Default,,0,0,0,,Кирисаме Куробанды кез келген жағдайда қорғаңыз
Dialogue: 0,0:12:15.10,0:12:15.94,Default,,0,0,0,,Иә
Dialogue: 0,0:12:18.40,0:12:21.40,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:22.40,0:12:25.20,Default,,0,0,0,,(Юнаның жылағаны)
Dialogue: 0,0:12:25.28,0:12:26.49,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:26.82,0:12:30.41,Default,,0,0,0,,Куробане қайда орналасқан? Бұл қорқынышты...
Dialogue: 0,0:12:33.66,0:12:35.04,Default,,0,0,0,,Юна! Ха...
Dialogue: 0,0:12:36.38,0:12:37.71,Default,,0,0,0,,Куробане! Ах...
Dialogue: 0,0:12:41.38,0:12:42.55,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:49.10,0:12:51.27,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:12:51.77,0:12:55.48,Default,,0,0,0,,Мен Миназукимін, ал Куроба менің інім.
Dialogue: 0,0:12:56.44,0:12:59.48,Default,,0,0,0,,Қане бірге қашайық. Бұл жерде жақсы емес.
Dialogue: 0,0:13:00.94,0:13:02.15,Default,,0,0,0,,Куроба да күтіп тұр.
Dialogue: 0,0:13:03.32,0:13:04.53,Default,,0,0,0,,Куробане?
Dialogue: 0,0:13:04.78,0:13:05.61,Default,,0,0,0,,Иә
Dialogue: 0,0:13:12.41,0:13:14.08,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:13:14.16,0:13:15.87,Default,,0,0,0,,(Куроба мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:13:16.00,0:13:16.83,Default,,0,0,0,,Юна...
Dialogue: 0,0:13:17.54,0:13:18.92,Default,,0,0,0,,Кешіктірмеңіз!
Dialogue: 0,0:13:19.25,0:13:20.88,Default,,0,0,0,,Бірақ Юна...
Dialogue: 0,0:13:20.96,0:13:23.59,Default,,0,0,0,,Бірдеңе болып қалса, баспанаға жиналамыз, солай ма?
Dialogue: 0,0:13:24.05,0:13:25.55,Default,,0,0,0,,Барлығының сонда екеніне сенімдімін.
Dialogue: 0,0:13:26.13,0:13:27.89,Default,,0,0,0,,Юна мені кейін қуып жетеді.
Dialogue: 0,0:13:28.47,0:13:29.30,Default,,0,0,0,,Иә
Dialogue: 0,0:13:40.69,0:13:42.44,Default,,0,0,0,,Минадзуки Изанами
Dialogue: 0,0:13:43.03,0:13:44.78,Default,,0,0,0,,Жақсы екеніңізге қуаныштымын.
Dialogue: 0,0:13:46.28,0:13:48.28,Default,,0,0,0,,Тез баспанаға эвакуациялаңыз
Dialogue: 0,0:13:48.36,0:13:50.62,Default,,0,0,0,,Жау да өте жақын... га...
Dialogue: 0,0:13:51.37,0:13:54.16,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:55.62,0:13:57.41,Default,,0,0,0,,Бұл сендерсіңдер.
Dialogue: 0,0:13:58.17,0:13:59.67,Default,,0,0,0,,Маркет-мейкер
Dialogue: 0,0:14:03.38,0:14:04.34,Default,,0,0,0,,Сен…
Dialogue: 0,0:14:06.17,0:14:07.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:11.64,0:14:15.27,Default,,0,0,0,,Уф... Миназуки Уф...
Dialogue: 0,0:14:15.35,0:14:16.93,Default,,0,0,0,,Сен шайтансың
Dialogue: 0,0:14:20.65,0:14:22.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:23.69,0:14:26.36,Default,,0,0,0,,Мен оған қосалқы бөлшек болмаймын.
Dialogue: 0,0:14:26.74,0:14:28.61,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:14:29.66,0:14:32.66,Default,,0,0,0,,Бұл қауесет ақиқат болды ма?
Dialogue: 0,0:14:34.08,0:14:35.24,Default,,0,0,0,,Куробане қайда орналасқан?
Dialogue: 0,0:14:36.12,0:14:37.54,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,0:14:38.04,0:14:40.83,Default,,0,0,0,,Минадзуки Бұл...
Dialogue: 0,0:14:42.79,0:14:44.38,Default,,0,0,0,,Қош бол Канопус
Dialogue: 0,0:14:44.67,0:14:49.13,Default,,0,0,0,,Хаа... Хаа... Уф...
Dialogue: 0,0:14:52.85,0:14:54.14,Default,,0,0,0,,(Куроба мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:14:54.22,0:14:55.06,Default,,0,0,0,,Дерлік
Dialogue: 0,0:14:55.18,0:14:59.56,Default,,0,0,0,,(Куроба мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:14:59.64,0:15:01.02,Default,,0,0,0,,Мұнда? О
Dialogue: 0,0:15:04.65,0:15:05.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:08.94,0:15:10.20,Default,,0,0,0,,Мен мұны осы жерден тоқтатамын.
Dialogue: 0,0:15:10.70,0:15:12.07,Default,,0,0,0,,Ішке кіріп, есікті бекітіңіз.
Dialogue: 0,0:15:12.16,0:15:13.41,Default,,0,0,0,,Бірақ... Куробане!
Dialogue: 0,0:15:14.07,0:15:18.87,Default,,0,0,0,,Қарашы, сен біздің патшамызсың, мұнда өлуге болмайды.
Dialogue: 0,0:15:19.62,0:15:20.75,Default,,0,0,0,,Кирисаме…
Dialogue: 0,0:15:20.92,0:15:22.79,Default,,0,0,0,,Мен де кейін келемін.
Dialogue: 0,0:15:23.00,0:15:25.34,Default,,0,0,0,,Маған ұнамайды! Кирисаме де
Dialogue: 0,0:15:25.67,0:15:27.05,Default,,0,0,0,,Шулы! Тез жүріңіз!
Dialogue: 0,0:15:27.80,0:15:28.63,Default,,0,0,0,,О! Оу!
Dialogue: 0,0:15:29.47,0:15:30.30,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,0:15:30.55,0:15:31.76,Default,,0,0,0,,Куробане! Жүгіріп кету!
Dialogue: 0,0:15:33.22,0:15:34.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:36.68,0:15:39.10,Default,,0,0,0,,Жақында кездесеміз, сонда күт.
Dialogue: 0,0:15:39.22,0:15:40.31,Default,,0,0,0,,(Есіктің ауыр жабылған дыбысы)
Dialogue: 0,0:15:40.43,0:15:42.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:42.85,0:15:45.86,Default,,0,0,0,,(Пулемет ату дыбысы)
Dialogue: 0,0:16:11.67,0:16:14.09,Default,,0,0,0,,Юна... Кешіріңіз.
Dialogue: 0,0:16:18.18,0:16:19.01,Default,,0,0,0,,Куробане
Dialogue: 0,0:16:19.52,0:16:20.35,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:22.23,0:16:23.06,Default,,0,0,0,,Юна?
Dialogue: 0,0:16:24.98,0:16:25.81,Default,,0,0,0,,Юна!
Dialogue: 0,0:16:26.65,0:16:28.07,Default,,0,0,0,,Юнар!
Dialogue: 0,0:16:28.82,0:16:29.82,Default,,0,0,0,,Юна!
Dialogue: 0,0:16:31.40,0:16:32.24,Default,,0,0,0,,Юнар!
Dialogue: 0,0:16:32.32,0:16:33.15,Default,,0,0,0,,Куробане
Dialogue: 0,0:16:33.24,0:16:34.07,Default,,0,0,0,,Ха...
Dialogue: 0,0:16:35.24,0:16:36.62,Default,,0,0,0,,Бұл Куробане ме?
Dialogue: 0,0:16:37.32,0:16:38.33,Default,,0,0,0,,Канопус!
Dialogue: 0,0:16:41.66,0:16:43.41,Default,,0,0,0,,Аа, сенің аман болғаныңа қуаныштымын.
Dialogue: 0,0:16:43.66,0:16:44.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:46.92,0:16:48.79,Default,,0,0,0,,Тез қашыңыз
Dialogue: 0,0:16:48.92,0:16:50.75,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:16:51.17,0:16:53.13,Default,,0,0,0,,Мен жай ғана қаша алмаймын
Dialogue: 0,0:16:54.17,0:16:58.85,Default,,0,0,0,,Куроба Сіз аман қалуға міндеттісіз.
Dialogue: 0,0:16:59.47,0:17:01.43,Default,,0,0,0,,Бұл менің достарыма да арналған.
Dialogue: 0,0:17:04.31,0:17:05.14,Default,,0,0,0,,Ха...
Dialogue: 0,0:17:11.03,0:17:11.90,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:12.90,0:17:15.90,Default,,0,0,0,,Мұнда сіз туралы бәрі жазылған.
Dialogue: 0,0:17:16.78,0:17:19.37,Default,,0,0,0,,Мен қазірден бастап істеуім керек нәрселер бар.
Dialogue: 0,0:17:20.53,0:17:22.62,Default,,0,0,0,,Енді жүріңіз.
Dialogue: 0,0:17:27.12,0:17:28.42,Default,,0,0,0,,Куробане! (Куроба) А...
Dialogue: 0,0:17:30.13,0:17:32.38,Default,,0,0,0,,Юнамен резонанс жасай аласыз.
Dialogue: 0,0:17:33.46,0:17:36.51,Default,,0,0,0,,Оны тауып, қорғаңыз
Dialogue: 0,0:17:37.26,0:17:38.09,Default,,0,0,0,,Иә
Dialogue: 0,0:17:50.02,0:17:51.07,Default,,0,0,0,,Кит
Dialogue: 0,0:17:52.36,0:17:57.07,Default,,0,0,0,,Ол бала сізге жетеді
Dialogue: 0,0:18:00.70,0:18:03.41,Default,,0,0,0,,Оған жол көрсет
Dialogue: 0,0:18:08.67,0:18:11.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:12.29,0:18:16.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:29.77,0:18:30.60,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:18:49.33,0:18:50.58,Default,,0,0,0,,Куробане...
Dialogue: 0,0:18:53.67,0:18:54.88,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:18:56.92,0:18:59.38,Default,,0,0,0,,Мен оны қорғаймын
Dialogue: 0,0:19:01.22,0:19:02.59,Default,,0,0,0,,Батыл бол
Dialogue: 0,0:19:03.85,0:19:08.02,Default,,0,0,0,,Оларды қабылдап, қара қауырсындардың патшасы бол.
Dialogue: 0,0:19:10.48,0:19:13.11,Default,,0,0,0,,Юна екеуің өмір сүре берсеңдер
Dialogue: 0,0:19:13.86,0:19:17.78,Default,,0,0,0,,Олардың естеліктері уақыт өте келе мөлдір болады.
Dialogue: 0,0:19:19.49,0:19:20.32,Default,,0,0,0,,Олар бақытты өмір сүруге құқылы
Dialogue: 0,0:19:20.40,0:19:21.24,Default,,0,0,0,,Оян
Dialogue: 0,0:19:21.32,0:19:22.32,Default,,0,0,0,,Біздің патша
Dialogue: 0,0:19:22.41,0:19:23.95,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:19:31.12,0:19:32.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:32.33,0:19:33.75,Default,,0,0,0,,Бұл өте нашар болды.
Dialogue: 0,0:19:34.38,0:19:36.71,Default,,0,0,0,,Өзіңізді әлі тым қатты итермеңіз. Ұйықтау.
Dialogue: 0,0:19:37.30,0:19:38.13,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:38.59,0:19:41.22,Default,,0,0,0,,Сосын кофе ішейік... Әлі мүмкін емес сияқты.
Dialogue: 0,0:19:41.30,0:19:42.89,Default,,0,0,0,,Шалбар (Кит) Иә?
Dialogue: 0,0:19:43.68,0:19:45.26,Default,,0,0,0,,А, мінекей.
Dialogue: 0,0:19:45.35,0:19:47.64,Default,,0,0,0,,Күткендей, бәрі жыртылып қалды, сондықтан мен оны енді қоя алмаймын.
Dialogue: 0,0:19:47.81,0:19:49.52,Default,,0,0,0,,Шалбардың қалтасы
Dialogue: 0,0:19:49.64,0:19:50.64,Default,,0,0,0,,Қалта?
Dialogue: 0,0:19:55.36,0:19:58.19,Default,,0,0,0,,Лақтырмас бұрын айтқаныңызға қуаныштымын.
Dialogue: 0,0:19:58.28,0:19:59.11,Default,,0,0,0,,Сол күні
Dialogue: 0,0:20:00.40,0:20:04.03,Default,,0,0,0,,Мен Юнадан басқа естеліктерді өзім өшірдім.
Dialogue: 0,0:20:05.32,0:20:09.62,Default,,0,0,0,,Менің сол көзімнің есте сақтау қабілеті бар.
Dialogue: 0,0:20:12.21,0:20:14.83,Default,,0,0,0,,Маған оны ешкімге қолданбау керектігін айтты.
Dialogue: 0,0:20:15.50,0:20:18.75,Default,,0,0,0,,Сондықтан мен есте сақтауды қайта жаздым.
Dialogue: 0,0:20:19.59,0:20:21.92,Default,,0,0,0,,Кінәдан құтылу
Dialogue: 0,0:20:23.01,0:20:28.31,Default,,0,0,0,,Бірақ мен оның көзіне қарасам, бәрі есіме түсті.
Dialogue: 0,0:20:34.94,0:20:36.77,Default,,0,0,0,,Оны әлі таба алмайсыз ба?
Dialogue: 0,0:20:37.98,0:20:40.73,Default,,0,0,0,,Барлық бөлімдер бірігіп ізденіс үстінде.
Dialogue: 0,0:20:42.65,0:20:45.41,Default,,0,0,0,,Өйткені сіз толық жауапкершілікті аласыз.
Dialogue: 0,0:20:45.57,0:20:47.74,Default,,0,0,0,,Кит Фрик қалпына келтірілді.
Dialogue: 0,0:20:48.53,0:20:50.04,Default,,0,0,0,,Ұят жоқ
Dialogue: 0,0:20:50.16,0:20:55.08,Default,,0,0,0,,Бұл жеткілікті. Мен мұны 24 сағат бойы жасаймын. Содан кейін Flick-ті табыңыз.
Dialogue: 0,0:20:55.54,0:20:58.71,Default,,0,0,0,,Егер бұл мүмкін болмаса, RIS дереу таратылады.
Dialogue: 0,0:20:59.13,0:21:00.00,Default,,0,0,0,,Менікі де емес—
Dialogue: 0,0:21:06.22,0:21:08.30,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:21:11.43,0:21:16.10,Default,,0,0,0,,Мүмкін ол іздеуді әдейі кешіктіріп жатқан шығар.
Dialogue: 0,0:21:16.73,0:21:20.57,Default,,0,0,0,,Бірақ мен қазір байсалды болуым керек.
Dialogue: 0,0:21:21.15,0:21:24.36,Default,,0,0,0,,RIS ол үшін алмастырылмайды.
Dialogue: 0,0:21:25.40,0:21:27.86,Default,,0,0,0,,Іздеу басқа жерде жалғасады
Dialogue: 0,0:21:28.24,0:21:31.45,Default,,0,0,0,,Егер сіз Фликті тапсаңыз, ол сол жігіт болар еді.
Dialogue: 0,0:21:32.33,0:21:36.37,Default,,0,0,0,,Топқа және оның деректеріне қол жеткізу құқығы жасалды
Dialogue: 0,0:21:36.92,0:21:38.58,Default,,0,0,0,,Қолдануыңызды өтінеміз.
Dialogue: 0,0:21:40.75,0:21:41.88,Default,,0,0,0,,«Біз "екінші Кира" бағыты бойынша тергеу жүргізіп жатырмыз» және олардың ынтымақтастығын сұраймыз.
Dialogue: 0,0:21:45.47,0:21:46.93,Default,,0,0,0,,Сіз айттыңыз
Dialogue: 0,0:21:47.38,0:21:49.22,Default,,0,0,0,,Біз Құдайға еліктегішпіз
Dialogue: 0,0:21:49.59,0:21:51.85,Default,,0,0,0,,Мен өлгенде, Құдайдың орнына
Dialogue: 0,0:21:52.47,0:21:55.60,Default,,0,0,0,,Қара қауырсынның патшасынан басқа ренжітетін ешкім жоқ.
Dialogue: 0,0:22:01.94,0:22:02.82,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:22:03.23,0:22:04.44,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:22:08.36,0:22:09.53,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:22:09.70,0:22:11.12,Default,,0,0,0,,(қолдың үзілген дыбысы)
Dialogue: 0,0:22:11.20,0:22:14.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:14.41,0:22:17.71,Default,,0,0,0,,А... а...
Dialogue: 0,0:22:18.54,0:22:19.54,Default,,0,0,0,,Сен
Dialogue: 0,0:22:19.62,0:22:23.30,Default,,0,0,0,,Жазуды оқи алатын жалғыз пайғамбар
Dialogue: 0,0:22:25.38,0:22:26.42,Default,,0,0,0,,Өткенді білу
Dialogue: 0,0:22:26.55,0:22:30.14,Default,,0,0,0,,Болашақты көре алатын жалғыз тіршілік иесі
Dialogue: 0,0:22:30.80,0:22:34.18,Default,,0,0,0,,Бізді жаңа әлемге жетелеген ол емес пе?
Dialogue: 0,0:22:36.39,0:22:37.52,Default,,0,0,0,,Олай емес пе?
Dialogue: 0,0:22:38.02,0:22:40.19,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:40.48,0:22:41.52,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:22:41.98,0:22:43.94,Default,,0,0,0,,Неге жауап бермейсің!
Dialogue: 0,0:22:46.69,0:22:47.65,Default,,0,0,0,,Ереже…
Dialogue: 0,0:22:47.90,0:22:50.07,Default,,0,0,0,,(Есіктің қатты жабылу дыбысы)
Dialogue: 0,0:23:05.38,0:23:11.38,Default,,0,0,0,,♪〜
Dialogue: 0,0:24:58.91,0:25:04.92,Default,,0,0,0,,〜♪
Dialogue: 0,0:25:06.42,0:25:12.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory