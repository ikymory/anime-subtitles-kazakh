Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:01:14.27,Default,,0,0,0,,♬～
Dialogue: 0,0:01:14.27,0:01:20.78,Default,,0,0,0,,<Қаладан адамдар мүлдем жоғалып кеткендей➡
Dialogue: 0,0:01:20.78,0:01:24.95,Default,,0,0,0,,Маған бұл уақыт ұнайды.＞
Dialogue: 0,0:01:24.95,0:01:34.16,Default,,0,0,0,,♬～
Dialogue: 0,0:01:35.96,0:01:37.96,Default,,0,0,0,,(Мизуон)
Dialogue: 0,0:01:42.83,0:01:45.83,Default,,0,0,0,,<Суық емес пе...>
Dialogue: 0,0:01:56.81,0:01:59.15,Default,,0,0,0,,Күрсін.
Dialogue: 0,0:01:59.15,0:02:01.75,Default,,0,0,0,,Күрсін.
Dialogue: 0,0:02:01.75,0:02:05.25,Default,,0,0,0,,Жаман емес! Өте суық...
Dialogue: 0,0:02:05.25,0:02:10.26,Default,,0,0,0,,күрсіну. Күрсін. Күрсін.
Dialogue: 0,0:02:12.76,0:02:16.26,Default,,0,0,0,,<Жапондықтардың қыстары да суық деп ойладым➡
Dialogue: 0,0:02:16.26,0:02:18.93,Default,,0,0,0,,Германиядан жақсырақ болуы мүмкін＞
Dialogue: 0,0:02:18.93,0:02:21.24,Default,,0,0,0,,(Қанаттарын қаққан үйректердің дыбысы)
Dialogue: 0,0:02:32.48,0:02:38.29,Default,,0,0,0,,♬～(скрипка)
Dialogue: 0,0:02:38.29,0:03:01.78,Default,,0,0,0,,♬～
Dialogue: 0,0:03:03.38,0:03:05.38,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:03:16.93,0:03:20.63,Default,,0,0,0,,Мама, әлі жоқ па деп ойлаймын...
Dialogue: 0,0:03:25.63,0:03:33.28,Default,,0,0,0,,♬～(скрипка)
Dialogue: 0,0:03:33.28,0:03:42.28,Default,,0,0,0,,♬～
Dialogue: 0,0:03:42.28,0:03:45.29,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:03:45.29,0:03:48.42,Default,,0,0,0,,А... Анашым!
Dialogue: 0,0:03:48.42,0:03:52.29,Default,,0,0,0,,Анашым! Мен, мен ойнауға өте жақсы болдым!
Dialogue: 0,0:03:52.29,0:03:54.30,Default,,0,0,0,,Иә….
Dialogue: 0,0:03:57.63,0:04:00.60,Default,,0,0,0,,күрсіну. Мен жаттығу жасап, сені күттім!
Dialogue: 0,0:04:00.60,0:04:03.44,Default,,0,0,0,,Анам тыңдасын деп едім...
Dialogue: 0,0:04:03.44,0:04:06.24,Default,,0,0,0,,Кешіріңіз, кейінірек жасай аламын ба?
Dialogue: 0,0:04:06.24,0:04:09.75,Default,,0,0,0,,Мен алдағы спектакльдің материалдарын оқуым керек...
Dialogue: 0,0:04:12.11,0:04:14.12,Default,,0,0,0,,Иә….
Dialogue: 0,0:04:16.95,0:04:21.72,Default,,0,0,0,,<Егер мен қазір артыма қарасам, мен де сондай едім➡
Dialogue: 0,0:04:21.72,0:04:26.09,Default,,0,0,0,,«Анам тыңдағанын қалаймын» Дәл осы ой➡
Dialogue: 0,0:04:26.09,0:04:29.40,Default,,0,0,0,,Менің ойымша, ол скрипкада ойнады...＞
Dialogue: 0,0:04:29.40,0:04:33.77,Default,,0,0,0,,♬～
Dialogue: 0,0:04:33.77,0:04:40.41,Default,,0,0,0,,<Мүмкін... Арманын орындағысы келген ана үшін мен...>
Dialogue: 0,0:04:40.41,0:04:43.28,Default,,0,0,0,,(Дауыс)
Dialogue: 0,0:04:43.28,0:04:47.15,Default,,0,0,0,,<Бұл «жүк» болды ма? ＞
Dialogue: 0,0:04:47.15,0:04:49.78,Default,,0,0,0,,Еске алу (Саэкидің атасы) Атасының үйінде➡
Dialogue: 0,0:04:49.78,0:04:53.29,Default,,0,0,0,,Сіз бірге өмір сүргіңіз келе ме? Уф. ➡
Dialogue: 0,0:04:53.29,0:04:57.29,Default,,0,0,0,,Жалғыз анамды аяймын.
Dialogue: 0,0:04:57.29,0:05:00.36,Default,,0,0,0,,<Бос емес анамнан кету➡
Dialogue: 0,0:05:00.36,0:05:03.90,Default,,0,0,0,,Менің ата-әжеммен бірге тұру мүмкіндігі болды, бірақ...➡
Dialogue: 0,0:05:03.90,0:05:07.60,Default,,0,0,0,,Мен анаммен тұруды таңдадым>
Dialogue: 0,0:05:09.37,0:05:16.24,Default,,0,0,0,,<Анамды жалғыз қалдырмау үшін. Мен өз-өзіме анам үшін дедім, бірақ...➡
Dialogue: 0,0:05:16.24,0:05:20.25,Default,,0,0,0,,Мүмкін мен дәл осылай ойлағым келген шығар>
Dialogue: 0,0:05:22.75,0:05:25.39,Default,,0,0,0,,Ах... о...
Dialogue: 0,0:05:25.39,0:05:28.92,Default,,0,0,0,,<Бірақ шынымен...>
Dialogue: 0,0:05:28.92,0:05:30.96,Default,,0,0,0,,Күрсін.
Dialogue: 0,0:05:30.96,0:05:35.70,Default,,0,0,0,,♬～
Dialogue: 0,0:05:35.70,0:05:39.57,Default,,0,0,0,,Менің ол қыздан бөлек тұру ойым жоқ!
Dialogue: 0,0:05:39.57,0:05:43.47,Default,,0,0,0,,Мені біразға қалдырыңыз, Жақсы айттыңыз!
Dialogue: 0,0:05:43.47,0:05:51.18,Default,,0,0,0,,♬～
Dialogue: 0,0:05:51.18,0:05:53.42,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:53.42,0:05:58.79,Default,,0,0,0,,♬～
Dialogue: 0,0:05:58.79,0:06:01.56,Default,,0,0,0,,Анашым...?
Dialogue: 0,0:06:01.56,0:06:08.33,Default,,0,0,0,,♬～
Dialogue: 0,0:06:08.33,0:06:12.20,Default,,0,0,0,,Нао... суыққа сезімтал болғандықтан.
Dialogue: 0,0:06:12.20,0:06:29.08,Default,,0,0,0,,♬～
Dialogue: 0,0:06:29.08,0:06:34.39,Default,,0,0,0,,<Сол тұншыққан салқын ауа➡
Dialogue: 0,0:06:34.39,0:06:37.69,Default,,0,0,0,,Мен сені сағындым...＞
Dialogue: 0,0:06:39.26,0:06:53.11,Default,,0,0,0,,♬～
Dialogue: 0,0:06:53.11,0:06:56.61,Default,,0,0,0,,♬ «Өзім жылтыратып жүрген біртүрлі етік».
Dialogue: 0,0:06:56.61,0:07:01.45,Default,,0,0,0,,♬ «Мен көпшіліктің арасында бұрмаланып көріндім.»
Dialogue: 0,0:07:01.45,0:07:05.05,Default,,0,0,0,,♬ «Мен жүзіп жүрдім».
Dialogue: 0,0:07:05.05,0:07:11.23,Default,,0,0,0,,♬ «Таланттың биіне бас иемін, ыңғайсыз қимылдаймын».
Dialogue: 0,0:07:11.23,0:07:16.36,Default,,0,0,0,,♬ «Тістерін көрсетіп, жымиып тұрған Амадей түсінбейді».
Dialogue: 0,0:07:16.36,0:07:22.74,Default,,0,0,0,,♬ «Бір жерден біреудің дауысы естіледі»
Dialogue: 0,0:07:22.74,0:07:29.24,Default,,0,0,0,,♬ «Мен сияқты бұрмаланған және жалғыз ән»
Dialogue: 0,0:07:29.24,0:07:33.75,Default,,0,0,0,,♬ «Лорелей әуенді жоғалтқаннан кейін импровизация жасайды»
Dialogue: 0,0:07:33.75,0:07:36.65,Default,,0,0,0,,♬ «Бахтың қорапта ойнауы»
Dialogue: 0,0:07:36.65,0:07:41.26,Default,,0,0,0,,♬ «Мені көтеріп алып, сахнада биледім».
Dialogue: 0,0:07:41.26,0:07:45.59,Default,,0,0,0,,♬ «Түні бойы таусылатын сияқтымыз».
Dialogue: 0,0:07:45.59,0:07:53.10,Default,,0,0,0,,♬ «Ол әдемі көздерден басқа ештеңе көрмеймін».
Dialogue: 0,0:07:53.10,0:07:57.94,Default,,0,0,0,,♬ «Мен қалай көрінемін?»
Dialogue: 0,0:07:57.94,0:08:04.95,Default,,0,0,0,,♬～
Dialogue: 0,0:08:15.06,0:08:19.56,Default,,0,0,0,,＜Сонымен... суық нәрсе суық болады...＞
Dialogue: 0,0:08:19.56,0:08:22.90,Default,,0,0,0,,Бұл өте ерте.
Dialogue: 0,0:08:22.90,0:08:26.57,Default,,0,0,0,,Аюкава мырза. қайырлы таң.
Dialogue: 0,0:08:26.57,0:08:30.24,Default,,0,0,0,,Қайырлы таң. Жылыту қосылып тұрған жоқ па?
Dialogue: 0,0:08:30.24,0:08:33.07,Default,,0,0,0,,Ол әлі жұмыс істемейді.
Dialogue: 0,0:08:33.07,0:08:38.25,Default,,0,0,0,,Мұндағы жылыту да ескі... Солай ма?
Dialogue: 0,0:08:38.25,0:08:42.08,Default,,0,0,0,,Мен жаңасын сатып алуыңызды қалаймын...
Dialogue: 0,0:08:44.02,0:08:47.72,Default,,0,0,0,,Сіз... қойылым алдында бұрынғыдай суық тиіп қалмаңыз.
Dialogue: 0,0:08:50.59,0:08:52.93,Default,,0,0,0,,Иә….
Dialogue: 0,0:08:52.93,0:08:57.40,Default,,0,0,0,,Жақсы, мен оны суық кезде жақсы көремін.
Dialogue: 0,0:08:57.40,0:09:02.70,Default,,0,0,0,,Жазғы аптап ыстықтан әлдеқайда жақсы. Мен қысты жақсы көремін.
Dialogue: 0,0:09:02.70,0:09:04.64,Default,,0,0,0,,Мен де.
Dialogue: 0,0:09:04.64,0:09:09.48,Default,,0,0,0,,О, түсіндім. Ол жақта Жапонияға қарағанда суық...
Dialogue: 0,0:09:09.48,0:09:13.21,Default,,0,0,0,,Германияда қыстың ортасында мен де жауап бердім деп ойлаймын.
Dialogue: 0,0:09:13.21,0:09:16.12,Default,,0,0,0,,Мұғалім, сіз сонда болдыңыз ба?
Dialogue: 0,0:09:16.12,0:09:21.56,Default,,0,0,0,,Неше рет? Бұл менің жас кезімнен жақсы көретін жерім. ➡
Dialogue: 0,0:09:21.56,0:09:26.73,Default,,0,0,0,,Университетте оқып жүрген кезімде мен неміс тілін қатты үйрендім. ➡
Dialogue: 0,0:09:26.73,0:09:30.60,Default,,0,0,0,,Мен бұл туралы қазір мүлдем ұмыттым.
Dialogue: 0,0:09:30.60,0:09:32.90,Default,,0,0,0,,<Ұмыту...>
Dialogue: 0,0:09:32.90,0:09:35.80,Default,,0,0,0,,Ойлап қарасам, кешегі хормен жаттығу➡
Dialogue: 0,0:09:35.80,0:09:38.81,Default,,0,0,0,,Сіз керемет болған сияқтысыз.
Dialogue: 0,0:09:41.24,0:09:44.15,Default,,0,0,0,,Сено-сенсэй сені мақтады. ➡
Dialogue: 0,0:09:44.15,0:09:47.92,Default,,0,0,0,,Егер сізді хорға шақырса, одан бас тартыңыз.
Dialogue: 0,0:09:47.92,0:09:50.59,Default,,0,0,0,,үшін асыра айтып жатыр.
Dialogue: 0,0:09:50.59,0:09:54.26,Default,,0,0,0,,Хордағы адамдар одан да керемет болды.
Dialogue: 0,0:09:54.26,0:09:56.59,Default,,0,0,0,,Кішіпейіл бол.
Dialogue: 0,0:09:56.59,0:10:00.26,Default,,0,0,0,,Мен басқалардан сәл артық болдым.
Dialogue: 0,0:10:00.26,0:10:03.26,Default,,0,0,0,,Мақтаған кезде, бақытты бол!
Dialogue: 0,0:10:03.26,0:10:06.60,Default,,0,0,0,,«Мен бақыттымын!» дегенді есте ұстаған дұрыс. ➡
Dialogue: 0,0:10:06.60,0:10:10.11,Default,,0,0,0,,Өзіне деген сенімділікке жетелейді, ән айту мен орындауды жақсартады. ➡
Dialogue: 0,0:10:10.11,0:10:13.41,Default,,0,0,0,,Көбірек эмоцияларды көрсет!
Dialogue: 0,0:10:13.41,0:10:18.25,Default,,0,0,0,,Жарайды, бұрынғыдан әлдеқайда жақсы, бірақ...
Dialogue: 0,0:10:18.25,0:10:22.55,Default,,0,0,0,,Бірақ... бір күні ұмытарсың, солай ма?
Dialogue: 0,0:10:24.15,0:10:29.66,Default,,0,0,0,,Мен кенет ойладым... Кішкентай кезімнен қызықты естеліктер...
Dialogue: 0,0:10:34.30,0:10:39.13,Default,,0,0,0,,Жақында болғандай есіңізде болса да...➡
Dialogue: 0,0:10:39.13,0:10:44.34,Default,,0,0,0,,Мен осындай нәрселерді есіме түсіру қиынға соға бастағандай сезінемін...
Dialogue: 0,0:10:45.91,0:10:47.84,Default,,0,0,0,,Хмм….
Dialogue: 0,0:10:47.84,0:10:52.98,Default,,0,0,0,,Рас... менің жасымда сен ұмытшақсың.
Dialogue: 0,0:10:52.98,0:10:56.02,Default,,0,0,0,,Не? (Аюкава) Бұл әзіл.
Dialogue: 0,0:10:56.02,0:11:01.02,Default,,0,0,0,,Бірақ ұмытып кететініміз рас шығар.
Dialogue: 0,0:11:04.39,0:11:08.60,Default,,0,0,0,,Мен білмей ішімде ғайып болған естеліктер➡
Dialogue: 0,0:11:08.60,0:11:11.27,Default,,0,0,0,,Менің ойымша, көп. ➡
Dialogue: 0,0:11:11.27,0:11:14.77,Default,,0,0,0,,Бірақ... бұл мен ұмытып кеткен дүниелер➡
Dialogue: 0,0:11:14.77,0:11:17.81,Default,,0,0,0,,Бұл сенің қазір кім екеніңнің еті мен қаны емес пе?
Dialogue: 0,0:11:17.81,0:11:21.64,Default,,0,0,0,,Бұл мағынада мүлде ұмыту➡ дегенді білдіреді
Dialogue: 0,0:11:21.64,0:11:24.65,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:11:27.28,0:11:30.18,Default,,0,0,0,,Ах…. қайырлы таң.
Dialogue: 0,0:11:30.18,0:11:32.79,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:11:32.79,0:11:36.29,Default,,0,0,0,,Әлі ерте, солай емес пе?
Dialogue: 0,0:11:36.29,0:11:38.79,Default,,0,0,0,,Саэки.
Dialogue: 0,0:11:38.79,0:11:42.10,Default,,0,0,0,,Сізде «бұл» бар, солай ма?
Dialogue: 0,0:11:47.97,0:11:50.77,Default,,0,0,0,,Оны ойнап көріңіз.
Dialogue: 0,0:11:53.78,0:11:56.28,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:58.15,0:12:02.85,Default,,0,0,0,,<Түсіндім, сіз оны өнімділігіңізге толтыра аласыз...>
Dialogue: 0,0:12:04.92,0:12:07.59,Default,,0,0,0,,Аоно-кун.
Dialogue: 0,0:12:07.59,0:12:10.29,Default,,0,0,0,,Менімен біраз уақыт бірге болыңыз.
Dialogue: 0,0:12:19.20,0:12:21.60,Default,,0,0,0,,Сабу!
Dialogue: 0,0:12:21.60,0:12:25.41,Default,,0,0,0,,Неліктен осындай салқын жерде жаттығу жасап әуре болдың? ?
Dialogue: 0,0:12:25.41,0:12:29.28,Default,,0,0,0,,Туған жердің салқынын еске түсіре ме деп ойлаймын. иә?
Dialogue: 0,0:12:29.28,0:12:33.78,Default,,0,0,0,,Бұл аз ғана, өтінемін.
Dialogue: 0,0:12:33.78,0:12:37.29,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:12:58.31,0:13:09.75,Default,,0,0,0,,♬～
Dialogue: 0,0:13:09.75,0:13:13.59,Default,,0,0,0,,<Қаланың сұлбасы...➡
Dialogue: 0,0:13:13.59,0:13:19.39,Default,,0,0,0,,Күн сәулесімен нұрланып, жайлап ашылғандай...>
Dialogue: 0,0:13:19.39,0:13:49.49,Default,,0,0,0,,♬～
Dialogue: 0,0:13:49.49,0:13:53.80,Default,,0,0,0,,<Суықтан аздап қалтырап тұрғандай...>
Dialogue: 0,0:13:53.80,0:14:07.34,Default,,0,0,0,,♬～
Dialogue: 0,0:14:07.34,0:14:10.24,Default,,0,0,0,,<Жұмсақ бол...>
Dialogue: 0,0:14:10.24,0:14:18.12,Default,,0,0,0,,♬～
Dialogue: 0,0:14:18.12,0:14:23.26,Default,,0,0,0,,<Қыстың тыныштығын қалыптастыру...>
Dialogue: 0,0:14:23.26,0:14:40.27,Default,,0,0,0,,♬～
Dialogue: 0,0:14:40.27,0:14:43.95,Default,,0,0,0,,<Бұл жігіт...➡
Dialogue: 0,0:14:43.95,0:14:49.28,Default,,0,0,0,,Осы жұмсақ... ойнай алдыңыз ба? ＞
Dialogue: 0,0:14:49.28,0:14:54.42,Default,,0,0,0,,♬～
Dialogue: 0,0:14:54.42,0:14:57.33,Default,,0,0,0,,Аа... (Мари) Ммм.
Dialogue: 0,0:14:57.33,0:15:07.74,Default,,0,0,0,,♬～
Dialogue: 0,0:15:07.74,0:15:10.37,Default,,0,0,0,,<Ұмытпаймын...>
Dialogue: 0,0:15:10.37,0:15:20.75,Default,,0,0,0,,♬～
Dialogue: 0,0:15:20.75,0:15:25.25,Default,,0,0,0,,＜Әр нота менің ішімде ойып жазылады＞
Dialogue: 0,0:15:25.25,0:16:01.76,Default,,0,0,0,,♬～
Dialogue: 0,0:16:06.36,0:16:10.57,Default,,0,0,0,,Бірдеңе болды ма? неге...?
Dialogue: 0,0:16:12.17,0:16:16.10,Default,,0,0,0,,Иә...не...?➡
Dialogue: 0,0:16:16.10,0:16:19.81,Default,,0,0,0,,Көрсетілім әлдеқайда жақсарды.
Dialogue: 0,0:16:21.74,0:16:23.78,Default,,0,0,0,,(Стефани) Маған оның бәрі бір! Ең бастысы —
Dialogue: 0,0:16:23.78,0:16:26.91,Default,,0,0,0,,Бұл тек ән айту емес, соншалықты қулық!
Dialogue: 0,0:16:26.91,0:16:29.75,Default,,0,0,0,,Сіз ұтыласыз деп үміттенемін!
Dialogue: 0,0:16:29.75,0:16:32.39,Default,,0,0,0,,<Сегіз соққы…>
Dialogue: 0,0:16:32.39,0:16:35.59,Default,,0,0,0,,Дұрыс... иә?
Dialogue: 0,0:16:35.59,0:16:41.46,Default,,0,0,0,,Сіз Германияның үйдегі суық екенін айтқан кезде ме едіңіз? Иә.
Dialogue: 0,0:16:41.46,0:16:45.93,Default,,0,0,0,,Германияда шынымен суық емес пе? Мен келісемін.
Dialogue: 0,0:16:45.93,0:16:49.40,Default,,0,0,0,,Сіз әлі де қыста далада қарда ойнайсыз ба?
Dialogue: 0,0:16:49.40,0:16:54.11,Default,,0,0,0,,Иә. Мен бір оркестрдің басқа балаларымен қарлы шайқасатынмын...
Dialogue: 0,0:16:54.11,0:16:57.41,Default,,0,0,0,,Бірақ? жоқ….
Dialogue: 0,0:16:57.41,0:17:01.22,Default,,0,0,0,,Аоно-кунды Германиядағы заттар қызықтырады➡
Dialogue: 0,0:17:01.22,0:17:03.52,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:17:03.52,0:17:07.99,Default,,0,0,0,,Бірақ, маған сіздің қандай өмір сүргеніңіз қызық.
Dialogue: 0,0:17:07.99,0:17:09.92,Default,,0,0,0,,Маған кез келген нәрсені сұраңыз!
Dialogue: 0,0:17:09.92,0:17:12.73,Default,,0,0,0,,Айтпақшы, мен өте танымал болдым.
Dialogue: 0,0:17:12.73,0:17:14.66,Default,,0,0,0,,Маған бәрібір!
Dialogue: 0,0:17:25.74,0:17:34.92,Default,,0,0,0,,♬ «Бәріміз фестивальге жиналайық».
Dialogue: 0,0:17:34.92,0:17:41.26,Default,,0,0,0,,♬ «Мен көптен күттім».
Dialogue: 0,0:17:41.26,0:17:45.26,Default,,0,0,0,,♬ «Иеміз әдемі»
Dialogue: 0,0:17:45.26,0:17:51.97,Default,,0,0,0,,♬ «Иеміз жақсы»
Dialogue: 0,0:17:53.77,0:17:57.94,Default,,0,0,0,,Аоно-кунның дауысы шығып жатыр. рақмет сізге!
Dialogue: 0,0:17:57.94,0:17:59.87,Default,,0,0,0,,Аа...
Dialogue: 0,0:17:59.87,0:18:02.18,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:18:04.75,0:18:07.62,Default,,0,0,0,,Мені мақтады...
Dialogue: 0,0:18:07.62,0:18:10.52,Default,,0,0,0,,Шишишишиши…. Оған қарама!
Dialogue: 0,0:18:10.52,0:18:13.35,Default,,0,0,0,,Мақтау алған кезде қуану керек.
Dialogue: 0,0:18:13.35,0:18:17.22,Default,,0,0,0,,Шулы! Бұл қуып жетуге тырысады!
Dialogue: 0,0:18:17.22,0:18:20.23,Default,,0,0,0,,А, онда сәйкестендіреміз бе?
Dialogue: 0,0:18:22.36,0:18:31.57,Default,,0,0,0,,♬ «Бәріміз фестивальге жиналайық».
Dialogue: 0,0:18:31.57,0:18:35.24,Default,,0,0,0,,♬ «Мен көптен күттім».
Dialogue: 0,0:18:35.24,0:18:38.08,Default,,0,0,0,,Оны да жасайық!
Dialogue: 0,0:18:38.08,0:18:42.58,Default,,0,0,0,,♬ «Иеміз осында, Иеміз осында»
Dialogue: 0,0:18:42.58,0:18:48.26,Default,,0,0,0,,♬ «Иеміз жақсы»
Dialogue: 0,0:18:48.26,0:18:51.93,Default,,0,0,0,,♬ «Шайтанның үйі»
Dialogue: 0,0:18:51.93,0:18:56.26,Default,,0,0,0,,Аюкава-кун бұл сөзді айтып тұрғаны осы ма? ➡
Dialogue: 0,0:18:56.26,0:19:01.27,Default,,0,0,0,,Тынымсыз еңбек етіп жатқан адамды көргенде хабар тарайды.
Dialogue: 0,0:19:02.87,0:19:04.91,Default,,0,0,0,,Сіз айлакерсіз.
Dialogue: 0,0:19:04.91,0:19:08.21,Default,,0,0,0,,Мен ерекше ештеңе істеген жоқпын. ➡
Dialogue: 0,0:19:08.21,0:19:13.51,Default,,0,0,0,,үшін оқушылардың өз әрекеттерінің нәтижесі.
Dialogue: 0,0:19:16.35,0:19:20.55,Default,,0,0,0,,О... Мен де солай сезінемін.
Dialogue: 0,0:19:20.55,0:19:24.23,Default,,0,0,0,,Көшбасшы ретінде мен де ұтыла алмаймын.
Dialogue: 0,0:19:24.23,0:19:27.06,Default,,0,0,0,,<Мен...сол біртүрлі қосқышты ұмытып қалдым...>
Dialogue: 0,0:19:27.06,0:19:31.93,Default,,0,0,0,,Мен өзімді қайтадан студент болғандай сезінемін! Ахахаха.
Dialogue: 0,0:19:31.93,0:19:37.74,Default,,0,0,0,,Өзіңді әшкерелесе де, жарысатын адам болғаны жақсы!
Dialogue: 0,0:19:39.64,0:19:42.44,Default,,0,0,0,,Сено мырза. (Сено) Иә.
Dialogue: 0,0:19:44.25,0:19:47.92,Default,,0,0,0,,Мен кіммен бәсекелесе аламын?
Dialogue: 0,0:19:47.92,0:19:51.12,Default,,0,0,0,,Такеда-кунды еске түсіру, бұл пайдалы.
Dialogue: 0,0:19:52.75,0:19:57.26,Default,,0,0,0,,Дзюдо клубының бұрынғы мүшесінен күткендей. (Такеда) Ауыр жүкті маған қалдыр!
Dialogue: 0,0:19:57.26,0:20:00.16,Default,,0,0,0,,Рахмет, Такеда-кун.
Dialogue: 0,0:20:00.16,0:20:03.06,Default,,0,0,0,,Хмм. ➡
Dialogue: 0,0:20:03.06,0:20:07.97,Default,,0,0,0,,Аюкава дәрменсіз. (Аюкава) Алаңдамаңыз.
Dialogue: 0,0:20:07.97,0:20:15.94,Default,,0,0,0,,(Аоно мен Саэкидің әңгімесі)
Dialogue: 0,0:20:15.94,0:20:18.95,Default,,0,0,0,,Мен оны ешқашан ұмытпаймын...
Dialogue: 0,0:20:39.97,0:20:46.14,Default,,0,0,0,,<Рождествода қар жауса, романтикалық болар еді. ➡
Dialogue: 0,0:20:46.14,0:20:50.64,Default,,0,0,0,,Не… бұл туралы көбірек ойланамын➡
Dialogue: 0,0:20:50.64,0:20:54.82,Default,,0,0,0,,Мен Рождество туралы армандағым келмейді. ➡
Dialogue: 0,0:20:54.82,0:20:59.69,Default,,0,0,0,,Тіпті... жаңбыр жаумауы керек. ➡
Dialogue: 0,0:20:59.69,0:21:03.62,Default,,0,0,0,,Біріншіден, бүгін Рождество емес...>
Dialogue: 0,0:21:03.62,0:21:06.39,Default,,0,0,0,,Козакура мырза!
Dialogue: 0,0:21:06.39,0:21:09.30,Default,,0,0,0,,Аоно-кун. Жақсы.
Dialogue: 0,0:21:09.30,0:21:12.60,Default,,0,0,0,,Өтетін орны Мен бұл жердің дұрыс екеніне сенімді емес едім.
Dialogue: 0,0:21:12.60,0:21:16.77,Default,,0,0,0,,Менің ойымша, бұл дұрыс шығар. Қараңыз.
Dialogue: 0,0:21:16.77,0:21:18.81,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:18.81,0:21:21.41,Default,,0,0,0,,Бүгін күні бойы жаңбыр жауа ма?
Dialogue: 0,0:21:21.41,0:21:24.28,Default,,0,0,0,,Музыкалық аспаптарды тасымалдау қиын.
Dialogue: 0,0:21:24.28,0:21:28.28,Default,,0,0,0,,Бәрібір қар жауса ғой. ана….
Dialogue: 0,0:21:31.42,0:21:41.80,Default,,0,0,0,,♬～
Dialogue: 0,0:21:41.80,0:21:45.30,Default,,0,0,0,,Мүмкін осында... дұрыс па?
Dialogue: 0,0:21:48.97,0:21:51.64,Default,,0,0,0,,＜Бірдеңе…➡
Dialogue: 0,0:21:51.64,0:21:55.51,Default,,0,0,0,,Нағашымның тойын еске түсіреді. ➡
Dialogue: 0,0:21:55.51,0:22:00.25,Default,,0,0,0,,«Мен алдағы жарысқа ақ көйлек алғым келеді!» ➡
Dialogue: 0,0:22:00.25,0:22:03.45,Default,,0,0,0,,Анаңды мазаладың ба...>
Dialogue: 0,0:22:05.09,0:22:07.99,Default,,0,0,0,,Біз кіреміз бе? иә!
Dialogue: 0,0:22:07.99,0:22:16.10,Default,,0,0,0,,♬～
Dialogue: 0,0:22:16.10,0:22:18.13,Default,,0,0,0,,Уау….
Dialogue: 0,0:22:18.13,0:22:53.43,Default,,0,0,0,,♬～
Dialogue: 0,0:22:53.43,0:22:55.94,Default,,0,0,0,,Керемет….
Dialogue: 0,0:22:58.97,0:23:04.28,Default,,0,0,0,,<Бүгін нағыз Рождестволық концерт>
Dialogue: 0,0:23:10.62,0:23:19.09,Default,,0,0,0,,♬～
Dialogue: 0,0:23:19.09,0:23:22.96,Default,,0,0,0,,♬ «Мен оны сізден алдым».
Dialogue: 0,0:23:22.96,0:23:28.80,Default,,0,0,0,,♬ «Сәйкес келетін үш жиілік кілтті салпыншақ»
Dialogue: 0,0:23:28.80,0:23:34.64,Default,,0,0,0,,♬ «Мен оны жоғалтып алдым, сені енді көре алмаймын».
Dialogue: 0,0:23:34.64,0:23:38.41,Default,,0,0,0,,♬ «Ағаштарды сүзіп өткен таңғажайып күн сәулесі»
Dialogue: 0,0:23:38.41,0:23:42.28,Default,,0,0,0,,♬ «Мен ешқашан орала алмаймын»
Dialogue: 0,0:23:42.28,0:23:49.42,Default,,0,0,0,,♬ "Мен өткенді жек көремін. Метроном, тоқтама".
Dialogue: 0,0:23:49.42,0:23:56.13,Default,,0,0,0,,♬ «Маған уақыт машинасы қажет емес».
Dialogue: 0,0:23:56.13,0:24:03.87,Default,,0,0,0,,♬ «Бірақ, мен сені сол кезде кездестірсем.»
Dialogue: 0,0:24:03.87,0:24:13.25,Default,,0,0,0,,♬ "Жарайды, жарайды, жұлдыздардың сиқыры сізді орап алады"
Dialogue: 0,0:24:13.25,0:24:19.39,Default,,0,0,0,,♬ «Мен саған жарық болғым келеді».
Dialogue: 0,0:24:19.39,0:24:28.40,Default,,0,0,0,,♬ «Жарайды, жарайды, өтінемін, уақыттың сиқыры».
Dialogue: 0,0:24:28.40,0:24:36.10,Default,,0,0,0,,♬ «Мен сенімен мәңгі бірге болғым келеді».
Dialogue: 0,0:24:37.60,0:24:43.60,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
