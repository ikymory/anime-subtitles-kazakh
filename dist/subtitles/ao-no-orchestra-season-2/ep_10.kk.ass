Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.40,0:00:07.94,Default,,0,0,0,,<Қараша➡
Dialogue: 0,0:00:07.94,0:00:11.94,Default,,0,0,0,,Жарыстың аяқталғанына бір апта болды＞
Dialogue: 0,0:00:13.61,0:00:17.11,Default,,0,0,0,,＜Мүмкін әлі ерте болған шығар...＞
Dialogue: 0,0:00:17.11,0:00:19.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:19.78,0:00:21.78,Default,,0,0,0,,Козакура мырза!
Dialogue: 0,0:00:23.42,0:00:26.32,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз! (Козакура Хару) Иә! ? Уф!
Dialogue: 0,0:00:26.32,0:00:29.63,Default,,0,0,0,,Мен рұқсатсыз ерте келдім!
Dialogue: 0,0:00:29.63,0:00:34.13,Default,,0,0,0,,Мен әдеттегіден ерте ояндым. Бұл дұрыс.
Dialogue: 0,0:00:34.13,0:00:42.00,Default,,0,0,0,,♬～
Dialogue: 0,0:00:42.00,0:00:45.14,Default,,0,0,0,,Ал... бәрібір кеттік!
Dialogue: 0,0:00:45.14,0:00:47.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:47.81,0:00:50.45,Default,,0,0,0,,<Бұл қорқынышты... ➡
Dialogue: 0,0:00:50.45,0:00:53.95,Default,,0,0,0,,Мен қобалжи бастадым...>
Dialogue: 0,0:00:56.32,0:01:10.10,Default,,0,0,0,,♬～
Dialogue: 0,0:01:10.10,0:01:13.60,Default,,0,0,0,,♬ «Өзім жылтыратып жүрген біртүрлі етік».
Dialogue: 0,0:01:13.60,0:01:18.47,Default,,0,0,0,,♬ «Мен көпшіліктің арасында бұрмаланған болып көріндім».
Dialogue: 0,0:01:18.47,0:01:22.11,Default,,0,0,0,,♬ «Мен жүзіп жүрдім».
Dialogue: 0,0:01:22.11,0:01:28.28,Default,,0,0,0,,♬ «Таланттың биіне бас иемін, Ебедейсіз қозғаламын».
Dialogue: 0,0:01:28.28,0:01:33.42,Default,,0,0,0,,♬ «Тістерін көрсетіп жымиған Амадей түсінбейді».
Dialogue: 0,0:01:33.42,0:01:39.80,Default,,0,0,0,,♬ «Бір жерден біреудің дауысы естіледі»
Dialogue: 0,0:01:39.80,0:01:46.30,Default,,0,0,0,,♬ «Мен сияқты бұрмаланған және жалғыз ән»
Dialogue: 0,0:01:46.30,0:01:50.81,Default,,0,0,0,,♬ «Лорелей әуенді жоғалтқаннан кейін импровизация жасайды»
Dialogue: 0,0:01:50.81,0:01:53.71,Default,,0,0,0,,♬ «Бахтың қорапта ойнауы»
Dialogue: 0,0:01:53.71,0:01:58.31,Default,,0,0,0,,♬ «Мені көтеріп алып, сахнада биледім».
Dialogue: 0,0:01:58.31,0:02:02.58,Default,,0,0,0,,♬ «Түні бойы таусылатын сияқтымыз».
Dialogue: 0,0:02:02.58,0:02:10.09,Default,,0,0,0,,♬ «Ол әдемі көздерден басқа ештеңе көрмеймін».
Dialogue: 0,0:02:10.09,0:02:14.93,Default,,0,0,0,,♬ «Мен қалай көрінемін?»
Dialogue: 0,0:02:14.93,0:02:21.94,Default,,0,0,0,,♬～
Dialogue: 0,0:02:26.54,0:02:29.48,Default,,0,0,0,,Үйірме жұмыстарынан үзіліс алғаныма біраз болды.
Dialogue: 0,0:02:29.48,0:02:33.12,Default,,0,0,0,,Жарысқа дейін уақытым аз болғандықтан қиын болды.
Dialogue: 0,0:02:33.12,0:02:36.42,Default,,0,0,0,,Бірақ менің ойымша, біз мұнымен аздап демалуға болады.
Dialogue: 0,0:02:36.42,0:02:41.12,Default,,0,0,0,,Сакума-сенпай бәрінің тым босаңсығанына алаңдады.
Dialogue: 0,0:02:41.12,0:02:43.13,Default,,0,0,0,,Ахаха.
Dialogue: 0,0:02:46.43,0:02:49.30,Default,,0,0,0,,Олай болса, келесі аптада маған қоңырау шалғыңыз келе ме?
Dialogue: 0,0:02:49.30,0:02:51.97,Default,,0,0,0,,Иә? Жарайды ма? Маған қалдырыңыз.
Dialogue: 0,0:02:51.97,0:02:55.64,Default,,0,0,0,,<немесе... Мен әңгімені жалғастыра алмаймын... ➡
Dialogue: 0,0:02:55.64,0:02:59.98,Default,,0,0,0,,Біз бір нәрсе туралы сөйлесуіміз керек... иә? ➡
Dialogue: 0,0:02:59.98,0:03:04.28,Default,,0,0,0,,Бірақ мұндай жағдайда мен не айтуым керек...? ＞
Dialogue: 0,0:03:05.78,0:03:08.78,Default,,0,0,0,,<Біз уәде берген күннен бастап...>
Dialogue: 0,0:03:08.78,0:03:12.55,Default,,0,0,0,,Еске алу Мен музыкалық аспаптар дүкеніне барғым келеді деп ойлаймын. ➡
Dialogue: 0,0:03:12.55,0:03:15.26,Default,,0,0,0,,Неге бірге бармаймыз...?
Dialogue: 0,0:03:15.26,0:03:19.76,Default,,0,0,0,,<Қозақура-санның алдында қандай бет жасауым керек?➡
Dialogue: 0,0:03:19.76,0:03:21.80,Default,,0,0,0,,Мен білмеймін…>
Dialogue: 0,0:03:21.80,0:03:29.27,Default,,0,0,0,,♬～
Dialogue: 0,0:03:29.27,0:03:33.61,Default,,0,0,0,,Уау... Жарыстағы басқа мектептердің өнері де керемет болды!
Dialogue: 0,0:03:33.61,0:03:37.41,Default,,0,0,0,,Иә! Барлық жерде деңгей жоғары болды...
Dialogue: 0,0:03:37.41,0:03:41.28,Default,,0,0,0,,Маған Акитадағы орта мектебім қатты әсер етті...
Dialogue: 0,0:03:41.28,0:03:45.62,Default,,0,0,0,,Өйткені, басқа мектептердің қойылымдарын тыңдау сізді ынталандырады.
Dialogue: 0,0:03:45.62,0:03:50.79,Default,,0,0,0,,Келесі концерт келесі айда болады, солай ма? Мен оны асыға күтемін.
Dialogue: 0,0:03:50.79,0:03:54.96,Default,,0,0,0,,Бірақ оған дейін жақын арада қорытынды емтихан келеді.
Dialogue: 0,0:03:54.96,0:03:56.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:59.84,0:04:02.24,Default,,0,0,0,,Мен ұмытып қалдым...
Dialogue: 0,0:04:02.24,0:04:05.91,Default,,0,0,0,,Дәлірек айтсам, есімде қалмауға тырыстым...
Dialogue: 0,0:04:05.91,0:04:09.75,Default,,0,0,0,,Мм... Аоно-кун жақсы деп үміттенемін➡
Dialogue: 0,0:04:09.75,0:04:13.08,Default,,0,0,0,,Келесі жолы тестке бірге дайындалсақ ше?
Dialogue: 0,0:04:13.08,0:04:16.92,Default,,0,0,0,,Не? Ал, бұл...
Dialogue: 0,0:04:16.92,0:04:19.96,Default,,0,0,0,,Ах. Аоно-кун станциясы міне осы! ? сурет...!
Dialogue: 0,0:04:19.96,0:04:22.96,Default,,0,0,0,,Мен түсуім керек! аа….
Dialogue: 0,0:04:24.79,0:04:29.00,Default,,0,0,0,,<«Екі адам?» деп сұрай алмаймын...>
Dialogue: 0,0:04:31.27,0:04:34.17,Default,,0,0,0,,Бұл музыкалық аспаптар дүкені ме?
Dialogue: 0,0:04:34.17,0:04:39.47,Default,,0,0,0,,Бұл шынымен де музыкалық дүкенге ұқсамайды, солай ма? Бүгін істеп жатырсың ба?
Dialogue: 0,0:04:42.28,0:04:46.95,Default,,0,0,0,,Еске алу Келесі жолы тестілеуге бірге дайындалсақ қалай болады?
Dialogue: 0,0:04:46.95,0:04:52.75,Default,,0,0,0,,<Мен оны күтпеген жерден шақыруға тырыстым, бірақ... Бұл жақсы нәрсе болды ма...? ➡
Dialogue: 0,0:04:52.75,0:04:58.56,Default,,0,0,0,,Біріншіден, Аоно-кунмен қалыпты сөйлесе аламын ба...? ➡
Dialogue: 0,0:04:58.56,0:05:01.46,Default,,0,0,0,,Кездейсоқ әңгіме➡
Dialogue: 0,0:05:01.46,0:05:05.43,Default,,0,0,0,,Басқа адамға көрсетілген мимика мен ым-ишара➡
Dialogue: 0,0:05:05.43,0:05:09.24,Default,,0,0,0,,Мен мұны қалыпты түрде жасай алуым керек➡
Dialogue: 0,0:05:09.24,0:05:12.57,Default,,0,0,0,,Менің басым босқа кетті...➡
Dialogue: 0,0:05:12.57,0:05:17.25,Default,,0,0,0,,Мен не істерімді білмеймін >
Dialogue: 0,0:05:17.25,0:05:19.75,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:05:19.75,0:05:24.59,Default,,0,0,0,,Сәлеметсіз бе, қош келдіңіз. Біраз уақыт болды, Хаджиме-кун.
Dialogue: 0,0:05:24.59,0:05:29.46,Default,,0,0,0,,Иә. Бүгін мен сендерге бантик шаштарын ауыстырып, аспаптарға қараңдар деп едім.
Dialogue: 0,0:05:29.46,0:05:34.76,Default,,0,0,0,,Сіз менімен бірге жүрсіз бе? Иә! Сәлем!
Dialogue: 0,0:05:34.76,0:05:39.27,Default,,0,0,0,,Ал, мен сендерге аздап көрсетейін. Отырыңыз және күтіңіз.
Dialogue: 0,0:05:46.94,0:05:48.88,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:05:48.88,0:05:51.81,Default,,0,0,0,,Рахмет. рақмет сізге!
Dialogue: 0,0:05:51.81,0:05:55.62,Default,,0,0,0,,Айтпақшы... екеуің ғашықсыңдар ма?
Dialogue: 0,0:05:55.62,0:05:59.79,Default,,0,0,0,,Цк... жоқ! Екеуі бір клубта...!
Dialogue: 0,0:05:59.79,0:06:01.99,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:04.76,0:06:07.90,Default,,0,0,0,,＜«Жоқ»... ➡
Dialogue: 0,0:06:07.90,0:06:12.73,Default,,0,0,0,,Бар күшіңмен жоққа шығарудың қажеті жоқ... ➡
Dialogue: 0,0:06:12.73,0:06:15.44,Default,,0,0,0,,Менің ақымақ…＞
Dialogue: 0,0:06:17.91,0:06:20.74,Default,,0,0,0,,Негізгі құрылғыда да ақау болған жоқ.
Dialogue: 0,0:06:20.74,0:06:24.25,Default,,0,0,0,,Шынымен! ? Сіз оны жақсы пайдаланып жатырсыз.
Dialogue: 0,0:06:24.25,0:06:27.75,Default,,0,0,0,,Иә. Негізі жарыс алдында келгім келді.
Dialogue: 0,0:06:27.75,0:06:29.68,Default,,0,0,0,,<Көңілді көрінеді... ➡
Dialogue: 0,0:06:29.68,0:06:34.26,Default,,0,0,0,,Мен скрипка туралы ойлауым керек...➡
Dialogue: 0,0:06:34.26,0:06:38.76,Default,,0,0,0,,Мен ең нашармын... ➡
Dialogue: 0,0:06:38.76,0:06:41.66,Default,,0,0,0,,Кешіріңіз…＞
Dialogue: 0,0:06:41.66,0:06:45.27,Default,,0,0,0,,Келесі аптада аяқталады, солай ма?
Dialogue: 0,0:06:45.27,0:06:50.41,Default,,0,0,0,,Иә. Жақсы емес пе? Ух... иә! Өйткені менде қосалқы бар.
Dialogue: 0,0:06:50.41,0:06:54.11,Default,,0,0,0,,<Келесі апта дегеніміз...➡
Dialogue: 0,0:06:54.11,0:06:59.81,Default,,0,0,0,,Сонда Аоно-кун екеуің қайтадан бірге бола аласыңдар...? ＞
Dialogue: 0,0:07:02.55,0:07:05.45,Default,,0,0,0,,Бүгінгі күн үшін рахмет, Козакура-сан.
Dialogue: 0,0:07:05.45,0:07:09.42,Default,,0,0,0,,Мен мұндай адаммен музыкалық дүкенге бірінші рет бардым➡
Dialogue: 0,0:07:09.42,0:07:13.23,Default,,0,0,0,,Бұл жаңа және... қызық болды.
Dialogue: 0,0:07:19.90,0:07:21.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:23.77,0:07:26.68,Default,,0,0,0,,Бұл станция ма...?
Dialogue: 0,0:07:26.68,0:07:29.91,Default,,0,0,0,,<Үйге барар ма екенмін... ➡
Dialogue: 0,0:07:29.91,0:07:31.85,Default,,0,0,0,,Дұрыс... ➡
Dialogue: 0,0:07:31.85,0:07:35.72,Default,,0,0,0,,Музыкалық дүкенге бару мақсатым орындалды➡
Dialogue: 0,0:07:35.72,0:07:41.09,Default,,0,0,0,,«Танысу»... Мен ғана солай ойлаймын...＞
Dialogue: 0,0:07:41.09,0:07:45.79,Default,,0,0,0,,Олай болса... Қарным ашты, тамақ ішейік.
Dialogue: 0,0:07:47.40,0:07:49.40,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:07:53.10,0:07:57.97,Default,,0,0,0,,＜Күн ашық немесе бұлтты➡
Dialogue: 0,0:07:57.97,0:08:03.21,Default,,0,0,0,,Қуанышты немесе қобалжу...＞
Dialogue: 0,0:08:03.21,0:08:05.71,Default,,0,0,0,,Ол жерде бос.
Dialogue: 0,0:08:05.71,0:08:10.55,Default,,0,0,0,,<Менің ойымша, бұл ауа-райы сияқты>
Dialogue: 0,0:08:10.55,0:08:22.76,Default,,0,0,0,,♬～
Dialogue: 0,0:08:26.90,0:08:30.24,Default,,0,0,0,,Козакура-сан тәттілерді қатты жақсы көреді.
Dialogue: 0,0:08:30.24,0:08:33.58,Default,,0,0,0,,Жазғы демалыста да мен Акинемен парфе жеуге бардым.
Dialogue: 0,0:08:33.58,0:08:36.61,Default,,0,0,0,,Кешіріңіз...! Ол сараңдыққа ұмтылатын сияқты.
Dialogue: 0,0:08:36.61,0:08:39.75,Default,,0,0,0,,Бұл жақсы емес пе? Риччан өте мейірімді➡
Dialogue: 0,0:08:39.75,0:08:42.65,Default,,0,0,0,,Ол да маған осындай істерде көмектеседі.
Dialogue: 0,0:08:42.65,0:08:45.39,Default,,0,0,0,,Екеуміз бірге тамақтанып отырдық...
Dialogue: 0,0:08:45.39,0:08:50.59,Default,,0,0,0,,Мейірімді болудан гөрі, өзін жегісі келмей ме?
Dialogue: 0,0:08:50.59,0:08:52.16,Default,,0,0,0,,Мүмкін солай.
Dialogue: 0,0:08:52.16,0:08:55.93,Default,,0,0,0,,Күні кеше мен үйге қайтып бара жатып тамақ сатып алып жатыр едім.
Dialogue: 0,0:08:55.93,0:08:58.83,Default,,0,0,0,,<Мен ақымақпын. ➡
Dialogue: 0,0:08:58.83,0:09:02.34,Default,,0,0,0,,Неге Риччан туралы айтып отырсың...>
Dialogue: 0,0:09:02.34,0:09:07.54,Default,,0,0,0,,Екеуің ұрыспайсыңдар ма? Мен мұны істемеймін... мүмкін?
Dialogue: 0,0:09:07.54,0:09:10.35,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:10.35,0:09:12.88,Default,,0,0,0,,<Мүмкін➡
Dialogue: 0,0:09:12.88,0:09:16.18,Default,,0,0,0,,Менің ойымша, сіз Рикчанның әңгімесін тыңдағыңыз келеді...＞
Dialogue: 0,0:09:18.22,0:09:21.12,Default,,0,0,0,,<Бүгін негативтер жоқ! ＞
Dialogue: 0,0:09:21.12,0:09:25.73,Default,,0,0,0,,Козакура-сан, сен Акинемен жақсы доссың.
Dialogue: 0,0:09:25.73,0:09:30.06,Default,,0,0,0,,Ах... Аоно-кун да Риччанмен жақсы дос...
Dialogue: 0,0:09:30.06,0:09:33.90,Default,,0,0,0,,Мен? Бұл қалыпты жағдай.
Dialogue: 0,0:09:33.90,0:09:35.90,Default,,0,0,0,,Қалыпты….
Dialogue: 0,0:09:37.57,0:09:43.28,Default,,0,0,0,,<Бұл «қалыпты» мен үшін…>
Dialogue: 0,0:09:46.25,0:09:51.39,Default,,0,0,0,,Мен орта мектепте оқып жүргенімде Аоно-кун маған скрипкада ойнауды үйретті...
Dialogue: 0,0:09:51.39,0:09:55.92,Default,,0,0,0,,Ах. Ол кезде мен де оқып, оқытатынмын.
Dialogue: 0,0:09:55.92,0:09:59.59,Default,,0,0,0,,Менің ойымша, бұл оның орнын басады.
Dialogue: 0,0:09:59.59,0:10:03.47,Default,,0,0,0,,Ол маған көп көмектесті.
Dialogue: 0,0:10:03.47,0:10:06.47,Default,,0,0,0,,Түсіндім... Мен дәретханаға барамын.
Dialogue: 0,0:10:06.47,0:10:10.24,Default,,0,0,0,,Ах... иә. Мен де өзіммен бірге қоқысты алып кетемін.
Dialogue: 0,0:10:10.24,0:10:13.54,Default,,0,0,0,,Кешіріңіз! рақмет сізге.
Dialogue: 0,0:10:26.82,0:10:30.43,Default,,0,0,0,,<Шынымен, мен... ➡
Dialogue: 0,0:10:30.43,0:10:33.80,Default,,0,0,0,,Саған зиян тигізетінін білсем де➡
Dialogue: 0,0:10:33.80,0:10:36.83,Default,,0,0,0,,Неге мұндайды сұрайсың...? ➡
Dialogue: 0,0:10:36.83,0:10:41.97,Default,,0,0,0,,Тіпті мен не істегім келетінін білмеймін. ➡
Dialogue: 0,0:10:41.97,0:10:46.44,Default,,0,0,0,,Бұл екеуі мен ойлағаннан да артық➡
Dialogue: 0,0:10:46.44,0:10:50.31,Default,,0,0,0,,Мүмкін орта мектептен бері доспыз... ➡
Dialogue: 0,0:10:50.31,0:10:52.81,Default,,0,0,0,,Өзің кінәлісің.＞
Dialogue: 0,0:10:52.81,0:10:54.82,Default,,0,0,0,,Ахаха, бұл күлкілі.
Dialogue: 0,0:10:56.45,0:11:01.92,Default,,0,0,0,,<Себебі мен ол уақытты лақтырып жібердім... ➡
Dialogue: 0,0:11:01.92,0:11:06.63,Default,,0,0,0,,Сол себепті, тіпті Риччан да...＞
Dialogue: 0,0:11:10.93,0:11:13.97,Default,,0,0,0,,<Бұл мен және Аоно-кун! ➡
Dialogue: 0,0:11:13.97,0:11:18.17,Default,,0,0,0,,Толығырақ... Аоно-кунмен әртүрлі нәрселер туралы сөйлесейік! ＞
Dialogue: 0,0:11:24.41,0:11:26.71,Default,,0,0,0,,Көптен бері көрмегелі!
Dialogue: 0,0:11:31.19,0:11:34.09,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:34.09,0:11:43.80,Default,,0,0,0,,♬～
Dialogue: 0,0:11:45.63,0:11:49.50,Default,,0,0,0,,(Синозаки мен оның достары күледі)
Dialogue: 0,0:11:49.50,0:11:52.31,Default,,0,0,0,,Жоқ. Шынымен ең жақсы.
Dialogue: 0,0:11:52.31,0:11:57.15,Default,,0,0,0,,Бұл шынымен де ерекше. Қараңдар, қараңдар.
Dialogue: 0,0:11:57.15,0:12:01.12,Default,,0,0,0,,Кіші орта мектептің 2 курсынан бері. ДДСҰ? Бұл жігіт.
Dialogue: 0,0:12:01.12,0:12:04.59,Default,,0,0,0,,Сол орта мектепте оқыған бала. Хмм.
Dialogue: 0,0:12:04.59,0:12:08.46,Default,,0,0,0,,<Неге... Синозаки мырза осында...>
Dialogue: 0,0:12:08.46,0:12:12.33,Default,,0,0,0,,Эй, мен көзілдірік тағуды қойдым. ➡
Dialogue: 0,0:12:12.33,0:12:17.27,Default,,0,0,0,,...Дәлірек айтсақ, Козакура-сан жоғалып кеткеннен бері қиын болды. ➡
Dialogue: 0,0:12:17.27,0:12:21.04,Default,,0,0,0,,Олар мектептерді рұқсатсыз ауыстырады.
Dialogue: 0,0:12:21.04,0:12:24.61,Default,,0,0,0,,Мұғалімдерім маған көп сұрақтар қойды...
Dialogue: 0,0:12:24.61,0:12:27.11,Default,,0,0,0,,Бұл өте тітіркендіргіш болды.
Dialogue: 0,0:12:27.11,0:12:30.01,Default,,0,0,0,,Әй, бұл мен бұрын айтқан жігіт.
Dialogue: 0,0:12:30.01,0:12:34.28,Default,,0,0,0,,Басқа мектепке ауысып қашып кетті. Бұл күлкілі. иә. ➡
Dialogue: 0,0:12:34.28,0:12:37.79,Default,,0,0,0,,Ах~ Эй, Козакура-сан, сен де кешкі ас іштің бе? ➡
Dialogue: 0,0:12:37.79,0:12:42.42,Default,,0,0,0,,Біз кешкі ас ішуге жақынбыз.
Dialogue: 0,0:12:42.42,0:12:46.63,Default,,0,0,0,,Козакура мырза! Маған бірдеңе сатып ал. ➡
Dialogue: 0,0:12:46.63,0:12:52.50,Default,,0,0,0,,Өйткені, Козакура-сан бізге көп қиындық әкелді, солай ма?
Dialogue: 0,0:12:52.50,0:12:55.97,Default,,0,0,0,,Бірдеңе сатып алған дұрыс емес пе?
Dialogue: 0,0:12:55.97,0:13:02.74,Default,,0,0,0,,♬～
Dialogue: 0,0:13:02.74,0:13:06.08,Default,,0,0,0,,Оны елемеңіз.
Dialogue: 0,0:13:06.08,0:13:08.58,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:13:08.58,0:13:12.92,Default,,0,0,0,,А? не? Мен оны естімеймін, бірақ.
Dialogue: 0,0:13:12.92,0:13:16.26,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:13:16.26,0:13:20.26,Default,,0,0,0,,♬～
Dialogue: 0,0:13:20.26,0:13:22.60,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:13:22.60,0:13:25.63,Default,,0,0,0,,Жарайды, тез шығарыңыз.
Dialogue: 0,0:13:25.63,0:13:28.64,Default,,0,0,0,,Сөмке осында.
Dialogue: 0,0:13:32.27,0:13:35.28,Default,,0,0,0,,Эй, сен сүйкімді нәрсе пайдаланып жатырсың. ➡
Dialogue: 0,0:13:35.28,0:13:38.15,Default,,0,0,0,,Мен оны біраз уақытқа қарызға аламын. (Синозакидің досы) Эй, не жегің келеді?
Dialogue: 0,0:13:38.15,0:13:41.95,Default,,0,0,0,,Жарайды, менің бай болудан басқа амалым жоқ. (Синозакидің досы) Менің барудан басқа амалым жоқ.
Dialogue: 0,0:13:41.95,0:13:44.15,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:48.12,0:13:50.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:50.43,0:13:52.93,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:14:00.90,0:14:04.57,Default,,0,0,0,,Бұл қылмыс емес пе?
Dialogue: 0,0:14:04.57,0:14:08.91,Default,,0,0,0,,Егер сіз бұл туралы әдеттегідей ойласаңыз, бұл бопсалау. иә?
Dialogue: 0,0:14:08.91,0:14:13.75,Default,,0,0,0,,Мен күзетшіні шақырамын. Кенеттен шыққан мына жігіт не? ?
Dialogue: 0,0:14:13.75,0:14:16.38,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:16.38,0:14:18.32,Default,,0,0,0,,Иә….
Dialogue: 0,0:14:18.32,0:14:22.19,Default,,0,0,0,,Немесе полиция жақсырақ болар еді.
Dialogue: 0,0:14:22.19,0:14:27.03,Default,,0,0,0,,Бірдеңе дұрыс емес пе? не? Қорқынышты...
Dialogue: 0,0:14:27.03,0:14:31.77,Default,,0,0,0,,Жоқ. Мен оны біраз уақытқа ғана қарызға алуға тырыстым.
Dialogue: 0,0:14:31.77,0:14:38.41,Default,,0,0,0,,Дәлірек айтсақ, Аоно-кун атақты адам. Бір орта мектепте оқығанымыз есіңізде ме? ➡
Dialogue: 0,0:14:38.41,0:14:43.11,Default,,0,0,0,,Ах! Әй, бірақ... Орта мектеп туралы естеліктерім онша жақсы емес➡
Dialogue: 0,0:14:43.11,0:14:45.15,Default,,0,0,0,,Есіңе алғың келмей ме?
Dialogue: 0,0:14:45.15,0:14:48.28,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:14:48.28,0:14:50.99,Default,,0,0,0,,Козакура-сан, кеттік.
Dialogue: 0,0:14:52.62,0:14:55.42,Default,,0,0,0,,Хмм, сіз осылай айтып отырсыз... ➡
Dialogue: 0,0:14:55.42,0:14:58.33,Default,,0,0,0,,Қашқандар бір-біріне жабысты. ➡
Dialogue: 0,0:14:58.33,0:15:02.23,Default,,0,0,0,,Бірақ сіз одан аулақ болғаныңыз жөн. ➡
Dialogue: 0,0:15:02.23,0:15:05.23,Default,,0,0,0,,Қатысудың еш жамандығы жоқ.
Dialogue: 0,0:15:05.23,0:15:10.37,Default,,0,0,0,,Козакура-санның кесірінен Акине-сан да мектепке баруды тоқтатты. ➡
Dialogue: 0,0:15:10.37,0:15:14.24,Default,,0,0,0,,Козакура-сан жаңа мектебін тамашалап жатқанда➡
Dialogue: 0,0:15:14.24,0:15:18.58,Default,,0,0,0,,Қызық, Әкине ауырып қалды ма?
Dialogue: 0,0:15:18.58,0:15:23.25,Default,,0,0,0,,Үндеме, неге айтпайсың...
Dialogue: 0,0:15:23.25,0:15:25.92,Default,,0,0,0,,Кешірім сұрау.
Dialogue: 0,0:15:25.92,0:15:30.39,Default,,0,0,0,,Козакура-саннан кешірім сұра.
Dialogue: 0,0:15:30.39,0:15:34.93,Default,,0,0,0,,Ха! ? Алып бара жатқан шығарсың... Сен... Орта мектептен бері➡
Dialogue: 0,0:15:34.93,0:15:38.13,Default,,0,0,0,,Бұл сіздің үнемі істеп жүргеніңіз емес пе?
Dialogue: 0,0:15:41.10,0:15:43.91,Default,,0,0,0,,Дұрыс кешірім сұрау.
Dialogue: 0,0:15:45.61,0:15:47.94,Default,,0,0,0,,Бұл не? Ұрыс?
Dialogue: 0,0:15:47.94,0:15:49.98,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:15:49.98,0:15:53.28,Default,,0,0,0,,Бұл өте жаман, солай емес пе?
Dialogue: 0,0:15:53.28,0:15:56.18,Default,,0,0,0,,Не болды? Бұл қорқынышты.
Dialogue: 0,0:15:56.18,0:16:01.09,Default,,0,0,0,,♬～
Dialogue: 0,0:16:01.09,0:16:03.59,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:16:09.56,0:16:12.37,Default,,0,0,0,,Мен таң қалдым! Бір минут күтіңіз.
Dialogue: 0,0:16:14.07,0:16:16.00,Default,,0,0,0,,Күрсін.
Dialogue: 0,0:16:16.00,0:16:18.91,Default,,0,0,0,,<Мен қатты толқып кеттім... ➡
Dialogue: 0,0:16:18.91,0:16:22.58,Default,,0,0,0,,Өтінемін, біз енді ешқашан кездеспейміз деп үміттенемін...>
Dialogue: 0,0:16:22.58,0:16:25.91,Default,,0,0,0,,Еске бірден Сакума-сенпайдың жүзі түсті➡
Dialogue: 0,0:16:25.91,0:16:29.58,Default,,0,0,0,,Ол адам не айтар еді деп ойланғаннан кейін ➡
Dialogue: 0,0:16:29.58,0:16:32.25,Default,,0,0,0,,Сол сияқты...
Dialogue: 0,0:16:32.25,0:16:36.59,Default,,0,0,0,,Козакура-сан, жарайды! ? Сіз өзіңізді нашар сезініп жатырсыз ба әлде бір нәрсе ме?
Dialogue: 0,0:16:36.59,0:16:40.39,Default,,0,0,0,,Бұл... бұл... бұл....
Dialogue: 0,0:16:40.39,0:16:43.20,Default,,0,0,0,,(Харудың айқайы)
Dialogue: 0,0:16:57.41,0:17:00.88,Default,,0,0,0,,<Мені көрдім... ➡
Dialogue: 0,0:17:00.88,0:17:04.09,Default,,0,0,0,,Ол белгілі болды...＞
Dialogue: 0,0:17:06.55,0:17:09.89,Default,,0,0,0,,<Әлсіз және ештеңе істей алмайды➡
Dialogue: 0,0:17:09.89,0:17:13.36,Default,,0,0,0,,Мен қандай аяныштымын... ➡
Dialogue: 0,0:17:13.36,0:17:18.57,Default,,0,0,0,,Жүрегімнің бір жерінде үнемі мазасызданатынмын...>
Dialogue: 0,0:17:20.23,0:17:26.94,Default,,0,0,0,,<Мен бір күні өткен өмірім белгілі болады деп қорқамын...>
Dialogue: 0,0:17:28.94,0:17:32.25,Default,,0,0,0,,<Нағыз мен - бұл...>
Dialogue: 0,0:17:32.25,0:17:35.75,Default,,0,0,0,,♬～
Dialogue: 0,0:17:35.75,0:17:40.09,Default,,0,0,0,,Ал... бұрын болған оқиға туралы... ➡
Dialogue: 0,0:17:40.09,0:17:43.96,Default,,0,0,0,,Мен... орта мектепте оқып жүрген кезімде➡
Dialogue: 0,0:17:43.96,0:17:48.80,Default,,0,0,0,,Мектепке бара алмай қалған кезім болды. ➡
Dialogue: 0,0:17:48.80,0:17:52.67,Default,,0,0,0,,Басында... Адамдар мен туралы жаман сөздер айтты➡
Dialogue: 0,0:17:52.67,0:17:57.51,Default,,0,0,0,,Жүріп келе жатқанымда артымнан біреу итеріп жібергенін сездім... ➡
Dialogue: 0,0:17:57.51,0:18:03.51,Default,,0,0,0,,Бірақ мен ештеңе айтуға қорықтым...
Dialogue: 0,0:18:06.55,0:18:11.42,Default,,0,0,0,,бұл... бұл бәрі емес. ➡
Dialogue: 0,0:18:11.42,0:18:16.89,Default,,0,0,0,,Мектепке баруды тоқтатқаныма жарты жылдай уақыт өтті...
Dialogue: 0,0:18:16.89,0:18:19.23,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:18:19.23,0:18:23.06,Default,,0,0,0,,Анам жылап тұрды... ➡
Dialogue: 0,0:18:23.06,0:18:26.57,Default,,0,0,0,,Жұмысымды тастап...басқа мектепке ауысу➡
Dialogue: 0,0:18:26.57,0:18:29.24,Default,,0,0,0,,Ол тіпті маған қозғалуға көмектесті.
Dialogue: 0,0:18:29.24,0:18:33.74,Default,,0,0,0,,Бұл жай ғана аналар емес...! Бұл Риччан...!
Dialogue: 0,0:18:35.38,0:18:38.08,Default,,0,0,0,,Риччан.
Dialogue: 0,0:18:38.08,0:18:41.75,Default,,0,0,0,,Бүгінгі сабаққа ескертулер! рақмет сізге!
Dialogue: 0,0:18:41.75,0:18:45.25,Default,,0,0,0,,Мен ұйықтап қалып, кейбір жерлерін өткізіп алдым.
Dialogue: 0,0:18:45.25,0:18:50.76,Default,,0,0,0,,Сұрақтарыңыз болса, маған хабарласыңыз. Олай болса, өзіңе қамқор бол.
Dialogue: 0,0:18:50.76,0:18:53.39,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:18:53.39,0:18:56.26,Default,,0,0,0,,Себебі сен мені қорғадың➡
Dialogue: 0,0:18:56.26,0:18:59.93,Default,,0,0,0,,Сабақта қандай жұмыстар атқарылды...! ➡
Dialogue: 0,0:18:59.93,0:19:02.84,Default,,0,0,0,,Байқасам да...➡
Dialogue: 0,0:19:02.84,0:19:07.68,Default,,0,0,0,,Мен... ештеңе істей алмадым...!
Dialogue: 0,0:19:07.68,0:19:12.58,Default,,0,0,0,,Бұл нағыз мен...
Dialogue: 0,0:19:12.58,0:19:19.29,Default,,0,0,0,,Мен...! үшінның өмірін құрттым... ➡
Dialogue: 0,0:19:19.29,0:19:25.73,Default,,0,0,0,,Мен өзгергім келді... Бірақ нәтиже болмады... ➡
Dialogue: 0,0:19:25.73,0:19:29.53,Default,,0,0,0,,Егер мен жоқ болсам...
Dialogue: 0,0:19:31.23,0:19:34.74,Default,,0,0,0,,Әрине, олай емес!
Dialogue: 0,0:19:34.74,0:19:39.57,Default,,0,0,0,,Мен... Мен Козакура-санды орта мектептен білмедім...
Dialogue: 0,0:19:39.57,0:19:43.74,Default,,0,0,0,,Мен қазіргі Козакура-санды мектеп табалдырығын аттағалы бері ғана білемін.
Dialogue: 0,0:19:43.74,0:19:49.38,Default,,0,0,0,,Бірақ мен...! Меніңше қазіргі Козакура-сан жалған емес!
Dialogue: 0,0:19:49.38,0:19:55.19,Default,,0,0,0,,♬～
Dialogue: 0,0:19:55.19,0:19:59.06,Default,,0,0,0,,Өткеннен жаман естеліктер ➡ болатыны рас
Dialogue: 0,0:19:59.06,0:20:02.26,Default,,0,0,0,,Менің ойымша, бұл кетпейді ...
Dialogue: 0,0:20:02.26,0:20:07.10,Default,,0,0,0,,Қозакура мырзадай болмаса да... Мен де, орта мектепте оқып жүрген кезімде➡
Dialogue: 0,0:20:07.10,0:20:11.94,Default,,0,0,0,,Әкем туралы күнде эфирге шығатын жаңалықтар мені уайымдайтындықтан...
Dialogue: 0,0:20:11.94,0:20:17.81,Default,,0,0,0,,♬～
Dialogue: 0,0:20:17.81,0:20:21.28,Default,,0,0,0,,Козакура-сан мейірімді.
Dialogue: 0,0:20:21.28,0:20:24.29,Default,,0,0,0,,үшін шулы сөйлесіп жатқанда➡
Dialogue: 0,0:20:24.29,0:20:27.62,Default,,0,0,0,,Үндемейтін жалғыз адам болса, оны әңгімеге қоспаңыз➡
Dialogue: 0,0:20:27.62,0:20:31.49,Default,,0,0,0,,Козакура мырза, сіз ол кісімен жай сөйлесесіз.
Dialogue: 0,0:20:31.49,0:20:35.70,Default,,0,0,0,,Мен сізді әрқашан зейін қоюға шебер деп ойладым.
Dialogue: 0,0:20:37.30,0:20:41.80,Default,,0,0,0,,Сондай-ақ, музыкалық аспаптар қоймасында сақталған үлкен көлемдегі ноталар➡
Dialogue: 0,0:20:41.80,0:20:46.51,Default,,0,0,0,,Тізімді композитордың аты-жөніне қарай реттеген Қозакура мырза емес пе?
Dialogue: 0,0:20:48.58,0:20:52.51,Default,,0,0,0,,Тамақты көп жеп тұншығып отырған Ақинеге орамал ұсынады.
Dialogue: 0,0:20:52.51,0:20:55.98,Default,,0,0,0,,Біреу жабуды ұмытып кеткен есікті жабу сияқты.
Dialogue: 0,0:20:55.98,0:21:00.39,Default,,0,0,0,,Бұл мен білетін Козакура-сан.
Dialogue: 0,0:21:00.39,0:21:04.93,Default,,0,0,0,,«Бұл өте кішкентай нәрсе» деп ойлауыңыз мүмкін, бірақ…➡
Dialogue: 0,0:21:04.93,0:21:09.26,Default,,0,0,0,,Бірақ...адамның ``мінезі'' күтпеген жерден солай болады➡
Dialogue: 0,0:21:09.26,0:21:12.77,Default,,0,0,0,,Менің ойымша, бұл орын алуы мүмкін.
Dialogue: 0,0:21:12.77,0:21:16.40,Default,,0,0,0,,Сонымен... қазіргі Козакура-сан бұл➡
Dialogue: 0,0:21:16.40,0:21:19.77,Default,,0,0,0,,Менің ойымша, сен нағыз Козакура-сансың.
Dialogue: 0,0:21:19.77,0:21:26.28,Default,,0,0,0,,♬～
Dialogue: 0,0:21:31.29,0:21:34.96,Default,,0,0,0,,<Мен асыға күткен күн болса да...>
Dialogue: 0,0:21:34.96,0:21:36.89,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:21:36.89,0:21:39.89,Default,,0,0,0,,<Мен мұны Аоно-кунның алдында жасадым...>
Dialogue: 0,0:21:47.13,0:21:51.97,Default,,0,0,0,,<Жоқ, бірақ...! Өткенді айтайық➡
Dialogue: 0,0:21:51.97,0:21:56.81,Default,,0,0,0,,Бұл жақсы мүмкіндік болды ма...? Теріс болмаңыз! ➡
Dialogue: 0,0:21:56.81,0:22:03.32,Default,,0,0,0,,Аоно-кун айтқандай, мен қазір кім екенімді өзгертуім керек! ＞
Dialogue: 0,0:22:06.92,0:22:09.39,Default,,0,0,0,,📱 (Хабар рингтоны)
Dialogue: 0,0:22:09.39,0:22:12.26,Default,,0,0,0,,<Мачий Сенпай…>
Dialogue: 0,0:22:12.26,0:22:21.94,Default,,0,0,0,,♬～
Dialogue: 0,0:22:21.94,0:22:23.87,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:22:23.87,0:22:34.52,Default,,0,0,0,,♬～
Dialogue: 0,0:22:34.52,0:22:53.43,Default,,0,0,0,,♬～
Dialogue: 0,0:22:53.43,0:22:55.94,Default,,0,0,0,,Барысы….
Dialogue: 0,0:23:01.91,0:23:05.38,Default,,0,0,0,,Ах...➡
Dialogue: 0,0:23:05.38,0:23:08.88,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,0:23:10.75,0:23:19.09,Default,,0,0,0,,♬～
Dialogue: 0,0:23:19.09,0:23:22.96,Default,,0,0,0,,♬ «Мен оны сенен алдым».
Dialogue: 0,0:23:22.96,0:23:28.80,Default,,0,0,0,,♬ «Сәйкес келетін үш жиілік кілтті салпыншақ»
Dialogue: 0,0:23:28.80,0:23:34.64,Default,,0,0,0,,♬ «Мен оны жоғалтып алдым, сені енді көре алмаймын».
Dialogue: 0,0:23:34.64,0:23:38.41,Default,,0,0,0,,♬ «Жапырақтар арқылы сүзгіленген таңғажайып күн сәулесі»
Dialogue: 0,0:23:38.41,0:23:42.28,Default,,0,0,0,,♬ «Мен ешқашан орала алмаймын»
Dialogue: 0,0:23:42.28,0:23:49.42,Default,,0,0,0,,♬ "Мен өткенді жек көремін. Метроном, тоқтама."
Dialogue: 0,0:23:49.42,0:23:56.13,Default,,0,0,0,,♬ «Маған уақыт машинасы қажет емес».
Dialogue: 0,0:23:56.13,0:24:03.87,Default,,0,0,0,,♬ «Бірақ, мен сені сол кезде кездестірсем.»
Dialogue: 0,0:24:03.87,0:24:13.25,Default,,0,0,0,,♬ «Жарайды, жақсы, жұлдыздардың сиқыры сізді орап алады»
Dialogue: 0,0:24:13.25,0:24:19.39,Default,,0,0,0,,♬ «Мен саған жарық болғым келеді».
Dialogue: 0,0:24:19.39,0:24:28.40,Default,,0,0,0,,♬ «Жарайды, жарайды, өтінемін, уақыттың сиқыры».
Dialogue: 0,0:24:28.40,0:24:36.10,Default,,0,0,0,,♬ «Мен сенімен мәңгі бірге болғым келеді».
Dialogue: 0,0:24:37.60,0:24:43.60,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
