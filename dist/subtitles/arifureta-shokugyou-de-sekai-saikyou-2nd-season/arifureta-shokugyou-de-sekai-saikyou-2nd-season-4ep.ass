Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:04.04,Default,,0,0,0,,(Қара айдаһардың ыңырануы)
Dialogue: 0,0:00:13.51,0:00:15.55,Default,,0,0,0,,Иә (Солдат) Тезірек!
Dialogue: 0,0:00:16.76,0:00:18.97,Default,,0,0,0,,(Қара айдаһардың ыңырануы)
Dialogue: 0,0:00:21.31,0:00:22.56,Default,,0,0,0,,Уф
Dialogue: 0,0:00:22.64,0:00:24.14,Default,,0,0,0,,Сақтанбаңыз (Солдат) Ах.
Dialogue: 0,0:00:29.19,0:00:30.86,Default,,0,0,0,,Әй... әйел?
Dialogue: 0,0:00:30.94,0:00:32.78,Default,,0,0,0,,Айдаһар емес пе?
Dialogue: 0,0:00:32.86,0:00:36.36,Default,,0,0,0,,Тио! Сенімен бәрі жақсы ма?
Dialogue: 0,0:00:36.45,0:00:38.16,Default,,0,0,0,,Тио!
Dialogue: 0,0:00:38.24,0:00:39.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:40.87,0:00:42.04,Default,,0,0,0,,Каори?
Dialogue: 0,0:00:43.08,0:00:45.58,Default,,0,0,0,,Хмм, бәрі жақсы.
Dialogue: 0,0:00:45.67,0:00:47.29,Default,,0,0,0,,Мен аздап шаршадым.
Dialogue: 0,0:00:50.96,0:00:53.26,Default,,0,0,0,,Тио Хаджиме, балалар ше?
Dialogue: 0,0:00:53.34,0:00:55.93,Default,,0,0,0,,Сіз жалғызсыз ба? Неліктен?
Dialogue: 0,0:00:56.55,0:00:58.34,Default,,0,0,0,,Сабыр ет, Каори.
Dialogue: 0,0:00:58.43,0:01:00.68,Default,,0,0,0,,Жанартау атқылауы туралы не деуге болады?
Dialogue: 0,0:01:01.97,0:01:06.98,Default,,0,0,0,,♪～
Dialogue: 0,0:02:26.27,0:02:31.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:37.99,0:02:40.20,Default,,0,0,0,,Олай болса, Хаджиме екеуің...
Dialogue: 0,0:02:40.28,0:02:44.53,Default,,0,0,0,,Хмм, олардың сенен кейін келетініне сенімдімін.
Dialogue: 0,0:02:44.62,0:02:47.79,Default,,0,0,0,,Ұстаз аз да болса берілмеді.
Dialogue: 0,0:02:48.45,0:02:51.08,Default,,0,0,0,,Мен одан шығудың жолы болғанына сенімдімін.
Dialogue: 0,0:02:52.71,0:02:55.80,Default,,0,0,0,,Каори, бұл сіздің қожайыныңыздан келген хабарлама.
Dialogue: 0,0:02:55.88,0:02:58.30,Default,,0,0,0,,А, Хаджиме-куннан?
Dialogue: 0,0:02:58.38,0:03:02.26,Default,,0,0,0,,Хмм, дәлірек айтсақ, Каори мен Мюдің картоптары бар.
Dialogue: 0,0:03:02.89,0:03:04.97,Default,,0,0,0,,«Кейін кездескенше»
Dialogue: 0,0:03:06.76,0:03:07.60,Default,,0,0,0,,Каори?
Dialogue: 0,0:03:07.68,0:03:12.23,Default,,0,0,0,,А, иә, онда бәрі жақсы.
Dialogue: 0,0:03:12.31,0:03:15.94,Default,,0,0,0,,Жағдай сырттан үмітсіз болып көрінсе де
Dialogue: 0,0:03:16.02,0:03:19.24,Default,,0,0,0,,Менің қожайыным болсаң, тірі қайтатын шығарсың.
Dialogue: 0,0:03:20.11,0:03:22.70,Default,,0,0,0,,Бұған сөзсіз сенуге болады.
Dialogue: 0,0:03:22.78,0:03:23.99,Default,,0,0,0,,Иә
Dialogue: 0,0:03:24.66,0:03:27.24,Default,,0,0,0,,Әкеңді алып кетпейсің бе?
Dialogue: 0,0:03:27.33,0:03:29.45,Default,,0,0,0,,Хаджиме папаға сеніңіз
Dialogue: 0,0:03:29.54,0:03:32.58,Default,,0,0,0,,Ең алдымен өзімізге қажет нәрсені жасайық.
Dialogue: 0,0:03:32.67,0:03:35.21,Default,,0,0,0,,Осыдан кейін мен сені алып кетемін.
Dialogue: 0,0:03:35.29,0:03:37.46,Default,,0,0,0,,Ах, бірақ Мюу-чан
Dialogue: 0,0:03:37.55,0:03:40.76,Default,,0,0,0,,Мен сені Грюен жанартауына апара алмаймын.
Dialogue: 0,0:03:40.84,0:03:43.68,Default,,0,0,0,,Содан кейін алдымен Элизенге барыңыз.
Dialogue: 0,0:03:43.76,0:03:46.01,Default,,0,0,0,,Мюды анасымен кездестіруге қалай болады?
Dialogue: 0,0:03:46.10,0:03:49.02,Default,,0,0,0,,Иә, шешілді.
Dialogue: 0,0:03:49.10,0:03:50.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:07.58,0:04:08.91,Default,,0,0,0,,Фу
Dialogue: 0,0:04:09.79,0:04:10.58,Default,,0,0,0,,Содан бері неше күн өтті?
Dialogue: 0,0:04:10.58,0:04:12.58,Default,,0,0,0,,Содан бері неше күн өтті?
Dialogue: 0,0:04:10.58,0:04:12.58,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:04:12.58,0:04:13.92,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:04:14.00,0:04:16.58,Default,,0,0,0,,Хаджиме, көңіл-күйің қалай?
Dialogue: 0,0:04:16.67,0:04:18.42,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:04:18.50,0:04:21.09,Default,,0,0,0,,Оның толық жазылуы үшін әлі біраз уақыт қажет сияқты.
Dialogue: 0,0:04:21.88,0:04:23.09,Default,,0,0,0,,Юэ ше?
Dialogue: 0,0:04:23.17,0:04:27.35,Default,,0,0,0,,Еш уайымдама, менімен қанымды бөлісу үшін Шиа алдым.
Dialogue: 0,0:04:28.51,0:04:31.39,Default,,0,0,0,,Юэ-сан, сен неге мініп жүрсің?
Dialogue: 0,0:04:31.47,0:04:33.56,Default,,0,0,0,,Өйткені Хаджиме сонда
Dialogue: 0,0:04:36.48,0:04:40.27,Default,,0,0,0,,Аврорадағы токсиндердің көпшілігі жойылды. Бәрі жақсы сияқты.
Dialogue: 0,0:04:40.36,0:04:41.99,Default,,0,0,0,,Мен проблема жоқ дедім бе?
Dialogue: 0,0:04:42.61,0:04:45.45,Default,,0,0,0,,Бірақ өзіңізді уайымдаған нәрсе туралы уайымдаңыз
Dialogue: 0,0:04:45.53,0:04:49.45,Default,,0,0,0,,Орналасу қиын, бірақ мен біраз демалуға қуаныштымын.
Dialogue: 0,0:04:49.53,0:04:53.66,Default,,0,0,0,,Бұл ашулы оқиға болды.
Dialogue: 0,0:04:53.75,0:04:56.08,Default,,0,0,0,,Сіз бақыттысыз ба, әлде сәтсіз бе...
Dialogue: 0,0:05:10.72,0:05:13.18,Default,,0,0,0,,Хаджиме-сан, сол жерде.
Dialogue: 0,0:05:20.48,0:05:21.44,Default,,0,0,0,,Ах
Dialogue: 0,0:05:24.03,0:05:25.53,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:34.58,0:05:35.54,Default,,0,0,0,,Уф
Dialogue: 0,0:05:38.67,0:05:41.04,Default,,0,0,0,,Әзірге қауіпсіз.
Dialogue: 0,0:05:41.13,0:05:44.05,Default,,0,0,0,,Хаджиме?
Dialogue: 0,0:05:45.47,0:05:47.01,Default,,0,0,0,,Бұл сиқырлы шеңбер.
Dialogue: 0,0:05:56.27,0:05:59.56,Default,,0,0,0,,Бұл ғарыштық манипуляцияның сиқыры ма?
Dialogue: 0,0:05:59.65,0:06:01.31,Default,,0,0,0,,Телепортация тұқымы
Dialogue: 0,0:06:01.40,0:06:04.94,Default,,0,0,0,,Артыңнан кенет пайда болған сол.
Dialogue: 0,0:06:08.40,0:06:09.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:12.53,0:06:13.91,Default,,0,0,0,,«Халық болашағы»
Dialogue: 0,0:06:13.99,0:06:17.83,Default,,0,0,0,,«Сіздің ерік-жігеріңізден босататыныңызға шын жүректен үміттенемін».
Dialogue: 0,0:06:18.50,0:06:20.04,Default,,0,0,0,,«Ныс Груен»
Dialogue: 0,0:06:21.79,0:06:23.50,Default,,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:06:23.59,0:06:26.09,Default,,0,0,0,,Ол өз істерін жинаған сияқты.
Dialogue: 0,0:06:26.17,0:06:30.22,Default,,0,0,0,,Найыз мырза сиқырдан басқа ештеңе қалдырмаған сияқты.
Dialogue: 0,0:06:42.52,0:06:46.57,Default,,0,0,0,,Ал, мен жеңіс пен сиқырдың дәлелін алдым.
Dialogue: 0,0:06:46.65,0:06:48.44,Default,,0,0,0,,Келесі қадам - ​​қашу.
Dialogue: 0,0:06:48.53,0:06:54.20,Default,,0,0,0,,Бірақ ғарыштық сиқырды пайдалану қиын және оны бірден пайдалану мүмкін емес.
Dialogue: 0,0:06:54.28,0:06:56.70,Default,,0,0,0,,Сізде бір нәрсе бар, солай ма?
Dialogue: 0,0:06:56.79,0:07:01.46,Default,,0,0,0,,Мүмкін сырты толығымен магмаға толған шығар?
Dialogue: 0,0:07:01.54,0:07:03.71,Default,,0,0,0,,Магма арқылы жүзу
Dialogue: 0,0:07:03.79,0:07:05.29,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:07:09.09,0:07:12.22,Default,,0,0,0,,Өтінемін, маған олай қарама.
Dialogue: 0,0:07:19.64,0:07:23.19,Default,,0,0,0,,Негізі біз су асты кемесін дайындадық.
Dialogue: 0,0:07:23.27,0:07:27.57,Default,,0,0,0,,Мен оны келесі Мелузин теңіз асты қирандыларында міндетті түрде қажет деп ойладым.
Dialogue: 0,0:07:27.65,0:07:29.44,Default,,0,0,0,,Мен оны алдын ала жасадым.
Dialogue: 0,0:07:29.53,0:07:32.20,Default,,0,0,0,,Ол шынымен магмада өмір сүре ала ма?
Dialogue: 0,0:07:32.28,0:07:34.57,Default,,0,0,0,,Мен біраз уайымдадым.
Dialogue: 0,0:07:53.93,0:07:56.85,Default,,0,0,0,,Жақсы сияқты.
Dialogue: 0,0:08:02.89,0:08:04.85,Default,,0,0,0,,Қалай? Не болып жатыр?
Dialogue: 0,0:08:04.94,0:08:07.69,Default,,0,0,0,,Шүкір, мен рульді басқара алмаймын.
Dialogue: 0,0:08:07.77,0:08:11.86,Default,,0,0,0,,Егер бұл атқылау болса, мені сыртқа лақтыру бақыты бұйырар еді.
Dialogue: 0,0:08:14.45,0:08:19.20,Default,,0,0,0,,Жарайды... түзу төмен, жоқ, қиғаш төмен сыпырылып жатқан сияқты.
Dialogue: 0,0:08:19.29,0:08:23.25,Default,,0,0,0,,Сонымен... бұл жер астында дегенді білдіре ме?
Dialogue: 0,0:08:24.75,0:08:27.42,Default,,0,0,0,,Юэ Ся Мен жақында орала алмаймын деп ойлаймын.
Dialogue: 0,0:08:27.50,0:08:30.50,Default,,0,0,0,,Қолымыздан келгенше алысқа барудан басқа амалымыз жоқ сияқты.
Dialogue: 0,0:08:32.22,0:08:36.47,Default,,0,0,0,,Мен соңына дейін жаныңда боламын. Егер бұл орындалса, онда ештеңе жоқ.
Dialogue: 0,0:08:36.55,0:08:40.18,Default,,0,0,0,,Сөзбе-сөз айтқанда, отта болса да, суда.
Dialogue: 0,0:08:40.26,0:08:44.64,Default,,0,0,0,,Мен де екеуіңнің қасында болғанша кез келген жерге барар едім.
Dialogue: 0,0:08:58.95,0:09:00.99,Default,,0,0,0,,Охххх (Юэ Ся) Охххх~
Dialogue: 0,0:09:16.09,0:09:17.47,Default,,0,0,0,,Шүкір, менің оқтарым бітті!
Dialogue: 0,0:09:18.39,0:09:19.22,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:09:31.11,0:09:32.86,Default,,0,0,0,,Иә, менің қаным...
Dialogue: 0,0:09:33.61,0:09:35.40,Default,,0,0,0,,Жақсы, әлі емес...
Dialogue: 0,0:09:35.49,0:09:36.36,Default,,0,0,0,,Юе…
Dialogue: 0,0:09:36.45,0:09:39.41,Default,,0,0,0,,Екеуің де біреуді ұмыттыңдар ма?
Dialogue: 0,0:09:40.99,0:09:43.45,Default,,0,0,0,,Менің қанымды да қолданыңыз.
Dialogue: 0,0:09:55.05,0:09:56.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:03.10,0:10:04.06,Default,,0,0,0,,Шииттер ше?
Dialogue: 0,0:10:04.14,0:10:06.68,Default,,0,0,0,,Өйткені мен сенімен көп қанымды бөлістім.
Dialogue: 0,0:10:06.77,0:10:09.15,Default,,0,0,0,,Ол біраз уақытқа дейін оянады деп ойламаймын.
Dialogue: 0,0:10:09.23,0:10:10.31,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:12.19,0:10:14.03,Default,,0,0,0,,Ммммм~
Dialogue: 0,0:10:14.11,0:10:18.15,Default,,0,0,0,,Иә? Сіз ояндыңыз ба? Өзіңізді қалай сезінесіз?
Dialogue: 0,0:10:18.24,0:10:21.32,Default,,0,0,0,,Ештеңе болмағандай табиғи алаңдаушылық
Dialogue: 0,0:10:21.41,0:10:22.95,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:23.03,0:10:26.54,Default,,0,0,0,,Мен өте жақсы жұмыс істеп жатырмын. Иә, солай!
Dialogue: 0,0:10:26.62,0:10:28.50,Default,,0,0,0,,Біріншінің естеліктері… Сен оларды көрдің бе?
Dialogue: 0,0:10:29.12,0:10:32.54,Default,,0,0,0,,Бұл жер дәл қай жерде?
Dialogue: 0,0:10:32.63,0:10:36.59,Default,,0,0,0,,Мен біраз зерттеу жүргізгім келеді.
Dialogue: 0,0:10:36.67,0:10:40.05,Default,,0,0,0,,Қазына бөлмесі Тиоға сеніп тапсырылған, сондықтан мен оған көмектесе алмаймын...
Dialogue: 0,0:10:41.14,0:10:42.68,Default,,0,0,0,,Сол қалпында саяхаттаңыз
Dialogue: 0,0:10:42.76,0:10:45.26,Default,,0,0,0,,Бұл кеме апаты деп аталады емес пе?
Dialogue: 0,0:10:46.22,0:10:47.73,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:10:52.27,0:10:55.02,Default,,0,0,0,,Сіз кімсіз? неге мұндасың?
Dialogue: 0,0:10:55.11,0:10:56.48,Default,,0,0,0,,Бұл не мініп бара жатыр?
Dialogue: 0,0:10:56.57,0:10:58.57,Default,,0,0,0,,Нггунггуннн!
Dialogue: 0,0:10:58.65,0:10:59.49,Default,,0,0,0,,Құт
Dialogue: 0,0:10:59.57,0:11:02.07,Default,,0,0,0,,Мен сенің сақтығыңды түсіруге тырыссам да, ол жұмыс істемейді.
Dialogue: 0,0:11:02.16,0:11:04.70,Default,,0,0,0,,Ол баланы да солай ұрлап алдың ба?
Dialogue: 0,0:11:02.16,0:11:04.70,Default,,0,0,0,,Нгг...
Dialogue: 0,0:11:04.70,0:11:04.78,Default,,0,0,0,,Нгг...
Dialogue: 0,0:11:04.78,0:11:05.37,Default,,0,0,0,,Нгг...
Dialogue: 0,0:11:04.78,0:11:05.37,Default,,0,0,0,,Баламызды тағы ұрлауға келдің бе?
Dialogue: 0,0:11:05.37,0:11:05.45,Default,,0,0,0,,Баламызды тағы ұрлауға келдің бе?
Dialogue: 0,0:11:05.45,0:11:07.41,Default,,0,0,0,,Баламызды тағы ұрлауға келдің бе?
Dialogue: 0,0:11:05.45,0:11:07.41,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:11:07.50,0:11:10.79,Default,,0,0,0,,Аа~ Мүмкін сен Мюу дегенің бар шығар?
Dialogue: 0,0:11:10.87,0:11:12.88,Default,,0,0,0,,А, онда біз...
Dialogue: 0,0:11:12.96,0:11:16.92,Default,,0,0,0,,Аузыңды жап! Қоян жарысқандай аузыңды ашпа!
Dialogue: 0,0:11:17.84,0:11:19.22,Default,,0,0,0,,Ах
Dialogue: 0,0:11:19.92,0:11:22.09,Default,,0,0,0,,Ах га ах ах
Dialogue: 0,0:11:22.18,0:11:24.10,Default,,0,0,0,,Керемет кадр
Dialogue: 0,0:11:25.14,0:11:27.31,Default,,0,0,0,,Иә? Қазір бірдеңе...
Dialogue: 0,0:11:27.39,0:11:28.31,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:28.39,0:11:31.06,Default,,0,0,0,,Папа! Не?
Dialogue: 0,0:11:31.14,0:11:32.94,Default,,0,0,0,,Ха, мүмкін емес.
Dialogue: 0,0:11:33.02,0:11:35.48,Default,,0,0,0,,Папа!
Dialogue: 0,0:11:36.98,0:11:37.98,Default,,0,0,0,,Мен?
Dialogue: 0,0:11:54.75,0:11:56.54,Default,,0,0,0,,Папа!
Dialogue: 0,0:11:58.13,0:11:59.38,Default,,0,0,0,,Мью
Dialogue: 0,0:12:06.30,0:12:09.43,Default,,0,0,0,,(Мюудың жылағаны)
Dialogue: 0,0:12:09.52,0:12:12.77,Default,,0,0,0,,Әке, кешіріңіз.
Dialogue: 0,0:12:12.85,0:12:16.65,Default,,0,0,0,,Сен маған енді ондай қауіпті ештеңе жасамайсың деп уәде бере аласың ба?
Dialogue: 0,0:12:16.73,0:12:17.98,Default,,0,0,0,,Иә
Dialogue: 0,0:12:18.07,0:12:20.19,Default,,0,0,0,,Жақсы болса, жарайды.
Dialogue: 0,0:12:20.28,0:12:21.53,Default,,0,0,0,,Папа~
Dialogue: 0,0:12:23.78,0:12:27.49,Default,,0,0,0,,Жақсы, шынымен жақсы~
Dialogue: 0,0:12:27.58,0:12:30.20,Default,,0,0,0,,Сені уайымдағаныма мен кінәлімін.
Dialogue: 0,0:12:30.29,0:12:33.12,Default,,0,0,0,,Көріп отырғаныңыздай, бұл түйреуіш, сондықтан...
Dialogue: 0,0:12:33.21,0:12:35.50,Default,,0,0,0,,Сондықтан жылама
Dialogue: 0,0:12:35.58,0:12:38.63,Default,,0,0,0,,Каоридің жылауы – көп қиындық.
Dialogue: 0,0:12:38.71,0:12:42.01,Default,,0,0,0,,Уф, сонда... сонда
Dialogue: 0,0:12:44.34,0:12:47.26,Default,,0,0,0,,Осылай біраз уақыт қалдырыңыз
Dialogue: 0,0:12:49.60,0:12:51.06,Default,,0,0,0,,Иә? Нуоо
Dialogue: 0,0:12:51.14,0:12:53.27,Default,,0,0,0,,О... сәлем Тио
Dialogue: 0,0:12:53.35,0:12:57.48,Default,,0,0,0,,Мен сендім. Мен сендім.
Dialogue: 0,0:12:57.56,0:13:00.07,Default,,0,0,0,,Осылай қайта кездескенде...
Dialogue: 0,0:13:01.11,0:13:05.07,Default,,0,0,0,,Маған біраз уақыт беріңізші, ұстаз.
Dialogue: 0,0:13:05.15,0:13:08.78,Default,,0,0,0,,Қараңыз~ Ұстаз, маған сыйлық беріңіз.
Dialogue: 0,0:13:33.64,0:13:35.68,Default,,0,0,0,,Эй, анау қыз...
Dialogue: 0,0:13:35.77,0:13:39.73,Default,,0,0,0,,А, иә, мен сенімдімін. Бұл Ремияның ұрланған баласы.
Dialogue: 0,0:13:43.82,0:13:47.07,Default,,0,0,0,,Гильдия филиалының менеджерінің сұрауының аяқталуын мақұлдаңыз
Dialogue: 0,0:13:47.78,0:13:50.87,Default,,0,0,0,,Алтын дәрежелі авантюрист Нагумо-доно
Dialogue: 0,0:13:50.95,0:13:53.62,Default,,0,0,0,,Сіз әртүрлі сұрақтар қойғыңыз келуі мүмкін.
Dialogue: 0,0:13:53.70,0:13:57.96,Default,,0,0,0,,Әзірше мен бұл баланың анасымен кездескенін қалаймын, жарай ма?
Dialogue: 0,0:13:58.04,0:13:59.96,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:14:00.04,0:14:04.30,Default,,0,0,0,,Теңізде айдаһар мен кемеге ұқсайтын нәрсе көрінді.
Dialogue: 0,0:14:04.38,0:14:07.22,Default,,0,0,0,,Патшалықтың солдаты ретінде мен бұған назар аудара алмаймын.
Dialogue: 0,0:14:07.30,0:14:10.51,Default,,0,0,0,,Мен Элисенде біраз тұруды жоспарлап отырмын.
Dialogue: 0,0:14:10.59,0:14:13.22,Default,,0,0,0,,Уақытым болса сенімен сөйлессем жарай ма?
Dialogue: 0,0:14:13.31,0:14:16.10,Default,,0,0,0,,Сөйлесуге мүмкіндік болса, жақсы.
Dialogue: 0,0:14:16.18,0:14:18.81,Default,,0,0,0,,Мен тынышталған соң тағы сұраймын.
Dialogue: 0,0:14:18.89,0:14:20.35,Default,,0,0,0,,Әңгіменің соңы
Dialogue: 0,0:14:20.44,0:14:22.23,Default,,0,0,0,,Осы жерде мәңгі қалсаң
Dialogue: 0,0:14:22.31,0:14:25.82,Default,,0,0,0,,Мен сізді патша солдатына қарсы қызметтік міндеттеріңізге кедергі келтіргеніңіз үшін тұтқынға аламын.
Dialogue: 0,0:14:27.40,0:14:31.03,Default,,0,0,0,,Әке, үйге бар, ана сені күтіп отыр.
Dialogue: 0,0:14:31.12,0:14:32.78,Default,,0,0,0,,Мен анамды көргім келеді
Dialogue: 0,0:14:32.87,0:14:35.49,Default,,0,0,0,,Дұрыс, тезірек барып көрейік.
Dialogue: 0,0:14:35.58,0:14:37.54,Default,,0,0,0,,Ей, ойнайық
Dialogue: 0,0:14:40.58,0:14:42.75,Default,,0,0,0,,Әке міне, міне
Dialogue: 0,0:14:42.84,0:14:44.00,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:14:44.09,0:14:45.63,Default,,0,0,0,,Асығыңыз~
Dialogue: 0,0:14:48.67,0:14:51.55,Default,,0,0,0,,Ремия, сабыр ет, сен ол аяқпен істей алмайсың.
Dialogue: 0,0:14:51.64,0:14:53.10,Default,,0,0,0,,Дұрыс, Ремиа-чан.
Dialogue: 0,0:14:53.18,0:14:54.89,Default,,0,0,0,,Егер бұл Мю Чан болса, мен оны міндетті түрде алып кетемін.
Dialogue: 0,0:14:54.97,0:14:58.14,Default,,0,0,0,,Жоқ, Мюу қайтып келді, солай ма?
Dialogue: 0,0:14:58.23,0:15:00.02,Default,,0,0,0,,Мен сені алып кетуім керек!
Dialogue: 0,0:15:00.10,0:15:02.02,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:15:02.10,0:15:03.56,Default,,0,0,0,,Мен? Меу!
Dialogue: 0,0:15:03.65,0:15:05.44,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:15:07.28,0:15:09.19,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:09.28,0:15:12.36,Default,,0,0,0,,Мен сені қорғай алмағаным үшін кешір, Миу.
Dialogue: 0,0:15:12.45,0:15:14.74,Default,,0,0,0,,Амансың ба, мама?
Dialogue: 0,0:15:14.83,0:15:18.20,Default,,0,0,0,,Мюу мұнда, олай емес.
Dialogue: 0,0:15:20.79,0:15:22.21,Default,,0,0,0,,Мью
Dialogue: 0,0:15:22.29,0:15:24.21,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:25.38,0:15:27.96,Default,,0,0,0,,Анашым, аяғыңызға не болды?
Dialogue: 0,0:15:28.05,0:15:30.34,Default,,0,0,0,,Сіз ауырып қалдыңыз ба? Бұл ауырады ма?
Dialogue: 0,0:15:31.09,0:15:34.85,Default,,0,0,0,,Әке! Анама көмектесіңізші, мамамның аяғы ауырады
Dialogue: 0,0:15:34.93,0:15:37.68,Default,,0,0,0,,Не? Ми... Миу Енді ше?
Dialogue: 0,0:15:37.77,0:15:39.22,Default,,0,0,0,,Әке! Асығыңыз~
Dialogue: 0,0:15:39.31,0:15:43.19,Default,,0,0,0,,О? О, менің? Ақыр соңында әке дедің бе?
Dialogue: 0,0:15:43.27,0:15:46.15,Default,,0,0,0,,Па... Әкем ше? Мен туралы айтып тұрсың ба?
Dialogue: 0,0:15:46.23,0:15:48.90,Default,,0,0,0,,Жоқ, бұл менмін!
Dialogue: 0,0:15:48.98,0:15:50.19,Default,,0,0,0,,Жоқ, менмін.
Dialogue: 0,0:15:50.28,0:15:52.74,Default,,0,0,0,,Ана мен әке...
Dialogue: 0,0:15:52.82,0:15:56.16,Default,,0,0,0,,Жарайды, Мюу, дұрыстап жазылады.
Dialogue: 0,0:15:56.74,0:15:59.87,Default,,0,0,0,,Сондықтан бұл бетті жасамаңыз.
Dialogue: 0,0:15:59.95,0:16:01.25,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:03.67,0:16:06.25,Default,,0,0,0,,Кешіріңіз, бірақ бір сәт кешіріңіз.
Dialogue: 0,0:16:06.34,0:16:07.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:08.84,0:16:10.63,Default,,0,0,0,,Не?
Dialogue: 0,0:16:15.51,0:16:19.10,Default,,0,0,0,,Ремия қайта үйленеді ме? Бұл... бұл ақымақ...
Dialogue: 0,0:16:19.18,0:16:21.98,Default,,0,0,0,,Ремия-чанға да келесі көктем келді.
Dialogue: 0,0:16:22.06,0:16:23.19,Default,,0,0,0,,Құттықтаймыз
Dialogue: 0,0:16:23.27,0:16:28.15,Default,,0,0,0,,Мен көремін. Бұл жарақаттар Мюді ұрлап кеткен адамдардан болған...
Dialogue: 0,0:16:28.90,0:16:30.57,Default,,0,0,0,,Каори, сен қалай ойлайсың?
Dialogue: 0,0:16:30.65,0:16:34.82,Default,,0,0,0,,Иә, жарайды, сіз дұрыс емдей аласыз.
Dialogue: 0,0:16:35.41,0:16:38.41,Default,,0,0,0,,Салдары жоқ емдеуге бірнеше күн қажет.
Dialogue: 0,0:16:38.49,0:16:41.58,Default,,0,0,0,,Баяу, бірте-бірте емдеген дұрыс деп ойлаймын.
Dialogue: 0,0:16:41.66,0:16:44.33,Default,,0,0,0,,Оған дейін ыңғайсыз болады деп ойлаймын.
Dialogue: 0,0:16:44.42,0:16:47.71,Default,,0,0,0,,Мен оны міндетті түрде түзетемін, сондықтан уайымдамаңыз.
Dialogue: 0,0:16:47.79,0:16:50.30,Default,,0,0,0,,О, тәңірім.
Dialogue: 0,0:16:50.38,0:16:53.09,Default,,0,0,0,,Бұл жарақатты ешкім емдей алмайды деп естідім.
Dialogue: 0,0:16:53.17,0:16:55.47,Default,,0,0,0,,Алғысымды қалай айта аламын...
Dialogue: 0,0:16:56.68,0:17:01.97,Default,,0,0,0,,А... ой... Ойланып қарасам, Мюу қандай?
Dialogue: 0,0:17:02.06,0:17:04.69,Default,,0,0,0,,Және бұл ...
Dialogue: 0,0:17:04.77,0:17:07.86,Default,,0,0,0,,Неліктен Мюу сені әке дейді?
Dialogue: 0,0:17:10.15,0:17:12.28,Default,,0,0,0,,Бұл туралы айту тым ұзақ болар еді.
Dialogue: 0,0:17:14.90,0:17:16.99,Default,,0,0,0,,Қызыммен осылай қауыштым.
Dialogue: 0,0:17:17.07,0:17:18.74,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:17:19.45,0:17:22.66,Default,,0,0,0,,Бұл жақсылығымды өмір бойы алсам да өтеймін.
Dialogue: 0,0:17:22.75,0:17:24.20,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:24.29,0:17:26.37,Default,,0,0,0,,Ол Мю Чанның анасы.
Dialogue: 0,0:17:26.46,0:17:28.33,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:17:28.92,0:17:31.04,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:17:32.84,0:17:35.84,Default,,0,0,0,,Сенің осында біраз уақыт болатыныңды естідім.
Dialogue: 0,0:17:36.51,0:17:38.76,Default,,0,0,0,,Олай болса, осы үйді пайдаланыңыз.
Dialogue: 0,0:17:38.84,0:17:41.05,Default,,0,0,0,,Мюу да осылай бақыттырақ болар еді.
Dialogue: 0,0:17:41.14,0:17:44.18,Default,,0,0,0,,Жоқ, бізде бәрі жақсы.
Dialogue: 0,0:17:44.27,0:17:47.27,Default,,0,0,0,,Пристанның жанында жақсы қонақ үй болды.
Dialogue: 0,0:17:47.35,0:17:49.65,Default,,0,0,0,,Мен де кемеге қызмет көрсеткім келеді.
Dialogue: 0,0:17:49.73,0:17:54.28,Default,,0,0,0,,Әй, әкесінің қызынан алшақтауы жақсы емес.
Dialogue: 0,0:17:56.45,0:17:58.95,Default,,0,0,0,,Әке, сіз бір жерге барасыз ба?
Dialogue: 0,0:17:59.03,0:17:59.87,Default,,0,0,0,,Е...
Dialogue: 0,0:17:59.95,0:18:03.24,Default,,0,0,0,,Мен сенің бір күні кетеріңді білемін.
Dialogue: 0,0:18:03.33,0:18:05.75,Default,,0,0,0,,Бірақ... сондықтан
Dialogue: 0,0:18:05.83,0:18:08.37,Default,,0,0,0,,Біз қоштасар күнге дейін менің әкем болшы.
Dialogue: 0,0:18:09.96,0:18:11.38,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:18:11.46,0:18:16.51,Default,,0,0,0,,Қоштасатын күнге дейін айтудың қажеті жоқ, сен менің мәңгілік әкем бола аласың, солай ма?
Dialogue: 0,0:18:16.59,0:18:19.59,Default,,0,0,0,,Жақсылығыңды өтеу үшін өмірімді өткіземін.
Dialogue: 0,0:18:19.68,0:18:22.30,Default,,0,0,0,,Ендеше... бұлай әзіл-қалжыңды доғаршы.
Dialogue: 0,0:18:22.39,0:18:23.81,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:18:22.39,0:18:23.81,Default,,0,0,0,,Ауа... суық, солай емес пе?
Dialogue: 0,0:18:23.81,0:18:23.89,Default,,0,0,0,,Ауа... суық, солай емес пе?
Dialogue: 0,0:18:23.89,0:18:25.31,Default,,0,0,0,,Ауа... суық, солай емес пе?
Dialogue: 0,0:18:23.89,0:18:25.31,Default,,0,0,0,,Хехехе
Dialogue: 0,0:18:25.31,0:18:25.81,Default,,0,0,0,,Ауа... суық, солай емес пе?
Dialogue: 0,0:18:25.89,0:18:29.39,Default,,0,0,0,,Әй, сен танымал боласың.
Dialogue: 0,0:18:29.48,0:18:33.94,Default,,0,0,0,,Алайда, менің күйеуімнен айырылғаныма бес жылдай болды.
Dialogue: 0,0:18:34.02,0:18:35.69,Default,,0,0,0,,Мюдың да әкесі болғанын қалайды, солай ма?
Dialogue: 0,0:18:35.78,0:18:38.32,Default,,0,0,0,,Не? Әке - әке
Dialogue: 0,0:18:38.40,0:18:42.28,Default,,0,0,0,,Дұрыс, әке.
Dialogue: 0,0:18:42.91,0:18:45.70,Default,,0,0,0,,Әй, шұғыл жиналыс болып жатыр.
Dialogue: 0,0:18:45.79,0:18:47.37,Default,,0,0,0,,Қатты болады.
Dialogue: 0,0:18:47.45,0:18:49.21,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:18:56.30,0:18:57.97,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:18:58.05,0:19:01.09,Default,,0,0,0,,Алдымен ұлы мәртебеліге есеп беремін деп айтпадың ба?
Dialogue: 0,0:19:05.31,0:19:06.14,Default,,0,0,0,,Ах
Dialogue: 0,0:19:09.39,0:19:11.65,Default,,0,0,0,,Мұғалім, біраз болды.
Dialogue: 0,0:19:12.69,0:19:15.11,Default,,0,0,0,,Айқай? Йэгаши мырза?
Dialogue: 0,0:19:17.19,0:19:19.03,Default,,0,0,0,,Шимизу-кун үшін кешірім сұраймын.
Dialogue: 0,0:19:20.03,0:19:23.91,Default,,0,0,0,,Бірақ сонда да сенің тірі жүргеніңе қуаныштымын.
Dialogue: 0,0:19:24.87,0:19:27.49,Default,,0,0,0,,Мен Нагумо-кунға өте ризамын.
Dialogue: 0,0:19:28.20,0:19:32.42,Default,,0,0,0,,Иә? Сен Яэгаши-санға және басқаларға көмектесуге бардың.
Dialogue: 0,0:19:32.50,0:19:34.67,Default,,0,0,0,,Тіпті кішкентай балаларды қорғау.
Dialogue: 0,0:19:34.75,0:19:36.00,Default,,0,0,0,,Иә
Dialogue: 0,0:19:36.09,0:19:40.67,Default,,0,0,0,,Бәлкім, ол ақырындап бұрынғы қалпына келе жатқан шығар.
Dialogue: 0,0:19:40.76,0:19:43.43,Default,,0,0,0,,Әлде өзгеріп, өсе бере ме?
Dialogue: 0,0:19:44.55,0:19:46.43,Default,,0,0,0,,Сіз оған сене алатын болсаңыз.
Dialogue: 0,0:19:46.51,0:19:49.18,Default,,0,0,0,,Хэхе хехе...
Dialogue: 0,0:19:50.10,0:19:52.73,Default,,0,0,0,,Ха Кохон
Dialogue: 0,0:19:53.35,0:19:54.35,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:19:54.44,0:19:58.36,Default,,0,0,0,,Мен сізді қауіпті жағдайдан ертерек құтқарғаныңызды естідім.
Dialogue: 0,0:19:58.44,0:19:59.78,Default,,0,0,0,,Нақты қалай?
Dialogue: 0,0:19:59.86,0:20:00.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:00.78,0:20:04.41,Default,,0,0,0,,Жоқ, өлген болуым мүмкін деді.
Dialogue: 0,0:20:04.49,0:20:07.83,Default,,0,0,0,,Сіз оны қалай емдегеніңіз маған біраз қызық болды.
Dialogue: 0,0:20:07.91,0:20:11.46,Default,,0,0,0,,Дұрыс... Дұрыс...
Dialogue: 0,0:20:12.79,0:20:16.21,Default,,0,0,0,,Мұғалім, Нагумо-кунмен бірдеңе болды ма?
Dialogue: 0,0:20:16.29,0:20:19.38,Default,,0,0,0,,А... Менде жоқ па? Не... бұл не?
Dialogue: 0,0:20:19.46,0:20:22.51,Default,,0,0,0,,Әдетте ол да, мен де ұстаз бен шәкіртпіз!
Dialogue: 0,0:20:22.59,0:20:26.14,Default,,0,0,0,,Мұғалім, сабыр етіңіз. Сенің үнің біртүрлі екен.
Dialogue: 0,0:20:26.22,0:20:27.60,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,0:20:28.60,0:20:32.10,Default,,0,0,0,,Нагумо-кун, сен Ай Чанға не істедің?
Dialogue: 0,0:20:33.23,0:20:37.61,Default,,0,0,0,,Ұстаз, сіз ұлы мәртебеліге хабарлағанда бірдеңе болды ма?
Dialogue: 0,0:20:38.90,0:20:42.86,Default,,0,0,0,,Нагумо-кун ресми түрде бидғатшы деп танылды.
Dialogue: 0,0:20:42.95,0:20:45.24,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:20:45.32,0:20:47.57,Default,,0,0,0,,Бұл өте ойланбаған шешім емес пе?
Dialogue: 0,0:20:47.66,0:20:49.95,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:50.04,0:20:53.21,Default,,0,0,0,,Шіркеуге қанша мойынсұнбасаң да, ол үлкен күш болса да
Dialogue: 0,0:20:53.29,0:20:56.58,Default,,0,0,0,,Нагумо-кун Ур қаласын құтқарып қалды.
Dialogue: 0,0:20:57.79,0:21:01.84,Default,,0,0,0,,Алайда қанша қарсылық білдірсем де ешнәрсе жасалған жоқ.
Dialogue: 0,0:21:03.01,0:21:06.72,Default,,0,0,0,,Менің наразылығымды елемеу керек еді.
Dialogue: 0,0:21:06.80,0:21:10.01,Default,,0,0,0,,Нагумо-кунды бидғатшы деп жариялау нені білдіреді?
Dialogue: 0,0:21:10.10,0:21:11.22,Default,,0,0,0,,Құнарлылық құдайының өзі
Dialogue: 0,0:21:11.31,0:21:13.43,Default,,0,0,0,,Бұл оны жоққа шығаруды білдірмейді ме?
Dialogue: 0,0:21:14.85,0:21:16.65,Default,,0,0,0,,Біртүрлі екені анық.
Dialogue: 0,0:21:17.40,0:21:21.19,Default,,0,0,0,,Енді ойлап қарасам, Ұлы мәртебелі және патшалық жағындағы адамдар күйі.
Dialogue: 0,0:21:21.27,0:21:24.07,Default,,0,0,0,,Біртүрлі болып көрінді...
Dialogue: 0,0:21:24.15,0:21:26.66,Default,,0,0,0,,Мен бұл туралы қызықтымын.
Dialogue: 0,0:21:26.74,0:21:29.28,Default,,0,0,0,,Олар не ойлайды?
Dialogue: 0,0:21:29.37,0:21:33.75,Default,,0,0,0,,Сіз онсыз да күшті Нагумо-кунға кімді жібермексіз...
Dialogue: 0,0:21:34.54,0:21:35.54,Default,,0,0,0,,Йэгаши мырза
Dialogue: 0,0:21:36.79,0:21:40.17,Default,,0,0,0,,Нагумо-кунның маған ғана айтқаны бар.
Dialogue: 0,0:21:41.59,0:21:43.51,Default,,0,0,0,,Бұл әңгіме ме? (Айко) Иә.
Dialogue: 0,0:21:44.17,0:21:48.01,Default,,0,0,0,,Бұл шіркеу табынатын Құдай және Нагумо-кунның мақсаты туралы.
Dialogue: 0,0:21:48.93,0:21:53.72,Default,,0,0,0,,Бұл ешқандай дәлелі жоқ әңгіме, бірақ өте маңызды оқиға...
Dialogue: 0,0:21:57.23,0:22:02.40,Default,,0,0,0,,Мен бәрін тезірек айтып беруім керек деп ойлаймын.
Dialogue: 0,0:22:04.03,0:22:09.03,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:33.95,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.03,0:23:38.66,Default,,0,0,0,,Келесі жолы «Мұхит түбі туралы естеліктер»
Dialogue: 0,0:23:40.16,0:23:46.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
