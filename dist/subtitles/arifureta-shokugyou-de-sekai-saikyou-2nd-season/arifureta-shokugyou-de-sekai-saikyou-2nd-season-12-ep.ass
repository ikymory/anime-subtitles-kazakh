Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:25.29,0:01:30.92,Default,,0,0,0,,～♪
Dialogue: 0,0:01:39.43,0:01:40.76,Default,,0,0,0,,Король астанасына басып кіру
Dialogue: 0,0:01:40.89,0:01:45.43,Default,,0,0,0,,Маджинзоку сияқты мүдделері бар Эри Накамураның басшылығына негізделген.
Dialogue: 0,0:01:46.56,0:01:49.56,Default,,0,0,0,,Ол некроманияны пайдаланады, бұл оның шақыруы.
Dialogue: 0,0:01:50.19,0:01:55.57,Default,,0,0,0,,Ұлы Оркус лабиринтінде кездескен жын-әйел нәсілінің мәйіті туралы хабарлама қалдырыңыз.
Dialogue: 0,0:01:55.65,0:01:59.45,Default,,0,0,0,,Жындар нәсілімен байланыс сәтті болған сияқты.
Dialogue: 0,0:01:59.53,0:02:04.20,Default,,0,0,0,,Және король астанасына және басқа әлемнің адамдарын өлтіруге арналған нұсқаулық
Dialogue: 0,0:02:04.29,0:02:06.45,Default,,0,0,0,,Рыцарлардың ұсынысына байланысты
Dialogue: 0,0:02:06.54,0:02:12.21,Default,,0,0,0,,Ол жын-перілерден өзіне және Коуки Аманогаваға еркіндік сұрады.
Dialogue: 0,0:02:12.92,0:02:17.09,Default,,0,0,0,,Сондай-ақ ол барлық достарын бірден өлтірген жоқ.
Dialogue: 0,0:02:17.17,0:02:20.22,Default,,0,0,0,,Өлгеннен кейін бірден бір адамға ғана қолдануға болады.
Dialogue: 0,0:02:20.30,0:02:23.22,Default,,0,0,0,,Бұл «биндама» деп аталатын техниканың табиғатына байланысты деп есептеледі.
Dialogue: 0,0:02:25.06,0:02:28.64,Default,,0,0,0,,Нәтиже Король астанасына шабуыл сәтсіз аяқталды.
Dialogue: 0,0:02:28.73,0:02:30.98,Default,,0,0,0,,Эри Накамура жындар жарысымен қашып кетті
Dialogue: 0,0:02:31.73,0:02:36.19,Default,,0,0,0,,Мәртебелі мырзаның миын жууға және өлтіруге қатысты, бұл Эри Накамура емес.
Dialogue: 0,0:02:36.28,0:02:39.03,Default,,0,0,0,,Айко Хатаяманы алып кеткен Камияма монахы
Dialogue: 0,0:02:39.11,0:02:42.03,Default,,0,0,0,,байланысты деп есептелсе де
Dialogue: 0,0:02:42.12,0:02:45.66,Default,,0,0,0,,Қазіргі уақытта монах әйелдің қайда екені белгісіз.
Dialogue: 0,0:02:45.74,0:02:47.87,Default,,0,0,0,,Ақпарат жиналуда
Dialogue: 0,0:02:57.05,0:03:02.34,Default,,0,0,0,,Басқа әлемдердің құрбандары - Дайсуке Хияма және Рейчи Кондо
Dialogue: 0,0:03:07.27,0:03:09.60,Default,,0,0,0,,Каори Ширасакидің үш мүшесі
Dialogue: 0,0:03:23.62,0:03:25.41,Default,,0,0,0,,Уф
Dialogue: 0,0:03:30.37,0:03:31.21,Default,,0,0,0,,Мұғалім ше?
Dialogue: 0,0:03:31.79,0:03:35.04,Default,,0,0,0,,Айко-сан болса, мен оған үзіліс жасауын өтіндім.
Dialogue: 0,0:03:35.13,0:03:35.96,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:36.04,0:03:39.42,Default,,0,0,0,,Хаджиме Каори жақсы.
Dialogue: 0,0:03:39.51,0:03:41.22,Default,,0,0,0,,Сондықтан мен Айконың орнына бардым.
Dialogue: 0,0:03:42.51,0:03:43.55,Default,,0,0,0,,Юе
Dialogue: 0,0:03:50.31,0:03:51.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:51.98,0:03:53.56,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:53.65,0:03:54.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:56.77,0:03:58.15,Default,,0,0,0,,Нагумо-кун
Dialogue: 0,0:04:03.24,0:04:05.20,Default,,0,0,0,,Маған күлме
Dialogue: 0,0:04:05.82,0:04:08.70,Default,,0,0,0,,Мұғалім оқушыларды бәрінен де жоғары бағалайды.
Dialogue: 0,0:04:08.79,0:04:09.99,Default,,0,0,0,,Мен сені тағы да өлтірдім.
Dialogue: 0,0:04:11.04,0:04:13.00,Default,,0,0,0,,Сізде ойланатын нәрсе бар, солай ма?
Dialogue: 0,0:04:15.46,0:04:19.00,Default,,0,0,0,,Шынымды айтсам, бөлу оңай емес.
Dialogue: 0,0:04:20.46,0:04:24.01,Default,,0,0,0,,Хияма-кунның істегені кешірілмейді, бірақ
Dialogue: 0,0:04:24.09,0:04:25.26,Default,,0,0,0,,Мүмкін болса
Dialogue: 0,0:04:25.34,0:04:29.18,Default,,0,0,0,,Қылмыстарын өтеу үшін өмір сүрсе екен.
Dialogue: 0,0:04:29.26,0:04:33.23,Default,,0,0,0,,Бірақ мен Нагумоның ашуының күштілігін де түсінемін.
Dialogue: 0,0:04:34.19,0:04:39.52,Default,,0,0,0,,Оның үстіне Нагумо-кунды кінәлауға құқығым жоқ.
Dialogue: 0,0:04:39.61,0:04:42.24,Default,,0,0,0,,Мұғалім жаңа ғана көмектесті, солай ма?
Dialogue: 0,0:04:42.32,0:04:45.70,Default,,0,0,0,,Менің ойымша, мұның бәрін өзіңіз жасау сізге ауыртпалық түсірмейді.
Dialogue: 0,0:04:45.78,0:04:47.41,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:04:47.49,0:04:50.74,Default,,0,0,0,,Мен оларды өлтіре алатынымды түсіндім.
Dialogue: 0,0:04:50.83,0:04:52.50,Default,,0,0,0,,Мен Тио-санға көмектестім.
Dialogue: 0,0:04:52.58,0:04:54.21,Default,,0,0,0,,Сіз өкінесіз бе?
Dialogue: 0,0:04:56.33,0:04:57.29,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:57.38,0:05:01.30,Default,,0,0,0,,Сол кезде мен өзімді және Тио-санды дайындадым...
Dialogue: 0,0:05:01.38,0:05:04.80,Default,,0,0,0,,Біз шіркеудің әрекетін назардан тыс қалдыра алмадық.
Dialogue: 0,0:05:05.59,0:05:07.59,Default,,0,0,0,,Көмегің үшін...
Dialogue: 0,0:05:07.68,0:05:11.39,Default,,0,0,0,,Егер біз жағдайды жіберсек, студенттер қорқынышты нәрселерге ұшырайды ...
Dialogue: 0,0:05:12.77,0:05:18.06,Default,,0,0,0,,Сондықтан мен еш өкінбеймін...
Dialogue: 0,0:05:22.53,0:05:25.90,Default,,0,0,0,,Сіз әлі де мұғалімсіз бе?
Dialogue: 0,0:05:25.99,0:05:27.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:27.82,0:05:29.16,Default,,0,0,0,,Егер қазірден бастап
Dialogue: 0,0:05:29.24,0:05:31.70,Default,,0,0,0,,Біздің мұғалім болғың келсе.
Dialogue: 0,0:05:32.29,0:05:35.20,Default,,0,0,0,,Менің шәкіртімнің өзімшілдігіне құлақ түре аласыз ба?
Dialogue: 0,0:05:36.00,0:05:38.21,Default,,0,0,0,,Сіз өзімшілсіз бе?
Dialogue: 0,0:05:38.83,0:05:42.42,Default,,0,0,0,,Мен мұғалімнің өзін кінәлі сезінгенін қалаймын.
Dialogue: 0,0:05:42.50,0:05:44.71,Default,,0,0,0,,Сол жүкті арқаңызда көтергеніңізді қалаймын.
Dialogue: 0,0:05:46.13,0:05:49.14,Default,,0,0,0,,Дұрыс күрес, арқаны дұрыс көтеру
Dialogue: 0,0:05:49.22,0:05:53.06,Default,,0,0,0,,Дұрыс азап, дұрыс ыңылдау
Dialogue: 0,0:05:53.14,0:05:57.10,Default,,0,0,0,,Өте адамдық және аздап жарқыраған көрінеді
Dialogue: 0,0:05:57.85,0:06:00.73,Default,,0,0,0,,Себебі мен оны енді сезе алмаймын
Dialogue: 0,0:06:01.73,0:06:04.61,Default,,0,0,0,,Адамдығымды ұмытпаймын. Мен жақсы үлгі боламын.
Dialogue: 0,0:06:05.49,0:06:07.49,Default,,0,0,0,,Мен мұқият боламын.
Dialogue: 0,0:06:07.57,0:06:12.37,Default,,0,0,0,,Мен мұны істесем, Жапонияға оралғаннан кейін мен міндетті түрде адам сияқты өмір сүре аламын.
Dialogue: 0,0:06:12.45,0:06:13.53,Default,,0,0,0,,Ах
Dialogue: 0,0:06:15.45,0:06:16.87,Default,,0,0,0,,Нагумо-кун
Dialogue: 0,0:06:19.25,0:06:22.13,Default,,0,0,0,,Жарайды, бұл өте ауыр және ауыр.
Dialogue: 0,0:06:22.21,0:06:24.17,Default,,0,0,0,,Ол бұзылғалы тұрғанда
Dialogue: 0,0:06:24.25,0:06:27.38,Default,,0,0,0,,Егер басқа ешкім болмаса және сіз қиындыққа тап болсаңыз
Dialogue: 0,0:06:29.09,0:06:30.93,Default,,0,0,0,,Сізге арқамды қарызға беруге рұқсат етіңіз
Dialogue: 0,0:06:32.85,0:06:36.72,Default,,0,0,0,,Сіз шынымен кімсіз?
Dialogue: 0,0:06:37.31,0:06:41.15,Default,,0,0,0,,Жарайды, Нагумо-кун, маған аздап қарыз беруіңді өтінемін.
Dialogue: 0,0:06:41.23,0:06:43.27,Default,,0,0,0,,Айо Сенсей
Dialogue: 0,0:06:47.57,0:06:52.57,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:06:56.58,0:06:58.29,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:07:00.33,0:07:01.46,Default,,0,0,0,,Біз жындан жаңа мәлімет алдық.
Dialogue: 0,0:07:02.92,0:07:04.00,Default,,0,0,0,,Фу
Dialogue: 0,0:07:09.47,0:07:12.89,Default,,0,0,0,,Еңбегіңізге рахмет, Коуки-сан
Dialogue: 0,0:07:12.97,0:07:15.64,Default,,0,0,0,,Лилия, бұл маңызды емес.
Dialogue: 0,0:07:16.35,0:07:19.81,Default,,0,0,0,,Лили соңғы бес күнде көп ұйықтамады, солай ма?
Dialogue: 0,0:07:19.89,0:07:22.10,Default,,0,0,0,,бәрібір.
Dialogue: 0,0:07:22.19,0:07:25.02,Default,,0,0,0,,Бұл қиын, бірақ шын мәнінде қиын нәрсе
Dialogue: 0,0:07:25.11,0:07:29.65,Default,,0,0,0,,Өйткені олар жақындарынан, дүние-мүлкінен айырылған Хейрих адамдар.
Dialogue: 0,0:07:29.74,0:07:33.11,Default,,0,0,0,,Олай десеңіз, Лили де ұлы мәртебелі атайды... А.
Dialogue: 0,0:07:34.74,0:07:36.41,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:37.08,0:07:38.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:38.54,0:07:40.62,Default,,0,0,0,,Шидзуку қалай?
Dialogue: 0,0:07:41.33,0:07:42.67,Default,,0,0,0,,Өзгеріс жоқ.
Dialogue: 0,0:07:43.50,0:07:45.67,Default,,0,0,0,,Әдетте әдеттегідей.
Dialogue: 0,0:07:45.75,0:07:48.42,Default,,0,0,0,,Мұны білмей тұрып, сіз үнемі жоғары қарайсыз.
Dialogue: 0,0:07:49.34,0:07:51.67,Default,,0,0,0,,Сіз оларды күтіп жүрсіз бе?
Dialogue: 0,0:07:51.76,0:07:54.93,Default,,0,0,0,,Шынымды айтсам, мен Нагумоға сене алмаймын.
Dialogue: 0,0:07:55.80,0:07:58.93,Default,,0,0,0,,Мен сенің Шидзукумен кездескеніңді қаламаймын.
Dialogue: 0,0:08:06.40,0:08:07.23,Default,,0,0,0,,Ах
Dialogue: 0,0:08:09.28,0:08:12.07,Default,,0,0,0,,Мынау... Коуки-сан, анау!
Dialogue: 0,0:08:12.15,0:08:14.16,Default,,0,0,0,,Бірдеңе құлап жатыр ма?
Dialogue: 0,0:08:14.24,0:08:16.41,Default,,0,0,0,,Не? Не кенеттен...
Dialogue: 0,0:08:17.99,0:08:18.91,Default,,0,0,0,,Не?
Dialogue: 0,0:08:18.99,0:08:22.54,Default,,0,0,0,,үшінң сақ болыңдар, жоғарыдан бірдеңе келе жатыр.
Dialogue: 0,0:08:34.63,0:08:37.97,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:08:38.05,0:08:39.35,Default,,0,0,0,,Нагумо-кун!
Dialogue: 0,0:08:40.39,0:08:43.89,Default,,0,0,0,,Йэгаши, сен амансың.
Dialogue: 0,0:08:47.44,0:08:49.65,Default,,0,0,0,,Нагумо-кун, Каори ше?
Dialogue: 0,0:08:49.73,0:08:51.53,Default,,0,0,0,,Неліктен Каори мұнда жоқ?
Dialogue: 0,0:08:51.61,0:08:54.03,Default,,0,0,0,,А, мен жақында боламын.
Dialogue: 0,0:08:54.11,0:08:54.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:55.03,0:08:59.37,Default,,0,0,0,,Сыртқы түрі сәл ғана өзгерген болуы мүмкін.
Dialogue: 0,0:09:00.33,0:09:02.04,Default,,0,0,0,,Бұл менің кінәм емес, ашуланба.
Dialogue: 0,0:09:02.12,0:09:06.12,Default,,0,0,0,,Күте тұрыңыз, не? Бұл не?
Dialogue: 0,0:09:06.21,0:09:09.54,Default,,0,0,0,,Мен қатты қобалжыдым, бұл нені білдіреді?
Dialogue: 0,0:09:09.63,0:09:11.30,Default,,0,0,0,,Сен Каориге не істедің?
Dialogue: 0,0:09:11.38,0:09:13.55,Default,,0,0,0,,Денені тексеру? Неге ондай істегіңіз келеді?
Dialogue: 0,0:09:13.63,0:09:16.51,Default,,0,0,0,,Хаджиме Кюн
Dialogue: 0,0:09:17.51,0:09:18.51,Default,,0,0,0,,Бұл дауыс?
Dialogue: 0,0:09:18.59,0:09:22.68,Default,,0,0,0,,Қабыл алыңыздар!
Dialogue: 0,0:09:22.77,0:09:23.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:43.08,0:09:44.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:44.25,0:09:45.16,Default,,0,0,0,,Ах
Dialogue: 0,0:09:46.33,0:09:48.00,Default,,0,0,0,,(Мектеп оқушысы 5) Ей, сен! (Мектеп оқушысы 4) Ааах!
Dialogue: 0,0:09:48.08,0:09:49.67,Default,,0,0,0,,Күте тұрыңыз, Коуки
Dialogue: 0,0:09:50.67,0:09:51.92,Default,,0,0,0,,Шидзуку?
Dialogue: 0,0:09:54.01,0:09:55.92,Default,,0,0,0,,Уф
Dialogue: 0,0:09:56.84,0:09:59.43,Default,,0,0,0,,Каори?
Dialogue: 0,0:10:00.43,0:10:02.93,Default,,0,0,0,,Каори...?
Dialogue: 0,0:10:03.01,0:10:04.02,Default,,0,0,0,,Е...
Dialogue: 0,0:10:05.31,0:10:07.14,Default,,0,0,0,,Иә, бұл Каори.
Dialogue: 0,0:10:07.23,0:10:10.23,Default,,0,0,0,,Шидзуку-чанның ең жақын досы Каори Ширасаки
Dialogue: 0,0:10:10.31,0:10:12.27,Default,,0,0,0,,Біраз басқаша көрінсе де
Dialogue: 0,0:10:12.36,0:10:13.77,Default,,0,0,0,,Мен тірімін және жақсымын.
Dialogue: 0,0:10:21.37,0:10:22.49,Default,,0,0,0,,Каори…
Dialogue: 0,0:10:24.33,0:10:25.79,Default,,0,0,0,,Каори!
Dialogue: 0,0:10:26.79,0:10:29.67,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:32.38,0:10:37.59,Default,,0,0,0,,Сізді алаңдатқаным үшін кешіріңіз. Жарайды. Жарайды.
Dialogue: 0,0:10:37.67,0:10:42.68,Default,,0,0,0,,Жақсы, жақсы.
Dialogue: 0,0:10:42.76,0:10:45.64,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:45.72,0:10:46.81,Default,,0,0,0,,Иә
Dialogue: 0,0:10:49.73,0:10:52.52,Default,,0,0,0,,Бұл нақты нені білдіреді?
Dialogue: 0,0:10:52.61,0:10:56.78,Default,,0,0,0,,Қарапайым тілмен айтқанда, Каоридің жанын сиқырмен қорғаңыз.
Dialogue: 0,0:10:56.86,0:11:00.65,Default,,0,0,0,,Бұл Ноинтоның жөнделген денесіне бекітілгенін білдіреді.
Dialogue: 0,0:11:01.78,0:11:02.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:02.78,0:11:04.53,Default,,0,0,0,,Мен мүлде түсінбеймін.
Dialogue: 0,0:11:04.62,0:11:07.70,Default,,0,0,0,,Не? Ал, Шидзуку-чан
Dialogue: 0,0:11:07.79,0:11:10.21,Default,,0,0,0,,Біз қазір қолданып жатқан сиқыр
Dialogue: 0,0:11:10.29,0:11:13.88,Default,,0,0,0,,Бұл құдайлар дәуірі деп аталатын дәуірдегі сиқырдың нашарлаған нұсқасы.
Dialogue: 0,0:11:13.96,0:11:15.59,Default,,0,0,0,,Біз бірге оқыдық, солай ма?
Dialogue: 0,0:11:15.67,0:11:19.84,Default,,0,0,0,,Иә, бұл дүниенің жаратылу мифінде пайда болатын сиқыр емес пе?
Dialogue: 0,0:11:19.92,0:11:21.93,Default,,0,0,0,,Ағымдағы атрибут сиқырынан айырмашылығы
Dialogue: 0,0:11:22.01,0:11:24.72,Default,,0,0,0,,Ол неғұрлым іргелі түрде әрекет ете алады...
Dialogue: 0,0:11:25.60,0:11:30.35,Default,,0,0,0,,Күте тұрыңыз, мүмкін Нагумо-кун мен басқаларында «Құдайлар дәуірі» сиқыры бар шығар?
Dialogue: 0,0:11:30.43,0:11:33.19,Default,,0,0,0,,Бұл сіз адамдардың жан дүниесіне араласа аласыз дегенді білдіре ме?
Dialogue: 0,0:11:33.27,0:11:34.11,Default,,0,0,0,,Иә
Dialogue: 0,0:11:34.19,0:11:37.90,Default,,0,0,0,,Сондықтан мен Каоридің жанын қорғадым, ол өлді деп есептелсе де.
Dialogue: 0,0:11:37.98,0:11:39.99,Default,,0,0,0,,Сіз оны басқа денеге бекіттіңіз.
Dialogue: 0,0:11:40.07,0:11:42.99,Default,,0,0,0,,Иә! Шидзуку-чан күткендей
Dialogue: 0,0:11:43.07,0:11:46.33,Default,,0,0,0,,Бірақ неге бұл дене?
Dialogue: 0,0:11:46.41,0:11:48.24,Default,,0,0,0,,Каоридің денесі жақсы болмай қалды ма?
Dialogue: 0,0:11:48.33,0:11:50.66,Default,,0,0,0,,Каоридің денесі толық сауығып кетті.
Dialogue: 0,0:11:50.75,0:11:52.96,Default,,0,0,0,,Жанымды қайтара алдым
Dialogue: 0,0:11:53.04,0:11:54.42,Default,,0,0,0,,Сонда неге...
Dialogue: 0,0:11:54.50,0:11:56.75,Default,,0,0,0,,Мен оны сұрадым (Сидзуку) Эх...
Dialogue: 0,0:11:57.42,0:12:00.76,Default,,0,0,0,,Себебі мен одан да күштірек болғым келеді
Dialogue: 0,0:12:02.34,0:12:05.22,Default,,0,0,0,,Мен айтсам Каори тыңдамайды.
Dialogue: 0,0:12:05.30,0:12:07.01,Default,,0,0,0,,Каоридің шын денесі
Dialogue: 0,0:12:07.10,0:12:10.56,Default,,0,0,0,,Ол сиқырлы түрде мұздатылған және сақталған.
Dialogue: 0,0:12:10.64,0:12:13.02,Default,,0,0,0,,Қалаған уақытта қайтуыңызға болады.
Dialogue: 0,0:12:14.48,0:12:15.86,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:16.44,0:12:19.90,Default,,0,0,0,,Каори әрқашан ақылсыз әрекеттер жасады.
Dialogue: 0,0:12:19.98,0:12:21.86,Default,,0,0,0,,Бұл жолы керемет
Dialogue: 0,0:12:21.94,0:12:24.66,Default,,0,0,0,,Эххе, сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:12:24.74,0:12:28.74,Default,,0,0,0,,Бұл жақсы. Сен тірі болғанша, бар болғаны.
Dialogue: 0,0:12:30.62,0:12:31.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:32.00,0:12:36.38,Default,,0,0,0,,Нагумо-кун Юэ-сан Шиа-сан Тио-сан
Dialogue: 0,0:12:36.46,0:12:39.67,Default,,0,0,0,,Менің ең жақын досымды құтқарғаныңыз үшін рахмет.
Dialogue: 0,0:12:40.92,0:12:42.92,Default,,0,0,0,,Мен бұл жақсылықты ешқашан ұмытпаймын.
Dialogue: 0,0:12:43.01,0:12:46.26,Default,,0,0,0,,Егер мен сізге бірдеңе істей алатын болсам, маған хабарлаңыз.
Dialogue: 0,0:12:46.34,0:12:48.05,Default,,0,0,0,,Мен жауап беруге бар күшімді саламын.
Dialogue: 0,0:12:48.14,0:12:49.43,Default,,0,0,0,,Иә
Dialogue: 0,0:12:49.51,0:12:51.97,Default,,0,0,0,,Ол әлі сыпайы жігіт.
Dialogue: 0,0:12:52.06,0:12:54.35,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:12:54.44,0:12:57.44,Default,,0,0,0,,Біз жай ғана достарымызға көмектестік.
Dialogue: 0,0:12:58.65,0:13:02.15,Default,,0,0,0,,Керісінше ол да маған қамқор болды.
Dialogue: 0,0:13:02.23,0:13:05.32,Default,,0,0,0,,Сіз маған Коукиге маңызды құпия дәрі бердіңіз.
Dialogue: 0,0:13:07.57,0:13:09.45,Default,,0,0,0,,Егер Яэгаши бұзса
Dialogue: 0,0:13:09.53,0:13:11.74,Default,,0,0,0,,Каори қиындыққа тап болады.
Dialogue: 0,0:13:11.83,0:13:15.16,Default,,0,0,0,,Мен... Мазасыз болу қорқынышты, Хажиме-кун.
Dialogue: 0,0:13:15.25,0:13:16.67,Default,,0,0,0,,Және... (Каори/Шидзуку) Иә?
Dialogue: 0,0:13:16.75,0:13:18.96,Default,,0,0,0,,Кейбір мұғалім айтады
Dialogue: 0,0:13:19.04,0:13:21.92,Default,,0,0,0,,Жалғыз өмір сүрмеу керек сияқты.
Dialogue: 0,0:13:22.00,0:13:23.34,Default,,0,0,0,,Ах
Dialogue: 0,0:13:23.42,0:13:25.97,Default,,0,0,0,,Сізде бәрі болуы мүмкін емес, бірақ
Dialogue: 0,0:13:26.05,0:13:27.51,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:13:28.47,0:13:29.93,Default,,0,0,0,,Нагумо-кун
Dialogue: 0,0:13:32.06,0:13:33.43,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:34.06,0:13:36.39,Default,,0,0,0,,Сонда біз Алланың алақанындамыз.
Dialogue: 0,0:13:36.48,0:13:38.69,Default,,0,0,0,,Сіз жай ғана биледім дейсіз бе?
Dialogue: 0,0:13:38.77,0:13:41.02,Default,,0,0,0,,Онда неге ертерек айтпадың?
Dialogue: 0,0:13:41.11,0:13:44.69,Default,,0,0,0,,Мен айтқанымда сендің бе?
Dialogue: 0,0:13:45.44,0:13:46.99,Default,,0,0,0,,Құдай жынды
Dialogue: 0,0:13:47.07,0:13:50.03,Default,,0,0,0,,Егер сіз істеп жатқан нәрсені мағынасыз деп айтсаңыз ше?
Dialogue: 0,0:13:50.12,0:13:54.54,Default,,0,0,0,,Маған сенбей, сынаған жоқсың ба?
Dialogue: 0,0:13:55.04,0:13:58.75,Default,,0,0,0,,Сонымен... Бірақ бұдан былай бірге күресетін болсақ...
Dialogue: 0,0:13:58.83,0:14:00.21,Default,,0,0,0,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:14:00.29,0:14:03.13,Default,,0,0,0,,Мен сені іздеп тауып, ұрысуға бармаймын.
Dialogue: 0,0:14:03.21,0:14:07.22,Default,,0,0,0,,Бұл дүниенің адамдарымен не болып жатқаны сізді қызықтырмайтынына сенімдісіз бе?
Dialogue: 0,0:14:07.30,0:14:10.30,Default,,0,0,0,,Бет-әлпетін де танымайтын адамға бере алатын күшім
Dialogue: 0,0:14:10.39,0:14:12.05,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:14:12.14,0:14:15.60,Default,,0,0,0,,Неге! сен менен күштісің
Dialogue: 0,0:14:15.68,0:14:17.18,Default,,0,0,0,,Егер сізде сонша күш болса
Dialogue: 0,0:14:17.27,0:14:20.06,Default,,0,0,0,,Оны дұрыс нәрсеге пайдалану керек емес пе?
Dialogue: 0,0:14:25.73,0:14:28.20,Default,,0,0,0,,Егер сізде күш болса...
Dialogue: 0,0:14:28.28,0:14:31.99,Default,,0,0,0,,Сондықтан сіз әрқашан маңызды орындасыз.
Dialogue: 0,0:14:32.07,0:14:34.49,Default,,0,0,0,,Сіз жерде жорғалайсыз.
Dialogue: 0,0:14:34.58,0:14:35.79,Default,,0,0,0,,Не?
Dialogue: 0,0:14:35.87,0:14:38.58,Default,,0,0,0,,Билік бар деп бірдеңе жасама.
Dialogue: 0,0:14:38.66,0:14:42.50,Default,,0,0,0,,Мен күш іздеймін және қолданамын, өйткені мен бірдеңе істегім келеді.
Dialogue: 0,0:14:42.59,0:14:45.38,Default,,0,0,0,,Сіздің ерік-жігеріңіз тым әлсіз.
Dialogue: 0,0:14:52.14,0:14:53.22,Default,,0,0,0,,Цк
Dialogue: 0,0:15:08.15,0:15:09.24,Default,,0,0,0,,Хаджиме
Dialogue: 0,0:15:10.40,0:15:11.74,Default,,0,0,0,,Не? Юэ
Dialogue: 0,0:15:11.82,0:15:14.83,Default,,0,0,0,,Бұл балалар өздері сияқты жақсы ма?
Dialogue: 0,0:15:14.91,0:15:18.20,Default,,0,0,0,,Мұғалім бар, сондықтан проблема жоқ.
Dialogue: 0,0:15:18.29,0:15:19.58,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:15:19.66,0:15:23.33,Default,,0,0,0,,Хаджиманың осылай қоштасуы дұрыс па?
Dialogue: 0,0:15:24.42,0:15:25.59,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:15:27.00,0:15:28.59,Default,,0,0,0,,Бұл тамаша болар еді
Dialogue: 0,0:15:30.63,0:15:32.22,Default,,0,0,0,,Ах, Шидзуку-чан
Dialogue: 0,0:15:32.30,0:15:34.30,Default,,0,0,0,,Каори, көрші болғың келе ме?
Dialogue: 0,0:15:34.39,0:15:36.06,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:15:38.52,0:15:41.31,Default,,0,0,0,,Кешіріңіз, әпкеңіздің жағы.
Dialogue: 0,0:15:42.48,0:15:44.06,Default,,0,0,0,,Неге әпке?
Dialogue: 0,0:15:44.15,0:15:47.07,Default,,0,0,0,,Нагумо-кун мен басқалары қазір қайда бара жатыр?
Dialogue: 0,0:15:47.15,0:15:49.23,Default,,0,0,0,,Сіз Ұлы лабиринтке ұмтыласыз, солай ма?
Dialogue: 0,0:15:49.32,0:15:53.82,Default,,0,0,0,,Ах, шығыстағы үлкен ағаш теңізі. Ол жерде үлкен лабиринт бар.
Dialogue: 0,0:15:53.91,0:15:57.16,Default,,0,0,0,,Сонда ол империялық территория арқылы өте ме?
Dialogue: 0,0:15:57.24,0:15:58.45,Default,,0,0,0,,Лилия
Dialogue: 0,0:15:58.54,0:15:59.62,Default,,0,0,0,,Бұл болмайды.
Dialogue: 0,0:15:59.70,0:16:02.83,Default,,0,0,0,,Олай болса, мен сенімен бірге келе аламын ба?
Dialogue: 0,0:16:02.92,0:16:05.04,Default,,0,0,0,,Не? Неліктен?
Dialogue: 0,0:16:05.13,0:16:07.46,Default,,0,0,0,,Патша астанасына осы шабуылмен
Dialogue: 0,0:16:07.54,0:16:11.38,Default,,0,0,0,,Империямен көп нәрсені талқылау керек.
Dialogue: 0,0:16:11.47,0:16:14.47,Default,,0,0,0,,Жиналыс неғұрлым тез өткізілсе, соғұрлым жақсы.
Dialogue: 0,0:16:15.22,0:16:18.64,Default,,0,0,0,,Сіз оны жібере аласыз, бірақ ол империя астанасына кірмейді.
Dialogue: 0,0:16:18.72,0:16:22.02,Default,,0,0,0,,Мен сізді императормен кездесуге ешқашан ертіп бармаймын.
Dialogue: 0,0:16:22.10,0:16:25.94,Default,,0,0,0,,Хехе, мен онша батыл ештеңе айтпаймын.
Dialogue: 0,0:16:26.02,0:16:28.27,Default,,0,0,0,,Олай болса, біз де сізге ереміз.
Dialogue: 0,0:16:28.36,0:16:31.19,Default,,0,0,0,,Бұл дүниені ойламаймын дегендерге
Dialogue: 0,0:16:31.28,0:16:32.57,Default,,0,0,0,,Лилияны басқаруда қалдыруға болмайды.
Dialogue: 0,0:16:33.32,0:16:35.45,Default,,0,0,0,,Біз жол бойында қауіпсіздікті қамтамасыз етеміз.
Dialogue: 0,0:16:35.53,0:16:40.04,Default,,0,0,0,,Ал егер Нагумо ештеңе істемесе, мен бұл әлемді құтқарамын.
Dialogue: 0,0:16:40.12,0:16:44.79,Default,,0,0,0,,Ол үшін бізге құдірет, құдай заманының сиқырының күші керек!
Dialogue: 0,0:16:44.87,0:16:48.25,Default,,0,0,0,,Егер мен сізге еретін болсам, мен Құдайдың жасы сиқырына ие боламын.
Dialogue: 0,0:16:48.34,0:16:51.55,Default,,0,0,0,,Жоқ, мен сізге орынды айтамын, сондықтан сіз қалағаныңызша бара аласыз.
Dialogue: 0,0:16:51.63,0:16:55.43,Default,,0,0,0,,Менің артымнан жүру өте тітіркендіргіш.
Dialogue: 0,0:16:55.51,0:17:00.26,Default,,0,0,0,,Бірақ Нагумо-кун, егер біз қазір Ұлы лабиринтке қарсы тұрсақ та,
Dialogue: 0,0:17:00.35,0:17:02.56,Default,,0,0,0,,Жақында өлемін деп айтпадың ба?
Dialogue: 0,0:17:02.64,0:17:05.85,Default,,0,0,0,,Не? Міне, қара.
Dialogue: 0,0:17:05.94,0:17:09.48,Default,,0,0,0,,Мен қабілетсіз болсам да, қолымнан бірдеңе келді, олай болды.
Dialogue: 0,0:17:09.57,0:17:10.82,Default,,0,0,0,,Мен бара аламын.
Dialogue: 0,0:17:14.65,0:17:16.95,Default,,0,0,0,,Бұл мүмкін емес, солай ма?
Dialogue: 0,0:17:17.03,0:17:18.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:19.66,0:17:21.29,Default,,0,0,0,,Маған жақсылық жасай аласыз ба?
Dialogue: 0,0:17:22.29,0:17:23.87,Default,,0,0,0,,Бір рет қана жеткілікті
Dialogue: 0,0:17:23.95,0:17:26.92,Default,,0,0,0,,Сізде кем дегенде бір Құдайлар дәуірінің сиқыры бар ма, жоқ па, соған байланысты.
Dialogue: 0,0:17:27.00,0:17:29.84,Default,,0,0,0,,Басқа лабиринттерді бағындыруда шешуші айырмашылық болады.
Dialogue: 0,0:17:29.92,0:17:32.34,Default,,0,0,0,,Қоңыраудан, өтінемін, Нагумо-кун.
Dialogue: 0,0:17:32.42,0:17:35.51,Default,,0,0,0,,Мен күшейіп, Эримен қайта сөйлескім келеді.
Dialogue: 0,0:17:35.59,0:17:37.55,Default,,0,0,0,,Өтінемін, Нагумо?
Dialogue: 0,0:17:37.63,0:17:40.85,Default,,0,0,0,,Ең болмаса өзімді және достарымды қорғай аламын.
Dialogue: 0,0:17:40.93,0:17:42.43,Default,,0,0,0,,Иә
Dialogue: 0,0:17:42.51,0:17:43.60,Default,,0,0,0,,Нагумо
Dialogue: 0,0:17:47.27,0:17:48.10,Default,,0,0,0,,Иә
Dialogue: 0,0:17:51.19,0:17:53.11,Default,,0,0,0,,Таң атқанда жолға шығамыз.
Dialogue: 0,0:17:53.19,0:17:55.07,Default,,0,0,0,,А, рахмет, Нагумо-кун.
Dialogue: 0,0:17:55.15,0:17:56.40,Default,,0,0,0,,Уау
Dialogue: 0,0:17:56.49,0:17:59.78,Default,,0,0,0,,Ұлы лабиринт Мен оны міндетті түрде бағындырамын!
Dialogue: 0,0:17:59.87,0:18:00.70,Default,,0,0,0,,Әрине!
Dialogue: 0,0:18:00.78,0:18:02.20,Default,,0,0,0,,О
Dialogue: 0,0:18:02.28,0:18:05.45,Default,,0,0,0,,Хаджиме-сан, сен сенімдісің бе?
Dialogue: 0,0:18:05.54,0:18:08.54,Default,,0,0,0,,Әй, бұл тек кедергі болады деп ойладым.
Dialogue: 0,0:18:08.62,0:18:10.21,Default,,0,0,0,,Мені өзіңізбен бірге алыңыз
Dialogue: 0,0:18:10.29,0:18:13.55,Default,,0,0,0,,Біраз күшке ие болу жақсы идея деп ойлаңыз.
Dialogue: 0,0:18:13.63,0:18:16.30,Default,,0,0,0,,Хаджиме Қорқынышты адам
Dialogue: 0,0:18:16.38,0:18:21.09,Default,,0,0,0,,Сізден күткендей, Ұстаз, сіздің идеяларыңыз енді адам емес.
Dialogue: 0,0:18:21.18,0:18:22.89,Default,,0,0,0,,Иә?Не айтқың келеді?
Dialogue: 0,0:18:22.97,0:18:27.14,Default,,0,0,0,,Мен өзімнің сыныптастарымды ет қабырғалары мен жемқорлар ретінде пайдаланғым келеді.
Dialogue: 0,0:18:28.19,0:18:29.02,Default,,0,0,0,,Е...
Dialogue: 0,0:18:32.31,0:18:33.15,Default,,0,0,0,,Хаджиме
Dialogue: 0,0:18:36.44,0:18:37.74,Default,,0,0,0,,Аздап
Dialogue: 0,0:18:39.36,0:18:42.12,Default,,0,0,0,,Хаджиме-сан, ммм.
Dialogue: 0,0:18:42.20,0:18:43.95,Default,,0,0,0,,Ха... Хаджиме-кун
Dialogue: 0,0:18:44.03,0:18:45.08,Default,,0,0,0,,Уау
Dialogue: 0,0:18:45.16,0:18:47.12,Default,,0,0,0,,Мен де, ммм.
Dialogue: 0,0:18:47.20,0:18:50.12,Default,,0,0,0,,Ұстаз, сіз де сабан жеңіз.
Dialogue: 0,0:18:50.21,0:18:51.63,Default,,0,0,0,,Ах-нжа
Dialogue: 0,0:18:54.21,0:18:55.63,Default,,0,0,0,,Тек бір рет
Dialogue: 0,0:18:55.71,0:18:57.63,Default,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,0:18:57.71,0:19:02.64,Default,,0,0,0,,Неге, бұл атмосфера өте ыңғайсыз сезінеді.
Dialogue: 0,0:19:08.98,0:19:09.89,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:19:09.98,0:19:13.77,Default,,0,0,0,,Жоқ... жоқ, не айтып тұрсың!
Dialogue: 0,0:19:13.86,0:19:16.28,Default,,0,0,0,,Мен әдеттегідей тамақтанып жатырмын.
Dialogue: 0,0:19:16.36,0:19:18.61,Default,,0,0,0,,Айтқанда Хажименің дәмін татып көру
Dialogue: 0,0:19:18.69,0:19:20.70,Default,,0,0,0,,Мен... Мен мұны істеген жоқпын.
Dialogue: 0,0:19:20.78,0:19:23.66,Default,,0,0,0,,Олай десеңіз, Тио бұзық, солай ма?
Dialogue: 0,0:19:23.74,0:19:27.37,Default,,0,0,0,,Қарашы, намыстанып шанышқыңды жалап жатырсың.
Dialogue: 0,0:19:29.75,0:19:32.37,Default,,0,0,0,,Тио, мұны қазір тоқтат.
Dialogue: 0,0:19:32.46,0:19:34.42,Default,,0,0,0,,Менің ойымша, оған көмектесу мүмкін емес
Dialogue: 0,0:19:34.50,0:19:38.21,Default,,0,0,0,,Қожайын бәрібір мені ақырын сүймейді.
Dialogue: 0,0:19:38.30,0:19:39.80,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:19:39.88,0:19:44.26,Default,,0,0,0,,Ұстаз, мен сыйлық сұраймын.
Dialogue: 0,0:19:44.34,0:19:45.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:45.35,0:19:49.73,Default,,0,0,0,,Мен сені қорғағандықтан, Сенсей, саған сыйлық берсем қарсы болмайсың ба?
Dialogue: 0,0:19:49.81,0:19:50.89,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:50.98,0:19:51.89,Default,,0,0,0,,Бұл жасырын
Dialogue: 0,0:19:51.98,0:19:54.61,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:19:54.69,0:19:57.86,Default,,0,0,0,,Жоғарыда айтқанымдай, бұл менің мүмкіндігімде ғана.
Dialogue: 0,0:19:57.94,0:20:00.90,Default,,0,0,0,,Уайымдамаңыз, мен шектен шыққан ештеңе айтпаймын.
Dialogue: 0,0:20:01.61,0:20:03.95,Default,,0,0,0,,Мен сені бірінші рет кездестіргенімдей
Dialogue: 0,0:20:04.03,0:20:07.28,Default,,0,0,0,,Мен жай ғана сенің менің сабан есегімді мазақтағаныңды қалаймын.
Dialogue: 0,0:20:07.37,0:20:08.37,Default,,0,0,0,,Қабылданбады.
Dialogue: 0,0:20:08.45,0:20:12.41,Default,,0,0,0,,Неге... Менің ойымша, бұл күлкілі өтініш емес.
Dialogue: 0,0:20:12.50,0:20:15.17,Default,,0,0,0,,Сол кездегідей қара, қатты, қалың таяқпен.
Dialogue: 0,0:20:15.25,0:20:18.25,Default,,0,0,0,,Мен сенің менің сабан құлағыма енгеніңді қалаймын.
Dialogue: 0,0:20:18.34,0:20:21.55,Default,,0,0,0,,Жалған мәлімдемелерді қолданбаңыз!
Dialogue: 0,0:20:21.63,0:20:25.43,Default,,0,0,0,,Бірақ бұл жай ғана түсініспеушілік деп айта алмайсыз, солай емес пе?
Dialogue: 0,0:20:25.51,0:20:28.06,Default,,0,0,0,,Өтірік айтпайтыныңызға сенімдімін.
Dialogue: 0,0:20:28.14,0:20:30.22,Default,,0,0,0,,Бұл мені қатты шақтады~
Dialogue: 0,0:20:30.31,0:20:33.23,Default,,0,0,0,,Иә, Нагумо-кун, сен аяусыз едің ғой?
Dialogue: 0,0:20:33.31,0:20:37.36,Default,,0,0,0,,Хаджиме-сан, күткендей, бұл біраз түсінбеушілік...
Dialogue: 0,0:20:37.44,0:20:41.32,Default,,0,0,0,,Хаджиме Тионың өзгеруіне Хажиме себепші болды
Dialogue: 0,0:20:41.40,0:20:42.32,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:20:42.40,0:20:44.82,Default,,0,0,0,,На... Нагумо-кун
Dialogue: 0,0:20:44.91,0:20:47.82,Default,,0,0,0,,Тио-санға не істедің...
Dialogue: 0,0:20:57.42,0:20:58.34,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:20:59.09,0:21:04.51,Default,,0,0,0,,Жарайсың, Тио, саған дәм берейік.
Dialogue: 0,0:21:04.59,0:21:07.18,Default,,0,0,0,,Ол кезден де қаттырақ, жуанырақ
Dialogue: 0,0:21:07.26,0:21:10.51,Default,,0,0,0,,Ал, ауырлай түскен мақтаныш шедевр.
Dialogue: 0,0:21:10.60,0:21:12.68,Default,,0,0,0,,Жарайды... күте тұрыңыз, қожайын.
Dialogue: 0,0:21:12.77,0:21:14.14,Default,,0,0,0,,Жоғарыда айтқаным жай ғана...
Dialogue: 0,0:21:14.23,0:21:16.27,Default,,0,0,0,,Бұлай ұялмаңыз.
Dialogue: 0,0:21:17.23,0:21:20.77,Default,,0,0,0,,Есіңе сіңетін уақыт жоқ, Мен сені әп-сәтте өлтіремін.
Dialogue: 0,0:21:21.65,0:21:24.74,Default,,0,0,0,,Шебердің көзі байсалды~
Dialogue: 0,0:21:24.82,0:21:29.41,Default,,0,0,0,,Юэ Шиа Каори~ Мен қожайынымды тоқтаттым~!
Dialogue: 0,0:21:29.49,0:21:30.49,Default,,0,0,0,,Хмф!
Dialogue: 0,0:21:30.58,0:21:31.58,Default,,0,0,0,,Ах
Dialogue: 0,0:21:40.71,0:21:41.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:43.71,0:21:44.84,Default,,0,0,0,,Хажиме?
Dialogue: 0,0:21:49.01,0:21:50.05,Default,,0,0,0,,Хаджиме
Dialogue: 0,0:21:57.27,0:22:00.44,Default,,0,0,0,,Бүгін де ұзақ күн болатын сияқты.
Dialogue: 0,0:22:02.02,0:22:06.32,Default,,0,0,0,,Мен сапарымды тез аяқтап, Мюді алып кетуім керек.
Dialogue: 0,0:22:07.49,0:22:08.32,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:22:10.41,0:22:15.33,Default,,0,0,0,,♪～
Dialogue: 0,0:22:16.54,0:22:18.62,Default,,0,0,0,,Қайтадан екеуміз ғана қалдық~
Dialogue: 0,0:22:18.71,0:22:20.46,Default,,0,0,0,,Юэ әрқашан қулықпен жүреді
Dialogue: 0,0:22:35.06,0:22:36.48,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:22:44.07,0:22:46.49,Default,,0,0,0,,Жүр, Нагумо, ерте кетейік.
Dialogue: 0,0:22:46.57,0:22:49.11,Default,,0,0,0,,Ұлы лабиринтті міндетті түрде бағындырыңыз
Dialogue: 0,0:22:49.20,0:22:50.61,Default,,0,0,0,,Қолдарым шырылдап тұр
Dialogue: 0,0:22:51.70,0:22:53.12,Default,,0,0,0,,Сіз тым толқып тұрсыз.
Dialogue: 0,0:22:53.20,0:22:56.20,Default,,0,0,0,,Нагумо-сан, көмегіңіз үшін рахмет.
Dialogue: 0,0:22:56.29,0:22:57.12,Default,,0,0,0,,О
Dialogue: 0,0:22:57.20,0:22:59.92,Default,,0,0,0,,Корольдік капиталды бізге қалдыр.
Dialogue: 0,0:23:00.00,0:23:00.83,Default,,0,0,0,,О
Dialogue: 0,0:23:00.92,0:23:03.63,Default,,0,0,0,,үшінңыз аман болыңыздар.
Dialogue: 0,0:23:04.38,0:23:06.13,Default,,0,0,0,,Мұғалімдер де
Dialogue: 0,0:23:31.74,0:23:33.78,Default,,0,0,0,,Сонда барамыз ба?
Dialogue: 0,0:23:35.91,0:23:40.91,Default,,0,0,0,,～♪
