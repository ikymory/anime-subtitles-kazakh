Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.27,0:00:24.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:26.06,0:00:26.90,Default,,0,0,0,,Ах
Dialogue: 0,0:00:31.82,0:00:33.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:52.92,0:00:53.97,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:54.59,0:00:57.30,Default,,0,0,0,,Биыл да ыстық жаз басталғалы тұр еді.
Dialogue: 0,0:01:06.19,0:01:09.65,Default,,0,0,0,,Жастар сол сәт үшін жанын күйдіреді
Dialogue: 0,0:01:09.73,0:01:13.23,Default,,0,0,0,,Бір сәттік атақ үшін бәрін тәуекел ету...
Dialogue: 0,0:01:13.32,0:01:14.99,Default,,0,0,0,,Шектеу
Dialogue: 0,0:01:15.07,0:01:17.24,Default,,0,0,0,,Биыл жаз тағы да сондай ыстық...
Dialogue: 0,0:01:17.32,0:01:18.53,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:01:23.16,0:01:24.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:25.29,0:01:28.12,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:28.79,0:01:30.04,Default,,0,0,0,,(♪ «Twinkle, Twinkle, Little Star» әніне варияциялар»)
Dialogue: 0,0:01:30.54,0:01:32.50,Default,,0,0,0,,Футаба, кеттік
Dialogue: 0,0:01:32.59,0:01:33.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:34.67,0:01:35.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:49.90,0:01:52.98,Default,,0,0,0,,Соңында ол үш жыл орындықта қалды.
Dialogue: 0,0:01:55.28,0:01:56.82,Default,,0,0,0,,Я...
Dialogue: 0,0:01:59.41,0:02:00.66,Default,,0,0,0,,Иә? Ха!
Dialogue: 0,0:02:04.24,0:02:06.16,Default,,0,0,0,,Қандай... қандай да бір ырым?
Dialogue: 0,0:02:06.79,0:02:07.96,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:02:08.29,0:02:09.29,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:02:09.37,0:02:10.58,Default,,0,0,0,,Уақыт таяп қалды
Dialogue: 0,0:02:10.67,0:02:12.50,Default,,0,0,0,,Бүгін де көңілді болайық
Dialogue: 0,0:02:12.59,0:02:15.21,Default,,0,0,0,,Иә, бәріміз, кеттік!
Dialogue: 0,0:02:15.30,0:02:16.13,Default,,0,0,0,,...
Dialogue: 0,0:02:16.21,0:02:17.88,Default,,0,0,0,,Біз мұны істейміз бе?
Dialogue: 0,0:02:17.97,0:02:19.76,Default,,0,0,0,,Ватари Шешуші позамен абай болыңыз
Dialogue: 0,0:02:19.84,0:02:22.05,Default,,0,0,0,,Уссу (Цукидате) Онагава қол ұстасып тұр.
Dialogue: 0,0:02:22.14,0:02:24.47,Default,,0,0,0,,Уайымдама~ (Ватари) Қолым шырылдап тұр.
Dialogue: 0,0:02:24.56,0:02:27.10,Default,,0,0,0,,Дыбысты жай ғана шығарып қоймай, оны созуды ұмытпаңыз.
Dialogue: 0,0:02:27.18,0:02:28.02,Default,,0,0,0,,...
Dialogue: 0,0:02:28.10,0:02:32.19,Default,,0,0,0,,(Әрекет кезіндегі музыка)
Dialogue: 0,0:02:32.27,0:02:33.27,Default,,0,0,0,,Музыка?
Dialogue: 0,0:03:00.05,0:03:04.05,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:03:10.81,0:03:13.77,Default,,0,0,0,,Мияги префектурасы орта мектебінің жан-жақты спорттық турнирі
Dialogue: 0,0:03:13.86,0:03:16.07,Default,,0,0,0,,Ерлердің көркем гимнастикасы
Dialogue: 0,0:03:16.15,0:03:18.78,Default,,0,0,0,,Көркем гимнастика ерлер үшін де бар.
Dialogue: 0,0:03:28.62,0:03:29.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:31.41,0:03:32.25,Default,,0,0,0,,Ах
Dialogue: 0,0:03:38.63,0:03:40.63,Default,,0,0,0,,Бұрынғы адамдар
Dialogue: 0,0:03:38.63,0:03:40.63,Default,,0,0,0,,№ 9 Жеке мектеп -
Dialogue: 0,0:03:40.72,0:03:43.22,Default,,0,0,0,,Сошуқан орта мектебі
Dialogue: 0,0:03:40.72,0:03:43.22,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:03:43.22,0:03:44.64,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:03:52.73,0:03:53.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:55.52,0:03:56.61,Default,,0,0,0,,(Барлығының дем шығару дыбысы)
Dialogue: 0,0:04:02.40,0:04:04.03,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:04:09.45,0:04:15.08,Default,,0,0,0,,♪～
Dialogue: 0,0:07:12.68,0:07:15.35,Default,,0,0,0,,～♪
Dialogue: 0,0:07:15.43,0:07:19.60,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:07:20.23,0:07:21.35,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:07:21.44,0:07:22.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:22.77,0:07:25.44,Default,,0,0,0,,Уау... керемет!
Dialogue: 0,0:07:27.19,0:07:29.82,Default,,0,0,0,,Сошукан орта мектебі…
Dialogue: 0,0:07:35.87,0:07:37.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:39.79,0:07:42.42,Default,,0,0,0,,Неліктен балл төмен?
Dialogue: 0,0:07:42.50,0:07:44.79,Default,,0,0,0,,Жоқ, бұл қымбат.
Dialogue: 0,0:07:44.88,0:07:46.84,Default,,0,0,0,,Төрт адам 15 ұпайды қалай жинай алады?
Dialogue: 0,0:07:46.92,0:07:49.21,Default,,0,0,0,,Не? Ао жоғары?
Dialogue: 0,0:07:49.30,0:07:50.42,Default,,0,0,0,,Мен көп жұмыс істеймін.
Dialogue: 0,0:07:50.51,0:07:52.84,Default,,0,0,0,,Бірақ сіз жеңіліп жатырсыз, солай ма?
Dialogue: 0,0:07:52.93,0:07:54.97,Default,,0,0,0,,Бұл сіз ерлер көркем гимнастикасымен бірінші рет айналысасыз ба?
Dialogue: 0,0:07:55.05,0:07:55.97,Default,,0,0,0,,Ах… Хаа
Dialogue: 0,0:07:56.05,0:07:58.89,Default,,0,0,0,,Көркем гимнастикадан ерлер арасындағы командалық жарыс
Dialogue: 0,0:07:58.97,0:08:00.56,Default,,0,0,0,,Мұны алты адам орындайды.
Dialogue: 0,0:08:00.64,0:08:02.69,Default,,0,0,0,,Тіпті 4 адам қатыса алады.
Dialogue: 0,0:08:02.77,0:08:05.94,Default,,0,0,0,,1,5 ұпай әр адамға шегеріледі.
Dialogue: 0,0:08:06.02,0:08:07.82,Default,,0,0,0,,Бұл үлкен ме?
Dialogue: 0,0:08:07.90,0:08:09.78,Default,,0,0,0,,Өйткені бұл тамаша балл 20?
Dialogue: 0,0:08:10.49,0:08:13.95,Default,,0,0,0,,Ерлер көркем гимнастикасы бойынша ұпай жинау шегерім әдісіне негізделген.
Dialogue: 0,0:08:14.03,0:08:17.03,Default,,0,0,0,,Мен қателескен сайын мінсіз баллдан шегеремін.
Dialogue: 0,0:08:17.12,0:08:19.41,Default,,0,0,0,,Демек, бұл 15 ұпай...
Dialogue: 0,0:08:20.20,0:08:22.21,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:08:23.29,0:08:26.25,Default,,0,0,0,,Сендай Токуо аймақтық турнирде қарсылас бола ма?
Dialogue: 0,0:08:26.33,0:08:28.59,Default,,0,0,0,,Қызық сияқты~
Dialogue: 0,0:08:28.67,0:08:30.76,Default,,0,0,0,,Сіз шынымен Ао орта мектебіне көңіл бөлесіз бе?
Dialogue: 0,0:08:32.17,0:08:33.42,Default,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:08:34.05,0:08:37.39,Default,,0,0,0,,Осыдан кейін марапаттау рәсімі өтеді.
Dialogue: 0,0:08:37.47,0:08:39.10,Default,,0,0,0,,Ойыншылар, нұсқауларды орындаңыз -
Dialogue: 0,0:08:39.10,0:08:41.02,Default,,0,0,0,,Ойыншылар, нұсқауларды орындаңыз -
Dialogue: 0,0:08:39.10,0:08:41.02,Default,,0,0,0,,Ми~сапон~ кеттік~
Dialogue: 0,0:08:41.02,0:08:41.10,Default,,0,0,0,,Ми~сапон~ кеттік~
Dialogue: 0,0:08:41.10,0:08:41.97,Default,,0,0,0,,Ми~сапон~ Кеттік~
Dialogue: 0,0:08:41.10,0:08:41.97,Default,,0,0,0,,Аренаға жиналыңыз
Dialogue: 0,0:08:41.97,0:08:43.73,Default,,0,0,0,,Аренаға жиналыңыз
Dialogue: 0,0:08:45.98,0:08:50.98,Default,,0,0,0,,♪～
Dialogue: 0,0:10:10.23,0:10:15.23,Default,,0,0,0,,～♪
Dialogue: 0,0:10:15.99,0:10:18.03,Default,,0,0,0,,Ерлерге арналған көркем гимнастика?
Dialogue: 0,0:10:18.11,0:10:20.49,Default,,0,0,0,,Хмм, бұл солай.
Dialogue: 0,0:10:20.57,0:10:21.99,Default,,0,0,0,,Арргх!
Dialogue: 0,0:10:22.07,0:10:25.83,Default,,0,0,0,,Мен адам денесінің бұлай қозғалғанын ешқашан көрген емеспін.
Dialogue: 0,0:10:25.91,0:10:27.04,Default,,0,0,0,,Я~
Dialogue: 0,0:10:27.12,0:10:30.29,Default,,0,0,0,,Ойлап қарасам, бұл Тохоку аймағында өте танымал.
Dialogue: 0,0:10:30.37,0:10:32.67,Default,,0,0,0,,Мен мұны бұрын бір жерден естігенмін.
Dialogue: 0,0:10:34.05,0:10:39.38,Default,,0,0,0,,Менің ойымша, Ао орта мектебінің балалары бәрінен де керемет болды.
Dialogue: 0,0:10:39.47,0:10:41.14,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:10:39.47,0:10:41.14,Default,,0,0,0,,(қолды біріктіру дыбысы)
Dialogue: 0,0:10:41.22,0:10:43.93,Default,,0,0,0,,Ағаңның гёзасы үлкен емес пе?
Dialogue: 0,0:10:44.01,0:10:46.35,Default,,0,0,0,,Шо-чан, мен бүгін ойыннан шаршадым.
Dialogue: 0,0:10:46.43,0:10:48.60,Default,,0,0,0,,Ол алмастырғыш болса да? (Футаба) Ух...
Dialogue: 0,0:10:49.48,0:10:53.06,Default,,0,0,0,,Нәтиже көңіл көншітпейтін болды, бірақ бәрібір клубтың қызметі тынышталды.
Dialogue: 0,0:10:53.15,0:10:54.86,Default,,0,0,0,,Емтихан тапсыру ғана қалды.
Dialogue: 0,0:10:54.94,0:10:56.98,Default,,0,0,0,,Сіз қайда баратыныңызды әлі шештіңіз бе?
Dialogue: 0,0:10:57.07,0:11:00.57,Default,,0,0,0,,Хм, егер сіз менен қазіргі бағаларыммен бара аламын ба деп сұрасаңыз...
Dialogue: 0,0:11:00.66,0:11:01.91,Default,,0,0,0,,Қайда барғыңыз келеді?
Dialogue: 0,0:11:01.99,0:11:03.82,Default,,0,0,0,,Иә? Сіз қайда барғыңыз келеді?
Dialogue: 0,0:11:03.91,0:11:06.91,Default,,0,0,0,,Иә, Шотаро қайда барғысы келеді.
Dialogue: 0,0:11:06.99,0:11:08.62,Default,,0,0,0,,Не істегіңіз келетінін жақсырақ орындаңыз
Dialogue: 0,0:11:08.70,0:11:11.00,Default,,0,0,0,,Мен мектепке барғым келмейді десем ше?
Dialogue: 0,0:11:11.08,0:11:13.08,Default,,0,0,0,,Мұқият ойлан
Dialogue: 0,0:11:14.13,0:11:16.09,Default,,0,0,0,,Мен не істегім келеді...
Dialogue: 0,0:11:28.10,0:11:31.77,Default,,0,0,0,,Мен не істегім келеді Мен қайда барғым келеді
Dialogue: 0,0:11:31.85,0:11:33.94,Default,,0,0,0,,(Футабаның жүрек соғысы)
Dialogue: 0,0:11:49.87,0:11:52.12,Default,,0,0,0,,Иә... Иә?
Dialogue: 0,0:11:52.21,0:11:55.58,Default,,0,0,0,,Шо-чан, тезірек бармасаң, кіру рәсіміне кешігіп қаласың.
Dialogue: 0,0:11:55.67,0:11:57.00,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:11:57.09,0:11:59.30,Default,,0,0,0,,Міне! Бұл жаман мінез!
Dialogue: 0,0:12:12.14,0:12:15.81,Default,,0,0,0,,Біз кез келген нәрсе болуы мүмкін әлемде өмір сүреміз...
Dialogue: 0,0:12:15.90,0:12:20.32,Default,,0,0,0,,Өз қолыңмен жасайтын болашағың анық.
Dialogue: 0,0:12:21.15,0:12:23.86,Default,,0,0,0,,Мақсат: Кемінде 2 жаңа мүше алыңыз!
Dialogue: 0,0:12:23.95,0:12:25.03,Default,,0,0,0,,...
Dialogue: 0,0:12:25.11,0:12:27.03,Default,,0,0,0,,Сіз мұны шынымен жасайсыз ба? Шичигахама
Dialogue: 0,0:12:27.12,0:12:29.16,Default,,0,0,0,,Сабақ басталғаннан кейін
Dialogue: 0,0:12:29.24,0:12:31.87,Default,,0,0,0,,Тұрмысы жақсыларды басқа бөлімшелер алып кетеді.
Dialogue: 0,0:12:31.95,0:12:33.58,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:12:33.66,0:12:36.04,Default,,0,0,0,,Спортпен айналысып, менің орта мектебіме келетіндер
Dialogue: 0,0:12:36.13,0:12:39.00,Default,,0,0,0,,Әдетте бейсболға немесе футбол клубына баратыныңызды шешіп қойған.
Dialogue: 0,0:12:39.09,0:12:42.72,Default,,0,0,0,,Соңғы кезде баскетбол, волейбол үйірмелері күшейіп келеді.
Dialogue: 0,0:12:42.80,0:12:43.88,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:43.97,0:12:45.51,Default,,0,0,0,,Негативтер жоқ!
Dialogue: 0,0:12:45.59,0:12:47.22,Default,,0,0,0,,Сондықтан мен Интер-Хайға бардым.
Dialogue: 0,0:12:47.30,0:12:49.81,Default,,0,0,0,,Ао орта мектебінде ұлдарға арналған көркем гимнастика үйірмесі бар.
Dialogue: 0,0:12:49.89,0:12:51.93,Default,,0,0,0,,Мен сізге көрсетуім керек, солай ма?
Dialogue: 0,0:12:52.02,0:12:55.14,Default,,0,0,0,,Ол үшін бізге алты мүше өте қажет.
Dialogue: 0,0:12:55.23,0:12:57.61,Default,,0,0,0,,Usu! (Онагава) Иә, бірақ~
Dialogue: 0,0:12:59.40,0:13:00.27,Default,,0,0,0,,Иә
Dialogue: 0,0:13:00.36,0:13:02.69,Default,,0,0,0,,Не? Бұл менеджер қандай?
Dialogue: 0,0:13:02.78,0:13:04.70,Default,,0,0,0,,Квота бір адамға 100 билет
Dialogue: 0,0:13:04.78,0:13:05.86,Default,,0,0,0,,Мүлдем (Онагава) Иә?
Dialogue: 0,0:13:05.95,0:13:08.20,Default,,0,0,0,,Менде ғана көп бар ма?
Dialogue: 0,0:13:08.28,0:13:09.87,Default,,0,0,0,,Үйге келгенде не істейсің? (Ер студент) Бір жерге келгіңіз келе ме?
Dialogue: 0,0:13:09.95,0:13:12.70,Default,,0,0,0,,Әй, міне, осында, кеттік!
Dialogue: 0,0:13:12.79,0:13:16.08,Default,,0,0,0,,О... эй! Сіздің денеңіз әдемі...
Dialogue: 0,0:13:16.17,0:13:18.63,Default,,0,0,0,,Дәл менің капитаным
Dialogue: 0,0:13:18.71,0:13:22.21,Default,,0,0,0,,Бір айта бастасаң, тоқтай алмайсың, кәдімгі нәрсе емес пе?
Dialogue: 0,0:13:22.30,0:13:24.13,Default,,0,0,0,,Олай болса, біз де барамыз ба?
Dialogue: 0,0:13:24.22,0:13:25.05,Default,,0,0,0,,...
Dialogue: 0,0:13:25.13,0:13:27.26,Default,,0,0,0,,Бұл не? (Ер оқушы) Бұл ерлердің көркем гимнастикасы.
Dialogue: 0,0:13:27.26,0:13:28.09,Default,,0,0,0,,Бұл не? (Ер оқушы) Ерлер көркем гимнастикасы.
Dialogue: 0,0:13:27.26,0:13:28.09,Default,,0,0,0,,Ах
Dialogue: 0,0:13:28.18,0:13:29.89,Default,,0,0,0,,Мен қатты толқып тұрмын!
Dialogue: 0,0:13:29.97,0:13:31.14,Default,,0,0,0,,Үйірме жұмыстарымен не істейсіз?
Dialogue: 0,0:13:31.22,0:13:32.10,Default,,0,0,0,,I Кэндо клубы
Dialogue: 0,0:13:34.06,0:13:36.64,Default,,0,0,0,,Сізге ерлердің көркем гимнастикасы қалай ұнайды?
Dialogue: 0,0:13:36.73,0:13:40.52,Default,,0,0,0,,Үздіксіз кері айналдыру керемет емес пе? мыс? бірге
Dialogue: 0,0:13:40.61,0:13:42.82,Default,,0,0,0,,Онагава Ерлерді жалдаңыз!
Dialogue: 0,0:13:42.90,0:13:44.15,Default,,0,0,0,,Теме және т.б.
Dialogue: 0,0:13:44.24,0:13:47.95,Default,,0,0,0,,Сіз менің ағамның парақшасын қабылдай алмайсыз ба? А?
Dialogue: 0,0:13:48.03,0:13:49.16,Default,,0,0,0,,Геп (ватари)
Dialogue: 0,0:13:49.24,0:13:52.37,Default,,0,0,0,,(Ao High клубының мүшелерін қабылдау дауыстары)
Dialogue: 0,0:13:52.45,0:13:56.62,Default,,0,0,0,,А... а... а...
Dialogue: 0,0:13:57.25,0:13:58.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:58.71,0:14:02.17,Default,,0,0,0,,Не... Не істеуім керек? Міне... Мен психикалық тұрғыдан дайынмын.
Dialogue: 0,0:14:02.25,0:14:03.96,Default,,0,0,0,,Мен үйірмеге қосылғым келеді.
Dialogue: 0,0:14:04.05,0:14:05.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:05.17,0:14:07.97,Default,,0,0,0,,Не? (Цукидате) Мен... Енді ше?
Dialogue: 0,0:14:08.05,0:14:11.30,Default,,0,0,0,,Мен ерлер арасындағы көркем гимнастика үйірмесіне қатысқым келеді.
Dialogue: 0,0:14:15.43,0:14:16.68,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:20.65,0:14:22.57,Default,,0,0,0,,Міне, келді!
Dialogue: 0,0:14:22.65,0:14:24.65,Default,,0,0,0,,Келгеніңізге рахмет! (Онагава) Шынымен!
Dialogue: 0,0:14:24.73,0:14:26.90,Default,,0,0,0,,Қош келдіңіз! (Ватари) Танысқаныма қуаныштымын!
Dialogue: 0,0:14:28.40,0:14:31.32,Default,,0,0,0,,Оған жету қиындай түсті
Dialogue: 0,0:14:34.49,0:14:37.37,Default,,0,0,0,,Хмм... Ммм...
Dialogue: 0,0:14:37.45,0:14:38.29,Default,,0,0,0,,Ах
Dialogue: 0,0:14:41.67,0:14:43.88,Default,,0,0,0,,Мисато… Йошия
Dialogue: 0,0:14:44.55,0:14:46.30,Default,,0,0,0,,Не болды? Курикома
Dialogue: 0,0:14:47.26,0:14:48.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:48.88,0:14:52.22,Default,,0,0,0,,37-ші жасөспірімдер арасындағы көркем гимнастикадан ерлер арасындағы республикалық турнир
Dialogue: 0,0:14:52.30,0:14:55.72,Default,,0,0,0,,Жеке есепте екінші орын алған Йошия Мисато
Dialogue: 0,0:14:55.81,0:14:57.06,Default,,0,0,0,,Не? Уау...
Dialogue: 0,0:14:57.14,0:15:00.85,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,0:15:00.94,0:15:03.36,Default,,0,0,0,,Сіз оны бұрын көрдім деп ойлаған кезде
Dialogue: 0,0:15:03.44,0:15:06.32,Default,,0,0,0,,Мисато? Ол Натори 4-ші орта мектебінің эйсе болды ма?
Dialogue: 0,0:15:06.40,0:15:08.32,Default,,0,0,0,,Бірақ сен менің орта мектебіме не үшін келдің?
Dialogue: 0,0:15:08.40,0:15:11.32,Default,,0,0,0,,Дұрыс, неге беделді мектеп...
Dialogue: 0,0:15:11.41,0:15:13.12,Default,,0,0,0,,Онагава! (Онагава) Эй!
Dialogue: 0,0:15:13.20,0:15:16.83,Default,,0,0,0,,Темее... Жаңа ғана Ао Хайды мазақ қылдың.
Dialogue: 0,0:15:16.91,0:15:18.91,Default,,0,0,0,,Ой, кешіріңіз капитан, сіздің бетіңіз қорқынышты көрінеді...
Dialogue: 0,0:15:18.91,0:15:20.66,Default,,0,0,0,,Ой, кешіріңіз капитан, сіздің жүзіңіз қорқынышты...
Dialogue: 0,0:15:18.91,0:15:20.66,Default,,0,0,0,,Менің қабілетім бар, бірақ...
Dialogue: 0,0:15:20.75,0:15:23.58,Default,,0,0,0,,Аға өткен жылғы префектуралық турнир
Dialogue: 0,0:15:24.25,0:15:29.30,Default,,0,0,0,,Сіз басын тіккен кезде, сіз сәтті болған сияқтысыз, бірақ шынтағыңызды түсірдіңіз, солай ма?
Dialogue: 0,0:15:29.38,0:15:31.22,Default,,0,0,0,,0,05 ұпай шегерім
Dialogue: 0,0:15:31.30,0:15:33.34,Default,,0,0,0,,Уф... (Ватари)...О, жоқ!
Dialogue: 0,0:15:33.43,0:15:34.55,Default,,0,0,0,,Қарт адамдарға
Dialogue: 0,0:15:34.64,0:15:36.35,Default,,0,0,0,,Қозғалысы бар екі орын
Dialogue: 0,0:15:36.43,0:15:38.47,Default,,0,0,0,,Мен тербеліп, тепе-теңдікті жоғалттым.
Dialogue: 0,0:15:38.56,0:15:40.64,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:15:40.73,0:15:43.02,Default,,0,0,0,,Жарайды, Ватари, жарайды.
Dialogue: 0,0:15:43.77,0:15:45.56,Default,,0,0,0,,Сіздің де бақылау қабілетіңіз бар сияқты.
Dialogue: 0,0:15:45.65,0:15:47.69,Default,,0,0,0,,Бізде тек топтар бар, солай ма?
Dialogue: 0,0:15:47.78,0:15:49.36,Default,,0,0,0,,Менің қалағаным осы
Dialogue: 0,0:15:49.44,0:15:51.74,Default,,0,0,0,,Уша! Қазір 5 адам
Dialogue: 0,0:15:51.82,0:15:53.74,Default,,0,0,0,,Интер-Хайға дейін бір ғана адам қалды!
Dialogue: 0,0:15:53.82,0:15:56.78,Default,,0,0,0,,Уф... осы супер жаңа студенттен кейін...
Dialogue: 0,0:15:56.87,0:15:59.54,Default,,0,0,0,,Бірдеңе айту қиын, не істеуім керек...
Dialogue: 0,0:15:59.62,0:16:01.66,Default,,0,0,0,,Мен Шусакуға хабарлаймын (Шичигахама) О, сұрама.
Dialogue: 0,0:16:04.83,0:16:06.96,Default,,0,0,0,,Иә? (Футаба) А, о... та!
Dialogue: 0,0:16:07.04,0:16:08.17,Default,,0,0,0,,tte…
Dialogue: 0,0:16:10.09,0:16:10.92,Default,,0,0,0,,Ах... м...
Dialogue: 0,0:16:10.92,0:16:12.51,Default,,0,0,0,,Ах... м...
Dialogue: 0,0:16:10.92,0:16:12.51,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:16:13.22,0:16:15.76,Default,,0,0,0,,Күдікті адам табылды (Футаба) Иә? Жоқ...
Dialogue: 0,0:16:15.84,0:16:17.97,Default,,0,0,0,,Не болды? Курикома
Dialogue: 0,0:16:18.06,0:16:20.18,Default,,0,0,0,,Ах... м... (Ватари) Качикоми?
Dialogue: 0,0:16:20.27,0:16:22.94,Default,,0,0,0,,А... Мен күдікті адам емеспін.
Dialogue: 0,0:16:23.02,0:16:24.19,Default,,0,0,0,,Хмм?
Dialogue: 0,0:16:24.27,0:16:27.06,Default,,0,0,0,,Мен… Мен, бұл…
Dialogue: 0,0:16:27.15,0:16:29.27,Default,,0,0,0,,Кез келген жағдайда (Цукидате) Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:16:29.36,0:16:31.78,Default,,0,0,0,,Мен көршілес өткен жылы өткен префектуралық турнирді тамашалап отырдым.
Dialogue: 0,0:16:31.86,0:16:34.36,Default,,0,0,0,,Клубқа қайта қосылғысы келетіндер бар ма?
Dialogue: 0,0:16:34.45,0:16:36.74,Default,,0,0,0,,Не? О, мм...
Dialogue: 0,0:16:36.82,0:16:38.78,Default,,0,0,0,,Жарайсыңдар! Сіз де қарап шығуыңыз керек
Dialogue: 0,0:16:38.87,0:16:42.12,Default,,0,0,0,,Иә! А... иә
Dialogue: 0,0:16:44.58,0:16:47.92,Default,,0,0,0,,Олай болса, өзімді тағы да таныстырып өтейін.
Dialogue: 0,0:16:48.00,0:16:50.92,Default,,0,0,0,,3 курс капитан Масамүнэ Шичигахама.
Dialogue: 0,0:16:52.05,0:16:55.55,Default,,0,0,0,,Вице-капитан Кейсуке Цукидате 3 курс студенті Құрметпен
Dialogue: 0,0:16:56.76,0:16:59.30,Default,,0,0,0,,3 курс Нагайоши Онагава Танысқаныма қуаныштымын
Dialogue: 0,0:16:59.89,0:17:01.52,Default,,0,0,0,,2 курс Котаро Ватари
Dialogue: 0,0:17:01.60,0:17:03.10,Default,,0,0,0,,Менің атым Йошия Мисато.
Dialogue: 0,0:17:03.18,0:17:04.64,Default,,0,0,0,,Бұл Шотаро Футаба!
Dialogue: 0,0:17:04.73,0:17:07.56,Default,,0,0,0,,Бұл Мисатоның бірінші күні, бірақ ол сізге жаттығуға мүмкіндік береді.
Dialogue: 0,0:17:07.65,0:17:08.48,Default,,0,0,0,,Иә (Футаба) Иә?
Dialogue: 0,0:17:08.56,0:17:09.65,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:09.73,0:17:12.11,Default,,0,0,0,,Экскурсия тек атмосферамен танысу.
Dialogue: 0,0:17:12.19,0:17:13.03,Default,,0,0,0,,Иә
Dialogue: 0,0:17:13.11,0:17:14.74,Default,,0,0,0,,Еңбегіңізге рахмет (Шичигахама) Уссу!
Dialogue: 0,0:17:14.82,0:17:16.03,Default,,0,0,0,,Сәлем (Ватари) Чихассу!
Dialogue: 0,0:17:16.11,0:17:18.57,Default,,0,0,0,,Сәлем (Футаба) Ах... Сәлем.
Dialogue: 0,0:17:18.66,0:17:22.45,Default,,0,0,0,,Мисато-кун, жаңа мүше және гастрольде болған Футаба-кун.
Dialogue: 0,0:17:22.54,0:17:26.04,Default,,0,0,0,,Бұл Шусаку Шида, ерлер арасындағы көркем гимнастика үйірмесінің директоры.
Dialogue: 0,0:17:26.12,0:17:29.38,Default,,0,0,0,,Менеджер 2 курс Асао Курикома
Dialogue: 0,0:17:29.46,0:17:31.63,Default,,0,0,0,,Екеуіңмен танысқаныма қуаныштымын.
Dialogue: 0,0:17:31.71,0:17:37.51,Default,,0,0,0,,１ ２ １ ２…
Dialogue: 0,0:17:44.22,0:17:47.48,Default,,0,0,0,,Не... бұл ерекше. Жылыту жаттығуы
Dialogue: 0,0:17:47.56,0:17:50.06,Default,,0,0,0,,Бұл оқшаулау деп аталады.
Dialogue: 0,0:17:50.15,0:17:51.52,Default,,0,0,0,,Сіздің денеңіз өте жұмсақ.
Dialogue: 0,0:17:51.61,0:17:53.07,Default,,0,0,0,,Не? солай ма? (Цукидате) Иә.
Dialogue: 0,0:17:53.15,0:17:55.57,Default,,0,0,0,,Көркем гимнастикаға жақсы
Dialogue: 0,0:17:57.82,0:17:59.03,Default,,0,0,0,,Бұрынғы спорт туралы не деуге болады?
Dialogue: 0,0:17:59.11,0:18:01.74,Default,,0,0,0,,Жүзу, футбол және кішкене бейсбол
Dialogue: 0,0:18:01.83,0:18:03.41,Default,,0,0,0,,Аа, дұрыс шығар.
Dialogue: 0,0:18:03.49,0:18:07.50,Default,,0,0,0,,Жүзудегі бүкіл дене жаттығулары және футболдағы дене тепе-теңдігі
Dialogue: 0,0:18:07.58,0:18:09.83,Default,,0,0,0,,Бейсболдың күші мен ептілігі
Dialogue: 0,0:18:09.92,0:18:12.04,Default,,0,0,0,,Барлығын көркем гимнастикада қолдануға болады
Dialogue: 0,0:18:12.13,0:18:13.42,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:14.21,0:18:16.01,Default,,0,0,0,,Олай болса, Мисато, келесі кезекте құлап жатыр.
Dialogue: 0,0:18:16.09,0:18:16.92,Default,,0,0,0,,Иә
Dialogue: 0,0:18:17.01,0:18:19.13,Default,,0,0,0,,Мен оның құлап жатқанына сенімдімін ...
Dialogue: 0,0:18:19.22,0:18:23.14,Default,,0,0,0,,Еденде немесе төсеніште секіруді немесе айналдыруды қамтитын әдіс.
Dialogue: 0,0:18:27.85,0:18:30.10,Default,,0,0,0,,Ху~ Эйс күткендей
Dialogue: 0,0:18:30.65,0:18:31.48,Default,,0,0,0,,Иә
Dialogue: 0,0:18:31.56,0:18:35.32,Default,,0,0,0,,Мисато-кун рондартодан кері сальто
Dialogue: 0,0:18:35.32,0:18:35.69,Default,,0,0,0,,Мисато-кун рондартодан кері сальто
Dialogue: 0,0:18:35.32,0:18:35.69,Default,,0,0,0,,О
Dialogue: 0,0:18:35.69,0:18:35.78,Default,,0,0,0,,О
Dialogue: 0,0:18:35.78,0:18:36.32,Default,,0,0,0,,О
Dialogue: 0,0:18:35.78,0:18:36.32,Default,,0,0,0,,Бір жарым бұрылу, одан кейін алға сальто
Dialogue: 0,0:18:36.32,0:18:39.24,Default,,0,0,0,,Бір жарым бұрылу, одан кейін алға сальто
Dialogue: 0,0:18:39.91,0:18:40.91,Default,,0,0,0,,Иә (Онагава) О
Dialogue: 0,0:18:49.71,0:18:50.83,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:00.34,0:19:01.51,Default,,0,0,0,,Я...
Dialogue: 0,0:19:03.35,0:19:04.60,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:19:04.68,0:19:07.56,Default,,0,0,0,,Футаба-кун, көлденең тепе-теңдікті де қолданып көрейік.
Dialogue: 0,0:19:07.64,0:19:09.14,Default,,0,0,0,,А... иә!
Dialogue: 0,0:19:09.23,0:19:11.02,Default,,0,0,0,,Жақсы дене қалпы.
Dialogue: 0,0:19:11.10,0:19:13.19,Default,,0,0,0,,Сіз жақсы нәрсеге қарап тұрсыз.
Dialogue: 0,0:19:13.27,0:19:15.69,Default,,0,0,0,,Мисато-кун да жақсы, бірақ...
Dialogue: 0,0:19:18.78,0:19:20.53,Default,,0,0,0,,Менің өзегім жақсы.
Dialogue: 0,0:19:20.61,0:19:22.91,Default,,0,0,0,,Бұл жақсы сәйкес болуы мүмкін.
Dialogue: 0,0:19:22.99,0:19:26.33,Default,,0,0,0,,Сіз оған сәйкессіз бе, жоқ па маңызды, бірақ көңіл көтеру - ең жақсысы.
Dialogue: 0,0:19:26.41,0:19:28.37,Default,,0,0,0,,Менің әйелім де көп айтады (Курикома) Иә, иә.
Dialogue: 0,0:19:28.45,0:19:30.96,Default,,0,0,0,,Ха...ха, бұл сіздің әйеліңіз бе?
Dialogue: 0,0:19:31.04,0:19:33.67,Default,,0,0,0,,Угггг... Аа... (Шичигахама) Қалайсың? Қалыңыз қалай?
Dialogue: 0,0:19:33.75,0:19:36.55,Default,,0,0,0,,Иә, дұрыс...
Dialogue: 0,0:19:36.63,0:19:39.01,Default,,0,0,0,,Мен әлі де сенімді емеспін
Dialogue: 0,0:19:39.09,0:19:41.22,Default,,0,0,0,,Сізді көркем гимнастика әрқашан қызықтырды ма?
Dialogue: 0,0:19:41.97,0:19:45.26,Default,,0,0,0,,Өткен жылы мен үлкендерімнің ойынын бірінші рет көрдім.
Dialogue: 0,0:19:45.35,0:19:47.39,Default,,0,0,0,,Ойыннан ұтылғаның ұят
Dialogue: 0,0:19:47.47,0:19:49.56,Default,,0,0,0,,Жоқ... жоқ! Керемет болды!
Dialogue: 0,0:19:49.64,0:19:52.69,Default,,0,0,0,,Биікке секіру және жылдам қозғалу
Dialogue: 0,0:19:52.77,0:19:54.31,Default,,0,0,0,,Мен шынымен таң қалдым.
Dialogue: 0,0:19:54.40,0:19:58.90,Default,,0,0,0,,Сонымен, менің аға буындарым кері айналдыру жасады... және мен олардың барлығының кері бұрылып жатқанын көрдім.
Dialogue: 0,0:19:58.98,0:20:00.82,Default,,0,0,0,,Керемет нәрсе.
Dialogue: 0,0:20:00.90,0:20:03.74,Default,,0,0,0,,Мен де солай істей алсам ғой.
Dialogue: 0,0:20:04.49,0:20:05.57,Default,,0,0,0,,Ах
Dialogue: 0,0:20:05.66,0:20:07.41,Default,,0,0,0,,Ал, кері айналдырып көрейік.
Dialogue: 0,0:20:07.49,0:20:09.33,Default,,0,0,0,,Иә! Сонымен... кенеттен солай
Dialogue: 0,0:20:09.41,0:20:11.58,Default,,0,0,0,,Жарайды. Менімен жүр. (Футаба) А?
Dialogue: 0,0:20:12.96,0:20:15.88,Default,,0,0,0,,Тыңда, денеңді қағып ал.
Dialogue: 0,0:20:15.96,0:20:18.30,Default,,0,0,0,,Төменгі арқам дірілдеп, аяғым дірілдеп тұр!
Dialogue: 0,0:20:18.38,0:20:20.21,Default,,0,0,0,,Ақырында, қолым қысылып қалды! тто
Dialogue: 0,0:20:20.30,0:20:21.22,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:20:21.30,0:20:23.26,Default,,0,0,0,,Бұл мағынасы жоқ.
Dialogue: 0,0:20:23.34,0:20:25.55,Default,,0,0,0,,Шынымен бе? Тек көріңіз
Dialogue: 0,0:20:25.64,0:20:27.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:27.97,0:20:30.06,Default,,0,0,0,,Ху (Футаба) Иә, бұл...
Dialogue: 0,0:20:30.14,0:20:31.18,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:20:31.27,0:20:32.77,Default,,0,0,0,,Кеудеңізді көбірек қатайтыңыз
Dialogue: 0,0:20:32.85,0:20:34.85,Default,,0,0,0,,А... аа... кеудем...
Dialogue: 0,0:20:34.94,0:20:37.65,Default,,0,0,0,,Цукидате де көмектеседі (Цукидат) Ах... о
Dialogue: 0,0:20:37.73,0:20:40.53,Default,,0,0,0,,Мен сені дұрыс қолдаймын, сондықтан мүмкіндігінше секір
Dialogue: 0,0:20:40.61,0:20:41.61,Default,,0,0,0,,Иә
Dialogue: 0,0:20:42.53,0:20:44.78,Default,,0,0,0,,Ио... уф (Цукидате) Жақсысың ба?
Dialogue: 0,0:20:44.86,0:20:48.03,Default,,0,0,0,,Жарайды... ол бәрібір маған тиесілі емес...
Dialogue: 0,0:20:59.29,0:21:01.26,Default,,0,0,0,,Жүрегіңізді ұстаңыз...
Dialogue: 0,0:21:06.51,0:21:11.52,Default,,0,0,0,,Дәл қазір Мисато-кун... жүрегім лүпілдеп тұр. Бұл дегенің бе?
Dialogue: 0,0:21:11.60,0:21:13.14,Default,,0,0,0,,Біз оны бір күн деп атаймыз ба?
Dialogue: 0,0:21:13.23,0:21:15.10,Default,,0,0,0,,Жоқ! Тағы біраз!
Dialogue: 0,0:21:15.19,0:21:17.35,Default,,0,0,0,,О... хи хи
Dialogue: 0,0:21:17.44,0:21:19.65,Default,,0,0,0,,♪～
Dialogue: 0,0:21:19.65,0:21:21.11,Default,,0,0,0,,♪～
Dialogue: 0,0:21:19.65,0:21:21.11,Default,,0,0,0,,Ой, қайталап көріңіз!
Dialogue: 0,0:21:21.19,0:21:22.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:22.40,0:21:24.15,Default,,0,0,0,,Батыл және қорықпаңыз
Dialogue: 0,0:21:24.24,0:21:25.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:25.15,0:21:27.70,Default,,0,0,0,,Кеуденің санасын ұмытпа (Футаба) Иә!
Dialogue: 0,0:21:29.32,0:21:30.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:30.24,0:21:31.99,Default,,0,0,0,,Жарайды, бұл жақсы.
Dialogue: 0,0:21:32.08,0:21:34.29,Default,,0,0,0,,Ол қалыптаса бастады.
Dialogue: 0,0:21:34.37,0:21:36.04,Default,,0,0,0,,Әрі қарай, көмексіз қолданып көрейік.
Dialogue: 0,0:21:36.12,0:21:36.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:37.71,0:21:39.17,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:21:39.25,0:21:41.88,Default,,0,0,0,,Мен мұндай сезімді бірінші рет сезінуім.
Dialogue: 0,0:21:42.55,0:21:46.26,Default,,0,0,0,,Үнемі біреудің шақыруы және алып кетуі
Dialogue: 0,0:21:46.34,0:21:47.97,Default,,0,0,0,,Бірақ шын жүректен...
Dialogue: 0,0:21:48.05,0:21:50.47,Default,,0,0,0,,Мен ешқашан байланған емеспін.
Dialogue: 0,0:21:50.55,0:21:51.93,Default,,0,0,0,,Жеңілсең де
Dialogue: 0,0:21:52.01,0:21:53.60,Default,,0,0,0,,Тұрақты бола алмасаң да
Dialogue: 0,0:21:53.68,0:21:55.10,Default,,0,0,0,,Мен өкінбеймін
Dialogue: 0,0:21:55.64,0:21:58.27,Default,,0,0,0,,Бірақ қазір секіргім келеді
Dialogue: 0,0:21:58.35,0:22:00.31,Default,,0,0,0,,Мен міндетті түрде секіргім келеді
Dialogue: 0,0:22:01.44,0:22:03.32,Default,,0,0,0,,Өйткені оны өзіңіз таңдадыңыз ба?
Dialogue: 0,0:22:03.40,0:22:04.65,Default,,0,0,0,,Бірінші рет өзім
Dialogue: 0,0:22:04.74,0:22:06.74,Default,,0,0,0,,Сіз бірдеңе жасағыңыз келгендіктен бе?
Dialogue: 0,0:22:07.95,0:22:10.87,Default,,0,0,0,,Мен қайда барғым келеді Не істегім келеді
Dialogue: 0,0:22:10.95,0:22:13.04,Default,,0,0,0,,Мен байсалдымын...
Dialogue: 0,0:22:18.46,0:22:19.75,Default,,0,0,0,,Мен кері айналдырғым келеді!
Dialogue: 0,0:22:19.83,0:22:21.29,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:22:22.75,0:22:24.05,Default,,0,0,0,,Денесі тегіс
Dialogue: 0,0:22:24.13,0:22:26.05,Default,,0,0,0,,Осы уақытқа дейін ауада қалқып жүрген...
Dialogue: 0,0:22:26.13,0:22:27.38,Default,,0,0,0,,Мен бұрын-соңды сезінбегендей
Dialogue: 0,0:22:27.47,0:22:28.34,Default,,0,0,0,,Жеңілірек болыңыз
Dialogue: 0,0:22:28.97,0:22:31.85,Default,,0,0,0,,Бәрі айналып жатыр.
Dialogue: 0,0:22:35.35,0:22:38.06,Default,,0,0,0,,Дүние кеңейіп бара жатқандай сезінді.
Dialogue: 0,0:22:39.94,0:22:40.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:40.85,0:22:41.77,Default,,0,0,0,,Ах
Dialogue: 0,0:22:41.86,0:22:43.44,Default,,0,0,0,,Тынш! ～♪
Dialogue: 0,0:22:43.44,0:22:43.52,Default,,0,0,0,,～♪
Dialogue: 0,0:22:43.52,0:22:44.82,Default,,0,0,0,,~♪ Пи
Dialogue: 0,0:22:44.82,0:22:44.90,Default,,0,0,0,,～♪
Dialogue: 0,0:22:44.90,0:22:46.23,Default,,0,0,0,,～♪ Сіз мұны істей аласыз.
Dialogue: 0,0:22:50.28,0:22:51.45,Default,,0,0,0,,Енгізіңіз
Dialogue: 0,0:22:52.32,0:22:55.41,Default,,0,0,0,,Мен ерлер арасындағы көркем гимнастика үйірмесіне қатысамын!
Dialogue: 0,0:22:56.91,0:23:02.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
