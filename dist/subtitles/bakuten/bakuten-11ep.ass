Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.96,0:00:09.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:10.34,0:00:11.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:11.84,0:00:13.84,Default,,0,0,0,,Неге ертерек айтпадың?
Dialogue: 0,0:00:13.97,0:00:16.51,Default,,0,0,0,,Бұл... бұл үлкен мәселе болмайтын шығар...
Dialogue: 0,0:00:18.30,0:00:20.93,Default,,0,0,0,,Мен үлкендерден үндемеуді сұрай аламын ба деп ойлаймын...
Dialogue: 0,0:00:21.06,0:00:21.98,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:00:22.10,0:00:22.89,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:00:23.02,0:00:25.52,Default,,0,0,0,,Өткізілетін жерге барсаңыз, директор да сонда болады.
Dialogue: 0,0:00:25.65,0:00:28.40,Default,,0,0,0,,Жақында білесің, шынымды айтсам амал жоқ.
Dialogue: 0,0:00:29.52,0:00:32.40,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:00:33.78,0:00:37.53,Default,,0,0,0,,Неге... осындай маңызды күнде...
Dialogue: 0,0:00:39.03,0:00:44.00,Default,,0,0,0,,♪～
Dialogue: 0,0:02:03.91,0:02:08.87,Default,,0,0,0,,～♪
Dialogue: 0,0:02:09.75,0:02:12.88,Default,,0,0,0,,Е... бұл созылу. Бұл соншалықты үлкен мәміле емес, солай емес пе?
Dialogue: 0,0:02:13.00,0:02:15.00,Default,,0,0,0,,Созылуды елемеңіз
Dialogue: 0,0:02:15.13,0:02:17.01,Default,,0,0,0,,Кейінгі әсерлер қалуы мүмкін.
Dialogue: 0,0:02:17.13,0:02:18.76,Default,,0,0,0,,Бірінші: Сіз әрекет ете аласыз ба...
Dialogue: 0,0:02:18.88,0:02:19.80,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:02:19.93,0:02:21.47,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:02:22.30,0:02:24.81,Default,,0,0,0,,Әйтеуір алдымен дәрігерге барыңыз.
Dialogue: 0,0:02:24.93,0:02:25.93,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:02:26.64,0:02:29.10,Default,,0,0,0,,Барып дәлелдеңдер.
Dialogue: 0,0:02:29.23,0:02:31.15,Default,,0,0,0,,Ашылу салтанатын өткізу мүмкін емес⸺
Dialogue: 0,0:02:31.27,0:02:32.61,Default,,0,0,0,,Сіз матчқа уақытында келесіз.
Dialogue: 0,0:02:32.73,0:02:33.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:33.77,0:02:36.36,Default,,0,0,0,,Дәрігерге бармасаң, жарыса алмайсың.
Dialogue: 0,0:02:37.86,0:02:38.65,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:38.78,0:02:40.53,Default,,0,0,0,,Мен сізге еремін.
Dialogue: 0,0:02:40.66,0:02:41.61,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:02:42.16,0:02:42.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:56.59,0:02:57.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:59.59,0:03:00.38,Default,,0,0,0,,Сондықтан⸺
Dialogue: 0,0:03:01.05,0:03:02.22,Default,,0,0,0,,Сіздің жағдайыңыз қандай, Футаба?
Dialogue: 0,0:03:07.43,0:03:08.52,Default,,0,0,0,,Йо
Dialogue: 0,0:03:08.64,0:03:10.60,Default,,0,0,0,,Ах! Такесе...
Dialogue: 0,0:03:10.73,0:03:12.65,Default,,0,0,0,,Сіз осы уақытқа дейін келдіңіз бе?
Dialogue: 0,0:03:13.31,0:03:14.56,Default,,0,0,0,,Сасакама жігіті
Dialogue: 0,0:03:16.02,0:03:16.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:16.94,0:03:19.11,Default,,0,0,0,,А? (Муцу) Не болды?
Dialogue: 0,0:03:19.24,0:03:20.53,Default,,0,0,0,,Сіз кездейсоқ қобалжыдыңыз ба?
Dialogue: 0,0:03:20.65,0:03:22.74,Default,,0,0,0,,Иә? Мисапонто Шотароха?
Dialogue: 0,0:03:22.86,0:03:26.28,Default,,0,0,0,,Аа~ Екеуміз де ұйқышылбыз.
Dialogue: 0,0:03:26.41,0:03:27.83,Default,,0,0,0,,Жоқ, менің жылым бос.
Dialogue: 0,0:03:27.95,0:03:29.70,Default,,0,0,0,,Мисапонга? Ұйықтап қалдыңыз ба?
Dialogue: 0,0:03:29.83,0:03:31.16,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:31.29,0:03:32.50,Default,,0,0,0,,Ах! Міне бітті!
Dialogue: 0,0:03:34.08,0:03:36.42,Default,,0,0,0,,Бірдеңе болған сияқты.
Dialogue: 0,0:03:36.54,0:03:38.84,Default,,0,0,0,,Әй, үлкен балаңыз да?
Dialogue: 0,0:03:38.96,0:03:40.97,Default,,0,0,0,,Иә, мен Ао орта мектебінің мүшесімін...
Dialogue: 0,0:03:41.09,0:03:42.30,Default,,0,0,0,,Жасың нешеде?
Dialogue: 0,0:03:42.43,0:03:42.88,Default,,0,0,0,,1 курс (Аюми) Ия!
Dialogue: 0,0:03:42.88,0:03:43.76,Default,,0,0,0,,1 курс (Аюми) Иә!
Dialogue: 0,0:03:42.88,0:03:43.76,Default,,0,0,0,,Енді ашылу салтанаты өтеді.
Dialogue: 0,0:03:43.76,0:03:43.89,Default,,0,0,0,,Енді ашылу салтанаты өтеді.
Dialogue: 0,0:03:43.89,0:03:45.85,Default,,0,0,0,,Енді ашылу салтанаты өтеді.
Dialogue: 0,0:03:43.89,0:03:45.85,Default,,0,0,0,,Мен ағаммен біргемін! (Сакико) Иә?
Dialogue: 0,0:03:45.97,0:03:48.51,Default,,0,0,0,,Мүмкін Шотаро Футаба?
Dialogue: 0,0:03:55.02,0:03:55.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:55.02,0:03:55.81,Default,,0,0,0,,Өкінбеу үшін⸺
Dialogue: 0,0:03:55.81,0:03:55.94,Default,,0,0,0,,Өкінбеу үшін⸺
Dialogue: 0,0:03:55.94,0:03:56.69,Default,,0,0,0,,Өкінбеу үшін⸺
Dialogue: 0,0:03:55.94,0:03:56.69,Default,,0,0,0,,Сенің ағаң жоқ.
Dialogue: 0,0:03:56.69,0:03:56.81,Default,,0,0,0,,Сенің ағаң жоқ.
Dialogue: 0,0:03:56.81,0:03:57.44,Default,,0,0,0,,Сенің ағаң жоқ.
Dialogue: 0,0:03:56.81,0:03:57.44,Default,,0,0,0,,Оның күшін толық көрсетіңіз
Dialogue: 0,0:03:57.44,0:03:57.57,Default,,0,0,0,,Оның күшін толық көрсетіңіз
Dialogue: 0,0:03:57.57,0:03:58.78,Default,,0,0,0,,Оның күшін толық көрсетіңіз
Dialogue: 0,0:03:57.57,0:03:58.78,Default,,0,0,0,,Рё Чан да...
Dialogue: 0,0:03:58.90,0:04:01.03,Default,,0,0,0,,Мен кешігіп қалдым деп ойлаймын. Сізге қоңырау шалайын ба?
Dialogue: 0,0:03:58.90,0:04:01.03,Default,,0,0,0,,Жас энергияға толы⸺
Dialogue: 0,0:04:01.15,0:04:02.61,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,0:04:01.15,0:04:02.61,Default,,0,0,0,,Керемет қойылым көрсетесіздер деп сенемін.
Dialogue: 0,0:04:02.61,0:04:02.74,Default,,0,0,0,,Маған тамаша қойылым көрсетеді деп сенемін.
Dialogue: 0,0:04:02.74,0:04:03.32,Default,,0,0,0,,Маған тамаша қойылым көрсетеді деп сенемін.
Dialogue: 0,0:04:02.74,0:04:03.32,Default,,0,0,0,,Егер бірдеңе болса, мен сізге хабарласамын.
Dialogue: 0,0:04:03.32,0:04:03.45,Default,,0,0,0,,Егер бірдеңе болса, мен сізге хабарласамын.
Dialogue: 0,0:04:03.45,0:04:04.53,Default,,0,0,0,,Егер бірдеңе болса, мен сізге хабарласамын.
Dialogue: 0,0:04:03.45,0:04:04.53,Default,,0,0,0,,Мен үлкен үміт күтемін.
Dialogue: 0,0:04:04.53,0:04:04.66,Default,,0,0,0,,Мен үлкен үміт күтемін.
Dialogue: 0,0:04:04.66,0:04:05.57,Default,,0,0,0,,Мен үлкен үміт күтемін.
Dialogue: 0,0:04:04.66,0:04:05.57,Default,,0,0,0,,Иә
Dialogue: 0,0:04:05.70,0:04:06.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:06.66,0:04:09.16,Default,,0,0,0,,№1 Акита префектурасының өкілі
Dialogue: 0,0:04:09.29,0:04:11.50,Default,,0,0,0,,Префектуралық Акита Хигаши орта мектебі
Dialogue: 0,0:04:12.29,0:04:13.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:17.09,0:04:18.09,Default,,0,0,0,,Пуха
Dialogue: 0,0:04:18.80,0:04:20.71,Default,,0,0,0,,Бір орында тұрудың пайдасы жоқ.
Dialogue: 0,0:04:20.84,0:04:22.01,Default,,0,0,0,,Концентрация концентрациясы
Dialogue: 0,0:04:22.13,0:04:23.51,Default,,0,0,0,,Иә! (Ватари) Уссу
Dialogue: 0,0:04:24.13,0:04:25.97,Default,,0,0,0,,№2 Фукусима префектурасының өкілі
Dialogue: 0,0:04:25.97,0:04:27.14,Default,,0,0,0,,№2 Фукусима префектурасының өкілі
Dialogue: 0,0:04:25.97,0:04:27.14,Default,,0,0,0,,Ұрыс! жалғастыра бер!
Dialogue: 0,0:04:27.14,0:04:27.26,Default,,0,0,0,,Ұрыс! жалғастыра бер!
Dialogue: 0,0:04:27.26,0:04:28.10,Default,,0,0,0,,Ұрыс! жалғастыра бер!
Dialogue: 0,0:04:27.26,0:04:28.10,Default,,0,0,0,,Префектуралық Сукагава үшінші орта мектебі
Dialogue: 0,0:04:28.10,0:04:30.39,Default,,0,0,0,,Префектуралық Сукагава Үшінші орта мектебі
Dialogue: 0,0:04:30.52,0:04:31.02,Default,,0,0,0,,♪～
Dialogue: 0,0:04:31.02,0:04:32.31,Default,,0,0,0,,♪～
Dialogue: 0,0:04:31.02,0:04:32.31,Default,,0,0,0,,Комацу мырза, сәл күте тұрыңыз.
Dialogue: 0,0:04:32.31,0:04:32.43,Default,,0,0,0,,♪～
Dialogue: 0,0:04:32.43,0:04:33.64,Default,,0,0,0,,♪～
Dialogue: 0,0:04:32.43,0:04:33.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:36.31,0:04:37.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:37.98,0:04:38.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:39.07,0:04:40.57,Default,,0,0,0,,～♪
Dialogue: 0,0:04:40.69,0:04:42.49,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:04:48.66,0:04:49.78,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:04:51.29,0:04:54.08,Default,,0,0,0,,Уау, Широ жоғары.
Dialogue: 0,0:04:57.83,0:04:59.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:02.34,0:05:04.30,Default,,0,0,0,,А... ха...
Dialogue: 0,0:05:04.42,0:05:06.01,Default,,0,0,0,,Хмф, сіз өте тітіркендіргішсіз.
Dialogue: 0,0:05:06.01,0:05:06.88,Default,,0,0,0,,Хмф, сіз өте тітіркендіргішсіз.
Dialogue: 0,0:05:06.01,0:05:06.88,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:07.55,0:05:10.31,Default,,0,0,0,,Бірінші курстың екі студенті әлі келмеген сияқты.
Dialogue: 0,0:05:10.43,0:05:13.93,Default,,0,0,0,,Күтілгендей, Мисапон мен Шотаро жоқ.
Dialogue: 0,0:05:14.06,0:05:15.60,Default,,0,0,0,,Бұл оңай жеңіс, қызық емес пе?
Dialogue: 0,0:05:15.73,0:05:16.81,Default,,0,0,0,,Цукиюки!
Dialogue: 0,0:05:16.94,0:05:18.27,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз!
Dialogue: 0,0:05:18.40,0:05:20.77,Default,,0,0,0,,Ол мұны аздап бастаған сияқты.
Dialogue: 0,0:05:20.90,0:05:22.78,Default,,0,0,0,,Төрт адам сөйлей алмайды
Dialogue: 0,0:05:22.90,0:05:24.78,Default,,0,0,0,,Шамасы, біз⸺
Dialogue: 0,0:05:24.90,0:05:27.95,Default,,0,0,0,,Ол сендерді сатып алмақ болған сияқты.
Dialogue: 0,0:05:30.12,0:05:31.16,Default,,0,0,0,,Не!
Dialogue: 0,0:05:31.70,0:05:32.95,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:38.62,0:05:39.42,Default,,0,0,0,,2 жыл бұрын...
Dialogue: 0,0:05:40.59,0:05:42.88,Default,,0,0,0,,Сіз үшеу ғана болдыңыз.
Dialogue: 0,0:05:43.00,0:05:43.88,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:44.01,0:05:45.72,Default,,0,0,0,,Әрқашан жоғары қараңыз
Dialogue: 0,0:05:45.84,0:05:48.18,Default,,0,0,0,,Оның жалт-жұлт еткен, сынайтын көздері болды.
Dialogue: 0,0:05:48.30,0:05:49.22,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:49.93,0:05:51.51,Default,,0,0,0,,Өткен жылғы да төрт адам
Dialogue: 0,0:05:51.64,0:05:54.60,Default,,0,0,0,,Сіздің бүкіл денеңіз жауынгерлік рухқа толы болды.
Dialogue: 0,0:05:54.72,0:05:55.73,Default,,0,0,0,,Осымен салыстырғанда⸺
Dialogue: 0,0:05:56.35,0:05:58.27,Default,,0,0,0,,Балалар, қазір қалайсыңдар?
Dialogue: 0,0:05:58.39,0:05:59.48,Default,,0,0,0,,Масқара
Dialogue: 0,0:05:59.60,0:06:02.27,Default,,0,0,0,,Тепкілеудің қажеті жоқ
Dialogue: 0,0:06:02.40,0:06:03.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:03.40,0:06:05.90,Default,,0,0,0,,А, бұл өте шулы.
Dialogue: 0,0:06:06.03,0:06:07.28,Default,,0,0,0,,Біз...
Dialogue: 0,0:06:07.99,0:06:09.91,Default,,0,0,0,,Әдеттегідей.
Dialogue: 0,0:06:17.41,0:06:18.46,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:20.71,0:06:21.67,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:25.38,0:06:27.47,Default,,0,0,0,,Бір үміт бар сияқты.
Dialogue: 0,0:06:27.59,0:06:28.51,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:28.63,0:06:29.80,Default,,0,0,0,,Сіз⸺
Dialogue: 0,0:06:29.93,0:06:31.39,Default,,0,0,0,,Айтылды
Dialogue: 0,0:06:29.93,0:06:31.39,Default,,0,0,0,,Үлкендер түсінбес бұрын мен оларға қанша рет құрмет көрсетуім керек?
Dialogue: 0,0:06:31.39,0:06:31.51,Default,,0,0,0,,Үлкендер түсінбес бұрын оларға қанша рет құрмет көрсету керек?
Dialogue: 0,0:06:31.51,0:06:32.60,Default,,0,0,0,,Үлкендер түсінбес бұрын оларға қанша рет құрмет көрсету керек?
Dialogue: 0,0:06:31.51,0:06:32.60,Default,,0,0,0,,Иә, олар дұрыс.
Dialogue: 0,0:06:32.60,0:06:34.64,Default,,0,0,0,,Иә, олар дұрыс.
Dialogue: 0,0:06:34.76,0:06:37.77,Default,,0,0,0,,Ша! Әдеттегідей мен жеңіске деген жігермен секіремін!
Dialogue: 0,0:06:37.89,0:06:39.14,Default,,0,0,0,,Шаа~! (Ватари) Иә!
Dialogue: 0,0:06:39.27,0:06:40.06,Default,,0,0,0,,Хаха...
Dialogue: 0,0:06:40.19,0:06:42.27,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:06:42.90,0:06:45.69,Default,,0,0,0,,№ 4 Аомори префектурасының өкілі
Dialogue: 0,0:06:45.82,0:06:48.61,Default,,0,0,0,,Жеке Ширанари университетінің орта мектебі
Dialogue: 0,0:06:48.74,0:06:51.36,Default,,0,0,0,,Бұл өткен жылғы орта мектептің жеңімпаз мектебі болды!
Dialogue: 0,0:06:48.74,0:06:51.36,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:06:51.49,0:06:52.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:54.83,0:06:55.62,Default,,0,0,0,,(үшінның дем шығару дыбысы)
Dialogue: 0,0:07:15.35,0:07:19.14,Default,,0,0,0,,♪～
Dialogue: 0,0:08:52.03,0:08:54.65,Default,,0,0,0,,Оқу-жаттығу жиынында болған жағдайды салыстыруға болмайды.
Dialogue: 0,0:08:54.78,0:08:56.41,Default,,0,0,0,,Әрине Такасе мен Муцу
Dialogue: 0,0:08:56.53,0:08:58.49,Default,,0,0,0,,Қалғандары да керемет.
Dialogue: 0,0:08:58.62,0:09:00.49,Default,,0,0,0,,Және Маширо Цукиюки
Dialogue: 0,0:09:01.16,0:09:03.00,Default,,0,0,0,,Бұл не? Бұл құбыжық па?
Dialogue: 0,0:09:24.43,0:09:26.10,Default,,0,0,0,,Бұрынғы мектеп және...
Dialogue: 0,0:09:26.23,0:09:27.94,Default,,0,0,0,,Иә, әртүрлі деңгей.
Dialogue: 0,0:09:28.06,0:09:29.77,Default,,0,0,0,,Әзірге қателер жоқ
Dialogue: 0,0:09:29.90,0:09:32.15,Default,,0,0,0,,Сізден күткендей, Мабучи-сенпай.
Dialogue: 0,0:09:33.86,0:09:34.65,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:19.53,0:10:24.41,Default,,0,0,0,,～♪
Dialogue: 0,0:10:37.13,0:10:37.97,Default,,0,0,0,,Мұнда келу қандай да бір қорқынышты іс сияқты…
Dialogue: 0,0:10:38.09,0:10:39.63,Default,,0,0,0,,Уау 18 ұпай! (Аюми) 1 орын!
Dialogue: 0,0:10:38.09,0:10:39.63,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:10:43.26,0:10:45.64,Default,,0,0,0,,18.０…
Dialogue: 0,0:10:45.77,0:10:47.31,Default,,0,0,0,,Сен оны ойламаған жерден алып келдің.
Dialogue: 0,0:10:47.43,0:10:49.89,Default,,0,0,0,,Ей, басқа адамға ештеңе жетпейді.
Dialogue: 0,0:10:50.02,0:10:53.40,Default,,0,0,0,,Енді 40 минуттық үзіліс жасаймыз.
Dialogue: 0,0:10:54.23,0:10:55.78,Default,,0,0,0,,Жарыс дәл сағат 13:00-де жалғасады.
Dialogue: 0,0:10:55.78,0:10:57.40,Default,,0,0,0,,Жарыс дәл сағат 13:00-де жалғасады.
Dialogue: 0,0:10:55.78,0:10:57.40,Default,,0,0,0,,Жарайды, ағынды тағы бір рет тексеріңіз...
Dialogue: 0,0:10:57.40,0:10:57.74,Default,,0,0,0,,Жарайды, ағынды тағы бір рет тексеріңіз...
Dialogue: 0,0:10:57.86,0:10:59.03,Default,,0,0,0,,Капитан (4 адам) Иә!
Dialogue: 0,0:10:57.86,0:10:59.03,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:10:59.15,0:11:02.91,Default,,0,0,0,,Енді біз 40 минуттық үзіліс жасаймыз.
Dialogue: 0,0:11:03.62,0:11:05.03,Default,,0,0,0,,Сакико-сан Тамагояки
Dialogue: 0,0:11:05.16,0:11:06.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:06.20,0:11:07.95,Default,,0,0,0,,Ах~ (Сакико) Ах~
Dialogue: 0,0:11:08.58,0:11:09.04,Default,,0,0,0,,Хмм, эй!
Dialogue: 0,0:11:09.04,0:11:10.33,Default,,0,0,0,,Хмм, эй!
Dialogue: 0,0:11:09.04,0:11:10.33,Default,,0,0,0,,Шо-чан, сен осындасың ба?
Dialogue: 0,0:11:10.33,0:11:10.46,Default,,0,0,0,,Шочан, сен осындасың ба?
Dialogue: 0,0:11:10.46,0:11:11.25,Default,,0,0,0,,Шо-чан, сен осындасың ба?
Dialogue: 0,0:11:10.46,0:11:11.25,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:11:13.17,0:11:13.96,Default,,0,0,0,,Шығу
Dialogue: 0,0:11:14.63,0:11:17.84,Default,,0,0,0,,Жоқ... екі апта төсек демалысы керек дедіңіз ғой, солай ма?
Dialogue: 0,0:11:17.96,0:11:20.17,Default,,0,0,0,,Мен тапсырсам 1,5 ұпай шегеріледі.
Dialogue: 0,0:11:20.30,0:11:22.80,Default,,0,0,0,,Жеңіске жету оңай емес деп ойлаймын.
Dialogue: 0,0:11:24.05,0:11:25.85,Default,,0,0,0,,Егер сіз көп қателессеңіз, ол солай болады!
Dialogue: 0,0:11:25.97,0:11:27.43,Default,,0,0,0,,Қателік жасамаңыз!
Dialogue: 0,0:11:28.52,0:11:31.69,Default,,0,0,0,,Ауыруы біршама басылды, мен 3 минутқа шыдай аламын.
Dialogue: 0,0:11:31.81,0:11:34.65,Default,,0,0,0,,Егер жағдай нашарласа ше?
Dialogue: 0,0:11:42.66,0:11:44.24,Default,,0,0,0,,Шотаро...
Dialogue: 0,0:11:44.82,0:11:47.87,Default,,0,0,0,,Сенде келесі жылы бар, енді өзіңді итерме...
Dialogue: 0,0:11:47.99,0:11:49.45,Default,,0,0,0,,Келесі жылы емес!
Dialogue: 0,0:11:49.58,0:11:50.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:51.12,0:11:52.46,Default,,0,0,0,,Шотаро...
Dialogue: 0,0:11:53.00,0:11:54.38,Default,,0,0,0,,үшін...
Dialogue: 0,0:11:54.50,0:11:58.59,Default,,0,0,0,,Бұл алты адам ойынға қатыса алатын жалғыз жыл.
Dialogue: 0,0:11:59.21,0:12:01.55,Default,,0,0,0,,Осы жерде жеңілсек, бүгін...
Dialogue: 0,0:12:02.30,0:12:03.63,Default,,0,0,0,,Бәрі бітті.
Dialogue: 0,0:12:04.59,0:12:06.26,Default,,0,0,0,,Шичигахама Сенпаймен
Dialogue: 0,0:12:06.39,0:12:08.06,Default,,0,0,0,,Цукидате-сенпаймен
Dialogue: 0,0:12:08.18,0:12:09.60,Default,,0,0,0,,Онагава-сенпаймен
Dialogue: 0,0:12:09.72,0:12:11.35,Default,,0,0,0,,Ватари-сенпаймен
Dialogue: 0,0:12:11.48,0:12:13.27,Default,,0,0,0,,Мисато және барлығы...
Dialogue: 0,0:12:14.94,0:12:17.23,Default,,0,0,0,,Ойынға бәріміз бірге бара алмаймыз.
Dialogue: 0,0:12:17.36,0:12:18.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:18.90,0:12:21.07,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:12:21.19,0:12:22.57,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:12:23.24,0:12:24.20,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:25.16,0:12:26.12,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:26.66,0:12:28.78,Default,,0,0,0,,Сіз маған секіруді үйреттіңіз⸺
Dialogue: 0,0:12:29.37,0:12:31.29,Default,,0,0,0,,үшін Ао орта мектебінің ұлдар көркем гимнастика үйірмесі...
Dialogue: 0,0:12:32.66,0:12:35.67,Default,,0,0,0,,Мен! үшінмыз секіргіміз келеді!
Dialogue: 0,0:12:36.63,0:12:39.38,Default,,0,0,0,,Маған ойнауға рұқсат етіңіз!
Dialogue: 0,0:12:40.71,0:12:42.13,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:12:45.34,0:12:46.64,Default,,0,0,0,,Биыл ғана дебют жасаған –
Dialogue: 0,0:12:46.76,0:12:51.81,Default,,0,0,0,,Мен сондай-ақ 5 адаммен жеңілгеннен гөрі 6 адаммен жеңіске жетуді мақсат етемін.
Dialogue: 0,0:12:51.93,0:12:52.89,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:12:58.52,0:12:59.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:01.28,0:13:02.32,Default,,0,0,0,,Шотаро...
Dialogue: 0,0:13:02.99,0:13:06.99,Default,,0,0,0,,Капитан ретінде мен сені жібере алмаймын...
Dialogue: 0,0:13:08.57,0:13:10.49,Default,,0,0,0,,Мен мұны айта аламын
Dialogue: 0,0:13:10.62,0:13:11.70,Default,,0,0,0,,Шичигахама!
Dialogue: 0,0:13:11.83,0:13:12.95,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:13:13.08,0:13:16.42,Default,,0,0,0,,Сіз үш жыл бойы Интер-Хайға жетуді мақсат еттіңіз, солай емес пе?
Dialogue: 0,0:13:16.54,0:13:17.67,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:13:17.79,0:13:20.13,Default,,0,0,0,,Сондықтан Шотароны армандарымызға қосуға рұқсат етеміз...
Dialogue: 0,0:13:20.25,0:13:22.25,Default,,0,0,0,,Бұл енді біздің арманымыз емес!
Dialogue: 0,0:13:23.09,0:13:26.26,Default,,0,0,0,,Шотаро мен Мисато бір түс көреді
Dialogue: 0,0:13:27.30,0:13:29.01,Default,,0,0,0,,Сен шыдай алмайсың ба?
Dialogue: 0,0:13:29.14,0:13:31.26,Default,,0,0,0,,Шотаромен бір позицияда болу⸺
Dialogue: 0,0:13:31.39,0:13:33.47,Default,,0,0,0,,Ойынға бармайсың ба?
Dialogue: 0,0:13:34.31,0:13:35.48,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:13:36.64,0:13:38.31,Default,,0,0,0,,Бұл қол сынса да⸺
Dialogue: 0,0:13:39.23,0:13:41.15,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:13:43.32,0:13:45.61,Default,,0,0,0,,Мен жаман капитанмын.
Dialogue: 0,0:13:46.78,0:13:48.20,Default,,0,0,0,,Шичигахама...
Dialogue: 0,0:13:48.70,0:13:49.53,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:51.12,0:13:51.91,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:55.41,0:13:57.54,Default,,0,0,0,,Мен дөрекі екенімді білемін.
Dialogue: 0,0:13:57.67,0:14:00.96,Default,,0,0,0,,Бірақ мен Шотаро сияқты сезінемін.
Dialogue: 0,0:14:01.09,0:14:02.09,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:02.21,0:14:05.38,Default,,0,0,0,,Мен де осы алты адаммен матчқа қатысқым келеді.
Dialogue: 0,0:14:05.51,0:14:08.38,Default,,0,0,0,,Егер бәріміз бірге секіре алмасақ, онда пайда жоқ.
Dialogue: 0,0:14:08.51,0:14:11.76,Default,,0,0,0,,Мен матч кезінде Шотароны бақылап отырамын.
Dialogue: 0,0:14:11.89,0:14:12.68,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:13.39,0:14:14.18,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:14:22.82,0:14:23.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:24.78,0:14:25.69,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:25.82,0:14:30.16,Default,,0,0,0,,Кугг… гугг…
Dialogue: 0,0:14:30.28,0:14:33.45,Default,,0,0,0,,Көркем гимнастикамен енді ешқашан айналыса алмайтын шығармын.
Dialogue: 0,0:14:34.91,0:14:36.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:36.29,0:14:37.08,Default,,0,0,0,,Иә
Dialogue: 0,0:14:37.71,0:14:41.25,Default,,0,0,0,,Бүгін бәрі жақсы болса да, мен орта мектепке қатыса алмай қалуым мүмкін.
Dialogue: 0,0:14:42.13,0:14:43.13,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:14:43.75,0:14:46.55,Default,,0,0,0,,Бірдеңе болып қалса, ол бөлім үшін проблемаға айналады.
Dialogue: 0,0:14:46.67,0:14:48.17,Default,,0,0,0,,Мен жауапкершілікті аламын
Dialogue: 0,0:14:48.30,0:14:50.09,Default,,0,0,0,,Айтуға оңай емес.
Dialogue: 0,0:14:50.72,0:14:51.72,Default,,0,0,0,,Бірде болған оқиға⸺
Dialogue: 0,0:14:52.34,0:14:54.76,Default,,0,0,0,,Ешкім жауапкершілікті ала алмайды.
Dialogue: 0,0:15:07.11,0:15:07.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:07.65,0:15:08.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:07.65,0:15:08.15,Default,,0,0,0,,Қолмен жылынуға тыйым салынады
Dialogue: 0,0:15:08.15,0:15:10.15,Default,,0,0,0,,Қолды пайдаланып қыздыруға тыйым салынады
Dialogue: 0,0:15:10.28,0:15:12.62,Default,,0,0,0,,Ойын уақытына дейін қимылсыз болыңыз
Dialogue: 0,0:15:12.74,0:15:16.87,Default,,0,0,0,,Содан кейін матч біткен бойда қайтадан ауруханаға барыңыз.
Dialogue: 0,0:15:17.49,0:15:18.62,Default,,0,0,0,,Қадағалау!
Dialogue: 0,0:15:19.33,0:15:21.46,Default,,0,0,0,,Егер матчқа дейін нашарласа
Dialogue: 0,0:15:21.58,0:15:23.63,Default,,0,0,0,,Ол кезде де жоқ еді
Dialogue: 0,0:15:23.75,0:15:26.55,Default,,0,0,0,,А... иә!
Dialogue: 0,0:15:26.67,0:15:29.13,Default,,0,0,0,,Хмм! Жарайды!
Dialogue: 0,0:15:29.26,0:15:31.26,Default,,0,0,0,,Егер солай болса, асығыңыз!
Dialogue: 0,0:15:31.38,0:15:34.22,Default,,0,0,0,,Асығыңыз! Жүктеп салуға уақытым таусылып жатыр!
Dialogue: 0,0:15:34.35,0:15:35.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:35.26,0:15:36.06,Default,,0,0,0,,Бәрібір⸺
Dialogue: 0,0:15:36.18,0:15:37.64,Default,,0,0,0,,Шусаку…
Dialogue: 0,0:15:36.18,0:15:37.64,Default,,0,0,0,,Оны ең жақсы көрсеткішке айналдырайық!
Dialogue: 0,0:15:37.64,0:15:37.77,Default,,0,0,0,,Оны ең жақсы көрсеткішке айналдырайық!
Dialogue: 0,0:15:37.77,0:15:38.10,Default,,0,0,0,,Оны ең жақсы көрсеткішке айналдырайық!
Dialogue: 0,0:15:37.77,0:15:38.10,Default,,0,0,0,,Хаха... Мен де нашар режиссермін.
Dialogue: 0,0:15:38.10,0:15:38.22,Default,,0,0,0,,Хаха... Мен де нашар режиссермін.
Dialogue: 0,0:15:38.22,0:15:40.39,Default,,0,0,0,,Хаха... Мен де нашар режиссермін.
Dialogue: 0,0:15:38.22,0:15:40.39,Default,,0,0,0,,Usu! Сіз мұны істегіңіз келе ме?
Dialogue: 0,0:15:40.52,0:15:41.31,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:41.44,0:15:42.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:43.52,0:15:46.65,Default,,0,0,0,,Біздің директор ғой директор!
Dialogue: 0,0:15:51.28,0:15:54.37,Default,,0,0,0,,Енді түстен кейінгі сессия басталады.
Dialogue: 0,0:15:54.91,0:15:57.70,Default,,0,0,0,,№ 5 Ямагата префектурасының өкілі
Dialogue: 0,0:15:57.83,0:16:01.04,Default,,0,0,0,,Префектуралық Ямагата Шохоку орта мектебі
Dialogue: 0,0:16:05.04,0:16:06.29,Default,,0,0,0,,Мисато-кун
Dialogue: 0,0:16:06.96,0:16:08.71,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:16:08.84,0:16:11.59,Default,,0,0,0,,Менің қасымда болмасаң да, жарайды.
Dialogue: 0,0:16:13.76,0:16:14.64,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:16.47,0:16:19.26,Default,,0,0,0,,Сіз де анда-санда көңіл көтеруіңіз керек.
Dialogue: 0,0:16:19.39,0:16:22.60,Default,,0,0,0,,Иә... Иә, рахмет.
Dialogue: 0,0:16:37.45,0:16:38.87,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:16:38.99,0:16:40.29,Default,,0,0,0,,Иә! (Ватари) Иә!
Dialogue: 0,0:16:41.75,0:16:43.12,Default,,0,0,0,,Иә?Ах!
Dialogue: 0,0:16:45.25,0:16:46.67,Default,,0,0,0,,Үлкен аға! (Сакико) Рё-чан!
Dialogue: 0,0:16:46.79,0:16:48.38,Default,,0,0,0,,Хэхехе... (Мимиори) Жақсы.
Dialogue: 0,0:16:56.26,0:16:57.09,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:03.64,0:17:05.56,Default,,0,0,0,,1 орын Shiro High болып бөлінеді.
Dialogue: 0,0:17:05.69,0:17:06.94,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:17:07.06,0:17:09.27,Default,,0,0,0,,Широтаканы жеңетін біздер.
Dialogue: 0,0:17:09.90,0:17:12.69,Default,,0,0,0,,Бұл аспан, аспанға қарай⸺
Dialogue: 0,0:17:12.82,0:17:14.45,Default,,0,0,0,,Әдеттегіден жоғары⸺
Dialogue: 0,0:17:14.99,0:17:16.28,Default,,0,0,0,,Жарып өткенше секіремін!
Dialogue: 0,0:17:16.41,0:17:17.82,Default,,0,0,0,,О! (Футаба/Мисато) Иә!
Dialogue: 0,0:17:20.03,0:17:21.45,Default,,0,0,0,,Бар күшіммен (Шичигахама) Иә!
Dialogue: 0,0:17:21.58,0:17:23.04,Default,,0,0,0,,Бар күшіммен (Цукидате) Иә!
Dialogue: 0,0:17:23.16,0:17:24.37,Default,,0,0,0,,Толығымен (Онагава) Иә!
Dialogue: 0,0:17:24.50,0:17:25.79,Default,,0,0,0,,Қолымнан келгенше (Ватари) Усу!
Dialogue: 0,0:17:25.91,0:17:27.29,Default,,0,0,0,,Қолымнан келгенше (Мисато) Иә!
Dialogue: 0,0:17:27.92,0:17:29.50,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз және одан толық ләззат алыңыз
Dialogue: 0,0:17:29.63,0:17:30.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:34.30,0:17:37.05,Default,,0,0,0,,№ 7 Мияги префектурасының өкілі
Dialogue: 0,0:17:37.18,0:17:40.14,Default,,0,0,0,,Жеке Сошукан орта мектебі
Dialogue: 0,0:17:40.26,0:17:41.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:43.06,0:17:44.22,Default,,0,0,0,,(үшінның дем шығару дыбысы)
