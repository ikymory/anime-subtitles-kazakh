Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.96,0:00:10.71,Default,,0,0,0,,Пуха~
Dialogue: 0,0:00:11.34,0:00:14.51,Default,,0,0,0,,Ваннаға түскеннен кейін ішсең, құмар болып кетесің... А?
Dialogue: 0,0:00:14.59,0:00:16.80,Default,,0,0,0,,Рё-чан, сен үйде болдың ба?
Dialogue: 0,0:00:18.10,0:00:19.47,Default,,0,0,0,,Сако-чан
Dialogue: 0,0:00:19.56,0:00:20.43,Default,,0,0,0,,Не?
Dialogue: 0,0:00:21.22,0:00:23.94,Default,,0,0,0,,Менің сізге айтатын шағын әңгімем бар.
Dialogue: 0,0:00:24.02,0:00:29.02,Default,,0,0,0,,♪～
Dialogue: 0,0:01:48.94,0:01:53.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:57.40,0:01:59.91,Default,,0,0,0,,Біз префектуралық турнирден 2-ші орынға өттік
Dialogue: 0,0:01:59.99,0:02:01.53,Default,,0,0,0,,Фу…
Dialogue: 0,0:02:01.62,0:02:04.45,Default,,0,0,0,,Бәріміз бірге секіруді жалғастырайық
Dialogue: 0,0:02:08.16,0:02:09.67,Default,,0,0,0,,Мен әлі де секіре аламын...
Dialogue: 0,0:02:11.63,0:02:13.09,Default,,0,0,0,,Сіз секіре аласыз!
Dialogue: 0,0:02:13.55,0:02:14.55,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:02:14.63,0:02:15.59,Default,,0,0,0,,«Жақсы» деген не?
Dialogue: 0,0:02:15.59,0:02:16.59,Default,,0,0,0,,«Жақсы» деген не?
Dialogue: 0,0:02:15.59,0:02:16.59,Default,,0,0,0,,Ой! Ах...
Dialogue: 0,0:02:16.67,0:02:17.51,Default,,0,0,0,,Хмм?
Dialogue: 0,0:02:17.59,0:02:19.51,Default,,0,0,0,,Күлме, қолмен қаңбақ
Dialogue: 0,0:02:19.59,0:02:20.84,Default,,0,0,0,,Иә
Dialogue: 0,0:02:20.93,0:02:22.47,Default,,0,0,0,,Иә? Онагава?
Dialogue: 0,0:02:23.93,0:02:24.85,Default,,0,0,0,,Онагава-сенпай?
Dialogue: 0,0:02:24.93,0:02:26.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:26.60,0:02:29.52,Default,,0,0,0,,Сіз әлі де кешегі қателік туралы алаңдайсыз ба?
Dialogue: 0,0:02:29.60,0:02:30.60,Default,,0,0,0,,Содан кейін жаттығу...
Dialogue: 0,0:02:30.69,0:02:31.52,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:02:31.60,0:02:35.90,Default,,0,0,0,,Мен префектуралық турнирде екінші орынды жеңіп алдым, бірақ мен қыздар арасында мүлдем танымал емеспін.
Dialogue: 0,0:02:35.98,0:02:36.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:37.07,0:02:38.44,Default,,0,0,0,,Қосымша Коса~
Dialogue: 0,0:02:38.53,0:02:40.53,Default,,0,0,0,,префектуралық турнирде 2-орын, керемет
Dialogue: 0,0:02:40.61,0:02:43.58,Default,,0,0,0,,Сіз маған ерлер көркем гимнастикасы туралы үйрете аласыз ба?
Dialogue: 0,0:02:43.66,0:02:46.62,Default,,0,0,0,,немесе сол сияқты!
Dialogue: 0,0:02:46.70,0:02:48.62,Default,,0,0,0,,Сіз не айтып тұрсыз...
Dialogue: 0,0:02:48.71,0:02:50.42,Default,,0,0,0,,Мен аздап түсіндім.
Dialogue: 0,0:02:50.50,0:02:51.54,Default,,0,0,0,,…маған қатысты айттың ғой, иә? Хе-хе.
Dialogue: 0,0:02:51.62,0:02:53.67,Default,,0,0,0,,А... Менің амалым жоқ.
Dialogue: 0,0:02:53.67,0:02:53.92,Default,,0,0,0,,А... Менің амалым жоқ.
Dialogue: 0,0:02:53.67,0:02:53.92,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:53.92,0:02:54.00,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:54.00,0:02:54.84,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:54.00,0:02:54.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:55.67,0:02:57.63,Default,,0,0,0,,Баршаңызға қайырлы таң
Dialogue: 0,0:02:57.71,0:02:59.72,Default,,0,0,0,,Директор Мисато
Dialogue: 0,0:02:59.80,0:03:03.05,Default,,0,0,0,,Не болды? Сонымен таңертең ерте
Dialogue: 0,0:03:03.14,0:03:05.60,Default,,0,0,0,,Менімен кеше түнде хабарласыңыз.
Dialogue: 0,0:03:05.68,0:03:07.68,Default,,0,0,0,,Мен де жатақханаға көшкім келеді.
Dialogue: 0,0:03:07.77,0:03:08.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:08.68,0:03:10.77,Default,,0,0,0,,Мисато-кун да жатақханада ма?
Dialogue: 0,0:03:10.85,0:03:12.31,Default,,0,0,0,,Не?
Dialogue: 0,0:03:12.40,0:03:15.32,Default,,0,0,0,,Сіз шынымен бізбен мәңгі бірге болғыңыз келе ме?
Dialogue: 0,0:03:15.40,0:03:17.73,Default,,0,0,0,,Бұл жалғыздық
Dialogue: 0,0:03:17.82,0:03:20.61,Default,,0,0,0,,Жалғыз адам емес
Dialogue: 0,0:03:20.70,0:03:22.95,Default,,0,0,0,,Бұл префектуралық турнирде белгілі болды.
Dialogue: 0,0:03:23.03,0:03:26.62,Default,,0,0,0,,Қазіргі уақытта біз Широ орта мектебін жеңе алмаймыз.
Dialogue: 0,0:03:26.70,0:03:27.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:28.24,0:03:30.71,Default,,0,0,0,,Мен міндетті түрде Inter-High-те көрінгім келеді.
Dialogue: 0,0:03:31.29,0:03:34.21,Default,,0,0,0,,Ол үшін біз жоғары көтерілуіміз керек...
Dialogue: 0,0:03:34.29,0:03:37.67,Default,,0,0,0,,Мен ғана емес, барлығы.
Dialogue: 0,0:03:37.75,0:03:41.13,Default,,0,0,0,,Уа! Бәріміз бірге өртелейік!
Dialogue: 0,0:03:41.22,0:03:42.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:42.13,0:03:42.97,Default,,0,0,0,,Иә (Ватари) Осунобу
Dialogue: 0,0:03:43.59,0:03:46.51,Default,,0,0,0,,Мисато-кун, үйге бару керек пе?
Dialogue: 0,0:03:46.60,0:03:47.93,Default,,0,0,0,,Сенбі және жексенбі күндері үйге барамын
Dialogue: 0,0:03:48.01,0:03:50.73,Default,,0,0,0,,Олай болса, капитан, рахмет.
Dialogue: 0,0:03:50.81,0:03:51.73,Default,,0,0,0,,...
Dialogue: 0,0:03:51.81,0:03:54.02,Default,,0,0,0,,Сіз түсінесіз деп ойлаймын.
Dialogue: 0,0:03:54.10,0:03:55.98,Default,,0,0,0,,Мұнда тамақ әзірлеу, кір жуу және тазалау...
Dialogue: 0,0:03:56.56,0:03:58.94,Default,,0,0,0,,Кезекшілік жүйесі
Dialogue: 0,0:03:59.03,0:04:03.07,Default,,0,0,0,,Алдымен мен сіздің аспаздық дағдыларыңызды көрсетейін.
Dialogue: 0,0:04:03.15,0:04:04.91,Default,,0,0,0,,Мисато~
Dialogue: 0,0:04:05.41,0:04:06.24,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:12.16,0:04:14.71,Default,,0,0,0,,Gugg...
Dialogue: 0,0:04:14.79,0:04:16.58,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:04:17.17,0:04:17.92,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:04:17.92,0:04:18.75,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:04:17.92,0:04:18.75,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:18.84,0:04:19.92,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:25.18,0:04:26.97,Default,,0,0,0,,Кейін тазалау үшін өте қолайлы
Dialogue: 0,0:04:27.05,0:04:28.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:28.30,0:04:30.56,Default,,0,0,0,,Бұл не? Керемет Эйс!
Dialogue: 0,0:04:30.64,0:04:33.10,Default,,0,0,0,,Мінсіз эйс емес
Dialogue: 0,0:04:34.27,0:04:37.23,Default,,0,0,0,,Жақсы! Мен тамақ жедім, Мисато да келді.
Dialogue: 0,0:04:37.31,0:04:38.82,Default,,0,0,0,,Келесі - жаттығу... (Цукидате) Бір минут күтіңіз!
Dialogue: 0,0:04:38.90,0:04:39.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:40.02,0:04:43.53,Default,,0,0,0,,Капитан, сіз бірдеңені ұмытып жатқан жоқсыз ба?
Dialogue: 0,0:04:43.61,0:04:44.03,Default,,0,0,0,,Префектуралық турнир аяқталды. Келесі аптадан кейінгі аптадан бастап...
Dialogue: 0,0:04:44.03,0:04:46.86,Default,,0,0,0,,Префектуралық турнир аяқталды. Келесі аптадан бастап...
Dialogue: 0,0:04:44.03,0:04:46.86,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:48.12,0:04:50.03,Default,,0,0,0,,Аралық бақылау!
Dialogue: 0,0:04:50.12,0:04:51.62,Default,,0,0,0,,Бұл қауіпті! Бұл өте қауіпті!
Dialogue: 0,0:04:51.70,0:04:53.04,Default,,0,0,0,,Мен ұмытып қалдым!
Dialogue: 0,0:04:53.12,0:04:54.50,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:04:54.58,0:04:56.83,Default,,0,0,0,,Мен мүлде оқымадым...
Dialogue: 0,0:04:56.92,0:04:59.04,Default,,0,0,0,,Осы уақытқа дейін клубтың қызметі тоқтатылады.
Dialogue: 0,0:04:59.13,0:05:02.05,Default,,0,0,0,,Директорға берген уәдемді биыл да орындауым керек.
Dialogue: 0,0:05:02.13,0:05:03.55,Default,,0,0,0,,Тіпті ұйықтап қалғаннан кейін де, кем дегенде—
Dialogue: 0,0:05:03.63,0:05:05.63,Default,,0,0,0,,Тіпті бір адам қызыл ұпай алса
Dialogue: 0,0:05:05.72,0:05:09.68,Default,,0,0,0,,Сол жылы Акайо университетінің гимназиясын пайдалану тоқтатылды.
Dialogue: 0,0:05:09.76,0:05:10.93,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:05:11.01,0:05:11.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:12.02,0:05:14.48,Default,,0,0,0,,Бұл кілемшеге секіруге болмайды дегенді білдіре ме?
Dialogue: 0,0:05:14.56,0:05:16.02,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:16.10,0:05:19.77,Default,,0,0,0,,Капитан мен Ватари Онагава әрқашан өз орындарының шетінде тұрады.
Dialogue: 0,0:05:19.86,0:05:20.69,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:05:20.77,0:05:24.90,Default,,0,0,0,,Цукидате-сенпай мен Курикома-сенпай ше?
Dialogue: 0,0:05:24.99,0:05:26.24,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:05:26.90,0:05:28.32,Default,,0,0,0,,Шотаро ше?
Dialogue: 0,0:05:28.41,0:05:31.53,Default,,0,0,0,,А, менің ағылшын тілім аздап...
Dialogue: 0,0:05:31.62,0:05:33.45,Default,,0,0,0,,Түсіндім, Мисато ше?
Dialogue: 0,0:05:34.16,0:05:35.91,Default,,0,0,0,,Орта мектеп күндері Қызыл нүктелер туралы не деуге болады?
Dialogue: 0,0:05:36.00,0:05:37.12,Default,,0,0,0,,Ешқашан
Dialogue: 0,0:05:37.21,0:05:40.21,Default,,0,0,0,,Жарайды, онда Шотароның ағылшын тіліне көз жүгіртіп көрейін.
Dialogue: 0,0:05:40.29,0:05:41.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:41.21,0:05:41.92,Default,,0,0,0,,Иә
Dialogue: 0,0:05:41.92,0:05:42.38,Default,,0,0,0,,Иә
Dialogue: 0,0:05:41.92,0:05:42.38,Default,,0,0,0,,А, сәл күте тұрыңыз...
Dialogue: 0,0:05:42.38,0:05:42.46,Default,,0,0,0,,А, сәл күте тұрыңыз...
Dialogue: 0,0:05:42.46,0:05:43.84,Default,,0,0,0,,А, сәл күте тұрыңыз...
Dialogue: 0,0:05:42.46,0:05:43.84,Default,,0,0,0,,Шичигахама мен Онагава менікі.
Dialogue: 0,0:05:43.84,0:05:44.84,Default,,0,0,0,,Шичигахама мен Онагава менікі.
Dialogue: 0,0:05:44.92,0:05:47.09,Default,,0,0,0,,Ватариді менеджер бақылайды.
Dialogue: 0,0:05:47.18,0:05:48.09,Default,,0,0,0,,Олай болса, бәріңе.
Dialogue: 0,0:05:48.18,0:05:49.76,Default,,0,0,0,,Орта мектепке баруға бар күшімізді салайық!
Dialogue: 0,0:05:49.84,0:05:50.68,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:50.76,0:05:51.60,Default,,0,0,0,,Иә (Ватари) Usu!
Dialogue: 0,0:05:52.51,0:05:55.93,Default,,0,0,0,,Топ түсінеді...
Dialogue: 0,0:05:56.02,0:05:59.23,Default,,0,0,0,,Қат! Бамбуктан кама жасау үшін сізге ағылшын тілі қажет емес!
Dialogue: 0,0:05:59.90,0:06:03.61,Default,,0,0,0,,Мүмкін Сасаначи бір күні шетелде кеңейетін шығар, солай ма?
Dialogue: 0,0:06:03.69,0:06:04.90,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:06:04.98,0:06:07.40,Default,,0,0,0,,Сасакаматты ағылшын тілінде қалай айтасыз?
Dialogue: 0,0:06:07.49,0:06:09.61,Default,,0,0,0,,Не? Жоқ...
Dialogue: 0,0:06:10.41,0:06:12.03,Default,,0,0,0,,Ммм Саса Саса...
Dialogue: 0,0:06:12.12,0:06:14.54,Default,,0,0,0,,Жоқ, бұл сынақта болмайды.
Dialogue: 0,0:06:14.62,0:06:15.83,Default,,0,0,0,,Соңында…
Dialogue: 0,0:06:15.91,0:06:17.83,Default,,0,0,0,,Ақырында, ақырында, ақырында...
Dialogue: 0,0:06:17.91,0:06:20.33,Default,,0,0,0,,Онагава Бұл сөз есіңізде, солай ма?
Dialogue: 0,0:06:20.42,0:06:21.50,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:21.58,0:06:24.88,Default,,0,0,0,,Барлық сөздер Tantan Girls әндерінен алынған.
Dialogue: 0,0:06:24.96,0:06:27.05,Default,,0,0,0,,Рахмет... Макон
Dialogue: 0,0:06:28.17,0:06:29.13,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:06:28.17,0:06:29.13,Default,,0,0,0,,Ма-чон Ма-чон Ма-чон…
Dialogue: 0,0:06:29.13,0:06:29.22,Default,,0,0,0,,Ма-чон Ма-чон Ма-чон…
Dialogue: 0,0:06:29.22,0:06:31.30,Default,,0,0,0,,Ма-чон Ма-чон Ма-чон…
Dialogue: 0,0:06:29.22,0:06:31.30,Default,,0,0,0,,Бамбук шөпі!
Dialogue: 0,0:06:31.30,0:06:31.39,Default,,0,0,0,,Ма-чон Ма-чон Ма-чон…
Dialogue: 0,0:06:31.39,0:06:32.68,Default,,0,0,0,,Ма-чон Ма-чон Ма-чон…
Dialogue: 0,0:06:31.39,0:06:32.68,Default,,0,0,0,,Өйткені, ағылшын тілі болашақта қажет болады.
Dialogue: 0,0:06:32.68,0:06:32.76,Default,,0,0,0,,Өйткені, ағылшын тілі болашақта қажет болады.
Dialogue: 0,0:06:32.76,0:06:33.60,Default,,0,0,0,,Өйткені, ағылшын тілі болашақта қажет болады.
Dialogue: 0,0:06:32.76,0:06:33.60,Default,,0,0,0,,Я...
Dialogue: 0,0:06:33.68,0:06:35.31,Default,,0,0,0,,Егер сіз допты алсаңыз...
Dialogue: 0,0:06:35.39,0:06:37.43,Default,,0,0,0,,Саған қауіп төніп тұр, Мацуоның әпкесі, артқа тұр.
Dialogue: 0,0:06:37.52,0:06:39.60,Default,,0,0,0,,Өл~ Жоқ!
Dialogue: 0,0:06:39.69,0:06:41.23,Default,,0,0,0,,Теми! Қай топтан?
Dialogue: 0,0:06:41.85,0:06:43.77,Default,,0,0,0,,Джакаашии!
Dialogue: 0,0:06:43.86,0:06:45.78,Default,,0,0,0,,Қазір не оқып жатырсың?
Dialogue: 0,0:06:45.86,0:06:47.03,Default,,0,0,0,,Канджи
Dialogue: 0,0:06:57.08,0:06:58.16,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:06:59.21,0:07:00.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:00.71,0:07:03.50,Default,,0,0,0,,Мен үлкен жалау жасадым...
Dialogue: 0,0:07:03.58,0:07:05.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:05.71,0:07:06.75,Default,,0,0,0,,Флютер
Dialogue: 0,0:07:06.84,0:07:08.84,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:07:08.92,0:07:11.51,Default,,0,0,0,,Flutter оны құрастырған
Dialogue: 0,0:07:11.59,0:07:15.14,Default,,0,0,0,,Тұлғаның белгісі…
Dialogue: 0,0:07:15.22,0:07:16.47,Default,,0,0,0,,Тәсіл
Dialogue: 0,0:07:16.56,0:07:20.06,Default,,0,0,0,,Мисато-кун, сен енді қайдан білесің?
Dialogue: 0,0:07:20.14,0:07:22.73,Default,,0,0,0,,Бұл туралы бәрі есімде.
Dialogue: 0,0:07:23.23,0:07:24.94,Default,,0,0,0,,Мисато-кун, күткендей...
Dialogue: 0,0:07:25.02,0:07:27.40,Default,,0,0,0,,Пар... (Мисато) Бұл фект емес.
Dialogue: 0,0:07:31.95,0:07:34.53,Default,,0,0,0,,Иә? Үлкендеріңіз ше?
Dialogue: 0,0:07:34.62,0:07:36.03,Default,,0,0,0,,Сол жақта.
Dialogue: 0,0:07:36.12,0:07:36.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.37,0:07:39.20,Default,,0,0,0,,Я...
Dialogue: 0,0:07:39.29,0:07:40.91,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:07:41.00,0:07:43.50,Default,,0,0,0,,Басыңды пайдалансаң, қарның аш...
Dialogue: 0,0:07:43.58,0:07:44.96,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:45.04,0:07:47.92,Default,,0,0,0,,Мен оны онша көп қолданбаймын деп ойлаймын...
Dialogue: 0,0:07:48.71,0:07:50.76,Default,,0,0,0,,Шотаро жақсы оқыды ма?
Dialogue: 0,0:07:50.84,0:07:51.76,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:51.84,0:07:52.68,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:07:52.76,0:07:54.64,Default,,0,0,0,,Иә! (Цукидате) Ахахха...
Dialogue: 0,0:07:54.72,0:07:56.35,Default,,0,0,0,,Футаба, оны маған аша аласыз ба?
Dialogue: 0,0:07:56.43,0:07:57.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:57.85,0:07:59.72,Default,,0,0,0,,Мисато-кун, бұл...
Dialogue: 0,0:07:59.81,0:08:00.77,Default,,0,0,0,,Кешкі ас
Dialogue: 0,0:08:00.85,0:08:02.35,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:08:02.44,0:08:03.27,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:08:02.44,0:08:03.27,Default,,0,0,0,,Сіз өте мұқиятсыз Мисато (Ватари)
Dialogue: 0,0:08:03.27,0:08:04.40,Default,,0,0,0,,Сіз өте мұқиятсыз Мисато (Ватари)
Dialogue: 0,0:08:04.48,0:08:06.06,Default,,0,0,0,,Онигири~ (Ватари) Ахх...
Dialogue: 0,0:08:06.15,0:08:08.40,Default,,0,0,0,,Мен көп нәрсе жасадым, сондықтан оны толтыруым керек.
Dialogue: 0,0:08:08.48,0:08:10.28,Default,,0,0,0,,Уау, бұл дәмді көрінеді! (Ватари) Қарғыс атсын...
Dialogue: 0,0:08:10.36,0:08:11.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:11.78,0:08:12.99,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:08:13.07,0:08:15.99,Default,,0,0,0,,Шабаның тамағы менің ішімді ауыртады!
Dialogue: 0,0:08:16.74,0:08:20.24,Default,,0,0,0,,Егер қызыл нүкте алсаңыз, төсенішті пайдалана алмайсыз деген ережелер бар.
Dialogue: 0,0:08:20.33,0:08:22.25,Default,,0,0,0,,Басқа бөлімдер де бар ма?
Dialogue: 0,0:08:22.33,0:08:24.21,Default,,0,0,0,,Біз ғана шығармыз
Dialogue: 0,0:08:24.29,0:08:28.46,Default,,0,0,0,,Көркем гимнастикадан ерлер үйірмесі құрылғанда мен директорға уәде бердім.
Dialogue: 0,0:08:28.54,0:08:29.96,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:08:30.05,0:08:32.01,Default,,0,0,0,,Директор маған орын жасап берді...
Dialogue: 0,0:08:32.09,0:08:33.55,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:08:33.63,0:08:36.30,Default,,0,0,0,,Бұл сіз бірге клуб құрдыңыз дегенді білдіре ме?
Dialogue: 0,0:08:36.39,0:08:37.30,Default,,0,0,0,,Жоқ. Сенің мақсатың не екенін білмеймін, бірақ бұл күмәнді.
Dialogue: 0,0:08:37.39,0:08:39.10,Default,,0,0,0,,Бірақ директор?
Dialogue: 0,0:08:39.18,0:08:41.22,Default,,0,0,0,,Ол Ширанари университетінің эйсе болды, солай ма?
Dialogue: 0,0:08:41.31,0:08:43.60,Default,,0,0,0,,Ол данышпан ойыншы.
Dialogue: 0,0:08:44.19,0:08:46.40,Default,,0,0,0,,Егер мен жарысты бұрынғыдай жалғастырсам.
Dialogue: 0,0:08:46.48,0:08:48.06,Default,,0,0,0,,Ерлер көркем гимнастикасының тарихы
Dialogue: 0,0:08:48.15,0:08:50.48,Default,,0,0,0,,Біреулер мені өзгердім дейді.
Dialogue: 0,0:08:50.57,0:08:51.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:55.07,0:08:56.61,Default,,0,0,0,,Шусаку
Dialogue: 0,0:08:56.70,0:09:00.28,Default,,0,0,0,,(дыбысты жазу)
Dialogue: 0,0:09:01.20,0:09:04.12,Default,,0,0,0,,(Қашықтан басқару пультінің дыбысы)
Dialogue: 0,0:09:04.21,0:09:05.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:06.92,0:09:08.83,Default,,0,0,0,,(дыбысты ескеру)
Dialogue: 0,0:09:08.92,0:09:09.84,Default,,0,0,0,,Шусаку
Dialogue: 0,0:09:09.92,0:09:11.34,Default,,0,0,0,,Ой… бұл қорқынышты!
Dialogue: 0,0:09:11.42,0:09:12.55,Default,,0,0,0,,Күріш
Dialogue: 0,0:09:12.63,0:09:14.97,Default,,0,0,0,,Екінші нұсқау: Күзетшіге пышақ, тапанша немесе ұялы телефон сияқты заттарды алып жүруге рұқсат етілмейді
Dialogue: 0,0:09:15.05,0:09:16.26,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:16.34,0:09:18.97,Default,,0,0,0,,Мисато-кун мен үшін жасады.
Dialogue: 0,0:09:19.05,0:09:20.60,Default,,0,0,0,,Дәмді көрінеді.
Dialogue: 0,0:09:21.26,0:09:23.56,Default,,0,0,0,,Мен өте шоғырландым.
Dialogue: 0,0:09:23.64,0:09:24.52,Default,,0,0,0,,Иә
Dialogue: 0,0:09:24.60,0:09:27.85,Default,,0,0,0,,Қазір барлығын көру бір қызық.
Dialogue: 0,0:09:27.94,0:09:32.07,Default,,0,0,0,,Соңғы кездері мен ескі Шусакуға біраз оралған сияқтымын.
Dialogue: 0,0:09:32.15,0:09:33.61,Default,,0,0,0,,Иә! Өтірік?
Dialogue: 0,0:09:33.69,0:09:35.53,Default,,0,0,0,,Көздеріңіз нашарлап барады ма?
Dialogue: 0,0:09:35.61,0:09:36.86,Default,,0,0,0,,Я...
Dialogue: 0,0:09:36.95,0:09:40.58,Default,,0,0,0,,Мен өзімнің ескі мінезімді ұнатпаймын...
Dialogue: 0,0:09:40.66,0:09:41.74,Default,,0,0,0,,1-курс жиналысы!
Dialogue: 0,0:09:41.83,0:09:43.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:43.12,0:09:45.75,Default,,0,0,0,,Бүгіннен бастап жаттығу мәзірін өзгертіңіз
Dialogue: 0,0:09:45.83,0:09:47.29,Default,,0,0,0,,Шынайы ма? (1 жыл) Мен өлемін...
Dialogue: 0,0:09:47.37,0:09:48.50,Default,,0,0,0,,Жауап беріңіз!
Dialogue: 0,0:09:48.58,0:09:50.13,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,0:09:50.21,0:09:53.21,Default,,0,0,0,,Уақыт босқа кетті, Мабучи-сенпай.
Dialogue: 0,0:09:53.92,0:09:56.59,Default,,0,0,0,,Сайысқа барыңды сал
Dialogue: 0,0:09:56.67,0:10:00.76,Default,,0,0,0,,Олай істей алмайтындарға не үйретсең де...
Dialogue: 0,0:10:00.85,0:10:02.22,Default,,0,0,0,,Шида…
Dialogue: 0,0:10:02.31,0:10:03.18,Default,,0,0,0,,Және...
Dialogue: 0,0:10:03.26,0:10:06.68,Default,,0,0,0,,Сізден төмен деңгейлі қоқыс көрінгенде
Dialogue: 0,0:10:06.77,0:10:08.02,Default,,0,0,0,,Жәндіктер жүгіреді
Dialogue: 0,0:10:08.10,0:10:09.48,Default,,0,0,0,,Жаңа ғана бірдеңе айтпадың ба?
Dialogue: 0,0:10:09.56,0:10:11.02,Default,,0,0,0,,Мен дұрыс жаттығып жатырмын.
Dialogue: 0,0:10:11.61,0:10:12.69,Default,,0,0,0,,Уау (Мабучи) Эй!
Dialogue: 0,0:10:17.24,0:10:18.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:18.36,0:10:19.32,Default,,0,0,0,,Я...
Dialogue: 0,0:10:20.57,0:10:23.33,Default,,0,0,0,,Жоқ, рақмет.
Dialogue: 0,0:10:23.41,0:10:25.79,Default,,0,0,0,,Мұндай ғажайып адам қалай болуы мүмкін?
Dialogue: 0,0:10:25.87,0:10:28.66,Default,,0,0,0,,Ол турнирден бір күн бұрын жарақат алғанын айтты.
Dialogue: 0,0:10:28.75,0:10:31.50,Default,,0,0,0,,Оны жасырып, ойынға өтіңіз
Dialogue: 0,0:10:33.71,0:10:35.34,Default,,0,0,0,,Гах... Гах!
Dialogue: 0,0:10:35.42,0:10:36.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:35.42,0:10:36.59,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:10:36.67,0:10:38.92,Default,,0,0,0,,Гррр...
Dialogue: 0,0:10:39.01,0:10:41.51,Default,,0,0,0,,Шида! Шида!
Dialogue: 0,0:10:42.47,0:10:45.47,Default,,0,0,0,,Неліктен жарақатыңыз туралы үндемей қалдыңыз?
Dialogue: 0,0:10:46.35,0:10:49.23,Default,,0,0,0,,Амал жоқ, енді...
Dialogue: 0,0:10:49.77,0:10:52.98,Default,,0,0,0,,Мен ертең жоқ сияқты әрекет етемін.
Dialogue: 0,0:10:53.52,0:10:56.03,Default,,0,0,0,,Сол сәтте өміріңді өртеп жібер
Dialogue: 0,0:10:56.11,0:10:59.07,Default,,0,0,0,,Сонымен... нәтиже осы ма?
Dialogue: 0,0:10:59.15,0:11:00.91,Default,,0,0,0,,Мен тағы да...
Dialogue: 0,0:11:00.99,0:11:03.12,Default,,0,0,0,,Мен міндетті түрде секіремін!
Dialogue: 0,0:11:14.96,0:11:18.21,Default,,0,0,0,,(неміс)
Dialogue: 0,0:11:30.77,0:11:32.10,Default,,0,0,0,,(Қабырға қағу дыбысы)
Dialogue: 0,0:11:32.60,0:11:33.60,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:11:34.11,0:11:35.52,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:11:42.45,0:11:44.95,Default,,0,0,0,,Сізді ауруханадан шығуыңызбен құттықтаймыз
Dialogue: 0,0:11:45.03,0:11:46.28,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:46.37,0:11:48.04,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:11:48.12,0:11:48.95,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:11:49.54,0:11:51.87,Default,,0,0,0,,Сол жерде басың айналып жатыр ма?
Dialogue: 0,0:11:51.96,0:11:54.42,Default,,0,0,0,,Жапонияға қайтып барып, бас айналуым керек пе?
Dialogue: 0,0:11:54.50,0:11:57.96,Default,,0,0,0,,Менің де ертең істейтін жұмысым жоқ, сондықтан мен қалағанымды істеймін.
Dialogue: 0,0:12:01.67,0:12:03.68,Default,,0,0,0,,Сіз жаяу жүрсіз бе?
Dialogue: 0,0:12:03.76,0:12:05.18,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:05.26,0:12:07.60,Default,,0,0,0,,Шида мырза кетіп бара жатыр.
Dialogue: 0,0:12:07.68,0:12:10.39,Default,,0,0,0,,Мен жүре алсам да, қолымнан ештеңе келмейді...
Dialogue: 0,0:12:10.47,0:12:13.19,Default,,0,0,0,,Мен барынша тырыстым және қалыпты жүре алдым.
Dialogue: 0,0:12:13.27,0:12:16.94,Default,,0,0,0,,Егер мен қатты тырыспасам, мен бұлай істей алмас едім.
Dialogue: 0,0:12:17.02,0:12:20.07,Default,,0,0,0,,Еңбегіңді жоққа шығарма
Dialogue: 0,0:12:20.65,0:12:25.32,Default,,0,0,0,,Ертеңгі күні ерінбей еңбек еткенде жақсы нәрсе болатын шығар.
Dialogue: 0,0:12:27.49,0:12:28.33,Default,,0,0,0,,Неке?
Dialogue: 0,0:12:28.41,0:12:30.45,Default,,0,0,0,,Аа, қарсы тарап кім?
Dialogue: 0,0:12:30.54,0:12:32.00,Default,,0,0,0,,Мен сол жерде кездестірген адам
Dialogue: 0,0:12:32.08,0:12:35.17,Default,,0,0,0,,Шида... Шусаку дедің бе?
Dialogue: 0,0:12:35.25,0:12:38.25,Default,,0,0,0,,Ол Шило университетінде гимнаст болды...
Dialogue: 0,0:12:38.34,0:12:40.75,Default,,0,0,0,,Иә? Бұл көркем гимнастика болды ма?
Dialogue: 0,0:12:40.84,0:12:43.97,Default,,0,0,0,,Аа~ Ерлерге арналған көркем гимнастика деген бар ма?
Dialogue: 0,0:12:44.05,0:12:45.89,Default,,0,0,0,,Бар сияқты.
Dialogue: 0,0:12:45.97,0:12:48.10,Default,,0,0,0,,Мен де ертеңгі жиналысқа барамын.
Dialogue: 0,0:12:48.18,0:12:49.56,Default,,0,0,0,,Киім Мен не істеуім керек?
Dialogue: 0,0:12:49.64,0:12:51.27,Default,,0,0,0,,Не жақсы?
Dialogue: 0,0:12:51.35,0:12:53.89,Default,,0,0,0,,Сіз таңды тыңдайсыз ба?
Dialogue: 0,0:12:53.98,0:12:56.40,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:12:59.40,0:13:00.36,Default,,0,0,0,,(шишиодоши дыбысы)
Dialogue: 0,0:13:00.94,0:13:04.07,Default,,0,0,0,,Танысқаныма қуаныштымын, Асао-чан, танысқаныма қуаныштымын.
Dialogue: 0,0:13:04.15,0:13:05.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:05.24,0:13:06.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:07.49,0:13:09.33,Default,,0,0,0,,Бірдеңе дұрыс емес (Шида) Иә?
Dialogue: 0,0:13:09.41,0:13:11.95,Default,,0,0,0,,Сіз енді көркем гимнастикамен айналыспайсыз ба?
Dialogue: 0,0:13:12.04,0:13:13.33,Default,,0,0,0,,Ойыншы ретінде.
Dialogue: 0,0:13:14.62,0:13:16.83,Default,,0,0,0,,Мен жаттықтырушы болуды ойлап жүрмін.
Dialogue: 0,0:13:17.75,0:13:18.67,Default,,0,0,0,,Шида?
Dialogue: 0,0:13:18.75,0:13:20.71,Default,,0,0,0,,О, Широ өлшемі?
Dialogue: 0,0:13:20.79,0:13:23.46,Default,,0,0,0,,Дәл қазір қолымыз жетеді.
Dialogue: 0,0:13:24.92,0:13:27.34,Default,,0,0,0,,Мүшелер саны аз.
Dialogue: 0,0:13:27.43,0:13:30.39,Default,,0,0,0,,Кешіріңіз, бірақ басқа нәрсе іздеп көре аласыз ба?
Dialogue: 0,0:13:30.97,0:13:32.77,Default,,0,0,0,,Бұл тағы да Шида-сенпай.
Dialogue: 0,0:13:32.85,0:13:33.68,Default,,0,0,0,,Аха…
Dialogue: 0,0:13:34.35,0:13:35.56,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:13:36.14,0:13:39.90,Default,,0,0,0,,Дәл қазір Широ университетінде және Широ жоғарыда адамдар жеткіліксіз.
Dialogue: 0,0:13:39.98,0:13:42.86,Default,,0,0,0,,Егер менде қандай да бір идея болса, мен сізге қоңырау шалуға тырысамын.
Dialogue: 0,0:13:42.94,0:13:46.90,Default,,0,0,0,,Иә, кешіріңіз, рахмет.
Dialogue: 0,0:13:47.70,0:13:51.45,Default,,0,0,0,,Тіпті Мабучи-сенпайдың өтініші бойынша ол кісі...
Dialogue: 0,0:13:51.53,0:13:53.99,Default,,0,0,0,,Ол маған не деді?
Dialogue: 0,0:13:54.08,0:13:56.25,Default,,0,0,0,,Мен бәрібір маскүнеммін.
Dialogue: 0,0:13:56.33,0:13:59.12,Default,,0,0,0,,Шида-сан да астынан ештеңе кимейді.
Dialogue: 0,0:14:02.63,0:14:04.63,Default,,0,0,0,,Сіз шештіңіз бе? Қайда?
Dialogue: 0,0:14:04.71,0:14:06.13,Default,,0,0,0,,Бұл Ао Така.
Dialogue: 0,0:14:06.22,0:14:08.97,Default,,0,0,0,,Жеке Сошукан орта мектебі
Dialogue: 0,0:14:09.05,0:14:11.93,Default,,0,0,0,,Ао орта мектебінде ұлдарға арналған көркем гимнастика үйірмесі болды ма?
Dialogue: 0,0:14:12.01,0:14:13.26,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:14:13.35,0:14:16.98,Default,,0,0,0,,Мен сізге ағылшын тілін үйретемін және газет үйірмесіне кеңесші боламын.
Dialogue: 0,0:14:17.06,0:14:19.40,Default,,0,0,0,,үшін үшін көп рахмет.
Dialogue: 0,0:14:19.48,0:14:20.44,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:14:27.07,0:14:28.11,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:14:37.54,0:14:39.46,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:14:47.97,0:14:49.63,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:14:52.05,0:14:52.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:53.47,0:14:54.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:54.47,0:14:55.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:57.43,0:14:58.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:01.69,0:15:03.61,Default,,0,0,0,,Уау! Хаха...
Dialogue: 0,0:15:03.69,0:15:06.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:06.15,0:15:07.11,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:07.19,0:15:08.53,Default,,0,0,0,,О, бұл керемет! (Шида) Әй!
Dialogue: 0,0:15:08.61,0:15:10.07,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:15:10.15,0:15:11.61,Default,,0,0,0,,Айтыңызшы, бұл не!
Dialogue: 0,0:15:11.70,0:15:12.70,Default,,0,0,0,,Мен де Мен де~
Dialogue: 0,0:15:12.78,0:15:13.70,Default,,0,0,0,,Батырға ұқсайды! (Шида) А?
Dialogue: 0,0:15:13.78,0:15:15.49,Default,,0,0,0,,(Ұлдардың дауысы)
Dialogue: 0,0:15:16.66,0:15:17.49,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:17.58,0:15:18.62,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:15:18.70,0:15:21.83,Default,,0,0,0,,Сіз кері айналдыруды үйрендім дедіңіз, солай ма?
Dialogue: 0,0:15:21.92,0:15:22.96,Default,,0,0,0,,О
Dialogue: 0,0:15:23.04,0:15:25.92,Default,,0,0,0,,Цукидате мен Онагава да бірге.
Dialogue: 0,0:15:26.00,0:15:29.59,Default,,0,0,0,,Аомориде орта аралық мектеп болған кезде мені сонда апарды.
Dialogue: 0,0:15:30.17,0:15:33.59,Default,,0,0,0,,Мен көрген бірінші топ керемет болды...
Dialogue: 0,0:15:33.68,0:15:35.05,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:15:35.80,0:15:37.97,Default,,0,0,0,,Сіз орта мектепке қайда баруды шештіңіз бе?
Dialogue: 0,0:15:38.06,0:15:40.27,Default,,0,0,0,,Ах... біз...
Dialogue: 0,0:15:41.64,0:15:42.48,Default,,0,0,0,,Біз
Dialogue: 0,0:15:42.56,0:15:45.02,Default,,0,0,0,,Мен Шида-санның орта мектебіне барғым келеді!
Dialogue: 0,0:15:45.11,0:15:48.48,Default,,0,0,0,,Сондықтан мен топ болып көркем гимнастикамен айналысқым келеді!
Dialogue: 0,0:15:48.57,0:15:49.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:49.49,0:15:53.41,Default,,0,0,0,,Ах... Бірақ Ао орта мектебінде ұлдарға арналған көркем гимнастика үйірмесі жоқ.
Dialogue: 0,0:15:53.49,0:15:54.74,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:55.32,0:15:57.03,Default,,0,0,0,,Егер бұл басқа орта мектеп болса...
Dialogue: 0,0:15:57.12,0:15:59.83,Default,,0,0,0,,Иә, Сендай Токуо сияқты нәрсе ме?
Dialogue: 0,0:15:59.91,0:16:01.83,Default,,0,0,0,,Қаласаңыз, мен бір рет экскурсияға барғым келеді.
Dialogue: 0,0:16:01.91,0:16:04.33,Default,,0,0,0,,Біреуін жасасам жарамайды ма?
Dialogue: 0,0:16:04.42,0:16:06.00,Default,,0,0,0,,Көркем гимнастикадан ерлер үйірмесі
Dialogue: 0,0:16:06.09,0:16:07.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:07.21,0:16:10.13,Default,,0,0,0,,Біз Ао орта мектебінде ұлдар көркем гимнастика үйірмесін ашамыз.
Dialogue: 0,0:16:10.21,0:16:11.59,Default,,0,0,0,,Міне, бастаймыз!
Dialogue: 0,0:16:11.67,0:16:13.88,Default,,0,0,0,,Байыпты ойланыңыз
Dialogue: 0,0:16:13.97,0:16:16.89,Default,,0,0,0,,Өйткені, бұл сіздің қолыңыздан келетін жалғыз нәрсе.
Dialogue: 0,0:16:17.51,0:16:18.93,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:16:19.01,0:16:19.85,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:19.93,0:16:21.35,Default,,0,0,0,,Міне!
Dialogue: 0,0:16:21.43,0:16:22.27,Default,,0,0,0,,Шида мырза?
Dialogue: 0,0:16:22.35,0:16:24.98,Default,,0,0,0,,Мен сізге орын жасап беремін!
Dialogue: 0,0:16:25.06,0:16:27.86,Default,,0,0,0,,Біз ерлер көркем гимнастика үйірмесін міндетті түрде құрамыз!
Dialogue: 0,0:16:29.53,0:16:30.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:30.44,0:16:31.78,Default,,0,0,0,,Қараңыз~
Dialogue: 0,0:16:31.86,0:16:32.90,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:16:32.99,0:16:36.03,Default,,0,0,0,,Хахахаха... Сен оны Онагаваға жасадың.
Dialogue: 0,0:16:36.12,0:16:38.62,Default,,0,0,0,,Иә? Ерлер көркем гимнастика үйірмесі?
Dialogue: 0,0:16:38.70,0:16:41.83,Default,,0,0,0,,Иә! Міне, материалдар
Dialogue: 0,0:16:41.91,0:16:43.62,Default,,0,0,0,,Қарап көріңізші!
Dialogue: 0,0:16:44.42,0:16:47.21,Default,,0,0,0,,Осы уақытқа дейін неге байқамадым деп ойлаймын.
Dialogue: 0,0:16:47.29,0:16:50.96,Default,,0,0,0,,Менің ішімде әлі де тәттілік бар екеніне сенімдімін.
Dialogue: 0,0:16:51.05,0:16:54.30,Default,,0,0,0,,Мен эйс болдым деп мақтаған кезде қандай сезімде болдым
Dialogue: 0,0:16:54.80,0:16:56.84,Default,,0,0,0,,Біреу қол ұшын созады
Dialogue: 0,0:16:57.51,0:17:00.81,Default,,0,0,0,,Мені қабылдайтын бір жер бар
Dialogue: 0,0:17:01.68,0:17:04.44,Default,,0,0,0,,Бірақ мұндай нәрсе болған жоқ.
Dialogue: 0,0:17:04.52,0:17:06.56,Default,,0,0,0,,Мен мұны өзім жасауым керек еді.
Dialogue: 0,0:17:06.65,0:17:09.61,Default,,0,0,0,,Қызық сияқты, хехе...
Dialogue: 0,0:17:10.32,0:17:13.61,Default,,0,0,0,,Директордың орынбасары, сіз бейнені көрдіңіз бе?
Dialogue: 0,0:17:13.69,0:17:15.11,Default,,0,0,0,,Оны көру мүмкін емес.
Dialogue: 0,0:17:15.20,0:17:16.99,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:17:17.07,0:17:18.87,Default,,0,0,0,,Өйткені қажеттілік жоқ
Dialogue: 0,0:17:18.95,0:17:23.04,Default,,0,0,0,,Ерлердің көркем гимнастикасының тартымдылығын көрмейінше түсіне алмайсың.
Dialogue: 0,0:17:23.62,0:17:25.33,Default,,0,0,0,,Қарамай-ақ айта аласыз
Dialogue: 0,0:17:25.41,0:17:29.50,Default,,0,0,0,,Мұндай үйірме құрудың мектебімізге пайдасы жоқ.
Dialogue: 0,0:17:29.59,0:17:31.17,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:17:32.21,0:17:33.26,Default,,0,0,0,,Директордың орынбасары!
Dialogue: 0,0:17:33.84,0:17:35.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:35.34,0:17:36.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:37.84,0:17:38.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:43.27,0:17:44.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:46.77,0:17:47.77,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:51.07,0:17:53.69,Default,,0,0,0,,Нағыз ерлердің көркем гимнастикасы мұндай емес.
Dialogue: 0,0:17:54.36,0:17:58.91,Default,,0,0,0,,Көп есе, он есе, жүздеген есе күшті және әдемі
Dialogue: 0,0:17:59.62,0:18:01.24,Default,,0,0,0,,Тым болмаса бір қараңызшы!
Dialogue: 0,0:18:01.33,0:18:03.58,Default,,0,0,0,,Мұқият қарап, ойланыңыз!
Dialogue: 0,0:18:04.16,0:18:05.54,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:18:06.66,0:18:09.37,Default,,0,0,0,,Сіз әкелген көп материалдармен
Dialogue: 0,0:18:09.46,0:18:12.67,Default,,0,0,0,,Ерлердің көркем гимнастикасы туралы жалпы түсінігім бар.
Dialogue: 0,0:18:12.75,0:18:15.42,Default,,0,0,0,,Жатақхана басқа үйірмелерге толы.
Dialogue: 0,0:18:15.51,0:18:17.93,Default,,0,0,0,,Қоймадағы бос бөлме жақсы.
Dialogue: 0,0:18:18.59,0:18:20.80,Default,,0,0,0,,Арнайы төсеніш бар, солай ма?
Dialogue: 0,0:18:20.89,0:18:23.60,Default,,0,0,0,,Бұл үшін бюджет жоқ.
Dialogue: 0,0:18:23.68,0:18:26.06,Default,,0,0,0,,Мен Акайо университетінен төсеніш алуды жоспарлап отырмын.
Dialogue: 0,0:18:26.14,0:18:30.06,Default,,0,0,0,,Бет сүйектері дұрыс па?
Dialogue: 0,0:18:36.40,0:18:37.65,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:18:37.74,0:18:41.28,Default,,0,0,0,,Мен Акайо университетіне де өтініш жасаймын.
Dialogue: 0,0:18:43.70,0:18:44.99,Default,,0,0,0,,Аға
Dialogue: 0,0:18:45.08,0:18:48.21,Default,,0,0,0,,Неліктен мен үшін мұны істейсің?
Dialogue: 0,0:18:49.41,0:18:51.54,Default,,0,0,0,,Сіз данышпан емессіз.
Dialogue: 0,0:18:52.67,0:18:55.30,Default,,0,0,0,,Сіз тырысып жатқаныңызды білемін.
Dialogue: 0,0:18:55.38,0:18:57.76,Default,,0,0,0,,Бұл шын болды
Dialogue: 0,0:18:58.38,0:19:01.22,Default,,0,0,0,,Оның жаман мінезі де шын еді.
Dialogue: 0,0:19:02.05,0:19:04.97,Default,,0,0,0,,Неліктен мұндай әрекетке барар едіңіз?
Dialogue: 0,0:19:05.47,0:19:08.23,Default,,0,0,0,,Тағы да сол балалармен...
Dialogue: 0,0:19:09.81,0:19:13.19,Default,,0,0,0,,Мен қайтадан секіретін сияқтымын.
Dialogue: 0,0:19:19.28,0:19:20.11,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:20.20,0:19:22.11,Default,,0,0,0,,Хэхе... (Цукидате) О~
Dialogue: 0,0:19:22.20,0:19:23.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:23.62,0:19:24.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:29.66,0:19:33.71,Default,,0,0,0,,Оо, бұл жақсы сезінуі мүмкін!
Dialogue: 0,0:19:33.79,0:19:36.21,Default,,0,0,0,,Шида мырза... Жоқ, директор
Dialogue: 0,0:19:36.30,0:19:37.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:37.38,0:19:39.76,Default,,0,0,0,,Біз де уәде береміз
Dialogue: 0,0:19:39.84,0:19:42.93,Default,,0,0,0,,Мен директорды орта мектепке міндетті түрде әкелемін!
Dialogue: 0,0:19:43.01,0:19:44.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:44.97,0:19:45.85,Default,,0,0,0,,Иә
Dialogue: 0,0:19:45.93,0:19:47.43,Default,,0,0,0,,Мен жақсы оқимын!
Dialogue: 0,0:19:47.51,0:19:49.73,Default,,0,0,0,,Мен ешқашан қызыл ұпай алмаймын!
Dialogue: 0,0:19:49.81,0:19:51.85,Default,,0,0,0,,Алынса, 1 жыл
Dialogue: 0,0:19:51.94,0:19:54.81,Default,,0,0,0,,Бұл гимназияны енді пайдалана алмасаңыз, маңызды емес.
Dialogue: 0,0:19:54.90,0:19:56.23,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:19:56.32,0:19:58.98,Default,,0,0,0,,Иә! Ер адамға екі сөз жоқ!
Dialogue: 0,0:19:59.65,0:20:01.90,Default,,0,0,0,,Өтінемін, Шичигахама-кун...
Dialogue: 0,0:20:01.99,0:20:02.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:03.66,0:20:04.74,Default,,0,0,0,,Не! Гваааах!
Dialogue: 0,0:20:06.62,0:20:07.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:07.66,0:20:10.37,Default,,0,0,0,,Сондықтан сіз ешқашан қызыл ұпай ала алмайсыз.
Dialogue: 0,0:20:11.00,0:20:13.42,Default,,0,0,0,,Мен оқуға барамын!
Dialogue: 0,0:20:14.25,0:20:16.08,Default,,0,0,0,,Менде біраз алаңдаушылық бар.
Dialogue: 0,0:20:16.17,0:20:18.00,Default,,0,0,0,,Иә? (Шичигахама) Бұл не?
Dialogue: 0,0:20:18.09,0:20:20.34,Default,,0,0,0,,Қазіргі капитан туралы айту.
Dialogue: 0,0:20:20.42,0:20:23.59,Default,,0,0,0,,Уәде берген директор емес...
Dialogue: 0,0:20:24.22,0:20:26.01,Default,,0,0,0,,Мен ешқашан қызыл ұпай алмаймын!
Dialogue: 0,0:20:26.09,0:20:27.64,Default,,0,0,0,,Алынса, 1 жыл
Dialogue: 0,0:20:27.72,0:20:31.06,Default,,0,0,0,,Бұл гимназияны енді пайдалана алмасаңыз, бәрібір.
Dialogue: 0,0:20:31.14,0:20:33.10,Default,,0,0,0,,...
Dialogue: 0,0:20:33.19,0:20:34.02,Default,,0,0,0,,Не!
Dialogue: 0,0:20:34.85,0:20:35.69,Default,,0,0,0,,О
Dialogue: 0,0:20:35.77,0:20:37.77,Default,,0,0,0,,Аа, сіз бұл туралы айтқан кезде ...
Dialogue: 0,0:20:37.86,0:20:39.44,Default,,0,0,0,,Менің кіші бауырым бар.
Dialogue: 0,0:20:39.52,0:20:42.44,Default,,0,0,0,,Менен сұрасаң жоқ!
Dialogue: 0,0:20:42.53,0:20:45.20,Default,,0,0,0,,Шичигахама~! (Шичигахама) Жоооу!
Dialogue: 0,0:20:45.28,0:20:46.99,Default,,0,0,0,,Сіз үшін! Біз ~!
Dialogue: 0,0:20:46.99,0:20:48.91,Default,,0,0,0,,Сіз үшін! Біз ~!
Dialogue: 0,0:20:46.99,0:20:48.91,Default,,0,0,0,,Мен сені бұл жолы кешіре алмаймын!
Dialogue: 0,0:20:48.99,0:20:51.04,Default,,0,0,0,,Мен сені кешіре алмаймын!
Dialogue: 0,0:20:48.99,0:20:51.04,Default,,0,0,0,,Ах, мен өзімді сергек сезінемін.
Dialogue: 0,0:20:51.04,0:20:52.25,Default,,0,0,0,,А, мен сергек болдым.
Dialogue: 0,0:20:52.33,0:20:54.83,Default,,0,0,0,,Иә! Мисато-кун, барасың ба?
Dialogue: 0,0:20:54.92,0:20:56.75,Default,,0,0,0,,Бомбаларды лақтыра беріңіз!
Dialogue: 0,0:20:56.83,0:20:58.79,Default,,0,0,0,,Мен бұл біртүрлі деп ойладым!
Dialogue: 0,0:20:58.88,0:21:00.46,Default,,0,0,0,,Директор осылай айту керек еді...
Dialogue: 0,0:21:00.55,0:21:01.46,Default,,0,0,0,,Сіздің таңдауыңыз жоқ!
Dialogue: 0,0:21:01.55,0:21:03.97,Default,,0,0,0,,Ер адам ретінде директордың мен үшін көп нәрсе істеуі...
Dialogue: 0,0:21:04.05,0:21:06.01,Default,,0,0,0,,Олай етпе!
Dialogue: 0,0:21:04.05,0:21:06.01,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:21:06.09,0:21:07.64,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:21:09.60,0:21:12.89,Default,,0,0,0,,Соған қарамастан біз қолымыздан келгеннің бәрін жасай алдық...
Dialogue: 0,0:21:12.98,0:21:15.94,Default,,0,0,0,,Қадағалау! үшін қызыл нүктелерден аулақ болды!
Dialogue: 0,0:21:16.52,0:21:17.65,Default,,0,0,0,,Иә
Dialogue: 0,0:21:17.73,0:21:19.52,Default,,0,0,0,,Олай болса, бастайық.
Dialogue: 0,0:21:19.61,0:21:20.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:22.07,0:21:25.28,Default,,0,0,0,,Бүгін біз де секіреміз
Dialogue: 0,0:21:26.11,0:21:31.12,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.99,0:22:55.99,Default,,0,0,0,,～♪
