Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.89,0:00:17.85,Default,,0,0,0,,Бұл керемет қойылым болды.
Dialogue: 0,0:00:17.93,0:00:19.72,Default,,0,0,0,,Широның биіктігі ...
Dialogue: 0,0:00:24.02,0:00:25.94,Default,,0,0,0,,Балалар
Dialogue: 0,0:00:26.44,0:00:29.86,Default,,0,0,0,,Шынымен де, қазір екеумізді салыстыруға болмайды...
Dialogue: 0,0:00:29.94,0:00:32.61,Default,,0,0,0,,Ах! Өтірік, жеңіл жеңіс!
Dialogue: 0,0:00:32.69,0:00:33.95,Default,,0,0,0,,Жау емес
Dialogue: 0,0:00:34.03,0:00:35.61,Default,,0,0,0,,Сәлем капитан
Dialogue: 0,0:00:37.99,0:00:38.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:39.33,0:00:40.74,Default,,0,0,0,,Капитан?
Dialogue: 0,0:00:51.09,0:00:52.17,Default,,0,0,0,,Е...
Dialogue: 0,0:00:52.26,0:00:54.09,Default,,0,0,0,,Тауық еті?
Dialogue: 0,0:00:54.17,0:00:57.14,Default,,0,0,0,,Сендай сиыр еті емес пе?
Dialogue: 0,0:00:57.22,0:01:00.14,Default,,0,0,0,,Жоқ, Такемонды қосуға болады...
Dialogue: 0,0:01:00.22,0:01:01.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:03.85,0:01:04.56,Default,,0,0,0,,Маширо, сенің мінезің нашар.
Dialogue: 0,0:01:04.56,0:01:05.48,Default,,0,0,0,,Маширо, сенің мінезің нашар.
Dialogue: 0,0:01:04.56,0:01:05.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:05.48,0:01:06.02,Default,,0,0,0,,Маширо, сенің мінезің нашар.
Dialogue: 0,0:01:06.10,0:01:06.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:08.48,0:01:10.65,Default,,0,0,0,,Саған бірдеңе көмектесе аламын ба?
Dialogue: 0,0:01:10.73,0:01:13.49,Default,,0,0,0,,Жоқ, сіз мұны қазір жасай аласыз.
Dialogue: 0,0:01:13.99,0:01:16.20,Default,,0,0,0,,Бөлмеңізді жинадыңыз ба?
Dialogue: 0,0:01:16.28,0:01:17.11,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:01:17.70,0:01:20.37,Default,,0,0,0,,Мен оны тазалауды ойладым...
Dialogue: 0,0:01:20.45,0:01:24.45,Default,,0,0,0,,Бұл күткеннен ертерек келген адам.
Dialogue: 0,0:01:24.54,0:01:25.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:25.71,0:01:26.54,Default,,0,0,0,,Бұл кәдесый.
Dialogue: 0,0:01:27.21,0:01:29.96,Default,,0,0,0,,Аомори мамандығы «Қызық алма»
Dialogue: 0,0:01:32.00,0:01:33.71,Default,,0,0,0,,Бұл алма ғой.
Dialogue: 0,0:01:34.30,0:01:35.51,Default,,0,0,0,,Сәлем, мистер Брифс
Dialogue: 0,0:01:35.59,0:01:36.72,Default,,0,0,0,,Брифс мырза?
Dialogue: 0,0:01:36.80,0:01:39.22,Default,,0,0,0,,Мен айттым ғой!
Dialogue: 0,0:01:39.30,0:01:41.39,Default,,0,0,0,,Өтінемін, маған біртүрлі ештеңе айтпа!
Dialogue: 0,0:01:41.47,0:01:44.39,Default,,0,0,0,,Бұл адам Шотаро Футаба.
Dialogue: 0,0:01:44.47,0:01:46.89,Default,,0,0,0,,Шотаро Футаба...
Dialogue: 0,0:01:46.98,0:01:49.40,Default,,0,0,0,,Футаччи? Шотаро?
Dialogue: 0,0:01:50.11,0:01:52.40,Default,,0,0,0,,Мисапон сонда емес пе?
Dialogue: 0,0:01:52.48,0:01:54.78,Default,,0,0,0,,Мисато-кун үйден жолға шығады.
Dialogue: 0,0:01:54.86,0:01:56.49,Default,,0,0,0,,Хмм.
Dialogue: 0,0:01:56.57,0:01:57.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:57.99,0:01:59.28,Default,,0,0,0,,Уау~
Dialogue: 0,0:02:00.78,0:02:02.16,Default,,0,0,0,,Сасакамабоко
Dialogue: 0,0:02:02.83,0:02:05.16,Default,,0,0,0,,Сасакамабоко…
Dialogue: 0,0:02:12.79,0:02:14.42,Default,,0,0,0,,Мм (3 адам) Аа!
Dialogue: 0,0:02:14.50,0:02:15.59,Default,,0,0,0,,Сәлем Маширо!
Dialogue: 0,0:02:15.67,0:02:16.76,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:02:16.84,0:02:17.67,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:02:17.76,0:02:20.51,Default,,0,0,0,,Сонымен бұл туралы не деуге болады?
Dialogue: 0,0:02:20.59,0:02:21.43,Default,,0,0,0,,Прототип -
Dialogue: 0,0:02:22.22,0:02:25.01,Default,,0,0,0,,Үгітілген алма қосылған карри дәмі
Dialogue: 0,0:02:25.10,0:02:27.98,Default,,0,0,0,,Хмм... Сізге де алма ұнайды, солай ма?
Dialogue: 0,0:02:28.06,0:02:29.73,Default,,0,0,0,,Жоқ, бұл алма емес.
Dialogue: 0,0:02:29.81,0:02:32.52,Default,,0,0,0,,Үгітілген алма қосылған карри дәмі!
Dialogue: 0,0:02:32.61,0:02:34.19,Default,,0,0,0,,Сонда бұл алма?
Dialogue: 0,0:02:34.27,0:02:35.02,Default,,0,0,0,,Бұл карри дәмі. (Тақасе) Бұл алма.
Dialogue: 0,0:02:35.02,0:02:36.19,Default,,0,0,0,,Бұл карри дәмі. (Тақасе) Бұл алма.
Dialogue: 0,0:02:35.02,0:02:36.19,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:02:36.19,0:02:36.28,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:02:36.28,0:02:37.49,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:02:36.28,0:02:37.49,Default,,0,0,0,,Сіз карри дейсіз бе? (Такасе) Алма!
Dialogue: 0,0:02:37.57,0:02:38.95,Default,,0,0,0,,Карри! (Такасе) Ринго!
Dialogue: 0,0:02:37.57,0:02:38.95,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:02:39.03,0:02:39.95,Default,,0,0,0,,Карри!
Dialogue: 0,0:02:40.03,0:02:45.03,Default,,0,0,0,,♪～
Dialogue: 0,0:04:04.86,0:04:09.87,Default,,0,0,0,,～♪
Dialogue: 0,0:04:10.54,0:04:12.87,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:04:12.96,0:04:15.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:18.71,0:04:20.21,Default,,0,0,0,,Шичигахама～
Dialogue: 0,0:04:20.30,0:04:22.01,Default,,0,0,0,,Мен оянамын~
Dialogue: 0,0:04:22.09,0:04:24.18,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:04:24.26,0:04:25.22,Default,,0,0,0,,Мұқаба
Dialogue: 0,0:04:29.89,0:04:31.68,Default,,0,0,0,,А... Қайырлы таң...
Dialogue: 0,0:04:32.93,0:04:34.31,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:04:34.39,0:04:35.48,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:35.56,0:04:37.86,Default,,0,0,0,,О (Цукидате) Қайырлы таң
Dialogue: 0,0:04:37.94,0:04:39.82,Default,,0,0,0,,Қайырлы таң (Футаба) Ах.
Dialogue: 0,0:04:40.57,0:04:42.36,Default,,0,0,0,,Қайырлы таң Мисато-кун
Dialogue: 0,0:04:42.44,0:04:44.86,Default,,0,0,0,,О, ерте құс
Dialogue: 0,0:04:44.95,0:04:46.78,Default,,0,0,0,,Ерте құс емес
Dialogue: 0,0:04:47.37,0:04:50.58,Default,,0,0,0,,Иә? Бірақ есік кілті әлі...
Dialogue: 0,0:04:50.66,0:04:52.79,Default,,0,0,0,,Біз оны ашық қалдырдық (Цукидате/Шичигахама) Ах!
Dialogue: 0,0:04:55.08,0:04:56.29,Default,,0,0,0,,Такасе!
Dialogue: 0,0:04:56.37,0:04:59.25,Default,,0,0,0,,Оны ашу дегеніңіз не!
Dialogue: 0,0:04:59.34,0:05:01.46,Default,,0,0,0,,Мен ерте тұрдым.
Dialogue: 0,0:05:01.55,0:05:03.97,Default,,0,0,0,,үшінна жүгіруге рұқсат берілді.
Dialogue: 0,0:05:04.05,0:05:05.09,Default,,0,0,0,,Не!
Dialogue: 0,0:05:05.17,0:05:07.01,Default,,0,0,0,,Мен өзімшіл деп ойладым, бірақ
Dialogue: 0,0:05:07.09,0:05:10.39,Default,,0,0,0,,Мен де жинап, таңғы ас әзірлей бастадым.
Dialogue: 0,0:05:13.81,0:05:14.64,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:14.73,0:05:17.48,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:17.56,0:05:19.40,Default,,0,0,0,,Уау, жарқырап тұр
Dialogue: 0,0:05:20.11,0:05:21.52,Default,,0,0,0,,Бүгін дәлізде кім кезекші?
Dialogue: 0,0:05:21.61,0:05:22.86,Default,,0,0,0,,А, бұл менмін.
Dialogue: 0,0:05:22.94,0:05:23.28,Default,,0,0,0,,Често!
Dialogue: 0,0:05:23.28,0:05:24.24,Default,,0,0,0,,Често!
Dialogue: 0,0:05:23.28,0:05:24.24,Default,,0,0,0,,Ах! (Футаба) А?
Dialogue: 0,0:05:24.24,0:05:25.61,Default,,0,0,0,,Често!
Dialogue: 0,0:05:25.70,0:05:28.32,Default,,0,0,0,,Кеуде кеуде кеуде... Кеуде!
Dialogue: 0,0:05:28.41,0:05:29.24,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:05:30.95,0:05:32.87,Default,,0,0,0,,Кешіріңіз, мен де...
Dialogue: 0,0:05:30.95,0:05:32.87,Default,,0,0,0,,Шахмат шахмат Шахмат шахмат...
Dialogue: 0,0:05:32.87,0:05:32.95,Default,,0,0,0,,Шахмат шахмат Шахмат шахмат...
Dialogue: 0,0:05:32.95,0:05:34.25,Default,,0,0,0,,Шахмат Шахмат Шахмат Шахмат...
Dialogue: 0,0:05:32.95,0:05:34.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:34.33,0:05:35.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:34.33,0:05:35.50,Default,,0,0,0,,Chase!
Dialogue: 0,0:05:35.50,0:05:35.58,Default,,0,0,0,,Chase!
Dialogue: 0,0:05:35.58,0:05:37.00,Default,,0,0,0,,Chase!
Dialogue: 0,0:05:35.58,0:05:37.00,Default,,0,0,0,,Эй, тоқта!
Dialogue: 0,0:05:37.08,0:05:39.79,Default,,0,0,0,,Шахмат тототото…
Dialogue: 0,0:05:39.88,0:05:42.17,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:05:39.88,0:05:42.17,Default,,0,0,0,,Тым-ау!
Dialogue: 0,0:05:42.17,0:05:42.25,Default,,0,0,0,,Өтее!
Dialogue: 0,0:05:42.25,0:05:43.13,Default,,0,0,0,,Тым-ау!
Dialogue: 0,0:05:42.25,0:05:43.13,Default,,0,0,0,,Куора~!
Dialogue: 0,0:05:43.21,0:05:43.76,Default,,0,0,0,,Шахмат шахмат Шахмат шахмат...
Dialogue: 0,0:05:43.76,0:05:46.38,Default,,0,0,0,,Шахмат шахмат Шахмат шахмат...
Dialogue: 0,0:05:43.76,0:05:46.38,Default,,0,0,0,,Адамдар туралы сөйлесіңіз! Тыңдаңыз!
Dialogue: 0,0:05:46.38,0:05:46.47,Default,,0,0,0,,Адамдар туралы сөйлесіңіз! Тыңдаңыз!
Dialogue: 0,0:05:46.47,0:05:48.59,Default,,0,0,0,,Адамдар туралы сөйлесіңіз! Тыңдаңыз!
Dialogue: 0,0:05:46.47,0:05:48.59,Default,,0,0,0,,Тым-ау!
Dialogue: 0,0:05:52.68,0:05:53.72,Default,,0,0,0,,мамыр…
Dialogue: 0,0:05:54.27,0:05:56.73,Default,,0,0,0,,Иванума, пиондар туралы айтатын болсақ
Dialogue: 0,0:05:56.81,0:05:58.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:59.27,0:06:01.23,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:06:01.31,0:06:03.36,Default,,0,0,0,,Ол әдемі гүлдеді.
Dialogue: 0,0:06:05.90,0:06:07.74,Default,,0,0,0,,Әдемі... (Мисато) Иә?
Dialogue: 0,0:06:16.66,0:06:18.96,Default,,0,0,0,,Аздап дәмсіз
Dialogue: 0,0:06:19.04,0:06:22.13,Default,,0,0,0,,Көкөністерден бөлінетін судың мөлшерін қате бағаладыңыз ба?
Dialogue: 0,0:06:22.21,0:06:23.13,Default,,0,0,0,,Бұл карта сәл ақымақтай көрінбей ме?
Dialogue: 0,0:06:23.21,0:06:27.01,Default,,0,0,0,,Қарғыс атсын! Менің жолақтарыммен қалағаныңызды жасаңыз!
Dialogue: 0,0:06:27.09,0:06:30.47,Default,,0,0,0,,0,2 грамм амин қышқылдарын қосыңыз Тұз...
Dialogue: 0,0:06:30.55,0:06:32.47,Default,,0,0,0,,Ой! Боқтама!
Dialogue: 0,0:06:32.55,0:06:33.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:34.01,0:06:36.47,Default,,0,0,0,,Ватари, сабыр ет!
Dialogue: 0,0:06:37.02,0:06:38.27,Default,,0,0,0,,Капитан!
Dialogue: 0,0:06:38.35,0:06:40.77,Default,,0,0,0,,Аға, мені жіберіңізші! (Онагава) Бұл жақсы емес.
Dialogue: 0,0:06:40.85,0:06:42.40,Default,,0,0,0,,Менің жолақтарым зақымдалуда.
Dialogue: 0,0:06:42.40,0:06:43.48,Default,,0,0,0,,Менің жолақтарым зақымдалуда.
Dialogue: 0,0:06:42.40,0:06:43.48,Default,,0,0,0,,Түзету аяқталды Delicious
Dialogue: 0,0:06:43.48,0:06:43.56,Default,,0,0,0,,Түзету аяқталды Delicious
Dialogue: 0,0:06:43.56,0:06:45.19,Default,,0,0,0,,Түзету аяқталды Delicious
Dialogue: 0,0:06:43.56,0:06:45.19,Default,,0,0,0,,Мен... Ватари, сабыр ет.
Dialogue: 0,0:06:45.32,0:06:47.65,Default,,0,0,0,,Сәлем! Егер сіз доптарды алсаңыз!
Dialogue: 0,0:06:47.74,0:06:49.57,Default,,0,0,0,,Жақсы! Ал, Ватари!
Dialogue: 0,0:06:49.65,0:06:50.91,Default,,0,0,0,,Капитан!
Dialogue: 0,0:06:50.99,0:06:53.32,Default,,0,0,0,,Күтіңіз~
Dialogue: 0,0:06:57.25,0:07:00.46,Default,,0,0,0,,Негізгі қозғалыстардың дәлдігі мен әдемілігі
Dialogue: 0,0:07:00.54,0:07:02.33,Default,,0,0,0,,Алты адамның синхрондылығын растау -
Dialogue: 0,0:07:02.42,0:07:04.79,Default,,0,0,0,,Мұқият болыңыз
Dialogue: 0,0:07:06.05,0:07:08.71,Default,,0,0,0,,Бұл оқу-жаттығу жиынының тақырыбы.
Dialogue: 0,0:07:08.80,0:07:09.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:17.10,0:07:21.19,Default,,0,0,0,,Назарыңызды бастың төбесінен бастап, саусақтарыңызға дейін шоғырландырыңыз!
Dialogue: 0,0:07:21.27,0:07:23.44,Default,,0,0,0,,Жаттығу жасап жатырмын деп босаңсуға болмайды!
Dialogue: 0,0:07:23.52,0:07:24.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:26.07,0:07:28.36,Default,,0,0,0,,Саусақтарыңызды созыңыз! (Онагава) Иә!
Dialogue: 0,0:07:35.83,0:07:36.78,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:07:37.41,0:07:39.37,Default,,0,0,0,,Онда! Ол дірілдеп тұр!
Dialogue: 0,0:07:39.45,0:07:40.29,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:07:40.91,0:07:42.46,Default,,0,0,0,,Дүрбелең емес!
Dialogue: 0,0:07:42.54,0:07:44.46,Default,,0,0,0,,Қозғалғың келсе, жай ғана биле!
Dialogue: 0,0:07:44.54,0:07:46.17,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:07:46.25,0:07:49.21,Default,,0,0,0,,Жарайды, келесіде! құлау
Dialogue: 0,0:07:50.63,0:07:53.05,Default,,0,0,0,,Еш ойланба, тез қимылда!
Dialogue: 0,0:07:53.13,0:07:54.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:56.97,0:08:00.39,Default,,0,0,0,,Сіз оны дауыстап айтуға да болады.
Dialogue: 0,0:08:00.48,0:08:03.06,Default,,0,0,0,,Білесің бе, Мабучи-сенпай.
Dialogue: 0,0:08:03.14,0:08:06.48,Default,,0,0,0,,Мен адамдарға бірдеңе үйретуде жақсы емеспін.
Dialogue: 0,0:08:06.56,0:08:09.03,Default,,0,0,0,,«Деңгейі менен төмен жатқан шөгінділер...»
Dialogue: 0,0:08:09.11,0:08:13.65,Default,,0,0,0,,Сіз: «Мен сізге тіпті менің көз алдымда кіруге де жол бере алмаймын» дедіңіз.
Dialogue: 0,0:08:13.74,0:08:16.99,Default,,0,0,0,,Мен ешқашан көшбасшы боламын деп ойламадым.
Dialogue: 0,0:08:17.07,0:08:19.66,Default,,0,0,0,,Ой, бұл ұят.
Dialogue: 0,0:08:20.87,0:08:22.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:23.75,0:08:24.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:24.67,0:08:28.29,Default,,0,0,0,,Сонымен директор Шида мен директор Мабучи ше...
Dialogue: 0,0:08:28.38,0:08:32.01,Default,,0,0,0,,Ах, екеуі де Шираней университетінің түлектері.
Dialogue: 0,0:08:32.09,0:08:37.60,Default,,0,0,0,,Ширанари Дай ерлер көркем гимнастика клубының негізін қалаған аты аңызға айналған мүшелер
Dialogue: 0,0:08:37.68,0:08:38.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:42.93,0:08:44.64,Default,,0,0,0,,Бұл директор ма?
Dialogue: 0,0:08:45.23,0:08:48.31,Default,,0,0,0,,Бейне қазіргіден басқаша көрінеді...
Dialogue: 0,0:08:48.40,0:08:51.15,Default,,0,0,0,,Сіздің көзіңізге бұл көзқарас қалыпты емес.
Dialogue: 0,0:08:51.73,0:08:54.74,Default,,0,0,0,,Ол Ширанари университетінің майталманы болған көрінеді.
Dialogue: 0,0:08:56.16,0:09:00.16,Default,,0,0,0,,Сізге ескі эйс қызық па? соңғы ace
Dialogue: 0,0:09:00.87,0:09:03.54,Default,,0,0,0,,Соңғы эйс емес
Dialogue: 0,0:09:06.75,0:09:09.59,Default,,0,0,0,,Ширанакидің орта мектебінде және университетінде 7 жыл өткізді
Dialogue: 0,0:09:09.67,0:09:11.96,Default,,0,0,0,,Мұқият нұсқаулар беру жүйесі -
Dialogue: 0,0:09:12.55,0:09:14.97,Default,,0,0,0,,Шамасы, ол осы уақытта құрылған.
Dialogue: 0,0:09:15.05,0:09:17.26,Default,,0,0,0,,Сондықтан күшті...
Dialogue: 0,0:09:17.34,0:09:19.47,Default,,0,0,0,,Бұл таңданатын уақыт емес, солай ма?
Dialogue: 0,0:09:20.05,0:09:23.56,Default,,0,0,0,,Түстен кейін мен университетке барып, байсалды рөл ойнаймын.
Dialogue: 0,0:09:25.06,0:09:26.44,Default,,0,0,0,,Пуха
Dialogue: 0,0:09:26.98,0:09:30.19,Default,,0,0,0,,Үлкен шешім қабылдап, оны сізге көрсетейік!
Dialogue: 0,0:09:30.69,0:09:31.82,Default,,0,0,0,,Иә! (Онагава және т.б.) Айо
Dialogue: 0,0:09:43.87,0:09:47.16,Default,,0,0,0,,Мисапон да Широ биіне келгенін қалаймын.
Dialogue: 0,0:09:48.08,0:09:50.29,Default,,0,0,0,,Сонда біз қайтадан бірге боламыз
Dialogue: 0,0:09:50.38,0:09:53.13,Default,,0,0,0,,Мен көңілді және керемет нәрсе жасай алар едім.
Dialogue: 0,0:09:54.67,0:09:56.09,Default,,0,0,0,,таудың тереңінде демалыс үйін сатып алу туралы оқиға ше?
Dialogue: 0,0:09:56.92,0:09:57.76,Default,,0,0,0,,Әй
Dialogue: 0,0:09:59.84,0:10:01.51,Default,,0,0,0,,Әртүрлі командалармен жарысу...
Dialogue: 0,0:10:01.60,0:10:03.31,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:10:07.48,0:10:10.61,Default,,0,0,0,,Бұдан былай екі мектеп те өнер көрсетеді.
Dialogue: 0,0:10:11.56,0:10:14.61,Default,,0,0,0,,Бір нәрсені байқасаңыз, бір-біріңізге кеңес беріңіз.
Dialogue: 0,0:10:15.48,0:10:17.99,Default,,0,0,0,,Көбірек пікір алмасу
Dialogue: 0,0:10:19.70,0:10:22.33,Default,,0,0,0,,Қараңдар, мен бар күшімді саламын.
Dialogue: 0,0:10:22.91,0:10:25.49,Default,,0,0,0,,Муцу мүмкіндігінше секіріңіз (Муцу)
Dialogue: 0,0:10:25.58,0:10:27.75,Default,,0,0,0,,Оминато өте мәнерлі (Оминато)
Dialogue: 0,0:10:27.83,0:10:31.04,Default,,0,0,0,,Азума: Толық жылдамдық (Азума) Мм/сағ...
Dialogue: 0,0:10:31.13,0:10:33.29,Default,,0,0,0,,Рюгамори, икемділігіңді көрсет.
Dialogue: 0,0:10:33.38,0:10:34.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:34.84,0:10:37.80,Default,,0,0,0,,Маширо, бұл оқу-жаттығу жиыны деп ойнама.
Dialogue: 0,0:10:38.47,0:10:40.09,Default,,0,0,0,,Бар күшіңізбен жүріңіз
Dialogue: 0,0:10:40.18,0:10:41.30,Default,,0,0,0,,Иә
Dialogue: 0,0:10:42.51,0:10:44.56,Default,,0,0,0,,Бір-бірінің қимылын мұқият қадағалаңыз
Dialogue: 0,0:10:45.81,0:10:47.89,Default,,0,0,0,,Бірге дем алайық!
Dialogue: 0,0:10:47.98,0:10:49.06,Default,,0,0,0,,О! (Мисато/Футаба) Иә!
Dialogue: 0,0:10:50.19,0:10:52.65,Default,,0,0,0,,Ал, Широтакадан бастайық.
Dialogue: 0,0:10:52.73,0:10:53.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:58.28,0:11:00.28,Default,,0,0,0,,♪～
Dialogue: 0,0:11:04.91,0:11:06.91,Default,,0,0,0,,～♪
Dialogue: 0,0:11:09.96,0:11:12.92,Default,,0,0,0,,Широтака керемет.
Dialogue: 0,0:11:18.26,0:11:19.09,Default,,0,0,0,,Мұндай нәрсе-
Dialogue: 0,0:11:19.17,0:11:22.59,Default,,0,0,0,,Біз сізге кеңес бере алмаймыз.
Dialogue: 0,0:11:24.43,0:11:28.06,Default,,0,0,0,,Шынымды айтсам, көңілім қалды.
Dialogue: 0,0:11:28.14,0:11:31.14,Default,,0,0,0,,Миягиге келу шынымен қажет болды ма?
Dialogue: 0,0:11:31.23,0:11:32.48,Default,,0,0,0,,Менің күмәнім бар.
Dialogue: 0,0:11:32.56,0:11:34.69,Default,,0,0,0,,Жарайды, солай болар…
Dialogue: 0,0:11:34.77,0:11:38.19,Default,,0,0,0,,Сақ болу керек адам емес пе?
Dialogue: 0,0:11:43.57,0:11:44.41,Default,,0,0,0,,Я...
Dialogue: 0,0:11:46.08,0:11:46.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:46.08,0:11:46.91,Default,,0,0,0,,Жоқ, бәрі жақсы...
Dialogue: 0,0:11:46.91,0:11:48.20,Default,,0,0,0,,Жоқ, бәрі жақсы...
Dialogue: 0,0:11:48.29,0:11:49.16,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:50.41,0:11:54.71,Default,,0,0,0,,Бұлай әрекет ету кеңес сұрауға тұрарлық емес.
Dialogue: 0,0:11:56.88,0:11:57.96,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:01.42,0:12:04.59,Default,,0,0,0,,Ао Хайдың өнерін алғаш рет екі жыл бұрын көрдім.
Dialogue: 0,0:12:05.47,0:12:09.18,Default,,0,0,0,,Біз бір рет Тохокудағы алты префектурада бірлескен жаттығу өткіздік.
Dialogue: 0,0:12:09.97,0:12:11.27,Default,,0,0,0,,Ол дерлік сатылып кеткен екен.
Dialogue: 0,0:12:13.31,0:12:16.19,Default,,0,0,0,,Сошукан орта мектебі?
Dialogue: 0,0:12:16.27,0:12:20.32,Default,,0,0,0,,Көркем гимнастикадан ерлер үйірмесі енді ғана құрылған сияқты.
Dialogue: 0,0:12:33.58,0:12:34.42,Default,,0,0,0,,Тек қарау арқылы-
Dialogue: 0,0:12:35.25,0:12:39.34,Default,,0,0,0,,Бұл оның қаншалықты жаттығу жасағанын көрсететін тамаша қойылым болды.
Dialogue: 0,0:12:40.25,0:12:42.76,Default,,0,0,0,,Ал өткен жылғы Мияги префектуралық турнирінде...
Dialogue: 0,0:12:42.84,0:12:46.39,Default,,0,0,0,,Төрт адам таңғаларлық 15 ұпай жинады.
Dialogue: 0,0:12:47.51,0:12:50.39,Default,,0,0,0,,Көк аспан міндетті түрде көтеріледі
Dialogue: 0,0:12:52.73,0:12:55.35,Default,,0,0,0,,Неге жараспайды деп ойлаймын.
Dialogue: 0,0:12:55.44,0:12:56.52,Default,,0,0,0,,6 адам болса
Dialogue: 0,0:12:57.73,0:13:00.36,Default,,0,0,0,,Мен төрт адам болып көшіп-қонуға әбден үйренгенмін.
Dialogue: 0,0:13:00.44,0:13:04.03,Default,,0,0,0,,Мисато мен Шотароның қимылдарын көре алмайсыз ба?
Dialogue: 0,0:13:05.70,0:13:06.53,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:10.12,0:13:11.70,Default,,0,0,0,,Қадағалау…
Dialogue: 0,0:13:13.08,0:13:14.29,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:15.66,0:13:17.17,Default,,0,0,0,,Қарсы неге? Бүгін таңертең сен жақсылап көмектесіп жүрдің ғой, иә?
Dialogue: 0,0:13:17.25,0:13:18.29,Default,,0,0,0,,Капитан…
Dialogue: 0,0:13:18.38,0:13:21.50,Default,,0,0,0,,Оқу-жаттығу жиынын ұйымдастыра алсам да.
Dialogue: 0,0:13:21.59,0:13:24.17,Default,,0,0,0,,Мен орынсыз ойын көрсеттім...
Dialogue: 0,0:13:27.01,0:13:29.51,Default,,0,0,0,,Аспан биік, өзін жақсы сезінеді
Dialogue: 0,0:13:30.10,0:13:30.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:31.51,0:13:33.43,Default,,0,0,0,,«Бір-ақ рет тоқтаңыз...»
Dialogue: 0,0:13:33.93,0:13:38.40,Default,,0,0,0,,«Аспанға қарау жақсы», - деді әйелім.
Dialogue: 0,0:13:40.48,0:13:41.65,Default,,0,0,0,,Аспан...?
Dialogue: 0,0:13:45.86,0:13:47.15,Default,,0,0,0,,Бүгінгі еңбектеріңізге рахмет.
Dialogue: 0,0:13:48.91,0:13:49.99,Default,,0,0,0,,Әлі ертең бар...
Dialogue: 0,0:13:50.07,0:13:52.12,Default,,0,0,0,,Жақсылап демалыңыз
Dialogue: 0,0:14:01.38,0:14:02.84,Default,,0,0,0,,Маширо туралы есіңізде ме?
Dialogue: 0,0:14:02.92,0:14:03.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:06.01,0:14:07.26,Default,,0,0,0,,Олай болса, бұл ысырап.
Dialogue: 0,0:14:08.26,0:14:11.76,Default,,0,0,0,,Ол данышпан, сен олай емессің.
Dialogue: 0,0:14:11.85,0:14:13.22,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:14:13.31,0:14:16.02,Default,,0,0,0,,Данышпанға еліктеуге асықпа!
Dialogue: 0,0:14:16.10,0:14:19.35,Default,,0,0,0,,Өз қарқыныңызбен жұмыс жасаңыз...
Dialogue: 0,0:14:19.44,0:14:22.65,Default,,0,0,0,,Осыны айтқыңыз келеді, солай ма? Сөздердің сыры
Dialogue: 0,0:14:22.73,0:14:24.86,Default,,0,0,0,,Мен сөйлейтін эйс емеспін.
Dialogue: 0,0:14:25.73,0:14:27.61,Default,,0,0,0,,Бұл дұрыс емес (Мисато) Иә?
Dialogue: 0,0:14:28.20,0:14:32.28,Default,,0,0,0,,Мен Маширо-кун сияқты емеспін.
Dialogue: 0,0:14:32.87,0:14:35.66,Default,,0,0,0,,Үлкендеріңізді ұстамаңыз
Dialogue: 0,0:14:35.74,0:14:38.62,Default,,0,0,0,,Мен өзімді дұрыс ұстай алғым келеді.
Dialogue: 0,0:14:38.71,0:14:39.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:40.21,0:14:44.17,Default,,0,0,0,,Сондықтан мен бұл қандай да бір жолмен пайдалы болуы мүмкін деп ойладым.
Dialogue: 0,0:14:45.59,0:14:47.38,Default,,0,0,0,,Сондықтан асықтырудың қажеті жоқ.
Dialogue: 0,0:14:48.01,0:14:48.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:49.05,0:14:51.43,Default,,0,0,0,,Біз оның сізге бейімделгеніне көз жеткіземіз.
Dialogue: 0,0:14:51.51,0:14:52.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:52.93,0:14:53.76,Default,,0,0,0,,(ұзын құйрықты көбелектің айқайы)
Dialogue: 0,0:14:55.47,0:14:58.31,Default,,0,0,0,,Сонымен Мисато...
Dialogue: 0,0:14:58.39,0:15:00.35,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ па?
Dialogue: 0,0:15:00.44,0:15:01.48,Default,,0,0,0,,Я...
Dialogue: 0,0:15:01.56,0:15:03.11,Default,,0,0,0,,Керісінше, Мисато
Dialogue: 0,0:15:03.19,0:15:05.77,Default,,0,0,0,,Сіз бізді орналастыру үшін бар күшіңізді салып жатырсыз.
Dialogue: 0,0:15:05.86,0:15:06.82,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:09.03,0:15:10.28,Default,,0,0,0,,Мен сізге ілесе аламын...
Dialogue: 0,0:15:12.66,0:15:14.03,Default,,0,0,0,,Сәйкестік пе?
Dialogue: 0,0:15:20.50,0:15:21.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:25.79,0:15:28.38,Default,,0,0,0,,Әйтеуір, ертең де бәріміз бір-бірімізбен үндестік...
Dialogue: 0,0:15:28.46,0:15:29.97,Default,,0,0,0,,Тыныс алуды синхрондау қажет емес!
Dialogue: 0,0:15:30.05,0:15:30.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:31.47,0:15:32.72,Default,,0,0,0,,Шичигахама?
Dialogue: 0,0:15:32.80,0:15:34.72,Default,,0,0,0,,Шотаро жаңадан келген!
Dialogue: 0,0:15:35.39,0:15:38.56,Default,,0,0,0,,Мисато бізбен әлі болған жоқ...
Dialogue: 0,0:15:38.64,0:15:42.73,Default,,0,0,0,,Біз төрт адам сияқты әрекет етуге үйреніп қалдық.
Dialogue: 0,0:15:42.81,0:15:43.65,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:15:43.73,0:15:45.19,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:15:45.27,0:15:47.44,Default,,0,0,0,,Сәйкес келуге тым қатты тырыстыңыз ба?
Dialogue: 0,0:15:48.07,0:15:49.90,Default,,0,0,0,,Осыған назар аударыңыз...
Dialogue: 0,0:15:49.99,0:15:53.41,Default,,0,0,0,,Біздің жеке қозғалысымыз атрофияға ұшырады.
Dialogue: 0,0:15:54.24,0:15:56.83,Default,,0,0,0,,Біздің мақсатымыз қандай?
Dialogue: 0,0:15:56.91,0:15:58.49,Default,,0,0,0,,Бұл өте жоғары!
Dialogue: 0,0:15:58.58,0:16:01.29,Default,,0,0,0,,Әңгіме 6 адамның бірдей қозғалыс жасауында емес!
Dialogue: 0,0:16:02.04,0:16:03.04,Default,,0,0,0,,Шотаро
Dialogue: 0,0:16:03.12,0:16:05.63,Default,,0,0,0,,Бізді де ойлаудың қажеті жоқ!
Dialogue: 0,0:16:05.71,0:16:06.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:07.13,0:16:09.96,Default,,0,0,0,,Керісінше, басып озуға тырысыңыз!
Dialogue: 0,0:16:10.63,0:16:13.55,Default,,0,0,0,,Аа... біз доспыз...
Dialogue: 0,0:16:13.63,0:16:16.68,Default,,0,0,0,,Сонымен қатар олар бір-бірімен бәсекелес.
Dialogue: 0,0:16:16.76,0:16:18.43,Default,,0,0,0,,Мона Мисато (Мисато) Иә!
Dialogue: 0,0:16:19.10,0:16:21.43,Default,,0,0,0,,Бізден ұялмаңыз
Dialogue: 0,0:16:22.06,0:16:23.39,Default,,0,0,0,,Бар күшіңізбен жүріңіз!
Dialogue: 0,0:16:23.48,0:16:24.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:25.60,0:16:26.44,Default,,0,0,0,,Қарсылас…
Dialogue: 0,0:16:28.40,0:16:29.73,Default,,0,0,0,,Үлкендеріммен...
Dialogue: 0,0:16:30.61,0:16:32.15,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:32.24,0:16:33.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:34.32,0:16:36.49,Default,,0,0,0,,Топ болып бірге биіктерден көрінейік!
Dialogue: 0,0:16:37.95,0:16:40.87,Default,,0,0,0,,Алты адам бұдан да жоғары орындарды көздейді!
Dialogue: 0,0:16:40.95,0:16:42.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:43.29,0:16:44.58,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:16:44.67,0:16:45.87,Default,,0,0,0,,О! (Футаба/Мисато) Иә!
Dialogue: 0,0:16:46.71,0:16:49.09,Default,,0,0,0,,Иә? Бұл Мисапон!
Dialogue: 0,0:16:49.67,0:16:51.59,Default,,0,0,0,,Маширо? Хехе...
Dialogue: 0,0:16:53.30,0:16:54.59,Default,,0,0,0,,Такасе…
Dialogue: 0,0:16:56.18,0:16:57.80,Default,,0,0,0,,Алтауымыз жоғарыға көтерілеміз.
Dialogue: 0,0:16:57.89,0:16:58.72,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:01.47,0:17:05.06,Default,,0,0,0,,Жігіттер өздеріңнен жоғары көтеріліңдер!
Dialogue: 0,0:17:05.73,0:17:09.11,Default,,0,0,0,,Егер солай болса, мен оны сыпайы түрде құлатуым керек.
Dialogue: 0,0:17:09.19,0:17:10.40,Default,,0,0,0,,Хе хехе...
Dialogue: 0,0:17:10.48,0:17:12.61,Default,,0,0,0,,Алты адам?
Dialogue: 0,0:17:12.69,0:17:16.24,Default,,0,0,0,,Бар болғаны 6 адам болса да, мен маңызды нәрсені ұмытып кеттім.
Dialogue: 0,0:17:16.32,0:17:17.99,Default,,0,0,0,,Бұл маңызды ма?
Dialogue: 0,0:17:18.49,0:17:20.91,Default,,0,0,0,,Широ орта мектебінің оқушылары да сонда.
Dialogue: 0,0:17:20.99,0:17:21.83,Default,,0,0,0,,Хмм?
Dialogue: 0,0:17:23.04,0:17:25.41,Default,,0,0,0,,үшінн бірден жасайық!
Dialogue: 0,0:17:25.50,0:17:26.33,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:17:27.08,0:17:31.84,Default,,0,0,0,,(Тинтин қыздарының ән айтуы)
Dialogue: 0,0:17:37.43,0:17:40.60,Default,,0,0,0,,Не? Макон әрқашан қолынан келгеннің бәрін жасайды
Dialogue: 0,0:17:40.68,0:17:43.60,Default,,0,0,0,,Ол көп жаттығу жасайды және жанкүйерлеріне қамқорлық жасайды.
Dialogue: 0,0:17:43.68,0:17:45.35,Default,,0,0,0,,Таза!
Dialogue: 0,0:17:46.39,0:17:49.77,Default,,0,0,0,,Тантан қыздары Асами Мияфуджи 19 жаста
Dialogue: 0,0:17:49.86,0:17:53.36,Default,,0,0,0,,Бойы 159см Қан тобы А
Dialogue: 0,0:17:53.44,0:17:56.32,Default,,0,0,0,,Оның суретінің түсі қызғылт, ал ерекше шеберлігі – скрипка.
Dialogue: 0,0:17:56.40,0:17:57.78,Default,,0,0,0,,Сіз...
Dialogue: 0,0:17:58.36,0:18:00.99,Default,,0,0,0,,Мен Аомори Небута арманымын
Dialogue: 0,0:18:01.08,0:18:03.54,Default,,0,0,0,,Мен Аки Казамаураның жанкүйерімін.
Dialogue: 0,0:18:07.33,0:18:09.12,Default,,0,0,0,,Ма-чон Ма-чон…
Dialogue: 0,0:18:09.21,0:18:10.04,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:10.13,0:18:14.00,Default,,0,0,0,,Неге... Неге, аға...
Dialogue: 0,0:18:14.09,0:18:17.01,Default,,0,0,0,,Сіз уәде бердіңіз.
Dialogue: 0,0:18:17.09,0:18:19.72,Default,,0,0,0,,Сол көпірден бірге өтейік!
Dialogue: 0,0:18:19.80,0:18:21.97,Default,,0,0,0,,Уақыт өзгерді (Ватари) Иә?
Dialogue: 0,0:18:23.01,0:18:26.81,Default,,0,0,0,,Арман әлдеқашан қызарып, тот басқан...
Dialogue: 0,0:18:27.52,0:18:29.90,Default,,0,0,0,,Мына көпірге қараңдар.
Dialogue: 0,0:18:31.44,0:18:33.11,Default,,0,0,0,,Бұл жұмыртқа мүкі ме?
Dialogue: 0,0:18:33.19,0:18:35.28,Default,,0,0,0,,Иә, бұл Тамао-сан.
Dialogue: 0,0:18:35.36,0:18:37.90,Default,,0,0,0,,Бұл бұршақ тұқымдастағы Мамеко.
Dialogue: 0,0:18:37.99,0:18:41.16,Default,,0,0,0,,Хехе... Сен әдемісің, солай ма?
Dialogue: 0,0:18:41.24,0:18:43.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:43.20,0:18:48.41,Default,,0,0,0,,Сізді қарсы алу кеші және бізбен кездесу... Шамасы.
Dialogue: 0,0:18:48.50,0:18:51.04,Default,,0,0,0,,Мұнда пиондарды қосыңыз...
Dialogue: 0,0:18:51.13,0:18:53.38,Default,,0,0,0,,Күтілгендей! Рюгамори-кун
Dialogue: 0,0:18:53.46,0:18:54.88,Default,,0,0,0,,Оджо Сейя!
Dialogue: 0,0:18:55.46,0:18:56.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:57.17,0:19:00.18,Default,,0,0,0,,Теме шекарасы…
Dialogue: 0,0:19:00.88,0:19:02.64,Default,,0,0,0,,Тантан Тататан!
Dialogue: 0,0:19:02.72,0:19:04.18,Default,,0,0,0,,Бұл хаос…
Dialogue: 0,0:19:04.81,0:19:05.97,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:06.89,0:19:07.81,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:08.98,0:19:09.98,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:10.89,0:19:15.65,Default,,0,0,0,,Әдеттегідей, бұл кішігірім шеберлік және жеткіліксіз кері айналдыру.
Dialogue: 0,0:19:15.73,0:19:18.11,Default,,0,0,0,,Тек серпінмен Сасакама бейбақ
Dialogue: 0,0:19:18.19,0:19:19.36,Default,,0,0,0,,Не?
Dialogue: 0,0:19:19.44,0:19:21.03,Default,,0,0,0,,Менің кері айналдыру жылдамырақ!
Dialogue: 0,0:19:21.11,0:19:22.11,Default,,0,0,0,,(кері дыбыс)
Dialogue: 0,0:19:22.20,0:19:24.12,Default,,0,0,0,,Эй, бұл жай ғана жылдам емес пе?
Dialogue: 0,0:19:24.20,0:19:24.91,Default,,0,0,0,,Менікі қымбатырақ!
Dialogue: 0,0:19:24.91,0:19:26.08,Default,,0,0,0,,Менікі қымбатырақ!
Dialogue: 0,0:19:24.91,0:19:26.08,Default,,0,0,0,,(кері дыбыс)
Dialogue: 0,0:19:26.08,0:19:26.58,Default,,0,0,0,,(кері дыбыс)
Dialogue: 0,0:19:26.66,0:19:26.99,Default,,0,0,0,,Не!
Dialogue: 0,0:19:26.99,0:19:27.70,Default,,0,0,0,,Не!
Dialogue: 0,0:19:26.99,0:19:27.70,Default,,0,0,0,,(кері дыбыс)
Dialogue: 0,0:19:27.70,0:19:28.41,Default,,0,0,0,,(кері айналдыру дыбысы)
Dialogue: 0,0:19:28.50,0:19:30.12,Default,,0,0,0,,Сен ең жақсысың, шық!
Dialogue: 0,0:19:30.21,0:19:31.12,Default,,0,0,0,,Қалаған жерде!
Dialogue: 0,0:19:31.21,0:19:33.00,Default,,0,0,0,,Хехехехехе...
Dialogue: 0,0:19:33.08,0:19:33.96,Default,,0,0,0,,Шичигахама!
Dialogue: 0,0:19:35.25,0:19:38.67,Default,,0,0,0,,Екеумізге де капитан болу қиын.
Dialogue: 0,0:19:39.17,0:19:42.84,Default,,0,0,0,,Кері айналдыру жоқ, сіздің кері айналдыруыңыз өткір болды.
Dialogue: 0,0:19:42.93,0:19:46.22,Default,,0,0,0,,Цукидате мырза заттарды бұрмалауға шебер.
Dialogue: 0,0:19:46.31,0:19:47.72,Default,,0,0,0,,Хаха... О, жоқ...
Dialogue: 0,0:19:47.81,0:19:51.06,Default,,0,0,0,,Иә! Мен барлығынан сұрағым келді
Dialogue: 0,0:19:51.14,0:19:53.19,Default,,0,0,0,,Алға иілуге арналған кеңестер...
Dialogue: 0,0:19:53.27,0:19:55.52,Default,,0,0,0,,Сырғыту уақыты...?
Dialogue: 0,0:19:56.32,0:19:57.52,Default,,0,0,0,,Бейне бар
Dialogue: 0,0:19:57.61,0:19:59.99,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:20:00.61,0:20:01.20,Default,,0,0,0,,Біріншіден, Цукидате-сенпайдың қиғаш алға иілуі.
Dialogue: 0,0:20:01.20,0:20:02.07,Default,,0,0,0,,Біріншіден, Цукидате-сенпайдың қиғаш алға иілуі.
Dialogue: 0,0:20:01.20,0:20:02.07,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:02.07,0:20:02.15,Default,,0,0,0,,Біріншіден, Цукидате-сенпайдың қиғаш алға иілуі.
Dialogue: 0,0:20:02.15,0:20:03.78,Default,,0,0,0,,Біріншіден, Цукидате-сенпайдың қиғаш алға иілуі.
Dialogue: 0,0:20:02.15,0:20:03.78,Default,,0,0,0,,Не болды? (Футаба) А?
Dialogue: 0,0:20:04.41,0:20:05.82,Default,,0,0,0,,Себебі сен күлесің
Dialogue: 0,0:20:04.41,0:20:05.82,Default,,0,0,0,,Өйткені, бұл панесу
Dialogue: 0,0:20:05.91,0:20:07.78,Default,,0,0,0,,Келесі, Шичигахама капитаны
Dialogue: 0,0:20:07.87,0:20:08.33,Default,,0,0,0,,Менің қолым толық созылған.
Dialogue: 0,0:20:08.33,0:20:09.91,Default,,0,0,0,,Менің қолым толық созылды.
Dialogue: 0,0:20:08.33,0:20:09.91,Default,,0,0,0,,Көркем гимнастиканы бәрі жақсы көреді.
Dialogue: 0,0:20:09.91,0:20:10.00,Default,,0,0,0,,Көркем гимнастиканы бәрі жақсы көреді.
Dialogue: 0,0:20:10.00,0:20:11.33,Default,,0,0,0,,Көркем гимнастиканы бәрі жақсы көреді.
Dialogue: 0,0:20:10.00,0:20:11.33,Default,,0,0,0,,Қол жаттығулары да жақсы.
Dialogue: 0,0:20:11.33,0:20:11.41,Default,,0,0,0,,Көркем гимнастиканы бәрі жақсы көреді.
Dialogue: 0,0:20:11.41,0:20:12.29,Default,,0,0,0,,Көркем гимнастиканы бәрі жақсы көреді.
Dialogue: 0,0:20:11.41,0:20:12.29,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:20:13.58,0:20:15.79,Default,,0,0,0,,Мисато-кун... (Мисато) Иә?
Dialogue: 0,0:20:15.88,0:20:17.50,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:20:17.59,0:20:19.84,Default,,0,0,0,,Ао орта мектебіне не үшін келдің?
Dialogue: 0,0:20:19.92,0:20:20.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:23.30,0:20:25.30,Default,,0,0,0,,Мен жасағым келетін көркем гимнастика...
Dialogue: 0,0:20:25.97,0:20:27.51,Default,,0,0,0,,Тек осында
Dialogue: 0,0:20:28.89,0:20:30.60,Default,,0,0,0,,Осымен
Dialogue: 0,0:20:31.14,0:20:32.31,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:20:33.81,0:20:35.31,Default,,0,0,0,,Мен не істегім келеді...
Dialogue: 0,0:20:37.69,0:20:39.61,Default,,0,0,0,,Барғым келетін жерлер...
Dialogue: 0,0:20:40.40,0:20:41.28,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:41.94,0:20:46.32,Default,,0,0,0,,Хехехехехе...
Dialogue: 0,0:20:57.92,0:20:59.09,Default,,0,0,0,,Цу!
Dialogue: 0,0:21:02.13,0:21:03.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:05.05,0:21:06.05,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:21:06.68,0:21:10.14,Default,,0,0,0,,Мына оқушы екеуің кешегіден әлдеқайда жақсысыңдар, солай емес пе?
Dialogue: 0,0:21:10.22,0:21:11.06,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:11.89,0:21:15.06,Default,,0,0,0,,Кішкене бос әңгіме
Dialogue: 0,0:21:16.19,0:21:17.77,Default,,0,0,0,,үшін дос
Dialogue: 0,0:21:17.85,0:21:19.61,Default,,0,0,0,,Әр адам – бәсекелес
Dialogue: 0,0:21:20.40,0:21:21.65,Default,,0,0,0,,үшінмен...
Dialogue: 0,0:21:23.03,0:21:24.15,Default,,0,0,0,,Мен де!
Dialogue: 0,0:21:25.11,0:21:25.95,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:26.03,0:21:31.03,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.91,0:22:55.91,Default,,0,0,0,,～♪
