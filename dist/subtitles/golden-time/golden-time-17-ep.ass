Dialogue: 0,0:01:18.00,0:01:23.00,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:01:23.00,0:01:27.80,Default,,0,0,0,,«Мен бармын» деп ән айтсам да, шын айтсам, соны айтамын.
Dialogue: 0,0:01:27.80,0:01:31.00,Default,,0,0,0,,Жүрегімдегі көз жас сені де жарып барады
Dialogue: 0,0:01:31.00,0:01:37.00,Default,,0,0,0,,Сүйіспеншілікке ғашық дегенім осы
Dialogue: 0,0:01:37.00,0:01:43.00,Default,,0,0,0,,Махаббатқа ғашық
Dialogue: 0,0:01:52.00,0:01:53.00,Default,,0,0,0,,Сыр!
Dialogue: 0,0:01:53.00,0:01:54.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:54.00,0:01:57.00,Default,,0,0,0,,Сенпай мен басқалары келді ме?
Dialogue: 0,0:01:57.00,0:02:00.00,Default,,0,0,0,,Кешіріңіз, мен сізге көмектесемін!
Dialogue: 0,0:02:00.00,0:02:01.00,Default,,0,0,0,,Тек Банри
Dialogue: 0,0:02:01.00,0:02:03.00,Default,,0,0,0,,Тек Банри?
Dialogue: 0,0:02:03.00,0:02:04.00,Default,,0,0,0,,Бұл Банри
Dialogue: 0,0:02:04.00,0:02:06.00,Default,,0,0,0,,Не?
Dialogue: 0,0:02:07.00,0:02:08.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:08.00,0:02:10.00,Default,,0,0,0,,Маған неге олай қарап тұрсың?
Dialogue: 0,0:02:14.00,0:02:16.00,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:02:16.00,0:02:18.00,Default,,0,0,0,,Мұнда кел, тек Банри.
Dialogue: 0,0:02:18.00,0:02:20.00,Default,,0,0,0,,Бірге орындайық
Dialogue: 0,0:02:20.00,0:02:24.00,Default,,0,0,0,,4-сынып оқушылары келгенге дейін мына жылтыр затты киіңіз.
Dialogue: 0,0:02:24.00,0:02:26.00,Default,,0,0,0,,Бұл чочинмоны ұмытпаңыз
Dialogue: 0,0:02:30.00,0:02:32.00,Default,,0,0,0,,Жоқ, бұл қорқынышты.
Dialogue: 0,0:02:32.00,0:02:33.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:33.00,0:02:35.00,Default,,0,0,0,,Ал бұл бала мұнда не істеп жүр?
Dialogue: 0,0:02:35.00,0:02:36.00,Default,,0,0,0,,Жоқ, бұл қорқынышты.
Dialogue: 0,0:02:36.00,0:02:38.00,Default,,0,0,0,,Бұл, әрине, біртүрлі болар еді
Dialogue: 0,0:02:38.00,0:02:40.00,Default,,0,0,0,,Мұнда таңғаларлық ештеңе жоқ.
Dialogue: 0,0:02:40.00,0:02:45.00,Default,,0,0,0,,Мен оқу-жаттығу жиынына бара алмадым, бірақ мен бүгін өте көңілді боламын.
Dialogue: 0,0:02:45.00,0:02:48.00,Default,,0,0,0,,Бұл жер маған төрағаның айласымен қарызға берілді.
Dialogue: 0,0:02:48.00,0:02:50.00,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:02:50.00,0:02:52.00,Default,,0,0,0,,Әй, қызық екен, солай емес пе?
Dialogue: 0,0:02:52.00,0:02:55.00,Default,,0,0,0,,Бұл қызықты бонус
Dialogue: 0,0:02:58.00,0:03:00.00,Default,,0,0,0,,Йотада Банри
Dialogue: 0,0:03:01.00,0:03:03.00,Default,,0,0,0,,Көп уақыт болған жоқ
Dialogue: 0,0:03:03.00,0:03:07.00,Default,,0,0,0,,Мен сенімен танысқым келді.
Dialogue: 0,0:03:07.00,0:03:10.00,Default,,0,0,0,,Соңғы уақытта не істедіңіз?
Dialogue: 0,0:03:10.00,0:03:13.00,Default,,0,0,0,,Жоқ, бұл күндері олай емес.
Dialogue: 0,0:03:13.00,0:03:18.00,Default,,0,0,0,,Олай болса, олай болса, көмектесуге болмайды.
Dialogue: 0,0:03:20.00,0:03:23.00,Default,,0,0,0,,Менің ойымша, бұл жай ғана Банри мен Робоко.
Dialogue: 0,0:03:23.00,0:03:28.00,Default,,0,0,0,,Біз үшін бұл ұрықтанған жұмыртқа сияқты.
Dialogue: 0,0:03:28.00,0:03:31.00,Default,,0,0,0,,ше? Сен не туралы айтып тұрсың?
Dialogue: 0,0:03:31.00,0:03:36.00,Default,,0,0,0,,Екі тірі заттың бір болғанын білдіреді.
Dialogue: 0,0:03:36.00,0:03:41.00,Default,,0,0,0,,Банри мен Робоко, олар әрқашан бірге болған сияқты.
Dialogue: 0,0:03:41.00,0:03:45.00,Default,,0,0,0,,Бұл біздің жанымызды кейінгі ұрпақпен байланыстыратын гендер.
Dialogue: 0,0:03:45.00,0:03:47.00,Default,,0,0,0,,Иә
Dialogue: 0,0:03:48.00,0:03:52.00,Default,,0,0,0,,Иә? Ринна-сенпай осында емес пе?
Dialogue: 0,0:03:52.00,0:03:56.00,Default,,0,0,0,,Әлгі жігіт ата-анасының үйінен осы жаққа келе жатқан.
Dialogue: 0,0:03:56.00,0:03:58.00,Default,,0,0,0,,Қазір қалдырыңыз
Dialogue: 0,0:03:58.00,0:04:00.00,Default,,0,0,0,,А, сен Шидзуокаға қайтып бардың ба?
Dialogue: 0,0:04:00.00,0:04:03.00,Default,,0,0,0,,Оны қалдырған жерден ұстамаңыз.
Dialogue: 0,0:04:03.00,0:04:05.00,Default,,0,0,0,,Бұл сіз туралы көбірек.
Dialogue: 0,0:04:05.00,0:04:08.00,Default,,0,0,0,,Жоқ, мен сендер туралы айтып отырмын.
Dialogue: 0,0:04:08.00,0:04:12.00,Default,,0,0,0,,Мм, мен бұл нені білдіретінін түсінбеймін.
Dialogue: 0,0:04:12.00,0:04:15.00,Default,,0,0,0,,Сонымен менің айтайын деп отырғаным
Dialogue: 0,0:04:15.00,0:04:18.00,Default,,0,0,0,,Сіз және Робоко туралы
Dialogue: 0,0:04:18.00,0:04:22.00,Default,,0,0,0,,Айтайын дегенім, бәріміз де қосылғымыз келеді.
Dialogue: 0,0:04:22.00,0:04:24.00,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:04:24.00,0:04:26.00,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:04:26.00,0:04:28.00,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:04:28.00,0:04:30.00,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:04:30.00,0:04:33.00,Default,,0,0,0,,Міне, сіз түсінесіз.
Dialogue: 0,0:04:33.00,0:04:35.00,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:04:35.00,0:04:39.00,Default,,0,0,0,,Басқаша айтқанда, мен Робокомен ажырасқаным үшін
Dialogue: 0,0:04:39.00,0:04:42.00,Default,,0,0,0,,Олардың біреуі бонусты тоқтататын нәрсе жоқ.
Dialogue: 0,0:04:42.00,0:04:44.00,Default,,0,0,0,,Не?
Dialogue: 0,0:04:44.00,0:04:46.00,Default,,0,0,0,,Барлығына айтпа, түсіндің бе?
Dialogue: 0,0:04:46.00,0:04:50.00,Default,,0,0,0,,Біз келмейтін едік, сондықтан мен Робокоға қоңырау шалып, электрондық хат жаздым.
Dialogue: 0,0:04:50.00,0:04:53.00,Default,,0,0,0,,Мен сізбен мүлдем байланыса алмаймын.
Dialogue: 0,0:04:53.00,0:04:56.00,Default,,0,0,0,,Мен сізге қоңырау шалсам да, Робоко туралы болады.
Dialogue: 0,0:04:56.00,0:04:58.00,Default,,0,0,0,,Оның екі жақты ауызы болды.
Dialogue: 0,0:04:58.00,0:05:00.00,Default,,0,0,0,,Демек, бұл нені білдіреді, солай ма?
Dialogue: 0,0:05:00.00,0:05:02.00,Default,,0,0,0,,Жоқ, бұл
Dialogue: 0,0:05:02.00,0:05:05.00,Default,,0,0,0,,Бірақ біз енді жұп емеспіз.
Dialogue: 0,0:05:05.00,0:05:09.00,Default,,0,0,0,,Арамыздағы байланыс жойылатын сияқты емес.
Dialogue: 0,0:05:09.00,0:05:11.00,Default,,0,0,0,,Келіңіздер, бәріңіз.
Dialogue: 0,0:05:11.00,0:05:14.00,Default,,0,0,0,,Жүректің ауырғанын емдейміз
Dialogue: 0,0:05:14.00,0:05:17.00,Default,,0,0,0,,Жүр, тек Банридің көңілін көтер.
Dialogue: 0,0:05:17.00,0:05:21.00,Default,,0,0,0,,Бар болғаны он мың миль Бар болғаны он мың миль
Dialogue: 0,0:05:21.00,0:05:25.00,Default,,0,0,0,,Жоқ, жоқ, жоқ, неге олай сөйлеп тұрсың?
Dialogue: 0,0:05:25.00,0:05:27.00,Default,,0,0,0,,Мен және Коуко
Dialogue: 0,0:05:27.00,0:05:30.00,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым.
Dialogue: 0,0:05:31.00,0:05:33.00,Default,,0,0,0,,Робоко!
Dialogue: 0,0:05:33.00,0:05:35.00,Default,,0,0,0,,Робоко келді!
Dialogue: 0,0:05:35.00,0:05:38.00,Default,,0,0,0,,Робот бала жаңа ғана Жүректегі жөндеу шеберханасынан оралды.
Dialogue: 0,0:05:38.00,0:05:43.00,Default,,0,0,0,,Бәріміз, сынған робот баланы жылы қарсы алайық.
Dialogue: 0,0:05:45.00,0:05:47.00,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:05:47.00,0:05:49.00,Default,,0,0,0,,Сондықтан ол басқаша. Бұл түсінбеушілік.
Dialogue: 0,0:05:49.00,0:05:51.00,Default,,0,0,0,,Бәріне айтпа, түсінемін.
Dialogue: 0,0:05:51.00,0:05:53.00,Default,,0,0,0,,Жоқ, түсінбеймін.
Dialogue: 0,0:05:53.00,0:05:56.00,Default,,0,0,0,,Біз бөлінбейміз.
Dialogue: 0,0:05:58.00,0:06:00.00,Default,,0,0,0,,Аа, бұл күлкілі.
Dialogue: 0,0:06:00.00,0:06:02.00,Default,,0,0,0,,Мен оны қатты түсінгенім сонша, жоғалтып алдым.
Dialogue: 0,0:06:02.00,0:06:05.00,Default,,0,0,0,,Неге тоқтадың? Не істеуім керек?
Dialogue: 0,0:06:05.00,0:06:07.00,Default,,0,0,0,,Мен қатты уайымдадым.
Dialogue: 0,0:06:07.00,0:06:08.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:08.00,0:06:10.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:11.00,0:06:13.00,Default,,0,0,0,,Жарайды, оларды айыптамаңыз.
Dialogue: 0,0:06:13.00,0:06:15.00,Default,,0,0,0,,Бұл балалар жаман емес.
Dialogue: 0,0:06:15.00,0:06:18.00,Default,,0,0,0,,Бұл ең сорақысы шығар.
Dialogue: 0,0:06:18.00,0:06:23.00,Default,,0,0,0,,Екеуіңнің ажырасып кеткеніңді бірінші сен емес пе едің?
Dialogue: 0,0:06:24.00,0:06:27.00,Default,,0,0,0,,Балалар, бұл сөзді де айттыңыздар.
Dialogue: 0,0:06:27.00,0:06:29.00,Default,,0,0,0,,Не? Сіз бізді кінәлағыңыз келе ме?
Dialogue: 0,0:06:29.00,0:06:32.00,Default,,0,0,0,,Бірақ өткен күні бұл аздап қауіпті болды.
Dialogue: 0,0:06:32.00,0:06:34.00,Default,,0,0,0,,Қауіпті емес Қауіпті емес
Dialogue: 0,0:06:34.00,0:06:37.00,Default,,0,0,0,,Бұған кедергі келтірмеңіз.
Dialogue: 0,0:06:38.00,0:06:40.00,Default,,0,0,0,,Не?
Dialogue: 0,0:06:40.00,0:06:43.00,Default,,0,0,0,,Ая, сен юкатада жақсы көрінесің.
Dialogue: 0,0:06:43.00,0:06:46.00,Default,,0,0,0,,Бұл мен биыл жасаған юката.
Dialogue: 0,0:06:46.00,0:06:49.00,Default,,0,0,0,,Мен осы жазда Банримен бірге отшашуға барғым келеді.
Dialogue: 0,0:06:49.00,0:06:52.00,Default,,0,0,0,,Бару Баруды шешіңіз
Dialogue: 0,0:06:52.00,0:06:54.00,Default,,0,0,0,,Өткенде жаңбыр жауды.
Dialogue: 0,0:06:54.00,0:06:55.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:55.00,0:06:57.00,Default,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:06:57.00,0:06:59.00,Default,,0,0,0,,Маған жаңа ғана қоңырау түсті.
Dialogue: 0,0:06:59.00,0:07:04.00,Default,,0,0,0,,Бүгін 4-ші курстың бұрынғы президенті Хошино-сенпай да осында болады деп естідім.
Dialogue: 0,0:07:04.00,0:07:06.00,Default,,0,0,0,,Шынайы ма? Хоши мырза?
Dialogue: 0,0:07:06.00,0:07:09.00,Default,,0,0,0,,Учи келмесе, келмеймін дедің.
Dialogue: 0,0:07:09.00,0:07:10.00,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:07:10.00,0:07:12.00,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:07:12.00,0:07:15.00,Default,,0,0,0,,Жақсы, сіз барлық уақытта мұңайып көріндіңіз.
Dialogue: 0,0:07:15.00,0:07:17.00,Default,,0,0,0,,Жарайды, бар күшімізді салып тойлайық.
Dialogue: 0,0:07:24.00,0:07:27.00,Default,,0,0,0,,Ант Біраз уақыт өтті.
Dialogue: 0,0:07:32.00,0:07:34.00,Default,,0,0,0,,Аңызға айналған Пилют Салқын
Dialogue: 0,0:07:34.00,0:07:36.00,Default,,0,0,0,,Дұрыс, дұрыс, тамаша.
Dialogue: 0,0:07:36.00,0:07:38.00,Default,,0,0,0,,Мұнда не болып жатыр? Бұл шынымен жақсы.
Dialogue: 0,0:07:38.00,0:07:39.00,Default,,0,0,0,,Бұл өте нашар.
Dialogue: 0,0:07:39.00,0:07:41.00,Default,,0,0,0,,Мүмкін біз де көмектесуіміз керек еді.
Dialogue: 0,0:07:41.00,0:07:43.00,Default,,0,0,0,,Бұл шектен шыққан.
Dialogue: 0,0:07:43.00,0:07:45.00,Default,,0,0,0,,Одан да Хоши-сенпай
Dialogue: 0,0:07:46.00,0:07:48.00,Default,,0,0,0,,Учитейді құттықтаймыз
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:07:50.00,0:07:51.00,Default,,0,0,0,,О
Dialogue: 0,0:07:51.00,0:07:54.00,Default,,0,0,0,,Енді Учитейді 4-сыныптың бәрі ала алады.
Dialogue: 0,0:07:54.00,0:07:55.00,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:08:00.00,0:08:02.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:02.00,0:08:05.00,Default,,0,0,0,,Мен үйден әлі шыққан жоқпын.
Dialogue: 0,0:08:05.00,0:08:07.00,Default,,0,0,0,,Әуе түрмесі!
Dialogue: 0,0:08:07.00,0:08:09.00,Default,,0,0,0,,Мен қарқынның өзгеруін қалаймын
Dialogue: 0,0:08:09.00,0:08:11.00,Default,,0,0,0,,Мен келдім
Dialogue: 0,0:08:11.00,0:08:13.00,Default,,0,0,0,,Мен шынымен кешірім сұраймын
Dialogue: 0,0:08:15.00,0:08:17.00,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз
Dialogue: 0,0:08:17.00,0:08:20.00,Default,,0,0,0,,Бұл қандай ауа?
Dialogue: 0,0:08:24.00,0:08:27.00,Default,,0,0,0,,Маған не болды?
Dialogue: 0,0:08:27.00,0:08:29.00,Default,,0,0,0,,Дүниедегі адамдар көре алмайды
Dialogue: 0,0:08:29.00,0:08:30.00,Default,,0,0,0,,Түсіндім, түсінемін
Dialogue: 0,0:08:30.00,0:08:31.00,Default,,0,0,0,,Үлкендер жаман емес
Dialogue: 0,0:08:31.00,0:08:32.00,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:08:32.00,0:08:33.00,Default,,0,0,0,,Көбірек ішіп көріңіз
Dialogue: 0,0:08:33.00,0:08:34.00,Default,,0,0,0,,Иә, мүлде емес.
Dialogue: 0,0:08:34.00,0:08:36.00,Default,,0,0,0,,Мазалағаныңызға рахмет.
Dialogue: 0,0:08:36.00,0:08:38.00,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:38.00,0:08:39.00,Default,,0,0,0,,It's okay.
Dialogue: 0,0:08:39.00,0:08:41.00,Default,,0,0,0,,Ата-анамның үйінде болсам да
Dialogue: 0,0:08:41.00,0:08:43.00,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:08:43.00,0:08:44.00,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:08:44.00,0:08:46.00,Default,,0,0,0,,Сізге апат туралы кім айтты?
Dialogue: 0,0:08:46.00,0:08:48.00,Default,,0,0,0,,Иә, бұл көп нәрсе.
Dialogue: 0,0:08:51.00,0:08:53.00,Default,,0,0,0,,Ах, бірақ мен жеңілдеп қалдым.
Dialogue: 0,0:08:53.00,0:08:55.00,Default,,0,0,0,,Мен сенің жүзіңді көрмейінше уайымдамаймын
Dialogue: 0,0:08:55.00,0:09:01.00,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:09:01.00,0:09:04.00,Default,,0,0,0,,Сенің жүзіңді көргенше уайымдадым.
Dialogue: 0,0:09:05.00,0:09:07.00,Default,,0,0,0,,Мен олардың жүздерін көрсем де
Dialogue: 0,0:09:07.00,0:09:09.00,Default,,0,0,0,,Қайтып келгенімде жиналыс болды.
Dialogue: 0,0:09:21.00,0:09:22.00,Default,,0,0,0,,Линда Сенпай
Dialogue: 0,0:09:22.00,0:09:23.00,Default,,0,0,0,,Иә
Dialogue: 0,0:09:23.00,0:09:25.00,Default,,0,0,0,,Ескі естеліктерімді жоғалтқанға дейін
Dialogue: 0,0:09:25.00,0:09:27.00,Default,,0,0,0,,Менімен отшашу болды ма?
Dialogue: 0,0:09:27.00,0:09:29.00,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:09:31.00,0:09:32.00,Default,,0,0,0,,Үлкендер
Dialogue: 0,0:09:32.00,0:09:34.00,Default,,0,0,0,,Банри және үш жылдық орта мектеп
Dialogue: 0,0:09:34.00,0:09:36.00,Default,,0,0,0,,Біз бір сыныпта оқыдық, солай ма?
Dialogue: 0,0:09:36.00,0:09:37.00,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:09:37.00,0:09:40.00,Default,,0,0,0,,Мен көпірден құлағанша
Dialogue: 0,0:09:40.00,0:09:43.00,Default,,0,0,0,,Үйірме жұмыстары да сол жеңіл атлетика клубы болды, солай емес пе?
Dialogue: 0,0:09:43.00,0:09:44.00,Default,,0,0,0,,Линда Сенпай
Dialogue: 0,0:09:44.00,0:09:46.00,Default,,0,0,0,,Менің ойымша, бұл тамаша болды
Dialogue: 0,0:09:47.00,0:09:49.00,Default,,0,0,0,,Отшашу
Dialogue: 0,0:09:49.00,0:09:50.00,Default,,0,0,0,,Банри
Dialogue: 0,0:09:50.00,0:09:52.00,Default,,0,0,0,,Сол аяғыңызға қараңыз.
Dialogue: 0,0:09:52.00,0:09:54.00,Default,,0,0,0,,Сол аяқ
Dialogue: 0,0:09:54.00,0:09:56.00,Default,,0,0,0,,Өртенген жердің іздері
Dialogue: 0,0:09:56.00,0:09:58.00,Default,,0,0,0,,Мұзды жаз Жеңіл атлетика клубының оқу-жаттығу жиынында
Dialogue: 0,0:09:58.00,0:10:00.00,Default,,0,0,0,,Барлығы отшашуды жасағанда
Dialogue: 0,0:10:00.00,0:10:02.00,Default,,0,0,0,,Зымыран отшашуы құлады
Dialogue: 0,0:10:02.00,0:10:04.00,Default,,0,0,0,,Банриге тура соқты
Dialogue: 0,0:10:04.00,0:10:05.00,Default,,0,0,0,,Иә
Dialogue: 0,0:10:05.00,0:10:07.00,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,0:10:07.00,0:10:08.00,Default,,0,0,0,,Мен бұл менікі екеніне сенімдімін
Dialogue: 0,0:10:08.00,0:10:09.00,Default,,0,0,0,,Линда-сенпайды қорғау
Dialogue: 0,0:10:09.00,0:10:10.00,Default,,0,0,0,,Мен жарақат алдым.
Dialogue: 0,0:10:10.00,0:10:12.00,Default,,0,0,0,,Бұл намыс тыртығы
Dialogue: 0,0:10:12.00,0:10:14.00,Default,,0,0,0,,Морио қаласы керемет орын.
Dialogue: 0,0:10:15.00,0:10:17.00,Default,,0,0,0,,Мен тез қашып кеттім, бірақ
Dialogue: 0,0:10:17.00,0:10:18.00,Default,,0,0,0,,Линда-сенпай
Dialogue: 0,0:10:18.00,0:10:22.00,Default,,0,0,0,,Банриге тура соқты
Dialogue: 0,0:10:22.00,0:10:24.00,Default,,0,0,0,,Мен тез қашып кеттім, бірақ
Dialogue: 0,0:10:24.00,0:10:27.00,Default,,0,0,0,,Сіз өз еркіңізбен қашуға кешігіп қалдыңыз.
Dialogue: 0,0:10:27.00,0:10:31.00,Default,,0,0,0,,Осыдан кейін Коммон маған ашуланды және бұл өте қиын болды.
Dialogue: 0,0:10:31.00,0:10:33.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:33.00,0:10:34.00,Default,,0,0,0,,Ақырында
Dialogue: 0,0:10:34.00,0:10:36.00,Default,,0,0,0,,Бұл баяғыда.
Dialogue: 0,0:10:38.00,0:10:40.00,Default,,0,0,0,,Айтпақшы, Банри
Dialogue: 0,0:10:40.00,0:10:43.00,Default,,0,0,0,,Мен жазғы демалыста үйге бармаймын
Dialogue: 0,0:10:43.00,0:10:44.00,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:10:44.00,0:10:46.00,Default,,0,0,0,,Ата-анам да мені ренжітіп жатыр.
Dialogue: 0,0:10:49.00,0:10:50.00,Default,,0,0,0,,Линда Сенпай
Dialogue: 0,0:10:50.00,0:10:51.00,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:10:51.00,0:10:54.00,Default,,0,0,0,,Егер сіздің отбасыңыз Банриді кездестірсе,
Dialogue: 0,0:10:54.00,0:10:56.00,Default,,0,0,0,,Менімен ойнаңызшы.
Dialogue: 0,0:10:56.00,0:10:58.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:59.00,0:11:00.00,Default,,0,0,0,,Осымен
Dialogue: 0,0:11:00.00,0:11:03.00,Default,,0,0,0,,Мен мұны айтқым келген жоқ.
Dialogue: 0,0:11:05.00,0:11:07.00,Default,,0,0,0,,Сіз бара аласыз
Dialogue: 0,0:11:11.00,0:11:12.00,Default,,0,0,0,,Түлектер қауымдастығы
Dialogue: 0,0:11:12.00,0:11:13.00,Default,,0,0,0,,Орта мектеп
Dialogue: 0,0:11:13.00,0:11:14.00,Default,,0,0,0,,Иә
Dialogue: 0,0:11:14.00,0:11:15.00,Default,,0,0,0,,Келесі аптада.
Dialogue: 0,0:11:15.00,0:11:17.00,Default,,0,0,0,,Сыныптағы түлектер кездесуі
Dialogue: 0,0:11:17.00,0:11:20.00,Default,,0,0,0,,Келгіңіз келмейді деп ойлаймын.
Dialogue: 0,0:11:20.00,0:11:23.00,Default,,0,0,0,,Мен үндемеуді жоспарладым.
Dialogue: 0,0:11:23.00,0:11:25.00,Default,,0,0,0,,Бетіңізді көрсетіңіз
Dialogue: 0,0:11:27.00,0:11:28.00,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:11:28.00,0:11:30.00,Default,,0,0,0,,Ақылсыз адамдар мұны істемейді.
Dialogue: 0,0:11:30.00,0:11:31.00,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:11:31.00,0:11:34.00,Default,,0,0,0,,Барлығы сен үшін алаңдайды
Dialogue: 0,0:11:34.00,0:11:38.00,Default,,0,0,0,,Мен оның жайдары жүзін көрсем, ол шынымен де бақытты болар еді деп ойлаймын.
Dialogue: 0,0:11:38.00,0:11:40.00,Default,,0,0,0,,Менің саған айтарым осы ғана.
Dialogue: 0,0:11:42.00,0:11:43.00,Default,,0,0,0,,Аға
Dialogue: 0,0:11:43.00,0:11:45.00,Default,,0,0,0,,Оған Банри қатысады
Dialogue: 0,0:11:45.00,0:11:46.00,Default,,0,0,0,,Сіз қалайсыз?
Dialogue: 0,0:11:46.00,0:11:47.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:11:47.00,0:11:48.00,Default,,0,0,0,,Неліктен жоқ?
Dialogue: 0,0:11:48.00,0:11:49.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:49.00,0:11:51.00,Default,,0,0,0,,Әрине.
Dialogue: 0,0:11:53.00,0:11:54.00,Default,,0,0,0,,Иә
Dialogue: 0,0:11:55.00,0:11:56.00,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:11:57.00,0:11:58.00,Default,,0,0,0,,Түлектер қауымдастығы
Dialogue: 0,0:11:58.00,0:11:59.00,Default,,0,0,0,,Қатысу
Dialogue: 0,0:12:04.00,0:12:05.00,Default,,0,0,0,,Жер
Dialogue: 0,0:12:05.00,0:12:07.00,Default,,0,0,0,,Мен қажет емес нәрсе жасадым ба?
Dialogue: 0,0:12:07.00,0:12:10.00,Default,,0,0,0,,Өз шешімімді қабылдағаным үшін кешірім сұраймын.
Dialogue: 0,0:12:10.00,0:12:11.00,Default,,0,0,0,,Мен
Dialogue: 0,0:12:11.00,0:12:12.00,Default,,0,0,0,,Банри тағы қиындыққа тап болды.
Dialogue: 0,0:12:12.00,0:12:13.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:13.00,0:12:14.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:14.00,0:12:17.00,Default,,0,0,0,,Мен өткенімнен қашуды тоқтатуды шештім.
Dialogue: 0,0:12:17.00,0:12:18.00,Default,,0,0,0,,Не болды? Пластырь жапсыруым керек болар.
Dialogue: 0,0:12:18.00,0:12:19.00,Default,,0,0,0,,Мен
Dialogue: 0,0:12:20.00,0:12:21.00,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:21.00,0:12:23.00,Default,,0,0,0,,Шынымды айтсам, мен уайымдап отырмын.
Dialogue: 0,0:12:23.00,0:12:25.00,Default,,0,0,0,,Әркім нені кездестіргісі келеді
Dialogue: 0,0:12:25.00,0:12:28.00,Default,,0,0,0,,Тек Банри есте сақтау қабілетін жоғалтқанға дейін.
Dialogue: 0,0:12:28.00,0:12:29.00,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:12:29.00,0:12:32.00,Default,,0,0,0,,Мен қазіргіден басқа адаммын.
Dialogue: 0,0:12:32.00,0:12:33.00,Default,,0,0,0,,Біз кездескен кезде
Dialogue: 0,0:12:33.00,0:12:34.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:34.00,0:12:37.00,Default,,0,0,0,,Сізге ұқсас болуы мүмкін
Dialogue: 0,0:12:37.00,0:12:39.00,Default,,0,0,0,,Құттықтаймыз, біз кездескіміз келеді
Dialogue: 0,0:12:39.00,0:12:40.00,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,0:12:40.00,0:12:42.00,Default,,0,0,0,,Мен Банридің түпнұсқасымен танысқым келеді.
Dialogue: 0,0:12:42.00,0:12:43.00,Default,,0,0,0,,немесе соған ұқсас нәрсе
Dialogue: 0,0:12:43.00,0:12:45.00,Default,,0,0,0,,Сіз ойлануыңыз мүмкін
Dialogue: 0,0:12:46.00,0:12:48.00,Default,,0,0,0,,Бұл туралы өткен күні Коуко маған айтты.
Dialogue: 0,0:12:48.00,0:12:51.00,Default,,0,0,0,,Ол отбасы мен достарын тастап қашып кетті.
Dialogue: 0,0:12:52.00,0:12:54.00,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:12:54.00,0:12:55.00,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:12:55.00,0:12:57.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:57.00,0:12:58.00,Default,,0,0,0,,Мен
Dialogue: 0,0:12:58.00,0:13:00.00,Default,,0,0,0,,Есте сақтау қабілетім жоқ екенін білсем де.
Dialogue: 0,0:13:00.00,0:13:01.00,Default,,0,0,0,,Анна
Dialogue: 0,0:13:01.00,0:13:02.00,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:13:02.00,0:13:04.00,Default,,0,0,0,,Бұлай айтқаныңызға қуаныштымын.
Dialogue: 0,0:13:04.00,0:13:05.00,Default,,0,0,0,,Мен де солаймын.
Dialogue: 0,0:13:05.00,0:13:07.00,Default,,0,0,0,,Мен сыныпта барлығымен танысамын.
Dialogue: 0,0:13:07.00,0:13:10.00,Default,,0,0,0,,Сіз қалай сезінсеңіз де, оған көмектесу мүмкін емес.
Dialogue: 0,0:13:10.00,0:13:12.00,Default,,0,0,0,,Сізді алаңдатқаным үшін кешірім сұраңыз
Dialogue: 0,0:13:12.00,0:13:14.00,Default,,0,0,0,,Рахмет айт
Dialogue: 0,0:13:16.00,0:13:17.00,Default,,0,0,0,,Маған бұл не деген қызық.
Dialogue: 0,0:13:18.00,0:13:19.00,Default,,0,0,0,,Мен
Dialogue: 0,0:13:19.00,0:13:22.00,Default,,0,0,0,,Мен бүкіл Банримен кездесе алатын сияқтымын.
Dialogue: 0,0:13:23.00,0:13:24.00,Default,,0,0,0,,Толық?
Dialogue: 0,0:13:24.00,0:13:25.00,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:13:25.00,0:13:27.00,Default,,0,0,0,,Мен Банриді кездестіретін сияқтымын.
Dialogue: 0,0:13:27.00,0:13:28.00,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:13:28.00,0:13:30.00,Default,,0,0,0,,Мен Банриді кездестіретін сияқтымын.
Dialogue: 0,0:13:30.00,0:13:31.00,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:13:31.00,0:13:33.00,Default,,0,0,0,,Мен Банриді кездестіретін сияқтымын.
Dialogue: 0,0:13:33.00,0:13:34.00,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:13:34.00,0:13:35.00,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:13:35.00,0:13:36.00,Default,,0,0,0,,Банри туралы
Dialogue: 0,0:13:36.00,0:13:38.00,Default,,0,0,0,,Мен оны шынымен қабылдадым деп ойламаймын.
Dialogue: 0,0:13:39.00,0:13:41.00,Default,,0,0,0,,Маған ыңғайлы тек Банри
Dialogue: 0,0:13:41.00,0:13:43.00,Default,,0,0,0,,Мүмкін ол оны көргісі келмеді.
Dialogue: 0,0:13:44.00,0:13:46.00,Default,,0,0,0,,Мен білмейтін Банри
Dialogue: 0,0:13:46.00,0:13:48.00,Default,,0,0,0,,Білетін адам бар екенін
Dialogue: 0,0:13:48.00,0:13:49.00,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:13:49.00,0:13:51.00,Default,,0,0,0,,Қабылданбады.
Dialogue: 0,0:13:52.00,0:13:54.00,Default,,0,0,0,,Қызғаныш, солай ма?
Dialogue: 0,0:13:55.00,0:13:56.00,Default,,0,0,0,,және сезім
Dialogue: 0,0:13:57.00,0:13:58.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:13:58.00,0:14:00.00,Default,,0,0,0,,Сіз маған өткен күні айттыңыз.
Dialogue: 0,0:14:00.00,0:14:02.00,Default,,0,0,0,,Мен де бар күшімді саламын
Dialogue: 0,0:14:02.00,0:14:04.00,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Коуко да.
Dialogue: 0,0:14:04.00,0:14:06.00,Default,,0,0,0,,Менімен бірге көліктен түспе.
Dialogue: 0,0:14:07.00,0:14:08.00,Default,,0,0,0,,Мен
Dialogue: 0,0:14:08.00,0:14:10.00,Default,,0,0,0,,Мен сені Банриді жақсы көресің деп ойладым.
Dialogue: 0,0:14:11.00,0:14:12.00,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:14:12.00,0:14:15.00,Default,,0,0,0,,Мен ғашық болу дұрыс екенін білдім
Dialogue: 0,0:14:18.00,0:14:20.00,Default,,0,0,0,,Маған Банри ұнайды, себебі ол Банри.
Dialogue: 0,0:14:20.00,0:14:23.00,Default,,0,0,0,,Мен Банридің толығымен Банри болғанына қуаныштымын.
Dialogue: 0,0:14:24.00,0:14:26.00,Default,,0,0,0,,Мен де танымайтын Банри
Dialogue: 0,0:14:26.00,0:14:28.00,Default,,0,0,0,,Мен тіпті Банриді де жек көремін
Dialogue: 0,0:14:28.00,0:14:29.00,Default,,0,0,0,,Оның қандай маңызы бар?
Dialogue: 0,0:14:29.00,0:14:31.00,Default,,0,0,0,,Бұл Банри болса жақсы.
Dialogue: 0,0:14:32.00,0:14:34.00,Default,,0,0,0,,Егер бәрі толығымен Банри болса
Dialogue: 0,0:14:34.00,0:14:36.00,Default,,0,0,0,,Маған керегі осы
Dialogue: 0,0:14:38.00,0:14:39.00,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:14:39.00,0:14:42.00,Default,,0,0,0,,Жалпы кім екенімді ұмыту ауырады.
Dialogue: 0,0:14:44.00,0:14:47.00,Default,,0,0,0,,Көрмейтін Банри де Банри.
Dialogue: 0,0:14:48.00,0:14:49.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:14:49.00,0:14:51.00,Default,,0,0,0,,Бұрынғы Банри туралы
Dialogue: 0,0:14:51.00,0:14:52.00,Default,,0,0,0,,Өз көзіңізбен қараңыз
Dialogue: 0,0:14:53.00,0:14:55.00,Default,,0,0,0,,Қазіргі Банри ұмытып кеткен Банри
Dialogue: 0,0:14:55.00,0:14:58.00,Default,,0,0,0,,Мен оны кездестіргенге дейін Банри туралы.
Dialogue: 0,0:14:58.00,0:14:59.00,Default,,0,0,0,,Өзіңіз қараңыз
Dialogue: 0,0:15:00.00,0:15:01.00,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:15:01.00,0:15:02.00,Default,,0,0,0,,Менімен сөйлескеніңізді қалаймын.
Dialogue: 0,0:15:25.00,0:15:27.00,Default,,0,0,0,,Осы қорапша кітапты қазір аша аламын ба?
Dialogue: 0,0:15:27.00,0:15:28.00,Default,,0,0,0,,Иә
Dialogue: 0,0:15:28.00,0:15:31.00,Default,,0,0,0,,Мына қорапты Сумикоға апарыңыз.
Dialogue: 0,0:15:32.00,0:15:34.00,Default,,0,0,0,,Ішінде нәзік заттар бар, сондықтан абай болыңыз.
Dialogue: 0,0:15:35.00,0:15:37.00,Default,,0,0,0,,Адамдармен қарым-қатынасың жаман емес.
Dialogue: 0,0:15:38.00,0:15:39.00,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:15:41.00,0:15:43.00,Default,,0,0,0,,Тага-сан, сен бүгін түнде тұрасың.
Dialogue: 0,0:15:44.00,0:15:46.00,Default,,0,0,0,,Тазалауға түнге дейін керек сияқты.
Dialogue: 0,0:15:47.00,0:15:48.00,Default,,0,0,0,,Эй, не?
Dialogue: 0,0:15:48.00,0:15:50.00,Default,,0,0,0,,Сіз мені түнге дейін жұмыс істеуге мәжбүр етесіз бе?
Dialogue: 0,0:15:51.00,0:15:54.00,Default,,0,0,0,,Сол үшін келдіңіз, солай ма?
Dialogue: 0,0:15:54.00,0:15:55.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:55.00,0:15:59.00,Default,,0,0,0,,Мен саған қозғалуға көмектескім келмеді.
Dialogue: 0,0:15:59.00,0:16:02.00,Default,,0,0,0,,Мен аздап қызыққандықтан қарап шығуға келдім.
Dialogue: 0,0:16:02.00,0:16:04.00,Default,,0,0,0,,Мен бөлме тамаша емес деп естідім.
Dialogue: 0,0:16:04.00,0:16:06.00,Default,,0,0,0,,Мен қатты күлемін деп ойладым
Dialogue: 0,0:16:06.00,0:16:08.00,Default,,0,0,0,,Жұп пепло дайындаңыз
Dialogue: 0,0:16:09.00,0:16:11.00,Default,,0,0,0,,Жарайды, бәрібір тез орындайық.
Dialogue: 0,0:16:11.00,0:16:14.00,Default,,0,0,0,,Тага-сан менің ұйықтап жатқан бірінші қонағым.
Dialogue: 0,0:16:15.00,0:16:17.00,Default,,0,0,0,,Өйткені мен тоқтамаймын
Dialogue: 0,0:16:17.00,0:16:19.00,Default,,0,0,0,,Өлсем де, жер жойылса да
Dialogue: 0,0:16:19.00,0:16:21.00,Default,,0,0,0,,Өйткені ол ешқашан тоқтамайды
Dialogue: 0,0:16:25.00,0:16:26.00,Default,,0,0,0,,Тага-сан
Dialogue: 0,0:16:26.00,0:16:27.00,Default,,0,0,0,,Не?
Dialogue: 0,0:16:28.00,0:16:31.00,Default,,0,0,0,,Менің дәл қазір не ойлап тұрғанымды болжап көрейік.
Dialogue: 0,0:16:32.00,0:16:34.00,Default,,0,0,0,,Егер сіз кездейсоқ болжасаңыз
Dialogue: 0,0:16:34.00,0:16:36.00,Default,,0,0,0,,Сіз Бэнли туралы айтып отырсыз, солай ма?
Dialogue: 0,0:16:36.00,0:16:39.00,Default,,0,0,0,,Сіз бұл күндері Шидзуокада не істеп жүрсіз?
Dialogue: 0,0:16:41.00,0:16:43.00,Default,,0,0,0,,Тага-сан керемет.
Dialogue: 0,0:16:43.00,0:16:47.00,Default,,0,0,0,,Бір ғашық болған соң, бақытқа мәңгі ғашық боласың.
Dialogue: 0,0:16:48.00,0:16:50.00,Default,,0,0,0,,Бәрі де солай емес пе?
Dialogue: 0,0:16:51.00,0:16:53.00,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:16:53.00,0:16:56.00,Default,,0,0,0,,Мен Тага-санды құрметтеймін.
Dialogue: 0,0:16:58.00,0:17:00.00,Default,,0,0,0,,Эй, қазір не болып жатыр?
Dialogue: 0,0:17:02.00,0:17:05.00,Default,,0,0,0,,Бұл, әрине, әзіл, солай ма?
Dialogue: 0,0:17:07.00,0:17:08.00,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:17:12.00,0:17:15.00,Default,,0,0,0,,Линда-сенпай, сіз әлі де жақсы емессіз бе?
Dialogue: 0,0:17:15.00,0:17:17.00,Default,,0,0,0,,Иә, бірінші пойызға дейін қалуды жоспарлап отырмын.
Dialogue: 0,0:17:17.00,0:17:20.00,Default,,0,0,0,,Пойыз қозғала бастағанда, мен Шинкансенді аламын.
Dialogue: 0,0:17:20.00,0:17:23.00,Default,,0,0,0,,Линда-сенпай, ата-анаңның үйіне қайта барасың ба?
Dialogue: 0,0:17:23.00,0:17:26.00,Default,,0,0,0,,Бастапқыда мен бірден үйге баруды жоспарладым.
Dialogue: 0,0:17:26.00,0:17:28.00,Default,,0,0,0,,Мені кенеттен осында толық емес жұмыс күнімен жұмыс істеуді сұрады.
Dialogue: 0,0:17:28.00,0:17:30.00,Default,,0,0,0,,Бір ғана демалыс күні
Dialogue: 0,0:17:30.00,0:17:32.00,Default,,0,0,0,,Мен де екі кішінің жүзін көрдім.
Dialogue: 0,0:17:33.00,0:17:34.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:17:34.00,0:17:37.00,Default,,0,0,0,,Мен қажет емес нәрсе жасадым ба?
Dialogue: 0,0:17:37.00,0:17:41.00,Default,,0,0,0,,Мен Линда-сенпайға апат туралы хабарласып, оны алаңдаттым.
Dialogue: 0,0:17:41.00,0:17:43.00,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:17:43.00,0:17:44.00,Default,,0,0,0,,Маған мұны үйреткеніңізге қуаныштымын.
Dialogue: 0,0:17:44.00,0:17:46.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:46.00,0:17:47.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:48.00,0:17:49.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:17:49.00,0:17:51.00,Default,,0,0,0,,Саған да көмектесейін бе?
Dialogue: 0,0:17:51.00,0:17:54.00,Default,,0,0,0,,Ах, ақыры аяқталды.
Dialogue: 0,0:17:55.00,0:17:56.00,Default,,0,0,0,,О
Dialogue: 0,0:17:56.00,0:17:57.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:17:57.00,0:17:59.00,Default,,0,0,0,,Ата-анаңның үйінде қанша уақыт боласың?
Dialogue: 0,0:17:59.00,0:18:01.00,Default,,0,0,0,,Мүмкін жазғы демалыстың соңына дейін
Dialogue: 0,0:18:01.00,0:18:03.00,Default,,0,0,0,,Сондай-ақ, түлектердің бас қосуы бар.
Dialogue: 0,0:18:03.00,0:18:06.00,Default,,0,0,0,,Одан кейін жергілікті достарыммен араласуды жоспарлап отырмын.
Dialogue: 0,0:18:06.00,0:18:09.00,Default,,0,0,0,,Сыныптың бас қосуы жақсы.
Dialogue: 0,0:18:10.00,0:18:12.00,Default,,0,0,0,,Сіз осындай нәрсені жоспарлап отырсыз ба?
Dialogue: 0,0:18:12.00,0:18:14.00,Default,,0,0,0,,Қазір
Dialogue: 0,0:18:14.00,0:18:16.00,Default,,0,0,0,,Банри де үйіне қайтты.
Dialogue: 0,0:18:16.00,0:18:19.00,Default,,0,0,0,,Ойнайтын адамым аз болғандықтан жалықтым.
Dialogue: 0,0:18:20.00,0:18:22.00,Default,,0,0,0,,Линда-сенпай Шидзуокадан келген бе?
Dialogue: 0,0:18:22.00,0:18:23.00,Default,,0,0,0,,Иә
Dialogue: 0,0:18:23.00,0:18:24.00,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:18:24.00,0:18:25.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:25.00,0:18:28.00,Default,,0,0,0,,Банри де Шидзуоканы айтты.
Dialogue: 0,0:18:28.00,0:18:29.00,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:18:29.00,0:18:31.00,Default,,0,0,0,,Мен бір жерде Банридің жанынан өттім.
Dialogue: 0,0:18:31.00,0:18:33.00,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:18:33.00,0:18:36.00,Default,,0,0,0,,Шизуока - үлкен жер.
Dialogue: 0,0:18:37.00,0:18:39.00,Default,,0,0,0,,Маған не істеп жатқаныңызды айтыңыз.
Dialogue: 0,0:18:39.00,0:18:40.00,Default,,0,0,0,,Иә
Dialogue: 0,0:18:40.00,0:18:41.00,Default,,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:18:41.00,0:18:42.00,Default,,0,0,0,,Иә
Dialogue: 0,0:18:42.00,0:18:44.00,Default,,0,0,0,,Неге олай істейсің?
Dialogue: 0,0:18:45.00,0:18:47.00,Default,,0,0,0,,Неліктен мұны істеймін деп ойлайсың?
Dialogue: 0,0:18:52.00,0:18:54.00,Default,,0,0,0,,Мен өз бөлмеме қайтайын.
Dialogue: 0,0:18:54.00,0:18:55.00,Default,,0,0,0,,Джейн
Dialogue: 0,0:18:59.00,0:19:01.00,Default,,0,0,0,,Үш жақсы. Үшеуі жақсы.
Dialogue: 0,0:19:01.00,0:19:04.00,Default,,0,0,0,,Әй, бірақ олардың барлығын әртүрлі дәмді етіп жасаңыз.
Dialogue: 0,0:19:04.00,0:19:05.00,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:19:05.00,0:19:08.00,Default,,0,0,0,,Сонымен қатар, дәретхана қайда?
Dialogue: 0,0:19:08.00,0:19:09.00,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:19:13.00,0:19:15.00,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:19:15.00,0:19:17.00,Default,,0,0,0,,Саған рахмет, Кага-сан, жақсарғаның үшін.
Dialogue: 0,0:19:18.00,0:19:20.00,Default,,0,0,0,,А, бұл өте жақсы болды.
Dialogue: 0,0:19:20.00,0:19:21.00,Default,,0,0,0,,О
Dialogue: 0,0:19:21.00,0:19:23.00,Default,,0,0,0,,Мен де Ока-чанды кездестірсем ғой.
Dialogue: 0,0:19:23.00,0:19:25.00,Default,,0,0,0,,Біз көмектесе алмаймыз ба?
Dialogue: 0,0:19:25.00,0:19:27.00,Default,,0,0,0,,Көшіп болған соң жинап біткен жоқ дейді.
Dialogue: 0,0:19:27.00,0:19:28.00,Default,,0,0,0,,О
Dialogue: 0,0:19:29.00,0:19:30.00,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:19:30.00,0:19:32.00,Default,,0,0,0,,Бұл жолы Янаги мырзаның біраз қиындықтары бар.
Dialogue: 0,0:19:32.00,0:19:34.00,Default,,0,0,0,,Мазасыз ба?
Dialogue: 0,0:19:36.00,0:19:37.00,Default,,0,0,0,,Осымен
Dialogue: 0,0:19:37.00,0:19:39.00,Default,,0,0,0,,Банридің туған қаласы - Шидзуока.
Dialogue: 0,0:19:39.00,0:19:41.00,Default,,0,0,0,,Сен оның қандай орта мектеп екенін білесің бе?
Dialogue: 0,0:19:41.00,0:19:42.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:42.00,0:19:43.00,Default,,0,0,0,,Һмпф
Dialogue: 0,0:19:43.00,0:19:46.00,Default,,0,0,0,,Өткені туралы көп айтпайды.
Dialogue: 0,0:19:46.00,0:19:47.00,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:19:47.00,0:19:50.00,Default,,0,0,0,,Өйткені, апаттар мен жарақаттар болды.
Dialogue: 0,0:19:50.00,0:19:52.00,Default,,0,0,0,,Мүмкін есіңе алғың келмейтін шығар?
Dialogue: 0,0:19:52.00,0:19:53.00,Default,,0,0,0,,Апат
Dialogue: 0,0:19:53.00,0:19:54.00,Default,,0,0,0,,Жақында болған апатты айтасыз ба?
Dialogue: 0,0:19:54.00,0:19:55.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:55.00,0:19:56.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:56.00,0:19:58.00,Default,,0,0,0,,Янаги-сан тыңдамайды.
Dialogue: 0,0:19:58.00,0:20:01.00,Default,,0,0,0,,Банридің көпірден құлап, ауыр жарақат алу оқиғасы.
Dialogue: 0,0:20:01.00,0:20:02.00,Default,,0,0,0,,Ауыр жарақат
Dialogue: 0,0:20:02.00,0:20:04.00,Default,,0,0,0,,Біздің алдымызда
Dialogue: 0,0:20:04.00,0:20:07.00,Default,,0,0,0,,Сізді жат дінге алдап, жаттығу лагеріне апарды.
Dialogue: 0,0:20:07.00,0:20:09.00,Default,,0,0,0,,Сол кезде Банри осылай деді.
Dialogue: 0,0:20:09.00,0:20:12.00,Default,,0,0,0,,Көпірден құлап, біраз уақыт ауруханада жатыр.
Dialogue: 0,0:20:13.00,0:20:14.00,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:20:14.00,0:20:18.00,Default,,0,0,0,,Сол тәжірибенің арқасында мен ғана дінге қызығамын.
Dialogue: 0,0:20:18.00,0:20:20.00,Default,,0,0,0,,Қалғандардың бәрі қызық емес, сондықтан үйлеріне қайтсын.
Dialogue: 0,0:20:20.00,0:20:21.00,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:20:21.00,0:20:22.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:22.00,0:20:24.00,Default,,0,0,0,,Бірақ бұл рас па?
Dialogue: 0,0:20:24.00,0:20:27.00,Default,,0,0,0,,Мен де оны өтірік деп ойлайтынмын.
Dialogue: 0,0:20:27.00,0:20:31.00,Default,,0,0,0,,Менің ойымша, ол бізді құтылу үшін аузынан шығарып жіберді.
Dialogue: 0,0:20:31.00,0:20:32.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:32.00,0:20:34.00,Default,,0,0,0,,Өткенде теңізге барғанымда
Dialogue: 0,0:20:34.00,0:20:36.00,Default,,0,0,0,,Мен әлсіз тыртықтарды көрдім.
Dialogue: 0,0:20:36.00,0:20:38.00,Default,,0,0,0,,Осы жерде
Dialogue: 0,0:20:38.00,0:20:40.00,Default,,0,0,0,,Мен білмейтін сияқтымын.
Dialogue: 0,0:20:40.00,0:20:44.00,Default,,0,0,0,,Оқу-жаттығу жиынында барғаныңыз рас шығар?
Dialogue: 0,0:20:44.00,0:20:46.00,Default,,0,0,0,,Басқа да көп нәрсені айтты.
Dialogue: 0,0:20:46.00,0:20:48.00,Default,,0,0,0,,Әртүрлі заттар қандай?
Dialogue: 0,0:20:48.00,0:20:49.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:49.00,0:20:52.00,Default,,0,0,0,,Қаншалықты шын, қанша өтірік екенін білмеймін.
Dialogue: 0,0:20:52.00,0:20:53.00,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:20:53.00,0:20:55.00,Default,,0,0,0,,Адам сөйлескісі келмесе де
Dialogue: 0,0:20:55.00,0:20:57.00,Default,,0,0,0,,Көп таңдау жасау жақсы емес.
Dialogue: 0,0:20:57.00,0:20:59.00,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:21:04.00,0:21:06.00,Default,,0,0,0,,Уау, дәмді көрінеді
Dialogue: 0,0:21:06.00,0:21:07.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:07.00,0:21:08.00,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені алыңыз
Dialogue: 0,0:21:08.00,0:21:10.00,Default,,0,0,0,,Менің сыйлығым
Dialogue: 0,0:21:10.00,0:21:12.00,Default,,0,0,0,,Себебі мен көп нәрсеге алаңдадым.
Dialogue: 0,0:21:12.00,0:21:13.00,Default,,0,0,0,,О
Dialogue: 0,0:21:13.00,0:21:14.00,Default,,0,0,0,,Кага-сан семіз
Dialogue: 0,0:21:14.00,0:21:15.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:21:15.00,0:21:18.00,Default,,0,0,0,,Сіз бұл жақсы досқа не айтасыз?
Dialogue: 0,0:21:18.00,0:21:20.00,Default,,0,0,0,,АҚШ АҚШ жіңішке іш Жұқа іш
Dialogue: 0,0:21:20.00,0:21:21.00,Default,,0,0,0,,Мұнда
Dialogue: 0,0:21:21.00,0:21:22.00,Default,,0,0,0,,Сіз білдіңіз
Dialogue: 0,0:21:22.00,0:21:23.00,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:21:23.00,0:21:24.00,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:21:24.00,0:21:25.00,Default,,0,0,0,,Банри ауруханаға жатқызылды
Dialogue: 0,0:21:25.00,0:21:26.00,Default,,0,0,0,,Чо
Dialogue: 0,0:21:26.00,0:21:27.00,Default,,0,0,0,,Янасан
Dialogue: 0,0:21:27.00,0:21:28.00,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:21:28.00,0:21:30.00,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:30.00,0:21:32.00,Default,,0,0,0,,Менде түсінік жоқ
Dialogue: 0,0:21:32.00,0:21:34.00,Default,,0,0,0,,Иә Қасық
Dialogue: 0,0:21:34.00,0:21:35.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:21:35.00,0:21:36.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:36.00,0:21:37.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:37.00,0:21:38.00,Default,,0,0,0,,Мицуомо
Dialogue: 0,0:21:38.00,0:21:39.00,Default,,0,0,0,,Секір!!
Dialogue: 0,0:21:39.00,0:21:40.00,Default,,0,0,0,,Еш ойланбастан жеу керек пе?
Dialogue: 0,0:21:40.00,0:21:42.00,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:21:42.00,0:21:43.00,Default,,0,0,0,,Иә, Кага-сан.
Dialogue: 0,0:21:43.00,0:21:45.00,Default,,0,0,0,,Анаңның бөлмесі қалай болды?
Dialogue: 0,0:21:45.00,0:21:46.00,Default,,0,0,0,,Ол тоқтады ма?
Dialogue: 0,0:21:46.00,0:21:47.00,Default,,0,0,0,,тоқтатылды
Dialogue: 0,0:21:47.00,0:21:48.00,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:21:48.00,0:21:51.00,Default,,0,0,0,,Мен тіпті қозғалуға көмектесу үшін жасалғанмын.
Dialogue: 0,0:21:51.00,0:21:52.00,Default,,0,0,0,,О
Dialogue: 0,0:21:52.00,0:21:54.00,Default,,0,0,0,,Кага-санның жұмыс істегені жақсы емес пе?
Dialogue: 0,0:21:54.00,0:21:55.00,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:22:04.00,0:22:08.00,Default,,0,0,0,,Жоқ, ол басқаша.
Dialogue: 0,0:22:08.00,0:22:09.00,Default,,0,0,0,,О
Dialogue: 0,0:22:09.00,0:22:11.00,Default,,0,0,0,,Сіз нені әлі түсінбейсіз
Dialogue: 0,0:22:11.00,0:22:14.00,Default,,0,0,0,,Екі-үш сағат бұрын шығар.
Dialogue: 0,0:22:14.00,0:22:15.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:22:15.00,0:22:18.00,Default,,0,0,0,,Қолыңды тигізгім келеді
Dialogue: 0,0:22:18.00,0:22:24.00,Default,,0,0,0,,Мен махаббатсыз бола алмаймын
Dialogue: 0,0:22:24.00,0:22:28.00,Default,,0,0,0,,Мен айқайлап жібергім келеді
Dialogue: 0,0:22:28.00,0:22:31.00,Default,,0,0,0,,Мен махаббатсыз бола алмаймын
Dialogue: 0,0:22:31.00,0:22:35.00,Default,,0,0,0,,Айқайлағысы келетін сезім
Dialogue: 0,0:22:35.00,0:22:36.00,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:22:36.00,0:22:38.00,Default,,0,0,0,,Олардың көптігі сонша, мені мазалайды
Dialogue: 0,0:22:38.00,0:22:40.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:22:40.00,0:22:42.00,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:22:42.00,0:22:43.00,Default,,0,0,0,,О
Dialogue: 0,0:22:43.00,0:22:45.00,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:22:45.00,0:22:48.00,Default,,0,0,0,,шынымен де
Dialogue: 0,0:22:48.00,0:22:52.00,Default,,0,0,0,,Маған ғашық
Dialogue: 0,0:22:52.00,0:22:55.00,Default,,0,0,0,,Дауысты сөздер
Dialogue: 0,0:22:55.00,0:22:58.00,Default,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:22:58.00,0:23:01.00,Default,,0,0,0,,Тездетіп мені сүй
Dialogue: 0,0:23:01.00,0:23:04.00,Default,,0,0,0,,5000 жылдан кейін мені қызықтырмайды.
Dialogue: 0,0:23:04.00,0:23:08.00,Default,,0,0,0,,Мен шексіз емеспін
Dialogue: 0,0:23:08.00,0:23:11.00,Default,,0,0,0,,Сен бір күні өлесің
Dialogue: 0,0:23:11.00,0:23:14.00,Default,,0,0,0,,Мен сені мәңгілікке сүйемін
Dialogue: 0,0:23:14.00,0:23:17.00,Default,,0,0,0,,Айтсаң да риза емеспін
Dialogue: 0,0:23:17.00,0:23:21.00,Default,,0,0,0,,Біріншіден, менімен танысқанша
Dialogue: 0,0:23:21.00,0:23:25.00,Default,,0,0,0,,Тек сүюді ойла
Dialogue: 0,0:23:26.50,0:23:31.50,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
