Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Бұл... менің есте сақтау қабілетім жоғалған жер.
Dialogue: 0,0:00:06.00,0:00:07.00,Default,,0,0,0,,Неге...
Dialogue: 0,0:00:08.00,0:00:09.00,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:00:10.00,0:00:11.00,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:00:12.00,0:00:13.00,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:00:14.00,0:00:15.00,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:00:16.00,0:00:17.00,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:00:19.00,0:00:20.00,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:00:21.00,0:00:22.00,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:00:23.00,0:00:24.00,Default,,0,0,0,,Неге...
Dialogue: 0,0:00:25.00,0:00:26.00,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:00:27.00,0:00:29.00,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:00:30.00,0:00:31.00,Default,,0,0,0,,Мен неге...
Dialogue: 0,0:00:32.00,0:00:34.00,Default,,0,0,0,,Менің есімде ештеңе жоқ
Dialogue: 0,0:00:35.00,0:00:36.00,Default,,0,0,0,,Линда-сенпай...
Dialogue: 0,0:00:36.00,0:00:38.00,Default,,0,0,0,,Мен туралы не болды?
Dialogue: 0,0:00:44.00,0:00:45.00,Default,,0,0,0,,Энди
Dialogue: 0,0:00:45.00,0:00:46.00,Default,,0,0,0,,Янус мырза
Dialogue: 0,0:00:47.00,0:00:48.00,Default,,0,0,0,,Осымен
Dialogue: 0,0:00:48.00,0:00:50.00,Default,,0,0,0,,Қазір бара аласың ба?
Dialogue: 0,0:00:51.00,0:00:52.00,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:52.00,0:00:53.00,Default,,0,0,0,,Ешқайсысы жоқ.
Dialogue: 0,0:00:53.00,0:00:54.00,Default,,0,0,0,,Не?
Dialogue: 0,0:00:55.00,0:00:56.00,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:56.00,0:00:57.00,Default,,0,0,0,,Ешқайсысы жоқ.
Dialogue: 0,0:01:26.00,0:01:29.00,Default,,0,0,0,,Мен ешқашан ұмытпаймын
Dialogue: 0,0:01:36.00,0:01:39.00,Default,,0,0,0,,Мен қайдамын?
Dialogue: 0,0:01:40.00,0:01:42.00,Default,,0,0,0,,Ересек болу қиын.
Dialogue: 0,0:01:43.00,0:01:46.00,Default,,0,0,0,,Мен оны әзірше ұмыта аламын ба?
Dialogue: 0,0:01:46.00,0:01:48.00,Default,,0,0,0,,Өйткені түн күтіп тұр
Dialogue: 0,0:01:49.00,0:01:51.00,Default,,0,0,0,,Жүрегің лүпілдесін
Dialogue: 0,0:01:51.00,0:01:53.00,Default,,0,0,0,,Біз кездесе аламыз
Dialogue: 0,0:01:53.00,0:01:56.00,Default,,0,0,0,,Егер сіз ойнасаңыз
Dialogue: 0,0:01:56.00,0:01:58.00,Default,,0,0,0,,Мен сізге айтқым келеді
Dialogue: 0,0:01:58.00,0:02:00.00,Default,,0,0,0,,Енді менің ойымда
Dialogue: 0,0:02:00.00,0:02:03.00,Default,,0,0,0,,Байқаймын ба деп қорқамын
Dialogue: 0,0:02:03.00,0:02:05.00,Default,,0,0,0,,Өткен және болашақ
Dialogue: 0,0:02:05.00,0:02:07.00,Default,,0,0,0,,Қорықсаң да
Dialogue: 0,0:02:07.00,0:02:10.00,Default,,0,0,0,,Бос болса қозғала алмайды
Dialogue: 0,0:02:10.00,0:02:12.00,Default,,0,0,0,,Егер сізге ұнаса
Dialogue: 0,0:02:12.00,0:02:15.00,Default,,0,0,0,,Бәрі жақсы
Dialogue: 0,0:02:15.00,0:02:17.00,Default,,0,0,0,,бастайық
Dialogue: 0,0:02:17.00,0:02:20.00,Default,,0,0,0,,Барлық жаман нәрселерді ұмытыңыз
Dialogue: 0,0:02:20.00,0:02:23.00,Default,,0,0,0,,Мен сенімен түнде билесем
Dialogue: 0,0:02:23.00,0:02:27.00,Default,,0,0,0,,Өзіңіздің жақсырақ нұсқасы болыңыз
Dialogue: 0,0:02:27.00,0:02:30.00,Default,,0,0,0,,Мен солай сезінемін
Dialogue: 0,0:02:30.00,0:02:34.00,Default,,0,0,0,,Ешқашан аяқталмайтын мазмұн уақыты
Dialogue: 0,0:02:34.00,0:02:37.00,Default,,0,0,0,,Сен екеуміздің арамыз жақындап барады
Dialogue: 0,0:02:37.00,0:02:40.00,Default,,0,0,0,,Айналма болса да соқпа, жіберме
Dialogue: 0,0:02:40.00,0:02:43.00,Default,,0,0,0,,Мен оны бағалағым келеді
Dialogue: 0,0:02:51.00,0:02:53.00,Default,,0,0,0,,18 жасқа дейін
Dialogue: 0,0:02:53.00,0:02:56.00,Default,,0,0,0,,Мен жай ғана Банри болдым
Dialogue: 0,0:02:56.00,0:02:58.00,Default,,0,0,0,,Мектеп бітіру рәсімінен кейінгі күні
Dialogue: 0,0:02:58.00,0:03:00.00,Default,,0,0,0,,Көпірден құлау
Dialogue: 0,0:03:00.00,0:03:04.00,Default,,0,0,0,,Мұқабада тек ішіндегі заттар ғана денеден түскен.
Dialogue: 0,0:03:04.00,0:03:08.00,Default,,0,0,0,,Жансыз жан болып қуылдым
Dialogue: 0,0:03:10.00,0:03:11.00,Default,,0,0,0,,Екінші жағынан
Dialogue: 0,0:03:11.00,0:03:13.00,Default,,0,0,0,,Жаныңды жоғалтты
Dialogue: 0,0:03:13.00,0:03:16.00,Default,,0,0,0,,Тек денеге айналған бос Банри
Dialogue: 0,0:03:16.00,0:03:18.00,Default,,0,0,0,,Амнезиясы бар адам ретінде
Dialogue: 0,0:03:18.00,0:03:20.00,Default,,0,0,0,,Біраз уақыт өткізіңіз
Dialogue: 0,0:03:20.00,0:03:23.00,Default,,0,0,0,,Мен университет студенті атандым.
Dialogue: 0,0:03:23.00,0:03:24.00,Default,,0,0,0,,Арасында
Dialogue: 0,0:03:24.00,0:03:26.00,Default,,0,0,0,,Мен елес болдым
Dialogue: 0,0:03:26.00,0:03:28.00,Default,,0,0,0,,Жаңадан туған Тада Банри
Dialogue: 0,0:03:28.00,0:03:31.00,Default,,0,0,0,,Мен сені жаныңда бақылап отырдым.
Dialogue: 0,0:03:31.00,0:03:33.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:03:33.00,0:03:36.00,Default,,0,0,0,,Менің дауысым Банриге жетпейді.
Dialogue: 0,0:03:44.00,0:03:45.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:45.00,0:03:47.00,Default,,0,0,0,,Бұл да болды.
Dialogue: 0,0:03:47.00,0:03:50.00,Default,,0,0,0,,Біз жаңа ғана кездестік.
Dialogue: 0,0:03:50.00,0:03:53.00,Default,,0,0,0,,Бірақ мен сенімен бірге болғаным өте қызық.
Dialogue: 0,0:03:53.00,0:03:55.00,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:03:55.00,0:03:59.00,Default,,0,0,0,,Ендеше бұдан былай жақсы дос болайық.
Dialogue: 0,0:04:01.00,0:04:03.00,Default,,0,0,0,,Тек сен
Dialogue: 0,0:04:03.00,0:04:04.00,Default,,0,0,0,,О
Dialogue: 0,0:04:04.00,0:04:05.00,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:04:05.00,0:04:06.00,Default,,0,0,0,,ИӘ! Бұл мен, мен
Dialogue: 0,0:04:06.00,0:04:09.00,Default,,0,0,0,,Мұны қабылдауыңызды қалаймын.
Dialogue: 0,0:04:09.00,0:04:11.00,Default,,0,0,0,,Менімен сәйкестендіру
Dialogue: 0,0:04:11.00,0:04:12.00,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:04:12.00,0:04:14.00,Default,,0,0,0,,Бұл аман қалудың айнасы
Dialogue: 0,0:04:14.00,0:04:17.00,Default,,0,0,0,,Бір күні діни оқу лагерінен қашып кеткенімде.
Dialogue: 0,0:04:17.00,0:04:18.00,Default,,0,0,0,,О
Dialogue: 0,0:04:18.00,0:04:21.00,Default,,0,0,0,,Сіз де сол уақытта жүктеріңізді қалдырғансыз, солай ма?
Dialogue: 0,0:04:21.00,0:04:22.00,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:04:22.00,0:04:25.00,Default,,0,0,0,,Мен оны алып шығу үшін қалтамда болдым.
Dialogue: 0,0:04:25.00,0:04:26.00,Default,,0,0,0,,Сосын бірдеңе
Dialogue: 0,0:04:26.00,0:04:29.00,Default,,0,0,0,,Бұл жай ғана сізбен достықты немесе байланысты білдіреді.
Dialogue: 0,0:04:29.00,0:04:32.00,Default,,0,0,0,,Бұл кәдесый сияқты.
Dialogue: 0,0:04:32.00,0:04:33.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:04:33.00,0:04:37.00,Default,,0,0,0,,Мен де сол затты сыйлыққа бергім келгендіктен сатып алдым.
Dialogue: 0,0:04:37.00,0:04:38.00,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:04:38.00,0:04:39.00,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:04:39.00,0:04:40.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:44.00,0:04:47.00,Default,,0,0,0,,Are you a good friend?
Dialogue: 0,0:05:03.00,0:05:05.00,Default,,0,0,0,,Кеше не болды?
Dialogue: 0,0:05:05.00,0:05:08.00,Default,,0,0,0,,Because something wasn't right on the phone.
Dialogue: 0,0:05:08.00,0:05:09.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:09.00,0:05:11.00,Default,,0,0,0,,Бір нәрсе сияқты көрінді
Dialogue: 0,0:05:11.00,0:05:13.00,Default,,0,0,0,,Kouko Nisa
Dialogue: 0,0:05:13.00,0:05:15.00,Default,,0,0,0,,Мен аздап артық айттым деп ойлаймын.
Dialogue: 0,0:05:15.00,0:05:17.00,Default,,0,0,0,,Мен әлі де уайымдаймын.
Dialogue: 0,0:05:17.00,0:05:18.00,Default,,0,0,0,,About Kaga-san
Dialogue: 0,0:05:18.00,0:05:19.00,Default,,0,0,0,,О
Dialogue: 0,0:05:20.00,0:05:21.00,Default,,0,0,0,,Кейінірек
Dialogue: 0,0:05:21.00,0:05:23.00,Default,,0,0,0,,Чинами туралы да
Dialogue: 0,0:05:23.00,0:05:25.00,Default,,0,0,0,,About Oka-chan
Dialogue: 0,0:05:32.00,0:05:35.00,Default,,0,0,0,,Maa Maa Maa
Dialogue: 0,0:05:35.00,0:05:38.00,Default,,0,0,0,,Бұл тек сенсің, менің ең жақын досым.
Dialogue: 0,0:05:38.00,0:05:39.00,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:39.00,0:05:42.00,Default,,0,0,0,,Бүгін таңертең кездейсоқ кездесіп қалуымыз мүмкін
Dialogue: 0,0:05:42.00,0:05:45.00,Default,,0,0,0,,Looks like it's going to be a really nice day
Dialogue: 0,0:05:45.00,0:05:46.00,Default,,0,0,0,,Эй
Dialogue: 0,0:05:46.00,0:05:47.00,Default,,0,0,0,,We absolutely
Dialogue: 0,0:05:47.00,0:05:49.00,Default,,0,0,0,,Condemned by fate
Dialogue: 0,0:05:49.00,0:05:52.00,Default,,0,0,0,,He's my best friend from my previous life.
Dialogue: 0,0:05:52.00,0:05:53.00,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:53.00,0:05:54.00,Default,,0,0,0,,Kaga-san
Dialogue: 0,0:05:54.00,0:05:55.00,Default,,0,0,0,,О
Dialogue: 0,0:05:57.00,0:05:58.00,Default,,0,0,0,,Тек сіздің дауысыңыз
Dialogue: 0,0:05:58.00,0:06:00.00,Default,,0,0,0,,That's amazing.
Dialogue: 0,0:06:00.00,0:06:01.00,Default,,0,0,0,,Эй
Dialogue: 0,0:06:01.00,0:06:02.00,Default,,0,0,0,,Өткен өміріміз туралы
Dialogue: 0,0:06:02.00,0:06:03.00,Default,,0,0,0,,Мен бұл туралы ойладым
Dialogue: 0,0:06:03.00,0:06:04.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:04.00,0:06:06.00,Default,,0,0,0,,Мен
Dialogue: 0,0:06:06.00,0:06:07.00,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:06:07.00,0:06:10.00,Default,,0,0,0,,Монастырдың әпкесі шәкірт
Dialogue: 0,0:06:10.00,0:06:12.00,Default,,0,0,0,,Бірақ сіз терең орманда тұрасыз
Dialogue: 0,0:06:12.00,0:06:14.00,Default,,0,0,0,,He was a shepherd
Dialogue: 0,0:06:14.00,0:06:15.00,Default,,0,0,0,,And every morning
Dialogue: 0,0:06:15.00,0:06:18.00,Default,,0,0,0,,Бірақ сіз ірімшікті жеткізуіңіз керек еді.
Dialogue: 0,0:06:18.00,0:06:21.00,Default,,0,0,0,,I'm sure of that
Dialogue: 0,0:06:21.00,0:06:22.00,Default,,0,0,0,,Эй
Dialogue: 0,0:06:22.00,0:06:25.00,Default,,0,0,0,,Бұл романтикалық емес
Dialogue: 0,0:06:25.00,0:06:26.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:26.00,0:06:29.00,Default,,0,0,0,,Өмірдегі барлық нәрсе үшін рахмет
Dialogue: 0,0:06:29.00,0:06:31.00,Default,,0,0,0,,Осылай қайта оралу
Dialogue: 0,0:06:31.00,0:06:34.00,Default,,0,0,0,,Бізді қайтадан жақындастырған осы тағдыр
Dialogue: 0,0:06:34.00,0:06:36.00,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:06:36.00,0:06:38.00,Default,,0,0,0,,О
Dialogue: 0,0:06:38.00,0:06:40.00,Default,,0,0,0,,Well Mitsuo
Dialogue: 0,0:06:40.00,0:06:41.00,Default,,0,0,0,,О
Dialogue: 0,0:06:41.00,0:06:42.00,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:42.00,0:06:43.00,Default,,0,0,0,,Мицуо
Dialogue: 0,0:06:43.00,0:06:44.00,Default,,0,0,0,,You must be
Dialogue: 0,0:06:44.00,0:06:47.00,Default,,0,0,0,,A lone hunter traveling through the wilderness
Dialogue: 0,0:06:47.00,0:06:48.00,Default,,0,0,0,,Facially
Dialogue: 0,0:06:48.00,0:06:51.00,Default,,0,0,0,,It's like that.
Dialogue: 0,0:06:51.00,0:06:55.00,Default,,0,0,0,,Who am I, spending my days in quiet prayer in the depths of the monastery?
Dialogue: 0,0:06:55.00,0:07:00.00,Default,,0,0,0,,Maybe it was our destiny that we shouldn't have met in the first place.
Dialogue: 0,0:07:01.00,0:07:02.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:04.00,0:07:05.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:07:05.00,0:07:07.00,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:07:07.00,0:07:08.00,Default,,0,0,0,,Содан кейін олар жоғалады
Dialogue: 0,0:07:08.00,0:07:10.00,Default,,0,0,0,,Мен де солай істедім.
Dialogue: 0,0:07:10.00,0:07:11.00,Default,,0,0,0,,Эй
Dialogue: 0,0:07:11.00,0:07:14.00,Default,,0,0,0,,Мұны істеудің уақыты келді ме, Коуко-чан?
Dialogue: 0,0:07:14.00,0:07:16.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:16.00,0:07:17.00,Default,,0,0,0,,А, енді.
Dialogue: 0,0:07:17.00,0:07:20.00,Default,,0,0,0,,Linda-senpai asked me to consult about the basics.
Dialogue: 0,0:07:20.00,0:07:24.00,Default,,0,0,0,,This kid has no idea about compulsory subjects.
Dialogue: 0,0:07:24.00,0:07:27.00,Default,,0,0,0,,Мен уақытында лекция оқыдым.
Dialogue: 0,0:07:30.00,0:07:32.00,Default,,0,0,0,,Бірақ Банри жақсы ма?
Dialogue: 0,0:07:32.00,0:07:34.00,Default,,0,0,0,,Сіз дұрыс тіркелдіңіз бе?
Dialogue: 0,0:07:34.00,0:07:35.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:07:35.00,0:07:37.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:07:37.00,0:07:38.00,Default,,0,0,0,,38-тарау: Алтын тәжірибе · Реквием
Dialogue: 0,0:07:39.00,0:07:41.00,Default,,0,0,0,,Иә, мен сені таныстырамын.
Dialogue: 0,0:07:41.00,0:07:42.00,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:07:42.00,0:07:43.00,Default,,0,0,0,,Менің досым Янус
Dialogue: 0,0:07:43.00,0:07:44.00,Default,,0,0,0,,Қолдауыңызға рахмет
Dialogue: 0,0:07:44.00,0:07:46.00,Default,,0,0,0,,Линда-сенпай бонусы
Dialogue: 0,0:07:46.00,0:07:49.00,Default,,0,0,0,,The person who helped me from the religious camp
Dialogue: 0,0:07:49.00,0:07:50.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:50.00,0:07:54.00,Default,,0,0,0,,That section seems like my friend caused trouble.
Dialogue: 0,0:07:54.00,0:07:56.00,Default,,0,0,0,,Бұл қиындық тудырмайды
Dialogue: 0,0:07:56.00,0:07:59.00,Default,,0,0,0,,Are you doing well in registering for the course?
Dialogue: 0,0:07:59.00,0:08:00.00,Default,,0,0,0,,О
Dialogue: 0,0:08:00.00,0:08:01.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:01.00,0:08:02.00,Default,,0,0,0,,Азаматтық құқық дегеніміз не?
Dialogue: 0,0:08:02.00,0:08:03.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:03.00,0:08:04.00,Default,,0,0,0,,Профессор Цукамото
Dialogue: 0,0:08:04.00,0:08:05.00,Default,,0,0,0,,Не?
Dialogue: 0,0:08:06.00,0:08:08.00,Default,,0,0,0,,Цукамотоның азаматтық заңын қабылдадыңыз ба?
Dialogue: 0,0:08:09.00,0:08:10.00,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:08:10.00,0:08:13.00,Default,,0,0,0,,Tsukamoto makes super difficult tests every year.
Dialogue: 0,0:08:13.00,0:08:15.00,Default,,0,0,0,,I can't use past questions as a reference either.
Dialogue: 0,0:08:15.00,0:08:18.00,Default,,0,0,0,,Taking attendance is also extremely difficult.
Dialogue: 0,0:08:19.00,0:08:20.00,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:08:21.00,0:08:23.00,Default,,0,0,0,,О, тәңірім
Dialogue: 0,0:08:23.00,0:08:26.00,Default,,0,0,0,,It's kind of difficult if you fold it into three.
Dialogue: 0,0:08:26.00,0:08:27.00,Default,,0,0,0,,О.
Dialogue: 0,0:08:29.00,0:08:30.00,Default,,0,0,0,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:08:30.00,0:08:31.00,Default,,0,0,0,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:08:31.00,0:08:32.00,Default,,0,0,0,,Мен
Dialogue: 0,0:08:32.00,0:08:34.00,Default,,0,0,0,,Басқа азаматтық құқық профессорынан сұраңыз
Dialogue: 0,0:08:34.00,0:08:36.00,Default,,0,0,0,,Менен қазір жаттығуға болады ма деп сұраңыз.
Dialogue: 0,0:08:38.00,0:08:40.00,Default,,0,0,0,,Ақымақ, ақымақ, ақымақ
Dialogue: 0,0:08:40.00,0:08:41.00,Default,,0,0,0,,Барлық несиелерді алып тастаңыз
Dialogue: 0,0:08:41.00,0:08:42.00,Default,,0,0,0,,Қосарлы
Dialogue: 0,0:08:42.00,0:08:43.00,Default,,0,0,0,,Және жыла
Dialogue: 0,0:08:43.00,0:08:45.00,Default,,0,0,0,,Ақымақ ақымақ
Dialogue: 0,0:08:46.00,0:08:47.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:47.00,0:08:49.00,Default,,0,0,0,,Үш балаға бүктеңіз
Dialogue: 0,0:08:50.00,0:08:51.00,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:51.00,0:08:54.00,Default,,0,0,0,,Have you guys decided whether to enter the bonus?
Dialogue: 0,0:08:54.00,0:08:57.00,Default,,0,0,0,,Менде әлі нөлдік жаңа мүшелер бар.
Dialogue: 0,0:08:57.00,0:08:58.00,Default,,0,0,0,,Әрине
Dialogue: 0,0:08:58.00,0:08:59.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:08:59.00,0:09:00.00,Default,,0,0,0,,Екеуміз қосыламыз.
Dialogue: 0,0:09:00.00,0:09:03.00,Default,,0,0,0,,Бізді жалынды достық байланыстырады.
Dialogue: 0,0:09:03.00,0:09:05.00,Default,,0,0,0,,Біз ең жақсы достармыз.
Dialogue: 0,0:09:05.00,0:09:07.00,Default,,0,0,0,,Еш нәрсеге қарамастан бірге боламыз
Dialogue: 0,0:09:07.00,0:09:08.00,Default,,0,0,0,,Дұрыс? Тада-кун
Dialogue: 0,0:09:08.00,0:09:09.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:09:09.00,0:09:10.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:10.00,0:09:11.00,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:09:11.00,0:09:14.00,Default,,0,0,0,,Екі жаңа мүшені бекіту
Dialogue: 0,0:09:14.00,0:09:16.00,Default,,0,0,0,,Енді жақсы араласайық
Dialogue: 0,0:09:16.00,0:09:17.00,Default,,0,0,0,,Иә
Dialogue: 0,0:09:17.00,0:09:18.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:09:18.00,0:09:19.00,Default,,0,0,0,,Иә
Dialogue: 0,0:09:19.00,0:09:21.00,Default,,0,0,0,,Линда Сенпай
Dialogue: 0,0:09:21.00,0:09:24.00,Default,,0,0,0,,Сіз мен туралы міндетті түрде білесіз, солай ма?
Dialogue: 0,0:09:24.00,0:09:25.00,Default,,0,0,0,,Кім үндемейді?
Dialogue: 0,0:09:25.00,0:09:28.00,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:09:30.00,0:09:31.00,Default,,0,0,0,,Кагава мырза
Dialogue: 0,0:09:31.00,0:09:34.00,Default,,0,0,0,,Сіз биге сенімді емеспін деп айтпадыңыз ба?
Dialogue: 0,0:09:34.00,0:09:35.00,Default,,0,0,0,,Иә
Dialogue: 0,0:09:35.00,0:09:39.00,Default,,0,0,0,,Бірақ мен оны тек осы үшін ғана білуім керек деп ойламаймын.
Dialogue: 0,0:09:39.00,0:09:42.00,Default,,0,0,0,,Жақында көп нәрсе болды, солай емес пе?
Dialogue: 0,0:09:42.00,0:09:44.00,Default,,0,0,0,,Оларды жеңу
Dialogue: 0,0:09:44.00,0:09:47.00,Default,,0,0,0,,Мен қазір өте позитивті сезінемін.
Dialogue: 0,0:09:47.00,0:09:48.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:48.00,0:09:50.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:50.00,0:09:53.00,Default,,0,0,0,,Мұның бәрі менің жақын досым Тада-кунның арқасында.
Dialogue: 0,0:09:53.00,0:09:54.00,Default,,0,0,0,,Мен бәрібір
Dialogue: 0,0:09:54.00,0:09:57.00,Default,,0,0,0,,Мен жаңа нәрселерді байқағым келеді
Dialogue: 0,0:09:57.00,0:09:59.00,Default,,0,0,0,,Жалқау болмаңыз
Dialogue: 0,0:09:59.00,0:10:01.00,Default,,0,0,0,,Бұл сіздің өміріңіздің босқа кетуі
Dialogue: 0,0:10:01.00,0:10:03.00,Default,,0,0,0,,Күн сайын бүкіл дене ғана бар
Dialogue: 0,0:10:03.00,0:10:05.00,Default,,0,0,0,,Өте позитивті өмірде
Dialogue: 0,0:10:05.00,0:10:08.00,Default,,0,0,0,,Мен сенің алдыңда өлемін
Dialogue: 0,0:10:08.00,0:10:10.00,Default,,0,0,0,,Неліктен мұндай шектен шығу керек?
Dialogue: 0,0:10:10.00,0:10:13.00,Default,,0,0,0,,Тіпті Тада-кун оң болуы керек.
Dialogue: 0,0:10:13.00,0:10:14.00,Default,,0,0,0,,Бун
Dialogue: 0,0:10:14.00,0:10:16.00,Default,,0,0,0,,Болуы керек
Dialogue: 0,0:10:16.00,0:10:18.00,Default,,0,0,0,,Маған дәл солай позитивті болу керек.
Dialogue: 0,0:10:18.00,0:10:20.00,Default,,0,0,0,,Біз бұлай дос бола алмаймыз.
Dialogue: 0,0:10:20.00,0:10:22.00,Default,,0,0,0,,Тіпті егер мен
Dialogue: 0,0:10:26.00,0:10:28.00,Default,,0,0,0,,Сіз әдетте осылай айтасыз ба?
Dialogue: 0,0:10:28.00,0:10:29.00,Default,,0,0,0,,Мен олай айтқан жоқпын.
Dialogue: 0,0:10:29.00,0:10:31.00,Default,,0,0,0,,Мен ештеңе айтқан жоқпын
Dialogue: 0,0:10:31.00,0:10:33.00,Default,,0,0,0,,Бірақ мен мұны айтқым келді.
Dialogue: 0,0:10:33.00,0:10:34.00,Default,,0,0,0,,Орындалмады Орындалмады
Dialogue: 0,0:10:34.00,0:10:35.00,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:10:35.00,0:10:37.00,Default,,0,0,0,,Содан кейін жинақты қосыңыз.
Dialogue: 0,0:10:37.00,0:10:40.00,Default,,0,0,0,,Бұл ыңғайсыз үнсіз ойын
Dialogue: 0,0:10:40.00,0:10:41.00,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:10:41.00,0:10:43.00,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:10:43.00,0:10:45.00,Default,,0,0,0,,Бұл бәрібір
Dialogue: 0,0:10:45.00,0:10:47.00,Default,,0,0,0,,Барымызды салайық
Dialogue: 0,0:10:47.00,0:10:49.00,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:52.00,0:10:55.00,Default,,0,0,0,,Жапон музыка клубы бір жылға тегін.
Dialogue: 0,0:10:55.00,0:10:57.00,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:10:57.00,0:11:00.00,Default,,0,0,0,,Сондай-ақ жапон музыка клубы, бірінші курс ғылыми орта мектебі.
Dialogue: 0,0:11:00.00,0:11:02.00,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:11:05.00,0:11:06.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:06.00,0:11:08.00,Default,,0,0,0,,Енді жазғы іс-шараға
Dialogue: 0,0:11:08.00,0:11:10.00,Default,,0,0,0,,Мен біраз серпін алдым.
Dialogue: 0,0:11:10.00,0:11:12.00,Default,,0,0,0,,Жазда бірдеңе болып жатыр ма?
Dialogue: 0,0:11:12.00,0:11:15.00,Default,,0,0,0,,Мен көпіршік биіне қатысуды шештім.
Dialogue: 0,0:11:15.00,0:11:17.00,Default,,0,0,0,,Олай болса, бірден жаттығу жасайық.
Dialogue: 0,0:11:17.00,0:11:19.00,Default,,0,0,0,,Музыкалық дайындық
Dialogue: 0,0:11:19.00,0:11:21.00,Default,,0,0,0,,Тек айналаңыздағыларға еліктеуге тырысыңыз.
Dialogue: 0,0:11:21.00,0:11:23.00,Default,,0,0,0,,Иә
Dialogue: 0,0:11:23.00,0:11:24.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:24.00,0:11:27.00,Default,,0,0,0,,Мен бүгін жақсы билей алатыныма сенімдімін.
Dialogue: 0,0:11:27.00,0:11:29.00,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:11:29.00,0:11:30.00,Default,,0,0,0,,Олай болса жасап көрейік
Dialogue: 0,0:11:30.00,0:11:31.00,Default,,0,0,0,,Хаято-сан
Dialogue: 0,0:11:31.00,0:11:53.00,Default,,0,0,0,,Юия-сан
Dialogue: 0,0:11:55.00,0:11:56.00,Default,,0,0,0,,Мен бастаушымын
Dialogue: 0,0:11:56.00,0:11:58.00,Default,,0,0,0,,Бұл сізге алдымен қажет.
Dialogue: 0,0:11:59.00,0:12:00.00,Default,,0,0,0,,Жақсырақ және жақсырақ болыңыз
Dialogue: 0,0:12:00.00,0:12:02.00,Default,,0,0,0,,Коуко-чан қалғандарына барады
Dialogue: 0,0:12:02.00,0:12:03.00,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:12:03.00,0:12:05.00,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:09.00,0:12:10.00,Default,,0,0,0,,Мен енді жоқпын
Dialogue: 0,0:12:10.00,0:12:14.48,Default,,0,0,0,,Жоқ.Екеуміз жақын дос болсақ та, айлалы болғаны сонша, мен ғана жақсы билейді!
Dialogue: 0,0:12:14.48,0:12:16.28,Default,,0,0,0,,Қорқынышты! Сатқын!
Dialogue: 0,0:12:16.60,0:12:17.96,Default,,0,0,0,,Уф, уф… Бізді кім қуып келеді?
Dialogue: 0,0:12:19.52,0:12:20.68,Default,,0,0,0,,Маған енді ұнамайды!
Dialogue: 0,0:12:21.52,0:12:24.52,Default,,0,0,0,,Мен позитивті болу үшін бар күшімді салғым келді...
Dialogue: 0,0:12:25.60,0:12:27.76,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:12:28.28,0:12:30.16,Default,,0,0,0,,Ей, сен мүлдем жылама!
Dialogue: 0,0:12:30.92,0:12:31.92,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:12:32.92,0:12:34.68,Default,,0,0,0,,Ааааааааааааа...
Dialogue: 0,0:12:34.68,0:12:36.92,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:12:36.92,0:12:39.44,Default,,0,0,0,,Мен мұны өзім білемін...
Dialogue: 0,0:12:39.44,0:12:41.92,Default,,0,0,0,,Мен ашуландым...
Dialogue: 0,0:12:42.52,0:12:43.72,Default,,0,0,0,,Қағасан…
Dialogue: 0,0:12:43.72,0:12:45.96,Default,,0,0,0,,Сен менің досым боласың, солай ма?
Dialogue: 0,0:12:45.96,0:12:48.68,Default,,0,0,0,,Мен білемін...білемін...
Dialogue: 0,0:12:48.68,0:12:51.92,Default,,0,0,0,,Сөйлеседі, жақсы араласады...
Dialogue: 0,0:12:53.04,0:12:56.92,Default,,0,0,0,,Шеңберде бірге кездесіп, бірге билей аламыз...
Dialogue: 0,0:12:56.92,0:12:59.36,Default,,0,0,0,,Менің де айтқым келмейді...
Dialogue: 0,0:12:59.36,0:13:01.70,Default,,0,0,0,,Ол кешегі күнді уайымдайды.
Dialogue: 0,0:13:02.28,0:13:06.78,Default,,0,0,0,,Сол сияқты... Сосын жабайы болып, пәле жасайсың.
Dialogue: 0,0:13:06.78,0:13:09.66,Default,,0,0,0,,Олай істесең, Тада-кунның өзі сені жек көреді.
Dialogue: 0,0:13:09.66,0:13:11.04,Default,,0,0,0,,Ал... жақсы, бұл...
Dialogue: 0,0:13:11.62,0:13:12.96,Default,,0,0,0,,Тек тұрыңыз.
Dialogue: 0,0:13:15.16,0:13:16.96,Default,,0,0,0,,Сіз ұзақ уақыт бойы өзіңізді итермеледіңіз.
Dialogue: 0,0:13:17.96,0:13:21.96,Default,,0,0,0,,Янустың мені тастап кеткеніне екі күн ғана болды.
Dialogue: 0,0:13:24.64,0:13:26.30,Default,,0,0,0,,Кага-сан да ғажап емес пе?
Dialogue: 0,0:13:26.62,0:13:31.30,Default,,0,0,0,,Эспрессо қосылған латте, ванильді шәрбат, кілегей, карамель және
Dialogue: 0,0:13:31.94,0:13:35.50,Default,,0,0,0,,Шоколад қосыңыз Ең күшті үйлестіру
Dialogue: 0,0:13:36.00,0:13:37.62,Default,,0,0,0,,Өзіңізді жақсы сезінген сияқтысыз.
Dialogue: 0,0:13:38.58,0:13:43.78,Default,,0,0,0,,Бұрынғы үшін кешірім сұраймын. Сенің жылап тұрғаның біртүрлі болды.
Dialogue: 0,0:13:44.30,0:13:47.18,Default,,0,0,0,,Соңғы кездері мен өзімді шынымен...
Dialogue: 0,0:13:47.94,0:13:49.10,Default,,0,0,0,,Мен ештеңе істей алмаймын
Dialogue: 0,0:13:51.38,0:13:55.18,Default,,0,0,0,,Немесе менде басынан-ақ шатасу үрдісі бар шығар.
Dialogue: 0,0:13:55.98,0:13:58.78,Default,,0,0,0,,Ақымақ және асығыс және үмітсіз
Dialogue: 0,0:14:00.50,0:14:01.74,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:14:02.54,0:14:06.78,Default,,0,0,0,,Мен бұрынғы қателіктерімді тезірек тоқтату керек деп ойладым.
Dialogue: 0,0:14:07.42,0:14:09.78,Default,,0,0,0,,Сондықтан мен қатты уайымдадым.
Dialogue: 0,0:14:10.94,0:14:14.34,Default,,0,0,0,,Ал... өткен сәтсіздіктер, ақыр соңында,
Dialogue: 0,0:14:14.78,0:14:19.30,Default,,0,0,0,,Иә, мен үш нәрсеге қатысты өз сезімдерімді реттегім келді.
Dialogue: 0,0:14:20.34,0:14:21.86,Default,,0,0,0,,Ешбір өкінішім жоқ сияқты.
Dialogue: 0,0:14:22.42,0:14:26.14,Default,,0,0,0,,Бірақ мен өзімді әлі де ессіз сезінемін.
Dialogue: 0,0:14:28.26,0:14:30.54,Default,,0,0,0,,Иә? Жоқ, менде келген сияқты.
Dialogue: 0,0:14:30.90,0:14:32.86,Default,,0,0,0,,А... сәл күте тұрыңыз.
Dialogue: 0,0:14:36.18,0:14:38.54,Default,,0,0,0,,Тада-кун, сіз оны пайдаланып жатырсыз.
Dialogue: 0,0:14:38.86,0:14:41.90,Default,,0,0,0,,Әрине, бұл достықтың айнасы.
Dialogue: 0,0:14:43.94,0:14:47.90,Default,,0,0,0,,Тада-кун менің қандай пайдасыз екенімді түсінді.
Dialogue: 0,0:14:48.62,0:14:50.30,Default,,0,0,0,,Жақсы болмаса да, мен сені кешіремін
Dialogue: 0,0:14:51.22,0:14:53.06,Default,,0,0,0,,Соған ғашық болып, жыладым.
Dialogue: 0,0:14:53.82,0:14:55.14,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:14:55.70,0:14:59.58,Default,,0,0,0,,Жарайды, мен сенен бір жас үлкенмін.
Dialogue: 0,0:14:59.94,0:15:04.18,Default,,0,0,0,,Түсіндім, Тада-кун Линда-сенпаймен құрдас, солай ма?
Dialogue: 0,0:15:04.98,0:15:07.50,Default,,0,0,0,,Мен, Линда-сенпай сияқты болғым келеді.
Dialogue: 0,0:15:08.02,0:15:09.10,Default,,0,0,0,,Мен саған тәнтімін
Dialogue: 0,0:15:09.98,0:15:10.70,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:15:10.90,0:15:15.30,Default,,0,0,0,,Мен өзімді сергек және позитивті сезінемін және өмірден ләззат аламын.
Dialogue: 0,0:15:15.86,0:15:18.30,Default,,0,0,0,,Не істесең де керемет, әдемі.
Dialogue: 0,0:15:18.78,0:15:23.22,Default,,0,0,0,,Әй, менің ойымша, Қошы-сенпай Линда-сенпайды ұнатады.
Dialogue: 0,0:15:23.42,0:15:24.90,Default,,0,0,0,,А... неге?
Dialogue: 0,0:15:25.58,0:15:27.62,Default,,0,0,0,,Өйткені олар жақсы араласатын сияқты.
Dialogue: 0,0:15:28.10,0:15:31.22,Default,,0,0,0,,Бірақ біз кездесіп жатқан жоқпыз, солай ма?
Dialogue: 0,0:15:32.06,0:15:36.62,Default,,0,0,0,,А, мүмкін Линда-сенпайдың басқа жігіті бар шығар.
Dialogue: 0,0:15:36.94,0:15:40.54,Default,,0,0,0,,Ол өте жақсы адам және шынымен танымал болып көрінеді.
Dialogue: 0,0:15:40.74,0:15:41.54,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:15:45.10,0:15:46.14,Default,,0,0,0,,Линда Сенпай
Dialogue: 0,0:15:47.50,0:15:48.62,Default,,0,0,0,,Нана Хаяшида
Dialogue: 0,0:15:52.30,0:15:53.42,Default,,0,0,0,,Бұл қалыпты температура.
Dialogue: 0,0:15:53.98,0:15:55.90,Default,,0,0,0,,Сізде алаңдаушылық бар ма?
Dialogue: 0,0:15:56.46,0:15:59.26,Default,,0,0,0,,Мм... бұл дене туралы емес.
Dialogue: 0,0:16:00.82,0:16:05.98,Default,,0,0,0,,Күн сайын түн ортасында мен сол жақтағы тауда жыпылықтайтын жарықты көремін.
Dialogue: 0,0:16:06.98,0:16:08.46,Default,,0,0,0,,Оның не екенін білесің бе?
Dialogue: 0,0:16:09.10,0:16:11.14,Default,,0,0,0,,Жарық? Түнде?
Dialogue: 0,0:16:12.58,0:16:14.42,Default,,0,0,0,,Бұл сіздің ұйықтай алмайсыз дегенді білдіре ме?
Dialogue: 0,0:16:16.42,0:16:18.54,Default,,0,0,0,,Мұны маған айту керек.
Dialogue: 0,0:16:19.34,0:16:22.54,Default,,0,0,0,,Жоқ, мен әлі сағат 11 шамасында ұйықтамаймын.
Dialogue: 0,0:16:22.78,0:16:25.18,Default,,0,0,0,,Бұл ауруханада сағат 9-да жарық сөндіріледі.
Dialogue: 0,0:16:25.54,0:16:27.86,Default,,0,0,0,,Өміріңізді уақытында өткізіңіз.
Dialogue: 0,0:16:33.86,0:16:36.18,Default,,0,0,0,,Мен сізді уайымдап жатқаныңызды түсіндім.
Dialogue: 0,0:16:36.78,0:16:38.74,Default,,0,0,0,,Өйткені, бұл есте сақтау қабілетінің жоғалуы.
Dialogue: 0,0:16:39.98,0:16:43.46,Default,,0,0,0,,Бірақ мен екі айға жуық ауруханада жаттым.
Dialogue: 0,0:16:43.94,0:16:46.70,Default,,0,0,0,,Мені үнемі қамап, қадағалап жүргендей болады.
Dialogue: 0,0:16:49.22,0:16:51.22,Default,,0,0,0,,Мені ауруханадан қашан шығаруға болады?
Dialogue: 0,0:16:54.10,0:16:54.94,Default,,0,0,0,,Бүгін түнде де
Dialogue: 0,0:16:57.58,0:17:00.58,Default,,0,0,0,,Бұл алғыстың белгісі ме?
Dialogue: 0,0:17:06.18,0:17:07.42,Default,,0,0,0,,Колт, жағдай қалай?
Dialogue: 0,0:17:36.18,0:17:44.80,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:17:44.80,0:17:46.90,Default,,0,0,0,,аха
Dialogue: 0,0:17:46.90,0:17:52.74,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:17:52.74,0:17:57.02,Default,,0,0,0,,орган Мен бұл жерде екеніне сенімдімін
Dialogue: 0,0:17:57.02,0:18:00.08,Default,,0,0,0,,вуду
Dialogue: 0,0:18:00.08,0:18:02.08,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:18:12.08,0:18:16.08,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:18:20.08,0:18:22.08,Default,,0,0,0,,Бұл күдікті емес.
Dialogue: 0,0:18:23.08,0:18:29.08,Default,,0,0,0,,Эй, мен төменде ауруханада емделіп жатырмын.
Dialogue: 0,0:18:29.08,0:18:31.78,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:18:32.28,0:18:37.08,Default,,0,0,0,,Негізі, мен бөлмеден сол жарықты көріп, оның не екеніне таң қалдым.
Dialogue: 0,0:18:38.08,0:18:41.08,Default,,0,0,0,,Сондықтан мен оны тексергім келді.
Dialogue: 0,0:18:44.48,0:18:45.88,Default,,0,0,0,,Бұл... жарайды ма?
Dialogue: 0,0:18:45.88,0:18:47.48,Default,,0,0,0,,Бұл...бұл...
Dialogue: 0,0:18:52.28,0:18:55.58,Default,,0,0,0,,Ауруханадан біреуді шақыруым керек пе?
Dialogue: 0,0:18:55.88,0:18:58.58,Default,,0,0,0,,Аа, жоқ, мен үшін бәрі жақсы. Оқиға
Dialogue: 0,0:19:00.08,0:19:02.48,Default,,0,0,0,,-да жалғасады
Dialogue: 0,0:19:02.88,0:19:08.68,Default,,0,0,0,,Мен бұл жарық маған сигнал жіберген шығар деп ойладым.
Dialogue: 0,0:19:09.48,0:19:12.68,Default,,0,0,0,,Қашып кету сигналы сияқты нәрсе.
Dialogue: 0,0:19:12.88,0:19:15.28,Default,,0,0,0,,Оларды Кокчи Кокчи деп атайтын сияқты.
Dialogue: 0,0:19:16.28,0:19:18.48,Default,,0,0,0,,Мен өзімді бағыттап жатқандай сезінемін.
Dialogue: 0,0:19:19.48,0:19:21.08,Default,,0,0,0,,Мына жерден қашыңыз.
Dialogue: 0,0:19:21.28,0:19:22.28,Default,,0,0,0,,Қашу?
Dialogue: 0,0:19:22.68,0:19:24.48,Default,,0,0,0,,Мен ауруханада жатырмын.
Dialogue: 0,0:19:25.08,0:19:27.68,Default,,0,0,0,,Бірақ мені үнемі бақылап жүрген сияқты.
Dialogue: 0,0:19:28.28,0:19:30.88,Default,,0,0,0,,Бұл дымқыл және қызықсыз
Dialogue: 0,0:19:31.28,0:19:34.08,Default,,0,0,0,,Міне, бүгін мен бұдан былай шыдай алмадым. Бұл
Dialogue: 0,0:19:34.68,0:19:36.48,Default,,0,0,0,,-де болды
Dialogue: 0,0:19:36.88,0:19:39.28,Default,,0,0,0,,Иә, бұл ақымақтық.
Dialogue: 0,0:19:39.88,0:19:41.08,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:43.28,0:19:46.28,Default,,0,0,0,,Күнде түнде жалғыз не істедің?
Dialogue: 0,0:19:46.48,0:19:48.28,Default,,0,0,0,,Мен аурухананы көруге келдім.
Dialogue: 0,0:19:50.08,0:19:52.08,Default,,0,0,0,,Менің досым ауруханада жатыр.
Dialogue: 0,0:19:53.68,0:19:57.08,Default,,0,0,0,,Бірақ кейбір жағдайларға байланысты мен сізбен кездесуге келе алмадым.
Dialogue: 0,0:19:57.28,0:20:00.68,Default,,0,0,0,,Сондықтан мен тым болмаса жақынырақ барайын деп ойладым.
Dialogue: 0,0:20:01.48,0:20:02.68,Default,,0,0,0,,Осы жерде адамдар бар ма?
Dialogue: 0,0:20:03.08,0:20:04.08,Default,,0,0,0,,Бұл Токио.
Dialogue: 0,0:20:04.68,0:20:06.68,Default,,0,0,0,,Мен, Токиодағы университет студентімін
Dialogue: 0,0:20:07.08,0:20:09.68,Default,,0,0,0,,Қазіргі уақытта «Алтын апта» үшін үйге оралуда
Dialogue: 0,0:20:10.28,0:20:11.28,Default,,0,0,0,,(Панда) Бірінші курс студентін жіберуді қамтитын Арнайы сынып ісі — бұл төтенше жағдай.
Dialogue: 0,0:20:11.88,0:20:13.68,Default,,0,0,0,,Керемет Токио
Dialogue: 0,0:20:14.68,0:20:19.08,Default,,0,0,0,,Мен Токио университетінің студенті болғанда, мен де бұл тордан шыға аламын.
Dialogue: 0,0:20:19.88,0:20:21.88,Default,,0,0,0,,Мен қашып кететін сияқтымын.
Dialogue: 0,0:20:22.48,0:20:24.68,Default,,0,0,0,,Тор аурухана дегенді білдіре ме?
Dialogue: 0,0:20:24.88,0:20:28.08,Default,,0,0,0,,Мұның бәрі мені байланыстыратын адами қарым-қатынасқа кіреді.
Dialogue: 0,0:20:28.68,0:20:29.68,Default,,0,0,0,,Бұғаулар
Dialogue: 0,0:20:30.68,0:20:32.68,Default,,0,0,0,,Осы заттардың барлығы бірге
Dialogue: 0,0:20:34.08,0:20:35.48,Default,,0,0,0,,Токиоға келіңіз!
Dialogue: 0,0:20:36.68,0:20:37.68,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:20:38.08,0:20:40.48,Default,,0,0,0,,Кел, мұнда кел.
Dialogue: 0,0:20:41.48,0:20:42.48,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:42.88,0:20:43.88,Default,,0,0,0,,That's right.
Dialogue: 0,0:20:44.28,0:20:45.88,Default,,0,0,0,,Тек Токиоға барыңыз.
Dialogue: 0,0:20:46.48,0:20:48.28,Default,,0,0,0,,Ауруханадан шығып, сабақ оқы
Dialogue: 0,0:20:48.88,0:20:51.28,Default,,0,0,0,,Сізге Токиодағы университетке түсу жеткілікті.
Dialogue: 0,0:20:52.48,0:20:53.28,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:53.88,0:20:55.68,Default,,0,0,0,,Маған белгі бергеніңіз үшін рахмет.
Dialogue: 0,0:20:56.28,0:20:58.48,Default,,0,0,0,,Мен бұл рахмет белгісі емес екенін білемін.
Dialogue: 0,0:20:58.88,0:21:00.88,Default,,0,0,0,,Бірақ мен үшін бұл
Dialogue: 0,0:21:01.48,0:21:03.48,Default,,0,0,0,,Сіздің жарығыңыз секіру сигналы болды.
Dialogue: 0,0:21:06.28,0:21:09.28,Default,,0,0,0,,Мен Токиоға барамын!
Dialogue: 0,0:21:15.28,0:21:18.08,Default,,0,0,0,,Өйткені, бұл Линда-сенпай еді.
Dialogue: 0,0:21:19.28,0:21:22.08,Default,,0,0,0,,Бірақ сен неге үндемейсің?
Dialogue: 0,0:21:22.88,0:21:24.68,Default,,0,0,0,,Орта мектепте сыныптас болдық
Dialogue: 0,0:21:25.28,0:21:27.08,Default,,0,0,0,,Екеуміз ауруханада жатқанымда таныстық.
Dialogue: 0,0:21:28.68,0:21:30.48,Default,,0,0,0,,А, мен білмеймін.
Dialogue: 0,0:21:40.08,0:21:41.68,Default,,0,0,0,,Денең болса да
Dialogue: 0,0:21:42.28,0:21:44.28,Default,,0,0,0,,18 жасқа дейін есте сақтау қабілеті жоқ
Dialogue: 0,0:21:45.28,0:21:47.48,Default,,0,0,0,,Менің естеліктерім бар, бірақ денем жоқ
Dialogue: 0,0:21:48.88,0:21:49.88,Default,,0,0,0,,Мен саған үйреткім келеді
Dialogue: 0,0:21:50.88,0:21:51.88,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:21:53.08,0:21:55.08,Default,,0,0,0,,Линда қандай адам болды?
Dialogue: 0,0:22:20.28,0:22:23.28,Default,,0,0,0,,Әп сәтте махаббат иісі
Dialogue: 0,0:22:23.88,0:22:25.88,Default,,0,0,0,,Мен тамаша шешкім келеді
Dialogue: 0,0:22:26.08,0:22:28.08,Default,,0,0,0,,Желе боялған бір сүйісу
Dialogue: 0,0:22:28.48,0:22:30.48,Default,,0,0,0,,Сергіту және қызықты
Dialogue: 0,0:22:30.68,0:22:33.08,Default,,0,0,0,,Саған асығайық
Dialogue: 0,0:22:35.68,0:22:37.48,Default,,0,0,0,,Сақ бол, тәтті тұзақ
Dialogue: 0,0:22:39.88,0:22:42.08,Default,,0,0,0,,Иә, мен саған сыбырлаймын
Dialogue: 0,0:22:43.48,0:22:46.68,Default,,0,0,0,,А, мен күте алмаймын.
Dialogue: 0,0:22:47.08,0:22:49.08,Default,,0,0,0,,Қандай күлімсіреу
Dialogue: 0,0:22:49.08,0:22:51.08,Default,,0,0,0,,Менімен танысыңыз.
Dialogue: 0,0:22:51.08,0:22:53.08,Default,,0,0,0,,Әдемі махаббат, сүйкімді махаббат
Dialogue: 0,0:22:53.08,0:22:55.08,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:22:55.08,0:22:58.08,Default,,0,0,0,,Мен күннің шуағымын, мен күннің шуағымын
Dialogue: 0,0:22:58.08,0:23:00.08,Default,,0,0,0,,Қол ұстасып көрейік
Dialogue: 0,0:23:00.08,0:23:02.08,Default,,0,0,0,,Адал болу мүмкін емес
Dialogue: 0,0:23:02.08,0:23:05.08,Default,,0,0,0,,Менің қолым солай
Dialogue: 0,0:23:05.08,0:23:10.08,Default,,0,0,0,,Мені тарта бер
Dialogue: 0,0:23:19.08,0:23:21.08,Default,,0,0,0,,Субтитр Арнаға жазылыңыз
Dialogue: 0,0:23:22.58,0:23:27.58,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
