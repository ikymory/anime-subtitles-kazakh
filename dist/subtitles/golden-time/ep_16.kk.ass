Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Оян! Оян!
Dialogue: 0,0:00:16.00,0:00:18.00,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:00:19.00,0:00:20.00,Default,,0,0,0,,Жазатайым оқиға?
Dialogue: 0,0:00:20.00,0:00:28.00,Default,,0,0,0,,Банди…
Dialogue: 0,0:00:28.00,0:00:29.00,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:00:29.00,0:00:31.00,Default,,0,0,0,,Қалай болғанда да, барамыз.
Dialogue: 0,0:00:31.00,0:00:32.00,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:00:32.00,0:00:34.00,Default,,0,0,0,,Сәлем, Банди.
Dialogue: 0,0:00:36.00,0:00:37.00,Default,,0,0,0,,...
Dialogue: 0,0:00:58.00,0:01:00.00,Default,,0,0,0,,Банди
Dialogue: 0,0:01:28.00,0:01:46.00,Default,,0,0,0,,Банди
Dialogue: 0,0:01:48.00,0:02:06.00,Default,,0,0,0,,Банди
Dialogue: 0,0:02:23.00,0:02:24.00,Default,,0,0,0,,Чинами…
Dialogue: 0,0:02:24.00,0:02:25.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:26.00,0:02:27.00,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:02:33.00,0:02:34.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:34.00,0:02:36.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:36.00,0:02:38.00,Default,,0,0,0,,Мен оған аздап соқтығыстым.
Dialogue: 0,0:02:38.00,0:02:39.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:39.00,0:02:41.00,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:02:43.00,0:02:44.00,Default,,0,0,0,,Дене
Dialogue: 0,0:02:44.00,0:02:46.00,Default,,0,0,0,,Бұл шын мәнінде үлкен мәселе емес.
Dialogue: 0,0:02:46.00,0:02:48.00,Default,,0,0,0,,Бірақ... бірақ...
Dialogue: 0,0:02:48.00,0:02:49.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:49.00,0:02:51.00,Default,,0,0,0,,Сіз полицияға хабарласуыңыз керек.
Dialogue: 0,0:02:54.00,0:02:55.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:02:58.00,0:02:59.00,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:02:59.00,0:03:01.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:01.00,0:03:02.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:03:04.00,0:03:06.00,Default,,0,0,0,,Жол-көлік оқиғасы
Dialogue: 0,0:03:11.00,0:03:13.00,Default,,0,0,0,,Пойыз шақырмағаныңыз дұрыс па?
Dialogue: 0,0:03:13.00,0:03:14.00,Default,,0,0,0,,Иә
Dialogue: 0,0:03:14.00,0:03:17.00,Default,,0,0,0,,Бампер жай ғана ойылған сияқты.
Dialogue: 0,0:03:18.00,0:03:20.00,Default,,0,0,0,,Итататата
Dialogue: 0,0:03:21.00,0:03:23.00,Default,,0,0,0,,Көлікті абайсызда жүргізу.
Dialogue: 0,0:03:23.00,0:03:26.00,Default,,0,0,0,,Бұл үлкен мәселе болмағанына қуаныштымын.
Dialogue: 0,0:03:26.00,0:03:28.00,Default,,0,0,0,,Сіз қоршауды жөндеуге ақы төлеуіңіз керек.
Dialogue: 0,0:03:28.00,0:03:30.00,Default,,0,0,0,,Осы ниетпен
Dialogue: 0,0:03:30.00,0:03:33.00,Default,,0,0,0,,Сондай-ақ, сіз кәмелетке толмағандықтан, ата-анаңызға да хабарласуыңыз қажет.
Dialogue: 0,0:03:33.00,0:03:35.00,Default,,0,0,0,,Кімге хабарласуға болады?
Dialogue: 0,0:03:35.00,0:03:37.00,Default,,0,0,0,,Сіз қазір қоңырау шала аласыз
Dialogue: 0,0:03:53.00,0:03:54.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:23.00,0:04:24.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:24.00,0:04:25.00,Default,,0,0,0,,Ока-чан
Dialogue: 0,0:04:25.00,0:04:27.00,Default,,0,0,0,,Мен Вэнсті осылай алдым
Dialogue: 0,0:04:27.00,0:04:28.00,Default,,0,0,0,,О
Dialogue: 0,0:04:28.00,0:04:31.00,Default,,0,0,0,,Ол әдетте өткір иттер жиналатын жерде көрінеді.
Dialogue: 0,0:04:31.00,0:04:32.00,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:04:32.00,0:04:34.00,Default,,0,0,0,,Ол орта мектепке хабарласты.
Dialogue: 0,0:04:34.00,0:04:51.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:51.00,0:04:52.00,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:04:52.00,0:04:55.00,Default,,0,0,0,,Мен орта мектеппен байланыса алмаймын деп уайымдаймын.
Dialogue: 0,0:04:56.00,0:04:57.00,Default,,0,0,0,,Жоспар
Dialogue: 0,0:04:57.00,0:05:00.00,Default,,0,0,0,,Мен сізге бірнеше рет электрондық хат жазып, қоңырау шалдым.
Dialogue: 0,0:05:00.00,0:05:02.00,Default,,0,0,0,,Мен анамнан сұрадым
Dialogue: 0,0:05:03.00,0:05:04.00,Default,,0,0,0,,Орта мектеп алаңы
Dialogue: 0,0:05:04.00,0:05:06.00,Default,,0,0,0,,Барселона вокзалы тоқтатылды.
Dialogue: 0,0:05:10.00,0:05:11.00,Default,,0,0,0,,Яна-сан
Dialogue: 0,0:05:11.00,0:05:12.00,Default,,0,0,0,,Менің бүгін уақытым бар.
Dialogue: 0,0:05:18.00,0:05:19.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:22.00,0:05:24.00,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:05:24.00,0:05:27.00,Default,,0,0,0,,Маған сенің кездесіп тұрған адамыңмен бетпе-бет келгенің ұнамайды.
Dialogue: 0,0:05:27.00,0:05:28.00,Default,,0,0,0,,Не?
Dialogue: 0,0:05:28.00,0:05:30.00,Default,,0,0,0,,Мұнда түні бойы.
Dialogue: 0,0:05:30.00,0:05:32.00,Default,,0,0,0,,Бетіңді олай көрсетпе.
Dialogue: 0,0:05:32.00,0:05:34.00,Default,,0,0,0,,Бұл өте абайсызда
Dialogue: 0,0:05:34.00,0:05:35.00,Default,,0,0,0,,Сен
Dialogue: 0,0:05:35.00,0:05:37.00,Default,,0,0,0,,Бұл жерде тым көп, солай емес пе?
Dialogue: 0,0:05:37.00,0:05:41.00,Default,,0,0,0,,Қабырғалар арқылы тараған ауа мені тітіркендіреді.
Dialogue: 0,0:05:41.00,0:05:43.00,Default,,0,0,0,,Мен не болғанын білмеймін, бірақ
Dialogue: 0,0:05:43.00,0:05:45.00,Default,,0,0,0,,Тез тіріл!
Dialogue: 0,0:05:45.00,0:05:47.00,Default,,0,0,0,,Бұл тітіркендіргіш
Dialogue: 0,0:05:47.00,0:05:49.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:49.00,0:05:52.00,Default,,0,0,0,,Егер бәрі сәтсіз болса, бізге қайта келіңіз.
Dialogue: 0,0:05:53.00,0:05:55.00,Default,,0,0,0,,Мен оны тегін саламын.
Dialogue: 0,0:06:04.00,0:06:05.00,Default,,0,0,0,,Мэнди
Dialogue: 0,0:06:06.00,0:06:07.00,Default,,0,0,0,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:06:07.00,0:06:08.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:08.00,0:06:10.00,Default,,0,0,0,,Мен соңғы болып сөйледім.
Dialogue: 0,0:06:10.00,0:06:11.00,Default,,0,0,0,,Мэнди
Dialogue: 0,0:06:12.00,0:06:13.00,Default,,0,0,0,,Ана
Dialogue: 0,0:06:13.00,0:06:14.00,Default,,0,0,0,,Менің шашым жазылды.
Dialogue: 0,0:06:14.00,0:06:15.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:06:16.00,0:06:17.00,Default,,0,0,0,,Тека
Dialogue: 0,0:06:17.00,0:06:19.00,Default,,0,0,0,,Бұл бастапқыда ауыр жарақат емес еді.
Dialogue: 0,0:06:20.00,0:06:21.00,Default,,0,0,0,,Қазір толық емес жұмыс күні
Dialogue: 0,0:06:21.00,0:06:22.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:22.00,0:06:23.00,Default,,0,0,0,,Кештен бастап
Dialogue: 0,0:06:23.00,0:06:25.00,Default,,0,0,0,,Барлығыңызды кешіріңіз
Dialogue: 0,0:06:25.00,0:06:27.00,Default,,0,0,0,,Маған ыңғайлы болуды сұрады.
Dialogue: 0,0:06:28.00,0:06:30.00,Default,,0,0,0,,Жақсы, бәрібір менің бос уақытым бар.
Dialogue: 0,0:06:31.00,0:06:32.00,Default,,0,0,0,,Анамның толық емес жұмыс күні
Dialogue: 0,0:06:32.00,0:06:34.00,Default,,0,0,0,,Мен бір рет келгім келді.
Dialogue: 0,0:06:37.00,0:06:38.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:38.00,0:06:39.00,Default,,0,0,0,,Мен бөлмені шештім.
Dialogue: 0,0:06:39.00,0:06:40.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:40.00,0:06:45.00,Default,,0,0,0,,Бұл мен армандаған мүлік түрі емес.
Dialogue: 0,0:06:45.00,0:06:48.00,Default,,0,0,0,,Мен уақытты ескере отырып шешуге тура келді.
Dialogue: 0,0:06:48.00,0:06:51.00,Default,,0,0,0,,Осы айдың ішінде ымыраға келгеннен кейін ымыраға келу
Dialogue: 0,0:06:53.00,0:06:54.00,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:06:54.00,0:06:56.00,Default,,0,0,0,,Мен де Кога-санға хат жібердім.
Dialogue: 0,0:06:56.00,0:06:57.00,Default,,0,0,0,,Жауап беру
Dialogue: 0,0:06:57.00,0:06:58.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:58.00,0:06:59.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:00.00,0:07:01.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:01.00,0:07:03.00,Default,,0,0,0,,Мен Мэндимен де байланыса алмаймын.
Dialogue: 0,0:07:03.00,0:07:04.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:04.00,0:07:05.00,Default,,0,0,0,,Менің ата-анам
Dialogue: 0,0:07:05.00,0:07:08.00,Default,,0,0,0,,Мен өткен күні Токиоға шықтым.
Dialogue: 0,0:07:08.00,0:07:11.00,Default,,0,0,0,,Қага-санның әкесімен сол кезде танысқан көрінеді.
Dialogue: 0,0:07:11.00,0:07:13.00,Default,,0,0,0,,Қоғаның әкесі де біздің үйде.
Dialogue: 0,0:07:13.00,0:07:15.00,Default,,0,0,0,,Келіңіз
Dialogue: 0,0:07:15.00,0:07:18.00,Default,,0,0,0,,Әке, сақтандыру, көлік жөндеу және т.б.
Dialogue: 0,0:07:18.00,0:07:20.00,Default,,0,0,0,,Мен өзін-өзі сертификаттау туралы айттым.
Dialogue: 0,0:07:20.00,0:07:23.00,Default,,0,0,0,,Қалай болғанда да, бұл қате.
Dialogue: 0,0:07:23.00,0:07:26.00,Default,,0,0,0,,Мен мұны әлемде көп естимін.
Dialogue: 0,0:07:26.00,0:07:30.00,Default,,0,0,0,,Кеше менде апат болды.
Dialogue: 0,0:07:30.00,0:07:31.00,Default,,0,0,0,,немесе соған ұқсас нәрсе
Dialogue: 0,0:07:31.00,0:07:32.00,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:07:32.00,0:07:35.00,Default,,0,0,0,,Бұл сондай ауыр жағдайда болды.
Dialogue: 0,0:07:35.00,0:07:38.00,Default,,0,0,0,,Сіздің әкеңізбен кездескеніңізді естідім.
Dialogue: 0,0:07:38.00,0:07:39.00,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:07:39.00,0:07:42.00,Default,,0,0,0,,Ол жол осындай ауыр жағдайда айтылған.
Dialogue: 0,0:07:42.00,0:07:43.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:07:43.00,0:07:47.00,Default,,0,0,0,,Осы ойлардың бәрі менің басымда айналып жатыр.
Dialogue: 0,0:07:48.00,0:07:51.00,Default,,0,0,0,,Негізі мен қатты қорықтым.
Dialogue: 0,0:07:51.00,0:07:55.00,Default,,0,0,0,,Егер бәріміз шатассақ, өліп қалуымыз мүмкін еді.
Dialogue: 0,0:07:55.00,0:07:56.00,Default,,0,0,0,,Кога мырза
Dialogue: 0,0:07:56.00,0:07:58.00,Default,,0,0,0,,Сіз ашуланған болуыңыз керек.
Dialogue: 0,0:07:58.00,0:07:59.00,Default,,0,0,0,,Сооо
Dialogue: 0,0:07:59.00,0:08:03.00,Default,,0,0,0,,Оны шынымен де алаңдатып отырған сияқты.
Dialogue: 0,0:08:03.00,0:08:04.00,Default,,0,0,0,,(Ватару) Бұл жігіт суға түсе алмайды! (Цубаки) Косэй!
Dialogue: 0,0:08:04.00,0:08:07.00,Default,,0,0,0,,Мен қазір не істеуім керек?
Dialogue: 0,0:08:07.00,0:08:09.00,Default,,0,0,0,,Ең бірінші менің кінәм болса да.
Dialogue: 0,0:08:09.00,0:08:12.00,Default,,0,0,0,,Кога-сан да шаршамайды.
Dialogue: 0,0:08:12.00,0:08:14.00,Default,,0,0,0,,Маған көлік жүргізуге рұқсат етіңіз
Dialogue: 0,0:08:14.00,0:08:16.00,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:08:16.00,0:08:18.00,Default,,0,0,0,,Себебі мен жарақат алдым.
Dialogue: 0,0:08:18.00,0:08:20.00,Default,,0,0,0,,Мен шу шығарып жатырмын
Dialogue: 0,0:08:20.00,0:08:22.00,Default,,0,0,0,,Мен ең нашармын
Dialogue: 0,0:08:22.00,0:08:24.00,Default,,0,0,0,,Мен әйелдер бөліміндемін, абай болыңыз.
Dialogue: 0,0:08:24.00,0:08:28.00,Default,,0,0,0,,Ұйықтап қалмас үшін мен сенімен сөйлесуім керек еді.
Dialogue: 0,0:08:28.00,0:08:30.00,Default,,0,0,0,,Мен де жауапкершілікті сезінемін.
Dialogue: 0,0:08:30.00,0:08:32.00,Default,,0,0,0,,Сіз көлік жүргізуге әлі үйренбеген орта мектеп
Dialogue: 0,0:08:32.00,0:08:34.00,Default,,0,0,0,,Тоқтау керек еді
Dialogue: 0,0:08:36.00,0:08:38.00,Default,,0,0,0,,Ащы болуды доғарайық
Dialogue: 0,0:08:38.00,0:08:41.00,Default,,0,0,0,,Бұдан былай не істеуіміз керек?
Dialogue: 0,0:08:41.00,0:08:45.00,Default,,0,0,0,,Мен барлығының бірігіп, бұл туралы ойлануын қаладым.
Dialogue: 0,0:08:45.00,0:08:48.00,Default,,0,0,0,,Қағамен қоштасуға шыдамаймын.
Dialogue: 0,0:08:48.00,0:08:50.00,Default,,0,0,0,,Өйткені мен оны мүлдем жек көремін
Dialogue: 0,0:08:50.00,0:08:52.00,Default,,0,0,0,,Маған бұл да ұнамайды.
Dialogue: 0,0:08:52.00,0:08:54.00,Default,,0,0,0,,Мұны бәрі жек көреді.
Dialogue: 0,0:08:54.00,0:08:56.00,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:08:56.00,0:08:58.00,Default,,0,0,0,,Сонымен, мен
Dialogue: 0,0:08:58.00,0:08:59.00,Default,,0,0,0,,Коганың жағдайы қалай?
Dialogue: 0,0:08:59.00,0:09:01.00,Default,,0,0,0,,Мен істің қалай жүріп жатқанын білгім келеді.
Dialogue: 0,0:09:01.00,0:09:05.00,Default,,0,0,0,,Дегенмен, электрондық пошта мен телефон қоңыраулары да жақсы емес.
Dialogue: 0,0:09:06.00,0:09:08.00,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:09:10.00,0:09:12.00,Default,,0,0,0,,Янаги мырза Коганың үйі
Dialogue: 0,0:09:12.00,0:09:13.00,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:09:13.00,0:09:15.00,Default,,0,0,0,,О
Dialogue: 0,0:09:15.00,0:09:17.00,Default,,0,0,0,,That's right.
Dialogue: 0,0:09:17.00,0:09:18.00,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:09:18.00,0:09:19.00,Default,,0,0,0,,Иә
Dialogue: 0,0:09:19.00,0:09:21.00,Default,,0,0,0,,Ока-чан бұдан былай толық емес жұмыс күні болады.
Dialogue: 0,0:09:21.00,0:09:23.00,Default,,0,0,0,,Иә
Dialogue: 0,0:09:23.00,0:09:26.00,Default,,0,0,0,,Бэнлимен бірге барған дұрыс емес пе?
Dialogue: 0,0:09:26.00,0:09:29.00,Default,,0,0,0,,Бэнлимен жалғыз сөйлескен оңайырақ болар еді.
Dialogue: 0,0:09:32.00,0:09:34.00,Default,,0,0,0,,Кога мен Янаги ше?
Dialogue: 0,0:09:34.00,0:09:36.00,Default,,0,0,0,,Сіз осындай жерде өстіңіз бе?
Dialogue: 0,0:09:43.00,0:09:44.00,Default,,0,0,0,,Тада-кун?
Dialogue: 0,0:09:46.00,0:09:48.00,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:09:48.00,0:09:50.00,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:09:51.00,0:09:53.00,Default,,0,0,0,,Be fond of me
Dialogue: 0,0:09:53.00,0:09:55.00,Default,,0,0,0,,Барлық жерде маған еріңіз
Dialogue: 0,0:09:55.00,0:09:57.00,Default,,0,0,0,,Бүгін жұмыс істедіңіз бе?
Dialogue: 0,0:09:57.00,0:09:58.00,Default,,0,0,0,,Тек таңертең
Dialogue: 0,0:09:58.00,0:10:01.00,Default,,0,0,0,,Негізі мен демалыста болдым.
Dialogue: 0,0:10:01.00,0:10:03.00,Default,,0,0,0,,I gave it back.
Dialogue: 0,0:10:03.00,0:10:05.00,Default,,0,0,0,,Barcelona
Dialogue: 0,0:10:05.00,0:10:06.00,Default,,0,0,0,,Иә
Dialogue: 0,0:10:06.00,0:10:10.00,Default,,0,0,0,,Қоғаның басынан бастауға құлықсыз болып көрінді.
Dialogue: 0,0:10:13.00,0:10:14.00,Default,,0,0,0,,Koga
Dialogue: 0,0:10:16.00,0:10:17.00,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:10:27.00,0:10:29.00,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:10:45.00,0:10:46.00,Default,,0,0,0,,Koga
Dialogue: 0,0:10:47.00,0:10:48.00,Default,,0,0,0,,Koga
Dialogue: 0,0:10:48.00,0:10:49.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:51.00,0:10:54.00,Default,,0,0,0,,Өткен күні сізге қауіп төндіргенім үшін кешіріңіз.
Dialogue: 0,0:10:54.00,0:10:57.00,Default,,0,0,0,,Сені қорқытқаным үшін кешірім сұраймын.
Dialogue: 0,0:10:58.00,0:10:59.00,Default,,0,0,0,,Кога
Dialogue: 0,0:10:59.00,0:11:01.00,Default,,0,0,0,,Келме, кет
Dialogue: 0,0:11:01.00,0:11:03.00,Default,,0,0,0,,Маған қарама
Dialogue: 0,0:11:03.00,0:11:05.00,Default,,0,0,0,,Ешкімді көргім келмейді
Dialogue: 0,0:11:07.00,0:11:09.00,Default,,0,0,0,,Менің үйге барғым келмейді.
Dialogue: 0,0:11:10.00,0:11:12.00,Default,,0,0,0,,Мен де жақсы емеспін.
Dialogue: 0,0:11:12.00,0:11:15.00,Default,,0,0,0,,Мен сені енді көре алмаймын. I don't want to be seen.
Dialogue: 0,0:11:15.00,0:11:17.00,Default,,0,0,0,,Мен ең болмағанда алған ақшамды қайтарып бергім келеді.
Dialogue: 0,0:11:20.00,0:11:22.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:22.00,0:11:23.00,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:11:24.00,0:11:26.00,Default,,0,0,0,,Барлығы да қатты уайымдады.
Dialogue: 0,0:11:27.00,0:11:30.00,Default,,0,0,0,,Мен және басқалар жауапкершілікті сезінеміз.
Dialogue: 0,0:11:30.00,0:11:32.00,Default,,0,0,0,,Мұның бәрі де жаман емес.
Dialogue: 0,0:11:34.00,0:11:36.00,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:11:36.00,0:11:38.00,Default,,0,0,0,,Мұның мағынасы осы емес пе?
Dialogue: 0,0:11:38.00,0:11:41.00,Default,,0,0,0,,Мен өзімнен ұяламын
Dialogue: 0,0:11:43.00,0:11:45.00,Default,,0,0,0,,I thought
Dialogue: 0,0:11:45.00,0:11:48.00,Default,,0,0,0,,Мен өзімнің ақымақтығымды алғаш рет шындап ойладым.
Dialogue: 0,0:11:48.00,0:11:51.00,Default,,0,0,0,,Мен бәрін істей аламын деп ойладым.
Dialogue: 0,0:11:51.00,0:11:54.00,Default,,0,0,0,,Мен қазір ересекпін және боспын.
Dialogue: 0,0:11:54.00,0:11:57.00,Default,,0,0,0,,Қалауыңызша әрекет ете аласыз
Dialogue: 0,0:11:58.00,0:12:00.00,Default,,0,0,0,,Нәтиже - күріш айдау
Dialogue: 0,0:12:00.00,0:12:03.00,Default,,0,0,0,,Мен қателессем, бәріміз өлетін едік.
Dialogue: 0,0:12:04.00,0:12:05.00,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:12:06.00,0:12:08.00,Default,,0,0,0,,Демек, бұл тек Коганың кінәсі.
Dialogue: 0,0:12:08.00,0:12:09.00,Default,,0,0,0,,А, осы ма?
Dialogue: 0,0:12:09.00,0:12:11.00,Default,,0,0,0,,Бұл толығымен менің кінәм.
Dialogue: 0,0:12:13.00,0:12:15.00,Default,,0,0,0,,Көлікті бос жүру дұрыс емес.
Dialogue: 0,0:12:15.00,0:12:17.00,Default,,0,0,0,,Бұл сіздің жауапкершілігіңіз, солай ма?
Dialogue: 0,0:12:17.00,0:12:20.00,Default,,0,0,0,,Бірақ мен барлық тазалауды да өз мойныма алдым.
Dialogue: 0,0:12:20.00,0:12:23.00,Default,,0,0,0,,Мен қаншалықты жетілмеген екенімді түсінбеймін.
Dialogue: 0,0:12:23.00,0:12:27.00,Default,,0,0,0,,Мен шынымен де ақымақпын
Dialogue: 0,0:12:28.00,0:12:30.00,Default,,0,0,0,,Жасым жетсе де
Dialogue: 0,0:12:30.00,0:12:33.00,Default,,0,0,0,,Мен неге осылай ересек бола алмаймын?
Dialogue: 0,0:12:33.00,0:12:36.00,Default,,0,0,0,,Көктемге дейін мектеп оқушысы болдым.
Dialogue: 0,0:12:36.00,0:12:38.00,Default,,0,0,0,,Сіз кенеттен қалай ересек адам болдыңыз?
Dialogue: 0,0:12:38.00,0:12:41.00,Default,,0,0,0,,Бірақ мен өзімді ересек адаммын деп ойладым
Dialogue: 0,0:12:41.00,0:12:44.00,Default,,0,0,0,,Ол шын мәнінде ересек адам сияқты әрекет етті.
Dialogue: 0,0:12:44.00,0:12:47.00,Default,,0,0,0,,Түнде көшеге шығып, қымбат аяқ киім кию
Dialogue: 0,0:12:47.00,0:12:50.00,Default,,0,0,0,,Боянып, өзіңізге ұнайтын адаммен танысыңыз
Dialogue: 0,0:12:50.00,0:12:52.00,Default,,0,0,0,,Көлік жүргізу
Dialogue: 0,0:12:52.00,0:12:55.00,Default,,0,0,0,,Мен бала кезімде сондай ақымақпын
Dialogue: 0,0:12:55.00,0:12:57.00,Default,,0,0,0,,Мен ересек адамға еліктедім.
Dialogue: 0,0:12:57.00,0:13:01.00,Default,,0,0,0,,Бұл бәріне қауіп төндірді.
Dialogue: 0,0:13:01.00,0:13:04.00,Default,,0,0,0,,Мен өзімнен ұяламын
Dialogue: 0,0:13:04.00,0:13:08.00,Default,,0,0,0,,Мен енді бетімді жұрттың алдында көрсете алмаймын.
Dialogue: 0,0:13:08.00,0:13:10.00,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:13:10.00,0:13:12.00,Default,,0,0,0,,Барлығы Кога үшін алаңдайды.
Dialogue: 0,0:13:12.00,0:13:13.00,Default,,0,0,0,,№.
Dialogue: 0,0:13:13.00,0:13:14.00,Default,,0,0,0,,Кога
Dialogue: 0,0:13:16.00,0:13:17.00,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:18.00,0:13:21.00,Default,,0,0,0,,Жауапкершілікті дұрыс қабылдауым керек.
Dialogue: 0,0:13:21.00,0:13:24.00,Default,,0,0,0,,Менде Банри қайта кездесетін түрі жоқ.
Dialogue: 0,0:13:26.00,0:13:30.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:31.00,0:13:33.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:34.00,0:13:35.00,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:13:35.00,0:13:38.00,Default,,0,0,0,,Бұл мені енді ешқашан көрмейсің деген сөз
Dialogue: 0,0:13:38.00,0:13:40.00,Default,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,0:13:40.00,0:13:43.00,Default,,0,0,0,,Жазатайым оқиға – жазатайым оқиға.
Dialogue: 0,0:13:43.00,0:13:44.00,Default,,0,0,0,,Кездесетін бет жоқ
Dialogue: 0,0:13:44.00,0:13:45.00,Default,,0,0,0,,Артық емес
Dialogue: 0,0:13:45.00,0:13:46.00,Default,,0,0,0,,Күл жоғалады
Dialogue: 0,0:13:46.00,0:13:50.00,Default,,0,0,0,,Сіз мұндай нәрсе үшін жауапкершілікті аламын деп айтпайсыз, солай ма?
Dialogue: 0,0:13:50.00,0:13:52.00,Default,,0,0,0,,Кога осылай кешірілгісі келеді.
Dialogue: 0,0:13:52.00,0:13:53.00,Default,,0,0,0,,Роджер
Dialogue: 0,0:13:53.00,0:13:54.00,Default,,0,0,0,,Маған
Dialogue: 0,0:13:54.00,0:13:55.00,Default,,0,0,0,,Барлығына
Dialogue: 0,0:13:55.00,0:13:57.00,Default,,0,0,0,,Бұл мені жақсы сезінеді
Dialogue: 0,0:13:57.00,0:13:59.00,Default,,0,0,0,,Сонда ол жоғалады дейсіз бе?
Dialogue: 0,0:14:00.00,0:14:02.00,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:14:02.00,0:14:04.00,Default,,0,0,0,,Мен мұны айтқым келген жоқ.
Dialogue: 0,0:14:04.00,0:14:05.00,Default,,0,0,0,,Жазатайым оқиға болды
Dialogue: 0,0:14:05.00,0:14:07.00,Default,,0,0,0,,Одан кейін ештеңе істеу мүмкін болмады
Dialogue: 0,0:14:07.00,0:14:09.00,Default,,0,0,0,,Бұл үшін ұят болғаны дұрыс.
Dialogue: 0,0:14:09.00,0:14:10.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:14:10.00,0:14:12.00,Default,,0,0,0,,Сол ұяттан қашпа
Dialogue: 0,0:14:12.00,0:14:14.00,Default,,0,0,0,,Ұятты өзімді арқалап
Dialogue: 0,0:14:14.00,0:14:16.00,Default,,0,0,0,,Сонда да өмір сүруден басқа амалымыз жоқ.
Dialogue: 0,0:14:16.00,0:14:20.00,Default,,0,0,0,,Сіз өзіңіз болуды тоқтата алмайсыз.
Dialogue: 0,0:14:20.00,0:14:21.00,Default,,0,0,0,,Немесе не?
Dialogue: 0,0:14:21.00,0:14:24.00,Default,,0,0,0,,Мен туралы қабылдай алмайтын ештеңе жоқ сияқты.
Dialogue: 0,0:14:24.00,0:14:25.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:14:25.00,0:14:27.00,Default,,0,0,0,,Басқа апат орын алса
Dialogue: 0,0:14:27.00,0:14:28.00,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:14:28.00,0:14:30.00,Default,,0,0,0,,Мұның менің қазір кім екеніме еш қатысы жоқ.
Dialogue: 0,0:14:30.00,0:14:32.00,Default,,0,0,0,,Дәл солай, сіз оны өзіңізге ыңғайлы уақытта қайта-қайта жасай аласыз.
Dialogue: 0,0:14:32.00,0:14:34.00,Default,,0,0,0,,Артында қалған адамдар
Dialogue: 0,0:14:34.00,0:14:36.00,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:14:37.00,0:14:39.00,Default,,0,0,0,,Шулы
Dialogue: 0,0:14:39.00,0:14:40.00,Default,,0,0,0,,Сен ғой—
Dialogue: 0,0:14:40.00,0:14:42.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:14:42.00,0:14:45.00,Default,,0,0,0,,Сіз
Dialogue: 0,0:14:45.00,0:14:46.00,Default,,0,0,0,,Сонымен, сен сол аралда не істеп жүрдің?
Dialogue: 0,0:14:46.00,0:14:47.00,Default,,0,0,0,,Айт
Dialogue: 0,0:14:47.00,0:14:49.00,Default,,0,0,0,,Кога
Dialogue: 0,0:14:49.00,0:14:51.00,Default,,0,0,0,,Паннеде
Dialogue: 0,0:14:51.00,0:14:52.00,Default,,0,0,0,,Тек Panne үшін
Dialogue: 0,0:14:52.00,0:14:54.00,Default,,0,0,0,,Маған ешқашан айтқым келмейді
Dialogue: 0,0:14:54.00,0:14:57.00,Default,,0,0,0,,Сіз
Dialogue: 0,0:14:57.00,0:14:58.00,Default,,0,0,0,,Тек Panne үшін
Dialogue: 0,0:14:58.00,0:15:01.00,Default,,0,0,0,,Мен мұны естігім келмейді.
Dialogue: 0,0:15:01.00,0:15:02.00,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:15:02.00,0:15:04.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:04.00,0:15:05.00,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:15:05.00,0:15:07.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:08.00,0:15:09.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:11.00,0:15:12.00,Default,,0,0,0,,Панде
Dialogue: 0,0:15:12.00,0:15:14.00,Default,,0,0,0,,Сен бәрін лақтырып жібердің.
Dialogue: 0,0:15:14.00,0:15:15.00,Default,,0,0,0,,Артында қалдырыңыз
Dialogue: 0,0:15:15.00,0:15:17.00,Default,,0,0,0,,Қайталап көріңіз
Dialogue: 0,0:15:17.00,0:15:18.00,Default,,0,0,0,,Өткен шақ мүлде жоқ
Dialogue: 0,0:15:18.00,0:15:20.00,Default,,0,0,0,,Сіз оны қабылдаған жоқсыз.
Dialogue: 0,0:15:20.00,0:15:21.00,Default,,0,0,0,,Яғни
Dialogue: 0,0:15:21.00,0:15:24.00,Default,,0,0,0,,Менікі мен қалағандай болмады.
Dialogue: 0,0:15:24.00,0:15:25.00,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:15:25.00,0:15:26.00,Default,,0,0,0,,Оны ұмыт
Dialogue: 0,0:15:26.00,0:15:27.00,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:15:27.00,0:15:28.00,Default,,0,0,0,,Қай Германия?
Dialogue: 0,0:15:28.00,0:15:29.00,Default,,0,0,0,,Өткен
Dialogue: 0,0:15:29.00,0:15:30.00,Default,,0,0,0,,Артыңызға қарамаңыз
Dialogue: 0,0:15:30.00,0:15:31.00,Default,,0,0,0,,Жылау және айқайлау
Dialogue: 0,0:15:31.00,0:15:32.00,Default,,0,0,0,,Кім шу шығарды
Dialogue: 0,0:15:32.00,0:15:33.00,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:15:35.00,0:15:36.00,Default,,0,0,0,,Не?
Dialogue: 0,0:15:36.00,0:15:37.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:37.00,0:15:39.00,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:15:39.00,0:15:40.00,Default,,0,0,0,,Ой, не болып жатыр? Менің де денем магнитке айналады деп ойламаған едім.
Dialogue: 0,0:15:40.00,0:15:41.00,Default,,0,0,0,,Менің өткен өмірім
Dialogue: 0,0:15:41.00,0:15:42.00,Default,,0,0,0,,Сізге Линда ұнады ма?
Dialogue: 0,0:15:42.00,0:15:44.00,Default,,0,0,0,,Айтпа
Dialogue: 0,0:15:44.00,0:15:46.00,Default,,0,0,0,,Егер біреу осылай айтса
Dialogue: 0,0:15:46.00,0:15:47.00,Default,,0,0,0,,Содан кейін мен
Dialogue: 0,0:15:47.00,0:15:49.00,Default,,0,0,0,,Мен не істеуім керек еді?
Dialogue: 0,0:15:52.00,0:15:53.00,Default,,0,0,0,,Жалпы
Dialogue: 0,0:15:53.00,0:15:54.00,Default,,0,0,0,,Сіз
Dialogue: 0,0:15:54.00,0:15:55.00,Default,,0,0,0,,Олай айтпа
Dialogue: 0,0:15:59.00,0:16:00.00,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:16:00.00,0:16:02.00,Default,,0,0,0,,Бұған дейін, солай емес пе?
Dialogue: 0,0:16:02.00,0:16:03.00,Default,,0,0,0,,Басынан бастап Панде
Dialogue: 0,0:16:03.00,0:16:04.00,Default,,0,0,0,,Менің өткен өмірім
Dialogue: 0,0:16:04.00,0:16:05.00,Default,,0,0,0,,Сіз оны қабылдауға дайынсыз ба?
Dialogue: 0,0:16:05.00,0:16:07.00,Default,,0,0,0,,Ол жоқ еді.
Dialogue: 0,0:16:07.00,0:16:08.00,Default,,0,0,0,,Сондықтан бұл менің ата-анамның үйі.
Dialogue: 0,0:16:08.00,0:16:09.00,Default,,0,0,0,,Сен оны лақтырып жібердің, солай ма?
Dialogue: 0,0:16:09.00,0:16:10.00,Default,,0,0,0,,Отбасы және достар
Dialogue: 0,0:16:10.00,0:16:12.00,Default,,0,0,0,,Артында қалдырыңыз
Dialogue: 0,0:16:12.00,0:16:13.00,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:16:13.00,0:16:14.00,Default,,0,0,0,,Линда-сенпай да
Dialogue: 0,0:16:14.00,0:16:15.00,Default,,0,0,0,,Батпырауық
Dialogue: 0,0:16:15.00,0:16:16.00,Default,,0,0,0,,Сабырлы жүзді киіңіз
Dialogue: 0,0:16:16.00,0:16:18.00,Default,,0,0,0,,Сен қазір тірісің бе?
Dialogue: 0,0:16:18.00,0:16:19.00,Default,,0,0,0,,Барлығы менікі
Dialogue: 0,0:16:19.00,0:16:21.00,Default,,0,0,0,,Бұл сіз істеп жатқан нәрсе емес.
Dialogue: 0,0:16:21.00,0:16:22.00,Default,,0,0,0,,Ал қазір
Dialogue: 0,0:16:22.00,0:16:23.00,Default,,0,0,0,,Сіз мені кесіп тастамақсыз ба?
Dialogue: 0,0:16:25.00,0:16:26.00,Default,,0,0,0,,Тағы бір апат болды.
Dialogue: 0,0:16:26.00,0:16:27.00,Default,,0,0,0,,Менің жадым ұшқанда
Dialogue: 0,0:16:27.00,0:16:28.00,Default,,0,0,0,,артта қалды
Dialogue: 0,0:16:28.00,0:16:29.00,Default,,0,0,0,,Не лақтырылады
Dialogue: 0,0:16:29.00,0:16:31.00,Default,,0,0,0,,Енді менің кезегім, солай ма?
Dialogue: 0,0:16:32.00,0:16:33.00,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:16:33.00,0:16:34.00,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:16:35.00,0:16:36.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:38.00,0:16:39.00,Default,,0,0,0,,Түсімде көрдім
Dialogue: 0,0:16:40.00,0:16:41.00,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:16:42.00,0:16:43.00,Default,,0,0,0,,Панри
Dialogue: 0,0:16:43.00,0:16:44.00,Default,,0,0,0,,Мені қалдырыңыз
Dialogue: 0,0:16:44.00,0:16:45.00,Default,,0,0,0,,Қашуды армандау
Dialogue: 0,0:16:45.00,0:16:47.00,Default,,0,0,0,,Мен осындай түс көрдім
Dialogue: 0,0:16:47.00,0:16:48.00,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:16:49.00,0:16:50.00,Default,,0,0,0,,Түс көргендіктен
Dialogue: 0,0:16:50.00,0:16:51.00,Default,,0,0,0,,Сіз мұны айтып тұрсыз ба?
Dialogue: 0,0:16:51.00,0:16:52.00,Default,,0,0,0,,Түс көргендіктен
Dialogue: 0,0:16:52.00,0:16:53.00,Default,,0,0,0,,Мен
Dialogue: 0,0:16:53.00,0:16:54.00,Default,,0,0,0,,Ашулану
Dialogue: 0,0:16:54.00,0:16:55.00,Default,,0,0,0,,Сізді ұрып-соқтыңыз ба?
Dialogue: 0,0:16:58.00,0:17:01.00,Default,,0,0,0,,Күлме
Dialogue: 0,0:17:05.00,0:17:06.00,Default,,0,0,0,,Панри
Dialogue: 0,0:17:07.00,0:17:09.00,Default,,0,0,0,,Мен қорқыныштымын
Dialogue: 0,0:17:18.00,0:17:19.00,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:17:19.00,0:17:20.00,Default,,0,0,0,,Мен ұйықтай алмаймын
Dialogue: 0,0:17:22.00,0:17:24.00,Default,,0,0,0,,Мен ұйықтайын деп жатқанда
Dialogue: 0,0:17:24.00,0:17:25.00,Default,,0,0,0,,Армандау
Dialogue: 0,0:17:26.00,0:17:28.00,Default,,0,0,0,,Көлік жүргізуді армандау
Dialogue: 0,0:17:29.00,0:17:30.00,Default,,0,0,0,,Автомобиль жолы
Dialogue: 0,0:17:30.00,0:17:31.00,Default,,0,0,0,,Сіз жүгіріп жүрсіз бе?
Dialogue: 0,0:17:32.00,0:17:33.00,Default,,0,0,0,,Панри
Dialogue: 0,0:17:33.00,0:17:34.00,Default,,0,0,0,,Әйелдер бөлімінде
Dialogue: 0,0:17:34.00,0:17:35.00,Default,,0,0,0,,Жолда
Dialogue: 0,0:17:35.00,0:17:36.00,Default,,0,0,0,,Пойыздан түсіңіз.
Dialogue: 0,0:17:36.00,0:17:37.00,Default,,0,0,0,,Белгі пайда болады
Dialogue: 0,0:17:38.00,0:17:39.00,Default,,0,0,0,,Мен ғана түсе аламын
Dialogue: 0,0:17:39.00,0:17:40.00,Default,,0,0,0,,Артқа қарау
Dialogue: 0,0:17:41.00,0:17:43.00,Default,,0,0,0,,Панри мінген көлік
Dialogue: 0,0:17:43.00,0:17:44.00,Default,,0,0,0,,Сью
Dialogue: 0,0:17:44.00,0:17:45.00,Default,,0,0,0,,Жүгіруді бастаңыз
Dialogue: 0,0:17:45.00,0:17:46.00,Default,,0,0,0,,Мені қууға болмайды
Dialogue: 0,0:17:46.00,0:17:47.00,Default,,0,0,0,,Тек қана шығарып салыңыз
Dialogue: 0,0:17:48.00,0:17:49.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:49.00,0:17:50.00,Default,,0,0,0,,Ұзақ уақыт бойы
Dialogue: 0,0:17:50.00,0:17:51.00,Default,,0,0,0,,Мұндай арман
Dialogue: 0,0:17:51.00,0:17:52.00,Default,,0,0,0,,Мен өзімді көріп тұрғандай сезінемін.
Dialogue: 0,0:17:53.00,0:17:54.00,Default,,0,0,0,,Панриге
Dialogue: 0,0:17:54.00,0:17:55.00,Default,,0,0,0,,Артында қалды
Dialogue: 0,0:17:55.00,0:17:56.00,Default,,0,0,0,,Сол күні
Dialogue: 0,0:17:56.00,0:17:57.00,Default,,0,0,0,,Бір күні
Dialogue: 0,0:17:57.00,0:17:58.00,Default,,0,0,0,,Міндетті түрде келеді
Dialogue: 0,0:17:58.00,0:17:59.00,Default,,0,0,0,,Ойлау
Dialogue: 0,0:17:59.00,0:18:00.00,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:18:00.00,0:18:01.00,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:18:01.00,0:18:02.00,Default,,0,0,0,,Қорқады
Dialogue: 0,0:18:02.00,0:18:03.00,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:18:03.00,0:18:04.00,Default,,0,0,0,,Мен қайтадан
Dialogue: 0,0:18:04.00,0:18:05.00,Default,,0,0,0,,Жад
Dialogue: 0,0:18:05.00,0:18:06.00,Default,,0,0,0,,Жоғалтып алмайсың ба?
Dialogue: 0,0:18:06.00,0:18:07.00,Default,,0,0,0,,...
Dialogue: 0,0:18:08.00,0:18:09.00,Default,,0,0,0,,Иә
Dialogue: 0,0:18:10.00,0:18:11.00,Default,,0,0,0,,Мен
Dialogue: 0,0:18:11.00,0:18:12.00,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:18:12.00,0:18:13.00,Default,,0,0,0,,Иә
Dialogue: 0,0:18:14.00,0:18:15.00,Default,,0,0,0,,Мен
Dialogue: 0,0:18:15.00,0:18:16.00,Default,,0,0,0,,What if
Dialogue: 0,0:18:16.00,0:18:17.00,Default,,0,0,0,,Панриге
Dialogue: 0,0:18:17.00,0:18:18.00,Default,,0,0,0,,Егер артта қалса
Dialogue: 0,0:18:18.00,0:18:19.00,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:18:19.00,0:18:20.00,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:18:20.00,0:18:21.00,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:18:21.00,0:18:22.00,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:18:23.00,0:18:24.00,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:18:24.00,0:18:25.00,Default,,0,0,0,,тіпті Эден кампусында да — қайдағы қырағы көздердің қашан қарап тұрғанын білмейсің.
Dialogue: 0,0:18:25.00,0:18:26.00,Default,,0,0,0,,Мен өмір сүруім керек пе?
Dialogue: 0,0:18:26.00,0:18:27.00,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:18:28.00,0:18:29.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:18:29.00,0:18:30.00,Default,,0,0,0,,(Кугисаки) Эй, сен! (Скаут) Ә?
Dialogue: 0,0:18:30.00,0:18:31.00,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:18:31.00,0:18:32.00,Default,,0,0,0,,Барсаң
Dialogue: 0,0:18:32.00,0:18:33.00,Default,,0,0,0,,Мен де
Dialogue: 0,0:18:33.00,0:18:34.00,Default,,0,0,0,,бірге
Dialogue: 0,0:18:34.00,0:18:35.00,Default,,0,0,0,,Мені ал
Dialogue: 0,0:18:36.00,0:18:37.00,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:18:37.00,0:18:38.00,Default,,0,0,0,,Сол арман
Dialogue: 0,0:18:38.00,0:18:39.00,Default,,0,0,0,,Қарасаңыз
Dialogue: 0,0:18:39.00,0:18:40.00,Default,,0,0,0,,Әзірге
Dialogue: 0,0:18:40.00,0:18:41.00,Default,,0,0,0,,Көліктен
Dialogue: 0,0:18:41.00,0:18:42.00,Default,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
