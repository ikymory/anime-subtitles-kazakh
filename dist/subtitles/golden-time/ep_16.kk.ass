Dialogue: 0,0:20:03.00,0:20:04.00,Default,,0,0,0,,Панди туралы
Dialogue: 0,0:20:05.00,0:20:06.00,Default,,0,0,0,,Мен
Dialogue: 0,0:20:06.00,0:20:07.00,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:20:10.00,0:20:11.00,Default,,0,0,0,,Жер
Dialogue: 0,0:20:12.00,0:20:13.00,Default,,0,0,0,,Онда
Dialogue: 0,0:20:13.00,0:20:14.00,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:20:15.00,0:20:16.00,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:20:16.00,0:20:17.00,Default,,0,0,0,,Онда жоқ.
Dialogue: 0,0:20:17.00,0:20:18.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:18.00,0:20:19.00,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:20:19.00,0:20:20.00,Default,,0,0,0,,Мұнда кім бар?
Dialogue: 0,0:20:20.00,0:20:21.00,Default,,0,0,0,,Тек мысықтар
Dialogue: 0,0:20:21.00,0:20:22.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:22.00,0:20:23.00,Default,,0,0,0,,Бұл менің әкемнің жұмысы.
Dialogue: 0,0:20:23.00,0:20:24.00,Default,,0,0,0,,Түс болды
Dialogue: 0,0:20:24.00,0:20:25.00,Default,,0,0,0,,Бірге рамен жейміз
Dialogue: 0,0:20:25.00,0:20:26.00,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:20:26.00,0:20:27.00,Default,,0,0,0,,Иә
Dialogue: 0,0:20:28.00,0:20:29.00,Default,,0,0,0,,Өтірік айту жаман
Dialogue: 0,0:20:30.00,0:20:31.00,Default,,0,0,0,,Мұнда
Dialogue: 0,0:20:31.00,0:20:32.00,Default,,0,0,0,,Ол
Dialogue: 0,0:20:32.00,0:20:33.00,Default,,0,0,0,,Мен өтірік айттым.
Dialogue: 0,0:20:34.00,0:20:35.00,Default,,0,0,0,,Әкем
Dialogue: 0,0:20:35.00,0:20:36.00,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:20:36.00,0:20:37.00,Default,,0,0,0,,Ол шыншыл болды.
Dialogue: 0,0:20:37.00,0:20:38.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:20:38.00,0:20:39.00,Default,,0,0,0,,Ол
Dialogue: 0,0:20:39.00,0:20:40.00,Default,,0,0,0,,Өтірік айтты
Dialogue: 0,0:20:40.00,0:20:41.00,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:20:44.00,0:20:45.00,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:20:45.00,0:20:46.00,Default,,0,0,0,,Ұнатпау
Dialogue: 0,0:20:47.00,0:20:48.00,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:20:48.00,0:20:49.00,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:20:49.00,0:20:50.00,Default,,0,0,0,,Осындай өмір
Dialogue: 0,0:20:50.00,0:20:51.00,Default,,0,0,0,,Ұнатпау
Dialogue: 0,0:20:52.00,0:20:53.00,Default,,0,0,0,,Мұнда
Dialogue: 0,0:20:53.00,0:20:54.00,Default,,0,0,0,,Біраз
Dialogue: 0,0:20:54.00,0:20:55.00,Default,,0,0,0,,Ванли
Dialogue: 0,0:20:55.00,0:20:56.00,Default,,0,0,0,,Жұмыстан шығару
Dialogue: 0,0:20:57.00,0:20:58.00,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:20:58.00,0:20:59.00,Default,,0,0,0,,Жасаңыз
Dialogue: 0,0:20:59.00,0:21:00.00,Default,,0,0,0,,Ақыл
Dialogue: 0,0:21:00.00,0:21:01.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:01.00,0:21:02.00,Default,,0,0,0,,Сіз оны жей аласыз ба?
Dialogue: 0,0:21:02.00,0:21:03.00,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:21:03.00,0:21:04.00,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:21:05.00,0:21:06.00,Default,,0,0,0,,Менің тамақтан басқа амалым жоқ.
Dialogue: 0,0:21:06.00,0:21:07.00,Default,,0,0,0,,Тек Ақ кит жақында пайда болады екенін білемін—
Dialogue: 0,0:21:07.00,0:21:08.00,Default,,0,0,0,,Заттарды кәдімгідей қабылдау
Dialogue: 0,0:21:08.00,0:21:09.00,Default,,0,0,0,,табиғи түрде
Dialogue: 0,0:21:09.00,0:21:10.00,Default,,0,0,0,,Қазір ғана
Dialogue: 0,0:21:10.00,0:21:11.00,Default,,0,0,0,,Барлығыңызды асығыңыз
Dialogue: 0,0:21:11.00,0:21:13.00,Default,,0,0,0,,Шық
Dialogue: 0,0:21:13.00,0:21:14.00,Default,,0,0,0,,Ас үй
Dialogue: 0,0:21:14.00,0:21:15.00,Default,,0,0,0,,Қайда?
Dialogue: 0,0:21:15.00,0:21:16.00,Default,,0,0,0,,төменде
Dialogue: 0,0:21:16.00,0:21:17.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:27.00,0:21:28.00,Default,,0,0,0,,Дайын
Dialogue: 0,0:21:28.00,0:21:29.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:21:29.00,0:21:30.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:32.00,0:21:33.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:33.00,0:21:34.00,Default,,0,0,0,,Мен оны аламын
Dialogue: 0,0:21:35.00,0:21:36.00,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:21:42.00,0:21:43.00,Default,,0,0,0,,Жер
Dialogue: 0,0:21:43.00,0:21:44.00,Default,,0,0,0,,Тағы да сол арман
Dialogue: 0,0:21:44.00,0:21:45.00,Default,,0,0,0,,Сіз қарап отырсыз ба?
Dialogue: 0,0:21:48.00,0:21:49.00,Default,,0,0,0,,Ориринойо
Dialogue: 0,0:21:49.00,0:21:50.00,Default,,0,0,0,,Монжиро!
Dialogue: 0,0:21:59.00,0:22:00.00,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:22:00.00,0:22:01.00,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:22:01.00,0:22:02.00,Default,,0,0,0,,Егер жоқ болса
Dialogue: 0,0:22:02.00,0:22:04.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:22:04.00,0:22:05.00,Default,,0,0,0,,Сіз оны әлі түсінбейсіз
Dialogue: 0,0:22:05.00,0:22:06.00,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:22:06.00,0:22:07.00,Default,,0,0,0,,2
Dialogue: 0,0:22:07.00,0:22:08.00,Default,,0,0,0,,3
Dialogue: 0,0:22:08.00,0:22:09.00,Default,,0,0,0,,Уақыт
Dialogue: 0,0:22:09.00,0:22:10.00,Default,,0,0,0,,Мүмкін бұрын
Dialogue: 0,0:22:10.00,0:22:11.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:22:11.00,0:22:12.00,Default,,0,0,0,,Қолда
Dialogue: 0,0:22:12.00,0:22:13.00,Default,,0,0,0,,Мен саған тиіскім келеді
Dialogue: 0,0:22:14.00,0:22:15.00,Default,,0,0,0,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:22:16.00,0:22:17.00,Default,,0,0,0,,О.
Dialogue: 0,0:22:17.00,0:22:18.00,Default,,0,0,0,,Немесе
Dialogue: 0,0:22:18.00,0:22:19.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:22:19.00,0:22:20.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:22:20.00,0:22:21.00,Default,,0,0,0,,Бүгін
Dialogue: 0,0:22:21.00,0:22:57.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:22:57.00,0:23:01.00,Default,,0,0,0,,Тездетіп мені сүй
Dialogue: 0,0:23:01.00,0:23:04.00,Default,,0,0,0,,Мені 5000 жылдан кейін не болатыны қызықтырмайды.
Dialogue: 0,0:23:04.00,0:23:08.00,Default,,0,0,0,,Мен шексіз емеспін
Dialogue: 0,0:23:08.00,0:23:11.00,Default,,0,0,0,,Сен қашан өлесің?
Dialogue: 0,0:23:11.00,0:23:14.00,Default,,0,0,0,,Мен сені мәңгілікке сүйемін
Dialogue: 0,0:23:14.00,0:23:17.00,Default,,0,0,0,,Айтсаң да риза емеспін
Dialogue: 0,0:23:17.00,0:23:21.00,Default,,0,0,0,,Алдымен өлуге рұқсат етіңіз
Dialogue: 0,0:23:21.00,0:23:25.00,Default,,0,0,0,,Тек махаббат туралы ойла
Dialogue: 0,0:23:27.00,0:23:31.00,Default,,0,0,0,,Уау, мен Коуконың бөлмесіне бірінші рет кіріп отырмын.
Dialogue: 0,0:23:31.00,0:23:35.00,Default,,0,0,0,,Бұл коконың иісі.
Dialogue: 0,0:23:35.00,0:23:38.00,Default,,0,0,0,,Айналдырып жатқан жастықтың өзі Коуконың иісіне ұқсайды.
Dialogue: 0,0:23:39.50,0:23:44.50,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
