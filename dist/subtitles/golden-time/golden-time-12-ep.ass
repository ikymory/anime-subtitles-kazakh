Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:08.00,Default,,0,0,0,,Бэнли! Ендеше, сен неге әдемі киіндің?
Dialogue: 0,0:00:08.00,0:00:09.00,Default,,0,0,0,,Линда-сенпай - бұл!
Dialogue: 0,0:00:31.00,0:00:32.00,Default,,0,0,0,,Қолайлы қол!
Dialogue: 0,0:00:32.00,0:00:34.00,Default,,0,0,0,,Кешке барайық
Dialogue: 0,0:00:34.00,0:00:37.00,Default,,0,0,0,,Жүрегім билейді, Мен оны тоқтата алмаймын
Dialogue: 0,0:00:37.00,0:00:39.00,Default,,0,0,0,,Жыла және күл
Dialogue: 0,0:00:39.00,0:00:41.00,Default,,0,0,0,,Сіздермен естеліктер
Dialogue: 0,0:00:41.00,0:00:44.00,Default,,0,0,0,,Мен ешқашан ұмытпаймын
Dialogue: 0,0:00:50.00,0:00:54.00,Default,,0,0,0,,Нағыз мен қайда?
Dialogue: 0,0:00:54.00,0:00:57.00,Default,,0,0,0,,Ересек болу қиын.
Dialogue: 0,0:00:57.00,0:01:00.00,Default,,0,0,0,,Мен оны әзірше ұмыта аламын ба?
Dialogue: 0,0:01:00.00,0:01:03.00,Default,,0,0,0,,Өйткені түн күтіп тұр
Dialogue: 0,0:01:03.00,0:01:05.00,Default,,0,0,0,,Жүрегің лүпілдесін
Dialogue: 0,0:01:05.00,0:01:07.00,Default,,0,0,0,,Біз кездесе аламыз
Dialogue: 0,0:01:07.00,0:01:10.00,Default,,0,0,0,,Көңілді болсаң
Dialogue: 0,0:01:10.00,0:01:12.00,Default,,0,0,0,,Мен сізге айтқым келеді
Dialogue: 0,0:01:12.00,0:01:14.00,Default,,0,0,0,,Енді менің ойымда
Dialogue: 0,0:01:14.00,0:01:17.00,Default,,0,0,0,,Байқаймын ба деп қорқамын
Dialogue: 0,0:01:17.00,0:01:19.00,Default,,0,0,0,,Өткен және болашақ
Dialogue: 0,0:01:19.00,0:01:21.00,Default,,0,0,0,,Қорықсаң да
Dialogue: 0,0:01:21.00,0:01:24.00,Default,,0,0,0,,Бос болса қозғала алмайды
Dialogue: 0,0:01:24.00,0:01:28.00,Default,,0,0,0,,Ләззат алсаң, бәрі жақсы
Dialogue: 0,0:01:28.00,0:01:30.00,Default,,0,0,0,,бастайық
Dialogue: 0,0:01:30.00,0:01:33.00,Default,,0,0,0,,Барлық жаман нәрселерді ұмытыңыз
Dialogue: 0,0:01:33.00,0:01:36.00,Default,,0,0,0,,Мен сенімен түнде билесем
Dialogue: 0,0:01:36.00,0:01:40.00,Default,,0,0,0,,Өзіңіздің жақсырақ нұсқасы болыңыз
Dialogue: 0,0:01:40.00,0:01:44.00,Default,,0,0,0,,Мен солай сезінемін.
Dialogue: 0,0:01:44.00,0:01:47.00,Default,,0,0,0,,Бұл бітпейтін аспан денесі
Dialogue: 0,0:01:47.00,0:01:48.00,Default,,0,0,0,,Жақын болыңыз
Dialogue: 0,0:01:48.00,0:01:50.00,Default,,0,0,0,,Сіз бен менің арамыздағы қашықтық
Dialogue: 0,0:01:50.00,0:01:52.00,Default,,0,0,0,,Ешқашан кетпеңіз
Dialogue: 0,0:01:52.00,0:01:54.00,Default,,0,0,0,,Тіпті айналма жолда
Dialogue: 0,0:01:54.00,0:01:58.00,Default,,0,0,0,,Мен оны бағалағым келеді
Dialogue: 0,0:02:10.00,0:02:11.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:02:11.00,0:02:12.00,Default,,0,0,0,,Иә
Dialogue: 0,0:02:12.00,0:02:14.00,Default,,0,0,0,,Сіз жынды сияқтысыз.
Dialogue: 0,0:02:14.00,0:02:16.00,Default,,0,0,0,,Сіз әдетте осылай сезінесіз бе?
Dialogue: 0,0:02:16.00,0:02:17.00,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:02:17.00,0:02:19.00,Default,,0,0,0,,Бірге суретке түсейік
Dialogue: 0,0:02:19.00,0:02:21.00,Default,,0,0,0,,(Юки) Бірақ Хори, сен мықтысың ғой, иә? (Хидэ Иура) Һмм…
Dialogue: 0,0:02:21.00,0:02:23.00,Default,,0,0,0,,Аз ғана, аздап
Dialogue: 0,0:02:25.00,0:02:27.00,Default,,0,0,0,,Янако да көп жұмыс істейді.
Dialogue: 0,0:02:27.00,0:02:29.00,Default,,0,0,0,,Әдемі жігіт күткендей
Dialogue: 0,0:02:29.00,0:02:31.00,Default,,0,0,0,,Янако да сүйкімді
Dialogue: 0,0:02:31.00,0:02:33.00,Default,,0,0,0,,Мен де сүйкімдімін
Dialogue: 0,0:02:33.00,0:02:35.00,Default,,0,0,0,,Линда Сенпай
Dialogue: 0,0:02:35.00,0:02:37.00,Default,,0,0,0,,Линда-сенпай да
Dialogue: 0,0:02:37.00,0:02:39.00,Default,,0,0,0,,Нана-сенпайдың мені шақырғанын естідім.
Dialogue: 0,0:02:39.00,0:02:41.00,Default,,0,0,0,,Мен де жаңадан үйренгенім
Dialogue: 0,0:02:41.00,0:02:42.00,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:02:42.00,0:02:44.00,Default,,0,0,0,,Линда-сенпай да керемет.
Dialogue: 0,0:02:44.00,0:02:48.00,Default,,0,0,0,,Бұл өте эротикалық және салқын, байыпты.
Dialogue: 0,0:02:48.00,0:02:52.00,Default,,0,0,0,,Сондықтан жақыннан қарамаңыз деймін.
Dialogue: 0,0:02:52.00,0:02:54.00,Default,,0,0,0,,Президенттің телефон қоңырауы
Dialogue: 0,0:02:54.00,0:02:56.00,Default,,0,0,0,,Жай даяшы болу өте жаман
Dialogue: 0,0:02:56.00,0:02:58.00,Default,,0,0,0,,Тұру жақсы шешім.
Dialogue: 0,0:02:58.00,0:02:59.00,Default,,0,0,0,,Иә
Dialogue: 0,0:02:59.00,0:03:01.00,Default,,0,0,0,,Жасасаң, Байторио қайта
Dialogue: 0,0:03:01.00,0:03:08.00,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:08.00,0:03:09.00,Default,,0,0,0,,Тұру жақсы шешім.
Dialogue: 0,0:03:09.00,0:03:10.00,Default,,0,0,0,,Иә
Dialogue: 0,0:03:10.00,0:03:12.00,Default,,0,0,0,,Жасасаң, Байторио қайта
Dialogue: 0,0:03:12.00,0:03:14.00,Default,,0,0,0,,Мен сізбен сөйлесе аламын.
Dialogue: 0,0:03:14.00,0:03:15.00,Default,,0,0,0,,Икейана мырза
Dialogue: 0,0:03:15.00,0:03:18.00,Default,,0,0,0,,Жазғы демалыс кезіндегі іс-шараларға ақша табу
Dialogue: 0,0:03:18.00,0:03:21.00,Default,,0,0,0,,Мен бұл сен туралы деп ойладым.
Dialogue: 0,0:03:21.00,0:03:22.00,Default,,0,0,0,,Бізден басқа барлығы Сакурадзима-сенпайды ұмытып қалған болар.
Dialogue: 0,0:03:22.00,0:03:23.00,Default,,0,0,0,,Тоқта, балам.
Dialogue: 0,0:03:23.00,0:03:25.00,Default,,0,0,0,,Барлығы тәжірибе
Dialogue: 0,0:03:25.00,0:03:27.00,Default,,0,0,0,,Іскерлік тапсырыстар
Dialogue: 0,0:03:27.00,0:03:28.00,Default,,0,0,0,,Тез кел
Dialogue: 0,0:03:28.00,0:03:30.00,Default,,0,0,0,,А, мен мұны қазір істеймін.
Dialogue: 0,0:03:30.00,0:03:32.00,Default,,0,0,0,,Егер сіз ақша үшін бірдеңе жасасаңыз
Dialogue: 0,0:03:32.00,0:03:34.00,Default,,0,0,0,,Сәттілік, мырза.
Dialogue: 0,0:03:34.00,0:03:36.00,Default,,0,0,0,,Мен сенің батыр екеніңді қадағалаймын.
Dialogue: 0,0:03:36.00,0:03:38.00,Default,,0,0,0,,Оны көрудің қажеті жоқ.
Dialogue: 0,0:04:02.00,0:04:04.00,Default,,0,0,0,,Эй, сенің қызың бар.
Dialogue: 0,0:04:05.00,0:04:08.00,Default,,0,0,0,,Адамның махаббаты туралы не айтасыз?
Dialogue: 0,0:04:08.00,0:04:10.00,Default,,0,0,0,,Жоқ, сәл ғана.
Dialogue: 0,0:04:10.00,0:04:11.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:11.00,0:04:13.00,Default,,0,0,0,,Мен мұны осы жерде аздап қолданамын.
Dialogue: 0,0:04:13.00,0:04:14.00,Default,,0,0,0,,Мен аламын.
Dialogue: 0,0:04:14.00,0:04:15.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:04:17.00,0:04:19.00,Default,,0,0,0,,Кешіріңіз, көмегіңіз үшін рахмет.
Dialogue: 0,0:04:19.00,0:04:22.00,Default,,0,0,0,,Мен немқұрайлы болғандықтан, мен өз басымды пайдаланамын.
Dialogue: 0,0:04:22.00,0:04:24.00,Default,,0,0,0,,Маған қайтадан түбіртек керек.
Dialogue: 0,0:04:24.00,0:04:26.00,Default,,0,0,0,,Жоқ, мұндай атмосфераны бірінші рет бастан өткеруім.
Dialogue: 0,0:04:26.00,0:04:28.00,Default,,0,0,0,,Әйтеуір мас болып қалдым
Dialogue: 0,0:04:29.00,0:04:30.00,Default,,0,0,0,,Кілт – рух.
Dialogue: 0,0:04:30.00,0:04:32.00,Default,,0,0,0,,Мақтан тұт
Dialogue: 0,0:04:35.00,0:04:37.00,Default,,0,0,0,,Қайда қарап тұрсың?
Dialogue: 0,0:04:37.00,0:04:39.00,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:04:39.00,0:04:41.00,Default,,0,0,0,,Таку
Dialogue: 0,0:05:04.00,0:05:06.00,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:05:06.00,0:05:08.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:08.00,0:05:10.00,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:05:10.00,0:05:12.00,Default,,0,0,0,,Яна-сан
Dialogue: 0,0:05:12.00,0:05:14.00,Default,,0,0,0,,Сіз мұны істегенде өте қызық болған сияқтысыз.
Dialogue: 0,0:05:14.00,0:05:16.00,Default,,0,0,0,,Сіз осындай нәрсеге лайық болуыңыз мүмкін.
Dialogue: 0,0:05:16.00,0:05:18.00,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:05:18.00,0:05:20.00,Default,,0,0,0,,Әзірге айналаңыздағыларға
Dialogue: 0,0:05:20.00,0:05:22.00,Default,,0,0,0,,Өзіме еліктеуді айту
Dialogue: 0,0:05:22.00,0:05:24.00,Default,,0,0,0,,Мен мұны кездейсоқ жасадым.
Dialogue: 0,0:05:24.00,0:05:32.00,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:05:32.00,0:05:34.00,Default,,0,0,0,,Мен мұны кездейсоқ жасадым.
Dialogue: 0,0:05:34.00,0:05:37.00,Default,,0,0,0,,Толық емес сияқты.
Dialogue: 0,0:05:37.00,0:05:39.00,Default,,0,0,0,,Эй, Ванди де солай ойлайды.
Dialogue: 0,0:05:39.00,0:05:42.00,Default,,0,0,0,,Иә, Линда-сенпай дұрыс айтады.
Dialogue: 0,0:05:42.00,0:05:43.00,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:05:43.00,0:05:45.00,Default,,0,0,0,,Сәлем Линда
Dialogue: 0,0:05:45.00,0:05:47.00,Default,,0,0,0,,Маған қол ұшын беріңіз.
Dialogue: 0,0:05:47.00,0:05:49.00,Default,,0,0,0,,Yes
Dialogue: 0,0:05:50.00,0:05:52.00,Default,,0,0,0,,Бірақ ол қатты толқыды.
Dialogue: 0,0:05:52.00,0:05:54.00,Default,,0,0,0,,Денемді де шырышты етті
Dialogue: 0,0:05:54.00,0:05:56.00,Default,,0,0,0,,Сіз шынымен көңіл көтердіңіз бе?
Dialogue: 0,0:05:57.00,0:05:58.00,Default,,0,0,0,,That's right.
Dialogue: 0,0:05:58.00,0:06:01.00,Default,,0,0,0,,Мен өзімді соншалықты жаман сезінбеймін.
Dialogue: 0,0:06:02.00,0:06:07.00,Default,,0,0,0,,Мен осы жерді жандандыратын құрылғы сияқты әрекет етуге тырысамын.
Dialogue: 0,0:06:07.00,0:06:10.00,Default,,0,0,0,,Аа, мен түсіндім деп ойлаймын.
Dialogue: 0,0:06:16.00,0:06:19.00,Default,,0,0,0,,Янус мырза дұрыс айтты.
Dialogue: 0,0:06:19.00,0:06:22.00,Default,,0,0,0,,Бірақ бұл түн, Ваннидің өмірінен бөлек,
Dialogue: 0,0:06:22.00,0:06:25.00,Default,,0,0,0,,Бір қызығы мен үшін жаман емес
Dialogue: 0,0:06:25.00,0:06:29.00,Default,,0,0,0,,Ерекше кеңістікте өзіңізді басқа біреу ретінде жасыру
Dialogue: 0,0:06:29.00,0:06:32.00,Default,,0,0,0,,Жұмысты орындайтын жай ғана машина болу
Dialogue: 0,0:06:37.00,0:06:40.00,Default,,0,0,0,,Бұл өте жақсы, Линда-сенпай.
Dialogue: 0,0:06:41.00,0:06:44.00,Default,,0,0,0,,Менің сенімен келгенімді қалайсың ба?
Dialogue: 0,0:06:59.00,0:07:01.00,Default,,0,0,0,,Шаршадыңыз ба? Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:01.00,0:07:03.00,Default,,0,0,0,,Мен өте көңілді жүрмін
Dialogue: 0,0:07:03.00,0:07:05.00,Default,,0,0,0,,Мен оған тәуелді болып кететін сияқтымын.
Dialogue: 0,0:07:05.00,0:07:07.00,Default,,0,0,0,,Сабарудың арқасында болар.
Dialogue: 0,0:07:07.00,0:07:10.00,Default,,0,0,0,,Бұл менің президентке арналған іс-шарамен төртінші рет жұмыс істеуім.
Dialogue: 0,0:07:12.00,0:07:14.00,Default,,0,0,0,,Бұл екеуі өте сүйкімді
Dialogue: 0,0:07:14.00,0:07:16.00,Default,,0,0,0,,Мен акуланы ала аламын ба?
Dialogue: 0,0:07:16.00,0:07:18.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:21.00,0:07:22.00,Default,,0,0,0,,Жақсы атмосфера
Dialogue: 0,0:07:22.00,0:07:24.00,Default,,0,0,0,,Келесі - бұл
Dialogue: 0,0:07:24.00,0:07:26.00,Default,,0,0,0,,Жақсы атмосфера
Dialogue: 0,0:07:54.00,0:07:56.00,Default,,0,0,0,,О
Dialogue: 0,0:08:25.00,0:08:27.00,Default,,0,0,0,,Жоқ, Коуко-чан.
Dialogue: 0,0:08:27.00,0:08:29.00,Default,,0,0,0,,Сіз қате түсіндіңіз
Dialogue: 0,0:08:29.00,0:08:31.00,Default,,0,0,0,,Мен Линдамын.
Dialogue: 0,0:08:31.00,0:08:33.00,Default,,0,0,0,,Хайуши Нана
Dialogue: 0,0:08:34.00,0:08:36.00,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:08:36.00,0:08:37.00,Default,,0,0,0,,Мені шынымен кешіріңіз
Dialogue: 0,0:08:37.00,0:08:39.00,Default,,0,0,0,,Бұл тым ашулы болды.
Dialogue: 0,0:08:39.00,0:08:40.00,Default,,0,0,0,,Бұл менің кінәм болды
Dialogue: 0,0:08:40.00,0:08:41.00,Default,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:08:41.00,0:08:42.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:42.00,0:08:50.00,Default,,0,0,0,,Мен
Dialogue: 0,0:08:50.00,0:08:51.00,Default,,0,0,0,,Бұл өте қызықты болды
Dialogue: 0,0:08:51.00,0:08:52.00,Default,,0,0,0,,Бұл менің кінәм болды
Dialogue: 0,0:08:52.00,0:08:53.00,Default,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:08:53.00,0:08:55.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:55.00,0:08:57.00,Default,,0,0,0,,Тұтынушылардың алдында шу шығармаңыз
Dialogue: 0,0:08:57.00,0:08:59.00,Default,,0,0,0,,Қарашы, Киран.
Dialogue: 0,0:09:01.00,0:09:03.00,Default,,0,0,0,,Кага-сан мұнда кел
Dialogue: 0,0:09:10.00,0:09:12.00,Default,,0,0,0,,Қалай болғанда да, мен қазір толық емес жұмыс күнімен жұмыс істеймін.
Dialogue: 0,0:09:12.00,0:09:14.00,Default,,0,0,0,,Мен оны кейінірек түсіндіремін.
Dialogue: 0,0:09:14.00,0:09:16.00,Default,,0,0,0,,Жұмыс біткенше күтіңіз
Dialogue: 0,0:09:16.00,0:09:18.00,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:09:18.00,0:09:19.00,Default,,0,0,0,,Қатаң болса да
Dialogue: 0,0:09:19.00,0:09:22.00,Default,,0,0,0,,Мен мұнда қала алмаймын.
Dialogue: 0,0:09:22.00,0:09:23.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:23.00,0:09:25.00,Default,,0,0,0,,Менің бөлмем
Dialogue: 0,0:09:25.00,0:09:28.00,Default,,0,0,0,,Енді сен менің бөлмемдесің
Dialogue: 0,0:09:28.00,0:09:31.00,Default,,0,0,0,,Біткен кезде мен бар жылдамдықпен қайтамын.
Dialogue: 0,0:09:49.00,0:09:51.00,Default,,0,0,0,,Жер
Dialogue: 0,0:09:51.00,0:09:53.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:59.00,0:10:00.00,Default,,0,0,0,,Жер
Dialogue: 0,0:10:00.00,0:10:02.00,Default,,0,0,0,,Иә
Dialogue: 0,0:10:09.00,0:10:10.00,Default,,0,0,0,,Келесі
Dialogue: 0,0:10:10.00,0:10:12.00,Default,,0,0,0,,Тадабанрикун
Dialogue: 0,0:10:12.00,0:10:14.00,Default,,0,0,0,,Иә
Dialogue: 0,0:10:14.00,0:10:16.00,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:10:16.00,0:10:17.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:17.00,0:10:19.00,Default,,0,0,0,,Онда біраз нәрсе болды.
Dialogue: 0,0:10:19.00,0:10:22.00,Default,,0,0,0,,Менің ойымша, бұл мені жаздан өте алады
Dialogue: 0,0:10:22.00,0:10:23.00,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:10:23.00,0:10:26.00,Default,,0,0,0,,Мен оны пайдалануды жоғалтқан шығармын.
Dialogue: 0,0:10:28.00,0:10:29.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:29.00,0:10:31.00,Default,,0,0,0,,Кага-санға электрондық пошта
Dialogue: 0,0:11:17.00,0:11:19.00,Default,,0,0,0,,Кага-сан
Dialogue: 0,0:11:26.00,0:11:28.00,Default,,0,0,0,,Кага-сан
Dialogue: 0,0:11:28.00,0:11:29.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:11:29.00,0:11:30.00,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:11:30.00,0:11:31.00,Default,,0,0,0,,Алкогольді ішу
Dialogue: 0,0:11:31.00,0:11:33.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:33.00,0:11:35.00,Default,,0,0,0,,Мен де соқтым
Dialogue: 0,0:11:35.00,0:11:37.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:37.00,0:11:39.00,Default,,0,0,0,,Менің шашым әлі жазылмады.
Dialogue: 0,0:11:39.00,0:11:41.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:41.00,0:11:43.00,Default,,0,0,0,,Кага-сан
Dialogue: 0,0:11:43.00,0:11:45.00,Default,,0,0,0,,Бұлай жасамаңыз
Dialogue: 0,0:11:45.00,0:11:47.00,Default,,0,0,0,,Мен жақсы қыз болғым келді
Dialogue: 0,0:11:47.00,0:11:49.00,Default,,0,0,0,,Ол қайтадан жұмыс істемеді.
Dialogue: 0,0:11:49.00,0:11:50.00,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:11:50.00,0:11:52.00,Default,,0,0,0,,Бұл жақсы болмады.
Dialogue: 0,0:11:54.00,0:11:55.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:55.00,0:11:57.00,Default,,0,0,0,,Нацуки, ояндың ба әлі?
Dialogue: 0,0:11:57.00,0:11:59.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:59.00,0:12:02.00,Default,,0,0,0,,Мен Кага-санды теңізге апарғым келді.
Dialogue: 0,0:12:02.00,0:12:04.00,Default,,0,0,0,,Жақсылық сұрама
Dialogue: 0,0:12:04.00,0:12:07.00,Default,,0,0,0,,Мен жігіт сияқты салқын көрінгім келді
Dialogue: 0,0:12:07.00,0:12:09.00,Default,,0,0,0,,Сондықтан мен Кага-санға өтірік айттым.
Dialogue: 0,0:12:09.00,0:12:11.00,Default,,0,0,0,,Линда-сенпайдың қасымда екенін білмедім.
Dialogue: 0,0:12:11.00,0:12:13.00,Default,,0,0,0,,Бірақ мен жұмыс істеген кезде
Dialogue: 0,0:12:13.00,0:12:15.00,Default,,0,0,0,,Әйтеуір атмосфера мені таң қалдырды.
Dialogue: 0,0:12:15.00,0:12:17.00,Default,,0,0,0,,Менің шиеленісуім өзгерді
Dialogue: 0,0:12:17.00,0:12:19.00,Default,,0,0,0,,Міне, солай болды
Dialogue: 0,0:12:19.00,0:12:20.00,Default,,0,0,0,,Міне
Dialogue: 0,0:12:20.00,0:12:22.00,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:12:22.00,0:12:24.00,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:12:24.00,0:12:25.00,Default,,0,0,0,,Өтірік айтқаным үшін кешіріңіз
Dialogue: 0,0:12:25.00,0:12:27.00,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:12:29.00,0:12:30.00,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:12:30.00,0:12:32.00,Default,,0,0,0,,Джанандри
Dialogue: 0,0:12:32.00,0:12:36.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:36.00,0:12:38.00,Default,,0,0,0,,Тек солай деп айтыңыз.
Dialogue: 0,0:12:40.00,0:12:41.00,Default,,0,0,0,,Өтірік
Dialogue: 0,0:12:41.00,0:12:43.00,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:12:48.00,0:12:50.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:53.00,0:12:56.00,Default,,0,0,0,,Линда-сенпай
Dialogue: 0,0:12:56.00,0:12:58.00,Default,,0,0,0,,Есімді жоғалтқанға дейін
Dialogue: 0,0:12:58.00,0:13:00.00,Default,,0,0,0,,Біз сыныптас болдық.
Dialogue: 0,0:13:00.00,0:13:02.00,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:13:02.00,0:13:04.00,Default,,0,0,0,,Есімді жоғалтқанға дейін
Dialogue: 0,0:13:04.00,0:13:06.00,Default,,0,0,0,,Біз сыныптас болдық.
Dialogue: 0,0:13:06.00,0:13:08.00,Default,,0,0,0,,Бір сыныпта
Dialogue: 0,0:13:08.00,0:13:10.00,Default,,0,0,0,,Сол жеңіл атлетика бөлімінде
Dialogue: 0,0:13:10.00,0:13:12.00,Default,,0,0,0,,Біз дос болдық
Dialogue: 0,0:13:13.00,0:13:16.00,Default,,0,0,0,,Мен Линданы ұмытып кетіппін
Dialogue: 0,0:13:16.00,0:13:18.00,Default,,0,0,0,,Біз университетте кездейсоқ кездестік.
Dialogue: 0,0:13:18.00,0:13:20.00,Default,,0,0,0,,Әрине Линда
Dialogue: 0,0:13:20.00,0:13:22.00,Default,,0,0,0,,Мені бірден біл
Dialogue: 0,0:13:22.00,0:13:24.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:13:24.00,0:13:26.00,Default,,0,0,0,,Шатасып кетпес үшін
Dialogue: 0,0:13:28.00,0:13:29.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:29.00,0:13:31.00,Default,,0,0,0,,Сіз маған айтқан жоқсыз.
Dialogue: 0,0:13:32.00,0:13:35.00,Default,,0,0,0,,Өйткені мен Кага-санның білгенін қаламадым.
Dialogue: 0,0:13:36.00,0:13:38.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:38.00,0:13:39.00,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:13:39.00,0:13:41.00,Default,,0,0,0,,Жад жоғалмас бұрын
Dialogue: 0,0:13:41.00,0:13:43.00,Default,,0,0,0,,Линда туралы
Dialogue: 0,0:13:43.00,0:13:45.00,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:13:45.00,0:13:46.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:13:46.00,0:13:49.00,Default,,0,0,0,,Мен сенің бұл туралы алаңдағаныңды қаламадым.
Dialogue: 0,0:13:50.00,0:13:52.00,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:13:52.00,0:13:54.00,Default,,0,0,0,,Өйткені мен тітіркендіргіш әйелмін
Dialogue: 0,0:13:54.00,0:13:55.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:55.00,0:13:57.00,Default,,0,0,0,,Біреу шу шығарса
Dialogue: 0,0:13:57.00,0:13:59.00,Default,,0,0,0,,Себебі мен бұл қиындық туғызады деп ойладым.
Dialogue: 0,0:14:00.00,0:14:02.00,Default,,0,0,0,,Өйткені менің бір ісім бар.
Dialogue: 0,0:14:05.00,0:14:07.00,Default,,0,0,0,,Сезімдерім қайта тірілетін кездер болады.
Dialogue: 0,0:14:08.00,0:14:10.00,Default,,0,0,0,,Кенеттен еске түсіру сияқты
Dialogue: 0,0:14:12.00,0:14:13.00,Default,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,0:14:14.00,0:14:16.00,Default,,0,0,0,,Мен бұл туралы өзім ештеңе істей алмаймын.
Dialogue: 0,0:14:17.00,0:14:19.00,Default,,0,0,0,,Ол Линдаға қайтқысы келеді.
Dialogue: 0,0:14:19.00,0:14:21.00,Default,,0,0,0,,Жан
Dialogue: 0,0:14:21.00,0:14:23.00,Default,,0,0,0,,Өмір дауыл сияқты
Dialogue: 0,0:14:23.00,0:14:25.00,Default,,0,0,0,,Жылайтын кездерім болады.
Dialogue: 0,0:14:29.00,0:14:31.00,Default,,0,0,0,,Менің жадым оралмаса да
Dialogue: 0,0:14:31.00,0:14:32.00,Default,,0,0,0,,Тек эмоциялар
Dialogue: 0,0:14:32.00,0:14:35.00,Default,,0,0,0,,Мен тек Линдаға оралғым келеді.
Dialogue: 0,0:14:35.00,0:14:37.00,Default,,0,0,0,,Кенет қайта жанданды
Dialogue: 0,0:14:38.00,0:14:40.00,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:14:45.00,0:14:47.00,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:14:48.00,0:14:49.00,Default,,0,0,0,,Кага-сан
Dialogue: 0,0:14:50.00,0:14:52.00,Default,,0,0,0,,Мен жақсы қыз болғым келді
Dialogue: 0,0:14:52.00,0:14:54.00,Default,,0,0,0,,Тіпті фотосуретті тапқан кезде де
Dialogue: 0,0:14:54.00,0:14:58.00,Default,,0,0,0,,Мен Тада-кунның сенімен сөйлесуін күтуің керек деп ойладым.
Dialogue: 0,0:14:58.00,0:15:00.00,Default,,0,0,0,,Сұрақ қою
Dialogue: 0,0:15:00.00,0:15:02.00,Default,,0,0,0,,Психикалық тұрақсыз болу
Dialogue: 0,0:15:02.00,0:15:04.00,Default,,0,0,0,,Мен мұны тоқтатуды шештім.
Dialogue: 0,0:15:05.00,0:15:06.00,Default,,0,0,0,,Мен күш салдым.
Dialogue: 0,0:15:06.00,0:15:07.00,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,0:15:07.00,0:15:09.00,Default,,0,0,0,,Мен барынша тырыстым
Dialogue: 0,0:15:09.00,0:15:10.00,Default,,0,0,0,,Кага-сан
Dialogue: 0,0:15:10.00,0:15:12.00,Default,,0,0,0,,Бірақ егер бұлай десеңіз, мен
Dialogue: 0,0:15:12.00,0:15:14.00,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:15:14.00,0:15:16.00,Default,,0,0,0,,Мұның бәрі бекер.
Dialogue: 0,0:15:16.00,0:15:18.00,Default,,0,0,0,,Жаман болып қалды.
Dialogue: 0,0:15:18.00,0:15:20.00,Default,,0,0,0,,Қараңызшы, мынандай.
Dialogue: 0,0:15:20.00,0:15:22.00,Default,,0,0,0,,Менде осылай болып жатыр
Dialogue: 0,0:15:23.00,0:15:25.00,Default,,0,0,0,,Енді не істеуім керек?
Dialogue: 0,0:15:25.00,0:15:27.00,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:15:27.00,0:15:28.00,Default,,0,0,0,,Мынаны ал, «Aerosmith»!
Dialogue: 0,0:15:29.00,0:15:30.00,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:15:32.00,0:15:34.00,Default,,0,0,0,,Неге олай дедің?
Dialogue: 0,0:15:35.00,0:15:36.00,Default,,0,0,0,,Эй
Dialogue: 0,0:15:36.00,0:15:37.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:37.00,0:15:39.00,Default,,0,0,0,,Маған не үшін айттың?
Dialogue: 0,0:15:40.00,0:15:41.00,Default,,0,0,0,,Кага-санға
Dialogue: 0,0:15:41.00,0:15:43.00,Default,,0,0,0,,Мен шыншыл болғым келді.
Dialogue: 0,0:15:43.00,0:15:45.00,Default,,0,0,0,,Менің өлгім келмеді
Dialogue: 0,0:15:49.00,0:15:50.00,Default,,0,0,0,,Кага-сан күт
Dialogue: 0,0:15:51.00,0:15:52.00,Default,,0,0,0,,Тада-кун
Dialogue: 0,0:15:52.00,0:15:53.00,Default,,0,0,0,,Бұл дауыл
Dialogue: 0,0:15:54.00,0:15:55.00,Default,,0,0,0,,Дауыл сияқты
Dialogue: 0,0:15:56.00,0:15:58.00,Default,,0,0,0,,менің жүрегімді алаңдатады
Dialogue: 0,0:16:01.00,0:16:02.00,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:16:02.00,0:16:04.00,Default,,0,0,0,,Еске салма
Dialogue: 0,0:16:04.00,0:16:05.00,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:16:05.00,0:16:07.00,Default,,0,0,0,,Өткенді еске түсірме
Dialogue: 0,0:16:10.00,0:16:11.00,Default,,0,0,0,,Бір ғана
Dialogue: 0,0:16:11.00,0:16:13.00,Default,,0,0,0,,Менің сенен қалайтыным сол
Dialogue: 0,0:16:13.00,0:16:15.00,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:16:15.00,0:16:16.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:16.00,0:16:17.00,Default,,0,0,0,,Солай етіңіз
Dialogue: 0,0:16:22.00,0:16:23.00,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:16:23.00,0:16:25.00,Default,,0,0,0,,Сіз мені Банди деп атай аласыз.
Dialogue: 0,0:16:27.00,0:16:28.00,Default,,0,0,0,,Мен туралы
Dialogue: 0,0:16:28.00,0:16:30.00,Default,,0,0,0,,Ол мені Коко деп атайды.
Dialogue: 0,0:16:30.00,0:16:31.00,Default,,0,0,0,,О
Dialogue: 0,0:16:31.00,0:16:32.00,Default,,0,0,0,,Коко
Dialogue: 0,0:16:34.00,0:16:35.00,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:16:36.00,0:16:38.00,Default,,0,0,0,,Сен мені неге Коко дейсің?
Dialogue: 0,0:16:38.00,0:16:39.00,Default,,0,0,0,,Мен туралы
Dialogue: 0,0:16:39.00,0:16:41.00,Default,,0,0,0,,Ол мені Коко деп атайды.
Dialogue: 0,0:16:42.00,0:16:43.00,Default,,0,0,0,,Коко
Dialogue: 0,0:16:43.00,0:16:44.00,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:16:44.00,0:16:46.00,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:16:46.00,0:16:47.00,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:16:48.00,0:16:49.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:49.00,0:16:50.00,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:16:50.00,0:16:51.00,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:16:52.00,0:16:53.00,Default,,0,0,0,,Жоспар
Dialogue: 0,0:16:53.00,0:16:55.00,Default,,0,0,0,,Мен Коконы жақсы көремін
Dialogue: 0,0:16:57.00,0:16:59.00,Default,,0,0,0,,Мен қорқыныштымын, солай емес пе?
Dialogue: 0,0:16:59.00,0:17:00.00,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:17:00.00,0:17:01.00,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:17:01.00,0:17:03.00,Default,,0,0,0,,Менің макияжым толығымен жойылмаған сияқты.
Dialogue: 0,0:17:07.00,0:17:08.00,Default,,0,0,0,,Таң атқанда
Dialogue: 0,0:17:08.00,0:17:10.00,Default,,0,0,0,,Макияжды автоматты түрде қолданыңыз және дүкенге бармаңыз
Dialogue: 0,0:17:11.00,0:17:13.00,Default,,0,0,0,,Оны осы бөлмеде қалдырыңыз.
Dialogue: 0,0:17:13.00,0:17:14.00,Default,,0,0,0,,Мен түнеген кезде
Dialogue: 0,0:17:14.00,0:17:17.00,Default,,0,0,0,,Мен оны қолданамын деп ойлаймын.
Dialogue: 0,0:17:19.00,0:17:20.00,Default,,0,0,0,,Коко
Dialogue: 0,0:17:24.00,0:17:25.00,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:17:25.00,0:17:26.00,Default,,0,0,0,,Банди
Dialogue: 0,0:17:26.00,0:17:28.00,Default,,0,0,0,,Мен уайымдаймын
Dialogue: 0,0:17:28.00,0:17:29.00,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:17:29.00,0:17:30.00,Default,,0,0,0,,Түсінеді
Dialogue: 0,0:17:33.00,0:17:35.00,Default,,0,0,0,,Мен қатты уайымдаймын.
Dialogue: 0,0:17:35.00,0:17:36.00,Default,,0,0,0,,Өйткені
Dialogue: 0,0:17:36.00,0:17:37.00,Default,,0,0,0,,Бізде
Dialogue: 0,0:17:37.00,0:17:39.00,Default,,0,0,0,,Ештеңе жоқ.
Dialogue: 0,0:17:40.00,0:17:42.00,Default,,0,0,0,,Уақыт жеткіліксіз
Dialogue: 0,0:17:42.00,0:17:44.00,Default,,0,0,0,,Тәжірибенің болмауы
Dialogue: 0,0:17:44.00,0:17:46.00,Default,,0,0,0,,Менде ешқандай естелік жоқ
Dialogue: 0,0:17:46.00,0:17:48.00,Default,,0,0,0,,Фотосуреттер жоқ
Dialogue: 0,0:17:58.00,0:17:59.00,Default,,0,0,0,,Егер
Dialogue: 0,0:17:59.00,0:18:01.00,Default,,0,0,0,,Фотоға түсеміз бе?
Dialogue: 0,0:18:02.00,0:18:05.00,Default,,0,0,0,,Мен де Кокомен суретке түскім келеді.
Dialogue: 0,0:18:05.00,0:18:06.00,Default,,0,0,0,,Біз
Dialogue: 0,0:18:06.00,0:18:08.00,Default,,0,0,0,,Осы жерден дұрыстап бастайық.
Dialogue: 0,0:18:09.00,0:18:12.00,Default,,0,0,0,,Ештеңені асықтырудың қажеті жоқ.
Dialogue: 0,0:18:12.00,0:18:13.00,Default,,0,0,0,,Мен түкке тұрғысыз болғандықтан
Dialogue: 0,0:18:13.00,0:18:15.00,Default,,0,0,0,,Мен сені күштеп алғым келмейді.
Dialogue: 0,0:18:17.00,0:18:18.00,Default,,0,0,0,,Иә
Dialogue: 0,0:18:22.00,0:18:23.00,Default,,0,0,0,,Чад Банди
Dialogue: 0,0:18:25.00,0:18:26.00,Default,,0,0,0,,Артық
Dialogue: 0,0:18:26.00,0:18:27.00,Default,,0,0,0,,Тека
Dialogue: 0,0:18:27.00,0:18:28.00,Default,,0,0,0,,Кешкі бөлме үшін кешіріңіз
Dialogue: 0,0:18:28.00,0:18:30.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:30.00,0:18:31.00,Default,,0,0,0,,О, мен не істеуім керек?
Dialogue: 0,0:18:31.00,0:18:33.00,Default,,0,0,0,,Коко-чан ашуланды, солай ма?
Dialogue: 0,0:18:33.00,0:18:35.00,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:18:35.00,0:18:36.00,Default,,0,0,0,,Шынымды айтсам
Dialogue: 0,0:18:36.00,0:18:38.00,Default,,0,0,0,,Шынымды айтсам, мен сорамын
Dialogue: 0,0:18:38.00,0:18:39.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:39.00,0:18:41.00,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:18:41.00,0:18:43.00,Default,,0,0,0,,Коконың жағдайы жақсы.
Dialogue: 0,0:18:43.00,0:18:44.00,Default,,0,0,0,,Шынымен
Dialogue: 0,0:18:45.00,0:18:46.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:46.00,0:18:47.00,Default,,0,0,0,,Олай болса неге әуре?
Dialogue: 0,0:18:47.00,0:18:49.00,Default,,0,0,0,,Менің үйіме жақындап қалды.
Dialogue: 0,0:18:53.00,0:18:54.00,Default,,0,0,0,,Әңгіме дегеніміз не?
Dialogue: 0,0:18:54.00,0:18:56.00,Default,,0,0,0,,Бұл баяғыда болды
Dialogue: 0,0:18:56.00,0:18:57.00,Default,,0,0,0,,Баяғыда
Dialogue: 0,0:18:57.00,0:19:00.00,Default,,0,0,0,,Біз кездескен жоқпыз.
Dialogue: 0,0:19:00.00,0:19:03.00,Default,,0,0,0,,Линда-сенпай осылай деді, солай ма?
Dialogue: 0,0:19:03.00,0:19:04.00,Default,,0,0,0,,Иә
Dialogue: 0,0:19:04.00,0:19:05.00,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:05.00,0:19:07.00,Default,,0,0,0,,Мен ағамды жақсы көремін.
Dialogue: 0,0:19:07.00,0:19:09.00,Default,,0,0,0,,Бірақ аға
Dialogue: 0,0:19:09.00,0:19:12.00,Default,,0,0,0,,Линда мені ұнатпады
Dialogue: 0,0:19:13.00,0:19:14.00,Default,,0,0,0,,Иә
Dialogue: 0,0:19:14.00,0:19:16.00,Default,,0,0,0,,Романтикалық мағынада
Dialogue: 0,0:19:17.00,0:19:19.00,Default,,0,0,0,,Сен менің досым болдың
Dialogue: 0,0:19:19.00,0:19:21.00,Default,,0,0,0,,Бұл махаббат емес еді
Dialogue: 0,0:19:21.00,0:19:25.00,Default,,0,0,0,,Сен маған ұнамадың
Dialogue: 0,0:19:27.00,0:19:29.00,Default,,0,0,0,,Мен мұны растағым келді.
Dialogue: 0,0:19:36.00,0:19:37.00,Default,,0,0,0,,Сіз естідіңіз бе?
Dialogue: 0,0:19:37.00,0:19:40.00,Default,,0,0,0,,Линда сіздің қайтып келетін жеріңіз емес.
Dialogue: 0,0:19:41.00,0:19:43.00,Default,,0,0,0,,Сіз қаншалықты күшті сезінсеңіз де
Dialogue: 0,0:19:43.00,0:19:45.00,Default,,0,0,0,,Бұл бір жақты көше
Dialogue: 0,0:19:46.00,0:19:47.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:19:47.00,0:19:49.00,Default,,0,0,0,,Оны қазірдің өзінде ұмытыңыз
Dialogue: 0,0:19:49.00,0:19:50.00,Default,,0,0,0,,Кесу
Dialogue: 0,0:19:50.00,0:19:51.00,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:19:51.00,0:19:52.00,Default,,0,0,0,,Маған Линда ұнайды
Dialogue: 0,0:19:52.00,0:19:54.00,Default,,0,0,0,,Мен Линданың қасында болғым келеді
Dialogue: 0,0:19:55.00,0:19:58.00,Default,,0,0,0,,Шынымен
Dialogue: 0,0:19:58.00,0:20:00.00,Default,,0,0,0,,Мен Линданы іздедім
Dialogue: 0,0:20:00.00,0:20:03.00,Default,,0,0,0,,Мен Линданың жағына қайтқым келді.
Dialogue: 0,0:20:06.00,0:20:07.00,Default,,0,0,0,,На
Dialogue: 0,0:20:13.00,0:20:15.00,Default,,0,0,0,,Барлық көмектеріңіз үшін рахмет.
Dialogue: 0,0:20:15.00,0:20:17.00,Default,,0,0,0,,Бірақ қазірден бастап
Dialogue: 0,0:20:17.00,0:20:19.00,Default,,0,0,0,,Сіз мені танисыз
Dialogue: 0,0:20:19.00,0:20:21.00,Default,,0,0,0,,Мен мұның бәрі жойылғанын қалаймын.
Dialogue: 0,0:20:23.00,0:20:25.00,Default,,0,0,0,,Бұл стресс.
Dialogue: 0,0:20:25.00,0:20:27.00,Default,,0,0,0,,Өзіңізді амнезия бар деп санайсыз ба?
Dialogue: 0,0:20:27.00,0:20:29.00,Default,,0,0,0,,Мен бұл туралы білгім келмейді.
Dialogue: 0,0:20:29.00,0:20:30.00,Default,,0,0,0,,Мен
Dialogue: 0,0:20:30.00,0:20:32.00,Default,,0,0,0,,Мен өткеннен құтылғым келеді.
Dialogue: 0,0:20:32.00,0:20:33.00,Default,,0,0,0,,Қазірдің өзінде
Dialogue: 0,0:20:33.00,0:20:35.00,Default,,0,0,0,,Бұрынғы сыныптасы жоқ
Dialogue: 0,0:20:36.00,0:20:39.00,Default,,0,0,0,,Бұдан былай үйірмеде тек үлкендер мен кішілер боламыз.
Dialogue: 0,0:20:39.00,0:20:42.00,Default,,0,0,0,,Маған назар аударуыңыздың қажеті жоқ.
Dialogue: 0,0:20:44.00,0:20:45.00,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:20:45.00,0:20:47.00,Default,,0,0,0,,Шынымды айтсам, Коуко Линда-сенпай.
Dialogue: 0,0:20:47.00,0:20:49.00,Default,,0,0,0,,Мен аздап алаңдаймын.
Dialogue: 0,0:20:49.00,0:20:50.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:20:50.00,0:20:53.00,Default,,0,0,0,,Мен сізден өзімді анық алғым келеді.
Dialogue: 0,0:20:53.00,0:20:57.00,Default,,0,0,0,,Мен оған жақсы көңіл бөлгім келеді.
Dialogue: 0,0:20:57.00,0:21:00.00,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:21:00.00,0:21:02.00,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:21:02.00,0:21:04.00,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:21:04.00,0:21:05.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:05.00,0:21:07.00,Default,,0,0,0,,Сізге керек
Dialogue: 0,0:21:22.00,0:21:24.00,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:21:24.00,0:21:26.00,Default,,0,0,0,,Бэнли
Dialogue: 0,0:21:26.00,0:21:28.00,Default,,0,0,0,,Мұның бәрі керісінше.
Dialogue: 0,0:21:28.00,0:21:30.00,Default,,0,0,0,,Бэнли
Dialogue: 0,0:21:33.00,0:21:35.00,Default,,0,0,0,,Мен қайтадан суретке түсіп жатырмын
Dialogue: 0,0:21:35.00,0:21:37.00,Default,,0,0,0,,Оны тоқтатыңыз, себебі бұл табиғи емес
Dialogue: 0,0:21:37.00,0:21:38.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:21:38.00,0:21:40.00,Default,,0,0,0,,Мен сурет салмаймын.
Dialogue: 0,0:21:40.00,0:21:41.00,Default,,0,0,0,,Егер сіз мұны істесеңіз
Dialogue: 0,0:21:41.00,0:21:43.00,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:21:45.00,0:21:47.00,Default,,0,0,0,,Сәлем Коуко
Dialogue: 0,0:21:47.00,0:21:49.00,Default,,0,0,0,,Сыртта суретке түспеу керек пе?
Dialogue: 0,0:21:49.00,0:21:50.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:50.00,0:21:52.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:52.00,0:21:54.00,Default,,0,0,0,,Бэнли тез
Dialogue: 0,0:21:54.00,0:21:56.00,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:22:02.00,0:22:03.00,Default,,0,0,0,,Бан
Dialogue: 0,0:22:33.00,0:23:11.00,Default,,0,0,0,,Бан
Dialogue: 0,0:23:40.00,0:23:41.00,Default,,0,0,0,,Ерте!?
Dialogue: 0,0:23:42.50,0:23:47.50,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
