Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Линдер, бұл баяу.
Dialogue: 0,0:00:07.00,0:00:09.00,Default,,0,0,0,,Біз шынымен жақсы доспыз ғой, солай ма?
Dialogue: 0,0:00:09.00,0:00:11.00,Default,,0,0,0,,Линдер-сенпай және Ванлей-сенпай
Dialogue: 0,0:00:12.00,0:00:14.00,Default,,0,0,0,,Біз күнде үйге бірге барамыз.
Dialogue: 0,0:00:14.00,0:00:17.00,Default,,0,0,0,,Мен олар міндетті түрде кездесіп жүр деп ойладым.
Dialogue: 0,0:00:17.00,0:00:19.00,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:00:19.00,0:00:21.00,Default,,0,0,0,,Балалар сендер сондайсыңдар.
Dialogue: 0,0:00:21.00,0:00:23.00,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:00:23.00,0:00:25.00,Default,,0,0,0,,Мен салмақпын
Dialogue: 0,0:00:25.00,0:00:28.00,Default,,0,0,0,,Қараңызшы, Бэнли сенімсіз.
Dialogue: 0,0:00:28.00,0:00:30.00,Default,,0,0,0,,Сондықтан мен оны жалғыз қалдыра алмаймын.
Dialogue: 0,0:00:30.00,0:00:32.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:32.00,0:00:35.00,Default,,0,0,0,,Басқаша айтқанда, маған Бэнли-сенпай ұнайды, сондықтан мен оны жалғыз қалдыруым керек.
Dialogue: 0,0:00:35.00,0:00:37.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:37.00,0:00:40.00,Default,,0,0,0,,Біріншіден, мен оны адам ретінде көрмеймін.
Dialogue: 0,0:00:40.00,0:00:41.00,Default,,0,0,0,,Қазірше сау бол,
Dialogue: 0,0:00:41.00,0:00:43.00,Default,,0,0,0,,Маған ұнайды, солай емес пе?
Dialogue: 0,0:00:43.00,0:00:45.00,Default,,0,0,0,,Кеше болған жайтқа әлі де алаңдайсың ба?
Dialogue: 0,0:00:45.00,0:00:47.00,Default,,0,0,0,,Маған ол жігіт мүлде ұнамайды.
Dialogue: 0,0:00:49.00,0:00:51.00,Default,,0,0,0,,Қараңдар, мен қазір үйге бара жатырмын.
Dialogue: 0,0:00:51.00,0:00:53.00,Default,,0,0,0,,Бэнли күт
Dialogue: 0,0:01:01.00,0:01:03.00,Default,,0,0,0,,Оссу Бэнли
Dialogue: 0,0:01:05.00,0:01:07.00,Default,,0,0,0,,Сәлем Бэнли
Dialogue: 0,0:01:21.00,0:01:23.00,Default,,0,0,0,,Сәлем Ванли
Dialogue: 0,0:01:27.00,0:01:29.00,Default,,0,0,0,,Бэнли
Dialogue: 0,0:01:29.00,0:01:31.00,Default,,0,0,0,,Бұл жақында болды.
Dialogue: 0,0:01:34.00,0:01:37.00,Default,,0,0,0,,Маған ол жігіт мүлде ұнамайды.
Dialogue: 0,0:01:46.00,0:01:49.00,Default,,0,0,0,,Иә, қызмет
Dialogue: 0,0:01:49.00,0:01:51.00,Default,,0,0,0,,Иә, суық.
Dialogue: 0,0:02:05.00,0:02:07.00,Default,,0,0,0,,Барлығы
Dialogue: 0,0:02:07.00,0:02:09.00,Default,,0,0,0,,Бұл керісінше, Бэнли.
Dialogue: 0,0:02:10.00,0:02:12.00,Default,,0,0,0,,Мен
Dialogue: 0,0:02:12.00,0:02:15.00,Default,,0,0,0,,Кейде мен сондай ақымақпын
Dialogue: 0,0:02:15.00,0:02:17.00,Default,,0,0,0,,Мен ақымақпын
Dialogue: 0,0:02:18.00,0:02:20.00,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:02:23.00,0:02:25.00,Default,,0,0,0,,Сенің әкең Эден мектебінің түлегі ғой, иә?
Dialogue: 0,0:02:25.00,0:02:27.00,Default,,0,0,0,,Линданың маған да қатысы жоқ.
Dialogue: 0,0:02:27.00,0:02:29.00,Default,,0,0,0,,Маған мүлдем ұнамайды.
Dialogue: 0,0:02:29.00,0:02:31.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:31.00,0:02:33.00,Default,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:02:33.00,0:02:34.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:34.00,0:02:36.00,Default,,0,0,0,,Бэнли
Dialogue: 0,0:02:37.00,0:02:39.00,Default,,0,0,0,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:02:41.00,0:02:43.00,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:02:44.00,0:02:46.00,Default,,0,0,0,,Иә
Dialogue: 0,0:02:47.00,0:02:48.00,Default,,0,0,0,,Осы уақытта
Dialogue: 0,0:02:48.00,0:02:51.00,Default,,0,0,0,,Менің жүрегімде от жағылды деп ойлаймын.
Dialogue: 0,0:02:51.00,0:02:53.00,Default,,0,0,0,,Линда
Dialogue: 0,0:02:53.00,0:02:56.00,Default,,0,0,0,,Ол мені мүлде ұнатпайтынын айтты.
Dialogue: 0,0:02:56.00,0:02:58.00,Default,,0,0,0,,Сөз болса
Dialogue: 0,0:02:58.00,0:03:01.00,Default,,0,0,0,,Менің шынайы сезімдерім керісінше болса ше?
Dialogue: 0,0:03:02.00,0:03:04.00,Default,,0,0,0,,Жер
Dialogue: 0,0:03:04.00,0:03:06.00,Default,,0,0,0,,Линда
Dialogue: 0,0:03:17.00,0:03:19.00,Default,,0,0,0,,Мен енді ұмытпаймын
Dialogue: 0,0:03:27.00,0:03:30.00,Default,,0,0,0,,Мен қайдамын?
Dialogue: 0,0:03:30.00,0:03:33.00,Default,,0,0,0,,Ересек болу қиын.
Dialogue: 0,0:03:33.00,0:03:36.00,Default,,0,0,0,,Мен оны әзірше ұмыта аламын ба?
Dialogue: 0,0:03:36.00,0:03:39.00,Default,,0,0,0,,Өйткені түн күтіп тұр
Dialogue: 0,0:03:39.00,0:03:41.00,Default,,0,0,0,,Жүрегіңді соғу
Dialogue: 0,0:03:41.00,0:03:43.00,Default,,0,0,0,,Біз қашан кездесе аламыз
Dialogue: 0,0:03:43.00,0:03:46.00,Default,,0,0,0,,Егер сіз ойнасаңыз
Dialogue: 0,0:03:46.00,0:03:48.00,Default,,0,0,0,,Мен сізге айтқым келеді
Dialogue: 0,0:03:48.00,0:03:50.00,Default,,0,0,0,,Енді менің ойымда
Dialogue: 0,0:03:50.00,0:03:53.00,Default,,0,0,0,,Байқаймын ба деп қорқамын
Dialogue: 0,0:03:53.00,0:03:55.00,Default,,0,0,0,,Өткен және болашақ
Dialogue: 0,0:03:55.00,0:03:57.00,Default,,0,0,0,,Қорықсаң да
Dialogue: 0,0:03:57.00,0:04:00.00,Default,,0,0,0,,Бос болса қозғала алмайды
Dialogue: 0,0:04:00.00,0:04:02.00,Default,,0,0,0,,Егер сізге ұнаса
Dialogue: 0,0:04:02.00,0:04:05.00,Default,,0,0,0,,Бәрі жақсы
Dialogue: 0,0:04:05.00,0:04:07.00,Default,,0,0,0,,бастайық
Dialogue: 0,0:04:07.00,0:04:10.00,Default,,0,0,0,,Барлық жаман нәрселерді ұмытыңыз
Dialogue: 0,0:04:10.00,0:04:13.00,Default,,0,0,0,,Мен сенімен түнде билесем
Dialogue: 0,0:04:14.00,0:04:17.00,Default,,0,0,0,,Өзіңіздің жақсырақ нұсқасы болыңыз
Dialogue: 0,0:04:17.00,0:04:21.00,Default,,0,0,0,,Мен солай сезінемін.
Dialogue: 0,0:04:21.00,0:04:24.00,Default,,0,0,0,,Ешқашан бітпейтін мазмұн уақыты
Dialogue: 0,0:04:24.00,0:04:27.00,Default,,0,0,0,,Сен екеуміздің арамыз жақындап барады
Dialogue: 0,0:04:27.00,0:04:29.00,Default,,0,0,0,,Бірге уақыт өткізу
Dialogue: 0,0:04:29.00,0:04:34.00,Default,,0,0,0,,Айналма жол болса да қадірлегім келеді
Dialogue: 0,0:04:37.00,0:04:38.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:38.00,0:04:39.00,Default,,0,0,0,,Яна жетекші болып табылады
Dialogue: 0,0:04:39.00,0:04:40.00,Default,,0,0,0,,Иә
Dialogue: 0,0:04:40.00,0:04:42.00,Default,,0,0,0,,Со Тада-кун
Dialogue: 0,0:04:42.00,0:04:44.00,Default,,0,0,0,,Мицуоның бөлмесіне барыңыз.
Dialogue: 0,0:04:44.00,0:04:46.00,Default,,0,0,0,,Мені тексеруге келме
Dialogue: 0,0:04:46.00,0:04:49.00,Default,,0,0,0,,Қараңызшы, мен міндетті түрде бармауым керек.
Dialogue: 0,0:04:49.00,0:04:50.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:50.00,0:04:51.00,Default,,0,0,0,,Менің жігітім болса да
Dialogue: 0,0:04:51.00,0:04:52.00,Default,,0,0,0,,Басқа адамның бөлмесінде
Dialogue: 0,0:04:52.00,0:04:54.00,Default,,0,0,0,,Баратын жол жоқ.
Dialogue: 0,0:04:54.00,0:04:55.00,Default,,0,0,0,,Қарама-қарсы жыныспен жалғыз
Dialogue: 0,0:04:55.00,0:04:56.00,Default,,0,0,0,,Жабық бөлмеде боламын деп уайымдамаңыз
Dialogue: 0,0:04:56.00,0:04:58.00,Default,,0,0,0,,Бұл алдау
Dialogue: 0,0:04:58.00,0:05:00.00,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:00.00,0:05:03.00,Default,,0,0,0,,Келесі есікке оралыңыз
Dialogue: 0,0:05:03.00,0:05:04.00,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:05:04.00,0:05:06.00,Default,,0,0,0,,Ах
Dialogue: 0,0:05:06.00,0:05:07.00,Default,,0,0,0,,Тада-кун, тыңдап тұрсың ба?
Dialogue: 0,0:05:07.00,0:05:10.00,Default,,0,0,0,,Тыңдап жатырмын Тыңдап отырмын
Dialogue: 0,0:05:10.00,0:05:11.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:11.00,0:05:13.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:05:13.00,0:05:14.00,Default,,0,0,0,,Иә
Dialogue: 0,0:05:14.00,0:05:15.00,Default,,0,0,0,,Мен Линдаға келдім
Dialogue: 0,0:05:15.00,0:05:17.00,Default,,0,0,0,,Мен өз сезімімді ұмытқан жоқпын
Dialogue: 0,0:05:17.00,0:05:18.00,Default,,0,0,0,,Мен сізге кейінірек хабарласамын.
Dialogue: 0,0:05:18.00,0:05:21.00,Default,,0,0,0,,Қазір де мен елес болып кеткенмін
Dialogue: 0,0:05:21.00,0:05:22.00,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:05:22.00,0:05:23.00,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:05:23.00,0:05:24.00,Default,,0,0,0,,Қазір Тадабанри дегеніміз не?
Dialogue: 0,0:05:24.00,0:05:27.00,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:05:27.00,0:05:29.00,Default,,0,0,0,,Қазір Банри деген не?
Dialogue: 0,0:05:29.00,0:05:30.00,Default,,0,0,0,,Кагакукомен
Dialogue: 0,0:05:30.00,0:05:33.00,Default,,0,0,0,,Себебі біз кездесіп жатырмыз.
Dialogue: 0,0:05:34.00,0:05:37.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:37.00,0:05:39.00,Default,,0,0,0,,Мүмкін осында
Dialogue: 0,0:05:39.00,0:05:41.00,Default,,0,0,0,,Янаттаба
Dialogue: 0,0:05:41.00,0:05:43.00,Default,,0,0,0,,Оны енгізіңіз.
Dialogue: 0,0:05:43.00,0:05:44.00,Default,,0,0,0,,Жоқ, шынымен
Dialogue: 0,0:05:44.00,0:05:45.00,Default,,0,0,0,,Бүгін менмін
Dialogue: 0,0:05:45.00,0:05:46.00,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:05:46.00,0:05:48.00,Default,,0,0,0,,Өзіңізді мәжбүрлемеңіз
Dialogue: 0,0:05:48.00,0:05:50.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:50.00,0:05:53.00,Default,,0,0,0,,Мен саған тамақ жасап берейін деп едім.
Dialogue: 0,0:05:53.00,0:05:54.00,Default,,0,0,0,,Эй
Dialogue: 0,0:05:54.00,0:05:56.00,Default,,0,0,0,,Яна ет пен картопты ұната ма?
Dialogue: 0,0:05:56.00,0:05:57.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:57.00,0:05:58.00,Default,,0,0,0,,Мен де байсалдымын
Dialogue: 0,0:05:58.00,0:06:00.00,Default,,0,0,0,,Бүгін I
Dialogue: 0,0:06:00.00,0:06:02.00,Default,,0,0,0,,Мен көптен бері жалықтым
Dialogue: 0,0:06:02.00,0:06:03.00,Default,,0,0,0,,Ал егер
Dialogue: 0,0:06:03.00,0:06:05.00,Default,,0,0,0,,Мен түнесем бе деп ойладым.
Dialogue: 0,0:06:05.00,0:06:08.00,Default,,0,0,0,,Байыпты, байыпты, байыпты, байыпты.
Dialogue: 0,0:06:08.00,0:06:09.00,Default,,0,0,0,,Yes
Dialogue: 0,0:06:09.00,0:06:11.00,Default,,0,0,0,,Янасан
Dialogue: 0,0:06:13.00,0:06:14.00,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:14.00,0:06:15.00,Default,,0,0,0,,Банри
Dialogue: 0,0:06:15.00,0:06:19.00,Default,,0,0,0,,Менің досым
Dialogue: 0,0:06:23.00,0:06:25.00,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:25.00,0:06:28.00,Default,,0,0,0,,Бұл менің жігітім
Dialogue: 0,0:06:29.00,0:06:30.00,Default,,0,0,0,,Арамызда
Dialogue: 0,0:06:30.00,0:06:32.00,Default,,0,0,0,,Ешкім кіре алмайды
Dialogue: 0,0:06:32.00,0:06:35.00,Default,,0,0,0,,Олар бұрынғы өмірдегі ғашықтар.
Dialogue: 0,0:06:35.00,0:06:36.00,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:06:36.00,0:06:37.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:37.00,0:06:39.00,Default,,0,0,0,,Мен бұрынғы өмірімде қой болдым ба?
Dialogue: 0,0:06:39.00,0:06:42.00,Default,,0,0,0,,Мен монастырьда апа болдым
Dialogue: 0,0:06:42.00,0:06:44.00,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:06:45.00,0:06:48.00,Default,,0,0,0,,Балалар, сендер есі дұрыс емессіңдер.
Dialogue: 0,0:06:51.00,0:06:52.00,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:06:52.00,0:06:54.00,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:06:54.00,0:06:56.00,Default,,0,0,0,,Қазір
Dialogue: 0,0:06:56.00,0:06:58.00,Default,,0,0,0,,Эйкендік Рейна Сенпай
Dialogue: 0,0:06:58.00,0:07:00.00,Default,,0,0,0,,Бұл қорқынышты болды
Dialogue: 0,0:07:00.00,0:07:03.00,Default,,0,0,0,,Ол шынымен де өзінің дегейін көрсетеді.
Dialogue: 0,0:07:03.00,0:07:05.00,Default,,0,0,0,,О
Dialogue: 0,0:07:07.00,0:07:09.00,Default,,0,0,0,,Қандай тамаша бөлме.
Dialogue: 0,0:07:09.00,0:07:11.00,Default,,0,0,0,,Бұл өте жаман.
Dialogue: 0,0:07:12.00,0:07:14.00,Default,,0,0,0,,Мен Кага мырзадан сұрадым
Dialogue: 0,0:07:14.00,0:07:15.00,Default,,0,0,0,,Ока-чанмен
Dialogue: 0,0:07:15.00,0:07:17.00,Default,,0,0,0,,Тағы бірдеңе болды.
Dialogue: 0,0:07:18.00,0:07:19.00,Default,,0,0,0,,болды
Dialogue: 0,0:07:21.00,0:07:22.00,Default,,0,0,0,,Ах
Dialogue: 0,0:07:22.00,0:07:23.00,Default,,0,0,0,,Янар
Dialogue: 0,0:07:23.00,0:07:25.00,Default,,0,0,0,,Мен сені бүгін қашып кетуге жол бермеймін.
Dialogue: 0,0:07:26.00,0:07:27.00,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:07:27.00,0:07:28.00,Default,,0,0,0,,Біраз
Dialogue: 0,0:07:29.00,0:07:30.00,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:07:30.00,0:07:32.00,Default,,0,0,0,,Менімен сөйлеспе
Dialogue: 0,0:07:32.00,0:07:34.00,Default,,0,0,0,,Өткен күнгі компат туралы
Dialogue: 0,0:07:34.00,0:07:35.00,Default,,0,0,0,,Білетін болады
Dialogue: 0,0:07:35.00,0:07:37.00,Default,,0,0,0,,Бұл мәңгі дегенді білдіре ме?
Dialogue: 0,0:07:39.00,0:07:40.00,Default,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,0:07:42.00,0:07:45.00,Default,,0,0,0,,Егер Яна қаласа, мен аламын.
Dialogue: 0,0:07:54.00,0:07:55.00,Default,,0,0,0,,болып табылады
Dialogue: 0,0:07:55.00,0:07:56.00,Default,,0,0,0,,Yes
Dialogue: 0,0:07:56.00,0:07:58.00,Default,,0,0,0,,Сіз қашан
Dialogue: 0,0:07:58.00,0:08:01.00,Default,,0,0,0,,Сен менің жаныма рұқсатсыз келдің.
Dialogue: 0,0:08:01.00,0:08:03.00,Default,,0,0,0,,Айтпақшы, кешегі кеште,
Dialogue: 0,0:08:03.00,0:08:05.00,Default,,0,0,0,,Асығыстық үшін қабылданбаған адам емес.
Dialogue: 0,0:08:08.00,0:08:09.00,Default,,0,0,0,,Янасса
Dialogue: 0,0:08:15.00,0:08:16.00,Default,,0,0,0,,Осындай нәрсе
Dialogue: 0,0:08:16.00,0:08:18.00,Default,,0,0,0,,Айналаңыздағылардың бәрі біледі ме?
Dialogue: 0,0:08:18.00,0:08:20.00,Default,,0,0,0,,Айтпақшы мені тастап кетті.
Dialogue: 0,0:08:21.00,0:08:22.00,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:08:22.00,0:08:23.00,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:23.00,0:08:28.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:08:28.00,0:08:29.00,Default,,0,0,0,,Сізді тастап кеткен
Dialogue: 0,0:08:29.00,0:08:30.00,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:08:30.00,0:08:32.00,Default,,0,0,0,,Мен не істесем де, басқалар мені қалай көреді деп алаңдаймын.
Dialogue: 0,0:08:33.00,0:08:34.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:36.00,0:08:37.00,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:08:38.00,0:08:40.00,Default,,0,0,0,,Айтпақшы, ештеңе болмағандай.
Dialogue: 0,0:08:40.00,0:08:42.00,Default,,0,0,0,,Сіз қалыпты әрекет етуіңіз керек.
Dialogue: 0,0:08:44.00,0:08:45.00,Default,,0,0,0,,Бірақ кездессек
Dialogue: 0,0:08:46.00,0:08:48.00,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:08:48.00,0:08:49.00,Default,,0,0,0,,Мен ұялдым
Dialogue: 0,0:08:49.00,0:08:51.00,Default,,0,0,0,,Мен қайғылы сезінемін.
Dialogue: 0,0:08:51.00,0:08:53.00,Default,,0,0,0,,Мен ең нашармын
Dialogue: 0,0:08:53.00,0:08:55.00,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:08:56.00,0:08:57.00,Default,,0,0,0,,Янасса
Dialogue: 0,0:08:57.00,0:08:59.00,Default,,0,0,0,,Бетіңізге қараңыз
Dialogue: 0,0:09:01.00,0:09:03.00,Default,,0,0,0,,Тістерге жабысу
Dialogue: 0,0:09:03.00,0:09:05.00,Default,,0,0,0,,Мен жай ғана дүкеннен қолмен пісірілген суши жедім.
Dialogue: 0,0:09:05.00,0:09:06.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:06.00,0:09:08.00,Default,,0,0,0,,Өйткені ол әдемі жігіт
Dialogue: 0,0:09:08.00,0:09:10.00,Default,,0,0,0,,Өзіңізге сенімдірек болғаныңыз дұрыс
Dialogue: 0,0:09:11.00,0:09:13.00,Default,,0,0,0,,Әйтеуір, осылай тұра берсе, жақсы емес.
Dialogue: 0,0:09:13.00,0:09:16.00,Default,,0,0,0,,Линда-сенпай маған көмектескен кездегідей
Dialogue: 0,0:09:16.00,0:09:18.00,Default,,0,0,0,,Бұл жолы мен Янасса туралы бірдеңе істеймін.
Dialogue: 0,0:09:19.00,0:09:21.00,Default,,0,0,0,,Линда-сенпай дегеніміз не?
Dialogue: 0,0:09:22.00,0:09:23.00,Default,,0,0,0,,Моши Моши Нидзиген-кун
Dialogue: 0,0:09:23.00,0:09:24.00,Default,,0,0,0,,Осымен
Dialogue: 0,0:09:24.00,0:09:27.00,Default,,0,0,0,,Мен қазір Жанассаны жігерлендіру үшін жиналыс өткізгім келеді.
Dialogue: 0,0:09:35.00,0:09:36.00,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:09:36.00,0:09:38.00,Default,,0,0,0,,Тада-кун, сен 15 минутқа кешігіп қалдың.
Dialogue: 0,0:09:39.00,0:09:40.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:40.00,0:09:41.00,Default,,0,0,0,,Ах.
Dialogue: 0,0:09:41.00,0:09:43.00,Default,,0,0,0,,Мен өз-өзімді өлтіруге тырыстым.
Dialogue: 0,0:09:43.00,0:09:45.00,Default,,0,0,0,,Тада-кунмен танысу
Dialogue: 0,0:09:45.00,0:09:47.00,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:09:50.00,0:09:51.00,Default,,0,0,0,,Джанассамен кездесу
Dialogue: 0,0:09:51.00,0:09:52.00,Default,,0,0,0,,Жоспар
Dialogue: 0,0:09:52.00,0:09:54.00,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:09:56.00,0:09:57.00,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:09:58.00,0:09:59.00,Default,,0,0,0,,Мен бақытты емеспін.
Dialogue: 0,0:09:59.00,0:10:01.00,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:10:01.00,0:10:02.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:02.00,0:10:04.00,Default,,0,0,0,,Мен әркімнің сезімін бағалаймын, бірақ
Dialogue: 0,0:10:05.00,0:10:07.00,Default,,0,0,0,,Мені қызықтыратын мынау бір.
Dialogue: 0,0:10:07.00,0:10:08.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:08.00,0:10:10.00,Default,,0,0,0,,Маған Банри қоңырау шалған кезде
Dialogue: 0,0:10:10.00,0:10:13.00,Default,,0,0,0,,Мен Кага-санмен бір сыныпта оқыдым.
Dialogue: 0,0:10:13.00,0:10:15.00,Default,,0,0,0,,Тыңдалады
Dialogue: 0,0:10:15.00,0:10:18.00,Default,,0,0,0,,Мен әрқашан сенімен бірге болғым келеді
Dialogue: 0,0:10:18.00,0:10:21.00,Default,,0,0,0,,Маған Мицуо мүлдем маңызды емес.
Dialogue: 0,0:10:21.00,0:10:24.00,Default,,0,0,0,,Менің ұсынысым, оны ойын-сауық саябағына айналдыру.
Dialogue: 0,0:10:24.00,0:10:26.00,Default,,0,0,0,,Ұнамаса, үйге қайт.
Dialogue: 0,0:10:26.00,0:10:28.00,Default,,0,0,0,,Бұл бәрібір мазасыз
Dialogue: 0,0:10:36.00,0:10:38.00,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:10:38.00,0:10:40.00,Default,,0,0,0,,Бұл ана
Dialogue: 0,0:10:40.00,0:10:41.00,Default,,0,0,0,,Шығу керек
Dialogue: 0,0:10:41.00,0:10:42.00,Default,,0,0,0,,шығу керек
Dialogue: 0,0:10:43.00,0:10:44.00,Default,,0,0,0,,Янасса
Dialogue: 0,0:10:48.00,0:10:50.00,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:10:51.00,0:10:52.00,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:10:54.00,0:10:55.00,Default,,0,0,0,,Мен едім!
Dialogue: 0,0:10:55.00,0:10:58.00,Default,,0,0,0,,Біз Мицуоны жігерлендіру үшін кездесу өткіземіз.
Dialogue: 0,0:10:58.00,0:11:00.00,Default,,0,0,0,,Сіз де келіңіз
Dialogue: 0,0:11:00.00,0:11:02.00,Default,,0,0,0,,Келгеніңді қаламаймын, бірақ
Dialogue: 0,0:11:02.00,0:11:06.00,Default,,0,0,0,,Мен саған Мицуо үшін қоңырау шалып тұрмын.
Dialogue: 0,0:11:08.00,0:11:09.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:11:09.00,0:11:10.00,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:11:11.00,0:11:14.00,Default,,0,0,0,,Мен Мицуоға мейірімділік таныттым.
Dialogue: 0,0:11:15.00,0:11:16.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:11:16.00,0:11:18.00,Default,,0,0,0,,Мен үшін не істеп жатырсың?
Dialogue: 0,0:11:18.00,0:11:20.00,Default,,0,0,0,,Мен естігендей.
Dialogue: 0,0:11:20.00,0:11:22.00,Default,,0,0,0,,-мен не істеу керек
Dialogue: 0,0:11:23.00,0:11:24.00,Default,,0,0,0,,Қайтару
Dialogue: 0,0:11:24.00,0:11:25.00,Default,,0,0,0,,қалады
Dialogue: 0,0:11:28.00,0:11:30.00,Default,,0,0,0,,Моши Моши Окачан
Dialogue: 0,0:11:32.00,0:11:35.00,Default,,0,0,0,,Мен билет қақпасының алдында күтемін.
Dialogue: 0,0:11:36.00,0:11:40.00,Default,,0,0,0,,Ойын-сауық саябағына Тада-кунмен жалғыз келер едім.
Dialogue: 0,0:11:41.00,0:11:43.00,Default,,0,0,0,,Олай болса, келесі жолы жиналайық.
Dialogue: 0,0:11:43.00,0:11:45.00,Default,,0,0,0,,Бассейн жақында ашылады
Dialogue: 0,0:11:45.00,0:11:47.00,Default,,0,0,0,,Немесе мен теңізге баруым керек шығар
Dialogue: 0,0:11:47.00,0:11:49.00,Default,,0,0,0,,Тада-кун және теңіз жоқ
Dialogue: 0,0:11:49.00,0:11:51.00,Default,,0,0,0,,Мен оны асыға күтемін
Dialogue: 0,0:11:57.00,0:11:59.00,Default,,0,0,0,,Мені алып кетуге Қаза-сан да келді.
Dialogue: 0,0:11:59.00,0:12:01.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:02.00,0:12:05.00,Default,,0,0,0,,Жоқ, бірақ мен бұрын алған телефон қоңырауы мені таң қалдырды.
Dialogue: 0,0:12:05.00,0:12:10.00,Default,,0,0,0,,Кага-сан кенеттен пайда болды, мен оны біртүрлі деп ойладым, бірақ содан кейін Яна-га-сан пайда болды.
Dialogue: 0,0:12:10.00,0:12:12.00,Default,,0,0,0,,Мен қазір баруым керек.
Dialogue: 0,0:12:12.00,0:12:14.00,Default,,0,0,0,,Сіз қатты ренжідіңіз, солай емес пе?
Dialogue: 0,0:12:15.00,0:12:16.00,Default,,0,0,0,,қараңыз
Dialogue: 0,0:12:17.00,0:12:19.00,Default,,0,0,0,,Мен осындай нәрсені әкелдім.
Dialogue: 0,0:12:19.00,0:12:20.00,Default,,0,0,0,,Кеспе
Dialogue: 0,0:12:20.00,0:12:21.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:21.00,0:12:23.00,Default,,0,0,0,,Бұл өте көңілсіз.
Dialogue: 0,0:12:24.00,0:12:25.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:25.00,0:12:28.00,Default,,0,0,0,,Бари мен Кага-сан кездесіп жүр дейді.
Dialogue: 0,0:12:28.00,0:12:29.00,Default,,0,0,0,,О, мен оны білдім.
Dialogue: 0,0:12:29.00,0:12:31.00,Default,,0,0,0,,Мен өткен күні Нижиген-куннан сұрадым
Dialogue: 0,0:12:32.00,0:12:35.00,Default,,0,0,0,,Мен де олардың қол ұстасып тұрғанын көрдім.
Dialogue: 0,0:12:35.00,0:12:37.00,Default,,0,0,0,,О, көрдің бе?
Dialogue: 0,0:12:37.00,0:12:39.00,Default,,0,0,0,,Мен көрдім
Dialogue: 0,0:12:40.00,0:12:44.00,Default,,0,0,0,,Мен сенің келгеніңді қаламадым.
Dialogue: 0,0:12:44.00,0:12:47.00,Default,,0,0,0,,Сенің модератор болғаныңды қаламаймын.
Dialogue: 0,0:12:47.00,0:12:49.00,Default,,0,0,0,,Кага-сан осылай атады.
Dialogue: 0,0:12:49.00,0:12:52.00,Default,,0,0,0,,Мен жай ғана Мицуоны аядым, себебі ол ренжіді.
Dialogue: 0,0:12:52.00,0:12:55.00,Default,,0,0,0,,Ол менің бала күнгі досым ғой.
Dialogue: 0,0:12:55.00,0:12:57.00,Default,,0,0,0,,Мен бәрібір сізбен кездесуге қарсы емеспін.
Dialogue: 0,0:12:57.00,0:13:01.00,Default,,0,0,0,,Бірақ Мицуоны бұдан былай қинамаңыз.
Dialogue: 0,0:13:01.00,0:13:04.00,Default,,0,0,0,,Егер мұны істей алмасаңыз, үйге қайтыңыз.
Dialogue: 0,0:13:05.00,0:13:07.00,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:13:08.00,0:13:10.00,Default,,0,0,0,,Оның Кага-санға қатысы жоқ.
Dialogue: 0,0:13:11.00,0:13:14.00,Default,,0,0,0,,Яна екеуміздің арамызда не болса да
Dialogue: 0,0:13:14.00,0:13:16.00,Default,,0,0,0,,Оның Кага-санға қатысы жоқ.
Dialogue: 0,0:13:17.00,0:13:20.00,Default,,0,0,0,,Кага-сан Баримен кездесіп жүр, солай ма?
Dialogue: 0,0:13:20.00,0:13:24.00,Default,,0,0,0,,Қолыңыздағы нәрсеге көбірек көңіл бөлсеңіз
Dialogue: 0,0:13:26.00,0:13:28.00,Default,,0,0,0,,Маған кеспелерді қайтарыңыз
Dialogue: 0,0:13:32.00,0:13:33.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:33.00,0:13:35.00,Default,,0,0,0,,Ах.
Dialogue: 0,0:13:38.00,0:13:41.00,Default,,0,0,0,,Жарайды, сынған жоқ.
Dialogue: 0,0:13:42.00,0:13:45.00,Default,,0,0,0,,Мен дұрыс суретке түсіре аламын ба?
Dialogue: 0,0:13:48.00,0:13:50.00,Default,,0,0,0,,Бұл Қағасан.
Dialogue: 0,0:13:50.00,0:13:52.00,Default,,0,0,0,,Кагакуку
Dialogue: 0,0:13:52.00,0:13:54.00,Default,,0,0,0,,Мен камерамен бірінші рет суретке түсуім.
Dialogue: 0,0:13:54.00,0:13:56.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:57.00,0:13:59.00,Default,,0,0,0,,Сәлем Кага-сан
Dialogue: 0,0:13:59.00,0:14:01.00,Default,,0,0,0,,Маған да қиын.
Dialogue: 0,0:14:01.00,0:14:04.00,Default,,0,0,0,,Олай емес сияқты көрінуі мүмкін, бірақ
Dialogue: 0,0:14:04.00,0:14:06.00,Default,,0,0,0,,Өйткені
Dialogue: 0,0:14:06.00,0:14:07.00,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:14:07.00,0:14:09.00,Default,,0,0,0,,Янатебаса
Dialogue: 0,0:14:11.00,0:14:14.00,Default,,0,0,0,,Айтшы, енді сенімен сөйлеспеймін.
Dialogue: 0,0:14:14.00,0:14:16.00,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:14:16.00,0:14:20.00,Default,,0,0,0,,Сенің алдыңда сүйкімді болмаймын деп ерінетін мен ғана.
Dialogue: 0,0:14:20.00,0:14:22.00,Default,,0,0,0,,Сабыр және шыдамдылық
Dialogue: 0,0:14:22.00,0:14:25.00,Default,,0,0,0,,Сен жылауыңды тоқтатқанша сені осылай лақтырып жіберейін бе?
Dialogue: 0,0:14:25.00,0:14:26.00,Default,,0,0,0,,Қағасан
Dialogue: 0,0:14:26.00,0:14:28.00,Default,,0,0,0,,Анам тұншығып жатыр.
Dialogue: 0,0:14:28.00,0:14:30.00,Default,,0,0,0,,Жылауыңды тоқтатқалы тұрғанда, маған көзді айналдыр
Dialogue: 0,0:14:30.00,0:14:32.00,Default,,0,0,0,,Оған дейін оны сол күйінде сақтаңыз.
Dialogue: 0,0:14:32.00,0:14:34.00,Default,,0,0,0,,Жоқ, жоқ, анам өледі.
Dialogue: 0,0:14:37.00,0:14:39.00,Default,,0,0,0,,Жылауды тоқтатыңыз
Dialogue: 0,0:14:39.00,0:14:40.00,Default,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:14:40.00,0:14:42.00,Default,,0,0,0,,Не болды? Егер айтатын сөзің болса, мен тыңдап тұрмын
Dialogue: 0,0:14:42.00,0:14:44.00,Default,,0,0,0,,Сәлем Ванли
Dialogue: 0,0:14:44.00,0:14:47.00,Default,,0,0,0,,Мен қазір шынымен көңілді емеспін.
Dialogue: 0,0:14:47.00,0:14:48.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:14:48.00,0:14:49.00,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:14:49.00,0:14:50.00,Default,,0,0,0,,Суретке түсіру
Dialogue: 0,0:14:50.00,0:14:51.00,Default,,0,0,0,,Шынайы
Dialogue: 0,0:14:51.00,0:14:52.00,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:14:52.00,0:14:53.00,Default,,0,0,0,,Шынайы
Dialogue: 0,0:14:53.00,0:14:55.00,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:14:56.00,0:14:57.00,Default,,0,0,0,,Сәлем, кішкентай Қағасан
Dialogue: 0,0:14:57.00,0:14:58.00,Default,,0,0,0,,Шынайы кімдігі: жалдамалы кісі өлтіруші
Dialogue: 0,0:14:58.00,0:15:00.00,Default,,0,0,0,,Босатып көріңіз
Dialogue: 0,0:15:00.00,0:15:01.00,Default,,0,0,0,,Мен сияқты нәрсе
Dialogue: 0,0:15:01.00,0:15:04.00,Default,,0,0,0,,Мен дәл қазір үлкен тұрақтылық сезімін сезінемін.
Dialogue: 0,0:15:05.00,0:15:06.00,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:15:24.00,0:15:26.00,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:15:34.00,0:15:35.00,Default,,0,0,0,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:15:35.00,0:15:36.00,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:15:36.00,0:15:38.00,Default,,0,0,0,,Алдымен нені міну керек?
Dialogue: 0,0:15:38.00,0:15:40.00,Default,,0,0,0,,Бұл айғайлайтын түрі екені сөзсіз.
Dialogue: 0,0:16:04.00,0:16:06.00,Default,,0,0,0,,Біз бітім жасай алдық па?
Dialogue: 0,0:16:08.00,0:16:12.00,Default,,0,0,0,,Тада-кун, маған қарашы
Dialogue: 0,0:16:26.00,0:16:28.00,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:16:28.00,0:16:29.00,Default,,0,0,0,,Міне.
Dialogue: 0,0:16:29.00,0:16:34.00,Default,,0,0,0,,Бетке қуырылған кеспе
Dialogue: 0,0:16:34.00,0:16:35.00,Default,,0,0,0,,Иә
Dialogue: 0,0:16:36.00,0:16:37.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:37.00,0:16:38.00,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:16:38.00,0:16:39.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:16:39.00,0:16:40.00,Default,,0,0,0,,Яра-сан
Dialogue: 0,0:16:40.00,0:16:41.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:41.00,0:16:42.00,Default,,0,0,0,,Нана
Dialogue: 0,0:16:42.00,0:16:44.00,Default,,0,0,0,,Келісім жасаймыз ба?
Dialogue: 0,0:16:44.00,0:16:45.00,Default,,0,0,0,,Келісім
Dialogue: 0,0:16:45.00,0:16:46.00,Default,,0,0,0,,Иә
Dialogue: 0,0:16:46.00,0:16:50.00,Default,,0,0,0,,Егер мен бүгінгідей ойын күнін немесе ішімдік кешін ұйымдастыратын болсам,
Dialogue: 0,0:16:50.00,0:16:52.00,Default,,0,0,0,,Екі тарап мүмкіндігінше қатысуы керек.
Dialogue: 0,0:16:52.00,0:16:55.00,Default,,0,0,0,,Солай етсең, біраз адамдар жиналады.
Dialogue: 0,0:16:55.00,0:16:56.00,Default,,0,0,0,,Сендер тым ашушаңсыңдар
Dialogue: 0,0:16:56.00,0:16:59.00,Default,,0,0,0,,Сен тегін мінсең, мен де мінемін.
Dialogue: 0,0:16:59.00,0:17:01.00,Default,,0,0,0,,Маған үш күйеуінің бірге болғаны ұнамайды.
Dialogue: 0,0:17:01.00,0:17:03.00,Default,,0,0,0,,Бұл сызық.
Dialogue: 0,0:17:03.00,0:17:05.00,Default,,0,0,0,,Мен де араластым.
Dialogue: 0,0:17:05.00,0:17:06.00,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:17:06.00,0:17:07.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:20.00,0:17:23.00,Default,,0,0,0,,Біреу ояу
Dialogue: 0,0:17:31.00,0:17:33.00,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:17:50.00,0:17:53.00,Default,,0,0,0,,Линда...сенпай
Dialogue: 0,0:17:53.00,0:17:55.00,Default,,0,0,0,,Ванли
Dialogue: 0,0:17:55.00,0:17:58.00,Default,,0,0,0,,Бұл осылайша қолайлырақ көрінеді.
Dialogue: 0,0:18:00.00,0:18:02.00,Default,,0,0,0,,Қызықты болды.
Dialogue: 0,0:18:03.00,0:18:05.00,Default,,0,0,0,,Нана-сенпайдың бөлмесінде үнемі болдың ба?
Dialogue: 0,0:18:06.00,0:18:07.00,Default,,0,0,0,,Иә
Dialogue: 0,0:18:08.00,0:18:11.00,Default,,0,0,0,,Мен жай ғана сен туралы ойладым.
Dialogue: 0,0:18:12.00,0:18:14.00,Default,,0,0,0,,Электрондық хатты алған кезде мен қатты қорықтым.
Dialogue: 0,0:18:15.00,0:18:17.00,Default,,0,0,0,,Менің ояу екенімді қайдан білдің?
Dialogue: 0,0:18:18.00,0:18:22.00,Default,,0,0,0,,Неге екенін білмеймін, бірақ өзімді солай сезіндім.
Dialogue: 0,0:18:22.00,0:18:25.00,Default,,0,0,0,,Банри әрқашан солай болған.
Dialogue: 0,0:18:26.00,0:18:28.00,Default,,0,0,0,,Клубтық оқу-жаттығу жиындары үшін экскурсия жоқ па?
Dialogue: 0,0:18:29.00,0:18:32.00,Default,,0,0,0,,Түн ортасында ұйықтай алмай жүргенімде, сен қыздың бөлмесіне кірдің.
Dialogue: 0,0:18:33.00,0:18:36.00,Default,,0,0,0,,Эй Линда, сен ояусың ба?
Dialogue: 0,0:18:37.00,0:18:38.00,Default,,0,0,0,,Е, мен жер астындамын.
Dialogue: 0,0:18:39.00,0:18:43.00,Default,,0,0,0,,Мені де тітіркендіреді, бірақ сіз өте қобалжыған сияқтысыз.
Dialogue: 0,0:18:44.00,0:18:48.00,Default,,0,0,0,,Мен ұйықтай алмаймын, ертеңгі жаттығуға алаңдаймын.
Dialogue: 0,0:18:49.00,0:18:50.00,Default,,0,0,0,,Уау
Dialogue: 0,0:18:50.00,0:18:53.00,Default,,0,0,0,,Иә, бұл әрекетте эротикалық жіп бар екені сөзсіз.
Dialogue: 0,0:18:54.00,0:18:55.00,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:18:56.00,0:19:00.00,Default,,0,0,0,,Сонымен, сол жолы шалбарымды жоғалтып алған Банри болды.
Dialogue: 0,0:19:01.00,0:19:02.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:19:02.00,0:19:03.00,Default,,0,0,0,,Уф
Dialogue: 0,0:19:13.00,0:19:15.00,Default,,0,0,0,,Әйтеуір, бірақ
Dialogue: 0,0:19:16.00,0:19:17.00,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:19:17.00,0:19:20.00,Default,,0,0,0,,Менің ойымша, ол кезде маған Линда ұнады.
Dialogue: 0,0:19:21.00,0:19:24.00,Default,,0,0,0,,Сондықтан ұйықтай алмаймын деп сылтау айттым.
Dialogue: 0,0:19:25.00,0:19:28.00,Default,,0,0,0,,Менің ойымша, бұл Линданың ұйықтап жатқанын көргісі келетін сәл эротикалық әрекет болды.
Dialogue: 0,0:19:29.00,0:19:31.00,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:37.00,0:19:42.00,Default,,0,0,0,,Өткенді басынан осылай айтуым керек еді.
Dialogue: 0,0:19:42.00,0:19:46.00,Default,,0,0,0,,Бір рет айтуды ұмытып кететін сөздер белгілі бір себептермен токсиндерді көбірек шығарады.
Dialogue: 0,0:19:47.00,0:19:51.00,Default,,0,0,0,,Егер сіз жай ғана бірдеңе айта алсаңыз, бұл ең жақсысы.
Dialogue: 0,0:19:54.00,0:19:58.00,Default,,0,0,0,,Банри екеуміздің арасында айта алмайтын ештеңе жоқ.
Dialogue: 0,0:19:59.00,0:20:03.00,Default,,0,0,0,,Біз өзгермейміз, осылай өмір сүреміз.
Dialogue: 0,0:20:04.00,0:20:07.00,Default,,0,0,0,,Бір аспанға қарасам, мүлде өзгерген жоқ
Dialogue: 0,0:20:08.00,0:20:09.00,Default,,0,0,0,,О
Dialogue: 0,0:20:09.00,0:20:10.00,Default,,0,0,0,,Банри?
Dialogue: 0,0:20:11.00,0:20:14.00,Default,,0,0,0,,Мен естімеген бір нәрсе бар.
Dialogue: 0,0:20:15.00,0:20:16.00,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:20:17.00,0:20:18.00,Default,,0,0,0,,Мектеп бітіру рәсімінен кейінгі күні
Dialogue: 0,0:20:19.00,0:20:22.00,Default,,0,0,0,,Қызық, мойындауға не жауап берді?
Dialogue: 0,0:20:27.00,0:20:28.00,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:30.00,0:20:32.00,Default,,0,0,0,,Жауабы жоқ.
Dialogue: 0,0:20:33.00,0:20:36.00,Default,,0,0,0,,Өйткені мен Банриге ғашықпын.
Dialogue: 0,0:20:36.00,0:20:41.00,Default,,0,0,0,,Өйткені, мен Банриді романтикалық қызығушылық деп санай алмадым.
Dialogue: 0,0:20:42.00,0:20:46.00,Default,,0,0,0,,Мен біз әрқашан жақсы дос боламыз деп айтқым келді.
Dialogue: 0,0:20:49.00,0:20:53.00,Default,,0,0,0,,Түсіндім, Линда-сенпай.
Dialogue: 0,0:20:56.00,0:20:58.00,Default,,0,0,0,,Сол күндерге қайта оралғың келе ме?
Dialogue: 0,0:21:00.00,0:21:04.00,Default,,0,0,0,,Сол кезде мен болған жерде
Dialogue: 0,0:21:04.00,0:21:05.00,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:21:07.00,0:21:09.00,Default,,0,0,0,,Мен үйге барғым келеді!
Dialogue: 0,0:21:14.00,0:21:16.00,Default,,0,0,0,,Мен не айттым?
Dialogue: 0,0:21:18.00,0:21:21.00,Default,,0,0,0,,Ой, мен осы сәтте ұйықтап қалдым.
Dialogue: 0,0:21:23.00,0:21:24.00,Default,,0,0,0,,Ұйықтап қалу?
Dialogue: 0,0:21:25.00,0:21:28.00,Default,,0,0,0,,Мен қазір ұйықтауым керек сияқты. Ұйқының болмауы жақсы емес.
Dialogue: 0,0:21:28.00,0:21:32.00,Default,,0,0,0,,Ұйқының болмауы жақсы емес, жүйкемді жұқартады.
Dialogue: 0,0:21:32.00,0:21:34.00,Default,,0,0,0,,Мен тіпті қажет емес нәрселер туралы ойлаймын.
Dialogue: 0,0:21:36.00,0:21:37.00,Default,,0,0,0,,Қайырлы түн Тадабанри
Dialogue: 0,0:21:40.00,0:21:43.00,Default,,0,0,0,,Мен Линданы әлі де жақсы көремін
Dialogue: 0,0:21:44.00,0:21:46.00,Default,,0,0,0,,Мүмкін болса, мен Линданың қасында мәңгі қалғым келеді.
Dialogue: 0,0:21:47.00,0:21:50.00,Default,,0,0,0,,Бірақ мен сені тастап кете алмаймын
Dialogue: 0,0:21:51.00,0:21:53.00,Default,,0,0,0,,Кетсем, жоқ боламын.
Dialogue: 0,0:21:54.00,0:21:55.00,Default,,0,0,0,,Мен солай сезінемін
Dialogue: 0,0:21:58.00,0:21:59.00,Default,,0,0,0,,Қайырлы түн Тада Банри
Dialogue: 0,0:22:28.00,0:22:29.00,Default,,0,0,0,,Қайырлы түн Тада Банри
Dialogue: 0,0:22:59.00,0:23:00.00,Default,,0,0,0,,Қайырлы түн Тада Банри
Dialogue: 0,0:23:01.00,0:23:02.00,Default,,0,0,0,,Қайырлы түн Тадабанри
Dialogue: 0,0:23:03.00,0:23:04.00,Default,,0,0,0,,Қайырлы түн Тада Банри
Dialogue: 0,0:23:05.00,0:23:06.00,Default,,0,0,0,,Қайырлы түн Тадабанри
Dialogue: 0,0:23:07.00,0:23:08.00,Default,,0,0,0,,Қайырлы түн Тадабанри
Dialogue: 0,0:23:09.00,0:23:10.00,Default,,0,0,0,,Қайырлы түн Тадабанри
Dialogue: 0,0:23:11.00,0:23:12.00,Default,,0,0,0,,Қайырлы түн Тада Банри
Dialogue: 0,0:23:13.00,0:23:14.00,Default,,0,0,0,,Қайырлы түн Тада Банри
Dialogue: 0,0:23:15.00,0:23:16.00,Default,,0,0,0,,Қайырлы түн Тадабанри
Dialogue: 0,0:23:17.00,0:23:18.00,Default,,0,0,0,,Қайырлы түн Тадабанри
Dialogue: 0,0:23:19.00,0:23:20.00,Default,,0,0,0,,Қайырлы түн Тадабанри
Dialogue: 0,0:23:21.00,0:23:22.00,Default,,0,0,0,,Қайырлы түн Тада Банри
Dialogue: 0,0:23:23.00,0:23:24.00,Default,,0,0,0,,Қайырлы түн Тада Банри
Dialogue: 0,0:23:25.00,0:23:26.00,Default,,0,0,0,,Қайырлы түн Тадабанри
Dialogue: 0,0:23:26.00,0:23:27.00,Default,,0,0,0,,Қайырлы түн Тада Банри
Dialogue: 0,0:23:28.00,0:23:29.00,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:23:30.00,0:23:32.00,Default,,0,0,0,,Сен маған өте жақсы еліктейсің.
Dialogue: 0,0:23:33.00,0:23:34.00,Default,,0,0,0,,Жоқ, Мицуо
Dialogue: 0,0:23:35.00,0:23:36.00,Default,,0,0,0,,Бөлме қызықсыз, аяғым ауырады.
Dialogue: 0,0:23:37.00,0:23:38.00,Default,,0,0,0,,Кецуаго
Dialogue: 0,0:23:39.00,0:23:40.00,Default,,0,0,0,,Мұны қайталама. Көтеріліс
Dialogue: 0,0:23:41.50,0:23:46.50,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
