Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.37,0:00:07.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.67,0:01:36.97,Default,,0,0,0,,～♪
Dialogue: 0,0:01:42.97,0:01:43.97,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:01:44.64,0:01:45.98,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:01:48.31,0:01:52.02,Default,,0,0,0,,Қария... Мен ризамын.
Dialogue: 0,0:01:52.15,0:01:53.53,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:01:53.65,0:01:54.86,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:01:54.98,0:01:57.99,Default,,0,0,0,,Сіз байыпты жұмыс істеуіңіз керек.
Dialogue: 0,0:01:58.07,0:01:58.99,Default,,0,0,0,,Фу
Dialogue: 0,0:02:02.53,0:02:04.99,Default,,0,0,0,,Топтардың құны соншама көп пе?
Dialogue: 0,0:02:05.08,0:02:08.75,Default,,0,0,0,,Иә, сатылмайтын топтар үшін қазірдің өзінде қиын.
Dialogue: 0,0:02:08.87,0:02:12.54,Default,,0,0,0,,Өткен күні тұтынушылардан гөрі мүшелер көп болды.
Dialogue: 0,0:02:12.67,0:02:14.55,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:02:14.67,0:02:17.51,Default,,0,0,0,,Сенің есі дұрыс па?
Dialogue: 0,0:02:22.93,0:02:25.72,Default,,0,0,0,,Хмм, мына бала...
Dialogue: 0,0:02:25.85,0:02:27.73,Default,,0,0,0,,Бұл әйел...
Dialogue: 0,0:02:28.10,0:02:29.10,Default,,0,0,0,,О? О!
Dialogue: 0,0:02:29.23,0:02:31.02,Default,,0,0,0,,Бұл жігіт!!
Dialogue: 0,0:02:31.60,0:02:35.82,Default,,0,0,0,,Уау!!
Dialogue: 0,0:02:36.28,0:02:38.24,Default,,0,0,0,,Тегіс!
Dialogue: 0,0:02:38.36,0:02:40.28,Default,,0,0,0,,Тегіс!
Dialogue: 0,0:02:40.53,0:02:42.28,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:02:42.41,0:02:44.41,Default,,0,0,0,,Каору қорқынышты
Dialogue: 0,0:02:44.91,0:02:47.62,Default,,0,0,0,,Жарайды, мен сені қорғаймын.
Dialogue: 0,0:02:47.70,0:02:48.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:48.62,0:02:50.29,Default,,0,0,0,,Тегіс!
Dialogue: 0,0:02:50.75,0:02:53.25,Default,,0,0,0,,Дайбури... Жапонияға келеді...
Dialogue: 0,0:02:53.38,0:02:53.59,Default,,0,0,0,,А? Бұл не?
Dialogue: 0,0:02:53.59,0:02:55.59,Default,,0,0,0,,А? Бұл не?
Dialogue: 0,0:02:53.59,0:02:55.59,Default,,0,0,0,,Тегіс! Ха ха...
Dialogue: 0,0:02:55.59,0:02:55.71,Default,,0,0,0,,Тегіс! Ха ха...
Dialogue: 0,0:02:55.71,0:02:56.55,Default,,0,0,0,,Тегіс! Ха ха...
Dialogue: 0,0:02:55.71,0:02:56.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:56.55,0:02:56.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:56.67,0:02:57.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:56.67,0:02:57.17,Default,,0,0,0,,Хэйкун... ха ха...
Dialogue: 0,0:02:57.17,0:02:57.80,Default,,0,0,0,,Хэйкун... ха ха...
Dialogue: 0,0:02:57.80,0:02:58.92,Default,,0,0,0,,Хэйкун... ха ха...
Dialogue: 0,0:02:57.80,0:02:58.92,Default,,0,0,0,,Ой, кешіріңіз, мен сізді білемін.
Dialogue: 0,0:02:58.92,0:02:59.05,Default,,0,0,0,,Ой, кешіріңіз, мен сізді білемін.
Dialogue: 0,0:02:59.05,0:03:00.26,Default,,0,0,0,,Ой, кешіріңіз, мен сізді білемін.
Dialogue: 0,0:02:59.05,0:03:00.26,Default,,0,0,0,,Хэй-кун ха ха ха ха...
Dialogue: 0,0:03:00.26,0:03:00.38,Default,,0,0,0,,Хэй-кун ха ха ха ха...
Dialogue: 0,0:03:00.38,0:03:03.51,Default,,0,0,0,,Хэй-кун ха ха ха ха...
Dialogue: 0,0:03:00.38,0:03:03.51,Default,,0,0,0,,Эй Чиба, не болды?
Dialogue: 0,0:03:04.30,0:03:08.14,Default,,0,0,0,,Керемет! Дайбури Жапонияда өнер көрсете ме?
Dialogue: 0,0:03:08.22,0:03:09.06,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:03:09.56,0:03:11.10,Default,,0,0,0,,Өте керемет
Dialogue: 0,0:03:11.23,0:03:12.48,Default,,0,0,0,,О
Dialogue: 0,0:03:12.98,0:03:14.65,Default,,0,0,0,,Міндетті түрде барып көріңіз!
Dialogue: 0,0:03:14.77,0:03:15.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:15.98,0:03:21.32,Default,,0,0,0,,Хехе... Рюсуке, бізді Эддимен таныстыра аласыз ба?
Dialogue: 0,0:03:21.45,0:03:23.57,Default,,0,0,0,,Менің ойымша, бұл мүмкін емес.
Dialogue: 0,0:03:23.70,0:03:25.12,Default,,0,0,0,,Өйткені, қазір Дайбри —
Dialogue: 0,0:03:25.24,0:03:29.16,Default,,0,0,0,,Олар АҚШ-тағы 8 миллион дана сатылымы бар ең күшті топ.
Dialogue: 0,0:03:29.29,0:03:32.79,Default,,0,0,0,,Бірақ ол Эддимен дос, солай ма?
Dialogue: 0,0:03:33.96,0:03:37.34,Default,,0,0,0,,Бірақ Дайбури Жапонияда...
Dialogue: 0,0:03:37.46,0:03:38.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:38.67,0:03:43.64,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:04:11.50,0:04:13.50,Default,,0,0,0,,Тачитакада Тойонага Ниши ме?
Dialogue: 0,0:04:13.62,0:04:15.46,Default,,0,0,0,,Иә, солай деп үміттенемін.
Dialogue: 0,0:04:15.58,0:04:16.88,Default,,0,0,0,,Қауіпті…
Dialogue: 0,0:04:17.96,0:04:19.42,Default,,0,0,0,,Сіздің ағымдағы бағаларыңыз...
Dialogue: 0,0:04:19.55,0:04:22.76,Default,,0,0,0,,Бұл мінсіз шекара.
Dialogue: 0,0:04:22.88,0:04:24.05,Default,,0,0,0,,Ах... жай ғана...
Dialogue: 0,0:04:24.13,0:04:26.43,Default,,0,0,0,,Бұл жазғы демалыста қаншалықты еңбек еткеніңізге байланысты.
Dialogue: 0,0:04:26.55,0:04:27.85,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:04:28.60,0:04:30.35,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:04:32.56,0:04:35.14,Default,,0,0,0,,О! Әңгіме біткен жоқ!
Dialogue: 0,0:04:35.60,0:04:38.06,Default,,0,0,0,,Сіз топта жүрген сияқтысыз.
Dialogue: 0,0:04:38.19,0:04:40.11,Default,,0,0,0,,Сіз кәсіби маман болуды мақсат етесіз бе?
Dialogue: 0,0:04:40.57,0:04:41.65,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:41.73,0:04:45.15,Default,,0,0,0,,Бұл бос сөз! Мен сен бола алмаймын
Dialogue: 0,0:04:45.24,0:04:48.74,Default,,0,0,0,,Мачидадағы 20 жыл ұстаздық өмірі—
Dialogue: 0,0:04:48.87,0:04:52.66,Default,,0,0,0,,Әнші болған бір оқушыны білмеймін!
Dialogue: 0,0:04:52.75,0:04:55.83,Default,,0,0,0,,Бұл Танака шындық
Dialogue: 0,0:04:58.46,0:05:04.47,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:05:18.86,0:05:21.86,Default,,0,0,0,,Хиодо-кун... сен қайтадан жақсарып келе жатырсың.
Dialogue: 0,0:05:23.19,0:05:24.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:26.57,0:05:28.91,Default,,0,0,0,,Әй, Саку!
Dialogue: 0,0:05:29.03,0:05:30.12,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:05:33.16,0:05:34.95,Default,,0,0,0,,Баумкухен?
Dialogue: 0,0:05:35.58,0:05:37.25,Default,,0,0,0,,Бұл сіз жейтін нәрсе ме?
Dialogue: 0,0:05:37.37,0:05:39.79,Default,,0,0,0,,Жоқ, біз 3-4 жаста...
Dialogue: 0,0:05:39.92,0:05:42.38,Default,,0,0,0,,Ол белсенді болған топтың аты.
Dialogue: 0,0:05:42.46,0:05:46.01,Default,,0,0,0,,Хмм, мен бұл туралы естігендей болдым. Мен ол туралы естіген жоқпын деп ойлаймын.
Dialogue: 0,0:05:46.13,0:05:49.97,Default,,0,0,0,,Масато Кохината сол топта гитарада ойнады.
Dialogue: 0,0:05:50.09,0:05:51.60,Default,,0,0,0,,Хиодоның әкесі
Dialogue: 0,0:05:51.72,0:05:53.51,Default,,0,0,0,,А... менің фамилиям басқа.
Dialogue: 0,0:05:53.64,0:05:57.85,Default,,0,0,0,,Иә, Хиодо менің анамның фамилиясы сияқты.
Dialogue: 0,0:05:57.98,0:05:59.06,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:05:59.19,0:06:02.32,Default,,0,0,0,,Оның ата-анасы екі рет ажырасқан...
Dialogue: 0,0:06:02.44,0:06:03.27,Default,,0,0,0,,Сонымен
Dialogue: 0,0:06:03.40,0:06:06.94,Default,,0,0,0,,Уау, сен сондай білімді екенсің.
Dialogue: 0,0:06:07.36,0:06:10.91,Default,,0,0,0,,Эй Танака-кун Сакурай-кун
Dialogue: 0,0:06:11.12,0:06:12.74,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:06:12.87,0:06:16.08,Default,,0,0,0,,Балалар, күзгі мәдени фестивальге бармайсыңдар ма?
Dialogue: 0,0:06:16.20,0:06:17.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:18.25,0:06:21.00,Default,,0,0,0,,Биыл мен де атқару комитетінің мүшесімін.
Dialogue: 0,0:06:21.13,0:06:24.17,Default,,0,0,0,,Музыкалық сайысты конкурстық форматқа айналдырыңыз—
Dialogue: 0,0:06:24.30,0:06:27.17,Default,,0,0,0,,Үздік гитарист немесе вокалист
Dialogue: 0,0:06:27.30,0:06:29.26,Default,,0,0,0,,Жеңімпаз топ та анықталады!
Dialogue: 0,0:06:29.38,0:06:32.93,Default,,0,0,0,,Сондықтан... міндетті түрде бізге қосылыңыз!
Dialogue: 0,0:06:34.47,0:06:35.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:36.85,0:06:38.27,Default,,0,0,0,,О... еркек!
Dialogue: 0,0:06:38.39,0:06:39.39,Default,,0,0,0,,Иә!?
Dialogue: 0,0:06:44.90,0:06:47.32,Default,,0,0,0,,Керемет гитарист...
Dialogue: 0,0:06:49.03,0:06:50.99,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:51.86,0:06:55.66,Default,,0,0,0,,(Махоның ән айту дауысы)
Dialogue: 0,0:07:09.42,0:07:11.76,Default,,0,0,0,,Әй, ертең боссың ба?
Dialogue: 0,0:07:11.88,0:07:15.81,Default,,0,0,0,,Кешіріңіз! Менің ертең маңызды бір ісім бар.
Dialogue: 0,0:07:15.93,0:07:18.10,Default,,0,0,0,,Бұл не? Маңызды бизнес?
Dialogue: 0,0:07:18.22,0:07:20.14,Default,,0,0,0,,Құпия
Dialogue: 0,0:07:20.27,0:07:22.98,Default,,0,0,0,,Эй, бұл да маңызды.
Dialogue: 0,0:07:23.10,0:07:25.15,Default,,0,0,0,,Бұл өте маңызды!
Dialogue: 0,0:07:25.27,0:07:28.23,Default,,0,0,0,,Бұл да өте маңызды.
Dialogue: 0,0:07:28.36,0:07:31.49,Default,,0,0,0,,Бұл өте ауыр салмақтағылар үшін маңызды!
Dialogue: 0,0:07:36.28,0:07:40.00,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:07:41.08,0:07:41.83,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:07:43.33,0:07:44.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:45.79,0:07:48.25,Default,,0,0,0,,Коюки, жақсысың ба?
Dialogue: 0,0:07:48.46,0:07:49.63,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:51.01,0:07:52.88,Default,,0,0,0,,Сіз бозарған сияқтысыз.
Dialogue: 0,0:07:53.01,0:07:56.55,Default,,0,0,0,,Негізі мен көлік түрімін.
Dialogue: 0,0:07:56.89,0:07:59.06,Default,,0,0,0,,Мен бәріне жақсы емеспін...
Dialogue: 0,0:07:59.18,0:08:02.64,Default,,0,0,0,,Бұл жағдайда ойын-сауық саябағына бару қызық болмас еді!
Dialogue: 0,0:08:05.81,0:08:07.19,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:08:17.66,0:08:19.58,Default,,0,0,0,,Мен оны мінгім келеді!
Dialogue: 0,0:08:19.70,0:08:21.25,Default,,0,0,0,,Не? Көлік...
Dialogue: 0,0:08:25.92,0:08:27.21,Default,,0,0,0,,Бұл жақсы!
Dialogue: 0,0:08:29.13,0:08:31.76,Default,,0,0,0,,Бірақ... аяғым таяққа айналды...
Dialogue: 0,0:08:32.09,0:08:34.55,Default,,0,0,0,,Махо Сіз дұрыс есіп жүрсіз бе?
Dialogue: 0,0:08:35.68,0:08:36.76,Default,,0,0,0,,Махо...
Dialogue: 0,0:08:37.01,0:08:39.43,Default,,0,0,0,,Амансың ба...?
Dialogue: 0,0:08:39.76,0:08:42.27,Default,,0,0,0,,Иә... бәрібір.
Dialogue: 0,0:08:43.43,0:08:44.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:49.82,0:08:52.19,Default,,0,0,0,,Сіздің қызуыңыз көтеріліп тұрған шығар.
Dialogue: 0,0:08:52.32,0:08:53.90,Default,,0,0,0,,Менің қызуым шамалы болғандықтан...
Dialogue: 0,0:08:54.32,0:08:56.57,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:08:57.70,0:08:59.33,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:08:59.45,0:09:02.29,Default,,0,0,0,,Неліктен дене қызуы көтеріліп тұрса да, келуге мәжбүрледің?
Dialogue: 0,0:09:02.95,0:09:04.41,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:09:13.71,0:09:15.72,Default,,0,0,0,,Сіз шынымен үйге жалғыз бара аласыз ба?
Dialogue: 0,0:09:16.76,0:09:19.80,Default,,0,0,0,,Иә, әкем вокзалға келеді.
Dialogue: 0,0:09:20.10,0:09:21.35,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:22.01,0:09:23.89,Default,,0,0,0,,Сонда сіз сенімді бола аласыз.
Dialogue: 0,0:09:25.06,0:09:28.81,Default,,0,0,0,,Коюки... Жүзу жарысы есіңізде ме?
Dialogue: 0,0:09:28.90,0:09:30.52,Default,,0,0,0,,Менің есімде...
Dialogue: 0,0:09:30.65,0:09:34.57,Default,,0,0,0,,Ғажайып жеңіс Махоның арқасында болды деп ойлаймын.
Dialogue: 0,0:09:34.69,0:09:37.11,Default,,0,0,0,,Хмм, олай емес...
Dialogue: 0,0:09:37.66,0:09:39.32,Default,,0,0,0,,Бәс тігу туралы не деуге болады?
Dialogue: 0,0:09:39.70,0:09:41.41,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:09:42.12,0:09:44.08,Default,,0,0,0,,Коюки жеңсе...
Dialogue: 0,0:09:44.62,0:09:46.83,Default,,0,0,0,,Не айтсаң да тыңдаймын
Dialogue: 0,0:09:47.50,0:09:48.54,Default,,0,0,0,,(Махоның түшкіруі)
Dialogue: 0,0:09:51.54,0:09:56.22,Default,,0,0,0,,Мен Махоның менімен кәсіби мансапты мақсат еткенін қалаймын.
Dialogue: 0,0:09:56.42,0:09:58.01,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:09:58.43,0:09:59.55,Default,,0,0,0,,Неге?
Dialogue: 0,0:09:59.68,0:10:01.05,Default,,0,0,0,,Махо да жақсы әнші...
Dialogue: 0,0:10:01.05,0:10:01.30,Default,,0,0,0,,Махо ән айтуды жақсы біледі...
Dialogue: 0,0:10:01.05,0:10:01.30,Default,,0,0,0,,(Темір жол өткелінің дабыл дыбысы)
Dialogue: 0,0:10:01.30,0:10:01.43,Default,,0,0,0,,(Темір жол өткелінің дабыл дыбысы)
Dialogue: 0,0:10:01.43,0:10:04.85,Default,,0,0,0,,(Темір жол өткелінің дабыл дыбысы)
Dialogue: 0,0:10:01.43,0:10:04.85,Default,,0,0,0,,Оның ағылшын тілін жақсы біледі және сүйкімді.
Dialogue: 0,0:10:04.85,0:10:06.06,Default,,0,0,0,,(Темір жол өткелінің дабыл дыбысы)
Dialogue: 0,0:10:06.18,0:10:08.10,Default,,0,0,0,,Сіз міндетті түрде кәсіпқой бола аласыз
Dialogue: 0,0:10:06.18,0:10:08.10,Default,,0,0,0,,Жақында бірінші қатарда болады...
Dialogue: 0,0:10:09.81,0:10:12.82,Default,,0,0,0,,Мен Коюкиден өзгешемін.
Dialogue: 0,0:10:13.19,0:10:16.44,Default,,0,0,0,,Өйткені... Коюки керемет.
Dialogue: 0,0:10:16.57,0:10:18.03,Default,,0,0,0,,(Махоның түшкіруі)
Dialogue: 0,0:10:18.15,0:10:20.32,Default,,0,0,0,,Амансың ба? (Махо) Иә.
Dialogue: 0,0:10:48.60,0:10:51.90,Default,,0,0,0,,(Коюкидің ауыр тыныс алуы)
Dialogue: 0,0:10:56.82,0:11:00.95,Default,,0,0,0,,Сайто-санның алғашқы сүйісі қандай болды?
Dialogue: 0,0:11:01.36,0:11:03.37,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:11:03.49,0:11:05.58,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:11:05.91,0:11:07.83,Default,,0,0,0,,Есте сақтау ауырады
Dialogue: 0,0:11:07.95,0:11:12.42,Default,,0,0,0,,Ол Йосивараның жасында болған кезде, ол 40-тан асқан оңай қыз болды.
Dialogue: 0,0:11:12.83,0:11:14.46,Default,,0,0,0,,Чигушо!
Dialogue: 0,0:11:14.59,0:11:20.05,Default,,0,0,0,,Маған жастық шағымды қайтар!
Dialogue: 0,0:11:20.17,0:11:21.47,Default,,0,0,0,,Сайто мырза...
Dialogue: 0,0:11:21.55,0:11:28.52,Default,,0,0,0,,(Гакудың ән салған дауысы)
Dialogue: 0,0:11:37.23,0:11:39.19,Default,,0,0,0,,Эйдзи!
Dialogue: 0,0:11:39.57,0:11:40.49,Default,,0,0,0,,Эйдзи Кун
Dialogue: 0,0:11:43.86,0:11:45.99,Default,,0,0,0,,Ғылым~!
Dialogue: 0,0:11:55.00,0:12:01.51,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:12:03.51,0:12:05.51,Default,,0,0,0,,Бұл әйелдердің керемет саны!
Dialogue: 0,0:12:05.97,0:12:09.14,Default,,0,0,0,,БЕК-ті жұмылдырғандар санымен салыстыруға келмейді.
Dialogue: 0,0:12:09.43,0:12:11.52,Default,,0,0,0,,Ғылым~!
Dialogue: 0,0:12:12.02,0:12:13.56,Default,,0,0,0,,Қоңырау тұтқасы...
Dialogue: 0,0:12:14.98,0:12:19.02,Default,,0,0,0,,Бұл... рок емес.
Dialogue: 0,0:12:19.40,0:12:22.45,Default,,0,0,0,,Бірақ сіздің негізгі дебютіңіз шешілді.
Dialogue: 0,0:12:23.15,0:12:24.95,Default,,0,0,0,,Рюсуке, қара!
Dialogue: 0,0:12:28.03,0:12:30.12,Default,,0,0,0,,Түпнұсқа нуар орхидеясы
Dialogue: 0,0:12:30.24,0:12:34.50,Default,,0,0,0,,Noir компакт-дискілерінің сатылуы музыка индустриясындағы маңызды кезең болып табылады.
Dialogue: 0,0:12:34.62,0:12:35.75,Default,,0,0,0,,Керемет~
Dialogue: 0,0:12:35.88,0:12:39.17,Default,,0,0,0,,Бұл визуалды рок әлеміндегі үлкен атаумен қамтамасыз етілген бе?
Dialogue: 0,0:12:39.30,0:12:41.55,Default,,0,0,0,,(Чиба есінеу)
Dialogue: 0,0:12:41.76,0:12:45.22,Default,,0,0,0,,Менің толық емес жұмыс күнім бар, сондықтан мен үйге бара жатырмын.
Dialogue: 0,0:12:45.34,0:12:46.89,Default,,0,0,0,,Менің де толық емес жұмысым бар.
Dialogue: 0,0:12:53.02,0:12:54.19,Default,,0,0,0,,Эйдзи…
Dialogue: 0,0:12:55.35,0:12:58.61,Default,,0,0,0,,Бұл сіз айтқан ең күшті топ па...
Dialogue: 0,0:13:17.54,0:13:24.38,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:13:27.64,0:13:31.26,Default,,0,0,0,,Юкио~ Минами мырза қоңырау шалып жатыр!
Dialogue: 0,0:13:31.39,0:13:32.35,Default,,0,0,0,,Иә
Dialogue: 0,0:13:39.56,0:13:41.07,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:13:41.61,0:13:43.23,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:13:45.28,0:13:45.95,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:13:45.95,0:13:47.07,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:13:45.95,0:13:47.07,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:13:47.07,0:13:47.78,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:13:48.07,0:13:49.16,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:13:49.53,0:13:55.54,Default,,0,0,0,,(Рюсукенің ағылшынша әңгімесі)
Dialogue: 0,0:13:57.62,0:13:58.33,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:13:58.33,0:13:58.54,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:13:58.33,0:13:58.54,Default,,0,0,0,,Махо?
Dialogue: 0,0:13:58.54,0:13:59.38,Default,,0,0,0,,Махо?
Dialogue: 0,0:13:59.67,0:14:02.13,Default,,0,0,0,,Иә!? Жоқ, досым.
Dialogue: 0,0:14:02.25,0:14:03.80,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:10.93,0:14:12.85,Default,,0,0,0,,Бұл өте қызықты.
Dialogue: 0,0:14:12.97,0:14:14.52,Default,,0,0,0,,Бірақ бұл шынымен келе ме?
Dialogue: 0,0:14:14.64,0:14:16.52,Default,,0,0,0,,А, мен енді күте алмаймын!
Dialogue: 0,0:14:16.64,0:14:19.56,Default,,0,0,0,,Шынымен хахаха...
Dialogue: 0,0:14:20.44,0:14:22.02,Default,,0,0,0,,Бүгінгі күн керемет.
Dialogue: 0,0:14:22.15,0:14:25.61,Default,,0,0,0,,Мен де сыртқа шығып, таңғажайып адамдарды көрдім.
Dialogue: 0,0:14:25.73,0:14:28.11,Default,,0,0,0,,Бүгін осындай керемет топ шығады ма?
Dialogue: 0,0:14:28.24,0:14:31.74,Default,,0,0,0,,Біздің танымалдылығымыз... солай емес пе?
Dialogue: 0,0:14:33.49,0:14:35.41,Default,,0,0,0,,Едіге келе жатыр.
Dialogue: 0,0:14:35.62,0:14:37.37,Default,,0,0,0,,Иә! (Тайра, Саку, Чиба) Хмм...
Dialogue: 0,0:14:37.87,0:14:41.42,Default,,0,0,0,,Иә... Дайбуридің Жапонияға келгені рас...
Dialogue: 0,0:14:41.63,0:14:42.63,Default,,0,0,0,,О...
Dialogue: 0,0:14:42.75,0:14:46.05,Default,,0,0,0,,Ақпарат бір жерден шығып кеткен болуы мүмкін.
Dialogue: 0,0:14:47.38,0:14:49.72,Default,,0,0,0,,Бүгінгі тұтынушы Эддиді іздейді.
Dialogue: 0,0:14:49.84,0:14:51.80,Default,,0,0,0,,Бұл қалжың ба?
Dialogue: 0,0:14:51.93,0:14:53.76,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:14:53.89,0:14:56.06,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:14:56.60,0:15:00.27,Default,,0,0,0,,Сәлем! Абайсызда ештеңе айтпа!
Dialogue: 0,0:15:02.02,0:15:04.94,Default,,0,0,0,,Мен сендерге қысым болады деп ойладым.
Dialogue: 0,0:15:05.15,0:15:08.19,Default,,0,0,0,,Қысым туралы не деуге болады? Ақымақ!
Dialogue: 0,0:15:08.32,0:15:10.36,Default,,0,0,0,,Егер Дибриден Эдди Ли келсе...
Dialogue: 0,0:15:10.49,0:15:13.28,Default,,0,0,0,,Бұл БЕК-ті сатудың тамаша мүмкіндігі!
Dialogue: 0,0:15:13.41,0:15:14.91,Default,,0,0,0,,Чиба-кун...
Dialogue: 0,0:15:15.20,0:15:16.58,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ!
Dialogue: 0,0:15:16.70,0:15:18.62,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:15:21.92,0:15:23.71,Default,,0,0,0,,Бір екі!
Dialogue: 0,0:15:21.92,0:15:23.71,Default,,0,0,0,,(цимбал санау дыбысы)
Dialogue: 0,0:15:23.71,0:15:24.59,Default,,0,0,0,,(цимбал санау дыбысы)
Dialogue: 0,0:15:24.67,0:15:30.67,Default,,0,0,0,,♪「ӨМІР ДӘТТІЛЕРІ」
Dialogue: 0,0:15:34.47,0:15:38.85,Default,,0,0,0,,(Чиба орамы)
Dialogue: 0,0:16:14.09,0:16:15.59,Default,,0,0,0,,Коюки!
Dialogue: 0,0:16:15.97,0:16:16.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:39.37,0:16:40.45,Default,,0,0,0,,Ах
Dialogue: 0,0:16:40.58,0:16:42.37,Default,,0,0,0,,Иә? (Еркек) Эй Махо
Dialogue: 0,0:16:42.45,0:16:44.21,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:44.29,0:16:45.71,Default,,0,0,0,,(Ерлер ағылшын)
Dialogue: 0,0:16:47.33,0:16:51.38,Default,,0,0,0,,(Көрермендердің қошеметі мен қошеметі)
Dialogue: 0,0:16:56.30,0:16:57.39,Default,,0,0,0,,Фу…
Dialogue: 0,0:17:02.73,0:17:04.14,Default,,0,0,0,,Хмм?
Dialogue: 0,0:17:05.06,0:17:06.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:06.77,0:17:08.90,Default,,0,0,0,,Ой, бұл өтірік!?
Dialogue: 0,0:17:08.98,0:17:12.90,Default,,0,0,0,,(Қонақтардың шуы)
Dialogue: 0,0:17:13.28,0:17:14.11,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:17:14.19,0:17:17.11,Default,,0,0,0,,Сәлем Эдди Ли! екінші ойлар туралы! сену мүмкін емес! …
Dialogue: 0,0:17:18.03,0:17:19.07,Default,,0,0,0,,Бұл қандай да бір «Гя●ган» ба?!
Dialogue: 0,0:17:19.87,0:17:21.20,Default,,0,0,0,,Рэй!
Dialogue: 0,0:17:25.58,0:17:28.00,Default,,0,0,0,,〈Бұл біртүрлі Махо〉
Dialogue: 0,0:17:28.13,0:17:29.29,Default,,0,0,0,,<Мен барлығына кейінірек қол қоямын>
Dialogue: 0,0:17:29.42,0:17:31.21,Default,,0,0,0,,Маған үндемеуімді айта аласыз ба? 〉
Dialogue: 0,0:17:32.92,0:17:33.96,Default,,0,0,0,,ＯＫ！
Dialogue: 0,0:17:34.09,0:17:35.84,Default,,0,0,0,,үшінң тыныш болыңдар!
Dialogue: 0,0:17:35.97,0:17:38.68,Default,,0,0,0,,Эдди тікелей эфирді көруге келеді!
Dialogue: 0,0:17:40.76,0:17:42.60,Default,,0,0,0,,<Топты аяймын>
Dialogue: 0,0:17:42.72,0:17:45.60,Default,,0,0,0,,<Осы жігіттерді ілу керек пе? 〉
Dialogue: 0,0:17:45.73,0:17:48.48,Default,,0,0,0,,〈Ей, егер сіз тағы да қиындық тудырсаңыз...〉
Dialogue: 0,0:17:48.60,0:17:50.52,Default,,0,0,0,,〈Турдан бас тартылады〉
Dialogue: 0,0:17:52.82,0:17:54.28,Default,,0,0,0,,Сіз Коюкиді білесіз бе?
Dialogue: 0,0:17:54.40,0:17:55.69,Default,,0,0,0,,Мэтт Швециядағы тікелей шоуда —
Dialogue: 0,0:17:56.11,0:17:58.66,Default,,0,0,0,,Ол ПБ-ны ұнатпайтынын айтып, үйіне кетті.
Dialogue: 0,0:17:59.49,0:18:02.20,Default,,0,0,0,,Бірінші ән аяқталғанда, «Ертең кездескенше» деңіз
Dialogue: 0,0:18:02.33,0:18:03.91,Default,,0,0,0,,Ол қайтып келгенін айтты.
Dialogue: 0,0:18:04.62,0:18:08.79,Default,,0,0,0,,Бірдеңе... Бұл тіпті тікелей эфир емес.
Dialogue: 0,0:18:08.92,0:18:11.59,Default,,0,0,0,,Дұрыс... Екеуіңді осында шақырайын ба?
Dialogue: 0,0:18:11.71,0:18:13.34,Default,,0,0,0,,Ум...
Dialogue: 0,0:18:13.46,0:18:16.09,Default,,0,0,0,,Жоқ, бұл біздің кезең.
Dialogue: 0,0:18:16.17,0:18:17.01,Default,,0,0,0,,Иә
Dialogue: 0,0:18:17.09,0:18:18.84,Default,,0,0,0,,Коюки! Ха!
Dialogue: 0,0:18:18.97,0:18:21.22,Default,,0,0,0,,Әнді өткізіп жіберіп, “FACE” ойнаңыз
Dialogue: 0,0:18:22.43,0:18:23.51,Default,,0,0,0,,О!
Dialogue: 0,0:18:24.68,0:18:25.52,Default,,0,0,0,,Махо...
Dialogue: 0,0:18:28.10,0:18:33.52,Default,,0,0,0,,♪「БЕТ」
Dialogue: 0,0:18:36.61,0:18:40.36,Default,,0,0,0,,(Коюкидің ағылшынша ән айтатын дауысы)
Dialogue: 0,0:19:12.69,0:19:19.03,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:19:20.53,0:19:24.41,Default,,0,0,0,,Ән жақсы болды, бірақ гитара қорқынышты болды.
Dialogue: 0,0:19:37.30,0:19:39.38,Default,,0,0,0,,Бұл жақсы көрінеді.
Dialogue: 0,0:19:39.51,0:19:40.72,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:19:40.80,0:19:45.97,Default,,0,0,0,,(ағылшынша мат деген сөз)
Dialogue: 0,0:19:46.18,0:19:47.31,Default,,0,0,0,,(Эдди Ағылшын тілі)
Dialogue: 0,0:19:47.31,0:19:48.02,Default,,0,0,0,,(Эдди Ағылшын тілі)
Dialogue: 0,0:19:47.31,0:19:48.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:48.02,0:19:48.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:50.18,0:19:53.23,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:19:53.60,0:19:55.86,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:19:56.94,0:19:58.28,Default,,0,0,0,,Кездескенше!
Dialogue: 0,0:20:06.45,0:20:08.49,Default,,0,0,0,,Махо! Оны қазір аударыңыз!
Dialogue: 0,0:20:08.62,0:20:11.87,Default,,0,0,0,,Хмм? Гитара керемет емес
Dialogue: 0,0:20:14.25,0:20:16.04,Default,,0,0,0,,Бірақ ән жақсы.
Dialogue: 0,0:20:16.17,0:20:18.96,Default,,0,0,0,,Шынымен бе? Эдди!?
Dialogue: 0,0:20:19.09,0:20:22.42,Default,,0,0,0,,Эхехе хахаха...
Dialogue: 0,0:20:25.89,0:20:27.18,Default,,0,0,0,,<Жақсысың ба?>
Dialogue: 0,0:20:34.14,0:20:36.40,Default,,0,0,0,,Мэтт, жақсысың ба?
Dialogue: 0,0:20:40.69,0:20:43.28,Default,,0,0,0,,Бұл арман сияқты...
Dialogue: 0,0:20:43.65,0:20:47.20,Default,,0,0,0,,Дайбуриден Эдди мен Мэтт менің дүкеніме келді...
Dialogue: 0,0:20:49.12,0:20:52.79,Default,,0,0,0,,Едігенің қолтаңбасын мүлдем өшірме!
Dialogue: 0,0:20:52.91,0:20:55.29,Default,,0,0,0,,Дұрыс айтасыз! Бұл дүкен қазынасы!
Dialogue: 0,0:20:55.96,0:21:00.21,Default,,0,0,0,,Бірақ мен Мэтттің ашулануының қалдықтарын дереу тазалауым керек.
Dialogue: 0,0:21:01.51,0:21:02.97,Default,,0,0,0,,Сәлем Рэй
Dialogue: 0,0:21:03.09,0:21:04.30,Default,,0,0,0,,〈Сіз маған Люсильді бере аласыз ба? 〉
Dialogue: 0,0:21:05.26,0:21:06.80,Default,,0,0,0,,<Есіңіз дұрыс па? 〉
Dialogue: 0,0:21:07.22,0:21:10.60,Default,,0,0,0,,<Бүгінгі тікелей эфирді көргеннен кейін мен оны ойнағым келді>
Dialogue: 0,0:21:10.81,0:21:14.02,Default,,0,0,0,,〈Бірақ олар білсе, сіздің өміріңіз міндетті түрде нысанаға алынады.〉
Dialogue: 0,0:21:15.85,0:21:17.81,Default,,0,0,0,,<Дұрыс>
Dialogue: 0,0:21:18.73,0:21:20.82,Default,,0,0,0,,<Бұл ақылсыз>
Dialogue: 0,0:21:23.28,0:21:26.07,Default,,0,0,0,,<Қазіргі кезде мұндай нәрсе танымал ма? 〉
Dialogue: 0,0:21:26.28,0:21:28.57,Default,,0,0,0,,〈О, керемет нәрсе〉
Dialogue: 0,0:21:28.74,0:21:30.66,Default,,0,0,0,,<Дұрыс, жылтыр.>
Dialogue: 0,0:21:35.00,0:21:36.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:40.46,0:21:41.67,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:42.55,0:21:43.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:46.09,0:21:47.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:47.76,0:21:49.34,Default,,0,0,0,,(Мэттің күбірлеген дауысы)
Dialogue: 0,0:21:49.80,0:21:52.51,Default,,0,0,0,,Мэтт Сіз өте мас сияқтысыз...
Dialogue: 0,0:21:53.31,0:21:55.23,Default,,0,0,0,,Сен мені жек көрдің бе...?
Dialogue: 0,0:21:55.56,0:21:59.02,Default,,0,0,0,,Хмм, есіңізде жоқ екеніне сенімдімін.
Dialogue: 0,0:21:59.86,0:22:02.36,Default,,0,0,0,,〈Ертеңгі күні бізде жасырын тікелей эфир бар.〉
Dialogue: 0,0:22:02.48,0:22:04.82,Default,,0,0,0,,〈Кел, топпен ойна! 〉
Dialogue: 0,0:22:05.53,0:22:06.86,Default,,0,0,0,,〈Жақсысың ба? 〉
Dialogue: 0,0:22:07.57,0:22:09.45,Default,,0,0,0,,<Әрине, Рэй>
Dialogue: 0,0:22:10.62,0:22:12.87,Default,,0,0,0,,<Бүгін көңілді болды! 〉
Dialogue: 0,0:22:13.74,0:22:15.79,Default,,0,0,0,,<Онда өмір сүр! 〉
Dialogue: 0,0:22:16.62,0:22:19.42,Default,,0,0,0,,(Эдди Ағылшын тілі)
Dialogue: 0,0:22:22.96,0:22:27.26,Default,,0,0,0,,Эдди мен Мэтт дәл менің алдымда.
Dialogue: 0,0:22:27.84,0:22:29.89,Default,,0,0,0,,Бұл шындық
Dialogue: 0,0:22:31.05,0:22:33.14,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,0:22:36.85,0:22:42.86,Default,,0,0,0,,♪～
Dialogue: 0,0:24:03.44,0:24:06.40,Default,,0,0,0,,～♪
Dialogue: 0,0:24:07.19,0:24:10.49,Default,,0,0,0,,үшінң караокеде не айтасыңдар?
Dialogue: 0,0:24:10.61,0:24:13.86,Default,,0,0,0,,Мен...хехехе...мен...
Dialogue: 0,0:24:15.36,0:24:21.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
