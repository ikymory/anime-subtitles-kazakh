Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.45,0:00:06.96,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.67,0:01:36.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:04.12,0:02:05.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:05.33,0:02:09.25,Default,,0,0,0,,(Эддидің ағылшыншасы)
Dialogue: 0,0:02:14.09,0:02:17.22,Default,,0,0,0,,Туған күнің құтты болсын
Dialogue: 0,0:02:17.34,0:02:18.51,Default,,0,0,0,,Эдди!
Dialogue: 0,0:02:19.05,0:02:21.76,Default,,0,0,0,,(Эдди мен Мэтт күледі)
Dialogue: 0,0:02:44.28,0:02:45.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:49.62,0:02:50.50,Default,,0,0,0,,Хехе
Dialogue: 0,0:02:51.37,0:02:52.38,Default,,0,0,0,,Иә
Dialogue: 0,0:03:25.12,0:03:27.87,Default,,0,0,0,,Баяғыда кеңседегі әйел...
Dialogue: 0,0:03:27.99,0:03:30.79,Default,,0,0,0,,Сіз жұмыстан кенеттен шығып кеткенде не ойладыңыз?
Dialogue: 0,0:03:30.91,0:03:32.79,Default,,0,0,0,,Музыканы жақсы көретін досымнан басталды.
Dialogue: 0,0:03:32.92,0:03:35.34,Default,,0,0,0,,Жазғы ерекше алғыс дыбысы
Dialogue: 0,0:03:36.29,0:03:37.42,Default,,0,0,0,,Бастапқыда Англиядан —
Dialogue: 0,0:03:37.55,0:03:39.88,Default,,0,0,0,,Гластонбери фестивалінен әсер алған —
Dialogue: 0,0:03:40.01,0:03:43.97,Default,,0,0,0,,Жапониядағы жанкүйерлер дайындаған таза рок фестивалін өткізе аламыз ба?
Dialogue: 0,0:03:44.26,0:03:46.43,Default,,0,0,0,,Барлығы осындай қарапайым мотивтен басталды...
Dialogue: 0,0:03:46.55,0:03:49.06,Default,,0,0,0,,Алғыс білдіретін дыбыс
Dialogue: 0,0:03:50.56,0:03:54.94,Default,,0,0,0,,Бұл қазір Жапониядағы ең үлкен ашық іс-шара.
Dialogue: 0,0:03:55.06,0:03:57.44,Default,,0,0,0,,Сіз кеңсе ханымысыз ба?
Dialogue: 0,0:03:57.57,0:03:58.86,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:59.78,0:04:02.36,Default,,0,0,0,,Менің әпкем былтыр қайтыс болды
Dialogue: 0,0:04:03.03,0:04:04.45,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,0:04:06.24,0:04:09.33,Default,,0,0,0,,Кенеттен болғаным үшін кешіріңіз, бірақ сөзге көшейік.
Dialogue: 0,0:04:09.66,0:04:10.62,Default,,0,0,0,,О
Dialogue: 0,0:04:10.70,0:04:13.87,Default,,0,0,0,,Дайбри мүшелерін білесің бе?
Dialogue: 0,0:04:14.08,0:04:15.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:15.29,0:04:18.71,Default,,0,0,0,,Мен сіздің концертіңізге Daibri тобының екі мүшесі келгенін естідім.
Dialogue: 0,0:04:18.84,0:04:19.88,Default,,0,0,0,,О
Dialogue: 0,0:04:20.13,0:04:22.51,Default,,0,0,0,,Олар өліп жатқан тұқым -
Dialogue: 0,0:04:22.63,0:04:25.13,Default,,0,0,0,,Мен сізді ризашылық дыбыс деп атай аламын ба?
Dialogue: 0,0:04:25.51,0:04:27.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:27.18,0:04:30.18,Default,,0,0,0,,Олар дүниежүзілік саяхатын аяқтап, қазір кетіп қалды.
Dialogue: 0,0:04:30.31,0:04:34.14,Default,,0,0,0,,Хм, сен не айтып тұрғаныңды білесің!
Dialogue: 0,0:04:34.27,0:04:35.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:37.61,0:04:39.52,Default,,0,0,0,,Енді ризашылық дыбысы —
Dialogue: 0,0:04:39.65,0:04:41.48,Default,,0,0,0,,Ақша жасау құралына ұқсайды
Dialogue: 0,0:04:41.61,0:04:45.28,Default,,0,0,0,,Әйтеуір мен дұрыс емес бағытқа кетіп бара жатқандай сезінемін.
Dialogue: 0,0:04:46.82,0:04:49.20,Default,,0,0,0,,Ран, жапон жағындағы продюсер—
Dialogue: 0,0:04:49.33,0:04:51.33,Default,,0,0,0,,Мендегі белгі Bell Arm деп аталады.
Dialogue: 0,0:04:51.45,0:04:56.12,Default,,0,0,0,,Йошито Морозуми есімді жас актер пайдасыз топқа қосылады.
Dialogue: 0,0:04:56.46,0:04:58.75,Default,,0,0,0,,Мен оны көрсетуге және шығаруға тырысамын.
Dialogue: 0,0:05:01.09,0:05:03.30,Default,,0,0,0,,Менің әпкем...
Dialogue: 0,0:05:03.92,0:05:06.47,Default,,0,0,0,,Музыка әлемді, адамдардың санасын өзгерте алады.
Dialogue: 0,0:05:06.59,0:05:08.47,Default,,0,0,0,,Ол мен ойлаған адам.
Dialogue: 0,0:05:09.64,0:05:13.35,Default,,0,0,0,,Рэн мен Леон Сайкстың RJ белгісі...
Dialogue: 0,0:05:13.47,0:05:15.64,Default,,0,0,0,,Өзін жақсы сезінетін поп-музыка
Dialogue: 0,0:05:15.73,0:05:18.56,Default,,0,0,0,,Барлығы жақсы деп айтатын эскапист музыкасы...
Dialogue: 0,0:05:18.69,0:05:20.65,Default,,0,0,0,,Адамдардың санасын сал...
Dialogue: 0,0:05:20.73,0:05:23.53,Default,,0,0,0,,Өмірімізде кездесетін әртүрлі мәселелер туралы ойлау қабілеті.
Dialogue: 0,0:05:23.65,0:05:26.15,Default,,0,0,0,,Оны алып кетші Иә!
Dialogue: 0,0:05:26.65,0:05:27.66,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:28.03,0:05:31.62,Default,,0,0,0,,Жақсы сезінетін поп-топ...
Dialogue: 0,0:05:31.74,0:05:35.33,Default,,0,0,0,,Маған дүниеде қанша адам бар екені маңызды емес.
Dialogue: 0,0:05:35.62,0:05:38.62,Default,,0,0,0,,Оларға ризашылық үні—
Dialogue: 0,0:05:38.75,0:05:40.84,Default,,0,0,0,,Мен айналысқым келмейді
Dialogue: 0,0:05:41.09,0:05:44.55,Default,,0,0,0,,Музыканың әлемді өзгерту күші бар ма?
Dialogue: 0,0:05:44.67,0:05:46.05,Default,,0,0,0,,Иә
Dialogue: 0,0:05:46.34,0:05:47.76,Default,,0,0,0,,Кем дегенде—
Dialogue: 0,0:05:48.18,0:05:49.09,Default,,0,0,0,,Бұл өліп жатқан тұқымда.
Dialogue: 0,0:05:49.09,0:05:49.93,Default,,0,0,0,,Өліп бара жатқан тұқымда бар.
Dialogue: 0,0:05:49.09,0:05:49.93,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:05:49.93,0:05:50.47,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:05:50.47,0:05:50.80,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:05:50.47,0:05:50.80,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:05:50.80,0:05:51.85,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:05:52.22,0:05:53.51,Default,,0,0,0,,Хе
Dialogue: 0,0:05:53.64,0:05:55.68,Default,,0,0,0,,Маған ұнады, Обачан.
Dialogue: 0,0:05:55.93,0:05:58.81,Default,,0,0,0,,А... ақсақал?
Dialogue: 0,0:05:58.94,0:06:00.98,Default,,0,0,0,,Мен қазір Эддиге хабарласамын.
Dialogue: 0,0:06:01.36,0:06:02.48,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:06:02.94,0:06:06.49,Default,,0,0,0,,Егер сіз бізге Grateful Sound-қа қоссаңыз.
Dialogue: 0,0:06:09.45,0:06:10.53,Default,,0,0,0,,Жоқ!!
Dialogue: 0,0:06:11.07,0:06:12.28,Default,,0,0,0,,Хм...!
Dialogue: 0,0:06:13.66,0:06:15.29,Default,,0,0,0,,Иә, шын мәнінде...
Dialogue: 0,0:06:15.37,0:06:18.50,Default,,0,0,0,,Моңғол Chop Squad CD тыңдау—
Dialogue: 0,0:06:18.62,0:06:20.88,Default,,0,0,0,,Сіз ризашылық дыбысына қатысып жатырсыз.
Dialogue: 0,0:06:21.00,0:06:23.80,Default,,0,0,0,,Мен оны ұсындым.
Dialogue: 0,0:06:23.88,0:06:26.67,Default,,0,0,0,,Қатты қылмыстар қаласы асығыс таратылды.
Dialogue: 0,0:06:26.80,0:06:28.88,Default,,0,0,0,,Рельеф ретінде.
Dialogue: 0,0:06:29.09,0:06:30.01,Default,,0,0,0,,Нихихи…
Dialogue: 0,0:06:30.09,0:06:32.80,Default,,0,0,0,,Басқа кәсіби топтармен салыстырғанда сапасы...
Dialogue: 0,0:06:32.93,0:06:35.52,Default,,0,0,0,,Бұл туралы мүлдем айтудың қажеті жоқ.
Dialogue: 0,0:06:35.60,0:06:38.02,Default,,0,0,0,,Хмм...! Хмф!
Dialogue: 0,0:06:38.31,0:06:41.27,Default,,0,0,0,,Болашақ перспективаларды және төмен шығындарды бағалау -
Dialogue: 0,0:06:41.40,0:06:44.02,Default,,0,0,0,,Менімен келіскен адамдар болды.
Dialogue: 0,0:06:44.36,0:06:45.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:46.11,0:06:47.53,Default,,0,0,0,,Бірақ...?
Dialogue: 0,0:06:47.74,0:06:49.90,Default,,0,0,0,,Ран қабылдамаған
Dialogue: 0,0:06:52.49,0:06:54.41,Default,,0,0,0,,Себебі не екенін білмеймін, бірақ...
Dialogue: 0,0:06:54.53,0:06:59.33,Default,,0,0,0,,Бұл салада Ран сізді байқап қалса, көпшілікке шығу қиын болуы мүмкін.
Dialogue: 0,0:07:00.37,0:07:02.25,Default,,0,0,0,,Сондықтан мен жарысқа шығамын.
Dialogue: 0,0:07:02.33,0:07:04.25,Default,,0,0,0,,Мм...!
Dialogue: 0,0:07:04.67,0:07:06.42,Default,,0,0,0,,Обачан және—
Dialogue: 0,0:07:07.00,0:07:10.51,Default,,0,0,0,,Леонның сақтық көшірмесімен бұл мүмкін емес.
Dialogue: 0,0:07:11.59,0:07:13.85,Default,,0,0,0,,Оның екі аптадан кейін Австралиядан келетініне сенімдімін.
Dialogue: 0,0:07:13.97,0:07:17.01,Default,,0,0,0,,Сіз тоқтайтыныңызды айттыңыз. Хмм.
Dialogue: 0,0:07:18.22,0:07:20.64,Default,,0,0,0,,Мен Леон Сайкспен тікелей сөйлесуді шештім.
Dialogue: 0,0:07:21.44,0:07:23.98,Default,,0,0,0,,Танысқаныма қуаныштымын! Хмм...
Dialogue: 0,0:07:24.11,0:07:25.48,Default,,0,0,0,,Обачан...
Dialogue: 0,0:07:25.57,0:07:28.40,Default,,0,0,0,,Менің атым Казуо Сато.
Dialogue: 0,0:07:31.70,0:07:32.61,Default,,0,0,0,,Бұл қызықты болды.
Dialogue: 0,0:07:32.74,0:07:34.82,Default,,0,0,0,,Иә! Эдди өте керемет~
Dialogue: 0,0:07:34.95,0:07:36.37,Default,,0,0,0,,Мэтт ше?
Dialogue: 0,0:07:36.49,0:07:37.91,Default,,0,0,0,,Уау, мен бір нәрседен қорқып тұрған шығармын.
Dialogue: 0,0:07:38.04,0:07:40.46,Default,,0,0,0,,Ендеше, ән айтып тұрған қыз кім еді?
Dialogue: 0,0:07:40.71,0:07:42.87,Default,,0,0,0,,Мен Юкико туралы ешқашан естіген емеспін.
Dialogue: 0,0:07:42.96,0:07:43.96,Default,,0,0,0,,Атсуко да~
Dialogue: 0,0:07:44.21,0:07:46.63,Default,,0,0,0,,Иә!? Grateful Sound бағдарламасында көрінесіз бе?
Dialogue: 0,0:07:46.75,0:07:48.34,Default,,0,0,0,,Жарайды, бұл қоңырау қолы деп аталады.
Dialogue: 0,0:07:48.46,0:07:50.30,Default,,0,0,0,,Мен жаңа топпен жұмыс істеймін.
Dialogue: 0,0:07:50.42,0:07:52.84,Default,,0,0,0,,Альбом күзде шығады деп жоспарланған
Dialogue: 0,0:07:52.97,0:07:55.22,Default,,0,0,0,,Әнші... (Махо) Бұл керемет.
Dialogue: 0,0:07:56.80,0:07:58.60,Default,,0,0,0,,Аха... (Махо) Олай болса...
Dialogue: 0,0:07:58.72,0:08:00.18,Default,,0,0,0,,Бірдеңе жейік
Dialogue: 0,0:08:00.31,0:08:02.31,Default,,0,0,0,,Аа, мен өттім.
Dialogue: 0,0:08:02.44,0:08:05.10,Default,,0,0,0,,Иә~ Біз жақсы араласпаймыз.
Dialogue: 0,0:08:05.23,0:08:07.06,Default,,0,0,0,,Мен Рюсукенің жарақатына алаңдаймын.
Dialogue: 0,0:08:07.06,0:08:07.73,Default,,0,0,0,,Мен Рюсукенің жарақатына алаңдаймын.
Dialogue: 0,0:08:07.06,0:08:07.73,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:08:07.73,0:08:08.23,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:08:09.19,0:08:12.57,Default,,0,0,0,,Аа, мен кино көріп отыр едім.
Dialogue: 0,0:08:12.70,0:08:13.78,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:08:13.91,0:08:15.24,Default,,0,0,0,,Бүгін жұма.
Dialogue: 0,0:08:15.70,0:08:18.37,Default,,0,0,0,,Махо: Бір күні дүкенде Эгучи-санмен бірге...
Dialogue: 0,0:08:18.49,0:08:21.25,Default,,0,0,0,,Йохеи Таками мен Чиеми Куниоши бар.
Dialogue: 0,0:08:21.45,0:08:25.25,Default,,0,0,0,,Ей, әлгі ерекше салат дәмді ғой, солай емес пе?
Dialogue: 0,0:08:25.37,0:08:28.25,Default,,0,0,0,,Аа, мен Коюки Чиеми Куниосиді айтып тұрғанына сенімдімін...
Dialogue: 0,0:08:28.38,0:08:31.51,Default,,0,0,0,,Ха ха… Менде барлық компакт-дискілер бар және жанкүйермін!
Dialogue: 0,0:08:31.59,0:08:34.47,Default,,0,0,0,,Ой, мен Рюсукенің жарақатына алаңдап отырмын.
Dialogue: 0,0:08:34.59,0:08:36.59,Default,,0,0,0,,Сол түкірікті үстіне қойсаң, жазылып кетеді!
Dialogue: 0,0:08:36.72,0:08:39.01,Default,,0,0,0,,Бұл өте жаман...
Dialogue: 0,0:08:39.14,0:08:41.47,Default,,0,0,0,,Көпшілікке рұқсат етілмейді.
Dialogue: 0,0:08:43.94,0:08:45.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:45.52,0:08:47.77,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:08:48.06,0:08:51.73,Default,,0,0,0,,Хехе, Рюсукеге сәлем айтыңыз~
Dialogue: 0,0:08:51.82,0:08:53.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:16.05,0:09:17.43,Default,,0,0,0,,Я...
Dialogue: 0,0:09:25.81,0:09:27.52,Default,,0,0,0,,Әйтеуір жақсы болады.
Dialogue: 0,0:09:27.65,0:09:29.90,Default,,0,0,0,,Сәлем! Бұл сенімнің негізі неде?
Dialogue: 0,0:09:30.27,0:09:31.82,Default,,0,0,0,,Саана
Dialogue: 0,0:09:32.90,0:09:35.70,Default,,0,0,0,,Сіз оны дұрыс түсіндіре алмайсыз ба?
Dialogue: 0,0:09:35.90,0:09:38.91,Default,,0,0,0,,Аш болсаң, ашуланасың.
Dialogue: 0,0:09:42.03,0:09:45.20,Default,,0,0,0,,Чиеми Куниошимен шынымен кездескіңіз келді ме?
Dialogue: 0,0:09:45.33,0:09:47.92,Default,,0,0,0,,Иә... бүгін түн ұйқысыз өтеді.
Dialogue: 0,0:09:55.30,0:09:59.14,Default,,0,0,0,,Мен бұрын түс көрдім
Dialogue: 0,0:10:04.52,0:10:07.69,Default,,0,0,0,,Ол тұман сияқты ақшыл және бұлыңғыр болды.
Dialogue: 0,0:10:07.81,0:10:10.90,Default,,0,0,0,,Үлкен жерде көп қоқыс жатыр.
Dialogue: 0,0:10:11.02,0:10:12.44,Default,,0,0,0,,Ах!!
Dialogue: 0,0:10:13.48,0:10:14.57,Default,,0,0,0,,Өте ыстық!! Ақымақ, сен мені өлтірмекшісің бе!?
Dialogue: 0,0:10:14.57,0:10:18.20,Default,,0,0,0,,Өте ыстық!! Ақымақ, сен мені өлтірмекшісің бе!?
Dialogue: 0,0:10:14.57,0:10:18.20,Default,,0,0,0,,Уау! А... жоқ...
Dialogue: 0,0:10:18.40,0:10:21.62,Default,,0,0,0,,Сіз қоқысты жинап жатқансыз, солай ма?
Dialogue: 0,0:10:21.74,0:10:23.70,Default,,0,0,0,,Өлі рок харизматикасы
Dialogue: 0,0:10:24.58,0:10:25.95,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:10:26.66,0:10:30.67,Default,,0,0,0,,«Мен сіздің концертіңізден кейін жинап жатырмын».
Dialogue: 0,0:10:32.38,0:10:35.13,Default,,0,0,0,,Сид оны шаршаған кейіппен алды.
Dialogue: 0,0:10:37.05,0:10:41.84,Default,,0,0,0,,Ой, мен сол түс көргеннен кейін дене қызуым 39 градус 6 минутқа көтерілді.
Dialogue: 0,0:10:45.60,0:10:48.35,Default,,0,0,0,,Мен олардың не ойлайтынын білмеймін, бірақ...
Dialogue: 0,0:10:48.60,0:10:52.94,Default,,0,0,0,,Бұл әлемде тек ғажайып деп санауға болатын кездесулерден туған топтар бар.
Dialogue: 0,0:10:53.86,0:10:55.94,Default,,0,0,0,,Тек ешкім емес
Dialogue: 0,0:10:56.86,0:10:58.69,Default,,0,0,0,,Тек солардың қолынан келеді
Dialogue: 0,0:11:04.78,0:11:06.70,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:11:06.83,0:11:09.08,Default,,0,0,0,,Хаа!! Хмм~
Dialogue: 0,0:11:09.37,0:11:11.62,Default,,0,0,0,,Эй, эй! Күте тұрыңыз, мен...
Dialogue: 0,0:11:11.75,0:11:14.21,Default,,0,0,0,,Менің мұндай арманым жоқ!
Dialogue: 0,0:11:14.96,0:11:16.50,Default,,0,0,0,,О... мен әрқашан-
Dialogue: 0,0:11:16.63,0:11:20.93,Default,,0,0,0,,Мен толық түсті 3D панорамалық кескінмен армандаймын.
Dialogue: 0,0:11:21.30,0:11:25.55,Default,,0,0,0,,Ризашылық дыбысына қатысуды білдіретін арман бар ма?
Dialogue: 0,0:11:25.68,0:11:27.31,Default,,0,0,0,,Фрагменттерге де қарамаңыз!!
Dialogue: 0,0:11:27.43,0:11:31.85,Default,,0,0,0,,А, жоқ, Чиба-кун... бұл жай ғана арман.
Dialogue: 0,0:11:31.98,0:11:34.65,Default,,0,0,0,,Жарайды, мен ғана күйзеліп жатырмын.
Dialogue: 0,0:11:34.77,0:11:35.69,Default,,0,0,0,,Мұндай арман...
Dialogue: 0,0:11:35.82,0:11:37.40,Default,,0,0,0,,Чиба-кун, кеспе тым ұзарып барады.
Dialogue: 0,0:11:37.53,0:11:39.24,Default,,0,0,0,,Дауыс!!
Dialogue: 0,0:11:39.36,0:11:41.78,Default,,0,0,0,,Сонда бұл түс ақ пен қара ма? түсі?
Dialogue: 0,0:11:41.90,0:11:44.74,Default,,0,0,0,,Хм, бұл қалай өтті деп ойлаймын.
Dialogue: 0,0:11:45.62,0:11:46.49,Default,,0,0,0,,Түс болуы мүмкін
Dialogue: 0,0:11:46.62,0:11:48.66,Default,,0,0,0,,Бұл не? Жарайды!
Dialogue: 0,0:11:54.08,0:11:57.92,Default,,0,0,0,,(Куниоси Чиеми әні)
Dialogue: 0,0:12:06.68,0:12:07.93,Default,,0,0,0,,(шу)
Dialogue: 0,0:12:09.22,0:12:13.31,Default,,0,0,0,,(шу)
Dialogue: 0,0:12:13.44,0:12:14.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:17.57,0:12:18.44,Default,,0,0,0,,Не?
Dialogue: 0,0:12:20.40,0:12:22.15,Default,,0,0,0,,Бұл еркелік пе?
Dialogue: 0,0:12:26.99,0:12:28.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:30.20,0:12:32.62,Default,,0,0,0,,Нууууууууууу!!
Dialogue: 0,0:12:32.75,0:12:35.96,Default,,0,0,0,,Алға! Гррр~
Dialogue: 0,0:12:36.42,0:12:38.59,Default,,0,0,0,,Иә! Уф...
Dialogue: 0,0:12:38.71,0:12:42.21,Default,,0,0,0,,Иә? Ой кешір кешір
Dialogue: 0,0:12:42.80,0:12:46.18,Default,,0,0,0,,А... Үндемесең, ата-анаң оянады.
Dialogue: 0,0:12:46.30,0:12:48.89,Default,,0,0,0,,Ой! (Махо) Жақсы соққы
Dialogue: 0,0:12:49.01,0:12:51.22,Default,,0,0,0,,Рюсуке-кун, қазір жақсысың ба?
Dialogue: 0,0:12:51.31,0:12:52.48,Default,,0,0,0,,Жақсы
Dialogue: 0,0:12:52.68,0:12:55.39,Default,,0,0,0,,Кенеттен және екі адаммен не болды?
Dialogue: 0,0:12:55.52,0:12:57.48,Default,,0,0,0,,Хехе, өйткені...
Dialogue: 0,0:12:57.94,0:13:01.44,Default,,0,0,0,,Мен Коюкидің таңданған түрін көргім келді.
Dialogue: 0,0:13:01.90,0:13:03.28,Default,,0,0,0,,Иә! Хмм?
Dialogue: 0,0:13:03.40,0:13:04.95,Default,,0,0,0,,О, не?
Dialogue: 0,0:13:05.70,0:13:07.82,Default,,0,0,0,,Хехе, бұл шын~
Dialogue: 0,0:13:07.95,0:13:09.37,Default,,0,0,0,,Ах~
Dialogue: 0,0:13:09.95,0:13:10.95,Default,,0,0,0,,Бұл...!
Dialogue: 0,0:13:11.91,0:13:13.16,Default,,0,0,0,,Ах
Dialogue: 0,0:13:13.29,0:13:14.96,Default,,0,0,0,,Мүмкін...!
Dialogue: 0,0:13:15.54,0:13:17.46,Default,,0,0,0,,Бұл Чиеми Куниёшидің қолтаңбасы~
Dialogue: 0,0:13:17.54,0:13:19.96,Default,,0,0,0,,Уау! иә?
Dialogue: 0,0:13:20.17,0:13:21.80,Default,,0,0,0,,Әй, ата-аналар, тұрыңдар.
Dialogue: 0,0:13:21.92,0:13:23.09,Default,,0,0,0,,А, сен қандай адамсың?
Dialogue: 0,0:13:24.84,0:13:27.13,Default,,0,0,0,,Хмм, солай деп ойлаймын.
Dialogue: 0,0:13:27.26,0:13:29.09,Default,,0,0,0,,Теледидардағыдай жақсы қыз еді.
Dialogue: 0,0:13:30.18,0:13:31.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:31.43,0:13:33.85,Default,,0,0,0,,Коюкиге сәлем айтыңыз.
Dialogue: 0,0:13:34.23,0:13:37.85,Default,,0,0,0,,А, мен оны мұраға айналдырамын. Махо көп рахмет.
Dialogue: 0,0:13:39.10,0:13:40.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:46.40,0:13:47.86,Default,,0,0,0,,Куфуфу
Dialogue: 0,0:13:47.95,0:13:50.87,Default,,0,0,0,,Міне, сен де ересек адам болып кеттің.
Dialogue: 0,0:13:52.49,0:13:53.87,Default,,0,0,0,,Ақымақ аға
Dialogue: 0,0:13:54.29,0:13:58.33,Default,,0,0,0,,Коюки~ Неге бұл кітапты төсегіңіздің жанында ұстайсыз?
Dialogue: 0,0:13:58.83,0:14:00.96,Default,,0,0,0,,Шынымен емес (Махо) Ммм.
Dialogue: 0,0:14:01.09,0:14:03.63,Default,,0,0,0,,Ах, мен шаршадым.
Dialogue: 0,0:14:05.13,0:14:08.88,Default,,0,0,0,,Коюки~ Бүгін түнеуге бола ма?
Dialogue: 0,0:14:09.18,0:14:11.72,Default,,0,0,0,,Иә? Бір ғана футон бар, солай ма?
Dialogue: 0,0:14:12.22,0:14:16.77,Default,,0,0,0,,Өйткені, Рюсукенің футоны сасық, шаң кенелеріне толы.
Dialogue: 0,0:14:16.89,0:14:17.73,Default,,0,0,0,,Сен оны бірнеше күн бұрын ертіп келгенде маған айтсаң ғой.
Dialogue: 0,0:14:19.31,0:14:21.06,Default,,0,0,0,,Рюсуке де осында.
Dialogue: 0,0:14:21.48,0:14:24.86,Default,,0,0,0,,А... Жоқ, мен үйге бара жатырмын.
Dialogue: 0,0:14:25.15,0:14:27.90,Default,,0,0,0,,Өз жастығым болмаса, ұйықтай алмаймын
Dialogue: 0,0:14:32.03,0:14:34.29,Default,,0,0,0,,Олай болса, танысқаныма қуаныштымын.
Dialogue: 0,0:14:34.41,0:14:36.33,Default,,0,0,0,,Хмм! (Рюсуке) Уау
Dialogue: 0,0:14:36.41,0:14:38.66,Default,,0,0,0,,Рэй!! Хмм!
Dialogue: 0,0:14:39.37,0:14:42.67,Default,,0,0,0,,Жүр, мен ауырдым.
Dialogue: 0,0:14:43.17,0:14:45.17,Default,,0,0,0,,<Сау болыңыз>
Dialogue: 0,0:14:46.09,0:14:47.63,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:14:48.88,0:14:50.68,Default,,0,0,0,,<Абайлаңыз>
Dialogue: 0,0:14:51.55,0:14:57.56,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:15:02.90,0:15:04.77,Default,,0,0,0,,Эй, сенде ауыстыратын киім бар ма?
Dialogue: 0,0:15:04.90,0:15:07.11,Default,,0,0,0,,А-а, сәл күте тұрыңыз.
Dialogue: 0,0:15:10.70,0:15:11.91,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:15:11.91,0:15:13.07,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:15:11.91,0:15:13.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:18.16,0:15:21.71,Default,,0,0,0,,Мен композициялық жұмыс істеп жатырмын.
Dialogue: 0,0:15:22.21,0:15:25.00,Default,,0,0,0,,​​Иә, қайырлы түн.
Dialogue: 0,0:15:25.84,0:15:27.21,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:47.69,0:15:48.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:51.61,0:15:52.61,Default,,0,0,0,,(Махо ұйқысы)
Dialogue: 0,0:16:09.51,0:16:11.13,Default,,0,0,0,,Ах~
Dialogue: 0,0:16:15.30,0:16:16.47,Default,,0,0,0,,Коюки?
Dialogue: 0,0:16:17.93,0:16:20.14,Default,,0,0,0,,Ұйықтайтын болсаң, осында ұйықта.
Dialogue: 0,0:16:21.18,0:16:22.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:23.31,0:16:25.81,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:16:27.56,0:16:29.19,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:16:29.65,0:16:30.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:37.91,0:16:39.83,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:16:45.37,0:16:47.29,Default,,0,0,0,,Хмм… Хмпф
Dialogue: 0,0:16:48.21,0:16:49.42,Default,,0,0,0,,Коюки
Dialogue: 0,0:16:50.59,0:16:52.13,Default,,0,0,0,,Коюки иә?
Dialogue: 0,0:16:53.05,0:16:54.93,Default,,0,0,0,,Фильмдегі Коюки—
Dialogue: 0,0:16:55.05,0:16:57.72,Default,,0,0,0,,Өте керемет болды
Dialogue: 0,0:17:01.06,0:17:04.85,Default,,0,0,0,,Бұл өте керемет болды.
Dialogue: 0,0:17:06.35,0:17:07.77,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:18.37,0:17:21.58,Default,,0,0,0,,Ал, біздің алдымызда...
Dialogue: 0,0:17:21.83,0:17:24.83,Default,,0,0,0,,Біз сүйдік, солай ма? Бұл...
Dialogue: 0,0:17:25.04,0:17:26.83,Default,,0,0,0,,Бұл нені білдіреді...
Dialogue: 0,0:17:26.96,0:17:29.00,Default,,0,0,0,,Менің айтайын дегенім, қарым-қатынас...
Dialogue: 0,0:17:29.13,0:17:30.96,Default,,0,0,0,,Махо? Сіз ұйықтап қалдыңыз ба?
Dialogue: 0,0:17:31.46,0:17:32.84,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:34.59,0:17:36.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:41.97,0:17:45.52,Default,,0,0,0,,(Махоның ұйқы туралы әңгімесі)
Dialogue: 0,0:17:45.64,0:17:46.60,Default,,0,0,0,,Иә
Dialogue: 0,0:17:57.99,0:17:59.66,Default,,0,0,0,,Ммм
Dialogue: 0,0:17:59.87,0:18:01.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:10.42,0:18:13.50,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:18:14.21,0:18:16.59,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,0:18:17.55,0:18:18.68,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:18:31.94,0:18:33.77,Default,,0,0,0,,Фильмдегі Коюки—
Dialogue: 0,0:18:33.90,0:18:36.36,Default,,0,0,0,,Өте керемет болды
Dialogue: 0,0:18:38.40,0:18:41.03,Default,,0,0,0,,Ах~ Қайырлы таң
Dialogue: 0,0:18:41.12,0:18:43.53,Default,,0,0,0,,Қайырлы таң (Махо) Қайырлы таң~
Dialogue: 0,0:18:43.78,0:18:45.83,Default,,0,0,0,,Ммм?
Dialogue: 0,0:18:45.95,0:18:47.54,Default,,0,0,0,,Иә!?
Dialogue: 0,0:18:45.95,0:18:47.54,Default,,0,0,0,,Әй, сен сыпайы көрінесің бе?
Dialogue: 0,0:18:47.54,0:18:48.54,Default,,0,0,0,,Әй, сен сыпайы көрінесің бе?
Dialogue: 0,0:18:49.12,0:18:49.33,Default,,0,0,0,,А... а...
Dialogue: 0,0:18:49.33,0:18:50.33,Default,,0,0,0,,А... а...
Dialogue: 0,0:18:49.33,0:18:50.33,Default,,0,0,0,,Бетіңізді тез жуыңыз—
Dialogue: 0,0:18:50.33,0:18:50.46,Default,,0,0,0,,А... а...
Dialogue: 0,0:18:50.46,0:18:51.38,Default,,0,0,0,,А... а...
Dialogue: 0,0:18:50.46,0:18:51.38,Default,,0,0,0,,Күрішті жеме
Dialogue: 0,0:18:51.50,0:18:53.09,Default,,0,0,0,,(2-қыз) О, өтінемін, өзіңізді міндетті сезінбеңіз, ханым
Dialogue: 0,0:18:53.21,0:18:54.17,Default,,0,0,0,,Махо-чан
Dialogue: 0,0:18:53.21,0:18:54.17,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:54.17,0:18:54.29,Default,,0,0,0,,Ааа...
Dialogue: 0,0:18:54.29,0:18:55.80,Default,,0,0,0,,Хааа...
Dialogue: 0,0:18:54.29,0:18:55.80,Default,,0,0,0,,Қайта толтыруды сұраудан тартынбаңыз.
Dialogue: 0,0:18:55.80,0:18:55.92,Default,,0,0,0,,Қайта толтыруды сұраудан тартынбаңыз.
Dialogue: 0,0:18:55.92,0:18:56.30,Default,,0,0,0,,Қайта толтыруды сұраудан тартынбаңыз.
Dialogue: 0,0:18:55.92,0:18:56.30,Default,,0,0,0,,Құп-қисынсыз! Мен анық-ақ жоғарыға көтерілдім.
Dialogue: 0,0:18:56.30,0:18:57.42,Default,,0,0,0,,Құп-қисынсыз! Мен анық-ақ жоғарыға көтерілдім.
Dialogue: 0,0:18:57.71,0:19:02.51,Default,,0,0,0,,Анам сол түні өте қорқынышты болды.
Dialogue: 0,0:19:02.80,0:19:06.27,Default,,0,0,0,,Амансың ба? Тіпті ер адам толыққанды адам.
Dialogue: 0,0:19:06.39,0:19:07.81,Default,,0,0,0,,Әрекет ету дегеніміз белгілі бір шешімге ие болу дегенді білдіреді...
Dialogue: 0,0:19:07.81,0:19:09.14,Default,,0,0,0,,Әрекет ету дегеніміз белгілі бір шешімге ие болу дегенді білдіреді...
Dialogue: 0,0:19:07.81,0:19:09.14,Default,,0,0,0,,Иә
Dialogue: 0,0:19:09.39,0:19:10.98,Default,,0,0,0,,Иә
Dialogue: 0,0:19:17.19,0:19:20.36,Default,,0,0,0,,(ғибадатхана қоңырауының дыбысы)
Dialogue: 0,0:19:22.36,0:19:25.37,Default,,0,0,0,,<Кәдімгі алтын тістер бүгінде жоқ.>
Dialogue: 0,0:19:33.96,0:19:36.55,Default,,0,0,0,,<Менің алдымда қайтадан шығу үшін...>
Dialogue: 0,0:19:36.67,0:19:38.55,Default,,0,0,0,,<Ақымақ адам>
Dialogue: 0,0:19:40.30,0:19:42.63,Default,,0,0,0,,<Бекке ұнағанын әкелдім>
Dialogue: 0,0:19:42.72,0:19:43.64,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:19:43.76,0:19:45.97,Default,,0,0,0,,<Бек өте ұялшақ...>
Dialogue: 0,0:19:46.10,0:19:48.22,Default,,0,0,0,,<Мен жалғыз адаммын>
Dialogue: 0,0:19:48.35,0:19:51.27,Default,,0,0,0,,〈Олай болса, маған мейірімді бола аласыз ба?〉
Dialogue: 0,0:19:53.15,0:19:55.65,Default,,0,0,0,,<Моңғол шабақтары отряды...>
Dialogue: 0,0:19:55.77,0:19:59.15,Default,,0,0,0,,〈Мен оны АҚШ колледжі диаграммаларының алғашқы 10-на кіргенін естідім〉
Dialogue: 0,0:19:59.61,0:20:00.65,Default,,0,0,0,,Хахан
Dialogue: 0,0:20:00.86,0:20:02.78,Default,,0,0,0,,〈Осындай жанр үшін〉
Dialogue: 0,0:20:02.91,0:20:05.16,Default,,0,0,0,,〈Бұл ерекше хит болды деп айтуға болады.〉
Dialogue: 0,0:20:05.37,0:20:07.45,Default,,0,0,0,,(мүмкін бұл кино эффектісі)
Dialogue: 0,0:20:07.58,0:20:11.00,Default,,0,0,0,,<Егер ол Чикагодағы супер-минор инди белгісі болмаса...>
Dialogue: 0,0:20:11.12,0:20:13.83,Default,,0,0,0,,<Сандар сөзсіз көбейеді>
Dialogue: 0,0:20:14.33,0:20:15.88,Default,,0,0,0,,<Мен көремін>
Dialogue: 0,0:20:16.63,0:20:18.71,Default,,0,0,0,,〈Сіздің бизнесіңіз қандай? 〉
Dialogue: 0,0:20:19.17,0:20:22.01,Default,,0,0,0,,<Мен бұл тек ит тағамы емес екеніне сенімдімін.>
Dialogue: 0,0:20:22.13,0:20:25.30,Default,,0,0,0,,<Ризашылық дыбыс>
Dialogue: 0,0:20:33.14,0:20:35.85,Default,,0,0,0,,<Не!? Сіз>
Dialogue: 0,0:20:52.75,0:20:54.71,Default,,0,0,0,,Сәлем Танака-кун
Dialogue: 0,0:20:55.08,0:20:57.83,Default,,0,0,0,,Бұл Онигата-кун, ол күреседі.
Dialogue: 0,0:20:57.96,0:21:01.30,Default,,0,0,0,,Фуфуфуфу Мен Олимпиадаға қараймын.
Dialogue: 0,0:21:01.42,0:21:02.97,Default,,0,0,0,,О, бұл керемет.
Dialogue: 0,0:21:03.63,0:21:07.64,Default,,0,0,0,,Танака-кун мен Масуока-сан жақсы достар, солай ма?
Dialogue: 0,0:21:08.68,0:21:10.56,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:21:12.06,0:21:15.94,Default,,0,0,0,,Хмм, Масуока-сан сен туралы айтып жатыр...
Dialogue: 0,0:21:16.73,0:21:20.36,Default,,0,0,0,,Мүмкін сізге ұнайтын шығар.
Dialogue: 0,0:21:22.07,0:21:24.82,Default,,0,0,0,,А... бірдеңе...
Dialogue: 0,0:21:24.95,0:21:26.99,Default,,0,0,0,,Мм... а
Dialogue: 0,0:21:27.07,0:21:30.53,Default,,0,0,0,,Мен фильмді көрдім, маған қол қоя аласыз ба?
Dialogue: 0,0:21:30.62,0:21:33.16,Default,,0,0,0,,Ni-nuo иә? Мен!?
Dialogue: 0,0:21:33.83,0:21:35.71,Default,,0,0,0,,Коюки-кун~
Dialogue: 0,0:21:37.92,0:21:39.25,Default,,0,0,0,,Хироми-чан
Dialogue: 0,0:21:39.33,0:21:42.09,Default,,0,0,0,,Ах ха ха ха...
Dialogue: 0,0:21:44.17,0:21:46.26,Default,,0,0,0,,Мен көрдім! фильм!
Dialogue: 0,0:21:46.47,0:21:48.76,Default,,0,0,0,,Кеше мен оны досыммен бірге көруге бардым.
Dialogue: 0,0:21:49.26,0:21:50.76,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:21:50.85,0:21:52.97,Default,,0,0,0,,Бұл мені қозғады~
Dialogue: 0,0:21:53.10,0:21:56.10,Default,,0,0,0,,Коюки-кун соншалықты үлкен көрінеді.
Dialogue: 0,0:21:56.81,0:21:59.98,Default,,0,0,0,,Сыныпта Коюки-кун туралы қауесеттер бар!
Dialogue: 0,0:22:00.11,0:22:01.61,Default,,0,0,0,,Я~
Dialogue: 0,0:22:01.69,0:22:04.44,Default,,0,0,0,,Мен бұлай айтуға ұяламын, бірақ...
Dialogue: 0,0:22:04.57,0:22:07.65,Default,,0,0,0,,Мен лиотардпен жүгіріп шықтым хаха
Dialogue: 0,0:22:07.86,0:22:09.36,Default,,0,0,0,,Ах, рахмет (Масуока) Хэхе
Dialogue: 0,0:22:11.28,0:22:12.58,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:22:21.88,0:22:25.13,Default,,0,0,0,,Менің күшім әлі алда...
Dialogue: 0,0:22:26.21,0:22:30.51,Default,,0,0,0,,Мен фильмнің БЕКке пайдасы тиеді деп ойладым.
Dialogue: 0,0:22:32.60,0:22:35.64,Default,,0,0,0,,Сосын сол жаз келеді
Dialogue: 0,0:22:36.89,0:22:42.86,Default,,0,0,0,,♪～
Dialogue: 0,0:24:00.43,0:24:06.40,Default,,0,0,0,,～♪
Dialogue: 0,0:24:07.23,0:24:10.36,Default,,0,0,0,,Келесі аптада Пейдждің көзінен сәулелер шығады.
Dialogue: 0,0:24:10.44,0:24:11.15,Default,,0,0,0,,Келесі аптада!
Dialogue: 0,0:24:11.28,0:24:12.03,Default,,0,0,0,,«Жеңіл музыка»
Dialogue: 0,0:24:12.15,0:24:13.86,Default,,0,0,0,,Қараңдар! (Махо) Шынайы ма?
Dialogue: 0,0:24:15.36,0:24:21.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
