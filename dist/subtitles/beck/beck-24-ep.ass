Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.33,0:00:06.96,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.67,0:01:36.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:45.18,0:01:51.19,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:02:02.08,0:02:08.25,Default,,0,0,0,,(Коюкидің ән айту дауысы)
Dialogue: 0,0:02:19.22,0:02:20.68,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:02:21.72,0:02:23.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:30.40,0:02:32.02,Default,,0,0,0,,Коюки-кун...
Dialogue: 0,0:02:47.62,0:02:53.25,Default,,0,0,0,,Жарыс қаншада басталады?
Dialogue: 0,0:03:05.01,0:03:06.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:07.47,0:03:08.52,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:03:11.94,0:03:13.27,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:31.83,0:03:32.96,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:33.08,0:03:37.17,Default,,0,0,0,,Неліктен олар бүгін ғана бірінен соң бірі шығады? Сол жігіттер
Dialogue: 0,0:03:52.35,0:03:53.69,Default,,0,0,0,,<Кеттік>
Dialogue: 0,0:03:53.81,0:03:55.15,Default,,0,0,0,,〈Бірдеңе болды ма? 〉
Dialogue: 0,0:03:55.27,0:03:57.40,Default,,0,0,0,,〈Үшінші кезеңде бірдеңе дұрыс емес〉
Dialogue: 0,0:03:58.27,0:04:00.49,Default,,0,0,0,,(Бұл оркестрлерде жиі орындалатын қойылым)
Dialogue: 0,0:04:01.99,0:04:05.20,Default,,0,0,0,,〈Жоқ, ол жігіт〉
Dialogue: 0,0:04:05.99,0:04:07.41,Default,,0,0,0,,<Бұл жағдайда—>
Dialogue: 0,0:04:08.16,0:04:09.83,Default,,0,0,0,,<Онымен айналысуды сізге қалдырамын>
Dialogue: 0,0:04:10.12,0:04:11.66,Default,,0,0,0,,<Түсінікті>
Dialogue: 0,0:04:21.17,0:04:23.30,Default,,0,0,0,,Біраз ұзақ емес пе? бұл ән
Dialogue: 0,0:04:23.42,0:04:24.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:24.55,0:04:25.43,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:04:25.51,0:04:27.18,Default,,0,0,0,,Не болды!
Dialogue: 0,0:04:27.68,0:04:29.01,Default,,0,0,0,,Ах
Dialogue: 0,0:04:34.64,0:04:35.90,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:39.61,0:04:40.48,Default,,0,0,0,,Эй, сен...
Dialogue: 0,0:04:40.61,0:04:42.78,Default,,0,0,0,,Сіз қайда жүрдіңіз?
Dialogue: 0,0:04:42.90,0:04:44.28,Default,,0,0,0,,Бұл өте үлкен...
Dialogue: 0,0:04:44.40,0:04:47.41,Default,,0,0,0,,Мен бұл жігітпен қайта кездесуді шештім.
Dialogue: 0,0:04:49.91,0:04:51.62,Default,,0,0,0,,Сіз шешсеңіз де...
Dialogue: 0,0:04:52.91,0:04:55.21,Default,,0,0,0,,Мен енді қашпаймын
Dialogue: 0,0:05:00.67,0:05:02.21,Default,,0,0,0,,<Оны қайтарып бересіз бе?>
Dialogue: 0,0:05:02.42,0:05:04.84,Default,,0,0,0,,<Қызға бер>
Dialogue: 0,0:05:06.97,0:05:09.55,Default,,0,0,0,,〈Ағам саған Люсильді бергісі келеді〉
Dialogue: 0,0:05:11.18,0:05:13.47,Default,,0,0,0,,<Бірақ мен Люсильдің коммерциялық құндылығын ойлаймын—
Dialogue: 0,0:05:13.60,0:05:15.44,Default,,0,0,0,,<Мен мұны істеуге болмайды деп шештім>
Dialogue: 0,0:05:15.77,0:05:17.23,Default,,0,0,0,,<Рюсуке Минами>
Dialogue: 0,0:05:17.35,0:05:19.23,Default,,0,0,0,,<Мәмілені ұмытпа>
Dialogue: 0,0:05:19.94,0:05:21.61,Default,,0,0,0,,<Бұлт бағыты күдікті>
Dialogue: 0,0:05:21.82,0:05:23.53,Default,,0,0,0,,(Голдидің күлкісі)
Dialogue: 0,0:05:23.53,0:05:24.90,Default,,0,0,0,,(Голдидің күлкісі)
Dialogue: 0,0:05:23.53,0:05:24.90,Default,,0,0,0,,<Сахнаға тез барыңыз>
Dialogue: 0,0:05:24.90,0:05:25.70,Default,,0,0,0,,(Голдидің күлкісі)
Dialogue: 0,0:05:30.74,0:05:32.33,Default,,0,0,0,,〈Сол түнгі сессия болды...〉
Dialogue: 0,0:05:32.45,0:05:33.83,Default,,0,0,0,,〈Бұл өте қызықты болды.〉
Dialogue: 0,0:05:33.95,0:05:36.79,Default,,0,0,0,,〈Мен сен сияқты гитаристер жойылып кеткен деп ойладым〉
Dialogue: 0,0:05:36.91,0:05:39.17,Default,,0,0,0,,<Кез-келген уақытта тағы бір сессия өткізейік>
Dialogue: 0,0:05:39.29,0:05:40.96,Default,,0,0,0,,<Күншуақ бала туралы аңыз мұрагер>
Dialogue: 0,0:05:41.09,0:05:44.59,Default,,0,0,0,,<Рюсуке Минамиге>
Dialogue: 0,0:05:51.18,0:05:53.18,Default,,0,0,0,,Кеттік, кемпір.
Dialogue: 0,0:05:53.72,0:05:56.81,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:06:02.19,0:06:03.65,Default,,0,0,0,,Рюсуке-кун!
Dialogue: 0,0:06:04.90,0:06:05.74,Default,,0,0,0,,Лу…
Dialogue: 0,0:06:08.15,0:06:09.74,Default,,0,0,0,,Люсиль…
Dialogue: 0,0:06:10.41,0:06:11.49,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:15.33,0:06:16.66,Default,,0,0,0,,Бұл біртүрлі гитара.
Dialogue: 0,0:06:16.79,0:06:18.25,Default,,0,0,0,,Ол қандай дыбыс шығарады?
Dialogue: 0,0:06:23.80,0:06:26.26,Default,,0,0,0,,О... Иә!
Dialogue: 0,0:06:27.13,0:06:27.97,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:32.68,0:06:34.01,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:06:34.85,0:06:35.93,Default,,0,0,0,,Хе-хе…
Dialogue: 0,0:06:41.40,0:06:42.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:42.36,0:06:45.48,Default,,0,0,0,,Бұл шынымен 500 адам ма?
Dialogue: 0,0:06:51.70,0:06:52.53,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:52.74,0:06:55.74,Default,,0,0,0,,Үшінші кезеңде адамдар жылдам қозғалуда!
Dialogue: 0,0:06:59.66,0:07:01.04,Default,,0,0,0,,Келіңіздер! Малколм!
Dialogue: 0,0:07:01.17,0:07:04.38,Default,,0,0,0,,Оның себебі жаңбырда жабдықтың сулануы.
Dialogue: 0,0:07:04.50,0:07:06.05,Default,,0,0,0,,Сауығуға үміт жоқ
Dialogue: 0,0:07:04.50,0:07:06.05,Default,,0,0,0,,(Чибаның ыңырсыуы)
Dialogue: 0,0:07:06.05,0:07:06.17,Default,,0,0,0,,(Чибаның ыңырсыуы)
Dialogue: 0,0:07:06.17,0:07:08.09,Default,,0,0,0,,(Чибаның ыңырсыуы)
Dialogue: 0,0:07:06.17,0:07:08.09,Default,,0,0,0,,Малкольм да қонақүйге қайтатынын айтады.
Dialogue: 0,0:07:08.17,0:07:11.09,Default,,0,0,0,,Бұл жаман. Біз осы уақытқа дейін небәрі 3 ән орындадық.
Dialogue: 0,0:07:11.18,0:07:15.26,Default,,0,0,0,,Ал бұл тұтынушы келіспейді.
Dialogue: 0,0:07:15.39,0:07:16.76,Default,,0,0,0,,«Жоқ» деңіз—
Dialogue: 0,0:07:16.89,0:07:18.56,Default,,0,0,0,,(таспаның аршылған дыбысы)
Dialogue: 0,0:07:16.89,0:07:18.56,Default,,0,0,0,,Дүниеде өмір сүруге сізде батыл бар.
Dialogue: 0,0:07:18.56,0:07:19.68,Default,,0,0,0,,Дүниеде жүруге деген жігер
Dialogue: 0,0:07:20.18,0:07:22.69,Default,,0,0,0,,Ішек? (Қызметкерлер) Ахх!
Dialogue: 0,0:07:22.81,0:07:24.19,Default,,0,0,0,,Мінекей! Хаха~!
Dialogue: 0,0:07:24.77,0:07:26.23,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:07:26.36,0:07:27.98,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:28.11,0:07:30.53,Default,,0,0,0,,Менің ұялы телефоным сонда емес пе еді?
Dialogue: 0,0:07:30.65,0:07:31.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:33.41,0:07:35.49,Default,,0,0,0,,Мұндай жол бар ма?
Dialogue: 0,0:07:35.62,0:07:37.20,Default,,0,0,0,,Картада жоқ жол (Чиба) Уау!
Dialogue: 0,0:07:37.33,0:07:38.95,Default,,0,0,0,,Жабдықтарды тасымалдауға арналған жол
Dialogue: 0,0:07:39.08,0:07:40.12,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:07:41.41,0:07:44.46,Default,,0,0,0,,Ла… Тікелей шоу жарты жолда қалды... Ой!
Dialogue: 0,0:07:44.58,0:07:46.17,Default,,0,0,0,,Бітті деп ойлаймын?
Dialogue: 0,0:07:46.29,0:07:48.30,Default,,0,0,0,,Бұл өте кеш басталған сияқты.
Dialogue: 0,0:07:48.42,0:07:50.13,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:07:50.26,0:07:51.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:51.47,0:07:53.51,Default,,0,0,0,,Неліктен Моңғол Чоп тобының рэпері—
Dialogue: 0,0:07:53.63,0:07:54.47,Default,,0,0,0,,Сіз түрмеде отырсыз ба?
Dialogue: 0,0:07:54.59,0:07:57.72,Default,,0,0,0,,Енді неге?
Dialogue: 0,0:07:57.85,0:08:02.31,Default,,0,0,0,,(69-буын өнімділігі)
Dialogue: 0,0:08:02.44,0:08:05.77,Default,,0,0,0,,(Чибаның көңілді дауысы)
Dialogue: 0,0:08:14.07,0:08:15.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:28.17,0:08:29.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:30.13,0:08:36.55,Default,,0,0,0,,(69 буын әні)
Dialogue: 0,0:08:36.68,0:08:38.01,Default,,0,0,0,,Егер сол уақытта—
Dialogue: 0,0:08:38.14,0:08:41.10,Default,,0,0,0,,Егер мен 69-ұрпақты кездестірмеген болсам...
Dialogue: 0,0:08:41.22,0:08:43.85,Default,,0,0,0,,Мен өз өмірімді сүре алмадым деп ойлаймын
Dialogue: 0,0:08:43.98,0:08:44.89,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:08:45.02,0:08:48.73,Default,,0,0,0,,Үшінші кезеңге өткім келмейді!
Dialogue: 0,0:08:49.19,0:08:50.02,Default,,0,0,0,,О!
Dialogue: 0,0:08:51.73,0:08:52.57,Default,,0,0,0,,Баршаңыз!
Dialogue: 0,0:08:52.69,0:08:54.95,Default,,0,0,0,,Орныңыздан үш қадам артқа кетіңіз!
Dialogue: 0,0:08:55.07,0:08:57.45,Default,,0,0,0,,Алдыңғы жағы итеріліп кетсе, бұл өте қауіпті.
Dialogue: 0,0:08:57.57,0:08:59.66,Default,,0,0,0,,Біз әрбір адамның қауіпсіздігін қамтамасыз етуіміз керек.
Dialogue: 0,0:08:59.78,0:09:01.58,Default,,0,0,0,,Кезеңді қайта бастау мүмкін емес!
Dialogue: 0,0:09:01.70,0:09:03.25,Default,,0,0,0,,Ынтымақтастық үшін рахмет!
Dialogue: 0,0:09:03.37,0:09:06.83,Default,,0,0,0,,(Көрермендердің айқайлары)
Dialogue: 0,0:09:07.71,0:09:09.84,Default,,0,0,0,,Эй... Бұршақ бактары!
Dialogue: 0,0:09:09.92,0:09:12.55,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:09:12.63,0:09:14.42,Default,,0,0,0,,Бұл екінші үзіліс.
Dialogue: 0,0:09:14.55,0:09:16.93,Default,,0,0,0,,Haunt Оған толқу жетіспейді!
Dialogue: 0,0:09:17.05,0:09:19.22,Default,,0,0,0,,Сізге қарсы емес деп үміттенемін!
Dialogue: 0,0:09:19.51,0:09:21.72,Default,,0,0,0,,Мен бұл ойынды ұта алмаймын
Dialogue: 0,0:09:27.69,0:09:28.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:30.44,0:09:33.99,Default,,0,0,0,,Эй эй... Коюки бүгін керемет.
Dialogue: 0,0:09:41.78,0:09:44.95,Default,,0,0,0,,Ол да өз өмірін қатерге тіккен.
Dialogue: 0,0:09:47.50,0:09:49.75,Default,,0,0,0,,Чиба-кун! (Чиба) Әй?
Dialogue: 0,0:09:52.96,0:09:54.46,Default,,0,0,0,,Ах!!
Dialogue: 0,0:09:55.46,0:09:57.97,Default,,0,0,0,,Мен сахнаны асыға күтемін
Dialogue: 0,0:09:58.59,0:10:00.18,Default,,0,0,0,,Сәттілік (Чиба) Ах...
Dialogue: 0,0:10:01.55,0:10:03.97,Default,,0,0,0,,бұл... иә!
Dialogue: 0,0:10:04.10,0:10:06.85,Default,,0,0,0,,Мен қатты дауыспен айқайлаймын! Хехе
Dialogue: 0,0:10:07.81,0:10:09.06,Default,,0,0,0,,БЕК сияқты
Dialogue: 0,0:10:09.19,0:10:10.77,Default,,0,0,0,,Иә, бірақ БЕК—
Dialogue: 0,0:10:10.90,0:10:13.61,Default,,0,0,0,,Мен оларды анағұрлым қарқынды топ деп ойладым.
Dialogue: 0,0:10:16.15,0:10:18.11,Default,,0,0,0,,Жоқ...! Жібер, Корра!
Dialogue: 0,0:10:18.20,0:10:21.62,Default,,0,0,0,,(Қызметкерлердің ескертулері)
Dialogue: 0,0:10:22.03,0:10:23.03,Default,,0,0,0,,Чиба-кун!
Dialogue: 0,0:10:23.16,0:10:23.99,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:10:24.66,0:10:25.49,Default,,0,0,0,,Кешіктің, Чиба!
Dialogue: 0,0:10:25.62,0:10:26.87,Default,,0,0,0,,Хехехе аздап
Dialogue: 0,0:10:27.16,0:10:30.37,Default,,0,0,0,,Сәлем! Жібер, Корра! Мен мүшемін!
Dialogue: 0,0:10:40.93,0:10:46.93,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:10:48.06,0:10:49.60,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:10:50.60,0:10:51.69,Default,,0,0,0,,Аах! М… Мұғалім!
Dialogue: 0,0:10:51.81,0:10:54.61,Default,,0,0,0,,Мен саған соңғы жазамды беруге келдім.
Dialogue: 0,0:10:54.73,0:10:55.61,Default,,0,0,0,,Мен үшін де солай
Dialogue: 0,0:10:55.69,0:10:58.24,Default,,0,0,0,,(эффектор жұмысының дыбысы)
Dialogue: 0,0:10:58.36,0:11:00.36,Default,,0,0,0,,Мен бүгін топтан кетемін.
Dialogue: 0,0:11:00.45,0:11:04.45,Default,,0,0,0,,Ах... Хэйкун!? Менімен бірге жүрудің қажеті жоқ!
Dialogue: 0,0:11:04.58,0:11:05.83,Default,,0,0,0,,Кез келген жағдайда—
Dialogue: 0,0:11:05.91,0:11:07.62,Default,,0,0,0,,Негізгі кезеңді және екінші кезеңді жұмылдыру үшін —
Dialogue: 0,0:11:07.75,0:11:08.95,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:11:09.08,0:11:11.33,Default,,0,0,0,,Топтың тараудан басқа амалы жоқ деп ойлаймын.
Dialogue: 0,0:11:17.63,0:11:19.67,Default,,0,0,0,,Чиба-кун келді.
Dialogue: 0,0:11:19.92,0:11:22.05,Default,,0,0,0,,«Миға шабуыл» жасайық!
Dialogue: 0,0:11:28.02,0:11:29.27,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:11:31.14,0:11:35.69,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:11:38.19,0:11:39.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:41.95,0:11:43.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:03.80,0:12:06.43,Default,,0,0,0,,Ах! иә!
Dialogue: 0,0:12:25.82,0:12:29.87,Default,,0,0,0,,Уау Уау Уау!
Dialogue: 0,0:12:38.13,0:12:39.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:39.50,0:12:41.13,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:12:41.26,0:12:42.34,Default,,0,0,0,,Тұтынушы ұялы телефонды және т.б.
Dialogue: 0,0:12:42.47,0:12:44.76,Default,,0,0,0,,Сіз маған осы жерде жанды орындау туралы айтасыз ба?
Dialogue: 0,0:12:44.88,0:12:47.30,Default,,0,0,0,,Жоқ, ол деңгейде емес.
Dialogue: 0,0:12:49.81,0:12:51.02,Default,,0,0,0,,Мен бұған сене алмаймын
Dialogue: 0,0:12:51.14,0:12:52.56,Default,,0,0,0,,Адамдардың саны тез өсуде
Dialogue: 0,0:12:52.68,0:12:54.44,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:13:13.04,0:13:14.41,Default,,0,0,0,,<Миға шабуыл!?>
Dialogue: 0,0:13:14.54,0:13:15.87,Default,,0,0,0,,<Уфуфу жұмбақ! 〉
Dialogue: 0,0:13:16.00,0:13:17.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:21.92,0:13:23.59,Default,,0,0,0,,Рюсуке-кун...
Dialogue: 0,0:13:24.09,0:13:26.05,Default,,0,0,0,,Сіз кереметсіз! иә!
Dialogue: 0,0:13:26.18,0:13:27.68,Default,,0,0,0,,Иә? Сіздің асқазаныңыз салқындап кетті ме?
Dialogue: 0,0:13:27.80,0:13:31.51,Default,,0,0,0,,Рюсуке-кун! Жарма мама аман болсын!
Dialogue: 0,0:13:31.64,0:13:33.14,Default,,0,0,0,,«Мама» сериясы!? (Еркек, Кайо) Иә?
Dialogue: 0,0:13:33.56,0:13:36.10,Default,,0,0,0,,БЕК - ең жақсы! (Еркек Кайо) Ия!
Dialogue: 0,0:13:46.53,0:13:49.87,Default,,0,0,0,,Сол барабанды бірге сынап көрейік.
Dialogue: 0,0:13:58.87,0:14:02.00,Default,,0,0,0,,(Микчанның ән айту дауысы)
Dialogue: 0,0:14:04.96,0:14:06.26,Default,,0,0,0,,Сіз жылап жатырсыз ба? Сіз
Dialogue: 0,0:14:06.72,0:14:08.47,Default,,0,0,0,,Осындай тікелей шоулар бар.
Dialogue: 0,0:14:08.59,0:14:11.85,Default,,0,0,0,,Менің мүмкіндігімнен де артық нәрсені жасайтын уақыт келді.
Dialogue: 0,0:14:16.85,0:14:20.86,Default,,0,0,0,,БЕКтің жақсылығы қандай да бір жолмен өтіп жатқанына сенімдімін.
Dialogue: 0,0:14:20.98,0:14:22.06,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:28.53,0:14:29.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:32.20,0:14:33.58,Default,,0,0,0,,Төрт!
Dialogue: 0,0:14:39.87,0:14:41.21,Default,,0,0,0,,<Сіз нені айтасыз? 〉
Dialogue: 0,0:14:43.25,0:14:44.63,Default,,0,0,0,,〈Үшінші кезеңнің тікелей видеосы неге бар?〉
Dialogue: 0,0:14:44.75,0:14:47.51,Default,,0,0,0,,<Ол ағып жатыр>
Dialogue: 0,0:14:47.72,0:14:49.26,Default,,0,0,0,,<Мырза. Сайкс! 〉
Dialogue: 0,0:14:49.34,0:14:51.51,Default,,0,0,0,,<Малкольм қонақүйге қайта оралғалы жатыр! 〉
Dialogue: 0,0:14:52.39,0:14:53.22,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:53.55,0:14:54.39,Default,,0,0,0,,<Голди! 〉
Dialogue: 0,0:14:54.51,0:14:56.10,Default,,0,0,0,,〈Иә, бастық! 〉
Dialogue: 0,0:14:56.97,0:14:58.06,Default,,0,0,0,,〈Неліктен бақылау керек?〉
Dialogue: 0,0:14:58.18,0:15:00.64,Default,,0,0,0,,<Сіз үшінші кезеңнің кадрларын ойнап жатырсыз ба? 〉
Dialogue: 0,0:15:00.77,0:15:02.98,Default,,0,0,0,,〈Көрермендер спектакль үзілгендіктен ашуланды.〉
Dialogue: 0,0:15:03.11,0:15:05.40,Default,,0,0,0,,〈Сені тыныштандыру үшін〉
Dialogue: 0,0:15:05.52,0:15:06.78,Default,,0,0,0,,〈Сонымен қатар негізгі сахнадағы жанды орындау да тоқтатылды.〉
Dialogue: 0,0:15:07.15,0:15:09.90,Default,,0,0,0,,<Үшінші кезеңдегі бейнені ойнаудан басқа амалым қалмады>
Dialogue: 0,0:15:10.99,0:15:12.49,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:12.62,0:15:13.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:15.08,0:15:16.70,Default,,0,0,0,,<Негізгі сахналық қойылым—>
Dialogue: 0,0:15:16.83,0:15:18.62,Default,,0,0,0,,<3 минут бұрын жалғасты>
Dialogue: 0,0:15:19.50,0:15:21.29,Default,,0,0,0,,<Сіз жұмыстан босатылдыңыз>
Dialogue: 0,0:15:26.05,0:15:28.01,Default,,0,0,0,,Бұл қызық өсіп келеді.
Dialogue: 0,0:15:28.13,0:15:30.09,Default,,0,0,0,,Иә... Иә... Түсінемін.
Dialogue: 0,0:15:30.22,0:15:31.26,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:15:31.38,0:15:32.34,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:15:32.47,0:15:36.51,Default,,0,0,0,,Малколмның екінші кезең мониторы өнімділіктің үзілгенін көрсетеді.
Dialogue: 0,0:15:36.64,0:15:38.93,Default,,0,0,0,,Мұнда тікелей бейне көрсетілді.
Dialogue: 0,0:15:39.06,0:15:40.23,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:15:40.35,0:15:42.85,Default,,0,0,0,,Ғажайып нәрсе болатын сияқты.
Dialogue: 0,0:15:42.94,0:15:44.73,Default,,0,0,0,,Бірақ оны табиғи нәтиже деп те айтуға болады.
Dialogue: 0,0:15:44.86,0:15:47.61,Default,,0,0,0,,Өйткені толқу басқа кезеңдерден мүлде бөлек.
Dialogue: 0,0:15:48.53,0:15:51.90,Default,,0,0,0,,Мұндағы тұтынушылар қуанып тұрғандай кейіп танытпайды.
Dialogue: 0,0:15:52.03,0:15:53.91,Default,,0,0,0,,Бұл өте қызықты.
Dialogue: 0,0:15:53.99,0:15:58.16,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:16:45.58,0:16:48.29,Default,,0,0,0,,Қалай болғанда да, Йошитоның әні өте жақсы.
Dialogue: 0,0:16:48.50,0:16:50.17,Default,,0,0,0,,А... Қазір айтамын деп ойлаймын.
Dialogue: 0,0:16:50.30,0:16:52.46,Default,,0,0,0,,Бұл рас, бірақ...
Dialogue: 0,0:16:53.51,0:16:55.18,Default,,0,0,0,,Бұл бизнес
Dialogue: 0,0:16:55.30,0:16:57.89,Default,,0,0,0,,Ән айтуда жақсысың ба, жамансың ба, бәрібір.
Dialogue: 0,0:16:58.01,0:17:01.81,Default,,0,0,0,,Йошито нарық сұранысын қанағаттандырады —
Dialogue: 0,0:17:01.89,0:17:04.56,Default,,0,0,0,,Бұл ең жақсы бағдарламалық құрал.
Dialogue: 0,0:17:06.27,0:17:08.52,Default,,0,0,0,,Ал, сен қай жерден
Dialogue: 0,0:17:08.65,0:17:10.40,Default,,0,0,0,,Үш қадам артқа шегініңіз!
Dialogue: 0,0:17:10.52,0:17:12.61,Default,,0,0,0,,Бұл үшінші үзіліс!
Dialogue: 0,0:17:12.74,0:17:15.32,Default,,0,0,0,,Tsk, бұл тіпті тірі шоу болмаса да, өте қызықты...
Dialogue: 0,0:17:16.24,0:17:18.66,Default,,0,0,0,,Бұл алдын ала белгіленген үйлесімділік әлемі.
Dialogue: 0,0:17:18.78,0:17:22.70,Default,,0,0,0,,Хмф! Ашкөздікпен басқарылатын бұршақ танктері!
Dialogue: 0,0:17:23.70,0:17:26.54,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:17:26.54,0:17:28.92,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:17:26.54,0:17:28.92,Default,,0,0,0,,Махо... неге шықпайсың?
Dialogue: 0,0:17:31.92,0:17:34.17,Default,,0,0,0,,Бұл Hidee тікелей эфирде. Мен болсам, үйге барар едім.
Dialogue: 0,0:17:34.17,0:17:35.51,Default,,0,0,0,,Бұл Hidee тікелей эфирде. Мен болсам, үйге барар едім.
Dialogue: 0,0:17:34.17,0:17:35.51,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:17:35.80,0:17:36.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:37.30,0:17:39.85,Default,,0,0,0,,Не!? Қонақтар кете бастады ма?
Dialogue: 0,0:17:40.10,0:17:41.39,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:17:41.51,0:17:45.06,Default,,0,0,0,,Бұл жердің бәрі лай, адамдар бірінен соң бірі құлап жатыр...
Dialogue: 0,0:17:45.18,0:17:47.98,Default,,0,0,0,,Бұл далада! Әрине!
Dialogue: 0,0:17:48.31,0:17:49.23,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:17:49.35,0:17:52.27,Default,,0,0,0,,Жабдық жаңбырдан бүлінгендіктен біраз уақыт алатын сияқты.
Dialogue: 0,0:17:52.40,0:17:53.78,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:17:53.90,0:17:55.15,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:17:55.28,0:17:56.49,Default,,0,0,0,,Ал, әзірге
Dialogue: 0,0:17:56.61,0:17:58.86,Default,,0,0,0,,Негізгі кезең 14900 адам
Dialogue: 0,0:17:59.07,0:18:01.45,Default,,0,0,0,,Екінші кезең 7000 адам
Dialogue: 0,0:18:01.58,0:18:04.70,Default,,0,0,0,,Ал үшінші кезеңде 1400 адам!?
Dialogue: 0,0:18:04.83,0:18:07.87,Default,,0,0,0,,Қозғалыстағы адамдар өте аз.
Dialogue: 0,0:18:08.75,0:18:14.76,Default,,0,0,0,,♪「ӨМІР ДӘТТІЛЕРІ」
Dialogue: 0,0:18:16.97,0:18:21.01,Default,,0,0,0,,(Чиба орамы)
Dialogue: 0,0:18:29.10,0:18:32.65,Default,,0,0,0,,〈Мм, біртүрлі болып көрінеді! 〉
Dialogue: 0,0:18:39.32,0:18:42.20,Default,,0,0,0,,(аудитория шулары)
Dialogue: 0,0:18:42.62,0:18:45.12,Default,,0,0,0,,Қандай шулы тұтынушы!
Dialogue: 0,0:18:45.66,0:18:48.54,Default,,0,0,0,,Оны басқа сахналарда да жанды қойылымдарда ойнау жақсы емес пе?
Dialogue: 0,0:18:48.66,0:18:51.25,Default,,0,0,0,,Екінші кезең де үзілді!
Dialogue: 0,0:18:51.38,0:18:54.17,Default,,0,0,0,,Тек үшінші кезеңді көрсетуге болады.
Dialogue: 0,0:18:54.29,0:18:57.84,Default,,0,0,0,,Үшінші кезең Рюсуке тобы...
Dialogue: 0,0:18:58.34,0:19:00.68,Default,,0,0,0,,Ах, әлгі қорқынышты жігіт бар топ.
Dialogue: 0,0:19:00.80,0:19:03.05,Default,,0,0,0,,Бұл шынымен де зорлық-зомбылық...
Dialogue: 0,0:19:03.18,0:19:05.76,Default,,0,0,0,,(аудитория шуы)
Dialogue: 0,0:19:10.27,0:19:12.06,Default,,0,0,0,,Бір нәрсе қызық сияқты
Dialogue: 0,0:19:12.19,0:19:13.44,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:19:13.56,0:19:15.65,Default,,0,0,0,,Үшінші кезең БЕК, солай ма?
Dialogue: 0,0:19:15.77,0:19:17.28,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:24.07,0:19:26.58,Default,,0,0,0,,Бұл оның тобы...
Dialogue: 0,0:19:26.91,0:19:28.25,Default,,0,0,0,,Эйдзи-кун...
Dialogue: 0,0:19:28.66,0:19:29.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:36.67,0:19:37.92,Default,,0,0,0,,Не?
Dialogue: 0,0:19:38.05,0:19:39.84,Default,,0,0,0,,Мен де киімімді шешемін!
Dialogue: 0,0:19:45.51,0:19:48.10,Default,,0,0,0,,Керемет! Халық саны көбейіп келеді
Dialogue: 0,0:19:48.18,0:19:50.39,Default,,0,0,0,,Иә, бұл таңқаларлық.
Dialogue: 0,0:19:52.06,0:19:54.94,Default,,0,0,0,,Эй, Коюки, "FACE" бөліміне барайық
Dialogue: 0,0:19:55.36,0:19:57.94,Default,,0,0,0,,Оңай қателіктер жібермеңіз.
Dialogue: 0,0:20:15.54,0:20:18.13,Default,,0,0,0,,Менің барлығына өтінішім бар.
Dialogue: 0,0:20:18.25,0:20:21.13,Default,,0,0,0,,Өзіңіз шығарған қоқысты өзіңіз лақтырыңыз.
Dialogue: 0,0:20:21.26,0:20:24.34,Default,,0,0,0,,Менің ойымша, оны басқа біреуге алу ұят.
Dialogue: 0,0:20:25.39,0:20:28.35,Default,,0,0,0,,Коюки-кун! Мен оны дұрыстап тастаймын!
Dialogue: 0,0:20:28.47,0:20:29.72,Default,,0,0,0,,Ой мой!
Dialogue: 0,0:20:29.85,0:20:31.02,Default,,0,0,0,,Мен де!
Dialogue: 0,0:20:36.40,0:20:40.69,Default,,0,0,0,,♪「БЕТ」
Dialogue: 0,0:20:40.82,0:20:44.99,Default,,0,0,0,,(Коюкидің ағылшынша ән айтатын дауысы)
Dialogue: 0,0:20:59.75,0:21:01.38,Default,,0,0,0,,Бұл фильмдегі бала емес пе?
Dialogue: 0,0:21:01.84,0:21:03.34,Default,,0,0,0,,Daibli фильмі?
Dialogue: 0,0:21:03.47,0:21:05.26,Default,,0,0,0,,Неге дыбыс шығармайсың?
Dialogue: 0,0:21:05.38,0:21:07.18,Default,,0,0,0,,Бұл Ран-санның нұсқауынсыз...
Dialogue: 0,0:21:07.30,0:21:09.93,Default,,0,0,0,,Бұл фестивальді менің әпкем бастады!
Dialogue: 0,0:21:10.06,0:21:10.89,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:21:11.35,0:21:13.31,Default,,0,0,0,,Дыбысты айт! (Қызметкерлер) Иә!
Dialogue: 0,0:21:13.73,0:21:15.48,Default,,0,0,0,,Ол шынымен құлады ма? Сол қыз
Dialogue: 0,0:21:15.60,0:21:17.77,Default,,0,0,0,,Иә, бұл қауесет.
Dialogue: 0,0:21:17.90,0:21:19.98,Default,,0,0,0,,Әй, жаңбыр әлсіреп барады.
Dialogue: 0,0:21:20.11,0:21:21.48,Default,,0,0,0,,Бұл тоқтауы мүмкін.
Dialogue: 0,0:21:21.61,0:21:22.69,Default,,0,0,0,,♪～
Dialogue: 0,0:21:22.69,0:21:24.90,Default,,0,0,0,,♪～
Dialogue: 0,0:21:22.69,0:21:24.90,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:21:27.78,0:21:31.16,Default,,0,0,0,,(Коюкидің ағылшынша ән айтатын дауысы)
Dialogue: 0,0:21:31.70,0:21:35.79,Default,,0,0,0,,Коюки-кун... үлкен сахнада жақсы көрінесің.
Dialogue: 0,0:21:42.30,0:21:43.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:43.38,0:21:45.22,Default,,0,0,0,,〈Кешіріңіз қыздар! 〉
Dialogue: 0,0:21:45.42,0:21:48.76,Default,,0,0,0,,Олай болса, осы уақытқа дейін істеген ісіміздің бәрін жаңбыр астында жуып алайық!
Dialogue: 0,0:21:48.89,0:21:50.14,Default,,0,0,0,,(Sunato) Менімен бір команда бол. (Ashido) Эй, Бакуго, сен де менімен бір команда боласың ба?
Dialogue: 0,0:21:55.39,0:21:56.85,Default,,0,0,0,,Үшінші кезең алыс емес пе?
Dialogue: 0,0:21:56.98,0:21:59.02,Default,,0,0,0,,Ендеше, жүгірмесек, уақытында үлгермейміз!
Dialogue: 0,0:22:10.24,0:22:12.28,Default,,0,0,0,,Адамдардың ағынын көре аласыз ба?
Dialogue: 0,0:22:12.41,0:22:15.08,Default,,0,0,0,,Иә, музыканың құдіреті ғажап.
Dialogue: 0,0:22:15.20,0:22:19.12,Default,,0,0,0,,Үшінші кезеңге өте көп адамдар келеді.
Dialogue: 0,0:22:19.25,0:22:23.46,Default,,0,0,0,,Мен ризашылық дыбысынан әлі бас тартқан жоқпын.
Dialogue: 0,0:22:24.92,0:22:29.93,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:22:32.05,0:22:34.39,Default,,0,0,0,,Бұл соңғы ән
Dialogue: 0,0:22:35.02,0:22:37.68,Default,,0,0,0,,Бізде бар нәрсемен ән айтайық
Dialogue: 0,0:22:38.39,0:22:41.52,Default,,0,0,0,,Енді БЕК...
Dialogue: 0,0:22:44.15,0:22:50.07,Default,,0,0,0,,♪～
Dialogue: 0,0:24:04.27,0:24:09.28,Default,,0,0,0,,～♪
Dialogue: 0,0:24:14.49,0:24:16.99,Default,,0,0,0,,Жаңбырдан кейін түнгі аспанда жұлдыздар жарқырай бастайды
Dialogue: 0,0:24:17.91,0:24:19.79,Default,,0,0,0,,Келесі аптада «Шығу»
Dialogue: 0,0:24:19.91,0:24:20.95,Default,,0,0,0,,Теріңізді тазалаңыз.
Dialogue: 0,0:24:22.45,0:24:28.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
