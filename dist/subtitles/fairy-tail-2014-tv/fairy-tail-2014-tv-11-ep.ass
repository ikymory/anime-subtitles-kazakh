Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.76,0:00:04.38,Default,,0,0,0,,Сіз бұл адамды жақсы білуіңіз керек.
Dialogue: 0,0:00:06.60,0:00:08.64,Default,,0,0,0,,Саймонды Джерард өлтірді...
Dialogue: 0,0:00:10.68,0:00:12.23,Default,,0,0,0,,Ол менің ағам.
Dialogue: 0,0:00:12.81,0:00:14.31,Default,,0,0,0,,Ha
Dialogue: 0,0:00:17.65,0:00:19.57,Default,,0,0,0,,Саймон...
Dialogue: 0,0:00:20.28,0:00:21.49,Default,,0,0,0,,Наги…
Dialogue: 0,0:00:23.65,0:00:28.37,Default,,0,0,0,,Саймонның өліміне Жерардың кінәсі болуы мүмкін екені рас.
Dialogue: 0,0:00:28.58,0:00:32.54,Default,,0,0,0,,Бірақ оны өлтірген Жерар емес.
Dialogue: 0,0:00:34.58,0:00:35.42,Default,,0,0,0,,Бұл менмін...
Dialogue: 0,0:00:43.22,0:00:44.88,Default,,0,0,0,,Адам өлтіру ниеті осында...
Dialogue: 0,0:00:47.64,0:00:48.97,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,0:01:04.40,0:01:06.36,Default,,0,0,0,,Мен өле алмаймын
Dialogue: 0,0:02:29.49,0:02:35.49,Default,,0,0,0,,~♪
Dialogue: 0,0:02:40.83,0:02:43.25,Default,,0,0,0,,Ұлы жын шайқасының соңғы күні
Dialogue: 0,0:02:43.38,0:02:45.96,Default,,0,0,0,,Нацу достарымен Люсиді құтқаруға барды...
Dialogue: 0,0:02:46.09,0:02:49.42,Default,,0,0,0,,Қамалдың жертөлесінде болашақ Люсиді кездестіріңіз
Dialogue: 0,0:02:49.55,0:02:54.10,Default,,0,0,0,,Болашақ Люси неліктен уақытқа саяхат жасады?
Dialogue: 0,0:02:54.39,0:02:57.47,Default,,0,0,0,,Болашақта не болды?
Dialogue: 0,0:02:57.89,0:03:01.06,Default,,0,0,0,,Нефрит ханшайымы өткенге қайтатын есік.
Dialogue: 0,0:03:01.19,0:03:05.57,Default,,0,0,0,,Eclipse көмегімен не істегіңіз келеді?
Dialogue: 0,0:03:06.11,0:03:10.03,Default,,0,0,0,,Бәрі әлі де жұмбақ
Dialogue: 0,0:03:13.24,0:03:15.87,Default,,0,0,0,,«Болашақ үмітсіздікке қарай жылдамдайды»
Dialogue: 0,0:03:20.50,0:03:25.25,Default,,0,0,0,,Айтайын дегенім, бұл тағы да есік. Бұл бұрынғы шығу емес пе?
Dialogue: 0,0:03:25.38,0:03:28.84,Default,,0,0,0,,Мен олар бір жерде айналып жүргендей сезінемін.
Dialogue: 0,0:03:28.96,0:03:30.92,Default,,0,0,0,,Жел әр жерден келеді...
Dialogue: 0,0:03:31.05,0:03:34.09,Default,,0,0,0,,Сыртқа қай жерден қосылатынын білмеймін.
Dialogue: 0,0:03:34.22,0:03:36.85,Default,,0,0,0,,Бұл мәселе. Кейбір адамдар жарақат алды.
Dialogue: 0,0:03:37.01,0:03:39.89,Default,,0,0,0,,Қалай болғанда да, мен гильдиядағылардың барлығына қауіпсіз екенімді айтуым керек.
Dialogue: 0,0:03:40.02,0:03:44.15,Default,,0,0,0,,Дұрыс, сыртқа қашу керек.
Dialogue: 0,0:03:44.44,0:03:47.82,Default,,0,0,0,,Егер жолыңыз болса, сыртқа шығатын жолды таба аласыз.
Dialogue: 0,0:03:47.94,0:03:51.07,Default,,0,0,0,,Жолың болмаса, босқа тентіреп кетесің.
Dialogue: 0,0:03:51.28,0:03:52.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:52.45,0:03:56.07,Default,,0,0,0,,Егер мен мұндағы құрылым туралы көбірек білсем, мен мұндай нәрсені істей алмас едім.
Dialogue: 0,0:03:56.20,0:03:58.33,Default,,0,0,0,,Кешірім сұрау сенің қолыңда емес.
Dialogue: 0,0:03:58.45,0:04:00.41,Default,,0,0,0,,Бәрі де болады, әрі қарай жүрейік.
Dialogue: 0,0:04:00.54,0:04:02.83,Default,,0,0,0,,Маған да бұл жерде Люси қызық.
Dialogue: 0,0:04:02.96,0:04:04.04,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:04.29,0:04:05.42,Default,,0,0,0,,Жарайды, кеттік, кеттік.
Dialogue: 0,0:04:05.54,0:04:08.21,Default,,0,0,0,,Мен де Люсиді алып кеткім келеді.
Dialogue: 0,0:04:16.55,0:04:20.27,Default,,0,0,0,,Сіздің алаңдағаныңыз дұрыс деп ойлаймын.
Dialogue: 0,0:04:20.68,0:04:22.73,Default,,0,0,0,,«Ұлы жын-шайтан» демонстрациясының нәтижелерін қараңыз.
Dialogue: 0,0:04:22.85,0:04:26.19,Default,,0,0,0,,Eclipse есігін ашу немесе ашу туралы шешім қабылдау және т.б.
Dialogue: 0,0:04:27.27,0:04:29.94,Default,,0,0,0,,Мүмкін болса, мұқият болыңыз.
Dialogue: 0,0:04:30.07,0:04:32.94,Default,,0,0,0,,Мен де жағдайды бағалағым келеді.
Dialogue: 0,0:04:34.03,0:04:38.70,Default,,0,0,0,,Өйткені ол осы патшалықта тұратын әрбір адамның болашағына қатысты.
Dialogue: 0,0:04:40.70,0:04:45.79,Default,,0,0,0,,Бірақ дәл қазір менде үкім шығару үшін басқа негіз жоқ.
Dialogue: 0,0:04:46.54,0:04:49.46,Default,,0,0,0,,Сол адам айтқан Ұлы сиқырлы шайқас көрсетілімінің нәтижесі.
Dialogue: 0,0:04:50.13,0:04:52.01,Default,,0,0,0,,Егер дұрыс болса...
Dialogue: 0,0:04:52.13,0:04:56.13,Default,,0,0,0,,Басқаша айтқанда, ол адамның болашақты анық білетінін дәлелдейді.
Dialogue: 0,0:04:57.14,0:05:00.97,Default,,0,0,0,,Жақында біз бұл қорытындыға келеміз.
Dialogue: 0,0:05:02.68,0:05:05.39,Default,,0,0,0,,Негізі мен де сенгім келмейді.
Dialogue: 0,0:05:05.81,0:05:08.86,Default,,0,0,0,,Сол адам айтқан болашақтың орындалатыны.
Dialogue: 0,0:05:12.65,0:05:14.24,Default,,0,0,0,,Сіз қалай ойлайсыз? Люси
Dialogue: 0,0:05:14.99,0:05:17.41,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. Барайық.
Dialogue: 0,0:05:17.53,0:05:18.37,Default,,0,0,0,,Иә
Dialogue: 0,0:05:20.78,0:05:23.25,Default,,0,0,0,,Мен керемет шайқас қойылымымен не болып жатқанын білемін
Dialogue: 0,0:05:23.37,0:05:25.83,Default,,0,0,0,,Олар дәл сол жерде істеп жатыр, солай ма?
Dialogue: 0,0:05:25.96,0:05:29.75,Default,,0,0,0,,Әйтеуір, тез қашып, атамен және басқалармен кездесейік.
Dialogue: 0,0:05:38.34,0:05:40.60,Default,,0,0,0,,Кагураның Фубутайтенін ұстады
Dialogue: 0,0:05:40.72,0:05:41.47,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:05:41.60,0:05:42.64,Default,,0,0,0,,Кагура-чан
Dialogue: 0,0:05:47.60,0:05:48.90,Default,,0,0,0,,Саймон сақтаған
Dialogue: 0,0:05:52.69,0:05:54.69,Default,,0,0,0,,Роб атадан аман қалған
Dialogue: 0,0:05:59.11,0:06:01.03,Default,,0,0,0,,Менің достарым сақтады
Dialogue: 0,0:06:06.29,0:06:08.67,Default,,0,0,0,,Бұл өмірден бас тарту...
Dialogue: 0,0:06:10.38,0:06:13.21,Default,,0,0,0,,Кеткендерге тіл тигізу
Dialogue: 0,0:06:13.34,0:06:14.25,Default,,0,0,0,,Гррр…
Dialogue: 0,0:06:14.55,0:06:16.38,Default,,0,0,0,,Сіз де, Жерар да-
Dialogue: 0,0:06:17.76,0:06:18.84,Default,,0,0,0,,Олардың барлығын бірге өлтіріңіз!
Dialogue: 0,0:06:26.14,0:06:29.48,Default,,0,0,0,,Бұл сіздің энергияңыз болса, солай болсын.
Dialogue: 0,0:06:31.10,0:06:33.82,Default,,0,0,0,,Мен бұл сезімді таптағым келмейді, бірақ...
Dialogue: 0,0:06:33.98,0:06:34.65,Default,,0,0,0,,Хааа!
Dialogue: 0,0:06:34.90,0:06:36.28,Default,,0,0,0,,Менің жеңілетін ойым жоқ!
Dialogue: 0,0:06:36.40,0:06:37.40,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:06:43.37,0:06:44.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:58.84,0:06:59.92,Default,,0,0,0,,Бұл Эльза!
Dialogue: 0,0:07:00.34,0:07:04.80,Default,,0,0,0,,Қандай ақыл-ой күші, тұла бойы тоз-тоз болып тұрса да, әйтеуір бір бұрылып кете алды.
Dialogue: 0,0:07:04.93,0:07:05.97,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:07:06.10,0:07:07.93,Default,,0,0,0,,Күйе... ғажайып кабо
Dialogue: 0,0:07:08.31,0:07:10.60,Default,,0,0,0,,Мен сол фукудайтенді суырып алдым
Dialogue: 0,0:07:10.73,0:07:13.90,Default,,0,0,0,,Кагура... жоғалды ма?
Dialogue: 0,0:07:14.06,0:07:15.65,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:07:16.02,0:07:20.20,Default,,0,0,0,,Керемет! Бұл тіпті менің көзім де жете алмайтын жарқ етті.
Dialogue: 0,0:07:23.11,0:07:24.20,Default,,0,0,0,,Уф
Dialogue: 0,0:07:24.32,0:07:26.41,Default,,0,0,0,,Кагура әлі де тұрады
Dialogue: 0,0:07:26.70,0:07:28.87,Default,,0,0,0,,Шешім әлі шешілген жоқ!
Dialogue: 0,0:07:29.50,0:07:32.25,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:07:35.71,0:07:36.38,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:07:43.13,0:07:44.26,Default,,0,0,0,,Эльза
Dialogue: 0,0:07:52.14,0:07:53.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:03.70,0:08:04.66,Default,,0,0,0,,Неге...
Dialogue: 0,0:08:07.08,0:08:08.16,Default,,0,0,0,,(Рион) Егер сұраса, олар әлемнің кез келген түкпіріне барады —
Dialogue: 0,0:08:09.04,0:08:10.29,Default,,0,0,0,,«періштелер баспалдағы» деп те аталатын жарық.
Dialogue: 0,0:08:12.50,0:08:13.96,Default,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:08:14.08,0:08:15.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:15.88,0:08:16.92,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:18.21,0:08:20.55,Default,,0,0,0,,Мен есімде қалдым деп айту керек пе?
Dialogue: 0,0:08:22.59,0:08:28.30,Default,,0,0,0,,Мен тек Саймонның әпкесі есімде...
Dialogue: 0,0:08:28.97,0:08:30.93,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,0:08:31.81,0:08:33.10,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:34.02,0:08:38.19,Default,,0,0,0,,Мен де Розмари ауылынанмын.
Dialogue: 0,0:08:39.82,0:08:41.07,Default,,0,0,0,,Саймон...
Dialogue: 0,0:08:41.65,0:08:44.03,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:08:44.15,0:08:45.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:49.37,0:08:50.87,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:08:50.99,0:08:52.33,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:08:52.45,0:08:57.54,Default,,0,0,0,,Балаларды ұрлап, барлық ересектерді өлтіріңіз!
Dialogue: 0,0:08:58.88,0:09:00.30,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:09:01.30,0:09:02.55,Default,,0,0,0,,Қайда?
Dialogue: 0,0:09:04.88,0:09:07.09,Default,,0,0,0,,Осындай жерде қалсаң, табыласың.
Dialogue: 0,0:09:07.55,0:09:09.10,Default,,0,0,0,,Бірақ менің ағам
Dialogue: 0,0:09:09.47,0:09:12.02,Default,,0,0,0,,Мен ана жақтан баланың даусын естідім.
Dialogue: 0,0:09:12.14,0:09:13.14,Default,,0,0,0,,Жасыру!
Dialogue: 0,0:09:13.48,0:09:15.02,Default,,0,0,0,,Сіздің әпкеңіз ше?
Dialogue: 0,0:09:15.14,0:09:17.06,Default,,0,0,0,,Жарайды, мен басқа жер тауып беремін.
Dialogue: 0,0:09:19.81,0:09:20.86,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:09:23.32,0:09:25.24,Default,,0,0,0,,Баланы таптық!
Dialogue: 0,0:09:25.36,0:09:26.36,Default,,0,0,0,,Егер солай болса, сол кезде айтамын.
Dialogue: 0,0:09:40.13,0:09:41.59,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:09:42.30,0:09:47.18,Default,,0,0,0,,Мен Саймоннан сіз туралы көп естідім.
Dialogue: 0,0:09:47.84,0:09:50.43,Default,,0,0,0,,Мен де әрқашан алаңдадым.
Dialogue: 0,0:09:51.43,0:09:53.89,Default,,0,0,0,,Мен сенің қауіпсіздігіңе үміттендім.
Dialogue: 0,0:09:58.85,0:10:00.06,Default,,0,0,0,,Қазірдің өзінде
Dialogue: 0,0:10:11.41,0:10:13.83,Default,,0,0,0,,Мен әлі де ойымды реттей алмаймын
Dialogue: 0,0:10:16.75,0:10:17.83,Default,,0,0,0,,дәл қазір менің алдымда тұр!
Dialogue: 0,0:10:18.96,0:10:20.88,Default,,0,0,0,,Бұл матч менікі...
Dialogue: 0,0:10:21.88,0:10:22.84,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:29.18,0:10:30.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:36.31,0:10:37.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:40.10,0:10:42.27,Default,,0,0,0,,Жеңімпаз - Эльза
Dialogue: 0,0:10:42.94,0:10:46.07,Default,,0,0,0,,Бірақ ұпай маған тиесілі.
Dialogue: 0,0:10:46.40,0:10:48.61,Default,,0,0,0,,Минерва Кагураны жеңді
Dialogue: 0,0:10:49.65,0:10:52.66,Default,,0,0,0,,Ұпайлар Sabretooth-қа қосылады
Dialogue: 0,0:10:53.12,0:10:55.83,Default,,0,0,0,,Көшбасшыны жеңгені үшін 5 ұпай қосылды.
Dialogue: 0,0:10:55.95,0:10:58.12,Default,,0,0,0,,Fairy Tail кері өзгертілді
Dialogue: 0,0:10:58.25,0:11:00.46,Default,,0,0,0,,Ағымдағы жалғыз жоғарғы
Dialogue: 0,0:11:01.46,0:11:03.13,Default,,0,0,0,,Мен айтар едім
Dialogue: 0,0:11:03.50,0:11:06.38,Default,,0,0,0,,Мен сендерге чемпиондардың шайқасын көрсетемін
Dialogue: 0,0:11:07.09,0:11:09.97,Default,,0,0,0,,Патша тек дәмді тағам жейді
Dialogue: 0,0:11:10.43,0:11:14.76,Default,,0,0,0,,Қанаттары жыртылған су перісі басы пері
Dialogue: 0,0:11:14.89,0:11:16.18,Default,,0,0,0,,...т.б.
Dialogue: 0,0:11:16.31,0:11:18.47,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:11:18.60,0:11:20.18,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:11:20.81,0:11:22.94,Default,,0,0,0,,Келесі кезекте сен, Эльза.
Dialogue: 0,0:11:23.06,0:11:27.69,Default,,0,0,0,,Дегенмен, бұл жарақатпен мен нәтижені көре аламын.
Dialogue: 0,0:11:28.32,0:11:30.78,Default,,0,0,0,,Мирия...
Dialogue: 0,0:11:31.61,0:11:34.74,Default,,0,0,0,,Мириананы сұраңыз...
Dialogue: 0,0:11:36.28,0:11:37.20,Default,,0,0,0,,О
Dialogue: 0,0:11:37.54,0:11:39.00,Default,,0,0,0,,Мириана?
Dialogue: 0,0:11:39.58,0:11:41.21,Default,,0,0,0,,Бұл котенка ма?
Dialogue: 0,0:11:46.84,0:11:49.71,Default,,0,0,0,,Бұл жігіт төбелесе алмайды.
Dialogue: 0,0:11:50.26,0:11:51.93,Default,,0,0,0,,Ұпайды сақта!
Dialogue: 0,0:11:54.76,0:11:57.26,Default,,0,0,0,,Sabretooth-қа тағы 1 ұпай қосыңыз
Dialogue: 0,0:11:57.39,0:12:00.73,Default,,0,0,0,,Кабо, мұнда Fairy Tail арасындағы айырмашылық одан әрі кеңейді
Dialogue: 0,0:12:00.85,0:12:04.98,Default,,0,0,0,,5 ұпай айырмашылығы Бұл өте жылдам.
Dialogue: 0,0:12:05.86,0:12:06.69,Default,,0,0,0,,Мириана
Dialogue: 0,0:12:10.15,0:12:13.91,Default,,0,0,0,,Иә? Эль-чан...
Dialogue: 0,0:12:15.03,0:12:17.24,Default,,0,0,0,,Мықты болыңыз! Мириана
Dialogue: 0,0:12:18.08,0:12:19.29,Default,,0,0,0,,Иә? Ха!
Dialogue: 0,0:12:23.29,0:12:23.96,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:24.33,0:12:29.46,Default,,0,0,0,,Күту қызықсыз болды, сондықтан мен оны ренжітіп ойнадым.
Dialogue: 0,0:12:32.97,0:12:35.22,Default,,0,0,0,,Бұл жақсы айқай болды.
Dialogue: 0,0:12:41.52,0:12:42.73,Default,,0,0,0,,Эльза
Dialogue: 0,0:12:43.35,0:12:44.85,Default,,0,0,0,,Кагура! Мириана!
Dialogue: 0,0:12:44.98,0:12:46.90,Default,,0,0,0,,Бұл енді жеңіске жақын емес.
Dialogue: 0,0:12:47.02,0:12:49.61,Default,,0,0,0,,Тез қолға алмасақ, асығайық.
Dialogue: 0,0:12:50.44,0:12:53.53,Default,,0,0,0,,Барлық Mermaid Heel ойыншылары енді жойылды.
Dialogue: 0,0:12:53.65,0:12:56.66,Default,,0,0,0,,Ал ол жерде Эльза мен Минерва ғана қалды.
Dialogue: 0,0:12:57.03,0:13:00.37,Default,,0,0,0,,Бірақ Эльзаның бүкіл денесі тозған, Кабо.
Dialogue: 0,0:13:00.49,0:13:02.91,Default,,0,0,0,,Екінші жағынан, Минерва еш зиянсыз.
Dialogue: 0,0:13:03.54,0:13:08.13,Default,,0,0,0,,Шынымен қанаты жұлынған перінің жеңіске жету мүмкіндігі бар ма?
Dialogue: 0,0:13:17.01,0:13:21.26,Default,,0,0,0,,Эльза мен Минерва ғана аман қалған жоқ.
Dialogue: 0,0:13:21.39,0:13:23.77,Default,,0,0,0,,Магнолия қаласындағы барлық жерде-
Dialogue: 0,0:13:23.89,0:13:28.31,Default,,0,0,0,,Сиқыршылар кескілескен шайқаста.
Dialogue: 0,0:13:39.78,0:13:41.12,Default,,0,0,0,,Уау
Dialogue: 0,0:13:44.33,0:13:46.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:47.79,0:13:49.04,Default,,0,0,0,,Терияа! Гуаа
Dialogue: 0,0:13:50.25,0:13:51.46,Default,,0,0,0,,Уаааа
Dialogue: 0,0:14:01.14,0:14:05.14,Default,,0,0,0,,Қуат айырмашылығын бір күнде жабу мүмкін емес.
Dialogue: 0,0:14:05.27,0:14:06.56,Default,,0,0,0,,Серіктеріне сенгені өзінің қателігі екенін түсінген Эрен
Dialogue: 0,0:14:14.57,0:14:15.99,Default,,0,0,0,,Мына адамға қара.
Dialogue: 0,0:14:17.74,0:14:19.95,Default,,0,0,0,,Нацу Драгнил сияқты жақсы емес
Dialogue: 0,0:14:23.95,0:14:25.41,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:14:33.21,0:14:35.96,Default,,0,0,0,,Найзағай құдайы өлтіруші Ольга
Dialogue: 0,0:14:36.55,0:14:37.84,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:38.26,0:14:39.47,Default,,0,0,0,,Хахаха
Dialogue: 0,0:14:39.84,0:14:43.14,Default,,0,0,0,,Менің атымды есіңе түсірдің бе, Лаксус?
Dialogue: 0,0:14:43.64,0:14:46.85,Default,,0,0,0,,Сабретут менің басымды ауыртып тұр.
Dialogue: 0,0:14:47.14,0:14:51.27,Default,,0,0,0,,Сіздің найзағайыңыз шынымен де керемет болуы мүмкін.
Dialogue: 0,0:14:51.90,0:14:55.53,Default,,0,0,0,,Бірақ мен тек екінші орында боламын деп ойлаймын.
Dialogue: 0,0:14:55.65,0:14:57.74,Default,,0,0,0,,Сіз маған айтасыз.
Dialogue: 0,0:14:58.07,0:15:00.86,Default,,0,0,0,,№1 деп айтқыңыз келе ме?
Dialogue: 0,0:15:01.41,0:15:04.70,Default,,0,0,0,,Я, сенің үстіңде біреу бар.
Dialogue: 0,0:15:05.03,0:15:07.83,Default,,0,0,0,,Барлығын бірден жоғалту жақсы тәжірибе.
Dialogue: 0,0:15:08.62,0:15:10.58,Default,,0,0,0,,Хмф, қызық.
Dialogue: 0,0:15:10.71,0:15:13.25,Default,,0,0,0,,Менің күн күркіреуім және менің күркіреуім
Dialogue: 0,0:15:13.71,0:15:16.67,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:15:16.80,0:15:18.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:25.76,0:15:30.44,Default,,0,0,0,,Не болды? Менің аяғым қатып, қозғала алмайтын сияқты емес шығар.
Dialogue: 0,0:15:30.89,0:15:33.60,Default,,0,0,0,,Сіз мені ұруға шындап қарайсыз ба?
Dialogue: 0,0:15:33.73,0:15:36.90,Default,,0,0,0,,Сіз мұны ғана көре аласыз деп ойлайсыз ба?
Dialogue: 0,0:15:39.15,0:15:40.19,Default,,0,0,0,,Риппель Овердрайв Брэфордтың маңдайына жай ғана тиіп өтті ме?
Dialogue: 0,0:15:50.33,0:15:52.00,Default,,0,0,0,,Сіз күткендей, Лаксус.
Dialogue: 0,0:15:52.12,0:15:53.79,Default,,0,0,0,,Бастау уақыты келді ме?
Dialogue: 0,0:15:53.96,0:15:56.88,Default,,0,0,0,,Мен сенімен мәңгілікке уақыт өткізе алар едім.
Dialogue: 0,0:15:57.00,0:15:58.75,Default,,0,0,0,,Менің уақытым жоқ.
Dialogue: 0,0:16:06.43,0:16:08.89,Default,,0,0,0,,Нууоооо!
Dialogue: 0,0:16:09.39,0:16:12.14,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:16:33.41,0:16:34.25,Default,,0,0,0,,Иә
Dialogue: 0,0:16:36.50,0:16:37.42,Default,,0,0,0,,Хохо
Dialogue: 0,0:16:42.72,0:16:46.05,Default,,0,0,0,,Мен жақсы адамдармен кездестім.
Dialogue: 0,0:16:46.34,0:16:48.93,Default,,0,0,0,,Қарғыс атсын... Қасиетті ондық Юра
Dialogue: 0,0:16:49.39,0:16:52.18,Default,,0,0,0,,Сен шықтың, құбыжық.
Dialogue: 0,0:17:02.44,0:17:04.36,Default,,0,0,0,,Сіз Леонды шатастырып жатырсыз.
Dialogue: 0,0:17:04.49,0:17:06.66,Default,,0,0,0,,Ювия Грей-самаға берілген!
Dialogue: 0,0:17:10.49,0:17:13.00,Default,,0,0,0,,Шерияның бұлай күресетінін күтпедім.
Dialogue: 0,0:17:13.12,0:17:14.21,Default,,0,0,0,,Ювия күткендей
Dialogue: 0,0:17:14.33,0:17:14.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:15.83,0:17:18.08,Default,,0,0,0,,Ей, сен әлгі қиын жерге оралдың.
Dialogue: 0,0:17:18.21,0:17:19.50,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:17:19.92,0:17:20.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:21.30,0:17:22.46,Default,,0,0,0,,Арыстан! Мистер Грей!
Dialogue: 0,0:17:22.71,0:17:25.47,Default,,0,0,0,,Не болды, Грей? Қатты емес пе?
Dialogue: 0,0:17:25.88,0:17:29.47,Default,,0,0,0,,Мен жай ғана Ябоға біраз заттарды жинадым.
Dialogue: 0,0:17:29.80,0:17:30.47,Default,,0,0,0,,Ювия
Dialogue: 0,0:17:30.76,0:17:31.56,Default,,0,0,0,,Иә
Dialogue: 0,0:17:31.68,0:17:33.72,Default,,0,0,0,,Бірден екі адам бітіре алмайды.
Dialogue: 0,0:17:34.73,0:17:37.06,Default,,0,0,0,,Бірден екі адам бітіре алмайды.
Dialogue: 0,0:17:38.81,0:17:40.77,Default,,0,0,0,,Екі адам кез келген жерге бара алады...
Dialogue: 0,0:17:43.32,0:17:45.49,Default,,0,0,0,,Екі адам арасындағы махаббат мәңгілік
Dialogue: 0,0:17:46.45,0:17:49.32,Default,,0,0,0,,Сіз бал айын қайда өткізесіз? қымбаттым
Dialogue: 0,0:17:49.45,0:17:51.74,Default,,0,0,0,,Сіздің басыңызда не болып жатыр?
Dialogue: 0,0:17:51.87,0:17:54.54,Default,,0,0,0,,Жоқ! Мен Жувианы тез оятуым керек.
Dialogue: 0,0:17:54.66,0:17:57.50,Default,,0,0,0,,Арыстан – оянатын.
Dialogue: 0,0:18:01.84,0:18:03.46,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:18:03.80,0:18:05.55,Default,,0,0,0,,Мен ешқашан адасып қаламын деп ойламадым.
Dialogue: 0,0:18:05.67,0:18:07.09,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:18:07.22,0:18:10.97,Default,,0,0,0,,Мен сарайлардың құрылымы туралы да көп білмеймін.
Dialogue: 0,0:18:11.10,0:18:12.22,Default,,0,0,0,,Castle-sama?
Dialogue: 0,0:18:12.47,0:18:16.48,Default,,0,0,0,,Тез қашып, бәріне хабарлауым керек.
Dialogue: 0,0:18:16.60,0:18:20.94,Default,,0,0,0,,Ай: Тұтылу туралы, Болашақ Люси туралы және т.б.
Dialogue: 0,0:18:21.06,0:18:23.36,Default,,0,0,0,,Бұл азап, солдаттардан өтеміз.
Dialogue: 0,0:18:23.48,0:18:25.36,Default,,0,0,0,,Жоқ, кейбір адамдар жарақат алды.
Dialogue: 0,0:18:25.48,0:18:28.24,Default,,0,0,0,,Қызық, осымен бірдеңе істей аламыз ба?
Dialogue: 0,0:18:28.45,0:18:30.91,Default,,0,0,0,,Жоқ, бұл бәрі емес.
Dialogue: 0,0:18:31.03,0:18:34.54,Default,,0,0,0,,Біз Ұлы Жын шайқасында соғысып жатырмыз, солай ма?
Dialogue: 0,0:18:34.91,0:18:36.87,Default,,0,0,0,,Бұл патшалық демеушілік ететін турнир.
Dialogue: 0,0:18:37.00,0:18:41.04,Default,,0,0,0,,Менің ойымша, біз патша әскеріне біз туралы жаман әсер қалдыруға болмайды.
Dialogue: 0,0:18:41.17,0:18:43.84,Default,,0,0,0,,Мен жазалаушылардың бәрін жеңдім...
Dialogue: 0,0:18:43.92,0:18:45.25,Default,,0,0,0,,Тым кеш болуы мүмкін
Dialogue: 0,0:18:45.50,0:18:48.80,Default,,0,0,0,,Мүмкін олар сәл жұмсақ болса жақсы болар еді.
Dialogue: 0,0:18:48.92,0:18:51.01,Default,,0,0,0,,Қазір ойлап қарасам, ол адамдар...
Dialogue: 0,0:18:51.14,0:18:53.51,Default,,0,0,0,,Ол жаман адам емес еді.
Dialogue: 0,0:18:53.64,0:18:56.89,Default,,0,0,0,,Жарайды, мен бұлай айтатын жағдайға жеткен жоқпын.
Dialogue: 0,0:18:57.02,0:19:00.14,Default,,0,0,0,,Оны қатты ауыртпады, ол қалпына келмеді.
Dialogue: 0,0:19:00.27,0:19:03.77,Default,,0,0,0,,Сенің есіңді жиатын кезің жақындап қалған шығар.
Dialogue: 0,0:19:04.86,0:19:07.74,Default,,0,0,0,,Люси, көп уайымдама.
Dialogue: 0,0:19:07.86,0:19:08.69,Default,,0,0,0,,Иә
Dialogue: 0,0:19:09.78,0:19:14.20,Default,,0,0,0,,Екеуің болсаң да, екеуіңді де жақсы көре аламын.
Dialogue: 0,0:19:14.33,0:19:16.04,Default,,0,0,0,,Ауа Маған оқып бере аласыз ба?
Dialogue: 0,0:19:18.12,0:19:18.66,Default,,0,0,0,,О!
Dialogue: 0,0:19:18.79,0:19:20.75,Default,,0,0,0,,Амансың ба? болашақ Люси
Dialogue: 0,0:19:20.87,0:19:22.79,Default,,0,0,0,,А, бұл қайда?
Dialogue: 0,0:19:22.92,0:19:23.79,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:19:24.13,0:19:26.17,Default,,0,0,0,,Құлып асханасына ұқсайды.
Dialogue: 0,0:19:26.30,0:19:28.71,Default,,0,0,0,,Ол әлі қамалдың ішінде, солай ма?
Dialogue: 0,0:19:29.88,0:19:32.18,Default,,0,0,0,,Бұл менің жадым.
Dialogue: 0,0:19:32.59,0:19:37.60,Default,,0,0,0,,Тұңғиықтан құтылған соң бәрі патшалық әскердің қолына түседі.
Dialogue: 0,0:19:38.68,0:19:43.56,Default,,0,0,0,,Сондықтан мен сізге алдын ала хабарлауға асықтым.
Dialogue: 0,0:19:44.19,0:19:47.61,Default,,0,0,0,,Менің жолым болмағанын ғана айта аламын.
Dialogue: 0,0:19:50.78,0:19:55.32,Default,,0,0,0,,Біз сол уақыт келгенше түрмеде болдық.
Dialogue: 0,0:19:55.45,0:19:56.33,Default,,0,0,0,,Сол кезде?
Dialogue: 0,0:20:01.71,0:20:05.54,Default,,0,0,0,,Люси болашақта басынан өткерген фактілер
Dialogue: 0,0:20:05.67,0:20:09.13,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Ол жігіттердің қолына түсіп қалуымыз мүмкін емес.
Dialogue: 0,0:20:09.26,0:20:12.59,Default,,0,0,0,,Иә, мені ұратын сияқты емес.
Dialogue: 0,0:20:12.72,0:20:16.85,Default,,0,0,0,,Жүгіру кезінде біз Eclipse-ге жақындаймыз.
Dialogue: 0,0:20:16.97,0:20:22.10,Default,,0,0,0,,Осыған байланысты олар бұдан былай сиқырды пайдалана алмайды және барлығы зынданға тасталады.
Dialogue: 0,0:20:22.35,0:20:24.85,Default,,0,0,0,,Біз болашақта ебедейсіз боламыз.
Dialogue: 0,0:20:25.19,0:20:30.07,Default,,0,0,0,,Мм... Люси болашақтан қалай келді?
Dialogue: 0,0:20:30.19,0:20:34.36,Default,,0,0,0,,Біз маңызды нәрсені әлі естіген жоқпыз.
Dialogue: 0,0:20:38.41,0:20:40.79,Default,,0,0,0,,Ең нашар болашақты өзгерту
Dialogue: 0,0:20:40.91,0:20:43.04,Default,,0,0,0,,Бұл мүмкін болатын ең нашар болашақ па?
Dialogue: 0,0:20:43.33,0:20:46.88,Default,,0,0,0,,Сіздің болашақта нақты не болды?
Dialogue: 0,0:20:49.38,0:20:50.55,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:56.09,0:20:58.39,Default,,0,0,0,,Ол кісі маған айтты
Dialogue: 0,0:21:00.31,0:21:02.52,Default,,0,0,0,,Бізді алда не күтіп тұр...
Dialogue: 0,0:21:04.52,0:21:05.35,Default,,0,0,0,,Үмітсіздік
Dialogue: 0,0:21:05.48,0:21:06.27,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:21:11.57,0:21:15.40,Default,,0,0,0,,Бұл елге 10 000-нан астам айдаһар тобы шабуыл жасайды.
Dialogue: 0,0:21:35.42,0:21:36.18,Default,,0,0,0,,Қала өртеніп кетті.
Dialogue: 0,0:21:37.34,0:21:41.60,Default,,0,0,0,,Құлып құлап, көп адам қаза тапты.
Dialogue: 0,0:21:43.31,0:21:46.89,Default,,0,0,0,,Сөздер дұрыс па, жалған ба?
Dialogue: 0,0:21:48.65,0:21:52.23,Default,,0,0,0,,Жауабын маған сеніп тапсырды.
Dialogue: 0,0:21:53.07,0:21:55.11,Default,,0,0,0,,Ұлы сиқырлы шайқас демонстрациясының нәтижелері...
Dialogue: 0,0:21:56.49,0:21:58.86,Default,,0,0,0,,Менің шешімдерімді басшылыққа алады
Dialogue: 0,0:23:47.10,0:23:53.10,Default,,0,0,0,,~♪
Dialogue: 0,0:23:55.81,0:23:57.36,Default,,0,0,0,,Он мың айдаһар
Dialogue: 0,0:23:57.48,0:23:59.74,Default,,0,0,0,,Болашақта керемет нәрсе болатын сияқты.
Dialogue: 0,0:23:59.86,0:24:01.36,Default,,0,0,0,,Нацу, не істеуіміз керек?
Dialogue: 0,0:24:01.49,0:24:04.87,Default,,0,0,0,,Әй, бақытты, мен жаңа ғана керемет құпия жоспар ойлап таптым.
Dialogue: 0,0:24:04.99,0:24:07.91,Default,,0,0,0,,Уау, мен мүлде үлкен үміт күтпеймін.
Dialogue: 0,0:24:08.20,0:24:12.58,Default,,0,0,0,,Соңына дейін тыңдаңыз, бақытты болыңыз. Бұл жолы шынымен де керемет.
Dialogue: 0,0:24:13.08,0:24:14.88,Default,,0,0,0,,Келесі жолы «Бақа»
Dialogue: 0,0:24:15.04,0:24:16.38,Default,,0,0,0,,Сонымен, оның құпиясы неде?
Dialogue: 0,0:24:16.50,0:24:18.13,Default,,0,0,0,,Айдаһарлар өте қиын болуы мүмкін
Dialogue: 0,0:24:18.46,0:24:21.09,Default,,0,0,0,,Қалыпты соқпа, сиқырмен ұр
Dialogue: 0,0:24:21.22,0:24:23.97,Default,,0,0,0,,Нацу Бұл әдеттегідей
Dialogue: 0,0:24:25.47,0:24:31.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory