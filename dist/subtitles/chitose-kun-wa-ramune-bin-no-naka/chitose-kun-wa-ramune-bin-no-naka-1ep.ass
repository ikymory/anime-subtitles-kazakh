Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.83,0:00:08.34,Default,,0,0,0,,《Саку: Көк сақиналар.
Dialogue: 0,0:00:08.34,0:00:11.17,Default,,0,0,0,,Ескі ағаш сыныпта➨
Dialogue: 0,0:00:11.17,0:00:14.34,Default,,0,0,0,,Үзіліс кезінде дәлізде➨
Dialogue: 0,0:00:14.34,0:00:17.01,Default,,0,0,0,,Сабақтан кейін далада》
Dialogue: 0,0:00:17.01,0:00:19.68,Default,,0,0,0,,《Кешкі көл: Көк гүлдейді.
Dialogue: 0,0:00:19.68,0:00:22.02,Default,,0,0,0,,Мен ерекше болғым келеді➨
Dialogue: 0,0:00:22.02,0:00:25.52,Default,,0,0,0,,Менің ерекше сезімдерімді құшақтаған кезде》
Dialogue: 0,0:00:25.52,0:00:27.69,Default,,0,0,0,,《Аспан: көк түске боялған.
Dialogue: 0,0:00:27.69,0:00:30.86,Default,,0,0,0,,Түсінбеушілік пен қателіктерді қайталасақ та➨
Dialogue: 0,0:00:30.86,0:00:35.36,Default,,0,0,0,,Мен жібергім келмейді, белгілі бір байланыстың болуын қалаймын》
Dialogue: 0,0:00:35.36,0:00:37.53,Default,,0,0,0,,《Юдзуки: Аоға айқайлаңыз.
Dialogue: 0,0:00:37.53,0:00:40.20,Default,,0,0,0,,Ауырсыну және жылау➨
Dialogue: 0,0:00:40.20,0:00:43.71,Default,,0,0,0,,Өзіңмен болу》
Dialogue: 0,0:00:43.71,0:00:46.71,Default,,0,0,0,,《Ертеңгі жел: көк түс.
Dialogue: 0,0:00:46.71,0:00:50.38,Default,,0,0,0,,Мен салған арманға жету жолында➨
Dialogue: 0,0:00:50.38,0:00:53.88,Default,,0,0,0,,Адасып кетсем де, бас тартсам да.
Dialogue: 0,0:00:53.88,0:00:56.39,Default,,0,0,0,,《Ян: Көкке қарай жүгіру.
Dialogue: 0,0:00:56.39,0:00:58.39,Default,,0,0,0,,Қолыңызда бардың бәрін беріңіз➨
Dialogue: 0,0:00:58.39,0:01:03.33,Default,,0,0,0,,Мен осы сәтте құмарлықпен өмір сүргім келеді.
Dialogue: 0,0:01:03.33,0:01:05.83,Default,,0,0,0,,《Саку: Біз сондаймыз➨
Dialogue: 0,0:01:05.83,0:01:08.83,Default,,0,0,0,,Түрлі-түсті көк түстер сериясы➨
Dialogue: 0,0:01:08.83,0:01:12.00,Default,,0,0,0,,Бір реттік көктемде суға батып кету.
Dialogue: 0,0:01:12.00,0:01:14.67,Default,,0,0,0,,Ол бір жерде батып бара жатқан болуы керек➨
Dialogue: 0,0:01:14.67,0:01:17.84,Default,,0,0,0,,Тек осы жүректе бейнеленген...》
Dialogue: 0,0:01:17.84,0:01:23.35,Default,,0,0,0,,《Барлығы: Жалғыз көкті іздеймін》
Dialogue: 0,0:01:26.35,0:01:36.36,Default,,0,0,0,,♬～
Dialogue: 0,0:01:36.36,0:01:39.66,Default,,0,0,0,,(мраморлардың дыбысы)
Dialogue: 0,0:01:43.37,0:01:46.37,Default,,0,0,0,,《Сәку: Көктем – бастаулар мезгілі.
Dialogue: 0,0:01:46.37,0:01:49.87,Default,,0,0,0,,Пастел көк түске боялған аспан➨
Dialogue: 0,0:01:49.87,0:01:52.54,Default,,0,0,0,,Тербелген қара шаш пен юбка ➨
Dialogue: 0,0:01:52.54,0:01:55.38,Default,,0,0,0,,Шие гүлінің түсіне боялған бүйірлік профиль де➨
Dialogue: 0,0:01:55.38,0:01:59.21,Default,,0,0,0,,Барлығы кездесуді алдын ала ескертуге толы.
Dialogue: 0,0:01:59.21,0:02:01.82,Default,,0,0,0,,Бір күні мен ересек адам боламын➨
Dialogue: 0,0:02:01.82,0:02:04.65,Default,,0,0,0,,Қымбатты екеніңізге сенімдімін, жылағым келеді➨
Dialogue: 0,0:02:04.65,0:02:07.66,Default,,0,0,0,,Аздап ұялатын күндерім болады➨
Dialogue: 0,0:02:07.66,0:02:12.06,Default,,0,0,0,,Мен алда не күтіп тұрғанына көбірек сенгім келеді...
Dialogue: 0,0:02:14.16,0:02:16.16,Default,,0,0,0,,Уау….
Dialogue: 0,0:02:16.16,0:02:19.50,Default,,0,0,0,,Қайырлы таң, Саку-кун.
Dialogue: 0,0:02:19.50,0:02:23.34,Default,,0,0,0,,《Саку: Юку Учида. Бұл соншалықты байқалмайды ➨
Dialogue: 0,0:02:23.34,0:02:27.34,Default,,0,0,0,,Мектепке баратын түні мен: ``Шынында, ол саған ұнайды, солай ма?''➨
Dialogue: 0,0:02:27.34,0:02:30.68,Default,,0,0,0,,Ол сенімен сырласуға келетін жігіттің түрі.
Dialogue: 0,0:02:30.68,0:02:33.18,Default,,0,0,0,,Не болды? Қайырлы таң.
Dialogue: 0,0:02:33.18,0:02:36.35,Default,,0,0,0,,Мынаны қараңыз.
Dialogue: 0,0:02:36.35,0:02:41.02,Default,,0,0,0,,Аа, болды... Жарайды, жарайды. иә?
Dialogue: 0,0:02:41.02,0:02:44.36,Default,,0,0,0,,Сіздің реакцияңыз қандай? `` Мен оны жоққа шығара алмаймын, бірақ оны өзгертейік.''
Dialogue: 0,0:02:44.36,0:02:48.03,Default,,0,0,0,,Саку-кун танымал болғандықтан, көптеген адамдар онымен қиындыққа тап болады.
Dialogue: 0,0:02:48.03,0:02:51.20,Default,,0,0,0,,Бұл өтірік! ? Барлығына өте мейірімді➨
Dialogue: 0,0:02:51.20,0:02:54.04,Default,,0,0,0,,Лас әзілдерден бастап, әзіл-қалжың әңгімеге дейін мұны оңай жасай аласыз➨
Dialogue: 0,0:02:54.04,0:02:56.87,Default,,0,0,0,,Ол әдемі ғана емес, сонымен қатар өте спортшы➨
Dialogue: 0,0:02:56.87,0:02:59.37,Default,,0,0,0,,Менің де бағаларым жоғары ➨
Dialogue: 0,0:02:59.37,0:03:01.98,Default,,0,0,0,,Басатын элемент дәл қай жерде?
Dialogue: 0,0:03:01.98,0:03:05.15,Default,,0,0,0,,Негізінен солай емес пе?
Dialogue: 0,0:03:05.15,0:03:07.48,Default,,0,0,0,,Кеше үйірме жұмыстарынан үйге қайтып келе жатқанда➨
Dialogue: 0,0:03:07.48,0:03:11.32,Default,,0,0,0,,Жаңа сынып жарияланды. (Саку) А?
Dialogue: 0,0:03:11.32,0:03:14.82,Default,,0,0,0,,Тағы бірге. Мен сені осы жылы тағы көремін деп үміттенемін.
Dialogue: 0,0:03:16.83,0:03:20.50,Default,,0,0,0,,Бұл тек біз емес, барлық кәдімгі мүшелер.
Dialogue: 0,0:03:20.50,0:03:23.67,Default,,0,0,0,,Ммм... Әзірше мен бақыттымын➨
Dialogue: 0,0:03:23.67,0:03:26.33,Default,,0,0,0,,Мейірімділік танытсаңыз, жарайды деп ойлаймын.
Dialogue: 0,0:03:26.33,0:03:28.54,Default,,0,0,0,,Ахаха.
Dialogue: 0,0:03:32.84,0:03:36.51,Default,,0,0,0,,Ах! Әй, бұл Саку! Қайырлы таң! Укчи де!
Dialogue: 0,0:03:36.51,0:03:41.52,Default,,0,0,0,,《Саку: Хиираги Юко. Менің айналамдағылар оны «заңды әйелім» деп атайды.
Dialogue: 0,0:03:41.52,0:03:45.02,Default,,0,0,0,,Ерлерге де, әйелдерге де шынайы күлкі жіберіңіз➨
Dialogue: 0,0:03:45.02,0:03:47.86,Default,,0,0,0,,Ол өз сыныбында пұт сияқты.
Dialogue: 0,0:03:47.86,0:03:51.03,Default,,0,0,0,,Қайырлы таң, Юко-чан, екеуің де.
Dialogue: 0,0:03:51.03,0:03:54.03,Default,,0,0,0,,Ия, тағы бірге сабақ!
Dialogue: 0,0:03:54.03,0:03:56.87,Default,,0,0,0,,Эхехехе~ Саку сен де бақыттысың ба?
Dialogue: 0,0:03:56.87,0:04:00.30,Default,,0,0,0,,Әрине. Кешкі көлден шыққанда төмен қараймын➨
Dialogue: 0,0:04:00.30,0:04:02.97,Default,,0,0,0,,Мектепке ақырын жүруге тура келді.
Dialogue: 0,0:04:02.97,0:04:06.81,Default,,0,0,0,,Жаңа қызға қарап отырып➨
Dialogue: 0,0:04:06.81,0:04:10.31,Default,,0,0,0,,Ол өте жеңіл қадамдармен жүрді.
Dialogue: 0,0:04:10.31,0:04:13.82,Default,,0,0,0,,Ех! Бұл не? Бұл өте қызықсыз.
Dialogue: 0,0:04:13.82,0:04:16.82,Default,,0,0,0,,Сәлем. Ойымда жоқ! ?
Dialogue: 0,0:04:16.82,0:04:19.15,Default,,0,0,0,,Ху, Юку, менің уақытым➨
Dialogue: 0,0:04:19.15,0:04:22.16,Default,,0,0,0,,Сіз ашулануыңыз керек, себебі сіздің реакцияңыз басқаша. Бұл дұрыс.
Dialogue: 0,0:04:22.16,0:04:24.16,Default,,0,0,0,,Сейцу. Апыр-ай.
Dialogue: 0,0:04:24.16,0:04:27.00,Default,,0,0,0,,Кешіріңіз, мен түсіру уақыты келді деп ойладым.
Dialogue: 0,0:04:27.00,0:04:31.33,Default,,0,0,0,,《Саку: Кайто Асано. Небәрі екі жылдың ішінде ол ерлер автобусының эйсі болды.
Dialogue: 0,0:04:31.33,0:04:34.84,Default,,0,0,0,,Спорттық мінезді қарапайым ақымақ.
Dialogue: 0,0:04:34.84,0:04:38.67,Default,,0,0,0,,Оны дұрыс жерден кеспесең, ол ұзын болып қалады.
Dialogue: 0,0:04:38.67,0:04:42.51,Default,,0,0,0,,《Казуки Мизушино. Футбол клубының негізгі ойыншысы.
Dialogue: 0,0:04:42.51,0:04:47.02,Default,,0,0,0,,Сырттай көрінгенімен, ол іс жүзінде есептеп, айла-шарғы жасайды.
Dialogue: 0,0:04:47.02,0:04:50.35,Default,,0,0,0,,Қалай болғанда да, бұл кездесу➨
Dialogue: 0,0:04:50.35,0:04:53.86,Default,,0,0,0,,Хитоза командасы! Юко Хираги періштелері.
Dialogue: 0,0:04:53.86,0:04:55.86,Default,,0,0,0,,Кайто динамит бомбалаушылары!
Dialogue: 0,0:04:55.86,0:04:59.36,Default,,0,0,0,,Kaz Creative агенттігі. ЮА5.
Dialogue: 0,0:04:59.36,0:05:01.96,Default,,0,0,0,,Жарайды, музыкалық айырмашылыққа байланысты...
Dialogue: 0,0:05:01.96,0:05:03.97,Default,,0,0,0,,Таратылды!
Dialogue: 0,0:05:03.97,0:05:05.97,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:05:05.97,0:05:08.80,Default,,0,0,0,,О, бұл Хитоза! (Юдзуки) Қайырлы таң.
Dialogue: 0,0:05:08.80,0:05:11.81,Default,,0,0,0,,Шашыңыз ұзарып кетпей ме?
Dialogue: 0,0:05:11.81,0:05:16.31,Default,,0,0,0,,《Саку: Цинхай Ян. Ол кішкентай болса да, ол әйелдер автобусының эйси ретінде белсенді➨
Dialogue: 0,0:05:16.31,0:05:18.81,Default,,0,0,0,,Ол спорттық және жігерлі қыз.
Dialogue: 0,0:05:18.81,0:05:20.82,Default,,0,0,0,,Мен оны кесіп аламын ба?
Dialogue: 0,0:05:20.82,0:05:23.15,Default,,0,0,0,,Мен бас тартамын, өйткені қан көремін деп қорқамын.
Dialogue: 0,0:05:23.15,0:05:25.15,Default,,0,0,0,,Андато! Бұл нені білдіреді...!
Dialogue: 0,0:05:25.15,0:05:27.66,Default,,0,0,0,,《Саку: Себебі мен ер достарым сияқты белсендімін➨
Dialogue: 0,0:05:27.66,0:05:30.16,Default,,0,0,0,,Оның кейде көрсететін қорғансыз қыз мінезі➨
Dialogue: 0,0:05:30.16,0:05:32.33,Default,,0,0,0,,Бұл тартымды》 Эй➨
Dialogue: 0,0:05:32.33,0:05:35.50,Default,,0,0,0,,Ең алдымен менімен сол баскетбол клубынан сөйлесу керек, солай ма?
Dialogue: 0,0:05:35.50,0:05:38.83,Default,,0,0,0,,Е-е, бұл туралы жаңа ештеңе жоқ.
Dialogue: 0,0:05:38.83,0:05:42.84,Default,,0,0,0,,Дұрыс. Читоза мен Мизушинодағы көзге арналған мереке.
Dialogue: 0,0:05:42.84,0:05:47.34,Default,,0,0,0,,《Саку: Юдзуки Нанасе. Ол сонымен қатар әйел автобус жүргізушісі және Янның серіктесі.
Dialogue: 0,0:05:47.34,0:05:51.01,Default,,0,0,0,,Сыныпта кім ең сүйкімді деген пікірталас болған кезде➨
Dialogue: 0,0:05:51.01,0:05:55.02,Default,,0,0,0,,Оның аты әрқашан Юкомен бірге аталады.
Dialogue: 0,0:05:55.02,0:05:57.35,Default,,0,0,0,,Юко табиғи кумир түрі болса➨
Dialogue: 0,0:05:57.35,0:06:01.29,Default,,0,0,0,,Ол әртүрлі мимикаларды қолданатын актрисаның түрі.
Dialogue: 0,0:06:01.29,0:06:04.79,Default,,0,0,0,,Жарайды, мен бірінші рет дұрыс сөйлеп тұрмын➨
Dialogue: 0,0:06:04.79,0:06:06.96,Default,,0,0,0,,Мен өзімді таныстырудан бастасам бола ма?
Dialogue: 0,0:06:06.96,0:06:09.63,Default,,0,0,0,,Эх, Укчи, сен тым байыптысың.
Dialogue: 0,0:06:09.63,0:06:11.63,Default,,0,0,0,,Мен осылай естідім.
Dialogue: 0,0:06:11.63,0:06:16.97,Default,,0,0,0,,Кохон. Сонымен, біз Chitose командасына жаңа мүше қосып жатырмыз.
Dialogue: 0,0:06:16.97,0:06:20.14,Default,,0,0,0,,О! Aomi Dangerous Challengers!
Dialogue: 0,0:06:20.14,0:06:22.98,Default,,0,0,0,,Бос айдай.
Dialogue: 0,0:06:22.98,0:06:25.31,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:06:25.31,0:06:28.12,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:31.15,0:06:33.66,Default,,0,0,0,,《Ябе, тым көңілді болдыңыз ба?
Dialogue: 0,0:06:33.66,0:06:36.99,Default,,0,0,0,,Бірақ, бұл қалыпты жүргізу.
Dialogue: 0,0:06:36.99,0:06:42.00,Default,,0,0,0,,Бір жерде біреу жақсы көреді, бір жерде біреу жек көреді.
Dialogue: 0,0:06:42.00,0:06:46.80,Default,,0,0,0,,Мені қоршап тұрған әлем бүгінде үзіліссіз және тыныш сияқты.
Dialogue: 0,0:07:00.45,0:07:02.62,Default,,0,0,0,,Бұл Иванами, менің сынып жетекшім.
Dialogue: 0,0:07:02.62,0:07:06.29,Default,,0,0,0,,Ендеше, оны қалдырып, қалағанымызды жасайық.
Dialogue: 0,0:07:06.29,0:07:10.13,Default,,0,0,0,,《Иванами Кураносуке. Әдетте Курасен деген атпен белгілі.
Dialogue: 0,0:07:10.13,0:07:12.13,Default,,0,0,0,,Бірінші курста да мен өз бөлмемде болдым➨
Dialogue: 0,0:07:12.13,0:07:14.63,Default,,0,0,0,,Дайындық мектебінің мұғалімі сияқты емес, бірақ бос ➨
Dialogue: 0,0:07:14.63,0:07:17.13,Default,,0,0,0,,Оқушылар өте сенімді》
Dialogue: 0,0:07:17.13,0:07:20.47,Default,,0,0,0,,Ша! Мектеп ережелері тым қатал емес сияқты.
Dialogue: 0,0:07:20.47,0:07:23.81,Default,,0,0,0,,Жарайды, ол кісінің киімі кең болғандықтан.
Dialogue: 0,0:07:23.81,0:07:26.47,Default,,0,0,0,,Әдетте үйірме жұмыстарынан терлегеннен кейін➨
Dialogue: 0,0:07:26.47,0:07:29.81,Default,,0,0,0,,Сіз галстукыңызды дұрыс байлай аласыз ба?
Dialogue: 0,0:07:29.81,0:07:34.15,Default,,0,0,0,,Оны таспаға айналдыру керек. Бұл галстукке қарағанда азырақ қысымды сезінеді.
Dialogue: 0,0:07:34.15,0:07:38.49,Default,,0,0,0,,Күйеуім, менің мінезіме лента жақсы көрінеді деп ойлайсың ба?
Dialogue: 0,0:07:38.49,0:07:40.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:40.49,0:07:43.66,Default,,0,0,0,,Олай болса, Хитоза, мен сенен жалғастыруыңды өтінемін. Қосулы ма?
Dialogue: 0,0:07:43.66,0:07:46.10,Default,,0,0,0,,Қытырлақ, өтінемін? А~ Тек Саку үшін.
Dialogue: 0,0:07:46.10,0:07:49.50,Default,,0,0,0,,Оф…. сізді түсіндім.
Dialogue: 0,0:07:53.67,0:07:56.67,Default,,0,0,0,,Кохон. Ал...
Dialogue: 0,0:07:56.67,0:08:00.61,Default,,0,0,0,,Менің атымды білмейтін адам жоқ деп ойлаймын.
Dialogue: 0,0:08:00.61,0:08:03.61,Default,,0,0,0,,Иванами Сенсейдің эксклюзивті қызметшісі➨
Dialogue: 0,0:08:03.61,0:08:06.61,Default,,0,0,0,,Бұл Читосе Саку-чан!
Dialogue: 0,0:08:06.61,0:08:09.45,Default,,0,0,0,,Айтпақшы, артымнан мені «шалақ» дейді!
Dialogue: 0,0:08:09.45,0:08:11.45,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:08:11.45,0:08:13.62,Default,,0,0,0,,Саку Бұл өте тегіс!
Dialogue: 0,0:08:13.62,0:08:15.79,Default,,0,0,0,,Цк. (Инаба) Саму.
Dialogue: 0,0:08:15.79,0:08:17.79,Default,,0,0,0,,Тек шешеміз.
Dialogue: 0,0:08:17.79,0:08:20.30,Default,,0,0,0,,Біріншіден, мен сынып төрағасымын.
Dialogue: 0,0:08:20.30,0:08:22.30,Default,,0,0,0,,Өткен жылы Саку ұнаса ше?
Dialogue: 0,0:08:22.30,0:08:25.30,Default,,0,0,0,,Білікті емес пе? Қарсылық жоқ!
Dialogue: 0,0:08:25.30,0:08:27.30,Default,,0,0,0,,Барлығына солай ма?
Dialogue: 0,0:08:29.30,0:08:31.64,Default,,0,0,0,,Жарайды, мен мұны істеймін.
Dialogue: 0,0:08:31.64,0:08:34.98,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:08:34.98,0:08:37.48,Default,,0,0,0,,Олай болса, келесісі төрағаның орынбасары деп ойлаймын.
Dialogue: 0,0:08:37.48,0:08:39.48,Default,,0,0,0,,Иә, иә, иә!
Dialogue: 0,0:08:39.48,0:08:42.48,Default,,0,0,0,,Саку төраға болайын десе, мен істеймін!
Dialogue: 0,0:08:42.48,0:08:44.82,Default,,0,0,0,,Мен де бірінші жылы сайлауға түстім➨
Dialogue: 0,0:08:44.82,0:08:48.32,Default,,0,0,0,,Маған көп жұмыс берген кім болды?
Dialogue: 0,0:08:48.32,0:08:50.99,Default,,0,0,0,,Жарайды! Бастауыш мектепте оқып жүрген кезім➨
Dialogue: 0,0:08:50.99,0:08:53.66,Default,,0,0,0,,Қояндар мен өлтірушілерді жақсы күтетін!
Dialogue: 0,0:08:53.66,0:08:56.33,Default,,0,0,0,,Сіз тірі табиғатқа жауапты болғыңыз келе ме?
Dialogue: 0,0:08:56.33,0:08:59.00,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:08:59.00,0:09:01.77,Default,,0,0,0,,Бұл Хиираги Юко. Сізге көп рахмет.
Dialogue: 0,0:09:01.77,0:09:03.77,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:09:03.77,0:09:07.28,Default,,0,0,0,,Жарайды, мен сенен бұдан былай бір нәрсе істеуіңді өтінгім келеді.
Dialogue: 0,0:09:30.97,0:09:33.47,Default,,0,0,0,,Эй, сен осындасың.
Dialogue: 0,0:09:37.14,0:09:39.81,Default,,0,0,0,,Темекі шегуге толық тыйым салынбады ма?
Dialogue: 0,0:09:39.81,0:09:44.48,Default,,0,0,0,,Хмф, егер сіз студенттерге түтін үрмесеңіз, бұл үлкен мәселе болмайды.
Dialogue: 0,0:09:44.48,0:09:47.82,Default,,0,0,0,,Сіздің ойыңызша, алдарыңызда не тұр?
Dialogue: 0,0:09:47.82,0:09:51.99,Default,,0,0,0,,Темекі шегуім туралы үндемеу үшін мен осы жердің қосалқы кілтін алдым➨
Dialogue: 0,0:09:51.99,0:09:56.32,Default,,0,0,0,,Біртүрлі адам, меніңше. Жарайды онда.
Dialogue: 0,0:09:56.32,0:10:00.66,Default,,0,0,0,,Қазіргі шылым шегетіндердің иықтары тар емес пе?
Dialogue: 0,0:10:00.66,0:10:02.66,Default,,0,0,0,,Сізді көп ұрып-соқты.
Dialogue: 0,0:10:02.66,0:10:06.57,Default,,0,0,0,,Меніңше, бәрі оңай түсінікті зұлым адамды іздейді.
Dialogue: 0,0:10:08.50,0:10:11.01,Default,,0,0,0,,Менде бір сезім бар...
Dialogue: 0,0:10:17.01,0:10:19.01,Default,,0,0,0,,Сонымен, тапсырма қандай?
Dialogue: 0,0:10:19.01,0:10:21.35,Default,,0,0,0,,Аа...
Dialogue: 0,0:10:21.35,0:10:25.69,Default,,0,0,0,,Кента Ямадзаки. Бірінші курстың үшінші семестрінен бастап➨
Dialogue: 0,0:10:25.69,0:10:28.52,Default,,0,0,0,,Мектепке келмеу. (Саку) Хе.
Dialogue: 0,0:10:28.52,0:10:30.53,Default,,0,0,0,,Әзірге менің білетінім➨
Dialogue: 0,0:10:30.53,0:10:35.36,Default,,0,0,0,,Тек оған аниме, жеңіл романдар ұнайтын сияқты.
Dialogue: 0,0:10:35.36,0:10:39.03,Default,,0,0,0,,Күрсін... Неге маған айтып тұрсың?
Dialogue: 0,0:10:39.03,0:10:44.54,Default,,0,0,0,,Неліктен осындай жақсы жігіт 30 жастан кейін әлі бойдақ болып жүр деп ойлайсыз?
Dialogue: 0,0:10:44.54,0:10:49.21,Default,,0,0,0,,Менің азғантай жалақымды Катамачидің ойын-сауық бизнесіне жұмсау "Блейзеріңді шешпе" ➨
Dialogue: 0,0:10:49.21,0:10:51.71,Default,,0,0,0,,Сіз оған ақшаны не үшін құйып жатқаныңызды білесіз бе?
Dialogue: 0,0:10:51.71,0:10:53.88,Default,,0,0,0,,Тұлға ретінде де, ұстаз ретінде де➨
Dialogue: 0,0:10:53.88,0:10:56.38,Default,,0,0,0,,Мен тек қана дисквалификацияланғанымды білемін.
Dialogue: 0,0:10:56.38,0:10:59.89,Default,,0,0,0,,Балалардың жағдайын тек балалар ғана түсінеді.
Dialogue: 0,0:10:59.89,0:11:03.83,Default,,0,0,0,,Үлкендердің жағдайын тек ересектер түсінетініне көз жеткізіңіз.
Dialogue: 0,0:11:03.83,0:11:08.16,Default,,0,0,0,,Таку…. Ең бастысы - Ямадзаки-кунды сендіру➨
Dialogue: 0,0:11:08.16,0:11:10.67,Default,,0,0,0,,Сіз оны мектепке жібергіңіз келетінін айтып отырсыз.
Dialogue: 0,0:11:10.67,0:11:14.34,Default,,0,0,0,,Айтпақшы, бас тартуға мүмкіндігім бар ма?
Dialogue: 0,0:11:14.34,0:11:16.34,Default,,0,0,0,,Қол жететін жерге қойыңыз➨
Dialogue: 0,0:11:16.34,0:11:19.84,Default,,0,0,0,,Мен шеше алатын мәселелер бар.➨
Dialogue: 0,0:11:19.84,0:11:22.68,Default,,0,0,0,,Мен оны жалғыз қалдыра аламын ба?
Dialogue: 0,0:11:22.68,0:11:27.68,Default,,0,0,0,,Читосе-кун - кез келген адамның қолынан келетін супер қаһарман.
Dialogue: 0,0:11:31.52,0:11:35.19,Default,,0,0,0,,《Тч, ол шынымен де қиын қария.
Dialogue: 0,0:11:35.19,0:11:40.53,Default,,0,0,0,,Әдемі өмір сүре алмасаң, өлгеннің айырмашылығы жоқ.
Dialogue: 0,0:11:40.53,0:11:45.33,Default,,0,0,0,,Бұл менің эстетикам.
Dialogue: 0,0:11:57.88,0:12:01.98,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:01.98,0:12:07.66,Default,,0,0,0,,Әйтеуір, бүгін сені кездестіргендей болдым.
Dialogue: 0,0:12:07.66,0:12:09.66,Default,,0,0,0,,Сіз не оқыдыңыз?
Dialogue: 0,0:12:09.66,0:12:13.49,Default,,0,0,0,,«Елес әйел» Уильям Ирланд.
Dialogue: 0,0:12:13.49,0:12:16.66,Default,,0,0,0,,«Түн жас еді, ол да жас еді➨
Dialogue: 0,0:12:16.66,0:12:20.84,Default,,0,0,0,,Түнгі ауа тәтті болғанымен, көңілі ащы еді».
Dialogue: 0,0:12:20.84,0:12:25.01,Default,,0,0,0,,Бұл жаңа аударма. Ха, мен мұны білдім.
Dialogue: 0,0:12:25.01,0:12:27.34,Default,,0,0,0,,Бұл аз.
Dialogue: 0,0:12:27.34,0:12:32.35,Default,,0,0,0,,《Сәку: Әпкемді алғаш рет өткен қыркүйекте кездестірдім...》
Dialogue: 0,0:12:32.35,0:12:34.85,Default,,0,0,0,,⸨Тоқта!
Dialogue: 0,0:12:34.85,0:12:37.52,Default,,0,0,0,,Күте тұрыңыз...! Күте тұрыңыз!
Dialogue: 0,0:12:37.52,0:12:40.86,Default,,0,0,0,,Тоқта. (Өзенге құлаған дыбыс)
Dialogue: 0,0:12:40.86,0:12:43.36,Default,,0,0,0,,Дассе~! Өйткені сен өлтірдің➨
Dialogue: 0,0:12:43.36,0:12:48.56,Default,,0,0,0,,Үйге барар жолда алыс жүріңіз. Бұл не...!
Dialogue: 0,0:12:51.87,0:12:53.87,Default,,0,0,0,,Үлкен апа да... (жүгіріп)
Dialogue: 0,0:12:53.87,0:12:55.87,Default,,0,0,0,,Мазете!
Dialogue: 0,0:12:57.87,0:13:00.58,Default,,0,0,0,,Ах...!
Dialogue: 0,0:13:02.81,0:13:06.15,Default,,0,0,0,,Ахахаха!
Dialogue: 0,0:13:06.15,0:13:08.32,Default,,0,0,0,,Міне! Апыр-ай!
Dialogue: 0,0:13:08.32,0:13:10.82,Default,,0,0,0,,Хе... Эй, не болып жатыр?
Dialogue: 0,0:13:10.82,0:13:14.16,Default,,0,0,0,,Келіңіздер! Хехе….
Dialogue: 0,0:13:14.16,0:13:17.33,Default,,0,0,0,,Иә! Ах!
Dialogue: 0,0:13:17.33,0:13:22.83,Default,,0,0,0,,А, сендер де келіңдер! Асықшы! Эй!
Dialogue: 0,0:13:22.83,0:13:27.00,Default,,0,0,0,,Эй, мына қыз біртүрлі екен! Жоғал әрі! Жоғал әрі!
Dialogue: 0,0:13:27.00,0:13:29.67,Default,,0,0,0,,Жарайды, бәрімізді шақырыңыз!
Dialogue: 0,0:13:29.67,0:13:34.68,Default,,0,0,0,,Қараңдар! Әй, эй... сен қу екенсің! (көңілді дауыс)
Dialogue: 0,0:13:37.01,0:13:41.35,Default,,0,0,0,,Жақында кездескенше~ Біртүрлі әпке! (Ұлдар) Сонда кездескенше!
Dialogue: 0,0:13:41.35,0:13:43.55,Default,,0,0,0,,Аа...
Dialogue: 0,0:13:48.69,0:13:51.03,Default,,0,0,0,,Су да тамшылайды.Сен жақсы әйелсің бе?
Dialogue: 0,0:13:51.03,0:13:53.36,Default,,0,0,0,,Жоқ, тіпті жақсы қарасам да➨
Dialogue: 0,0:13:53.36,0:13:56.03,Default,,0,0,0,,Өйткені бұл суға батқан әйелдің елесі.
Dialogue: 0,0:13:56.03,0:13:59.87,Default,,0,0,0,,Бұл бола ма?
Dialogue: 0,0:13:59.87,0:14:02.64,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:14:02.64,0:14:05.81,Default,,0,0,0,,Бұл тазалау...
Dialogue: 0,0:14:05.81,0:14:09.48,Default,,0,0,0,,Мм... Иә? Не?
Dialogue: 0,0:14:09.48,0:14:12.65,Default,,0,0,0,,Мм... неге олай істедің?
Dialogue: 0,0:14:12.65,0:14:16.65,Default,,0,0,0,,Мен көмектессем де, әдетте құлап қалған баланы көтеремін➨
Dialogue: 0,0:14:16.65,0:14:20.15,Default,,0,0,0,,Басқа баланы сынау оңай деп ойлаймын...
Dialogue: 0,0:14:20.15,0:14:22.66,Default,,0,0,0,,Хмм….
Dialogue: 0,0:14:22.66,0:14:27.83,Default,,0,0,0,,Бәріміз лайланып, күліп, үйге иық тірестірсек жақсы болар еді➨
Dialogue: 0,0:14:27.83,0:14:30.50,Default,,0,0,0,,Бұл әлдеқайда жақсы деп ойламайсыз ба?
Dialogue: 0,0:14:30.50,0:14:34.17,Default,,0,0,0,,Тіпті егер сіз, туыстықсыз адам, нәтижесінде дымқыл боласыз ба?
Dialogue: 0,0:14:34.17,0:14:38.07,Default,,0,0,0,,Жауапсыз өтіп бара жатқан бейтаныс адам сізді мазақ етсе де?
Dialogue: 0,0:14:40.01,0:14:44.85,Default,,0,0,0,,Мен үшін бұл қызықтырақ болар деп ойладым.
Dialogue: 0,0:14:44.85,0:14:49.85,Default,,0,0,0,,Демек, сіздің айтып отырғаныңыз негізсіз.
Dialogue: 0,0:14:49.85,0:14:53.35,Default,,0,0,0,,Сізден тағы бір нәрсе сұрасам болады ма?
Dialogue: 0,0:14:53.35,0:14:55.69,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:14:55.69,0:14:59.19,Default,,0,0,0,,Маған атыңызды айтыңызшы.
Dialogue: 0,0:15:02.30,0:15:04.30,Default,,0,0,0,,Асуказэ Нишино.
Dialogue: 0,0:15:04.30,0:15:07.30,Default,,0,0,0,,Ертеңгі жел - ертең соғатын жел⸩
Dialogue: 0,0:15:07.30,0:15:09.30,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:15:09.30,0:15:12.47,Default,,0,0,0,,《Ертең соғатын жел.
Dialogue: 0,0:15:12.47,0:15:17.48,Default,,0,0,0,,Ол есім өз қалауымен еркін өмір сүретін қызға арналған➨
Dialogue: 0,0:15:17.48,0:15:21.48,Default,,0,0,0,,Саған керемет көрінді деп ойладым》
Dialogue: 0,0:15:21.48,0:15:25.15,Default,,0,0,0,,Курасен мені тағы да бір қиыншылық жасауға мәжбүр етті.
Dialogue: 0,0:15:25.15,0:15:29.99,Default,,0,0,0,,Сіз әлі де кемелсізсіз.
Dialogue: 0,0:15:29.99,0:15:33.16,Default,,0,0,0,,Отшашусыз әдемі саябаққа ұқсайды.
Dialogue: 0,0:15:33.16,0:15:36.00,Default,,0,0,0,,Бұл оны айтудың өте айналмалы тәсілі.
Dialogue: 0,0:15:36.00,0:15:39.67,Default,,0,0,0,,Балаларды жарақаттауы мүмкін ойын жабдықтары алынып тасталды➨
Dialogue: 0,0:15:39.67,0:15:42.50,Default,,0,0,0,,Тіпті доп ойнай алмайтын саябақ.
Dialogue: 0,0:15:42.50,0:15:47.68,Default,,0,0,0,,Шаршаған үлкендер мұңды жүзбен кітап оқып отыр.
Dialogue: 0,0:15:47.68,0:15:49.84,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:15:49.84,0:15:54.68,Default,,0,0,0,,Мысалы, мен өз сыныбымдағы ең жақын қызбен➨
Dialogue: 0,0:15:54.68,0:15:57.19,Default,,0,0,0,,Егер мен суға батып бара жатсам➨
Dialogue: 0,0:15:57.19,0:15:59.19,Default,,0,0,0,,Сіз кімге көмектесесіз?
Dialogue: 0,0:15:59.19,0:16:01.46,Default,,0,0,0,,Ах...! (Ертеңгі жел) Сіз➨
Dialogue: 0,0:16:01.46,0:16:05.46,Default,,0,0,0,,Мен екі орындық ашық қызыл байдаркамен есіп келемін.
Dialogue: 0,0:16:05.46,0:16:08.63,Default,,0,0,0,,Бір адам байдаркадан ұстап тұруы керек...
Dialogue: 0,0:16:08.63,0:16:12.13,Default,,0,0,0,,Алайда суда қанішер акулалар бар➨
Dialogue: 0,0:16:12.13,0:16:14.47,Default,,0,0,0,,Пираньялар мен қолтырауындар бар делік!
Dialogue: 0,0:16:14.47,0:16:18.47,Default,,0,0,0,,Менің ондай жерге жүгіруге сенімім жоқ...
Dialogue: 0,0:16:18.47,0:16:22.31,Default,,0,0,0,,Мен болсам, ойланбастан көмектесер едім.
Dialogue: 0,0:16:22.31,0:16:26.31,Default,,0,0,0,,Себебі мен сыныптағы ең жақын досымнан жақсымын➨
Dialogue: 0,0:16:26.31,0:16:28.82,Default,,0,0,0,,Өйткені сен маған көбірек ұнайсың.
Dialogue: 0,0:16:28.82,0:16:30.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:30.82,0:16:36.16,Default,,0,0,0,,Егер бұл мойындау болса, мен тапқыр жағдайды қалаймын.
Dialogue: 0,0:16:36.16,0:16:40.16,Default,,0,0,0,,Сіз де таңдамайтыныңызға сенімдімін.
Dialogue: 0,0:16:40.16,0:16:44.33,Default,,0,0,0,,Мен жақсымын, сондықтан мен оларға бортқа мініңдер дедім.
Dialogue: 0,0:16:44.33,0:16:48.84,Default,,0,0,0,,Ең әдемі және дұрыс жауап екеніне сеніңіз.
Dialogue: 0,0:16:48.84,0:16:53.01,Default,,0,0,0,,Мүмкін емес. Тіпті мені пиранха тістеп алғым келмейді.
Dialogue: 0,0:16:53.01,0:16:57.01,Default,,0,0,0,,Сонымен, қызғылт саусақ, құлақша және ерін➨
Dialogue: 0,0:16:57.01,0:16:59.68,Default,,0,0,0,,Мен шағып жатқанда ойлаймын.
Dialogue: 0,0:16:59.68,0:17:04.09,Default,,0,0,0,,«Бұл Читосе Саку».
Dialogue: 0,0:17:11.63,0:17:17.30,Default,,0,0,0,,《Жолда келе жатқан фигура әлдеқашан бір үйге сіңіп кеткен➨
Dialogue: 0,0:17:17.30,0:17:21.30,Default,,0,0,0,,Сағат 22:00, тіпті көліктердің дыбысы да сирек.
Dialogue: 0,0:17:21.30,0:17:27.31,Default,,0,0,0,,Оның жартысы қазірдің өзінде арман, жартысы бір қадам ғана қалды.
Dialogue: 0,0:17:27.31,0:17:33.48,Default,,0,0,0,,Осы ауа қалталы сәттерде менде кенет бір нәрсе туралы ойланатын болдым.
Dialogue: 0,0:17:33.48,0:17:39.49,Default,,0,0,0,,Мен бұл қалада шынымен бармын ба?
Dialogue: 0,0:17:39.49,0:17:42.82,Default,,0,0,0,,Дүниенің бір түкпірінде ойдан шығарылғандай сезілетін➨
Dialogue: 0,0:17:42.82,0:17:47.03,Default,,0,0,0,,Сізге берілген рөлді жақсы ойнай аласыз ба?
Dialogue: 0,0:17:49.83,0:17:54.84,Default,,0,0,0,,《Кента Ямазаки-кун. қазір не ойлап отырсың?
Dialogue: 0,0:17:54.84,0:17:58.01,Default,,0,0,0,,Осы айға қарап отырсаңыз➨
Dialogue: 0,0:17:58.01,0:18:02.31,Default,,0,0,0,,Бұл мен қарап тұрған ай ба? 》
Dialogue: 0,0:18:07.11,0:18:11.52,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:18.46,0:18:21.30,Default,,0,0,0,,(сөйлеу)
Dialogue: 0,0:18:21.30,0:18:24.80,Default,,0,0,0,,Хитоз. ше? Нанасе.
Dialogue: 0,0:18:24.80,0:18:27.47,Default,,0,0,0,,Кездесуге шақыру? Ха.
Dialogue: 0,0:18:27.47,0:18:31.64,Default,,0,0,0,,Мұндай тосын шабуыл жаман емес, бірақ қазір басқа әңгіме.
Dialogue: 0,0:18:31.64,0:18:33.98,Default,,0,0,0,,Хитоза, сізде қиындық бар ма?
Dialogue: 0,0:18:33.98,0:18:36.64,Default,,0,0,0,,《Сіз байқадыңыз деп ойлаймын》
Dialogue: 0,0:18:36.64,0:18:39.65,Default,,0,0,0,,Менің сыныбымда мектепке барудан бас тартатын бала бар➨
Dialogue: 0,0:18:39.65,0:18:43.15,Default,,0,0,0,,Курасен мені мектепке келуге көндіруді өтінді.
Dialogue: 0,0:18:43.15,0:18:45.99,Default,,0,0,0,,Әйтеуір, мен сабақтан кейін барамын.
Dialogue: 0,0:18:45.99,0:18:49.49,Default,,0,0,0,,Қарсы болмасаңыз, араласқыңыз келе ме?
Dialogue: 0,0:18:49.49,0:18:52.99,Default,,0,0,0,,Хитозаның өзі соншалықты жақсы болмауы мүмкін.
Dialogue: 0,0:18:52.99,0:18:57.33,Default,,0,0,0,,《Нанасе айналасындағылардың оған қалай қарайтынын түсінеді➨
Dialogue: 0,0:18:57.33,0:19:01.44,Default,,0,0,0,,Тиісті бақылау, табиғи емес жетілдіру》
Dialogue: 0,0:19:01.44,0:19:05.27,Default,,0,0,0,,Санкю. Бірақ мен басқа біреуден сұрап жатырмын.
Dialogue: 0,0:19:05.27,0:19:07.44,Default,,0,0,0,,Сізге қоңырау шалып тұрған жоқ па?
Dialogue: 0,0:19:07.44,0:19:10.78,Default,,0,0,0,,Бірақ пайдалы болуы мүмкін жағдайды көрсеңіз, маған хабарлаңыз.
Dialogue: 0,0:19:10.78,0:19:15.58,Default,,0,0,0,,Мен өзім ұнататын адамдар үшін қолымнан келгеннің бәрін жасауға бейіммін.
Dialogue: 0,0:19:21.62,0:19:23.62,Default,,0,0,0,,Хмм... (аяқ дыбысы)
Dialogue: 0,0:19:33.13,0:19:36.97,Default,,0,0,0,,Кешіріңіз, күттіңіз бе? жоқ. Фукибе: Амансың ба?
Dialogue: 0,0:19:36.97,0:19:39.81,Default,,0,0,0,,Иә. Бұл өзін-өзі жаттықтыру күні болды.
Dialogue: 0,0:19:39.81,0:19:42.14,Default,,0,0,0,,Бірақ неге мен?
Dialogue: 0,0:19:42.14,0:19:45.48,Default,,0,0,0,,Адамдардың ұнатулары мен ұнатпаулары анық➨
Dialogue: 0,0:19:45.48,0:19:48.98,Default,,0,0,0,,Юзора қашықтықты жақсы біледі, солай ма?
Dialogue: 0,0:19:48.98,0:19:51.79,Default,,0,0,0,,Мен олай емес деп ойлаймын.
Dialogue: 0,0:19:53.82,0:19:55.82,Default,,0,0,0,,Себебі мен Кайтоның мамачариін қарызға алдым.
Dialogue: 0,0:19:55.82,0:19:58.49,Default,,0,0,0,,Е... Амансың ба.
Dialogue: 0,0:19:58.49,0:20:00.49,Default,,0,0,0,,Педалдардың салмағына қол тигізбеңіз.
Dialogue: 0,0:20:00.49,0:20:03.80,Default,,0,0,0,,Бұл соншалықты ауыр емес! Ммм.
Dialogue: 0,0:20:08.00,0:20:10.34,Default,,0,0,0,,Оны басып өту оңай емес пе?
Dialogue: 0,0:20:10.34,0:20:13.51,Default,,0,0,0,,Бұл юбка болса да жасай алмайсың.
Dialogue: 0,0:20:13.51,0:20:18.01,Default,,0,0,0,,Иә. Бірақ бұл қауіпті, сондықтан иығыңызды немесе беліңізді ұстаңыз.
Dialogue: 0,0:20:18.01,0:20:20.31,Default,,0,0,0,,Иә….
Dialogue: 0,0:20:22.35,0:20:25.85,Default,,0,0,0,,Қолыңызды лас шүберек сияқты пайдалануды тоқтата аласыз ба?
Dialogue: 0,0:20:25.85,0:20:33.03,Default,,0,0,0,,♬～
Dialogue: 0,0:20:33.03,0:20:35.03,Default,,0,0,0,,Артқа…. (Саку) А?
Dialogue: 0,0:20:35.03,0:20:37.70,Default,,0,0,0,,Саку-кунның арқасы.
Dialogue: 0,0:20:37.70,0:20:40.37,Default,,0,0,0,,Бұл мен ойлағаннан әлдеқайда үлкен.
Dialogue: 0,0:20:40.37,0:20:43.37,Default,,0,0,0,,Қатты және балаша.
Dialogue: 0,0:20:43.37,0:20:48.04,Default,,0,0,0,,Ол осылай көрінсе де, ол бастапқыда префектурадағы ең жақсы бейсболшылардың бірі болған.
Dialogue: 0,0:20:48.04,0:20:52.71,Default,,0,0,0,,Мен білемін. Өткен жылы жазғы демалыста ойын ойнадым➨
Dialogue: 0,0:20:52.71,0:20:55.88,Default,,0,0,0,,Мен Фукибе жаттығу кезінде сыныптан қарап отырдым.
Dialogue: 0,0:20:55.88,0:20:58.55,Default,,0,0,0,,Бұл қазіргідей дос болғанға дейін болды, солай ма?
Dialogue: 0,0:20:58.55,0:21:01.49,Default,,0,0,0,,Ол менің жасырын жанкүйерім болды ма?
Dialogue: 0,0:21:01.49,0:21:06.29,Default,,0,0,0,,Мен солай ма деп ойлаймын...
Dialogue: 0,0:21:11.83,0:21:15.17,Default,,0,0,0,,Саку-кун, сен бірдеңе ойлап тұрсың ба?
Dialogue: 0,0:21:15.17,0:21:18.67,Default,,0,0,0,,Хмм. Тежегішті кенеттен қашан басу керек?
Dialogue: 0,0:21:18.67,0:21:22.18,Default,,0,0,0,,Пуни Пуни дүрбелеңімен кездесудің сәті түсе ме деп ойлаймын.
Dialogue: 0,0:21:22.18,0:21:26.85,Default,,0,0,0,,Кешірім сұраймын деп каммингті тоқтатуым керек пе?
Dialogue: 0,0:21:26.85,0:21:30.18,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:21:30.18,0:21:34.19,Default,,0,0,0,,Жоқ, мен Ямадзаки-кун туралы айтып отырмын. Не істеуім керек?
Dialogue: 0,0:21:34.19,0:21:36.52,Default,,0,0,0,,Мен бұл туралы көп ойладым, бірақ➨
Dialogue: 0,0:21:36.52,0:21:40.86,Default,,0,0,0,,Мен бұл туралы сілтеусіз ойлаудың мағынасыз екенін түсіндім.
Dialogue: 0,0:21:40.86,0:21:43.03,Default,,0,0,0,,"Соққы кезінде жарылған" сияқты нәрсе.
Dialogue: 0,0:21:43.03,0:21:48.37,Default,,0,0,0,,«Оны сындырыңыз». Өтінемін бұзбаңызшы, жарай ма?
Dialogue: 0,0:21:48.37,0:21:50.54,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:21:50.54,0:21:52.54,Default,,0,0,0,,🔊 (Кентаның анасы) Иә...?
Dialogue: 0,0:21:52.54,0:21:55.21,Default,,0,0,0,,Сәлеметсіз бе! Қазір Кента-кунмен бір сыныпта➨
Dialogue: 0,0:21:55.21,0:21:57.21,Default,,0,0,0,,Менің атым Читосе Саку!
Dialogue: 0,0:21:57.21,0:22:00.48,Default,,0,0,0,,Мен баспаларды жеткізуге келдім! 🔊Күрсіну….
Dialogue: 0,0:22:00.48,0:22:03.48,Default,,0,0,0,,Танысқаныма қуаныштымын, менің атым Юку Учида.
Dialogue: 0,0:22:03.48,0:22:07.66,Default,,0,0,0,,Кента-кун былтырдан бері мектепке бармаған, сондықтан оның жағдайы қалай екен деп ойлаймын➨
Dialogue: 0,0:22:07.66,0:22:11.49,Default,,0,0,0,,Мен сіздің жағдайыңыз туралы біраз уайымдап тұрмын.
Dialogue: 0,0:22:11.49,0:22:16.00,Default,,0,0,0,,🔊Ой, жарайды... Ендеше әуре болудың қажеті жоқ... Сәл күте тұрыңыз.
Dialogue: 0,0:22:16.00,0:22:18.30,Default,,0,0,0,,Иә.
Dialogue: 0,0:22:20.84,0:22:24.51,Default,,0,0,0,,Кента-кун, анаңа айтпадың ба?
Dialogue: 0,0:22:24.51,0:22:30.18,Default,,0,0,0,,Мектепке келгің келмейтін себебі. Иә, ештеңе...
Dialogue: 0,0:22:30.18,0:22:34.01,Default,,0,0,0,,Қарсы болмасаңыз, сізбен біраз сөйлессем болады ма?
Dialogue: 0,0:22:34.01,0:22:37.69,Default,,0,0,0,,Бірақ... ол қыз қатты соғуы мүмкін.
Dialogue: 0,0:22:37.69,0:22:40.02,Default,,0,0,0,,Мен анамның қолынан келмейтініне сенімдімін➨
Dialogue: 0,0:22:40.02,0:22:43.19,Default,,0,0,0,,Менің ойымша, жоғары сынып оқушыларының арасында әңгіме бар.
Dialogue: 0,0:22:43.19,0:22:46.36,Default,,0,0,0,,Олай болса, мені бақылай аласыз ба?
Dialogue: 0,0:22:46.36,0:22:50.06,Default,,0,0,0,,Ах...! өтінемін.
Dialogue: 0,0:23:03.48,0:23:06.81,Default,,0,0,0,,Мен сізді тыңдаймын! не?
Dialogue: 0,0:23:06.81,0:23:10.82,Default,,0,0,0,,Иә! Читосе Саку 5➨ сынып төрағасы болды
Dialogue: 0,0:23:10.82,0:23:14.32,Default,,0,0,0,,Ямадаки-кун бір сыныпта оқитын. Әрқашан қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:23:14.32,0:23:19.49,Default,,0,0,0,,Хитоза... Саку? неге? Әлгі бейбақтан?
Dialogue: 0,0:23:19.49,0:23:23.33,Default,,0,0,0,,А... Сіз қалай ойлайсыз?
Dialogue: 0,0:23:23.33,0:23:29.34,Default,,0,0,0,,Танысқаныма қуаныштымын, Ямазаки-кун. Бұл менімен бір сыныпта оқитын Юку Учида.
Dialogue: 0,0:23:29.34,0:23:34.34,Default,,0,0,0,,Сізді таң қалдырғаны үшін кешіріңіз. Мен сені көптен бері сабаққа келмегеніңді естідім.
Dialogue: 0,0:23:34.34,0:23:38.68,Default,,0,0,0,,Хмм... Учида... ол Хитоза гаремінің бір бөлігі ме?
Dialogue: 0,0:23:38.68,0:23:41.68,Default,,0,0,0,,Ал ше...
Dialogue: 0,0:23:41.68,0:23:44.18,Default,,0,0,0,,Пікір қайшылықтары болса да➨
Dialogue: 0,0:23:44.18,0:23:46.85,Default,,0,0,0,,Мүмкін Читоза мен Учида сәйкес келеді.
Dialogue: 0,0:23:46.85,0:23:49.86,Default,,0,0,0,,Неге аздап сөйлеспейміз?
Dialogue: 0,0:23:49.86,0:23:53.19,Default,,0,0,0,,Менің ойымша, сіз сынып жетекшіңіз айтқандықтан құлықсыз келдіңіз.
Dialogue: 0,0:23:53.19,0:23:57.20,Default,,0,0,0,,Бұл байланысты емес, бірақ мен Ямазаки-кунмен сөйлескім келді.
Dialogue: 0,0:23:57.20,0:23:59.53,Default,,0,0,0,,Сізге жеңіл романдар мен аниме таныс па?
Dialogue: 0,0:23:59.53,0:24:03.14,Default,,0,0,0,,Шыққан янкья - отаку үндеуі.
Dialogue: 0,0:24:03.14,0:24:05.47,Default,,0,0,0,,Егер сізді шынымен қызықтырса, мен жеңіл романдар туралы айтайын➨
Dialogue: 0,0:24:05.47,0:24:07.47,Default,,0,0,0,,Сіз тіпті бір нәрсені білесіз бе?
Dialogue: 0,0:24:07.47,0:24:09.48,Default,,0,0,0,,『Шынайы емес адамға ғашық бола аламын ба? ».
Dialogue: 0,0:24:09.48,0:24:11.48,Default,,0,0,0,,``Мен отакумын және мені қыз қаншықтар нысанаға алып жатыр.''
Dialogue: 0,0:24:11.48,0:24:15.48,Default,,0,0,0,,``Мен Риа зарядын жою комитетіне кірсем де, менің жастық шағым ең төменгі деңгейде болды''.
Dialogue: 0,0:24:15.48,0:24:17.99,Default,,0,0,0,,``Егер мен, ең төменгі каста, басқа әлемде реинкарнациялансам➨
Dialogue: 0,0:24:17.99,0:24:19.99,Default,,0,0,0,,Гарем құру туралы.''
Dialogue: 0,0:24:19.99,0:24:22.82,Default,,0,0,0,,``Басқа әлемде менің бетім салқын болу үшін стандарт болып көрінеді.''
Dialogue: 0,0:24:22.82,0:24:25.99,Default,,0,0,0,,``Бір себептермен менің сыныбымдағы ең жақсы оқушы Хикья менің шәкіртім болды.''
Dialogue: 0,0:24:25.99,0:24:30.16,Default,,0,0,0,,``Менің өте әдемі ағам мені тітіркендіреді, өйткені мен құпия жігітпін!'' ”.
Dialogue: 0,0:24:30.16,0:24:32.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:32.17,0:24:34.50,Default,,0,0,0,,Кешіріңіз, менде ештеңе жоқ.
Dialogue: 0,0:24:34.50,0:24:38.01,Default,,0,0,0,,Ямадзаки-кун, мен де ол туралы көп білмеймін➨
Dialogue: 0,0:24:38.01,0:24:41.01,Default,,0,0,0,,Сіздің ұсыныстарыңыз бар ма?
Dialogue: 0,0:24:41.01,0:24:43.18,Default,,0,0,0,,Жоқ, сәл ғана...
Dialogue: 0,0:24:43.18,0:24:47.18,Default,,0,0,0,,Оны Учида мырза сияқты балаға оқу қызық емес деп ойлаймын.
Dialogue: 0,0:24:47.18,0:24:52.85,Default,,0,0,0,,Солай ма? Егер бұл менің інімнің ұлдарға арналған мангасы болса, мен оны да оқимын.
Dialogue: 0,0:24:52.85,0:24:55.19,Default,,0,0,0,,Кітап сөресі Мен оны көргім келеді.
Dialogue: 0,0:24:55.19,0:24:57.86,Default,,0,0,0,,Жоқ... жоқ, бөлме лас...
Dialogue: 0,0:24:57.86,0:25:01.30,Default,,0,0,0,,Ал, есіктен сөйлесейік, жарай ма?
Dialogue: 0,0:25:01.30,0:25:04.80,Default,,0,0,0,,Ян-кья тақырыбы мен түсінбедім.
Dialogue: 0,0:25:04.80,0:25:07.80,Default,,0,0,0,,Мен қарапайыммын.
Dialogue: 0,0:25:07.80,0:25:10.80,Default,,0,0,0,,Жоқ, ол жай ғана жарқырап тұрды.
Dialogue: 0,0:25:10.80,0:25:13.81,Default,,0,0,0,,Мүмкін бұл айналаның жарқырағанынан ба?
Dialogue: 0,0:25:13.81,0:25:19.81,Default,,0,0,0,,Ямадзаки-кун үлкен топпен жүруден гөрі өз уақытын бағалайтын адам ма?
Dialogue: 0,0:25:19.81,0:25:22.15,Default,,0,0,0,,Ал... солай шығар.
Dialogue: 0,0:25:22.15,0:25:25.49,Default,,0,0,0,,Тек осыған ғана құмар бола аласыз.
Dialogue: 0,0:25:25.49,0:25:29.16,Default,,0,0,0,,Ямадзаки-кун, Юку екеуің жақсы араласатындарыңа қуаныштымын.
Dialogue: 0,0:25:29.16,0:25:33.49,Default,,0,0,0,,Мен оны біраз уақытқа шешіп алайын ба? Неге сонша босаңсып жатырсың?
Dialogue: 0,0:25:33.49,0:25:36.33,Default,,0,0,0,,Өйткені мен Учида мырзамен кез келген уақытта сөйлесе аламын ба?
Dialogue: 0,0:25:36.33,0:25:40.17,Default,,0,0,0,,Жоқ, тым кеш. Мен олай айтқым келген жоқ...
Dialogue: 0,0:25:40.17,0:25:42.84,Default,,0,0,0,,Біз бір-бірімізді ұнатпаймыз!
Dialogue: 0,0:25:42.84,0:25:46.01,Default,,0,0,0,,Жарайды, мен бүгін үйге барамын.
Dialogue: 0,0:25:46.01,0:25:48.01,Default,,0,0,0,,Мен келесі аптада қайтамын.
Dialogue: 0,0:25:48.01,0:25:51.01,Default,,0,0,0,,Енді келме, бейбақ!
Dialogue: 0,0:25:54.18,0:25:56.35,Default,,0,0,0,,Қалай болды? Юку.
Dialogue: 0,0:25:56.35,0:25:59.35,Default,,0,0,0,,Сіз бір нәрседен қорқатындай сезіндіңіз бе?
Dialogue: 0,0:25:59.35,0:26:03.46,Default,,0,0,0,,Ол Саку-кунға қажетінен гөрі агрессивті болды.
Dialogue: 0,0:26:03.46,0:26:05.96,Default,,0,0,0,,Мен солай деп ойлаймын.
Dialogue: 0,0:26:05.96,0:26:08.63,Default,,0,0,0,,Саку-кун бірдеңені байқады ма?
Dialogue: 0,0:26:08.63,0:26:10.80,Default,,0,0,0,,Хмм….
Dialogue: 0,0:26:10.80,0:26:12.97,Default,,0,0,0,,Ямадзаки-кун, сен мені жек көресің.
Dialogue: 0,0:26:12.97,0:26:14.97,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:26:14.97,0:26:16.97,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:26:16.97,0:26:19.81,Default,,0,0,0,,Бірақ мен бұл сезімді түсінемін.
Dialogue: 0,0:26:19.81,0:26:23.81,Default,,0,0,0,,Юку-чан! ? (Юко) Жарайды, жарайды.
Dialogue: 0,0:26:23.81,0:26:26.81,Default,,0,0,0,,Сонда да Саку-кун салқын.
Dialogue: 0,0:26:26.81,0:26:29.98,Default,,0,0,0,,Әй, қашуға тырысқанда осыны қолданасың!
Dialogue: 0,0:26:29.98,0:26:31.99,Default,,0,0,0,,Хехе.
Dialogue: 0,0:26:31.99,0:26:35.82,Default,,0,0,0,,《Саку: Ямадзаки-кун барлығын қабылдамай қояды➨
Dialogue: 0,0:26:35.82,0:26:37.83,Default,,0,0,0,,Мен айтқан жоқпын...
Dialogue: 0,0:26:37.83,0:26:41.03,Default,,0,0,0,,Мен триггерді жіберіп алған шығармын...》
Dialogue: 0,0:26:49.00,0:26:54.68,Default,,0,0,0,,《Саку: Батып бара жатқан күн жіңішке толқынды бұлттарды бояйды.
Dialogue: 0,0:26:54.68,0:26:57.34,Default,,0,0,0,,Апельсиннен қызғылт сарыға дейін➨
Dialogue: 0,0:26:57.34,0:26:59.85,Default,,0,0,0,,Мандарин түсінен өрік түсіне дейін➨
Dialogue: 0,0:26:59.85,0:27:03.45,Default,,0,0,0,,Өріктен гентианға және лазураға дейін➨
Dialogue: 0,0:27:03.45,0:27:08.46,Default,,0,0,0,,Жалған көрінетін әдемі градацияларды сал.
Dialogue: 0,0:27:08.46,0:27:11.46,Default,,0,0,0,,Құшақтасып тұрған екі адамның сұлбасы ➨
Dialogue: 0,0:27:11.46,0:27:15.96,Default,,0,0,0,,Бұл шынымен жастық шағымның бір парағы сияқты болды.
Dialogue: 0,0:27:29.48,0:27:32.81,Default,,0,0,0,,Баяу Баяу! (велосипед қоңырауының дыбысы)
Dialogue: 0,0:27:32.81,0:27:34.82,Default,,0,0,0,,《Саку: Содан бері бір апта өтті.
Dialogue: 0,0:27:34.82,0:27:39.15,Default,,0,0,0,,Ойланып, екінші рет Юкодан сұрадым.
Dialogue: 0,0:27:39.15,0:27:41.15,Default,,0,0,0,,Шын жүректен әңгімелесу➨
Dialogue: 0,0:27:41.15,0:27:43.16,Default,,0,0,0,,Ол шын мәнінде не ойласа, соны айтады➨
Dialogue: 0,0:27:43.16,0:27:45.83,Default,,0,0,0,,Мен Юко қуатын алғым келді》
Dialogue: 0,0:27:45.83,0:27:48.33,Default,,0,0,0,,Өте жақсы сезім, Саку!
Dialogue: 0,0:27:48.33,0:27:50.50,Default,,0,0,0,,Қалай мінсең, шалбарымды көресің.
Dialogue: 0,0:27:50.50,0:27:54.00,Default,,0,0,0,,Міне, өтіп бара жатқан бейтаныс адам мені көрді➨
Dialogue: 0,0:27:54.00,0:27:56.00,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:27:56.00,0:27:59.84,Default,,0,0,0,,Енді мен саған қарап көрейін бе?
Dialogue: 0,0:27:59.84,0:28:02.61,Default,,0,0,0,,Саку ерекше, сондықтан жоқ!
Dialogue: 0,0:28:02.61,0:28:05.61,Default,,0,0,0,,Бұл әдетте ерекше біреуге көрсететін нәрсе емес пе?
Dialogue: 0,0:28:05.61,0:28:09.95,Default,,0,0,0,,Бәлкім, бір күні ерекше оқиға болар!
Dialogue: 0,0:28:09.95,0:28:11.95,Default,,0,0,0,,Иә.
Dialogue: 0,0:28:11.95,0:28:20.29,Default,,0,0,0,,♬～
Dialogue: 0,0:28:20.29,0:28:23.13,Default,,0,0,0,,Хэхехе!
Dialogue: 0,0:28:23.13,0:28:27.13,Default,,0,0,0,,Өткен жылмен салыстырғанда онша тер иісі жоқ.
Dialogue: 0,0:28:27.13,0:28:31.31,Default,,0,0,0,,Бұл үйге келу клубы. Міне бітті.
Dialogue: 0,0:28:31.31,0:28:35.64,Default,,0,0,0,,Сақу тердің иісін жек көрмеймін.
Dialogue: 0,0:28:35.64,0:28:40.31,Default,,0,0,0,,Сонымен, сіздің ойыңыз бар ма? Мүлдем.
Dialogue: 0,0:28:40.31,0:28:44.82,Default,,0,0,0,,Бірақ Саку осында болғандықтан, оның түбінде шешілетіні сөзсіз.
Dialogue: 0,0:28:44.82,0:28:47.49,Default,,0,0,0,,Ол менің кейіпкерім.
Dialogue: 0,0:28:47.49,0:28:53.16,Default,,0,0,0,,Әзірге Юко Ямадзаки-кунмен қалыпты сөйлесе алатын болса, жақсы болады.
Dialogue: 0,0:28:53.16,0:28:55.83,Default,,0,0,0,,Қандай жағдай болмасын, мен оны жасырамын.
Dialogue: 0,0:28:55.83,0:28:58.83,Default,,0,0,0,,Ка~Шикомари~! Апыр-ай! ? Эй, Юко-сан! ?
Dialogue: 0,0:28:58.83,0:29:02.60,Default,,0,0,0,,《Сәку: Батыр болудың шарттары қандай?
Dialogue: 0,0:29:02.60,0:29:06.44,Default,,0,0,0,,Мен бұл кез келген уақытта шындық екеніне сенімдімін➨
Dialogue: 0,0:29:06.44,0:29:09.24,Default,,0,0,0,,Батыр болуды тоқтатпа》
Dialogue: 0,0:29:11.78,0:29:16.28,Default,,0,0,0,,Ямадаки-кун, бұл Хитоза.
Dialogue: 0,0:29:16.28,0:29:19.79,Default,,0,0,0,,Мен саған мені кіргізбе дедім, өйткені дос емеспіз.
Dialogue: 0,0:29:19.79,0:29:22.79,Default,,0,0,0,,Анаң да уайымдап тұр.
Dialogue: 0,0:29:22.79,0:29:24.96,Default,,0,0,0,,Учида мырза да сонда ма? Жоқ ➨
Dialogue: 0,0:29:24.96,0:29:26.96,Default,,0,0,0,,Юку клуб жұмысына байланысты келе алмады.
Dialogue: 0,0:29:26.96,0:29:30.80,Default,,0,0,0,,Күтілгендей. Мен мұнда сіздің қорыңызды көтеру үшін келдім➨
Dialogue: 0,0:29:30.80,0:29:33.30,Default,,0,0,0,,Мазасыз болып көрінді, мен оны бірден лақтырып жібердім.
Dialogue: 0,0:29:33.30,0:29:35.30,Default,,0,0,0,,Юку ондай жігіт емес.
Dialogue: 0,0:29:35.30,0:29:38.81,Default,,0,0,0,,Мен де Ямадзаки-кунға қатты көңіл бөлдім.
Dialogue: 0,0:29:38.81,0:29:42.31,Default,,0,0,0,,Бүгін маған басқа қыз келді.
Dialogue: 0,0:29:42.31,0:29:45.81,Default,,0,0,0,,Сәлеметсіз бе! Хийраги Ю көлінде!
Dialogue: 0,0:29:45.81,0:29:48.15,Default,,0,0,0,,Сіз мектепке келмедім дейсіз бе?
Dialogue: 0,0:29:48.15,0:29:50.15,Default,,0,0,0,,Бұл қиын. Не болды?
Dialogue: 0,0:29:50.15,0:29:53.32,Default,,0,0,0,,Сәлем...Хираги - бұл Хираги! ?
Dialogue: 0,0:29:53.32,0:29:55.66,Default,,0,0,0,,Ол Читоза гаремінің жоғарғы мүшесі емес пе?
Dialogue: 0,0:29:55.66,0:29:58.66,Default,,0,0,0,,Ондай қаншықпен не істегің келеді?
Dialogue: 0,0:29:58.66,0:30:03.16,Default,,0,0,0,,Bicchi дегеніміз не? Менің ойымша, бұл Шигару Онна деп аталады.
Dialogue: 0,0:30:03.16,0:30:07.33,Default,,0,0,0,,Өте жиіркенішті! Ей, қаншықтар қорқынышты емес пе?
Dialogue: 0,0:30:07.33,0:30:09.34,Default,,0,0,0,,Саку: Мен бәріне дайынмын.
Dialogue: 0,0:30:09.34,0:30:11.67,Default,,0,0,0,,Хмф, сіз де Читозадансыз➨
Dialogue: 0,0:30:11.67,0:30:13.67,Default,,0,0,0,,Сен мені қуантқың келгендіктен келдің.
Dialogue: 0,0:30:13.67,0:30:16.01,Default,,0,0,0,,Бұл қалыпты жағдай, солай емес пе?
Dialogue: 0,0:30:16.01,0:30:18.85,Default,,0,0,0,,Саку қиналса, көмектескісі келеді.
Dialogue: 0,0:30:18.85,0:30:22.02,Default,,0,0,0,,Қараңыз. Жағымсыз адамдарға мейірімді бола білгім келеді➨
Dialogue: 0,0:30:22.02,0:30:24.18,Default,,0,0,0,,Сіз жай ғана сүйікті қарсыласыңызды шақырып жатырсыз.
Dialogue: 0,0:30:24.18,0:30:28.02,Default,,0,0,0,,Жақындарыңыздың алдында жақсы жақтарын көрсеткіңіз келетіні қалыпты жағдай, солай емес пе?
Dialogue: 0,0:30:28.02,0:30:30.86,Default,,0,0,0,,Болжам ат ретінде пайдаланған адамдай бол!
Dialogue: 0,0:30:30.86,0:30:35.03,Default,,0,0,0,,Маған мейірімді бол, егер мен саған ашсам, баспалдақтан түсетініңе сенімдімін!
Dialogue: 0,0:30:35.03,0:30:37.20,Default,,0,0,0,,Бәрібір кейін күлесің!
Dialogue: 0,0:30:37.20,0:30:42.04,Default,,0,0,0,,Интроверттер тез түсініп, қызығушылық танытады!
Dialogue: 0,0:30:42.04,0:30:45.37,Default,,0,0,0,,Жарайды, мүмкін Ямазаки-кун➨
Dialogue: 0,0:30:45.37,0:30:50.54,Default,,0,0,0,,Сізге мейірімділік танытқан қызды мойындап, сәтсіздікке ұшырадыңыз ба?
Dialogue: 0,0:30:50.54,0:30:54.38,Default,,0,0,0,,Ха! Әй... сен де жалғыз адам емессің!
Dialogue: 0,0:30:54.38,0:30:57.55,Default,,0,0,0,,Ол адам Учида-сан және басқа да көптеген қыздар➨
Dialogue: 0,0:30:57.55,0:30:59.55,Default,,0,0,0,,Сіз мейірімдісіз.
Dialogue: 0,0:30:59.55,0:31:02.66,Default,,0,0,0,,Сақудың бәріне мейірімді екенін білемін.
Dialogue: 0,0:31:02.66,0:31:05.16,Default,,0,0,0,,Себебі мені осындай нәрсе қызықтырды➨
Dialogue: 0,0:31:05.16,0:31:07.66,Default,,0,0,0,,Бірінші болу үшін бар күшіңізді салыңыз.
Dialogue: 0,0:31:07.66,0:31:12.50,Default,,0,0,0,,Жарайды, басқа қыз менің сүйіктім болып кетсе, мен мұңаяр едім. Бірақ бұл➨
Dialogue: 0,0:31:12.50,0:31:17.67,Default,,0,0,0,,Сакудың таңдауына менің жарамсыздығым емес пе?
Dialogue: 0,0:31:17.67,0:31:23.01,Default,,0,0,0,,Маған мейірімді болғаны үшін Сақудың кінәсі жоқ деп ойлаймын.
Dialogue: 0,0:31:23.01,0:31:25.01,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:31:25.01,0:31:28.01,Default,,0,0,0,,Рахмет. Төменде шай ішіңіз.
Dialogue: 0,0:31:28.01,0:31:32.19,Default,,0,0,0,,Қалғанын істеймін. Ка~Шикомари~!
Dialogue: 0,0:31:32.19,0:31:35.36,Default,,0,0,0,,(Кешкі көлде алыстап бара жатқан аяқ дыбысы)
Dialogue: 0,0:31:35.36,0:31:39.19,Default,,0,0,0,,Мен жағдайды түсінемін. Мен сізге көмектесе аламын деп ойлаймын.
Dialogue: 0,0:31:39.19,0:31:41.70,Default,,0,0,0,,Жоғарыдан қарау Бұл шынымен тітіркендіргіш.
Dialogue: 0,0:31:41.70,0:31:43.70,Default,,0,0,0,,Әзірше аша аласыз ба?
Dialogue: 0,0:31:43.70,0:31:47.03,Default,,0,0,0,,Маған ұнамайды. (Саку) Шай ішейік➨
Dialogue: 0,0:31:47.03,0:31:49.70,Default,,0,0,0,,Юконың Е кубогына қарап отырып.
Dialogue: 0,0:31:49.70,0:31:52.21,Default,,0,0,0,,Ақымақ болма. Оны ашпа.
Dialogue: 0,0:31:52.21,0:31:54.88,Default,,0,0,0,,Қалай болғанда да? Не болса да?
Dialogue: 0,0:31:54.88,0:31:56.88,Default,,0,0,0,,Сіз оны аша алмайсыз дейсіз бе!
Dialogue: 0,0:31:56.88,0:32:00.15,Default,,0,0,0,,Тез үйге қайт, бейбақ!
Dialogue: 0,0:32:00.15,0:32:03.65,Default,,0,0,0,,Түсіндім... Басқа амалым жоқ.
Dialogue: 0,0:32:10.66,0:32:15.50,Default,,0,0,0,,Негізі мен де сол жаққа барғым келген...
Dialogue: 0,0:32:15.50,0:32:17.66,Default,,0,0,0,,Менің ойымша, бұл жақсы шығар!
Dialogue: 0,0:32:17.66,0:32:19.83,Default,,0,0,0,,Мен солай деп үміттенемін. Мама➨
Dialogue: 0,0:32:19.83,0:32:22.34,Default,,0,0,0,,Кешіріңіз, бірақ...
Dialogue: 0,0:32:22.34,0:32:24.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:38.69,0:32:40.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:40.69,0:32:43.19,Default,,0,0,0,,Үшінші жарық Chitose-kun!
Dialogue: 0,0:32:43.19,0:32:45.89,Default,,0,0,0,,Бірыңғай сан... 9!
Dialogue: 0,0:32:48.53,0:32:52.70,Default,,0,0,0,,Уау! ?
Dialogue: 0,0:32:52.70,0:33:02.81,Default,,0,0,0,,♬～
Dialogue: 0,0:33:02.81,0:33:07.31,Default,,0,0,0,,Иә! аа….
Dialogue: 0,0:33:07.31,0:33:12.82,Default,,0,0,0,,Енді өзара түсіністікті бастайық.
Dialogue: 0,0:33:14.32,0:33:20.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory