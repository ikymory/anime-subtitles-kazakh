Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:04.67,Default,,0,0,0,,Иә! Көп нәрсе болып жатыр, Кента-цчи!
Dialogue: 0,0:00:04.67,0:00:07.00,Default,,0,0,0,,《Саку: Кента бір аптада 2 кг арықтады.
Dialogue: 0,0:00:07.00,0:00:10.17,Default,,0,0,0,,Әрі қарай барлығын жоғарыдан төменге қарай теңестірейік➨
Dialogue: 0,0:00:10.17,0:00:12.84,Default,,0,0,0,,Біз Эльпаға келдік》
Dialogue: 0,0:00:12.84,0:00:15.01,Default,,0,0,0,,Хмм, сәл артық➨
Dialogue: 0,0:00:15.01,0:00:18.01,Default,,0,0,0,,Жаман емес. Ужас!
Dialogue: 0,0:02:04.49,0:02:06.66,Default,,0,0,0,,А? (Юко) Иә!
Dialogue: 0,0:02:06.66,0:02:09.66,Default,,0,0,0,,Бұл дәл Kentacchi бейнесі сияқты! Эй➨
Dialogue: 0,0:02:09.66,0:02:12.16,Default,,0,0,0,,Неге тоқтамайсың? иә?
Dialogue: 0,0:02:12.16,0:02:15.66,Default,,0,0,0,,Достарыңызбен сол жерде кездесесіз, солай ма?
Dialogue: 0,0:02:15.66,0:02:17.83,Default,,0,0,0,,Біз қашан кездесеміз?
Dialogue: 0,0:02:17.83,0:02:21.14,Default,,0,0,0,,Екі аптадан кейін болады. бірақ….
Dialogue: 0,0:02:23.17,0:02:25.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:27.34,0:02:29.34,Default,,0,0,0,,Мұны істеу қиын.
Dialogue: 0,0:02:29.34,0:02:32.68,Default,,0,0,0,,Мен Kenta-cchi-ді түсінбеймін➨
Dialogue: 0,0:02:32.68,0:02:34.68,Default,,0,0,0,,Сіз не істегіңіз келеді? Жақсы….
Dialogue: 0,0:02:34.68,0:02:37.19,Default,,0,0,0,,«Сіз өзгердіңіз», тіпті сәл болса да➨
Dialogue: 0,0:02:37.19,0:02:39.69,Default,,0,0,0,,Ойланып қарасаңыз. Не?
Dialogue: 0,0:02:39.69,0:02:42.52,Default,,0,0,0,,Кешіріңіз! Ах!
Dialogue: 0,0:02:42.52,0:02:46.03,Default,,0,0,0,,А...? Не... не?
Dialogue: 0,0:02:46.03,0:02:50.37,Default,,0,0,0,,Жарайды. Жарайды. Алақай! Күлімсіреп күліңіз!
Dialogue: 0,0:02:50.37,0:02:53.04,Default,,0,0,0,,Уф…. (ысырма дыбысы)
Dialogue: 0,0:02:53.04,0:02:55.37,Default,,0,0,0,,Қарашы, Кента-цчи!
Dialogue: 0,0:02:55.37,0:03:00.14,Default,,0,0,0,,А... бұл... шынымен... мен бе?
Dialogue: 0,0:03:00.14,0:03:02.48,Default,,0,0,0,,Жақын топ сияқты сезіледі!
Dialogue: 0,0:03:02.48,0:03:06.48,Default,,0,0,0,,Өзіңіздің әлсіз қарым-қатынас дағдыларыңызды сынап, диетаңызды ұстаныңыз➨
Dialogue: 0,0:03:06.48,0:03:08.98,Default,,0,0,0,,Оның шаш үлгісі мен киімі де өзгертілген.
Dialogue: 0,0:03:08.98,0:03:13.32,Default,,0,0,0,,Кента қанша алға жүрсе де, жақсы ілгерілеуде.
Dialogue: 0,0:03:13.32,0:03:16.49,Default,,0,0,0,,Сонымен... бұл не?
Dialogue: 0,0:03:16.49,0:03:19.10,Default,,0,0,0,,Маңыздысы «ештеңеге қарамастан өзгеру»➨
Dialogue: 0,0:03:19.10,0:03:23.67,Default,,0,0,0,,Шешімділік туын ұстап, оны жүрегіңнің ортасына шаншып ал➨
Dialogue: 0,0:03:23.67,0:03:27.50,Default,,0,0,0,,Оны ешқашан жібермеңіз.
Dialogue: 0,0:03:27.50,0:03:31.34,Default,,0,0,0,,Келесі екі аптада мен өлетіндей жүгіруді жалғастырамын.
Dialogue: 0,0:03:31.34,0:03:35.84,Default,,0,0,0,,Құдайдың, Юконың және барлығының ынтымақтастығы зая кетпесін.
Dialogue: 0,0:03:35.84,0:03:40.85,Default,,0,0,0,,Өйткені... ол менің досым...
Dialogue: 0,0:03:40.85,0:03:44.02,Default,,0,0,0,,Айтар болсаң, абыроймен айт, Жиренішті.
Dialogue: 0,0:03:44.02,0:03:49.02,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:03:49.02,0:03:51.69,Default,,0,0,0,,《Саку: Өзгергісі келетін және шынымен өзгергісі келетін адамдар➨
Dialogue: 0,0:03:51.69,0:03:53.70,Default,,0,0,0,,Онша көп емес.
Dialogue: 0,0:03:53.70,0:03:56.03,Default,,0,0,0,,Бір күні осы күндерді еске алсам➨
Dialogue: 0,0:03:56.03,0:04:00.54,Default,,0,0,0,,Сіз өзіңізді мақтай аласыз деп үміттенемін.
Dialogue: 0,0:04:04.31,0:04:07.48,Default,,0,0,0,,Фува…. (Инаба) Неге маған ұқсайсың➨
Dialogue: 0,0:04:07.48,0:04:10.15,Default,,0,0,0,,Сіз Читозамен және басқалармен араласып жатырсыз ба? Ха! ?
Dialogue: 0,0:04:10.15,0:04:13.48,Default,,0,0,0,,Жоқ, Құдай Иванами мырзадан мұны сұрады.
Dialogue: 0,0:04:13.48,0:04:16.49,Default,,0,0,0,,Хитозе-кун Құдай ма? Бұл күлкілі.
Dialogue: 0,0:04:16.49,0:04:19.65,Default,,0,0,0,,Жарайды, егер сіз бірден көп сөйлесеңіз➨
Dialogue: 0,0:04:19.65,0:04:21.99,Default,,0,0,0,,Ямадзаки-кун да абдырап қалады.
Dialogue: 0,0:04:21.99,0:04:24.99,Default,,0,0,0,,Учида, аузыңды жауып тұра алмайсың ба?
Dialogue: 0,0:04:24.99,0:04:29.50,Default,,0,0,0,,Менің айтайын дегенім, сіз Читосе-кунның серігі үшін өте қарапайым адамсыз.
Dialogue: 0,0:04:29.50,0:04:32.50,Default,,0,0,0,,Ахаха... Мен мұны білемін.
Dialogue: 0,0:04:32.50,0:04:37.17,Default,,0,0,0,,Жоқ... жоқ, менің көзқарасым бойынша, Учида-сан да шынымен жарқырап тұр.
Dialogue: 0,0:04:37.17,0:04:40.51,Default,,0,0,0,,Сіз Учидаға ғашық болғаныңыз үшін Хитозаға жақындайсыз ба?
Dialogue: 0,0:04:40.51,0:04:42.51,Default,,0,0,0,,Дұрыс...\NЖағдай
Dialogue: 0,0:04:42.51,0:04:46.68,Default,,0,0,0,,. Өтінемін маған көмектесіңіз. (Юзуки/Казуки) Иә.
Dialogue: 0,0:04:46.68,0:04:49.68,Default,,0,0,0,,《Мүлдем емес. Кента бұл➨
Dialogue: 0,0:04:49.68,0:04:52.85,Default,,0,0,0,,Ақыры алға қарай жүре бастасам да.
Dialogue: 0,0:04:52.85,0:04:56.02,Default,,0,0,0,,О! (Барлығы) Ах!
Dialogue: 0,0:04:56.02,0:04:59.69,Default,,0,0,0,,Хитосе, сен неге соңғы кезде бұл жігітпен араласып жүрсің?
Dialogue: 0,0:04:59.69,0:05:03.30,Default,,0,0,0,,Хмм? Ум...?
Dialogue: 0,0:05:03.30,0:05:07.14,Default,,0,0,0,,Мұны жасамаңыз. Мен оны префектуралық университеттің финалында жеңдім.
Dialogue: 0,0:05:07.14,0:05:09.81,Default,,0,0,0,,Бұл күн сәулесіндегі Аджуму Уемура.
Dialogue: 0,0:05:09.81,0:05:13.64,Default,,0,0,0,,Кіші мектепті бітіргеннен кейін ол бейсболдан оңай бас тартты.
Dialogue: 0,0:05:13.64,0:05:16.14,Default,,0,0,0,,Аджуму да бейсбол клубының мүшесі емес.
Dialogue: 0,0:05:16.14,0:05:19.15,Default,,0,0,0,,Хмф... Бұл мені ақымақ етіп көрсетті.
Dialogue: 0,0:05:19.15,0:05:21.32,Default,,0,0,0,,Одан гөрі мен солаймын➨
Dialogue: 0,0:05:21.32,0:05:23.49,Default,,0,0,0,,Мен сүйкімді қыздың атын білемін.
Dialogue: 0,0:05:23.49,0:05:27.32,Default,,0,0,0,,Назуна Аясе. Жарайды, мен бақыттымын.
Dialogue: 0,0:05:27.32,0:05:31.16,Default,,0,0,0,,Мизушино-кун да, Читосе-кун да мұндай қарапайым балаларға қарағанда жақсы➨
Dialogue: 0,0:05:31.16,0:05:33.16,Default,,0,0,0,,Екеуміз бірге отырсақ екен.
Dialogue: 0,0:05:33.16,0:05:37.00,Default,,0,0,0,,J… қарапайым. Өйткені, бұл атлетикалық клуб➨
Dialogue: 0,0:05:37.00,0:05:39.67,Default,,0,0,0,,Әйелдік қасиеті төмендей ме?
Dialogue: 0,0:05:39.67,0:05:43.51,Default,,0,0,0,,Мм! Жоқ, мен сен туралы айтып тұрғаным жоқ.
Dialogue: 0,0:05:43.51,0:05:45.51,Default,,0,0,0,,Сонымен? (Кента) Ах!
Dialogue: 0,0:05:45.51,0:05:49.18,Default,,0,0,0,,Неге бұл жігіт? Бұл тек дос болғандықтан.
Dialogue: 0,0:05:49.18,0:05:52.51,Default,,0,0,0,,Демалыс күні Юко екеуміз Эльпа кездесуіне бардық.
Dialogue: 0,0:05:52.51,0:05:55.68,Default,,0,0,0,,Маған тынығып берші... Сонша надансың ба?
Dialogue: 0,0:05:55.68,0:05:57.69,Default,,0,0,0,,Жоқ, мен уақытша...
Dialogue: 0,0:05:57.69,0:06:02.19,Default,,0,0,0,,Өкінішке орай, бұл Цуру сияқты. Сіз кіммен айналысатыныңызды шешесіз.
Dialogue: 0,0:06:05.13,0:06:07.96,Default,,0,0,0,,Жарайды, ондай шу шығаруды доғарайық.
Dialogue: 0,0:06:07.96,0:06:12.47,Default,,0,0,0,,Өкінішке орай, сен сияқты ешқашан берілмейтіндерді ұнатпаймын.
Dialogue: 0,0:06:12.47,0:06:14.47,Default,,0,0,0,,Сәлем. Ах!
Dialogue: 0,0:06:14.47,0:06:17.31,Default,,0,0,0,,Хитозды қажетсіз қиындықтардан өткізбеңіз.
Dialogue: 0,0:06:17.31,0:06:19.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:23.14,0:06:27.15,Default,,0,0,0,,《Мүлдем... Жақсы жігіт пе, жаман ба?➨
Dialogue: 0,0:06:27.15,0:06:29.85,Default,,0,0,0,,Мен оны шынымен түсінбеймін, бұл теріс жол》
Dialogue: 0,0:06:33.66,0:06:38.99,Default,,0,0,0,,Тауға шыққан күн сүйген адамның бейнесі менде дәл осындай еді...
Dialogue: 0,0:06:38.99,0:06:41.66,Default,,0,0,0,,Мұндай жағдайда не істеуім керек?
Dialogue: 0,0:06:41.66,0:06:44.00,Default,,0,0,0,,Онымен айналыспаған дұрыс.
Dialogue: 0,0:06:44.00,0:06:49.17,Default,,0,0,0,,Басқалар сіз туралы не ойлайтынын емес, өзіңізді мақтан ете аласыз ба.
Dialogue: 0,0:06:49.17,0:06:53.34,Default,,0,0,0,,Егер сіз өз өміріңізді басшылыққа ала отырып өмір сүрсеңіз, сіз басқалардың сөздеріне соншалықты қуанбайсыз немесе мұңаймайсыз.
Dialogue: 0,0:06:53.34,0:06:57.85,Default,,0,0,0,,Сіз өзіңізді мақтан етесіз бе?
Dialogue: 0,0:07:03.29,0:07:05.95,Default,,0,0,0,,⸨Аа...⸩
Dialogue: 0,0:07:05.95,0:07:10.29,Default,,0,0,0,,《Егер мен Читосе Сакудың идеалды бейнесін қорғау үшін қолымды созсам➨
Dialogue: 0,0:07:10.29,0:07:14.80,Default,,0,0,0,,Сіз ең болмағанда нәтижелер үшін жауапкершілікті алуыңыз керек.
Dialogue: 0,0:07:14.80,0:07:17.30,Default,,0,0,0,,Алдағы шешуші шайқас күні болса ше➨
Dialogue: 0,0:07:17.30,0:07:21.64,Default,,0,0,0,,Егер Кентаның жүрегіне сондай жара болса, орнынан тұра алмас еді...》
Dialogue: 0,0:07:21.64,0:07:24.14,Default,,0,0,0,,Ой….
Dialogue: 0,0:07:26.64,0:07:30.98,Default,,0,0,0,,Иә! Уақытыңыз болса, менімен бірге болыңыз.
Dialogue: 0,0:07:30.98,0:07:34.78,Default,,0,0,0,,Эй… Эй….
Dialogue: 0,0:07:37.32,0:07:39.82,Default,,0,0,0,,Хмм….
Dialogue: 0,0:07:39.82,0:07:43.49,Default,,0,0,0,,Бұл өте жұмсақ.
Dialogue: 0,0:07:43.49,0:07:46.33,Default,,0,0,0,,Өйткені бұл негіздердің негізі.
Dialogue: 0,0:07:46.33,0:07:50.00,Default,,0,0,0,,Неліктен дәл қазір қиын көріндіңіз?
Dialogue: 0,0:07:50.00,0:07:52.50,Default,,0,0,0,,Сондықтан мені көңіл көтеруге шақырдың ба?
Dialogue: 0,0:07:52.50,0:07:54.84,Default,,0,0,0,,Йотто. Мүмкін емес.
Dialogue: 0,0:07:54.84,0:07:58.51,Default,,0,0,0,,Мен бірге жаттығатын адам болған кезде қатты қуанатын адаммын.
Dialogue: 0,0:07:58.51,0:08:00.78,Default,,0,0,0,,Қош бол...
Dialogue: 0,0:08:00.78,0:08:04.45,Default,,0,0,0,,Мысалы, ұпайлар квотасы белгіленген матчта➨
Dialogue: 0,0:08:04.45,0:08:06.61,Default,,0,0,0,,Нәтижеге қол жеткізбей, ұтылып қалсаңыз ➨
Dialogue: 0,0:08:06.61,0:08:09.45,Default,,0,0,0,,Күн туралы не істейсің? Итататата...!
Dialogue: 0,0:08:09.45,0:08:12.29,Default,,0,0,0,,Нәтиже бермеу қабілетінің жоқтығынан.
Dialogue: 0,0:08:12.29,0:08:15.96,Default,,0,0,0,,Тек кешірім сұрап, көбірек тырысу керек.
Dialogue: 0,0:08:15.96,0:08:19.96,Default,,0,0,0,,Хитозе бейсболды неге тастады?
Dialogue: 0,0:08:19.96,0:08:22.30,Default,,0,0,0,,Мен монахты жек көрдім.
Dialogue: 0,0:08:22.30,0:08:25.13,Default,,0,0,0,,А, сен алдамақшысың.
Dialogue: 0,0:08:25.13,0:08:28.97,Default,,0,0,0,,Е/Ж...
Dialogue: 0,0:08:28.97,0:08:31.14,Default,,0,0,0,,Эй… Эй….
Dialogue: 0,0:08:31.14,0:08:35.48,Default,,0,0,0,,Бұл деңгейден бас тартуға жеткілікті жаман ойын болған жоқ.
Dialogue: 0,0:08:35.48,0:08:37.48,Default,,0,0,0,,Өріс басқа болса да айта аласыз.
Dialogue: 0,0:08:37.48,0:08:40.15,Default,,0,0,0,,Бейсболға қанша ақша жұмсадыңыз?
Dialogue: 0,0:08:40.15,0:08:43.15,Default,,0,0,0,,Міне, солай шығар.
Dialogue: 0,0:08:43.15,0:08:45.49,Default,,0,0,0,,Хмм….
Dialogue: 0,0:08:45.49,0:08:48.49,Default,,0,0,0,,(Дриблинг дыбысы)
Dialogue: 0,0:08:51.83,0:08:54.16,Default,,0,0,0,,Ең жақсы 10 ойында жеңілген жақсы➨
Dialogue: 0,0:08:54.16,0:08:57.00,Default,,0,0,0,,Басқа адамның кез келген сұрағына жауап беруге қалай болады?
Dialogue: 0,0:08:57.00,0:08:59.83,Default,,0,0,0,,Нені естігіңіз келеді? Бүгінге➨
Dialogue: 0,0:08:59.83,0:09:02.54,Default,,0,0,0,,Менің ертерек депрессияға түскен себебім жақсы.
Dialogue: 0,0:09:05.11,0:09:08.94,Default,,0,0,0,,Мен жеңсем, сен маған тентек сұрақтар қоясың, солай ма?
Dialogue: 0,0:09:08.94,0:09:11.61,Default,,0,0,0,,Сіз дайын болған кезде, дүкеннен ыстық тағамдар алыңыз!
Dialogue: 0,0:09:11.61,0:09:14.95,Default,,0,0,0,,Жарайды, кез келген уақытта қош келдіңіз!
Dialogue: 0,0:09:14.95,0:09:20.79,Default,,0,0,0,,Ха ха ха ха... иә... Сатып алдым.
Dialogue: 0,0:09:20.79,0:09:23.79,Default,,0,0,0,,Бұл баяу. Бұл жын ба?
Dialogue: 0,0:09:23.79,0:09:27.13,Default,,0,0,0,,Бар күшіммен жарысқан соң, мен дүкенге қарай жүгірдім.
Dialogue: 0,0:09:27.13,0:09:30.47,Default,,0,0,0,,Негізгі тақырып туралы не айтасыз? Өтінемін, Янмен сөйлесіңіз.
Dialogue: 0,0:09:30.47,0:09:32.77,Default,,0,0,0,,Таку….
Dialogue: 0,0:09:34.80,0:09:36.81,Default,,0,0,0,,Бұл Кента туралы.
Dialogue: 0,0:09:36.81,0:09:40.48,Default,,0,0,0,,Сіз ескі достарыңызға қарайсыз ба? аа.
Dialogue: 0,0:09:40.48,0:09:43.98,Default,,0,0,0,,Егер бұл орындалмаса не болатынын ойлай бастадым...
Dialogue: 0,0:09:43.98,0:09:46.15,Default,,0,0,0,,Сіз оны арандатқаныңыз үшін➨
Dialogue: 0,0:09:46.15,0:09:49.15,Default,,0,0,0,,Мен нәтиже шығаруым керек.
Dialogue: 0,0:09:49.15,0:09:52.32,Default,,0,0,0,,Сіз таңқаларлық ақымақсыз ба? Ах...
Dialogue: 0,0:09:52.32,0:09:55.49,Default,,0,0,0,,Ямадаки сізді өз еркімен директор етіп таңдады➨
Dialogue: 0,0:09:55.49,0:09:58.49,Default,,0,0,0,,Мен матчқа қатысуды шештім.
Dialogue: 0,0:09:58.49,0:10:01.00,Default,,0,0,0,,Сонымен, сіз сәттісіз бе немесе сәтсізсіз бе➨
Dialogue: 0,0:10:01.00,0:10:03.83,Default,,0,0,0,,Жауапкершілікті өз мойнына алуы керек адам - Ямадзаки.
Dialogue: 0,0:10:03.83,0:10:06.84,Default,,0,0,0,,Хитоза Ямадзакидің шешімділігін мазақ етеді.
Dialogue: 0,0:10:06.84,0:10:08.84,Default,,0,0,0,,Ах...!
Dialogue: 0,0:10:08.84,0:10:11.67,Default,,0,0,0,,Режиссердің міндеті – үйретуге болатын нәрсені үйрету➨
Dialogue: 0,0:10:11.67,0:10:14.51,Default,,0,0,0,,Соңында, ойыншыларыңызға сеніңіз және оларды жіберіңіз.
Dialogue: 0,0:10:14.51,0:10:19.01,Default,,0,0,0,,Ал сен шымшып қалғанда мен саған қол ұшын беремін.
Dialogue: 0,0:10:19.01,0:10:23.18,Default,,0,0,0,,Хмм... Өзара түсіністік дегенді естігенде таң қалдым...
Dialogue: 0,0:10:23.18,0:10:26.02,Default,,0,0,0,,Иә! ? Ха!
Dialogue: 0,0:10:26.02,0:10:30.02,Default,,0,0,0,,Алаңдама, Хитоза! Хехе….
Dialogue: 0,0:10:30.02,0:10:34.13,Default,,0,0,0,,Ах... Аа...
Dialogue: 0,0:10:37.20,0:10:40.54,Default,,0,0,0,,Хитоза босаңсыған көрінеді және аузының бұрышын көтереді➨
Dialogue: 0,0:10:40.54,0:10:43.04,Default,,0,0,0,,Маған оның бар күшімен допты қуғаны ұнайды.
Dialogue: 0,0:10:43.04,0:10:47.14,Default,,0,0,0,,Шынымен бе? Маған бұл Хитоза ұнайды.
Dialogue: 0,0:10:49.21,0:10:51.38,Default,,0,0,0,,Жарайды, бұл кек матч.
Dialogue: 0,0:10:51.38,0:10:54.38,Default,,0,0,0,,Кім алысқа ұша алатынын білу үшін жарысайық.
Dialogue: 0,0:10:54.38,0:10:57.55,Default,,0,0,0,,Жеңілген адамға келсек...
Dialogue: 0,0:10:57.55,0:11:02.49,Default,,0,0,0,,Жеңімпазға шын жүректен шағым түсірсем ше?
Dialogue: 0,0:11:02.49,0:11:04.59,Default,,0,0,0,,Мен міндім!
Dialogue: 0,0:11:10.50,0:11:15.00,Default,,0,0,0,,《Сәку: Аспанда ең жылдам жұлдыз жарқырап тұрды.
Dialogue: 0,0:11:15.00,0:11:19.51,Default,,0,0,0,,Мен сонша алысқа жетсем ғой...》
Dialogue: 0,0:11:23.01,0:11:26.18,Default,,0,0,0,,《Сәку: Мейірімді қызға сүйенбей➨
Dialogue: 0,0:11:26.18,0:11:30.18,Default,,0,0,0,,Тұратын жерге дейін...》
Dialogue: 0,0:11:33.02,0:11:36.36,Default,,0,0,0,,📱 (дірілдеген дыбыс)
Dialogue: 0,0:11:36.36,0:11:40.19,Default,,0,0,0,,Бұл менмін. 📱(Юдзуки) Бұл менмін. Қалай жағдай?
Dialogue: 0,0:11:40.19,0:11:42.36,Default,,0,0,0,,Бұл қызықсыз жұмыс.
Dialogue: 0,0:11:42.36,0:11:46.37,Default,,0,0,0,,Бюстгалтеріңізді үш секунд ішінде шешіңіз деген сияқты.
Dialogue: 0,0:11:46.37,0:11:50.54,Default,,0,0,0,,Көңіл кофеханадағы кілегейлі сода сияқты тәтті.
Dialogue: 0,0:11:50.54,0:11:54.21,Default,,0,0,0,,📱(Юзуки) Мен бұл артқы ілмек деп ойладым, бірақ алдыңғы ілмек болды➨
Dialogue: 0,0:11:54.21,0:11:59.98,Default,,0,0,0,,Мұндай жағдайлар үнемі болып тұрады. Фуфуфуфу….
Dialogue: 0,0:11:59.98,0:12:04.15,Default,,0,0,0,,Бұл үрдіске импровизация жасамаңыз және жауап бермеңіз.
Dialogue: 0,0:12:04.15,0:12:06.32,Default,,0,0,0,,Хэхехе...
Dialogue: 0,0:12:06.32,0:12:09.16,Default,,0,0,0,,Қайырлы кеш, сөйлескіңіз келе ме?
Dialogue: 0,0:12:09.16,0:12:13.16,Default,,0,0,0,,Қайырлы кеш, сөйлесеміз бе?
Dialogue: 0,0:12:13.16,0:12:16.83,Default,,0,0,0,,📱 (Юдзуки) Неліктен Читосе Ямадзакидің ісін қолға алды?
Dialogue: 0,0:12:16.83,0:12:19.17,Default,,0,0,0,,Өйткені Құрасен мені қорқытты.
Dialogue: 0,0:12:19.17,0:12:22.67,Default,,0,0,0,,📱Мен көремін. Сіз шынымен көрсеткіңіз келмейтін бірдеңе болған кезде ➨
Dialogue: 0,0:12:22.67,0:12:24.67,Default,,0,0,0,,Барлығын жасырма➨
Dialogue: 0,0:12:24.67,0:12:28.01,Default,,0,0,0,,Тек үстірт фактілерді көрсеткен дұрыс.
Dialogue: 0,0:12:28.01,0:12:30.18,Default,,0,0,0,,Басқа себептер бар ма?
Dialogue: 0,0:12:30.18,0:12:32.51,Default,,0,0,0,,Менің бұлай айтқаным дұрыс па?
Dialogue: 0,0:12:32.51,0:12:36.02,Default,,0,0,0,,Өзіңіз туралы сіз білмейтін нәрсені ашуға көмектесетін әдемі қыз қандай?➨
Dialogue: 0,0:12:36.02,0:12:38.52,Default,,0,0,0,,Көбінесе махаббат басталады.
Dialogue: 0,0:12:38.52,0:12:41.52,Default,,0,0,0,,Өйткені сен Читосе Сакусың.
Dialogue: 0,0:12:43.86,0:12:46.86,Default,,0,0,0,,Сіз Юдзуки Нанасесіз.
Dialogue: 0,0:12:46.86,0:12:50.03,Default,,0,0,0,,Жақсы. Дұрыс жауап сияқты.
Dialogue: 0,0:12:50.03,0:12:52.87,Default,,0,0,0,,📱Маған жол арасында оқитын адамдарды ұнатпаймын.
Dialogue: 0,0:12:52.87,0:12:58.21,Default,,0,0,0,,Алғашқы әсерлері ең нашар әдемі ұлдар, әдетте, сіз ғашық бола бастайсыз.
Dialogue: 0,0:12:58.21,0:13:01.31,Default,,0,0,0,,Аа... 📱Ямазакидің көндіруі...
Dialogue: 0,0:13:01.31,0:13:05.81,Default,,0,0,0,,Уччиден кейін менің орнына Юко таңдағаныңыз ұят.
Dialogue: 0,0:13:05.81,0:13:08.98,Default,,0,0,0,,Мен Хитозаға ақшаны қарызға алғанымды қалаймын.
Dialogue: 0,0:13:08.98,0:13:12.15,Default,,0,0,0,,📱Қарызға ештеңе болмаса да, сұлу қыздың өтініші➨
Dialogue: 0,0:13:12.15,0:13:14.49,Default,,0,0,0,,Негізі менде жоқ демеу саясаты бар.
Dialogue: 0,0:13:14.49,0:13:17.33,Default,,0,0,0,,Жарайды, келесі жолы сенен бір жақсылық сұрауыңды сұрайтын шығармын.
Dialogue: 0,0:13:17.33,0:13:19.49,Default,,0,0,0,,Мысалы...
Dialogue: 0,0:13:19.49,0:13:22.50,Default,,0,0,0,,Менің сүйіктім болғың келе ме?
Dialogue: 0,0:13:24.67,0:13:27.17,Default,,0,0,0,,Мұндай тосын шабуылдарға қарсы біз әлсізбіз.
Dialogue: 0,0:13:27.17,0:13:30.17,Default,,0,0,0,,А... иә?
Dialogue: 0,0:13:30.17,0:13:33.34,Default,,0,0,0,,Басындағы импульс тым көп созылды.
Dialogue: 0,0:13:33.34,0:13:36.51,Default,,0,0,0,,Хмм….
Dialogue: 0,0:13:36.51,0:13:40.18,Default,,0,0,0,,📱(Саку) Ол кезде Нанасе арғы жақта ма әлде алдыңғы жақта ма?
Dialogue: 0,0:13:40.18,0:13:44.52,Default,,0,0,0,,📱Осылай түсінбесем, бүгін түнде ұйықтай алмаймын.
Dialogue: 0,0:13:44.52,0:13:50.19,Default,,0,0,0,,Бұл сіздің арқаңыз. Бүгін сәуірдің аспанындай бозғылт ашық көк.
Dialogue: 0,0:13:50.19,0:13:54.03,Default,,0,0,0,,Ах...! Мен бәрібір ұйықтай алмаймын деп ойлаймын.
Dialogue: 0,0:13:54.03,0:13:57.20,Default,,0,0,0,,Қайырлы түн, Хитоза.
Dialogue: 0,0:13:57.20,0:14:01.10,Default,,0,0,0,,Қайырлы түн, Нанасе.
Dialogue: 0,0:14:19.99,0:14:23.49,Default,,0,0,0,,Көзді ашып-жұмғанша уәде етілген үш апта өтті.
Dialogue: 0,0:14:23.49,0:14:27.66,Default,,0,0,0,,Менің барлық қажырлы еңбегімнің арқасында мен салмақ жоғалтуды жақсы сезінемін.
Dialogue: 0,0:14:27.66,0:14:30.33,Default,,0,0,0,,Мен аздап қысылғандай сезінемін.
Dialogue: 0,0:14:30.33,0:14:33.17,Default,,0,0,0,,Ақырында ертең ме? Шешуші шайқастың мысалы.
Dialogue: 0,0:14:33.17,0:14:37.34,Default,,0,0,0,,Шынымды айтсам, менде сізге артқа қарағым келетін құлдық сезімі жоқ➨
Dialogue: 0,0:14:37.34,0:14:41.18,Default,,0,0,0,,Барлығы мені өзгердім деп ойлайды деп үміттенемін.
Dialogue: 0,0:14:41.18,0:14:44.85,Default,,0,0,0,,Жарайды, Кента өзгерді.
Dialogue: 0,0:14:44.85,0:14:47.65,Default,,0,0,0,,Енді жерге барайық.
Dialogue: 0,0:14:50.02,0:14:53.69,Default,,0,0,0,,Саку~! Кента!
Dialogue: 0,0:14:53.69,0:14:57.02,Default,,0,0,0,,Сәлем! О, мен мұны көрдім! (Аджуму) Йо Читоза.
Dialogue: 0,0:14:57.02,0:15:00.29,Default,,0,0,0,,Жазалау ойынына бәс тігуді қалайсыз ба? (Инаба/Иномата) Иә.
Dialogue: 0,0:15:00.29,0:15:02.96,Default,,0,0,0,,Жақсы. Қатаң етейік.
Dialogue: 0,0:15:02.96,0:15:04.97,Default,,0,0,0,,Жоғары.
Dialogue: 0,0:15:04.97,0:15:09.47,Default,,0,0,0,,Құдай-ау, амансың ба? Соншалықты байсалды көрінбе.
Dialogue: 0,0:15:09.47,0:15:13.14,Default,,0,0,0,,Бұл жай ғана ойын. Мен сізге де көп жолдама беремін.
Dialogue: 0,0:15:13.14,0:15:17.15,Default,,0,0,0,,Жоқ! Мүмкін емес, мүмкін емес, мүмкін емес! Қолды қолданатын жарыстар да мүмкін емес ➨
Dialogue: 0,0:15:17.15,0:15:19.65,Default,,0,0,0,,Аяқпен ештеңе істеу мүмкін емес дейді!
Dialogue: 0,0:15:19.65,0:15:23.82,Default,,0,0,0,,Кентаға жазалау ойыны қажет емес, сондықтан бәріміз бірге көңіл көтерейік.
Dialogue: 0,0:15:23.82,0:15:27.52,Default,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,0:15:34.33,0:15:38.67,Default,,0,0,0,,Кента! Мен сізге дәмді нәрсе беремін, сондықтан мақсатқа жақын жерде күтіңіз!
Dialogue: 0,0:15:38.67,0:15:49.34,Default,,0,0,0,,♬～
Dialogue: 0,0:15:49.34,0:15:52.01,Default,,0,0,0,,Жақсы Кента! Мені ұр!
Dialogue: 0,0:15:52.01,0:15:56.85,Default,,0,0,0,,Уа, ау... Апыр-ай...!
Dialogue: 0,0:15:56.85,0:15:59.05,Default,,0,0,0,,Уа! о!
Dialogue: 0,0:16:01.96,0:16:05.29,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:16:05.29,0:16:08.80,Default,,0,0,0,,Дахахаха... Иіс деген бар ма?
Dialogue: 0,0:16:08.80,0:16:11.97,Default,,0,0,0,,Гухахаха... Тым ұят... Хахаха...!
Dialogue: 0,0:16:11.97,0:16:15.47,Default,,0,0,0,,Уайымдама, Кента! Ұрыс~!
Dialogue: 0,0:16:15.47,0:16:17.97,Default,,0,0,0,,Бұл өте қызықты форма болды.
Dialogue: 0,0:16:17.97,0:16:20.81,Default,,0,0,0,,Егер соқса, бұл даладан тыс үйге жүгіру.
Dialogue: 0,0:16:20.81,0:16:25.01,Default,,0,0,0,,Демек, сіз бұл мүмкін емес дейсіз...
Dialogue: 0,0:16:29.32,0:16:34.32,Default,,0,0,0,,《Саку: Көңіл көтеруге болмайды, бірақ Кентаның жүрегі байсалды...
Dialogue: 0,0:16:34.32,0:16:38.83,Default,,0,0,0,,Осыдан кейін бәріміз бірге допты бердік, соның ішінде Кента➨
Dialogue: 0,0:16:38.83,0:16:40.83,Default,,0,0,0,,Ол футбол ойнағанды ұнататын.
Dialogue: 0,0:16:40.83,0:16:44.50,Default,,0,0,0,,Жаттығуда жақсы емес адамды есептен шығару арқылы жеңдіңіз делік➨
Dialogue: 0,0:16:44.50,0:16:46.83,Default,,0,0,0,,Мұның несі қызық?
Dialogue: 0,0:16:46.83,0:16:51.34,Default,,0,0,0,,Ойын қызықты, өйткені бәрі бірге жасайды.
Dialogue: 0,0:16:54.51,0:16:57.01,Default,,0,0,0,,Қашанға дейін осындай нәрселермен айналысасың?
Dialogue: 0,0:16:57.01,0:17:00.95,Default,,0,0,0,,Олай айтпа. Кента өте керемет жігіт.
Dialogue: 0,0:17:00.95,0:17:03.05,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:17:05.29,0:17:07.29,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:09.29,0:17:11.96,Default,,0,0,0,,Сіз соншалықты жалқаусыз! Көңіл-күйіңізді көтеріңіз!
Dialogue: 0,0:17:11.96,0:17:14.46,Default,,0,0,0,,Саку~ Маған салқын қырыңызды көрсетіңіз~!
Dialogue: 0,0:17:14.46,0:17:16.63,Default,,0,0,0,,Егер біз осы жерден бұрылсақ, біз сізді 8 санымен сыйлаймыз!
Dialogue: 0,0:17:16.63,0:17:18.63,Default,,0,0,0,,Сәттілік, Ямадаки-кун!
Dialogue: 0,0:17:18.63,0:17:21.14,Default,,0,0,0,,Эй, сәлем…. Кента!
Dialogue: 0,0:17:21.14,0:17:23.80,Default,,0,0,0,,Ах! ? Соңында ең жақсы бөлігін көрсетейік!
Dialogue: 0,0:17:23.80,0:17:26.64,Default,,0,0,0,,Иә….
Dialogue: 0,0:17:28.64,0:17:34.98,Default,,0,0,0,,♬～
Dialogue: 0,0:17:34.98,0:17:37.08,Default,,0,0,0,,Уау! Жарайсың!
Dialogue: 0,0:17:39.65,0:17:41.66,Default,,0,0,0,,Кента!
Dialogue: 0,0:17:43.82,0:17:46.16,Default,,0,0,0,,Ал...
Dialogue: 0,0:17:46.16,0:17:50.83,Default,,0,0,0,,Соңғы рет жарысамыз ба? Бұл Осе!
Dialogue: 0,0:17:50.83,0:17:52.83,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:57.84,0:18:00.94,Default,,0,0,0,,Шешіңіз, бұл дәмді.
Dialogue: 0,0:18:00.94,0:18:03.44,Default,,0,0,0,,Аа...
Dialogue: 0,0:18:07.45,0:18:10.12,Default,,0,0,0,,Иә! Апыр-ай...!
Dialogue: 0,0:18:10.12,0:18:12.29,Default,,0,0,0,,Уау...!
Dialogue: 0,0:18:12.29,0:18:14.62,Default,,0,0,0,,Жарайсыңдар! Саку Өте керемет!
Dialogue: 0,0:18:14.62,0:18:17.46,Default,,0,0,0,,Күтілгендей. Ямадзаки-кун да жақсы.
Dialogue: 0,0:18:17.46,0:18:21.80,Default,,0,0,0,,Жоғалту - бұл шығын! Деніміз сау болсын!
Dialogue: 0,0:18:21.80,0:18:26.63,Default,,0,0,0,,♬ (Саку/Каито/Казуки) «Маймыл горилла шимпанзе»
Dialogue: 0,0:18:26.63,0:18:33.98,Default,,0,0,0,,♬ “Маймыл горилла шимпанзе маймыл горилла шимпанзе”
Dialogue: 0,0:18:33.98,0:18:37.48,Default,,0,0,0,,Сәлем! Нақтырақ...! Іске сәт!
Dialogue: 0,0:18:37.48,0:18:41.08,Default,,0,0,0,,Аа... Ах... Қарғыс атқыр...
Dialogue: 0,0:18:44.15,0:18:46.99,Default,,0,0,0,,Бүгінгі дене шынықтыру сабағы өте қызықты өтті!
Dialogue: 0,0:18:46.99,0:18:50.99,Default,,0,0,0,,А-а... Қоянды секіртсем де, суретке айналатыныма қорқамын.
Dialogue: 0,0:18:50.99,0:18:54.50,Default,,0,0,0,,Соңғы бөліктен басқасы өте нашар болды.
Dialogue: 0,0:18:54.50,0:18:57.00,Default,,0,0,0,,Бәріне Кента кінәлі. Ах!
Dialogue: 0,0:18:57.00,0:19:00.60,Default,,0,0,0,,Кентаккидің түсірілімі Мен оны ешқашан ұмытпаймын.
Dialogue: 0,0:19:00.60,0:19:03.94,Default,,0,0,0,,Қанша иіскесем де, берілмеймін. Фуфуфу….
Dialogue: 0,0:19:03.94,0:19:06.44,Default,,0,0,0,,Әй, қарағым, ол өте қызық жігіт, солай емес пе?
Dialogue: 0,0:19:06.44,0:19:10.44,Default,,0,0,0,,Иә? Ах Кентакчи. (жабылу дыбысы)
Dialogue: 0,0:19:10.44,0:19:13.95,Default,,0,0,0,,Кеш болды. Бүгін үшеуміз 8 санына барайық.
Dialogue: 0,0:19:13.95,0:19:17.45,Default,,0,0,0,,Не... алдайсың ба? (2 адам) Әй?
Dialogue: 0,0:19:17.45,0:19:19.95,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Енді мен туралы жаман сөз айт➨
Dialogue: 0,0:19:19.95,0:19:22.29,Default,,0,0,0,,Сіз күлдіңіз! (2 адам) Ах!
Dialogue: 0,0:19:22.29,0:19:26.79,Default,,0,0,0,,Жоқ... Менің ойымша, егер сіз осында болсаңыз, мен де дәл осылай әбігерге түсетін болар едім.
Dialogue: 0,0:19:26.79,0:19:29.46,Default,,0,0,0,,Уемура-кун дұрыс айтады.
Dialogue: 0,0:19:29.46,0:19:33.13,Default,,0,0,0,,Мен ақымақ фольга болдым...
Dialogue: 0,0:19:33.13,0:19:36.30,Default,,0,0,0,,Кентакчи, сіз бірдеңені дұрыс түсінбедіңіз бе?
Dialogue: 0,0:19:36.30,0:19:40.14,Default,,0,0,0,,Дұрыс, бәрібір ертеңге дейін қарым-қатынас...
Dialogue: 0,0:19:40.14,0:19:43.48,Default,,0,0,0,,Аджуму саған не айтты?
Dialogue: 0,0:19:43.48,0:19:47.15,Default,,0,0,0,,Уф… уф….
Dialogue: 0,0:19:47.15,0:19:49.32,Default,,0,0,0,,Біз сияқты адамдар үшін➨
Dialogue: 0,0:19:49.32,0:19:52.15,Default,,0,0,0,,Дене тәрбиесі азаптан басқа ештеңе емес...
Dialogue: 0,0:19:52.15,0:19:54.66,Default,,0,0,0,,Бірақ мені күштеп тарту➨
Dialogue: 0,0:19:54.66,0:19:57.66,Default,,0,0,0,,Соңында сіз батыр боласыз...
Dialogue: 0,0:19:57.66,0:20:00.10,Default,,0,0,0,,Сіз тіпті біздің қайғы-қасіретімізді түсінесіз бе?
Dialogue: 0,0:20:00.10,0:20:04.33,Default,,0,0,0,,Бар болу арқылы сіз басқа біреудің ➨ тауын басып аласыз
Dialogue: 0,0:20:04.33,0:20:06.67,Default,,0,0,0,,Балалар!
Dialogue: 0,0:20:06.67,0:20:10.67,Default,,0,0,0,,Бұл… жаман болды….
Dialogue: 0,0:20:10.67,0:20:13.67,Default,,0,0,0,,Ах! аздап!
Dialogue: 0,0:20:13.67,0:20:17.01,Default,,0,0,0,,Сіз бірге уақыт өткізген Саку осылай болды ма?
Dialogue: 0,0:20:17.01,0:20:20.51,Default,,0,0,0,,Артынан Кентачкидің қателіктерін мазақ етеді➨
Dialogue: 0,0:20:20.51,0:20:23.68,Default,,0,0,0,,Сіз байсалдысыз ба? Ах...
Dialogue: 0,0:20:23.68,0:20:26.85,Default,,0,0,0,,Жоқ…. Ах! ?
Dialogue: 0,0:20:26.85,0:20:29.19,Default,,0,0,0,,Мен Кентаға солай ойлай бергенімде➨
Dialogue: 0,0:20:29.19,0:20:33.03,Default,,0,0,0,,Менің істегенім жай ғана қорлау болды.
Dialogue: 0,0:20:33.03,0:20:35.86,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:20:35.86,0:20:39.07,Default,,0,0,0,,Ах...! Уф...!
Dialogue: 0,0:20:41.87,0:20:45.07,Default,,0,0,0,,Кента! Ертеңгі күнге сәттілік!
Dialogue: 0,0:20:47.37,0:20:50.58,Default,,0,0,0,,Бұл нәтиже беретініне сенімдімін.
Dialogue: 0,0:20:53.21,0:20:57.22,Default,,0,0,0,,Шынымен оны осылай қалдыру дұрыс па? (Саку) Жарайды.
Dialogue: 0,0:20:57.22,0:21:00.15,Default,,0,0,0,,Басынан бері уәде үш апта болатын.
Dialogue: 0,0:21:00.15,0:21:03.32,Default,,0,0,0,,Ертеңнен бастап тағы да бөлек жолдармен кетеміз.
Dialogue: 0,0:21:03.32,0:21:06.16,Default,,0,0,0,,Кентакчи Мен жақсы өтеді деп үміттенемін.
Dialogue: 0,0:21:06.16,0:21:09.00,Default,,0,0,0,,Бұл орындалады. (Юу көлі) Саку менімен➨
Dialogue: 0,0:21:09.00,0:21:11.17,Default,,0,0,0,,Мен саған әр нәрсені үйреттім.
Dialogue: 0,0:21:11.17,0:21:13.67,Default,,0,0,0,,Менімен бірге Юуко да шықты.
Dialogue: 0,0:21:13.67,0:21:15.84,Default,,0,0,0,,Біз жай ғана араласатынбыз.
Dialogue: 0,0:21:15.84,0:21:19.17,Default,,0,0,0,,Саку айтпаса, мен қимылдамас едім➨
Dialogue: 0,0:21:19.17,0:21:22.68,Default,,0,0,0,,Мен Кента-чи өзгереді деп ешқашан ойламадым.
Dialogue: 0,0:21:22.68,0:21:27.68,Default,,0,0,0,,Саку екеуміздің айырмашылығымыз осында, мен бұл батырлыққа қойылатын талап екеніне сенімдімін.
Dialogue: 0,0:21:27.68,0:21:29.85,Default,,0,0,0,,Мен батыр емеспін.
Dialogue: 0,0:21:29.85,0:21:34.02,Default,,0,0,0,,Юко мені тым асқақтатады.
Dialogue: 0,0:21:34.02,0:21:37.02,Default,,0,0,0,,Өздерін батырмын деп есептейтін адамдар➨
Dialogue: 0,0:21:37.02,0:21:41.03,Default,,0,0,0,,Мен өзімді батыр деп санағым келмейді.
Dialogue: 0,0:21:41.03,0:21:46.53,Default,,0,0,0,,Нағыз мейірімділік адамның өзіне ғана көрінбейді.
Dialogue: 0,0:21:46.53,0:21:50.20,Default,,0,0,0,,Кешкі адамның маған қалай қарайтынына сенуге бола ма?
Dialogue: 0,0:21:50.20,0:21:54.04,Default,,0,0,0,,А, бұл қорқынышты!
Dialogue: 0,0:21:54.04,0:21:57.71,Default,,0,0,0,,Кішкентай кезімнен мені әртүрлі адамдар көреді➨
Dialogue: 0,0:21:57.71,0:22:00.61,Default,,0,0,0,,Мен оны көріп үйреніп қалдым.
Dialogue: 0,0:22:02.48,0:22:06.15,Default,,0,0,0,,Мен сене алғанша, сенуге тырысамын.
Dialogue: 0,0:22:06.15,0:22:09.82,Default,,0,0,0,,Аа... сонда...
Dialogue: 0,0:22:09.82,0:22:14.83,Default,,0,0,0,,Мүмкін мәңгілік.
Dialogue: 0,0:22:16.33,0:22:22.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory