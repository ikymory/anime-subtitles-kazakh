Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:47.87,0:01:50.17,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:01:57.05,0:01:59.05,Default,,0,0,0,,Хмм….
Dialogue: 0,0:02:03.82,0:02:06.49,Default,,0,0,0,,Ертеңгі желдің жолы мен айтқандай.
Dialogue: 0,0:02:06.49,0:02:09.83,Default,,0,0,0,,Иә, бұл рас деп ойлаймын.
Dialogue: 0,0:02:09.83,0:02:14.16,Default,,0,0,0,,Мен бұл бала Фукудайға барып, мемлекеттік қызметші болады деп шештім.
Dialogue: 0,0:02:14.16,0:02:17.17,Default,,0,0,0,,Бұл нені білдіреді? (3 адам) Әй! ?
Dialogue: 0,0:02:17.17,0:02:21.00,Default,,0,0,0,,Ах... (Ертеңгі жел) Хмм...
Dialogue: 0,0:02:21.00,0:02:24.34,Default,,0,0,0,,Аа, еңбегіңіз үшін рахмет. Үйге бара аласыз. Бірақ!
Dialogue: 0,0:02:24.34,0:02:28.51,Default,,0,0,0,,Сіз бұл әңгімеге қандай дәрежеде қосылмақсыз?
Dialogue: 0,0:02:28.51,0:02:31.51,Default,,0,0,0,,Үйге қайт. Ах!
Dialogue: 0,0:02:31.51,0:02:34.02,Default,,0,0,0,,Түсіндім, бұл сенсің. иә?
Dialogue: 0,0:02:34.02,0:02:36.52,Default,,0,0,0,,Жақсы, Иванами мырза.
Dialogue: 0,0:02:36.52,0:02:40.19,Default,,0,0,0,,Қаласаңыз, отырыңыз. әке!
Dialogue: 0,0:02:40.19,0:02:44.19,Default,,0,0,0,,Кешіріңіз. Менің атым Читосе Саку.
Dialogue: 0,0:02:46.19,0:02:50.20,Default,,0,0,0,,Сәлем, Нисси. Енді мистер Нишино.
Dialogue: 0,0:02:50.20,0:02:54.04,Default,,0,0,0,,О? О, бұл Нишино-сан.
Dialogue: 0,0:02:54.04,0:02:57.37,Default,,0,0,0,,Сіз мұны қызыңызбен талқылағаннан кейін шештіңіз бе?
Dialogue: 0,0:02:57.37,0:02:59.71,Default,,0,0,0,,Талқылаудың қажеті жоқ.
Dialogue: 0,0:02:59.71,0:03:02.81,Default,,0,0,0,,Мен Асуказэ туралы жақсы білемін➨
Dialogue: 0,0:03:02.81,0:03:06.98,Default,,0,0,0,,Бұл қалай бақытты болуға болатынын ойлағаннан кейін қабылданған шешім.
Dialogue: 0,0:03:06.98,0:03:09.65,Default,,0,0,0,,Асуказэ неге Токиоға барғысы келеді➨
Dialogue: 0,0:03:09.65,0:03:11.65,Default,,0,0,0,,Сіз мені сұрадыңыз, солай ма?
Dialogue: 0,0:03:11.65,0:03:13.82,Default,,0,0,0,,Редактор болғың келетін сияқты.
Dialogue: 0,0:03:13.82,0:03:18.16,Default,,0,0,0,,Сол арманға мән бермей, бақытты бола аласыз ба?
Dialogue: 0,0:03:18.16,0:03:20.16,Default,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:03:20.16,0:03:23.50,Default,,0,0,0,,Жастар, сіз бұл туралы жай ғана сөйлесесіз➨
Dialogue: 0,0:03:23.50,0:03:26.33,Default,,0,0,0,,Барлығы рұқсат етілгендей әрекет етіңіз.
Dialogue: 0,0:03:26.33,0:03:28.84,Default,,0,0,0,,Сіз редактор болуды мақсат еттіңіз делік➨
Dialogue: 0,0:03:28.84,0:03:31.34,Default,,0,0,0,,Сіз үлкейтудің не екенін білесіз бе?
Dialogue: 0,0:03:31.34,0:03:34.68,Default,,0,0,0,,Бұл өте тар қақпа, солай емес пе?
Dialogue: 0,0:03:34.68,0:03:37.68,Default,,0,0,0,,Егер бұл белгілі ірі компания болса, 100 есе арзан.
Dialogue: 0,0:03:37.68,0:03:40.85,Default,,0,0,0,,Дүние соншалықты тәтті емес, мен оны ұнатамын деп оған кіремін.
Dialogue: 0,0:03:40.85,0:03:45.35,Default,,0,0,0,,Шағын баспа компаниясынан жоғары көтерілудің басқа жолы бар емес пе?
Dialogue: 0,0:03:47.52,0:03:50.36,Default,,0,0,0,,Ертеңгі армандарды қалай орындауға болады➨
Dialogue: 0,0:03:50.36,0:03:54.53,Default,,0,0,0,,Ең төменгі шарт - жаңа бөлімнің табысты болуы➨
Dialogue: 0,0:03:54.53,0:03:57.03,Default,,0,0,0,,Мұндай баспагерлер шектеулі.
Dialogue: 0,0:03:57.03,0:03:59.37,Default,,0,0,0,,Әлі де... Мен көздеген уақыт ➨ болатын
Dialogue: 0,0:03:59.37,0:04:02.47,Default,,0,0,0,,Бұл босқа кетпей ме? Уф...
Dialogue: 0,0:04:02.47,0:04:07.81,Default,,0,0,0,,Мен кішігірім компанияға қосылдым және айлық жалақысы аз және ауыр жұмыс арқылы ақыл мен денемді сындырдым➨
Dialogue: 0,0:04:07.81,0:04:11.31,Default,,0,0,0,,Жұмысты ауыстыра алмасаң, өкінуге тым кеш.
Dialogue: 0,0:04:11.31,0:04:17.15,Default,,0,0,0,,Сонда сіз жауапкершілікті ала аласыз ба? Ол ертең желді тамақтандырады ма?
Dialogue: 0,0:04:17.15,0:04:19.82,Default,,0,0,0,,Хитозе-кун. Хмм...
Dialogue: 0,0:04:19.82,0:04:22.49,Default,,0,0,0,,Фукуйде қалсаңыз, сізде отбасылық үй болады.
Dialogue: 0,0:04:22.49,0:04:25.33,Default,,0,0,0,,Ертең жел соғып тұрса, мемлекеттік қызметке емтиханда қиындық болмайды.
Dialogue: 0,0:04:25.33,0:04:28.33,Default,,0,0,0,,Жақсы жар тауып, отбасын құрсаңыз болғаны➨
Dialogue: 0,0:04:28.33,0:04:31.17,Default,,0,0,0,,Ұзақ бақытқа кепілдік беріледі.
Dialogue: 0,0:04:31.17,0:04:36.00,Default,,0,0,0,,Ата-ананың осылай тілеуі дұрыс емес пе?
Dialogue: 0,0:04:36.00,0:04:41.84,Default,,0,0,0,,Түбінде жүргенімде Асуказенің сөзі мені құтқарды.
Dialogue: 0,0:04:41.84,0:04:44.18,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:04:44.18,0:04:49.52,Default,,0,0,0,,Менің ойымша, жоғары ұлғайту арқылы өтуге күшім жеткілікті.
Dialogue: 0,0:04:49.52,0:04:52.02,Default,,0,0,0,,Кәсіби маман бола алатыныңызға сеніңіз➨
Dialogue: 0,0:04:52.02,0:04:57.19,Default,,0,0,0,,Сіздің ойыңызша, қанша бейсболшы өз ұмтылыстарының ортасында бас тартты?
Dialogue: 0,0:04:57.19,0:04:59.53,Default,,0,0,0,,Негізсіз сенім➨
Dialogue: 0,0:04:59.53,0:05:02.30,Default,,0,0,0,,адасудан көп айырмашылығы жоқ. Уф!
Dialogue: 0,0:05:02.30,0:05:05.63,Default,,0,0,0,,Баланың еркін құрметтеу ата-ананың міндеті болса ➨
Dialogue: 0,0:05:05.63,0:05:09.14,Default,,0,0,0,,Сондай-ақ, ата-ананың міндеті – балаларын оқыту, бағыт-бағдар беру.
Dialogue: 0,0:05:09.14,0:05:11.97,Default,,0,0,0,,Сіз де, Ертең Кэзе де менің пікірім бар➨
Dialogue: 0,0:05:11.97,0:05:15.31,Default,,0,0,0,,Менде онымен күресуге сөзім болмады.
Dialogue: 0,0:05:15.31,0:05:17.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:17.31,0:05:20.62,Default,,0,0,0,,Бұл біздің мәселеміз.
Dialogue: 0,0:05:24.32,0:05:27.32,Default,,0,0,0,,Иә. (қол шапалақтау дыбысы)
Dialogue: 0,0:05:27.32,0:05:31.33,Default,,0,0,0,,Қазіргі таңда менің бірінші таңдауым – Фукудай.
Dialogue: 0,0:05:31.33,0:05:36.33,Default,,0,0,0,,Мен сізді соңғы шешім туралы хабардар еттім деп ойладым ба? Уф….
Dialogue: 0,0:05:36.33,0:05:40.67,Default,,0,0,0,,Баланың өсу қарқынына көп сын айтпаған дұрыс деп ойлаймын.
Dialogue: 0,0:05:40.67,0:05:43.00,Default,,0,0,0,,Мұны Нисси де білетініне сенімдімін.
Dialogue: 0,0:05:43.00,0:05:48.34,Default,,0,0,0,,Бұл Нишино мырза болуы керек. Бұл өзгермейді.
Dialogue: 0,0:05:48.34,0:05:50.68,Default,,0,0,0,,Сіз өзгердіңіз.
Dialogue: 0,0:05:50.68,0:05:53.68,Default,,0,0,0,,Ол тек қисынды болған ресми қарт болды.
Dialogue: 0,0:05:53.68,0:06:00.19,Default,,0,0,0,,Үйрете берсең, ақырында түсінесің.
Dialogue: 0,0:06:04.46,0:06:08.30,Default,,0,0,0,,Кешіріңіз. Өйткені, сен көрген менмін➨
Dialogue: 0,0:06:08.30,0:06:12.47,Default,,0,0,0,,Бұл жай ғана елес сияқты... Әй...!
Dialogue: 0,0:06:12.47,0:06:17.47,Default,,0,0,0,,《Ақымақ болма》
Dialogue: 0,0:06:17.47,0:06:21.31,Default,,0,0,0,,Ах! Бірге ішейік.
Dialogue: 0,0:06:21.31,0:06:23.51,Default,,0,0,0,,⚟ Сәлеметсіз бе, Президент мырза!
Dialogue: 0,0:06:25.48,0:06:28.65,Default,,0,0,0,,Сонымен? Өзіңізді қалай сезінесіз?
Dialogue: 0,0:06:28.65,0:06:32.99,Default,,0,0,0,,Мен жақсы көретін бір үлкеннің әкесі маған: «Менің қызым мұны істемейді» деді.
Dialogue: 0,0:06:32.99,0:06:36.16,Default,,0,0,0,,Тойға сәлем бергенім есімде жоқ.
Dialogue: 0,0:06:36.16,0:06:41.16,Default,,0,0,0,,Өзіңізді қалай сезінесіз? Батырдың батылдығымен шабуылға шықты.
Dialogue: 0,0:06:41.16,0:06:44.00,Default,,0,0,0,,Әлі жоғалтпа.
Dialogue: 0,0:06:44.00,0:06:46.00,Default,,0,0,0,,Жоғары.
Dialogue: 0,0:06:46.00,0:06:49.84,Default,,0,0,0,,Курасен сенді ме? Сіз мұны істеп жатқан сияқты болдыңыз ба?
Dialogue: 0,0:06:49.84,0:06:53.01,Default,,0,0,0,,Дәлірек айтқанда, біз бір-бірімізді білетін сияқтымыз.
Dialogue: 0,0:06:53.01,0:06:59.01,Default,,0,0,0,,Нипси орта мектепте менің сынып жетекшім болды. Мен түсінемін. Міне бітті.
Dialogue: 0,0:06:59.01,0:07:02.78,Default,,0,0,0,,Студент кезімде жағдай өте қиын болатын.
Dialogue: 0,0:07:02.78,0:07:05.95,Default,,0,0,0,,Ах! ? Мүмкін➨
Dialogue: 0,0:07:05.95,0:07:09.46,Default,,0,0,0,,Сол кезде Құрасенді ақтап алған сол кісі болды дейсіз бе?
Dialogue: 0,0:07:09.46,0:07:13.96,Default,,0,0,0,,Ол бұрын жанашыр, ынталы адам болған сияқты?
Dialogue: 0,0:07:13.96,0:07:17.80,Default,,0,0,0,,Бірінші жартысы дұрыс, екінші жартысы дұрыс емес.
Dialogue: 0,0:07:17.80,0:07:20.97,Default,,0,0,0,,Бұл маған шындап өмір сүруге мүмкіндік берді➨
Dialogue: 0,0:07:20.97,0:07:25.81,Default,,0,0,0,,Нипси әрқашан заңды зорлық-зомбылықпен қашу жолдарын жауып тастайтын түрі болды.
Dialogue: 0,0:07:25.81,0:07:27.98,Default,,0,0,0,,Сурет тамаша.
Dialogue: 0,0:07:27.98,0:07:30.15,Default,,0,0,0,,Шочу жартасы. ⚟Аййо~!
Dialogue: 0,0:07:30.15,0:07:33.32,Default,,0,0,0,,Дәл... солай➨
Dialogue: 0,0:07:33.32,0:07:37.32,Default,,0,0,0,,Ол өз пайымдауымен біреудің шешімін жоққа шығаратын адам емес еді.
Dialogue: 0,0:07:37.32,0:07:41.82,Default,,0,0,0,,Сайып келгенде, маңыздысы сіздің қалауыңыз.
Dialogue: 0,0:07:41.82,0:07:43.83,Default,,0,0,0,,Ерік….
Dialogue: 0,0:07:43.83,0:07:48.66,Default,,0,0,0,,Иә, сізді Шочу рок күтіп тұр. Сәлем.
Dialogue: 0,0:07:48.66,0:07:52.17,Default,,0,0,0,,Жылдар өткен сайын ойлау тәсілі өзгерді ме➨
Dialogue: 0,0:07:52.17,0:07:56.00,Default,,0,0,0,,Менің қызым сүйкімді болғандықтан тым қатал болып кете ме?
Dialogue: 0,0:07:56.00,0:07:59.67,Default,,0,0,0,,Бірақ қызымның бақытын ойлап жүргенім➨
Dialogue: 0,0:07:59.67,0:08:01.88,Default,,0,0,0,,Бұл өтірік емес еді, солай ма?
Dialogue: 0,0:08:03.95,0:08:06.78,Default,,0,0,0,,Пухаа~. Мен келісемін.
Dialogue: 0,0:08:06.78,0:08:10.12,Default,,0,0,0,,Мұғалім болу қиын жұмыс...
Dialogue: 0,0:08:10.12,0:08:12.29,Default,,0,0,0,,Егер мен қалыпты өмір сүрсем➨
Dialogue: 0,0:08:12.29,0:08:15.29,Default,,0,0,0,,Баланың өміріне жауапты болу➨
Dialogue: 0,0:08:15.29,0:08:17.96,Default,,0,0,0,,Тек Теменің баласы болған кезде.
Dialogue: 0,0:08:17.96,0:08:20.96,Default,,0,0,0,,Бірақ мен бұл жұмысты істеп жатқанда➨
Dialogue: 0,0:08:20.96,0:08:25.13,Default,,0,0,0,,Жыл сайын ондаған, жүздеген адамдар бұл ауыртпалықты көтереді.
Dialogue: 0,0:08:25.13,0:08:28.64,Default,,0,0,0,,Бұл рас. Барлығы - бәрі➨
Dialogue: 0,0:08:28.64,0:08:32.31,Default,,0,0,0,,Менің армандарымды орындасаңыз, қуанар едім➨
Dialogue: 0,0:08:32.31,0:08:34.81,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:08:34.81,0:08:39.81,Default,,0,0,0,,Сахна артында сансыз сәтсіздіктер, сәтсіздіктер мен өкініштер бар➨
Dialogue: 0,0:08:39.81,0:08:45.65,Default,,0,0,0,,Жаныңда осындай нәрселерді бақылап отыратын жұмыс.
Dialogue: 0,0:08:45.65,0:08:48.82,Default,,0,0,0,,Сонда мұғалімнің айтқанына сену керек пе?
Dialogue: 0,0:08:48.82,0:08:52.66,Default,,0,0,0,,Жоқ. Олай емес➨
Dialogue: 0,0:08:52.66,0:08:57.67,Default,,0,0,0,,Бұл мұғалімдердің оқушыларына қарап адамдарды танитындай сезінетінін білдіреді.
Dialogue: 0,0:08:57.67,0:09:00.94,Default,,0,0,0,,Неліктен Құрасен орта мектепте мұғалім болуды мақсат етті?
Dialogue: 0,0:09:00.94,0:09:04.11,Default,,0,0,0,,Сонда сізге Нишино мырза әсер етті ме?
Dialogue: 0,0:09:04.11,0:09:08.78,Default,,0,0,0,,Менің айналамда Ниссиден басқа лайықты ересек адамдар болған жоқ.
Dialogue: 0,0:09:08.78,0:09:13.62,Default,,0,0,0,,Солай ма? Өмір солай.
Dialogue: 0,0:09:13.62,0:09:16.79,Default,,0,0,0,,Біртүрлі➨
Dialogue: 0,0:09:16.79,0:09:20.12,Default,,0,0,0,,Мен оны мақсат етпеуім керек деп ешқашан ойлаған емеспін.
Dialogue: 0,0:09:20.12,0:09:25.13,Default,,0,0,0,,Бұл мен Темеде таңдаған болашақ. Жауапты дұрыс жасау Темидің міндеті.
Dialogue: 0,0:09:25.13,0:09:28.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:33.64,0:09:35.80,Default,,0,0,0,,Жаттығу туралы не айтасыз?
Dialogue: 0,0:09:35.80,0:09:38.81,Default,,0,0,0,,Янмен 1-ден 1-ге жеңілгені үшін жазалау ойыны.
Dialogue: 0,0:09:38.81,0:09:41.48,Default,,0,0,0,,Хахаха...! Иә, бөлісіңіз.
Dialogue: 0,0:09:41.48,0:09:45.81,Default,,0,0,0,,Бұрынғы жігітім сол жерде жылап жібергендей тұрды, сондықтан мен самурайдың жанашырлығын сезіндім.
Dialogue: 0,0:09:45.81,0:09:48.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:50.99,0:09:52.99,Default,,0,0,0,,(әйнек қағу дыбысы)
Dialogue: 0,0:09:52.99,0:09:55.82,Default,,0,0,0,,Иә! Ертең әпке?
Dialogue: 0,0:09:55.82,0:09:58.83,Default,,0,0,0,,Басқа оқиға! Не! ?
Dialogue: 0,0:09:58.83,0:10:02.16,Default,,0,0,0,,Жалаңаш жәшікке келсем, арқаңды көрдім.
Dialogue: 0,0:10:02.16,0:10:06.33,Default,,0,0,0,,Қорқынышты, мұңды және әйтеуір жеңілдетілген...
Dialogue: 0,0:10:06.33,0:10:08.84,Default,,0,0,0,,Сондықтан мен оны осылай елестеттім!
Dialogue: 0,0:10:08.84,0:10:11.17,Default,,0,0,0,,(әйнек қағу дыбысы)
Dialogue: 0,0:10:11.17,0:10:13.68,Default,,0,0,0,,⸨Аа, ертең апа.
Dialogue: 0,0:10:13.68,0:10:16.85,Default,,0,0,0,,Күткендей, қашып құтыла алмайсың.
Dialogue: 0,0:10:16.85,0:10:20.35,Default,,0,0,0,,Мен де! Тағы да сіздермен➨
Dialogue: 0,0:10:20.35,0:10:24.19,Default,,0,0,0,,Мен сенімен дұрыс сөйлесуім керек деп ойладым...⸩
Dialogue: 0,0:10:24.19,0:10:26.19,Default,,0,0,0,,сияқты!
Dialogue: 0,0:10:26.19,0:10:29.52,Default,,0,0,0,,Мен білмеймін. Бірақ не болды! ?
Dialogue: 0,0:10:29.52,0:10:32.53,Default,,0,0,0,,Сіз, мен өзім сүйетін ағаны күтемін➨
Dialogue: 0,0:10:32.53,0:10:37.20,Default,,0,0,0,,Менің сыныптасым сүйкімді қызбен сырласудың несі айып? ?
Dialogue: 0,0:10:37.20,0:10:41.87,Default,,0,0,0,,Сізге рахмет, мен кету мүмкіндігін жіберіп алдым да, саусағымды аузыма алып қарадым, бірақ не болды! ?
Dialogue: 0,0:10:41.87,0:10:44.37,Default,,0,0,0,,Әй... ертең апа, сабыр етіңіз.
Dialogue: 0,0:10:44.37,0:10:47.08,Default,,0,0,0,,Кейіпкерде қате бар.
Dialogue: 0,0:10:51.05,0:10:54.55,Default,,0,0,0,,Кешіріңіз. Мен саған қиындық туғыздым.
Dialogue: 0,0:10:54.55,0:10:56.55,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:56.55,0:11:00.49,Default,,0,0,0,,Ешқандай дайындықсыз бар күшіммен сол жерге секірдім.
Dialogue: 0,0:11:00.49,0:11:06.09,Default,,0,0,0,,Бұл сіз үшін керемет. Жоқ, жоқ, жоқ.
Dialogue: 0,0:11:08.33,0:11:12.67,Default,,0,0,0,,Ол жаман адам емес. (Саку) Түсіндім.
Dialogue: 0,0:11:12.67,0:11:17.67,Default,,0,0,0,,Егер ол жай ғана жаман жігіт болса, мен айтқанымнан қайтпас едім деп ойлаймын.
Dialogue: 0,0:11:17.67,0:11:22.38,Default,,0,0,0,,Ертең апамның әкесі жақсы әке.
Dialogue: 0,0:11:24.68,0:11:28.68,Default,,0,0,0,,《Сәку: Бұл кісі бұрыннан білетін шығар.
Dialogue: 0,0:11:28.68,0:11:31.35,Default,,0,0,0,,Менің ойымша, бала болған дұрыс болар еді.
Dialogue: 0,0:11:31.35,0:11:34.36,Default,,0,0,0,,Егжей-тегжейлі логиканы өткізіп жіберіңіз➨
Dialogue: 0,0:11:34.36,0:11:38.03,Default,,0,0,0,,Өзінің өзімшілдігіне итермелейтін адамдар көп...》
Dialogue: 0,0:11:38.03,0:11:42.86,Default,,0,0,0,,Бірақ сіз өз арманыңыздан бас тарта алмайсыз.
Dialogue: 0,0:11:42.86,0:11:45.20,Default,,0,0,0,,Әрине, адамдардың көпшілігі ➨
Dialogue: 0,0:11:45.20,0:11:48.54,Default,,0,0,0,,Бір күні, бір жерде, бас тартуға тура келетін уақыт келеді.
Dialogue: 0,0:11:48.54,0:11:54.21,Default,,0,0,0,,Сонда да мен істей алатын жалғыз нәрсе - өзімнен басқа біреуден бас тартуға мәжбүрлеу➨
Dialogue: 0,0:11:54.21,0:11:57.05,Default,,0,0,0,,Менің ойымша, бұлай болуы керек емес.
Dialogue: 0,0:11:57.05,0:12:02.32,Default,,0,0,0,,Мен сенің бұлай айтқаныңды қаламаймын.
Dialogue: 0,0:12:02.32,0:12:04.65,Default,,0,0,0,,Ах...!
Dialogue: 0,0:12:04.65,0:12:07.32,Default,,0,0,0,,Ертең айтатын менмін, апа.
Dialogue: 0,0:12:07.32,0:12:11.33,Default,,0,0,0,,Ха! кешіріңіз.
Dialogue: 0,0:12:11.33,0:12:15.00,Default,,0,0,0,,Мен ең нашармын...
Dialogue: 0,0:12:15.00,0:12:19.50,Default,,0,0,0,,Мен сіз сияқты көбірек істей аламын деп ойладым...
Dialogue: 0,0:12:27.18,0:12:31.68,Default,,0,0,0,,Негізі сен маған сенген кезде➨
Dialogue: 0,0:12:31.68,0:12:35.52,Default,,0,0,0,,Еркін өмірді аңсағаныңды айтқан кезде➨
Dialogue: 0,0:12:35.52,0:12:38.02,Default,,0,0,0,,Мен шынымен бақытты болдым.
Dialogue: 0,0:12:38.02,0:12:42.69,Default,,0,0,0,,Менің идеалыма біраз жақындадым...
Dialogue: 0,0:12:42.69,0:12:46.53,Default,,0,0,0,,Бірақ одан да қиын жағдайдан➨
Dialogue: 0,0:12:46.53,0:12:49.20,Default,,0,0,0,,Дұрыс қалпына келген сізге➨
Dialogue: 0,0:12:49.20,0:12:53.20,Default,,0,0,0,,Мен енді кім екенімді саған көрсете алмаймын.
Dialogue: 0,0:12:53.20,0:12:56.54,Default,,0,0,0,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,0:12:56.54,0:13:01.98,Default,,0,0,0,,Сондықтан ертең менің әпкем...
Dialogue: 0,0:13:01.98,0:13:05.31,Default,,0,0,0,,《Күн батқандай жел соғады.
Dialogue: 0,0:13:05.31,0:13:09.98,Default,,0,0,0,,Сіз мені өткен кешегі күнге қайтаруға тырысасыз ба?
Dialogue: 0,0:13:09.98,0:13:15.09,Default,,0,0,0,,Жел соғады, ертеңге қарай ма білмеймін...
Dialogue: 0,0:13:18.66,0:13:20.83,Default,,0,0,0,,Сондықтан.
Dialogue: 0,0:13:20.83,0:13:23.50,Default,,0,0,0,,Сізбен қоштасатын кез келді.
Dialogue: 0,0:13:23.50,0:13:26.50,Default,,0,0,0,,Ертең, әпке...
Dialogue: 0,0:13:26.50,0:13:40.85,Default,,0,0,0,,♬～
Dialogue: 0,0:13:40.85,0:13:44.02,Default,,0,0,0,,Бірге өткізген уақытты ешқашан ұмытпаймын.
Dialogue: 0,0:13:44.02,0:13:47.02,Default,,0,0,0,,Біз мұнда не туралы айттық➨
Dialogue: 0,0:13:47.02,0:13:49.69,Default,,0,0,0,,Сонымен бірге біз бірге тыңдаған музыка.
Dialogue: 0,0:13:49.69,0:13:52.53,Default,,0,0,0,,Бірінші және соңғы дата.
Dialogue: 0,0:13:52.53,0:13:58.70,Default,,0,0,0,,Тамаша кішкентай баламен өткен жастық шағымнан естелік➨
Dialogue: 0,0:13:58.70,0:14:03.81,Default,,0,0,0,,Мен оны альбомда мәңгі сақтаймын.
Dialogue: 0,0:14:03.81,0:14:14.82,Default,,0,0,0,,♬～
Dialogue: 0,0:14:14.82,0:14:18.52,Default,,0,0,0,,Ақымақ болма...
Dialogue: 0,0:14:26.16,0:14:31.67,Default,,0,0,0,,Эй, балалар, сендерде бүлікшіл кезең болды ма?
Dialogue: 0,0:14:31.67,0:14:35.67,Default,,0,0,0,,Жоқ. Шығын көрсеткіштері нашар. Саған ұқсайды.
Dialogue: 0,0:14:35.67,0:14:39.67,Default,,0,0,0,,Сол үшін бе, күні бойы күңіреніп жүрдің бе?
Dialogue: 0,0:14:39.67,0:14:43.34,Default,,0,0,0,,Ата-аналардың көпшілігі үшін➨
Dialogue: 0,0:14:43.34,0:14:46.68,Default,,0,0,0,,Біз әрқашан қиын балалар боламыз.
Dialogue: 0,0:14:46.68,0:14:49.52,Default,,0,0,0,,Мен ештеңемен дауласа алмаймын.
Dialogue: 0,0:14:49.52,0:14:52.19,Default,,0,0,0,,Ата-ананың сөзіне мән бермеу және үйден кету➨
Dialogue: 0,0:14:52.19,0:14:55.52,Default,,0,0,0,,Өзіңізді қалай сезіндіңіз? Күткендей➨
Dialogue: 0,0:14:55.52,0:14:59.53,Default,,0,0,0,,Менің сезімімді түсінетін сияқтысыз ба?
Dialogue: 0,0:14:59.53,0:15:02.13,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:02.13,0:15:05.30,Default,,0,0,0,,Тіпті үлкендер дұрыс жауапты әп-сәтте көрсе де ➨
Dialogue: 0,0:15:05.30,0:15:09.47,Default,,0,0,0,,Сондықтан уайымдаймыз, қинаймыз.
Dialogue: 0,0:15:09.47,0:15:11.47,Default,,0,0,0,,Бұл процесті өткізіп жіберу➨
Dialogue: 0,0:15:11.47,0:15:14.81,Default,,0,0,0,,Мен тек дұрыс жауаптың мені мәжбүрлегенін қаламаймын...
Dialogue: 0,0:15:14.81,0:15:18.31,Default,,0,0,0,,《Ересектер үшін біз өткенбіз➨
Dialogue: 0,0:15:18.31,0:15:22.48,Default,,0,0,0,,Біз үшін бұл қазіргі және болашақ.
Dialogue: 0,0:15:22.48,0:15:25.32,Default,,0,0,0,,Бұл нәтиже теориясы, бірақ оны осылай жасаңыз➨
Dialogue: 0,0:15:25.32,0:15:28.16,Default,,0,0,0,,Мен қазір тұрған жердемін, өйткені мен өзіммен бетпе-бет келдім➨
Dialogue: 0,0:15:28.16,0:15:31.99,Default,,0,0,0,,Қандай таңдау жасасаңыз да, тек сіздің шешіміңіз➨
Dialogue: 0,0:15:31.99,0:15:35.50,Default,,0,0,0,,Бұл менің болашақ өзімді жасайды деп айта аласыз...
Dialogue: 0,0:15:35.50,0:15:38.17,Default,,0,0,0,,Жаңа ғана лақтырылып, жабық ➨ болып кетсем де
Dialogue: 0,0:15:38.17,0:15:40.50,Default,,0,0,0,,Сіз үлкен философиямен ояндыңыз.
Dialogue: 0,0:15:40.50,0:15:45.34,Default,,0,0,0,,Олай айтпа. Хахахаха….
Dialogue: 0,0:15:45.34,0:15:49.01,Default,,0,0,0,,Мен сендерге қарағанда әлдеқайда шебер және ақылдымын➨
Dialogue: 0,0:15:49.01,0:15:51.35,Default,,0,0,0,,Сызықты ерте сызыңыз.
Dialogue: 0,0:15:51.35,0:15:54.35,Default,,0,0,0,,Мен кәсіпқой бола алмайтын шығармын, міне, ➨
Dialogue: 0,0:15:54.35,0:15:58.19,Default,,0,0,0,,Маған шын ғашық болсаң да, сен оны түсінбейтін шығарсың, мінекей.
Dialogue: 0,0:15:58.19,0:16:01.46,Default,,0,0,0,,Сондықтан мен зардап шекпеймін, адаспаймын.
Dialogue: 0,0:16:01.46,0:16:04.79,Default,,0,0,0,,Мен жоғары тәуекел мен жоғары табысты көтере алмаймын➨
Dialogue: 0,0:16:04.79,0:16:07.96,Default,,0,0,0,,Қолжетімді төмен тәуекелді төмен табысты таңдаңыз.
Dialogue: 0,0:16:07.96,0:16:09.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:09.96,0:16:13.80,Default,,0,0,0,,《Саку: Мен бұл адамның қауіптілігі жоғары студент екеніне сенімдімін➨
Dialogue: 0,0:16:13.80,0:16:16.14,Default,,0,0,0,,Сіз көп нәрсені көрген болуыңыз керек...》
Dialogue: 0,0:16:16.14,0:16:19.97,Default,,0,0,0,,Бір қызығы, әлемде үлкен тәуекелге баруға дайын адамдар бар➨
Dialogue: 0,0:16:19.97,0:16:23.78,Default,,0,0,0,,Әрқашан жоғары табыс алатын адамдар бар...
Dialogue: 0,0:16:35.49,0:16:37.49,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:16:39.99,0:16:42.50,Default,,0,0,0,,Йо. Оу.
Dialogue: 0,0:16:42.50,0:16:46.33,Default,,0,0,0,,Сонымен мұнда не үшін келдің? Менің мұны істегенімді қалайсыз ба?
Dialogue: 0,0:16:46.33,0:16:49.34,Default,,0,0,0,,Неліктен оның салдары бар сияқты естіледі?
Dialogue: 0,0:16:49.34,0:16:52.17,Default,,0,0,0,,Мен кешкі асты бірге ішу керек деп ойладым.
Dialogue: 0,0:16:52.17,0:16:55.84,Default,,0,0,0,,Бұл өте еркектік таңдау.
Dialogue: 0,0:16:55.84,0:16:58.68,Default,,0,0,0,,Басқа әйелдің белгісі бар ма?➨
Dialogue: 0,0:16:58.68,0:17:02.95,Default,,0,0,0,,Мен оны тексеру керек деп ойладым. Сенің де көлеңкең жоқ.
Dialogue: 0,0:17:02.95,0:17:06.45,Default,,0,0,0,,Итадакимасу.
Dialogue: 0,0:17:06.45,0:17:08.79,Default,,0,0,0,,Хитоза мисо сорпасы Ммм!
Dialogue: 0,0:17:08.79,0:17:13.46,Default,,0,0,0,,Екеуміз бірге тұрсақ, тамақ пісіруді қоятын шығармын, бұл жаман.
Dialogue: 0,0:17:13.46,0:17:17.47,Default,,0,0,0,,Менің ойымша, оның қатесі сіз айтып отырған алғышарттар.
Dialogue: 0,0:17:17.47,0:17:21.47,Default,,0,0,0,,Ойланып көрші, Хитоза, сен қандай мансап жолын таңдайтыныңды шештің бе?
Dialogue: 0,0:17:21.47,0:17:26.47,Default,,0,0,0,,Шынымды айтсам, мен ештеңе ойлаған жоқпын. Бейсбол ойнап жүрген кезім➨
Dialogue: 0,0:17:26.47,0:17:29.64,Default,,0,0,0,,«Кошиенге ұмтыл!» Мен ойлағанның бәрі болды➨
Dialogue: 0,0:17:29.64,0:17:33.15,Default,,0,0,0,,Жақсылық жасасам, маған кәсіби мамандар келе ме деп ойлаймын➨
Dialogue: 0,0:17:33.15,0:17:36.98,Default,,0,0,0,,Соқыр ойладым. Мен түсінемін.
Dialogue: 0,0:17:36.98,0:17:41.32,Default,,0,0,0,,Менің ойымша, біз әлі жазғы демалыстамыз. Жақсы.
Dialogue: 0,0:17:41.32,0:17:44.66,Default,,0,0,0,,《Саку: Бейсбол менің өмірімнен жоғалып кеткен кезде➨
Dialogue: 0,0:17:44.66,0:17:48.83,Default,,0,0,0,,Мен енді қалай жүремін деп ойлаймын➨
Dialogue: 0,0:17:48.83,0:17:52.00,Default,,0,0,0,,Мен оны енді елестете алмайтын сияқтымын.
Dialogue: 0,0:17:52.00,0:17:54.34,Default,,0,0,0,,Сондықтан мен ертең апама барамын➨
Dialogue: 0,0:17:54.34,0:17:57.67,Default,,0,0,0,,Мен жағдайдың бұлай болғанын қаламаймын...》
Dialogue: 0,0:17:57.67,0:18:00.27,Default,,0,0,0,,Сіз префектурадан тыс жерде екеніңізді айттыңыз.
Dialogue: 0,0:18:00.27,0:18:03.44,Default,,0,0,0,,Иә. Колледж студенттері кезінде➨
Dialogue: 0,0:18:03.44,0:18:06.28,Default,,0,0,0,,Мен жалғыз және еркін өмір сүргім келеді➨
Dialogue: 0,0:18:06.28,0:18:08.62,Default,,0,0,0,,Мұндай жалпы себеп.
Dialogue: 0,0:18:08.62,0:18:11.95,Default,,0,0,0,,Мен көремін. Негізі бұл жеткілікті ➨
Dialogue: 0,0:18:11.95,0:18:14.29,Default,,0,0,0,,Сіздің мансап жолыңыз қандай?
Dialogue: 0,0:18:14.29,0:18:16.79,Default,,0,0,0,,Әй, қызықсыз деп отырғаным жоқ.
Dialogue: 0,0:18:16.79,0:18:19.29,Default,,0,0,0,,Мен білемін. Содан кейін➨
Dialogue: 0,0:18:19.29,0:18:23.80,Default,,0,0,0,,Менің ойымша, соңғы кездері көңілім күйзелу себебі күткендей шығар.
Dialogue: 0,0:18:29.14,0:18:31.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:33.31,0:18:35.31,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:37.31,0:18:39.48,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:39.48,0:18:43.99,Default,,0,0,0,,Эй, кел. Иә...?
Dialogue: 0,0:18:52.66,0:18:54.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:54.83,0:19:09.34,Default,,0,0,0,,♬～
Dialogue: 0,0:19:11.61,0:19:13.61,Default,,0,0,0,,Сәлем! Енді түкіріңіз.
Dialogue: 0,0:19:13.61,0:19:17.12,Default,,0,0,0,,Не! ? Дәл қазір Читозаны алаңдатып отырғаны осы.
Dialogue: 0,0:19:17.12,0:19:20.62,Default,,0,0,0,,Мен... Сізден бірдеңе сұрасам болады ма? иә?
Dialogue: 0,0:19:20.62,0:19:24.33,Default,,0,0,0,,Осы уақытқа дейін қандай мағыналы ағын бар?
Dialogue: 0,0:19:27.29,0:19:31.97,Default,,0,0,0,,Құпия ашайын десем, қараңғы болса жақсы болар деп ойладым.
Dialogue: 0,0:19:31.97,0:19:35.80,Default,,0,0,0,,Мен сені итеріп жіберемін. (Юзуки) Жоқ.
Dialogue: 0,0:19:35.80,0:19:38.81,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:38.81,0:19:43.64,Default,,0,0,0,,Көрдіңіз бе, Хитоза сіз ойлағаннан да ақымақ.
Dialogue: 0,0:19:43.64,0:19:46.65,Default,,0,0,0,,Иә? Мен ойлағаннан да көп қорландым! ?
Dialogue: 0,0:19:46.65,0:19:50.15,Default,,0,0,0,,Өзін ақылды етіп көрсетіп, күрделі ойлаудың нәтижесі➨
Dialogue: 0,0:19:50.15,0:19:53.49,Default,,0,0,0,,Процесті өткізіп жіберіп, ақымақтық жасаңыз.
Dialogue: 0,0:19:53.49,0:19:59.66,Default,,0,0,0,,Басынан бастап жасай алатын бір ғана нәрсе бар.
Dialogue: 0,0:19:59.66,0:20:01.66,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:01.66,0:20:05.33,Default,,0,0,0,,Жолыңызда тұрған қабырғаны алдыңғы жақтан күшпен соғыңыз.
Dialogue: 0,0:20:05.33,0:20:07.33,Default,,0,0,0,,Оны жойыңыз.
Dialogue: 0,0:20:07.33,0:20:11.04,Default,,0,0,0,,Бұл ер адам! Бұл Читосе Саку. Ах...
Dialogue: 0,0:20:15.18,0:20:19.01,Default,,0,0,0,,Әйтпесе мен сені дәл қазір итеріп, жеймін.
Dialogue: 0,0:20:19.01,0:20:21.02,Default,,0,0,0,,Сіз жыртқышсыз ба?
Dialogue: 0,0:20:24.19,0:20:27.52,Default,,0,0,0,,Рахмет, Нанасе.
Dialogue: 0,0:20:27.52,0:20:30.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:34.20,0:20:37.87,Default,,0,0,0,,《Сәку: Қанша алыс жүрсек те баламыз.
Dialogue: 0,0:20:37.87,0:20:42.67,Default,,0,0,0,,Ондай жағдайда мен бала сияқты әрекет етуге тырысамын...》
Dialogue: 0,0:20:45.54,0:20:50.64,Default,,0,0,0,,《Юзуки: Ааа. Қиын жауға тұз жібердім бе деп...》
Dialogue: 0,0:20:53.38,0:20:56.38,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:20:59.99,0:21:02.49,Default,,0,0,0,,(Терезеге соғылған тастардың дыбысы)
Dialogue: 0,0:21:11.00,0:21:13.00,Default,,0,0,0,,Хмм….
Dialogue: 0,0:21:13.00,0:21:17.17,Default,,0,0,0,,♬ (Сәку) «Жаңа таң атты» А? Эй!
Dialogue: 0,0:21:17.17,0:21:21.51,Default,,0,0,0,,♬ «Кибоу жоқ Асада»
Dialogue: 0,0:21:21.51,0:21:25.68,Default,,0,0,0,,♬ «Жүрегіңді қуанышқа аш»
Dialogue: 0,0:21:25.68,0:21:30.18,Default,,0,0,0,,♬ «Оозора Аогэ»
Dialogue: 0,0:21:30.18,0:21:32.85,Default,,0,0,0,,Не...жағдай қандай?
Dialogue: 0,0:21:32.85,0:21:34.86,Default,,0,0,0,,Сіз мұны бір кезде айтқансыз, солай ма?
Dialogue: 0,0:21:34.86,0:21:37.19,Default,,0,0,0,,Ертең әпкеңді кездесуге шақырғанда➨
Dialogue: 0,0:21:37.19,0:21:40.86,Default,,0,0,0,,Ол терезенің сыртында ``Radio Exercise Song'' әнін айтып жатқанын айтты.
Dialogue: 0,0:21:40.86,0:21:44.37,Default,,0,0,0,,Бірақ мен саған өткен күні айттым...
Dialogue: 0,0:21:44.37,0:21:48.54,Default,,0,0,0,,Өкінішке орай, менің өмірімде осы уақытқа дейін қыздардың "қоштасуы" ➨ болды.
Dialogue: 0,0:21:48.54,0:21:51.37,Default,,0,0,0,,«Қуып кету» дегенді білдіретінін білдім.
Dialogue: 0,0:21:51.37,0:21:55.88,Default,,0,0,0,,《Сәку: Ол кезде ертең әпкем шашын сол құлағының артына қойып жатқан еді➨
Dialogue: 0,0:21:55.88,0:21:58.38,Default,,0,0,0,,Себебі мен "қош бол" дедім》
Dialogue: 0,0:21:58.38,0:22:01.32,Default,,0,0,0,,Ертең әпкеммен қашайық!
Dialogue: 0,0:22:01.32,0:22:04.82,Default,,0,0,0,,Мен сені ұрлауға келдім!
Dialogue: 0,0:22:04.82,0:22:08.66,Default,,0,0,0,,Ах...!
Dialogue: 0,0:22:08.66,0:22:12.66,Default,,0,0,0,,30 минут! Және, мүмкін, сәл көбірек!
Dialogue: 0,0:22:12.66,0:22:15.56,Default,,0,0,0,,Мені ана жақтағы саябақта күт!
Dialogue: 0,0:22:25.67,0:22:27.84,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:27.84,0:22:29.84,Default,,0,0,0,,Сіз.
Dialogue: 0,0:22:29.84,0:22:34.85,Default,,0,0,0,,Сіз! Хмм...
Dialogue: 0,0:22:34.85,0:22:37.02,Default,,0,0,0,,Ертең әпке.
Dialogue: 0,0:22:37.02,0:22:39.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:39.02,0:22:41.36,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:22:41.36,0:22:44.69,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:22:44.69,0:22:48.20,Default,,0,0,0,,Бұл сізге өте жарасады. Тым көп пе?
Dialogue: 0,0:22:48.20,0:22:51.20,Default,,0,0,0,,Көңілім толқымай тұра алмадым...
Dialogue: 0,0:22:51.20,0:22:53.37,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:22:53.37,0:22:56.87,Default,,0,0,0,,Керемет, баланың арманынан шыққан нәрсе сияқты.
Dialogue: 0,0:22:56.87,0:23:00.98,Default,,0,0,0,,Шынымен бе? Егер сізде ұйықтау әдеті болмаса, бұл тамаша болар еді.
Dialogue: 0,0:23:00.98,0:23:04.65,Default,,0,0,0,,Өтірік! ? Жоқ, мен оны дұрыс түзеттім!
Dialogue: 0,0:23:04.65,0:23:08.65,Default,,0,0,0,,Бұл өтірік. Уф! ? қазірдің өзінде!
Dialogue: 0,0:23:08.65,0:23:18.33,Default,,0,0,0,,♬～
Dialogue: 0,0:23:18.33,0:23:27.67,Default,,0,0,0,,♬～
Dialogue: 0,0:23:27.67,0:23:33.17,Default,,0,0,0,,Мені ұрлайсың ба?
Dialogue: 0,0:23:33.17,0:23:35.18,Default,,0,0,0,,Иә.
Dialogue: 0,0:23:36.68,0:23:42.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory