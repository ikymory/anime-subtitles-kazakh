Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.54,0:00:06.54,Default,,0,0,0,,♪~
Dialogue: 0,0:01:07.85,0:01:09.73,Default,,0,0,0,,Мен сандарға сенемін!
Dialogue: 0,0:01:10.11,0:01:11.44,Default,,0,0,0,,О-о-о~! Жамылғыға ұқсайды.
Dialogue: 0,0:01:11.61,0:01:13.11,Default,,0,0,0,,Бұл доллар ма?
Dialogue: 0,0:01:13.23,0:01:15.95,Default,,0,0,0,,Бұл не? Осы жігіттердің бәрі?
Dialogue: 0,0:01:16.15,0:01:18.24,Default,,0,0,0,,Мысалы, жай ғана маған үйлен.
Dialogue: 0,0:01:18.70,0:01:21.99,Default,,0,0,0,,Сіз сондай-ақ «бұл» туралы құпияны сақтайсыз.
Dialogue: 0,0:01:22.29,0:01:23.12,Default,,0,0,0,,Келти
Dialogue: 0,0:01:23.33,0:01:25.75,Default,,0,0,0,,Бұл мен күткеннен де қызық болды.
Dialogue: 0,0:01:25.87,0:01:27.17,Default,,0,0,0,,Мен айқайлап жатырмын
Dialogue: 0,0:01:27.29,0:01:29.00,Default,,0,0,0,,Мен қазір осында тудым!
Dialogue: 0,0:01:30.21,0:01:32.67,Default,,0,0,0,,Селтиге оралыңыз!
Dialogue: 0,0:01:48.48,0:01:54.48,Default,,0,0,0,,~♪
Dialogue: 0,0:02:05.83,0:02:08.04,Default,,0,0,0,,Мен сізге алғыс айтуым керек.
Dialogue: 0,0:02:08.16,0:02:09.41,Default,,0,0,0,,Егер сіз болмасаңыз...
Dialogue: 0,0:02:09.50,0:02:14.00,Default,,0,0,0,,Әпке оны тағы да шағын зертханаға қамап қоятын еді.
Dialogue: 0,0:02:14.34,0:02:15.42,Default,,0,0,0,,Ягири-кун
Dialogue: 0,0:02:17.63,0:02:18.30,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:02:18.84,0:02:20.55,Default,,0,0,0,,Селтиді бәрібір қайтар.
Dialogue: 0,0:02:20.84,0:02:23.72,Default,,0,0,0,,Полицейлер келгенше қызыммен қашуым керек.
Dialogue: 0,0:02:24.43,0:02:25.89,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:02:26.02,0:02:27.56,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:02:27.68,0:02:31.23,Default,,0,0,0,,Мен оны бала кезімнен бақылап келемін.
Dialogue: 0,0:02:31.81,0:02:33.36,Default,,0,0,0,,Мен сені босатқым келді.
Dialogue: 0,0:02:33.48,0:02:35.73,Default,,0,0,0,,Кең дүние сені азат етсін.
Dialogue: 0,0:02:35.98,0:02:38.24,Default,,0,0,0,,Мен де сол жерде тұрамын.
Dialogue: 0,0:02:38.61,0:02:39.99,Default,,0,0,0,,Бар болғаны...
Dialogue: 0,0:02:40.07,0:02:43.70,Default,,0,0,0,,Әрқашан, әрқашан, әрқашан, әрқашан, әрқашан, әрқашан ойлау
Dialogue: 0,0:02:44.70,0:02:48.91,Default,,0,0,0,,Жоқ, махаббаттың күшін ешкім тоқтата алмайды, солай ма?
Dialogue: 0,0:02:49.04,0:02:51.37,Default,,0,0,0,,Сіз не қайтарасыз?
Dialogue: 0,0:02:51.62,0:02:54.59,Default,,0,0,0,,Бұрынғы және қазіргі сандарға ғана сүйену
Dialogue: 0,0:02:57.34,0:02:59.55,Default,,0,0,0,,Менің махаббатым бұл деңгейде бұзылмайды
Dialogue: 0,0:03:02.72,0:03:05.47,Default,,0,0,0,,Бұл жұмыс істемейді. Ауырды бірақ ұмытамын.
Dialogue: 0,0:03:05.56,0:03:07.93,Default,,0,0,0,,Ауырсыну маған және Селтидің өміріне қажет емес.
Dialogue: 0,0:03:08.14,0:03:11.23,Default,,0,0,0,,Сондықтан мен дәл қазір және осы жерде сезінетін ауырсынуды сезбеймін.
Dialogue: 0,0:03:11.35,0:03:12.23,Default,,0,0,0,,Бұл әлі менімен толық бірікпегенінің дәлелі.
Dialogue: 0,0:03:21.70,0:03:23.20,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:26.66,0:03:27.62,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:27.74,0:03:31.54,Default,,0,0,0,,Сэйджи-сан қатал және дөрекі, ол басқа адамдардан ерекше...
Dialogue: 0,0:03:31.62,0:03:32.75,Default,,0,0,0,,Мен жаман адам емеспін.
Dialogue: 0,0:03:33.25,0:03:35.46,Default,,0,0,0,,Бірақ бұл адам әлдеқашан біреуді ұнатады...
Dialogue: 0,0:03:35.59,0:03:36.75,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:37.21,0:03:39.76,Default,,0,0,0,,Жоқ... мүмкін емес
Dialogue: 0,0:03:40.17,0:03:41.76,Default,,0,0,0,,Жоқ, бұл бала...
Dialogue: 0,0:03:43.72,0:03:46.26,Default,,0,0,0,,Бұл менің мойным емес
Dialogue: 0,0:03:46.39,0:03:49.10,Default,,0,0,0,,Бұл бала... Бұл баланың аты...
Dialogue: 0,0:03:50.27,0:03:52.23,Default,,0,0,0,,Харима... Мика-сан?
Dialogue: 0,0:03:53.19,0:03:54.35,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:54.60,0:03:59.11,Default,,0,0,0,,Сіз Ягири-кун өлтіруі тиіс Мика Харимасыз ба?
Dialogue: 0,0:04:01.11,0:04:02.20,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:04:03.95,0:04:04.49,Default,,0,0,0,,Эй
Dialogue: 0,0:04:05.95,0:04:06.57,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:04:08.08,0:04:08.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:09.79,0:04:12.00,Default,,0,0,0,,Эй, сенің барыңа сенімдімін, Сейджи-сан.
Dialogue: 0,0:04:12.12,0:04:13.62,Default,,0,0,0,,Мен де бүгін келдім.
Dialogue: 0,0:04:13.75,0:04:16.38,Default,,0,0,0,,Қатты! Мен есікті ашуды ұмытып кетіппін
Dialogue: 0,0:04:16.46,0:04:18.04,Default,,0,0,0,,Бұл мені кіргізбейді.
Dialogue: 0,0:04:18.13,0:04:19.96,Default,,0,0,0,,Сіз ұйықтап жатқан шығарсыз?
Dialogue: 0,0:04:20.96,0:04:21.97,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:04:22.47,0:04:25.80,Default,,0,0,0,,Емтихан кезінде мен Сейджи-санның қасында отырдым.
Dialogue: 0,0:04:26.89,0:04:30.39,Default,,0,0,0,,Оң жақта отырған қыздың Рюгамин деген тамаша фамилиясы бар еді.
Dialogue: 0,0:04:30.47,0:04:33.60,Default,,0,0,0,,Сол жағымдағы адамның аты кім екен деп ойладым...
Dialogue: 0,0:04:33.69,0:04:35.65,Default,,0,0,0,,Жалт қарасам, бір көргеннен махаббат екен.
Dialogue: 0,0:04:36.10,0:04:38.44,Default,,0,0,0,,Менің көзіме түскен Сейджи-сан да күлді.
Dialogue: 0,0:04:41.15,0:04:43.49,Default,,0,0,0,,Сонымен Сейджи-сан, маған бетіңді көрсетші.
Dialogue: 0,0:04:43.57,0:04:45.15,Default,,0,0,0,,Өтінемін, өтінемін
Dialogue: 0,0:04:45.28,0:04:47.20,Default,,0,0,0,,Сіз өзіңізді жақсы сезінбей жүрсіз бе?
Dialogue: 0,0:04:47.32,0:04:48.66,Default,,0,0,0,,Сол себепті кете алмайсың ба?
Dialogue: 0,0:04:48.78,0:04:50.33,Default,,0,0,0,,Олай болса мен саған ашамын.
Dialogue: 0,0:04:50.45,0:04:52.62,Default,,0,0,0,,Қазір күтіңіз.
Dialogue: 0,0:04:55.16,0:04:58.21,Default,,0,0,0,,Емтихан тапсырған күннен бастап көп іздендім.
Dialogue: 0,0:04:58.63,0:05:01.00,Default,,0,0,0,,Сейджидің туған күні және отбасы
Dialogue: 0,0:05:12.68,0:05:14.48,Default,,0,0,0,,Сэйдзи-сан
Dialogue: 0,0:05:16.02,0:05:17.77,Default,,0,0,0,,Көрдіңіз бе? (Мика) Мм... мм...
Dialogue: 0,0:05:17.85,0:05:21.27,Default,,0,0,0,,Мен... жарайды, мен ешкімге айтпаймын.
Dialogue: 0,0:05:21.36,0:05:23.61,Default,,0,0,0,,Мм... ммм... жарайды.
Dialogue: 0,0:05:24.03,0:05:26.53,Default,,0,0,0,,Сіздің хоббиіңіз қандай болса да, мен оны сізге сәйкестендіремін.
Dialogue: 0,0:05:26.65,0:05:28.49,Default,,0,0,0,,Мм... сондықтан...
Dialogue: 0,0:05:28.57,0:05:29.20,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:05:29.70,0:05:30.91,Default,,0,0,0,,Mr. Seiji
Dialogue: 0,0:05:32.29,0:05:33.04,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:05:33.70,0:05:35.87,Default,,0,0,0,,Сейдзи...?
Dialogue: 0,0:05:35.96,0:05:36.91,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:05:38.96,0:05:39.88,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:05:40.38,0:05:43.88,Default,,0,0,0,,Кешіріңіз! Мен әлі өлмеген едім.
Dialogue: 0,0:05:43.96,0:05:45.92,Default,,0,0,0,,Сосын Сейджидің үлкен әпкесі...
Dialogue: 0,0:05:47.34,0:05:49.39,Default,,0,0,0,,Сейджи сізге ғашық болғанын қалайсыз ба?
Dialogue: 0,0:05:51.55,0:05:52.26,Default,,0,0,0,,Жақсы қыз.
Dialogue: 0,0:05:52.72,0:05:55.52,Default,,0,0,0,,Сол кезде дәрігер келді...
Dialogue: 0,0:05:55.60,0:05:57.73,Default,,0,0,0,,Кішкене пластикалық ота жасатып, макияж жасасаңыз...
Dialogue: 0,0:05:57.81,0:06:00.02,Default,,0,0,0,,Сол мойын мен Сейджидің сүйікті мойны...
Dialogue: 0,0:06:00.10,0:06:01.27,Default,,0,0,0,,Олар бір-біріне дәл ұқсайды
Dialogue: 0,0:06:01.73,0:06:05.78,Default,,0,0,0,,«Сенің атың Селти, бұл сенің мойныңдағы есім».
Dialogue: 0,0:06:06.36,0:06:09.28,Default,,0,0,0,,Сондықтан мен Сейджи-сан үшін Селти болуға тырыстым.
Dialogue: 0,0:06:09.66,0:06:11.87,Default,,0,0,0,,Бірақ Нами мырза мұның тым жайбарақат екенін айтады.
Dialogue: 0,0:06:11.95,0:06:13.41,Default,,0,0,0,,Жақында білемін...
Dialogue: 0,0:06:13.49,0:06:17.08,Default,,0,0,0,,Эмоциялар мен естеліктерімді өшіру үшін операция немесе дәрі.
Dialogue: 0,0:06:17.37,0:06:19.71,Default,,0,0,0,,Менің атымды кім біледі
Dialogue: 0,0:06:20.33,0:06:23.09,Default,,0,0,0,,Менің Дуллахан екенімді білетін дәрігер
Dialogue: 0,0:06:24.05,0:06:27.63,Default,,0,0,0,,Бұл қалада мұндай адам бір ғана.
Dialogue: 0,0:06:28.42,0:06:30.09,Default,,0,0,0,,Себебі мен Сейджи-санмен бірге болғым келді
Dialogue: 0,0:06:30.18,0:06:31.30,Default,,0,0,0,,Сондықтан мен көп еңбек еттім!
Dialogue: 0,0:06:37.18,0:06:39.23,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:06:39.56,0:06:40.73,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:06:40.81,0:06:44.98,Default,,0,0,0,,Шынайы мен жалғанның аражігін ажырата алмадың.
Dialogue: 0,0:06:45.36,0:06:49.40,Default,,0,0,0,,Сенің махаббатыңның ауқымы осында. Ерен еңбегіңіз үшін рахмет.
Dialogue: 0,0:06:51.78,0:06:52.78,Default,,0,0,0,,Mr. Seiji
Dialogue: 0,0:06:54.03,0:06:57.70,Default,,0,0,0,,Сіз оны қайтару үшін өз өміріңізді қатерге тіктіңіз...
Dialogue: 0,0:06:57.79,0:06:59.12,Default,,0,0,0,,Менің ойымша, бұл керемет
Dialogue: 0,0:06:59.66,0:07:02.58,Default,,0,0,0,,Мен Харима мырзаны дұрыс түсінбедім.
Dialogue: 0,0:07:02.96,0:07:05.50,Default,,0,0,0,,Оның мінезінде ақау бар екені рас, бірақ...
Dialogue: 0,0:07:05.88,0:07:07.88,Default,,0,0,0,,Мен аңдыушы емеспін.
Dialogue: 0,0:07:08.13,0:07:11.26,Default,,0,0,0,,Өйткені сен Ягири-кун үшін өз өміріңді қатерге тіктің.
Dialogue: 0,0:07:11.34,0:07:15.35,Default,,0,0,0,,Менің ойымша, бұл сіздің өзімшілдік қалауыңыздың арқасында жасай алмайтын нәрсе.
Dialogue: 0,0:07:15.76,0:07:19.06,Default,,0,0,0,,Сізді өлтіре жаздаған адамды әлі де жақсы көруіңіз ғажап деп ойлаймын.
Dialogue: 0,0:07:19.14,0:07:20.39,Default,,0,0,0,,Көптеген жолдармен
Dialogue: 0,0:07:20.69,0:07:23.65,Default,,0,0,0,,Харима-сан мен Ягири-кун өте...
Dialogue: 0,0:07:23.81,0:07:25.27,Default,,0,0,0,,Менің ойымша, олар ұқсас.
Dialogue: 0,0:07:26.98,0:07:27.69,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:07:30.36,0:07:31.36,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:07:36.24,0:07:38.37,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:07:39.50,0:07:41.50,Default,,0,0,0,,Әрі қарай не айтқыңыз келеді?
Dialogue: 0,0:07:41.87,0:07:46.21,Default,,0,0,0,,«Сіз менің басымның сол зертханада екенін білдіңіз».
Dialogue: 0,0:07:46.42,0:07:50.92,Default,,0,0,0,,«Әкеңіз екеуіңіз Yagiri Pharmaceuticals компаниясымен басынан бері ынтымақтасасыздар.»
Dialogue: 0,0:07:51.01,0:07:54.64,Default,,0,0,0,,«Менің басымды алған әкең шығар?»
Dialogue: 0,0:07:55.14,0:07:57.72,Default,,0,0,0,,«Бірақ сен оны менен жасырасың...»
Dialogue: 0,0:07:57.85,0:08:00.73,Default,,0,0,0,,«Өлім алдында тұрған әйелдің бетін рұқсатсыз кесу».
Dialogue: 0,0:08:01.02,0:08:02.48,Default,,0,0,0,,«Мен де құбыжықпын, бірақ...»
Dialogue: 0,0:08:02.60,0:08:05.52,Default,,0,0,0,,«Сіз адамдарды шын мағынасында жейтін құбыжықсыз».
Dialogue: 0,0:08:05.94,0:08:06.86,Default,,0,0,0,,сияқты бір жерде ме?
Dialogue: 0,0:08:07.36,0:08:10.65,Default,,0,0,0,,Аа, түсініспеушілік болмас үшін, алдын ала айта кетейін...
Dialogue: 0,0:08:10.78,0:08:13.03,Default,,0,0,0,,Әкем сенің бетіңді ұрлады. Ол кінәлі ме деп ойлаймын...
Dialogue: 0,0:08:13.15,0:08:14.82,Default,,0,0,0,,Мен білмеймін және мені қызықтырмайды.
Dialogue: 0,0:08:15.03,0:08:17.99,Default,,0,0,0,,Бұл кішкентай пластикалық операция оның қалаған нәрсесі болды...
Dialogue: 0,0:08:18.66,0:08:21.70,Default,,0,0,0,,Мүмкін, Ягиридің адамдары оған жол көрсеткен шығар...
Dialogue: 0,0:08:22.08,0:08:23.92,Default,,0,0,0,,Бұл мен білетін нәрсе емес.
Dialogue: 0,0:08:25.83,0:08:30.09,Default,,0,0,0,,«Менің не ойлайтынымды білесің бе?»
Dialogue: 0,0:08:30.88,0:08:32.55,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:08:32.88,0:08:36.72,Default,,0,0,0,,Мен сені 20 жыл бойы сүйдім, осыны білемін.
Dialogue: 0,0:08:37.72,0:08:39.10,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:08:39.30,0:08:42.23,Default,,0,0,0,,Олай болса, осы уақытқа дейін мойынның орналасқан жері туралы неге үндемей келдің?
Dialogue: 0,0:08:43.39,0:08:44.85,Default,,0,0,0,,Өйткені сен маған ұнайсың
Dialogue: 0,0:08:45.10,0:08:47.27,Default,,0,0,0,,Сондықтан мойын қайда деп үндемедім.
Dialogue: 0,0:08:47.81,0:08:50.73,Default,,0,0,0,,Басыңды алсам, кетесің.
Dialogue: 0,0:08:51.07,0:08:52.78,Default,,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:08:53.36,0:08:56.28,Default,,0,0,0,,Мен сенің бақытың үшін бас тартамын деп айтпаймын.
Dialogue: 0,0:08:57.20,0:08:59.83,Default,,0,0,0,,Бұл сіз бен менің арамыздағы махаббат үшін шайқас.
Dialogue: 0,0:09:01.20,0:09:03.12,Default,,0,0,0,,Мен сені ешқашан жібермеймін
Dialogue: 0,0:09:03.25,0:09:07.04,Default,,0,0,0,,Ол үшін басқаларды, өлімді және өзімді жақсы көру
Dialogue: 0,0:09:07.38,0:09:11.09,Default,,0,0,0,,Қарама-қайшы болып көрінеді, бірақ мен тіпті сіздің ойларыңызды пайдаланамын.
Dialogue: 0,0:09:15.09,0:09:17.64,Default,,0,0,0,,Басымды қайтарсам да...
Dialogue: 0,0:09:17.76,0:09:19.64,Default,,0,0,0,,Егер мен сені тастап кетсем...
Dialogue: 0,0:09:20.22,0:09:23.77,Default,,0,0,0,,Бұл сіздің қалауыңыз болса да, бұл сіздің басыңыздың еркі дегенді білдірмейді.
Dialogue: 0,0:09:24.77,0:09:25.81,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:09:26.27,0:09:28.69,Default,,0,0,0,,Сен неге бұл дүниеде перісің?
Dialogue: 0,0:09:28.77,0:09:31.36,Default,,0,0,0,,Сіз адамдардың алдына көрінесіз бе?
Dialogue: 0,0:09:32.02,0:09:33.57,Default,,0,0,0,,Менің басымнан айырылғандықтан...
Dialogue: 0,0:09:33.65,0:09:37.49,Default,,0,0,0,,Осы дүниеде заттай алдың ба деп ойлаймын.
Dialogue: 0,0:09:37.99,0:09:41.74,Default,,0,0,0,,Олай болса, басын алып, естеліктеріңізді қалпына келтірген...
Dialogue: 0,0:09:41.83,0:09:44.70,Default,,0,0,0,,Осы уақытқа дейін барлығы елес болғандай...
Dialogue: 0,0:09:44.79,0:09:47.08,Default,,0,0,0,,Түтін болып ғайып бола ма?
Dialogue: 0,0:09:47.62,0:09:49.46,Default,,0,0,0,,Менің қорқатыным осы
Dialogue: 0,0:09:57.88,0:10:00.30,Default,,0,0,0,,Маған сенесің бе?
Dialogue: 0,0:10:01.60,0:10:03.26,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:10:03.60,0:10:05.81,Default,,0,0,0,,Керісінше мен саған ғана сенемін.
Dialogue: 0,0:10:06.60,0:10:08.06,Default,,0,0,0,,Мен де қорқамын
Dialogue: 0,0:10:09.10,0:10:10.81,Default,,0,0,0,,Мен өлуден қорқамын
Dialogue: 0,0:10:11.86,0:10:16.11,Default,,0,0,0,,Мен қазір мені өлтіретін ешкім жоқ екенін түсіндім.
Dialogue: 0,0:10:16.49,0:10:17.74,Default,,0,0,0,,Бұл менмендік емес
Dialogue: 0,0:10:17.82,0:10:20.49,Default,,0,0,0,,Мен мұны қарапайым факт ретінде қабылдаймын.
Dialogue: 0,0:10:20.78,0:10:23.83,Default,,0,0,0,,Онда қуаныш та, толқу да жоқ.
Dialogue: 0,0:10:24.12,0:10:24.95,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:10:25.41,0:10:27.29,Default,,0,0,0,,Жоқ, сондықтан қорқынышты
Dialogue: 0,0:10:27.83,0:10:31.88,Default,,0,0,0,,Менің ішімде «өлімді» басқаратын өзек жоқ.
Dialogue: 0,0:10:32.00,0:10:34.38,Default,,0,0,0,,Менің мойным – оның өзегі.
Dialogue: 0,0:10:34.80,0:10:36.92,Default,,0,0,0,,Біреу менің мойынымды бұзады
Dialogue: 0,0:10:37.38,0:10:38.92,Default,,0,0,0,,Ал енді мен...
Dialogue: 0,0:10:39.01,0:10:42.05,Default,,0,0,0,,Оның менің ниетіме де, жағдайыма да қатысы жоқ...
Dialogue: 0,0:10:44.72,0:10:45.68,Default,,0,0,0,,Сенесің бе?
Dialogue: 0,0:10:46.31,0:10:50.10,Default,,0,0,0,,Менің көзім жоқ, миым жоқ, қорқынышты түс көремін.
Dialogue: 0,0:10:50.19,0:10:53.48,Default,,0,0,0,,Сол түнді көріп, қорқып дірілдегенімде сенесің бе?
Dialogue: 0,0:10:53.73,0:10:54.94,Default,,0,0,0,,Өйткені бұл қорқынышты...
Dialogue: 0,0:10:55.02,0:10:57.40,Default,,0,0,0,,Өйткені мен өз өлімімді басқарғым келеді...
Dialogue: 0,0:10:57.53,0:10:59.45,Default,,0,0,0,,Басыңды сұрай бердім.
Dialogue: 0,0:11:00.20,0:11:03.37,Default,,0,0,0,,Мен мұны айтсам сенер ме едің?
Dialogue: 0,0:11:04.41,0:11:07.29,Default,,0,0,0,,Мен саған айттым, мен саған ғана сенемін.
Dialogue: 0,0:11:07.37,0:11:09.21,Default,,0,0,0,,Тұманға бес миль қалды.
Dialogue: 0,0:11:09.33,0:11:13.38,Default,,0,0,0,,Менің ойымша, біз бәріміз жай ғана болжам жасап, алданып қалдық.
Dialogue: 0,0:11:15.04,0:11:16.30,Default,,0,0,0,,Сен ақымақ сияқтысың.
Dialogue: 0,0:11:16.38,0:11:17.21,Default,,0,0,0,,Иә
Dialogue: 0,0:11:17.67,0:11:18.71,Default,,0,0,0,,Сәлем Силла
Dialogue: 0,0:11:18.80,0:11:19.63,Default,,0,0,0,,Не?
Dialogue: 0,0:11:23.22,0:11:24.10,Default,,0,0,0,,Мен сені бір рет ұрайын
Dialogue: 0,0:11:25.10,0:11:26.06,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:30.02,0:11:32.56,Default,,0,0,0,,Олай болса мен де сені бір ұрайын.
Dialogue: 0,0:11:44.74,0:11:47.41,Default,,0,0,0,,Көрдіңіз бе, Селтидің шынайы жүзі ең әдемі.
Dialogue: 0,0:11:50.16,0:11:54.25,Default,,0,0,0,,Бұл соққы ант сүйіспеншілікті алмастырады.
Dialogue: 0,0:11:55.21,0:11:56.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.09,0:12:06.43,Default,,0,0,0,,Сіз жылап жатырсыз ба?
Dialogue: 0,0:12:19.61,0:12:21.94,Default,,0,0,0,,Бірақ бұл таңқаларлық, солай емес пе?
Dialogue: 0,0:12:26.62,0:12:27.78,Default,,0,0,0,,Йо Изая
Dialogue: 0,0:12:28.45,0:12:30.08,Default,,0,0,0,,Менің келмегеніме көп болды
Dialogue: 0,0:12:30.16,0:12:31.50,Default,,0,0,0,,Оны олай атамаңыз.
Dialogue: 0,0:12:31.62,0:12:34.71,Default,,0,0,0,,Айтпақшы, «Доллар» атауының шығу тегін білесіз бе?
Dialogue: 0,0:12:35.37,0:12:37.50,Default,,0,0,0,,Сен маған долларды бермейсің бе?
Dialogue: 0,0:12:38.04,0:12:39.50,Default,,0,0,0,,Бұл айырмашылық.
Dialogue: 0,0:12:39.63,0:12:42.13,Default,,0,0,0,,Бұл ұйым негізінен ештеңе істемейді.
Dialogue: 0,0:12:42.21,0:12:46.01,Default,,0,0,0,,«Доллар», өйткені олар жалқау. Бұл солай.
Dialogue: 0,0:12:46.14,0:12:49.22,Default,,0,0,0,,Дотачин Сіз мұны бұрын көрдіңіз бе? Қара велосипед!
Dialogue: 0,0:12:49.31,0:12:51.14,Default,,0,0,0,,Жоқ, жоқ, жоқ, бұл маңызды ма?
Dialogue: 0,0:12:51.22,0:12:53.98,Default,,0,0,0,,Бұл оптикалық иллюзия емес еді.
Dialogue: 0,0:12:54.06,0:12:56.15,Default,,0,0,0,,Мүмкін бұл CG шығар? Ұнайды
Dialogue: 0,0:12:56.23,0:12:58.77,Default,,0,0,0,,Бұл CG де доллардың мүшесі болып табылады.
Dialogue: 0,0:12:58.86,0:13:00.15,Default,,0,0,0,,Не?!
Dialogue: 0,0:13:00.27,0:13:01.78,Default,,0,0,0,,Керемет! (Кадота) Бұл рас па?
Dialogue: 0,0:13:01.86,0:13:04.49,Default,,0,0,0,,Керемет Керемет
Dialogue: 0,0:13:07.95,0:13:09.83,Default,,0,0,0,,Шынымды айтсам, таң қалдым.
Dialogue: 0,0:13:09.95,0:13:11.45,Default,,0,0,0,,Интернетте адамдардың айтарлықтай саны...
Dialogue: 0,0:13:11.58,0:13:14.41,Default,,0,0,0,,Мен оның өзін «доллар» деп атайтынын білдім.
Dialogue: 0,0:13:14.54,0:13:17.67,Default,,0,0,0,,Бірақ бүгін сіз кенет жиналыс өткіземін деп айттыңыз...
Dialogue: 0,0:13:17.79,0:13:20.46,Default,,0,0,0,,Мен осында жиналу үшін бар күш-жігерін салып жатқан адамдардың көп екеніне сене алар емеспін.
Dialogue: 0,0:13:20.59,0:13:23.92,Default,,0,0,0,,А, адамдар шынымен сен ойлағаннан да көп.
Dialogue: 0,0:13:24.01,0:13:28.34,Default,,0,0,0,,Дегенмен, Микадо-кун күнделікті өмірден қашуды армандайтын сияқты...
Dialogue: 0,0:13:28.59,0:13:32.39,Default,,0,0,0,,Токиодағы өмір жарты жылдан кейін күнделікті тәртіпке айналады.
Dialogue: 0,0:13:32.72,0:13:35.06,Default,,0,0,0,,Егер сіз одан да ерекше болғыңыз келсе...
Dialogue: 0,0:13:35.18,0:13:36.48,Default,,0,0,0,,Басқа елге кеткіңіз келе ме?
Dialogue: 0,0:13:36.56,0:13:38.35,Default,,0,0,0,,Немесе тағы бір жер асты...
Dialogue: 0,0:13:38.44,0:13:39.90,Default,,0,0,0,,Қолымды сынаудан басқа амалым жоқ.
Dialogue: 0,0:13:40.44,0:13:42.57,Default,,0,0,0,,Бірақ ол жағына да кіретін болсақ...
Dialogue: 0,0:13:42.90,0:13:45.24,Default,,0,0,0,,Ол 3 күннен кейін «күнделікті» болуы мүмкін.
Dialogue: 0,0:13:46.99,0:13:51.87,Default,,0,0,0,,Егер сіз күнделікті өмірден шынымен қашқыңыз келсе, сізде үнемі дамудан басқа амал жоқ.
Dialogue: 0,0:13:52.41,0:13:55.66,Default,,0,0,0,,Сіз жоғарыға немесе төменге ұмтыласыз ба.
Dialogue: 0,0:13:56.87,0:13:58.87,Default,,0,0,0,,Күнделікті өмірден ләззат алыңыз
Dialogue: 0,0:13:58.96,0:13:59.88,Default,,0,0,0,,Өмірімді қатерге тігіп, барымды салдым.
Dialogue: 0,0:14:00.54,0:14:02.04,Default,,0,0,0,,Сіздің құрметіңізге -
Dialogue: 0,0:14:02.17,0:14:06.47,Default,,0,0,0,,Мен Нами Ягиридің телефон нөмірі туралы ақпаратты тегін сақтаймын.
Dialogue: 0,0:14:06.72,0:14:10.84,Default,,0,0,0,,Осы «Доллар» негізін қалаушы екеніңіз туралы ақпаратты сатпаңыз.
Dialogue: 0,0:14:11.22,0:14:14.89,Default,,0,0,0,,Бұл сіздің ұйымыңыз. Сіз оны өз қалауыңыз бойынша пайдалана аласыз.
Dialogue: 0,0:14:21.61,0:14:23.40,Default,,0,0,0,,Изая!
Dialogue: 0,0:14:23.94,0:14:26.40,Default,,0,0,0,,Құтқару уақыты жақындап қалған сияқты.
Dialogue: 0,0:14:26.90,0:14:29.82,Default,,0,0,0,,Олай болса, бар күшіңді сал, Таро Танака.
Dialogue: 0,0:14:30.61,0:14:32.37,Default,,0,0,0,,Тоқта, күт!
Dialogue: 0,0:14:32.74,0:14:34.58,Default,,0,0,0,,Мінекей!
Dialogue: 0,0:14:34.70,0:14:35.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:39.29,0:14:41.25,Default,,0,0,0,,А... мүмкін емес...
Dialogue: 0,0:14:41.79,0:14:42.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:44.46,0:14:48.63,Default,,0,0,0,,Келесі күні қалыпты өмір қалпына келді.
Dialogue: 0,0:14:48.88,0:14:50.93,Default,,0,0,0,,Оған да
Dialogue: 0,0:14:51.76,0:14:52.93,Default,,0,0,0,,Тіпті сол балаға
Dialogue: 0,0:14:53.05,0:14:55.68,Default,,0,0,0,,Білесің бе, Микадо, мен оны интернеттен көрдім...
Dialogue: 0,0:14:55.76,0:14:58.10,Default,,0,0,0,,Мен кеше доллар раллиі болғанын естідім.
Dialogue: 0,0:14:58.18,0:15:02.10,Default,,0,0,0,,Саймон мен Сидзуо да доллардың мүшелері болған сияқты.
Dialogue: 0,0:15:02.19,0:15:04.61,Default,,0,0,0,,Оның үстіне мына қара велосипедтің мойыны жоқ...
Dialogue: 0,0:15:04.69,0:15:06.94,Default,,0,0,0,,Қабырға бойымен жүгіріп, орақты шығарыңыз...
Dialogue: 0,0:15:07.07,0:15:10.45,Default,,0,0,0,,Бірдеңе керемет болған сияқты.
Dialogue: 0,0:15:10.53,0:15:12.41,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:15:12.99,0:15:14.83,Default,,0,0,0,,Және де оларға
Dialogue: 0,0:15:14.95,0:15:17.41,Default,,0,0,0,,Мен сені сүймеймін
Dialogue: 0,0:15:17.79,0:15:20.29,Default,,0,0,0,,Бірақ мен саған қарап тұрғанша...
Dialogue: 0,0:15:20.37,0:15:23.25,Default,,0,0,0,,«Оған» деген махаббатымды ешқашан ұмытпаймын
Dialogue: 0,0:15:23.58,0:15:25.92,Default,,0,0,0,,Сондықтан мен сенің махаббатыңды қабылдаймын
Dialogue: 0,0:15:26.38,0:15:29.13,Default,,0,0,0,,Мен оны бір күні қайтарып алғанша
Dialogue: 0,0:15:39.39,0:15:40.39,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:15:40.48,0:15:42.48,Default,,0,0,0,,Қайырлы таң, мен көптен күттім.
Dialogue: 0,0:15:42.60,0:15:43.31,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:15:43.44,0:15:46.32,Default,,0,0,0,,Бүгін ұйықтап жатырмын, сондықтан ерте кетемін.
Dialogue: 0,0:15:46.40,0:15:48.78,Default,,0,0,0,,А, ұйықтамадың ба? Сіз түні бойы ұйықтадыңыз ба?
Dialogue: 0,0:15:49.11,0:15:50.32,Default,,0,0,0,,Иә, аздап.
Dialogue: 0,0:15:50.53,0:15:52.45,Default,,0,0,0,,Канра-сан әлі сені көргісі келеді.
Dialogue: 0,0:15:52.70,0:15:54.82,Default,,0,0,0,,Канра мырза... келесіз бе?
Dialogue: 0,0:15:55.16,0:15:57.79,Default,,0,0,0,,Әй, менің шұғыл жұмысым бар сияқты.
Dialogue: 0,0:15:57.87,0:15:58.95,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:15:59.04,0:16:01.21,Default,,0,0,0,,Кешіріңіз, ертерек кешіріңіз.
Dialogue: 0,0:16:01.33,0:16:02.33,Default,,0,0,0,,Сонымен қатар, Yoshida Productions Яиді Yotsuba-ның талисманы ретінде насихаттап жатыр.
Dialogue: 0,0:16:05.83,0:16:08.67,Default,,0,0,0,,Өкініштісі, көңілді бөлігі шұғыл жұмыс.
Dialogue: 0,0:16:09.71,0:16:10.80,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:16:11.34,0:16:14.68,Default,,0,0,0,,Ал менің күнделікті өмірім әдеттегідей.
Dialogue: 0,0:16:15.01,0:16:18.06,Default,,0,0,0,,Кездейсоқ кездеспеген адаммен кездесіп қалу да...
Dialogue: 0,0:16:18.18,0:16:19.18,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:16:20.85,0:16:22.60,Default,,0,0,0,,Ол сынған сияқты.
Dialogue: 0,0:16:22.81,0:16:25.06,Default,,0,0,0,,Ал, елестер жасырын...
Dialogue: 0,0:16:25.19,0:16:27.82,Default,,0,0,0,,Бұл қорқынышты, өйткені ол кенеттен дірілдеп шығады ...
Dialogue: 0,0:16:28.07,0:16:30.19,Default,,0,0,0,,Ол сондай керемет көрініс жасады.
Dialogue: 0,0:16:30.65,0:16:33.11,Default,,0,0,0,,Енді сенен ешкім қорықпайды.
Dialogue: 0,0:16:33.36,0:16:37.66,Default,,0,0,0,,Ақырында ешкімді өлтірген жоқсың. Сол орақпен нені кесуге болмайды?
Dialogue: 0,0:16:38.37,0:16:40.37,Default,,0,0,0,,Сіз бұл әйелді кездейсоқ қуып жүрсіз бе?
Dialogue: 0,0:16:40.45,0:16:42.37,Default,,0,0,0,,Сізге қажет болса, мен әрқашан көмектесемін.
Dialogue: 0,0:16:42.75,0:16:43.87,Default,,0,0,0,,Маған қоңырау шалыңыз
Dialogue: 0,0:16:46.54,0:16:47.58,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:16:48.09,0:16:50.55,Default,,0,0,0,,Нами Ягири қайда екенін білмеймін.
Dialogue: 0,0:16:50.88,0:16:55.09,Default,,0,0,0,,Бірақ бәрібір, менмін, ештеңеден кем емеспін.
Dialogue: 0,0:16:55.59,0:17:00.06,Default,,0,0,0,,Күндер әдеттегідей, артық үміт пен үмітсіз
Dialogue: 0,0:17:00.18,0:17:01.56,Default,,0,0,0,,Шынында… олардың әрқайсысы «Стэйн», «Стэйн» деп тоқтамай сөйлей береді…
Dialogue: 0,0:17:01.81,0:17:05.64,Default,,0,0,0,,Бірақ бұл орындалу сезімі қандай!
Dialogue: 0,0:17:06.65,0:17:09.69,Default,,0,0,0,,Мен мұндамын, сен сондасың
Dialogue: 0,0:17:10.06,0:17:14.07,Default,,0,0,0,,Мен сенің құтқарушың болсам, сен менің құтқарушымсың.
Dialogue: 0,0:17:18.24,0:17:20.32,Default,,0,0,0,,Ал бала ойланады
Dialogue: 0,0:17:20.53,0:17:22.79,Default,,0,0,0,,Изая Орихараның маған айтқаны
Dialogue: 0,0:17:23.08,0:17:25.25,Default,,0,0,0,,Мен мүмкін емес шындықты аңсаймын...
Dialogue: 0,0:17:25.37,0:17:28.13,Default,,0,0,0,,Жаңа шындықтан мәңгілік іздеуге бола ма?
Dialogue: 0,0:17:28.25,0:17:29.63,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:17:29.96,0:17:34.21,Default,,0,0,0,,Сол мәңгілік те «күнделікті» бола ма?
Dialogue: 0,0:17:35.26,0:17:36.93,Default,,0,0,0,,Көп жағынан жаман болды.
Dialogue: 0,0:17:37.05,0:17:38.26,Default,,0,0,0,,Еңбек тәжірибесі бағдарламасына оралды
Dialogue: 0,0:17:44.81,0:17:47.23,Default,,0,0,0,,Эй... Сәлем, менің орным.
Dialogue: 0,0:17:47.31,0:17:49.98,Default,,0,0,0,,Аа, сынып өкілінің артында бос орын бар.
Dialogue: 0,0:17:50.11,0:17:54.90,Default,,0,0,0,,ше? Не болып жатыр? Неге кенеттен келгеніңізді түсінбеймін.
Dialogue: 0,0:17:59.62,0:18:01.45,Default,,0,0,0,,Мен оның бұрынғыдай екеніне сенімдімін
Dialogue: 0,0:18:01.58,0:18:04.75,Default,,0,0,0,,Мен енді Мика Харимамен жұмыс істемеймін.
Dialogue: 0,0:18:05.08,0:18:09.29,Default,,0,0,0,,Бұл жақсы нәрсе екенін тек ол біледі.
Dialogue: 0,0:18:09.63,0:18:11.13,Default,,0,0,0,,Бірақ шынымен солай ма?
Dialogue: 0,0:18:11.46,0:18:15.05,Default,,0,0,0,,Өйткені, адамдар адамның жүрегін түсінбейді ме?
Dialogue: 0,0:18:15.46,0:18:20.59,Default,,0,0,0,,«Бізде үнемі дамудан басқа амал жоқ». Ол кісінің сөзі менің ойымда жаңғырық.
Dialogue: 0,0:18:21.89,0:18:26.73,Default,,0,0,0,,Осындай батыл әрекет жасағаннан кейін мен бәрін істей аламын деп ойладым.
Dialogue: 0,0:18:26.81,0:18:30.52,Default,,0,0,0,,Бірақ бала мұны шамалы да болжаған жоқ.
Dialogue: 0,0:18:30.81,0:18:33.48,Default,,0,0,0,,Бір сыныптағы қызды кездесуге шақыру...
Dialogue: 0,0:18:33.57,0:18:36.03,Default,,0,0,0,,Бұл соншалықты батылдықты қажет етеді.
Dialogue: 0,0:18:36.78,0:18:39.11,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:18:40.66,0:18:43.87,Default,,0,0,0,,Бала қызды тапқанша 30 секунд қалды
Dialogue: 0,0:18:44.49,0:18:49.00,Default,,0,0,0,,35 секунд ішінде бала өзінің ең жақын досын қызды еркелетіп жатқанын тапқанша\NБала ең жақын досын тепкенше
Dialogue: 0,0:18:49.41,0:18:53.29,Default,,0,0,0,,45 секунд
Dialogue: 0,0:18:53.67,0:18:57.80,Default,,0,0,0,,74 секунд қалды, қыз балаға шайдан бас тартты
Dialogue: 0,0:18:58.05,0:19:03.05,Default,,0,0,0,,Баланы қыз төбесіндегі түскі асқа шақырғанша 78 секунд қалды.
Dialogue: 0,0:19:03.80,0:19:06.89,Default,,0,0,0,,Жігіт қызға ғашық болғанша...
Dialogue: 0,0:19:07.47,0:19:11.31,Default,,0,0,0,,Бала қызды мойындағанша...
Dialogue: 0,0:19:15.32,0:19:18.19,Default,,0,0,0,,Бірақ сіз де ақымақтық жасадыңыз.
Dialogue: 0,0:19:20.99,0:19:25.03,Default,,0,0,0,,Ағамның бұралған махаббаты үшін мен кенеттен бәрінен айырылдым.
Dialogue: 0,0:19:34.84,0:19:38.80,Default,,0,0,0,,Жоқ, бұл менің ініме деген бұрмаланған махаббат сияқты.
Dialogue: 0,0:19:38.88,0:19:42.72,Default,,0,0,0,,Сонымен, бұл қауіпті емес пе? Бұл Небуламен бірігу емес пе?
Dialogue: 0,0:19:42.93,0:19:45.26,Default,,0,0,0,,Мұны әзіл ретінде айтсаң ше?
Dialogue: 0,0:19:45.47,0:19:49.02,Default,,0,0,0,,Мафия немесе білікті мерген...
Dialogue: 0,0:19:49.10,0:19:52.23,Default,,0,0,0,,Қабағыңның арасын қағып
Dialogue: 0,0:19:53.31,0:19:53.94,Default,,0,0,0,,Тазалау көлігі?
Dialogue: 0,0:19:54.31,0:19:56.90,Default,,0,0,0,,Иә, әдеттегі қалпына келтіру тобы.
Dialogue: 0,0:19:56.98,0:19:57.73,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:20:01.74,0:20:04.95,Default,,0,0,0,,Сәлеметсіз бе? Іс күрделене түсуде...
Dialogue: 0,0:20:05.37,0:20:06.95,Default,,0,0,0,,Қазір бөлмеден шыға аласыз ба?
Dialogue: 0,0:20:10.12,0:20:12.58,Default,,0,0,0,,Корольдер арасындағы жеке шайқас ережелері
Dialogue: 0,0:20:13.08,0:20:14.46,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:20:15.50,0:20:19.17,Default,,0,0,0,,Ағаң менімен бірдей болғанына сенімдімін.
Dialogue: 0,0:20:19.25,0:20:21.42,Default,,0,0,0,,Мен о дүниеге ешкімнен артық сенбеймін...
Dialogue: 0,0:20:21.55,0:20:25.51,Default,,0,0,0,,Өлімнен басқалардан көбірек қорқу, Жұмақтан көбірек аңсау
Dialogue: 0,0:20:26.47,0:20:30.02,Default,,0,0,0,,Дегенмен, о дүниенің бар екеніне мен де сенімдімін.
Dialogue: 0,0:20:30.10,0:20:31.39,Default,,0,0,0,,Осымен қалдырайық.
Dialogue: 0,0:20:32.94,0:20:33.89,Default,,0,0,0,,Дуллахан дегеніміз не?
Dialogue: 0,0:20:33.98,0:20:36.73,Default,,0,0,0,,Негізінде тек әйелдер бар дейді.
Dialogue: 0,0:20:37.27,0:20:38.27,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:20:38.65,0:20:39.86,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:39.94,0:20:42.74,Default,,0,0,0,,Кейбір қарамағындағылар мифологияны зерттеп жүрген...
Dialogue: 0,0:20:42.82,0:20:44.28,Default,,0,0,0,,Өйткені мен мұны босқа кетті деп ойладым
Dialogue: 0,0:20:44.95,0:20:46.66,Default,,0,0,0,,Сіз рационалистсіз, солай емес пе?
Dialogue: 0,0:20:46.78,0:20:48.58,Default,,0,0,0,,Ал, мұны артта қалдырыңыз.
Dialogue: 0,0:20:48.78,0:20:52.00,Default,,0,0,0,,Валхалла деп аталатын аспан, дәл емес...
Dialogue: 0,0:20:52.58,0:20:56.67,Default,,0,0,0,,Скандинавия мифологиясында Валькирия деп аталатын сауыт киген періште әйел бар.
Dialogue: 0,0:20:56.79,0:21:00.63,Default,,0,0,0,,Ержүрек жауынгерлердің рухын Валхаллаға бағыттау туралы әңгіме бар.
Dialogue: 0,0:21:00.88,0:21:03.13,Default,,0,0,0,,Әйел өлгендерді көтеріп жатыр
Dialogue: 0,0:21:03.26,0:21:05.51,Default,,0,0,0,,Сіз мұны бір жерден естідім деп ойламайсыз ба?
Dialogue: 0,0:21:05.93,0:21:08.35,Default,,0,0,0,,Жерді кезіп жүрген валькирлердің көрінісі...
Dialogue: 0,0:21:08.47,0:21:10.72,Default,,0,0,0,,Дуллахан деген теория бар.
Dialogue: 0,0:21:11.31,0:21:14.64,Default,,0,0,0,,Олай болса, мен осыны күтіп тұрғаныма сенімдімін.
Dialogue: 0,0:21:15.19,0:21:17.52,Default,,0,0,0,,Соғыс уақытын ояту
Dialogue: 0,0:21:17.65,0:21:20.44,Default,,0,0,0,,Валхаллаға қарсы алу үшін қасиетті жауынгерді табу
Dialogue: 0,0:21:21.32,0:21:23.57,Default,,0,0,0,,Бұл тірі, бірақ оянбайды...
Dialogue: 0,0:21:23.65,0:21:25.15,Default,,0,0,0,,Бұл ұрыс алаңы емес.
Dialogue: 0,0:21:26.11,0:21:29.74,Default,,0,0,0,,Мүмкін болса, мен де сол жауынгер ретінде таңдалғым келеді.
Dialogue: 0,0:21:29.99,0:21:32.87,Default,,0,0,0,,Өлгеннен кейін шынымен Валхалла бар болса...
Dialogue: 0,0:21:33.00,0:21:34.87,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:21:35.00,0:21:38.33,Default,,0,0,0,,Қақтығыс аймағына барып белсенділік таныта алмаймын деп ойлаймын.
Dialogue: 0,0:21:38.42,0:21:42.75,Default,,0,0,0,,Бұл жағдайда менің қолымнан келетін жалғыз нәрсе - соғыс бастау, солай ма?
Dialogue: 0,0:21:42.84,0:21:45.67,Default,,0,0,0,,Хаха мен қандай бақыттымын
Dialogue: 0,0:21:45.76,0:21:49.76,Default,,0,0,0,,Аспанға сенбей, аспаннан алыс өмір кешкен мен...
Dialogue: 0,0:21:49.85,0:21:53.06,Default,,0,0,0,,Сондықтан жерге құлаған өлім періштесін кездестіруге болады.
Dialogue: 0,0:21:53.18,0:21:56.10,Default,,0,0,0,,Бұл сіздің болжамыңыз емес.
Dialogue: 0,0:21:56.18,0:21:58.06,Default,,0,0,0,,Сенгендер құтқарылады
Dialogue: 0,0:21:58.19,0:22:00.69,Default,,0,0,0,,Және бұл сақтандыру дейді, солай ма?
Dialogue: 0,0:22:00.90,0:22:04.23,Default,,0,0,0,,Тозақ болса да, Азаптан басқа ештеңе болмаса да...
Dialogue: 0,0:22:04.36,0:22:07.03,Default,,0,0,0,,«Мен» бар болғанша, маңызды емес.
Dialogue: 0,0:22:07.70,0:22:11.95,Default,,0,0,0,,Бірақ, мүмкін болса, аспан жақсырақ болар еді.
Dialogue: 0,0:22:12.58,0:22:15.70,Default,,0,0,0,,Эй Нами-сан, бәріміз жұмаққа барайық.
Dialogue: 0,0:22:16.50,0:22:19.75,Default,,0,0,0,,Доллар мүшесі ретінде мен бұған жауапты боламын.
Dialogue: 0,0:22:19.88,0:22:21.21,Default,,0,0,0,,Маяк астындағы қараңғылық
Dialogue: 0,0:22:21.34,0:22:22.46,Default,,0,0,0,,Мен де Селтиді күтпедім...
Dialogue: 0,0:22:22.54,0:22:26.92,Default,,0,0,0,,Сіздің басыңыз өзіңіз жұмыс істейтін ұйымға тиесілі емес деп ойлайсыз, солай емес пе?
Dialogue: 0,0:22:27.42,0:22:30.09,Default,,0,0,0,,Иә, сіз де долларға қосыла аласыз.
Dialogue: 0,0:22:30.51,0:22:34.01,Default,,0,0,0,,Бастықтың «Кім келсе, сүйретеміз» деген саясаты бар.
Dialogue: 0,0:22:34.31,0:22:38.60,Default,,0,0,0,,Алайда... Жарты жолда адамдарды жинай бастаған мен болдым.
Dialogue: 0,0:22:40.02,0:22:41.90,Default,,0,0,0,,Жерге түскен періште...
Dialogue: 0,0:22:42.02,0:22:44.57,Default,,0,0,0,,Оны қолымызбен жапсырайық
Dialogue: 0,0:22:45.19,0:22:46.07,Default,,0,0,0,,Эй?
Dialogue: 0,0:22:46.99,0:22:52.99,Default,,0,0,0,,♪~
Dialogue: 0,0:24:07.11,0:24:13.11,Default,,0,0,0,,~♪
Dialogue: 0,0:24:14.61,0:24:20.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory