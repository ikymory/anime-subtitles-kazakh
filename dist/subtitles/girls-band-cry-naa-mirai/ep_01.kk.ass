Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.41,0:00:08.80,Default,,0,0,0,,Рупа-сан Томо-чан Субару-чан Момока-сан
Dialogue: 0,0:00:09.34,0:00:10.76,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:11.59,0:00:12.93,Default,,0,0,0,,Мектептен бас тарту
Dialogue: 0,0:00:14.51,0:00:17.51,Default,,0,0,0,,♪～
Dialogue: 0,0:00:25.60,0:00:27.19,Default,,0,0,0,,«жебе» ♪Өшірмес мұңды жайып
Dialogue: 0,0:00:27.31,0:00:28.86,Default,,0,0,0,,♪Айта алмайтын күрсініп өзімді алдап жатырмын
Dialogue: 0,0:00:28.98,0:00:30.11,Default,,0,0,0,,♪Бір күні мені жылатқан көрініс,
Dialogue: 0,0:00:30.23,0:00:32.15,Default,,0,0,0,,♪Бәрін жыртып тастаймын
Dialogue: 0,0:00:32.28,0:00:34.24,Default,,0,0,0,,♪Шынымен шыққан сиқырға
Dialogue: 0,0:00:34.36,0:00:35.36,Default,,0,0,0,,♪Өзіңізбен бірге алып келген жауап
Dialogue: 0,0:00:35.49,0:00:38.12,Default,,0,0,0,,♪Жүрегіме ойып саламын
Dialogue: 0,0:00:38.28,0:00:39.74,Default,,0,0,0,,♪Қанша тырыссаңыз да нәтиже өзгермейді
Dialogue: 0,0:00:39.87,0:00:41.70,Default,,0,0,0,,♪Әзірше өзгерістерге алаңдайсыз ба?
Dialogue: 0,0:00:41.83,0:00:43.08,Default,,0,0,0,,♪Өз сезіміңді бейнелейтін жерде
Dialogue: 0,0:00:43.21,0:00:44.96,Default,,0,0,0,,♪Әлемді жалғайтын қызыл жіп
Dialogue: 0,0:00:45.08,0:00:48.09,Default,,0,0,0,,♪Байқауға болмайтын және ретсіз өтірік
Dialogue: 0,0:00:48.21,0:00:49.38,Default,,0,0,0,,♪Қайғылы мақтаныш
Dialogue: 0,0:00:49.50,0:00:51.96,Default,,0,0,0,,♪Біз өз сезімімізді күтеміз
Dialogue: 0,0:00:52.42,0:00:54.84,Default,,0,0,0,,♪Сенсорлық зақым, болашақтың адасуы
Dialogue: 0,0:00:55.63,0:00:56.76,Default,,0,0,0,,♪Сезімдер, махаббат және күш
Dialogue: 0,0:00:56.89,0:00:58.10,Default,,0,0,0,,♪Мен түсінбеймін
Dialogue: 0,0:00:58.68,0:00:59.89,Default,,0,0,0,,♪Ойлансам да ғайып болды
Dialogue: 0,0:01:00.01,0:01:01.18,Default,,0,0,0,,♪Оны жеу керек
Dialogue: 0,0:01:01.31,0:01:04.60,Default,,0,0,0,,♪ Лақтыр, кет.
Dialogue: 0,0:01:04.73,0:01:07.35,Default,,0,0,0,,♪Осы ессіз күндерге тост
Dialogue: 0,0:01:07.48,0:01:09.36,Default,,0,0,0,,♪Кеудедегі оқ
Dialogue: 0,0:01:09.48,0:01:12.23,Default,,0,0,0,,♪Бұрмаланған ертеңге құтқару жоқ
Dialogue: 0,0:01:12.53,0:01:14.90,Default,,0,0,0,,♪Құлағымды жапсам да, қараңғылық күңіренеді
Dialogue: 0,0:01:15.20,0:01:18.62,Default,,0,0,0,,♪Бір күні, Жылаған түнімді әнге айналдырармын
Dialogue: 0,0:01:18.74,0:01:21.91,Default,,0,0,0,,♪Аман бол, барма.
Dialogue: 0,0:01:22.29,0:01:25.46,Default,,0,0,0,,♪Дұға ет және құрт
Dialogue: 0,0:01:25.58,0:01:27.83,Default,,0,0,0,,♪Жүрегіңді айт
Dialogue: 0,0:01:27.96,0:01:29.50,Default,,0,0,0,,♪Қандай ересек адам
Dialogue: 0,0:01:29.63,0:01:31.88,Default,,0,0,0,,♪Мен ештеңе түсінбеймін
Dialogue: 0,0:01:32.25,0:01:34.97,Default,,0,0,0,,♪Жынды болған мына дүниеде
Dialogue: 0,0:01:39.97,0:01:42.97,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.81,0:01:45.06,Default,,0,0,0,,Ең алдымен кешірім сұраңыз
Dialogue: 0,0:01:45.18,0:01:46.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:46.39,0:01:47.73,Default,,0,0,0,,(Шукуна) Хе-хе. (Итадори) Уф! Ах! Уф!
Dialogue: 0,0:01:47.85,0:01:50.90,Default,,0,0,0,,А, Субару-чан, Момока-санның одақтасы?
Dialogue: 0,0:01:51.15,0:01:52.78,Default,,0,0,0,,Достар да, жаулар да жоқ
Dialogue: 0,0:01:52.90,0:01:55.90,Default,,0,0,0,,Бірақ мұндай жерде кенеттен сөйлегеніне Нина кінәлі.
Dialogue: 0,0:01:56.20,0:01:58.45,Default,,0,0,0,,Сахна – көрермендерге заттарды көрсететін жер.
Dialogue: 0,0:01:58.57,0:02:00.28,Default,,0,0,0,,Ең маңызды орын
Dialogue: 0,0:02:00.41,0:02:03.54,Default,,0,0,0,,Бұл сіздің жеке жағдайыңызды талқылайтын орын емес!
Dialogue: 0,0:02:03.79,0:02:06.04,Default,,0,0,0,,Сол үшін де айтқым келді!
Dialogue: 0,0:02:06.91,0:02:07.92,Default,,0,0,0,,Момокаға!
Dialogue: 0,0:02:08.04,0:02:08.87,Default,,0,0,0,,Уф
Dialogue: 0,0:02:09.00,0:02:09.92,Default,,0,0,0,,Хмф!
Dialogue: 0,0:02:10.04,0:02:11.09,Default,,0,0,0,,Ууу~
Dialogue: 0,0:02:11.21,0:02:13.42,Default,,0,0,0,,Екеуі отырып, адамдарға қарап отыр.
Dialogue: 0,0:02:13.67,0:02:17.55,Default,,0,0,0,,Бізге ештеңе айтпаңыз және кенеттен «шығыңыз» немесе «соңғы» деңіз!
Dialogue: 0,0:02:17.80,0:02:20.64,Default,,0,0,0,,Ешқандай кеңессіз кәсіпқой болуды шешкен адамға.
Dialogue: 0,0:02:20.76,0:02:21.68,Default,,0,0,0,,Маған айтқым келмейді!
Dialogue: 0,0:02:22.10,0:02:24.22,Default,,0,0,0,,Екеуі де.
Dialogue: 0,0:02:24.93,0:02:27.81,Default,,0,0,0,,Сіз мұны бірінші кезекте қиындатқан шығарсыз!
Dialogue: 0,0:02:27.94,0:02:28.94,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:29.27,0:02:30.19,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:02:30.40,0:02:31.94,Default,,0,0,0,,Мен жалғастырамын!
Dialogue: 0,0:02:32.23,0:02:34.32,Default,,0,0,0,,Ақылсыз қызып кетуге болмайды.
Dialogue: 0,0:02:34.44,0:02:36.19,Default,,0,0,0,,Кейін өкінесің
Dialogue: 0,0:02:36.44,0:02:39.95,Default,,0,0,0,,Алмаз шаңының қаншалықты танымал екенін білесіз бе?
Dialogue: 0,0:02:40.16,0:02:44.24,Default,,0,0,0,,Сондықтан мен ешнәрсе жасамай тастадым деп айтқым келмейді.
Dialogue: 0,0:02:44.37,0:02:46.45,Default,,0,0,0,,Біз қателестік
Dialogue: 0,0:02:46.75,0:02:48.08,Default,,0,0,0,,Айтқым келмейді!
Dialogue: 0,0:02:48.25,0:02:49.08,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:49.83,0:02:50.83,Default,,0,0,0,,Шындыққа қараңыз
Dialogue: 0,0:02:50.96,0:02:53.75,Default,,0,0,0,,Ештеңеге қарамай қашуға тырысатындар
Dialogue: 0,0:02:53.88,0:02:55.09,Default,,0,0,0,,Бұл Момока-сан емес пе?
Dialogue: 0,0:02:55.25,0:02:59.05,Default,,0,0,0,,Шулы! Мен туралы не білесің?
Dialogue: 0,0:02:59.17,0:03:00.89,Default,,0,0,0,,Онда маған айтыңызшы!
Dialogue: 0,0:03:01.01,0:03:02.85,Default,,0,0,0,,Неліктен топ болуды жалғастырдыңыз?
Dialogue: 0,0:03:03.14,0:03:05.89,Default,,0,0,0,,Егер сіз шынымен жұмыс істемейді деп ойласаңыз
Dialogue: 0,0:03:06.02,0:03:08.35,Default,,0,0,0,,Сен неге ауылға бармадың?
Dialogue: 0,0:03:08.60,0:03:10.35,Default,,0,0,0,,Сіз топты қайтадан бастадыңыз ба?
Dialogue: 0,0:03:11.90,0:03:15.11,Default,,0,0,0,,Қалай болғанда да, сіз мектепке қайта оралуыңыз керек.
Dialogue: 0,0:03:16.32,0:03:17.23,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:03:19.65,0:03:21.66,Default,,0,0,0,,Олай болса өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:03:22.36,0:03:23.37,Default,,0,0,0,,[Қарқылдаған дыбыс]
Dialogue: 0,0:03:24.45,0:03:26.04,Default,,0,0,0,,Сіз қашып бара жатырсыз ба?
Dialogue: 0,0:03:28.20,0:03:29.58,Default,,0,0,0,,Қашпа!
Dialogue: 0,0:03:31.75,0:03:33.04,Default,,0,0,0,,…Үндеңіз
Dialogue: 0,0:03:33.38,0:03:34.88,Default,,0,0,0,,Ыстық, солай емес пе?
Dialogue: 0,0:03:35.00,0:03:36.05,Default,,0,0,0,,Сен жай ғана ақымақсың.
Dialogue: 0,0:03:36.38,0:03:38.42,Default,,0,0,0,,Мені ұрғың келсе, ұра аласың.
Dialogue: 0,0:03:38.55,0:03:39.88,Default,,0,0,0,,Мен үйреніп қалдым.
Dialogue: 0,0:03:40.01,0:03:41.30,Default,,0,0,0,,Сіз өз күшіңізді сынап көруіңіз керек.
Dialogue: 0,0:03:41.63,0:03:44.55,Default,,0,0,0,,Сонда Момока-санға төмен қарауға болады.
Dialogue: 0,0:03:45.60,0:03:47.31,Default,,0,0,0,,Олар сол жігіттермен бірдей...
Dialogue: 0,0:03:49.48,0:03:50.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:56.15,0:03:57.36,Default,,0,0,0,,Ой...
Dialogue: 0,0:03:57.90,0:03:59.32,Default,,0,0,0,,Су Сіз оны ішесіз бе?
Dialogue: 0,0:03:59.90,0:04:01.32,Default,,0,0,0,,Тағы да аяқталды.
Dialogue: 0,0:04:01.65,0:04:03.36,Default,,0,0,0,,Бұл бастама
Dialogue: 0,0:04:04.49,0:04:06.08,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:04:06.20,0:04:07.87,Default,,0,0,0,,Мен сізге ертең қайта хабарласамын.
Dialogue: 0,0:04:07.99,0:04:08.83,Default,,0,0,0,,Иә
Dialogue: 0,0:04:09.16,0:04:12.58,Default,,0,0,0,,Ах, мен бұл атмосферадан құтыла аламын.
Dialogue: 0,0:04:19.59,0:04:20.59,Default,,0,0,0,,Эй!
Dialogue: 0,0:04:20.80,0:04:22.05,Default,,0,0,0,,Не ол?
Dialogue: 0,0:04:22.38,0:04:24.05,Default,,0,0,0,,Бұл қандай гитара?
Dialogue: 0,0:04:24.39,0:04:26.51,Default,,0,0,0,,Мен оны үйге бара жатқанда алдым.
Dialogue: 0,0:04:27.05,0:04:28.06,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:04:28.39,0:04:29.60,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:04:30.89,0:04:34.27,Default,,0,0,0,,Мен Нинаға пайдаланылмаған гитара берді.
Dialogue: 0,0:04:34.40,0:04:37.82,Default,,0,0,0,,Даусыңда арсыздық жоқ, тамсанатындай.
Dialogue: 0,0:04:38.15,0:04:41.44,Default,,0,0,0,,Момока-сан екеуміз біргеміз, сондықтан мен оған қолынан келгеннің бәрін істеуін айттым.
Dialogue: 0,0:04:43.28,0:04:44.36,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:04:44.49,0:04:46.37,Default,,0,0,0,,Қауіпсіз жүріңіз~
Dialogue: 0,0:04:47.91,0:04:50.16,Default,,0,0,0,,Пойыз Ол шынымен бар ма?
Dialogue: 0,0:04:50.29,0:04:51.45,Default,,0,0,0,,№.
Dialogue: 0,0:04:51.62,0:04:53.91,Default,,0,0,0,,Менің ойымша, біраз сөйлесу керек.
Dialogue: 0,0:04:54.04,0:04:56.29,Default,,0,0,0,,Бұл тіпті мұқият болды.
Dialogue: 0,0:04:58.63,0:05:00.34,Default,,0,0,0,,Лупа және басқалар білді ме?
Dialogue: 0,0:05:00.46,0:05:02.72,Default,,0,0,0,,Нинаның бұлай айтатынына сене алар емеспін.
Dialogue: 0,0:05:03.01,0:05:04.26,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:04.38,0:05:08.89,Default,,0,0,0,,Бірақ мен оны жақында Нинаны көргеннен кейін күткен болар едім.
Dialogue: 0,0:05:09.01,0:05:12.02,Default,,0,0,0,,Момока-сама ғана байқамайды.
Dialogue: 0,0:05:13.39,0:05:14.98,Default,,0,0,0,,Неге оны тоқтатпадың?
Dialogue: 0,0:05:15.10,0:05:16.60,Default,,0,0,0,,Бұл адамның бостандығы, солай ма?
Dialogue: 0,0:05:16.90,0:05:19.44,Default,,0,0,0,,Нинаның айтып отырғаны қаншалықты абайсызда?
Dialogue: 0,0:05:19.57,0:05:21.36,Default,,0,0,0,,Сіз бұл Субару екенін білесіз бе?
Dialogue: 0,0:05:21.78,0:05:25.24,Default,,0,0,0,,Оның үстіне, инди-дебют жасамаған топ...
Dialogue: 0,0:05:25.49,0:05:26.53,Default,,0,0,0,,Алдыңғы фестиваль
Dialogue: 0,0:05:26.66,0:05:27.74,Default,,0,0,0,,өтті
Dialogue: 0,0:05:28.12,0:05:30.24,Default,,0,0,0,,Сондай-ақ Лупа-санға.
Dialogue: 0,0:05:30.37,0:05:32.79,Default,,0,0,0,,Маған бір белгі хабарласып, олар қызығушылық танытты.
Dialogue: 0,0:05:32.91,0:05:33.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:34.00,0:05:36.50,Default,,0,0,0,,Сіз бұл өтірік деп ойлайтын шығарсыз, бірақ
Dialogue: 0,0:05:36.83,0:05:40.50,Default,,0,0,0,,Момока-сан бұрынғы Алмаз шаңы, солай ма?
Dialogue: 0,0:05:40.71,0:05:42.13,Default,,0,0,0,,Томо-чан мен Рупа-сан да
Dialogue: 0,0:05:42.25,0:05:46.01,Default,,0,0,0,,Интернетте көпшіліктің назарын аударған жұмбақ дуэт
Dialogue: 0,0:05:46.30,0:05:47.97,Default,,0,0,0,,Сонымен қатар, Нинаның даусы
Dialogue: 0,0:05:48.09,0:05:51.64,Default,,0,0,0,,Бір күні бір вокалист: «Жақсы екен» деп күбірледі.
Dialogue: 0,0:05:52.14,0:05:53.68,Default,,0,0,0,,Аздаған дыбыс
Dialogue: 0,0:05:53.81,0:05:54.64,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:54.89,0:05:57.52,Default,,0,0,0,,Жазушылар көп.
Dialogue: 0,0:05:57.69,0:05:59.31,Default,,0,0,0,,Тіпті келесі тікелей эфирге арналған сауалнама.
Dialogue: 0,0:05:59.44,0:06:01.15,Default,,0,0,0,,Біз іздеген тұтынушы...
Dialogue: 0,0:06:02.27,0:06:03.40,Default,,0,0,0,,Ең!
Dialogue: 0,0:06:04.19,0:06:05.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:05.49,0:06:08.53,Default,,0,0,0,,Нинаның айтқаны құр арман емес.
Dialogue: 0,0:06:08.66,0:06:11.03,Default,,0,0,0,,Дедусты жеңу ысырап болар еді.
Dialogue: 0,0:06:11.16,0:06:14.16,Default,,0,0,0,,Ең болмағанда сіз бірінші қадам жасай аласыз
Dialogue: 0,0:06:14.45,0:06:16.66,Default,,0,0,0,,Лупалар не дейді?
Dialogue: 0,0:06:16.96,0:06:19.79,Default,,0,0,0,,Ол балалар басынан кәсіпқой болғысы келді, солай ма?
Dialogue: 0,0:06:19.96,0:06:20.92,Default,,0,0,0,,Субару ше?
Dialogue: 0,0:06:21.04,0:06:22.80,Default,,0,0,0,,Мен оны сәйкестендіремін~
Dialogue: 0,0:06:23.17,0:06:26.51,Default,,0,0,0,,үшін мәңгілік бала болып қалмайды.
Dialogue: 0,0:06:27.63,0:06:30.14,Default,,0,0,0,,Қалғаны Момокаға байланысты.
Dialogue: 0,0:06:30.55,0:06:34.14,Default,,0,0,0,,Бастапқыда барлығы келісе ме?
Dialogue: 0,0:06:34.60,0:06:35.97,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:06:36.10,0:06:38.48,Default,,0,0,0,,Нина дәл осылай деді.
Dialogue: 0,0:06:38.60,0:06:42.11,Default,,0,0,0,,«Егер сіз байыпты болсаңыз, шегінуден бас тартып, мақсат қоюыңыз керек».
Dialogue: 0,0:06:42.23,0:06:43.07,Default,,0,0,0,,Ха...
Dialogue: 0,0:06:43.65,0:06:47.19,Default,,0,0,0,,Бұл қиын болғандықтан, қашу жолын кесіп тастауға тура келеді.
Dialogue: 0,0:06:50.61,0:06:52.12,Default,,0,0,0,,[Гитара дыбысы]
Dialogue: 0,0:06:52.49,0:06:54.20,Default,,0,0,0,,Кәмелетке толмаған…
Dialogue: 0,0:06:54.99,0:06:56.25,Default,,0,0,0,,Ｆ…
Dialogue: 0,0:06:57.41,0:06:58.62,Default,,0,0,0,,Ｇ…
Dialogue: 0,0:06:58.75,0:07:02.29,Default,,0,0,0,,Уау, бәрі осылай жасайды.
Dialogue: 0,0:07:02.42,0:07:03.46,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:05.05,0:07:09.97,Default,,0,0,0,,♪Бостандық Бостандық Мен бүгіннен босмын~~
Dialogue: 0,0:07:10.09,0:07:14.89,Default,,0,0,0,,♪Ертең де~ Ертеңгі күні де~ Өзіңе ұнайтын нәрсені істе~
Dialogue: 0,0:07:15.01,0:07:16.18,Default,,0,0,0,,Джакажан!
Dialogue: 0,0:07:18.39,0:07:19.60,Default,,0,0,0,,«Әкеме»
Dialogue: 0,0:07:20.02,0:07:22.10,Default,,0,0,0,,«Осы уақытқа дейін мені тәрбиелеп өсіргеніңізге рахмет».
Dialogue: 0,0:07:22.69,0:07:25.11,Default,,0,0,0,,«Бұдан былай мен өз күшіммен бар күшімді саламын».
Dialogue: 0,0:07:25.61,0:07:27.78,Default,,0,0,0,,«Жәрдемақы жеткілікті».
Dialogue: 0,0:07:28.15,0:07:30.70,Default,,0,0,0,,«Біз сіздің банк кітапшаңызды қайтарамыз»
Dialogue: 0,0:07:30.82,0:07:31.86,Default,,0,0,0,,«Нина»
Dialogue: 0,0:07:40.37,0:07:41.25,Default,,0,0,0,,Гүлп...
Dialogue: 0,0:07:41.54,0:07:43.17,Default,,0,0,0,,Оны жесең, жұмыстан шығасың.
Dialogue: 0,0:07:43.29,0:07:44.50,Default,,0,0,0,,Ақыр соңында?
Dialogue: 0,0:07:44.63,0:07:45.84,Default,,0,0,0,,Әрине!
Dialogue: 0,0:07:45.96,0:07:49.13,Default,,0,0,0,,Дәл... неліктен жарты күндік жұмыс ретінде осында келудің қиындығына түстің?
Dialogue: 0,0:07:49.26,0:07:51.22,Default,,0,0,0,,Толық емес жұмыстың өзі менің бірінші рет.
Dialogue: 0,0:07:51.34,0:07:53.34,Default,,0,0,0,,Мен білетін адам болғаны дұрыс болар еді...
Dialogue: 0,0:07:53.47,0:07:54.76,Default,,0,0,0,,Сондықтан кеш!
Dialogue: 0,0:07:54.93,0:07:57.26,Default,,0,0,0,,«Ей, кел!» десеңіз.
Dialogue: 0,0:07:57.56,0:07:58.81,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:59.56,0:08:02.27,Default,,0,0,0,,Шетелдіктердің кері сөйлесуіне жол бермеңіз!
Dialogue: 0,0:08:02.52,0:08:03.52,Default,,0,0,0,,Бұл!
Dialogue: 0,0:08:03.81,0:08:05.23,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:08:05.36,0:08:07.44,Default,,0,0,0,,Абайлаңыз! [Есікті автоматты түрде ашу дыбысы]
Dialogue: 0,0:08:07.57,0:08:09.44,Default,,0,0,0,,Сізге үлкен рахмет~
Dialogue: 0,0:08:10.44,0:08:11.70,Default,,0,0,0,,Лупа мырза
Dialogue: 0,0:08:11.82,0:08:14.11,Default,,0,0,0,,Мұндай жағдай күнде болып тұрады.
Dialogue: 0,0:08:18.12,0:08:21.08,Default,,0,0,0,,Маған да құлып керек.
Dialogue: 0,0:08:22.12,0:08:23.87,Default,,0,0,0,,Мен түгендеуге қараймын.
Dialogue: 0,0:08:25.38,0:08:28.05,Default,,0,0,0,,Сонымен Момокаға не болды?
Dialogue: 0,0:08:28.38,0:08:30.34,Default,,0,0,0,,Маған бәрібір...
Dialogue: 0,0:08:30.46,0:08:33.55,Default,,0,0,0,,Менің ойымша, егер бұл туралы қазір сөйлесетін болсақ, біз тек қайтадан ұрысамыз.
Dialogue: 0,0:08:33.93,0:08:36.89,Default,,0,0,0,,Мен саған айтамын, егер тәртіпсіздік осылай жалғаса берсе.
Dialogue: 0,0:08:37.01,0:08:38.56,Default,,0,0,0,,Біз тоқтаймыз.
Dialogue: 0,0:08:39.43,0:08:40.27,Default,,0,0,0,,Футаба, сөйлесе кетсек пе?
Dialogue: 0,0:08:40.39,0:08:42.02,Default,,0,0,0,,[Есікті автоматты түрде ашу дыбысы]
Dialogue: 0,0:08:42.14,0:08:44.19,Default,,0,0,0,,Сәлем! Қош келдіңіз...
Dialogue: 0,0:08:44.31,0:08:45.44,Default,,0,0,0,,Se...
Dialogue: 0,0:08:46.61,0:08:47.81,Default,,0,0,0,,Орташа 1
Dialogue: 0,0:08:48.11,0:08:49.52,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:08:50.03,0:08:51.44,Default,,0,0,0,,Орташа 1 мылтық!
Dialogue: 0,0:08:53.70,0:08:55.70,Default,,0,0,0,,Сыра алғыңыз келе ме?
Dialogue: 0,0:08:55.82,0:08:56.82,Default,,0,0,0,,Нина
Dialogue: 0,0:08:57.12,0:08:58.58,Default,,0,0,0,,Тапсырыс бергіңіз келе ме?
Dialogue: 0,0:08:58.87,0:09:00.66,Default,,0,0,0,,Осыдан кейін уақытыңыз бар ма?
Dialogue: 0,0:09:01.45,0:09:03.08,Default,,0,0,0,,Онда...
Dialogue: 0,0:09:03.25,0:09:04.25,Default,,0,0,0,,Су!
Dialogue: 0,0:09:07.50,0:09:08.71,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:09:10.00,0:09:12.21,Default,,0,0,0,,Жақын жерде, мен жақын арада боламын.
Dialogue: 0,0:09:13.17,0:09:14.72,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:09:20.56,0:09:22.93,Default,,0,0,0,,Мен электрондық поштаны күттім!
Dialogue: 0,0:09:23.06,0:09:25.85,Default,,0,0,0,,Аздап уайымдап, маған бірдеңе жіберіңізші!
Dialogue: 0,0:09:26.23,0:09:27.35,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:27.48,0:09:28.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:28.69,0:09:32.11,Default,,0,0,0,,«Ұнатудың қарама-қарсы жағы қызық емес» емес пе?
Dialogue: 0,0:09:32.40,0:09:36.36,Default,,0,0,0,,Біз сонша ұрысып жүрсек те, әлі бірге сөйлесіп жатқанымызға сене алар емеспін.
Dialogue: 0,0:09:36.78,0:09:38.41,Default,,0,0,0,,Бұл менің сені жақсы көретінімнің дәлелі.
Dialogue: 0,0:09:40.16,0:09:41.74,Default,,0,0,0,,Сен жай ғана ақымақсың.
Dialogue: 0,0:09:42.08,0:09:43.83,Default,,0,0,0,,Мұнда…?
Dialogue: 0,0:09:43.95,0:09:45.75,Default,,0,0,0,,Жарайды, есікті ашыңыз.
Dialogue: 0,0:09:45.87,0:09:51.17,Default,,0,0,0,,«Бос жәшік» ♪Алға ұмтылғанда не нәрсеге сүйенуіміз керек?
Dialogue: 0,0:09:51.34,0:09:54.38,Default,,0,0,0,,♪Оқулықта айтылғандай.
Dialogue: 0,0:09:54.59,0:09:56.93,Default,,0,0,0,,♪ Күрделі сөздерге толы
Dialogue: 0,0:09:57.05,0:10:00.05,Default,,0,0,0,,♪Сол уақыттан бастап бүгін
Dialogue: 0,0:09:59.34,0:10:00.93,Default,,0,0,0,,Алмаз шаңы…
Dialogue: 0,0:10:02.06,0:10:05.64,Default,,0,0,0,,Шығу жолынан бас тартып, аман қалу деген осы.
Dialogue: 0,0:10:05.93,0:10:09.60,Default,,0,0,0,,Біз орындағымыз келетін әндер туралы ештеңе айта алмаймыз.
Dialogue: 0,0:10:09.73,0:10:16.40,Default,,0,0,0,,Тірі қалу үшін не сатылады, не адамдарға ұнайды, не туралы айтылады?
Dialogue: 0,0:10:16.86,0:10:19.24,Default,,0,0,0,,Бізде оны қуудан басқа амал жоқ.
Dialogue: 0,0:10:19.70,0:10:22.41,Default,,0,0,0,,Бәрі де солай емес пе?
Dialogue: 0,0:10:24.12,0:10:27.33,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені жасау арқылы өмір сүре аласыз.
Dialogue: 0,0:10:27.91,0:10:29.33,Default,,0,0,0,,Санаулы ғана.
Dialogue: 0,0:10:30.75,0:10:33.34,Default,,0,0,0,,Тіпті Diamond Dust тобының қазіргі мүшелері
Dialogue: 0,0:10:33.46,0:10:36.05,Default,,0,0,0,,Бұл менің басынан бастап істегім келгені емес еді.
Dialogue: 0,0:10:36.17,0:10:39.26,Default,,0,0,0,,Аман қалу, сату
Dialogue: 0,0:10:39.38,0:10:41.09,Default,,0,0,0,,Мен осыны таңдадым.
Dialogue: 0,0:10:42.93,0:10:44.10,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:10:44.22,0:10:47.68,Default,,0,0,0,,Бұл Момоканың әндері міндетті түрде жұмыс істемейді дегенді білдірмейді, солай емес пе?
Dialogue: 0,0:10:48.06,0:10:50.85,Default,,0,0,0,,Бұған дейін Момоканың әні қабылданбады.
Dialogue: 0,0:10:50.98,0:10:53.86,Default,,0,0,0,,Сіз тіпті әрекет етпестен топтан шықтыңыз.
Dialogue: 0,0:10:53.98,0:10:56.94,Default,,0,0,0,,Бірақ ол қазіргі күйінде сатылды.
Dialogue: 0,0:10:57.28,0:11:00.20,Default,,0,0,0,,Ағымдағы Алмаз шаңы дұрыс.
Dialogue: 0,0:11:00.74,0:11:02.70,Default,,0,0,0,,Алдымен барлығы айтты
Dialogue: 0,0:11:02.99,0:11:05.45,Default,,0,0,0,,«Идол топтарымен алдамаңыз»
Dialogue: 0,0:11:05.58,0:11:07.70,Default,,0,0,0,,«Біз өз әндерімізді орындаймыз»
Dialogue: 0,0:11:08.29,0:11:10.46,Default,,0,0,0,,Ешкім тыңдамады.
Dialogue: 0,0:11:10.96,0:11:12.79,Default,,0,0,0,,Бірақ шындық
Dialogue: 0,0:11:12.92,0:11:15.96,Default,,0,0,0,,Кәсіби мамандар жоғары бағаласа да, сатпаса сатпайды.
Dialogue: 0,0:11:17.09,0:11:20.51,Default,,0,0,0,,Сізді күлдіретін нәрсе үлкен хитке айналады.
Dialogue: 0,0:11:20.97,0:11:22.89,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:11:23.01,0:11:24.01,Default,,0,0,0,,Бұл факт
Dialogue: 0,0:11:24.14,0:11:26.10,Default,,0,0,0,,Қысым біртіндеп артады
Dialogue: 0,0:11:27.35,0:11:29.10,Default,,0,0,0,,Содан кейін таңдау келеді
Dialogue: 0,0:11:30.06,0:11:34.15,Default,,0,0,0,,Бас тартсаңыз, жалғастыра алмайсыз.
Dialogue: 0,0:11:36.73,0:11:39.07,Default,,0,0,0,,Олар жалғастыруды таңдады.
Dialogue: 0,0:11:39.19,0:11:42.28,Default,,0,0,0,,Мұны ешқашан жоққа шығаруға болмайды.
Dialogue: 0,0:11:42.41,0:11:46.37,Default,,0,0,0,,Бірақ мен Нинаның мен сияқты таңдау жасағанын қаламаймын.
Dialogue: 0,0:11:47.20,0:11:52.12,Default,,0,0,0,,«Неге ауылға бармадың?» «Сіз топ құрдыңыз ба?» деп сұрадым.
Dialogue: 0,0:11:52.33,0:11:54.96,Default,,0,0,0,,Сол кезде мен Нинаның ән айтып жатқанын көрдім.
Dialogue: 0,0:11:55.09,0:11:58.26,Default,,0,0,0,,Ән айтып жүргенімді алғаш көрген кез есіме түсті.
Dialogue: 0,0:11:58.63,0:12:02.43,Default,,0,0,0,,Нина «сатқысы» немесе «танығысы» келмейді.
Dialogue: 0,0:12:02.55,0:12:05.01,Default,,0,0,0,,Мен жай ғана сүйікті әнімді айтып отырдым
Dialogue: 0,0:12:05.60,0:12:06.97,Default,,0,0,0,,Сол кездегі Нина
Dialogue: 0,0:12:07.10,0:12:09.35,Default,,0,0,0,,Сені ұнатқан мен болдым
Dialogue: 0,0:12:09.60,0:12:11.81,Default,,0,0,0,,Бұл сол кездегі менмін.
Dialogue: 0,0:12:12.44,0:12:16.15,Default,,0,0,0,,Сондықтан мен сенің Нина болып ән айтуыңды қаладым.
Dialogue: 0,0:12:17.15,0:12:18.98,Default,,0,0,0,,Ештеңеге байланысты емес
Dialogue: 0,0:12:19.11,0:12:21.78,Default,,0,0,0,,Мен сол әнді тыңдап, сонда болғым келді (өткен жерден шаттық естілді)
Dialogue: 0,0:12:21.78,0:12:22.32,Default,,0,0,0,,(Өткен жерден қошемет көрсетілді)
Dialogue: 0,0:12:22.45,0:12:24.74,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:12:25.28,0:12:27.53,Default,,0,0,0,,Бұл алмаз шаңы еді.
Dialogue: 0,0:12:27.91,0:12:30.75,Default,,0,0,0,,Олай болса келесі топқа қолдау көрсетіңіз!
Dialogue: 0,0:12:32.37,0:12:34.96,Default,,0,0,0,,Менің сезімім не болады?
Dialogue: 0,0:12:35.75,0:12:36.96,Default,,0,0,0,,Нина…
Dialogue: 0,0:12:37.17,0:12:39.21,Default,,0,0,0,,Менің сезімім не болады?
Dialogue: 0,0:12:40.42,0:12:41.59,Default,,0,0,0,,Нина!
Dialogue: 0,0:12:44.89,0:12:45.72,Default,,0,0,0,,Нина!
Dialogue: 0,0:12:46.01,0:12:47.10,Default,,0,0,0,,Жібер!
Dialogue: 0,0:12:47.22,0:12:48.56,Default,,0,0,0,,[Нан! ]
Dialogue: 0,0:12:51.68,0:12:54.10,Default,,0,0,0,,Мен сіздің жадыңыз емеспін
Dialogue: 0,0:12:54.35,0:12:57.11,Default,,0,0,0,,Өзіңізді естеліктеріңізге қамап алмаңыз
Dialogue: 0,0:12:58.94,0:13:01.86,Default,,0,0,0,,Енді қол алысып амандасайық.
Dialogue: 0,0:13:02.65,0:13:05.36,Default,,0,0,0,,♪Осы бос орынды толтырыңыз
Dialogue: 0,0:13:05.78,0:13:07.28,Default,,0,0,0,,♪Сіз оны шеше аласыз ба?
Dialogue: 0,0:13:07.41,0:13:08.37,Default,,0,0,0,,Исери мырза?
Dialogue: 0,0:13:08.49,0:13:09.49,Default,,0,0,0,,♪Бір күні
Dialogue: 0,0:13:09.62,0:13:12.12,Default,,0,0,0,,♪Сіз мұны қалай істер едіңіз?
Dialogue: 0,0:13:10.66,0:13:12.12,Default,,0,0,0,,Исери мырза!?
Dialogue: 0,0:13:12.25,0:13:13.37,Default,,0,0,0,,Күте тұрыңыз! Нина! ♪Сіз ары қарай жүргіңіз келе ме?
Dialogue: 0,0:13:13.37,0:13:15.12,Default,,0,0,0,,♪Ары қарай жүргіңіз келе ме?
Dialogue: 0,0:13:15.33,0:13:18.79,Default,,0,0,0,,♪Бұл шынымен ақ, бұл өте ұзын
Dialogue: 0,0:13:18.92,0:13:24.55,Default,,0,0,0,,♪Котаэ, бәлкім, жалпыға ортақ білім, ол негізінен жай пішін.
Dialogue: 0,0:13:25.38,0:13:27.72,Default,,0,0,0,,Саусақ ұшы дірілдеп тұрса да
Dialogue: 0,0:13:28.55,0:13:32.60,Default,,0,0,0,,Әндеріңізбен өмір сүргісі келетіндер бар.
Dialogue: 0,0:13:33.14,0:13:35.52,Default,,0,0,0,,Қорғау керек нәрсе
Dialogue: 0,0:13:35.64,0:13:37.56,Default,,0,0,0,,Менің есімде сен емессің
Dialogue: 0,0:13:38.10,0:13:41.57,Default,,0,0,0,,Әндерімді біреуге жеткізгім келетін сияқты.
Dialogue: 0,0:13:41.90,0:13:45.78,Default,,0,0,0,,Ойым, қуанышым, ашуым, мұңым
Dialogue: 0,0:13:45.90,0:13:49.07,Default,,0,0,0,,Біреуге қол жеткізгіңіз келгендіктен топ құрдыңыз, солай ма?
Dialogue: 0,0:13:49.45,0:13:52.79,Default,,0,0,0,,Сіз Токиоға мектеп фестиваліне ән айту үшін келдіңіз, солай ма?
Dialogue: 0,0:13:52.91,0:13:54.58,Default,,0,0,0,,Сіз кәсіпқой болдыңыз, солай ма?
Dialogue: 0,0:13:56.12,0:13:57.87,Default,,0,0,0,,Сіз неден қорқасыз?
Dialogue: 0,0:13:58.00,0:13:59.67,Default,,0,0,0,,Неден қорқасың?
Dialogue: 0,0:14:00.00,0:14:01.50,Default,,0,0,0,,Мен осындамын.
Dialogue: 0,0:14:01.63,0:14:04.26,Default,,0,0,0,,Сіз маған батылдық пен қуат бересіз
Dialogue: 0,0:14:04.38,0:14:06.68,Default,,0,0,0,,Сенің арқаңда мен ұша алдым...
Dialogue: 0,0:14:07.13,0:14:10.01,Default,,0,0,0,,Мен сенімен бірге ән айтып бақытты сезінемін
Dialogue: 0,0:14:10.14,0:14:12.35,Default,,0,0,0,,Оны тігуді қалайтын адам!
Dialogue: 0,0:14:13.10,0:14:15.81,Default,,0,0,0,,Мен саған сенемін, әнің!
Dialogue: 0,0:14:18.14,0:14:19.35,Default,,0,0,0,,Момока-сан
Dialogue: 0,0:14:22.11,0:14:24.03,Default,,0,0,0,,Менімен бірге қашпа
Dialogue: 0,0:14:24.86,0:14:26.15,Default,,0,0,0,,[Есіктің ашылған дыбысы]
Dialogue: 0,0:14:27.40,0:14:28.53,Default,,0,0,0,,Момокан?
Dialogue: 0,0:14:29.45,0:14:30.62,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:14:31.16,0:14:32.45,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:14:32.78,0:14:33.74,Default,,0,0,0,,Нина Кеттік!
Dialogue: 0,0:14:33.87,0:14:34.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:34.83,0:14:35.75,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:14:36.66,0:14:37.96,Default,,0,0,0,,Хина...
Dialogue: 0,0:14:38.08,0:14:39.50,Default,,0,0,0,,Сәлем! (Нина) Иә!
Dialogue: 0,0:14:39.62,0:14:41.08,Default,,0,0,0,,[Қозғалтқыштың іске қосылу дыбысы] (Момока) Мен алға барамын.
Dialogue: 0,0:14:41.21,0:14:42.25,Default,,0,0,0,,Үйге пойызбен кел
Dialogue: 0,0:14:42.38,0:14:44.21,Default,,0,0,0,,А?! Момокан!
Dialogue: 0,0:14:44.34,0:14:45.26,Default,,0,0,0,,Момока-сан!
Dialogue: 0,0:14:45.59,0:14:46.42,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:14:51.01,0:14:52.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:52.18,0:14:54.26,Default,,0,0,0,,Момока-сан, күте тұр! Момока-сан!
Dialogue: 0,0:14:54.39,0:14:55.81,Default,,0,0,0,,[ кенет тежеу дыбысы]
Dialogue: 0,0:14:58.18,0:14:59.23,Default,,0,0,0,,Бакаяру
Dialogue: 0,0:14:59.35,0:15:00.27,Default,,0,0,0,,Сенің есі дұрыс па?
Dialogue: 0,0:15:01.10,0:15:03.40,Default,,0,0,0,,Бұл Оайко, солай ма?
Dialogue: 0,0:15:04.27,0:15:05.44,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:15:06.78,0:15:08.57,Default,,0,0,0,,Неге қашып бара жатырсың?
Dialogue: 0,0:15:08.70,0:15:11.28,Default,,0,0,0,,Момоканың қашуының қажеті жоқ.
Dialogue: 0,0:15:11.41,0:15:14.03,Default,,0,0,0,,Момока-сан ештеңе істеген жоқ!
Dialogue: 0,0:15:14.37,0:15:15.29,Default,,0,0,0,,Шулы!
Dialogue: 0,0:15:15.41,0:15:17.12,Default,,0,0,0,,[Жақындау]
Dialogue: 0,0:15:18.66,0:15:20.29,Default,,0,0,0,,Момо Хан!
Dialogue: 0,0:15:21.04,0:15:29.42,Default,,0,0,0,,[Клаксон дыбысы]
Dialogue: 0,0:15:34.76,0:15:37.72,Default,,0,0,0,,Сөйлесудің қажеті жоқ, тыңда!
Dialogue: 0,0:15:38.14,0:15:40.23,Default,,0,0,0,,Сіздің топ ашқаныңызды естідім!
Dialogue: 0,0:15:40.52,0:15:42.23,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,0:15:42.65,0:15:44.56,Default,,0,0,0,,Біз өкінбейміз!
Dialogue: 0,0:15:44.90,0:15:47.07,Default,,0,0,0,,Бұл сізді міндетті түрде шыңға жеткізеді!
Dialogue: 0,0:15:47.36,0:15:49.57,Default,,0,0,0,,Мен сізге қателеспегенімді көрсетемін!
Dialogue: 0,0:15:49.99,0:15:52.57,Default,,0,0,0,,Оған дейін мен міндетті түрде аман қаламын!
Dialogue: 0,0:15:53.20,0:15:56.33,Default,,0,0,0,,Біз де ешқашан жеңілмейміз.
Dialogue: 0,0:15:56.66,0:15:59.83,Default,,0,0,0,,Олар біздің дұрыс айтқанымызды айтады.
Dialogue: 0,0:16:02.21,0:16:04.96,Default,,0,0,0,,Мен қателеспегенімді айтамын!
Dialogue: 0,0:16:05.21,0:16:06.13,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:06.25,0:16:07.84,Default,,0,0,0,,Өзімшіл ештеңе айтпа
Dialogue: 0,0:16:08.17,0:16:10.34,Default,,0,0,0,,Осылай ойнау
Dialogue: 0,0:16:10.47,0:16:13.05,Default,,0,0,0,,Соншалықты ұлы сөзді айтуға қалай дәтің бар!
Dialogue: 0,0:16:13.18,0:16:14.09,Default,,0,0,0,,Момокан
Dialogue: 0,0:16:14.30,0:16:15.85,Default,,0,0,0,,Бұл айдол тобы, солай ма?
Dialogue: 0,0:16:15.97,0:16:19.22,Default,,0,0,0,,Өкінбесеңіз, сүйкімдірек болуға тырысыңыз.
Dialogue: 0,0:16:19.35,0:16:20.60,Default,,0,0,0,,Бұл кәсіпқой!
Dialogue: 0,0:16:20.93,0:16:23.35,Default,,0,0,0,,Келесі фестивальде біз де сонда боламыз.
Dialogue: 0,0:16:23.90,0:16:26.02,Default,,0,0,0,,Сонда біз бүгінгідей өнер көрсетсек,
Dialogue: 0,0:16:26.15,0:16:27.11,Default,,0,0,0,,Сіздің тұтынушыларыңыз...
Dialogue: 0,0:16:27.77,0:16:29.36,Default,,0,0,0,,Мен бәрін әкелемін!
Dialogue: 0,0:16:30.44,0:16:31.36,Default,,0,0,0,,Хамф!
Dialogue: 0,0:16:32.70,0:16:33.86,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:34.41,0:16:35.87,Default,,0,0,0,,Бұл соғыс жариялау.
Dialogue: 0,0:16:38.54,0:16:40.12,Default,,0,0,0,,Момо Хан!
Dialogue: 0,0:16:40.50,0:16:42.62,Default,,0,0,0,,Біз ұмытпаймыз!
Dialogue: 0,0:16:44.04,0:16:44.96,Default,,0,0,0,,Ха...
Dialogue: 0,0:16:47.50,0:16:49.00,Default,,0,0,0,,Нина мінеді
Dialogue: 0,0:16:49.13,0:16:50.55,Default,,0,0,0,,[Қозғалтқышты іске қосу дыбысы]
Dialogue: 0,0:16:54.09,0:16:55.51,Default,,0,0,0,,Сіз бұл қызды танисыз ба?
Dialogue: 0,0:16:56.59,0:16:59.68,Default,,0,0,0,,Кел, мен бейтаныс адаммын.
Dialogue: 0,0:17:02.85,0:17:05.02,Default,,0,0,0,,Боқ...
Dialogue: 0,0:17:05.77,0:17:06.73,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:17:06.86,0:17:08.23,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:08.36,0:17:09.69,Default,,0,0,0,,Момока-сан
Dialogue: 0,0:17:09.82,0:17:10.94,Default,,0,0,0,,Не?
Dialogue: 0,0:17:11.36,0:17:14.53,Default,,0,0,0,,Мен күткендей Момоканы ұнатамын.
Dialogue: 0,0:17:15.61,0:17:17.03,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:17:19.12,0:17:21.16,Default,,0,0,0,,Бұл қазірдің өзінде шешілген жоқ па?
Dialogue: 0,0:17:23.62,0:17:25.04,Default,,0,0,0,,Мойындау
Dialogue: 0,0:17:27.00,0:17:28.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:30.09,0:17:31.92,Default,,0,0,0,,(Момоканың жылағаны)
Dialogue: 0,0:17:32.05,0:17:35.13,Default,,0,0,0,,[Дыбыс деңгейін көтер] ♪Дұрыс жауап жоқ, жеңіліс жоқ.
Dialogue: 0,0:17:35.26,0:17:36.80,Default,,0,0,0,,♪Менің бүкіл өмірім
Dialogue: 0,0:17:36.93,0:17:40.81,Default,,0,0,0,,♪Бұл менмін, бар болғаны.
Dialogue: 0,0:17:40.93,0:17:47.10,Default,,0,0,0,,♪Енді бұзатын болсақ та, ертең болмайды
Dialogue: 0,0:17:50.44,0:17:51.44,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:17:51.98,0:17:53.03,Default,,0,0,0,,[Есіктің ашылған дыбысы]
Dialogue: 0,0:17:53.44,0:17:55.20,Default,,0,0,0,,Рупа Не?
Dialogue: 0,0:17:56.65,0:17:58.45,Default,,0,0,0,,Сол үшін айттым ғой, солай ма?
Dialogue: 0,0:17:59.66,0:18:00.53,Default,,0,0,0,,Хмф!
Dialogue: 0,0:18:04.00,0:18:04.83,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:18:05.33,0:18:07.83,Default,,0,0,0,,Олар өте қызық балалар.
Dialogue: 0,0:18:08.37,0:18:11.34,Default,,0,0,0,,Қазірдің өзінде! Қанша көп ішсем де
Dialogue: 0,0:18:11.67,0:18:13.05,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:18:13.17,0:18:14.88,Default,,0,0,0,,Мен енді көлік жүргізбеймін.
Dialogue: 0,0:18:15.01,0:18:17.34,Default,,0,0,0,,Қызарып, олай ашуланба.
Dialogue: 0,0:18:17.68,0:18:19.14,Default,,0,0,0,,Бұл пост
Dialogue: 0,0:18:19.51,0:18:21.60,Default,,0,0,0,,Келесі кезекте Момокаға келді.
Dialogue: 0,0:18:21.85,0:18:23.01,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:23.14,0:18:24.93,Default,,0,0,0,,Содан кейін Шыңғыс хан
Dialogue: 0,0:18:25.06,0:18:28.10,Default,,0,0,0,,Бұл шынымен Асахикаваның мамандығы ма?
Dialogue: 0,0:18:28.48,0:18:30.69,Default,,0,0,0,,Тіпті Нинаның да ат сашими болған, солай ма?
Dialogue: 0,0:18:30.81,0:18:33.40,Default,,0,0,0,,Жылқы сашими - Кумамотоның ерекшелігі!
Dialogue: 0,0:18:34.23,0:18:36.82,Default,,0,0,0,,Мен мүлдем мас емеспін.
Dialogue: 0,0:18:37.70,0:18:38.95,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:18:39.53,0:18:40.66,Default,,0,0,0,,Не?
Dialogue: 0,0:18:41.03,0:18:42.24,Default,,0,0,0,,Жақтар...
Dialogue: 0,0:18:43.12,0:18:44.87,Default,,0,0,0,,Хмм... мынаны қараңыз.
Dialogue: 0,0:18:45.16,0:18:46.96,Default,,0,0,0,,Мас қариямен төбелесу
Dialogue: 0,0:18:47.08,0:18:48.75,Default,,0,0,0,,Сыра бөтелкесімен ұру
Dialogue: 0,0:18:48.87,0:18:50.75,Default,,0,0,0,,Сондықтан бұл туралы алаңдамаңыз
Dialogue: 0,0:18:52.42,0:18:54.38,Default,,0,0,0,,Шындығында, мен де солаймын.
Dialogue: 0,0:18:54.67,0:18:55.71,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:18:56.42,0:18:58.59,Default,,0,0,0,,Иә... Менің ойымша.
Dialogue: 0,0:18:58.72,0:19:00.39,Default,,0,0,0,,Мазасыз құбыжық Нина
Dialogue: 0,0:19:01.76,0:19:04.39,Default,,0,0,0,,Мен сізге дәл айтқаныңызды беремін.
Dialogue: 0,0:19:04.51,0:19:06.72,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:19:06.85,0:19:08.85,Default,,0,0,0,,Қайта ашық қызыл түске айналмаңыз.
Dialogue: 0,0:19:08.98,0:19:10.65,Default,,0,0,0,,Бұл пост...
Dialogue: 0,0:19:11.69,0:19:13.27,Default,,0,0,0,,Хаа~
Dialogue: 0,0:19:13.48,0:19:14.90,Default,,0,0,0,,Сіз мұны қанша уақыттан бері істеп жүрсіз?
Dialogue: 0,0:19:15.32,0:19:18.99,Default,,0,0,0,,Жоқ, өйткені мен шынымен өлемін деп ойладым.
Dialogue: 0,0:19:19.28,0:19:20.11,Default,,0,0,0,,[сықырлау...]
Dialogue: 0,0:19:20.24,0:19:22.20,Default,,0,0,0,,Кенет тек ыстық ауа шықты...
Dialogue: 0,0:19:22.32,0:19:23.41,Default,,0,0,0,,Ааах…
Dialogue: 0,0:19:23.74,0:19:28.29,Default,,0,0,0,,Түні бойы ыстық болды, мен ұйықтай алмаймын.
Dialogue: 0,0:19:28.54,0:19:29.66,Default,,0,0,0,,Ұйықтама!
Dialogue: 0,0:19:29.91,0:19:31.00,Default,,0,0,0,,(Сүйек сынуының дыбысы)
Dialogue: 0,0:19:31.12,0:19:34.42,Default,,0,0,0,,Мен әннің сөзін де, әнді де мерекеге дейін жөндеп алуым керек.
Dialogue: 0,0:19:34.96,0:19:36.63,Default,,0,0,0,,Сіз оны түзетесіз бе?
Dialogue: 0,0:19:37.01,0:19:39.84,Default,,0,0,0,,Маған қазір ұнайды.
Dialogue: 0,0:19:39.97,0:19:40.93,Default,,0,0,0,,Мистер Столкер
Dialogue: 0,0:19:41.47,0:19:43.89,Default,,0,0,0,,Момока-сан неге көңілі толмайды?
Dialogue: 0,0:19:44.26,0:19:46.35,Default,,0,0,0,,Ал, мен не айтайын...
Dialogue: 0,0:19:46.47,0:19:49.18,Default,,0,0,0,,Бір сөзбен айтқанда, қарапайым...
Dialogue: 0,0:19:49.73,0:19:50.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:52.60,0:19:54.56,Default,,0,0,0,,Маған неге айтпадың?
Dialogue: 0,0:19:55.02,0:19:59.99,Default,,0,0,0,,Момоканың жаңа әні «біраз тартымды болды» деп жүрмін...
Dialogue: 0,0:20:01.70,0:20:02.78,Default,,0,0,0,,Бөлек
Dialogue: 0,0:20:03.45,0:20:05.12,Default,,0,0,0,,Өйткені мен оны жақсы деп ойладым
Dialogue: 0,0:20:05.99,0:20:08.66,Default,,0,0,0,,Олай болса, жақсы.
Dialogue: 0,0:20:12.29,0:20:14.96,Default,,0,0,0,,Әдеттегідей мен мүлде тамақ жемеймін.
Dialogue: 0,0:20:15.63,0:20:17.59,Default,,0,0,0,,Олай істесең өлесің.
Dialogue: 0,0:20:17.80,0:20:18.80,Default,,0,0,0,,[Қоңырау дыбысы]
Dialogue: 0,0:20:19.38,0:20:20.80,Default,,0,0,0,,･･･
Dialogue: 0,0:20:20.92,0:20:22.88,Default,,0,0,0,,Салқындаған соң үйге барыңыз.
Dialogue: 0,0:20:23.05,0:20:25.35,Default,,0,0,0,,Бұл өте өлтіреді!
Dialogue: 0,0:20:25.47,0:20:28.64,Default,,0,0,0,,Сіз келесі аптаға дейін келмейсіз, солай ма? салқындатқышты жөндеу
Dialogue: 0,0:20:28.77,0:20:30.31,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:20:30.68,0:20:33.48,Default,,0,0,0,,Момоканың үйінде кондиционер жоқ па?
Dialogue: 0,0:20:33.60,0:20:36.52,Default,,0,0,0,,Иә, бірақ Момока түнгі ауысымда жұмыс істейді...
Dialogue: 0,0:20:37.48,0:20:39.57,Default,,0,0,0,,Бұл сәл әлсіз емес пе? жел
Dialogue: 0,0:20:40.15,0:20:41.99,Default,,0,0,0,,Ах [сықырлау...]
Dialogue: 0,0:20:42.11,0:20:43.03,Default,,0,0,0,,[Бофун! ]
Dialogue: 0,0:20:43.15,0:20:44.16,Default,,0,0,0,,[Домофон дыбысы]
Dialogue: 0,0:20:44.28,0:20:45.99,Default,,0,0,0,,О, па-ва-фу-ру!
Dialogue: 0,0:20:46.20,0:20:47.87,Default,,0,0,0,,Әр шулы
Dialogue: 0,0:20:48.12,0:20:49.83,Default,,0,0,0,,Қандай тамаша бөлме.
Dialogue: 0,0:20:50.16,0:20:51.12,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:20:51.25,0:20:52.33,Default,,0,0,0,,[Смартфонның хабарландыру дыбысы]
Dialogue: 0,0:20:53.25,0:20:54.87,Default,,0,0,0,,Ах Момока-сан
Dialogue: 0,0:20:55.29,0:20:58.00,Default,,0,0,0,,Мен түнгі ауысымдамын. Бұл жақын жерде, мен сені кейінірек көремін.
Dialogue: 0,0:20:58.34,0:20:59.21,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:20:59.34,0:21:01.76,Default,,0,0,0,,Кәне, бәріміз бірге кешкі ас ішейік.
Dialogue: 0,0:21:01.88,0:21:02.72,Default,,0,0,0,,Міне!
Dialogue: 0,0:21:03.55,0:21:05.76,Default,,0,0,0,,Неге олай сөйлеп тұрсың?
Dialogue: 0,0:21:06.30,0:21:09.01,Default,,0,0,0,,Сіз мұны бір сағатқа ғана айттыңыз, солай ма?
Dialogue: 0,0:21:09.43,0:21:10.26,Default,,0,0,0,,Әй...
Dialogue: 0,0:21:11.81,0:21:13.60,Default,,0,0,0,,Соңғы пойыз жүрді
Dialogue: 0,0:21:13.73,0:21:14.77,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:21:14.89,0:21:16.02,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:16.27,0:21:19.02,Default,,0,0,0,,Әу бастан көздегенің осы!
Dialogue: 0,0:21:19.36,0:21:21.82,Default,,0,0,0,,Ал, карта ойнаймыз.
Dialogue: 0,0:21:21.94,0:21:23.28,Default,,0,0,0,,Дайын бол!
Dialogue: 0,0:21:26.28,0:21:27.87,Default,,0,0,0,,[Тоққыл дыбыс]
Dialogue: 0,0:21:28.20,0:21:29.62,Default,,0,0,0,,[Есіктің ашылған дыбысы]
Dialogue: 0,0:21:34.87,0:21:36.50,Default,,0,0,0,,Сіз алдымен ұйықтайсыз ба?
Dialogue: 0,0:21:36.62,0:21:37.71,Default,,0,0,0,,Заттарыңды үйге әкетуді ұмытып қалғансың ғой…
Dialogue: 0,0:21:37.83,0:21:40.84,Default,,0,0,0,,Карта ойнауды немесе басқа нәрсені үш адам жасай алады, солай ма?
Dialogue: 0,0:21:41.38,0:21:43.46,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,0:21:45.43,0:21:46.76,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:21:47.93,0:21:50.26,Default,,0,0,0,,Шағымыңыз болса айтыңыз.
Dialogue: 0,0:21:50.39,0:21:51.51,Default,,0,0,0,,Шағым?
Dialogue: 0,0:21:51.76,0:21:53.77,Default,,0,0,0,,Неге шағымданасыз?
Dialogue: 0,0:21:57.19,0:21:58.81,Default,,0,0,0,,[Есік жабылған дыбыс]
Dialogue: 0,0:22:01.73,0:22:02.86,Default,,0,0,0,,Мен жеңілдім...
Dialogue: 0,0:22:03.19,0:22:05.32,Default,,0,0,0,,Бұл қандай жағдай?
Dialogue: 0,0:22:05.53,0:22:07.36,Default,,0,0,0,,Бастапқы себеп – Нина
Dialogue: 0,0:22:07.49,0:22:10.62,Default,,0,0,0,,Жоқ! Біріншіден, бұл менің салқындатқышым, солай ма?
Dialogue: 0,0:22:10.74,0:22:12.49,Default,,0,0,0,,Тек шыдамды болыңыз!
Dialogue: 0,0:22:12.79,0:22:13.75,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:22:14.08,0:22:16.41,Default,,0,0,0,,Даналық туралы не деуге болады? Мен ұйықтап қалдым
Dialogue: 0,0:22:16.87,0:22:19.13,Default,,0,0,0,,Әнді айтпадың ба?
Dialogue: 0,0:22:19.38,0:22:20.63,Default,,0,0,0,,Атап айтқанда...
Dialogue: 0,0:22:20.96,0:22:22.09,Default,,0,0,0,,Мен...
Dialogue: 0,0:22:22.21,0:22:24.63,Default,,0,0,0,,Ол бірдеңе айтқысы келген сияқты...
Dialogue: 0,0:22:24.92,0:22:26.09,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:22:26.22,0:22:27.34,Default,,0,0,0,,Тоңазытқышта
Dialogue: 0,0:22:27.47,0:22:29.39,Default,,0,0,0,,Жылыса жаман, солай ма?
Dialogue: 0,0:22:29.51,0:22:32.51,Default,,0,0,0,,Сені әжең тауып алса не болады деп ойлайсың?
Dialogue: 0,0:22:32.72,0:22:36.27,Default,,0,0,0,,Жарайды, таңға дейін ішіңіз...
Dialogue: 0,0:22:36.89,0:22:37.73,Default,,0,0,0,,Жылан?
Dialogue: 0,0:22:37.85,0:22:39.52,Default,,0,0,0,,Бұл Томо-чанның үй жануары.
Dialogue: 0,0:22:39.65,0:22:42.52,Default,,0,0,0,,Жарайды, улы емес, жұмсақ...
Dialogue: 0,0:22:42.73,0:22:44.53,Default,,0,0,0,,Ауыр!?
Dialogue: 0,0:22:44.65,0:22:45.57,Default,,0,0,0,,Моттайнай
Dialogue: 0,0:22:45.69,0:22:47.15,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:22:47.28,0:22:48.53,Default,,0,0,0,,Не? [Есік жабылған дыбыс]
Dialogue: 0,0:22:49.61,0:22:50.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:50.66,0:22:53.79,Default,,0,0,0,,Ха ха ха ха... (Нина) Момока-сан? Момока-сан?
Dialogue: 0,0:22:53.91,0:22:56.08,Default,,0,0,0,,Мен ол жерде тұрып қалғым келмейді!
Dialogue: 0,0:22:56.20,0:22:58.12,Default,,0,0,0,,Оны тастаңыз! Жарайды, асығыңыз!
Dialogue: 0,0:22:58.25,0:23:00.71,Default,,0,0,0,,Момока жыландармен жақсы қарым-қатынаста болмады.
Dialogue: 0,0:23:00.83,0:23:02.13,Default,,0,0,0,,Бұл ескірген.
Dialogue: 0,0:23:02.25,0:23:04.92,Default,,0,0,0,,Бұл жылан! Бұл жылан! Жарайсыңдар ма!?
Dialogue: 0,0:23:05.05,0:23:07.55,Default,,0,0,0,,Nii~ Әсіресе...
Dialogue: 0,0:23:07.67,0:23:08.67,Default,,0,0,0,,Бұл біртүрлі!
Dialogue: 0,0:23:09.18,0:23:12.26,Default,,0,0,0,,Төрт қыздың бәрі жақсы!
Dialogue: 0,0:23:12.39,0:23:13.68,Default,,0,0,0,,Біраз уақыт бірге тұрсақ
Dialogue: 0,0:23:14.01,0:23:16.18,Default,,0,0,0,,Момоканың артында жылан тұр.
Dialogue: 0,0:23:16.31,0:23:18.18,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:23:19.31,0:23:20.69,Default,,0,0,0,,ашылды...?
Dialogue: 0,0:23:20.81,0:23:22.44,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:23:22.77,0:23:23.65,Default,,0,0,0,,Керемет сыра!
Dialogue: 0,0:23:23.77,0:23:25.11,Default,,0,0,0,,Тоқта, күт!
Dialogue: 0,0:23:25.23,0:23:29.53,Default,,0,0,0,,Қалай болғанда да, ол қазір Томо-чанның бөлмесінде!
Dialogue: 0,0:23:30.07,0:23:31.82,Default,,0,0,0,,Қазір шығыңыз.
Dialogue: 0,0:23:31.95,0:23:33.70,Default,,0,0,0,,Сәл сынған...
Dialogue: 0,0:23:34.03,0:23:35.74,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:23:36.08,0:23:38.41,Default,,0,0,0,,Мен енді бала емеспін!
Dialogue: 0,0:23:38.54,0:23:39.91,Default,,0,0,0,,Нина-сан қатты бұзылды!
Dialogue: 0,0:23:41.33,0:23:42.42,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:23:42.54,0:23:43.67,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:23:44.13,0:23:45.29,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:23:45.92,0:23:47.55,Default,,0,0,0,,Қайта келме!
Dialogue: 0,0:23:48.92,0:23:50.63,Default,,0,0,0,,Сосын мен толық емес жұмысқа барамын.
Dialogue: 0,0:23:51.01,0:23:52.59,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:23:52.72,0:23:54.64,Default,,0,0,0,,Жылан, одан құтыл.
Dialogue: 0,0:23:56.18,0:23:57.77,Default,,0,0,0,,Айтпақшы, Хэби Чан ше?
Dialogue: 0,0:23:57.89,0:24:01.44,Default,,0,0,0,,Субару-сан мұнымен айналысатынын айтты.
Dialogue: 0,0:24:01.73,0:24:03.35,Default,,0,0,0,,Мен жылан болғым келеді...
Dialogue: 0,0:24:03.90,0:24:05.77,Default,,0,0,0,,Әзірге тараңыз.
Dialogue: 0,0:24:06.19,0:24:07.78,Default,,0,0,0,,Лупа, кеттік.
Dialogue: 0,0:24:07.90,0:24:10.40,Default,,0,0,0,,Мен үйге баруым керек...
Dialogue: 0,0:24:10.53,0:24:12.86,Default,,0,0,0,,Е, мен жалғызбын ба?
Dialogue: 0,0:24:12.99,0:24:14.24,Default,,0,0,0,,Тәжірибе болмаса да
Dialogue: 0,0:24:14.37,0:24:17.41,Default,,0,0,0,,Неге мен сенімен бетпе-бет кездесуім керек?
Dialogue: 0,0:24:18.12,0:24:21.58,Default,,0,0,0,,Момока-сан мұндай нәрселердің де маңызды екенін айтты.
Dialogue: 0,0:24:21.71,0:24:26.50,Default,,0,0,0,,Аа, егер сізде уақыт болса, менің жаттығуымды көруге қарсы ма едіңіз?
Dialogue: 0,0:24:26.63,0:24:27.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:27.59,0:24:30.09,Default,,0,0,0,,Мен үйге барып, гитараны алайын!
Dialogue: 0,0:24:31.80,0:24:33.22,Default,,0,0,0,,[Цикада дыбысы]
Dialogue: 0,0:24:33.55,0:24:35.43,Default,,0,0,0,,Бұл акустикалық ма?
Dialogue: 0,0:24:35.55,0:24:36.43,Default,,0,0,0,,Иә
Dialogue: 0,0:24:36.80,0:24:38.43,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:24:38.68,0:24:45.10,Default,,0,0,0,,[Гитара орындауы]
Dialogue: 0,0:24:46.15,0:24:49.94,Default,,0,0,0,,[Электр гитара өнімділігі]
Dialogue: 0,0:24:50.32,0:24:53.45,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен оны келесі тікелей эфирімде сынап көруді ойлаймын.
Dialogue: 0,0:24:53.57,0:24:55.57,Default,,0,0,0,,Мен қатты жақсардым
Dialogue: 0,0:24:55.70,0:24:56.70,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:24:56.95,0:25:00.16,Default,,0,0,0,,Егер басқа гитара ойнатқыш болса, дыбыс жуанырақ болады...
Dialogue: 0,0:25:00.29,0:25:01.83,Default,,0,0,0,,Мүмкін емес (бұрынғы мүше В) Иә?
Dialogue: 0,0:25:02.62,0:25:06.04,Default,,0,0,0,,Сол қолдармен жанды дауыста орындау әзіл емес.
Dialogue: 0,0:25:08.38,0:25:10.67,Default,,0,0,0,,…чан? Сатоши-чан?
Dialogue: 0,0:25:10.96,0:25:11.84,Default,,0,0,0,,Сатоши-чан!
Dialogue: 0,0:25:11.96,0:25:12.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:12.92,0:25:14.26,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:25:16.01,0:25:16.97,Default,,0,0,0,,Лупа ше?
Dialogue: 0,0:25:17.09,0:25:19.39,Default,,0,0,0,,Мен сарапшы емеспін
Dialogue: 0,0:25:19.51,0:25:22.98,Default,,0,0,0,,Айта берсем, мен де гитарада маман емеспін.
Dialogue: 0,0:25:23.14,0:25:25.98,Default,,0,0,0,,Бірақ сіз музыка туралы көп білесіз, солай ма?
Dialogue: 0,0:25:27.48,0:25:28.48,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:25:32.40,0:25:33.99,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:25:34.28,0:25:35.74,Default,,0,0,0,,Сіз мұны хобби ретінде жасасаңыз...
Dialogue: 0,0:25:35.86,0:25:36.86,Default,,0,0,0,,Хобби?
Dialogue: 0,0:25:36.99,0:25:38.74,Default,,0,0,0,,Бұл сахнада мүмкін емес дегенді білдіре ме?
Dialogue: 0,0:25:41.83,0:25:43.87,Default,,0,0,0,,Сахнада ойнағың келе ме?
Dialogue: 0,0:25:44.00,0:25:44.91,Default,,0,0,0,,Иә
Dialogue: 0,0:25:45.04,0:25:49.00,Default,,0,0,0,,Мен өткен күні Дайданың концертіне бардым да, іштей ойладым, солай ма?
Dialogue: 0,0:25:49.25,0:25:51.42,Default,,0,0,0,,Мен жақсарғым келеді
Dialogue: 0,0:25:51.96,0:25:54.34,Default,,0,0,0,,Момока-санға сенбе
Dialogue: 0,0:25:54.59,0:25:57.51,Default,,0,0,0,,Мен саған көмектесіп, мұны бірге істегім келеді.
Dialogue: 0,0:25:58.76,0:26:01.01,Default,,0,0,0,,Аа, әрине барлығына.
Dialogue: 0,0:26:02.01,0:26:06.10,Default,,0,0,0,,Егер түзету керек нәрсе болса, маған хабарлаңыз.
Dialogue: 0,0:26:07.98,0:26:09.11,Default,,0,0,0,,Заттарыңды үйге әкетуді ұмытып қалғансың ғой…
Dialogue: 0,0:26:09.44,0:26:12.32,Default,,0,0,0,,Айтшы~ Томо-чан!
Dialogue: 0,0:26:15.11,0:26:17.36,Default,,0,0,0,,Гитарада ойнайды
Dialogue: 0,0:26:17.70,0:26:20.37,Default,,0,0,0,,Бүкіл өміріңді алса да, оны дұрыс түсінбейсің!
Dialogue: 0,0:26:21.83,0:26:24.62,Default,,0,0,0,,[Цикада дыбысы]
Dialogue: 0,0:26:28.92,0:26:30.13,Default,,0,0,0,,[Пернетақтаны түрту дыбысы]
Dialogue: 0,0:26:30.42,0:26:32.63,Default,,0,0,0,,Сіз мұны бірнеше рет айттыңыз! Шынымен...
Dialogue: 0,0:26:34.63,0:26:37.13,Default,,0,0,0,,Ақылмен сөйлеме.
Dialogue: 0,0:26:37.43,0:26:40.30,Default,,0,0,0,,Бала кезінен фортепианода ойнағаны үшін көптеген марапаттарға ие болған адаммен.
Dialogue: 0,0:26:40.43,0:26:42.14,Default,,0,0,0,,Біз әртүрліміз
Dialogue: 0,0:26:42.47,0:26:43.81,Default,,0,0,0,,Мен мұны істегім келмейді
Dialogue: 0,0:26:44.14,0:26:46.77,Default,,0,0,0,,Мм... (Бұрынғы мүше А) Сен аузыңды жап.
Dialogue: 0,0:26:46.89,0:26:48.19,Default,,0,0,0,,[Есіктің ашылу дыбысы]
Dialogue: 0,0:26:51.73,0:26:52.94,Default,,0,0,0,,Я...
Dialogue: 0,0:26:53.15,0:26:57.61,Default,,0,0,0,,Білесің бе, мен кеше сол қызбен сөйлестім...
Dialogue: 0,0:27:02.03,0:27:02.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:05.20,0:27:08.04,Default,,0,0,0,,Кішкене салқындап барады, солай емес пе?
Dialogue: 0,0:27:09.25,0:27:10.42,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:27:10.67,0:27:13.50,Default,,0,0,0,,Кейде кондиционерсіз жүру жақсы.
Dialogue: 0,0:27:13.63,0:27:14.80,Default,,0,0,0,,[Смартфонның хабарландыру дыбысы]
Dialogue: 0,0:27:20.38,0:27:23.14,Default,,0,0,0,,Мен бақытты болдым, Нина-сан.
Dialogue: 0,0:27:25.60,0:27:27.68,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес...
Dialogue: 0,0:27:30.27,0:27:32.23,Default,,0,0,0,,Қай жағын түсірдің?
Dialogue: 0,0:27:32.36,0:27:33.40,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:27:33.52,0:27:40.61,Default,,0,0,0,,[Гитара орындауы]
Dialogue: 0,0:27:40.99,0:27:41.99,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:27:42.11,0:27:43.91,Default,,0,0,0,,Сатоси не деді?
Dialogue: 0,0:27:44.24,0:27:46.62,Default,,0,0,0,,«Үй ойнағандай сезінетін гитара»
Dialogue: 0,0:27:46.74,0:27:49.41,Default,,0,0,0,,«Бұл өмір бойы қажет болса да, ол ешқашан қалыпты болмайды»
Dialogue: 0,0:27:49.75,0:27:51.87,Default,,0,0,0,,Уау, бұл көп нәрсені айтуға болады.
Dialogue: 0,0:27:52.00,0:27:54.84,Default,,0,0,0,,Менің ойымша, бұл баланың жеке басына қатысты.
Dialogue: 0,0:27:57.17,0:27:58.67,Default,,0,0,0,,Мотивация жоғалды ма?
Dialogue: 0,0:27:59.84,0:28:00.67,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:28:01.09,0:28:03.80,Default,,0,0,0,,Егер сізде солай болса, жақсы.
Dialogue: 0,0:28:04.18,0:28:06.93,Default,,0,0,0,,Сонымен Субару-чан не ойлады?
Dialogue: 0,0:28:07.64,0:28:09.68,Default,,0,0,0,,Мен Сатосимен келісемін деп ойлаймын.
Dialogue: 0,0:28:10.27,0:28:11.19,Default,,0,0,0,,Мен...
Dialogue: 0,0:28:11.31,0:28:14.69,Default,,0,0,0,,Мен көп жаттыққандықтан істей аламын деп ойладым.
Dialogue: 0,0:28:15.02,0:28:18.69,Default,,0,0,0,,Жарайды, оны бір-екі жылда жасауға болмайды, солай ма?
Dialogue: 0,0:28:18.98,0:28:23.16,Default,,0,0,0,,Мен әуесқоймын ба, бәрібір, бірақ мен бәрібір кәсіби деңгейді мақсат етіп отырмын.
Dialogue: 0,0:28:23.57,0:28:26.49,Default,,0,0,0,,Бірақ Субару-чан қалай болса да жақсы жүр.
Dialogue: 0,0:28:26.83,0:28:27.99,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:28:28.33,0:28:32.50,Default,,0,0,0,,Интеллектуалды түрде ойлаймын, тіпті менің де айтарым көп.
Dialogue: 0,0:28:32.62,0:28:35.46,Default,,0,0,0,,Бірақ сіз бұлай айтқан жоқсыз, солай ма?
Dialogue: 0,0:28:35.58,0:28:38.50,Default,,0,0,0,,Жарайды, Нина сияқты мен де барып сұрамаймын.
Dialogue: 0,0:28:40.26,0:28:41.72,Default,,0,0,0,,[Домофон дыбысы]
Dialogue: 0,0:28:41.84,0:28:42.76,Default,,0,0,0,,Ах
Dialogue: 0,0:28:45.22,0:28:46.26,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:28:46.39,0:28:49.27,Default,,0,0,0,,Мен оны артқы жағындағы аквариумға қойдым, сондықтан оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:28:50.22,0:28:52.56,Default,,0,0,0,,Мен тамақ жеген жоқпын, жарай ма?
Dialogue: 0,0:28:52.69,0:28:53.52,Default,,0,0,0,,Бөлек
Dialogue: 0,0:28:53.64,0:28:56.23,Default,,0,0,0,,[Гитара орындауы]
Dialogue: 0,0:28:56.36,0:28:57.27,Default,,0,0,0,,Ах, Сатоши-чан
Dialogue: 0,0:28:58.61,0:28:59.78,Default,,0,0,0,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,0:29:00.07,0:29:03.28,Default,,0,0,0,,Иә, мен оны Субару-чанға да тыңдадым.
Dialogue: 0,0:29:03.40,0:29:04.28,Default,,0,0,0,,Жақсы…
Dialogue: 0,0:29:04.82,0:29:05.91,Default,,0,0,0,,Itata…
Dialogue: 0,0:29:07.99,0:29:09.66,Default,,0,0,0,,Эй, аа...
Dialogue: 0,0:29:10.62,0:29:11.54,Default,,0,0,0,,Сатоши-чан?
Dialogue: 0,0:29:14.54,0:29:15.62,Default,,0,0,0,,Еріту?
Dialogue: 0,0:29:17.25,0:29:18.84,Default,,0,0,0,,Токиоға келіңіз
Dialogue: 0,0:29:18.96,0:29:21.17,Default,,0,0,0,,Мүшелерді желіде жинаңыз
Dialogue: 0,0:29:21.30,0:29:22.97,Default,,0,0,0,,Топты бастау...
Dialogue: 0,0:29:23.09,0:29:27.30,Default,,0,0,0,,Томо-чан мен Лупа-сан сонда кездесті ме?
Dialogue: 0,0:29:27.55,0:29:31.93,Default,,0,0,0,,Иә, меннен басқа барабаншы мен гитарашы да болды.
Dialogue: 0,0:29:32.35,0:29:35.02,Default,,0,0,0,,Сіз кәсіпқой болуды мақсат еткеніңізді айттыңыз...
Dialogue: 0,0:29:35.27,0:29:38.31,Default,,0,0,0,,Жарайды, бәрі осылай дейді.
Dialogue: 0,0:29:38.90,0:29:42.32,Default,,0,0,0,,Себебі біз бір сезімді бөлісетін достармыз деп есептейміз.
Dialogue: 0,0:29:42.61,0:29:46.45,Default,,0,0,0,,Сол балаларға қойылатын талап күшейе түсуде...
Dialogue: 0,0:29:46.86,0:29:50.83,Default,,0,0,0,,Рупа-сан әлі де Томо-чанмен бірге болды, солай ма?
Dialogue: 0,0:29:51.95,0:29:55.62,Default,,0,0,0,,Томо-чан жалғыз келетінін айтты.
Dialogue: 0,0:29:57.37,0:29:58.96,Default,,0,0,0,,Сол жаста...
Dialogue: 0,0:30:00.09,0:30:03.46,Default,,0,0,0,,Содан менің үйімде бірге тұра бастадық.
Dialogue: 0,0:30:03.59,0:30:05.72,Default,,0,0,0,,Бірінші рет екі адам бен-шоуга ойнады
Dialogue: 0,0:30:06.30,0:30:08.59,Default,,0,0,0,,Менде бірнеше кәсіби мүмкіндіктер болды...
Dialogue: 0,0:30:09.05,0:30:13.47,Default,,0,0,0,,Осылайша мен мұны істеген сайын, мен біреумен соқтығысып, оны құртып аламын ...
Dialogue: 0,0:30:13.89,0:30:19.10,Default,,0,0,0,,Менің ойымша, сондықтан мен өз ойымды айтуға қорқамын.
Dialogue: 0,0:30:19.81,0:30:24.19,Default,,0,0,0,,Шын сезімімді көрсетсем, жаман болар ма деп қорықтым...
Dialogue: 0,0:30:26.86,0:30:28.70,Default,,0,0,0,,Қалай ойлайсың, Момока-сан?
Dialogue: 0,0:30:29.11,0:30:30.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:30.70,0:30:31.70,Default,,0,0,0,,Менің гитарам
Dialogue: 0,0:30:32.24,0:30:35.12,Default,,0,0,0,,Сахнада бірге өнер көрсете аламыз деп ойлайсың ба?
Dialogue: 0,0:30:39.54,0:30:40.46,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:30:41.04,0:30:42.04,Default,,0,0,0,,Ха...
Dialogue: 0,0:30:45.51,0:30:46.76,Default,,0,0,0,,Мұндай емес қой. (Миямура) Шынымен бе?
Dialogue: 0,0:30:48.84,0:30:50.47,Default,,0,0,0,,[Есіктің ашылған дыбысы] Мен үйдемін.
Dialogue: 0,0:30:51.72,0:30:53.31,Default,,0,0,0,,тым кеш болды.
Dialogue: 0,0:30:54.64,0:30:56.48,Default,,0,0,0,,А, мен жедім!
Dialogue: 0,0:30:56.77,0:30:57.73,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:30:59.60,0:31:00.77,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:31:01.86,0:31:04.23,Default,,0,0,0,,Қанша сақ, не ұялшақ болса да
Dialogue: 0,0:31:04.65,0:31:08.15,Default,,0,0,0,,Қарау сізді ешқайда апармайды.
Dialogue: 0,0:31:08.28,0:31:09.61,Default,,0,0,0,,Кездесу аяқталғаннан кейін де, үйге келген соң қылмыскерлерді үкім шығарумен қайта айналысамын.
Dialogue: 0,0:31:10.78,0:31:14.45,Default,,0,0,0,,Жүр, Сатоси, серуендеуді қалайсың ба?
Dialogue: 0,0:31:16.37,0:31:18.75,Default,,0,0,0,,Ол мүлдем суымайды.
Dialogue: 0,0:31:20.08,0:31:22.59,Default,,0,0,0,,Біз ертең тағы да жаттығу жасаймыз, солай ма?
Dialogue: 0,0:31:23.29,0:31:25.63,Default,,0,0,0,,Жаңбыр жаумайды деп үміттенемін...
Dialogue: 0,0:31:27.05,0:31:29.43,Default,,0,0,0,,Бұл дұрыс емес, иә?
Dialogue: 0,0:31:29.84,0:31:32.18,Default,,0,0,0,,Бұл жақсы емес, сондықтан мен жай ғана «жоқ» дедім.
Dialogue: 0,0:31:33.05,0:31:35.64,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,0:31:37.64,0:31:40.81,Default,,0,0,0,,Олай болса, неліктен ''Оны ойнай аласыз'' дедіңіз?
Dialogue: 0,0:31:40.94,0:31:42.19,Default,,0,0,0,,Бұл...
Dialogue: 0,0:31:42.81,0:31:45.98,Default,,0,0,0,,Өйткені Нина мұны күтеді, солай ма?
Dialogue: 0,0:31:46.11,0:31:49.45,Default,,0,0,0,,Сахнада Момокамен бірге өнер көрсеткісі келеді...
Dialogue: 0,0:31:50.03,0:31:52.57,Default,,0,0,0,,Сондықтан мен Томо-чаннан сұрадым.
Dialogue: 0,0:31:53.03,0:31:54.70,Default,,0,0,0,,Себебі мен жақсарғым келеді
Dialogue: 0,0:31:54.83,0:31:57.54,Default,,0,0,0,,үшін осылай дейді.
Dialogue: 0,0:31:57.66,0:32:00.25,Default,,0,0,0,,«Мен байсалдымын» немесе «Мен жақсарғым келеді»
Dialogue: 0,0:32:00.62,0:32:02.00,Default,,0,0,0,,Бірақ соңында...
Dialogue: 0,0:32:02.12,0:32:06.75,Default,,0,0,0,,Менің айтқым келетіні: «Мені таңданғым келеді» немесе «Мен ыңғайлы ән айтқым келеді» ...
Dialogue: 0,0:32:08.51,0:32:14.51,Default,,0,0,0,,[Гитара орындауы]
Dialogue: 0,0:32:16.10,0:32:17.77,Default,,0,0,0,,Сіз оны естисіз, солай ма?
Dialogue: 0,0:32:17.89,0:32:21.89,Default,,0,0,0,,[Гитара орындауы]
Dialogue: 0,0:32:24.40,0:32:26.40,Default,,0,0,0,,[Гитара орындауы]
Dialogue: 0,0:32:26.52,0:32:28.61,Default,,0,0,0,,Ита... Уф...
Dialogue: 0,0:32:29.78,0:32:31.78,Default,,0,0,0,,Міне, осылай...
Dialogue: 0,0:32:31.90,0:32:32.74,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:32:32.86,0:32:34.49,Default,,0,0,0,,Міне!
Dialogue: 0,0:32:34.62,0:32:36.53,Default,,0,0,0,,Мені тыңда, мына саусақ!
Dialogue: 0,0:32:36.66,0:32:37.91,Default,,0,0,0,,[Jakajakajaka…]
Dialogue: 0,0:32:38.66,0:32:41.16,Default,,0,0,0,,[Гитара орындауы]
Dialogue: 0,0:32:41.29,0:32:43.54,Default,,0,0,0,,Мен үш адамның тірі екенін көргенде
Dialogue: 0,0:32:43.75,0:32:46.46,Default,,0,0,0,,Мен анық түсіндім.
Dialogue: 0,0:32:47.04,0:32:49.71,Default,,0,0,0,,«Бұл адамдар ауыр».
Dialogue: 0,0:32:50.30,0:32:53.05,Default,,0,0,0,,«Бұл дәмге немесе мазмұнға ешқандай қатысы жоқ».
Dialogue: 0,0:32:53.34,0:32:56.60,Default,,0,0,0,,«Мен сахнада шындап тұрмын».
Dialogue: 0,0:32:57.18,0:32:58.01,Default,,0,0,0,,Ха...
Dialogue: 0,0:32:59.01,0:33:01.10,Default,,0,0,0,,Томо-чан да нені қалайды
Dialogue: 0,0:33:01.48,0:33:04.31,Default,,0,0,0,,«Міне, солай», солай ма?
Dialogue: 0,0:33:05.10,0:33:06.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:06.15,0:33:07.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:07.90,0:33:08.73,Default,,0,0,0,,Хехе
Dialogue: 0,0:33:12.49,0:33:13.32,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,0:33:13.61,0:33:16.82,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:33:17.37,0:33:18.83,Default,,0,0,0,,Эээх…
Dialogue: 0,0:33:19.20,0:33:21.91,Default,,0,0,0,,Хаха...
Dialogue: 0,0:33:26.63,0:33:29.09,Default,,0,0,0,,Мен міндетті түрде жақсарамын!
Dialogue: 0,0:33:30.05,0:33:33.05,Default,,0,0,0,,[Гитара орындауы]
Dialogue: 0,0:33:35.97,0:33:37.09,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:33:37.34,0:33:38.18,Default,,0,0,0,,Хамф!
Dialogue: 0,0:33:39.81,0:33:40.76,Default,,0,0,0,,Хехе
Dialogue: 0,0:33:42.14,0:33:45.48,Default,,0,0,0,,Мен мұндай нәрсені жақсы көремін.
Dialogue: 0,0:33:52.53,0:33:54.15,Default,,0,0,0,,Кішкене үзіліс жасайық
Dialogue: 0,0:33:54.28,0:33:56.11,Default,,0,0,0,,Момока (Момока) Иә?
Dialogue: 0,0:33:56.82,0:34:00.91,Default,,0,0,0,,Менің ойымша, бұл ән қазіргідей қызықсыз болар еді.
Dialogue: 0,0:34:09.33,0:34:10.50,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:34:14.97,0:34:17.47,Default,,0,0,0,,Бұл шынымен танымал ма? біз
Dialogue: 0,0:34:17.68,0:34:19.43,Default,,0,0,0,,Тауарлар да сүйкімді.
Dialogue: 0,0:34:19.60,0:34:22.51,Default,,0,0,0,,Сіз оған біртүрлі ат қойғандықтан.
Dialogue: 0,0:34:22.85,0:34:24.56,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:34:25.27,0:34:27.23,Default,,0,0,0,,Тікенді резеңке жолақ
Dialogue: 0,0:34:27.60,0:34:30.81,Default,,0,0,0,,Менің ойымша, бұл Шин-Кавасакидегіден жақсы сатылуда...
Dialogue: 0,0:34:32.65,0:34:34.49,Default,,0,0,0,,Мм... (Момока) А?
Dialogue: 0,0:34:34.78,0:34:38.49,Default,,0,0,0,,Мен осындай адаммын.
Dialogue: 0,0:34:39.20,0:34:41.58,Default,,0,0,0,,«Алтын садақшы»
Dialogue: 0,0:34:41.70,0:34:42.53,Default,,0,0,0,,Иә
Dialogue: 0,0:34:42.66,0:34:45.00,Default,,0,0,0,,Мен мұны бір жерден естігендей болдым...
Dialogue: 0,0:34:45.12,0:34:46.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:46.71,0:34:48.12,Default,,0,0,0,,Ойын-сауық агенттігі!
Dialogue: 0,0:34:49.29,0:34:50.13,Default,,0,0,0,,Ха...
Dialogue: 0,0:34:51.29,0:34:52.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:34:52.80,0:34:54.46,Default,,0,0,0,,Барлаушы дейсіз бе?
Dialogue: 0,0:34:54.80,0:34:57.22,Default,,0,0,0,,Иә, бұл менің ниетім.
Dialogue: 0,0:34:57.88,0:34:58.72,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:34:59.09,0:35:00.26,Default,,0,0,0,,Шын мәнінде, мен...
Dialogue: 0,0:35:00.39,0:35:02.10,Default,,0,0,0,,Маған гауһар шаңы ұнайды!
Dialogue: 0,0:35:02.26,0:35:03.10,Default,,0,0,0,,Иә
Dialogue: 0,0:35:03.35,0:35:06.43,Default,,0,0,0,,Бірақ маған қазіргі Алмаз шаңы ұнамайды.
Dialogue: 0,0:35:06.56,0:35:09.98,Default,,0,0,0,,Бұл бастапқы топтың сапасының толық жоғалуы.
Dialogue: 0,0:35:10.31,0:35:12.52,Default,,0,0,0,,Миура Момоканы жақсы көреді!
Dialogue: 0,0:35:12.65,0:35:14.11,Default,,0,0,0,,Момока көздеген музыка
Dialogue: 0,0:35:14.23,0:35:16.28,Default,,0,0,0,,Мен оның дұрыс пішінделгенін қалаймын.
Dialogue: 0,0:35:16.40,0:35:18.28,Default,,0,0,0,,Бұл топта бар!
Dialogue: 0,0:35:18.40,0:35:19.66,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:35:20.32,0:35:21.41,Default,,0,0,0,,Жарайды, отырыңыз.
Dialogue: 0,0:35:21.53,0:35:22.37,Default,,0,0,0,,Иә...
Dialogue: 0,0:35:23.37,0:35:26.58,Default,,0,0,0,,Дедус мамандыққа барғалы жатқанда, И
Dialogue: 0,0:35:26.70,0:35:30.87,Default,,0,0,0,,Сондай-ақ, «бұл бұрынғыдай жұмыс істемейді», «заманға сай келмейді».
Dialogue: 0,0:35:31.29,0:35:32.13,Default,,0,0,0,,Иә
Dialogue: 0,0:35:32.50,0:35:35.05,Default,,0,0,0,,Менің ойымша, бұл дұрыс емес.
Dialogue: 0,0:35:35.38,0:35:39.38,Default,,0,0,0,,Шын мәнінде, бүгінгі Дайдаларды жанкүйерлер қабылдады.
Dialogue: 0,0:35:39.93,0:35:42.22,Default,,0,0,0,,Бірақ мұндағы төрт адам
Dialogue: 0,0:35:42.34,0:35:43.97,Default,,0,0,0,,«Мен жарысқым келеді»
Dialogue: 0,0:35:44.14,0:35:47.02,Default,,0,0,0,,«Мен қолданып көргім келген әнді көргім келеді»...
Dialogue: 0,0:35:47.56,0:35:50.02,Default,,0,0,0,,Мен сол сөздерді пайдалануды ойлап отырмын.
Dialogue: 0,0:35:51.19,0:35:52.02,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:35:53.15,0:35:54.02,Default,,0,0,0,,Момока-сан...
Dialogue: 0,0:35:54.36,0:35:55.52,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:35:55.65,0:35:56.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:57.11,0:35:59.70,Default,,0,0,0,,Сіз келесі фестивальге қатысасыз, солай ма?
Dialogue: 0,0:36:00.45,0:36:03.03,Default,,0,0,0,,«Фестивальде өз ізіңді қалдыр»?
Dialogue: 0,0:36:03.28,0:36:04.41,Default,,0,0,0,,Егер сіз көзге түссеңіз
Dialogue: 0,0:36:04.53,0:36:08.33,Default,,0,0,0,,Агенттіктерге дыбыс жазу компанияларына күшті сатылымдар жасау оңайырақ болады.
Dialogue: 0,0:36:08.54,0:36:09.91,Default,,0,0,0,,Жанкүйерлер көп болса
Dialogue: 0,0:36:10.29,0:36:13.71,Default,,0,0,0,,Қазіргі музыкалық стильімізді өзгеріссіз сақтайық.
Dialogue: 0,0:36:14.25,0:36:18.42,Default,,0,0,0,,Сонымен фестиваль кезеңі соңғы тыңдау сияқты ма?
Dialogue: 0,0:36:18.71,0:36:20.47,Default,,0,0,0,,Нина (Нина) Иә
Dialogue: 0,0:36:20.59,0:36:24.22,Default,,0,0,0,,Нина, алдыңғы әннің сөзін ойлап таба аласыз ба?
Dialogue: 0,0:36:24.39,0:36:25.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:26.31,0:36:30.35,Default,,0,0,0,,Сен жазған өлеңімді көргім келеді.
Dialogue: 0,0:36:31.52,0:36:32.35,Default,,0,0,0,,Иә
Dialogue: 0,0:36:32.73,0:36:34.61,Default,,0,0,0,,Мен неге екенін түсінбеймін?
Dialogue: 0,0:36:35.02,0:36:36.32,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:36:36.44,0:36:38.11,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:36:38.23,0:36:40.57,Default,,0,0,0,,Екеуің түсінген сияқтысыңдар.
Dialogue: 0,0:36:43.70,0:36:44.95,Default,,0,0,0,,[Есікті автоматты түрде ашу дыбысы]
Dialogue: 0,0:36:45.07,0:36:47.03,Default,,0,0,0,,Сәлем... Уау!
Dialogue: 0,0:36:48.79,0:36:50.25,Default,,0,0,0,,Не болды?
Dialogue: 0,0:36:50.62,0:36:52.25,Default,,0,0,0,,Неліктен? неге?
Dialogue: 0,0:36:53.00,0:36:54.25,Default,,0,0,0,,Сәлем
Dialogue: 0,0:36:54.54,0:36:57.04,Default,,0,0,0,,Мм... міне Исери деген бала.
Dialogue: 0,0:36:57.17,0:36:59.38,Default,,0,0,0,,Менің ойымша, бұл толық емес жұмыс күні...
Dialogue: 0,0:36:59.84,0:37:00.84,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:37:01.88,0:37:04.59,Default,,0,0,0,,Бүгін вахтада емес сияқтысыз...
Dialogue: 0,0:37:06.22,0:37:08.76,Default,,0,0,0,,Эден академиясының нәтижелері.
Dialogue: 0,0:37:09.10,0:37:10.64,Default,,0,0,0,,Сіз оны іздеп жүрсіз бе?
Dialogue: 0,0:37:11.68,0:37:13.89,Default,,0,0,0,,Лупа мырза... солай ма?
Dialogue: 0,0:37:14.31,0:37:17.19,Default,,0,0,0,,Қазірдің өзінде! Білсеңіздер айтыңыздаршы!
Dialogue: 0,0:37:18.40,0:37:19.23,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:37:21.57,0:37:22.40,Default,,0,0,0,,Ескі…
Dialogue: 0,0:37:26.74,0:37:28.70,Default,,0,0,0,,Сен мұнда неге келдің?
Dialogue: 0,0:37:29.08,0:37:32.62,Default,,0,0,0,,Ху~ Бұл жерде тыныштық сезіледі~
Dialogue: 0,0:37:33.00,0:37:35.29,Default,,0,0,0,,Сіз әлі бизнес туралы естіген жоқсыз, солай ма?
Dialogue: 0,0:37:35.42,0:37:37.79,Default,,0,0,0,,Бұл туралы жай ғана дұрыс айтқан дұрыс емес пе?
Dialogue: 0,0:37:38.09,0:37:39.34,Default,,0,0,0,,бұл бұлыңғыр кадрлардан оны анықтау қиын болар еді.
Dialogue: 0,0:37:40.38,0:37:41.34,Default,,0,0,0,,Иә...
Dialogue: 0,0:37:45.55,0:37:46.89,Default,,0,0,0,,[Құлыпты ашуға тырысқан дыбыс]
Dialogue: 0,0:37:47.01,0:37:47.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:48.43,0:37:50.60,Default,,0,0,0,,Сіз құлыпты ауыстырдыңыз ба?
Dialogue: 0,0:37:51.64,0:37:53.48,Default,,0,0,0,,Мен сонда тұрамын!
Dialogue: 0,0:37:53.93,0:37:55.73,Default,,0,0,0,,Маған жаңа кілт беріңіз!
Dialogue: 0,0:37:56.73,0:37:57.94,Default,,0,0,0,,♬~
Dialogue: 0,0:37:58.06,0:38:01.86,Default,,0,0,0,,үшін, мына жігіт, бәрі, мына жігіт~!
Dialogue: 0,0:38:01.98,0:38:02.90,Default,,0,0,0,,Шулы!
Dialogue: 0,0:38:03.03,0:38:03.86,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:38:04.49,0:38:05.61,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:38:05.90,0:38:06.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:07.49,0:38:10.12,Default,,0,0,0,,Мен толық емес ауысымнан демалыс алдым.
Dialogue: 0,0:38:10.53,0:38:13.12,Default,,0,0,0,,Бұл Томо-чан екеуміздің сыйлығымыз.
Dialogue: 0,0:38:13.54,0:38:14.50,Default,,0,0,0,,Ха...
Dialogue: 0,0:38:16.29,0:38:17.46,Default,,0,0,0,,Неге...
Dialogue: 0,0:38:19.04,0:38:21.50,Default,,0,0,0,,Менің ойымша, сіз Сатоши-чаннан біраз естідіңіз...
Dialogue: 0,0:38:22.05,0:38:25.38,Default,,0,0,0,,Сол күні менің отбасыма телефон соғу жоспарым бар еді.
Dialogue: 0,0:38:25.55,0:38:28.47,Default,,0,0,0,,Жұмыс сәл ұзағырақ болды.
Dialogue: 0,0:38:28.80,0:38:30.47,Default,,0,0,0,,«Ертең кездескенше».
Dialogue: 0,0:38:30.60,0:38:33.02,Default,,0,0,0,,«Мен сенімен кез келген уақытта сөйлесе аламын» деп ойладым.
Dialogue: 0,0:38:34.06,0:38:35.68,Default,,0,0,0,,Бұл соңғы рет болды
Dialogue: 0,0:38:35.93,0:38:36.77,Default,,0,0,0,,А...
Dialogue: 0,0:38:37.06,0:38:41.11,Default,,0,0,0,,Уақыт пен мүмкіндік сіз ойлағаннан да аз.
Dialogue: 0,0:38:41.86,0:38:44.07,Default,,0,0,0,,Өзімен-өзі сөйлесу тітіркендіреді, солай емес пе?
Dialogue: 0,0:38:46.32,0:38:48.53,Default,,0,0,0,,Сіз шынымен де соншалықты мән бересіз бе?
Dialogue: 0,0:38:48.78,0:38:51.28,Default,,0,0,0,,Әдетте мені бәрі жалғыз қалдырады...
Dialogue: 0,0:38:51.58,0:38:53.49,Default,,0,0,0,,[Джаджаяджан! ]
Dialogue: 0,0:38:53.62,0:38:55.29,Default,,0,0,0,,Маған дыбыс әсерлері қажет емес
Dialogue: 0,0:38:55.79,0:38:58.92,Default,,0,0,0,,Түсіндім... Нинаның мұндай әлсіздігі бар ма еді?
Dialogue: 0,0:38:59.71,0:39:00.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:00.79,0:39:03.42,Default,,0,0,0,,Сізді не нәрсеге көбірек сүйрейді?
Dialogue: 0,0:39:03.55,0:39:05.92,Default,,0,0,0,,Бұл емтихан немесе қорқыту емес, солай ма?
Dialogue: 0,0:39:06.59,0:39:09.89,Default,,0,0,0,,Әкең сені жақтамағандықтан емес пе?
Dialogue: 0,0:39:11.80,0:39:13.06,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:39:13.39,0:39:15.39,Default,,0,0,0,,Егер жоқ болса, мен сені кездестіре аламын, солай ма?
Dialogue: 0,0:39:16.02,0:39:17.06,Default,,0,0,0,,Жақында кездесеміз.
Dialogue: 0,0:39:17.56,0:39:18.85,Default,,0,0,0,,Олай болса маған келіңіз.
Dialogue: 0,0:39:18.98,0:39:21.31,Default,,0,0,0,,Оған дейін менің үйіме кіре алмайсың.
Dialogue: 0,0:39:24.02,0:39:24.94,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:39:27.99,0:39:30.70,Default,,0,0,0,,[Алдыңғы есіктің ашылуы мен жабылу дыбысы]
Dialogue: 0,0:39:31.32,0:39:32.70,Default,,0,0,0,,[Джаджа Жан]
Dialogue: 0,0:39:33.78,0:39:34.95,Default,,0,0,0,,Мен келдім...
Dialogue: 0,0:39:37.20,0:39:38.21,Default,,0,0,0,,Я...
Dialogue: 0,0:39:43.04,0:39:44.25,Default,,0,0,0,,(Бекки) Ах, емтихандар аяқталды — ақыры тыныш күндер келді~
Dialogue: 0,0:39:44.38,0:39:45.21,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:39:46.42,0:39:47.71,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:39:53.43,0:39:55.06,Default,,0,0,0,,[Бұтақты соққан дыбыс] Бұл...
Dialogue: 0,0:39:55.47,0:39:56.31,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:39:59.56,0:40:01.39,Default,,0,0,0,,[Аяқтары]
Dialogue: 0,0:40:01.94,0:40:03.23,Default,,0,0,0,,Нина (Нина) Хии
Dialogue: 0,0:40:04.23,0:40:05.61,Default,,0,0,0,,Мен сені іздедім.
Dialogue: 0,0:40:06.57,0:40:07.40,Default,,0,0,0,,Топ?
Dialogue: 0,0:40:08.03,0:40:08.90,Default,,0,0,0,,Иә...
Dialogue: 0,0:40:09.36,0:40:11.78,Default,,0,0,0,,Сіз оны жұмысқа айналдырамын дейсіз бе?
Dialogue: 0,0:40:12.16,0:40:13.37,Default,,0,0,0,,Мен солай ойлаймын
Dialogue: 0,0:40:13.70,0:40:16.79,Default,,0,0,0,,Мен әлдеқашан ойын-сауық агенттігінен ұсыныстар алдым.
Dialogue: 0,0:40:17.29,0:40:20.08,Default,,0,0,0,,Маман болуға бір қадам қалған сияқтысыз.
Dialogue: 0,0:40:20.62,0:40:22.62,Default,,0,0,0,,Бұл рас па, жоқ па білмеймін, бірақ...
Dialogue: 0,0:40:23.42,0:40:25.59,Default,,0,0,0,,Бұл дұрыс (Ясуэ), бірақ...
Dialogue: 0,0:40:25.84,0:40:27.92,Default,,0,0,0,,Емтихан тапсыру үшін үйден шығу
Dialogue: 0,0:40:28.05,0:40:31.47,Default,,0,0,0,,Олар мұны есепсіз жасады ма?
Dialogue: 0,0:40:31.93,0:40:34.47,Default,,0,0,0,,Мен оны бір көрдім, бірақ...
Dialogue: 0,0:40:34.85,0:40:37.51,Default,,0,0,0,,Сіздің ойыңызша, сіздің анаңыз қаншалықты зардап шегеді?
Dialogue: 0,0:40:40.10,0:40:41.52,Default,,0,0,0,,Тағы да солай...
Dialogue: 0,0:40:41.64,0:40:43.69,Default,,0,0,0,,Сенің анаңның бұған қатысы жоқ, солай ма?
Dialogue: 0,0:40:44.10,0:40:48.86,Default,,0,0,0,,Әке, мен үйден шыққанда: «Қалағаныңды істе» дедің.
Dialogue: 0,0:40:49.07,0:40:52.20,Default,,0,0,0,,Мен де: «Қалағаныңды істе» дедім.
Dialogue: 0,0:40:52.53,0:40:53.57,Default,,0,0,0,,Жоқ
Dialogue: 0,0:40:53.91,0:40:56.20,Default,,0,0,0,,«Мен: «Жәй ғана университетке бар» дедім.
Dialogue: 0,0:40:58.58,0:41:01.58,Default,,0,0,0,,Мен сенің өзімшілдігіңді қаншалықты естідім деп ойлайсың?
Dialogue: 0,0:41:02.46,0:41:05.83,Default,,0,0,0,,«Мен мектепті тастағым келеді», сондықтан мен мектептен кетуге қадам жасадым.
Dialogue: 0,0:41:06.50,0:41:09.25,Default,,0,0,0,,Ол: «Мен Токиоға барғым келеді», - деді, сондықтан оны реттеңіз...
Dialogue: 0,0:41:09.75,0:41:11.92,Default,,0,0,0,,Ақылсыз сөздер айтпа
Dialogue: 0,0:41:12.09,0:41:14.22,Default,,0,0,0,,Мен мұның бәрін өзім жасадым!
Dialogue: 0,0:41:14.51,0:41:17.14,Default,,0,0,0,,Мектепті тастасаң да, арғы жаққа кетесің!
Dialogue: 0,0:41:17.26,0:41:18.05,Default,,0,0,0,,Тіпті пәтер
Dialogue: 0,0:41:18.18,0:41:20.14,Default,,0,0,0,,Сені анаң таныстырғандықтан кірдің, солай ма?
Dialogue: 0,0:41:20.27,0:41:21.10,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:41:21.47,0:41:24.69,Default,,0,0,0,,Кепілгердің бетінде қандай есім жазылған деп ойлайсыз?
Dialogue: 0,0:41:25.31,0:41:27.31,Default,,0,0,0,,Сіз әлі кәмелетке толмағансыз.
Dialogue: 0,0:41:27.61,0:41:29.94,Default,,0,0,0,,Бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:41:30.15,0:41:33.70,Default,,0,0,0,,Баланың ересек адамның бақылауында екенін білдіреді.
Dialogue: 0,0:41:35.16,0:41:37.37,Default,,0,0,0,,Сол себепті «мені тыңда» дейсіз бе?
Dialogue: 0,0:41:37.95,0:41:40.87,Default,,0,0,0,,Сіз: «Қорлау ешқашан болмағандай елестетіңіз» дейсіз бе?
Dialogue: 0,0:41:42.00,0:41:42.87,Default,,0,0,0,,Нина
Dialogue: 0,0:41:43.00,0:41:44.37,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:41:44.75,0:41:46.37,Default,,0,0,0,,Дұрыстап сөйлесейік
Dialogue: 0,0:41:46.50,0:41:48.92,Default,,0,0,0,,Кездесіп, дұрыс түсінейік.
Dialogue: 0,0:41:49.04,0:41:50.59,Default,,0,0,0,,Мен сол үшін келдім.
Dialogue: 0,0:41:50.71,0:41:53.76,Default,,0,0,0,,Бірақ бұл басынан мүмкін емес...
Dialogue: 0,0:41:53.88,0:41:55.01,Default,,0,0,0,,[Есіктің ашылған дыбысы]
Dialogue: 0,0:41:55.88,0:41:57.14,Default,,0,0,0,,Мен ертең шығамын
Dialogue: 0,0:41:57.72,0:41:59.43,Default,,0,0,0,,Нина, менімен бірге жүрші.
Dialogue: 0,0:42:00.14,0:42:03.02,Default,,0,0,0,,[Цикада дыбысы]
Dialogue: 0,0:42:15.74,0:42:16.66,Default,,0,0,0,,Мен бармаймын
Dialogue: 0,0:42:17.03,0:42:19.03,Default,,0,0,0,,Мектеп, солай ма? Мен бармаймын
Dialogue: 0,0:42:19.16,0:42:20.91,Default,,0,0,0,,Біз бұл туралы айттық.
Dialogue: 0,0:42:21.41,0:42:23.87,Default,,0,0,0,,Сізде сөйлесетін нәрсе бар деп үміттенемін.
Dialogue: 0,0:42:24.00,0:42:26.46,Default,,0,0,0,,Менің де айтатын нәрсем бар.
Dialogue: 0,0:42:27.71,0:42:30.71,Default,,0,0,0,,Ыстықтағы қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:42:30.84,0:42:31.67,Default,,0,0,0,,Жоқ
Dialogue: 0,0:42:32.80,0:42:34.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:42:34.76,0:42:37.80,Default,,0,0,0,,Нина-сан да аптап ыстықта қиналады.
Dialogue: 0,0:42:38.18,0:42:39.01,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:42:39.14,0:42:42.14,Default,,0,0,0,,Иә, фактілерді дұрыс тексеріңіз.
Dialogue: 0,0:42:42.26,0:42:44.89,Default,,0,0,0,,Студент те фактіні мойындады.
Dialogue: 0,0:42:45.68,0:42:50.31,Default,,0,0,0,,Мектеп мұны түсінбегеніне өкінеміз.
Dialogue: 0,0:42:50.69,0:42:52.27,Default,,0,0,0,,үшін осы ма?
Dialogue: 0,0:42:52.40,0:42:54.32,Default,,0,0,0,,Мектепте жауапкершілік жоқ па?
Dialogue: 0,0:42:54.53,0:42:56.74,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:42:56.86,0:43:00.20,Default,,0,0,0,,Алайда мектеп бұны қорлау деп мойындамайды...
Dialogue: 0,0:43:00.49,0:43:03.45,Default,,0,0,0,,Мен бұл айтқаным емес екенін білемін.
Dialogue: 0,0:43:03.70,0:43:06.75,Default,,0,0,0,,Бірақ сол кезде мектеп бұл шындықты түсінді...
Dialogue: 0,0:43:06.87,0:43:07.71,Default,,0,0,0,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:43:08.33,0:43:09.21,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:43:09.33,0:43:11.33,Default,,0,0,0,,«Тоқта» дейсіз бе?
Dialogue: 0,0:43:12.42,0:43:14.88,Default,,0,0,0,,Нинаның бұлай айтуының қажеті жоқ.
Dialogue: 0,0:43:15.09,0:43:17.17,Default,,0,0,0,,Сіз жәбірленушісіз
Dialogue: 0,0:43:17.76,0:43:18.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:19.09,0:43:20.51,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:43:22.89,0:43:24.01,Default,,0,0,0,,Нина!
Dialogue: 0,0:43:24.60,0:43:27.85,Default,,0,0,0,,Мектеп бірден қайтып келуге болатынын айтады.
Dialogue: 0,0:43:28.35,0:43:31.52,Default,,0,0,0,,Ұнамаса, ауыстыру процедураларымен айналысамыз дейді.
Dialogue: 0,0:43:31.65,0:43:32.48,Default,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,0:43:33.65,0:43:34.52,Default,,0,0,0,,Сол кездегідей
Dialogue: 0,0:43:34.65,0:43:37.32,Default,,0,0,0,,Мен енді «ештеңе болмағандай кейіп таныт» демеймін
Dialogue: 0,0:43:37.44,0:43:38.70,Default,,0,0,0,,Оны дұрыс мойындауға рұқсат етіңіз
Dialogue: 0,0:43:38.82,0:43:41.03,Default,,0,0,0,,Сіздің жараларыңыз қалай жазылады? Қазір...
Dialogue: 0,0:43:41.16,0:43:42.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:43:42.24,0:43:45.37,Default,,0,0,0,,Мен не айтсам да, олар түсінбейді деп ойлаймын.
Dialogue: 0,0:43:55.00,0:43:56.42,Default,,0,0,0,,[Есіктің ашылған дыбысы]
Dialogue: 0,0:43:56.55,0:43:57.51,Default,,0,0,0,,Сіз қайтып барасыз ба?
Dialogue: 0,0:43:57.63,0:43:58.63,Default,,0,0,0,,Иә...
Dialogue: 0,0:43:59.30,0:44:01.51,Default,,0,0,0,,тобы Сіз мұны шынымен жасайсыз ба?
Dialogue: 0,0:44:01.80,0:44:02.64,Default,,0,0,0,,Иә
Dialogue: 0,0:44:04.39,0:44:06.14,Default,,0,0,0,,Сізге бұл ұнайды ма?
Dialogue: 0,0:44:07.60,0:44:08.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:12.98,0:44:14.56,Default,,0,0,0,,Сол ән...
Dialogue: 0,0:44:15.90,0:44:19.15,Default,,0,0,0,,Сіз менің арқамды итеріп жібердіңіз.
Dialogue: 0,0:44:20.20,0:44:24.28,Default,,0,0,0,,«Сабырлы бол, адамды ақылды етеді» деп айту
Dialogue: 0,0:44:24.70,0:44:27.66,Default,,0,0,0,,«Пайдасы жоқ» «Менде шыдаудан басқа амал жоқ»
Dialogue: 0,0:44:27.79,0:44:31.04,Default,,0,0,0,,Ойланып тұрғанымда сен мені итеріп жібердің.
Dialogue: 0,0:44:35.79,0:44:39.92,Default,,0,0,0,,«Егер қателеспесеңіз, оған шыдамаңыз».
Dialogue: 0,0:44:40.05,0:44:42.68,Default,,0,0,0,,«Болашақ туралы ойлама»
Dialogue: 0,0:44:43.01,0:44:44.68,Default,,0,0,0,,«Қолыңыздан келгенше ұшыңыз»
Dialogue: 0,0:44:45.14,0:44:48.01,Default,,0,0,0,,Тұңғиыққа құлап бара жатыр ма?
Dialogue: 0,0:44:48.14,0:44:51.56,Default,,0,0,0,,Білмеймін, көкке ұшқан кезім бе.
Dialogue: 0,0:44:51.98,0:44:54.65,Default,,0,0,0,,Сол ән мені самғатты
Dialogue: 0,0:44:54.77,0:44:56.73,Default,,0,0,0,,Сондықтан қайтып оралуға негіз жоқ
Dialogue: 0,0:44:56.86,0:44:58.61,Default,,0,0,0,,Мен енді қайтып оралғым келмейді
Dialogue: 0,0:44:59.11,0:45:00.40,Default,,0,0,0,,Мен...
Dialogue: 0,0:45:01.74,0:45:03.57,Default,,0,0,0,,Сол кезде мен...
Dialogue: 0,0:45:03.95,0:45:06.16,Default,,0,0,0,,Өзімді өлтірмек болдым
Dialogue: 0,0:45:11.62,0:45:14.21,Default,,0,0,0,,Оның қанаттары болмауы мүмкін.
Dialogue: 0,0:45:14.33,0:45:17.50,Default,,0,0,0,,Мүмкін мен оны ұшып жатыр деп ойлайтын шығармын.
Dialogue: 0,0:45:18.42,0:45:21.71,Default,,0,0,0,,Бірақ маған қазір бәрінен де ұнайды.
Dialogue: 0,0:45:21.97,0:45:23.63,Default,,0,0,0,,Мен мұны мақтанышпен айта аламын.
Dialogue: 0,0:45:24.22,0:45:26.51,Default,,0,0,0,,Бұл нағыз мен
Dialogue: 0,0:45:29.56,0:45:30.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:31.64,0:45:32.98,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:45:33.27,0:45:35.94,Default,,0,0,0,,Бірақ кешкі ас ішейік.
Dialogue: 0,0:45:37.11,0:45:37.98,Default,,0,0,0,,Иә
Dialogue: 0,0:45:38.94,0:45:41.28,Default,,0,0,0,,Сәлем! Қыша лотос түбірі карри
Dialogue: 0,0:45:41.40,0:45:42.74,Default,,0,0,0,,Біраз уақыт болды, солай емес пе?
Dialogue: 0,0:45:43.78,0:45:45.36,Default,,0,0,0,,Жарай ма? (Сүзүнэ) Не?
Dialogue: 0,0:45:45.74,0:45:48.49,Default,,0,0,0,,Жоқ... Бұл отбасылық өсиет. Отбасылық өсиет.
Dialogue: 0,0:45:48.83,0:45:51.37,Default,,0,0,0,,Ах~ Жарайды.
Dialogue: 0,0:45:51.62,0:45:53.33,Default,,0,0,0,,Сіз кеткеннен кейін
Dialogue: 0,0:45:53.46,0:45:55.42,Default,,0,0,0,,Бұл біртүрлі сезім, солай емес пе?
Dialogue: 0,0:45:56.00,0:45:56.96,Default,,0,0,0,,Келесі күні де
Dialogue: 0,0:45:57.08,0:46:00.71,Default,,0,0,0,,Әке, мен ішімдік ішуге жарамсызмын.
Dialogue: 0,0:46:01.42,0:46:03.01,Default,,0,0,0,,Мен қатты мас болдым.
Dialogue: 0,0:46:03.88,0:46:06.89,Default,,0,0,0,,«Мен не істеуім керек деп ойлайсың?»
Dialogue: 0,0:46:07.18,0:46:08.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:08.14,0:46:09.26,Default,,0,0,0,,...өйткені
Dialogue: 0,0:46:11.01,0:46:12.89,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:46:13.85,0:46:16.98,Default,,0,0,0,,Сондай-ақ, ол ағартушы ретінде өте танымал.
Dialogue: 0,0:46:17.10,0:46:19.77,Default,,0,0,0,,Айналаңыздан кеңес сұраңыз
Dialogue: 0,0:46:20.73,0:46:23.49,Default,,0,0,0,,Бұл Шинкансен екі жаққа бару билеті
Dialogue: 0,0:46:23.61,0:46:26.82,Default,,0,0,0,,Анам досымнан жасырын түрде маған беруін өтінді.
Dialogue: 0,0:46:26.95,0:46:27.78,Default,,0,0,0,,А...
Dialogue: 0,0:46:27.91,0:46:29.28,Default,,0,0,0,,Сіз байқамадыңыз, солай ма?
Dialogue: 0,0:46:30.03,0:46:31.37,Default,,0,0,0,,Сіз
Dialogue: 0,0:46:31.53,0:46:32.99,Default,,0,0,0,,Мені жақсы көреді
Dialogue: 0,0:46:33.24,0:46:34.91,Default,,0,0,0,,Дәл солай, бірақ әкелер
Dialogue: 0,0:46:35.04,0:46:37.42,Default,,0,0,0,,Мен сені сөзсіз жақсы көремін
Dialogue: 0,0:46:38.04,0:46:39.96,Default,,0,0,0,,Мұны ұмытпа
Dialogue: 0,0:46:42.05,0:46:44.46,Default,,0,0,0,,Итадакимасу... (жылап)
Dialogue: 0,0:46:44.59,0:46:46.93,Default,,0,0,0,,Тірі болғаныңызға рахмет.
Dialogue: 0,0:46:47.68,0:46:50.05,Default,,0,0,0,,Мен де сені жақсы көремін Нина
Dialogue: 0,0:46:52.93,0:46:54.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:46:54.52,0:46:58.27,Default,,0,0,0,,Мені осылай мазақтадың ба... Анамның карри?
Dialogue: 0,0:46:58.56,0:47:00.44,Default,,0,0,0,,[Цикада дыбысы]
Dialogue: 0,0:47:06.82,0:47:10.24,Default,,0,0,0,,♪Бұл шынымен ақ, бұл өте ұзын
Dialogue: 0,0:47:07.40,0:47:10.24,Default,,0,0,0,,Ах... Ах-а?
Dialogue: 0,0:47:10.41,0:47:15.83,Default,,0,0,0,,♪Котаэ жай ғана форма деген түсінік бар.
Dialogue: 0,0:47:16.20,0:47:21.04,Default,,0,0,0,,♪Саусақ ұшы дірілдеп тұрса да
Dialogue: 0,0:47:19.08,0:47:21.58,Default,,0,0,0,,Сізге ұнады ма? Бұл ән...
Dialogue: 0,0:47:21.71,0:47:24.55,Default,,0,0,0,,♪Дұрыс жауап жоқ, жеңіліс жоқ.
Dialogue: 0,0:47:23.34,0:47:24.55,Default,,0,0,0,,Иә...
Dialogue: 0,0:47:24.67,0:47:26.30,Default,,0,0,0,,♪Менің бүкіл өмірім
Dialogue: 0,0:47:25.09,0:47:26.30,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:47:26.42,0:47:30.09,Default,,0,0,0,,♪Бұл менмін, бар болғаны.
Dialogue: 0,0:47:27.26,0:47:30.09,Default,,0,0,0,,Ұнамайсыз ба? Саған ұнамайды.
Dialogue: 0,0:47:30.43,0:47:36.02,Default,,0,0,0,,♪Енді бұзатын болсақ та, ертең болмайды
Dialogue: 0,0:47:33.10,0:47:36.02,Default,,0,0,0,,Бұл жақсы ән (Нина) Ха...
Dialogue: 0,0:47:37.48,0:47:38.85,Default,,0,0,0,,Жақсы ән
Dialogue: 0,0:47:40.19,0:47:41.77,Default,,0,0,0,,Әке (Мунео) Иә?
Dialogue: 0,0:47:42.44,0:47:45.86,Default,,0,0,0,,Менің айтқанымды тыңдамайтын өзімшіл қыз.
Dialogue: 0,0:47:45.98,0:47:47.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:47:48.40,0:47:51.28,Default,,0,0,0,,Темекі шегуіңізді азайтыңыз.
Dialogue: 0,0:48:00.33,0:48:03.17,Default,,0,0,0,,Мен барамын. мен барамын...
Dialogue: 0,0:48:03.54,0:48:04.54,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:48:05.92,0:48:06.88,Default,,0,0,0,,Нина!
Dialogue: 0,0:48:08.51,0:48:09.67,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:48:10.84,0:48:11.68,Default,,0,0,0,,Не?
Dialogue: 0,0:48:13.85,0:48:15.43,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:48:17.52,0:48:18.60,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:48:18.73,0:48:19.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:23.19,0:48:24.11,Default,,0,0,0,,Иә
Dialogue: 0,0:48:24.73,0:48:25.77,Default,,0,0,0,,Нина!
Dialogue: 0,0:48:26.02,0:48:26.86,Default,,0,0,0,,Уау...
Dialogue: 0,0:48:27.53,0:48:29.11,Default,,0,0,0,,Пәтер кілті!
Dialogue: 0,0:48:29.82,0:48:30.95,Default,,0,0,0,,Кілт пе?
Dialogue: 0,0:48:33.99,0:48:34.95,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:48:35.33,0:48:36.66,Default,,0,0,0,,Әкемнен!
Dialogue: 0,0:48:39.00,0:48:39.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:48:47.09,0:48:48.38,Default,,0,0,0,,Әке!
Dialogue: 0,0:48:52.18,0:48:55.76,Default,,0,0,0,,Мен шығарған әнімді келесі жолы айтамын.
Dialogue: 0,0:48:55.89,0:48:57.60,Default,,0,0,0,,Ұнаса, келіп тыңда.
Dialogue: 0,0:48:59.14,0:49:00.18,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:49:01.02,0:49:01.85,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:49:02.98,0:49:03.98,Default,,0,0,0,,Нина…
Dialogue: 0,0:49:06.44,0:49:07.48,Default,,0,0,0,,Әй!
Dialogue: 0,0:49:08.15,0:49:09.53,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:49:10.11,0:49:11.78,Default,,0,0,0,,Филиалдар үшін де рахмет!
Dialogue: 0,0:49:13.07,0:49:14.36,Default,,0,0,0,,Түсінгенше көрсетемін
Dialogue: 0,0:49:15.45,0:49:16.49,Default,,0,0,0,,Хехе
Dialogue: 0,0:49:17.53,0:49:21.37,Default,,0,0,0,,Құлақсызсың, мұңаймассың, ренжітіп барамын.
Dialogue: 0,0:49:22.21,0:49:23.37,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:49:24.50,0:49:27.00,Default,,0,0,0,,Сау болыңыз, жақында кездескенше
Dialogue: 0,0:49:28.50,0:49:31.38,Default,,0,0,0,,(Көліктегі хабарландыру)
Dialogue: 0,0:49:31.51,0:49:34.51,Default,,0,0,0,,(Нинаның ұйқысы)
Dialogue: 0,0:49:38.64,0:49:39.85,Default,,0,0,0,,(Нинаның есінеу)
Dialogue: 0,0:49:39.97,0:49:41.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:42.06,0:49:43.18,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:49:44.89,0:49:46.56,Default,,0,0,0,,Дегенмен, мен бұл ойды қабылдауға өзімді қиналдыра алмаймын.
Dialogue: 0,0:49:49.02,0:49:57.41,Default,,0,0,0,,(Нинаның гуілдеуі)
Dialogue: 0,0:49:57.74,0:49:59.41,Default,,0,0,0,,Нина (Нина) А...
Dialogue: 0,0:50:04.66,0:50:05.96,Default,,0,0,0,,Кәдесыйлар ше?
Dialogue: 0,0:50:07.67,0:50:08.71,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:50:09.84,0:50:10.96,Default,,0,0,0,,Неге...
Dialogue: 0,0:50:11.75,0:50:12.59,Default,,0,0,0,,Момока-сан
Dialogue: 0,0:50:12.71,0:50:15.80,Default,,0,0,0,,Менен «Нина міндетті түрде қайтып келеді» деп сұрамаңыз.
Dialogue: 0,0:50:16.30,0:50:18.05,Default,,0,0,0,,Егер тағы бір күн кешігіп қалса
Dialogue: 0,0:50:18.18,0:50:20.97,Default,,0,0,0,,Біз Кумамотоға дейін көлікпен жүруге мәжбүр болдық.
Dialogue: 0,0:50:21.10,0:50:22.14,Default,,0,0,0,,Теңізді ластайтын ешқандай ірі қалалар жоқ—
Dialogue: 0,0:50:22.27,0:50:24.77,Default,,0,0,0,,Неліктен көлік жүргіземін дейсіз?
Dialogue: 0,0:50:24.89,0:50:25.81,Default,,0,0,0,,Ка!
Dialogue: 0,0:50:25.94,0:50:28.56,Default,,0,0,0,,Рупа мырза, сіз тамаша жұмыс істедіңіз.
Dialogue: 0,0:50:28.94,0:50:31.07,Default,,0,0,0,,үшін келісті!
Dialogue: 0,0:50:31.19,0:50:32.65,Default,,0,0,0,,Сіз жылап жатқан шығарсыз.
Dialogue: 0,0:50:32.78,0:50:34.44,Default,,0,0,0,,Ей, сен жылап тұрғанда кіресің.
Dialogue: 0,0:50:34.57,0:50:36.70,Default,,0,0,0,,Жарайды, сен жылап тұрған жоқсың ғой?
Dialogue: 0,0:50:36.82,0:50:38.32,Default,,0,0,0,,Қалай ойлайсың, Лупа?
Dialogue: 0,0:50:38.61,0:50:41.20,Default,,0,0,0,,Хмм, жақсы...
Dialogue: 0,0:50:42.33,0:50:44.50,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,0:50:45.25,0:50:46.08,Default,,0,0,0,,Хехе
Dialogue: 0,0:50:46.25,0:50:47.08,Default,,0,0,0,,Иә
Dialogue: 0,0:50:47.50,0:50:48.33,Default,,0,0,0,,Эххе
Dialogue: 0,0:50:49.00,0:50:49.92,Default,,0,0,0,,Иә
Dialogue: 0,0:50:50.59,0:50:51.59,Default,,0,0,0,,Хехе
Dialogue: 0,0:50:52.38,0:50:53.34,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:50:55.84,0:50:56.92,Default,,0,0,0,,Қайта оралуыңмен!
Dialogue: 0,0:50:57.05,0:50:58.47,Default,,0,0,0,,Ол дұрыс жұмыс істеді ме?
Dialogue: 0,0:50:58.59,0:51:01.76,Default,,0,0,0,,Иә, орындалды. Керемет ән!
Dialogue: 0,0:51:04.27,0:51:06.23,Default,,0,0,0,,Ха~ Мен шаршадым.
Dialogue: 0,0:51:06.35,0:51:09.52,Default,,0,0,0,,О, Бартон апа, бұл Тори!
Dialogue: 0,0:51:09.65,0:51:11.90,Default,,0,0,0,,Өтірік! не? ол саған ұнайды ма?
Dialogue: 0,0:51:12.02,0:51:13.52,Default,,0,0,0,,Болыңыз… әсіресе…
Dialogue: 0,0:51:13.65,0:51:17.28,Default,,0,0,0,,Ол әдемі жігіт~ (Сатоши) Жоқ деп жатырсың!
Dialogue: 0,0:51:17.61,0:51:19.74,Default,,0,0,0,,Қараңдар! Біз де тізімдеміз
Dialogue: 0,0:51:19.86,0:51:22.28,Default,,0,0,0,,Дұрыс, шығып жатыр.
Dialogue: 0,0:51:22.66,0:51:24.37,Default,,0,0,0,,Сіздің кезегіңіз бірінші күні, солай ма?
Dialogue: 0,0:51:24.49,0:51:26.79,Default,,0,0,0,,Дұрыс, бұл кезеңнің басы.
Dialogue: 0,0:51:27.12,0:51:29.71,Default,,0,0,0,,Содан кейін біз Тори тобын көруге барамыз.
Dialogue: 0,0:51:29.83,0:51:31.67,Default,,0,0,0,,Мынау мен мынау ғана қалды...
Dialogue: 0,0:51:31.79,0:51:34.09,Default,,0,0,0,,Сіз соншалықты көп көресіз бе?
Dialogue: 0,0:51:34.21,0:51:37.80,Default,,0,0,0,,Ал, көресіз! Мен оны тегін жіберемін.
Dialogue: 0,0:51:38.17,0:51:39.01,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:51:39.13,0:51:40.30,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:51:40.59,0:51:41.76,Default,,0,0,0,,Мен оны естідім~
Dialogue: 0,0:51:41.89,0:51:44.81,Default,,0,0,0,,Естуімше, келесі фестивальдегі келбет өзгерді.
Dialogue: 0,0:51:45.22,0:51:46.56,Default,,0,0,0,,Мен сені сүйем
Dialogue: 0,0:51:46.68,0:51:48.27,Default,,0,0,0,,Хаха…
Dialogue: 0,0:51:48.68,0:51:50.90,Default,,0,0,0,,Екінші күні бізге кезек келетін сияқты.
Dialogue: 0,0:51:51.02,0:51:51.90,Default,,0,0,0,,Иә!?
Dialogue: 0,0:51:52.02,0:51:55.19,Default,,0,0,0,,Мен ойнаймын деп жүрген топ жұмыс істемей қалған сияқты...
Dialogue: 0,0:51:55.32,0:51:56.40,Default,,0,0,0,,Кезеңдері бірдей
Dialogue: 0,0:51:56.53,0:52:00.07,Default,,0,0,0,,Бізді сол уақытқа ауыстыра аласыз ба?
Dialogue: 0,0:52:00.45,0:52:02.24,Default,,0,0,0,,Екінші күн түні бойы.
Dialogue: 0,0:52:02.37,0:52:05.45,Default,,0,0,0,,Қазір пайда болған уақытпен салыстырғанда, бұл үлкен жетістік.
Dialogue: 0,0:52:05.58,0:52:07.04,Default,,0,0,0,,Ең жақсысы емес пе!
Dialogue: 0,0:52:07.16,0:52:09.08,Default,,0,0,0,,Олай болса, барлығына жарай ма?
Dialogue: 0,0:52:09.54,0:52:10.58,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:52:10.96,0:52:13.08,Default,,0,0,0,,Артқы жел бар ма?
Dialogue: 0,0:52:15.96,0:52:18.38,Default,,0,0,0,,Қазір уақытыңыз бар ма?
Dialogue: 0,0:52:20.68,0:52:21.84,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:52:21.97,0:52:23.64,Default,,0,0,0,,Иә! Бұл үлкен мәселе
Dialogue: 0,0:52:23.76,0:52:26.81,Default,,0,0,0,,Мен өтетін орынды бір рет алдын ала қарасам жақсы болар еді деп ойладым.
Dialogue: 0,0:52:26.93,0:52:29.14,Default,,0,0,0,,Сіз мұны осындай үлкен жерде жасай аласыз ба?
Dialogue: 0,0:52:29.43,0:52:32.69,Default,,0,0,0,,Басты кезең болғаны өкінішті (Нина) Басты кезең?
Dialogue: 0,0:52:32.81,0:52:36.11,Default,,0,0,0,,Біз сол жерде салынған шағын сахнада тұрмыз.
Dialogue: 0,0:52:36.23,0:52:38.40,Default,,0,0,0,,Иә? Көптеген кезеңдері бар?
Dialogue: 0,0:52:38.82,0:52:41.03,Default,,0,0,0,,Сіз шынымен ештеңе білмейсіз.
Dialogue: 0,0:52:41.61,0:52:43.57,Default,,0,0,0,,Танымал нәрсе - бұл үлкен.
Dialogue: 0,0:52:43.70,0:52:46.03,Default,,0,0,0,,Біз сияқты адамдар кішкентай.
Dialogue: 0,0:52:46.37,0:52:49.04,Default,,0,0,0,,Әрине, гауһар шаңы сонда.
Dialogue: 0,0:52:49.45,0:52:50.45,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:52:53.37,0:52:55.54,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:52:55.84,0:52:58.05,Default,,0,0,0,,Менің ойымша, бұл өте жақсы.
Dialogue: 0,0:52:58.50,0:53:00.76,Default,,0,0,0,,Үлкен сахнада ән айтып тұрған Дайдасқа
Dialogue: 0,0:53:00.88,0:53:04.05,Default,,0,0,0,,Кішігірім сахнада ән айтатын біз сынаққа қатысамыз, солай ма?
Dialogue: 0,0:53:04.39,0:53:05.68,Default,,0,0,0,,«Алып өлтіру»
Dialogue: 0,0:53:05.80,0:53:07.26,Default,,0,0,0,,«Бұрыштағы егеуқұйрық мысықты тістеп алды»
Dialogue: 0,0:53:07.39,0:53:08.35,Default,,0,0,0,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:53:08.51,0:53:11.06,Default,,0,0,0,,Қарсы тарап та, жанкүйерлер де олай ойламайды.
Dialogue: 0,0:53:11.48,0:53:14.06,Default,,0,0,0,,Менің ойымша, Момока-сан екеуміз
Dialogue: 0,0:53:14.40,0:53:17.32,Default,,0,0,0,,үшін, тапсырысқа сенімдісіз бе?
Dialogue: 0,0:53:18.36,0:53:19.65,Default,,0,0,0,,Жақсы, солай ма?
Dialogue: 0,0:53:22.19,0:53:23.20,Default,,0,0,0,,Иә
Dialogue: 0,0:53:24.03,0:53:25.49,Default,,0,0,0,,Бұл жақсы сезінеді, солай ма?
Dialogue: 0,0:53:25.62,0:53:27.62,Default,,0,0,0,,Аспан астында осылай ән айта алсам...
Dialogue: 0,0:53:29.24,0:53:31.20,Default,,0,0,0,,Момока-сан!
Dialogue: 0,0:53:31.54,0:53:34.21,Default,,0,0,0,,Маған алдағы фестивальге гитараңызды беріңізші!
Dialogue: 0,0:53:34.62,0:53:37.08,Default,,0,0,0,,Олай болса, мен толық емес жұмысқа барамын!
Dialogue: 0,0:53:38.46,0:53:40.09,Default,,0,0,0,,Иә? Сіз бірге емессіз бе?
Dialogue: 0,0:53:40.21,0:53:41.05,Default,,0,0,0,,Иә
Dialogue: 0,0:53:41.17,0:53:45.59,Default,,0,0,0,,Нина-сан, сіз бізден бөлек жаңа толық емес жұмыс күнін өзіңіз бастадыңыз.
Dialogue: 0,0:53:45.76,0:53:46.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:46.72,0:53:49.85,Default,,0,0,0,,Мен өзімшіл немесе капризмін дер едім.
Dialogue: 0,0:53:50.39,0:53:53.35,Default,,0,0,0,,Мен өзім бірдеңе істеуді шештім.
Dialogue: 0,0:53:53.64,0:53:57.10,Default,,0,0,0,,Ол, әрине, жақында өзгерді.
Dialogue: 0,0:54:00.48,0:54:01.48,Default,,0,0,0,,Гааах!
Dialogue: 0,0:54:02.03,0:54:04.78,Default,,0,0,0,,Жүзі сергітетін бір ғана адам
Dialogue: 0,0:54:05.74,0:54:06.78,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:54:13.33,0:54:14.62,Default,,0,0,0,,Мен өтірікші емеспін...
Dialogue: 0,0:54:15.04,0:54:16.62,Default,,0,0,0,,[Жел қоңырауының дыбысы]
Dialogue: 0,0:54:17.92,0:54:21.25,Default,,0,0,0,,[Көтерілген қоңырау дыбысы]
Dialogue: 0,0:54:21.38,0:54:22.42,Default,,0,0,0,,Субару
Dialogue: 0,0:54:22.55,0:54:25.38,Default,,0,0,0,,Олар топта екендіктерін әлі де жасырады, солай ма?
Dialogue: 0,0:54:25.72,0:54:28.39,Default,,0,0,0,,Маған Томо-чан ұнайды.
Dialogue: 0,0:54:28.76,0:54:31.06,Default,,0,0,0,,Мен... Мен әсіресе...
Dialogue: 0,0:54:31.18,0:54:34.68,Default,,0,0,0,,Сатосиді де кешіретін уақыт келеді деп үміттенемін.
Dialogue: 0,0:54:35.94,0:54:37.65,Default,,0,0,0,,Бұл мүлде мүмкін емес
Dialogue: 0,0:54:38.02,0:54:40.40,Default,,0,0,0,,Біз болашақта не күтіп тұрғанын білмейміз.
Dialogue: 0,0:54:41.23,0:54:42.40,Default,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,0:54:43.99,0:54:48.32,Default,,0,0,0,,Ешқашан кездеспесек, сөйлеспесек те, біз әлі тіріміз.
Dialogue: 0,0:54:48.91,0:54:51.41,Default,,0,0,0,,Мен үшін маңызды адамдар
Dialogue: 0,0:54:51.53,0:54:54.37,Default,,0,0,0,,Күлге айналды, еш жерде жоқ.
Dialogue: 0,0:54:55.45,0:54:57.42,Default,,0,0,0,,Мен осындамын, солай ма?
Dialogue: 0,0:54:59.21,0:55:00.38,Default,,0,0,0,,Рахмет
Dialogue: 0,0:55:01.34,0:55:03.67,Default,,0,0,0,,Иә? Неге ән айтасың?
Dialogue: 0,0:55:03.80,0:55:05.42,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:55:05.55,0:55:08.18,Default,,0,0,0,,Бұл біреумен байланыса алатындықтан ба?
Dialogue: 0,0:55:08.93,0:55:10.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:55:11.60,0:55:14.43,Default,,0,0,0,,Менің ойымша, бұл менің шынымды айтатын жер болғандықтан.
Dialogue: 0,0:55:16.27,0:55:17.44,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:55:17.73,0:55:20.44,Default,,0,0,0,,Сіз бәрін ұмытып, еркін бола аласыз.
Dialogue: 0,0:55:27.57,0:55:28.82,Default,,0,0,0,,Мен...
Dialogue: 0,0:55:30.57,0:55:33.03,Default,,0,0,0,,Себебі мен қателеспеймін деп ойлағым келеді
Dialogue: 0,0:55:33.58,0:55:34.91,Default,,0,0,0,,(қатты сөйлеу)
Dialogue: 0,0:55:35.04,0:55:36.95,Default,,0,0,0,,Бұл таңғажайып адамдар саны болды.
Dialogue: 0,0:55:37.08,0:55:39.79,Default,,0,0,0,,Қазір нақты істің уақыты келді.
Dialogue: 0,0:55:41.13,0:55:42.88,Default,,0,0,0,,Сіздің кезегіңіз кешке басталады, солай ма?
Dialogue: 0,0:55:43.00,0:55:44.80,Default,,0,0,0,,Иә, ұқыптылық!
Dialogue: 0,0:55:45.21,0:55:47.55,Default,,0,0,0,,Мүмкін біз басқа топты көруге барармыз!
Dialogue: 0,0:55:47.67,0:55:49.80,Default,,0,0,0,,Иә? Бүгін ұрыс
Dialogue: 0,0:55:50.18,0:55:53.97,Default,,0,0,0,,Жарайды, басқа топтарға қарап, толқу жаман емес.
Dialogue: 0,0:55:54.10,0:55:56.06,Default,,0,0,0,,Тек кешікпе
Dialogue: 0,0:55:56.18,0:55:57.14,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:55:57.27,0:55:59.06,Default,,0,0,0,,Мен де бірге келе аламын ба?
Dialogue: 0,0:55:59.19,0:56:01.06,Default,,0,0,0,,Нина жоқ!
Dialogue: 0,0:56:01.65,0:56:02.56,Default,,0,0,0,,Сараң!
Dialogue: 0,0:56:03.06,0:56:05.44,Default,,0,0,0,,Аа, көп "лайк" жинап жатыр.
Dialogue: 0,0:56:05.57,0:56:09.07,Default,,0,0,0,,Сондай-ақ, «Мен Тоге Тогені көруді асыға күтемін» деген түсініктеме болды.
Dialogue: 0,0:56:09.28,0:56:10.86,Default,,0,0,0,,Оған көп көңіл бөлініп жатыр~
Dialogue: 0,0:56:10.99,0:56:11.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:56:12.11,0:56:14.28,Default,,0,0,0,,Бұл ішуге болады.
Dialogue: 0,0:56:14.41,0:56:15.74,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:56:15.87,0:56:18.45,Default,,0,0,0,,Итадакимасу (Нина) аялдамасы.
Dialogue: 0,0:56:18.83,0:56:19.96,Default,,0,0,0,,Кішкене ғана...
Dialogue: 0,0:56:20.08,0:56:22.33,Default,,0,0,0,,Лупаның «аз» дегені аз ғана емес!
Dialogue: 0,0:56:23.08,0:56:24.75,Default,,0,0,0,,Әй, Миура-сан!
Dialogue: 0,0:56:24.88,0:56:25.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:56:26.80,0:56:28.71,Default,,0,0,0,,Миура мырза... солай ма?
Dialogue: 0,0:56:29.38,0:56:30.93,Default,,0,0,0,,Сәлем... Сіз дұрыс емес адамсыз!
Dialogue: 0,0:56:31.05,0:56:33.72,Default,,0,0,0,,Не? Күте тұрыңыз... сіз дұрыс емес адамсыз ба?
Dialogue: 0,0:56:34.30,0:56:36.47,Default,,0,0,0,,Мен аламын... (Томо) Жоқ!
Dialogue: 0,0:56:36.64,0:56:39.73,Default,,0,0,0,,Ой, енді ойлап қарасам, Субару әлі қайтып келмеді.
Dialogue: 0,0:56:40.06,0:56:42.23,Default,,0,0,0,,Сіз әлі де тікелей шоуларды ойнап жатқан жоқсыз ба?
Dialogue: 0,0:56:42.56,0:56:44.98,Default,,0,0,0,,Алдау! Мен сенімен барғым келді
Dialogue: 0,0:56:45.27,0:56:47.44,Default,,0,0,0,,Ол шешінетін бөлмеге оралды.
Dialogue: 0,0:56:47.57,0:56:48.65,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:56:48.78,0:56:50.32,Default,,0,0,0,,Жоқ! Уф...
Dialogue: 0,0:56:51.61,0:56:52.61,Default,,0,0,0,,Субару-чан
Dialogue: 0,0:56:53.28,0:56:56.24,Default,,0,0,0,,Иә! (Нина) Қалай болды? Сіз оны тікелей эфирде көрдіңіз бе?
Dialogue: 0,0:56:56.91,0:56:57.74,Default,,0,0,0,,Иә
Dialogue: 0,0:56:57.99,0:57:00.75,Default,,0,0,0,,Керемет~ Менің де барғым келді~
Dialogue: 0,0:57:01.08,0:57:03.58,Default,,0,0,0,,Ухуху... Мен қызғанамын.
Dialogue: 0,0:57:05.58,0:57:07.00,Default,,0,0,0,,Жалғыздықты сергіту...
Dialogue: 0,0:57:08.38,0:57:10.01,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:57:10.30,0:57:12.76,Default,,0,0,0,,Мен кеше әжеме электрондық хат жібердім.
Dialogue: 0,0:57:13.51,0:57:14.51,Default,,0,0,0,,Қый!
Dialogue: 0,0:57:14.64,0:57:15.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:15.85,0:57:19.52,Default,,0,0,0,,Мен оған: «Мен актер болғым келмейді, мен басқа істегім келеді» дедім.
Dialogue: 0,0:57:19.93,0:57:20.77,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:57:21.18,0:57:24.65,Default,,0,0,0,,Сондықтан да, осы топты мәңгі жасайық.
Dialogue: 0,0:57:25.10,0:57:26.77,Default,,0,0,0,,Бүгін жұмыс істемесе де...
Dialogue: 0,0:57:27.73,0:57:28.65,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:57:28.77,0:57:29.86,Default,,0,0,0,,Нина Хаса
Dialogue: 0,0:57:29.98,0:57:33.65,Default,,0,0,0,,Оның көзқарасы тар, ол тек дұрыс тұжырым жасайды, икемсіз.
Dialogue: 0,0:57:33.78,0:57:36.53,Default,,0,0,0,,Дегенмен, ол ұялшақ және онша дос емес...
Dialogue: 0,0:57:36.66,0:57:38.45,Default,,0,0,0,,Мен де қорлаймын.
Dialogue: 0,0:57:38.83,0:57:41.12,Default,,0,0,0,,Бірақ сіз өтірік айта алмайсыз, солай ма?
Dialogue: 0,0:57:41.25,0:57:43.04,Default,,0,0,0,,Бар күшіммен
Dialogue: 0,0:57:43.16,0:57:44.92,Default,,0,0,0,,Бұл сенімділік береді.
Dialogue: 0,0:57:45.04,0:57:47.46,Default,,0,0,0,,Мен қарым-қатынасты сынап көргім келеді.
Dialogue: 0,0:57:48.17,0:57:49.34,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:57:49.63,0:57:51.09,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:57:51.88,0:57:53.09,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:57:54.13,0:57:56.26,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:57:56.39,0:57:57.22,Default,,0,0,0,,Кеттік
Dialogue: 0,0:57:57.39,0:57:59.39,Default,,0,0,0,,Ах... Момока-сан
Dialogue: 0,0:57:59.56,0:58:00.68,Default,,0,0,0,,Қайда?
Dialogue: 0,0:58:01.14,0:58:02.81,Default,,0,0,0,,Артымнан ерсең, түсінесің.
Dialogue: 0,0:58:04.94,0:58:06.35,Default,,0,0,0,,Бұл әлі де үлкен
Dialogue: 0,0:58:06.69,0:58:08.56,Default,,0,0,0,,Өйткені бұл негізгі кезең
Dialogue: 0,0:58:08.69,0:58:10.11,Default,,0,0,0,,Адамдар саны көбейді
Dialogue: 0,0:58:10.23,0:58:11.94,Default,,0,0,0,,Сатоши-чан, сен көресің бе?
Dialogue: 0,0:58:12.07,0:58:14.03,Default,,0,0,0,,Сондықтан мен оны жек көремін...
Dialogue: 0,0:58:14.15,0:58:15.86,Default,,0,0,0,,Менің иығыма мінгің келе ме?
Dialogue: 0,0:58:16.32,0:58:17.87,Default,,0,0,0,,Иә! (Нина) Эххех...
Dialogue: 0,0:58:17.99,0:58:21.49,Default,,0,0,0,,Сатоши-чан да оны толығымен пайдалана бастады.
Dialogue: 0,0:58:21.62,0:58:24.12,Default,,0,0,0,,♪ [“Бос жәшік” қойылымының кіріспесі]
Dialogue: 0,0:58:22.62,0:58:24.12,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,0:58:24.50,0:58:25.83,Default,,0,0,0,,Бұл ән...
Dialogue: 0,0:58:26.67,0:58:28.13,Default,,0,0,0,,Иә
Dialogue: 0,0:58:28.25,0:58:30.34,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:58:29.04,0:58:30.34,Default,,0,0,0,,Момока-сан...
Dialogue: 0,0:58:32.50,0:58:35.63,Default,,0,0,0,,Бүгін шақырғаныңызға рахмет!
Dialogue: 0,0:58:36.05,0:58:37.80,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:58:37.93,0:58:39.43,Default,,0,0,0,,Ана жақтағы бала өте шебер екен, бізге үйретсін бе?
Dialogue: 0,0:58:39.55,0:58:41.18,Default,,0,0,0,,Алмаз шаңы!
Dialogue: 0,0:58:41.31,0:58:42.97,Default,,0,0,0,,(қолдау мен қол шапалақтау)
Dialogue: 0,0:58:43.10,0:58:45.64,Default,,0,0,0,,Соңына дейін тыңдаңыздар!
Dialogue: 0,0:58:49.40,0:58:51.65,Default,,0,0,0,,Қайғылы кейіпкер болуды қанша уақытқа жоспарлайсыз?
Dialogue: 0,0:58:52.94,0:58:54.82,Default,,0,0,0,,Нина қателесті.
Dialogue: 0,0:58:57.99,0:59:00.16,Default,,0,0,0,,Егер сіз одан да көп жасасаңыз, сіз тек ақша жоғалтасыз.
Dialogue: 0,0:59:00.66,0:59:03.04,Default,,0,0,0,,Сіз шынымен де ақымақсыз ба?
Dialogue: 0,0:59:05.00,0:59:06.58,Default,,0,0,0,,Тек...
Dialogue: 0,0:59:07.21,0:59:08.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:59:11.09,0:59:13.17,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:59:15.05,0:59:16.72,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:59:17.05,0:59:18.72,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:59:18.84,0:59:21.35,Default,,0,0,0,,♪～
Dialogue: 0,0:59:39.74,0:59:42.66,Default,,0,0,0,,«Қайғы циклі» ♪ Басын айту
Dialogue: 0,0:59:42.78,0:59:46.20,Default,,0,0,0,,♪Осы дүниенің соңында
Dialogue: 0,0:59:46.70,0:59:50.00,Default,,0,0,0,,♪Жақындап келе жатқан нәрсе күдікті
Dialogue: 0,0:59:50.12,0:59:52.96,Default,,0,0,0,,♪ Тек тездетіңіз
Dialogue: 0,0:59:53.09,0:59:55.05,Default,,0,0,0,,♪Жалтыратын уақыт
Dialogue: 0,0:59:55.17,0:59:57.63,Default,,0,0,0,,♪Мен тіпті аяқтай алмаймын
Dialogue: 0,0:59:57.76,1:00:00.22,Default,,0,0,0,,♪Арманда өмір сүру
Dialogue: 0,1:00:00.34,1:00:02.72,Default,,0,0,0,,♪ Өзара сыйластықпен күлу
Dialogue: 0,1:00:02.85,1:00:05.39,Default,,0,0,0,,♪Сүйікті көзқарасың
Dialogue: 0,1:00:05.51,1:00:07.89,Default,,0,0,0,,♪Бір-біріммен жынды болғым келеді
Dialogue: 0,1:00:08.02,1:00:10.52,Default,,0,0,0,,♪Оның өзі оның орнын толтыра алмайды
Dialogue: 0,1:00:10.64,1:00:13.11,Default,,0,0,0,,♪Бұл дүние айқайламайды
Dialogue: 0,1:00:13.23,1:00:15.69,Default,,0,0,0,,♪ Құрғақ тер
Dialogue: 0,1:00:15.82,1:00:18.32,Default,,0,0,0,,♪Өзгеретін заттарға
Dialogue: 0,1:00:18.44,1:00:20.95,Default,,0,0,0,,♪Бір ғана тілек
Dialogue: 0,1:00:21.07,1:00:23.49,Default,,0,0,0,,♪Қанша айқайлай беремін
Dialogue: 0,1:00:23.62,1:00:25.91,Default,,0,0,0,,♪Тағдырдың қатал тізбектері
Dialogue: 0,1:00:26.04,1:00:30.12,Default,,0,0,0,,♪ Шатастырылған
Dialogue: 0,1:00:30.41,1:00:34.04,Default,,0,0,0,,♪Мұңның басқа циклі
Dialogue: 0,1:00:44.39,1:00:47.39,Default,,0,0,0,,～♪
Dialogue: 0,1:00:45.64,1:00:48.81,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,1:00:49.14,1:00:50.89,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:00:51.94,1:00:55.31,Default,,0,0,0,,Қош келдіңіз! Мен де сенің артыңды көремін!
Dialogue: 0,1:00:55.86,1:00:57.32,Default,,0,0,0,,Жақсырақ...
Dialogue: 0,1:00:57.44,1:00:58.32,Default,,0,0,0,,Әрине
Dialogue: 0,1:00:58.44,1:01:00.11,Default,,0,0,0,,Idol вокал қосады
Dialogue: 0,1:01:00.24,1:01:04.32,Default,,0,0,0,,Бізді уақытынан бұрын жоспарлай бастаған топқа айналғанымыз үшін көп сынға алды.
Dialogue: 0,1:01:04.74,1:01:07.24,Default,,0,0,0,,«Ақымақ болма, мені мазақ етпе»
Dialogue: 0,1:01:07.37,1:01:10.83,Default,,0,0,0,,Мен міндетті түрде «Мен бұл жерде бағалауымды өзгертемін» деп ойлаймын.
Dialogue: 0,1:01:13.87,1:01:17.84,Default,,0,0,0,,Мен тұтынушыларға өзімнің байсалды екенімді анық айта аламын...
Dialogue: 0,1:01:20.63,1:01:21.47,Default,,0,0,0,,Хамф!
Dialogue: 0,1:01:21.59,1:01:22.42,Default,,0,0,0,,Бол!
Dialogue: 0,1:01:26.18,1:01:27.85,Default,,0,0,0,,Сіз де солай ойладыңыз ба?
Dialogue: 0,1:01:27.97,1:01:29.01,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,1:01:29.14,1:01:31.06,Default,,0,0,0,,Маған мұндай нәрсе ұнайды
Dialogue: 0,1:01:31.18,1:01:33.10,Default,,0,0,0,,Момока-сан бәріне
Dialogue: 0,1:01:33.23,1:01:36.11,Default,,0,0,0,,Барлық тұтынушыларды осында тартайық.
Dialogue: 0,1:01:36.98,1:01:38.11,Default,,0,0,0,,О!
Dialogue: 0,1:01:38.32,1:01:40.15,Default,,0,0,0,,Олай болса, Торн Құмырсқа мырза
Dialogue: 0,1:01:40.28,1:01:42.15,Default,,0,0,0,,Дыбысты тексеріңіз
Dialogue: 0,1:01:42.28,1:01:43.11,Default,,0,0,0,,Иә!
Dialogue: 0,1:01:45.53,1:01:46.62,Default,,0,0,0,,Уау...
Dialogue: 0,1:01:46.91,1:01:48.45,Default,,0,0,0,,Бірінші болып Айс Фриз!
Dialogue: 0,1:01:50.70,1:01:53.12,Default,,0,0,0,,Мен барабанның бәрін бергенін қалаймын.
Dialogue: 0,1:01:53.25,1:01:54.12,Default,,0,0,0,,Уа!
Dialogue: 0,1:01:54.50,1:01:55.46,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,1:01:55.75,1:01:58.79,Default,,0,0,0,,[Барабан өнімділігі]
Dialogue: 0,1:02:19.31,1:02:21.28,Default,,0,0,0,,Иә, бәрі жақсы.
Dialogue: 0,1:02:21.65,1:02:23.49,Default,,0,0,0,,Олай болса дауысыңызды беріңізші.
Dialogue: 0,1:02:23.61,1:02:24.57,Default,,0,0,0,,Иә
Dialogue: 0,1:02:24.70,1:02:28.16,Default,,0,0,0,,Эй, эй, ха~а! Ха~а!
Dialogue: 0,1:02:28.28,1:02:30.08,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,1:02:30.20,1:02:33.04,Default,,0,0,0,,Рахмет! рақмет сізге!
Dialogue: 0,1:02:33.25,1:02:36.54,Default,,0,0,0,,Иә, Басс мырза, сізге көп рахмет.
Dialogue: 0,1:02:36.67,1:02:38.04,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:02:39.84,1:02:42.84,Default,,0,0,0,,[Бас орындау]
Dialogue: 0,1:02:43.05,1:02:44.21,Default,,0,0,0,,Уау...
Dialogue: 0,1:02:52.93,1:02:54.81,Default,,0,0,0,,[Ойнауды тоқтату]
Dialogue: 0,1:02:55.35,1:02:57.56,Default,,0,0,0,,О! Бұл жақсы, жақсы!
Dialogue: 0,1:02:57.90,1:03:00.52,Default,,0,0,0,,Иә, басқа тондар бар ма?
Dialogue: 0,1:03:00.65,1:03:02.61,Default,,0,0,0,,Иә, ол күшейеді!
Dialogue: 0,1:03:03.73,1:03:04.57,Default,,0,0,0,,[Түйменің басу дыбысы]
Dialogue: 0,1:03:05.24,1:03:08.24,Default,,0,0,0,,[Бас өнімділігі]
Dialogue: 0,1:03:12.53,1:03:14.58,Default,,0,0,0,,Иә, тағы бірдеңе бар ма?
Dialogue: 0,1:03:15.00,1:03:16.29,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:03:18.75,1:03:20.21,Default,,0,0,0,,Нақты нәрсе дерлік осында.
Dialogue: 0,1:03:20.67,1:03:22.54,Default,,0,0,0,,Олай болса шеңбер құрсақ ше?
Dialogue: 0,1:03:22.67,1:03:23.59,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:03:24.55,1:03:25.59,Default,,0,0,0,,Кішкентай саусақ…
Dialogue: 0,1:03:25.92,1:03:27.97,Default,,0,0,0,,Кішкентай саусағыңызды көтергіңіз келе ме?
Dialogue: 0,1:03:28.59,1:03:29.47,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:03:31.05,1:03:31.97,Default,,0,0,0,,О!
Dialogue: 0,1:03:32.22,1:03:33.51,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:03:33.64,1:03:34.47,Default,,0,0,0,,Сэм...
Dialogue: 0,1:03:35.14,1:03:39.10,Default,,0,0,0,,Басталғалы тұрған нәрсе - біз үшін ең жақсы тікелей шоу.
Dialogue: 0,1:03:39.39,1:03:43.65,Default,,0,0,0,,Сол сахнада Нинаның әнін тыңдауға рұқсат етіңіз, айқайлаңыз.
Dialogue: 0,1:03:43.77,1:03:47.11,Default,,0,0,0,,Әндерімізбен бәрінің жүрегін ойып ал
Dialogue: 0,1:03:48.61,1:03:49.61,Default,,0,0,0,,Иә...
Dialogue: 0,1:03:49.74,1:03:51.53,Default,,0,0,0,,Ах! Мені жылатты!
Dialogue: 0,1:03:51.66,1:03:54.20,Default,,0,0,0,,Қойылым алдында не істеп жатырсың?
Dialogue: 0,1:03:54.37,1:04:00.46,Default,,0,0,0,,[Гитараның шырылдаған дыбысы]
Dialogue: 0,1:04:02.92,1:04:04.84,Default,,0,0,0,,Мен гитарада ойнай алмаймын!
Dialogue: 0,1:04:04.96,1:04:06.88,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,1:04:07.42,1:04:09.55,Default,,0,0,0,,Хехе, мынау әбестік.
Dialogue: 0,1:04:09.68,1:04:12.14,Default,,0,0,0,,Бұл сұмдық рок.
Dialogue: 0,1:04:12.68,1:04:16.27,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Тогенаши Тогеаримін.
Dialogue: 0,1:04:16.39,1:04:18.64,Default,,0,0,0,,Ал, мен топтамын.
Dialogue: 0,1:04:19.06,1:04:22.85,Default,,0,0,0,,Ал... Бірақ бұл оңай емес.
Dialogue: 0,1:04:22.98,1:04:27.48,Default,,0,0,0,,Біз бәріміз қорқақпыз, басқаларға сенбейміз және бәріміз қорқақпыз.
Dialogue: 0,1:04:27.61,1:04:30.65,Default,,0,0,0,,Мені сыртқа шақырсаң, «Мен бұл мәселеге байсалды емеспін» деген сияқты сөздерді айта бастайсың...
Dialogue: 0,1:04:31.20,1:04:32.95,Default,,0,0,0,,Бұл мен туралы ма?
Dialogue: 0,1:04:33.07,1:04:34.95,Default,,0,0,0,,Гудзигудзи дегеніміз не?
Dialogue: 0,1:04:35.08,1:04:36.70,Default,,0,0,0,,Солай емес пе!
Dialogue: 0,1:04:36.83,1:04:37.74,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:04:37.87,1:04:40.91,Default,,0,0,0,,Қазіргісі гитарадағы Момока-сан және пернетақтадағы Томо-чан.
Dialogue: 0,1:04:41.04,1:04:44.17,Default,,0,0,0,,Және заңды құбыжық! Вокалист Нина!
Dialogue: 0,1:04:44.71,1:04:47.09,Default,,0,0,0,,...және Лупа-сан, бас гитарист.
Dialogue: 0,1:04:47.21,1:04:48.63,Default,,0,0,0,,Жекпе-жек - ең жақсы!
Dialogue: 0,1:04:48.76,1:04:49.59,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,1:04:49.72,1:04:52.47,Default,,0,0,0,,Ал барабандар!
Dialogue: 0,1:04:53.84,1:04:55.93,Default,,0,0,0,,Субару desu!
Dialogue: 0,1:04:56.05,1:04:57.60,Default,,0,0,0,,Уф!
Dialogue: 0,1:04:57.72,1:05:00.52,Default,,0,0,0,,«Беріңіз» «Бұл мүмкін емес»
Dialogue: 0,1:05:00.64,1:05:04.90,Default,,0,0,0,,«Бұл мүмкін емес» «Шындыққа қараңыз» «Бұл жеткілікті»
Dialogue: 0,1:05:05.11,1:05:06.94,Default,,0,0,0,,«Маған да қиын...»
Dialogue: 0,1:05:07.48,1:05:10.90,Default,,0,0,0,,Міне, шындық мені жұтып қоюға тырысты.
Dialogue: 0,1:05:11.03,1:05:13.28,Default,,0,0,0,,Ол сондай мейірімді жүзімен мені жеп жатыр...
Dialogue: 0,1:05:14.74,1:05:17.74,Default,,0,0,0,,Сондықтан мен бұл әнді ұстанамын
Dialogue: 0,1:05:18.12,1:05:19.33,Default,,0,0,0,,Және…
Dialogue: 0,1:05:19.83,1:05:22.83,Default,,0,0,0,,Осы әнмен сенбейтіндерді сендіремін.
Dialogue: 0,1:05:23.37,1:05:26.34,Default,,0,0,0,,Менің қазынамнан бас тартқандардың бәріне
Dialogue: 0,1:05:26.75,1:05:29.34,Default,,0,0,0,,Қате емес деп айқайлаймын!
Dialogue: 0,1:05:29.96,1:05:32.47,Default,,0,0,0,,«Бос және катарсис» ♪Қанша алсаңыз да
Dialogue: 0,1:05:32.59,1:05:35.18,Default,,0,0,0,,♪Менікі қанша?
Dialogue: 0,1:05:35.30,1:05:37.30,Default,,0,0,0,,♪Не болса да, не болса да
Dialogue: 0,1:05:37.43,1:05:43.85,Default,,0,0,0,,♪Мен жете алмаймын.
Dialogue: 0,1:05:49.23,1:05:51.19,Default,,0,0,0,,♪Тым жоғары үміт
Dialogue: 0,1:05:51.32,1:05:54.40,Default,,0,0,0,,♪Шіріген сөздер
Dialogue: 0,1:05:54.53,1:05:56.99,Default,,0,0,0,,♪Ешкім ешкімнен артық емес
Dialogue: 0,1:05:57.12,1:06:00.08,Default,,0,0,0,,♪Мен сенің жоғары болғаныңды қаламаймын.
Dialogue: 0,1:06:00.20,1:06:03.16,Default,,0,0,0,,♪Бір ғана себеп бар
Dialogue: 0,1:06:03.29,1:06:06.42,Default,,0,0,0,,♪Себебі мен оны бұзғаныңды қалаймын
Dialogue: 0,1:06:06.75,1:06:08.84,Default,,0,0,0,,♪Бұл бостық
Dialogue: 0,1:06:09.80,1:06:14.51,Default,,0,0,0,,♪Таза жүрекпен көргенде
Dialogue: 0,1:06:14.93,1:06:19.89,Default,,0,0,0,,♪Бәрі кемпірқосақ түсті болып көрінеді делік
Dialogue: 0,1:06:20.01,1:06:22.02,Default,,0,0,0,,♪Тіпті мен нені түсінгім келеді
Dialogue: 0,1:06:22.14,1:06:25.02,Default,,0,0,0,,♪Бұлыңғыр және бұлыңғыр
Dialogue: 0,1:06:25.14,1:06:26.35,Default,,0,0,0,,♪Менің өлгім келмейді
Dialogue: 0,1:06:26.48,1:06:27.65,Default,,0,0,0,,♪Өлгенше өмір сүр
Dialogue: 0,1:06:27.77,1:06:28.98,Default,,0,0,0,,♪Мен оны қалаймын, мен оны қалаймын
Dialogue: 0,1:06:29.11,1:06:30.32,Default,,0,0,0,,♪Бұл жан
Dialogue: 0,1:06:30.44,1:06:32.28,Default,,0,0,0,,♪Ақылға сыймайтын шыдамсыздық
Dialogue: 0,1:06:32.40,1:06:35.40,Default,,0,0,0,,♪Мен оны тоқтата алмаймын
Dialogue: 0,1:06:35.53,1:06:36.74,Default,,0,0,0,,♪Мен кешіре алмаймын, кешіре алмаймын
Dialogue: 0,1:06:36.86,1:06:37.91,Default,,0,0,0,,♪Бұл тұрарлық емес
Dialogue: 0,1:06:38.03,1:06:39.24,Default,,0,0,0,,♪ үшін және бәрі
Dialogue: 0,1:06:39.37,1:06:40.70,Default,,0,0,0,,♪Мен төменмін.
Dialogue: 0,1:06:40.83,1:06:43.83,Default,,0,0,0,,♪ Көз жасы тек бетінде
Dialogue: 0,1:06:43.95,1:06:51.00,Default,,0,0,0,,♪Мен оны жасырамын.
Dialogue: 0,1:06:56.26,1:06:58.18,Default,,0,0,0,,♪ Мойынсұнғыш бол
Dialogue: 0,1:06:58.30,1:07:01.35,Default,,0,0,0,,♪Блять лас сөздер
Dialogue: 0,1:07:01.81,1:07:03.93,Default,,0,0,0,,♪ Құлағымды жабатыным сонша
Dialogue: 0,1:07:04.06,1:07:07.19,Default,,0,0,0,,♪ Бағыну - бұл құмарлық
Dialogue: 0,1:07:07.31,1:07:10.06,Default,,0,0,0,,♪ Қайғылы және жалғыз
Dialogue: 0,1:07:10.19,1:07:13.82,Default,,0,0,0,,♪Барар жері жоқ ауырсыну
Dialogue: 0,1:07:13.94,1:07:16.78,Default,,0,0,0,,♪Көтерілді
Dialogue: 0,1:07:16.95,1:07:21.49,Default,,0,0,0,,♪Жүрегі бос болса, жылай алмаймын
Dialogue: 0,1:07:21.99,1:07:26.62,Default,,0,0,0,,♪Түсініп, Үнсіз дауыс шымырлайды
Dialogue: 0,1:07:27.12,1:07:28.96,Default,,0,0,0,,♪Тіпті мен қол жеткізгім келетін нәрсе
Dialogue: 0,1:07:29.08,1:07:35.13,Default,,0,0,0,,♪Түтін бұлыңғыр болады
Dialogue: 0,1:07:50.44,1:07:52.23,Default,,0,0,0,,♪Тіпті мен нені түсінгім келеді
Dialogue: 0,1:07:52.36,1:07:55.57,Default,,0,0,0,,♪Бұлыңғыр және бұлыңғыр
Dialogue: 0,1:08:03.28,1:08:04.28,Default,,0,0,0,,♪Мен жоғалып кеткім келмейді
Dialogue: 0,1:08:04.41,1:08:05.66,Default,,0,0,0,,♪Оны жойғаныңды қалаймын.
Dialogue: 0,1:08:05.79,1:08:06.91,Default,,0,0,0,,♪Тот басқан, шатастырылған
Dialogue: 0,1:08:07.04,1:08:08.33,Default,,0,0,0,,♪Бұрмаланған шу
Dialogue: 0,1:08:08.46,1:08:10.42,Default,,0,0,0,,♪Ашық және бұлтты
Dialogue: 0,1:08:10.54,1:08:13.46,Default,,0,0,0,,♪Бөлініп кеткенде әдемі
Dialogue: 0,1:08:13.59,1:08:14.63,Default,,0,0,0,,♪ аянышты, аянышты
Dialogue: 0,1:08:14.75,1:08:16.09,Default,,0,0,0,,♪Мен оны жек көремін
Dialogue: 0,1:08:16.21,1:08:17.21,Default,,0,0,0,,♪Мәні, өшкен, тыныс, өшкен
Dialogue: 0,1:08:17.34,1:08:19.13,Default,,0,0,0,,♪Идеал = ескі қиял
Dialogue: 0,1:08:19.26,1:08:21.89,Default,,0,0,0,,♪ Тіпті қарсылық көрсетпей
Dialogue: 0,1:08:22.01,1:08:26.77,Default,,0,0,0,,♪Мен қорқамын
Dialogue: 0,1:08:28.35,1:08:34.36,Default,,0,0,0,,♪Мен қорқамын
Dialogue: 0,1:08:36.53,1:08:39.53,Default,,0,0,0,,～♪
Dialogue: 0,1:08:39.65,1:08:44.03,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,1:08:45.45,1:08:49.29,Default,,0,0,0,,Момока-сан... Мен қателеспеймін, солай ма?
Dialogue: 0,1:08:50.58,1:08:51.58,Default,,0,0,0,,[Ысырма дыбысы]
Dialogue: 0,1:08:53.17,1:08:55.42,Default,,0,0,0,,үшін... әдемі
Dialogue: 0,1:08:55.96,1:08:57.34,Default,,0,0,0,,Түзету.
Dialogue: 0,1:08:57.71,1:08:59.76,Default,,0,0,0,,Иә!? Шынымен бе?
Dialogue: 0,1:09:00.63,1:09:02.63,Default,,0,0,0,,Бұл рас...
Dialogue: 0,1:09:03.13,1:09:05.64,Default,,0,0,0,,Менің мұрным салқын...
Dialogue: 0,1:09:05.76,1:09:08.77,Default,,0,0,0,,Ах! Оны менімен тексерме!
Dialogue: 0,1:09:09.52,1:09:11.27,Default,,0,0,0,,Не? Сізде толық емес жұмыс күні бар ма?
Dialogue: 0,1:09:11.69,1:09:13.48,Default,,0,0,0,,Маған айтқаныңызды қалаймын.
Dialogue: 0,1:09:13.77,1:09:17.27,Default,,0,0,0,,Бүгін Рупа мен Сатосидің соңғы жарты күндік жұмысы болған сияқты.
Dialogue: 0,1:09:17.40,1:09:21.74,Default,,0,0,0,,«Бұл маған осы уақытқа дейін қамқорлық жасаған жер, сондықтан мені жіберіңізші».
Dialogue: 0,1:09:22.15,1:09:25.07,Default,,0,0,0,,Бұған көмектесу мүмкін емес (Момока) Кешіріңіз.
Dialogue: 0,1:09:25.20,1:09:26.16,Default,,0,0,0,,Хмм?
Dialogue: 0,1:09:26.28,1:09:27.99,Default,,0,0,0,,Президенттің хоббиі
Dialogue: 0,1:09:28.37,1:09:30.83,Default,,0,0,0,,«Компанияңыздың аты жазылған су»…
Dialogue: 0,1:09:30.95,1:09:32.87,Default,,0,0,0,,Тікенекті құмырсқа суы?
Dialogue: 0,1:09:33.21,1:09:35.92,Default,,0,0,0,,Оны естігенде тамағым ауырады...
Dialogue: 0,1:09:36.04,1:09:39.13,Default,,0,0,0,,Иә, келісім-шарт құжаттарында мәселе жоқ.
Dialogue: 0,1:09:39.50,1:09:44.38,Default,,0,0,0,,Сонымен, бүгіннен бастап сіз ресми түрде осы кеңсеге қосыласыз.
Dialogue: 0,1:09:44.51,1:09:47.26,Default,,0,0,0,,Мен, Миура, жауапты боламын.
Dialogue: 0,1:09:47.55,1:09:48.64,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,1:09:48.89,1:09:49.89,Default,,0,0,0,,Мен де солай.
Dialogue: 0,1:09:50.02,1:09:51.77,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,1:09:52.68,1:09:55.40,Default,,0,0,0,,Сонымен біз кеңсеге кірдік.
Dialogue: 0,1:09:55.69,1:09:58.15,Default,,0,0,0,,Не? Нижуман?
Dialogue: 0,1:09:58.44,1:10:01.57,Default,,0,0,0,,Иә, ол әр айдың 25-ін айтты деп ойлаймын.
Dialogue: 0,1:10:01.69,1:10:03.11,Default,,0,0,0,,Мен оны пайдалана аламын ба?
Dialogue: 0,1:10:03.24,1:10:06.16,Default,,0,0,0,,Көрініп тұр, бұл жалақы.
Dialogue: 0,1:10:06.28,1:10:09.74,Default,,0,0,0,,Бірақ біз тапқан ақшаның қанша пайызы?
Dialogue: 0,1:10:09.87,1:10:11.41,Default,,0,0,0,,Оны кеңсе әкеледі.
Dialogue: 0,1:10:11.54,1:10:13.91,Default,,0,0,0,,Тауарлар, тікелей шоулар және альбомдар
Dialogue: 0,1:10:14.04,1:10:18.46,Default,,0,0,0,,Егер агенттік мұнда және сол жерде сатылым жасаса, бұл екі тарап үшін де ұтысқа ие болады.
Dialogue: 0,1:10:18.92,1:10:21.46,Default,,0,0,0,,Қарапайым тілмен айтсақ, мынандай.
Dialogue: 0,1:10:21.88,1:10:25.01,Default,,0,0,0,,...Сізге әлі де мән бересіз бе? Бұған дейінгі фестиваль
Dialogue: 0,1:10:25.13,1:10:27.34,Default,,0,0,0,,Сіз жай ғана эго жасап жатырсыз ба?
Dialogue: 0,1:10:27.47,1:10:30.60,Default,,0,0,0,,Иә, аламын! Бұл керемет тікелей эфир болды!
Dialogue: 0,1:10:30.72,1:10:34.98,Default,,0,0,0,,Жақсы, бізді бағалағандар әлі де болды.
Dialogue: 0,1:10:35.10,1:10:37.27,Default,,0,0,0,,Шарт осылай жасалды
Dialogue: 0,1:10:37.40,1:10:38.23,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:10:38.61,1:10:41.23,Default,,0,0,0,,Мен айттым ғой, солай ма? «Эгоисттік ештеңе жасамаңыз»
Dialogue: 0,1:10:42.07,1:10:42.90,Default,,0,0,0,,Иә...
Dialogue: 0,1:10:43.03,1:10:46.45,Default,,0,0,0,,Асыққанның жөні жоқ. Шайқас басталғалы тұр.
Dialogue: 0,1:10:46.57,1:10:48.49,Default,,0,0,0,,Камадо!
Dialogue: 0,1:10:48.99,1:10:51.20,Default,,0,0,0,,Момока-сан да мұны өте жақсы біледі.
Dialogue: 0,1:10:51.33,1:10:52.33,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:52.45,1:10:53.66,Default,,0,0,0,,Ха! Хаа!
Dialogue: 0,1:10:54.66,1:10:56.08,Default,,0,0,0,,Иә, бұл
Dialogue: 0,1:10:57.25,1:10:59.25,Default,,0,0,0,,Екі адам арасындағы келісім-шарттың көшірмесі
Dialogue: 0,1:11:00.13,1:11:01.13,Default,,0,0,0,,Және…
Dialogue: 0,1:11:01.50,1:11:03.13,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,1:11:03.88,1:11:04.80,Default,,0,0,0,,Не?
Dialogue: 0,1:11:04.92,1:11:06.88,Default,,0,0,0,,Оны шын жүректен қабылдаңыз!
Dialogue: 0,1:11:07.01,1:11:09.39,Default,,0,0,0,,Сіз не тапсырыс бергіңіз келеді?
Dialogue: 0,1:11:09.68,1:11:11.22,Default,,0,0,0,,Содан кейін бір орташа
Dialogue: 0,1:11:11.35,1:11:13.14,Default,,0,0,0,,Сонда мен де орташамын.
Dialogue: 0,1:11:13.77,1:11:15.81,Default,,0,0,0,,Менің келмегеніме көп уақыт болды.
Dialogue: 0,1:11:15.93,1:11:18.73,Default,,0,0,0,,Басында мен Нинаға тамақ бердім.
Dialogue: 0,1:11:18.85,1:11:19.94,Default,,0,0,0,,Бұл осында болды.
Dialogue: 0,1:11:20.06,1:11:20.90,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:11:21.15,1:11:24.40,Default,,0,0,0,,Токио вокзалынан мұнда жету үшін 4 сағат кетті.
Dialogue: 0,1:11:24.53,1:11:26.90,Default,,0,0,0,,«Менде кілт жоқ» болса ше?
Dialogue: 0,1:11:27.24,1:11:29.03,Default,,0,0,0,,Сіз қаншалықты бағытты сезінесіз?
Dialogue: 0,1:11:29.41,1:11:31.03,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,1:11:32.08,1:11:33.03,Default,,0,0,0,,Сатоши-чан
Dialogue: 0,1:11:34.37,1:11:35.95,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,1:11:37.21,1:11:38.04,Default,,0,0,0,,Олай болса!
Dialogue: 0,1:11:38.29,1:11:42.84,Default,,0,0,0,,Бұдан былай Тогенаши Тогеаридің кәсіби келісім-шартты еске алу кеші...
Dialogue: 0,1:11:44.30,1:11:45.17,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:45.42,1:11:49.59,Default,,0,0,0,,Мен толық емес жұмыс күнімнен жаңа ғана шықтым, сондықтан мен жақында келемін деген хабарлама алдым.
Dialogue: 0,1:11:49.72,1:11:50.68,Default,,0,0,0,,көремін.
Dialogue: 0,1:11:50.84,1:11:53.93,Default,,0,0,0,,Соңында да көп нәрсе бар.
Dialogue: 0,1:11:54.06,1:11:55.02,Default,,0,0,0,,[Асқабақтың кесілген дыбысы]
Dialogue: 0,1:11:55.14,1:11:56.43,Default,,0,0,0,,Itte...
Dialogue: 0,1:11:56.73,1:11:59.44,Default,,0,0,0,,Шикі асқабақ шынымен қатты ма?
Dialogue: 0,1:11:59.56,1:12:01.10,Default,,0,0,0,,Мен мұны бірінші рет білдім
Dialogue: 0,1:12:01.23,1:12:03.94,Default,,0,0,0,,Әй, жас келіншектің бірдеңе айтқанына біраз болды.
Dialogue: 0,1:12:04.27,1:12:06.57,Default,,0,0,0,,Already! Бұл басқаша
Dialogue: 0,1:12:06.69,1:12:08.95,Default,,0,0,0,,Мен мұны бұрын айтпадым ба...
Dialogue: 0,1:12:09.24,1:12:11.11,Default,,0,0,0,,Иә?қалай?
Dialogue: 0,1:12:11.32,1:12:14.91,Default,,0,0,0,,Мүмкін шынымен солай болған шығар...
Dialogue: 0,1:12:15.41,1:12:16.87,Default,,0,0,0,,Мұнда келіңіз
Dialogue: 0,1:12:17.00,1:12:19.83,Default,,0,0,0,,Момока-сан саған көп нәрсені үйретті, солай ма?
Dialogue: 0,1:12:20.17,1:12:22.92,Default,,0,0,0,,Ол кезде бұл үлкен соққы болды.
Dialogue: 0,1:12:23.04,1:12:25.71,Default,,0,0,0,,«Мен ештеңе істей алмаймын».
Dialogue: 0,1:12:25.84,1:12:29.80,Default,,0,0,0,,«Мен ештеңе білмегенімді түсінбедім».
Dialogue: 0,1:12:29.92,1:12:31.84,Default,,0,0,0,,Қазір кейбір нәрселерді жасай аласыз ба?
Dialogue: 0,1:12:32.18,1:12:35.60,Default,,0,0,0,,Қазір! Менде әлі гитара жоқ...
Dialogue: 0,1:12:35.97,1:12:37.60,Default,,0,0,0,,Бұл шынымен жақсы болды ма?
Dialogue: 0,1:12:38.22,1:12:40.23,Default,,0,0,0,,Мен сені осылай ойлауға тырысамын.
Dialogue: 0,1:12:40.35,1:12:42.10,Default,,0,0,0,,Бұдан былай барлығына
Dialogue: 0,1:12:42.65,1:12:43.81,Default,,0,0,0,,Иә, иә, хехе...
Dialogue: 0,1:12:43.94,1:12:46.61,Default,,0,0,0,,[Алдыңғы есіктің ашылған дыбысы] Сізді күткенім үшін кешіріңіз~
Dialogue: 0,1:12:47.61,1:12:48.69,Default,,0,0,0,,Және…
Dialogue: 0,1:12:48.82,1:12:51.11,Default,,0,0,0,,Мен топтың логотипін де жасадым.
Dialogue: 0,1:12:51.24,1:12:52.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:52.57,1:12:54.07,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:12:55.16,1:12:57.91,Default,,0,0,0,,Не, екеуің мұны енді өз беттеріңмен бастап жатырсыңдар!
Dialogue: 0,1:12:58.04,1:13:00.54,Default,,0,0,0,,Сіз әлі сәлем айтқан жоқсыз! Greetings!
Dialogue: 0,1:13:00.66,1:13:01.54,Default,,0,0,0,,(Бекки) Ах, емтихандар аяқталды — ақыры тыныш күндер келді~
Dialogue: 0,1:13:01.66,1:13:03.08,Default,,0,0,0,,Мен сізді естімеймін.
Dialogue: 0,1:13:03.37,1:13:06.34,Default,,0,0,0,,Мүлдем... (Нина) Біз де бастау керек пе?
Dialogue: 0,1:13:06.46,1:13:08.09,Default,,0,0,0,,Оған көмектесу мүмкін емес...
Dialogue: 0,1:13:08.51,1:13:12.80,Default,,0,0,0,,Ах! Сондықтан мен қытай қырыққабатының жанкүйерімін деймін.
Dialogue: 0,1:13:12.93,1:13:15.10,Default,,0,0,0,,Мен де пысық адаммын (Нина) Қараңдар!
Dialogue: 0,1:13:15.39,1:13:17.47,Default,,0,0,0,,Қандай азап! Екеуміз де!
Dialogue: 0,1:13:17.72,1:13:19.60,Default,,0,0,0,,Мен бұл туралы ерекшемін! (Сатоши) Иә.
Dialogue: 0,1:13:19.72,1:13:20.56,Default,,0,0,0,,Шулы!
Dialogue: 0,1:13:20.68,1:13:22.64,Default,,0,0,0,,Бұл, әрине, дәмдірек!
Dialogue: 0,1:13:22.77,1:13:24.23,Default,,0,0,0,,Бұл басталды.
Dialogue: 0,1:13:24.35,1:13:25.98,Default,,0,0,0,,Текстурасы болмаса, дәмі болмайды!
Dialogue: 0,1:13:26.19,1:13:28.65,Default,,0,0,0,,Мен сені де Какутаку фракциясына айналдырамын ба?
Dialogue: 0,1:13:28.78,1:13:29.86,Default,,0,0,0,,Жеңдер!
Dialogue: 0,1:13:30.24,1:13:34.24,Default,,0,0,0,,(шулы сөйлеу)
Dialogue: 0,1:13:37.70,1:13:39.29,Default,,0,0,0,,Не болды?
Dialogue: 0,1:13:40.04,1:13:41.54,Default,,0,0,0,,Ән идеялары…
Dialogue: 0,1:13:41.91,1:13:42.75,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:43.00,1:13:44.62,Default,,0,0,0,,Мен тақырыпты ойлап таптым
Dialogue: 0,1:13:47.25,1:13:50.13,Default,,0,0,0,,Уау... бұл ақылсыз!
Dialogue: 0,1:13:50.38,1:13:51.51,Default,,0,0,0,,(Миураның жөтелі)
Dialogue: 0,1:13:51.63,1:13:52.88,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:13:53.42,1:13:55.34,Default,,0,0,0,,Бұл Наката мырза, инженер.
Dialogue: 0,1:13:55.47,1:13:57.39,Default,,0,0,0,,Nakata. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,1:13:57.76,1:13:59.14,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,1:13:59.47,1:14:01.68,Default,,0,0,0,,Бұл менің көмекшім Накано мырза.
Dialogue: 0,1:14:01.81,1:14:02.89,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,1:14:03.35,1:14:05.02,Default,,0,0,0,,Бұл AP-тен келген Танака мырза.
Dialogue: 0,1:14:05.27,1:14:07.27,Default,,0,0,0,,Ал жарнаманың Тано мырзасы
Dialogue: 0,1:14:07.61,1:14:10.15,Default,,0,0,0,,Мен оны мүлде есіме түсіре алмайтын сияқтымын.
Dialogue: 0,1:14:10.28,1:14:13.03,Default,,0,0,0,,Бұл жұмыстың бір бөлігі екенін есте сақтау.
Dialogue: 0,1:14:13.36,1:14:15.53,Default,,0,0,0,,Момока-сан, есіңде ме?
Dialogue: 0,1:14:15.91,1:14:19.83,Default,,0,0,0,,Бұл қоғам мүшесі ретінде парасаттылық.
Dialogue: 0,1:14:19.95,1:14:22.79,Default,,0,0,0,,Олай болса, инженердің аты кім?
Dialogue: 0,1:14:22.91,1:14:24.54,Default,,0,0,0,,Танака мырза (Наката) «Наката»
Dialogue: 0,1:14:24.66,1:14:26.04,Default,,0,0,0,,Уф... [Тақтаны түсірген дыбыс]
Dialogue: 0,1:14:26.17,1:14:28.00,Default,,0,0,0,,Кешіріңіз... (Нина мен Субару күледі)
Dialogue: 0,1:14:28.13,1:14:29.04,Default,,0,0,0,,Күлме
Dialogue: 0,1:14:29.38,1:14:32.76,Default,,0,0,0,,Әнді күні кеше Момока берген еді ғой?
Dialogue: 0,1:14:32.88,1:14:33.72,Default,,0,0,0,,Иә
Dialogue: 0,1:14:33.84,1:14:35.55,Default,,0,0,0,,Мен оған шартты түрде сөз қостым.
Dialogue: 0,1:14:35.72,1:14:39.10,Default,,0,0,0,,Hoora! Сіз қашаннан бері күліп жүрсіз?
Dialogue: 0,1:14:39.22,1:14:40.43,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:14:42.10,1:14:43.10,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:43.60,1:14:45.06,Default,,0,0,0,,Бұл тақырып...
Dialogue: 0,1:14:45.31,1:14:48.31,Default,,0,0,0,,Иә, мен мұны барлығын ойлай отырып жасадым.
Dialogue: 0,1:14:48.81,1:14:52.48,Default,,0,0,0,,Ең бірінші қандай ән шығарғым келеді деп ойлағанымда,
Dialogue: 0,1:14:52.61,1:14:55.32,Default,,0,0,0,,Өйткені, бұл тек біз туралы.
Dialogue: 0,1:14:56.40,1:14:57.32,Default,,0,0,0,,Момока-сан...
Dialogue: 0,1:14:57.57,1:14:59.57,Default,,0,0,0,,Жақсы! Сонда бастайық па?
Dialogue: 0,1:15:00.20,1:15:01.83,Default,,0,0,0,,Нина (Нина) Иә?
Dialogue: 0,1:15:02.08,1:15:05.71,Default,,0,0,0,,Егер сіз Дедусты шынымен жеңгіңіз келсе, оған рухыңызды салыңыз.
Dialogue: 0,1:15:06.62,1:15:07.46,Default,,0,0,0,,Иә
Dialogue: 0,1:15:08.25,1:15:11.46,Default,,0,0,0,,Бесеуміз ән жаза бастадық.
Dialogue: 0,1:15:11.59,1:15:14.59,Default,,0,0,0,,♪～
Dialogue: 0,1:16:00.89,1:16:02.64,Default,,0,0,0,,～♪
Dialogue: 0,1:16:02.97,1:16:04.89,Default,,0,0,0,,Мүмкін мен шектен шығып кеткен шығармын?
Dialogue: 0,1:16:05.01,1:16:07.14,Default,,0,0,0,,Иә? Дегенмен жақсы деп ойлаймын
Dialogue: 0,1:16:07.39,1:16:11.06,Default,,0,0,0,,Керісінше, біз алдымен жасаған нәрсені алуымыз керек емес пе?
Dialogue: 0,1:16:11.19,1:16:13.15,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:16:13.40,1:16:16.15,Default,,0,0,0,,...
Dialogue: 0,1:16:16.53,1:16:19.90,Default,,0,0,0,,Кешіріңіз, бірақ бұл өте ұзақ.
Dialogue: 0,1:16:20.24,1:16:21.28,Default,,0,0,0,,Иә
Dialogue: 0,1:16:21.82,1:16:24.78,Default,,0,0,0,,Ха... Уақытында үлгердім.
Dialogue: 0,1:16:25.12,1:16:26.16,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,1:16:26.29,1:16:28.04,Default,,0,0,0,,...
Dialogue: 0,1:16:29.29,1:16:31.29,Default,,0,0,0,,Бұл... қызық.
Dialogue: 0,1:16:31.42,1:16:32.29,Default,,0,0,0,,Не?
Dialogue: 0,1:16:32.54,1:16:36.17,Default,,0,0,0,,Қазір бәріміз өз әндерімізді жасап жатырмыз, солай ма?
Dialogue: 0,1:16:36.50,1:16:40.43,Default,,0,0,0,,Жақында біреуге жетеді деп ойласам...
Dialogue: 0,1:16:40.80,1:16:42.93,Default,,0,0,0,,...
Dialogue: 0,1:16:43.05,1:16:44.14,Default,,0,0,0,,...
Dialogue: 0,1:16:44.26,1:16:46.93,Default,,0,0,0,,Кейде оны сіз үшін ешкім алмайды.
Dialogue: 0,1:16:47.18,1:16:48.68,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:16:49.14,1:16:52.60,Default,,0,0,0,,Өйткені мен бұл үшін көп жұмыс істеп жатырмын.
Dialogue: 0,1:16:53.35,1:16:54.65,Default,,0,0,0,,Жарайды...
Dialogue: 0,1:16:59.11,1:17:01.95,Default,,0,0,0,,Аа, Миура...
Dialogue: 0,1:17:00.19,1:17:02.82,Default,,0,0,0,,Daedus!? Шынымен бе?
Dialogue: 0,1:17:03.32,1:17:04.49,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,1:17:04.62,1:17:06.24,Default,,0,0,0,,Мен сізге кейінірек хабарласамын.
Dialogue: 0,1:17:07.74,1:17:08.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:08.79,1:17:12.83,Default,,0,0,0,,Момока-сан Миура-санның да тыңдағанын қалайтын ән...
Dialogue: 0,1:17:13.37,1:17:16.34,Default,,0,0,0,,Сіз мұны естідіңіз бе? ток
Dialogue: 0,1:17:16.54,1:17:17.38,Default,,0,0,0,,Жоқ
Dialogue: 0,1:17:17.80,1:17:19.05,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:17:19.80,1:17:22.59,Default,,0,0,0,,Гауһар шаңы не болды?
Dialogue: 0,1:17:23.30,1:17:24.30,Default,,0,0,0,,Я...
Dialogue: 0,1:17:24.80,1:17:27.60,Default,,0,0,0,,Бұл бұрын басқа жақтан жіберілген нәрсе.
Dialogue: 0,1:17:28.39,1:17:29.89,Default,,0,0,0,,Читта 2 КҮН
Dialogue: 0,1:17:30.02,1:17:34.10,Default,,0,0,0,,1-күн: Алмаз шаңы 2-күн: Тікенекті тікенді құмырсқа…
Dialogue: 0,1:17:34.35,1:17:37.02,Default,,0,0,0,,Шынайы ма? Осындай үлкен жерде?
Dialogue: 0,1:17:37.15,1:17:40.57,Default,,0,0,0,,Осы әннің кестесін білгендей.
Dialogue: 0,1:17:40.69,1:17:41.99,Default,,0,0,0,,Мерзім - ақпан.
Dialogue: 0,1:17:42.40,1:17:44.91,Default,,0,0,0,,Ол мұны Валентин күні жобасы ретінде жасағысы келеді.
Dialogue: 0,1:17:45.03,1:17:47.87,Default,,0,0,0,,...
Dialogue: 0,1:17:48.37,1:17:50.50,Default,,0,0,0,,Келесі бетті оқыңыз
Dialogue: 0,1:17:51.66,1:17:55.29,Default,,0,0,0,,Билет сатылымы мен қатысатын адамдар санына қарай жарысыңыз
Dialogue: 0,1:17:55.42,1:17:58.59,Default,,0,0,0,,Драманың негізгі әні ретінде жеңімпаз таңдалатын сияқты.
Dialogue: 0,1:17:58.96,1:17:59.96,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,1:18:00.21,1:18:01.38,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:18:01.51,1:18:03.38,Default,,0,0,0,,Иә? Не?
Dialogue: 0,1:18:04.13,1:18:05.13,Default,,0,0,0,,Жеңіске жете алмайсыз ба?
Dialogue: 0,1:18:05.39,1:18:07.89,Default,,0,0,0,,Егер сіз төбелеске дейін жеңілетініңізді білсеңіз не істейсіз?
Dialogue: 0,1:18:08.01,1:18:10.01,Default,,0,0,0,,Сіз тырысуыңыз керек... (Момока) Білесіз бе!
Dialogue: 0,1:18:10.14,1:18:14.56,Default,,0,0,0,,Бұл жобаның кемшілігі сол аудиторияның алдында емес.
Dialogue: 0,1:18:14.85,1:18:18.11,Default,,0,0,0,,Олар «топқа қарсы» десе де, олар әрқайсысының жеке адамы.
Dialogue: 0,1:18:18.23,1:18:21.53,Default,,0,0,0,,Сондықтан маңыздысы сол күнгі спектакль емес.
Dialogue: 0,1:18:21.65,1:18:22.94,Default,,0,0,0,,Жұмылдыру күші
Dialogue: 0,1:18:23.28,1:18:25.82,Default,,0,0,0,,Аты көп танылған адам міндетті түрде жеңеді.
Dialogue: 0,1:18:25.95,1:18:27.45,Default,,0,0,0,,Бұл не...
Dialogue: 0,1:18:27.82,1:18:29.83,Default,,0,0,0,,Ашуланғаннан пайда жоқ.
Dialogue: 0,1:18:30.16,1:18:34.37,Default,,0,0,0,,Бірақ Дайдас мүшелері бұл туралы не ойлайды?
Dialogue: 0,1:18:34.75,1:18:36.00,Default,,0,0,0,,Саана
Dialogue: 0,1:18:36.71,1:18:38.88,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,1:18:39.00,1:18:42.46,Default,,0,0,0,,Ең болмағанда мен білетін Хина сондай...
Dialogue: 0,1:18:42.67,1:18:46.55,Default,,0,0,0,,«Маған пайдалы таңдау жасаудың несі жаман?» Дейтін бала.
Dialogue: 0,1:18:47.01,1:18:49.47,Default,,0,0,0,,Бір-бірімізге жаман сөз айтсақ, бәлеге қалатын сияқтымыз.
Dialogue: 0,1:18:49.72,1:18:51.35,Default,,0,0,0,,Бұл шынымен де жаман ба?
Dialogue: 0,1:18:51.47,1:18:53.85,Default,,0,0,0,,Бұл драмаларда жиі кездеседі емес пе?
Dialogue: 0,1:18:53.98,1:18:56.10,Default,,0,0,0,,Біз сыра және басқа сусындар туралы сөйлестік...
Dialogue: 0,1:18:56.23,1:18:57.60,Default,,0,0,0,,Мен оны көрдім!
Dialogue: 0,1:18:57.85,1:18:59.81,Default,,0,0,0,,Не? Бұл рас па?
Dialogue: 0,1:18:59.94,1:19:00.86,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,1:19:01.19,1:19:03.11,Default,,0,0,0,,Көпшілік дауыс қана емес пе?
Dialogue: 0,1:19:03.57,1:19:05.70,Default,,0,0,0,,Пайда болғанды жақсы деп санайтын адамдар
Dialogue: 0,1:19:06.32,1:19:08.49,Default,,0,0,0,,Көрмегені жақсы деп ойлайтын адамдар
Dialogue: 0,1:19:12.83,1:19:13.83,Default,,0,0,0,,Шит… шит…
Dialogue: 0,1:19:14.12,1:19:16.33,Default,,0,0,0,,Біз бәріміз әртүрлі нәрселер туралы сөйлестік.
Dialogue: 0,1:19:16.46,1:19:20.96,Default,,0,0,0,,Менің ойымша, әлі ерте, немесе мен жеткілікті түрде дайын емеспін...
Dialogue: 0,1:19:21.63,1:19:22.71,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,1:19:22.96,1:19:26.47,Default,,0,0,0,,Содан кейін мен басқа тарапқа бас тарту туралы хабарлаймын.
Dialogue: 0,1:19:26.72,1:19:27.88,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:19:28.01,1:19:30.47,Default,,0,0,0,,Миура мырза не ойлады?
Dialogue: 0,1:19:30.76,1:19:31.89,Default,,0,0,0,,Нина…
Dialogue: 0,1:19:33.64,1:19:35.73,Default,,0,0,0,,Шынымды айтсам абдырап қалдым.
Dialogue: 0,1:19:35.85,1:19:38.23,Default,,0,0,0,,Жеңіске жету қиын болады деп ойладым.
Dialogue: 0,1:19:38.56,1:19:41.81,Default,,0,0,0,,Дегенмен, менің атым бүгінгі Дайдалармен қатар көрінсе,
Dialogue: 0,1:19:41.94,1:19:43.23,Default,,0,0,0,,Танымалдықтың артуы
Dialogue: 0,1:19:43.52,1:19:44.53,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,1:19:44.73,1:19:48.40,Default,,0,0,0,,Дегенмен, сонымен бірге, егер жарық пен қараңғылық тым айқын болса,
Dialogue: 0,1:19:48.53,1:19:52.33,Default,,0,0,0,,«Тікенді заттар танымал емес» деген күшті әсер бар.
Dialogue: 0,1:19:53.41,1:19:56.50,Default,,0,0,0,,Осыны да ескере отырып, олар жоспар құрды ма?
Dialogue: 0,1:19:56.75,1:19:59.42,Default,,0,0,0,,«Бірге өмір сүру және бірге өркендеу» «Бір-бірін ұстау»
Dialogue: 0,1:19:59.54,1:20:02.13,Default,,0,0,0,,Екеуі де шынайы ниет, екеуі де ресми.
Dialogue: 0,1:20:02.75,1:20:04.34,Default,,0,0,0,,Шынымды айтсам, білмеймін.
Dialogue: 0,1:20:05.71,1:20:08.51,Default,,0,0,0,,А, мен біраз шаршадым...
Dialogue: 0,1:20:08.63,1:20:11.14,Default,,0,0,0,,Әр нәрсенің бір сыры бар сияқты.
Dialogue: 0,1:20:11.34,1:20:13.39,Default,,0,0,0,,«Ересектер әлемі» сияқты сезіну
Dialogue: 0,1:20:14.39,1:20:15.35,Default,,0,0,0,,Не?
Dialogue: 0,1:20:15.47,1:20:17.98,Default,,0,0,0,,Сіз әлі де күресу керек деп ойлайсыз ба?
Dialogue: 0,1:20:18.10,1:20:19.31,Default,,0,0,0,,Хмм...
Dialogue: 0,1:20:19.44,1:20:22.56,Default,,0,0,0,,Мамандар осылай мәңгілікке жалғаса ма деп ойлаймын.
Dialogue: 0,1:20:22.69,1:20:25.32,Default,,0,0,0,,Сол жолды таңдаған Нина болды.
Dialogue: 0,1:20:25.90,1:20:26.90,Default,,0,0,0,,Мен келдім!
Dialogue: 0,1:20:27.03,1:20:28.65,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,1:20:28.99,1:20:32.24,Default,,0,0,0,,Ал, алдыңғы сөз тіркесіне оралайық.
Dialogue: 0,1:20:32.37,1:20:34.91,Default,,0,0,0,,Бұл жеткіліксіз.
Dialogue: 0,1:20:35.16,1:20:38.79,Default,,0,0,0,,Сонда нөлден қайта бастау жылдамырақ емес пе?
Dialogue: 0,1:20:39.12,1:20:41.96,Default,,0,0,0,,Бұл да рас па... Иә? Шынымен бе?
Dialogue: 0,1:20:42.08,1:20:43.79,Default,,0,0,0,,Не? Осы уакытқа дейін?
Dialogue: 0,1:20:44.13,1:20:47.05,Default,,0,0,0,,Дұрыс, мұндай нәрсе танымал емес...
Dialogue: 0,1:20:47.17,1:20:48.55,Default,,0,0,0,,Қызық, ескі ме?
Dialogue: 0,1:20:48.92,1:20:52.55,Default,,0,0,0,,Иә? Модуляцияны қосу үшін бұл жерде танымал екені рас.
Dialogue: 0,1:20:52.68,1:20:55.64,Default,,0,0,0,,[Бас өнімділігі]
Dialogue: 0,1:20:55.76,1:20:57.56,Default,,0,0,0,,Бұл солай ма? Сососо!
Dialogue: 0,1:20:58.22,1:20:59.48,Default,,0,0,0,,Момока-сан
Dialogue: 0,1:20:59.60,1:21:00.56,Default,,0,0,0,,Не?
Dialogue: 0,1:21:01.10,1:21:03.19,Default,,0,0,0,,Мен өзімді барлық нәрсеге тым көп уайымдайтындай сезінемін.
Dialogue: 0,1:21:03.31,1:21:07.07,Default,,0,0,0,,Мен бастаған жерімнен барған сайын алыстап бара жатқандай сезінемін.
Dialogue: 0,1:21:07.28,1:21:11.32,Default,,0,0,0,,Бұл Момоканың «Біз тікенді» фильміндегі әні, солай емес пе?
Dialogue: 0,1:21:11.45,1:21:13.82,Default,,0,0,0,,Олай болса, бұл жақсы деп ойлаймын...
Dialogue: 0,1:21:14.41,1:21:15.91,Default,,0,0,0,,Ең маңыздысы
Dialogue: 0,1:21:16.03,1:21:18.95,Default,,0,0,0,,Бұл біздің әніміз бе, жоқ па, соған байланысты.
Dialogue: 0,1:21:19.08,1:21:21.91,Default,,0,0,0,,Менің ойымша, бұл жеткілікті.
Dialogue: 0,1:21:22.83,1:21:25.92,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,1:21:26.04,1:21:28.21,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:21:29.59,1:21:30.63,Default,,0,0,0,,Бұл!
Dialogue: 0,1:21:31.17,1:21:32.17,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:32.59,1:21:34.34,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,1:21:34.59,1:21:37.22,Default,,0,0,0,,Мен Дедусқа қарсы ойнағым келеді.
Dialogue: 0,1:21:38.31,1:21:41.81,Default,,0,0,0,,Түрлі ниеттер мен жағдайлар бар екенін түсінемін.
Dialogue: 0,1:21:42.14,1:21:46.19,Default,,0,0,0,,Бірақ біз жеке шоу ретінде жеке шоу жасай аламыз, солай ма?
Dialogue: 0,1:21:46.31,1:21:47.48,Default,,0,0,0,,Сіз ән айта аласыз, солай ма?
Dialogue: 0,1:21:47.61,1:21:49.69,Default,,0,0,0,,Менің ойымша, бұл рас...
Dialogue: 0,1:21:49.82,1:21:52.61,Default,,0,0,0,,Олай болса ән айтқан дұрыс болар деп ойлаймын.
Dialogue: 0,1:21:52.74,1:21:54.07,Default,,0,0,0,,Қандай себеп болса да
Dialogue: 0,1:21:54.20,1:21:57.37,Default,,0,0,0,,Ән айтқан жерден қашпау керек деп ойлаймын.
Dialogue: 0,1:21:57.87,1:21:59.20,Default,,0,0,0,,Егер сіз мұны істесеңіз...
Dialogue: 0,1:21:59.87,1:22:01.37,Default,,0,0,0,,Бұл мен жеңілдім дегенді білдіре ме?
Dialogue: 0,1:22:02.04,1:22:03.04,Default,,0,0,0,,Иә
Dialogue: 0,1:22:03.54,1:22:06.13,Default,,0,0,0,,Жоқ? Момока-сан...
Dialogue: 0,1:22:06.79,1:22:07.71,Default,,0,0,0,,Хмм...
Dialogue: 0,1:22:10.59,1:22:12.67,Default,,0,0,0,,Момока-сан шешуі керек.
Dialogue: 0,1:22:12.80,1:22:16.01,Default,,0,0,0,,Қазіргі алмаз шаңымен не тығыз байланысты?
Dialogue: 0,1:22:16.14,1:22:17.89,Default,,0,0,0,,Өйткені бұл Момока-сан.
Dialogue: 0,1:22:18.39,1:22:22.27,Default,,0,0,0,,Бұл Нина-сан, Субару-сан және Томо-чан үшін жақсы емес пе?
Dialogue: 0,1:22:23.23,1:22:24.60,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,1:22:25.90,1:22:28.19,Default,,0,0,0,,Момока-сан мен Дайдас Нана-сан және т.б
Dialogue: 0,1:22:28.31,1:22:30.23,Default,,0,0,0,,Сіз жаңа жылдық қонаққа бардыңыз ба?
Dialogue: 0,1:22:30.36,1:22:31.44,Default,,0,0,0,,Кеше болған жайтқа әлі де алаңдайсың ба?
Dialogue: 0,1:22:31.57,1:22:34.24,Default,,0,0,0,,Бұл Құдайға арқа сүйейтін уақыт емес.
Dialogue: 0,1:22:34.65,1:22:36.07,Default,,0,0,0,,Шит… шит…
Dialogue: 0,1:22:38.57,1:22:40.49,Default,,0,0,0,,Не болды? Момока-сан
Dialogue: 0,1:22:41.16,1:22:44.50,Default,,0,0,0,,Біртүрлі емес пе? Мен соңғы кездері тітіркеніп жүрмін.
Dialogue: 0,1:22:44.83,1:22:47.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:22:47.25,1:22:49.09,Default,,0,0,0,,Соңғы кездері ән жақсы шығара алмай жүрмін...
Dialogue: 0,1:22:49.21,1:22:50.09,Default,,0,0,0,,Өтірік!
Dialogue: 0,1:22:50.80,1:22:53.38,Default,,0,0,0,,Бізге өтірік айтқаныңды қаламаймыз!
Dialogue: 0,1:22:54.51,1:22:55.51,Default,,0,0,0,,Я...
Dialogue: 0,1:22:57.39,1:22:58.76,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,1:22:59.35,1:23:02.18,Default,,0,0,0,,Музыка жасауға неғұрлым байсалды болсам, соғұрлым көп
Dialogue: 0,1:23:02.31,1:23:05.56,Default,,0,0,0,,Мен өзімді сол күндегідей сезінемін...уайым қайта оралады.
Dialogue: 0,1:23:06.19,1:23:09.77,Default,,0,0,0,,Мен дәл қазір сондай бақыттымын және бақыттымын
Dialogue: 0,1:23:10.15,1:23:11.15,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:23:11.73,1:23:14.32,Default,,0,0,0,,Мен оны қайтадан жоғалтып аламын ба деп қорқамын...
Dialogue: 0,1:23:15.44,1:23:18.82,Default,,0,0,0,,Мен Момоканың қиналып жатқанын білдім.
Dialogue: 0,1:23:19.57,1:23:21.87,Default,,0,0,0,,Мен де бос болдым.
Dialogue: 0,1:23:22.41,1:23:23.70,Default,,0,0,0,,Осы уақытқа дейін...
Dialogue: 0,1:23:24.87,1:23:28.37,Default,,0,0,0,,Біз бұл дүниеде жалғыз болдық, солай ма?
Dialogue: 0,1:23:29.00,1:23:31.00,Default,,0,0,0,,Бірақ музыка болды.
Dialogue: 0,1:23:31.13,1:23:35.42,Default,,0,0,0,,Қазірдің өзінде Момоканың құмарлығы менің бойымнан өтеді.
Dialogue: 0,1:23:36.17,1:23:39.43,Default,,0,0,0,,Қоңырауын тоқтатпайды.
Dialogue: 0,1:23:39.72,1:23:43.14,Default,,0,0,0,,Бұл мені барлығымен байланыстырды.
Dialogue: 0,1:23:44.10,1:23:48.23,Default,,0,0,0,,Мен бұл сезімге сенемін! Ән сал!
Dialogue: 0,1:23:48.73,1:23:51.52,Default,,0,0,0,,Сондықтан өзіңізге сеніңіз
Dialogue: 0,1:23:51.90,1:23:55.78,Default,,0,0,0,,Мен тікенекті құмырсқалар туралы әңгіме құрастырғым келеді.
Dialogue: 0,1:23:55.90,1:23:58.90,Default,,0,0,0,,Мен сол арманды мәңгілікке көргім келеді
Dialogue: 0,1:23:59.07,1:24:00.07,Default,,0,0,0,,Бұл бес адам
Dialogue: 0,1:24:01.87,1:24:05.16,Default,,0,0,0,,Менің ойымша, жартастың құдайы бар.
Dialogue: 0,1:24:05.29,1:24:06.20,Default,,0,0,0,,Эххе
Dialogue: 0,1:24:10.00,1:24:11.50,Default,,0,0,0,,Өте жақсы
Dialogue: 0,1:24:12.04,1:24:15.71,Default,,0,0,0,,Егер мұндай құдай бар болса, сіз не сұрар едіңіз?
Dialogue: 0,1:24:16.26,1:24:18.97,Default,,0,0,0,,Әрине «1 миллион дана сатылады деп үміттенемін»
Dialogue: 0,1:24:19.38,1:24:21.72,Default,,0,0,0,,Сонда 10 миллион дана ше?
Dialogue: 0,1:24:22.01,1:24:24.22,Default,,0,0,0,,100 миллионнан астам дана!
Dialogue: 0,1:24:24.35,1:24:26.10,Default,,0,0,0,,(5 адам күледі)
Dialogue: 0,1:24:26.22,1:24:27.35,Default,,0,0,0,,Мен...
Dialogue: 0,1:24:27.48,1:24:29.89,Default,,0,0,0,,«Сіз Дайдаспен тікелей эфирде жеңесіз деп үміттенемін»
Dialogue: 0,1:24:30.02,1:24:30.98,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:31.73,1:24:33.56,Default,,0,0,0,,Не? (Нина) Момока-сан...
Dialogue: 0,1:24:33.69,1:24:34.69,Default,,0,0,0,,Не?
Dialogue: 0,1:24:35.19,1:24:36.69,Default,,0,0,0,,[Нинаның құшақтау дыбысы] (Момока) Уф...
Dialogue: 0,1:24:37.61,1:24:39.36,Default,,0,0,0,,...Міне, солай сезіледі.
Dialogue: 0,1:24:39.70,1:24:42.36,Default,,0,0,0,,Сіз қалай ойлайсыз? Сізге қажет нәрсе бар ма?
Dialogue: 0,1:24:43.20,1:24:45.08,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,1:24:45.20,1:24:48.29,Default,,0,0,0,,Иә, мұны түсіну оңай болуы мүмкін.
Dialogue: 0,1:24:48.41,1:24:49.62,Default,,0,0,0,,Маған да ұнайды
Dialogue: 0,1:24:52.54,1:24:56.88,Default,,0,0,0,,Мен әндерді ұнатамын немесе ұнатпаймын деп айтпауға тырысамын...
Dialogue: 0,1:24:57.30,1:24:58.13,Default,,0,0,0,,Иә
Dialogue: 0,1:24:58.42,1:25:02.97,Default,,0,0,0,,Бірақ мақтаусыз, оның қазіргі түрі ұнайды.
Dialogue: 0,1:25:03.09,1:25:05.89,Default,,0,0,0,,Сіз орындағыңыз келетін нәрсе дұрыс енгізілген.
Dialogue: 0,1:25:06.22,1:25:09.23,Default,,0,0,0,,Мен сізді соңғы бірнеше аптада бақылап жүрмін.
Dialogue: 0,1:25:09.35,1:25:11.39,Default,,0,0,0,,Безендірусіз айтуға болады
Dialogue: 0,1:25:12.19,1:25:13.40,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:25:14.27,1:25:17.15,Default,,0,0,0,,Сондықтан оны жасау жақсы сезінеді.
Dialogue: 0,1:25:17.61,1:25:20.11,Default,,0,0,0,,Сіз сияқты топтарға көмектесе алу
Dialogue: 0,1:25:20.24,1:25:22.78,Default,,0,0,0,,Мен бұл жұмысты қабылдағаныма қуаныштымын.
Dialogue: 0,1:25:23.95,1:25:24.78,Default,,0,0,0,,Мен!
Dialogue: 0,1:25:25.57,1:25:27.28,Default,,0,0,0,,Рахмет
Dialogue: 0,1:25:28.33,1:25:30.45,Default,,0,0,0,,Рахмет! Танака-сан!
Dialogue: 0,1:25:30.58,1:25:32.33,Default,,0,0,0,,Бұл Наката (Нина) Ах...
Dialogue: 0,1:25:33.08,1:25:37.42,Default,,0,0,0,,Бақылау күні анықталғаннан кейін біз сізге қайта хабарласамыз.
Dialogue: 0,1:25:37.67,1:25:39.63,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:25:39.92,1:25:41.88,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:25:42.93,1:25:45.18,Default,,0,0,0,,Бағалауға тым ерте
Dialogue: 0,1:25:45.30,1:25:46.97,Default,,0,0,0,,Әлі көп жол бар
Dialogue: 0,1:25:47.10,1:25:47.93,Default,,0,0,0,,Сонымен
Dialogue: 0,1:25:48.35,1:25:52.35,Default,,0,0,0,,[Оятқыш дыбысы]
Dialogue: 0,1:25:53.27,1:25:54.65,Default,,0,0,0,,Хмм...
Dialogue: 0,1:25:55.06,1:25:57.15,Default,,0,0,0,,Уф... суық!
Dialogue: 0,1:25:59.19,1:26:00.82,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,1:26:02.49,1:26:04.07,Default,,0,0,0,,Жартас құдайы
Dialogue: 0,1:26:04.20,1:26:05.82,Default,,0,0,0,,1 миллиард қаралым…
Dialogue: 0,1:26:05.95,1:26:09.12,Default,,0,0,0,,Жоқ, тіпті 10 000 қаралу жақсы болар еді, өтінемін!
Dialogue: 0,1:26:10.04,1:26:12.33,Default,,0,0,0,,Өтінемін...
Dialogue: 0,1:26:12.45,1:26:14.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:26:22.88,1:26:24.38,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,1:26:27.26,1:26:30.10,Default,,0,0,0,,Түсінікті болу үшін мен күткенімнің жартысын да айтқан жоқпын.
Dialogue: 0,1:26:30.39,1:26:31.47,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:26:31.60,1:26:33.48,Default,,0,0,0,,Бейне соншалықты көп қаралғанымен
Dialogue: 0,1:26:33.60,1:26:35.85,Default,,0,0,0,,Тек жазылымдарды көбейту мүмкін емес.
Dialogue: 0,1:26:36.27,1:26:38.69,Default,,0,0,0,,Бұл туралы не ойлайсыз, Миура мырза?
Dialogue: 0,1:26:39.23,1:26:40.65,Default,,0,0,0,,Ең үлкен мәселе
Dialogue: 0,1:26:40.77,1:26:44.49,Default,,0,0,0,,Бұл әсер ету және тану деңгейі бұрынғыдан әлдеқайда жоғары екенін білдіреді.
Dialogue: 0,1:26:44.86,1:26:47.87,Default,,0,0,0,,Іздеу санына және т.б. қарасаңыз да, бұл өте жақсы сан.
Dialogue: 0,1:26:47.99,1:26:51.83,Default,,0,0,0,,Өлеңді осыншама ізденсе, оның біраз қимылы болуы керек.
Dialogue: 0,1:26:52.08,1:26:53.58,Default,,0,0,0,,Бұл ондай нәрсе жоқ дегенді білдіреді.
Dialogue: 0,1:26:53.70,1:26:54.83,Default,,0,0,0,,Бұл кеңсенің жауапкершілігі.
Dialogue: 0,1:26:55.37,1:26:57.79,Default,,0,0,0,,Бұл жарнаманың дұрыс жүрмейтінін білдірсе керек.
Dialogue: 0,1:26:58.13,1:26:59.34,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:27:00.09,1:27:01.96,Default,,0,0,0,,Миура-санды бірінші рет көріп тұрмын...
Dialogue: 0,1:27:02.09,1:27:03.59,Default,,0,0,0,,Бұл, әрине, басқаша болды.
Dialogue: 0,1:27:03.71,1:27:05.34,Default,,0,0,0,,Иә? Момока ше?
Dialogue: 0,1:27:05.47,1:27:07.80,Default,,0,0,0,,«Кешіріңіз, кездескенше»...
Dialogue: 0,1:27:07.93,1:27:11.35,Default,,0,0,0,,Не? Қайтып келдің бе? Осыдан кейін жаттығу керек емес пе?
Dialogue: 0,1:27:11.68,1:27:13.47,Default,,0,0,0,,Жарайды, бүгін тоқталайық.
Dialogue: 0,1:27:13.60,1:27:15.35,Default,,0,0,0,,Дұрыс (Нина) Иә?
Dialogue: 0,1:27:15.68,1:27:17.94,Default,,0,0,0,,Момока-сан, сіз анық байқадыңыз.
Dialogue: 0,1:27:18.06,1:27:19.90,Default,,0,0,0,,Дұрыс (Нина) Не?
Dialogue: 0,1:27:20.02,1:27:22.44,Default,,0,0,0,,Сіз шынымен баяусыз. (Нина) Не?
Dialogue: 0,1:27:22.57,1:27:24.11,Default,,0,0,0,,Сіз мұны бұрын айттыңыз.
Dialogue: 0,1:27:24.23,1:27:26.65,Default,,0,0,0,,Аты жайылып жатса да, әні ел аузында жоқ.
Dialogue: 0,1:27:26.78,1:27:27.99,Default,,0,0,0,,Мен оларға мүлде қызықпаймын—
Dialogue: 0,1:27:28.11,1:27:29.74,Default,,0,0,0,,Әнге қатысты мәселе бар.
Dialogue: 0,1:27:29.87,1:27:30.70,Default,,0,0,0,,Иә!?
Dialogue: 0,1:27:30.82,1:27:31.66,Default,,0,0,0,,Миура мырза
Dialogue: 0,1:27:31.78,1:27:33.83,Default,,0,0,0,,Момока өзі айтқысы келді.
Dialogue: 0,1:27:33.95,1:27:35.66,Default,,0,0,0,,Мен сені бұлай айтуыңды тоқтаттым.
Dialogue: 0,1:27:35.79,1:27:36.62,Default,,0,0,0,,Неліктен!?
Dialogue: 0,1:27:36.75,1:27:38.96,Default,,0,0,0,,Момока-сан жараланады...
Dialogue: 0,1:27:39.08,1:27:41.42,Default,,0,0,0,,Жоқ! Бұл болғалы тұр!
Dialogue: 0,1:27:41.54,1:27:42.75,Default,,0,0,0,,Бұл жақсы ән емес пе?
Dialogue: 0,1:27:42.88,1:27:44.84,Default,,0,0,0,,үшін сені қатты мақтады!
Dialogue: 0,1:27:44.96,1:27:46.51,Default,,0,0,0,,Миура мырза да, Наката мырза да
Dialogue: 0,1:27:46.72,1:27:49.80,Default,,0,0,0,,Егер ол сатылса, онда ешкім қиындыққа тап болмайды.
Dialogue: 0,1:27:49.93,1:27:50.76,Default,,0,0,0,,Бірақ!
Dialogue: 0,1:27:50.89,1:27:54.85,Default,,0,0,0,,«Ван Гог көзі тірісінде бір ғана картинасын сатты».
Dialogue: 0,1:27:54.97,1:27:55.81,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:27:55.93,1:27:58.69,Default,,0,0,0,,Соңында адамдар ақпаратқа еріп кетеді.
Dialogue: 0,1:27:58.81,1:28:01.98,Default,,0,0,0,,үшін жақсы десе, қызықпаса да көремін.
Dialogue: 0,1:28:02.11,1:28:04.78,Default,,0,0,0,,Ешкім қарамайтын нәрсеге мен де қарамаймын.
Dialogue: 0,1:28:04.90,1:28:06.19,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,1:28:06.49,1:28:07.82,Default,,0,0,0,,Жоқ деп айта аласыз ба?
Dialogue: 0,1:28:08.11,1:28:11.87,Default,,0,0,0,,Егер сол ойынның тікелей бейнесі 5000 және 1 миллион қаралымға ие болса
Dialogue: 0,1:28:11.99,1:28:13.62,Default,,0,0,0,,Нина Қайсысын ашу керек?
Dialogue: 0,1:28:14.28,1:28:19.62,Default,,0,0,0,,♪ [Жарнама жолынан ойнатылатын музыка]
Dialogue: 0,1:28:19.75,1:28:22.21,Default,,0,0,0,,♪Бұл дүние айқайламайды
Dialogue: 0,1:28:22.33,1:28:24.84,Default,,0,0,0,,♪ Құрғақ тер
Dialogue: 0,1:28:24.96,1:28:29.68,Default,,0,0,0,,♪Үнемі өзгеретін нәрселерге бір ғана тілек
Dialogue: 0,1:28:27.55,1:28:29.68,Default,,0,0,0,,Тоқта, бұл жиіркенішті!
Dialogue: 0,1:28:29.80,1:28:31.59,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,1:28:32.39,1:28:34.97,Default,,0,0,0,,«Тіпті жеңе алмаса да күрескен топ»
Dialogue: 0,1:28:35.14,1:28:38.31,Default,,0,0,0,,«Мен бұл жігіттердің каммингінің сезімін жек көремін»
Dialogue: 0,1:28:38.43,1:28:40.89,Default,,0,0,0,,«Жеңілгендер тез жоғалады»
Dialogue: 0,1:28:41.31,1:28:43.48,Default,,0,0,0,,Әлемде ғана!
Dialogue: 0,1:28:44.61,1:28:47.07,Default,,0,0,0,,Ақымақ болма! Мен оны шынымен тыңдамасам да!
Dialogue: 0,1:28:47.19,1:28:49.65,Default,,0,0,0,,Мен сендерден жеңіліп жатқан сияқты емеспін!
Dialogue: 0,1:28:49.78,1:28:51.99,Default,,0,0,0,,Ештеңе етпейді, балалар!
Dialogue: 0,1:28:53.66,1:28:56.70,Default,,0,0,0,,Тыныштық, тыныштық, тыныштық, тыныштық
Dialogue: 0,1:28:56.83,1:28:58.12,Default,,0,0,0,,Я...
Dialogue: 0,1:29:00.71,1:29:02.79,Default,,0,0,0,,Иә? Өтінімді орындаңыз...
Dialogue: 0,1:29:03.21,1:29:04.33,Default,,0,0,0,,Балапандар?
Dialogue: 0,1:29:04.96,1:29:07.80,Default,,0,0,0,,Иә!? Ресми белгі де бар...
Dialogue: 0,1:29:14.68,1:29:15.68,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,1:29:16.85,1:29:18.52,Default,,0,0,0,,Иә! (Нина) А...
Dialogue: 0,1:29:21.23,1:29:23.19,Default,,0,0,0,,Идиоттар көреді~♪
Dialogue: 0,1:29:25.86,1:29:26.98,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,1:29:27.98,1:29:29.99,Default,,0,0,0,,Жарайды ма? Бетперделеудің қажеті жоқ
Dialogue: 0,1:29:30.11,1:29:32.49,Default,,0,0,0,,Мен соншалықты танымал емеспін...
Dialogue: 0,1:29:32.78,1:29:34.28,Default,,0,0,0,,Сіз мені әлі де жақсы көресіз бе?
Dialogue: 0,1:29:34.41,1:29:37.62,Default,,0,0,0,,Иә, мектептен қайтып келе жатқанда бірге тамақтанатынбыз.
Dialogue: 0,1:29:37.95,1:29:38.87,Default,,0,0,0,,Мен ақшаны төлеймін...
Dialogue: 0,1:29:39.16,1:29:40.87,Default,,0,0,0,,Жарайсың, құрметті.
Dialogue: 0,1:29:42.41,1:29:43.25,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,1:29:43.37,1:29:44.46,Default,,0,0,0,,Ештеңе...
Dialogue: 0,1:29:44.58,1:29:47.00,Default,,0,0,0,,Мен жай ғана сіз дұрыс түсінбедіңіз деп ойладым.
Dialogue: 0,1:29:47.13,1:29:48.00,Default,,0,0,0,,Қый!
Dialogue: 0,1:29:48.13,1:29:48.96,Default,,0,0,0,,Осымен
Dialogue: 0,1:29:49.09,1:29:52.13,Default,,0,0,0,,Мен Дедтің вокалына әдейі сай емес сияқтымын.
Dialogue: 0,1:29:52.30,1:29:54.64,Default,,0,0,0,,Сіз тыңдаудан өткеніңізді айттыңыз.
Dialogue: 0,1:29:55.01,1:29:57.85,Default,,0,0,0,,А... Түсініп тұрмын, бұл екеуміз ажырасып кеткеннен кейін.
Dialogue: 0,1:29:57.97,1:30:00.14,Default,,0,0,0,,Нина мектепке келуді тоқтатты.
Dialogue: 0,1:30:00.27,1:30:02.23,Default,,0,0,0,,Не? Мақтануға келдің бе?
Dialogue: 0,1:30:02.35,1:30:05.35,Default,,0,0,0,,Бұл менің айтқанымды орындамағаныңыз үшін болды.
Dialogue: 0,1:30:05.48,1:30:08.77,Default,,0,0,0,,Егер сен мені тыңдасаң, бұлай болмас еді.
Dialogue: 0,1:30:08.90,1:30:12.15,Default,,0,0,0,,Мен «дұрыс» деп айтқым келеді, бірақ жартысы дұрыс емес.
Dialogue: 0,1:30:13.45,1:30:15.91,Default,,0,0,0,,Билеттер сатылмайды, солай ма? (Нина) Бұл маңызды емес, солай ма?
Dialogue: 0,1:30:16.03,1:30:18.53,Default,,0,0,0,,Менің ойымша, бұл байланысты емес пе?
Dialogue: 0,1:30:18.66,1:30:20.16,Default,,0,0,0,,Біз бірге жанды дауыста өнер көрсетеміз.
Dialogue: 0,1:30:20.29,1:30:21.16,Default,,0,0,0,,Бірге емес!
Dialogue: 0,1:30:24.16,1:30:27.63,Default,,0,0,0,,Нинаның кеңсесінен Миура мырза менің үйіме кеңес алу үшін келді.
Dialogue: 0,1:30:27.75,1:30:29.21,Default,,0,0,0,,«Біз бірдеңе істей алмаймыз ба?»
Dialogue: 0,1:30:29.34,1:30:30.30,Default,,0,0,0,,Миура мырза?
Dialogue: 0,1:30:30.42,1:30:33.01,Default,,0,0,0,,Егер біз екі күні де кететін болсақ.
Dialogue: 0,1:30:33.13,1:30:34.51,Default,,0,0,0,,Билеттер де болатын шығар.
Dialogue: 0,1:30:34.63,1:30:36.59,Default,,0,0,0,,«Мен сенің екі күнде де фургондарға қарсы ойнағаныңды қалаймын.»
Dialogue: 0,1:30:37.01,1:30:40.72,Default,,0,0,0,,Шынымды айтсам, сіз өзіңіздің жанды орындау мүмкіндігіңіздің 30%-ын да сатқан жоқсыз.
Dialogue: 0,1:30:41.01,1:30:42.31,Default,,0,0,0,,Менің кестем тегін.
Dialogue: 0,1:30:42.43,1:30:46.02,Default,,0,0,0,,Қалғаны біздің шешімімізде.
Dialogue: 0,1:30:46.35,1:30:49.48,Default,,0,0,0,,Сондықтан мен Нина мен басқалардың ойын тыңдаймын деп ойладым.
Dialogue: 0,1:30:50.19,1:30:51.02,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:30:51.65,1:30:52.53,Default,,0,0,0,,Заттарыңды үйге әкетуді ұмытып қалғансың ғой…
Dialogue: 0,1:30:52.65,1:30:55.70,Default,,0,0,0,,«Арнайы» қажетсіз ештеңе жасамауды білдіреді ме?
Dialogue: 0,1:30:55.82,1:30:58.16,Default,,0,0,0,,Әлде алғыс айтамын ба?
Dialogue: 0,1:30:58.28,1:31:01.91,Default,,0,0,0,,♪ [Залдағы BGM: «Қайғы циклі»]
Dialogue: 0,1:31:02.04,1:31:05.04,Default,,0,0,0,,Сіз мені естисіз бе? Бұл «сататын»
Dialogue: 0,1:31:05.16,1:31:07.71,Default,,0,0,0,,Маңызды нәрселер Маңызды нәрселер...
Dialogue: 0,1:31:07.92,1:31:10.46,Default,,0,0,0,,Жүр, неге мойындамайсың?
Dialogue: 0,1:31:10.63,1:31:12.42,Default,,0,0,0,,«Мен қателестім»
Dialogue: 0,1:31:12.55,1:31:14.88,Default,,0,0,0,,«Хинаның айтқаны дұрыс болды».
Dialogue: 0,1:31:15.01,1:31:17.09,Default,,0,0,0,,«Мен сенің айтқаныңды тыңдауым керек еді».
Dialogue: 0,1:31:19.76,1:31:21.56,Default,,0,0,0,,Сіз шынымен көмектесуді жоспарлап отырсыз ба?
Dialogue: 0,1:31:21.93,1:31:22.93,Default,,0,0,0,,Не?
Dialogue: 0,1:31:23.06,1:31:24.56,Default,,0,0,0,,Бұл күлкілі емес пе?
Dialogue: 0,1:31:24.68,1:31:26.77,Default,,0,0,0,,Анко үндемейді
Dialogue: 0,1:31:26.89,1:31:27.98,Default,,0,0,0,,Неліктен Аянкото...
Dialogue: 0,1:31:28.19,1:31:30.61,Default,,0,0,0,,Бұл қорлаудың себебі.
Dialogue: 0,1:31:30.73,1:31:32.98,Default,,0,0,0,,Сіздің көңіл-күйіңіз нашар болды ма, әлде біреу сізге қарады ма?
Dialogue: 0,1:31:34.19,1:31:36.74,Default,,0,0,0,,Бэттен Анко мұны көрді.
Dialogue: 0,1:31:36.86,1:31:38.11,Default,,0,0,0,,«Маған көмектескеніңді қалаймын»...
Dialogue: 0,1:31:38.24,1:31:41.41,Default,,0,0,0,,Ол кезде мен жалғыз едім.
Dialogue: 0,1:31:41.74,1:31:44.54,Default,,0,0,0,,Барсам, Нинаның жағында боламын.
Dialogue: 0,1:31:45.29,1:31:48.79,Default,,0,0,0,,Мен оларды тоқтатсам, Нина байқайды.
Dialogue: 0,1:31:49.04,1:31:51.00,Default,,0,0,0,,Сонда Анко не істейді?
Dialogue: 0,1:31:51.13,1:31:52.04,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:31:52.17,1:31:55.26,Default,,0,0,0,,Сіз мұны жеңе аласыз ба? Сіз мектепке келесіз бе?
Dialogue: 0,1:31:55.38,1:31:57.55,Default,,0,0,0,,Мұғалім байқап, тоқтай ма...
Dialogue: 0,1:31:57.80,1:31:59.55,Default,,0,0,0,,Оған дейін жай қалдырыңыз ба?
Dialogue: 0,1:31:59.68,1:32:01.76,Default,,0,0,0,,Сіз неге...
Dialogue: 0,1:32:01.89,1:32:03.31,Default,,0,0,0,,Нағыз қулық - бұл көңілсіз.
Dialogue: 0,1:32:03.43,1:32:05.14,Default,,0,0,0,,Уайымдама, мұндай нәрсе ренжітеді...
Dialogue: 0,1:32:05.35,1:32:07.27,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,1:32:07.39,1:32:09.02,Default,,0,0,0,,Хинаның айтқанын түсіндім.
Dialogue: 0,1:32:09.65,1:32:11.77,Default,,0,0,0,,Баттен, сен жындысың ба?
Dialogue: 0,1:32:12.11,1:32:15.28,Default,,0,0,0,,Бір қызығы, қателесу дұрысырақ.
Dialogue: 0,1:32:17.49,1:32:19.32,Default,,0,0,0,,Мен үндемеймін!
Dialogue: 0,1:32:24.58,1:32:28.16,Default,,0,0,0,,«Мен бәрін әшкерелеп, өмір сүремін» солай ма?
Dialogue: 0,1:32:29.04,1:32:30.75,Default,,0,0,0,,«Мен қателестім» десеңіз
Dialogue: 0,1:32:30.87,1:32:32.50,Default,,0,0,0,,Мен саған қолымнан келгенше көмектесемін
Dialogue: 0,1:32:33.09,1:32:34.25,Default,,0,0,0,,Уф
Dialogue: 0,1:32:34.75,1:32:35.92,Default,,0,0,0,,Үйге қайт!
Dialogue: 0,1:32:37.51,1:32:38.84,Default,,0,0,0,,[Монеталарды қою дыбысы] (Нина) Ақша!
Dialogue: 0,1:32:40.01,1:32:41.55,Default,,0,0,0,,Ас үшін рахмет!
Dialogue: 0,1:32:44.55,1:32:46.22,Default,,0,0,0,,[Смартфонның діріл дыбысы]
Dialogue: 0,1:32:46.35,1:32:47.18,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,1:32:47.56,1:32:48.93,Default,,0,0,0,,Сізге қоңырау шалғаным үшін кешіріңіз.
Dialogue: 0,1:32:49.85,1:32:52.48,Default,,0,0,0,,Мүлде жоқ Басқа не?
Dialogue: 0,1:32:52.60,1:32:55.61,Default,,0,0,0,,Жоқ... Мен барлығына бір рет айттым.
Dialogue: 0,1:32:55.73,1:32:58.69,Default,,0,0,0,,Дедус: «Екі күнде де саған қарсы ойнай аламыз ба?» деп сұрады.
Dialogue: 0,1:32:58.82,1:33:00.45,Default,,0,0,0,,Сізге хабарласқан сияқты.
Dialogue: 0,1:33:00.57,1:33:03.12,Default,,0,0,0,,«Мен бір аудитория алдында қалыпты түрде жарысқым келеді».
Dialogue: 0,1:33:03.91,1:33:07.12,Default,,0,0,0,,Сонымен, сізге Миура мырза қоңырау шалды, солай ма?
Dialogue: 0,1:33:07.24,1:33:09.87,Default,,0,0,0,,Иә, бірақ не болды? (Нина) Жоқ...
Dialogue: 0,1:33:10.00,1:33:11.25,Default,,0,0,0,,Қалай ойлайсың, Нина?
Dialogue: 0,1:33:11.96,1:33:13.50,Default,,0,0,0,,үшін ше?
Dialogue: 0,1:33:13.71,1:33:14.67,Default,,0,0,0,,Ал...
Dialogue: 0,1:33:14.79,1:33:16.92,Default,,0,0,0,,Біріншіден, бұл жарыс емес еді
Dialogue: 0,1:33:17.05,1:33:19.63,Default,,0,0,0,,Аздап есі дұрыс болғаны дұрыс емес пе?
Dialogue: 0,1:33:20.01,1:33:24.14,Default,,0,0,0,,Бірақ қазірден бастап, нәтижеге қарамастан, клиент бөлмеге кіреді.
Dialogue: 0,1:33:24.51,1:33:26.89,Default,,0,0,0,,Мұның бәрі Дайдастың арқасында, солай ма?
Dialogue: 0,1:33:27.31,1:33:29.18,Default,,0,0,0,,Бұл біз қазірдің өзінде бар екенін білдіреді
Dialogue: 0,1:33:29.31,1:33:31.14,Default,,0,0,0,,Бұл жеңілгенді мойындау сияқты, солай емес пе?
Dialogue: 0,1:33:31.64,1:33:33.65,Default,,0,0,0,,Сен қарсысың ба, Нина-сан?
Dialogue: 0,1:33:33.81,1:33:35.02,Default,,0,0,0,,Иә, бұл маған ұнамайды
Dialogue: 0,1:33:35.52,1:33:36.52,Default,,0,0,0,,Бұл басталды
Dialogue: 0,1:33:36.65,1:33:38.57,Default,,0,0,0,,Мен Нинаның сезімін түсінемін.
Dialogue: 0,1:33:39.48,1:33:41.70,Default,,0,0,0,,Маған ұнамайды, маған мүлдем ұнамайды!
Dialogue: 0,1:33:41.82,1:33:44.41,Default,,0,0,0,,Осы уақытқа дейін қалай келді деп ойлайсың?
Dialogue: 0,1:33:44.53,1:33:47.95,Default,,0,0,0,,«Момока-сан қателеспейді» «Момока-санның әндері жарамды»
Dialogue: 0,1:33:48.37,1:33:50.37,Default,,0,0,0,,Сіз мұны дәлелдейсіз бе?
Dialogue: 0,1:33:50.50,1:33:52.79,Default,,0,0,0,,Мен осы уақытқа дейін жеттім, өйткені мен бұған сенемін!
Dialogue: 0,1:33:52.91,1:33:55.92,Default,,0,0,0,,Бірақ шындық бұған жол бермейді.
Dialogue: 0,1:33:56.21,1:33:59.42,Default,,0,0,0,,Ағымдағы тікелей билеттер сатылымы 30%-дан аз.
Dialogue: 0,1:33:59.84,1:34:01.42,Default,,0,0,0,,Бұл менің инди болған кездегіден төмен.
Dialogue: 0,1:34:01.80,1:34:03.43,Default,,0,0,0,,Сонымен не айтып тұрсың?
Dialogue: 0,1:34:03.55,1:34:05.34,Default,,0,0,0,,Жауапкершілікті өз мойнына аламын дейсіз бе?
Dialogue: 0,1:34:05.80,1:34:07.64,Default,,0,0,0,,Бұл қанша ақша деп ойлайсыз?
Dialogue: 0,1:34:08.31,1:34:09.14,Default,,0,0,0,,Ақша…
Dialogue: 0,1:34:09.43,1:34:11.18,Default,,0,0,0,,Тек өткізу орнының ақысы емес
Dialogue: 0,1:34:11.31,1:34:13.81,Default,,0,0,0,,Біз тіпті сатуды күтумен тауар жасаймыз.
Dialogue: 0,1:34:13.94,1:34:15.77,Default,,0,0,0,,Жарнама да тегін емес.
Dialogue: 0,1:34:15.94,1:34:19.02,Default,,0,0,0,,Зиянды барынша азайтуды ойлаудан басқа амалымыз жоқ.
Dialogue: 0,1:34:19.15,1:34:20.98,Default,,0,0,0,,Мұның бәрі мен.
Dialogue: 0,1:34:21.11,1:34:21.94,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:34:22.24,1:34:23.70,Default,,0,0,0,,Аа... (Субару/Сатоши) А...
Dialogue: 0,1:34:25.99,1:34:28.70,Default,,0,0,0,,Бұл Дайдасқа да бас иетініңді білдіре ме?
Dialogue: 0,1:34:29.79,1:34:32.25,Default,,0,0,0,,Мен оны Дэдусқа түсіріп жатқан сияқты емеспін.
Dialogue: 0,1:34:32.37,1:34:35.29,Default,,0,0,0,,Иә! Сіз олардың ұсынысын қабылдаймын дейсіз бе?
Dialogue: 0,1:34:35.42,1:34:36.38,Default,,0,0,0,,Оны түсіріңіз!
Dialogue: 0,1:34:36.83,1:34:39.75,Default,,0,0,0,,Сіз шынымен Дайдас осындай ұсыныс жасайды деп ойлайсыз ба?
Dialogue: 0,1:34:39.88,1:34:40.75,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:34:41.00,1:34:42.76,Default,,0,0,0,,Бұл қазірдің өзінде шешілген жоқ па?
Dialogue: 0,1:34:42.88,1:34:45.34,Default,,0,0,0,,Миура мырза басын иіп сұрады.
Dialogue: 0,1:34:46.47,1:34:50.10,Default,,0,0,0,,«Менімен мұны істей аласың ба?» «Өтінемін маған көмектесіңіз.»
Dialogue: 0,1:34:50.22,1:34:51.06,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:34:51.18,1:34:53.10,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,1:34:53.23,1:34:57.27,Default,,0,0,0,,Мен саған айту үшін келдім, Хина маған: «Мен қателескенімді айт» деді.
Dialogue: 0,1:34:57.40,1:34:59.98,Default,,0,0,0,,«Олай болса мен саған қолымнан келгенше көмектесемін».
Dialogue: 0,1:35:00.57,1:35:03.28,Default,,0,0,0,,Оны айтқым келмейді.
Dialogue: 0,1:35:03.40,1:35:04.99,Default,,0,0,0,,Өйткені мен...
Dialogue: 0,1:35:05.49,1:35:07.28,Default,,0,0,0,,Өйткені бұл қате емес!
Dialogue: 0,1:35:09.62,1:35:10.62,Default,,0,0,0,,Нина…
Dialogue: 0,1:35:12.37,1:35:14.45,Default,,0,0,0,,Сондықтан басыңызды төмен түсірмеңіз!
Dialogue: 0,1:35:14.58,1:35:19.04,Default,,0,0,0,,[Гитараның шырылдаған дыбысы]
Dialogue: 0,1:35:21.17,1:35:23.59,Default,,0,0,0,,[Құмарлы орындау]
Dialogue: 0,1:35:23.71,1:35:27.18,Default,,0,0,0,,Менің ол кезде кім болғанымды жоққа шығармаңыз!
Dialogue: 0,1:35:28.47,1:35:30.80,Default,,0,0,0,,«Ақша» «Жауапкершілік» «Танымал»
Dialogue: 0,1:35:30.93,1:35:32.68,Default,,0,0,0,,Мен мұны білемін!
Dialogue: 0,1:35:33.01,1:35:36.06,Default,,0,0,0,,Жиренішті! Бұл жиіркенішті! Бұл жиіркенішті! Бұл жиіркенішті!
Dialogue: 0,1:35:36.48,1:35:38.06,Default,,0,0,0,,Тек әлемде!
Dialogue: 0,1:35:38.19,1:35:39.02,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:39.23,1:35:40.15,Default,,0,0,0,,[Тұт! ]
Dialogue: 0,1:35:40.81,1:35:41.77,Default,,0,0,0,,Нина! Нина-сан!
Dialogue: 0,1:35:41.90,1:35:42.94,Default,,0,0,0,,Жақсысың ба!?
Dialogue: 0,1:35:43.61,1:35:47.07,Default,,0,0,0,,Мен қаншалықты кішкентаймын...
Dialogue: 0,1:35:47.45,1:35:53.91,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,1:35:54.58,1:35:55.75,Default,,0,0,0,,[Қоңырау дыбысы]
Dialogue: 0,1:35:56.04,1:35:57.50,Default,,0,0,0,,Олар жасады ма?
Dialogue: 0,1:35:58.37,1:36:01.79,Default,,0,0,0,,«Менің одақтастарым болмайды» деп айтуым керек еді.
Dialogue: 0,1:36:02.21,1:36:04.80,Default,,0,0,0,,Менің істегенімді сонша жек көрдіңіз бе?
Dialogue: 0,1:36:05.26,1:36:09.22,Default,,0,0,0,,Анса: Мен мұны Нинамен сөйлескенде сезіндім.
Dialogue: 0,1:36:09.34,1:36:10.76,Default,,0,0,0,,Әділдіктің тікенегін шығар
Dialogue: 0,1:36:10.89,1:36:12.51,Default,,0,0,0,,Нәзік таңбалау
Dialogue: 0,1:36:12.64,1:36:14.60,Default,,0,0,0,,үшінн ренжіту...
Dialogue: 0,1:36:14.97,1:36:18.10,Default,,0,0,0,,Мен өзімді жаман адам сияқты сезінемін.
Dialogue: 0,1:36:18.94,1:36:21.69,Default,,0,0,0,,Бұл шынымен махаббаттың соңы ма? (Нина) Иә.
Dialogue: 0,1:36:21.94,1:36:25.03,Default,,0,0,0,,Бұл Нинаға өте ұқсас эпизод.
Dialogue: 0,1:36:25.19,1:36:28.28,Default,,0,0,0,,Сонымен қорлаған балаға не болды?
Dialogue: 0,1:36:28.82,1:36:30.53,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,1:36:30.66,1:36:34.58,Default,,0,0,0,,Біраз уақыттан кейін әлгі балалар екеуміз мені қорлай бастадық.
Dialogue: 0,1:36:34.74,1:36:36.70,Default,,0,0,0,,Сосын жасырын сөйлесеміз.
Dialogue: 0,1:36:36.83,1:36:38.66,Default,,0,0,0,,«Сіз бұл балалардан кешірім сұрауыңыз керек».
Dialogue: 0,1:36:38.83,1:36:40.83,Default,,0,0,0,,«Мені кешіретініңізге сенімдімін».
Dialogue: 0,1:36:40.96,1:36:43.79,Default,,0,0,0,,«Онда мен де мұны істеудің қажеті жоқ.»
Dialogue: 0,1:36:43.92,1:36:45.09,Default,,0,0,0,,Бұл не? ол
Dialogue: 0,1:36:45.21,1:36:47.26,Default,,0,0,0,,Бірақ мен қалтырап кеттім.
Dialogue: 0,1:36:47.38,1:36:49.09,Default,,0,0,0,,Мен сол балалардан шошып кеттім.
Dialogue: 0,1:36:49.22,1:36:52.72,Default,,0,0,0,,Бірақ сіз құтқарылдыңыз, солай ма? Сіз менің жанашырымсыз, солай ма?
Dialogue: 0,1:36:52.84,1:36:55.10,Default,,0,0,0,,Сондықтан мектепке бара алмайсың...
Dialogue: 0,1:36:55.51,1:36:56.35,Default,,0,0,0,,Иә...
Dialogue: 0,1:36:56.68,1:36:58.85,Default,,0,0,0,,«Себебі бұл дұрыс емес»…
Dialogue: 0,1:36:58.98,1:37:02.15,Default,,0,0,0,,Сіз қателесесіз! Қалай ойласаңыз да, қателесесіз.
Dialogue: 0,1:37:02.27,1:37:03.23,Default,,0,0,0,,Сатоши-чан...
Dialogue: 0,1:37:03.36,1:37:04.36,Default,,0,0,0,,Өйткені бұл дұрыс!
Dialogue: 0,1:37:04.48,1:37:07.98,Default,,0,0,0,,Қалай ойласаң да, Хина деген қыздың айтқаны дұрыс!
Dialogue: 0,1:37:08.11,1:37:09.19,Default,,0,0,0,,Бірақ!
Dialogue: 0,1:37:09.36,1:37:10.36,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:37:11.57,1:37:14.12,Default,,0,0,0,,Менің ойымша, бұл мені қызықтырды.
Dialogue: 0,1:37:14.32,1:37:18.95,Default,,0,0,0,,Маған сенің ән айтатын дауысың ұнайды. Мүмкін Лупа, Момока және Субару...
Dialogue: 0,1:37:19.08,1:37:20.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:20.50,1:37:21.79,Default,,0,0,0,,Сатоши-чан...
Dialogue: 0,1:37:22.00,1:37:23.12,Default,,0,0,0,,[Нинаның құшақтау дыбысы] (Чи) Уау! Тоқта...
Dialogue: 0,1:37:23.25,1:37:24.33,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:37:24.63,1:37:26.88,Default,,0,0,0,,Маған бұл ұнамайды!
Dialogue: 0,1:37:27.00,1:37:27.84,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:27.96,1:37:29.46,Default,,0,0,0,,Қорытындыға қол жеткізілді.
Dialogue: 0,1:37:29.59,1:37:32.68,Default,,0,0,0,,Бірақ Миура-сан мен оның достары бұл жерге жету үшін көп еңбек етті.
Dialogue: 0,1:37:32.80,1:37:34.84,Default,,0,0,0,,Жауапкершілікті өз мойнына алу керек
Dialogue: 0,1:37:35.39,1:37:36.60,Default,,0,0,0,,Шынымен...
Dialogue: 0,1:37:36.72,1:37:39.52,Default,,0,0,0,,Бірақ, мен оны қалай да елестетіп тұрғандай сезінемін.
Dialogue: 0,1:37:39.64,1:37:41.48,Default,,0,0,0,,Әу бастан осылай болды.
Dialogue: 0,1:37:41.85,1:37:44.69,Default,,0,0,0,,Мынау. Иә, бұл Нина!
Dialogue: 0,1:37:44.81,1:37:45.69,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,1:37:45.81,1:37:47.86,Default,,0,0,0,,(5 адам күледі)
Dialogue: 0,1:37:48.53,1:37:49.36,Default,,0,0,0,,Бас тарту?
Dialogue: 0,1:37:49.48,1:37:51.11,Default,,0,0,0,,Біз оларды қашып құтылуға ешқашан жол бермейміз
Dialogue: 0,1:37:51.40,1:37:53.61,Default,,0,0,0,,Ол: «Мен Ванға қарсы ойнағым келеді» деді.
Dialogue: 0,1:37:53.74,1:37:54.86,Default,,0,0,0,,«Мен дұрыс жарысқым келеді»...
Dialogue: 0,1:37:55.16,1:37:57.70,Default,,0,0,0,,Мен білемін, бірақ қазірден бастап...
Dialogue: 0,1:37:57.83,1:38:00.50,Default,,0,0,0,,Біз құтқарылған сияқтымыз.
Dialogue: 0,1:38:00.75,1:38:04.17,Default,,0,0,0,,Солай болса да, кем дегенде тұтынушыға...
Dialogue: 0,1:38:05.50,1:38:07.50,Default,,0,0,0,,Бәріміз солай шештік.
Dialogue: 0,1:38:07.75,1:38:11.26,Default,,0,0,0,,Әрине, бұл қаншалықты өзімшілдік таңдау?
Dialogue: 0,1:38:11.38,1:38:14.63,Default,,0,0,0,,Бұл кеңсеге айтарлықтай зиян келтіретінін де білеміз.
Dialogue: 0,1:38:14.76,1:38:17.14,Default,,0,0,0,,Осы іс-шараға кететін шығындарды айтыңызшы.
Dialogue: 0,1:38:17.39,1:38:21.18,Default,,0,0,0,,Қашан келетініне уәде бере алмаймын, бірақ міндетті түрде қайтарып аламын.
Dialogue: 0,1:38:21.31,1:38:22.14,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:38:22.89,1:38:24.31,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:38:26.19,1:38:27.90,Default,,0,0,0,,Басыңызды көтеріңіз
Dialogue: 0,1:38:28.61,1:38:29.90,Default,,0,0,0,,Себебін айтыңызшы
Dialogue: 0,1:38:31.61,1:38:35.66,Default,,0,0,0,,Мен Дедус Хинадан тікелей хабарлама алдым...
Dialogue: 0,1:38:36.07,1:38:38.03,Default,,0,0,0,,Миура-сан қуанып қалды.
Dialogue: 0,1:38:38.37,1:38:40.79,Default,,0,0,0,,Мен мұны істей алмаймын десем де, біз жанды дауыста өнер көрсеттік.
Dialogue: 0,1:38:40.91,1:38:42.70,Default,,0,0,0,,Сенің соншалықты алыс кеткеніңе сене алар емеспін...
Dialogue: 0,1:38:42.83,1:38:46.42,Default,,0,0,0,,Бірақ мен әлі де бас тартуды өрескел деп санаймын.
Dialogue: 0,1:38:46.88,1:38:47.71,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:38:47.83,1:38:50.17,Default,,0,0,0,,Кешіріңіз, мен өзімшілмін.
Dialogue: 0,1:38:51.59,1:38:53.92,Default,,0,0,0,,Шынымды айтсам, мен білдім.
Dialogue: 0,1:38:54.05,1:38:56.38,Default,,0,0,0,,Сезіміңізге не қарсы болады...
Dialogue: 0,1:38:56.72,1:38:57.84,Default,,0,0,0,,Миура мырза...
Dialogue: 0,1:38:57.97,1:38:59.39,Default,,0,0,0,,Миура да жақсы емес.
Dialogue: 0,1:38:59.89,1:39:01.47,Default,,0,0,0,,Қазір күлетін уақыт па?
Dialogue: 0,1:39:01.60,1:39:04.89,Default,,0,0,0,,Ақша мен келісім-шарттарды агенттік пен Миура шешеді.
Dialogue: 0,1:39:05.85,1:39:09.15,Default,,0,0,0,,Миура сендермен жұмыс істегісі келді, өйткені сендер сондайсыңдар.
Dialogue: 0,1:39:09.61,1:39:12.03,Default,,0,0,0,,Соңында маған көмектесіңізші.
Dialogue: 0,1:39:12.69,1:39:13.53,Default,,0,0,0,,Тоқтау керек пе?
Dialogue: 0,1:39:13.86,1:39:14.69,Default,,0,0,0,,Иә
Dialogue: 0,1:39:14.82,1:39:16.07,Default,,0,0,0,,Не? Трансфер?
Dialogue: 0,1:39:16.20,1:39:18.62,Default,,0,0,0,,Жоқ, мен мұны тегін жасаймын деп ойлаймын.
Dialogue: 0,1:39:18.82,1:39:20.37,Default,,0,0,0,,Сіздің шағымыңыз болды ма?
Dialogue: 0,1:39:20.62,1:39:21.45,Default,,0,0,0,,Маған біртіндеп орал
Dialogue: 0,1:39:21.58,1:39:24.62,Default,,0,0,0,,Өзіміз ғана шештік, болды.
Dialogue: 0,1:39:25.46,1:39:26.62,Default,,0,0,0,,Хмм.
Dialogue: 0,1:39:26.75,1:39:29.63,Default,,0,0,0,,10 жылдан кейін әлі тірі болсаңыз, қайта келіңіз.
Dialogue: 0,1:39:29.75,1:39:31.13,Default,,0,0,0,,Мен сізге тегін жұмыс істеймін
Dialogue: 0,1:39:32.80,1:39:36.01,Default,,0,0,0,,Иә! Рахмет, Наката-сан!
Dialogue: 0,1:39:36.76,1:39:38.26,Default,,0,0,0,,Сиыр етінен жасалған ыдыс жегіңіз келе ме?
Dialogue: 0,1:39:38.51,1:39:40.01,Default,,0,0,0,,Сіз бәрібір ішкіңіз келеді.
Dialogue: 0,1:39:40.14,1:39:42.89,Default,,0,0,0,,Бұл дұрыс емес (Даналық) Лупа нанымды емес!
Dialogue: 0,1:39:43.56,1:39:47.14,Default,,0,0,0,,Ойланып қарасақ, екеуміз де алғаш рет осы жерде кездестік.
Dialogue: 0,1:39:47.44,1:39:48.52,Default,,0,0,0,,Иә.
Dialogue: 0,1:39:49.10,1:39:50.81,Default,,0,0,0,,Қызыл имбирь...
Dialogue: 0,1:39:51.48,1:39:53.53,Default,,0,0,0,,Сіз «ант» алғыңыз келе ме? Бени имбирімен
Dialogue: 0,1:39:54.07,1:39:56.57,Default,,0,0,0,,Бұл Томо-чан және басқалар үшін де маңызды есім.
Dialogue: 0,1:39:56.70,1:39:58.28,Default,,0,0,0,,Маңызды өмірлік ант...
Dialogue: 0,1:39:58.66,1:39:59.78,Default,,0,0,0,,Сіз немен ант етесіз?
Dialogue: 0,1:40:00.49,1:40:04.04,Default,,0,0,0,,Бұл бес адам мұны жалғастырады. Біз ешқашан тоқтамаймыз.
Dialogue: 0,1:40:05.16,1:40:07.00,Default,,0,0,0,,Сонда тамақтан басқа амалың жоқ.
Dialogue: 0,1:40:07.12,1:40:09.42,Default,,0,0,0,,Бұл жақсы (Сатоши) Бір ғана сусын.
Dialogue: 0,1:40:10.33,1:40:12.00,Default,,0,0,0,,Момока-сан (Момока) Иә?
Dialogue: 0,1:40:12.67,1:40:14.80,Default,,0,0,0,,Маған бұл қала ұнайды
Dialogue: 0,1:40:15.55,1:40:19.30,Default,,0,0,0,,Мені күлдіріп, жылатып жіберген достарымды кездестірген бұл қала...
Dialogue: 0,1:40:19.43,1:40:20.47,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:40:21.68,1:40:22.72,Default,,0,0,0,,Кавасаки
Dialogue: 0,1:40:23.64,1:40:24.47,Default,,0,0,0,,Иә!
Dialogue: 0,1:40:24.60,1:40:26.98,Default,,0,0,0,,(аудитория сөзі)
Dialogue: 0,1:40:31.35,1:40:32.77,Default,,0,0,0,,Бұл шығын деп аталады.
Dialogue: 0,1:40:32.90,1:40:35.73,Default,,0,0,0,,«Жапония сериясындағы қатарынан 4 жеңіліс~» сияқты нәрсе
Dialogue: 0,1:40:35.90,1:40:37.94,Default,,0,0,0,,Ешқандай керемет болмайды...
Dialogue: 0,1:40:38.36,1:40:41.03,Default,,0,0,0,,Дұрыс, бұл мелодрама емес.
Dialogue: 0,1:40:41.16,1:40:41.99,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:43.53,1:40:44.74,Default,,0,0,0,,Түсінікті! Рахмет!
Dialogue: 0,1:40:46.91,1:40:48.16,Default,,0,0,0,,Хидари?
Dialogue: 0,1:40:50.17,1:40:52.42,Default,,0,0,0,,Уф, анау жігіт...
Dialogue: 0,1:40:52.54,1:40:53.42,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,1:40:53.54,1:40:54.88,Default,,0,0,0,,Күтпеген жерден Хина бала екен.
Dialogue: 0,1:40:55.00,1:40:57.05,Default,,0,0,0,,Мүмкін ол Нинаның көнгенін қаламайтын шығар.
Dialogue: 0,1:40:57.42,1:40:58.30,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:40:58.42,1:41:01.01,Default,,0,0,0,,Сіз «кешірім сұраңыз» деу үшін келдіңіз бе?
Dialogue: 0,1:41:01.13,1:41:03.26,Default,,0,0,0,,Өйткені, айта берсең, төбеңде қалатыныңды білемін.
Dialogue: 0,1:41:03.39,1:41:06.22,Default,,0,0,0,,Шынымен! Нина-сан, бұл соңғы бастық сияқты.
Dialogue: 0,1:41:06.35,1:41:08.81,Default,,0,0,0,,Ол әлемдегі ең тітіркендіргіш жын патшасы.
Dialogue: 0,1:41:09.10,1:41:11.48,Default,,0,0,0,,Бірақ егер сіз оны жеңсеңіз, ойын аяқталады.
Dialogue: 0,1:41:11.60,1:41:12.69,Default,,0,0,0,,Мен сенің құлағаныңды қаламаймын.
Dialogue: 0,1:41:12.98,1:41:14.44,Default,,0,0,0,,Мен мүлдем бақытты емеспін!
Dialogue: 0,1:41:14.61,1:41:17.78,Default,,0,0,0,,Мен сені мақтаймын. Мен оны айтып отырғаныма сенімдімін.
Dialogue: 0,1:41:17.90,1:41:20.53,Default,,0,0,0,,үшінна, уақыт келді.
Dialogue: 0,1:41:25.70,1:41:27.29,Default,,0,0,0,,[Перденнің түскен дыбысы]
Dialogue: 0,1:41:33.54,1:41:36.21,Default,,0,0,0,,(шақыру)
Dialogue: 0,1:41:36.34,1:41:38.59,Default,,0,0,0,,Ал... бәрі, өздерің білетіндей.
Dialogue: 0,1:41:38.71,1:41:41.67,Default,,0,0,0,,Бұл Алмаз шаңымен кездесу болды.
Dialogue: 0,1:41:41.80,1:41:43.13,Default,,0,0,0,,Нәтижелерді көре аласыз...
Dialogue: 0,1:41:43.26,1:41:44.09,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:44.22,1:41:46.43,Default,,0,0,0,,Бүгін келгеніңіз үшін рахмет!
Dialogue: 0,1:41:46.55,1:41:47.39,Default,,0,0,0,,[Бұрын! ]
Dialogue: 0,1:41:47.51,1:41:48.52,Default,,0,0,0,,Бұл~!
Dialogue: 0,1:41:48.64,1:41:51.48,Default,,0,0,0,,Ахахха! Жарайды, жарайды!
Dialogue: 0,1:41:51.64,1:41:54.77,Default,,0,0,0,,Шындығында, біз мұны өте жақсы түсіндік.
Dialogue: 0,1:41:54.90,1:41:58.23,Default,,0,0,0,,«Мен Алмаз шаңын жеңгім келеді» «Мен жеңілгім келмейді»
Dialogue: 0,1:41:58.44,1:42:01.24,Default,,0,0,0,,Фестивальдарда да бір-бірімізбен шындап жарысатынбыз.
Dialogue: 0,1:42:03.49,1:42:05.62,Default,,0,0,0,,Бұл кенет, бірақ мен өзім туралы айтайын.
Dialogue: 0,1:42:06.16,1:42:07.49,Default,,0,0,0,,Сіз сенімдісіз бе? Лупа мырза
Dialogue: 0,1:42:08.99,1:42:10.66,Default,,0,0,0,,Мен орта мектепте
Dialogue: 0,1:42:10.79,1:42:13.12,Default,,0,0,0,,Бірде қорлық көрген балаға көмектесуге бардым.
Dialogue: 0,1:42:13.50,1:42:17.88,Default,,0,0,0,,Ол кезде мен сыныптан көмекке келе жатқан едім, сондай қуаныштымын.
Dialogue: 0,1:42:18.17,1:42:19.67,Default,,0,0,0,,Мен өзімді мақтаныш сезіндім.
Dialogue: 0,1:42:19.80,1:42:21.63,Default,,0,0,0,,Маған солай ұнады.
Dialogue: 0,1:42:21.97,1:42:25.68,Default,,0,0,0,,Соның кесірінен мен өзімді қорқыттым...
Dialogue: 0,1:42:25.80,1:42:27.76,Default,,0,0,0,,Мен мектепті тастап кеттім.
Dialogue: 0,1:42:28.35,1:42:31.60,Default,,0,0,0,,Бірақ содан бері мен бірде-бір рет: ''Бармағанымды қалаймын'' деп айтқан емеспін.
Dialogue: 0,1:42:31.72,1:42:34.52,Default,,0,0,0,,«Егер мен бармағанымда, бұл болмас еді»
Dialogue: 0,1:42:34.64,1:42:36.15,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін ...
Dialogue: 0,1:42:36.56,1:42:37.90,Default,,0,0,0,,Мен осылай білдім.
Dialogue: 0,1:42:38.61,1:42:41.65,Default,,0,0,0,,Мен ештеңеге өкінбеймін.
Dialogue: 0,1:42:41.94,1:42:45.32,Default,,0,0,0,,Момоканың әні мені шыңдады
Dialogue: 0,1:42:45.95,1:42:47.99,Default,,0,0,0,,Мен Хинамен жиі осылай сөйлесемін...
Dialogue: 0,1:42:49.45,1:42:50.41,Default,,0,0,0,,Ах...
Dialogue: 0,1:42:51.87,1:42:52.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:42:54.08,1:42:55.79,Default,,0,0,0,,Маған да Хина ұнады.
Dialogue: 0,1:42:56.71,1:42:58.17,Default,,0,0,0,,Дайдастың әні...
Dialogue: 0,1:42:59.88,1:43:01.67,Default,,0,0,0,,Бұл менің әнім ғана емес
Dialogue: 0,1:43:01.80,1:43:03.59,Default,,0,0,0,,Ол дұрыс келді...
Dialogue: 0,1:43:05.01,1:43:06.05,Default,,0,0,0,,Хехе
Dialogue: 0,1:43:07.09,1:43:10.35,Default,,0,0,0,,Тағы да бүгінгі күн үшін көп рахмет.
Dialogue: 0,1:43:10.47,1:43:13.85,Default,,0,0,0,,Осында келген қисық адамдарсың.
Dialogue: 0,1:43:13.98,1:43:17.15,Default,,0,0,0,,Бірақ мен сондай адамдарды жақсы көремін.
Dialogue: 0,1:43:17.48,1:43:19.06,Default,,0,0,0,,Ал мен айқайлаймын
Dialogue: 0,1:43:19.19,1:43:22.36,Default,,0,0,0,,«Мен ұтылмаймын» «Мен қателеспеймін»
Dialogue: 0,1:43:22.90,1:43:26.57,Default,,0,0,0,,Біздің бастауларымыздың куәсі бол!
Dialogue: 0,1:43:26.82,1:43:29.82,Default,,0,0,0,,♪～
Dialogue: 0,1:43:31.83,1:43:33.95,Default,,0,0,0,,«Тағдыр гүлі» ♪Бәрі бірдей
Dialogue: 0,1:43:34.08,1:43:36.41,Default,,0,0,0,,♪Өмір сүру
Dialogue: 0,1:43:36.54,1:43:38.63,Default,,0,0,0,,♪Қонатын жерің жоқ болса
Dialogue: 0,1:43:38.75,1:43:44.80,Default,,0,0,0,,♪Ұшыңыз
Dialogue: 0,1:43:44.92,1:43:47.47,Default,,0,0,0,,♪Тағдыр тоғысады, ырылдайды
Dialogue: 0,1:43:47.59,1:43:49.68,Default,,0,0,0,,♪Мен басқа жолдардың бәрін жедім
Dialogue: 0,1:43:49.80,1:43:51.93,Default,,0,0,0,,♪Мен үшін қалған өмір
Dialogue: 0,1:43:52.06,1:43:54.39,Default,,0,0,0,,♪Сенімен бірге ән айту
Dialogue: 0,1:43:54.52,1:43:56.64,Default,,0,0,0,,♪Жарық та, жел де жоқ
Dialogue: 0,1:43:56.77,1:43:59.27,Default,,0,0,0,,♪Оқшаулау түрмесі сияқты
Dialogue: 0,1:43:59.40,1:44:01.36,Default,,0,0,0,,♪Ауырып, ауыртады
Dialogue: 0,1:44:01.48,1:44:03.52,Default,,0,0,0,,♪Бәрі сызаттармен жабылған
Dialogue: 0,1:44:03.65,1:44:06.07,Default,,0,0,0,,♪Мен оны жек көрдім...
Dialogue: 0,1:44:06.19,1:44:09.53,Default,,0,0,0,,♪Жайылған қанаттарым саңылауларға толы болса да
Dialogue: 0,1:44:09.66,1:44:11.07,Default,,0,0,0,,♪Тіпті тозақтың тереңдігі
Dialogue: 0,1:44:11.20,1:44:15.08,Default,,0,0,0,,♪Сенімен ән айтсам
Dialogue: 0,1:44:16.00,1:44:19.25,Default,,0,0,0,,♪Жоғалғым келеді, Қанатымды қағып жатырмын қазір
Dialogue: 0,1:44:19.37,1:44:21.92,Default,,0,0,0,,♪Мен енді жоғалып кеткім келмейді
Dialogue: 0,1:44:22.04,1:44:23.38,Default,,0,0,0,,♪Жұлдырап кетіп қалды
Dialogue: 0,1:44:23.50,1:44:26.21,Default,,0,0,0,,♪Бір күні бұл жерде гүлдер гүлдейді
Dialogue: 0,1:44:26.34,1:44:29.47,Default,,0,0,0,,♪Мен жоғалып кеткім келді, мен енді жоқпын
Dialogue: 0,1:44:29.59,1:44:31.97,Default,,0,0,0,,♪Оның жоғалып кетпегеніне қуаныштымын...
Dialogue: 0,1:44:32.10,1:44:35.14,Default,,0,0,0,,♪Себебі мен сені кездестіргенде бәрі гүлдей бастады.
Dialogue: 0,1:44:35.26,1:44:39.56,Default,,0,0,0,,♪Тағдыр гүлі
Dialogue: 0,1:44:41.31,1:44:43.31,Default,,0,0,0,,♪Бәрі бірдей
Dialogue: 0,1:44:43.44,1:44:46.03,Default,,0,0,0,,♪Өмір сүру
Dialogue: 0,1:44:46.15,1:44:48.19,Default,,0,0,0,,♪Мен бақыттымын және көңілдімін
Dialogue: 0,1:44:48.32,1:44:50.24,Default,,0,0,0,,♪Барлық әлсіз жақтары
Dialogue: 0,1:44:50.36,1:44:52.70,Default,,0,0,0,,♪Ол жоғалып кетті
Dialogue: 0,1:44:52.82,1:44:56.24,Default,,0,0,0,,♪Айналсаң қара бұлт шығады
Dialogue: 0,1:44:56.37,1:44:57.87,Default,,0,0,0,,♪Абайсыз болса да, бұл жолы
Dialogue: 0,1:44:58.00,1:45:01.83,Default,,0,0,0,,♪Желді соққым келеді
Dialogue: 0,1:45:24.69,1:45:27.11,Default,,0,0,0,,♪Тағдыр тоғысады, ырылдайды
Dialogue: 0,1:45:27.23,1:45:29.49,Default,,0,0,0,,♪Мен басқа жолдардың бәрін жедім
Dialogue: 0,1:45:29.61,1:45:31.53,Default,,0,0,0,,♪Мен үшін қалған өмір
Dialogue: 0,1:45:31.65,1:45:34.53,Default,,0,0,0,,♪Сенімен бірге ән айту
Dialogue: 0,1:45:34.66,1:45:36.08,Default,,0,0,0,,Бір екі үш төрт!
Dialogue: 0,1:45:36.91,1:45:40.20,Default,,0,0,0,,♪Көне алмағандықтан бас тарттым, қазір
Dialogue: 0,1:45:40.33,1:45:42.83,Default,,0,0,0,,♪Мен түс туралы білдім
Dialogue: 0,1:45:42.96,1:45:44.38,Default,,0,0,0,,♪Өткен күндерде
Dialogue: 0,1:45:44.50,1:45:47.09,Default,,0,0,0,,♪Мен қайтпаймын, тіпті қайтқым да келмейді
Dialogue: 0,1:45:47.21,1:45:50.26,Default,,0,0,0,,♪Сіз болғыңыз келген күннен асып кетіңіз
Dialogue: 0,1:45:50.38,1:45:52.97,Default,,0,0,0,,♪Мен ...болмағаныма қуаныштымын.
Dialogue: 0,1:45:53.09,1:45:55.89,Default,,0,0,0,,♪Сенімен көбірек күліп, ертеңгі күнді көргім келеді
Dialogue: 0,1:45:56.01,1:45:57.18,Default,,0,0,0,,♪Бұл тағдыр
Dialogue: 0,1:45:57.31,1:46:00.39,Default,,0,0,0,,♪Жоғалып кеткім келеді, Қанатымды қағып жатырмын енді
Dialogue: 0,1:46:00.52,1:46:02.94,Default,,0,0,0,,♪Мен енді жоғалып кеткім келмейді
Dialogue: 0,1:46:03.06,1:46:04.81,Default,,0,0,0,,♪Жұлдырап қалды
Dialogue: 0,1:46:04.94,1:46:07.07,Default,,0,0,0,,♪Бір күні бұл жерде гүлдер гүлдейді
Dialogue: 0,1:46:07.19,1:46:10.53,Default,,0,0,0,,♪Мен жоғалып кеткім келді, мен енді жоқпын
Dialogue: 0,1:46:10.65,1:46:13.20,Default,,0,0,0,,♪Оның жоғалып кетпегеніне қуаныштымын...
Dialogue: 0,1:46:13.32,1:46:16.20,Default,,0,0,0,,♪Себебі мен сені кездестіргенде бүршіктерім гүлденді.
Dialogue: 0,1:46:16.32,1:46:22.41,Default,,0,0,0,,♪Тағдыр гүлі
Dialogue: 0,1:46:38.01,1:46:40.06,Default,,0,0,0,,～♪
Dialogue: 0,1:46:40.18,1:46:42.56,Default,,0,0,0,,(қуаныш)
Dialogue: 0,1:46:45.69,1:46:46.94,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,1:46:47.06,1:46:48.31,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:46:48.44,1:46:53.61,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:46:56.78,1:46:59.78,Default,,0,0,0,,♪～
Dialogue: 0,1:47:01.91,1:47:05.00,Default,,0,0,0,,«Тікенді раушан» ♪Менің шындығым тыртыққа толы еді
Dialogue: 0,1:47:05.12,1:47:07.71,Default,,0,0,0,,♪ Мен білмей тұрып, күн жарқырап тұрды
Dialogue: 0,1:47:07.83,1:47:10.17,Default,,0,0,0,,♪ Күлесің
Dialogue: 0,1:47:10.63,1:47:13.30,Default,,0,0,0,,♪Мен де алданып қалдым, лол
Dialogue: 0,1:47:13.42,1:47:16.05,Default,,0,0,0,,♪Ешқандай үміт болмаса да
Dialogue: 0,1:47:16.18,1:47:18.85,Default,,0,0,0,,♪Батыл гүлдеймін
Dialogue: 0,1:47:18.97,1:47:21.31,Default,,0,0,0,,♪Барлық жерде
Dialogue: 0,1:47:21.72,1:47:24.56,Default,,0,0,0,,♪Менің қасымда бол
Dialogue: 0,1:47:24.68,1:47:28.90,Default,,0,0,0,,♪Кешіремін деп те айта алмаймын
Dialogue: 0,1:47:29.77,1:47:37.20,Default,,0,0,0,,♪Қоштасудың көз жасы алтын
Dialogue: 0,1:47:37.57,1:47:40.41,Default,,0,0,0,,♪Соңы әлі осында
Dialogue: 0,1:47:40.53,1:47:43.83,Default,,0,0,0,,♪Аспан жарқырап күледі
Dialogue: 0,1:47:43.95,1:47:46.62,Default,,0,0,0,,♪Мен көңілім қалғандықтан бәс тігемін.
Dialogue: 0,1:47:46.75,1:47:49.38,Default,,0,0,0,,♪Егер мұң нұрланса
Dialogue: 0,1:47:49.50,1:47:54.34,Default,,0,0,0,,♪Мен жеңілмеймін, себебі бұл қате емес
Dialogue: 0,1:47:54.46,1:47:58.76,Default,,0,0,0,,♪Аузыңды ашсаң, жек көретін боласың
Dialogue: 0,1:47:59.72,1:48:02.31,Default,,0,0,0,,♪Тіпті күрсіну түнінде
Dialogue: 0,1:48:02.81,1:48:06.06,Default,,0,0,0,,♪Егер мен сізге лайықты түрде бет бұрсам
Dialogue: 0,1:48:06.18,1:48:08.81,Default,,0,0,0,,♪Сұр жол
Dialogue: 0,1:48:08.94,1:48:11.56,Default,,0,0,0,,♪ Артқы жел соғады ма?
Dialogue: 0,1:48:11.69,1:48:16.44,Default,,0,0,0,,♪Түрлі-түсті, бұрын көрмеген болашақ
Dialogue: 0,1:48:16.74,1:48:21.57,Default,,0,0,0,,♪Дірілдеген жүрегім ертеңгі күнге үміт
Dialogue: 0,1:48:22.03,1:48:25.87,Default,,0,0,0,,♪Шашылған дәндер гүлге айналады
Dialogue: 0,1:48:36.26,1:48:39.26,Default,,0,0,0,,♪Сома туралы білудің қажеті жоқ.
Dialogue: 0,1:48:39.38,1:48:42.09,Default,,0,0,0,,♪Тым сентиментальды болмаңыз
Dialogue: 0,1:48:42.22,1:48:44.47,Default,,0,0,0,,♪Еш уақытта
Dialogue: 0,1:48:44.93,1:48:47.73,Default,,0,0,0,,♪Мен теңізден өтемін
Dialogue: 0,1:48:47.85,1:48:52.27,Default,,0,0,0,,♪Қуаныш естіместен
Dialogue: 0,1:48:53.15,1:49:00.70,Default,,0,0,0,,♪Ұйқыдағы күлкіге гүл шоғын қойыңыз
Dialogue: 0,1:49:00.82,1:49:03.37,Default,,0,0,0,,♪Соңы әлі жоқ
Dialogue: 0,1:49:03.49,1:49:07.45,Default,,0,0,0,,♪Мен оны жүзеге асырамын
Dialogue: 0,1:49:23.22,1:49:26.47,Default,,0,0,0,,♪Бір күні жоғалтқан нұрым
Dialogue: 0,1:49:26.60,1:49:29.23,Default,,0,0,0,,♪Жарқыраған арман
Dialogue: 0,1:49:29.35,1:49:32.02,Default,,0,0,0,,♪Түнгі аспанда ұшсаң
Dialogue: 0,1:49:32.14,1:49:36.98,Default,,0,0,0,,♪Басылма, қазірдің өзінде кеш
Dialogue: 0,1:49:37.11,1:49:41.53,Default,,0,0,0,,♪Келесі күні біз бір-бірімізге жылуымызды лақтырып жатырмыз
Dialogue: 0,1:49:42.32,1:49:44.95,Default,,0,0,0,,♪Мен оны жасыра алмаймын
Dialogue: 0,1:49:45.45,1:49:48.66,Default,,0,0,0,,♪Егер мен сенімен шексіз жүрсем
Dialogue: 0,1:49:48.79,1:49:51.46,Default,,0,0,0,,♪Біз көкпіз
Dialogue: 0,1:49:51.58,1:49:54.25,Default,,0,0,0,,♪Сүйікті болар ма екенмін
Dialogue: 0,1:49:54.38,1:49:58.88,Default,,0,0,0,,♪Бақыт, бір қадам
Dialogue: 0,1:49:59.38,1:50:04.30,Default,,0,0,0,,♪Біз кездескен қалада иірген тағдырымыз
Dialogue: 0,1:50:04.76,1:50:10.60,Default,,0,0,0,,♪Сол ұшқын ешқашан сөнбейді, солай ма?
Dialogue: 0,1:50:15.77,1:50:19.61,Default,,0,0,0,,♪Тілеген арман болса, гүлдей берсін
Dialogue: 0,1:50:24.82,1:50:27.83,Default,,0,0,0,,～♪
Dialogue: 0,1:50:29.33,1:50:35.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
