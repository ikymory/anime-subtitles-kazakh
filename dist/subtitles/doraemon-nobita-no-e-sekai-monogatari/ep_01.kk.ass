Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.01,0:00:16.97,Default,,0,0,0,,（）
Dialogue: 0,0:00:17.64,0:00:22.10,Default,,0,0,0,,Мило~ Басқа нәрсемен ойнайық!
Dialogue: 0,0:00:22.18,0:00:24.48,Default,,0,0,0,,Иә... сәл күте тұрыңыз.
Dialogue: 0,0:00:24.56,0:00:26.40,Default,,0,0,0,,Мило!
Dialogue: 0,0:00:27.06,0:00:29.52,Default,,0,0,0,,Иә... сәл ғана
Dialogue: 0,0:00:29.61,0:00:31.69,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:00:31.78,0:00:32.82,Default,,0,0,0,,Иә...
Dialogue: 0,0:00:33.45,0:00:35.82,Default,,0,0,0,,А, көк жарғанат
Dialogue: 0,0:00:35.91,0:00:37.41,Default,,0,0,0,,Иә...
Dialogue: 0,0:00:37.49,0:00:39.53,Default,,0,0,0,,Не? қайда?
Dialogue: 0,0:00:39.62,0:00:40.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:40.91,0:00:43.66,Default,,0,0,0,,Аты аңызға айналған көк жарқанатты тауып алайық.
Dialogue: 0,0:00:43.75,0:00:45.00,Default,,0,0,0,,Жоғалған орманда!
Dialogue: 0,0:00:45.08,0:00:47.08,Default,,0,0,0,,Не, ана жерде...
Dialogue: 0,0:00:47.17,0:00:50.13,Default,,0,0,0,,Мен бармауым керек, өйткені шайтан пайда болады...
Dialogue: 0,0:00:50.21,0:00:52.30,Default,,0,0,0,,Хмм, бәрібір!
Dialogue: 0,0:00:52.38,0:00:55.47,Default,,0,0,0,,Тек сурет салмаңыз, ойнаңыз!
Dialogue: 0,0:00:58.93,0:01:00.14,Default,,0,0,0,,Ха...
Dialogue: 0,0:01:01.26,0:01:02.35,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:01:02.97,0:01:05.39,Default,,0,0,0,,Мен мұны салып біткенше сәл күте тұрыңыз.
Dialogue: 0,0:01:05.48,0:01:09.52,Default,,0,0,0,,Хм, мен аздап сыздым!
Dialogue: 0,0:01:09.61,0:01:13.28,Default,,0,0,0,,Ендеше, біз де Клэрдің суретін салайық. Бұл қызық болады...
Dialogue: 0,0:01:13.36,0:01:14.82,Default,,0,0,0,,Боу!
Dialogue: 0,0:01:14.90,0:01:19.20,Default,,0,0,0,,Мен суреттерді жек көремін!
Dialogue: 0,0:01:19.32,0:01:21.58,Default,,0,0,0,,Ах... Клэр!
Dialogue: 0,0:01:27.08,0:01:28.96,Default,,0,0,0,,Милоның идиоты
Dialogue: 0,0:01:30.09,0:01:32.09,Default,,0,0,0,,Маған Мило ұнамайды.
Dialogue: 0,0:01:33.88,0:01:36.84,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:01:39.18,0:01:40.43,Default,,0,0,0,,Ха...
Dialogue: 0,0:01:48.39,0:01:51.48,Default,,0,0,0,,Хаха... Мм...
Dialogue: 0,0:01:53.82,0:01:56.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:06.83,0:02:11.38,Default,,0,0,0,,（）
Dialogue: 0,0:02:13.29,0:02:15.17,Default,,0,0,0,,Гррр!
Dialogue: 0,0:02:15.26,0:02:16.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:16.71,0:02:19.09,Default,,0,0,0,,Гррр!
Dialogue: 0,0:02:20.34,0:02:21.51,Default,,0,0,0,,«Hairi Komi Light» шығысы болып табылады
Dialogue: 0,0:02:21.59,0:02:23.05,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:02:23.56,0:02:25.47,Default,,0,0,0,,Сіз түсінуге мүмкіндік жоқ!
Dialogue: 0,0:02:25.56,0:02:27.77,Default,,0,0,0,,Осындай лабиринтте!
Dialogue: 0,0:02:27.85,0:02:30.73,Default,,0,0,0,,Хе! Эй! Эй!
Dialogue: 0,0:02:30.81,0:02:31.94,Default,,0,0,0,,Гррр!
Dialogue: 0,0:02:32.02,0:02:33.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:33.27,0:02:34.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:34.48,0:02:35.98,Default,,0,0,0,,Тея!
Dialogue: 0,0:02:37.24,0:02:38.15,Default,,0,0,0,,Ая!
Dialogue: 0,0:02:38.82,0:02:40.61,Default,,0,0,0,,Ngg
Dialogue: 0,0:02:42.74,0:02:44.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:44.45,0:02:46.16,Default,,0,0,0,,Шығу!
Dialogue: 0,0:02:47.95,0:02:50.12,Default,,0,0,0,,Гррр!
Dialogue: 0,0:02:51.21,0:02:52.83,Default,,0,0,0,,Гррр... Гррр!
Dialogue: 0,0:02:54.59,0:02:56.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:56.42,0:02:58.51,Default,,0,0,0,,Ооо!
Dialogue: 0,0:03:01.38,0:03:02.97,Default,,0,0,0,,Yahoo~!
Dialogue: 0,0:03:03.05,0:03:04.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:04.30,0:03:05.14,Default,,0,0,0,,Гррр!
Dialogue: 0,0:03:05.22,0:03:06.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:07.47,0:03:09.60,Default,,0,0,0,,бұл… «Ирикоми жарығы»
Dialogue: 0,0:03:09.68,0:03:11.56,Default,,0,0,0,,Бас тарту~!
Dialogue: 0,0:03:11.64,0:03:13.44,Default,,0,0,0,,Гуо...?
Dialogue: 0,0:03:14.02,0:03:16.52,Default,,0,0,0,,Жұт... жұт...
Dialogue: 0,0:03:19.11,0:03:21.28,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:03:22.49,0:03:24.87,Default,,0,0,0,,Мен бұл суреттегі құбыжық екеніне қуаныштымын.
Dialogue: 0,0:03:24.95,0:03:27.62,Default,,0,0,0,,Егер мұндай нәрсе шын болса...
Dialogue: 0,0:03:27.70,0:03:32.08,Default,,0,0,0,,Минотавр мифологиядағы құбыжық екені рас.
Dialogue: 0,0:03:32.17,0:03:35.67,Default,,0,0,0,,Бұл Кноссос сарайы шынайы.
Dialogue: 0,0:03:35.75,0:03:37.59,Default,,0,0,0,,Дұрыс қазылған.
Dialogue: 0,0:03:37.67,0:03:40.30,Default,,0,0,0,,- Мино өркениеті, солай ма? -(Сунео) Иә!
Dialogue: 0,0:03:40.38,0:03:42.47,Default,,0,0,0,,Осы сарайдың ашылуымен
Dialogue: 0,0:03:42.55,0:03:46.30,Default,,0,0,0,,Жоғалған өркениеттің бар екендігі дәлелденді.
Dialogue: 0,0:03:46.39,0:03:49.43,Default,,0,0,0,,Трояның осы қирандыларына да солай.
Dialogue: 0,0:03:49.52,0:03:52.44,Default,,0,0,0,,Романтикалық емес пе? Мүмкін-
Dialogue: 0,0:03:52.52,0:03:55.81,Default,,0,0,0,,Әлі де жойылып кеткен және әлі ашылмаған көптеген елдер мен өркениеттер бар...
Dialogue: 0,0:03:55.90,0:03:58.02,Default,,0,0,0,,Тарихты оқу маңызды емес!
Dialogue: 0,0:03:58.11,0:04:01.03,Default,,0,0,0,,Басқа суретті қайталап көрейік.
Dialogue: 0,0:04:01.11,0:04:03.61,Default,,0,0,0,,Мен бұл жолы қызықты сурет алғым келеді.
Dialogue: 0,0:04:03.70,0:04:05.20,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:04:05.28,0:04:06.70,Default,,0,0,0,,Қызық көрінеді!
Dialogue: 0,0:04:06.78,0:04:08.16,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:04:08.24,0:04:10.45,Default,,0,0,0,,«Хай Ирикоми Жарығы»!
Dialogue: 0,0:04:13.75,0:04:15.50,Default,,0,0,0,,Хехе...
Dialogue: 0,0:04:15.58,0:04:16.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:16.92,0:04:18.71,Default,,0,0,0,,Нобита-кун тез
Dialogue: 0,0:04:18.80,0:04:22.09,Default,,0,0,0,,Күте тұрыңыз, Дораемон!
Dialogue: 0,0:04:22.17,0:04:27.18,Default,,0,0,0,,♪～
Dialogue: 0,0:05:47.01,0:05:52.18,Default,,0,0,0,,～♪
Dialogue: 0,0:05:52.26,0:05:55.14,Default,,0,0,0,,(цикада дауысы)
Dialogue: 0,0:05:55.22,0:05:57.60,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:06:06.57,0:06:07.78,Default,,0,0,0,,Хуа~аа
Dialogue: 0,0:06:07.86,0:06:10.87,Default,,0,0,0,,- (Нобита) Қозғалма! -Кешіріңіз, кешіріңіз
Dialogue: 0,0:06:10.95,0:06:14.62,Default,,0,0,0,,Сондай-ақ мен жақсы сурет сала алмаймын, себебі ол қозғалады.
Dialogue: 0,0:06:14.70,0:06:17.37,Default,,0,0,0,,Қозғалмасаң да, суретті жақсы сала алмайсың.
Dialogue: 0,0:06:17.46,0:06:18.62,Default,,0,0,0,,(Стефани) Маған оның бәрі бір! Ең бастысы —
Dialogue: 0,0:06:20.42,0:06:24.42,Default,,0,0,0,,Жақсы сурет салу туралы ойланудың қажеті жоқ.
Dialogue: 0,0:06:24.50,0:06:27.30,Default,,0,0,0,,Өйткені суретті жақсы салмасаң, жұрт саған күледі.
Dialogue: 0,0:06:27.38,0:06:29.26,Default,,0,0,0,,Ика Нобита
Dialogue: 0,0:06:29.34,0:06:31.47,Default,,0,0,0,,Суретте не маңызды?
Dialogue: 0,0:06:31.55,0:06:35.47,Default,,0,0,0,,Бұл жақсы сурет салу туралы емес.
Dialogue: 0,0:06:35.56,0:06:38.23,Default,,0,0,0,,Ең бастысы...
Dialogue: 0,0:06:38.31,0:06:41.35,Default,,0,0,0,,Шынымен... бұл...
Dialogue: 0,0:06:42.40,0:06:46.28,Default,,0,0,0,,Гу~ Хмм~
Dialogue: 0,0:06:46.36,0:06:47.99,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:06:48.07,0:06:50.28,Default,,0,0,0,,Әкем артық жұмыс істеген көрінеді.
Dialogue: 0,0:06:50.36,0:06:52.45,Default,,0,0,0,,Маған ұйықтауға рұқсат етіңіз.
Dialogue: 0,0:06:52.53,0:06:55.74,Default,,0,0,0,,Ха~ бітті!
Dialogue: 0,0:06:55.83,0:06:57.79,Default,,0,0,0,,Оны тастауға әлі ерте
Dialogue: 0,0:06:57.87,0:07:00.79,Default,,0,0,0,,Мен әр түрлі картиналардың ішіне қарауға тырыстым.
Dialogue: 0,0:07:00.87,0:07:03.00,Default,,0,0,0,,Мынадай бірдеңе, аздап шығармашылық құштарлық...
Dialogue: 0,0:07:03.08,0:07:06.13,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:07:06.21,0:07:07.96,Default,,0,0,0,,Мен сызбаларды кейінге қалдырамын.
Dialogue: 0,0:07:08.05,0:07:11.05,Default,,0,0,0,,Жазғы каникул біткенше орындаңыз.
Dialogue: 0,0:07:11.13,0:07:12.68,Default,,0,0,0,,күрсіну
Dialogue: 0,0:07:12.76,0:07:15.43,Default,,0,0,0,,Жақында мен жаман нәрселерді артқа тастаймын.
Dialogue: 0,0:07:15.43,0:07:15.76,Default,,0,0,0,,Жақында жаман нәрселерді артқа тастаймын.
Dialogue: 0,0:07:15.43,0:07:15.76,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:07:15.76,0:07:15.85,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:07:15.85,0:07:18.22,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:07:15.85,0:07:18.22,Default,,0,0,0,,Нобита-кун әрқашан
Dialogue: 0,0:07:18.31,0:07:21.06,Default,,0,0,0,,Гутара Гутара...
Dialogue: 0,0:07:21.14,0:07:22.52,Default,,0,0,0,,Я...
Dialogue: 0,0:07:24.06,0:07:26.02,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:07:26.11,0:07:28.19,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:07:28.28,0:07:32.03,Default,,0,0,0,,Дайын суретте де жаңбыр жаумай ма деп ойлаймын...
Dialogue: 0,0:07:34.49,0:07:35.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:37.24,0:07:38.45,Default,,0,0,0,,Хамф!
Dialogue: 0,0:07:38.79,0:07:39.66,Default,,0,0,0,,Гюго!
Dialogue: 0,0:07:39.75,0:07:40.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:43.67,0:07:44.92,Default,,0,0,0,,О!
Dialogue: 0,0:07:48.59,0:07:51.22,Default,,0,0,0,,Көп уақыт өтті...
Dialogue: 0,0:07:51.88,0:07:53.34,Default,,0,0,0,,Жоғалып кетті…
Dialogue: 0,0:07:57.93,0:08:00.14,Default,,0,0,0,,Суреттер құлап жатыр ма?
Dialogue: 0,0:08:00.93,0:08:04.06,Default,,0,0,0,,Жаңбыр жауып тұр, иә? Бұл?
Dialogue: 0,0:08:04.15,0:08:06.11,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:06.19,0:08:07.77,Default,,0,0,0,,Бұл сирек кездеседі.
Dialogue: 0,0:08:07.86,0:08:11.11,Default,,0,0,0,,Кенепке емес, тікелей тақтаға салынған.
Dialogue: 0,0:08:11.19,0:08:13.49,Default,,0,0,0,,Бұл біртүрлі пішін.
Dialogue: 0,0:08:13.57,0:08:16.24,Default,,0,0,0,,Мұның жалғасы бар сияқты...
Dialogue: 0,0:08:16.32,0:08:17.99,Default,,0,0,0,,Бұл жарғанат па?
Dialogue: 0,0:08:18.08,0:08:19.70,Default,,0,0,0,,Меніңше...
Dialogue: 0,0:08:19.79,0:08:20.95,Default,,0,0,0,,Біртүрлі көк.
Dialogue: 0,0:08:21.04,0:08:23.16,Default,,0,0,0,,Әй, көк түс өзгерді!
Dialogue: 0,0:08:23.25,0:08:24.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:24.92,0:08:29.21,Default,,0,0,0,,Бұл рас. Түс бағдарға байланысты өзгеретін сияқты.
Dialogue: 0,0:08:29.30,0:08:31.51,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:08:32.09,0:08:35.26,Default,,0,0,0,,Мм... Жұмбақ шұңқырда, жұмбақ сурет
Dialogue: 0,0:08:35.34,0:08:37.85,Default,,0,0,0,,Неліктен жаңбыр жауды...
Dialogue: 0,0:08:39.01,0:08:40.89,Default,,0,0,0,,Иә, тыңдайық!
Dialogue: 0,0:08:40.97,0:08:42.73,Default,,0,0,0,,Не? Кімге?
Dialogue: 0,0:08:43.31,0:08:45.81,Default,,0,0,0,,«Хай Ирикоми Жарығы»!
Dialogue: 0,0:08:45.90,0:08:50.27,Default,,0,0,0,,Суреттегі баладан сұрасаң да түсінбейді деп ойлаймын...
Dialogue: 0,0:08:51.98,0:08:55.11,Default,,0,0,0,,Иә? Даа...
Dialogue: 0,0:08:56.07,0:08:58.95,Default,,0,0,0,,- (Нобита) Не! -Ая...
Dialogue: 0,0:08:59.03,0:09:00.74,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:09:09.75,0:09:10.88,Default,,0,0,0,,Хаха
Dialogue: 0,0:09:10.96,0:09:15.01,Default,,0,0,0,,- (Нобита) Ол бала қайда? - Хмм.
Dialogue: 0,0:09:15.09,0:09:17.97,Default,,0,0,0,,Хаха ахаха…
Dialogue: 0,0:09:18.05,0:09:21.31,Default,,0,0,0,,Қысқа жеңдер сәл салқын.
Dialogue: 0,0:09:21.39,0:09:23.02,Default,,0,0,0,,Хахаха
Dialogue: 0,0:09:23.10,0:09:24.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:24.31,0:09:26.69,Default,,0,0,0,,Хаха хахаха
Dialogue: 0,0:09:26.77,0:09:29.69,Default,,0,0,0,,Ал, дәмін татып көргің келе ме?
Dialogue: 0,0:09:31.07,0:09:32.90,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:35.40,0:09:36.90,Default,,0,0,0,,Жоқ, вокзалдың алдында түсіріп кетсеңіз жеткілікті.
Dialogue: 0,0:09:36.99,0:09:39.07,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:43.20,0:09:47.33,Default,,0,0,0,,- (Нобита) Мен оны жоғалтып алдым - Ол көңілді бала.
Dialogue: 0,0:09:47.42,0:09:50.88,Default,,0,0,0,,Көздің түсі суреттегі жарқанатпен бірдей болды.
Dialogue: 0,0:09:50.96,0:09:52.55,Default,,0,0,0,,Не? Шынымен бе?
Dialogue: 0,0:09:52.63,0:09:55.88,Default,,0,0,0,,Иә, бұл бір сәтке ғана болды, бірақ түсі өзгерді.
Dialogue: 0,0:09:55.97,0:09:57.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:04.64,0:10:06.81,Default,,0,0,0,,А...
Dialogue: 0,0:10:12.15,0:10:13.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:18.11,0:10:21.74,Default,,0,0,0,,(Клэрдің таңданған дауысы)
Dialogue: 0,0:10:27.41,0:10:31.00,Default,,0,0,0,,Нобита~? Тек бір тапсырманы орындау үшін...
Dialogue: 0,0:10:31.08,0:10:31.92,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:32.71,0:10:34.38,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:34.46,0:10:36.84,Default,,0,0,0,,Сіз Нобитаның досысыз ба?
Dialogue: 0,0:10:36.92,0:10:40.80,Default,,0,0,0,,Не деген сүйкімді бала...
Dialogue: 0,0:10:40.89,0:10:43.47,Default,,0,0,0,,Аяқ киім киіңіз!
Dialogue: 0,0:10:43.55,0:10:45.01,Default,,0,0,0,,Эй...
Dialogue: 0,0:10:45.85,0:10:46.93,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:10:47.02,0:10:50.39,Default,,0,0,0,,Бұл өнер тарихын қайта жазатын үлкен жаңалық.
Dialogue: 0,0:10:50.48,0:10:54.32,Default,,0,0,0,,Қазіргі уақытта көшіріліп жатқан осы үлкен мұражайдың қоймасынан.
Dialogue: 0,0:10:54.40,0:10:57.40,Default,,0,0,0,,Жұмбақ сурет табылды
Dialogue: 0,0:10:57.99,0:11:02.07,Default,,0,0,0,,Шығарманы қай ел немесе кім жасағаны туралы ешбір жазба таба алмадым.
Dialogue: 0,0:11:02.16,0:11:03.57,Default,,0,0,0,,Жұмбақ сурет
Dialogue: 0,0:11:03.66,0:11:05.79,Default,,0,0,0,,Айта кету керек, бұрыш бойынша—
Dialogue: 0,0:11:05.87,0:11:09.87,Default,,0,0,0,,Бұл жұмбақ көгілдір жылтырдың басқа түрін көрсетеді.
Dialogue: 0,0:11:09.96,0:11:13.08,Default,,0,0,0,,Бұл шамамен 13 ғасырдағы шығарма деп есептеледі.
Dialogue: 0,0:11:13.17,0:11:15.84,Default,,0,0,0,,Бұл өте сирек кездесетін түс.
Dialogue: 0,0:11:15.92,0:11:18.84,Default,,0,0,0,,Менің ойымша, оны қазіргі заманда да қайта жаңғырту мүмкін емес еді...
Dialogue: 0,0:11:18.92,0:11:19.97,Default,,0,0,0,,Мен таңқаларлық нәрсе таптым деп ойлаймын.
Dialogue: 0,0:11:19.97,0:11:22.26,Default,,0,0,0,,Мен таңқаларлық нәрсе таптым деп ойлаймын.
Dialogue: 0,0:11:19.97,0:11:22.26,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:24.39,0:11:28.06,Default,,0,0,0,,Осы ерекше көкті шығара алатын кен табылса.
Dialogue: 0,0:11:28.14,0:11:30.27,Default,,0,0,0,,Бұл гауһар тас емес
Dialogue: 0,0:11:30.35,0:11:32.81,Default,,0,0,0,,Құны ондаған миллиард иен болуы мүмкін
Dialogue: 0,0:11:32.90,0:11:34.27,Default,,0,0,0,,Ондаған миллиард иен?
Dialogue: 0,0:11:34.36,0:11:37.23,Default,,0,0,0,,Мен мұнда Нобитаны көре алмаймын.
Dialogue: 0,0:11:37.32,0:11:40.44,Default,,0,0,0,,Осы ерекше кен туралы анықтамаларды табу
Dialogue: 0,0:11:40.53,0:11:43.86,Default,,0,0,0,,Сурет қазіргі уақытта жан-жақты талдануда.
Dialogue: 0,0:11:43.95,0:11:47.20,Default,,0,0,0,,Міне, бұл арманға толы оқиға.
Dialogue: 0,0:11:47.28,0:11:49.16,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:11:50.08,0:11:53.12,Default,,0,0,0,,(Клэрдің таңданған дауысы)
Dialogue: 0,0:11:53.21,0:11:54.88,Default,,0,0,0,,♬~
Dialogue: 0,0:11:54.96,0:11:56.88,Default,,0,0,0,,Уа, ау, әй...
Dialogue: 0,0:11:56.96,0:12:01.13,Default,,0,0,0,,Уау! Апыр-ай! Апыр-ай!
Dialogue: 0,0:12:01.22,0:12:04.59,Default,,0,0,0,,Уау~
Dialogue: 0,0:12:04.68,0:12:05.85,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:08.18,0:12:10.60,Default,,0,0,0,,Көрдіңіз бе? таңғы жаңалықтар
Dialogue: 0,0:12:10.68,0:12:13.73,Default,,0,0,0,,Көгілдір елестететін тас тауып алсам.
Dialogue: 0,0:12:13.81,0:12:15.73,Default,,0,0,0,,Оның құны ондаған миллиард иен.
Dialogue: 0,0:12:15.81,0:12:19.36,Default,,0,0,0,,Ой, оны қайдан табуға болады?
Dialogue: 0,0:12:19.44,0:12:22.28,Default,,0,0,0,,Егер сіз мұны түсінсеңіз, бұл иллюзия емес, солай ма?
Dialogue: 0,0:12:22.36,0:12:23.95,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:12:24.03,0:12:27.41,Default,,0,0,0,,Әй, ақымақ деген не? Ақымақ деген не?
Dialogue: 0,0:12:27.49,0:12:29.20,Default,,0,0,0,,Әзіл. Жай ойнам айттым.
Dialogue: 0,0:12:29.20,0:12:30.16,Default,,0,0,0,,Қалжың болса, әзіл
Dialogue: 0,0:12:29.20,0:12:30.16,Default,,0,0,0,,(Клэрдің күлуі)
Dialogue: 0,0:12:30.16,0:12:30.24,Default,,0,0,0,,(Клэрдің күлкісі)
Dialogue: 0,0:12:30.24,0:12:31.66,Default,,0,0,0,,(Клэрдің күлуі)
Dialogue: 0,0:12:30.24,0:12:31.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:31.75,0:12:33.75,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:12:39.67,0:12:41.51,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:12:41.59,0:12:43.30,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:12:46.34,0:12:48.72,Default,,0,0,0,,Уау~
Dialogue: 0,0:12:50.10,0:12:51.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:53.81,0:12:54.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:55.27,0:12:57.02,Default,,0,0,0,,Уау~
Dialogue: 0,0:12:59.19,0:13:02.28,Default,,0,0,0,,- (Сайт жетекшісі) Әй, сәл күте тұрыңыз - Анау, анау, анау!
Dialogue: 0,0:13:02.36,0:13:05.15,Default,,0,0,0,,- (бригадир) А? -Уау~
Dialogue: 0,0:13:05.24,0:13:06.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:12.70,0:13:13.54,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:13:15.12,0:13:16.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:19.96,0:13:22.67,Default,,0,0,0,,Тоқта! Тоқта~!
Dialogue: 0,0:13:38.06,0:13:39.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:41.23,0:13:42.07,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:45.11,0:13:46.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:46.32,0:13:47.99,Default,,0,0,0,,Тұрғындар балық аулау мен егіншілікпен күнкөреді—
Dialogue: 0,0:13:51.74,0:13:53.87,Default,,0,0,0,,Такеши-сан, тоқтат!
Dialogue: 0,0:13:53.95,0:13:56.29,Default,,0,0,0,,-Хмф - (Сунео) Иә?
Dialogue: 0,0:13:56.37,0:13:57.46,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:13:59.75,0:14:01.13,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:14:05.67,0:14:06.97,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:08.01,0:14:09.43,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:14:09.51,0:14:11.68,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,0:14:16.39,0:14:18.85,Default,,0,0,0,,Ха, қызық, қайда кетті?
Dialogue: 0,0:14:18.94,0:14:19.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:21.11,0:14:22.77,Default,,0,0,0,,Дораэмон бұл...
Dialogue: 0,0:14:22.86,0:14:25.40,Default,,0,0,0,,Иә? Амал жоқ...
Dialogue: 0,0:14:27.95,0:14:29.36,Default,,0,0,0,,Сәлем Нобита!
Dialogue: 0,0:14:29.45,0:14:31.95,Default,,0,0,0,,Бұл із кім? Қайда бардың?
Dialogue: 0,0:14:32.03,0:14:34.20,Default,,0,0,0,,Мен сыртқа шықтым.
Dialogue: 0,0:14:34.29,0:14:35.16,Default,,0,0,0,,Нобита?
Dialogue: 0,0:14:35.24,0:14:37.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:37.08,0:14:38.62,Default,,0,0,0,,(Шукуна) Хе-хе. (Итадори) Уф! Ах! Уф!
Dialogue: 0,0:14:38.71,0:14:40.33,Default,,0,0,0,,Перера…
Dialogue: 0,0:14:40.42,0:14:43.92,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Ойымда жоқ.
Dialogue: 0,0:14:44.00,0:14:46.59,Default,,0,0,0,,Әзірше менімен шай ішуге ше?
Dialogue: 0,0:14:46.67,0:14:48.09,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:14:48.17,0:14:50.68,Default,,0,0,0,,Сонда да сенің көздерің әдемі.
Dialogue: 0,0:14:50.76,0:14:54.10,Default,,0,0,0,,Шынымен жұмбақ түс...
Dialogue: 0,0:14:54.22,0:14:56.06,Default,,0,0,0,,Э? Не болып жатыр? Неге!?
Dialogue: 0,0:14:56.14,0:14:58.77,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:15:00.39,0:15:02.48,Default,,0,0,0,,«Шынында Конняку»!
Dialogue: 0,0:15:03.11,0:15:06.11,Default,,0,0,0,,Эй, мынаны көріңіз.
Dialogue: 0,0:15:06.19,0:15:08.49,Default,,0,0,0,,Пера! Пера Пера Пера Пера
Dialogue: 0,0:15:08.57,0:15:10.57,Default,,0,0,0,,Ей, эй, ей
Dialogue: 0,0:15:12.07,0:15:13.62,Default,,0,0,0,,Сені басып озғым келеді.
Dialogue: 0,0:15:13.70,0:15:15.53,Default,,0,0,0,,Ннн... Хмф!
Dialogue: 0,0:15:15.62,0:15:16.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:17.08,0:15:20.50,Default,,0,0,0,,Шетелдіктерге тамақ сияқты көрінбеуі мүмкін.
Dialogue: 0,0:15:20.58,0:15:22.00,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:15:22.08,0:15:24.00,Default,,0,0,0,,Жақсырақ құралдар бар ма?
Dialogue: 0,0:15:24.08,0:15:25.63,Default,,0,0,0,,Тамақ ішейік
Dialogue: 0,0:15:25.71,0:15:27.25,Default,,0,0,0,,Зуко!
Dialogue: 0,0:15:27.34,0:15:28.67,Default,,0,0,0,,Аму
Dialogue: 0,0:15:30.67,0:15:31.97,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:15:32.05,0:15:35.14,Default,,0,0,0,,О! Мен сенің не айтып тұрғаныңды түсінемін.
Dialogue: 0,0:15:35.22,0:15:38.64,Default,,0,0,0,,Бұл таңқаларлық емес пе? Дора-чан – болашақ робот.
Dialogue: 0,0:15:38.72,0:15:40.73,Default,,0,0,0,,Робот?
Dialogue: 0,0:15:40.81,0:15:43.19,Default,,0,0,0,,Сіз роботтар туралы білмейтініңізге сенімдісіз бе?
Dialogue: 0,0:15:43.27,0:15:46.48,Default,,0,0,0,,Бұл сиқыршы сияқты.
Dialogue: 0,0:15:46.57,0:15:48.11,Default,,0,0,0,,Сіз сиқыршысыз ба?
Dialogue: 0,0:15:48.19,0:15:50.40,Default,,0,0,0,,Хэхе~ Мен Дораемонмын!
Dialogue: 0,0:15:50.49,0:15:52.61,Default,,0,0,0,,Бұл Клэр!
Dialogue: 0,0:15:52.70,0:15:57.08,Default,,0,0,0,,Хаха, бұл сүйкімді есім. Менің атым Нобита.
Dialogue: 0,0:15:57.16,0:15:58.58,Default,,0,0,0,,Бұл ерекше атау.
Dialogue: 0,0:15:58.66,0:16:00.00,Default,,0,0,0,,Е...
Dialogue: 0,0:16:01.08,0:16:02.37,Default,,0,0,0,,Мен Джианмын
Dialogue: 0,0:16:02.46,0:16:03.42,Default,,0,0,0,,Мен Сунеомын!
Dialogue: 0,0:16:03.50,0:16:05.42,Default,,0,0,0,,Танысқаныма қуаныштымын, Шизука
Dialogue: 0,0:16:06.04,0:16:10.59,Default,,0,0,0,,Бәріңнің есімдерің, киімдерің біртүрлі екен.
Dialogue: 0,0:16:10.67,0:16:11.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.05,0:16:14.59,Default,,0,0,0,,Сізге плащ немесе басқа нәрсе кию керек.
Dialogue: 0,0:16:14.68,0:16:16.14,Default,,0,0,0,,Косплейдің қандай да бір түрі?
Dialogue: 0,0:16:16.22,0:16:19.47,Default,,0,0,0,,Хмм? Сіздің айтып отырғаныңыз қарапайым
Dialogue: 0,0:16:19.56,0:16:22.64,Default,,0,0,0,,Бұл ел қызық дүниелерге толы.
Dialogue: 0,0:16:22.73,0:16:26.02,Default,,0,0,0,,Негізі мен Нобита-кунмен суретке ертерек түскенмін.
Dialogue: 0,0:16:26.11,0:16:27.86,Default,,0,0,0,,Ол солардың бірі.
Dialogue: 0,0:16:27.94,0:16:30.07,Default,,0,0,0,,Бұл суреттен шықты ма?
Dialogue: 0,0:16:30.15,0:16:32.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:32.44,0:16:33.61,Default,,0,0,0,,Клэр-чан
Dialogue: 0,0:16:34.28,0:16:37.83,Default,,0,0,0,,Мөлдір қабырға бар ма? Бұл сіздің сиқырыңыз ба?
Dialogue: 0,0:16:37.91,0:16:40.49,Default,,0,0,0,,Жоқ, бұл басқаша...
Dialogue: 0,0:16:40.58,0:16:42.62,Default,,0,0,0,,Хмм, Дора деп айтпа.
Dialogue: 0,0:16:42.71,0:16:47.42,Default,,0,0,0,,Шын сиқыршы болсаң, тілегімді орында!
Dialogue: 0,0:16:47.50,0:16:48.38,Default,,0,0,0,,Қалайсыз ба?
Dialogue: 0,0:16:48.46,0:16:51.76,Default,,0,0,0,,Вараваны Артурия княздігіне апарғаныңызды қалаймын!
Dialogue: 0,0:16:52.38,0:16:53.88,Default,,0,0,0,,Артурия княздігі?
Dialogue: 0,0:16:53.97,0:16:57.47,Default,,0,0,0,,Мен бұл туралы ешқашан естіген емеспін. Бұл қайда?
Dialogue: 0,0:16:57.55,0:16:58.93,Default,,0,0,0,,Қай жерде десеңіз де...
Dialogue: 0,0:16:59.01,0:17:00.85,Default,,0,0,0,,Ал...
Dialogue: 0,0:17:00.93,0:17:02.18,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:17:02.77,0:17:06.81,Default,,0,0,0,,Артурия Артурия және...
Dialogue: 0,0:17:06.90,0:17:11.02,Default,,0,0,0,,Хмм, ол ел энциклопедияда жоқ.
Dialogue: 0,0:17:11.53,0:17:13.65,Default,,0,0,0,,Мен үйге барғым келеді
Dialogue: 0,0:17:14.19,0:17:16.91,Default,,0,0,0,,Осындай ойдан шығарылған ел адамдарының сахнасында.
Dialogue: 0,0:17:16.99,0:17:18.82,Default,,0,0,0,,Менің ойымша, бұл боялған сурет.
Dialogue: 0,0:17:18.91,0:17:20.62,Default,,0,0,0,,О, міне!
Dialogue: 0,0:17:21.83,0:17:25.58,Default,,0,0,0,,Бұл менің туған жерім, Артурия!
Dialogue: 0,0:17:26.37,0:17:27.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:27.62,0:17:30.46,Default,,0,0,0,,Бұл теледидарда көрсетілген танымал сурет!
Dialogue: 0,0:17:30.54,0:17:31.84,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:17:31.92,0:17:34.21,Default,,0,0,0,,Бұл жұмбақ көк түсті жасай алатын тас
Dialogue: 0,0:17:34.30,0:17:37.01,Default,,0,0,0,,Бұл гауһар тастардан да қымбат!
Dialogue: 0,0:17:37.09,0:17:38.51,Default,,0,0,0,,О!
Dialogue: 0,0:17:38.59,0:17:41.01,Default,,0,0,0,,Енді қызық болып барады!
Dialogue: 0,0:17:41.10,0:17:44.48,Default,,0,0,0,,Артурия қамалын іздейік!
Dialogue: 0,0:17:44.56,0:17:47.69,Default,,0,0,0,,- (Нобита) Мен үйдемін - кешіріңіз.
Dialogue: 0,0:17:47.77,0:17:49.69,Default,,0,0,0,,Аяқ киімді дұрыстап тігемін.
Dialogue: 0,0:17:49.77,0:17:50.90,Default,,0,0,0,,Бұрынғыдай әдемі
Dialogue: 0,0:17:50.98,0:17:55.11,Default,,0,0,0,,Бұл мүлдем оғаш әдет.
Dialogue: 0,0:17:55.19,0:17:56.57,Default,,0,0,0,,Сәлем Клэр
Dialogue: 0,0:17:56.65,0:18:00.12,Default,,0,0,0,,Бұл менің басыма неге түскенін білмейсің бе?
Dialogue: 0,0:18:00.20,0:18:02.58,Default,,0,0,0,,Мұны түсіну мүмкін емес.
Dialogue: 0,0:18:02.66,0:18:04.16,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:18:04.24,0:18:06.33,Default,,0,0,0,,Мұнда да тамаша сурет бар!
Dialogue: 0,0:18:06.41,0:18:08.04,Default,,0,0,0,,- (Сунео) Я~! -(Нобита) Уау!
Dialogue: 0,0:18:08.12,0:18:11.54,Default,,0,0,0,,-Бұл Кессаку! -(Нобита) Бұл жаман болды.
Dialogue: 0,0:18:11.63,0:18:13.71,Default,,0,0,0,,Кәне, бәріміз, кеттік.
Dialogue: 0,0:18:13.80,0:18:14.96,Default,,0,0,0,,Рельеф...
Dialogue: 0,0:18:16.59,0:18:18.38,Default,,0,0,0,,Енді кеттік...
Dialogue: 0,0:18:18.84,0:18:20.76,Default,,0,0,0,,Томбой
Dialogue: 0,0:18:21.85,0:18:26.85,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:18:27.81,0:18:31.94,Default,,0,0,0,,Жоқ, мен қамалды да, көлді де таба алмаймын.
Dialogue: 0,0:18:32.02,0:18:35.19,Default,,0,0,0,,Менің ойымша, ол басынан бері тартылмаған.
Dialogue: 0,0:18:35.28,0:18:37.57,Default,,0,0,0,,Бұл жоғалған орман.
Dialogue: 0,0:18:37.65,0:18:40.82,Default,,0,0,0,,Орманды араламасаң, қамалды таппайсың.
Dialogue: 0,0:18:40.91,0:18:42.66,Default,,0,0,0,,Бұл параметр...
Dialogue: 0,0:18:42.74,0:18:44.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:44.95,0:18:46.20,Default,,0,0,0,,Хмм?
Dialogue: 0,0:18:47.91,0:18:51.29,Default,,0,0,0,,Хмм... мм? Хмм?
Dialogue: 0,0:18:51.96,0:18:53.59,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:18:53.67,0:18:55.05,Default,,0,0,0,,Хмм... Гага...
Dialogue: 0,0:18:56.21,0:18:58.55,Default,,0,0,0,,Уау, Нобита-кун!
Dialogue: 0,0:18:58.63,0:19:01.55,Default,,0,0,0,,-Хехе...хехе! -Ах!
Dialogue: 0,0:19:01.64,0:19:03.51,Default,,0,0,0,,Чай Бұл тағы сенсің!
Dialogue: 0,0:19:03.60,0:19:05.60,Default,,0,0,0,,Маған құйрық беруді доғар!
Dialogue: 0,0:19:05.68,0:19:07.77,Default,,0,0,0,,Не? Жарғанат па?
Dialogue: 0,0:19:07.85,0:19:09.48,Default,,0,0,0,,Бұл жігіт Чай
Dialogue: 0,0:19:09.56,0:19:14.48,Default,,0,0,0,,Орманда адасып қалған адамдарды қорқытатын, мінезі нашар кішкентай шайтан.
Dialogue: 0,0:19:14.57,0:19:17.28,Default,,0,0,0,,Мінезі қандай шайтан.
Dialogue: 0,0:19:17.36,0:19:19.32,Default,,0,0,0,,Олардың болуы мүмкін емес.
Dialogue: 0,0:19:19.40,0:19:20.86,Default,,0,0,0,,Мен осы орманға келгенше
Dialogue: 0,0:19:20.95,0:19:23.91,Default,,0,0,0,,Мен шайтанды ырым деп ойладым.
Dialogue: 0,0:19:23.99,0:19:26.08,Default,,0,0,0,,Ол шынымен бар ма деп ойлаймын
Dialogue: 0,0:19:26.16,0:19:29.04,Default,,0,0,0,,Өйткені суретті салған адам сол ырымға сенген.
Dialogue: 0,0:19:29.12,0:19:31.21,Default,,0,0,0,,Мен оның шыққанына сенімдімін.
Dialogue: 0,0:19:31.29,0:19:32.92,Default,,0,0,0,,Әй, бұл қызық!
Dialogue: 0,0:19:33.00,0:19:34.79,Default,,0,0,0,,Суреттер жұмбақ.
Dialogue: 0,0:19:34.88,0:19:38.76,Default,,0,0,0,,Оны салған адамның жүрегіне үңілгендей.
Dialogue: 0,0:19:38.84,0:19:42.72,Default,,0,0,0,,Қызық, бұл суретті қандай адам салған?
Dialogue: 0,0:19:44.18,0:19:48.35,Default,,0,0,0,,Иә! Бүгін мен сізге жоғалған орманнан қалай құтылуға болатынын көрсетемін.
Dialogue: 0,0:19:48.43,0:19:51.56,Default,,0,0,0,,Муримури Түсінесіз бе?
Dialogue: 0,0:19:57.52,0:20:00.74,Default,,0,0,0,,Әй, Чайдың айтқаны емес пе?
Dialogue: 0,0:20:00.82,0:20:03.95,Default,,0,0,0,,Қалай жүрсең де орман
Dialogue: 0,0:20:04.03,0:20:06.95,Default,,0,0,0,,Мен қамалды да, көлді де көрмеймін.
Dialogue: 0,0:20:07.03,0:20:08.99,Default,,0,0,0,,Әлсіз дыбыс шығармаңыз
Dialogue: 0,0:20:09.08,0:20:12.92,Default,,0,0,0,,Егер мен абыржу орманынан құтыла алсам, мен сенімдімін ...
Dialogue: 0,0:20:13.00,0:20:14.54,Default,,0,0,0,,Не?
Dialogue: 0,0:20:14.63,0:20:16.38,Default,,0,0,0,,Бұдан былай...
Dialogue: 0,0:20:17.00,0:20:18.92,Default,,0,0,0,,Ештеңе!
Dialogue: 0,0:20:21.42,0:20:23.55,Default,,0,0,0,,Суреттің жиегін айтасыз ба?
Dialogue: 0,0:20:23.63,0:20:25.76,Default,,0,0,0,,Шеттері бар ма?
Dialogue: 0,0:20:25.84,0:20:29.31,Default,,0,0,0,,Менің ойымша, бұл сурет салған адамның қиялының шеті ғана.
Dialogue: 0,0:20:29.39,0:20:30.85,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:20:30.93,0:20:33.19,Default,,0,0,0,,Мен саған Жоғалған орманнан шыға алмайтыныңды айттым.
Dialogue: 0,0:20:33.27,0:20:37.27,Default,,0,0,0,,Бұл тым қатты, Чай! Мен сені төңкеріп айқышқа шегемін!
Dialogue: 0,0:20:37.36,0:20:40.98,Default,,0,0,0,,Иә! Мен төңкерілгенді жақсы көремін
Dialogue: 0,0:20:41.07,0:20:43.20,Default,,0,0,0,,Коу! Дора!
Dialogue: 0,0:20:43.28,0:20:46.11,Default,,0,0,0,,Сіздің кезегіңіз! Орман арқылы өтудің сиқыры!
Dialogue: 0,0:20:46.20,0:20:47.95,Default,,0,0,0,,Уф, уф… Бізді кім қуып келеді?
Dialogue: 0,0:20:48.03,0:20:49.79,Default,,0,0,0,,Енді не болды, Дора?
Dialogue: 0,0:20:49.87,0:20:52.58,Default,,0,0,0,,Жоқ, яғни…
Dialogue: 0,0:20:52.66,0:20:54.12,Default,,0,0,0,,Қазір!
Dialogue: 0,0:20:54.21,0:20:58.09,Default,,0,0,0,,Жоғалып кетті... Бұл таңғажайып сиқыр!
Dialogue: 0,0:20:58.17,0:21:00.13,Default,,0,0,0,,Итататата...
Dialogue: 0,0:21:01.38,0:21:03.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:04.01,0:21:06.13,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:06.68,0:21:09.05,Default,,0,0,0,,Баршаңызға~!
Dialogue: 0,0:21:09.14,0:21:11.68,Default,,0,0,0,,Мұнда кел, тез кел.
Dialogue: 0,0:21:13.14,0:21:14.10,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:14.18,0:21:15.98,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:18.11,0:21:19.15,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:19.23,0:21:21.27,Default,,0,0,0,,-Йоишо-(Сунео) Фууватто
Dialogue: 0,0:21:21.36,0:21:22.44,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:21:23.40,0:21:24.40,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:21:25.49,0:21:28.16,Default,,0,0,0,,-Арх! - Дааа!
Dialogue: 0,0:21:28.24,0:21:30.62,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:21:37.00,0:21:38.88,Default,,0,0,0,,Дәл сол сурет сияқты!
Dialogue: 0,0:21:38.96,0:21:41.04,Default,,0,0,0,,Сонда бұл жерде ме?
Dialogue: 0,0:21:41.13,0:21:43.59,Default,,0,0,0,,Бұл сөзсіз Артурия сарайы!
Dialogue: 0,0:21:43.67,0:21:46.38,Default,,0,0,0,,(Қуаныш дауысы)
Dialogue: 0,0:21:46.47,0:21:51.85,Default,,0,0,0,,Дора Жоғалған орманнан шығатын жолды табу үшін таңғажайып сиқыршы болуы керек.
Dialogue: 0,0:21:51.93,0:21:54.35,Default,,0,0,0,,Дора, күткендей!
Dialogue: 0,0:21:54.81,0:21:55.93,Default,,0,0,0,,Сунео
Dialogue: 0,0:21:56.02,0:21:59.60,Default,,0,0,0,,Бұл жерде көптеген елес зергерлік бұйымдар бар, солай емес пе?
Dialogue: 0,0:21:59.69,0:22:00.94,Default,,0,0,0,,Гуфуфуфуфу
Dialogue: 0,0:22:01.02,0:22:02.65,Default,,0,0,0,,Эй мынау...
Dialogue: 0,0:22:02.73,0:22:06.45,Default,,0,0,0,,Менің басыма түскен суреттің екінші жартысы емес пе?
Dialogue: 0,0:22:06.53,0:22:08.24,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:22:08.32,0:22:10.12,Default,,0,0,0,,Нобита-кунның бөлмесіндегі суретте
Dialogue: 0,0:22:10.20,0:22:12.66,Default,,0,0,0,,Сіз «Кіру жарығына» соқтыңыз, солай ма?
Dialogue: 0,0:22:12.74,0:22:13.79,Default,,0,0,0,,Әсері
Dialogue: 0,0:22:13.87,0:22:17.46,Default,,0,0,0,,Ол бастапқыда бір бөлік болды, бірақ екінші жартысында да пайда болды.
Dialogue: 0,0:22:18.46,0:22:20.08,Default,,0,0,0,,Сонымен Нобита-кунның бөлмесінен
Dialogue: 0,0:22:20.17,0:22:21.46,Default,,0,0,0,,Сурет арқылы
Dialogue: 0,0:22:21.54,0:22:22.79,Default,,0,0,0,,Басқа есіктен
Dialogue: 0,0:22:22.88,0:22:24.63,Default,,0,0,0,,Ол шықты.
Dialogue: 0,0:22:24.71,0:22:27.51,Default,,0,0,0,,Бірақ оның сол суреттен шыққаны мынаны білдіреді
Dialogue: 0,0:22:27.59,0:22:30.26,Default,,0,0,0,,Бұл шынайы әлем, солай ма?
Dialogue: 0,0:22:30.34,0:22:34.35,Default,,0,0,0,,Неліктен бұл нағыз ел энциклопедияда көрсетілмеген?
Dialogue: 0,0:22:34.43,0:22:38.48,Default,,0,0,0,,Кноссос сарайы мен Троя патшалығы сияқты болуы мүмкін.
Dialogue: 0,0:22:38.56,0:22:42.19,Default,,0,0,0,,Тарихтан адасып кеткен ел емес пе?
Dialogue: 0,0:22:42.27,0:22:45.40,Default,,0,0,0,,Не? Бұл баяғыда келді дегенді білдіре ме?
Dialogue: 0,0:22:45.48,0:22:48.24,Default,,0,0,0,,Жоқ! Бұлай болмауы керек...
Dialogue: 0,0:22:50.45,0:22:54.12,Default,,0,0,0,,Бұл оңтүстік-шығыс Еуропа болса керек...
Dialogue: 0,0:22:54.20,0:22:56.83,Default,,0,0,0,,Не? 13 ғасыр?
Dialogue: 0,0:22:56.91,0:22:58.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:58.29,0:23:00.12,Default,,0,0,0,,Жаңалықтарда айтқандай!
Dialogue: 0,0:23:00.21,0:23:03.88,Default,,0,0,0,,Керемет! Қалаға барайық!
Dialogue: 0,0:23:04.63,0:23:07.21,Default,,0,0,0,,Бір минут күтіңіз~
Dialogue: 0,0:23:11.84,0:23:16.85,Default,,0,0,0,,(Сыңғырлаған қоңырау дыбысы)
Dialogue: 0,0:23:20.44,0:23:22.94,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:23:23.02,0:23:27.65,Default,,0,0,0,,Керемет! Ертегідегі қала сияқты
Dialogue: 0,0:23:27.73,0:23:30.20,Default,,0,0,0,,Бұл ностальгиялық.
Dialogue: 0,0:23:30.28,0:23:31.74,Default,,0,0,0,,Мен «кіретін жарық» болады деп күтпедім.
Dialogue: 0,0:23:31.82,0:23:35.12,Default,,0,0,0,,Уақытты кері қайтару...
Dialogue: 0,0:23:35.20,0:23:38.25,Default,,0,0,0,,Бірақ бұл жағдайда Клэр нағыз Артуриядан.
Dialogue: 0,0:23:38.33,0:23:41.50,Default,,0,0,0,,Суретте адасу мүмкіндігі де пайда болды.
Dialogue: 0,0:23:41.58,0:23:43.46,Default,,0,0,0,,- (Адам) Уа... - (Нобита) Түсіндім.
Dialogue: 0,0:23:43.54,0:23:45.21,Default,,0,0,0,,-Мм? -(Нобита) А?
Dialogue: 0,0:23:45.29,0:23:46.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:47.67,0:23:48.92,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:23:49.01,0:23:51.38,Default,,0,0,0,,Хахаха... үшін, мұнда келіңдер!
Dialogue: 0,0:23:51.47,0:23:54.34,Default,,0,0,0,,Әй... Әй, кенет не болды?
Dialogue: 0,0:23:54.43,0:23:56.64,Default,,0,0,0,,Міне! А... мынау!
Dialogue: 0,0:23:56.72,0:23:58.31,Default,,0,0,0,,«Кисекае камерасы»!
Dialogue: 0,0:23:58.39,0:24:02.64,Default,,0,0,0,,Ах! Сол үшін маған қадала қарадың.
Dialogue: 0,0:24:02.73,0:24:04.10,Default,,0,0,0,,Кеттік~
Dialogue: 0,0:24:04.19,0:24:05.90,Default,,0,0,0,,Иә, ірімшік!
Dialogue: 0,0:24:05.98,0:24:07.32,Default,,0,0,0,,(ысырма дыбысы)
Dialogue: 0,0:24:07.40,0:24:10.78,Default,,0,0,0,,- (Нобита) Уау... - Бұл керемет сиқыр!
Dialogue: 0,0:24:10.86,0:24:12.61,Default,,0,0,0,,(ысырма дыбысы)
Dialogue: 0,0:24:12.70,0:24:14.11,Default,,0,0,0,,(ысырма дыбысы)
Dialogue: 0,0:24:14.20,0:24:15.62,Default,,0,0,0,,(ысырма дыбысы)
Dialogue: 0,0:24:15.70,0:24:16.99,Default,,0,0,0,,(ысырма дыбысы)
Dialogue: 0,0:24:30.67,0:24:32.63,Default,,0,0,0,,(мүйіз дыбысы)
Dialogue: 0,0:24:32.72,0:24:34.59,Default,,0,0,0,,Жақсы, мен оны сатып алдым! Мен оны сатып алдым!
Dialogue: 0,0:24:35.30,0:24:36.85,Default,,0,0,0,,Бұл жаңа!
Dialogue: 0,0:24:36.93,0:24:38.05,Default,,0,0,0,,Арзан!
Dialogue: 0,0:24:38.14,0:24:39.51,Default,,0,0,0,,Гугга~
Dialogue: 0,0:24:39.60,0:24:42.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:43.31,0:24:45.90,Default,,0,0,0,,Бүгін базар күні ме?
Dialogue: 0,0:24:46.77,0:24:49.44,Default,,0,0,0,,Еттен жасалған пирог пен шарап! Бұл дәмді
Dialogue: 0,0:24:49.52,0:24:52.15,Default,,0,0,0,,Ірімшік жұмыртқасы Зәйтүн майы!
Dialogue: 0,0:24:52.24,0:24:55.16,Default,,0,0,0,,Майшабақ лосось балығы!
Dialogue: 0,0:24:55.24,0:24:57.66,Default,,0,0,0,,Қуыстарды алып тастаңыз, ол ауырмайды.
Dialogue: 0,0:24:57.74,0:24:59.24,Default,,0,0,0,,Жақсы... бұл өте жақсы!
Dialogue: 0,0:24:59.33,0:25:01.87,Default,,0,0,0,,Бәрі де мүмкін.
Dialogue: 0,0:25:01.95,0:25:05.08,Default,,0,0,0,,Тіпті мүсіндер мен картиналар сататын дүкен де бар.
Dialogue: 0,0:25:05.17,0:25:07.63,Default,,0,0,0,,Бұл басқа елдерде болуы екіталай.
Dialogue: 0,0:25:07.71,0:25:11.96,Default,,0,0,0,,Артурия өнер қаласы ретінде танымал.
Dialogue: 0,0:25:12.05,0:25:15.05,Default,,0,0,0,,Сора! Хаха қалай!
Dialogue: 0,0:25:15.13,0:25:18.68,Default,,0,0,0,,Тоттотто... Тоттотто! Қараңыз, қараңыз
Dialogue: 0,0:25:19.97,0:25:22.77,Default,,0,0,0,,Уф, тамағым кепті...
Dialogue: 0,0:25:27.56,0:25:29.36,Default,,0,0,0,,Бухихин!
Dialogue: 0,0:25:29.44,0:25:32.03,Default,,0,0,0,,Уау, фонтан бар!
Dialogue: 0,0:25:32.11,0:25:33.82,Default,,0,0,0,,Бұл құдай ма?
Dialogue: 0,0:25:33.90,0:25:36.03,Default,,0,0,0,,Иә, бұл Артурияны қорғаңыз—
Dialogue: 0,0:25:36.11,0:25:37.78,Default,,0,0,0,,Өнер құдайы
Dialogue: 0,0:25:37.86,0:25:39.70,Default,,0,0,0,,Тілек айтып, тілек айтсаң
Dialogue: 0,0:25:39.78,0:25:42.20,Default,,0,0,0,,Ол кез келген нәрсені жүзеге асыра алатын беделге ие.
Dialogue: 0,0:25:42.29,0:25:43.75,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:25:43.83,0:25:47.04,Default,,0,0,0,,Хехе, киім ауыстырар алдында қалтамға салып қойдым.
Dialogue: 0,0:25:47.12,0:25:48.96,Default,,0,0,0,,Ол дұрыс қалады.
Dialogue: 0,0:25:49.71,0:25:52.42,Default,,0,0,0,,Сіз елес қазынаны таба аласыз
Dialogue: 0,0:25:53.09,0:25:54.21,Default,,0,0,0,,Хмм
Dialogue: 0,0:25:54.71,0:25:56.55,Default,,0,0,0,,Бұл дөңгелек нәрсе не?
Dialogue: 0,0:25:56.63,0:25:58.89,Default,,0,0,0,,Бұл шоколад. Шоколад.
Dialogue: 0,0:25:58.97,0:26:01.55,Default,,0,0,0,,Шоколадты сүйреткіш?
Dialogue: 0,0:26:01.64,0:26:03.60,Default,,0,0,0,,Жарайды, онда шай алғыңыз келе ме? Сәлем
Dialogue: 0,0:26:03.68,0:26:05.02,Default,,0,0,0,,Ахх
Dialogue: 0,0:26:05.10,0:26:06.73,Default,,0,0,0,,Могумогумогу…
Dialogue: 0,0:26:07.31,0:26:11.31,Default,,0,0,0,,Бұл не? Бұл тозақ сияқты!
Dialogue: 0,0:26:11.40,0:26:13.19,Default,,0,0,0,,Маған көбірек беріңіз! Маған көбірек беріңіз!
Dialogue: 0,0:26:13.28,0:26:15.03,Default,,0,0,0,,- (Сунео) Жарайды, эй - Аа~
Dialogue: 0,0:26:15.65,0:26:16.86,Default,,0,0,0,,Әму!
Dialogue: 0,0:26:16.95,0:26:18.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:18.53,0:26:23.24,Default,,0,0,0,,Хмм, міне, солай! Дәмі жұмақ сияқты!
Dialogue: 0,0:26:23.33,0:26:25.91,Default,,0,0,0,,Сәлем! Қайтарыңыз!
Dialogue: 0,0:26:26.00,0:26:29.58,Default,,0,0,0,,Шоколадты сүйреткіш - ең жақсы!
Dialogue: 0,0:26:32.46,0:26:34.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:34.25,0:26:37.72,Default,,0,0,0,,(үшінның қуанышты дауыстары)
Dialogue: 0,0:26:40.26,0:26:43.43,Default,,0,0,0,,Қараңдар, қараңдар! Түсі басқаша көрінеді хаха
Dialogue: 0,0:26:43.51,0:26:44.81,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:26:44.89,0:26:47.23,Default,,0,0,0,,Бұл Клэрдің көзінің түсімен бірдей.
Dialogue: 0,0:26:47.31,0:26:48.56,Default,,0,0,0,,Бұл көк түс
Dialogue: 0,0:26:48.64,0:26:51.52,Default,,0,0,0,,Ол Артурия Көк деп аталады.
Dialogue: 0,0:26:51.60,0:26:53.86,Default,,0,0,0,,Артурия Көк!
Dialogue: 0,0:26:54.57,0:26:57.11,Default,,0,0,0,,Бұл жаңалықтардағы көк түс туралы.
Dialogue: 0,0:26:57.19,0:27:00.53,Default,,0,0,0,,Бұл елдің бір жерінде сол түсті шығаратын тас бар...
Dialogue: 0,0:27:00.61,0:27:02.95,Default,,0,0,0,,Гуфуфуфуфуфуфу
Dialogue: 0,0:27:03.03,0:27:05.58,Default,,0,0,0,,Эй Клэр, бұл не түтін?
Dialogue: 0,0:27:05.66,0:27:07.91,Default,,0,0,0,,О, бұл жанартаудың кесірінен.
Dialogue: 0,0:27:08.00,0:27:11.00,Default,,0,0,0,,Ол жер Джигокудани деп аталады.
Dialogue: 0,0:27:11.75,0:27:15.75,Default,,0,0,0,,Бұл Артурия көлі де баяғыда атқылау нәтижесінде пайда болған.
Dialogue: 0,0:27:15.84,0:27:18.88,Default,,0,0,0,,Я, атқылаудың салдарынан...
Dialogue: 0,0:27:18.97,0:27:20.13,Default,,0,0,0,,Уф!
Dialogue: 0,0:27:23.60,0:27:25.47,Default,,0,0,0,,Қызыл айдаһар...
Dialogue: 0,0:27:26.14,0:27:27.68,Default,,0,0,0,,Исере!
Dialogue: 0,0:27:29.39,0:27:31.06,Default,,0,0,0,,Клэр?
Dialogue: 0,0:27:31.81,0:27:33.23,Default,,0,0,0,,Не болды?
Dialogue: 0,0:27:34.65,0:27:36.69,Default,,0,0,0,,Эй, не болды, Армин? Өзіңді қолыңнан ал, иә? Эй!
Dialogue: 0,0:27:37.94,0:27:40.07,Default,,0,0,0,,Эй, жанартау бар.
Dialogue: 0,0:27:40.15,0:27:43.62,Default,,0,0,0,,Қызық, бұл жерде ыстық бұлақтар бар ма?
Dialogue: 0,0:27:43.70,0:27:46.99,Default,,0,0,0,,Ыстық бұлақ Каа, Шизука-чан сияқты.
Dialogue: 0,0:27:47.08,0:27:47.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:50.58,0:27:52.92,Default,,0,0,0,,-Мило! -иә?
Dialogue: 0,0:27:53.00,0:27:54.88,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:27:54.96,0:27:56.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:56.96,0:27:59.34,Default,,0,0,0,,А... Клэр?
Dialogue: 0,0:28:01.68,0:28:03.30,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:28:03.39,0:28:06.26,Default,,0,0,0,,Күтілгендей... Мило
Dialogue: 0,0:28:06.89,0:28:08.14,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:28:09.52,0:28:10.81,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:28:12.52,0:28:14.44,Default,,0,0,0,,- Тыныш! -Үлкен!
Dialogue: 0,0:28:15.23,0:28:19.36,Default,,0,0,0,,Бірақ бұл көздер міндетті түрде Клэрдікі.
Dialogue: 0,0:28:19.94,0:28:22.11,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:28:23.07,0:28:27.33,Default,,0,0,0,,Сіз заттарды іздемей-ақ жай ғана сурет салдыңыз ба?
Dialogue: 0,0:28:27.41,0:28:32.16,Default,,0,0,0,,Жоқ! Мен оны іздедім, бүкіл ел іздеді.
Dialogue: 0,0:28:32.75,0:28:35.29,Default,,0,0,0,,Төрт жыл бойы қайда болдың?
Dialogue: 0,0:28:35.38,0:28:37.75,Default,,0,0,0,,-4 жыл? -Аа...
Dialogue: 0,0:28:37.84,0:28:39.67,Default,,0,0,0,,Ал сендер ше?
Dialogue: 0,0:28:39.75,0:28:42.34,Default,,0,0,0,,Ол мені жоғалған орманнан алып шықты.
Dialogue: 0,0:28:42.42,0:28:45.72,Default,,0,0,0,,Сиқыршы Дора және оның достары
Dialogue: 0,0:28:45.80,0:28:47.80,Default,,0,0,0,,Балалар, Клэр
Dialogue: 0,0:28:47.89,0:28:49.43,Default,,0,0,0,,Жүр, осы жаққа кел.
Dialogue: 0,0:28:49.51,0:28:53.02,Default,,0,0,0,,Ішке кіріп асықпай сөйлесейік.
Dialogue: 0,0:28:54.48,0:28:57.40,Default,,0,0,0,,(Тауықтың айқайлауы)
Dialogue: 0,0:28:59.69,0:29:01.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:01.69,0:29:05.70,Default,,0,0,0,,Хмм... Клэр Артурия княздігінің ханшайымы ма?
Dialogue: 0,0:29:05.78,0:29:08.99,Default,,0,0,0,,Иә, бірақ... сен мұны айтпадың ба?
Dialogue: 0,0:29:09.08,0:29:10.66,Default,,0,0,0,,Мен саған айтпадым ба?
Dialogue: 0,0:29:10.74,0:29:12.58,Default,,0,0,0,,Мен тыңдамаймын!
Dialogue: 0,0:29:12.66,0:29:13.66,Default,,0,0,0,,Аха…
Dialogue: 0,0:29:13.75,0:29:16.37,Default,,0,0,0,,Ал, әкем
Dialogue: 0,0:29:16.46,0:29:19.50,Default,,0,0,0,,Өйткені ол Артурия сарайында үй суретшісі болған.
Dialogue: 0,0:29:19.59,0:29:23.84,Default,,0,0,0,,Клэр екеуміз кішкентай кезімізден бірге ойнайтынбыз.
Dialogue: 0,0:29:24.63,0:29:26.59,Default,,0,0,0,,Мило! Мило!
Dialogue: 0,0:29:26.68,0:29:28.80,Default,,0,0,0,,Клэр Қозғалма!
Dialogue: 0,0:29:28.89,0:29:30.18,Default,,0,0,0,,Боу!
Dialogue: 0,0:29:30.26,0:29:32.27,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:29:33.02,0:29:35.06,Default,,0,0,0,,Бірақ бір күні...
Dialogue: 0,0:29:36.64,0:29:38.61,Default,,0,0,0,,Клэр~!
Dialogue: 0,0:29:38.69,0:29:41.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:29:45.20,0:29:47.66,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:29:47.74,0:29:49.99,Default,,0,0,0,,Клэр~!
Dialogue: 0,0:29:52.08,0:29:53.41,Default,,0,0,0,,Ах
Dialogue: 0,0:29:55.66,0:29:58.54,Default,,0,0,0,,Клэр~!
Dialogue: 0,0:30:01.59,0:30:04.17,Default,,0,0,0,,Содан кейін Клэр кеңістік-уақыт залына барады...
Dialogue: 0,0:30:04.26,0:30:05.97,Default,,0,0,0,,Құлыптар мен көлдер
Dialogue: 0,0:30:06.05,0:30:09.39,Default,,0,0,0,,Бүкіл ел орманда да іздеуді жалғастырды.
Dialogue: 0,0:30:09.47,0:30:13.31,Default,,0,0,0,,Бірақ мен оны таба алмадым.
Dialogue: 0,0:30:13.39,0:30:15.52,Default,,0,0,0,,Қамалға келген көріпкел
Dialogue: 0,0:30:15.60,0:30:18.23,Default,,0,0,0,,Оны Исердің қарғысы деп атауға дейін барыңыз.
Dialogue: 0,0:30:18.31,0:30:19.77,Default,,0,0,0,,Isere?
Dialogue: 0,0:30:19.85,0:30:22.44,Default,,0,0,0,,Ол осы елдің аңызға айналған шайтаны.
Dialogue: 0,0:30:22.52,0:30:24.44,Default,,0,0,0,,Бір күні қайта тірілемін
Dialogue: 0,0:30:24.53,0:30:27.78,Default,,0,0,0,,Дүние жойылады деп қорқады.
Dialogue: 0,0:30:27.86,0:30:30.41,Default,,0,0,0,,Бірақ бұл ырым
Dialogue: 0,0:30:30.49,0:30:34.41,Default,,0,0,0,,Жұмбақ көріпкел де мен білмей ғайып болды.
Dialogue: 0,0:30:34.49,0:30:36.37,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:30:36.45,0:30:39.25,Default,,0,0,0,,Соңында Клэр табылмады.
Dialogue: 0,0:30:39.33,0:30:42.09,Default,,0,0,0,,Менің рухым кетіп қалған екен.
Dialogue: 0,0:30:42.17,0:30:45.00,Default,,0,0,0,,Бірақ неге бұл суретте болды?
Dialogue: 0,0:30:45.09,0:30:46.21,Default,,0,0,0,,Хмм.
Dialogue: 0,0:30:46.30,0:30:49.59,Default,,0,0,0,,Менің ойымша, Клэр уақытпен саяхаттаушы болды ма?
Dialogue: 0,0:30:49.68,0:30:50.55,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:30:50.64,0:30:53.76,Default,,0,0,0,,Уақыт құйынына түскен Клэр сияқты
Dialogue: 0,0:30:53.85,0:30:57.43,Default,,0,0,0,,Кейде кеңістік-уақыт залын аралайтын адамдар болады.
Dialogue: 0,0:30:57.52,0:31:00.90,Default,,0,0,0,,Уақыт өте келе кейбір адамдар басқа дәуірге ауысты.
Dialogue: 0,0:31:00.98,0:31:04.11,Default,,0,0,0,,Мұндай адамдарды уақытты жүргізуші деп атайды.
Dialogue: 0,0:31:04.19,0:31:05.11,Default,,0,0,0,,Я~
Dialogue: 0,0:31:05.19,0:31:07.74,Default,,0,0,0,,«Hai Irikomi Light» суреттің ішкі жағын шындықпен байланыстырады
Dialogue: 0,0:31:07.82,0:31:10.82,Default,,0,0,0,,Өйткені ол кеңістік-уақыт саңылаулары принципін қолданып байланыстыратын құрал.
Dialogue: 0,0:31:10.91,0:31:15.74,Default,,0,0,0,,Мүмкін Клэр кездейсоқ суретке түсіп қалған шығар.
Dialogue: 0,0:31:15.83,0:31:17.41,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:31:18.66,0:31:19.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:22.42,0:31:25.67,Default,,0,0,0,,- (Нобита) Бұл есіңде ме? -Мен түсінбеймін
Dialogue: 0,0:31:25.75,0:31:28.92,Default,,0,0,0,,Мен оянсам, мен адасқан орманда едім.
Dialogue: 0,0:31:29.01,0:31:30.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:31:30.26,0:31:33.80,Default,,0,0,0,,Мен патша мен патшайымның қайғысын сұрамадым.
Dialogue: 0,0:31:33.89,0:31:35.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:35.18,0:31:37.10,Default,,0,0,0,,Әкем Клэрдің суретін салды.
Dialogue: 0,0:31:37.18,0:31:40.48,Default,,0,0,0,,Мен оны жұбатуға тырыстым, бірақ...
Dialogue: 0,0:31:40.56,0:31:43.77,Default,,0,0,0,,Сонымен Милоның әкесіне не болды?
Dialogue: 0,0:31:43.86,0:31:46.52,Default,,0,0,0,,Менің әкем былтыр қайтыс болды.
Dialogue: 0,0:31:46.61,0:31:47.69,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:31:47.78,0:31:50.11,Default,,0,0,0,,Сонымен, сізді сарайдан қуып жіберді ме?
Dialogue: 0,0:31:50.19,0:31:52.24,Default,,0,0,0,,Неліктен тозығы жеткен дүкенде жүрсің?
Dialogue: 0,0:31:52.32,0:31:55.12,Default,,0,0,0,,Қарғыс атсын... Шүберек дүкені болғаны өте жаман болды.
Dialogue: 0,0:31:55.20,0:31:57.95,Default,,0,0,0,,Мен әлі сарайда тұрамын.
Dialogue: 0,0:31:58.04,0:31:59.08,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:31:59.16,0:32:02.83,Default,,0,0,0,,Бұл әкемнің екінші шеберханасы болатын.
Dialogue: 0,0:32:02.92,0:32:07.50,Default,,0,0,0,,Жұмыс арасында мен мұнда сурет салуды үйренуге келемін.
Dialogue: 0,0:32:07.59,0:32:11.17,Default,,0,0,0,,Эй, сен әлі сөйлеп тұрсың ба? Күн батады
Dialogue: 0,0:32:11.26,0:32:13.55,Default,,0,0,0,,Дұрыс, мен сарайға баруым керек.
Dialogue: 0,0:32:13.64,0:32:16.55,Default,,0,0,0,,Король мен патшайым шетелге саяхатқа шығады.
Dialogue: 0,0:32:16.64,0:32:18.72,Default,,0,0,0,,Не? Сіз алыстасыз ба?
Dialogue: 0,0:32:18.81,0:32:20.06,Default,,0,0,0,,Мен абдырап қалдым
Dialogue: 0,0:32:20.14,0:32:23.14,Default,,0,0,0,,Кешке үйге келмесем, анам уайымдайды.
Dialogue: 0,0:32:23.23,0:32:25.31,Default,,0,0,0,,Жарайды, бірақ, Клэр дұрыс айтады.
Dialogue: 0,0:32:25.40,0:32:28.36,Default,,0,0,0,,Ата-анаңды көре алмаймын ба деп уайымдамайсың ба?
Dialogue: 0,0:32:28.44,0:32:29.94,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:32:30.03,0:32:31.90,Default,,0,0,0,,Онда бәрібір.
Dialogue: 0,0:32:31.99,0:32:35.91,Default,,0,0,0,,Қайтып келгеннен кейін кеткен кезге оралу үшін «уақыт машинасын» пайдаланыңыз.
Dialogue: 0,0:32:35.99,0:32:37.49,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:37.58,0:32:39.49,Default,,0,0,0,,Олай болса, бұл үлкен мәселе болғандықтан.
Dialogue: 0,0:32:39.58,0:32:41.62,Default,,0,0,0,,Мен Милодан бір жақсылық сұрай аламын ба?
Dialogue: 0,0:32:41.70,0:32:43.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:44.50,0:32:46.29,Default,,0,0,0,,Уау... бұл керемет!
Dialogue: 0,0:32:46.38,0:32:49.05,Default,,0,0,0,,Сурет салу соншалықты оңай екеніне сене алар емеспін
Dialogue: 0,0:32:49.13,0:32:51.26,Default,,0,0,0,,Тек қағаз бен қарындаштар, солай ма?
Dialogue: 0,0:32:51.34,0:32:53.76,Default,,0,0,0,,Бұл дәуірде қағаз бағалы болды.
Dialogue: 0,0:32:53.84,0:32:55.68,Default,,0,0,0,,Қарындаштар әлі болған жоқ.
Dialogue: 0,0:32:55.76,0:32:57.22,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:32:57.30,0:32:59.39,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:33:00.01,0:33:02.85,Default,,0,0,0,,Уау, өте жақсы!
Dialogue: 0,0:33:03.60,0:33:05.98,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:33:06.06,0:33:08.65,Default,,0,0,0,,«Су құрылысын салу машинасы»!
Dialogue: 0,0:33:08.73,0:33:10.44,Default,,0,0,0,,Йотто!
Dialogue: 0,0:33:10.53,0:33:13.65,Default,,0,0,0,,Бұрынғы суретті сол жердегі тесікке салыңыз.
Dialogue: 0,0:33:13.74,0:33:16.70,Default,,0,0,0,,«Суды өңдеуге арналған фурикаке» үлкен бөтелкесін қойыңыз
Dialogue: 0,0:33:17.28,0:33:19.87,Default,,0,0,0,,Жоқ... не болады?
Dialogue: 0,0:33:19.95,0:33:20.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:21.74,0:33:23.37,Default,,0,0,0,,Чинкарахойт
Dialogue: 0,0:33:24.00,0:33:25.37,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:33:26.96,0:33:29.17,Default,,0,0,0,,Жоқ... не? Бұл не?
Dialogue: 0,0:33:29.84,0:33:31.63,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:33:34.13,0:33:36.34,Default,,0,0,0,,Иә
Dialogue: 0,0:33:38.14,0:33:40.60,Default,,0,0,0,,Дора – сиқырдың шебері.
Dialogue: 0,0:33:40.68,0:33:42.72,Default,,0,0,0,,Эхехехехе...
Dialogue: 0,0:33:44.31,0:33:45.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:47.81,0:33:50.40,Default,,0,0,0,,Керемет Уау!
Dialogue: 0,0:33:50.48,0:33:53.74,Default,,0,0,0,,Бірақ қабырғалардың мөлдірлігі сонша, мен өзімді еркін сезінбеймін.
Dialogue: 0,0:33:53.82,0:33:55.36,Default,,0,0,0,,Аяқтау...
Dialogue: 0,0:33:55.45,0:33:57.78,Default,,0,0,0,,«Суды өңдеуге арналған Фурикаке»!
Dialogue: 0,0:33:57.86,0:33:59.95,Default,,0,0,0,,Осыны себіңіз де, бояңыз.
Dialogue: 0,0:34:00.03,0:34:01.87,Default,,0,0,0,,- (Нобита) Онда бұл мен! - Күте тұрыңыз!
Dialogue: 0,0:34:01.95,0:34:05.54,Default,,0,0,0,,Ах, бұл «қайтадан тазартылған фурикаке»
Dialogue: 0,0:34:05.62,0:34:08.79,Default,,0,0,0,,Егер сіз мұны қолдансаңыз, бұл ғимарат бірден суға айналады.
Dialogue: 0,0:34:08.88,0:34:09.83,Default,,0,0,0,,Уф!
Dialogue: 0,0:34:09.92,0:34:12.00,Default,,0,0,0,,Мен түстерді бояймын
Dialogue: 0,0:34:12.09,0:34:15.01,Default,,0,0,0,,Әркім екінші қабаттан өз бөлмеңді таңда.
Dialogue: 0,0:34:15.09,0:34:17.09,Default,,0,0,0,,«Сурет беретін берет»!
Dialogue: 0,0:34:17.18,0:34:19.76,Default,,0,0,0,,Осының көмегімен сіз өзіңіздің сүйікті жиһазыңызды жасай аласыз.
Dialogue: 0,0:35:04.22,0:35:06.52,Default,,0,0,0,,- (Нобита) Уау! -Уау
Dialogue: 0,0:35:07.60,0:35:09.35,Default,,0,0,0,,«Қайнатылған фурикаке»!
Dialogue: 0,0:35:09.44,0:35:11.73,Default,,0,0,0,,- (Нобита) Сұмдық! - (Сунео) Тамшылаған су Жақсы адам!
Dialogue: 0,0:35:11.81,0:35:14.94,Default,,0,0,0,,Пинг-понг пампон!
Dialogue: 0,0:35:15.02,0:35:16.98,Default,,0,0,0,,Тамақ дайын
Dialogue: 0,0:35:17.07,0:35:19.78,Default,,0,0,0,,Шатырға шығыңыз.
Dialogue: 0,0:35:19.86,0:35:21.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:21.49,0:35:23.32,Default,,0,0,0,,Бұл Нагаши Сомен бе?
Dialogue: 0,0:35:23.41,0:35:24.74,Default,,0,0,0,,Пинг Донг!
Dialogue: 0,0:35:24.83,0:35:27.33,Default,,0,0,0,,Әрине, «тағамдық үстел сөресі» бар.
Dialogue: 0,0:35:27.41,0:35:29.00,Default,,0,0,0,,- Катсудон! -(Сунео) Стейк!
Dialogue: 0,0:35:29.08,0:35:30.87,Default,,0,0,0,,Құймақ!
Dialogue: 0,0:35:30.96,0:35:32.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:32.17,0:35:34.46,Default,,0,0,0,,Бұл түс сияқты сиқырлы!
Dialogue: 0,0:35:34.54,0:35:36.67,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:35:37.38,0:35:38.42,Default,,0,0,0,,Не!
Dialogue: 0,0:35:38.51,0:35:40.51,Default,,0,0,0,,-(Сунео) Жай... -Болды.
Dialogue: 0,0:35:40.59,0:35:42.80,Default,,0,0,0,,Сәлем! Иә...
Dialogue: 0,0:35:44.47,0:35:45.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:35:49.98,0:35:54.36,Default,,0,0,0,,Хмм, дәмді! Клэрді де жеме.
Dialogue: 0,0:35:54.44,0:35:57.90,Default,,0,0,0,,Мен... Мен ондай оғаш нәрселерді жемеймін.
Dialogue: 0,0:35:57.98,0:35:59.32,Default,,0,0,0,,Бұдан гөрі...
Dialogue: 0,0:35:59.40,0:36:03.57,Default,,0,0,0,,Шоколад қосылған француз тосты.
Dialogue: 0,0:36:03.66,0:36:04.70,Default,,0,0,0,,Әму!
Dialogue: 0,0:36:06.33,0:36:08.79,Default,,0,0,0,,Шоколадты сүйреткіш - ең жақсы!
Dialogue: 0,0:36:08.87,0:36:10.96,Default,,0,0,0,,Хехе, мынау да бар.
Dialogue: 0,0:36:11.04,0:36:12.79,Default,,0,0,0,,Шоколадты банан
Dialogue: 0,0:36:12.87,0:36:14.75,Default,,0,0,0,,Фу!
Dialogue: 0,0:36:14.83,0:36:16.29,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,0:36:16.38,0:36:19.05,Default,,0,0,0,,Джиан Сіз тым көп жеп жатырсыз!
Dialogue: 0,0:36:22.22,0:36:23.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:23.68,0:36:25.14,Default,,0,0,0,,Не болды?
Dialogue: 0,0:36:25.22,0:36:27.10,Default,,0,0,0,,Артурия көлі ұзақ уақыттан бері алғаш рет
Dialogue: 0,0:36:27.18,0:36:29.72,Default,,0,0,0,,Бұл өте әдемі емес...
Dialogue: 0,0:36:29.81,0:36:33.90,Default,,0,0,0,,Клэрдің көздері көлдің түсімен бірдей.
Dialogue: 0,0:36:33.98,0:36:35.90,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:36:36.86,0:36:40.40,Default,,0,0,0,,Мен осындай түстерді қалай аламын деп ойлаймын
Dialogue: 0,0:36:40.48,0:36:41.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:41.40,0:36:44.16,Default,,0,0,0,,Сіз осыған ұқсас нәрсені бұрын айттыңыз.
Dialogue: 0,0:36:44.24,0:36:46.49,Default,,0,0,0,,Шынымен бе? қашан?
Dialogue: 0,0:36:47.99,0:36:49.83,Default,,0,0,0,,-Мм -Ух...
Dialogue: 0,0:36:49.91,0:36:51.45,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:36:51.54,0:36:56.42,Default,,0,0,0,,Мен көк, жасыл, күлгін сияқты әртүрлі түстерді көре аламын.
Dialogue: 0,0:36:57.08,0:37:00.63,Default,,0,0,0,,Мен мұндай түсті қалай аламын деп ойлаймын...
Dialogue: 0,0:37:02.05,0:37:03.67,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:37:03.76,0:37:05.97,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:37:06.05,0:37:07.39,Default,,0,0,0,,Сіз мұны айттыңыз ба?
Dialogue: 0,0:37:07.47,0:37:10.47,Default,,0,0,0,,Бұрынғы ештеңе есімде жоқ.
Dialogue: 0,0:37:10.56,0:37:12.73,Default,,0,0,0,,Бұл көп уақыт бұрын болған жоқ.
Dialogue: 0,0:37:12.81,0:37:13.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:13.94,0:37:15.81,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:37:15.90,0:37:17.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:25.07,0:37:27.95,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:37:28.03,0:37:31.66,Default,,0,0,0,,(Клэрдің көңілді дауысы және тыныш ызылдағаны)
Dialogue: 0,0:37:31.74,0:37:35.04,Default,,0,0,0,,Эй, Клэр, бірге кірейік.
Dialogue: 0,0:37:35.12,0:37:37.12,Default,,0,0,0,,Мен ваннаны ұнатпаймын!
Dialogue: 0,0:37:38.00,0:37:40.09,Default,,0,0,0,,Мен оған сенбеймін…
Dialogue: 0,0:37:40.17,0:37:43.05,Default,,0,0,0,,Мм, қазына...
Dialogue: 0,0:37:43.13,0:37:46.51,Default,,0,0,0,,Гаа~ Гуо~
Dialogue: 0,0:37:46.59,0:37:48.97,Default,,0,0,0,,Аяя… Аяя…
Dialogue: 0,0:37:49.05,0:37:51.31,Default,,0,0,0,,(дәретхананың ағу дыбысы)
Dialogue: 0,0:37:51.39,0:37:53.35,Default,,0,0,0,,Я~
Dialogue: 0,0:37:55.77,0:37:59.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:11.16,0:38:13.62,Default,,0,0,0,,Мило, сен әлі ояндың ба?
Dialogue: 0,0:38:13.70,0:38:16.54,Default,,0,0,0,,Нобита: Мен сала бастадым, тоқтадым
Dialogue: 0,0:38:16.62,0:38:19.13,Default,,0,0,0,,Мен сурет салғым келеді...
Dialogue: 0,0:38:19.21,0:38:20.63,Default,,0,0,0,,Кіріңіз!
Dialogue: 0,0:38:20.71,0:38:21.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:38:26.55,0:38:28.80,Default,,0,0,0,,Уау~ Бұл Клэрдің суреті.
Dialogue: 0,0:38:28.88,0:38:30.47,Default,,0,0,0,,Иә
Dialogue: 0,0:38:30.55,0:38:33.35,Default,,0,0,0,,Бұл тамаша, Мило - данышпан.
Dialogue: 0,0:38:33.43,0:38:37.02,Default,,0,0,0,,Жарайды, менен артық адамдар көп.
Dialogue: 0,0:38:37.10,0:38:39.35,Default,,0,0,0,,Бірақ, әкем айтқандай,
Dialogue: 0,0:38:39.44,0:38:42.61,Default,,0,0,0,,Сіз сурет салуда жақсы ма, әлде нашар суретте ме, бәрібір.
Dialogue: 0,0:38:42.69,0:38:43.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:43.77,0:38:46.49,Default,,0,0,0,,Мен өзім ғана сала алатын сурет салғым келеді
Dialogue: 0,0:38:46.57,0:38:48.03,Default,,0,0,0,,Мен Тога. Тога Химико
Dialogue: 0,0:38:48.11,0:38:50.70,Default,,0,0,0,,Мен ғана сурет сала аламын...
Dialogue: 0,0:38:51.70,0:38:54.62,Default,,0,0,0,,Бұл бояу ма? Бұл түтік емес
Dialogue: 0,0:38:54.70,0:38:56.66,Default,,0,0,0,,Түтік дегеніміз не? сиқыр?
Dialogue: 0,0:38:56.75,0:38:59.17,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:39:06.46,0:39:08.67,Default,,0,0,0,,Жұмыртқа? Сен ашсың ба?
Dialogue: 0,0:39:08.76,0:39:11.30,Default,,0,0,0,,Хаха, бұл басқаша.
Dialogue: 0,0:39:12.34,0:39:13.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:15.18,0:39:18.35,Default,,0,0,0,,Иә? Жұмыртқаның сарысын қосу керек пе?
Dialogue: 0,0:39:18.43,0:39:21.85,Default,,0,0,0,,Дұрыс, мен сиқырды қолдана алмаймын.
Dialogue: 0,0:39:21.94,0:39:24.77,Default,,0,0,0,,Әдеттегідей түстерді жасау керек
Dialogue: 0,0:39:24.86,0:39:28.65,Default,,0,0,0,,Бұл қалыпты жағдай
Dialogue: 0,0:39:29.65,0:39:32.36,Default,,0,0,0,,Эй, сен әлі Клэрдің көзіне түс қоспайсың ба?
Dialogue: 0,0:39:34.16,0:39:35.12,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:39:35.20,0:39:37.75,Default,,0,0,0,,Не? Не? кешіріңіз!
Dialogue: 0,0:39:37.83,0:39:39.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:39:39.75,0:39:41.12,Default,,0,0,0,,Клэрдің көзі...
Dialogue: 0,0:39:41.21,0:39:43.96,Default,,0,0,0,,Артурия көкін шығаратын тас жоқ.
Dialogue: 0,0:39:44.04,0:39:45.50,Default,,0,0,0,,Бұл түс...
Dialogue: 0,0:39:45.59,0:39:50.17,Default,,0,0,0,,Артурия көк... Неше түрлі түстерге ұқсайтын көк?
Dialogue: 0,0:39:50.26,0:39:52.80,Default,,0,0,0,,Иә, Артурия Блу —
Dialogue: 0,0:39:52.89,0:39:56.76,Default,,0,0,0,,Бұл сарай суретшілерінің кейінгі ұрпақтарына ғана берілетін құпия көк.
Dialogue: 0,0:39:57.77,0:40:00.27,Default,,0,0,0,,Әкем бұл тас туралы білген.
Dialogue: 0,0:40:00.35,0:40:02.98,Default,,0,0,0,,Айтылмай қайтыс болды.
Dialogue: 0,0:40:03.52,0:40:08.15,Default,,0,0,0,,Мен сол көк түсті тапқым келеді
Dialogue: 0,0:40:08.23,0:40:11.49,Default,,0,0,0,,Мен осы ательенің жанында құпия ингредиент бар деп ойладым.
Dialogue: 0,0:40:11.57,0:40:13.45,Default,,0,0,0,,Мен әртүрлі заттарды іздедім.
Dialogue: 0,0:40:13.53,0:40:18.70,Default,,0,0,0,,Тек тастар ғана емес, ағаш қабығы, нағыз гүлдер, саз қабықтары да...
Dialogue: 0,0:40:18.79,0:40:23.50,Default,,0,0,0,,Мен жүздеген түрлі түстерді қолданып көрдім, бірақ ол түсті ала алмадым.
Dialogue: 0,0:40:24.88,0:40:27.04,Default,,0,0,0,,Бұл керемет, Мило.
Dialogue: 0,0:40:27.13,0:40:27.96,Default,,0,0,0,,А...?
Dialogue: 0,0:40:28.05,0:40:31.76,Default,,0,0,0,,Мен бұл қиын болуы мүмкін екеніне сене алмаймын.
Dialogue: 0,0:40:31.84,0:40:33.97,Default,,0,0,0,,Мен қызғаншақпын.
Dialogue: 0,0:40:34.05,0:40:36.01,Default,,0,0,0,,Мен... солай деп ойлаймын.
Dialogue: 0,0:40:36.10,0:40:40.72,Default,,0,0,0,,Ха, мен Мило сияқты сурет салсам екен.
Dialogue: 0,0:40:40.81,0:40:43.44,Default,,0,0,0,,Жақсы сурет салуға арналған кеңестеріңіз бар ма?
Dialogue: 0,0:40:43.52,0:40:46.65,Default,,0,0,0,,Нобита сурет салғанды ​​ұнатпайды ма?
Dialogue: 0,0:40:46.73,0:40:49.94,Default,,0,0,0,,Өйткені сен мүлде ақымақ болсаң да, адамдар саған күледі.
Dialogue: 0,0:40:50.03,0:40:53.03,Default,,0,0,0,,Хехе, сурет салуға кеңестер жоқ...
Dialogue: 0,0:40:53.11,0:40:54.16,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:40:54.86,0:40:56.20,Default,,0,0,0,,Сізге ұнайтын нәрсе
Dialogue: 0,0:40:56.28,0:41:00.12,Default,,0,0,0,,«Мен сені сүйемін» деп ойлай отырып, суретті салсаңыз болғаны.
Dialogue: 0,0:41:00.20,0:41:02.12,Default,,0,0,0,,Ммм
Dialogue: 0,0:41:02.20,0:41:05.58,Default,,0,0,0,,Сондықтан жақсы сурет сала алсаң, қиналмайды.
Dialogue: 0,0:41:05.67,0:41:09.34,Default,,0,0,0,,Сондықтан оны жақсылап салуға тырысудың қажеті жоқ.
Dialogue: 0,0:41:09.42,0:41:12.34,Default,,0,0,0,,Жақсы сурет жақсы сурет емес.
Dialogue: 0,0:41:12.42,0:41:15.22,Default,,0,0,0,,Сонымен, «жақсы сурет» дегеніміз не?
Dialogue: 0,0:41:15.30,0:41:16.76,Default,,0,0,0,,Хмф
Dialogue: 0,0:41:17.51,0:41:20.10,Default,,0,0,0,,Әйтеуір, жаман болсаң жақсы.
Dialogue: 0,0:41:20.18,0:41:23.18,Default,,0,0,0,,Менің сүйікті достарым, сүйікті отбасым, т.б.
Dialogue: 0,0:41:23.27,0:41:26.77,Default,,0,0,0,,Мен сені сүйемін деп суретті сал.
Dialogue: 0,0:41:27.48,0:41:28.98,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:41:31.78,0:41:33.36,Default,,0,0,0,,Ммм
Dialogue: 0,0:41:40.49,0:41:43.00,Default,,0,0,0,,(Тауықтың айқайлауы)
Dialogue: 0,0:41:43.95,0:41:46.58,Default,,0,0,0,,(Екі адам ұйықтап жатыр)
Dialogue: 0,0:41:46.67,0:41:48.67,Default,,0,0,0,,Оян!
Dialogue: 0,0:41:48.75,0:41:52.00,Default,,0,0,0,,Тез дайындал! Кеттік!
Dialogue: 0,0:41:52.09,0:41:54.34,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,0:42:00.72,0:42:02.68,Default,,0,0,0,,Жақсы уақыт.
Dialogue: 0,0:42:02.77,0:42:05.81,Default,,0,0,0,,Анам мен әкемнің тез үйге келетініне сене алар емеспін.
Dialogue: 0,0:42:05.89,0:42:08.77,Default,,0,0,0,,Мұның бәрі менің мықты жолымның арқасы.
Dialogue: 0,0:42:10.61,0:42:12.61,Default,,0,0,0,,А, досым.
Dialogue: 0,0:42:13.78,0:42:16.20,Default,,0,0,0,,Сәлем, досым!
Dialogue: 0,0:42:16.99,0:42:19.49,Default,,0,0,0,,Эй, бұл Мило.
Dialogue: 0,0:42:19.57,0:42:22.16,Default,,0,0,0,,Не болды? Бүгінде адамдар өте көп...
Dialogue: 0,0:42:22.24,0:42:23.08,Default,,0,0,0,,Ах
Dialogue: 0,0:42:25.62,0:42:27.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:27.58,0:42:29.71,Default,,0,0,0,,үшін, бұл Пал.
Dialogue: 0,0:42:29.79,0:42:32.67,Default,,0,0,0,,Суреттерді сататын және сатып алатын өнер дилері.
Dialogue: 0,0:42:32.75,0:42:35.92,Default,,0,0,0,,Ол менің салған суреттерімді ұнататын санаулы адамдардың бірі.
Dialogue: 0,0:42:36.01,0:42:39.22,Default,,0,0,0,,Иә, бұдан былай одан да өсесің.
Dialogue: 0,0:42:39.30,0:42:41.18,Default,,0,0,0,,Сіз көбірек сурет салуыңыз керек
Dialogue: 0,0:42:41.26,0:42:43.31,Default,,0,0,0,,Тек суреттерді тегін салыңыз
Dialogue: 0,0:42:43.39,0:42:44.68,Default,,0,0,0,,Менің басқа шаруам жоқ
Dialogue: 0,0:42:44.77,0:42:47.23,Default,,0,0,0,,Саған тағы сурет салуға рұқсат етсем, не істейсің?
Dialogue: 0,0:42:47.31,0:42:49.94,Default,,0,0,0,,Пэл Клэр ханшайым қайтып келді.
Dialogue: 0,0:42:50.02,0:42:53.36,Default,,0,0,0,,Не? Жан-дүниесі кетіп қалған ханшайым?
Dialogue: 0,0:42:53.44,0:42:55.11,Default,,0,0,0,,-Хмф! -Иә
Dialogue: 0,0:42:55.19,0:42:58.07,Default,,0,0,0,,Сіз қайтып келдіңіз, бұл керемет.
Dialogue: 0,0:42:58.15,0:43:00.41,Default,,0,0,0,,Бұл ғажайыптар еліндегі Алиса ма?
Dialogue: 0,0:43:00.49,0:43:01.82,Default,,0,0,0,,Хмф!
Dialogue: 0,0:43:01.91,0:43:03.53,Default,,0,0,0,,Сонымен... Олай болса, Мило.
Dialogue: 0,0:43:03.62,0:43:05.41,Default,,0,0,0,,Жаңа жұмысыңыз болса, маған қайта көрсетіңіз.
Dialogue: 0,0:43:05.49,0:43:07.54,Default,,0,0,0,,Керек емес сөздерді айтпа!
Dialogue: 0,0:43:07.62,0:43:09.96,Default,,0,0,0,,-Нннн...! -Ал... Жақында кездескенше.
Dialogue: 0,0:43:10.04,0:43:12.75,Default,,0,0,0,,-(Нобита) Не қызық? -Хмф!
Dialogue: 0,0:43:12.84,0:43:15.21,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:43:18.26,0:43:21.93,Default,,0,0,0,,- (Патша) О... - (Королева) Ха! Амал жоқ...
Dialogue: 0,0:43:22.72,0:43:25.10,Default,,0,0,0,,О... мүмкін емес
Dialogue: 0,0:43:25.85,0:43:27.77,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:43:27.85,0:43:28.81,Default,,0,0,0,,Баа!
Dialogue: 0,0:43:28.89,0:43:32.77,Default,,0,0,0,,- (Король/Королева) Клэр! -әке! ана!
Dialogue: 0,0:43:32.86,0:43:34.73,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:43:36.94,0:43:39.99,Default,,0,0,0,,- (Ханшайым) Сәттілік, аман болыңыз... - (Патша) О, мына көздер.
Dialogue: 0,0:43:40.07,0:43:42.99,Default,,0,0,0,,Бұл сөзсіз Клэр.
Dialogue: 0,0:43:44.28,0:43:48.83,Default,,0,0,0,,Неліктен ол төрт жыл бұрынғыдай болды?
Dialogue: 0,0:43:48.91,0:43:51.17,Default,,0,0,0,,А, бұл дегеніміз...
Dialogue: 0,0:43:51.25,0:43:53.46,Default,,0,0,0,,Жоғалған орманның сиқырымен бұл дүние қандай?
Dialogue: 0,0:43:53.54,0:43:57.96,Default,,0,0,0,,Уақыт ағымы басқаша болса ше?
Dialogue: 0,0:43:58.05,0:43:59.76,Default,,0,0,0,,Уақыт?
Dialogue: 0,0:43:59.84,0:44:01.63,Default,,0,0,0,,Мило Бұл адамдар кімдер?
Dialogue: 0,0:44:01.72,0:44:05.35,Default,,0,0,0,,Ұлы сиқыршы Дораемон және оның достары
Dialogue: 0,0:44:05.43,0:44:08.60,Default,,0,0,0,,Бұл Клэрге көмектескен адамдар.
Dialogue: 0,0:44:08.68,0:44:12.31,Default,,0,0,0,,Жақсы! Қалай рахмет айта аламын?
Dialogue: 0,0:44:12.39,0:44:14.10,Default,,0,0,0,,Жоқ, солай.
Dialogue: 0,0:44:14.19,0:44:16.19,Default,,0,0,0,,Мен жай ғана өтіп бара жатырмын.
Dialogue: 0,0:44:16.27,0:44:18.73,Default,,0,0,0,,Бірақ сыйлығыңызды ұмытпаңыз.
Dialogue: 0,0:44:18.82,0:44:19.99,Default,,0,0,0,,~ емес
Dialogue: 0,0:44:20.07,0:44:21.28,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:44:21.36,0:44:22.91,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:44:22.99,0:44:25.41,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:44:25.49,0:44:26.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:26.49,0:44:28.83,Default,,0,0,0,,(үшінның ішінің шуылдаған дыбысы)
Dialogue: 0,0:44:29.54,0:44:31.00,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:44:31.08,0:44:33.96,Default,,0,0,0,,Тезірек тойлайтын жерді дайындап алайық.
Dialogue: 0,0:44:34.04,0:44:35.67,Default,,0,0,0,,Иә!
Dialogue: 0,0:44:35.75,0:44:38.46,Default,,0,0,0,,Эй, бұл мереке, Клэр!
Dialogue: 0,0:44:38.55,0:44:40.01,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:44:40.09,0:44:42.17,Default,,0,0,0,,Ей, шайтан... Жақсы!
Dialogue: 0,0:44:42.26,0:44:44.89,Default,,0,0,0,,Бұл жігіт жай ғана жарғанат.
Dialogue: 0,0:44:44.97,0:44:46.35,Default,,0,0,0,,Хмм…
Dialogue: 0,0:44:46.43,0:44:49.31,Default,,0,0,0,,Сәлем Содоро
Dialogue: 0,0:44:49.39,0:44:52.69,Default,,0,0,0,,Иә, мен Содородамын.
Dialogue: 0,0:44:52.77,0:44:55.27,Default,,0,0,0,,Лайлы шыбын... Баа
Dialogue: 0,0:44:55.35,0:44:57.82,Default,,0,0,0,,Оларды галереяның айналасында көрсетіңіз.
Dialogue: 0,0:44:57.90,0:45:00.23,Default,,0,0,0,,Ән дайын болғанша
Dialogue: 0,0:45:00.32,0:45:02.24,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:45:02.32,0:45:04.70,Default,,0,0,0,,Содоро? Бұл бейтаныс бет
Dialogue: 0,0:45:04.78,0:45:07.12,Default,,0,0,0,,О? Клэр ханшайым?
Dialogue: 0,0:45:07.20,0:45:09.91,Default,,0,0,0,,Сіз Исердің қарғысынан құтылдыңыз ба?
Dialogue: 0,0:45:09.99,0:45:11.04,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:45:11.12,0:45:12.75,Default,,0,0,0,,Исер маңызды емес!
Dialogue: 0,0:45:12.83,0:45:14.79,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:45:14.87,0:45:15.71,Default,,0,0,0,,Қазір!
Dialogue: 0,0:45:16.96,0:45:18.42,Default,,0,0,0,,Хахаха
Dialogue: 0,0:45:18.50,0:45:20.96,Default,,0,0,0,,Ми... үшінн күлдірту үшін
Dialogue: 0,0:45:21.05,0:45:23.38,Default,,0,0,0,,Мен «әдейі» құладым
Dialogue: 0,0:45:23.47,0:45:26.39,Default,,0,0,0,,Ол сүйкімді және сүйкімді жігіт хахаха
Dialogue: 0,0:45:27.01,0:45:29.93,Default,,0,0,0,,Сәлем бәріңе, осында келіңдер.
Dialogue: 0,0:45:32.85,0:45:35.06,Default,,0,0,0,,Патшаның мақтанышы осы.
Dialogue: 0,0:45:35.14,0:45:39.06,Default,,0,0,0,,Бұл Артур кескіндемесінің қазынасы.
Dialogue: 0,0:45:39.15,0:45:41.82,Default,,0,0,0,,Тарихи патшалар, мифтер, аңыздар, т.б.
Dialogue: 0,0:45:41.90,0:45:44.57,Default,,0,0,0,,Бұл мен салған сурет Иә.
Dialogue: 0,0:45:44.65,0:45:46.91,Default,,0,0,0,,Бұл жерде қазына туралы аңыз да бар.
Dialogue: 0,0:45:46.99,0:45:48.41,Default,,0,0,0,,Ол сызылған ба?
Dialogue: 0,0:45:48.49,0:45:49.87,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:45:49.95,0:45:51.03,Default,,0,0,0,,Мүмкін бар шығар.
Dialogue: 0,0:45:51.62,0:45:53.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:55.75,0:45:56.71,Default,,0,0,0,,Бұл...
Dialogue: 0,0:46:00.50,0:46:02.92,Default,,0,0,0,,Артурияның ескі аңыздары
Dialogue: 0,0:46:03.01,0:46:06.51,Default,,0,0,0,,Оны ескі сарай суретшісі салған.
Dialogue: 0,0:46:06.59,0:46:09.14,Default,,0,0,0,,Ортадағы шайтан – Исере.
Dialogue: 0,0:46:09.22,0:46:11.39,Default,,0,0,0,,Isere? Бұл...
Dialogue: 0,0:46:12.31,0:46:13.47,Default,,0,0,0,,«Жарықты алып тастаңыз...»
Dialogue: 0,0:46:13.56,0:46:16.94,Default,,0,0,0,,«Тіпті қараңғылықты өшіретін қара рыцарь Исере»
Dialogue: 0,0:46:17.02,0:46:21.90,Default,,0,0,0,,«Ол пайда болғанда, қызыл айдаһар қанаттарын қағып, әлем суға батады».
Dialogue: 0,0:46:21.98,0:46:24.86,Default,,0,0,0,,«Бірақ көк жарқанат қанаттарын қағады»
Dialogue: 0,0:46:24.94,0:46:27.91,Default,,0,0,0,,«Ұлы рақым келеді»
Dialogue: 0,0:46:35.95,0:46:38.46,Default,,0,0,0,,«Үлкен рақым» мүмкін...
Dialogue: 0,0:46:38.54,0:46:41.00,Default,,0,0,0,,Оның үстіне ол көк...
Dialogue: 0,0:46:41.08,0:46:43.13,Default,,0,0,0,,О та ка ла
Dialogue: 0,0:46:43.21,0:46:44.17,Default,,0,0,0,,Қазір!
Dialogue: 0,0:46:45.63,0:46:46.88,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:46:46.97,0:46:48.84,Default,,0,0,0,,Ағай, сіз жиі ажырайсыз.
Dialogue: 0,0:46:48.93,0:46:50.22,Default,,0,0,0,,Сонымен... дұрыс.
Dialogue: 0,0:46:50.30,0:46:53.72,Default,,0,0,0,,Жасыңыз 40-тан асқанда, сіз көбіне далада күйзеліске ұшырайсыз...
Dialogue: 0,0:46:53.81,0:46:55.81,Default,,0,0,0,,дегенді қалай түсінесіңдер?
Dialogue: 0,0:46:55.89,0:46:58.35,Default,,0,0,0,,Мен мұны әдейі күлу үшін жасадым!
Dialogue: 0,0:46:58.44,0:47:00.23,Default,,0,0,0,,Аха ахах...
Dialogue: 0,0:47:00.31,0:47:02.27,Default,,0,0,0,,Иә? Қайтадан азайып барады
Dialogue: 0,0:47:02.36,0:47:06.49,Default,,0,0,0,,Әй, бұл күндері сурет ұрылары тағы да аңдып жүр.
Dialogue: 0,0:47:06.57,0:47:08.24,Default,,0,0,0,,Сурет ұры?
Dialogue: 0,0:47:09.11,0:47:11.49,Default,,0,0,0,,-Жақсы - (Нобита) Не болды?
Dialogue: 0,0:47:11.57,0:47:15.83,Default,,0,0,0,,Бұл менің әкем салған Артурия. Ол ұрланған жоқ.
Dialogue: 0,0:47:17.00,0:47:19.29,Default,,0,0,0,,Бұл газетке шыққан сурет.
Dialogue: 0,0:47:19.37,0:47:22.71,Default,,0,0,0,,Иә, Артурия Блу.
Dialogue: 0,0:47:25.25,0:47:29.22,Default,,0,0,0,,(Труба және көше әртістері)
Dialogue: 0,0:47:32.18,0:47:36.06,Default,,0,0,0,,Кәне, бәріміз, көңіл көтеріңдер.
Dialogue: 0,0:47:36.14,0:47:38.56,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:47:38.64,0:47:42.86,Default,,0,0,0,,Иә? Пышақтар мен шанышқылар... Ах!
Dialogue: 0,0:47:44.61,0:47:46.32,Default,,0,0,0,,Қолмен тамақ ішу...
Dialogue: 0,0:47:46.40,0:47:49.49,Default,,0,0,0,,Өйткені бұл 13 ғасыр Аму!
Dialogue: 0,0:47:49.57,0:47:51.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:52.45,0:47:53.82,Default,,0,0,0,,Аму
Dialogue: 0,0:47:53.91,0:47:56.12,Default,,0,0,0,,Хмм, мен мұны істей аламын!
Dialogue: 0,0:47:56.20,0:47:57.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:47:57.54,0:48:00.91,Default,,0,0,0,,(Клэрдің күлуі)
Dialogue: 0,0:48:01.00,0:48:04.75,Default,,0,0,0,,Клэрді қайтарғаныңыз үшін көп рахмет.
Dialogue: 0,0:48:04.84,0:48:07.17,Default,,0,0,0,,Бата әкелетін көк жарқанат қандай?
Dialogue: 0,0:48:07.25,0:48:09.42,Default,,0,0,0,,Бұл сіз туралы болуы мүмкін.
Dialogue: 0,0:48:09.51,0:48:11.34,Default,,0,0,0,,Дораэмон көк түсті
Dialogue: 0,0:48:11.43,0:48:13.64,Default,,0,0,0,,Бұл жарқанат емес, ол енот ит.
Dialogue: 0,0:48:13.72,0:48:16.10,Default,,0,0,0,,Мен енот ит емеспін!
Dialogue: 0,0:48:16.18,0:48:19.56,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:48:23.81,0:48:26.52,Default,,0,0,0,,Жо... Жылы...
Dialogue: 0,0:48:26.61,0:48:29.03,Default,,0,0,0,,-Гах- (Нобита) Мен мұндамын...
Dialogue: 0,0:48:29.99,0:48:31.32,Default,,0,0,0,,Енді «уақыт машинасында»
Dialogue: 0,0:48:31.40,0:48:33.49,Default,,0,0,0,,Біз кеткен күнге оралайық
Dialogue: 0,0:48:33.57,0:48:36.83,Default,,0,0,0,,Ах! Мен фантомды зергерлік бұйымдарды іздеуді ұмытып кеттім!
Dialogue: 0,0:48:36.91,0:48:40.33,Default,,0,0,0,,-Ах! -(Нобита және т.б.) Ахахха
Dialogue: 0,0:48:42.33,0:48:45.75,Default,,0,0,0,,Шығарыңыз! Мені бұл жерден кетіріңіз!
Dialogue: 0,0:48:45.83,0:48:48.67,Default,,0,0,0,,Әке, ана…
Dialogue: 0,0:48:50.76,0:48:51.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:48:54.68,0:48:56.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:56.72,0:48:57.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:48:59.10,0:49:02.23,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:49:06.02,0:49:08.69,Default,,0,0,0,,Иә? Сіз алыстасыз ба?
Dialogue: 0,0:49:08.77,0:49:11.28,Default,,0,0,0,,Сіз уәде бердіңіз.
Dialogue: 0,0:49:11.36,0:49:13.65,Default,,0,0,0,,Бұл жағдайда бөлмеңізде күтіңіз.
Dialogue: 0,0:49:13.74,0:49:15.07,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:49:15.16,0:49:16.66,Default,,0,0,0,,Оджамашимасу
Dialogue: 0,0:49:16.74,0:49:18.91,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:49:20.66,0:49:22.75,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:49:22.83,0:49:25.67,Default,,0,0,0,,Ах, Такеши-сан мен Сунео-сан сені күтіп отыр.
Dialogue: 0,0:49:25.75,0:49:27.38,Default,,0,0,0,,Не? шын?
Dialogue: 0,0:49:30.50,0:49:31.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:32.55,0:49:33.80,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:49:34.47,0:49:37.01,Default,,0,0,0,,Қызық, ол үйіне кетті ме?
Dialogue: 0,0:49:40.26,0:49:42.60,Default,,0,0,0,,Әке, сіз оны керемет суреттеңіз.
Dialogue: 0,0:49:42.68,0:49:44.39,Default,,0,0,0,,«Бұл жақсы сурет», солай емес пе?
Dialogue: 0,0:49:44.48,0:49:47.06,Default,,0,0,0,,Хмм? Әкем осындай ма?
Dialogue: 0,0:49:47.15,0:49:49.06,Default,,0,0,0,,Ешқандай айырмашылық жоқ.
Dialogue: 0,0:49:49.15,0:49:50.86,Default,,0,0,0,,Өтірік айту жақсы емес
Dialogue: 0,0:49:50.94,0:49:54.95,Default,,0,0,0,,Хмм, мен жақсы болмасам, жақсы деп ойлаймын.
Dialogue: 0,0:49:55.03,0:49:57.41,Default,,0,0,0,,Жақсы сурет «жақсы сурет» емес пе?
Dialogue: 0,0:49:57.49,0:49:59.16,Default,,0,0,0,,«Жақсы сурет» дегеніміз не?
Dialogue: 0,0:49:59.24,0:50:01.45,Default,,0,0,0,,Хмм.
Dialogue: 0,0:50:01.54,0:50:03.66,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:50:06.83,0:50:07.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:09.29,0:50:12.63,Default,,0,0,0,,Нобита… Нобита…
Dialogue: 0,0:50:12.71,0:50:16.05,Default,,0,0,0,,Нобита… Нобита…
Dialogue: 0,0:50:16.13,0:50:17.26,Default,,0,0,0,,Нобита!
Dialogue: 0,0:50:18.64,0:50:20.72,Default,,0,0,0,,Бір қорқынышты нәрсе болды.
Dialogue: 0,0:50:20.80,0:50:22.06,Default,,0,0,0,,Клэр?
Dialogue: 0,0:50:22.14,0:50:25.31,Default,,0,0,0,,Джан мен Сунео түрмеге қамалды.
Dialogue: 0,0:50:25.39,0:50:27.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:27.48,0:50:28.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:50:31.27,0:50:32.77,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:50:33.36,0:50:34.57,Default,,0,0,0,,Уф
Dialogue: 0,0:50:34.65,0:50:35.69,Default,,0,0,0,,Тоуууу
Dialogue: 0,0:50:37.74,0:50:41.37,Default,,0,0,0,,Мен Сунео мен оның достары мұнда жалғыз келеді деп ойламадым.
Dialogue: 0,0:50:41.45,0:50:44.33,Default,,0,0,0,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:50:44.41,0:50:47.04,Default,,0,0,0,,Кіре берістегі суретті де жинап алайық.
Dialogue: 0,0:50:47.12,0:50:49.67,Default,,0,0,0,,Қайтадан біреу кірсе, қиналып қаламыз.
Dialogue: 0,0:50:49.75,0:50:52.25,Default,,0,0,0,,Сіз мұнда қазына іздеуге келгеніңізге сенімдімін.
Dialogue: 0,0:50:52.34,0:50:55.26,Default,,0,0,0,,Мен саған тоқтаңдар дедім.
Dialogue: 0,0:50:55.34,0:50:57.22,Default,,0,0,0,,Мына жігіт екі адамға үнсіз ақша берді.
Dialogue: 0,0:50:57.30,0:50:59.30,Default,,0,0,0,,Мен сізге шоколадты саусақ алғаныңызды естідім.
Dialogue: 0,0:50:59.38,0:51:01.47,Default,,0,0,0,,Кики Кики сөйледі.
Dialogue: 0,0:51:03.64,0:51:05.43,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:51:05.52,0:51:08.69,Default,,0,0,0,,Екеуің ханшайымның жанашырларысыңдар.
Dialogue: 0,0:51:08.77,0:51:11.15,Default,,0,0,0,,Оджамасасису
Dialogue: 0,0:51:11.90,0:51:12.94,Default,,0,0,0,,Көк бөрененің үлкен батасы
Dialogue: 0,0:51:12.94,0:51:14.40,Default,,0,0,0,,Көк бөрененің үлкен батасы
Dialogue: 0,0:51:12.94,0:51:14.40,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:51:14.40,0:51:15.36,Default,,0,0,0,,Көк бөрененің үлкен батасы
Dialogue: 0,0:51:15.44,0:51:16.57,Default,,0,0,0,,Чай суреттерде жасырылған кодтар туралы ештеңе білмейді ме?
Dialogue: 0,0:51:16.57,0:51:18.70,Default,,0,0,0,,Чай суретте жасырылған код туралы ештеңе білмейді ме?
Dialogue: 0,0:51:16.57,0:51:18.70,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:51:18.70,0:51:19.36,Default,,0,0,0,,Чай суретте жасырылған код туралы ештеңе білмейді ме?
Dialogue: 0,0:51:19.45,0:51:22.32,Default,,0,0,0,,А, мені қызықтырады.
Dialogue: 0,0:51:24.70,0:51:25.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:28.08,0:51:29.71,Default,,0,0,0,,Хмм?
Dialogue: 0,0:51:29.79,0:51:32.63,Default,,0,0,0,,...
Dialogue: 0,0:51:33.17,0:51:34.17,Default,,0,0,0,,Эй... Иә?
Dialogue: 0,0:51:35.30,0:51:38.09,Default,,0,0,0,,Балалар, ұрыларды суретке түсіргендерің үшін тұтқындалып жатырсыңдар!
Dialogue: 0,0:51:38.17,0:51:39.38,Default,,0,0,0,,Е!
Dialogue: 0,0:51:39.47,0:51:42.47,Default,,0,0,0,,Жоқ... Не айтып тұрсың? Бұл түсінбеушілік!
Dialogue: 0,0:51:42.55,0:51:44.85,Default,,0,0,0,,Мен ұры емеспін!
Dialogue: 0,0:51:44.93,0:51:46.47,Default,,0,0,0,,Қатты жүріңіз!
Dialogue: 0,0:51:46.56,0:51:48.39,Default,,0,0,0,,Қандай да бір қателік болған болуы керек!
Dialogue: 0,0:51:48.48,0:51:50.31,Default,,0,0,0,,- (Сунео) Адвокат шақырыңыз! - Екі адам ұсталды.
Dialogue: 0,0:51:50.39,0:51:53.27,Default,,0,0,0,,Бірдеңе оғаш бола бастады.
Dialogue: 0,0:51:53.36,0:51:56.23,Default,,0,0,0,,Клэр~ Бұл қайда~?
Dialogue: 0,0:51:56.32,0:51:57.69,Default,,0,0,0,,Үлкен жаңалықтар Үлкен жаңалық!
Dialogue: 0,0:51:57.78,0:51:59.69,Default,,0,0,0,,Мен саған мені кіргіз деп жатырмын!
Dialogue: 0,0:51:59.78,0:52:02.41,Default,,0,0,0,,-(Қақпашы) Ол күдіктенеді. -Не айтқың келеді?
Dialogue: 0,0:52:02.49,0:52:05.16,Default,,0,0,0,,Дөрекі! Сен не істеп жатырсың?
Dialogue: 0,0:52:05.24,0:52:07.66,Default,,0,0,0,,Не? Мен бұл нені білдіретінін түсінбеймін.
Dialogue: 0,0:52:07.74,0:52:09.96,Default,,0,0,0,,Клэр неге құлыптаулы?
Dialogue: 0,0:52:10.04,0:52:12.75,Default,,0,0,0,,Бұл өте сергітеді...
Dialogue: 0,0:52:12.83,0:52:14.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:14.96,0:52:16.50,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:52:16.59,0:52:18.63,Default,,0,0,0,,Ханшайымға дөрекілік көрсет!
Dialogue: 0,0:52:18.71,0:52:21.68,Default,,0,0,0,,Ханшайым ше? Айтқаныңды ұмытпа
Dialogue: 0,0:52:21.76,0:52:24.97,Default,,0,0,0,,Ханшайым болсаң, қарашы, ол ана жақта.
Dialogue: 0,0:52:25.05,0:52:26.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:26.43,0:52:28.22,Default,,0,0,0,,Сен сондай ақымақсың ба?
Dialogue: 0,0:52:28.31,0:52:31.18,Default,,0,0,0,,Ку... Клэр келді!
Dialogue: 0,0:52:31.27,0:52:34.23,Default,,0,0,0,,Жалған ханшайым мен оның достарынан сақ болыңыз.
Dialogue: 0,0:52:34.31,0:52:36.90,Default,,0,0,0,,Нағыз ханшайым осылай дейді!
Dialogue: 0,0:52:36.98,0:52:38.28,Default,,0,0,0,,Нағыз нәрсе - сабан!
Dialogue: 0,0:52:38.36,0:52:42.11,Default,,0,0,0,,Өтірікші! Мен сені осы жерден өткізуге рұқсат ете алмаймын
Dialogue: 0,0:52:43.36,0:52:46.74,Default,,0,0,0,,Арбаны дайындаңыз және кешіктірмеңіз!
Dialogue: 0,0:52:46.83,0:52:47.99,Default,,0,0,0,,Ах... Ха!
Dialogue: 0,0:52:48.08,0:52:52.12,Default,,0,0,0,,Клэрге не болды? Бірдеңе дұрыс емес.
Dialogue: 0,0:52:52.21,0:52:56.17,Default,,0,0,0,,Клэр соңғы бірнеше күнде өзінің армандары туралы айтып жүр, солай ма?
Dialogue: 0,0:52:56.25,0:52:58.96,Default,,0,0,0,,А... Исердің арманы ма?
Dialogue: 0,0:52:59.05,0:53:03.13,Default,,0,0,0,,Ежелден сол баланың арманы ақиқат арманға айналған.
Dialogue: 0,0:53:03.22,0:53:05.18,Default,,0,0,0,,Сіз бізді таң қалдырдыңыз
Dialogue: 0,0:53:05.26,0:53:08.22,Default,,0,0,0,,Клэрдің армандарының күші ақиқат.
Dialogue: 0,0:53:08.31,0:53:10.18,Default,,0,0,0,,Шаршадым! Қанша айтсам да...
Dialogue: 0,0:53:10.27,0:53:15.06,Default,,0,0,0,,Жаман нәрсе болады...
Dialogue: 0,0:53:19.07,0:53:21.48,Default,,0,0,0,,Мен мұндай нәрсе болғанына сене алар емеспін...
Dialogue: 0,0:53:21.57,0:53:24.24,Default,,0,0,0,,Эй, Пал бірдеңе білуі мүмкін.
Dialogue: 0,0:53:24.32,0:53:25.28,Default,,0,0,0,,Пал?
Dialogue: 0,0:53:25.36,0:53:27.62,Default,,0,0,0,,Бұл адам арт-дилер деп атады ма?
Dialogue: 0,0:53:27.70,0:53:31.45,Default,,0,0,0,,Иә, мен картиналарды сатып алу және сату үшін әрқашан сарайға кіріп-шығамын.
Dialogue: 0,0:53:31.54,0:53:33.96,Default,,0,0,0,,Дұрыс, Сунео және басқалары ұсталған кезде.
Dialogue: 0,0:53:34.04,0:53:36.04,Default,,0,0,0,,Мен ол жігітті жасырын бақылап отырдым.
Dialogue: 0,0:53:36.12,0:53:38.17,Default,,0,0,0,,- Иә? -Досым?
Dialogue: 0,0:53:38.25,0:53:39.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:39.92,0:53:42.05,Default,,0,0,0,,Осы уақытқа дейін неге байқамадым?
Dialogue: 0,0:53:42.13,0:53:43.92,Default,,0,0,0,,Не деген...
Dialogue: 0,0:53:44.01,0:53:45.13,Default,,0,0,0,,Бұл Алиса!
Dialogue: 0,0:53:45.97,0:53:48.51,Default,,0,0,0,,Бұл ғажайыптар еліндегі Алиса ма?
Dialogue: 0,0:53:48.60,0:53:52.22,Default,,0,0,0,,«Алисаның ғажайыптар еліндегі оқиғалары» 19 ғасырда жарық көрді
Dialogue: 0,0:53:52.31,0:53:55.10,Default,,0,0,0,,Осы дәуірден 600 жыл!
Dialogue: 0,0:53:55.19,0:53:56.69,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:53:56.77,0:53:58.61,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:53:59.36,0:54:01.69,Default,,0,0,0,,- (Нобита) Не айтып тұрсың? -(2 адам) Зуко
Dialogue: 0,0:54:01.78,0:54:05.24,Default,,0,0,0,,Сонымен... бұл Палдың болашақтан екенін білдіреді, солай ма?
Dialogue: 0,0:54:05.32,0:54:07.20,Default,,0,0,0,,Егер бұл сізге қажет болса, бұл жақсы.
Dialogue: 0,0:54:07.28,0:54:10.41,Default,,0,0,0,,Сурет ұрылар көп деп айтпадың ба?
Dialogue: 0,0:54:10.49,0:54:12.37,Default,,0,0,0,,Мүмкін «Уақыт аңшысы»
Dialogue: 0,0:54:12.45,0:54:13.91,Default,,0,0,0,,Уақыт аңшысы?
Dialogue: 0,0:54:14.00,0:54:15.54,Default,,0,0,0,,Өткен дүниеден
Dialogue: 0,0:54:15.62,0:54:18.12,Default,,0,0,0,,Мен суреттер мен зергерлік бұйымдарды ұрлайтын адамдарды айтып отырмын.
Dialogue: 0,0:54:18.21,0:54:20.71,Default,,0,0,0,,Тарихты өзгертпесе.
Dialogue: 0,0:54:21.75,0:54:23.63,Default,,0,0,0,,-Ол алаңдатады -Құйрықты қолданбаңыз~
Dialogue: 0,0:54:23.71,0:54:26.01,Default,,0,0,0,,Ей, болашақ пен өткен.
Dialogue: 0,0:54:26.09,0:54:28.34,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:54:28.43,0:54:31.22,Default,,0,0,0,,Ах, яғни мынау немесе анау.
Dialogue: 0,0:54:31.30,0:54:32.81,Default,,0,0,0,,Кукукаку Умаума
Dialogue: 0,0:54:32.89,0:54:34.47,Default,,0,0,0,,Зебра
Dialogue: 0,0:54:34.56,0:54:36.56,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:54:36.64,0:54:38.77,Default,,0,0,0,,Ха~
Dialogue: 0,0:54:38.85,0:54:41.44,Default,,0,0,0,,Әйтеуір, қамалды сурет салатын ұры
Dialogue: 0,0:54:41.52,0:54:44.32,Default,,0,0,0,,Сіз бұл болашақтағы Пал болуы мүмкін дейсіз бе?
Dialogue: 0,0:54:44.40,0:54:45.24,Default,,0,0,0,,Иә
Dialogue: 0,0:54:45.32,0:54:48.70,Default,,0,0,0,,Пал онша жаман адам емес.
Dialogue: 0,0:54:48.78,0:54:49.91,Default,,0,0,0,,О, расымен бе?
Dialogue: 0,0:54:49.99,0:54:52.66,Default,,0,0,0,,Жоқ, бұл күдікті нәрсе болды.
Dialogue: 0,0:54:52.74,0:54:53.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:54:54.04,0:54:56.00,Default,,0,0,0,,Қалай болғанда да, мен анықтауым керек.
Dialogue: 0,0:54:56.08,0:54:57.66,Default,,0,0,0,,Палдың үйі қайда?
Dialogue: 0,0:54:57.75,0:55:01.29,Default,,0,0,0,,Сонымен... сұрасам да айтпайды...
Dialogue: 0,0:55:01.38,0:55:03.80,Default,,0,0,0,,-Аяши~ -Ух...
Dialogue: 0,0:55:03.88,0:55:05.88,Default,,0,0,0,,Үйге барсам, ұрланған бірдеңені таптым...
Dialogue: 0,0:55:05.96,0:55:08.01,Default,,0,0,0,,Ол қытырлақ болуы керек.
Dialogue: 0,0:55:08.09,0:55:10.14,Default,,0,0,0,,Жарайды! Үйді табайық!
Dialogue: 0,0:55:10.22,0:55:11.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:55:11.14,0:55:14.51,Default,,0,0,0,,Шық! Шығар!
Dialogue: 0,0:55:14.60,0:55:16.47,Default,,0,0,0,,- Чутчутту - (Сунео) Сәлем!
Dialogue: 0,0:55:16.56,0:55:19.69,Default,,0,0,0,,Маған көмектесші, анашым!
Dialogue: 0,0:55:19.77,0:55:21.40,Default,,0,0,0,,Біз бәрібір асығуымыз керек.
Dialogue: 0,0:55:21.48,0:55:24.40,Default,,0,0,0,,Жарайды, біз мұны талқылап жатырмыз.
Dialogue: 0,0:55:24.48,0:55:26.61,Default,,0,0,0,,Бақылауды жалғастырыңыз.
Dialogue: 0,0:55:26.69,0:55:29.36,Default,,0,0,0,,-Пал -Уау ма... Мило!
Dialogue: 0,0:55:29.45,0:55:31.07,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:55:31.16,0:55:32.78,Default,,0,0,0,,Жоқ...жоқ
Dialogue: 0,0:55:32.87,0:55:35.83,Default,,0,0,0,,Бұл жай ғана жеке әңгіме. Бұл монолог. Хахаха...
Dialogue: 0,0:55:35.91,0:55:38.29,Default,,0,0,0,,Олай болса, асығыңыз, бүгінгі күн осымен бітті...
Dialogue: 0,0:55:38.37,0:55:39.62,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:55:39.71,0:55:42.50,Default,,0,0,0,,Досыңды тексеріп, орнында күт.
Dialogue: 0,0:55:42.58,0:55:43.88,Default,,0,0,0,,Жарайды
Dialogue: 0,0:55:48.55,0:55:50.43,Default,,0,0,0,,Шизука-чан, саған керегі —
Dialogue: 0,0:55:50.51,0:55:52.89,Default,,0,0,0,,Сіз оны «қосалқы қалтаңызда» алып тастай аласыз.
Dialogue: 0,0:55:52.97,0:55:54.14,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:55:54.22,0:55:55.64,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:55:55.72,0:55:58.18,Default,,0,0,0,,«Жансыз Саймин мегафон»!
Dialogue: 0,0:55:58.27,0:56:00.06,Default,,0,0,0,,және жай ғана сыпырғыш
Dialogue: 0,0:56:00.14,0:56:02.23,Default,,0,0,0,,Сен ұшатын сыпырғышсың
Dialogue: 0,0:56:05.52,0:56:08.19,Default,,0,0,0,,Шидзука сиқыр қолдана ала ма?
Dialogue: 0,0:56:08.28,0:56:10.65,Default,,0,0,0,,Бұл да Дора-чанның сиқыры.
Dialogue: 0,0:56:10.74,0:56:14.74,Default,,0,0,0,,Чай сарайдағы жағдайды көріп, Сунео мен басқаларға алаңдайды.
Dialogue: 0,0:56:14.82,0:56:17.37,Default,,0,0,0,,Сен әлі тірісің деп үміттенемін.
Dialogue: 0,0:56:17.45,0:56:18.62,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:56:18.70,0:56:19.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:19.70,0:56:22.08,Default,,0,0,0,,Фоо!
Dialogue: 0,0:56:23.04,0:56:24.67,Default,,0,0,0,,Пал қалаға кетті
Dialogue: 0,0:56:27.25,0:56:29.26,Default,,0,0,0,,Сондай-ақ бақылануда
Dialogue: 0,0:56:30.47,0:56:33.43,Default,,0,0,0,,Шпиондық фильм сияқты, хмм...
Dialogue: 0,0:56:33.51,0:56:34.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:34.43,0:56:35.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:56:38.60,0:56:39.93,Default,,0,0,0,,Хмм?
Dialogue: 0,0:56:41.60,0:56:43.98,Default,,0,0,0,,Та... көмектесші~
Dialogue: 0,0:56:44.06,0:56:45.56,Default,,0,0,0,,Нобита-сан?
Dialogue: 0,0:56:45.65,0:56:46.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:46.77,0:56:49.36,Default,,0,0,0,,Ааах…
Dialogue: 0,0:56:50.36,0:56:53.32,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:56:55.91,0:56:57.95,Default,,0,0,0,,​​Қайда бара жатырсың?
Dialogue: 0,0:57:00.08,0:57:02.29,Default,,0,0,0,,О~ Мен тірі едім.
Dialogue: 0,0:57:02.37,0:57:04.75,Default,,0,0,0,,Чай! Менің қымбатты досым!
Dialogue: 0,0:57:04.83,0:57:08.00,Default,,0,0,0,,Біз тозақ алқабына түсеміз!
Dialogue: 0,0:57:08.09,0:57:10.55,Default,,0,0,0,,Тозақ? Мен қызғанамын~
Dialogue: 0,0:57:10.63,0:57:13.76,Default,,0,0,0,,-Ақымақ болма! -(Сунео) Маған көмектес!
Dialogue: 0,0:57:13.84,0:57:15.89,Default,,0,0,0,,«Каругару қармақ»!
Dialogue: 0,0:57:16.85,0:57:17.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:17.80,0:57:19.68,Default,,0,0,0,,Мия! Шш!
Dialogue: 0,0:57:19.76,0:57:22.73,Default,,0,0,0,,Ах... Рахмет, бұл пайдалы болды.
Dialogue: 0,0:57:22.81,0:57:25.23,Default,,0,0,0,,Шизука күшті, солай емес пе?
Dialogue: 0,0:57:25.31,0:57:29.32,Default,,0,0,0,,Бұл «каругару қармақ». Оны тіпті Клэр көтере алады.
Dialogue: 0,0:57:29.40,0:57:30.98,Default,,0,0,0,,-Йо - (Нобита) Уау!
Dialogue: 0,0:57:31.07,0:57:34.36,Default,,0,0,0,,Жарық, жарық! Міне бітті! Міне бітті!
Dialogue: 0,0:57:34.45,0:57:37.57,Default,,0,0,0,,Шизука-чан, стратегияны өзгерту!
Dialogue: 0,0:57:37.66,0:57:40.45,Default,,0,0,0,,Мен тез арада Сунео мен оның достарын құтқаруыңды қалаймын.
Dialogue: 0,0:57:40.54,0:57:41.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:57:41.58,0:57:44.08,Default,,0,0,0,,Джигокуданиде екі адам өлім жазасына кесілмекші.
Dialogue: 0,0:57:44.16,0:57:46.04,Default,,0,0,0,,Мен қызғаншақпын!
Dialogue: 0,0:57:46.12,0:57:48.33,Default,,0,0,0,,Мен орындалатын жердің орнын білемін.
Dialogue: 0,0:57:48.42,0:57:49.67,Default,,0,0,0,,Керемет!
Dialogue: 0,0:57:49.75,0:57:52.17,Default,,0,0,0,,Нобита екеуміз Палдың артынан қуамыз, өтінемін!
Dialogue: 0,0:57:52.26,0:57:53.09,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:57:53.17,0:57:55.01,Default,,0,0,0,,- (Нобита) Мен мұны сұрадым! -Иә!
Dialogue: 0,0:57:56.18,0:57:57.97,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:57:58.05,0:58:00.22,Default,,0,0,0,,Палда сенің де бетің жарылған.
Dialogue: 0,0:58:00.31,0:58:02.27,Default,,0,0,0,,Чаймен Джигокуданиге бару
Dialogue: 0,0:58:02.35,0:58:03.18,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:58:03.27,0:58:05.69,Default,,0,0,0,,Джигокудани?
Dialogue: 0,0:58:05.77,0:58:07.90,Default,,0,0,0,,О... ауыр екен!
Dialogue: 0,0:58:07.98,0:58:10.86,Default,,0,0,0,,Сол жаққа бұрылыңыз! Келесі бұрышты оңға бұрыңыз.
Dialogue: 0,0:58:10.94,0:58:13.03,Default,,0,0,0,,Қуып жетудің уақыты келді!
Dialogue: 0,0:58:16.70,0:58:17.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:17.61,0:58:19.99,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:58:29.96,0:58:32.50,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:58:34.67,0:58:35.59,Default,,0,0,0,,Тез жүр!
Dialogue: 0,0:58:35.67,0:58:37.97,Default,,0,0,0,,Барам десе бара аласың ба?
Dialogue: 0,0:58:39.51,0:58:42.68,Default,,0,0,0,,Осылай етсең... Мен сені сотқа беремін!
Dialogue: 0,0:58:42.76,0:58:45.14,Default,,0,0,0,,Біз кінәсізміз~!
Dialogue: 0,0:58:45.23,0:58:48.44,Default,,0,0,0,,Содоро, басқа адам бала.
Dialogue: 0,0:58:48.52,0:58:50.86,Default,,0,0,0,,Бұл тым көп емес пе?
Dialogue: 0,0:58:50.94,0:58:53.86,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:58:53.94,0:58:58.36,Default,,0,0,0,,Ұрлық ауыр қылмыс болып табылады және өлім жазасына лайық.
Dialogue: 0,0:58:58.45,0:59:00.82,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:59:05.37,0:59:07.04,Default,,0,0,0,,Хмм
Dialogue: 0,0:59:07.87,0:59:10.71,Default,,0,0,0,,- (Нобита) Уау! -Шшш!
Dialogue: 0,0:59:10.79,0:59:12.50,Default,,0,0,0,,Дораемон
Dialogue: 0,0:59:12.59,0:59:15.96,Default,,0,0,0,,Бұл рас! Ештеңені ұрламаңыз!
Dialogue: 0,0:59:16.05,0:59:20.43,Default,,0,0,0,,Ұрлық жасағандар оны өзінен ұрладым демейді.
Dialogue: 0,0:59:21.22,0:59:22.89,Default,,0,0,0,,Ииии!
Dialogue: 0,0:59:22.97,0:59:24.01,Default,,0,0,0,,Гугугугу…
Dialogue: 0,0:59:24.10,0:59:26.68,Default,,0,0,0,,Анашым!
Dialogue: 0,0:59:27.56,0:59:29.81,Default,,0,0,0,,Мен Палдың үйін таптым!
Dialogue: 0,0:59:29.89,0:59:31.19,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:59:31.27,0:59:33.27,Default,,0,0,0,,Жарайды
Dialogue: 0,0:59:33.36,0:59:35.11,Default,,0,0,0,,«Құрса арқылы»
Dialogue: 0,0:59:35.19,0:59:37.40,Default,,0,0,0,,Нобита-кун – «Коробашия»
Dialogue: 0,0:59:38.28,0:59:41.36,Default,,0,0,0,,«Коробашияға» 10 иен салып, Палды құлат!
Dialogue: 0,0:59:41.45,0:59:43.70,Default,,0,0,0,,Клэр! Не болды!
Dialogue: 0,0:59:43.78,0:59:46.41,Default,,0,0,0,,Сіз сондай жігітсіз бе?
Dialogue: 0,0:59:46.49,0:59:48.04,Default,,0,0,0,,Құдай Будда!
Dialogue: 0,0:59:48.12,0:59:51.50,Default,,0,0,0,,Шайтан болсаң да, маған көмектес!
Dialogue: 0,0:59:51.58,0:59:52.79,Default,,0,0,0,,Иә
Dialogue: 0,0:59:52.88,0:59:53.71,Default,,0,0,0,,３…
Dialogue: 0,0:59:53.79,0:59:54.92,Default,,0,0,0,,２…
Dialogue: 0,0:59:55.00,0:59:56.13,Default,,0,0,0,,１！
Dialogue: 0,0:59:56.21,0:59:57.21,Default,,0,0,0,,Міне!
Dialogue: 0,0:59:57.30,0:59:58.42,Default,,0,0,0,,Жаса!
Dialogue: 0,0:59:58.51,1:00:00.84,Default,,0,0,0,,- (Жалушы) Ей! -(2 адам) Уау!
Dialogue: 0,1:00:00.93,1:00:02.30,Default,,0,0,0,,Бұл сіздің пайдалануыңыз үшін!
Dialogue: 0,1:00:03.22,1:00:04.05,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:04.14,1:00:05.26,Default,,0,0,0,,О...!
Dialogue: 0,1:00:05.35,1:00:07.97,Default,,0,0,0,,Я... Джан!
Dialogue: 0,1:00:08.06,1:00:10.44,Default,,0,0,0,,Ngh!
Dialogue: 0,1:00:10.52,1:00:11.64,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:00:11.73,1:00:13.94,Default,,0,0,0,,Міне болды! Ана жерде!
Dialogue: 0,1:00:14.02,1:00:15.36,Default,,0,0,0,,Такеши-сан!
Dialogue: 0,1:00:17.15,1:00:19.53,Default,,0,0,0,,Гугугугу…
Dialogue: 0,1:00:19.61,1:00:20.74,Default,,0,0,0,,Иә
Dialogue: 0,1:00:21.32,1:00:23.70,Default,,0,0,0,,Гугу... n~
Dialogue: 0,1:00:25.49,1:00:28.62,Default,,0,0,0,,Джай… Джажа… Джай…
Dialogue: 0,1:00:30.41,1:00:33.29,Default,,0,0,0,,Ооо...
Dialogue: 0,1:00:36.59,1:00:37.71,Default,,0,0,0,,Ga!
Dialogue: 0,1:00:39.26,1:00:40.59,Default,,0,0,0,,Такеши-сан!
Dialogue: 0,1:00:40.67,1:00:42.59,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:00:43.63,1:00:46.51,Default,,0,0,0,,«Каругару қармақ»!
Dialogue: 0,1:00:46.60,1:00:48.43,Default,,0,0,0,,Иә!
Dialogue: 0,1:00:50.27,1:00:52.64,Default,,0,0,0,,Не?!
Dialogue: 0,1:00:59.11,1:01:00.65,Default,,0,0,0,,- Не? - (Сунео) О, сонда болды.
Dialogue: 0,1:01:01.65,1:01:04.03,Default,,0,0,0,,Мен... құтқарылдым.
Dialogue: 0,1:01:04.11,1:01:06.99,Default,,0,0,0,,-Жоқ... -(Жалған Клэр) Қарғыс атсын!
Dialogue: 0,1:01:07.08,1:01:09.45,Default,,0,0,0,,Сонымен... аспанда ұшады
Dialogue: 0,1:01:09.54,1:01:11.20,Default,,0,0,0,,Уау! Бұл сиқыршы!
Dialogue: 0,1:01:11.29,1:01:14.17,Default,,0,0,0,,Ей, балалар, қашпаңдар!
Dialogue: 0,1:01:14.25,1:01:15.71,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:01:15.79,1:01:17.00,Default,,0,0,0,,Клэр?
Dialogue: 0,1:01:17.09,1:01:19.88,Default,,0,0,0,,Ангатойо! Бірақ...
Dialogue: 0,1:01:19.96,1:01:22.05,Default,,0,0,0,,Екі Клэр?
Dialogue: 0,1:01:22.13,1:01:23.84,Default,,0,0,0,,Ку... Клэр?
Dialogue: 0,1:01:23.93,1:01:25.13,Default,,0,0,0,,Әке!
Dialogue: 0,1:01:25.22,1:01:28.26,Default,,0,0,0,,Сіз бұл алаяқты жалған деп шынымен ойладыңыз ба?
Dialogue: 0,1:01:28.35,1:01:30.77,Default,,0,0,0,,Не айту керек! Бұл жалған!
Dialogue: 0,1:01:30.85,1:01:32.31,Default,,0,0,0,,Жоқ, бұл сенсің!
Dialogue: 0,1:01:32.39,1:01:35.56,Default,,0,0,0,,-(2 адам) Нунуну... -(Патша) О, о...
Dialogue: 0,1:01:35.65,1:01:37.27,Default,,0,0,0,,А... а...
Dialogue: 0,1:01:41.90,1:01:43.69,Default,,0,0,0,,-Аша! -(2 адам) Ах!
Dialogue: 0,1:01:43.78,1:01:45.95,Default,,0,0,0,,Нобита-кун, асығыңыз! тез! тез!
Dialogue: 0,1:01:46.99,1:01:49.24,Default,,0,0,0,,Уау, қазір 5 иен болды.
Dialogue: 0,1:01:49.33,1:01:50.62,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,1:01:50.70,1:01:53.25,Default,,0,0,0,,-Авававава... -(Нобита) Бар болғаны 5 иен қалды!
Dialogue: 0,1:01:53.33,1:01:54.87,Default,,0,0,0,,Палды құлат!
Dialogue: 0,1:01:55.37,1:01:57.38,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,1:01:57.46,1:02:00.46,Default,,0,0,0,,Уақыт аңшысы! Жұмбақ болыңыз!
Dialogue: 0,1:02:01.13,1:02:02.96,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,1:02:03.05,1:02:05.09,Default,,0,0,0,,Ах... Гяа!
Dialogue: 0,1:02:05.17,1:02:07.97,Default,,0,0,0,,Чай, асығыңыз.
Dialogue: 0,1:02:08.05,1:02:09.80,Default,,0,0,0,,Хмм... мүмкін емес!
Dialogue: 0,1:02:09.89,1:02:13.52,Default,,0,0,0,,Менің ойымша, егер мен мұны іске қоссам, тезірек болар еді.
Dialogue: 0,1:02:15.18,1:02:17.90,Default,,0,0,0,,О~ Ракутин Ракутин~
Dialogue: 0,1:02:17.98,1:02:20.23,Default,,0,0,0,,Қайсы… Қайсысы қай…
Dialogue: 0,1:02:20.31,1:02:22.32,Default,,0,0,0,,Мен енді түсінбеймін
Dialogue: 0,1:02:22.40,1:02:23.90,Default,,0,0,0,,Бұл шын!
Dialogue: 0,1:02:23.99,1:02:25.36,Default,,0,0,0,,Жоқ, келіңіз!
Dialogue: 0,1:02:25.45,1:02:28.24,Default,,0,0,0,,Мен... Қайсысы екенін білмеймін...
Dialogue: 0,1:02:28.32,1:02:29.62,Default,,0,0,0,,Содоро ше?
Dialogue: 0,1:02:29.70,1:02:32.12,Default,,0,0,0,,Бұл сондай сергітеді... О, жоқ.
Dialogue: 0,1:02:32.20,1:02:34.08,Default,,0,0,0,,Мен үшін де сергіту
Dialogue: 0,1:02:34.16,1:02:35.54,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:37.04,1:02:38.29,Default,,0,0,0,,Сәлем Клэр
Dialogue: 0,1:02:38.37,1:02:41.29,Default,,0,0,0,,Өткен күні бірге шомылғанымыз есіңізде ме?
Dialogue: 0,1:02:41.38,1:02:42.75,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,1:02:42.84,1:02:45.47,Default,,0,0,0,,Сергіту және жақсы сезінді.
Dialogue: 0,1:02:45.55,1:02:46.92,Default,,0,0,0,,Әй!
Dialogue: 0,1:02:47.01,1:02:50.89,Default,,0,0,0,,Кірме, мен ваннаны ұнатпаймын.
Dialogue: 0,1:02:50.97,1:02:52.89,Default,,0,0,0,,Такеши-сан гонёгонё...
Dialogue: 0,1:02:52.97,1:02:54.31,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:56.06,1:02:59.10,Default,,0,0,0,,Эй, Клэрдің сүйікті тағамы қандай?
Dialogue: 0,1:02:59.19,1:03:02.48,Default,,0,0,0,,Әрине, менің сүйікті тағамым - шоколад бұршақтары.
Dialogue: 0,1:03:02.57,1:03:04.11,Default,,0,0,0,,Шоколад?
Dialogue: 0,1:03:04.19,1:03:07.03,Default,,0,0,0,,Қазіргі заманда шоколад деген нәрсе жоқ!
Dialogue: 0,1:03:07.11,1:03:09.45,Default,,0,0,0,,Мұны қайдан білесіз?
Dialogue: 0,1:03:09.53,1:03:11.07,Default,,0,0,0,,Гах... бұл...
Dialogue: 0,1:03:11.16,1:03:13.87,Default,,0,0,0,,Жоқ, күте тұр, сен неге олайсың...
Dialogue: 0,1:03:13.95,1:03:14.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:17.08,1:03:19.50,Default,,0,0,0,,-Мына жігіт! -Қал...
Dialogue: 0,1:03:19.58,1:03:22.00,Default,,0,0,0,,Мен сізді уақытында патрульге жіберемін!
Dialogue: 0,1:03:22.08,1:03:24.21,Default,,0,0,0,,Жарайды... мұның қажеті жоқ.
Dialogue: 0,1:03:24.30,1:03:26.88,Default,,0,0,0,,- (Нобита) Жоқ, керек! - Уақытында келдің...
Dialogue: 0,1:03:26.96,1:03:29.43,Default,,0,0,0,,- Өлетін уақыт жаман - Бірақ...
Dialogue: 0,1:03:29.51,1:03:31.14,Default,,0,0,0,,Демонстрациялар мен ереуілдерге жол берілмейді!
Dialogue: 0,1:03:31.22,1:03:35.10,Default,,0,0,0,,Бірақ мен уақыт патрульшісімін!
Dialogue: 0,1:03:35.18,1:03:36.72,Default,,0,0,0,,О!
Dialogue: 0,1:03:36.81,1:03:39.81,Default,,0,0,0,,Бұл жағдайда, бұл сөзсіз уақытында ...
Dialogue: 0,1:03:39.89,1:03:42.02,Default,,0,0,0,,Иә!
Dialogue: 0,1:03:42.10,1:03:44.36,Default,,0,0,0,,Мына жігіт, мына микрофонмен Клэр...
Dialogue: 0,1:03:44.44,1:03:47.99,Default,,0,0,0,,Ол алаяқты пайдаланған сияқты.
Dialogue: 0,1:03:48.07,1:03:50.45,Default,,0,0,0,,Коммутатор... бұл?
Dialogue: 0,1:03:55.08,1:03:57.16,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,1:03:57.25,1:03:58.87,Default,,0,0,0,,Құпия құрал...!
Dialogue: 0,1:03:58.96,1:04:00.96,Default,,0,0,0,,Сіз болашақтансыз ба?
Dialogue: 0,1:04:01.04,1:04:03.63,Default,,0,0,0,,Мүмкін Уақыт аңшысы...
Dialogue: 0,1:04:03.71,1:04:06.00,Default,,0,0,0,,Уақыт аңшысы? Не айтқың келеді?
Dialogue: 0,1:04:06.09,1:04:07.76,Default,,0,0,0,,Әй, уақыт патрульі!
Dialogue: 0,1:04:07.84,1:04:11.09,Default,,0,0,0,,Ах! Ахх...
Dialogue: 0,1:04:11.18,1:04:12.47,Default,,0,0,0,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,1:04:12.55,1:04:16.06,Default,,0,0,0,,Ах! Әлгі жүз сол заманның көріпкелі!
Dialogue: 0,1:04:16.14,1:04:17.52,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:04:18.18,1:04:20.35,Default,,0,0,0,,Хмф, менің...
Dialogue: 0,1:04:21.14,1:04:23.27,Default,,0,0,0,,Егер біз білсек, ештеңе істей алмаймыз
Dialogue: 0,1:04:23.35,1:04:24.73,Default,,0,0,0,,«Әмбебап тұзақ»!
Dialogue: 0,1:04:24.81,1:04:26.73,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:04:28.03,1:04:31.90,Default,,0,0,0,,Хе хе хе хе, бұл жігіттер барымта.
Dialogue: 0,1:04:31.99,1:04:33.61,Default,,0,0,0,,Қарғыс атсын! Қайтарыңыз!
Dialogue: 0,1:04:33.70,1:04:35.53,Default,,0,0,0,,«Дыбысы ұзын жастық»!
Dialogue: 0,1:04:35.62,1:04:37.91,Default,,0,0,0,,-Тәкеши-сан! -(Сунео) Джан!
Dialogue: 0,1:04:37.99,1:04:39.54,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:42.08,1:04:45.84,Default,,0,0,0,,Ха ха! Ел жойылғанша ұйықтай бер!
Dialogue: 0,1:04:45.92,1:04:48.63,Default,,0,0,0,,Хахахахахаха
Dialogue: 0,1:04:48.71,1:04:50.92,Default,,0,0,0,,-Хи-хи-Хм...
Dialogue: 0,1:04:51.01,1:04:53.47,Default,,0,0,0,,Сәлем бәріңе!
Dialogue: 0,1:04:53.55,1:04:54.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:54.72,1:04:58.89,Default,,0,0,0,,Джигокуданиде ұйықтап жатырсыз ба? Бұл курорт сияқты.
Dialogue: 0,1:04:58.97,1:05:01.85,Default,,0,0,0,,үшінна не болды? Не болды...
Dialogue: 0,1:05:05.15,1:05:08.19,Default,,0,0,0,,Иә! Ал...
Dialogue: 0,1:05:09.11,1:05:11.86,Default,,0,0,0,,Иә, Мило? Неге...
Dialogue: 0,1:05:11.94,1:05:13.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:13.24,1:05:15.03,Default,,0,0,0,,Жақынбаңыз
Dialogue: 0,1:05:15.11,1:05:16.37,Default,,0,0,0,,Сыпыртқы!
Dialogue: 0,1:05:17.53,1:05:18.53,Default,,0,0,0,,Каранэс ауданына оралу.
Dialogue: 0,1:05:18.62,1:05:21.25,Default,,0,0,0,,Клэр-чанды құтқарсаң, мен бірден қайтамын!
Dialogue: 0,1:05:21.33,1:05:23.12,Default,,0,0,0,,Уақыт қайығы бар
Dialogue: 0,1:05:23.21,1:05:25.46,Default,,0,0,0,,Бұл шынымен де уақыт патрульі...
Dialogue: 0,1:05:25.54,1:05:26.88,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,1:05:26.96,1:05:29.71,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,1:05:29.80,1:05:30.96,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,1:05:31.05,1:05:34.09,Default,,0,0,0,,Бұл қиын! Содоро уақытты іздеуші болған
Dialogue: 0,1:05:34.18,1:05:35.68,Default,,0,0,0,,Не?
Dialogue: 0,1:05:35.76,1:05:36.59,Default,,0,0,0,,Күтілгендей
Dialogue: 0,1:05:36.68,1:05:38.85,Default,,0,0,0,,Король мен Клэрді кепілге алу
Dialogue: 0,1:05:38.93,1:05:40.89,Default,,0,0,0,,Мен қамалға қарай бет алдым.
Dialogue: 0,1:05:41.47,1:05:43.68,Default,,0,0,0,,Мен де қазір келе жатырмын.
Dialogue: 0,1:05:43.77,1:05:44.60,Default,,0,0,0,,Жүр!
Dialogue: 0,1:06:00.03,1:06:02.04,Default,,0,0,0,,Мен жасырын тергеуші болдым.
Dialogue: 0,1:06:02.12,1:06:04.79,Default,,0,0,0,,Мен Содороның құйрығынан ұстамақ болдым.
Dialogue: 0,1:06:04.87,1:06:06.67,Default,,0,0,0,,Сізді бөлгенім үшін кешіріңіз.
Dialogue: 0,1:06:06.75,1:06:10.00,Default,,0,0,0,,Жоқ, өйткені біз де шешуші факторды таба алмадық.
Dialogue: 0,1:06:10.09,1:06:12.88,Default,,0,0,0,,Ол бетперденің шебері ғой...
Dialogue: 0,1:06:12.96,1:06:17.09,Default,,0,0,0,,Ол қамалға алдымен көріпкел ретінде кірді.
Dialogue: 0,1:06:17.18,1:06:21.72,Default,,0,0,0,,Қара рыцарь Исердің қайта тірілуіне аз уақыт қалды.
Dialogue: 0,1:06:21.81,1:06:22.72,Default,,0,0,0,,Не!
Dialogue: 0,1:06:22.81,1:06:27.31,Default,,0,0,0,,Клэрдің жоғалып кетуі де Исердің қарғысына байланысты болды.
Dialogue: 0,1:06:27.40,1:06:30.27,Default,,0,0,0,,Маған Клэрдің қайда екенін айт!
Dialogue: 0,1:06:30.36,1:06:33.82,Default,,0,0,0,,(джиджижи… дыбысы)
Dialogue: 0,1:06:36.11,1:06:37.41,Default,,0,0,0,,Хмм...
Dialogue: 0,1:06:38.82,1:06:39.70,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,1:06:39.78,1:06:42.58,Default,,0,0,0,,- Уақыт аңшысы, солай ма? -Апыр-ай!
Dialogue: 0,1:06:43.20,1:06:44.16,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:06:44.25,1:06:46.16,Default,,0,0,0,,Содан бір күні бір сәуле жарқырап түсті,
Dialogue: 0,1:06:47.62,1:06:48.96,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:06:53.42,1:06:55.01,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,1:06:55.09,1:06:56.17,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,1:06:56.26,1:06:58.26,Default,,0,0,0,,Уау... уф!
Dialogue: 0,1:06:59.97,1:07:01.60,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,1:07:05.43,1:07:07.31,Default,,0,0,0,,Арх! Жоқ...
Dialogue: 0,1:07:08.14,1:07:10.06,Default,,0,0,0,,Эй... жібер! Жіберу!
Dialogue: 0,1:07:10.15,1:07:11.69,Default,,0,0,0,,Мені жіберме!
Dialogue: 0,1:07:11.77,1:07:13.77,Default,,0,0,0,,Ммм~!
Dialogue: 0,1:07:13.86,1:07:16.19,Default,,0,0,0,,-Фуну! -Да~!
Dialogue: 0,1:07:20.95,1:07:24.08,Default,,0,0,0,,Ах! Қымбат сурет!
Dialogue: 0,1:07:24.16,1:07:25.66,Default,,0,0,0,,Содан бір күні бір сәуле жарқырап түсті,
Dialogue: 0,1:07:29.92,1:07:32.00,Default,,0,0,0,,Керемет! Қайтадан бастау керек пе?
Dialogue: 0,1:07:32.08,1:07:34.05,Default,,0,0,0,,(сирена дыбысы)
Dialogue: 0,1:07:34.13,1:07:37.76,Default,,0,0,0,,-Күте~! - Уа! Ол табанды
Dialogue: 0,1:07:37.84,1:07:41.89,Default,,0,0,0,,Уау! Мұнда! Гиперкеңістікте мылтық атпаңыз!
Dialogue: 0,1:07:41.97,1:07:43.51,Default,,0,0,0,,Кеңістік-уақыт тұрақсыз болады...
Dialogue: 0,1:07:44.05,1:07:46.27,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:07:47.02,1:07:49.19,Default,,0,0,0,,А, мен саған айтпаймын!
Dialogue: 0,1:07:49.27,1:07:53.11,Default,,0,0,0,,Тар жолдардың дұрыс саны ғана жасалды.
Dialogue: 0,1:07:53.19,1:07:54.36,Default,,0,0,0,,Есеп № 006
Dialogue: 0,1:07:54.44,1:07:56.86,Default,,0,0,0,,...
Dialogue: 0,1:07:56.94,1:07:57.82,Default,,0,0,0,,Хамф!
Dialogue: 0,1:07:59.57,1:08:00.70,Default,,0,0,0,,Гюго!
Dialogue: 0,1:08:01.78,1:08:03.03,Default,,0,0,0,,О!
Dialogue: 0,1:08:04.49,1:08:05.79,Default,,0,0,0,,Фуго…
Dialogue: 0,1:08:07.04,1:08:09.25,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:08:10.96,1:08:12.71,Default,,0,0,0,,Ха~
Dialogue: 0,1:08:12.79,1:08:14.59,Default,,0,0,0,,Ол суретті ұрлап жатқанда
Dialogue: 0,1:08:14.67,1:08:16.92,Default,,0,0,0,,Артурия Блудың шынайы мақсаты —
Dialogue: 0,1:08:17.00,1:08:19.34,Default,,0,0,0,,Дөрекі тастарды іздеу
Dialogue: 0,1:08:19.42,1:08:23.05,Default,,0,0,0,,Мен оны таппайынша ешқашан берілмеймін
Dialogue: 0,1:08:28.14,1:08:31.14,Default,,0,0,0,,Қарғыс атсын, менің болжамым дәл.
Dialogue: 0,1:08:31.23,1:08:33.90,Default,,0,0,0,,Қазіргі заманда көгілдір көгілдір көгілдір кедір-бұдырлы тастар міндетті түрде кездеседі.
Dialogue: 0,1:08:33.98,1:08:36.52,Default,,0,0,0,,Мен оны табуым керек еді!
Dialogue: 0,1:08:36.61,1:08:39.15,Default,,0,0,0,,Міне, тағы барамыз!
Dialogue: 0,1:08:39.24,1:08:40.49,Default,,0,0,0,,Осы үш кадрды қайтадан қатар қойып көрсетіңізші.
Dialogue: 0,1:08:40.57,1:08:42.03,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,1:08:42.70,1:08:44.07,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,1:08:44.82,1:08:47.49,Default,,0,0,0,,Уақыт аңшысы бүкіл дәуір бойы іздеген
Dialogue: 0,1:08:47.58,1:08:49.16,Default,,0,0,0,,Косо Дориро, солай ма?
Dialogue: 0,1:08:49.25,1:08:51.58,Default,,0,0,0,,Иә, бірақ не?
Dialogue: 0,1:08:51.66,1:08:52.83,Default,,0,0,0,,Гррр…
Dialogue: 0,1:08:52.92,1:08:56.29,Default,,0,0,0,,Егер сіз суретті қатты жақсы көрсеңіз, неге өзіңізді картинаның ішіне қамап алмайсыз!
Dialogue: 0,1:08:56.38,1:08:58.17,Default,,0,0,0,,Ал, күте тұрыңыз.
Dialogue: 0,1:08:58.25,1:09:00.63,Default,,0,0,0,,Мен жақсы нәрсе істеп жатырмын ба?
Dialogue: 0,1:09:00.71,1:09:03.38,Default,,0,0,0,,Бұл бәрібір жойылатын ел емес пе?
Dialogue: 0,1:09:03.47,1:09:04.51,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:04.59,1:09:08.01,Default,,0,0,0,,Сіз не істесеңіз де, болашаққа көп әсер етпейді.
Dialogue: 0,1:09:08.10,1:09:09.97,Default,,0,0,0,,Мәселе бұл емес!
Dialogue: 0,1:09:10.06,1:09:14.52,Default,,0,0,0,,Мына суретке қараңыз! барлығы үлкен құндылық
Dialogue: 0,1:09:14.60,1:09:17.15,Default,,0,0,0,,Бірақ, бірнеше жүз жылдан кейін...
Dialogue: 0,1:09:17.23,1:09:20.69,Default,,0,0,0,,Жанартау барлығын өртеп жібереді.
Dialogue: 0,1:09:20.78,1:09:25.45,Default,,0,0,0,,Күлге айналады, тіпті ел болғанын да ұмытады, солай ма?
Dialogue: 0,1:09:25.53,1:09:30.66,Default,,0,0,0,,Артурия шынымен тарих ұмытқан ел болды ма?
Dialogue: 0,1:09:30.74,1:09:34.25,Default,,0,0,0,,Бұл орын алмас бұрын, біз оларды болашаққа көшіреміз.
Dialogue: 0,1:09:34.33,1:09:36.38,Default,,0,0,0,,Сурет салу бір рахат болары сөзсіз.
Dialogue: 0,1:09:36.46,1:09:39.00,Default,,0,0,0,,Бірақ! Егер сурет осы жерден жоғалып кетсе
Dialogue: 0,1:09:39.09,1:09:43.09,Default,,0,0,0,,Қазір мұндағылар... Мило мен басқалары мұңаяды!
Dialogue: 0,1:09:43.17,1:09:46.68,Default,,0,0,0,,Сіз бәрібір өлетін жігіттер туралы бірдеңе білдіңіз бе?
Dialogue: 0,1:09:48.14,1:09:51.14,Default,,0,0,0,,Болашақта сенен де көп адамдар бар.
Dialogue: 0,1:09:51.22,1:09:53.35,Default,,0,0,0,,«Сіз бәрібір кімнің өлетінін білесіз бе?»
Dialogue: 0,1:09:53.43,1:09:55.90,Default,,0,0,0,,дегенде не ойлайсың?
Dialogue: 0,1:09:56.69,1:09:59.77,Default,,0,0,0,,Мен Нобита-кун туралы жақсы нәрсе айттым.
Dialogue: 0,1:09:59.86,1:10:03.36,Default,,0,0,0,,Қозғалмаңыз! Қолыңызды дорбадан шығарыңыз
Dialogue: 0,1:10:03.44,1:10:04.95,Default,,0,0,0,,Хехехехе
Dialogue: 0,1:10:05.03,1:10:07.49,Default,,0,0,0,,Мына кепілді көрмейсің бе?
Dialogue: 0,1:10:07.57,1:10:08.62,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:08.70,1:10:10.95,Default,,0,0,0,,- (Нобита) Клэр! -Патша!
Dialogue: 0,1:10:11.04,1:10:12.66,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,1:10:12.75,1:10:16.87,Default,,0,0,0,,Жарай ма? Жарайды ма? Кепілге алынғандар не болатыны сізді қызықтыра ма?
Dialogue: 0,1:10:17.58,1:10:18.63,Default,,0,0,0,,Содоро!
Dialogue: 0,1:10:19.29,1:10:20.34,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:20.42,1:10:21.38,Default,,0,0,0,,Емдеу...
Dialogue: 0,1:10:21.46,1:10:23.13,Default,,0,0,0,,Фунгия!
Dialogue: 0,1:10:24.13,1:10:25.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:26.76,1:10:28.55,Default,,0,0,0,,Ах... а...
Dialogue: 0,1:10:28.64,1:10:31.60,Default,,0,0,0,,- (Патша) О, Клэр - Жарайды.
Dialogue: 0,1:10:31.68,1:10:34.27,Default,,0,0,0,,Содоро! Құрметті сіз...
Dialogue: 0,1:10:34.35,1:10:35.56,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,1:10:36.31,1:10:37.85,Default,,0,0,0,,Уф! Уау...
Dialogue: 0,1:10:39.65,1:10:40.52,Default,,0,0,0,,Ей!
Dialogue: 0,1:10:41.32,1:10:43.19,Default,,0,0,0,,Уау... уф!
Dialogue: 0,1:10:43.28,1:10:44.19,Default,,0,0,0,,Уф!
Dialogue: 0,1:10:44.28,1:10:46.74,Default,,0,0,0,,Тататата... Не?
Dialogue: 0,1:10:46.82,1:10:48.53,Default,,0,0,0,,Кешіріңіз! «Коробашия» бұл
Dialogue: 0,1:10:48.61,1:10:51.28,Default,,0,0,0,,Содоро үш рет айналдырмайынша, ол тоқтамайды.
Dialogue: 0,1:10:52.62,1:10:53.74,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,1:10:53.83,1:10:55.50,Default,,0,0,0,,Сіз оны тоқтата аласыз ба!
Dialogue: 0,1:10:57.54,1:10:59.17,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,1:10:59.96,1:11:01.59,Default,,0,0,0,,Ішек
Dialogue: 0,1:11:01.67,1:11:03.34,Default,,0,0,0,,Өндіріс көлемі артты!
Dialogue: 0,1:11:08.63,1:11:10.51,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:10.59,1:11:13.22,Default,,0,0,0,,Қалыңыз... иә!
Dialogue: 0,1:11:13.31,1:11:16.64,Default,,0,0,0,,Үстелдер айналды, ақымақ.
Dialogue: 0,1:11:16.73,1:11:18.94,Default,,0,0,0,,Әй... Айтқаныңды қаламаймын!
Dialogue: 0,1:11:19.02,1:11:19.94,Default,,0,0,0,,Хун
Dialogue: 0,1:11:20.02,1:11:21.77,Default,,0,0,0,,«Харикоми жарығы»?
Dialogue: 0,1:11:21.86,1:11:22.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:22.98,1:11:26.86,Default,,0,0,0,,Оны баланың ойыншығы ретінде сақтау босқа кетеді.
Dialogue: 0,1:11:27.90,1:11:30.95,Default,,0,0,0,,Шық! Қара рыцарь Исере!
Dialogue: 0,1:11:34.62,1:11:35.49,Default,,0,0,0,,Ой
Dialogue: 0,1:11:35.58,1:11:36.50,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:45.38,1:11:47.26,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:47.84,1:11:51.68,Default,,0,0,0,,Ха~хахахаха!
Dialogue: 0,1:11:51.76,1:11:54.43,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,1:11:54.51,1:11:56.14,Default,,0,0,0,,Исере…
Dialogue: 0,1:11:57.47,1:12:00.10,Default,,0,0,0,,Ол өте дәл болжаушы болған.
Dialogue: 0,1:12:00.19,1:12:02.86,Default,,0,0,0,,Сіз қайтадан көзге түстіңіз.
Dialogue: 0,1:12:02.94,1:12:06.40,Default,,0,0,0,,Исере! Мына жігіттерді қабыл алыңыздар!
Dialogue: 0,1:12:07.15,1:12:09.49,Default,,0,0,0,,Осы арада...
Dialogue: 0,1:12:11.07,1:12:13.53,Default,,0,0,0,,Әй... иә? иә?
Dialogue: 0,1:12:18.33,1:12:19.96,Default,,0,0,0,,Не?
Dialogue: 0,1:12:20.04,1:12:22.92,Default,,0,0,0,,Түс... жойылды!
Dialogue: 0,1:12:23.00,1:12:25.17,Default,,0,0,0,,Вун
Dialogue: 0,1:12:25.25,1:12:29.13,Default,,0,0,0,,Жоқ... не істеп жатырсың! Олар тозаққа кетсін!
Dialogue: 0,1:12:29.21,1:12:33.26,Default,,0,0,0,,Тез орындаңыз! Әйтпесе, суретке қайта салайық...
Dialogue: 0,1:12:44.19,1:12:45.02,Default,,0,0,0,,Уау
Dialogue: 0,1:12:50.49,1:12:53.86,Default,,0,0,0,,Бірдеңе бар ма? Бірдеңе бар ма...
Dialogue: 0,1:13:00.16,1:13:01.00,Default,,0,0,0,,Клэр!
Dialogue: 0,1:13:01.08,1:13:02.71,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,1:13:02.79,1:13:04.71,Default,,0,0,0,,- (Нобита) Патша! -әке!
Dialogue: 0,1:13:07.34,1:13:08.17,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:08.25,1:13:10.84,Default,,0,0,0,,-Уау! -Апыр-ай!
Dialogue: 0,1:13:12.17,1:13:13.80,Default,,0,0,0,,Досым!
Dialogue: 0,1:13:15.84,1:13:17.22,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:21.89,1:13:23.48,Default,,0,0,0,,Уф!
Dialogue: 0,1:13:30.82,1:13:32.69,Default,,0,0,0,,- (3 адам) Сәлем! -Хмм!
Dialogue: 0,1:13:36.53,1:13:38.62,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:13:41.20,1:13:42.96,Default,,0,0,0,,О... ауыр екен!
Dialogue: 0,1:13:47.67,1:13:49.67,Default,,0,0,0,,Не деген сұмдық! Сен бейбақ!
Dialogue: 0,1:13:49.75,1:13:50.80,Default,,0,0,0,,О!
Dialogue: 0,1:13:50.88,1:13:54.76,Default,,0,0,0,,Жарайды... мүмкін емес... Исер?
Dialogue: 0,1:13:54.84,1:13:57.14,Default,,0,0,0,,Уау
Dialogue: 0,1:14:16.11,1:14:18.24,Default,,0,0,0,,Сықырлау...
Dialogue: 0,1:14:18.32,1:14:19.78,Default,,0,0,0,,Уау!
Dialogue: 0,1:14:21.29,1:14:23.08,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,1:14:27.71,1:14:29.92,Default,,0,0,0,,Егер оны алып жатқанда ол қозғалса, біз зақым келтіріп аламыз
Dialogue: 0,1:14:30.00,1:14:30.84,Default,,0,0,0,,Ха!
Dialogue: 0,1:14:34.59,1:14:36.51,Default,,0,0,0,,Қазір шегініңіз!
Dialogue: 0,1:14:37.26,1:14:38.97,Default,,0,0,0,,Мотоциклді қолданғандағыдай, ол—
Dialogue: 0,1:14:41.35,1:14:44.27,Default,,0,0,0,,Әкесі… Анасы…
Dialogue: 0,1:14:55.40,1:14:59.03,Default,,0,0,0,,Исер қайта тіріледі...
Dialogue: 0,1:14:59.11,1:15:00.57,Default,,0,0,0,,«Жарықты алып тастаңыз...»
Dialogue: 0,1:15:00.66,1:15:04.08,Default,,0,0,0,,«Тіпті қараңғылықты өшіретін қара рыцарь Исере»
Dialogue: 0,1:15:04.16,1:15:07.00,Default,,0,0,0,,Түспен тыныс алғаны рас.
Dialogue: 0,1:15:07.08,1:15:09.25,Default,,0,0,0,,-Мм... -Ах
Dialogue: 0,1:15:11.17,1:15:12.34,Default,,0,0,0,,Хмм...
Dialogue: 0,1:15:12.42,1:15:14.21,Default,,0,0,0,,«Пневматикалық мылтық» «Оқпалы мылтық»
Dialogue: 0,1:15:14.30,1:15:16.63,Default,,0,0,0,,«Лездік жабысатын тапанша» және «Хирари плащы»
Dialogue: 0,1:15:16.72,1:15:17.67,Default,,0,0,0,,«Башо жанкүйері»
Dialogue: 0,1:15:17.76,1:15:18.68,Default,,0,0,0,,Жарайды
Dialogue: 0,1:15:19.43,1:15:21.68,Default,,0,0,0,,Исер немесе Маазель, мен білмеймін.
Dialogue: 0,1:15:21.76,1:15:23.89,Default,,0,0,0,,Мен сені бұрқыратамын!
Dialogue: 0,1:15:25.18,1:15:27.85,Default,,0,0,0,,Сен маған күшіңді бересің бе?
Dialogue: 0,1:15:27.94,1:15:30.44,Default,,0,0,0,,-Ах! -(Нобита) Әрине!
Dialogue: 0,1:15:30.52,1:15:33.98,Default,,0,0,0,,Бұл «интрузия жарығы» себебінен болды.
Dialogue: 0,1:15:34.07,1:15:36.07,Default,,0,0,0,,Біз бірдеңе істеуіміз керек!
Dialogue: 0,1:15:36.15,1:15:38.61,Default,,0,0,0,,Дұрыс, Сунео!
Dialogue: 0,1:15:38.70,1:15:40.11,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:15:40.20,1:15:44.28,Default,,0,0,0,,Егер сіз Исерді жеңсеңіз, патша өз қалпына оралатыны сөзсіз.
Dialogue: 0,1:15:48.04,1:15:49.00,Default,,0,0,0,,Иә
Dialogue: 0,1:15:49.08,1:15:51.71,Default,,0,0,0,,Бұл Мило үшін.
Dialogue: 0,1:15:51.79,1:15:53.34,Default,,0,0,0,,«Нағыз қарындаштар»!
Dialogue: 0,1:15:53.42,1:15:57.13,Default,,0,0,0,,Қараңызшы, егер сіз мұнымен қарудың бір түрін салсаңыз ...
Dialogue: 0,1:16:00.01,1:16:02.51,Default,,0,0,0,,Уау! Сурет пайда болды!
Dialogue: 0,1:16:02.59,1:16:05.18,Default,,0,0,0,,О! Пачинко да керемет!
Dialogue: 0,1:16:05.26,1:16:07.64,Default,,0,0,0,,Сіз кез келген нәрсені сызып, жібере аласыз.
Dialogue: 0,1:16:07.72,1:16:10.31,Default,,0,0,0,,Жарайды, жынды болайық!
Dialogue: 0,1:16:10.39,1:16:11.85,Default,,0,0,0,,О!
Dialogue: 0,1:16:11.94,1:16:15.82,Default,,0,0,0,,- (Шайтандар) Гииджи! - (Сарбаздар) О! Ах!
Dialogue: 0,1:16:16.44,1:16:19.28,Default,,0,0,0,,Жарайсың! Ей!
Dialogue: 0,1:16:19.36,1:16:21.53,Default,,0,0,0,,Осы шу-шудың бәрімен—
Dialogue: 0,1:16:22.32,1:16:23.82,Default,,0,0,0,,Гуи!
Dialogue: 0,1:16:23.91,1:16:25.08,Default,,0,0,0,,Гуи!
Dialogue: 0,1:16:25.74,1:16:28.62,Default,,0,0,0,,Ух... Хе! Эй!
Dialogue: 0,1:16:28.70,1:16:29.91,Default,,0,0,0,,Иә!
Dialogue: 0,1:16:30.00,1:16:31.75,Default,,0,0,0,,Гао!
Dialogue: 0,1:16:34.13,1:16:36.04,Default,,0,0,0,,Бум! Бум!
Dialogue: 0,1:16:37.05,1:16:37.96,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:39.01,1:16:39.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:40.01,1:16:40.92,Default,,0,0,0,,Хен
Dialogue: 0,1:16:41.01,1:16:43.14,Default,,0,0,0,,Ату генийінен күткендей!
Dialogue: 0,1:16:43.22,1:16:46.39,Default,,0,0,0,,- «Хирари плащы»! -(Ібіліс) Джиги!
Dialogue: 0,1:16:46.47,1:16:47.76,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:16:48.35,1:16:50.10,Default,,0,0,0,,«Башо жанкүйері»!
Dialogue: 0,1:16:50.89,1:16:52.52,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:16:56.40,1:16:58.94,Default,,0,0,0,,Уа, уау!
Dialogue: 0,1:17:03.49,1:17:05.57,Default,,0,0,0,,(оқтардың таусылғанының шерткен дыбысы)
Dialogue: 0,1:17:05.66,1:17:06.87,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:17:08.16,1:17:09.58,Default,,0,0,0,,Келме!
Dialogue: 0,1:17:09.66,1:17:13.08,Default,,0,0,0,,Уф... та... Көмектесіңізші, құдай!
Dialogue: 0,1:17:13.17,1:17:15.04,Default,,0,0,0,,Үлкен шымшу Үлкен шымшу!
Dialogue: 0,1:17:15.13,1:17:17.75,Default,,0,0,0,,Чай! Маған қарамай көмектесіңізші!
Dialogue: 0,1:17:17.84,1:17:22.01,Default,,0,0,0,,Мен суды ұнатпаймын десем, шоколад берсең таң қалар едім!
Dialogue: 0,1:17:22.09,1:17:24.22,Default,,0,0,0,,де! Дододо... Дораемон!
Dialogue: 0,1:17:24.30,1:17:25.22,Default,,0,0,0,,Сунео!
Dialogue: 0,1:17:25.30,1:17:27.43,Default,,0,0,0,,Бум! Бум!
Dialogue: 0,1:17:27.51,1:17:30.39,Default,,0,0,0,,Хи хи...
Dialogue: 0,1:17:30.47,1:17:31.60,Default,,0,0,0,,Уау!
Dialogue: 0,1:17:35.15,1:17:36.52,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:17:37.86,1:17:38.73,Default,,0,0,0,,Уау!
Dialogue: 0,1:17:42.78,1:17:44.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:44.36,1:17:47.12,Default,,0,0,0,,Не? Жоқ... не?
Dialogue: 0,1:17:47.20,1:17:48.83,Default,,0,0,0,,Бум! иә?
Dialogue: 0,1:17:48.91,1:17:50.99,Default,,0,0,0,,Ах, еріген.
Dialogue: 0,1:17:51.08,1:17:54.16,Default,,0,0,0,,Бұл жігіттер де мен сияқты бастапқыда бояулар.
Dialogue: 0,1:17:54.25,1:17:56.00,Default,,0,0,0,,Суға әлсіз.
Dialogue: 0,1:17:56.08,1:17:59.59,Default,,0,0,0,,Не? Маған тез айт!
Dialogue: 0,1:17:59.67,1:18:00.92,Default,,0,0,0,,Бум!
Dialogue: 0,1:18:01.42,1:18:02.30,Default,,0,0,0,,үшінна!
Dialogue: 0,1:18:02.38,1:18:04.63,Default,,0,0,0,,Шайтанның әлсіздігі – су!
Dialogue: 0,1:18:05.34,1:18:07.72,Default,,0,0,0,,Сумен суланса, ериді!
Dialogue: 0,1:18:07.80,1:18:10.18,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,1:18:11.18,1:18:12.35,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,1:18:13.18,1:18:15.94,Default,,0,0,0,,Не! Тым!
Dialogue: 0,1:18:17.98,1:18:20.40,Default,,0,0,0,,- (Сунео) Қарғыс атсын! -Иә! Алақай!
Dialogue: 0,1:18:21.36,1:18:23.32,Default,,0,0,0,,Сәлем! Ах...
Dialogue: 0,1:18:23.90,1:18:25.20,Default,,0,0,0,,Гуи!
Dialogue: 0,1:18:25.28,1:18:27.07,Default,,0,0,0,,- Нобита Delicious! -(Нобита) Хехе
Dialogue: 0,1:18:27.16,1:18:29.83,Default,,0,0,0,,Барлық жерде балық аулау!
Dialogue: 0,1:18:30.62,1:18:31.66,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,1:18:32.49,1:18:34.12,Default,,0,0,0,,Иә? Ах, міне!
Dialogue: 0,1:18:34.20,1:18:35.50,Default,,0,0,0,,Гуи!
Dialogue: 0,1:18:35.58,1:18:38.13,Default,,0,0,0,,Жоқ, түсініксіз!
Dialogue: 0,1:18:38.21,1:18:40.71,Default,,0,0,0,,- Сунео! -(Сунео) Ух... иә.
Dialogue: 0,1:18:40.79,1:18:44.26,Default,,0,0,0,,үшінңыз көпірдің кіреберісіне жиналыңыздар!
Dialogue: 0,1:18:47.30,1:18:50.60,Default,,0,0,0,,Әр жынды бір-бірден жеңсеңіз, оны уақытында жеңе алмайсыз.
Dialogue: 0,1:18:50.68,1:18:52.97,Default,,0,0,0,,Бірден Исерге шабуыл жасайық!
Dialogue: 0,1:18:53.06,1:18:55.52,Default,,0,0,0,,Тоцугеки!
Dialogue: 0,1:19:00.36,1:19:02.65,Default,,0,0,0,,Гуи! Гррр…
Dialogue: 0,1:19:10.74,1:19:13.41,Default,,0,0,0,,- (Нобита) Әй! -(Шайтан) Гуи!
Dialogue: 0,1:19:13.49,1:19:15.79,Default,,0,0,0,,Дайын бол!
Dialogue: 0,1:19:17.00,1:19:17.87,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:20.92,1:19:23.55,Default,,0,0,0,,Grr
Dialogue: 0,1:19:23.63,1:19:26.34,Default,,0,0,0,,Исер... Бұл...!
Dialogue: 0,1:19:26.92,1:19:28.76,Default,,0,0,0,,Ат!
Dialogue: 0,1:19:28.84,1:19:31.22,Default,,0,0,0,,Гррр!
Dialogue: 0,1:19:31.30,1:19:32.89,Default,,0,0,0,,Уау!
Dialogue: 0,1:19:32.97,1:19:34.18,Default,,0,0,0,,Сонымен... міне, солай!
Dialogue: 0,1:19:36.64,1:19:38.06,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:39.19,1:19:42.40,Default,,0,0,0,,Уау!
Dialogue: 0,1:19:44.65,1:19:46.61,Default,,0,0,0,,Уау!
Dialogue: 0,1:19:47.36,1:19:48.49,Default,,0,0,0,,Не?
Dialogue: 0,1:20:00.12,1:20:02.75,Default,,0,0,0,,Уау!
Dialogue: 0,1:20:02.83,1:20:05.92,Default,,0,0,0,,Жоқ... қызыл айдаһар...
Dialogue: 0,1:20:06.00,1:20:09.22,Default,,0,0,0,,Се... дүние... батады
Dialogue: 0,1:20:12.51,1:20:14.89,Default,,0,0,0,,-Әке! -Клэр!
Dialogue: 0,1:20:14.97,1:20:17.14,Default,,0,0,0,,Уау!
Dialogue: 0,1:20:22.94,1:20:24.98,Default,,0,0,0,,Уау!
Dialogue: 0,1:20:25.07,1:20:26.19,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:20:26.27,1:20:27.61,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:20:29.24,1:20:30.36,Default,,0,0,0,,Гуаа!
Dialogue: 0,1:20:30.45,1:20:32.78,Default,,0,0,0,,-Ах! - Шизука!
Dialogue: 0,1:20:32.86,1:20:34.28,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:20:37.16,1:20:40.21,Default,,0,0,0,,Ах! «Такекоптер»... Ах!
Dialogue: 0,1:20:40.29,1:20:42.42,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:20:42.50,1:20:43.42,Default,,0,0,0,,Аһ!
Dialogue: 0,1:20:47.50,1:20:49.88,Default,,0,0,0,,- (Нобита) Джан! -(Изере) Гуруруру…
Dialogue: 0,1:20:53.80,1:20:55.35,Default,,0,0,0,,Содан бір күні бір сәуле жарқырап түсті,
Dialogue: 0,1:20:57.89,1:20:58.77,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:00.77,1:21:02.31,Default,,0,0,0,,Нобита! Джан!
Dialogue: 0,1:21:02.39,1:21:03.73,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:21:05.56,1:21:07.69,Default,,0,0,0,,А... сен барсың...
Dialogue: 0,1:21:07.77,1:21:08.65,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:08.73,1:21:11.61,Default,,0,0,0,,- (Нобита және басқалар) Сунео! -(Сунео) А?
Dialogue: 0,1:21:11.70,1:21:13.66,Default,,0,0,0,,Нигеро!
Dialogue: 0,1:21:15.70,1:21:17.08,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:20.20,1:21:21.08,Default,,0,0,0,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,1:21:21.16,1:21:22.96,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:21:24.12,1:21:26.25,Default,,0,0,0,,Сунео!
Dialogue: 0,1:21:26.96,1:21:28.09,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:32.34,1:21:33.47,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:34.51,1:21:35.68,Default,,0,0,0,,Джан!
Dialogue: 0,1:21:35.76,1:21:38.14,Default,,0,0,0,,-Жоқ, кет! -(Нобита) Бірақ...
Dialogue: 0,1:21:43.35,1:21:45.23,Default,,0,0,0,,Иә!
Dialogue: 0,1:21:46.90,1:21:47.94,Default,,0,0,0,,Джан!
Dialogue: 0,1:21:48.98,1:21:50.36,Default,,0,0,0,,Әй!
Dialogue: 0,1:21:56.91,1:21:59.91,Default,,0,0,0,,Уау!
Dialogue: 0,1:22:07.88,1:22:10.80,Default,,0,0,0,,Шизука... Шизука! (қанаттардың қағу дыбысы)
Dialogue: 0,1:22:12.71,1:22:14.26,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:16.84,1:22:18.47,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,1:22:19.10,1:22:20.68,Default,,0,0,0,,Клэр?
Dialogue: 0,1:22:21.97,1:22:24.73,Default,,0,0,0,,Чай, сен қашып бара жатырсың.
Dialogue: 0,1:22:24.81,1:22:26.65,Default,,0,0,0,,Ку... Клэр!
Dialogue: 0,1:22:30.23,1:22:33.86,Default,,0,0,0,,Исере Мен сенің қарсыласыңмын!
Dialogue: 0,1:22:33.94,1:22:36.24,Default,,0,0,0,,Уау!
Dialogue: 0,1:22:36.91,1:22:38.24,Default,,0,0,0,,Бум!
Dialogue: 0,1:22:43.29,1:22:47.42,Default,,0,0,0,,Хм... Исеремен күресетін құрал бар ма?
Dialogue: 0,1:22:47.50,1:22:50.21,Default,,0,0,0,,Хм... Ха, міне, солай!
Dialogue: 0,1:22:50.29,1:22:52.38,Default,,0,0,0,,«Мұса таяқшасы»!
Dialogue: 0,1:22:52.46,1:22:55.92,Default,,0,0,0,,Жырт! Көл!
Dialogue: 0,1:23:07.31,1:23:09.85,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:09.94,1:23:13.69,Default,,0,0,0,,Исерді осында тартып, көлді қалпына келтіріңіз.
Dialogue: 0,1:23:13.78,1:23:15.94,Default,,0,0,0,,Ұнамағанша мен саған су құйып беремін!
Dialogue: 0,1:23:16.03,1:23:17.74,Default,,0,0,0,,(Генри) Э-э… Қазіргі уақытта бізге сурет салу сабағы өтуі керек еді, бірақ
Dialogue: 0,1:23:17.82,1:23:20.49,Default,,0,0,0,,Бірақ біз Исерді қалай азғырамыз?
Dialogue: 0,1:23:20.57,1:23:23.41,Default,,0,0,0,,- (3 адам) Ммм - Мм!
Dialogue: 0,1:23:23.49,1:23:25.37,Default,,0,0,0,,Чай!
Dialogue: 0,1:23:26.54,1:23:30.29,Default,,0,0,0,,Клэр де ағарып кетті.
Dialogue: 0,1:23:30.38,1:23:31.71,Default,,0,0,0,,Клэр…
Dialogue: 0,1:23:31.79,1:23:33.55,Default,,0,0,0,,Клэрге дейін...
Dialogue: 0,1:23:33.63,1:23:36.63,Default,,0,0,0,,Жақында Исере туралы бірдеңе істеу керек.
Dialogue: 0,1:23:38.43,1:23:39.43,Default,,0,0,0,,Иә!
Dialogue: 0,1:23:39.51,1:23:42.39,Default,,0,0,0,,Ол бір шетінен екінші шетіне дейін барлық түсті сорып жатыр.
Dialogue: 0,1:23:42.47,1:23:44.26,Default,,0,0,0,,Оларды түстермен тартыңыз!
Dialogue: 0,1:23:44.35,1:23:45.47,Default,,0,0,0,,Ықылық
Dialogue: 0,1:23:45.56,1:23:49.81,Default,,0,0,0,,Шырылдаған...
Dialogue: 0,1:23:49.89,1:23:53.19,Default,,0,0,0,,Кешіріңіз, мен өз суретімді пайдаланғым келді.
Dialogue: 0,1:23:53.27,1:23:56.74,Default,,0,0,0,,Бұл ең нашар бөлігі болды, сондықтан жақсы.
Dialogue: 0,1:23:56.82,1:24:00.20,Default,,0,0,0,,Осыншама үлкен етпесең де... ұят.
Dialogue: 0,1:24:00.28,1:24:02.53,Default,,0,0,0,,Неліктен? Бұл өте жақсы сурет болса да
Dialogue: 0,1:24:02.62,1:24:04.62,Default,,0,0,0,,Не? «Жақсы сурет»?
Dialogue: 0,1:24:04.70,1:24:06.75,Default,,0,0,0,,Уау!
Dialogue: 0,1:24:10.04,1:24:11.37,Default,,0,0,0,,Изер!
Dialogue: 0,1:24:11.46,1:24:12.67,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,1:24:12.75,1:24:14.38,Default,,0,0,0,,Гуруру…
Dialogue: 0,1:24:14.46,1:24:17.26,Default,,0,0,0,,Сіз қалай ойлайсыз? Ол түстерге толы!
Dialogue: 0,1:24:17.34,1:24:20.34,Default,,0,0,0,,Осы уақытқа дейін кел! Тұтқалы қалам!
Dialogue: 0,1:24:22.47,1:24:24.05,Default,,0,0,0,,Уау!
Dialogue: 0,1:24:24.14,1:24:25.89,Default,,0,0,0,,Келіңіздер... Міне, келдік!
Dialogue: 0,1:24:26.60,1:24:28.98,Default,,0,0,0,,Нобита мен оның достары кешігіп қалды.
Dialogue: 0,1:24:29.06,1:24:31.81,Default,,0,0,0,,Мен өлтірдім бе деп ойлаймын.
Dialogue: 0,1:24:31.90,1:24:32.73,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:33.61,1:24:35.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:24:38.74,1:24:39.57,Default,,0,0,0,,Уау!
Dialogue: 0,1:24:46.53,1:24:49.29,Default,,0,0,0,,Әйтеуір... көлге дейін!
Dialogue: 0,1:24:49.37,1:24:50.62,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:08.93,1:25:10.23,Default,,0,0,0,,Мен оны көріп тұрмын!
Dialogue: 0,1:25:12.52,1:25:13.48,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:15.10,1:25:18.36,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:19.44,1:25:22.40,Default,,0,0,0,,-Арғх - (Нобита) Ма... Мило!
Dialogue: 0,1:25:23.07,1:25:24.07,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:24.16,1:25:25.57,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:25:27.70,1:25:30.37,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,1:25:30.45,1:25:32.87,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:25:32.96,1:25:34.58,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:35.88,1:25:38.75,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:25:38.84,1:25:41.46,Default,,0,0,0,,Уау, мен де?
Dialogue: 0,1:25:44.97,1:25:47.68,Default,,0,0,0,,Екеуің де осындасыңдар! Жүгір!
Dialogue: 0,1:25:47.76,1:25:50.97,Default,,0,0,0,,-Нобитаның суреті! -(Нобита) Жарайды, тезірек!
Dialogue: 0,1:25:51.72,1:25:53.35,Default,,0,0,0,,Асығыңыз! тез! тез!
Dialogue: 0,1:25:56.40,1:25:57.27,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:58.15,1:25:59.19,Default,,0,0,0,,Уф...
Dialogue: 0,1:26:00.19,1:26:02.44,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:26:02.53,1:26:03.82,Default,,0,0,0,,Арх!
Dialogue: 0,1:26:04.49,1:26:06.87,Default,,0,0,0,,Көл! Қайтып келу!
Dialogue: 0,1:26:09.12,1:26:10.74,Default,,0,0,0,,Уау!
Dialogue: 0,1:26:14.54,1:26:18.17,Default,,0,0,0,,Оооуу!
Dialogue: 0,1:26:23.88,1:26:26.05,Default,,0,0,0,,А... а...
Dialogue: 0,1:26:28.85,1:26:31.72,Default,,0,0,0,,Қандай жігіт...
Dialogue: 0,1:26:31.81,1:26:33.52,Default,,0,0,0,,Керемет!
Dialogue: 0,1:26:33.60,1:26:35.85,Default,,0,0,0,,«Хирари мантиясы»!
Dialogue: 0,1:26:36.56,1:26:38.56,Default,,0,0,0,,Уф... Куууу...!
Dialogue: 0,1:26:38.65,1:26:40.69,Default,,0,0,0,,Уау!
Dialogue: 0,1:27:20.23,1:27:23.48,Default,,0,0,0,,Суреттің шеті... ұқсайды.
Dialogue: 0,1:27:24.48,1:27:26.15,Default,,0,0,0,,Түс...
Dialogue: 0,1:27:27.03,1:27:28.95,Default,,0,0,0,,Ол жоғалып кетті...
Dialogue: 0,1:27:29.03,1:27:30.87,Default,,0,0,0,,Әкемнің күшін қолданамын…
Dialogue: 0,1:27:31.82,1:27:34.29,Default,,0,0,0,,(қанаттардың қағу дыбысы)
Dialogue: 0,1:27:37.62,1:27:42.09,Default,,0,0,0,,Қызыл айдаһар қанат қағады... Дүние батады...
Dialogue: 0,1:27:42.17,1:27:44.17,Default,,0,0,0,,Бұл енді мүмкін емес пе...
Dialogue: 0,1:27:44.25,1:27:46.51,Default,,0,0,0,,Куу... Куу
Dialogue: 0,1:27:46.59,1:27:47.47,Default,,0,0,0,,Ха!
Dialogue: 0,1:27:48.09,1:27:49.72,Default,,0,0,0,,Міне!
Dialogue: 0,1:27:49.80,1:27:52.01,Default,,0,0,0,,Түсіндім! Егер сіз оны қолдансаңыз ...
Dialogue: 0,1:27:52.10,1:27:52.93,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:27:53.51,1:27:55.14,Default,,0,0,0,,Исере!
Dialogue: 0,1:27:55.22,1:27:57.10,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:27:57.18,1:27:59.06,Default,,0,0,0,,Керемет!
Dialogue: 0,1:27:59.14,1:28:00.77,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:28:03.94,1:28:06.11,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:28:06.19,1:28:07.65,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:28:08.40,1:28:13.45,Default,,0,0,0,,Дораемон жоғалып кетсе, біз жоқ боламыз...
Dialogue: 0,1:28:13.53,1:28:14.70,Default,,0,0,0,,Га
Dialogue: 0,1:28:16.87,1:28:18.50,Default,,0,0,0,,Бұл...
Dialogue: 0,1:28:19.54,1:28:20.46,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,1:28:20.54,1:28:21.67,Default,,0,0,0,,Уау!
Dialogue: 0,1:28:22.29,1:28:23.92,Default,,0,0,0,,Мило Нигеро!
Dialogue: 0,1:28:25.21,1:28:27.92,Default,,0,0,0,,Бірақ бұл құрал қазірдің өзінде...
Dialogue: 0,1:28:31.18,1:28:32.93,Default,,0,0,0,,Гррр!
Dialogue: 0,1:28:34.35,1:28:35.72,Default,,0,0,0,,Гррр!
Dialogue: 0,1:28:38.43,1:28:41.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:42.23,1:28:44.23,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:28:45.69,1:28:47.69,Default,,0,0,0,,- (Изер) Уау... - (Нобита) Тоқта!
Dialogue: 0,1:28:51.20,1:28:52.66,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:53.41,1:28:55.16,Default,,0,0,0,,Мило!
Dialogue: 0,1:28:55.24,1:28:56.08,Default,,0,0,0,,Уау!
Dialogue: 0,1:28:56.16,1:28:58.79,Default,,0,0,0,,Уау!
Dialogue: 0,1:28:58.87,1:29:02.00,Default,,0,0,0,,Арх! Қалыңыз...
Dialogue: 0,1:29:02.08,1:29:04.00,Default,,0,0,0,,Иә... Мило?
Dialogue: 0,1:29:04.08,1:29:07.50,Default,,0,0,0,,Не? Жоқ... мұнда...
Dialogue: 0,1:29:08.88,1:29:10.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:10.30,1:29:12.30,Default,,0,0,0,,Текетцу
Dialogue: 0,1:29:12.38,1:29:14.68,Default,,0,0,0,,Терецу жоқ Паа
Dialogue: 0,1:29:14.76,1:29:17.89,Default,,0,0,0,,Ноби Ноби
Dialogue: 0,1:29:17.97,1:29:20.48,Default,,0,0,0,,До... Дора... Дс?
Dialogue: 0,1:29:20.56,1:29:22.02,Default,,0,0,0,,Ноби!
Dialogue: 0,1:29:22.10,1:29:24.48,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:29:24.56,1:29:27.44,Default,,0,0,0,,Мен салған ебедейсіз Дораемон
Dialogue: 0,1:29:27.52,1:29:30.11,Default,,0,0,0,,Осылай қарасаң сұмдық.
Dialogue: 0,1:29:30.19,1:29:32.86,Default,,0,0,0,,Ах! Бұл мынаны білдіреді ...
Dialogue: 0,1:29:32.95,1:29:34.66,Default,,0,0,0,,Нобита...
Dialogue: 0,1:29:34.74,1:29:35.57,Default,,0,0,0,,Ха!
Dialogue: 0,1:29:36.78,1:29:38.03,Default,,0,0,0,,Бір-бірден, кезекпен—
Dialogue: 0,1:29:40.58,1:29:43.46,Default,,0,0,0,,Дораемон Мило қауіпті!
Dialogue: 0,1:29:43.54,1:29:45.96,Default,,0,0,0,,Бірақ шығу соншалықты биік!
Dialogue: 0,1:29:46.04,1:29:49.63,Default,,0,0,0,,Мм... Коп Кооп!
Dialogue: 0,1:29:49.71,1:29:53.63,Default,,0,0,0,,Бұл «Такекоптер» ме? Мен өте нашармын ...
Dialogue: 0,1:29:53.72,1:29:55.68,Default,,0,0,0,,Ноби! Tappi!
Dialogue: 0,1:29:55.76,1:29:58.89,Default,,0,0,0,,Түсіндім, ебедейсіз адам болғандықтан.
Dialogue: 0,1:29:58.97,1:30:00.22,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:30:01.22,1:30:02.64,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:30:03.27,1:30:05.39,Default,,0,0,0,,А... Мен ұша алдым!
Dialogue: 0,1:30:05.48,1:30:09.44,Default,,0,0,0,,Уау! Апыр-ай! Уа... хахаха
Dialogue: 0,1:30:10.15,1:30:13.36,Default,,0,0,0,,Не? Мүмкін басқа құралдар да бар шығар...
Dialogue: 0,1:30:14.65,1:30:16.36,Default,,0,0,0,,О... бар ма?
Dialogue: 0,1:30:16.45,1:30:18.12,Default,,0,0,0,,Уау!
Dialogue: 0,1:30:18.20,1:30:19.66,Default,,0,0,0,,Олай болса оны шығарыңыз!
Dialogue: 0,1:30:19.74,1:30:21.66,Default,,0,0,0,,(gogogo… дыбысы)
Dialogue: 0,1:30:21.74,1:30:23.29,Default,,0,0,0,,Не?
Dialogue: 0,1:30:23.91,1:30:28.04,Default,,0,0,0,,Иә? Уау, уау... Уау.
Dialogue: 0,1:30:28.13,1:30:30.00,Default,,0,0,0,,Уау!
Dialogue: 0,1:30:30.09,1:30:31.25,Default,,0,0,0,,Уф!
Dialogue: 0,1:30:33.67,1:30:36.05,Default,,0,0,0,,- (Изер) Уау! -Апыр-ай!
Dialogue: 0,1:30:36.13,1:30:37.26,Default,,0,0,0,,Ах!
Dialogue: 0,1:30:37.34,1:30:39.72,Default,,0,0,0,,О, бұл…
Dialogue: 0,1:30:39.80,1:30:42.52,Default,,0,0,0,,Додо... Дораемон! Ха... Тезірек шығарыңыз!
Dialogue: 0,1:30:42.60,1:30:45.18,Default,,0,0,0,,...
Dialogue: 0,1:30:45.27,1:30:46.94,Default,,0,0,0,,Мен Мен Мен!
Dialogue: 0,1:30:47.02,1:30:49.27,Default,,0,0,0,,Уау... бұл?
Dialogue: 0,1:30:49.36,1:30:51.27,Default,,0,0,0,,Ноби! Tappi!
Dialogue: 0,1:30:51.36,1:30:53.65,Default,,0,0,0,,Мен шынымен жындымын.
Dialogue: 0,1:30:53.73,1:30:56.49,Default,,0,0,0,,Бірақ рахмет, Дораемон!
Dialogue: 0,1:30:56.57,1:30:58.41,Default,,0,0,0,,Мен келемін!
Dialogue: 0,1:30:58.49,1:31:02.33,Default,,0,0,0,,Нобби! Гунбар!
Dialogue: 0,1:31:02.41,1:31:04.87,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,1:31:05.58,1:31:09.79,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:09.88,1:31:10.96,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:31:11.04,1:31:14.51,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:15.63,1:31:18.22,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:19.51,1:31:21.89,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:21.97,1:31:23.22,Default,,0,0,0,,Нобита!
Dialogue: 0,1:31:23.81,1:31:26.43,Default,,0,0,0,,Мен Дораемоннан жақсы нәрсе алдым!
Dialogue: 0,1:31:26.52,1:31:27.94,Default,,0,0,0,,Дораемон?
Dialogue: 0,1:31:28.56,1:31:29.48,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:32.27,1:31:34.86,Default,,0,0,0,,Түсіндірме кейінірек! Мило Пачинко сал!
Dialogue: 0,1:31:34.94,1:31:36.24,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,1:31:36.99,1:31:39.24,Default,,0,0,0,,Хмм... Иә!
Dialogue: 0,1:31:39.32,1:31:41.37,Default,,0,0,0,,Хаха, Мило күткендей!
Dialogue: 0,1:31:41.45,1:31:45.04,Default,,0,0,0,,Бұл жаман құрал, бірақ мен оны осы құралда қолданамын!
Dialogue: 0,1:31:47.54,1:31:49.08,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:31:49.83,1:31:52.29,Default,,0,0,0,,«Қайнатылған фурикаке»!
Dialogue: 0,1:31:52.38,1:31:53.67,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:32:02.43,1:32:04.43,Default,,0,0,0,,Ләззат алыңыз! Тыңдаңыз!
Dialogue: 0,1:32:14.15,1:32:17.19,Default,,0,0,0,,Уау!
Dialogue: 0,1:32:25.28,1:32:28.62,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:32:52.77,1:32:55.19,Default,,0,0,0,,Ааа!
Dialogue: 0,1:32:55.27,1:32:56.65,Default,,0,0,0,,Иә?иә?
Dialogue: 0,1:32:56.73,1:32:59.36,Default,,0,0,0,,Ал... иә?
Dialogue: 0,1:33:00.78,1:33:02.74,Default,,0,0,0,,Тек…
Dialogue: 0,1:33:02.82,1:33:05.32,Default,,0,0,0,,-Клэр-чан -Шидзука!
Dialogue: 0,1:33:12.92,1:33:15.96,Default,,0,0,0,,Ой... Уау!
Dialogue: 0,1:33:16.04,1:33:17.88,Default,,0,0,0,,Уау!
Dialogue: 0,1:33:17.96,1:33:20.05,Default,,0,0,0,,Не? иә?
Dialogue: 0,1:33:21.13,1:33:23.51,Default,,0,0,0,,Нобита ұстаңыз
Dialogue: 0,1:33:24.72,1:33:26.51,Default,,0,0,0,,Сендер де сол істі тамаша шешесіңдер деп ойлаймын.
Dialogue: 0,1:33:37.06,1:33:40.19,Default,,0,0,0,,«Лезде тазалайтын кептіргіш»!
Dialogue: 0,1:33:41.74,1:33:44.28,Default,,0,0,0,,Нобита Елді құтқарған бұл сурет
Dialogue: 0,1:33:44.36,1:33:46.70,Default,,0,0,0,,Мен оны сарайдың ең жақсы жерінде көрсетемін.
Dialogue: 0,1:33:46.78,1:33:50.66,Default,,0,0,0,,Бұл өте ұят.
Dialogue: 0,1:33:50.75,1:33:54.67,Default,,0,0,0,,Нобитаның ақсақ сызбалары пайдалы.
Dialogue: 0,1:33:54.75,1:33:57.13,Default,,0,0,0,,Иә?Не?
Dialogue: 0,1:33:58.13,1:34:00.59,Default,,0,0,0,,Көк... жарғанат?
Dialogue: 0,1:34:00.67,1:34:04.55,Default,,0,0,0,,Жоқ! Үлкен баталар әкеледі деп айтылады ма?
Dialogue: 0,1:34:04.63,1:34:08.26,Default,,0,0,0,,үшін қалыпты жағдайға оралды ма?
Dialogue: 0,1:34:08.35,1:34:10.43,Default,,0,0,0,,Иә? Шай емес пе?
Dialogue: 0,1:34:10.51,1:34:11.68,Default,,0,0,0,,Клэр~!
Dialogue: 0,1:34:11.77,1:34:14.35,Default,,0,0,0,,Шай! Жақсы болды ма?
Dialogue: 0,1:34:14.44,1:34:16.73,Default,,0,0,0,,Шай Бұл не көк?
Dialogue: 0,1:34:16.81,1:34:20.65,Default,,0,0,0,,Бұл ма? Мен біртүрлі нәрсе таптым.
Dialogue: 0,1:34:20.73,1:34:23.57,Default,,0,0,0,,Бұл... болуы мүмкін...
Dialogue: 0,1:34:24.20,1:34:25.32,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,1:34:25.40,1:34:27.53,Default,,0,0,0,,Оны қайдан таптың?
Dialogue: 0,1:34:27.62,1:34:30.70,Default,,0,0,0,,Егер мен саған айтсам, сен маған шоколад бересің бе?
Dialogue: 0,1:34:30.79,1:34:33.04,Default,,0,0,0,,Жасайық! Мен не қажет болса да істеймін!
Dialogue: 0,1:34:34.83,1:34:37.96,Default,,0,0,0,,«Мұса таяқшасы»!
Dialogue: 0,1:34:42.71,1:34:45.68,Default,,0,0,0,,Бұл үлкен ме?
Dialogue: 0,1:34:50.72,1:34:55.64,Default,,0,0,0,,Көк жарқанат қанат қағады, үлкен береке әкеледі.
Dialogue: 0,1:34:55.73,1:34:59.36,Default,,0,0,0,,Бұл Артурия Блудың өрескел тасы екеніне күмән жоқ.
Dialogue: 0,1:34:59.44,1:35:01.98,Default,,0,0,0,,Аңыз шындық болды!
Dialogue: 0,1:35:02.07,1:35:05.24,Default,,0,0,0,,Иә! Ол миллиардер!
Dialogue: 0,1:35:05.32,1:35:08.53,Default,,0,0,0,,Жоқ, Мило мұнымен сурет салмақшы.
Dialogue: 0,1:35:08.61,1:35:09.53,Default,,0,0,0,,Е...
Dialogue: 0,1:35:09.62,1:35:11.20,Default,,0,0,0,,Үйге апарып сатсаң
Dialogue: 0,1:35:11.28,1:35:14.08,Default,,0,0,0,,Мен уақыт патрульіне түсіп қаламын.
Dialogue: 0,1:35:14.16,1:35:17.12,Default,,0,0,0,,Міне!
Dialogue: 0,1:35:17.21,1:35:20.63,Default,,0,0,0,,Ха... Қандай әдемі көк.
Dialogue: 0,1:35:20.71,1:35:24.76,Default,,0,0,0,,Мен әрқашан суреттегім келген көк түсті сала аламын.
Dialogue: 0,1:35:24.84,1:35:28.47,Default,,0,0,0,,Жарайды, мен жылап жібергеніме сондай қуаныштымын.
Dialogue: 0,1:35:28.55,1:35:31.01,Default,,0,0,0,,Нені көп салғың келеді?
Dialogue: 0,1:35:31.64,1:35:32.72,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,1:35:32.81,1:35:33.68,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,1:35:33.76,1:35:38.14,Default,,0,0,0,,Мына әдемі көздерің! Бұл көздер мәңгілік...
Dialogue: 0,1:35:38.23,1:35:41.73,Default,,0,0,0,,Мен сенің көздеріңнің шынайы түсін суреттегім келді.
Dialogue: 0,1:35:41.81,1:35:43.98,Default,,0,0,0,,Өйткені мен бұл түсті шығара білуім керек.
Dialogue: 0,1:35:44.07,1:35:47.70,Default,,0,0,0,,Менің сезімімді айтып жеткізу қиын!
Dialogue: 0,1:35:47.78,1:35:50.16,Default,,0,0,0,,Иә! Хмм...
Dialogue: 0,1:35:50.24,1:35:52.45,Default,,0,0,0,,Е... бояуы жақсы болса да
Dialogue: 0,1:35:52.53,1:35:56.50,Default,,0,0,0,,Жоқ... мен жақсы сурет сала алмайтын сияқтымын.
Dialogue: 0,1:35:58.25,1:36:00.54,Default,,0,0,0,,Чай, сен керемет жұмыс жасадың.
Dialogue: 0,1:36:00.62,1:36:03.59,Default,,0,0,0,,Иә? Жарайды, бәрі жақсы.
Dialogue: 0,1:36:03.67,1:36:07.55,Default,,0,0,0,,Мен шоколад чиптерін алсам ғой
Dialogue: 0,1:36:10.34,1:36:13.64,Default,,0,0,0,,Аа, осындай жерде «жарық» бар...
Dialogue: 0,1:36:13.72,1:36:16.93,Default,,0,0,0,,Бұл қымбат болды...
Dialogue: 0,1:36:17.02,1:36:18.43,Default,,0,0,0,,Кики?
Dialogue: 0,1:36:19.85,1:36:21.94,Default,,0,0,0,,Хмм...? иә?
Dialogue: 0,1:36:22.02,1:36:23.27,Default,,0,0,0,,Чай?
Dialogue: 0,1:36:23.36,1:36:24.90,Default,,0,0,0,,Не болды?
Dialogue: 0,1:36:24.98,1:36:26.61,Default,,0,0,0,,Я...
Dialogue: 0,1:36:26.69,1:36:32.16,Default,,0,0,0,,Біз келесі жолы кездескенше шоколад чиптерін дайындап қойыңыз~
Dialogue: 0,1:36:33.49,1:36:35.53,Default,,0,0,0,,Сіз суретке қайта оралдыңыз ба?
Dialogue: 0,1:36:35.62,1:36:39.71,Default,,0,0,0,,«Кіру жарығы» қысқа тұйықталып, әсерін жоғалтты.
Dialogue: 0,1:36:39.79,1:36:42.17,Default,,0,0,0,,Ха! Клэр?
Dialogue: 0,1:36:42.25,1:36:45.13,Default,,0,0,0,,Клэр? Неліктен…?
Dialogue: 0,1:36:46.88,1:36:49.17,Default,,0,0,0,,Үндемегенім жаман болды.
Dialogue: 0,1:36:49.26,1:36:52.64,Default,,0,0,0,,Варава шын мәнінде суреттегі адам.
Dialogue: 0,1:36:52.72,1:36:54.93,Default,,0,0,0,,-Е-е... -Түсіндім...
Dialogue: 0,1:36:55.01,1:36:57.39,Default,,0,0,0,,Оның рухы кеткен жоқ па?
Dialogue: 0,1:37:01.23,1:37:04.77,Default,,0,0,0,,Мен бірге өткізген уақытты ешқашан ұмытпаймын.
Dialogue: 0,1:37:04.86,1:37:05.86,Default,,0,0,0,,Клэр!
Dialogue: 0,1:37:05.94,1:37:09.53,Default,,0,0,0,,Әкем мен шешемнің мұңын емдеу үшін.
Dialogue: 0,1:37:09.61,1:37:14.82,Default,,0,0,0,,Менің суретімді салғаны үшін Милоның әкесіне рахмет.
Dialogue: 0,1:37:15.37,1:37:16.53,Default,,0,0,0,,Мило…
Dialogue: 0,1:37:19.37,1:37:22.46,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын...
Dialogue: 0,1:37:36.22,1:37:41.89,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:37:49.78,1:37:53.20,Default,,0,0,0,,Бірақ мен барлығына өте ризамын.
Dialogue: 0,1:37:53.28,1:37:57.41,Default,,0,0,0,,Сіздердің арқаларыңызда қамал жөнделіп, барлық адамдар қалыпты жағдайға оралды.
Dialogue: 0,1:37:57.49,1:38:00.24,Default,,0,0,0,,Сізге көп рахмет...
Dialogue: 0,1:38:01.25,1:38:04.62,Default,,0,0,0,,Клэр жай ғана елес еді...
Dialogue: 0,1:38:07.33,1:38:08.34,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:08.42,1:38:10.05,Default,,0,0,0,,Пал?
Dialogue: 0,1:38:10.13,1:38:13.59,Default,,0,0,0,,үшінна шағын сыйлық.
Dialogue: 0,1:38:13.67,1:38:14.76,Default,,0,0,0,,Әй
Dialogue: 0,1:38:15.55,1:38:16.97,Default,,0,0,0,,Джажан!
Dialogue: 0,1:38:17.05,1:38:18.93,Default,,0,0,0,,-Уау! - (Патша) О, құдай!
Dialogue: 0,1:38:20.47,1:38:21.64,Default,,0,0,0,,Хехехе
Dialogue: 0,1:38:21.72,1:38:24.10,Default,,0,0,0,,- (Королева) А... - (Король) Клэр...!
Dialogue: 0,1:38:24.64,1:38:27.19,Default,,0,0,0,,-(Патшайым) Ах~ -(Патша) Ах... Тотто
Dialogue: 0,1:38:27.27,1:38:29.23,Default,,0,0,0,,Ханшайым, сенімді болыңыз!
Dialogue: 0,1:38:29.32,1:38:32.78,Default,,0,0,0,,- (Патша) Күзетші! Күзетші! -Иә...хехехе
Dialogue: 0,1:38:33.53,1:38:34.78,Default,,0,0,0,,Клэр!
Dialogue: 0,1:38:35.49,1:38:37.07,Default,,0,0,0,,Мило…
Dialogue: 0,1:38:40.20,1:38:42.33,Default,,0,0,0,,Мен Содороды ертіп барған кезде.
Dialogue: 0,1:38:42.41,1:38:45.33,Default,,0,0,0,,Мен оның кеңістік-уақыт залында қалқып бара жатқанын таптым.
Dialogue: 0,1:38:45.41,1:38:49.59,Default,,0,0,0,,Бұл төрт жыл бұрын жанын қиған Клэр, солай ма?
Dialogue: 0,1:38:49.67,1:38:51.63,Default,,0,0,0,,Сіз...
Dialogue: 0,1:38:52.96,1:38:56.30,Default,,0,0,0,,Бұл елді сақтап қалған батырлар.
Dialogue: 0,1:38:56.38,1:38:58.84,Default,,0,0,0,,Сіз білмейсіз деп ойлаймын...
Dialogue: 0,1:39:00.10,1:39:01.51,Default,,0,0,0,,Мен білемін.
Dialogue: 0,1:39:01.60,1:39:02.89,Default,,0,0,0,,А...?
Dialogue: 0,1:39:02.97,1:39:05.52,Default,,0,0,0,,Жұмбақ кеңістікте қалқып жүргенде
Dialogue: 0,1:39:05.60,1:39:08.15,Default,,0,0,0,,Мен барлық уақытта армандадым
Dialogue: 0,1:39:08.23,1:39:12.44,Default,,0,0,0,,үшінмен бірге өткізген 6 жылдық арманым...
Dialogue: 0,1:39:13.53,1:39:16.24,Default,,0,0,0,,Түсімде жеген шоколад бұршақтарының дәмі
Dialogue: 0,1:39:16.32,1:39:18.61,Default,,0,0,0,,Менің есімде дұрыс!
Dialogue: 0,1:39:19.28,1:39:21.20,Default,,0,0,0,,Уау!
Dialogue: 0,1:39:22.53,1:39:24.24,Default,,0,0,0,,Клэр!
Dialogue: 0,1:39:24.33,1:39:26.54,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,1:39:37.47,1:39:40.89,Default,,0,0,0,,Өткен күні табылған жұмбақ картина туралы кейінгі есеп.
Dialogue: 0,1:39:40.97,1:39:42.10,Default,,0,0,0,,О!
Dialogue: 0,1:39:42.18,1:39:45.97,Default,,0,0,0,,Мен жаңа жұмыс таптым!
Dialogue: 0,1:39:46.06,1:39:48.23,Default,,0,0,0,,Ахх... Мугггг...
Dialogue: 0,1:39:48.31,1:39:50.27,Default,,0,0,0,,Рабу...
Dialogue: 0,1:39:50.35,1:39:52.82,Default,,0,0,0,,Бұл шынымен жұмбақ сурет.
Dialogue: 0,1:39:52.90,1:39:55.07,Default,,0,0,0,,Бізді сызып жатыр
Dialogue: 0,1:39:55.15,1:39:56.61,Default,,0,0,0,,Бұл Мило болуы керек.
Dialogue: 0,1:39:56.69,1:40:00.82,Default,,0,0,0,,Мен суреттегі Клэр мен Чайдың өзін жалғыз сезінбесін қаладым...
Dialogue: 0,1:40:01.66,1:40:02.83,Default,,0,0,0,,Уау!
Dialogue: 0,1:40:02.91,1:40:04.41,Default,,0,0,0,,Хехехе
Dialogue: 0,1:40:05.12,1:40:08.16,Default,,0,0,0,,Бұл өте құнды жұмыс.
Dialogue: 0,1:40:08.25,1:40:11.33,Default,,0,0,0,,Жүздеген миллиондар... жоқ, миллиардтар бос сөз болар еді.
Dialogue: 0,1:40:11.42,1:40:13.25,Default,,0,0,0,,Миллиардтар?
Dialogue: 0,1:40:13.34,1:40:16.34,Default,,0,0,0,,Мен біреуін алуым керек еді...
Dialogue: 0,1:40:16.42,1:40:19.22,Default,,0,0,0,,Міне, мен тағы бір фотосуретті таптым.
Dialogue: 0,1:40:19.30,1:40:21.05,Default,,0,0,0,,Ахх... Муггг...
Dialogue: 0,1:40:21.14,1:40:24.22,Default,,0,0,0,,Ортағасырлық балалар граффитиіне ұқсайды
Dialogue: 0,1:40:24.30,1:40:27.22,Default,,0,0,0,,Жарайды, мүлде жақсы деп айта алмаймын.
Dialogue: 0,1:40:27.31,1:40:29.94,Default,,0,0,0,,Бұл мүлде тұрмайтын шығар.
Dialogue: 0,1:40:30.02,1:40:31.27,Default,,0,0,0,,Уау!
Dialogue: 0,1:40:31.35,1:40:34.48,Default,,0,0,0,,Бұл әлемді құтқарған сурет.
Dialogue: 0,1:40:34.57,1:40:36.40,Default,,0,0,0,,Не дедің!
Dialogue: 0,1:40:36.48,1:40:38.86,Default,,0,0,0,,Менің көретін көзім жоқ.
Dialogue: 0,1:40:38.94,1:40:40.07,Default,,0,0,0,,А...?
Dialogue: 0,1:40:40.15,1:40:43.78,Default,,0,0,0,,Мынаны қарашы... бұл иті иті ме, әлде бірдеңе.
Dialogue: 0,1:40:43.87,1:40:44.74,Default,,0,0,0,,Сен оны білесің бе, Аводөл? (Аводөл) Ах… өте
Dialogue: 0,1:40:44.83,1:40:48.45,Default,,0,0,0,,Сізге ұнайтынын анық көріп тұрмын.
Dialogue: 0,1:40:48.54,1:40:52.08,Default,,0,0,0,,Бірақ бұл күлкілі.
Dialogue: 0,1:40:52.17,1:40:57.05,Default,,0,0,0,,Сол кезде бір бала оны бар күшімен салғанына сенімдімін.
Dialogue: 0,1:40:57.17,1:40:58.38,Default,,0,0,0,,Иә
Dialogue: 0,1:40:58.46,1:41:03.30,Default,,0,0,0,,Бұл эмоцияға толы әдемі сурет.
Dialogue: 0,1:41:05.30,1:41:06.81,Default,,0,0,0,,Уау!
Dialogue: 0,1:41:06.89,1:41:08.85,Default,,0,0,0,,Хэхе... хехе
Dialogue: 0,1:41:08.93,1:41:11.31,Default,,0,0,0,,Әке, сіздің позаңыз өзгерді!
Dialogue: 0,1:41:11.39,1:41:13.60,Default,,0,0,0,,Аа... Кешіріңіз, кешіріңіз.
Dialogue: 0,1:41:14.98,1:41:16.48,Default,,0,0,0,,Хехехе
Dialogue: 0,1:41:16.57,1:41:20.40,Default,,0,0,0,,Енді түскі асқа дайындалайық па?
Dialogue: 0,1:41:20.49,1:41:22.57,Default,,0,0,0,,Иә! Түскі асқа не бар?
Dialogue: 0,1:41:22.65,1:41:25.20,Default,,0,0,0,,Уа, саған не керек?
Dialogue: 0,1:41:25.28,1:41:26.91,Default,,0,0,0,,Ал, сәлем.
Dialogue: 0,1:41:26.99,1:41:28.99,Default,,0,0,0,,Нагаши Сомен!
Dialogue: 0,1:41:33.83,1:41:38.84,Default,,0,0,0,,♪～
Dialogue: 0,1:44:25.09,1:44:30.09,Default,,0,0,0,,～♪
