Dialogue: 0,0:02:26.07,0:03:06.07,gg,NTP,0000,0000,0000,Banner;8;0;20,Бұл субтитр Eien Subtitle Group компаниясының туындысы, хабарландыру тақтасының мекенжайы: http://www.eien-acg.com Ол тек білім беру мақсатында жасалған, сондықтан оны коммерциялық мақсатта пайдаланбаңыз. Жүктеп алғаннан кейін оны 24 сағат ішінде жойыңыз. Жазушы: Юкчи Түзету: Мушитан Уақыт осі: Юкчи Чоре: Геня Мицуруги Энко: Геня Мицуруги
Dialogue: 0,0:01:30.61,0:01:35.86,*Default,NTP,0000,0000,0000,,Менің атым Такуми Сайджо, 17 жаста, Суимей Академиясының екінші курсында.
Dialogue: 0,0:01:36.23,0:01:39.12,*Default,NTP,0000,0000,0000,,Мен отакумын, оның хоббиі интернет ойындары мен аниме.
Dialogue: 0,0:01:39.96,0:01:41.93,*Default,NTP,0000,0000,0000,,Мен қазір тұратын Шибуяда
Dialogue: 0,0:01:42.46,0:01:45.89,*Default,NTP,0000,0000,0000,,Жаңа Ген деп аталатын жұмбақ оқиғалар тізбегі орын алуда.
Dialogue: 0,0:01:46.74,0:01:49.85,*Default,NTP,0000,0000,0000,,Мен үш өлшемді заттарға қызығушылық танытпадым.
Dialogue: 0,0:01:50.74,0:01:54.17,*Default,NTP,0000,0000,0000,,Бір күні мен кенеттен бірінші рет генералмен сөйлестім.
Dialogue: 0,0:01:54.24,0:01:56.27,*Default,NTP,0000,0000,0000,,Маған жаңа ұрпақты болжайтын сурет көрсетілді.
Dialogue: 0,0:01:56.57,0:01:59.68,*Default,NTP,0000,0000,0000,,Және сол сурет сияқты қылмыс болған жер.
Dialogue: 0,0:02:00.07,0:02:02.23,*Default,NTP,0000,0000,0000,,Мен оның куәсі болдым.
Dialogue: 0,0:02:03.30,0:02:06.60,*Default,NTP,0000,0000,0000,,Оның үстіне, кінәлі болып көрінген орта мектептегі бір қыз бар еді.
Dialogue: 0,0:02:09.89,0:02:14.01,*Default,NTP,0000,0000,0000,,Ол тағы да менің алдымда көрінді
Dialogue: 0,0:02:20.17,0:02:21.38,*Default,NTP,0000,0000,0000,,Ах...
Dialogue: 0,0:02:24.36,0:02:25.47,*Default,NTP,0000,0000,0000,,Ібіліс әйел
Dialogue: 0,0:02:33.32,0:02:34.51,*Default,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:02:34.57,0:02:37.79,*Default,NTP,0000,0000,0000,,Ой, сен мұнда неге келдің?
Dialogue: 0,0:02:38.07,0:02:40.72,*Default,NTP,0000,0000,0000,,Өтінемін, мені өлтірме.
Dialogue: 0,0:02:40.75,0:02:42.11,*Default,NTP,0000,0000,0000,,Өтінемін, өтінемін.
Dialogue: 0,0:02:42.19,0:02:45.32,*Default,NTP,0000,0000,0000,,Бичи! Өзіңізбен сөйлесуді тоқтатыңыз
Dialogue: 0,0:02:45.65,0:02:47.85,*Default,NTP,0000,0000,0000,,Не туралы айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:02:50.96,0:02:52.07,*Default,NTP,0000,0000,0000,,Эй, сен тұра аласың ба?
Dialogue: 0,0:02:52.69,0:02:53.16,*Default,NTP,0000,0000,0000,,Тұр
Dialogue: 0,0:02:53.22,0:02:54.38,*Default,NTP,0000,0000,0000,,Оған қол тигізбеңіз
Dialogue: 0,0:02:55.91,0:02:59.61,*Default,NTP,0000,0000,0000,,Мен сенің біреуді өлтіріп жатқаныңды көрдім.
Dialogue: 0,0:03:00.82,0:03:04.96,*Default,NTP,0000,0000,0000,,Эй, бұл өте қорқынышты нәрсе екенін түсінесің бе?
Dialogue: 0,0:03:05.07,0:03:07.82,*Default,NTP,0000,0000,0000,,Мені де өлтіресің.
Dialogue: 0,0:03:07.89,0:03:12.59,*Default,NTP,0000,0000,0000,,Мені ешқашан кісі өлтіруші деп атайды деп ойламадым.
Dialogue: 0,0:03:12.59,0:03:15.63,*Default,NTP,0000,0000,0000,,Маған оны жіберіп алуға көмектесіңіз
Dialogue: 0,0:03:15.78,0:03:19.49,*Default,NTP,0000,0000,0000,,Сәлеметсіз бе, сәл тынышталайық.
Dialogue: 0,0:03:21.61,0:03:22.45,*Default,NTP,0000,0000,0000,,Таку
Dialogue: 0,0:03:23.25,0:03:27.26,*Default,NTP,0000,0000,0000,,Сіз қайдан білесіз? менің атым
Dialogue: 0,0:03:27.50,0:03:30.20,*Default,NTP,0000,0000,0000,,Әрине, біз доспыз.
Dialogue: 0,0:03:30.48,0:03:31.55,*Default,NTP,0000,0000,0000,,Сау бол, Джоджо!
Dialogue: 0,0:03:32.44,0:03:34.92,*Default,NTP,0000,0000,0000,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:03:35.54,0:03:39.19,*Default,NTP,0000,0000,0000,,Менің сынақ ұпайларым онша жақсы болмаса да, бұл менмін.
Dialogue: 0,0:03:39.59,0:03:43.70,*Default,NTP,0000,0000,0000,,Менің бетіме солай айтсаң, мен жараланып қаламын.
Dialogue: 0,0:03:43.95,0:03:45.01,*Default,NTP,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:03:45.12,0:03:50.55,*Default,NTP,0000,0000,0000,,Фува Таку сыныптастарының жүздерін есіне түсіре алмайды, бұл өте қорқынышты~
Dialogue: 0,0:03:50.98,0:03:55.09,*Default,NTP,0000,0000,0000,,Бірақ көмектесу мүмкін емес, Таку мектепке көп келмейді.
Dialogue: 0,0:03:56.37,0:03:58.80,*Default,NTP,0000,0000,0000,,Сіз шынымен менің атымды ұмыттыңыз ба?
Dialogue: 0,0:03:59.60,0:04:00.79,*Default,NTP,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:04:01.22,0:04:02.35,*Default,NTP,0000,0000,0000,,Сіз мұны білесіз.
Dialogue: 0,0:04:03.48,0:04:05.10,*Default,NTP,0000,0000,0000,,Сіз білуіңіз керек
Dialogue: 0,0:04:08.49,0:04:09.74,*Default,NTP,0000,0000,0000,,Ri…mi…
Dialogue: 0,0:04:10.07,0:04:11.64,*Default,NTP,0000,0000,0000,,Керемет жауап
Dialogue: 0,0:04:13.69,0:04:16.39,*Default,NTP,0000,0000,0000,,Мен Сакибата Нашибукамын.
Dialogue: 0,0:04:17.06,0:04:20.77,*Default,NTP,0000,0000,0000,,Есіңізде болса керек. Жақсы, жақсы.
Dialogue: 0,0:04:21.28,0:04:25.94,*Default,NTP,0000,0000,0000,,Мен бұл баланың атын қайдан білемін?
Dialogue: 0,0:04:26.35,0:04:27.51,*Default,NTP,0000,0000,0000,,Әй, екеуің.
Dialogue: 0,0:04:27.54,0:04:28.20,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:04:28.76,0:04:30.87,*Default,NTP,0000,0000,0000,,О, қайырлы таң.
Dialogue: 0,0:04:31.03,0:04:33.55,*Default,NTP,0000,0000,0000,,Әлі де жақсы араласатын сияқтысыңдар.
Dialogue: 0,0:04:33.79,0:04:35.55,*Default,NTP,0000,0000,0000,,Жақсырақ, кездессек ше?
Dialogue: 0,0:04:35.58,0:04:37.87,*Default,NTP,0000,0000,0000,,Оның орнына мені тыңда, үлкен бала.
Dialogue: 0,0:04:38.02,0:04:39.73,*Default,NTP,0000,0000,0000,,Егер сіз оны алсаңыз, бұл қорқынышты.
Dialogue: 0,0:04:39.82,0:04:41.56,*Default,NTP,0000,0000,0000,,Қазір бұл не?
Dialogue: 0,0:04:42.14,0:04:45.88,*Default,NTP,0000,0000,0000,,Сосын жын әйел екеуіміз бірге болған жағдай сияқты.
Dialogue: 0,0:04:46.04,0:04:47.47,*Default,NTP,0000,0000,0000,,Бұл күнделікті нәрсе сияқты емес пе?
Dialogue: 0,0:04:47.51,0:04:48.37,*Default,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:04:48.43,0:04:49.06,*Default,NTP,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:04:49.72,0:04:52.80,*Default,NTP,0000,0000,0000,,Сіз мектепке анда-санда келетіндіктен ұмытып қалдыңыз ба?
Dialogue: 0,0:04:53.38,0:04:57.17,*Default,NTP,0000,0000,0000,,Менен басқа, сен бірінші курстан бері бір сыныпта оқисың.
Dialogue: 0,0:04:57.16,0:04:59.23,*Default,NTP,0000,0000,0000,,Бірінші жылдан бері?
Dialogue: 0,0:04:59.52,0:05:02.40,*Default,NTP,0000,0000,0000,,Өткенде үшеуміз көңіл көтеруге шықтық, солай ма?
Dialogue: 0,0:05:03.58,0:05:04.22,*Default,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:05:06.91,0:05:07.75,*Default,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,0:05:08.09,0:05:10.29,*Default,NTP,0000,0000,0000,,NEET ретінде сізді кім ойлайды?
Dialogue: 0,0:05:10.60,0:05:13.20,*Default,NTP,0000,0000,0000,,Дүние кең болса да, бұл тек мен және Нашибука туралы.
Dialogue: 0,0:05:13.33,0:05:14.72,*Default,NTP,0000,0000,0000,,Бұл тым көп
Dialogue: 0,0:05:15.94,0:05:16.92,*Default,NTP,0000,0000,0000,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:05:29.82,0:05:33.52,*Default,NTP,0000,0000,0000,,Мен мұндай әйелді бұрын-соңды сыныпта көрмегенмін...
Dialogue: 0,0:05:34.01,0:05:35.08,*Default,NTP,0000,0000,0000,,Бізді азық-түлік таситын жүк арбаларынан да жақсы қарайды
Dialogue: 0,0:05:35.93,0:05:37.76,*Default,NTP,0000,0000,0000,,Жоқ, нақты айта алмаймын.
Dialogue: 0,0:05:38.16,0:05:41.04,*Default,NTP,0000,0000,0000,,Менде тағы да қорқынышты адасушылық пайда болды, Таки.
Dialogue: 0,0:05:41.14,0:05:42.79,*Default,NTP,0000,0000,0000,,Жұлдыз келді
Dialogue: 0,0:05:42.90,0:05:46.04,*Default,NTP,0000,0000,0000,,Әй, шайтан әйел тек алдау...
Dialogue: 0,0:05:46.30,0:05:48.41,*Default,NTP,0000,0000,0000,,Бұл адасушылық. Бұл адасушылық.
Dialogue: 0,0:05:48.43,0:05:49.73,*Default,NTP,0000,0000,0000,,Бір қолымда оқталған винтовка ұстап
Dialogue: 0,0:05:49.82,0:05:51.60,*Default,NTP,0000,0000,0000,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:05:51.78,0:05:54.03,*Default,NTP,0000,0000,0000,,Егер мұны жасасаңыз, ол бірден жоғалады.
Dialogue: 0,0:05:54.33,0:05:56.03,*Default,NTP,0000,0000,0000,,Одан да ынталы бол.
Dialogue: 0,0:05:59.47,0:06:03.31,*Default,NTP,0000,0000,0000,,Дұрыс, 3D туралы алаңдамаудың қажеті жоқ.
Dialogue: 0,0:06:03.39,0:06:04.37,*Default,NTP,0000,0000,0000,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:06:04.62,0:06:09.03,*Default,NTP,0000,0000,0000,,Иә, мен интернет ойындар әлеміндегі құдаймын.
Dialogue: 0,0:06:09.14,0:06:10.07,*Default,NTP,0000,0000,0000,,Рух
Dialogue: 0,0:06:11.05,0:06:11.61,*Default,NTP,0000,0000,0000,,Таку
Dialogue: 0,0:06:11.78,0:06:12.39,*Default,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:06:15.71,0:06:16.46,*Default,NTP,0000,0000,0000,,Уау
Dialogue: 0,0:06:17.32,0:06:19.33,*Default,NTP,0000,0000,0000,,Қайда жүгірсең де пайдасы жоқ.
Dialogue: 0,0:06:20.55,0:06:22.02,*Default,NTP,0000,0000,0000,,Мен оны міндетті түрде табамын
Dialogue: 0,0:06:24.06,0:06:27.31,*Default,NTP,0000,0000,0000,,Мен де Такуды қоямын.
Dialogue: 0,0:06:35.88,0:06:39.58,*Default,NTP,0000,0000,0000,,Бұл да адасушылық болды ма? Мен қуаныштымын.
Dialogue: 0,0:06:39.58,0:06:43.14,*Default,NTP,0000,0000,0000,,Таку: Сіз оны дұрыс құлыптауыңыз керек.
Dialogue: 0,0:06:43.54,0:06:45.65,*Default,NTP,0000,0000,0000,,Соңғы уақытта көп қиындық болды.
Dialogue: 0,0:06:46.33,0:06:47.80,*Default,NTP,0000,0000,0000,,Иә, бұл Шоко-сан. Мен қазір осындамын, бәрі жақсы.
Dialogue: 0,0:06:47.93,0:06:50.91,*Default,NTP,0000,0000,0000,,Такудың Сейра-чаны Мен келген сайын саны көбейеді.
Dialogue: 0,0:06:51.00,0:06:53.24,*Default,NTP,0000,0000,0000,,Бұл шынайы.
Dialogue: 0,0:06:54.53,0:06:58.42,*Default,NTP,0000,0000,0000,,Әй, бұл алдын ала ояту нұсқасы емес пе?
Dialogue: 0,0:06:59.08,0:07:03.11,*Default,NTP,0000,0000,0000,,Ойланып қарасам, жақында оянғаннан кейінгі нұсқасы шығады, солай ма?
Dialogue: 0,0:07:03.17,0:07:04.74,*Default,NTP,0000,0000,0000,,Неліктен олай істедің?
Dialogue: 0,0:07:05.00,0:07:07.87,*Default,NTP,0000,0000,0000,,Таку сізге айтты, солай ма?
Dialogue: 0,0:07:08.01,0:07:09.39,*Default,NTP,0000,0000,0000,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:07:09.78,0:07:12.62,*Default,NTP,0000,0000,0000,,Ал, сен мұнда не үшін келдің?
Dialogue: 0,0:07:13.38,0:07:15.64,*Default,NTP,0000,0000,0000,,Өйткені ол мектепте жаман күн өткізетін сияқты.
Dialogue: 0,0:07:15.89,0:07:17.32,*Default,NTP,0000,0000,0000,,Мен сені тексеруге келдім.
Dialogue: 0,0:07:18.82,0:07:20.76,*Default,NTP,0000,0000,0000,,Бұл әлі де ауыр көрінеді.
Dialogue: 0,0:07:21.48,0:07:24.96,*Default,NTP,0000,0000,0000,,Иә, мен саған нәрлі бірдеңе дайындаймын.
Dialogue: 0,0:07:25.44,0:07:26.32,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:27.74,0:07:28.40,*Default,NTP,0000,0000,0000,,Таку
Dialogue: 0,0:07:28.48,0:07:29.68,*Default,NTP,0000,0000,0000,,Қайтып кел!
Dialogue: 0,0:07:34.39,0:07:36.32,*Default,NTP,0000,0000,0000,,Инспектор, сіздің баяндамаңыз.
Dialogue: 0,0:07:37.75,0:07:40.87,*Default,NTP,0000,0000,0000,,Инспектордың орынбасары Хан, тыңдап тұрсың ба?
Dialogue: 0,0:07:40.93,0:07:43.20,*Default,NTP,0000,0000,0000,,Мені Хан мырза шақырып жатыр.
Dialogue: 0,0:07:44.27,0:07:47.81,*Default,NTP,0000,0000,0000,,Аа, кешіріңіз. Сувадан репортаж.
Dialogue: 0,0:07:47.89,0:07:49.58,*Default,NTP,0000,0000,0000,,Мен бе?
Dialogue: 0,0:07:49.70,0:07:50.59,*Default,NTP,0000,0000,0000,,Мен жеңдім
Dialogue: 0,0:07:50.61,0:07:51.08,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:07:53.28,0:07:56.21,*Default,NTP,0000,0000,0000,,Қылмыс болған жердің жанындағы бейнебақылау камераларының талдауы шығарылды.
Dialogue: 0,0:07:56.24,0:07:56.99,*Default,NTP,0000,0000,0000,,Кохон
Dialogue: 0,0:07:58.01,0:07:58.81,*Default,NTP,0000,0000,0000,,шықты
Dialogue: 0,0:07:59.11,0:08:01.54,*Default,NTP,0000,0000,0000,,Қылмыс жасаған кезде күдікті адам көрінді.
Dialogue: 0,0:08:02.62,0:08:03.59,*Default,NTP,0000,0000,0000,,Бейнені көрсетіңіз
Dialogue: 0,0:08:05.17,0:08:08.36,*Default,NTP,0000,0000,0000,,Қылмыс орнынан шамамен 50 метр
Dialogue: 0,0:08:08.39,0:08:10.18,*Default,NTP,0000,0000,0000,,Бұл тиындар тұрағындағы бақылау камерасы.
Dialogue: 0,0:08:10.72,0:08:12.74,*Default,NTP,0000,0000,0000,,Қылмыс орнындағы тұрғындардың айғақтары бойынша
Dialogue: 0,0:08:13.00,0:08:15.65,*Default,NTP,0000,0000,0000,,Сағат 21:00-ден 21:30-ға дейін
Dialogue: 0,0:08:15.86,0:08:18.61,*Default,NTP,0000,0000,0000,,Шеге соғылғандай естілді дейді.
Dialogue: 0,0:08:18.68,0:08:20.30,*Default,NTP,0000,0000,0000,,Сіз білетіндей,
Dialogue: 0,0:08:23.50,0:08:26.43,*Default,NTP,0000,0000,0000,,Бұл бейне 21:34-те жарияланған
Dialogue: 0,0:08:27.64,0:08:31.48,*Default,NTP,0000,0000,0000,,Бұл қылмыстан кейін болғанын білдіреді.
Dialogue: 0,0:08:32.99,0:08:36.73,*Default,NTP,0000,0000,0000,,Сот сараптамасы ғылыми-зерттеу институтының талдауы нәтижесінде бейнедегі адам ер адам.
Dialogue: 0,0:08:37.12,0:08:40.93,*Default,NTP,0000,0000,0000,,Оның жасы 20-дан асқан жас шамасындағы...
Dialogue: 0,0:08:41.60,0:08:45.71,*Default,NTP,0000,0000,0000,,Бұл киім Suimei Private Academy-ден келген ұлдың формасы болып шықты.
Dialogue: 0,0:08:46.33,0:08:49.40,*Default,NTP,0000,0000,0000,,Сонымен қатар, оң қолыңызға назар аударғаныңызды қалаймын...
Dialogue: 0,0:08:49.79,0:08:52.76,*Default,NTP,0000,0000,0000,,Бұл «мен ұстап тұрған нәрсе»
Dialogue: 0,0:08:53.07,0:08:58.68,*Default,NTP,0000,0000,0000,,Оның пішініне қарағанда, бұл қылмыста пайдаланылған темір қазық болуы мүмкін.
Dialogue: 0,0:08:58.93,0:09:03.54,*Default,NTP,0000,0000,0000,,Бұл бала қылмыскерге ең жақын адам екенін білдіре ме?
Dialogue: 0,0:09:03.67,0:09:05.41,*Default,NTP,0000,0000,0000,,Аа, міне, осыны білдіреді.
Dialogue: 0,0:09:05.80,0:09:08.59,*Default,NTP,0000,0000,0000,,Сенпай, дәмді бөлікті ал.
Dialogue: 0,0:09:08.94,0:09:11.05,*Default,NTP,0000,0000,0000,,Ақыры құйрығымды шығардым.
Dialogue: 0,0:09:11.58,0:09:15.42,*Default,NTP,0000,0000,0000,,Мен оны ұстап алуым керек және ешқашан жібермеуім керек.
Dialogue: 0,0:09:17.99,0:09:20.33,*Default,NTP,0000,0000,0000,,Бұл туралы алаңдама Бұл туралы алаңдама
Dialogue: 0,0:09:21.08,0:09:22.61,*Default,NTP,0000,0000,0000,,Ібіліс әйел – адасушы
Dialogue: 0,0:09:23.00,0:09:25.56,*Default,NTP,0000,0000,0000,,Жұлдыз келді, маған күш бер.
Dialogue: 0,0:09:28.32,0:09:30.37,*Default,NTP,0000,0000,0000,,Әйтеуір... тағы да сол жігіт
Dialogue: 0,0:09:30.99,0:09:34.73,*Default,NTP,0000,0000,0000,,Кешіріңіз, Сайджо-кун, сіз осындасыз ба?
Dialogue: 0,0:09:35.17,0:09:38.96,*Default,NTP,0000,0000,0000,,Бұл дауыс...Юай
Dialogue: 0,0:09:42.08,0:09:45.19,*Default,NTP,0000,0000,0000,,Бұл есіңізде ме? бүгінгі уәде
Dialogue: 0,0:09:45.54,0:09:46.16,*Default,NTP,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:09:46.60,0:09:50.34,*Default,NTP,0000,0000,0000,,Қараңдар, ол маған Сейра-чанның фигурасына тапсырыс беруге көмектеспекші.
Dialogue: 0,0:09:51.42,0:09:55.67,*Default,NTP,0000,0000,0000,,Дұрыс, жын-шайтанның кесірінен мүлде ұмытып кеттім.
Dialogue: 0,0:10:01.94,0:10:05.18,*Default,NTP,0000,0000,0000,,Мені алып кетуге келгеніңізде бұл мазасыздық болды ма?
Dialogue: 0,0:10:05.94,0:10:07.73,*Default,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:10:09.21,0:10:12.25,*Default,NTP,0000,0000,0000,,Кешіріңіз, бұл өткен күні ғана болды.
Dialogue: 0,0:10:12.36,0:10:14.11,*Default,NTP,0000,0000,0000,,Мен бұл өтінішті жасадым
Dialogue: 0,0:10:15.64,0:10:16.18,*Default,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:10:27.66,0:10:33.21,*Default,NTP,0000,0000,0000,,Жоқ, бұл ауырады. Тезірек жұмысымызды аяқтап, базаға оралайық.
Dialogue: 0,0:10:33.36,0:10:34.01,*Default,NTP,0000,0000,0000,,Onii
Dialogue: 0,0:10:34.08,0:10:35.69,*Default,NTP,0000,0000,0000,,Нанами
Dialogue: 0,0:10:36.31,0:10:38.43,*Default,NTP,0000,0000,0000,,Мүмкін Ониидің құрбысы шығар?
Dialogue: 0,0:10:38.91,0:10:40.56,*Default,NTP,0000,0000,0000,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:10:41.19,0:10:44.30,*Default,NTP,0000,0000,0000,,Fi, мен тек фигураларды ескертемін.
Dialogue: 0,0:10:44.87,0:10:46.66,*Default,NTP,0000,0000,0000,,Қуыршақ сенің досың ба?
Dialogue: 0,0:10:47.15,0:10:49.72,*Default,NTP,0000,0000,0000,,Дұрыс, менің қызым жоқ.
Dialogue: 0,0:10:49.72,0:10:53.06,*Default,NTP,0000,0000,0000,,Менің атым Юа Кусуноки.
Dialogue: 0,0:10:53.59,0:10:55.48,*Default,NTP,0000,0000,0000,,А, бұл менің әпкем Нанами.
Dialogue: 0,0:10:55.96,0:10:59.31,*Default,NTP,0000,0000,0000,,Асыл ағаммен кездескенім үшін кешірім сұраймын.
Dialogue: 0,0:10:59.36,0:11:00.83,*Default,NTP,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:11:00.99,0:11:04.51,*Default,NTP,0000,0000,0000,,Менің ағам жалқау, бірақ онымен жақсы дос болыңыз.
Dialogue: 0,0:11:07.09,0:11:08.13,*Default,NTP,0000,0000,0000,,Біраз онии
Dialogue: 0,0:11:08.39,0:11:09.95,*Default,NTP,0000,0000,0000,,Сіз дұрыс сөйлесе аласыз ба?
Dialogue: 0,0:11:10.34,0:11:13.73,*Default,NTP,0000,0000,0000,,Әйел достарым бар екенін елестете алмаймын.
Dialogue: 0,0:11:13.89,0:11:15.38,*Default,NTP,0000,0000,0000,,Мықты болу керек
Dialogue: 0,0:11:15.58,0:11:16.36,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:11:19.51,0:11:22.30,*Default,NTP,0000,0000,0000,,Уау, мен қобалжыдым.
Dialogue: 0,0:11:22.78,0:11:25.44,*Default,NTP,0000,0000,0000,,Өтінемін, ол жерге қайтып оралмаңыз.
Dialogue: 0,0:11:25.83,0:11:26.95,*Default,NTP,0000,0000,0000,,Ааа
Dialogue: 0,0:11:42.39,0:11:45.79,*Default,NTP,0000,0000,0000,,Кешіріңіз, мен сізді вокзалға апаруым керек болды.
Dialogue: 0,0:11:45.96,0:11:47.47,*Default,NTP,0000,0000,0000,,Тіпті менің жүгімді алып кетіңіз
Dialogue: 0,0:11:47.83,0:11:49.26,*Default,NTP,0000,0000,0000,,Жоқ, бәрі жақсы.
Dialogue: 0,0:11:49.83,0:11:52.72,*Default,NTP,0000,0000,0000,,Сайджо-кун, сенде ұялы телефон жоқ па?
Dialogue: 0,0:11:54.43,0:11:56.45,*Default,NTP,0000,0000,0000,,Онда біз сізбен байланыса алмаймыз.
Dialogue: 0,0:11:56.75,0:11:58.09,*Default,NTP,0000,0000,0000,,Қайта байланысу керек пе?
Dialogue: 0,0:11:58.44,0:12:01.55,*Default,NTP,0000,0000,0000,,Ах, бірақ Сайджо-кун, сенің компьютерің бар еді ғой, солай ма?
Dialogue: 0,0:12:01.81,0:12:04.29,*Default,NTP,0000,0000,0000,,Электрондық пошта мекенжайларымен алмасуды қалайсыз ба?
Dialogue: 0,0:12:05.04,0:12:06.02,*Default,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:12:06.55,0:12:10.44,*Default,NTP,0000,0000,0000,,Eso фигурасының шығу күні
Dialogue: 0,0:12:10.74,0:12:12.94,*Default,NTP,0000,0000,0000,,Мен оны алуым керек.
Dialogue: 0,0:12:13.51,0:12:16.90,*Default,NTP,0000,0000,0000,,Менде әлі жалғыз Animate 8-ге баруға батылым жетпейді.
Dialogue: 0,0:12:17.97,0:12:21.49,*Default,NTP,0000,0000,0000,,Ал мен, Сайджо-кун, тағы басқалар...
Dialogue: 0,0:12:22.34,0:12:24.04,*Default,NTP,0000,0000,0000,,Себебі мен дос болғым келеді
Dialogue: 0,0:12:35.04,0:12:37.15,*Default,NTP,0000,0000,0000,,Бұл электрондық пошта~ Бөкенасу
Dialogue: 0,0:12:39.27,0:12:41.58,*Default,NTP,0000,0000,0000,,Ой, мен бірден келдім.
Dialogue: 0,0:12:42.70,0:12:44.53,*Default,NTP,0000,0000,0000,,«Қайырлы кеш, бұл Кусуноки».
Dialogue: 0,0:12:44.83,0:12:46.72,*Default,NTP,0000,0000,0000,,«Мен сізге бірден электрондық хат жібердім.»
Dialogue: 0,0:12:47.07,0:12:49.60,*Default,NTP,0000,0000,0000,,«Бүгін сенімен жүргенім үшін кешірім сұраймын».
Dialogue: 0,0:12:50.03,0:12:52.14,*Default,NTP,0000,0000,0000,,«Бірақ мен көп көңілді болдым».
Dialogue: 0,0:12:52.54,0:12:55.24,*Default,NTP,0000,0000,0000,,«Мүмкін мұндай дүкенге бірінші рет барғандықтан болар».
Dialogue: 0,0:12:56.09,0:13:00.89,*Default,NTP,0000,0000,0000,,«Немесе Сайджо-кун менімен бірге болған шығар... (lol)»
Dialogue: 0,0:13:01.32,0:13:04.48,*Default,NTP,0000,0000,0000,,«Сайджо-кун ертең сабаққа нешеде келеді?»
Dialogue: 0,0:13:04.83,0:13:07.53,*Default,NTP,0000,0000,0000,,«Аа, мұны неге сұрағың келді?»
Dialogue: 0,0:13:07.75,0:13:10.08,*Default,NTP,0000,0000,0000,,«Мен таңертең сәлем айтқым келеді...»
Dialogue: 0,0:13:10.48,0:13:14.72,*Default,NTP,0000,0000,0000,,«Таңертең кездейсоқ кездессек жақсы болар еді».
Dialogue: 0,0:13:15.16,0:13:16.95,*Default,NTP,0000,0000,0000,,«Онда мен сізге қайтадан электрондық хат жіберемін.»
Dialogue: 0,0:13:17.30,0:13:18.37,*Default,NTP,0000,0000,0000,,«Қайырлы түн (^ _ ^)/~~»
Dialogue: 0,0:13:19.01,0:13:21.30,*Default,NTP,0000,0000,0000,,Жауап Оны жібересіз бе?
Dialogue: 0,0:13:22.33,0:13:25.58,*Default,NTP,0000,0000,0000,,шын мәнінде екі өлшемдегі ең жақсысы
Dialogue: 0,0:13:25.79,0:13:27.45,*Default,NTP,0000,0000,0000,,Тек екі өлшем болуы мүмкін
Dialogue: 0,0:13:32.47,0:13:33.12,*Default,NTP,0000,0000,0000,,Жабысқақ
Dialogue: 0,0:13:33.17,0:13:35.78,*Default,NTP,0000,0000,0000,,Хахаха...қытықтайды
Dialogue: 0,0:13:44.67,0:13:46.19,*Default,NTP,0000,0000,0000,,Кімді іздеп жүрсіз?
Dialogue: 0,0:13:46.49,0:13:46.89,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:13:47.38,0:13:48.44,*Default,NTP,0000,0000,0000,,Мен сізге қоңырау шаламын.
Dialogue: 0,0:13:48.88,0:13:52.08,*Default,NTP,0000,0000,0000,,Рахмет, Сайджо-кун...
Dialogue: 0,0:13:52.52,0:13:55.13,*Default,NTP,0000,0000,0000,,Таку? Менде бүгін демалыс бар
Dialogue: 0,0:13:55.61,0:13:56.73,*Default,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:13:58.11,0:13:59.36,*Default,NTP,0000,0000,0000,,Такудың досы ма?
Dialogue: 0,0:13:59.52,0:14:00.10,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:14:00.32,0:14:04.65,*Default,NTP,0000,0000,0000,,Мен Такудың осындай әдемі досы болғанына таң қалдым.
Dialogue: 0,0:14:05.01,0:14:06.67,*Default,NTP,0000,0000,0000,,Біз жақында ғана кездестік.
Dialogue: 0,0:14:07.38,0:14:11.53,*Default,NTP,0000,0000,0000,,Бірақ Сайджо-кун кеше менімен бірге дүкен аралауға барды.
Dialogue: 0,0:14:11.97,0:14:13.40,*Default,NTP,0000,0000,0000,,Біз бірге шықтық.
Dialogue: 0,0:14:14.25,0:14:16.45,*Default,NTP,0000,0000,0000,,Сіз тағы бірдеңе істедіңіз бе?
Dialogue: 0,0:14:16.72,0:14:17.46,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:14:18.31,0:14:19.91,*Default,NTP,0000,0000,0000,,Әсіресе сатып алудан басқа заттарға.
Dialogue: 0,0:14:20.35,0:14:22.56,*Default,NTP,0000,0000,0000,,А, жақсы.
Dialogue: 0,0:14:23.13,0:14:24.92,*Default,NTP,0000,0000,0000,,Сізден біртүрлі нәрсе сұрағаным үшін кешіріңіз.
Dialogue: 0,0:14:25.18,0:14:26.56,*Default,NTP,0000,0000,0000,,Иә Жоқ
Dialogue: 0,0:14:37.50,0:14:40.93,*Default,NTP,0000,0000,0000,,Кім не десе де, шайтан әйел – адасушы.
Dialogue: 0,0:14:41.36,0:14:43.98,*Default,NTP,0000,0000,0000,,Мен жұлдыздардың келгеніне ғана сенемін.
Dialogue: 0,0:14:44.60,0:14:46.01,*Default,NTP,0000,0000,0000,,Сайджо-кун~
Dialogue: 0,0:14:46.08,0:14:46.47,*Default,NTP,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:14:47.82,0:14:51.62,*Default,NTP,0000,0000,0000,,Мен оны Сайджо-кун деп ойладым, өйткені оны арт жағынан көріп тұрдым.
Dialogue: 0,0:14:52.92,0:14:54.72,*Default,NTP,0000,0000,0000,,Мен оның артынан жүгірдім
Dialogue: 0,0:14:55.56,0:14:57.35,*Default,NTP,0000,0000,0000,,Қайырлы таң Сайджо-кун
Dialogue: 0,0:14:58.25,0:15:02.32,*Default,NTP,0000,0000,0000,,Мен бас тартқан жоқпын. Менен не күтесің?
Dialogue: 0,0:15:03.80,0:15:06.73,*Default,NTP,0000,0000,0000,,Мен Сайджо-кунды жақсы көремін
Dialogue: 0,0:15:09.03,0:15:16.83,*Default,NTP,0000,0000,0000,,Менмін, менмін, мен...
Dialogue: 0,0:15:17.36,0:15:19.33,*Default,NTP,0000,0000,0000,,Маған не болды?
Dialogue: 0,0:15:20.45,0:15:22.88,*Default,NTP,0000,0000,0000,,Мен бұл электрондық поштаны жібердім.
Dialogue: 0,0:15:23.59,0:15:24.93,*Default,NTP,0000,0000,0000,,Маған оны оқуға рұқсат етесіз бе?
Dialogue: 0,0:15:25.42,0:15:25.90,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:15:26.29,0:15:28.66,*Default,NTP,0000,0000,0000,,Мен жауап алмағаным жақсы.
Dialogue: 0,0:15:28.78,0:15:30.76,*Default,NTP,0000,0000,0000,,Мен ол шынымен келген жоқ деп ойладым.
Dialogue: 0,0:15:36.65,0:15:39.40,*Default,NTP,0000,0000,0000,,Мен кеше Сайджо-кунның сабағына бардым.
Dialogue: 0,0:15:39.88,0:15:40.99,*Default,NTP,0000,0000,0000,,Мен демалыс күні деп естідім.
Dialogue: 0,0:15:41.88,0:15:44.90,*Default,NTP,0000,0000,0000,,Жел тартып жатқан шығар деп ойладым.
Dialogue: 0,0:15:45.45,0:15:46.56,*Default,NTP,0000,0000,0000,,Мен уайымдадым.
Dialogue: 0,0:15:47.21,0:15:51.32,*Default,NTP,0000,0000,0000,,Мен мектепке анда-санда ғана келемін. Мені хикикомори деп атайды.
Dialogue: 0,0:15:52.48,0:15:56.23,*Default,NTP,0000,0000,0000,,Түсіндім, бірақ бүгін танысқаныма қуаныштымын.
Dialogue: 0,0:15:56.53,0:15:57.01,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:15:58.33,0:16:00.39,*Default,NTP,0000,0000,0000,,Мектепке анда-санда келсе де
Dialogue: 0,0:16:01.56,0:16:04.21,*Default,NTP,0000,0000,0000,,Мен Сайджо-кунды оңбаған адам деп ойламаймын.
Dialogue: 0,0:16:06.65,0:16:10.03,*Default,NTP,0000,0000,0000,,Кешіріңіз, мен түсінгендей бірдеңе айттым.
Dialogue: 0,0:16:10.34,0:16:13.49,*Default,NTP,0000,0000,0000,,Бірақ бұл өте ауыр.
Dialogue: 0,0:16:13.89,0:16:15.10,*Default,NTP,0000,0000,0000,,Олай болса, тамаша.
Dialogue: 0,0:16:15.26,0:16:15.58,*Default,NTP,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:16:16.06,0:16:20.39,*Default,NTP,0000,0000,0000,,Өйткені Сайджо-кун қиын болса да мектепке бару үшін барын салуда.
Dialogue: 0,0:16:21.01,0:16:24.99,*Default,NTP,0000,0000,0000,,Бірақ мен отакумын және мен өрескелмін.
Dialogue: 0,0:16:25.71,0:16:28.82,*Default,NTP,0000,0000,0000,,Мен Сайджо-кунның әңгімелерін тыңдағанды ​​ұнатамын.
Dialogue: 0,0:16:29.44,0:16:31.14,*Default,NTP,0000,0000,0000,,Сайджо-кун қандай болса
Dialogue: 0,0:16:31.99,0:16:36.05,*Default,NTP,0000,0000,0000,,Бұл не? Бұл не?
Dialogue: 0,0:16:36.68,0:16:38.97,*Default,NTP,0000,0000,0000,,Ол мені қалай болсам ұнататынын айтады.
Dialogue: 0,0:16:41.23,0:16:43.93,*Default,NTP,0000,0000,0000,,Неліктен бұл жақсы сезінеді?
Dialogue: 0,0:16:49.71,0:16:51.87,*Default,NTP,0000,0000,0000,,Бұл да үлкен ескерту.
Dialogue: 0,0:16:52.08,0:16:54.46,*Default,NTP,0000,0000,0000,,Сайджо-кун, кешіріңізші.
Dialogue: 0,0:16:58.46,0:17:02.11,*Default,NTP,0000,0000,0000,,Аа, бүгін сабақтан кейін уақытың бар ма?
Dialogue: 0,0:17:02.41,0:17:02.80,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:17:04.25,0:17:08.54,*Default,NTP,0000,0000,0000,,Қарсы болмасаңыз, у...
Dialogue: 0,0:17:09.80,0:17:14.46,*Default,NTP,0000,0000,0000,,Үйге бірге барайық. Мен сабақтан кейін аулада күтемін.
Dialogue: 0,0:17:15.90,0:17:16.83,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:17:20.04,0:17:24.33,*Default,NTP,0000,0000,0000,,Бұл арман немесе адасушылық емес.
Dialogue: 0,0:17:35.32,0:17:37.75,*Default,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:17:45.05,0:17:48.20,*Default,NTP,0000,0000,0000,,Юай шынымен де сонда болды
Dialogue: 0,0:17:49.01,0:17:50.84,*Default,NTP,0000,0000,0000,,Ол тек мені күтіп отырды
Dialogue: 0,0:17:52.47,0:17:54.30,*Default,NTP,0000,0000,0000,,Грейс маған опасыздық жасамайды
Dialogue: 0,0:17:54.97,0:17:57.26,*Default,NTP,0000,0000,0000,,Жұмсақ болсаң, мені құтқара аларсың.
Dialogue: 0,0:18:04.25,0:18:05.45,*Default,NTP,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:18:06.38,0:18:06.90,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:18:07.21,0:18:09.64,*Default,NTP,0000,0000,0000,,Сайджо-кунның шынымен келе жатқанына сене алар емеспін.
Dialogue: 0,0:18:10.82,0:18:13.56,*Default,NTP,0000,0000,0000,,Менімен үйге келесің бе?
Dialogue: 0,0:18:14.27,0:18:15.43,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:40.47,0:18:42.26,*Default,NTP,0000,0000,0000,,Осындай кәдімгі декорация
Dialogue: 0,0:18:42.97,0:18:44.68,*Default,NTP,0000,0000,0000,,Бұл кездейсоқ жағдай болса да
Dialogue: 0,0:18:45.34,0:18:47.63,*Default,NTP,0000,0000,0000,,Неліктен менің жылағым келеді?
Dialogue: 0,0:18:49.62,0:18:50.82,*Default,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:18:51.48,0:18:52.73,*Default,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:18:54.04,0:18:56.66,*Default,NTP,0000,0000,0000,,Иә? Құсу бақа
Dialogue: 0,0:18:58.14,0:18:59.73,*Default,NTP,0000,0000,0000,,Мен бұған дейін бір жерде сенімдімін
Dialogue: 0,0:19:03.21,0:19:04.77,*Default,NTP,0000,0000,0000,,36-БӨЛМЕ
Dialogue: 0,0:19:05.58,0:19:07.91,*Default,NTP,0000,0000,0000,,Сол кезде қасымда кім болғанына сене алмадым.
Dialogue: 0,0:19:08.22,0:19:09.10,*Default,NTP,0000,0000,0000,,Сайджо-кун?
Dialogue: 0,0:19:09.47,0:19:13.05,*Default,NTP,0000,0000,0000,,О, бұл ма? Оны құсық бақа деп атайды.
Dialogue: 0,0:19:13.49,0:19:15.87,*Default,NTP,0000,0000,0000,,Мен саған біреуін беремін. Рақмет сізге.
Dialogue: 0,0:19:17.01,0:19:18.85,*Default,NTP,0000,0000,0000,,Бұл біртүрлі, мен оны түсіре алмаймын.
Dialogue: 0,0:19:36.51,0:19:40.08,*Default,NTP,0000,0000,0000,,Жаңа ген мақаласы Неліктен?
Dialogue: 0,0:19:42.13,0:19:43.47,*Default,NTP,0000,0000,0000,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:19:44.64,0:19:47.21,*Default,NTP,0000,0000,0000,,Маған жауап бер, бірдеңе айт.
Dialogue: 0,0:19:49.51,0:19:51.35,*Default,NTP,0000,0000,0000,,Мен сене жаздасам да
Dialogue: 0,0:19:52.01,0:19:54.61,*Default,NTP,0000,0000,0000,,Юа мен жақта болуы мүмкін.
Dialogue: 0,0:19:54.64,0:19:55.96,*Default,NTP,0000,0000,0000,,Мен ойлана бастадым
Dialogue: 0,0:19:59.80,0:20:03.28,*Default,NTP,0000,0000,0000,,Ақырында, тіпті Юайдың да маған жақсылығы жоқ.
Dialogue: 0,0:20:03.85,0:20:06.46,*Default,NTP,0000,0000,0000,,Мен сізге бір мақсатпен жақындадым.
Dialogue: 0,0:20:06.82,0:20:09.26,*Default,NTP,0000,0000,0000,,Бұл ең нашар. Бұл ең нашар.
Dialogue: 0,0:20:13.74,0:20:14.43,*Default,NTP,0000,0000,0000,,Сіз қашып бара жатырсыз ба?
Dialogue: 0,0:20:20.96,0:20:21.94,*Default,NTP,0000,0000,0000,,Мен сенің қашуыңа жол бермеймін
Dialogue: 0,0:20:22.56,0:20:25.62,*Default,NTP,0000,0000,0000,,Сізді алдағаным үшін кешірім сұраймын, бірақ бұл өзара.
Dialogue: 0,0:20:26.20,0:20:28.99,*Default,NTP,0000,0000,0000,,Тіпті сізде жасырып жүрген нәрсе бар, солай ма?
Dialogue: 0,0:20:29.88,0:20:31.77,*Default,NTP,0000,0000,0000,,Бұл әйел ақылды.
Dialogue: 0,0:20:32.29,0:20:36.82,*Default,NTP,0000,0000,0000,,Бұл əйелдің маған айтқан əр сөзі аузынан шығып кетті.
Dialogue: 0,0:20:37.57,0:20:39.14,*Default,NTP,0000,0000,0000,,Тәтті
Dialogue: 0,0:20:39.48,0:20:42.77,*Default,NTP,0000,0000,0000,,Бұл әйелдің айтқанына неге сендім?
Dialogue: 0,0:20:43.35,0:20:46.46,*Default,NTP,0000,0000,0000,,Мен оны зерттеуге көбірек уақыт бөлгім келді.
Dialogue: 0,0:20:46.81,0:20:48.64,*Default,NTP,0000,0000,0000,,Бұл анықталғандықтан көмектесу мүмкін емес.
Dialogue: 0,0:20:49.58,0:20:52.02,*Default,NTP,0000,0000,0000,,Менің саған айтар сөзім бар.
Dialogue: 0,0:20:52.58,0:20:53.98,*Default,NTP,0000,0000,0000,,Сіз мені тыңдайсыз.
Dialogue: 0,0:20:54.49,0:20:56.30,*Default,NTP,0000,0000,0000,,Тыңдамаймын деме.
Dialogue: 0,0:20:56.82,0:20:58.34,*Default,NTP,0000,0000,0000,,Сіз тыңдауыңыз керек
Dialogue: 0,0:20:58.73,0:20:59.44,*Default,NTP,0000,0000,0000,,Тыңдаңыз
Dialogue: 0,0:20:59.73,0:21:00.67,*Default,NTP,0000,0000,0000,,Сіз мұны естисіз.
Dialogue: 0,0:21:01.01,0:21:02.09,*Default,NTP,0000,0000,0000,,Тыңдамасаңыз
Dialogue: 0,0:21:13.07,0:21:15.46,*Default,NTP,0000,0000,0000,,Бұл ставка таныс сияқты, солай ма?
Dialogue: 0,0:21:18.17,0:21:19.50,*Default,NTP,0000,0000,0000,,Сіз мұны бәрібір білесіз.
Dialogue: 0,0:21:19.72,0:21:20.96,*Default,NTP,0000,0000,0000,,Білетініңізге сенімдімін
Dialogue: 0,0:21:21.09,0:21:22.46,*Default,NTP,0000,0000,0000,,Білмеймін демеңіз
Dialogue: 0,0:21:22.82,0:21:24.19,*Default,NTP,0000,0000,0000,,Білмесең біртүрлі екен
Dialogue: 0,0:21:24.50,0:21:27.51,*Default,NTP,0000,0000,0000,,Сен білесің, білесің.
Dialogue: 0,0:21:31.01,0:21:33.01,*Default,NTP,0000,0000,0000,,Бұл сіздің бөлмеңізде болды.
Dialogue: 0,0:21:33.73,0:21:34.51,*Default,NTP,0000,0000,0000,,Сіздің бөлмеңіз
Dialogue: 0,0:21:34.70,0:21:35.60,*Default,NTP,0000,0000,0000,,Төсек астында
Dialogue: 0,0:21:35.74,0:21:36.98,*Default,NTP,0000,0000,0000,,Ол еденде болды.
Dialogue: 0,0:21:37.29,0:21:37.93,*Default,NTP,0000,0000,0000,,Құлап бара жатты.
Dialogue: 0,0:21:38.09,0:21:38.89,*Default,NTP,0000,0000,0000,,Сіз оны тастадыңыз, солай ма?
Dialogue: 0,0:21:38.91,0:21:39.93,*Default,NTP,0000,0000,0000,,Немесе лақтырдым
Dialogue: 0,0:21:39.96,0:21:41.39,*Default,NTP,0000,0000,0000,,Ол бәрібір құлап жатты.
Dialogue: 0,0:21:41.51,0:21:42.39,*Default,NTP,0000,0000,0000,,Құлап бара жатты
Dialogue: 0,0:21:45.20,0:21:49.09,*Default,NTP,0000,0000,0000,,Бұл үлес Жаңа ұрпақ 3 оқиғасында пайдаланылған үлеспен бірдей.
Dialogue: 0,0:21:49.80,0:21:50.52,*Default,NTP,0000,0000,0000,,Дәл солай ма?
Dialogue: 0,0:21:50.67,0:21:51.71,*Default,NTP,0000,0000,0000,,Дәл солай емес пе?
Dialogue: 0,0:21:51.81,0:21:53.34,*Default,NTP,0000,0000,0000,,Әрине, дәл солай
Dialogue: 0,0:21:53.50,0:21:54.21,*Default,NTP,0000,0000,0000,,Дәл солай
Dialogue: 0,0:21:54.32,0:21:56.80,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:21:58.26,0:22:02.51,*Default,NTP,0000,0000,0000,,Бұл әйел... Жаңа Геннің кінәсі мені деп күдіктенеді.
Dialogue: 0,0:22:03.00,0:22:07.11,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:08.88,0:22:09.81,*Default,NTP,0000,0000,0000,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:22:28.56,0:22:31.03,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:31.65,0:22:34.99,*Default,NTP,0000,0000,0000,,Білетініңді көргім келді.
Dialogue: 0,0:22:35.75,0:22:38.09,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:39.48,0:22:42.36,*Default,NTP,0000,0000,0000,,Олай болса, тағы бір нәрсені растауға рұқсат етіңіздер.
Dialogue: 0,0:22:44.58,0:22:46.87,*Default,NTP,0000,0000,0000,,Сізде прекогнитивті қабілеттер бар ма?
Dialogue: 0,0:22:47.31,0:22:48.06,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:22:48.57,0:22:50.73,*Default,NTP,0000,0000,0000,,Менде прекогнитивті қабілеттер бар деп ойлауым керек.
Dialogue: 0,0:22:50.99,0:22:54.10,*Default,NTP,0000,0000,0000,,Себебі сізде қанағаттанарлықсыз кескін деректері болды
Dialogue: 0,0:22:59.22,0:23:00.16,*Default,NTP,0000,0000,0000,,Сен оны ұрладың ба?
Dialogue: 0,0:23:00.91,0:23:05.34,*Default,NTP,0000,0000,0000,,3
Dialogue: 0,0:23:06.37,0:23:10.21,*Default,NTP,0000,0000,0000,,Оның үстіне бұл сурет оқиғадан бір күн бұрын тарап кеткен.
Dialogue: 0,0:23:10.78,0:23:12.03,*Default,NTP,0000,0000,0000,,Қайырлы таң, Йор.
Dialogue: 0,0:23:12.56,0:23:16.99,*Default,NTP,0000,0000,0000,,Мен мұны сол күні бірінші рет сөйлескен генералдан алдым.
Dialogue: 0,0:23:18.20,0:23:23.08,*Default,NTP,0000,0000,0000,,Сен генералсың ба, әлде мені сиқылайсың ба?
Dialogue: 0,0:23:23.33,0:23:24.67,*Default,NTP,0000,0000,0000,,Маған көмектес
Dialogue: 0,0:23:25.11,0:23:30.17,*Default,NTP,0000,0000,0000,,Бұл сурет @Cafe ROOM37 компьютерінен алынған.
Dialogue: 0,0:23:31.66,0:23:35.63,*Default,NTP,0000,0000,0000,,37-БӨЛМЕ Мен үнемі пайдаланатын бөлме
Dialogue: 0,0:23:42.48,0:23:45.46,*Default,NTP,0000,0000,0000,,Мұның бәрі сіз туралы
Dialogue: 0,0:23:48.85,0:23:50.60,*Default,NTP,0000,0000,0000,,Анау журнал біртүрлі екен, солай емес пе?
Dialogue: 0,0:23:51.22,0:23:54.92,*Default,NTP,0000,0000,0000,,Нейдхардт пен генералдың сөйлеу уақыты мүлдем сәйкес келмейді.
Dialogue: 0,0:23:57.83,0:23:59.90,*Default,NTP,0000,0000,0000,,Нейдхарт - Сайджо-кун.
Dialogue: 0,0:24:00.47,0:24:03.77,*Default,NTP,0000,0000,0000,,Сөйлеу уақыты 28 қыркүйек күні сағат 03:00.
Dialogue: 0,0:24:04.48,0:24:07.59,*Default,NTP,0000,0000,0000,,Ал келесі күні @cafe-ге барасыз.
Dialogue: 0,0:24:08.53,0:24:11.04,*Default,NTP,0000,0000,0000,,Генералдың сөзімен бір уақытта, сағат 19.00-де.
Dialogue: 0,0:24:11.79,0:24:14.04,*Default,NTP,0000,0000,0000,,Сіз не туралы айтып тұрсыз?
Dialogue: 0,0:24:14.84,0:24:16.45,*Default,NTP,0000,0000,0000,,Бұдан не үйрендік
Dialogue: 0,0:24:17.40,0:24:19.06,*Default,NTP,0000,0000,0000,,Маған қарама
Dialogue: 0,0:24:20.31,0:24:22.42,*Default,NTP,0000,0000,0000,,Өз өндірісіңіз
Dialogue: 0,0:24:22.82,0:24:24.52,*Default,NTP,0000,0000,0000,,Маған қарама
Dialogue: 0,0:24:26.41,0:24:29.07,*Default,NTP,0000,0000,0000,,Генерал өзіңсің.
Dialogue: 0,0:24:43.37,0:24:46.52,*Default,NTP,0000,0000,0000,,Мен мен емеспін
Dialogue: 0,0:24:47.59,0:24:52.75,*Default,NTP,0000,0000,0000,,Бұл мен болу керек дүние емес.
Dialogue: 0,0:26:36.53,0:26:39.23,*Default,NTP,0000,0000,0000,,Бұл кімнің көздері?
Dialogue: 0,0:26:40.73,0:26:46.73,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory