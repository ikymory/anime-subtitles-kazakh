Dialogue: 0,0:03:55.97,0:04:40.97,gg,NTP,0000,0000,0000,Banner;8;0;20,Бұл субтитр Eien Subtitle Group компаниясының туындысы, хабарландыру тақтасының мекенжайы: http://www.eien-acg.com Ол тек білім беру мақсатында жасалған, сондықтан оны коммерциялық мақсатта пайдаланбаңыз. Жүктеп алғаннан кейін оны 24 сағат ішінде жойыңыз. Жазушы: Юкчи Түзету: Мушитан Уақыт осі: икпко Chore: Мицуруги Геня Энко: Мицуруги Геня
Dialogue: 0,0:00:04.57,0:00:08.17,*Default,NTP,0000,0000,0000,,Аспаннан көзқарас түседі
Dialogue: 0,0:00:10.86,0:00:12.71,*Default,NTP,0000,0000,0000,,Маған қарама
Dialogue: 0,0:00:37.80,0:00:39.41,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:00:51.59,0:00:52.99,*Default,NTP,0000,0000,0000,,Періште?
Dialogue: 0,0:01:06.88,0:01:11.36,*Default,NTP,0000,0000,0000,,Бұл дүниеде тек мен және ол бар
Dialogue: 0,0:01:12.53,0:01:15.43,*Default,NTP,0000,0000,0000,,Мәңгі бір-бірімізге қарап тұрсақ
Dialogue: 0,0:01:16.58,0:01:21.26,*Default,NTP,0000,0000,0000,,Менің әлемім оның көзінен көрген нәрсеге айнала ма?
Dialogue: 0,0:01:23.13,0:01:28.31,*Default,NTP,0000,0000,0000,,Оның әлемі менің көз алдымда бейнеленген нәрсеге айнала ма?
Dialogue: 0,0:01:29.68,0:01:31.66,*Default,NTP,0000,0000,0000,,Менің бәрі ол
Dialogue: 0,0:01:32.47,0:01:35.36,*Default,NTP,0000,0000,0000,,Оның бар нәрсесі мен ғана
Dialogue: 0,0:03:38.64,0:03:42.88,*Default,NTP,0000,0000,0000,,Tackey Wake up Tackey
Dialogue: 0,0:03:48.09,0:03:49.25,*Default,NTP,0000,0000,0000,,Жұлдыз келді
Dialogue: 0,0:03:52.10,0:03:56.36,*Default,NTP,0000,0000,0000,,Бұл ояту әдісі Брачудың екінші эпизодының басындағыдай
Dialogue: 0,0:03:56.68,0:03:57.70,*Default,NTP,0000,0000,0000,,ktkr kita
Dialogue: 0,0:03:57.73,0:04:01.24,*Default,NTP,0000,0000,0000,,Асығыңыз, бүгін мектепке баратын күн, дереу тұрыңыз.
Dialogue: 0,0:04:01.55,0:04:03.15,*Default,NTP,0000,0000,0000,,Жабысқақ?
Dialogue: 0,0:04:04.19,0:04:07.30,*Default,NTP,0000,0000,0000,,Бүгін бірінші кезеңді өткізіп жіберуге болады.
Dialogue: 0,0:04:07.92,0:04:09.47,*Default,NTP,0000,0000,0000,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:04:09.60,0:04:12.12,*Default,NTP,0000,0000,0000,,Соған қарамастан Таки де өзгерді.
Dialogue: 0,0:04:12.34,0:04:15.26,*Default,NTP,0000,0000,0000,,Бітіруге қажетті кредиттердің ең аз санын алу үшін.
Dialogue: 0,0:04:15.32,0:04:18.51,*Default,NTP,0000,0000,0000,,Олар тіпті мектепке барудың ең төменгі ауысымдық тізімін жасау үшін барын салды.
Dialogue: 0,0:04:18.84,0:04:20.94,*Default,NTP,0000,0000,0000,,Мен мұны ешкімге көрсете алмаймын.
Dialogue: 0,0:04:24.67,0:04:26.72,*Default,NTP,0000,0000,0000,,Бұл кімнің көздері?
Dialogue: 0,0:04:33.07,0:04:34.28,*Default,NTP,0000,0000,0000,,О, жоқ!
Dialogue: 0,0:04:34.30,0:04:35.25,*Default,NTP,0000,0000,0000,,Шынымен
Dialogue: 0,0:04:37.02,0:04:38.15,*Default,NTP,0000,0000,0000,,Сонымен…
Dialogue: 0,0:04:38.21,0:04:41.07,*Default,NTP,0000,0000,0000,,Сіз мені бәрібір өрескел деп ойлайтын шығарсыз.
Dialogue: 0,0:04:41.48,0:04:45.94,*Default,NTP,0000,0000,0000,,Хехе, мен үшін сендер үш өлшемді әйелдер әлдеқайда қорқыныштысыңдар.
Dialogue: 0,0:04:45.94,0:04:49.35,*Default,NTP,0000,0000,0000,,Йо Таку, сен бүгін мектепке келесің бе?
Dialogue: 0,0:04:49.37,0:04:50.91,*Default,NTP,0000,0000,0000,,Мисуми-кун
Dialogue: 0,0:04:50.91,0:04:54.63,*Default,NTP,0000,0000,0000,,Әлі де мұңайып көрінесің. Мүмкін сіз тым көп ойын ойнап ұйықтай алмай жүрсіз бе?
Dialogue: 0,0:04:55.74,0:04:59.25,*Default,NTP,0000,0000,0000,,Кеше мен осы сыныпта 3-ші қызды жасадым.
Dialogue: 0,0:04:59.47,0:05:02.90,*Default,NTP,0000,0000,0000,,Енді менің сыныбымдағы сүйкімді қыздарды жаулап алуды аяқтадыңдар.
Dialogue: 0,0:05:02.94,0:05:03.82,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:05:06.15,0:05:09.21,*Default,NTP,0000,0000,0000,,Ал, сізді қызықтырмайтын нәрселер туралы сөйлесуді доғарайық.
Dialogue: 0,0:05:10.20,0:05:13.16,*Default,NTP,0000,0000,0000,,Олай болса, сіз Жаңа Геннің тарихын білесіз бе?
Dialogue: 0,0:05:13.32,0:05:14.91,*Default,NTP,0000,0000,0000,,Жаңа…Жаңа ген
Dialogue: 0,0:05:14.92,0:05:17.51,*Default,NTP,0000,0000,0000,,Шибуяда болған біртүрлі оқиға туралы.
Dialogue: 0,0:05:17.80,0:05:22.86,*Default,NTP,0000,0000,0000,,Сіз кінәлі әйел екенін естігенде таң қаласыз, ал куәгерлердің айтуынша, ол өте әдемі болған.
Dialogue: 0,0:05:23.03,0:05:26.59,*Default,NTP,0000,0000,0000,,Ах~ ол қандай адам екен деп ойлаймын. Ол шынымен әдемі ме деп ойлаймын.
Dialogue: 0,0:05:26.66,0:05:27.81,*Default,NTP,0000,0000,0000,,Танысайық
Dialogue: 0,0:05:27.82,0:05:28.27,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:05:28.32,0:05:30.08,*Default,NTP,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:05:30.39,0:05:33.63,*Default,NTP,0000,0000,0000,,Бүгін сол кісі өлтіру орнына неге менімен бірге келмейсің?
Dialogue: 0,0:05:33.75,0:05:36.17,*Default,NTP,0000,0000,0000,,Сосын мен кінәліге тап болдым.
Dialogue: 0,0:05:36.19,0:05:39.57,*Default,NTP,0000,0000,0000,,Білесіз бе, қылмыскер қылмыс болған жерге қайтады дейді.
Dialogue: 0,0:05:39.85,0:05:40.65,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:05:41.27,0:05:43.96,*Default,NTP,0000,0000,0000,,Иә? Мен түсінемін.
Dialogue: 0,0:05:48.18,0:05:52.10,*Default,NTP,0000,0000,0000,,Міне! Ия хахаха...
Dialogue: 0,0:05:54.41,0:05:55.94,*Default,NTP,0000,0000,0000,,Керемет жабысқақ
Dialogue: 0,0:05:55.94,0:05:59.02,*Default,NTP,0000,0000,0000,,Бұл дүниеде менімен жарыса алатын ешкім жоқ
Dialogue: 0,0:05:59.37,0:06:03.53,*Default,NTP,0000,0000,0000,,Өйткені, бұл Гейл мен Найзағайдан шыққан Нейдхардт хехехе
Dialogue: 0,0:06:13.27,0:06:14.33,*Default,NTP,0000,0000,0000,,Гримм?
Dialogue: 0,0:06:20.70,0:06:22.97,*Default,NTP,0000,0000,0000,,Үш өлшем? Бұл қоқыс
Dialogue: 0,0:06:26.63,0:06:28.09,*Default,NTP,0000,0000,0000,,Тағы да солай ма?
Dialogue: 0,0:06:34.71,0:06:36.42,*Default,NTP,0000,0000,0000,,Бір жерде сілтеме жарияланған.
Dialogue: 0,0:06:38.45,0:06:43.42,*Default,NTP,0000,0000,0000,,Өткен айда Шибуяда болған екі оқиғаға қатысты...
Dialogue: 0,0:06:43.56,0:06:47.70,*Default,NTP,0000,0000,0000,,Жаңа ұрпақтың ақылсыздығы Жаңа буын ретінде қысқартылған
Dialogue: 0,0:06:47.83,0:06:53.56,*Default,NTP,0000,0000,0000,,Біріншіден, бес жоғары сынып оқушысы көпқабатты үйден секіріп, өз-өзіне қол жұмсады.
Dialogue: 0,0:06:53.56,0:06:55.22,*Default,NTP,0000,0000,0000,,Әдетте «топтық сүңгу» ретінде белгілі
Dialogue: 0,0:06:55.96,0:07:00.33,*Default,NTP,0000,0000,0000,,Екіншіден, ер адамның мәйітінен ұрық шықты.
Dialogue: 0,0:07:00.41,0:07:02.13,*Default,NTP,0000,0000,0000,,«Жүкті ер адам» деп аталады
Dialogue: 0,0:07:02.15,0:07:03.82,*Default,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:07:04.21,0:07:05.16,*Default,NTP,0000,0000,0000,,Onii
Dialogue: 0,0:07:05.19,0:07:06.60,*Default,NTP,0000,0000,0000,,Бұл дауыс
Dialogue: 0,0:07:05.81,0:07:09.39,*Default,NTP,0000,0000,0000,,Эй, аш!
Dialogue: 0,0:07:09.62,0:07:12.84,*Default,NTP,0000,0000,0000,,Бака Онии, ашпасаң сұмдық болады.
Dialogue: 0,0:07:13.10,0:07:14.61,*Default,NTP,0000,0000,0000,,Міне, келдіңіз
Dialogue: 0,0:07:16.81,0:07:18.87,*Default,NTP,0000,0000,0000,,Тірі қалу☆
Dialogue: 0,0:07:23.77,0:07:25.45,*Default,NTP,0000,0000,0000,,Уау, көгерген иіс шығады~
Dialogue: 0,0:07:25.47,0:07:30.19,*Default,NTP,0000,0000,0000,,Ониидің бөлмесі әлі лас. Мен саған оны тазала деп айттым.
Dialogue: 0,0:07:30.32,0:07:31.49,*Default,NTP,0000,0000,0000,,Неліктен жоқ?
Dialogue: 0,0:07:32.01,0:07:35.32,*Default,NTP,0000,0000,0000,,Жарайды, бәрібір маған оны тазалайтын қызым болмайды деп ойлаймын.
Dialogue: 0,0:07:35.56,0:07:39.35,*Default,NTP,0000,0000,0000,,Егер бұл орын алса, Нананың маған келіп тазалап беруден басқа амалы қалмайды деп ойлаймын.
Dialogue: 0,0:07:40.56,0:07:41.39,*Default,NTP,0000,0000,0000,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:07:41.61,0:07:42.75,*Default,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:07:42.95,0:07:47.01,*Default,NTP,0000,0000,0000,,Менің бөлмеме басып кіргеніңді қаламаймын.
Dialogue: 0,0:07:47.86,0:07:52.56,*Default,NTP,0000,0000,0000,,Тозақ, сіздің аман қалуыңызды тексеру үшін келген қарындасыңызға осылай айтасыз ба?
Dialogue: 0,0:07:52.93,0:07:57.42,*Default,NTP,0000,0000,0000,,Дәл осы онийді осыншама қиыншылыққа неге әкелдің деп ойлаймын.
Dialogue: 0,0:07:57.92,0:07:58.92,*Default,NTP,0000,0000,0000,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:07:59.45,0:08:02.34,*Default,NTP,0000,0000,0000,,Ха, мен шөлдеп тұрмын.
Dialogue: 0,0:08:02.50,0:08:03.86,*Default,NTP,0000,0000,0000,,Мен саған сусын әкелемін.
Dialogue: 0,0:08:08.95,0:08:11.43,*Default,NTP,0000,0000,0000,,Кем дегенде кесе пайдаланыңыз.
Dialogue: 0,0:08:11.49,0:08:12.75,*Default,NTP,0000,0000,0000,,Мен оны қолданамын
Dialogue: 0,0:08:16.06,0:08:17.68,*Default,NTP,0000,0000,0000,,Дегенмен, Титан аумағына әрбір шығу
Dialogue: 0,0:08:17.80,0:08:18.55,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:08:19.03,0:08:22.01,*Default,NTP,0000,0000,0000,,Ал... қазір үйге бару керек. Бітірдің.
Dialogue: 0,0:08:22.30,0:08:23.67,*Default,NTP,0000,0000,0000,,Әлі біткен жоқ
Dialogue: 0,0:08:23.98,0:08:26.86,*Default,NTP,0000,0000,0000,,Мен Ониидің ұялы телефонын сатып алайын деп жатырмын.
Dialogue: 0,0:08:26.87,0:08:27.68,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:08:27.68,0:08:28.92,*Default,NTP,0000,0000,0000,,Бұл әкеңнің бұйрығы.
Dialogue: 0,0:08:28.97,0:08:30.90,*Default,NTP,0000,0000,0000,,Менімен кез келген уақытта байланыса аласыз
Dialogue: 0,0:08:31.22,0:08:33.23,*Default,NTP,0000,0000,0000,,Нана сияқты үлгіні пайдаланбаңыз.
Dialogue: 0,0:08:33.56,0:08:36.44,*Default,NTP,0000,0000,0000,,Әрі қарай мен сізге сол бауды беремін.
Dialogue: 0,0:08:37.49,0:08:40.14,*Default,NTP,0000,0000,0000,,Уау, қандай сұмдық кейіпкер.
Dialogue: 0,0:08:40.22,0:08:43.87,*Default,NTP,0000,0000,0000,,Сіз білмейсіз бе? Бұл қазір өте танымал ...
Dialogue: 0,0:08:46.99,0:08:51.00,*Default,NTP,0000,0000,0000,,Жоғары сыныптағы қыздар арасындағы сән туралы білуге ​​болады емес пе?
Dialogue: 0,0:08:52.13,0:08:54.18,*Default,NTP,0000,0000,0000,,Ал, ұялы телефон сатып алайық.
Dialogue: 0,0:08:54.18,0:08:57.44,*Default,NTP,0000,0000,0000,,Аа, мен сәйкестік жақсы деп айтпаймын.
Dialogue: 0,0:08:57.44,0:09:00.53,*Default,NTP,0000,0000,0000,,Егер отбасы мүшелері бір үлгіні пайдаланса, жеңілдік қызметі бар.
Dialogue: 0,0:09:00.69,0:09:01.31,*Default,NTP,0000,0000,0000,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:09:01.31,0:09:05.25,*Default,NTP,0000,0000,0000,,Әй, әкем маған ақшаны неге береді?
Dialogue: 0,0:09:05.51,0:09:06.57,*Default,NTP,0000,0000,0000,,Мұндағы Окаринді
Dialogue: 0,0:09:10.63,0:09:13.02,*Default,NTP,0000,0000,0000,,Мен енді сене алар емеспін, ақымақ.
Dialogue: 0,0:09:13.39,0:09:14.36,*Default,NTP,0000,0000,0000,,Мен қазір үйге бара жатырмын
Dialogue: 0,0:09:14.63,0:09:15.45,*Default,NTP,0000,0000,0000,,О
Dialogue: 0,0:09:17.22,0:09:18.04,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:09:21.97,0:09:24.23,*Default,NTP,0000,0000,0000,,Маған вокзалға дейін апаруыңызды өтінемін.
Dialogue: 0,0:09:24.23,0:09:25.35,*Default,NTP,0000,0000,0000,,Менің сыртқа шыққым келмейді
Dialogue: 0,0:09:25.35,0:09:27.97,*Default,NTP,0000,0000,0000,,Өйткені соңғы уақытта бұл жерде көп қиындық болды.
Dialogue: 0,0:09:28.40,0:09:29.37,*Default,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:09:29.37,0:09:30.25,*Default,NTP,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:09:31.30,0:09:35.45,*Default,NTP,0000,0000,0000,,Мүмкін емес Нана не болғаны маңызды емес дейді.
Dialogue: 0,0:09:36.81,0:09:38.32,*Default,NTP,0000,0000,0000,,Идиот! ақымақ! ақымақ!
Dialogue: 0,0:09:38.32,0:09:41.54,*Default,NTP,0000,0000,0000,,Онии-сан, сен біртүрлі қылмыскерді кездестіруің керек!
Dialogue: 0,0:09:42.97,0:09:44.98,*Default,NTP,0000,0000,0000,,Ақыры тыныштық орнады.
Dialogue: 0,0:10:02.85,0:10:05.59,*Default,NTP,0000,0000,0000,,Бұл кімнің көздері?
Dialogue: 0,0:10:11.50,0:10:14.71,*Default,NTP,0000,0000,0000,,Жалпы? Сурет сілтемесі?
Dialogue: 0,0:10:18.91,0:10:21.31,*Default,NTP,0000,0000,0000,,Не... кенет мына жігіт не болды?
Dialogue: 0,0:10:21.64,0:10:24.59,*Default,NTP,0000,0000,0000,,Бұл вирус па? Сіз мұндай нәрсеге түсіп қалуыңыз мүмкін емес.
Dialogue: 0,0:10:25.74,0:10:27.93,*Default,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:10:30.74,0:10:33.49,*Default,NTP,0000,0000,0000,,Не...не, мені қорқытпа?
Dialogue: 0,0:10:46.15,0:10:50.92,*Default,NTP,0000,0000,0000,,Не...не...мүмкін генерал құқық бұзушы жігіт шығар?
Dialogue: 0,0:11:19.62,0:11:21.46,*Default,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:11:28.07,0:11:30.69,*Default,NTP,0000,0000,0000,,Нанами Смаш
Dialogue: 0,0:11:33.06,0:11:34.09,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:11:43.83,0:11:45.45,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:11:46.24,0:11:47.76,*Default,NTP,0000,0000,0000,,алыңыз
Dialogue: 0,0:11:47.91,0:11:51.12,*Default,NTP,0000,0000,0000,,Иә, мен келемін.
Dialogue: 0,0:11:53.75,0:11:56.55,*Default,NTP,0000,0000,0000,,Бұл да… тағы да.
Dialogue: 0,0:11:57.54,0:11:59.74,*Default,NTP,0000,0000,0000,,Мен келемін.
Dialogue: 0,0:12:01.15,0:12:03.25,*Default,NTP,0000,0000,0000,,Мен ешқашан жаттығуға әуес адамды кездестірмедім.
Dialogue: 0,0:12:03.52,0:12:06.14,*Default,NTP,0000,0000,0000,,Мүмкін ол керемет жас ханым шығар?
Dialogue: 0,0:12:10.18,0:12:13.28,*Default,NTP,0000,0000,0000,,Генералдың кесірінен өзімді үйде отырсам да өз үйімдегідей сезінбеймін.
Dialogue: 0,0:12:13.48,0:12:16.52,*Default,NTP,0000,0000,0000,,Осындай кезде мен өз уайымымды осы кәдімгі жерде жеңілдете аламын.
Dialogue: 0,0:12:19.25,0:12:22.24,*Default,NTP,0000,0000,0000,,Фухихи…
Dialogue: 0,0:12:27.62,0:12:28.68,*Default,NTP,0000,0000,0000,,Таза
Dialogue: 0,0:12:29.33,0:12:32.61,*Default,NTP,0000,0000,0000,,Иә? Бұл Нанамиде болған.
Dialogue: 0,0:12:32.98,0:12:34.50,*Default,NTP,0000,0000,0000,,Және үш
Dialogue: 0,0:12:41.97,0:12:44.26,*Default,NTP,0000,0000,0000,,Мен өзімді жақсы сезінсем де
Dialogue: 0,0:13:01.30,0:13:04.91,*Default,NTP,0000,0000,0000,,Не, бұл Шибуя?
Dialogue: 0,0:13:16.01,0:13:17.10,*Default,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:13:28.60,0:13:31.39,*Default,NTP,0000,0000,0000,,Жалпы сілтеме фотосы
Dialogue: 0,0:13:41.83,0:13:45.57,*Default,NTP,0000,0000,0000,,Таку мен сенімен танысқым келді.
Dialogue: 0,0:13:58.28,0:14:01.95,*Default,NTP,0000,0000,0000,,Таку мен сенімен танысқым келді.
Dialogue: 0,0:14:03.18,0:14:05.86,*Default,NTP,0000,0000,0000,,Не... неге атымды қойдыңыз?
Dialogue: 0,0:14:13.57,0:14:16.34,*Default,NTP,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:14:22.70,0:14:26.97,*Default,NTP,0000,0000,0000,,Жарайды...Сіздің жүзіңізді көрдім, менің атымды да білетін сияқтысыз.
Dialogue: 0,0:14:27.30,0:14:28.66,*Default,NTP,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:14:29.37,0:14:32.63,*Default,NTP,0000,0000,0000,,Жарайды, Таки, бұл сенің кәдімгі адасуың шығар.
Dialogue: 0,0:14:32.94,0:14:35.11,*Default,NTP,0000,0000,0000,,Бірақ... бірақ бұл ставка
Dialogue: 0,0:14:35.79,0:14:37.35,*Default,NTP,0000,0000,0000,,Бұл еш жерде жоқ.
Dialogue: 0,0:14:37.84,0:14:39.44,*Default,NTP,0000,0000,0000,,О, солай.
Dialogue: 0,0:14:39.69,0:14:41.72,*Default,NTP,0000,0000,0000,,Жоқ, теріс адасулар
Dialogue: 0,0:14:41.72,0:14:45.18,*Default,NTP,0000,0000,0000,,Позитивті Позитивті Мен позитивті жабысқақ заттарды жақсы көремін
Dialogue: 0,0:14:45.80,0:14:48.61,*Default,NTP,0000,0000,0000,,Дұрыс, жұлдыз келді. Бұл сөзсіз алдау.
Dialogue: 0,0:14:48.61,0:14:52.67,*Default,NTP,0000,0000,0000,,Хаха... Мен үшін қандай шынайы адасушылық.
Dialogue: 0,0:14:56.50,0:15:07.30,*Default,NTP,0000,0000,0000,,Крест тәрізді сансыз күңгірт түсті инелер
Dialogue: 0,0:15:07.90,0:15:23.20,*Default,NTP,0000,0000,0000,,Ашық түсті шомылдыру рәсімі және айқышқа шегелу массасы――――
Dialogue: 0,0:15:24.98,0:15:27.67,*Default,NTP,0000,0000,0000,,Бұл кімнің көздері?
Dialogue: 0,0:15:35.70,0:15:37.64,*Default,NTP,0000,0000,0000,,Маған біреу қарап тұр
Dialogue: 0,0:15:48.51,0:15:51.06,*Default,NTP,0000,0000,0000,,Ей, сен неге менің артымнан келе жатырсың?
Dialogue: 0,0:15:52.17,0:15:56.06,*Default,NTP,0000,0000,0000,,Кешегі жын әйел мені өшіруге келді ме?
Dialogue: 0,0:16:03.98,0:16:06.08,*Default,NTP,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:16:11.27,0:16:14.28,*Default,NTP,0000,0000,0000,,Мен ренжіту үшін бірдеңе жасадым ба?
Dialogue: 0,0:16:14.79,0:16:16.33,*Default,NTP,0000,0000,0000,,Жоқ, алмаймын.
Dialogue: 0,0:16:16.84,0:16:19.62,*Default,NTP,0000,0000,0000,,Мен мектептегі атмосфера сияқтымын.
Dialogue: 0,0:16:22.57,0:16:26.09,*Default,NTP,0000,0000,0000,,Артымнан еріп жүргенім көп ойланғандықтан ба?
Dialogue: 0,0:16:31.73,0:16:34.49,*Default,NTP,0000,0000,0000,,Бұл әйел менің соңымнан келе ме?
Dialogue: 0,0:16:35.19,0:16:37.40,*Default,NTP,0000,0000,0000,,Амал жоқ, шайтан әйелдің серігі
Dialogue: 0,0:16:52.50,0:16:53.83,*Default,NTP,0000,0000,0000,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:16:56.27,0:16:58.45,*Default,NTP,0000,0000,0000,,Мен...бұл жай алдау ма?
Dialogue: 0,0:17:00.91,0:17:02.58,*Default,NTP,0000,0000,0000,,Ешбір жағдайда араласпаңыз.
Dialogue: 0,0:17:09.54,0:17:10.90,*Default,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:17:14.05,0:17:18.57,*Default,NTP,0000,0000,0000,,Мм... жақсысың ба? Сіз жарақат алдыңыз ба?
Dialogue: 0,0:17:19.84,0:17:22.76,*Default,NTP,0000,0000,0000,,Не? Артымнан ерме.
Dialogue: 0,0:17:22.78,0:17:23.37,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:17:23.39,0:17:25.30,*Default,NTP,0000,0000,0000,,Менен не керек?
Dialogue: 0,0:17:25.91,0:17:28.54,*Default,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,0:17:29.39,0:17:32.67,*Default,NTP,0000,0000,0000,,Мен...менің атым Юа Кусуноки.
Dialogue: 0,0:17:33.17,0:17:35.05,*Default,NTP,0000,0000,0000,,Іс жүзінде...
Dialogue: 0,0:17:35.06,0:17:38.36,*Default,NTP,0000,0000,0000,,Мен сені алғаш көргенде әйтеуір саған қызық болдым.
Dialogue: 0,0:17:39.36,0:17:42.09,*Default,NTP,0000,0000,0000,,Мүмкін емес Бұл эротикалық ойын ма?
Dialogue: 0,0:17:42.47,0:17:43.82,*Default,NTP,0000,0000,0000,,Жоқ, алданып қалмаңыз.
Dialogue: 0,0:17:44.30,0:17:49.05,*Default,NTP,0000,0000,0000,,Бұл ыңғайсыздық. Артымнан ерме.
Dialogue: 0,0:17:49.34,0:17:50.36,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:17:51.93,0:17:53.64,*Default,NTP,0000,0000,0000,,Сіз қатты өкінесіз бе?
Dialogue: 0,0:17:54.40,0:17:56.30,*Default,NTP,0000,0000,0000,,Мо... Мен сізге бақылап жүрмін.
Dialogue: 0,0:17:59.15,0:18:00.36,*Default,NTP,0000,0000,0000,,Сіз жарақат алдыңыз.
Dialogue: 0,0:18:00.37,0:18:01.28,*Default,NTP,0000,0000,0000,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,0:18:01.91,0:18:05.90,*Default,NTP,0000,0000,0000,,Мен сені үйге жеткізіп саламын, себебі сен жараланған менің кінәм.
Dialogue: 0,0:18:06.18,0:18:07.67,*Default,NTP,0000,0000,0000,,Сондықтан оны сізге жіберуге рұқсат етіңіз.
Dialogue: 0,0:18:08.51,0:18:10.68,*Default,NTP,0000,0000,0000,,Мм, бұл үй қайда?
Dialogue: 0,0:18:12.01,0:18:13.63,*Default,NTP,0000,0000,0000,,Ши...Шинсен
Dialogue: 0,0:18:13.63,0:18:14.39,*Default,NTP,0000,0000,0000,,Шинсен?
Dialogue: 0,0:18:14.81,0:18:17.31,*Default,NTP,0000,0000,0000,,Кешіріңіз, мұны маған неге айтып отырсыз?
Dialogue: 0,0:18:17.63,0:18:19.49,*Default,NTP,0000,0000,0000,,Мен не күтемін?
Dialogue: 0,0:18:22.23,0:18:24.87,*Default,NTP,0000,0000,0000,,Онии Нанаға шынымен суық.
Dialogue: 0,0:18:25.61,0:18:29.05,*Default,NTP,0000,0000,0000,,Қуыршақтарды күту әдеті
Dialogue: 0,0:18:29.08,0:18:32.80,*Default,NTP,0000,0000,0000,,Нанамидің ағасы тек аниме қыздарына қызығады, солай ма?
Dialogue: 0,0:18:32.81,0:18:34.85,*Default,NTP,0000,0000,0000,,Мен түсінбеймін
Dialogue: 0,0:18:34.85,0:18:35.93,*Default,NTP,0000,0000,0000,,Нана да
Dialogue: 0,0:18:35.98,0:18:39.82,*Default,NTP,0000,0000,0000,,Бірақ қаншама қыздардың мұндай жігіттерге ғашық болатынына таң қаласың.
Dialogue: 0,0:18:39.82,0:18:41.79,*Default,NTP,0000,0000,0000,,Менің досым сондай.
Dialogue: 0,0:18:41.79,0:18:44.73,*Default,NTP,0000,0000,0000,,Мен сені құтқаруым керек деп уайымдап тұрған сияқтысың.
Dialogue: 0,0:18:44.73,0:18:48.18,*Default,NTP,0000,0000,0000,,Сонда Нанамидің ағасы осындай қызды ала ала ма?
Dialogue: 0,0:18:48.18,0:18:49.57,*Default,NTP,0000,0000,0000,,О... Бірдеңе?
Dialogue: 0,0:18:49.57,0:18:50.51,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:50.64,0:18:51.73,*Default,NTP,0000,0000,0000,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:18:54.18,0:18:56.17,*Default,NTP,0000,0000,0000,,Эй... жеткілікті.
Dialogue: 0,0:18:56.33,0:18:58.57,*Default,NTP,0000,0000,0000,,Эй... сен осындай жерде тұрасың ба?
Dialogue: 0,0:18:58.75,0:19:01.36,*Default,NTP,0000,0000,0000,,Не айтайын, соған сүйсінемін.
Dialogue: 0,0:19:01.40,0:19:02.04,*Default,NTP,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:19:02.14,0:19:05.60,*Default,NTP,0000,0000,0000,,Ол өзін заңсыз адам сияқты сезінеді, бұл жақсы.
Dialogue: 0,0:19:05.75,0:19:07.39,*Default,NTP,0000,0000,0000,,Жоқ...алданбаңыз.
Dialogue: 0,0:19:07.48,0:19:10.09,*Default,NTP,0000,0000,0000,,Сіз ешқашан үш өлшемді әйелге алданбайсыз.
Dialogue: 0,0:19:16.93,0:19:18.01,*Default,NTP,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:19:18.19,0:19:19.10,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:19:19.87,0:19:22.11,*Default,NTP,0000,0000,0000,,Ол мейірімді және қамқор адам...
Dialogue: 0,0:19:22.17,0:19:25.04,*Default,NTP,0000,0000,0000,,Сіз алданбайсыз. Сіз алданбайсыз.
Dialogue: 0,0:19:25.04,0:19:28.55,*Default,NTP,0000,0000,0000,,А, бұл Брачудан келген Сейра-чан... иә?
Dialogue: 0,0:19:28.68,0:19:30.73,*Default,NTP,0000,0000,0000,,О... сен білесің бе?
Dialogue: 0,0:19:30.76,0:19:34.16,*Default,NTP,0000,0000,0000,,Иә, мен Брачуды жақсы көремін және оны апта сайын көремін.
Dialogue: 0,0:19:34.25,0:19:35.51,*Default,NTP,0000,0000,0000,,Эй... иә.
Dialogue: 0,0:19:36.17,0:19:37.77,*Default,NTP,0000,0000,0000,,Саған Сейра-чан ұнайды, солай ма?
Dialogue: 0,0:19:37.87,0:19:41.07,*Default,NTP,0000,0000,0000,,Маған ол барлық кейіпкерлердің ішінде көбірек ұнайды.
Dialogue: 0,0:19:41.59,0:19:43.88,*Default,NTP,0000,0000,0000,,Сондай-ақ...фуджоши болуы мүмкін бе?
Dialogue: 0,0:19:43.89,0:19:44.53,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:19:44.59,0:19:45.75,*Default,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,0:19:45.78,0:19:47.82,*Default,NTP,0000,0000,0000,,Мен қарап шыға аламын ба?
Dialogue: 0,0:19:48.74,0:19:52.13,*Default,NTP,0000,0000,0000,,Аа, кешіріңіз, мен бірдеңе дедім.
Dialogue: 0,0:19:52.80,0:19:54.79,*Default,NTP,0000,0000,0000,,Менің ойымша, қазір үйге бару керек.
Dialogue: 0,0:19:55.00,0:19:56.20,*Default,NTP,0000,0000,0000,,Қарап шығуға болады.
Dialogue: 0,0:19:56.28,0:19:58.87,*Default,NTP,0000,0000,0000,,Бұл рас па? Рақмет сізге.
Dialogue: 0,0:19:59.49,0:20:02.76,*Default,NTP,0000,0000,0000,,Бұл Саньодо нұсқасының алдын ала оянған нұсқасы.
Dialogue: 0,0:20:03.05,0:20:05.96,*Default,NTP,0000,0000,0000,,Хоширай фигураларының бірнеше түрі бар.
Dialogue: 0,0:20:06.23,0:20:07.46,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:20:07.67,0:20:08.77,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:20:08.93,0:20:10.36,*Default,NTP,0000,0000,0000,,Анау... сол сөре.
Dialogue: 0,0:20:10.95,0:20:13.61,*Default,NTP,0000,0000,0000,,Уау, оның қанша екені таңқаларлық.
Dialogue: 0,0:20:14.24,0:20:16.97,*Default,NTP,0000,0000,0000,,Айтпақшы, мен Сейра фигурасын аяқтадым.
Dialogue: 0,0:20:17.14,0:20:20.22,*Default,NTP,0000,0000,0000,,Жақында көптен күткен оятудан кейінгі нұсқасы шығады.
Dialogue: 0,0:20:20.47,0:20:22.75,*Default,NTP,0000,0000,0000,,Бұл өте жоғары сапа сияқты.
Dialogue: 0,0:20:22.93,0:20:26.04,*Default,NTP,0000,0000,0000,,Оянғаннан кейін сіз 12-бөлімдегі сол көріністі айтасыз, солай ма?
Dialogue: 0,0:20:26.27,0:20:29.69,*Default,NTP,0000,0000,0000,,О, мен сені жақсы білемін. Сіз өте энтузиастсыз.
Dialogue: 0,0:20:29.78,0:20:31.27,*Default,NTP,0000,0000,0000,,Иә, өйткені маған ұнайды.
Dialogue: 0,0:20:31.33,0:20:34.99,*Default,NTP,0000,0000,0000,,Мен сол оянған көріністі қайта-қайта қараймын.
Dialogue: 0,0:20:35.58,0:20:40.12,*Default,NTP,0000,0000,0000,,Бұл көріністі Құдайдың жаратушысы Мияджи басқарған және салған.
Dialogue: 0,0:20:40.27,0:20:44.36,*Default,NTP,0000,0000,0000,,Сондықтан сапаның жоғары болуы табиғи нәрсе. Оның өнімі шын мәнінде құдайлық.
Dialogue: 0,0:20:44.47,0:20:47.43,*Default,NTP,0000,0000,0000,,Түсіндім, сенің білімің көп.
Dialogue: 0,0:20:47.60,0:20:51.02,*Default,NTP,0000,0000,0000,,Режиссерді, режиссерді және сценарийді тексеру керек.
Dialogue: 0,0:20:51.13,0:20:53.84,*Default,NTP,0000,0000,0000,,Жарайды, мен оны келесі жолы көремін.
Dialogue: 0,0:20:55.04,0:20:58.56,*Default,NTP,0000,0000,0000,,Маған соны айта аласыз ба?
Dialogue: 0,0:20:59.81,0:21:01.16,*Default,NTP,0000,0000,0000,,Сіздің атыңыз
Dialogue: 0,0:21:03.00,0:21:05.17,*Default,NTP,0000,0000,0000,,То...Такуми Сайджо
Dialogue: 0,0:21:05.65,0:21:08.42,*Default,NTP,0000,0000,0000,,Бұл Такуми Сайджо. Жасың нешеде?
Dialogue: 0,0:21:08.55,0:21:10.24,*Default,NTP,0000,0000,0000,,бастап…екі жылға дейін
Dialogue: 0,0:21:10.46,0:21:11.83,*Default,NTP,0000,0000,0000,,Мен үш жастамын
Dialogue: 0,0:21:12.07,0:21:14.45,*Default,NTP,0000,0000,0000,,Мен сенен үлкенмін.
Dialogue: 0,0:21:15.99,0:21:19.39,*Default,NTP,0000,0000,0000,,Бұл ақылсыз, мен Мое қимылынан шошып кете жаздадым.
Dialogue: 0,0:21:19.75,0:21:22.63,*Default,NTP,0000,0000,0000,,Юада «сабырлы әпке» қасиеті бар ма?
Dialogue: 0,0:21:22.85,0:21:24.02,*Default,NTP,0000,0000,0000,,Сонымен
Dialogue: 0,0:21:24.28,0:21:26.35,*Default,NTP,0000,0000,0000,,Менің Сайджо-кунға өтінішім бар.
Dialogue: 0,0:21:26.85,0:21:27.81,*Default,NTP,0000,0000,0000,,Өтінемін?
Dialogue: 0,0:21:29.55,0:21:32.56,*Default,NTP,0000,0000,0000,,Маған ұнайсың
Dialogue: 0,0:21:32.78,0:21:35.08,*Default,NTP,0000,0000,0000,,Мен Сайджо-кунға қарап отырдым.
Dialogue: 0,0:21:35.66,0:21:37.99,*Default,NTP,0000,0000,0000,,Менімен дос бола бересің бе?
Dialogue: 0,0:21:38.33,0:21:41.31,*Default,NTP,0000,0000,0000,,Не... Хошикита неге купальник киіп алған?
Dialogue: 0,0:21:41.31,0:21:41.84,*Default,NTP,0000,0000,0000,,Қақпақ
Dialogue: 0,0:21:43.02,0:21:45.41,*Default,NTP,0000,0000,0000,,Мен... кешіріңіз.
Dialogue: 0,0:21:45.43,0:21:47.19,*Default,NTP,0000,0000,0000,,Мен ықшам дискіні басқан сияқтымын.
Dialogue: 0,0:21:47.23,0:21:49.61,*Default,NTP,0000,0000,0000,,Кешіріңіз, мен тазалаймын.
Dialogue: 0,0:21:50.88,0:21:52.65,*Default,NTP,0000,0000,0000,,О, жарайды.
Dialogue: 0,0:21:58.26,0:22:00.51,*Default,NTP,0000,0000,0000,,Жоқ, уайымдамаңыз
Dialogue: 0,0:22:01.08,0:22:03.64,*Default,NTP,0000,0000,0000,,Fi...фигураларды ұстамаңыз.
Dialogue: 0,0:22:03.84,0:22:06.89,*Default,NTP,0000,0000,0000,,бұл...Иә Жоқ.
Dialogue: 0,0:22:09.02,0:22:11.75,*Default,NTP,0000,0000,0000,,Брачу дужинши түсірілді.
Dialogue: 0,0:22:12.44,0:22:15.36,*Default,NTP,0000,0000,0000,,Ішіне қарасам... ғажап.
Dialogue: 0,0:22:15.37,0:22:16.73,*Default,NTP,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:22:16.94,0:22:19.77,*Default,NTP,0000,0000,0000,,А...рұқсатсыз маған қарама.
Dialogue: 0,0:22:19.78,0:22:20.67,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:22:22.98,0:22:25.77,*Default,NTP,0000,0000,0000,,Өтінемін, өтінемін.
Dialogue: 0,0:22:27.01,0:22:30.21,*Default,NTP,0000,0000,0000,,Жоғарыда айтқан фигураны брондау үшін менімен бірге бара аласыз ба?
Dialogue: 0,0:22:30.56,0:22:31.22,*Default,NTP,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:22:31.96,0:22:36.49,*Default,NTP,0000,0000,0000,,Мен бұрын-соңды мұндай аниме дүкенінде болған емеспін.
Dialogue: 0,0:22:36.89,0:22:40.29,*Default,NTP,0000,0000,0000,,А, бұл өте әдепсіз өтініш, солай емес пе?
Dialogue: 0,0:22:40.49,0:22:43.79,*Default,NTP,0000,0000,0000,,Кешіріңіз, Сайджо-кун менің кесірімнен зардап шекті.
Dialogue: 0,0:22:41.86,0:22:43.36,*Default,NTP,0000,0000,0000,,Бұл тұзақ болуы керек
Dialogue: 0,0:22:43.81,0:22:46.44,*Default,NTP,0000,0000,0000,,Осы эротикалық ойын сияқты оппортунистік даму
Dialogue: 0,0:22:46.47,0:22:48.38,*Default,NTP,0000,0000,0000,,Бұл шындықта болуы мүмкін емес.
Dialogue: 0,0:22:49.31,0:22:52.77,*Default,NTP,0000,0000,0000,,Мен...Кешіріңіз, бірақ менің өтінішімді дәл қазір ұмытыңыз.
Dialogue: 0,0:22:53.61,0:22:58.83,*Default,NTP,0000,0000,0000,,Сайджо-кунның менімен әртүрлі нәрселер туралы сөйлескеніне өте қуаныштымын.
Dialogue: 0,0:22:56.14,0:22:58.14,*Default,NTP,0000,0000,0000,,Бұл әрекет. Мен бас тартамын!
Dialogue: 0,0:22:58.50,0:23:00.25,*Default,NTP,0000,0000,0000,,Еркек сияқты айтайын!
Dialogue: 0,0:23:03.73,0:23:08.69,*Default,NTP,0000,0000,0000,,Маған үзіліс беріңізші. Мен мұны хаотикалық ойында ғана бастан өткердім.
Dialogue: 0,0:23:11.53,0:23:15.11,*Default,NTP,0000,0000,0000,,Маған сенің өзімді өзімшілдікпен мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:23:15.12,0:23:17.64,*Default,NTP,0000,0000,0000,,Сайджо-кунмен кездесу жақсы идея емес.
Dialogue: 0,0:23:17.90,0:23:18.82,*Default,NTP,0000,0000,0000,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:23:18.85,0:23:19.64,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:23:19.65,0:23:20.85,*Default,NTP,0000,0000,0000,,Келе аласыз ба?
Dialogue: 0,0:23:22.94,0:23:26.57,*Default,NTP,0000,0000,0000,,Уау, рахмет саған, Сайджо-кун.
Dialogue: 0,0:23:27.87,0:23:30.66,*Default,NTP,0000,0000,0000,,Олай болсаң да, алданбайсың.
Dialogue: 0,0:23:35.31,0:23:38.06,*Default,NTP,0000,0000,0000,,Ұзақ уақыт мазалағаным үшін кешіріңіз.
Dialogue: 0,0:23:38.22,0:23:41.18,*Default,NTP,0000,0000,0000,,Аяғыңыз ауырса, дәрігерге барыңыз.
Dialogue: 0,0:23:41.53,0:23:42.50,*Default,NTP,0000,0000,0000,,Олай болса
Dialogue: 0,0:23:50.71,0:23:53.90,*Default,NTP,0000,0000,0000,,Өйткені, Хошикита мен үшін ең жақсысы
Dialogue: 0,0:23:54.43,0:23:57.36,*Default,NTP,0000,0000,0000,,Мен сіздің оянғаннан кейінгі нұсқаңызды асыға күтемін.
Dialogue: 0,0:24:00.41,0:24:01.88,*Default,NTP,0000,0000,0000,,Енді жаңалықтардан
Dialogue: 0,0:24:02.01,0:24:06.07,*Default,NTP,0000,0000,0000,,Өткен түні Шибуя округіндегі көшеде ер адамның мәйіті табылды.
Dialogue: 0,0:24:06.41,0:24:09.72,*Default,NTP,0000,0000,0000,,Адамды крест тәрізді бағанаға қадады.
Dialogue: 0,0:24:09.76,0:24:13.00,*Default,NTP,0000,0000,0000,,Елордалық полиция департаменті жындылықтың жаңа буыны деп аталады.
Dialogue: 0,0:24:13.01,0:24:16.78,*Default,NTP,0000,0000,0000,,Сибуядағы жұмбақ оқиғалар тізбегімен белгілі бір байланыс бар сияқты.
Dialogue: 0,0:24:16.86,0:24:19.10,*Default,NTP,0000,0000,0000,,Толық ауқымды тергеу басталды.
Dialogue: 0,0:24:26.56,0:24:27.32,*Default,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:24:27.91,0:24:28.80,*Default,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:24:32.92,0:24:33.69,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:24:41.01,0:24:43.16,*Default,NTP,0000,0000,0000,,Мен оны Моулд Колизейге жетпей тұрып жоюым керек
Dialogue: 0,0:24:46.33,0:24:49.50,*Default,NTP,0000,0000,0000,,Ах...сол кезде...
Dialogue: 0,0:24:55.44,0:24:56.85,*Default,NTP,0000,0000,0000,,Қайырлы таң Таку
Dialogue: 0,0:26:36.47,0:26:39.35,*Default,NTP,0000,0000,0000,,Бұл кімнің көздері?
Dialogue: 0,0:26:40.85,0:26:46.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory