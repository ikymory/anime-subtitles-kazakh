Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:11.34,0:00:17.35,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.21,0:01:40.22,Default,,0,0,0,,~♪
Dialogue: 0,0:01:41.39,0:01:43.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:45.14,0:01:46.39,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:01:49.06,0:01:49.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:51.48,0:01:52.40,Default,,0,0,0,,Мастер Роши…
Dialogue: 0,0:01:54.86,0:01:56.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:57.32,0:01:58.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:59.49,0:02:00.66,Default,,0,0,0,,Өйткені ол
Dialogue: 0,0:02:01.53,0:02:03.16,Default,,0,0,0,,Сіз мені қорлағыңыз келе ме?
Dialogue: 0,0:02:09.29,0:02:12.04,Default,,0,0,0,,Ей, сен қу қарт екенсің.
Dialogue: 0,0:02:12.29,0:02:13.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:15.21,0:02:16.05,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:18.30,0:02:19.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:20.93,0:02:22.30,Default,,0,0,0,,О...
Dialogue: 0,0:02:31.06,0:02:35.15,Default,,0,0,0,,
Dialogue: 0,0:02:35.53,0:02:38.65,Default,,0,0,0,,1-раунд Бірінші матчтан үлкен реніш болды!
Dialogue: 0,0:02:39.03,0:02:40.78,Default,,0,0,0,,Бір қызығы, Лю Кай патша
Dialogue: 0,0:02:40.91,0:02:44.66,Default,,0,0,0,,Мен жапондық пагилис Юдзиро Ханмадан жеңілдім!
Dialogue: 0,0:02:49.87,0:02:53.17,Default,,0,0,0,,Енді екінші матчтың жұптары жарияланды.
Dialogue: 0,0:02:54.29,0:02:56.67,Default,,0,0,0,,Боксшы кіші Махомед қарсы.
Dialogue: 0,0:02:57.67,0:02:59.97,Default,,0,0,0,,Теңіздің алып патшасы
Dialogue: 0,0:03:06.01,0:03:06.85,Default,,0,0,0,,Хаа
Dialogue: 0,0:03:07.60,0:03:08.43,Default,,0,0,0,,Ум...
Dialogue: 0,0:03:08.60,0:03:09.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:11.52,0:03:13.02,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:03:13.35,0:03:14.69,Default,,0,0,0,,Біз Токиода кездестік...
Dialogue: 0,0:03:15.15,0:03:17.65,Default,,0,0,0,,О! О, құдайым
Dialogue: 0,0:03:17.82,0:03:19.69,Default,,0,0,0,,Біздің мұндай жерде кездесетінімізге сене алар емеспін
Dialogue: 0,0:03:20.07,0:03:21.65,Default,,0,0,0,,Дәл жазылғандай жауап беріп отырсың — қазір сәнде жүрген сол «қолмен басқарылатын» кішкентай қыздардың бірісің бе?
Dialogue: 0,0:03:21.91,0:03:24.41,Default,,0,0,0,,Қатысатыныңызды білу
Dialogue: 0,0:03:24.57,0:03:27.20,Default,,0,0,0,,Хахаха жарайды
Dialogue: 0,0:03:27.37,0:03:28.91,Default,,0,0,0,,Мен жеңемін
Dialogue: 0,0:03:29.08,0:03:29.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:30.12,0:03:30.96,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:03:32.04,0:03:33.46,Default,,0,0,0,,Кім шығады?
Dialogue: 0,0:03:36.25,0:03:37.46,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:03:37.84,0:03:41.17,Default,,0,0,0,,Баки Ханма сіздің сүйіктіңіз болды ма?
Dialogue: 0,0:03:41.38,0:03:43.72,Default,,0,0,0,,Және ол ең жақсы емес
Dialogue: 0,0:03:43.89,0:03:44.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:46.72,0:03:47.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:49.31,0:03:50.48,Default,,0,0,0,,(Козуэдің айқайы)
Dialogue: 0,0:03:52.98,0:03:54.23,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:54.40,0:03:55.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:55.73,0:03:56.90,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:57.11,0:04:00.11,Default,,0,0,0,,Бақи мырзаның амандығы үшін бірге дұға етейік.
Dialogue: 0,0:04:00.65,0:04:01.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:02.03,0:04:03.11,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:04:03.36,0:04:06.41,Default,,0,0,0,,Намаз – мүмкін емес нәрсені тілеу.
Dialogue: 0,0:04:06.57,0:04:08.74,Default,,0,0,0,,Жәндіктің жақсы жүрегі емес
Dialogue: 0,0:04:09.16,0:04:12.25,Default,,0,0,0,,Оны жүзеге асыруға бел байлау!
Dialogue: 0,0:04:12.41,0:04:13.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:13.58,0:04:15.08,Default,,0,0,0,,Ол менімен кездескенше
Dialogue: 0,0:04:16.29,0:04:19.00,Default,,0,0,0,,Ал егер сен мені ұрсаң
Dialogue: 0,0:04:20.21,0:04:22.92,Default,,0,0,0,,Мен оны міндетті түрде аман-есен аяқтаймын.
Dialogue: 0,0:04:25.39,0:04:29.14,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:29.31,0:04:31.02,Default,,0,0,0,,Бұл өте үлкен!
Dialogue: 0,0:04:31.18,0:04:34.14,Default,,0,0,0,,Аспанға тиген алып, Теңіз патшасы
Dialogue: 0,0:04:35.65,0:04:37.90,Default,,0,0,0,,Катая бокс стиліндегі жекпе-жек өнері
Dialogue: 0,0:04:38.40,0:04:40.69,Default,,0,0,0,,Кіші Махомед Алай.
Dialogue: 0,0:04:43.24,0:04:44.40,Default,,0,0,0,,(айдаһар дыбысы)
Dialogue: 0,0:04:45.53,0:04:46.91,Default,,0,0,0,,Дора шайқас туралы хабарлайды
Dialogue: 0,0:04:47.37,0:04:50.41,Default,,0,0,0,,Бүгін бірінші рет шырылдады!
Dialogue: 0,0:04:51.58,0:04:52.41,Default,,0,0,0,,Ni!
Dialogue: 0,0:04:53.29,0:04:54.12,Default,,0,0,0,,О!
Dialogue: 0,0:04:56.79,0:04:57.92,Default,,0,0,0,,Ооо!
Dialogue: 0,0:04:58.75,0:05:00.92,Default,,0,0,0,,Төмен!
Dialogue: 0,0:05:01.30,0:05:03.05,Default,,0,0,0,,Ол қазірдің өзінде шешілді!
Dialogue: 0,0:05:03.21,0:05:04.30,Default,,0,0,0,,Тым ерте
Dialogue: 0,0:05:04.47,0:05:06.93,Default,,0,0,0,,Шешуге әлі ерте!
Dialogue: 0,0:05:07.59,0:05:08.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:08.76,0:05:10.18,Default,,0,0,0,,О! (Көрермендер) Қарсы шабуыл!
Dialogue: 0,0:05:10.60,0:05:12.93,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:05:13.47,0:05:16.69,Default,,0,0,0,,Мен тұрдым, мен тұрдым, Кайоу патша!
Dialogue: 0,0:05:16.85,0:05:18.69,Default,,0,0,0,,Теңіз патшасы жалғастыруға ниетті!
Dialogue: 0,0:05:19.11,0:05:21.07,Default,,0,0,0,,Мен солай деп ойлаймын.
Dialogue: 0,0:05:21.27,0:05:25.74,Default,,0,0,0,,Теңіз патшасының есімін «Отан қорғаушысы» деп атайды, оны қастерлейді.
Dialogue: 0,0:05:26.03,0:05:30.49,Default,,0,0,0,,Қонақты қатарынан екі рет ұстадың.
Dialogue: 0,0:05:30.83,0:05:33.91,Default,,0,0,0,,Хмм, бұл біраз қатал.
Dialogue: 0,0:05:34.08,0:05:38.21,Default,,0,0,0,,Толық қалпына келу үшін әлі де уақыт қажет
Dialogue: 0,0:05:40.34,0:05:41.46,Default,,0,0,0,,Иә
Dialogue: 0,0:05:41.75,0:05:43.21,Default,,0,0,0,,А, жоқ.
Dialogue: 0,0:05:43.59,0:05:44.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:45.88,0:05:46.72,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:47.59,0:05:48.84,Default,,0,0,0,,Біз бұған қарап тұра алмаймыз.
Dialogue: 0,0:05:49.59,0:05:50.97,Default,,0,0,0,,Футтория!
Dialogue: 0,0:05:52.51,0:05:54.72,Default,,0,0,0,,Теңіз патшасы да сынға ұшырады.
Dialogue: 0,0:05:55.14,0:05:57.98,Default,,0,0,0,,Ол сауығып кеткенше күтемін.
Dialogue: 0,0:05:58.14,0:05:58.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:59.15,0:05:59.98,Default,,0,0,0,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,0:06:00.61,0:06:03.73,Default,,0,0,0,,Әзірге ол қалпына келген сияқты.
Dialogue: 0,0:06:04.73,0:06:06.44,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:06:09.11,0:06:10.32,Default,,0,0,0,,Ah~ah
Dialogue: 0,0:06:10.87,0:06:12.49,Default,,0,0,0,,Жою импульсі артып келеді
Dialogue: 0,0:06:12.66,0:06:13.49,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:06:18.12,0:06:19.25,Default,,0,0,0,,
Dialogue: 0,0:06:19.96,0:06:22.25,Default,,0,0,0,,Қандай ұлы тұғыр.
Dialogue: 0,0:06:22.71,0:06:25.42,Default,,0,0,0,,Менің күткенім қалпына келтіру емес еді.
Dialogue: 0,0:06:25.63,0:06:29.47,Default,,0,0,0,,Бұл бір соққымен шешілетін жылдам қимыл.
Dialogue: 0,0:06:29.84,0:06:31.01,Default,,0,0,0,,(айдаһар дыбысы)
Dialogue: 0,0:06:31.59,0:06:33.10,Default,,0,0,0,,Ойын бар!
Dialogue: 0,0:06:33.81,0:06:35.64,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:06:35.81,0:06:37.60,Default,,0,0,0,,Еліміздің мақтанышы, теңіз патшасы
Dialogue: 0,0:06:37.73,0:06:41.98,Default,,0,0,0,,Екеуін де шетелдік пагилис жеңеді деп ойламаппын!
Dialogue: 0,0:06:42.56,0:06:46.28,Default,,0,0,0,,Мұндай дамуды кім болжаған?
Dialogue: 0,0:06:50.86,0:06:52.16,Default,,0,0,0,,Ли Хэ-Ванг
Dialogue: 0,0:06:52.32,0:06:55.79,Default,,0,0,0,,Ли жекпе-жек бойынша жапондық чемпионмен кездеседі.
Dialogue: 0,0:06:57.12,0:07:00.79,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:07:01.46,0:07:02.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:03.46,0:07:04.29,Default,,0,0,0,,Баки
Dialogue: 0,0:07:04.59,0:07:07.30,Default,,0,0,0,,Эй, уайымдама.
Dialogue: 0,0:07:07.71,0:07:09.76,Default,,0,0,0,,Менің саған айтар сөзім бар.
Dialogue: 0,0:07:11.09,0:07:13.30,Default,,0,0,0,,Қарсылас Ли Хэ-Ванг
Dialogue: 0,0:07:14.22,0:07:16.72,Default,,0,0,0,,Ол бүкіл Қытайда бірінші орында.
Dialogue: 0,0:07:17.35,0:07:19.06,Default,,0,0,0,,Ол улы қолды қолданушы.
Dialogue: 0,0:07:21.23,0:07:22.06,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:07:23.77,0:07:25.31,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:07:26.65,0:07:27.48,Default,,0,0,0,,Уф
Dialogue: 0,0:07:28.57,0:07:29.40,Default,,0,0,0,,Уф
Dialogue: 0,0:07:30.15,0:07:30.99,Default,,0,0,0,,Уф
Dialogue: 0,0:07:31.65,0:07:34.99,Default,,0,0,0,,Мен онымен бір жерде кездесіп қалармын деп үміттендім.
Dialogue: 0,0:07:36.12,0:07:38.08,Default,,0,0,0,,Шынымен бақытты
Dialogue: 0,0:07:39.45,0:07:40.83,Default,,0,0,0,,«Сәттілік»?
Dialogue: 0,0:07:41.79,0:07:45.84,Default,,0,0,0,,Мұндай қорытындыға қайдан және қалай келеміз?
Dialogue: 0,0:07:46.38,0:07:50.84,Default,,0,0,0,,Теңіз патшасы атағының өзі қауіп төндірсе де жеткілікті.
Dialogue: 0,0:07:51.30,0:07:53.59,Default,,0,0,0,,Оның үстіне одан да улы
Dialogue: 0,0:07:54.05,0:07:56.60,Default,,0,0,0,,Ханма Бакидің оянуына бәс тігу
Dialogue: 0,0:07:59.35,0:08:01.27,Default,,0,0,0,,...Ашуланба
Dialogue: 0,0:08:01.93,0:08:04.10,Default,,0,0,0,,...шикотен...
Dialogue: 0,0:08:04.52,0:08:05.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:05.94,0:08:08.32,Default,,0,0,0,,Алаңдамаңыз!
Dialogue: 0,0:08:08.48,0:08:09.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:09.53,0:08:10.36,Default,,0,0,0,,Ха...
Dialogue: 0,0:08:10.86,0:08:13.11,Default,,0,0,0,,«Оянуға ставка»...
Dialogue: 0,0:08:13.49,0:08:14.32,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:14.74,0:08:17.37,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:08:17.53,0:08:18.37,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:18.83,0:08:22.37,Default,,0,0,0,,Қалағаныңды істеуге рұқсат ет!
Dialogue: 0,0:08:22.58,0:08:24.37,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:24.54,0:08:25.37,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:27.25,0:08:29.63,Default,,0,0,0,,Міне, бастаймыз! Ал, қабыл ал!
Dialogue: 0,0:08:30.05,0:08:31.30,Default,,0,0,0,,Жетеді
Dialogue: 0,0:08:32.92,0:08:35.38,Default,,0,0,0,,Жетеді... жеткілікті.
Dialogue: 0,0:08:36.14,0:08:38.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:39.60,0:08:43.23,Default,,0,0,0,,(Козуэдің айқайы)
Dialogue: 0,0:08:43.35,0:08:44.69,Default,,0,0,0,,Батылдық...
Dialogue: 0,0:08:45.31,0:08:46.15,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:08:47.40,0:08:49.15,Default,,0,0,0,,Сіз ұтыласыз ба?
Dialogue: 0,0:08:49.27,0:08:51.65,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:08:51.78,0:08:52.78,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:52.94,0:08:55.15,Default,,0,0,0,,Үшінші ойын басталады.
Dialogue: 0,0:08:55.32,0:08:58.16,Default,,0,0,0,,Енді пайда болған адам - ​​Ханма Баки.
Dialogue: 0,0:08:59.08,0:09:00.58,Default,,0,0,0,,Небәрі 17 жаста
Dialogue: 0,0:09:00.74,0:09:04.91,Default,,0,0,0,,Жапондық жауынгер патша мұнараға түсті!
Dialogue: 0,0:09:07.92,0:09:11.05,Default,,0,0,0,,Не болды! Ханма Бакидің денесі...
Dialogue: 0,0:09:11.59,0:09:12.92,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:09:13.09,0:09:14.92,Default,,0,0,0,,Сіз жаман нәрсе жедіңіз бе?
Dialogue: 0,0:09:16.88,0:09:19.43,Default,,0,0,0,,Қарсы шабуыл - Ли Хэ О
Dialogue: 0,0:09:19.93,0:09:23.93,Default,,0,0,0,,Мен Қытай мақтан ететін қатты жұдырық медицинасының шеберімін!
Dialogue: 0,0:09:26.69,0:09:29.19,Default,,0,0,0,,Енді шайқас басталсын!
Dialogue: 0,0:09:29.31,0:09:32.86,Default,,0,0,0,,(айдаһар дыбысы)
Dialogue: 0,0:09:34.19,0:09:36.45,Default,,0,0,0,,Кенеттен ол мені соқты!
Dialogue: 0,0:09:38.11,0:09:38.95,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:09:39.32,0:09:41.45,Default,,0,0,0,,Таза соққы!
Dialogue: 0,0:09:41.58,0:09:42.45,Default,,0,0,0,,О!
Dialogue: 0,0:09:42.62,0:09:43.45,Default,,0,0,0,,Иә
Dialogue: 0,0:09:44.29,0:09:45.91,Default,,0,0,0,,Соғу
Dialogue: 0,0:09:47.04,0:09:48.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:48.67,0:09:49.71,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:51.50,0:09:54.17,Default,,0,0,0,,Улы қолмен соққы
Dialogue: 0,0:09:57.22,0:09:59.47,Default,,0,0,0,,
Dialogue: 0,0:10:00.80,0:10:03.14,Default,,0,0,0,,Оны жеп қойған!
Dialogue: 0,0:10:05.22,0:10:06.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:08.39,0:10:11.73,Default,,0,0,0,,Мен... Менде мұны көруден басқа амал жоқ...
Dialogue: 0,0:10:23.62,0:10:24.74,Default,,0,0,0,,Темекі шегу
Dialogue: 0,0:10:24.87,0:10:26.25,Default,,0,0,0,,
Dialogue: 0,0:10:30.79,0:10:32.25,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:10:33.04,0:10:35.76,Default,,0,0,0,,Не, сен мені күтіп тұрсың ба?
Dialogue: 0,0:10:38.30,0:10:39.76,Default,,0,0,0,,Сіз өте мейірімдісіз.
Dialogue: 0,0:10:41.22,0:10:43.26,Default,,0,0,0,,Қазірдің өзінде бұзылған
Dialogue: 0,0:10:45.10,0:10:47.02,Default,,0,0,0,,Иә? Қол алысу?
Dialogue: 0,0:10:49.31,0:10:50.77,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:10:51.69,0:10:52.52,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:52.90,0:10:54.02,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:10:54.48,0:10:55.40,Default,,0,0,0,,Қарсы қол
Dialogue: 0,0:10:55.57,0:10:57.03,Default,,0,0,0,,Аңызға айналған матч әдісі
Dialogue: 0,0:10:57.53,0:10:59.15,Default,,0,0,0,,Қарсы қол (Козуэ) А...
Dialogue: 0,0:11:00.57,0:11:02.03,Default,,0,0,0,,Бұл қысқа мерзімді шайқас па?
Dialogue: 0,0:11:03.91,0:11:04.74,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:06.45,0:11:07.29,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:07.83,0:11:09.54,Default,,0,0,0,,Айки! Мында кел!
Dialogue: 0,0:11:09.96,0:11:10.79,Default,,0,0,0,,Икемділік…
Dialogue: 0,0:11:11.54,0:11:12.38,Default,,0,0,0,,Тей!
Dialogue: 0,0:11:16.34,0:11:17.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:26.93,0:11:28.43,Default,,0,0,0,,Мен көп нәрсені білдім
Dialogue: 0,0:11:28.72,0:11:29.56,Default,,0,0,0,,алынды!
Dialogue: 0,0:11:29.73,0:11:30.68,Default,,0,0,0,,Дұрыс емес
Dialogue: 0,0:11:31.31,0:11:34.19,Default,,0,0,0,,Жапондық дәстүрлі жекпе-жек Джу
Dialogue: 0,0:11:34.86,0:11:37.19,Default,,0,0,0,,Мен оны бір рет бастан өткергім келді
Dialogue: 0,0:11:39.44,0:11:40.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:40.74,0:11:41.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:42.99,0:11:45.57,Default,,0,0,0,,Бұл тез шешіледі.
Dialogue: 0,0:11:48.62,0:11:49.70,Default,,0,0,0,,Жалғасы
Dialogue: 0,0:11:55.04,0:11:55.88,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:57.46,0:12:00.84,Default,,0,0,0,,Хааааааааааааааааааааааааааа!
Dialogue: 0,0:12:01.67,0:12:03.51,Default,,0,0,0,,(Зеницу) Незуко-чан, Танжиро~ (Танжиро) Тоқтат! Зенцу!
Dialogue: 0,0:12:07.18,0:12:08.01,Default,,0,0,0,,Улы қол...
Dialogue: 0,0:12:08.18,0:12:09.52,Default,,0,0,0,,Улы қол жіңішкереді!
Dialogue: 0,0:12:10.10,0:12:11.85,Default,,0,0,0,,Қолдар жұқарып барады
Dialogue: 0,0:12:12.02,0:12:14.98,Default,,0,0,0,,Бұл жауға улы қолдың тигенінің дәлелі ме?
Dialogue: 0,0:12:15.15,0:12:15.98,Default,,0,0,0,,Мүмкін, олардың санын және ауқымын неғұрлым шектесек—
Dialogue: 0,0:12:17.73,0:12:20.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:21.28,0:12:22.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:24.95,0:12:25.78,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:12:32.20,0:12:33.04,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:12:36.71,0:12:37.54,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:12:38.25,0:12:39.09,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:12:43.09,0:12:43.92,Default,,0,0,0,,Га!
Dialogue: 0,0:12:44.18,0:12:46.05,Default,,0,0,0,,Құп-қисынсыз! Мен анық-ақ жоғарыға көтерілдім.
Dialogue: 0,0:12:51.85,0:12:54.06,Default,,0,0,0,,Ханма Баки құлады!
Dialogue: 0,0:12:56.48,0:12:57.56,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:11.08,0:13:12.12,Default,,0,0,0,,Баки…
Dialogue: 0,0:13:13.25,0:13:14.08,Default,,0,0,0,,Эй
Dialogue: 0,0:13:14.66,0:13:15.58,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:13:18.54,0:13:19.84,Default,,0,0,0,,Зат өзгерді.
Dialogue: 0,0:13:21.50,0:13:23.55,Default,,0,0,0,,Тіпті сол қалың қолдар
Dialogue: 0,0:13:25.51,0:13:27.84,Default,,0,0,0,,Тіпті сол күшті аяқтар
Dialogue: 0,0:13:29.85,0:13:31.64,Default,,0,0,0,,Болат корпусы да
Dialogue: 0,0:13:33.77,0:13:34.73,Default,,0,0,0,,Барлығы…
Dialogue: 0,0:13:35.27,0:13:36.60,Default,,0,0,0,,Заттар өзгерді.
Dialogue: 0,0:13:38.15,0:13:39.02,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:40.19,0:13:41.61,Default,,0,0,0,,Ха... Баки!
Dialogue: 0,0:13:46.07,0:13:46.90,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:47.53,0:13:49.37,Default,,0,0,0,,Ештеңе өзгерген жоқ
Dialogue: 0,0:13:50.70,0:13:54.37,Default,,0,0,0,,Сіз ештеңені өзгерткен жоқсыз.
Dialogue: 0,0:13:59.04,0:14:00.25,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:00.96,0:14:02.38,Default,,0,0,0,,Мен бұған жол бермеймін. Мен бұған жол бермеймін!
Dialogue: 0,0:14:03.05,0:14:05.84,Default,,0,0,0,,Жақсы әйел затқа айналды
Dialogue: 0,0:14:06.38,0:14:07.30,Default,,0,0,0,,У...
Dialogue: 0,0:14:09.39,0:14:10.39,Default,,0,0,0,,Төңкеріл!
Dialogue: 0,0:14:11.72,0:14:14.64,Default,,0,0,0,,Өзгерсе де Өзгерсе де
Dialogue: 0,0:14:16.48,0:14:18.14,Default,,0,0,0,,Заттар қанша өзгерсе де
Dialogue: 0,0:14:20.94,0:14:23.15,Default,,0,0,0,,Сіз ешқашан өзгермейсіз
Dialogue: 0,0:14:33.83,0:14:34.66,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:14:35.49,0:14:36.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:37.16,0:14:39.16,Default,,0,0,0,,Ха... Ах!
Dialogue: 0,0:14:46.38,0:14:47.21,Default,,0,0,0,,Изуку Мидория…
Dialogue: 0,0:14:50.34,0:14:51.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:53.01,0:14:53.85,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:14:57.06,0:14:57.89,Default,,0,0,0,,Баки-кун!
Dialogue: 0,0:15:02.31,0:15:03.36,Default,,0,0,0,,Сіз!
Dialogue: 0,0:15:04.90,0:15:06.19,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:15:06.90,0:15:08.44,Default,,0,0,0,,Төңкерілді!
Dialogue: 0,0:15:09.61,0:15:11.95,Default,,0,0,0,,Артқа... Қайту керек пе?
Dialogue: 0,0:15:12.45,0:15:13.45,Default,,0,0,0,,Козуэ-сан!
Dialogue: 0,0:15:13.78,0:15:15.70,Default,,0,0,0,,Бақи қайта тіріледі!
Dialogue: 0,0:15:15.87,0:15:16.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:17.33,0:15:18.62,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:15:18.83,0:15:21.46,Default,,0,0,0,,Жарайсың Козуэ-сан!
Dialogue: 0,0:15:21.92,0:15:22.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:22.92,0:15:25.13,Default,,0,0,0,,Сіздің ағаңыз
Dialogue: 0,0:15:25.63,0:15:27.80,Default,,0,0,0,,Ол емделді
Dialogue: 0,0:15:30.05,0:15:34.64,Default,,0,0,0,,1540 Қытай Мин әулеті
Dialogue: 0,0:15:34.80,0:15:38.35,Default,,0,0,0,,Жаман жұдырық Жапонияға енгізілді
Dialogue: 0,0:15:39.52,0:15:41.98,Default,,0,0,0,,Жеті томның мазмұны
Dialogue: 0,0:15:42.14,0:15:44.98,Default,,0,0,0,,Күшті дәрілерді алудың мұқият және мұқият әдісі
Dialogue: 0,0:15:45.15,0:15:48.07,Default,,0,0,0,,және Улы қолды үйрету
Dialogue: 0,0:15:49.23,0:15:52.99,Default,,0,0,0,,Уақыттың қолбасшысы Йосимото Имагаваның бұйрығымен
Dialogue: 0,0:15:53.20,0:15:56.37,Default,,0,0,0,,Тек ниндзялардың оқуға рұқсаты бар.
Dialogue: 0,0:15:57.87,0:16:01.50,Default,,0,0,0,,Сол кезде барлық білімге ие болған ниндзяның улы қолымен.
Dialogue: 0,0:16:01.71,0:16:05.71,Default,,0,0,0,,Қарсы күштердің құрбандары Ходжо Уджиясу болды
Dialogue: 0,0:16:05.88,0:16:09.38,Default,,0,0,0,,Негізінде 90-нан астам адам болған дейді.
Dialogue: 0,0:16:10.21,0:16:13.68,Default,,0,0,0,,Жаңа заманнан бері төрт ғасыр
Dialogue: 0,0:16:13.84,0:16:18.64,Default,,0,0,0,,Тарихтың артында ұрпақтан-ұрпаққа жалғасып келе жатқан улы қол.
Dialogue: 0,0:16:19.01,0:16:21.85,Default,,0,0,0,,«Құттықтаймын» деп аяқтағым келеді
Dialogue: 0,0:16:22.02,0:16:23.44,Default,,0,0,0,,Қытай халқының сезімі қандай?
Dialogue: 0,0:16:23.60,0:16:25.90,Default,,0,0,0,,Бұл оңай емес.
Dialogue: 0,0:16:26.69,0:16:30.90,Default,,0,0,0,,Бұл 7 томды қамтитын «Улы қолдың» бүкіл тарихы болуы керек...
Dialogue: 0,0:16:31.49,0:16:34.91,Default,,0,0,0,,Тағы бес том болды.
Dialogue: 0,0:16:35.28,0:16:37.62,Default,,0,0,0,,Алдыңғы 7 том «сахна артында»
Dialogue: 0,0:16:37.83,0:16:39.41,Default,,0,0,0,,Келесі 5 том – «Йоте»
Dialogue: 0,0:16:40.79,0:16:42.37,Default,,0,0,0,,Инь және Ян
Dialogue: 0,0:16:42.54,0:16:45.71,Default,,0,0,0,,12 томнан тұратын толық
Dialogue: 0,0:16:47.46,0:16:51.42,Default,,0,0,0,,Сайып келгенде, оң қолдар міндетті түрде улы қолдар.
Dialogue: 0,0:16:51.96,0:16:54.38,Default,,0,0,0,,Тек өте шектеулі жағдайларда
Dialogue: 0,0:16:54.59,0:16:56.18,Default,,0,0,0,,Детоксикацияға бет бұрыңыз!
Dialogue: 0,0:16:57.47,0:16:58.68,Default,,0,0,0,,Орнынан тұр!
Dialogue: 0,0:16:58.85,0:17:02.64,Default,,0,0,0,,Бір сәт жерде жатқан жапон чемпионы
Dialogue: 0,0:17:02.81,0:17:05.44,Default,,0,0,0,,Мен тағы да осы аренада тұрмын!
Dialogue: 0,0:17:10.02,0:17:10.90,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:17:12.78,0:17:14.32,Default,,0,0,0,,Бұл жарық
Dialogue: 0,0:17:15.07,0:17:17.45,Default,,0,0,0,,Ах... жарық
Dialogue: 0,0:17:18.20,0:17:20.45,Default,,0,0,0,,Дәл жоғарыдағыдай
Dialogue: 0,0:17:20.99,0:17:23.20,Default,,0,0,0,,Мен бірден секіріп кететін сияқтымын.
Dialogue: 0,0:17:23.66,0:17:25.41,Default,,0,0,0,,Иә? Эх...
Dialogue: 0,0:17:27.50,0:17:30.13,Default,,0,0,0,,Кешіріңіз, мен сізді ұзақ күттім
Dialogue: 0,0:17:34.01,0:17:35.97,Default,,0,0,0,,Келіңіздер, дереу
Dialogue: 0,0:17:36.47,0:17:37.34,Default,,0,0,0,,Ммм
Dialogue: 0,0:17:37.63,0:17:38.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:43.97,0:17:45.60,Default,,0,0,0,,О? Нгг!
Dialogue: 0,0:17:47.23,0:17:48.06,Default,,0,0,0,,О~
Dialogue: 0,0:17:48.23,0:17:49.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:52.44,0:17:53.32,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:54.11,0:17:54.99,Default,,0,0,0,,Сіз оны тоқтатасыз ба?
Dialogue: 0,0:17:55.15,0:17:57.86,Default,,0,0,0,,Шабуыл пішінге келмей тұрып тоқтату!
Dialogue: 0,0:17:58.32,0:18:00.37,Default,,0,0,0,,Ли... оқылып жатыр.
Dialogue: 0,0:18:03.12,0:18:06.29,Default,,0,0,0,,Қалай болғанда да, уы төңкерілді.
Dialogue: 0,0:18:06.91,0:18:09.12,Default,,0,0,0,,Бұл анық көрінеді.
Dialogue: 0,0:18:09.67,0:18:10.83,Default,,0,0,0,,Инь және Ян
Dialogue: 0,0:18:11.00,0:18:14.13,Default,,0,0,0,,Екі токсин, сіздің денеңіздің ішіндегі нәрсе
Dialogue: 0,0:18:14.80,0:18:16.01,Default,,0,0,0,,Сіздің жауынгерлік рухыңыз бойынша
Dialogue: 0,0:18:16.17,0:18:19.13,Default,,0,0,0,,Бұл мидан бөлінетін ми ішілік дәрілік зат па?
Dialogue: 0,0:18:19.76,0:18:22.89,Default,,0,0,0,,Әлде тұрған ғашықтың төккен көз жасымен
Dialogue: 0,0:18:23.06,0:18:25.14,Default,,0,0,0,,Эйфория тудырды
Dialogue: 0,0:18:25.60,0:18:27.39,Default,,0,0,0,,Және олардың мақтаныштарынан
Dialogue: 0,0:18:27.56,0:18:30.40,Default,,0,0,0,,Бұл түзілген химиялық зат па?
Dialogue: 0,0:18:30.98,0:18:34.82,Default,,0,0,0,,Немесе олардың барлығы сіздің ішіңізде кездеседі.
Dialogue: 0,0:18:34.98,0:18:37.44,Default,,0,0,0,,Химиялық реакция тудырады және ұшқын шығарады
Dialogue: 0,0:18:39.07,0:18:40.86,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:18:41.16,0:18:44.70,Default,,0,0,0,,Сізге бірдеңе болғанына мен риза емес сияқтымын.
Dialogue: 0,0:18:47.12,0:18:49.79,Default,,0,0,0,,Мен бұл жолмен көптен бері жүріп келемін, бірақ
Dialogue: 0,0:18:50.25,0:18:53.17,Default,,0,0,0,,Бұл мен үшін де жаңа құбылыс.
Dialogue: 0,0:18:53.50,0:18:56.00,Default,,0,0,0,,Бас жақсы емес...
Dialogue: 0,0:18:56.17,0:18:57.42,Default,,0,0,0,,Қытай сорпасы
Dialogue: 0,0:18:58.30,0:19:00.93,Default,,0,0,0,,Сөзбен түсіндіру түсініксіз.
Dialogue: 0,0:19:02.09,0:19:02.93,Default,,0,0,0,,Тек...
Dialogue: 0,0:19:08.35,0:19:09.43,Default,,0,0,0,,Дене
Dialogue: 0,0:19:10.77,0:19:12.69,Default,,0,0,0,,«Бақыт сені»
Dialogue: 0,0:19:12.98,0:19:13.86,Default,,0,0,0,,Хмм?
Dialogue: 0,0:19:14.73,0:19:15.69,Default,,0,0,0,,Мен саған айттым ба?
Dialogue: 0,0:19:16.78,0:19:18.94,Default,,0,0,0,,Тез арада шешілмеңіз
Dialogue: 0,0:19:19.78,0:19:20.70,Default,,0,0,0,,Қызықты
Dialogue: 0,0:19:21.70,0:19:23.20,Default,,0,0,0,,Неліктен қолданып көрмеске?
Dialogue: 0,0:19:25.58,0:19:26.99,Default,,0,0,0,,Хмм аа!
Dialogue: 0,0:19:29.08,0:19:29.91,Default,,0,0,0,,Хамф!
Dialogue: 0,0:19:30.25,0:19:31.08,Default,,0,0,0,,Хамф!
Dialogue: 0,0:19:32.00,0:19:33.17,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:34.92,0:19:36.00,Default,,0,0,0,,Ура!
Dialogue: 0,0:19:37.63,0:19:38.55,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:43.55,0:19:44.47,Default,,0,0,0,,
Dialogue: 0,0:19:53.94,0:19:54.77,Default,,0,0,0,,Уф
Dialogue: 0,0:19:55.73,0:19:56.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:57.32,0:19:58.48,Default,,0,0,0,,Уф (Юдзиро) Хмм...
Dialogue: 0,0:20:00.61,0:20:02.28,Default,,0,0,0,,Ли Кай-Ванг мырза
Dialogue: 0,0:20:04.87,0:20:05.99,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:20:06.33,0:20:08.08,Default,,0,0,0,,Қандай себеп болса да
Dialogue: 0,0:20:08.62,0:20:10.00,Default,,0,0,0,,Мотив қандай болса да
Dialogue: 0,0:20:10.75,0:20:13.00,Default,,0,0,0,,Мен дәл қазір осылай тұрмын...
Dialogue: 0,0:20:14.42,0:20:15.75,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:20:18.21,0:20:19.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:19.59,0:20:20.76,Default,,0,0,0,,(айдаһар дыбысы)
Dialogue: 0,0:20:21.34,0:20:22.17,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:20:22.47,0:20:23.76,Default,,0,0,0,,Есеп айырысу! (қуаныш)
Dialogue: 0,0:20:23.93,0:20:26.72,Default,,0,0,0,,Жеңімпаз - Баки Ханма!
Dialogue: 0,0:20:28.14,0:20:29.51,Default,,0,0,0,,Бұрынғыдан да көп...
Dialogue: 0,0:20:30.18,0:20:32.35,Default,,0,0,0,,Баки! Баки!
Dialogue: 0,0:20:32.52,0:20:34.19,Default,,0,0,0,,Қазір бұрынғыдан да көп
Dialogue: 0,0:20:35.52,0:20:37.77,Default,,0,0,0,,Күшті тұра білу – бұл...
Dialogue: 0,0:20:38.65,0:20:40.86,Default,,0,0,0,,Баки! Баки!
Dialogue: 0,0:20:41.03,0:20:42.90,Default,,0,0,0,,Сізге рахмет!
Dialogue: 0,0:20:56.21,0:20:57.17,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:20:59.54,0:21:00.84,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:21:01.26,0:21:02.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:07.14,0:21:08.18,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:21:09.85,0:21:10.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:16.19,0:21:17.56,Default,,0,0,0,,Келесі түзетуге тиіс нәрсе
Dialogue: 0,0:21:21.36,0:21:27.36,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:43.40,0:22:49.40,Default,,0,0,0,,~♪
