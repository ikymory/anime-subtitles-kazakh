Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.17,0:00:12.97,Default,,0,0,0,,Сіз ең нашарсыз
Dialogue: 0,0:00:15.64,0:00:16.93,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:00:17.01,0:00:18.89,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:00:18.97,0:00:20.77,Default,,0,0,0,,(Савагучидің жылауы)
Dialogue: 0,0:00:20.85,0:00:24.81,Default,,0,0,0,,Савагучи неге жылап жатыр? Зардап шеккен мен болдым.
Dialogue: 0,0:00:24.89,0:00:27.94,Default,,0,0,0,,Гоу неге сонша ашуланады...
Dialogue: 0,0:00:28.82,0:00:31.28,Default,,0,0,0,,Мен Хараданы да өлтіреді деп ойладым.
Dialogue: 0,0:00:31.36,0:00:32.36,Default,,0,0,0,,Бұл қорқынышты болды...
Dialogue: 0,0:00:32.44,0:00:35.20,Default,,0,0,0,,Балалар, Австралияға ерулерің керек пе?
Dialogue: 0,0:00:37.16,0:00:39.83,Default,,0,0,0,,Мен ашулы Го Яконы бірінші рет көріп тұрмын...
Dialogue: 0,0:00:39.91,0:00:41.45,Default,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:00:41.54,0:00:44.54,Default,,0,0,0,,Савагучи, сіз бір-біріңізді бұрыннан танисыз, солай ма?
Dialogue: 0,0:00:44.62,0:00:46.71,Default,,0,0,0,,Балабақшадан бері
Dialogue: 0,0:00:46.79,0:00:49.96,Default,,0,0,0,,Го сен кішкентай кезіңнен бері ашуланды ма?
Dialogue: 0,0:00:50.05,0:00:51.46,Default,,0,0,0,,Эй, ешқашан.
Dialogue: 0,0:00:51.55,0:00:54.97,Default,,0,0,0,,Бұл таңқаларлық. Бұл тірі ұлттық қазынамен тең емес пе?
Dialogue: 0,0:00:56.13,0:00:56.97,Default,,0,0,0,,Харада
Dialogue: 0,0:00:57.76,0:00:58.72,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:00:58.80,0:01:00.97,Default,,0,0,0,,- (Йосисада) Годан кешірім сұрау керек - (Такуми) Ал сен ше?
Dialogue: 0,0:01:01.06,0:01:03.48,Default,,0,0,0,,Қайсысы нашар деп сұрама.
Dialogue: 0,0:01:03.56,0:01:06.81,Default,,0,0,0,,Егер Австралия болмаса, допты кім алады?
Dialogue: 0,0:01:06.90,0:01:07.98,Default,,0,0,0,,Нобаниши мырза?
Dialogue: 0,0:01:08.06,0:01:09.98,Default,,0,0,0,,Мен ол жігіттің қолына түсе аламын ба?
Dialogue: 0,0:01:10.06,0:01:12.61,Default,,0,0,0,,Дұрыс па? Годан басқа ешкім жоқ.
Dialogue: 0,0:01:12.69,0:01:16.20,Default,,0,0,0,,Кешірім сұрап, батареяны жинаңыз.
Dialogue: 0,0:01:16.28,0:01:18.07,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:01:18.16,0:01:21.87,Default,,0,0,0,,Мен сендермен үш жыл бойы керемет бейсбол ойнай аламын деп ойлаймын.
Dialogue: 0,0:01:21.95,0:01:23.75,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:01:23.83,0:01:26.04,Default,,0,0,0,,Бейсболды тоғыз адам ойнайды.
Dialogue: 0,0:01:26.12,0:01:28.37,Default,,0,0,0,,Басқаларға сенсең, не істейсің?
Dialogue: 0,0:01:29.17,0:01:32.30,Default,,0,0,0,,Сонымен, бұл Го Харада болуы керек, солай ма?
Dialogue: 0,0:01:32.38,0:01:34.71,Default,,0,0,0,,Егер солай болса, уайымдамаңыз.
Dialogue: 0,0:01:37.97,0:01:39.30,Default,,0,0,0,,Қайтару
Dialogue: 0,0:01:43.06,0:01:48.06,Default,,0,0,0,,♪～
Dialogue: 0,0:03:07.52,0:03:12.52,Default,,0,0,0,,～♪
Dialogue: 0,0:03:19.03,0:03:21.11,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:21.20,0:03:22.57,Default,,0,0,0,,О Такуми?
Dialogue: 0,0:03:23.45,0:03:25.78,Default,,0,0,0,,Сіз өте шаршаған сияқтысыз
Dialogue: 0,0:03:25.87,0:03:29.29,Default,,0,0,0,,Бүгін мен алғаш рет бейсбол клубының жаттығуына қатыстым.
Dialogue: 0,0:03:29.91,0:03:31.79,Default,,0,0,0,,Менімен ойнаудан шаршадың ба?
Dialogue: 0,0:03:33.88,0:03:35.92,Default,,0,0,0,,Такуми есінен танып қалады
Dialogue: 0,0:03:36.00,0:03:36.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:37.80,0:03:39.59,Default,,0,0,0,,Егер сіз әдеттегідей болсаңыз
Dialogue: 0,0:03:39.67,0:03:42.93,Default,,0,0,0,,«Жай ғана жаттығу мені шаршатады ма?» Гурдың жауабы болды
Dialogue: 0,0:03:43.01,0:03:45.18,Default,,0,0,0,,Қайтып келуі керек...
Dialogue: 0,0:03:51.18,0:03:52.31,Default,,0,0,0,,Ерлі-зайыптылардың төбелесуі?
Dialogue: 0,0:03:52.39,0:03:53.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:54.02,0:03:55.86,Default,,0,0,0,,Гомен төбелескен шығарсың.
Dialogue: 0,0:03:55.94,0:03:58.86,Default,,0,0,0,,Ол әйеліне бұлай жасады.
Dialogue: 0,0:03:58.94,0:04:00.07,Default,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,0:04:00.15,0:04:02.82,Default,,0,0,0,,Менің мойным қызарып кетті.
Dialogue: 0,0:04:03.61,0:04:05.91,Default,,0,0,0,,Анам мені жылатпаса
Dialogue: 0,0:04:05.99,0:04:07.78,Default,,0,0,0,,Оны дұрыс жасырыңыз
Dialogue: 0,0:04:09.49,0:04:10.58,Default,,0,0,0,,Ата
Dialogue: 0,0:04:11.29,0:04:14.50,Default,,0,0,0,,Қызық, денеңізді ұстағанда ғана айта аласыз ба?
Dialogue: 0,0:04:14.58,0:04:16.96,Default,,0,0,0,,Қанша және қалай жаттығу керек
Dialogue: 0,0:04:18.96,0:04:20.21,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:04:20.30,0:04:23.30,Default,,0,0,0,,Мүмкін емес пе? Бірақ бүгін мектепте...
Dialogue: 0,0:04:24.05,0:04:26.22,Default,,0,0,0,,Сіз өте қатал тәжірибесіз.
Dialogue: 0,0:04:26.30,0:04:27.47,Default,,0,0,0,,Оқуды жалғастыру
Dialogue: 0,0:04:27.55,0:04:29.76,Default,,0,0,0,,Егер сіз белгілі бір деңгейдегі нұсқаушы болсаңыз
Dialogue: 0,0:04:29.85,0:04:32.18,Default,,0,0,0,,Блеф деп айту оңай болуы мүмкін.
Dialogue: 0,0:04:32.27,0:04:34.48,Default,,0,0,0,,Жоқ, бұл слэм-данк болды.
Dialogue: 0,0:04:34.56,0:04:35.94,Default,,0,0,0,,Бұл блеф.
Dialogue: 0,0:04:36.02,0:04:39.94,Default,,0,0,0,,Орта мектептегі баланың қандай екенін түсіну оңай деп ойласаңыз.
Dialogue: 0,0:04:40.02,0:04:42.99,Default,,0,0,0,,Жас жігіт екеніңізге сенімдісіз бе?
Dialogue: 0,0:04:43.74,0:04:46.86,Default,,0,0,0,,Мен сенімді емеспін, бірақ менің ойымша, ол 30-да.
Dialogue: 0,0:04:46.95,0:04:50.24,Default,,0,0,0,,Көшбасшы болатын кез келді.
Dialogue: 0,0:04:50.33,0:04:53.96,Default,,0,0,0,,Балалардың ертегілері сізді бәрін білетіндей әсерге бөлейді.
Dialogue: 0,0:04:54.04,0:04:55.83,Default,,0,0,0,,Қорқыныш айқайлайды
Dialogue: 0,0:04:55.92,0:04:56.75,Default,,0,0,0,,Қорқыныш?
Dialogue: 0,0:04:56.83,0:05:00.50,Default,,0,0,0,,Мен бұл жаста балалардың не айтатынын түсінбеймін.
Dialogue: 0,0:05:00.59,0:05:03.17,Default,,0,0,0,,Осы уақытқа дейін ол ешқашан байқалмаған.
Dialogue: 0,0:05:03.26,0:05:06.63,Default,,0,0,0,,Сізге ұнайтын қыз ойынды көруге келгендіктен.
Dialogue: 0,0:05:06.72,0:05:09.76,Default,,0,0,0,,Мен бір рет үш үйге жүгірдім.
Dialogue: 0,0:05:09.85,0:05:12.85,Default,,0,0,0,,Бұл жігіттің түрі мынау десең,
Dialogue: 0,0:05:12.93,0:05:15.18,Default,,0,0,0,,Әдетте кейінірек тат үшін тит болады.
Dialogue: 0,0:05:15.27,0:05:18.06,Default,,0,0,0,,Сенің ұрпағың осындай.
Dialogue: 0,0:05:18.15,0:05:19.61,Default,,0,0,0,,Бұл шынымен де қорқынышты.
Dialogue: 0,0:05:20.36,0:05:24.11,Default,,0,0,0,,Ал, сенің директорың қандай жігіт?
Dialogue: 0,0:05:24.19,0:05:25.53,Default,,0,0,0,,Атын Томура
Dialogue: 0,0:05:25.61,0:05:27.78,Default,,0,0,0,,Томура? Бұл рас па?
Dialogue: 0,0:05:27.86,0:05:31.12,Default,,0,0,0,,Мен білмеймін. Томура: Макото, сен білесің бе?
Dialogue: 0,0:05:31.20,0:05:34.16,Default,,0,0,0,,Ах, мен Нитта орта мектебін тастаған кезде
Dialogue: 0,0:05:34.25,0:05:36.91,Default,,0,0,0,,Менің ойымша, ол екінші курста тұрақты болды.
Dialogue: 0,0:05:37.00,0:05:39.50,Default,,0,0,0,,Жақсы болды, байсалды бала едің.
Dialogue: 0,0:05:39.58,0:05:41.25,Default,,0,0,0,,Сіз қате адамсыз.
Dialogue: 0,0:05:41.34,0:05:43.67,Default,,0,0,0,,Ол шынымен қу жігіт.
Dialogue: 0,0:05:43.76,0:05:46.17,Default,,0,0,0,,Барлық қызықсыз нәрселерді айту
Dialogue: 0,0:05:46.26,0:05:47.76,Default,,0,0,0,,Шашыңыздың ұзындығы ше?
Dialogue: 0,0:05:47.84,0:05:49.89,Default,,0,0,0,,Бейсболға қатысы жоқ нәрселерді айту...
Dialogue: 0,0:05:49.97,0:05:51.18,Default,,0,0,0,,Сирек кездесетін жәндіктер
Dialogue: 0,0:05:51.26,0:05:52.51,Default,,0,0,0,,Ә? Не айтпақшысың?
Dialogue: 0,0:05:53.18,0:05:55.98,Default,,0,0,0,,Сіз тіпті басқаларды мақтамайсыз.
Dialogue: 0,0:05:56.06,0:05:57.81,Default,,0,0,0,,Жаман сөз айтпа
Dialogue: 0,0:05:57.89,0:06:00.15,Default,,0,0,0,,Міне, мен бүгін шағымданамын.
Dialogue: 0,0:06:00.77,0:06:02.44,Default,,0,0,0,,Бұл сирек кездеседі
Dialogue: 0,0:06:07.11,0:06:09.53,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:19.83,0:06:21.29,Default,,0,0,0,,Бауырым, амансың ба?
Dialogue: 0,0:06:23.09,0:06:24.13,Default,,0,0,0,,Не?
Dialogue: 0,0:06:24.96,0:06:26.80,Default,,0,0,0,,Сіз Го Чанмен ұрысып қалдыңыз, солай ма?
Dialogue: 0,0:06:26.88,0:06:28.72,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:06:29.59,0:06:31.43,Default,,0,0,0,,Мұны сенен кім сұрады?
Dialogue: 0,0:06:32.01,0:06:35.18,Default,,0,0,0,,Сұрағанда ғана айта аламын, аға, көңіліңіз жайсыз.
Dialogue: 0,0:06:35.26,0:06:38.43,Default,,0,0,0,,Мен сіз сияқты үнемі ренжімеймін.
Dialogue: 0,0:06:39.14,0:06:41.35,Default,,0,0,0,,Мен шынымен де өзімді жақсы сезінбеймін.
Dialogue: 0,0:06:41.44,0:06:43.94,Default,,0,0,0,,Мен Го Чанмен ұрысып қалғанымды бірден білдім.
Dialogue: 0,0:06:44.86,0:06:47.40,Default,,0,0,0,,Амансың ба? Ауыртпайды ма?
Dialogue: 0,0:06:56.29,0:07:01.21,Default,,0,0,0,,(мүшелердің айқайы)
Dialogue: 0,0:07:02.63,0:07:03.96,Default,,0,0,0,,Сәлем Харада
Dialogue: 0,0:07:04.04,0:07:06.71,Default,,0,0,0,,Австралиялық жігіт таңертеңнен бері сөйлемейді.
Dialogue: 0,0:07:06.80,0:07:08.21,Default,,0,0,0,,Сізге де?
Dialogue: 0,0:07:08.30,0:07:11.13,Default,,0,0,0,,Мен аңырап сыртқа қарадым.
Dialogue: 0,0:07:11.22,0:07:13.18,Default,,0,0,0,,Оның бізге қатысы жоқ десеңіз
Dialogue: 0,0:07:13.26,0:07:15.35,Default,,0,0,0,,Шу шығарып, қарап тұрмаңыз
Dialogue: 0,0:07:15.43,0:07:17.22,Default,,0,0,0,,Сіз түтіккен балаға ұқсайсыз.
Dialogue: 0,0:07:17.81,0:07:19.23,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:19.31,0:07:21.06,Default,,0,0,0,,Ашуланған соң
Dialogue: 0,0:07:21.14,0:07:23.73,Default,,0,0,0,,Неге екенін түсінбегеніңізге сенімдімін.
Dialogue: 0,0:07:23.81,0:07:27.28,Default,,0,0,0,,Өтінемін, Харада, менімен татуласып кетші.
Dialogue: 0,0:07:27.36,0:07:30.36,Default,,0,0,0,,Сөйлесе жүгірсең, тынысың тарылады.
Dialogue: 0,0:07:30.90,0:07:36.33,Default,,0,0,0,,(мүшелердің айқайы)
Dialogue: 0,0:07:39.95,0:07:41.46,Default,,0,0,0,,Оши
Dialogue: 0,0:07:41.54,0:07:44.54,Default,,0,0,0,,Жаңбыр жауып тұр, бүгінгі күн осымен бітті.
Dialogue: 0,0:07:44.63,0:07:45.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:45.54,0:07:48.05,Default,,0,0,0,,Харада: Сізде шағым бар ма?
Dialogue: 0,0:07:48.13,0:07:49.38,Default,,0,0,0,,бітті ме?
Dialogue: 0,0:07:49.46,0:07:51.47,Default,,0,0,0,,Соңында жаңбыр жауды
Dialogue: 0,0:07:51.55,0:07:54.26,Default,,0,0,0,,Бірақ сіз осыншама жаңбырға төтеп бере аласыз.
Dialogue: 0,0:07:54.34,0:07:55.97,Default,,0,0,0,,Егер бұл сәйкестік болса, ол жойылмайды.
Dialogue: 0,0:07:57.76,0:08:01.23,Default,,0,0,0,,Біткен соң, бітті десек, бітті
Dialogue: 0,0:08:01.31,0:08:03.02,Default,,0,0,0,,Бүгін мұнда мұғалім жоқ.
Dialogue: 0,0:08:03.10,0:08:05.35,Default,,0,0,0,,Бірінші сынып оқушылары бұл туралы айтпайды.
Dialogue: 0,0:08:05.44,0:08:08.82,Default,,0,0,0,,1-ші және 2-ші сынып оқушылары құрал-жабдықтарын пайдаланғаннан кейін тазалауы керек.
Dialogue: 0,0:08:08.90,0:08:09.73,Default,,0,0,0,,Таратылды!
Dialogue: 0,0:08:09.82,0:08:12.36,Default,,0,0,0,,Көгерген
Dialogue: 0,0:08:14.36,0:08:15.95,Default,,0,0,0,,Харада-кун
Dialogue: 0,0:08:16.45,0:08:19.83,Default,,0,0,0,,Сен ақымақсың. Тіпті кәсіби ойыншылар да соған ұмтылғысы келеді ме?
Dialogue: 0,0:08:19.91,0:08:22.54,Default,,0,0,0,,Көп алданбаңыз
Dialogue: 0,0:08:22.62,0:08:24.67,Default,,0,0,0,,Өйткені топтық жұмыс маңызды
Dialogue: 0,0:08:24.75,0:08:27.25,Default,,0,0,0,,Мазалаған кезде қиындыққа тап боламыз.
Dialogue: 0,0:08:27.34,0:08:30.42,Default,,0,0,0,,Ойын кезінде жаңбыр жауса не істейсің?
Dialogue: 0,0:08:30.50,0:08:31.76,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:08:31.84,0:08:33.80,Default,,0,0,0,,Осылай жаңбыр жауса, ойын болады.
Dialogue: 0,0:08:33.88,0:08:35.26,Default,,0,0,0,,Маған жаттығу керек пе?
Dialogue: 0,0:08:36.34,0:08:37.51,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:08:37.60,0:08:38.51,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:38.60,0:08:40.51,Default,,0,0,0,,Менің бейсбол клубым
Dialogue: 0,0:08:40.60,0:08:43.06,Default,,0,0,0,,Салқын көрініп, жаңбырлы күні суланба
Dialogue: 0,0:08:43.14,0:08:45.98,Default,,0,0,0,,Пневмония тудыратындай ақымақтық жасамаңыз.
Dialogue: 0,0:08:46.06,0:08:47.61,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:08:47.69,0:08:51.53,Default,,0,0,0,,Мен Харада-кун сияқты қыңыр адамды қаламаймын.
Dialogue: 0,0:08:52.61,0:08:54.53,Default,,0,0,0,,Сіз шынымен де қызықпайсыз.
Dialogue: 0,0:08:57.11,0:08:59.08,Default,,0,0,0,,Менің ағам менімен сөйлессе де.
Dialogue: 0,0:08:59.16,0:09:01.29,Default,,0,0,0,,Менің ойымша, бұл жаман көзқарас емес.
Dialogue: 0,0:09:02.45,0:09:03.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:03.37,0:09:04.50,Default,,0,0,0,,(саусақтарды қолдануға арналған дыбыс)
Dialogue: 0,0:09:05.00,0:09:06.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:08.38,0:09:10.09,Default,,0,0,0,,Айтпақшы, Харада-кун
Dialogue: 0,0:09:10.17,0:09:12.00,Default,,0,0,0,,Мен Томура мырзадан шаш қиюын өтіндім.
Dialogue: 0,0:09:12.09,0:09:13.42,Default,,0,0,0,,Бұл сіздің айтқаныңыз емес пе?
Dialogue: 0,0:09:13.51,0:09:14.97,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:09:15.05,0:09:18.43,Default,,0,0,0,,Қырылған шаш сүйкімді Харада-кунға жараспайды.
Dialogue: 0,0:09:19.93,0:09:21.68,Default,,0,0,0,,Кешіріңіз, вице-капитан!
Dialogue: 0,0:09:23.27,0:09:25.52,Default,,0,0,0,,Маған жабдық бөлмесінің кілтін беріңізші.
Dialogue: 0,0:09:25.60,0:09:27.69,Default,,0,0,0,,Есік жабылуда.
Dialogue: 0,0:09:33.28,0:09:34.99,Default,,0,0,0,,Мен оны тазалаймын.
Dialogue: 0,0:09:36.86,0:09:38.45,Default,,0,0,0,,Такуми кеттік
Dialogue: 0,0:09:51.54,0:09:53.00,Default,,0,0,0,,- (Такуми) Бару - (Бару) Иә?
Dialogue: 0,0:09:53.09,0:09:55.92,Default,,0,0,0,,Маған көмектесетін болсаң, тезірек кел.
Dialogue: 0,0:09:56.01,0:09:57.63,Default,,0,0,0,,Менің саған көмектескенімді қалайсың ба?
Dialogue: 0,0:09:57.72,0:09:58.88,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:58.97,0:10:00.47,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:10:02.56,0:10:04.97,Default,,0,0,0,,Такуми, абай болу керек.
Dialogue: 0,0:10:06.27,0:10:07.60,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:10:07.69,0:10:10.77,Default,,0,0,0,,Балалар, сендер сөйлей бастағанда мен де солай ойладым.
Dialogue: 0,0:10:11.48,0:10:13.44,Default,,0,0,0,,Сырттан солай көрінді.
Dialogue: 0,0:10:14.15,0:10:15.94,Default,,0,0,0,,Олар лас емес.
Dialogue: 0,0:10:16.03,0:10:19.49,Default,,0,0,0,,Олар араласа береді және ештеңе істемейді.
Dialogue: 0,0:10:20.32,0:10:23.12,Default,,0,0,0,,Шынымды айтсам, дәл осылай ұрысып қалсақ ше?
Dialogue: 0,0:10:23.20,0:10:25.62,Default,,0,0,0,,Сен бірінші маған қимыл жасамадың ба?
Dialogue: 0,0:10:25.70,0:10:26.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:27.46,0:10:30.33,Default,,0,0,0,,Ха... Сабақты жақсы орындамасаң, сабақтан шеттетіледі.
Dialogue: 0,0:10:30.42,0:10:31.58,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:10:31.67,0:10:33.13,Default,,0,0,0,,Қалай сақ болу керек?
Dialogue: 0,0:10:33.21,0:10:35.25,Default,,0,0,0,,Ересек сиыр
Dialogue: 0,0:10:35.34,0:10:37.88,Default,,0,0,0,,Өзіңді босатсаң жақсы емес пе?
Dialogue: 0,0:10:37.97,0:10:40.01,Default,,0,0,0,,Мұғалімдер мен үлкендер не дейді
Dialogue: 0,0:10:40.09,0:10:42.39,Default,,0,0,0,,Тек адал тыңдау керек.
Dialogue: 0,0:10:45.43,0:10:47.52,Default,,0,0,0,,Бірдеңе керек болса, сұраймын.
Dialogue: 0,0:10:47.60,0:10:50.23,Default,,0,0,0,,Бірақ мен үнсіз ғана бағынғым келмейді.
Dialogue: 0,0:10:50.31,0:10:51.48,Default,,0,0,0,,Такуми…
Dialogue: 0,0:10:51.56,0:10:52.40,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:53.31,0:10:55.44,Default,,0,0,0,,Мен енді не істерімді білмеймін
Dialogue: 0,0:10:55.94,0:10:56.78,Default,,0,0,0,,Австралия
Dialogue: 0,0:10:57.49,0:10:59.53,Default,,0,0,0,,Қане, аулау ойынын ойнайық
Dialogue: 0,0:10:59.61,0:11:00.99,Default,,0,0,0,,Жаңбырда?
Dialogue: 0,0:11:01.07,0:11:02.53,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:11:02.62,0:11:04.91,Default,,0,0,0,,Бүгінгідей жаттығуды аяқтаудың жолы жоқ.
Dialogue: 0,0:11:04.99,0:11:06.74,Default,,0,0,0,,Мен оны лақтырғым келеді
Dialogue: 0,0:11:06.83,0:11:07.91,Default,,0,0,0,,(доптың құлаған дыбысы)
Dialogue: 0,0:11:11.75,0:11:13.50,Default,,0,0,0,,Кешіріңіз, бірақ мен олай сезінбеймін.
Dialogue: 0,0:11:13.58,0:11:14.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:15.09,0:11:17.13,Default,,0,0,0,,Сен лақтырғың келеді, солай ма?
Dialogue: 0,0:11:17.21,0:11:18.88,Default,,0,0,0,,Бұл көңілсіздік.
Dialogue: 0,0:11:18.96,0:11:20.13,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:11:20.22,0:11:22.80,Default,,0,0,0,,Мен мұнда тек сенімен айналысу үшін келген жоқпын.
Dialogue: 0,0:11:23.76,0:11:25.18,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:11:25.76,0:11:27.18,Default,,0,0,0,,Жәкенте
Dialogue: 0,0:11:27.26,0:11:28.52,Default,,0,0,0,,Мен әрқашан сенің айтқаныңды істеймін
Dialogue: 0,0:11:28.60,0:11:30.06,Default,,0,0,0,,Ол қозғалмайды
Dialogue: 0,0:11:30.77,0:11:33.19,Default,,0,0,0,,Сіз басқаларға ергенді ұнатпайтыныңызды айттыңыз.
Dialogue: 0,0:11:33.81,0:11:35.23,Default,,0,0,0,,Мен де солаймын.
Dialogue: 0,0:11:35.31,0:11:37.82,Default,,0,0,0,,Қалағаныңызша қозғалуға қарсысыз ба?
Dialogue: 0,0:11:38.69,0:11:40.57,Default,,0,0,0,,Немесе Такуми...
Dialogue: 0,0:11:44.12,0:11:45.70,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:11:45.78,0:11:47.66,Default,,0,0,0,,Иә, қазірдің өзінде.
Dialogue: 0,0:11:47.74,0:11:50.33,Default,,0,0,0,,Мен сенің не айтқың келетінін де білмеймін.
Dialogue: 0,0:11:50.41,0:11:53.87,Default,,0,0,0,,Менің басым бұзылды, енді маған бәрібір.
Dialogue: 0,0:12:09.31,0:12:11.23,Default,,0,0,0,,Харада Отомрай қоңырау шалып жатыр.
Dialogue: 0,0:12:11.31,0:12:12.64,Default,,0,0,0,,О
Dialogue: 0,0:12:13.81,0:12:17.48,Default,,0,0,0,,Бүгіннен бастап біз Учитомен практикалық тәжірибені бастаймыз.
Dialogue: 0,0:12:17.57,0:12:21.24,Default,,0,0,0,,Тәжірибе тәртібі кестеге сәйкес.
Dialogue: 0,0:12:21.32,0:12:22.49,Default,,0,0,0,,Иә
Dialogue: 0,0:12:22.57,0:12:24.16,Default,,0,0,0,,Енді, Харада.
Dialogue: 0,0:12:26.82,0:12:29.74,Default,,0,0,0,,Эй, сен біздің клубтан шығуды жоспарлап жүрсің бе?
Dialogue: 0,0:12:29.83,0:12:32.79,Default,,0,0,0,,Жоқ, жұмыстан кететін ойым жоқ.
Dialogue: 0,0:12:32.87,0:12:34.75,Default,,0,0,0,,Сонда бұл не шаш?
Dialogue: 0,0:12:34.83,0:12:37.67,Default,,0,0,0,,Алдыңғы күні айтқан сөзімді ұмыттың ба?
Dialogue: 0,0:12:37.75,0:12:40.50,Default,,0,0,0,,Неге айтқанын орындамадың?
Dialogue: 0,0:12:44.47,0:12:46.14,Default,,0,0,0,,Ойынға барма
Dialogue: 0,0:12:46.22,0:12:47.26,Default,,0,0,0,,Неге!
Dialogue: 0,0:12:47.34,0:12:51.39,Default,,0,0,0,,Жаттықтырушының бұйрығы орындалмаса, ресми матч ойнауға бола ма?
Dialogue: 0,0:12:51.47,0:12:54.35,Default,,0,0,0,,Сізде талант бар екені сөзсіз.
Dialogue: 0,0:12:54.44,0:12:56.65,Default,,0,0,0,,Жәкен, аузыңды жап, менің айтқанымды істе.
Dialogue: 0,0:12:56.73,0:13:00.40,Default,,0,0,0,,Осылай жасасаң, сол талантты шығарасың.
Dialogue: 0,0:13:01.32,0:13:02.15,Default,,0,0,0,,Директор
Dialogue: 0,0:13:02.23,0:13:05.20,Default,,0,0,0,,Нагакура, мен саған қоңырау шалмаймын.
Dialogue: 0,0:13:05.28,0:13:07.32,Default,,0,0,0,,Берілген жаттығуларды орындаңыз
Dialogue: 0,0:13:07.41,0:13:09.45,Default,,0,0,0,,Мен Такумиді қайтарғым келеді.
Dialogue: 0,0:13:09.53,0:13:12.91,Default,,0,0,0,,Мен калистеникамен айналыса алмаймын.
Dialogue: 0,0:13:13.00,0:13:14.33,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:13:14.41,0:13:16.67,Default,,0,0,0,,үшін бірге бұл үлкен батарея.
Dialogue: 0,0:13:16.75,0:13:17.67,Default,,0,0,0,,Балалар
Dialogue: 0,0:13:18.25,0:13:21.67,Default,,0,0,0,,Дегенмен, екеуіңізге де матчқа қатысуға рұқсат етілмейді.
Dialogue: 0,0:13:23.76,0:13:25.42,Default,,0,0,0,,Шаштың оған еш қатысы жоқ.
Dialogue: 0,0:13:25.51,0:13:27.68,Default,,0,0,0,,Менің басым қырылған болса, доп жылдамырақ бола ма?
Dialogue: 0,0:13:27.76,0:13:29.22,Default,,0,0,0,,Сен ақымақ сияқтысың!
Dialogue: 0,0:13:32.01,0:13:33.31,Default,,0,0,0,,Идиот, сіз тым көп айтасыз
Dialogue: 0,0:13:37.60,0:13:38.81,Default,,0,0,0,,Директор
Dialogue: 0,0:13:39.40,0:13:41.61,Default,,0,0,0,,Жарғанатта тұру туралы не айтасыз?
Dialogue: 0,0:13:41.69,0:13:42.57,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:13:42.65,0:13:44.82,Default,,0,0,0,,(клуб мүшелерінің музыкасы)
Dialogue: 0,0:13:44.90,0:13:45.78,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:13:45.86,0:13:49.16,Default,,0,0,0,,Мм... Хараданың добы өте жылдам.
Dialogue: 0,0:13:49.24,0:13:51.83,Default,,0,0,0,,Директор: Мен оны тексеріп көрейін деп ойладым.
Dialogue: 0,0:13:52.33,0:13:54.83,Default,,0,0,0,,А, жоқ, бұл... Кешіріңіз.
Dialogue: 0,0:13:56.46,0:13:58.54,Default,,0,0,0,,...
Dialogue: 0,0:13:58.62,0:14:00.58,Default,,0,0,0,,Маған оны жарғанат арқылы тексеруге рұқсат етіңіз.
Dialogue: 0,0:14:00.67,0:14:02.50,Default,,0,0,0,,Қорғанысқа тұрақты құрамдарды тағайындаңыз
Dialogue: 0,0:14:02.59,0:14:03.84,Default,,0,0,0,,Мұғалім, мен қиналдым.
Dialogue: 0,0:14:03.92,0:14:05.38,Default,,0,0,0,,Мәселе неде?
Dialogue: 0,0:14:05.46,0:14:07.34,Default,,0,0,0,,Сіздің жаттығу кестеңіз бұзылады.
Dialogue: 0,0:14:07.42,0:14:10.68,Default,,0,0,0,,Бұл көп уақытты қажет етпейді Ор Тензай...
Dialogue: 0,0:14:11.39,0:14:14.06,Default,,0,0,0,,Менің әдістеріме де көңіліңіз толмай ма?
Dialogue: 0,0:14:15.68,0:14:16.68,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:17.77,0:14:20.44,Default,,0,0,0,,Олай болса, Мидорикава екеуің барып көріңдер.
Dialogue: 0,0:14:20.52,0:14:22.94,Default,,0,0,0,,Дөң мияу, мына бала көтеріліп келеді.
Dialogue: 0,0:14:23.90,0:14:25.57,Default,,0,0,0,,Мұғалім Ум...
Dialogue: 0,0:14:25.65,0:14:29.32,Default,,0,0,0,,1-ші сыныпты батареяның қуатын көрсетейін.
Dialogue: 0,0:14:29.41,0:14:31.12,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:14:35.16,0:14:37.45,Default,,0,0,0,,Отомрай өте жақсы жігіт.
Dialogue: 0,0:14:37.54,0:14:40.04,Default,,0,0,0,,Сіз батареяны дұрыс жинадыңыз.
Dialogue: 0,0:14:40.12,0:14:43.13,Default,,0,0,0,,Мен Тензайдың ұстай алмайтынын білемін.
Dialogue: 0,0:14:43.21,0:14:45.21,Default,,0,0,0,,Отомрайға қарсы лақтырасың ба?
Dialogue: 0,0:14:45.30,0:14:48.22,Default,,0,0,0,,Дұрыс, Кайондзи-санға рахмет.
Dialogue: 0,0:14:55.43,0:14:56.47,Default,,0,0,0,,Ойнайық
Dialogue: 0,0:15:06.65,0:15:07.99,Default,,0,0,0,,Доп
Dialogue: 0,0:15:08.07,0:15:11.49,Default,,0,0,0,,Нагакура Енді оны әдейі алып тастадың ба?
Dialogue: 0,0:15:12.66,0:15:13.49,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:15:14.07,0:15:17.16,Default,,0,0,0,,Менен балық аулайтын доп сұрадың.
Dialogue: 0,0:15:17.24,0:15:18.08,Default,,0,0,0,,Иә
Dialogue: 0,0:15:18.16,0:15:19.00,Default,,0,0,0,,Хмм…
Dialogue: 0,0:15:28.13,0:15:29.51,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:15:32.34,0:15:34.51,Default,,0,0,0,,Ақымақ мінезді адамдар бар.
Dialogue: 0,0:15:44.86,0:15:46.11,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:15:46.19,0:15:47.15,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:53.49,0:15:55.82,Default,,0,0,0,,Бұл дөрекі емес пе?
Dialogue: 0,0:15:55.91,0:15:58.20,Default,,0,0,0,,Төреші абдырап, абдырап қалады.
Dialogue: 0,0:15:58.29,0:16:01.37,Default,,0,0,0,,Нагакура: Бұл сіздің жетекшіңіз емес пе?
Dialogue: 0,0:16:01.46,0:16:02.29,Default,,0,0,0,,Иә
Dialogue: 0,0:16:02.37,0:16:05.04,Default,,0,0,0,,Хараданың бақылауы дәл осы
Dialogue: 0,0:16:05.13,0:16:08.88,Default,,0,0,0,,Егер шайба сіздің бағытыңызды оқыса, сіз қаншалықты жылдам болсаңыз да соққыға ұшырайсыз.
Dialogue: 0,0:16:08.96,0:16:09.80,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:16:10.46,0:16:11.97,Default,,0,0,0,,Бірақ бұл қате.
Dialogue: 0,0:16:12.05,0:16:14.55,Default,,0,0,0,,Директор үйге жүгіруді көздеп отыр, солай ма?
Dialogue: 0,0:16:14.64,0:16:16.35,Default,,0,0,0,,Ол кейінге қалдырылды
Dialogue: 0,0:16:16.85,0:16:18.81,Default,,0,0,0,,Такуми допты жеңу қиын болды.
Dialogue: 0,0:16:18.89,0:16:21.77,Default,,0,0,0,,Ха... мәселе бұл емес.
Dialogue: 0,0:16:21.85,0:16:25.35,Default,,0,0,0,,Егер сіз соққы алсаңыз, бұл батареяның кінәсі.
Dialogue: 0,0:16:25.44,0:16:26.61,Default,,0,0,0,,Кел, Харада
Dialogue: 0,0:16:26.69,0:16:28.32,Default,,0,0,0,,Тенниши Мидорикава Можа
Dialogue: 0,0:16:29.27,0:16:30.32,Default,,0,0,0,,тіпті ол өзі де білмейтін Титантарға қатысты бір құпия жатыр дейді.
Dialogue: 0,0:16:31.11,0:16:34.32,Default,,0,0,0,,Харада мен Нагакура Бүгіннен бастап негізгі жаттығудан кейін
Dialogue: 0,0:16:34.41,0:16:36.07,Default,,0,0,0,,Питтинг тәжірибесін енгізу
Dialogue: 0,0:16:36.16,0:16:37.07,Default,,0,0,0,,О...
Dialogue: 0,0:16:37.16,0:16:39.66,Default,,0,0,0,,Харада: Сіз матч өткізесіз бе?
Dialogue: 0,0:16:39.74,0:16:43.08,Default,,0,0,0,,Болды, мен сол кездегі жағдайға қарап шешемін.
Dialogue: 0,0:16:44.21,0:16:45.12,Default,,0,0,0,,Иә
Dialogue: 0,0:16:46.04,0:16:48.75,Default,,0,0,0,,Шынымен, жаттығуды жалғастырайық.
Dialogue: 0,0:16:48.84,0:16:50.84,Default,,0,0,0,,Мидорикава, питчингке қайта оралыңыз.
Dialogue: 0,0:16:50.92,0:16:53.97,Default,,0,0,0,,Бірінші сынып оқушылары калистеника жаттығуларын дәл жалғастыру керек.
Dialogue: 0,0:16:54.05,0:16:54.72,Default,,0,0,0,,Иә
Dialogue: 0,0:16:54.72,0:16:55.26,Default,,0,0,0,,Иә
Dialogue: 0,0:16:54.72,0:16:55.26,Default,,0,0,0,,Менің қазір істеуім керек.
Dialogue: 0,0:16:55.26,0:16:56.97,Default,,0,0,0,,Менің қазір істеуім керек.
Dialogue: 0,0:17:03.39,0:17:04.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:06.81,0:17:08.02,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:17:09.06,0:17:11.48,Default,,0,0,0,,А... Сәлеметсіз бе.
Dialogue: 0,0:17:11.57,0:17:13.86,Default,,0,0,0,,Сіз осы адамдардың бірісіз бе?
Dialogue: 0,0:17:13.94,0:17:16.66,Default,,0,0,0,,Олай болса, сенің ісің кімге арналған?
Dialogue: 0,0:17:16.74,0:17:18.32,Default,,0,0,0,,-(Томура) Мм... -(Аонами) Ах.
Dialogue: 0,0:17:18.41,0:17:19.74,Default,,0,0,0,,Мен болжап көрейін.
Dialogue: 0,0:17:24.46,0:17:27.12,Default,,0,0,0,,Әй, мүмкін ата?
Dialogue: 0,0:17:27.71,0:17:30.38,Default,,0,0,0,,Иә, сен қайдан білдің?
Dialogue: 0,0:17:30.46,0:17:32.71,Default,,0,0,0,,Атам шомылыңыз
Dialogue: 0,0:17:32.80,0:17:34.63,Default,,0,0,0,,Осы сағатта ваннаға түсуім керек пе?
Dialogue: 0,0:17:34.72,0:17:37.89,Default,,0,0,0,,Иә, әкем іссапардан оралған соң келеді.
Dialogue: 0,0:17:37.97,0:17:39.14,Default,,0,0,0,,Ағай да кіреді ме?
Dialogue: 0,0:17:39.22,0:17:41.01,Default,,0,0,0,,Жоқ, иә.
Dialogue: 0,0:17:41.10,0:17:42.56,Default,,0,0,0,,Неге шалбарыңды әкелмейсің?
Dialogue: 0,0:17:42.64,0:17:44.27,Default,,0,0,0,,Е? Иә.
Dialogue: 0,0:17:46.06,0:17:48.15,Default,,0,0,0,,Клиент ата
Dialogue: 0,0:17:48.23,0:17:49.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:52.32,0:17:53.15,Default,,0,0,0,,Директор
Dialogue: 0,0:17:53.98,0:17:57.15,Default,,0,0,0,,Біраз уақыт өтті, мен ұмытып кеткен шығармын...
Dialogue: 0,0:17:57.24,0:17:59.07,Default,,0,0,0,,Рас?
Dialogue: 0,0:17:59.57,0:18:01.16,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:18:01.24,0:18:02.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:02.37,0:18:05.66,Default,,0,0,0,,А...Негізі, менің саған айтатын шағын әңгімем бар.
Dialogue: 0,0:18:06.79,0:18:08.54,Default,,0,0,0,,Сіз Такуми туралы айтып отырсыз ба?
Dialogue: 0,0:18:08.62,0:18:10.92,Default,,0,0,0,,үшінн болжай аласыз.
Dialogue: 0,0:18:11.00,0:18:13.67,Default,,0,0,0,,Басшы Мен жай ғана айтайын.
Dialogue: 0,0:18:13.75,0:18:15.80,Default,,0,0,0,,Мен Хараданы жаттықтырғым келеді.
Dialogue: 0,0:18:15.88,0:18:18.34,Default,,0,0,0,,Мен сол баланы толыққанды бала етіп өсіргім келеді.
Dialogue: 0,0:18:19.01,0:18:21.26,Default,,0,0,0,,Тым бүлікшіл
Dialogue: 0,0:18:21.35,0:18:24.22,Default,,0,0,0,,Мұндай тұлғамен оқыту қиын.
Dialogue: 0,0:18:24.31,0:18:26.23,Default,,0,0,0,,Директордың өзінен аздап...
Dialogue: 0,0:18:26.31,0:18:27.68,Default,,0,0,0,,Рас айтасыз
Dialogue: 0,0:18:28.27,0:18:30.40,Default,,0,0,0,,Міне, мен әр оқушының қартына айналдым.
Dialogue: 0,0:18:30.48,0:18:32.48,Default,,0,0,0,,Сіз ынтымақтастық туралы сұрайсыз ба?
Dialogue: 0,0:18:32.56,0:18:34.07,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:18:34.15,0:18:36.90,Default,,0,0,0,,Мен директордың немересі болғандықтан келдім.
Dialogue: 0,0:18:36.99,0:18:39.70,Default,,0,0,0,,Режиссер кімге көбірек әсер етеді?
Dialogue: 0,0:18:39.78,0:18:42.70,Default,,0,0,0,,Оған ешкімнің ықпалы жоқ.
Dialogue: 0,0:18:44.37,0:18:45.70,Default,,0,0,0,,Менің айтқаным болса
Dialogue: 0,0:18:46.29,0:18:50.21,Default,,0,0,0,,Такуми кез келген нәрсені тыңдайды деп ойлап осында келсең, қателестің.
Dialogue: 0,0:18:50.92,0:18:54.71,Default,,0,0,0,,Жарайды, мен біреудің айтқанын орындайтын адам емеспін.
Dialogue: 0,0:18:54.80,0:18:56.13,Default,,0,0,0,,Жәкең сол жаста
Dialogue: 0,0:18:56.21,0:18:58.72,Default,,0,0,0,,Мүмкін мен де солай лақтыратын шығармын.
Dialogue: 0,0:19:00.68,0:19:02.47,Default,,0,0,0,,Сіз мысқылдайсыз ба? Директор
Dialogue: 0,0:19:02.55,0:19:04.14,Default,,0,0,0,,Сарказм?
Dialogue: 0,0:19:04.72,0:19:08.02,Default,,0,0,0,,Біз орта мектепте оқып жүргенде директордың айтқанын тыңдайтынбыз.
Dialogue: 0,0:19:08.10,0:19:10.39,Default,,0,0,0,,Мен бәрін теңіз кірпісіне апардым.
Dialogue: 0,0:19:10.48,0:19:12.23,Default,,0,0,0,,Директордың айтқанын орындаңыз
Dialogue: 0,0:19:12.31,0:19:15.65,Default,,0,0,0,,Мен Кошиенге бара алатыныма сендім.
Dialogue: 0,0:19:16.40,0:19:17.23,Default,,0,0,0,,Seede?
Dialogue: 0,0:19:17.32,0:19:19.28,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:19:19.36,0:19:22.49,Default,,0,0,0,,Директор жұмыстан кеткенде мен дайындалдым.
Dialogue: 0,0:19:22.57,0:19:25.41,Default,,0,0,0,,А, менің ойымша, біз енді жеңе алмаймыз.
Dialogue: 0,0:19:25.49,0:19:27.95,Default,,0,0,0,,Директор біздің күшімізден бас тартты.
Dialogue: 0,0:19:28.04,0:19:29.75,Default,,0,0,0,,Мен жұмыстан шықтым.
Dialogue: 0,0:19:30.46,0:19:32.50,Default,,0,0,0,,Сіз менің жұмыстан кеткенімді көрдіңіз.
Dialogue: 0,0:19:32.58,0:19:34.50,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,0:19:34.59,0:19:37.30,Default,,0,0,0,,Менің олай ойламағаным анық болды.
Dialogue: 0,0:19:37.38,0:19:39.80,Default,,0,0,0,,Бірақ мен күзгі турнирде жеңілгенімде
Dialogue: 0,0:19:39.88,0:19:41.97,Default,,0,0,0,,Маған директор айтты.
Dialogue: 0,0:19:42.05,0:19:45.89,Default,,0,0,0,,Иока мырза, сіз жаңа ғана бас тартқан нәрселер бар.
Dialogue: 0,0:19:45.97,0:19:47.51,Default,,0,0,0,,Бұл ирониялық
Dialogue: 0,0:19:48.18,0:19:49.02,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:49.10,0:19:50.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:50.60,0:19:52.73,Default,,0,0,0,,Менің атам неге бейсбол ойнауды қойды?
Dialogue: 0,0:19:52.81,0:19:55.02,Default,,0,0,0,,Неліктен әже ауырып қалды?
Dialogue: 0,0:19:55.11,0:19:57.69,Default,,0,0,0,,Ата мен әже бір-бірін жақсы көретін.
Dialogue: 0,0:19:57.77,0:20:00.03,Default,,0,0,0,,Мен үнемі әжемнің қасында болдым.
Dialogue: 0,0:20:00.11,0:20:01.20,Default,,0,0,0,,Ое Аонами
Dialogue: 0,0:20:01.28,0:20:03.95,Default,,0,0,0,,Мен саған ештеңе айтпаған шығармын.
Dialogue: 0,0:20:04.03,0:20:05.74,Default,,0,0,0,,Менімен сөйлесе алмасаңыз, түсінемін.
Dialogue: 0,0:20:05.82,0:20:07.33,Default,,0,0,0,,Ата, ішімдік ішкеннен кейін.
Dialogue: 0,0:20:07.41,0:20:09.29,Default,,0,0,0,,Мен әрқашан әжем туралы айтамын.
Dialogue: 0,0:20:10.70,0:20:12.29,Default,,0,0,0,,Бұл күлкілі.
Dialogue: 0,0:20:13.33,0:20:16.79,Default,,0,0,0,,Такуми осы уақытқа дейін болуы мүмкін.
Dialogue: 0,0:20:16.88,0:20:18.50,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:18.59,0:20:20.42,Default,,0,0,0,,Мен бүгін жарғанақта тұрдым.
Dialogue: 0,0:20:20.51,0:20:22.42,Default,,0,0,0,,Хараданың добын көру
Dialogue: 0,0:20:22.51,0:20:24.05,Default,,0,0,0,,Шынымды айтсам, таң қалдым.
Dialogue: 0,0:20:24.13,0:20:25.43,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:25.51,0:20:28.81,Default,,0,0,0,,Жүрегімді елжіреткен қызды кездестіргеніме қуаныштымын.
Dialogue: 0,0:20:28.89,0:20:31.06,Default,,0,0,0,,Мен болсам, қарар едім.
Dialogue: 0,0:20:31.14,0:20:33.31,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:20:34.65,0:20:38.32,Default,,0,0,0,,Сөйтсем, өз немерең шығар.
Dialogue: 0,0:20:38.40,0:20:39.65,Default,,0,0,0,,Мүмкін, мен кенеттен үйленуге ұсыныс жасағандықтан шығар—
Dialogue: 0,0:20:39.73,0:20:42.65,Default,,0,0,0,,Егер сіз өзіңізді Харада деп ойласаңыз, мен әлі де өсе аламын.
Dialogue: 0,0:20:42.74,0:20:44.32,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:20:44.40,0:20:47.32,Default,,0,0,0,,Бірақ бұл тек жеңіске жету құралы.
Dialogue: 0,0:20:47.41,0:20:48.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:50.79,0:20:52.37,Default,,0,0,0,,Бейсбол ойыны
Dialogue: 0,0:20:52.45,0:20:54.33,Default,,0,0,0,,Бұл өте қызық.
Dialogue: 0,0:20:54.41,0:20:56.17,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:20:57.42,0:21:01.17,Default,,0,0,0,,Бұл таңқаларлық. Мен матчта ойнай алатын шығармын.
Dialogue: 0,0:21:01.25,0:21:02.26,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:21:02.34,0:21:03.92,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:21:04.01,0:21:04.84,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:21:04.01,0:21:04.84,Default,,0,0,0,,Мен сізді Отомрай пайдалану керек пе, жоқ па деп ойлаймын.
Dialogue: 0,0:21:04.84,0:21:06.47,Default,,0,0,0,,Отомрай сені пайдалансын ба, жоқ па деп ойлаймын.
Dialogue: 0,0:21:06.55,0:21:08.01,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,0:21:08.10,0:21:09.55,Default,,0,0,0,,Сіз мұны бұрын айттыңыз.
Dialogue: 0,0:21:10.06,0:21:13.02,Default,,0,0,0,,Матчта ойнаудың қажеті жоқ, ойнау керек.
Dialogue: 0,0:21:13.02,0:21:13.85,Default,,0,0,0,,Матчта ойнаудың қажеті жоқ, ойнау керек.
Dialogue: 0,0:21:13.02,0:21:13.85,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:21:14.60,0:21:16.40,Default,,0,0,0,,Бұл біздің бейсболымыз.
Dialogue: 0,0:21:25.99,0:21:30.99,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.24,0:22:55.91,Default,,0,0,0,,～♪
