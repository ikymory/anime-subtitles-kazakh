Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.25,0:00:09.42,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:00:12.30,0:00:13.76,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:00:16.59,0:00:17.60,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:00:20.35,0:00:24.14,Default,,0,0,0,,Харада, кеш болып қалды, үндемей тұрайық.
Dialogue: 0,0:00:24.23,0:00:27.19,Default,,0,0,0,,Иә, мен жинап жатырмын.
Dialogue: 0,0:00:27.27,0:00:30.03,Default,,0,0,0,,Қалағаныңызша жаттығуға болады.
Dialogue: 0,0:00:30.11,0:00:32.53,Default,,0,0,0,,Уақыт тым көп артта қалса, бұл проблема болар еді.
Dialogue: 0,0:00:32.61,0:00:33.53,Default,,0,0,0,,Иә
Dialogue: 0,0:00:33.61,0:00:34.86,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:00:34.95,0:00:36.03,Default,,0,0,0,,Оши
Dialogue: 0,0:00:36.61,0:00:39.16,Default,,0,0,0,,Харада жабдық бөлмесінің есігін құлыптады.
Dialogue: 0,0:00:39.24,0:00:41.12,Default,,0,0,0,,Нагакура клуб бөлмесін жинайды
Dialogue: 0,0:00:41.20,0:00:42.79,Default,,0,0,0,,Дұрыс орындаңыз
Dialogue: 0,0:00:42.87,0:00:45.29,Default,,0,0,0,,- (Тениши) Мен бірінші үйге барамын - (Австралия) Иә.
Dialogue: 0,0:00:45.37,0:00:46.67,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:00:48.38,0:00:51.84,Default,,0,0,0,,Хмм, «Кездескенше».
Dialogue: 0,0:00:51.92,0:00:53.92,Default,,0,0,0,,Бұл Otomrai эффектісі.
Dialogue: 0,0:00:54.01,0:00:57.09,Default,,0,0,0,,Егер Отомрай мақұлдаса, бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:00:57.18,0:00:58.55,Default,,0,0,0,,Балалар!
Dialogue: 0,0:00:58.64,0:00:59.80,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:00:59.89,0:01:02.43,Default,,0,0,0,,Мен сені мектеп қақпасында күтемін.
Dialogue: 0,0:01:04.77,0:01:06.81,Default,,0,0,0,,Маған допты тастауға көмектесіңіз.
Dialogue: 0,0:01:11.15,0:01:12.03,Default,,0,0,0,,Австралия туралы не деуге болады?
Dialogue: 0,0:01:12.11,0:01:13.78,Default,,0,0,0,,Клуб бөлмесін тазалау.
Dialogue: 0,0:01:13.86,0:01:15.07,Default,,0,0,0,,Хмм.
Dialogue: 0,0:01:25.04,0:01:27.83,Default,,0,0,0,,Эй, мен сыртта күтемін.
Dialogue: 0,0:01:27.92,0:01:29.75,Default,,0,0,0,,Мен қараңғыда жақсы емеспін.
Dialogue: 0,0:01:33.25,0:01:34.26,Default,,0,0,0,,(Жарғанаттың соғу дыбысы)
Dialogue: 0,0:01:34.34,0:01:35.92,Default,,0,0,0,,Ой
Dialogue: 0,0:01:57.07,0:02:02.08,Default,,0,0,0,,♪～
Dialogue: 0,0:03:21.53,0:03:26.53,Default,,0,0,0,,～♪
Dialogue: 0,0:03:34.58,0:03:35.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:36.79,0:03:38.21,Default,,0,0,0,,Савагучи?
Dialogue: 0,0:03:38.30,0:03:39.21,Default,,0,0,0,,(Тіректің сықырлаған дыбысы)
Dialogue: 0,0:03:39.30,0:03:40.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:47.10,0:03:48.10,Default,,0,0,0,,Савагучи
Dialogue: 0,0:03:52.27,0:03:54.65,Default,,0,0,0,,Ақымақ болма, мен үйге барамын.
Dialogue: 0,0:03:55.40,0:03:56.90,Default,,0,0,0,,Ах!Уф...
Dialogue: 0,0:03:57.57,0:03:58.40,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:00.36,0:04:03.15,Default,,0,0,0,,А, балалар... сендер қандайсыңдар?
Dialogue: 0,0:04:03.78,0:04:06.41,Default,,0,0,0,,Ой... жібер, ақымақ.
Dialogue: 0,0:04:06.49,0:04:07.91,Default,,0,0,0,,Не болып жатыр өзі?
Dialogue: 0,0:04:07.99,0:04:08.99,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:14.00,0:04:16.67,Default,,0,0,0,,Балалар... жіберіңдер!
Dialogue: 0,0:04:17.25,0:04:19.50,Default,,0,0,0,,Өтінемін, мені кешіріңіз
Dialogue: 0,0:04:19.59,0:04:21.38,Default,,0,0,0,,Сәждеге баратын болсаң, мен сені жіберемін.
Dialogue: 0,0:04:21.46,0:04:22.92,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:04:31.02,0:04:31.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:33.77,0:04:34.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:37.02,0:04:37.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:39.27,0:04:42.61,Default,,0,0,0,,(белдік соғу дыбысы)
Dialogue: 0,0:04:43.86,0:04:45.66,Default,,0,0,0,,Маған көмектесіңізші деп айтыңыз
Dialogue: 0,0:04:45.74,0:04:47.66,Default,,0,0,0,,Олай болса бітті.
Dialogue: 0,0:04:48.53,0:04:49.83,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:04:51.41,0:04:52.95,Default,,0,0,0,,Мен шаш алайын деп жатырмын.
Dialogue: 0,0:04:53.04,0:04:55.37,Default,,0,0,0,,Мойыннан жоғары жасама.
Dialogue: 0,0:04:55.46,0:04:56.46,Default,,0,0,0,,байқалады
Dialogue: 0,0:04:56.54,0:04:58.54,Default,,0,0,0,,Цк, орындайық.
Dialogue: 0,0:04:58.63,0:04:59.84,Default,,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:05:03.51,0:05:04.34,Default,,0,0,0,,(Такуми құлаған дыбыс)
Dialogue: 0,0:05:05.63,0:05:07.68,Default,,0,0,0,,Мен жылдам допты кішкентай доп сияқты лақтыра аламын деп ойлаймын.
Dialogue: 0,0:05:07.76,0:05:09.10,Default,,0,0,0,,Бортқа мініңіз
Dialogue: 0,0:05:09.18,0:05:11.64,Default,,0,0,0,,Әй, бос сөз айтпа.
Dialogue: 0,0:05:11.72,0:05:12.72,Default,,0,0,0,,Кеттік
Dialogue: 0,0:05:12.81,0:05:15.02,Default,,0,0,0,,(Адамды қалдыру)
Dialogue: 0,0:05:15.10,0:05:18.35,Default,,0,0,0,,Менің доптарымды өзіңдікімен салыстырма.
Dialogue: 0,0:05:18.44,0:05:19.73,Default,,0,0,0,,(Такумидің ыңырсыуы)
Dialogue: 0,0:05:20.27,0:05:22.32,Default,,0,0,0,,Ал... жақсы...
Dialogue: 0,0:05:22.40,0:05:24.69,Default,,0,0,0,,Тоқта, енді емес
Dialogue: 0,0:05:25.95,0:05:26.78,Default,,0,0,0,,(Такуми құлаған дыбыс)
Dialogue: 0,0:05:28.20,0:05:31.28,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:05:32.54,0:05:35.33,Default,,0,0,0,,(Такуми терең тыныс алады)
Dialogue: 0,0:05:39.58,0:05:40.63,Default,,0,0,0,,Такуми
Dialogue: 0,0:05:42.17,0:05:43.42,Default,,0,0,0,,Такуми!
Dialogue: 0,0:05:44.46,0:05:45.42,Default,,0,0,0,,Гррр…
Dialogue: 0,0:05:45.51,0:05:48.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:49.47,0:05:50.68,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:05:50.76,0:05:53.93,Default,,0,0,0,,Сонда бұл қан емес пе?
Dialogue: 0,0:05:55.35,0:05:56.39,Default,,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,0:06:07.03,0:06:10.45,Default,,0,0,0,,Мұнда кел, менімен бірге жүр.
Dialogue: 0,0:06:10.53,0:06:12.28,Default,,0,0,0,,Неліктен сіздің орныңыз...
Dialogue: 0,0:06:12.37,0:06:16.20,Default,,0,0,0,,Егер қасында ешкім болмаса, оған қамқорлық жасамау керек.
Dialogue: 0,0:06:17.50,0:06:18.58,Default,,0,0,0,,Мені жайына қалдыр
Dialogue: 0,0:06:18.66,0:06:20.50,Default,,0,0,0,,Сіз мені жалғыз қалдыра аласыз ба?
Dialogue: 0,0:06:21.50,0:06:22.34,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:06:26.88,0:06:27.72,Default,,0,0,0,,Кеттік
Dialogue: 0,0:06:28.34,0:06:29.43,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:06:49.24,0:06:51.99,Default,,0,0,0,,Жуынайық немесе жуынатын бөлмеге барайық.
Dialogue: 0,0:06:52.99,0:06:53.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:56.29,0:06:58.58,Default,,0,0,0,,Такуми Жарайды Жәкен
Dialogue: 0,0:06:58.66,0:07:00.46,Default,,0,0,0,,Енді ешкім қалмады
Dialogue: 0,0:07:01.87,0:07:04.63,Default,,0,0,0,,Мен оларды кешірмеймін...
Dialogue: 0,0:07:04.71,0:07:06.92,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:07:07.00,0:07:08.92,Default,,0,0,0,,Баяу дем шығарыңыз
Dialogue: 0,0:07:09.01,0:07:11.18,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:07:12.93,0:07:14.05,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:14.14,0:07:17.72,Default,,0,0,0,,«Жарайды» дедіңіз, солай ма?
Dialogue: 0,0:07:18.31,0:07:20.77,Default,,0,0,0,,Маған душ қабылдауға рұқсат етіңіз.
Dialogue: 0,0:07:20.85,0:07:22.35,Default,,0,0,0,,Таңғажайып тер
Dialogue: 0,0:07:22.44,0:07:24.15,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:07:24.23,0:07:25.06,Default,,0,0,0,,(кранды жабу дыбысы)
Dialogue: 0,0:07:31.95,0:07:33.49,Default,,0,0,0,,Бұл өте лас
Dialogue: 0,0:07:33.57,0:07:37.24,Default,,0,0,0,,Қарасам, бұл менің былтырғы пижамаларым.
Dialogue: 0,0:07:37.33,0:07:40.25,Default,,0,0,0,,Өзіңізді күтіңіз және төсекке жатыңыз.
Dialogue: 0,0:07:42.29,0:07:43.25,Default,,0,0,0,,Сіз...
Dialogue: 0,0:07:43.83,0:07:45.75,Default,,0,0,0,,Иә, солай...
Dialogue: 0,0:07:47.84,0:07:49.88,Default,,0,0,0,,Бұл аздап қорқынышты.
Dialogue: 0,0:07:49.96,0:07:51.26,Default,,0,0,0,,Шағымданбаңыз
Dialogue: 0,0:07:53.84,0:07:55.60,Default,,0,0,0,,Қараңыз, аяқтаңыз
Dialogue: 0,0:07:56.10,0:07:58.18,Default,,0,0,0,,Мен дәкені ертең ауыстырамын.
Dialogue: 0,0:08:00.14,0:08:01.31,Default,,0,0,0,,Бұл ауырды ма?
Dialogue: 0,0:08:04.23,0:08:06.77,Default,,0,0,0,,Бар, мені аяма.
Dialogue: 0,0:08:06.86,0:08:08.77,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:08:09.73,0:08:11.40,Default,,0,0,0,,Ауырсынуды басатын дәрі қабылдаңыз.
Dialogue: 0,0:08:11.49,0:08:13.82,Default,,0,0,0,,Барлығы сізбен бірге болады.
Dialogue: 0,0:08:13.91,0:08:16.28,Default,,0,0,0,,Көрініп тұр, бұл бизнес.
Dialogue: 0,0:08:16.87,0:08:18.53,Default,,0,0,0,,Мен ұйықтай аламын ба?
Dialogue: 0,0:08:18.62,0:08:20.66,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:20.75,0:08:21.87,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:24.42,0:08:25.25,Default,,0,0,0,,Австралия
Dialogue: 0,0:08:26.42,0:08:28.96,Default,,0,0,0,,Бүгінгі күнді ешкімге айтпа.
Dialogue: 0,0:08:29.05,0:08:32.05,Default,,0,0,0,,Мен мұны айтпауым керек екенін білемін, бірақ қайырлы түн.
Dialogue: 0,0:08:42.85,0:08:44.89,Default,,0,0,0,,Қараңдар, тамақ ішейік.
Dialogue: 0,0:08:45.39,0:08:46.77,Default,,0,0,0,,А...
Dialogue: 0,0:08:50.07,0:08:52.32,Default,,0,0,0,,Аа, енді ойлап қарасам, ұмытып кетіппін.
Dialogue: 0,0:08:52.99,0:08:54.11,Default,,0,0,0,,Қый!
Dialogue: 0,0:08:54.20,0:08:56.49,Default,,0,0,0,,Әй, үйің болса, мен сені шақырар едім.
Dialogue: 0,0:08:56.57,0:08:57.95,Default,,0,0,0,,Түнде болу
Dialogue: 0,0:08:58.03,0:08:59.37,Default,,0,0,0,,Сіз қоңырау шалдыңыз ба?
Dialogue: 0,0:08:59.45,0:09:00.28,Default,,0,0,0,,Иә
Dialogue: 0,0:09:00.87,0:09:03.54,Default,,0,0,0,,Нағашы апаңның айтқанын естідім.
Dialogue: 0,0:09:03.62,0:09:06.33,Default,,0,0,0,,Мәселе жоқ, солай ма? Менің жаттығу киімдерім де құрғақ.
Dialogue: 0,0:09:06.42,0:09:08.71,Default,,0,0,0,,Сіз шынымен...
Dialogue: 0,0:09:09.34,0:09:12.30,Default,,0,0,0,,Не деп тұрсың, жазықсыз?
Dialogue: 0,0:09:12.38,0:09:13.34,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:09:13.42,0:09:14.84,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:09:14.92,0:09:18.72,Default,,0,0,0,,Жарайды, мен не істеймін деп ойланып қалатын кездер болады.
Dialogue: 0,0:09:19.47,0:09:21.72,Default,,0,0,0,,Сіз оны жек көрмейсіз бе? Мұндай нәрсе
Dialogue: 0,0:09:21.81,0:09:23.72,Default,,0,0,0,,Сізге ұнамай ма?
Dialogue: 0,0:09:23.81,0:09:26.39,Default,,0,0,0,,Бұл мен туралы емес.
Dialogue: 0,0:09:26.48,0:09:27.73,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:09:27.81,0:09:30.90,Default,,0,0,0,,О, менің тіс щеткамды алуым керек сияқты.
Dialogue: 0,0:09:32.82,0:09:35.11,Default,,0,0,0,,Маған тағы бір шыны шай беріңізші.
Dialogue: 0,0:09:35.19,0:09:36.24,Default,,0,0,0,,Күн ыстық
Dialogue: 0,0:09:36.32,0:09:38.74,Default,,0,0,0,,Тапсырыстар өте көп
Dialogue: 0,0:09:38.82,0:09:41.24,Default,,0,0,0,,Ағам айтқандай...
Dialogue: 0,0:09:41.91,0:09:42.99,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:45.79,0:09:47.37,Default,,0,0,0,,Савагучи келмеді.
Dialogue: 0,0:09:47.46,0:09:50.00,Default,,0,0,0,,Сава? Сіз үзіліс жасайсыз ба?
Dialogue: 0,0:09:50.08,0:09:53.75,Default,,0,0,0,,Эй, ол жоқ еді.
Dialogue: 0,0:09:53.84,0:09:55.97,Default,,0,0,0,,Біз мектептен шыққан кезде
Dialogue: 0,0:09:56.05,0:09:58.26,Default,,0,0,0,,Иә, болмады.
Dialogue: 0,0:09:58.34,0:10:00.09,Default,,0,0,0,,Әлгі жігіттің ашушаңдығы бар.
Dialogue: 0,0:10:00.18,0:10:03.14,Default,,0,0,0,,Менің ойымша, сіз таң қалдыңыз және үйге бірінші кетті деп ойладыңыз.
Dialogue: 0,0:10:05.18,0:10:07.81,Default,,0,0,0,,Ол жабдық бөлмесіне дейін менімен бірге болды.
Dialogue: 0,0:10:07.89,0:10:09.48,Default,,0,0,0,,Такуми…
Dialogue: 0,0:10:10.27,0:10:13.40,Default,,0,0,0,,Сава кеше бізді клуб бөлмесіне шақырды.
Dialogue: 0,0:10:13.48,0:10:15.78,Default,,0,0,0,,Сіз барлық қиындықты жасап жатырсыз.
Dialogue: 0,0:10:15.86,0:10:17.65,Default,,0,0,0,,Сол қиын кезеңде
Dialogue: 0,0:10:18.15,0:10:20.28,Default,,0,0,0,,Савагучи қайда болды?
Dialogue: 0,0:10:20.36,0:10:22.20,Default,,0,0,0,,Саваның бұған қатысы жоқ.
Dialogue: 0,0:10:22.28,0:10:25.70,Default,,0,0,0,,Саваның ақымақтық жасауы мүмкін емес!
Dialogue: 0,0:10:25.79,0:10:27.71,Default,,0,0,0,,Оны ешкім айтқан жоқ.
Dialogue: 0,0:10:27.79,0:10:30.83,Default,,0,0,0,,Бірақ бүгін демалысқа шығасың ба?
Dialogue: 0,0:10:30.92,0:10:33.25,Default,,0,0,0,,Сабақтан кейін барайық.
Dialogue: 0,0:10:33.34,0:10:35.17,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:10:35.25,0:10:36.76,Default,,0,0,0,,Сізді қызықтыратын шығар.
Dialogue: 0,0:10:43.14,0:10:45.60,Default,,0,0,0,,Сава Хараданы ұрмаңыз.
Dialogue: 0,0:10:45.68,0:10:48.39,Default,,0,0,0,,Мен неге Савагучиге жұдырықтаймын?
Dialogue: 0,0:10:48.48,0:10:50.60,Default,,0,0,0,,Бұл сізді бәрібір сияқты етеді.
Dialogue: 0,0:10:51.23,0:10:54.73,Default,,0,0,0,,Мен Саваға күмәнданамын және одан бірдеңе сұрағым келеді.
Dialogue: 0,0:10:56.07,0:10:58.86,Default,,0,0,0,,Савахана, сен ондай адам емессің.
Dialogue: 0,0:10:58.94,0:11:01.24,Default,,0,0,0,,Мен бұған күмәнданбаймын.
Dialogue: 0,0:11:01.32,0:11:04.33,Default,,0,0,0,,Кеше осындай жағдай болды, сондықтан мен бүгін демалыс аламын.
Dialogue: 0,0:11:04.41,0:11:06.29,Default,,0,0,0,,Сіз бұл туралы алаңдамайсыз ба?
Dialogue: 0,0:11:06.37,0:11:08.91,Default,,0,0,0,,Сіз шынымен Сава үшін алаңдайсыз ба?
Dialogue: 0,0:11:09.00,0:11:10.41,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:11:10.50,0:11:14.38,Default,,0,0,0,,Олай болмаса, неге үйірме жұмыстарынан үзіліс жасайсыз?
Dialogue: 0,0:11:19.55,0:11:22.89,Default,,0,0,0,,Ах, Сава... Не істеп жүр!?
Dialogue: 0,0:11:23.59,0:11:24.89,Default,,0,0,0,,Ағашқа өрмелеу?
Dialogue: 0,0:11:25.55,0:11:27.39,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:11:27.47,0:11:30.06,Default,,0,0,0,,Менің ойымша, ол секірмейді.
Dialogue: 0,0:11:30.14,0:11:32.65,Default,,0,0,0,,Идиот, біртүрлі сөз айтпа.
Dialogue: 0,0:11:36.82,0:11:37.65,Default,,0,0,0,,Ах
Dialogue: 0,0:11:38.65,0:11:40.65,Default,,0,0,0,,Сава! Түсіңіз
Dialogue: 0,0:11:43.70,0:11:45.16,Default,,0,0,0,,Харада Кешіріңіз
Dialogue: 0,0:11:45.24,0:11:49.20,Default,,0,0,0,,«Кешіріңіз» деген не? Түсіп, сөйлесіңіз.
Dialogue: 0,0:11:49.29,0:11:51.54,Default,,0,0,0,,Харада Сіз ашулысыз, солай емес пе?
Dialogue: 0,0:11:51.62,0:11:53.25,Default,,0,0,0,,Мен ашуланбаймын!
Dialogue: 0,0:11:53.33,0:11:56.88,Default,,0,0,0,,Айқайлама, Харада, мейірімдірек көрінуге тырыс.
Dialogue: 0,0:11:56.96,0:11:59.21,Default,,0,0,0,,Олай болса, Такуми, күл.
Dialogue: 0,0:11:59.30,0:12:01.38,Default,,0,0,0,,Нәзік дауысты қолданыңыз.
Dialogue: 0,0:12:01.88,0:12:05.18,Default,,0,0,0,,Ақымақ, қуанбаса да күле аласың ба?
Dialogue: 0,0:12:05.93,0:12:08.26,Default,,0,0,0,,Ара балық құлап қалса, уайымдамаңыз.
Dialogue: 0,0:12:08.35,0:12:10.02,Default,,0,0,0,,Бұл Хараданың жауапкершілігі.
Dialogue: 0,0:12:14.48,0:12:17.52,Default,,0,0,0,,Савагучи, басыңды көтер.
Dialogue: 0,0:12:17.61,0:12:19.32,Default,,0,0,0,,Маған кешегі күн туралы айтып бере аласыз ба?
Dialogue: 0,0:12:23.28,0:12:26.82,Default,,0,0,0,,Кеше мен жабдық бөлмесінің сыртында болдым.
Dialogue: 0,0:12:26.91,0:12:28.70,Default,,0,0,0,,Менің аузым кенет артымнан жабылып қалды.
Dialogue: 0,0:12:29.41,0:12:31.33,Default,,0,0,0,,Тыныш бол деп айту
Dialogue: 0,0:12:31.41,0:12:33.37,Default,,0,0,0,,Мен қатты қорқамын...
Dialogue: 0,0:12:33.46,0:12:35.33,Default,,0,0,0,,Қорықпаңыз және қозғалмаңыз
Dialogue: 0,0:12:35.42,0:12:37.46,Default,,0,0,0,,Жабдық бөлмесінен біраз адамдар шықты.
Dialogue: 0,0:12:37.54,0:12:40.00,Default,,0,0,0,,Бітті деп күлдім.
Dialogue: 0,0:12:40.09,0:12:41.71,Default,,0,0,0,,Бар, мен сені шақырамын.
Dialogue: 0,0:12:42.67,0:12:45.43,Default,,0,0,0,,Бірақ мен Харада-санға қарауға қорқамын.
Dialogue: 0,0:12:45.51,0:12:47.72,Default,,0,0,0,,Мен жай ғана қашып, үйге бара аламын...
Dialogue: 0,0:12:48.72,0:12:51.35,Default,,0,0,0,,Кешіріңіз... Кешіріңіз
Dialogue: 0,0:12:51.43,0:12:53.89,Default,,0,0,0,,Бұл Тензай болды ма?
Dialogue: 0,0:12:53.98,0:12:55.81,Default,,0,0,0,,Мүмкін, мен солай ойлаймын.
Dialogue: 0,0:12:55.90,0:12:58.61,Default,,0,0,0,,Эй, мен не істеуім керек?
Dialogue: 0,0:12:58.69,0:13:01.11,Default,,0,0,0,,Мен бұл туралы көптен бері ойладым, бірақ мен оны түсінбеймін.
Dialogue: 0,0:13:02.03,0:13:04.61,Default,,0,0,0,,Ағашқа шығып, кеңірек көрінсең де
Dialogue: 0,0:13:04.70,0:13:06.61,Default,,0,0,0,,Мен әлі түсінбедім
Dialogue: 0,0:13:06.70,0:13:09.58,Default,,0,0,0,,Отомрайға айтқан дұрыс емес пе?
Dialogue: 0,0:13:09.66,0:13:11.58,Default,,0,0,0,,Не болады?
Dialogue: 0,0:13:11.66,0:13:14.16,Default,,0,0,0,,Тензайдың жасағаны туралы ешқандай дәлел болмаса да.
Dialogue: 0,0:13:14.75,0:13:16.42,Default,,0,0,0,,Артқы жағындағы тыртық...
Dialogue: 0,0:13:16.92,0:13:18.71,Default,,0,0,0,,Сонда не болады?
Dialogue: 0,0:13:20.21,0:13:22.59,Default,,0,0,0,,Сондықтан клубтың қызметі тоқтатылады.
Dialogue: 0,0:13:22.67,0:13:24.51,Default,,0,0,0,,Сонда кім бақытты?
Dialogue: 0,0:13:24.59,0:13:26.51,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:13:26.59,0:13:30.26,Default,,0,0,0,,Бейсбол ойнай алмасаң, мектепке барудың қажеті жоқ!
Dialogue: 0,0:13:30.35,0:13:33.77,Default,,0,0,0,,Сонымен, сен бұған шыдайсың ба?
Dialogue: 0,0:13:33.85,0:13:36.10,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:13:36.19,0:13:37.02,Default,,0,0,0,,(Киришима) Сенпай Амагири жақсы жүр ме екен?
Dialogue: 0,0:13:42.11,0:13:43.69,Default,,0,0,0,,Савагучи
Dialogue: 0,0:13:43.78,0:13:46.74,Default,,0,0,0,,Ертең келіңіз, тіпті үйірме жұмыстары үшін болса да.
Dialogue: 0,0:13:49.37,0:13:51.08,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:13:57.41,0:13:58.75,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:14:01.34,0:14:03.75,Default,,0,0,0,,Харада Донешита
Dialogue: 0,0:14:03.84,0:14:06.05,Default,,0,0,0,,Оның әдеттегі күші болмаса да.
Dialogue: 0,0:14:06.13,0:14:07.22,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:07.30,0:14:10.26,Default,,0,0,0,,Мен кеше әлсіреп қалған сияқтымын, мен не ойлап отырмын?
Dialogue: 0,0:14:11.85,0:14:14.60,Default,,0,0,0,,Кеше босаңсуға не себеп болды?
Dialogue: 0,0:14:14.68,0:14:17.81,Default,,0,0,0,,Бүгінгі сұмдық питчинг немен байланысты?
Dialogue: 0,0:14:17.89,0:14:19.65,Default,,0,0,0,,Мен ештеңе істеп жатқан жоқпын.
Dialogue: 0,0:14:19.73,0:14:23.36,Default,,0,0,0,,Мұнда келіңіз және пішінмен араласпаңыз, ол ақаулық тудырады.
Dialogue: 0,0:14:23.44,0:14:24.28,Default,,0,0,0,,Иә
Dialogue: 0,0:14:24.36,0:14:27.86,Default,,0,0,0,,Мен алдағы турнирдің бірінші ойынын бастаушы боламын.
Dialogue: 0,0:14:27.95,0:14:29.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:29.24,0:14:30.41,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:14:30.49,0:14:31.78,Default,,0,0,0,,Стартер...
Dialogue: 0,0:14:32.99,0:14:36.16,Default,,0,0,0,,Ұстаушы Нобуниши болса, мен лақтыра алмаймын.
Dialogue: 0,0:14:36.25,0:14:37.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:38.00,0:14:41.08,Default,,0,0,0,,Нобуниши мырза менің допты ұстай алмайды.
Dialogue: 0,0:14:41.17,0:14:44.17,Default,,0,0,0,,Маған ұнамайды, егер бұл менің қолымнан келгенді көрсете алмайтын ойын болса.
Dialogue: 0,0:14:44.25,0:14:48.17,Default,,0,0,0,,Сіз оны ұстай аласыз ба, жоқ па, сіз жаттығуға дейін ешқашан білмейсіз.
Dialogue: 0,0:14:48.26,0:14:50.38,Default,,0,0,0,,Егер сіз допты ұстағыңыз келмесе
Dialogue: 0,0:14:50.47,0:14:51.97,Default,,0,0,0,,Дәл солай жаттығуға да қатысты.
Dialogue: 0,0:14:52.05,0:14:53.80,Default,,0,0,0,,Тензай да осылай деді
Dialogue: 0,0:14:53.89,0:14:56.89,Default,,0,0,0,,Мен сені ұстаушы бола алмаймын.
Dialogue: 0,0:14:56.97,0:14:59.85,Default,,0,0,0,,Менің айтқаныма қарсы шығады.
Dialogue: 0,0:15:00.89,0:15:04.19,Default,,0,0,0,,Иә? Мен қатты терлеп жатырмын
Dialogue: 0,0:15:04.27,0:15:06.90,Default,,0,0,0,,Эй, өзіңді шынымен нашар сезінесің бе?
Dialogue: 0,0:15:06.98,0:15:09.32,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:15:09.40,0:15:10.57,Default,,0,0,0,,Нагакура
Dialogue: 0,0:15:10.65,0:15:13.41,Default,,0,0,0,,Бүгін Харада үзіліс жасап, үйіне қайтсын.
Dialogue: 0,0:15:13.49,0:15:14.33,Default,,0,0,0,,Иә
Dialogue: 0,0:15:16.24,0:15:19.50,Default,,0,0,0,,Бұл таңқаларлық. Го және Харада екеуі де бастаушы.
Dialogue: 0,0:15:19.58,0:15:21.54,Default,,0,0,0,,Мен Такумидің қосымшасымын
Dialogue: 0,0:15:21.62,0:15:24.84,Default,,0,0,0,,Ақымақ батарея үшін бонустар немесе қосымшалар бар ма?
Dialogue: 0,0:15:24.92,0:15:27.84,Default,,0,0,0,,Егер сен болмасаң, допты кімге лақтырар едің?
Dialogue: 0,0:15:31.01,0:15:32.09,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:15:33.01,0:15:34.09,Default,,0,0,0,,Не?
Dialogue: 0,0:15:37.26,0:15:39.10,Default,,0,0,0,,Мен мұндай болады деп ешқашан ойламадым.
Dialogue: 0,0:15:39.18,0:15:42.10,Default,,0,0,0,,Менің ойымша, бұл барлық уақытта бола бермеді.
Dialogue: 0,0:15:42.19,0:15:44.23,Default,,0,0,0,,Екеуміз үндемей тұрайық.
Dialogue: 0,0:15:44.31,0:15:45.65,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:15:45.73,0:15:49.23,Default,,0,0,0,,Ашуланып, шектен шығып кеткенім үшін кешірім сұраймын.
Dialogue: 0,0:15:49.32,0:15:51.20,Default,,0,0,0,,Кешірім сұрау дұрыс па?
Dialogue: 0,0:15:51.28,0:15:54.91,Default,,0,0,0,,Екі жыл бойы байыппен не істеп жатырмыз
Dialogue: 0,0:15:54.99,0:15:56.74,Default,,0,0,0,,Сіз жақсы білесіз, солай ма?
Dialogue: 0,0:15:56.83,0:16:00.25,Default,,0,0,0,,Біз әрқашан жақсы балалар болдық, солай емес пе?
Dialogue: 0,0:16:00.83,0:16:03.50,Default,,0,0,0,,Мен бейсболды ұнатпасам да ойнадым.
Dialogue: 0,0:16:03.58,0:16:06.13,Default,,0,0,0,,Осыншама шыдасаң да, жарайды.
Dialogue: 0,0:16:06.21,0:16:09.88,Default,,0,0,0,,Ұстаз, сіз бізге опасыздық жасамайсыз, солай ма?
Dialogue: 0,0:16:09.96,0:16:13.13,Default,,0,0,0,,Бұл сатқындық па? Әзілді өткізіп алмаңыз
Dialogue: 0,0:16:14.34,0:16:15.64,Default,,0,0,0,,Нобуниши мырза...
Dialogue: 0,0:16:15.72,0:16:17.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:17.10,0:16:20.89,Default,,0,0,0,,Нобаниши мырза бейсболды жек көрді ме?
Dialogue: 0,0:16:21.48,0:16:23.48,Default,,0,0,0,,Ұнамайды да, жек көрмейді де.
Dialogue: 0,0:16:23.56,0:16:27.11,Default,,0,0,0,,Кіші орта мектеп – орта мектептен бір қадам ғана.
Dialogue: 0,0:16:27.19,0:16:29.57,Default,,0,0,0,,Бейсбол клубында белсенді болсаңыз
Dialogue: 0,0:16:29.65,0:16:31.36,Default,,0,0,0,,Ішкі есеп guttoyo naruite
Dialogue: 0,0:16:31.44,0:16:33.86,Default,,0,0,0,,Мен оны ағадан естідім.
Dialogue: 0,0:16:33.95,0:16:36.99,Default,,0,0,0,,Үйірмеге кірмегенің жақсы болар еді.
Dialogue: 0,0:16:37.07,0:16:40.54,Default,,0,0,0,,Қалағаныңды айт, қалағаныңды істе...
Dialogue: 0,0:16:40.62,0:16:42.87,Default,,0,0,0,,Сонымен, сіз кенеттен бастаушы болдыңыз ба?
Dialogue: 0,0:16:42.96,0:16:44.00,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:16:44.08,0:16:47.50,Default,,0,0,0,,Мені ұстанып, мазақ етпе!
Dialogue: 0,0:16:47.58,0:16:50.88,Default,,0,0,0,,Директор екеуің қалжыңдап тұрған боларсыңдар.
Dialogue: 0,0:16:53.13,0:16:56.26,Default,,0,0,0,,Сондай-ақ, Кайондзи бізден бөлек.
Dialogue: 0,0:16:56.97,0:17:00.64,Default,,0,0,0,,Ол бала кезінен бейсболға әуес болған.
Dialogue: 0,0:17:00.72,0:17:03.77,Default,,0,0,0,,Ол бізден өзгеше.
Dialogue: 0,0:17:09.23,0:17:10.90,Default,,0,0,0,,- (Кусанаги) Харада - (Такуми) Иә.
Dialogue: 0,0:17:11.48,0:17:13.78,Default,,0,0,0,,Дереу директордың кабинетіне барыңыз.
Dialogue: 0,0:17:16.99,0:17:20.74,Default,,0,0,0,,Қайырлы таң балалар, қиын болды.
Dialogue: 0,0:17:20.83,0:17:22.91,Default,,0,0,0,,Келіңіздер, отырыңыздар.
Dialogue: 0,0:17:27.54,0:17:30.09,Default,,0,0,0,,Томура Сенсей мен Нобуниши-кун деген кім?
Dialogue: 0,0:17:30.17,0:17:32.17,Default,,0,0,0,,Мен сенімен бұрын сөйлескенмін.
Dialogue: 0,0:17:32.25,0:17:34.88,Default,,0,0,0,,Тензай не болады?
Dialogue: 0,0:17:34.97,0:17:37.80,Default,,0,0,0,,Адамды біраз уақыт үйде күтіңіз
Dialogue: 0,0:17:37.89,0:17:39.30,Default,,0,0,0,,Мен жазаланамын ба?
Dialogue: 0,0:17:39.39,0:17:41.60,Default,,0,0,0,,Бұл жай ғана факт.
Dialogue: 0,0:17:41.68,0:17:44.81,Default,,0,0,0,,Біз де сақ болуымыз керек.
Dialogue: 0,0:17:44.89,0:17:47.77,Default,,0,0,0,,Нобуниши-кун және оның достары үлгілі студенттер болды.
Dialogue: 0,0:17:47.85,0:17:49.81,Default,,0,0,0,,Мен сенбеймін...
Dialogue: 0,0:17:49.90,0:17:52.48,Default,,0,0,0,,Шынында не болып жатыр?
Dialogue: 0,0:17:52.57,0:17:56.15,Default,,0,0,0,,...
Dialogue: 0,0:17:56.24,0:17:58.57,Default,,0,0,0,,...
Dialogue: 0,0:17:58.66,0:17:59.99,Default,,0,0,0,,Осымен
Dialogue: 0,0:18:00.07,0:18:02.70,Default,,0,0,0,,Олардың болашағын қарастыру
Dialogue: 0,0:18:02.79,0:18:05.70,Default,,0,0,0,,...
Dialogue: 0,0:18:06.29,0:18:07.96,Default,,0,0,0,,Харада-кун да ашулы.
Dialogue: 0,0:18:08.04,0:18:10.96,Default,,0,0,0,,...
Dialogue: 0,0:18:11.04,0:18:14.59,Default,,0,0,0,,...
Dialogue: 0,0:18:14.67,0:18:17.34,Default,,0,0,0,,...
Dialogue: 0,0:18:17.42,0:18:19.97,Default,,0,0,0,,“”
Dialogue: 0,0:18:20.05,0:18:22.55,Default,,0,0,0,,Біріншіден, бейсбол клубының пайда болғанына біраз болды.
Dialogue: 0,0:18:22.64,0:18:25.47,Default,,0,0,0,,Мен үйірме жұмыстарынан үзіліс алғым келеді.
Dialogue: 0,0:18:25.56,0:18:26.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:28.31,0:18:31.86,Default,,0,0,0,,...
Dialogue: 0,0:18:31.94,0:18:34.57,Default,,0,0,0,,Бұл бейсбол клубының ішкі мәселесі.
Dialogue: 0,0:18:34.65,0:18:36.86,Default,,0,0,0,,Клуб қызметін тоқтатудан басқа амал жоқ.
Dialogue: 0,0:18:36.94,0:18:40.36,Default,,0,0,0,,Ол қанша уақытқа дейін тоқтатылады? Жақында турнир болады.
Dialogue: 0,0:18:40.45,0:18:42.70,Default,,0,0,0,,Турнир?
Dialogue: 0,0:18:42.78,0:18:45.74,Default,,0,0,0,,...
Dialogue: 0,0:18:45.83,0:18:47.45,Default,,0,0,0,,Жақсы болуы мүмкін
Dialogue: 0,0:18:47.54,0:18:49.50,Default,,0,0,0,,Ары қарай не болатыны ағып кетсе
Dialogue: 0,0:18:50.08,0:18:53.09,Default,,0,0,0,,Турнирге байсалды жүзбен қатысып жатқаныңызды білсем ше?
Dialogue: 0,0:18:53.17,0:18:55.75,Default,,0,0,0,,Мен олардың не айтарын білмеймін
Dialogue: 0,0:18:55.84,0:18:58.05,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:18:58.13,0:19:01.39,Default,,0,0,0,,Міне... Біз префектуралық турнирді мақсат етіп отырмыз...
Dialogue: 0,0:19:01.47,0:19:05.14,Default,,0,0,0,,Кайондзи-кун, мен сенің ауырғаныңды түсінемін.
Dialogue: 0,0:19:05.22,0:19:07.81,Default,,0,0,0,,Бірақ мен бұл жолы жауапкершілікті өз мойныма алуым керек.
Dialogue: 0,0:19:07.89,0:19:10.81,Default,,0,0,0,,Сондай-ақ ауыртпалықты бүкіл бөлім көтеру қажет болуы мүмкін.
Dialogue: 0,0:19:10.89,0:19:11.94,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:19:18.61,0:19:20.28,Default,,0,0,0,,- (Такуми) Кайонджи-сан - (Каионджи) Иә?
Dialogue: 0,0:19:21.28,0:19:23.41,Default,,0,0,0,,Үйірме жұмыстарын орындайық
Dialogue: 0,0:19:23.49,0:19:25.28,Default,,0,0,0,,Әзірге тоқтатылды
Dialogue: 0,0:19:25.37,0:19:27.79,Default,,0,0,0,,Егер біз жақсы жұмыс жасамасақ, клуб жойылуы мүмкін.
Dialogue: 0,0:19:27.87,0:19:29.37,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:29.45,0:19:32.37,Default,,0,0,0,,...
Dialogue: 0,0:19:32.88,0:19:35.04,Default,,0,0,0,,Егер ол жоғалып кетсе, проблема болмайды.
Dialogue: 0,0:19:35.13,0:19:37.80,Default,,0,0,0,,Үйірме жұмыстарын жүргізу мүмкін болмаса, маған құрал-жабдықтарыңызды қарызға беріңіз.
Dialogue: 0,0:19:39.09,0:19:40.05,Default,,0,0,0,,Харада…
Dialogue: 0,0:19:40.13,0:19:42.93,Default,,0,0,0,,Мен бейсбол ойнағым келеді
Dialogue: 0,0:19:43.01,0:19:45.14,Default,,0,0,0,,Мені басқа ештеңе қызықтырмайды.
Dialogue: 0,0:19:46.14,0:19:47.43,Default,,0,0,0,,Мен бейсбол ойнаймын
Dialogue: 0,0:19:47.51,0:19:49.43,Default,,0,0,0,,Мектептер бұған жол бермейді.
Dialogue: 0,0:19:50.06,0:19:53.44,Default,,0,0,0,,Бейсболды біреудің рұқсатынсыз ойнай аласыз.
Dialogue: 0,0:19:54.23,0:19:55.19,Default,,0,0,0,,Такуми…
Dialogue: 0,0:19:58.23,0:20:00.82,Default,,0,0,0,,Жабдық бөлмесінің кілтін тапсыру.
Dialogue: 0,0:20:02.24,0:20:04.57,Default,,0,0,0,,Кайонжи мырза, солай емес пе?
Dialogue: 0,0:20:04.66,0:20:07.78,Default,,0,0,0,,Харада... Мен келесі жылы емтихан тапсырамын.
Dialogue: 0,0:20:07.87,0:20:10.70,Default,,0,0,0,,Шынымды айтсам, мен мектепке қарсы шыққым келмейді. Кешіріңіз.
Dialogue: 0,0:20:16.21,0:20:17.75,Default,,0,0,0,,Сіз мұны шынымен жасайсыз ба?
Dialogue: 0,0:20:17.84,0:20:18.71,Default,,0,0,0,,Орындаңыз
Dialogue: 0,0:20:18.80,0:20:20.80,Default,,0,0,0,,Ал, сабақтан кейін.
Dialogue: 0,0:20:20.88,0:20:22.59,Default,,0,0,0,,Иә, мектептен кейін.
Dialogue: 0,0:20:32.56,0:20:33.98,Default,,0,0,0,,Каионжи мырза...
Dialogue: 0,0:20:37.44,0:20:40.86,Default,,0,0,0,,Күткендей, оған қараудың өзі ауырады.
Dialogue: 0,0:20:40.94,0:20:44.24,Default,,0,0,0,,Бүгін шықтым, бірақ ертеңгі күнді білмеймін.
Dialogue: 0,0:20:44.32,0:20:47.91,Default,,0,0,0,,Енді әдеттегідей жүгіру және калистеника.
Dialogue: 0,0:20:47.99,0:20:50.24,Default,,0,0,0,,Содан кейін бірден позицияларды жаттықтыруды бастаңыз.
Dialogue: 0,0:20:50.33,0:20:51.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:56.12,0:20:57.25,Default,,0,0,0,,Харада
Dialogue: 0,0:20:57.33,0:20:58.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:58.29,0:21:00.42,Default,,0,0,0,,Келесі жолы менімен біржола күресіңіз.
Dialogue: 0,0:21:00.50,0:21:02.42,Default,,0,0,0,,Жарыс? Шынайы ма?
Dialogue: 0,0:21:02.51,0:21:03.92,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:21:04.01,0:21:07.05,Default,,0,0,0,,Етке келгенде ешкімді жеңе алмаймын.
Dialogue: 0,0:21:07.64,0:21:09.51,Default,,0,0,0,,Бейсбол командасының мүшелері алаңда
Dialogue: 0,0:21:09.60,0:21:11.47,Default,,0,0,0,,Бүгін клубтың қызметі тоқтатылды.
Dialogue: 0,0:21:11.56,0:21:15.48,Default,,0,0,0,,Қазір жаттығуды тоқтатып, үйге қайт.
Dialogue: 0,0:21:15.56,0:21:17.15,Default,,0,0,0,,Бейсбол командасының мүшелері алаңда...
Dialogue: 0,0:21:17.23,0:21:18.23,Default,,0,0,0,,Такуми
Dialogue: 0,0:21:18.31,0:21:19.73,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:21:26.03,0:21:31.03,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.28,0:22:55.95,Default,,0,0,0,,～♪
