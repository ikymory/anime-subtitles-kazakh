Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.96,0:00:10.55,Default,,0,0,0,,Иә, мен оны таптым деп ойлаймын.
Dialogue: 0,0:00:10.63,0:00:12.47,Default,,0,0,0,,Бұл құмыра соғуы мүмкін.
Dialogue: 0,0:00:12.55,0:00:13.97,Default,,0,0,0,,Сіз оны ұра аласыз ба?
Dialogue: 0,0:00:14.05,0:00:14.88,Default,,0,0,0,,Соға алады
Dialogue: 0,0:00:14.97,0:00:16.89,Default,,0,0,0,,Ол жігіттер әлі балалар.
Dialogue: 0,0:00:19.85,0:00:21.85,Default,,0,0,0,,Сіз риза емес сияқтысыз, капитан.
Dialogue: 0,0:00:21.93,0:00:24.77,Default,,0,0,0,,Харадаға Соннаны ұру оңай ма? Шун
Dialogue: 0,0:00:24.85,0:00:26.27,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:00:26.35,0:00:29.65,Default,,0,0,0,,Мен сенің сұлу ханшайымыңды жеймін.
Dialogue: 0,0:00:29.73,0:00:30.69,Default,,0,0,0,,Не?
Dialogue: 0,0:00:30.78,0:00:34.49,Default,,0,0,0,,Мен сенің келесі бұрылысыңды күтетін шығармын, Химе-сан.
Dialogue: 0,0:00:34.57,0:00:36.99,Default,,0,0,0,,Аңқау болма!
Dialogue: 0,0:00:37.07,0:00:42.08,Default,,0,0,0,,♪～
Dialogue: 0,0:02:01.53,0:02:06.54,Default,,0,0,0,,～♪
Dialogue: 0,0:02:08.25,0:02:09.96,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:02:13.59,0:02:15.09,Default,,0,0,0,,Сол жерде соқсаң, жаман.
Dialogue: 0,0:02:15.17,0:02:16.01,Default,,0,0,0,,Үш жақты өзгерту
Dialogue: 0,0:02:16.09,0:02:17.34,Default,,0,0,0,,Барлығын есте сақтаңыз
Dialogue: 0,0:02:17.42,0:02:18.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:19.30,0:02:20.39,Default,,0,0,0,,Шуго
Dialogue: 0,0:02:20.47,0:02:24.10,Default,,0,0,0,,Кешіріңіз, ханшайым, келесі бөлімге дейін.
Dialogue: 0,0:02:24.18,0:02:25.27,Default,,0,0,0,,Мороиячча
Dialogue: 0,0:02:27.85,0:02:30.40,Default,,0,0,0,,Неге екенін білесіз.
Dialogue: 0,0:02:31.31,0:02:33.27,Default,,0,0,0,,Неге түсінбейсің, ақымақ?
Dialogue: 0,0:02:34.11,0:02:35.69,Default,,0,0,0,,Қысқасы, сіз
Dialogue: 0,0:02:35.78,0:02:38.82,Default,,0,0,0,,Менің бар ойым ханшайыммен кездесуге бару.
Dialogue: 0,0:02:38.90,0:02:41.28,Default,,0,0,0,,Сонда сіз ештеңе түсінбейсіз бе?
Dialogue: 0,0:02:41.36,0:02:42.91,Default,,0,0,0,,Нитта Хигаши дегеніміз не?
Dialogue: 0,0:02:42.99,0:02:44.74,Default,,0,0,0,,Эй, Бор командасы бар ма?
Dialogue: 0,0:02:44.83,0:02:45.66,Default,,0,0,0,,Байсалды жүзбен
Dialogue: 0,0:02:45.74,0:02:48.00,Default,,0,0,0,,Мұндай негізгі сұрақтарды қоймаңыз.
Dialogue: 0,0:02:48.75,0:02:50.83,Default,,0,0,0,,Нитта жаман емес.
Dialogue: 0,0:02:52.88,0:02:55.80,Default,,0,0,0,,Не істеуге болмайды, бұл батарея.
Dialogue: 0,0:02:55.88,0:02:59.05,Default,,0,0,0,,Ханшайым мен үлкен аулаушы
Dialogue: 0,0:02:59.13,0:03:00.88,Default,,0,0,0,,Бұл ең нашар болар еді
Dialogue: 0,0:03:10.81,0:03:13.48,Default,,0,0,0,,Джоно Жылдамдыққа алданып қалмаңыз.
Dialogue: 0,0:03:13.56,0:03:14.86,Default,,0,0,0,,оны әйтеуір кесіп тастаңыз
Dialogue: 0,0:03:14.94,0:03:16.65,Default,,0,0,0,,Сіз оны баса аласыз.
Dialogue: 0,0:03:16.73,0:03:17.65,Default,,0,0,0,,Иә
Dialogue: 0,0:03:21.57,0:03:23.11,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:03:23.20,0:03:25.49,Default,,0,0,0,,Шун: Ол өзін нашар сезініп тұр ма?
Dialogue: 0,0:03:28.49,0:03:31.66,Default,,0,0,0,,Ойын барысында мен қарсылас құмыра қалай жүр екен деп уайымдадым.
Dialogue: 0,0:03:31.75,0:03:33.00,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:03:33.08,0:03:34.88,Default,,0,0,0,,Жоғарыда айтқанымдай,
Dialogue: 0,0:03:34.96,0:03:38.13,Default,,0,0,0,,Химе-сан мен батареяда не болды?
Dialogue: 0,0:03:38.21,0:03:39.96,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:03:40.05,0:03:41.63,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:03:42.84,0:03:43.89,Default,,0,0,0,,Сізге
Dialogue: 0,0:03:43.97,0:03:44.84,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:03:44.93,0:03:49.39,Default,,0,0,0,,(Йокот ойыншылары қолдайды)
Dialogue: 0,0:03:52.56,0:03:53.39,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:03:54.98,0:03:56.90,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:01.99,0:04:03.66,Default,,0,0,0,,О, Хаги, иә.
Dialogue: 0,0:04:08.24,0:04:09.54,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:10.50,0:04:13.67,Default,,0,0,0,,Дәл қазір оның басы шатасуда.
Dialogue: 0,0:04:13.75,0:04:17.09,Default,,0,0,0,,Мен не лақтырарымды білмеймін.
Dialogue: 0,0:04:17.17,0:04:19.17,Default,,0,0,0,,Үйге жүгіру соққысы әлі де болған жоқ
Dialogue: 0,0:04:19.25,0:04:22.17,Default,,0,0,0,,Менің соққы сызығым тек хит жасау үшін барын салуда.
Dialogue: 0,0:04:22.26,0:04:24.09,Default,,0,0,0,,Ұлы ханшайым
Dialogue: 0,0:04:24.18,0:04:26.55,Default,,0,0,0,,Неліктен бұл ханшайымды ұрды?
Dialogue: 0,0:04:26.64,0:04:28.18,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:04:31.64,0:04:34.77,Default,,0,0,0,,Сіз бөтелке немесе ханшайым емессіз.
Dialogue: 0,0:04:34.85,0:04:37.06,Default,,0,0,0,,Өкінішке орай, ханшайым құмыра екен.
Dialogue: 0,0:04:37.15,0:04:39.52,Default,,0,0,0,,Допты қағып алатын адам жоқ.
Dialogue: 0,0:04:39.61,0:04:42.07,Default,,0,0,0,,Бұл құмыра бұл туралы ештеңе істей алмайды.
Dialogue: 0,0:04:42.15,0:04:43.99,Default,,0,0,0,,Шун, маған дұрыстап айтшы.
Dialogue: 0,0:04:44.07,0:04:46.32,Default,,0,0,0,,- (Кадоваки) Неге... - (Мизугаки) Ойынға назар аударыңыз!
Dialogue: 0,0:04:47.16,0:04:48.28,Default,,0,0,0,,Төрт шар
Dialogue: 0,0:04:50.41,0:04:51.33,Default,,0,0,0,,Я...
Dialogue: 0,0:04:51.41,0:04:55.25,Default,,0,0,0,,Қараңдар, Икебе жүрді, төрт доп.
Dialogue: 0,0:04:55.33,0:04:57.83,Default,,0,0,0,,Осындай керемет бақылауға ие болған адам
Dialogue: 0,0:04:57.92,0:05:00.34,Default,,0,0,0,,Соққы Бірде-бір доп кірмейді.
Dialogue: 0,0:05:00.42,0:05:03.21,Default,,0,0,0,,Ханшайым, айықпас дертіңіз бар ма?
Dialogue: 0,0:05:07.05,0:05:08.85,Default,,0,0,0,,Батареяны толығымен ауыстыруым керек пе?
Dialogue: 0,0:05:09.64,0:05:12.14,Default,,0,0,0,,Шуго, Кайондзи сенен жақсырақ.
Dialogue: 0,0:05:12.22,0:05:14.35,Default,,0,0,0,,Мен капитан ретінде өте сабырлы боламын.
Dialogue: 0,0:05:21.94,0:05:25.24,Default,,0,0,0,,Сіз өте ауыр науқас сияқтысыз.
Dialogue: 0,0:05:25.32,0:05:26.61,Default,,0,0,0,,Ондай жігітке
Dialogue: 0,0:05:26.70,0:05:28.87,Default,,0,0,0,,Мен сенімен бірінші рет кездесіп тұрмын.
Dialogue: 0,0:05:29.87,0:05:31.87,Default,,0,0,0,,Бірақ бұл соңы болуы мүмкін.
Dialogue: 0,0:05:31.95,0:05:33.66,Default,,0,0,0,,Кішкентай ханшайым
Dialogue: 0,0:05:33.75,0:05:36.37,Default,,0,0,0,,Әзірше қорғанға тұрудан қорықпа.
Dialogue: 0,0:05:36.46,0:05:37.62,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:05:37.71,0:05:39.92,Default,,0,0,0,,100% сенімді
Dialogue: 0,0:05:40.00,0:05:43.25,Default,,0,0,0,,Бұл ақымақтың түрі нәзік.
Dialogue: 0,0:05:44.38,0:05:45.84,Default,,0,0,0,,Үш жақты өзгерту
Dialogue: 0,0:05:46.80,0:05:48.47,Default,,0,0,0,,Мм... бұл өзгеріс.
Dialogue: 0,0:05:48.55,0:05:49.76,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:49.84,0:05:52.39,Default,,0,0,0,,Сакияма мырза қысқа допты орындамады ма?
Dialogue: 0,0:05:52.47,0:05:54.14,Default,,0,0,0,,Бұл қос қойылым.
Dialogue: 0,0:05:54.22,0:05:57.23,Default,,0,0,0,,Ача, не істеуіміз керек?
Dialogue: 0,0:05:57.31,0:06:00.36,Default,,0,0,0,,Келесі иннинг, соққы реті келеді, Шуго.
Dialogue: 0,0:06:00.44,0:06:01.36,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:06:01.44,0:06:05.57,Default,,0,0,0,,Ханшайым шығып кетті. Сіздің мотивацияңыз екі есе азайған жоқ па?
Dialogue: 0,0:06:05.65,0:06:09.16,Default,,0,0,0,,Мені шымшып ұрып-соғуға рұқсат бергені үшін олар күңіренетініне сенімдімін.
Dialogue: 0,0:06:09.24,0:06:10.66,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:06:16.33,0:06:17.16,Default,,0,0,0,,Алу…
Dialogue: 0,0:06:17.25,0:06:19.17,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:06:19.25,0:06:21.42,Default,,0,0,0,,Яббе, мен Шугоны білдім
Dialogue: 0,0:06:23.00,0:06:24.42,Default,,0,0,0,,Не...
Dialogue: 0,0:06:24.50,0:06:26.55,Default,,0,0,0,,Бұл ойын, жаттықтырушы~
Dialogue: 0,0:06:26.63,0:06:28.01,Default,,0,0,0,,Ойын қандай?
Dialogue: 0,0:06:28.09,0:06:29.97,Default,,0,0,0,,Мектептің рұқсатынсыз
Dialogue: 0,0:06:30.05,0:06:32.80,Default,,0,0,0,,Сіз матчты рұқсатсыз ойнай аламын деп ойлайсыз ба?
Dialogue: 0,0:06:32.89,0:06:35.26,Default,,0,0,0,,Бүгін жексенбі, директор.
Dialogue: 0,0:06:35.35,0:06:37.06,Default,,0,0,0,,Жеке бос уақыт
Dialogue: 0,0:06:37.14,0:06:39.02,Default,,0,0,0,,Йокоте формасын кию
Dialogue: 0,0:06:39.10,0:06:41.48,Default,,0,0,0,,Жеке уақыт немесе ақымақ деген не?
Dialogue: 0,0:06:41.56,0:06:42.40,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:42.48,0:06:43.31,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:43.90,0:06:45.32,Default,,0,0,0,,Менің атым Томура.
Dialogue: 0,0:06:45.40,0:06:48.36,Default,,0,0,0,,Мен Хигаши Ниттаның директорымын.
Dialogue: 0,0:06:52.41,0:06:53.91,Default,,0,0,0,,Жалғастыру мүмкін емес пе?
Dialogue: 0,0:06:53.99,0:06:56.33,Default,,0,0,0,,Бұл мүмкін емес, ұтылған матч.
Dialogue: 0,0:06:56.41,0:06:59.83,Default,,0,0,0,,Директорым мені қатты мазалайды...
Dialogue: 0,0:06:59.91,0:07:03.21,Default,,0,0,0,,Біз матчты алғанымызға қарамастан, бұл көңілсіз.
Dialogue: 0,0:07:03.29,0:07:05.34,Default,,0,0,0,,Кешіріңіз, мен директордан сұраймын.
Dialogue: 0,0:07:05.42,0:07:08.21,Default,,0,0,0,,Бұл ысырап, бәрі қорқады.
Dialogue: 0,0:07:08.30,0:07:10.13,Default,,0,0,0,,Бүгінгі күннің бәрі осы.
Dialogue: 0,0:07:10.22,0:07:12.84,Default,,0,0,0,,Жоқ, саған қиындық туғызған менмін.
Dialogue: 0,0:07:12.93,0:07:15.26,Default,,0,0,0,,-(Мизугаки)...Сонымен ары қарай не істейміз?-(Кайонжи) Иә?
Dialogue: 0,0:07:15.35,0:07:18.56,Default,,0,0,0,,Менің Кадоваки-куным көңілсіз.
Dialogue: 0,0:07:18.64,0:07:22.27,Default,,0,0,0,,Менің қымбатты ханшайымым күнде түнде түсімде көрінеді, сондықтан мен ұйықтамаймын.
Dialogue: 0,0:07:22.35,0:07:24.11,Default,,0,0,0,,- (Мизугаки) Сүйкімді емес пе? -(Кайондзи) А?
Dialogue: 0,0:07:24.19,0:07:25.36,Default,,0,0,0,,Сізден аулақ болыңыз!
Dialogue: 0,0:07:25.44,0:07:29.11,Default,,0,0,0,,Кайондзи, сен көңілсіз бірдеңе айттың.
Dialogue: 0,0:07:29.19,0:07:31.32,Default,,0,0,0,,Менің үйіммен қайталап көрейік.
Dialogue: 0,0:07:31.40,0:07:32.78,Default,,0,0,0,,Не? Бірақ...
Dialogue: 0,0:07:32.86,0:07:34.12,Default,,0,0,0,,Бұл қызықты болды
Dialogue: 0,0:07:34.20,0:07:38.45,Default,,0,0,0,,Мектепке қатысты. Қарсыластарын өздері таңдап, ойнайды.
Dialogue: 0,0:07:38.54,0:07:40.12,Default,,0,0,0,,Бұл өте қызықты болды.
Dialogue: 0,0:07:40.20,0:07:41.71,Default,,0,0,0,,Әрине жоқ.
Dialogue: 0,0:07:41.79,0:07:43.00,Default,,0,0,0,,Жасайық
Dialogue: 0,0:07:43.08,0:07:46.42,Default,,0,0,0,,Асықпаңыз, емтихан біткенше күтіңіз.
Dialogue: 0,0:07:47.71,0:07:50.38,Default,,0,0,0,,Жарайды, бәрі бақытты болады деп ойлаймын.
Dialogue: 0,0:07:50.47,0:07:51.34,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:07:50.47,0:07:51.34,Default,,0,0,0,,Енді ештеңені жоғалтпау үшін
Dialogue: 0,0:07:51.34,0:07:52.13,Default,,0,0,0,,Енді ештеңені жоғалтпау үшін
Dialogue: 0,0:07:52.22,0:07:54.72,Default,,0,0,0,,Бір шарт бар.
Dialogue: 0,0:07:54.80,0:07:55.64,Default,,0,0,0,,Жағдайлар?
Dialogue: 0,0:07:55.72,0:07:59.39,Default,,0,0,0,,Бұл ойында міндетті түрде қорғанда Химе-сан болуы керек.
Dialogue: 0,0:08:00.73,0:08:02.39,Default,,0,0,0,,Сіз Харада туралы айтып отырсыз ба?
Dialogue: 0,0:08:02.48,0:08:05.98,Default,,0,0,0,,Кайонджи, сен көзіңді жұмып аласың ба?
Dialogue: 0,0:08:06.06,0:08:06.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.02,0:08:08.27,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:08:08.36,0:08:09.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:11.36,0:08:14.28,Default,,0,0,0,,Мен неге жеңілдім...
Dialogue: 0,0:08:17.37,0:08:19.79,Default,,0,0,0,,Ах, Кадоваки-сан...
Dialogue: 0,0:08:26.29,0:08:27.29,Default,,0,0,0,,Харада
Dialogue: 0,0:08:28.54,0:08:29.46,Default,,0,0,0,,Иә
Dialogue: 0,0:08:31.46,0:08:33.51,Default,,0,0,0,,«иә» болмаса да
Dialogue: 0,0:08:35.64,0:08:37.43,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:08:37.51,0:08:39.18,Default,,0,0,0,,Бұл соншалықты үлкен.
Dialogue: 0,0:08:39.76,0:08:41.68,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:42.35,0:08:44.69,Default,,0,0,0,,Мені қорғаннан сүйреп түсірді
Dialogue: 0,0:08:44.77,0:08:46.10,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:08:46.19,0:08:47.44,Default,,0,0,0,,Кадоваки мырза
Dialogue: 0,0:08:47.52,0:08:50.32,Default,,0,0,0,,Біздің мүшелерге ақылға сыймайтын ештеңе айтпаңыз.
Dialogue: 0,0:08:52.19,0:08:54.45,Default,,0,0,0,,Мен біреуді бір атпен ұрып тастадым.
Dialogue: 0,0:08:54.53,0:08:56.36,Default,,0,0,0,,Сонда сіз жеңдім деп ойлайсыз ба?
Dialogue: 0,0:08:57.03,0:08:59.95,Default,,0,0,0,,Мен қанша орынсыз істер жасадым?
Dialogue: 0,0:09:00.03,0:09:01.20,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:09:01.87,0:09:03.20,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:09:03.91,0:09:06.21,Default,,0,0,0,,Нагакура деп айттыңыз ба?
Dialogue: 0,0:09:06.29,0:09:08.71,Default,,0,0,0,,I Чуно Мидзугаки
Dialogue: 0,0:09:08.79,0:09:11.21,Default,,0,0,0,,Химе-санмен қашан кездесіп жүрсің?
Dialogue: 0,0:09:12.34,0:09:14.84,Default,,0,0,0,,Осы көктемнен бастап наурыз...
Dialogue: 0,0:09:14.92,0:09:17.01,Default,,0,0,0,,Сонда әлі жарты жыл бар ма?
Dialogue: 0,0:09:17.09,0:09:20.51,Default,,0,0,0,,Сонда мен тіл табысуға қатысты кеңестерді білмеймін.
Dialogue: 0,0:09:20.60,0:09:23.85,Default,,0,0,0,,Мизугаки-сан, сен ол кезде жарғанат айтқан жоқсың ба?
Dialogue: 0,0:09:23.93,0:09:25.85,Default,,0,0,0,,Не? Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:09:27.94,0:09:29.86,Default,,0,0,0,,Сіз ұстаушы бола алмайсыз.
Dialogue: 0,0:09:29.94,0:09:31.86,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:31.94,0:09:33.48,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:09:33.57,0:09:36.07,Default,,0,0,0,,Сіз ханшайымның ұстаушысы бола алмайсыз.
Dialogue: 0,0:09:36.65,0:09:38.78,Default,,0,0,0,,Сіз жай ғана азапсыз.
Dialogue: 0,0:09:39.45,0:09:41.20,Default,,0,0,0,,Ханшайымдар сияқты түрлерге арналған
Dialogue: 0,0:09:41.28,0:09:43.87,Default,,0,0,0,,Мен дұрыс заттарды біріктіруім керек.
Dialogue: 0,0:09:44.58,0:09:47.87,Default,,0,0,0,,Мен де сіздей болып, сізбен тең дәрежеде тіл табысуға тырыссам ғой.
Dialogue: 0,0:09:49.08,0:09:50.88,Default,,0,0,0,,Шүберек шығады
Dialogue: 0,0:09:50.96,0:09:53.00,Default,,0,0,0,,Бұл бүгінгі нәтиже.
Dialogue: 0,0:09:53.09,0:09:56.88,Default,,0,0,0,,Балалар, аккумуляторды жинасаңдар да, бір-біріңді жаншып кетесіңдер.
Dialogue: 0,0:09:57.68,0:09:59.93,Default,,0,0,0,,Ал мен Нагакура кіммін?
Dialogue: 0,0:10:00.01,0:10:03.89,Default,,0,0,0,,Мен көп жылдар бойы данышпан Шуго Кадовакимен бейсбол ойнадым.
Dialogue: 0,0:10:06.98,0:10:09.52,Default,,0,0,0,,Балалар, тезірек үйге қайтайық!
Dialogue: 0,0:10:09.60,0:10:12.27,Default,,0,0,0,,...
Dialogue: 0,0:10:12.36,0:10:15.78,Default,,0,0,0,,Кешіріңіз, Химе-сан, оны қайтадан лақтырып көріңіз.
Dialogue: 0,0:10:16.53,0:10:19.11,Default,,0,0,0,,Егер лақтырудан қорықпасаңыз
Dialogue: 0,0:10:34.59,0:10:35.42,Default,,0,0,0,,Кеттік
Dialogue: 0,0:10:35.50,0:10:36.38,Default,,0,0,0,,Нагакура
Dialogue: 0,0:10:36.46,0:10:37.30,Default,,0,0,0,,Иә
Dialogue: 0,0:10:37.38,0:10:40.22,Default,,0,0,0,,Жүгірме, қал.
Dialogue: 0,0:10:40.30,0:10:41.55,Default,,0,0,0,,Басқалары жүгіруге барады.
Dialogue: 0,0:10:41.64,0:10:42.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:42.64,0:10:43.97,Default,,0,0,0,,Қадағалау?
Dialogue: 0,0:10:43.97,0:10:44.22,Default,,0,0,0,,Қадағалау?
Dialogue: 0,0:10:43.97,0:10:44.22,Default,,0,0,0,,(Нономура мен оның достары айғайлайды)
Dialogue: 0,0:10:44.22,0:10:44.81,Default,,0,0,0,,(Номура мен оның достары айғайлайды)
Dialogue: 0,0:10:44.81,0:10:45.77,Default,,0,0,0,,(Нономура мен оның достары айғайлайды)
Dialogue: 0,0:10:44.81,0:10:45.77,Default,,0,0,0,,Отырыңыз
Dialogue: 0,0:10:45.77,0:10:46.18,Default,,0,0,0,,(Нономура мен оның достары айғайлайды)
Dialogue: 0,0:10:46.27,0:10:48.18,Default,,0,0,0,,Мен үйіндіден лақтырамын
Dialogue: 0,0:10:54.73,0:10:56.44,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:11:01.28,0:11:02.87,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:11:04.24,0:11:05.28,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:11:08.00,0:11:09.46,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:11:10.04,0:11:11.21,Default,,0,0,0,,Иә
Dialogue: 0,0:11:11.29,0:11:13.58,Default,,0,0,0,,Менің ойымша, бұл күшті.
Dialogue: 0,0:11:13.67,0:11:15.38,Default,,0,0,0,,Сіз... қалай салыстырасыз?
Dialogue: 0,0:11:15.46,0:11:16.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:16.38,0:11:19.22,Default,,0,0,0,,Мен оның допымен қалай салыстыратынын сұрадым.
Dialogue: 0,0:11:19.80,0:11:21.09,Default,,0,0,0,,Такуми...
Dialogue: 0,0:11:21.76,0:11:25.22,Default,,0,0,0,,Жақсы, менеджер лақтыратын әдіс - алаңшылардың лақтыру тәсілі.
Dialogue: 0,0:11:25.30,0:11:27.22,Default,,0,0,0,,Такумимен салыстыруды сұрасаң да...
Dialogue: 0,0:11:27.31,0:11:29.39,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:11:29.48,0:11:31.98,Default,,0,0,0,,Ол мияулап жатыр... Дұрыс.
Dialogue: 0,0:11:32.06,0:11:33.52,Default,,0,0,0,,Ол 70% лақтырылсын
Dialogue: 0,0:11:34.40,0:11:37.23,Default,,0,0,0,,Сынақ аяқталғанда, оған айтыңыз.
Dialogue: 0,0:11:37.32,0:11:39.07,Default,,0,0,0,,70% күшпен лақтыру
Dialogue: 0,0:11:39.15,0:11:42.20,Default,,0,0,0,,Қарсыластың соққы сызығынан аулақ болу үшін алаңды қалай ұстау керектігін үйреніңіз.
Dialogue: 0,0:11:42.28,0:11:45.83,Default,,0,0,0,,Төбелессең де, Харада бәрібір ұстаушы болады.
Dialogue: 0,0:11:45.91,0:11:49.83,Default,,0,0,0,,Сен маған Такумиге бәрін тастама деп айтып тұрсың ба?
Dialogue: 0,0:11:49.91,0:11:51.08,Default,,0,0,0,,...
Dialogue: 0,0:11:51.16,0:11:54.83,Default,,0,0,0,,Қанша уақыт өтсе де, төбеде тұра алмайды.
Dialogue: 0,0:11:55.67,0:11:57.88,Default,,0,0,0,,Такуми келіспейді деп ойлаймын.
Dialogue: 0,0:11:57.96,0:11:58.84,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:59.46,0:12:00.42,Default,,0,0,0,,Басқа жақтан күтпеген жерден
Dialogue: 0,0:12:00.51,0:12:03.26,Default,,0,0,0,,Ол сенен төбеде тұруды сұрауы мүмкін.
Dialogue: 0,0:12:03.34,0:12:04.59,Default,,0,0,0,,Сол матчтан бері бір ай өтті
Dialogue: 0,0:12:04.68,0:12:07.30,Default,,0,0,0,,Тым көп питчинг жаттығуларын жасамаңыз.
Dialogue: 0,0:12:07.39,0:12:09.89,Default,,0,0,0,,Тіпті Харада үшін бұл шектеу емес пе?
Dialogue: 0,0:12:09.97,0:12:13.60,Default,,0,0,0,,Ұстаушы бола алмасаң, Хараданы қорғанға апар.
Dialogue: 0,0:12:13.69,0:12:17.61,Default,,0,0,0,,Оның 70%-ы көптеген командалар үшін жеткілікті.
Dialogue: 0,0:12:19.19,0:12:21.32,Default,,0,0,0,,Нагакура, сен тоқтайсың ба?
Dialogue: 0,0:12:21.40,0:12:22.24,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:22.32,0:12:24.36,Default,,0,0,0,,Қазір болса, әлі уақыт бар.
Dialogue: 0,0:12:24.45,0:12:27.62,Default,,0,0,0,,Сен байыпты емессің деп уайымдап, қиналсам да,
Dialogue: 0,0:12:27.70,0:12:29.87,Default,,0,0,0,,Мүмкін Харада маған көмектеспейтін шығар.
Dialogue: 0,0:12:32.12,0:12:33.66,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:12:33.75,0:12:34.62,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:12:34.71,0:12:37.67,Default,,0,0,0,,Директор ештеңе түсінбейді.
Dialogue: 0,0:12:38.71,0:12:39.63,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:41.80,0:12:43.38,Default,,0,0,0,,Кешіріңіз, мен тым көп айттым.
Dialogue: 0,0:12:43.47,0:12:45.43,Default,,0,0,0,,Шығу немесе тоқтату
Dialogue: 0,0:12:45.51,0:12:47.89,Default,,0,0,0,,Бұл сіздің мәселеңіз емес.
Dialogue: 0,0:12:53.89,0:12:55.02,Default,,0,0,0,,Брат телефон
Dialogue: 0,0:12:55.10,0:12:56.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:57.10,0:12:59.32,Default,,0,0,0,,Сіз бос емес адам болуыңыз керек.
Dialogue: 0,0:12:59.40,0:13:00.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:00.69,0:13:01.94,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:13:02.03,0:13:03.57,Default,,0,0,0,,Маған маған харада
Dialogue: 0,0:13:03.65,0:13:04.53,Default,,0,0,0,,Жоқ, бұл тек қана тәжірибе.
Dialogue: 0,0:13:04.61,0:13:07.91,Default,,0,0,0,,Йошисада-кун әдемі және салқын.
Dialogue: 0,0:13:07.99,0:13:09.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:09.37,0:13:12.29,Default,,0,0,0,,Сіз дәл қазір бара жатырсыз. Сонда кездескенше.
Dialogue: 0,0:13:12.37,0:13:13.50,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:13:13.58,0:13:14.41,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:13:14.50,0:13:16.83,Default,,0,0,0,,Мазасыз адам келе жатыр.
Dialogue: 0,0:13:16.92,0:13:18.42,Default,,0,0,0,,Го Чан келе ме?
Dialogue: 0,0:13:18.50,0:13:19.59,Default,,0,0,0,,Ол келмейді.
Dialogue: 0,0:13:19.67,0:13:22.38,Default,,0,0,0,,Хм, Го-чан келгенде мен өзімді жалғыз сезінемін.
Dialogue: 0,0:13:22.46,0:13:23.55,Default,,0,0,0,,Қараңыз, міне осы ғой?
Dialogue: 0,0:13:23.63,0:13:26.55,Default,,0,0,0,,Бауырым, өзіңді жалғыз сезінбейсің бе?
Dialogue: 0,0:13:29.55,0:13:32.72,Default,,0,0,0,,Бүгін бізде маңызды хабарландыру бар.
Dialogue: 0,0:13:34.77,0:13:36.60,Default,,0,0,0,,Олай болса, қысқаша айтып беріңізші.
Dialogue: 0,0:13:36.69,0:13:38.31,Default,,0,0,0,,Төсекте жатпа
Dialogue: 0,0:13:38.90,0:13:41.98,Default,,0,0,0,,Капитан менен аулаушы ойнағым келе ме деп сұрады.
Dialogue: 0,0:13:42.07,0:13:43.48,Default,,0,0,0,,Не!
Dialogue: 0,0:13:44.32,0:13:47.11,Default,,0,0,0,,Сонда Йошисада не деп жауап берді?
Dialogue: 0,0:13:47.20,0:13:49.16,Default,,0,0,0,,Мен оны ұнатпаймын дедім.
Dialogue: 0,0:13:49.24,0:13:50.74,Default,,0,0,0,,Бейсбол ойыны тұрғысынан.
Dialogue: 0,0:13:50.83,0:13:53.37,Default,,0,0,0,,Менің жалғыз екенімді білесің.
Dialogue: 0,0:13:53.45,0:13:56.29,Default,,0,0,0,,Мен білмеймін, тек Австралия бар.
Dialogue: 0,0:13:56.37,0:13:58.12,Default,,0,0,0,,Құрақ неге осылай шығады?
Dialogue: 0,0:13:58.21,0:14:01.34,Default,,0,0,0,,Мен Хараданың қарсыласымын.
Dialogue: 0,0:14:01.42,0:14:03.30,Default,,0,0,0,,Біріншіден, аулаушы болу қызықсыз.
Dialogue: 0,0:14:03.38,0:14:05.51,Default,,0,0,0,,Мен отырумен және тұрумен айналысамын.
Dialogue: 0,0:14:05.59,0:14:07.84,Default,,0,0,0,,Сұлу жүзімді маскамен жасырма
Dialogue: 0,0:14:07.93,0:14:09.13,Default,,0,0,0,,Қандай ысырап.
Dialogue: 0,0:14:09.22,0:14:12.64,Default,,0,0,0,,Сіз капитан Нономураға айттыңыз ба?
Dialogue: 0,0:14:12.72,0:14:15.60,Default,,0,0,0,,Мен капитан мен директордан үзілді-кесілді бас тарттым.
Dialogue: 0,0:14:15.68,0:14:17.85,Default,,0,0,0,,Отомрайға ақымақ сөздер айтып тұрсың ба?
Dialogue: 0,0:14:17.85,0:14:19.40,Default,,0,0,0,,Отомрайға ақымақ сөздер айтып тұрсың ба?
Dialogue: 0,0:14:17.85,0:14:19.40,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:14:19.40,0:14:19.48,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:14:19.48,0:14:21.02,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:14:19.48,0:14:21.02,Default,,0,0,0,,Бір жағынан бұл таңқаларлық.
Dialogue: 0,0:14:21.11,0:14:22.90,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:14:24.94,0:14:25.90,Default,,0,0,0,,Харада
Dialogue: 0,0:14:26.65,0:14:27.90,Default,,0,0,0,,Австралия
Dialogue: 0,0:14:39.16,0:14:40.08,Default,,0,0,0,,Австралия…
Dialogue: 0,0:14:42.17,0:14:43.25,Default,,0,0,0,,Такуми…
Dialogue: 0,0:14:44.59,0:14:46.26,Default,,0,0,0,,Йошисада оны ұстай ма?
Dialogue: 0,0:14:51.76,0:14:56.47,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:14:58.27,0:14:59.56,Default,,0,0,0,,- (Савагучи) Идиот - (Такуми) Итте
Dialogue: 0,0:15:00.14,0:15:01.98,Default,,0,0,0,,Неге ештеңе айтпайсың?
Dialogue: 0,0:15:02.06,0:15:04.06,Default,,0,0,0,,Сіз жапон тілінде сөйлейсіз бе?
Dialogue: 0,0:15:04.15,0:15:07.94,Default,,0,0,0,,Екеуміз бейсбол ойнайық, ақымақ.
Dialogue: 0,0:15:12.78,0:15:14.95,Default,,0,0,0,,Жарайды... Маған бәрібір.
Dialogue: 0,0:15:15.03,0:15:18.04,Default,,0,0,0,,Ол матчта жеңді деп айта алатын жалғыз адам - ​​ханшайым.
Dialogue: 0,0:15:18.12,0:15:18.95,Default,,0,0,0,,Харада?
Dialogue: 0,0:15:19.04,0:15:22.25,Default,,0,0,0,,Иә, Химе-сан Кадовакиді жеңді.
Dialogue: 0,0:15:22.33,0:15:24.13,Default,,0,0,0,,Менің ойымша, бұл үлкен мәселе.
Dialogue: 0,0:15:24.21,0:15:26.96,Default,,0,0,0,,Қалғанын алып тастасаңыз да, өзгеріс келеді.
Dialogue: 0,0:15:27.05,0:15:28.46,Default,,0,0,0,,- (Кайондзи) Мидзугаки - (Мидзугаки) Иә?
Dialogue: 0,0:15:28.55,0:15:30.97,Default,,0,0,0,,Нагакураға бірдеңе дедіңіз бе?
Dialogue: 0,0:15:31.05,0:15:34.85,Default,,0,0,0,,Не? Жаттығуға баруға алаңдайсыз ба?
Dialogue: 0,0:15:34.93,0:15:37.35,Default,,0,0,0,,Жаттығудан үзіліс жасай алмайтын сияқтымын.
Dialogue: 0,0:15:37.43,0:15:39.56,Default,,0,0,0,,Хараданың добы Оны ұстағысы келмейтін сияқты...
Dialogue: 0,0:15:39.64,0:15:41.27,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:15:41.35,0:15:44.77,Default,,0,0,0,,Қалай болғанда да, Ханшайым әлі де қорғандардан қорқады.
Dialogue: 0,0:15:44.86,0:15:46.94,Default,,0,0,0,,Харада бұлай емес.
Dialogue: 0,0:15:47.02,0:15:50.49,Default,,0,0,0,,Бірақ Нагакура мені ұстап алмайынша мен сенімен сөйлеспеймін.
Dialogue: 0,0:15:50.57,0:15:53.99,Default,,0,0,0,,Не? Ханшайым, сен допты ұстап тұрсың ба?
Dialogue: 0,0:15:54.07,0:15:57.20,Default,,0,0,0,,Енді мен Нагакура туралы айтайын.
Dialogue: 0,0:15:57.28,0:16:00.20,Default,,0,0,0,,Неліктен әңгімені Харадаға әкелдің?
Dialogue: 0,0:16:02.29,0:16:03.46,Default,,0,0,0,,Кадоваки Гана
Dialogue: 0,0:16:04.21,0:16:05.67,Default,,0,0,0,,Матч басталмас бұрын
Dialogue: 0,0:16:05.75,0:16:08.25,Default,,0,0,0,,Ол қатты қобалжығандай көрінді.
Dialogue: 0,0:16:08.34,0:16:10.67,Default,,0,0,0,,Ол байқамайды деп ойлаймын.
Dialogue: 0,0:16:10.76,0:16:13.43,Default,,0,0,0,,Мен соғып кете алмайтын шығармын деп іштей күбірледім.
Dialogue: 0,0:16:13.51,0:16:14.76,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:16:15.55,0:16:18.01,Default,,0,0,0,,Кадовакиді осы уақытқа дейін итеретін адам бар ма?
Dialogue: 0,0:16:18.10,0:16:19.52,Default,,0,0,0,,Қызық
Dialogue: 0,0:16:20.35,0:16:22.02,Default,,0,0,0,,...ал екінші тараптың ханшайымы
Dialogue: 0,0:16:22.10,0:16:25.35,Default,,0,0,0,,Неге кәдімгі бетті киіп, үйінді тегістемейсің?
Dialogue: 0,0:16:25.44,0:16:28.32,Default,,0,0,0,,Ойын матч басталмай тұрып-ақ шешілді.
Dialogue: 0,0:16:28.40,0:16:31.28,Default,,0,0,0,,Жарыссақ та, нәтиже бірдей болады.
Dialogue: 0,0:16:31.36,0:16:35.11,Default,,0,0,0,,Ал, сен неге Нагакурамен араласып, батареяны бүлдіріп алдың?
Dialogue: 0,0:16:35.20,0:16:37.28,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:16:37.37,0:16:40.79,Default,,0,0,0,,Нагакура Сіз көп нәрсе жасадыңыз, солай емес пе?
Dialogue: 0,0:16:41.58,0:16:44.42,Default,,0,0,0,,Ал... батареяңызды қалдырыңыз.
Dialogue: 0,0:16:44.50,0:16:46.04,Default,,0,0,0,,Екі рет тексеру
Dialogue: 0,0:16:46.13,0:16:49.55,Default,,0,0,0,,Емтихан аяқталғаннан кейін мүмкіндігінше тезірек
Dialogue: 0,0:16:49.63,0:16:52.17,Default,,0,0,0,,Бейсбол стадионын ересек адамсыз жалға алуға бола ма?
Dialogue: 0,0:16:52.26,0:16:54.38,Default,,0,0,0,,Директормен кеңесіңіз
Dialogue: 0,0:16:54.47,0:16:57.01,Default,,0,0,0,,Әй... сен анау қартқа сене алмайсың ба?
Dialogue: 0,0:16:57.09,0:16:58.55,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:16:58.64,0:17:01.81,Default,,0,0,0,,Мен және осы менеджер, өткен күні ғана ойын.
Dialogue: 0,0:17:01.89,0:17:04.73,Default,,0,0,0,,Менің ашуланғаным сонша, басымдағы қан тамырлары сынып қалды.
Dialogue: 0,0:17:04.81,0:17:06.19,Default,,0,0,0,,Сіз маған қиындық тудырдыңыз.
Dialogue: 0,0:17:06.27,0:17:09.86,Default,,0,0,0,,Кімге? Шуго болса, уайымдаудың қажеті жоқ.
Dialogue: 0,0:17:09.94,0:17:12.19,Default,,0,0,0,,Бұл жігіт артықшылықты сыныптан.
Dialogue: 0,0:17:12.28,0:17:14.03,Default,,0,0,0,,Мизугаки Сіз...
Dialogue: 0,0:17:14.11,0:17:15.11,Default,,0,0,0,,Не?
Dialogue: 0,0:17:15.70,0:17:17.70,Default,,0,0,0,,Сіз Кадовакиді жек көресіз бе?
Dialogue: 0,0:17:17.78,0:17:18.70,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:20.28,0:17:21.20,Default,,0,0,0,,(Мидзугакидің көтерілу дыбысы)
Dialogue: 0,0:17:21.29,0:17:22.95,Default,,0,0,0,,Не деген ақымақтық.
Dialogue: 0,0:17:23.04,0:17:24.96,Default,,0,0,0,,Неге мен...
Dialogue: 0,0:17:25.04,0:17:27.62,Default,,0,0,0,,Әйтеуір өзімді солай сезінемін.
Dialogue: 0,0:17:28.13,0:17:28.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:31.04,0:17:31.96,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:17:35.05,0:17:38.47,Default,,0,0,0,,(Есікті автоматты түрде ашу/жабу дыбысы)
Dialogue: 0,0:17:40.55,0:17:42.85,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:17:42.93,0:17:43.77,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:17:43.85,0:17:46.19,Default,,0,0,0,,Тошика, сен қазір қайдасың?
Dialogue: 0,0:17:46.27,0:17:47.56,Default,,0,0,0,,Сіз қай жерде деп ойлайсыз?
Dialogue: 0,0:17:47.64,0:17:48.48,Default,,0,0,0,,Нитта?
Dialogue: 0,0:17:48.56,0:17:50.86,Default,,0,0,0,,Керемет жауап Сіз қайдан білдіңіз?
Dialogue: 0,0:17:50.94,0:17:52.48,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:17:52.57,0:17:56.74,Default,,0,0,0,,Мен Кайондзимен кездесіп, реванш туралы сөйлестім.
Dialogue: 0,0:17:56.82,0:17:57.95,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:17:58.03,0:17:59.16,Default,,0,0,0,,Әрине
Dialogue: 0,0:17:59.24,0:18:02.08,Default,,0,0,0,,Мен сен сияқты жаман қылықтар жасамаймын.
Dialogue: 0,0:18:02.16,0:18:04.12,Default,,0,0,0,,Мен ең жақсы кезеңді дайындадым
Dialogue: 0,0:18:04.20,0:18:05.66,Default,,0,0,0,,Хо…
Dialogue: 0,0:18:05.75,0:18:08.75,Default,,0,0,0,,Бұл мен сенімен ойнайтын соңғы ойын.
Dialogue: 0,0:18:08.83,0:18:10.75,Default,,0,0,0,,ше? Сен не айтып тұрсың?
Dialogue: 0,0:18:11.96,0:18:13.42,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:18:13.50,0:18:14.51,Default,,0,0,0,,О!
Dialogue: 0,0:18:14.59,0:18:16.92,Default,,0,0,0,,Қалайсың, жалғыз өзі?
Dialogue: 0,0:18:17.01,0:18:19.84,Default,,0,0,0,,Шуго... мұнда неге келдің?
Dialogue: 0,0:18:19.93,0:18:23.26,Default,,0,0,0,,Таңертең үйден жаңа шыққаныңды естігенде, маған тиді.
Dialogue: 0,0:18:28.85,0:18:30.40,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:18:30.48,0:18:32.56,Default,,0,0,0,,Австралия тұтынушысы
Dialogue: 0,0:18:32.65,0:18:33.77,Default,,0,0,0,,Мен үшін?
Dialogue: 0,0:18:33.86,0:18:35.28,Default,,0,0,0,,Иә, Харада-кун.
Dialogue: 0,0:18:35.36,0:18:36.53,Default,,0,0,0,,Такуми?
Dialogue: 0,0:18:36.61,0:18:39.86,Default,,0,0,0,,Аонами-чан мен Савагучи-кун және т.б
Dialogue: 0,0:18:43.16,0:18:45.54,Default,,0,0,0,,Го-чан, мен саған тәтті картоп әкелдім.
Dialogue: 0,0:18:45.62,0:18:46.45,Default,,0,0,0,,Картоп?
Dialogue: 0,0:18:46.54,0:18:48.66,Default,,0,0,0,,Бұл өте күлкілі
Dialogue: 0,0:18:48.75,0:18:52.13,Default,,0,0,0,,...
Dialogue: 0,0:18:52.21,0:18:54.46,Default,,0,0,0,,Мен кіре берісте кезіп жүрдім.
Dialogue: 0,0:18:54.55,0:18:56.05,Default,,0,0,0,,Жүр, мен сенімен бірге кірдім.
Dialogue: 0,0:18:57.17,0:18:59.05,Default,,0,0,0,,Бар, мен сені алып кетуге келдім.
Dialogue: 0,0:18:59.13,0:19:01.59,Default,,0,0,0,,Го-чан, ойнайық, жарай ма?
Dialogue: 0,0:19:01.68,0:19:02.80,Default,,0,0,0,,Ойнату...
Dialogue: 0,0:19:02.89,0:19:04.43,Default,,0,0,0,,Сіз не ойнап жатырсыз?
Dialogue: 0,0:19:04.51,0:19:05.64,Default,,0,0,0,,Бейсбол
Dialogue: 0,0:19:05.72,0:19:06.72,Default,,0,0,0,,Бейсбол?
Dialogue: 0,0:19:06.81,0:19:08.06,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:19:08.14,0:19:09.94,Default,,0,0,0,,Харада сені саябақта күтіп тұр.
Dialogue: 0,0:19:10.02,0:19:12.69,Default,,0,0,0,,...
Dialogue: 0,0:19:12.77,0:19:14.82,Default,,0,0,0,,Мен сені кел деп шақыра алмаймын.
Dialogue: 0,0:19:14.90,0:19:16.53,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:19:17.15,0:19:20.57,Default,,0,0,0,,Харада шынымен ештеңе істей алмайды.
Dialogue: 0,0:19:20.65,0:19:22.61,Default,,0,0,0,,Сіз кімсіз? Ханзада?
Dialogue: 0,0:19:22.70,0:19:25.58,Default,,0,0,0,,Осыншама көп нәрсені істеуге болады ма?
Dialogue: 0,0:19:25.66,0:19:28.91,Default,,0,0,0,,Нагакура Токо, шынымен бармауың керек.
Dialogue: 0,0:19:29.00,0:19:31.92,Default,,0,0,0,,Мен, неге Нагакура Анеге жұлқылап жатыр?
Dialogue: 0,0:19:32.00,0:19:33.08,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:19:34.29,0:19:36.09,Default,,0,0,0,,Эй, сен мені естисің бе?
Dialogue: 0,0:19:36.17,0:19:38.59,Default,,0,0,0,,Сіз керемет адамсыз, солай ма?
Dialogue: 0,0:19:38.67,0:19:40.59,Default,,0,0,0,,Бірақ Нагакура екеуміз доспыз.
Dialogue: 0,0:19:41.97,0:19:43.64,Default,,0,0,0,,Біз дос емеспіз
Dialogue: 0,0:19:43.72,0:19:44.97,Default,,0,0,0,,Харада
Dialogue: 0,0:19:45.05,0:19:47.60,Default,,0,0,0,,Ондай сөздерді айтпа...
Dialogue: 0,0:19:47.68,0:19:49.31,Default,,0,0,0,,Сонымен, Хараданың айтуы бойынша ше?
Dialogue: 0,0:19:49.39,0:19:51.73,Default,,0,0,0,,Нагакураның тек ұстау функциясы бар ма?
Dialogue: 0,0:19:51.81,0:19:54.10,Default,,0,0,0,,Егер ол ырылдаса, лақтырасың ба?
Dialogue: 0,0:19:54.19,0:19:58.11,Default,,0,0,0,,Тіпті ол мені дос санамайды.
Dialogue: 0,0:19:58.19,0:20:01.86,Default,,0,0,0,,Уф... сен сондай жалғызсың...
Dialogue: 0,0:20:04.95,0:20:06.24,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:20:06.33,0:20:07.78,Default,,0,0,0,,Атататта!
Dialogue: 0,0:20:08.45,0:20:09.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:10.83,0:20:12.92,Default,,0,0,0,,Таңғажайып ұстау күші.
Dialogue: 0,0:20:13.00,0:20:16.84,Default,,0,0,0,,Бірақ ханшайым мұндай өрескел істерге бармауы керек.
Dialogue: 0,0:20:16.92,0:20:17.96,Default,,0,0,0,,Мизугаки мырза
Dialogue: 0,0:20:18.05,0:20:18.92,Default,,0,0,0,,Айо
Dialogue: 0,0:20:19.00,0:20:22.13,Default,,0,0,0,,Өтінемін, мені «ханшайым» деп атауды тоқтата аласыз ба?
Dialogue: 0,0:20:22.22,0:20:23.05,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:20:23.13,0:20:25.68,Default,,0,0,0,,Харада: Мен сені мазақ етемін.
Dialogue: 0,0:20:25.76,0:20:26.93,Default,,0,0,0,,Балалар, шегініңдер.
Dialogue: 0,0:20:27.01,0:20:30.56,Default,,0,0,0,,Құдай-ау, мына Куриносуке қандай жігіт?
Dialogue: 0,0:20:30.64,0:20:32.64,Default,,0,0,0,,Үлкендеріңізге құрметті сөздерді қолданыңыз.
Dialogue: 0,0:20:32.73,0:20:35.65,Default,,0,0,0,,Ол басқа мектептен, ол менің үлкен сыныпта емес.
Dialogue: 0,0:20:35.73,0:20:36.94,Default,,0,0,0,,Жай ғана қарт адам
Dialogue: 0,0:20:37.02,0:20:38.52,Default,,0,0,0,,Уау, бұл тітіркендіргіш.
Dialogue: 0,0:20:38.61,0:20:39.52,Default,,0,0,0,,Хехехе
Dialogue: 0,0:20:39.61,0:20:41.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:41.11,0:20:43.28,Default,,0,0,0,,А, жоқ, мұндай жерде болады деп ешқашан ойламадым.
Dialogue: 0,0:20:43.36,0:20:46.91,Default,,0,0,0,,Мен Шунмен ауызша жарыса алатын адам болады деп ойламадым.
Dialogue: 0,0:20:46.99,0:20:48.28,Default,,0,0,0,,I Йошисада
Dialogue: 0,0:20:48.37,0:20:50.45,Default,,0,0,0,,Сіз Куриносукесіз.
Dialogue: 0,0:20:50.54,0:20:52.54,Default,,0,0,0,,Мен Харада отбасына тоқтадым.
Dialogue: 0,0:20:52.62,0:20:54.87,Default,,0,0,0,,Сонда мен осында келіп, саған сабақ беремін деп ойладым.
Dialogue: 0,0:20:54.96,0:20:57.96,Default,,0,0,0,,Әй, мен ханшайымның жүзін көруге келдім.
Dialogue: 0,0:21:01.05,0:21:04.22,Default,,0,0,0,,Нитта Хигашидің батареясы қалай?
Dialogue: 0,0:21:06.39,0:21:07.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:13.73,0:21:15.98,Default,,0,0,0,,Көктемде қайталаңыз.
Dialogue: 0,0:21:16.60,0:21:19.44,Default,,0,0,0,,Сізде сіріңке бар ма?
Dialogue: 0,0:21:19.52,0:21:20.36,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:21:20.44,0:21:22.15,Default,,0,0,0,,Қайтадан жасайық
Dialogue: 0,0:21:22.65,0:21:23.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:26.07,0:21:31.08,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.95,0:22:55.95,Default,,0,0,0,,～♪
