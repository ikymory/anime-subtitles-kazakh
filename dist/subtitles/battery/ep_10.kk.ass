Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.34,0:00:16.51,Default,,0,0,0,,Ммм
Dialogue: 0,0:00:17.43,0:00:19.68,Default,,0,0,0,,Бұл өте жақсы күн болды.
Dialogue: 0,0:00:19.76,0:00:22.73,Default,,0,0,0,,Ойлап қарасам, Савагучи налып жатыр екен.
Dialogue: 0,0:00:22.81,0:00:25.19,Default,,0,0,0,,Мен үшінші курста болғым келмейді.
Dialogue: 0,0:00:25.27,0:00:27.48,Default,,0,0,0,,Мен үйірме жұмыстарынан кеткім келмейді.
Dialogue: 0,0:00:27.56,0:00:29.07,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:00:29.73,0:00:31.48,Default,,0,0,0,,Сіз бұл туралы ойламайсыз ба?
Dialogue: 0,0:00:32.90,0:00:33.99,Default,,0,0,0,,Алда не күтіп тұр
Dialogue: 0,0:00:34.07,0:00:36.24,Default,,0,0,0,,Бұл солай деп ойлаудың қажеті жоқ.
Dialogue: 0,0:00:36.32,0:00:37.99,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:00:38.07,0:00:40.20,Default,,0,0,0,,Сіз қалыпты ойлайсыз ба?
Dialogue: 0,0:00:40.29,0:00:44.12,Default,,0,0,0,,Кошиенге барғың келетінін айтпадың ба?
Dialogue: 0,0:00:46.33,0:00:47.88,Default,,0,0,0,,Бір жыл бұрын
Dialogue: 0,0:00:48.88,0:00:51.59,Default,,0,0,0,,Бірақ мен бұл туралы қазір ойлай алмаймын.
Dialogue: 0,0:00:52.30,0:00:53.51,Default,,0,0,0,,Қатты ауырады
Dialogue: 0,0:00:54.72,0:00:57.68,Default,,0,0,0,,Мен орта мектепке дейін сенімен бірге боламын
Dialogue: 0,0:00:57.76,0:00:59.89,Default,,0,0,0,,Ойлаудың өзі тым ауыр.
Dialogue: 0,0:01:01.39,0:01:02.39,Default,,0,0,0,,Австралия
Dialogue: 0,0:01:02.47,0:01:04.14,Default,,0,0,0,,Неге қайтып келдің?
Dialogue: 0,0:01:07.10,0:01:08.65,Default,,0,0,0,,Неліктен тағы?
Dialogue: 0,0:01:08.73,0:01:10.86,Default,,0,0,0,,Мен сені ұстайтыным болар деп ойладым.
Dialogue: 0,0:01:14.19,0:01:15.15,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:01:15.24,0:01:17.66,Default,,0,0,0,,Сонда менімен дос болғың келе ме?
Dialogue: 0,0:01:20.45,0:01:23.41,Default,,0,0,0,,Сізге не керек, қолғаптарыңыз бар ма?
Dialogue: 0,0:01:23.50,0:01:24.41,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:26.92,0:01:28.00,Default,,0,0,0,,Такуми
Dialogue: 0,0:01:29.38,0:01:31.67,Default,,0,0,0,,Өткен күні доп Кайонджи мырзаға.
Dialogue: 0,0:01:33.05,0:01:33.92,Default,,0,0,0,,Бұл
Dialogue: 0,0:01:40.05,0:01:45.06,Default,,0,0,0,,♪～
Dialogue: 0,0:03:04.51,0:03:09.52,Default,,0,0,0,,～♪
Dialogue: 0,0:03:13.10,0:03:16.02,Default,,0,0,0,,Ата, мына тамақ біртүрлі екен.
Dialogue: 0,0:03:17.07,0:03:18.28,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:03:18.36,0:03:21.53,Default,,0,0,0,,Күріш пеші сынған. Мен күрішті пісіре алмаймын.
Dialogue: 0,0:03:29.33,0:03:32.75,Default,,0,0,0,,Ата, суды қосқанда қателескен жоқсыз ба?
Dialogue: 0,0:03:32.83,0:03:34.21,Default,,0,0,0,,Мені ақымақ қыл
Dialogue: 0,0:03:34.29,0:03:37.17,Default,,0,0,0,,Содан кейін сіз дұрыс емес қосқышты басқансыз.
Dialogue: 0,0:03:37.25,0:03:40.76,Default,,0,0,0,,«Пісіру» орнына «жылы ұстау» түймесін баспадыңыз ба?
Dialogue: 0,0:03:40.84,0:03:41.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:42.68,0:03:43.76,Default,,0,0,0,,Я...
Dialogue: 0,0:03:44.34,0:03:45.64,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:03:45.72,0:03:48.56,Default,,0,0,0,,Макико, оны құпия сақтаңыз.
Dialogue: 0,0:03:48.64,0:03:49.77,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:03:50.81,0:03:52.06,Default,,0,0,0,,Не?
Dialogue: 0,0:03:52.14,0:03:55.15,Default,,0,0,0,,Тыныш ақшаға мен саған хокабен сатып аламын.
Dialogue: 0,0:03:55.23,0:03:56.90,Default,,0,0,0,,Мен де сауда жасаймын.
Dialogue: 0,0:03:56.98,0:03:59.03,Default,,0,0,0,,Аонами, не қажет екенін ескер.
Dialogue: 0,0:03:59.11,0:04:02.36,Default,,0,0,0,,Иә, нан жоқ, құлпынай жоқ.
Dialogue: 0,0:04:02.45,0:04:03.53,Default,,0,0,0,,Мен де винер алғым келеді
Dialogue: 0,0:04:05.28,0:04:07.28,Default,,0,0,0,,Неге маған қарап тұрсың, ата?
Dialogue: 0,0:04:07.37,0:04:09.04,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:04:09.12,0:04:12.08,Default,,0,0,0,,Сіз де көп нәрсені жасай аласыз.
Dialogue: 0,0:04:12.16,0:04:15.29,Default,,0,0,0,,Мен бейсболдан басқа ештеңе істей алмаймын деп ойлайсың ба?
Dialogue: 0,0:04:15.38,0:04:17.29,Default,,0,0,0,,Мен мұны мақтау ретінде айттым.
Dialogue: 0,0:04:17.38,0:04:19.46,Default,,0,0,0,,Мен ештеңе істей алмаймын
Dialogue: 0,0:04:19.55,0:04:22.80,Default,,0,0,0,,Бейсболдан басқа ештеңемен айналыспайсыз ба?
Dialogue: 0,0:04:22.88,0:04:25.05,Default,,0,0,0,,Сізге басқа ештеңе керек емес.
Dialogue: 0,0:04:25.13,0:04:28.81,Default,,0,0,0,,Такуми: Ол бейсболға таңдалады деп үміттенемін.
Dialogue: 0,0:04:28.89,0:04:31.06,Default,,0,0,0,,Бейсболды таңдау сияқты таныс.
Dialogue: 0,0:04:31.14,0:04:32.56,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:04:32.64,0:04:35.19,Default,,0,0,0,,Бұл дүниеде қандай дүниелер бар?
Dialogue: 0,0:04:35.27,0:04:36.56,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:04:36.65,0:04:37.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:37.90,0:04:41.90,Default,,0,0,0,,Мен не істей аламын? Мен не істей алмаймын?
Dialogue: 0,0:04:41.99,0:04:44.32,Default,,0,0,0,,Сіз ештеңе түсінбейсіз деп ойлаймын.
Dialogue: 0,0:04:44.40,0:04:46.53,Default,,0,0,0,,Мұны дұрыс білгеннен кейін
Dialogue: 0,0:04:46.61,0:04:49.78,Default,,0,0,0,,Иә, бірақ бейсбол ойнауға тырысатындар ғана
Dialogue: 0,0:04:49.87,0:04:52.33,Default,,0,0,0,,Бейсболды өзіңіз таңдағаныңызды айта аласыз.
Dialogue: 0,0:04:52.41,0:04:56.33,Default,,0,0,0,,Эй, сен де сүт алғың келе ме? Және рамен де?
Dialogue: 0,0:05:05.80,0:05:07.97,Default,,0,0,0,,Ата, жарайды.
Dialogue: 0,0:05:08.05,0:05:10.47,Default,,0,0,0,,Менің ағам болса, ашуланбас едім.
Dialogue: 0,0:05:11.18,0:05:12.43,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:12.52,0:05:15.94,Default,,0,0,0,,Мен тағы да қажетсіз бірдеңені айтуым керек сияқты.
Dialogue: 0,0:05:16.02,0:05:18.48,Default,,0,0,0,,Бірақ атам жақсы болды.
Dialogue: 0,0:05:18.56,0:05:20.44,Default,,0,0,0,,Иә? Керемет болды ма?
Dialogue: 0,0:05:20.52,0:05:22.61,Default,,0,0,0,,Иә, ата
Dialogue: 0,0:05:22.69,0:05:25.03,Default,,0,0,0,,Менің ағаммен бейсбол туралы сөйлесетін кез келді.
Dialogue: 0,0:05:25.11,0:05:27.45,Default,,0,0,0,,Ең керемет көрінеді
Dialogue: 0,0:05:32.91,0:05:35.91,Default,,0,0,0,,Шун, сенен сұрайтыным бар.
Dialogue: 0,0:05:36.83,0:05:37.92,Default,,0,0,0,,Не?
Dialogue: 0,0:05:38.00,0:05:40.67,Default,,0,0,0,,Мен Хараданы жеңе алмаймын дейсің.
Dialogue: 0,0:05:40.75,0:05:42.17,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:05:43.09,0:05:44.38,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:05:44.46,0:05:47.68,Default,,0,0,0,,Сенің әлсіздігің – аңғалдығың.
Dialogue: 0,0:05:47.76,0:05:51.30,Default,,0,0,0,,Менің не ойлайтыным маңызды емес.
Dialogue: 0,0:05:51.39,0:05:53.35,Default,,0,0,0,,Химе-саннан біраз үйрен
Dialogue: 0,0:05:53.43,0:05:55.68,Default,,0,0,0,,Ол тек өзіне ғана сенеді.
Dialogue: 0,0:05:55.77,0:05:59.15,Default,,0,0,0,,Бірақ мен жақсы емес нәрселердің бәрін біліңіз.
Dialogue: 0,0:05:59.23,0:06:02.19,Default,,0,0,0,,Сонда да маған сенген жалғыз сенсің.
Dialogue: 0,0:06:02.27,0:06:04.53,Default,,0,0,0,,Мен бұған сенген жоқпын.
Dialogue: 0,0:06:04.61,0:06:07.70,Default,,0,0,0,,Жалпы айтқанда, адамдарға мүмкіндігінше қатты соққы беріңіз.
Dialogue: 0,0:06:07.78,0:06:09.45,Default,,0,0,0,,Сенсеңіз де, сенбесеңіз де
Dialogue: 0,0:06:10.37,0:06:11.45,Default,,0,0,0,,Я...
Dialogue: 0,0:06:12.03,0:06:15.70,Default,,0,0,0,,Шун, сіз клубтың спорттық ұсынысынан бас тарттыңыз.
Dialogue: 0,0:06:15.79,0:06:18.79,Default,,0,0,0,,О, құдай-ау, ақпарат қайдан шықты?
Dialogue: 0,0:06:18.87,0:06:20.79,Default,,0,0,0,,Әй, анашым.
Dialogue: 0,0:06:20.88,0:06:23.21,Default,,0,0,0,,Мен сенімен бірге барып, әжеме шағымдандым.
Dialogue: 0,0:06:23.29,0:06:26.17,Default,,0,0,0,,Сіз кез келген жерден өте аласыз.
Dialogue: 0,0:06:26.26,0:06:28.97,Default,,0,0,0,,Бейсбол клубы Нейтоны таңдауда неліктен қиындыққа тап болды?
Dialogue: 0,0:06:29.63,0:06:31.89,Default,,0,0,0,,Бейсбол ойнау үшін орта мектепке барамын деген ниетім жоқ.
Dialogue: 0,0:06:31.97,0:06:33.93,Default,,0,0,0,,Егер солай болса, онда бұл анық.
Dialogue: 0,0:06:34.01,0:06:36.97,Default,,0,0,0,,Сонымен не істейміз? Футбол?
Dialogue: 0,0:06:37.73,0:06:38.60,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:06:38.68,0:06:39.77,Default,,0,0,0,,Ештеңе емес пе?
Dialogue: 0,0:06:40.27,0:06:42.98,Default,,0,0,0,,Сіз үш жылыңызды ештеңе істемей өткізуді жоспарлап отырсыз ба?
Dialogue: 0,0:06:43.06,0:06:45.98,Default,,0,0,0,,Дұрыс, мен жақсымын.
Dialogue: 0,0:06:46.07,0:06:48.99,Default,,0,0,0,,Мен уақытымды ештеңе жасамай өткізуді жоспарлап отырмын.
Dialogue: 0,0:06:51.20,0:06:52.20,Default,,0,0,0,,Я...
Dialogue: 0,0:06:53.28,0:06:55.20,Default,,0,0,0,,Бұл өте шаршатады.
Dialogue: 0,0:06:57.41,0:06:58.41,Default,,0,0,0,,Мен осындамын, мама
Dialogue: 0,0:06:58.50,0:07:01.96,Default,,0,0,0,,Сіз бейсболды соншалықты жек көресіз бе?
Dialogue: 0,0:07:02.04,0:07:05.67,Default,,0,0,0,,Жоқ, мен оны жек көрмеймін. Мен оны жақсы көремін және әлі де сүйемін.
Dialogue: 0,0:07:05.75,0:07:06.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:06.75,0:07:07.92,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,0:07:08.01,0:07:09.97,Default,,0,0,0,,Ауыратынына сенімдімін.
Dialogue: 0,0:07:10.05,0:07:12.93,Default,,0,0,0,,Осындай алып адамнан таяқ жеу
Dialogue: 0,0:07:13.01,0:07:15.93,Default,,0,0,0,,Егер сіз танымайтын адам болса, мен сізбен танысқым келеді.
Dialogue: 0,0:07:16.01,0:07:17.77,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:07:17.85,0:07:20.89,Default,,0,0,0,,Кешірім сұрау ештеңе қоспайды.
Dialogue: 0,0:07:20.98,0:07:23.44,Default,,0,0,0,,Жоқ, бұл дөрекі.
Dialogue: 0,0:07:24.94,0:07:28.28,Default,,0,0,0,,Мен сенен басқа ешкімді ұрмаймын деп ойлаймын.
Dialogue: 0,0:07:28.36,0:07:30.53,Default,,0,0,0,,Неге?
Dialogue: 0,0:07:32.74,0:07:35.62,Default,,0,0,0,,Сіз мені арандатқансыз, солай емес пе?
Dialogue: 0,0:07:35.70,0:07:39.16,Default,,0,0,0,,Бұл әдеттегіден басқаша, бірақ өткен күні мен кірдім.
Dialogue: 0,0:07:39.25,0:07:43.12,Default,,0,0,0,,Сен мені ұрғанымды қаладың.
Dialogue: 0,0:07:43.21,0:07:44.33,Default,,0,0,0,,Жәкен...
Dialogue: 0,0:07:46.29,0:07:48.21,Default,,0,0,0,,Бұл анық емес пе?
Dialogue: 0,0:07:48.71,0:07:53.01,Default,,0,0,0,,Шуго сен мен ойлағандай ақымақ емес едің.
Dialogue: 0,0:08:02.48,0:08:03.56,Default,,0,0,0,,Харада
Dialogue: 0,0:08:07.73,0:08:10.15,Default,,0,0,0,,Сіз танымалсыз, Кайонжи мырза.
Dialogue: 0,0:08:10.23,0:08:11.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.24,0:08:12.40,Default,,0,0,0,,Букет
Dialogue: 0,0:08:12.49,0:08:13.91,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:08:13.99,0:08:16.70,Default,,0,0,0,,Бұл Nonomura және т.б.
Dialogue: 0,0:08:16.78,0:08:19.62,Default,,0,0,0,,Қазіргі капитан бұрынғы капитанға гүл сыйлайды
Dialogue: 0,0:08:19.70,0:08:21.54,Default,,0,0,0,,Бұл жыл сайын әдеттегі нәрсе.
Dialogue: 0,0:08:21.62,0:08:22.91,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:08:23.54,0:08:26.54,Default,,0,0,0,,Басқалар да қол соғып, осылай істеді.
Dialogue: 0,0:08:26.63,0:08:29.67,Default,,0,0,0,,Жосысада екеуің ғана жетіспеді.
Dialogue: 0,0:08:30.25,0:08:31.92,Default,,0,0,0,,Онда Йошисада да болған жоқ па?
Dialogue: 0,0:08:32.01,0:08:35.26,Default,,0,0,0,,Ол рәсім кезінде ұйықтап қалды.
Dialogue: 0,0:08:35.34,0:08:37.68,Default,,0,0,0,,Менің сынып жетекшім маған дәріс оқыды.
Dialogue: 0,0:08:37.76,0:08:38.93,Default,,0,0,0,,Шамасы
Dialogue: 0,0:08:40.01,0:08:41.47,Default,,0,0,0,,Бұл солай сияқты.
Dialogue: 0,0:08:43.98,0:08:45.77,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:08:45.85,0:08:46.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:46.77,0:08:48.73,Default,,0,0,0,,Келесі матчта
Dialogue: 0,0:08:48.81,0:08:51.53,Default,,0,0,0,,Мен оны лақтырмаймын деп ойлайсыз ба?
Dialogue: 0,0:08:51.61,0:08:52.69,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:53.32,0:08:55.45,Default,,0,0,0,,Олай болса, мұны неге сұрайсың?
Dialogue: 0,0:08:56.20,0:08:58.24,Default,,0,0,0,,Мен кенет ойладым
Dialogue: 0,0:08:58.32,0:09:01.45,Default,,0,0,0,,Харада: Қызық, ол бұған шындап қарайды ма?
Dialogue: 0,0:09:02.79,0:09:04.96,Default,,0,0,0,,Мен қазір ашуланып тұрмын.
Dialogue: 0,0:09:05.04,0:09:07.92,Default,,0,0,0,,Сен менің ағам болмасаң, мен сені жұдырықтаймын деп ойладың ба?
Dialogue: 0,0:09:08.00,0:09:09.21,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:09:09.71,0:09:12.21,Default,,0,0,0,,Мен Кайонджи-санның ойын тыңдаймын.
Dialogue: 0,0:09:17.47,0:09:20.18,Default,,0,0,0,,Кадоваки туралы не ойлайсыз?
Dialogue: 0,0:09:20.26,0:09:21.22,Default,,0,0,0,,Кадоваки мырза?
Dialogue: 0,0:09:21.31,0:09:24.23,Default,,0,0,0,,Қалай ойлайсыңдар, ол керемет шабандоз?
Dialogue: 0,0:09:24.31,0:09:25.69,Default,,0,0,0,,Бұл Койл деген жігіт шын мәнінде пайдалы ма?
Dialogue: 0,0:09:26.19,0:09:27.60,Default,,0,0,0,,үшін осы ма?
Dialogue: 0,0:09:27.69,0:09:28.73,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:09:29.40,0:09:30.23,Default,,0,0,0,,Харада
Dialogue: 0,0:09:30.98,0:09:32.65,Default,,0,0,0,,Сіз ұтыласыз
Dialogue: 0,0:09:32.73,0:09:34.99,Default,,0,0,0,,Бұл мені ұрды дегенді білдіре ме?
Dialogue: 0,0:09:35.07,0:09:36.90,Default,,0,0,0,,Мен мұны жақсы айта алмаймын.
Dialogue: 0,0:09:36.99,0:09:40.70,Default,,0,0,0,,Харада мен Нагакура Учитодан қорықпай ма?
Dialogue: 0,0:09:40.78,0:09:43.12,Default,,0,0,0,,Әйтпесе, сіз жеңе алмайсыз.
Dialogue: 0,0:09:43.20,0:09:44.87,Default,,0,0,0,,Сіз Кадоваки мырзаны айтасыз ба?
Dialogue: 0,0:09:44.95,0:09:48.87,Default,,0,0,0,,Сонда бұл жігіт. Ол байсалды.
Dialogue: 0,0:09:48.96,0:09:51.75,Default,,0,0,0,,Мен қорқуым керек деп тұрсың ба, өйткені сен байыптысың ба?
Dialogue: 0,0:09:52.96,0:09:55.13,Default,,0,0,0,,Харада, қорық
Dialogue: 0,0:09:55.21,0:09:57.63,Default,,0,0,0,,Келесі матч Кадоваки салмақты болады
Dialogue: 0,0:09:58.34,0:10:01.30,Default,,0,0,0,,Жеңіс немесе жеңілу немесе сол сияқты нәрселер туралы ойламаңыз.
Dialogue: 0,0:10:01.39,0:10:03.43,Default,,0,0,0,,Мен тек саған қарай келе жатырмын
Dialogue: 0,0:10:03.51,0:10:05.14,Default,,0,0,0,,Менің ойымша, бұл қорқынышты емес
Dialogue: 0,0:10:05.77,0:10:07.60,Default,,0,0,0,,Егер құмыра қамырдан қорықса
Dialogue: 0,0:10:07.69,0:10:09.52,Default,,0,0,0,,Бұл жарыс емес, солай ма?
Dialogue: 0,0:10:09.60,0:10:11.19,Default,,0,0,0,,Логика жоқ
Dialogue: 0,0:10:12.98,0:10:16.49,Default,,0,0,0,,Мен құмырамын, сондықтан ешкімді жеңе алмаймын.
Dialogue: 0,0:10:20.74,0:10:21.95,Default,,0,0,0,,Я...
Dialogue: 0,0:10:23.53,0:10:25.04,Default,,0,0,0,,Вент ашылғанына үш күн болды.
Dialogue: 0,0:10:25.12,0:10:26.45,Default,,0,0,0,,Директор
Dialogue: 0,0:10:26.54,0:10:29.04,Default,,0,0,0,,Сені оңай тастап кетті, Кайонжи.
Dialogue: 0,0:10:29.12,0:10:30.29,Default,,0,0,0,,Мен Харадаға баруым керек.
Dialogue: 0,0:10:30.37,0:10:32.67,Default,,0,0,0,,Менің саған айтар сөзім бар еді.
Dialogue: 0,0:10:32.75,0:10:34.30,Default,,0,0,0,,Мен жақсы ештеңе айта алмаймын...
Dialogue: 0,0:10:34.38,0:10:36.80,Default,,0,0,0,,Оның қандай жақсы екенін біреуге айтудың пайдасы жоқ.
Dialogue: 0,0:10:36.88,0:10:37.80,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:37.88,0:10:39.55,Default,,0,0,0,,Ол не деді?
Dialogue: 0,0:10:39.63,0:10:43.47,Default,,0,0,0,,«Мен құмырамын, сондықтан мен ешкімге жеңілмеймін».
Dialogue: 0,0:10:43.55,0:10:46.56,Default,,0,0,0,,Дәл... 13-14 жастағы бала осылай дей ме?
Dialogue: 0,0:10:46.64,0:10:48.56,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:48.64,0:10:51.35,Default,,0,0,0,,Сіз Харадаға дұрыс кеңес бердіңіз.
Dialogue: 0,0:10:51.44,0:10:52.48,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:52.56,0:10:54.98,Default,,0,0,0,,Одан артық ештеңе жасама.
Dialogue: 0,0:10:55.07,0:10:57.69,Default,,0,0,0,,Шынымды айтсам, бұл керемет деп ойлаймын.
Dialogue: 0,0:10:57.78,0:10:58.94,Default,,0,0,0,,Кім?
Dialogue: 0,0:10:59.03,0:10:59.95,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:11:00.03,0:11:01.95,Default,,0,0,0,,Мен? Харада Джанут?
Dialogue: 0,0:11:02.03,0:11:04.28,Default,,0,0,0,,Хараданың атын немесе басқаларды атамаңыз.
Dialogue: 0,0:11:04.37,0:11:07.20,Default,,0,0,0,,Ол жай ғана бос бала.
Dialogue: 0,0:11:07.29,0:11:09.91,Default,,0,0,0,,Бірақ сіз табиғи құмыра шығарсыз.
Dialogue: 0,0:11:09.91,0:11:11.00,Default,,0,0,0,,Бірақ сіз табиғи құмыра шығарсыз.
Dialogue: 0,0:11:09.91,0:11:11.00,Default,,0,0,0,,Томура мырза Томура мырза
Dialogue: 0,0:11:11.00,0:11:12.21,Default,,0,0,0,,Томура мырза Томура мырза
Dialogue: 0,0:11:12.29,0:11:12.88,Default,,0,0,0,,Қоңырау келіп жатыр.
Dialogue: 0,0:11:12.88,0:11:14.21,Default,,0,0,0,,Қоңырау келіп жатыр.
Dialogue: 0,0:11:12.88,0:11:14.21,Default,,0,0,0,,Харада да, Нагакура да сізге сеніп тапсырылған, оларды қалауыңызша пайдаланыңыз.
Dialogue: 0,0:11:14.21,0:11:14.29,Default,,0,0,0,,Харада да, Нагакура да сізге сеніп тапсырылған, оларды қалауыңызша пайдаланыңыз.
Dialogue: 0,0:11:14.29,0:11:16.71,Default,,0,0,0,,Харада да, Нагакура да сізге сеніп тапсырылған және сіз оларды өз қалауыңыз бойынша пайдалана аласыз.
Dialogue: 0,0:11:14.29,0:11:16.71,Default,,0,0,0,,Қызметкерлер бөлмесіне оралыңыз.
Dialogue: 0,0:11:18.01,0:11:19.05,Default,,0,0,0,,Досым
Dialogue: 0,0:11:19.13,0:11:21.51,Default,,0,0,0,,Батареяны өзіңізбен бірге қалдырыңыз.
Dialogue: 0,0:11:21.59,0:11:23.09,Default,,0,0,0,,Қанағаттанбады ма?
Dialogue: 0,0:11:23.18,0:11:24.72,Default,,0,0,0,,Жоқ, солай…
Dialogue: 0,0:11:25.30,0:11:29.27,Default,,0,0,0,,Хараданың лақтыруы - бұл Кадовакиге және басқаларға уәде, солай ма?
Dialogue: 0,0:11:29.35,0:11:31.06,Default,,0,0,0,,Жәкен, батареяны ойынға дейін ұста.
Dialogue: 0,0:11:31.14,0:11:33.10,Default,,0,0,0,,Мен сені өзімнің бұйрығыммен қоямын.
Dialogue: 0,0:11:33.19,0:11:35.36,Default,,0,0,0,,Мен араласпаймын
Dialogue: 0,0:11:37.07,0:11:40.95,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:11:42.61,0:11:43.45,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:11:44.07,0:11:45.03,Default,,0,0,0,,Иә
Dialogue: 0,0:11:45.12,0:11:46.58,Default,,0,0,0,,Сәлеметсіз бе, Мизугаки?
Dialogue: 0,0:11:46.66,0:11:49.08,Default,,0,0,0,,О, Кайондзи?
Dialogue: 0,0:11:49.16,0:11:51.91,Default,,0,0,0,,Мен жеңілетінімді айттым.
Dialogue: 0,0:11:52.00,0:11:52.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:53.04,0:11:56.71,Default,,0,0,0,,Жарайды, мен Харадаға жеңілетінімді айттым.
Dialogue: 0,0:11:56.79,0:11:58.46,Default,,0,0,0,,Кадоваки жеңе алмайды
Dialogue: 0,0:11:58.55,0:12:01.97,Default,,0,0,0,,Бұл нақты пікір.
Dialogue: 0,0:12:02.05,0:12:04.84,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз солай ойламайсыз ба?
Dialogue: 0,0:12:04.93,0:12:07.22,Default,,0,0,0,,Біз матч алдында осындай нәрселер туралы сөйлестік.
Dialogue: 0,0:12:07.30,0:12:08.68,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:12:09.27,0:12:11.02,Default,,0,0,0,,Бейсбол – мен.
Dialogue: 0,0:12:11.10,0:12:13.89,Default,,0,0,0,,Сіздің ерік-жігеріңіз неғұрлым күшті болса, соғұрлым жеңіске жететініңізге сеніңіз.
Dialogue: 0,0:12:13.98,0:12:17.94,Default,,0,0,0,,Кадовакидің қарсыласын жеңуге деген ынтасы күштірек.
Dialogue: 0,0:12:18.02,0:12:19.44,Default,,0,0,0,,Жақсы
Dialogue: 0,0:12:19.53,0:12:21.94,Default,,0,0,0,,Кадоваки мақсаты бір адам.
Dialogue: 0,0:12:22.03,0:12:24.95,Default,,0,0,0,,Зейінге келетін болсақ, бұл керемет.
Dialogue: 0,0:12:25.03,0:12:28.70,Default,,0,0,0,,Иә, бірақ мен жеңе аламыз деп ойлаймын.
Dialogue: 0,0:12:28.78,0:12:30.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:30.41,0:12:31.95,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:12:32.04,0:12:35.96,Default,,0,0,0,,Менің ойымша, егер сіз мұны жасасаңыз, жеңіске жету мүмкіндігіңіз жоғары.
Dialogue: 0,0:12:36.04,0:12:38.46,Default,,0,0,0,,Бұл жақсы нәрсе.
Dialogue: 0,0:12:39.04,0:12:42.34,Default,,0,0,0,,Бұл менмін, Харада, мен оны өзгертіп көрейін деп ойлаймын.
Dialogue: 0,0:12:42.42,0:12:44.09,Default,,0,0,0,,Бүкіл команда да өзгерді.
Dialogue: 0,0:12:44.18,0:12:47.05,Default,,0,0,0,,Мочи Йокотемен тең дәрежеде бәсекелесе алатын команда болыңыз
Dialogue: 0,0:12:47.14,0:12:48.14,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,0:12:48.22,0:12:51.47,Default,,0,0,0,,«Не?»... Мен сенің айтқаныңның жартысын да түсіне алар емеспін.
Dialogue: 0,0:12:51.56,0:12:53.77,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,0:12:53.85,0:12:56.98,Default,,0,0,0,,Директор маған аккумуляторды өзіме қалдыруымды айтты.
Dialogue: 0,0:12:57.06,0:12:59.15,Default,,0,0,0,,Жәкен Мен өз жолыммен сынап көрейін
Dialogue: 0,0:12:59.23,0:13:02.11,Default,,0,0,0,,Әлі бір апта қалды, сондықтан оны уақытында орындаймыз.
Dialogue: 0,0:13:02.69,0:13:05.74,Default,,0,0,0,,Идиот, сен өзіңді қалай түсінесің?
Dialogue: 0,0:13:05.82,0:13:07.99,Default,,0,0,0,,Негізі мен аздап уайымдап тұрмын.
Dialogue: 0,0:13:08.07,0:13:12.04,Default,,0,0,0,,Шынымды айтсам, менде мұндай күш бар ма деп ойладым...
Dialogue: 0,0:13:12.12,0:13:14.91,Default,,0,0,0,,Мен Мизугаки не істер еді деп ойлаймын.
Dialogue: 0,0:13:15.00,0:13:16.25,Default,,0,0,0,,Мен телефон соқтым
Dialogue: 0,0:13:16.33,0:13:17.46,Default,,0,0,0,,Мен?
Dialogue: 0,0:13:20.92,0:13:22.13,Default,,0,0,0,,Таза
Dialogue: 0,0:13:22.76,0:13:24.92,Default,,0,0,0,,Әр нәрсені өз бетінше ойластырған дұрыс.
Dialogue: 0,0:13:25.01,0:13:27.09,Default,,0,0,0,,Сіз бұл туралы айтып көріңіз.
Dialogue: 0,0:13:27.18,0:13:28.01,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:13:28.09,0:13:29.35,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:13:29.43,0:13:31.72,Default,,0,0,0,,...
Dialogue: 0,0:13:31.81,0:13:33.14,Default,,0,0,0,,Сіз маған қоңырау шалдыңыз ба?
Dialogue: 0,0:13:33.22,0:13:36.39,Default,,0,0,0,,Айтшы, не айтқың келеді?
Dialogue: 0,0:13:36.48,0:13:39.44,Default,,0,0,0,,２
Dialogue: 0,0:13:39.52,0:13:41.69,Default,,0,0,0,,Фуфу соғыс жариялау
Dialogue: 0,0:13:41.77,0:13:42.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:42.69,0:13:45.78,Default,,0,0,0,,...
Dialogue: 0,0:13:45.86,0:13:48.41,Default,,0,0,0,,Хехе, бұл неше жаста?
Dialogue: 0,0:13:48.49,0:13:50.91,Default,,0,0,0,,Біз жоғалтуға мүмкіндік жоқ.
Dialogue: 0,0:13:50.99,0:13:52.99,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:13:53.08,0:13:54.95,Default,,0,0,0,,Жәкен Соғыс жариялауы
Dialogue: 0,0:13:55.04,0:13:58.00,Default,,0,0,0,,Сен Кадовакиді ал, мен батареяны аламын.
Dialogue: 0,0:13:58.08,0:14:00.42,Default,,0,0,0,,Біздің әрқайсымызда козир бар.
Dialogue: 0,0:14:00.50,0:14:03.55,Default,,0,0,0,,Сіз қазір шошып кеттіңіз бе?
Dialogue: 0,0:14:03.63,0:14:05.34,Default,,0,0,0,,Ей, жасайық.
Dialogue: 0,0:14:05.42,0:14:08.01,Default,,0,0,0,,Ең жақсы сәйкестікті жасаңыз
Dialogue: 0,0:14:08.09,0:14:09.84,Default,,0,0,0,,Сіз білесіз...
Dialogue: 0,0:14:09.93,0:14:11.97,Default,,0,0,0,,Харада соғылған көрініс
Dialogue: 0,0:14:12.05,0:14:14.22,Default,,0,0,0,,Кадоваки шығып жатқан көрініс
Dialogue: 0,0:14:14.31,0:14:16.10,Default,,0,0,0,,Сіз қайсысын көргіңіз келеді?
Dialogue: 0,0:14:17.85,0:14:19.40,Default,,0,0,0,,Екеуі де.
Dialogue: 0,0:14:19.48,0:14:20.48,Default,,0,0,0,,Мизугаки…
Dialogue: 0,0:14:20.56,0:14:23.36,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:14:23.44,0:14:25.86,Default,,0,0,0,,...
Dialogue: 0,0:14:25.94,0:14:27.90,Default,,0,0,0,,Бұл Мидзугаки.
Dialogue: 0,0:14:27.99,0:14:30.11,Default,,0,0,0,,Мен сіздің әдісіңізді асыға күтемін.
Dialogue: 0,0:14:30.20,0:14:31.37,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:14:37.00,0:14:37.71,Default,,0,0,0,,-（） -（）
Dialogue: 0,0:14:37.71,0:14:39.29,Default,,0,0,0,,-（） -（）
Dialogue: 0,0:14:37.71,0:14:39.29,Default,,0,0,0,,(клуб мүшелерінің жүгірген аяқ дыбысы)
Dialogue: 0,0:14:40.46,0:14:41.92,Default,,0,0,0,,Алдағы матч
Dialogue: 0,0:14:42.00,0:14:45.05,Default,,0,0,0,,...
Dialogue: 0,0:14:45.63,0:14:48.17,Default,,0,0,0,,...
Dialogue: 0,0:14:48.26,0:14:51.80,Default,,0,0,0,,...
Dialogue: 0,0:14:51.89,0:14:54.35,Default,,0,0,0,,Біз мұндай матчты соңғы рет ойнай аламыз.
Dialogue: 0,0:14:54.43,0:14:57.31,Default,,0,0,0,,Мен қатты толқыдым және оны асыға күтемін.
Dialogue: 0,0:14:57.98,0:15:01.06,Default,,0,0,0,,Бірақ бұл тек біздің 3 курс студенттерінің пікірі.
Dialogue: 0,0:15:01.65,0:15:05.07,Default,,0,0,0,,1 және 2 сынып оқушыларының ынтымақтастығына ризамын.
Dialogue: 0,0:15:05.65,0:15:08.36,Default,,0,0,0,,Мен сізге ертерек алғыс айтпауым керек еді, бірақ...
Dialogue: 0,0:15:10.15,0:15:12.82,Default,,0,0,0,,Маған бәрібір, олай ойламаймын.
Dialogue: 0,0:15:12.91,0:15:15.20,Default,,0,0,0,,Қызықты, себебі ол әдеттегі тәжірибеден ерекшеленеді
Dialogue: 0,0:15:15.28,0:15:17.58,Default,,0,0,0,,Мен үшін ең соңында көңіл-күйім жақсы.
Dialogue: 0,0:15:17.66,0:15:20.08,Default,,0,0,0,,Оның қалыпты тәжірибеден айырмашылығы неде?
Dialogue: 0,0:15:20.16,0:15:23.75,Default,,0,0,0,,Тәжірибе мәзірі толығымен тегін емес пе?
Dialogue: 0,0:15:23.83,0:15:26.63,Default,,0,0,0,,Директордың араласуы оңай емес пе?
Dialogue: 0,0:15:26.71,0:15:27.92,Default,,0,0,0,,Менің жұмысым азайды...
Dialogue: 0,0:15:28.01,0:15:28.84,Default,,0,0,0,,Идиот
Dialogue: 0,0:15:29.47,0:15:31.34,Default,,0,0,0,,Бірақ жаттығу қызық.
Dialogue: 0,0:15:32.18,0:15:34.60,Default,,0,0,0,,Кайонджи мырза, бұл дегеніміз.
Dialogue: 0,0:15:34.68,0:15:37.18,Default,,0,0,0,,Көңілді және ынтымақтастықта болыңыз
Dialogue: 0,0:15:44.94,0:15:46.32,Default,,0,0,0,,Такуми
Dialogue: 0,0:15:47.57,0:15:50.28,Default,,0,0,0,,Сен бүгін күні бойы құмыра болып жүрсің.
Dialogue: 0,0:15:50.36,0:15:51.36,Default,,0,0,0,,Неліктен өзіңізді ұстайсыз?
Dialogue: 0,0:15:51.45,0:15:52.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:53.03,0:15:55.74,Default,,0,0,0,,Сен барыңды бермей бітсе, қарсы боласың ба?
Dialogue: 0,0:15:55.82,0:15:57.12,Default,,0,0,0,,Бұл сіздің бетіңізде жазылған.
Dialogue: 0,0:15:57.20,0:15:58.29,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:15:58.37,0:15:59.62,Default,,0,0,0,,«Мен аштан өліп жатырмын»
Dialogue: 0,0:16:00.54,0:16:02.08,Default,,0,0,0,,Маған бұл күндері ұнамайды.
Dialogue: 0,0:16:02.16,0:16:03.37,Default,,0,0,0,,Қайда?
Dialogue: 0,0:16:03.46,0:16:05.46,Default,,0,0,0,,Мен оны лақтырғым келеді, мен оны аламын.
Dialogue: 0,0:16:05.96,0:16:08.55,Default,,0,0,0,,Айтқаныңды көп күттім.
Dialogue: 0,0:16:09.09,0:16:10.51,Default,,0,0,0,,Маған неге айтпадың?
Dialogue: 0,0:16:11.72,0:16:13.63,Default,,0,0,0,,Такуми Рашиуненжа
Dialogue: 0,0:16:17.35,0:16:18.64,Default,,0,0,0,,Харада!
Dialogue: 0,0:16:18.72,0:16:21.18,Default,,0,0,0,,Серіктес болайық
Dialogue: 0,0:16:21.27,0:16:22.14,Default,,0,0,0,,Нономура
Dialogue: 0,0:16:22.23,0:16:24.40,Default,,0,0,0,,1-2 жыл қорғау
Dialogue: 0,0:16:24.48,0:16:26.40,Default,,0,0,0,,(клуб мүшелерінің жүгірген аяқ дыбысы)
Dialogue: 0,0:16:39.70,0:16:40.83,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:16:40.91,0:16:41.75,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:16:50.25,0:16:51.34,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:16:57.55,0:16:59.93,Default,,0,0,0,,...
Dialogue: 0,0:17:00.56,0:17:03.35,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:17:03.85,0:17:04.73,Default,,0,0,0,,Нагакура
Dialogue: 0,0:17:04.81,0:17:05.77,Default,,0,0,0,,Иә
Dialogue: 0,0:17:06.27,0:17:07.98,Default,,0,0,0,,Сіз оны ұстай аласыз ба?
Dialogue: 0,0:17:08.06,0:17:09.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:09.23,0:17:10.23,Default,,0,0,0,,Нономура!
Dialogue: 0,0:17:10.32,0:17:11.28,Default,,0,0,0,,Иә
Dialogue: 0,0:17:13.57,0:17:16.99,Default,,0,0,0,,Енді қорғаныста болған соң, маған аздап тықылдатыңыз.
Dialogue: 0,0:17:17.07,0:17:17.99,Default,,0,0,0,,Иә
Dialogue: 0,0:17:19.32,0:17:22.70,Default,,0,0,0,,Кайондзи мырза, бұл нені білдіреді?
Dialogue: 0,0:17:22.79,0:17:24.50,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:17:24.58,0:17:26.25,Default,,0,0,0,,Дәл солай...
Dialogue: 0,0:17:26.33,0:17:29.46,Default,,0,0,0,,Хараданың добы, сен оны ұстай аласың ба?
Dialogue: 0,0:17:29.54,0:17:30.75,Default,,0,0,0,,Мен естідім.
Dialogue: 0,0:17:30.84,0:17:32.96,Default,,0,0,0,,Жоқ, бұл мүмкін емес деп ойлаймын.
Dialogue: 0,0:17:33.05,0:17:35.13,Default,,0,0,0,,Жаттығу мүмкін емес пе?
Dialogue: 0,0:17:35.22,0:17:37.26,Default,,0,0,0,,Мен Йокоте матчына уақытында үлгере алмаймын.
Dialogue: 0,0:17:37.34,0:17:40.26,Default,,0,0,0,,Сабырлы жауап, Нагакура.
Dialogue: 0,0:17:40.35,0:17:43.39,Default,,0,0,0,,Кайондзи-сан мені дүрбелеңге салғысы келе ме?
Dialogue: 0,0:17:43.47,0:17:44.52,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:17:44.60,0:17:47.52,Default,,0,0,0,,Сіз Харада болсаңыз да ұстаушы ойнай аласыз ба?
Dialogue: 0,0:17:47.60,0:17:50.27,Default,,0,0,0,,Жарайды, бұл қалыпты жағдай.
Dialogue: 0,0:17:50.36,0:17:52.11,Default,,0,0,0,,Мен оны дұрыстап аламын.
Dialogue: 0,0:17:52.61,0:17:54.94,Default,,0,0,0,,Оны не дұрыс ұстайды?
Dialogue: 0,0:17:55.69,0:17:57.24,Default,,0,0,0,,Мен сізден тағы сұраймын.
Dialogue: 0,0:17:57.82,0:18:01.28,Default,,0,0,0,,Харададан басқа құмыралар да дәл осындай сезіммен жасай ала ма?
Dialogue: 0,0:18:01.37,0:18:02.66,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:03.24,0:18:04.45,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:04.54,0:18:06.08,Default,,0,0,0,,Менің ойымша, бұл мүмкін емес.
Dialogue: 0,0:18:06.96,0:18:07.79,Default,,0,0,0,,Иә
Dialogue: 0,0:18:07.87,0:18:11.13,Default,,0,0,0,,Бұлай айтқаның өте жаман болды.
Dialogue: 0,0:18:12.42,0:18:13.75,Default,,0,0,0,,Онда мен мұны істеймін.
Dialogue: 0,0:18:13.84,0:18:15.71,Default,,0,0,0,,- (Кайондзи) Харада ше? - (Бару) А?
Dialogue: 0,0:18:15.80,0:18:16.84,Default,,0,0,0,,Харада бұл
Dialogue: 0,0:18:16.92,0:18:19.26,Default,,0,0,0,,Нагакура ұстаушыға лақтыра ала ма?
Dialogue: 0,0:18:19.84,0:18:21.30,Default,,0,0,0,,Капитан…
Dialogue: 0,0:18:21.39,0:18:24.72,Default,,0,0,0,,Мен осылай болғанын қалаймын.
Dialogue: 0,0:18:26.10,0:18:28.27,Default,,0,0,0,,Бұл нағыз құмыра, солай ма?
Dialogue: 0,0:18:28.35,0:18:29.73,Default,,0,0,0,,Бұл қисынды.
Dialogue: 0,0:18:29.81,0:18:32.65,Default,,0,0,0,,Нагакура Маған көбірек еркін болу керек.
Dialogue: 0,0:18:32.73,0:18:35.32,Default,,0,0,0,,Бейсбол ойынын жалғастыру мүмкін еместігінен айырмашылығы бар ма?
Dialogue: 0,0:18:39.11,0:18:42.78,Default,,0,0,0,,Үйге қайтайық. Харада мені апаратынын айтты.
Dialogue: 0,0:18:49.62,0:18:51.67,Default,,0,0,0,,Сен мені үйге апарасың ба?
Dialogue: 0,0:18:51.75,0:18:53.79,Default,,0,0,0,,Жоқ, мен артқа мінемін.
Dialogue: 0,0:18:53.88,0:18:56.55,Default,,0,0,0,,Не, жүргізуші?
Dialogue: 0,0:19:00.13,0:19:01.43,Default,,0,0,0,,Австралия
Dialogue: 0,0:19:01.51,0:19:02.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:02.85,0:19:05.31,Default,,0,0,0,,Кайондзи-санмен не туралы сөйлестіңіз?
Dialogue: 0,0:19:05.89,0:19:06.89,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:19:07.60,0:19:09.56,Default,,0,0,0,,Неліктен кенеттен тоқтап қалады?
Dialogue: 0,0:19:10.27,0:19:12.65,Default,,0,0,0,,Кадоваки мырза керемет адам.
Dialogue: 0,0:19:12.73,0:19:14.82,Default,,0,0,0,,Иә, қамыр ретінде.
Dialogue: 0,0:19:15.90,0:19:17.73,Default,,0,0,0,,Жануте қамыр ретінде
Dialogue: 0,0:19:17.82,0:19:20.49,Default,,0,0,0,,Қараңызшы, бұл қазірдің өзінде бүкілхалықтық аудан.
Dialogue: 0,0:19:20.57,0:19:23.32,Default,,0,0,0,,Неліктен бейтаныс жаңа ойыншымен матч ойнауға тырысу керек?
Dialogue: 0,0:19:24.07,0:19:26.20,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:19:26.29,0:19:27.33,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:19:28.91,0:19:31.17,Default,,0,0,0,,«Кел» дегеннің не екенін білмейсің бе?
Dialogue: 0,0:19:31.25,0:19:32.08,Default,,0,0,0,,Иә
Dialogue: 0,0:19:32.17,0:19:36.46,Default,,0,0,0,,Кадоваки мырза шарасыз. Сіз бұл анық деп ойлайсыз ба?
Dialogue: 0,0:19:37.09,0:19:39.34,Default,,0,0,0,,Мен ерекше ештеңе ойламаймын.
Dialogue: 0,0:19:41.84,0:19:44.97,Default,,0,0,0,,Сіз оны менімен бірге лақтыра аласыз ба?
Dialogue: 0,0:19:45.05,0:19:46.85,Default,,0,0,0,,- (Такуми) лақтырылды - (Австралия) Көремін.
Dialogue: 0,0:19:47.51,0:19:49.98,Default,,0,0,0,,Лақтыру немесе лақтырмау
Dialogue: 0,0:19:50.06,0:19:53.35,Default,,0,0,0,,Менен мұны бәрі сұрайды, бірақ маңызды емес.
Dialogue: 0,0:19:54.15,0:19:55.15,Default,,0,0,0,,Сіз шынымен солайсыз
Dialogue: 0,0:19:55.23,0:19:56.86,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:19:56.94,0:19:57.98,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:19:58.07,0:19:59.36,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:19:59.44,0:20:02.07,Default,,0,0,0,,Ұстаушы сен болмасаң маған бәрібір
Dialogue: 0,0:20:02.15,0:20:03.61,Default,,0,0,0,,Маңызды емес
Dialogue: 0,0:20:06.20,0:20:09.12,Default,,0,0,0,,Мен саған велосипед беремін. Үйге бару.
Dialogue: 0,0:20:09.20,0:20:10.37,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:20:11.04,0:20:14.58,Default,,0,0,0,,Мен де сен сияқты өз допымды ұстай алсам
Dialogue: 0,0:20:14.67,0:20:16.88,Default,,0,0,0,,Мен кез келген адамды лақтыра аламын
Dialogue: 0,0:20:17.88,0:20:19.13,Default,,0,0,0,,Білу
Dialogue: 0,0:20:19.21,0:20:20.55,Default,,0,0,0,,Сонымен
Dialogue: 0,0:20:20.63,0:20:23.43,Default,,0,0,0,,Сіз ұстаушы болғаныңыз біздің бірге екенімізді білдірмейді.
Dialogue: 0,0:20:24.72,0:20:28.14,Default,,0,0,0,,Қолында күші бар кез келген адам ұстаушы бола алады.
Dialogue: 0,0:20:28.22,0:20:30.97,Default,,0,0,0,,«Ұстаушы сияқты нәрсе»…
Dialogue: 0,0:20:33.27,0:20:34.98,Default,,0,0,0,,Мен енді ғана түсіндім
Dialogue: 0,0:20:35.06,0:20:35.90,Default,,0,0,0,,Қый!
Dialogue: 0,0:20:36.81,0:20:39.23,Default,,0,0,0,,Сіз ешқашан Такуми Хараданың добын ұстаған емессіз.
Dialogue: 0,0:20:39.32,0:20:40.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:40.23,0:20:41.61,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:20:41.69,0:20:45.16,Default,,0,0,0,,Өз допыңды ұстай алмайтын жалғыз сенсің.
Dialogue: 0,0:20:45.82,0:20:48.33,Default,,0,0,0,,Мағынасы жоқ не айтып тұрсың?
Dialogue: 0,0:20:48.41,0:20:49.66,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:20:50.41,0:20:52.83,Default,,0,0,0,,Сіз нақты ештеңе білмейсіз.
Dialogue: 0,0:20:52.91,0:20:54.96,Default,,0,0,0,,Мен сол бір допты ұстаған кезде...
Dialogue: 0,0:20:55.46,0:20:57.50,Default,,0,0,0,,Мен нені сезіне аламын және біле аламын
Dialogue: 0,0:20:58.25,0:20:59.59,Default,,0,0,0,,Ватари-сан
Dialogue: 0,0:21:00.21,0:21:01.59,Default,,0,0,0,,Маған бере аласыз ба?
Dialogue: 0,0:21:03.09,0:21:03.92,Default,,0,0,0,,Австралия
Dialogue: 0,0:21:05.01,0:21:07.47,Default,,0,0,0,,Ойын аяқталғанда
Dialogue: 0,0:21:07.55,0:21:09.43,Default,,0,0,0,,Мен ағашқа бір рет өрмелегім келеді.
Dialogue: 0,0:21:10.14,0:21:11.68,Default,,0,0,0,,Ағаш? Не?
Dialogue: 0,0:21:11.77,0:21:14.18,Default,,0,0,0,,Савагучидегі бұл үлкен
Dialogue: 0,0:21:15.10,0:21:17.10,Default,,0,0,0,,А... хахахаха
Dialogue: 0,0:21:17.60,0:21:19.69,Default,,0,0,0,,Ағашқа өрмелеу өте қиын.
Dialogue: 0,0:21:19.77,0:21:20.98,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:21:26.11,0:21:31.12,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.99,0:22:55.99,Default,,0,0,0,,～♪
