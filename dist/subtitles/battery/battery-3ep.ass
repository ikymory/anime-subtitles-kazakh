Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.01,0:00:12.84,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:00:12.92,0:00:13.55,Default,,0,0,0,,(Жер қозғалысының дыбысы)
Dialogue: 0,0:00:13.55,0:00:15.26,Default,,0,0,0,,(Жер қозғалысының дыбысы)
Dialogue: 0,0:00:13.55,0:00:15.26,Default,,0,0,0,,Такуми, кел!
Dialogue: 0,0:00:18.93,0:00:20.31,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:00:22.18,0:00:23.18,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:00:23.85,0:00:26.44,Default,,0,0,0,,Допты әр уақытта әкелмейсің.
Dialogue: 0,0:00:28.02,0:00:30.44,Default,,0,0,0,,Күтілгендей, бұл ең жақсы!
Dialogue: 0,0:00:30.53,0:00:32.44,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:00:32.53,0:00:35.20,Default,,0,0,0,,Ой, доп осында тұрған сияқты.
Dialogue: 0,0:00:35.28,0:00:38.20,Default,,0,0,0,,Бұл не? Бұл графикалық роман сияқты.
Dialogue: 0,0:00:38.28,0:00:40.29,Default,,0,0,0,,Мен не айтуым керек?
Dialogue: 0,0:00:40.37,0:00:42.04,Default,,0,0,0,,О, мен сені келдім деп ойладым.
Dialogue: 0,0:00:42.12,0:00:43.75,Default,,0,0,0,,Жүрегім лүпілдеп, қызуым көтеріліп барады.
Dialogue: 0,0:00:43.83,0:00:44.71,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:00:44.79,0:00:46.75,Default,,0,0,0,,Жарайды, жеткілікті.
Dialogue: 0,0:00:46.83,0:00:48.50,Default,,0,0,0,,Әр доп туралы көп айтпа.
Dialogue: 0,0:00:48.59,0:00:49.75,Default,,0,0,0,,Сіз оны жеңе алмайсыз.
Dialogue: 0,0:00:49.84,0:00:50.96,Default,,0,0,0,,Тез оралыңыз
Dialogue: 0,0:00:51.05,0:00:52.26,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:00:53.67,0:00:55.05,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:00:56.63,0:00:57.47,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:00:59.89,0:01:00.72,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:01:00.81,0:01:01.89,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:01:03.60,0:01:05.98,Default,,0,0,0,,Ей, оны осылай қалдырайық.
Dialogue: 0,0:01:06.06,0:01:07.15,Default,,0,0,0,,О
Dialogue: 0,0:01:09.44,0:01:12.44,Default,,0,0,0,,Сіз қабылдау туралы хабарламаңызды ертең жібересіз бе?
Dialogue: 0,0:01:13.23,0:01:14.28,Default,,0,0,0,,О
Dialogue: 0,0:01:21.99,0:01:23.16,Default,,0,0,0,,Такуми
Dialogue: 0,0:01:23.24,0:01:27.17,Default,,0,0,0,,Сіз қисық допты меңгеруді жоспарлап отырсыз ба?
Dialogue: 0,0:01:29.33,0:01:31.54,Default,,0,0,0,,Мұны маған бұрын да атам айтқан.
Dialogue: 0,0:01:31.63,0:01:35.17,Default,,0,0,0,,Софтболды ұстап тұрып қисық допты лақтырмаңыз.
Dialogue: 0,0:01:35.88,0:01:38.22,Default,,0,0,0,,Фастбол жеткілікті.
Dialogue: 0,0:01:38.30,0:01:40.93,Default,,0,0,0,,Бұл орта мектептің бейсболында тамаша жұмыс істейтін еді.
Dialogue: 0,0:01:41.55,0:01:43.68,Default,,0,0,0,,Қисық шарларға сенбе
Dialogue: 0,0:01:44.35,0:01:45.43,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:01:46.02,0:01:49.31,Default,,0,0,0,,Денеңіз дайын болғанда оны міндетті түрде меңгеріңіз
Dialogue: 0,0:01:50.15,0:01:52.11,Default,,0,0,0,,Сіздің де осындай ниетіңіз болуы керек.
Dialogue: 0,0:01:53.15,0:01:58.15,Default,,0,0,0,,♪～
Dialogue: 0,0:03:17.94,0:03:22.95,Default,,0,0,0,,～♪
Dialogue: 0,0:03:27.87,0:03:29.50,Default,,0,0,0,,Бұл сіз бұрын сөйлескен адам.
Dialogue: 0,0:03:29.58,0:03:30.79,Default,,0,0,0,,Естеліктердің дәмі
Dialogue: 0,0:03:30.87,0:03:33.54,Default,,0,0,0,,Мынау анамның маған арнап жасаған кинпира лошаны.
Dialogue: 0,0:03:33.63,0:03:37.30,Default,,0,0,0,,А, иә, бұл сағыныш.
Dialogue: 0,0:03:39.96,0:03:40.80,Default,,0,0,0,,Не?
Dialogue: 0,0:03:41.55,0:03:44.93,Default,,0,0,0,,Тіркелу туралы хабарлама Ата-ана/қамқоршы атыңызды жазады
Dialogue: 0,0:03:45.01,0:03:46.39,Default,,0,0,0,,Бүгін жаз
Dialogue: 0,0:03:46.89,0:03:49.81,Default,,0,0,0,,Біраз күте тұрыңыз, бұл көзқараста не бар?
Dialogue: 0,0:03:49.89,0:03:53.19,Default,,0,0,0,,Неліктен сіз әрқашан басқаларға бұйрық бересіз?
Dialogue: 0,0:03:54.06,0:03:55.61,Default,,0,0,0,,Мен ешқандай бұйрық берген жоқпын.
Dialogue: 0,0:03:55.69,0:03:57.69,Default,,0,0,0,,Сонда сіз жақсылық сұрап тұрсыз ба?
Dialogue: 0,0:03:57.77,0:03:59.44,Default,,0,0,0,,Мен мұны сұраған жоқпын.
Dialogue: 0,0:04:00.11,0:04:02.45,Default,,0,0,0,,Мен бейсбол клубына қосылуды шештім.
Dialogue: 0,0:04:02.53,0:04:04.61,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:04:04.70,0:04:06.70,Default,,0,0,0,,Мен оны ұсынбаймын.
Dialogue: 0,0:04:06.78,0:04:09.33,Default,,0,0,0,,Макико, абай болыңыз.
Dialogue: 0,0:04:09.41,0:04:11.20,Default,,0,0,0,,Бір ғана тіркеу формасы
Dialogue: 0,0:04:11.29,0:04:12.71,Default,,0,0,0,,Неге сонша ашуланасың?
Dialogue: 0,0:04:12.79,0:04:14.50,Default,,0,0,0,,Әке, үндемеңіз!
Dialogue: 0,0:04:14.58,0:04:16.71,Default,,0,0,0,,Әрқашан осылай
Dialogue: 0,0:04:17.42,0:04:20.71,Default,,0,0,0,,Бейсбол клубына бармаймын десем не істер едің?
Dialogue: 0,0:04:20.80,0:04:23.59,Default,,0,0,0,,Ананың қарсылығы маңызды емес.
Dialogue: 0,0:04:23.68,0:04:25.68,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:04:25.76,0:04:28.22,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым, бірақ...
Dialogue: 0,0:04:28.85,0:04:31.81,Default,,0,0,0,,Лайлы киімді кім жуады?
Dialogue: 0,0:04:31.89,0:04:34.73,Default,,0,0,0,,Ойын барысында түскі қорапты кім жасайды?
Dialogue: 0,0:04:35.60,0:04:38.06,Default,,0,0,0,,Айналаңыздағылардың қолдауын сезіну
Dialogue: 0,0:04:38.15,0:04:40.23,Default,,0,0,0,,Кішкене болса жақсы емес пе?
Dialogue: 0,0:04:50.83,0:04:54.00,Default,,0,0,0,,Денеңіз дайын болғанда оны міндетті түрде меңгеріңіз
Dialogue: 0,0:04:54.83,0:04:56.75,Default,,0,0,0,,Сізде де осындай ниет болуы керек.
Dialogue: 0,0:05:03.72,0:05:05.51,Default,,0,0,0,,Тоқтауым керек пе?
Dialogue: 0,0:05:05.59,0:05:07.22,Default,,0,0,0,,Бейсбол
Dialogue: 0,0:05:09.47,0:05:10.60,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:13.06,0:05:14.81,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:14.89,0:05:18.02,Default,,0,0,0,,Сіз біреумен батарея жасап, оның лақтырғанын көргіңіз келе ме?
Dialogue: 0,0:05:19.81,0:05:21.40,Default,,0,0,0,,Шынымен
Dialogue: 0,0:05:21.98,0:05:24.40,Default,,0,0,0,,Осындай біртүрлі адамды кездестіру өте жақсы болды.
Dialogue: 0,0:05:41.79,0:05:43.88,Default,,0,0,0,,...
Dialogue: 0,0:05:44.51,0:05:47.93,Default,,0,0,0,,Сен, сенің мойныңдағы ілмек шығып тұр.
Dialogue: 0,0:05:49.47,0:05:50.51,Default,,0,0,0,,Сынып және аты қандай?
Dialogue: 0,0:05:51.22,0:05:52.60,Default,,0,0,0,,Хмм... жібер!
Dialogue: 0,0:05:56.73,0:05:57.60,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:06:01.65,0:06:03.65,Default,,0,0,0,,Такуми Харада?
Dialogue: 0,0:06:03.73,0:06:05.82,Default,,0,0,0,,Хмм, иә, бұл атау.
Dialogue: 0,0:06:05.90,0:06:08.53,Default,,0,0,0,,Сыртқы түрі де өте жақсы.
Dialogue: 0,0:06:09.24,0:06:11.49,Default,,0,0,0,,Мен көремін. Рахмет сізге.
Dialogue: 0,0:06:11.62,0:06:13.74,Default,,0,0,0,,Ал, ол жерге не кіреді?
Dialogue: 0,0:06:13.83,0:06:14.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:14.74,0:06:18.37,Default,,0,0,0,,Қалтаңда не бар екенін естідім.
Dialogue: 0,0:06:20.33,0:06:21.17,Default,,0,0,0,,Токарев
Dialogue: 0,0:06:22.88,0:06:24.55,Default,,0,0,0,,Байыппен жауап беріңіз
Dialogue: 0,0:06:25.21,0:06:26.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:28.51,0:06:31.18,Default,,0,0,0,,Ха, бұл үлкен Токарев.
Dialogue: 0,0:06:31.89,0:06:33.39,Default,,0,0,0,,Джагабута конейамон
Dialogue: 0,0:06:33.47,0:06:35.68,Default,,0,0,0,,Оны өзіңізбен бірге алып келмеуіңіз керек.
Dialogue: 0,0:06:36.27,0:06:38.18,Default,,0,0,0,,Бұл пайдасыз емес.
Dialogue: 0,0:06:40.10,0:06:41.94,Default,,0,0,0,,Кішкене қимыл жасайық
Dialogue: 0,0:06:47.69,0:06:48.57,Default,,0,0,0,,Хмм…
Dialogue: 0,0:06:52.91,0:06:55.28,Default,,0,0,0,,Курткаңызды шешіңіз.
Dialogue: 0,0:07:10.97,0:07:13.80,Default,,0,0,0,,Иә, бұлшықетті қалай құру керектігін анықтаңыз.
Dialogue: 0,0:07:15.51,0:07:18.89,Default,,0,0,0,,Бұл көп жүгіру.
Dialogue: 0,0:07:19.52,0:07:21.64,Default,,0,0,0,,5-6 км болады деп ойлаймын.
Dialogue: 0,0:07:21.73,0:07:24.65,Default,,0,0,0,,Созылу да аздап жалқау.
Dialogue: 0,0:07:24.73,0:07:27.48,Default,,0,0,0,,Дегенмен, мен қисық шарлар туралы әлі білмеймін.
Dialogue: 0,0:07:27.57,0:07:29.57,Default,,0,0,0,,Харада сияқты нәрсе
Dialogue: 0,0:07:29.65,0:07:31.15,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:07:32.03,0:07:34.16,Default,,0,0,0,,Маған кім үйретсе де, құлағым естімейтін.
Dialogue: 0,0:07:34.24,0:07:35.28,Default,,0,0,0,,Кез келген адамға
Dialogue: 0,0:07:35.37,0:07:39.16,Default,,0,0,0,,Менің бейсбол тәжірибесі жоқ сияқты.
Dialogue: 0,0:07:39.25,0:07:42.21,Default,,0,0,0,,Мен бейсболдан жастар құрамасында болдым.
Dialogue: 0,0:07:42.29,0:07:44.04,Default,,0,0,0,,Бірақ жүгіру т.б.
Dialogue: 0,0:07:44.13,0:07:46.50,Default,,0,0,0,,Мен мұны өз еркіммен жасадым.
Dialogue: 0,0:07:46.59,0:07:48.96,Default,,0,0,0,,Жалпы... сіз тек бірінші курс студенті болсаңыз да.
Dialogue: 0,0:07:49.05,0:07:50.67,Default,,0,0,0,,Бұл тамаша көзқарас.
Dialogue: 0,0:07:50.76,0:07:52.43,Default,,0,0,0,,Аздап ойланыңыз.
Dialogue: 0,0:07:53.05,0:07:54.47,Default,,0,0,0,,Допты қайтарыңыз.
Dialogue: 0,0:07:54.55,0:07:57.43,Default,,0,0,0,,Мектеп өміріне қатысы жоқ заттар
Dialogue: 0,0:07:57.51,0:08:00.68,Default,,0,0,0,,Барлық заттар мектеп ережелерін бұзатын заттар ретінде жойылады.
Dialogue: 0,0:08:00.77,0:08:03.69,Default,,0,0,0,,Оны қайтарыңыз. Қарым-қатынас бар.
Dialogue: 0,0:08:11.28,0:08:15.24,Default,,0,0,0,,Үйірмеге келгеніме көп уақыт болды.
Dialogue: 0,0:08:15.32,0:08:17.41,Default,,0,0,0,,Бейсбол клубына қосылыңыз
Dialogue: 0,0:08:17.49,0:08:19.54,Default,,0,0,0,,Допты иемдену құқық бұзушылық болып табылмайды.
Dialogue: 0,0:08:19.62,0:08:21.16,Default,,0,0,0,,Бұл логика ма?
Dialogue: 0,0:08:21.25,0:08:22.71,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:08:22.79,0:08:26.42,Default,,0,0,0,,Сіз мұндай ақымақтыққа жол беретіндей аңғал емессіз.
Dialogue: 0,0:08:27.84,0:08:29.84,Default,,0,0,0,,Оны ешқашан қалтаңыздан шығармаңыз.
Dialogue: 0,0:08:30.42,0:08:32.80,Default,,0,0,0,,Дәлізде қармақ ойнама.
Dialogue: 0,0:08:33.42,0:08:35.43,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:35.51,0:08:38.35,Default,,0,0,0,,Мен дәлізде қармақ ойнай алмаймын деп ойладым.
Dialogue: 0,0:08:38.43,0:08:40.26,Default,,0,0,0,,Кейде
Dialogue: 0,0:08:40.35,0:08:44.10,Default,,0,0,0,,Әлгі ақымақ дәлізге доп лақтырып стақанды сындырды.
Dialogue: 0,0:08:45.10,0:08:48.27,Default,,0,0,0,,Допты лақтыру арқылы ойнағың келсе, мұны істеуге болатын шығар.
Dialogue: 0,0:08:48.36,0:08:50.11,Default,,0,0,0,,Ұстау ойын емес, солай ма?
Dialogue: 0,0:08:53.49,0:08:57.87,Default,,0,0,0,,Мүлдем... Бұл туралы мұндай үлкен мәміле жасайтын адам сирек.
Dialogue: 0,0:08:57.95,0:09:00.45,Default,,0,0,0,,Жарайды, сыныпқа қайт.
Dialogue: 0,0:09:01.70,0:09:02.70,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:13.59,0:09:15.09,Default,,0,0,0,,- (Ау) Такуми - (Такуми) Иә?
Dialogue: 0,0:09:21.97,0:09:23.10,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:09:23.18,0:09:26.35,Default,,0,0,0,,Мен сізді қызметкерлер бөлмесіне сүйреп апарғанын естідім.
Dialogue: 0,0:09:26.44,0:09:27.60,Default,,0,0,0,,Не болып жатқанын көруге келсең
Dialogue: 0,0:09:27.69,0:09:30.02,Default,,0,0,0,,Қанша адам күліп тұр?
Dialogue: 0,0:09:30.11,0:09:32.40,Default,,0,0,0,,Сіз күлдіңіз бе? Мен?
Dialogue: 0,0:09:32.48,0:09:33.57,Default,,0,0,0,,Сіз солсыз
Dialogue: 0,0:09:33.65,0:09:35.74,Default,,0,0,0,,Харада күткендей.
Dialogue: 0,0:09:35.82,0:09:37.99,Default,,0,0,0,,Отомрай сізге дәріс оқыды, солай ма?
Dialogue: 0,0:09:38.07,0:09:41.37,Default,,0,0,0,,Сондықтан мен күліп тұрмын. Мен әсер алдым. Мен әсер алдым.
Dialogue: 0,0:09:42.20,0:09:43.45,Default,,0,0,0,,Отомрай?
Dialogue: 0,0:09:43.95,0:09:47.12,Default,,0,0,0,,Дұрыс, Томура Сенсейдің лақап аты.
Dialogue: 0,0:09:47.21,0:09:48.17,Default,,0,0,0,,Мен бейсбол клубының кеңесшісімін...
Dialogue: 0,0:09:48.17,0:09:49.42,Default,,0,0,0,,Мен бейсбол клубының кеңесшісімін...
Dialogue: 0,0:09:48.17,0:09:49.42,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:49.42,0:09:49.50,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:49.50,0:09:50.63,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:49.50,0:09:50.63,Default,,0,0,0,,Ах
Dialogue: 0,0:09:56.97,0:09:59.84,Default,,0,0,0,,Біртүрлі мұңды нәрсе, солай емес пе?
Dialogue: 0,0:09:59.93,0:10:01.89,Default,,0,0,0,,Көңілсіз емес.
Dialogue: 0,0:10:01.97,0:10:05.39,Default,,0,0,0,,Бұл өте көңілді емес, вице-капитан.
Dialogue: 0,0:10:05.47,0:10:06.64,Default,,0,0,0,,Вице-капитан?
Dialogue: 0,0:10:07.39,0:10:09.52,Default,,0,0,0,,Бұл бейсбол клубынан емес шығар.
Dialogue: 0,0:10:09.60,0:10:11.11,Default,,0,0,0,,Бейсбол клубы
Dialogue: 0,0:10:11.69,0:10:14.28,Default,,0,0,0,,Нобиниши, №3 ұстаушы
Dialogue: 0,0:10:14.36,0:10:15.78,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:25.45,0:10:26.79,Default,,0,0,0,,Құсанағы мырза
Dialogue: 0,0:10:26.87,0:10:28.00,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:10:28.08,0:10:31.63,Default,,0,0,0,,Отаку сыныбына арналған студенттер сауалнамасын көре аламын ба?
Dialogue: 0,0:10:31.71,0:10:33.34,Default,,0,0,0,,А, жақсы
Dialogue: 0,0:10:35.76,0:10:37.30,Default,,0,0,0,,Міне
Dialogue: 0,0:10:40.13,0:10:41.39,Default,,0,0,0,,Не?
Dialogue: 0,0:10:41.47,0:10:44.85,Default,,0,0,0,,Өзін-өзі толтыруға келетін болсақ, мен ештеңе жазудың қажеті жоқ.
Dialogue: 0,0:10:45.39,0:10:48.60,Default,,0,0,0,,Хоббилер Арнайы дағдылар Сүйікті пәндер...
Dialogue: 0,0:10:48.68,0:10:51.60,Default,,0,0,0,,Мен тіпті ең маңызды достарым туралы жазғым да келмейді.
Dialogue: 0,0:10:51.69,0:10:52.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:53.40,0:10:55.57,Default,,0,0,0,,Директор Иока
Dialogue: 0,0:10:55.65,0:10:58.03,Default,,0,0,0,,Директор Иока
Dialogue: 0,0:10:58.11,0:11:01.53,Default,,0,0,0,,Иока мырза, Нитта орта мектебінің бейсбол командасының менеджері?
Dialogue: 0,0:11:01.61,0:11:05.33,Default,,0,0,0,,Иә, бұрынғы бала Иока мырзаның немересі сияқты.
Dialogue: 0,0:11:05.41,0:11:07.70,Default,,0,0,0,,Енді ойлап қарасам, Томура-сенсей де.
Dialogue: 0,0:11:07.79,0:11:10.50,Default,,0,0,0,,Ол Nitta бейсбол клубының түлегі болды.
Dialogue: 0,0:11:10.58,0:11:13.08,Default,,0,0,0,,Жаттықтырушы Иокаға сабақ беруде қиындықтар болды ма?
Dialogue: 0,0:11:13.17,0:11:14.34,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:11:14.42,0:11:16.38,Default,,0,0,0,,Бірақ мен орта мектептің екінші курсында оқып жүрген кезімде
Dialogue: 0,0:11:16.46,0:11:19.34,Default,,0,0,0,,Директор кенеттен қызметінен кетті.
Dialogue: 0,0:11:19.42,0:11:23.22,Default,,0,0,0,,Біз үлкен түлектер емеспіз.
Dialogue: 0,0:11:23.93,0:11:30.35,Default,,0,0,0,,(мүшелердің айқайы)
Dialogue: 0,0:11:40.78,0:11:42.61,Default,,0,0,0,,Полковник!
Dialogue: 0,0:11:47.79,0:11:49.75,Default,,0,0,0,,Капитан Кайондзи-сан.
Dialogue: 0,0:11:50.71,0:11:54.63,Default,,0,0,0,,Бүгіннен бастап біз жоспарланғандай толыққанды орынды қағуды бастаймыз.
Dialogue: 0,0:11:55.21,0:11:59.76,Default,,0,0,0,,Ойын екі топқа бөлінеді, бірінші курс студенттері сырт алаңда доптарды алады.
Dialogue: 0,0:11:59.84,0:12:03.34,Default,,0,0,0,,Қажетсіз әңгімеге араласпаңыз немесе отырмаңыз.
Dialogue: 0,0:12:03.84,0:12:05.64,Default,,0,0,0,,Жақсы ма, директор?
Dialogue: 0,0:12:05.72,0:12:08.64,Default,,0,0,0,,Мұны жай ғана жаттығу жұмысы деп атайық.
Dialogue: 0,0:12:08.72,0:12:10.98,Default,,0,0,0,,Осының алдында...
Dialogue: 0,0:12:11.06,0:12:11.89,Default,,0,0,0,,Харада
Dialogue: 0,0:12:11.98,0:12:12.89,Default,,0,0,0,,Иә
Dialogue: 0,0:12:13.48,0:12:14.40,Default,,0,0,0,,Қорғанға барыңыз
Dialogue: 0,0:12:14.48,0:12:16.81,Default,,0,0,0,,(клуб мүшелерінің музыкасы)
Dialogue: 0,0:12:16.90,0:12:18.15,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:12:18.23,0:12:21.15,Default,,0,0,0,,Құмыраны болғысы келетін басқаларға ойын ойнауға рұқсат етіледі.
Dialogue: 0,0:12:21.24,0:12:23.65,Default,,0,0,0,,Біріншіден, бұл Харада.
Dialogue: 0,0:12:23.74,0:12:26.41,Default,,0,0,0,,Теннис алыңыз.
Dialogue: 0,0:12:27.07,0:12:28.20,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:12:28.74,0:12:31.00,Default,,0,0,0,,Такуми, қолыңнан келгеннің бәрін істе
Dialogue: 0,0:12:38.84,0:12:41.46,Default,,0,0,0,,Жарайды, таста, Харада.
Dialogue: 0,0:12:45.51,0:12:47.18,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:12:51.93,0:12:53.85,Default,,0,0,0,,А...
Dialogue: 0,0:12:53.93,0:12:54.77,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:12:59.52,0:13:00.36,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:13:13.91,0:13:16.50,Default,,0,0,0,,Хаясе Харада
Dialogue: 0,0:13:22.38,0:13:24.30,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,0:13:24.38,0:13:25.42,Default,,0,0,0,,(клуб мүшелерінің музыкасы)
Dialogue: 0,0:13:25.51,0:13:26.59,Default,,0,0,0,,Эй
Dialogue: 0,0:13:27.97,0:13:29.80,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:13:32.81,0:13:35.56,Default,,0,0,0,,Кешіріңіз, қолым тайып кетті.
Dialogue: 0,0:13:38.23,0:13:40.98,Default,,0,0,0,,Мұғалім, үзіліс жасаңыз.
Dialogue: 0,0:13:41.07,0:13:43.40,Default,,0,0,0,,О, абай бол.
Dialogue: 0,0:13:45.65,0:13:49.07,Default,,0,0,0,,Егер солай болса, мен оны аламын.
Dialogue: 0,0:13:50.41,0:13:51.49,Default,,0,0,0,,Директор
Dialogue: 0,0:13:52.66,0:13:54.45,Default,,0,0,0,,Егер ұстаушы
Dialogue: 0,0:13:54.54,0:13:57.33,Default,,0,0,0,,Маған лақтыруды жеңілдете аласыз ба?
Dialogue: 0,0:13:57.41,0:13:59.08,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:59.17,0:14:01.25,Default,,0,0,0,,Харада, сені шығарып алу үшін.
Dialogue: 0,0:14:01.34,0:14:03.00,Default,,0,0,0,,Сіз бұл допты әдейі лақтырдыңыз ба?
Dialogue: 0,0:14:03.09,0:14:05.09,Default,,0,0,0,,Ақылсыз сөз айтпа
Dialogue: 0,0:14:05.17,0:14:07.22,Default,,0,0,0,,Бірақ мен ойладым...
Dialogue: 0,0:14:07.30,0:14:09.72,Default,,0,0,0,,Ойлан, дауыстап айтпа
Dialogue: 0,0:14:09.80,0:14:11.18,Default,,0,0,0,,Саваға да айтпа
Dialogue: 0,0:14:11.26,0:14:12.47,Default,,0,0,0,,Нагакура
Dialogue: 0,0:14:12.56,0:14:13.47,Default,,0,0,0,,Иә
Dialogue: 0,0:14:13.56,0:14:17.23,Default,,0,0,0,,Егер Харада сізді ұсынса, Тензайға ауысыңыз.
Dialogue: 0,0:14:17.31,0:14:21.15,Default,,0,0,0,,Иә, қорғаушыларыңыз бен леггинстеріңізді қарызға аламын ба?
Dialogue: 0,0:14:29.45,0:14:30.91,Default,,0,0,0,,Дайын
Dialogue: 0,0:14:32.70,0:14:33.66,Default,,0,0,0,,Такуми
Dialogue: 0,0:14:36.50,0:14:38.33,Default,,0,0,0,,Жасайық, Жүр.
Dialogue: 0,0:14:38.83,0:14:41.50,Default,,0,0,0,,Бұл менің орта мектептегі бейсболдағы дебютім.
Dialogue: 0,0:14:43.29,0:14:47.05,Default,,0,0,0,,Әй, басынан бастап бар күшіңмен лақтыр.
Dialogue: 0,0:14:47.92,0:14:48.97,Default,,0,0,0,,Әрине
Dialogue: 0,0:15:13.99,0:15:15.41,Default,,0,0,0,,Хо…
Dialogue: 0,0:15:15.49,0:15:17.91,Default,,0,0,0,,Оны дәл қазіргідей жерге лақтырып көріңіз.
Dialogue: 0,0:15:21.75,0:15:22.79,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:15:24.75,0:15:26.05,Default,,0,0,0,,Кайондзи храмы
Dialogue: 0,0:15:26.13,0:15:27.96,Default,,0,0,0,,Қамырға арналған жәшікте тұру
Dialogue: 0,0:15:28.05,0:15:29.09,Default,,0,0,0,,Сіз соғып жатырсыз ба?
Dialogue: 0,0:15:29.17,0:15:31.18,Default,,0,0,0,,Соқ, тұр.
Dialogue: 0,0:15:31.26,0:15:32.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:34.01,0:15:35.30,Default,,0,0,0,,Бір сәт!
Dialogue: 0,0:15:35.39,0:15:37.60,Default,,0,0,0,,Такуми, сен жақсысың.
Dialogue: 0,0:15:37.68,0:15:39.43,Default,,0,0,0,,Қатты келетін әдеттегі доп.
Dialogue: 0,0:15:39.52,0:15:42.02,Default,,0,0,0,,Соны айту үшін осынша жол жүрдің бе?
Dialogue: 0,0:15:42.10,0:15:42.94,Default,,0,0,0,,Сукуна соған тұрарлық.
Dialogue: 0,0:15:43.02,0:15:46.15,Default,,0,0,0,,Жарайды, келесі курсты айтамын.
Dialogue: 0,0:15:46.23,0:15:47.07,Default,,0,0,0,,Алмаңыз
Dialogue: 0,0:15:58.66,0:15:59.50,Default,,0,0,0,,(шыңырау дыбысы)
Dialogue: 0,0:16:01.75,0:16:02.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:12.01,0:16:14.68,Default,,0,0,0,,Иә, Такуми ең жақсы!
Dialogue: 0,0:16:16.47,0:16:18.14,Default,,0,0,0,,(Жер қозғалысының дыбысы)
Dialogue: 0,0:16:21.93,0:16:22.94,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:23.02,0:16:24.23,Default,,0,0,0,,Иә, қазірдің өзінде.
Dialogue: 0,0:16:24.77,0:16:26.40,Default,,0,0,0,,Иә
Dialogue: 0,0:16:28.07,0:16:29.94,Default,,0,0,0,,Мен жалпы ойды түсіндім.
Dialogue: 0,0:16:30.03,0:16:32.82,Default,,0,0,0,,Екеуің сырт алаңға шығып, допты алыңдар.
Dialogue: 0,0:16:32.90,0:16:35.70,Default,,0,0,0,,- (Австралия) Бірақ... - (Томура) Нагакура Алаңдамаңыз.
Dialogue: 0,0:16:35.78,0:16:38.45,Default,,0,0,0,,Балалар, сендер әлі бірінші курс студенттерісіңдер.
Dialogue: 0,0:16:38.53,0:16:41.25,Default,,0,0,0,,Нұсқауларды орындаңыз Түсіндіңіз бе?
Dialogue: 0,0:16:41.91,0:16:42.87,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:16:42.96,0:16:46.96,Default,,0,0,0,,Биыл бір топ арсыз адамдар жиналды.
Dialogue: 0,0:16:48.63,0:16:51.26,Default,,0,0,0,,Сіз қолданып көргіңіз келетін тағы біреу бар ма?
Dialogue: 0,0:16:52.42,0:16:55.80,Default,,0,0,0,,Олай болса, орындық қағуға көшейік.
Dialogue: 0,0:16:55.88,0:16:57.97,Default,,0,0,0,,Харада, мұнда кел.
Dialogue: 0,0:17:00.31,0:17:03.23,Default,,0,0,0,,Харада, лақтыруды тоқтатыңыз.
Dialogue: 0,0:17:03.31,0:17:06.73,Default,,0,0,0,,Жасыңызда артық салмақ тастамаңыз.
Dialogue: 0,0:17:06.81,0:17:09.61,Default,,0,0,0,,Бұдан былай мен төменгі денемді күшейтемін.
Dialogue: 0,0:17:09.69,0:17:12.48,Default,,0,0,0,,...
Dialogue: 0,0:17:12.57,0:17:13.61,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:13.69,0:17:16.24,Default,,0,0,0,,Олай болса, шынын айту керек, Харада.
Dialogue: 0,0:17:16.32,0:17:18.99,Default,,0,0,0,,...
Dialogue: 0,0:17:19.07,0:17:22.49,Default,,0,0,0,,...
Dialogue: 0,0:17:22.58,0:17:25.37,Default,,0,0,0,,Дегенмен, талантыңды шыңдамасаң
Dialogue: 0,0:17:25.46,0:17:27.25,Default,,0,0,0,,Мұның бәрі бар.
Dialogue: 0,0:17:27.83,0:17:29.00,Default,,0,0,0,,Сен! Бұл қалай батылдық!
Dialogue: 0,0:17:29.08,0:17:30.25,Default,,0,0,0,,Иә
Dialogue: 0,0:17:30.34,0:17:31.75,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:17:31.84,0:17:33.26,Default,,0,0,0,,бастайық...
Dialogue: 0,0:17:34.72,0:17:38.14,Default,,0,0,0,,...
Dialogue: 0,0:17:38.22,0:17:40.39,Default,,0,0,0,,Шашыңызды дұрыс қиыңыз!
Dialogue: 0,0:17:43.68,0:17:46.39,Default,,0,0,0,,...
Dialogue: 0,0:17:47.35,0:17:48.65,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:48.73,0:17:51.65,Default,,0,0,0,,...
Dialogue: 0,0:17:52.23,0:17:54.86,Default,,0,0,0,,...
Dialogue: 0,0:17:54.94,0:17:56.65,Default,,0,0,0,,Нұсқауларды орындаңыз
Dialogue: 0,0:17:57.28,0:17:59.66,Default,,0,0,0,,...
Dialogue: 0,0:17:59.74,0:18:02.91,Default,,0,0,0,,Ақымақ! Неліктен сенде мұндай жаман мінез бар?
Dialogue: 0,0:18:02.99,0:18:05.04,Default,,0,0,0,,...
Dialogue: 0,0:18:05.12,0:18:06.66,Default,,0,0,0,,Қайдағы тәртіпсіздік?
Dialogue: 0,0:18:07.25,0:18:08.62,Default,,0,0,0,,Сіздің шашыңыз қанша?
Dialogue: 0,0:18:08.71,0:18:11.42,Default,,0,0,0,,...
Dialogue: 0,0:18:11.50,0:18:13.96,Default,,0,0,0,,Мүлдем мағынасы жоқ.
Dialogue: 0,0:18:16.38,0:18:19.34,Default,,0,0,0,,Шаш ал, қырылған бассың.
Dialogue: 0,0:18:19.43,0:18:21.76,Default,,0,0,0,,Мен сендерді киіндірейін.
Dialogue: 0,0:18:22.26,0:18:25.93,Default,,0,0,0,,...
Dialogue: 0,0:18:26.93,0:18:27.89,Default,,0,0,0,,Иә
Dialogue: 0,0:18:30.19,0:18:32.06,Default,,0,0,0,,Сырттағы алаңға барыңыз
Dialogue: 0,0:18:35.65,0:18:37.32,Default,,0,0,0,,Жаттығу
Dialogue: 0,0:18:37.40,0:18:39.32,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:18:39.40,0:18:41.16,Default,,0,0,0,,Отомрай, бұл қорқынышты болды.
Dialogue: 0,0:18:41.24,0:18:43.08,Default,,0,0,0,,Хехе, мүмкін емес.
Dialogue: 0,0:18:45.79,0:18:48.87,Default,,0,0,0,,...
Dialogue: 0,0:18:48.96,0:18:50.08,Default,,0,0,0,,Барма
Dialogue: 0,0:18:51.29,0:18:52.84,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:52.92,0:18:54.84,Default,,0,0,0,,Ол уайымдаушы.
Dialogue: 0,0:18:55.55,0:18:58.84,Default,,0,0,0,,...
Dialogue: 0,0:18:58.92,0:19:00.51,Default,,0,0,0,,Дұрыс, Харада.
Dialogue: 0,0:19:00.59,0:19:04.05,Default,,0,0,0,,...
Dialogue: 0,0:19:04.14,0:19:06.60,Default,,0,0,0,,...
Dialogue: 0,0:19:06.68,0:19:09.98,Default,,0,0,0,,...
Dialogue: 0,0:19:10.06,0:19:11.60,Default,,0,0,0,,Хараданың мүмкіндігі болады.
Dialogue: 0,0:19:11.69,0:19:13.69,Default,,0,0,0,,Дұрыс, қартайайық.
Dialogue: 0,0:19:13.77,0:19:14.73,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:19:15.44,0:19:18.28,Default,,0,0,0,,Эй, күте тұрыңыз, бұл сіздің мүмкіндігіңіз болуы мүмкін.
Dialogue: 0,0:19:18.36,0:19:20.36,Default,,0,0,0,,Ақымақ болма, Бар.
Dialogue: 0,0:19:20.45,0:19:23.62,Default,,0,0,0,,Ақымақ болма, қалжыңдама.
Dialogue: 0,0:19:23.70,0:19:25.12,Default,,0,0,0,,Сіз мұны айтып тұрған жоқсыз ба?
Dialogue: 0,0:19:25.20,0:19:27.70,Default,,0,0,0,,Мен байсалдымын, сен ақымақсың.
Dialogue: 0,0:19:27.79,0:19:28.91,Default,,0,0,0,,Отомрай т.б.
Dialogue: 0,0:19:29.00,0:19:31.21,Default,,0,0,0,,Тіпті шашымның ұзындығын да мазақ етті
Dialogue: 0,0:19:31.29,0:19:33.13,Default,,0,0,0,,Бәрі мен қалағандай болады деп үміттенемін.
Dialogue: 0,0:19:33.21,0:19:35.29,Default,,0,0,0,,Мен осылай айтамын.
Dialogue: 0,0:19:35.38,0:19:38.26,Default,,0,0,0,,Егер сіз менің ойынға қатысқанымды қаламасаңыз, мен оны неге істеймін?
Dialogue: 0,0:19:38.34,0:19:40.76,Default,,0,0,0,,Матч ойнауға қатысты емес.
Dialogue: 0,0:19:40.84,0:19:42.30,Default,,0,0,0,,Ол шығады деп ойлаймын.
Dialogue: 0,0:19:42.80,0:19:44.89,Default,,0,0,0,,Тіпті Отомрай
Dialogue: 0,0:19:44.97,0:19:48.52,Default,,0,0,0,,Префектуралық және республикалық турнирлерге барғыңыз келмейді ме?
Dialogue: 0,0:19:48.60,0:19:50.77,Default,,0,0,0,,Ойында жеңгіңіз келсе
Dialogue: 0,0:19:50.85,0:19:53.15,Default,,0,0,0,,Бұл сізді пайдалансам көмектесе алмайтынын білдіре ме?
Dialogue: 0,0:19:53.23,0:19:54.56,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:19:55.81,0:19:57.27,Default,,0,0,0,,Джададо Харада
Dialogue: 0,0:19:57.36,0:19:59.32,Default,,0,0,0,,Отомрай жеңсе, менің ойымша.
Dialogue: 0,0:19:59.40,0:20:00.78,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:20:00.86,0:20:02.28,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:20:02.36,0:20:04.82,Default,,0,0,0,,Харада тым тәкаппар.
Dialogue: 0,0:20:04.91,0:20:08.79,Default,,0,0,0,,Маған матчта жеңілгенім маңызды емес, сондықтан мен сізді пайдаланамын деп ойлауым мүмкін.
Dialogue: 0,0:20:08.87,0:20:10.12,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:20:10.20,0:20:12.83,Default,,0,0,0,,Топтық жұмысты бұзсаңыз,
Dialogue: 0,0:20:12.92,0:20:16.54,Default,,0,0,0,,Егер сіз матчқа қатыса алмасаңыз, алаңдамаңыз.
Dialogue: 0,0:20:17.25,0:20:18.67,Default,,0,0,0,,Ол шықпайды.
Dialogue: 0,0:20:18.75,0:20:19.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:19.92,0:20:21.67,Default,,0,0,0,,Матчқа қатысудың қажеті жоқ
Dialogue: 0,0:20:22.59,0:20:24.18,Default,,0,0,0,,«Шығудың қажеті жоқ»...
Dialogue: 0,0:20:24.26,0:20:27.01,Default,,0,0,0,,Бұл сенсің, биыл ғана.
Dialogue: 0,0:20:27.10,0:20:28.89,Default,,0,0,0,,Келесі жылы да шыға алмай қалуым мүмкін.
Dialogue: 0,0:20:28.97,0:20:30.10,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:30.18,0:20:32.35,Default,,0,0,0,,Мен сондай біреудің мейіріміне бөленгім келеді.
Dialogue: 0,0:20:32.43,0:20:34.14,Default,,0,0,0,,Ойынға бармаған дұрыс
Dialogue: 0,0:20:34.77,0:20:35.81,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:20:36.90,0:20:38.32,Default,,0,0,0,,Йомо Міне!
Dialogue: 0,0:20:38.40,0:20:39.11,Default,,0,0,0,,Ойынға неге бармайсың? Ақымақ болма
Dialogue: 0,0:20:39.11,0:20:41.07,Default,,0,0,0,,Ойынға неге бармайсың? Ақымақ болма
Dialogue: 0,0:20:39.11,0:20:41.07,Default,,0,0,0,,- (Савагучи) Жүр! -(Хигашия) Тоқта, кет.
Dialogue: 0,0:20:41.15,0:20:44.07,Default,,0,0,0,,Адамдарға тіл тигізуге болмайды!
Dialogue: 0,0:20:44.15,0:20:46.57,Default,,0,0,0,,Бар, тоқта, Харада өледі.
Dialogue: 0,0:20:46.66,0:20:48.28,Default,,0,0,0,,Кет, жібер!
Dialogue: 0,0:20:50.54,0:20:51.75,Default,,0,0,0,,Гррр…
Dialogue: 0,0:20:51.83,0:20:56.92,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:20:59.13,0:21:00.50,Default,,0,0,0,,Сіз
Dialogue: 0,0:21:02.09,0:21:03.47,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:21:25.99,0:21:30.99,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.24,0:22:55.91,Default,,0,0,0,,～♪
