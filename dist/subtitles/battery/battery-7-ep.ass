Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.63,0:00:14.84,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:17.43,0:00:18.35,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:18.43,0:00:20.02,Default,,0,0,0,,Такуми!
Dialogue: 0,0:00:23.85,0:00:25.77,Default,,0,0,0,,Неліктен дәл сол допты лақтырмадың?
Dialogue: 0,0:00:26.81,0:00:27.77,Default,,0,0,0,,Мен оны лақтырдым
Dialogue: 0,0:00:27.86,0:00:31.28,Default,,0,0,0,,Өтірікші Бұл доп үйге жүгіру болады!
Dialogue: 0,0:00:38.45,0:00:39.99,Default,,0,0,0,,Шынымен…
Dialogue: 0,0:00:40.08,0:00:42.79,Default,,0,0,0,,Мені ұстамаймын деп өз күшіңді ұстап қалдың ба?
Dialogue: 0,0:00:44.91,0:00:45.96,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:00:46.04,0:00:48.54,Default,,0,0,0,,Мен сенің ұстап алуыңа алаңдауым керек.
Dialogue: 0,0:00:48.63,0:00:50.63,Default,,0,0,0,,Олай болса неліктен ұрып қалдың?
Dialogue: 0,0:00:54.01,0:00:56.01,Default,,0,0,0,,Айтудың қандай тамаша тәсілі.
Dialogue: 0,0:00:56.09,0:00:58.60,Default,,0,0,0,,Бірақ мен де солай сезінемін.
Dialogue: 0,0:00:58.68,0:01:02.10,Default,,0,0,0,,4-ші қадам Бұл шынымен де жеңісті алаң болды ма?
Dialogue: 0,0:01:03.89,0:01:07.02,Default,,0,0,0,,Кадоваки мырза, жаттығу матчын өткізіңіз.
Dialogue: 0,0:01:07.10,0:01:09.06,Default,,0,0,0,,Қайталап көріңіз.
Dialogue: 0,0:01:09.15,0:01:12.44,Default,,0,0,0,,Эй, Кадоваки, жаттығу матчын өткізіп жатырсың ба?
Dialogue: 0,0:01:12.94,0:01:15.07,Default,,0,0,0,,Сіз сол жерден өтініш бере аласыз ба?
Dialogue: 0,0:01:15.78,0:01:17.95,Default,,0,0,0,,Бұл жолы мен сызып тастаймын.
Dialogue: 0,0:01:18.78,0:01:20.24,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:20.74,0:01:24.08,Default,,0,0,0,,Бұл жолы мені ешкім ұрмайды.
Dialogue: 0,0:01:24.16,0:01:27.17,Default,,0,0,0,,Сіз мен үшін тамаша жұмыс жасайсыз.
Dialogue: 0,0:01:27.67,0:01:29.21,Default,,0,0,0,,Сіз мұны айтып тұрсыз ба?
Dialogue: 0,0:01:29.29,0:01:32.46,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:01:32.55,0:01:35.80,Default,,0,0,0,,Кайонжи Бұл қандай балалар?
Dialogue: 0,0:01:35.88,0:01:38.59,Default,,0,0,0,,Бұл Ниттаның бірінші жылы болды, сондықтан сіз әдепсіз болып жатырсыз.
Dialogue: 0,0:01:38.68,0:01:41.47,Default,,0,0,0,,Жоқ, бұл балалар ерекше.
Dialogue: 0,0:01:44.47,0:01:47.02,Default,,0,0,0,,Жарайды, мен қанша жүрерімді білмеймін.
Dialogue: 0,0:01:47.10,0:01:48.48,Default,,0,0,0,,Көбейтіп көріңіз
Dialogue: 0,0:01:48.56,0:01:50.86,Default,,0,0,0,,Шынымен, рахмет.
Dialogue: 0,0:01:50.94,0:01:53.11,Default,,0,0,0,,Толық мәліметтер кейінірек
Dialogue: 0,0:01:54.07,0:01:57.61,Default,,0,0,0,,Маған сенің де, бұл жағдайдың да қатысы жоқ.
Dialogue: 0,0:02:00.07,0:02:05.08,Default,,0,0,0,,♪～
Dialogue: 0,0:03:24.53,0:03:29.54,Default,,0,0,0,,～♪
Dialogue: 0,0:03:49.43,0:03:50.35,Default,,0,0,0,,Харада
Dialogue: 0,0:03:50.43,0:03:51.35,Default,,0,0,0,,Иә
Dialogue: 0,0:03:51.43,0:03:53.69,Default,,0,0,0,,Эй, неге Кадовакиге төртінші қадам керек?
Dialogue: 0,0:03:53.77,0:03:55.98,Default,,0,0,0,,Күш басылды және лақтырылды
Dialogue: 0,0:03:56.69,0:04:00.49,Default,,0,0,0,,Эй Нагакура, сен бұл допты ұстай алмайсың деп ойлаймын.
Dialogue: 0,0:04:01.07,0:04:03.99,Default,,0,0,0,,Сізге зиян тигізуі мүмкін деп ойладыңыз ба?
Dialogue: 0,0:04:04.07,0:04:07.24,Default,,0,0,0,,Қалай болғанда да, Нагакура есеңгіреп қалады.
Dialogue: 0,0:04:07.33,0:04:09.49,Default,,0,0,0,,Маған опасыздық жасалды
Dialogue: 0,0:04:09.58,0:04:12.71,Default,,0,0,0,,Мен Нагакураға неге сене алмадым?
Dialogue: 0,0:04:12.79,0:04:13.62,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:04:13.71,0:04:16.25,Default,,0,0,0,,Денеме тисе де, ол доп тоқтайды.
Dialogue: 0,0:04:16.33,0:04:19.63,Default,,0,0,0,,Олай болса, келесі жолы сіз допты ұстап алған болуыңыз керек.
Dialogue: 0,0:04:19.71,0:04:22.72,Default,,0,0,0,,Сіз бұлай сене алмадыңыз ба?
Dialogue: 0,0:04:23.88,0:04:26.09,Default,,0,0,0,,Сіз шынымен баласыз.
Dialogue: 0,0:04:26.18,0:04:28.81,Default,,0,0,0,,Бейсбол ойынының негіздерін түсінбейсіз бе?
Dialogue: 0,0:04:28.89,0:04:30.39,Default,,0,0,0,,Кайондзи храмы
Dialogue: 0,0:04:30.47,0:04:33.06,Default,,0,0,0,,Бұл жігіт өте қиын.
Dialogue: 0,0:04:33.14,0:04:35.19,Default,,0,0,0,,Мен ештеңе түсінбеймін
Dialogue: 0,0:04:35.27,0:04:37.98,Default,,0,0,0,,Мен сенен бұлай ақымақ болады деп күтпедім.
Dialogue: 0,0:04:43.95,0:04:44.95,Default,,0,0,0,,Йо
Dialogue: 0,0:04:45.03,0:04:46.16,Default,,0,0,0,,О
Dialogue: 0,0:04:48.03,0:04:51.08,Default,,0,0,0,,Сіз орта мектеп оқушыларымен араластыңыз ба?
Dialogue: 0,0:04:51.16,0:04:52.16,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:04:52.25,0:04:55.67,Default,,0,0,0,,Шынымен, әзіл ретінде осылай айта аласыз ба?
Dialogue: 0,0:04:55.75,0:04:57.58,Default,,0,0,0,,-де? Не істеуім керек?
Dialogue: 0,0:04:57.67,0:05:01.13,Default,,0,0,0,,Қалай ойласаңыз да, Ниттамен жаттығу кездесуі мүмкін емес.
Dialogue: 0,0:05:03.21,0:05:04.17,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:05:04.26,0:05:07.39,Default,,0,0,0,,Мектепте рұқсат жоқ деп ойлаймын.
Dialogue: 0,0:05:07.47,0:05:09.22,Default,,0,0,0,,Мұны өзіңіз қалағандай жасамаңыз.
Dialogue: 0,0:05:09.30,0:05:10.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:10.81,0:05:12.22,Default,,0,0,0,,Мектепке қатысты мәселелер
Dialogue: 0,0:05:12.31,0:05:15.44,Default,,0,0,0,,Рұқсатсыз жиналып, сіріңке ойнау.
Dialogue: 0,0:05:15.52,0:05:17.15,Default,,0,0,0,,Шуго...
Dialogue: 0,0:05:19.02,0:05:20.94,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:05:22.61,0:05:23.78,Default,,0,0,0,,Даймаджи
Dialogue: 0,0:05:23.86,0:05:25.40,Default,,0,0,0,,Уайымдама Шуго
Dialogue: 0,0:05:25.49,0:05:29.37,Default,,0,0,0,,Оқушылардың рұқсатсыз бір-біріне қарсы ойнауы мүмкін деп ойлайсыз ба?
Dialogue: 0,0:05:29.45,0:05:31.49,Default,,0,0,0,,Бұл бұрын-соңды болмаған нәрсе.
Dialogue: 0,0:05:34.04,0:05:35.87,Default,,0,0,0,,Жауапкершілікті алыңыз
Dialogue: 0,0:05:35.96,0:05:38.71,Default,,0,0,0,,Мен сенен өтінемін, Шун, ынтымақтастық үшін.
Dialogue: 0,0:05:39.71,0:05:42.13,Default,,0,0,0,,Ал... Мен ішпеймін, темекі шекпеймін.
Dialogue: 0,0:05:42.21,0:05:44.51,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:05:45.05,0:05:48.09,Default,,0,0,0,,Шуго, бұл сіздің бірінші тәжірибеңіз.
Dialogue: 0,0:05:48.18,0:05:49.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:49.55,0:05:52.22,Default,,0,0,0,,Сіз тіпті мектепке қарсы шықпақ болдыңыз.
Dialogue: 0,0:05:52.31,0:05:56.10,Default,,0,0,0,,Сіз бірдеңе істеу туралы ойланып көрдіңіз бе?
Dialogue: 0,0:05:56.18,0:05:58.98,Default,,0,0,0,,Оны киіп, ақымақтық жасама.
Dialogue: 0,0:05:59.06,0:06:00.69,Default,,0,0,0,,Ешқашан болмаған.
Dialogue: 0,0:06:01.77,0:06:02.82,Default,,0,0,0,,Шығу…
Dialogue: 0,0:06:04.78,0:06:06.94,Default,,0,0,0,,Мен Йокотеде 5-ші нөмірмін.
Dialogue: 0,0:06:07.03,0:06:09.70,Default,,0,0,0,,Шуго Кадовакиді таң қалдырған адам
Dialogue: 0,0:06:09.78,0:06:11.62,Default,,0,0,0,,Танысайық
Dialogue: 0,0:06:11.70,0:06:15.24,Default,,0,0,0,,Сізді кадрыңыздан шығарып алған адаммен алғашқы тәжірибеңіз.
Dialogue: 0,0:06:15.33,0:06:17.00,Default,,0,0,0,,Мені қатты қызықтырады.
Dialogue: 0,0:06:17.08,0:06:20.04,Default,,0,0,0,,Мен де сынап көрейін деп қышиды.
Dialogue: 0,0:06:20.12,0:06:22.13,Default,,0,0,0,,Айтсаңыз
Dialogue: 0,0:06:22.21,0:06:24.00,Default,,0,0,0,,Бұл көп сияқты.
Dialogue: 0,0:06:24.63,0:06:26.80,Default,,0,0,0,,Ол нағыз сұлу.
Dialogue: 0,0:06:26.88,0:06:30.18,Default,,0,0,0,,Танысайық, жарғанатқа тұрып, дәм татайық.
Dialogue: 0,0:06:30.26,0:06:32.39,Default,,0,0,0,,Бұл сіздің бірінші тәжірибеңіз.
Dialogue: 0,0:06:37.18,0:06:38.02,Default,,0,0,0,,Көк толқын
Dialogue: 0,0:06:42.61,0:06:46.03,Default,,0,0,0,,Енді мен сенімен жатпаймын.
Dialogue: 0,0:06:46.11,0:06:49.45,Default,,0,0,0,,Түсіндім, қызуым түсіп кетті.
Dialogue: 0,0:06:49.53,0:06:52.03,Default,,0,0,0,,Олай болса, тезірек бөлмеңе қайт.
Dialogue: 0,0:06:54.70,0:06:57.29,Default,,0,0,0,,Бауырым, сен Го Чанмен ұрысып қалдың ба?
Dialogue: 0,0:06:59.12,0:07:00.79,Default,,0,0,0,,Неліктен бұлай...
Dialogue: 0,0:07:01.92,0:07:03.08,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:07:03.17,0:07:05.29,Default,,0,0,0,,Басқа жолы мен Го Чанмен ұрысып қалдым.
Dialogue: 0,0:07:05.38,0:07:07.34,Default,,0,0,0,,Бауырым, қиын болған шығар.
Dialogue: 0,0:07:10.22,0:07:12.22,Default,,0,0,0,,Жарайды, ағайын.
Dialogue: 0,0:07:12.30,0:07:13.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:13.34,0:07:16.89,Default,,0,0,0,,Го Чан бұл туралы маған бұрын да айтқан болатын.
Dialogue: 0,0:07:16.97,0:07:19.73,Default,,0,0,0,,Ағаң ешкімнен ешқашан жеңілмейді.
Dialogue: 0,0:07:19.81,0:07:21.31,Default,,0,0,0,,Сіз осылай айтқаныңыз үшін.
Dialogue: 0,0:07:21.39,0:07:25.19,Default,,0,0,0,,Менің ойымша, Го Чан ағасын қатты жақсы көреді.
Dialogue: 0,0:07:25.27,0:07:27.19,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:07:27.28,0:07:29.65,Default,,0,0,0,,Жәкен, дұрыстап кешірім сұрасаң
Dialogue: 0,0:07:29.74,0:07:31.70,Default,,0,0,0,,Олар иә деп жауап береді.
Dialogue: 0,0:07:33.61,0:07:35.20,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:35.28,0:07:37.54,Default,,0,0,0,,Такумиге қоңырау шалыңыз
Dialogue: 0,0:07:39.16,0:07:40.50,Default,,0,0,0,,Австралиядан?
Dialogue: 0,0:07:40.58,0:07:44.29,Default,,0,0,0,,Жақсы, сүйкімді қыз еді.
Dialogue: 0,0:07:44.38,0:07:45.21,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:45.29,0:07:46.84,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:07:46.92,0:07:47.75,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:07:48.59,0:07:49.80,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:07:49.88,0:07:51.22,Default,,0,0,0,,Маған харада
Dialogue: 0,0:07:51.30,0:07:52.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:52.22,0:07:55.34,Default,,0,0,0,,Дәл қазір маған Кадоваки қоңырау шалды.
Dialogue: 0,0:07:55.43,0:07:58.39,Default,,0,0,0,,Сәйкестік жасауға дайын болыңыз.
Dialogue: 0,0:07:58.47,0:08:01.85,Default,,0,0,0,,Ал... жетістікке жету мүмкіндігі жоғары.
Dialogue: 0,0:08:01.93,0:08:04.90,Default,,0,0,0,,Тек соны айтып, осылай ойлау... болды.
Dialogue: 0,0:08:06.19,0:08:07.19,Default,,0,0,0,,Не! Гваааах!
Dialogue: 0,0:08:07.27,0:08:08.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:09.15,0:08:11.82,Default,,0,0,0,,Мм... мен де Гоға қоңырау шалуым керек пе?
Dialogue: 0,0:08:11.90,0:08:14.91,Default,,0,0,0,,Аа, мен мұны Нагакураға да ертерек жасадым...
Dialogue: 0,0:08:15.62,0:08:17.07,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:08:17.16,0:08:18.03,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:18.62,0:08:20.79,Default,,0,0,0,,Бірақ мен матч ойнайтынымызға сенімдімін.
Dialogue: 0,0:08:20.87,0:08:22.79,Default,,0,0,0,,Эри Рики кірді.
Dialogue: 0,0:08:23.58,0:08:25.42,Default,,0,0,0,,Ах Харада
Dialogue: 0,0:08:25.50,0:08:26.67,Default,,0,0,0,,Иә
Dialogue: 0,0:08:26.75,0:08:28.75,Default,,0,0,0,,Директорға не айтты
Dialogue: 0,0:08:28.84,0:08:31.17,Default,,0,0,0,,Көп ойланбаңыз.
Dialogue: 0,0:08:31.26,0:08:35.22,Default,,0,0,0,,Менде батареяда ақау бар. Мен оны пайдалана алмайтын сияқтымын.
Dialogue: 0,0:08:35.30,0:08:37.64,Default,,0,0,0,,Шынымды айтсам, бұл жай ғана мазасыздық.
Dialogue: 0,0:08:37.72,0:08:38.55,Default,,0,0,0,,Тағы кездескенше
Dialogue: 0,0:08:38.64,0:08:40.68,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:08:41.43,0:08:43.73,Default,,0,0,0,,Телефонды қайтарып беремін.
Dialogue: 0,0:09:19.55,0:09:20.47,Default,,0,0,0,,Такуми
Dialogue: 0,0:09:20.55,0:09:22.31,Default,,0,0,0,,Түс, кет.
Dialogue: 0,0:09:27.52,0:09:30.82,Default,,0,0,0,,Бар, осы сағатта қайда барасың?
Dialogue: 0,0:09:32.19,0:09:34.99,Default,,0,0,0,,А, Такуми-кун да сенімен бірге ме?
Dialogue: 0,0:09:37.82,0:09:39.99,Default,,0,0,0,,Барыңыз анашым, сіз бірдеңе айтып тұрсыз.
Dialogue: 0,0:10:05.35,0:10:08.89,Default,,0,0,0,,Ақымақ! Сен жасайық...
Dialogue: 0,0:10:11.11,0:10:13.90,Default,,0,0,0,,Шикишо... ақымақ сияқты әрекет ет
Dialogue: 0,0:10:17.11,0:10:19.03,Default,,0,0,0,,Неге қоңырау шалып жатырсыз?
Dialogue: 0,0:10:19.11,0:10:20.95,Default,,0,0,0,,Tappa басқаша болар еді.
Dialogue: 0,0:10:21.03,0:10:23.03,Default,,0,0,0,,Нағыз төбелесіп көрейік, мен сені жеңе аламын ба!
Dialogue: 0,0:10:23.12,0:10:24.41,Default,,0,0,0,,Қорқақтық
Dialogue: 0,0:10:24.49,0:10:25.70,Default,,0,0,0,,Допты ұстау керек
Dialogue: 0,0:10:25.79,0:10:27.29,Default,,0,0,0,,Сіз үлкен төбелесіп жатырсыз ба?
Dialogue: 0,0:10:28.21,0:10:30.62,Default,,0,0,0,,Айтқыңыз келген нәрсені жай ғана айтпаңыз!
Dialogue: 0,0:10:30.71,0:10:31.96,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:10:32.04,0:10:34.59,Default,,0,0,0,,Мен саған әзіл ойнадым.
Dialogue: 0,0:10:34.67,0:10:35.63,Default,,0,0,0,,Бірде-бір рет
Dialogue: 0,0:10:35.71,0:10:37.88,Default,,0,0,0,,Мен туралы не ойлайсың?
Dialogue: 0,0:10:37.97,0:10:40.38,Default,,0,0,0,,Ол тым сақ болмайтын ұстаушы.
Dialogue: 0,0:10:41.09,0:10:42.01,Default,,0,0,0,,Чикишо
Dialogue: 0,0:10:42.72,0:10:46.35,Default,,0,0,0,,Осы төртінші қадамды көргенде маған қалай қарадың?
Dialogue: 0,0:10:46.43,0:10:47.93,Default,,0,0,0,,Ұстаушыны құмыра аяпты.
Dialogue: 0,0:10:48.02,0:10:49.39,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:10:49.48,0:10:52.36,Default,,0,0,0,,Мен шынымен кіммен күресуім керек?
Dialogue: 0,0:10:52.44,0:10:54.27,Default,,0,0,0,,Йокоте де, директор да емес.
Dialogue: 0,0:10:54.36,0:10:55.40,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:10:56.28,0:10:57.69,Default,,0,0,0,,Маған таңданыңыз
Dialogue: 0,0:10:57.78,0:10:59.40,Default,,0,0,0,,Мен сенен ешқашан жеңілмеймін
Dialogue: 0,0:11:00.36,0:11:02.20,Default,,0,0,0,,Жанашырлық мені өлтірмейді
Dialogue: 0,0:11:03.28,0:11:05.49,Default,,0,0,0,,Мен сен үшін ең жақсы ұстаушымын
Dialogue: 0,0:11:05.58,0:11:07.37,Default,,0,0,0,,Мен шын жүректен түсінемін
Dialogue: 0,0:11:08.00,0:11:10.29,Default,,0,0,0,,Мен кешірім сұрадым, бірақ мені жерге тізерлеп қойдым.
Dialogue: 0,0:11:11.50,0:11:13.04,Default,,0,0,0,,Такумиді еске түсіріңіз
Dialogue: 0,0:11:16.05,0:11:17.55,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:11:53.17,0:11:55.17,Default,,0,0,0,,Жоқ, Хигашитани-кун
Dialogue: 0,0:11:55.25,0:11:57.55,Default,,0,0,0,,Харада мырза мұны керемет жасады.
Dialogue: 0,0:11:57.63,0:12:00.63,Default,,0,0,0,,Бет-әлпет емес пе?
Dialogue: 0,0:12:00.72,0:12:04.18,Default,,0,0,0,,Егер бұл Йосисаданың беті болса, бұл босқа.
Dialogue: 0,0:12:04.26,0:12:06.72,Default,,0,0,0,,Тоқта, бұл не сөз?
Dialogue: 0,0:12:06.80,0:12:09.85,Default,,0,0,0,,Бетімде Харададан жеңілгім келмейді.
Dialogue: 0,0:12:09.93,0:12:13.19,Default,,0,0,0,,Нитта Хигаши орта мектебі әдемі ұлдардың алғашқы бестігіне кіреді
Dialogue: 0,0:12:13.27,0:12:15.90,Default,,0,0,0,,Мені кім кіргізеді? Міне бітті.
Dialogue: 0,0:12:15.98,0:12:17.69,Default,,0,0,0,,Шулы
Dialogue: 0,0:12:17.77,0:12:21.07,Default,,0,0,0,,Эй, мұны кім жасады? Отомрай?
Dialogue: 0,0:12:21.15,0:12:21.99,Default,,0,0,0,,Бұл піл
Dialogue: 0,0:12:22.07,0:12:23.20,Default,,0,0,0,,- (Йосисада) Иә? -(Хигашия) Піл?
Dialogue: 0,0:12:23.28,0:12:26.95,Default,,0,0,0,,Менің үйде үй жануарым бар еді, ол жабайы болып кетті.
Dialogue: 0,0:12:27.03,0:12:29.41,Default,,0,0,0,,Ах... піл.
Dialogue: 0,0:12:29.49,0:12:31.95,Default,,0,0,0,,Харада-сама оны өз үйінде сақтайды.
Dialogue: 0,0:12:37.04,0:12:38.09,Default,,0,0,0,,Кадоваки
Dialogue: 0,0:12:38.84,0:12:42.09,Default,,0,0,0,,Бұл Йокоте Кадоваки ме? Харада
Dialogue: 0,0:12:50.10,0:12:52.98,Default,,0,0,0,,Кайонджи храмы Осы айдың соңғы жексенбісі
Dialogue: 0,0:12:53.93,0:12:55.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:55.10,0:12:55.98,Default,,0,0,0,,Сәйкестік
Dialogue: 0,0:12:57.06,0:12:59.23,Default,,0,0,0,,Сіз матчқа өтініш бересіз бе?
Dialogue: 0,0:12:59.32,0:13:02.94,Default,,0,0,0,,Маған мектеп арқылы өтініш бермеу керектігін айтты.
Dialogue: 0,0:13:03.03,0:13:03.86,Default,,0,0,0,,Бірақ орындаңыз
Dialogue: 0,0:13:04.78,0:13:05.82,Default,,0,0,0,,Харада
Dialogue: 0,0:13:06.45,0:13:08.62,Default,,0,0,0,,Мен айттым.
Dialogue: 0,0:13:08.70,0:13:10.87,Default,,0,0,0,,Қарсыластарымызға қарсы тамаша ойнағанымызда, олар бізді жіберіп алды.
Dialogue: 0,0:13:10.95,0:13:12.37,Default,,0,0,0,,Бір жыл болды.
Dialogue: 0,0:13:14.46,0:13:17.33,Default,,0,0,0,,Барлығы мұны істегісі келеді.
Dialogue: 0,0:13:17.42,0:13:19.38,Default,,0,0,0,,Мектеп маңызды емес
Dialogue: 0,0:13:19.46,0:13:20.88,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:13:20.96,0:13:22.42,Default,,0,0,0,,жексенбі…
Dialogue: 0,0:13:22.51,0:13:25.22,Default,,0,0,0,,Сізге ұнайтын нәрселер жиналып бейсбол ойнаса
Dialogue: 0,0:13:25.30,0:13:27.89,Default,,0,0,0,,Рұқсат сияқты күрделі нәрселерді айтпаңыз.
Dialogue: 0,0:13:29.01,0:13:30.89,Default,,0,0,0,,Сізде бұл қол болды ма?
Dialogue: 0,0:13:31.89,0:13:34.27,Default,,0,0,0,,Мен сенің келісіміңді алу үшін келдім.
Dialogue: 0,0:13:34.35,0:13:36.27,Default,,0,0,0,,Сіз қалай ойлайсыз? Оны жасамау керек пе?
Dialogue: 0,0:13:36.35,0:13:39.48,Default,,0,0,0,,Мен мұны істеймін, мен саған ризашылығымды білдіремін, Кадоваки.
Dialogue: 0,0:13:39.56,0:13:42.78,Default,,0,0,0,,Осындай аңғал сөздер айтсаң, мен сені жылатамын.
Dialogue: 0,0:13:43.69,0:13:44.53,Default,,0,0,0,,Харада
Dialogue: 0,0:13:45.15,0:13:46.03,Default,,0,0,0,,Иә
Dialogue: 0,0:13:46.74,0:13:50.57,Default,,0,0,0,,Мен туралы үлкен мәміле жасағаныңыз үшін жауапкершілікті өзіңізге жүктеймін.
Dialogue: 0,0:13:50.66,0:13:52.58,Default,,0,0,0,,Нашар питтингке жол берілмейді
Dialogue: 0,0:13:52.66,0:13:54.66,Default,,0,0,0,,Қанағаттанайық
Dialogue: 0,0:13:54.75,0:13:56.16,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:56.79,0:14:01.17,Default,,0,0,0,,Тек келесі эйс жойылса да, кек сақтамаңыз.
Dialogue: 0,0:14:02.63,0:14:03.88,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:14:03.96,0:14:06.38,Default,,0,0,0,,Жеңілмеңіз және депрессияға түспеңіз.
Dialogue: 0,0:14:06.47,0:14:08.18,Default,,0,0,0,,Бұл сіздің емтиханыңызға әсер етеді.
Dialogue: 0,0:14:09.80,0:14:13.51,Default,,0,0,0,,Орналасқан жері кешегі орталық алаң болды. Сендер келулерің керек.
Dialogue: 0,0:14:13.60,0:14:15.77,Default,,0,0,0,,Оның орнына төрешілерге арналған параметрлер т.б.
Dialogue: 0,0:14:15.85,0:14:16.68,Default,,0,0,0,,Осы жерде орындаңыз
Dialogue: 0,0:14:16.77,0:14:18.19,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:20.44,0:14:22.98,Default,,0,0,0,,Жаттығу кезінде сөзімді бөлгеніңіз үшін рахмет.
Dialogue: 0,0:14:23.07,0:14:24.15,Default,,0,0,0,,Оэ Кадоваки
Dialogue: 0,0:14:24.23,0:14:26.44,Default,,0,0,0,,...
Dialogue: 0,0:14:26.53,0:14:29.45,Default,,0,0,0,,...
Dialogue: 0,0:14:36.54,0:14:39.83,Default,,0,0,0,,Йокотеден осы жерге дейін жүгіру
Dialogue: 0,0:14:39.92,0:14:40.79,Default,,0,0,0,,Иә
Dialogue: 0,0:14:45.38,0:14:46.34,Default,,0,0,0,,Директор
Dialogue: 0,0:14:46.42,0:14:49.59,Default,,0,0,0,,...
Dialogue: 0,0:14:49.68,0:14:51.68,Default,,0,0,0,,Жарайды, мен саған қалдырамын.
Dialogue: 0,0:14:51.76,0:14:52.60,Default,,0,0,0,,Иә
Dialogue: 0,0:14:52.68,0:14:56.35,Default,,0,0,0,,...
Dialogue: 0,0:14:56.43,0:15:00.10,Default,,0,0,0,,Нагакура Харада Балалар сендер ақ топсыңдар.
Dialogue: 0,0:15:00.19,0:15:03.56,Default,,0,0,0,,...
Dialogue: 0,0:15:03.65,0:15:04.52,Default,,0,0,0,,Иә
Dialogue: 0,0:15:30.47,0:15:32.84,Default,,0,0,0,,Әй, жаным, қарап тұрсың ба?
Dialogue: 0,0:15:45.86,0:15:47.82,Default,,0,0,0,,Шуго, иә?
Dialogue: 0,0:15:47.90,0:15:48.90,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:48.98,0:15:51.24,Default,,0,0,0,,Ммм, түсіндім.
Dialogue: 0,0:15:51.32,0:15:53.41,Default,,0,0,0,,Ол өте ханшайым.
Dialogue: 0,0:15:53.49,0:15:56.24,Default,,0,0,0,,Кадоваки неге сонша шу шығарып отыр?
Dialogue: 0,0:15:56.33,0:15:59.62,Default,,0,0,0,,Оны ойласаң, арық бала екен.
Dialogue: 0,0:15:59.70,0:16:02.87,Default,,0,0,0,,Сенің еркелігіңмен салыстырғанда, бәрі де арық.
Dialogue: 0,0:16:02.96,0:16:03.92,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:16:04.00,0:16:07.67,Default,,0,0,0,,Орындық алдында тербелуге жаттықтыру. Мына құмыраны ашуландырыңыз.
Dialogue: 0,0:16:07.75,0:16:10.05,Default,,0,0,0,,Соншалықты алысқа бару керек пе?
Dialogue: 0,0:16:10.13,0:16:11.42,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:20.52,0:16:22.43,Default,,0,0,0,,Үйінді тегістелді
Dialogue: 0,0:16:22.52,0:16:24.94,Default,,0,0,0,,Қарсыласқа иокот лақтырған жыл болды.
Dialogue: 0,0:16:25.02,0:16:26.69,Default,,0,0,0,,Сіз тынышсыз ба?
Dialogue: 0,0:16:28.02,0:16:30.23,Default,,0,0,0,,Сіз тіпті қобалжымайсыз ба?
Dialogue: 0,0:16:30.32,0:16:32.70,Default,,0,0,0,,Иә, сіз оны төлей аласыз.
Dialogue: 0,0:16:39.79,0:16:41.83,Default,,0,0,0,,Енді оны ұсақтап алайық.
Dialogue: 0,0:16:41.91,0:16:42.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:42.83,0:16:44.67,Default,,0,0,0,,Сіздің сүйіктіңіз
Dialogue: 0,0:16:45.46,0:16:47.00,Default,,0,0,0,,Ол сөзсіз әдемі
Dialogue: 0,0:16:47.08,0:16:49.71,Default,,0,0,0,,Оның мінезі өте нашар сияқты, солай емес пе?
Dialogue: 0,0:16:52.30,0:16:53.47,Default,,0,0,0,,Оны ұсақтауға бола ма?
Dialogue: 0,0:16:53.55,0:16:55.22,Default,,0,0,0,,Бұл бізге оңай.
Dialogue: 0,0:16:56.05,0:16:57.47,Default,,0,0,0,,Хаги Джоно
Dialogue: 0,0:16:59.35,0:17:01.47,Default,,0,0,0,,Мына құмыраны зертте.
Dialogue: 0,0:17:01.56,0:17:03.56,Default,,0,0,0,,Бұл префектуралық университеттегі ең үлкен көз ауруы.
Dialogue: 0,0:17:03.64,0:17:04.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:08.31,0:17:09.98,Default,,0,0,0,,Ой-ау!
Dialogue: 0,0:17:25.41,0:17:26.50,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:17:31.84,0:17:32.67,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:17:42.06,0:17:44.02,Default,,0,0,0,,Үш таңбалы өзгерісті сызыңыз
Dialogue: 0,0:17:44.10,0:17:45.39,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:48.90,0:17:50.27,Default,,0,0,0,,- (Мизугаки) Хаги - (Хаги) Иә
Dialogue: 0,0:17:51.98,0:17:55.78,Default,,0,0,0,,Ниттаның соққылар сапында назар аудару керек жалғыз нәрсе - №4 Каионджи.
Dialogue: 0,0:17:56.36,0:17:58.78,Default,,0,0,0,,Бұл негізінен қорғаныс командасы.
Dialogue: 0,0:17:58.86,0:18:00.78,Default,,0,0,0,,Иә, өзіңізді қыспаңыз.
Dialogue: 0,0:18:08.50,0:18:09.42,Default,,0,0,0,,(Дыбысты қабылдау)
Dialogue: 0,0:18:15.42,0:18:16.42,Default,,0,0,0,,Төрт доп
Dialogue: 0,0:18:18.22,0:18:19.68,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:18:32.82,0:18:34.07,Default,,0,0,0,,Өзгерту
Dialogue: 0,0:18:46.16,0:18:48.46,Default,,0,0,0,,Бұл менің қымбатты ханшайымыммен кездесу.
Dialogue: 0,0:18:48.54,0:18:50.42,Default,,0,0,0,,Уақытыңызды бөліп, рахат алыңыз.
Dialogue: 0,0:18:57.38,0:18:59.51,Default,,0,0,0,,Нагакура Біраз уақыт өтті.
Dialogue: 0,0:18:59.59,0:19:00.43,Default,,0,0,0,,Иә
Dialogue: 0,0:19:00.51,0:19:02.39,Default,,0,0,0,,Сол доп келе жатыр.
Dialogue: 0,0:19:02.47,0:19:03.30,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:04.30,0:19:05.43,Default,,0,0,0,,Сіз оны ұстай аласыз ба?
Dialogue: 0,0:19:05.51,0:19:07.02,Default,,0,0,0,,алу
Dialogue: 0,0:19:08.14,0:19:09.02,Default,,0,0,0,,Ойнату
Dialogue: 0,0:19:14.65,0:19:16.11,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:19:26.16,0:19:28.12,Default,,0,0,0,,Қамырды тастаңыз
Dialogue: 0,0:19:28.20,0:19:29.08,Default,,0,0,0,,Я...
Dialogue: 0,0:19:35.79,0:19:39.59,Default,,0,0,0,,Дұрыс, Кадоваки кездейсоқ шығып кетуі мүмкін.
Dialogue: 0,0:19:40.63,0:19:42.59,Default,,0,0,0,,Бұл кездейсоқ емес.
Dialogue: 0,0:19:47.89,0:19:50.06,Default,,0,0,0,,Жоқ, балалар
Dialogue: 0,0:19:50.14,0:19:51.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:51.64,0:19:53.60,Default,,0,0,0,,Эй, мен оны лақтырамын.
Dialogue: 0,0:19:53.69,0:19:54.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:54.61,0:19:57.32,Default,,0,0,0,,Кадовакиге лақтырылған сол доп
Dialogue: 0,0:19:57.40,0:19:59.57,Default,,0,0,0,,Әлде бұл кездейсоқтық па?
Dialogue: 0,0:20:00.49,0:20:02.57,Default,,0,0,0,,Сіз ұстаушы бола алмайсыз.
Dialogue: 0,0:20:02.65,0:20:03.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:03.91,0:20:07.33,Default,,0,0,0,,Одан үлкен допты ұстай аласың ба?
Dialogue: 0,0:20:07.91,0:20:10.33,Default,,0,0,0,,Хехе ұсталмайсың Отаку.
Dialogue: 0,0:20:10.41,0:20:11.83,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:11.91,0:20:14.96,Default,,0,0,0,,Қарағым, қарашы, Ханшайым, қиналыпсың.
Dialogue: 0,0:20:15.67,0:20:18.84,Default,,0,0,0,,Мен сізді қол қоюға мәжбүрлей алмаймын. Мен сені тұрғыза алмаймын.
Dialogue: 0,0:20:18.92,0:20:21.13,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:20:21.22,0:20:24.47,Default,,0,0,0,,Неге екенін білмеймін, сондықтан мен тентекпін.
Dialogue: 0,0:20:25.93,0:20:26.80,Default,,0,0,0,,(Үкім шығару)
Dialogue: 0,0:20:26.89,0:20:29.26,Default,,0,0,0,,Батер: Жарғанатпен сөйлеспе.
Dialogue: 0,0:20:29.35,0:20:30.85,Default,,0,0,0,,Оны осындай ерекше жағдайға араластыру сәл қатал қадам сияқты.
Dialogue: 0,0:20:35.52,0:20:36.36,Default,,0,0,0,,Ойнату
Dialogue: 0,0:20:38.94,0:20:39.82,Default,,0,0,0,,Австралия…
Dialogue: 0,0:20:47.41,0:20:48.91,Default,,0,0,0,,Я...
Dialogue: 0,0:20:56.83,0:20:57.75,Default,,0,0,0,,Шығу
Dialogue: 0,0:21:00.50,0:21:01.34,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:06.13,0:21:07.05,Default,,0,0,0,,Иә
Dialogue: 0,0:21:26.11,0:21:31.12,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.99,0:22:55.99,Default,,0,0,0,,～♪
