Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.38,0:00:14.47,Default,,0,0,0,,Такуми
Dialogue: 0,0:00:15.97,0:00:17.26,Default,,0,0,0,,Такуми
Dialogue: 0,0:00:34.70,0:00:35.86,Default,,0,0,0,,Мұнда кел!
Dialogue: 0,0:00:37.87,0:00:39.37,Default,,0,0,0,,Мені ұстаңыз
Dialogue: 0,0:00:39.99,0:00:41.37,Default,,0,0,0,,Мені ұстаңыз...
Dialogue: 0,0:00:43.46,0:00:45.62,Default,,0,0,0,,Ешқашан жіберме!
Dialogue: 0,0:00:49.71,0:00:52.51,Default,,0,0,0,,Неліктен мен емес басқа адамды таңдар едіңіз?
Dialogue: 0,0:00:52.59,0:00:54.26,Default,,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:01:01.64,0:01:03.77,Default,,0,0,0,,Кешпеймін…
Dialogue: 0,0:01:08.02,0:01:13.03,Default,,0,0,0,,♪～
Dialogue: 0,0:02:32.56,0:02:37.57,Default,,0,0,0,,～♪
Dialogue: 0,0:02:53.38,0:02:55.63,Default,,0,0,0,,Үйге қайтайық Кадоваки
Dialogue: 0,0:03:00.26,0:03:03.64,Default,,0,0,0,,Эй, мен саған Кайонджиден қоңырау шалғанын естідім.
Dialogue: 0,0:03:04.26,0:03:05.64,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:03:05.72,0:03:08.31,Default,,0,0,0,,Оның сізге қатысы жоқ.
Dialogue: 0,0:03:08.39,0:03:10.02,Default,,0,0,0,,Бұл матч туралы.
Dialogue: 0,0:03:10.10,0:03:12.56,Default,,0,0,0,,Оның маған қатысы жоқ па?
Dialogue: 0,0:03:13.35,0:03:14.52,Default,,0,0,0,,Босқа болма
Dialogue: 0,0:03:15.44,0:03:17.82,Default,,0,0,0,,Мен матч туралы ойламайтын сияқтымын.
Dialogue: 0,0:03:17.90,0:03:19.36,Default,,0,0,0,,Сіз мұны айта аласыз.
Dialogue: 0,0:03:19.44,0:03:21.65,Default,,0,0,0,,Сіздің басыңызда не бар?
Dialogue: 0,0:03:21.74,0:03:23.78,Default,,0,0,0,,Тек Харада.
Dialogue: 0,0:03:23.87,0:03:27.87,Default,,0,0,0,,Ойынды қалай жеңу керек және кім бастаушы болуы керек
Dialogue: 0,0:03:27.95,0:03:29.79,Default,,0,0,0,,Сіз бұл туралы екінші рет ойланып көрдіңіз бе?
Dialogue: 0,0:03:29.87,0:03:31.79,Default,,0,0,0,,Бұл... бірақ...
Dialogue: 0,0:03:32.62,0:03:35.59,Default,,0,0,0,,Оның сізге қатысы жоқ.
Dialogue: 0,0:03:35.67,0:03:38.46,Default,,0,0,0,,Шун: Мен осылай айтайын деп ойладым.
Dialogue: 0,0:03:38.55,0:03:40.30,Default,,0,0,0,,Сіз ашуланып қалдыңыз.
Dialogue: 0,0:03:40.38,0:03:41.22,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:03:41.30,0:03:42.26,Default,,0,0,0,,Иә
Dialogue: 0,0:03:42.34,0:03:46.01,Default,,0,0,0,,Кішкентай кезімнен сен мені ашуландырдың.
Dialogue: 0,0:03:46.64,0:03:48.81,Default,,0,0,0,,Мен қыбырлағанда
Dialogue: 0,0:03:48.89,0:03:50.64,Default,,0,0,0,,Поо... Естеліктер
Dialogue: 0,0:03:50.73,0:03:53.81,Default,,0,0,0,,Басым таз болған соң, жайлап алайын.
Dialogue: 0,0:03:53.90,0:03:55.31,Default,,0,0,0,,- (Кадоваки) Бірдеңе, солай ма? - (Мизугаки) Иә?
Dialogue: 0,0:03:55.40,0:03:59.07,Default,,0,0,0,,Ашулы Шундзи нағыз Шундзиден жақсы
Dialogue: 0,0:03:59.15,0:04:00.07,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:04:02.65,0:04:04.61,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:04.70,0:04:06.37,Default,,0,0,0,,Айтпақшы, сіз
Dialogue: 0,0:04:06.45,0:04:09.08,Default,,0,0,0,,Менің ойымша, сізде әрқашан мазохистік тенденциялар болған.
Dialogue: 0,0:04:10.95,0:04:12.58,Default,,0,0,0,,Терді сүртуге не жетсін?
Dialogue: 0,0:04:12.66,0:04:14.00,Default,,0,0,0,,О
Dialogue: 0,0:04:18.17,0:04:19.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:23.01,0:04:24.01,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:25.01,0:04:28.60,Default,,0,0,0,,Іш бұлшықеттерін жаттықтыру тәсілі жеткіліксіз Шуго
Dialogue: 0,0:04:28.68,0:04:29.93,Default,,0,0,0,,(Присцилла) Сол тәрбиесіз шлюхаға—
Dialogue: 0,0:04:30.01,0:04:32.48,Default,,0,0,0,,Соңғы рет үшін.
Dialogue: 0,0:04:32.56,0:04:34.31,Default,,0,0,0,,Енді несие беру немесе қарыз алу жоқ.
Dialogue: 0,0:04:34.94,0:04:36.02,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:04:36.77,0:04:39.69,Default,,0,0,0,,Күте тұрыңыз, сіз қалжыңдап тұрсыз.
Dialogue: 0,0:04:39.77,0:04:41.44,Default,,0,0,0,,Сіз нені білдіреді?
Dialogue: 0,0:04:43.28,0:04:46.20,Default,,0,0,0,,Мен сіз білетін нәрселерді қалдырамын.
Dialogue: 0,0:04:47.99,0:04:49.87,Default,,0,0,0,,Мен шынымен кіммін?
Dialogue: 0,0:04:50.54,0:04:52.95,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,0:04:53.04,0:04:55.83,Default,,0,0,0,,Мен мұны бір рет жасағаныңызды қалаймын
Dialogue: 0,0:04:55.92,0:04:58.92,Default,,0,0,0,,Мен саған өзімнің кім екенімді ешқашан көрсеткен емеспін.
Dialogue: 0,0:05:00.38,0:05:01.88,Default,,0,0,0,,Мұны есте сақтаңыз
Dialogue: 0,0:05:04.51,0:05:05.72,Default,,0,0,0,,Шуго
Dialogue: 0,0:05:05.80,0:05:08.93,Default,,0,0,0,,Мен сені жек көремін.
Dialogue: 0,0:05:09.01,0:05:11.31,Default,,0,0,0,,Жек көрдім, жек көрдім, шыдай алмадым.
Dialogue: 0,0:05:11.76,0:05:15.56,Default,,0,0,0,,Мен сенің бір жерде жоғалып кетсең екен деп қала бердім.
Dialogue: 0,0:05:16.06,0:05:17.44,Default,,0,0,0,,Мәңгі
Dialogue: 0,0:05:18.60,0:05:20.31,Default,,0,0,0,,Бұл сенің кінәң емес
Dialogue: 0,0:05:20.40,0:05:22.73,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:05:23.32,0:05:25.90,Default,,0,0,0,,Мен оны жек көретінім сонша, мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:05:28.11,0:05:29.32,Default,,0,0,0,,(Шиозаки) «Кісі өлтіруші» дегенің не?
Dialogue: 0,0:06:45.82,0:06:48.99,Default,,0,0,0,,Омизу! Сіз Хагиді бастауды жоспарлап отырсыз ба?
Dialogue: 0,0:06:49.07,0:06:50.03,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:50.11,0:06:51.86,Default,,0,0,0,,Неге мен емес?
Dialogue: 0,0:06:51.95,0:06:53.53,Default,,0,0,0,,Өйткені бұл қауіпті
Dialogue: 0,0:06:53.62,0:06:54.91,Default,,0,0,0,,Бұл қауіпті ме?
Dialogue: 0,0:06:55.41,0:06:57.41,Default,,0,0,0,,Мен ұрып кетемін дейсің бе?
Dialogue: 0,0:06:57.50,0:06:58.54,Default,,0,0,0,,Эномото
Dialogue: 0,0:06:59.12,0:07:01.71,Default,,0,0,0,,Маған қызық, сен қандай құмансың.
Dialogue: 0,0:07:01.79,0:07:04.54,Default,,0,0,0,,Саған айтуымды сұрама.
Dialogue: 0,0:07:05.63,0:07:08.55,Default,,0,0,0,,Мен әрқашан сенің артыңда болдым, сені қорғадым.
Dialogue: 0,0:07:08.63,0:07:10.59,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:07:11.09,0:07:12.22,Default,,0,0,0,,Маған айтпа
Dialogue: 0,0:07:12.30,0:07:13.18,Default,,0,0,0,,Не?
Dialogue: 0,0:07:16.64,0:07:19.31,Default,,0,0,0,,Эномото, сен иығыңды ауырттың.
Dialogue: 0,0:07:19.39,0:07:20.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:21.02,0:07:24.90,Default,,0,0,0,,Республикалық турнирде өзімді жақсы сезінбегенім рас па?
Dialogue: 0,0:07:25.77,0:07:28.86,Default,,0,0,0,,Ешкімге айтқым келмеді, сонда сен қайдан білдің?
Dialogue: 0,0:07:28.94,0:07:30.57,Default,,0,0,0,,Мен осылай дедім.
Dialogue: 0,0:07:30.65,0:07:32.99,Default,,0,0,0,,Мен сенің артыңдамын
Dialogue: 0,0:07:33.07,0:07:35.12,Default,,0,0,0,,Менің арқамды бақылап жүр
Dialogue: 0,0:07:35.20,0:07:36.41,Default,,0,0,0,,Емделді
Dialogue: 0,0:07:36.49,0:07:37.83,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:07:37.91,0:07:40.04,Default,,0,0,0,,Екінші тарап өте нашар
Dialogue: 0,0:07:40.12,0:07:42.83,Default,,0,0,0,,Омизу, дұрыс түсіндіріңізші.
Dialogue: 0,0:07:42.92,0:07:45.88,Default,,0,0,0,,Егер солай болса, Эномото қанағаттанбайды.
Dialogue: 0,0:07:45.96,0:07:47.17,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:47.67,0:07:48.67,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:07:49.67,0:07:52.26,Default,,0,0,0,,Нитта Хигаши құмыра және
Dialogue: 0,0:07:52.34,0:07:54.34,Default,,0,0,0,,Сіз бұл допты лақтыра аласыз ба?
Dialogue: 0,0:07:55.18,0:07:59.22,Default,,0,0,0,,Олар сіз лақтыратын боларсыз деп жаттығады.
Dialogue: 0,0:07:59.72,0:08:02.35,Default,,0,0,0,,Мен бұл құмыраны жаттығу үстелі ретінде пайдаландым.
Dialogue: 0,0:08:02.44,0:08:05.65,Default,,0,0,0,,Ол жылдам доптарға қарсы өте күшті болуы керек.
Dialogue: 0,0:08:07.73,0:08:10.32,Default,,0,0,0,,Сіз орта мектепке барсаңыз да, ойынды жалғастыра бересіз.
Dialogue: 0,0:08:10.40,0:08:12.20,Default,,0,0,0,,Бұл жерде шектен шығуға болмайды.
Dialogue: 0,0:08:14.28,0:08:16.57,Default,,0,0,0,,Жаттықтырушы қорабында тұр?
Dialogue: 0,0:08:16.66,0:08:17.62,Default,,0,0,0,,Омизу
Dialogue: 0,0:08:17.70,0:08:20.87,Default,,0,0,0,,Эномотоның иығы туралы қайдан білдің?
Dialogue: 0,0:08:20.95,0:08:22.62,Default,,0,0,0,,Бойым қысқа.
Dialogue: 0,0:08:22.71,0:08:25.63,Default,,0,0,0,,Құмыраның жағдайын түсінемін.
Dialogue: 0,0:08:25.71,0:08:28.34,Default,,0,0,0,,Мен оны мүлде байқамадым
Dialogue: 0,0:08:28.42,0:08:31.71,Default,,0,0,0,,Караки Нитта Хигашиді төмендетпеңіз.
Dialogue: 0,0:08:31.80,0:08:33.97,Default,,0,0,0,,Мизугаки-сенпай!
Dialogue: 0,0:08:34.05,0:08:34.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:38.05,0:08:39.10,Default,,0,0,0,,Аға
Dialogue: 0,0:08:39.18,0:08:42.56,Default,,0,0,0,,Куриносуке, сен мұнда не үшін келдің?
Dialogue: 0,0:08:42.64,0:08:46.02,Default,,0,0,0,,Жоқ, «неге»... Мен Нитта Хигаши ойыншысымын.
Dialogue: 0,0:08:46.10,0:08:47.40,Default,,0,0,0,,Сіз менімен кездескіңіз келді, солай ма?
Dialogue: 0,0:08:47.48,0:08:48.56,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:08:48.65,0:08:51.53,Default,,0,0,0,,Мен сенімен кездескім келмеді.
Dialogue: 0,0:08:51.61,0:08:53.32,Default,,0,0,0,,Бұл қандай көзқарас?
Dialogue: 0,0:08:53.40,0:08:56.74,Default,,0,0,0,,Мен мүшелер тізімін алмасу үшін келдім.
Dialogue: 0,0:08:57.32,0:08:58.53,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:08:59.70,0:09:00.99,Default,,0,0,0,,Сәлем Куриносуке
Dialogue: 0,0:09:01.08,0:09:02.08,Default,,0,0,0,,Иә Иә Иә
Dialogue: 0,0:09:02.16,0:09:04.50,Default,,0,0,0,,бірден «Иә».
Dialogue: 0,0:09:04.58,0:09:06.46,Default,,0,0,0,,Жағдайларыңыз қалай?
Dialogue: 0,0:09:06.54,0:09:08.96,Default,,0,0,0,,Мен өте жақсы формадамын.
Dialogue: 0,0:09:09.04,0:09:11.09,Default,,0,0,0,,Жағдайыңды кім сұрайды?
Dialogue: 0,0:09:11.17,0:09:12.09,Default,,0,0,0,,Батареялар және
Dialogue: 0,0:09:12.17,0:09:14.97,Default,,0,0,0,,Әй, екеуі.
Dialogue: 0,0:09:15.05,0:09:16.68,Default,,0,0,0,,Хмм, сіз қалай ойлайсыз?
Dialogue: 0,0:09:16.76,0:09:18.97,Default,,0,0,0,,Джожо Уиттораннан айырмашылығы бар ма?
Dialogue: 0,0:09:19.64,0:09:22.97,Default,,0,0,0,,Харада: Мен әлі де бақылауды шеше алмаймын.
Dialogue: 0,0:09:23.68,0:09:25.31,Default,,0,0,0,,Әйтеуір, мен ұстаушы болғаным жақсы болар еді.
Dialogue: 0,0:09:25.39,0:09:27.14,Default,,0,0,0,,Жақсы болды ма деп ойлаймын
Dialogue: 0,0:09:27.23,0:09:28.48,Default,,0,0,0,,Йошисада
Dialogue: 0,0:09:28.56,0:09:31.44,Default,,0,0,0,,Бос сөз айтпа
Dialogue: 0,0:09:33.99,0:09:36.99,Default,,0,0,0,,Менің атым Нономура. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:09:39.07,0:09:40.91,Default,,0,0,0,,Таңғажайып емес пе? Көз жеткен жердің бәрінде Ятоитерлер!
Dialogue: 0,0:09:40.99,0:09:43.29,Default,,0,0,0,,Сіз келесі капитансыз ба?
Dialogue: 0,0:09:43.37,0:09:44.50,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:09:44.58,0:09:45.87,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:09:45.96,0:09:47.37,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:09:47.46,0:09:48.71,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:09:49.67,0:09:52.00,Default,,0,0,0,,Бірақ мұндай батареямен
Dialogue: 0,0:09:52.09,0:09:55.05,Default,,0,0,0,,Топ жақсы жұмыс істеп жатыр ма?
Dialogue: 0,0:09:55.13,0:09:57.76,Default,,0,0,0,,Сіз қызғанасыз ба? Мизугаки мырза
Dialogue: 0,0:09:57.84,0:09:59.01,Default,,0,0,0,,Не?
Dialogue: 0,0:09:59.09,0:10:01.01,Default,,0,0,0,,Біздің топқа
Dialogue: 0,0:10:01.10,0:10:03.39,Default,,0,0,0,,Осындай батареялар бар.
Dialogue: 0,0:10:03.47,0:10:05.31,Default,,0,0,0,,Ол дәл қазір осында—
Dialogue: 0,0:10:05.39,0:10:06.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:07.81,0:10:08.64,Default,,0,0,0,,Иә
Dialogue: 0,0:10:09.52,0:10:12.23,Default,,0,0,0,,Қараки Келесі кезек бізде.
Dialogue: 0,0:10:12.32,0:10:13.40,Default,,0,0,0,,Соққы
Dialogue: 0,0:10:13.48,0:10:14.36,Default,,0,0,0,,О
Dialogue: 0,0:10:16.11,0:10:18.24,Default,,0,0,0,,Мен де байқамадым.
Dialogue: 0,0:10:18.74,0:10:20.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:21.03,0:10:22.41,Default,,0,0,0,,Эномото туралы
Dialogue: 0,0:10:23.45,0:10:25.29,Default,,0,0,0,,Байқаудың қажеті жоқ.
Dialogue: 0,0:10:25.37,0:10:27.96,Default,,0,0,0,,Бұл мейірімдірек болар еді.
Dialogue: 0,0:10:28.46,0:10:31.42,Default,,0,0,0,,Егер басқа адам ханшайым болмаса, мен үндемей қалар едім.
Dialogue: 0,0:10:32.00,0:10:34.42,Default,,0,0,0,,Бұл міндетті түрде Хараданың кінәсі емес.
Dialogue: 0,0:10:34.50,0:10:35.84,Default,,0,0,0,,Түсіну
Dialogue: 0,0:10:35.92,0:10:38.30,Default,,0,0,0,,Оны жай ғана үйіндіге лақтырады.
Dialogue: 0,0:10:38.80,0:10:42.43,Default,,0,0,0,,Соған қарамастан, біз түсінбей, айналамыздағыларды бұрышқа итереміз.
Dialogue: 0,0:10:43.22,0:10:46.43,Default,,0,0,0,,Мұндай нәрсе шынымен зұлымдық.
Dialogue: 0,0:10:49.02,0:10:50.44,Default,,0,0,0,,Бұл жеткілікті емес пе?
Dialogue: 0,0:10:51.23,0:10:52.36,Default,,0,0,0,,Не?
Dialogue: 0,0:10:52.44,0:10:54.65,Default,,0,0,0,,Хараданың Котаа қазірдің өзінде
Dialogue: 0,0:10:55.36,0:10:59.07,Default,,0,0,0,,Егер сен болмасаң, матч болмас еді.
Dialogue: 0,0:11:03.37,0:11:04.99,Default,,0,0,0,,Менмін
Dialogue: 0,0:11:05.08,0:11:07.62,Default,,0,0,0,,Мен көптен бері сенің арқаңды бақылап жүрмін.
Dialogue: 0,0:11:07.70,0:11:08.95,Default,,0,0,0,,Өйткені ол қалды
Dialogue: 0,0:11:09.04,0:11:11.04,Default,,0,0,0,,Мен де сенің арқаңды көріп тұрмын.
Dialogue: 0,0:11:12.29,0:11:15.71,Default,,0,0,0,,Бала кезімнен бейсболдың оған еш қатысы жоқ.
Dialogue: 0,0:11:16.71,0:11:17.96,Default,,0,0,0,,Кеттік
Dialogue: 0,0:11:20.72,0:11:22.47,Default,,0,0,0,,- (Томура) Ато мырза - (Ато) А?
Dialogue: 0,0:11:22.55,0:11:26.47,Default,,0,0,0,,Томура мырза, біраз уақыт болды.
Dialogue: 0,0:11:26.56,0:11:27.89,Default,,0,0,0,,Сіз ойынды көріп отырсыз ба?
Dialogue: 0,0:11:27.97,0:11:29.48,Default,,0,0,0,,Қарап жатырсыз ба?
Dialogue: 0,0:11:30.06,0:11:32.85,Default,,0,0,0,,Сіз тағы да алаңсыз туралы айтасыз.
Dialogue: 0,0:11:32.94,0:11:34.90,Default,,0,0,0,,Мен біраз уақыттан бері болдым
Dialogue: 0,0:11:34.98,0:11:37.98,Default,,0,0,0,,Мен сіздің командаңыздың жаттығуын көрдім.
Dialogue: 0,0:11:38.07,0:11:39.03,Default,,0,0,0,,Иә
Dialogue: 0,0:11:39.11,0:11:40.53,Default,,0,0,0,,Бұрын Кадовакиден
Dialogue: 0,0:11:40.61,0:11:44.62,Default,,0,0,0,,Бірде маған отакумен ойын ойнауды тапсырды.
Dialogue: 0,0:11:44.70,0:11:47.49,Default,,0,0,0,,Ол Ниттаның құмырасын ұрғысы келеді...
Dialogue: 0,0:11:47.58,0:11:51.29,Default,,0,0,0,,Осы аралықта мен сенің айтқаныңның бәрін елемедім.
Dialogue: 0,0:11:51.37,0:11:54.25,Default,,0,0,0,,Әрине, мен де айтар едім.
Dialogue: 0,0:11:54.33,0:11:58.21,Default,,0,0,0,,Менің ойымша, бұл мен жаңа ғана соққан құмыра.
Dialogue: 0,0:11:58.30,0:11:59.59,Default,,0,0,0,,Бұл Харада.
Dialogue: 0,0:11:59.67,0:12:01.01,Default,,0,0,0,,Ұстаушы ше?
Dialogue: 0,0:12:01.09,0:12:02.72,Default,,0,0,0,,Мен Нагакурамын.
Dialogue: 0,0:12:02.80,0:12:04.89,Default,,0,0,0,,Сіз қазір екінші курс студентісіз.
Dialogue: 0,0:12:04.97,0:12:06.39,Default,,0,0,0,,Иә
Dialogue: 0,0:12:06.47,0:12:07.72,Default,,0,0,0,,Нитта Хигаши
Dialogue: 0,0:12:07.81,0:12:10.73,Default,,0,0,0,,Ол биылғы префектуралық турнирде пайда болады.
Dialogue: 0,0:12:10.81,0:12:11.77,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:12:11.85,0:12:13.52,Default,,0,0,0,,Мизугаки
Dialogue: 0,0:12:13.60,0:12:16.23,Default,,0,0,0,,Неліктен Джоно мен Хагиді негізгі құрамға шығардыңыз?
Dialogue: 0,0:12:16.31,0:12:18.77,Default,,0,0,0,,Турнирді қарастыру.
Dialogue: 0,0:12:20.36,0:12:22.78,Default,,0,0,0,,Nitta Higashi жаңа батареясы
Dialogue: 0,0:12:22.86,0:12:25.78,Default,,0,0,0,,Сен оны өз көзіңмен көруге тура келетініне сенімдімін.
Dialogue: 0,0:12:25.87,0:12:27.49,Default,,0,0,0,,Мидзугаки-кун
Dialogue: 0,0:12:27.58,0:12:29.91,Default,,0,0,0,,Сіз бұл туралы ойлай аласыз.
Dialogue: 0,0:12:29.99,0:12:31.83,Default,,0,0,0,,Бұл тамаша мүмкіндік
Dialogue: 0,0:12:31.91,0:12:35.79,Default,,0,0,0,,Yokote директоры ретінде мұқият қараңыз.
Dialogue: 0,0:12:35.88,0:12:39.34,Default,,0,0,0,,Биылғы Нитта Хигаши назар аударатын команда сияқты.
Dialogue: 0,0:12:40.17,0:12:41.88,Default,,0,0,0,,Жұмсақ болыңыз
Dialogue: 0,0:12:53.02,0:12:54.14,Default,,0,0,0,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:12:54.23,0:12:55.06,Default,,0,0,0,,Ах
Dialogue: 0,0:12:55.14,0:12:56.44,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:56.52,0:12:57.56,Default,,0,0,0,,Директор
Dialogue: 0,0:12:58.31,0:13:00.11,Default,,0,0,0,,Сен оны көруге келдің бе?
Dialogue: 0,0:13:00.19,0:13:02.40,Default,,0,0,0,,Бұл мені ренжітті.
Dialogue: 0,0:13:02.49,0:13:04.82,Default,,0,0,0,,Мен сенің ағаңның матчын көргім келеді.
Dialogue: 0,0:13:04.90,0:13:07.28,Default,,0,0,0,,Аа, бұл Аонами-кун болатын.
Dialogue: 0,0:13:07.99,0:13:09.83,Default,,0,0,0,,Атаммен қоштасу?
Dialogue: 0,0:13:10.45,0:13:13.08,Default,,0,0,0,,Мен сіздің қолдауыңызды көруге келдім.
Dialogue: 0,0:13:14.62,0:13:16.00,Default,,0,0,0,,Ағаң сені жақтай ма?
Dialogue: 0,0:13:16.08,0:13:17.46,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:13:18.33,0:13:19.54,Default,,0,0,0,,«Жақсы»
Dialogue: 0,0:13:19.63,0:13:22.76,Default,,0,0,0,,Неліктен директор қарау жағында?
Dialogue: 0,0:13:25.80,0:13:29.35,Default,,0,0,0,,...
Dialogue: 0,0:13:29.43,0:13:31.22,Default,,0,0,0,,Көп нәрсе бар.
Dialogue: 0,0:13:31.31,0:13:34.18,Default,,0,0,0,,...
Dialogue: 0,0:13:34.27,0:13:35.23,Default,,0,0,0,,О...
Dialogue: 0,0:13:37.10,0:13:38.48,Default,,0,0,0,,Директор
Dialogue: 0,0:13:40.31,0:13:42.73,Default,,0,0,0,,Бұл менің оқушыларым.
Dialogue: 0,0:13:42.82,0:13:45.07,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:13:45.15,0:13:47.36,Default,,0,0,0,,Бірақ сол «бақылаушы» болуды доғарыңыз.
Dialogue: 0,0:13:47.45,0:13:50.62,Default,,0,0,0,,Мен енді қарт адаммын
Dialogue: 0,0:13:50.70,0:13:52.62,Default,,0,0,0,,Жоқ, біз үшін.
Dialogue: 0,0:13:52.70,0:13:55.08,Default,,0,0,0,,Директор әрқашан директор.
Dialogue: 0,0:13:55.16,0:13:57.62,Default,,0,0,0,,Сіз Иока-сансыз ба?
Dialogue: 0,0:13:58.46,0:14:00.88,Default,,0,0,0,,Ол Нитта орта мектебінің директоры болды.
Dialogue: 0,0:14:00.96,0:14:02.25,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:14:02.34,0:14:06.01,Default,,0,0,0,,Жоқ, танысқаныма қуаныштымын.
Dialogue: 0,0:14:06.67,0:14:08.80,Default,,0,0,0,,Қолымды қысып жібере аласыз ба?
Dialogue: 0,0:14:12.35,0:14:15.14,Default,,0,0,0,,Нитта орта мектебі Кошиенге барған сайын
Dialogue: 0,0:14:15.22,0:14:18.02,Default,,0,0,0,,Мен теледидарға жабысып қалдым.
Dialogue: 0,0:14:18.10,0:14:21.40,Default,,0,0,0,,...
Dialogue: 0,0:14:21.48,0:14:22.77,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:14:22.86,0:14:25.90,Default,,0,0,0,,Мен мұны істегенді ұнатпаймын, бірақ оны көргенді ұнатамын.
Dialogue: 0,0:14:25.99,0:14:28.53,Default,,0,0,0,,Мен өте спортшы емеспін.
Dialogue: 0,0:14:28.61,0:14:30.03,Default,,0,0,0,,Менің денем әлсіз
Dialogue: 0,0:14:30.61,0:14:33.78,Default,,0,0,0,,Бейсболды жақсы ойнайтын жігіттерді қызғанатынмын.
Dialogue: 0,0:14:34.41,0:14:35.58,Default,,0,0,0,,№
Dialogue: 0,0:14:37.37,0:14:38.71,Default,,0,0,0,,Ағай, жоқ.
Dialogue: 0,0:14:38.79,0:14:41.67,Default,,0,0,0,,ше? Айырмашылығы неде?
Dialogue: 0,0:14:41.75,0:14:45.05,Default,,0,0,0,,Егер сіз физикалық әлсіз болсаңыз немесе дене шынықтыру сабағында нашар болсаңыз да,
Dialogue: 0,0:14:45.13,0:14:46.42,Default,,0,0,0,,Мен бейсбол ойнай аламын.
Dialogue: 0,0:14:47.80,0:14:49.93,Default,,0,0,0,,Егер сізге шынымен ұнаса, сіз жасай аласыз.
Dialogue: 0,0:14:50.51,0:14:53.80,Default,,0,0,0,,Мен бейсболды дұрыс ойнаймын және ағамды ұрдым.
Dialogue: 0,0:14:54.56,0:14:55.56,Default,,0,0,0,,Аға?
Dialogue: 0,0:14:55.64,0:14:58.18,Default,,0,0,0,,Қане, аға, қараңызшы.
Dialogue: 0,0:14:58.27,0:15:01.60,Default,,0,0,0,,Сіздің ағаларыңыз бейсбол ойнай ма?
Dialogue: 0,0:15:03.15,0:15:06.19,Default,,0,0,0,,А... бұл қызық.
Dialogue: 0,0:15:12.78,0:15:13.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:16.45,0:15:17.45,Default,,0,0,0,,Хо…
Dialogue: 0,0:15:18.04,0:15:19.46,Default,,0,0,0,,Шие гүлдері
Dialogue: 0,0:15:20.25,0:15:21.42,Default,,0,0,0,,Шие дегеніміз не?
Dialogue: 0,0:15:22.08,0:15:24.42,Default,,0,0,0,,Шие шиемен бірге гүлдейді
Dialogue: 0,0:15:28.30,0:15:30.59,Default,,0,0,0,,Қалыпты гүлден ерте гүлдейді
Dialogue: 0,0:15:30.67,0:15:31.97,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:32.05,0:15:32.89,Default,,0,0,0,,Өте ұзақ уақыттан бері көрмеппін.
Dialogue: 0,0:15:33.64,0:15:35.60,Default,,0,0,0,,Сапқа тұр!
Dialogue: 0,0:15:43.56,0:15:45.27,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:15:53.28,0:15:54.87,Default,,0,0,0,,- (Кадоваки) Харада - (Такуми) Иә.
Dialogue: 0,0:15:54.95,0:15:56.83,Default,,0,0,0,,Соңында
Dialogue: 0,0:15:57.53,0:15:58.37,Default,,0,0,0,,Иә
Dialogue: 0,0:15:58.45,0:16:01.00,Default,,0,0,0,,Мен сені мәңгі күттім
Dialogue: 0,0:16:01.08,0:16:02.87,Default,,0,0,0,,Уау, бұл ұзақ болды.
Dialogue: 0,0:16:19.31,0:16:20.14,Default,,0,0,0,,Ойнату
Dialogue: 0,0:16:26.73,0:16:28.02,Default,,0,0,0,,Доп
Dialogue: 0,0:16:28.11,0:16:29.02,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:38.99,0:16:40.16,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:16:40.95,0:16:42.16,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:16:44.08,0:16:44.92,Default,,0,0,0,,Доп
Dialogue: 0,0:16:48.00,0:16:48.92,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:16:52.92,0:16:53.76,Default,,0,0,0,,(Ханами) Кісі өлтіру ниетіне тежегіш салатын адам —
Dialogue: 0,0:17:18.95,0:17:21.62,Default,,0,0,0,,Біраз уақыт болды, балам.
Dialogue: 0,0:17:21.70,0:17:24.62,Default,,0,0,0,,Бұл №3, Мизугаки-сан.
Dialogue: 0,0:17:25.37,0:17:28.63,Default,,0,0,0,,...
Dialogue: 0,0:17:29.42,0:17:30.71,Default,,0,0,0,,Дәл бұрынғы күндегідей
Dialogue: 0,0:17:30.79,0:17:32.63,Default,,0,0,0,,Ол құламайды, солай ма?
Dialogue: 0,0:17:33.80,0:17:34.63,Default,,0,0,0,,Әрине
Dialogue: 0,0:17:35.72,0:17:38.64,Default,,0,0,0,,Цк майдың ырылдауы
Dialogue: 0,0:17:39.68,0:17:43.64,Default,,0,0,0,,Мен қырылған бас болып қалсам, мен сені сүйер едім.
Dialogue: 0,0:17:59.99,0:18:01.07,Default,,0,0,0,,(Ханами) Кісі өлтіру ниетіне тежегіш салатын адам —
Dialogue: 0,0:18:01.78,0:18:02.83,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:18:05.91,0:18:07.08,Default,,0,0,0,,Жақсы питтинг
Dialogue: 0,0:18:13.17,0:18:14.09,Default,,0,0,0,,Барлығы жақсы болады, иә?
Dialogue: 0,0:18:14.71,0:18:17.01,Default,,0,0,0,,Кайондзи мырза келе жатыр.
Dialogue: 0,0:18:17.09,0:18:18.05,Default,,0,0,0,,О
Dialogue: 0,0:18:20.97,0:18:24.43,Default,,0,0,0,,...
Dialogue: 0,0:18:25.68,0:18:27.02,Default,,0,0,0,,Такацуки
Dialogue: 0,0:18:27.60,0:18:29.60,Default,,0,0,0,,Лақтырғың келе ме?
Dialogue: 0,0:18:29.69,0:18:30.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:30.60,0:18:32.90,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:18:32.98,0:18:35.23,Default,,0,0,0,,Мен бұл туралы ерекше емеспін.
Dialogue: 0,0:18:35.32,0:18:36.32,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:36.40,0:18:39.49,Default,,0,0,0,,Үйінді – шағын жер.
Dialogue: 0,0:18:40.45,0:18:42.87,Default,,0,0,0,,Маған жер ұнайды.
Dialogue: 0,0:18:44.28,0:18:45.12,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:18:45.20,0:18:48.12,Default,,0,0,0,,...
Dialogue: 0,0:18:48.21,0:18:50.08,Default,,0,0,0,,Маған жер ұнайды
Dialogue: 0,0:18:50.17,0:18:51.38,Default,,0,0,0,,Сәлем Харада
Dialogue: 0,0:18:51.46,0:18:54.13,Default,,0,0,0,,Қорған кішкентай, солай емес пе?
Dialogue: 0,0:18:54.21,0:18:56.88,Default,,0,0,0,,...
Dialogue: 0,0:18:56.96,0:18:59.55,Default,,0,0,0,,Түсіндім, сен солай ойламайсың ба?
Dialogue: 0,0:18:59.63,0:19:00.47,Default,,0,0,0,,Иә
Dialogue: 0,0:18:59.63,0:19:00.47,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:19:00.47,0:19:01.01,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:19:03.72,0:19:05.26,Default,,0,0,0,,Екі шықты ма?
Dialogue: 0,0:19:06.31,0:19:08.52,Default,,0,0,0,,Көп болды, Кайондзи-сан.
Dialogue: 0,0:19:08.60,0:19:10.31,Default,,0,0,0,,Бұл Джоно болатын.
Dialogue: 0,0:19:10.39,0:19:12.48,Default,,0,0,0,,Иә, мен оны асыға күттім.
Dialogue: 0,0:19:12.56,0:19:13.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:15.77,0:19:17.03,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:19:28.75,0:19:30.29,Default,,0,0,0,,-（） -（）
Dialogue: 0,0:19:32.21,0:19:33.29,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:33.38,0:19:34.67,Default,,0,0,0,,Кайондзи храмы
Dialogue: 0,0:19:34.75,0:19:37.88,Default,,0,0,0,,Орталық Таоканың иықтары елдегі ең жақсы
Dialogue: 0,0:19:37.96,0:19:39.01,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:19:39.09,0:19:42.59,Default,,0,0,0,,...
Dialogue: 0,0:19:42.68,0:19:44.55,Default,,0,0,0,,Бізде тек 1 ұпай бар, бұл жақсы.
Dialogue: 0,0:19:44.64,0:19:46.47,Default,,0,0,0,,Мен қатты уайымдасам да
Dialogue: 0,0:19:46.56,0:19:47.93,Default,,0,0,0,,Мен айтамын.
Dialogue: 0,0:19:49.93,0:19:51.35,Default,,0,0,0,,Сәлем Мизугаки
Dialogue: 0,0:19:52.39,0:19:55.65,Default,,0,0,0,,Бейсбол өте қызықты.
Dialogue: 0,0:19:55.73,0:19:56.98,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:58.90,0:20:00.74,Default,,0,0,0,,Йокоте күткендей.
Dialogue: 0,0:20:00.82,0:20:01.70,Default,,0,0,0,,О
Dialogue: 0,0:20:06.37,0:20:07.91,Default,,0,0,0,,Сәлем досым
Dialogue: 0,0:20:07.99,0:20:08.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:10.83,0:20:12.58,Default,,0,0,0,,Такумиге барайық
Dialogue: 0,0:20:12.66,0:20:15.13,Default,,0,0,0,,Бұл ұзақ болды, Шуго.
Dialogue: 0,0:20:15.21,0:20:16.29,Default,,0,0,0,,О
Dialogue: 0,0:20:16.38,0:20:17.63,Default,,0,0,0,,Жоспар
Dialogue: 0,0:20:25.89,0:20:27.05,Default,,0,0,0,,Харада…
Dialogue: 0,0:20:37.56,0:20:39.86,Default,,0,0,0,,Шуго Кадоваки...
Dialogue: 0,0:20:55.25,0:20:57.13,Default,,0,0,0,,Мынау.
Dialogue: 0,0:21:03.76,0:21:08.76,Default,,0,0,0,,♪～
Dialogue: 0,0:21:20.73,0:21:21.78,Default,,0,0,0,,Такуми
Dialogue: 0,0:22:46.23,0:22:51.95,Default,,0,0,0,,～♪
Dialogue: 0,0:22:52.03,0:22:53.91,Default,,0,0,0,,(доп соғу дыбысы)
