Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:26.36,0:00:29.84,Default,,0,0,0,,Менің алғашқы махаббатым – фильмдер! Бұл Cinema Boy Seishiro Kato.
Dialogue: 0,0:00:29.84,0:00:31.83,Default,,0,0,0,,Бүгінгі фильм осында!
Dialogue: 0,0:00:46.34,0:00:48.33,Default,,0,0,0,,Ескі деп құртқыңыз келсе...
Dialogue: 0,0:00:48.33,0:00:50.35,Default,,0,0,0,,Ұнамаса, анық айт.
Dialogue: 0,0:00:50.35,0:00:52.35,Default,,0,0,0,,<түзу және кінәсіз→
Dialogue: 0,0:00:52.35,0:00:54.35,Default,,0,0,0,,Жастық махаббат хикаясы＞
Dialogue: 0,0:04:34.81,0:05:58.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:58.32,0:06:02.38,Default,,0,0,0,,♪♪~ Қазан солқылдақ, қазан салбырап
Dialogue: 0,0:06:02.38,0:06:05.83,Default,,0,0,0,,♪♪~ Кесетін тақталар тонна
Dialogue: 0,0:06:05.83,0:06:09.82,Default,,0,0,0,,♪♪~ Тофу Фуруфуру жұмыртқасы дірілдеп тұр
Dialogue: 0,0:06:09.82,0:06:13.80,Default,,0,0,0,,♪♪~ Натто жабысқақ
Dialogue: 0,0:06:13.80,0:06:17.82,Default,,0,0,0,,♪♪~ Жұмыртқаны ыстық табаға құйыңыз.
Dialogue: 0,0:06:17.82,0:06:21.36,Default,,0,0,0,,♪♪~ Мисоны кастрюльге салыңыз
Dialogue: 0,0:06:21.36,0:06:25.33,Default,,0,0,0,,♪♪~ Ыстық күрішті күріш ыдысына құйыңыз.
Dialogue: 0,0:06:25.33,0:06:28.80,Default,,0,0,0,,♪♪～ Дайындық жақсы жүріп жатыр.
Dialogue: 0,0:06:28.80,0:06:32.82,Default,,0,0,0,,♪♪~ Барлығын ояту
Dialogue: 0,0:06:32.82,0:06:36.81,Default,,0,0,0,,♪♪~ Барлығы бірге болғанда
Dialogue: 0,0:06:36.81,0:06:40.86,Default,,0,0,0,,♪♪~ Жүр, көп тамақтанайық
Dialogue: 0,0:06:40.86,0:06:44.32,Default,,0,0,0,,♪♪~ Күн де жарқырап тұр
Dialogue: 0,0:06:44.32,0:06:47.82,Default,,0,0,0,,♪♪~ Таңғы ас бірге
Dialogue: 0,0:06:47.82,0:06:50.82,Default,,0,0,0,,♪♪~ Мен жасадым
Dialogue: 0,0:06:50.82,0:06:55.81,Default,,0,0,0,,♪♪~ Асығыңыз, асығыңыз
Dialogue: 0,0:06:55.81,0:06:59.35,Default,,0,0,0,,♪♪~ Бірақ дәмін көріңіз.
Dialogue: 0,0:06:59.35,0:07:03.30,Default,,0,0,0,,♪♪~ Бірге таңғы ас
Dialogue: 0,0:07:03.30,0:07:06.82,Default,,0,0,0,,♪♪~ Мен жасадым
Dialogue: 0,0:07:06.82,0:07:10.81,Default,,0,0,0,,♪♪~ Асығыңыз, асығыңыз
Dialogue: 0,0:07:10.81,0:07:14.83,Default,,0,0,0,,♪♪~ Бірақ дәмін көріңіз.
Dialogue: 0,0:07:14.83,0:07:26.33,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:35.32,0:07:37.30,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:07:37.30,0:07:39.82,Default,,0,0,0,,Қайырлы таң, Сора, ояусың ба?
Dialogue: 0,0:07:39.82,0:07:42.83,Default,,0,0,0,,Айна алдында. (Хокуто) Қайырлы таң.
Dialogue: 0,0:07:42.83,0:07:44.86,Default,,0,0,0,,Қайырлы таң. қайырлы таң.
Dialogue: 0,0:07:44.86,0:07:46.90,Default,,0,0,0,,Ахх.
Dialogue: 0,0:07:46.90,0:07:49.82,Default,,0,0,0,,Хокуто мырза, сіз де кеше кешіктіңіз бе?
Dialogue: 0,0:07:49.82,0:07:52.30,Default,,0,0,0,,Бүгін тағы да кеш.
Dialogue: 0,0:07:52.30,0:07:54.82,Default,,0,0,0,,Кешкі асты сақтағыңыз келе ме?
Dialogue: 0,0:07:54.82,0:07:56.81,Default,,0,0,0,,Кешіріңіз, өтінемін.
Dialogue: 0,0:07:56.81,0:08:00.83,Default,,0,0,0,,Мелдің әртүрлі түрлері бар. (Хокуто) Осы аптада бізде жұмыс күші жетіспейді.
Dialogue: 0,0:08:00.83,0:08:03.31,Default,,0,0,0,,Үлкен апа, менің шұлығым тесіліп қалды.
Dialogue: 0,0:08:03.31,0:08:05.35,Default,,0,0,0,,Оны тігін машинасына шығарыңыз.
Dialogue: 0,0:08:05.35,0:08:08.42,Default,,0,0,0,,Көбінесе тесіктер болады. (Рику) Бұл менің кінәм емес →
Dialogue: 0,0:08:08.42,0:08:11.32,Default,,0,0,0,,Ол тез кішірейеді. Иә, бұл жер.
Dialogue: 0,0:08:11.32,0:08:14.32,Default,,0,0,0,,Үлкен әпке! Түскі ас қорабын мықтап орап алыңыз.
Dialogue: 0,0:08:14.32,0:08:16.81,Default,,0,0,0,,Әлі де жеткіліксіз бе? Иә.
Dialogue: 0,0:08:16.81,0:08:19.81,Default,,0,0,0,,Рику-чан, мен саған қуырылған жұмыртқамды беремін.
Dialogue: 0,0:08:19.81,0:08:23.80,Default,,0,0,0,,Иә! Жоқ, Хокуто-сан, мен жеуім керек.
Dialogue: 0,0:08:23.80,0:08:27.30,Default,,0,0,0,,Қайсысы дәрігер екенін білмеймін.
Dialogue: 0,0:08:28.91,0:08:31.81,Default,,0,0,0,,Уау! Сол көп соя соусын қайтадан қосыңыз.
Dialogue: 0,0:08:31.81,0:08:34.29,Default,,0,0,0,,Бұл жақсы емес пе? (Рику) Мен де.
Dialogue: 0,0:08:34.29,0:08:36.83,Default,,0,0,0,,Қазірдің өзінде! (Хокуто) Хи хи хи....
Dialogue: 0,0:08:36.83,0:08:39.82,Default,,0,0,0,,Хирокоджи мырза! Кешкі ас!
Dialogue: 0,0:08:39.82,0:08:41.80,Default,,0,0,0,,≪Иә! ≫
Dialogue: 0,0:08:41.80,0:08:45.82,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:08:50.41,0:08:53.80,Default,,0,0,0,,Анаңның үлесін Рику мен Хирокодзиге бөл.
Dialogue: 0,0:08:53.80,0:08:55.30,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:08:55.30,0:08:57.82,Default,,0,0,0,,Әже, шәй қайнатқанымды қалайсыз ба?
Dialogue: 0,0:08:57.82,0:09:00.32,Default,,0,0,0,,Жақсы, мен оны аяқтадым.
Dialogue: 0,0:09:02.81,0:09:06.31,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:09:08.83,0:09:10.33,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:09:15.82,0:09:18.32,Default,,0,0,0,,Барлығыңыз, рахат алыңыз.
Dialogue: 0,0:09:18.32,0:09:20.32,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:09:23.33,0:09:24.83,Default,,0,0,0,,Кеш келу.
Dialogue: 0,0:09:24.83,0:09:28.30,Default,,0,0,0,,Өйткені шашым орнында тұрмайды.
Dialogue: 0,0:09:28.30,0:09:30.80,Default,,0,0,0,,Бұл жеткілікті әдемі.
Dialogue: 0,0:09:33.40,0:09:35.32,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:09:35.32,0:09:37.81,Default,,0,0,0,,Хокуто-сан бүгін де кешікті ме? (Хокуто) Иә.
Dialogue: 0,0:09:37.81,0:09:40.31,Default,,0,0,0,,Медициналық резидент болу қиын.
Dialogue: 0,0:09:40.31,0:10:37.90,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:37.90,0:10:40.82,Default,,0,0,0,,≪Мен келемін! ≫ Қош келдіңіз!
Dialogue: 0,0:10:40.82,0:11:04.31,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:04.31,0:11:07.31,Default,,0,0,0,,Қайырлы таң. (Томоко) Қайырлы таң.
Dialogue: 0,0:11:07.31,0:11:09.83,Default,,0,0,0,,Уми-чан, атқа мінгің келе ме?
Dialogue: 0,0:11:09.83,0:11:12.84,Default,,0,0,0,,Рахмет. Жарайды. Мен түсінемін. Сонда кездескенше.
Dialogue: 0,0:11:12.84,0:11:15.36,Default,,0,0,0,,Жуып, кептіріңіз.
Dialogue: 0,0:11:15.36,0:11:17.39,Default,,0,0,0,,Жарайды, келіңдер.
Dialogue: 0,0:11:17.39,0:11:19.31,Default,,0,0,0,,Мен барамын.
Dialogue: 0,0:11:19.31,0:11:41.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:41.30,0:11:43.32,Default,,0,0,0,,Кел, кел, кел.
Dialogue: 0,0:11:43.32,0:11:44.82,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:11:44.82,0:11:46.82,Default,,0,0,0,,Қараңызшы, бұл Мел туралы емес пе?
Dialogue: 0,0:11:46.82,0:11:50.32,Default,,0,0,0,,Бұл сөзсіз дұрыс. Ту ұстаған жалғыз Мел.
Dialogue: 0,0:12:00.32,0:12:02.82,Default,,0,0,0,,Әй, солай емес пе? Сіз Мел туралы айтып отырсыз, солай ма?
Dialogue: 0,0:12:02.82,0:12:04.30,Default,,0,0,0,,А... иә.
Dialogue: 0,0:12:04.30,0:12:06.81,Default,,0,0,0,,Мацузаки туралы болды→
Dialogue: 0,0:12:06.81,0:12:09.33,Default,,0,0,0,,Бөтелкені теңізге лақтырғанмен бірдей.
Dialogue: 0,0:12:09.33,0:12:12.33,Default,,0,0,0,,Әй, не! Математика бөліміндегі қызық!
Dialogue: 0,0:12:12.33,0:12:15.35,Default,,0,0,0,,Йошино-кун латын кварталының тұрғыны, солай ма?
Dialogue: 0,0:12:15.35,0:12:17.40,Default,,0,0,0,,Дұрыс. (есіктің ашылған дыбысы)
Dialogue: 0,0:12:17.40,0:12:18.90,Default,,0,0,0,,≪Тұр! ≫
Dialogue: 0,0:12:24.32,0:12:27.32,Default,,0,0,0,,Менде сол үстел бар. Түсіндім.
Dialogue: 0,0:12:28.83,0:12:30.33,Default,,0,0,0,,Карри удон адам!
Dialogue: 0,0:12:31.82,0:12:34.82,Default,,0,0,0,,Нобуко! Міне, міне!
Dialogue: 0,0:12:34.82,0:12:37.82,Default,,0,0,0,,Күткеніңізге рахмет. Тағы да карри удон?
Dialogue: 0,0:12:37.82,0:12:39.86,Default,,0,0,0,,Жарайды, маған ұнайды.
Dialogue: 0,0:12:39.86,0:12:42.41,Default,,0,0,0,,Бұл Юко әлі нан емес пе?
Dialogue: 0,0:12:42.41,0:12:44.31,Default,,0,0,0,,Жарайды, өйткені маған ұнайды.
Dialogue: 0,0:12:44.31,0:12:46.31,Default,,0,0,0,,Mel's әдеттегідей дәмді көрінеді.
Dialogue: 0,0:12:46.31,0:12:49.32,Default,,0,0,0,,Нобуконы өзіңіз де жасауға болады. (Юко) Мен шыдай алмаймын.
Dialogue: 0,0:12:49.32,0:12:52.32,Default,,0,0,0,,Маған ұнаса, менде тек қана бенто қорапшасы болады...
Dialogue: 0,0:12:53.30,0:12:55.82,Default,,0,0,0,,О! Жақсы!
Dialogue: 0,0:12:55.82,0:12:57.82,Default,,0,0,0,,Жоқ, бұл не туралы?
Dialogue: 0,0:12:59.34,0:13:06.33,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:06.33,0:13:07.82,Default,,0,0,0,,Ол бұрын Алл Майттың көмекшісі болған —
Dialogue: 0,0:13:07.82,0:13:10.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:10.32,0:13:12.81,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:12.81,0:13:16.83,Default,,0,0,0,,Вассе Вассе Вассе….
Dialogue: 0,0:13:16.83,0:13:18.83,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:13:19.83,0:13:22.33,Default,,0,0,0,,Балалар, уақыт келді.
Dialogue: 0,0:13:24.42,0:13:26.30,Default,,0,0,0,,Ах! Ол бұзылды!
Dialogue: 0,0:13:26.30,0:13:28.30,Default,,0,0,0,,Барыңыз.
Dialogue: 0,0:13:32.31,0:13:33.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.33,0:13:38.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:38.82,0:13:40.83,Default,,0,0,0,,Ай!
Dialogue: 0,0:13:40.83,0:13:42.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:42.35,0:13:43.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:49.83,0:13:55.33,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:13:58.84,0:14:00.32,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:14:00.32,0:14:03.82,Default,,0,0,0,,Керемет! Бұл дәстүрдің жаңғыруы!
Dialogue: 0,0:14:06.39,0:14:08.31,Default,,0,0,0,,Екеуің осы жаққа бұрылыңдар.
Dialogue: 0,0:14:08.31,0:14:10.31,Default,,0,0,0,,(камера ысырмасының дыбысы)
Dialogue: 0,0:14:11.31,0:14:13.83,Default,,0,0,0,,Ах! (Оқушылар) Ах!
Dialogue: 0,0:14:13.83,0:14:15.80,Default,,0,0,0,,Бұл керемет болды.
Dialogue: 0,0:14:15.80,0:14:17.82,Default,,0,0,0,,Мел, жақсысың ба?
Dialogue: 0,0:14:17.82,0:14:19.82,Default,,0,0,0,,Ақымақ сияқты!
Dialogue: 0,0:14:25.90,0:14:29.32,Default,,0,0,0,,Қазір! (Томоко) ≪Қош келдіңіз! ≫
Dialogue: 0,0:14:29.32,0:14:32.32,Default,,0,0,0,,Аа, кешіріңіз. Жарайды.
Dialogue: 0,0:14:35.31,0:14:37.32,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:14:37.32,0:14:39.33,Default,,0,0,0,,Бүгінгі күнгі скумбрия арзан болды.
Dialogue: 0,0:14:39.33,0:14:41.31,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:14:41.31,0:14:43.31,Default,,0,0,0,,Қуырайық.
Dialogue: 0,0:14:43.31,0:14:45.81,Default,,0,0,0,,Мен біраз уақытқа әжемнің үйіне барамын.
Dialogue: 0,0:14:53.82,0:14:57.32,Default,,0,0,0,,≪Үми әже≫ Кіріңіз.
Dialogue: 0,0:15:08.86,0:15:10.89,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:15:10.89,0:15:13.33,Default,,0,0,0,,Сіздің қызыл түсте болмағаныңыз өте жақсы.
Dialogue: 0,0:15:13.33,0:15:15.81,Default,,0,0,0,,Томоконың жалақысы →
Dialogue: 0,0:15:15.81,0:15:18.30,Default,,0,0,0,,Себебі оны маған әжем береді.
Dialogue: 0,0:15:18.30,0:15:19.80,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:15:19.80,0:15:23.82,Default,,0,0,0,,Мен пансионатты басқармасам да, мен бастапқыда адамдарды қонаққа шақыруды жоспарладым.
Dialogue: 0,0:15:23.82,0:15:27.32,Default,,0,0,0,,Айтпақшы, Уми мырза, жақсысыз ба?
Dialogue: 0,0:15:27.32,0:15:29.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:29.38,0:15:31.41,Default,,0,0,0,,Ауыртпайды ма?
Dialogue: 0,0:15:31.41,0:15:35.32,Default,,0,0,0,,Барлығы менімен бірге болса, өзімді жалғыз сезінудің қажеті жоқ.
Dialogue: 0,0:15:35.32,0:15:37.32,Default,,0,0,0,,Сіз білесіз...→
Dialogue: 0,0:15:37.32,0:15:42.31,Default,,0,0,0,,Ту тіккеніңді көргенде, жүрегім ауырады.
Dialogue: 0,0:15:42.31,0:15:46.81,Default,,0,0,0,,Мен әкемді қатты сағындым деп ойлаймын.
Dialogue: 0,0:15:46.81,0:15:49.33,Default,,0,0,0,,Мен тамаша адамды таптым →
Dialogue: 0,0:15:49.33,0:15:52.83,Default,,0,0,0,,Ту көтерудің қажеті жоқ еді.
Dialogue: 0,0:15:53.92,0:15:56.92,Default,,0,0,0,,≪ханым≫ (гүл) Өтінемін.
Dialogue: 0,0:15:58.32,0:16:02.82,Default,,0,0,0,,Бүгінгі күн үшін кешірім сұраймын. (Гүл) Иә, еңбектеріңізге рахмет.
Dialogue: 0,0:16:04.33,0:16:07.33,Default,,0,0,0,,Мен кешкі ас дайындаймын.
Dialogue: 0,0:16:09.30,0:16:11.85,Default,,0,0,0,,(жылжымалы есіктің жабылу дыбысы)
Dialogue: 0,0:16:11.85,0:16:13.39,Default,,0,0,0,,Аа...
Dialogue: 0,0:16:13.39,0:16:38.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:38.38,0:16:39.90,Default,,0,0,0,,♪♪~ Ах….
Dialogue: 0,0:16:39.90,0:16:41.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:41.83,0:16:43.32,Default,,0,0,0,,♪♪~ Ах...!
Dialogue: 0,0:16:43.32,0:16:46.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:46.32,0:16:52.81,Default,,0,0,0,,♪♪～ (бу ысқырығы)
Dialogue: 0,0:16:52.81,0:17:13.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:13.81,0:17:16.80,Default,,0,0,0,,Уау, бұл керемет.
Dialogue: 0,0:17:16.80,0:17:19.32,Default,,0,0,0,,Дұрыс, сондықтан мен бірінші курстың қызымын →
Dialogue: 0,0:17:19.32,0:17:22.36,Default,,0,0,0,,Мен Казама-сан үшін фан-клуб ашу туралы айтып отырмын.
Dialogue: 0,0:17:22.36,0:17:24.39,Default,,0,0,0,,Сәлем. Сіз жақсы адамсыз ба?
Dialogue: 0,0:17:24.39,0:17:25.81,Default,,0,0,0,,Міне →
Dialogue: 0,0:17:25.81,0:17:28.81,Default,,0,0,0,,Бұл мені жансыз етеді. (Хирокоджи) Электроника дүкені ме?
Dialogue: 0,0:17:28.81,0:17:30.81,Default,,0,0,0,,Хахаха! Эй, бұл не, Хиро-чан?
Dialogue: 0,0:17:30.81,0:17:43.89,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:43.89,0:17:45.81,Default,,0,0,0,,♪♪~ Аа….
Dialogue: 0,0:17:45.81,0:17:56.31,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:57.31,0:18:02.38,Default,,0,0,0,,«Қыз, туыңды неге көтеріп тұрсың?».
Dialogue: 0,0:18:02.38,0:18:09.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:46.81,0:20:49.31,Default,,0,0,0,,Міне, осылайша Уоллахия княздігі →
Dialogue: 0,0:20:49.31,0:20:52.30,Default,,0,0,0,,Османлы Түркия мен Ресей арасындағы→
Dialogue: 0,0:20:52.30,0:20:56.80,Default,,0,0,0,,Ол әрқашан екі ұлы державаның аумақтық амбицияларының объектісі болды.
Dialogue: 0,0:20:59.41,0:21:07.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:07.80,0:21:09.32,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:21:09.32,0:21:11.32,Default,,0,0,0,,Аспан Не болды?
Dialogue: 0,0:21:12.80,0:21:16.30,Default,,0,0,0,,Мен мұны 30 иенге сатып алдым, хаха!
Dialogue: 0,0:21:17.81,0:21:20.33,Default,,0,0,0,,30 иен... Мынадай фото ма?
Dialogue: 0,0:21:20.33,0:21:21.86,Default,,0,0,0,,Керемет, солай ма?
Dialogue: 0,0:21:21.86,0:21:23.90,Default,,0,0,0,,Мен оны сатып алдым және қол қойылғанын қалаймын.
Dialogue: 0,0:21:23.90,0:21:26.30,Default,,0,0,0,,Эй, мен Казама-санның орнына барамын. Менімен жүр.
Dialogue: 0,0:21:26.30,0:21:28.30,Default,,0,0,0,,Ол жаққа жалғыз бару қиын...
Dialogue: 0,0:21:28.30,0:21:30.80,Default,,0,0,0,,Жоқ, мен де ол жерде ешқашан болған емеспін.
Dialogue: 0,0:21:30.80,0:21:32.80,Default,,0,0,0,,Өтінемін! Жоқ.
Dialogue: 0,0:21:33.79,0:21:35.81,Default,,0,0,0,,Әпке, өтінемін!
Dialogue: 0,0:21:35.81,0:21:39.31,Default,,0,0,0,,Сәлем! Эй! өтінемін!
Dialogue: 0,0:21:41.33,0:21:45.40,Default,,0,0,0,,≪Конституциялық биліктегі саяси партиялар халыққа қарайды→
Dialogue: 0,0:21:45.40,0:21:47.80,Default,,0,0,0,,Біз жауапкершілікті құрметтеуіміз керек≫
Dialogue: 0,0:21:47.80,0:21:50.29,Default,,0,0,0,,≪Әсіресе саяси партиялар кабинеттері дәуірінде→
Dialogue: 0,0:21:50.29,0:21:53.29,Default,,0,0,0,,Ол далада жүргенде халыққа қандай саясатты жариялады?→
Dialogue: 0,0:21:53.29,0:21:57.41,Default,,0,0,0,,Таңертең оянған соң, сіз мұны орындауға жауаптысыз...≫
Dialogue: 0,0:21:57.41,0:21:59.91,Default,,0,0,0,,Кеттік. Иә.
Dialogue: 0,0:22:01.32,0:22:05.81,Default,,0,0,0,,≪Саяси партиялар кабинетінің маңызы ашыла бастады≫
Dialogue: 0,0:22:05.81,0:22:07.31,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:22:07.31,0:22:09.33,Default,,0,0,0,,Бүгінгі күннің дақтары әсіресе керемет.
Dialogue: 0,0:22:09.33,0:22:11.81,Default,,0,0,0,,Не керек, олар бір қатарға тізіліп тұрады.
Dialogue: 0,0:22:11.81,0:22:13.81,Default,,0,0,0,,Күннің магнит өрісін сезбе.
Dialogue: 0,0:22:13.81,0:22:16.37,Default,,0,0,0,,Кешіріңіз! Бұл не?
Dialogue: 0,0:22:16.37,0:22:19.30,Default,,0,0,0,,Weekly Quartier Latin журналының редакциясы қайда орналасқан?
Dialogue: 0,0:22:19.30,0:22:22.31,Default,,0,0,0,,3 қабат Археологиялық зерттеу кабинеті.
Dialogue: 0,0:22:22.31,0:22:24.31,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:22:28.31,0:22:31.81,Default,,0,0,0,,≪Көптеген басқа саясаттар бар, үлкенді-кішілі→
Dialogue: 0,0:22:31.81,0:22:36.39,Default,,0,0,0,,Алайда, мұқият қарайтын болсақ, олардың саясатын не деп атайды→
Dialogue: 0,0:22:36.39,0:22:40.31,Default,,0,0,0,,Бұл саясат тақырыптарын тізімдейтін бос нембутсу ғана...≫
Dialogue: 0,0:22:40.31,0:22:44.31,Default,,0,0,0,,Қызық, сіз оны әлі тазалаған жоқсыз ба? Апыр-ай….
Dialogue: 0,0:22:45.80,0:22:48.80,Default,,0,0,0,,≪Егер сізде шын жүректен мұны істеуге шын ниетіңіз болмаса→
Dialogue: 0,0:22:48.80,0:22:51.30,Default,,0,0,0,,Ынта деген жоқ! ≫
Dialogue: 0,0:22:52.32,0:23:03.33,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:03.33,0:23:04.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:04.81,0:23:07.82,Default,,0,0,0,,Йошино мырза, Археологиялық зерттеу институты қайда орналасқан?
Dialogue: 0,0:23:07.82,0:23:11.80,Default,,0,0,0,,Осының үстінде әдебиет үйірмесінің маңдайшасы бар.
Dialogue: 0,0:23:11.80,0:23:13.82,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:23:13.82,0:23:15.32,Default,,0,0,0,,Иә.
Dialogue: 0,0:23:15.32,0:23:23.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:23.30,0:23:24.80,Default,,0,0,0,,Ах! (Аспан) Уау!
Dialogue: 0,0:23:24.80,0:23:29.31,Default,,0,0,0,,Ей, келдің! Жас философия студенті, мен көптен күттім.
Dialogue: 0,0:23:29.31,0:23:30.81,Default,,0,0,0,,Не...?
Dialogue: 0,0:23:30.81,0:23:33.81,Default,,0,0,0,,Жаңа мүшелерді күткенімізге қанша жыл болды?
Dialogue: 0,0:23:33.81,0:23:36.83,Default,,0,0,0,,Еңбегім бекер болған жоқ!
Dialogue: 0,0:23:36.83,0:23:41.42,Default,,0,0,0,,Мм... жоқ... Мен Археология институтындағы әдебиет үйірмесі бөлмесіне бара жатырмын.
Dialogue: 0,0:23:41.42,0:23:43.30,Default,,0,0,0,,Жарайды, ұстанба.
Dialogue: 0,0:23:43.30,0:23:45.82,Default,,0,0,0,,Экзистенциализмге тоқталайық.
Dialogue: 0,0:23:45.82,0:23:47.81,Default,,0,0,0,,Немесе Ницше болуы мүмкін.
Dialogue: 0,0:23:47.81,0:23:49.31,Default,,0,0,0,,Уау!?
Dialogue: 0,0:23:49.31,0:23:51.31,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:23:51.31,0:23:54.31,Default,,0,0,0,,Кәкеңе, ойыңдағы кедергілерден арыл!
Dialogue: 0,0:23:54.31,0:23:58.33,Default,,0,0,0,,Балалар, мұнымен тоқтап қалмаңдар. Ұстасаңыз, көп уақыт кетеді.
Dialogue: 0,0:23:58.33,0:24:01.90,Default,,0,0,0,,Не айту керек! Кёгаку Айоның бейбақтары!
Dialogue: 0,0:24:01.90,0:24:04.81,Default,,0,0,0,,Дәлелдеуге келмейтін бос теориялармен айналысатындарға→
Dialogue: 0,0:24:04.81,0:24:06.83,Default,,0,0,0,,Мені қорлағаным есімде жоқ!
Dialogue: 0,0:24:06.83,0:24:09.80,Default,,0,0,0,,<<Жаңа ақын, бұлттан, жарықтан, бораннан→
Dialogue: 0,0:24:09.80,0:24:11.80,Default,,0,0,0,,Мөлдір энергияны алу...≫
Dialogue: 0,0:24:11.80,0:24:14.80,Default,,0,0,0,,Адамдар мен жер жасауы керек пішінді ұсыныңыз.
Dialogue: 0,0:24:14.80,0:24:18.82,Default,,0,0,0,,Жаңа дәуірдегі Коперник, тым ауыр...
Dialogue: 0,0:24:18.82,0:24:21.37,Default,,0,0,0,,А, сезімталдық болды. О...
Dialogue: 0,0:24:21.37,0:24:23.29,Default,,0,0,0,,Бұл Жапониядан келген орта мектеп оқушысы.
Dialogue: 0,0:24:23.29,0:24:50.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:50.80,0:24:52.30,Default,,0,0,0,,болды.
Dialogue: 0,0:24:52.30,0:24:53.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:54.79,0:24:56.29,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:24:56.29,0:24:58.84,Default,,0,0,0,,Мацузаки мырза. Ямадзаки мырза.
Dialogue: 0,0:24:58.84,0:25:01.91,Default,,0,0,0,,Директор! Сіз сирек тұтынушысыз!
Dialogue: 0,0:25:01.91,0:25:03.41,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:25:07.30,0:25:09.32,Default,,0,0,0,,Әдебиет үйірмесіне қош келдіңіздер.
Dialogue: 0,0:25:09.32,0:25:11.29,Default,,0,0,0,,No Археология институты?
Dialogue: 0,0:25:11.29,0:25:14.29,Default,,0,0,0,,Амал жоқ, жалған апталық Quartier Latin газеті→ Менің ойымша, бұл
Dialogue: 0,0:25:14.29,0:25:15.80,Default,,0,0,0,,үшін емес.
Dialogue: 0,0:25:15.80,0:25:17.30,Default,,0,0,0,,Тоқта, Мизунума.
Dialogue: 0,0:25:17.30,0:25:19.30,Default,,0,0,0,,Енгізіңіз... Ах.
Dialogue: 0,0:25:22.85,0:25:25.40,Default,,0,0,0,,Сонда біздің клуб тоқтатылған клуб емес пе?
Dialogue: 0,0:25:25.40,0:25:28.90,Default,,0,0,0,,Дұрыс, біздің клубта екі-ақ адам бар, сен және мен...
Dialogue: 0,0:25:30.33,0:25:32.33,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:25:33.80,0:25:36.80,Default,,0,0,0,,Қол қойыңыз! иә?
Dialogue: 0,0:25:36.80,0:25:39.30,Default,,0,0,0,,Жасай бер, батыр.
Dialogue: 0,0:25:48.41,0:25:51.31,Default,,0,0,0,,Хмм…. рақмет сізге!
Dialogue: 0,0:25:51.31,0:25:52.82,Default,,0,0,0,,Сол қол….
Dialogue: 0,0:25:52.82,0:25:57.32,Default,,0,0,0,,Бұл сол кезден емес. Мені мысық тырнап алды.
Dialogue: 0,0:25:58.30,0:25:59.81,Default,,0,0,0,,Мысық па?
Dialogue: 0,0:25:59.81,0:26:03.33,Default,,0,0,0,,Дұрыс, Шун үшін сайды аздап кесіп жіберсеңіз?
Dialogue: 0,0:26:03.33,0:26:04.83,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:26:04.83,0:26:08.90,Default,,0,0,0,,Өйткені, жұмыс күші жетіспейді, мен студенттер кеңесімен айналысамын.
Dialogue: 0,0:26:08.90,0:26:12.80,Default,,0,0,0,,Сіз менің әпкемсіз бе? Иә, Мацузаки Сора.
Dialogue: 0,0:26:12.80,0:26:16.82,Default,,0,0,0,,Әпке, сізге көмектессем қалай болады? Менің қолжазбам нашар.
Dialogue: 0,0:26:16.82,0:26:18.81,Default,,0,0,0,,Не айтып тұрсың, Аспан?
Dialogue: 0,0:26:18.81,0:26:20.31,Default,,0,0,0,,Мен….
Dialogue: 0,0:26:22.31,0:26:25.31,Default,,0,0,0,,Сіз екінші курстасыз, физикадан жақсы емессіз бе?
Dialogue: 0,0:26:25.31,0:26:27.83,Default,,0,0,0,,Бұл профессор Сузуки.
Dialogue: 0,0:26:27.83,0:26:29.87,Default,,0,0,0,,Бұл пайдалы.
Dialogue: 0,0:26:29.87,0:26:33.81,Default,,0,0,0,,Өйткені бұл мектептің бірінші тауы Мизунума-доно тауды кесіп өтті.
Dialogue: 0,0:26:33.81,0:26:37.83,Default,,0,0,0,,Дұрыс, қалған 17% сіздің бақытыңыз.
Dialogue: 0,0:26:37.83,0:26:39.80,Default,,0,0,0,,Хэхехе...
Dialogue: 0,0:26:39.80,0:26:42.31,Default,,0,0,0,,Сол кезде сағат 6. аа.
Dialogue: 0,0:26:42.31,0:26:45.31,Default,,0,0,0,,Кеттік. Иә... Иә.
Dialogue: 0,0:26:49.34,0:26:53.31,Default,,0,0,0,,Мацузаки мырза, сізді шығуға дейін шығарып салайық.
Dialogue: 0,0:26:53.31,0:26:55.83,Default,,0,0,0,,Тецукеннің қолына түссең қауіпті.
Dialogue: 0,0:26:55.83,0:26:57.83,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:27:02.30,0:27:04.80,Default,,0,0,0,,Хмм….
Dialogue: 0,0:27:08.84,0:27:10.34,Default,,0,0,0,,Хмм….
Dialogue: 0,0:27:16.32,0:27:18.82,Default,,0,0,0,,Осыны жалғастырыңыз.
Dialogue: 0,0:27:32.36,0:27:34.40,Default,,0,0,0,,Тек әрекет жасаңыз!
Dialogue: 0,0:27:34.40,0:27:37.32,Default,,0,0,0,,Мен осылай отыра берсем тарасам, түлектеріммен бетпе-бет келе алмаймын!
Dialogue: 0,0:27:37.32,0:27:38.82,Default,,0,0,0,,Әй!
Dialogue: 0,0:27:49.83,0:28:22.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:22.80,0:28:24.80,Default,,0,0,0,,Бастайық, Шун!
Dialogue: 0,0:28:24.80,0:28:28.79,Default,,0,0,0,,Мацузаки мырза да сонда бола ма? Бұл латын кварталының аман қалуы үшін жиын.
Dialogue: 0,0:28:28.79,0:28:30.81,Default,,0,0,0,,Бұл уақыт болды!
Dialogue: 0,0:28:30.81,0:28:32.31,Default,,0,0,0,,Аяқталған кесу.
Dialogue: 0,0:28:32.31,0:28:34.79,Default,,0,0,0,,Рахмет, бұл пайдалы болды.
Dialogue: 0,0:28:34.79,0:28:37.83,Default,,0,0,0,,Жиналу!
Dialogue: 0,0:28:37.83,0:28:43.32,Default,,0,0,0,,Квартиер тұрғындары, жиналыңыздар! Бұл жиналыс!
Dialogue: 0,0:28:43.32,0:29:06.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:29:06.81,0:29:08.81,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:29:36.31,0:29:38.31,Default,,0,0,0,,Қош келдіңіз Мел.
Dialogue: 0,0:29:38.31,0:29:39.81,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:29:39.81,0:29:42.36,Default,,0,0,0,,Маған карри жасау үшін көкөністерді турап бере аласыз ба?
Dialogue: 0,0:29:42.36,0:29:43.86,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:29:53.31,0:29:54.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:58.33,0:30:01.80,Default,,0,0,0,,[ТД]♪～
Dialogue: 0,0:30:01.80,0:30:04.80,Default,,0,0,0,,Әже, мен үйдемін! үйге қош келдіңіз.
Dialogue: 0,0:30:04.80,0:30:08.37,Default,,0,0,0,,Рику: Сіз еңістің түбіне дейін дүкен аралай аласыз ба? Тіпті қасапшы.
Dialogue: 0,0:30:08.37,0:30:11.82,Default,,0,0,0,,Е! Енді?
Dialogue: 0,0:30:11.82,0:30:13.33,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,0:30:13.33,0:30:16.33,Default,,0,0,0,,Жақында Казуо Фунаки пайда болады.
Dialogue: 0,0:30:16.33,0:30:19.31,Default,,0,0,0,,Томокодан сұрамадыңыз ба?
Dialogue: 0,0:30:19.31,0:30:21.81,Default,,0,0,0,,Мен оны түскі асқа қолдандым.
Dialogue: 0,0:30:22.80,0:30:24.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:27.87,0:30:30.87,Default,,0,0,0,,Хиро-сан, қазанды 10 минуттан кейін жағып қойыңыз.
Dialogue: 0,0:30:31.79,0:30:33.81,Default,,0,0,0,,Иә.
Dialogue: 0,0:30:33.81,0:30:40.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:40.32,0:30:42.81,Default,,0,0,0,,♪♪~ (тежегіш дыбысы)
Dialogue: 0,0:30:42.81,0:30:46.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:46.83,0:30:48.88,Default,,0,0,0,,Окабе! Мен барамын!
Dialogue: 0,0:30:48.88,0:30:50.38,Default,,0,0,0,,Иә.
Dialogue: 0,0:30:51.81,0:30:54.82,Default,,0,0,0,,Атқа мінейік. Біз түбіне дейін барамыз, солай ма?
Dialogue: 0,0:30:54.82,0:30:58.32,Default,,0,0,0,,Жарайды. Мен тежегішті дұрыс баса аламын.
Dialogue: 0,0:30:58.32,0:30:59.82,Default,,0,0,0,,Жүріңіз.
Dialogue: 0,0:30:59.82,0:31:01.32,Default,,0,0,0,,Иә.
Dialogue: 0,0:31:01.32,0:31:14.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:31:14.82,0:31:16.81,Default,,0,0,0,,Кездесу аяқталды ма?
Dialogue: 0,0:31:16.81,0:31:18.81,Default,,0,0,0,,Әлі де қатты дауылды.
Dialogue: 0,0:31:18.81,0:31:21.81,Default,,0,0,0,,Бірақ менде коменданттық сағат бар.
Dialogue: 0,0:31:23.83,0:31:26.32,Default,,0,0,0,,Сіз оны басып шығардыңыз ба? физикадан.
Dialogue: 0,0:31:26.32,0:31:27.82,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:31:27.82,0:31:31.32,Default,,0,0,0,,Ертең мен ертерек басып шығарамын. Әрқашан солай.
Dialogue: 0,0:31:34.32,0:31:37.33,Default,,0,0,0,,Менің Казама-саннан сұрайтыным бар.
Dialogue: 0,0:31:37.33,0:31:38.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:38.83,0:31:40.81,Default,,0,0,0,,«Quartier...» журналында жарияланған өлең.
Dialogue: 0,0:31:40.81,0:31:41.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:41.83,0:31:49.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:31:49.35,0:31:50.89,Default,,0,0,0,,Не?
Dialogue: 0,0:31:50.89,0:31:53.31,Default,,0,0,0,,Жоқ, жарайды.
Dialogue: 0,0:31:53.31,0:32:04.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:32:04.80,0:32:06.80,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:32:08.86,0:32:11.79,Default,,0,0,0,,Маған 400 г шошқа етінің басын беріңізші. Иә!
Dialogue: 0,0:32:11.79,0:32:13.81,Default,,0,0,0,,Екі крокет. иә.
Dialogue: 0,0:32:13.81,0:32:17.31,Default,,0,0,0,,Мен сізге қосымша 240 иен беремін. рақмет сізге.
Dialogue: 0,0:32:20.32,0:32:21.82,Default,,0,0,0,,Иә, дәл солай.
Dialogue: 0,0:32:21.82,0:32:23.32,Default,,0,0,0,,Иә, қош келдіңіз.
Dialogue: 0,0:32:23.32,0:32:25.29,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:32:25.29,0:32:26.79,Default,,0,0,0,,Тамақтану.
Dialogue: 0,0:32:29.38,0:32:31.81,Default,,0,0,0,,Мен оны үйге де әкеле алмаймын.
Dialogue: 0,0:32:31.81,0:32:33.82,Default,,0,0,0,,Сіздің үйіңіз қайда?
Dialogue: 0,0:32:33.82,0:32:36.82,Default,,0,0,0,,Құрметті. Уау, бұл алыс.
Dialogue: 0,0:32:39.82,0:32:41.32,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,0:32:42.31,0:32:44.31,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:32:44.31,0:32:55.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:32:55.80,0:32:57.31,Default,,0,0,0,,♪♪~ Дәмді.
Dialogue: 0,0:32:57.31,0:33:07.31,Default,,0,0,0,,♪♪~
Dialogue: 0,0:37:01.32,0:37:04.32,Default,,0,0,0,,≪Хиро-сан, оны аш≫
Dialogue: 0,0:37:06.32,0:37:08.34,Default,,0,0,0,,Сіз ауырып жатырсыз ба?
Dialogue: 0,0:37:08.34,0:37:10.34,Default,,0,0,0,,Хмм….
Dialogue: 0,0:37:12.41,0:37:14.81,Default,,0,0,0,,Алға. Иә.
Dialogue: 0,0:37:14.81,0:37:16.81,Default,,0,0,0,,Кіріңіз, Хиро-сан.
Dialogue: 0,0:37:28.33,0:37:30.83,Default,,0,0,0,,Керемет...
Dialogue: 0,0:37:39.81,0:37:44.31,Default,,0,0,0,,Жоқ, түнде салдым, түстер шықпайды.
Dialogue: 0,0:37:44.31,0:37:46.31,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:37:47.81,0:37:49.31,Default,,0,0,0,,​​Бұл….
Dialogue: 0,0:37:52.83,0:37:57.91,Default,,0,0,0,,Жиі өтетін кеме. Мел оған беремін деп жауап беріп жатқан сияқты.
Dialogue: 0,0:37:57.91,0:38:01.41,Default,,0,0,0,,Мен көремін. Мел оны көре алмайды.
Dialogue: 0,0:38:02.83,0:38:04.83,Default,,0,0,0,,Маған... жауап беріңізші?
Dialogue: 0,0:38:08.82,0:38:11.82,Default,,0,0,0,,Хмм….
Dialogue: 0,0:38:11.82,0:38:14.82,Default,,0,0,0,,А... Менің қарным ашты.
Dialogue: 0,0:38:14.82,0:38:22.32,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:38:36.33,0:38:38.83,Default,,0,0,0,,Қайырлы таң. қайырлы таң!
Dialogue: 0,0:38:38.83,0:38:41.32,Default,,0,0,0,,Басылған Бұл әдемі қолжазба.
Dialogue: 0,0:38:41.32,0:38:43.82,Default,,0,0,0,,Ах... Жақсы.
Dialogue: 0,0:38:44.89,0:38:46.42,Default,,0,0,0,,Ум...
Dialogue: 0,0:38:46.42,0:38:51.33,Default,,0,0,0,,(Стартқы қоңырау)
Dialogue: 0,0:38:51.33,0:38:54.33,Default,,0,0,0,,Мен сізге көмектесетін тағы бір нәрсе бар ма?
Dialogue: 0,0:38:54.33,0:38:55.83,Default,,0,0,0,,Әрине.
Dialogue: 0,0:38:56.83,0:39:00.34,Default,,0,0,0,,Бірақ мен кешке дейін мектепте қала алмаймын.
Dialogue: 0,0:39:00.34,0:39:04.84,Default,,0,0,0,,Мен саған пышақ беремін, сен оны үйде кесіп ал, солай ма?
Dialogue: 0,0:39:04.84,0:39:06.36,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:39:06.36,0:39:09.43,Default,,0,0,0,,Сабақтан кейін талқылау жиналысы болады.
Dialogue: 0,0:39:09.43,0:39:10.83,Default,,0,0,0,,Сіз шығасыз ба?
Dialogue: 0,0:39:10.83,0:39:13.83,Default,,0,0,0,,Кешіріңіз, мен бүгін істей алмаймын.
Dialogue: 0,0:39:14.82,0:39:16.32,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:39:17.32,0:39:22.84,Default,,0,0,0,,(Соңғы қоңырау)
Dialogue: 0,0:39:22.84,0:39:24.34,Default,,0,0,0,,Мел Күтіңіз!
Dialogue: 0,0:39:24.34,0:39:27.40,Default,,0,0,0,,Анмицу жегіңіз келе ме? Нобуко, сіздің клубтық жұмыстарыңыз туралы не айтасыз?
Dialogue: 0,0:39:27.40,0:39:29.83,Default,,0,0,0,,Университет көлеміндегі пікірталастың арқасында менің демалыс күнім бар.
Dialogue: 0,0:39:29.83,0:39:33.82,Default,,0,0,0,,Кешіріңіз, Томоко-сан бүгін жоқ, сондықтан мен үйге ерте баруым керек.
Dialogue: 0,0:39:33.82,0:39:35.82,Default,,0,0,0,,Өтетін орны осында!
Dialogue: 0,0:39:35.82,0:39:38.82,Default,,0,0,0,,Университеттік пікірталас өтетін орын осында!
Dialogue: 0,0:39:41.31,0:39:43.81,Default,,0,0,0,,Жарайды, сонда тоқта.
Dialogue: 0,0:39:45.88,0:39:47.88,Default,,0,0,0,,Бүгін дөрекі болатын сияқты.
Dialogue: 0,0:39:51.82,0:39:53.32,Default,,0,0,0,,(Кашиваги) Олай деу дұрыс па?
Dialogue: 0,0:39:53.32,0:39:56.32,Default,,0,0,0,,Енді үйге барасың ба? Жас камбала бар жақсысы бар.
Dialogue: 0,0:39:56.32,0:39:59.83,Default,,0,0,0,,Олай болса маған беріңізші. Иә.
Dialogue: 0,0:39:59.83,0:40:03.33,Default,,0,0,0,,Анашым, сіз әлі үйдесіз бе? әлі….
Dialogue: 0,0:40:03.33,0:40:06.83,Default,,0,0,0,,Мен оны кейінірек алып кетемін. Не болды?
Dialogue: 0,0:40:11.82,0:40:14.31,Default,,0,0,0,,«Бұл енді соғыстан кейінгі кезең емес» дегеннен кейін →
Dialogue: 0,0:40:14.31,0:40:16.85,Default,,0,0,0,,Он жылға жуық уақыт өтті.
Dialogue: 0,0:40:16.85,0:40:18.33,Default,,0,0,0,,Жастық ұзын!
Dialogue: 0,0:40:18.33,0:40:20.32,Default,,0,0,0,,Келесі жылы Токио Олимпиадасы өтеді→
Dialogue: 0,0:40:20.32,0:40:23.32,Default,,0,0,0,,Еліміз үлкен дәрежеде қайта туғалы тұр!
Dialogue: 0,0:40:23.32,0:40:25.32,Default,,0,0,0,,Ескі заттар барған сайын бұзылып жатыр →
Dialogue: 0,0:40:25.32,0:40:28.89,Default,,0,0,0,,Жаңа қоғам құрылуда!
Dialogue: 0,0:40:28.89,0:40:31.81,Default,,0,0,0,,Біздің мектеп латын кварталын да бұзды→
Dialogue: 0,0:40:31.81,0:40:34.33,Default,,0,0,0,,Жаңа клуб үйін салу →
Dialogue: 0,0:40:34.33,0:40:37.33,Default,,0,0,0,,Бұл тарихи қажеттілік және студенттердің көпшілігі қалайды!
Dialogue: 0,0:40:37.33,0:40:38.83,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:40:38.83,0:40:41.84,Default,,0,0,0,,Не болып жатыр? Мен шынымен түсінбеймін.
Dialogue: 0,0:40:41.84,0:40:43.32,Default,,0,0,0,,(пидиумдағы түрту дыбысы)
Dialogue: 0,0:40:43.32,0:40:46.84,Default,,0,0,0,,Сауалнама нәтижесінде 711 адам қайта құруды қолдады.
Dialogue: 0,0:40:46.84,0:40:48.88,Default,,0,0,0,,Бұл оқушылардың 80% құрайды →
Dialogue: 0,0:40:48.88,0:40:51.81,Default,,0,0,0,,Қайта құру жоспарын қолдауды көрсетеді!
Dialogue: 0,0:40:51.81,0:40:53.83,Default,,0,0,0,,Менің ойымша, біз мектеп жоспарын қабылдауымыз керек...
Dialogue: 0,0:40:53.83,0:40:56.84,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:40:56.84,0:40:58.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:58.34,0:41:01.32,Default,,0,0,0,,Балалар сендер Тори қарттарға ұқсайсыңдар!
Dialogue: 0,0:41:01.32,0:41:04.33,Default,,0,0,0,,Студент болсаңыз, шынайы сезіміңізді ашық айтыңыз!
Dialogue: 0,0:41:04.33,0:41:06.85,Default,,0,0,0,,Ережелерді сақтаңыз! Ол сөйлеп тұр!
Dialogue: 0,0:41:06.85,0:41:09.40,Default,,0,0,0,,Бос бауыз, санды сұрама!
Dialogue: 0,0:41:09.40,0:41:11.83,Default,,0,0,0,,Сеннари Бьютан!
Dialogue: 0,0:41:11.83,0:41:13.33,Default,,0,0,0,,Сіз мені қорлайсыз ба?
Dialogue: 0,0:41:13.33,0:41:15.30,Default,,0,0,0,,Мұндай қоқыстың не керегі бар!
Dialogue: 0,0:41:15.30,0:41:18.31,Default,,0,0,0,,Санмен жеңуге тырысу – көпшіліктің озбырлығы!
Dialogue: 0,0:41:18.31,0:41:21.31,Default,,0,0,0,,Сен демократияның не екенін білесің бе?
Dialogue: 0,0:41:23.33,0:41:26.87,Default,,0,0,0,,Хахахаха! Төраға! Оларды жап!
Dialogue: 0,0:41:26.87,0:41:28.37,Default,,0,0,0,,О!
Dialogue: 0,0:41:29.92,0:41:31.80,Default,,0,0,0,,Ескі болғандықтан жойғыңыз келсе→
Dialogue: 0,0:41:31.80,0:41:34.34,Default,,0,0,0,,Бастарыңызды ұрыңыз! Мен сөйлеп тұрмын, түс!
Dialogue: 0,0:41:34.34,0:41:36.31,Default,,0,0,0,,Ескіні жою →
Dialogue: 0,0:41:36.31,0:41:38.83,Default,,0,0,0,,Өткен естеліктерді лақтырып тастаумен бірдей емес пе?
Dialogue: 0,0:41:38.83,0:41:40.81,Default,,0,0,0,,Тірі және өліп жатқан адамдар туралы естеліктер →
Dialogue: 0,0:41:40.81,0:41:43.33,Default,,0,0,0,,Оны елемеу деген осы емес пе?
Dialogue: 0,0:41:43.33,0:41:46.84,Default,,0,0,0,,Жаңа нәрсеге секіріп, тарихқа мән бермейтіндерге→
Dialogue: 0,0:41:46.84,0:41:48.89,Default,,0,0,0,,Болашақ деген нәрсе бар ма?
Dialogue: 0,0:41:48.89,0:41:51.31,Default,,0,0,0,,Азшылықтың пікірін тыңдағысы келмейтіндерге →
Dialogue: 0,0:41:51.31,0:41:53.32,Default,,0,0,0,,Сіз демократия туралы айтуға лайықсыз!
Dialogue: 0,0:41:53.32,0:41:56.83,Default,,0,0,0,,Бұл филибустер. Одан құтыл! О!
Dialogue: 0,0:41:56.83,0:41:59.33,Default,,0,0,0,,Скрам! Жою!
Dialogue: 0,0:42:00.32,0:42:03.32,Default,,0,0,0,,Еш қағыспа! Артқа итеріңіз!
Dialogue: 0,0:42:03.32,0:42:05.32,Default,,0,0,0,,Сахнадан түс! Бұл пайдасыз қарсылық!
Dialogue: 0,0:42:05.32,0:42:06.82,Default,,0,0,0,,♬~
Dialogue: 0,0:42:09.91,0:42:11.33,Default,,0,0,0,,Керемет!
Dialogue: 0,0:42:11.33,0:42:13.81,Default,,0,0,0,,Модератор Бірдеңе жасаңыз! Мұқият жасаңыз!
Dialogue: 0,0:42:13.81,0:42:16.81,Default,,0,0,0,,Мен далада киім ауыстырғанды ​​ұнатпаймын!
Dialogue: 0,0:42:26.36,0:42:31.81,Default,,0,0,0,,♪~ Ақ гүлдер жайқалып тұрды
Dialogue: 0,0:42:31.81,0:42:39.82,Default,,0,0,0,,♪~ Туған жерімдегі алыстағы арман күні
Dialogue: 0,0:42:39.82,0:42:45.31,Default,,0,0,0,,♪~ Мен қоштасқанда
Dialogue: 0,0:42:45.31,0:42:50.93,Default,,0,0,0,,♪~ Мен үндемей, төмен қарадым.
Dialogue: 0,0:42:50.93,0:42:55.82,Default,,0,0,0,,♪~ Төменгі шаш
Dialogue: 0,0:42:55.82,0:43:01.34,Default,,0,0,0,,♪~ Ол кез мұңды болды
Dialogue: 0,0:43:01.34,0:43:06.83,Default,,0,0,0,,♪~ Сол ақ гүл.
Dialogue: 0,0:43:06.83,0:43:12.37,Default,,0,0,0,,♪~ Ол кез мұңды болды
Dialogue: 0,0:43:12.37,0:43:17.87,Default,,0,0,0,,♪~ Сол ақ гүл.
Dialogue: 0,0:43:22.33,0:43:24.32,Default,,0,0,0,,Жиналғандар таң қалды ма?
Dialogue: 0,0:43:24.32,0:43:27.82,Default,,0,0,0,,Бұл өте қызықты болды. Барлығы керемет болды.
Dialogue: 0,0:43:27.82,0:43:29.84,Default,,0,0,0,,Әрқашан солай.
Dialogue: 0,0:43:29.84,0:43:32.84,Default,,0,0,0,,Оқушылардың 80%-ы қайта құруды жақтайды →
Dialogue: 0,0:43:32.84,0:43:35.33,Default,,0,0,0,,Мизунума да қозғала алмайды.
Dialogue: 0,0:43:35.33,0:43:37.36,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:43:37.36,0:43:49.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:43:49.82,0:43:53.33,Default,,0,0,0,,Эй, мен оны тазаласам қалай болады?
Dialogue: 0,0:43:53.33,0:43:54.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:54.31,0:43:57.32,Default,,0,0,0,,Бұл ескі, бірақ өте жақсы ғимарат.
Dialogue: 0,0:43:57.32,0:44:02.35,Default,,0,0,0,,Оны тазалап, қыздарды шақырсаң, бәрі тамаша үңгір деп ойлайды.
Dialogue: 0,0:44:02.35,0:44:04.41,Default,,0,0,0,,Мен қандай болдым.
Dialogue: 0,0:44:04.41,0:44:05.81,Default,,0,0,0,,Тазалау?
Dialogue: 0,0:44:05.81,0:44:09.83,Default,,0,0,0,,Бірақ «Шаң да мәдениет» дейді.
Dialogue: 0,0:44:09.83,0:44:12.83,Default,,0,0,0,,Физика Хари тауы Ол өте жақсы беделге ие.
Dialogue: 0,0:44:12.83,0:44:15.83,Default,,0,0,0,,Барлығы II Ямахари санын асыға күтеді.
Dialogue: 0,0:44:15.83,0:44:17.80,Default,,0,0,0,,Мен де.
Dialogue: 0,0:44:17.80,0:44:25.31,Default,,0,0,0,,♪♪~
Dialogue: 0,0:44:25.31,0:44:27.81,Default,,0,0,0,,Бұл өте жаман. Өтінемін көмектесіңізші.
Dialogue: 0,0:44:28.81,0:44:31.32,Default,,0,0,0,,Қош бол. Қайта кездескенше.
Dialogue: 0,0:44:31.32,0:44:35.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:44:35.34,0:44:38.32,Default,,0,0,0,,Рахмет саған Мел! Аа!?
Dialogue: 0,0:44:38.32,0:44:47.33,Default,,0,0,0,,♪♪~
Dialogue: 0,0:44:47.33,0:44:49.83,Default,,0,0,0,,Ах! Балық дүкені!
Dialogue: 0,0:44:52.82,0:44:55.82,Default,,0,0,0,,Олар тек хормен ән айтады, солай ма? Мұғалімдер де солай.
Dialogue: 0,0:44:55.82,0:44:57.83,Default,,0,0,0,,Ол ештеңе айтпастан кетіп қалды.
Dialogue: 0,0:44:57.83,0:45:02.86,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:45:02.86,0:45:07.32,Default,,0,0,0,,Латын кварталы... Мен болған кездегідей.
Dialogue: 0,0:45:07.32,0:45:10.82,Default,,0,0,0,,Мизунума, студенттік кеңестің төрағасы, менің сыныптасымның інісі.
Dialogue: 0,0:45:10.82,0:45:13.83,Default,,0,0,0,,Иә! Сіздің ағаңыз да өнерлі болды ма?
Dialogue: 0,0:45:13.83,0:45:16.83,Default,,0,0,0,,Әпке, мен қазір астрофизикамен айналысып жатырмын.
Dialogue: 0,0:45:16.83,0:45:19.81,Default,,0,0,0,,Керемет! (Макимура) ≪Не болды? ≫
Dialogue: 0,0:45:19.81,0:45:21.32,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:45:21.32,0:45:23.87,Default,,0,0,0,,О, бұл виски емес! Мен үшін сақта.
Dialogue: 0,0:45:23.87,0:45:25.90,Default,,0,0,0,,Ішейік, ішейік! Мен ірімшікті кесемін.
Dialogue: 0,0:45:25.90,0:45:27.84,Default,,0,0,0,,Бұл жақсы. Балаларға рұқсат етілмейді.
Dialogue: 0,0:45:27.84,0:45:29.32,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:45:29.32,0:45:32.81,Default,,0,0,0,,Әй, Мел, оларды менің қоштасу кешіме шақырайық.
Dialogue: 0,0:45:32.81,0:45:34.83,Default,,0,0,0,,Не? ДДСҰ?
Dialogue: 0,0:45:34.83,0:45:37.83,Default,,0,0,0,,О-то-ко-до-мо!
Dialogue: 0,0:45:38.82,0:45:41.32,Default,,0,0,0,,Адам? Ах!
Dialogue: 0,0:49:47.30,0:49:49.30,Default,,0,0,0,,≪Сәлем≫ Ах….
Dialogue: 0,0:49:51.80,0:49:55.31,Default,,0,0,0,,"Х.О.Қ.Ұ.Т."
Dialogue: 0,0:49:55.31,0:49:56.84,Default,,0,0,0,,Бұл «Хокуто».
Dialogue: 0,0:49:56.84,0:49:59.34,Default,,0,0,0,,Сіз сигнал жалаушаларын оқи аласыз ба?
Dialogue: 0,0:50:04.32,0:50:07.30,Default,,0,0,0,,Қақпа арқылы кіріңіз. (Гүл) ≪Тұтынушыны көрдім≫
Dialogue: 0,0:50:07.30,0:50:08.80,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:50:12.79,0:50:19.88,Default,,0,0,0,,Хахахаха….
Dialogue: 0,0:50:19.88,0:50:22.30,Default,,0,0,0,,Алысқа бармасаң да→
Dialogue: 0,0:50:22.30,0:50:25.30,Default,,0,0,0,,Осы жерден күйеу тауып, кәсіп ашсаңыз болғаны.
Dialogue: 0,0:50:25.30,0:50:29.29,Default,,0,0,0,,Бізді қуып жібереді ме?! Оған дейін тұрмысқа шығасың ғой, солай ма?
Dialogue: 0,0:50:29.29,0:50:31.31,Default,,0,0,0,,Иә, асығуымыз керек!
Dialogue: 0,0:50:31.31,0:50:34.31,Default,,0,0,0,,Маки-сан міндетті түрде керемет әйел болады.
Dialogue: 0,0:50:34.31,0:50:35.81,Default,,0,0,0,,Сіз мұны өте жақсы білесіз!
Dialogue: 0,0:50:35.81,0:50:37.85,Default,,0,0,0,,Мәселе директорлар кеңесінде.
Dialogue: 0,0:50:37.85,0:50:39.88,Default,,0,0,0,,Директор жақсы адам.
Dialogue: 0,0:50:39.88,0:50:41.30,Default,,0,0,0,,Қандай ит енот.
Dialogue: 0,0:50:41.30,0:50:43.82,Default,,0,0,0,,Төраға ителгіге ұқсайды.
Dialogue: 0,0:50:43.82,0:50:46.31,Default,,0,0,0,,Бұл адам әлі де директор болуды жоспарлап жүр ме?
Dialogue: 0,0:50:46.31,0:50:47.81,Default,,0,0,0,,Шамасы.
Dialogue: 0,0:50:47.81,0:50:51.80,Default,,0,0,0,,Оқшауланудан қорықпа, Бірақ тактика даналықты қажет етеді.
Dialogue: 0,0:50:51.80,0:50:53.80,Default,,0,0,0,,Бірақ оны тактика деп атаса да→
Dialogue: 0,0:50:53.80,0:50:56.83,Default,,0,0,0,,Біздің қолымыздан келетіні көп.
Dialogue: 0,0:50:56.83,0:50:59.39,Default,,0,0,0,,Менде көзілдірік таусылды.
Dialogue: 0,0:50:59.39,0:51:00.79,Default,,0,0,0,,Мен оны бірден жуамын.
Dialogue: 0,0:51:00.79,0:51:03.29,Default,,0,0,0,,Маған мынаны беріңіз. иә.
Dialogue: 0,0:51:06.31,0:51:08.30,Default,,0,0,0,,Суши осында!
Dialogue: 0,0:51:08.30,0:51:10.82,Default,,0,0,0,,Иә! (Аға) Мен күттім!
Dialogue: 0,0:51:10.82,0:51:13.30,Default,,0,0,0,,Бұл жер Мэйдзи дәуірінің соңында салынған.
Dialogue: 0,0:51:13.30,0:51:15.80,Default,,0,0,0,,Бұрын аурухана болған.
Dialogue: 0,0:51:24.80,0:51:28.32,Default,,0,0,0,,Менің үлкен атам мысықтарды жақсы көретін.
Dialogue: 0,0:51:28.32,0:51:31.82,Default,,0,0,0,,Мен бұл ғимараттың Латын кварталымен бір уақытта салынғанына сене алмаймын.
Dialogue: 0,0:51:31.82,0:51:33.80,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:51:33.80,0:51:36.32,Default,,0,0,0,,Сіз оны шынымен бағалайсыз.
Dialogue: 0,0:51:36.32,0:51:37.83,Default,,0,0,0,,Иә.
Dialogue: 0,0:51:37.83,0:51:41.86,Default,,0,0,0,,Менің үлкен атама, ата, сенің әкең де дәрігер ме?
Dialogue: 0,0:51:41.86,0:51:44.36,Default,,0,0,0,,Жоқ, мен қайықта болдым.
Dialogue: 0,0:51:46.82,0:51:51.81,Default,,0,0,0,,♪~ Сен алқаптан кетесің
Dialogue: 0,0:51:51.81,0:51:56.81,Default,,0,0,0,,♪~ Нәзік күлкі қалдыру
Dialogue: 0,0:51:56.81,0:51:59.81,Default,,0,0,0,,♪~ Екеуміз іздедік...
Dialogue: 0,0:51:59.81,0:52:02.37,Default,,0,0,0,,Әке Ол теңізші болды ма?
Dialogue: 0,0:52:02.37,0:52:04.40,Default,,0,0,0,,Мынадай үй.
Dialogue: 0,0:52:04.40,0:52:07.82,Default,,0,0,0,,Атасы мен әжесі үзілді-кесілді қарсы болды.
Dialogue: 0,0:52:07.82,0:52:11.81,Default,,0,0,0,,Сол себепті анаң үйден кетіп, қашып кетті.
Dialogue: 0,0:52:11.81,0:52:13.31,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:52:13.31,0:52:16.31,Default,,0,0,0,,Сіздің анаңыз университетте мұғалім болған, солай ма?
Dialogue: 0,0:52:16.31,0:52:17.82,Default,,0,0,0,,Иә.
Dialogue: 0,0:52:17.82,0:52:21.82,Default,,0,0,0,,Сіздің әкеңіз матрос болғандықтан сигнал жалаушасы ма?
Dialogue: 0,0:52:26.31,0:52:29.81,Default,,0,0,0,,Жас кезімде.
Dialogue: 0,0:52:32.81,0:52:35.30,Default,,0,0,0,,Егер жалаушаны сөндірсеңіз→
Dialogue: 0,0:52:35.30,0:52:38.80,Default,,0,0,0,,Әкемнің адаспай қайтатынын айтты→
Dialogue: 0,0:52:38.80,0:52:42.36,Default,,0,0,0,,Ту күн сайын сөндірілді.
Dialogue: 0,0:52:42.36,0:52:48.33,Default,,0,0,0,,Мен киім сөресіне жалаушаны сөндірдім де, әкемнің үйге келуін күттім.
Dialogue: 0,0:52:48.33,0:52:51.83,Default,,0,0,0,,Күн сайын Күн сайын….
Dialogue: 0,0:52:53.82,0:52:59.31,Default,,0,0,0,,Бірақ Корей соғысы кезінде әкемнің кемесі суға батып кетті.
Dialogue: 0,0:52:59.31,0:53:02.81,Default,,0,0,0,,Сонда да жалау күн сайын көрсетіліп тұратын.
Dialogue: 0,0:53:06.80,0:53:10.32,Default,,0,0,0,,Сол тудың тұғырын осы отбасы → алған
Dialogue: 0,0:53:10.32,0:53:13.79,Default,,0,0,0,,Ту көтере алмай жылаймын→
Dialogue: 0,0:53:13.79,0:53:16.79,Default,,0,0,0,,Оны маған атам салып берді.
Dialogue: 0,0:53:16.79,0:53:31.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:53:31.79,0:53:33.79,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:53:36.29,0:53:39.30,Default,,0,0,0,,Бұл бөлме бұрын атамның емтихан қабылдау бөлмесі болған.
Dialogue: 0,0:53:39.30,0:53:41.82,Default,,0,0,0,,Менің анам оны қазір оқу орны ретінде пайдалануда.
Dialogue: 0,0:53:41.82,0:53:43.80,Default,,0,0,0,,Қандай тамаша кітап.
Dialogue: 0,0:53:43.80,0:53:47.37,Default,,0,0,0,,Ах, Мелдің отбасы.
Dialogue: 0,0:53:47.37,0:53:48.89,Default,,0,0,0,,Иә.
Dialogue: 0,0:53:48.89,0:53:50.89,Default,,0,0,0,,Әке?
Dialogue: 0,0:53:52.79,0:53:56.79,Default,,0,0,0,,Бұл ата, менің әкем осында.
Dialogue: 0,0:54:00.30,0:54:04.32,Default,,0,0,0,,Ол әдемі емес пе? Тұрмысқа шыққанда да.
Dialogue: 0,0:54:04.32,0:54:07.82,Default,,0,0,0,,Маған бұл фото ұнайды.
Dialogue: 0,0:54:13.80,0:54:15.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:17.82,0:54:20.30,Default,,0,0,0,,«Юичиро Савамура.»
Dialogue: 0,0:54:20.30,0:54:23.81,Default,,0,0,0,,Менің әкемнің аты Мацузаки осы әулеттен.
Dialogue: 0,0:54:23.81,0:54:27.29,Default,,0,0,0,,Хокуто апаның сәлемі.
Dialogue: 0,0:54:27.29,0:54:28.83,Default,,0,0,0,,Мен қазір барамын.
Dialogue: 0,0:54:28.83,0:54:30.33,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:54:38.31,0:54:55.37,Default,,0,0,0,,♪♪~
Dialogue: 0,0:54:55.37,0:54:56.91,Default,,0,0,0,,♪♪~ Хэхехе….
Dialogue: 0,0:54:56.91,0:55:18.85,Default,,0,0,0,,♪♪~
Dialogue: 0,0:55:18.85,0:55:20.88,Default,,0,0,0,,♪♪~ Мен үйдемін.
Dialogue: 0,0:55:20.88,0:55:28.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:55:28.81,0:55:31.33,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:55:31.33,0:55:34.33,Default,,0,0,0,,Анаңды уайымдама.
Dialogue: 0,0:55:35.81,0:55:37.31,Default,,0,0,0,,Иә.
Dialogue: 0,0:55:43.84,0:55:46.37,Default,,0,0,0,,≪Шун-чан, кешкі ас ше? ≫
Dialogue: 0,0:55:46.37,0:55:47.91,Default,,0,0,0,,Орындалды.
Dialogue: 0,0:55:47.91,0:55:50.31,Default,,0,0,0,,[ТД] (Тікелей эфир) Сіз орнатылған орынға кірдіңіз.
Dialogue: 0,0:55:50.31,0:55:53.81,Default,,0,0,0,,[ТД] Екі-үш, мен төртінші қадамды толық санаудан лақтырдым!
Dialogue: 0,0:55:53.81,0:55:57.81,Default,,0,0,0,,[Теледидар] Жоқ! Бұл соққы! Мен Нагасиманы ұрып тастадым!
Dialogue: 0,0:56:15.80,0:56:18.81,Default,,0,0,0,,Юичиро Савамура….
Dialogue: 0,0:56:18.81,0:56:21.81,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:56:29.35,0:56:39.31,Default,,0,0,0,,♪♪~
Dialogue: 0,0:56:39.31,0:56:41.31,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:56:41.31,0:56:43.30,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:56:43.30,0:56:45.80,Default,,0,0,0,,О. Ах...
Dialogue: 0,0:56:49.80,0:56:53.82,Default,,0,0,0,,Құрметті еріктілер, Латын тоқсанына қош келдіңіздер.
Dialogue: 0,0:56:53.82,0:56:57.90,Default,,0,0,0,,Мәдени құндылық деп атауға болатын осы тарихи ғимаратты сақтау үшін →
Dialogue: 0,0:56:57.90,0:57:01.30,Default,,0,0,0,,Көмегің үшін көп рахмет.
Dialogue: 0,0:57:01.30,0:57:05.32,Default,,0,0,0,,Уау~ Хехехе....
Dialogue: 0,0:57:05.32,0:57:07.81,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:57:07.81,0:57:11.79,Default,,0,0,0,,Қауіпті жұмыстарды орындауда ер адамдар жетекшілік етуі керек!
Dialogue: 0,0:57:11.79,0:57:14.31,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:57:14.31,0:57:15.81,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:57:15.81,0:57:31.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:57:31.80,0:57:34.30,Default,,0,0,0,,Ақырғы өмір! Тек сонда!
Dialogue: 0,0:57:34.30,0:57:36.30,Default,,0,0,0,,Ешқандай ерекшелік жоқ.
Dialogue: 0,0:57:36.30,0:57:37.80,Default,,0,0,0,,Жақсы, жасаңыз!
Dialogue: 0,0:57:37.80,0:57:40.80,Default,,0,0,0,,Кеттік! Сен ~ жоқ…. (Тецукеннің директоры) Ах!
Dialogue: 0,0:57:42.34,0:57:44.34,Default,,0,0,0,,Кя~! Қолдану Қолдану….
Dialogue: 0,0:57:46.81,0:57:52.30,Default,,0,0,0,,Хахахаха….
Dialogue: 0,0:57:52.30,0:57:54.30,Default,,0,0,0,,Эй, сақ бол!
Dialogue: 0,0:57:54.30,0:57:56.80,Default,,0,0,0,,Ах! Ах! Ах!
Dialogue: 0,0:57:58.31,0:57:59.79,Default,,0,0,0,,Ай!
Dialogue: 0,0:57:59.79,0:58:02.29,Default,,0,0,0,,Ха! Мұнда! Сақ болыңыз!
Dialogue: 0,0:58:08.32,0:58:11.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:11.32,0:58:21.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:58:21.81,0:58:26.40,Default,,0,0,0,,Математика I Математика II… Жай жауап парақтары.
Dialogue: 0,0:58:26.40,0:58:28.80,Default,,0,0,0,,Бұл Ямахари туралы маңызды құжат.
Dialogue: 0,0:58:28.80,0:58:32.79,Default,,0,0,0,,Ах! Хокуто-санның нөмірі мен 100 ұпай жинадым.
Dialogue: 0,0:58:32.79,0:58:34.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:40.30,0:58:41.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:42.85,0:58:46.30,Default,,0,0,0,,Сәлем! Барлығыңыз орнына қойыңыздаршы.
Dialogue: 0,0:58:46.30,0:58:48.80,Default,,0,0,0,,≪Иә≫ Мен сізге сонда көмектесемін.
Dialogue: 0,0:58:51.31,0:58:54.31,Default,,0,0,0,,Иә, Мацузаки мырза. Ха... Иә!
Dialogue: 0,0:58:54.31,0:58:59.31,Default,,0,0,0,,Егер сіз оны сақтауды немесе лақтыруды ойласаңыз, Мизунума-доно сізге оны өртеп жіберуге кеңес береді.
Dialogue: 0,0:59:05.81,0:59:09.81,Default,,0,0,0,,Бұл шынымен лас. Сіз оны соңғы рет қашан тазаладыңыз?
Dialogue: 0,0:59:09.81,0:59:12.31,Default,,0,0,0,,Мен үйірмеге кіргеннен бері олай істемедім.
Dialogue: 0,0:59:12.31,0:59:13.81,Default,,0,0,0,,Хя….
Dialogue: 0,0:59:13.81,0:59:16.30,Default,,0,0,0,,Мен ертең бадминтоншы жігіттерді әкелемін!
Dialogue: 0,0:59:16.30,0:59:18.30,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:59:48.37,0:59:51.82,Default,,0,0,0,,Аспан! Мен бірінші үйге барамын!
Dialogue: 0,0:59:51.82,0:59:55.32,Default,,0,0,0,,Иә! Мен кешкі асқа қайтамын.
Dialogue: 0,1:00:13.31,1:00:16.31,Default,,0,0,0,,Саған бірдеңе болды ма?
Dialogue: 0,1:00:17.29,1:00:19.29,Default,,0,0,0,,Ештеңе.
Dialogue: 0,1:00:20.80,1:00:23.80,Default,,0,0,0,,Ал, ертең. аа.
Dialogue: 0,1:00:25.34,1:00:27.34,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:01:17.29,1:01:20.79,Default,,0,0,0,,Әке, сізден сұрайын дегенім бар.
Dialogue: 0,1:01:21.79,1:01:25.31,Default,,0,0,0,,Мен жұмыстамын. Жеңілдетіңіз.
Dialogue: 0,1:01:25.31,1:01:30.81,Default,,0,0,0,,Бұл Юичиро Савамура менің нағыз әкем, солай ма?
Dialogue: 0,1:01:34.37,1:01:37.37,Default,,0,0,0,,Біз бұл туралы бұрын айтқан болатынбыз.
Dialogue: 0,1:01:39.79,1:01:42.29,Default,,0,0,0,,Сен менің ұлымсың.
Dialogue: 0,1:01:43.30,1:01:45.30,Default,,0,0,0,,Иә….
Dialogue: 0,1:01:46.82,1:01:53.32,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,1:01:58.91,1:02:05.41,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,1:02:20.83,1:02:23.83,Default,,0,0,0,,Желді күн болды.
Dialogue: 0,1:02:24.81,1:02:30.31,Default,,0,0,0,,Савамура сізге сәбиіңізбен және отбасы кітабыңыздың көшірмесімен қонаққа келді.
Dialogue: 0,1:02:30.31,1:02:42.41,Default,,0,0,0,,♪♪~
Dialogue: 0,1:02:42.41,1:02:46.81,Default,,0,0,0,,Жаңа ғана сәбиден айырылдық.
Dialogue: 0,1:02:46.81,1:02:50.30,Default,,0,0,0,,Анаң жұлып алатындай ұстап →
Dialogue: 0,1:02:50.30,1:02:52.80,Default,,0,0,0,,Сауылған.
Dialogue: 0,1:02:56.80,1:02:59.31,Default,,0,0,0,,Савамура жақсы теңізші болды.
Dialogue: 0,1:02:59.31,1:03:02.36,Default,,0,0,0,,Корей соғысы кезінде «LST» капитаны болды→
Dialogue: 0,1:03:02.36,1:03:04.91,Default,,0,0,0,,Мені мина басып қалды→
Dialogue: 0,1:03:04.91,1:03:07.91,Default,,0,0,0,,Ол маған үнемі сүтке ақша жіберетін.
Dialogue: 0,1:03:09.32,1:03:12.32,Default,,0,0,0,,Соңғы кездері мен оған қатты ұқсай бастадым.
Dialogue: 0,1:03:13.30,1:03:15.80,Default,,0,0,0,,Сен біздің ұлымызсың.
Dialogue: 0,1:03:17.29,1:03:20.29,Default,,0,0,0,,Иә...рахмет.
Dialogue: 0,1:03:20.29,1:03:44.30,Default,,0,0,0,,♪♪~
Dialogue: 0,1:03:44.30,1:03:46.30,Default,,0,0,0,,Хиро-сан, сен осындасың ба?
Dialogue: 0,1:03:46.30,1:03:47.80,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,1:03:47.80,1:03:58.32,Default,,0,0,0,,♪♪~
Dialogue: 0,1:03:58.32,1:04:01.32,Default,,0,0,0,,Сіз бүгін өтпейтін сияқтысыз.
Dialogue: 0,1:04:01.32,1:04:02.80,Default,,0,0,0,,Иә….
Dialogue: 0,1:04:02.80,1:04:14.36,Default,,0,0,0,,♪♪~
Dialogue: 0,1:04:14.36,1:04:17.30,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,1:04:17.30,1:04:44.30,Default,,0,0,0,,♪♪~
Dialogue: 0,1:04:51.84,1:04:53.37,Default,,0,0,0,,Хокуто мырза.
Dialogue: 0,1:04:53.37,1:04:55.87,Default,,0,0,0,,Мел кіріңіз.
Dialogue: 0,1:05:00.81,1:05:02.81,Default,,0,0,0,,Мен кетемін.
Dialogue: 0,1:05:02.81,1:05:04.80,Default,,0,0,0,,Мел маған қамқорлық жасады.
Dialogue: 0,1:05:04.80,1:05:06.30,Default,,0,0,0,,Мен сені шығарып салғым келеді.
Dialogue: 0,1:05:06.30,1:05:09.29,Default,,0,0,0,,Жарайды, жүк көлігінде күндізгі уақыт.
Dialogue: 0,1:05:09.29,1:05:11.82,Default,,0,0,0,,Мен өзімді жалғыз сезінемін...
Dialogue: 0,1:05:11.82,1:05:13.79,Default,,0,0,0,,Ол ойнауға келетінін айтты.
Dialogue: 0,1:05:13.79,1:05:16.34,Default,,0,0,0,,Жарайды, мен сабаққа кешігіп барамын.
Dialogue: 0,1:05:16.34,1:05:17.84,Default,,0,0,0,,Иә.
Dialogue: 0,1:05:20.30,1:05:22.80,Default,,0,0,0,,Казама-кунмен бәрі жақсы болады деп үміттенемін.
Dialogue: 0,1:05:22.80,1:05:24.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:27.80,1:05:29.80,Default,,0,0,0,,Мен барамын.
Dialogue: 0,1:05:45.81,1:05:49.31,Default,,0,0,0,,Қосымша мәселе! Қосымша! Бұл өте ерекше!
Dialogue: 0,1:05:49.31,1:05:51.81,Default,,0,0,0,,Танысқаныма қуаныштымын. Бұл қосымша мәселе. Иә, өтінемін.
Dialogue: 0,1:05:51.81,1:05:53.81,Default,,0,0,0,,Бұл Weekly Quartier қосымша шығарылымы!
Dialogue: 0,1:05:53.81,1:05:55.80,Default,,0,0,0,,Мен мұны бүгін қайталаймын, сондықтан менен сұрамаңыз. аа.
Dialogue: 0,1:05:55.80,1:05:58.80,Default,,0,0,0,,Латын кварталын тазалау басталды!
Dialogue: 0,1:05:58.80,1:06:00.84,Default,,0,0,0,,Танысқаныма қуаныштымын. Қосымша!
Dialogue: 0,1:06:00.84,1:06:02.87,Default,,0,0,0,,Мен бүгін тағы барамын. рақмет сізге.
Dialogue: 0,1:06:02.87,1:06:05.81,Default,,0,0,0,,Қайырлы таң! Ерен еңбегіңіз үшін рахмет. Сәлем.
Dialogue: 0,1:06:05.81,1:06:08.31,Default,,0,0,0,,Иә! Мен де бүгін сенен сұраймын.
Dialogue: 0,1:06:08.31,1:06:10.80,Default,,0,0,0,,Иә, Мацузаки мырза.
Dialogue: 0,1:06:10.80,1:06:13.80,Default,,0,0,0,,Қосымша мәселе! Қосымша!
Dialogue: 0,1:06:13.80,1:06:17.82,Default,,0,0,0,,Қосымша басылым! Weekly Quartier қосымша шығарылымы!
Dialogue: 0,1:06:17.82,1:06:22.32,Default,,0,0,0,,Weekly Quartier қосымша шығарылымы! Қосымша! Қосымша! Қосымша!
Dialogue: 0,1:06:28.80,1:06:30.80,Default,,0,0,0,,Келесі.
Dialogue: 0,1:06:30.80,1:06:32.30,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:06:34.80,1:06:37.32,Default,,0,0,0,,≪Уау! ≫
Dialogue: 0,1:06:37.32,1:06:39.82,Default,,0,0,0,,Сәттілік! жақсы!
Dialogue: 0,1:06:44.85,1:06:47.90,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,1:06:47.90,1:06:50.40,Default,,0,0,0,,Керемет! барайық!
Dialogue: 0,1:07:00.30,1:07:03.80,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:07:14.31,1:07:15.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:23.30,1:07:30.88,Default,,0,0,0,,♪♪~
Dialogue: 0,1:07:30.88,1:07:34.31,Default,,0,0,0,,Ұнамаса, анық айт.
Dialogue: 0,1:07:34.31,1:07:44.82,Default,,0,0,0,,♪♪~
Dialogue: 0,1:07:44.82,1:07:48.85,Default,,0,0,0,,Юичиро Савамура Менің нағыз әкем.
Dialogue: 0,1:07:48.85,1:07:50.36,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:50.36,1:07:52.86,Default,,0,0,0,,Бұл арзан мелодрама сияқты.
Dialogue: 0,1:07:55.29,1:07:57.30,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:07:57.30,1:08:01.29,Default,,0,0,0,,Мен де отбасылық тіркеуді тексеру үшін қалалық әкімдікке бардым.
Dialogue: 0,1:08:01.29,1:08:03.31,Default,,0,0,0,,Ал...
Dialogue: 0,1:08:03.31,1:08:06.81,Default,,0,0,0,,Біз ағамыз бен апамыз.
Dialogue: 0,1:08:09.82,1:08:12.37,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:08:12.37,1:08:16.37,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын. Менің қолымнан келгені – білмеймін деп кейіп көрсету.
Dialogue: 0,1:08:19.81,1:08:22.81,Default,,0,0,0,,Біз әлі де доспыз.
Dialogue: 0,1:08:24.30,1:08:25.80,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:47.32,1:08:50.79,Default,,0,0,0,,Сора-чан Мел Мектепте бірдеңе болды ма?
Dialogue: 0,1:08:50.79,1:08:54.81,Default,,0,0,0,,Білмеймін, олай ойламаймын...
Dialogue: 0,1:08:54.81,1:08:59.35,Default,,0,0,0,,Меніңше...бұрынғы тамақ біртүрлі болды.
Dialogue: 0,1:08:59.35,1:09:01.90,Default,,0,0,0,,Ол дымқыл болды.
Dialogue: 0,1:09:01.90,1:09:04.29,Default,,0,0,0,,Бірдеңе болды.
Dialogue: 0,1:09:04.29,1:09:07.81,Default,,0,0,0,,Үйге бірінші рет кеш келуім.
Dialogue: 0,1:09:07.81,1:09:09.81,Default,,0,0,0,,Хмм….
Dialogue: 0,1:09:15.82,1:09:18.30,Default,,0,0,0,,Әпке, монша ше?
Dialogue: 0,1:09:18.30,1:09:20.80,Default,,0,0,0,,Тоқтату….
Dialogue: 0,1:09:21.87,1:09:23.87,Default,,0,0,0,,Суық?
Dialogue: 0,1:10:01.81,1:10:14.79,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:10:14.79,1:10:17.31,Default,,0,0,0,,) (Йосико) ((Теңіз!))
Dialogue: 0,1:10:17.31,1:10:30.82,Default,,0,0,0,,♪♪~
Dialogue: 0,1:10:30.82,1:10:32.79,Default,,0,0,0,,♪♪~ Аа….
Dialogue: 0,1:10:32.79,1:10:36.31,Default,,0,0,0,,♪♪~
Dialogue: 0,1:10:36.31,1:10:37.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:37.81,1:11:05.79,Default,,0,0,0,,(көкөністерді кесу дыбысы)
Dialogue: 0,1:11:05.79,1:11:09.31,Default,,0,0,0,,Қайырлы таң Уми, жақсы ұйықтадың ба?
Dialogue: 0,1:11:09.31,1:11:12.88,Default,,0,0,0,,Анашым, сіз үйдесіз бе?
Dialogue: 0,1:11:12.88,1:11:16.88,Default,,0,0,0,,Не? Мен осында мәңгі боламын.
Dialogue: 0,1:11:17.80,1:11:22.80,Default,,0,0,0,,≪Теңіз! Мен туды көтеремін, кел! ≫
Dialogue: 0,1:11:28.30,1:11:29.80,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:36.79,1:11:39.29,Default,,0,0,0,,Әке….
Dialogue: 0,1:11:40.29,1:11:43.81,Default,,0,0,0,,Теңіз Бұл жолы ұзағырақ қалуыңызға болады.
Dialogue: 0,1:11:43.81,1:11:55.91,Default,,0,0,0,,♪♪~
Dialogue: 0,1:11:55.91,1:11:58.81,Default,,0,0,0,,Ол үлкейіп кетті...
Dialogue: 0,1:11:58.81,1:12:06.81,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:13:07.30,1:13:10.80,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:16:04.81,1:16:07.29,Default,,0,0,0,,Материалдар бойынша сұрақтарыңыз болса, маған хабарлаңыз.
Dialogue: 0,1:16:07.29,1:16:09.30,Default,,0,0,0,,Бұл жігіт құрылыс компаниясы.
Dialogue: 0,1:16:09.30,1:16:11.85,Default,,0,0,0,,Маған үзіліс беріңіз! Жақсы емес пе?
Dialogue: 0,1:16:11.85,1:16:13.90,Default,,0,0,0,,Қазір экономика жақсы, солай ма?
Dialogue: 0,1:16:13.90,1:16:15.82,Default,,0,0,0,,Олай болса, сәттілік тілеймін!
Dialogue: 0,1:16:15.82,1:16:18.30,Default,,0,0,0,,Рахмет. Әкем маған ашуланады...
Dialogue: 0,1:16:18.30,1:16:20.31,Default,,0,0,0,,Бұл таңқаларлық. Бұл да Хокуто ханым →
Dialogue: 0,1:16:20.31,1:16:22.81,Default,,0,0,0,,Жоқ, мұның бәрі Мелдің арқасында.
Dialogue: 0,1:16:22.81,1:16:25.81,Default,,0,0,0,,Ол сәттілік құдайы.
Dialogue: 0,1:16:25.81,1:16:28.31,Default,,0,0,0,,Еңбектеріңіз үшін рахмет. (Нобуко) Сәлем.
Dialogue: 0,1:16:29.32,1:16:31.82,Default,,0,0,0,,Бұл тамаша! Бұл нағыз көрініс сияқты!
Dialogue: 0,1:16:39.31,1:16:42.31,Default,,0,0,0,,Не істеп жатырсың! (Тецукеннің директоры) Жоқ...мм...
Dialogue: 0,1:16:42.31,1:16:44.80,Default,,0,0,0,,Маған біраз уақытқа қарызға беріңізші.
Dialogue: 0,1:16:44.80,1:16:48.80,Default,,0,0,0,,Жалпы айтқанда, оны шпательмен жағуға тырысқаннан 100 жыл бұрын болды.
Dialogue: 0,1:16:53.34,1:16:56.84,Default,,0,0,0,,Әй... Уау!
Dialogue: 0,1:16:58.29,1:16:59.80,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:16:59.80,1:17:02.32,Default,,0,0,0,,Менің әкем сылақшы генерал.
Dialogue: 0,1:17:02.32,1:17:04.80,Default,,0,0,0,,Әй... әдемі!
Dialogue: 0,1:17:04.80,1:17:07.80,Default,,0,0,0,,Сіз не туралы айтып отырсыз? (Тецукеннің директоры) Жоқ, анау қабырға...
Dialogue: 0,1:17:07.80,1:17:10.30,Default,,0,0,0,,Не! Фуфуфу….
Dialogue: 0,1:17:15.36,1:17:16.90,Default,,0,0,0,,Сәлем.
Dialogue: 0,1:17:16.90,1:17:18.90,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,1:17:20.32,1:17:24.30,Default,,0,0,0,,Кеш қалғаныңыз үшін рахмет. Үйде бәрі жақсы ма?
Dialogue: 0,1:17:24.30,1:17:26.32,Default,,0,0,0,,Бүгін мен көктен сұрадым.
Dialogue: 0,1:17:26.32,1:17:28.82,Default,,0,0,0,,Мен сізге көмектесе аламын ба?
Dialogue: 0,1:17:32.80,1:17:35.80,Default,,0,0,0,,Бұған тапсырыс беруге болады ма? иә.
Dialogue: 0,1:17:39.30,1:17:41.32,Default,,0,0,0,,Ертеңгі күнге берсем жарайды ма?
Dialogue: 0,1:17:41.32,1:17:44.79,Default,,0,0,0,,Иә, бұл өте пайдалы, рахмет.
Dialogue: 0,1:17:44.79,1:17:46.79,Default,,0,0,0,,Қош бол. қош бол.
Dialogue: 0,1:18:02.33,1:18:03.83,Default,,0,0,0,,Аа...
Dialogue: 0,1:18:05.80,1:19:05.81,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:07.81,1:19:09.81,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:19:13.81,1:19:16.30,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:19:16.30,1:19:33.32,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,1:19:33.32,1:19:37.30,Default,,0,0,0,,Аман болсын! Ура!
Dialogue: 0,1:19:37.30,1:19:39.79,Default,,0,0,0,,Мел! Бір минут күтіңіз!
Dialogue: 0,1:19:39.79,1:19:42.31,Default,,0,0,0,,Қат! Бұл шұғыл жиналыс!
Dialogue: 0,1:19:42.31,1:19:45.31,Default,,0,0,0,,Директорлар кеңесі жазғы каникул кезінде оны бұзу туралы шешім қабылдады!
Dialogue: 0,1:19:48.85,1:19:51.40,Default,,0,0,0,,Директор ''бұл шешілді'' деп сенімді.
Dialogue: 0,1:19:51.40,1:19:54.79,Default,,0,0,0,,Мен оны тазалауға тырыссам да! Қарамай-ақ шешім қабылдайсыз ба?
Dialogue: 0,1:19:54.79,1:19:57.31,Default,,0,0,0,,Егер сіз мұны көрсеңіз, оны жойғыңыз келмейді.
Dialogue: 0,1:19:57.31,1:19:58.81,Default,,0,0,0,,Иә! Хи хи хи.
Dialogue: 0,1:19:58.81,1:20:01.81,Default,,0,0,0,,Директордың кабинетіне шабуыл жасайық! Бұл дұрыс! Бұл дұрыс!
Dialogue: 0,1:20:01.81,1:20:04.30,Default,,0,0,0,,Төрағамен тікелей сөйлесуге қалай болады?
Dialogue: 0,1:20:04.30,1:20:08.80,Default,,0,0,0,,Төраға Токумару қорының кәсіпкері, сондықтан онымен кездесу қиын.
Dialogue: 0,1:20:08.80,1:20:12.37,Default,,0,0,0,,Мизусума! Казама! Барлығының атынан барыңыз!
Dialogue: 0,1:20:12.37,1:20:15.31,Default,,0,0,0,,Иә! Кәне! Бар!
Dialogue: 0,1:20:15.31,1:20:18.31,Default,,0,0,0,,Кеттік, Мизунума! Токиоға!
Dialogue: 0,1:20:18.31,1:20:20.80,Default,,0,0,0,,Мизусума!
Dialogue: 0,1:20:20.80,1:20:23.30,Default,,0,0,0,,Өтінемін! (Әйел) Мизунума-сан!
Dialogue: 0,1:20:24.32,1:20:25.82,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,1:20:25.82,1:20:28.30,Default,,0,0,0,,Мел де келуі керек. Бірге барайық.
Dialogue: 0,1:20:28.30,1:20:29.84,Default,,0,0,0,,Уау!
Dialogue: 0,1:20:29.84,1:20:31.84,Default,,0,0,0,,Сәттілік Мел!
Dialogue: 0,1:20:40.82,1:20:42.80,Default,,0,0,0,,Үлкен әпке. иә?
Dialogue: 0,1:20:42.80,1:20:44.80,Default,,0,0,0,,Ертеңгі күн сәтті болсын.
Dialogue: 0,1:20:44.80,1:20:46.30,Default,,0,0,0,,Иә.
Dialogue: 0,1:21:01.30,1:21:03.79,Default,,0,0,0,,Қайырлы таң. қайырлы таң.
Dialogue: 0,1:21:03.79,1:21:05.81,Default,,0,0,0,,Мел ерте кетті ме?
Dialogue: 0,1:21:05.81,1:21:09.31,Default,,0,0,0,,Жоқ. Мен кеше келмегенімді хабарладым.
Dialogue: 0,1:21:09.31,1:21:12.80,Default,,0,0,0,,Жарайды, барлығымыз кеттік.
Dialogue: 0,1:21:12.80,1:21:57.79,Default,,0,0,0,,♪♪~
Dialogue: 0,1:21:57.79,1:21:59.79,Default,,0,0,0,,Қолымыздан келгеннің бәрін жасайық.
Dialogue: 0,1:22:01.31,1:22:04.31,Default,,0,0,0,,Иә, иә, иә, иә, иә.
Dialogue: 0,1:22:05.30,1:22:07.34,Default,,0,0,0,,Сіз тапсырыс бердіңіз бе?
Dialogue: 0,1:22:07.34,1:22:10.41,Default,,0,0,0,,Жоқ. Мен тікелей төрағаға шағымдануға келдім.
Dialogue: 0,1:22:10.41,1:22:12.79,Default,,0,0,0,,Олар тікелей президентке шағымдануы керек сияқты.
Dialogue: 0,1:22:12.79,1:22:16.31,Default,,0,0,0,,Иә, мен Конан академиясының студентімін.
Dialogue: 0,1:22:16.31,1:22:17.81,Default,,0,0,0,,3 адам.
Dialogue: 0,1:22:18.80,1:22:20.30,Default,,0,0,0,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,1:22:21.80,1:22:26.31,Default,,0,0,0,,Сол жақтағы лифтпен 4-қабатқа көтеріліп, сонда күтіңіз.
Dialogue: 0,1:22:26.31,1:22:28.34,Default,,0,0,0,,Ол 4-қабатта.
Dialogue: 0,1:22:28.34,1:22:31.84,Default,,0,0,0,,Аты-жөніңізді сол жерге жазыңыз. Бір ғана адам жақсы.
Dialogue: 0,1:22:36.82,1:22:38.82,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,1:22:41.32,1:22:43.81,Default,,0,0,0,,«Конан академиясының» студенті?
Dialogue: 0,1:22:43.81,1:22:45.82,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:22:45.82,1:22:48.34,Default,,0,0,0,,Президент өте бос емес.
Dialogue: 0,1:22:48.34,1:22:51.91,Default,,0,0,0,,Тапсырыс бермей қонаққа келсеңіз де, кездесе алмай қалуыңыз мүмкін.
Dialogue: 0,1:22:51.91,1:22:55.30,Default,,0,0,0,,Кешіріңіз, бірақ алдын ала сұрамаңыз→
Dialogue: 0,1:22:55.30,1:22:58.30,Default,,0,0,0,,Мен сені кездестіре алмайсың деп ойлап, ішке кірдім.
Dialogue: 0,1:22:58.30,1:23:01.31,Default,,0,0,0,,Мен президентке хабарладым.
Dialogue: 0,1:23:01.31,1:23:03.31,Default,,0,0,0,,Уақытты босқа кетіру мүмкін, бірақ →
Dialogue: 0,1:23:03.31,1:23:06.31,Default,,0,0,0,,Қарсы болмасаңыз, осында күтіңіз.
Dialogue: 0,1:23:06.31,1:23:08.30,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз!
Dialogue: 0,1:23:08.30,1:23:09.82,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,1:23:09.82,1:23:12.37,Default,,0,0,0,,Жоқ, жоқ, Анпанға келгенде, бұл ``Кимурая''.
Dialogue: 0,1:23:12.37,1:23:14.29,Default,,0,0,0,,``Накамурая'' да жақсы, Басқарушы директор.
Dialogue: 0,1:23:14.29,1:23:17.79,Default,,0,0,0,,Қандай бос сөз айтып тұрсың? Мен мүлде түсінбеймін.
Dialogue: 0,1:23:22.81,1:23:24.81,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:23:30.34,1:23:32.39,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,1:23:32.39,1:23:35.39,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,1:23:41.30,1:23:42.80,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,1:23:44.30,1:23:45.80,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:50.81,1:23:52.81,Default,,0,0,0,,Хахаха….
Dialogue: 0,1:23:52.81,1:23:55.81,Default,,0,0,0,,Дұрыс, Ито-чан. Бұл Мэйданың крекері.
Dialogue: 0,1:23:56.86,1:23:58.36,Default,,0,0,0,,Аа...
Dialogue: 0,1:23:59.30,1:24:01.30,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,1:24:07.31,1:24:10.81,Default,,0,0,0,,Балалар, кіріңдер.
Dialogue: 0,1:24:10.81,1:24:12.31,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:14.33,1:24:16.88,Default,,0,0,0,,А, иә, иә. Кешіріңіз.
Dialogue: 0,1:24:16.88,1:24:18.80,Default,,0,0,0,,Иә, иә.
Dialogue: 0,1:24:18.80,1:24:21.79,Default,,0,0,0,,Дұрыс, солай. Аа, дұрыс.
Dialogue: 0,1:24:21.79,1:24:23.81,Default,,0,0,0,,Онда отырыңыз.
Dialogue: 0,1:24:23.81,1:24:26.29,Default,,0,0,0,,Кешіріңіз, сәл күте тұрыңыз.
Dialogue: 0,1:24:26.29,1:24:30.80,Default,,0,0,0,,А, сондықтан. Сәлем айтыңыз.
Dialogue: 0,1:24:30.80,1:24:33.80,Default,,0,0,0,,Иә Иә.
Dialogue: 0,1:24:38.80,1:24:40.31,Default,,0,0,0,,Отырыңыз.
Dialogue: 0,1:24:40.31,1:24:43.31,Default,,0,0,0,,Балалар сендерге мектепте не болды?
Dialogue: 0,1:24:43.31,1:24:45.31,Default,,0,0,0,,Қашып кетті!
Dialogue: 0,1:24:45.31,1:24:49.32,Default,,0,0,0,,Қашу? Мен де жақсы жұмыс жасадым.
Dialogue: 0,1:24:49.32,1:24:52.82,Default,,0,0,0,,Бұл Сейрёсоны қайта құру туралы.
Dialogue: 0,1:24:52.82,1:24:56.39,Default,,0,0,0,,Иә! Мен төрағаның латын кварталына бір көз жүгіртсе екен деймін →
Dialogue: 0,1:24:56.39,1:24:59.81,Default,,0,0,0,,Мен тікелей шағымдануға келдім! Бізге бір рет келіңіздер!
Dialogue: 0,1:24:59.81,1:25:03.80,Default,,0,0,0,,Хмм… жасыңыз нешеде?
Dialogue: 0,1:25:03.80,1:25:06.80,Default,,0,0,0,,Мен екінші курстамын. Менің атым Уми Мацузаки.
Dialogue: 0,1:25:06.80,1:25:09.80,Default,,0,0,0,,Мен апталық тоқсанға арналған гари-кири жасап жатырмын.
Dialogue: 0,1:25:09.80,1:25:13.82,Default,,0,0,0,,Хм... неге Сеирёсоны артта қалдырғың келеді?
Dialogue: 0,1:25:13.82,1:25:16.38,Default,,0,0,0,,Өйткені мен оны жақсы көремін.
Dialogue: 0,1:25:16.38,1:25:18.79,Default,,0,0,0,,Тазалау үшін бәріміз көп еңбек еттік.
Dialogue: 0,1:25:18.79,1:25:21.29,Default,,0,0,0,,Келіңіздер, көріңіздер.
Dialogue: 0,1:25:22.82,1:25:25.82,Default,,0,0,0,,Тазалау... Иә.
Dialogue: 0,1:25:25.82,1:25:28.82,Default,,0,0,0,,Сенің әкеңнің қызметі қандай?
Dialogue: 0,1:25:28.82,1:25:30.81,Default,,0,0,0,,Ол теңізші болған.
Dialogue: 0,1:25:30.81,1:25:35.31,Default,,0,0,0,,Ол капитан болды және Корей соғысы кезінде қайтыс болды.
Dialogue: 0,1:25:36.38,1:26:05.30,Default,,0,0,0,,♪♪~
Dialogue: 0,1:26:07.31,1:26:09.33,Default,,0,0,0,,«LST»?
Dialogue: 0,1:26:09.33,1:26:11.33,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:26:12.31,1:26:14.30,Default,,0,0,0,,Мен...
Dialogue: 0,1:26:14.30,1:26:18.32,Default,,0,0,0,,Анаң сені өсіру үшін көп еңбек еткен болуы керек.
Dialogue: 0,1:26:18.32,1:26:21.82,Default,,0,0,0,,Сіз әдемі жас ханым болдыңыз.
Dialogue: 0,1:26:21.82,1:26:24.38,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:26:24.38,1:26:27.38,Default,,0,0,0,,Түсіндім! барайық!
Dialogue: 0,1:26:30.80,1:26:32.80,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:26:34.30,1:26:37.80,Default,,0,0,0,,А, бұл менмін. Ал ертең ше?
Dialogue: 0,1:26:38.81,1:26:41.81,Default,,0,0,0,,А, түн болды.
Dialogue: 0,1:26:41.81,1:26:43.81,Default,,0,0,0,,Бұл жұма күні.
Dialogue: 0,1:26:45.31,1:26:47.87,Default,,0,0,0,,Жарайды, ертең түстен кейін барамын.
Dialogue: 0,1:26:47.87,1:26:52.37,Default,,0,0,0,,Мен де директормен сөйлесемін және ресми турға барамын.
Dialogue: 0,1:26:56.81,1:26:58.79,Default,,0,0,0,,Бұл жерде жақсы ересек адамдар бар.
Dialogue: 0,1:26:58.79,1:27:00.79,Default,,0,0,0,,Мен әлі білмеймін.
Dialogue: 0,1:27:02.30,1:27:04.30,Default,,0,0,0,,Бірақ бұл жақсы болды.
Dialogue: 0,1:27:05.82,1:27:10.31,Default,,0,0,0,,Мен ертең Қанда ағама барамын.
Dialogue: 0,1:27:10.31,1:27:35.79,Default,,0,0,0,,♪♪~
Dialogue: 0,1:27:37.35,1:27:41.35,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,1:27:46.31,1:27:49.80,Default,,0,0,0,,Казама-сан, сен әлі мансап жолыңды шештің бе?
Dialogue: 0,1:27:49.80,1:27:53.82,Default,,0,0,0,,Иә, мен ұлттық үкіметті нысанаға алып отырмын, себебі менің отбасым кедей.
Dialogue: 0,1:27:53.82,1:27:56.30,Default,,0,0,0,,Апталық тоқсан туралы не деуге болады?
Dialogue: 0,1:27:56.30,1:27:59.82,Default,,0,0,0,,Картье мәселесі шешілгеннен кейін мен оны кішіге тапсырамын.
Dialogue: 0,1:27:59.82,1:28:01.32,Default,,0,0,0,,Мел ше?
Dialogue: 0,1:28:02.88,1:28:04.79,Default,,0,0,0,,Мен әлі шешкен жоқпын.
Dialogue: 0,1:28:04.79,1:28:08.79,Default,,0,0,0,,Мен дәрігер болғым келеді деп ойлаймын, бірақ...
Dialogue: 0,1:28:09.80,1:28:15.80,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,1:28:15.80,1:28:20.34,Default,,0,0,0,,Сол өлең... Оны Казама-сан жазды ма?
Dialogue: 0,1:28:20.34,1:28:25.34,Default,,0,0,0,,Күнде таңертең Мел әкемнің тегінен көтерген туды тамашаладым.
Dialogue: 0,1:28:26.30,1:28:30.30,Default,,0,0,0,,Мен өз бақшамнан кемені көре алмадым.
Dialogue: 0,1:28:30.30,1:28:35.30,Default,,0,0,0,,Сондықтан жауап жалауын көтергеніңізді білмедім.
Dialogue: 0,1:28:46.80,1:28:48.80,Default,,0,0,0,,Казама мырза. иә?
Dialogue: 0,1:28:50.31,1:28:53.81,Default,,0,0,0,,Мен… Бұл менмін….
Dialogue: 0,1:28:55.31,1:28:58.80,Default,,0,0,0,,Күнде ту көтеріп, әкемді шақырдым→
Dialogue: 0,1:28:58.80,1:29:02.33,Default,,0,0,0,,Менің орныма әкем Қазама-санды берді→
Dialogue: 0,1:29:02.33,1:29:04.33,Default,,0,0,0,,Мен бұл туралы ойлануды шештім.
Dialogue: 0,1:29:08.31,1:29:10.79,Default,,0,0,0,,Маған Казама-сан ұнайды.
Dialogue: 0,1:29:10.79,1:29:12.29,Default,,0,0,0,,Мел….
Dialogue: 0,1:29:12.29,1:29:15.30,Default,,0,0,0,,Туысқан болса да, аға-іні болса да →
Dialogue: 0,1:29:15.30,1:29:17.80,Default,,0,0,0,,Мен сені қатты жақсы көремін!
Dialogue: 0,1:29:26.39,1:29:28.89,Default,,0,0,0,,Мен де сені жақсы көремін.
Dialogue: 0,1:29:30.81,1:29:32.81,Default,,0,0,0,,(Шығу қоңырауы)
Dialogue: 0,1:29:32.81,1:29:48.90,Default,,0,0,0,,♪♪~
Dialogue: 0,1:29:48.90,1:29:50.90,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,1:29:52.80,1:29:54.30,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:55.80,1:29:58.81,Default,,0,0,0,,Итадакимасу! ана!
Dialogue: 0,1:29:58.81,1:30:00.81,Default,,0,0,0,,Теңіз! Мен үйдемін.
Dialogue: 0,1:30:00.81,1:30:04.31,Default,,0,0,0,,Қайтадан қош келдіңіз! Америка қалай болды?
Dialogue: 0,1:30:04.31,1:30:07.32,Default,,0,0,0,,Менің күндерім оқумен өтті.
Dialogue: 0,1:30:07.32,1:30:09.87,Default,,0,0,0,,Сора Жігіт таптың ба?
Dialogue: 0,1:30:09.87,1:30:11.40,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,1:30:11.40,1:30:13.81,Default,,0,0,0,,Анашым, бұл дәмді!
Dialogue: 0,1:30:13.81,1:30:15.81,Default,,0,0,0,,Сиыр еті.
Dialogue: 0,1:30:15.81,1:30:19.80,Default,,0,0,0,,Бұл шошқа ма? (Макимура) Хиро-чан Сиыр – сиыр!
Dialogue: 0,1:30:19.80,1:30:22.80,Default,,0,0,0,,Хахахаха….
Dialogue: 0,1:30:30.87,1:30:32.87,Default,,0,0,0,,Ана.
Dialogue: 0,1:30:35.79,1:30:38.29,Default,,0,0,0,,Не болды? Сонша кеш.
Dialogue: 0,1:30:42.30,1:30:44.79,Default,,0,0,0,,Анаңнан сұрайын дегенім бар.
Dialogue: 0,1:30:44.79,1:30:46.79,Default,,0,0,0,,Отырыңыз.
Dialogue: 0,1:30:51.33,1:30:53.88,Default,,0,0,0,,Уақыт айырмашылығына байланысты ұйықтай алмаймын→
Dialogue: 0,1:30:53.88,1:30:57.30,Default,,0,0,0,,Мен тазалауды бастағанда, мен одан да сергек болдым.
Dialogue: 0,1:30:57.30,1:31:01.30,Default,,0,0,0,,Мектепте менен бір жыл жоғары тұрған Шун Казама деген адам бар.
Dialogue: 0,1:31:03.81,1:31:06.31,Default,,0,0,0,,Хокуто-санның қоштасу кешіне келді→
Dialogue: 0,1:31:06.31,1:31:10.31,Default,,0,0,0,,Мен оған әкемнің суретін көрсеткенімде, Казама мырзаның қолында сол фото→
Dialogue: 0,1:31:10.31,1:31:14.31,Default,,0,0,0,,Юичиро Савамура - Казама-санның әкесі...
Dialogue: 0,1:31:32.82,1:31:34.82,Default,,0,0,0,,Бұл сурет?
Dialogue: 0,1:31:38.84,1:31:40.38,Default,,0,0,0,,Иә.
Dialogue: 0,1:31:40.38,1:31:44.88,Default,,0,0,0,,Иә, бұл біршама күрделі болуы мүмкін.
Dialogue: 0,1:31:45.80,1:31:49.80,Default,,0,0,0,,Әкең екеуміз қашып кеттік дедім.
Dialogue: 0,1:31:49.80,1:31:52.32,Default,,0,0,0,,Иә. Сіздің де есіңізде, солай ма?
Dialogue: 0,1:31:52.32,1:31:57.81,Default,,0,0,0,,Біз Рокугодағы Инамура мырзаның үйінің екінші қабатында тұрдық.
Dialogue: 0,1:31:57.81,1:32:00.83,Default,,0,0,0,,Юичиро жиі саяхатқа шығады→
Dialogue: 0,1:32:00.83,1:32:06.30,Default,,0,0,0,,Сол уақытта мен сені қолтығыма алып мектепке бардым.
Dialogue: 0,1:32:06.30,1:32:11.82,Default,,0,0,0,,Бірақ оқуға түскеніме қуанып, толқып кеттім.
Dialogue: 0,1:32:11.82,1:32:27.31,Default,,0,0,0,,♪♪~
Dialogue: 0,1:32:27.31,1:32:29.31,Default,,0,0,0,,()
Dialogue: 0,1:32:29.31,1:32:37.32,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:32:37.32,1:32:40.39,Default,,0,0,0,,((Тачибана жігіті құтқару кемесінің бортында →
Dialogue: 0,1:32:40.39,1:32:42.30,Default,,0,0,0,,Жазатайым жағдайда қайтыс болды))
Dialogue: 0,1:32:42.30,1:32:46.32,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:32:46.32,1:32:51.32,Default,,0,0,0,,((Менің туыстарымның барлығы Пикадон. Оларды жалғыз қалдырсам, олар балалар үйіне түседі))
Dialogue: 0,1:32:53.85,1:32:56.90,Default,,0,0,0,,Үкімет кеңсесіне Юичиро сіздің балаңыз екенін хабарлаңыз→
Dialogue: 0,1:32:56.90,1:32:59.30,Default,,0,0,0,,Мен сені осында күшпен алып келдім.
Dialogue: 0,1:32:59.30,1:33:01.32,Default,,0,0,0,,Соғыс енді ғана аяқталды→
Dialogue: 0,1:33:01.32,1:33:04.33,Default,,0,0,0,,Ондайлар көп болды.
Dialogue: 0,1:33:04.33,1:33:10.32,Default,,0,0,0,,Бірақ... сен менің құрсағымдасың, мен сені өсіре алмаймын.
Dialogue: 0,1:33:10.32,1:33:13.32,Default,,0,0,0,,Теңізші ретінде өзіңіз қалаған адамды табыңыз →
Dialogue: 0,1:33:13.32,1:33:15.87,Default,,0,0,0,,Мен асырап алдым.
Dialogue: 0,1:33:15.87,1:33:19.32,Default,,0,0,0,,Ол бала жақсы бала болды ма?
Dialogue: 0,1:33:19.32,1:33:21.81,Default,,0,0,0,,Иә.
Dialogue: 0,1:33:21.81,1:33:24.30,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,1:33:24.30,1:33:29.32,Default,,0,0,0,,Сенің әкең немқұрайлы болса да, нағыз жақсы адам еді.
Dialogue: 0,1:33:29.32,1:33:33.84,Default,,0,0,0,,Сол кісінің арқасында оқуымды жалғастырдым.
Dialogue: 0,1:33:33.84,1:33:40.31,Default,,0,0,0,,Бірақ Казама-сан әкеңнің нағыз баласы болса ше...
Dialogue: 0,1:33:40.31,1:33:43.32,Default,,0,0,0,,Сол адамның баласы болса ше?
Dialogue: 0,1:33:43.32,1:33:45.30,Default,,0,0,0,,Мен сені көргім келеді.
Dialogue: 0,1:33:45.30,1:33:48.30,Default,,0,0,0,,Олар ұқсас па? Мына фотомен.
Dialogue: 0,1:33:51.81,1:33:53.81,Default,,0,0,0,,Иә….
Dialogue: 0,1:33:58.80,1:34:00.82,Default,,0,0,0,,Теңіз….
Dialogue: 0,1:34:00.82,1:34:13.33,Default,,0,0,0,,♪♪~
Dialogue: 0,1:34:13.33,1:34:31.83,Default,,0,0,0,,♪♪~ (жылап)
Dialogue: 0,1:37:34.31,1:37:36.31,Default,,0,0,0,,Мен барамын. мен барамын.
Dialogue: 0,1:37:36.31,1:37:38.31,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,1:38:25.31,1:38:26.81,Default,,0,0,0,,Хмм….
Dialogue: 0,1:38:35.31,1:38:37.31,Default,,0,0,0,,Хмм...
Dialogue: 0,1:38:40.83,1:38:43.31,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,1:38:43.31,1:38:45.31,Default,,0,0,0,,Эй, эй, эй.
Dialogue: 0,1:38:50.34,1:38:52.89,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:38:52.89,1:39:09.81,Default,,0,0,0,,♪♪~ (қол шапалақтау)
Dialogue: 0,1:39:09.81,1:39:12.33,Default,,0,0,0,,Бұл өте керемет ғимарат.
Dialogue: 0,1:39:12.33,1:39:14.83,Default,,0,0,0,,Мен қорқамын.
Dialogue: 0,1:39:15.83,1:39:18.90,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,1:39:18.90,1:39:22.82,Default,,0,0,0,,Ха! Мен 10 жыл бойы күн дақтарын бақылап келемін!
Dialogue: 0,1:39:22.82,1:39:26.81,Default,,0,0,0,,Міне, 10 жыл болды... Сонда сіз бірдеңе үйрендіңіз бе?
Dialogue: 0,1:39:26.81,1:39:31.31,Default,,0,0,0,,Күннің ғұмыры ұзақ, біздің уақытымыз қысқа→
Dialogue: 0,1:39:31.31,1:39:33.33,Default,,0,0,0,,Мен әлі ештеңе түсінбеймін!
Dialogue: 0,1:39:33.33,1:39:35.30,Default,,0,0,0,,Иә, тазалық жақсы!
Dialogue: 0,1:39:35.30,1:39:41.82,Default,,0,0,0,,♪♪~
Dialogue: 0,1:39:41.82,1:39:44.31,Default,,0,0,0,,Философия?
Dialogue: 0,1:39:44.31,1:39:48.33,Default,,0,0,0,,Жаңа клуб бөлмесін қаламайсыз ба?
Dialogue: 0,1:39:48.33,1:39:51.80,Default,,0,0,0,,Сенің де сүйкімді жасөспірімдерің бар сияқты.
Dialogue: 0,1:39:51.80,1:39:55.82,Default,,0,0,0,,Кешіріңіз, мәртебелі мәртебелі, бірақ сіз бөшкеде өмір сүрген философты білесіз бе?
Dialogue: 0,1:39:55.82,1:39:57.87,Default,,0,0,0,,Диоген!
Dialogue: 0,1:39:57.87,1:40:01.83,Default,,0,0,0,,Хахахаха….
Dialogue: 0,1:40:01.83,1:40:05.81,Default,,0,0,0,,Директор: Жақсы оқитындар емес пе?
Dialogue: 0,1:40:05.81,1:40:07.83,Default,,0,0,0,,Әлі де...
Dialogue: 0,1:40:07.83,1:40:10.83,Default,,0,0,0,,Үшінші курс Казама-кун? иә.
Dialogue: 0,1:40:12.32,1:40:15.32,Default,,0,0,0,,Ах! (Токумару) Хахахаха...
Dialogue: 0,1:40:15.32,1:40:16.86,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:40:16.86,1:40:18.89,Default,,0,0,0,,Сәлеметсіз бе, әке?
Dialogue: 0,1:40:18.89,1:40:21.33,Default,,0,0,0,,Фотодағы үшінші Онодера жақындап қалды.
Dialogue: 0,1:40:21.33,1:40:23.82,Default,,0,0,0,,Мәліметтерді білетін сияқты.
Dialogue: 0,1:40:23.82,1:40:25.32,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:25.32,1:40:28.32,Default,,0,0,0,,Кеме портта. Ол порттан сағат 4-те шығады.
Dialogue: 0,1:40:28.32,1:40:31.82,Default,,0,0,0,,Шетелдік бағыт, сондықтан біразға дейін қайта алмаймын. Қазір кел!
Dialogue: 0,1:40:33.32,1:40:42.33,Default,,0,0,0,,♪~
Dialogue: 0,1:40:42.33,1:40:47.82,Default,,0,0,0,,♪~ Қою көк толқындар
Dialogue: 0,1:40:47.82,1:40:52.33,Default,,0,0,0,,♪~ Менде бәрі болатын күн келсе де
Dialogue: 0,1:40:52.33,1:40:56.85,Default,,0,0,0,,♪～ Көкжиекке
Dialogue: 0,1:40:56.85,1:41:02.30,Default,,0,0,0,,♪~ Өлмеу керек
Dialogue: 0,1:41:02.30,1:41:06.81,Default,,0,0,0,,♪~ Біз таулармыз
Dialogue: 0,1:41:06.81,1:41:11.81,Default,,0,0,0,,♪～ шыңдар айналады
Dialogue: 0,1:41:11.81,1:41:16.83,Default,,0,0,0,,♪~ Болашақтан соққан желде
Dialogue: 0,1:41:16.83,1:41:20.91,Default,,0,0,0,,♪~ Басыңызды көтеріңіз
Dialogue: 0,1:41:20.91,1:41:25.79,Default,,0,0,0,,♪~ Қою көк толқындар
Dialogue: 0,1:41:25.79,1:41:30.30,Default,,0,0,0,,♪~ Жейтін күнім келсе де
Dialogue: 0,1:41:30.30,1:41:34.80,Default,,0,0,0,,♪～ Көкжиекке
Dialogue: 0,1:41:34.80,1:41:40.83,Default,,0,0,0,,♪~ Өлмеу керек
Dialogue: 0,1:41:40.83,1:41:45.30,Default,,0,0,0,,Мырзалар! Енді сіз осы Quartier латынның қадірін білесіз!
Dialogue: 0,1:41:45.30,1:41:49.80,Default,,0,0,0,,Тәрбиеші ретінде мәдениетті қорғамай ештеңе айтпа!
Dialogue: 0,1:41:51.32,1:41:56.82,Default,,0,0,0,,Мен жауапкершілікті өз мойныма алып, басқа жерде клуб үйін саламын!
Dialogue: 0,1:41:57.84,1:42:01.41,Default,,0,0,0,,Иә!
Dialogue: 0,1:42:01.41,1:42:05.32,Default,,0,0,0,,Иә! Мел! жақсы!
Dialogue: 0,1:42:05.32,1:42:08.82,Default,,0,0,0,,Мен таң қалдым! Мен әсер алдым!
Dialogue: 0,1:42:08.82,1:42:12.81,Default,,0,0,0,,Аман болсын! Ура!
Dialogue: 0,1:42:12.81,1:42:14.31,Default,,0,0,0,,Уау!
Dialogue: 0,1:42:14.31,1:42:17.31,Default,,0,0,0,,Келесі экспериментке дайындалайық! иә!
Dialogue: 0,1:42:17.31,1:42:20.35,Default,,0,0,0,,Рахмет. Мелге рахмет.
Dialogue: 0,1:42:20.35,1:42:23.92,Default,,0,0,0,,Иә, иә. Менде ондай ештеңе жоқ...
Dialogue: 0,1:42:23.92,1:42:26.82,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Оны бастаған Мэл болды!
Dialogue: 0,1:42:26.82,1:42:29.82,Default,,0,0,0,,Иә, иә! Мел! рақмет сізге!
Dialogue: 0,1:42:29.82,1:42:31.81,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:42:31.81,1:42:34.31,Default,,0,0,0,,Сізге жақсы, Мел.
Dialogue: 0,1:42:35.31,1:42:36.81,Default,,0,0,0,,Мел!
Dialogue: 0,1:42:41.85,1:42:44.85,Default,,0,0,0,,Әй, екеуің! Мен оны өртеп жіберемін!
Dialogue: 0,1:42:45.81,1:42:50.83,Default,,0,0,0,,Жоғары мәртебелі! Бұл екі адамның өмірінде маңызды нәрсе болды.
Dialogue: 0,1:42:50.83,1:42:53.31,Default,,0,0,0,,Екеуің асығуларың керек!
Dialogue: 0,1:42:53.31,1:42:56.82,Default,,0,0,0,,Қашу! Жастық шақ.
Dialogue: 0,1:42:56.82,1:43:01.36,Default,,0,0,0,,♪♪~
Dialogue: 0,1:43:01.36,1:43:03.39,Default,,0,0,0,,Казама-сан!
Dialogue: 0,1:43:03.39,1:43:04.89,Default,,0,0,0,,Ген-сан!
Dialogue: 0,1:43:05.83,1:43:07.81,Default,,0,0,0,,Уми-чан!
Dialogue: 0,1:43:07.81,1:43:16.32,Default,,0,0,0,,♪♪~
Dialogue: 0,1:43:16.32,1:43:20.86,Default,,0,0,0,,Уми-чан, уайымдама! Оны генерал мырзаға қалдырыңыз!
Dialogue: 0,1:43:20.86,1:43:31.32,Default,,0,0,0,,♪♪~
Dialogue: 0,1:43:31.32,1:43:34.82,Default,,0,0,0,,Жоқ, жүгірейік! Иә, рахмет!
Dialogue: 0,1:43:35.82,1:43:38.31,Default,,0,0,0,,Кешіріңіз! Уми-чан!
Dialogue: 0,1:43:38.31,1:43:45.33,Default,,0,0,0,,♪♪~
Dialogue: 0,1:43:45.33,1:43:48.33,Default,,0,0,0,,Шун-чан! Асығыңыз!
Dialogue: 0,1:43:49.42,1:43:50.82,Default,,0,0,0,,Оны басқа жерде көрді, сондықтан ол сонда кетті.
Dialogue: 0,1:43:50.82,1:44:19.80,Default,,0,0,0,,♪♪~
Dialogue: 0,1:44:19.80,1:44:21.82,Default,,0,0,0,,Бұл менің әкемнің белгісі.
Dialogue: 0,1:44:21.82,1:44:29.32,Default,,0,0,0,,♪♪~
Dialogue: 0,1:44:40.30,1:44:41.80,Default,,0,0,0,,Әй!
Dialogue: 0,1:44:48.31,1:44:50.81,Default,,0,0,0,,Капитан, мен сені осында әкелдім.
Dialogue: 0,1:44:59.81,1:45:02.81,Default,,0,0,0,,Ұшу 15 минутқа кешіктіріледі. Ха!
Dialogue: 0,1:45:06.81,1:45:11.32,Default,,0,0,0,,Мен көремін. Сен Тачибананың ұлысың...
Dialogue: 0,1:45:11.32,1:45:14.32,Default,,0,0,0,,Сен Савамураның қызысың ба...?
Dialogue: 0,1:45:14.32,1:45:16.32,Default,,0,0,0,,Құрметке ие болды.
Dialogue: 0,1:45:31.32,1:45:34.36,Default,,0,0,0,,Сіз мистер Шун айттыңыз. иә.
Dialogue: 0,1:45:34.36,1:45:37.41,Default,,0,0,0,,Сіздің әкеңіз Хироси Тачибана.
Dialogue: 0,1:45:37.41,1:45:40.31,Default,,0,0,0,,Ол фотосуреттің алдыңғы қатарындағы оң жақтағы төртінші адам.
Dialogue: 0,1:45:40.31,1:45:43.80,Default,,0,0,0,,Савамура да сенің жаныңда екенін байқайсың.
Dialogue: 0,1:45:43.80,1:45:46.80,Default,,0,0,0,,Біз ең жақын дос болдық.
Dialogue: 0,1:45:47.82,1:45:51.31,Default,,0,0,0,,((Тачибана, сіз ортасындасыз)) (Тачибана) ((Мен?))
Dialogue: 0,1:45:51.31,1:45:56.33,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:45:58.80,1:46:06.32,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:46:18.30,1:46:22.81,Default,,0,0,0,,Сенің ата-анаң қайтыс болғанда мен теңізде болдым. Егер бұл
Dialogue: 0,1:46:22.81,1:46:27.31,Default,,0,0,0,,болмағанда, мен Савамура сияқты әрекет етер едім.
Dialogue: 0,1:46:27.31,1:46:31.33,Default,,0,0,0,,Тачибана мен Савамураның ұлы мен қызымен танысу→
Dialogue: 0,1:46:31.33,1:46:33.85,Default,,0,0,0,,Мен бақыттымын Рахмет.
Dialogue: 0,1:46:33.85,1:46:36.40,Default,,0,0,0,,Мен ешқашан мұндай бақытты болған емеспін.
Dialogue: 0,1:46:36.40,1:46:40.32,Default,,0,0,0,,♪♪~ “Қош бол жаз ~ Көкнәр төбесінен~”
Dialogue: 0,1:46:40.32,1:46:46.33,Default,,0,0,0,,♪♪~
Dialogue: 0,1:46:46.33,1:46:53.32,Default,,0,0,0,,♪♪～ (бу ысқырығы)
Dialogue: 0,1:46:53.32,1:46:56.37,Default,,0,0,0,,♪♪~
Dialogue: 0,1:46:56.37,1:47:03.31,Default,,0,0,0,,♪♪~ Жарқыраған теңізде тұман басқан кеме
Dialogue: 0,1:47:03.31,1:47:10.32,Default,,0,0,0,,♪♪~ Қоштасу ысқырығын қалдырамын
Dialogue: 0,1:47:10.32,1:47:17.31,Default,,0,0,0,,♪♪~ Егер сіз жұмсақ еңіспен төмен түссеңіз
Dialogue: 0,1:47:17.31,1:47:24.30,Default,,0,0,0,,♪♪~ Жаздай боялған желді қарсы алар ма екенмін
Dialogue: 0,1:47:24.30,1:47:30.83,Default,,0,0,0,,♪♪~ Менің махаббатым – әуен
Dialogue: 0,1:47:30.83,1:47:37.82,Default,,0,0,0,,♪♪~ Қатты ән айт
Dialogue: 0,1:47:37.82,1:47:44.32,Default,,0,0,0,,♪♪~ Менің махаббатым – шағала
Dialogue: 0,1:47:44.32,1:47:51.31,Default,,0,0,0,,♪♪～ биікте ұшыңыз
Dialogue: 0,1:47:51.31,1:47:58.34,Default,,0,0,0,,♪♪~ Батып бара жатқан күнде сені шақырдым
Dialogue: 0,1:47:58.34,1:48:01.91,Default,,0,0,0,,♪♪~ Сіз үшін
Dialogue: 0,1:48:01.91,1:48:06.31,Default,,0,0,0,,♪♪~ Қызық, кездесе аламыз ба?
Dialogue: 0,1:48:06.31,1:48:30.32,Default,,0,0,0,,♪♪~
Dialogue: 0,1:48:30.32,1:48:33.30,Default,,0,0,0,,♪♪～ (бу ысқырығы)
Dialogue: 0,1:48:33.30,1:48:37.81,Default,,0,0,0,,♪♪~
Dialogue: 0,1:48:37.81,1:48:44.80,Default,,0,0,0,,♪♪~ Серуенде тербелген ағаштар
Dialogue: 0,1:48:44.80,1:48:51.31,Default,,0,0,0,,♪♪~ Қоштасудың көлеңкесін тастадым
Dialogue: 0,1:48:51.31,1:48:58.30,Default,,0,0,0,,♪♪~ Old Chapel Weathervane Chicken
Dialogue: 0,1:48:58.30,1:49:05.32,Default,,0,0,0,,♪♪~ Қаланы жазғы түстермен көре аласыз ба?
Dialogue: 0,1:49:05.32,1:49:11.81,Default,,0,0,0,,♪♪~ Кешегі махаббат - көз жасы
Dialogue: 0,1:49:11.81,1:49:18.82,Default,,0,0,0,,♪♪~ Ақырында, шөлдеу жоғалады.
Dialogue: 0,1:49:18.82,1:49:25.81,Default,,0,0,0,,♪♪~ Ертеңгі махаббат - Лефранк
Dialogue: 0,1:49:25.81,1:49:32.80,Default,,0,0,0,,♪♪~ Шексіз сөздер
Dialogue: 0,1:49:32.80,1:49:39.32,Default,,0,0,0,,♪♪~ Күн батқанда тағы кездессек
Dialogue: 0,1:49:39.32,1:49:43.39,Default,,0,0,0,,♪♪~ Сен менсің
Dialogue: 0,1:49:43.39,1:49:50.33,Default,,0,0,0,,♪♪~ Сіз мені ұстағыңыз келе ме?
Dialogue: 0,1:49:50.33,1:50:31.33,Default,,0,0,0,,♪♪~
Dialogue: 0,1:50:55.81,1:50:58.30,Default,,0,0,0,,«Жұма жол ШОУ!» Көріп отырғандардың барлығына.
Dialogue: 0,1:50:58.30,1:51:00.30,Default,,0,0,0,,Қайырлы кеш, менің атым Юзу.
Dialogue: 0,1:51:05.32,1:51:10.34,Default,,0,0,0,,Бұл кек тағдыры артылған баланың кескілескен шайқасы туралы.
Dialogue: 0,1:51:10.34,1:51:13.91,Default,,0,0,0,,Біз фильмді бірінші рет көрдік →
Dialogue: 0,1:51:13.91,1:51:15.83,Default,,0,0,0,,Тіпті үлкендер қарасақ та →
Dialogue: 0,1:51:15.83,1:51:18.32,Default,,0,0,0,,Мазмұны өте әсерлі деп ойлаймын.
Dialogue: 0,1:51:18.32,1:51:22.82,Default,,0,0,0,,Осы фильмнің тақырыптық әні, ''СЕБЕП'', біз ''Yuzu'' айтады.
Dialogue: 0,1:51:22.82,1:51:26.81,Default,,0,0,0,,Осы дүниедегі өміріміздің мәнін қайта қарастыру →
Dialogue: 0,1:51:26.81,1:51:30.86,Default,,0,0,0,,Хабар: біз осы жерден қозғала аламыз.
Dialogue: 0,1:51:30.86,1:51:32.90,Default,,0,0,0,,Комикстерді қайта оқу →
Dialogue: 0,1:51:32.90,1:51:35.80,Default,,0,0,0,,«АҢшы х АҢшы» дүниетанымы бойынша өлең шығардым.
Dialogue: 0,1:51:35.80,1:51:38.32,Default,,0,0,0,,Әндерімізбен шағын әңгіме айтыңыз →
Dialogue: 0,1:51:38.32,1:51:40.82,Default,,0,0,0,,Бұл қызықты болады деп үміттенемін.
Dialogue: 0,1:51:40.82,1:51:44.33,Default,,0,0,0,,Бұл өте жақсы фильм, сондықтан оны театрға барып көріңіз.
Dialogue: 0,1:51:44.33,1:51:46.83,Default,,0,0,0,,Сәлем, ол ертең шығады!
Dialogue: 0,1:51:47.82,1:52:15.82,Default,,0,0,0,,♪♪~
Dialogue: 0,1:52:25.82,1:52:27.32,Default,,0,0,0,,Оның аты бар ма?
Dialogue: 0,1:52:27.32,1:52:28.82,Default,,0,0,0,,Клауту.
Dialogue: 0,1:52:31.31,1:52:33.79,Default,,0,0,0,,<Мақсат не? ＞
Dialogue: 0,1:52:33.79,1:52:37.82,Default,,0,0,0,,Сіздің өмір жолыңыз соған әкелді.
Dialogue: 0,1:52:37.82,1:52:41.39,Default,,0,0,0,,Біз өзгереміз, сіз мұны білесіз бе?
Dialogue: 0,1:52:41.39,1:52:43.32,Default,,0,0,0,,тым кеш!
Dialogue: 0,1:52:47.31,1:52:49.31,Default,,0,0,0,,<Оны жіберіп алмаңыз! ＞
Dialogue: 0,1:52:50.81,1:52:55.81,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
