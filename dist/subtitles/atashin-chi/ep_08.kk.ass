Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:14.87,0:01:16.80,Default,,0,0,0,,Ах
Dialogue: 0,0:01:16.80,0:01:18.80,Default,,0,0,0,,Үлкен? үлкен
Dialogue: 0,0:01:18.80,0:01:20.81,Default,,0,0,0,,Ол соншалықты жағымсыз иіс емес.
Dialogue: 0,0:01:20.81,0:01:23.81,Default,,0,0,0,,Иістің тарағанын күтіңіз
Dialogue: 0,0:01:23.81,0:01:25.81,Default,,0,0,0,,Ах, уау!
Dialogue: 0,0:01:28.80,0:01:30.80,Default,,0,0,0,,Сіздің әпкеңіз де үлкен бе?
Dialogue: 0,0:02:54.80,0:03:01.81,Default,,0,0,0,,Құмарлықтың қызыл раушан гүлі
Dialogue: 0,0:03:01.81,0:03:06.81,Default,,0,0,0,,және қызғаныш
Dialogue: 0,0:03:06.81,0:03:09.80,Default,,0,0,0,,Фуфуфу фу…
Dialogue: 0,0:03:09.80,0:03:12.80,Default,,0,0,0,,Ах... Ах.
Dialogue: 0,0:03:14.80,0:03:16.80,Default,,0,0,0,,Хехехехехехехехехе
Dialogue: 0,0:03:16.80,0:03:18.81,Default,,0,0,0,,Ах ха ха ха ха
Dialogue: 0,0:03:18.81,0:03:21.81,Default,,0,0,0,,Ах
Dialogue: 0,0:03:21.81,0:03:23.81,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:03:33.80,0:03:36.81,Default,,0,0,0,,Бөлмені жөндеу Бұл жолы менің мақсатым болды
Dialogue: 0,0:03:36.81,0:03:39.81,Default,,0,0,0,,Азиялық курорттық қонақүйдегі арнайы люкс бөлмесі
Dialogue: 0,0:03:39.81,0:03:41.81,Default,,0,0,0,,Босаңсытатын қонақ бөлмесі елестейді
Dialogue: 0,0:03:44.80,0:03:46.80,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:03:46.80,0:03:48.80,Default,,0,0,0,,Қазір танымал кафеге ұқсайды.
Dialogue: 0,0:03:48.80,0:03:51.81,Default,,0,0,0,,Мен де осындай дәмді қосуға тырыстым.
Dialogue: 0,0:03:51.81,0:03:55.81,Default,,0,0,0,,Бұл жанама жарықтандыру да атмосфера жасайды.
Dialogue: 0,0:03:55.81,0:04:00.80,Default,,0,0,0,,Бұл мен 100 иен тұратын дүкеннен сатып алған қоқыс себеті.
Dialogue: 0,0:04:00.80,0:04:02.80,Default,,0,0,0,,Эй, бұл жақсы.
Dialogue: 0,0:04:02.80,0:04:04.80,Default,,0,0,0,,Сіз қалай ойлайсыз? Уау
Dialogue: 0,0:04:04.80,0:04:07.81,Default,,0,0,0,,Жақсы, бұл менің бөлмеме ұқсамайды.
Dialogue: 0,0:04:07.81,0:04:10.81,Default,,0,0,0,,Ой, жарнамадан кейін ауа райы.
Dialogue: 0,0:04:16.81,0:04:19.80,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:19.80,0:04:21.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:28.81,0:04:31.81,Default,,0,0,0,,А-а-а-а-а!
Dialogue: 0,0:04:38.80,0:04:40.81,Default,,0,0,0,,Хун
Dialogue: 0,0:04:40.81,0:04:42.81,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,0:04:44.81,0:04:47.81,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:04:49.81,0:04:52.80,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:04:52.80,0:04:54.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:54.80,0:04:58.81,Default,,0,0,0,,Уау... Ах... Арғ... Уау.
Dialogue: 0,0:04:58.81,0:05:01.81,Default,,0,0,0,,Жақсы, осылай
Dialogue: 0,0:05:01.81,0:05:03.81,Default,,0,0,0,,Келесі
Dialogue: 0,0:05:03.81,0:05:05.81,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:05:05.81,0:05:07.82,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:05:07.82,0:05:14.81,Default,,0,0,0,,Мммфмф
Dialogue: 0,0:05:14.81,0:05:16.81,Default,,0,0,0,,Жоқ, мен саған кеше айтқан жоқпын ба? Лукако – нағыз жігіт.
Dialogue: 0,0:05:16.81,0:05:18.81,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:18.81,0:05:22.81,Default,,0,0,0,,Уф уф...
Dialogue: 0,0:05:22.81,0:05:24.82,Default,,0,0,0,,Жоқ, мен саған кеше айтқан жоқпын ба? Лукако – нағыз жігіт.
Dialogue: 0,0:05:24.82,0:05:28.80,Default,,0,0,0,,...
Dialogue: 0,0:05:28.80,0:05:33.81,Default,,0,0,0,,Nu! Nu! Ну!
Dialogue: 0,0:05:33.81,0:05:36.81,Default,,0,0,0,,Жоқ, мен саған кеше айтқан жоқпын ба? Лукако – нағыз жігіт.
Dialogue: 0,0:05:38.81,0:05:40.81,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:05:45.80,0:05:47.80,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:50.81,0:05:52.81,Default,,0,0,0,,Хамф!
Dialogue: 0,0:05:52.81,0:05:55.81,Default,,0,0,0,,Уф!Уф!
Dialogue: 0,0:05:55.81,0:05:58.81,Default,,0,0,0,,А, мен оны аздап шығаруым керек.
Dialogue: 0,0:06:01.80,0:06:03.80,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:06:03.80,0:06:05.81,Default,,0,0,0,,Қызықты...
Dialogue: 0,0:06:05.81,0:06:09.81,Default,,0,0,0,,А, мен көбірек беруім керек.
Dialogue: 0,0:06:09.81,0:06:11.81,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:15.82,0:06:17.82,Default,,0,0,0,,Сеноха!
Dialogue: 0,0:06:17.82,0:06:21.81,Default,,0,0,0,,Ммм! Гррр...
Dialogue: 0,0:06:21.81,0:06:25.81,Default,,0,0,0,,Нувааа...
Dialogue: 0,0:06:25.81,0:06:27.81,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:06:27.81,0:06:30.82,Default,,0,0,0,,Сеноха!
Dialogue: 0,0:06:30.82,0:06:34.82,Default,,0,0,0,,Уау, ау, әй...
Dialogue: 0,0:06:34.82,0:06:36.80,Default,,0,0,0,,Менің ойымша жақсы идея
Dialogue: 0,0:06:36.80,0:06:38.80,Default,,0,0,0,,Ой, ой, ой
Dialogue: 0,0:06:42.81,0:06:45.81,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:06:45.81,0:06:47.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:50.82,0:06:52.82,Default,,0,0,0,,А, қайта безендіру?
Dialogue: 0,0:06:52.82,0:06:55.81,Default,,0,0,0,,Қош келдіңіз, өте кең.
Dialogue: 0,0:06:55.81,0:06:58.81,Default,,0,0,0,,Иә, мен таң қалдым.
Dialogue: 0,0:06:58.81,0:07:00.81,Default,,0,0,0,,Бір нәрсе үйде емес сияқты.
Dialogue: 0,0:07:00.81,0:07:02.81,Default,,0,0,0,,Бұл мәселе болды, сондықтан мен қазір жалғызбын.
Dialogue: 0,0:07:02.81,0:07:06.82,Default,,0,0,0,,А, диван терезенің жанында жақсырақ. Атмосфера өзгереді.
Dialogue: 0,0:07:06.82,0:07:08.82,Default,,0,0,0,,Әй, бұл мата да жақсы.
Dialogue: 0,0:07:08.82,0:07:10.81,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:07:10.81,0:07:12.81,Default,,0,0,0,,Аппаппаны баяғыда жасаған кезден қалған бөліктер
Dialogue: 0,0:07:12.81,0:07:14.81,Default,,0,0,0,,Әй, не айтсаң да.
Dialogue: 0,0:07:14.81,0:07:16.81,Default,,0,0,0,,Өйткені ол азиялық курортқа ұқсайды.
Dialogue: 0,0:07:20.82,0:07:24.82,Default,,0,0,0,,Дәл қазір не болып жатыр? Мұнда ешкім жоқ па?
Dialogue: 0,0:07:24.82,0:07:27.81,Default,,0,0,0,,Нана Ах
Dialogue: 0,0:07:27.81,0:07:29.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:32.81,0:07:34.81,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:07:34.81,0:07:36.81,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:36.81,0:07:38.82,Default,,0,0,0,,Азия курорты.
Dialogue: 0,0:07:38.82,0:07:41.82,Default,,0,0,0,,Бұл мен көптен бері қолданбаған нәрсем.
Dialogue: 0,0:07:41.82,0:07:43.82,Default,,0,0,0,,Хехе, жарайды.
Dialogue: 0,0:07:43.82,0:07:47.81,Default,,0,0,0,,Оңтүстік аралдың ұлы патшасы
Dialogue: 0,0:07:47.81,0:07:50.81,Default,,0,0,0,,Аты Ұлы Хамехамеха
Dialogue: 0,0:07:50.81,0:07:54.82,Default,,0,0,0,,Азиялық демалыс орны деп нені айтады?
Dialogue: 0,0:07:54.82,0:07:56.82,Default,,0,0,0,,Бүгінгі Гавайи.
Dialogue: 0,0:07:58.82,0:08:00.82,Default,,0,0,0,,Ей, ұлпа, қайда бардың?
Dialogue: 0,0:08:00.82,0:08:02.82,Default,,0,0,0,,Аа, анау жақта, анау жақта.
Dialogue: 0,0:08:04.81,0:08:07.81,Default,,0,0,0,,Иә, мынаны айтайық.
Dialogue: 0,0:08:09.81,0:08:11.82,Default,,0,0,0,,Өте қызықсыз
Dialogue: 0,0:08:11.82,0:08:14.82,Default,,0,0,0,,Иә? Жақсы, қарсы стильдегі үстел
Dialogue: 0,0:08:14.82,0:08:16.82,Default,,0,0,0,,Бұл жылдамдықтың өзгеруі.
Dialogue: 0,0:08:16.82,0:08:19.81,Default,,0,0,0,,Жүр, ақымақ.
Dialogue: 0,0:08:19.81,0:08:21.81,Default,,0,0,0,,Қабырғаға қарап отырып тамақтанғыңыз келе ме?
Dialogue: 0,0:08:23.81,0:08:25.81,Default,,0,0,0,,Оны тез қайтарыңыз!
Dialogue: 0,0:08:25.81,0:08:27.82,Default,,0,0,0,,Бұл "хей~" емес
Dialogue: 0,0:08:27.82,0:08:29.82,Default,,0,0,0,,Жарайды, бүгін түн болды.
Dialogue: 0,0:08:29.82,0:08:31.82,Default,,0,0,0,,Бірде-бір рет осындай нәрсені жасау жақсы.
Dialogue: 0,0:08:31.82,0:08:34.82,Default,,0,0,0,,Оңтүстік аралда болудан ләззат алыңыз
Dialogue: 0,0:08:34.82,0:08:38.81,Default,,0,0,0,,Әй, бірінші сервант қайда кетті?
Dialogue: 0,0:08:38.81,0:08:42.81,Default,,0,0,0,,Айтпақшы, мама, қайда бардың?
Dialogue: 0,0:08:44.82,0:08:46.82,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:49.82,0:08:51.82,Default,,0,0,0,,Миканның бөлмесі?
Dialogue: 0,0:08:54.81,0:08:56.81,Default,,0,0,0,,Вахан
Dialogue: 0,0:08:56.81,0:08:58.81,Default,,0,0,0,,Ахх
Dialogue: 0,0:09:01.82,0:09:04.82,Default,,0,0,0,,Сіз не істеп жатырсыз? Тек алыстап кет.
Dialogue: 0,0:09:04.82,0:09:06.82,Default,,0,0,0,,Бұл бала ата-анасына қарап тұр.
Dialogue: 0,0:09:06.82,0:09:09.82,Default,,0,0,0,,Ахахха, жарайды. Бүгін түн болды.
Dialogue: 0,0:09:09.82,0:09:11.81,Default,,0,0,0,,Дұрыс, тез арада тамақ ішуім керек.
Dialogue: 0,0:09:11.81,0:09:13.81,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:09:15.81,0:09:17.82,Default,,0,0,0,,Жалқаулар үшін тамаша диеталық машина.
Dialogue: 0,0:09:17.82,0:09:20.82,Default,,0,0,0,,Іш бұлшықетінің тербелетін белбеуімен таныстыру
Dialogue: 0,0:09:20.82,0:09:22.82,Default,,0,0,0,,Пайдалану өте оңай
Dialogue: 0,0:09:22.82,0:09:24.82,Default,,0,0,0,,Бұл белдікті асқазанға ораңыз
Dialogue: 0,0:09:24.82,0:09:26.82,Default,,0,0,0,,Сәлем Стив, қалыңыз қалай?
Dialogue: 0,0:09:26.82,0:09:29.81,Default,,0,0,0,,Бұл керемет, Дженнифер, мына іш қуысына қараңыз.
Dialogue: 0,0:09:29.81,0:09:31.81,Default,,0,0,0,,Бұл тартымды, оны түртіңіз.
Dialogue: 0,0:09:31.81,0:09:33.81,Default,,0,0,0,,Уау, керемет, менің ішім жыртылып кетті.
Dialogue: 0,0:09:33.81,0:09:35.81,Default,,0,0,0,,Қазірдің өзінде
Dialogue: 0,0:09:38.82,0:09:40.82,Default,,0,0,0,,Қазірдің өзінде! Мен сене алар емеспін
Dialogue: 0,0:09:40.82,0:09:42.82,Default,,0,0,0,,Неліктен менің заттарымды сақтаудасың?
Dialogue: 0,0:09:42.82,0:09:44.82,Default,,0,0,0,,Әлгі қарғыс атқыр қарғыс
Dialogue: 0,0:09:55.82,0:09:57.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:57.82,0:09:59.82,Default,,0,0,0,,Менің қоқыс жәшігімді білмейсің бе?
Dialogue: 0,0:09:59.82,0:10:01.83,Default,,0,0,0,,Ой, не істеп жатырсың?
Dialogue: 0,0:10:01.83,0:10:04.81,Default,,0,0,0,,Ах, Ю-чан, жарықты өшіріп көр.
Dialogue: 0,0:10:04.81,0:10:06.81,Default,,0,0,0,,Иә? неге? Жарайды
Dialogue: 0,0:10:09.82,0:10:12.82,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:10:12.82,0:10:15.82,Default,,0,0,0,,Иә
Dialogue: 0,0:10:15.82,0:10:19.82,Default,,0,0,0,,Сіз қалай ойлайсыз? Жанама жарықтандыру атмосфераны жасайды, солай ма?
Dialogue: 0,0:10:22.81,0:10:25.82,Default,,0,0,0,,Қайтарыңыз аааа
Dialogue: 0,0:10:25.82,0:10:27.82,Default,,0,0,0,,Азиялық демалыс орны
Dialogue: 0,0:10:29.82,0:10:31.82,Default,,0,0,0,,Тат Тат Тат Тат
Dialogue: 0,0:10:31.82,0:10:33.82,Default,,0,0,0,,Талалалала
Dialogue: 0,0:10:33.82,0:10:35.83,Default,,0,0,0,,Тат Тат Тат Тат
Dialogue: 0,0:10:35.83,0:10:37.81,Default,,0,0,0,,Тара ла ла ла ла ла
Dialogue: 0,0:10:37.81,0:10:39.81,Default,,0,0,0,,Тат Тат Тат Тат
Dialogue: 0,0:10:39.81,0:10:43.81,Default,,0,0,0,,Талалалала тат тат тат тат тат
Dialogue: 0,0:10:49.82,0:10:51.82,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:58.82,0:11:00.82,Default,,0,0,0,,Сәл ғана жақсы.
Dialogue: 0,0:11:00.82,0:11:02.82,Default,,0,0,0,,Эй, бар болғаны 1000 иен.
Dialogue: 0,0:11:02.82,0:11:05.82,Default,,0,0,0,,Да! Балаңа ақша бергенің жаман емес пе?
Dialogue: 0,0:11:05.82,0:11:07.83,Default,,0,0,0,,Аванстық несиелер шектен тыс.
Dialogue: 0,0:11:07.83,0:11:09.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:13.81,0:11:15.82,Default,,0,0,0,,500 600
Dialogue: 0,0:11:15.82,0:11:19.82,Default,,0,0,0,,700 800 850 860
Dialogue: 0,0:11:19.82,0:11:23.82,Default,,0,0,0,,861 862 863
Dialogue: 0,0:11:23.82,0:11:25.83,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:11:25.83,0:11:29.81,Default,,0,0,0,,863 иен қанша рет санасаңыз да
Dialogue: 0,0:11:29.81,0:11:32.81,Default,,0,0,0,,Қалталы ақша күніне 4 күн қалды?
Dialogue: 0,0:11:37.82,0:11:39.82,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:11:39.82,0:11:42.83,Default,,0,0,0,,Әйтеуір бүгін бітті
Dialogue: 0,0:11:42.83,0:11:45.83,Default,,0,0,0,,Айналма жолмен емес, тура үйге қайтайық.
Dialogue: 0,0:11:45.83,0:11:47.82,Default,,0,0,0,,Микан Үйге қайтайық
Dialogue: 0,0:11:47.82,0:11:49.82,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:11:58.83,0:12:01.83,Default,,0,0,0,,Ей, мен ғана шынымен ашпын ба?
Dialogue: 0,0:12:01.83,0:12:03.81,Default,,0,0,0,,А, барайық, бірдеңе жейміз.
Dialogue: 0,0:12:03.81,0:12:05.82,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:12:05.82,0:12:07.82,Default,,0,0,0,,Жүр, дәмді нәрсе жейік
Dialogue: 0,0:12:07.82,0:12:09.82,Default,,0,0,0,,Қайда? Бұл ағын нашар
Dialogue: 0,0:12:09.82,0:12:12.82,Default,,0,0,0,,Мектеп жанында не болды? Мен бірдеңе істеуім керек
Dialogue: 0,0:12:12.82,0:12:14.83,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:12:14.83,0:12:17.83,Default,,0,0,0,,А, онда кел, анау дүкенге барып, ет тоқаштары немесе бір нәрсе ал.
Dialogue: 0,0:12:17.83,0:12:19.83,Default,,0,0,0,,Бұл шынымен де отбасылық мейрамхана ма? Бұл дұрыс
Dialogue: 0,0:12:19.83,0:12:22.82,Default,,0,0,0,,Сіз пицца жегіңіз келе ме? Кеттік, кеттік
Dialogue: 0,0:12:22.82,0:12:24.82,Default,,0,0,0,,Өтірік Өтірік Өтірік
Dialogue: 0,0:12:24.82,0:12:26.82,Default,,0,0,0,,Отбасылық мейрамханалар қымбат
Dialogue: 0,0:12:26.82,0:12:28.82,Default,,0,0,0,,Ааа, иә?
Dialogue: 0,0:12:28.82,0:12:31.83,Default,,0,0,0,,Менің бүгін бір нәрсе істеуім керек.
Dialogue: 0,0:12:31.83,0:12:34.83,Default,,0,0,0,,Ей, үйге барасың ба? Жарайды, сәл ғана
Dialogue: 0,0:12:34.83,0:12:37.83,Default,,0,0,0,,Ертең орындалмайтын нәрсені айтасыз ба?
Dialogue: 0,0:12:37.83,0:12:39.82,Default,,0,0,0,,Иә? Яғни...
Dialogue: 0,0:12:39.82,0:12:41.82,Default,,0,0,0,,Тіпті ертең
Dialogue: 0,0:12:41.82,0:12:44.82,Default,,0,0,0,,Олай болса кеттік, кеттік
Dialogue: 0,0:12:44.82,0:12:46.82,Default,,0,0,0,,Мен әлсізмін!
Dialogue: 0,0:12:51.83,0:12:53.83,Default,,0,0,0,,Қалай болғанда да 300 иен диапазонында
Dialogue: 0,0:12:53.83,0:12:55.83,Default,,0,0,0,,Хмм, содан кейін мен
Dialogue: 0,0:12:55.83,0:12:57.82,Default,,0,0,0,,Асшаяндар мен қаймақ қосылған жаңа кремді макарон
Dialogue: 0,0:12:57.82,0:12:59.82,Default,,0,0,0,,Пудинг а ла режимі
Dialogue: 0,0:12:59.82,0:13:01.82,Default,,0,0,0,,Өтірік? Содан кейін мен де қытырлақ бекон аламын.
Dialogue: 0,0:13:01.82,0:13:04.83,Default,,0,0,0,,Картоп райхан дәмі бар пицца және құлпынай парфеті
Dialogue: 0,0:13:04.83,0:13:08.83,Default,,0,0,0,,Егер солай болса, мен де удон салатын және пайдалы ната де коко жеймін.
Dialogue: 0,0:13:11.83,0:13:13.82,Default,,0,0,0,,үшін, сенде неге сонша ақша бар?
Dialogue: 0,0:13:13.82,0:13:17.82,Default,,0,0,0,,Маған кофе керек.
Dialogue: 0,0:13:17.82,0:13:20.82,Default,,0,0,0,,Сіз тамақ ішпейсіз бе? Да... Мен диетадамын.
Dialogue: 0,0:13:20.82,0:13:22.83,Default,,0,0,0,,Қай жерде семіз?
Dialogue: 0,0:13:22.83,0:13:24.83,Default,,0,0,0,,Мына қарынға қара! Қараңызшы, не? қайда
Dialogue: 0,0:13:24.83,0:13:27.83,Default,,0,0,0,,Мен де кофе ішемін.
Dialogue: 0,0:13:27.83,0:13:31.82,Default,,0,0,0,,Ми де диетада ма? Жоқ, менің әмияным қысылып қалды.
Dialogue: 0,0:13:31.82,0:13:34.82,Default,,0,0,0,,Хмм, дұрыс. Мен де солай айтқаныма қуаныштымын.
Dialogue: 0,0:13:36.82,0:13:38.83,Default,,0,0,0,,Асшаяндар мен қырыққабат қосылған жаңа кремді макарон
Dialogue: 0,0:13:38.83,0:13:42.83,Default,,0,0,0,,Puding a la mode құралы
Dialogue: 0,0:13:42.83,0:13:44.83,Default,,0,0,0,,Уау
Dialogue: 0,0:13:44.83,0:13:46.83,Default,,0,0,0,,Қытырлақ бекон және картоп райхан дәмі бар пицца
Dialogue: 0,0:13:46.83,0:13:48.82,Default,,0,0,0,,Удон салатымен құлпынай парфеті
Dialogue: 0,0:13:48.82,0:13:51.82,Default,,0,0,0,,Дені сау Ната де Коко тұтынушылары
Dialogue: 0,0:13:51.82,0:13:53.82,Default,,0,0,0,,Ал оның Регалияларының көбі шын мәнінде Нора болып шықты.
Dialogue: 0,0:13:53.82,0:13:56.83,Default,,0,0,0,,Кофе тұтынушылары
Dialogue: 0,0:13:56.83,0:13:59.83,Default,,0,0,0,,Ахаха
Dialogue: 0,0:13:59.83,0:14:02.83,Default,,0,0,0,,Эй Ми, жартысын жегің келе ме?
Dialogue: 0,0:14:02.83,0:14:04.82,Default,,0,0,0,,Өйткені оның бәрін жеуге болмайды
Dialogue: 0,0:14:04.82,0:14:08.82,Default,,0,0,0,,Уау, алғаныма қуаныштымын.
Dialogue: 0,0:14:08.82,0:14:11.82,Default,,0,0,0,,А, дәмді. Онда «жаңа мәзір» деп жазылған.
Dialogue: 0,0:14:15.83,0:14:17.83,Default,,0,0,0,,«Жаңа мәзір»
Dialogue: 0,0:14:17.83,0:14:19.83,Default,,0,0,0,,«Жаңа мәзір» әлсіз, солай емес пе?
Dialogue: 0,0:14:19.83,0:14:21.84,Default,,0,0,0,,Сондай-ақ, «шектелген» т.б.
Dialogue: 0,0:14:21.84,0:14:24.82,Default,,0,0,0,,Ал, мен саған маусымдық құлпынай парфейін де беремін.
Dialogue: 0,0:14:24.82,0:14:26.82,Default,,0,0,0,,Шынымен бе? рахмет
Dialogue: 0,0:14:26.82,0:14:28.83,Default,,0,0,0,,Удон салатын да жеп көріңіз.
Dialogue: 0,0:14:28.83,0:14:30.83,Default,,0,0,0,,Олай болса, макарон да, сосын мен де.
Dialogue: 0,0:14:30.83,0:14:32.83,Default,,0,0,0,,Ах, бұл пицца, макарон, т.б.
Dialogue: 0,0:14:32.83,0:14:35.83,Default,,0,0,0,,Сіз ең көп салмақ қосасыз.
Dialogue: 0,0:14:35.83,0:14:37.83,Default,,0,0,0,,Бұрын «жемеймін» дегеніңмен.
Dialogue: 0,0:14:37.83,0:14:40.82,Default,,0,0,0,,Сіздің ерік-жігеріңіз әлсіз.
Dialogue: 0,0:14:40.82,0:14:42.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:42.82,0:14:44.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:46.83,0:14:48.83,Default,,0,0,0,,Әй, соны бір тістеп берші.
Dialogue: 0,0:14:48.83,0:14:50.83,Default,,0,0,0,,Жарайды, көп нәрсені ал.
Dialogue: 0,0:14:50.83,0:14:52.83,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:14:57.82,0:15:00.82,Default,,0,0,0,,Адал өмір сүрейік енді
Dialogue: 0,0:15:00.82,0:15:03.82,Default,,0,0,0,,Шыда, Микан, қолыңнан келгенін істе.
Dialogue: 0,0:15:15.82,0:15:19.83,Default,,0,0,0,,Қалта ақшасы 863 минус 263
Dialogue: 0,0:15:19.83,0:15:21.83,Default,,0,0,0,,Бар болғаны 600 иен қалды.
Dialogue: 0,0:15:40.83,0:15:42.83,Default,,0,0,0,,Ачи
Dialogue: 0,0:15:42.83,0:15:44.84,Default,,0,0,0,,О
Dialogue: 0,0:15:44.84,0:15:47.84,Default,,0,0,0,,А, мен салқын шырын ішкім келеді.
Dialogue: 0,0:15:50.82,0:15:53.82,Default,,0,0,0,,Уф, бірақ 600 иен қалды
Dialogue: 0,0:15:55.83,0:15:58.83,Default,,0,0,0,,Ой, жоқ… Мен бәрін бүлдіріп алдым…
Dialogue: 0,0:15:58.83,0:16:01.83,Default,,0,0,0,,Мен бұған әлі шыдай алмаймын
Dialogue: 0,0:16:04.84,0:16:07.82,Default,,0,0,0,,Мен қайсысын таңдауым керек?
Dialogue: 0,0:16:07.82,0:16:09.82,Default,,0,0,0,,Гррр... Гегег
Dialogue: 0,0:16:10.83,0:16:12.83,Default,,0,0,0,,500 иендік монета!
Dialogue: 0,0:16:12.83,0:16:14.83,Default,,0,0,0,,Мен оны мүлдем көрмеймін!
Dialogue: 0,0:16:14.83,0:16:17.83,Default,,0,0,0,,Көзім сәл сыртқа қараса екен.
Dialogue: 0,0:16:17.83,0:16:19.83,Default,,0,0,0,,Гуу...
Dialogue: 0,0:16:23.84,0:16:26.84,Default,,0,0,0,,Гуу
Dialogue: 0,0:16:27.83,0:16:29.83,Default,,0,0,0,,Не? Тачибана Гику!
Dialogue: 0,0:16:29.83,0:16:32.83,Default,,0,0,0,,Йо Йошиока
Dialogue: 0,0:16:32.83,0:16:35.84,Default,,0,0,0,,Йошиоканың бірінші рет пайда болуы
Dialogue: 0,0:16:35.84,0:16:37.84,Default,,0,0,0,,Не? Сіз ақшаны тастадыңыз ба?
Dialogue: 0,0:16:37.84,0:16:41.83,Default,,0,0,0,,Ой, мені сыныпта біреу көріп қалды.
Dialogue: 0,0:16:41.83,0:16:43.83,Default,,0,0,0,,Әй, болды, кеттік, кеттік
Dialogue: 0,0:16:43.83,0:16:45.83,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:16:45.83,0:16:47.83,Default,,0,0,0,,Жарайды, шынымен.
Dialogue: 0,0:16:47.83,0:16:51.84,Default,,0,0,0,,Ақшаңды ысырап қылсаң, жазаланасың.
Dialogue: 0,0:16:51.84,0:16:53.84,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:16:53.84,0:16:55.84,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:16:55.84,0:16:57.84,Default,,0,0,0,,Бұл Йошиока
Dialogue: 0,0:16:57.84,0:17:00.83,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:17:00.83,0:17:02.83,Default,,0,0,0,,Шынында да...
Dialogue: 0,0:17:02.83,0:17:04.83,Default,,0,0,0,,Бұл 10 иен.
Dialogue: 0,0:17:04.83,0:17:09.84,Default,,0,0,0,,10 йен Әйел 10 йен үшін бетін жерге үйкеледі ме?
Dialogue: 0,0:17:09.84,0:17:11.84,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:17:11.84,0:17:14.84,Default,,0,0,0,,Шынында да, жеткілікті.
Dialogue: 0,0:17:14.84,0:17:16.83,Default,,0,0,0,,А, қараңдаршы
Dialogue: 0,0:17:16.83,0:17:18.83,Default,,0,0,0,,Ах, 500 иен.
Dialogue: 0,0:17:18.83,0:17:20.83,Default,,0,0,0,,Уф уау
Dialogue: 0,0:17:20.83,0:17:22.83,Default,,0,0,0,,Ятер, мен кофе алдым.
Dialogue: 0,0:17:22.83,0:17:25.84,Default,,0,0,0,,Керемет Тачибана?
Dialogue: 0,0:17:25.84,0:17:27.84,Default,,0,0,0,,А... Менде де кофе бар.
Dialogue: 0,0:17:32.84,0:17:35.83,Default,,0,0,0,,Ах, 10 иен жақсырақ, солай ма?
Dialogue: 0,0:17:35.83,0:17:37.83,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:17:37.83,0:17:39.83,Default,,0,0,0,,Олай болса, балық аулау бәрінен тұрады.
Dialogue: 0,0:17:39.83,0:17:42.84,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:17:42.84,0:17:45.84,Default,,0,0,0,,Олай болса, оны 10 иенге лақтырмаңыз.
Dialogue: 0,0:17:45.84,0:17:47.84,Default,,0,0,0,,Иә
Dialogue: 0,0:17:58.84,0:18:01.84,Default,,0,0,0,,Сен маған осылай келдің
Dialogue: 0,0:18:01.84,0:18:04.84,Default,,0,0,0,,600-ді азайтып, 500-ді қосыңыз, бұл 130-ның бөлігі.
Dialogue: 0,0:18:04.84,0:18:07.84,Default,,0,0,0,,Бар болғаны 230 иен қалды
Dialogue: 0,0:18:09.83,0:18:13.83,Default,,0,0,0,,А, мен адал өмір сүруге ант бердім.
Dialogue: 0,0:18:13.83,0:18:15.83,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:18:18.84,0:18:20.84,Default,,0,0,0,,Ой, не болды, енді не болды
Dialogue: 0,0:18:20.84,0:18:23.84,Default,,0,0,0,,Осыны есіңе түсірсең, біртүрлі нәрсе болады.
Dialogue: 0,0:18:27.83,0:18:30.83,Default,,0,0,0,,...
Dialogue: 0,0:18:30.83,0:18:32.84,Default,,0,0,0,,...
Dialogue: 0,0:18:32.84,0:18:34.84,Default,,0,0,0,,...
Dialogue: 0,0:18:34.84,0:18:37.84,Default,,0,0,0,,...
Dialogue: 0,0:18:37.84,0:18:39.84,Default,,0,0,0,,...
Dialogue: 0,0:18:39.84,0:18:41.83,Default,,0,0,0,,...
Dialogue: 0,0:18:41.83,0:18:43.83,Default,,0,0,0,,...
Dialogue: 0,0:18:43.83,0:18:45.83,Default,,0,0,0,,...
Dialogue: 0,0:18:45.83,0:18:47.83,Default,,0,0,0,,...
Dialogue: 0,0:18:47.83,0:18:49.84,Default,,0,0,0,,...
Dialogue: 0,0:18:49.84,0:18:51.84,Default,,0,0,0,,...
Dialogue: 0,0:19:40.85,0:19:42.85,Default,,0,0,0,,Сенің анаң қайсысы?
Dialogue: 0,0:19:49.80,0:19:51.80,Default,,0,0,0,,Міне осылай болды.
Dialogue: 0,0:19:53.30,0:19:59.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
