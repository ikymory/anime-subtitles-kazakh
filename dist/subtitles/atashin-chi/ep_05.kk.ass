Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:22.73,0:01:24.68,Default,,0,0,0,,Ах
Dialogue: 0,0:01:24.68,0:01:26.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:32.67,0:01:36.67,Default,,0,0,0,,Ғұн ғұн ғұн ғұн ғұн ғұн ғұн ғұн ғұн ғұн ғұн ғұн ғұн ғұн ғұн хұн ғұн
Dialogue: 0,0:03:10.67,0:03:14.67,Default,,0,0,0,,Бұл тоқтамайды.
Dialogue: 0,0:03:14.67,0:03:16.67,Default,,0,0,0,,Бүгін кешкі асқа бірдеңе жеуге бола ма?
Dialogue: 0,0:03:16.67,0:03:18.67,Default,,0,0,0,,А, жеткізу?
Dialogue: 0,0:03:18.67,0:03:20.68,Default,,0,0,0,,Сәлем әке
Dialogue: 0,0:03:20.68,0:03:22.68,Default,,0,0,0,,Барлығымен шақыру Түсті ойын бұрышы
Dialogue: 0,0:03:22.68,0:03:24.68,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:03:24.68,0:03:26.68,Default,,0,0,0,,Жарайсың ба? Жарайды
Dialogue: 0,0:03:26.68,0:03:28.68,Default,,0,0,0,,Жақсы жеткізу
Dialogue: 0,0:03:31.67,0:03:33.67,Default,,0,0,0,,Сіз нені қалайсыз?
Dialogue: 0,0:03:33.67,0:03:36.68,Default,,0,0,0,,Маған жыланбалық ұнайды.
Dialogue: 0,0:03:36.68,0:03:38.68,Default,,0,0,0,,Онда емес пе? жыланбалық мейрамханасы
Dialogue: 0,0:03:38.68,0:03:40.68,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:03:40.68,0:03:42.68,Default,,0,0,0,,Бұл асханадағы мәзір.
Dialogue: 0,0:03:42.68,0:03:44.68,Default,,0,0,0,,Жыланбалық тізімделген
Dialogue: 0,0:03:44.68,0:03:49.67,Default,,0,0,0,,Карри күріш Якимеши Удон Грильде пісірілген Зімбір
Dialogue: 0,0:03:49.67,0:03:52.68,Default,,0,0,0,,А, жыланбалық...
Dialogue: 0,0:03:52.68,0:03:55.68,Default,,0,0,0,,Менің шоғырланбағаным туралы бірдеңе.
Dialogue: 0,0:03:57.68,0:03:59.68,Default,,0,0,0,,О, бүгін маған бірдеңе болды.
Dialogue: 0,0:03:59.68,0:04:01.67,Default,,0,0,0,,Мен бай нәрсе жегім келеді.
Dialogue: 0,0:04:01.67,0:04:04.67,Default,,0,0,0,,А, бұл батыс мейрамханасы ма?
Dialogue: 0,0:04:04.67,0:04:07.67,Default,,0,0,0,,Ол кеше ғана вокзалдың артында ашылды.
Dialogue: 0,0:04:07.67,0:04:11.68,Default,,0,0,0,,А, омлет күріш дәмді көрінеді.
Dialogue: 0,0:04:11.68,0:04:14.68,Default,,0,0,0,,Мама, мен мұны істеуім керек пе? Омлет күріш
Dialogue: 0,0:04:14.68,0:04:17.68,Default,,0,0,0,,Сізге омлет күрішін жеткізу үшін не істейсіз?
Dialogue: 0,0:04:17.68,0:04:20.67,Default,,0,0,0,,Үйде омлет күріш сияқты қалағаныңызша жасауға болады.
Dialogue: 0,0:04:20.67,0:04:22.67,Default,,0,0,0,,Жоқ... бұл мүмкін емес.
Dialogue: 0,0:04:22.67,0:04:25.67,Default,,0,0,0,,Біздің үйде демиглейс соусы бар.
Dialogue: 0,0:04:25.67,0:04:28.68,Default,,0,0,0,,Анам сушиге құмар.
Dialogue: 0,0:04:28.68,0:04:30.68,Default,,0,0,0,,Әй, сенің де әкең, солай ма?
Dialogue: 0,0:04:30.68,0:04:32.68,Default,,0,0,0,,Иә
Dialogue: 0,0:04:32.68,0:04:34.68,Default,,0,0,0,,Қараңызшы, мен мұны білдім, иә?
Dialogue: 0,0:04:34.68,0:04:38.67,Default,,0,0,0,,Осуши Осуши
Dialogue: 0,0:04:38.67,0:04:41.67,Default,,0,0,0,,Байрақ болғанын қалаймын.
Dialogue: 0,0:04:41.67,0:04:43.68,Default,,0,0,0,,А, бірақ
Dialogue: 0,0:04:43.68,0:04:47.68,Default,,0,0,0,,Егер сіз конгер жыланбалығын сушимен жесеңіз, ол сіздің жыланбалыққа деген құштарлығыңызды қанағаттандыра ма?
Dialogue: 0,0:04:47.68,0:04:50.68,Default,,0,0,0,,Хм, суши де бар ма?
Dialogue: 0,0:04:50.68,0:04:52.68,Default,,0,0,0,,Онда суши, келісемін!
Dialogue: 0,0:04:55.67,0:04:57.67,Default,,0,0,0,,Ах
Dialogue: 0,0:04:57.67,0:04:59.68,Default,,0,0,0,,Мама, бұл дәмді көрінеді.
Dialogue: 0,0:04:59.68,0:05:01.68,Default,,0,0,0,,О, жоқ, жоқ, жоқ
Dialogue: 0,0:05:01.68,0:05:04.68,Default,,0,0,0,,Сіз тек осылай суретке түсіруге ақша жұмсайсыз.
Dialogue: 0,0:05:04.68,0:05:06.68,Default,,0,0,0,,Ақыр соңында, бұл солай.
Dialogue: 0,0:05:06.68,0:05:08.68,Default,,0,0,0,,Тұйық ретінде
Dialogue: 0,0:05:08.68,0:05:10.67,Default,,0,0,0,,Олар сізге дұрыс суши беріп жатқан сияқты.
Dialogue: 0,0:05:10.67,0:05:12.67,Default,,0,0,0,,Иә? Әдеттегі жер емес
Dialogue: 0,0:05:12.67,0:05:15.67,Default,,0,0,0,,Бүгін жаңа нәрсені зерттейік.
Dialogue: 0,0:05:15.67,0:05:17.68,Default,,0,0,0,,Дұрыс, төрт кесек бамбук.
Dialogue: 0,0:05:17.68,0:05:20.68,Default,,0,0,0,,Иә, өтінемін, Уф... Уф...
Dialogue: 0,0:05:20.68,0:05:22.68,Default,,0,0,0,,Неліктен бамбук?
Dialogue: 0,0:05:22.68,0:05:25.68,Default,,0,0,0,,Онда жыланбалық жоқ.Бүгін бамбук пен қарағайды қолданайық.
Dialogue: 0,0:05:25.68,0:05:27.69,Default,,0,0,0,,Бамбук жеткілікті, солай ма? әке
Dialogue: 0,0:05:27.69,0:05:30.67,Default,,0,0,0,,Нені дұрыс түсінбей жатқаныңызды білмеймін...
Dialogue: 0,0:05:30.67,0:05:32.67,Default,,0,0,0,,Не? Қарағай?
Dialogue: 0,0:05:32.67,0:05:34.68,Default,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,0:05:34.68,0:05:38.68,Default,,0,0,0,,А, мен саған ертерек телефон соққан Тачибанамын. Иә, бамбук. Мацу. Мацу Мацу.
Dialogue: 0,0:05:38.68,0:05:41.68,Default,,0,0,0,,Ах, қарным ашты. Мен бірдеңе жеуім керек пе?
Dialogue: 0,0:05:41.68,0:05:43.69,Default,,0,0,0,,Ештеңе емес.
Dialogue: 0,0:05:43.69,0:05:45.67,Default,,0,0,0,,Мен қазір жеткізуге тапсырыс беріп жатырмын.
Dialogue: 0,0:05:45.67,0:05:47.67,Default,,0,0,0,,Не? Суши
Dialogue: 0,0:05:47.67,0:05:49.68,Default,,0,0,0,,Суши?
Dialogue: 0,0:05:49.68,0:05:51.68,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:05:51.68,0:05:53.68,Default,,0,0,0,,Пицца жақсы болды.
Dialogue: 0,0:05:53.68,0:05:55.68,Default,,0,0,0,,Суши қайда?
Dialogue: 0,0:05:55.68,0:05:57.68,Default,,0,0,0,,Орезуши кәдімгі орын
Dialogue: 0,0:05:57.68,0:05:59.69,Default,,0,0,0,,А... Меніңше, сіз кешігіп қалдыңыз.
Dialogue: 0,0:05:59.69,0:06:01.69,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:06:01.69,0:06:03.67,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:06:03.67,0:06:06.67,Default,,0,0,0,,Енді сорпа пісірейік.
Dialogue: 0,0:06:18.69,0:06:21.67,Default,,0,0,0,,Мені ұйықтатпа
Dialogue: 0,0:06:21.67,0:06:24.68,Default,,0,0,0,,Маған фортепианоны сатуыңызды өтінемін.
Dialogue: 0,0:06:24.68,0:06:28.68,Default,,0,0,0,,Тазалау кезінде қозғалмайтын пианино үлкен қиындық тудырады.
Dialogue: 0,0:06:28.68,0:06:30.68,Default,,0,0,0,,Оны ешкім ойнамайды
Dialogue: 0,0:06:30.68,0:06:33.69,Default,,0,0,0,,Сонда бұл көлемді қоқыс па? Жоқ, маған қоңырау шалыңыз.
Dialogue: 0,0:06:33.69,0:06:38.67,Default,,0,0,0,,Sute Sete Piano 0220
Dialogue: 0,0:06:38.67,0:06:40.67,Default,,0,0,0,,Тастап кеткен фортепиано қауымдастығы
Dialogue: 0,0:06:42.68,0:06:46.68,Default,,0,0,0,,Сіз уайымдап, ешкімге айта алмайсыз ба?
Dialogue: 0,0:06:46.68,0:06:48.68,Default,,0,0,0,,Кеш емес пе? Бұл жерде!
Dialogue: 0,0:06:48.68,0:06:50.69,Default,,0,0,0,,Бұл мотоцикл жеткізу қызметі.
Dialogue: 0,0:06:50.69,0:06:53.69,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:06:53.69,0:06:55.69,Default,,0,0,0,,Бұл мотоцикл жеткізу болды.
Dialogue: 0,0:06:59.68,0:07:01.68,Default,,0,0,0,,Әлі кеш емес пе?
Dialogue: 0,0:07:01.68,0:07:03.68,Default,,0,0,0,,Ендеше пицца жасайық
Dialogue: 0,0:07:03.68,0:07:05.68,Default,,0,0,0,,Эй, маған қоңырау шалыңыз.
Dialogue: 0,0:07:05.68,0:07:08.69,Default,,0,0,0,,А, сен маған телефон соғасың ба? Жақында емес пе?
Dialogue: 0,0:07:08.69,0:07:10.69,Default,,0,0,0,,Бұл ұмытылған жоқ па?
Dialogue: 0,0:07:10.69,0:07:12.67,Default,,0,0,0,,Мен мұны ұмытып қалдым.
Dialogue: 0,0:07:12.67,0:07:17.68,Default,,0,0,0,,Жаңбыр жауып тұрғандықтан, жеткізу тапсырыстары асығыс екеніне сенімдімін.
Dialogue: 0,0:07:17.68,0:07:20.68,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:20.68,0:07:24.69,Default,,0,0,0,,Жарайды, ол жақта әрқашан кеш болады. Күтсең, келеді.
Dialogue: 0,0:07:24.69,0:07:26.69,Default,,0,0,0,,Хмм…
Dialogue: 0,0:07:35.68,0:07:39.69,Default,,0,0,0,,Хмм... Ммм...
Dialogue: 0,0:07:39.69,0:07:45.69,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:07:45.69,0:07:48.68,Default,,0,0,0,,Мен аштық сезінемін. Мен бірдеңе жей аламын ба?
Dialogue: 0,0:07:48.68,0:07:50.68,Default,,0,0,0,,Жоқ! Жақында суши келгенде не істейсіз?
Dialogue: 0,0:07:50.68,0:07:52.68,Default,,0,0,0,,Бұл суши келмейді.
Dialogue: 0,0:07:52.68,0:07:54.68,Default,,0,0,0,,Сондықтан мен пицца алғым келеді дедім.
Dialogue: 0,0:07:54.68,0:07:56.69,Default,,0,0,0,,Жоқ, пицца тамақ емес!
Dialogue: 0,0:07:56.69,0:07:58.69,Default,,0,0,0,,Бірақ бұл жылдам, солай емес пе?
Dialogue: 0,0:07:58.69,0:08:00.69,Default,,0,0,0,,Мама, маған тез қоңырау шалыңыз.
Dialogue: 0,0:08:00.69,0:08:02.69,Default,,0,0,0,,Оған көмектесу мүмкін емес. Неліктен мен біраз күтуім керек?
Dialogue: 0,0:08:02.69,0:08:04.68,Default,,0,0,0,,Менің ойымша, сендер мұны істей алмайсыңдар.
Dialogue: 0,0:08:04.68,0:08:06.68,Default,,0,0,0,,Ол жаққа қарасаңыз, телефон қоңырауы еске түсіретін сияқты.
Dialogue: 0,0:08:06.68,0:08:08.68,Default,,0,0,0,,Бұл жерде еш қиындық жоқ.
Dialogue: 0,0:08:08.68,0:08:11.68,Default,,0,0,0,,Сіз ауырып тұрсыз, солай емес пе?
Dialogue: 0,0:08:11.68,0:08:14.69,Default,,0,0,0,,Аш аңдар
Dialogue: 0,0:08:14.69,0:08:16.69,Default,,0,0,0,,О, мен Суши-санмын?
Dialogue: 0,0:08:16.69,0:08:21.68,Default,,0,0,0,,Сәлеметсіз бе, мен Тачибана, мен ертерек жеткізуді сұрадым.
Dialogue: 0,0:08:21.68,0:08:24.68,Default,,0,0,0,,Не? Иә, қарағай. 4 порция.
Dialogue: 0,0:08:24.68,0:08:27.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:27.68,0:08:30.68,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:08:33.69,0:08:35.69,Default,,0,0,0,,Білесіз бе, аздап.
Dialogue: 0,0:08:35.69,0:08:38.68,Default,,0,0,0,,Егер солай болса, неге біз сізге дұрыс хабарласпаймыз?
Dialogue: 0,0:08:38.68,0:08:40.68,Default,,0,0,0,,Әдетте, гейктер әрқашан осылай болады.
Dialogue: 0,0:08:40.68,0:08:42.68,Default,,0,0,0,,Бұл сізге ыңғайлы болу үшін!
Dialogue: 0,0:08:42.68,0:08:44.68,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:08:44.68,0:08:46.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:51.69,0:08:53.69,Default,,0,0,0,,Суши ше?
Dialogue: 0,0:08:56.68,0:08:58.68,Default,,0,0,0,,Ұрысқанда не істеу керек, ақымақ
Dialogue: 0,0:08:58.68,0:09:00.68,Default,,0,0,0,,Мен өзімді қазір өте нашар сезіндім.
Dialogue: 0,0:09:00.68,0:09:02.68,Default,,0,0,0,,Біз не істеуіміз керек? күріш
Dialogue: 0,0:09:02.68,0:09:05.68,Default,,0,0,0,,Мен білмеймін! Қазірдің өзінде ана!
Dialogue: 0,0:09:11.69,0:09:15.68,Default,,0,0,0,,Ммммммммммммммм
Dialogue: 0,0:09:15.68,0:09:19.68,Default,,0,0,0,,Хехехехехехехе
Dialogue: 0,0:09:24.69,0:09:28.69,Default,,0,0,0,,Құмарлық...
Dialogue: 0,0:09:28.69,0:09:31.68,Default,,0,0,0,,11:40
Dialogue: 0,0:09:31.68,0:09:36.69,Default,,0,0,0,,Бүгін оның мерзімі бітетін күн.
Dialogue: 0,0:09:36.69,0:09:38.69,Default,,0,0,0,,Мен бірдеңе істеуім керек
Dialogue: 0,0:09:52.68,0:09:55.68,Default,,0,0,0,,Әлі 12:10
Dialogue: 0,0:10:00.69,0:10:02.69,Default,,0,0,0,,Банктер сағат 3-ке дейін жұмыс істейді, сондықтан жақсы.
Dialogue: 0,0:10:02.69,0:10:07.69,Default,,0,0,0,,Құмарлықтың қызыл раушан гүлі
Dialogue: 0,0:10:10.69,0:10:12.69,Default,,0,0,0,,Сақ болуға шақырылады.
Dialogue: 0,0:10:12.69,0:10:14.69,Default,,0,0,0,,Соңғы жылы юрисдикцияда ұрлау болды.
Dialogue: 0,0:10:14.69,0:10:16.69,Default,,0,0,0,,Үлкен 643 іс...
Dialogue: 0,0:10:16.69,0:10:19.70,Default,,0,0,0,,Банк кітапшаңызды және мөріңізді әкеліңіз
Dialogue: 0,0:10:19.70,0:10:21.68,Default,,0,0,0,,Қалалық және полиция бөлімдері көшелерде сақ болуға шақырады, т.б.
Dialogue: 0,0:10:21.68,0:10:23.68,Default,,0,0,0,,Біз іс-шаралар жүргіземіз.
Dialogue: 0,0:10:23.68,0:10:25.68,Default,,0,0,0,,Мен ешқандай нәтиже көрмегендіктен қиналып жатырмын.
Dialogue: 0,0:10:25.68,0:10:27.69,Default,,0,0,0,,1:00 5 минут бұрын
Dialogue: 0,0:10:27.69,0:10:29.69,Default,,0,0,0,,Қазірдің өзінде 90 іс болды.
Dialogue: 0,0:10:47.69,0:10:51.69,Default,,0,0,0,,Жеңіл жеңіс
Dialogue: 0,0:10:51.69,0:10:54.70,Default,,0,0,0,,Кеттік
Dialogue: 0,0:10:54.70,0:10:57.68,Default,,0,0,0,,Міне, бұл мотоциклде, біз бір-бірімізден өтіп бара жатырмыз.
Dialogue: 0,0:10:57.68,0:11:01.69,Default,,0,0,0,,Мен велосипед себетінен сөмкені жұлып алғанда,
Dialogue: 0,0:11:01.69,0:11:04.69,Default,,0,0,0,,Зерттеулер бойынша бұл әдіс.
Dialogue: 0,0:11:04.69,0:11:07.69,Default,,0,0,0,,Осы уақытқа дейін барлық мақсат саудаға бара жатқан адамдар болды.
Dialogue: 0,0:11:07.69,0:11:09.69,Default,,0,0,0,,Үй шаруасындағы әйелдер деп айтылады.
Dialogue: 0,0:11:09.69,0:11:12.70,Default,,0,0,0,,Жақсы, бірақ бұл сөмкедегі иық белдіктері.
Dialogue: 0,0:11:12.70,0:11:14.68,Default,,0,0,0,,Мынаны осындай халатқа іліп қойыңыз
Dialogue: 0,0:11:14.68,0:11:17.69,Default,,0,0,0,,Жұлып алуды қиындатудың бір жолы бар ма?
Dialogue: 0,0:11:17.69,0:11:20.69,Default,,0,0,0,,Көшеге шықсаң, үй шаруасындағы әйелдер, эй Баку-сан
Dialogue: 0,0:11:20.69,0:11:23.69,Default,,0,0,0,,Не? Жоқ, мен Бакумін.
Dialogue: 0,0:11:23.69,0:11:25.69,Default,,0,0,0,,Бакуге абай болудың қажеті жоқ.
Dialogue: 0,0:11:25.69,0:11:27.70,Default,,0,0,0,,Сөмкеңізге абай болыңыз.
Dialogue: 0,0:11:27.70,0:11:29.70,Default,,0,0,0,,Эй, мен де сақ болайын.
Dialogue: 0,0:11:29.70,0:11:31.68,Default,,0,0,0,,А, мен кетуім керек.
Dialogue: 0,0:11:31.68,0:11:33.69,Default,,0,0,0,,Енді келесі бұрыш «Жапонияға қазір қауіп төніп тұр».
Dialogue: 0,0:11:33.69,0:11:37.69,Default,,0,0,0,,Жапонияға қауіп төніп тұр ма?
Dialogue: 0,0:11:37.69,0:11:41.69,Default,,0,0,0,,Қандай қауіп бар? не?
Dialogue: 0,0:11:41.69,0:11:44.70,Default,,0,0,0,,Мен мұны пайдаланбаймын.
Dialogue: 0,0:11:44.70,0:11:48.70,Default,,0,0,0,,Оны жұлып кетпес үшін диагональ бойынша іліңіз.
Dialogue: 0,0:11:53.69,0:11:56.69,Default,,0,0,0,,Не? Қандай қауіп бар?
Dialogue: 0,0:11:56.69,0:11:58.69,Default,,0,0,0,,Вегетариандық деген нәрсе бар емес пе?
Dialogue: 0,0:11:58.69,0:12:00.70,Default,,0,0,0,,Дүниеде көп нәрсе болып жатыр, Баку мырза.
Dialogue: 0,0:12:00.70,0:12:02.70,Default,,0,0,0,,Бұл рас, солай емес пе?
Dialogue: 0,0:12:02.70,0:12:04.70,Default,,0,0,0,,Иә, тағы кездескенше, қош бол.
Dialogue: 0,0:12:04.70,0:12:06.70,Default,,0,0,0,,Бітті...
Dialogue: 0,0:12:09.69,0:12:13.69,Default,,0,0,0,,Қандай қауіп болды?
Dialogue: 0,0:12:13.69,0:12:15.69,Default,,0,0,0,,Жапон дағдарысынан банктер
Dialogue: 0,0:12:15.69,0:12:17.69,Default,,0,0,0,,Асығыңыз, асығыңыз
Dialogue: 0,0:12:40.69,0:12:42.69,Default,,0,0,0,,Ei
Dialogue: 0,0:12:42.69,0:12:44.69,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:12:44.69,0:12:46.69,Default,,0,0,0,,№ 524?
Dialogue: 0,0:12:46.69,0:12:50.70,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:12:50.70,0:12:52.70,Default,,0,0,0,,№ 509?
Dialogue: 0,0:12:52.70,0:12:54.70,Default,,0,0,0,,15 адам?
Dialogue: 0,0:12:54.70,0:12:57.69,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:12:57.69,0:12:59.69,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:13:06.70,0:13:08.70,Default,,0,0,0,,Бүгін кейінірек.
Dialogue: 0,0:13:08.70,0:13:12.70,Default,,0,0,0,,Мен оны Итами мырзаға апарып, бүктелген тәттілер сатып аламын.
Dialogue: 0,0:13:12.70,0:13:16.70,Default,,0,0,0,,Әкеңнің костюмін кірден шығар.
Dialogue: 0,0:13:22.69,0:13:24.70,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:13:24.70,0:13:26.70,Default,,0,0,0,,Бұл тапсырма.
Dialogue: 0,0:13:26.70,0:13:28.70,Default,,0,0,0,,Мен шай торттарының ассортиментін алғым келеді, өтінемін.
Dialogue: 0,0:13:28.70,0:13:30.70,Default,,0,0,0,,Кашикомаримасу Мұнда басыңыз
Dialogue: 0,0:13:30.70,0:13:32.70,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:38.69,0:13:41.70,Default,,0,0,0,,Мен мұны алуға келдім.
Dialogue: 0,0:13:41.70,0:13:43.70,Default,,0,0,0,,Иә, дәл солай.
Dialogue: 0,0:13:43.70,0:13:45.70,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:48.69,0:13:50.69,Default,,0,0,0,,Керемет
Dialogue: 0,0:13:53.69,0:13:55.69,Default,,0,0,0,,Сіз күткен кезде орындалады.
Dialogue: 0,0:14:00.70,0:14:02.70,Default,,0,0,0,,Ах
Dialogue: 0,0:14:08.69,0:14:10.69,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:10.69,0:14:14.70,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:14:14.70,0:14:17.70,Default,,0,0,0,,Сіз не итермелеп жатырсыз?
Dialogue: 0,0:14:17.70,0:14:19.70,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:14:19.70,0:14:22.70,Default,,0,0,0,,Бұл жай ғана тапсырма.
Dialogue: 0,0:14:22.70,0:14:24.69,Default,,0,0,0,,Бұл…
Dialogue: 0,0:14:24.69,0:14:26.69,Default,,0,0,0,,Шай торттарының ассортименті
Dialogue: 0,0:14:26.69,0:14:29.69,Default,,0,0,0,,Маған 12 дана қорап алғым келеді, өтінемін.
Dialogue: 0,0:14:29.69,0:14:31.69,Default,,0,0,0,,Иә
Dialogue: 0,0:14:34.70,0:14:40.69,Default,,0,0,0,,Хаа ха... хаа ха...
Dialogue: 0,0:14:40.69,0:14:44.69,Default,,0,0,0,,Ой...
Dialogue: 0,0:14:52.70,0:14:54.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:57.69,0:15:00.69,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:00.69,0:15:02.69,Default,,0,0,0,,Шай тортын қалайсыз ба?
Dialogue: 0,0:15:02.69,0:15:04.70,Default,,0,0,0,,Иә
Dialogue: 0,0:15:04.70,0:15:07.70,Default,,0,0,0,,Хмм…
Dialogue: 0,0:15:09.70,0:15:14.69,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:15:14.69,0:15:16.69,Default,,0,0,0,,Га
Dialogue: 0,0:15:16.69,0:15:21.70,Default,,0,0,0,,Хмм... Ммм...
Dialogue: 0,0:15:21.70,0:15:25.70,Default,,0,0,0,,Э-э-э—
Dialogue: 0,0:15:25.70,0:15:29.70,Default,,0,0,0,,Мм, 12 дана жақсы болды ма?
Dialogue: 0,0:15:29.70,0:15:33.69,Default,,0,0,0,,Иә, бұл жақсы болды.
Dialogue: 0,0:15:33.69,0:15:36.70,Default,,0,0,0,,Бұл жақсы деп нені айтасыз?
Dialogue: 0,0:15:36.70,0:15:38.70,Default,,0,0,0,,Неліктен өткен шақ?
Dialogue: 0,0:15:38.70,0:15:40.70,Default,,0,0,0,,４
Dialogue: 0,0:15:40.70,0:15:44.70,Default,,0,0,0,,５ ６
Dialogue: 0,0:15:44.70,0:15:48.71,Default,,0,0,0,,７ ８
Dialogue: 0,0:15:48.71,0:15:51.69,Default,,0,0,0,,９ 10
Dialogue: 0,0:15:51.69,0:15:53.69,Default,,0,0,0,,11 12
Dialogue: 0,0:15:56.70,0:15:59.70,Default,,0,0,0,,Ал, орауыш қағаздың түсі қандай...
Dialogue: 0,0:15:59.70,0:16:01.70,Default,,0,0,0,,Бұл! Өйткені ол ашық көк!
Dialogue: 0,0:16:01.70,0:16:03.71,Default,,0,0,0,,Лента ше?
Dialogue: 0,0:16:03.71,0:16:05.71,Default,,0,0,0,,Бұл көк, өтінемін!
Dialogue: 0,0:16:05.71,0:16:08.69,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:16:08.69,0:16:12.70,Default,,0,0,0,,Мына лентаны қалайсыз ба?
Dialogue: 0,0:16:12.70,0:16:15.70,Default,,0,0,0,,А, жеткілікті. Қаптаманы өзім жасаймын.
Dialogue: 0,0:16:17.70,0:16:20.71,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:16:20.71,0:16:24.71,Default,,0,0,0,,А, келесіде тазалау. Асығыңыз, асығыңыз.
Dialogue: 0,0:16:34.70,0:16:36.70,Default,,0,0,0,,Ах
Dialogue: 0,0:16:36.70,0:16:39.71,Default,,0,0,0,,О! Нгг…
Dialogue: 0,0:16:39.71,0:16:41.71,Default,,0,0,0,,​​О?
Dialogue: 0,0:16:44.70,0:16:46.70,Default,,0,0,0,,Қауіпсіз
Dialogue: 0,0:16:48.70,0:16:52.70,Default,,0,0,0,,А... Иә? Күрсін...
Dialogue: 0,0:16:52.70,0:16:55.71,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:16:55.71,0:16:58.69,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:16:58.69,0:17:00.70,Default,,0,0,0,,Оны басқа жерде көрді, сондықтан ол сонда кетті.
Dialogue: 0,0:17:00.70,0:17:03.70,Default,,0,0,0,,Субару-кун?
Dialogue: 0,0:17:03.70,0:17:05.70,Default,,0,0,0,,Иә, иә, иә
Dialogue: 0,0:17:05.70,0:17:07.70,Default,,0,0,0,,Мұны алу үшін.
Dialogue: 0,0:17:07.70,0:17:10.71,Default,,0,0,0,,Иә, сәл күте тұрыңыз.
Dialogue: 0,0:17:10.71,0:17:12.71,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:17:12.71,0:17:15.69,Default,,0,0,0,,Мен мұны алуға келдім.
Dialogue: 0,0:17:15.69,0:17:19.70,Default,,0,0,0,,Иә, иә, Тачибана мырза.
Dialogue: 0,0:17:19.70,0:17:21.70,Default,,0,0,0,,Тачибана мырза Тачибана мырза
Dialogue: 0,0:17:21.70,0:17:24.70,Default,,0,0,0,,Тачибана мырза Тачибана мырза
Dialogue: 0,0:17:24.70,0:17:29.71,Default,,0,0,0,,Тачибана костюмі және
Dialogue: 0,0:17:29.71,0:17:32.71,Default,,0,0,0,,Маған қызық, Тачибана мырза қайда?
Dialogue: 0,0:17:32.71,0:17:36.70,Default,,0,0,0,,Ал, Тачибана мырза.
Dialogue: 0,0:17:36.70,0:17:40.70,Default,,0,0,0,,Осы жерде болды ма?
Dialogue: 0,0:17:40.70,0:17:42.70,Default,,0,0,0,,Жоқ! дұрысырақ
Dialogue: 0,0:17:42.70,0:17:44.71,Default,,0,0,0,,Иә, сол жерде тексерілген киімнің жанында.
Dialogue: 0,0:17:44.71,0:17:46.71,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:17:46.71,0:17:48.71,Default,,0,0,0,,Сөмке жақсы. Рақмет сізге.
Dialogue: 0,0:17:48.71,0:17:51.71,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:18:02.71,0:18:04.71,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:18:07.70,0:18:09.70,Default,,0,0,0,,Қалғаны банкте.
Dialogue: 0,0:18:13.70,0:18:16.70,Default,,0,0,0,,Жарамдылық мерзімі
Dialogue: 0,0:18:23.71,0:18:27.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:27.70,0:18:31.70,Default,,0,0,0,,Бүгін де мен толық мерзімімді елемейтін ана болдым.
Dialogue: 0,0:18:31.70,0:18:34.70,Default,,0,0,0,,Кя!
Dialogue: 0,0:18:41.71,0:18:46.70,Default,,0,0,0,,...
Dialogue: 0,0:18:46.70,0:18:49.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:49.70,0:18:51.71,Default,,0,0,0,,Бұл менікі. Мен оны бірінші ұстадым.
Dialogue: 0,0:18:51.71,0:18:53.71,Default,,0,0,0,,Сіз аздап сыпайы емессіз бе?
Dialogue: 0,0:19:43.71,0:19:47.65,Default,,0,0,0,,Әй, бұл оңай, ғалам
Dialogue: 0,0:19:47.65,0:19:50.65,Default,,0,0,0,,А? О? аа!
Dialogue: 0,0:19:52.15,0:19:58.15,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
