Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.22,0:00:42.66,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:00:42.66,0:00:48.13,Default,,0,0,0,,ол маған шексіз артықшылық беретін қаруға айналады.
Dialogue: 0,0:00:48.13,0:00:50.53,Default,,0,0,0,,ол маған шексіз артықшылық беретін қаруға айналады.
Dialogue: 0,0:00:50.53,0:00:53.73,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:01:42.68,0:01:44.75,Default,,0,0,0,,Ал, бәріңе.
Dialogue: 0,0:01:44.75,0:01:47.99,Default,,0,0,0,,Керемет
Dialogue: 0,0:01:47.99,0:01:49.99,Default,,0,0,0,,Ммм.
Dialogue: 0,0:02:00.40,0:02:02.67,Default,,0,0,0,,О.
Dialogue: 0,0:02:02.67,0:02:04.77,Default,,0,0,0,,Шынында да, сен бөлексің…
Dialogue: 0,0:02:11.11,0:02:13.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:15.42,0:02:21.22,Default,,0,0,0,,Тапсырыс беруші
Dialogue: 0,0:02:21.22,0:02:23.66,Default,,0,0,0,,Бірақ бұл дүкенде құбыжық маскалары сатылады.
Dialogue: 0,0:02:23.66,0:02:25.96,Default,,0,0,0,,Оны кию ережесі.
Dialogue: 0,0:02:25.96,0:02:29.40,Default,,0,0,0,,Бұл туралы не деуге болады? Саған жарасады деп ойлаймын.
Dialogue: 0,0:02:29.40,0:02:31.33,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:02:31.33,0:02:33.64,Default,,0,0,0,,Біз құбыжықтарға айналдық.
Dialogue: 0,0:02:33.64,0:02:36.27,Default,,0,0,0,,О
Dialogue: 0,0:02:36.27,0:02:38.27,Default,,0,0,0,,Өлшем және Гоемон
Dialogue: 0,0:02:38.27,0:02:42.68,Default,,0,0,0,,Сіз секундтың оннан бір бөлігін құрайтын құбыжықсыз, иә?
Dialogue: 0,0:02:42.68,0:02:44.88,Default,,0,0,0,,Люпин қайда?
Dialogue: 0,0:02:48.18,0:02:53.59,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:02:53.59,0:02:55.69,Default,,0,0,0,,Мен
Dialogue: 0,0:03:14.84,0:03:16.81,Default,,0,0,0,,Бухаа
Dialogue: 0,0:03:16.81,0:03:22.95,Default,,0,0,0,,О, ау
Dialogue: 0,0:03:22.95,0:03:26.25,Default,,0,0,0,,Иә! Розетта әжей емес пе?
Dialogue: 0,0:03:26.25,0:03:28.19,Default,,0,0,0,,Есімде, есімде
Dialogue: 0,0:03:28.19,0:03:30.16,Default,,0,0,0,,Әлі де қыңыр тірі
Dialogue: 0,0:03:30.16,0:03:32.36,Default,,0,0,0,,Мен жерлеу үйін ұйымдастырумен айналысамын.
Dialogue: 0,0:03:32.36,0:03:35.26,Default,,0,0,0,,Ішіңіз!
Dialogue: 0,0:03:35.26,0:03:39.86,Default,,0,0,0,,Жақсы, қуаныштымын, рахмет.
Dialogue: 0,0:04:02.79,0:04:06.03,Default,,0,0,0,,Ихихи, бұл дәмді.
Dialogue: 0,0:04:06.03,0:04:08.33,Default,,0,0,0,,Хотакатата
Dialogue: 0,0:04:08.33,0:04:10.60,Default,,0,0,0,,Зенигата Интерполдың жігіті.
Dialogue: 0,0:04:10.60,0:04:14.04,Default,,0,0,0,,Неге мені қуып жүрсің? Хахахаха!
Dialogue: 0,0:04:14.04,0:04:16.87,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:04:16.87,0:04:19.24,Default,,0,0,0,,E. coli ықырық тудырады
Dialogue: 0,0:04:19.24,0:04:21.58,Default,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,0:04:21.58,0:04:23.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:23.95,0:04:26.48,Default,,0,0,0,,Токиодан келген Таккубин
Dialogue: 0,0:04:26.48,0:04:29.05,Default,,0,0,0,,О
Dialogue: 0,0:04:29.05,0:04:33.95,Default,,0,0,0,,le
Dialogue: 0,0:04:36.59,0:04:40.39,Default,,0,0,0,,Мүмкін бұл Фудзико-чанның сүйіспеншілік сыйы болар.
Dialogue: 0,0:04:42.86,0:04:47.70,Default,,0,0,0,,Эх-хэ-хэ
Dialogue: 0,0:04:47.70,0:04:49.97,Default,,0,0,0,,Зенигата, ебедейсіз және ақымақ.
Dialogue: 0,0:04:49.97,0:04:53.41,Default,,0,0,0,,Бұл Анпонтанның Зенигатасы. Неге сонша қорқасың?
Dialogue: 0,0:04:53.41,0:04:56.31,Default,,0,0,0,,О, сен мені естідің бе? Кешіріңіз
Dialogue: 0,0:04:56.31,0:04:59.21,Default,,0,0,0,,О
Dialogue: 0,0:04:59.21,0:05:01.65,Default,,0,0,0,,Жоқ, білмедім, білмедім
Dialogue: 0,0:05:01.65,0:05:05.22,Default,,0,0,0,,Өтінемін, өтінемін, көбірек, көбірек, көбірек
Dialogue: 0,0:05:05.22,0:05:10.49,Default,,0,0,0,,Қарғыс атсын, не? иә?
Dialogue: 0,0:05:10.49,0:05:13.53,Default,,0,0,0,,Сәлем! не істеп жатырсың
Dialogue: 0,0:05:13.53,0:05:15.93,Default,,0,0,0,,Тоқтатпасаң, мен сені ұстаймын! иә?
Dialogue: 0,0:05:18.20,0:05:21.10,Default,,0,0,0,,Totsuan Cymbals сізге керемет көрінеді.
Dialogue: 0,0:05:21.10,0:05:23.14,Default,,0,0,0,,Мені сүйсең жеткілікті
Dialogue: 0,0:05:23.14,0:05:25.27,Default,,0,0,0,,О! Неге мені сүймейсің?
Dialogue: 0,0:05:25.27,0:05:27.28,Default,,0,0,0,,Зууу!
Dialogue: 0,0:05:27.28,0:05:30.04,Default,,0,0,0,,Мен сенімен шынымен тіл табыса алмаймын.
Dialogue: 0,0:05:30.04,0:05:32.08,Default,,0,0,0,,Хонжа
Dialogue: 0,0:05:32.08,0:05:34.92,Default,,0,0,0,,Күте тұрыңыз! Қашып кетсең ұрып кетесің.
Dialogue: 0,0:05:34.92,0:05:37.22,Default,,0,0,0,,О
Dialogue: 0,0:05:42.09,0:05:45.59,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:05:56.50,0:05:58.60,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:06:10.62,0:06:14.59,Default,,0,0,0,,Уау! Бұл жақсы емес
Dialogue: 0,0:06:14.59,0:06:17.96,Default,,0,0,0,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:06:17.96,0:06:21.83,Default,,0,0,0,,Хмм, тағы бір қызықсыз нәрсе.
Dialogue: 0,0:06:21.83,0:06:23.93,Default,,0,0,0,,Айтпа?
Dialogue: 0,0:06:33.44,0:06:35.64,Default,,0,0,0,,Беллон
Dialogue: 0,0:07:31.20,0:07:33.67,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:07:33.67,0:07:36.04,Default,,0,0,0,,Сіз кімге күлесіз?
Dialogue: 0,0:07:36.04,0:07:38.54,Default,,0,0,0,,Люпин фантом ұры ма әлде Интерполдың инспекторы Зенигата ма?
Dialogue: 0,0:07:38.54,0:07:40.94,Default,,0,0,0,,Бродвейдегі Гран-при жарысы басталды!
Dialogue: 0,0:07:40.94,0:07:44.64,Default,,0,0,0,,Ықтималдық 100-ден 1-ге дейін! Ой, 1-ге 1000!
Dialogue: 0,0:08:21.58,0:08:24.98,Default,,0,0,0,,Нихихихи сен бейбақ.
Dialogue: 0,0:08:28.29,0:08:31.99,Default,,0,0,0,,Иә? Алда
Dialogue: 0,0:08:35.06,0:08:37.97,Default,,0,0,0,,Гуфуфуфуфуфуфу
Dialogue: 0,0:08:37.97,0:08:40.07,Default,,0,0,0,,Гуфуфуфуфуфуфу
Dialogue: 0,0:08:52.28,0:08:54.28,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:59.69,0:09:01.89,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:09:45.67,0:09:48.54,Default,,0,0,0,,Неліктен бұл сұмдық әлі тірі?
Dialogue: 0,0:09:48.54,0:09:51.24,Default,,0,0,0,,Ол баяғыда өлуі керек емес пе еді?
Dialogue: 0,0:09:53.71,0:09:58.05,Default,,0,0,0,,Қате болуы керек, уайымдамаңыз.
Dialogue: 0,0:09:58.05,0:10:00.78,Default,,0,0,0,,Оны ертең таңертеңге дейін тазалаңыз.
Dialogue: 0,0:10:00.78,0:10:04.15,Default,,0,0,0,,Қалай? Гудзон өзенінде жүзу жақсы ма?
Dialogue: 0,0:10:04.15,0:10:06.15,Default,,0,0,0,,Әлде оны суға батырған дұрыс па?
Dialogue: 0,0:10:08.32,0:10:10.72,Default,,0,0,0,,Жүзіп алайын, ғашығыммен өзенге қарап
Dialogue: 0,0:10:10.72,0:10:13.69,Default,,0,0,0,,Шараппен тост айтайық
Dialogue: 0,0:10:13.69,0:10:16.59,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:40.39,0:10:42.32,Default,,0,0,0,,Менің ойымша, бұл жерде үлкен тесік жоқ.
Dialogue: 0,0:10:42.32,0:10:44.36,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:10:44.36,0:10:46.53,Default,,0,0,0,,Зенигатаға бәс тігетін адам бар ма?
Dialogue: 0,0:10:46.53,0:10:48.46,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:48.46,0:10:52.83,Default,,0,0,0,,Сәттілік Люпин
Dialogue: 0,0:10:52.83,0:10:56.53,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:59.47,0:11:01.47,Default,,0,0,0,,Нихихи
Dialogue: 0,0:11:04.11,0:11:06.31,Default,,0,0,0,,Уау
Dialogue: 0,0:11:09.65,0:11:14.09,Default,,0,0,0,,Эй
Dialogue: 0,0:11:14.09,0:11:19.06,Default,,0,0,0,,Nissssssssssssssssssssssssssssssssssssssssssssssssssssssss ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssjsss жарайды.
Dialogue: 0,0:11:19.06,0:11:22.16,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:11:25.50,0:11:28.10,Default,,0,0,0,,Хммм Иә.
Dialogue: 0,0:11:34.07,0:11:37.77,Default,,0,0,0,,О? Не?
Dialogue: 0,0:12:12.75,0:12:15.45,Default,,0,0,0,,Бирон
Dialogue: 0,0:12:15.45,0:12:17.65,Default,,0,0,0,,Lupine
Dialogue: 0,0:12:52.09,0:12:56.29,Default,,0,0,0,,О
Dialogue: 0,0:13:00.79,0:13:02.83,Default,,0,0,0,,Люпин
Dialogue: 0,0:13:02.83,0:13:05.73,Default,,0,0,0,,Келесі жолы кездесеміз
Dialogue: 0,0:13:08.24,0:13:10.84,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:15.98,0:13:20.71,Default,,0,0,0,,Ихихихихихихи
Dialogue: 0,0:13:20.71,0:13:24.15,Default,,0,0,0,,Не? Хехе
Dialogue: 0,0:13:24.15,0:13:27.19,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:13:27.19,0:13:29.96,Default,,0,0,0,,Оны Марсианоның бастығына берген дұрыс емес пе?
Dialogue: 0,0:13:29.96,0:13:33.26,Default,,0,0,0,,Сэм, ақшаны есептеуді оған қалдыр.
Dialogue: 0,0:13:47.07,0:13:51.25,Default,,0,0,0,,Ооо! Сонша
Dialogue: 0,0:13:51.25,0:13:54.48,Default,,0,0,0,,Сора Сора Сора
Dialogue: 0,0:13:54.48,0:13:57.15,Default,,0,0,0,,Барабба
Dialogue: 0,0:13:57.15,0:13:59.45,Default,,0,0,0,,Мына рюкзакта
Dialogue: 0,0:14:02.36,0:14:04.36,Default,,0,0,0,,Сағынып қалдыңыз ба?
Dialogue: 0,0:14:06.33,0:14:08.46,Default,,0,0,0,,Мұны көріп тұрсың ба, Майк?
Dialogue: 0,0:14:08.46,0:14:11.37,Default,,0,0,0,,Бұл жай ғана шыбын-шіркей емес, жарай ма?
Dialogue: 0,0:14:11.37,0:14:13.90,Default,,0,0,0,,болып табылады
Dialogue: 0,0:14:13.90,0:14:16.40,Default,,0,0,0,,Егер ол Нью-Йорк мафиясы деп аталса.
Dialogue: 0,0:14:16.40,0:14:18.77,Default,,0,0,0,,Бұл бір рет
Dialogue: 0,0:14:18.77,0:14:20.84,Default,,0,0,0,,Ұялғаннан қызарып кету
Dialogue: 0,0:14:20.84,0:14:23.38,Default,,0,0,0,,екі рет
Dialogue: 0,0:14:23.38,0:14:27.35,Default,,0,0,0,,Үшінші дәреже
Dialogue: 0,0:14:27.35,0:14:32.09,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:32.09,0:14:34.29,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:37.69,0:14:40.99,Default,,0,0,0,,Түсінсең, бұрыл
Dialogue: 0,0:14:40.99,0:14:44.70,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:44.70,0:14:47.60,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:14:52.74,0:14:54.74,Default,,0,0,0,,Фуааааааааааа
Dialogue: 0,0:15:11.43,0:15:17.33,Default,,0,0,0,,Иә? Хмм? Ууууууууууу!
Dialogue: 0,0:15:19.17,0:15:21.17,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:25.91,0:15:28.21,Default,,0,0,0,,Б
Dialogue: 0,0:15:32.71,0:15:35.31,Default,,0,0,0,,Б
Dialogue: 0,0:15:38.42,0:15:42.96,Default,,0,0,0,,Уф
Dialogue: 0,0:15:42.96,0:15:44.89,Default,,0,0,0,,Ихихихихихихихи
Dialogue: 0,0:15:44.89,0:15:47.69,Default,,0,0,0,,Ол дұрыс бекітілген.
Dialogue: 0,0:15:50.03,0:15:53.13,Default,,0,0,0,,Мен оны біраз уақыттан бері алып жатырмын.
Dialogue: 0,0:15:55.77,0:15:59.57,Default,,0,0,0,,Ха, кел, Розетта.
Dialogue: 0,0:15:59.57,0:16:02.61,Default,,0,0,0,,Қайт, мен саған сыйлық беремін. Қайтып кел.
Dialogue: 0,0:16:02.61,0:16:06.15,Default,,0,0,0,,Бұлай жұмыс істемейді.
Dialogue: 0,0:16:06.15,0:16:08.75,Default,,0,0,0,,Саясат оны сол күні қайтару болып табылады.
Dialogue: 0,0:16:21.26,0:16:25.56,Default,,0,0,0,,О? Эй кемпір
Dialogue: 0,0:16:30.34,0:16:32.27,Default,,0,0,0,,Ууууууууууу жақсы
Dialogue: 0,0:16:32.27,0:16:34.98,Default,,0,0,0,,Люпин ше?
Dialogue: 0,0:16:34.98,0:16:37.44,Default,,0,0,0,,Тіпті бұл бұрын да болған
Dialogue: 0,0:16:37.44,0:16:39.64,Default,,0,0,0,,Мен көп биледім.
Dialogue: 0,0:16:41.92,0:16:47.19,Default,,0,0,0,,Уау! Жетеді
Dialogue: 0,0:16:47.19,0:16:50.62,Default,,0,0,0,,Мен сізге жеткілікті қарыздармын.
Dialogue: 0,0:16:50.62,0:16:54.06,Default,,0,0,0,,...
Dialogue: 0,0:16:54.06,0:16:57.43,Default,,0,0,0,,Мен олай ойламаймын, сонда ше?
Dialogue: 0,0:16:57.43,0:16:59.90,Default,,0,0,0,,Кел, Люпин
Dialogue: 0,0:16:59.90,0:17:02.00,Default,,0,0,0,,Хееееееее!
Dialogue: 0,0:17:12.21,0:17:14.51,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:17:17.55,0:17:21.15,Default,,0,0,0,,Ухихихихи
Dialogue: 0,0:17:21.15,0:17:25.03,Default,,0,0,0,,Көмегің үшін рахмет. Мен саған жақсы әңгіме айтып беремін.
Dialogue: 0,0:17:25.03,0:17:27.43,Default,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:17:30.40,0:17:33.30,Default,,0,0,0,,Бір кездері
Dialogue: 0,0:17:33.30,0:17:35.74,Default,,0,0,0,,Осы уақытқа дейін өркендей берді.
Dialogue: 0,0:17:35.74,0:17:38.61,Default,,0,0,0,,Вавилон, Месопотамия өркениетінің қаласы
Dialogue: 0,0:17:38.61,0:17:40.91,Default,,0,0,0,,Парсы ордасына ілгерілеу
Dialogue: 0,0:17:40.91,0:17:42.98,Default,,0,0,0,,Ол жойылды.
Dialogue: 0,0:17:42.98,0:17:45.81,Default,,0,0,0,,Бірақ Вавилон жойылар алдында,
Dialogue: 0,0:17:45.81,0:17:49.48,Default,,0,0,0,,Құдай пайда болып, Вавилонның қазынасын алып кетеді.
Dialogue: 0,0:17:49.48,0:17:52.42,Default,,0,0,0,,Олар оны жинап алып, жасырды.
Dialogue: 0,0:17:52.42,0:17:54.62,Default,,0,0,0,,Иә? жылы
Dialogue: 0,0:17:59.16,0:18:01.56,Default,,0,0,0,,Тәңір жасырған қазына
Dialogue: 0,0:18:01.56,0:18:04.06,Default,,0,0,0,,Оны Вавилон қазынасы деп атаңыз.
Dialogue: 0,0:18:04.06,0:18:06.26,Default,,0,0,0,,Мына шамға
Dialogue: 0,0:18:23.72,0:18:25.99,Default,,0,0,0,,Әлі де осында!
Dialogue: 0,0:18:25.99,0:18:28.32,Default,,0,0,0,,Сіз Нью-Йорк мафиясы үшін не істедіңіз?
Dialogue: 0,0:18:28.32,0:18:30.26,Default,,0,0,0,,Розетта тарақандары
Dialogue: 0,0:18:30.26,0:18:32.63,Default,,0,0,0,,Жоқ, жоқ, жоқ, жібер.
Dialogue: 0,0:18:32.63,0:18:36.13,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:18:36.13,0:18:38.13,Default,,0,0,0,,Енді алыстаңыз.
Dialogue: 0,0:18:38.13,0:18:40.33,Default,,0,0,0,,Lupine
Dialogue: 0,0:18:40.33,0:18:42.63,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:19:06.29,0:19:11.83,Default,,0,0,0,,Қорғасын оқтары маған жұмыс істемейді, алтын доп...
Dialogue: 0,0:19:11.83,0:19:15.70,Default,,0,0,0,,Егер бұл алтын шар немесе гауһар тас болса, мен оны қабылдай аламын.
Dialogue: 0,0:19:15.70,0:19:18.70,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:19:22.41,0:19:25.01,Default,,0,0,0,,Бітірдің бе? О, жоқ
Dialogue: 0,0:19:25.01,0:19:28.21,Default,,0,0,0,,Мені үндеместен үйге жібере алмайсың. Эй, кемпір.
Dialogue: 0,0:19:57.08,0:20:00.31,Default,,0,0,0,,Тез қашқан кемпір екенін.
Dialogue: 0,0:20:00.31,0:20:03.25,Default,,0,0,0,,Енді кезекке тұрайық.
Dialogue: 0,0:20:03.25,0:20:06.62,Default,,0,0,0,,Вассе
Dialogue: 0,0:20:06.62,0:20:12.73,Default,,0,0,0,,Люпин ақымақ
Dialogue: 0,0:20:12.73,0:20:15.06,Default,,0,0,0,,Не?
Dialogue: 0,0:20:15.06,0:20:18.73,Default,,0,0,0,,Мен қалдырған кәдесый.
Dialogue: 0,0:20:18.73,0:20:21.43,Default,,0,0,0,,Бұл жігіт бірдеңе болуы мүмкін.
Dialogue: 0,0:20:27.81,0:20:29.84,Default,,0,0,0,,Мен Мартиноға жақындадым
Dialogue: 0,0:20:29.84,0:20:32.55,Default,,0,0,0,,Вавилонның құпиясын иіскеуге тырысу.
Dialogue: 0,0:20:32.55,0:20:35.28,Default,,0,0,0,,Ол білетін сияқты.
Dialogue: 0,0:20:35.28,0:20:39.92,Default,,0,0,0,,Сен кімсің? Хмм
Dialogue: 0,0:20:39.92,0:20:42.59,Default,,0,0,0,,Батыс қайыршысы!
Dialogue: 0,0:20:42.59,0:20:44.69,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:21:02.74,0:21:04.84,Default,,0,0,0,,Ненің суретін салып жатырсың?
Dialogue: 0,0:21:12.49,0:21:16.59,Default,,0,0,0,,Мен скампи салайын деп едім, бірақ оны өзгерттім.
Dialogue: 0,0:21:16.59,0:21:18.59,Default,,0,0,0,,Юбе
Dialogue: 0,0:21:18.59,0:21:22.40,Default,,0,0,0,,О.
Dialogue: 0,0:21:22.40,0:21:25.00,Default,,0,0,0,,Бұл өткен күні алтын табыт болатын.
Dialogue: 0,0:21:25.00,0:21:27.20,Default,,0,0,0,,Сіз өте арманшыл адамсыз, солай емес пе?
Dialogue: 0,0:21:29.30,0:21:31.24,Default,,0,0,0,,Бірақ Вавилонның қазынасы ше?
Dialogue: 0,0:21:31.24,0:21:34.14,Default,,0,0,0,,Қызық, бар ма? Сондай-ақ бар
Dialogue: 0,0:21:34.14,0:21:38.01,Default,,0,0,0,,Сенбейсің бе? Мен үнемі сөйлесемін.
Dialogue: 0,0:21:38.01,0:21:40.41,Default,,0,0,0,,Жақын арада өз көзқарасыңызды көрсетсеңіз деймін.
Dialogue: 0,0:22:08.61,0:22:11.24,Default,,0,0,0,,Неке сақинасы ше? Фудзико
Dialogue: 0,0:22:11.24,0:22:13.65,Default,,0,0,0,,Мені қате түсінбе, Мартино.
Dialogue: 0,0:22:13.65,0:22:16.15,Default,,0,0,0,,Вавилонның алтынын тапсаң
Dialogue: 0,0:22:16.15,0:22:18.35,Default,,0,0,0,,Мен сені жақсы көретінімді айттым
Dialogue: 0,0:22:24.79,0:22:27.66,Default,,0,0,0,,Жақында Вавилонның алтыны табылады.
Dialogue: 0,0:22:27.66,0:22:31.53,Default,,0,0,0,,Менің ұйымым сізді табу үшін қолдан келгеннің бәрін жасауда.
Dialogue: 0,0:22:31.53,0:22:34.23,Default,,0,0,0,,Мен мұны еріксіз істеп жатқан жоқпын.
Dialogue: 0,0:22:34.23,0:22:38.71,Default,,0,0,0,,Бұл ата-анамның ұрпағынан бері келе жатқан заңды кәсіп.
Dialogue: 0,0:22:38.71,0:22:42.48,Default,,0,0,0,,Мен мұны естуден шаршадым. Токиоға қайтатын уақыт келді деп ойлаймын.
Dialogue: 0,0:22:42.48,0:22:44.48,Default,,0,0,0,,Фудзико
Dialogue: 0,0:22:59.36,0:23:03.00,Default,,0,0,0,,Келіңіз және оны өз көзқарасыңызбен көрсетіңіз.
Dialogue: 0,0:23:03.00,0:23:05.70,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:23:37.30,0:23:39.40,Default,,0,0,0,,Ашық
Dialogue: 0,0:23:43.70,0:23:46.27,Default,,0,0,0,,Менің әкем Лаки Лучаноға
Dialogue: 0,0:23:46.27,0:23:48.54,Default,,0,0,0,,Аумағын беріп, зейнетке шыққан.
Dialogue: 0,0:23:48.54,0:23:52.41,Default,,0,0,0,,Бұл Донпачиден шаршағаным үшін ғана емес.
Dialogue: 0,0:23:52.41,0:23:54.68,Default,,0,0,0,,Әкем алтын іздеуге Вавилонияға кетті.
Dialogue: 0,0:23:54.68,0:23:56.68,Default,,0,0,0,,Себебі мені ренжітті.
Dialogue: 0,0:23:56.68,0:23:58.95,Default,,0,0,0,,Барлығы Мэдисон Сквер Гарденде басталды.
Dialogue: 0,0:23:58.95,0:24:01.95,Default,,0,0,0,,Бұл метро құрылыс алаңынан табылған балшық тақтасы болатын.
Dialogue: 0,0:24:35.36,0:24:38.83,Default,,0,0,0,,Қандай балшық тақтайшаларда вавилондық әріптер қашалған?
Dialogue: 0,0:24:38.83,0:24:41.13,Default,,0,0,0,,Ол Нью-Йорктің ортасында жерден шықты ма?
Dialogue: 0,0:24:41.13,0:24:46.47,Default,,0,0,0,,Бұл әлі шешілмейтін жұмбақ, бірақ содан бері
Dialogue: 0,0:24:46.47,0:24:50.30,Default,,0,0,0,,Әкем банды бизнестен біржола кетті.
Dialogue: 0,0:24:50.30,0:24:54.70,Default,,0,0,0,,Мен өзімді Вавилон қирандыларын қазуға арнауды шештім.
Dialogue: 0,0:25:06.89,0:25:11.29,Default,,0,0,0,,Нашар
Dialogue: 0,0:25:11.29,0:25:13.99,Default,,0,0,0,,Иракқа жіберілген Гитлер болды.
Dialogue: 0,0:25:17.96,0:25:22.70,Default,,0,0,0,,Гитлер менің әкем сияқты іздеген.
Dialogue: 0,0:25:22.70,0:25:26.14,Default,,0,0,0,,Бұл алтын. Вавилониядағы барлық алтынды жинаңыз.
Dialogue: 0,0:25:26.14,0:25:30.01,Default,,0,0,0,,Бұл Навухатнесарон бұйырған алтын кесек.
Dialogue: 0,0:25:30.01,0:25:32.91,Default,,0,0,0,,Кесек? оның қандай пішіні бар
Dialogue: 0,0:25:32.91,0:25:35.85,Default,,0,0,0,,Білмеймін, бірақ алтынның айыбы жоқ.
Dialogue: 0,0:25:35.85,0:25:38.22,Default,,0,0,0,,Әкем қазып алған балшық тақтада,
Dialogue: 0,0:25:38.22,0:25:40.52,Default,,0,0,0,,Бұл анық жазылған.
Dialogue: 0,0:25:40.52,0:25:45.33,Default,,0,0,0,,Мен бизнесті де, жер асты әлемінің жұмысын да өз қолыма алдым
Dialogue: 0,0:25:45.33,0:25:47.93,Default,,0,0,0,,Мен мұны жас Ковальскийге қалдыруды жөн көрдім.
Dialogue: 0,0:25:56.94,0:25:59.24,Default,,0,0,0,,Уау
Dialogue: 0,0:26:02.18,0:26:04.18,Default,,0,0,0,,Жабу
Dialogue: 0,0:26:29.67,0:26:31.60,Default,,0,0,0,,Фудзико күткендей
Dialogue: 0,0:26:31.60,0:26:34.54,Default,,0,0,0,,Маған басқа керексіз заттар маңызды емес
Dialogue: 0,0:26:34.54,0:26:36.58,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:26:36.58,0:26:38.75,Default,,0,0,0,,Манхэттен құжаттары дегеніміз не?
Dialogue: 0,0:26:38.75,0:26:41.38,Default,,0,0,0,,Иә, мен Манхэттеннен кеттім.
Dialogue: 0,0:26:41.38,0:26:44.42,Default,,0,0,0,,Барлығы 50 балшық таблетка сынықтары бар делінген.
Dialogue: 0,0:26:44.42,0:26:47.52,Default,,0,0,0,,Міне, олардың 40-ы.
Dialogue: 0,0:26:47.52,0:26:50.16,Default,,0,0,0,,Иә
Dialogue: 0,0:26:50.16,0:26:53.06,Default,,0,0,0,,Сына әріптер ойыс болуы керек емес пе?
Dialogue: 0,0:26:53.06,0:26:55.16,Default,,0,0,0,,Бұл көрінбейді, солай ма?
Dialogue: 0,0:26:57.43,0:27:01.30,Default,,0,0,0,,Мүмкін бұл кері әріп шығар?
Dialogue: 0,0:27:01.30,0:27:04.64,Default,,0,0,0,,Ол оқи алады ма? Амал жоқ
Dialogue: 0,0:27:04.64,0:27:07.67,Default,,0,0,0,,Мен қорқамын, Фудзико, дұрыс айтасың.
Dialogue: 0,0:27:07.67,0:27:11.81,Default,,0,0,0,,Манхэттендегі вавилондық әріптердің барлығы кері әріптермен жазылған.
Dialogue: 0,0:27:11.81,0:27:15.05,Default,,0,0,0,,Күткендей, дәл Люпин айтқандай.
Dialogue: 0,0:27:15.05,0:27:17.98,Default,,0,0,0,,Не? Люпин де солай істейді
Dialogue: 0,0:27:17.98,0:27:20.85,Default,,0,0,0,,Мен біраз жинап жатырмын.
Dialogue: 0,0:27:20.85,0:27:23.76,Default,,0,0,0,,Онша көп емес.
Dialogue: 0,0:27:23.76,0:27:26.66,Default,,0,0,0,,Олай болса, болмайды
Dialogue: 0,0:27:26.66,0:27:29.63,Default,,0,0,0,,Сіз соны мақсат етіп жатырмын дейсіз бе? Әй
Dialogue: 0,0:27:29.63,0:27:32.60,Default,,0,0,0,,Вавилон алтыны туралы және әкең туралы
Dialogue: 0,0:27:32.60,0:27:36.47,Default,,0,0,0,,Мен оны мұқият зерттеп, анықтадым, әрине.
Dialogue: 0,0:27:36.47,0:27:39.24,Default,,0,0,0,,Ха
Dialogue: 0,0:27:39.24,0:27:42.91,Default,,0,0,0,,Бұл сұмдық! Сіз балшық!
Dialogue: 0,0:27:42.91,0:27:45.55,Default,,0,0,0,,Люпин оның лай екенін естігенде.
Dialogue: 0,0:27:45.55,0:27:47.55,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:27:50.38,0:27:52.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:54.55,0:27:58.19,Default,,0,0,0,,Бұл жасырын камера.
Dialogue: 0,0:27:58.19,0:28:00.76,Default,,0,0,0,,Сіз камераны ұрладыңыз ба?
Dialogue: 0,0:28:00.76,0:28:02.76,Default,,0,0,0,,Ааах!
Dialogue: 0,0:28:09.07,0:28:12.41,Default,,0,0,0,,Әй?
Dialogue: 0,0:28:12.41,0:28:16.21,Default,,0,0,0,,Кяаааааааааааааааааааа
Dialogue: 0,0:28:16.21,0:28:18.81,Default,,0,0,0,,Менімен не істейсің?
Dialogue: 0,0:28:24.82,0:28:28.69,Default,,0,0,0,,Ru
Dialogue: 0,0:28:28.69,0:28:31.72,Default,,0,0,0,,Тек ұйықтама.
Dialogue: 0,0:28:31.72,0:28:35.46,Default,,0,0,0,,Егер сіздің дауысыңыз болса, мен оны дұрыстап жазып алар едім.
Dialogue: 0,0:28:35.46,0:28:39.33,Default,,0,0,0,,Ашық
Dialogue: 0,0:28:39.33,0:28:43.70,Default,,0,0,0,,Нихихихи уһ
Dialogue: 0,0:28:43.70,0:28:46.61,Default,,0,0,0,,Вавилон қазынасы Мен оны аламын
Dialogue: 0,0:28:46.61,0:28:48.81,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:28:53.38,0:28:55.82,Default,,0,0,0,,Сіздің қазіргі жұмысыңыз қандай? Сәттілік мачу
Dialogue: 0,0:28:55.82,0:28:57.82,Default,,0,0,0,,Жақында колледжде оқитын қыздар туралы
Dialogue: 0,0:28:57.82,0:29:01.55,Default,,0,0,0,,Өте сүйкімді! Сізге қандай тағам ұнамайды?
Dialogue: 0,0:29:01.55,0:29:03.49,Default,,0,0,0,,Сегізаяқ О, иә.
Dialogue: 0,0:29:03.49,0:29:06.99,Default,,0,0,0,,Парижге барайық. Инспектор Зенигатаға сөз.
Dialogue: 0,0:29:10.63,0:29:12.87,Default,,0,0,0,,Хатшы! Бұл Зенигатаның не кінәсі бар?
Dialogue: 0,0:29:12.87,0:29:17.20,Default,,0,0,0,,Люпинді қамауға алу үшін тікелей бағыныштыны тіркеңіз.
Dialogue: 0,0:29:17.20,0:29:19.17,Default,,0,0,0,,Сізге қандай тағам ұнамайды? сегізаяқ
Dialogue: 0,0:29:19.17,0:29:22.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:29:22.04,0:29:24.38,Default,,0,0,0,,Инспектор Зенигатаға сөз
Dialogue: 0,0:29:24.38,0:29:26.95,Default,,0,0,0,,nihihihihi
Dialogue: 0,0:29:26.95,0:29:31.22,Default,,0,0,0,,О? Ммм
Dialogue: 0,0:29:31.22,0:29:34.85,Default,,0,0,0,,Жарайсың, мына Зенигатаны мүкке салдың!
Dialogue: 0,0:29:34.85,0:29:37.86,Default,,0,0,0,,Бероберо
Dialogue: 0,0:29:37.86,0:29:40.19,Default,,0,0,0,,Зенигата-кун! Тек бүгін
Dialogue: 0,0:29:40.19,0:29:42.96,Default,,0,0,0,,Мен сені Люпинді тұтқындау миссиясынан аластатамын!
Dialogue: 0,0:29:42.96,0:29:45.87,Default,,0,0,0,,Не?
Dialogue: 0,0:29:45.87,0:29:49.17,Default,,0,0,0,,Сіздің жаңа миссияңыз - жоқ
Dialogue: 0,0:29:49.17,0:29:52.01,Default,,0,0,0,,Бұл Зенигата
Dialogue: 0,0:29:52.01,0:29:55.81,Default,,0,0,0,,Жоқ
Dialogue: 0,0:29:57.81,0:30:01.21,Default,,0,0,0,,Өтіп бара жатқандарға ыңғайсыздық тудырғанымыз үшін кешірім сұраймыз.
Dialogue: 0,0:30:01.21,0:30:04.85,Default,,0,0,0,,Бұл ICPO-ның жарнамалық шары.
Dialogue: 0,0:30:04.85,0:30:08.19,Default,,0,0,0,,Солтүстіктегі Алясканың шетінен оңтүстіктегі Жаңа Гвинеяның тереңдігіне дейін
Dialogue: 0,0:30:08.19,0:30:12.69,Default,,0,0,0,,Дүние жүзіндегі полиция күштерінен таңдалған 50 әйел полиция қызметкері
Dialogue: 0,0:30:12.69,0:30:16.66,Default,,0,0,0,,Сұлулығы үшін ICPO демеушілік ететін халықаралық байқау
Dialogue: 0,0:30:16.66,0:30:19.66,Default,,0,0,0,,Полицей әйел сұлулық байқауы
Dialogue: 0,0:30:26.54,0:30:28.47,Default,,0,0,0,,Жазба нөмірі 9
Dialogue: 0,0:30:28.47,0:30:30.51,Default,,0,0,0,,Америка өкілі
Dialogue: 0,0:30:30.51,0:30:32.51,Default,,0,0,0,,Қате
Dialogue: 0,0:30:42.76,0:30:45.02,Default,,0,0,0,,Ахх
Dialogue: 0,0:30:45.02,0:30:47.93,Default,,0,0,0,,Хмм, жарай…
Dialogue: 0,0:30:47.93,0:30:49.96,Default,,0,0,0,,Жазба нөмірі 11
Dialogue: 0,0:30:49.96,0:30:52.90,Default,,0,0,0,,Қытай өкілі
Dialogue: 0,0:30:52.90,0:30:56.37,Default,,0,0,0,,Нименхао Нихао
Dialogue: 0,0:30:56.37,0:30:59.21,Default,,0,0,0,,Ол ертең-ақ ауруханадан шығады сияқты—
Dialogue: 0,0:30:59.21,0:31:01.81,Default,,0,0,0,,Жазба нөмірі 35
Dialogue: 0,0:31:01.81,0:31:04.38,Default,,0,0,0,,Кеңес Аруы
Dialogue: 0,0:31:04.38,0:31:06.68,Default,,0,0,0,,Харашо
Dialogue: 0,0:31:06.68,0:31:09.28,Default,,0,0,0,,Харашо
Dialogue: 0,0:31:09.28,0:31:12.19,Default,,0,0,0,,Харашо өте жақсы
Dialogue: 0,0:31:12.19,0:31:14.82,Default,,0,0,0,,Жазба нөмірі 41
Dialogue: 0,0:31:14.82,0:31:17.36,Default,,0,0,0,,Кения өкілі
Dialogue: 0,0:31:17.36,0:31:20.19,Default,,0,0,0,,Хаффхохо
Dialogue: 0,0:31:20.19,0:31:22.59,Default,,0,0,0,,Кения
Dialogue: 0,0:31:40.81,0:31:43.91,Default,,0,0,0,,Енді мен хабарландыру жасаймын.
Dialogue: 0,0:31:46.99,0:31:49.89,Default,,0,0,0,,Жазба нөмірі 26
Dialogue: 0,0:31:49.89,0:31:53.39,Default,,0,0,0,,Италия өкілі
Dialogue: 0,0:32:03.44,0:32:06.17,Default,,0,0,0,,Неліктен мұндай ұсқынсыз адам таңдалады?
Dialogue: 0,0:32:06.17,0:32:08.88,Default,,0,0,0,,Емтихан критерийлері мүлде қате!
Dialogue: 0,0:32:08.88,0:32:10.81,Default,,0,0,0,,Күмән қалады
Dialogue: 0,0:32:10.81,0:32:13.21,Default,,0,0,0,,Конкурс Қайталап көріңіз!
Dialogue: 0,0:32:13.21,0:32:15.65,Default,,0,0,0,,Сіз қалай ойлайсыз? Жауап беріңіз!
Dialogue: 0,0:32:15.65,0:32:18.15,Default,,0,0,0,,Ммм?
Dialogue: 0,0:32:18.15,0:32:20.09,Default,,0,0,0,,Әлемдегі жетекші ICPO
Dialogue: 0,0:32:20.09,0:32:22.05,Default,,0,0,0,,Уақытты өлтіру үшін мұны істеу
Dialogue: 0,0:32:22.05,0:32:24.72,Default,,0,0,0,,Сіз мұны жақсы дейсіз бе? Кет
Dialogue: 0,0:32:24.72,0:32:27.63,Default,,0,0,0,,Зенигата-кун
Dialogue: 0,0:32:27.63,0:32:29.90,Default,,0,0,0,,Ягами
Dialogue: 0,0:32:29.90,0:32:32.73,Default,,0,0,0,,Киккунды Люпинді тұтқындау миссиясына қайтарыңыз.
Dialogue: 0,0:32:32.73,0:32:35.47,Default,,0,0,0,,Иә? Бұл рас па!
Dialogue: 0,0:32:35.47,0:32:38.37,Default,,0,0,0,,Ягами
Dialogue: 0,0:32:38.37,0:32:40.41,Default,,0,0,0,,Люпин қамауға алынды...
Dialogue: 0,0:32:40.41,0:32:44.91,Default,,0,0,0,,Зенигата-кун, мен сенен бір нәрсе алғым келеді.
Dialogue: 0,0:32:44.91,0:32:47.81,Default,,0,0,0,,Бүгіннен бастап олар сіздің тікелей есептеріңіз болады.
Dialogue: 0,0:32:47.81,0:32:49.78,Default,,0,0,0,,Лазаньяны да қосыңыз
Dialogue: 0,0:32:49.78,0:32:52.29,Default,,0,0,0,,Эх-хэ-хэ
Dialogue: 0,0:32:52.29,0:32:55.49,Default,,0,0,0,,Бұл жолы мен сені түрмеге тастаймын.
Dialogue: 0,0:32:55.49,0:32:57.42,Default,,0,0,0,,Чончон
Dialogue: 0,0:32:57.42,0:33:00.36,Default,,0,0,0,,Чочон
Dialogue: 0,0:33:00.36,0:33:03.16,Default,,0,0,0,,Чон Чон Чон
Dialogue: 0,0:33:05.20,0:33:09.90,Default,,0,0,0,,Енді ләззат алыңыз!
Dialogue: 0,0:33:14.74,0:33:17.58,Default,,0,0,0,,Құдай…
Dialogue: 0,0:33:17.58,0:33:20.18,Default,,0,0,0,,Елдің түкпір-түкпірінен алтын жина
Dialogue: 0,0:33:20.18,0:33:22.15,Default,,0,0,0,,Колт, жағдай қалай?
Dialogue: 0,0:33:22.15,0:33:25.55,Default,,0,0,0,,Оның орналасқан жері
Dialogue: 0,0:33:25.55,0:33:28.02,Default,,0,0,0,,Колт, жағдай қалай?
Dialogue: 0,0:33:28.02,0:33:29.96,Default,,0,0,0,,Гуфуфуфуфуфу
Dialogue: 0,0:33:29.96,0:33:32.46,Default,,0,0,0,,Маған елдің түкпір-түкпірінде алтын бар екені ұнайды.
Dialogue: 0,0:33:32.46,0:33:36.33,Default,,0,0,0,,Бұл ондаған мың тонна болса керек.
Dialogue: 0,0:33:36.33,0:33:39.83,Default,,0,0,0,,Бұл күлкілі Люпин, мен Құдай пайда болған оқиғамын.
Dialogue: 0,0:33:39.83,0:33:41.77,Default,,0,0,0,,Мен саған сенбеуді таңдадым.
Dialogue: 0,0:33:41.77,0:33:46.24,Default,,0,0,0,,Мен тіпті Құдайға сенбеймін.
Dialogue: 0,0:33:46.24,0:33:49.74,Default,,0,0,0,,Оны патша сорпаға пайдаланған даши қабығымен салыстыруға болмайды.
Dialogue: 0,0:33:49.74,0:33:52.28,Default,,0,0,0,,Бабыл қазынасына сенсем де
Dialogue: 0,0:33:52.28,0:33:54.21,Default,,0,0,0,,Маған көне құжаттардың көзі ұнамайды.
Dialogue: 0,0:33:54.21,0:33:56.45,Default,,0,0,0,,Неліктен қазір Америка?
Dialogue: 0,0:33:56.45,0:33:59.35,Default,,0,0,0,,Неліктен ол Нью-Йорк топырағында болуы керек?
Dialogue: 0,0:33:59.35,0:34:02.36,Default,,0,0,0,,Мінекей!
Dialogue: 0,0:34:02.36,0:34:05.66,Default,,0,0,0,,Мен оны ашсам, қазынаның ішінде жоқ екеніне таң қалдым.
Dialogue: 0,0:34:05.66,0:34:08.39,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:34:08.39,0:34:10.73,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:34:10.73,0:34:13.17,Default,,0,0,0,,Мен оны міндетті түрде ашып, сізге көрсетемін.
Dialogue: 0,0:34:13.17,0:34:15.47,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:34:15.47,0:34:17.70,Default,,0,0,0,,Ей, эй, өлшемді көне заман
Dialogue: 0,0:34:17.70,0:34:21.57,Default,,0,0,0,,Ескендір Зұлқарнайын іздеп тапса да, алтын болатын.
Dialogue: 0,0:34:21.57,0:34:23.91,Default,,0,0,0,,Наполеон маңында
Dialogue: 0,0:34:23.91,0:34:25.95,Default,,0,0,0,,Және Гитлер
Dialogue: 0,0:34:25.95,0:34:28.21,Default,,0,0,0,,Дүниені жаулап алуды жоспарлаған батырлар
Dialogue: 0,0:34:28.21,0:34:30.88,Default,,0,0,0,,Барлығы
Dialogue: 0,0:34:30.88,0:34:33.68,Default,,0,0,0,,Сен оны анау сараң бандиттерге бересің бе?
Dialogue: 0,0:34:36.52,0:34:38.46,Default,,0,0,0,,Басыңды суыт, Люпин
Dialogue: 0,0:34:38.46,0:34:40.43,Default,,0,0,0,,Қандай қорқынышты өлшем!
Dialogue: 0,0:34:40.43,0:34:43.20,Default,,0,0,0,,Ммм
Dialogue: 0,0:34:43.20,0:34:45.16,Default,,0,0,0,,Түсуді кім айтты?
Dialogue: 0,0:34:45.16,0:34:47.16,Default,,0,0,0,,Коньяк таусылды.
Dialogue: 0,0:34:58.31,0:35:00.61,Default,,0,0,0,,Коньяк? Сіз де коньяк жеп қойыңыз!
Dialogue: 0,0:35:04.12,0:35:06.82,Default,,0,0,0,,Саз таблеткасының ылғалдылық жағдайы қандай?
Dialogue: 0,0:35:16.36,0:35:18.36,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:35:21.73,0:35:24.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:24.97,0:35:27.87,Default,,0,0,0,,Сәлем
Dialogue: 0,0:35:27.87,0:35:30.11,Default,,0,0,0,,Lupine
Dialogue: 0,0:35:30.11,0:35:34.05,Default,,0,0,0,,Gya gya gya gyaaaaaaaaaatatatatata
Dialogue: 0,0:35:34.05,0:35:37.75,Default,,0,0,0,,Кешіріңіз. Махаббат деген не? Сүйісу?
Dialogue: 0,0:35:37.75,0:35:40.52,Default,,0,0,0,,Егер солай болса, кешіріңіз.
Dialogue: 0,0:35:40.52,0:35:42.76,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:35:42.76,0:35:45.66,Default,,0,0,0,,Ол мені күніне 100 рет сүйді.
Dialogue: 0,0:35:45.66,0:35:48.43,Default,,0,0,0,,О? Алекс деген кім?
Dialogue: 0,0:35:48.43,0:35:50.66,Default,,0,0,0,,Александр
Dialogue: 0,0:35:50.66,0:35:53.23,Default,,0,0,0,,Леон-чан да мені жақсы көреді.
Dialogue: 0,0:35:53.23,0:35:55.17,Default,,0,0,0,,Сен менімен үнемі сырласатынсың
Dialogue: 0,0:35:55.17,0:35:57.50,Default,,0,0,0,,Сол кісінің арқасында ұйқым қашып жатыр.
Dialogue: 0,0:35:57.50,0:36:00.24,Default,,0,0,0,,Мен жылқыдан жиі сийемін.
Dialogue: 0,0:36:00.24,0:36:02.98,Default,,0,0,0,,Иә? Бұл қашан болды, кемпір?
Dialogue: 0,0:36:02.98,0:36:06.25,Default,,0,0,0,,Ватерлоода соғыс болды, солай ма? Уақыт келді
Dialogue: 0,0:36:06.25,0:36:09.28,Default,,0,0,0,,Иә? Жарайды онда
Dialogue: 0,0:36:09.28,0:36:11.75,Default,,0,0,0,,Напонапо
Dialogue: 0,0:36:11.75,0:36:14.39,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:36:14.39,0:36:16.62,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:36:16.62,0:36:20.32,Default,,0,0,0,,Егер бұл жақсы болмаса, мен оқиғаны мүлдем көре алмаймын.
Dialogue: 0,0:36:23.83,0:36:26.23,Default,,0,0,0,,Вавилонның оңтүстігі
Dialogue: 0,0:36:33.21,0:36:36.61,Default,,0,0,0,,Hiiii
Dialogue: 0,0:36:36.61,0:36:39.01,Default,,0,0,0,,Уау
Dialogue: 0,0:36:46.29,0:36:49.96,Default,,0,0,0,,Осындай жерде болды, қайда кетті деп ойладым.
Dialogue: 0,0:36:49.96,0:36:53.86,Default,,0,0,0,,А, мен таң қалдым.
Dialogue: 0,0:36:57.53,0:36:59.97,Default,,0,0,0,,76 жыл сайын
Dialogue: 0,0:36:59.97,0:37:02.54,Default,,0,0,0,,Жарқыраған Бабыл мұнарасында тұрыңыз
Dialogue: 0,0:37:02.54,0:37:06.31,Default,,0,0,0,,Эй
Dialogue: 0,0:37:06.31,0:37:09.81,Default,,0,0,0,,Мұның Вавилон қазынасына қандай қатысы бар?
Dialogue: 0,0:37:09.81,0:37:13.65,Default,,0,0,0,,Құдай сыпырғыш жұлдызға мініп келеді.
Dialogue: 0,0:37:13.65,0:37:16.62,Default,,0,0,0,,Вавилонның алтынын қараңыз
Dialogue: 0,0:37:16.62,0:37:18.78,Default,,0,0,0,,Сонда сіз ше?
Dialogue: 0,0:37:18.78,0:37:22.29,Default,,0,0,0,,Сонда сіз Құдайдың басшылығын қолданасыз ба?
Dialogue: 0,0:37:22.29,0:37:26.79,Default,,0,0,0,,Хохохохохохо Люпин
Dialogue: 0,0:37:26.79,0:37:29.46,Default,,0,0,0,,Есіңізде болсын, қараңғы тесік бар
Dialogue: 0,0:37:29.46,0:37:31.86,Default,,0,0,0,,Мен сені күтетініме сенімдімін
Dialogue: 0,0:37:31.86,0:37:33.80,Default,,0,0,0,,Қараңғы тесік
Dialogue: 0,0:37:33.80,0:37:36.70,Default,,0,0,0,,Lupine
Dialogue: 0,0:37:36.70,0:37:39.20,Default,,0,0,0,,Йойо
Dialogue: 0,0:37:41.27,0:37:44.97,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:37:47.45,0:37:50.92,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:37:50.92,0:37:52.92,Default,,0,0,0,,Жақсы
Dialogue: 0,0:37:55.76,0:37:57.86,Default,,0,0,0,,Орташа! Бұл ауырады
Dialogue: 0,0:38:33.43,0:38:36.33,Default,,0,0,0,,Сіз 2500 жыл өмір сүрдіңіз бе?
Dialogue: 0,0:38:36.33,0:38:39.83,Default,,0,0,0,,Әлгі кемпір...
Dialogue: 0,0:38:58.42,0:39:00.42,Default,,0,0,0,,Иә? Ааааааааа!
Dialogue: 0,0:39:08.63,0:39:10.63,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:39:17.00,0:39:19.00,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:39:19.00,0:39:22.44,Default,,0,0,0,,Өлшемдері
Dialogue: 0,0:39:22.44,0:39:25.31,Default,,0,0,0,,Мен сенің өміріңді аяймын.
Dialogue: 0,0:39:25.31,0:39:28.91,Default,,0,0,0,,Ковальскиге немесе Вавилонға қалай бармақшысыз?
Dialogue: 0,0:39:28.91,0:39:31.15,Default,,0,0,0,,Өлеңде айтылғандай
Dialogue: 0,0:39:31.15,0:39:35.02,Default,,0,0,0,,Біз шам жағып, бара аламыз ба? Осындай нәрсе ме?
Dialogue: 0,0:39:35.02,0:39:37.32,Default,,0,0,0,,Иә, бірақ уау.
Dialogue: 0,0:40:06.02,0:40:08.02,Default,,0,0,0,,Chase
Dialogue: 0,0:40:10.19,0:40:12.19,Default,,0,0,0,,Увааааааааааааааааааа
Dialogue: 0,0:40:16.96,0:40:18.96,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:40:27.61,0:40:30.98,Default,,0,0,0,,Йо
Dialogue: 0,0:40:30.98,0:40:32.98,Default,,0,0,0,,Гвааааааааааааааааааааааа
Dialogue: 0,0:40:35.78,0:40:37.72,Default,,0,0,0,,Хмм?
Dialogue: 0,0:40:37.72,0:40:41.09,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:40:41.09,0:40:43.09,Default,,0,0,0,,О
Dialogue: 0,0:40:52.50,0:40:57.00,Default,,0,0,0,,Біз шырақ жағып, бара аламыз ба? Мен үйге барып, бара аламын
Dialogue: 0,0:40:57.00,0:40:59.80,Default,,0,0,0,,Иитомо Ковальски, шырақ жағыңыз!
Dialogue: 0,0:41:02.81,0:41:05.01,Default,,0,0,0,,Уф
Dialogue: 0,0:41:09.58,0:41:11.55,Default,,0,0,0,,Ой
Dialogue: 0,0:41:11.55,0:41:17.22,Default,,0,0,0,,Вааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:41:17.22,0:41:19.96,Default,,0,0,0,,Уф уау
Dialogue: 0,0:41:19.96,0:41:22.86,Default,,0,0,0,,Уау
Dialogue: 0,0:41:22.86,0:41:26.30,Default,,0,0,0,,Жоқ, ха, ха, га, өлшем! Мен сенің сүйектеріңді ерітемін!
Dialogue: 0,0:41:26.30,0:41:29.90,Default,,0,0,0,,Ахаха
Dialogue: 0,0:41:37.78,0:41:40.18,Default,,0,0,0,,Баратын кез келді, өлшем.
Dialogue: 0,0:41:50.32,0:41:54.02,Default,,0,0,0,,Гоемон! Барасыз ба, жоқ па?
Dialogue: 0,0:42:11.28,0:42:13.38,Default,,0,0,0,,Құпия қылыш
Dialogue: 0,0:42:23.46,0:42:25.86,Default,,0,0,0,,О
Dialogue: 0,0:42:30.30,0:42:33.60,Default,,0,0,0,,Бухаха
Dialogue: 0,0:42:33.60,0:42:35.67,Default,,0,0,0,,Үлкен қолдар.
Dialogue: 0,0:42:35.67,0:42:39.41,Default,,0,0,0,,Хек
Dialogue: 0,0:42:39.41,0:42:42.91,Default,,0,0,0,,Кел, Гоемон, бұл жұмыс.
Dialogue: 0,0:43:31.02,0:43:36.40,Default,,0,0,0,,Фуа гра-террині мен бұзау етінен жасалған стейк өте сәнді.
Dialogue: 0,0:43:36.40,0:43:39.10,Default,,0,0,0,,Шарап 1959 Бордо мен Неспер ме?
Dialogue: 0,0:43:39.10,0:43:41.40,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:43:43.70,0:43:47.67,Default,,0,0,0,,Не? Фуа грас террині туралы не деуге болады?
Dialogue: 0,0:43:47.67,0:43:50.48,Default,,0,0,0,,А, майға қуырылған көк шөптер көп.
Dialogue: 0,0:43:50.48,0:43:54.35,Default,,0,0,0,,Сәлем! мен
Dialogue: 0,0:43:54.35,0:43:57.55,Default,,0,0,0,,Дайынсың ба, Чен?
Dialogue: 0,0:44:04.32,0:44:07.23,Default,,0,0,0,,Адамның ойлауы онша ерекшеленбейді.
Dialogue: 0,0:44:07.23,0:44:09.86,Default,,0,0,0,,Мына жігіттерге біреу соққы берсін!
Dialogue: 0,0:44:09.86,0:44:12.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:12.16,0:44:14.70,Default,,0,0,0,,Сен маған қолыңды кісендеймін дейсің бе, инспектор?
Dialogue: 0,0:44:14.70,0:44:18.10,Default,,0,0,0,,Иә, Люпинге арналған кісен.
Dialogue: 0,0:44:27.85,0:44:30.08,Default,,0,0,0,,Алдындағы көлікте 4-5 адам
Dialogue: 0,0:44:30.08,0:44:33.58,Default,,0,0,0,,Арттағы жеңіл автокөлік үшін де солай.
Dialogue: 0,0:44:41.69,0:44:44.39,Default,,0,0,0,,Увааааааааааааааааааа
Dialogue: 0,0:44:46.43,0:44:49.63,Default,,0,0,0,,нихихихихихи
Dialogue: 0,0:44:56.41,0:44:59.41,Default,,0,0,0,,Шарап тізімі. Жеке саяхатқа тыйым салынады.
Dialogue: 0,0:44:59.41,0:45:03.12,Default,,0,0,0,,Алдымен тартыңыз
Dialogue: 0,0:45:03.12,0:45:05.58,Default,,0,0,0,,Бұл да менмін
Dialogue: 0,0:45:05.58,0:45:08.59,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:45:08.59,0:45:10.72,Default,,0,0,0,,Ой-оу.
Dialogue: 0,0:45:10.72,0:45:14.03,Default,,0,0,0,,О ла ла ла ла
Dialogue: 0,0:45:14.03,0:45:16.56,Default,,0,0,0,,Менің сүйікті Гламур-чаным сәйкес келеді
Dialogue: 0,0:45:16.56,0:45:19.20,Default,,0,0,0,,Онда барсам болады ма?
Dialogue: 0,0:45:19.20,0:45:22.57,Default,,0,0,0,,Иә
Dialogue: 0,0:45:22.57,0:45:26.44,Default,,0,0,0,,Тіпті келіңіз
Dialogue: 0,0:45:26.44,0:45:29.31,Default,,0,0,0,,Гухахаха
Dialogue: 0,0:45:29.31,0:45:31.81,Default,,0,0,0,,Бұл ұйықтауға арналған арнайы дәрі.
Dialogue: 0,0:45:45.76,0:45:49.63,Default,,0,0,0,,Келіп орындадың ба? Люпин
Dialogue: 0,0:45:49.63,0:45:52.83,Default,,0,0,0,,Жоооу
Dialogue: 0,0:45:52.83,0:45:54.83,Default,,0,0,0,,нихихихихихи
Dialogue: 0,0:45:57.17,0:46:02.07,Default,,0,0,0,,Сәлем
Dialogue: 0,0:46:02.07,0:46:04.17,Default,,0,0,0,,Ааааан ааан
Dialogue: 0,0:46:08.78,0:46:10.85,Default,,0,0,0,,Ооо
Dialogue: 0,0:46:10.85,0:46:13.02,Default,,0,0,0,,Кя
Dialogue: 0,0:46:13.02,0:46:15.52,Default,,0,0,0,,Не болып жатыр? Ой
Dialogue: 0,0:46:18.36,0:46:20.96,Default,,0,0,0,,Қымбат киіміңді бұзу
Dialogue: 0,0:46:24.03,0:46:27.90,Default,,0,0,0,,Қолыңызды көтеріңіз
Dialogue: 0,0:46:27.90,0:46:30.47,Default,,0,0,0,,Мен ICPO полиция қызметкері Сарандамын.
Dialogue: 0,0:46:30.47,0:46:32.40,Default,,0,0,0,,Мен сені тұтқындап жатырмын.
Dialogue: 0,0:46:32.40,0:46:35.14,Default,,0,0,0,,Kyaah
Dialogue: 0,0:46:35.14,0:46:37.71,Default,,0,0,0,,О
Dialogue: 0,0:46:37.71,0:46:40.35,Default,,0,0,0,,Не болды? а?
Dialogue: 0,0:46:40.35,0:46:42.28,Default,,0,0,0,,Куу фуэн
Dialogue: 0,0:46:42.28,0:46:46.45,Default,,0,0,0,,Кимисама
Dialogue: 0,0:46:46.45,0:46:49.66,Default,,0,0,0,,О? А, жоқ, жоқ, солай болады
Dialogue: 0,0:46:49.66,0:46:53.53,Default,,0,0,0,,Шулы, тынышталып, арқанды беріңізші!
Dialogue: 0,0:46:53.53,0:46:56.36,Default,,0,0,0,,Бұлай істегенше, жолаушыларды эвакуациялаған дұрыс.
Dialogue: 0,0:46:56.36,0:46:58.30,Default,,0,0,0,,Жақсы емес пе? не?
Dialogue: 0,0:46:58.30,0:47:01.00,Default,,0,0,0,,Шынымен бе? Күте тұрыңыз! Люпин
Dialogue: 0,0:47:08.31,0:47:12.68,Default,,0,0,0,,Wow acho acho acho
Dialogue: 0,0:47:12.68,0:47:15.61,Default,,0,0,0,,Ачо
Dialogue: 0,0:47:15.61,0:47:17.61,Default,,0,0,0,,Accio
Dialogue: 0,0:47:24.39,0:47:31.40,Default,,0,0,0,,Естен тану
Dialogue: 0,0:47:31.40,0:47:33.70,Default,,0,0,0,,Менің атым Гоемон.
Dialogue: 0,0:47:35.63,0:47:39.00,Default,,0,0,0,,Ха
Dialogue: 0,0:47:39.00,0:47:41.20,Default,,0,0,0,,Атта
Dialogue: 0,0:47:43.84,0:47:45.91,Default,,0,0,0,,Дааааааааааааааааааааааааааа
Dialogue: 0,0:47:45.91,0:47:47.91,Default,,0,0,0,,Chase!
Dialogue: 0,0:47:51.52,0:47:55.39,Default,,0,0,0,,Күте тұрыңыз, Люпин! Увааааааааааааааа
Dialogue: 0,0:47:55.39,0:47:57.89,Default,,0,0,0,,Менің қашып кетуіме жол берме. Бұл қауіпті.
Dialogue: 0,0:48:00.26,0:48:02.26,Default,,0,0,0,,Люпин!
Dialogue: 0,0:48:08.50,0:48:11.00,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:48:16.14,0:48:20.58,Default,,0,0,0,,Күте тұрыңыз! Сен бейбақ!
Dialogue: 0,0:48:20.58,0:48:23.18,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:48:33.66,0:48:36.36,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:48:36.36,0:48:38.70,Default,,0,0,0,,Таку
Dialogue: 0,0:48:38.70,0:48:41.93,Default,,0,0,0,,Accio
Dialogue: 0,0:48:41.93,0:48:45.13,Default,,0,0,0,,Не? Сіз! Ачо
Dialogue: 0,0:48:47.44,0:48:50.04,Default,,0,0,0,,Люпин қамауға алынды!
Dialogue: 0,0:48:55.91,0:48:57.92,Default,,0,0,0,,О? О
Dialogue: 0,0:48:57.92,0:49:00.52,Default,,0,0,0,,Құт
Dialogue: 0,0:49:00.52,0:49:02.49,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:49:02.49,0:49:05.66,Default,,0,0,0,,О.
Dialogue: 0,0:49:05.66,0:49:08.39,Default,,0,0,0,,Құт
Dialogue: 0,0:49:08.39,0:49:12.30,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:49:12.30,0:49:15.57,Default,,0,0,0,,Кочокочо
Dialogue: 0,0:49:15.57,0:49:18.60,Default,,0,0,0,,Хуаааааааааааааааааааааааааааа
Dialogue: 0,0:49:18.60,0:49:20.87,Default,,0,0,0,,О ла ла ла ла ла
Dialogue: 0,0:49:20.87,0:49:23.68,Default,,0,0,0,,Абайо тоцуан!
Dialogue: 0,0:49:23.68,0:49:27.58,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:49:31.28,0:49:34.85,Default,,0,0,0,,Гоемон
Dialogue: 0,0:49:34.85,0:49:37.52,Default,,0,0,0,,О
Dialogue: 0,0:49:37.52,0:49:41.12,Default,,0,0,0,,Ұмытпаймын, үлкен гүлдей...
Dialogue: 0,0:49:44.10,0:49:46.03,Default,,0,0,0,,Сіз ғашықсыз ба? Гоемон Уф
Dialogue: 0,0:49:46.03,0:49:48.03,Default,,0,0,0,,Нару кіндік
Dialogue: 0,0:49:51.50,0:49:53.90,Default,,0,0,0,,О, құдайым
Dialogue: 0,0:50:01.18,0:50:03.11,Default,,0,0,0,,Поха
Dialogue: 0,0:50:03.11,0:50:05.71,Default,,0,0,0,,Увааааааааааааааааааааааааа
Dialogue: 0,0:50:13.86,0:50:17.13,Default,,0,0,0,,Ова
Dialogue: 0,0:50:17.13,0:50:19.23,Default,,0,0,0,,Доуаах
Dialogue: 0,0:50:27.67,0:50:29.61,Default,,0,0,0,,Ууууууууууу
Dialogue: 0,0:50:29.61,0:50:31.61,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:51:55.49,0:51:59.16,Default,,0,0,0,,Вавилон қирандыларынан тура оңтүстікке қарай қазу.
Dialogue: 0,0:51:59.16,0:52:01.47,Default,,0,0,0,,Итальяндық қазба тобы бар, солай ма?
Dialogue: 0,0:52:01.47,0:52:03.94,Default,,0,0,0,,Капитан – доктор Тартини.
Dialogue: 0,0:52:03.94,0:52:05.87,Default,,0,0,0,,Жоқ? Иә
Dialogue: 0,0:52:05.87,0:52:08.21,Default,,0,0,0,,Ирак монархиясы құлатылғанға дейін
Dialogue: 0,0:52:08.21,0:52:10.54,Default,,0,0,0,,Мартино қорында жұмыс істеген адам.
Dialogue: 0,0:52:10.54,0:52:13.45,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:52:13.45,0:52:17.32,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:52:17.32,0:52:19.55,Default,,0,0,0,,Иә
Dialogue: 0,0:52:19.55,0:52:23.45,Default,,0,0,0,,Бабыл мұнарасы, не! Бабыл мұнарасы? Ахх
Dialogue: 0,0:52:26.02,0:52:28.39,Default,,0,0,0,,Егер бұл Бабыл мұнарасы болса
Dialogue: 0,0:52:28.39,0:52:31.13,Default,,0,0,0,,Ол бұрыннан қазылған болуы керек.
Dialogue: 0,0:52:31.13,0:52:34.47,Default,,0,0,0,,Ескі өсиетте жазылғандай Вавилондағы ғибадатхананың қирандыларында.
Dialogue: 0,0:52:34.47,0:52:37.37,Default,,0,0,0,,Дәл осындай тіркесі бар саз тақтайша табылды.
Dialogue: 0,0:52:37.37,0:52:40.71,Default,,0,0,0,,Бұл Бабыл мұнарасы екені белгілі емес пе?
Dialogue: 0,0:52:40.71,0:52:43.38,Default,,0,0,0,,Бірақ бұл екінші мұнара болды.
Dialogue: 0,0:52:43.38,0:52:46.38,Default,,0,0,0,,Бұл үлкенірек және құрметті.
Dialogue: 0,0:52:46.38,0:52:49.28,Default,,0,0,0,,Тартини осылай айтып тұрған сияқты.
Dialogue: 0,0:52:52.08,0:52:54.42,Default,,0,0,0,,Хмм, Мартино шығар.
Dialogue: 0,0:52:54.42,0:52:56.49,Default,,0,0,0,,Сіз әлі қазынаны таптыңыз ба?
Dialogue: 0,0:52:56.49,0:52:59.32,Default,,0,0,0,,Он мың тонна деп айтпады ма?
Dialogue: 0,0:52:59.32,0:53:02.46,Default,,0,0,0,,Соншалықты ауыр нәрсені қалай көтересің?
Dialogue: 0,0:53:02.46,0:53:06.26,Default,,0,0,0,,Ол жынды, мен оны алу үшін әскерді жылжытуым керек.
Dialogue: 0,0:53:24.32,0:53:26.25,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:53:26.25,0:53:29.55,Default,,0,0,0,,Мен мұндай үлкен болады деп ойламадым.
Dialogue: 0,0:53:32.56,0:53:35.43,Default,,0,0,0,,Екінші мұнара...
Dialogue: 0,0:53:35.43,0:53:38.40,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:53:38.40,0:53:40.70,Default,,0,0,0,,Мен бұл дөңгелек бөлікті күтпедім.
Dialogue: 0,0:53:40.70,0:53:43.30,Default,,0,0,0,,Бұл мұнараның басы емес шығар.
Dialogue: 0,0:53:48.07,0:53:51.74,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:53:51.74,0:53:55.31,Default,,0,0,0,,Иә? Мұнда, бұл жерде
Dialogue: 0,0:53:55.31,0:53:57.35,Default,,0,0,0,,Міне Мартино келеді.
Dialogue: 0,0:53:57.35,0:54:00.95,Default,,0,0,0,,Бұл зерттеу тобын толығымен Марсиано қаржыландырады.
Dialogue: 0,0:54:03.56,0:54:05.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:05.49,0:54:10.33,Default,,0,0,0,,Сәлем, сәлем Тартини
Dialogue: 0,0:54:10.33,0:54:13.43,Default,,0,0,0,,Жарайды, егер сіз мұны жасағыңыз келсе, түнде жасаңыз.
Dialogue: 0,0:54:48.13,0:54:50.83,Default,,0,0,0,,Айтпақшы, Гоемон, сен бұл қапты қалай пайдаланасың?
Dialogue: 0,0:54:53.24,0:54:55.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:55:03.28,0:55:05.58,Default,,0,0,0,,О ла ла ла ла ла ла ла ла.
Dialogue: 0,0:55:08.65,0:55:12.05,Default,,0,0,0,,Ух ватататататататата
Dialogue: 0,0:55:20.27,0:55:23.57,Default,,0,0,0,,Увааааааааааааааааааааааааааа
Dialogue: 0,0:55:29.71,0:55:32.61,Default,,0,0,0,,Жасау
Dialogue: 0,0:55:32.61,0:55:35.35,Default,,0,0,0,,Буин
Dialogue: 0,0:55:35.35,0:55:39.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:45.99,0:55:49.86,Default,,0,0,0,,Увааааааааааааааааааааааааа
Dialogue: 0,0:55:49.86,0:55:51.90,Default,,0,0,0,,Тоқта, тоқта, тоқта, тоқта
Dialogue: 0,0:55:51.90,0:55:54.10,Default,,0,0,0,,Тоқта
Dialogue: 0,0:56:00.51,0:56:02.71,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:56:06.11,0:56:08.55,Default,,0,0,0,,Бұл жігіт өте қонақжай.
Dialogue: 0,0:56:08.55,0:56:12.02,Default,,0,0,0,,Кувабаракувабара Оисаоисаооисаоиса
Dialogue: 0,0:56:12.02,0:56:14.49,Default,,0,0,0,,Ойсай ой саоиса
Dialogue: 0,0:56:14.49,0:56:16.45,Default,,0,0,0,,Хой хойт
Dialogue: 0,0:56:16.45,0:56:19.45,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:56:22.89,0:56:27.49,Default,,0,0,0,,Уау
Dialogue: 0,0:56:29.60,0:56:32.40,Default,,0,0,0,,Иә
Dialogue: 0,0:56:40.81,0:56:42.88,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:56:42.88,0:56:47.29,Default,,0,0,0,,Менің ойымша, ұпай жыртық дегенді білдіреді.
Dialogue: 0,0:56:47.29,0:56:50.89,Default,,0,0,0,,Сонда тағы бір ғана тұзақ бар ма?
Dialogue: 0,0:57:03.57,0:57:05.77,Default,,0,0,0,,Тігін
Dialogue: 0,0:57:11.98,0:57:14.65,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:57:14.65,0:57:17.85,Default,,0,0,0,,Бұл жылдам
Dialogue: 0,0:57:20.99,0:57:24.89,Default,,0,0,0,,Не? Бұл мен ойлағандай емес.
Dialogue: 0,0:57:47.11,0:57:49.91,Default,,0,0,0,,Розетта? Біреу бар ма?
Dialogue: 0,0:57:52.35,0:57:55.15,Default,,0,0,0,,Бұл галлюцинация.
Dialogue: 0,0:58:02.09,0:58:06.09,Default,,0,0,0,,Lupine
Dialogue: 0,0:58:15.37,0:58:17.34,Default,,0,0,0,,Розетта
Dialogue: 0,0:58:17.34,0:58:22.05,Default,,0,0,0,,Мені Құдай бұрыннан пайдаланған.
Dialogue: 0,0:58:22.05,0:58:24.35,Default,,0,0,0,,Мен бұл жерге қондым.
Dialogue: 0,0:58:24.35,0:58:27.79,Default,,0,0,0,,Сол құдай 76 жыл сайын аспаннан келсе.
Dialogue: 0,0:58:27.79,0:58:31.66,Default,,0,0,0,,Бұл құдайдың көлігі сыпырғыш жұлдыз болуы мүмкін бе?
Dialogue: 0,0:58:31.66,0:58:33.93,Default,,0,0,0,,Дұрыс, Люпин.
Dialogue: 0,0:58:33.93,0:58:37.80,Default,,0,0,0,,Мен мұнда мәңгі ұйықтадым
Dialogue: 0,0:58:37.80,0:58:40.37,Default,,0,0,0,,Әр 76 жыл сайын ояныңыз
Dialogue: 0,0:58:40.37,0:58:43.20,Default,,0,0,0,,Жер бетінде кезіп жүру
Dialogue: 0,0:58:43.20,0:58:45.17,Default,,0,0,0,,Мен Вавилонның алтынын іздеймін.
Dialogue: 0,0:58:45.17,0:58:47.84,Default,,0,0,0,,Біртүрлі емес пе? Оны Құдай деп атауға болады.
Dialogue: 0,0:58:47.84,0:58:51.28,Default,,0,0,0,,Сіз қазынаның қайда екенін білмейсіз бе?
Dialogue: 0,0:58:51.28,0:58:54.68,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:59:00.49,0:59:02.52,Default,,0,0,0,,Жылама
Dialogue: 0,0:59:02.52,0:59:05.02,Default,,0,0,0,,Бұрынғы Розетта
Dialogue: 0,0:59:09.69,0:59:12.99,Default,,0,0,0,,Иә...
Dialogue: 0,0:59:17.90,0:59:20.57,Default,,0,0,0,,Вавилон қазынасының құпиясы
Dialogue: 0,0:59:20.57,0:59:23.34,Default,,0,0,0,,Қаз ананың әнін үйретіп жатқаныма сенбеймін
Dialogue: 0,0:59:23.34,0:59:27.04,Default,,0,0,0,,Вавилондықтар да сөз тіркестеріне еліктеген.
Dialogue: 0,0:59:33.15,0:59:35.35,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:59:44.03,0:59:46.33,Default,,0,0,0,,Қауіп
Dialogue: 0,1:00:05.85,1:00:07.95,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,1:00:16.86,1:00:20.06,Default,,0,0,0,,Вавилон алтыны Бұл
Dialogue: 0,1:00:27.51,1:00:30.11,Default,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:00:30.11,1:00:32.04,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:00:32.04,1:00:35.08,Default,,0,0,0,,Мініп жүр, кеттік.
Dialogue: 0,1:00:35.08,1:00:38.38,Default,,0,0,0,,Рахмет
Dialogue: 0,1:00:38.38,1:00:42.25,Default,,0,0,0,,Рахмет
Dialogue: 0,1:00:42.25,1:00:44.19,Default,,0,0,0,,Тұйық
Dialogue: 0,1:00:44.19,1:00:47.69,Default,,0,0,0,,Рахмет
Dialogue: 0,1:00:47.69,1:00:50.29,Default,,0,0,0,,Сәттілік
Dialogue: 0,1:00:50.29,1:00:54.29,Default,,0,0,0,,Рахмет
Dialogue: 0,1:00:57.07,1:00:59.67,Default,,0,0,0,,Такара такара
Dialogue: 0,1:00:59.67,1:01:08.38,Default,,0,0,0,,Рахмет
Dialogue: 0,1:01:08.38,1:01:10.48,Default,,0,0,0,,Такарааааааааааааааааааа
Dialogue: 0,1:01:26.76,1:01:31.06,Default,,0,0,0,,Әй, күрес бітпейді, ауырады.
Dialogue: 0,1:01:33.84,1:01:36.54,Default,,0,0,0,,Сіз оны таптыңыз ба? иә?
Dialogue: 0,1:01:39.28,1:01:41.78,Default,,0,0,0,,Бұл Вавилонның алтыны ма?
Dialogue: 0,1:01:45.45,1:01:47.65,Default,,0,0,0,,Қайтыс болған әкемнің атынан рахмет айтайық.
Dialogue: 0,1:01:51.59,1:01:54.29,Default,,0,0,0,,Сіздің рөліңіз аяқталды. Жолдан кет.
Dialogue: 0,1:01:58.03,1:01:59.96,Default,,0,0,0,,Жарайды, кел.
Dialogue: 0,1:01:59.96,1:02:03.30,Default,,0,0,0,,Бұл мен армандаған Вавилон қазынасы.
Dialogue: 0,1:02:03.30,1:02:05.57,Default,,0,0,0,,О
Dialogue: 0,1:02:05.57,1:02:09.74,Default,,0,0,0,,Сіз алтын немесе гауһар шарды қабылдаймын дедіңіз, Люпин-чан.
Dialogue: 0,1:02:09.74,1:02:12.78,Default,,0,0,0,,Қараңыз!
Dialogue: 0,1:02:12.78,1:02:16.31,Default,,0,0,0,,Мен оны ерекше ету үшін бар күшімді салдым.
Dialogue: 0,1:02:16.31,1:02:18.28,Default,,0,0,0,,Lupine
Dialogue: 0,1:02:18.28,1:02:20.38,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:02:29.63,1:02:31.73,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,1:02:40.04,1:02:41.97,Default,,0,0,0,,Түсіру
Dialogue: 0,1:02:41.97,1:02:43.97,Default,,0,0,0,,Батпырауқұлаққа міну
Dialogue: 0,1:02:46.14,1:02:50.01,Default,,0,0,0,,Сегізаяқ
Dialogue: 0,1:02:50.01,1:02:54.59,Default,,0,0,0,,Жеңілу көңілсіз.
Dialogue: 0,1:02:54.59,1:02:56.69,Default,,0,0,0,,Әзірге
Dialogue: 0,1:03:02.96,1:03:05.06,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:03:16.34,1:03:19.24,Default,,0,0,0,,Елдегі бар алтынды жинап, жасасам ше?
Dialogue: 0,1:03:19.24,1:03:21.61,Default,,0,0,0,,Аздап
Dialogue: 0,1:03:21.61,1:03:24.88,Default,,0,0,0,,Жарайды…
Dialogue: 0,1:03:24.88,1:03:26.82,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,1:03:26.82,1:03:29.69,Default,,0,0,0,,Бұл Евфрат өзені.
Dialogue: 0,1:03:29.69,1:03:32.66,Default,,0,0,0,,Бұл жерде адамзаттың алғашқы өркениеті дүниеге келген.
Dialogue: 0,1:03:32.66,1:03:36.19,Default,,0,0,0,,5000 жыл бұрын...
Dialogue: 0,1:03:36.19,1:03:40.63,Default,,0,0,0,,Сәлем
Dialogue: 0,1:03:40.63,1:03:43.00,Default,,0,0,0,,Гяаа
Dialogue: 0,1:03:43.00,1:03:46.87,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,1:03:46.87,1:03:49.17,Default,,0,0,0,,Кім осындай жамандық жасайды!
Dialogue: 0,1:03:53.08,1:03:55.08,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,1:04:14.70,1:04:17.94,Default,,0,0,0,,Хмммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,1:04:17.94,1:04:21.81,Default,,0,0,0,,Оны қалай шығаруға болады? Сіз оны қайда апаруды жоспарлап отырсыз?
Dialogue: 0,1:04:21.81,1:04:23.81,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,1:04:26.54,1:04:29.98,Default,,0,0,0,,Неге осы елдің президентіне апармайсың?
Dialogue: 0,1:04:29.98,1:04:32.05,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,1:04:32.05,1:04:35.59,Default,,0,0,0,,Сонда көктем, мен көп шарап сатып аламын.
Dialogue: 0,1:04:35.59,1:04:37.52,Default,,0,0,0,,Олай жасасаң, қамауға аласың.
Dialogue: 0,1:04:37.52,1:04:40.49,Default,,0,0,0,,Ол қазірдің өзінде шешілді, солай ма? Не?
Dialogue: 0,1:04:40.49,1:04:43.09,Default,,0,0,0,,Оны маған қалдырыңыз.
Dialogue: 0,1:04:58.84,1:05:03.15,Default,,0,0,0,,Меніңше, әрекет ететін уақыт емес.
Dialogue: 0,1:05:03.15,1:05:05.08,Default,,0,0,0,,Мұндай қабілетсіз адамның астында
Dialogue: 0,1:05:05.08,1:05:07.59,Default,,0,0,0,,Мен Люпинді ұстай алмаймын.
Dialogue: 0,1:05:07.59,1:05:10.02,Default,,0,0,0,,Дұрыс, сенің істегенің ебедейсіз, ақымақтық.
Dialogue: 0,1:05:10.02,1:05:12.99,Default,,0,0,0,,Мен анпонтандық болғандықтан, мен кейде осырамын.
Dialogue: 0,1:05:12.99,1:05:15.09,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,1:05:18.73,1:05:20.73,Default,,0,0,0,,Көлік келді.
Dialogue: 0,1:05:25.50,1:05:27.60,Default,,0,0,0,,Бұл не өзі? Бұл кішкентай ит
Dialogue: 0,1:05:30.37,1:05:33.28,Default,,0,0,0,,Маған су мен май беріңізші.
Dialogue: 0,1:05:33.28,1:05:37.72,Default,,0,0,0,,Қиындық болмас үшін маған қалдырыңызшы.
Dialogue: 0,1:05:37.72,1:05:41.22,Default,,0,0,0,,Хаайы
Dialogue: 0,1:05:41.22,1:05:45.19,Default,,0,0,0,,Хаау
Dialogue: 0,1:05:45.19,1:05:47.69,Default,,0,0,0,,Умм Харашо
Dialogue: 0,1:05:50.90,1:05:55.37,Default,,0,0,0,,Эй, сен не ойлап тұрсың?
Dialogue: 0,1:05:55.37,1:05:57.64,Default,,0,0,0,,Жоқ
Dialogue: 0,1:05:57.64,1:05:59.97,Default,,0,0,0,,Мен адамдардың мұны асыра сілтеу деп қабылдап, бұл қиындық деп айтқанын қаламаймын.
Dialogue: 0,1:05:59.97,1:06:02.37,Default,,0,0,0,,Үйге жаяу бар! Эй!
Dialogue: 0,1:06:09.05,1:06:13.25,Default,,0,0,0,,Бұл жай ғана кездейсоқтық
Dialogue: 0,1:06:13.25,1:06:17.92,Default,,0,0,0,,Эй
Dialogue: 0,1:06:17.92,1:06:22.02,Default,,0,0,0,,Арыстан мүсінін қайтар. Қарсылық танытсаң, өміріңді жоғалтасың.
Dialogue: 0,1:06:28.57,1:06:31.44,Default,,0,0,0,,Мм! Хаа
Dialogue: 0,1:06:31.44,1:06:35.11,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:35.11,1:06:37.11,Default,,0,0,0,,Аняр
Dialogue: 0,1:06:59.43,1:07:01.83,Default,,0,0,0,,Жаман ба?
Dialogue: 0,1:07:20.89,1:07:22.99,Default,,0,0,0,,Уау
Dialogue: 0,1:07:25.59,1:07:28.39,Default,,0,0,0,,Айтпақшы, Венецияға жеткеннен кейін нұсқауларың аяқталады.»
Dialogue: 0,1:07:36.00,1:07:38.77,Default,,0,0,0,,Эй, тоқта!
Dialogue: 0,1:07:38.77,1:07:41.47,Default,,0,0,0,,Міне.
Dialogue: 0,1:07:41.47,1:07:43.47,Default,,0,0,0,,На
Dialogue: 0,1:08:01.73,1:08:03.66,Default,,0,0,0,,Мұнда Кувейт әскері бар сияқты.
Dialogue: 0,1:08:03.66,1:08:05.66,Default,,0,0,0,,Мен неге екенін білмеймін
Dialogue: 0,1:08:08.63,1:08:11.13,Default,,0,0,0,,Деде де де де
Dialogue: 0,1:08:18.18,1:08:20.18,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:23.05,1:08:26.75,Default,,0,0,0,,Ах! Ухихихихи
Dialogue: 0,1:08:26.75,1:08:28.85,Default,,0,0,0,,Мылтық
Dialogue: 0,1:08:36.06,1:08:38.16,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:08:50.01,1:08:53.51,Default,,0,0,0,,Мен сіздің өтінішіңізді қабылдаймын.
Dialogue: 0,1:08:53.51,1:08:55.61,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,1:08:59.22,1:09:01.32,Default,,0,0,0,,Сора
Dialogue: 0,1:09:05.62,1:09:09.29,Default,,0,0,0,,Б-бірақ… сәби аман.
Dialogue: 0,1:09:09.29,1:09:12.23,Default,,0,0,0,,Сәтсіз қалдыңыз.
Dialogue: 0,1:09:12.23,1:09:14.33,Default,,0,0,0,,Жоқ
Dialogue: 0,1:09:17.57,1:09:20.47,Default,,0,0,0,,Kyaah
Dialogue: 0,1:09:20.47,1:09:24.94,Default,,0,0,0,,Уау
Dialogue: 0,1:09:24.94,1:09:27.51,Default,,0,0,0,,Жарайсың
Dialogue: 0,1:09:27.51,1:09:32.35,Default,,0,0,0,,Гүлдерді Зантецукенмен кесуге болмайды
Dialogue: 0,1:09:32.35,1:09:35.75,Default,,0,0,0,,Бұл – Шығыстың жұмбағы.
Dialogue: 0,1:09:35.75,1:09:39.62,Default,,0,0,0,,Иә
Dialogue: 0,1:09:39.62,1:09:42.19,Default,,0,0,0,,Мен атпаймын. Мен түсіруге уәде беремін.
Dialogue: 0,1:09:42.19,1:09:45.49,Default,,0,0,0,,бастап
Dialogue: 0,1:09:48.57,1:09:51.94,Default,,0,0,0,,Мұнда
Dialogue: 0,1:09:51.94,1:09:54.20,Default,,0,0,0,,Жоқ десем де
Dialogue: 0,1:09:54.20,1:09:56.27,Default,,0,0,0,,На
Dialogue: 0,1:09:56.27,1:10:00.01,Default,,0,0,0,,Тамағымды тістеп алды.
Dialogue: 0,1:10:00.01,1:10:02.45,Default,,0,0,0,,Сенің басың қирап қалды ма?
Dialogue: 0,1:10:02.45,1:10:06.65,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,1:10:06.65,1:10:08.69,Default,,0,0,0,,Тыныш және зәр шығару.
Dialogue: 0,1:10:08.69,1:10:11.29,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,1:10:11.29,1:10:15.29,Default,,0,0,0,,Шық!
Dialogue: 0,1:10:15.29,1:10:18.19,Default,,0,0,0,,Жақсы көздеп, ату
Dialogue: 0,1:10:42.25,1:10:44.35,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,1:10:47.22,1:10:50.56,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,1:10:50.56,1:10:52.56,Default,,0,0,0,,Не?
Dialogue: 0,1:10:55.20,1:10:57.90,Default,,0,0,0,,Әулиелердің көпшілігі
Dialogue: 0,1:11:02.84,1:11:06.58,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:11:06.58,1:11:09.55,Default,,0,0,0,,Иә
Dialogue: 0,1:11:09.55,1:11:12.12,Default,,0,0,0,,Қ-қалайша?
Dialogue: 0,1:11:12.12,1:11:14.35,Default,,0,0,0,,Ei?
Dialogue: 0,1:11:14.35,1:11:16.75,Default,,0,0,0,,Бұл кездейсоқ болуы мүмкін.
Dialogue: 0,1:11:16.75,1:11:21.53,Default,,0,0,0,,Мен бар деп ойладым, хахаха
Dialogue: 0,1:11:21.53,1:11:24.06,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,1:11:24.06,1:11:26.50,Default,,0,0,0,,Сенімге ие бол
Dialogue: 0,1:11:26.50,1:11:29.50,Default,,0,0,0,,Иә
Dialogue: 0,1:11:29.50,1:11:32.64,Default,,0,0,0,,Батып алайық. Батып алайық.
Dialogue: 0,1:11:32.64,1:11:35.34,Default,,0,0,0,,Тапсырма
Dialogue: 0,1:11:40.01,1:11:43.61,Default,,0,0,0,,Гоемон
Dialogue: 0,1:11:50.62,1:11:52.72,Default,,0,0,0,,О
Dialogue: 0,1:11:55.53,1:11:58.26,Default,,0,0,0,,Люпин!
Dialogue: 0,1:11:58.26,1:12:00.36,Default,,0,0,0,,Мукка
Dialogue: 0,1:12:10.57,1:12:12.58,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:12.58,1:12:15.25,Default,,0,0,0,,Ол ит болса да, тым оғаш кішкентай жаратылыс.
Dialogue: 0,1:12:15.25,1:12:18.45,Default,,0,0,0,,Кора
Dialogue: 0,1:12:22.99,1:12:26.69,Default,,0,0,0,,Ол Кувейт төңірегінде өте бай адамдарды баурап алған болуы керек.
Dialogue: 0,1:12:26.69,1:12:29.03,Default,,0,0,0,,Қазынаны жинау кезінде
Dialogue: 0,1:12:29.03,1:12:32.63,Default,,0,0,0,,Менің ойымша, бұл сәнді кемеде бүкіл әлем бойынша саяхаттың өлшемі.
Dialogue: 0,1:12:32.63,1:12:35.00,Default,,0,0,0,,Жақсы
Dialogue: 0,1:12:35.00,1:12:37.27,Default,,0,0,0,,Көңіліңіз қалмады ма, Люпин?
Dialogue: 0,1:12:37.27,1:12:39.80,Default,,0,0,0,,Кем дегенде Фудзико
Dialogue: 0,1:12:39.80,1:12:44.14,Default,,0,0,0,,Келесі үлкен жұмысқа
Dialogue: 0,1:12:44.14,1:12:47.95,Default,,0,0,0,,Иә? Келесі үлкен жұмыс? О
Dialogue: 0,1:12:47.95,1:12:51.92,Default,,0,0,0,,Вавилонның қазынасы соншалықты кішкентай болуы мүмкін емес.
Dialogue: 0,1:12:51.92,1:12:55.42,Default,,0,0,0,,Тағы да көп нәрсе істеуге болады.
Dialogue: 0,1:12:55.42,1:12:58.46,Default,,0,0,0,,Не? бұл қайда
Dialogue: 0,1:12:58.46,1:13:02.89,Default,,0,0,0,,Ақыры маған бір ой келді.
Dialogue: 0,1:13:02.89,1:13:06.69,Default,,0,0,0,,Нью-Йорк қай жерде?
Dialogue: 0,1:13:16.44,1:13:18.54,Default,,0,0,0,,Иә.
Dialogue: 0,1:13:41.03,1:13:44.50,Default,,0,0,0,,Фудзико, уәдеңді орындайсың ба?
Dialogue: 0,1:13:44.50,1:13:46.90,Default,,0,0,0,,Тіпті ұйықтап қалғаннан кейін де, кем дегенде—
Dialogue: 0,1:13:49.67,1:13:51.67,Default,,0,0,0,,Га
Dialogue: 0,1:14:38.16,1:14:42.26,Default,,0,0,0,,Не?
Dialogue: 0,1:14:42.26,1:14:44.90,Default,,0,0,0,,Не? Мұнда не үшін келдің?
Dialogue: 0,1:14:44.90,1:14:49.00,Default,,0,0,0,,Біз қазынаны қайтарамыз деп шешкеніне сенімдімін.
Dialogue: 0,1:14:51.64,1:14:53.87,Default,,0,0,0,,Қайырлы таң, Гойт мырза.
Dialogue: 0,1:14:53.87,1:14:57.67,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,1:14:57.67,1:14:59.61,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,1:14:59.61,1:15:01.98,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,1:15:01.98,1:15:04.61,Default,,0,0,0,,Сонымен
Dialogue: 0,1:15:04.61,1:15:06.55,Default,,0,0,0,,Түсіндің бе, Андерстерн?
Dialogue: 0,1:15:06.55,1:15:09.32,Default,,0,0,0,,Хе-е-е, бұзатын кез келді.
Dialogue: 0,1:15:09.32,1:15:11.72,Default,,0,0,0,,Оқиға
Dialogue: 0,1:15:13.76,1:15:17.19,Default,,0,0,0,,Өлтір, өлтір, өлтір!
Dialogue: 0,1:15:17.19,1:15:19.20,Default,,0,0,0,,Себебі мен оны саған бермеймін.
Dialogue: 0,1:15:19.20,1:15:21.60,Default,,0,0,0,,Себебі мен оны ешкімге бермеймін
Dialogue: 0,1:15:28.81,1:15:31.01,Default,,0,0,0,,Мама
Dialogue: 0,1:15:37.85,1:15:39.85,Default,,0,0,0,,Білемін, білемін!
Dialogue: 0,1:15:47.36,1:15:49.63,Default,,0,0,0,,Екінші буын оны үш рет айтты.
Dialogue: 0,1:15:49.63,1:15:51.90,Default,,0,0,0,,Өлтіру, өлтіру, өлтіру.
Dialogue: 0,1:15:51.90,1:15:54.80,Default,,0,0,0,,Тек орындаңыз.
Dialogue: 0,1:15:54.80,1:15:58.67,Default,,0,0,0,,Майк, айтар сөзің бар ма?
Dialogue: 0,1:15:58.67,1:16:01.57,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,1:16:01.57,1:16:04.98,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:16:04.98,1:16:07.04,Default,,0,0,0,,Екі рет
Dialogue: 0,1:16:07.04,1:16:09.28,Default,,0,0,0,,Үшінші рет Дайсуке Джиген.
Dialogue: 0,1:16:09.28,1:16:12.25,Default,,0,0,0,,Оның қасында жүріп өлтіре алмадың.
Dialogue: 0,1:16:12.25,1:16:14.48,Default,,0,0,0,,Иә
Dialogue: 0,1:16:14.48,1:16:17.78,Default,,0,0,0,,Қозғалма, есегіңде шыбын бар.
Dialogue: 0,1:16:35.77,1:16:37.77,Default,,0,0,0,,Тазалау
Dialogue: 0,1:17:38.40,1:17:40.70,Default,,0,0,0,,Төменде
Dialogue: 0,1:17:54.85,1:17:56.95,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:18:01.76,1:18:05.50,Default,,0,0,0,,Өлшемге қараңыз
Dialogue: 0,1:18:05.50,1:18:08.70,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,1:18:08.70,1:18:11.47,Default,,0,0,0,,Мен таптым!
Dialogue: 0,1:18:11.47,1:18:14.50,Default,,0,0,0,,Бұл кім? Бұл Вавилонның алтыны ма?
Dialogue: 0,1:18:14.50,1:18:18.74,Default,,0,0,0,,Гуфуфу Гахахаха Аххахаха
Dialogue: 0,1:18:18.74,1:18:22.95,Default,,0,0,0,,Люпин жақсы ма?
Dialogue: 0,1:18:22.95,1:18:24.88,Default,,0,0,0,,Айтпақшы, оның осында екенін қайдан білдің?
Dialogue: 0,1:18:24.88,1:18:27.72,Default,,0,0,0,,Эй, Manhattan Documents туралы не деуге болады?
Dialogue: 0,1:18:27.72,1:18:30.25,Default,,0,0,0,,Дөңгелектерге шашылғанын байқадым.
Dialogue: 0,1:18:30.25,1:18:32.92,Default,,0,0,0,,Шеңбердің ортасын қазсаң, бірдеңе шығып қалар.
Dialogue: 0,1:18:32.92,1:18:35.02,Default,,0,0,0,,Мен солай ойладым
Dialogue: 0,1:18:45.37,1:18:47.84,Default,,0,0,0,,Оның бетіне жазылған сына әріптері
Dialogue: 0,1:18:47.84,1:18:49.84,Default,,0,0,0,,Мөрге ұқсап, жан-жаққа ұшып бара жатты.
Dialogue: 0,1:18:49.84,1:18:52.61,Default,,0,0,0,,Мен болжам жасадым.
Dialogue: 0,1:18:52.61,1:18:55.01,Default,,0,0,0,,О
Dialogue: 0,1:19:00.42,1:19:02.99,Default,,0,0,0,,Сонымен
Dialogue: 0,1:19:02.99,1:19:05.79,Default,,0,0,0,,Бабылдың алтын мұнарасы Вавилон қирандыларынан шыққан.
Dialogue: 0,1:19:05.79,1:19:10.93,Default,,0,0,0,,Дәл солай
Dialogue: 0,1:19:10.93,1:19:14.70,Default,,0,0,0,,Оны кім көтерді? Мен білмеймін. Мен білмеймін.
Dialogue: 0,1:19:14.70,1:19:16.63,Default,,0,0,0,,2500 жыл бұрын
Dialogue: 0,1:19:16.63,1:19:20.50,Default,,0,0,0,,Қандай көлік болғанын білмеймін.
Dialogue: 0,1:19:20.50,1:19:23.41,Default,,0,0,0,,Жарайды…
Dialogue: 0,1:19:23.41,1:19:27.14,Default,,0,0,0,,Сіз жек көретін нәрсе пайда болады.
Dialogue: 0,1:19:27.14,1:19:29.94,Default,,0,0,0,,Мен шыныаяқ алғым келеді.
Dialogue: 0,1:19:33.82,1:19:36.52,Default,,0,0,0,,Уақыт жоқ. Өлшем уақыты?
Dialogue: 0,1:19:36.52,1:19:39.52,Default,,0,0,0,,Жақында шетелдіктер бұл жігітті алуға келеді.
Dialogue: 0,1:19:39.52,1:19:41.96,Default,,0,0,0,,Иә
Dialogue: 0,1:19:41.96,1:19:45.26,Default,,0,0,0,,Не? Розетта әже осылай деді.
Dialogue: 0,1:19:45.26,1:19:49.67,Default,,0,0,0,,Әр 76 жыл сайын жарқырап тұратын Бабыл мұнарасын тұрғызайық.
Dialogue: 0,1:19:49.67,1:19:51.90,Default,,0,0,0,,76 жыл сайын келеді
Dialogue: 0,1:19:51.90,1:19:53.90,Default,,0,0,0,,Сыпыртқы жұлдызы бар
Dialogue: 0,1:19:53.90,1:19:56.00,Default,,0,0,0,,Галлей кометасы?
Dialogue: 0,1:20:00.28,1:20:03.98,Default,,0,0,0,,Галлей кометасы Жерге ең жақын орналасқан.
Dialogue: 0,1:20:03.98,1:20:06.72,Default,,0,0,0,,Ертең түнде сағат 11.
Dialogue: 0,1:20:06.72,1:20:09.22,Default,,0,0,0,,25 сағат қалды
Dialogue: 0,1:20:30.07,1:20:33.64,Default,,0,0,0,,Осының бәрін алтын деп ойлаймын.
Dialogue: 0,1:20:33.64,1:20:35.58,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,1:20:35.58,1:20:39.45,Default,,0,0,0,,Жоқ, бұл біраз күлкілі көріне бастады.
Dialogue: 0,1:20:39.45,1:20:41.85,Default,,0,0,0,,Жетеді.
Dialogue: 0,1:20:41.85,1:20:43.82,Default,,0,0,0,,Қайық
Dialogue: 0,1:20:43.82,1:20:48.69,Default,,0,0,0,,А, мен одан да стакан алғым келеді.
Dialogue: 0,1:20:48.69,1:20:50.79,Default,,0,0,0,,Бұл да рас.
Dialogue: 0,1:21:07.94,1:21:10.41,Default,,0,0,0,,Йо
Dialogue: 0,1:21:10.41,1:21:12.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:14.32,1:21:16.42,Default,,0,0,0,,Әй?
Dialogue: 0,1:21:24.26,1:21:27.96,Default,,0,0,0,,Жоқ
Dialogue: 0,1:21:34.60,1:21:36.61,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,1:21:36.61,1:21:39.01,Default,,0,0,0,,Уау
Dialogue: 0,1:21:44.78,1:21:48.35,Default,,0,0,0,,Бұл жерде қалуға болады ма? 76-шы жыл
Dialogue: 0,1:21:48.35,1:21:51.05,Default,,0,0,0,,Ертең.
Dialogue: 0,1:21:51.05,1:21:54.09,Default,,0,0,0,,Сіз жарқыраған мұнараның қайда екенін білесіз бе?
Dialogue: 0,1:21:54.09,1:21:57.09,Default,,0,0,0,,Бұл Madison Square Garden.
Dialogue: 0,1:22:01.53,1:22:03.73,Default,,0,0,0,,Иә, рахмет.
Dialogue: 0,1:22:06.37,1:22:09.94,Default,,0,0,0,,Фуджиконы Марсиано ұстады.
Dialogue: 0,1:22:09.94,1:22:12.04,Default,,0,0,0,,Не?
Dialogue: 0,1:22:15.15,1:22:17.25,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,1:22:49.55,1:22:51.55,Default,,0,0,0,,Фудзико Фудзико!
Dialogue: 0,1:23:00.19,1:23:02.49,Default,,0,0,0,,Ашық күнжіт
Dialogue: 0,1:23:15.17,1:23:17.17,Default,,0,0,0,,Фудзико
Dialogue: 0,1:23:24.51,1:23:27.81,Default,,0,0,0,,Мен сені күттім, Люпин.
Dialogue: 0,1:23:30.85,1:23:33.39,Default,,0,0,0,,Хаджикиді тастаңыз
Dialogue: 0,1:23:33.39,1:23:35.36,Default,,0,0,0,,Мына жігітті көрмейсің бе?
Dialogue: 0,1:23:35.36,1:23:37.69,Default,,0,0,0,,Бұл
Dialogue: 0,1:23:37.69,1:23:41.90,Default,,0,0,0,,Бұл 100 метр шаршыны ұшырып әкете алатын қуатты бомба.
Dialogue: 0,1:23:41.90,1:23:44.40,Default,,0,0,0,,Мені қорқытуды доғар. Бұл сіз істеп жатқан нәрсе.
Dialogue: 0,1:23:44.40,1:23:47.87,Default,,0,0,0,,Жарайсыңдар
Dialogue: 0,1:23:47.87,1:23:49.87,Default,,0,0,0,,Сіз мұны ешқашан жасамауыңыз керек.
Dialogue: 0,1:24:02.99,1:24:06.52,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,1:24:06.52,1:24:08.49,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:08.49,1:24:10.99,Default,,0,0,0,,Бүгіннен бастап мен Манхэттенге жауапты боламын!
Dialogue: 0,1:24:31.98,1:24:35.65,Default,,0,0,0,,Мен бұл ғимараттың жобасын өзімнің алдыңғышыммен бірге жасадым.
Dialogue: 0,1:24:35.65,1:24:38.89,Default,,0,0,0,,Мұндағыдан да қызықты жерлер бар.
Dialogue: 0,1:24:38.89,1:24:41.89,Default,,0,0,0,,Мен сізге жол көрсетуге рұқсат етіңіз, бұл дүниенің соңғы көрінісі.
Dialogue: 0,1:24:45.13,1:24:47.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:25:09.39,1:25:11.65,Default,,0,0,0,,...
Dialogue: 0,1:25:11.65,1:25:14.32,Default,,0,0,0,,Қап-қара өзен ағып жатыр.
Dialogue: 0,1:25:14.32,1:25:17.16,Default,,0,0,0,,Сендер де осы жерде өлім жазасына кесілген құрттарсыңдар.
Dialogue: 0,1:25:17.16,1:25:19.16,Default,,0,0,0,,Бір жерде кездесеміз.
Dialogue: 0,1:25:23.37,1:25:25.37,Default,,0,0,0,,Гяаа
Dialogue: 0,1:25:44.39,1:25:46.49,Default,,0,0,0,,О
Dialogue: 0,1:25:58.90,1:26:01.57,Default,,0,0,0,,Бұл қай жерде? Бабыл мұнарасының ішінде
Dialogue: 0,1:26:01.57,1:26:04.27,Default,,0,0,0,,Бабылдың алтын мұнарасы, иә?
Dialogue: 0,1:26:15.18,1:26:17.82,Default,,0,0,0,,Бұл сіз сирек көретін декорация.
Dialogue: 0,1:26:17.82,1:26:19.76,Default,,0,0,0,,Розетта әжені де бұрышқа отырғызба.
Dialogue: 0,1:26:19.76,1:26:21.76,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,1:26:25.56,1:26:28.26,Default,,0,0,0,,Мен мұның не екенін білмеймін, о
Dialogue: 0,1:26:31.73,1:26:34.77,Default,,0,0,0,,Эй
Dialogue: 0,1:26:34.77,1:26:37.44,Default,,0,0,0,,Бір кездері
Dialogue: 0,1:26:37.44,1:26:40.01,Default,,0,0,0,,Вавилондағы барлық алтынды жинаңыз
Dialogue: 0,1:26:40.01,1:26:42.51,Default,,0,0,0,,Ол адамдарға мұнара тұрғызды.
Dialogue: 0,1:26:44.75,1:26:47.65,Default,,0,0,0,,Құдай сыпырғыш жұлдызға мініп келді
Dialogue: 0,1:26:47.65,1:26:52.39,Default,,0,0,0,,Аспанға дейін
Dialogue: 0,1:26:52.39,1:26:55.59,Default,,0,0,0,,Алайда мен соққының не екенін білмеймін.
Dialogue: 0,1:26:55.59,1:26:59.80,Default,,0,0,0,,Мен оны жолда түсіріп алдым деп ойлаймын.
Dialogue: 0,1:26:59.80,1:27:04.10,Default,,0,0,0,,Онда
Dialogue: 0,1:27:04.10,1:27:06.10,Default,,0,0,0,,Содан кейін 2000 жыл
Dialogue: 0,1:27:06.10,1:27:09.31,Default,,0,0,0,,Тұрғындар
Dialogue: 0,1:27:09.31,1:27:14.68,Default,,0,0,0,,Нью-Йорк деген қалаға айналды. Міне бітті.
Dialogue: 0,1:27:14.68,1:27:17.78,Default,,0,0,0,,Бұл Бабыл мұнарасы хехехе
Dialogue: 0,1:27:20.88,1:27:23.69,Default,,0,0,0,,Құдай неге алтынды ұрламақ болды?
Dialogue: 0,1:27:23.69,1:27:26.39,Default,,0,0,0,,Маған ұнайды. Сіз оны не үшін пайдаланасыз?
Dialogue: 0,1:27:26.39,1:27:29.29,Default,,0,0,0,,Сіз оны ақшаға пайдаланбайсыз ба?
Dialogue: 0,1:27:29.29,1:27:31.56,Default,,0,0,0,,Құдай ақшаны да жұмсайды
Dialogue: 0,1:27:31.56,1:27:34.46,Default,,0,0,0,,Сіз оны не үшін пайдаланасыз?
Dialogue: 0,1:27:34.46,1:27:38.33,Default,,0,0,0,,1-мақсат: Сәтті тіркелу – Орындалды
Dialogue: 0,1:27:38.33,1:27:40.34,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені сатып алғанда не істейсіз?
Dialogue: 0,1:27:40.34,1:27:42.64,Default,,0,0,0,,Мен оны жеймін.
Dialogue: 0,1:27:42.64,1:27:44.94,Default,,0,0,0,,Әй, менің.
Dialogue: 0,1:27:52.22,1:27:54.52,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,1:27:58.52,1:28:01.42,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:01.42,1:28:03.96,Default,,0,0,0,,Угугу
Dialogue: 0,1:28:03.96,1:28:05.96,Default,,0,0,0,,Ауырды
Dialogue: 0,1:28:23.01,1:28:25.25,Default,,0,0,0,,Раббым!
Dialogue: 0,1:28:25.25,1:28:27.25,Default,,0,0,0,,Бірінші
Dialogue: 0,1:28:57.31,1:28:59.41,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,1:29:17.40,1:29:20.84,Default,,0,0,0,,Фудзико, жақсысың ба?
Dialogue: 0,1:29:20.84,1:29:22.87,Default,,0,0,0,,Эй
Dialogue: 0,1:29:22.87,1:29:25.44,Default,,0,0,0,,Не, Вавилон алтыны?
Dialogue: 0,1:29:25.44,1:29:28.54,Default,,0,0,0,,Ей, жұлдыздарға қарап неге бұл туралы ойламайсың?
Dialogue: 0,1:30:56.40,1:30:59.87,Default,,0,0,0,,Құдай дегеніміз не?
Dialogue: 0,1:30:59.87,1:31:02.91,Default,,0,0,0,,Әй, алтын Бабыл мұнарасы көкке көтерілді
Dialogue: 0,1:31:02.91,1:31:05.68,Default,,0,0,0,,Не деген ысырап, тамаша көрініс емес пе?
Dialogue: 0,1:31:05.68,1:31:08.64,Default,,0,0,0,,Саусақтарыңды аузыңа салып маған қарап тұрсың ба?
Dialogue: 0,1:31:08.64,1:31:12.75,Default,,0,0,0,,Ұры!
Dialogue: 0,1:31:12.75,1:31:16.72,Default,,0,0,0,,Эй Люпин, Цезарьдың заттары Цезарьға барады.
Dialogue: 0,1:31:16.72,1:31:19.09,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:31:19.09,1:31:21.09,Default,,0,0,0,,Бұл менікі
Dialogue: 0,1:31:25.93,1:31:28.03,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:31:30.80,1:31:32.80,Default,,0,0,0,,Иә
Dialogue: 0,1:31:46.52,1:31:48.62,Default,,0,0,0,,Хой
Dialogue: 0,1:31:59.66,1:32:01.60,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,1:32:01.60,1:32:04.20,Default,,0,0,0,,Хой
Dialogue: 0,1:32:22.82,1:32:26.32,Default,,0,0,0,,Рахмет
Dialogue: 0,1:32:26.32,1:32:28.62,Default,,0,0,0,,Біреулер мені құдай дейтін.
Dialogue: 0,1:32:28.62,1:32:32.06,Default,,0,0,0,,Жоғалған Бабыл мұнарасын табу
Dialogue: 0,1:32:32.06,1:32:34.96,Default,,0,0,0,,Мен Жерге жіберілдім.
Dialogue: 0,1:32:34.96,1:32:39.80,Default,,0,0,0,,Менің 76 жасымда ғана оралуға мүмкіндігім болды.
Dialogue: 0,1:32:39.80,1:32:42.71,Default,,0,0,0,,Қанша уақыт болды, солай ма?
Dialogue: 0,1:32:42.71,1:32:44.74,Default,,0,0,0,,Сіз мені бұл жігітті іздеуге мәжбүр еттіңіз.
Dialogue: 0,1:32:44.74,1:32:47.94,Default,,0,0,0,,Иә, Ескендір Зұлқарнайынға да.
Dialogue: 0,1:32:47.94,1:32:50.91,Default,,0,0,0,,Наполеон да, Гитлер де істей алмаған нәрсе
Dialogue: 0,1:32:50.91,1:32:54.82,Default,,0,0,0,,Жасаған істеріңіз үшін рахмет.
Dialogue: 0,1:32:54.82,1:33:00.29,Default,,0,0,0,,Бұл менікі, мен сендерге бермеймін.
Dialogue: 0,1:33:00.29,1:33:02.29,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:33:05.13,1:33:07.56,Default,,0,0,0,,Мен сені сүймегенімді қалаймын
Dialogue: 0,1:33:07.56,1:33:10.76,Default,,0,0,0,,Жұлдыздарға оралу
Dialogue: 0,1:33:13.67,1:33:15.67,Default,,0,0,0,,Қош бол Люпин
Dialogue: 0,1:33:37.49,1:33:41.10,Default,,0,0,0,,Ғаламның ақырына дейін осылай бірге болу қызық болар еді
Dialogue: 0,1:33:41.10,1:33:43.20,Default,,0,0,0,,Штаб оның шамамен төрт айда сегіз «Стелла» жинайтынын болжайды, бірақ
Dialogue: 0,1:35:26.07,1:35:30.24,Default,,0,0,0,,Цезарьдікі
Dialogue: 0,1:35:30.24,1:35:32.24,Default,,0,0,0,,Мен өзімді сергек сезінемін.
Dialogue: 0,1:35:32.24,1:35:36.38,Default,,0,0,0,,Люпин не
Dialogue: 0,1:35:36.38,1:35:39.28,Default,,0,0,0,,О, ақымақ
Dialogue: 0,1:35:39.28,1:35:41.35,Default,,0,0,0,,Йоккорашо
Dialogue: 0,1:35:41.35,1:35:45.02,Default,,0,0,0,,Айқай? Ех хе хе
Dialogue: 0,1:35:45.02,1:35:47.32,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,1:35:47.32,1:35:50.32,Default,,0,0,0,,Бұл жолы
Dialogue: 0,1:35:57.03,1:36:00.40,Default,,0,0,0,,Қош бол, сен білгірсің.
Dialogue: 0,1:36:00.40,1:36:02.60,Default,,0,0,0,,Уфуфуфуфуфу
Dialogue: 0,1:36:08.28,1:36:11.75,Default,,0,0,0,,Балалар
Dialogue: 0,1:36:11.75,1:36:15.18,Default,,0,0,0,,Жоқ! Сен біліксіз Зенигата
Dialogue: 0,1:36:15.18,1:36:18.95,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:36:18.95,1:36:21.36,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:36:21.36,1:36:25.79,Default,,0,0,0,,Жарайды, неге Розеттадан сені қайтадан іздеуді сұрамайсың?
Dialogue: 0,1:36:25.79,1:36:28.46,Default,,0,0,0,,Мен 76 жыл күте алмаймын.
Dialogue: 0,1:36:28.46,1:36:30.96,Default,,0,0,0,,Lupine
Dialogue: 0,1:36:36.77,1:36:38.87,Default,,0,0,0,,Пухаа
Dialogue: 0,1:36:40.37,1:36:46.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory