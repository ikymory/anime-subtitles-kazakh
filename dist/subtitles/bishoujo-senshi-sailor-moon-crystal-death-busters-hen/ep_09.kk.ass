Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.45,0:00:06.92,Default,,0,0,0,,(электрокардиограмма сигналының тоны)
Dialogue: 0,0:00:07.04,0:00:07.88,Default,,0,0,0,,(Жүрек тоқтаған дыбыс)
Dialogue: 0,0:00:08.25,0:00:10.17,Default,,0,0,0,,Менің жүрегім тоқтап қалды...
Dialogue: 0,0:00:10.76,0:00:12.17,Default,,0,0,0,,Қайтыс болу
Dialogue: 0,0:00:12.55,0:00:14.22,Default,,0,0,0,,Солай ма!?
Dialogue: 0,0:00:15.43,0:00:16.64,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:00:16.80,0:00:18.97,Default,,0,0,0,,Хмм... Чибиуса!
Dialogue: 0,0:00:20.35,0:00:22.06,Default,,0,0,0,,Чибиуса!
Dialogue: 0,0:00:22.35,0:00:24.73,Default,,0,0,0,,Сенің жаның шығарылды, иә?
Dialogue: 0,0:00:25.77,0:00:26.94,Default,,0,0,0,,Харука-сан...
Dialogue: 0,0:00:27.11,0:00:27.77,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:29.23,0:00:33.03,Default,,0,0,0,,Хотару-чанға... Теңізші Сатурнға...
Dialogue: 0,0:00:33.32,0:00:34.74,Default,,0,0,0,,Өлтірілді ме?
Dialogue: 0,0:00:35.41,0:00:39.12,Default,,0,0,0,,Теңізші Сатурн әлі оянған жоқ.
Dialogue: 0,0:00:39.24,0:00:40.49,Default,,0,0,0,,Себебі—
Dialogue: 0,0:00:40.62,0:00:44.37,Default,,0,0,0,,Үш бойтұмар әлі іске қосылмаған.
Dialogue: 0,0:00:45.37,0:00:48.33,Default,,0,0,0,,Чибиусаға көмектесудің бір ғана жолы бар
Dialogue: 0,0:00:49.17,0:00:51.50,Default,,0,0,0,,Біреуі бар ма? қалай көмектесуге болады
Dialogue: 0,0:00:52.51,0:00:54.88,Default,,0,0,0,,Өрт сөндірушілерді өлтіріңіз...
Dialogue: 0,0:00:55.05,0:00:56.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:56.22,0:00:59.30,Default,,0,0,0,,Хотаруды сол жігіттер аспапқа айналдырды.
Dialogue: 0,0:01:00.22,0:01:02.60,Default,,0,0,0,,Бұл енді от емес, жау!
Dialogue: 0,0:01:04.02,0:01:08.77,Default,,0,0,0,,Чибиусаның жаны мен елес күміс кристалы оның қолында.
Dialogue: 0,0:01:09.56,0:01:14.24,Default,,0,0,0,,Чиби-Усаны құтқарғың келсе, онымен шайқасып, оны жеңіп, оны қайтар.
Dialogue: 0,0:01:14.36,0:01:17.28,Default,,0,0,0,,Сол... (Ами) Басқа амал жоқ па?
Dialogue: 0,0:01:17.78,0:01:20.37,Default,,0,0,0,,Теңізші Сатурн оянбаса да
Dialogue: 0,0:01:20.49,0:01:23.91,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, ақырында жойылу келеді.
Dialogue: 0,0:01:25.08,0:01:27.17,Default,,0,0,0,,Кеттік, біз
Dialogue: 0,0:01:27.79,0:01:31.80,Default,,0,0,0,,Чибиусаны ғана емес, барлығын құтқару.
Dialogue: 0,0:01:33.67,0:01:36.97,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:01:40.14,0:01:42.39,Default,,0,0,0,,Қоян... Ах...
Dialogue: 0,0:01:43.10,0:01:45.77,Default,,0,0,0,,Дұрыс, қоян
Dialogue: 0,0:01:45.89,0:01:48.02,Default,,0,0,0,,Егер біз бұл планетаны құтқармасақ...
Dialogue: 0,0:01:49.69,0:01:50.56,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:01:51.36,0:01:52.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:59.24,0:02:01.99,Default,,0,0,0,,Денем суып барады...
Dialogue: 0,0:02:02.91,0:02:05.20,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:02:05.95,0:02:09.12,Default,,0,0,0,,Бұлай жалғаса берсе, қан енді айналмайды.
Dialogue: 0,0:02:09.42,0:02:13.21,Default,,0,0,0,,Жаныңды қайтарсаң да, қайта тіріле алмайсың.
Dialogue: 0,0:02:13.63,0:02:16.26,Default,,0,0,0,,Сені менің бөлмеме апарайық, Мамо-чан...
Dialogue: 0,0:02:16.76,0:02:18.17,Default,,0,0,0,,Уақыт жоқ
Dialogue: 0,0:02:18.63,0:02:22.30,Default,,0,0,0,,Егер оның жанын тез қайтармасақ, Чибиуса құтқарылмайды.
Dialogue: 0,0:02:22.43,0:02:23.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:23.60,0:02:25.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:25.89,0:02:31.23,Default,,0,0,0,,♪〜
Dialogue: 0,0:03:49.77,0:03:55.52,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:59.19,0:04:01.53,Default,,0,0,0,,Чибиуза және менің денемнің байланысы
Dialogue: 0,0:04:02.20,0:04:05.49,Default,,0,0,0,,Менің денемді өмірді қолдау жүйесі ретінде пайдаланыңыз
Dialogue: 0,0:04:05.62,0:04:07.70,Default,,0,0,0,,Чибиусаның денесін барынша пайдаланыңыз
Dialogue: 0,0:04:09.49,0:04:11.20,Default,,0,0,0,,Бірақ содан кейін -
Dialogue: 0,0:04:11.33,0:04:13.25,Default,,0,0,0,,Мамо-чанның денесіне түскен ауыртпалық...
Dialogue: 0,0:04:13.54,0:04:17.67,Default,,0,0,0,,Жарайды, енді Чибиуса екеуміз бірміз.
Dialogue: 0,0:04:19.80,0:04:22.84,Default,,0,0,0,,Сіз бізді біраз уақытқа жалғыз қалдыра аласыз ба?
Dialogue: 0,0:04:23.47,0:04:24.76,Default,,0,0,0,,Иә
Dialogue: 0,0:04:26.72,0:04:30.72,Default,,0,0,0,,Мен Чибиусаны да, Хотару-чанды да таңдай алмаймын...
Dialogue: 0,0:04:32.27,0:04:34.23,Default,,0,0,0,,Бұл планетаның адамдары да...
Dialogue: 0,0:04:41.61,0:04:43.44,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:43.95,0:04:47.03,Default,,0,0,0,,Мамо-чанның жүрек соғысын естіп тұрмын
Dialogue: 0,0:04:47.78,0:04:50.74,Default,,0,0,0,,Чибиуса тірі сияқты...
Dialogue: 0,0:04:52.54,0:04:54.54,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:55.46,0:04:58.00,Default,,0,0,0,,Мен не істеуім керек? (жылау)
Dialogue: 0,0:04:58.17,0:04:59.67,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:05:00.46,0:05:03.55,Default,,0,0,0,,Қоян... Ах...
Dialogue: 0,0:05:04.51,0:05:05.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:13.27,0:05:14.56,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:17.31,0:05:19.61,Default,,0,0,0,,Мен оны қайтаруға барамын, АҚШ.
Dialogue: 0,0:05:19.73,0:05:20.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:20.61,0:05:24.49,Default,,0,0,0,,Чибиусаның жаны және елес күміс кристалы...
Dialogue: 0,0:05:25.65,0:05:28.78,Default,,0,0,0,,Бізде қазір қолдан келгенді істеуден басқа амал жоқ.
Dialogue: 0,0:05:29.49,0:05:31.12,Default,,0,0,0,,Үмітіңізді үзбеңіз
Dialogue: 0,0:05:32.66,0:05:33.91,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:39.71,0:05:41.00,Default,,0,0,0,,Бұл көзқарас...
Dialogue: 0,0:05:42.05,0:05:43.92,Default,,0,0,0,,Бұл Мәсіх пе?
Dialogue: 0,0:05:44.09,0:05:46.84,Default,,0,0,0,,Әлде жою құдайы ма?
Dialogue: 0,0:05:51.85,0:05:54.64,Default,,0,0,0,,Бұл тар және ыңғайсыз ыдыс.
Dialogue: 0,0:05:56.06,0:05:58.81,Default,,0,0,0,,Мен өзімді жайсыз сезінемін... (Есіктің ашылған дыбысы)
Dialogue: 0,0:05:58.98,0:06:01.65,Default,,0,0,0,,Әй... 9-ханым
Dialogue: 0,0:06:03.36,0:06:06.11,Default,,0,0,0,,Біз сіздің келуіңізді күттік.
Dialogue: 0,0:06:07.40,0:06:09.20,Default,,0,0,0,,Ұзақ болды...
Dialogue: 0,0:06:09.57,0:06:14.16,Default,,0,0,0,,Сол кезде мен қызым Хотаруға жұмыртқа салдым, бірақ...
Dialogue: 0,0:06:14.29,0:06:18.04,Default,,0,0,0,,Ұзақ уақыт бойы мен ерекшеленбей оянамын деп ойладым.
Dialogue: 0,0:06:18.96,0:06:20.50,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:06:20.67,0:06:21.71,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:22.67,0:06:23.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:24.30,0:06:26.96,Default,,0,0,0,,Мен енді ғана оянғаныма сене алар емеспін...
Dialogue: 0,0:06:27.09,0:06:28.13,Default,,0,0,0,,Каолинит
Dialogue: 0,0:06:28.26,0:06:29.09,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:29.22,0:06:32.93,Default,,0,0,0,,Бұл ұзақ және ауыр жұмыс болды.
Dialogue: 0,0:06:33.05,0:06:34.97,Default,,0,0,0,,Бұдан былай шебер туралы...
Dialogue: 0,0:06:35.10,0:06:40.02,Default,,0,0,0,,Маған қалдыр, ескі дүниедегі серігің.
Dialogue: 0,0:06:40.19,0:06:40.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:41.06,0:06:44.82,Default,,0,0,0,,Сізге Ұстаз берген маңызды миссия бар.
Dialogue: 0,0:06:44.94,0:06:48.11,Default,,0,0,0,,Оны мүмкіндігінше тез аяқтау керек.
Dialogue: 0,0:06:48.40,0:06:50.82,Default,,0,0,0,,Бөтен заттарды жою
Dialogue: 0,0:06:51.57,0:06:53.95,Default,,0,0,0,,Мен сәтсіздікке шыдамаймын
Dialogue: 0,0:06:54.83,0:06:56.95,Default,,0,0,0,,Мен жасап көремін
Dialogue: 0,0:06:59.29,0:07:02.92,Default,,0,0,0,,Мен болсам да, шегінетін ойым жоқ...
Dialogue: 0,0:07:03.38,0:07:04.67,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:07:07.80,0:07:09.47,Default,,0,0,0,,Перғауын 90) О...
Dialogue: 0,0:07:10.34,0:07:13.76,Default,,0,0,0,,Мен сізді күттім 9 ханым
Dialogue: 0,0:07:14.85,0:07:17.10,Default,,0,0,0,,Ұстаз перғауын90
Dialogue: 0,0:07:17.68,0:07:18.64,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:07:19.18,0:07:23.06,Default,,0,0,0,,Әй... Бұл не деген құдірет!
Dialogue: 0,0:07:24.36,0:07:28.53,Default,,0,0,0,,Мен бұрын-соңды мұндай Евхаристаны көрген емеспін!
Dialogue: 0,0:07:28.99,0:07:32.07,Default,,0,0,0,,Бұл Евхаристия емес.
Dialogue: 0,0:07:32.20,0:07:35.74,Default,,0,0,0,,Жұлдыздан қорғайтын адамдар үшін жарық көзі...
Dialogue: 0,0:07:36.24,0:07:40.87,Default,,0,0,0,,Бұл керемет күшті жасыратын елес күміс кристалл.
Dialogue: 0,0:07:42.25,0:07:44.08,Default,,0,0,0,,Жұмбақ жарық...
Dialogue: 0,0:07:44.21,0:07:46.79,Default,,0,0,0,,Онда бірдеңе тұрып жатқан сияқты.
Dialogue: 0,0:07:47.30,0:07:50.88,Default,,0,0,0,,Күшті және тыныштандыратын қасиетті сәуле...
Dialogue: 0,0:07:51.01,0:07:52.43,Default,,0,0,0,,Әрине
Dialogue: 0,0:07:53.38,0:07:58.22,Default,,0,0,0,,Өйткені оны сол баланың бейкүнә, сұлу жаны қорғады.
Dialogue: 0,0:07:58.56,0:07:59.81,Default,,0,0,0,,Бұл кім!?
Dialogue: 0,0:08:00.98,0:08:02.56,Default,,0,0,0,,Ж-жарайды… Сатып алғаныңызға рахмет.
Dialogue: 0,0:08:08.57,0:08:09.69,Default,,0,0,0,,Ах…
Dialogue: 0,0:08:12.28,0:08:15.53,Default,,0,0,0,,Менің қызметшім сиқыршылар 5
Dialogue: 0,0:08:16.62,0:08:19.16,Default,,0,0,0,,Сол жігіттерге қайта тірілу —
Dialogue: 0,0:08:19.33,0:08:21.37,Default,,0,0,0,,Қарғыс
Dialogue: 0,0:08:23.46,0:08:24.58,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:08:26.00,0:08:28.67,Default,,0,0,0,,Ешқашан бұзылмайтын қарғыс...
Dialogue: 0,0:08:28.84,0:08:31.21,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:08:34.55,0:08:35.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:36.51,0:08:37.68,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:08:38.39,0:08:41.72,Default,,0,0,0,,Барып Чибиусаның жанын қайтарайық.
Dialogue: 0,0:08:42.06,0:08:44.98,Default,,0,0,0,,Бізде алға ұмтылудан басқа амал жоқ.
Dialogue: 0,0:08:46.85,0:08:49.07,Default,,0,0,0,,Иә... кеттік.
Dialogue: 0,0:08:49.61,0:08:50.90,Default,,0,0,0,,Шексіздікке!
Dialogue: 0,0:08:54.03,0:08:57.45,Default,,0,0,0,,Мүген Ғакуен қашан осылай болды...
Dialogue: 0,0:08:58.16,0:09:00.74,Default,,0,0,0,,Ол орасан зор зұлымдыққа толы...
Dialogue: 0,0:09:00.87,0:09:04.21,Default,,0,0,0,,Қалыпты емес қуат күмбез тәрізді айналады.
Dialogue: 0,0:09:04.66,0:09:07.54,Default,,0,0,0,,Иә, бұл «Ω» пішіні сияқты...
Dialogue: 0,0:09:07.71,0:09:09.54,Default,,0,0,0,,Кеттік (Сейлор Мун және басқалары) Хмм...
Dialogue: 0,0:09:12.71,0:09:13.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:14.55,0:09:18.18,Default,,0,0,0,,Уран Нептун Плутон
Dialogue: 0,0:09:19.55,0:09:23.18,Default,,0,0,0,,Біздің жүрегіміз ешқашан біртұтас болмайды ма?
Dialogue: 0,0:09:23.56,0:09:26.02,Default,,0,0,0,,Иә? Сейлор Мун?
Dialogue: 0,0:09:26.14,0:09:27.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:28.69,0:09:29.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:30.15,0:09:31.65,Default,,0,0,0,,Сейлор Мун…
Dialogue: 0,0:09:32.19,0:09:33.48,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:09:33.61,0:09:37.20,Default,,0,0,0,,Үшеуміз барамыз отты өлтіреміз.
Dialogue: 0,0:09:38.53,0:09:39.78,Default,,0,0,0,,Өлтіру...
Dialogue: 0,0:09:40.20,0:09:41.24,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:09:41.66,0:09:42.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:45.62,0:09:48.17,Default,,0,0,0,,Фуфуфуфуфу... Міне, келдің.
Dialogue: 0,0:09:48.75,0:09:50.67,Default,,0,0,0,,Теңізші Сенши
Dialogue: 0,0:09:52.50,0:09:53.71,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:09:53.88,0:09:54.96,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:55.76,0:09:58.43,Default,,0,0,0,,«Шексіз лабиринт (Лабиринт Муген)» қош келдіңіз
Dialogue: 0,0:09:59.14,0:10:00.05,Default,,0,0,0,,Уф…
Dialogue: 0,0:10:00.22,0:10:04.97,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:10:06.52,0:10:07.64,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:09.85,0:10:11.81,Default,,0,0,0,,Сізде әдептілік жоқ.
Dialogue: 0,0:10:12.40,0:10:17.36,Default,,0,0,0,,Муген Гакуэн этикет менеджері Бұл Юко Аримура...
Dialogue: 0,0:10:17.49,0:10:19.16,Default,,0,0,0,,Маған жол көрсетуге рұқсат етіңіз
Dialogue: 0,0:10:19.32,0:10:20.20,Default,,0,0,0,,Әдеттегі!?
Dialogue: 0,0:10:20.36,0:10:23.24,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:10:24.95,0:10:26.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:26.54,0:10:27.71,Default,,0,0,0,,Уууу…
Dialogue: 0,0:10:28.66,0:10:29.71,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:10:30.25,0:10:33.96,Default,,0,0,0,,Сіз шынымен ұрысқыңыз келмейді, солай ма?
Dialogue: 0,0:10:34.09,0:10:35.05,Default,,0,0,0,,(Присцилла) Сол тәрбиесіз шлюхаға—
Dialogue: 0,0:10:35.21,0:10:38.05,Default,,0,0,0,,Түсіндім, жауынгерлік рух жоқ.
Dialogue: 0,0:10:38.17,0:10:39.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:40.30,0:10:44.81,Default,,0,0,0,,Мен Сейлор Мун үшін енді ешқашан төбелеспеймін.
Dialogue: 0,0:10:45.01,0:10:48.35,Default,,0,0,0,,Әдептілікке, жекпе-жекке, көріпкелдікке машықтанған дұрыс.
Dialogue: 0,0:10:48.48,0:10:50.23,Default,,0,0,0,,Бұл сіздің игілігіңіз үшін емес пе?
Dialogue: 0,0:10:50.69,0:10:51.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:52.06,0:10:53.65,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:10:53.81,0:10:56.19,Default,,0,0,0,,Жоғалған!? Барлығы қайда...
Dialogue: 0,0:10:57.32,0:10:58.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:00.49,0:11:01.99,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:11:02.49,0:11:04.12,Default,,0,0,0,,Мен оны кітаптан көрдім.
Dialogue: 0,0:11:04.24,0:11:06.33,Default,,0,0,0,,Әлемдегі ең үлкен жүйеге ие болу—
Dialogue: 0,0:11:06.45,0:11:09.71,Default,,0,0,0,,Жасанды өмір типті суперкомпьютер
Dialogue: 0,0:11:10.83,0:11:13.17,Default,,0,0,0,,Қош келдіңіз (Меркурий) Сіз...
Dialogue: 0,0:11:13.79,0:11:19.09,Default,,0,0,0,,Есіңде ме? Юйо Мидо жаратылыстану сабағына жауапты
Dialogue: 0,0:11:19.38,0:11:20.93,Default,,0,0,0,,Біздің мектептің мәні—
Dialogue: 0,0:11:21.05,0:11:23.72,Default,,0,0,0,,Мен мұны сізге көрсете алғаныма қуаныштымын.
Dialogue: 0,0:11:24.60,0:11:26.64,Default,,0,0,0,,Ха! (Меркурий) Уау...
Dialogue: 0,0:11:26.76,0:11:27.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:27.89,0:11:30.89,Default,,0,0,0,,Ұрыста босқа кеткен қымбат уақыт —
Dialogue: 0,0:11:31.02,0:11:35.19,Default,,0,0,0,,Күн сайын бұл қабілет Сейлор Мун үшін пайдаланылады...
Dialogue: 0,0:11:35.69,0:11:39.07,Default,,0,0,0,,Сіз шынымен де көбірек оқығыңыз келеді, солай ма?
Dialogue: 0,0:11:39.90,0:11:41.15,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:41.65,0:11:44.45,Default,,0,0,0,,Негізі, маған көбірек оқу керек...
Dialogue: 0,0:11:44.95,0:11:48.45,Default,,0,0,0,,Медицина училищесі... бұл мүмкін емес.
Dialogue: 0,0:11:48.91,0:11:50.12,Default,,0,0,0,,Барлығы қайда!?
Dialogue: 0,0:11:50.70,0:11:52.46,Default,,0,0,0,,Ха... қайда бардың?
Dialogue: 0,0:11:52.58,0:11:54.21,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:11:54.71,0:11:56.96,Default,,0,0,0,,Уау! Менің басым...
Dialogue: 0,0:11:57.38,0:11:59.26,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:11:59.71,0:12:02.76,Default,,0,0,0,,Сонымен, мен, Мими Ханю,
Dialogue: 0,0:12:02.88,0:12:06.39,Default,,0,0,0,,Бүгінгі кештің тамаша қонағы...
Dialogue: 0,0:12:06.76,0:12:09.81,Default,,0,0,0,,Теңізші Венера! (қуаныш)
Dialogue: 0,0:12:09.97,0:12:13.52,Default,,0,0,0,,Венера! Венера! Венера!
Dialogue: 0,0:12:13.81,0:12:16.40,Default,,0,0,0,,А... не болды?
Dialogue: 0,0:12:17.19,0:12:20.15,Default,,0,0,0,,Тезірек ән айт, Теңізші Венера
Dialogue: 0,0:12:20.61,0:12:23.49,Default,,0,0,0,,Сіздің арманыңыз кумир болу еді, солай ма?
Dialogue: 0,0:12:24.32,0:12:27.78,Default,,0,0,0,,Дұрыс, айдол болу менің арманым...
Dialogue: 0,0:12:28.62,0:12:31.29,Default,,0,0,0,,Теңізші жауынгерлер күлкілі...
Dialogue: 0,0:12:31.41,0:12:33.25,Default,,0,0,0,,Қазір тоқтатыңыз...
Dialogue: 0,0:12:34.37,0:12:37.50,Default,,0,0,0,,Ха!? Мұнда...
Dialogue: 0,0:12:37.63,0:12:40.25,Default,,0,0,0,,Шексіз ботаникалық баққа қош келдіңіз
Dialogue: 0,0:12:40.42,0:12:42.09,Default,,0,0,0,,Сіз... Теллур!
Dialogue: 0,0:12:42.21,0:12:43.76,Default,,0,0,0,,Ухуху…
Dialogue: 0,0:12:45.55,0:12:47.68,Default,,0,0,0,,Бүгін шайқас жоқ (Юпитер) Ах...
Dialogue: 0,0:12:48.39,0:12:49.68,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:12:51.89,0:12:53.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:54.19,0:12:56.02,Default,,0,0,0,,Раушан гүлдері көп
Dialogue: 0,0:12:57.06,0:12:58.19,Default,,0,0,0,,Уау...
Dialogue: 0,0:12:59.32,0:13:03.44,Default,,0,0,0,,«Ла Франс» шайының бірінші гибридті сорты!
Dialogue: 0,0:13:04.61,0:13:07.20,Default,,0,0,0,,Бұл «Soleil d’Or»!
Dialogue: 0,0:13:07.32,0:13:11.70,Default,,0,0,0,,Уау... «жарқыраудың» шедеврлері қаншама!
Dialogue: 0,0:13:12.58,0:13:13.87,Default,,0,0,0,,Ннн…
Dialogue: 0,0:13:14.00,0:13:19.17,Default,,0,0,0,,Ха... Маған енді шайқас бәрібір.
Dialogue: 0,0:13:20.71,0:13:22.96,Default,,0,0,0,,Мен осында мәңгі қалғым келеді
Dialogue: 0,0:13:24.42,0:13:29.22,Default,,0,0,0,,Менің арманым - сүйген адамыммен осылай раушан гүлзарында болу...
Dialogue: 0,0:13:33.35,0:13:34.39,Default,,0,0,0,,Хе-хе…
Dialogue: 0,0:13:34.56,0:13:35.68,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:13:35.94,0:13:37.98,Default,,0,0,0,,А... бұл қайда?
Dialogue: 0,0:13:39.23,0:13:40.98,Default,,0,0,0,,Барлығы ше!? Ах...
Dialogue: 0,0:13:41.90,0:13:45.69,Default,,0,0,0,,Меркурий! Марс! Юпитер! Венера!
Dialogue: 0,0:13:46.95,0:13:50.62,Default,,0,0,0,,Сіздің арқаңызда тоз-тоз болып қалдық.
Dialogue: 0,0:13:50.87,0:13:52.91,Default,,0,0,0,,Иә!? (Юпитер) Енді ұрыс жоқ...
Dialogue: 0,0:13:53.33,0:13:55.04,Default,,0,0,0,,Кешіріңіз, Мақпей.
Dialogue: 0,0:13:55.20,0:13:56.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:57.83,0:13:59.12,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:13:59.25,0:14:00.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:01.88,0:14:02.71,Default,,0,0,0,,Уф…
Dialogue: 0,0:14:02.84,0:14:05.55,Default,,0,0,0,,Бұл сен кінәлі Сейлор Мун
Dialogue: 0,0:14:05.71,0:14:08.76,Default,,0,0,0,,Уф... ку... ауырады.
Dialogue: 0,0:14:09.09,0:14:12.43,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:12.60,0:14:13.60,Default,,0,0,0,,Уф…
Dialogue: 0,0:14:13.72,0:14:16.10,Default,,0,0,0,,Хи хи...
Dialogue: 0,0:14:17.48,0:14:19.77,Default,,0,0,0,,Біз сізге де көмектесеміз.
Dialogue: 0,0:14:19.94,0:14:21.15,Default,,0,0,0,,Чибиуса-чан
Dialogue: 0,0:14:21.27,0:14:24.90,Default,,0,0,0,,Мен Сейлор Мун тітіркендіргіш деп ойладым.
Dialogue: 0,0:14:25.03,0:14:26.36,Default,,0,0,0,,Ухухуху...
Dialogue: 0,0:14:27.78,0:14:30.53,Default,,0,0,0,,Уран Нептун Плутон
Dialogue: 0,0:14:31.87,0:14:34.16,Default,,0,0,0,,Мен онымен айналысамын. (Ай) Әй...
Dialogue: 0,0:14:34.70,0:14:37.12,Default,,0,0,0,,Чибиуса мен Хотару...
Dialogue: 0,0:14:38.50,0:14:41.83,Default,,0,0,0,,Ал қоян! Сен де!
Dialogue: 0,0:14:42.00,0:14:42.79,Default,,0,0,0,,Иә!?
Dialogue: 0,0:14:42.96,0:14:44.75,Default,,0,0,0,,Ха... Қоян!
Dialogue: 0,0:14:44.92,0:14:47.30,Default,,0,0,0,,Қарғыс атсын... Алданба!
Dialogue: 0,0:14:47.97,0:14:48.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:50.80,0:14:52.60,Default,,0,0,0,,...
Dialogue: 0,0:14:53.72,0:14:58.81,Default,,0,0,0,,Таяғыма қуат бер Жүрек Ай Таяқ!
Dialogue: 0,0:15:04.44,0:15:08.15,Default,,0,0,0,,Ай спиралы...
Dialogue: 0,0:15:08.28,0:15:10.70,Default,,0,0,0,,Инфаркт!
Dialogue: 0,0:15:20.79,0:15:21.67,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:22.37,0:15:23.58,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:15:27.46,0:15:28.67,Default,,0,0,0,,Хааа! (кесілген дыбыс)
Dialogue: 0,0:15:29.21,0:15:30.26,Default,,0,0,0,,Ннн!
Dialogue: 0,0:15:33.26,0:15:35.80,Default,,0,0,0,,Қарғыс атсын... Бұл не деген жігіттер!
Dialogue: 0,0:15:36.31,0:15:38.64,Default,,0,0,0,,Оны қалай кессең де, ол саған шабуыл жасайды
Dialogue: 0,0:15:39.27,0:15:42.60,Default,,0,0,0,,Менің жүрегім лүпілдеп тұр... Сейлор Мун
Dialogue: 0,0:15:42.98,0:15:44.19,Default,,0,0,0,,Уран Плутон!
Dialogue: 0,0:15:44.31,0:15:45.40,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:45.52,0:15:46.82,Default,,0,0,0,,Қараңыз...
Dialogue: 0,0:15:49.74,0:15:52.03,Default,,0,0,0,,Ха! Мынау... мынау!?
Dialogue: 0,0:15:53.03,0:15:53.91,Default,,0,0,0,,Ах!?
Dialogue: 0,0:15:54.37,0:15:55.70,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:15:55.82,0:15:58.20,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:58.87,0:16:01.66,Default,,0,0,0,,Хмм... Хааа!
Dialogue: 0,0:16:02.46,0:16:03.92,Default,,0,0,0,,Сейлор Мунға қауіп төніп тұр!
Dialogue: 0,0:16:04.29,0:16:06.00,Default,,0,0,0,,Мәжбүрлі серпіліс!
Dialogue: 0,0:16:06.54,0:16:09.80,Default,,0,0,0,,Ғарыштық семсерді жарылғыш!
Dialogue: 0,0:16:11.72,0:16:12.97,Default,,0,0,0,,Хаа!
Dialogue: 0,0:16:13.13,0:16:14.30,Default,,0,0,0,,Ах…
Dialogue: 0,0:16:14.47,0:16:16.22,Default,,0,0,0,,Ухухуху...
Dialogue: 0,0:16:18.85,0:16:19.64,Default,,0,0,0,,Уф…
Dialogue: 0,0:16:20.14,0:16:22.23,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:16:22.77,0:16:23.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:24.23,0:16:25.06,Default,,0,0,0,,Хаа!
Dialogue: 0,0:16:27.19,0:16:29.23,Default,,0,0,0,,Хаа! (Ай) Уф!
Dialogue: 0,0:16:29.36,0:16:31.90,Default,,0,0,0,,Ууууууууууууууууууу!
Dialogue: 0,0:16:32.03,0:16:32.78,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:16:32.95,0:16:36.16,Default,,0,0,0,,(айдың ыңылауы)
Dialogue: 0,0:16:39.83,0:16:41.45,Default,,0,0,0,,Терең теңіз…
Dialogue: 0,0:16:43.75,0:16:45.21,Default,,0,0,0,,Айнадан түсіру!
Dialogue: 0,0:16:47.29,0:16:49.13,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:16:49.50,0:16:50.42,Default,,0,0,0,,Уф…
Dialogue: 0,0:16:54.93,0:16:56.64,Default,,0,0,0,,Ғарыштық-уақыттағы дауылды шабуыл (Кронос Тайфуны)
Dialogue: 0,0:17:05.73,0:17:07.15,Default,,0,0,0,,Уф…
Dialogue: 0,0:17:07.27,0:17:09.44,Default,,0,0,0,,Сейлор Мун! (Ай) А...
Dialogue: 0,0:17:11.32,0:17:13.07,Default,,0,0,0,,Нептун! Плутон!
Dialogue: 0,0:17:13.24,0:17:15.15,Default,,0,0,0,,Уран!
Dialogue: 0,0:17:15.28,0:17:17.32,Default,,0,0,0,,Амансың ба? теңізші ай
Dialogue: 0,0:17:18.41,0:17:20.49,Default,,0,0,0,,Мен сені келер деп ойладым...
Dialogue: 0,0:17:21.66,0:17:22.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:23.91,0:17:25.71,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:17:25.83,0:17:28.42,Default,,0,0,0,,Нептун Плутон...
Dialogue: 0,0:17:28.54,0:17:30.50,Default,,0,0,0,,Маған көмектесуге келдің бе?
Dialogue: 0,0:17:30.67,0:17:34.26,Default,,0,0,0,,Иә, біз баяғы Теңізші Сеншіміз.
Dialogue: 0,0:17:34.38,0:17:35.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:36.97,0:17:38.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:41.43,0:17:44.10,Default,,0,0,0,,Мен сендім.
Dialogue: 0,0:17:44.93,0:17:48.69,Default,,0,0,0,,Біз де солай сезінеміз...
Dialogue: 0,0:17:49.48,0:17:50.52,Default,,0,0,0,,Бұл кедергі.
Dialogue: 0,0:17:50.65,0:17:51.77,Default,,0,0,0,,Баланы өлтіріңіз
Dialogue: 0,0:17:51.94,0:17:53.07,Default,,0,0,0,,Иә!?
Dialogue: 0,0:17:53.78,0:17:55.15,Default,,0,0,0,,Біз дос бола алмаймыз.
Dialogue: 0,0:17:56.45,0:17:57.82,Default,,0,0,0,,Сейлор Мунға қауіп төніп тұр!
Dialogue: 0,0:17:58.32,0:18:00.03,Default,,0,0,0,,Мәжбүрлі серпіліс!
Dialogue: 0,0:18:01.78,0:18:04.16,Default,,0,0,0,,Мен сені тастап кете алмаймын
Dialogue: 0,0:18:05.20,0:18:09.08,Default,,0,0,0,,Мен әрқашан бірге күрескім келді.
Dialogue: 0,0:18:09.88,0:18:11.09,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:13.38,0:18:15.63,Default,,0,0,0,,Бірге күресейік
Dialogue: 0,0:18:16.42,0:18:18.76,Default,,0,0,0,,Ал егер күш күшейсе—
Dialogue: 0,0:18:18.88,0:18:21.89,Default,,0,0,0,,Мүмкін емес нәрсе мүмкін болады
Dialogue: 0,0:18:24.22,0:18:25.35,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:25.97,0:18:26.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:35.15,0:18:36.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:36.15,0:18:37.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:39.11,0:18:40.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:41.57,0:18:43.83,Default,,0,0,0,,Біз теңізші жауынгерміз
Dialogue: 0,0:18:43.95,0:18:45.20,Default,,0,0,0,,Егер біз бір болсақ —
Dialogue: 0,0:18:45.33,0:18:48.16,Default,,0,0,0,,Кез келген қуатты өндіруге болады!
Dialogue: 0,0:18:48.62,0:18:51.79,Default,,0,0,0,,Ай Чалис, шық, менің қолымды ал!
Dialogue: 0,0:18:55.21,0:18:59.55,Default,,0,0,0,,Бірге жинал, киелі жауынгерлердің киелі күші!
Dialogue: 0,0:19:12.10,0:19:14.65,Default,,0,0,0,,Ай дағдарысы!
Dialogue: 0,0:19:14.77,0:19:16.98,Default,,0,0,0,,Макияж!
Dialogue: 0,0:19:39.21,0:19:41.09,Default,,0,0,0,,Жоғарыда! (Теңізші Сенши) Иә!
Dialogue: 0,0:19:41.63,0:19:42.63,Default,,0,0,0,,Сейлор Мун) Кеттік!
Dialogue: 0,0:19:42.80,0:19:45.30,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:19:46.22,0:19:47.39,Default,,0,0,0,,Міне!
Dialogue: 0,0:19:47.72,0:19:53.27,Default,,0,0,0,,Қарғыс атсын... Сіз бұл мистикалық каолиниттің ең керемет техникасын шешіп алдыңыз ба?
Dialogue: 0,0:19:54.81,0:19:58.61,Default,,0,0,0,,Бірақ біз сізге енді араласуға жол бермейміз!
Dialogue: 0,0:19:59.15,0:20:01.90,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:20:02.07,0:20:03.66,Default,,0,0,0,,Ха... Даймон!
Dialogue: 0,0:20:03.82,0:20:05.03,Default,,0,0,0,,Ннн!
Dialogue: 0,0:20:06.62,0:20:07.83,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:20:07.95,0:20:10.41,Default,,0,0,0,,Юпитер кокосы…
Dialogue: 0,0:20:10.54,0:20:12.04,Default,,0,0,0,,Циклон!
Dialogue: 0,0:20:13.42,0:20:14.83,Default,,0,0,0,,Венера…
Dialogue: 0,0:20:17.09,0:20:21.05,Default,,0,0,0,,Көзін қысып тұрған шынжырлы қылыш!
Dialogue: 0,0:20:22.67,0:20:24.55,Default,,0,0,0,,Ақыры ұстадым сені, Дио!
Dialogue: 0,0:20:26.68,0:20:31.27,Default,,0,0,0,,Су Миражы (Mercury Aqua Mirage)!
Dialogue: 0,0:20:35.94,0:20:40.73,Default,,0,0,0,,Марс жыланының оты!
Dialogue: 0,0:20:41.44,0:20:43.20,Default,,0,0,0,,Ақыры ұстадым сені, Дио!
Dialogue: 0,0:20:44.78,0:20:47.37,Default,,0,0,0,,Ннн… Ннн…
Dialogue: 0,0:20:47.49,0:20:48.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:48.78,0:20:49.83,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:49.95,0:20:52.12,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:20:52.29,0:20:53.62,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:20:54.04,0:20:56.50,Default,,0,0,0,,Қазір! Шешіңіз...
Dialogue: 0,0:20:57.04,0:20:58.67,Default,,0,0,0,,Сейлор Мун!
Dialogue: 0,0:20:59.88,0:21:02.71,Default,,0,0,0,,Біз құтқарамыз
Dialogue: 0,0:21:03.05,0:21:05.80,Default,,0,0,0,,Жою арманынан, бұл жұлдыз!
Dialogue: 0,0:21:10.10,0:21:16.06,Default,,0,0,0,,Кемпірқосақ айдың жүрегі ауырады!
Dialogue: 0,0:21:19.15,0:21:21.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:21.40,0:21:23.40,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:21:28.03,0:21:28.91,Default,,0,0,0,,(Жарылған дыбыс)
Dialogue: 0,0:21:29.99,0:21:32.49,Default,,0,0,0,,Қандай лабиринтте жүрсең де
Dialogue: 0,0:21:32.62,0:21:35.62,Default,,0,0,0,,Мен үмітімді үзбеймін!
Dialogue: 0,0:21:37.58,0:21:39.33,Default,,0,0,0,,Барлығың іздеңдер!
Dialogue: 0,0:21:39.88,0:21:41.21,Default,,0,0,0,,Хотару-чан!
Dialogue: 0,0:21:43.17,0:21:45.13,Default,,0,0,0,,Ақырында мистикалық каолинит—
Dialogue: 0,0:21:45.26,0:21:46.76,Default,,0,0,0,,Жеңілді ме?
Dialogue: 0,0:21:46.88,0:21:49.14,Default,,0,0,0,,Супер Сейлор Мун…
Dialogue: 0,0:21:50.18,0:21:52.06,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:21:52.35,0:21:56.27,Default,,0,0,0,,Осы Омега аймағын біздің қасиетті орынға айналдыратын кез келді...
Dialogue: 0,0:21:57.31,0:21:59.94,Default,,0,0,0,,Егер елес күміс кристалл болса...
Dialogue: 0,0:22:00.36,0:22:03.78,Default,,0,0,0,,Бізде қорқатын ештеңе жоқ!
Dialogue: 0,0:22:21.00,0:22:27.01,Default,,0,0,0,,♪〜
Dialogue: 0,0:23:48.17,0:23:50.30,Default,,0,0,0,,〜♪
Dialogue: 0,0:23:52.30,0:23:53.30,Default,,0,0,0,,Енді адаспаңыз
Dialogue: 0,0:23:53.43,0:23:56.60,Default,,0,0,0,,Чибиуса мен Хотару-чан міндетті түрде көмектеседі!
Dialogue: 0,0:23:57.26,0:24:02.23,Default,,0,0,0,,Келесі акт.35 «Шексіз 9 «Шексіз лабиринт (Лабиринт Муген)» 2»
Dialogue: 0,0:24:02.35,0:24:04.15,Default,,0,0,0,,Ай сәулесі - махаббат хабары
Dialogue: 0,0:24:05.65,0:24:11.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
