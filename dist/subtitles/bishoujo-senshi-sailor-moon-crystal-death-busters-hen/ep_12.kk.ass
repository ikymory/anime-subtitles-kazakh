Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.87,0:00:04.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:09.09,0:00:10.30,Default,,0,0,0,,Ах, ол біте салысымен —
Dialogue: 0,0:00:10.46,0:00:11.92,Default,,0,0,0,,Әй, Мамо-чан!
Dialogue: 0,0:00:12.09,0:00:13.38,Default,,0,0,0,,Стокседо маскасы!
Dialogue: 0,0:00:13.84,0:00:15.51,Default,,0,0,0,,Кедергі ұзаққа созылмайды!
Dialogue: 0,0:00:15.64,0:00:19.06,Default,,0,0,0,,Жалқаулықпен жүрсек, мына ғаламшарды әлгі жігіт тоздырады!
Dialogue: 0,0:00:19.22,0:00:20.14,Default,,0,0,0,,(9 ханымның үрген дауысы)
Dialogue: 0,0:00:20.27,0:00:22.89,Default,,0,0,0,,Супер Сейлор Мунға айналу
Dialogue: 0,0:00:25.65,0:00:27.11,Default,,0,0,0,,Ай тостаған!
Dialogue: 0,0:00:27.44,0:00:29.44,Default,,0,0,0,,Шық, қолыма ал!
Dialogue: 0,0:00:33.53,0:00:35.16,Default,,0,0,0,,Сейлор Мун…
Dialogue: 0,0:00:36.03,0:00:38.20,Default,,0,0,0,,Менің де күшті болғым келеді
Dialogue: 0,0:00:38.91,0:00:40.74,Default,,0,0,0,,Мен де бір күні...
Dialogue: 0,0:00:41.16,0:00:42.87,Default,,0,0,0,,Сейлор Мун сияқты
Dialogue: 0,0:00:45.58,0:00:46.88,Default,,0,0,0,,Мен де...
Dialogue: 0,0:00:52.88,0:00:54.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:55.01,0:00:58.22,Default,,0,0,0,,Екі Ай тостаған...
Dialogue: 0,0:00:59.64,0:01:02.02,Default,,0,0,0,,Сейлор Чиби Мунның ойлары—
Dialogue: 0,0:01:02.14,0:01:04.60,Default,,0,0,0,,Мен жаңа оянуды жігерлендіремін.
Dialogue: 0,0:01:06.52,0:01:09.27,Default,,0,0,0,,Сейлор Чиби Мунның өзгеруі!
Dialogue: 0,0:01:09.69,0:01:10.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:11.57,0:01:12.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:24.95,0:01:27.29,Default,,0,0,0,,Ай дағдарысы!
Dialogue: 0,0:01:27.42,0:01:29.33,Default,,0,0,0,,Макияж!
Dialogue: 0,0:01:57.78,0:01:59.03,Default,,0,0,0,,Сейлор Чиби Мун) Ах...
Dialogue: 0,0:02:01.91,0:02:03.41,Default,,0,0,0,,Бұл сурет...
Dialogue: 0,0:02:03.95,0:02:06.20,Default,,0,0,0,,Супер Сейлор Чиби Мун!
Dialogue: 0,0:02:06.33,0:02:07.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:07.37,0:02:09.04,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:02:09.29,0:02:10.63,Default,,0,0,0,,(үру)
Dialogue: 0,0:02:13.09,0:02:14.17,Default,,0,0,0,,Сейлор Мун) Кеттік.
Dialogue: 0,0:02:14.30,0:02:16.17,Default,,0,0,0,,Супер Сейлор Чиби Мун!
Dialogue: 0,0:02:16.76,0:02:19.72,Default,,0,0,0,,Иә! супер теңізші ай
Dialogue: 0,0:02:20.30,0:02:23.35,Default,,0,0,0,,Енді күш біріктірейік!
Dialogue: 0,0:02:23.51,0:02:26.98,Default,,0,0,0,,(үру)
Dialogue: 0,0:02:28.23,0:02:30.60,Default,,0,0,0,,Кемпірқосақ…
Dialogue: 0,0:02:31.02,0:02:36.90,Default,,0,0,0,,Қос айдың жүрегі ауырады!
Dialogue: 0,0:02:42.53,0:02:43.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:47.45,0:02:50.12,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:02:50.50,0:02:52.75,Default,,0,0,0,,Ннн…
Dialogue: 0,0:02:58.13,0:03:01.18,Default,,0,0,0,,Қарғыс атсын... Бұл кеңістік-уақыттың бұрмалануы...
Dialogue: 0,0:03:02.22,0:03:04.18,Default,,0,0,0,,Ха... келе жатыр!
Dialogue: 0,0:03:05.01,0:03:07.27,Default,,0,0,0,,Ұстаз перғауын 90!
Dialogue: 0,0:03:08.81,0:03:11.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:11.44,0:03:15.40,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:03:15.86,0:03:21.24,Default,,0,0,0,,♪〜
Dialogue: 0,0:04:39.73,0:04:45.49,Default,,0,0,0,,〜♪
Dialogue: 0,0:04:47.24,0:04:51.49,Default,,0,0,0,,(9 ханым жылайды)
Dialogue: 0,0:04:54.71,0:04:57.67,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:04:58.00,0:04:59.54,Default,,0,0,0,,Көбірек қуат!
Dialogue: 0,0:04:59.67,0:05:01.92,Default,,0,0,0,,Сізді жарып жіберуге жеткілікті күш!
Dialogue: 0,0:05:02.59,0:05:03.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:05.30,0:05:08.01,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:05:09.93,0:05:12.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:12.27,0:05:15.64,Default,,0,0,0,,Ууу
Dialogue: 0,0:05:16.14,0:05:17.94,Default,,0,0,0,,Гуарг!
Dialogue: 0,0:05:19.27,0:05:20.57,Default,,0,0,0,,О...
Dialogue: 0,0:05:20.73,0:05:21.61,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:21.73,0:05:25.36,Default,,0,0,0,,Мен көптен күттім! 9 ханым!
Dialogue: 0,0:05:26.11,0:05:29.32,Default,,0,0,0,,О! Менің қожайыным!
Dialogue: 0,0:05:29.45,0:05:31.45,Default,,0,0,0,,Енді бір болудың уақыты келді!
Dialogue: 0,0:05:36.16,0:05:37.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:37.33,0:05:39.04,Default,,0,0,0,,А... иә...
Dialogue: 0,0:05:39.21,0:05:40.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:40.17,0:05:42.96,Default,,0,0,0,,Жылдам дайындалыңдар!
Dialogue: 0,0:05:50.60,0:05:52.14,Default,,0,0,0,,Жоғалып кетті... (Матрос Юпитер) Не!?
Dialogue: 0,0:05:54.56,0:05:56.64,Default,,0,0,0,,О...
Dialogue: 0,0:05:57.85,0:06:02.23,Default,,0,0,0,,Күш... Күшке толы!
Dialogue: 0,0:06:02.40,0:06:03.40,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:03.52,0:06:07.78,Default,,0,0,0,,90-шы перғауын 9-ханшыны сіңірді!
Dialogue: 0,0:06:07.90,0:06:10.95,Default,,0,0,0,,Осы жылдамдықпен бұл жұлдыз жұтылады!
Dialogue: 0,0:06:11.32,0:06:14.20,Default,,0,0,0,,үшінна! Оның үлкен болуын тоқтатыңыз!
Dialogue: 0,0:06:14.74,0:06:16.20,Default,,0,0,0,,Осы планетаны қорғаңыз!
Dialogue: 0,0:06:17.50,0:06:18.33,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:18.50,0:06:19.62,Default,,0,0,0,,Венера…
Dialogue: 0,0:06:22.21,0:06:26.17,Default,,0,0,0,,Көз қысып тұрған шынжырлы қылыш!
Dialogue: 0,0:06:28.26,0:06:32.72,Default,,0,0,0,,Марс жыланының оты!
Dialogue: 0,0:06:33.72,0:06:36.77,Default,,0,0,0,,Юпитер кокосы…
Dialogue: 0,0:06:36.89,0:06:38.18,Default,,0,0,0,,Циклон!
Dialogue: 0,0:06:39.19,0:06:43.40,Default,,0,0,0,,Су Миражы (Mercury Aqua Mirage)!
Dialogue: 0,0:06:44.90,0:06:50.36,Default,,0,0,0,,...
Dialogue: 0,0:06:52.20,0:06:55.24,Default,,0,0,0,,Кеттік, супер Сейлор Чиби Мун!
Dialogue: 0,0:06:55.37,0:06:56.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:58.62,0:07:01.04,Default,,0,0,0,,Кемпірқосақ түсі…
Dialogue: 0,0:07:01.42,0:07:07.13,Default,,0,0,0,,Қос айдың жүрегі ауырады!
Dialogue: 0,0:07:18.06,0:07:21.48,Default,,0,0,0,,Жоғалыңыз, Ұстаз Перғауын90!
Dialogue: 0,0:07:21.64,0:07:24.94,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:07:25.11,0:07:26.40,Default,,0,0,0,,Ннн!
Dialogue: 0,0:07:26.57,0:07:27.82,Default,,0,0,0,,Ннн!
Dialogue: 0,0:07:27.98,0:07:29.19,Default,,0,0,0,,Ннн!
Dialogue: 0,0:07:29.36,0:07:32.57,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:07:32.74,0:07:35.32,Default,,0,0,0,,Сіз мұны жасадыңыз ба? Жоқ, қара!
Dialogue: 0,0:07:36.24,0:07:37.70,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:07:37.83,0:07:40.41,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:07:43.25,0:07:45.33,Default,,0,0,0,,Бұл энергия...
Dialogue: 0,0:07:45.46,0:07:50.05,Default,,0,0,0,,Бұл жұлдызды қорғайтындардың күші ме?
Dialogue: 0,0:07:50.76,0:07:51.59,Default,,0,0,0,,Уф…
Dialogue: 0,0:07:51.72,0:07:54.47,Default,,0,0,0,,Енді жоқ... Қуат...
Dialogue: 0,0:07:54.76,0:07:56.14,Default,,0,0,0,,Ха... аа...
Dialogue: 0,0:07:56.89,0:07:58.31,Default,,0,0,0,,Чиби Мун!
Dialogue: 0,0:07:58.47,0:07:59.31,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:08:01.60,0:08:02.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:03.31,0:08:06.02,Default,,0,0,0,,Қандай күшті күш!
Dialogue: 0,0:08:06.15,0:08:09.53,Default,,0,0,0,,Қандай керемет энергия!
Dialogue: 0,0:08:10.23,0:08:11.07,Default,,0,0,0,,үшінна!
Dialogue: 0,0:08:11.24,0:08:12.24,Default,,0,0,0,,Ахх...
Dialogue: 0,0:08:12.36,0:08:14.24,Default,,0,0,0,,Ха... Венера!
Dialogue: 0,0:08:14.82,0:08:16.74,Default,,0,0,0,,Юпитер (Юпитер) Ағаш...
Dialogue: 0,0:08:17.16,0:08:19.62,Default,,0,0,0,,Мықты болыңыз! (2 адам) Уау...
Dialogue: 0,0:08:19.87,0:08:21.62,Default,,0,0,0,,Ха... бәріңе!
Dialogue: 0,0:08:22.21,0:08:24.58,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:08:24.75,0:08:27.21,Default,,0,0,0,,Ха... мүмкін емес...
Dialogue: 0,0:08:27.34,0:08:31.63,Default,,0,0,0,,Оның денесі біздің күш-қуатымыздың арқасында алып болды!?
Dialogue: 0,0:08:33.42,0:08:35.34,Default,,0,0,0,,Иә? Мен қозғала алмаймын...
Dialogue: 0,0:08:35.76,0:08:37.26,Default,,0,0,0,,Кедергі!?
Dialogue: 0,0:08:39.39,0:08:42.10,Default,,0,0,0,,Мен саған бұл атыраудан кетуге рұқсат бермеймін!
Dialogue: 0,0:08:42.39,0:08:44.35,Default,,0,0,0,,Ұстаз перғауын 90!
Dialogue: 0,0:08:44.64,0:08:47.36,Default,,0,0,0,,Оны үшеуміз тоқтатамыз!
Dialogue: 0,0:08:47.86,0:08:49.23,Default,,0,0,0,,Фухаха...
Dialogue: 0,0:08:49.36,0:08:54.65,Default,,0,0,0,,Қанша күрессең де, бәрі кеш!
Dialogue: 0,0:08:56.32,0:08:58.20,Default,,0,0,0,,Уууу…
Dialogue: 0,0:08:58.37,0:09:01.29,Default,,0,0,0,,Қарғыс атсын... Осы қарқынмен бөгет...
Dialogue: 0,0:09:01.62,0:09:05.04,Default,,0,0,0,,Уран! Нептун! Плутон!
Dialogue: 0,0:09:05.25,0:09:06.25,Default,,0,0,0,,Чи…
Dialogue: 0,0:09:06.37,0:09:10.34,Default,,0,0,0,,Иә, ол жермен-жексен болады!
Dialogue: 0,0:09:17.68,0:09:21.35,Default,,0,0,0,,Уууу…
Dialogue: 0,0:09:26.02,0:09:28.56,Default,,0,0,0,,Ха... бөгет жойылды...
Dialogue: 0,0:09:37.41,0:09:40.66,Default,,0,0,0,,Уф... қарғыс атсын! Әзірге...
Dialogue: 0,0:09:40.87,0:09:42.79,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:09:42.95,0:09:45.12,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:09:45.29,0:09:47.25,Default,,0,0,0,,Ха... аа...
Dialogue: 0,0:09:50.29,0:09:51.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:55.97,0:09:57.01,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:57.34,0:09:59.47,Default,,0,0,0,,Не? (Плутон) Аспаз…
Dialogue: 0,0:09:59.76,0:10:01.60,Default,,0,0,0,,Ах... (Меркурий) Бұл...
Dialogue: 0,0:10:05.43,0:10:06.48,Default,,0,0,0,,Тау жүйесі!?
Dialogue: 0,0:10:08.14,0:10:10.15,Default,,0,0,0,,О...
Dialogue: 0,0:10:11.31,0:10:15.82,Default,,0,0,0,,Алыста, менің ұмытылған үйдегі жұлдыздар жүйесі...
Dialogue: 0,0:10:16.74,0:10:18.74,Default,,0,0,0,,Тау жүйесі!
Dialogue: 0,0:10:19.70,0:10:20.70,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:10:20.82,0:10:26.66,Default,,0,0,0,,Мен бұл планетаны қамтып, оны игерейін деп жатырмын.
Dialogue: 0,0:10:26.83,0:10:33.38,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:10:34.63,0:10:39.30,Default,,0,0,0,,Өлімнің иісі бар қара лава жер бетін басып жатыр...
Dialogue: 0,0:10:39.80,0:10:43.51,Default,,0,0,0,,Осы қарқынмен бұл планета олардыкі болады...
Dialogue: 0,0:10:43.64,0:10:46.39,Default,,0,0,0,,Біз ештеңе істей алмаймыз ба?
Dialogue: 0,0:10:46.89,0:10:48.10,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:10:48.52,0:10:50.94,Default,,0,0,0,,Бітті ме?
Dialogue: 0,0:10:51.06,0:10:52.02,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:10:52.19,0:10:54.40,Default,,0,0,0,,Бәле! (Венера) Міне...
Dialogue: 0,0:10:54.77,0:10:56.82,Default,,0,0,0,,Чиби Мун! Чиби Мун!
Dialogue: 0,0:10:56.98,0:10:59.53,Default,,0,0,0,,Ууу...
Dialogue: 0,0:10:59.65,0:11:00.70,Default,,0,0,0,,Я...
Dialogue: 0,0:11:01.74,0:11:03.91,Default,,0,0,0,,Әркім өз шегінде
Dialogue: 0,0:11:04.66,0:11:06.99,Default,,0,0,0,,Менің күшім қалмады...
Dialogue: 0,0:11:11.71,0:11:13.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:13.92,0:11:15.88,Default,,0,0,0,,Ха... аа...
Dialogue: 0,0:11:24.47,0:11:26.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:26.56,0:11:28.56,Default,,0,0,0,,Ха... аа...
Dialogue: 0,0:11:28.72,0:11:30.60,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:11:30.77,0:11:32.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:32.77,0:11:34.94,Default,,0,0,0,,Бұл... (С Чиби Мун) Ах...
Dialogue: 0,0:11:35.40,0:11:37.73,Default,,0,0,0,,Не!? Бұл жарық
Dialogue: 0,0:11:42.66,0:11:44.49,Default,,0,0,0,,Ай сәулесі…
Dialogue: 0,0:11:45.32,0:11:46.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:48.24,0:11:49.62,Default,,0,0,0,,Жылы...
Dialogue: 0,0:11:51.96,0:11:53.37,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:53.67,0:11:57.50,Default,,0,0,0,,Мені әрқашан бәрі қорғады.
Dialogue: 0,0:11:59.05,0:12:05.05,Default,,0,0,0,,Алдыңғы өмірімнен бастап мені бәрі бақылап, қолдап отырды.
Dialogue: 0,0:12:06.89,0:12:08.76,Default,,0,0,0,,Хотару-чан осында
Dialogue: 0,0:12:08.93,0:12:11.93,Default,,0,0,0,,Ха... (Чиби Мун) Біздің ішімізде!
Dialogue: 0,0:12:12.06,0:12:13.81,Default,,0,0,0,,Біздің…
Dialogue: 0,0:12:15.65,0:12:19.23,Default,,0,0,0,,Хотару-чан осында.
Dialogue: 0,0:12:20.69,0:12:22.15,Default,,0,0,0,,Біз қорғауымыз керек...
Dialogue: 0,0:12:23.11,0:12:26.53,Default,,0,0,0,,Енді мен бәрін қорғауым керек!
Dialogue: 0,0:12:28.03,0:12:29.58,Default,,0,0,0,,Әлі қалды...
Dialogue: 0,0:12:30.29,0:12:34.37,Default,,0,0,0,,Әр адамның күші әлі де менің ішімде.
Dialogue: 0,0:12:35.29,0:12:39.34,Default,,0,0,0,,Дәл қазір денеммен күресетін жалғыз мен ғанамын.
Dialogue: 0,0:12:40.59,0:12:44.72,Default,,0,0,0,,Тек мен және елес күміс кристалдың құдіреті
Dialogue: 0,0:12:46.93,0:12:48.30,Default,,0,0,0,,Ай тостаған!
Dialogue: 0,0:12:48.80,0:12:50.85,Default,,0,0,0,,Шық, мені ал!
Dialogue: 0,0:12:52.14,0:12:53.64,Default,,0,0,0,,Маған күшіңді бер!
Dialogue: 0,0:12:53.77,0:12:57.06,Default,,0,0,0,,Тоғыз матрос жауынгердің соңғы күшін тойлау.
Dialogue: 0,0:12:57.19,0:12:59.23,Default,,0,0,0,,Аты аңызға айналған Ай тостаған!
Dialogue: 0,0:13:01.86,0:13:03.90,Default,,0,0,0,,АҚШ... не істейсің!?
Dialogue: 0,0:13:09.49,0:13:10.58,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:13:10.74,0:13:11.49,Default,,0,0,0,,Қоян!
Dialogue: 0,0:13:11.66,0:13:12.50,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:20.88,0:13:22.38,Default,,0,0,0,,Сейлор Мун…
Dialogue: 0,0:13:24.13,0:13:25.51,Default,,0,0,0,,Мен—
Dialogue: 0,0:13:26.34,0:13:29.51,Default,,0,0,0,,Ай тостаған және елес күміс кристалының күші —
Dialogue: 0,0:13:30.01,0:13:32.22,Default,,0,0,0,,Оның ішін босат!
Dialogue: 0,0:13:44.19,0:13:45.61,Default,,0,0,0,,Мен—
Dialogue: 0,0:13:46.20,0:13:49.24,Default,,0,0,0,,Ай тостаған және елес күміс кристалының күші —
Dialogue: 0,0:13:49.91,0:13:52.24,Default,,0,0,0,,Оның ішін босат!
Dialogue: 0,0:13:53.16,0:13:56.00,Default,,0,0,0,,Келіңіздер! Usaa!
Dialogue: 0,0:13:57.83,0:14:00.25,Default,,0,0,0,,Ах... Сейлор Мун...
Dialogue: 0,0:14:00.42,0:14:02.17,Default,,0,0,0,,Сейлор Мун!?
Dialogue: 0,0:14:02.29,0:14:04.63,Default,,0,0,0,,Супер Сейлор Мун! Керемет...
Dialogue: 0,0:14:05.17,0:14:07.97,Default,,0,0,0,,Хмм... (Марс) жоғалып кетті...
Dialogue: 0,0:14:08.09,0:14:10.22,Default,,0,0,0,,Ол шынымен жоғалып кетті ме?
Dialogue: 0,0:14:10.59,0:14:11.89,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:14:12.51,0:14:13.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:16.39,0:14:17.43,Default,,0,0,0,,Қоян!
Dialogue: 0,0:14:17.56,0:14:18.77,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:14:18.89,0:14:21.48,Default,,0,0,0,,Ха... аа...
Dialogue: 0,0:14:22.44,0:14:26.11,Default,,0,0,0,,Сейлор Мунның реакциясы... жоғалып кетті.
Dialogue: 0,0:14:27.40,0:14:28.82,Default,,0,0,0,,Ннн…
Dialogue: 0,0:14:29.20,0:14:32.41,Default,,0,0,0,,Кук... Қоян...
Dialogue: 0,0:14:33.33,0:14:36.29,Default,,0,0,0,,Менің өлуіме бірінші сен ғана рұқсат еттің...
Dialogue: 0,0:14:37.50,0:14:39.12,Default,,0,0,0,,Қорғау мүмкін болмады...
Dialogue: 0,0:14:39.92,0:14:41.79,Default,,0,0,0,,Кук… nnnn…
Dialogue: 0,0:14:41.96,0:14:43.75,Default,,0,0,0,,Сейлор Мун…
Dialogue: 0,0:14:44.46,0:14:45.92,Default,,0,0,0,,Мама!
Dialogue: 0,0:14:46.26,0:14:49.13,Default,,0,0,0,,Қарғыс атсын... осылай...
Dialogue: 0,0:14:49.72,0:14:52.68,Default,,0,0,0,,Бұл сондай... ақымақ!
Dialogue: 0,0:14:52.89,0:14:53.89,Default,,0,0,0,,Мен... га...
Dialogue: 0,0:14:54.51,0:14:56.47,Default,,0,0,0,,Сіз маған әлі атыңызды айтқан жоқсыз.
Dialogue: 0,0:14:56.60,0:14:58.27,Default,,0,0,0,,Мен білемін, иә?
Dialogue: 0,0:14:58.39,0:15:00.23,Default,,0,0,0,,Харука Тенну
Dialogue: 0,0:15:00.39,0:15:04.65,Default,,0,0,0,,Сіз де, Мичиру да атақты адамдарсыз.
Dialogue: 0,0:15:05.11,0:15:07.82,Default,,0,0,0,,Харука-сан - Уран, солай ма?
Dialogue: 0,0:15:07.94,0:15:10.11,Default,,0,0,0,,Сол желдің иісі бар
Dialogue: 0,0:15:10.91,0:15:14.20,Default,,0,0,0,,Мен... мен жай ғана...
Dialogue: 0,0:15:14.45,0:15:16.66,Default,,0,0,0,,Сол баланы өз қолыммен қорғағым келді.
Dialogue: 0,0:15:17.45,0:15:21.08,Default,,0,0,0,,үшін осы!
Dialogue: 0,0:15:21.25,0:15:24.67,Default,,0,0,0,,Ууу...
Dialogue: 0,0:15:24.84,0:15:28.30,Default,,0,0,0,,Уууу... Сейлор Мун...
Dialogue: 0,0:15:28.71,0:15:30.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.05,0:15:33.18,Default,,0,0,0,,Уууу…
Dialogue: 0,0:15:33.34,0:15:34.93,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:15:35.47,0:15:36.47,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:15:37.72,0:15:38.56,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:39.60,0:15:40.94,Default,,0,0,0,,Тұмар...
Dialogue: 0,0:15:41.27,0:15:42.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:42.90,0:15:44.56,Default,,0,0,0,,Резонанстық!?
Dialogue: 0,0:16:06.17,0:16:11.80,Default,,0,0,0,,Иә? Не? Бұл нұр менің денемнен асып түседі
Dialogue: 0,0:16:11.92,0:16:13.97,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:16:14.30,0:16:17.60,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:16:25.27,0:16:26.77,Default,,0,0,0,,Уууу…
Dialogue: 0,0:16:26.98,0:16:28.82,Default,,0,0,0,,Ууу!?
Dialogue: 0,0:16:29.15,0:16:30.65,Default,,0,0,0,,Уууу…
Dialogue: 0,0:16:31.24,0:16:32.07,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:16:43.96,0:16:45.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:45.71,0:16:47.25,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:16:47.63,0:16:49.09,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:17:19.87,0:17:22.66,Default,,0,0,0,,Мен өлім аузынан келген хабаршымын
Dialogue: 0,0:17:22.79,0:17:27.29,Default,,0,0,0,,Үнсіз жауынгер, оның қамқоршысы Сатурн, жойылу планетасы.
Dialogue: 0,0:17:28.46,0:17:30.29,Default,,0,0,0,,Теңізші Сатурн
Dialogue: 0,0:17:31.09,0:17:32.92,Default,,0,0,0,,Ннн…
Dialogue: 0,0:17:33.05,0:17:35.34,Default,,0,0,0,,Теңізші Сатурн…
Dialogue: 0,0:17:36.55,0:17:38.05,Default,,0,0,0,,Мен ояндым...
Dialogue: 0,0:17:38.22,0:17:40.68,Default,,0,0,0,,Қарғыс атсын... Осымен...
Dialogue: 0,0:17:40.85,0:17:42.81,Default,,0,0,0,,Ах... (Плутон) Өтірік...
Dialogue: 0,0:17:43.22,0:17:44.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:45.64,0:17:47.64,Default,,0,0,0,,Бітті ме?
Dialogue: 0,0:17:49.65,0:17:53.19,Default,,0,0,0,,Мен бұрын шақырылғандықтан және
Dialogue: 0,0:17:54.07,0:17:57.40,Default,,0,0,0,,Уақыт әлі өтпеген сияқты.
Dialogue: 0,0:18:04.33,0:18:07.00,Default,,0,0,0,,Аа... Кез келген уақытта мен—
Dialogue: 0,0:18:07.12,0:18:09.04,Default,,0,0,0,,Шақырылмаған қонаққа ұқсайды.
Dialogue: 0,0:18:13.34,0:18:18.76,Default,,0,0,0,,Біртіндеп бірқатар сәйкестіктер бірігіп, оқиға жазықтығында ауытқу орын алады.
Dialogue: 0,0:18:18.88,0:18:23.93,Default,,0,0,0,,Тарих бір кезде сәл ығысқан сияқты.
Dialogue: 0,0:18:24.68,0:18:25.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:26.85,0:18:29.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:29.48,0:18:31.27,Default,,0,0,0,,Уф... Мен қозғала алмаймын.
Dialogue: 0,0:18:31.65,0:18:34.98,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:18:36.15,0:18:38.78,Default,,0,0,0,,Осы шексіз жерде болған апаттың салдарынан —
Dialogue: 0,0:18:38.90,0:18:41.78,Default,,0,0,0,,Мәңгі ұйықтау керек болған от шыбынының...
Dialogue: 0,0:18:42.45,0:18:43.45,Default,,0,0,0,,Киборг ретінде—
Dialogue: 0,0:18:43.58,0:18:46.58,Default,,0,0,0,,Мен мүмкін емес өмір сүре бастадым...
Dialogue: 0,0:18:50.33,0:18:52.71,Default,,0,0,0,,Бұл да оның денесі...
Dialogue: 0,0:18:53.38,0:18:57.26,Default,,0,0,0,,Ешқашан оянбау керек болған жаным үшін
Dialogue: 0,0:18:57.38,0:18:59.30,Default,,0,0,0,,Таң қалды
Dialogue: 0,0:19:01.64,0:19:03.97,Default,,0,0,0,,Профессор Томенің бұрмаланған санасы...
Dialogue: 0,0:19:04.10,0:19:07.64,Default,,0,0,0,,Менің мына басқа дүниеден адамдарды шақырғаным...
Dialogue: 0,0:19:09.56,0:19:14.11,Default,,0,0,0,,Ал мен денемді аспапқа айналдырып өмір сүре бастадым...
Dialogue: 0,0:19:17.15,0:19:19.24,Default,,0,0,0,,Бірақ менде басқа амал жоқ.
Dialogue: 0,0:19:20.40,0:19:23.28,Default,,0,0,0,,Бізді осында тартты...
Dialogue: 0,0:19:23.41,0:19:26.12,Default,,0,0,0,,Мұнда басқа әлемге жол ашылды.
Dialogue: 0,0:19:26.24,0:19:29.12,Default,,0,0,0,,Өйткені бұл жер таңдалды
Dialogue: 0,0:19:29.83,0:19:33.29,Default,,0,0,0,,үшін жойылуға қарай жүре бастады ...
Dialogue: 0,0:19:33.42,0:19:35.38,Default,,0,0,0,,Тағдыр
Dialogue: 0,0:19:37.17,0:19:39.92,Default,,0,0,0,,Енді мен ояндым, мен...
Dialogue: 0,0:19:40.05,0:19:41.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:43.18,0:19:47.22,Default,,0,0,0,,Бұл Silence Glaive қойылуы керек.
Dialogue: 0,0:19:47.39,0:19:50.98,Default,,0,0,0,,Тыныштық Глейв... Өлім құдайының орағы!
Dialogue: 0,0:19:51.14,0:19:54.81,Default,,0,0,0,,Оны шайқау – бәрінің жоғалуын білдіреді...
Dialogue: 0,0:19:55.06,0:19:59.15,Default,,0,0,0,,Ақымақ! Бұл тағдырдың жазуы ма?
Dialogue: 0,0:19:59.28,0:20:00.24,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:20:11.91,0:20:13.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:13.62,0:20:16.96,Default,,0,0,0,,Біздің болашағымыз жоқ па?
Dialogue: 0,0:20:20.17,0:20:23.26,Default,,0,0,0,,Ха... Тоқта, Сатурн!
Dialogue: 0,0:20:24.22,0:20:27.51,Default,,0,0,0,,Өлім қайта туылған революция!
Dialogue: 0,0:20:30.06,0:20:32.31,Default,,0,0,0,,(Перғауынның ыңырануы 90)
Dialogue: 0,0:20:32.81,0:20:34.98,Default,,0,0,0,,Қуат...
Dialogue: 0,0:20:35.10,0:20:38.69,Default,,0,0,0,,Қуат жұтылады!
Dialogue: 0,0:20:38.94,0:20:42.61,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:20:42.78,0:20:46.32,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:20:46.49,0:20:49.41,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:20:50.12,0:20:51.45,Default,,0,0,0,,Уууу…
Dialogue: 0,0:20:51.58,0:20:52.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:53.04,0:20:54.92,Default,,0,0,0,,О...
Dialogue: 0,0:20:55.04,0:20:57.75,Default,,0,0,0,,Бұл үлкен теріс аура...
Dialogue: 0,0:20:58.17,0:21:03.30,Default,,0,0,0,,Осы Омега аймағын қоршап алған ең үлкен ұйықтау күші!
Dialogue: 0,0:21:03.63,0:21:09.93,Default,,0,0,0,,Сол күш жойылуға апаратын нұр болып оянды ма?
Dialogue: 0,0:21:10.10,0:21:12.27,Default,,0,0,0,,Бұл сен бе!?
Dialogue: 0,0:21:12.39,0:21:18.23,Default,,0,0,0,,Шыу!
Dialogue: 0,0:21:18.73,0:21:22.32,Default,,0,0,0,,Ол бетін тастап кетті! Қандай күш!
Dialogue: 0,0:21:22.82,0:21:25.99,Default,,0,0,0,,Жиренішті тіршілік иесі! Басқыншы!
Dialogue: 0,0:21:26.91,0:21:28.07,Default,,0,0,0,,Ештеңеге оралма!
Dialogue: 0,0:21:30.83,0:21:33.95,Default,,0,0,0,,Бұл дүниені аяқтаңыз!
Dialogue: 0,0:21:34.12,0:21:37.42,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:21:38.83,0:21:41.75,Default,,0,0,0,,Бітті... Мен оны енді тоқтата алмаймын!
Dialogue: 0,0:21:42.63,0:21:45.55,Default,,0,0,0,,Тыныштық сөндірілді!
Dialogue: 0,0:21:46.51,0:21:49.93,Default,,0,0,0,,Онымен дүние бітеді!
Dialogue: 0,0:21:50.76,0:21:52.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:53.14,0:21:54.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:55.18,0:21:56.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:57.14,0:21:58.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:59.69,0:22:00.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:05.07,0:22:07.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:07.99,0:22:11.12,Default,,0,0,0,,Сейлор Мун!
Dialogue: 0,0:22:20.88,0:22:26.88,Default,,0,0,0,,♪〜
Dialogue: 0,0:23:48.00,0:23:50.13,Default,,0,0,0,,〜♪
Dialogue: 0,0:23:52.13,0:23:53.72,Default,,0,0,0,,Теңізші Сатурн ақыры оянады
Dialogue: 0,0:23:54.30,0:23:57.31,Default,,0,0,0,,Ал «Тыныштық глейві» төмен түсірілді.
Dialogue: 0,0:23:57.85,0:24:02.14,Default,,0,0,0,,Келесі акт.38 «Шексіздік 12 Шексіздік – кету»
Dialogue: 0,0:24:02.60,0:24:04.73,Default,,0,0,0,,Ай сәулесі - махаббат хабары
Dialogue: 0,0:24:06.23,0:24:12.23,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
