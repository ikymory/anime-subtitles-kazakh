Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.10,0:00:03.14,Default,,0000,0000,0000,,Хатсухусо
Dialogue: 0,0:00:01.10,0:00:03.14,Default,,0000,0000,0000,,Алғашқы телехабар!
Dialogue: 0,0:00:03.14,0:00:05.11,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:00:03.14,0:00:05.11,Default,,0000,0000,0000,,«Нобита»….
Dialogue: 0,0:00:03.14,0:00:05.11,Default,,0000,0000,0000,,Чикю симфониясы
Dialogue: 0,0:00:03.14,0:00:05.11,Default,,0000,0000,0000,,«Жер симфониясы».
Dialogue: 0,0:00:05.11,0:00:07.11,Default,,0000,0000,0000,,Ди
Dialogue: 0,0:00:05.11,0:00:07.11,Default,,0000,0000,0000,,О.
Dialogue: 0,0:00:05.11,0:00:07.11,Default,,0000,0000,0000,,Алдымен d түймесін→ басыңыз
Dialogue: 0,0:00:07.11,0:00:10.11,Default,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:00:07.11,0:00:10.11,Default,,0000,0000,0000,,«Дораэмон фильм кейіпкерлерінің жинағы»
Dialogue: 0,0:00:07.11,0:00:10.11,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:00:07.11,0:00:10.11,Default,,0000,0000,0000,,бастайық.
Dialogue: 0,0:00:10.11,0:00:13.11,Default,,0000,0000,0000,,Хосочу
Dialogue: 0,0:00:10.11,0:00:13.11,Default,,0000,0000,0000,,Хабар тарату
Dialogue: 0,0:00:10.11,0:00:13.11,Default,,0000,0000,0000,,Түбіртек
Dialogue: 0,0:00:10.11,0:00:13.11,Default,,0000,0000,0000,,Тоджо
Dialogue: 0,0:00:10.11,0:00:13.11,Default,,0000,0000,0000,,Өткен фильмдерде пайда болған →
Dialogue: 0,0:00:13.11,0:00:16.12,Default,,0000,0000,0000,,Ники
Dialogue: 0,0:00:13.11,0:00:16.12,Default,,0000,0000,0000,,Танымал кейіпкерлер
Dialogue: 0,0:00:13.11,0:00:16.12,Default,,0000,0000,0000,,Гамен
Dialogue: 0,0:00:13.11,0:00:16.12,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:00:13.11,0:00:16.12,Default,,0000,0000,0000,,Экранда пайда болған кезде→
Dialogue: 0,0:00:16.12,0:00:19.12,Default,,0000,0000,0000,,Дондон
Dialogue: 0,0:00:16.12,0:00:19.12,Default,,0000,0000,0000,,Ол жиналуда.
Dialogue: 0,0:00:19.12,0:00:22.12,Default,,0000,0000,0000,,♬ Соғылуы тиіс толық нүкте
Dialogue: 0,0:00:19.12,0:00:22.12,Default,,0000,0000,0000,,Бұл Писуке!
Dialogue: 0,0:00:19.12,0:00:22.12,Default,,0000,0000,0000,,Мен де Попон алғым келеді!
Dialogue: 0,0:00:22.12,0:00:24.09,Default,,0000,0000,0000,,Казу
Dialogue: 0,0:00:22.12,0:00:24.09,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:00:22.12,0:00:24.09,Default,,0000,0000,0000,,Жиналған санға байланысты
Dialogue: 0,0:00:22.12,0:00:24.09,Default,,0000,0000,0000,,Ұпай жинаңыз....
Dialogue: 0,0:00:25.13,0:00:27.09,Default,,0000,0000,0000,,Бұл сыйлық
Dialogue: 0,0:00:25.13,0:00:27.09,Default,,0000,0000,0000,,Мен аламын.
Dialogue: 0,0:00:27.09,0:00:29.10,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:00:29.10,0:00:31.13,Default,,0000,0000,0000,,Гука
Dialogue: 0,0:00:29.10,0:00:31.13,Default,,0000,0000,0000,,Сәнді сыйлық
Dialogue: 0,0:00:29.10,0:00:31.13,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:00:31.13,0:00:34.10,Default,,0000,0000,0000,,Дүние
Dialogue: 0,0:00:31.13,0:00:34.10,Default,,0000,0000,0000,,Жақсы емес
Dialogue: 0,0:00:31.13,0:00:34.10,Default,,0000,0000,0000,,Не? Әлемде бір ғана
Dialogue: 0,0:00:31.13,0:00:34.10,Default,,0000,0000,0000,,Сонымен қатар суреттер бар.
Dialogue: 0,0:00:34.10,0:00:36.10,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:00:36.10,0:00:38.14,Default,,0000,0000,0000,,d түймесін басыңыз
Dialogue: 0,0:00:36.10,0:00:38.14,Default,,0000,0000,0000,,Санка
Dialogue: 0,0:00:36.10,0:00:38.14,Default,,0000,0000,0000,,Қатысу.
Dialogue: 0,0:00:38.14,0:00:40.11,Default,,0000,0000,0000,,(Дораэмон/Нобита)
Dialogue: 0,0:00:38.14,0:00:40.11,Default,,0000,0000,0000,,Қазір мен сөйлесіп тұрған адам – басқа емес,
Dialogue: 0,0:00:42.14,0:00:53.09,Default,,0000,0000,0000,,Жел
Dialogue: 0,0:00:42.14,0:00:53.09,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:00:42.14,0:00:53.09,Default,,0000,0000,0000,,(Жел дыбысы)
Dialogue: 0,0:00:53.09,0:00:56.09,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:00:56.09,0:00:59.09,Default,,0000,0000,0000,,Тори
Dialogue: 0,0:00:56.09,0:00:59.09,Default,,0000,0000,0000,,На
Dialogue: 0,0:00:56.09,0:00:59.09,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:00:56.09,0:00:59.09,Default,,0000,0000,0000,,(құстардың сайрауы)
Dialogue: 0,0:00:56.09,0:00:59.09,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:00:56.09,0:00:59.09,Default,,0000,0000,0000,,Ұзын
Dialogue: 0,0:00:56.09,0:00:59.09,Default,,0000,0000,0000,,(Судың ағып жатқан дыбысы)
Dialogue: 0,0:00:59.09,0:01:02.10,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,0:00:59.09,0:01:02.10,Default,,0000,0000,0000,,(Құстардың қанат қаққан дыбысы)
Dialogue: 0,0:00:59.09,0:01:02.10,Default,,0000,0000,0000,,(құстардың сайрауы)
Dialogue: 0,0:01:02.10,0:01:04.06,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:01:08.10,0:01:15.11,Default,,0000,0000,0000,,Аққу
Dialogue: 0,0:01:08.10,0:01:15.11,Default,,0000,0000,0000,,(аққудың айқайы)
Dialogue: 0,0:01:15.11,0:01:18.08,Default,,0000,0000,0000,,Ах... әдемі.
Dialogue: 0,0:01:21.11,0:01:23.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:01:24.12,0:01:26.09,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:01:30.12,0:01:32.09,Default,,0000,0000,0000,,Шогекион
Dialogue: 0,0:01:30.12,0:01:32.09,Default,,0000,0000,0000,,(соққы дыбысы)
Dialogue: 0,0:01:32.09,0:01:39.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:39.10,0:01:41.10,Default,,0000,0000,0000,,(тықылдаған дыбыс)
Dialogue: 0,0:01:44.10,0:01:46.11,Default,,0000,0000,0000,,Ах, а... Уау!
Dialogue: 0,0:01:46.11,0:01:48.11,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:01:48.11,0:02:02.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:04.12,0:02:22.18,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:22.18,0:02:40.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:40.09,0:02:58.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:58.11,0:03:16.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:20.10,0:03:26.11,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:03:26.11,0:03:28.11,Default,,0000,0000,0000,,Онтей
Dialogue: 0,0:03:26.11,0:03:28.11,Default,,0000,0000,0000,,Аудио: zwx & Tsurou; Аударма: Basugi & Ginappuru; Өңдеу: Xiao Ke & Ariake no Tsuki; Уақыт белгілеу: Feng She; Дәстүрлі қытайшаға түрлендіру: incot; Кодтау: Lie Shu
Dialogue: 0,0:03:26.11,0:03:28.11,Default,,0000,0000,0000,,(дауыссыз дыбыс)
Dialogue: 0,0:03:28.11,0:03:39.12,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:03:28.11,0:03:39.12,Default,,0000,0000,0000,,(дауыссыз дыбыс)
Dialogue: 0,0:03:41.12,0:03:43.12,Default,,0000,0000,0000,,(дауыссыз дыбыс)
Dialogue: 0,0:03:41.12,0:03:43.12,Default,,0000,0000,0000,,Поо...!
Dialogue: 0,0:03:43.12,0:03:46.16,Default,,0000,0000,0000,,Оқиға
Dialogue: 0,0:03:43.12,0:03:46.16,Default,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:03:43.12,0:03:46.16,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:03:43.12,0:03:46.16,Default,,0000,0000,0000,,Ясуо
Dialogue: 0,0:03:43.12,0:03:46.16,Default,,0000,0000,0000,,Бұл ненің дыбысы?
Dialogue: 0,0:03:46.16,0:03:48.13,Default,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:03:46.16,0:03:48.13,Default,,0000,0000,0000,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:03:46.16,0:03:48.13,Default,,0000,0000,0000,,Музыка
Dialogue: 0,0:03:46.16,0:03:48.13,Default,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:03:46.16,0:03:48.13,Default,,0000,0000,0000,,Шизу
Dialogue: 0,0:03:46.16,0:03:48.13,Default,,0000,0000,0000,,Мүмкін мен де байқап көрермін.
Dialogue: 0,0:03:48.13,0:03:50.16,Default,,0000,0000,0000,,Косейки
Dialogue: 0,0:03:48.13,0:03:50.16,Default,,0000,0000,0000,,Энсу
Dialogue: 0,0:03:48.13,0:03:50.16,Default,,0000,0000,0000,,Бұл өте ерекше қойылым.
Dialogue: 0,0:03:50.16,0:03:55.10,Default,,0000,0000,0000,,Айтпақшы, барлығы
Dialogue: 0,0:03:50.16,0:03:55.10,Default,,0000,0000,0000,,Дүние
Dialogue: 0,0:03:50.16,0:03:55.10,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,0:03:50.16,0:03:55.10,Default,,0000,0000,0000,,Фуру
Dialogue: 0,0:03:50.16,0:03:55.10,Default,,0000,0000,0000,,Гакки
Dialogue: 0,0:03:50.16,0:03:55.10,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:03:50.16,0:03:55.10,Default,,0000,0000,0000,,Дүние жүзіндегі ең көне музыкалық аспап қандай деп ойлайсың?
Dialogue: 0,0:03:55.10,0:03:57.14,Default,,0000,0000,0000,,Тым көп
Dialogue: 0,0:03:55.10,0:03:57.14,Default,,0000,0000,0000,,Хмм, қызық, бұл не?
Dialogue: 0,0:03:57.14,0:03:59.17,Default,,0000,0000,0000,,Міне, осы.
Dialogue: 0,0:03:59.17,0:04:05.11,Default,,0000,0000,0000,,Яку
Dialogue: 0,0:03:59.17,0:04:05.11,Default,,0000,0000,0000,,Манненмае
Dialogue: 0,0:03:59.17,0:04:05.11,Default,,0000,0000,0000,,Цуку
Dialogue: 0,0:03:59.17,0:04:05.11,Default,,0000,0000,0000,,Бұл Германияда шамамен 40 000 жыл бұрын жасалған.
Dialogue: 0,0:03:59.17,0:04:05.11,Default,,0000,0000,0000,,Жақсы көр
Dialogue: 0,0:03:59.17,0:04:05.11,Default,,0000,0000,0000,,Фью
Dialogue: 0,0:03:59.17,0:04:05.11,Default,,0000,0000,0000,,Аққу сүйегінен жасалған сыбызғы.
Dialogue: 0,0:04:05.11,0:04:08.11,Default,,0000,0000,0000,,Уено
Dialogue: 0,0:04:05.11,0:04:08.11,Default,,0000,0000,0000,,Хакубутсу соққысы
Dialogue: 0,0:04:05.11,0:04:08.11,Default,,0000,0000,0000,,Іске асыру
Dialogue: 0,0:04:05.11,0:04:08.11,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:05.11,0:04:08.11,Default,,0000,0000,0000,,Нағыз нәрсені Уэнодағы мұражайдан көруге болады.
Dialogue: 0,0:04:08.11,0:04:12.15,Default,,0000,0000,0000,,Джидо
Dialogue: 0,0:04:08.11,0:04:12.15,Default,,0000,0000,0000,,Ей, бұл аққу.
Dialogue: 0,0:04:08.11,0:04:12.15,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:04:08.11,0:04:12.15,Default,,0000,0000,0000,,Үрлеуді қаламайсыз ба?
Dialogue: 0,0:04:12.15,0:04:16.12,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:04:12.15,0:04:16.12,Default,,0000,0000,0000,,Қазір барлығы үрлеп жатыр
Dialogue: 0,0:04:12.15,0:04:16.12,Default,,0000,0000,0000,,Шисон
Dialogue: 0,0:04:12.15,0:04:16.12,Default,,0000,0000,0000,,Жазу құрылғысы – соның ұрпағы.
Dialogue: 0,0:04:16.12,0:04:18.16,Default,,0000,0000,0000,,
Dialogue: 0,0:04:18.16,0:04:22.13,Default,,0000,0000,0000,,Аки
Dialogue: 0,0:04:18.16,0:04:22.13,Default,,0000,0000,0000,,Музыка
Dialogue: 0,0:04:18.16,0:04:22.13,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:04:18.16,0:04:22.13,Default,,0000,0000,0000,,Енді күзгі концерт.
Dialogue: 0,0:04:18.16,0:04:22.13,Default,,0000,0000,0000,,♬ Star Platinum
Dialogue: 0,0:04:18.16,0:04:22.13,Default,,0000,0000,0000,,Ганба
Dialogue: 0,0:04:18.16,0:04:22.13,Default,,0000,0000,0000,,Жаттығу Қолдан келгеннің бәрін жасайық!
Dialogue: 0,0:04:22.13,0:04:24.10,Default,,0000,0000,0000,,Уа!
Dialogue: 0,0:04:24.10,0:04:28.13,Default,,0000,0000,0000,,Шингоки
Dialogue: 0,0:04:24.10,0:04:28.13,Default,,0000,0000,0000,,♬～ (бағдаршам музыкасы)
Dialogue: 0,0:04:28.13,0:04:30.14,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:04:30.14,0:04:33.14,Default,,0000,0000,0000,,♬～ (Радио музыка)
Dialogue: 0,0:04:33.14,0:04:38.11,Default,,0000,0000,0000,,Хатобаба
Dialogue: 0,0:04:33.14,0:04:38.11,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:04:33.14,0:04:38.11,Default,,0000,0000,0000,,♬~ «Аймақтан шығу»
Dialogue: 0,0:04:39.18,0:04:42.12,Default,,0000,0000,0000,,⚞♬〜
Dialogue: 0,0:04:42.12,0:04:46.12,Default,,0000,0000,0000,,Қызыл
Dialogue: 0,0:04:42.12,0:04:46.12,Default,,0000,0000,0000,,Бу
Dialogue: 0,0:04:42.12,0:04:46.12,Default,,0000,0000,0000,,На
Dialogue: 0,0:04:42.12,0:04:46.12,Default,,0000,0000,0000,,(нәресте жылады)
Dialogue: 0,0:04:42.12,0:04:46.12,Default,,0000,0000,0000,,♬~ “Неннен корорийо”
Dialogue: 0,0:04:46.12,0:04:49.12,Default,,0000,0000,0000,,♬～“Окорорийо”
Dialogue: 0,0:04:49.12,0:04:53.09,Default,,0000,0000,0000,,Аққу флейтасы сондай романтикалық!
Dialogue: 0,0:04:53.09,0:04:55.09,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:04:53.09,0:04:55.09,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:04:53.09,0:04:55.09,Default,,0000,0000,0000,,Менде магнитофон жоқ...
Dialogue: 0,0:04:55.09,0:04:57.06,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:04:55.09,0:04:57.06,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,0:04:55.09,0:04:57.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:58.10,0:05:01.10,Default,,0000,0000,0000,,О.
Dialogue: 0,0:04:58.10,0:05:01.10,Default,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:04:58.10,0:05:01.10,Default,,0000,0000,0000,,Жоқ, бұл мүмкін емес!
Dialogue: 0,0:04:58.10,0:05:01.10,Default,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:04:58.10,0:05:01.10,Default,,0000,0000,0000,,Мен не істесем де, ол дыбысты шығара алмаймын!
Dialogue: 0,0:05:01.10,0:05:04.10,Default,,0000,0000,0000,,Ману
Dialogue: 0,0:05:01.10,0:05:04.10,Default,,0000,0000,0000,,Сол ақымақ дыбыс туралы айтсақ...
Dialogue: 0,0:05:04.10,0:05:07.11,Default,,0000,0000,0000,,Бұл Нобитаның босаңсытатын және бейқам «жоқ» дыбысы!
Dialogue: 0,0:05:07.11,0:05:09.11,Default,,0000,0000,0000,,(Екі адам күледі)
Dialogue: 0,0:05:09.11,0:05:11.11,Default,,0000,0000,0000,,Nigate
Dialogue: 0,0:05:09.11,0:05:11.11,Default,,0000,0000,0000,,Мен магнитофонға жақсы емеспін!
Dialogue: 0,0:05:11.11,0:05:16.08,Default,,0000,0000,0000,,Сонымен қатар, кішкене жаттығу арқылы,
Dialogue: 0,0:05:11.11,0:05:16.08,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:05:11.11,0:05:16.08,Default,,0000,0000,0000,,Кез келген адам ойнай алады!
Dialogue: 0,0:05:16.08,0:05:19.12,Default,,0000,0000,0000,,Біреу?
Dialogue: 0,0:05:16.08,0:05:19.12,Default,,0000,0000,0000,,Тіпті Нобита ма?
Dialogue: 0,0:05:19.12,0:05:23.12,Default,,0000,0000,0000,,Ах! Егер бірдеңе болса
Dialogue: 0,0:05:19.12,0:05:23.12,Default,,0000,0000,0000,,Мими
Dialogue: 0,0:05:19.12,0:05:23.12,Default,,0000,0000,0000,,Көгершін
Dialogue: 0,0:05:19.12,0:05:23.12,Default,,0000,0000,0000,,Мен құлағыма көгершінді үрлеймін!
Dialogue: 0,0:05:23.12,0:05:29.10,Default,,0000,0000,0000,,♬〜``Көгершін''
Dialogue: 0,0:05:29.10,0:05:31.10,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,0:05:29.10,0:05:31.10,Default,,0000,0000,0000,,Хэхехе...!
Dialogue: 0,0:05:31.10,0:05:35.10,Default,,0000,0000,0000,,Нобита!
Dialogue: 0,0:05:31.10,0:05:35.10,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:05:31.10,0:05:35.10,Default,,0000,0000,0000,,О-
Dialogue: 0,0:05:31.10,0:05:35.10,Default,,0000,0000,0000,,Па
Dialogue: 0,0:05:31.10,0:05:35.10,Default,,0000,0000,0000,,Концертте аяғымызды тартсаң...→
Dialogue: 0,0:05:35.10,0:05:37.10,Default,,0000,0000,0000,,Түсінесіз бе?
Dialogue: 0,0:05:37.10,0:05:39.11,Default,,0000,0000,0000,,Түсінесіз бе?
Dialogue: 0,0:05:39.11,0:05:42.11,Default,,0000,0000,0000,,Қатты жаттығу!
Dialogue: 0,0:05:39.11,0:05:42.11,Default,,0000,0000,0000,,Тыңдаңыз!
Dialogue: 0,0:05:42.11,0:05:44.11,Default,,0000,0000,0000,,(Екі адам күледі)
Dialogue: 0,0:05:44.11,0:05:48.08,Default,,0000,0000,0000,,Куу~!
Dialogue: 0,0:05:44.11,0:05:48.08,Default,,0000,0000,0000,,Мені магнитофон сияқты бір нәрсемен мазақ ет!
Dialogue: 0,0:05:48.08,0:05:52.09,Default,,0000,0000,0000,,Егер Нобита-сан да жаттығу жасаса
Dialogue: 0,0:05:48.08,0:05:52.09,Default,,0000,0000,0000,,Сіз оны ойнай алатыныңызға сенімдімін.
Dialogue: 0,0:05:52.09,0:05:54.09,Default,,0000,0000,0000,,Барымызды салайық!
Dialogue: 0,0:05:58.09,0:06:02.10,Default,,0000,0000,0000,,Дораемон...
Dialogue: 0,0:06:05.10,0:06:08.10,Default,,0000,0000,0000,,
Dialogue: 0,0:06:05.10,0:06:08.10,Default,,0000,0000,0000,,Мен үйдемін!
Dialogue: 0,0:06:08.10,0:06:10.10,Default,,0000,0000,0000,,Қайта оралуыңмен!
Dialogue: 0,0:06:10.10,0:06:12.11,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:06:12.11,0:06:14.07,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:06:12.11,0:06:14.07,Default,,0000,0000,0000,,«Мен де үлкен жанкүйермін...»
Dialogue: 0,0:06:17.08,0:06:20.08,Default,,0000,0000,0000,,Бұл драма сізді жылатады!
Dialogue: 0,0:06:22.08,0:06:27.09,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:06:22.08,0:06:27.09,Default,,0000,0000,0000,,Мен сені сағындым
Dialogue: 0,0:06:22.08,0:06:27.09,Default,,0000,0000,0000,,Менің тәтті балым...!
Dialogue: 0,0:06:27.09,0:06:29.09,Default,,0000,0000,0000,,Хира
Dialogue: 0,0:06:27.09,0:06:29.09,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:27.09,0:06:29.09,Default,,0000,0000,0000,,Дораемон….
Dialogue: 0,0:06:29.09,0:06:32.09,Default,,0000,0000,0000,,Теріс
Dialogue: 0,0:06:29.09,0:06:32.09,Default,,0000,0000,0000,,Менің өтінішім бар... Иә?
Dialogue: 0,0:06:32.09,0:06:34.09,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:32.09,0:06:34.09,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:34.09,0:06:36.10,Default,,0000,0000,0000,,Ештеңе Ештеңе!
Dialogue: 0,0:06:36.10,0:06:38.10,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:06:36.10,0:06:38.10,Default,,0000,0000,0000,,Сіз бірдеңені жасырдыңыз!
Dialogue: 0,0:06:38.10,0:06:40.10,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:06:38.10,0:06:40.10,Default,,0000,0000,0000,,Жоқ, олай емес. бұл….
Dialogue: 0,0:06:41.10,0:06:43.10,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:06:41.10,0:06:43.10,Default,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:06:41.10,0:06:43.10,Default,,0000,0000,0000,,Әй, дораяки!
Dialogue: 0,0:06:43.10,0:06:46.11,Default,,0000,0000,0000,,Не болды? Сонша көп.
Dialogue: 0,0:06:43.10,0:06:46.11,Default,,0000,0000,0000,,Бұл… бұл….
Dialogue: 0,0:06:47.11,0:06:49.14,Default,,0000,0000,0000,,Хехехе… Біраз мақтанып қояйын
Dialogue: 0,0:06:47.11,0:06:49.14,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:49.14,0:06:52.11,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:06:49.14,0:06:52.11,Default,,0000,0000,0000,,Жоқ! Қайтарыңыз!
Dialogue: 0,0:06:49.14,0:06:52.11,Default,,0000,0000,0000,,Никки
Dialogue: 0,0:06:49.14,0:06:52.11,Default,,0000,0000,0000,,Не? бұл! күнделік?
Dialogue: 0,0:06:52.11,0:06:55.11,Default,,0000,0000,0000,,Егер ол жұмыс істемесе...!
Dialogue: 0,0:06:55.11,0:06:58.12,Default,,0000,0000,0000,,Бүгін
Dialogue: 0,0:06:55.11,0:06:58.12,Default,,0000,0000,0000,,«Бүгін
Dialogue: 0,0:06:55.11,0:06:58.12,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:55.11,0:06:58.12,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:06:55.11,0:06:58.12,Default,,0000,0000,0000,,Мен 20 дораяки жедім».
Dialogue: 0,0:06:58.12,0:07:01.12,Default,,0000,0000,0000,,Енді оны жемейсің бе?
Dialogue: 0,0:07:01.12,0:07:03.12,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:07:03.12,0:07:05.12,Default,,0000,0000,0000,,Бұл алдын ала күнделік.
Dialogue: 0,0:07:05.12,0:07:08.13,Default,,0000,0000,0000,,Кез келген нәрсе
Dialogue: 0,0:07:05.12,0:07:08.13,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:07:05.12,0:07:08.13,Default,,0000,0000,0000,,Күнделігіме жазғанымдай болып шықты.
Dialogue: 0,0:07:08.13,0:07:12.13,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:07:08.13,0:07:12.13,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:07:08.13,0:07:12.13,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:07:08.13,0:07:12.13,Default,,0000,0000,0000,,Күрделі
Dialogue: 0,0:07:08.13,0:07:12.13,Default,,0000,0000,0000,,Бірақ бұл күнделікті пайдалану қиын!
Dialogue: 0,0:07:12.13,0:07:17.10,Default,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:07:12.13,0:07:17.10,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:07:12.13,0:07:17.10,Default,,0000,0000,0000,,Сондықтан мен оны саған ешқашан қарызға бермеймін!
Dialogue: 0,0:07:12.13,0:07:17.10,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:07:17.10,0:07:19.11,Default,,0000,0000,0000,,Әй, егеуқұйрық!
Dialogue: 0,0:07:17.10,0:07:19.11,Default,,0000,0000,0000,,Да...! Егеуқұйрық! ?
Dialogue: 0,0:07:20.11,0:07:22.14,Default,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:07:20.11,0:07:22.14,Default,,0000,0000,0000,,Ах! О, қорқынышты қорқынышты ...
Dialogue: 0,0:07:22.14,0:07:26.11,Default,,0000,0000,0000,,Мимачига
Dialogue: 0,0:07:22.14,0:07:26.11,Default,,0000,0000,0000,,Кешіріңіз, кешіріңіз! Мен қате түсінген сияқтымын.
Dialogue: 0,0:07:26.11,0:07:28.18,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:07:26.11,0:07:28.18,Default,,0000,0000,0000,,Шынымен...?
Dialogue: 0,0:07:28.18,0:07:32.08,Default,,0000,0000,0000,,Одо
Dialogue: 0,0:07:28.18,0:07:32.08,Default,,0000,0000,0000,,Енді мені қорқытпа.
Dialogue: 0,0:07:28.18,0:07:32.08,Default,,0000,0000,0000,,Кешіріңіз. Кешіріңіз. иә.
Dialogue: 0,0:07:32.08,0:07:35.12,Default,,0000,0000,0000,,Ах~ Жақсы...
Dialogue: 0,0:07:35.12,0:07:38.09,Default,,0000,0000,0000,,Шукудай
Dialogue: 0,0:07:35.12,0:07:38.09,Default,,0000,0000,0000,,Олай болса, мен үй тапсырмасын орындайын!
Dialogue: 0,0:07:38.09,0:07:41.09,Default,,0000,0000,0000,,Аа, мен бұл туралы ойласам
Dialogue: 0,0:07:38.09,0:07:41.09,Default,,0000,0000,0000,,«және күн сайын күрсінемін.»
Dialogue: 0,0:07:38.09,0:07:41.09,Default,,0000,0000,0000,,Сенің маған бұрын бір қатысың бар сияқты көрінді.
Dialogue: 0,0:07:41.09,0:07:43.06,Default,,0000,0000,0000,,Кайкецу
Dialogue: 0,0:07:41.09,0:07:43.06,Default,,0000,0000,0000,,Жарайды, себебі ол шешіліп қойған.
Dialogue: 0,0:07:44.10,0:07:46.10,Default,,0000,0000,0000,,Иә! Жарайды онда.
Dialogue: 0,0:07:46.10,0:07:49.07,Default,,0000,0000,0000,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:07:46.10,0:07:49.07,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:07:46.10,0:07:49.07,Default,,0000,0000,0000,,Иә? Қар жаумай ма?
Dialogue: 0,0:07:50.17,0:07:52.17,Default,,0000,0000,0000,,Сайкоу
Dialogue: 0,0:07:50.17,0:07:52.17,Default,,0000,0000,0000,,⚞Ах~ Керемет!
Dialogue: 0,0:07:54.11,0:07:58.08,Default,,0000,0000,0000,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:07:54.11,0:07:58.08,Default,,0000,0000,0000,,Хэхехе... Хаха~ Хахахаха...!
Dialogue: 0,0:07:58.08,0:08:02.08,Default,,0000,0000,0000,,Барлығы жазылғандай бола ма?
Dialogue: 0,0:07:58.08,0:08:02.08,Default,,0000,0000,0000,,Осы менде болса ғой...!
Dialogue: 0,0:08:13.19,0:08:16.16,Default,,0000,0000,0000,,О.
Dialogue: 0,0:08:13.19,0:08:16.16,Default,,0000,0000,0000,,⚞Нобита! Оян!
Dialogue: 0,0:08:18.10,0:08:20.13,Default,,0000,0000,0000,,Нобита?
Dialogue: 0,0:08:20.13,0:08:22.13,Default,,0000,0000,0000,,Келесі
Dialogue: 0,0:08:20.13,0:08:22.13,Default,,0000,0000,0000,,«Келесі жаңалықтар».
Dialogue: 0,0:08:20.13,0:08:22.13,Default,,0000,0000,0000,,Жалпы...
Dialogue: 0,0:08:22.13,0:08:25.14,Default,,0000,0000,0000,,Шоуаксейтан Саки
Dialogue: 0,0:08:22.13,0:08:25.14,Default,,0000,0000,0000,,Екі
Dialogue: 0,0:08:22.13,0:08:25.14,Default,,0000,0000,0000,,«Астероидты зерттеуші Vulture 2 →
Dialogue: 0,0:08:25.14,0:08:28.14,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:08:25.14,0:08:28.14,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:08:25.14,0:08:28.14,Default,,0000,0000,0000,,Урашима астероидынан әкелінген үлгілер
Dialogue: 0,0:08:25.14,0:08:28.14,Default,,0000,0000,0000,,Хое
Dialogue: 0,0:08:25.14,0:08:28.14,Default,,0000,0000,0000,,Денсаулық
Dialogue: 0,0:08:25.14,0:08:28.14,Default,,0000,0000,0000,,Егжей-тегжейлі зерттеу →
Dialogue: 0,0:08:28.14,0:08:33.15,Default,,0000,0000,0000,,Жапония
Dialogue: 0,0:08:28.14,0:08:33.15,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:08:28.14,0:08:33.15,Default,,0000,0000,0000,,Дүние
Dialogue: 0,0:08:28.14,0:08:33.15,Default,,0000,0000,0000,,Кагакуша
Dialogue: 0,0:08:28.14,0:08:33.15,Default,,0000,0000,0000,,Дүние жүзінен, соның ішінде Жапониядан келген ғалымдар тобы.
Dialogue: 0,0:08:28.14,0:08:33.15,Default,,0000,0000,0000,,Күйе
Dialogue: 0,0:08:28.14,0:08:33.15,Default,,0000,0000,0000,,Орындалуда».
Dialogue: 0,0:08:34.15,0:08:39.12,Default,,0000,0000,0000,,Бұлай емес.
Dialogue: 0,0:08:34.15,0:08:39.12,Default,,0000,0000,0000,,(Мектеп хабары)
Dialogue: 0,0:08:34.15,0:08:39.12,Default,,0000,0000,0000,,Кезең
Dialogue: 0,0:08:34.15,0:08:39.12,Default,,0000,0000,0000,,«Аа... а... 1 сағат басталады».
Dialogue: 0,0:08:39.12,0:08:41.12,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:08:41.12,0:08:44.12,Default,,0000,0000,0000,,Қоңырау Не болды?
Dialogue: 0,0:08:44.12,0:08:48.09,Default,,0000,0000,0000,,Джугио
Dialogue: 0,0:08:44.12,0:08:48.09,Default,,0000,0000,0000,,Иә, музыка сабағын бастайық...
Dialogue: 0,0:08:48.09,0:08:50.13,Default,,0000,0000,0000,,Хаттори
Dialogue: 0,0:08:48.09,0:08:50.13,Default,,0000,0000,0000,,Ах, Хаттори мырза, сәл күте тұрыңыз.
Dialogue: 0,0:08:50.13,0:08:56.10,Default,,0000,0000,0000,,Iso
Dialogue: 0,0:08:50.13,0:08:56.10,Default,,0000,0000,0000,,Отбасы
Dialogue: 0,0:08:50.13,0:08:56.10,Default,,0000,0000,0000,,Ренраку
Dialogue: 0,0:08:50.13,0:08:56.10,Default,,0000,0000,0000,,Маған үйдегілер телефон соғып, үйге тез келуімді өтінді.
Dialogue: 0,0:08:50.13,0:08:56.10,Default,,0000,0000,0000,,Жақсы. түсіндім.
Dialogue: 0,0:08:56.10,0:09:01.17,Default,,0000,0000,0000,,Күрсін... Сонымен
Dialogue: 0,0:08:56.10,0:09:01.17,Default,,0000,0000,0000,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,0:08:56.10,0:09:01.17,Default,,0000,0000,0000,,Бірінші сағат – бос уақыт.
Dialogue: 0,0:09:01.17,0:09:03.08,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:09:03.08,0:09:05.08,Default,,0000,0000,0000,,Доджбол ойнайық!
Dialogue: 0,0:09:05.08,0:09:10.12,Default,,0000,0000,0000,,Бұл мүлде ақау…
Dialogue: 0,0:09:05.08,0:09:10.12,Default,,0000,0000,0000,,Мен жасадым! Музыка сабағы бітті!
Dialogue: 0,0:09:10.12,0:09:12.12,Default,,0000,0000,0000,,Бұл күнделік керемет!
Dialogue: 0,0:09:12.12,0:09:15.09,Default,,0000,0000,0000,,Шынында да мен жазғандай болып шықты!
Dialogue: 0,0:09:17.09,0:09:21.09,Default,,0000,0000,0000,,Қолдану керек пе... Қолданбау керек пе...!
Dialogue: 0,0:09:23.10,0:09:25.10,Default,,0000,0000,0000,,Оны қолданыңыз!
Dialogue: 0,0:09:25.10,0:09:28.10,Default,,0000,0000,0000,,Аха~ Бүгін 50 дана алмақсың ба?
Dialogue: 0,0:09:25.10,0:09:28.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:28.10,0:09:30.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:32.10,0:09:34.11,Default,,0000,0000,0000,,Бұл... бұл...!
Dialogue: 0,0:09:34.11,0:09:37.14,Default,,0000,0000,0000,,Миккабузу
Dialogue: 0,0:09:34.11,0:09:37.14,Default,,0000,0000,0000,,Нобита-кунның үш күндік монах күнделігі...
Dialogue: 0,0:09:37.14,0:09:40.11,Default,,0000,0000,0000,,⚟Дора-чан, күт!
Dialogue: 0,0:09:40.11,0:09:42.08,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:09:40.11,0:09:42.08,Default,,0000,0000,0000,,«Мен кез келген нәрсені кесіп аламын».
Dialogue: 0,0:09:40.11,0:09:42.08,Default,,0000,0000,0000,,«Бұл рас!»
Dialogue: 0,0:09:42.08,0:09:44.05,Default,,0000,0000,0000,,Ай
Dialogue: 0,0:09:42.08,0:09:44.05,Default,,0000,0000,0000,,«Махаббатты бұзуға болмайды!»
Dialogue: 0,0:09:42.08,0:09:44.05,Default,,0000,0000,0000,,♬～ (Драмалық музыка)
Dialogue: 0,0:09:45.08,0:09:47.09,Default,,0000,0000,0000,,«Бұл шынымен мүмкін бе?»
Dialogue: 0,0:09:45.08,0:09:47.09,Default,,0000,0000,0000,,♬ ~ «Таза жүрек»
Dialogue: 0,0:09:48.09,0:09:50.09,Default,,0000,0000,0000,,Шин
Dialogue: 0,0:09:48.09,0:09:50.09,Default,,0000,0000,0000,,«Мен сенбеймін...»
Dialogue: 0,0:09:48.09,0:09:50.09,Default,,0000,0000,0000,,♬～ (Драмалық музыка)
Dialogue: 0,0:09:50.09,0:09:52.09,Default,,0000,0000,0000,,Не болып жатыр? Бұл теледидар!
Dialogue: 0,0:09:50.09,0:09:52.09,Default,,0000,0000,0000,,(тықылдаған дыбыс)
Dialogue: 0,0:09:52.09,0:09:54.16,Default,,0000,0000,0000,,Жақсы жер болса да!
Dialogue: 0,0:09:52.09,0:09:54.16,Default,,0000,0000,0000,,(тықылдаған дыбыс)
Dialogue: 0,0:09:54.16,0:09:57.13,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:09:54.16,0:09:57.13,Default,,0000,0000,0000,,Йокан
Dialogue: 0,0:09:54.16,0:09:57.13,Default,,0000,0000,0000,,Менде жағымсыз сезім бар...
Dialogue: 0,0:09:54.16,0:09:57.13,Default,,0000,0000,0000,,Бұл! Ха!
Dialogue: 0,0:10:09.14,0:10:22.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:10:23.16,0:10:26.13,Default,,0000,0000,0000,,♬~ “Такея~ Сао…да…ке…”
Dialogue: 0,0:10:23.16,0:10:26.13,Default,,0000,0000,0000,,Асо
Dialogue: 0,0:10:23.16,0:10:26.13,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:10:23.16,0:10:26.13,Default,,0000,0000,0000,,Бүгін менің үйіме келгің келе ме?
Dialogue: 0,0:10:26.13,0:10:28.09,Default,,0000,0000,0000,,
Dialogue: 0,0:10:26.13,0:10:28.09,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:10:26.13,0:10:28.09,Default,,0000,0000,0000,,Go Go!
Dialogue: 0,0:10:28.09,0:10:31.10,Default,,0000,0000,0000,,Иә? Бірақ
Dialogue: 0,0:10:28.09,0:10:31.10,Default,,0000,0000,0000,,Кейко
Dialogue: 0,0:10:28.09,0:10:31.10,Default,,0000,0000,0000,,Бүгін сізде фортепиано сабағы болған жоқ па?
Dialogue: 0,0:10:31.10,0:10:34.10,Default,,0000,0000,0000,,Кайгай Риоко
Dialogue: 0,0:10:31.10,0:10:34.10,Default,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:10:31.10,0:10:34.10,Default,,0000,0000,0000,,Менің ұстазым шетелге іссапарға кетті.
Dialogue: 0,0:10:34.10,0:10:37.14,Default,,0000,0000,0000,,Кейін кездескенше!
Dialogue: 0,0:10:34.10,0:10:37.14,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:10:37.14,0:10:39.11,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:10:39.11,0:10:42.11,Default,,0000,0000,0000,,Уау! А... сәл күте тұрыңыз... күтіңіз!
Dialogue: 0,0:10:42.11,0:10:45.18,Default,,0000,0000,0000,,Бір рет
Dialogue: 0,0:10:42.11,0:10:45.18,Default,,0000,0000,0000,,Күтілгендей! Сіз оны рұқсатсыз пайдаландыңыз!
Dialogue: 0,0:10:42.11,0:10:45.18,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,0:10:45.18,0:10:50.12,Default,,0000,0000,0000,,Егер сіз оған жазсаңыз
Dialogue: 0,0:10:45.18,0:10:50.12,Default,,0000,0000,0000,,Музыка сабақтары шынымен жоғалып кетті!
Dialogue: 0,0:10:50.12,0:10:53.12,Default,,0000,0000,0000,,Диктофон жаттығуы
Dialogue: 0,0:10:50.12,0:10:53.12,Default,,0000,0000,0000,,Енді мен мұны істеудің қажеті жоқ!
Dialogue: 0,0:10:53.12,0:10:57.12,Default,,0000,0000,0000,,«Бүгін музыка болған жоқ, көңілді болды».
Dialogue: 0,0:10:57.12,0:11:00.09,Default,,0000,0000,0000,,Түсіндім! Түсіндім!
Dialogue: 0,0:11:00.09,0:11:02.09,Default,,0000,0000,0000,,Нобита-кунның кесірінен музыка сабағы болмады→
Dialogue: 0,0:11:02.09,0:11:06.10,Default,,0000,0000,0000,,Музыканың өзі
Dialogue: 0,0:11:02.09,0:11:06.10,Default,,0000,0000,0000,,Бұл дүниенің түкпір-түкпірінен кетті!
Dialogue: 0,0:11:06.10,0:11:08.10,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:11:08.10,0:11:11.17,Default,,0000,0000,0000,,...
Dialogue: 0,0:11:08.10,0:11:11.17,Default,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,0:11:11.17,0:11:13.11,Default,,0000,0000,0000,,Сіз...
Dialogue: 0,0:11:11.17,0:11:13.11,Default,,0000,0000,0000,,⚞ (нәресте жылауы)
Dialogue: 0,0:11:13.11,0:11:19.11,Default,,0000,0000,0000,,Нененкорори….
Dialogue: 0,0:11:13.11,0:11:19.11,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:11:13.11,0:11:19.11,Default,,0000,0000,0000,,(жөтел)
Dialogue: 0,0:11:19.11,0:11:22.08,Default,,0000,0000,0000,,Кейтайденва
Dialogue: 0,0:11:19.11,0:11:22.08,Default,,0000,0000,0000,,Чакушинон
Dialogue: 0,0:11:19.11,0:11:22.08,Default,,0000,0000,0000,,(Ұялы телефон рингтоны)
Dialogue: 0,0:11:22.08,0:11:24.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:27.15,0:11:31.12,Default,,0000,0000,0000,,Хой тарағы
Dialogue: 0,0:11:27.15,0:11:31.12,Default,,0000,0000,0000,,Ән
Dialogue: 0,0:11:27.15,0:11:31.12,Default,,0000,0000,0000,,Кәне, ән айтайық.
Dialogue: 0,0:11:27.15,0:11:31.12,Default,,0000,0000,0000,,Енджи
Dialogue: 0,0:11:27.15,0:11:31.12,Default,,0000,0000,0000,,Уа!
Dialogue: 0,0:11:31.12,0:11:34.16,Default,,0000,0000,0000,,(Электон)
Dialogue: 0,0:11:31.12,0:11:34.16,Default,,0000,0000,0000,,Не? кінә?
Dialogue: 0,0:11:34.16,0:11:36.10,Default,,0000,0000,0000,,болды
Dialogue: 0,0:11:34.16,0:11:36.10,Default,,0000,0000,0000,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:11:36.10,0:11:39.07,Default,,0000,0000,0000,,Уау! Барлығы тоқта!
Dialogue: 0,0:11:41.10,0:11:44.24,Default,,0000,0000,0000,,Энсу
Dialogue: 0,0:11:41.10,0:11:44.24,Default,,0000,0000,0000,,♬～(көрсетілім)
Dialogue: 0,0:11:41.10,0:11:44.24,Default,,0000,0000,0000,,
Dialogue: 0,0:11:44.24,0:11:48.11,Default,,0000,0000,0000,,Нандом
Dialogue: 0,0:11:44.24,0:11:48.11,Default,,0000,0000,0000,,Әй, бүгін неше рет болды?
Dialogue: 0,0:11:44.24,0:11:48.11,Default,,0000,0000,0000,,Қате
Dialogue: 0,0:11:44.24,0:11:48.11,Default,,0000,0000,0000,,Тіпті сен қателестің!
Dialogue: 0,0:11:48.11,0:11:50.24,Default,,0000,0000,0000,,Кай-сан
Dialogue: 0,0:11:48.11,0:11:50.24,Default,,0000,0000,0000,,Топ таратылды!
Dialogue: 0,0:11:48.11,0:11:50.24,Default,,0000,0000,0000,,ашуланшақ
Dialogue: 0,0:11:48.11,0:11:50.24,Default,,0000,0000,0000,,Не?!
Dialogue: 0,0:11:50.24,0:11:55.11,Default,,0000,0000,0000,,...
Dialogue: 0,0:11:50.24,0:11:55.11,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:11:50.24,0:11:55.11,Default,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:11:50.24,0:11:55.11,Default,,0000,0000,0000,,Өтірік! ? Мен 200 әннің барлық деректерін жойдым!
Dialogue: 0,0:11:55.11,0:11:58.15,Default,,0000,0000,0000,,Дансей
Dialogue: 0,0:11:55.11,0:11:58.15,Default,,0000,0000,0000,,Бізде де демалыс бар! ?
Dialogue: 0,0:11:55.11,0:11:58.15,Default,,0000,0000,0000,,...
Dialogue: 0,0:11:55.11,0:11:58.15,Default,,0000,0000,0000,,Хасан
Dialogue: 0,0:11:55.11,0:11:58.15,Default,,0000,0000,0000,,Мен стресстен арылғым келеді!
Dialogue: 0,0:11:58.15,0:12:03.12,Default,,0000,0000,0000,,Энка
Dialogue: 0,0:11:58.15,0:12:03.12,Default,,0000,0000,0000,,«Enka уақыты келді.
Dialogue: 0,0:11:58.15,0:12:03.12,Default,,0000,0000,0000,,Йотей
Dialogue: 0,0:11:58.15,0:12:03.12,Default,,0000,0000,0000,,Хенко
Dialogue: 0,0:11:58.15,0:12:03.12,Default,,0000,0000,0000,,Біз жаңалықтарды басқа уақытқа ауыстырамыз және таратамыз».
Dialogue: 0,0:12:03.12,0:12:05.19,Default,,0000,0000,0000,,
Dialogue: 0,0:12:03.12,0:12:05.19,Default,,0000,0000,0000,,...
Dialogue: 0,0:12:03.12,0:12:05.19,Default,,0000,0000,0000,,Мен асығыспын!
Dialogue: 0,0:12:05.19,0:12:10.13,Default,,0000,0000,0000,,Дораемон….
Dialogue: 0,0:12:05.19,0:12:10.13,Default,,0000,0000,0000,,Барлығы тітіркенген сияқты.
Dialogue: 0,0:12:10.13,0:12:14.10,Default,,0000,0000,0000,,Енді түсіндің бе?
Dialogue: 0,0:12:10.13,0:12:14.10,Default,,0000,0000,0000,,Музыка болмаса не болады?
Dialogue: 0,0:12:14.10,0:12:17.10,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:12:14.10,0:12:17.10,Default,,0000,0000,0000,,Түсіндім, тез бірдеңе істе!
Dialogue: 0,0:12:21.11,0:12:25.08,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:12:25.08,0:12:28.08,Default,,0000,0000,0000,,Біздің музыка осындай ма?
Dialogue: 0,0:12:30.08,0:12:33.09,Default,,0000,0000,0000,,♬～(Орындалу)
Dialogue: 0,0:12:30.08,0:12:33.09,Default,,0000,0000,0000,,Ақыр соңында, топ тастамайды!
Dialogue: 0,0:12:34.15,0:12:38.12,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:12:34.15,0:12:38.12,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:12:34.15,0:12:38.12,Default,,0000,0000,0000,,Келесі жолы итіңізбен келіңіз.
Dialogue: 0,0:12:34.15,0:12:38.12,Default,,0000,0000,0000,,Жоқ, мен ән айттым! Мен ән айттым!
Dialogue: 0,0:12:38.12,0:12:41.09,Default,,0000,0000,0000,,...
Dialogue: 0,0:12:38.12,0:12:41.09,Default,,0000,0000,0000,,Маған бұл ән ұнайды!
Dialogue: 0,0:12:38.12,0:12:41.09,Default,,0000,0000,0000,,Шинкиоку
Dialogue: 0,0:12:38.12,0:12:41.09,Default,,0000,0000,0000,,Бұл Минаның жаңа әні!
Dialogue: 0,0:12:42.16,0:12:45.13,Default,,0000,0000,0000,,Күрсін... Бұл жақсы.
Dialogue: 0,0:12:46.10,0:12:50.10,Default,,0000,0000,0000,,♬～ “А, аа, жарқырай…”
Dialogue: 0,0:12:50.10,0:12:52.10,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:12:50.10,0:12:52.10,Default,,0000,0000,0000,,бәрібір.
Dialogue: 0,0:12:50.10,0:12:52.10,Default,,0000,0000,0000,,Хэхехе...
Dialogue: 0,0:12:56.08,0:12:58.11,Default,,0000,0000,0000,,Сіз кімсіз...!
Dialogue: 0,0:12:58.11,0:13:02.08,Default,,0000,0000,0000,,Құралдар
Dialogue: 0,0:12:58.11,0:13:02.08,Default,,0000,0000,0000,,Тайо
Dialogue: 0,0:12:58.11,0:13:02.08,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:12:58.11,0:13:02.08,Default,,0000,0000,0000,,Ара-тұра құралдарға сүйенбей, өз бетіңізше жаттығу жасаңыз!
Dialogue: 0,0:13:04.12,0:13:06.09,Default,,0000,0000,0000,,Сәлем...
Dialogue: 0,0:13:06.09,0:13:11.19,Default,,0000,0000,0000,,Қазірдің өзінде! Нобита-кун оны пайдаланған кезде
Dialogue: 0,0:13:06.09,0:13:11.19,Default,,0000,0000,0000,,Бұл жаман болмайды!
Dialogue: 0,0:13:11.19,0:13:14.09,Default,,0000,0000,0000,,⚟Дора-чан?
Dialogue: 0,0:13:11.19,0:13:14.09,Default,,0000,0000,0000,,Тек
Dialogue: 0,0:13:11.19,0:13:14.09,Default,,0000,0000,0000,,Менде тағы да дораяки болды.
Dialogue: 0,0:13:14.09,0:13:16.13,Default,,0000,0000,0000,,Дораяки~! ?
Dialogue: 0,0:13:16.13,0:13:18.10,Default,,0000,0000,0000,,Дораяки!
Dialogue: 0,0:13:19.17,0:13:21.13,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:13:19.17,0:13:21.13,Default,,0000,0000,0000,,«Менімен бірге қаш»
Dialogue: 0,0:13:19.17,0:13:21.13,Default,,0000,0000,0000,,Куни
Dialogue: 0,0:13:19.17,0:13:21.13,Default,,0000,0000,0000,,«Мен елмін...»
Dialogue: 0,0:13:21.13,0:13:23.10,Default,,0000,0000,0000,,♬～ (Драмалық музыка)
Dialogue: 0,0:13:21.13,0:13:23.10,Default,,0000,0000,0000,,А, мен қатты тітіркендім!
Dialogue: 0,0:13:23.10,0:13:35.11,Default,,0000,0000,0000,,♬～ (Радио музыка)
Dialogue: 0,0:13:40.12,0:13:44.12,Default,,0000,0000,0000,,Жұмыртқа
Dialogue: 0,0:13:40.12,0:13:44.12,Default,,0000,0000,0000,,Нику
Dialogue: 0,0:13:40.12,0:13:44.12,Default,,0000,0000,0000,,Ал, жұмыртқа мен тартылған ет...
Dialogue: 0,0:13:44.12,0:13:46.13,Default,,0000,0000,0000,,О...
Dialogue: 0,0:13:48.09,0:13:52.10,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:13:48.09,0:13:52.10,Default,,0000,0000,0000,,Хо
Dialogue: 0,0:13:48.09,0:13:52.10,Default,,0000,0000,0000,,Нобитаның күнделігі? Осы жерде қалдырыңыз!
Dialogue: 0,0:13:53.10,0:13:57.14,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:13:57.14,0:14:01.11,Default,,0000,0000,0000,,(«жоқ» дыбысы)
Dialogue: 0,0:13:57.14,0:14:01.11,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:13:57.14,0:14:01.11,Default,,0000,0000,0000,,Сіз бұлай жақсы ойнай алмайсыз.
Dialogue: 0,0:14:01.11,0:14:07.11,Default,,0000,0000,0000,,Музыка
Dialogue: 0,0:14:01.11,0:14:07.11,Default,,0000,0000,0000,,А, а... музыка.
Dialogue: 0,0:14:01.11,0:14:07.11,Default,,0000,0000,0000,,Мен ол жерде болмағанын қалаймын ...
Dialogue: 0,0:14:11.12,0:14:13.12,Default,,0000,0000,0000,,Понмюэй!
Dialogue: 0,0:14:13.12,0:14:18.09,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:14:13.12,0:14:18.09,Default,,0000,0000,0000,,Иә! ? Ал... сен қайдансың?
Dialogue: 0,0:14:19.12,0:14:21.09,Default,,0000,0000,0000,,Понмюи Мюи!
Dialogue: 0,0:14:21.09,0:14:24.10,Default,,0000,0000,0000,,Гайкокуго
Dialogue: 0,0:14:21.09,0:14:24.10,Default,,0000,0000,0000,,Шет тілі? Не... не істеуім керек?
Dialogue: 0,0:14:24.10,0:14:27.10,Default,,0000,0000,0000,,Мен... Ханасенай Эйго!
Dialogue: 0,0:14:27.10,0:14:30.07,Default,,0000,0000,0000,,Муммю?
Dialogue: 0,0:14:27.10,0:14:30.07,Default,,0000,0000,0000,,Сонымен… бұл….
Dialogue: 0,0:14:32.10,0:14:36.11,Default,,0000,0000,0000,,Иә! Ха!
Dialogue: 0,0:14:32.10,0:14:36.11,Default,,0000,0000,0000,,Иә? Диктофон?
Dialogue: 0,0:14:36.11,0:14:39.08,Default,,0000,0000,0000,,Дыбыстық сигнал сигналдық сигнал....
Dialogue: 0,0:14:36.11,0:14:39.08,Default,,0000,0000,0000,,Сіз үрлеуді айтасыз ба?
Dialogue: 0,0:14:39.08,0:14:41.08,Default,,0000,0000,0000,,Дыбыстық сигнал сигналы.
Dialogue: 0,0:14:42.08,0:14:45.08,Default,,0000,0000,0000,,Гета
Dialogue: 0,0:14:42.08,0:14:45.08,Default,,0000,0000,0000,,Бірақ бұл өте жаман...
Dialogue: 0,0:14:45.08,0:14:47.12,Default,,0000,0000,0000,,Менің!
Dialogue: 0,0:14:47.12,0:14:49.09,Default,,0000,0000,0000,,Мен... түсіндім.
Dialogue: 0,0:14:52.09,0:14:54.13,Default,,0000,0000,0000,,Екі
Dialogue: 0,0:14:52.09,0:14:54.13,Default,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:14:52.09,0:14:54.13,Default,,0000,0000,0000,,(Тыныс алу дыбысы)
Dialogue: 0,0:14:54.13,0:14:57.10,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:14:57.10,0:14:59.10,Default,,0000,0000,0000,,(«жоқ» дыбысы)
Dialogue: 0,0:14:59.10,0:15:03.10,Default,,0000,0000,0000,,Кюхахаха! Ахахха!
Dialogue: 0,0:14:59.10,0:15:03.10,Default,,0000,0000,0000,,Ахахахаха...!
Dialogue: 0,0:15:03.10,0:15:07.11,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:15:03.10,0:15:07.11,Default,,0000,0000,0000,,Сондықтан мен сенің бұл ісің жақсы емес дедім!
Dialogue: 0,0:15:03.10,0:15:07.11,Default,,0000,0000,0000,,Менің! Мьюидікі!
Dialogue: 0,0:15:08.11,0:15:11.08,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:15:11.08,0:15:13.08,Default,,0000,0000,0000,,(«жоқ» дыбысы)
Dialogue: 0,0:15:13.08,0:15:20.19,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:15:20.19,0:15:25.19,Default,,0000,0000,0000,,♬～(Диктофон)
Dialogue: 0,0:15:20.19,0:15:25.19,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:25.19,0:15:31.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:31.10,0:15:35.10,Default,,0000,0000,0000,,(«жоқ» дыбысы)
Dialogue: 0,0:15:31.10,0:15:35.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:35.10,0:15:37.10,Default,,0000,0000,0000,,22 мамыр: Біз Аоямада бір-бірімізге дәптерлерімізді көрсетеміз.
Dialogue: 0,0:15:37.10,0:15:42.11,Default,,0000,0000,0000,,Ән
Dialogue: 0,0:15:37.10,0:15:42.11,Default,,0000,0000,0000,,♬～(ән)
Dialogue: 0,0:15:42.11,0:15:58.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:58.09,0:16:13.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:13.11,0:16:16.11,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:16:16.11,0:16:42.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:44.10,0:16:47.14,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:16:44.10,0:16:47.14,Default,,0000,0000,0000,,Керемет! Мен мұндай нәрсені бірінші рет жасап тұрмын.
Dialogue: 0,0:16:47.14,0:16:49.14,Default,,0000,0000,0000,,Матсуда мырза өледі.
Dialogue: 0,0:16:47.14,0:16:49.14,Default,,0000,0000,0000,,Сіз кімсіз...?
Dialogue: 0,0:16:49.14,0:16:52.11,Default,,0000,0000,0000,,Иә? иә?
Dialogue: 0,0:16:53.11,0:16:55.11,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:16:53.11,0:16:55.11,Default,,0000,0000,0000,,Ол жоғалып кетті...
Dialogue: 0,0:16:57.12,0:16:59.12,Default,,0000,0000,0000,,Мияу….
Dialogue: 0,0:16:59.12,0:17:07.13,Default,,0000,0000,0000,,Ханаута
Dialogue: 0,0:16:59.12,0:17:07.13,Default,,0000,0000,0000,,♬～(мырылдау)
Dialogue: 0,0:17:07.13,0:17:09.13,Default,,0000,0000,0000,,♬～(мырылдау)
Dialogue: 0,0:17:09.13,0:17:12.10,Default,,0000,0000,0000,,Ванна
Dialogue: 0,0:17:09.13,0:17:12.10,Default,,0000,0000,0000,,Жарық
Dialogue: 0,0:17:09.13,0:17:12.10,Default,,0000,0000,0000,,Ваннада жақсы естіледі.
Dialogue: 0,0:17:09.13,0:17:12.10,Default,,0000,0000,0000,,Қандай ән?
Dialogue: 0,0:17:12.10,0:17:14.10,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:17:12.10,0:17:14.10,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:17:12.10,0:17:14.10,Default,,0000,0000,0000,,О...?
Dialogue: 0,0:17:15.10,0:17:18.10,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:17:15.10,0:17:18.10,Default,,0000,0000,0000,,Mystery
Dialogue: 0,0:17:15.10,0:17:18.10,Default,,0000,0000,0000,,Ол бала біртүрлі бала еді.
Dialogue: 0,0:17:21.11,0:17:27.11,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:17:27.11,0:17:29.11,Default,,0000,0000,0000,,(«жоқ» дыбысы)
Dialogue: 0,0:17:29.11,0:17:31.12,Default,,0000,0000,0000,,Сәлем! Нобита!
Dialogue: 0,0:17:31.12,0:17:34.12,Default,,0000,0000,0000,,♬ ~ “Лала ла ла ла ла ла”
Dialogue: 0,0:17:34.12,0:17:36.09,Default,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:17:34.12,0:17:36.09,Default,,0000,0000,0000,,Иә? Бұл дауыс...
Dialogue: 0,0:17:36.09,0:17:43.10,Default,,0000,0000,0000,,♬ ~ «Рах-рах-рах-рах-рах-рах»
Dialogue: 0,0:17:44.10,0:17:47.17,Default,,0000,0000,0000,,Уми...!
Dialogue: 0,0:17:44.10,0:17:47.17,Default,,0000,0000,0000,,Бұл бала қайдан?
Dialogue: 0,0:17:47.17,0:17:49.13,Default,,0000,0000,0000,,Бұл бала!
Dialogue: 0,0:17:49.13,0:17:53.11,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:17:49.13,0:17:53.11,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:49.13,0:17:53.11,Default,,0000,0000,0000,,Нобита-сан, сен оны танисың ба?
Dialogue: 0,0:17:49.13,0:17:53.11,Default,,0000,0000,0000,,♬~ “Ралалә лалах”
Dialogue: 0,0:17:53.11,0:17:55.14,Default,,0000,0000,0000,,Хахахаха!
Dialogue: 0,0:17:55.14,0:17:58.08,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:17:55.14,0:17:58.08,Default,,0000,0000,0000,,♬～“Ралала рах рах”
Dialogue: 0,0:17:58.08,0:18:02.11,Default,,0000,0000,0000,,Сіз дұрыс істеп жатырсыз. Бұл дұрыс!
Dialogue: 0,0:18:02.11,0:18:07.09,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:18:02.11,0:18:07.09,Default,,0000,0000,0000,,♬ ~ «Рах-рах-рах-рах»
Dialogue: 0,0:18:07.09,0:18:10.12,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:18:07.09,0:18:10.12,Default,,0000,0000,0000,,♬~ “Лалала лала”
Dialogue: 0,0:18:10.12,0:18:15.16,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,0:18:10.12,0:18:15.16,Default,,0000,0000,0000,,♬ ~ «Рах-рах-рах-рах-рах»
Dialogue: 0,0:18:15.16,0:18:18.10,Default,,0000,0000,0000,,⚟♬～
Dialogue: 0,0:18:18.10,0:18:22.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:22.10,0:18:24.14,Default,,0000,0000,0000,,Менің Мико-чаным!
Dialogue: 0,0:18:24.14,0:18:28.11,Default,,0000,0000,0000,,Кокюу
Dialogue: 0,0:18:24.14,0:18:28.11,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:18:24.14,0:18:28.11,Default,,0000,0000,0000,,Ningyou
Dialogue: 0,0:18:24.14,0:18:28.11,Default,,0000,0000,0000,,Менің жоғары дәрежелі жаңғаққұмар!
Dialogue: 0,0:18:24.14,0:18:28.11,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:18:24.14,0:18:28.11,Default,,0000,0000,0000,,Бұл менің металл роботым!
Dialogue: 0,0:18:28.11,0:18:31.11,Default,,0000,0000,0000,,Менің де тұлыпым!
Dialogue: 0,0:18:31.11,0:18:34.11,Default,,0000,0000,0000,,Энсу
Dialogue: 0,0:18:31.11,0:18:34.11,Default,,0000,0000,0000,,♬～(Өнімділік)
Dialogue: 0,0:18:34.11,0:18:37.08,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:18:34.11,0:18:37.08,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:18:34.11,0:18:37.08,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Бұл қызықты емес пе?
Dialogue: 0,0:18:37.08,0:18:47.09,Default,,0000,0000,0000,,♬～(көрсетілім)
Dialogue: 0,0:18:47.09,0:18:52.10,Default,,0000,0000,0000,,♬～ (ән айту және ойнау)
Dialogue: 0,0:18:52.10,0:19:14.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:14.09,0:19:36.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:37.11,0:19:39.08,Default,,0000,0000,0000,,Ахахахаха...!
Dialogue: 0,0:19:39.08,0:19:41.18,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:19:39.08,0:19:41.18,Default,,0000,0000,0000,,Хмм… Ой!?
Dialogue: 0,0:19:39.08,0:19:41.18,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:19:41.18,0:19:45.08,Default,,0000,0000,0000,,Тори Хадада
Dialogue: 0,0:19:41.18,0:19:45.08,Default,,0000,0000,0000,,Керемет! Менің ішім пысып кетті!
Dialogue: 0,0:19:41.18,0:19:45.08,Default,,0000,0000,0000,,Сайкоу
Dialogue: 0,0:19:41.18,0:19:45.08,Default,,0000,0000,0000,,Бұл тамаша!
Dialogue: 0,0:19:45.08,0:19:48.19,Default,,0000,0000,0000,,Фанонпипи! Поумян Питтанчо!
Dialogue: 0,0:19:48.19,0:19:51.22,Default,,0000,0000,0000,,Ән айту
Dialogue: 0,0:19:48.19,0:19:51.22,Default,,0000,0000,0000,,Әнші дауыс қандай керемет!
Dialogue: 0,0:19:48.19,0:19:51.22,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:19:48.19,0:19:51.22,Default,,0000,0000,0000,,Сіз қайдансыз? Сіздің атыңыз кім?
Dialogue: 0,0:19:51.22,0:19:55.13,Default,,0000,0000,0000,,Сіз Нобита-кунды білесіз бе?
Dialogue: 0,0:19:51.22,0:19:55.13,Default,,0000,0000,0000,,Кеше
Dialogue: 0,0:19:51.22,0:19:55.13,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:51.22,0:19:55.13,Default,,0000,0000,0000,,Мен де кеше сені бірінші рет кездестірдім.
Dialogue: 0,0:19:55.13,0:19:57.13,Default,,0000,0000,0000,,Пуруру! Пуруру!
Dialogue: 0,0:19:57.13,0:19:59.13,Default,,0000,0000,0000,,Сөздер
Dialogue: 0,0:19:57.13,0:19:59.13,Default,,0000,0000,0000,,Мен сөздерді түсінбеймін, бірақ→
Dialogue: 0,0:19:59.13,0:20:02.10,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:19:59.13,0:20:02.10,Default,,0000,0000,0000,,Жарық
Dialogue: 0,0:19:59.13,0:20:02.10,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:59.13,0:20:02.10,Default,,0000,0000,0000,,Жүрегіміз жаңғырды!
Dialogue: 0,0:19:59.13,0:20:02.10,Default,,0000,0000,0000,,Сізде жүрек болды ма?
Dialogue: 0,0:20:02.10,0:20:04.10,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:20:02.10,0:20:04.10,Default,,0000,0000,0000,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:20:04.10,0:20:07.11,Default,,0000,0000,0000,,Иә? Ал сол бала ше?
Dialogue: 0,0:20:04.10,0:20:07.11,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:20:04.10,0:20:07.11,Default,,0000,0000,0000,,Сен қайда бардың?
Dialogue: 0,0:20:09.14,0:20:11.11,Default,,0000,0000,0000,,Қайтадан жоғалып кетті...
Dialogue: 0,0:20:11.11,0:20:14.11,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:20:11.11,0:20:14.11,Default,,0000,0000,0000,,Бұл не? Бұдан былай.
Dialogue: 0,0:20:14.11,0:20:21.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:21.12,0:20:25.12,Default,,0000,0000,0000,,Иә? Кептірілген саңырауқұлақтар?
Dialogue: 0,0:20:25.12,0:20:29.16,Default,,0000,0000,0000,,Эй, Эрен…
Dialogue: 0,0:20:25.12,0:20:29.16,Default,,0000,0000,0000,,Уау! Лас.
Dialogue: 0,0:20:29.16,0:20:33.13,Default,,0000,0000,0000,,Не болды? Джан.
Dialogue: 0,0:20:29.16,0:20:33.13,Default,,0000,0000,0000,,Сава
Dialogue: 0,0:20:29.16,0:20:33.13,Default,,0000,0000,0000,,Қол тигізгенде лас болды.
Dialogue: 0,0:20:34.13,0:20:39.10,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:20:34.13,0:20:39.10,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:20:34.13,0:20:39.10,Default,,0000,0000,0000,,Таптым! Бес виртуоз!
Dialogue: 0,0:20:39.10,0:20:41.11,Default,,0000,0000,0000,,Сәлем Дораемон.
Dialogue: 0,0:20:41.11,0:20:45.11,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:20:41.11,0:20:45.11,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:20:41.11,0:20:45.11,Default,,0000,0000,0000,,Құралдар
Dialogue: 0,0:20:41.11,0:20:45.11,Default,,0000,0000,0000,,Диктофон дағдыларын жақсартуға арналған құралдар бар ма?
Dialogue: 0,0:20:45.11,0:20:49.11,Default,,0000,0000,0000,,Джимичи
Dialogue: 0,0:20:45.11,0:20:49.11,Default,,0000,0000,0000,,♬ Star Platinum
Dialogue: 0,0:20:45.11,0:20:49.11,Default,,0000,0000,0000,,Білесіз бе... Маған тұрақты түрде жаттығу керек.
Dialogue: 0,0:20:45.11,0:20:49.11,Default,,0000,0000,0000,,Бұл сізге жақсы емес!
Dialogue: 0,0:20:49.11,0:20:53.09,Default,,0000,0000,0000,,Кеч.
Dialogue: 0,0:20:49.11,0:20:53.09,Default,,0000,0000,0000,,Ке... Не деген сараңдық! Сараңдық деген не?
Dialogue: 0,0:20:53.09,0:20:56.09,Default,,0000,0000,0000,,Иә? Хмм?
Dialogue: 0,0:20:57.19,0:20:59.09,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:20:57.19,0:20:59.09,Default,,0000,0000,0000,,Кімнен?
Dialogue: 0,0:20:59.09,0:21:01.09,Default,,0000,0000,0000,,Маған көрсет.
Dialogue: 0,0:20:59.09,0:21:01.09,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:03.10,0:21:08.10,Default,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:21:03.10,0:21:08.10,Default,,0000,0000,0000,,Мектеп
Dialogue: 0,0:21:03.10,0:21:08.10,Default,,0000,0000,0000,,Онгакушицу
Dialogue: 0,0:21:03.10,0:21:08.10,Default,,0000,0000,0000,,«Мен бүгін кешке мектептің музыка бөлмесінде күтемін».
Dialogue: 0,0:21:08.10,0:21:11.07,Default,,0000,0000,0000,,Ах! Бұл белгі...
Dialogue: 0,0:21:21.11,0:21:23.12,Default,,0000,0000,0000,,♬~ «Мяу мияу»
Dialogue: 0,0:21:23.12,0:21:26.15,Default,,0000,0000,0000,,♬~ “Мяу мияу”
Dialogue: 0,0:21:26.15,0:21:28.15,Default,,0000,0000,0000,,Ұрланған
Dialogue: 0,0:21:26.15,0:21:28.15,Default,,0000,0000,0000,,《Оның күші одан сайын артуда》
Dialogue: 0,0:21:29.12,0:21:31.09,Default,,0000,0000,0000,,Ня~?
Dialogue: 0,0:21:33.09,0:21:36.09,Default,,0000,0000,0000,,Мияу...! ? Мияу!
Dialogue: 0,0:21:36.09,0:21:38.10,Default,,0000,0000,0000,,Мияу...!
Dialogue: 0,0:21:39.10,0:21:56.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:56.11,0:21:58.08,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:21:56.11,0:21:58.08,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:21:58.08,0:22:01.12,Default,,0000,0000,0000,,Сонымен... ойланыңызшы, білесіз бе?
Dialogue: 0,0:22:01.12,0:22:04.12,Default,,0000,0000,0000,,сәйкес
Dialogue: 0,0:22:01.12,0:22:04.12,Default,,0000,0000,0000,,Түнде ешкім болмаған кезде музыка бөлмесінде
Dialogue: 0,0:22:01.12,0:22:04.12,Default,,0000,0000,0000,,О-
Dialogue: 0,0:22:01.12,0:22:04.12,Default,,0000,0000,0000,,Фортепианода ойнаған кезде→
Dialogue: 0,0:22:04.12,0:22:07.13,Default,,0000,0000,0000,,Шозоға
Dialogue: 0,0:22:04.12,0:22:07.13,Default,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:22:04.12,0:22:07.13,Default,,0000,0000,0000,,Бетховеннің портреті күлімсіреп тұрады дейді!
Dialogue: 0,0:22:07.13,0:22:09.09,Default,,0000,0000,0000,,Хееее...!
Dialogue: 0,0:22:11.10,0:22:13.10,Default,,0000,0000,0000,,Кедергі
Dialogue: 0,0:22:11.10,0:22:13.10,Default,,0000,0000,0000,,Мазалағаным үшін кешіріңіз...
Dialogue: 0,0:22:16.10,0:22:18.14,Default,,0000,0000,0000,,Ешкім жоқ...
Dialogue: 0,0:22:18.14,0:22:23.14,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:23.14,0:22:25.11,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:22:25.11,0:22:28.11,Default,,0000,0000,0000,,Бұл шынымен сол баладан болды ма?
Dialogue: 0,0:22:28.11,0:22:30.12,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:22:28.11,0:22:30.12,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:22:28.11,0:22:30.12,Default,,0000,0000,0000,,(перделердің ашылған дыбысы)
Dialogue: 0,0:22:28.11,0:22:30.12,Default,,0000,0000,0000,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:22:31.12,0:22:35.12,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:22:31.12,0:22:35.12,Default,,0000,0000,0000,,О? Бірдеңе?
Dialogue: 0,0:22:35.12,0:22:38.12,Default,,0000,0000,0000,,Жеміс
Dialogue: 0,0:22:35.12,0:22:38.12,Default,,0000,0000,0000,,«Осы әуенді ойнатыңызшы»….
Dialogue: 0,0:22:38.12,0:22:42.09,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:22:38.12,0:22:42.09,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:22:42.09,0:22:46.26,Default,,0000,0000,0000,,...
Dialogue: 0,0:22:42.09,0:22:46.26,Default,,0000,0000,0000,,Мен бұл әнді білемін.
Dialogue: 0,0:22:42.09,0:22:46.26,Default,,0000,0000,0000,,Иә! Ойна! ?
Dialogue: 0,0:22:46.26,0:22:51.24,Default,,0000,0000,0000,,Бетховен күле бастайды...
Dialogue: 0,0:22:46.26,0:22:51.24,Default,,0000,0000,0000,,Хонки
Dialogue: 0,0:22:46.26,0:22:51.24,Default,,0000,0000,0000,,Не... шын айтасыз ба?
Dialogue: 0,0:22:53.14,0:22:58.11,Default,,0000,0000,0000,,♬ ~ «Элиза үшін»
Dialogue: 0,0:22:58.11,0:23:09.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:12.12,0:23:16.19,Default,,0000,0000,0000,,Қ-не істеймін! Оны қағып кеттім!
Dialogue: 0,0:23:12.12,0:23:16.19,Default,,0000,0000,0000,,Жарық
Dialogue: 0,0:23:12.12,0:23:16.19,Default,,0000,0000,0000,,Жарық...!
Dialogue: 0,0:23:16.19,0:23:20.10,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:23:16.19,0:23:20.10,Default,,0000,0000,0000,,⚞Біз сізді күттік. Жүр, мұнда кел!
Dialogue: 0,0:23:20.10,0:23:22.33,Default,,0000,0000,0000,,Сондықтан мен саған қайта-қайта өлмейтінімді айттым
Dialogue: 0,0:23:20.10,0:23:22.33,Default,,0000,0000,0000,,О... аруақ! ?
Dialogue: 0,0:23:20.10,0:23:22.33,Default,,0000,0000,0000,,Дора-чан!
Dialogue: 0,0:23:22.33,0:23:24.10,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:23:22.33,0:23:24.10,Default,,0000,0000,0000,,⚞Келіңіздер, асығыңыздар!
Dialogue: 0,0:23:24.10,0:23:26.17,Default,,0000,0000,0000,,Сіз кімсіз! ?
Dialogue: 0,0:23:26.17,0:23:28.21,Default,,0000,0000,0000,,Теріс
Dialogue: 0,0:23:26.17,0:23:28.21,Default,,0000,0000,0000,,⚞Өтінемін!
Dialogue: 0,0:23:28.21,0:23:31.18,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:28.21,0:23:31.18,Default,,0000,0000,0000,,Қуат
Dialogue: 0,0:23:28.21,0:23:31.18,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:23:28.21,0:23:31.18,Default,,0000,0000,0000,,⚞Бізге сіздің көмегіңіз қажет!
Dialogue: 0,0:23:32.11,0:23:36.11,Default,,0000,0000,0000,,Жоғарғы
Dialogue: 0,0:23:32.11,0:23:36.11,Default,,0000,0000,0000,,Мен өзімді қандай да бір қиындыққа тап болғандай сезінемін...
Dialogue: 0,0:23:32.11,0:23:36.11,Default,,0000,0000,0000,,Не істеу керек? Барамыз ба?
Dialogue: 0,0:23:36.11,0:23:39.12,Default,,0000,0000,0000,,Бүгін
Dialogue: 0,0:23:36.11,0:23:39.12,Default,,0000,0000,0000,,Жоқ, Кио Кё... Бүгін тоқтауымыз керек пе?
Dialogue: 0,0:23:40.12,0:23:43.12,Default,,0000,0000,0000,,♬ ~ “Аааааааааа”
Dialogue: 0,0:23:43.12,0:23:47.13,Default,,0000,0000,0000,,Анау бала... Анау қыз ән айтып жатыр!
Dialogue: 0,0:23:47.13,0:23:49.09,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,0:23:52.13,0:23:56.10,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:23:52.13,0:23:56.10,Default,,0000,0000,0000,,Мына қыз қоңырау шалып тұр!
Dialogue: 0,0:23:52.13,0:23:56.10,Default,,0000,0000,0000,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:23:58.10,0:24:00.17,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:24:00.17,0:24:02.11,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:24:00.17,0:24:02.11,Default,,0000,0000,0000,,Уф… Ах…
Dialogue: 0,0:24:02.11,0:24:04.11,Default,,0000,0000,0000,,Қалай... шынымен бе?
Dialogue: 0,0:24:04.11,0:24:06.08,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:24:07.08,0:24:09.11,Default,,0000,0000,0000,,Қызықты
Dialogue: 0,0:24:07.08,0:24:09.11,Default,,0000,0000,0000,,Қызық болып барады!
Dialogue: 0,0:24:09.11,0:24:11.12,Default,,0000,0000,0000,,Жоқ, сәл күте тұрыңыз... күтіңіз!
Dialogue: 0,0:24:11.12,0:24:17.09,Default,,0000,0000,0000,,Енді... Не болатынын білмеймін!
Dialogue: 0,0:24:11.12,0:24:17.09,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:24:21.09,0:24:28.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:28.10,0:24:30.10,Default,,0000,0000,0000,,Не... не болып жатыр! ?
Dialogue: 0,0:24:30.10,0:24:32.14,Default,,0000,0000,0000,,О...!
Dialogue: 0,0:24:30.10,0:24:32.14,Default,,0000,0000,0000,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:24:32.14,0:24:36.11,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:24:32.14,0:24:36.11,Default,,0000,0000,0000,,Сора
Dialogue: 0,0:24:32.14,0:24:36.11,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:24:32.14,0:24:36.11,Default,,0000,0000,0000,,Дораемон! Аспанда көтеріліп жатыр!
Dialogue: 0,0:24:36.11,0:24:38.08,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:24:36.11,0:24:38.08,Default,,0000,0000,0000,,Өтірік! ?
Dialogue: 0,0:24:38.08,0:24:40.08,Default,,0000,0000,0000,,Бұл...!
Dialogue: 0,0:24:40.08,0:24:42.11,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:24:40.08,0:24:42.11,Default,,0000,0000,0000,,Бұл тоқтамайды!
Dialogue: 0,0:24:42.11,0:24:46.12,Default,,0000,0000,0000,,Иә! ? Апыр-ай...! !
Dialogue: 0,0:24:46.12,0:24:51.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:51.09,0:24:53.19,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:24:53.19,0:24:55.09,Default,,0000,0000,0000,,Чикюу
Dialogue: 0,0:24:53.19,0:24:55.09,Default,,0000,0000,0000,,Жер...!
Dialogue: 0,0:24:55.09,0:24:59.10,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:24:55.09,0:24:59.10,Default,,0000,0000,0000,,Учуу
Dialogue: 0,0:24:55.09,0:24:59.10,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:24:55.09,0:24:59.10,Default,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:24:55.09,0:24:59.10,Default,,0000,0000,0000,,Сонымен мен ғарышқа ұштым! ?
Dialogue: 0,0:24:59.10,0:25:01.10,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:24:59.10,0:25:01.10,Default,,0000,0000,0000,,Әдемі!
Dialogue: 0,0:25:01.10,0:25:04.10,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:25:01.10,0:25:04.10,Default,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:25:04.10,0:25:13.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:13.11,0:25:15.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:25:13.11,0:25:15.11,Default,,0000,0000,0000,,Не? Бұл!
Dialogue: 0,0:25:15.11,0:25:19.18,Default,,0000,0000,0000,,Дора-чан!
Dialogue: 0,0:25:15.11,0:25:19.18,Default,,0000,0000,0000,,Жердің жанында осындай нәрсе бар...!
Dialogue: 0,0:25:19.18,0:25:31.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:31.10,0:25:33.10,Default,,0000,0000,0000,,Ол тоқтады...
Dialogue: 0,0:25:50.08,0:25:52.05,Default,,0000,0000,0000,,Не? Мұнда.
Dialogue: 0,0:25:55.09,0:25:59.09,Default,,0000,0000,0000,,Шизу
Dialogue: 0,0:25:55.09,0:25:59.09,Default,,0000,0000,0000,,Тыныш... Ешкім жоқ па?
Dialogue: 0,0:25:59.09,0:26:02.09,Default,,0000,0000,0000,,Кимивару
Dialogue: 0,0:25:59.09,0:26:02.09,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:25:59.09,0:26:02.09,Default,,0000,0000,0000,,Ей, бұл қорқынышты. Үйге барайық.
Dialogue: 0,0:26:02.09,0:26:05.10,Default,,0000,0000,0000,,Сәлем! Бұл жерде!
Dialogue: 0,0:26:05.10,0:26:07.10,Default,,0000,0000,0000,,Сіз шынымен де сондасыз ба? Сол бала.
Dialogue: 0,0:26:07.10,0:26:09.07,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:26:07.10,0:26:09.07,Default,,0000,0000,0000,,Бәрібір іздеп көрейік.
Dialogue: 0,0:26:10.10,0:26:13.10,Default,,0000,0000,0000,,Кайдан
Dialogue: 0,0:26:10.10,0:26:13.10,Default,,0000,0000,0000,,Баспалдақтар бар
Dialogue: 0,0:26:10.10,0:26:13.10,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:26:10.10,0:26:13.10,Default,,0000,0000,0000,,Сіз көтеріліңіз дейсіз бе?
Dialogue: 0,0:26:13.10,0:26:15.07,Default,,0000,0000,0000,,Сәлем Джан!
Dialogue: 0,0:26:15.07,0:26:17.08,Default,,0000,0000,0000,,
Dialogue: 0,0:26:17.08,0:26:20.05,Default,,0000,0000,0000,,Қазірдің өзінде...
Dialogue: 0,0:26:17.08,0:26:20.05,Default,,0000,0000,0000,,О!
Dialogue: 0,0:26:22.08,0:26:24.08,Default,,0000,0000,0000,,
Dialogue: 0,0:26:22.08,0:26:24.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:26:24.08,0:26:27.05,Default,,0000,0000,0000,,
Dialogue: 0,0:26:24.08,0:26:27.05,Default,,0000,0000,0000,,Керемет дыбыс!
Dialogue: 0,0:26:33.06,0:26:36.09,Default,,0000,0000,0000,,Кейкашин
Dialogue: 0,0:26:33.06,0:26:36.09,Default,,0000,0000,0000,,Барлығы тым сақ.
Dialogue: 0,0:26:36.09,0:26:38.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:26:39.10,0:26:43.07,Default,,0000,0000,0000,,Уф…. Барлығы, күтіңіз!
Dialogue: 0,0:26:43.07,0:26:46.07,Default,,0000,0000,0000,,
Dialogue: 0,0:26:46.07,0:26:50.08,Default,,0000,0000,0000,,(тықылдаған дыбыс)
Dialogue: 0,0:26:46.07,0:26:50.08,Default,,0000,0000,0000,,Ах! Уууу...
Dialogue: 0,0:26:50.08,0:26:52.04,Default,,0000,0000,0000,,
Dialogue: 0,0:26:50.08,0:26:52.04,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:26:53.08,0:26:55.08,Default,,0000,0000,0000,,Мен енот ит емеспін!
Dialogue: 0,0:26:55.08,0:26:57.12,Default,,0000,0000,0000,,
Dialogue: 0,0:26:57.12,0:27:00.12,Default,,0000,0000,0000,,
Dialogue: 0,0:27:00.12,0:27:03.09,Default,,0000,0000,0000,,Тебиоши
Dialogue: 0,0:27:00.12,0:27:03.09,Default,,0000,0000,0000,,(қол шапалақтау)
Dialogue: 0,0:27:03.09,0:27:05.09,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:27:05.09,0:27:07.09,Default,,0000,0000,0000,,
Dialogue: 0,0:27:07.09,0:27:10.10,Default,,0000,0000,0000,,Уау! Уф, уф, уф...!
Dialogue: 0,0:27:10.10,0:27:12.10,Default,,0000,0000,0000,,Уау! Уф...!
Dialogue: 0,0:27:12.10,0:27:20.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:27:20.11,0:27:22.07,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:27:20.11,0:27:22.07,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:27:22.07,0:27:24.11,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:27:24.11,0:27:27.08,Default,,0000,0000,0000,,Ахахахахха!
Dialogue: 0,0:27:24.11,0:27:27.08,Default,,0000,0000,0000,,Қызықты
Dialogue: 0,0:27:24.11,0:27:27.08,Default,,0000,0000,0000,,Хахаха... Қызық!
Dialogue: 0,0:27:28.18,0:27:31.08,Default,,0000,0000,0000,,Кен Па! Кен Кен Па!
Dialogue: 0,0:27:31.08,0:27:44.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:27:44.10,0:27:52.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:27:52.10,0:27:54.07,Default,,0000,0000,0000,,Барлығына!
Dialogue: 0,0:27:52.10,0:27:54.07,Default,,0000,0000,0000,,О.
Dialogue: 0,0:27:52.10,0:27:54.07,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:27:54.07,0:27:56.07,Default,,0000,0000,0000,,Иллюзия! ?
Dialogue: 0,0:27:56.07,0:27:59.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:27:56.07,0:27:59.08,Default,,0000,0000,0000,,Әдемі!
Dialogue: 0,0:27:59.08,0:28:12.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:28:12.09,0:28:15.09,Default,,0000,0000,0000,,Матсуда мырза өледі.
Dialogue: 0,0:28:12.09,0:28:15.09,Default,,0000,0000,0000,,Бұл не...?
Dialogue: 0,0:28:15.09,0:28:22.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:28:22.10,0:28:24.10,Default,,0000,0000,0000,,Не? Иә!
Dialogue: 0,0:28:25.10,0:28:27.11,Default,,0000,0000,0000,,Жел
Dialogue: 0,0:28:25.10,0:28:27.11,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:28:25.10,0:28:27.11,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:28:25.10,0:28:27.11,Default,,0000,0000,0000,,（）
Dialogue: 0,0:28:25.10,0:28:27.11,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:28:27.11,0:28:30.08,Default,,0000,0000,0000,,Учуу
Dialogue: 0,0:28:27.11,0:28:30.08,Default,,0000,0000,0000,,Кууки
Dialogue: 0,0:28:27.11,0:28:30.08,Default,,0000,0000,0000,,Жел! ? Бұл кеңістік болса да, ауа бар.
Dialogue: 0,0:28:31.31,0:28:34.28,Default,,0000,0000,0000,,Гата
Dialogue: 0,0:28:31.31,0:28:34.28,Default,,0000,0000,0000,,⚞Тарифіңізге рахмет!
Dialogue: 0,0:28:31.31,0:28:34.28,Default,,0000,0000,0000,,...
Dialogue: 0,0:28:35.08,0:28:38.08,Default,,0000,0000,0000,,Денцецу
Dialogue: 0,0:28:35.08,0:28:38.08,Default,,0000,0000,0000,,Аңызға айналған Виртуоздан күткендей!
Dialogue: 0,0:28:38.08,0:28:40.09,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:28:38.08,0:28:40.09,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:28:40.09,0:28:43.09,Default,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:28:40.09,0:28:43.09,Default,,0000,0000,0000,,Менің атым Capek...!
Dialogue: 0,0:28:43.09,0:28:46.09,Default,,0000,0000,0000,,Тоқта... Тоқта... Тоқта...!
Dialogue: 0,0:28:46.09,0:28:48.06,Default,,0000,0000,0000,,Уау...! Масу….
Dialogue: 0,0:28:50.10,0:28:52.10,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:28:50.10,0:28:52.10,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:28:52.10,0:28:54.10,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:28:52.10,0:28:54.10,Default,,0000,0000,0000,,Бұл мен бұрын-соңды көрмеген робот түрі.
Dialogue: 0,0:28:52.10,0:28:54.10,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:28:54.10,0:28:57.17,Default,,0000,0000,0000,,Ах... Рахмет.
Dialogue: 0,0:28:57.17,0:29:00.11,Default,,0000,0000,0000,,⚞Пуй Мупоппо Тончапе!
Dialogue: 0,0:29:00.11,0:29:02.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:29:05.08,0:29:07.05,Default,,0000,0000,0000,,Ма~~тчичи! Бонбонпе!
Dialogue: 0,0:29:08.08,0:29:10.08,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:29:08.08,0:29:10.08,Default,,0000,0000,0000,,Бұл бала!
Dialogue: 0,0:29:08.08,0:29:10.08,Default,,0000,0000,0000,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:29:10.08,0:29:13.08,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:29:10.08,0:29:13.08,Default,,0000,0000,0000,,Сіз не айтып тұрсыз?
Dialogue: 0,0:29:10.08,0:29:13.08,Default,,0000,0000,0000,,Хамф!
Dialogue: 0,0:29:14.09,0:29:16.05,Default,,0000,0000,0000,,Шынымен конняку!
Dialogue: 0,0:29:17.09,0:29:20.09,Default,,0000,0000,0000,,О, мисо соусы да бар.
Dialogue: 0,0:29:20.09,0:29:22.09,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:29:20.09,0:29:22.09,Default,,0000,0000,0000,,Міне, осында! Nohohon көзілдірігі!
Dialogue: 0,0:29:22.09,0:29:24.10,Default,,0000,0000,0000,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:29:24.10,0:29:26.10,Default,,0000,0000,0000,,Нохохон көзілдірігі! ?
Dialogue: 0,0:29:26.10,0:29:29.07,Default,,0000,0000,0000,,Айтпа!
Dialogue: 0,0:29:26.10,0:29:29.07,Default,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:29:26.10,0:29:29.07,Default,,0000,0000,0000,,Хэхехе. Көретін көзің бар!
Dialogue: 0,0:29:30.10,0:29:33.07,Default,,0000,0000,0000,,Мен Миккамын. Мынау...
Dialogue: 0,0:29:33.07,0:29:38.08,Default,,0000,0000,0000,,Бұл - Капек.
Dialogue: 0,0:29:33.07,0:29:38.08,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:29:33.07,0:29:38.08,Default,,0000,0000,0000,,Сева
Dialogue: 0,0:29:33.07,0:29:38.08,Default,,0000,0000,0000,,Мен Микка-самаға қамқорлық жасаймын.
Dialogue: 0,0:29:38.08,0:29:40.08,Default,,0000,0000,0000,,Мен Дораемонмын...
Dialogue: 0,0:29:38.08,0:29:40.08,Default,,0000,0000,0000,,Мен Нобитамын!
Dialogue: 0,0:29:40.08,0:29:43.08,Default,,0000,0000,0000,,Мен, Джан!
Dialogue: 0,0:29:40.08,0:29:43.08,Default,,0000,0000,0000,,Мен Сунеомын!
Dialogue: 0,0:29:43.08,0:29:46.05,Default,,0000,0000,0000,,Мен... Мен тыныш отырмын.
Dialogue: 0,0:29:43.08,0:29:46.05,Default,,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:29:47.15,0:29:50.09,Default,,0000,0000,0000,,Дендо
Dialogue: 0,0:29:47.15,0:29:50.09,Default,,0000,0000,0000,,Тариф залына қош келдіңіз!
Dialogue: 0,0:29:50.09,0:29:52.09,Default,,0000,0000,0000,,Тариф залы?
Dialogue: 0,0:29:52.09,0:29:55.06,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:29:52.09,0:29:55.06,Default,,0000,0000,0000,,Сіз білмейсіз бе?
Dialogue: 0,0:29:52.09,0:29:55.06,Default,,0000,0000,0000,,Виртуоз?
Dialogue: 0,0:29:56.06,0:29:58.10,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:29:56.06,0:29:58.10,Default,,0000,0000,0000,,Биру... Не?
Dialogue: 0,0:29:58.10,0:30:02.10,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:29:58.10,0:30:02.10,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:29:58.10,0:30:02.10,Default,,0000,0000,0000,,Аты аңызға айналған Виртуозды іздеуде→
Dialogue: 0,0:30:02.10,0:30:04.10,Default,,0000,0000,0000,,Чикюу
Dialogue: 0,0:30:02.10,0:30:04.10,Default,,0000,0000,0000,,О.
Dialogue: 0,0:30:02.10,0:30:04.10,Default,,0000,0000,0000,,Мен жерге түсіп бара жатыр едім.
Dialogue: 0,0:30:04.10,0:30:06.10,Default,,0000,0000,0000,,Мен оны таптым.
Dialogue: 0,0:30:06.10,0:30:08.07,Default,,0000,0000,0000,,Сізге!
Dialogue: 0,0:30:08.07,0:30:10.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:30:10.07,0:30:12.11,Default,,0000,0000,0000,,Сонымен... сыра мен өтірік деген не?
Dialogue: 0,0:30:12.11,0:30:17.12,Default,,0000,0000,0000,,Хехе. Виртуоз дегеніміз не?
Dialogue: 0,0:30:12.11,0:30:17.12,Default,,0000,0000,0000,,Музыка
Dialogue: 0,0:30:12.11,0:30:17.12,Default,,0000,0000,0000,,Шет
Dialogue: 0,0:30:12.11,0:30:17.12,Default,,0000,0000,0000,,Тацудзин
Dialogue: 0,0:30:12.11,0:30:17.12,Default,,0000,0000,0000,,Музыка шебері!
Dialogue: 0,0:30:17.12,0:30:21.12,Default,,0000,0000,0000,,Біз... музыканың шеберіміз бе?
Dialogue: 0,0:30:21.12,0:30:24.12,Default,,0000,0000,0000,,Канчига
Dialogue: 0,0:30:21.12,0:30:24.12,Default,,0000,0000,0000,,Сіз бір нәрсені дұрыс түсінбеген сияқтысыз...
Dialogue: 0,0:30:24.12,0:30:27.09,Default,,0000,0000,0000,,Ata
Dialogue: 0,0:30:24.12,0:30:27.09,Default,,0000,0000,0000,,Осы жерде
Dialogue: 0,0:30:24.12,0:30:27.09,Default,,0000,0000,0000,,Сенің жолыңнан тірілдім.
Dialogue: 0,0:30:27.09,0:30:30.09,Default,,0000,0000,0000,,Шоко
Dialogue: 0,0:30:27.09,0:30:30.09,Default,,0000,0000,0000,,Бұл ең жақсы дәлел!
Dialogue: 0,0:30:30.09,0:30:34.07,Default,,0000,0000,0000,,Теріс
Dialogue: 0,0:30:30.09,0:30:34.07,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,0:30:30.09,0:30:34.07,Default,,0000,0000,0000,,Өтінемін! Даңқ залын оятыңыз!
Dialogue: 0,0:30:36.10,0:30:38.10,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:30:36.10,0:30:38.10,Default,,0000,0000,0000,,Ей, кеттік!
Dialogue: 0,0:30:36.10,0:30:38.10,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:30:38.10,0:30:40.10,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:30:38.10,0:30:40.10,Default,,0000,0000,0000,,Асығыңыз, асығыңыз!
Dialogue: 0,0:30:38.10,0:30:40.10,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:30:38.10,0:30:40.10,Default,,0000,0000,0000,,Бір минут күтіңіз!
Dialogue: 0,0:30:41.11,0:30:44.11,Default,,0000,0000,0000,,Микка-сама, сен сондай бақытты көрінесің...
Dialogue: 0,0:30:44.11,0:30:47.11,Default,,0000,0000,0000,,және т.б.
Dialogue: 0,0:30:44.11,0:30:47.11,Default,,0000,0000,0000,,Мұнда басқа балалар бар ма?
Dialogue: 0,0:30:47.11,0:30:50.11,Default,,0000,0000,0000,,
Dialogue: 0,0:30:47.11,0:30:50.11,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,0:30:47.11,0:30:50.11,Default,,0000,0000,0000,,Біз әрқашан бірге болдық.
Dialogue: 0,0:30:50.11,0:30:52.08,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:30:50.11,0:30:52.08,Default,,0000,0000,0000,,Кана
Dialogue: 0,0:30:50.11,0:30:52.08,Default,,0000,0000,0000,,Біреумен ойнау →
Dialogue: 0,0:30:52.08,0:30:56.12,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:30:52.08,0:30:56.12,Default,,0000,0000,0000,,Бұл Микка-саманың бірінші рет келуі еді.
Dialogue: 0,0:30:56.12,0:31:00.09,Default,,0000,0000,0000,,Қуат
Dialogue: 0,0:30:56.12,0:31:00.09,Default,,0000,0000,0000,,Бір-бірімізге көмектесейік!
Dialogue: 0,0:30:56.12,0:31:00.09,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:31:00.09,0:31:04.10,Default,,0000,0000,0000,,«және күн сайын күрсінемін.»
Dialogue: 0,0:31:00.09,0:31:04.10,Default,,0000,0000,0000,,Қысқасы, сізге күш беру үшін музыканы қолдансаңыз
Dialogue: 0,0:31:00.09,0:31:04.10,Default,,0000,0000,0000,,Жақсы емес пе?
Dialogue: 0,0:31:04.10,0:31:07.10,Default,,0000,0000,0000,,Квест
Dialogue: 0,0:31:04.10,0:31:07.10,Default,,0000,0000,0000,,Ылғау
Dialogue: 0,0:31:04.10,0:31:07.10,Default,,0000,0000,0000,,Бұрынғыдай болса, бұл сіз ойлағаннан да оңай болуы мүмкін!
Dialogue: 0,0:31:07.10,0:31:09.10,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:31:07.10,0:31:09.10,Default,,0000,0000,0000,,Хэхе! Бұл өте қызық болды!
Dialogue: 0,0:31:11.10,0:31:15.11,Default,,0000,0000,0000,,Мина
Dialogue: 0,0:31:11.10,0:31:15.11,Default,,0000,0000,0000,,Барлығыңызға рахмет!
Dialogue: 0,0:31:16.07,0:31:19.11,Default,,0000,0000,0000,,《Күте тұрыңыз》
Dialogue: 0,0:31:19.11,0:31:22.08,Default,,0000,0000,0000,,《Маэстро...! 》
Dialogue: 0,0:31:23.11,0:31:27.09,Default,,0000,0000,0000,,Міне! тез!
Dialogue: 0,0:31:30.09,0:31:34.09,Default,,0000,0000,0000,,♬～“Ра рах ра ра”
Dialogue: 0,0:31:35.09,0:31:37.10,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:31:35.09,0:31:37.10,Default,,0000,0000,0000,,Кіріңіз.
Dialogue: 0,0:31:37.10,0:31:40.10,Default,,0000,0000,0000,,Міне, Миккада ма?
Dialogue: 0,0:31:40.10,0:31:42.10,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:31:44.17,0:31:46.14,Default,,0000,0000,0000,,⚞Нобита-кун!
Dialogue: 0,0:31:44.17,0:31:46.14,Default,,0000,0000,0000,,Ух... иә!
Dialogue: 0,0:31:47.11,0:31:50.11,Default,,0000,0000,0000,,Гакки
Dialogue: 0,0:31:47.11,0:31:50.11,Default,,0000,0000,0000,,Виртуозды ойлағанда, музыкалық аспаптар елестейді!
Dialogue: 0,0:31:51.11,0:31:55.08,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:31:51.11,0:31:55.08,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,0:31:51.11,0:31:55.08,Default,,0000,0000,0000,,Жерге түскен сайын жинаған музыкалық аспаптарым
Dialogue: 0,0:31:51.11,0:31:55.08,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:31:55.08,0:31:58.08,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,0:31:58.08,0:32:01.09,Default,,0000,0000,0000,,
Dialogue: 0,0:31:58.08,0:32:01.09,Default,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:31:58.08,0:32:01.09,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:31:58.08,0:32:01.09,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені таңдаңыз!
Dialogue: 0,0:32:01.09,0:32:04.16,Default,,0000,0000,0000,,Иә? Бұл аспап па?
Dialogue: 0,0:32:04.16,0:32:07.06,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:32:04.16,0:32:07.06,Default,,0000,0000,0000,,Иә! ? Бұл «сақина сақинасымен» оянғандай. →
Dialogue: 0,0:32:07.06,0:32:10.06,Default,,0000,0000,0000,,Фарре ойнайтын аспап емес пе?
Dialogue: 0,0:32:10.06,0:32:12.06,Default,,0000,0000,0000,,Дұрыс айтпадым ба, Крюгер мырза?
Dialogue: 0,0:32:10.06,0:32:12.06,Default,,0000,0000,0000,,Керемет...!
Dialogue: 0,0:32:12.06,0:32:15.10,Default,,0000,0000,0000,,Мүмкін болса
Dialogue: 0,0:32:12.06,0:32:15.10,Default,,0000,0000,0000,,Мен оның керемет аспап болғанын қалаймын! Ах!
Dialogue: 0,0:32:15.10,0:32:17.10,Default,,0000,0000,0000,,Мен таңдай алмайтындар көп.
Dialogue: 0,0:32:15.10,0:32:17.10,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,0:32:17.10,0:32:19.07,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:32:17.10,0:32:19.07,Default,,0000,0000,0000,,Осындай кезде...
Dialogue: 0,0:32:20.07,0:32:22.07,Default,,0000,0000,0000,,Унмей
Dialogue: 0,0:32:20.07,0:32:22.07,Default,,0000,0000,0000,,Қызыл
Dialogue: 0,0:32:20.07,0:32:22.07,Default,,0000,0000,0000,,Бір көршім айтып еді…
Dialogue: 0,0:32:20.07,0:32:22.07,Default,,0000,0000,0000,,Тағдырдың қызыл жібі.
Dialogue: 0,0:32:22.07,0:32:27.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:32:27.08,0:32:29.11,Default,,0000,0000,0000,,Ippon
Dialogue: 0,0:32:27.08,0:32:29.11,Default,,0000,0000,0000,,О-
Dialogue: 0,0:32:27.08,0:32:29.11,Default,,0000,0000,0000,,Па
Dialogue: 0,0:32:27.08,0:32:29.11,Default,,0000,0000,0000,,Біреуін таңдап, → тартыңыз
Dialogue: 0,0:32:29.11,0:32:33.08,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:32:29.11,0:32:33.08,Default,,0000,0000,0000,,Көпшілігі
Dialogue: 0,0:32:29.11,0:32:33.08,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:32:29.11,0:32:33.08,Default,,0000,0000,0000,,Кота
Dialogue: 0,0:32:29.11,0:32:33.08,Default,,0000,0000,0000,,Сізге сәйкес келетін жауапты таңдаңыз
Dialogue: 0,0:32:29.11,0:32:33.08,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:32:29.11,0:32:33.08,Default,,0000,0000,0000,,Бөлінетін болады.
Dialogue: 0,0:32:33.08,0:32:35.09,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:32:33.08,0:32:35.09,Default,,0000,0000,0000,,Бұл менмін!
Dialogue: 0,0:32:35.09,0:32:37.19,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:32:37.19,0:32:39.09,Default,,0000,0000,0000,,Сонда мен...
Dialogue: 0,0:32:37.19,0:32:39.09,Default,,0000,0000,0000,,Бұл менмін!
Dialogue: 0,0:32:39.09,0:32:41.09,Default,,0000,0000,0000,,Шинчо
Dialogue: 0,0:32:39.09,0:32:41.09,Default,,0000,0000,0000,,Мұнда абай болыңыз...
Dialogue: 0,0:32:42.06,0:32:44.10,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:32:44.10,0:32:46.06,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:32:48.10,0:32:51.07,Default,,0000,0000,0000,,Уау, бұл керемет! Эй, не? бұл.
Dialogue: 0,0:32:52.07,0:32:54.07,Default,,0000,0000,0000,,Бұл туба.
Dialogue: 0,0:32:54.07,0:32:58.08,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:32:54.07,0:32:58.08,Default,,0000,0000,0000,,Әй, скрипка! керемет!
Dialogue: 0,0:33:00.08,0:33:02.08,Default,,0000,0000,0000,,Мен бонгомын!
Dialogue: 0,0:33:00.08,0:33:02.08,Default,,0000,0000,0000,,
Dialogue: 0,0:33:03.08,0:33:07.09,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:33:03.08,0:33:07.09,Default,,0000,0000,0000,,Ауыр...
Dialogue: 0,0:33:03.08,0:33:07.09,Default,,0000,0000,0000,,Бұл шынымен де тағдырдың құралы ма?
Dialogue: 0,0:33:07.09,0:33:09.09,Default,,0000,0000,0000,,Сава
Dialogue: 0,0:33:07.09,0:33:09.09,Default,,0000,0000,0000,,Мен оған ешқашан қол тигізбедім...
Dialogue: 0,0:33:09.09,0:33:12.09,Default,,0000,0000,0000,,Иппацу
Dialogue: 0,0:33:09.09,0:33:12.09,Default,,0000,0000,0000,,О-
Dialogue: 0,0:33:09.09,0:33:12.09,Default,,0000,0000,0000,,Ол бір кадрда пайда болмайды ма?
Dialogue: 0,0:33:12.09,0:33:14.06,Default,,0000,0000,0000,,Онтей
Dialogue: 0,0:33:12.09,0:33:14.06,Default,,0000,0000,0000,,♬～(Скрипка дыбысы жоқ)
Dialogue: 0,0:33:14.06,0:33:16.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:33:14.06,0:33:16.06,Default,,0000,0000,0000,,Hahahaha…!
Dialogue: 0,0:33:16.06,0:33:20.10,Default,,0000,0000,0000,,Айшуура
Dialogue: 0,0:33:16.06,0:33:20.10,Default,,0000,0000,0000,,Бұл үйлесімділік болжау сияқты.
Dialogue: 0,0:33:16.06,0:33:20.10,Default,,0000,0000,0000,,Кюу
Dialogue: 0,0:33:16.06,0:33:20.10,Default,,0000,0000,0000,,Бұл кенеттен жақсы ойнайтын сияқты емес.
Dialogue: 0,0:33:20.10,0:33:22.10,Default,,0000,0000,0000,,Бұл біртүрлі...
Dialogue: 0,0:33:22.10,0:33:25.10,Default,,0000,0000,0000,,Егер Виртуоз мырза
Dialogue: 0,0:33:22.10,0:33:25.10,Default,,0000,0000,0000,,Энсу
Dialogue: 0,0:33:22.10,0:33:25.10,Default,,0000,0000,0000,,Оны ойнау оңай болуы керек...
Dialogue: 0,0:33:25.10,0:33:28.11,Default,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:33:25.10,0:33:28.11,Default,,0000,0000,0000,,Кәпек бұны жоймады ма?
Dialogue: 0,0:33:25.10,0:33:28.11,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:33:28.11,0:33:31.08,Default,,0000,0000,0000,,Бұл Кәпектің кінәсі емес.
Dialogue: 0,0:33:28.11,0:33:31.08,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:33:34.08,0:33:36.08,Default,,0000,0000,0000,,Музыка?
Dialogue: 0,0:33:34.08,0:33:36.08,Default,,0000,0000,0000,,Музыкант лицензиясы!
Dialogue: 0,0:33:37.12,0:33:39.12,Default,,0000,0000,0000,,Не? сол.
Dialogue: 0,0:33:39.12,0:33:43.15,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:33:39.12,0:33:43.15,Default,,0000,0000,0000,,Егер сізде бұл болса
Dialogue: 0,0:33:39.12,0:33:43.15,Default,,0000,0000,0000,,Құрал сіздің деңгейіңізге сәйкес реттеледі.
Dialogue: 0,0:33:43.15,0:33:47.09,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:33:43.15,0:33:47.09,Default,,0000,0000,0000,,♬ Star Platinum
Dialogue: 0,0:33:43.15,0:33:47.09,Default,,0000,0000,0000,,Қолшатыр
Dialogue: 0,0:33:43.15,0:33:47.09,Default,,0000,0000,0000,,Бірге жаттығу
Dialogue: 0,0:33:43.15,0:33:47.09,Default,,0000,0000,0000,,Құралдар
Dialogue: 0,0:33:43.15,0:33:47.09,Default,,0000,0000,0000,,Бұл деңгейді көтеру үшін қолданылатын құрал.
Dialogue: 0,0:33:47.09,0:33:50.09,Default,,0000,0000,0000,,Иә. иә. иә.
Dialogue: 0,0:33:54.10,0:33:56.07,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:33:57.10,0:33:59.10,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:33:57.10,0:33:59.10,Default,,0000,0000,0000,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:33:59.10,0:34:01.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:34:02.07,0:34:04.11,Default,,0000,0000,0000,,
Dialogue: 0,0:34:04.11,0:34:06.11,Default,,0000,0000,0000,,(скрипка)
Dialogue: 0,0:34:06.11,0:34:09.08,Default,,0000,0000,0000,,(Туба)
Dialogue: 0,0:34:10.08,0:34:13.12,Default,,0000,0000,0000,,Мусу
Dialogue: 0,0:34:10.08,0:34:13.12,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:34:10.08,0:34:13.12,Default,,0000,0000,0000,,Лицензиямен бекітілген музыкалық аспаптарда өсиет болады.
Dialogue: 0,0:34:13.12,0:34:15.09,Default,,0000,0000,0000,,Сөздер
Dialogue: 0,0:34:13.12,0:34:15.09,Default,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:34:13.12,0:34:15.09,Default,,0000,0000,0000,,Мен тілде сөйлей алмаймын.
Dialogue: 0,0:34:16.12,0:34:20.09,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:34:16.12,0:34:20.09,Default,,0000,0000,0000,,Жарық
Dialogue: 0,0:34:16.12,0:34:20.09,Default,,0000,0000,0000,,Дыбыстық сигнал естілді!
Dialogue: 0,0:34:20.09,0:34:23.09,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:34:20.09,0:34:23.09,Default,,0000,0000,0000,,Танысқаныма қуаныштымын!
Dialogue: 0,0:34:23.09,0:34:27.10,Default,,0000,0000,0000,,Уау! Мен де Мен де!
Dialogue: 0,0:34:27.10,0:34:30.07,Default,,0000,0000,0000,,Бұл керней ме? Әлде гитара ма?
Dialogue: 0,0:34:31.10,0:34:35.11,Default,,0000,0000,0000,,Иә? Бұл...
Dialogue: 0,0:34:35.11,0:34:37.11,Default,,0000,0000,0000,,Менің магнитофоным! ?
Dialogue: 0,0:34:37.11,0:34:39.08,Default,,0000,0000,0000,,Иә Лицензия.
Dialogue: 0,0:34:44.12,0:34:46.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:34:46.12,0:34:50.12,Default,,0000,0000,0000,,(Диктофон)
Dialogue: 0,0:34:50.12,0:34:52.09,Default,,0000,0000,0000,,...
Dialogue: 0,0:34:52.09,0:34:56.06,Default,,0000,0000,0000,,Хи хи хи!
Dialogue: 0,0:34:52.09,0:34:56.06,Default,,0000,0000,0000,,...
Dialogue: 0,0:34:52.09,0:34:56.06,Default,,0000,0000,0000,,Бұл Нобитаға сәйкес келеді!
Dialogue: 0,0:34:56.06,0:34:59.10,Default,,0000,0000,0000,,Ол «жоқ» дыбысының шебері!
Dialogue: 0,0:34:59.10,0:35:02.10,Default,,0000,0000,0000,,Бұрыш
Dialogue: 0,0:34:59.10,0:35:02.10,Default,,0000,0000,0000,,Барлығына! Лицензияның бұрышында
Dialogue: 0,0:34:59.10,0:35:02.10,Default,,0000,0000,0000,,Құралды түртіп көріңіз.
Dialogue: 0,0:35:02.10,0:35:05.10,Default,,0000,0000,0000,,Иә? Жақсы….
Dialogue: 0,0:35:05.10,0:35:07.11,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:35:07.11,0:35:10.11,Default,,0000,0000,0000,,(Туба)
Dialogue: 0,0:35:07.11,0:35:10.11,Default,,0000,0000,0000,,О!
Dialogue: 0,0:35:10.11,0:35:14.15,Default,,0000,0000,0000,,Кез келген ауыр аспап
Dialogue: 0,0:35:10.11,0:35:14.15,Default,,0000,0000,0000,,♬ Star Platinum
Dialogue: 0,0:35:10.11,0:35:14.15,Default,,0000,0000,0000,,Сіз оны салпыншақ ретінде алып жүре аласыз.
Dialogue: 0,0:35:14.15,0:35:17.15,Default,,0000,0000,0000,,Түпнұсқа
Dialogue: 0,0:35:14.15,0:35:17.15,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,0:35:14.15,0:35:17.15,Default,,0000,0000,0000,,Оны тарту арқылы әрқашан қайта біріктіруге болады.
Dialogue: 0,0:35:19.08,0:35:21.09,Default,,0000,0000,0000,,(скрипка)
Dialogue: 0,0:35:19.08,0:35:21.09,Default,,0000,0000,0000,,
Dialogue: 0,0:35:21.09,0:35:23.09,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:35:21.09,0:35:23.09,Default,,0000,0000,0000,,Камado Танжиро.
Dialogue: 0,0:35:23.09,0:35:26.06,Default,,0000,0000,0000,,Ахх... Неліктен магнитофон?
Dialogue: 0,0:35:26.06,0:35:28.06,Default,,0000,0000,0000,,(Диктофон)
Dialogue: 0,0:35:28.06,0:35:30.09,Default,,0000,0000,0000,,Мен бақытты емеспін...
Dialogue: 0,0:35:28.06,0:35:30.09,Default,,0000,0000,0000,,(Диктофон)
Dialogue: 0,0:35:30.09,0:35:33.10,Default,,0000,0000,0000,,Көңілді...!
Dialogue: 0,0:35:30.09,0:35:33.10,Default,,0000,0000,0000,,Ал, барлығымыз, кеттік!
Dialogue: 0,0:35:33.10,0:35:35.07,Default,,0000,0000,0000,,О.
Dialogue: 0,0:35:33.10,0:35:35.07,Default,,0000,0000,0000,,(Батырма басылған дыбысы)
Dialogue: 0,0:35:33.10,0:35:35.07,Default,,0000,0000,0000,,Көңілді!
Dialogue: 0,0:35:36.07,0:35:38.10,Default,,0000,0000,0000,,Уа, уаа, уаа...! Апыр-ай!
Dialogue: 0,0:35:38.10,0:35:40.10,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:35:40.10,0:35:43.07,Default,,0000,0000,0000,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:35:40.10,0:35:43.07,Default,,0000,0000,0000,,Не болып жатыр! ?
Dialogue: 0,0:35:45.08,0:35:47.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:35:45.08,0:35:47.08,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:35:47.08,0:35:49.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:35:47.08,0:35:49.08,Default,,0000,0000,0000,,Сәлем! Қызық~!
Dialogue: 0,0:35:49.08,0:35:51.08,Default,,0000,0000,0000,,Хмф! Хамф!
Dialogue: 0,0:35:51.08,0:35:53.08,Default,,0000,0000,0000,,Уф...! Уф...!
Dialogue: 0,0:35:53.08,0:35:55.09,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:35:53.08,0:35:55.09,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:35:55.09,0:35:57.09,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:35:55.09,0:35:57.09,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:35:57.09,0:35:59.09,Default,,0000,0000,0000,,Ахаха!
Dialogue: 0,0:35:57.09,0:35:59.09,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,0:35:59.09,0:36:02.06,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:36:03.09,0:36:05.06,Default,,0000,0000,0000,,Есеқай әңгімесі
Dialogue: 0,0:36:03.09,0:36:05.06,Default,,0000,0000,0000,,〈«Нобитаның сурет әлемінің тарихы»〉
Dialogue: 0,0:36:05.06,0:36:07.10,Default,,0000,0000,0000,,Жарықты енгізіңіз!
Dialogue: 0,0:36:07.10,0:36:11.10,Default,,0000,0000,0000,,〈Осы құралмен
Dialogue: 0,0:36:07.10,0:36:11.10,Default,,0000,0000,0000,,Тосын
Dialogue: 0,0:36:07.10,0:36:11.10,Default,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:36:07.10,0:36:11.10,Default,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:36:07.10,0:36:11.10,Default,,0000,0000,0000,,Біз суреттің ішіне кіріп: «Уау!» дедік! 〉
Dialogue: 0,0:36:11.10,0:36:14.07,Default,,0000,0000,0000,,Meie
Dialogue: 0,0:36:11.10,0:36:14.07,Default,,0000,0000,0000,,Асо
Dialogue: 0,0:36:11.10,0:36:14.07,Default,,0000,0000,0000,,〈Кез келген шедеврді көруге болады.〉
Dialogue: 0,0:36:14.07,0:36:17.07,Default,,0000,0000,0000,,<Ван Гогтан Мункке! 〉
Dialogue: 0,0:36:17.07,0:36:19.11,Default,,0000,0000,0000,,Келесі
Dialogue: 0,0:36:17.07,0:36:19.11,Default,,0000,0000,0000,,〈Келесі...〉
Dialogue: 0,0:36:19.11,0:36:21.08,Default,,0000,0000,0000,,<Джиан! ? 〉
Dialogue: 0,0:36:19.11,0:36:21.08,Default,,0000,0000,0000,,〈Е! ? 〉
Dialogue: 0,0:36:31.02,0:36:33.02,Default,,0000,0000,0000,,Құрметті Мика!
Dialogue: 0,0:36:31.02,0:36:33.02,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:36:33.02,0:36:37.03,Default,,0000,0000,0000,,♬～“Ра рах ра ра”
Dialogue: 0,0:36:37.03,0:36:42.07,Default,,0000,0000,0000,,♬～“Лала лала”
Dialogue: 0,0:36:42.07,0:36:47.04,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:36:42.07,0:36:47.04,Default,,0000,0000,0000,,Бір нәрсенің ұшып бара жатқанын елестетіңіз.
Dialogue: 0,0:36:42.07,0:36:47.04,Default,,0000,0000,0000,,Тарифті ойнаңыз!
Dialogue: 0,0:36:47.04,0:36:49.04,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:36:49.04,0:36:51.01,Default,,0000,0000,0000,,Неге екенін білмеймін, бірақ біз де!
Dialogue: 0,0:36:53.04,0:36:55.05,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:36:55.05,0:36:58.05,Default,,0000,0000,0000,,(Үлдеген дыбыс)
Dialogue: 0,0:36:55.05,0:36:58.05,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:36:58.05,0:37:02.02,Default,,0000,0000,0000,,♬～(Скрипка дыбысы жоқ)
Dialogue: 0,0:36:58.05,0:37:02.02,Default,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:36:58.05,0:37:02.02,Default,,0000,0000,0000,,О, керемет естіледі!
Dialogue: 0,0:37:02.02,0:37:05.02,Default,,0000,0000,0000,,
Dialogue: 0,0:37:06.02,0:37:09.06,Default,,0000,0000,0000,,Ахх...!
Dialogue: 0,0:37:09.06,0:37:12.03,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:37:09.06,0:37:12.03,Default,,0000,0000,0000,,Не болып жатыр...?
Dialogue: 0,0:37:12.03,0:37:15.03,Default,,0000,0000,0000,,Иә? Нобита ше?
Dialogue: 0,0:37:12.03,0:37:15.03,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:37:15.03,0:37:17.03,Default,,0000,0000,0000,,Ооооо!
Dialogue: 0,0:37:17.03,0:37:20.04,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:37:20.04,0:37:22.01,Default,,0000,0000,0000,,Уф...! Апыр-ай!
Dialogue: 0,0:37:23.01,0:37:25.04,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:37:25.04,0:37:27.04,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:37:25.04,0:37:27.04,Default,,0000,0000,0000,,Кя!
Dialogue: 0,0:37:27.04,0:37:29.01,Default,,0000,0000,0000,,Нобита-кун!
Dialogue: 0,0:37:30.05,0:37:32.05,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,0:37:32.05,0:37:35.02,Default,,0000,0000,0000,,Нобита-сан, жақсысың ба?
Dialogue: 0,0:37:32.05,0:37:35.02,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:37:35.02,0:37:37.02,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:37:35.02,0:37:37.02,Default,,0000,0000,0000,,Бұл адамдар...?
Dialogue: 0,0:37:37.02,0:37:40.02,Default,,0000,0000,0000,,Мистер Батч! Мотцель мырза!
Dialogue: 0,0:37:40.02,0:37:43.06,Default,,0000,0000,0000,,Бұл Виртуоз
Dialogue: 0,0:37:40.02,0:37:43.06,Default,,0000,0000,0000,,Қорқынышты түс көрдің бе?
Dialogue: 0,0:37:40.02,0:37:43.06,Default,,0000,0000,0000,,Бізді жерден шақырды.
Dialogue: 0,0:37:43.06,0:37:45.03,Default,,0000,0000,0000,,Даңқ залын ояту үшін!
Dialogue: 0,0:37:45.03,0:37:47.03,Default,,0000,0000,0000,,Виртуоз...?
Dialogue: 0,0:37:47.03,0:37:50.03,Default,,0000,0000,0000,,Кокорозуйо
Dialogue: 0,0:37:47.03,0:37:50.03,Default,,0000,0000,0000,,Түсіндім! Бұл сендіреді.
Dialogue: 0,0:37:50.03,0:37:52.04,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:37:50.03,0:37:52.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:37:52.04,0:37:56.04,Default,,0000,0000,0000,,Сүйкімді
Dialogue: 0,0:37:52.04,0:37:56.04,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:37:52.04,0:37:56.04,Default,,0000,0000,0000,,Ұзын
Dialogue: 0,0:37:52.04,0:37:56.04,Default,,0000,0000,0000,,Осы өзенге су құюға рұқсат бере аласыз ба?
Dialogue: 0,0:37:56.04,0:37:59.04,Default,,0000,0000,0000,,Су?
Dialogue: 0,0:37:56.04,0:37:59.04,Default,,0000,0000,0000,,А...? Қалай?
Dialogue: 0,0:37:59.04,0:38:03.05,Default,,0000,0000,0000,,Сіз мұны істей аласыз!
Dialogue: 0,0:37:59.04,0:38:03.05,Default,,0000,0000,0000,,Егер сіз виртуоз болсаңыз!
Dialogue: 0,0:38:03.05,0:38:06.05,Default,,0000,0000,0000,,Хашира
Dialogue: 0,0:38:03.05,0:38:06.05,Default,,0000,0000,0000,,Сол бағанада
Dialogue: 0,0:38:03.05,0:38:06.05,Default,,0000,0000,0000,,Тарифтік энергияны алсаңыз→
Dialogue: 0,0:38:06.05,0:38:08.02,Default,,0000,0000,0000,,Су ағады.
Dialogue: 0,0:38:08.02,0:38:11.02,Default,,0000,0000,0000,,Хехехехе!
Dialogue: 0,0:38:08.02,0:38:11.02,Default,,0000,0000,0000,,Тама
Dialogue: 0,0:38:08.02,0:38:11.02,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:38:08.02,0:38:11.02,Default,,0000,0000,0000,,Мына допты үрле!
Dialogue: 0,0:38:11.02,0:38:13.09,Default,,0000,0000,0000,,Косеки
Dialogue: 0,0:38:11.02,0:38:13.09,Default,,0000,0000,0000,,Бұл Тариф кені.
Dialogue: 0,0:38:13.09,0:38:17.03,Default,,0000,0000,0000,,Ганну
Dialogue: 0,0:38:13.09,0:38:17.03,Default,,0000,0000,0000,,Фарреге жауап ретінде
Dialogue: 0,0:38:13.09,0:38:17.03,Default,,0000,0000,0000,,О
Dialogue: 0,0:38:13.09,0:38:17.03,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:38:13.09,0:38:17.03,Default,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:38:13.09,0:38:17.03,Default,,0000,0000,0000,,Үлкен энергия шығарады.
Dialogue: 0,0:38:17.03,0:38:20.03,Default,,0000,0000,0000,,Бунмей
Dialogue: 0,0:38:17.03,0:38:20.03,Default,,0000,0000,0000,,сызат
Dialogue: 0,0:38:17.03,0:38:20.03,Default,,0000,0000,0000,,Музыка өз күшімен өркениет құрды!
Dialogue: 0,0:38:20.03,0:38:24.04,Default,,0000,0000,0000,,Жол ақысы бір
Dialogue: 0,0:38:20.03,0:38:24.04,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:38:20.03,0:38:24.04,Default,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:38:20.03,0:38:24.04,Default,,0000,0000,0000,,Бас
Dialogue: 0,0:38:20.03,0:38:24.04,Default,,0000,0000,0000,,Бәріне қуат беретін энергия көзі!
Dialogue: 0,0:38:24.04,0:38:27.04,Default,,0000,0000,0000,,Электр энергиясы
Dialogue: 0,0:38:24.04,0:38:27.04,Default,,0000,0000,0000,,Сонда музыка электр тогы сияқты?
Dialogue: 0,0:38:27.04,0:38:30.04,Default,,0000,0000,0000,,Солай көрінеді.
Dialogue: 0,0:38:27.04,0:38:30.04,Default,,0000,0000,0000,,Дүние
Dialogue: 0,0:38:27.04,0:38:30.04,Default,,0000,0000,0000,,Қандай керемет дүние!
Dialogue: 0,0:38:30.04,0:38:34.05,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:38:30.04,0:38:34.05,Default,,0000,0000,0000,,Көңілсіз
Dialogue: 0,0:38:30.04,0:38:34.05,Default,,0000,0000,0000,,Хоши
Dialogue: 0,0:38:30.04,0:38:34.05,Default,,0000,0000,0000,,Бұл шынымен де... әдемі жұлдыз еді.
Dialogue: 0,0:38:34.05,0:38:36.01,Default,,0000,0000,0000,,(тубаның үрлеу дыбысы)
Dialogue: 0,0:38:34.05,0:38:36.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:38:37.05,0:38:40.05,Default,,0000,0000,0000,,(Үлдеген дыбыс)
Dialogue: 0,0:38:40.05,0:38:42.02,Default,,0000,0000,0000,,
Dialogue: 0,0:38:44.02,0:38:46.06,Default,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:38:44.02,0:38:46.06,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:38:44.02,0:38:46.06,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:38:46.06,0:38:50.03,Default,,0000,0000,0000,,Бір рет
Dialogue: 0,0:38:46.06,0:38:50.03,Default,,0000,0000,0000,,Хахаха... тағы да!
Dialogue: 0,0:38:50.03,0:38:52.03,Default,,0000,0000,0000,,Рики
Dialogue: 0,0:38:50.03,0:38:52.03,Default,,0000,0000,0000,,Сіз сонша күш қолдана алмайсыз.
Dialogue: 0,0:38:52.03,0:38:55.03,Default,,0000,0000,0000,,Хейкатрео
Dialogue: 0,0:38:52.03,0:38:55.03,Default,,0000,0000,0000,,Бірақ Джианның өкпе сыйымдылығы
Dialogue: 0,0:38:52.03,0:38:55.03,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:38:55.03,0:38:58.04,Default,,0000,0000,0000,,Ән
Dialogue: 0,0:38:55.03,0:38:58.04,Default,,0000,0000,0000,,...
Dialogue: 0,0:38:55.03,0:38:58.04,Default,,0000,0000,0000,,Әрине, ән айтқанды ұнатады.
Dialogue: 0,0:38:58.04,0:39:00.04,Default,,0000,0000,0000,,Хаа….
Dialogue: 0,0:39:00.04,0:39:02.04,Default,,0000,0000,0000,,(Туба)
Dialogue: 0,0:39:02.04,0:39:05.04,Default,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:39:02.04,0:39:05.04,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,0:39:02.04,0:39:05.04,Default,,0000,0000,0000,,Иә? Көп дем алып, көп шығару...?
Dialogue: 0,0:39:05.04,0:39:08.08,Default,,0000,0000,0000,,Мынау... осылай ма?
Dialogue: 0,0:39:08.08,0:39:10.05,Default,,0000,0000,0000,,Екі
Dialogue: 0,0:39:08.08,0:39:10.05,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:39:08.08,0:39:10.05,Default,,0000,0000,0000,,(Тыныс алу дыбысы)
Dialogue: 0,0:39:10.05,0:39:15.05,Default,,0000,0000,0000,,♬～(Туба)
Dialogue: 0,0:39:15.05,0:39:19.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:39:19.06,0:39:21.06,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:39:21.06,0:39:24.06,Default,,0000,0000,0000,,Суба
Dialogue: 0,0:39:21.06,0:39:24.06,Default,,0000,0000,0000,,Чоши
Dialogue: 0,0:39:21.06,0:39:24.06,Default,,0000,0000,0000,,Керемет! Міне солай!
Dialogue: 0,0:39:24.06,0:39:26.13,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:39:26.13,0:39:28.07,Default,,0000,0000,0000,,
Dialogue: 0,0:39:28.07,0:39:30.07,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:39:28.07,0:39:30.07,Default,,0000,0000,0000,,Бірақ қызық емес пе?
Dialogue: 0,0:39:30.07,0:39:32.07,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:39:30.07,0:39:32.07,Default,,0000,0000,0000,,...бірақ ол жоғалып кетті.
Dialogue: 0,0:39:32.07,0:39:34.04,Default,,0000,0000,0000,,
Dialogue: 0,0:39:34.04,0:39:38.04,Default,,0000,0000,0000,,Дене
Dialogue: 0,0:39:34.04,0:39:38.04,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:39:34.04,0:39:38.04,Default,,0000,0000,0000,,Одо
Dialogue: 0,0:39:34.04,0:39:38.04,Default,,0000,0000,0000,,Мм... денеңізді пайдаланып билегенді ұнатасыз ба...?
Dialogue: 0,0:39:38.04,0:39:41.08,Default,,0000,0000,0000,,
Dialogue: 0,0:39:41.08,0:39:44.05,Default,,0000,0000,0000,,Бутакки
Dialogue: 0,0:39:41.08,0:39:44.05,Default,,0000,0000,0000,,Жай ән
Dialogue: 0,0:39:41.08,0:39:44.05,Default,,0000,0000,0000,,Канджо
Dialogue: 0,0:39:41.08,0:39:44.05,Default,,0000,0000,0000,,О, құдайым
Dialogue: 0,0:39:41.08,0:39:44.05,Default,,0000,0000,0000,,Соқпалы аспаптар инстинктивті эмоцияны білдіреді.
Dialogue: 0,0:39:44.05,0:39:47.05,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,0:39:44.05,0:39:47.05,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:39:44.05,0:39:47.05,Default,,0000,0000,0000,,Ұялма, жүрегіңе бағын!
Dialogue: 0,0:39:49.09,0:39:52.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:39:52.06,0:39:54.06,Default,,0000,0000,0000,,Хэхехе!
Dialogue: 0,0:39:54.06,0:39:57.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:39:57.06,0:40:00.10,Default,,0000,0000,0000,,♬～(Скрипка дыбысы жоқ)
Dialogue: 0,0:40:00.10,0:40:04.07,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:40:00.10,0:40:04.07,Default,,0000,0000,0000,,♬～(Скрипка дыбысы жоқ)
Dialogue: 0,0:40:05.14,0:40:07.07,Default,,0000,0000,0000,,Иә? иә?
Dialogue: 0,0:40:07.07,0:40:10.07,Default,,0000,0000,0000,,Kincho
Dialogue: 0,0:40:07.07,0:40:10.07,Default,,0000,0000,0000,,Барлығыңыз қобалжыдыңыз ба...?
Dialogue: 0,0:40:10.07,0:40:13.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:40:10.07,0:40:13.08,Default,,0000,0000,0000,,(скрипка)
Dialogue: 0,0:40:13.08,0:40:15.05,Default,,0000,0000,0000,,Vegetation
Dialogue: 0,0:40:13.08,0:40:15.05,Default,,0000,0000,0000,,Мейірімді бол...?
Dialogue: 0,0:40:17.05,0:40:21.09,Default,,0000,0000,0000,,(скрипка)
Dialogue: 0,0:40:21.09,0:40:23.05,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:40:21.09,0:40:23.05,Default,,0000,0000,0000,,Не! ? Қазір!
Dialogue: 0,0:40:23.05,0:40:30.03,Default,,0000,0000,0000,,♬～(Скрипка)
Dialogue: 0,0:40:33.06,0:40:35.07,Default,,0000,0000,0000,,Кимо
Dialogue: 0,0:40:33.06,0:40:35.07,Default,,0000,0000,0000,,Жақсы сезінеді...!
Dialogue: 0,0:40:35.07,0:40:39.04,Default,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:40:35.07,0:40:39.04,Default,,0000,0000,0000,,Барлығы Аспаптардың дауыстары
Dialogue: 0,0:40:35.07,0:40:39.04,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:40:35.07,0:40:39.04,Default,,0000,0000,0000,,Мен оны қазір естіп тұрған сияқтымын.
Dialogue: 0,0:40:39.04,0:40:43.04,Default,,0000,0000,0000,,Бізге де Нохохон көзілдірігіңізді көрсетіңіз!
Dialogue: 0,0:40:39.04,0:40:43.04,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:40:43.04,0:40:45.01,Default,,0000,0000,0000,,Иә... Жарайды!
Dialogue: 0,0:40:47.04,0:40:49.08,Default,,0000,0000,0000,,(Тыныс алу дыбысы)
Dialogue: 0,0:40:49.08,0:40:54.05,Default,,0000,0000,0000,,♬～(Дыбыстан тыс дыбыс жазу құрылғысы)
Dialogue: 0,0:40:54.05,0:40:56.05,Default,,0000,0000,0000,,(«жоқ» дыбысы)
Dialogue: 0,0:40:58.02,0:41:00.06,Default,,0000,0000,0000,,Ахахха!
Dialogue: 0,0:40:58.02,0:41:00.06,Default,,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,0:41:00.06,0:41:02.03,Default,,0000,0000,0000,,Менің лицензиям болса да...
Dialogue: 0,0:41:03.03,0:41:06.03,Default,,0000,0000,0000,,Мүлде
Dialogue: 0,0:41:03.03,0:41:06.03,Default,,0000,0000,0000,,Сіз мүлде жақсы ойнай алмайсыз!
Dialogue: 0,0:41:06.03,0:41:09.07,Default,,0000,0000,0000,,(Диктофон)
Dialogue: 0,0:41:06.03,0:41:09.07,Default,,0000,0000,0000,,Әлде бұл жыныстық сипаттағы қорлау үшін сылтау ма?
Dialogue: 0,0:41:09.07,0:41:12.04,Default,,0000,0000,0000,,Сіз не айтып тұрсыз?
Dialogue: 0,0:41:09.07,0:41:12.04,Default,,0000,0000,0000,,Бұл магнитофон бұзылған!
Dialogue: 0,0:41:12.04,0:41:14.04,Default,,0000,0000,0000,,(Диктофон)
Dialogue: 0,0:41:12.04,0:41:14.04,Default,,0000,0000,0000,,Уф… Бұған қуануым керек пе?
Dialogue: 0,0:41:14.04,0:41:16.01,Default,,0000,0000,0000,,Кедергі
Dialogue: 0,0:41:14.04,0:41:16.01,Default,,0000,0000,0000,,Маған кедергі жасама, Нобита!
Dialogue: 0,0:41:17.04,0:41:22.05,Default,,0000,0000,0000,,♬～(көрсетілім)
Dialogue: 0,0:41:22.05,0:41:28.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:41:30.02,0:41:32.12,Default,,0000,0000,0000,,Керемет жұмыс
Dialogue: 0,0:41:30.02,0:41:32.12,Default,,0000,0000,0000,,Керемет жұмыс!
Dialogue: 0,0:41:32.12,0:41:34.02,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:41:32.12,0:41:34.02,Default,,0000,0000,0000,,⚞ (сарқылдаған судың дыбысы)
Dialogue: 0,0:41:34.02,0:41:43.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:41:43.03,0:41:46.04,Default,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:41:43.03,0:41:46.04,Default,,0000,0000,0000,,Бұл су, сэр!
Dialogue: 0,0:41:43.03,0:41:46.04,Default,,0000,0000,0000,,
Dialogue: 0,0:41:46.04,0:41:48.04,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:41:49.04,0:41:51.01,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:41:54.04,0:41:57.05,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:41:54.04,0:41:57.05,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:41:54.04,0:41:57.05,Default,,0000,0000,0000,,А... қайта тірілетін сияқты!
Dialogue: 0,0:41:54.04,0:41:57.05,Default,,0000,0000,0000,,
Dialogue: 0,0:41:57.05,0:42:00.02,Default,,0000,0000,0000,,(Дыбыс деңгейін көтеру)
Dialogue: 0,0:41:57.05,0:42:00.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:42:03.05,0:42:06.06,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:42:03.05,0:42:06.06,Default,,0000,0000,0000,,Иә! Деңгей көтерілді!
Dialogue: 0,0:42:06.06,0:42:08.03,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:42:06.06,0:42:08.03,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:42:08.03,0:42:11.10,Default,,0000,0000,0000,,Мен ше?
Dialogue: 0,0:42:08.03,0:42:11.10,Default,,0000,0000,0000,,Азу
Dialogue: 0,0:42:08.03,0:42:11.10,Default,,0000,0000,0000,,Нобита-кун сенімен қалады.
Dialogue: 0,0:42:11.10,0:42:14.06,Default,,0000,0000,0000,,Kii!
Dialogue: 0,0:42:11.10,0:42:14.06,Default,,0000,0000,0000,,⚟Барлығыңызға!
Dialogue: 0,0:42:14.06,0:42:17.03,Default,,0000,0000,0000,,Бұл!
Dialogue: 0,0:42:14.06,0:42:17.03,Default,,0000,0000,0000,,О!
Dialogue: 0,0:42:18.07,0:42:22.07,Default,,0000,0000,0000,,
Dialogue: 0,0:42:18.07,0:42:22.07,Default,,0000,0000,0000,,Мори
Dialogue: 0,0:42:18.07,0:42:22.07,Default,,0000,0000,0000,,Орман қазіргі Тарифпен оянған сияқты!
Dialogue: 0,0:42:24.07,0:42:27.08,Default,,0000,0000,0000,,Тез кеттік!
Dialogue: 0,0:42:24.07,0:42:27.08,Default,,0000,0000,0000,,Қалайсың?
Dialogue: 0,0:42:27.08,0:42:29.05,Default,,0000,0000,0000,,Бұл оңай.
Dialogue: 0,0:42:30.05,0:42:32.05,Default,,0000,0000,0000,,Кана
Dialogue: 0,0:42:30.05,0:42:32.05,Default,,0000,0000,0000,,Тарифті ойнаңыз!
Dialogue: 0,0:42:32.05,0:42:36.05,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:42:32.05,0:42:36.05,Default,,0000,0000,0000,,Сурет
Dialogue: 0,0:42:32.05,0:42:36.05,Default,,0000,0000,0000,,Елестетіп көріңізші
Dialogue: 0,0:42:32.05,0:42:36.05,Default,,0000,0000,0000,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,0:42:32.05,0:42:36.05,Default,,0000,0000,0000,,Сора
Dialogue: 0,0:42:32.05,0:42:36.05,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:42:32.05,0:42:36.05,Default,,0000,0000,0000,,Аспанда еркін ұшыңыз!
Dialogue: 0,0:42:36.05,0:42:39.06,Default,,0000,0000,0000,,♬～(Туба)
Dialogue: 0,0:42:36.05,0:42:39.06,Default,,0000,0000,0000,,Уау, бұл керемет!
Dialogue: 0,0:42:39.06,0:42:41.06,Default,,0000,0000,0000,,♬～(скрипка)
Dialogue: 0,0:42:41.06,0:42:43.06,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:42:41.06,0:42:43.06,Default,,0000,0000,0000,,Мен мұны осы жолы жасадым!
Dialogue: 0,0:42:43.06,0:42:46.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:42:43.06,0:42:46.10,Default,,0000,0000,0000,,Хэхе! Фарли керемет!
Dialogue: 0,0:42:46.10,0:42:49.07,Default,,0000,0000,0000,,♬~ “Ранран Ранран Ранран”
Dialogue: 0,0:42:46.10,0:42:49.07,Default,,0000,0000,0000,,Мина
Dialogue: 0,0:42:46.10,0:42:49.07,Default,,0000,0000,0000,,Чоши
Dialogue: 0,0:42:46.10,0:42:49.07,Default,,0000,0000,0000,,Барлығы осылай!
Dialogue: 0,0:42:49.07,0:42:51.07,Default,,0000,0000,0000,,Неге тек мен ғана...?
Dialogue: 0,0:42:51.07,0:42:53.07,Default,,0000,0000,0000,,♬ Star Platinum
Dialogue: 0,0:42:51.07,0:42:53.07,Default,,0000,0000,0000,,Дұрыс жаттығу.
Dialogue: 0,0:42:54.04,0:42:56.04,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:42:54.04,0:42:56.04,Default,,0000,0000,0000,,Сау болыңыз~!
Dialogue: 0,0:42:58.11,0:43:01.08,Default,,0000,0000,0000,,Қазір ойлап қарасам, дәл қазір
Dialogue: 0,0:42:58.11,0:43:01.08,Default,,0000,0000,0000,,Жаз
Dialogue: 0,0:42:58.11,0:43:01.08,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:42:58.11,0:43:01.08,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:42:58.11,0:43:01.08,Default,,0000,0000,0000,,Мен таныс дыбысты естідім.
Dialogue: 0,0:43:02.05,0:43:04.15,Default,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:43:02.05,0:43:04.15,Default,,0000,0000,0000,,Не болды? мұғалім.
Dialogue: 0,0:43:04.15,0:43:06.12,Default,,0000,0000,0000,,
Dialogue: 0,0:43:08.05,0:43:11.02,Default,,0000,0000,0000,,Чогока
Dialogue: 0,0:43:08.05,0:43:11.02,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:43:08.05,0:43:11.02,Default,,0000,0000,0000,,Өте сәнді сыйлықтар ұтып алыңыз
Dialogue: 0,0:43:08.05,0:43:11.02,Default,,0000,0000,0000,,Хосо
Dialogue: 0,0:43:08.05,0:43:11.02,Default,,0000,0000,0000,,Мәліметтерді тарату ойыны→
Dialogue: 0,0:43:11.02,0:43:14.06,Default,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:43:11.02,0:43:14.06,Default,,0000,0000,0000,,«Фильм кейіпкерлерінің жинағы».
Dialogue: 0,0:43:14.06,0:43:16.03,Default,,0000,0000,0000,,Ди
Dialogue: 0,0:43:14.06,0:43:16.03,Default,,0000,0000,0000,,О.
Dialogue: 0,0:43:14.06,0:43:16.03,Default,,0000,0000,0000,,Санка
Dialogue: 0,0:43:14.06,0:43:16.03,Default,,0000,0000,0000,,Қатысу үшін d түймесін басыңыз.
Dialogue: 0,0:43:18.00,0:43:23.00,Default,,0000,0000,0000,,♬~ “Ралала лала”
Dialogue: 0,0:43:18.00,0:43:23.00,Default,,0000,0000,0000,,♬～(скрипка)
Dialogue: 0,0:43:23.00,0:43:25.00,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:43:23.00,0:43:25.00,Default,,0000,0000,0000,,Не? Мұнда.
Dialogue: 0,0:43:25.00,0:43:27.00,Default,,0000,0000,0000,,Mystery
Dialogue: 0,0:43:25.00,0:43:27.00,Default,,0000,0000,0000,,Мори
Dialogue: 0,0:43:25.00,0:43:27.00,Default,,0000,0000,0000,,Жұмбақ орман.
Dialogue: 0,0:43:27.00,0:43:30.07,Default,,0000,0000,0000,,♬～(скрипка)
Dialogue: 0,0:43:30.07,0:43:33.01,Default,,0000,0000,0000,,...
Dialogue: 0,0:43:30.07,0:43:33.01,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:43:30.07,0:43:33.01,Default,,0000,0000,0000,,Бұл әнді бір жерден естігендей болдым...
Dialogue: 0,0:43:33.01,0:43:35.05,Default,,0000,0000,0000,,Иә? Ах...!
Dialogue: 0,0:43:35.05,0:43:37.01,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:43:35.05,0:43:37.01,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:43:35.05,0:43:37.01,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:43:37.01,0:43:40.02,Default,,0000,0000,0000,,Уау! Өрт сөндірушілер?
Dialogue: 0,0:43:37.01,0:43:40.02,Default,,0000,0000,0000,,Міне, алғашқы отбасыңды мүлде ұмытып қалғансың➡
Dialogue: 0,0:43:40.02,0:43:42.02,Default,,0000,0000,0000,,Кішкентай қоңыз
Dialogue: 0,0:43:40.02,0:43:42.02,Default,,0000,0000,0000,,Дауыс жәндік!
Dialogue: 0,0:43:42.02,0:43:46.06,Default,,0000,0000,0000,,Суретті кітап
Dialogue: 0,0:43:42.02,0:43:46.06,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:43:42.02,0:43:46.06,Default,,0000,0000,0000,,Суреттер кітабында кездесетін дыбысты жәндік?
Dialogue: 0,0:43:42.02,0:43:46.06,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:43:46.06,0:43:50.03,Default,,0000,0000,0000,,Ганну
Dialogue: 0,0:43:46.06,0:43:50.03,Default,,0000,0000,0000,,Дыбысты жәндіктер әдемі фаррларға жауап береді
Dialogue: 0,0:43:46.06,0:43:50.03,Default,,0000,0000,0000,,Хика
Dialogue: 0,0:43:46.06,0:43:50.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:43:46.06,0:43:50.03,Default,,0000,0000,0000,,Жарқырап тұратын әдеті бар.
Dialogue: 0,0:43:50.03,0:43:53.03,Default,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:43:50.03,0:43:53.03,Default,,0000,0000,0000,,Мен оның әлі осы орманда екеніне сене алар емеспін...
Dialogue: 0,0:43:53.03,0:43:55.03,Default,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:43:53.03,0:43:55.03,Default,,0000,0000,0000,,Сізге суретті кітаптар ұнайды ма?
Dialogue: 0,0:43:55.03,0:43:58.04,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:43:55.03,0:43:58.04,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:43:55.03,0:43:58.04,Default,,0000,0000,0000,,Иә! Менің сүйіктім
Dialogue: 0,0:43:55.03,0:43:58.04,Default,,0000,0000,0000,,Виртуоз бейнеленген суретті кітап.
Dialogue: 0,0:43:58.04,0:44:00.00,Default,,0000,0000,0000,,Міне, осы.
Dialogue: 0,0:44:00.00,0:44:03.04,Default,,0000,0000,0000,,«Виртуоз және роботтар
Dialogue: 0,0:44:00.00,0:44:03.04,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:44:00.00,0:44:03.04,Default,,0000,0000,0000,,Шеңбер құра→
Dialogue: 0,0:44:03.04,0:44:06.04,Default,,0000,0000,0000,,Көңілсіз
Dialogue: 0,0:44:03.04,0:44:06.04,Default,,0000,0000,0000,,Ол өте әдемі фарре ойнады».
Dialogue: 0,0:44:06.04,0:44:10.05,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:44:06.04,0:44:10.05,Default,,0000,0000,0000,,Мауах
Dialogue: 0,0:44:06.04,0:44:10.05,Default,,0000,0000,0000,,«Дыбыс шығаратын жәндіктер жарқырап ұшады.
Dialogue: 0,0:44:06.04,0:44:10.05,Default,,0000,0000,0000,,Дүние
Dialogue: 0,0:44:06.04,0:44:10.05,Default,,0000,0000,0000,,Жарық
Dialogue: 0,0:44:06.04,0:44:10.05,Default,,0000,0000,0000,,Дүние нұрға толды».
Dialogue: 0,0:44:11.05,0:44:14.02,Default,,0000,0000,0000,,Кавара
Dialogue: 0,0:44:11.05,0:44:14.02,Default,,0000,0000,0000,,Ынта
Dialogue: 0,0:44:11.05,0:44:14.02,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:44:11.05,0:44:14.02,Default,,0000,0000,0000,,Жасырын
Dialogue: 0,0:44:11.05,0:44:14.02,Default,,0000,0000,0000,,Кавахарадағы концертті көргеннен кейін көзім жетті.
Dialogue: 0,0:44:14.02,0:44:18.02,Default,,0000,0000,0000,,Она
Dialogue: 0,0:44:14.02,0:44:18.02,Default,,0000,0000,0000,,Суретті кітаппен бірдей
Dialogue: 0,0:44:14.02,0:44:18.02,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:44:14.02,0:44:18.02,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:44:14.02,0:44:18.02,Default,,0000,0000,0000,,Бұл Виртуоз мырза болуы керек!
Dialogue: 0,0:44:18.02,0:44:20.02,Default,,0000,0000,0000,,Жарық
Dialogue: 0,0:44:18.02,0:44:20.02,Default,,0000,0000,0000,,Дыбыстық сигнал естілді!
Dialogue: 0,0:44:20.02,0:44:22.03,Default,,0000,0000,0000,,Суретті кітап...?
Dialogue: 0,0:44:22.03,0:44:25.03,Default,,0000,0000,0000,,Ганба
Dialogue: 0,0:44:22.03,0:44:25.03,Default,,0000,0000,0000,,Сонда бар күшіңді салу керек.
Dialogue: 0,0:44:25.03,0:44:27.06,Default,,0000,0000,0000,,Кюу
Dialogue: 0,0:44:25.03,0:44:27.06,Default,,0000,0000,0000,,Сөздік
Dialogue: 0,0:44:25.03,0:44:27.06,Default,,0000,0000,0000,,Мен кенеттен сенімімді жоғалта бастадым...
Dialogue: 0,0:44:27.06,0:44:31.04,Default,,0000,0000,0000,,Дұрыс айтпадым ба, Крюгер мырза?
Dialogue: 0,0:44:27.06,0:44:31.04,Default,,0000,0000,0000,,Жақсы емес!
Dialogue: 0,0:44:27.06,0:44:31.04,Default,,0000,0000,0000,,Тоджоджинбутсу
Dialogue: 0,0:44:27.06,0:44:31.04,Default,,0000,0000,0000,,Мен суретті кітаптағы кейіпкерлер екенімізге сене алар емеспін.
Dialogue: 0,0:44:32.00,0:44:34.00,Default,,0000,0000,0000,,Кя!
Dialogue: 0,0:44:32.00,0:44:34.00,Default,,0000,0000,0000,,Құрметті Мика! ?
Dialogue: 0,0:44:34.00,0:44:36.01,Default,,0000,0000,0000,,Паропалок!
Dialogue: 0,0:44:36.01,0:44:38.01,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:44:36.01,0:44:38.01,Default,,0000,0000,0000,,О, жоқ!
Dialogue: 0,0:44:38.01,0:44:40.01,Default,,0000,0000,0000,,Паро Паро!
Dialogue: 0,0:44:38.01,0:44:40.01,Default,,0000,0000,0000,,Ол қытықтайды!
Dialogue: 0,0:44:40.01,0:44:42.01,Default,,0000,0000,0000,,Паропалок!
Dialogue: 0,0:44:40.01,0:44:42.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:44:42.01,0:44:45.02,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:44:42.01,0:44:45.02,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:44:42.01,0:44:45.02,Default,,0000,0000,0000,,Бірақ Паропараның бар екендігі... Ах!
Dialogue: 0,0:44:45.02,0:44:47.02,Default,,0000,0000,0000,,Палопаро... Палопаро!
Dialogue: 0,0:44:47.99,0:44:49.99,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:44:47.99,0:44:49.99,Default,,0000,0000,0000,,Қоңырау шалып тұрған сияқты.
Dialogue: 0,0:44:47.99,0:44:49.99,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:44:47.99,0:44:49.99,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:44:52.09,0:44:54.09,Default,,0000,0000,0000,,⚟Аа...
Dialogue: 0,0:44:54.09,0:44:57.06,Default,,0000,0000,0000,,Паро~.
Dialogue: 0,0:44:54.09,0:44:57.06,Default,,0000,0000,0000,,⚟Аа...
Dialogue: 0,0:44:58.00,0:45:01.03,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:44:58.00,0:45:01.03,Default,,0000,0000,0000,,Бұл Такирен мырза еді!
Dialogue: 0,0:45:01.03,0:45:03.97,Default,,0000,0000,0000,,Міне, біз тағы да келдік!
Dialogue: 0,0:45:01.03,0:45:03.97,Default,,0000,0000,0000,,На
Dialogue: 0,0:45:01.03,0:45:03.97,Default,,0000,0000,0000,,Неге жылайсың?
Dialogue: 0,0:45:03.97,0:45:08.01,Default,,0000,0000,0000,,Мунен
Dialogue: 0,0:45:03.97,0:45:08.01,Default,,0000,0000,0000,,Ах~ Қандай ұят~! аа….
Dialogue: 0,0:45:08.01,0:45:12.01,Default,,0000,0000,0000,,Жыласаң, түсінбейсің.
Dialogue: 0,0:45:08.01,0:45:12.01,Default,,0000,0000,0000,,Мен бұл туралы бірдеңе істей аламын ба деп ойлаймын.
Dialogue: 0,0:45:12.01,0:45:13.98,Default,,0000,0000,0000,,Бұл бұрынғыдай жақсы емес.
Dialogue: 0,0:45:14.98,0:45:18.02,Default,,0000,0000,0000,,Осы орманда
Dialogue: 0,0:45:14.98,0:45:18.02,Default,,0000,0000,0000,,Кимо
Dialogue: 0,0:45:14.98,0:45:18.02,Default,,0000,0000,0000,,Тенки
Dialogue: 0,0:45:14.98,0:45:18.02,Default,,0000,0000,0000,,Рендо
Dialogue: 0,0:45:14.98,0:45:18.02,Default,,0000,0000,0000,,Менің сезімдерім ауа райына байланысты.
Dialogue: 0,0:45:18.02,0:45:20.02,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:45:18.02,0:45:20.02,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,0:45:18.02,0:45:20.02,Default,,0000,0000,0000,,Бұл көңілді және шуақты →
Dialogue: 0,0:45:20.02,0:45:23.99,Default,,0000,0000,0000,,Кана
Dialogue: 0,0:45:20.02,0:45:23.99,Default,,0000,0000,0000,,Кәмпит
Dialogue: 0,0:45:20.02,0:45:23.99,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:45:20.02,0:45:23.99,Default,,0000,0000,0000,,Мұңайсам, Жауады осылай
Dialogue: 0,0:45:20.02,0:45:23.99,Default,,0000,0000,0000,,Дауыл
Dialogue: 0,0:45:20.02,0:45:23.99,Default,,0000,0000,0000,,Дауыл болуы мүмкін...
Dialogue: 0,0:45:23.99,0:45:27.99,Default,,0000,0000,0000,,(Туба)
Dialogue: 0,0:45:23.99,0:45:27.99,Default,,0000,0000,0000,,Иә?what up?
Dialogue: 0,0:45:27.99,0:45:29.99,Default,,0000,0000,0000,,(скрипка)
Dialogue: 0,0:45:27.99,0:45:29.99,Default,,0000,0000,0000,,О-
Dialogue: 0,0:45:27.99,0:45:29.99,Default,,0000,0000,0000,,Сіз бірдеңе ойнай аласыз ба?
Dialogue: 0,0:45:29.99,0:45:33.03,Default,,0000,0000,0000,,
Dialogue: 0,0:45:29.99,0:45:33.03,Default,,0000,0000,0000,,Иә. Такирен үшін ойнайық!
Dialogue: 0,0:45:33.03,0:45:37.03,Default,,0000,0000,0000,,Шикибу
Dialogue: 0,0:45:33.03,0:45:37.03,Default,,0000,0000,0000,,Маэстро қалпақ пен таяқша!
Dialogue: 0,0:45:37.03,0:45:41.00,Default,,0000,0000,0000,,Ечен!
Dialogue: 0,0:45:37.03,0:45:41.00,Default,,0000,0000,0000,,Гета
Dialogue: 0,0:45:37.03,0:45:41.00,Default,,0000,0000,0000,,Мәзір
Dialogue: 0,0:45:37.03,0:45:41.00,Default,,0000,0000,0000,,Құралдар
Dialogue: 0,0:45:37.03,0:45:41.00,Default,,0000,0000,0000,,Қаншалықты жаман болсаңыз да, жақсы жұмыс істеуге мүмкіндік беретін құрал ма?
Dialogue: 0,0:45:41.00,0:45:43.97,Default,,0000,0000,0000,,Жоқ. Тек парик пен таяқ.
Dialogue: 0,0:45:41.00,0:45:43.97,Default,,0000,0000,0000,,Даха!
Dialogue: 0,0:45:45.01,0:45:47.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:45:45.01,0:45:47.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:45:47.01,0:45:49.01,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:45:47.01,0:45:49.01,Default,,0000,0000,0000,,Хэхе….
Dialogue: 0,0:45:49.01,0:45:51.01,Default,,0000,0000,0000,,Иә! ? Маримба?
Dialogue: 0,0:45:51.01,0:45:54.99,Default,,0000,0000,0000,,Бутакки
Dialogue: 0,0:45:51.01,0:45:54.99,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:45:51.01,0:45:54.99,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:45:51.01,0:45:54.99,Default,,0000,0000,0000,,Ұрмалы аспаптар әнге қарай өзгеріп отырады.
Dialogue: 0,0:45:51.01,0:45:54.99,Default,,0000,0000,0000,,Хэхе!
Dialogue: 0,0:45:54.99,0:45:56.99,Default,,0000,0000,0000,,Олай болса...
Dialogue: 0,0:45:59.02,0:46:04.03,Default,,0000,0000,0000,,♬～ (көрсетілім)
Dialogue: 0,0:46:04.03,0:46:11.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:46:11.00,0:46:15.01,Default,,0000,0000,0000,,♬~ «Ранранран Ранранран»
Dialogue: 0,0:46:15.01,0:46:17.01,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:46:17.01,0:46:19.01,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:46:19.01,0:46:24.01,Default,,0000,0000,0000,,♬ ~ “Ранранран Ранранран”
Dialogue: 0,0:46:24.01,0:46:26.98,Default,,0000,0000,0000,,♬~ «Ранранран Ранранран»
Dialogue: 0,0:46:26.98,0:46:30.02,Default,,0000,0000,0000,,Уф... Кукуку...
Dialogue: 0,0:46:26.98,0:46:30.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:46:30.02,0:46:32.99,Default,,0000,0000,0000,,Уууу... Ахахаха...!
Dialogue: 0,0:46:32.99,0:46:36.03,Default,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:46:32.99,0:46:36.03,Default,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:46:32.99,0:46:36.03,Default,,0000,0000,0000,,Күлімсіреуге мәжбүрлегендей...
Dialogue: 0,0:46:36.03,0:46:39.00,Default,,0000,0000,0000,,Тоқта! Ахахха...!
Dialogue: 0,0:46:39.00,0:46:41.03,Default,,0000,0000,0000,,Әй, қандай ұят...!
Dialogue: 0,0:46:41.03,0:46:43.00,Default,,0000,0000,0000,,Каминари
Dialogue: 0,0:46:41.03,0:46:43.00,Default,,0000,0000,0000,,О.
Dialogue: 0,0:46:41.03,0:46:43.00,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:46:41.03,0:46:43.00,Default,,0000,0000,0000,,(күн күркіреуі)
Dialogue: 0,0:46:43.00,0:46:45.00,Default,,0000,0000,0000,,Гяккоука?
Dialogue: 0,0:46:43.00,0:46:45.00,Default,,0000,0000,0000,,Уф... бұл кері нәтиже емес пе?
Dialogue: 0,0:46:45.00,0:46:48.01,Default,,0000,0000,0000,,Иә? иә...?
Dialogue: 0,0:46:48.01,0:46:57.05,Default,,0000,0000,0000,,Онтей
Dialogue: 0,0:46:48.01,0:46:57.05,Default,,0000,0000,0000,,♬～(Дыбыстан тыс дыбыс жазу құрылғысы)
Dialogue: 0,0:46:57.05,0:46:59.02,Default,,0000,0000,0000,,Паро….
Dialogue: 0,0:46:59.02,0:47:03.09,Default,,0000,0000,0000,,Сәлем Нобита! Дыбыс синхрондалмаған болуы мүмкін!
Dialogue: 0,0:47:03.09,0:47:05.02,Default,,0000,0000,0000,,Не? Кешіріңіз... кешіріңіз...
Dialogue: 0,0:47:05.02,0:47:08.13,Default,,0000,0000,0000,,Бірақ әйтеуір
Dialogue: 0,0:47:05.02,0:47:08.13,Default,,0000,0000,0000,,Мұңды сезінуге өте ыңғайлы.
Dialogue: 0,0:47:08.13,0:47:10.09,Default,,0000,0000,0000,,Жаңбыр тоқтады.
Dialogue: 0,0:47:11.03,0:47:13.03,Default,,0000,0000,0000,,Дыбыстық сигнал естілді! Уау!
Dialogue: 0,0:47:13.03,0:47:17.00,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:47:13.03,0:47:17.00,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:47:13.03,0:47:17.00,Default,,0000,0000,0000,,Ах!!
Dialogue: 0,0:47:13.03,0:47:17.00,Default,,0000,0000,0000,,Даидзи
Dialogue: 0,0:47:13.03,0:47:17.00,Default,,0000,0000,0000,,«Өз сезімдеріңізге жақын болу маңызды» ма?
Dialogue: 0,0:47:17.00,0:47:20.00,Default,,0000,0000,0000,,Бір рет
Dialogue: 0,0:47:17.00,0:47:20.00,Default,,0000,0000,0000,,Теріс
Dialogue: 0,0:47:17.00,0:47:20.00,Default,,0000,0000,0000,,Барлығыңыз, осы жерде қайталаңыздар.
Dialogue: 0,0:47:22.01,0:47:24.01,Default,,0000,0000,0000,,Арата
Dialogue: 0,0:47:22.01,0:47:24.01,Default,,0000,0000,0000,,Содан кейін қайтадан.
Dialogue: 0,0:47:25.04,0:47:30.05,Default,,0000,0000,0000,,♬～(Өнімділік)
Dialogue: 0,0:47:30.05,0:47:44.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:47:44.03,0:47:46.03,Default,,0000,0000,0000,,Ах, бұл...
Dialogue: 0,0:47:46.03,0:47:48.03,Default,,0000,0000,0000,,Setsu
Dialogue: 0,0:47:46.03,0:47:48.03,Default,,0000,0000,0000,,Қандай өкінішті тариф...
Dialogue: 0,0:47:48.03,0:47:51.00,Default,,0000,0000,0000,,Паро!
Dialogue: 0,0:47:48.03,0:47:51.00,Default,,0000,0000,0000,,О, паро!
Dialogue: 0,0:47:51.00,0:48:21.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:48:22.03,0:48:25.04,Default,,0000,0000,0000,,Vegetation
Dialogue: 0,0:48:22.03,0:48:25.04,Default,,0000,0000,0000,,Бұл жеңіл тариф болды.
Dialogue: 0,0:48:25.04,0:48:30.01,Default,,0000,0000,0000,,На
Dialogue: 0,0:48:25.04,0:48:30.01,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:48:25.04,0:48:30.01,Default,,0000,0000,0000,,Қайтыс болған шеберді қарсы алу
Dialogue: 0,0:48:25.04,0:48:30.01,Default,,0000,0000,0000,,Нидо
Dialogue: 0,0:48:25.04,0:48:30.01,Default,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:48:25.04,0:48:30.01,Default,,0000,0000,0000,,Мен енді мұны істей алмайтыныма өкіндім...
Dialogue: 0,0:48:30.01,0:48:33.01,Default,,0000,0000,0000,,Сізге рахмет, мен өзімді жақсы сезінемін.
Dialogue: 0,0:48:30.01,0:48:33.01,Default,,0000,0000,0000,,Паро!
Dialogue: 0,0:48:33.01,0:48:35.98,Default,,0000,0000,0000,,«Өлді» деген нені білдіреді?
Dialogue: 0,0:48:33.01,0:48:35.98,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:48:37.01,0:48:39.98,Default,,0000,0000,0000,,Тосын
Dialogue: 0,0:48:37.01,0:48:39.98,Default,,0000,0000,0000,,〈Сізді «Уау!» Дейтін шайқас сахнасы! 〉
Dialogue: 0,0:48:39.98,0:48:44.02,Default,,0000,0000,0000,,Балық балығы
Dialogue: 0,0:48:39.98,0:48:44.02,Default,,0000,0000,0000,,Кіші
Dialogue: 0,0:48:39.98,0:48:44.02,Default,,0000,0000,0000,,Хоро
Dialogue: 0,0:48:39.98,0:48:44.02,Default,,0000,0000,0000,,<Қара рыцарь әлемді жояды>
Dialogue: 0,0:48:44.02,0:48:49.03,Default,,0000,0000,0000,,Акума
Dialogue: 0,0:48:44.02,0:48:49.03,Default,,0000,0000,0000,,Созецу
Dialogue: 0,0:48:44.02,0:48:49.03,Default,,0000,0000,0000,,Ұрыс
Dialogue: 0,0:48:44.02,0:48:49.03,Default,,0000,0000,0000,,<Жындармен кескілескен шайқаста
Dialogue: 0,0:48:44.02,0:48:49.03,Default,,0000,0000,0000,,Денцецу
Dialogue: 0,0:48:44.02,0:48:49.03,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:48:44.02,0:48:49.03,Default,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:48:44.02,0:48:49.03,Default,,0000,0000,0000,,Біз сол аңызға қарсы тұрамыз! 〉
Dialogue: 0,0:48:49.03,0:48:53.00,Default,,0000,0000,0000,,Ашық
Dialogue: 0,0:48:49.03,0:48:53.00,Default,,0000,0000,0000,,〈Бірақ екінші тарап
Dialogue: 0,0:48:49.03,0:48:53.00,Default,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:48:49.03,0:48:53.00,Default,,0000,0000,0000,,Оның күштілігі сонша, таң қаласың! 〉
Dialogue: 0,0:48:54.00,0:48:56.00,Default,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:48:54.00,0:48:56.00,Default,,0000,0000,0000,,Оуен
Dialogue: 0,0:48:54.00,0:48:56.00,Default,,0000,0000,0000,,〈Барлығыңыз, кинотеатрға келіп, бізді қолдаңыздар! 〉
Dialogue: 0,0:49:10.98,0:49:13.98,Default,,0000,0000,0000,,Шырмауық
Dialogue: 0,0:49:10.98,0:49:13.98,Default,,0000,0000,0000,,Сіз маған айтқан жоқсыз.
Dialogue: 0,0:49:14.95,0:49:17.95,Default,,0000,0000,0000,,Хамамори
Dialogue: 0,0:49:14.95,0:49:17.95,Default,,0000,0000,0000,,Цуто
Dialogue: 0,0:49:14.95,0:49:17.95,Default,,0000,0000,0000,,Бұл да менің қабір қараушы ретіндегі міндетім.
Dialogue: 0,0:49:17.95,0:49:19.96,Default,,0000,0000,0000,,Маған еріңіз.
Dialogue: 0,0:49:22.96,0:49:24.96,Default,,0000,0000,0000,,Бұл...!
Dialogue: 0,0:49:22.96,0:49:24.96,Default,,0000,0000,0000,,Бұл өтірік...
Dialogue: 0,0:49:25.96,0:49:28.97,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:49:25.96,0:49:28.97,Default,,0000,0000,0000,,Барлық қабірлер...? Ах!
Dialogue: 0,0:49:31.00,0:49:35.97,Default,,0000,0000,0000,,Орын
Dialogue: 0,0:49:31.00,0:49:35.97,Default,,0000,0000,0000,,Кокио
Dialogue: 0,0:49:31.00,0:49:35.97,Default,,0000,0000,0000,,Біздің туған планетамыз Мушика
Dialogue: 0,0:49:31.00,0:49:35.97,Default,,0000,0000,0000,,Келу
Dialogue: 0,0:49:31.00,0:49:35.97,Default,,0000,0000,0000,,Баяғыда→
Dialogue: 0,0:49:35.97,0:49:37.97,Default,,0000,0000,0000,,Үлкен мәміле
Dialogue: 0,0:49:35.97,0:49:37.97,Default,,0000,0000,0000,,Хоро
Dialogue: 0,0:49:35.97,0:49:37.97,Default,,0000,0000,0000,,Үлкен апаттан қираған.
Dialogue: 0,0:49:37.97,0:49:39.98,Default,,0000,0000,0000,,Қираған! ?
Dialogue: 0,0:49:39.98,0:49:42.01,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:49:42.01,0:49:47.95,Default,,0000,0000,0000,,Дендо
Dialogue: 0,0:49:42.01,0:49:47.95,Default,,0000,0000,0000,,...
Dialogue: 0,0:49:42.01,0:49:47.95,Default,,0000,0000,0000,,Бұл зал үлкен апаттан аман қалды.
Dialogue: 0,0:49:42.01,0:49:47.95,Default,,0000,0000,0000,,Джин
Dialogue: 0,0:49:42.01,0:49:47.95,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:49:42.01,0:49:47.95,Default,,0000,0000,0000,,Бірнеше Мушикалар мен борттағы робот →
Dialogue: 0,0:49:47.95,0:49:49.99,Default,,0000,0000,0000,,Кюмей
Dialogue: 0,0:49:47.95,0:49:49.99,Default,,0000,0000,0000,,Бұл құтқару қайығы болды...
Dialogue: 0,0:49:49.99,0:49:53.99,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:49:49.99,0:49:53.99,Default,,0000,0000,0000,,Сол Мушика адамдары ше?
Dialogue: 0,0:49:49.99,0:49:53.99,Default,,0000,0000,0000,,Сіз әлі осындасыз ба?
Dialogue: 0,0:49:54.99,0:49:56.99,Default,,0000,0000,0000,,...
Dialogue: 0,0:49:54.99,0:49:56.99,Default,,0000,0000,0000,,Өкінішке орай...→
Dialogue: 0,0:49:56.99,0:49:58.96,Default,,0000,0000,0000,,Қорытынды
Dialogue: 0,0:49:56.99,0:49:58.96,Default,,0000,0000,0000,,Балалар
Dialogue: 0,0:49:56.99,0:49:58.96,Default,,0000,0000,0000,,Соңғы бала...
Dialogue: 0,0:49:59.96,0:50:02.97,Default,,0000,0000,0000,,Бұл мен...?
Dialogue: 0,0:50:02.97,0:50:04.97,Default,,0000,0000,0000,,Сиыр
Dialogue: 0,0:50:02.97,0:50:04.97,Default,,0000,0000,0000,,Қожайынынан айырылған зал →
Dialogue: 0,0:50:04.97,0:50:07.97,Default,,0000,0000,0000,,Бізбен роботтар
Dialogue: 0,0:50:04.97,0:50:07.97,Default,,0000,0000,0000,,Ұзын
Dialogue: 0,0:50:04.97,0:50:07.97,Default,,0000,0000,0000,,Нему
Dialogue: 0,0:50:04.97,0:50:07.97,Default,,0000,0000,0000,,Мен ұзақ ұйқыға кеттім.
Dialogue: 0,0:50:07.97,0:50:09.97,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:50:09.97,0:50:12.98,Default,,0000,0000,0000,,Матсуда мырза өледі.
Dialogue: 0,0:50:09.97,0:50:12.98,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:50:09.97,0:50:12.98,Default,,0000,0000,0000,,Неліктен жер бетінде бұл қазір...?
Dialogue: 0,0:50:12.98,0:50:14.95,Default,,0000,0000,0000,,Бұл қандай үлкен апат?
Dialogue: 0,0:50:15.98,0:50:17.98,Default,,0000,0000,0000,,Хое
Dialogue: 0,0:50:15.98,0:50:17.98,Default,,0000,0000,0000,,Толық ақпаратты білмеймін →
Dialogue: 0,0:50:17.98,0:50:20.95,Default,,0000,0000,0000,,Егер Маэстро Венто
Dialogue: 0,0:50:17.98,0:50:20.95,Default,,0000,0000,0000,,...
Dialogue: 0,0:50:17.98,0:50:20.95,Default,,0000,0000,0000,,Сіз білуіңіз керек.
Dialogue: 0,0:50:21.95,0:50:25.02,Default,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:50:21.95,0:50:25.02,Default,,0000,0000,0000,,Жарайсың ба? Capek.
Dialogue: 0,0:50:25.02,0:50:28.99,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:50:25.02,0:50:28.99,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:50:25.02,0:50:28.99,Default,,0000,0000,0000,,Осы балаға бірдеңе болса
Dialogue: 0,0:50:25.02,0:50:28.99,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,0:50:25.02,0:50:28.99,Default,,0000,0000,0000,,Мен сені де оянуға бағдарламаладым.
Dialogue: 0,0:50:28.99,0:50:30.96,Default,,0000,0000,0000,,Мұғалім! ?
Dialogue: 0,0:50:30.96,0:50:34.97,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:50:30.96,0:50:34.97,Default,,0000,0000,0000,,Миха
Dialogue: 0,0:50:30.96,0:50:34.97,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:50:30.96,0:50:34.97,Default,,0000,0000,0000,,Мен оны бақылап отыруым керек.
Dialogue: 0,0:50:34.97,0:50:37.93,Default,,0000,0000,0000,,(Вентау)
Dialogue: 0,0:50:34.97,0:50:37.93,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:50:34.97,0:50:37.93,Default,,0000,0000,0000,,Біз Фаррдың өлуіне жол бере алмаймыз.
Dialogue: 0,0:50:38.97,0:50:40.97,Default,,0000,0000,0000,,Бұл бала→
Dialogue: 0,0:50:40.97,0:50:43.94,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,0:50:40.97,0:50:43.94,Default,,0000,0000,0000,,Мен Микканы сұрадым.
Dialogue: 0,0:50:47.98,0:50:49.98,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:50:49.98,0:50:53.95,Default,,0000,0000,0000,,Құрметті Микка, кешіріңіз.
Dialogue: 0,0:50:49.98,0:50:53.95,Default,,0000,0000,0000,,Мен… Мен….
Dialogue: 0,0:50:54.99,0:50:56.95,Default,,0000,0000,0000,,Микка-чан….
Dialogue: 0,0:50:54.99,0:50:56.95,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:50:56.95,0:50:58.99,Default,,0000,0000,0000,,Фуфуфуфуфуфу….
Dialogue: 0,0:50:58.99,0:51:01.96,Default,,0000,0000,0000,,Ахахаха...!
Dialogue: 0,0:50:58.99,0:51:01.96,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:51:01.96,0:51:06.00,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:51:01.96,0:51:06.00,Default,,0000,0000,0000,,Мен оны білдім!
Dialogue: 0,0:51:01.96,0:51:06.00,Default,,0000,0000,0000,,Capek Мен өтірік айтудан кенде емеспін.
Dialogue: 0,0:51:06.00,0:51:08.97,Default,,0000,0000,0000,,Маған музыкалық адамдар немесе басқа нәрсе маңызды емес!
Dialogue: 0,0:51:08.97,0:51:11.97,Default,,0000,0000,0000,,Моцель мырза, Бах мырза, т.б.
Dialogue: 0,0:51:08.97,0:51:11.97,Default,,0000,0000,0000,,Такирен-сан т.б. →
Dialogue: 0,0:51:11.97,0:51:14.97,Default,,0000,0000,0000,,Бұл жерде әлі де көп адамдар бар!
Dialogue: 0,0:51:11.97,0:51:14.97,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:51:14.97,0:51:17.97,Default,,0000,0000,0000,,Чика
Dialogue: 0,0:51:14.97,0:51:17.97,Default,,0000,0000,0000,,О.
Dialogue: 0,0:51:14.97,0:51:17.97,Default,,0000,0000,0000,,Мен тезірек барлығын оятуым керек!
Dialogue: 0,0:51:14.97,0:51:17.97,Default,,0000,0000,0000,,Паро!
Dialogue: 0,0:51:18.98,0:51:23.01,Default,,0000,0000,0000,,Кеттік Нохохон көзілдірігі!
Dialogue: 0,0:51:18.98,0:51:23.01,Default,,0000,0000,0000,,Capek де!
Dialogue: 0,0:51:23.01,0:51:25.98,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:51:23.01,0:51:25.98,Default,,0000,0000,0000,,Біз де кеттік!
Dialogue: 0,0:51:25.98,0:51:27.95,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:51:25.98,0:51:27.95,Default,,0000,0000,0000,,Уф… Ах…
Dialogue: 0,0:51:29.99,0:51:33.99,Default,,0000,0000,0000,,Мен, тағы да
Dialogue: 0,0:51:29.99,0:51:33.99,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:51:29.99,0:51:33.99,Default,,0000,0000,0000,,Мен ойнай алғым келеді...
Dialogue: 0,0:51:33.99,0:51:36.99,Default,,0000,0000,0000,,(Диктофон)
Dialogue: 0,0:51:33.99,0:51:36.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:36.99,0:51:39.00,Default,,0000,0000,0000,,(Диктофон)
Dialogue: 0,0:51:41.00,0:51:43.97,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:51:41.00,0:51:43.97,Default,,0000,0000,0000,,(Дыбыс деңгейін көтеру)
Dialogue: 0,0:51:45.00,0:51:46.97,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:51:47.97,0:51:49.97,Default,,0000,0000,0000,,Уау! !
Dialogue: 0,0:51:51.01,0:51:52.98,Default,,0000,0000,0000,,Барлығыңыз күтіңіздер!
Dialogue: 0,0:51:56.98,0:51:58.98,Default,,0000,0000,0000,,♬~ «Кейін кездескенше~»
Dialogue: 0,0:51:58.98,0:52:10.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:52:10.96,0:52:13.00,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:52:13.00,0:52:14.97,Default,,0000,0000,0000,,Қала
Dialogue: 0,0:52:13.00,0:52:14.97,Default,,0000,0000,0000,,Бұл қала ма?
Dialogue: 0,0:52:13.00,0:52:14.97,Default,,0000,0000,0000,,Сонымен... мені ұмытып қалғың келе ме?
Dialogue: 0,0:52:14.97,0:52:18.97,Default,,0000,0000,0000,,♬～(көрсетілім)
Dialogue: 0,0:52:18.97,0:52:22.97,Default,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:52:18.97,0:52:22.97,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:52:18.97,0:52:22.97,Default,,0000,0000,0000,,Бәрің, ояныңдар!
Dialogue: 0,0:52:18.97,0:52:22.97,Default,,0000,0000,0000,,Керемет! Көптеген!
Dialogue: 0,0:52:22.97,0:52:24.98,Default,,0000,0000,0000,,Ол мұнда бәрін талқандауға келген.
Dialogue: 0,0:52:24.98,0:52:28.98,Default,,0000,0000,0000,,Дебан
Dialogue: 0,0:52:24.98,0:52:28.98,Default,,0000,0000,0000,,Біздің кезегіміз!
Dialogue: 0,0:52:24.98,0:52:28.98,Default,,0000,0000,0000,,Қолы жоқ
Dialogue: 0,0:52:24.98,0:52:28.98,Default,,0000,0000,0000,,Өз дағдыларыңызды сынап көріңіз!
Dialogue: 0,0:52:28.98,0:52:30.98,Default,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:52:28.98,0:52:30.98,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:52:28.98,0:52:30.98,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:52:30.98,0:52:32.95,Default,,0000,0000,0000,,Микка-чан да!
Dialogue: 0,0:52:32.95,0:52:34.95,Default,,0000,0000,0000,,Уау...! иә!
Dialogue: 0,0:52:34.95,0:52:39.96,Default,,0000,0000,0000,,♬～(Өнімділік)
Dialogue: 0,0:52:39.96,0:53:06.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:53:06.95,0:53:13.06,Default,,0000,0000,0000,,
Dialogue: 0,0:53:13.06,0:53:30.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:53:30.97,0:53:47.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:53:47.99,0:53:49.99,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:53:47.99,0:53:49.99,Default,,0000,0000,0000,,Хэхехе!
Dialogue: 0,0:53:50.99,0:53:54.00,Default,,0000,0000,0000,,Сайкоу
Dialogue: 0,0:53:50.99,0:53:54.00,Default,,0000,0000,0000,,Біздің орындауымыз керемет болды!
Dialogue: 0,0:53:50.99,0:53:54.00,Default,,0000,0000,0000,,(Туба)
Dialogue: 0,0:53:54.00,0:53:58.00,Default,,0000,0000,0000,,Мучу
Dialogue: 0,0:53:54.00,0:53:58.00,Default,,0000,0000,0000,,Барлығы менің жеке әнім үшін ессіз болды!
Dialogue: 0,0:53:54.00,0:53:58.00,Default,,0000,0000,0000,,(скрипка)
Dialogue: 0,0:53:59.00,0:54:03.01,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:53:59.00,0:54:03.01,Default,,0000,0000,0000,,Не айттың!
Dialogue: 0,0:53:59.00,0:54:03.01,Default,,0000,0000,0000,,Сіздің солоңыз жақсырақ болды, солай ма?
Dialogue: 0,0:54:03.01,0:54:06.01,Default,,0000,0000,0000,,Жоқ, жоқ, бұл менмін.
Dialogue: 0,0:54:03.01,0:54:06.01,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:54:06.01,0:54:08.01,Default,,0000,0000,0000,,♬～ (шығыс орындау)
Dialogue: 0,0:54:06.01,0:54:08.01,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,0:54:06.01,0:54:08.01,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:54:08.01,0:54:11.98,Default,,0000,0000,0000,,♬～ (шамаланған өнімділік)
Dialogue: 0,0:54:11.98,0:54:15.99,Default,,0000,0000,0000,,Не? Мұнда.
Dialogue: 0,0:54:11.98,0:54:15.99,Default,,0000,0000,0000,,Уау, қорқынышты музыка...
Dialogue: 0,0:54:15.99,0:54:19.06,Default,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:54:15.99,0:54:19.06,Default,,0000,0000,0000,,Ол бұзылды ма?
Dialogue: 0,0:54:19.06,0:54:20.99,Default,,0000,0000,0000,,Ұрланған
Dialogue: 0,0:54:19.06,0:54:20.99,Default,,0000,0000,0000,,⚞ (шу)
Dialogue: 0,0:54:19.06,0:54:20.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:54:20.99,0:54:35.01,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:54:35.01,0:54:38.01,Default,,0000,0000,0000,,Не? Қазір.
Dialogue: 0,0:54:35.01,0:54:38.01,Default,,0000,0000,0000,,Бұл сегізаяқ па?
Dialogue: 0,0:54:38.01,0:54:40.01,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:54:38.01,0:54:40.01,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:54:40.01,0:54:42.01,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:54:40.01,0:54:42.01,Default,,0000,0000,0000,,Ал... күте тұрыңыз!
Dialogue: 0,0:54:42.01,0:54:46.98,Default,,0000,0000,0000,,♬～ (шығыс орындау)
Dialogue: 0,0:54:46.98,0:54:49.99,Default,,0000,0000,0000,,Баба Баба Бэнг Банг Бэнг!
Dialogue: 0,0:54:49.99,0:54:51.99,Default,,0000,0000,0000,,Мұндай қорқынышты тариф...
Dialogue: 0,0:54:51.99,0:54:56.99,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:54:51.99,0:54:56.99,Default,,0000,0000,0000,,♬～ «Мен шыдай алмаймын.»
Dialogue: 0,0:54:56.99,0:55:00.06,Default,,0000,0000,0000,,Кожо
Dialogue: 0,0:54:56.99,0:55:00.06,Default,,0000,0000,0000,,Менің фарре фабрикамда не болып жатыр?
Dialogue: 0,0:55:00.06,0:55:01.97,Default,,0000,0000,0000,,Бұрыш
Dialogue: 0,0:55:00.06,0:55:01.97,Default,,0000,0000,0000,,♬ ~ «Ақаулық бар ма?»
Dialogue: 0,0:55:01.97,0:55:06.00,Default,,0000,0000,0000,,Жұмыс
Dialogue: 0,0:55:01.97,0:55:06.00,Default,,0000,0000,0000,,Иә? Бұл олардың әрекеті ме? ?
Dialogue: 0,0:55:06.00,0:55:11.01,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:55:06.00,0:55:11.01,Default,,0000,0000,0000,,♬～“Жою～”
Dialogue: 0,0:55:11.01,0:55:13.01,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:55:13.01,0:55:14.98,Default,,0000,0000,0000,,
Dialogue: 0,0:55:14.98,0:55:17.98,Default,,0000,0000,0000,,Ittetete... Не болып жатыр?
Dialogue: 0,0:55:17.98,0:55:19.95,Default,,0000,0000,0000,,(шу)
Dialogue: 0,0:55:17.98,0:55:19.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:55:21.99,0:55:23.95,Default,,0000,0000,0000,,Ахх...!
Dialogue: 0,0:55:24.99,0:55:26.99,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:55:24.99,0:55:26.99,Default,,0000,0000,0000,,Йокан
Dialogue: 0,0:55:24.99,0:55:26.99,Default,,0000,0000,0000,,Сәлем! Менде жаман сезім бар ...
Dialogue: 0,0:55:29.96,0:55:32.00,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:55:32.00,0:55:34.96,Default,,0000,0000,0000,,
Dialogue: 0,0:55:32.00,0:55:34.96,Default,,0000,0000,0000,,Ах! Апыр-ай! Апыр-ай!
Dialogue: 0,0:55:34.96,0:55:36.97,Default,,0000,0000,0000,,
Dialogue: 0,0:55:34.96,0:55:36.97,Default,,0000,0000,0000,,Ой! Ой!
Dialogue: 0,0:55:36.97,0:55:43.97,Default,,0000,0000,0000,,♬~ “Некофунджатта”
Dialogue: 0,0:55:43.97,0:55:45.98,Default,,0000,0000,0000,,《Міне, басталды!》
Dialogue: 0,0:55:45.98,0:55:55.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:55:55.95,0:55:57.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:55:57.99,0:56:00.99,Default,,0000,0000,0000,,Гаххахаха...!
Dialogue: 0,0:56:00.99,0:56:02.96,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:56:00.99,0:56:02.96,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:56:00.99,0:56:02.96,Default,,0000,0000,0000,,Сіз білесіз бе? иә...?
Dialogue: 0,0:56:03.99,0:56:05.96,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:56:05.96,0:56:07.96,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:56:07.96,0:56:11.97,Default,,0000,0000,0000,,Біз аңызға айналғанбыз
Dialogue: 0,0:56:07.96,0:56:11.97,Default,,0000,0000,0000,,Бұл Биллидің айтқан өтірігі!
Dialogue: 0,0:56:11.97,0:56:13.97,Default,,0000,0000,0000,,Виртуоз.
Dialogue: 0,0:56:13.97,0:56:15.97,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:56:13.97,0:56:15.97,Default,,0000,0000,0000,,Бұл кім? Аты аңызға айналған Билли... иә?
Dialogue: 0,0:56:15.97,0:56:17.94,Default,,0000,0000,0000,,Уау! ?
Dialogue: 0,0:56:20.98,0:56:22.98,Default,,0000,0000,0000,,Джа Джа… Джан!
Dialogue: 0,0:56:22.98,0:56:25.98,Default,,0000,0000,0000,,Бұрынғы сегізаяқ! ?
Dialogue: 0,0:56:22.98,0:56:25.98,Default,,0000,0000,0000,,Өте көп!
Dialogue: 0,0:56:26.95,0:56:30.99,Default,,0000,0000,0000,,Хоуши
Dialogue: 0,0:56:26.95,0:56:30.99,Default,,0000,0000,0000,,А... бұл шу споралары!
Dialogue: 0,0:56:26.95,0:56:30.99,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:56:30.99,0:56:33.96,Default,,0000,0000,0000,,♬~ «Фарре ойнаңыз!
Dialogue: 0,0:56:30.99,0:56:33.96,Default,,0000,0000,0000,,Дәл қазір~”
Dialogue: 0,0:56:33.96,0:56:35.96,Default,,0000,0000,0000,,Жол ақысы?
Dialogue: 0,0:56:35.96,0:56:38.96,Default,,0000,0000,0000,,Мен түсінбеймін...
Dialogue: 0,0:56:35.96,0:56:38.96,Default,,0000,0000,0000,,Егер солай болса...
Dialogue: 0,0:56:40.00,0:56:44.97,Default,,0000,0000,0000,,♬～(Туба)
Dialogue: 0,0:56:44.97,0:56:49.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:56:50.97,0:56:55.98,Default,,0000,0000,0000,,♬～(скрипка)
Dialogue: 0,0:56:55.98,0:57:01.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:57:02.95,0:57:05.99,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:57:02.95,0:57:05.99,Default,,0000,0000,0000,,Ол еріді.
Dialogue: 0,0:57:02.95,0:57:05.99,Default,,0000,0000,0000,,Ракушо
Dialogue: 0,0:57:02.95,0:57:05.99,Default,,0000,0000,0000,,Оңай жеңіс!
Dialogue: 0,0:57:05.99,0:57:09.99,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:57:05.99,0:57:09.99,Default,,0000,0000,0000,,♬~ (Жұмысшы) «Ей, ақымақ, сенің артыңда».
Dialogue: 0,0:57:09.99,0:57:13.00,Default,,0000,0000,0000,,Хмм...? Апыр-ай!
Dialogue: 0,0:57:15.00,0:57:17.97,Default,,0000,0000,0000,,Уф! аа...!
Dialogue: 0,0:57:21.00,0:57:23.97,Default,,0000,0000,0000,,Сонымен... бұл өте үлкен...!
Dialogue: 0,0:57:21.00,0:57:23.97,Default,,0000,0000,0000,,Иә...!
Dialogue: 0,0:57:23.97,0:57:27.01,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:57:23.97,0:57:27.01,Default,,0000,0000,0000,,Она
Dialogue: 0,0:57:23.97,0:57:27.01,Default,,0000,0000,0000,,Үлкен болса да, сол кішкентаймен бірдей емес пе?
Dialogue: 0,0:57:27.01,0:57:29.01,Default,,0000,0000,0000,,Міне, солай!
Dialogue: 0,0:57:29.01,0:57:33.98,Default,,0000,0000,0000,,♬～(скрипка)
Dialogue: 0,0:57:29.01,0:57:33.98,Default,,0000,0000,0000,,♬～(Туба)
Dialogue: 0,0:57:33.98,0:57:39.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:57:40.99,0:57:43.96,Default,,0000,0000,0000,,Иә! Не... неге?! ?
Dialogue: 0,0:57:44.99,0:57:48.00,Default,,0000,0000,0000,,♬~ «Қандай сұмдық қойылым».
Dialogue: 0,0:57:48.00,0:57:50.97,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:57:48.00,0:57:50.97,Default,,0000,0000,0000,,Чозецу
Dialogue: 0,0:57:48.00,0:57:50.97,Default,,0000,0000,0000,,Менің трансценденттік техникама
Dialogue: 0,0:57:48.00,0:57:50.97,Default,,0000,0000,0000,,Сіз сараңсыз ба? ?
Dialogue: 0,0:57:50.97,0:57:55.00,Default,,0000,0000,0000,,Менің тамаша ойыным
Dialogue: 0,0:57:50.97,0:57:55.00,Default,,0000,0000,0000,,Оған не болды?
Dialogue: 0,0:57:55.00,0:58:01.01,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:57:55.00,0:58:01.01,Default,,0000,0000,0000,,♬~ «Балалар, сендер ештеңе түсінбейсіңдер.»
Dialogue: 0,0:58:01.01,0:58:04.98,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:58:01.01,0:58:04.98,Default,,0000,0000,0000,,♬ ~ «Шығарылым»
Dialogue: 0,0:58:04.98,0:58:06.98,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:58:08.02,0:58:11.99,Default,,0000,0000,0000,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:58:08.02,0:58:11.99,Default,,0000,0000,0000,,Уау! Апыр-ай! Апыр-ай...!
Dialogue: 0,0:58:13.99,0:58:16.99,Default,,0000,0000,0000,,Чова
Dialogue: 0,0:58:13.99,0:58:16.99,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:58:13.99,0:58:16.99,Default,,0000,0000,0000,,Мен тіпті тарифтерді үйлестіре алмайтыныма сене алмаймын...
Dialogue: 0,0:58:16.99,0:58:19.03,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:58:16.99,0:58:19.03,Default,,0000,0000,0000,,♬~ «Бірақ мәселе сонда».
Dialogue: 0,0:58:19.03,0:58:23.00,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:58:19.03,0:58:23.00,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:58:19.03,0:58:23.00,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:58:19.03,0:58:23.00,Default,,0000,0000,0000,,♬~ «Одан да көбеймес бұрын
Dialogue: 0,0:58:19.03,0:58:23.00,Default,,0000,0000,0000,,Менің жолымда...»
Dialogue: 0,0:58:23.00,0:58:25.00,Default,,0000,0000,0000,,О...!
Dialogue: 0,0:58:25.00,0:58:27.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:58:27.00,0:58:28.97,Default,,0000,0000,0000,,Хехехе… Біраз мақтанып қояйын
Dialogue: 0,0:58:30.01,0:58:35.01,Default,,0000,0000,0000,,Бах мырза
Dialogue: 0,0:58:30.01,0:58:35.01,Default,,0000,0000,0000,,Учуу
Dialogue: 0,0:58:30.01,0:58:35.01,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:58:30.01,0:58:35.01,Default,,0000,0000,0000,,Мен ғарышқа қарап тұрдым.
Dialogue: 0,0:58:35.01,0:58:39.98,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:58:35.01,0:58:39.98,Default,,0000,0000,0000,,Йокан
Dialogue: 0,0:58:35.01,0:58:39.98,Default,,0000,0000,0000,,Менде жағымсыз сезім бар.
Dialogue: 0,0:58:35.01,0:58:39.98,Default,,0000,0000,0000,,Киюу
Dialogue: 0,0:58:35.01,0:58:39.98,Default,,0000,0000,0000,,Менің қорқынышым негізсіз деп үміттенемін...
Dialogue: 0,0:58:40.98,0:58:43.05,Default,,0000,0000,0000,,Жағымсыз сезім?
Dialogue: 0,0:58:43.05,0:58:44.99,Default,,0000,0000,0000,,⚞Уф...!
Dialogue: 0,0:58:43.05,0:58:44.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:58:44.99,0:58:48.99,Default,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:58:44.99,0:58:48.99,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:58:44.99,0:58:48.99,Default,,0000,0000,0000,,Уау...! Менде қорқынышты оқиға болды...
Dialogue: 0,0:58:49.99,0:58:52.00,Default,,0000,0000,0000,,Пух...!
Dialogue: 0,0:58:52.00,0:58:56.07,Default,,0000,0000,0000,,Такеши-сан Сунео-сан!
Dialogue: 0,0:58:52.00,0:58:56.07,Default,,0000,0000,0000,,Сондықтан мен саған қайта-қайта өлмейтінімді айттым
Dialogue: 0,0:58:52.00,0:58:56.07,Default,,0000,0000,0000,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,0:58:52.00,0:58:56.07,Default,,0000,0000,0000,,Бұл арулар үйі...
Dialogue: 0,0:58:56.07,0:58:57.97,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:58:57.97,0:59:01.97,Default,,0000,0000,0000,,Чикюу
Dialogue: 0,0:58:57.97,0:59:01.97,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,0:58:57.97,0:59:01.97,Default,,0000,0000,0000,,-де
Dialogue: 0,0:58:57.97,0:59:01.97,Default,,0000,0000,0000,,Жақсы! Жерге оралып, басынан бастайық!
Dialogue: 0,0:58:57.97,0:59:01.97,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:59:01.97,0:59:04.97,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:59:01.97,0:59:04.97,Default,,0000,0000,0000,,Әй, біз де Жерге бара аламыз ба?
Dialogue: 0,0:59:04.97,0:59:06.98,Default,,0000,0000,0000,,Әрине!
Dialogue: 0,0:59:04.97,0:59:06.98,Default,,0000,0000,0000,,Хэхе!
Dialogue: 0,0:59:09.98,0:59:12.98,Default,,0000,0000,0000,,Ертең
Dialogue: 0,0:59:09.98,0:59:12.98,Default,,0000,0000,0000,,Жаз
Dialogue: 0,0:59:09.98,0:59:12.98,Default,,0000,0000,0000,,Ал, жазғы демалыс ертең басталады→
Dialogue: 0,0:59:12.98,0:59:18.02,Default,,0000,0000,0000,,Кисоку
Dialogue: 0,0:59:12.98,0:59:18.02,Default,,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:59:12.98,0:59:18.02,Default,,0000,0000,0000,,Сейкацу
Dialogue: 0,0:59:12.98,0:59:18.02,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:59:12.98,0:59:18.02,Default,,0000,0000,0000,,Тұрақты өмір сүріңіз
Dialogue: 0,0:59:12.98,0:59:18.02,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,0:59:12.98,0:59:18.02,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,0:59:12.98,0:59:18.02,Default,,0000,0000,0000,,Бастама
Dialogue: 0,0:59:12.98,0:59:18.02,Default,,0000,0000,0000,,Қауіпті жерлерден аулақ болыңыз.
Dialogue: 0,0:59:18.02,0:59:22.96,Default,,0000,0000,0000,,О
Dialogue: 0,0:59:18.02,0:59:22.96,Default,,0000,0000,0000,,Асо
Dialogue: 0,0:59:18.02,0:59:22.96,Default,,0000,0000,0000,,Мана
Dialogue: 0,0:59:18.02,0:59:22.96,Default,,0000,0000,0000,,Көп көңілді және көп нәрсені үйреніңіз
Dialogue: 0,0:59:18.02,0:59:22.96,Default,,0000,0000,0000,,Шукудай
Dialogue: 0,0:59:18.02,0:59:22.96,Default,,0000,0000,0000,,Васу
Dialogue: 0,0:59:18.02,0:59:22.96,Default,,0000,0000,0000,,Үй тапсырмасын ұмытпа!
Dialogue: 0,0:59:22.96,0:59:24.96,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:59:26.00,0:59:28.00,Default,,0000,0000,0000,,
Dialogue: 0,0:59:28.00,0:59:30.97,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:59:28.00,0:59:30.97,Default,,0000,0000,0000,,(шу аралас қоңыраулар)
Dialogue: 0,0:59:28.00,0:59:30.97,Default,,0000,0000,0000,,Бұрыш
Dialogue: 0,0:59:28.00,0:59:30.97,Default,,0000,0000,0000,,Иә? Ол қайтадан істен шықты ма?
Dialogue: 0,0:59:30.97,0:59:32.97,Default,,0000,0000,0000,,
Dialogue: 0,0:59:33.97,0:59:37.01,Default,,0000,0000,0000,,Ауыз
Dialogue: 0,0:59:33.97,0:59:37.01,Default,,0000,0000,0000,,♬～(ысқырық)
Dialogue: 0,0:59:33.97,0:59:37.01,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:59:33.97,0:59:37.01,Default,,0000,0000,0000,,♬～ (құлаққаптан музыка ағып жатыр)
Dialogue: 0,0:59:37.01,0:59:39.98,Default,,0000,0000,0000,,♬～ (музыка)
Dialogue: 0,0:59:37.01,0:59:39.98,Default,,0000,0000,0000,,Шингуки
Dialogue: 0,0:59:37.01,0:59:39.98,Default,,0000,0000,0000,,Юдон
Dialogue: 0,0:59:37.01,0:59:39.98,Default,,0000,0000,0000,,(Бағдаршам сигналы сигналы)
Dialogue: 0,0:59:41.01,0:59:44.95,Default,,0000,0000,0000,,Теннай
Dialogue: 0,0:59:41.01,0:59:44.95,Default,,0000,0000,0000,,♬～ (дүкендегі музыка)
Dialogue: 0,0:59:41.01,0:59:44.95,Default,,0000,0000,0000,,Шинкиоку
Dialogue: 0,0:59:41.01,0:59:44.95,Default,,0000,0000,0000,,Ах... Минаның жаңа әні!
Dialogue: 0,0:59:44.95,0:59:48.95,Default,,0000,0000,0000,,♬～ (музыка)
Dialogue: 0,0:59:48.95,0:59:50.95,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:59:48.95,0:59:50.95,Default,,0000,0000,0000,,Ия...!
Dialogue: 0,0:59:51.96,0:59:57.03,Default,,0000,0000,0000,,
Dialogue: 0,0:59:57.03,1:00:01.97,Default,,0000,0000,0000,,О.
Dialogue: 0,0:59:57.03,1:00:01.97,Default,,0000,0000,0000,,Мен жазғы демалыстағы үй тапсырмасын орындауым керек.
Dialogue: 0,0:59:57.03,1:00:01.97,Default,,0000,0000,0000,,Анам мені ешқайда жібермейді!
Dialogue: 0,1:00:01.97,1:00:04.97,Default,,0000,0000,0000,,Чика
Dialogue: 0,1:00:01.97,1:00:04.97,Default,,0000,0000,0000,,Тез бітіріңіз Нохохон көзілдірік!
Dialogue: 0,1:00:04.97,1:00:07.97,Default,,0000,0000,0000,,Асығыңыз! Асығыңыз! Асығыңыз!
Dialogue: 0,1:00:07.97,1:00:09.97,Default,,0000,0000,0000,,Дораемон...!
Dialogue: 0,1:00:09.97,1:00:11.98,Default,,0000,0000,0000,,Елдіандықтар маған бұйрық беріп тұр ма?
Dialogue: 0,1:00:09.97,1:00:11.98,Default,,0000,0000,0000,,Мен көмектесе алмаймын ...
Dialogue: 0,1:00:11.98,1:00:13.98,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,1:00:11.98,1:00:13.98,Default,,0000,0000,0000,,Абыр-сабыр!
Dialogue: 0,1:00:13.98,1:00:16.98,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,1:00:13.98,1:00:16.98,Default,,0000,0000,0000,,Құралдар
Dialogue: 0,1:00:13.98,1:00:16.98,Default,,0000,0000,0000,,Бұл шықты! Doraemon құпия құралы!
Dialogue: 0,1:00:16.98,1:00:18.95,Default,,0000,0000,0000,,Көңілді!
Dialogue: 0,1:00:16.98,1:00:18.95,Default,,0000,0000,0000,,...
Dialogue: 0,1:00:18.95,1:00:21.99,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,1:00:18.95,1:00:21.99,Default,,0000,0000,0000,,Бұл керемет, Нобита-сан!
Dialogue: 0,1:00:21.99,1:00:25.02,Default,,0000,0000,0000,,Беттері жоқ!
Dialogue: 0,1:00:21.99,1:00:25.02,Default,,0000,0000,0000,,Қате
Dialogue: 0,1:00:21.99,1:00:25.02,Default,,0000,0000,0000,,Қателерге толы...
Dialogue: 0,1:00:25.02,1:00:28.99,Default,,0000,0000,0000,,Асығыңыз! Асығыңыз!
Dialogue: 0,1:00:25.02,1:00:28.99,Default,,0000,0000,0000,,Асығыңыз! Асығыңыз! Асығыңыз!
Dialogue: 0,1:00:28.99,1:00:30.99,Default,,0000,0000,0000,,Келесі
Dialogue: 0,1:00:28.99,1:00:30.99,Default,,0000,0000,0000,,Никки
Dialogue: 0,1:00:28.99,1:00:30.99,Default,,0000,0000,0000,,Келесі күнделік!
Dialogue: 0,1:00:30.99,1:00:35.00,Default,,0000,0000,0000,,«Бүгін мен музыка орталығына бардым».
Dialogue: 0,1:00:35.00,1:00:37.97,Default,,0000,0000,0000,,«Бұл қызық болды»….
Dialogue: 0,1:00:37.97,1:00:42.01,Default,,0000,0000,0000,,Ал... келесі... келесі...
Dialogue: 0,1:00:42.01,1:00:45.04,Default,,0000,0000,0000,,Мен бетіме қайта оралдым.
Dialogue: 0,1:00:45.04,1:00:48.98,Default,,0000,0000,0000,,⚟Нобита Дора-чан
Dialogue: 0,1:00:45.04,1:00:48.98,Default,,0000,0000,0000,,Ванна
Dialogue: 0,1:00:45.04,1:00:48.98,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:00:45.04,1:00:48.98,Default,,0000,0000,0000,,Ванна қабылдаңыз!
Dialogue: 0,1:00:48.98,1:00:51.01,Default,,0000,0000,0000,,Ванна...?
Dialogue: 0,1:00:51.01,1:00:53.98,Default,,0000,0000,0000,,``Бүгін бәріміз шомылдық.''
Dialogue: 0,1:00:53.98,1:00:56.99,Default,,0000,0000,0000,,«Бұл қызық болды».
Dialogue: 0,1:01:12.00,1:01:13.97,Default,,0000,0000,0000,,Кайхеион
Dialogue: 0,1:01:12.00,1:01:13.97,Default,,0000,0000,0000,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:01:13.97,1:01:16.07,Default,,0000,0000,0000,,Нейки
Dialogue: 0,1:01:13.97,1:01:16.07,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,1:01:16.07,1:01:22.01,Default,,0000,0000,0000,,⚟♬～ (Диктофон)
Dialogue: 0,1:01:16.07,1:01:22.01,Default,,0000,0000,0000,,Иә? Фуфуфуфу….
Dialogue: 0,1:01:22.01,1:01:26.98,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,1:01:26.98,1:01:34.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:01:35.99,1:01:40.06,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,1:01:40.06,1:01:43.97,Default,,0000,0000,0000,,⚟♬～ (Диктофон)
Dialogue: 0,1:01:43.97,1:01:51.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:02:00.98,1:02:03.99,Default,,0000,0000,0000,,Ұзын
Dialogue: 0,1:02:00.98,1:02:03.99,Default,,0000,0000,0000,,(Дәретхананың ағу дыбысы)
Dialogue: 0,1:02:00.98,1:02:03.99,Default,,0000,0000,0000,,А...
Dialogue: 0,1:02:05.05,1:02:07.06,Default,,0000,0000,0000,,⚞♬～ (музыка)
Dialogue: 0,1:02:05.05,1:02:07.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:02:07.06,1:02:10.03,Default,,0000,0000,0000,,⚞♬～(музыка)
Dialogue: 0,1:02:10.99,1:02:14.96,Default,,0000,0000,0000,,Иә? Нобита?
Dialogue: 0,1:02:20.97,1:02:24.97,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:02:20.97,1:02:24.97,Default,,0000,0000,0000,,Хмм...? Бұл жай ғана менің қиялым ба?
Dialogue: 0,1:02:26.98,1:02:28.98,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:02:26.98,1:02:28.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:02:28.98,1:02:30.98,Default,,0000,0000,0000,,А... а~ а~….
Dialogue: 0,1:02:30.98,1:02:32.98,Default,,0000,0000,0000,,Не болды? Дораемон.
Dialogue: 0,1:02:32.98,1:02:36.99,Default,,0000,0000,0000,,Чоши
Dialogue: 0,1:02:32.98,1:02:36.99,Default,,0000,0000,0000,,Менің тамағымда бірдеңе бар... Гага!
Dialogue: 0,1:02:36.99,1:02:40.96,Default,,0000,0000,0000,,Жел
Dialogue: 0,1:02:36.99,1:02:40.96,Default,,0000,0000,0000,,О-
Dialogue: 0,1:02:36.99,1:02:40.96,Default,,0000,0000,0000,,Сіз суық тиіп қалдыңыз ба? Өтінемін.
Dialogue: 0,1:02:40.96,1:02:42.96,Default,,0000,0000,0000,,Мен келдім.
Dialogue: 0,1:02:47.00,1:02:49.97,Default,,0000,0000,0000,,Түс
Dialogue: 0,1:02:47.00,1:02:49.97,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,1:02:47.00,1:02:49.97,Default,,0000,0000,0000,,Менің тамағымның түсінде бірдеңе дұрыс емес.
Dialogue: 0,1:02:51.97,1:02:53.94,Default,,0000,0000,0000,,Кюкюбако
Dialogue: 0,1:02:51.97,1:02:53.94,Default,,0000,0000,0000,,Механикалық алғашқы көмек қобдишасы...
Dialogue: 0,1:02:54.97,1:02:57.97,Default,,0000,0000,0000,,Мен мұны да аламын. Гага...
Dialogue: 0,1:02:57.97,1:03:02.01,Default,,0000,0000,0000,,Мина
Dialogue: 0,1:02:57.97,1:03:02.01,Default,,0000,0000,0000,,Ал, бәріңе!
Dialogue: 0,1:02:57.97,1:03:02.01,Default,,0000,0000,0000,,Фуккатсу
Dialogue: 0,1:02:57.97,1:03:02.01,Default,,0000,0000,0000,,Даңқ залының қайта жандануы жақын жерде!
Dialogue: 0,1:03:02.01,1:03:04.95,Default,,0000,0000,0000,,Суко
Dialogue: 0,1:03:02.01,1:03:04.95,Default,,0000,0000,0000,,Қуат
Dialogue: 0,1:03:02.01,1:03:04.95,Default,,0000,0000,0000,,Немесе
Dialogue: 0,1:03:02.01,1:03:04.95,Default,,0000,0000,0000,,Бізге күш-қуатыңызды көбірек беріңізші!
Dialogue: 0,1:03:02.01,1:03:04.95,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:03:04.95,1:03:06.95,Default,,0000,0000,0000,,Олай болса кеттік!
Dialogue: 0,1:03:17.96,1:03:20.96,Default,,0000,0000,0000,,Өте сәнді сыйлық ұтып алыңыз
Dialogue: 0,1:03:17.96,1:03:20.96,Default,,0000,0000,0000,,Мәліметтерді тарату ойыны→
Dialogue: 0,1:03:20.96,1:03:22.97,Default,,0000,0000,0000,,«Фильм кейіпкерлерінің жинағы».
Dialogue: 0,1:03:22.97,1:03:25.94,Default,,0000,0000,0000,,Қатысу үшін d түймесін басыңыз.
Dialogue: 0,1:03:27.97,1:03:41.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:03:41.95,1:03:43.95,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,1:03:50.96,1:03:53.96,Default,,0000,0000,0000,,Ах... Уау!
Dialogue: 0,1:03:53.96,1:03:56.97,Default,,0000,0000,0000,,Бұл Даңқ залының басты алаңы!
Dialogue: 0,1:03:56.97,1:03:59.97,Default,,0000,0000,0000,,Сомен кеспесі
Dialogue: 0,1:03:56.97,1:03:59.97,Default,,0000,0000,0000,,Шинден
Dialogue: 0,1:03:56.97,1:03:59.97,Default,,0000,0000,0000,,Сіздің алдыңызда Маэстро храмы көрінеді!
Dialogue: 0,1:03:59.97,1:04:01.94,Default,,0000,0000,0000,,Міне!
Dialogue: 0,1:04:02.97,1:04:05.98,Default,,0000,0000,0000,,Гага….
Dialogue: 0,1:04:02.97,1:04:05.98,Default,,0000,0000,0000,,Ескертпе
Dialogue: 0,1:04:02.97,1:04:05.98,Default,,0000,0000,0000,,Ол оңай жазылмайды.
Dialogue: 0,1:04:05.98,1:04:07.98,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,1:04:05.98,1:04:07.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:04:07.98,1:04:10.98,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,1:04:07.98,1:04:10.98,Default,,0000,0000,0000,,Диктофонды ұмытып кетіппін!
Dialogue: 0,1:04:10.98,1:04:14.98,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,1:04:10.98,1:04:14.98,Default,,0000,0000,0000,,Қазірдің өзінде! Бұл шын жүректен шыққан!
Dialogue: 0,1:04:14.98,1:04:19.99,Default,,0000,0000,0000,,Жақсы емес пе?
Dialogue: 0,1:04:14.98,1:04:19.99,Default,,0000,0000,0000,,Гета
Dialogue: 0,1:04:14.98,1:04:19.99,Default,,0000,0000,0000,,Яку
Dialogue: 0,1:04:14.98,1:04:19.99,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,1:04:14.98,1:04:19.99,Default,,0000,0000,0000,,Бұл бәрібір ақсақ және пайдасыз.
Dialogue: 0,1:04:19.99,1:04:22.96,Default,,0000,0000,0000,,Жеткілікті
Dialogue: 0,1:04:19.99,1:04:22.96,Default,,0000,0000,0000,,Бізге жетеді!
Dialogue: 0,1:04:19.99,1:04:22.96,Default,,0000,0000,0000,,Міне...
Dialogue: 0,1:04:22.96,1:04:26.00,Default,,0000,0000,0000,,Мен де...!
Dialogue: 0,1:04:22.96,1:04:26.00,Default,,0000,0000,0000,,Оны қайда қалдырдың?
Dialogue: 0,1:04:26.00,1:04:28.97,Default,,0000,0000,0000,,Таши
Dialogue: 0,1:04:26.00,1:04:28.97,Default,,0000,0000,0000,,Кеше
Dialogue: 0,1:04:26.00,1:04:28.97,Default,,0000,0000,0000,,сәйкес
Dialogue: 0,1:04:26.00,1:04:28.97,Default,,0000,0000,0000,,Жастық көзі
Dialogue: 0,1:04:26.00,1:04:28.97,Default,,0000,0000,0000,,Мм... Кеше түнде жастығымда болған шығар...
Dialogue: 0,1:04:28.97,1:04:32.97,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,1:04:28.97,1:04:32.97,Default,,0000,0000,0000,,Бұдан былай есікке кез келген жерде оралуға болады.
Dialogue: 0,1:04:28.97,1:04:32.97,Default,,0000,0000,0000,,Өте
Dialogue: 0,1:04:28.97,1:04:32.97,Default,,0000,0000,0000,,Бұл қиын...
Dialogue: 0,1:04:32.97,1:04:34.97,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:04:34.97,1:04:36.97,Default,,0000,0000,0000,,...
Dialogue: 0,1:04:34.97,1:04:36.97,Default,,0000,0000,0000,,Кеңістік-уақыт өзгерткіш!
Dialogue: 0,1:04:36.97,1:04:39.98,Default,,0000,0000,0000,,Не? сол.
Dialogue: 0,1:04:36.97,1:04:39.98,Default,,0000,0000,0000,,...
Dialogue: 0,1:04:36.97,1:04:39.98,Default,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,1:04:36.97,1:04:39.98,Default,,0000,0000,0000,,Тек көрсетілген диапазон →
Dialogue: 0,1:04:39.98,1:04:44.01,Default,,0000,0000,0000,,Бөлме
Dialogue: 0,1:04:39.98,1:04:44.01,Default,,0000,0000,0000,,Юбедегі Нобита-кунның бөлмесінде
Dialogue: 0,1:04:39.98,1:04:44.01,Default,,0000,0000,0000,,Немесе
Dialogue: 0,1:04:39.98,1:04:44.01,Default,,0000,0000,0000,,Оны өзгертуге болады. Гагагага….
Dialogue: 0,1:04:44.01,1:04:46.02,Default,,0000,0000,0000,,Өзгертуге болатын нәрсе →
Dialogue: 0,1:04:46.02,1:04:49.99,Default,,0000,0000,0000,,Како
Dialogue: 0,1:04:46.02,1:04:49.99,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,1:04:46.02,1:04:49.99,Default,,0000,0000,0000,,Мұнда емес.
Dialogue: 0,1:04:46.02,1:04:49.99,Default,,0000,0000,0000,,Соңғы 24 сағат ішінде сонда болдыңыз ба?
Dialogue: 0,1:04:46.02,1:04:49.99,Default,,0000,0000,0000,,Кілт
Dialogue: 0,1:04:46.02,1:04:49.99,Default,,0000,0000,0000,,Орын мен уақытпен шектелген.
Dialogue: 0,1:04:49.99,1:04:51.99,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,1:04:51.99,1:04:55.02,Default,,0000,0000,0000,,Содан кейін ауқымды көрсетіңіз.
Dialogue: 0,1:04:55.02,1:04:57.99,Default,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,1:04:55.02,1:04:57.99,Default,,0000,0000,0000,,Аа, сәл артқа шегініңіз.
Dialogue: 0,1:04:55.02,1:04:57.99,Default,,0000,0000,0000,,Иә иә….
Dialogue: 0,1:04:57.99,1:05:01.96,Default,,0000,0000,0000,,Бұл құрал
Dialogue: 0,1:04:57.99,1:05:01.96,Default,,0000,0000,0000,,Арамызда
Dialogue: 0,1:04:57.99,1:05:01.96,Default,,0000,0000,0000,,Чосетсу
Dialogue: 0,1:04:57.99,1:05:01.96,Default,,0000,0000,0000,,Күрделі
Dialogue: 0,1:04:57.99,1:05:01.96,Default,,0000,0000,0000,,Кеңістік пен уақыт өлшемін реттеу қиын.
Dialogue: 0,1:05:01.96,1:05:04.97,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:05:01.96,1:05:04.97,Default,,0000,0000,0000,,Егер дұрыс сәйкес келмесе
Dialogue: 0,1:05:01.96,1:05:04.97,Default,,0000,0000,0000,,Іс күрделене түседі.
Dialogue: 0,1:05:04.97,1:05:07.97,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,1:05:04.97,1:05:07.97,Default,,0000,0000,0000,,Бұл Нобита-кунның бөлмесі шығар.
Dialogue: 0,1:05:07.97,1:05:09.97,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:05:09.97,1:05:14.01,Default,,0000,0000,0000,,Зура
Dialogue: 0,1:05:09.97,1:05:14.01,Default,,0000,0000,0000,,Уау! Хаха! Бұл ақымақ бет.
Dialogue: 0,1:05:14.01,1:05:17.01,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,1:05:14.01,1:05:17.01,Default,,0000,0000,0000,,Бұл менмін...
Dialogue: 0,1:05:14.01,1:05:17.01,Default,,0000,0000,0000,,Иә? жоқ!
Dialogue: 0,1:05:17.01,1:05:19.98,Default,,0000,0000,0000,,Қорытынды
Dialogue: 0,1:05:17.01,1:05:19.98,Default,,0000,0000,0000,,О.
Dialogue: 0,1:05:17.01,1:05:19.98,Default,,0000,0000,0000,,Сіз шынымен оны соңғы рет осы бөлмеге қойдыңыз ба?
Dialogue: 0,1:05:19.98,1:05:22.99,Default,,0000,0000,0000,,Фуроба
Dialogue: 0,1:05:19.98,1:05:22.99,Default,,0000,0000,0000,,А, дұрыс! Бұл ванна бөлмесі!
Dialogue: 0,1:05:22.99,1:05:24.99,Default,,0000,0000,0000,,Жалпы...
Dialogue: 0,1:05:24.99,1:05:27.99,Default,,0000,0000,0000,,Мм... жуынатын бөлме.
Dialogue: 0,1:05:24.99,1:05:27.99,Default,,0000,0000,0000,,Кешіріңіз. Кешіріңіз.
Dialogue: 0,1:05:30.99,1:05:33.00,Default,,0000,0000,0000,,Міне болды!
Dialogue: 0,1:05:33.00,1:05:36.00,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,1:05:33.00,1:05:36.00,Default,,0000,0000,0000,,Күткеніңізге рахмет!
Dialogue: 0,1:05:33.00,1:05:36.00,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,1:05:33.00,1:05:36.00,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,1:05:36.00,1:05:38.00,Default,,0000,0000,0000,,Бірақ неге ваннада?
Dialogue: 0,1:05:38.00,1:05:40.97,Default,,0000,0000,0000,,Жарық
Dialogue: 0,1:05:38.00,1:05:40.97,Default,,0000,0000,0000,,Білім
Dialogue: 0,1:05:38.00,1:05:40.97,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:05:38.00,1:05:40.97,Default,,0000,0000,0000,,Дыбыс жаңғырып, жақсы естисіз.
Dialogue: 0,1:05:42.97,1:05:47.01,Default,,0000,0000,0000,,Мұғалім! Бұл мен! Capek осында!
Dialogue: 0,1:05:47.01,1:05:49.01,Default,,0000,0000,0000,,Бұл керемет...
Dialogue: 0,1:05:49.01,1:05:51.98,Default,,0000,0000,0000,,Мұғалім! Венто мырза!
Dialogue: 0,1:05:51.98,1:05:54.98,Default,,0000,0000,0000,,Жаз
Dialogue: 0,1:05:51.98,1:05:54.98,Default,,0000,0000,0000,,Есте сақтауыңызға рахмет!
Dialogue: 0,1:05:51.98,1:05:54.98,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,1:05:51.98,1:05:54.98,Default,,0000,0000,0000,,Мен Микка-саманы әкелдім!
Dialogue: 0,1:05:54.98,1:05:56.99,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:05:54.98,1:05:56.99,Default,,0000,0000,0000,,Ал тыңдаңыз!
Dialogue: 0,1:05:56.99,1:05:59.99,Default,,0000,0000,0000,,Жерден, Виртуоздар
Dialogue: 0,1:05:56.99,1:05:59.99,Default,,0000,0000,0000,,Қорқынышты түс көрдің бе?
Dialogue: 0,1:05:56.99,1:05:59.99,Default,,0000,0000,0000,,Сізді шақырамыз!
Dialogue: 0,1:06:06.00,1:06:08.06,Default,,0000,0000,0000,,На
Dialogue: 0,1:06:06.00,1:06:08.06,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,1:06:06.00,1:06:08.06,Default,,0000,0000,0000,,(Чапектің айқайы)
Dialogue: 0,1:06:08.06,1:06:16.01,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:06:16.01,1:06:17.97,Default,,0000,0000,0000,,Га-га-га-га….
Dialogue: 0,1:06:20.08,1:06:22.04,Default,,0000,0000,0000,,⚟Хмм….
Dialogue: 0,1:06:22.98,1:06:25.98,Default,,0000,0000,0000,,Міне! Гага...
Dialogue: 0,1:06:25.98,1:06:27.95,Default,,0000,0000,0000,,Иә? Эх...
Dialogue: 0,1:06:30.99,1:06:34.96,Default,,0000,0000,0000,,Уф... мен көріп тұрмын...
Dialogue: 0,1:06:34.96,1:06:36.96,Default,,0000,0000,0000,,Матсуда мырза өледі.
Dialogue: 0,1:06:34.96,1:06:36.96,Default,,0000,0000,0000,,Мен кіммін...?
Dialogue: 0,1:06:36.96,1:06:42.97,Default,,0000,0000,0000,,Мұғалім! жақсы! Жақсы...!
Dialogue: 0,1:06:44.00,1:06:48.97,Default,,0000,0000,0000,,Солай болды ма?
Dialogue: 0,1:06:44.00,1:06:48.97,Default,,0000,0000,0000,,Гата
Dialogue: 0,1:06:44.00,1:06:48.97,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,1:06:44.00,1:06:48.97,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:06:44.00,1:06:48.97,Default,,0000,0000,0000,,Сізге қалай алғыс айта аламын...
Dialogue: 0,1:06:48.97,1:06:51.97,Default,,0000,0000,0000,,Чапек те жақсы жұмыс жасады.
Dialogue: 0,1:06:51.97,1:06:53.98,Default,,0000,0000,0000,,Жоқ...!
Dialogue: 0,1:06:53.98,1:06:58.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:06:58.98,1:07:00.98,Default,,0000,0000,0000,,Микка, солай ма?
Dialogue: 0,1:07:00.98,1:07:04.99,Default,,0000,0000,0000,,Мен... Сізден сұрайын дегенім бар.
Dialogue: 0,1:07:04.99,1:07:07.96,Default,,0000,0000,0000,,Хоро
Dialogue: 0,1:07:04.99,1:07:07.96,Default,,0000,0000,0000,,Мушика неліктен өлді?
Dialogue: 0,1:07:07.96,1:07:10.96,Default,,0000,0000,0000,,Микка-чан….
Dialogue: 0,1:07:10.96,1:07:13.96,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,1:07:10.96,1:07:13.96,Default,,0000,0000,0000,,Мен білгім келеді! Шыны.
Dialogue: 0,1:07:15.97,1:07:18.97,Default,,0000,0000,0000,,Кокио
Dialogue: 0,1:07:15.97,1:07:18.97,Default,,0000,0000,0000,,Толқу
Dialogue: 0,1:07:15.97,1:07:18.97,Default,,0000,0000,0000,,Біздің Отанымыз Мушика планетасы→
Dialogue: 0,1:07:18.97,1:07:22.94,Default,,0000,0000,0000,,Көңілсіз
Dialogue: 0,1:07:18.97,1:07:22.94,Default,,0000,0000,0000,,Хоши
Dialogue: 0,1:07:18.97,1:07:22.94,Default,,0000,0000,0000,,Тарифтерге толы әдемі жұлдыз еді...
Dialogue: 0,1:07:23.97,1:07:28.98,Default,,0000,0000,0000,,♬～ (ән айту және ойнау)
Dialogue: 0,1:07:28.98,1:07:30.95,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,1:07:28.98,1:07:30.95,Default,,0000,0000,0000,,Дегенмен, белгілі бір уақытта→
Dialogue: 0,1:07:30.95,1:07:34.95,Default,,0000,0000,0000,,Тарифтік энергия
Dialogue: 0,1:07:30.95,1:07:34.95,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,1:07:30.95,1:07:34.95,Default,,0000,0000,0000,,Джи
Dialogue: 0,1:07:30.95,1:07:34.95,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,1:07:30.95,1:07:34.95,Default,,0000,0000,0000,,О, құдайым
Dialogue: 0,1:07:30.95,1:07:34.95,Default,,0000,0000,0000,,Монополияға алғысы келетіндер пайда болады→
Dialogue: 0,1:07:34.95,1:07:38.99,Default,,0000,0000,0000,,Адамдар
Dialogue: 0,1:07:34.95,1:07:38.99,Default,,0000,0000,0000,,Кана
Dialogue: 0,1:07:34.95,1:07:38.99,Default,,0000,0000,0000,,Кинши
Dialogue: 0,1:07:34.95,1:07:38.99,Default,,0000,0000,0000,,Адамдарға фарре ойнауға тыйым салынды.
Dialogue: 0,1:07:38.99,1:07:41.96,Default,,0000,0000,0000,,Якуза
Dialogue: 0,1:07:38.99,1:07:41.96,Default,,0000,0000,0000,,Бұл үлкен апат...→
Dialogue: 0,1:07:41.96,1:07:45.96,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,1:07:41.96,1:07:45.96,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,1:07:41.96,1:07:45.96,Default,,0000,0000,0000,,Мен шу әкелдім...!
Dialogue: 0,1:07:45.96,1:07:47.96,Default,,0000,0000,0000,,Шу?
Dialogue: 0,1:07:47.96,1:07:49.97,Default,,0000,0000,0000,,Жақында
Dialogue: 0,1:07:47.96,1:07:49.97,Default,,0000,0000,0000,,Кедергі
Dialogue: 0,1:07:47.96,1:07:49.97,Default,,0000,0000,0000,,Сіз шу немесе алаңдататын дыбыстарды айтасыз ба?
Dialogue: 0,1:07:49.97,1:07:51.97,Default,,0000,0000,0000,,Дыбыс емес.
Dialogue: 0,1:07:49.97,1:07:51.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:07:51.97,1:07:54.94,Default,,0000,0000,0000,,Сонзай
Dialogue: 0,1:07:51.97,1:07:54.94,Default,,0000,0000,0000,,Ол ғаламда бар.
Dialogue: 0,1:07:58.01,1:08:02.98,Default,,0000,0000,0000,,Шу деген не?
Dialogue: 0,1:07:58.01,1:08:02.98,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,1:07:58.01,1:08:02.98,Default,,0000,0000,0000,,Ағайындылар
Dialogue: 0,1:07:58.01,1:08:02.98,Default,,0000,0000,0000,,Учуусеймейтай
Dialogue: 0,1:07:58.01,1:08:02.98,Default,,0000,0000,0000,,Жұлдыздарды жейтін алып ғарыштық тіршілік формасы...
Dialogue: 0,1:08:02.98,1:08:06.95,Default,,0000,0000,0000,,Химей
Dialogue: 0,1:08:02.98,1:08:06.95,Default,,0000,0000,0000,,(Адамдар айғайлайды)
Dialogue: 0,1:08:07.98,1:08:10.99,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,1:08:07.98,1:08:10.99,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:08:07.98,1:08:10.99,Default,,0000,0000,0000,,Бәріне кеш болды.
Dialogue: 0,1:08:10.99,1:08:15.99,Default,,0000,0000,0000,,Біз
Dialogue: 0,1:08:10.99,1:08:15.99,Default,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,1:08:10.99,1:08:15.99,Default,,0000,0000,0000,,Игай
Dialogue: 0,1:08:10.99,1:08:15.99,Default,,0000,0000,0000,,Жұлдыздарды лақтырып тастаудан басқа қолымнан келмеді...
Dialogue: 0,1:08:16.99,1:08:20.00,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:08:16.99,1:08:20.00,Default,,0000,0000,0000,,Өте қорқынышты нәрсе...
Dialogue: 0,1:08:20.00,1:08:21.96,Default,,0000,0000,0000,,Уф! Гага... Гага...!
Dialogue: 0,1:08:21.96,1:08:25.00,Default,,0000,0000,0000,,Дораемон! Сіз шынымен жақсысыз ба?
Dialogue: 0,1:08:25.00,1:08:26.97,Default,,0000,0000,0000,,Түс қандай да бір түрде өзгерді ме?
Dialogue: 0,1:08:28.00,1:08:32.98,Default,,0000,0000,0000,,Шоджо
Dialogue: 0,1:08:28.00,1:08:32.98,Default,,0000,0000,0000,,Күте тұрыңыз! Симптомдары...
Dialogue: 0,1:08:28.00,1:08:32.98,Default,,0000,0000,0000,,Хоуши
Dialogue: 0,1:08:28.00,1:08:32.98,Default,,0000,0000,0000,,Жұмыс
Dialogue: 0,1:08:28.00,1:08:32.98,Default,,0000,0000,0000,,Бұл шу спораларының жұмысы болса керек!
Dialogue: 0,1:08:32.98,1:08:35.01,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,1:08:32.98,1:08:35.01,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,1:08:32.98,1:08:35.01,Default,,0000,0000,0000,,(жөтел)
Dialogue: 0,1:08:35.01,1:08:37.98,Default,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,1:08:35.01,1:08:37.98,Default,,0000,0000,0000,,Бұл жақсы емес... Шу келеді!
Dialogue: 0,1:08:37.98,1:08:41.98,Default,,0000,0000,0000,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,1:08:37.98,1:08:41.98,Default,,0000,0000,0000,,Кира
Dialogue: 0,1:08:37.98,1:08:41.98,Default,,0000,0000,0000,,Шу фаррды жек көреді, солай ма?
Dialogue: 0,1:08:41.98,1:08:45.99,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,1:08:41.98,1:08:45.99,Default,,0000,0000,0000,,Жер тұрақты
Dialogue: 0,1:08:41.98,1:08:45.99,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,1:08:41.98,1:08:45.99,Default,,0000,0000,0000,,Ол фарремен толтырылуы керек еді...
Dialogue: 0,1:08:45.99,1:08:47.96,Default,,0000,0000,0000,,Мүмкін...
Dialogue: 0,1:08:54.96,1:08:57.97,Default,,0000,0000,0000,,Күнделікті алдын ала жазыңыз!
Dialogue: 0,1:08:54.96,1:08:57.97,Default,,0000,0000,0000,,Gagagagagagagga!
Dialogue: 0,1:08:57.97,1:09:00.97,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:08:57.97,1:09:00.97,Default,,0000,0000,0000,,Жерге шуыл келсе...
Dialogue: 0,1:09:01.97,1:09:05.01,Default,,0000,0000,0000,,Бұл жаман емес пе...?
Dialogue: 0,1:09:01.97,1:09:05.01,Default,,0000,0000,0000,,Не... не істеуіміз керек! ?
Dialogue: 0,1:09:05.01,1:09:08.98,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:09:05.01,1:09:08.98,Default,,0000,0000,0000,,Жерге шу шабуылы алдында
Dialogue: 0,1:09:05.01,1:09:08.98,Default,,0000,0000,0000,,Мақсат
Dialogue: 0,1:09:05.01,1:09:08.98,Default,,0000,0000,0000,,Залды ояту.
Dialogue: 0,1:09:08.98,1:09:11.98,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,1:09:08.98,1:09:11.98,Default,,0000,0000,0000,,Ширизо
Dialogue: 0,1:09:08.98,1:09:11.98,Default,,0000,0000,0000,,Сіз оны жеңе алуыңыз керек!
Dialogue: 0,1:09:16.99,1:09:19.99,Default,,0000,0000,0000,,Бұл залдың негізгі қосқышы.
Dialogue: 0,1:09:19.99,1:09:21.99,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:09:21.99,1:09:26.00,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:09:21.99,1:09:26.00,Default,,0000,0000,0000,,Коммутаторды қосу үшін
Dialogue: 0,1:09:21.99,1:09:26.00,Default,,0000,0000,0000,,Bue
Dialogue: 0,1:09:21.99,1:09:26.00,Default,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,1:09:21.99,1:09:26.00,Default,,0000,0000,0000,,Саған Мушиканың сыбызғы керек.
Dialogue: 0,1:09:26.00,1:09:28.00,Default,,0000,0000,0000,,Сол ұзын флейта →
Dialogue: 0,1:09:28.00,1:09:31.97,Default,,0000,0000,0000,,Джин
Dialogue: 0,1:09:28.00,1:09:31.97,Default,,0000,0000,0000,,Соңғы Мушика
Dialogue: 0,1:09:28.00,1:09:31.97,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,1:09:28.00,1:09:31.97,Default,,0000,0000,0000,,Тек Микка ойнай алады.
Dialogue: 0,1:09:31.97,1:09:33.97,Default,,0000,0000,0000,,Тек мен үшін...
Dialogue: 0,1:09:33.97,1:09:35.97,Default,,0000,0000,0000,,Соңғы….
Dialogue: 0,1:09:36.97,1:09:39.98,Default,,0000,0000,0000,,Мика.
Dialogue: 0,1:09:36.97,1:09:39.98,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,1:09:39.98,1:09:42.95,Default,,0000,0000,0000,,Егіздер
Dialogue: 0,1:09:39.98,1:09:42.95,Default,,0000,0000,0000,,Қарындасы
Dialogue: 0,1:09:39.98,1:09:42.95,Default,,0000,0000,0000,,Сіздің егіз қарындасыңыз болды.
Dialogue: 0,1:09:45.98,1:09:47.95,Default,,0000,0000,0000,,Әпке...?
Dialogue: 0,1:09:50.02,1:09:53.99,Default,,0000,0000,0000,,Ұзын
Dialogue: 0,1:09:50.02,1:09:53.99,Default,,0000,0000,0000,,Кел
Dialogue: 0,1:09:50.02,1:09:53.99,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,1:09:50.02,1:09:53.99,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,1:09:50.02,1:09:53.99,Default,,0000,0000,0000,,Ұзақ және азапты жолдың соңында
Dialogue: 0,1:09:50.02,1:09:53.99,Default,,0000,0000,0000,,Оны Жер→ дейміз
Dialogue: 0,1:09:53.99,1:09:58.99,Default,,0000,0000,0000,,Сеймей
Dialogue: 0,1:09:53.99,1:09:58.99,Default,,0000,0000,0000,,Біздікіне ұқсас тіршілік бар планета
Dialogue: 0,1:09:53.99,1:09:58.99,Default,,0000,0000,0000,,Табылды.
Dialogue: 0,1:09:58.99,1:10:02.00,Default,,0000,0000,0000,,Балалар
Dialogue: 0,1:09:58.99,1:10:02.00,Default,,0000,0000,0000,,Соңғы балалар егіз болды.
Dialogue: 0,1:10:02.00,1:10:07.00,Default,,0000,0000,0000,,Тұқым
Dialogue: 0,1:10:02.00,1:10:07.00,Default,,0000,0000,0000,,Бүгін
Dialogue: 0,1:10:02.00,1:10:07.00,Default,,0000,0000,0000,,Musika тұқымдарының өліп кетуіне жол бермеу
Dialogue: 0,1:10:02.00,1:10:07.00,Default,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,1:10:02.00,1:10:07.00,Default,,0000,0000,0000,,қою
Dialogue: 0,1:10:02.00,1:10:07.00,Default,,0000,0000,0000,,Жерге бір адам жіберілді→
Dialogue: 0,1:10:07.00,1:10:11.01,Default,,0000,0000,0000,,Басқа адам
Dialogue: 0,1:10:07.00,1:10:11.01,Default,,0000,0000,0000,,Даңқ залында суық ұйқыға кеттім.
Dialogue: 0,1:10:11.01,1:10:13.98,Default,,0000,0000,0000,,Бұл мен...?
Dialogue: 0,1:10:13.98,1:10:16.98,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:10:16.98,1:10:21.98,Default,,0000,0000,0000,,Ал мен Жерге жіберген апаңа.
Dialogue: 0,1:10:16.98,1:10:21.98,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,1:10:16.98,1:10:21.98,Default,,0000,0000,0000,,Оған сыбызғы тарту етті.
Dialogue: 0,1:10:21.98,1:10:28.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:10:28.99,1:10:33.00,Default,,0000,0000,0000,,Манненмае
Dialogue: 0,1:10:28.99,1:10:33.00,Default,,0000,0000,0000,,Әңгіме
Dialogue: 0,1:10:28.99,1:10:33.00,Default,,0000,0000,0000,,Бұл 40 000 жыл бұрын болған.
Dialogue: 0,1:10:33.00,1:10:36.00,Default,,0000,0000,0000,,40 000 жыл… флейта….
Dialogue: 0,1:10:36.00,1:10:38.00,Default,,0000,0000,0000,,А... дұрыс!
Dialogue: 0,1:10:38.00,1:10:41.00,Default,,0000,0000,0000,,
Dialogue: 0,1:10:38.00,1:10:41.00,Default,,0000,0000,0000,,Бұл біртүрлі...
Dialogue: 0,1:10:41.00,1:10:43.97,Default,,0000,0000,0000,,Не? кінә? Сондай-ақ…. Өте ыстық...!
Dialogue: 0,1:10:45.01,1:10:49.01,Default,,0000,0000,0000,,
Dialogue: 0,1:10:45.01,1:10:49.01,Default,,0000,0000,0000,,Не болып жатыр?!
Dialogue: 0,1:10:49.01,1:10:51.98,Default,,0000,0000,0000,,Дансей
Dialogue: 0,1:10:49.01,1:10:51.98,Default,,0000,0000,0000,,Не болып жатыр? Бұл рекорд!
Dialogue: 0,1:10:51.98,1:10:54.02,Default,,0000,0000,0000,,...
Dialogue: 0,1:10:51.98,1:10:54.02,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:10:51.98,1:10:54.02,Default,,0000,0000,0000,,Смартфондағы деректер жоғалып кетті!
Dialogue: 0,1:10:54.02,1:10:55.99,Default,,0000,0000,0000,,Тауық
Dialogue: 0,1:10:54.02,1:10:55.99,Default,,0000,0000,0000,,Анашым! Фортепиано біртүрлі!
Dialogue: 0,1:10:55.99,1:10:57.99,Default,,0000,0000,0000,,Чууши
Dialogue: 0,1:10:55.99,1:10:57.99,Default,,0000,0000,0000,,Концерт тоқтатылды.
Dialogue: 0,1:10:57.99,1:10:59.99,Default,,0000,0000,0000,,А-а, менің тамағым...
Dialogue: 0,1:10:59.99,1:11:02.99,Default,,0000,0000,0000,,Бұл теледидарда не болып жатыр?
Dialogue: 0,1:11:02.99,1:11:11.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:11:14.00,1:11:16.01,Default,,0000,0000,0000,,Уау….
Dialogue: 0,1:11:16.01,1:11:18.97,Default,,0000,0000,0000,,Бұл қайда?
Dialogue: 0,1:11:16.01,1:11:18.97,Default,,0000,0000,0000,,Хакубутсу соққысы
Dialogue: 0,1:11:16.01,1:11:18.97,Default,,0000,0000,0000,,Мұражай.
Dialogue: 0,1:11:18.97,1:11:22.01,Default,,0000,0000,0000,,Музыка
Dialogue: 0,1:11:18.97,1:11:22.01,Default,,0000,0000,0000,,Джуджио
Dialogue: 0,1:11:18.97,1:11:22.01,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:11:18.97,1:11:22.01,Default,,0000,0000,0000,,Қараңызшы, сіз музыка сабағында осылай дедіңіз, солай ма?
Dialogue: 0,1:11:22.01,1:11:25.01,Default,,0000,0000,0000,,Аққу
Dialogue: 0,1:11:22.01,1:11:25.01,Default,,0000,0000,0000,,Фью
Dialogue: 0,1:11:22.01,1:11:25.01,Default,,0000,0000,0000,,Әй, аққудың ысқырығы!
Dialogue: 0,1:11:25.01,1:11:26.98,Default,,0000,0000,0000,,Эй!
Dialogue: 0,1:11:25.01,1:11:26.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:11:26.98,1:11:31.02,Default,,0000,0000,0000,,Осыны айтып тұрған жоқсыз ба?
Dialogue: 0,1:11:26.98,1:11:31.02,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,1:11:26.98,1:11:31.02,Default,,0000,0000,0000,,А, бұл рас!
Dialogue: 0,1:11:31.02,1:11:33.99,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,1:11:31.02,1:11:33.99,Default,,0000,0000,0000,,Кенже
Dialogue: 0,1:11:31.02,1:11:33.99,Default,,0000,0000,0000,,Бұл өте кішкентай.
Dialogue: 0,1:11:33.99,1:11:36.99,Default,,0000,0000,0000,,Bue
Dialogue: 0,1:11:33.99,1:11:36.99,Default,,0000,0000,0000,,Бұл Мушиканың сыбызғы ма?
Dialogue: 0,1:11:36.99,1:11:38.96,Default,,0000,0000,0000,,Фуру
Dialogue: 0,1:11:36.99,1:11:38.96,Default,,0000,0000,0000,,Түсіну үшін тым ескі...
Dialogue: 0,1:11:40.00,1:11:43.00,Default,,0000,0000,0000,,Гагагагага~!
Dialogue: 0,1:11:43.00,1:11:46.97,Default,,0000,0000,0000,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,1:11:43.00,1:11:46.97,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,1:11:43.00,1:11:46.97,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,1:11:43.00,1:11:46.97,Default,,0000,0000,0000,,Омоидеколоннан флейтаның жадын көруге болады.
Dialogue: 0,1:11:53.98,1:11:55.94,Default,,0000,0000,0000,,Уау.
Dialogue: 0,1:11:56.98,1:11:59.95,Default,,0000,0000,0000,,На
Dialogue: 0,1:11:56.98,1:11:59.95,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,1:11:56.98,1:11:59.95,Default,,0000,0000,0000,,(аққудың айқайы)
Dialogue: 0,1:11:56.98,1:11:59.95,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,1:12:02.99,1:12:07.96,Default,,0000,0000,0000,,♬～(ысқырық)
Dialogue: 0,1:12:07.96,1:12:14.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:12:14.96,1:12:17.97,Default,,0000,0000,0000,,Уау... аққуға ұқсайды.
Dialogue: 0,1:12:24.97,1:12:27.98,Default,,0000,0000,0000,,(Үлдеген дыбыс)
Dialogue: 0,1:12:24.97,1:12:27.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:12:27.98,1:12:32.05,Default,,0000,0000,0000,,♬～(ысқырық)
Dialogue: 0,1:12:32.05,1:12:33.98,Default,,0000,0000,0000,,⚟♬～(ысқырық)
Dialogue: 0,1:12:33.98,1:12:35.98,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,1:12:35.98,1:12:38.95,Default,,0000,0000,0000,,♬～(ысқырық)
Dialogue: 0,1:12:39.96,1:12:42.99,Default,,0000,0000,0000,,Цуку
Dialogue: 0,1:12:39.96,1:12:42.99,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Мен сенікін көшіріп алып жасадым.
Dialogue: 0,1:12:42.99,1:12:45.96,Default,,0000,0000,0000,,Аздап
Dialogue: 0,1:12:42.99,1:12:45.96,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,1:12:42.99,1:12:45.96,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,1:12:42.99,1:12:45.96,Default,,0000,0000,0000,,Менің ойымша, бұл өте жақсы сызықта ...
Dialogue: 0,1:12:45.96,1:12:50.00,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,1:12:45.96,1:12:50.00,Default,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,1:12:45.96,1:12:50.00,Default,,0000,0000,0000,,(Екі адам күледі)
Dialogue: 0,1:12:50.00,1:12:54.97,Default,,0000,0000,0000,,Ән
Dialogue: 0,1:12:50.00,1:12:54.97,Default,,0000,0000,0000,,Энсу
Dialogue: 0,1:12:50.00,1:12:54.97,Default,,0000,0000,0000,,♬～ (ән айту және ойнау)
Dialogue: 0,1:12:54.97,1:13:24.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:13:24.97,1:13:35.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:13:37.01,1:13:39.08,Default,,0000,0000,0000,,Керемет...
Dialogue: 0,1:13:39.08,1:13:43.02,Default,,0000,0000,0000,,Кішкентай әпке мен әжімдер
Dialogue: 0,1:13:39.08,1:13:43.02,Default,,0000,0000,0000,,Микканың әпкесі Сен бақытты көріндің.
Dialogue: 0,1:13:39.08,1:13:43.02,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:13:43.02,1:13:47.99,Default,,0000,0000,0000,,Чикюу
Dialogue: 0,1:13:43.02,1:13:47.99,Default,,0000,0000,0000,,Мушиканың жолақысы мен жердің әуені
Dialogue: 0,1:13:43.02,1:13:47.99,Default,,0000,0000,0000,,Мен олардың байланысқанына сене алмаймын...
Dialogue: 0,1:13:47.99,1:13:54.00,Default,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,1:13:47.99,1:13:54.00,Default,,0000,0000,0000,,Мен... Мен жалғыз емес едім!
Dialogue: 0,1:13:56.00,1:13:59.00,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,1:13:56.00,1:13:59.00,Default,,0000,0000,0000,,Хехехехе….
Dialogue: 0,1:13:59.00,1:14:02.97,Default,,0000,0000,0000,,Бірақ бұл флейта
Dialogue: 0,1:13:59.00,1:14:02.97,Default,,0000,0000,0000,,Бұл Мушиканыкі емес еді.
Dialogue: 0,1:14:02.97,1:14:05.97,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,1:14:02.97,1:14:05.97,Default,,0000,0000,0000,,Микканың әпкесі ойнайтын.
Dialogue: 0,1:14:02.97,1:14:05.97,Default,,0000,0000,0000,,Нақты нәрсе
Dialogue: 0,1:14:02.97,1:14:05.97,Default,,0000,0000,0000,,Бұл оның шынайы екенін білдіре ме...
Dialogue: 0,1:14:05.97,1:14:09.01,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,1:14:05.97,1:14:09.01,Default,,0000,0000,0000,,Мен мұндай нәрсені қалай іздеймін?
Dialogue: 0,1:14:09.01,1:14:11.98,Default,,0000,0000,0000,,♬~ «Ғұн хұн хун хун хун»
Dialogue: 0,1:14:11.98,1:14:17.05,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,1:14:11.98,1:14:17.05,Default,,0000,0000,0000,,Бала айтып тұрған ән
Dialogue: 0,1:14:11.98,1:14:17.05,Default,,0000,0000,0000,,Басымдық
Dialogue: 0,1:14:11.98,1:14:17.05,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:14:11.98,1:14:17.05,Default,,0000,0000,0000,,Мен мұны жақында бір жерден естігендей болдым...
Dialogue: 0,1:14:17.05,1:14:20.02,Default,,0000,0000,0000,,Ютахима
Dialogue: 0,1:14:17.05,1:14:20.02,Default,,0000,0000,0000,,Иә! ? Дива Мина!
Dialogue: 0,1:14:21.99,1:14:23.96,Default,,0000,0000,0000,,Тосын
Dialogue: 0,1:14:21.99,1:14:23.96,Default,,0000,0000,0000,,Сейюу
Dialogue: 0,1:14:21.99,1:14:23.96,Default,,0000,0000,0000,,<Таң қалдырған қонақ дауыс актері! 〉
Dialogue: 0,1:14:24.96,1:14:29.00,Default,,0000,0000,0000,,Хахаха...! Сондықтан асығыңыз
Dialogue: 0,1:14:24.96,1:14:29.00,Default,,0000,0000,0000,,Жартас
Dialogue: 0,1:14:24.96,1:14:29.00,Default,,0000,0000,0000,,сенімді жігіт болып көрінуге тырысып жүрсің…
Dialogue: 0,1:14:24.96,1:14:29.00,Default,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,1:14:24.96,1:14:29.00,Default,,0000,0000,0000,,Біз мерекелік іс-шараны өткіземіз делік.
Dialogue: 0,1:14:29.00,1:14:31.97,Default,,0000,0000,0000,,Сейкигоро
Dialogue: 0,1:14:29.00,1:14:31.97,Default,,0000,0000,0000,,Сакухин
Dialogue: 0,1:14:29.00,1:14:31.97,Default,,0000,0000,0000,,Бұл шамамен 13 ғасырдағы шығарма деп есептеледі.→
Dialogue: 0,1:14:31.97,1:14:33.97,Default,,0000,0000,0000,,Хиджо
Dialogue: 0,1:14:31.97,1:14:33.97,Default,,0000,0000,0000,,Мезура
Dialogue: 0,1:14:31.97,1:14:33.97,Default,,0000,0000,0000,,Түс
Dialogue: 0,1:14:31.97,1:14:33.97,Default,,0000,0000,0000,,Бұл өте сирек кездесетін түс...
Dialogue: 0,1:14:34.97,1:14:37.97,Default,,0000,0000,0000,,Олай болса, Мило.
Dialogue: 0,1:14:34.97,1:14:37.97,Default,,0000,0000,0000,,Шинсаку
Dialogue: 0,1:14:34.97,1:14:37.97,Default,,0000,0000,0000,,Маған жаңа жұмысыңызды қайта көрсетіңізші.
Dialogue: 0,1:14:37.97,1:14:39.94,Default,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,1:14:37.97,1:14:39.94,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,1:14:37.97,1:14:39.94,Default,,0000,0000,0000,,<Мен кинотеатрда күтемін! 〉
Dialogue: 0,1:14:42.01,1:14:45.01,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,1:14:42.01,1:14:45.01,Default,,0000,0000,0000,,Какунин
Dialogue: 0,1:14:42.01,1:14:45.01,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,1:14:42.01,1:14:45.01,Default,,0000,0000,0000,,Билетіңізді тексеріңіз
Dialogue: 0,1:14:42.01,1:14:45.01,Default,,0000,0000,0000,,Егер
Dialogue: 0,1:14:42.01,1:14:45.01,Default,,0000,0000,0000,,Сапқа тұрыңыз.
Dialogue: 0,1:14:45.01,1:14:49.99,Default,,0000,0000,0000,,Кайен
Dialogue: 0,1:14:45.01,1:14:49.99,Default,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,1:14:45.01,1:14:49.99,Default,,0000,0000,0000,,Мина Шоудың басталуына әлі уақыт бар.
Dialogue: 0,1:14:45.01,1:14:49.99,Default,,0000,0000,0000,,Босаңсып отырыңыз.
Dialogue: 0,1:14:49.99,1:14:51.99,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:14:54.02,1:14:58.06,Default,,0000,0000,0000,,Хира
Dialogue: 0,1:14:54.02,1:14:58.06,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,1:14:54.02,1:14:58.06,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,1:14:54.02,1:14:58.06,Default,,0000,0000,0000,,Шинпай
Dialogue: 0,1:14:54.02,1:14:58.06,Default,,0000,0000,0000,,Енді уайымдаудың қажеті жоқ...
Dialogue: 0,1:14:58.06,1:15:00.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:15:01.00,1:15:03.00,Default,,0000,0000,0000,,Қазір
Dialogue: 0,1:15:01.00,1:15:03.00,Default,,0000,0000,0000,,Да... кім?
Dialogue: 0,1:15:09.00,1:15:11.01,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,1:15:09.00,1:15:11.01,Default,,0000,0000,0000,,Түс
Dialogue: 0,1:15:09.00,1:15:11.01,Default,,0000,0000,0000,,Бұл шаштың түсі….
Dialogue: 0,1:15:11.01,1:15:15.01,Default,,0000,0000,0000,,Мен Миккамын.
Dialogue: 0,1:15:11.01,1:15:15.01,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:15:11.01,1:15:15.01,Default,,0000,0000,0000,,Мен сыбызғы іздеу үшін осында келдім.
Dialogue: 0,1:15:15.01,1:15:17.01,Default,,0000,0000,0000,,Ысқырық?
Dialogue: 0,1:15:17.01,1:15:18.98,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,1:15:23.02,1:15:26.02,Default,,0000,0000,0000,,Мүмкін сіз бұл туралы айтып отырған шығарсыз?
Dialogue: 0,1:15:26.02,1:15:30.03,Default,,0000,0000,0000,,Немесе
Dialogue: 0,1:15:26.02,1:15:30.03,Default,,0000,0000,0000,,Ах...! Маған осы флейтаны қарызға беруіңізді қалаймын!
Dialogue: 0,1:15:30.03,1:15:35.00,Default,,0000,0000,0000,,Юдзу
Dialogue: 0,1:15:30.03,1:15:35.00,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,1:15:30.03,1:15:35.00,Default,,0000,0000,0000,,Мұны маған Германиядағы әжем берген.
Dialogue: 0,1:15:30.03,1:15:35.00,Default,,0000,0000,0000,,Оқиға
Dialogue: 0,1:15:30.03,1:15:35.00,Default,,0000,0000,0000,,Бұл бойтұмар.
Dialogue: 0,1:15:40.00,1:15:43.01,Default,,0000,0000,0000,,Не? Жарайды ма?
Dialogue: 0,1:15:44.01,1:15:46.98,Default,,0000,0000,0000,,Теріс
Dialogue: 0,1:15:44.01,1:15:46.98,Default,,0000,0000,0000,,Сүйкімді жанкүйердің өтініші.
Dialogue: 0,1:15:48.01,1:15:51.01,Default,,0000,0000,0000,,Қанара
Dialogue: 0,1:15:48.01,1:15:51.01,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,1:15:48.01,1:15:51.01,Default,,0000,0000,0000,,Рахмет! Мен оны міндетті түрде қайтарамын!
Dialogue: 0,1:15:51.01,1:15:52.98,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:15:51.01,1:15:52.98,Default,,0000,0000,0000,,Иә! Тағы кездесейік!
Dialogue: 0,1:15:56.02,1:15:58.99,Default,,0000,0000,0000,,Дегенмен—
Dialogue: 0,1:15:56.02,1:15:58.99,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,1:15:58.99,1:16:02.99,Default,,0000,0000,0000,,Дұрыс айтпадым ба, Крюгер мырза?
Dialogue: 0,1:15:58.99,1:16:02.99,Default,,0000,0000,0000,,Эй
Dialogue: 0,1:15:58.99,1:16:02.99,Default,,0000,0000,0000,,Иә! Ол сондай керемет әпке болды!
Dialogue: 0,1:16:04.03,1:16:08.00,Default,,0000,0000,0000,,Дүние
Dialogue: 0,1:16:04.03,1:16:08.00,Default,,0000,0000,0000,,Әлемге әйгілі дива Мина
Dialogue: 0,1:16:04.03,1:16:08.00,Default,,0000,0000,0000,,Чи
Dialogue: 0,1:16:04.03,1:16:08.00,Default,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,1:16:04.03,1:16:08.00,Default,,0000,0000,0000,,Мен Мушиканың қанын алғаныма сене алар емеспін!
Dialogue: 0,1:16:08.00,1:16:11.00,Default,,0000,0000,0000,,Сізге жақсылық, Дораемон!
Dialogue: 0,1:16:11.00,1:16:12.97,Default,,0000,0000,0000,,Дораемон?
Dialogue: 0,1:16:12.97,1:16:16.00,Default,,0000,0000,0000,,Гагагагагага... Пусун!
Dialogue: 0,1:16:16.00,1:16:19.01,Default,,0000,0000,0000,,Дораемон! Дораемон!
Dialogue: 0,1:16:16.00,1:16:19.01,Default,,0000,0000,0000,,Жыныстық қатынас!
Dialogue: 0,1:16:19.01,1:16:20.98,Default,,0000,0000,0000,,Iso
Dialogue: 0,1:16:19.01,1:16:20.98,Default,,0000,0000,0000,,Тезірек осы ысқырықты пайдаланыңыз!
Dialogue: 0,1:16:20.98,1:16:25.98,Default,,0000,0000,0000,,♬～(ысқырық)
Dialogue: 0,1:16:25.98,1:16:28.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:16:28.98,1:16:30.99,Default,,0000,0000,0000,,
Dialogue: 0,1:16:30.99,1:16:35.99,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,1:16:30.99,1:16:35.99,Default,,0000,0000,0000,,Ескертпе
Dialogue: 0,1:16:30.99,1:16:35.99,Default,,0000,0000,0000,,Неге! ? Тік сыбызғы болса, емделуге болады...
Dialogue: 0,1:16:35.99,1:16:38.99,Default,,0000,0000,0000,,Немесе
Dialogue: 0,1:16:35.99,1:16:38.99,Default,,0000,0000,0000,,Бұл ысқырық жоқ...
Dialogue: 0,1:16:38.99,1:16:42.13,Default,,0000,0000,0000,,Мүмкін сондықтан.
Dialogue: 0,1:16:38.99,1:16:42.13,Default,,0000,0000,0000,,Міне!
Dialogue: 0,1:16:42.13,1:16:46.00,Default,,0000,0000,0000,,Сәлем Джан. Сегізаяқ тәрізді нәрсе
Dialogue: 0,1:16:42.13,1:16:46.00,Default,,0000,0000,0000,,Хоуши
Dialogue: 0,1:16:42.13,1:16:46.00,Default,,0000,0000,0000,,Олар шу споралары емес пе?
Dialogue: 0,1:16:46.00,1:16:50.01,Default,,0000,0000,0000,,Ылғау
Dialogue: 0,1:16:46.00,1:16:50.01,Default,,0000,0000,0000,,Сіз оны музыкамен оңай жеңе аласыз, солай ма?
Dialogue: 0,1:16:46.00,1:16:50.01,Default,,0000,0000,0000,,О!
Dialogue: 0,1:16:50.01,1:16:55.01,Default,,0000,0000,0000,,Егер бәріміз музыка ойнасақ
Dialogue: 0,1:16:50.01,1:16:55.01,Default,,0000,0000,0000,,Түпнұсқа
Dialogue: 0,1:16:50.01,1:16:55.01,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,1:16:50.01,1:16:55.01,Default,,0000,0000,0000,,Дора-чан да қалыпты жағдайға орала ма деп ойлаймын!
Dialogue: 0,1:16:55.01,1:16:56.98,Default,,0000,0000,0000,,Міне, солай!
Dialogue: 0,1:16:58.01,1:17:02.99,Default,,0000,0000,0000,,♬～(көрсетілім)
Dialogue: 0,1:17:02.99,1:17:13.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:17:13.00,1:17:16.00,Default,,0000,0000,0000,,Қазірдің өзінде Джан!
Dialogue: 0,1:17:13.00,1:17:16.00,Default,,0000,0000,0000,,Теион
Dialogue: 0,1:17:13.00,1:17:16.00,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:17:13.00,1:17:16.00,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,1:17:13.00,1:17:16.00,Default,,0000,0000,0000,,Басс тым алға!
Dialogue: 0,1:17:16.00,1:17:19.00,Default,,0000,0000,0000,,Сен өзіңсің, салқын қимыл жасама.
Dialogue: 0,1:17:16.00,1:17:19.00,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:17:16.00,1:17:19.00,Default,,0000,0000,0000,,Дұрыс сәйкестендіріңіз!
Dialogue: 0,1:17:19.00,1:17:21.00,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:17:21.00,1:17:23.01,Default,,0000,0000,0000,,Гета
Dialogue: 0,1:17:21.00,1:17:23.01,Default,,0000,0000,0000,,Мен бұрынғыдан да жаман сияқтымын...
Dialogue: 0,1:17:23.01,1:17:26.98,Default,,0000,0000,0000,,♬～(Өнімділік)
Dialogue: 0,1:17:26.98,1:17:29.01,Default,,0000,0000,0000,,Фарре ұрысып жатыр...
Dialogue: 0,1:17:29.01,1:17:32.98,Default,,0000,0000,0000,,Она
Dialogue: 0,1:17:29.01,1:17:32.98,Default,,0000,0000,0000,,Сенрицу
Dialogue: 0,1:17:29.01,1:17:32.98,Default,,0000,0000,0000,,Кана
Dialogue: 0,1:17:29.01,1:17:32.98,Default,,0000,0000,0000,,Егер бәрі бірдей әуенді ойнап бітсе...
Dialogue: 0,1:17:29.01,1:17:32.98,Default,,0000,0000,0000,,(«жоқ» дыбысы)
Dialogue: 0,1:17:32.98,1:17:35.98,Default,,0000,0000,0000,,Сәлем Нобита! О, адам, енді үрлеме!
Dialogue: 0,1:17:35.98,1:17:39.99,Default,,0000,0000,0000,,Нобита осында болса, емделетін нәрселер жазылмайды!
Dialogue: 0,1:17:35.98,1:17:39.99,Default,,0000,0000,0000,,Міне!
Dialogue: 0,1:17:39.99,1:17:42.99,Default,,0000,0000,0000,,(Туба)
Dialogue: 0,1:17:39.99,1:17:42.99,Default,,0000,0000,0000,,Шу!
Dialogue: 0,1:17:42.99,1:17:44.99,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,1:17:44.99,1:17:47.00,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,1:17:44.99,1:17:47.00,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,1:17:44.99,1:17:47.00,Default,,0000,0000,0000,,Мен оны жек көремін!
Dialogue: 0,1:17:47.00,1:17:50.00,Default,,0000,0000,0000,,♬ Star Platinum
Dialogue: 0,1:17:47.00,1:17:50.00,Default,,0000,0000,0000,,Мен де жаттықтым!
Dialogue: 0,1:17:50.00,1:17:55.00,Default,,0000,0000,0000,,Мен де...
Dialogue: 0,1:17:50.00,1:17:55.00,Default,,0000,0000,0000,,Кенже
Dialogue: 0,1:17:50.00,1:17:55.00,Default,,0000,0000,0000,,Мен барлығымен ойнағым келеді!
Dialogue: 0,1:17:55.00,1:17:57.97,Default,,0000,0000,0000,,Мен Дорэмонды емдегім келеді!
Dialogue: 0,1:17:59.01,1:18:04.01,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,1:18:04.01,1:18:05.98,Default,,0000,0000,0000,,(«жоқ» дыбысы)
Dialogue: 0,1:18:06.98,1:18:08.98,Default,,0000,0000,0000,,
Dialogue: 0,1:18:08.98,1:18:10.99,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:18:11.99,1:18:14.99,Default,,0000,0000,0000,,Мина
Dialogue: 0,1:18:11.99,1:18:14.99,Default,,0000,0000,0000,,Міне! Мұнда барлығы...
Dialogue: 0,1:18:14.99,1:18:20.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:18:20.00,1:18:24.97,Default,,0000,0000,0000,,♬～(скрипка)
Dialogue: 0,1:18:24.97,1:18:28.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:18:28.00,1:18:33.01,Default,,0000,0000,0000,,♬～(Туба)
Dialogue: 0,1:18:33.01,1:18:38.01,Default,,0000,0000,0000,,♬～(көрсетілім)
Dialogue: 0,1:18:38.01,1:18:44.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:18:44.99,1:18:49.99,Default,,0000,0000,0000,,♬～ (ән айту және ойнау)
Dialogue: 0,1:18:49.99,1:18:59.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:18:59.00,1:19:03.00,Default,,0000,0000,0000,,Ха... ха... Хекшун!
Dialogue: 0,1:19:03.00,1:19:16.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:19:16.99,1:19:20.02,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,1:19:16.99,1:19:20.02,Default,,0000,0000,0000,,Барлығы керемет!
Dialogue: 0,1:19:20.02,1:19:23.99,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,1:19:20.02,1:19:23.99,Default,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,1:19:20.02,1:19:23.99,Default,,0000,0000,0000,,Бұл бірінші рет!
Dialogue: 0,1:19:20.02,1:19:23.99,Default,,0000,0000,0000,,Мен шошып кеттім!
Dialogue: 0,1:19:23.99,1:19:25.99,Default,,0000,0000,0000,,Суба
Dialogue: 0,1:19:23.99,1:19:25.99,Default,,0000,0000,0000,,Барлығы керемет болды!
Dialogue: 0,1:19:25.99,1:19:29.00,Default,,0000,0000,0000,,Хакушю
Dialogue: 0,1:19:25.99,1:19:29.00,Default,,0000,0000,0000,,(Шапалақтау)
Dialogue: 0,1:19:25.99,1:19:29.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:19:29.00,1:19:31.00,Default,,0000,0000,0000,,Нобита-кун.
Dialogue: 0,1:19:31.00,1:19:36.00,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:19:31.00,1:19:36.00,Default,,0000,0000,0000,,Мен сіздің магнитофоныңызды естідім.
Dialogue: 0,1:19:36.00,1:19:40.01,Default,,0000,0000,0000,,Дораемон... Дораемон!
Dialogue: 0,1:19:40.01,1:19:43.01,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,1:19:40.01,1:19:43.01,Default,,0000,0000,0000,,Дора-чан….
Dialogue: 0,1:19:43.01,1:19:45.01,Default,,0000,0000,0000,,Сіз жазылып кеткен сияқтысыз!
Dialogue: 0,1:19:45.01,1:19:46.98,Default,,0000,0000,0000,,(Дыбыс деңгейін көтеру)
Dialogue: 0,1:19:45.01,1:19:46.98,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,1:19:50.99,1:19:54.99,Default,,0000,0000,0000,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:19:50.99,1:19:54.99,Default,,0000,0000,0000,,Мен виртуоз болдым!
Dialogue: 0,1:19:54.99,1:19:57.03,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,1:19:54.99,1:19:57.03,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,1:19:57.03,1:20:01.00,Default,,0000,0000,0000,,(Туба)
Dialogue: 0,1:19:57.03,1:20:01.00,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,1:19:57.03,1:20:01.00,Default,,0000,0000,0000,,Қалай болғанда да, біз тез арада ауруханаға жетуіміз керек…
Dialogue: 0,1:19:57.03,1:20:01.00,Default,,0000,0000,0000,,Білемін, жаным!
Dialogue: 0,1:20:03.97,1:20:06.00,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:20:03.97,1:20:06.00,Default,,0000,0000,0000,,Менің де деңгейім көтерілді!
Dialogue: 0,1:20:06.00,1:20:09.00,Default,,0000,0000,0000,,Саған жақсы, Нобита-кун.
Dialogue: 0,1:20:06.00,1:20:09.00,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:20:09.00,1:20:14.98,Default,,0000,0000,0000,,(Диктофон)
Dialogue: 0,1:20:15.98,1:20:18.98,Default,,0000,0000,0000,,Сіз не айтып тұрсыз?
Dialogue: 0,1:20:15.98,1:20:18.98,Default,,0000,0000,0000,,Дәл қазір қойылым өте жақсы болды.
Dialogue: 0,1:20:18.98,1:20:20.98,Default,,0000,0000,0000,,Хахахаха!
Dialogue: 0,1:20:20.98,1:20:23.99,Default,,0000,0000,0000,,Бұл өте керемет қойылым болды...
Dialogue: 0,1:20:23.99,1:20:26.99,Default,,0000,0000,0000,,Сәлем Капек.
Dialogue: 0,1:20:23.99,1:20:26.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:20:26.99,1:20:31.99,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,1:20:26.99,1:20:31.99,Default,,0000,0000,0000,,Бірге музыка ойнау қызық!
Dialogue: 0,1:20:31.99,1:20:34.00,Default,,0000,0000,0000,,Хаа!
Dialogue: 0,1:20:35.96,1:20:40.97,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:20:35.96,1:20:40.97,Default,,0000,0000,0000,,Дендо
Dialogue: 0,1:20:35.96,1:20:40.97,Default,,0000,0000,0000,,Даңқ залына барайық!
Dialogue: 0,1:20:35.96,1:20:40.97,Default,,0000,0000,0000,,Жерді шудан қорғаңыз!
Dialogue: 0,1:20:40.97,1:20:42.97,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:20:40.97,1:20:42.97,Default,,0000,0000,0000,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,1:20:49.01,1:20:51.98,Default,,0000,0000,0000,,Маэстро….
Dialogue: 0,1:20:49.01,1:20:51.98,Default,,0000,0000,0000,,
Dialogue: 0,1:20:51.98,1:20:54.98,Default,,0000,0000,0000,,Қарғыс атсын... Мен бұл жерді не болса да қорғауым керек.
Dialogue: 0,1:20:54.98,1:20:56.99,Default,,0000,0000,0000,,...
Dialogue: 0,1:20:58.99,1:21:05.99,Default,,0000,0000,0000,,♬～(Туба)
Dialogue: 0,1:21:05.99,1:21:11.97,Default,,0000,0000,0000,,♬～(көрсетілім)
Dialogue: 0,1:21:11.97,1:21:15.00,Default,,0000,0000,0000,,О...
Dialogue: 0,1:21:11.97,1:21:15.00,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:21:15.00,1:21:19.01,Default,,0000,0000,0000,,♬~ «Аша ауырған сошир»
Dialogue: 0,1:21:19.01,1:21:21.98,Default,,0000,0000,0000,,Чика
Dialogue: 0,1:21:19.01,1:21:21.98,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,1:21:19.01,1:21:21.98,Default,,0000,0000,0000,,Асығыңыз! Қазір!
Dialogue: 0,1:21:19.01,1:21:21.98,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:21:21.98,1:21:25.98,Default,,0000,0000,0000,,Мұғалім
Dialogue: 0,1:21:21.98,1:21:25.98,Default,,0000,0000,0000,,Мұғалім мен ысқырық әкелдім!
Dialogue: 0,1:21:21.98,1:21:25.98,Default,,0000,0000,0000,,Жарайсың!
Dialogue: 0,1:21:25.98,1:21:28.98,Default,,0000,0000,0000,,Орын
Dialogue: 0,1:21:25.98,1:21:28.98,Default,,0000,0000,0000,,Біз бұл жерді қорғаймыз.
Dialogue: 0,1:21:25.98,1:21:28.98,Default,,0000,0000,0000,,Негізгі қосқышты жылдам қосыңыз!
Dialogue: 0,1:21:28.98,1:21:30.99,Default,,0000,0000,0000,,Ұрыс
Dialogue: 0,1:21:28.98,1:21:30.99,Default,,0000,0000,0000,,Мен де осында ұрысамын.
Dialogue: 0,1:21:30.99,1:21:32.99,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,1:21:30.99,1:21:32.99,Default,,0000,0000,0000,,Құрметті Мика!
Dialogue: 0,1:21:30.99,1:21:32.99,Default,,0000,0000,0000,,Мака
Dialogue: 0,1:21:30.99,1:21:32.99,Default,,0000,0000,0000,,Иә, маған қалдырыңыз!
Dialogue: 0,1:21:32.99,1:21:35.99,Default,,0000,0000,0000,,Нобита-кун, Мика-чан!
Dialogue: 0,1:21:32.99,1:21:35.99,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:21:35.99,1:21:37.99,Default,,0000,0000,0000,,Дора-чан!
Dialogue: 0,1:21:37.99,1:21:42.96,Default,,0000,0000,0000,,♬ ~ «Жалғыз Шейла Социласофалале»
Dialogue: 0,1:21:49.00,1:21:52.01,Default,,0000,0000,0000,,Бес….
Dialogue: 0,1:21:49.00,1:21:52.01,Default,,0000,0000,0000,,Микка-чан!
Dialogue: 0,1:21:52.01,1:21:54.01,Default,,0000,0000,0000,,Нобита!
Dialogue: 0,1:21:56.01,1:21:58.01,Default,,0000,0000,0000,,(ысқырық)
Dialogue: 0,1:22:01.02,1:22:03.02,Default,,0000,0000,0000,,(ысқырық)
Dialogue: 0,1:22:06.02,1:22:08.99,Default,,0000,0000,0000,,(ысқырық)
Dialogue: 0,1:22:10.03,1:22:11.99,Default,,0000,0000,0000,,(ысқырық)
Dialogue: 0,1:22:15.03,1:22:17.00,Default,,0000,0000,0000,,Босдық
Dialogue: 0,1:22:15.03,1:22:17.00,Default,,0000,0000,0000,,(тыныс алу дыбысы)
Dialogue: 0,1:22:18.00,1:22:22.00,Default,,0000,0000,0000,,Тыныштық
Dialogue: 0,1:22:18.00,1:22:22.00,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,1:22:18.00,1:22:22.00,Default,,0000,0000,0000,,Жоқ... Бір жазба әлі жоқ!
Dialogue: 0,1:22:18.00,1:22:22.00,Default,,0000,0000,0000,,Міне...
Dialogue: 0,1:22:22.00,1:22:26.01,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:22:26.01,1:22:29.01,Default,,0000,0000,0000,,《Әлі емес, Микка...! 》
Dialogue: 0,1:22:29.01,1:22:31.98,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:22:29.01,1:22:31.98,Default,,0000,0000,0000,,Ұстаз!
Dialogue: 0,1:22:37.02,1:22:40.02,Default,,0000,0000,0000,,Дора-чан!
Dialogue: 0,1:22:37.02,1:22:40.02,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,1:22:40.02,1:22:41.99,Default,,0000,0000,0000,,Міне...!
Dialogue: 0,1:22:41.99,1:22:48.00,Default,,0000,0000,0000,,(ысқырық)
Dialogue: 0,1:22:48.00,1:22:50.00,Default,,0000,0000,0000,,Күтілгендей, жоқ...
Dialogue: 0,1:22:50.00,1:22:51.97,Default,,0000,0000,0000,,Иә? Микка-чан!
Dialogue: 0,1:22:51.97,1:22:53.97,Default,,0000,0000,0000,,Кя!
Dialogue: 0,1:22:55.97,1:23:01.01,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,1:23:01.01,1:23:04.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:23:04.98,1:23:06.98,Default,,0000,0000,0000,,(«жоқ» дыбысы)
Dialogue: 0,1:23:06.98,1:23:09.98,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:23:06.98,1:23:09.98,Default,,0000,0000,0000,,Нобита-кунның...
Dialogue: 0,1:23:09.98,1:23:11.99,Default,,0000,0000,0000,,«Жоқ» дыбысы! ?
Dialogue: 0,1:23:11.99,1:23:13.99,Default,,0000,0000,0000,,Жаз
Dialogue: 0,1:23:11.99,1:23:13.99,Default,,0000,0000,0000,,Бұл ностальгиялық естіледі.
Dialogue: 0,1:23:13.99,1:23:16.99,Default,,0000,0000,0000,,Мен кіммін?
Dialogue: 0,1:23:13.99,1:23:16.99,Default,,0000,0000,0000,,Канжин
Dialogue: 0,1:23:13.99,1:23:16.99,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,1:23:13.99,1:23:16.99,Default,,0000,0000,0000,,Неге осындай қиын кезеңде...
Dialogue: 0,1:23:16.99,1:23:18.99,Default,,0000,0000,0000,,Нобита! Қараңдар!
Dialogue: 0,1:23:27.97,1:23:29.97,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,1:23:29.97,1:23:34.08,Default,,0000,0000,0000,,Жоқ дыбыс
Dialogue: 0,1:23:29.97,1:23:34.08,Default,,0000,0000,0000,,Бұл Нобитаның "жоқ" деген дыбысы еді!
Dialogue: 0,1:23:34.08,1:23:59.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:23:59.00,1:24:02.00,Default,,0000,0000,0000,,Матсуда мырза өледі.
Dialogue: 0,1:23:59.00,1:24:02.00,Default,,0000,0000,0000,,Хмм... не деген...
Dialogue: 0,1:24:02.00,1:24:05.01,Default,,0000,0000,0000,,Ой...!
Dialogue: 0,1:24:02.00,1:24:05.01,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:24:05.01,1:24:07.01,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:24:07.01,1:24:10.98,Default,,0000,0000,0000,,Каниппацу
Dialogue: 0,1:24:07.01,1:24:10.98,Default,,0000,0000,0000,,Аа... Бұл жақын қоңырау болды.
Dialogue: 0,1:24:07.01,1:24:10.98,Default,,0000,0000,0000,,
Dialogue: 0,1:24:10.98,1:24:13.98,Default,,0000,0000,0000,,Күрсін! мұғалім!
Dialogue: 0,1:24:13.98,1:24:15.98,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,1:24:13.98,1:24:15.98,Default,,0000,0000,0000,,Сіз оны уақытында орындадыңыз ба?
Dialogue: 0,1:24:15.98,1:24:18.99,Default,,0000,0000,0000,,Жарық
Dialogue: 0,1:24:15.98,1:24:18.99,Default,,0000,0000,0000,,Учуу
Dialogue: 0,1:24:15.98,1:24:18.99,Default,,0000,0000,0000,,Зал дыбыс жаңғырығы жоқ ғаламда→
Dialogue: 0,1:24:18.99,1:24:23.96,Default,,0000,0000,0000,,Біз фарр дыбысын жасай аламыз
Dialogue: 0,1:24:18.99,1:24:23.96,Default,,0000,0000,0000,,Гакки
Dialogue: 0,1:24:18.99,1:24:23.96,Default,,0000,0000,0000,,Бұл музыкалық аспап!
Dialogue: 0,1:24:25.99,1:24:29.96,Default,,0000,0000,0000,,(Ventau)
Dialogue: 0,1:24:25.99,1:24:29.96,Default,,0000,0000,0000,,Шокун
Dialogue: 0,1:24:25.99,1:24:29.96,Default,,0000,0000,0000,,Қақпақ
Dialogue: 0,1:24:25.99,1:24:29.96,Default,,0000,0000,0000,,Мырзалар. Сізді қайта көруге қуаныштымын.
Dialogue: 0,1:24:29.96,1:24:31.97,Default,,0000,0000,0000,,Бірақ дәл қазір уақытым жоқ.
Dialogue: 0,1:24:31.97,1:24:34.97,Default,,0000,0000,0000,,Құдайлар
Dialogue: 0,1:24:31.97,1:24:34.97,Default,,0000,0000,0000,,Шу жерге жақындап келеді.
Dialogue: 0,1:24:34.97,1:24:37.97,Default,,0000,0000,0000,,Оқиға
Dialogue: 0,1:24:34.97,1:24:37.97,Default,,0000,0000,0000,,Како
Dialogue: 0,1:24:34.97,1:24:37.97,Default,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,1:24:34.97,1:24:37.97,Default,,0000,0000,0000,,Біз ешқашан өткенді қайталамауымыз керек.
Dialogue: 0,1:24:37.97,1:24:42.98,Default,,0000,0000,0000,,Енді біз үшін фарре ойнайтын кез келді
Dialogue: 0,1:24:37.97,1:24:42.98,Default,,0000,0000,0000,,Ширизо
Dialogue: 0,1:24:37.97,1:24:42.98,Default,,0000,0000,0000,,Шуды жойыңыз!
Dialogue: 0,1:24:42.98,1:24:45.01,Default,,0000,0000,0000,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,1:24:45.01,1:24:48.98,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,1:24:45.01,1:24:48.98,Default,,0000,0000,0000,,Түсіндіру
Dialogue: 0,1:24:45.01,1:24:48.98,Default,,0000,0000,0000,,Мен осы спектакльдің негізгі ойыншысын таныстырғым келеді.
Dialogue: 0,1:24:48.98,1:24:53.99,Default,,0000,0000,0000,,Жерден келген
Dialogue: 0,1:24:48.98,1:24:53.99,Default,,0000,0000,0000,,Суку
Dialogue: 0,1:24:48.98,1:24:53.99,Default,,0000,0000,0000,,Кенже
Dialogue: 0,1:24:48.98,1:24:53.99,Default,,0000,0000,0000,,Даңқ залын құтқарған бес виртуоз!
Dialogue: 0,1:24:53.99,1:24:58.99,Default,,0000,0000,0000,,Кансей
Dialogue: 0,1:24:53.99,1:24:58.99,Default,,0000,0000,0000,,Профессор Такаянаги
Dialogue: 0,1:24:58.99,1:25:02.00,Default,,0000,0000,0000,,Көптеген
Dialogue: 0,1:24:58.99,1:25:02.00,Default,,0000,0000,0000,,Осыншама көп адаммен ойнайсың ба?
Dialogue: 0,1:25:02.00,1:25:03.97,Default,,0000,0000,0000,,Kincho
Dialogue: 0,1:25:02.00,1:25:03.97,Default,,0000,0000,0000,,Мен... Мен қобалжыдым...
Dialogue: 0,1:25:03.97,1:25:07.00,Default,,0000,0000,0000,,Гата
Dialogue: 0,1:25:03.97,1:25:07.00,Default,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,1:25:03.97,1:25:07.00,Default,,0000,0000,0000,,Олай болса жақсы.
Dialogue: 0,1:25:07.00,1:25:09.00,Default,,0000,0000,0000,,Осы уақытқа дейін не істедік
Dialogue: 0,1:25:07.00,1:25:09.00,Default,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,1:25:07.00,1:25:09.00,Default,,0000,0000,0000,,Есте сақта!
Dialogue: 0,1:25:09.00,1:25:12.01,Default,,0000,0000,0000,,Ганба
Dialogue: 0,1:25:09.00,1:25:12.01,Default,,0000,0000,0000,,Бірақ... қолдан келгеннің бәрін жасайық!
Dialogue: 0,1:25:12.01,1:25:14.01,Default,,0000,0000,0000,,
Dialogue: 0,1:25:14.01,1:25:17.01,Default,,0000,0000,0000,,...
Dialogue: 0,1:25:14.01,1:25:17.01,Default,,0000,0000,0000,,Тоу
Dialogue: 0,1:25:14.01,1:25:17.01,Default,,0000,0000,0000,,Кез келген жағдайда Tekio шамын пайдаланыңыз.
Dialogue: 0,1:25:17.01,1:25:19.98,Default,,0000,0000,0000,,Кокорозуйо
Dialogue: 0,1:25:17.01,1:25:19.98,Default,,0000,0000,0000,,Энгун
Dialogue: 0,1:25:17.01,1:25:19.98,Default,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,1:25:17.01,1:25:19.98,Default,,0000,0000,0000,,Сондай-ақ мен бірнеше күшті күшейтуді шақырдым!
Dialogue: 0,1:25:19.98,1:25:22.98,Default,,0000,0000,0000,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:25:19.98,1:25:22.98,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,1:25:22.98,1:25:24.99,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,1:25:22.98,1:25:24.99,Default,,0000,0000,0000,,Сол кезде!
Dialogue: 0,1:25:24.99,1:25:27.02,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,1:25:27.02,1:25:30.99,Default,,0000,0000,0000,,Мен үшін күткендей...
Dialogue: 0,1:25:27.02,1:25:30.99,Default,,0000,0000,0000,,(Диктофон)
Dialogue: 0,1:25:32.03,1:25:35.03,Default,,0000,0000,0000,,Хахаха...! Тоқта, қытық...
Dialogue: 0,1:25:35.03,1:25:37.10,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,1:25:37.10,1:25:40.00,Default,,0000,0000,0000,,Бұл менмін
Dialogue: 0,1:25:37.10,1:25:40.00,Default,,0000,0000,0000,,Екі адам
Dialogue: 0,1:25:37.10,1:25:40.00,Default,,0000,0000,0000,,Өйткені мен Капекпен жалғыз болдым→
Dialogue: 0,1:25:40.00,1:25:45.01,Default,,0000,0000,0000,,Ән
Dialogue: 0,1:25:40.00,1:25:45.01,Default,,0000,0000,0000,,Көрініс
Dialogue: 0,1:25:40.00,1:25:45.01,Default,,0000,0000,0000,,Барлығымен ән айту өте қызықты
Dialogue: 0,1:25:40.00,1:25:45.01,Default,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,1:25:40.00,1:25:45.01,Default,,0000,0000,0000,,Мен білмедім.
Dialogue: 0,1:25:45.01,1:25:48.01,Default,,0000,0000,0000,,...
Dialogue: 0,1:25:45.01,1:25:48.01,Default,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,1:25:45.01,1:25:48.01,Default,,0000,0000,0000,,Барлығымен танысқаныма өте қуаныштымын.
Dialogue: 0,1:25:48.01,1:25:50.01,Default,,0000,0000,0000,,Ән айтайық! Барлығы.
Dialogue: 0,1:25:50.01,1:25:52.01,Default,,0000,0000,0000,,Шудан арылайық!
Dialogue: 0,1:25:52.01,1:25:54.02,Default,,0000,0000,0000,,Кенже
Dialogue: 0,1:25:52.01,1:25:54.02,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:25:55.02,1:25:57.02,Default,,0000,0000,0000,,Энсу
Dialogue: 0,1:25:55.02,1:25:57.02,Default,,0000,0000,0000,,...
Dialogue: 0,1:25:55.02,1:25:57.02,Default,,0000,0000,0000,,Айтпақшы, сіз қандай әнді орындамақсыз?
Dialogue: 0,1:25:57.02,1:25:59.99,Default,,0000,0000,0000,,Бұрын
Dialogue: 0,1:25:57.02,1:25:59.99,Default,,0000,0000,0000,,Музыканы Капек жазған.
Dialogue: 0,1:25:59.99,1:26:02.99,Default,,0000,0000,0000,,Capek? таңқаларлық!
Dialogue: 0,1:26:02.99,1:26:07.00,Default,,0000,0000,0000,,Мен… Мен
Dialogue: 0,1:26:02.99,1:26:07.00,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:26:02.99,1:26:07.00,Default,,0000,0000,0000,,Маэстроның әні жақсы дедім→
Dialogue: 0,1:26:07.00,1:26:10.00,Default,,0000,0000,0000,,Чикюу
Dialogue: 0,1:26:07.00,1:26:10.00,Default,,0000,0000,0000,,Музыка
Dialogue: 0,1:26:07.00,1:26:10.00,Default,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,1:26:07.00,1:26:10.00,Default,,0000,0000,0000,,Өйткені мен жердің әуеніне ұшырадым→
Dialogue: 0,1:26:10.00,1:26:13.00,Default,,0000,0000,0000,,Орын
Dialogue: 0,1:26:10.00,1:26:13.00,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,1:26:10.00,1:26:13.00,Default,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,1:26:10.00,1:26:13.00,Default,,0000,0000,0000,,Жаңа тариф құру мүмкін болуы керек...
Dialogue: 0,1:26:13.00,1:26:15.97,Default,,0000,0000,0000,,Мен Нобита және оның достарымен танысқаныма қуаныштымын.
Dialogue: 0,1:26:15.97,1:26:19.01,Default,,0000,0000,0000,,Мен Жердің музыкасын тапқаныма қуаныштымын.
Dialogue: 0,1:26:19.01,1:26:22.01,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,1:26:19.01,1:26:22.01,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,1:26:19.01,1:26:22.01,Default,,0000,0000,0000,,Біз бұл ойды енгіздік.
Dialogue: 0,1:26:22.01,1:26:24.98,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,1:26:22.01,1:26:24.98,Default,,0000,0000,0000,,Әй, ол әннің аты қалай?
Dialogue: 0,1:26:25.98,1:26:27.98,Default,,0000,0000,0000,,Симфония
Dialogue: 0,1:26:25.98,1:26:27.98,Default,,0000,0000,0000,,«Жер симфониясы».
Dialogue: 0,1:26:29.98,1:26:44.97,Default,,0000,0000,0000,,Ескі күн
Dialogue: 0,1:26:29.98,1:26:44.97,Default,,0000,0000,0000,,(Оркестр дыбысының шығуы)
Dialogue: 0,1:26:49.97,1:26:55.01,Default,,0000,0000,0000,,♬ ~ «Жер симфониясы»
Dialogue: 0,1:26:55.01,1:27:00.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:27:00.98,1:27:02.98,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:27:02.98,1:27:19.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:27:19.97,1:27:21.97,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:27:19.97,1:27:21.97,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:27:19.97,1:27:21.97,Default,,0000,0000,0000,,Спорт күні керемет өтті, иә?
Dialogue: 0,1:27:21.97,1:27:42.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:27:42.96,1:28:02.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:28:02.98,1:28:06.95,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:28:02.98,1:28:06.95,Default,,0000,0000,0000,,Тариф жұмыс істейді!
Dialogue: 0,1:28:02.98,1:28:06.95,Default,,0000,0000,0000,,О.
Dialogue: 0,1:28:02.98,1:28:06.95,Default,,0000,0000,0000,,тармақ
Dialogue: 0,1:28:02.98,1:28:06.95,Default,,0000,0000,0000,,Тек айдап кет!
Dialogue: 0,1:28:06.95,1:28:15.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:28:15.96,1:28:18.06,Default,,0000,0000,0000,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,1:28:18.06,1:28:19.96,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,1:28:18.06,1:28:19.96,Default,,0000,0000,0000,,Ешқандай болмаңыз! Жалғастырайық!
Dialogue: 0,1:28:19.96,1:28:33.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:28:33.98,1:28:38.95,Default,,0000,0000,0000,,♬～ (ән айту және ойнау)
Dialogue: 0,1:28:38.95,1:28:59.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:28:59.97,1:29:20.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:29:20.99,1:29:22.99,Default,,0000,0000,0000,,О-
Dialogue: 0,1:29:20.99,1:29:22.99,Default,,0000,0000,0000,,Әй... шу азайып барады!
Dialogue: 0,1:29:22.99,1:29:27.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:29:40.98,1:29:42.98,Default,,0000,0000,0000,,Химей
Dialogue: 0,1:29:40.98,1:29:42.98,Default,,0000,0000,0000,,(Барлығы айқайлайды)
Dialogue: 0,1:29:42.98,1:29:44.98,Default,,0000,0000,0000,,Уақыт
Dialogue: 0,1:29:42.98,1:29:44.98,Default,,0000,0000,0000,,Құрметті Мика!
Dialogue: 0,1:29:44.98,1:29:46.98,Default,,0000,0000,0000,,Бұл жаман!
Dialogue: 0,1:29:44.98,1:29:46.98,Default,,0000,0000,0000,,Күресу…
Dialogue: 0,1:29:46.98,1:29:48.98,Default,,0000,0000,0000,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,1:29:46.98,1:29:48.98,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:29:48.98,1:29:50.99,Default,,0000,0000,0000,,Уф...!
Dialogue: 0,1:29:50.99,1:29:52.99,Default,,0000,0000,0000,,Куукихо
Dialogue: 0,1:29:50.99,1:29:52.99,Default,,0000,0000,0000,,Әуе зеңбірегі! Бум!
Dialogue: 0,1:29:52.99,1:29:56.99,Default,,0000,0000,0000,,Бум! Бум! Бум! Бум!
Dialogue: 0,1:29:56.99,1:29:59.96,Default,,0000,0000,0000,,Бұл жұмыс істемейді... Уау!
Dialogue: 0,1:29:59.96,1:30:01.96,Default,,0000,0000,0000,,Бұл музыка болуы керек. Жақсы….
Dialogue: 0,1:30:01.96,1:30:03.97,Default,,0000,0000,0000,,Гакки
Dialogue: 0,1:30:01.96,1:30:03.97,Default,,0000,0000,0000,,Аспап аспабы....
Dialogue: 0,1:30:03.97,1:30:06.00,Default,,0000,0000,0000,,Міне болды!
Dialogue: 0,1:30:06.00,1:30:12.01,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:30:12.01,1:30:15.98,Default,,0000,0000,0000,,...
Dialogue: 0,1:30:12.01,1:30:15.98,Default,,0000,0000,0000,,Жоқ! Бұл клиенттерді тарту үшін сүйкімді болды.
Dialogue: 0,1:30:12.01,1:30:15.98,Default,,0000,0000,0000,,Э? Тұр... не?
Dialogue: 0,1:30:15.98,1:30:20.98,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,1:30:20.98,1:30:22.98,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:30:22.98,1:30:25.95,Default,,0000,0000,0000,,Ай!
Dialogue: 0,1:30:22.98,1:30:25.95,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,1:30:28.99,1:30:31.99,Default,,0000,0000,0000,,(Барлығы айқайлайды)
Dialogue: 0,1:30:31.99,1:30:35.96,Default,,0000,0000,0000,,Вааах!
Dialogue: 0,1:30:36.96,1:30:41.94,Default,,0000,0000,0000,,Құрметті Мика! Нобита-сан!
Dialogue: 0,1:30:36.96,1:30:41.94,Default,,0000,0000,0000,,Дораемон-сан!
Dialogue: 0,1:30:42.97,1:30:45.94,Default,,0000,0000,0000,,Мен... Мұның бәрі бар ма...!
Dialogue: 0,1:30:56.95,1:30:59.95,Default,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,1:30:56.95,1:30:59.95,Default,,0000,0000,0000,,《Дыбыс жоқ...》
Dialogue: 0,1:31:18.97,1:31:21.94,Default,,0000,0000,0000,,Жел
Dialogue: 0,1:31:18.97,1:31:21.94,Default,,0000,0000,0000,,(Жел дыбысы)
Dialogue: 0,1:31:39.96,1:31:43.97,Default,,0000,0000,0000,,♬ ~ «Жер симфониясы»
Dialogue: 0,1:31:43.97,1:31:46.97,Default,,0000,0000,0000,,Дыбыс... музыка...
Dialogue: 0,1:31:46.97,1:32:01.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:32:01.95,1:32:03.95,Default,,0000,0000,0000,,Нобита-сан! Хехе...
Dialogue: 0,1:32:05.95,1:32:07.96,Default,,0000,0000,0000,,О.
Dialogue: 0,1:32:05.95,1:32:07.96,Default,,0000,0000,0000,,Әлі біткен жоқ! Сәлем Сунео!
Dialogue: 0,1:32:07.96,1:32:09.96,Default,,0000,0000,0000,,Міне, солай!
Dialogue: 0,1:32:09.96,1:32:11.99,Default,,0000,0000,0000,,Барлығына!
Dialogue: 0,1:32:09.96,1:32:11.99,Default,,0000,0000,0000,,Кеттік, Нобита.
Dialogue: 0,1:32:11.99,1:32:13.96,Default,,0000,0000,0000,,Микка!
Dialogue: 0,1:32:13.96,1:32:16.93,Default,,0000,0000,0000,,♬ ~ “Лалалалалалалалла ләлалаллала”
Dialogue: 0,1:32:18.00,1:32:21.97,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,1:32:21.97,1:32:24.97,Default,,0000,0000,0000,,♬ ~ “Лалалалаллалалалла ләлалаллала”
Dialogue: 0,1:32:24.97,1:32:28.98,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,1:32:29.98,1:32:31.98,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:32:31.98,1:32:33.98,Default,,0000,0000,0000,,Учуу
Dialogue: 0,1:32:31.98,1:32:33.98,Default,,0000,0000,0000,,Кеңістікте дыбыс бар...
Dialogue: 0,1:32:33.98,1:32:36.95,Default,,0000,0000,0000,,Микка-сама... Нобита-сан және басқалар...!
Dialogue: 0,1:32:38.05,1:32:40.99,Default,,0000,0000,0000,,⚞♬～ (ән айту және ойнау)
Dialogue: 0,1:32:38.05,1:32:40.99,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:32:38.05,1:32:40.99,Default,,0000,0000,0000,,О? Қызық, бұл қайдан келеді?
Dialogue: 0,1:32:40.99,1:32:44.99,Default,,0000,0000,0000,,Келесі
Dialogue: 0,1:32:40.99,1:32:44.99,Default,,0000,0000,0000,,Бұл сіздің көршіңіздің теледидары емес пе?
Dialogue: 0,1:32:40.99,1:32:44.99,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,1:32:44.99,1:32:49.03,Default,,0000,0000,0000,,♬ ~ “Лалала лалла лала лә ла ла”
Dialogue: 0,1:32:49.03,1:32:56.00,Default,,0000,0000,0000,,♬ ~ «Ләләлаләлләләлләлаллаалла
Dialogue: 0,1:32:49.03,1:32:56.00,Default,,0000,0000,0000,,Ла ла ла ла ла ла ла ла ».
Dialogue: 0,1:32:56.00,1:32:59.97,Default,,0000,0000,0000,,♬～ (Диктофон)
Dialogue: 0,1:32:59.97,1:33:05.98,Default,,0000,0000,0000,,Ontei
Dialogue: 0,1:32:59.97,1:33:05.98,Default,,0000,0000,0000,,Аудио: zwx & Tsurou; Аударма: Basugi & Ginappuru; Өңдеу: Xiao Ke & Ariake no Tsuki; Уақыт белгілеу: Feng She; Дәстүрлі қытайшаға түрлендіру: incot; Кодтау: Lie Shu
Dialogue: 0,1:32:59.97,1:33:05.98,Default,,0000,0000,0000,,(шығарылған дыбыс)
Dialogue: 0,1:33:06.98,1:33:09.98,Default,,0000,0000,0000,,Тазалау
Dialogue: 0,1:33:06.98,1:33:09.98,Default,,0000,0000,0000,,Кадун
Dialogue: 0,1:33:06.98,1:33:09.98,Default,,0000,0000,0000,,(Шаңсорғыштың жұмыс дыбысы)
Dialogue: 0,1:33:09.98,1:33:13.99,Default,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,1:33:09.98,1:33:13.99,Default,,0000,0000,0000,,(қиярдың кесілген дыбысы)
Dialogue: 0,1:33:13.99,1:33:16.96,Default,,0000,0000,0000,,Мокузай
Dialogue: 0,1:33:13.99,1:33:16.96,Default,,0000,0000,0000,,(ағаш кесу дыбысы)
Dialogue: 0,1:33:17.99,1:33:20.96,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,1:33:17.99,1:33:20.96,Default,,0000,0000,0000,,Ұзын
Dialogue: 0,1:33:17.99,1:33:20.96,Default,,0000,0000,0000,,(Дәретхананың ағу дыбысы)
Dialogue: 0,1:33:17.99,1:33:20.96,Default,,0000,0000,0000,,А...
Dialogue: 0,1:33:20.96,1:33:22.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:33:22.96,1:33:25.03,Default,,0000,0000,0000,,ашуланшақ
Dialogue: 0,1:33:22.96,1:33:25.03,Default,,0000,0000,0000,,Кансей
Dialogue: 0,1:33:22.96,1:33:25.03,Default,,0000,0000,0000,,Жарыс қаншада басталады?
Dialogue: 0,1:33:25.03,1:33:28.97,Default,,0000,0000,0000,,Қорытынды
Dialogue: 0,1:33:25.03,1:33:28.97,Default,,0000,0000,0000,,Кенже
Dialogue: 0,1:33:25.03,1:33:28.97,Default,,0000,0000,0000,,Олай болса, соңында бәріміз бірге болайық!
Dialogue: 0,1:33:28.97,1:33:35.01,Default,,0000,0000,0000,,Тебёши
Dialogue: 0,1:33:28.97,1:33:35.01,Default,,0000,0000,0000,,(қол шапалақтау)
Dialogue: 0,1:33:35.01,1:33:38.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:33:38.98,1:33:40.98,Default,,0000,0000,0000,,Жерден шыққан музыка...
Dialogue: 0,1:33:41.98,1:33:43.99,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,1:33:41.98,1:33:43.99,Default,,0000,0000,0000,,Хехехе….
Dialogue: 0,1:33:43.99,1:33:47.99,Default,,0000,0000,0000,,♬～(көрсетілім)
Dialogue: 0,1:33:47.99,1:33:49.99,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,1:33:49.99,1:34:00.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:34:00.97,1:34:03.97,Default,,0000,0000,0000,,♬ ~ «Рах-рах-рах-рах»
Dialogue: 0,1:34:03.97,1:34:07.98,Default,,0000,0000,0000,,♬～(Мина) “Лалала лала”
Dialogue: 0,1:34:07.98,1:34:11.95,Default,,0000,0000,0000,,♬~ (Мика Мина) «Рах-рах-рах-рах»
Dialogue: 0,1:34:11.95,1:34:16.95,Default,,0000,0000,0000,,♬ ~ “Ралала ла ла ла ла”
Dialogue: 0,1:34:16.95,1:34:34.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:34:34.97,1:34:52.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:34:52.99,1:34:56.96,Default,,0000,0000,0000,,♬~ «Ран ла ран ла ла ла
Dialogue: 0,1:34:52.99,1:34:56.96,Default,,0000,0000,0000,,Run-la-ran-la-la-la».
Dialogue: 0,1:34:56.96,1:34:58.96,Default,,0000,0000,0000,,♬~ “Лалала лала”
Dialogue: 0,1:34:58.96,1:35:02.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:35:02.96,1:35:09.97,Default,,0000,0000,0000,,♬～“Лалалалаллалалаллалалалааааааааааааааа”
Dialogue: 0,1:35:09.97,1:35:28.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:35:28.96,1:35:31.96,Default,,0000,0000,0000,,(«жоқ» дыбысы)
Dialogue: 0,1:35:31.96,1:35:42.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:35:52.98,1:35:54.98,Default,,0000,0000,0000,,Мм... О, құдайым.
Dialogue: 0,1:35:54.98,1:35:57.99,Default,,0000,0000,0000,,Энсукай
Dialogue: 0,1:35:54.98,1:35:57.99,Default,,0000,0000,0000,,Бұл керемет концерт болды.
Dialogue: 0,1:35:57.99,1:35:59.99,Default,,0000,0000,0000,,Бірақ бұл өте қызықты болды!
Dialogue: 0,1:35:59.99,1:36:02.99,Default,,0000,0000,0000,,Иә! сөзсіз….
Dialogue: 0,1:36:02.99,1:36:04.99,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:36:02.99,1:36:04.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:36:04.99,1:36:06.96,Default,,0000,0000,0000,,Мұғалім
Dialogue: 0,1:36:04.99,1:36:06.96,Default,,0000,0000,0000,,Мұғалім...!
Dialogue: 0,1:36:04.99,1:36:06.96,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:36:06.96,1:36:08.96,Default,,0000,0000,0000,,Құрметті Мика!
Dialogue: 0,1:36:10.00,1:36:13.00,Default,,0000,0000,0000,,«Виртуоз және роботтар
Dialogue: 0,1:36:10.00,1:36:13.00,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,1:36:10.00,1:36:13.00,Default,,0000,0000,0000,,Шеңбер құру→
Dialogue: 0,1:36:13.00,1:36:14.97,Default,,0000,0000,0000,,Көңілсіз
Dialogue: 0,1:36:13.00,1:36:14.97,Default,,0000,0000,0000,,Кана
Dialogue: 0,1:36:13.00,1:36:14.97,Default,,0000,0000,0000,,Ол өте әдемі фарре ойнады».
Dialogue: 0,1:36:14.97,1:36:17.97,Default,,0000,0000,0000,,Кішкентай қоңыз
Dialogue: 0,1:36:14.97,1:36:17.97,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,1:36:14.97,1:36:17.97,Default,,0000,0000,0000,,Мауах
Dialogue: 0,1:36:14.97,1:36:17.97,Default,,0000,0000,0000,,«Дыбыс жәндіктер жылт-жылт етіп ұшады →
Dialogue: 0,1:36:17.97,1:36:20.98,Default,,0000,0000,0000,,Дүние
Dialogue: 0,1:36:17.97,1:36:20.98,Default,,0000,0000,0000,,Жарық
Dialogue: 0,1:36:17.97,1:36:20.98,Default,,0000,0000,0000,,Дүние нұрға толды».
Dialogue: 0,1:36:20.98,1:36:25.98,Default,,0000,0000,0000,,Муон
Dialogue: 0,1:36:20.98,1:36:25.98,Default,,0000,0000,0000,,Бірақ неге үнсіз болуы керек ғаламда?
Dialogue: 0,1:36:20.98,1:36:25.98,Default,,0000,0000,0000,,Жарық
Dialogue: 0,1:36:20.98,1:36:25.98,Default,,0000,0000,0000,,Дыбыс болды, солай ма?
Dialogue: 0,1:36:25.98,1:36:27.98,Default,,0000,0000,0000,,Иә? Мен оны жақсы көремін!
Dialogue: 0,1:36:27.98,1:36:29.98,Default,,0000,0000,0000,,Сөздік
Dialogue: 0,1:36:27.98,1:36:29.98,Default,,0000,0000,0000,,Кеңістік уақытын ауыстырғыш?
Dialogue: 0,1:36:29.98,1:36:32.05,Default,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,1:36:29.98,1:36:32.05,Default,,0000,0000,0000,,Неліктен мұндай жерде...?
Dialogue: 0,1:36:29.98,1:36:32.05,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,1:36:32.05,1:36:33.99,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:36:32.05,1:36:33.99,Default,,0000,0000,0000,,Ах! Қосқыш қосулы!
Dialogue: 0,1:36:33.99,1:36:35.99,Default,,0000,0000,0000,,Идосаки
Dialogue: 0,1:36:33.99,1:36:35.99,Default,,0000,0000,0000,,Баратын жер...
Dialogue: 0,1:36:35.99,1:36:45.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:36:45.00,1:36:47.97,Default,,0000,0000,0000,,Дыбыс соншалықты жақсы резонанс тудырды ма?
Dialogue: 0,1:36:47.97,1:36:56.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:36:56.98,1:36:58.98,Default,,0000,0000,0000,,Хира
Dialogue: 0,1:36:56.98,1:36:58.98,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,1:36:56.98,1:36:58.98,Default,,0000,0000,0000,,Ах... Юрико... Мұнда мен үшін орын жоқ па?
Dialogue: 0,1:36:58.98,1:37:00.98,Default,,0000,0000,0000,,Васу
Dialogue: 0,1:36:58.98,1:37:00.98,Default,,0000,0000,0000,,Ләуһит
Dialogue: 0,1:36:58.98,1:37:00.98,Default,,0000,0000,0000,,А, Нобита-кун, мен бір нәрсені ұмытып қалдым!
Dialogue: 0,1:37:00.98,1:37:03.98,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ. Мен барамын!
Dialogue: 0,1:37:03.98,1:37:05.99,Default,,0000,0000,0000,,Жалпы...
Dialogue: 0,1:37:05.99,1:37:16.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:37:16.96,1:37:18.97,Default,,0000,0000,0000,,Есік
Dialogue: 0,1:37:16.96,1:37:18.97,Default,,0000,0000,0000,,Сол екеу ме?
Dialogue: 0,1:37:16.96,1:37:18.97,Default,,0000,0000,0000,,Құрметті Мика!
Dialogue: 0,1:37:18.97,1:37:22.00,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,1:37:18.97,1:37:22.00,Default,,0000,0000,0000,,Дәл қазір, доктор Венто →
Dialogue: 0,1:37:22.00,1:37:26.01,Default,,0000,0000,0000,,Себеп
Dialogue: 0,1:37:22.00,1:37:26.01,Default,,0000,0000,0000,,...
Dialogue: 0,1:37:22.00,1:37:26.01,Default,,0000,0000,0000,,...
Dialogue: 0,1:37:22.00,1:37:26.01,Default,,0000,0000,0000,,Көңіл көтеру
Dialogue: 0,1:37:22.00,1:37:26.01,Default,,0000,0000,0000,,Шинго
Dialogue: 0,1:37:22.00,1:37:26.01,Default,,0000,0000,0000,,Мушика планетасынан қашып кеткен басқа кеменің сигналы.
Dialogue: 0,1:37:22.00,1:37:26.01,Default,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,1:37:22.00,1:37:26.01,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,1:37:22.00,1:37:26.01,Default,,0000,0000,0000,,Ол оны алғанын айтты!
Dialogue: 0,1:37:26.01,1:37:30.04,Default,,0000,0000,0000,,Игай
Dialogue: 0,1:37:26.01,1:37:30.04,Default,,0000,0000,0000,,Бізден басқа
Dialogue: 0,1:37:26.01,1:37:30.04,Default,,0000,0000,0000,,Адамдар
Dialogue: 0,1:37:26.01,1:37:30.04,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,1:37:26.01,1:37:30.04,Default,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,1:37:26.01,1:37:30.04,Default,,0000,0000,0000,,Мушиканың халқы әлі тірі еді!
Dialogue: 0,1:37:30.04,1:37:35.95,Default,,0000,0000,0000,,Сол кездегі Фарре
Dialogue: 0,1:37:30.04,1:37:35.95,Default,,0000,0000,0000,,Сонзай
Dialogue: 0,1:37:30.04,1:37:35.95,Default,,0000,0000,0000,,Шырмауық
Dialogue: 0,1:37:30.04,1:37:35.95,Default,,0000,0000,0000,,Ол бізге біздің бар екендігімізді хабарлады!
Dialogue: 0,1:37:35.95,1:37:37.95,Default,,0000,0000,0000,,Дыбыстық сигнал естілді!
Dialogue: 0,1:37:41.96,1:37:46.06,Default,,0000,0000,0000,,Рахмет Нохохо…→
