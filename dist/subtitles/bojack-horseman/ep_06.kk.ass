Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.74,Default,,0,0,0,,NETFLIX түпнұсқа жұмысы
Dialogue: 0,0:00:10.64,0:00:11.77,Default,,0,0,0,,«Бал»
Dialogue: 0,0:00:12.04,0:00:14.78,Default,,0,0,0,,Өкініштісі, мен бал туралы айтып тұрған жоқпын.
Dialogue: 0,0:00:16.28,0:00:17.15,Default,,0,0,0,,Дайан
Dialogue: 0,0:00:17.21,0:00:18.71,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:00:20.52,0:00:23.25,Default,,0,0,0,,БоДжек қол алысады
Dialogue: 0,0:00:23.32,0:00:23.72,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:00:24.02,0:00:25.52,Default,,0,0,0,,Мен сізге міндетті түрде рұқсат етемін.
Dialogue: 0,0:00:25.62,0:00:26.45,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:00:26.69,0:00:28.19,Default,,0,0,0,,Бұл мен туралы ма?
Dialogue: 0,0:00:28.26,0:00:29.32,Default,,0,0,0,,Әрине
Dialogue: 0,0:00:29.39,0:00:31.69,Default,,0,0,0,,Мен бұл туралы сен үйге қайтып келе жатқанда ойладым.
Dialogue: 0,0:00:32.03,0:00:34.26,Default,,0,0,0,,Сіз мені қалай бал дейсіз?
Dialogue: 0,0:00:34.36,0:00:35.73,Default,,0,0,0,,Мен қателестім бе?
Dialogue: 0,0:00:36.03,0:00:37.60,Default,,0,0,0,,Оны жіберіңіз
Dialogue: 0,0:00:37.70,0:00:40.34,Default,,0,0,0,,Тодд мені алып кетуге келеді.
Dialogue: 0,0:00:40.50,0:00:42.20,Default,,0,0,0,,«Голливуд түрмесі»
Dialogue: 0,0:00:42.67,0:00:44.44,Default,,0,0,0,,Сіз жаңасыз ба?
Dialogue: 0,0:00:44.54,0:00:46.47,Default,,0,0,0,,Жарайды, уайымдайтын ештеңе жоқ...
Dialogue: 0,0:00:50.51,0:00:52.45,Default,,0,0,0,,Ұмытпа
Dialogue: 0,0:00:52.58,0:00:56.18,Default,,0,0,0,,Маған мінуге рұқсат етіңіз. Қонған кездегідей қатты шайқалмайды.
Dialogue: 0,0:00:56.35,0:00:58.35,Default,,0,0,0,,Бұл қорқынышты болды.
Dialogue: 0,0:00:58.52,0:01:01.72,Default,,0,0,0,,Жалғыз болсам, үрейленетін едім.
Dialogue: 0,0:01:02.06,0:01:03.83,Default,,0,0,0,,Жыланға тап болғаннан гөрі?
Dialogue: 0,0:01:04.16,0:01:05.83,Default,,0,0,0,,Оны мазақ етпе
Dialogue: 0,0:01:06.59,0:01:08.60,Default,,0,0,0,,Не болды?
Dialogue: 0,0:01:08.70,0:01:12.33,Default,,0,0,0,,Мен жыландардың маған шабуыл жасағаны туралы фильм көріп отырдым.
Dialogue: 0,0:01:12.40,0:01:14.47,Default,,0,0,0,,Сонымен... қай фильм?
Dialogue: 0,0:01:14.54,0:01:18.07,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:01:18.34,0:01:23.21,Default,,0,0,0,,Бұл ақымақ сұрақ, мен оны қоюға ұяламын.
Dialogue: 0,0:01:23.41,0:01:27.52,Default,,0,0,0,,Дайан екеуіңнің араларыңда бірдеңе болды ма?
Dialogue: 0,0:01:27.78,0:01:30.08,Default,,0,0,0,,Не?
Dialogue: 0,0:01:32.52,0:01:34.46,Default,,0,0,0,,Менімен қалжыңдаңыз.
Dialogue: 0,0:01:34.62,0:01:36.12,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:01:37.16,0:01:40.13,Default,,0,0,0,,Толық уайымдадым
Dialogue: 0,0:02:30.85,0:02:34.65,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:02:36.28,0:02:38.29,Default,,0,0,0,,Тамақ жегің келмейді ме?
Dialogue: 0,0:02:38.42,0:02:43.19,Default,,0,0,0,,Қаласаңыз, көлігіңізде сусын алуға болады.
Dialogue: 0,0:02:43.29,0:02:46.86,Default,,0,0,0,,Бүгін бірге уақыт өткізейік...
Dialogue: 0,0:02:47.16,0:02:49.43,Default,,0,0,0,,Сіз әрқашан осылай айтасыз, солай ма?
Dialogue: 0,0:02:49.50,0:02:53.47,Default,,0,0,0,,БоДжекпен бірге шыққыңыз келе ме?
Dialogue: 0,0:02:53.57,0:02:56.54,Default,,0,0,0,,Мен қоңырау шалдым, бірақ жауап болмады.
Dialogue: 0,0:02:56.70,0:02:58.34,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:02:58.44,0:03:01.34,Default,,0,0,0,,Кәне, кешкі асты бірге ішейік.
Dialogue: 0,0:03:03.38,0:03:06.21,Default,,0,0,0,,34В орындықтағы жігіт есіңізде ме?
Dialogue: 0,0:03:06.31,0:03:08.35,Default,,0,0,0,,Әрине есімде.
Dialogue: 0,0:03:08.52,0:03:12.42,Default,,0,0,0,,Мен сенімен Мексикаға барған кезім есімде.
Dialogue: 0,0:03:12.49,0:03:15.72,Default,,0,0,0,,Ол кездегі дүкенге ұқсайды.
Dialogue: 0,0:03:15.82,0:03:19.46,Default,,0,0,0,,үшінна түсінікті әңгіме айтыңыз.
Dialogue: 0,0:03:19.59,0:03:22.63,Default,,0,0,0,,Олай болса, бізге сәлем.
Dialogue: 0,0:03:23.30,0:03:26.73,Default,,0,0,0,,Иә... Маған ұнамайды. Оның ішінде бірдеңе бар.
Dialogue: 0,0:03:26.80,0:03:28.24,Default,,0,0,0,,Менеджер
Dialogue: 0,0:03:28.34,0:03:31.51,Default,,0,0,0,,Күте тұрыңыз, мен оны сұрадым.
Dialogue: 0,0:03:32.21,0:03:34.51,Default,,0,0,0,,Бұл D-ның кулоны.
Dialogue: 0,0:03:34.61,0:03:37.25,Default,,0,0,0,,Түсіндің бе? Бұл «Мен сені сүйемін» үшін D.
Dialogue: 0,0:03:37.45,0:03:37.91,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:03:37.98,0:03:40.48,Default,,0,0,0,,Бұл итке арналған D емес пе?
Dialogue: 0,0:03:40.62,0:03:41.92,Default,,0,0,0,,Бұл Дайанның Д.
Dialogue: 0,0:03:42.22,0:03:44.92,Default,,0,0,0,,Бұл менің бірінші тәжірибем.
Dialogue: 0,0:03:47.62,0:03:49.92,Default,,0,0,0,,Бақытты жұпқа арналған шампан
Dialogue: 0,0:03:49.99,0:03:53.93,Default,,0,0,0,,D, маған Дом Периді беріңіз.
Dialogue: 0,0:03:54.23,0:03:58.80,Default,,0,0,0,,Құпия мәзірден тапсырыс беру қиын.
Dialogue: 0,0:03:58.90,0:04:01.67,Default,,0,0,0,,Ең қымбат шампан
Dialogue: 0,0:04:01.77,0:04:05.47,Default,,0,0,0,,1920 жылғы Diamant Blue туралы не деуге болады?
Dialogue: 0,0:04:05.71,0:04:08.54,Default,,0,0,0,,Үшеуміз аман болайық
Dialogue: 0,0:04:08.64,0:04:12.28,Default,,0,0,0,,Бұл менің рахатым, оны іш.
Dialogue: 0,0:04:13.51,0:04:15.62,Default,,0,0,0,,Сіз жомартсыз.
Dialogue: 0,0:04:15.68,0:04:19.75,Default,,0,0,0,,Онда мен саған X-Box да беремін.
Dialogue: 0,0:04:19.85,0:04:20.92,Default,,0,0,0,,Бір уақытта бір бірлік
Dialogue: 0,0:04:22.49,0:04:24.29,Default,,0,0,0,,Екеуің доғарыңдар.
Dialogue: 0,0:04:24.39,0:04:28.30,Default,,0,0,0,,Сыйлық соғыстың бос сөз екені рас.
Dialogue: 0,0:04:28.40,0:04:29.50,Default,,0,0,0,,Жалғастыру
Dialogue: 0,0:04:29.63,0:04:34.30,Default,,0,0,0,,Бұл жігіт менің актерлік мансабым ғана емес.
Dialogue: 0,0:04:34.40,0:04:35.90,Default,,0,0,0,,Тостты ұрлау...
Dialogue: 0,0:04:35.97,0:04:38.81,Default,,0,0,0,,Маған тез сыйлық беріңіз
Dialogue: 0,0:04:38.91,0:04:41.54,Default,,0,0,0,,Олай болса қолыңызда бармен ойнайтын кез келді.
Dialogue: 0,0:04:41.68,0:04:46.58,Default,,0,0,0,,Мен тікұшақ сатып алдым, оны мінгісі келетіндер бар ма?
Dialogue: 0,0:04:47.52,0:04:51.29,Default,,0,0,0,,Маған ұнамайды, өйткені байлығыңмен мақтанатын сияқтысың.
Dialogue: 0,0:04:51.42,0:04:52.65,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:04:52.75,0:04:56.82,Default,,0,0,0,,Жарайды, мен бұл дүкенді сатып алдым.
Dialogue: 0,0:04:56.89,0:04:59.33,Default,,0,0,0,,Иесі үшін би
Dialogue: 0,0:05:01.03,0:05:02.33,Default,,0,0,0,,«Түрме»
Dialogue: 0,0:05:04.97,0:05:05.80,Default,,0,0,0,,Ой
Dialogue: 0,0:05:06.60,0:05:08.30,Default,,0,0,0,,Алдымен барыңыз.
Dialogue: 0,0:05:08.37,0:05:12.34,Default,,0,0,0,,Сен де тазалықты ұнатасың ба?
Dialogue: 0,0:05:12.41,0:05:15.74,Default,,0,0,0,,Тазалықты қатты ұнататыным кездейсоқтық.
Dialogue: 0,0:05:15.84,0:05:16.61,Default,,0,0,0,,Бұл Тодд.
Dialogue: 0,0:05:16.71,0:05:17.35,Default,,0,0,0,,Клаус
Dialogue: 0,0:05:17.41,0:05:21.42,Default,,0,0,0,,Ол жаңадан келген сияқты, бірақ бізде ортақ нәрсе көп сияқты.
Dialogue: 0,0:05:21.48,0:05:25.95,Default,,0,0,0,,Мен аппақпын, тазалықты ұнатамын. Сіз маған қосылғыңыз келе ме?
Dialogue: 0,0:05:26.32,0:05:29.49,Default,,0,0,0,,Достар бандаларды білдіреді ме?
Dialogue: 0,0:05:29.69,0:05:32.89,Default,,0,0,0,,Денеңізді жаттықтырғыңыз келсе, мен сізді біреумен таныстырамын.
Dialogue: 0,0:05:32.96,0:05:36.90,Default,,0,0,0,,Соңғы 20 жыл бойы мен де бөтелке шарап шығардым.
Dialogue: 0,0:05:36.96,0:05:39.70,Default,,0,0,0,,Арийлердің үстемдігі
Dialogue: 0,0:05:39.80,0:05:43.47,Default,,0,0,0,,Нацистік сенушілер шынымен бар ма?
Dialogue: 0,0:05:43.54,0:05:45.37,Default,,0,0,0,,Ертең кеш бар.
Dialogue: 0,0:05:45.47,0:05:49.11,Default,,0,0,0,,Шешім қабылдамас бұрын барлығымен сөйлесіңіз.
Dialogue: 0,0:05:49.38,0:05:50.85,Default,,0,0,0,,Бұл менің визит карточкам.
Dialogue: 0,0:05:51.05,0:05:54.05,Default,,0,0,0,,Ол қайда жасырылды?
Dialogue: 0,0:05:54.55,0:05:55.08,Default,,0,0,0,,«Elefante жаңа иесі»
Dialogue: 0,0:05:55.08,0:05:56.88,Default,,0,0,0,,«Elefante жаңа иесі»
Dialogue: 0,0:05:55.08,0:05:56.88,Default,,0,0,0,,45 46 47…
Dialogue: 0,0:05:56.88,0:05:59.12,Default,,0,0,0,,45 46 47…
Dialogue: 0,0:05:59.82,0:06:02.02,Default,,0,0,0,,Енді тоқтайық
Dialogue: 0,0:06:02.36,0:06:04.06,Default,,0,0,0,,Мен әлі шаршаған жоқпын.
Dialogue: 0,0:06:04.36,0:06:05.79,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:06:05.99,0:06:09.46,Default,,0,0,0,,Осы түкке тұрғысыз бәсекенің соңында...
Dialogue: 0,0:06:12.37,0:06:15.54,Default,,0,0,0,,D «Секс және кәмпит»?
Dialogue: 0,0:06:15.90,0:06:17.67,Default,,0,0,0,,«Хабарламау»
Dialogue: 0,0:06:17.97,0:06:18.77,Default,,0,0,0,,Боджак
Dialogue: 0,0:06:18.84,0:06:20.94,Default,,0,0,0,,Тодд, сен қайдасың?
Dialogue: 0,0:06:21.04,0:06:24.48,Default,,0,0,0,,Сенің кесіріңнен мен көлікпен жүруім керек.
Dialogue: 0,0:06:24.61,0:06:26.61,Default,,0,0,0,,Мен қазір түрмедемін.
Dialogue: 0,0:06:26.75,0:06:30.55,Default,,0,0,0,,Ал, телефонды осы жерде қолданайық.
Dialogue: 0,0:06:30.65,0:06:33.62,Default,,0,0,0,,Мари Кюри қандай марапатқа ие болды?
Dialogue: 0,0:06:33.69,0:06:35.06,Default,,0,0,0,,A Химия және физика
Dialogue: 0,0:06:35.39,0:06:36.39,Default,,0,0,0,,В Биология және...
Dialogue: 0,0:06:36.52,0:06:38.03,Default,,0,0,0,,Дұрыс жауап – В.
Dialogue: 0,0:06:38.39,0:06:38.89,Default,,0,0,0,,Бұл А.
Dialogue: 0,0:06:38.96,0:06:41.06,Default,,0,0,0,,Енді жеңетін уақыт
Dialogue: 0,0:06:41.40,0:06:44.17,Default,,0,0,0,,Мен үшін де солай. Кепіл құны 50 доллар...
Dialogue: 0,0:06:50.07,0:06:53.94,Default,,0,0,0,,Мен армрестлинг бойынша чемпионмын
Dialogue: 0,0:06:54.01,0:06:55.11,Default,,0,0,0,,Дайанды көрдіңіз бе?
Dialogue: 0,0:06:55.81,0:06:56.71,Default,,0,0,0,,Дайан?
Dialogue: 0,0:06:56.78,0:06:59.85,Default,,0,0,0,,Жақсы, кешіріңізші.
Dialogue: 0,0:06:59.95,0:07:02.78,Default,,0,0,0,,Мен ғашығымды төсекке апаруым керек.
Dialogue: 0,0:07:04.05,0:07:06.85,Default,,0,0,0,,Сіз әлі де осында болдыңыз ба?
Dialogue: 0,0:07:07.56,0:07:08.66,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:07:08.82,0:07:09.99,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:07:11.19,0:07:13.86,Default,,0,0,0,,Уайымыңызды кетіретін сусын
Dialogue: 0,0:07:14.56,0:07:15.86,Default,,0,0,0,,Тым күшті
Dialogue: 0,0:07:16.10,0:07:17.20,Default,,0,0,0,,Бұл таңғы ас.
Dialogue: 0,0:07:17.83,0:07:18.93,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:07:26.81,0:07:28.71,Default,,0,0,0,,Бұл жұмыс істеді.
Dialogue: 0,0:07:28.78,0:07:30.68,Default,,0,0,0,,Жаңалықтар
Dialogue: 0,0:07:30.81,0:07:34.95,Default,,0,0,0,,Біреу Голливудтың Д.
Dialogue: 0,0:07:35.12,0:07:35.88,Default,,0,0,0,,Не?
Dialogue: 0,0:07:35.98,0:07:40.76,Default,,0,0,0,,Сондықтан Голливудтың ескерту деңгейі ең жоғары D.
Dialogue: 0,0:07:40.86,0:07:44.76,Default,,0,0,0,,Д-ны қандай адам ұрлады?
Dialogue: 0,0:07:44.86,0:07:47.50,Default,,0,0,0,,Бұл қолжазба әзіл.
Dialogue: 0,0:07:47.70,0:07:48.56,Default,,0,0,0,,Ағаларыңа құрмет көрсет!
Dialogue: 0,0:07:49.46,0:07:50.47,Default,,0,0,0,,Бұл табиғи ғой, иә?
Dialogue: 0,0:07:52.00,0:07:53.70,Default,,0,0,0,,Д-ны не үшін ұрладың?
Dialogue: 0,0:07:53.77,0:07:55.74,Default,,0,0,0,,Сәлем Дайан
Dialogue: 0,0:07:55.94,0:07:58.47,Default,,0,0,0,,Бір-бірден, кезекпен—
Dialogue: 0,0:07:58.64,0:08:01.88,Default,,0,0,0,,Не тергеуге алынды
Dialogue: 0,0:08:01.94,0:08:05.25,Default,,0,0,0,,Духовный Дайк DMX Dane
Dialogue: 0,0:08:05.51,0:08:06.85,Default,,0,0,0,,үшін D.
Dialogue: 0,0:08:07.08,0:08:10.12,Default,,0,0,0,,Эй D, сен де бүгін ынталысың.
Dialogue: 0,0:08:10.52,0:08:12.99,Default,,0,0,0,,Бірақ мен суық тиіп қалдым.
Dialogue: 0,0:08:13.12,0:08:17.53,Default,,0,0,0,,Сіз аштықтасыз ба? Сіздің қазіргі жөтеліңіз де өтірік емес пе?
Dialogue: 0,0:08:17.63,0:08:19.26,Default,,0,0,0,,Ол мас болып, маған дауыстық хат қалдырды.
Dialogue: 0,0:08:19.53,0:08:20.03,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:08:20.09,0:08:22.93,Default,,0,0,0,,Қырылдағаннан кейін—
Dialogue: 0,0:08:23.00,0:08:27.87,Default,,0,0,0,,Металл дыбыс және бір нәрсені сүйреп бара жатқандай ауыр тыныс алу.
Dialogue: 0,0:08:28.00,0:08:29.94,Default,,0,0,0,,үшін осы ма?
Dialogue: 0,0:08:30.04,0:08:31.91,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:08:31.97,0:08:36.08,Default,,0,0,0,,Маған ішкеннен кейін дауыстық поштамды тыңдамайсың деп уәде бер.
Dialogue: 0,0:08:36.18,0:08:37.21,Default,,0,0,0,,Егер сіз ішуді қаласаңыз?
Dialogue: 0,0:08:37.28,0:08:37.91,Default,,0,0,0,,Түстен бастап?
Dialogue: 0,0:08:37.98,0:08:38.91,Default,,0,0,0,,Қазір ішіңіз
Dialogue: 0,0:08:38.98,0:08:39.95,Default,,0,0,0,,Сұхбат туралы не деуге болады?
Dialogue: 0,0:08:40.05,0:08:43.22,Default,,0,0,0,,Голливуд актерлері уәделерін бұзатындар.
Dialogue: 0,0:08:43.28,0:08:46.22,Default,,0,0,0,,D жоқ, сондықтан бұл «Харуу»
Dialogue: 0,0:08:46.29,0:08:49.56,Default,,0,0,0,,Гохонгохон кездескенше.
Dialogue: 0,0:08:51.09,0:08:54.56,Default,,0,0,0,,БоДжек? Қазір қиын
Dialogue: 0,0:08:54.66,0:08:58.10,Default,,0,0,0,,Дин Деннис Дасти да полицияға барды.
Dialogue: 0,0:08:58.20,0:08:59.83,Default,,0,0,0,,Мен Д-ны ұрладым.
Dialogue: 0,0:09:00.23,0:09:02.80,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:09:02.94,0:09:03.97,Default,,0,0,0,,Қалай...
Dialogue: 0,0:09:04.21,0:09:06.84,Default,,0,0,0,,Мұның бәрі проблемалық мінез-құлыққа қатысты.
Dialogue: 0,0:09:06.94,0:09:08.84,Default,,0,0,0,,Дайан біледі
Dialogue: 0,0:09:08.94,0:09:10.11,Default,,0,0,0,,Дайан?
Dialogue: 0,0:09:10.21,0:09:13.68,Default,,0,0,0,,Сізге бұл қыз ұнайды, солай ма?
Dialogue: 0,0:09:18.82,0:09:20.12,Default,,0,0,0,,Қалжың емес.
Dialogue: 0,0:09:20.32,0:09:23.26,Default,,0,0,0,,D оған? Мен сене алар емеспін
Dialogue: 0,0:09:23.59,0:09:25.56,Default,,0,0,0,,Мүмкін Дэвидтің Д
Dialogue: 0,0:09:25.63,0:09:29.06,Default,,0,0,0,,Ол мас болып, суретті жариялаған сияқты.
Dialogue: 0,0:09:29.86,0:09:31.73,Default,,0,0,0,,Ол қойылды.
Dialogue: 0,0:09:32.03,0:09:38.07,Default,,0,0,0,,Жарайды, хабар бермей, тойда жолсерік болып шығайын.
Dialogue: 0,0:09:38.21,0:09:40.71,Default,,0,0,0,,Сол жылы үйлену тойы?
Dialogue: 0,0:09:40.84,0:09:41.98,Default,,0,0,0,,Туыстарың көп пе?
Dialogue: 0,0:09:43.24,0:09:47.62,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:09:47.85,0:09:48.98,Default,,0,0,0,,«Орындау»
Dialogue: 0,0:09:49.12,0:09:49.75,Default,,0,0,0,,D
Dialogue: 0,0:09:49.92,0:09:54.12,Default,,0,0,0,,Білезіктегі үлкен D белгісі?
Dialogue: 0,0:09:54.22,0:09:55.02,Default,,0,0,0,,Мен жасамаймын
Dialogue: 0,0:09:55.66,0:09:56.96,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:09:57.09,0:09:59.96,Default,,0,0,0,,Мен анықтамаларды ұстандым.
Dialogue: 0,0:10:00.03,0:10:04.17,Default,,0,0,0,,Содан кейін біз сот-медициналық сараптама жасадық және не болды...
Dialogue: 0,0:10:04.27,0:10:06.87,Default,,0,0,0,,Мен жауап берушінің дыбысын естідім.
Dialogue: 0,0:10:06.93,0:10:09.37,Default,,0,0,0,,«Дайан үшін ұрланған»
Dialogue: 0,0:10:09.64,0:10:12.74,Default,,0,0,0,,«Менің атымды ата»
Dialogue: 0,0:10:12.87,0:10:14.64,Default,,0,0,0,,Тіпті бұл
Dialogue: 0,0:10:14.81,0:10:16.91,Default,,0,0,0,,Сіз оны әлі де ұнатасыз ба?
Dialogue: 0,0:10:17.01,0:10:19.91,Default,,0,0,0,,Мені Дайан қызықтырады.
Dialogue: 0,0:10:20.01,0:10:22.05,Default,,0,0,0,,Ол менің эмоционалды тірегім
Dialogue: 0,0:10:22.15,0:10:25.02,Default,,0,0,0,,Ол менің бірінші әйел түрім.
Dialogue: 0,0:10:25.09,0:10:27.66,Default,,0,0,0,,Мен оны мазақ етіп жатырмын
Dialogue: 0,0:10:27.76,0:10:31.76,Default,,0,0,0,,Мен де басқалардың заттарын ұрлағанды жақсы көремін, бірақ...
Dialogue: 0,0:10:31.83,0:10:35.06,Default,,0,0,0,,Мен оны ұнатпаймын
Dialogue: 0,0:10:35.16,0:10:36.26,Default,,0,0,0,,Сауда жасайық
Dialogue: 0,0:10:36.70,0:10:41.34,Default,,0,0,0,,Мен саған Д-дан құтылуға көмектесемін, енді Дайанмен сөйлеспе.
Dialogue: 0,0:10:41.64,0:10:44.14,Default,,0,0,0,,Кітап бойынша сұхбат болады.
Dialogue: 0,0:10:44.21,0:10:47.41,Default,,0,0,0,,Иә, бірақ оны ұстамаңыз.
Dialogue: 0,0:10:47.78,0:10:48.28,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:10:48.34,0:10:50.34,Default,,0,0,0,,Мен сендерді қол алысады деп ойладым.
Dialogue: 0,0:10:50.65,0:10:52.01,Default,,0,0,0,,Сәтсіз аяқталды.
Dialogue: 0,0:10:55.05,0:10:58.82,Default,,0,0,0,,Анальды тексеруден өту үшін аяқтарыңызды жайыңыз.
Dialogue: 0,0:10:59.79,0:11:02.19,Default,,0,0,0,,Жұмсақ болыңыз.
Dialogue: 0,0:11:02.96,0:11:05.69,Default,,0,0,0,,Біз жақсы араласамыз.
Dialogue: 0,0:11:05.79,0:11:08.33,Default,,0,0,0,,Сіз Клауспен сөйлесіп тұрдыңыз.
Dialogue: 0,0:11:08.40,0:11:11.37,Default,,0,0,0,,Олар жақсы жігіттер болса да.
Dialogue: 0,0:11:11.73,0:11:14.70,Default,,0,0,0,,Онда қалсаң, жерленесің.
Dialogue: 0,0:11:14.80,0:11:17.10,Default,,0,0,0,,Бірақ мен бір адам үшін алаңдаймын.
Dialogue: 0,0:11:17.17,0:11:21.38,Default,,0,0,0,,Егер сіз латын патшаларына қосылсаңыз, сіз жұлдызсыз.
Dialogue: 0,0:11:21.44,0:11:24.71,Default,,0,0,0,,Мен қазір екінші орындамын, бірақ бір күні шыңға шығамын.
Dialogue: 0,0:11:24.95,0:11:29.98,Default,,0,0,0,,Екі банданың шақыруы ғажап.
Dialogue: 0,0:11:31.29,0:11:35.99,Default,,0,0,0,,Ghostwriter мырза, мен қауесетті естідім.
Dialogue: 0,0:11:36.09,0:11:40.36,Default,,0,0,0,,Сіз бірнеше рет кездескен адамды кемсітуге қалай батылыңыз бар?
Dialogue: 0,0:11:40.46,0:11:46.37,Default,,0,0,0,,Бұл футболшының қуып келе жатқан дөрекі доп сияқты.
Dialogue: 0,0:11:46.70,0:11:48.34,Default,,0,0,0,,Фол жоқ.
Dialogue: 0,0:11:48.40,0:11:49.84,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:49.97,0:11:52.27,Default,,0,0,0,,Ал мені қуып жатқан жоқ
Dialogue: 0,0:11:52.37,0:11:55.74,Default,,0,0,0,,БоДжек сен үшін ессіз
Dialogue: 0,0:11:55.91,0:12:01.48,Default,,0,0,0,,Не?
Dialogue: 0,0:12:01.85,0:12:02.85,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:02.98,0:12:06.42,Default,,0,0,0,,Мен ақымақпын ба? Кешіріңіз, қазір үйге барыңыз
Dialogue: 0,0:12:09.16,0:12:12.26,Default,,0,0,0,,Полиция жақсы, бірақ сізге қыша керек пе?
Dialogue: 0,0:12:12.33,0:12:15.03,Default,,0,0,0,,Бұл бұрынғы түскі ас.
Dialogue: 0,0:12:15.13,0:12:16.73,Default,,0,0,0,,Оны жолдан шығарайық
Dialogue: 0,0:12:16.80,0:12:18.30,Default,,0,0,0,,Мен оны кейін жеуім мүмкін.
Dialogue: 0,0:12:18.40,0:12:23.10,Default,,0,0,0,,Мұнда D-ны қалай алуға болады деген сұрақ туындайды...
Dialogue: 0,0:12:23.27,0:12:25.87,Default,,0,0,0,,Полицияға ұсталсаң, бәлеге қаласың.
Dialogue: 0,0:12:25.94,0:12:27.74,Default,,0,0,0,,Қияр – сват
Dialogue: 0,0:12:27.81,0:12:32.41,Default,,0,0,0,,Қайтып қойғаннан гөрі, лақтырып тастау жылдамырақ, бірақ қалай...
Dialogue: 0,0:12:32.75,0:12:36.28,Default,,0,0,0,,Кофе ішкеннен кейін де шабыттанбаймын
Dialogue: 0,0:12:36.38,0:12:37.79,Default,,0,0,0,,Ішінде алкоголь бар.
Dialogue: 0,0:12:37.89,0:12:41.39,Default,,0,0,0,,Сол себепті мас екенсің бе? Мен 7 сусын іштім.
Dialogue: 0,0:12:41.52,0:12:45.03,Default,,0,0,0,,Менің ойыма ешқандай идея келмейді, бірақ мен өзімді керемет сезінемін.
Dialogue: 0,0:12:45.09,0:12:47.06,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:12:47.13,0:12:51.20,Default,,0,0,0,,Қазір сағат неше? Мен тікұшақты жылжытуым керек
Dialogue: 0,0:12:51.30,0:12:53.43,Default,,0,0,0,,Міне! Міне бітті!
Dialogue: 0,0:12:53.77,0:12:58.14,Default,,0,0,0,,Оны тікұшақпен көтеріп, теңізге лақтыр.
Dialogue: 0,0:12:58.21,0:12:59.47,Default,,0,0,0,,Жақсы идея
Dialogue: 0,0:12:59.77,0:13:01.34,Default,,0,0,0,,Теңіз, күте тұрыңыз.
Dialogue: 0,0:13:03.48,0:13:04.81,Default,,0,0,0,,Тодд не?
Dialogue: 0,0:13:05.45,0:13:08.55,Default,,0,0,0,,Егер сіз екі топпен кездесіп жүрсеңіз...
Dialogue: 0,0:13:08.92,0:13:12.09,Default,,0,0,0,,Мен төбелеске тартылдым...
Dialogue: 0,0:13:12.15,0:13:15.42,Default,,0,0,0,,``Ат дүбірі'' болғанда не болды?
Dialogue: 0,0:13:15.56,0:13:20.36,Default,,0,0,0,,Мен мұны бір рет «Жержаңғақ үйінде» жасадым.
Dialogue: 0,0:13:20.79,0:13:25.57,Default,,0,0,0,,«Менің кездесуде екі адам бар» - бұл идеяны ұсынған маған сұрақ.
Dialogue: 0,0:13:25.87,0:13:28.90,Default,,0,0,0,,Оны сәтті еткен менмін.
Dialogue: 0,0:13:29.00,0:13:31.37,Default,,0,0,0,,Ар-намысты ұрлау
Dialogue: 0,0:13:31.47,0:13:32.91,Default,,0,0,0,,Ар-намысты басып алу…
Dialogue: 0,0:13:32.97,0:13:34.51,Default,,0,0,0,,Тіпті сөздер ұрланған
Dialogue: 0,0:13:34.81,0:13:35.84,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:13:36.01,0:13:40.21,Default,,0,0,0,,Әлеуметтік жағынан мен Latin Kings жанкүйерімін, бірақ...
Dialogue: 0,0:13:40.35,0:13:43.85,Default,,0,0,0,,Қос қиылысуды тоқтатыңыз. Сіздің пікіріңіз қандай?
Dialogue: 0,0:13:44.12,0:13:45.45,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:13:46.05,0:13:49.49,Default,,0,0,0,,Түсіндім, бұл ар-намысты басып алу...
Dialogue: 0,0:13:49.82,0:13:53.09,Default,,0,0,0,,Қалай болғанда да, кепіл ақысы 50 доллар.
Dialogue: 0,0:13:53.16,0:13:55.13,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:13:55.20,0:13:56.86,Default,,0,0,0,,Енді операция басталады.
Dialogue: 0,0:13:56.93,0:13:58.10,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:13:58.17,0:14:02.94,Default,,0,0,0,,Бірақ сіз басқа жаққа қарауыңыз керек
Dialogue: 0,0:14:03.07,0:14:04.37,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:14:04.57,0:14:08.41,Default,,0,0,0,,Сауықтыру үшін тағы бір шыны кофе ішіңіз.
Dialogue: 0,0:14:12.85,0:14:14.15,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:14:14.38,0:14:16.02,Default,,0,0,0,,БАҚ мырза
Dialogue: 0,0:14:16.15,0:14:19.22,Default,,0,0,0,,Атақты адамдар қолма-қол ақша жұмсауда
Dialogue: 0,0:14:19.39,0:14:21.29,Default,,0,0,0,,үшін бірге жиналады
Dialogue: 0,0:14:21.39,0:14:23.89,Default,,0,0,0,,Бұл бар болғаны 1 доллар.
Dialogue: 0,0:14:23.99,0:14:24.99,Default,,0,0,0,,Дабыл қағуға болмайды
Dialogue: 0,0:14:25.13,0:14:28.63,Default,,0,0,0,,Бұл нақты қолма-қол ақша. Сіз бақытты емессіз бе?
Dialogue: 0,0:14:28.96,0:14:30.40,Default,,0,0,0,,Бір долларлық купюрада...
Dialogue: 0,0:14:30.46,0:14:32.87,Default,,0,0,0,,Иә, мен қолма-қол ақшаны пайдаланбаймын.
Dialogue: 0,0:14:33.00,0:14:36.57,Default,,0,0,0,,Олар қандай? Тез арада ақшаға ағылды!
Dialogue: 0,0:14:37.10,0:14:39.04,Default,,0,0,0,,Бұл жалған дабыл болған сияқты.
Dialogue: 0,0:14:40.98,0:14:43.11,Default,,0,0,0,,Мен тобығымды ұнатпаймын.
Dialogue: 0,0:14:43.41,0:14:46.91,Default,,0,0,0,,Дива Бейонсе жарақат алды.
Dialogue: 0,0:14:47.01,0:14:48.32,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:14:48.48,0:14:52.19,Default,,0,0,0,,Поп белгішесі Бейонсе—
Dialogue: 0,0:14:52.29,0:14:53.32,Default,,0,0,0,,Мен жарақат алдым
Dialogue: 0,0:14:53.42,0:14:54.42,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:14:54.52,0:14:58.33,Default,,0,0,0,,Мен «Аман қалған» әнін айтып жатырмын, сондықтан...
Dialogue: 0,0:14:58.43,0:15:01.03,Default,,0,0,0,,Сіз аман қалған сияқтысыз.
Dialogue: 0,0:15:01.16,0:15:02.00,Default,,0,0,0,,Оның себебі неде?
Dialogue: 0,0:15:02.06,0:15:04.90,Default,,0,0,0,,Сіз 1 долларлық купюраға түсіп кеткен сияқтысыз.
Dialogue: 0,0:15:04.97,0:15:05.90,Default,,0,0,0,,Бір долларлық купюра?
Dialogue: 0,0:15:05.97,0:15:06.90,Default,,0,0,0,,Иә
Dialogue: 0,0:15:06.97,0:15:07.43,Default,,0,0,0,,үшін?
Dialogue: 0,0:15:07.50,0:15:08.54,Default,,0,0,0,,Иә
Dialogue: 0,0:15:08.90,0:15:10.27,Default,,0,0,0,,Өлең сөздеріне ұқсайды
Dialogue: 0,0:15:10.57,0:15:15.34,Default,,0,0,0,,Қауіпті жақсы көретін Бейонсенің жағдайы...
Dialogue: 0,0:15:15.44,0:15:19.48,Default,,0,0,0,,Біз егжей-тегжейлерді білген бойда хабарлаймыз.
Dialogue: 0,0:15:19.65,0:15:21.95,Default,,0,0,0,,Қосымша жаңартулар үшін хабардар болыңыз
Dialogue: 0,0:15:22.32,0:15:24.35,Default,,0,0,0,,Жасаңыз.
Dialogue: 0,0:15:32.56,0:15:37.23,Default,,0,0,0,,Бейонсенің дәрігерлері оның қайтып келуіне үміт жоқ дейді...
Dialogue: 0,0:15:37.53,0:15:40.63,Default,,0,0,0,,D бойынша бақылау есебі келді.
Dialogue: 0,0:15:40.94,0:15:45.61,Default,,0,0,0,,Жержаңғақ үйінің алдындағы хабар.
Dialogue: 0,0:15:46.04,0:15:48.11,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:15:48.31,0:15:50.08,Default,,0,0,0,,үшін осында жиналды
Dialogue: 0,0:15:50.28,0:15:54.45,Default,,0,0,0,,Негізі Д-ны өзім ұрлап алдым.
Dialogue: 0,0:15:56.05,0:15:57.72,Default,,0,0,0,,Неге олай істедің?
Dialogue: 0,0:15:58.05,0:16:02.46,Default,,0,0,0,,Бұл менің дос қызым Дайанға арналған.
Dialogue: 0,0:16:04.36,0:16:06.13,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:16:06.53,0:16:08.53,Default,,0,0,0,,Ол ең жаман бейбақ.
Dialogue: 0,0:16:10.10,0:16:12.50,Default,,0,0,0,,Жержаңғақ майы –
Dialogue: 0,0:16:12.57,0:16:15.27,Default,,0,0,0,,Мен оны сүйіктім үшін ұрлағанымды мойындадым.
Dialogue: 0,0:16:15.37,0:16:18.27,Default,,0,0,0,,Қозғалыс деп мақтаған дауыс...
Dialogue: 0,0:16:18.37,0:16:20.14,Default,,0,0,0,,Толып кету
Dialogue: 0,0:16:20.24,0:16:21.68,Default,,0,0,0,,Қалалық полицияның хабарламасы
Dialogue: 0,0:16:21.98,0:16:23.41,Default,,0,0,0,,Егер ол жазаланса -
Dialogue: 0,0:16:23.51,0:16:26.25,Default,,0,0,0,,Мен төсбелгімді шешемін
Dialogue: 0,0:16:28.08,0:16:30.65,Default,,0,0,0,,Қызығушылық танытқан адам: Дайан.
Dialogue: 0,0:16:31.12,0:16:33.29,Default,,0,0,0,,Дайан, бұл керемет.
Dialogue: 0,0:16:33.39,0:16:37.56,Default,,0,0,0,,Маған бәрібір, бірақ тым көп емес пе?
Dialogue: 0,0:16:37.69,0:16:39.49,Default,,0,0,0,,Мен камералармен жақсы емеспін.
Dialogue: 0,0:16:39.56,0:16:44.63,Default,,0,0,0,,Айтпақшы, сізге кім ұнайды?
Dialogue: 0,0:16:44.70,0:16:46.67,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:16:49.60,0:16:51.44,Default,,0,0,0,,«Гаррю түрмесі»
Dialogue: 0,0:16:54.27,0:16:56.44,Default,,0,0,0,,Тодд
Dialogue: 0,0:16:56.51,0:16:59.55,Default,,0,0,0,,Бұл сізге өте жарасады
Dialogue: 0,0:16:59.68,0:17:03.05,Default,,0,0,0,,Күзетші маған оны кигізді.
Dialogue: 0,0:17:03.12,0:17:06.52,Default,,0,0,0,,Бірақ ол сізге күзгі жапырақтар сияқты жарасады.
Dialogue: 0,0:17:09.02,0:17:10.32,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:17:12.43,0:17:14.03,Default,,0,0,0,,Бұл Сантьяго.
Dialogue: 0,0:17:14.09,0:17:18.03,Default,,0,0,0,,Кешіріңіз, мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:17:18.47,0:17:19.47,Default,,0,0,0,,Әй, не?
Dialogue: 0,0:17:19.57,0:17:25.04,Default,,0,0,0,,Кешіріңіз, мен Энн сияқты жасырынған жоқпын.
Dialogue: 0,0:17:26.21,0:17:26.71,Default,,0,0,0,,Сақ бол.
Dialogue: 0,0:17:28.44,0:17:34.05,Default,,0,0,0,,Мені бір жігіт екі рет алдап кетті.
Dialogue: 0,0:17:34.18,0:17:38.05,Default,,0,0,0,,Сен нені айтып тұрсың?
Dialogue: 0,0:17:38.19,0:17:43.46,Default,,0,0,0,,Жержаңғақ майы менің Д-ді ұрлады.
Dialogue: 0,0:17:43.59,0:17:45.49,Default,,0,0,0,,Бұл оқиға?
Dialogue: 0,0:17:45.83,0:17:46.73,Default,,0,0,0,,Каранэс ауданына оралу.
Dialogue: 0,0:17:47.19,0:17:52.37,Default,,0,0,0,,Ол сценарийіңізге жақсырақ сәйкес келеді.
Dialogue: 0,0:17:52.47,0:17:53.10,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:17:53.20,0:17:57.07,Default,,0,0,0,,Боджак мас күйінде Д. ұрлық жасайды.
Dialogue: 0,0:17:57.14,0:18:01.78,Default,,0,0,0,,Сыйлық – жержаңғақ майы.
Dialogue: 0,0:18:02.18,0:18:05.35,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:18:05.48,0:18:08.65,Default,,0,0,0,,Бұл фильмге түсіруге болатын әсерлі оқиға.
Dialogue: 0,0:18:08.75,0:18:10.38,Default,,0,0,0,,Жаман емес.
Dialogue: 0,0:18:10.48,0:18:12.79,Default,,0,0,0,,Лаура Құқықтарды тексеріңіз.
Dialogue: 0,0:18:13.09,0:18:14.32,Default,,0,0,0,,Менің оқиғам қандай?
Dialogue: 0,0:18:14.42,0:18:17.72,Default,,0,0,0,,Мен сіздің D ұрлап алғаным қорқынышты, бірақ...
Dialogue: 0,0:18:17.79,0:18:20.39,Default,,0,0,0,,Өз сезімін білдірді
Dialogue: 0,0:18:20.46,0:18:23.23,Default,,0,0,0,,Бірақ сен маған айтқан жоқсың
Dialogue: 0,0:18:23.36,0:18:25.23,Default,,0,0,0,,Мен де айта аламын
Dialogue: 0,0:18:26.13,0:18:28.50,Default,,0,0,0,,Мен денемде де, ойымда да ештеңе сезбеймін.
Dialogue: 0,0:18:29.47,0:18:34.11,Default,,0,0,0,,Егер Кейт Гитлердің ханымын ойнаса, оны көрер ме едіңіз?
Dialogue: 0,0:18:34.24,0:18:37.28,Default,,0,0,0,,Сіз оны міндетті түрде көресіз.
Dialogue: 0,0:18:41.15,0:18:45.22,Default,,0,0,0,,Гитлердің ханымы – «бесінші Битл»
Dialogue: 0,0:18:45.29,0:18:50.69,Default,,0,0,0,,Неонацистер нацизмге қызығушылық танытады, солай ма?
Dialogue: 0,0:18:51.53,0:18:56.56,Default,,0,0,0,,Бұл ақ түсті би. Бұны ұнатамын.
Dialogue: 0,0:18:56.73,0:19:02.24,Default,,0,0,0,,Кешіріңіз, мен шахмат фигураларымды ұмытып қалдым.
Dialogue: 0,0:19:02.54,0:19:03.44,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:19:03.60,0:19:08.64,Default,,0,0,0,,Басқа бандаға қосылғаныңызға қуаныштымын.
Dialogue: 0,0:19:10.81,0:19:13.58,Default,,0,0,0,,Онда мен сені өлтіремін
Dialogue: 0,0:19:19.35,0:19:22.79,Default,,0,0,0,,Күн тәртібін өзгерту қате болды.
Dialogue: 0,0:19:22.86,0:19:25.53,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:19:25.69,0:19:28.60,Default,,0,0,0,,Ол сенің жүрегіңді ұрлады
Dialogue: 0,0:19:28.70,0:19:33.17,Default,,0,0,0,,Бірақ мен оның шынымен ұрланғанын білмеймін.
Dialogue: 0,0:19:33.30,0:19:37.80,Default,,0,0,0,,Оның әдістері сізге сәйкес келмейді.
Dialogue: 0,0:19:37.87,0:19:39.74,Default,,0,0,0,,Қандай әдіс?
Dialogue: 0,0:19:40.21,0:19:43.88,Default,,0,0,0,,Мен сені жиі ойлайтынмын.
Dialogue: 0,0:19:43.94,0:19:47.45,Default,,0,0,0,,Сізге ұнауы мүмкін әндер жинақталуда...
Dialogue: 0,0:19:47.61,0:19:52.35,Default,,0,0,0,,Бөлме гүлін беру немесе өз альбомын жасау.
Dialogue: 0,0:19:52.45,0:19:55.49,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:19:55.62,0:19:56.72,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:56.86,0:19:59.76,Default,,0,0,0,,Сізді көбірек түсінетін адаммен бірге болуыңыз керек.
Dialogue: 0,0:19:59.83,0:20:01.70,Default,,0,0,0,,Мысалы, кім?
Dialogue: 0,0:20:02.60,0:20:03.50,Default,,0,0,0,,Жарық жасыл, Ято-сан.
Dialogue: 0,0:20:03.83,0:20:06.37,Default,,0,0,0,,Сіз оны дәл қазір жаздыңыз ба?
Dialogue: 0,0:20:06.73,0:20:09.64,Default,,0,0,0,,Эндидің әңгімесін тыңдағыңыз келе ме?
Dialogue: 0,0:20:11.74,0:20:15.34,Default,,0,0,0,,Маржа ұрланған тауардың 10 пайызын құрайды.
Dialogue: 0,0:20:15.41,0:20:18.78,Default,,0,0,0,,Есірткі және темекі, қалыпты мөлшерлеме.
Dialogue: 0,0:20:18.88,0:20:20.61,Default,,0,0,0,,Мен қазір кетуім керек.
Dialogue: 0,0:20:20.98,0:20:24.65,Default,,0,0,0,,Негізі... түрме туралы...
Dialogue: 0,0:20:24.72,0:20:27.79,Default,,0,0,0,,Біз түрмеде жатырмыз.
Dialogue: 0,0:20:30.42,0:20:33.66,Default,,0,0,0,,Банзай ақ адам!
Dialogue: 0,0:20:33.76,0:20:38.93,Default,,0,0,0,,Латын патшалары сияқты бандана кию
Dialogue: 0,0:20:39.50,0:20:41.34,Default,,0,0,0,,Айыры болды, солай емес пе?
Dialogue: 0,0:20:41.40,0:20:45.61,Default,,0,0,0,,Маған екеуі де ұнайды, сондықтан таңдай алмаймын.
Dialogue: 0,0:20:45.67,0:20:50.68,Default,,0,0,0,,Бір-бірімізді түсінуге тырысуымыз керек емес пе?
Dialogue: 0,0:20:50.78,0:20:54.51,Default,,0,0,0,,Онда бөлудің қажеті жоқ.
Dialogue: 0,0:20:54.58,0:20:58.42,Default,,0,0,0,,Біз бәріміз де адамбыз және тіршілік иесіміз.
Dialogue: 0,0:20:58.79,0:20:59.89,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:21:00.25,0:21:05.43,Default,,0,0,0,,Түрмедегі жанжалдар нәсілдік мәселелерге ұласады
Dialogue: 0,0:21:05.53,0:21:06.43,Default,,0,0,0,,Бұған дейін—
Dialogue: 0,0:21:06.49,0:21:10.83,Default,,0,0,0,,Жержаңғақ майы мен Дайанның жалғасы
Dialogue: 0,0:21:15.50,0:21:15.94,Default,,0,0,0,,«Боджак»
Dialogue: 0,0:21:16.00,0:21:18.31,Default,,0,0,0,,Дайан? Қайтадан қош келдіңіз
Dialogue: 0,0:21:20.87,0:21:23.38,Default,,0,0,0,,Дайан... бұл менмін.
Dialogue: 0,0:21:24.54,0:21:27.31,Default,,0,0,0,,Ертеңгі оқиғаны растау үшін.
Dialogue: 0,0:21:27.41,0:21:31.82,Default,,0,0,0,,Бұл Мариса Томейге түшкіру туралы әңгіме, солай емес пе?
Dialogue: 0,0:21:32.02,0:21:36.46,Default,,0,0,0,,Кешіріңіз, мен Д-мен тым алыс кеттім.
Dialogue: 0,0:21:36.82,0:21:38.66,Default,,0,0,0,,Мен мұны сізге тағы да беремін
Dialogue: 0,0:21:39.76,0:21:44.60,Default,,0,0,0,,Сондай-ақ, кітап жазғаныңыз үшін рахмет.
Dialogue: 0,0:21:46.00,0:21:51.61,Default,,0,0,0,,Менің шамадан тыс әрекеттерім - мен сені сүйгендіктен
Dialogue: 0,0:21:51.84,0:21:53.61,Default,,0,0,0,,Мен сені ұстағым келеді
Dialogue: 0,0:21:53.97,0:21:56.48,Default,,0,0,0,,Мен ұстағанды жақсы көремін
Dialogue: 0,0:21:56.64,0:21:58.01,Default,,0,0,0,,Бұл өте нашар болды.
Dialogue: 0,0:21:58.68,0:22:03.02,Default,,0,0,0,,Мен өзім туралы терең білгім келеді.
Dialogue: 0,0:22:03.58,0:22:05.49,Default,,0,0,0,,Мен бұған жақсы емеспін
Dialogue: 0,0:22:05.59,0:22:07.72,Default,,0,0,0,,Себебі сен мені танисың...
Dialogue: 0,0:22:07.85,0:22:11.63,Default,,0,0,0,,Олар ең жақсы жұп, өйткені олар әртүрлі.
Dialogue: 0,0:22:11.86,0:22:13.56,Default,,0,0,0,,Егер сіз шоколад болсаңыз...
Dialogue: 0,0:22:13.63,0:22:14.43,Default,,0,0,0,,Жержаңғақ майы?
Dialogue: 0,0:22:14.49,0:22:18.00,Default,,0,0,0,,Мен сәбіз айтайын деп едім.
Dialogue: 0,0:22:18.50,0:22:19.90,Default,,0,0,0,,Сары май жақсы
Dialogue: 0,0:22:21.00,0:22:25.91,Default,,0,0,0,,Мен мінсіз адам емеспін және осы үшін өзімді жек көремін.
Dialogue: 0,0:22:26.01,0:22:30.38,Default,,0,0,0,,Бірақ қасыңда болсам, сені онша жек көрмеймін
Dialogue: 0,0:22:30.48,0:22:32.65,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:22:32.75,0:22:36.92,Default,,0,0,0,,Мен сенімен көбірек сөйлескім келеді.
Dialogue: 0,0:22:37.02,0:22:40.39,Default,,0,0,0,,Дайан, менің маңызды сұрағым бар.
Dialogue: 0,0:22:40.65,0:22:43.12,Default,,0,0,0,,Камера немесе жинақ жоқ
Dialogue: 0,0:22:43.66,0:22:45.66,Default,,0,0,0,,Тек мен және сен
Dialogue: 0,0:22:46.09,0:22:47.03,Default,,0,0,0,,Маған қоңырау шалыңыз
Dialogue: 0,0:22:47.49,0:22:50.66,Default,,0,0,0,,Бұл БоДжек, мен сені күтемін.
Dialogue: 0,0:22:50.76,0:22:55.77,Default,,0,0,0,,Сіз миссис жаңғақшы бола аласыз ба?
Dialogue: 0,0:22:56.50,0:22:59.61,Default,,0,0,0,,Маған әлі ерте сияқты...
Dialogue: 0,0:23:00.61,0:23:02.41,Default,,0,0,0,,Мен үйленемін
Dialogue: 0,0:23:02.74,0:23:03.91,Default,,0,0,0,,Ерлі-зайыптылардың жеке фамилиялары
Dialogue: 0,0:23:03.98,0:23:06.95,Default,,0,0,0,,Сіз естідіңіз бе? Ұсыныс сәтті болды
Dialogue: 0,0:23:07.05,0:23:11.55,Default,,0,0,0,,Бұл кеш, Эрика, мұнда кел.
Dialogue: 0,0:23:15.39,0:23:18.09,Default,,0,0,0,,Телефон жоқ, скотчта жұбаныш
Dialogue: 0,0:23:18.76,0:23:19.53,Default,,0,0,0,,«Диана»
Dialogue: 0,0:23:19.66,0:23:21.16,Default,,0,0,0,,Бұл мереке!
Dialogue: 0,0:23:21.43,0:23:21.83,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:23:21.93,0:23:23.16,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:23:23.43,0:23:24.77,Default,,0,0,0,,Мен көптен күттім.
Dialogue: 0,0:23:24.90,0:23:27.97,Default,,0,0,0,,Білесіз бе, біртүрлі нәрсе болды...
Dialogue: 0,0:23:28.54,0:23:30.10,Default,,0,0,0,,Келісілгенсіз бе?
Dialogue: 0,0:23:31.47,0:23:34.91,Default,,0,0,0,,Жержаңғақ майымен?
Dialogue: 0,0:23:36.41,0:23:37.58,Default,,0,0,0,,Дауыстық пошта бар, бірақ...
Dialogue: 0,0:23:37.68,0:23:40.71,Default,,0,0,0,,Ішімдік
Dialogue: 0,0:23:40.88,0:23:44.85,Default,,0,0,0,,Мен қайтуым керек D. Ертең кездескенше.
Dialogue: 0,0:23:45.52,0:23:46.92,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:23:49.66,0:23:52.59,Default,,0,0,0,,Мені бәрінен де жақсы түсінетін сенсің.
Dialogue: 0,0:23:55.80,0:24:00.43,Default,,0,0,0,,Мен сені Кандагар операциясынан үйге жіберемін.
Dialogue: 0,0:24:00.50,0:24:01.87,Default,,0,0,0,,Бұл оңай тапсырма.
Dialogue: 0,0:24:03.64,0:24:04.81,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:24:04.91,0:24:07.61,Default,,0,0,0,,Қара сұңқар құлады!
Dialogue: 0,0:24:07.97,0:24:10.61,Default,,0,0,0,,Басқаша емес, солай емес пе?
Dialogue: 0,0:24:16.58,0:24:18.89,Default,,0,0,0,,Мен мұны істедім, мен боспын.
Dialogue: 0,0:24:18.99,0:24:21.76,Default,,0,0,0,,Бостандық, еркіндік.
Dialogue: 0,0:24:22.06,0:24:25.49,Default,,0,0,0,,Бұл өтірік. Бұл үлкен сюжеттік бұрылыс.
Dialogue: 0,0:24:25.69,0:24:28.96,Default,,0,0,0,,Голливудтың идеялары таусылып жатқан жоқ па?
Dialogue: 0,0:24:30.46,0:24:36.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
