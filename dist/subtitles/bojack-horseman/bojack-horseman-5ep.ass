Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.74,Default,,0,0,0,,NETFLIX түпнұсқа жұмысы
Dialogue: 0,0:00:08.04,0:00:11.61,Default,,0,0,0,,«Эйр Буд халықаралық әуежайы»
Dialogue: 0,0:00:15.21,0:00:17.35,Default,,0,0,0,,Ой, менің ойымша, бұл осыған байланысты.
Dialogue: 0,0:00:17.48,0:00:19.35,Default,,0,0,0,,Тезірек жүр, бейбақ.
Dialogue: 0,0:00:19.48,0:00:21.28,Default,,0,0,0,,Ол жұмыста, оны айыптамаңыз.
Dialogue: 0,0:00:21.45,0:00:22.78,Default,,0,0,0,,Бұл сенің кінәң.
Dialogue: 0,0:00:23.05,0:00:25.05,Default,,0,0,0,,Сұйықтықтың сыйымдылығы асып кетті
Dialogue: 0,0:00:25.12,0:00:27.16,Default,,0,0,0,,Бұл Паппи Ван Винкл
Dialogue: 0,0:00:27.32,0:00:28.62,Default,,0,0,0,,Бұл винтаждық бурбон.
Dialogue: 0,0:00:28.72,0:00:32.49,Default,,0,0,0,,Мен ішсем, тіпті жыныстық қатынасқа түсе алмаймын.
Dialogue: 0,0:00:32.59,0:00:33.36,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:00:33.46,0:00:34.73,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:00:35.56,0:00:40.77,Default,,0,0,0,,Ол Нью-Йорктегі баспагермен кездесуге шақ қалған атақты адам.
Dialogue: 0,0:00:41.07,0:00:45.37,Default,,0,0,0,,Мен өз өмірбаянымды шығарғым келеді.
Dialogue: 0,0:00:45.47,0:00:46.17,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:00:46.27,0:00:47.64,Default,,0,0,0,,Сіз кедергі келтіргіңіз келе ме?
Dialogue: 0,0:00:50.75,0:00:53.45,Default,,0,0,0,,Дайан Күт, бұл жігіттің басы тас.
Dialogue: 0,0:00:53.75,0:00:54.52,Default,,0,0,0,,Дайан?
Dialogue: 0,0:00:55.15,0:00:55.58,Default,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:00:55.68,0:00:56.65,Default,,0,0,0,,Міне, БоДжек.
Dialogue: 0,0:00:56.72,0:00:57.62,Default,,0,0,0,,Оңай өтті.
Dialogue: 0,0:00:58.05,0:01:01.52,Default,,0,0,0,,Тек 10 жыл бойы қолданылып келе жатқан ережелерді сақтау.
Dialogue: 0,0:01:01.62,0:01:02.46,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:02.52,0:01:04.13,Default,,0,0,0,,Кім болсаң да...
Dialogue: 0,0:01:04.23,0:01:06.59,Default,,0,0,0,,Сіз менің бағдарламам туралы білмейсіз бе?
Dialogue: 0,0:01:06.73,0:01:08.06,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:01:08.13,0:01:10.67,Default,,0,0,0,,Маған Нью-Йоркке баруға рұқсат етіңіз.
Dialogue: 0,0:01:12.13,0:01:13.47,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:01:14.24,0:01:15.47,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:01:15.80,0:01:17.21,Default,,0,0,0,,Менде мылтық бар
Dialogue: 0,0:01:17.31,0:01:18.67,Default,,0,0,0,,Жоқ, бұл жазушы.
Dialogue: 0,0:01:19.64,0:01:21.54,Default,,0,0,0,,Жеңіл май себеп пе?
Dialogue: 0,0:01:21.61,0:01:24.21,Default,,0,0,0,,Сабыр ет, мен атақтымын.
Dialogue: 0,0:01:24.55,0:01:26.68,Default,,0,0,0,,Жолаушы денесін тексеру
Dialogue: 0,0:02:18.17,0:02:21.74,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:02:22.34,0:02:23.67,Default,,0,0,0,,«электрондық баспагер»
Dialogue: 0,0:02:25.91,0:02:26.88,Default,,0,0,0,,...
Dialogue: 0,0:02:27.14,0:02:28.74,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:02:28.84,0:02:31.21,Default,,0,0,0,,Калифорнияда болмаған дұрыс
Dialogue: 0,0:02:31.28,0:02:33.31,Default,,0,0,0,,Мен оны қауіпсіз деп ойладым.
Dialogue: 0,0:02:33.45,0:02:35.58,Default,,0,0,0,,Қоршаған ортаны өзгерту жақсы
Dialogue: 0,0:02:35.72,0:02:37.82,Default,,0,0,0,,Мұнда да ауа жақсы.
Dialogue: 0,0:02:37.89,0:02:39.72,Default,,0,0,0,,Ісік табылды.
Dialogue: 0,0:02:40.32,0:02:42.62,Default,,0,0,0,,Бірақ егер Аттының өмірбаяны жарияланса...
Dialogue: 0,0:02:42.72,0:02:45.76,Default,,0,0,0,,Медициналық шығындар туралы алаңдамау керек сияқты.
Dialogue: 0,0:02:45.86,0:02:47.30,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:02:47.43,0:02:48.23,Default,,0,0,0,,Жақсы жүріп жатыр.
Dialogue: 0,0:02:48.30,0:02:51.77,Default,,0,0,0,,Сахна артындағы көптеген оқиғалар мен әсерлі оқиғалар
Dialogue: 0,0:02:51.83,0:02:54.37,Default,,0,0,0,,Ол тамаша жазушы.
Dialogue: 0,0:02:54.44,0:02:55.70,Default,,0,0,0,,Бұл телефон қоңырауы.
Dialogue: 0,0:02:55.77,0:02:58.77,Default,,0,0,0,,Қоғамдық радиоға жазылғаныңыз үшін рахмет.
Dialogue: 0,0:02:58.91,0:03:02.51,Default,,0,0,0,,Бұл телефон қоңырауы оқиғаның басталғанын білдіреді...
Dialogue: 0,0:03:02.58,0:03:03.44,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:03:03.75,0:03:05.65,Default,,0,0,0,,Енді қайт, танымал қыз.
Dialogue: 0,0:03:05.88,0:03:07.25,Default,,0,0,0,,Ол мұны істей алмайды.
Dialogue: 0,0:03:07.38,0:03:09.32,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:09.42,0:03:10.39,Default,,0,0,0,,Тым жақсы
Dialogue: 0,0:03:10.45,0:03:13.39,Default,,0,0,0,,Менің ерекше өмірім туралы жазу үшін—
Dialogue: 0,0:03:13.45,0:03:15.52,Default,,0,0,0,,Сәл тым қалыпты
Dialogue: 0,0:03:15.62,0:03:18.76,Default,,0,0,0,,Солай ма? Кешіріңіз.
Dialogue: 0,0:03:18.83,0:03:21.80,Default,,0,0,0,,Оның орнына сұмдық жазушы туралы айтайық...
Dialogue: 0,0:03:21.86,0:03:23.80,Default,,0,0,0,,әзіл емес!
Dialogue: 0,0:03:23.90,0:03:25.77,Default,,0,0,0,,Жағдайды түсінесің бе?
Dialogue: 0,0:03:25.90,0:03:26.67,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:26.77,0:03:28.54,Default,,0,0,0,,Кітап қазан айында шығады.
Dialogue: 0,0:03:28.64,0:03:31.81,Default,,0,0,0,,Маған ол жынды сияқты сатылады деп уәде беріңізші.
Dialogue: 0,0:03:31.91,0:03:33.54,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:03:35.48,0:03:36.95,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:03:37.51,0:03:38.41,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:03:38.51,0:03:42.38,Default,,0,0,0,,Кітапханадан ерте қайтқаныңыз үшін алғыс білдірген телефон қоңырауы ма?
Dialogue: 0,0:03:42.48,0:03:44.22,Default,,0,0,0,,Ағам әкемнің қайтыс болғанын айтты.
Dialogue: 0,0:03:44.35,0:03:45.25,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:03:45.39,0:03:47.66,Default,,0,0,0,,Кітап қыркүйек айының соңында шығады, солай ма?
Dialogue: 0,0:03:47.79,0:03:49.22,Default,,0,0,0,,Мен өзімді өте нашар сезінемін.
Dialogue: 0,0:03:49.36,0:03:50.83,Default,,0,0,0,,Бұл ең нашар болды.
Dialogue: 0,0:03:50.96,0:03:52.29,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:52.36,0:03:54.00,Default,,0,0,0,,Осы уақытқа дейін бәрі жақсы болды.
Dialogue: 0,0:03:54.80,0:03:56.80,Default,,0,0,0,,Уақытында жеткізіледі ме?
Dialogue: 0,0:03:57.23,0:04:00.57,Default,,0,0,0,,Уайымдама, мен жерлеуге барамын, тез келемін.
Dialogue: 0,0:04:00.74,0:04:03.44,Default,,0,0,0,,БоДжек де келуі керек.
Dialogue: 0,0:04:03.50,0:04:05.91,Default,,0,0,0,,Жол жүру уақытын да жазуға болады.
Dialogue: 0,0:04:06.41,0:04:08.38,Default,,0,0,0,,Жарайды, егер сізге бірдеңе керек болса, маған хабарласыңыз.
Dialogue: 0,0:04:08.44,0:04:09.84,Default,,0,0,0,,Бір қоңыраумен оралу
Dialogue: 0,0:04:09.94,0:04:13.38,Default,,0,0,0,,Мен қазір телефон кабинасында тұрамын.
Dialogue: 0,0:04:14.68,0:04:18.99,Default,,0,0,0,,Жұмыртқаға бата
Dialogue: 0,0:04:19.25,0:04:21.42,Default,,0,0,0,,Қуырылған жұмыртқаны араластырыңыз.
Dialogue: 0,0:04:21.49,0:04:24.56,Default,,0,0,0,,Тодд, хум, ән айтпа.
Dialogue: 0,0:04:24.63,0:04:25.26,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:04:25.33,0:04:28.86,Default,,0,0,0,,Бұл кім? Бұл сіз оқып жатқан жадынама.
Dialogue: 0,0:04:28.96,0:04:32.83,Default,,0,0,0,,Сіз оқып жатқандықтан, менің дауысымды естисіз
Dialogue: 0,0:04:33.30,0:04:34.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:34.27,0:04:38.67,Default,,0,0,0,,Мен сені үйде қалдырмауым керек еді.
Dialogue: 0,0:04:38.77,0:04:41.48,Default,,0,0,0,,Сізге жұмыс жоқ
Dialogue: 0,0:04:41.71,0:04:43.61,Default,,0,0,0,,Ештеңеге қол тигізбе, әбігерге салма
Dialogue: 0,0:04:43.68,0:04:45.75,Default,,0,0,0,,Ертең мен қайтып келгенше...
Dialogue: 0,0:04:45.85,0:04:46.58,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:04:46.65,0:04:47.38,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:04:47.45,0:04:48.28,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:04:53.32,0:04:55.36,Default,,0,0,0,,Кеш болды, көңіл көтерейік
Dialogue: 0,0:05:00.86,0:05:03.36,Default,,0,0,0,,Ваннаға сәлем
Dialogue: 0,0:05:04.73,0:05:08.50,Default,,0,0,0,,«Күлкілі Тодд, мен сен және мен екенімізге қуаныштымын».
Dialogue: 0,0:05:11.61,0:05:14.31,Default,,0,0,0,,Мен керемет сиқыршымын
Dialogue: 0,0:05:14.38,0:05:18.48,Default,,0,0,0,,Бұл үйде тұратын адам ерекше актер.
Dialogue: 0,0:05:18.58,0:05:21.78,Default,,0,0,0,,Дэвид Бореаназды бәрі біледі.
Dialogue: 0,0:05:23.35,0:05:26.89,Default,,0,0,0,,«Қызығушылық танытқан адамда» пайда болды
Dialogue: 0,0:05:27.32,0:05:28.52,Default,,0,0,0,,«Құлып»…
Dialogue: 0,0:05:28.76,0:05:30.33,Default,,0,0,0,,т.б.
Dialogue: 0,0:05:30.69,0:05:32.66,Default,,0,0,0,,Кешіріңіз, бірақ бұл жерде бәрі басқаша.
Dialogue: 0,0:05:34.40,0:05:35.53,Default,,0,0,0,,Оның үйінде
Dialogue: 0,0:05:35.60,0:05:39.40,Default,,0,0,0,,Мен оны көру үшін 50 доллар төлеген болар едім.
Dialogue: 0,0:05:39.50,0:05:40.94,Default,,0,0,0,,Хью Джекманның американдық нұсқасы
Dialogue: 0,0:05:41.37,0:05:42.34,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:05:42.44,0:05:43.77,Default,,0,0,0,,Сондай-ақ, «Жану туралы ескертуде»
Dialogue: 0,0:05:43.84,0:05:45.61,Default,,0,0,0,,Тіпті $50?
Dialogue: 0,0:05:45.67,0:05:47.41,Default,,0,0,0,,Содан кейін кіріңіз.
Dialogue: 0,0:05:47.51,0:05:49.94,Default,,0,0,0,,Бұл Бореаназдың үйі!
Dialogue: 0,0:05:51.45,0:05:52.91,Default,,0,0,0,,«Бостонға қош келдіңіз»
Dialogue: 0,0:05:52.98,0:05:55.72,Default,,0,0,0,,Мен сізге көмектескім келеді, бірақ...
Dialogue: 0,0:05:55.78,0:05:59.09,Default,,0,0,0,,Жаназа, жанұя... Мен адамдарға жақсы емеспін.
Dialogue: 0,0:05:59.42,0:06:02.82,Default,,0,0,0,,Көлікте күткен дұрыс.
Dialogue: 0,0:06:02.89,0:06:04.89,Default,,0,0,0,,Менің ағам ең жаман
Dialogue: 0,0:06:04.99,0:06:06.83,Default,,0,0,0,,Ағайындылардың болғаны қандай жақсы.
Dialogue: 0,0:06:06.89,0:06:10.67,Default,,0,0,0,,Біз күнде футбол ойнаймыз, бір-бірімізбен ойнаймыз.
Dialogue: 0,0:06:10.73,0:06:13.50,Default,,0,0,0,,Жалғыз бала болу – жалғыздық.
Dialogue: 0,0:06:14.07,0:06:16.70,Default,,0,0,0,,Әке, қиялдағы досыңызбен кездескіңіз келе ме?
Dialogue: 0,0:06:16.77,0:06:18.01,Default,,0,0,0,,«Қиялдағы достар» —
Dialogue: 0,0:06:18.07,0:06:21.11,Default,,0,0,0,,Ақаның бар екенін айтатын адам.
Dialogue: 0,0:06:21.41,0:06:23.98,Default,,0,0,0,,Қабырғаға басыңды соғып, есін жисаң...
Dialogue: 0,0:06:24.05,0:06:25.71,Default,,0,0,0,,Сол досы да жоғалып кетеді
Dialogue: 0,0:06:25.78,0:06:26.85,Default,,0,0,0,,Мен аламын
Dialogue: 0,0:06:27.01,0:06:29.38,Default,,0,0,0,,Мен де жалғыз қалдым
Dialogue: 0,0:06:29.48,0:06:32.12,Default,,0,0,0,,Отбасыммен болсам да аяныштымын.
Dialogue: 0,0:06:32.45,0:06:33.79,Default,,0,0,0,,Шаштың түсі басқа сен жалғызсың ба?
Dialogue: 0,0:06:33.89,0:06:35.72,Default,,0,0,0,,Айырмашылығы – менің асырап алған ұлым Гари.
Dialogue: 0,0:06:35.79,0:06:39.46,Default,,0,0,0,,Мені әсіресе әкем жек көретін.
Dialogue: 0,0:06:39.69,0:06:42.96,Default,,0,0,0,,«Мен әкеммен төбедегі жұлдыздарға қарадым»...
Dialogue: 0,0:06:43.03,0:06:46.97,Default,,0,0,0,,Бұл сіздің жүрегіңізді ашу үшін ойдан шығарылған әңгіме.
Dialogue: 0,0:06:47.03,0:06:48.80,Default,,0,0,0,,Бұл жазудың ерекше дағдысы.
Dialogue: 0,0:06:48.94,0:06:52.61,Default,,0,0,0,,Алданып қалып, ренжіп қалғандай кейіп таныту? Бұл менің ерекше шеберлігім.
Dialogue: 0,0:06:52.71,0:06:54.58,Default,,0,0,0,,Іс жүзінде қоқыс үйіндісінде -
Dialogue: 0,0:06:54.64,0:06:57.85,Default,,0,0,0,,Мен Клинтонның қызы болуды армандадым
Dialogue: 0,0:06:57.95,0:06:59.08,Default,,0,0,0,,Маған бұйра шаш ұнамайды
Dialogue: 0,0:06:59.15,0:07:00.58,Default,,0,0,0,,Сіздің шашыңыз сапалы.
Dialogue: 0,0:07:00.65,0:07:01.48,Default,,0,0,0,,Иә
Dialogue: 0,0:07:04.72,0:07:05.79,Default,,0,0,0,,Келу
Dialogue: 0,0:07:05.85,0:07:08.49,Default,,0,0,0,,Мен жай ғана сәлем беремін.
Dialogue: 0,0:07:08.69,0:07:10.16,Default,,0,0,0,,10 минут, күте тұрыңыз.
Dialogue: 0,0:07:10.43,0:07:12.69,Default,,0,0,0,,Оны уақытты жою үшін пайдаланыңыз
Dialogue: 0,0:07:12.79,0:07:14.63,Default,,0,0,0,,Калейдоскоп?
Dialogue: 0,0:07:14.80,0:07:15.70,Default,,0,0,0,,Бала емес
Dialogue: 0,0:07:15.76,0:07:18.50,Default,,0,0,0,,Ғажайып... жылтырдың барлық түрі
Dialogue: 0,0:07:19.43,0:07:20.44,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:07:21.54,0:07:23.70,Default,,0,0,0,,Ди Ди, сені көргеніме қуаныштымын.
Dialogue: 0,0:07:24.07,0:07:25.51,Default,,0,0,0,,Гари Марти Арти
Dialogue: 0,0:07:25.61,0:07:26.71,Default,,0,0,0,,Бұл Ди Ди
Dialogue: 0,0:07:26.87,0:07:29.78,Default,,0,0,0,,Нашар Жақсы сәйкестік Қалайсың?
Dialogue: 0,0:07:29.88,0:07:32.71,Default,,0,0,0,,Бұл 1986 жылғы ойынды 100-ші рет көруім.
Dialogue: 0,0:07:32.81,0:07:34.72,Default,,0,0,0,,«Бакнердің қателігінен көңілі қалды»…
Dialogue: 0,0:07:34.82,0:07:36.12,Default,,0,0,0,,Бұл 100-ші рет.
Dialogue: 0,0:07:36.22,0:07:38.02,Default,,0,0,0,,Қайтып келдің бе, Ди Ди?
Dialogue: 0,0:07:38.15,0:07:39.65,Default,,0,0,0,,Менің әкем қайтыс болды.
Dialogue: 0,0:07:39.79,0:07:43.86,Default,,0,0,0,,Бұлай өлу шынымен аянышты.
Dialogue: 0,0:07:43.96,0:07:45.13,Default,,0,0,0,,Маған сыра беріңізші
Dialogue: 0,0:07:45.23,0:07:46.53,Default,,0,0,0,,Мен де
Dialogue: 0,0:07:46.59,0:07:48.66,Default,,0,0,0,,Мен жаңа ғана келдім.
Dialogue: 0,0:07:49.70,0:07:53.13,Default,,0,0,0,,Дайан ханшайым қызметші емес пе?
Dialogue: 0,0:07:53.50,0:07:55.80,Default,,0,0,0,,Мама, бізге сирек қонақ келді.
Dialogue: 0,0:07:55.90,0:07:57.94,Default,,0,0,0,,О, қош келдіңіз.
Dialogue: 0,0:07:58.14,0:08:00.61,Default,,0,0,0,,Кім келді деп ойладым...
Dialogue: 0,0:08:00.78,0:08:03.51,Default,,0,0,0,,Ди Ди патшайым осында.
Dialogue: 0,0:08:03.64,0:08:05.51,Default,,0,0,0,,Қандай жел соғады?
Dialogue: 0,0:08:05.65,0:08:07.22,Default,,0,0,0,,Көңіл айтуыңызды өтінемін.
Dialogue: 0,0:08:07.55,0:08:08.75,Default,,0,0,0,,Иә
Dialogue: 0,0:08:08.85,0:08:11.62,Default,,0,0,0,,Көптен бері сізден хабар жоқ.
Dialogue: 0,0:08:11.72,0:08:14.89,Default,,0,0,0,,Қайғылы отбасын жұбатуға тырысасыз ба?
Dialogue: 0,0:08:15.02,0:08:15.76,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:08:15.86,0:08:17.83,Default,,0,0,0,,Матч кезінде ұрыспаңыз
Dialogue: 0,0:08:17.96,0:08:21.03,Default,,0,0,0,,'86 Дүниежүзілік сериясы? Жоғалыңыз!
Dialogue: 0,0:08:21.16,0:08:22.56,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:22.66,0:08:24.73,Default,,0,0,0,,Біз бәрібір қарабайыр адамдар деңгейінде тұрмыз.
Dialogue: 0,0:08:24.80,0:08:27.77,Default,,0,0,0,,Калифорниядағы досыңыз сияқты емес.
Dialogue: 0,0:08:27.84,0:08:30.84,Default,,0,0,0,,Джордж Клуни де сенің досың ба?
Dialogue: 0,0:08:30.97,0:08:33.17,Default,,0,0,0,,Мұны жасамаңыз. Мен Дайанға жамандық айтқым келмейді.
Dialogue: 0,0:08:33.27,0:08:35.68,Default,,0,0,0,,5 жыл бойы байланыс жоқ.
Dialogue: 0,0:08:35.74,0:08:38.11,Default,,0,0,0,,А.Род сияқты шық.
Dialogue: 0,0:08:38.55,0:08:40.72,Default,,0,0,0,,Мен бәрібір барамын.
Dialogue: 0,0:08:41.55,0:08:43.85,Default,,0,0,0,,Барма, Ди Ди, өтінемін.
Dialogue: 0,0:08:43.95,0:08:45.72,Default,,0,0,0,,Анам «шығыңыз» деді
Dialogue: 0,0:08:45.82,0:08:49.59,Default,,0,0,0,,Мен мұны айтқым келмейді, мен сенің қалғаныңды қалаймын.
Dialogue: 0,0:08:49.66,0:08:50.53,Default,,0,0,0,,Дұрыс па? Марти
Dialogue: 0,0:08:50.63,0:08:51.66,Default,,0,0,0,,Сәйкестік жақсы.
Dialogue: 0,0:08:51.83,0:08:54.73,Default,,0,0,0,,Мен де жерлеу рәсімін жасауыңызды қалаймын.
Dialogue: 0,0:08:54.83,0:08:57.00,Default,,0,0,0,,Біз екі рет ойлана алмаймыз
Dialogue: 0,0:08:57.23,0:08:59.73,Default,,0,0,0,,Жарайды, сатушының нөмірі қандай?
Dialogue: 0,0:08:59.83,0:09:02.60,Default,,0,0,0,,Интернеттен іздеңіз.
Dialogue: 0,0:09:02.70,0:09:04.27,Default,,0,0,0,,Өзіңіз ойланыңыз
Dialogue: 0,0:09:04.57,0:09:06.61,Default,,0,0,0,,Асықпасаң, мұз ериді.
Dialogue: 0,0:09:06.81,0:09:08.64,Default,,0,0,0,,Күте тұрыңыз, бұл сіздің әкеңіз бе?
Dialogue: 0,0:09:09.08,0:09:11.68,Default,,0,0,0,,Неліктен Тама Тама граффити?
Dialogue: 0,0:09:11.85,0:09:15.22,Default,,0,0,0,,Мен сені өлді деп ойламадым.
Dialogue: 0,0:09:16.12,0:09:17.69,Default,,0,0,0,,Мен саған қарап тұрмын
Dialogue: 0,0:09:18.05,0:09:19.89,Default,,0,0,0,,Әке, сіз жақсы көрінесіз...
Dialogue: 0,0:09:21.12,0:09:24.86,Default,,0,0,0,,Дэвид Бореаназдың үйіне қош келдіңіз
Dialogue: 0,0:09:25.06,0:09:27.63,Default,,0,0,0,,Сіз теледидардан жиі шығасыз.
Dialogue: 0,0:09:27.80,0:09:29.66,Default,,0,0,0,,Қараңыз, драмалар...
Dialogue: 0,0:09:29.73,0:09:31.23,Default,,0,0,0,,Теледидар және т.б.
Dialogue: 0,0:09:31.33,0:09:32.83,Default,,0,0,0,,Қабылдау ақысы - $50
Dialogue: 0,0:09:32.97,0:09:33.77,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:09:33.87,0:09:36.64,Default,,0,0,0,,Дэвидтің суреті шығып кетті.
Dialogue: 0,0:09:36.70,0:09:38.04,Default,,0,0,0,,<Мен оны «Спайс» деп атаймын➡
Dialogue: 0,0:09:38.11,0:09:41.31,Default,,0,0,0,,Дэвидтің іш киімін көргің келмей ме?
Dialogue: 0,0:09:41.58,0:09:42.64,Default,,0,0,0,,Жатын бөлмеге барыңыз.
Dialogue: 0,0:09:42.74,0:09:43.91,Default,,0,0,0,,О, іш киім?
Dialogue: 0,0:09:43.98,0:09:45.88,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:09:45.95,0:09:47.98,Default,,0,0,0,,Әлі де бір жерде жазба бар ма?
Dialogue: 0,0:09:48.05,0:09:50.32,Default,,0,0,0,,Жоқ, бұл сіздің ар-ұжданыңыздың дауысы.
Dialogue: 0,0:09:50.62,0:09:54.06,Default,,0,0,0,,БоДжек саған сеніп, үйді сеніп тапсырды...
Dialogue: 0,0:09:54.16,0:09:55.19,Default,,0,0,0,,Аузыңды жап
Dialogue: 0,0:09:55.62,0:09:57.79,Default,,0,0,0,,Тоқташы, ауырады...
Dialogue: 0,0:10:02.30,0:10:05.33,Default,,0,0,0,,Сәлем, мен Тоддпын. Сіз маған бірдеңе көмектесе аласыз ба?
Dialogue: 0,0:10:05.70,0:10:07.94,Default,,0,0,0,,Аузыңды жап, ақша табуды доғар.
Dialogue: 0,0:10:08.04,0:10:09.30,Default,,0,0,0,,Сіздің агентіңіз
Dialogue: 0,0:10:09.64,0:10:11.21,Default,,0,0,0,,Неліктен білдің?
Dialogue: 0,0:10:11.37,0:10:15.28,Default,,0,0,0,,Сіз мені жіппен ойнадым деп ойладыңыз ба?
Dialogue: 0,0:10:15.34,0:10:18.08,Default,,0,0,0,,Мен деңгейді көтеремін
Dialogue: 0,0:10:18.28,0:10:19.81,Default,,0,0,0,,Ол үлкен болуы керек
Dialogue: 0,0:10:19.91,0:10:22.22,Default,,0,0,0,,Мила Кунисті қалай қолдануға болады?
Dialogue: 0,0:10:22.65,0:10:24.22,Default,,0,0,0,,Мила Кунис деген кім?
Dialogue: 0,0:10:24.39,0:10:26.62,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:10:27.25,0:10:28.22,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:10:30.16,0:10:32.09,Default,,0,0,0,,Мен соншалықты көруден шаршадым
Dialogue: 0,0:10:32.93,0:10:35.06,Default,,0,0,0,,Дайан
Dialogue: 0,0:10:37.67,0:10:39.70,Default,,0,0,0,,5 жыл бойы байланыста болмаған.
Dialogue: 0,0:10:39.87,0:10:42.14,Default,,0,0,0,,Бастық болмаңыз
Dialogue: 0,0:10:42.30,0:10:46.01,Default,,0,0,0,,Мен сізге ескерттім, себебі Марти жұмыс істемейді.
Dialogue: 0,0:10:46.14,0:10:46.81,Default,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,0:10:46.87,0:10:48.24,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:10:48.34,0:10:51.75,Default,,0,0,0,,Менің аяғым карьердегі жарақаттан ауырды.
Dialogue: 0,0:10:51.88,0:10:54.85,Default,,0,0,0,,Егер сіз американдық футбол командасының мүшесі болсаңыз, сізге демалыс керек.
Dialogue: 0,0:10:54.98,0:10:56.15,Default,,0,0,0,,Ол басқа, солай ма?
Dialogue: 0,0:10:56.32,0:11:00.89,Default,,0,0,0,,Жұмыс істегіңіз келсе де, жұмысты иммигранттар алады.
Dialogue: 0,0:11:01.02,0:11:02.92,Default,,0,0,0,,Біз де иммигранттармыз, солай ма?
Dialogue: 0,0:11:03.02,0:11:03.66,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:11:03.79,0:11:04.86,Default,,0,0,0,,Мен вьетнамдықпын.
Dialogue: 0,0:11:04.99,0:11:07.23,Default,,0,0,0,,Ол американдық көрінеді, бірақ ол американдық.
Dialogue: 0,0:11:07.36,0:11:08.23,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:08.36,0:11:10.83,Default,,0,0,0,,Ол не ойлады?
Dialogue: 0,0:11:12.23,0:11:14.80,Default,,0,0,0,,Мен Дайанды іздеп жүрмін.
Dialogue: 0,0:11:14.87,0:11:16.37,Default,,0,0,0,,Сіз ағылшын тілінде сөйлей аласыз ба?
Dialogue: 0,0:11:16.77,0:11:18.97,Default,,0,0,0,,Шынайы ма? Бұл ақылсыз
Dialogue: 0,0:11:19.04,0:11:21.88,Default,,0,0,0,,«Ат па, пәледе» пайда болған жылқы емес пе?
Dialogue: 0,0:11:22.71,0:11:24.71,Default,,0,0,0,,Ағылшын тілін кім түсінеді?
Dialogue: 0,0:11:24.81,0:11:26.15,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:26.71,0:11:28.25,Default,,0,0,0,,Жұлдыз келді
Dialogue: 0,0:11:28.38,0:11:30.75,Default,,0,0,0,,«Бореананың үйі»
Dialogue: 0,0:11:30.89,0:11:34.26,Default,,0,0,0,,$75 Балалар мен қарт адамдар тегін
Dialogue: 0,0:11:34.39,0:11:38.43,Default,,0,0,0,,Арқанның ішіне кірмеңіз.
Dialogue: 0,0:11:38.73,0:11:40.29,Default,,0,0,0,,Келесі - ас үй
Dialogue: 0,0:11:40.86,0:11:42.23,Default,,0,0,0,,Мила Кунис осында.
Dialogue: 0,0:11:43.80,0:11:46.77,Default,,0,0,0,,Зығырға жазылған «B.H» —
Dialogue: 0,0:11:46.87,0:11:48.87,Default,,0,0,0,,Бұл біздің үйдің бас әріпі.
Dialogue: 0,0:11:52.27,0:11:52.91,Default,,0,0,0,,Иә
Dialogue: 0,0:11:53.11,0:11:55.14,Default,,0,0,0,,Сіздің компанияңызда—
Dialogue: 0,0:11:55.28,0:11:57.18,Default,,0,0,0,,Денені қалай жинайды?
Dialogue: 0,0:11:57.24,0:11:58.31,Default,,0,0,0,,Сәлем БоДжек
Dialogue: 0,0:11:58.38,0:12:00.78,Default,,0,0,0,,Бостонда қандай да бір атақты адамдарды кездестірдіңіз бе?
Dialogue: 0,0:12:00.88,0:12:03.85,Default,,0,0,0,,Біз супермаркеттен бір уақытта жүзім алдық...
Dialogue: 0,0:12:03.92,0:12:05.79,Default,,0,0,0,,Бұл Бен Аффлек болатын.
Dialogue: 0,0:12:05.89,0:12:08.06,Default,,0,0,0,,Жүзімді де жейді.
Dialogue: 0,0:12:08.16,0:12:10.22,Default,,0,0,0,,Анашым, Бен Аффлек де жүзім жейді.
Dialogue: 0,0:12:10.39,0:12:11.99,Default,,0,0,0,,Атақты адамдар не жейді?
Dialogue: 0,0:12:12.13,0:12:13.03,Default,,0,0,0,,БоДжек...
Dialogue: 0,0:12:13.09,0:12:17.77,Default,,0,0,0,,Олар Даредевил сияқты жүзім үшін шайқасты.
Dialogue: 0,0:12:17.83,0:12:19.83,Default,,0,0,0,,Мен таңғажайып оқиғаны естідім.
Dialogue: 0,0:12:21.40,0:12:25.21,Default,,0,0,0,,үшінмыз футбол ойнаймыз ба?
Dialogue: 0,0:12:25.31,0:12:30.01,Default,,0,0,0,,Жарайды, үлкен жұлдызмен ойнау арман сияқты.
Dialogue: 0,0:12:30.18,0:12:31.48,Default,,0,0,0,,Бұған дейін—
Dialogue: 0,0:12:31.78,0:12:34.48,Default,,0,0,0,,Дайанның жылап тұрған бейнесін көрейік.
Dialogue: 0,0:12:34.78,0:12:36.12,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:12:36.28,0:12:37.79,Default,,0,0,0,,Қараудың қажеті жоқ
Dialogue: 0,0:12:37.92,0:12:40.96,Default,,0,0,0,,Баяғыда әпкеме қиялдағы қаламдас құрдым.
Dialogue: 0,0:12:41.02,0:12:42.06,Default,,0,0,0,,Аты – Лео
Dialogue: 0,0:12:42.19,0:12:45.36,Default,,0,0,0,,Өтінемін, бұл туралы айтуды доғарыңыз.
Dialogue: 0,0:12:45.76,0:12:47.39,Default,,0,0,0,,Біз хат жаздық.
Dialogue: 0,0:12:47.46,0:12:50.76,Default,,0,0,0,,Бұл жағдай Кембридж университетінің ер студенті.
Dialogue: 0,0:12:50.87,0:12:52.03,Default,,0,0,0,,Сізге қиын болды.
Dialogue: 0,0:12:52.13,0:12:55.90,Default,,0,0,0,,«Диана, екеуміз де түсінбейміз».
Dialogue: 0,0:12:55.97,0:12:57.77,Default,,0,0,0,,«Айналаңыздағы адамдар біртүрлі».
Dialogue: 0,0:12:58.07,0:13:00.11,Default,,0,0,0,,«Менің мәңгілік досым Леодан»
Dialogue: 0,0:13:00.27,0:13:01.14,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:13:01.38,0:13:02.78,Default,,0,0,0,,Кататана
Dialogue: 0,0:13:02.91,0:13:06.98,Default,,0,0,0,,Алты айдан кейін мен үйсіз адамды Арыстанға айналдырдым.
Dialogue: 0,0:13:07.05,0:13:09.25,Default,,0,0,0,,Әпкемді кешке шақырды
Dialogue: 0,0:13:09.35,0:13:10.02,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:13:10.08,0:13:13.39,Default,,0,0,0,,Гүлдерің әдемі екен.
Dialogue: 0,0:13:15.09,0:13:17.12,Default,,0,0,0,,Мен оны күнде көргім келеді
Dialogue: 0,0:13:17.49,0:13:18.56,Default,,0,0,0,,Бұл ең жақсы
Dialogue: 0,0:13:18.89,0:13:20.06,Default,,0,0,0,,Мені мазақ қылды
Dialogue: 0,0:13:20.23,0:13:22.13,Default,,0,0,0,,Жай әзіл
Dialogue: 0,0:13:22.20,0:13:23.13,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:13:24.47,0:13:26.87,Default,,0,0,0,,Дайан - жылауық
Dialogue: 0,0:13:26.97,0:13:30.07,Default,,0,0,0,,Бәріміз бірге күлетініміз жақсы емес пе?
Dialogue: 0,0:13:30.17,0:13:32.14,Default,,0,0,0,,Терапевт те солай айтты.
Dialogue: 0,0:13:32.24,0:13:35.14,Default,,0,0,0,,Жерлеуге барғың келе ме?
Dialogue: 0,0:13:35.28,0:13:39.28,Default,,0,0,0,,Маған жерлеу залдары ұнамайды, олар мәйіттерге толы.
Dialogue: 0,0:13:39.38,0:13:41.55,Default,,0,0,0,,Барғың келсе, жалғыз жүр.
Dialogue: 0,0:13:41.98,0:13:44.95,Default,,0,0,0,,Жақсы, мен бәрін жасаймын.
Dialogue: 0,0:13:45.05,0:13:47.02,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:13:47.25,0:13:48.16,Default,,0,0,0,,БоДжекке барайық
Dialogue: 0,0:13:48.29,0:13:49.89,Default,,0,0,0,,Оны әкелме
Dialogue: 0,0:13:52.23,0:13:53.83,Default,,0,0,0,,Жүрегіңді ұрлайтын жылдамдық –
Dialogue: 0,0:13:53.93,0:13:56.03,Default,,0,0,0,,Бұл Дэйв Робертстің ұрланған базаларымен бірдей.
Dialogue: 0,0:13:56.23,0:13:57.46,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:13:57.60,0:14:00.27,Default,,0,0,0,,Менің баруым керек, жаназада кездескенше.
Dialogue: 0,0:14:00.37,0:14:02.84,Default,,0,0,0,,Осы жолы бәріміз бірге ойнайық
Dialogue: 0,0:14:02.94,0:14:04.91,Default,,0,0,0,,Жерлеу психосы—!
Dialogue: 0,0:14:05.14,0:14:08.58,Default,,0,0,0,,Жерлеу рәсімі!
Dialogue: 0,0:14:08.91,0:14:11.15,Default,,0,0,0,,Сіз мына бөлмеге қарай аласыз—
Dialogue: 0,0:14:11.25,0:14:13.28,Default,,0,0,0,,Тек Platinum мүшелері үшін
Dialogue: 0,0:14:13.38,0:14:15.58,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:14:15.88,0:14:18.12,Default,,0,0,0,,Үзіліс Бұл Бореаназдың өзі.
Dialogue: 0,0:14:19.39,0:14:21.46,Default,,0,0,0,,Тодд, менің бөлмеме кірме.
Dialogue: 0,0:14:21.56,0:14:23.46,Default,,0,0,0,,Сәлеметсіз бе, мен Бореаназмын.
Dialogue: 0,0:14:24.86,0:14:26.19,Default,,0,0,0,,Осының бәрі экскурсияға арналған.
Dialogue: 0,0:14:26.29,0:14:27.93,Default,,0,0,0,,Күніңіз қызық болсын
Dialogue: 0,0:14:28.06,0:14:29.93,Default,,0,0,0,,«Құтты жерлеу үйі»
Dialogue: 0,0:14:30.26,0:14:32.20,Default,,0,0,0,,Сіздің әкеңіздің мінезі қандай?
Dialogue: 0,0:14:32.33,0:14:35.34,Default,,0,0,0,,Жай ғана маскүнем
Dialogue: 0,0:14:35.44,0:14:39.57,Default,,0,0,0,,Қызын қолдаудан алыс, оның сәтсіздіктеріне қуанды.
Dialogue: 0,0:14:40.17,0:14:44.65,Default,,0,0,0,,«Әке пакеті» туралы не айтасыз?
Dialogue: 0,0:14:44.95,0:14:46.58,Default,,0,0,0,,Әкем үшін ысырап
Dialogue: 0,0:14:47.65,0:14:50.28,Default,,0,0,0,,Егер солай болса, онда бұл—
Dialogue: 0,0:14:50.38,0:14:54.09,Default,,0,0,0,,«Тіпті папка болса да, қоқыс па?»?
Dialogue: 0,0:14:54.29,0:14:55.56,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:14:55.92,0:14:57.63,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:14:58.46,0:14:59.99,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,0:15:00.13,0:15:02.23,Default,,0,0,0,,Иықтарыңызды аздап босатыңыз.
Dialogue: 0,0:15:02.43,0:15:05.20,Default,,0,0,0,,Біз ағаларымыздан үйрене аламыз.
Dialogue: 0,0:15:05.30,0:15:06.23,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:15:06.33,0:15:09.00,Default,,0,0,0,,Мен құласам да, бітті.
Dialogue: 0,0:15:09.14,0:15:12.64,Default,,0,0,0,,Бірақ мен газды бір жерден шығаруым керек...
Dialogue: 0,0:15:12.97,0:15:14.58,Default,,0,0,0,,Ол жақында жарылады.
Dialogue: 0,0:15:15.14,0:15:16.91,Default,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:15:15.14,0:15:16.91,Default,,0,0,0,,«Хабарламау»
Dialogue: 0,0:15:16.98,0:15:19.41,Default,,0,0,0,,Көп рет шақырылды
Dialogue: 0,0:15:19.48,0:15:20.51,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:15:20.61,0:15:21.45,Default,,0,0,0,,Мен шықсам ше?
Dialogue: 0,0:15:21.55,0:15:23.62,Default,,0,0,0,,Итаден бәрібір
Dialogue: 0,0:15:24.08,0:15:27.12,Default,,0,0,0,,Телефонға жауап бермесең, мені қорқыта алмайсың.
Dialogue: 0,0:15:27.45,0:15:29.96,Default,,0,0,0,,Жақсырақ, зарядтау керек пе?
Dialogue: 0,0:15:30.06,0:15:30.49,Default,,0,0,0,,Үйде?
Dialogue: 0,0:15:30.59,0:15:31.99,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:15:32.46,0:15:34.13,Default,,0,0,0,,Мені итер
Dialogue: 0,0:15:35.23,0:15:37.00,Default,,0,0,0,,Не? Бұл оның үйі, солай ма?
Dialogue: 0,0:15:37.16,0:15:39.27,Default,,0,0,0,,Бұл... Дэвид Бореаназ ба?
Dialogue: 0,0:15:39.37,0:15:42.14,Default,,0,0,0,,Бұл БоДжектің үйі екені сөзсіз.
Dialogue: 0,0:15:42.24,0:15:43.64,Default,,0,0,0,,Егер сіз сөйлескіңіз келсе—
Dialogue: 0,0:15:44.10,0:15:47.14,Default,,0,0,0,,Ұзарту билетін сатып алыңыз
Dialogue: 0,0:15:47.37,0:15:49.14,Default,,0,0,0,,О, бос емес
Dialogue: 0,0:15:49.24,0:15:52.21,Default,,0,0,0,,Қараңызшы, тағы бір топ шоттар бар.
Dialogue: 0,0:15:52.31,0:15:55.68,Default,,0,0,0,,Сәлем, Кэролайн, сатудан түскен кірісті санау үшін...
Dialogue: 0,0:15:55.98,0:15:59.29,Default,,0,0,0,,Мен де дәретханаларды патрульдеуім керек.
Dialogue: 0,0:15:59.39,0:16:03.39,Default,,0,0,0,,Бореаназ қуыршағын ұрлаған кеңсе қызметкері жұмыстан қуылды.
Dialogue: 0,0:16:03.52,0:16:06.19,Default,,0,0,0,,Мен мұны жалғыз істей алмаймын.
Dialogue: 0,0:16:06.33,0:16:10.50,Default,,0,0,0,,Бұлай сөйлей бермей, ақша тап.
Dialogue: 0,0:16:11.53,0:16:14.57,Default,,0,0,0,,Бірақ бұл заңсыз деп ойлаймын.
Dialogue: 0,0:16:14.70,0:16:17.30,Default,,0,0,0,,Ақымаққа ұрсаң да түзелмейді...
Dialogue: 0,0:16:17.40,0:16:18.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:19.07,0:16:22.48,Default,,0,0,0,,Құлағыңыздағы тесікті мұқият тыңдаңыз.
Dialogue: 0,0:16:22.61,0:16:25.75,Default,,0,0,0,,Мен жақсы жұмыс таптым.
Dialogue: 0,0:16:26.05,0:16:27.58,Default,,0,0,0,,Өткенге орала алмаймыз.
Dialogue: 0,0:16:27.68,0:16:29.45,Default,,0,0,0,,Мен аяқ киім алғым келеді
Dialogue: 0,0:16:29.55,0:16:30.52,Default,,0,0,0,,Жемчужина да.
Dialogue: 0,0:16:30.99,0:16:33.72,Default,,0,0,0,,Мен тығырыққа тірелдім, не істеуім керек?
Dialogue: 0,0:16:34.02,0:16:35.39,Default,,0,0,0,,Мен саған үйретемін.
Dialogue: 0,0:16:35.56,0:16:36.19,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:16:36.26,0:16:38.33,Default,,0,0,0,,Бұл менмін, Бореаназ.
Dialogue: 0,0:16:38.69,0:16:40.76,Default,,0,0,0,,Бұл дауыс па?
Dialogue: 0,0:16:41.06,0:16:43.26,Default,,0,0,0,,Иә, мен сізге кеңес беремін.
Dialogue: 0,0:16:43.36,0:16:44.73,Default,,0,0,0,,Бұл драманың желісі.
Dialogue: 0,0:16:45.03,0:16:47.03,Default,,0,0,0,,Мен сенімдімін... «Жаңа қыз»?
Dialogue: 0,0:16:47.13,0:16:49.20,Default,,0,0,0,,«Жалғастыру»
Dialogue: 0,0:16:49.40,0:16:51.47,Default,,0,0,0,,Дэвиге рахмет
Dialogue: 0,0:16:51.57,0:16:53.61,Default,,0,0,0,,Мені Дэви деп атама
Dialogue: 0,0:16:56.44,0:16:57.21,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:16:57.31,0:16:59.75,Default,,0,0,0,,Сағат 4 болып қалды. Ешкім келмейді.
Dialogue: 0,0:17:00.05,0:17:02.62,Default,,0,0,0,,Бұлар адамның қоқысы.
Dialogue: 0,0:17:02.72,0:17:06.62,Default,,0,0,0,,Сонда сіз тіпті әкеңіздің жерлеуіне де қатыспадыңыз ба?
Dialogue: 0,0:17:07.45,0:17:08.49,Default,,0,0,0,,Денелер жоқ.
Dialogue: 0,0:17:08.66,0:17:10.76,Default,,0,0,0,,Түсінбеушілік болған сияқты.
Dialogue: 0,0:17:11.06,0:17:15.23,Default,,0,0,0,,«Мен мәйітті алуға барсам, ол үйде жоқ екен».
Dialogue: 0,0:17:15.33,0:17:20.30,Default,,0,0,0,,Біз басқа органды қосымша ақыға ұсына аламыз.
Dialogue: 0,0:17:20.40,0:17:21.64,Default,,0,0,0,,Сізге бұл қалай ұнайды?
Dialogue: 0,0:17:25.21,0:17:27.37,Default,,0,0,0,,Жерлеуге неге келмедің?
Dialogue: 0,0:17:27.47,0:17:31.31,Default,,0,0,0,,Мен дайындалдым, бірақ ешкім келмеді.
Dialogue: 0,0:17:31.41,0:17:34.25,Default,,0,0,0,,Әкем формальды болғанды ​​ұнатпайды.
Dialogue: 0,0:17:34.38,0:17:36.58,Default,,0,0,0,,Денесі ұсақталып, балыққа тағам ретінде пайдаланылады ма?
Dialogue: 0,0:17:36.68,0:17:39.45,Default,,0,0,0,,Жай ғана Янкис ойыншысын соқты.
Dialogue: 0,0:17:39.59,0:17:40.79,Default,,0,0,0,,Джетер Замамиро
Dialogue: 0,0:17:41.12,0:17:42.52,Default,,0,0,0,,Тоқта, мәйіт қайда?
Dialogue: 0,0:17:42.66,0:17:44.39,Default,,0,0,0,,Жүк көлігіне кесілген
Dialogue: 0,0:17:44.46,0:17:46.63,Default,,0,0,0,,«Бөлшектелген денелер»
Dialogue: 0,0:17:46.69,0:17:48.13,Default,,0,0,0,,Сен әкеңді ойып алдың ба?
Dialogue: 0,0:17:48.23,0:17:50.63,Default,,0,0,0,,Адамның қалағаны осы еді.
Dialogue: 0,0:17:50.76,0:17:53.63,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:17:53.77,0:17:59.54,Default,,0,0,0,,Басқаша айтқанда, күні бойы дайындалған жерлеуге келмеңіз.
Dialogue: 0,0:17:59.77,0:18:02.81,Default,,0,0,0,,Янкилердің Джетеріне соққы беру —
Dialogue: 0,0:18:03.11,0:18:06.15,Default,,0,0,0,,Сонда сен әкеңнің денесін ойып тастадың ба?
Dialogue: 0,0:18:06.25,0:18:08.48,Default,,0,0,0,,Оны жай ғана ұрып алмаңыз.
Dialogue: 0,0:18:08.58,0:18:10.42,Default,,0,0,0,,Джетердің үлкен жүзі
Dialogue: 0,0:18:10.55,0:18:11.82,Default,,0,0,0,,Иә, бұл өте үлкен.
Dialogue: 0,0:18:12.12,0:18:14.66,Default,,0,0,0,,Янкилер осы аптада қалаға келеді.
Dialogue: 0,0:18:14.79,0:18:17.39,Default,,0,0,0,,Томми, сен мені сұрадың.
Dialogue: 0,0:18:17.52,0:18:21.10,Default,,0,0,0,,Неліктен сіз әрқашан бастықсыз?
Dialogue: 0,0:18:21.20,0:18:23.23,Default,,0,0,0,,Мен басқашамын ба?
Dialogue: 0,0:18:23.36,0:18:25.30,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:18:25.47,0:18:29.44,Default,,0,0,0,,Әркімде қате ой бар. Дайан соншалықты керемет емес.
Dialogue: 0,0:18:29.54,0:18:34.34,Default,,0,0,0,,Ол менің елес жазушым. Кітап жазсам да атым жазылмайды.
Dialogue: 0,0:18:34.48,0:18:37.68,Default,,0,0,0,,Бұл оның 34 жасында армандағаны ма?
Dialogue: 0,0:18:37.88,0:18:40.81,Default,,0,0,0,,Байдың тоқ болуы
Dialogue: 0,0:18:41.15,0:18:44.45,Default,,0,0,0,,Ең үлкен емес
Dialogue: 0,0:18:45.29,0:18:45.85,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:18:46.15,0:18:47.59,Default,,0,0,0,,Байларға паразиттік тіршілік етеді?
Dialogue: 0,0:18:48.49,0:18:49.39,Default,,0,0,0,,Бұл сұмдық
Dialogue: 0,0:18:50.16,0:18:51.39,Default,,0,0,0,,Бұл пайдалы болды ма?
Dialogue: 0,0:18:58.53,0:19:03.60,Default,,0,0,0,,Сондықтан мен саған көлікте күт дедім.
Dialogue: 0,0:19:03.74,0:19:06.34,Default,,0,0,0,,Дайан ақыры ашуланып қалды.
Dialogue: 0,0:19:06.47,0:19:08.68,Default,,0,0,0,,Ди Ди, тоқтат.
Dialogue: 0,0:19:09.21,0:19:11.88,Default,,0,0,0,,Дайан, сен тамашаға айналып бара жатырсың.
Dialogue: 0,0:19:13.21,0:19:15.48,Default,,0,0,0,,Көлігіңіздің кілтімен не істемексіз?
Dialogue: 0,0:19:15.62,0:19:16.75,Default,,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:19:16.85,0:19:20.22,Default,,0,0,0,,Мен әкем тиелген жүк көлігіне міндім.
Dialogue: 0,0:19:20.32,0:19:21.62,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:19:21.86,0:19:23.89,Default,,0,0,0,,Есіңізде болсын, ақымақтар.
Dialogue: 0,0:19:24.19,0:19:26.76,Default,,0,0,0,,Мен қатты ашуландым
Dialogue: 0,0:19:26.86,0:19:29.30,Default,,0,0,0,,Не істеу керек?
Dialogue: 0,0:19:29.46,0:19:30.43,Default,,0,0,0,,3 минуттан кейін
Dialogue: 0,0:19:30.56,0:19:32.53,Default,,0,0,0,,Бір жиекте…
Dialogue: 0,0:19:32.63,0:19:35.94,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:19:36.27,0:19:38.17,Default,,0,0,0,,Жақсы, ағын келе жатыр.
Dialogue: 0,0:19:38.34,0:19:40.17,Default,,0,0,0,,Ол қайда баруы мүмкін?
Dialogue: 0,0:19:40.31,0:19:43.24,Default,,0,0,0,,Орта мектепте оқып жүргенде де үнсіз жоғалып кететін.
Dialogue: 0,0:19:43.61,0:19:45.58,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:19:45.78,0:19:47.65,Default,,0,0,0,,Менің бір ойым бар
Dialogue: 0,0:19:47.75,0:19:50.92,Default,,0,0,0,,Күте тұрыңыз, кеш басталғалы жатыр.
Dialogue: 0,0:19:51.22,0:19:53.79,Default,,0,0,0,,Бірақ ол қатты ашуланды.
Dialogue: 0,0:19:53.89,0:19:55.66,Default,,0,0,0,,Ал сенің әкең ше?
Dialogue: 0,0:19:55.76,0:19:58.73,Default,,0,0,0,,Барма, сен бесінші ағасың.
Dialogue: 0,0:19:58.86,0:19:59.93,Default,,0,0,0,,Мен?
Dialogue: 0,0:20:00.23,0:20:01.40,Default,,0,0,0,,Иә, аға.
Dialogue: 0,0:20:01.50,0:20:04.67,Default,,0,0,0,,Ішіп болған соң, футбол ойнайық.
Dialogue: 0,0:20:07.63,0:20:09.40,Default,,0,0,0,,Дереу таратыңыз
Dialogue: 0,0:20:09.64,0:20:11.41,Default,,0,0,0,,Жиналу туралы хабарлама жоқ
Dialogue: 0,0:20:11.71,0:20:13.61,Default,,0,0,0,,Дереу таратыңыз
Dialogue: 0,0:20:15.41,0:20:18.51,Default,,0,0,0,,Бұл ең жаманы, Кэролайн, не істеуіміз керек?
Dialogue: 0,0:20:18.61,0:20:19.71,Default,,0,0,0,,Маған ұнаса ше?
Dialogue: 0,0:20:19.81,0:20:22.72,Default,,0,0,0,,Мен кез келген жерден қашып кете аламын
Dialogue: 0,0:20:23.45,0:20:25.42,Default,,0,0,0,,Сіз Бореаназсыз ба?
Dialogue: 0,0:20:25.52,0:20:27.82,Default,,0,0,0,,Мм... Бореаназ қуыршағы ше?
Dialogue: 0,0:20:29.26,0:20:32.69,Default,,0,0,0,,Бұл дәл БоДжектің үйіне ұқсайды.
Dialogue: 0,0:20:32.79,0:20:34.56,Default,,0,0,0,,Сол сәулетші шығар
Dialogue: 0,0:20:34.66,0:20:36.56,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:20:36.66,0:20:37.70,Default,,0,0,0,,Бұл ең нашар
Dialogue: 0,0:20:37.80,0:20:40.23,Default,,0,0,0,,Мен үйге бармауым керек еді
Dialogue: 0,0:20:40.33,0:20:41.67,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:20:41.77,0:20:45.47,Default,,0,0,0,,Мен қайтып келгенде, мен сізге патенттелген жержаңғақ майын құшақтаймын.
Dialogue: 0,0:20:45.57,0:20:47.31,Default,,0,0,0,,«Бұл балқитын кремді».
Dialogue: 0,0:20:47.44,0:20:50.71,Default,,0,0,0,,Мен патент алған жоқпын, бірақ құшақтап ал
Dialogue: 0,0:20:50.94,0:20:52.98,Default,,0,0,0,,БоДжек келді, трубканы қояйық.
Dialogue: 0,0:20:50.94,0:20:52.98,Default,,0,0,0,,«қоқыс үйіндісі»
Dialogue: 0,0:20:52.98,0:20:53.28,Default,,0,0,0,,«қоқыс үйіндісі»
Dialogue: 0,0:20:53.28,0:20:53.95,Default,,0,0,0,,«қоқыс үйіндісі»
Dialogue: 0,0:20:53.28,0:20:53.95,Default,,0,0,0,,BoJack?
Dialogue: 0,0:20:53.95,0:20:53.98,Default,,0,0,0,,BoJack?
Dialogue: 0,0:20:54.31,0:20:55.48,Default,,0,0,0,,Неліктен ол?
Dialogue: 0,0:20:55.55,0:20:58.99,Default,,0,0,0,,Ертеректе бір қорқынышты сөз айтқаныма өкіндім.
Dialogue: 0,0:20:59.29,0:20:59.99,Default,,0,0,0,,Бұл рас, солай ма?
Dialogue: 0,0:21:00.95,0:21:04.46,Default,,0,0,0,,Барда сізге хат келді.
Dialogue: 0,0:21:06.66,0:21:08.56,Default,,0,0,0,,Оқыңыз, сізге ұнайды.
Dialogue: 0,0:21:08.93,0:21:09.86,Default,,0,0,0,,«Дайанға»
Dialogue: 0,0:21:09.96,0:21:13.33,Default,,0,0,0,,«Бұл менмін, Лео, менің ескі қаламдасым».
Dialogue: 0,0:21:13.57,0:21:16.47,Default,,0,0,0,,«Мен BoJack жазған жоқпын.»
Dialogue: 0,0:21:16.84,0:21:17.60,Default,,0,0,0,,Әрі қарай жалғастыр.
Dialogue: 0,0:21:17.74,0:21:19.74,Default,,0,0,0,,«Диана, сен жақсы адамсың».
Dialogue: 0,0:21:19.84,0:21:21.88,Default,,0,0,0,,«Бұл ең маңыздысы».
Dialogue: 0,0:21:22.01,0:21:23.74,Default,,0,0,0,,«Тіпті түсінетін адам болмаса да...»
Dialogue: 0,0:21:23.84,0:21:26.55,Default,,0,0,0,,«Мен сенің бұрынғы қалпыңда қалғаныңды қалаймын».
Dialogue: 0,0:21:26.68,0:21:29.55,Default,,0,0,0,,«Сатып алу кезінде эко сөмкені әкеліңіз»
Dialogue: 0,0:21:29.65,0:21:32.69,Default,,0,0,0,,«Жоспар құрайтын және әрекет ететін бөлік».
Dialogue: 0,0:21:32.79,0:21:36.62,Default,,0,0,0,,«Маған сенің ұшақта құлағыңды шығарып сағыз шайнағаның да ұнайды».
Dialogue: 0,0:21:36.99,0:21:39.63,Default,,0,0,0,,«Ешкім байқамаса да...»
Dialogue: 0,0:21:39.83,0:21:40.86,Default,,0,0,0,,«Мен білемін»
Dialogue: 0,0:21:40.93,0:21:43.36,Default,,0,0,0,,«Менің мәңгілік досым Леодан»
Dialogue: 0,0:21:44.33,0:21:46.03,Default,,0,0,0,,Қандай тамаша хат.
Dialogue: 0,0:21:46.33,0:21:49.34,Default,,0,0,0,,Мұны ата-анасы қорқынышты біреу айтты.
Dialogue: 0,0:21:49.74,0:21:50.97,Default,,0,0,0,,«Отбасы – бұл тұзақ»
Dialogue: 0,0:21:51.07,0:21:52.97,Default,,0,0,0,,«Мен шығуым керек»
Dialogue: 0,0:21:53.07,0:21:57.88,Default,,0,0,0,,Қазірдің өзінде мен отбасым мені мақтан тұтатын қызым деп санағанын қалаймын.
Dialogue: 0,0:21:58.35,0:21:59.71,Default,,0,0,0,,ақымақ көрінеді, солай ма?
Dialogue: 0,0:21:59.78,0:22:00.45,Default,,0,0,0,,О
Dialogue: 0,0:22:00.51,0:22:01.01,Default,,0,0,0,,Оны жоққа шығару
Dialogue: 0,0:22:01.35,0:22:03.92,Default,,0,0,0,,Жоқ, сен ақымақсың. Олар мойындай ма?
Dialogue: 0,0:22:04.02,0:22:06.72,Default,,0,0,0,,Мен үзіліс қосқым келеді.
Dialogue: 0,0:22:06.85,0:22:11.63,Default,,0,0,0,,Спилберг фильм үшін осылай жасады.
Dialogue: 0,0:22:11.73,0:22:14.59,Default,,0,0,0,,Нақты әлемде жоқ
Dialogue: 0,0:22:14.70,0:22:18.40,Default,,0,0,0,,Біз тек алға жылжамыз.
Dialogue: 0,0:22:18.50,0:22:20.80,Default,,0,0,0,,Бірақ олар үйге қайтқан сайын...
Dialogue: 0,0:22:20.93,0:22:22.07,Default,,0,0,0,,Мен үйге баруым керек.
Dialogue: 0,0:22:22.37,0:22:27.01,Default,,0,0,0,,Росстың жақсы жағы - ол адамдардың шыққан тегіне мән бермейді.
Dialogue: 0,0:22:27.11,0:22:29.71,Default,,0,0,0,,Мен бассейнді тазалау сияқты нәрселерге алаңдаймын.
Dialogue: 0,0:22:29.81,0:22:33.05,Default,,0,0,0,,Салатқа салатын жаңғақ түрлері.
Dialogue: 0,0:22:33.35,0:22:34.55,Default,,0,0,0,,Мен салатты жақсы көремін.
Dialogue: 0,0:22:34.65,0:22:37.48,Default,,0,0,0,,Жақсы, тек алға қарай жүр.
Dialogue: 0,0:22:38.05,0:22:39.42,Default,,0,0,0,,Еңбек тәжірибесі бағдарламасына оралды
Dialogue: 0,0:22:39.69,0:22:40.79,Default,,0,0,0,,Ойлан.
Dialogue: 0,0:22:40.89,0:22:44.42,Default,,0,0,0,,Сені ренжітетін әке қалмады.
Dialogue: 0,0:22:49.93,0:22:51.77,Default,,0,0,0,,«Пол Ревер»
Dialogue: 0,0:22:51.87,0:22:53.63,Default,,0,0,0,,«Фенвей саябағы»
Dialogue: 0,0:22:53.73,0:22:55.57,Default,,0,0,0,,«Сыралар»
Dialogue: 0,0:22:55.90,0:22:58.11,Default,,0,0,0,,Дерек Джетерге көп рахмет
Dialogue: 0,0:22:58.41,0:23:00.84,Default,,0,0,0,,Янкистің жұлдызды ойыншысы—
Dialogue: 0,0:23:00.94,0:23:04.88,Default,,0,0,0,,Менің қолымнан ұстап, жолды кесіп өтуге рұқсат еткеніңе сенбеймін.
Dialogue: 0,0:23:04.98,0:23:08.75,Default,,0,0,0,,Қарт адамдарға көмектесу заңдылық.
Dialogue: 0,0:23:09.55,0:23:11.12,Default,,0,0,0,,Не? Бұл балық тағамы ма?
Dialogue: 0,0:23:17.72,0:23:20.46,Default,,0,0,0,,Мен саған телефон соғып, барамын.
Dialogue: 0,0:23:20.53,0:23:21.46,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:23:25.80,0:23:27.53,Default,,0,0,0,,Шөп туралы хабарлама
Dialogue: 0,0:23:28.84,0:23:30.60,Default,,0,0,0,,Сәлем Шөп
Dialogue: 0,0:23:31.64,0:23:34.67,Default,,0,0,0,,Тезірек қоныстануымыз керек емес пе?
Dialogue: 0,0:23:34.78,0:23:35.94,Default,,0,0,0,,Өмір қысқа
Dialogue: 0,0:23:36.04,0:23:39.45,Default,,0,0,0,,Төбеңде қалсаң жақсы емес.
Dialogue: 0,0:23:39.71,0:23:42.88,Default,,0,0,0,,Әсіресе, айықпас ауру болсаң...
Dialogue: 0,0:23:42.98,0:23:45.49,Default,,0,0,0,,Қажет емес нәрселерді айту
Dialogue: 0,0:23:45.59,0:23:47.49,Default,,0,0,0,,Ендеше тіке сөйлесейік.
Dialogue: 0,0:23:47.59,0:23:49.62,Default,,0,0,0,,Маған қайта қоңырау шалыңыз.
Dialogue: 0,0:23:49.72,0:23:53.03,Default,,0,0,0,,Жарайды... мен күтемін.
Dialogue: 0,0:23:53.46,0:23:54.63,Default,,0,0,0,,Бұл BoJack
Dialogue: 0,0:23:54.86,0:23:56.63,Default,,0,0,0,,Жылқышы
Dialogue: 0,0:23:58.93,0:24:00.03,Default,,0,0,0,,Ол табанды.
Dialogue: 0,0:23:58.93,0:24:00.03,Default,,0,0,0,,«Хабарламау»
Dialogue: 0,0:24:01.00,0:24:04.57,Default,,0,0,0,,Өтінемін, БоДжек, шықшы.
Dialogue: 0,0:24:04.67,0:24:05.64,Default,,0,0,0,,Мен қазір кетемін.
Dialogue: 0,0:24:05.74,0:24:07.51,Default,,0,0,0,,Бұл BoJack. Маған хабарлама жіберіңіз.
Dialogue: 0,0:24:09.01,0:24:15.01,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
