Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.74,Default,,0,0,0,,NETFLIX түпнұсқа жұмысы
Dialogue: 0,0:00:08.67,0:00:12.31,Default,,0,0,0,,Бұл жұмыс істейді, өйткені біз мүлдем басқа адамдармыз.
Dialogue: 0,0:00:12.41,0:00:16.01,Default,,0,0,0,,Егер сен шоколад болсаң, мен жержаңғақ майы болар едім
Dialogue: 0,0:00:16.11,0:00:18.45,Default,,0,0,0,,Үніңді жап, мені сүй, ақымақ.
Dialogue: 0,0:00:21.62,0:00:22.45,Default,,0,0,0,,Кесу
Dialogue: 0,0:00:25.42,0:00:27.72,Default,,0,0,0,,«Гаррюдің ішкі тарихы» уақыты келді
Dialogue: 0,0:00:27.79,0:00:30.26,Default,,0,0,0,,Мен Райанмын
Dialogue: 0,0:00:30.36,0:00:33.09,Default,,0,0,0,,Мен ''Гарри ұры'' түсіріліміндемін
Dialogue: 0,0:00:33.19,0:00:36.66,Default,,0,0,0,,Қонақтар басты кейіпкер БоДжек және—
Dialogue: 0,0:00:36.77,0:00:39.73,Default,,0,0,0,,Жержаңғақ майы үлгі ретінде қызмет етті
Dialogue: 0,0:00:40.07,0:00:41.47,Default,,0,0,0,,Мен үлгімін бе?
Dialogue: 0,0:00:41.57,0:00:45.14,Default,,0,0,0,,Жарайды... әрине дұрыс айтасыз.
Dialogue: 0,0:00:45.34,0:00:50.21,Default,,0,0,0,,Шарасыз ұры оқиғасы киноға түсірілгеніне қуаныштымын.
Dialogue: 0,0:00:50.35,0:00:52.71,Default,,0,0,0,,Сіздің ұры туралы әңгімеңіз?
Dialogue: 0,0:00:52.78,0:00:56.05,Default,,0,0,0,,Сонымен қатар, түсірілім үйде жүргізілді.
Dialogue: 0,0:00:56.18,0:00:59.75,Default,,0,0,0,,Амиго мені ойнап жатыр.
Dialogue: 0,0:01:00.06,0:01:01.42,Default,,0,0,0,,Әй, ең жақын досым?
Dialogue: 0,0:01:01.49,0:01:02.22,Default,,0,0,0,,Кім
Dialogue: 0,0:01:02.32,0:01:03.36,Default,,0,0,0,,Тыныс алу
Dialogue: 0,0:01:03.46,0:01:06.73,Default,,0,0,0,,Біздің қараңғылық пен цуккоми...
Dialogue: 0,0:01:08.10,0:01:09.63,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:01:10.27,0:01:11.47,Default,,0,0,0,,Мен оны кейде шешіп аламын.
Dialogue: 0,0:01:11.53,0:01:12.60,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:01:12.67,0:01:15.07,Default,,0,0,0,,Қараңызшы, бұл тамаша.
Dialogue: 0,0:01:15.14,0:01:19.24,Default,,0,0,0,,БоДжек, мен сені өлді деп ойладым.
Dialogue: 0,0:01:19.37,0:01:24.58,Default,,0,0,0,,Мен тірі болғаныма және жұмысқа қайта оралғаныма қуаныштымын.
Dialogue: 0,0:01:24.68,0:01:26.21,Default,,0,0,0,,Неліктен бұл рөл?
Dialogue: 0,0:01:26.31,0:01:26.82,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:27.12,0:01:31.35,Default,,0,0,0,,«Д» ұрлаған адамның рөлін ойнауымды сұрайсыз ба?
Dialogue: 0,0:01:31.52,0:01:35.79,Default,,0,0,0,,Мен «D» ұрладым, ол идея ұры.
Dialogue: 0,0:01:36.12,0:01:39.13,Default,,0,0,0,,Менің осындай адамның рөлін ойнағанымды қалайсың ба?
Dialogue: 0,0:01:39.23,0:01:40.26,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:01:40.40,0:01:44.50,Default,,0,0,0,,Бала сияқты әрекет жасама, байсалды ойла
Dialogue: 0,0:01:44.60,0:01:46.73,Default,,0,0,0,,Бұл сіздің мүмкіндігіңіз
Dialogue: 0,0:01:46.87,0:01:50.37,Default,,0,0,0,,Квентин Тарантулино —
Dialogue: 0,0:01:50.47,0:01:53.64,Default,,0,0,0,,Сіз құлдырап бара жатқан актерлерді жаңғыртудың шеберісіз.
Dialogue: 0,0:01:53.71,0:01:56.68,Default,,0,0,0,,Сонда менің рөлім қандай?
Dialogue: 0,0:01:56.81,0:01:58.88,Default,,0,0,0,,Бұл Уоллес Шонның рөлі.
Dialogue: 0,0:01:59.18,0:02:03.28,Default,,0,0,0,,«Ханшайым қалыңдық» фильміндегі кішкентай жігіт?
Dialogue: 0,0:02:03.42,0:02:06.15,Default,,0,0,0,,Мен мұндай ақымақ ойнаудан бас тартамын.
Dialogue: 0,0:02:06.25,0:02:09.69,Default,,0,0,0,,Бірақ картиналарды жинау үшін ақша керек емес пе?
Dialogue: 0,0:02:10.43,0:02:11.69,Default,,0,0,0,,Мен ауырып тұрмын
Dialogue: 0,0:02:11.86,0:02:15.33,Default,,0,0,0,,Бұл маскүнемнің ішімдік сатып алуымен бірдей.
Dialogue: 0,0:02:15.43,0:02:18.70,Default,,0,0,0,,Шедевр келесі аптада аукционға қойылады.
Dialogue: 0,0:02:18.83,0:02:20.60,Default,,0,0,0,,Жарайды, мен істеймін.
Dialogue: 0,0:02:20.70,0:02:22.20,Default,,0,0,0,,Жарайды, мен істеймін.
Dialogue: 0,0:02:22.30,0:02:26.14,Default,,0,0,0,,Артыма қанды хабар қалдырып өлсем...
Dialogue: 0,0:02:26.21,0:02:28.61,Default,,0,0,0,,Бұл сен кінәлі.
Dialogue: 0,0:02:28.74,0:02:31.61,Default,,0,0,0,,...Сондықтан мен оны асыға күтемін.
Dialogue: 0,0:03:22.26,0:03:25.83,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:03:27.80,0:03:29.20,Default,,0,0,0,,Мүдделілер үшін.
Dialogue: 0,0:03:29.30,0:03:32.34,Default,,0,0,0,,Өз үйім болса да, түнгі сағат 3...
Dialogue: 0,0:03:32.44,0:03:35.91,Default,,0,0,0,,Адамдар келіп-кетіп жатыр, мен де шаршадым.
Dialogue: 0,0:03:36.21,0:03:38.25,Default,,0,0,0,,Мүдделілер үшін
Dialogue: 0,0:03:38.38,0:03:38.91,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:03:39.21,0:03:40.65,Default,,0,0,0,,Тойдан бері болды.
Dialogue: 0,0:03:40.78,0:03:43.52,Default,,0,0,0,,Жазғы демалыстан кейінгі мектеп сияқты
Dialogue: 0,0:03:43.72,0:03:45.49,Default,,0,0,0,,Атлетикалық клубты қолдау және т.б.
Dialogue: 0,0:03:45.59,0:03:47.96,Default,,0,0,0,,Маған математикадан үзіліс беруіңізді өтінемін.
Dialogue: 0,0:03:48.26,0:03:52.76,Default,,0,0,0,,Чирлидер «қыз шлюха» деп аталады—
Dialogue: 0,0:03:52.86,0:03:56.33,Default,,0,0,0,,Маңдайыма граффити бар.
Dialogue: 0,0:03:57.83,0:04:00.40,Default,,0,0,0,,Соңғы уақытта не істедіңіз?
Dialogue: 0,0:04:00.54,0:04:03.37,Default,,0,0,0,,Біз кафеде кездестік.
Dialogue: 0,0:04:03.47,0:04:04.54,Default,,0,0,0,,Даяшы?
Dialogue: 0,0:04:04.61,0:04:06.41,Default,,0,0,0,,Тіпті стейкхауста
Dialogue: 0,0:04:06.51,0:04:07.68,Default,,0,0,0,,Даяшы?
Dialogue: 0,0:04:07.81,0:04:09.68,Default,,0,0,0,,Сондай-ақ қытай мейрамханасында
Dialogue: 0,0:04:09.81,0:04:10.88,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:04:10.98,0:04:14.28,Default,,0,0,0,,Ол даяшы болғысы келетін жезөкше.
Dialogue: 0,0:04:14.88,0:04:20.26,Default,,0,0,0,,Сіз үйленгіңіз келетін адамды кездестіре аласыз деп үміттенемін.
Dialogue: 0,0:04:20.36,0:04:22.76,Default,,0,0,0,,Мен үйленемін бе? Мен небәрі 50 жастамын
Dialogue: 0,0:04:24.36,0:04:25.43,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:04:25.53,0:04:28.43,Default,,0,0,0,,Қолжазбаны бүгін Пинкиге жіберемін.
Dialogue: 0,0:04:28.56,0:04:29.36,Default,,0,0,0,,Орындалды ма?
Dialogue: 0,0:04:29.43,0:04:31.27,Default,,0,0,0,,Әлі жоқ, сәл ғана
Dialogue: 0,0:04:31.37,0:04:33.64,Default,,0,0,0,,Мен оны оқуды асыға күтемін.
Dialogue: 0,0:04:33.70,0:04:37.51,Default,,0,0,0,,Бірақ мен қатты қобалжыдым, құсқым келеді
Dialogue: 0,0:04:37.67,0:04:40.84,Default,,0,0,0,,Бірақ оның кесірінен менің ішім бос.
Dialogue: 0,0:04:40.94,0:04:43.34,Default,,0,0,0,,Мүдделілер үшін
Dialogue: 0,0:04:43.44,0:04:47.62,Default,,0,0,0,,Сіз оны менімен уақыт өткізгеннен кейін жаздыңыз.
Dialogue: 0,0:04:47.72,0:04:49.68,Default,,0,0,0,,Керемет кітап.
Dialogue: 0,0:04:49.75,0:04:53.35,Default,,0,0,0,,Актерлар кітаптарды бағалай алмайды.
Dialogue: 0,0:04:53.82,0:04:55.32,Default,,0,0,0,,«Гаррюдің ішкі тарихы»
Dialogue: 0,0:04:55.42,0:04:58.59,Default,,0,0,0,,Бүгінгі қонақ – Наоми Уоттс.
Dialogue: 0,0:04:58.69,0:05:01.46,Default,,0,0,0,,Неліктен Дайана рөлін сомдадың?
Dialogue: 0,0:05:01.60,0:05:05.83,Default,,0,0,0,,Маған үнемі үлкен фильмдер мен күрделі рөлдерге ұсыныстар түседі.
Dialogue: 0,0:05:05.90,0:05:08.00,Default,,0,0,0,,Романтикалық комедияларда көрінеді.
Dialogue: 0,0:05:08.34,0:05:11.61,Default,,0,0,0,,Мен жынды әйелді ойнағым келді.
Dialogue: 0,0:05:11.74,0:05:13.94,Default,,0,0,0,,Актриса болудың нағыз бақыты
Dialogue: 0,0:05:14.31,0:05:16.01,Default,,0,0,0,,Айтуға болатын көп нәрсе.
Dialogue: 0,0:05:16.31,0:05:19.55,Default,,0,0,0,,Түсірілімнен тыс рөлді ойнай аласыз ба?
Dialogue: 0,0:05:19.68,0:05:22.32,Default,,0,0,0,,Иә, дұрыс. Директордың нұсқауы бойынша.
Dialogue: 0,0:05:22.42,0:05:25.09,Default,,0,0,0,,Барлығы мені «Диана» деп атайды
Dialogue: 0,0:05:25.39,0:05:28.66,Default,,0,0,0,,Сіз оңай эмпатия жасай алатыныңыз жақсы.
Dialogue: 0,0:05:28.76,0:05:29.72,Default,,0,0,0,,Бүгін де әдемі көрінесің, Дайан.
Dialogue: 0,0:05:29.82,0:05:30.93,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:31.03,0:05:32.76,Default,,0,0,0,,Сіз емес
Dialogue: 0,0:05:32.89,0:05:34.36,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:34.50,0:05:35.56,Default,,0,0,0,,Жержаңғақ майы ше?
Dialogue: 0,0:05:35.66,0:05:36.46,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:05:36.56,0:05:37.83,Default,,0,0,0,,Жержаңғақ майы
Dialogue: 0,0:05:37.90,0:05:39.03,Default,,0,0,0,,БоДжек?
Dialogue: 0,0:05:39.10,0:05:41.37,Default,,0,0,0,,BoJack емес
Dialogue: 0,0:05:41.50,0:05:43.44,Default,,0,0,0,,Сіз маған қоңырау шалдыңыз ба?
Dialogue: 0,0:05:43.57,0:05:46.01,Default,,0,0,0,,Сізге рахмет, мен шатаспаймын.
Dialogue: 0,0:05:48.71,0:05:51.85,Default,,0,0,0,,Ойын-сауық әлемі керемет тең.
Dialogue: 0,0:05:52.01,0:05:53.75,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:53.82,0:05:55.12,Default,,0,0,0,,Бүріккіш
Dialogue: 0,0:05:55.38,0:05:56.02,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:05:57.95,0:06:00.92,Default,,0,0,0,,Бұл сіз түсірілімге бірінші рет қатысып жатырсыз ба?
Dialogue: 0,0:06:00.99,0:06:02.79,Default,,0,0,0,,Жержаңғақ майы жоқ
Dialogue: 0,0:06:02.89,0:06:05.49,Default,,0,0,0,,Тоқта, әкемнің аты сияқты естіледі.
Dialogue: 0,0:06:06.83,0:06:08.36,Default,,0,0,0,,Бұл менің де атым!
Dialogue: 0,0:06:09.50,0:06:11.43,Default,,0,0,0,,Ой, «мен» туралы айтсам—
Dialogue: 0,0:06:11.53,0:06:14.67,Default,,0,0,0,,Бір минут күтіңіз, шашыңыз.
Dialogue: 0,0:06:15.40,0:06:16.67,Default,,0,0,0,,<Сәлем достым>
Dialogue: 0,0:06:16.80,0:06:21.64,Default,,0,0,0,,Продюсер ретінде менің кеңесім бар.
Dialogue: 0,0:06:21.71,0:06:23.78,Default,,0,0,0,,Мен бір нәрсені байқадым
Dialogue: 0,0:06:23.91,0:06:27.12,Default,,0,0,0,,Ал, мәселе неде?
Dialogue: 0,0:06:27.42,0:06:29.82,Default,,0,0,0,,Бұл үлкен мәселе болды.
Dialogue: 0,0:06:29.92,0:06:33.55,Default,,0,0,0,,Сіз экипаж мойнын киіп алғансыз, солай емес пе?
Dialogue: 0,0:06:33.65,0:06:36.49,Default,,0,0,0,,Мен тек V-мойын киемін
Dialogue: 0,0:06:36.56,0:06:37.13,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:06:37.43,0:06:40.43,Default,,0,0,0,,Егер сіз суретке түссеңіз, шындыққа адал болуыңыз керек.
Dialogue: 0,0:06:40.56,0:06:42.70,Default,,0,0,0,,Әңгіменің өзі шындыққа жанаспайды
Dialogue: 0,0:06:42.80,0:06:44.10,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:06:44.87,0:06:45.97,Default,,0,0,0,,Себебі экипаж мойны...
Dialogue: 0,0:06:46.07,0:06:47.90,Default,,0,0,0,,Д-ны ұрлаған мен болдым.
Dialogue: 0,0:06:47.97,0:06:50.57,Default,,0,0,0,,Мен нағыз батырмын
Dialogue: 0,0:06:50.64,0:06:53.61,Default,,0,0,0,,Өмірбаяныңызды жариялауыңыз керек. Мен оны қазірдің өзінде жаздым.
Dialogue: 0,0:06:53.71,0:06:55.08,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:06:55.14,0:06:56.64,Default,,0,0,0,,Тым қызып кетпеңіз
Dialogue: 0,0:06:56.74,0:07:00.48,Default,,0,0,0,,Сізге экипаждың мойнына байланысты оттегі жетіспейді ме?
Dialogue: 0,0:07:00.62,0:07:02.12,Default,,0,0,0,,Мен тұтынушыға айтамын
Dialogue: 0,0:07:02.42,0:07:03.65,Default,,0,0,0,,Бірден шешілді
Dialogue: 0,0:07:03.75,0:07:04.65,Default,,0,0,0,,Донна
Dialogue: 0,0:07:08.62,0:07:09.49,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:09.59,0:07:12.76,Default,,0,0,0,,Мен сенің рөліңді ойнауға тырысамын
Dialogue: 0,0:07:12.89,0:07:14.13,Default,,0,0,0,,Қол қозғалысы дұрыс па?
Dialogue: 0,0:07:14.43,0:07:15.86,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:07:15.93,0:07:17.03,Default,,0,0,0,,Не қажет?
Dialogue: 0,0:07:17.17,0:07:18.70,Default,,0,0,0,,«Не қажет?»
Dialogue: 0,0:07:18.80,0:07:19.90,Default,,0,0,0,,Олар бір-біріне ұқсамайды.
Dialogue: 0,0:07:20.00,0:07:21.77,Default,,0,0,0,,«Олар бір-біріне ұқсамайды.»
Dialogue: 0,0:07:21.94,0:07:25.94,Default,,0,0,0,,Сіздің отбасылық өміріңіз қалай? Сіз армандағандайсыз ба?
Dialogue: 0,0:07:26.04,0:07:31.55,Default,,0,0,0,,Менің арманым – мені қорлағаны туралы әңгіме жазып, жүлде алу.
Dialogue: 0,0:07:31.85,0:07:32.58,Default,,0,0,0,,Иә
Dialogue: 0,0:07:32.65,0:07:36.15,Default,,0,0,0,,Рәсім жақсы өтті, бірақ бұл жай ғана рәсім.
Dialogue: 0,0:07:36.45,0:07:39.49,Default,,0,0,0,,Бұл бақытты аяқталса да—
Dialogue: 0,0:07:39.55,0:07:42.56,Default,,0,0,0,,Бұдан кейін өмір жалғасады.
Dialogue: 0,0:07:42.66,0:07:46.16,Default,,0,0,0,,Бақыттың асқар тауын тойда татқанмын, бірақ
Dialogue: 0,0:07:46.23,0:07:49.50,Default,,0,0,0,,Өмірдің алар асуы әлі алда
Dialogue: 0,0:07:49.90,0:07:53.50,Default,,0,0,0,,Біз Зоя типті логикамыз.
Dialogue: 0,0:07:56.00,0:07:58.04,Default,,0,0,0,,Тодд, мұны істеңіз.
Dialogue: 0,0:07:59.01,0:08:00.17,Default,,0,0,0,,Ол құлады.
Dialogue: 0,0:08:00.48,0:08:02.91,Default,,0,0,0,,Мұны байыппен қабылдаңыз
Dialogue: 0,0:08:03.04,0:08:06.01,Default,,0,0,0,,Кешіріңіз, BoJack Oh Peanut Butter
Dialogue: 0,0:08:06.71,0:08:09.02,Default,,0,0,0,,Мен жержаңғақ майының көмекшісімін.
Dialogue: 0,0:08:09.08,0:08:10.65,Default,,0,0,0,,Нағыз.
Dialogue: 0,0:08:11.49,0:08:16.19,Default,,0,0,0,,Бұл сайтта болудың тамаша мүмкіндігі.
Dialogue: 0,0:08:16.49,0:08:18.63,Default,,0,0,0,,Рок-операдан бері
Dialogue: 0,0:08:18.93,0:08:23.66,Default,,0,0,0,,Сол кезде сағынған балығың үлкен болды деп ойламайсың ба?
Dialogue: 0,0:08:24.80,0:08:29.50,Default,,0,0,0,,Ешқандай кедергі болған жоқ.
Dialogue: 0,0:08:30.14,0:08:32.17,Default,,0,0,0,,Ах, дәл солай.
Dialogue: 0,0:08:32.24,0:08:33.81,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:08:37.14,0:08:38.58,Default,,0,0,0,,Тамақ туралы не айтасыз?
Dialogue: 0,0:08:38.68,0:08:40.62,Default,,0,0,0,,Бұл ас үйде.
Dialogue: 0,0:08:40.68,0:08:43.82,Default,,0,0,0,,Жолмен жоғары көтеріліңіз, қонақ бөлмеден өтіңіз, ол сол жақта.
Dialogue: 0,0:08:43.89,0:08:46.82,Default,,0,0,0,,Мен барамын, ақымақтық жасама.
Dialogue: 0,0:08:47.22,0:08:50.69,Default,,0,0,0,,Маған бұл оқиға қатты ұнамайды.
Dialogue: 0,0:08:50.83,0:08:53.26,Default,,0,0,0,,Маған бірдеңе жетіспейтін сияқты
Dialogue: 0,0:08:53.83,0:08:55.93,Default,,0,0,0,,Музыканы қоссаңыз...
Dialogue: 0,0:08:56.03,0:08:58.23,Default,,0,0,0,,Музыка? Өзіңізді мазақ етпеңіз, жұмыстан шығарылдыңыз.
Dialogue: 0,0:08:58.30,0:08:59.83,Default,,0,0,0,,Кімнің бағыныңқысы?
Dialogue: 0,0:08:59.93,0:09:00.87,Default,,0,0,0,,Сіз де жұмыстан шығарылдыңыз.
Dialogue: 0,0:09:01.84,0:09:03.97,Default,,0,0,0,,Сіздің ойыңыз жоқ па?
Dialogue: 0,0:09:04.97,0:09:06.81,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:09:06.87,0:09:09.01,Default,,0,0,0,,Оны одан да Дайанға айналдырыңыз
Dialogue: 0,0:09:09.11,0:09:10.08,Default,,0,0,0,,Басқаша айтқанда?
Dialogue: 0,0:09:10.21,0:09:15.68,Default,,0,0,0,,Бұл әйелді жақсы көретін ер адам туралы әңгіме, солай ма?
Dialogue: 0,0:09:15.75,0:09:18.89,Default,,0,0,0,,Бірақ ол әйел жиі көрінбейді.
Dialogue: 0,0:09:18.99,0:09:23.72,Default,,0,0,0,,Неліктен оның жолдарын көбейтіп, сезімін көбірек бейнелемейміз?
Dialogue: 0,0:09:23.86,0:09:24.73,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:09:24.83,0:09:26.83,Default,,0,0,0,,Бұл жаңадан келген сұмдық.
Dialogue: 0,0:09:26.89,0:09:28.76,Default,,0,0,0,,Мені кешіріңіз.
Dialogue: 0,0:09:34.17,0:09:36.87,Default,,0,0,0,,Бұл керемет сияқты
Dialogue: 0,0:09:36.97,0:09:39.57,Default,,0,0,0,,Ол данышпан, сүйіп алайық.
Dialogue: 0,0:09:39.64,0:09:40.64,Default,,0,0,0,,Не болса да
Dialogue: 0,0:09:42.78,0:09:46.61,Default,,0,0,0,,Менің киім ауыстыратын бөлмемде Дайан туралы сөйлесейік.
Dialogue: 0,0:09:46.85,0:09:47.75,Default,,0,0,0,,Тодд
Dialogue: 0,0:09:47.82,0:09:51.15,Default,,0,0,0,,Костюмдер, әсіресе дененің жоғарғы бөлігі туралы айту
Dialogue: 0,0:09:51.22,0:09:53.99,Default,,0,0,0,,Әсіресе футболкалар туралы.
Dialogue: 0,0:09:54.09,0:09:57.29,Default,,0,0,0,,Жағаның пішініне шағымдану.
Dialogue: 0,0:09:59.33,0:10:00.90,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:10:00.96,0:10:02.90,Default,,0,0,0,,Пак!
Dialogue: 0,0:10:03.00,0:10:05.90,Default,,0,0,0,,Мен енді фильмдерді де, жержаңғақ майын да ұнатпаймын.
Dialogue: 0,0:10:06.03,0:10:07.64,Default,,0,0,0,,Қауынға толы
Dialogue: 0,0:10:07.77,0:10:09.14,Default,,0,0,0,,Мен қауындарды ұнатпаймын.
Dialogue: 0,0:10:09.24,0:10:12.34,Default,,0,0,0,,Ал менің рөлім кішкентай таз адам.
Dialogue: 0,0:10:12.64,0:10:13.77,Default,,0,0,0,,Бұл мен бе?
Dialogue: 0,0:10:13.91,0:10:17.31,Default,,0,0,0,,Бродвейде басты рөлді ойнайтын маған...
Dialogue: 0,0:10:17.65,0:10:22.65,Default,,0,0,0,,Сіз бұл қиын рөлді ойнауға күшім жоқ дейсіз бе?
Dialogue: 0,0:10:22.78,0:10:26.19,Default,,0,0,0,,Бұл үшін кешіріңіз.
Dialogue: 0,0:10:26.85,0:10:28.66,Default,,0,0,0,,Бірақ өмірбаян шықса —
Dialogue: 0,0:10:28.79,0:10:32.06,Default,,0,0,0,,Сенің шынайы болмысың әлемге ашылады
Dialogue: 0,0:10:32.16,0:10:34.83,Default,,0,0,0,,Өмірбаян? Мен білмедім
Dialogue: 0,0:10:34.96,0:10:37.10,Default,,0,0,0,,Тодд білген сияқты.
Dialogue: 0,0:10:37.23,0:10:38.67,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:38.77,0:10:41.37,Default,,0,0,0,,Оны ойынға ғашық етіңіз—
Dialogue: 0,0:10:41.67,0:10:44.94,Default,,0,0,0,,Олар рок операны жойды.
Dialogue: 0,0:10:45.04,0:10:46.21,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:46.34,0:10:47.64,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:10:47.74,0:10:50.21,Default,,0,0,0,,Ол кек алатын сияқты.
Dialogue: 0,0:10:50.34,0:10:54.22,Default,,0,0,0,,Соңғы кездері диверсия, кек алу туралы көп айтылып жүр.
Dialogue: 0,0:10:54.35,0:10:56.08,Default,,0,0,0,,Кек үшін кек алу?
Dialogue: 0,0:10:56.22,0:10:57.82,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:10:57.95,0:11:01.96,Default,,0,0,0,,Түсірілім кезінде мен жұмысыма назар аударамын.
Dialogue: 0,0:11:02.39,0:11:04.09,Default,,0,0,0,,Жаңа сценарий.
Dialogue: 0,0:11:04.19,0:11:06.76,Default,,0,0,0,,Сіздің жолдарыңыз менікі
Dialogue: 0,0:11:06.86,0:11:07.29,Default,,0,0,0,,Не?
Dialogue: 0,0:11:07.40,0:11:10.06,Default,,0,0,0,,Бұл Тодд есімді жігіттің кесірінен.
Dialogue: 0,0:11:10.16,0:11:14.07,Default,,0,0,0,,Саптарың азайып, менікі көбейді.
Dialogue: 0,0:11:14.37,0:11:18.71,Default,,0,0,0,,Бұл қала әйелдерді тым күрделі етеді.
Dialogue: 0,0:11:18.84,0:11:20.37,Default,,0,0,0,,Әрқашан осылай болады
Dialogue: 0,0:11:20.67,0:11:23.11,Default,,0,0,0,,Мен тағы да жақсы пікірлер алып жатырмын
Dialogue: 0,0:11:23.31,0:11:24.91,Default,,0,0,0,,Тодд жігіті
Dialogue: 0,0:11:26.25,0:11:30.72,Default,,0,0,0,,Осы жеті минуттық ұзын желімен айтқым келгені...
Dialogue: 0,0:11:31.12,0:11:34.92,Default,,0,0,0,,Өзіңді кешіру арқылы ғана әкеңді кешіре аласың.
Dialogue: 0,0:11:35.02,0:11:35.99,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:11:36.12,0:11:37.83,Default,,0,0,0,,Бірақ жеткілікті.
Dialogue: 0,0:11:37.93,0:11:41.13,Default,,0,0,0,,Бұл жұмыс істейді, өйткені біз екі мүлдем басқа адамбыз.
Dialogue: 0,0:11:41.26,0:11:43.00,Default,,0,0,0,,Мен шоколадпын
Dialogue: 0,0:11:43.13,0:11:46.13,Default,,0,0,0,,Сіз жержаңғақсыз
Dialogue: 0,0:11:46.23,0:11:47.13,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:11:48.70,0:11:50.00,Default,,0,0,0,,Кесу - ең жақсы
Dialogue: 0,0:11:50.27,0:11:53.94,Default,,0,0,0,,Мен көздеген фильмге жақындап келемін.
Dialogue: 0,0:11:54.31,0:11:57.01,Default,,0,0,0,,Төбеге шықпасаң, аштан өлесің.
Dialogue: 0,0:11:57.78,0:12:00.38,Default,,0,0,0,,Қазір басты кейіпкер Дайан сияқты.
Dialogue: 0,0:12:00.48,0:12:03.72,Default,,0,0,0,,Мен тереңірек түсінгім келеді
Dialogue: 0,0:12:03.82,0:12:06.15,Default,,0,0,0,,Толығырақ айтып беріңізші
Dialogue: 0,0:12:06.25,0:12:10.22,Default,,0,0,0,,Басың бос болғанша сөйлес
Dialogue: 0,0:12:10.32,0:12:15.30,Default,,0,0,0,,Мен барлық ойлар мен сезімдер менікі болғанын қалаймын.
Dialogue: 0,0:12:15.96,0:12:19.03,Default,,0,0,0,,Біздің сүйікті сусынымыз қандай?
Dialogue: 0,0:12:19.50,0:12:22.20,Default,,0,0,0,,Менің ойымша, бұл жақсы идея...
Dialogue: 0,0:12:22.30,0:12:26.04,Default,,0,0,0,,Ол сізбен сөйлесуіңіз керек, солай ма?
Dialogue: 0,0:12:26.34,0:12:29.01,Default,,0,0,0,,Дайан онымен сөйлескенді ұнатады.
Dialogue: 0,0:12:29.14,0:12:30.11,Default,,0,0,0,,Ең жақсы комбинация
Dialogue: 0,0:12:30.21,0:12:34.05,Default,,0,0,0,,Дайан онымен күні бойы сөйлеседі.
Dialogue: 0,0:12:34.15,0:12:36.32,Default,,0,0,0,,Менімен сөйлеспе
Dialogue: 0,0:12:36.45,0:12:41.02,Default,,0,0,0,,Дайанның өзімен өзі сөйлеспейтіні рас.
Dialogue: 0,0:12:41.12,0:12:42.09,Default,,0,0,0,,Сіз сөйлесіп отырған адам...
Dialogue: 0,0:12:42.19,0:12:44.19,Default,,0,0,0,,Дайаннан басқа адамдар
Dialogue: 0,0:12:44.43,0:12:45.36,Default,,0,0,0,,Тодд
Dialogue: 0,0:12:45.46,0:12:49.50,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:12:49.80,0:12:51.07,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:12:51.17,0:12:53.20,Default,,0,0,0,,Менің есіме енді...
Dialogue: 0,0:12:53.43,0:12:56.27,Default,,0,0,0,,Тоңазытқышта қытай тағамы бар.
Dialogue: 0,0:12:56.37,0:12:59.31,Default,,0,0,0,,Оны жеуге болады.
Dialogue: 0,0:12:59.41,0:13:00.94,Default,,0,0,0,,Өйткені біз доспыз
Dialogue: 0,0:13:01.44,0:13:02.98,Default,,0,0,0,,Сіз осында болдыңыз ба?
Dialogue: 0,0:13:03.11,0:13:05.11,Default,,0,0,0,,Ойыңыз бар ма?
Dialogue: 0,0:13:05.21,0:13:07.21,Default,,0,0,0,,БоДжек—
Dialogue: 0,0:13:07.31,0:13:10.99,Default,,0,0,0,,Оны ең нашар кейіпкерге айналдыруға қалай болады?
Dialogue: 0,0:13:11.12,0:13:12.22,Default,,0,0,0,,Бұл қажет пе?
Dialogue: 0,0:13:12.32,0:13:13.39,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:13:13.52,0:13:17.09,Default,,0,0,0,,Мені өзімшіл бейбақ ет.
Dialogue: 0,0:13:17.22,0:13:19.53,Default,,0,0,0,,Аудиторияда реніш тудыру
Dialogue: 0,0:13:19.86,0:13:23.23,Default,,0,0,0,,Жарайды, сценарийді қарап шығып, өзгертулер енгізейік.
Dialogue: 0,0:13:23.36,0:13:25.23,Default,,0,0,0,,Өзгерту үшін...
Dialogue: 0,0:13:25.33,0:13:26.47,Default,,0,0,0,,Оны артта қалдырыңыз
Dialogue: 0,0:13:26.57,0:13:28.37,Default,,0,0,0,,Сондай-ақ, мені қызықтыратын нәрсе -
Dialogue: 0,0:13:28.47,0:13:32.24,Default,,0,0,0,,Фильмді Жерде қою керек пе?
Dialogue: 0,0:13:32.37,0:13:34.88,Default,,0,0,0,,Бұл шынымен ақылсыз.
Dialogue: 0,0:13:34.98,0:13:35.91,Default,,0,0,0,,Жүлделерді ұтып алады
Dialogue: 0,0:13:36.01,0:13:39.11,Default,,0,0,0,,Қауын-чан, мен саған байланып қалдым
Dialogue: 0,0:13:39.25,0:13:41.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:41.25,0:13:44.45,Default,,0,0,0,,Бұл ауыр жағдай.
Dialogue: 0,0:13:44.55,0:13:46.22,Default,,0,0,0,,Мета-мета?
Dialogue: 0,0:13:46.42,0:13:50.02,Default,,0,0,0,,Басты кейіпкерге қауіп төніп тұр. Бұл фильм жақсы ма?
Dialogue: 0,0:13:50.16,0:13:51.36,Default,,0,0,0,,Мен оны жек көрдім
Dialogue: 0,0:13:51.46,0:13:56.53,Default,,0,0,0,,Ұнамаса да басты рөлді ойнаймын.
Dialogue: 0,0:13:56.83,0:13:59.93,Default,,0,0,0,,Мен де фильмнің бағытын жоғалтып алдым.
Dialogue: 0,0:14:00.03,0:14:04.31,Default,,0,0,0,,Неліктен мен бірінші кезекте экипаж мойнын киіп жүрмін?
Dialogue: 0,0:14:04.41,0:14:05.41,Default,,0,0,0,,Екінші нәрсе...
Dialogue: 0,0:14:07.07,0:14:08.24,Default,,0,0,0,,Ол жерде жоқ.
Dialogue: 0,0:14:08.34,0:14:10.91,Default,,0,0,0,,Мен міндетті түрде V-мойынның жанкүйерімін.
Dialogue: 0,0:14:11.01,0:14:15.88,Default,,0,0,0,,Сіз тіпті мойыны бар күннен қорғайтын көзілдірік кие алмайсыз...
Dialogue: 0,0:14:16.02,0:14:17.28,Default,,0,0,0,,Сол сияқты
Dialogue: 0,0:14:21.16,0:14:22.02,Default,,0,0,0,,Багель…
Dialogue: 0,0:14:22.89,0:14:24.63,Default,,0,0,0,,Сіздің арқаңызда мен жаттыға алдым.
Dialogue: 0,0:14:24.93,0:14:27.13,Default,,0,0,0,,Жолдар өте көп.
Dialogue: 0,0:14:27.23,0:14:29.30,Default,,0,0,0,,Мен туралы бәрі «дәл солай».
Dialogue: 0,0:14:29.43,0:14:31.33,Default,,0,0,0,,Бірақ мен сенімен бірге шығамын.
Dialogue: 0,0:14:31.43,0:14:34.54,Default,,0,0,0,,«D планетасының халқы өз патшасының қайтып келуін күтуде».
Dialogue: 0,0:14:34.64,0:14:37.10,Default,,0,0,0,,«Мен қорғалғанмын және жасырынамын».
Dialogue: 0,0:14:37.20,0:14:40.54,Default,,0,0,0,,«Мен жоғалтқан сенімімді қайтарғым келеді».
Dialogue: 0,0:14:40.88,0:14:41.58,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:14:41.91,0:14:44.35,Default,,0,0,0,,Бұл фильм ақылсыз
Dialogue: 0,0:14:44.45,0:14:47.95,Default,,0,0,0,,Дәйексөзді келтіріңіз: «Дұрыс».
Dialogue: 0,0:14:48.05,0:14:52.29,Default,,0,0,0,,Үнемі осылай, алаңсыз рөл ойнайды.
Dialogue: 0,0:14:52.39,0:14:56.92,Default,,0,0,0,,Мұңды шын өмірімді ұмытқым келеді
Dialogue: 0,0:14:57.02,0:14:58.96,Default,,0,0,0,,Сіз білмейсіз.
Dialogue: 0,0:14:59.09,0:15:02.23,Default,,0,0,0,,Менің өмірім қайғыға толы
Dialogue: 0,0:15:02.33,0:15:05.20,Default,,0,0,0,,Көз жасы көлі пайда болғаны сонша
Dialogue: 0,0:15:05.33,0:15:07.60,Default,,0,0,0,,Үніңді жап, мені сүй, ақымақ.
Dialogue: 0,0:15:07.90,0:15:08.34,Default,,0,0,0,,Не?
Dialogue: 0,0:15:09.14,0:15:10.47,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:12.31,0:15:13.61,Default,,0,0,0,,Бұл жәшікте
Dialogue: 0,0:15:19.65,0:15:21.28,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:15:21.38,0:15:22.98,Default,,0,0,0,,Наоми, ең жақсы...
Dialogue: 0,0:15:23.08,0:15:24.45,Default,,0,0,0,,Жоқ, солай ма?
Dialogue: 0,0:15:24.55,0:15:26.35,Default,,0,0,0,,Маған Дайан деп қоңырау шалыңыз
Dialogue: 0,0:15:29.12,0:15:31.49,Default,,0,0,0,,Жарайды, жұмысқа қайта оралайық.
Dialogue: 0,0:15:31.96,0:15:33.03,Default,,0,0,0,,Эй
Dialogue: 0,0:15:33.96,0:15:35.16,Default,,0,0,0,,Екі адам
Dialogue: 0,0:15:37.63,0:15:41.54,Default,,0,0,0,,О, біз оны шынымен таптық.
Dialogue: 0,0:15:41.64,0:15:43.40,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:15:43.54,0:15:45.71,Default,,0,0,0,,Түсірілім алдында ваннаға бару керек пе?
Dialogue: 0,0:15:46.01,0:15:47.21,Default,,0,0,0,,Сіз ойларды оқи аласыз ба?
Dialogue: 0,0:15:47.31,0:15:49.61,Default,,0,0,0,,Қаймақпен сүйісу
Dialogue: 0,0:15:51.15,0:15:54.65,Default,,0,0,0,,Тыңдаңдар, мен қолжазбаны баспаға жібердім.
Dialogue: 0,0:15:54.98,0:15:56.98,Default,,0,0,0,,Жазуды аяқтадыңыз ба? Мен оны оқығым келеді
Dialogue: 0,0:15:57.12,0:16:00.39,Default,,0,0,0,,Пинкиге айтыңыз, ол сізге жібереді.
Dialogue: 0,0:16:00.52,0:16:01.32,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:16:01.42,0:16:02.39,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:16:02.52,0:16:04.12,Default,,0,0,0,,Хит жұмыс жасалды.
Dialogue: 0,0:16:04.26,0:16:08.00,Default,,0,0,0,,Оқып болғаннан кейін, сіз байқаған боларсыз.
Dialogue: 0,0:16:08.13,0:16:11.27,Default,,0,0,0,,Ләззат ал, бірақ жомарт жүрекпен оқы
Dialogue: 0,0:16:11.43,0:16:13.03,Default,,0,0,0,,«Пингвин баспагерлері»
Dialogue: 0,0:16:14.37,0:16:15.70,Default,,0,0,0,,Penguin Publishers
Dialogue: 0,0:16:16.04,0:16:19.07,Default,,0,0,0,,Кеспе үйі қарызды талап ететін орын.
Dialogue: 0,0:16:19.17,0:16:21.04,Default,,0,0,0,,Түскі ас алғыңыз келе ме?
Dialogue: 0,0:16:21.18,0:16:23.41,Default,,0,0,0,,Бұл менмін. Мен сіздің өмірбаяныңызды оқығым келеді.
Dialogue: 0,0:16:23.71,0:16:27.25,Default,,0,0,0,,Айтайын, бұл мен күткеннен басқаша.
Dialogue: 0,0:16:27.35,0:16:28.98,Default,,0,0,0,,Бірақ бұл жақсы.
Dialogue: 0,0:16:29.08,0:16:32.69,Default,,0,0,0,,Бұл жолы хит болып, баламды кездестіремін.
Dialogue: 0,0:16:33.05,0:16:34.56,Default,,0,0,0,,Тез жіберіңізші.
Dialogue: 0,0:16:34.69,0:16:36.99,Default,,0,0,0,,Жіберу керек пе?
Dialogue: 0,0:16:37.09,0:16:40.43,Default,,0,0,0,,Бұл мен ойлағаннан да жақсы.
Dialogue: 0,0:16:41.00,0:16:43.23,Default,,0,0,0,,Жарайды, тез оқып шығайын.
Dialogue: 0,0:16:43.33,0:16:45.57,Default,,0,0,0,,Бұл менің шынайы пішінім.
Dialogue: 0,0:16:46.27,0:16:47.53,Default,,0,0,0,,«Бір қулықта озған ат».
Dialogue: 0,0:16:47.74,0:16:53.14,Default,,0,0,0,,«БоДжек балконда кәмпиттерді лақтырып жатыр еді».
Dialogue: 0,0:16:53.57,0:16:55.11,Default,,0,0,0,,«Қала шамдарымен жарықтандырылған»
Dialogue: 0,0:16:55.21,0:16:59.11,Default,,0,0,0,,«Ата-анасы БоДжекке айналған балалар...»
Dialogue: 0,0:16:59.21,0:17:02.12,Default,,0,0,0,,«Сізді қорлағаныңызды ешқашан ұмытпаңыз».
Dialogue: 0,0:17:02.22,0:17:05.42,Default,,0,0,0,,«Мен сөйлей беремін, өйткені мен үнсіздіктен қорқамын»
Dialogue: 0,0:17:05.52,0:17:09.46,Default,,0,0,0,,«Олар сәтсіздіктері әшкере болады деп қорқады».
Dialogue: 0,0:17:10.06,0:17:12.59,Default,,0,0,0,,«Бірақ мен сәтсіздікті қалпына келтіруге тырыспаймын».
Dialogue: 0,0:17:12.73,0:17:17.20,Default,,0,0,0,,«Мен көліктен түсіп, мұхитқа қарадым».
Dialogue: 0,0:17:17.60,0:17:19.70,Default,,0,0,0,,«Аузыңды жабық ұста»
Dialogue: 0,0:17:21.20,0:17:23.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:24.27,0:17:25.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:26.07,0:17:29.41,Default,,0,0,0,,Смартфон? Бұл шағын компьютер.
Dialogue: 0,0:17:29.51,0:17:32.31,Default,,0,0,0,,Сіз жазған нәрсе —
Dialogue: 0,0:17:32.41,0:17:35.48,Default,,0,0,0,,Бұл бейбақ рекорды болды ма?
Dialogue: 0,0:17:35.62,0:17:39.82,Default,,0,0,0,,Менің ойымша, әркім өзінің күшті және әлсіз жақтарын жазуы керек.
Dialogue: 0,0:17:40.15,0:17:43.16,Default,,0,0,0,,Сұлулық қайда? Барлығы кемшіліктер
Dialogue: 0,0:17:43.29,0:17:44.53,Default,,0,0,0,,Бұл гей жігіт туралы кітап.
Dialogue: 0,0:17:44.66,0:17:47.39,Default,,0,0,0,,Себебі сізде проблема бар
Dialogue: 0,0:17:47.49,0:17:50.36,Default,,0,0,0,,Сіз қарым-қатынас жасай алмайсыз ба?
Dialogue: 0,0:17:50.50,0:17:53.43,Default,,0,0,0,,Қуырылған алма туралы да тарау болды.
Dialogue: 0,0:17:53.53,0:17:55.10,Default,,0,0,0,,Сізге ұнайды, солай ма?
Dialogue: 0,0:17:55.20,0:17:56.60,Default,,0,0,0,,Сіз мұны осылай көрдіңіз бе?
Dialogue: 0,0:17:56.70,0:17:59.21,Default,,0,0,0,,Көңілді саяхат туралы—
Dialogue: 0,0:17:59.31,0:18:02.78,Default,,0,0,0,,Мен тек жылататын нәрселер туралы жазамын.
Dialogue: 0,0:18:03.08,0:18:04.21,Default,,0,0,0,,Бұл эмоционалды болды.
Dialogue: 0,0:18:04.34,0:18:07.78,Default,,0,0,0,,Менің фотосуретім жойылды.
Dialogue: 0,0:18:08.08,0:18:11.25,Default,,0,0,0,,Бұл кітап сіздің өміріңізді өзгертеді.
Dialogue: 0,0:18:11.52,0:18:15.12,Default,,0,0,0,,Актерлар кітапты білмейді, солай ма?
Dialogue: 0,0:18:16.36,0:18:16.79,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:18:17.09,0:18:18.43,Default,,0,0,0,,Сіздің сөздеріңіз
Dialogue: 0,0:18:18.53,0:18:20.39,Default,,0,0,0,,Өз ұстанымыңызды қарастырыңыз
Dialogue: 0,0:18:20.53,0:18:23.23,Default,,0,0,0,,Бұл достар арасындағы әңгіме емес.
Dialogue: 0,0:18:23.36,0:18:27.40,Default,,0,0,0,,Бастық өзінің қабілетсіз бағыныштыларына ашуланады.
Dialogue: 0,0:18:27.50,0:18:28.40,Default,,0,0,0,,Қайта жазу
Dialogue: 0,0:18:28.50,0:18:29.14,Default,,0,0,0,,Не?
Dialogue: 0,0:18:29.24,0:18:31.31,Default,,0,0,0,,Барлығын қайта жазыңыз
Dialogue: 0,0:18:31.41,0:18:33.17,Default,,0,0,0,,Бұл сөреге қалдырылды.
Dialogue: 0,0:18:39.41,0:18:40.15,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:18:40.25,0:18:41.78,Default,,0,0,0,,Интернеттегі мақалалар?
Dialogue: 0,0:18:42.12,0:18:43.25,Default,,0,0,0,,Мен жазып жатырмын
Dialogue: 0,0:18:43.38,0:18:48.56,Default,,0,0,0,,«Ұнату» дауылы болуы мүмкін оқиға бар
Dialogue: 0,0:18:48.66,0:18:51.43,Default,,0,0,0,,Мен оны сізге айтып беремін
Dialogue: 0,0:18:52.23,0:18:52.66,Default,,0,0,0,,Бұл қарғыс
Dialogue: 0,0:18:53.16,0:18:56.30,Default,,0,0,0,,Мен бір күні қайтамын
Dialogue: 0,0:18:56.43,0:19:00.53,Default,,0,0,0,,Зұлым император Божакитрон өлмейтін.
Dialogue: 0,0:19:01.30,0:19:03.57,Default,,0,0,0,,Алыс, мылтықты қойыңыз.
Dialogue: 0,0:19:03.70,0:19:05.41,Default,,0,0,0,,Сен өлесің
Dialogue: 0,0:19:05.51,0:19:07.77,Default,,0,0,0,,Әзірше осы.
Dialogue: 0,0:19:08.18,0:19:12.48,Default,,0,0,0,,Осылайша біз зұлым императордың құрсауынан құтылдық.
Dialogue: 0,0:19:12.61,0:19:15.22,Default,,0,0,0,,Ол болуы керек табиғи күйге айналды.
Dialogue: 0,0:19:15.32,0:19:17.58,Default,,0,0,0,,Қалқымалы жарық сақинасы
Dialogue: 0,0:19:17.85,0:19:18.72,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:19:18.92,0:19:20.15,Default,,0,0,0,,Кесу
Dialogue: 0,0:19:20.25,0:19:23.72,Default,,0,0,0,,Бұл тым ақымақ. Киноның мәні неде?
Dialogue: 0,0:19:23.86,0:19:26.79,Default,,0,0,0,,Ол қазірдің өзінде фильмдер шеңберінен шығып кетті.
Dialogue: 0,0:19:26.89,0:19:29.46,Default,,0,0,0,,Смартфон қолданбалары және т.б.
Dialogue: 0,0:19:29.60,0:19:34.43,Default,,0,0,0,,Біз ХХІ ғасырдағы БАҚ-қа бір қадам жақындауымыз мүмкін
Dialogue: 0,0:19:34.60,0:19:38.44,Default,,0,0,0,,Немесе сезім сияқты нәрсе.
Dialogue: 0,0:19:38.54,0:19:39.54,Default,,0,0,0,,Маған тыңдауға рұқсат етіңіз
Dialogue: 0,0:19:39.67,0:19:41.21,Default,,0,0,0,,Параметрлер жақсы.
Dialogue: 0,0:19:41.34,0:19:43.61,Default,,0,0,0,,Бұл керемет, Тодд.
Dialogue: 0,0:19:44.21,0:19:46.45,Default,,0,0,0,,Маған не болады?
Dialogue: 0,0:19:46.75,0:19:47.55,Default,,0,0,0,,Мен ондай адамды білмеймін.
Dialogue: 0,0:19:50.42,0:19:51.22,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:19:51.39,0:19:52.52,Default,,0,0,0,,Боджак
Dialogue: 0,0:19:52.62,0:19:53.95,Default,,0,0,0,,Бұл ең нашар күн.
Dialogue: 0,0:19:54.29,0:19:57.49,Default,,0,0,0,,Жантүршігерлік өмірбаянға арналған ең нашар фильм
Dialogue: 0,0:19:57.59,0:19:59.89,Default,,0,0,0,,Бір ғана жақсы нәрсе...
Dialogue: 0,0:20:00.23,0:20:00.93,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:20:01.23,0:20:02.20,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:20:02.30,0:20:03.83,Default,,0,0,0,,Шын мәнінде мектеп автобусымен келдің бе?
Dialogue: 0,0:20:03.93,0:20:04.73,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:20:04.87,0:20:09.27,Default,,0,0,0,,Ат өрісті аралап жүрді, бірақ родеодан шаршады.
Dialogue: 0,0:20:09.37,0:20:10.90,Default,,0,0,0,,Ершікті қоятын уақыт...
Dialogue: 0,0:20:11.21,0:20:11.87,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:20:11.97,0:20:17.21,Default,,0,0,0,,Мына жабайы жылқы сен деген лашықта демалғысы келеді.
Dialogue: 0,0:20:17.31,0:20:18.65,Default,,0,0,0,,Түсінемін
Dialogue: 0,0:20:18.78,0:20:19.98,Default,,0,0,0,,Мен сені жақсы көремін Наоми
Dialogue: 0,0:20:20.28,0:20:24.35,Default,,0,0,0,,Мені жұмыстан шығарды, жұмысымды таяқтағы доп алып кетті.
Dialogue: 0,0:20:24.48,0:20:25.45,Default,,0,0,0,,Бұл қорқынышты оқиға.
Dialogue: 0,0:20:25.55,0:20:29.26,Default,,0,0,0,,Бірақ бұдан былай біз екеуміз ғана бола аламыз.
Dialogue: 0,0:20:29.36,0:20:30.72,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:20:30.92,0:20:31.86,Default,,0,0,0,,Ер адамдар бірдей
Dialogue: 0,0:20:31.99,0:20:33.93,Default,,0,0,0,,Мұқият тыңдаңыз
Dialogue: 0,0:20:34.26,0:20:38.27,Default,,0,0,0,,Мен онымен Диананы ойнау үшін сөйлестім.
Dialogue: 0,0:20:38.37,0:20:41.80,Default,,0,0,0,,Түсірілім аяқталды, Наоми ретінде...
Dialogue: 0,0:20:41.94,0:20:44.27,Default,,0,0,0,,Мен саған қызық емеспін
Dialogue: 0,0:20:44.40,0:20:46.91,Default,,0,0,0,,Дәлірек айтсақ, бұл жиіркенішті.
Dialogue: 0,0:20:47.01,0:20:49.38,Default,,0,0,0,,Мен Наомиді жақсы көремін деп ойладым, бірақ...
Dialogue: 0,0:20:49.48,0:20:51.71,Default,,0,0,0,,Басқа адам Дайан болатын.
Dialogue: 0,0:20:51.81,0:20:54.41,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:54.55,0:20:55.88,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:20:56.58,0:20:58.95,Default,,0,0,0,,Мен ештеңе сезбеймін.
Dialogue: 0,0:21:03.29,0:21:04.69,Default,,0,0,0,,Неліктен қайтарып алу керек?
Dialogue: 0,0:21:04.83,0:21:06.79,Default,,0,0,0,,Таңғажайып нәрсе болды
Dialogue: 0,0:21:06.89,0:21:09.56,Default,,0,0,0,,Бұл фильм дамыды.
Dialogue: 0,0:21:09.66,0:21:10.70,Default,,0,0,0,,Біраз.
Dialogue: 0,0:21:10.83,0:21:15.27,Default,,0,0,0,,Интерактивті әлеуметтік медиа тәжірибесі
Dialogue: 0,0:21:15.40,0:21:16.94,Default,,0,0,0,,Ақымаққа ұқсайды
Dialogue: 0,0:21:17.04,0:21:17.70,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:21:17.87,0:21:21.41,Default,,0,0,0,,Мен қалқымалы өнер болуы мүмкін деп ойладым, бірақ...
Dialogue: 0,0:21:21.51,0:21:22.81,Default,,0,0,0,,Бұл басқаша болды.
Dialogue: 0,0:21:22.91,0:21:24.58,Default,,0,0,0,,Немесе парфюмерия
Dialogue: 0,0:21:24.68,0:21:26.61,Default,,0,0,0,,Бақытты печенье және т.б.
Dialogue: 0,0:21:26.71,0:21:29.48,Default,,0,0,0,,Қалпақ ретінде де пайдалануға болатын қайық
Dialogue: 0,0:21:29.58,0:21:30.72,Default,,0,0,0,,Барлығы әртүрлі
Dialogue: 0,0:21:30.85,0:21:34.32,Default,,0,0,0,,Дұрыс және бұл аяқталды.
Dialogue: 0,0:21:35.76,0:21:36.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:36.72,0:21:40.33,Default,,0,0,0,,Бұл екі ай сайын жеткізілетін тәттілер жиынтығы.
Dialogue: 0,0:21:40.49,0:21:41.33,Default,,0,0,0,,Оның мағынасы жоқ
Dialogue: 0,0:21:41.46,0:21:42.83,Default,,0,0,0,,Бұл түсініксіз.
Dialogue: 0,0:21:42.93,0:21:46.83,Default,,0,0,0,,Екі айда бір айда екі рет дегенді білдірмейді.
Dialogue: 0,0:21:47.37,0:21:49.90,Default,,0,0,0,,Екі айда бір рет жеткізілетін тәттілер
Dialogue: 0,0:21:50.00,0:21:52.37,Default,,0,0,0,,Бұл фильмдердің келер шақ.
Dialogue: 0,0:21:52.47,0:21:53.47,Default,,0,0,0,,Күте тұр… Демек, мені соңында ұмытып қалдыңдар ма?
Dialogue: 0,0:21:54.31,0:21:56.48,Default,,0,0,0,,Менің әңгімем аяқталды
Dialogue: 0,0:21:56.58,0:21:58.61,Default,,0,0,0,,Айналдыру.
Dialogue: 0,0:21:59.48,0:22:02.35,Default,,0,0,0,,Бұл шынайы кәмпит жинағы.
Dialogue: 0,0:22:02.45,0:22:03.38,Default,,0,0,0,,Үйге қайтайық.
Dialogue: 0,0:22:05.42,0:22:07.52,Default,,0,0,0,,Түсірілім қалай өтті?
Dialogue: 0,0:22:08.32,0:22:09.89,Default,,0,0,0,,Тәттіге толы.
Dialogue: 0,0:22:11.79,0:22:12.63,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:22:13.43,0:22:17.66,Default,,0,0,0,,Сіз менің мүмкіндігімді кек ретінде жойдыңыз деп ойлаймын.
Dialogue: 0,0:22:17.76,0:22:21.67,Default,,0,0,0,,Кек алу? Менде ештеңе болмады
Dialogue: 0,0:22:21.77,0:22:22.84,Default,,0,0,0,,Мен ақымақпын
Dialogue: 0,0:22:22.94,0:22:27.64,Default,,0,0,0,,Сол кездегі ренішімді жуып, жұмысыма ден қойдым.
Dialogue: 0,0:22:27.81,0:22:30.64,Default,,0,0,0,,Бұл кек алу емес пе еді?
Dialogue: 0,0:22:30.78,0:22:31.38,Default,,0,0,0,,Жоқ
Dialogue: 0,0:22:31.51,0:22:36.62,Default,,0,0,0,,Мені өшпенділік танытқаның үшін емес пе?
Dialogue: 0,0:22:36.72,0:22:37.42,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:22:37.58,0:22:39.09,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:22:39.42,0:22:42.39,Default,,0,0,0,,Арамыздағы алшақтық жойылғанына қуаныштымын.
Dialogue: 0,0:22:42.52,0:22:46.06,Default,,0,0,0,,Мен алшақтықты жоюға тырыспаймын.
Dialogue: 0,0:22:46.39,0:22:49.76,Default,,0,0,0,,Ойынға ену үшін Маргоды пайдаланыңыз—
Dialogue: 0,0:22:49.86,0:22:51.90,Default,,0,0,0,,Сіз менің жолыма бөгет болдыңыз.
Dialogue: 0,0:22:52.07,0:22:55.67,Default,,0,0,0,,Оны сөзбен жеткізу ақымақ сияқты, бірақ...
Dialogue: 0,0:22:55.77,0:22:58.44,Default,,0,0,0,,Бұл мен үшін маңызды
Dialogue: 0,0:22:58.54,0:23:00.94,Default,,0,0,0,,Мен қатты қиналдым.
Dialogue: 0,0:23:01.07,0:23:03.08,Default,,0,0,0,,Мен ең нашармын.
Dialogue: 0,0:23:03.54,0:23:05.75,Default,,0,0,0,,Сіз кек ала аласыз.
Dialogue: 0,0:23:05.85,0:23:07.75,Default,,0,0,0,,Маған бір рет атыңыз.
Dialogue: 0,0:23:07.85,0:23:08.55,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:23:08.68,0:23:12.55,Default,,0,0,0,,Ескі попкорнды жеңіз.
Dialogue: 0,0:23:13.59,0:23:14.49,Default,,0,0,0,,Боджак
Dialogue: 0,0:23:14.59,0:23:15.06,Default,,0,0,0,,Не?
Dialogue: 0,0:23:15.39,0:23:16.66,Default,,0,0,0,,Қуырылған алма ше?
Dialogue: 0,0:23:17.46,0:23:18.02,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:23:18.13,0:23:19.53,Default,,0,0,0,,Ал… біз Карт Титанмен біріктік ➡
Dialogue: 0,0:23:19.73,0:23:21.43,Default,,0,0,0,,Бұл менің сүйікті тағамым.
Dialogue: 0,0:23:21.60,0:23:22.93,Default,,0,0,0,,...
Dialogue: 0,0:23:23.03,0:23:25.10,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:23:26.03,0:23:28.67,Default,,0,0,0,,«BoJack туралы таң қалдыратын 5 факт?»
Dialogue: 0,0:23:28.80,0:23:29.74,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:23:29.84,0:23:32.97,Default,,0,0,0,,Интернетке қарамаңыз
Dialogue: 0,0:23:33.11,0:23:34.84,Default,,0,0,0,,Ол сынған.
Dialogue: 0,0:23:34.98,0:23:36.68,Default,,0,0,0,,Қолжетімсіз
Dialogue: 0,0:23:36.98,0:23:37.58,Default,,0,0,0,,Жеңілген жылқы
Dialogue: 0,0:23:37.71,0:23:38.85,Default,,0,0,0,,Бұл қайғылы жағдай.
Dialogue: 0,0:23:38.98,0:23:39.71,Default,,0,0,0,,Мені бер
Dialogue: 0,0:23:39.85,0:23:41.48,Default,,0,0,0,,Атақты адамдарды бақылаңыз
Dialogue: 0,0:23:41.72,0:23:43.58,Default,,0,0,0,,«Қайғыға толы»?
Dialogue: 0,0:23:43.72,0:23:45.59,Default,,0,0,0,,Бұл мені күлдіреді
Dialogue: 0,0:23:45.75,0:23:47.72,Default,,0,0,0,,Маған қарама
Dialogue: 0,0:23:47.85,0:23:49.59,Default,,0,0,0,,Мен атақтымын
Dialogue: 0,0:23:50.56,0:23:51.16,Default,,0,0,0,,Эй
Dialogue: 0,0:23:51.46,0:23:53.59,Default,,0,0,0,,Сабырлы түрде тыңдаңыз
Dialogue: 0,0:23:53.69,0:23:54.93,Default,,0,0,0,,Оны көпшілікке қалай жариялауға батылыңыз бар?
Dialogue: 0,0:23:55.03,0:23:58.60,Default,,0,0,0,,Мен алғашқы екі тарауды эфирге шығарған кезде, ол вирусқа айналды.
Dialogue: 0,0:23:58.73,0:24:01.60,Default,,0,0,0,,Бұл кәсіпқойлар айналысатын нәрсе ме?
Dialogue: 0,0:24:01.74,0:24:03.77,Default,,0,0,0,,Ашулану табиғи нәрсе.
Dialogue: 0,0:24:03.87,0:24:06.74,Default,,0,0,0,,Бірақ оң пікірлер де көп.
Dialogue: 0,0:24:06.87,0:24:09.51,Default,,0,0,0,,Менің кітабым жанкүйерлер санын көбейтеді.
Dialogue: 0,0:24:09.64,0:24:10.71,Default,,0,0,0,,Сіздің кітабыңыз?
Dialogue: 0,0:24:10.81,0:24:11.85,Default,,0,0,0,,Біздің кітаптар
Dialogue: 0,0:24:11.95,0:24:13.75,Default,,0,0,0,,Кітап әлемге шықпайды.
Dialogue: 0,0:24:13.88,0:24:17.02,Default,,0,0,0,,Мен оны басып шығаруға рұқсат беруім керек пе?
Dialogue: 0,0:24:17.15,0:24:19.52,Default,,0,0,0,,Мен өз жұмысымды орындадым
Dialogue: 0,0:24:19.62,0:24:21.15,Default,,0,0,0,,Менің ойымша, бұл жақсы кітап.
Dialogue: 0,0:24:21.49,0:24:23.89,Default,,0,0,0,,Ақырында түсінесіз.
Dialogue: 0,0:24:26.53,0:24:27.63,Default,,0,0,0,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың, иә?
Dialogue: 0,0:24:27.79,0:24:28.70,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:24:29.13,0:24:30.90,Default,,0,0,0,,Бірақ сіз жұмыстан шығарылдыңыз.
Dialogue: 0,0:24:32.40,0:24:38.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
