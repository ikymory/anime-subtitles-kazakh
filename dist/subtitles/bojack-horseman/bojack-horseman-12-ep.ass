Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:06.67,Default,,0,0,0,,NETFLIX түпнұсқа жұмысы
Dialogue: 0,0:00:06.67,0:00:07.74,Default,,0,0,0,,NETFLIX түпнұсқа жұмыстары
Dialogue: 0,0:00:06.67,0:00:07.74,Default,,0,0,0,,Сыртқы түрі ат үштік тәжді жеңіп алған кезде шешілді.
Dialogue: 0,0:00:07.74,0:00:10.21,Default,,0,0,0,,Сыртқы түрі ат үштік тәжді жеңіп алған кезде шешілді.
Dialogue: 0,0:00:10.61,0:00:14.44,Default,,0,0,0,,Бұл аптаның газеті.
Dialogue: 0,0:00:14.51,0:00:17.11,Default,,0,0,0,,«Хатшылықтан жауап алу»
Dialogue: 0,0:00:17.18,0:00:18.61,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:00:17.18,0:00:18.61,Default,,0,0,0,,«Дик Каветт шоуы»
Dialogue: 0,0:00:18.61,0:00:18.68,Default,,0,0,0,,«Дик Каветт шоуы»
Dialogue: 0,0:00:18.68,0:00:20.78,Default,,0,0,0,,«Дик Каветт шоуы»
Dialogue: 0,0:00:18.68,0:00:20.78,Default,,0,0,0,,Басқа хатшылық?
Dialogue: 0,0:00:21.72,0:00:26.09,Default,,0,0,0,,Негізінде бұл негізсіз.
Dialogue: 0,0:00:26.15,0:00:28.52,Default,,0,0,0,,Мен ат жарысына ешқашан бәс тіккен емеспін.
Dialogue: 0,0:00:28.62,0:00:30.59,Default,,0,0,0,,Тіпті өз нәсілім үшін.
Dialogue: 0,0:00:31.06,0:00:34.13,Default,,0,0,0,,Мен шоудың тоқтатылуына бәс тігемін.
Dialogue: 0,0:00:34.56,0:00:35.76,Default,,0,0,0,,Сонымен, сетте алты ойынды бірінші жеңген адам жеңеді, иә?
Dialogue: 0,0:00:36.06,0:00:39.10,Default,,0,0,0,,Көрермендердің хаттарымен таныстыру.
Dialogue: 0,0:00:39.17,0:00:42.07,Default,,0,0,0,,Менің саған жазған хатым бар сияқты.
Dialogue: 0,0:00:42.20,0:00:45.14,Default,,0,0,0,,Бұл 9 жасар БоДжектің хаты.
Dialogue: 0,0:00:45.54,0:00:49.41,Default,,0,0,0,,«Хатшылық мырза, мен жылқымын».
Dialogue: 0,0:00:49.48,0:00:52.45,Default,,0,0,0,,«Ең жақсы жүйрік — сен»
Dialogue: 0,0:00:52.51,0:00:53.35,Default,,0,0,0,,Ол ақылды бала.
Dialogue: 0,0:00:53.45,0:00:55.52,Default,,0,0,0,,«Менің болашақтағы арманым сенсің»
Dialogue: 0,0:00:55.58,0:01:00.06,Default,,0,0,0,,«Егер сіз киімді көшірсеңіз, Умакода да костюм болады».
Dialogue: 0,0:01:00.12,0:01:02.06,Default,,0,0,0,,«Себебі мен жылқының баласымын».
Dialogue: 0,0:01:02.12,0:01:04.49,Default,,0,0,0,,«Қазір бұл әзіл туралы не ойлайсыз?»
Dialogue: 0,0:01:04.56,0:01:06.13,Default,,0,0,0,,Әрі қарай
Dialogue: 0,0:01:06.23,0:01:08.13,Default,,0,0,0,,Танымал болды деп жауап жазайын ба?
Dialogue: 0,0:01:08.23,0:01:10.33,Default,,0,0,0,,«Менің сұрағым бар»
Dialogue: 0,0:01:10.40,0:01:13.74,Default,,0,0,0,,«Мен жақсы баламын және маған мектеп ұнайды».
Dialogue: 0,0:01:13.80,0:01:15.60,Default,,0,0,0,,«Бірақ мен кейде қайғылы сезінемін».
Dialogue: 0,0:01:15.67,0:01:20.18,Default,,0,0,0,,«Мен қайғылы кезде не істеуім керек?»
Dialogue: 0,0:01:20.31,0:01:23.08,Default,,0,0,0,,Қандай тамаша хат.
Dialogue: 0,0:01:23.34,0:01:26.65,Default,,0,0,0,,Менің де қайғылы кездерім болды.
Dialogue: 0,0:01:26.71,0:01:30.22,Default,,0,0,0,,Себебі менің отбасым ауқатты емес еді.
Dialogue: 0,0:01:30.32,0:01:35.36,Default,,0,0,0,,Бір күні мен жүгіре бастадым, бұл дұрыс болды.
Dialogue: 0,0:01:35.42,0:01:39.09,Default,,0,0,0,,Сондықтан қайғылы кезде жүгіріңіз.
Dialogue: 0,0:01:39.19,0:01:42.16,Default,,0,0,0,,Ешқашан тоқтамаңыз
Dialogue: 0,0:01:42.26,0:01:46.63,Default,,0,0,0,,Сізді ұстап тұрғандарды қуып жіберіңіз.
Dialogue: 0,0:01:46.70,0:01:51.34,Default,,0,0,0,,Қандай жағдай болмасын, тоқтама, артыңа қарама.
Dialogue: 0,0:01:51.41,0:01:54.24,Default,,0,0,0,,Барлығы сіздің алдыңызда
Dialogue: 0,0:01:54.41,0:01:54.58,Default,,0,0,0,,1 айдан кейін
Dialogue: 0,0:01:54.58,0:01:58.68,Default,,0,0,0,,1 айдан кейін
Dialogue: 0,0:01:54.58,0:01:58.68,Default,,0,0,0,,Қайырлы таң Луисвилл 22 тамыз 1973 ж
Dialogue: 0,0:01:58.68,0:01:58.75,Default,,0,0,0,,1 айдан кейін
Dialogue: 0,0:01:58.75,0:01:59.21,Default,,0,0,0,,1 айдан кейін
Dialogue: 0,0:01:58.75,0:01:59.21,Default,,0,0,0,,Бүгін қаралы күн
Dialogue: 0,0:01:59.21,0:02:01.15,Default,,0,0,0,,Бүгін қаралы күн
Dialogue: 0,0:02:01.22,0:02:04.29,Default,,0,0,0,,Секретариатқа өмір бойы жарысуға тыйым салынады.
Dialogue: 0,0:02:04.39,0:02:06.29,Default,,0,0,0,,Өте қиын болды… Өтінемін, мені жалғыз қалдыр.
Dialogue: 0,0:02:06.39,0:02:09.36,Default,,0,0,0,,70-ші жылдар болғандықтан спортта алдау ма?
Dialogue: 0,0:02:09.42,0:02:11.33,Default,,0,0,0,,Мынау
Dialogue: 0,0:02:11.43,0:02:16.76,Default,,0,0,0,,Дүниедегі ең жақсы жүгіруші де шындықтан қаша алмайды
Dialogue: 0,0:02:19.77,0:02:24.47,Default,,0,0,0,,Луисвилл бағытында кептеліс көп. Көпірдің үстіне біреу тоқтап қалды...
Dialogue: 0,0:03:15.66,0:03:19.29,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:03:19.39,0:03:21.40,Default,,0,0,0,,«Алтын глобусты марапаттау рәсімі»
Dialogue: 0,0:03:21.50,0:03:25.27,Default,,0,0,0,,Үздік комедия үшін сыйлық –
Dialogue: 0,0:03:25.37,0:03:27.80,Default,,0,0,0,,Жазған: BoJack Horseman
Dialogue: 0,0:03:27.90,0:03:29.80,Default,,0,0,0,,«Бір қулықта озған ат».
Dialogue: 0,0:03:29.94,0:03:32.57,Default,,0,0,0,,Бұл менің бірінші марапатым.
Dialogue: 0,0:03:32.67,0:03:34.58,Default,,0,0,0,,1992 жылы туындаған
Dialogue: 0,0:03:34.64,0:03:36.88,Default,,0,0,0,,Пол Маккартнимен—
Dialogue: 0,0:03:36.95,0:03:40.48,Default,,0,0,0,,Жұдырықтасудан кейінгі алғашқы көрініс
Dialogue: 0,0:03:41.28,0:03:44.39,Default,,0,0,0,,Бұл құрмет. Рахмет, Hariwoo қауымдастығы.
Dialogue: 0,0:03:44.49,0:03:47.59,Default,,0,0,0,,Бұл кітап комедия емес.
Dialogue: 0,0:03:47.66,0:03:51.33,Default,,0,0,0,,Сіз фильмді шынымен көрдіңіз бе?
Dialogue: 0,0:03:51.39,0:03:53.73,Default,,0,0,0,,Біріншіден, бұл кино емес, кітап.
Dialogue: 0,0:03:53.80,0:03:54.56,Default,,0,0,0,,Біз доспыз
Dialogue: 0,0:03:54.66,0:03:57.47,Default,,0,0,0,,Кітапқа берген жауабы керемет болды.
Dialogue: 0,0:03:57.53,0:04:00.00,Default,,0,0,0,,Соңғы үш ай ең жақсы болды.
Dialogue: 0,0:04:00.30,0:04:04.57,Default,,0,0,0,,Маған шынымен де осындай кітап шығарамын ба деп сұрады.
Dialogue: 0,0:04:04.64,0:04:09.81,Default,,0,0,0,,Сізге жанашырлық танытатын бір ғана адам болса, жарайды.
Dialogue: 0,0:04:09.91,0:04:14.58,Default,,0,0,0,,Барлығы мені батыл дейді, бірақ...
Dialogue: 0,0:04:14.68,0:04:16.99,Default,,0,0,0,,Сіз батыл болуыңыз керек.
Dialogue: 0,0:04:17.35,0:04:18.92,Default,,0,0,0,,Дүкенде кеш!
Dialogue: 0,0:04:20.29,0:04:23.36,Default,,0,0,0,,Мен той өткізгім келмеді.
Dialogue: 0,0:04:23.46,0:04:27.33,Default,,0,0,0,,Ерекше Мақта кәмпит жегіңіз келе ме?
Dialogue: 0,0:04:27.43,0:04:29.00,Default,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:04:29.26,0:04:29.90,Default,,0,0,0,,Иә
Dialogue: 0,0:04:29.96,0:04:31.87,Default,,0,0,0,,Бұл уақыт тұлғасы болды.
Dialogue: 0,0:04:31.97,0:04:34.37,Default,,0,0,0,,Сәлем, үлкендер.
Dialogue: 0,0:04:34.44,0:04:38.01,Default,,0,0,0,,Не, кітап тез сатылмай жатыр ма?
Dialogue: 0,0:04:38.27,0:04:41.44,Default,,0,0,0,,Мен де «Алтын глобусты» жеңіп алдым.
Dialogue: 0,0:04:41.51,0:04:43.31,Default,,0,0,0,,Сізді не бақытты етеді?
Dialogue: 0,0:04:43.41,0:04:45.71,Default,,0,0,0,,Бұл жігерлендірмейді.
Dialogue: 0,0:04:45.78,0:04:49.75,Default,,0,0,0,,Ересек Винсент Жұмыс қалай?
Dialogue: 0,0:04:49.82,0:04:53.66,Default,,0,0,0,,Іс жақсы жүріп жатыр. Мен қор нарығына барып, жұмыс істедім.
Dialogue: 0,0:04:53.76,0:04:55.69,Default,,0,0,0,,Сіз тым көп жұмыс жасайсыз.
Dialogue: 0,0:04:55.76,0:05:00.96,Default,,0,0,0,,Бәсекелестік әлемнен қашып, круизге барыңыз
Dialogue: 0,0:05:01.46,0:05:03.70,Default,,0,0,0,,Оның жүзу костюмін елестете аласыз ба?
Dialogue: 0,0:05:03.77,0:05:04.93,Default,,0,0,0,,Мүлде мүмкін емес
Dialogue: 0,0:05:05.30,0:05:09.50,Default,,0,0,0,,Брендан Фрейзермен кездесуге барайық.
Dialogue: 0,0:05:09.57,0:05:10.67,Default,,0,0,0,,Баяу
Dialogue: 0,0:05:11.71,0:05:15.04,Default,,0,0,0,,Бұл Дайанда болуы керек.
Dialogue: 0,0:05:15.31,0:05:16.98,Default,,0,0,0,,Сөз жоқ.
Dialogue: 0,0:05:17.05,0:05:20.85,Default,,0,0,0,,Соңғы уақытта оның жағдайы қалай? Өйткені біз кездескен жоқпыз
Dialogue: 0,0:05:20.92,0:05:24.89,Default,,0,0,0,,Кітап үлкен табысқа жетті және сіз мен сияқты атақтысыз.
Dialogue: 0,0:05:24.95,0:05:26.52,Default,,0,0,0,,Дәл Брэд Питт пен Энджи сияқты
Dialogue: 0,0:05:26.59,0:05:27.89,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:27.96,0:05:29.52,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:05:29.59,0:05:30.53,Default,,0,0,0,,Бұл қиын...
Dialogue: 0,0:05:30.59,0:05:33.86,Default,,0,0,0,,Эрика, күйігің жазылды ма?
Dialogue: 0,0:05:33.93,0:05:35.03,Default,,0,0,0,,Мұнда келіңіз.
Dialogue: 0,0:05:36.00,0:05:39.43,Default,,0,0,0,,Кешіріңіз. Мен сенің кітабыңды жақсы көремін.
Dialogue: 0,0:05:39.63,0:05:42.90,Default,,0,0,0,,Ашығын айтқанда шыншыл, ағартушы...
Dialogue: 0,0:05:43.07,0:05:44.41,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:44.47,0:05:47.71,Default,,0,0,0,,Маған оның атақты болғаны туралы әңгіме ұнайды.
Dialogue: 0,0:05:47.78,0:05:52.85,Default,,0,0,0,,Мен жалғыздықтың қажеті жоқ екенін өте терең деп ойладым.
Dialogue: 0,0:05:52.91,0:05:54.42,Default,,0,0,0,,Бұл терең, солай емес пе?
Dialogue: 0,0:05:54.48,0:05:58.99,Default,,0,0,0,,Маған келмейсің бе? «жалаңаштық» туралы сөйлесейік
Dialogue: 0,0:05:59.05,0:06:01.66,Default,,0,0,0,,Жоқ, мен қалысамын.
Dialogue: 0,0:06:01.72,0:06:02.36,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:06:02.42,0:06:02.99,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:06:11.90,0:06:13.74,Default,,0,0,0,,«Хатшылық»
Dialogue: 0,0:06:14.84,0:06:15.60,Default,,0,0,0,,Дайан
Dialogue: 0,0:06:15.74,0:06:16.77,Default,,0,0,0,,BoJack деген кім?
Dialogue: 0,0:06:16.84,0:06:18.07,Default,,0,0,0,,Біз кездескен жоқпыз ба?
Dialogue: 0,0:06:18.14,0:06:19.51,Default,,0,0,0,,Бұл да кітапқа айнала ма?
Dialogue: 0,0:06:19.61,0:06:22.71,Default,,0,0,0,,Апельсин? Келесі қызғылт сары кітап па?
Dialogue: 0,0:06:24.65,0:06:25.11,Default,,0,0,0,,Иә
Dialogue: 0,0:06:25.41,0:06:26.38,Default,,0,0,0,,Дайан
Dialogue: 0,0:06:26.51,0:06:27.98,Default,,0,0,0,,Себастьян Сент-Клэр.
Dialogue: 0,0:06:28.15,0:06:32.45,Default,,0,0,0,,Миллиардер гуманитарлық авантюрист
Dialogue: 0,0:06:32.75,0:06:33.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:33.49,0:06:34.76,Default,,0,0,0,,Кәне, алақандарыңды соғыңдар.
Dialogue: 0,0:06:36.89,0:06:38.86,Default,,0,0,0,,Мен Пинки пингвинінен оның нөмірін сұрадым.
Dialogue: 0,0:06:38.96,0:06:41.96,Default,,0,0,0,,Тілші іздейді.
Dialogue: 0,0:06:42.06,0:06:46.87,Default,,0,0,0,,Менің бірнеше ай бойы босқындар үшін жасаған ерлігімді жазып алуыңызды қалаймын.
Dialogue: 0,0:06:48.57,0:06:50.07,Default,,0,0,0,,Қандай тамаша оқиға.
Dialogue: 0,0:06:50.17,0:06:53.41,Default,,0,0,0,,Бірақ бұл менің мамандығым емес...
Dialogue: 0,0:06:53.51,0:06:54.44,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:54.58,0:06:57.95,Default,,0,0,0,,Мен BoJack Horseman-ді атақты ете алсам—
Dialogue: 0,0:06:58.05,0:07:02.62,Default,,0,0,0,,Сондай-ақ кедей балаларға назар аудару керек.
Dialogue: 0,0:07:02.72,0:07:04.82,Default,,0,0,0,,Адамдарды ояту
Dialogue: 0,0:07:04.95,0:07:06.65,Default,,0,0,0,,Мен ерте тұрамын.
Dialogue: 0,0:07:06.82,0:07:08.99,Default,,0,0,0,,Шындап оянайық
Dialogue: 0,0:07:09.19,0:07:12.06,Default,,0,0,0,,Дайан Мен байсалдымын.
Dialogue: 0,0:07:12.19,0:07:13.83,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:07:16.63,0:07:18.77,Default,,0,0,0,,Суданда 3 ай?
Dialogue: 0,0:07:18.90,0:07:23.20,Default,,0,0,0,,Сондай-ақ Гаитиде, Таиландта, Угандада және Шешенстанда.
Dialogue: 0,0:07:23.60,0:07:25.04,Default,,0,0,0,,LA-да емес пе?
Dialogue: 0,0:07:25.17,0:07:28.68,Default,,0,0,0,,Мен мағыналы іс жасап, адамдарға көмектескім келеді.
Dialogue: 0,0:07:28.78,0:07:33.15,Default,,0,0,0,,Пайдалы бол, жерде ұйықта, шелекпен тезек
Dialogue: 0,0:07:33.48,0:07:35.65,Default,,0,0,0,,Мен шелекке шашпаймын
Dialogue: 0,0:07:35.78,0:07:38.62,Default,,0,0,0,,Мен шелекке нәжіс жібергім келуі мүмкін
Dialogue: 0,0:07:38.75,0:07:41.52,Default,,0,0,0,,Қаласаңыз, шелек сатып алыңыз.
Dialogue: 0,0:07:41.62,0:07:44.63,Default,,0,0,0,,Шешенстан Бақия... бұл дұрыс емес пе?
Dialogue: 0,0:07:44.79,0:07:45.96,Default,,0,0,0,,Нәжіс емес—
Dialogue: 0,0:07:46.16,0:07:49.76,Default,,0,0,0,,Мен ЛА-дан кету жақсы идея деп ойладым.
Dialogue: 0,0:07:50.00,0:07:52.73,Default,,0,0,0,,Мен әрқашан сенің жаныңда боламын
Dialogue: 0,0:07:52.83,0:07:56.60,Default,,0,0,0,,Бірақ қиял елінде сіз іздеген нәрсені таба алмайсыз.
Dialogue: 0,0:07:56.80,0:07:59.61,Default,,0,0,0,,Бұл дүние қатыгез, мейірімсіз.
Dialogue: 0,0:07:59.67,0:08:04.08,Default,,0,0,0,,Бақыт өмірдің мәнін табу емес
Dialogue: 0,0:08:04.15,0:08:07.52,Default,,0,0,0,,Мағынасыз өмір сүру және өлу
Dialogue: 0,0:08:07.82,0:08:11.09,Default,,0,0,0,,Иә, мен басқа нұсқаларды қарастырамын.
Dialogue: 0,0:08:11.19,0:08:11.92,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:08:14.56,0:08:16.22,Default,,0,0,0,,«Вига—»
Dialogue: 0,0:08:16.49,0:08:17.26,Default,,0,0,0,,Мен сұрасам бола ма?
Dialogue: 0,0:08:17.56,0:08:20.66,Default,,0,0,0,,Винсент... бұл біртүрлі емес пе?
Dialogue: 0,0:08:20.80,0:08:23.50,Default,,0,0,0,,Тренчка киген үш бала бар, солай ма?
Dialogue: 0,0:08:23.63,0:08:25.93,Default,,0,0,0,,Бір-бірімізден өткенде ауырады
Dialogue: 0,0:08:26.27,0:08:31.81,Default,,0,0,0,,Мен толық уақытты жұмыс істеймін, сондықтан үйге келгенде тек R-бағалы фильмдерді көремін.
Dialogue: 0,0:08:32.51,0:08:35.71,Default,,0,0,0,,Мен ересектермен қарым-қатынаста болғым келеді, онда...
Dialogue: 0,0:08:35.81,0:08:38.75,Default,,0,0,0,,Мен туралы жеткілікті. Сіз кереметсіз!
Dialogue: 0,0:08:38.85,0:08:40.11,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:08:40.25,0:08:44.65,Default,,0,0,0,,Сізден жаңа 007 фильміндегі зұлым кейіпкерді ойнауды сұрап жатыр.
Dialogue: 0,0:08:45.09,0:08:47.59,Default,,0,0,0,,Ұсақтағышқа
Dialogue: 0,0:08:47.72,0:08:52.23,Default,,0,0,0,,Ағайынды Коэндердің жаңа жұмыстары туралы не деуге болады? Вестерн фильміндегі басты кейіпкер - жылқы.
Dialogue: 0,0:08:52.53,0:08:54.16,Default,,0,0,0,,Оскар сыйлығы
Dialogue: 0,0:08:54.30,0:08:56.70,Default,,0,0,0,,Қазір «Хатшылықтың» уақыты
Dialogue: 0,0:08:56.93,0:09:00.07,Default,,0,0,0,,Шынымен бе? Сіз тым кәрі емессіз бе?
Dialogue: 0,0:09:00.20,0:09:03.67,Default,,0,0,0,,Мен жай ғана сұрағандықтан жауап бердім.
Dialogue: 0,0:09:03.74,0:09:06.87,Default,,0,0,0,,Егер біз мұны қазір жасай алмасақ, бұл мағынасыз.
Dialogue: 0,0:09:07.04,0:09:08.94,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:09:09.04,0:09:13.21,Default,,0,0,0,,Қарапайым әңгімені неге сонша қиындатасың деп ойлаймын.
Dialogue: 0,0:09:13.58,0:09:15.65,Default,,0,0,0,,Лаура, бүгінгі күн кестесін тазала.
Dialogue: 0,0:09:15.72,0:09:21.56,Default,,0,0,0,,Мен бүгін күні бойы мені мүлде марапаттамайтын жұмыста жұмыс істеймін.
Dialogue: 0,0:09:21.92,0:09:22.69,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:09:24.86,0:09:27.33,Default,,0,0,0,,Тыңдаңыз, Тодд, «PB Living».
Dialogue: 0,0:09:27.63,0:09:30.77,Default,,0,0,0,,Бізге тағы бір үлкен соққы қажет.
Dialogue: 0,0:09:30.87,0:09:34.14,Default,,0,0,0,,Мен кино түсіргім келеді, енді түсірейік.
Dialogue: 0,0:09:34.24,0:09:37.84,Default,,0,0,0,,Мен жинаған сценарийлердің бәрі жақсы.
Dialogue: 0,0:09:37.94,0:09:39.14,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:09:39.64,0:09:43.28,Default,,0,0,0,,Бірақ шын мәнінде менде фильмдерден басқа идеялар бар.
Dialogue: 0,0:09:43.64,0:09:44.98,Default,,0,0,0,,Мен оны естігім келеді.
Dialogue: 0,0:09:45.11,0:09:49.28,Default,,0,0,0,,Жүріп бара жатып, мен дүкеннің терезесін көрдім.
Dialogue: 0,0:09:49.58,0:09:51.95,Default,,0,0,0,,Маған тамаша идея келді.
Dialogue: 0,0:09:52.05,0:09:53.79,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:09:53.85,0:09:57.59,Default,,0,0,0,,Хэллоуин тауарларын сататын дүкен.
Dialogue: 0,0:09:57.69,0:10:00.16,Default,,0,0,0,,Хэллоуин дүкені бар, солай ма?
Dialogue: 0,0:10:00.29,0:10:02.63,Default,,0,0,0,,Қазан айында
Dialogue: 0,0:10:02.70,0:10:07.20,Default,,0,0,0,,Қаңтар қалай өтеді? Бұл игерілмеген нарық.
Dialogue: 0,0:10:07.34,0:10:10.20,Default,,0,0,0,,Бұл оның жыл бойы ашық екенін білдіре ме?
Dialogue: 0,0:10:10.37,0:10:12.31,Default,,0,0,0,,Жоқ, тек қаңтарда
Dialogue: 0,0:10:12.71,0:10:15.91,Default,,0,0,0,,Міне, сіз Алтын глобусты мақсат ете аласыз.
Dialogue: 0,0:10:18.91,0:10:21.22,Default,,0,0,0,,Жақсы уақыт
Dialogue: 0,0:10:21.32,0:10:25.05,Default,,0,0,0,,Сіз қандай рөлді ойнағыңыз келеді? Ол хатшылықтың әкесі ме?
Dialogue: 0,0:10:25.12,0:10:28.09,Default,,0,0,0,,Ата? Қарғыс айтатын адам?
Dialogue: 0,0:10:28.19,0:10:30.22,Default,,0,0,0,,Мен қартайдым
Dialogue: 0,0:10:30.32,0:10:34.23,Default,,0,0,0,,Бірақ бізге тәжірибелі мамандар керек, солай ма?
Dialogue: 0,0:10:34.63,0:10:38.90,Default,,0,0,0,,Жыл мезгілі? Менің осарым ұзағырақ
Dialogue: 0,0:10:38.97,0:10:41.97,Default,,0,0,0,,Хатшылық 27 жасында қайтыс болды.
Dialogue: 0,0:10:42.07,0:10:44.91,Default,,0,0,0,,Мен тек тыңдауларыңызды қалаймын.
Dialogue: 0,0:10:45.04,0:10:46.97,Default,,0,0,0,,Біз тырысамыз ба?
Dialogue: 0,0:10:47.07,0:10:51.38,Default,,0,0,0,,«Байқап көр» демекші, біз келіссөздер жүргіземіз, балам.
Dialogue: 0,0:10:51.65,0:10:53.81,Default,,0,0,0,,Бала... жоқ, ақсақал.
Dialogue: 0,0:10:57.15,0:10:58.79,Default,,0,0,0,,Жоқ, осылай
Dialogue: 0,0:10:58.85,0:10:59.95,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:11:01.02,0:11:02.89,Default,,0,0,0,,Мұндай жағдай болды ма?
Dialogue: 0,0:11:03.19,0:11:04.23,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:11:04.29,0:11:05.19,Default,,0,0,0,,Тодд
Dialogue: 0,0:11:05.26,0:11:07.09,Default,,0,0,0,,Не? жержаңғақ майы
Dialogue: 0,0:11:07.26,0:11:09.13,Default,,0,0,0,,Сіз қалай сөйлейсіз?
Dialogue: 0,0:11:09.26,0:11:12.77,Default,,0,0,0,,Тодд, мен жаңа ғана таңғажайып костюм ойлап таптым.
Dialogue: 0,0:11:13.00,0:11:17.27,Default,,0,0,0,,Неге дүкенге барып, тапқан ақшаңызды жұмсамайсыз?
Dialogue: 0,0:11:17.44,0:11:21.78,Default,,0,0,0,,Бірақ бұл әлі қаңтар, солай емес пе?
Dialogue: 0,0:11:21.88,0:11:25.98,Default,,0,0,0,,Хэллоуин дүкенінің ашылуына тоғыз ай қалды.
Dialogue: 0,0:11:26.08,0:11:28.35,Default,,0,0,0,,Бірақ мен мұны қазір қалаймын!
Dialogue: 0,0:11:28.68,0:11:30.79,Default,,0,0,0,,Бұл болмайды ма?
Dialogue: 0,0:11:30.95,0:11:32.85,Default,,0,0,0,,Ешкім ешқашан
Dialogue: 0,0:11:33.42,0:11:34.92,Default,,0,0,0,,Таныстыру
Dialogue: 0,0:11:35.02,0:11:38.69,Default,,0,0,0,,«Хэллоуин дүкені қаңтар айында да ашылады»
Dialogue: 0,0:11:38.79,0:11:41.90,Default,,0,0,0,,Хэллоуинді кез келген адам тамашалай алады
Dialogue: 0,0:11:42.06,0:11:44.90,Default,,0,0,0,,Қаңтардағы Хэллоуин? Түсіндіріңізші
Dialogue: 0,0:11:45.00,0:11:48.44,Default,,0,0,0,,Бұған дейін біз бір жерде кездестік, солай ма?
Dialogue: 0,0:11:48.74,0:11:50.10,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:11:50.20,0:11:53.91,Default,,0,0,0,,Статистикаға сүйенсек, қаңтар айында суицид көп.
Dialogue: 0,0:11:54.04,0:11:55.41,Default,,0,0,0,,Мен мұны істеймін деп ойлаймын
Dialogue: 0,0:11:55.74,0:11:59.95,Default,,0,0,0,,Хэллоуинде дүкендер жоқ, бұл біртүрлі кездейсоқтық.
Dialogue: 0,0:12:00.05,0:12:03.15,Default,,0,0,0,,Хэллоуин дүкендері өмірді сақтай ала ма?
Dialogue: 0,0:12:03.28,0:12:08.72,Default,,0,0,0,,Мен сене алар емеспін. Ақымақтар біріккенде, ақымақтардың арасында синергетикалық әсер болады ма?
Dialogue: 0,0:12:08.86,0:12:09.89,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:10.06,0:12:14.93,Default,,0,0,0,,Бір-бірін мадақтауды доғар. Бұл отпен ойнау сияқты.
Dialogue: 0,0:12:15.03,0:12:17.00,Default,,0,0,0,,«Идея» деп аталатын от?
Dialogue: 0,0:12:17.10,0:12:19.83,Default,,0,0,0,,Мүмкін бұл «достық» деп аталатын от шығар
Dialogue: 0,0:12:19.97,0:12:21.20,Default,,0,0,0,,Бұл өрт емес
Dialogue: 0,0:12:21.34,0:12:22.74,Default,,0,0,0,,Өрт өрісінің ақымақтығы қандай?
Dialogue: 0,0:12:22.84,0:12:24.07,Default,,0,0,0,,Өрт аралы туралы не деуге болады?
Dialogue: 0,0:12:24.17,0:12:25.07,Default,,0,0,0,,Габе ше?
Dialogue: 0,0:12:25.17,0:12:25.87,Default,,0,0,0,,Габе?
Dialogue: 0,0:12:25.97,0:12:27.78,Default,,0,0,0,,Ол от сияқты
Dialogue: 0,0:12:27.91,0:12:28.34,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:12:28.44,0:12:30.04,Default,,0,0,0,,Ыстық болды
Dialogue: 0,0:12:31.41,0:12:34.15,Default,,0,0,0,,«Піл»
Dialogue: 0,0:12:37.05,0:12:39.99,Default,,0,0,0,,Жұмыс Жұмыс... Сізде бар болғаны осы ма?
Dialogue: 0,0:12:40.09,0:12:40.92,Default,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:12:41.06,0:12:44.39,Default,,0,0,0,,Пальто астында не бар? ішіне салыңыз
Dialogue: 0,0:12:44.53,0:12:47.96,Default,,0,0,0,,Қазір емес. Компанияға қоңырау шалыңыз.
Dialogue: 0,0:12:48.06,0:12:49.43,Default,,0,0,0,,Мен көлікті жеткізуім керек.
Dialogue: 0,0:12:49.76,0:12:51.37,Default,,0,0,0,,Тек компаниялар
Dialogue: 0,0:12:51.47,0:12:55.87,Default,,0,0,0,,Мен ересектермен қарым-қатынаста болғым келеді, бірақ мен жаспын.
Dialogue: 0,0:12:55.97,0:12:58.17,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:12:58.27,0:13:00.44,Default,,0,0,0,,Джинсы және би...
Dialogue: 0,0:13:00.77,0:13:02.18,Default,,0,0,0,,Балалар осылай істейді
Dialogue: 0,0:13:02.41,0:13:04.78,Default,,0,0,0,,Ересек ететін жалғыз нәрсе жұмыс емес
Dialogue: 0,0:13:04.88,0:13:07.85,Default,,0,0,0,,Сүйікті көлігіңізге міну үшін ересек болудың қажеті жоқ.
Dialogue: 0,0:13:07.95,0:13:11.92,Default,,0,0,0,,Мен тығырыққа тірелуден шаршадым.
Dialogue: 0,0:13:12.02,0:13:14.05,Default,,0,0,0,,Рут дегеніміз не?
Dialogue: 0,0:13:14.26,0:13:17.89,Default,,0,0,0,,Сіз басқа нәрсе іздеген сияқтысыз.
Dialogue: 0,0:13:17.99,0:13:21.50,Default,,0,0,0,,Үлкен кісідей айттым, бірақ шынымды айтсам, ренжідім.
Dialogue: 0,0:13:21.80,0:13:24.83,Default,,0,0,0,,Енді жоқ, кет, сау бол.
Dialogue: 0,0:13:25.40,0:13:26.30,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:13:27.17,0:13:28.07,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:13:29.34,0:13:31.11,Default,,0,0,0,,Маған шырын алуға бола ма?
Dialogue: 0,0:13:33.81,0:13:34.91,Default,,0,0,0,,Боджак
Dialogue: 0,0:13:35.01,0:13:37.11,Default,,0,0,0,,Режиссері Келси Дженнингс
Dialogue: 0,0:13:37.24,0:13:39.98,Default,,0,0,0,,Мен мүмкіндік үшін ризамын
Dialogue: 0,0:13:40.08,0:13:41.12,Default,,0,0,0,,Иә...
Dialogue: 0,0:13:41.22,0:13:43.55,Default,,0,0,0,,Хатшылық батыр...
Dialogue: 0,0:13:43.88,0:13:45.32,Default,,0,0,0,,Әр адамның батыры
Dialogue: 0,0:13:46.22,0:13:48.46,Default,,0,0,0,,бәрі болды
Dialogue: 0,0:13:48.59,0:13:50.82,Default,,0,0,0,,Мен директор болғандықтан білемін.
Dialogue: 0,0:13:50.93,0:13:55.53,Default,,0,0,0,,Келси 30 адамды тыңдады...
Dialogue: 0,0:13:55.86,0:13:59.00,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:13:59.13,0:14:00.53,Default,,0,0,0,,Қазір бастаңыз
Dialogue: 0,0:14:01.50,0:14:03.37,Default,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:14:04.17,0:14:07.47,Default,,0,0,0,,Сіз жеңген жүйрік атсыз, солай ма?
Dialogue: 0,0:14:07.58,0:14:11.41,Default,,0,0,0,,Жоқ, мен бүгін қонақпын.
Dialogue: 0,0:14:11.55,0:14:13.28,Default,,0,0,0,,Мен сұрақ қоя аламын ба?
Dialogue: 0,0:14:13.38,0:14:16.92,Default,,0,0,0,,Жүгіріп бара жатқанда неден қашасың?
Dialogue: 0,0:14:17.05,0:14:19.19,Default,,0,0,0,,Шынымды айтсам, ештеңе жоқ
Dialogue: 0,0:14:19.32,0:14:21.59,Default,,0,0,0,,Барлығы бір нәрседен қашады.
Dialogue: 0,0:14:21.89,0:14:25.99,Default,,0,0,0,,Менде ештеңе жоқ, менде ештеңе жоқ деп қорқамын
Dialogue: 0,0:14:26.43,0:14:29.20,Default,,0,0,0,,Барлығы қолтаңба мен фотосурет алғысы келеді.
Dialogue: 0,0:14:29.93,0:14:34.97,Default,,0,0,0,,Мен бәрі іздеген адам болғым келеді.
Dialogue: 0,0:14:35.54,0:14:38.37,Default,,0,0,0,,Менің күшім мейірімділік деп аталады, бірақ ...
Dialogue: 0,0:14:39.04,0:14:40.34,Default,,0,0,0,,Бірақ ол бос
Dialogue: 0,0:14:41.18,0:14:44.21,Default,,0,0,0,,Қанша жүгірсем де қашып құтыла алмаймын
Dialogue: 0,0:14:46.48,0:14:48.22,Default,,0,0,0,,Керемет Боджак
Dialogue: 0,0:14:49.38,0:14:50.62,Default,,0,0,0,,Менің жүрегімді тебірентеді...
Dialogue: 0,0:14:50.95,0:14:52.52,Default,,0,0,0,,Мен істедім
Dialogue: 0,0:14:52.62,0:14:54.66,Default,,0,0,0,,Мен мұны А.Гарфилд жасайды деп естимін.
Dialogue: 0,0:14:54.99,0:14:56.06,Default,,0,0,0,,Хатшылық рөлі!
Dialogue: 0,0:14:56.29,0:14:57.52,Default,,0,0,0,,А.Гарфилд?
Dialogue: 0,0:14:57.66,0:14:59.09,Default,,0,0,0,,Бұл ең жақсы күн
Dialogue: 0,0:14:59.23,0:15:00.06,Default,,0,0,0,,Өрмекші адам?
Dialogue: 0,0:15:00.16,0:15:02.13,Default,,0,0,0,,Бұл тамаша фильм болады!
Dialogue: 0,0:15:02.23,0:15:03.33,Default,,0,0,0,,Эндрю…
Dialogue: 0,0:15:03.96,0:15:06.27,Default,,0,0,0,,Гарфилд!
Dialogue: 0,0:15:07.10,0:15:09.24,Default,,0,0,0,,Мен дәрі қабылдағанда қорқынышты түс көремін.
Dialogue: 0,0:15:09.37,0:15:12.34,Default,,0,0,0,,Безгекке шалдықса өлесің.
Dialogue: 0,0:15:12.47,0:15:14.98,Default,,0,0,0,,Сондықтан бәрі дәрі ішеді.
Dialogue: 0,0:15:16.64,0:15:18.58,Default,,0,0,0,,Шатырдағы масалар
Dialogue: 0,0:15:18.98,0:15:19.98,Default,,0,0,0,,«Міне, менің электрондық поштамның мекенжайы.»
Dialogue: 0,0:15:22.45,0:15:25.39,Default,,0,0,0,,Кэролайн, БоДжектің агенті
Dialogue: 0,0:15:25.52,0:15:26.35,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:15:26.49,0:15:29.19,Default,,0,0,0,,БоДжекпен кездескен мысық.
Dialogue: 0,0:15:29.32,0:15:32.19,Default,,0,0,0,,Тойларда да талай рет кездестік.
Dialogue: 0,0:15:32.29,0:15:35.46,Default,,0,0,0,,Ленни Секретариат фильмін түсіріп жатыр.
Dialogue: 0,0:15:35.60,0:15:38.50,Default,,0,0,0,,Кейіпкер бойынша кеңесші—
Dialogue: 0,0:15:38.60,0:15:40.50,Default,,0,0,0,,Мен сізге бір жақсылық сұрағым келеді.
Dialogue: 0,0:15:40.63,0:15:41.54,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:15:41.67,0:15:45.41,Default,,0,0,0,,Бұл оңай жұмыс. Мен күні бойы тәтті жеймін.
Dialogue: 0,0:15:45.51,0:15:48.68,Default,,0,0,0,,«Хатшылық мұны істемейді»
Dialogue: 0,0:15:49.01,0:15:53.21,Default,,0,0,0,,Маған Судандағы жетім балаға жұмыс істеуді тапсырды...
Dialogue: 0,0:15:53.35,0:15:55.58,Default,,0,0,0,,Жетім болсаң, сатып аласың.
Dialogue: 0,0:15:55.72,0:15:57.02,Default,,0,0,0,,Мен оны сатып алғым келмейді
Dialogue: 0,0:15:57.15,0:16:01.19,Default,,0,0,0,,Адамдарға көмектесуге келгенде ақша босқа кетпейді.
Dialogue: 0,0:16:01.29,0:16:03.32,Default,,0,0,0,,Алдымен жұмыс істе, бала кейін
Dialogue: 0,0:16:03.46,0:16:05.26,Default,,0,0,0,,Әлі уақытта
Dialogue: 0,0:16:05.73,0:16:07.09,Default,,0,0,0,,Күйеуіңізбен кеңесіңіз
Dialogue: 0,0:16:07.33,0:16:09.20,Default,,0,0,0,,Енді мен сақалымды қысқартамын.
Dialogue: 0,0:16:09.26,0:16:12.37,Default,,0,0,0,,Сезіміңді бұлдыратады, бірақ сұлулықтың құны бар.
Dialogue: 0,0:16:12.47,0:16:14.47,Default,,0,0,0,,«Күміс қасық асхана»
Dialogue: 0,0:16:14.54,0:16:15.57,Default,,0,0,0,,Пирог ше?
Dialogue: 0,0:16:15.67,0:16:16.54,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:16:16.64,0:16:18.51,Default,,0,0,0,,Мен бәрін аламын
Dialogue: 0,0:16:18.61,0:16:20.61,Default,,0,0,0,,Бурбон қосыңыз
Dialogue: 0,0:16:21.41,0:16:25.51,Default,,0,0,0,,Соңғы кездері көңіл күйіңіз түсіп кетті, жақсысыз ба?
Dialogue: 0,0:16:25.65,0:16:29.58,Default,,0,0,0,,Сізді жақсы сезінетін нәрсе бар.
Dialogue: 0,0:16:29.68,0:16:33.72,Default,,0,0,0,,Бұл жаңа бизнес, ол жаңа және қызықты.
Dialogue: 0,0:16:34.05,0:16:36.49,Default,,0,0,0,,Хэллоуин дүкені туралы не деуге болады?
Dialogue: 0,0:16:36.62,0:16:37.26,Default,,0,0,0,,Не?
Dialogue: 0,0:16:37.36,0:16:42.03,Default,,0,0,0,,Бұл оқиға. Дүкеннің едені құлап қалды.
Dialogue: 0,0:16:42.13,0:16:45.33,Default,,0,0,0,,Жержаңғақ майы қытырлақ.
Dialogue: 0,0:16:45.43,0:16:47.37,Default,,0,0,0,,Жаңа еденді орнаттыңыз ба?
Dialogue: 0,0:16:49.04,0:16:53.27,Default,,0,0,0,,Хэллоуин? Қаңтар айында? Тамаша идея...
Dialogue: 0,0:16:54.71,0:16:57.24,Default,,0,0,0,,Бұл жолы «жеңіл»
Dialogue: 0,0:16:57.38,0:16:58.01,Default,,0,0,0,,Не?
Dialogue: 0,0:16:58.11,0:16:59.28,Default,,0,0,0,,Тегіс
Dialogue: 0,0:16:59.51,0:17:01.15,Default,,0,0,0,,Смути, солай ма?
Dialogue: 0,0:17:01.38,0:17:05.45,Default,,0,0,0,,Жоқ, ол тегіс. Көңіл-күйді ішіңіз.
Dialogue: 0,0:17:05.59,0:17:08.29,Default,,0,0,0,,Көңіл күйді қалай ішесіз?
Dialogue: 0,0:17:08.42,0:17:09.49,Default,,0,0,0,,Смузи дайындаңыз
Dialogue: 0,0:17:09.62,0:17:10.52,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:17:10.66,0:17:14.43,Default,,0,0,0,,Тегіс, көңілді іш.
Dialogue: 0,0:17:14.56,0:17:16.70,Default,,0,0,0,,Көңіл-күйді қалай ішуге болады?
Dialogue: 0,0:17:17.03,0:17:18.17,Default,,0,0,0,,Смузи ретінде
Dialogue: 0,0:17:18.30,0:17:21.40,Default,,0,0,0,,Сіз оны дүкеннен сатып аласыз ба? Пішіні қандай?
Dialogue: 0,0:17:21.54,0:17:24.81,Default,,0,0,0,,Мәліметтер әлі шешілген жоқ, бірақ олар жарияланды.
Dialogue: 0,0:17:25.11,0:17:27.51,Default,,0,0,0,,Негіздерден бірге бастайық
Dialogue: 0,0:17:27.64,0:17:31.55,Default,,0,0,0,,Балалар, сіздердің әрқашан жасайтын нәрселеріңіз түбегейлі.
Dialogue: 0,0:17:31.75,0:17:34.68,Default,,0,0,0,,Ақырында Хэллоуин дүкені...
Dialogue: 0,0:17:38.45,0:17:39.25,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:39.45,0:17:43.66,Default,,0,0,0,,Ашылу кешіне келіңіз.
Dialogue: 0,0:17:43.72,0:17:46.69,Default,,0,0,0,,Мен өзіме сенімді болғандықтан көп ақша салдым.
Dialogue: 0,0:17:46.83,0:17:48.10,Default,,0,0,0,,Бірқалыпты?
Dialogue: 0,0:17:48.23,0:17:51.17,Default,,0,0,0,,Күте тұрыңыз, Смуди? Smoothie?
Dialogue: 0,0:17:51.30,0:17:53.57,Default,,0,0,0,,Қайсысын жасаймыз?
Dialogue: 0,0:17:53.63,0:17:56.17,Default,,0,0,0,,Smoody - бізді кім етеді.
Dialogue: 0,0:17:57.34,0:18:00.17,Default,,0,0,0,,Енді қалай айттың, Жақсы сөз айттың.
Dialogue: 0,0:18:01.51,0:18:03.41,Default,,0,0,0,,«Смуди көңіл-күйін ішіңіз»
Dialogue: 0,0:18:03.64,0:18:04.48,Default,,0,0,0,,Кілт тізбегі
Dialogue: 0,0:18:04.58,0:18:05.45,Default,,0,0,0,,Жылулық қақпақ
Dialogue: 0,0:18:05.55,0:18:06.65,Default,,0,0,0,,Бөтелкені ашатын құрал
Dialogue: 0,0:18:07.25,0:18:09.25,Default,,0,0,0,,Смузи сияқты ішетін көңіл-күйім бар.
Dialogue: 0,0:18:09.52,0:18:11.52,Default,,0,0,0,,Тодд, басталды.
Dialogue: 0,0:18:11.62,0:18:12.39,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:18:12.55,0:18:14.69,Default,,0,0,0,,Мен сирек айтамын
Dialogue: 0,0:18:14.82,0:18:19.23,Default,,0,0,0,,Мен шоғырланып, оны соңына дейін көруім керек.
Dialogue: 0,0:18:19.39,0:18:22.23,Default,,0,0,0,,Басқа жерге жүгіріп, сәтсіздікке ұшырауыңыз мүмкін.
Dialogue: 0,0:18:22.33,0:18:25.60,Default,,0,0,0,,Содан мен вафли жеуші болдым.
Dialogue: 0,0:18:25.70,0:18:29.77,Default,,0,0,0,,Сіз жаңа ғана вафли айттыңыз ба? Әлде керемет пе?
Dialogue: 0,0:18:29.87,0:18:31.21,Default,,0,0,0,,Вафли
Dialogue: 0,0:18:31.31,0:18:34.48,Default,,0,0,0,,Бұл керемет нәрсе жақсы сатылуы мүмкін.
Dialogue: 0,0:18:34.58,0:18:37.85,Default,,0,0,0,,Вафли? Әлде керемет пе?
Dialogue: 0,0:18:38.15,0:18:38.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:45.69,0:18:49.46,Default,,0,0,0,,BoJack Smoody керемет
Dialogue: 0,0:18:50.29,0:18:51.63,Default,,0,0,0,,Оның не екенін білесің бе?
Dialogue: 0,0:18:51.76,0:18:53.83,Default,,0,0,0,,Көңілсіз музыка?
Dialogue: 0,0:18:53.89,0:18:58.43,Default,,0,0,0,,Мен бойдақпын, сондықтан ол жаңа болса, бәрі жақсы.
Dialogue: 0,0:18:58.63,0:18:59.43,Default,,0,0,0,,Көңілді
Dialogue: 0,0:18:59.53,0:19:00.90,Default,,0,0,0,,Кэролайн
Dialogue: 0,0:19:01.67,0:19:02.70,Default,,0,0,0,,Винсент
Dialogue: 0,0:19:02.87,0:19:06.44,Default,,0,0,0,,Танысқаныма қуаныштымын. Сіз не ойлайтыныңызға байланысты ...
Dialogue: 0,0:19:06.51,0:19:08.48,Default,,0,0,0,,Шын мәнінде мектеп автобусымен келдің бе?
Dialogue: 0,0:19:08.71,0:19:11.71,Default,,0,0,0,,Мен қорқынышты адам едім
Dialogue: 0,0:19:11.78,0:19:15.28,Default,,0,0,0,,Содан бері мен өз әрекеттеріме қайта қарадым.
Dialogue: 0,0:19:15.48,0:19:17.35,Default,,0,0,0,,Ересек болу деген нені білдіреді?
Dialogue: 0,0:19:17.45,0:19:22.69,Default,,0,0,0,,Кейде бұл шындықты айтуды білдіреді.
Dialogue: 0,0:19:22.79,0:19:25.83,Default,,0,0,0,,Менің шындығым...
Dialogue: 0,0:19:26.26,0:19:26.76,Default,,0,0,0,,Мен айтайын
Dialogue: 0,0:19:26.89,0:19:27.83,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:19:27.93,0:19:28.73,Default,,0,0,0,,Не?
Dialogue: 0,0:19:28.80,0:19:30.23,Default,,0,0,0,,Винсент
Dialogue: 0,0:19:30.30,0:19:32.77,Default,,0,0,0,,Бірге өмірден ләззат алайық
Dialogue: 0,0:19:33.37,0:19:34.20,Default,,0,0,0,,Не?
Dialogue: 0,0:19:34.27,0:19:35.64,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:19:35.70,0:19:36.87,Default,,0,0,0,,Мен мұны істей алмаймын
Dialogue: 0,0:19:37.17,0:19:39.34,Default,,0,0,0,,Маған да айтқанын қалаймын
Dialogue: 0,0:19:40.94,0:19:41.68,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:19:41.81,0:19:44.81,Default,,0,0,0,,Эй Келси, фильмдер туралы сөйлесейік.
Dialogue: 0,0:19:45.35,0:19:46.25,Default,,0,0,0,,Не?
Dialogue: 0,0:19:46.31,0:19:48.88,Default,,0,0,0,,Гарфилд пойыздан түсіп, апатқа ұшырады.
Dialogue: 0,0:19:49.25,0:19:53.19,Default,,0,0,0,,Хэллоуин дүкені? Қаңтар айында? Сен қалжыңдап тұрсың ба?
Dialogue: 0,0:19:56.39,0:19:57.59,Default,,0,0,0,,Ол жоғалды...
Dialogue: 0,0:19:57.76,0:20:01.60,Default,,0,0,0,,Менің денемдегі сүйек сынған, тез арада ауыстыру керек.
Dialogue: 0,0:20:01.73,0:20:06.70,Default,,0,0,0,,Мен BoJack Horseman-ді ұсындым.
Dialogue: 0,0:20:07.37,0:20:08.70,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:20:08.80,0:20:13.64,Default,,0,0,0,,Ол белсенді және оның жасын бейне өңдеу арқылы анықтауға болады.
Dialogue: 0,0:20:13.71,0:20:17.34,Default,,0,0,0,,Бірақ мен саған айтамын, трагедия сияқты әрекет етпеңдер.
Dialogue: 0,0:20:17.41,0:20:21.45,Default,,0,0,0,,Глютен аллергиясы және т.б. Шаршадыңыз ба?
Dialogue: 0,0:20:21.52,0:20:23.82,Default,,0,0,0,,Глютен дегеніміз не?
Dialogue: 0,0:20:23.98,0:20:25.92,Default,,0,0,0,,Егер сіз мұны әлі де орындағыңыз келсе...
Dialogue: 0,0:20:25.99,0:20:28.39,Default,,0,0,0,,Мен мұны істегім келеді, мен істеймін
Dialogue: 0,0:20:28.52,0:20:32.26,Default,,0,0,0,,20 кг тастап, 10 кг қайтар
Dialogue: 0,0:20:32.46,0:20:33.26,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:20:33.33,0:20:33.79,Default,,0,0,0,,Не?
Dialogue: 0,0:20:33.89,0:20:36.76,Default,,0,0,0,,Маған қоңырау шалма, мен сені шақырамын.
Dialogue: 0,0:20:42.50,0:20:43.24,Default,,0,0,0,,Сәлем
Dialogue: 0,0:20:43.30,0:20:43.87,Default,,0,0,0,,Сәлем
Dialogue: 0,0:20:43.97,0:20:45.51,Default,,0,0,0,,Сіз кештерді жек көресіз бе?
Dialogue: 0,0:20:45.61,0:20:47.77,Default,,0,0,0,,Мен темекі тартқым келеді.
Dialogue: 0,0:20:48.38,0:20:50.71,Default,,0,0,0,,Хатшылықтың басты кейіпкері ретінде таңдалды.
Dialogue: 0,0:20:50.78,0:20:51.78,Default,,0,0,0,,Сол эмоциясыз қыз –
Dialogue: 0,0:20:51.95,0:20:53.45,Default,,0,0,0,,Мен мұны істегім келді, бірақ...
Dialogue: 0,0:20:53.55,0:20:55.68,Default,,0,0,0,,Сіз бақытты емессіз бе?
Dialogue: 0,0:20:55.75,0:20:56.72,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:20:56.78,0:20:59.45,Default,,0,0,0,,Бұл әрқашан мәселе, солай емес пе?
Dialogue: 0,0:20:59.52,0:21:01.79,Default,,0,0,0,,Сіз қалаған нәрсені ала алмайсыз
Dialogue: 0,0:21:02.39,0:21:04.76,Default,,0,0,0,,Сізде бар кезде оны байқамайсыз.
Dialogue: 0,0:21:05.29,0:21:06.53,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:21:07.39,0:21:10.76,Default,,0,0,0,,Сізге ұнайтынын білмеймін, бірақ бұл фильм...
Dialogue: 0,0:21:10.86,0:21:13.90,Default,,0,0,0,,Сіз «кейіпкерлер кеңесшісі» болып жұмыс істейсіз бе?
Dialogue: 0,0:21:14.30,0:21:17.04,Default,,0,0,0,,Әріптестер?
Dialogue: 0,0:21:17.30,0:21:19.47,Default,,0,0,0,,Мені жек көрме
Dialogue: 0,0:21:19.54,0:21:20.71,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:21:20.91,0:21:22.61,Default,,0,0,0,,Сізге сәйкес емес пе?
Dialogue: 0,0:21:22.71,0:21:25.91,Default,,0,0,0,,Бұл сізге сәйкес келеді, себебі сіз кітапты жаздыңыз.
Dialogue: 0,0:21:25.98,0:21:29.68,Default,,0,0,0,,Иә, бірақ... мен ЛА-ға келгенде...
Dialogue: 0,0:21:29.75,0:21:33.75,Default,,0,0,0,,Жақсы мақала жазуға бел байладым.
Dialogue: 0,0:21:33.82,0:21:37.92,Default,,0,0,0,,Мен әлемді өзгерткім келеді, бірақ соңында бұл тек айналма жол
Dialogue: 0,0:21:38.46,0:21:40.59,Default,,0,0,0,,Уақыт көп
Dialogue: 0,0:21:40.66,0:21:42.73,Default,,0,0,0,,Ал, келесі жолы бар.
Dialogue: 0,0:21:42.90,0:21:47.07,Default,,0,0,0,,Сен бұрын менен жақсы адамсың ба деп сұрадың.
Dialogue: 0,0:21:47.53,0:21:50.00,Default,,0,0,0,,Сіз естідіңіз бе? Мүмкін
Dialogue: 0,0:21:50.30,0:21:53.07,Default,,0,0,0,,Бұл кенеттен болды, мен түсінбедім ...
Dialogue: 0,0:21:53.74,0:21:56.58,Default,,0,0,0,,Сіз оны жақсы адам деп ойлайсыз ба?
Dialogue: 0,0:21:56.71,0:21:59.65,Default,,0,0,0,,Мен «тұңғиық түбіне» сене алмаймын
Dialogue: 0,0:21:59.71,0:22:02.75,Default,,0,0,0,,Сіз қандай боласыз, ол сізге қатысты
Dialogue: 0,0:22:02.88,0:22:04.02,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:22:06.85,0:22:09.99,Default,,0,0,0,,Сіздің жұмысыңыз ерекше
Dialogue: 0,0:22:10.06,0:22:11.02,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:11.66,0:22:13.53,Default,,0,0,0,,Мен сізге ұнағаныңызды қаладым
Dialogue: 0,0:22:14.56,0:22:15.53,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:22:37.38,0:22:38.72,Default,,0,0,0,,«Керемет»
Dialogue: 0,0:22:50.73,0:22:52.53,Default,,0,0,0,,«Қағаз тасушыны қайтару»
Dialogue: 0,0:23:16.62,0:23:19.09,Default,,0,0,0,,Туған күніңізге сыйлықты ұмытып кеткенім үшін кешіріңіз.
Dialogue: 0,0:23:19.43,0:23:23.43,Default,,0,0,0,,Концерт билеттерін алуды армандаймын—
Dialogue: 0,0:23:23.50,0:23:25.97,Default,,0,0,0,,Мен шынымен маңызды нәрсені ұмыттым.
Dialogue: 0,0:23:26.07,0:23:29.40,Default,,0,0,0,,Сынып өкілдерінің сайлауына үңілдім.
Dialogue: 0,0:23:29.47,0:23:31.94,Default,,0,0,0,,Неліктен сайлауға түскеніңізді ұмытыңыз.
Dialogue: 0,0:23:32.04,0:23:33.84,Default,,0,0,0,,Мен ұлдарға ессізбін
Dialogue: 0,0:23:33.97,0:23:36.48,Default,,0,0,0,,Сыйлық жақсы
Dialogue: 0,0:23:36.54,0:23:38.71,Default,,0,0,0,,Сізге қажет нәрсенің бәрі осында
Dialogue: 0,0:23:39.65,0:23:40.98,Default,,0,0,0,,Макарон ше?
Dialogue: 0,0:23:41.18,0:23:42.78,Default,,0,0,0,,Сабрина
Dialogue: 0,0:23:42.85,0:23:44.55,Default,,0,0,0,,Жүр, ақымақ.
Dialogue: 0,0:23:45.55,0:23:48.42,Default,,0,0,0,,«Herb Kazaz өндірген»
Dialogue: 0,0:24:01.07,0:24:02.97,Default,,0,0,0,,«Блэйкке»
Dialogue: 0,0:24:03.04,0:24:05.47,Default,,0,0,0,,Рахмет, сен менің кейіпкерімсің.
Dialogue: 0,0:24:05.64,0:24:06.77,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:24:08.27,0:24:14.27,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
