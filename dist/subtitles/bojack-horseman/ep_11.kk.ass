Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.74,Default,,0,0,0,,NETFLIX түпнұсқа жұмысы
Dialogue: 0,0:00:11.44,0:00:13.64,Default,,0,0,0,,«Penguin Publishing жалға беру кеңсесі»
Dialogue: 0,0:00:13.74,0:00:16.18,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:00:16.31,0:00:20.32,Default,,0,0,0,,«Ол бірден 12 нанды жасырын жеді».
Dialogue: 0,0:00:20.45,0:00:22.42,Default,,0,0,0,,«Менен нанның қайда екенін сұрады...»
Dialogue: 0,0:00:22.52,0:00:24.45,Default,,0,0,0,,«Мен білмедім деп айттым».
Dialogue: 0,0:00:24.59,0:00:26.72,Default,,0,0,0,,«Бірақ оның беті панктарға толы».
Dialogue: 0,0:00:28.06,0:00:28.59,Default,,0,0,0,,«Әлемдегі ең жақсы үшінші әке»
Dialogue: 0,0:00:28.59,0:00:29.59,Default,,0,0,0,,«Әлемдегі ең жақсы үшінші әке»
Dialogue: 0,0:00:28.59,0:00:29.59,Default,,0,0,0,,Мен де
Dialogue: 0,0:00:29.59,0:00:29.66,Default,,0,0,0,,«Әлемдегі ең жақсы үшінші әке»
Dialogue: 0,0:00:29.66,0:00:31.59,Default,,0,0,0,,«Әлемдегі ең жақсы үшінші әке»
Dialogue: 0,0:00:29.66,0:00:31.59,Default,,0,0,0,,Бұл печенье болды.
Dialogue: 0,0:00:31.73,0:00:34.33,Default,,0,0,0,,Үсіндіге толы жемпір
Dialogue: 0,0:00:34.46,0:00:37.73,Default,,0,0,0,,Көрдіңіз бе, мен жаман жерлерін жазғанда...
Dialogue: 0,0:00:38.07,0:00:39.47,Default,,0,0,0,,Жанашырлық сезімін тудырады.
Dialogue: 0,0:00:39.60,0:00:40.74,Default,,0,0,0,,Сізге Секретариат неліктен ұнайды?
Dialogue: 0,0:00:41.07,0:00:42.07,Default,,0,0,0,,Өйткені бұл атақты жылқы
Dialogue: 0,0:00:42.20,0:00:44.21,Default,,0,0,0,,Өйткені оның кемшіліктері бар.
Dialogue: 0,0:00:44.31,0:00:47.74,Default,,0,0,0,,Сіз сияқты үлкен атақты...
Dialogue: 0,0:00:48.08,0:00:52.61,Default,,0,0,0,,Адамдар өздерінің осал екенін білгенде өздерін қауіпсіз сезінеді.
Dialogue: 0,0:00:52.75,0:00:57.79,Default,,0,0,0,,Егер сіз сәтсіздіктер немесе жылау туралы айтып жатсаңыз, маған тағы бір нәрсе айтыңыз.
Dialogue: 0,0:00:58.12,0:00:59.75,Default,,0,0,0,,BoJack Horseman
Dialogue: 0,0:01:00.06,0:01:04.49,Default,,0,0,0,,Ол семіз адамдарды құтқаратын басты кейіпкер.
Dialogue: 0,0:01:04.63,0:01:05.36,Default,,0,0,0,,Дұрыс емес
Dialogue: 0,0:01:05.49,0:01:08.50,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:01:08.60,0:01:12.07,Default,,0,0,0,,Дайан алғашқы екі тарауды интернетте орналастырды.
Dialogue: 0,0:01:12.17,0:01:13.74,Default,,0,0,0,,Бұл шартты бұзу, бірақ-
Dialogue: 0,0:01:13.84,0:01:17.61,Default,,0,0,0,,Реакция керемет болды, барлығы жалғасын күтуде
Dialogue: 0,0:01:17.71,0:01:20.51,Default,,0,0,0,,Демалыс күндерімен шектелген басып шығару
Dialogue: 0,0:01:20.61,0:01:23.65,Default,,0,0,0,,Баспахана тәркіленеді.
Dialogue: 0,0:01:23.78,0:01:25.25,Default,,0,0,0,,Аптаның соңына қарай?
Dialogue: 0,0:01:25.65,0:01:28.25,Default,,0,0,0,,Жарайды, мен өзім жазамын.
Dialogue: 0,0:01:28.38,0:01:29.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:29.38,0:01:30.79,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:01:31.09,0:01:33.25,Default,,0,0,0,,Жақсырақ сөйлемдер жаз
Dialogue: 0,0:01:33.39,0:01:34.52,Default,,0,0,0,,Бұл «автобиография»
Dialogue: 0,0:01:34.62,0:01:37.16,Default,,0,0,0,,Бар болғаны 5 күнде?
Dialogue: 0,0:01:37.26,0:01:40.13,Default,,0,0,0,,Соңғы оқыған кітабыңыз «Фирма» болды ма?
Dialogue: 0,0:01:40.26,0:01:43.63,Default,,0,0,0,,Сіздің жұмысыңыз соншалықты асыл ма?
Dialogue: 0,0:01:43.73,0:01:45.13,Default,,0,0,0,,«Мен жазушымын»
Dialogue: 0,0:01:45.27,0:01:49.20,Default,,0,0,0,,«Мен компьютеріммен кафеде жазамын».
Dialogue: 0,0:01:49.30,0:01:50.61,Default,,0,0,0,,«Көзілдіріктіңді де ки.»
Dialogue: 0,0:01:50.71,0:01:54.14,Default,,0,0,0,,«Заттардың мәнін тану».
Dialogue: 0,0:01:54.28,0:01:55.54,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:01:55.64,0:01:56.54,Default,,0,0,0,,Оны қалай айту керек
Dialogue: 0,0:01:56.71,0:01:59.65,Default,,0,0,0,,Адамдарға менсінбей қарайсың.
Dialogue: 0,0:01:59.75,0:02:02.55,Default,,0,0,0,,Оны мен де байқадым.
Dialogue: 0,0:02:02.65,0:02:04.89,Default,,0,0,0,,Некеңізді ашатын кітап жазыңыз
Dialogue: 0,0:02:05.19,0:02:08.42,Default,,0,0,0,,Жаңғақ майы сіздің шынайы болмысыңызды білмейді
Dialogue: 0,0:02:08.56,0:02:10.16,Default,,0,0,0,,Сіз оны соншалықты жек көресіз бе?
Dialogue: 0,0:02:10.29,0:02:11.16,Default,,0,0,0,,Қауіп-қатерлерге байланысты әуе саяхатынан бас тартып—
Dialogue: 0,0:02:11.26,0:02:15.26,Default,,0,0,0,,Арық қыздардан шаршадым.
Dialogue: 0,0:02:15.36,0:02:18.43,Default,,0,0,0,,Қараңғы жастықты өткізгенім үшін
Dialogue: 0,0:02:18.53,0:02:22.30,Default,,0,0,0,,Менің кітабыма ренжімеңіз.
Dialogue: 0,0:02:23.61,0:02:25.61,Default,,0,0,0,,Менің көңілім қалды.
Dialogue: 0,0:02:25.74,0:02:27.18,Default,,0,0,0,,Бұл сызық.
Dialogue: 0,0:02:28.28,0:02:30.18,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:02:30.28,0:02:33.45,Default,,0,0,0,,Жұмаға дейін аяқтай аласыз ба?
Dialogue: 0,0:02:33.58,0:02:34.32,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:02:34.45,0:02:38.29,Default,,0,0,0,,Мынаны өртеп жіберіңіз.
Dialogue: 0,0:02:38.39,0:02:41.79,Default,,0,0,0,,Дүниедегі барлық кітаптарды өрте
Dialogue: 0,0:02:41.89,0:02:44.26,Default,,0,0,0,,Күйеуіңнің ісінетін, таң қалдыратын шығарма жаз
Dialogue: 0,0:03:35.84,0:03:39.55,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:03:40.65,0:03:41.65,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:41.78,0:03:43.99,Default,,0,0,0,,1 тарау…
Dialogue: 0,0:03:44.25,0:03:46.29,Default,,0,0,0,,«1-тарау»
Dialogue: 0,0:03:46.72,0:03:47.79,Default,,0,0,0,,Басқа нәрсе
Dialogue: 0,0:03:49.42,0:03:51.69,Default,,0,0,0,,«1-тарау»
Dialogue: 0,0:03:53.66,0:03:54.26,Default,,0,0,0,,Не?
Dialogue: 0,0:03:54.43,0:03:56.26,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:03:56.40,0:03:58.27,Default,,0,0,0,,Дайан шедевр болды.
Dialogue: 0,0:03:58.33,0:04:00.27,Default,,0,0,0,,Мен сізге жаза алмаймын.
Dialogue: 0,0:04:05.91,0:04:06.67,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:04:06.81,0:04:09.54,Default,,0,0,0,,«Сіздер бір-біріңізді бұрыннан кім білдіңіздер?»
Dialogue: 0,0:04:09.64,0:04:11.95,Default,,0,0,0,,«Бұл агент Кэролайн.»
Dialogue: 0,0:04:12.31,0:04:13.55,Default,,0,0,0,,«ол туралы»
Dialogue: 0,0:04:13.68,0:04:15.88,Default,,0,0,0,,«Мен сені тастап кетпеуімнің себебі бар».
Dialogue: 0,0:04:15.95,0:04:19.52,Default,,0,0,0,,«Себебі оның сатуға күші бар».
Dialogue: 0,0:04:19.62,0:04:22.26,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:04:22.36,0:04:23.93,Default,,0,0,0,,Әңгімені ұрлау
Dialogue: 0,0:04:24.03,0:04:27.83,Default,,0,0,0,,Каннибал түрмеде үйленді, солай ма?
Dialogue: 0,0:04:27.96,0:04:30.30,Default,,0,0,0,,Енді сіздің кезегіңіз
Dialogue: 0,0:04:30.47,0:04:33.57,Default,,0,0,0,,Бұл сіздің соңғы мүмкіндігіңіз.
Dialogue: 0,0:04:33.74,0:04:35.97,Default,,0,0,0,,Мен өзімнің шынайы болмысымның белгілі болғанын қаламаймын
Dialogue: 0,0:04:36.27,0:04:38.97,Default,,0,0,0,,Мен жақсы білемін
Dialogue: 0,0:04:39.31,0:04:40.44,Default,,0,0,0,,Мен жек көретін адаммын
Dialogue: 0,0:04:40.58,0:04:40.98,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:41.31,0:04:42.94,Default,,0,0,0,,Душ қабылдаңыз
Dialogue: 0,0:04:43.04,0:04:44.95,Default,,0,0,0,,Менің көз жасымды көргеніңді қаламаймын
Dialogue: 0,0:04:48.45,0:04:50.32,Default,,0,0,0,,Бұл жұмыс.
Dialogue: 0,0:04:52.39,0:04:52.75,Default,,0,0,0,,«1-тарау»
Dialogue: 0,0:04:52.75,0:04:54.36,Default,,0,0,0,,«1-тарау» Маған бұл шрифт ұнайды.
Dialogue: 0,0:04:54.86,0:04:56.32,Default,,0,0,0,,«Мыс табақ»?
Dialogue: 0,0:04:56.46,0:04:58.59,Default,,0,0,0,,Бұл қазіргі адамның шрифті.
Dialogue: 0,0:04:59.33,0:04:59.76,Default,,0,0,0,,No
Dialogue: 0,0:04:59.99,0:05:01.60,Default,,0,0,0,,«Вадана» да жақсы
Dialogue: 0,0:05:01.73,0:05:03.87,Default,,0,0,0,,Сіз оны жасырдыңыз.
Dialogue: 0,0:05:03.97,0:05:06.83,Default,,0,0,0,,«Comic Sans» Менің сізбен жұмысым жоқ.
Dialogue: 0,0:05:07.07,0:05:08.00,Default,,0,0,0,,3:10?
Dialogue: 0,0:05:08.30,0:05:10.74,Default,,0,0,0,,Қаріп таңдауға 6 сағат...
Dialogue: 0,0:05:10.87,0:05:14.71,Default,,0,0,0,,БоДжек, концентрат. Концентрат.
Dialogue: 0,0:05:15.68,0:05:16.68,Default,,0,0,0,,«Бір қулықта озған ат».
Dialogue: 0,0:05:19.61,0:05:21.65,Default,,0,0,0,,Бұл соншалықты қиын болуы мүмкін емес
Dialogue: 0,0:05:21.88,0:05:25.35,Default,,0,0,0,,«Ол маған жиі сыйлықтар беретін».
Dialogue: 0,0:05:25.49,0:05:27.56,Default,,0,0,0,,Нәзік қылқалам штрихтары
Dialogue: 0,0:05:27.66,0:05:29.82,Default,,0,0,0,,Бұл сурет тұрарлық.
Dialogue: 0,0:05:29.92,0:05:33.90,Default,,0,0,0,,Құндылығы сонша, қолтаңбасы да жоқ.
Dialogue: 0,0:05:34.00,0:05:37.50,Default,,0,0,0,,«Ата-анамның әсері анық».
Dialogue: 0,0:05:37.63,0:05:38.90,Default,,0,0,0,,«Ана Беатрис бұл...»
Dialogue: 0,0:05:39.00,0:05:43.00,Default,,0,0,0,,«Ол Sugarman Sugar Company компаниясының бай қызы болды».
Dialogue: 0,0:05:43.10,0:05:45.67,Default,,0,0,0,,«Бұл арада менің әкем Баттерскот...»
Dialogue: 0,0:05:45.77,0:05:48.88,Default,,0,0,0,,«төменгі сыныптан шыққан»
Dialogue: 0,0:05:48.98,0:05:50.01,Default,,0,0,0,,«Немесе…»
Dialogue: 0,0:06:05.43,0:06:05.96,Default,,0,0,0,,Сәлем Тодд
Dialogue: 0,0:06:06.06,0:06:06.93,Default,,0,0,0,,Не?
Dialogue: 0,0:06:07.06,0:06:07.80,Default,,0,0,0,,Тодд
Dialogue: 0,0:06:07.93,0:06:08.66,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:08.80,0:06:09.66,Default,,0,0,0,,Маған қара
Dialogue: 0,0:06:09.80,0:06:10.67,Default,,0,0,0,,Жұмыс
Dialogue: 0,0:06:10.73,0:06:12.80,Default,,0,0,0,,Менің уақытым жоқ. Маған кедергі жасама.
Dialogue: 0,0:06:12.90,0:06:13.67,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:16.67,0:06:19.41,Default,,0,0,0,,Кітап сияқты тыныш оқы.
Dialogue: 0,0:06:19.54,0:06:20.41,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:22.68,0:06:26.41,Default,,0,0,0,,Әлгі бейбақ айналаға бәліш үгіндісін жайып жіберді.
Dialogue: 0,0:06:26.55,0:06:28.55,Default,,0,0,0,,Мен оны тазалаймын ба?
Dialogue: 0,0:06:28.68,0:06:30.45,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:06:31.55,0:06:33.09,Default,,0,0,0,,Жұмыс жүріп жатқан жоқ
Dialogue: 0,0:06:36.79,0:06:38.93,Default,,0,0,0,,Сорып ал, қарғыс атқыр шаңсорғыш.
Dialogue: 0,0:06:41.10,0:06:43.40,Default,,0,0,0,,Жазуға уақытым таусылып барады
Dialogue: 0,0:06:46.77,0:06:48.54,Default,,0,0,0,,Күте тұрыңыз, капитан
Dialogue: 0,0:06:48.64,0:06:50.61,Default,,0,0,0,,Ол кептеліп қалды
Dialogue: 0,0:06:50.71,0:06:54.11,Default,,0,0,0,,Құдай, маған жазуға уақыт бер.
Dialogue: 0,0:06:56.44,0:06:58.45,Default,,0,0,0,,«Жануарларды сатып алу»
Dialogue: 0,0:07:07.72,0:07:10.02,Default,,0,0,0,,«Мені ата-анам жақсы көрді».
Dialogue: 0,0:07:10.12,0:07:12.13,Default,,0,0,0,,«Бір жексенбі күні түстен кейін»
Dialogue: 0,0:07:12.59,0:07:13.46,Default,,0,0,0,,«Анам айтты»
Dialogue: 0,0:07:13.59,0:07:16.83,Default,,0,0,0,,«Сіздерге рахмет, анам мен әкем бақытты».
Dialogue: 0,0:07:16.93,0:07:21.00,Default,,0,0,0,,«Өте жақсы оқитын және спортқа жақсы танымал адам».
Dialogue: 0,0:07:21.20,0:07:22.74,Default,,0,0,0,,«Сіз парфе жегіңіз келе ме?»
Dialogue: 0,0:07:22.87,0:07:23.60,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:07:23.74,0:07:25.61,Default,,0,0,0,,«Мұзды сэндвич?»
Dialogue: 0,0:07:25.71,0:07:26.14,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:26.21,0:07:28.08,Default,,0,0,0,,«Тамақта?»
Dialogue: 0,0:07:28.88,0:07:30.85,Default,,0,0,0,,Бұл жақсы емес
Dialogue: 0,0:07:32.21,0:07:33.75,Default,,0,0,0,,Бунго Дұрыс жазу
Dialogue: 0,0:07:33.85,0:07:35.02,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:07:37.55,0:07:39.45,Default,,0,0,0,,Зейінін жинақтай алмайды
Dialogue: 0,0:07:39.89,0:07:40.72,Default,,0,0,0,,Кофе
Dialogue: 0,0:07:41.02,0:07:42.72,Default,,0,0,0,,Жоқ, бұл темекі.
Dialogue: 0,0:07:43.12,0:07:43.96,Default,,0,0,0,,Текила.
Dialogue: 0,0:07:44.66,0:07:46.76,Default,,0,0,0,,Маған музыка керек
Dialogue: 0,0:07:49.16,0:07:50.80,Default,,0,0,0,,Бұл есірткі ғой.
Dialogue: 0,0:07:52.90,0:07:55.64,Default,,0,0,0,,Сара Линн Өткен күні жаман болды.
Dialogue: 0,0:07:55.74,0:07:58.07,Default,,0,0,0,,Күшпен оңалтуға тырысты
Dialogue: 0,0:07:58.21,0:08:00.81,Default,,0,0,0,,Бүгін келгендеріңізге көп рахмет.
Dialogue: 0,0:08:00.91,0:08:01.78,Default,,0,0,0,,Бұл пайдалы.
Dialogue: 0,0:08:01.88,0:08:05.81,Default,,0,0,0,,Doctor Who материалы басқа деңгейде.
Dialogue: 0,0:08:05.91,0:08:07.92,Default,,0,0,0,,Мен жұмысқа шоғырланғым келеді.
Dialogue: 0,0:08:08.05,0:08:08.88,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:08:08.98,0:08:13.52,Default,,0,0,0,,Студенттер мұны тапсырмалармен айналысқанда да пайдаланады.
Dialogue: 0,0:08:13.69,0:08:15.49,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:08:15.59,0:08:18.06,Default,,0,0,0,,Мен де жасап көремін.
Dialogue: 0,0:08:19.79,0:08:21.06,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:08:21.20,0:08:22.06,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:21.20,0:08:22.06,Default,,0,0,0,,«Доктор Кім»
Dialogue: 0,0:08:22.06,0:08:22.16,Default,,0,0,0,,«Доктор Кім»
Dialogue: 0,0:08:22.16,0:08:24.20,Default,,0,0,0,,«Доктор Кім»
Dialogue: 0,0:08:22.16,0:08:24.20,Default,,0,0,0,,Мен Аллен Ху, дәрігермін.
Dialogue: 0,0:08:24.50,0:08:26.93,Default,,0,0,0,,Мен бұл «фу»
Dialogue: 0,0:08:27.03,0:08:28.54,Default,,0,0,0,,Демек, бұл Фу.
Dialogue: 0,0:08:28.70,0:08:31.07,Default,,0,0,0,,«HU» емес—
Dialogue: 0,0:08:31.21,0:08:32.54,Default,,0,0,0,,«Кім?»
Dialogue: 0,0:08:32.64,0:08:34.21,Default,,0,0,0,,Біз кім туралы айтып отырмыз?
Dialogue: 0,0:08:34.58,0:08:35.81,Default,,0,0,0,,Бұл әзіл ме?
Dialogue: 0,0:08:35.94,0:08:36.81,Default,,0,0,0,,Сіз қайда күлесіз?
Dialogue: 0,0:08:36.94,0:08:37.95,Default,,0,0,0,,Мен сенің жоғалып кеткеніңді қалаймын.
Dialogue: 0,0:08:38.08,0:08:40.95,Default,,0,0,0,,Бәрі жақсы, жай ғана күліңіз.
Dialogue: 0,0:08:41.05,0:08:44.85,Default,,0,0,0,,Бұл BBC арнасындағы танымал драма.
Dialogue: 0,0:08:44.95,0:08:47.82,Default,,0,0,0,,Бұл өткенге саяхат жасаған дәрігер туралы әңгіме.
Dialogue: 0,0:08:47.96,0:08:50.19,Default,,0,0,0,,Дұрыс, «Доктор Кім»
Dialogue: 0,0:08:50.83,0:08:53.09,Default,,0,0,0,,Ах, бұл «Доктор Кім»
Dialogue: 0,0:08:53.73,0:08:55.96,Default,,0,0,0,,Мен пионер дәуіріне барған эпизодты көрдім.
Dialogue: 0,0:08:56.10,0:08:58.20,Default,,0,0,0,,Оны әйел дәрігер деп атады.
Dialogue: 0,0:08:58.30,0:09:00.23,Default,,0,0,0,,Бұл «Доктор Куинн»
Dialogue: 0,0:09:00.54,0:09:01.20,Default,,0,0,0,,Патшайым деген кім?
Dialogue: 0,0:09:01.30,0:09:02.57,Default,,0,0,0,,Мен емес
Dialogue: 0,0:09:02.64,0:09:05.11,Default,,0,0,0,,Кім патшайым емес
Dialogue: 0,0:09:05.27,0:09:05.97,Default,,0,0,0,,Мен абдырап қалдым
Dialogue: 0,0:09:06.07,0:09:06.97,Default,,0,0,0,,Түсінбеу
Dialogue: 0,0:09:07.04,0:09:08.71,Default,,0,0,0,,Ол қашан күшіне енеді?
Dialogue: 0,0:09:08.84,0:09:10.58,Default,,0,0,0,,Жұмыс бастағалы жатыр.
Dialogue: 0,0:09:10.75,0:09:12.78,Default,,0,0,0,,Әр сағат сайын 3 таблеткадан ішіңіз.
Dialogue: 0,0:09:12.88,0:09:15.15,Default,,0,0,0,,Әр 30 минут сайын екі таблеткадан
Dialogue: 0,0:09:15.25,0:09:18.32,Default,,0,0,0,,Бұл әр 90 минут сайын 4 таблеткаға дейін
Dialogue: 0,0:09:18.62,0:09:22.26,Default,,0,0,0,,Алғашқы үш түр үшін 2 таблетка 4 таблетканың арасында.
Dialogue: 0,0:09:22.62,0:09:24.59,Default,,0,0,0,,Күн сәулесі мен суға қатаң тыйым салынады
Dialogue: 0,0:09:24.76,0:09:25.99,Default,,0,0,0,,Бұл гремлин ме?
Dialogue: 0,0:09:26.13,0:09:26.99,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:09:27.16,0:09:30.87,Default,,0,0,0,,Балаларға жүрекке операция жасаймын.
Dialogue: 0,0:09:31.00,0:09:32.10,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:09:34.77,0:09:37.27,Default,,0,0,0,,Жарайды, зейініңді жазуға аудар.
Dialogue: 0,0:09:39.27,0:09:40.74,Default,,0,0,0,,Бұл ақылсыз болады
Dialogue: 0,0:09:40.84,0:09:42.71,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:09:45.28,0:09:46.15,Default,,0,0,0,,Тодд
Dialogue: 0,0:09:46.25,0:09:48.62,Default,,0,0,0,,«Жүрек жылытатын сыр» неде?
Dialogue: 0,0:09:48.78,0:09:52.29,Default,,0,0,0,,Енді бізге «ең жақсы достар» болатын кез келді
Dialogue: 0,0:09:52.59,0:09:53.19,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:09:53.32,0:09:55.02,Default,,0,0,0,,Бірақ оны «дос» етіңіз
Dialogue: 0,0:09:55.16,0:09:57.63,Default,,0,0,0,,«Ат немесе шу» қай дәуір болды?
Dialogue: 0,0:09:57.73,0:10:01.60,Default,,0,0,0,,Халк Хоганның қонаққа келуі.
Dialogue: 0,0:10:01.70,0:10:03.30,Default,,0,0,0,,Жақсы, жаза бер.
Dialogue: 0,0:10:04.60,0:10:06.77,Default,,0,0,0,,Мен оны Хоганға көрсеткім келеді.
Dialogue: 0,0:10:07.70,0:10:08.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:08.24,0:10:10.61,Default,,0,0,0,,Бұл Сара Линн туралы.
Dialogue: 0,0:10:11.37,0:10:13.61,Default,,0,0,0,,Бұл 4 сағат бұрын болды.
Dialogue: 0,0:10:13.71,0:10:16.21,Default,,0,0,0,,Иә? Ол қалай дамып жатыр?
Dialogue: 0,0:10:16.31,0:10:16.94,Default,,0,0,0,,Жіберу
Dialogue: 0,0:10:17.04,0:10:18.31,Default,,0,0,0,,Жіберу
Dialogue: 0,0:10:18.65,0:10:20.31,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:10:20.65,0:10:23.65,Default,,0,0,0,,216 қолжазба беті бар. Бұл керемет.
Dialogue: 0,0:10:23.78,0:10:26.05,Default,,0,0,0,,Бұл ``Ферма'' сияқты ұзын.
Dialogue: 0,0:10:26.19,0:10:28.32,Default,,0,0,0,,Сіздің мақсатыңыз 200 дана болды, солай ма?
Dialogue: 0,0:10:28.66,0:10:32.29,Default,,0,0,0,,Мен әлі жаза аламын, басым айналады
Dialogue: 0,0:10:32.39,0:10:35.33,Default,,0,0,0,,Әдеби стиль және қызықты
Dialogue: 0,0:10:35.66,0:10:38.10,Default,,0,0,0,,Жағажайда оңай оқу
Dialogue: 0,0:10:38.20,0:10:40.07,Default,,0,0,0,,Дайан жоғарыда
Dialogue: 0,0:10:40.20,0:10:43.07,Default,,0,0,0,,«Көп тергеннен саусақтарым дірілдеп жатыр...»
Dialogue: 0,0:10:43.20,0:10:45.34,Default,,0,0,0,,«Мен саусақтарымда етеккір ауыратындай сезінемін».
Dialogue: 0,0:10:45.64,0:10:47.07,Default,,0,0,0,,Дайан мұны айтты ма?
Dialogue: 0,0:10:47.17,0:10:49.18,Default,,0,0,0,,Жоқ, бірақ саусақтарым дірілдеп тұр.
Dialogue: 0,0:10:49.28,0:10:51.08,Default,,0,0,0,,Бұл етеккірдегі ауырсыну сияқты
Dialogue: 0,0:10:51.18,0:10:52.35,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:10:54.18,0:10:56.18,Default,,0,0,0,,Бұл достық күлімсіреу ме?
Dialogue: 0,0:10:57.89,0:10:58.82,Default,,0,0,0,,Қызықты
Dialogue: 0,0:10:58.95,0:11:00.96,Default,,0,0,0,,Соңғы тарауда не істеуіміз керек?
Dialogue: 0,0:11:01.09,0:11:02.82,Default,,0,0,0,,Біз қалай аяқтаймыз ...
Dialogue: 0,0:11:02.96,0:11:05.89,Default,,0,0,0,,Ол басынан бастап Жер болды ма?
Dialogue: 0,0:11:05.99,0:11:09.10,Default,,0,0,0,,Қабылданбады, бірақ мен онымен барамын.
Dialogue: 0,0:11:18.87,0:11:19.84,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:11:20.11,0:11:22.14,Default,,0,0,0,,Сен киіміңді ауыстырдың ба?
Dialogue: 0,0:11:22.68,0:11:23.24,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:26.31,0:11:27.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:27.82,0:11:29.35,Default,,0,0,0,,Менің ойымша, бұл идея жақсы.
Dialogue: 0,0:11:30.12,0:11:31.12,Default,,0,0,0,,Бұл соңы.
Dialogue: 0,0:11:31.22,0:11:31.99,Default,,0,0,0,,Менікі?
Dialogue: 0,0:11:32.09,0:11:34.22,Default,,0,0,0,,Бұл Мэн туралы.
Dialogue: 0,0:11:34.32,0:11:36.86,Default,,0,0,0,,Маған жазғы көлде жүзу туралы әңгімелер ұнайды.
Dialogue: 0,0:11:36.96,0:11:40.13,Default,,0,0,0,,Мен қартайып, мейірбике күтіміне мұқтаж болғанда...
Dialogue: 0,0:11:40.26,0:11:44.93,Default,,0,0,0,,Көлге шомылдым, айнып қалдым, жағаға қайтуға күшім жетпеді.
Dialogue: 0,0:11:45.03,0:11:47.13,Default,,0,0,0,,Жай ғана көлге батып кет.
Dialogue: 0,0:11:47.27,0:11:49.90,Default,,0,0,0,,Бұл шынымен де қараңғы аяқталды.
Dialogue: 0,0:11:50.04,0:11:50.87,Default,,0,0,0,,Басқа идеялар бар ма?
Dialogue: 0,0:11:50.97,0:11:54.04,Default,,0,0,0,,Мұның қалай аяқталатынын білмеймін
Dialogue: 0,0:11:54.14,0:11:56.24,Default,,0,0,0,,Мен әлі өлген жоқпын
Dialogue: 0,0:11:56.34,0:12:00.31,Default,,0,0,0,,Аяқтау жазғың келсе, соңына жету керек.
Dialogue: 0,0:12:00.41,0:12:01.72,Default,,0,0,0,,Бүгін түнде өлесің бе?
Dialogue: 0,0:12:01.82,0:12:04.42,Default,,0,0,0,,Жақсы идея, мен сені өлтіремін.
Dialogue: 0,0:12:07.09,0:12:08.12,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:12:08.22,0:12:09.42,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:12:09.72,0:12:12.26,Default,,0,0,0,,Бағдарламада тәрбиеленген қызға
Dialogue: 0,0:12:12.36,0:12:14.03,Default,,0,0,0,,Шынайы өмірде өлтірілген
Dialogue: 0,0:12:15.16,0:12:18.17,Default,,0,0,0,,Адамдардың бақытсыздық туралы әңгімелері жақсы сатылады.
Dialogue: 0,0:12:18.30,0:12:20.87,Default,,0,0,0,,Жақсы кітап жынды сияқты сатылады.
Dialogue: 0,0:12:20.97,0:12:24.17,Default,,0,0,0,,Иә, БоДжекті өлтіріңіз.
Dialogue: 0,0:12:38.32,0:12:39.75,Default,,0,0,0,,Мен бір нәрсені білдім
Dialogue: 0,0:12:39.92,0:12:41.92,Default,,0,0,0,,Есірткі қабылдау кезінде—
Dialogue: 0,0:12:42.06,0:12:44.93,Default,,0,0,0,,Үйіңіздің қауіпсіздігі үшін бірге істеу керек нәрселер
Dialogue: 0,0:12:45.06,0:12:45.93,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:12:47.06,0:12:48.20,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:12:48.26,0:12:50.80,Default,,0,0,0,,Бұл мылтық өзін-өзі қорғауға арналған.
Dialogue: 0,0:12:50.93,0:12:51.90,Default,,0,0,0,,Бір-біріне
Dialogue: 0,0:12:52.00,0:12:53.93,Default,,0,0,0,,Мылтық тәрізді оттық?
Dialogue: 0,0:12:54.07,0:12:55.07,Default,,0,0,0,,Жеңілірек пішінді мылтық?
Dialogue: 0,0:12:55.20,0:12:57.14,Default,,0,0,0,,Сіз білдіңіз бе? Бұл жазушы.
Dialogue: 0,0:12:58.91,0:13:01.78,Default,,0,0,0,,Бұл мылтық болды. Шақпақ қайда?
Dialogue: 0,0:13:02.01,0:13:03.34,Default,,0,0,0,,Сіз оны нәрестеге бердіңіз бе?
Dialogue: 0,0:13:03.44,0:13:05.08,Default,,0,0,0,,Менің де мылтығым бар
Dialogue: 0,0:13:05.98,0:13:08.25,Default,,0,0,0,,Ақымақ, мынау сыпырғыш.
Dialogue: 0,0:13:09.42,0:13:11.09,Default,,0,0,0,,Мылтық туралы не деуге болады?
Dialogue: 0,0:13:11.89,0:13:13.99,Default,,0,0,0,,Бұл мылтық па? сыпырғыш?
Dialogue: 0,0:13:14.42,0:13:17.19,Default,,0,0,0,,Мен қайсысы екенін білмеймін.
Dialogue: 0,0:13:17.29,0:13:19.83,Default,,0,0,0,,Бір-бірімізді атайық
Dialogue: 0,0:13:19.96,0:13:22.83,Default,,0,0,0,,Қайсысы нақты екені анық.
Dialogue: 0,0:13:22.96,0:13:24.20,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:24.47,0:13:26.10,Default,,0,0,0,,Саған бір нәрсе сұрасам бола ма?
Dialogue: 0,0:13:26.20,0:13:28.50,Default,,0,0,0,,Тыныш және тыңда. Мен растағым келеді.
Dialogue: 0,0:13:28.84,0:13:30.10,Default,,0,0,0,,Түсінікті болайық
Dialogue: 0,0:13:30.24,0:13:33.51,Default,,0,0,0,,Оның мылтық немесе сыпырғыш екеніне көз жеткізіңіз, жарай ма?
Dialogue: 0,0:13:33.81,0:13:38.38,Default,,0,0,0,,Рок-опера туралы Сіз әлі ашуланған жоқсыз, солай ма?
Dialogue: 0,0:13:38.48,0:13:39.51,Default,,0,0,0,,Боджак
Dialogue: 0,0:13:39.85,0:13:41.95,Default,,0,0,0,,Аузыңды жап және тыңда
Dialogue: 0,0:13:42.05,0:13:42.98,Default,,0,0,0,,Мен зардап шектім
Dialogue: 0,0:13:43.12,0:13:45.59,Default,,0,0,0,,Бірақ мен түсінемін.
Dialogue: 0,0:13:45.95,0:13:49.46,Default,,0,0,0,,Мен енді сенен ештеңе күтпеймін.
Dialogue: 0,0:13:49.56,0:13:52.86,Default,,0,0,0,,Сені қайта ренжітуге жол берме.
Dialogue: 0,0:13:53.16,0:13:54.86,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:13:55.00,0:13:55.43,Default,,0,0,0,,Біраз
Dialogue: 0,0:13:55.56,0:13:57.90,Default,,0,0,0,,Мен мылтықсызмын ба?
Dialogue: 0,0:13:58.03,0:14:01.47,Default,,0,0,0,,Барлығына бірдей болмаған дұрыс.
Dialogue: 0,0:14:01.57,0:14:03.00,Default,,0,0,0,,Енді сіз өзіңізді қауіпсіз сезіне аласыз.
Dialogue: 0,0:14:03.14,0:14:03.84,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:14:03.94,0:14:06.27,Default,,0,0,0,,Енді біз Американың қару мәселесін шештік пе?
Dialogue: 0,0:14:06.41,0:14:08.01,Default,,0,0,0,,«Адамдарға қару»
Dialogue: 0,0:14:12.55,0:14:15.15,Default,,0,0,0,,Көбірек есірткі жасайық
Dialogue: 0,0:14:19.15,0:14:22.06,Default,,0,0,0,,Енді Американың есірткі мәселесін шешейік.
Dialogue: 0,0:14:22.16,0:14:23.56,Default,,0,0,0,,Олардың барлығын пайдаланыңыз
Dialogue: 0,0:14:23.86,0:14:24.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:36.60,0:14:39.91,Default,,0,0,0,,2 күннен кейін
Dialogue: 0,0:14:41.41,0:14:42.41,Default,,0,0,0,,БоДжек?
Dialogue: 0,0:14:46.95,0:14:48.45,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:14:48.58,0:14:49.88,Default,,0,0,0,,О
Dialogue: 0,0:14:49.98,0:14:52.92,Default,,0,0,0,,Мен бұл туралы ойладым, сіз дұрыс айтасыз.
Dialogue: 0,0:14:53.02,0:14:55.32,Default,,0,0,0,,Өмірбаян – адамның өзі
Dialogue: 0,0:14:55.42,0:14:57.93,Default,,0,0,0,,Өзіңізді қанағаттандыратын кітап жасаңыз
Dialogue: 0,0:14:58.33,0:14:59.03,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:14:59.13,0:15:02.56,Default,,0,0,0,,Екеуміз келісе алатын кітап құрастырайық.
Dialogue: 0,0:15:02.93,0:15:05.10,Default,,0,0,0,,(Абдул) Иә. (Жан) Иә
Dialogue: 0,0:15:06.27,0:15:07.20,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:15:13.47,0:15:14.34,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:14.44,0:15:15.48,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:15:16.48,0:15:17.54,Default,,0,0,0,,Матадава
Dialogue: 0,0:15:20.61,0:15:21.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:22.12,0:15:27.09,Default,,0,0,0,,Мен құймақтарды көп жедім.
Dialogue: 0,0:15:27.19,0:15:29.22,Default,,0,0,0,,Әлі де ессіз
Dialogue: 0,0:15:29.32,0:15:32.96,Default,,0,0,0,,Екі күнде емес, бар болғаны екі минутта.
Dialogue: 0,0:15:37.03,0:15:39.10,Default,,0,0,0,,Мені сүй
Dialogue: 0,0:16:00.52,0:16:04.36,Default,,0,0,0,,Сен маған опасыздық жасадың. Мен өлсем де сені кешірмеймін.
Dialogue: 0,0:16:05.16,0:16:07.59,Default,,0,0,0,,Мен жержаңғақ маймын
Dialogue: 0,0:16:07.70,0:16:09.30,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:12.47,0:16:13.17,Default,,0,0,0,,Не?
Dialogue: 0,0:16:22.01,0:16:23.98,Default,,0,0,0,,Бұл жер қай жер?
Dialogue: 0,0:16:24.08,0:16:27.38,Default,,0,0,0,,Сабыр ет, фон жойылды.
Dialogue: 0,0:16:27.48,0:16:30.02,Default,,0,0,0,,Тек фонмен шекара жоқ
Dialogue: 0,0:16:30.15,0:16:32.29,Default,,0,0,0,,Бұл жиі болады.
Dialogue: 0,0:16:37.69,0:16:38.69,Default,,0,0,0,,Сіз көмектесесіз бе?
Dialogue: 0,0:16:39.03,0:16:40.69,Default,,0,0,0,,Жасайық
Dialogue: 0,0:16:45.40,0:16:46.30,Default,,0,0,0,,Ой
Dialogue: 0,0:16:48.37,0:16:50.04,Default,,0,0,0,,Мен не істеуім керек? Маған көмектесіңіз...
Dialogue: 0,0:16:57.31,0:16:58.71,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:59.05,0:16:59.58,Default,,0,0,0,,Кесу
Dialogue: 0,0:16:59.71,0:17:01.68,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:17:01.78,0:17:04.59,Default,,0,0,0,,Жол «Бұл менмін»
Dialogue: 0,0:17:04.69,0:17:06.55,Default,,0,0,0,,«Өзгеріс жоқ», солай ма?
Dialogue: 0,0:17:06.65,0:17:08.69,Default,,0,0,0,,«Бұл менмін, мен өзгермеймін».
Dialogue: 0,0:17:08.79,0:17:10.42,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:10.52,0:17:11.69,Default,,0,0,0,,Әке
Dialogue: 0,0:17:21.07,0:17:22.34,Default,,0,0,0,,Әй, ат
Dialogue: 0,0:17:22.47,0:17:23.20,Default,,0,0,0,,Не?
Dialogue: 0,0:17:23.34,0:17:27.07,Default,,0,0,0,,Пенис майы мен қынап желе сэндвичі
Dialogue: 0,0:17:27.17,0:17:28.08,Default,,0,0,0,,Не?
Dialogue: 0,0:17:28.21,0:17:31.48,Default,,0,0,0,,Пенис майы және вагинальды желе
Dialogue: 0,0:17:31.58,0:17:32.78,Default,,0,0,0,,Бұл сэндвич.
Dialogue: 0,0:17:34.35,0:17:35.35,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:17:35.48,0:17:36.35,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:17:38.05,0:17:41.22,Default,,0,0,0,,Қазір тым кеш, БоДжек.
Dialogue: 0,0:17:41.42,0:17:43.49,Default,,0,0,0,,Бұл сіз таңдаған жол
Dialogue: 0,0:17:45.39,0:17:47.49,Default,,0,0,0,,Батып бара жатырмын, маған біреу көмектес
Dialogue: 0,0:17:47.63,0:17:49.33,Default,,0,0,0,,Бұл түбі жоқ шұңқыр.
Dialogue: 0,0:17:49.43,0:17:51.60,Default,,0,0,0,,Менімен Мэнге келгіңіз келе ме?
Dialogue: 0,0:17:51.70,0:17:53.47,Default,,0,0,0,,Бұл мүмкін емес, мен қозғала алмаймын.
Dialogue: 0,0:17:53.57,0:17:55.20,Default,,0,0,0,,Менің барғым келеді
Dialogue: 0,0:17:55.30,0:17:56.60,Default,,0,0,0,,Бірақ бұл мүмкін емес.
Dialogue: 0,0:17:56.70,0:17:57.77,Default,,0,0,0,,Шық
Dialogue: 0,0:17:58.11,0:17:59.21,Default,,0,0,0,,Шығу мүмкін емес
Dialogue: 0,0:17:59.31,0:18:01.48,Default,,0,0,0,,Сыртқа шыққыңыз келмейді, солай ма?
Dialogue: 0,0:18:01.58,0:18:05.25,Default,,0,0,0,,Қонақтарға әнді дұрыс айтуды айттым.
Dialogue: 0,0:18:05.38,0:18:08.12,Default,,0,0,0,,«Ллипоп» әнін айту
Dialogue: 0,0:18:08.25,0:18:09.65,Default,,0,0,0,,Мен ән айтқым келмейді
Dialogue: 0,0:18:09.78,0:18:11.65,Default,,0,0,0,,Мен бұл туралы ештеңе білмеймін.
Dialogue: 0,0:18:11.79,0:18:13.39,Default,,0,0,0,,Тұтынушы күтіп тұр.
Dialogue: 0,0:18:13.52,0:18:15.39,Default,,0,0,0,,Өлеңіңді тыңдайын
Dialogue: 0,0:18:15.52,0:18:17.12,Default,,0,0,0,,Ана махаббатын қаласаңыз—
Dialogue: 0,0:18:17.26,0:18:20.53,Default,,0,0,0,,Сахнаға тұрып, бізге өзіңіздің ерекше өнеріңізді көрсетіңіз.
Dialogue: 0,0:18:20.63,0:18:24.13,Default,,0,0,0,,Әдеттегідей «Ллипоп» әнін айт.
Dialogue: 0,0:18:24.60,0:18:25.80,Default,,0,0,0,,Мұқият тыңдаңыз
Dialogue: 0,0:18:26.13,0:18:28.67,Default,,0,0,0,,Мәңгілік өмір сүру үшін...
Dialogue: 0,0:18:28.87,0:18:30.10,Default,,0,0,0,,«Беатрис шабандозы»
Dialogue: 0,0:18:32.37,0:18:34.37,Default,,0,0,0,,«БоДжек шабандозы»
Dialogue: 0,0:18:34.48,0:18:35.11,Default,,0,0,0,,Эй
Dialogue: 0,0:18:37.14,0:18:38.61,Default,,0,0,0,,«Ақаулық бойынша кеңес беру үшін 5 цент»
Dialogue: 0,0:18:38.71,0:18:40.41,Default,,0,0,0,,Сізде алаңдаушылық бар ма?
Dialogue: 0,0:18:40.61,0:18:42.58,Default,,0,0,0,,Мен депрессиядамын.
Dialogue: 0,0:18:42.72,0:18:45.39,Default,,0,0,0,,Мен барлығына ұнамды болғым келеді
Dialogue: 0,0:18:45.49,0:18:47.29,Default,,0,0,0,,Махаббатты мәжбүрлеу мүмкін емес
Dialogue: 0,0:18:47.42,0:18:51.13,Default,,0,0,0,,Өзгелерге мейірімді бол, жүрегіңді аш
Dialogue: 0,0:18:51.23,0:18:53.43,Default,,0,0,0,,Қазірдің өзінде кеш, солай емес пе?
Dialogue: 0,0:18:53.56,0:18:56.83,Default,,0,0,0,,Мен галлюцинациямын, сондықтан не қаласаңыз, жауап беремін.
Dialogue: 0,0:18:57.16,0:18:58.53,Default,,0,0,0,,Әлі уақыт па?
Dialogue: 0,0:18:58.63,0:19:00.70,Default,,0,0,0,,Жарайды, әлі де кеш емес.
Dialogue: 0,0:19:00.83,0:19:01.57,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:01.70,0:19:04.64,Default,,0,0,0,,Ешқашан кеш емес
Dialogue: 0,0:19:04.74,0:19:06.57,Default,,0,0,0,,Өз өміріңді өзің шешесің
Dialogue: 0,0:19:07.24,0:19:12.31,Default,,0,0,0,,Кеңес беру ақысы 5 цент...
Dialogue: 0,0:19:22.86,0:19:24.16,Default,,0,0,0,,Боджак
Dialogue: 0,0:19:24.26,0:19:25.19,Default,,0,0,0,,Не?
Dialogue: 0,0:19:25.33,0:19:26.73,Default,,0,0,0,,Күріш.
Dialogue: 0,0:19:28.33,0:19:31.20,Default,,0,0,0,,Эд: «Аспан шулы», - деді.
Dialogue: 0,0:19:31.33,0:19:34.20,Default,,0,0,0,,«Аспан шулы» деген нені білдіреді?
Dialogue: 0,0:19:34.33,0:19:36.60,Default,,0,0,0,,Ол ең шулы.
Dialogue: 0,0:19:37.60,0:19:40.21,Default,,0,0,0,,БоДжек, тоқтат.
Dialogue: 0,0:19:40.34,0:19:41.88,Default,,0,0,0,,Неге жасырып жатырсың?
Dialogue: 0,0:19:42.21,0:19:44.75,Default,,0,0,0,,Мен шайқауға шыдай алмаймын
Dialogue: 0,0:19:46.35,0:19:49.88,Default,,0,0,0,,Мен сенімен мәңгі бірге болғым келеді
Dialogue: 0,0:19:50.32,0:19:51.49,Default,,0,0,0,,Әрине.
Dialogue: 0,0:19:51.59,0:19:54.62,Default,,0,0,0,,Бірақ бұл «сол сияқты» мүмкін болмауы мүмкін
Dialogue: 0,0:19:54.76,0:19:56.36,Default,,0,0,0,,Мен жүктімін.
Dialogue: 0,0:19:56.49,0:19:58.49,Default,,0,0,0,,Бұл мені бақытты етеді.
Dialogue: 0,0:19:58.59,0:20:00.89,Default,,0,0,0,,Сіздің балаңыздың сексен пайызы.
Dialogue: 0,0:20:04.40,0:20:06.90,Default,,0,0,0,,Дәл қазір сені ұстау жаман ба?
Dialogue: 0,0:20:07.23,0:20:08.47,Default,,0,0,0,,Неліктен нашар?
Dialogue: 0,0:20:08.64,0:20:10.77,Default,,0,0,0,,Нәресте қорқуы мүмкін
Dialogue: 0,0:20:11.21,0:20:13.94,Default,,0,0,0,,Біраз уақыт ауызымызбен, қолымызбен жасайық.
Dialogue: 0,0:20:23.52,0:20:25.25,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:20:25.55,0:20:27.52,Default,,0,0,0,,Әке мұнда, әке!
Dialogue: 0,0:20:27.65,0:20:29.79,Default,,0,0,0,,Чиби-чан, әке!
Dialogue: 0,0:20:29.92,0:20:30.79,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:20:31.93,0:20:33.99,Default,,0,0,0,,Мен оны жеймін
Dialogue: 0,0:20:38.77,0:20:39.67,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:20:39.77,0:20:40.40,Default,,0,0,0,,Харпер
Dialogue: 0,0:20:40.67,0:20:42.67,Default,,0,0,0,,Жұлдыздар жоқ
Dialogue: 0,0:20:42.77,0:20:43.67,Default,,0,0,0,,Мен аспандамын
Dialogue: 0,0:20:43.80,0:20:46.27,Default,,0,0,0,,Сіз оны күндіз көре алмайсыз.
Dialogue: 0,0:20:47.27,0:20:47.81,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:20:47.94,0:20:48.64,Default,,0,0,0,,Не?
Dialogue: 0,0:20:48.74,0:20:52.38,Default,,0,0,0,,Әкем екеуміз дос бола аламыз ба?
Dialogue: 0,0:20:52.48,0:20:53.78,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:20:53.88,0:20:56.75,Default,,0,0,0,,Сізге печенье, жасыл желек және өрілген ұнайды ма?
Dialogue: 0,0:20:56.85,0:20:59.29,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:20:59.42,0:21:03.32,Default,,0,0,0,,Мен достық сұрау жібердім, сондықтан күту ғана қалды.
Dialogue: 0,0:21:03.56,0:21:04.83,Default,,0,0,0,,Бекіту
Dialogue: 0,0:21:10.63,0:21:12.43,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:21:17.44,0:21:18.71,Default,,0,0,0,,Сіз үлкейдіңіз.
Dialogue: 0,0:21:18.84,0:21:20.84,Default,,0,0,0,,Ол велосипед теуіп жүр.
Dialogue: 0,0:21:20.97,0:21:23.38,Default,,0,0,0,,Бұл скутер
Dialogue: 0,0:21:24.44,0:21:25.85,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:27.38,0:21:28.32,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:21:28.45,0:21:33.05,Default,,0,0,0,,Бұл өмірде бақытты болуың мүмкін еді.
Dialogue: 0,0:21:41.06,0:21:42.60,Default,,0,0,0,,Не? Бұл қайда?
Dialogue: 0,0:21:43.76,0:21:44.43,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:21:44.53,0:21:46.33,Default,,0,0,0,,Мен қолжазбаны оқыдым.
Dialogue: 0,0:21:46.47,0:21:47.67,Default,,0,0,0,,Мен түсінікті боламын.
Dialogue: 0,0:21:47.77,0:21:50.00,Default,,0,0,0,,Сіздің кітабыңыз толығымен—
Dialogue: 0,0:21:50.34,0:21:53.47,Default,,0,0,0,,Сөзсіз ең жақсы... Түсінбедім.
Dialogue: 0,0:21:53.57,0:21:54.47,Default,,0,0,0,,Бұл мағынасы жоқ.
Dialogue: 0,0:21:54.57,0:21:55.48,Default,,0,0,0,,Бүгін аптаның қай күні?
Dialogue: 0,0:21:55.58,0:21:59.01,Default,,0,0,0,,«Доктор Кім» ересектерге арналған романдар
Dialogue: 0,0:21:59.35,0:22:00.51,Default,,0,0,0,,Сорпа рецепті
Dialogue: 0,0:22:00.61,0:22:03.02,Default,,0,0,0,,11 қыркүйектегі лаңкестік әрекеттерге қатысты жеке теориялар
Dialogue: 0,0:22:03.35,0:22:07.49,Default,,0,0,0,,Кітапқа айналдыруға болмайтын бірнеше бейне сілтемелері
Dialogue: 0,0:22:08.62,0:22:09.79,Default,,0,0,0,,Түсіндім, кесіп таста.
Dialogue: 0,0:22:10.39,0:22:13.59,Default,,0,0,0,,«Ghostwriter конференциясы»
Dialogue: 0,0:22:13.69,0:22:15.63,Default,,0,0,0,,Сұрақ қою
Dialogue: 0,0:22:15.76,0:22:18.33,Default,,0,0,0,,Ghostwriter жауаптары
Dialogue: 0,0:22:18.43,0:22:21.37,Default,,0,0,0,,Tori Spelling-ке сұрағым бар.
Dialogue: 0,0:22:21.47,0:22:23.84,Default,,0,0,0,,Сплинг мырза бұл жерде жоқ.
Dialogue: 0,0:22:23.94,0:22:25.34,Default,,0,0,0,,Мен сізге айттым
Dialogue: 0,0:22:25.44,0:22:28.44,Default,,0,0,0,,Мен оның елес жазушысы болғым келеді.
Dialogue: 0,0:22:28.51,0:22:31.51,Default,,0,0,0,,Кездесудің мақсатын түсініңіз
Dialogue: 0,0:22:32.78,0:22:34.05,Default,,0,0,0,,Келесі адамды жіберіңіз
Dialogue: 0,0:22:34.38,0:22:36.78,Default,,0,0,0,,Менің бәріңізге қояр сұрағым бар.
Dialogue: 0,0:22:36.88,0:22:39.75,Default,,0,0,0,,Сіздің сүйікті елесіңіз кім?
Dialogue: 0,0:22:40.05,0:22:43.79,Default,,0,0,0,,Олар қорқынышты жазушылар емес...
Dialogue: 0,0:22:44.02,0:22:45.76,Default,,0,0,0,,Мен оны тоқтатуым керек еді.
Dialogue: 0,0:22:46.39,0:22:49.06,Default,,0,0,0,,Қатысушыларға –
Dialogue: 0,0:22:49.40,0:22:51.43,Default,,0,0,0,,Ақылға қонымды сұрақ қойыңыз
Dialogue: 0,0:22:51.67,0:22:55.67,Default,,0,0,0,,Бұл қалыпты сұрақ па? Мені ату үшін мылтық бер.
Dialogue: 0,0:22:55.77,0:22:56.84,Default,,0,0,0,,Сұрақ
Dialogue: 0,0:22:56.94,0:22:58.37,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:22:59.41,0:23:00.81,Default,,0,0,0,,Дайанға сұрақ
Dialogue: 0,0:23:01.44,0:23:04.08,Default,,0,0,0,,Саған айтқанымның бәрі үшін кешірім сұраймын.
Dialogue: 0,0:23:04.41,0:23:05.91,Default,,0,0,0,,Кітабыңызды басып шығарыңыз
Dialogue: 0,0:23:06.01,0:23:08.65,Default,,0,0,0,,Сен маған қарағанда жақсы жазасың, ал...
Dialogue: 0,0:23:09.08,0:23:12.39,Default,,0,0,0,,Көпшіліктің назары енді маңызды емес
Dialogue: 0,0:23:12.75,0:23:16.56,Default,,0,0,0,,Мен сенен кім екенімді білмей қорықтым.
Dialogue: 0,0:23:17.42,0:23:19.69,Default,,0,0,0,,Сіз басқалардан артықсыз
Dialogue: 0,0:23:19.83,0:23:21.09,Default,,0,0,0,,Сіз мені танисыз...
Dialogue: 0,0:23:22.43,0:23:26.53,Default,,0,0,0,,Мәселен, мен кешігіп қалдым ба?
Dialogue: 0,0:23:26.63,0:23:27.40,Default,,0,0,0,,Не?
Dialogue: 0,0:23:27.73,0:23:32.57,Default,,0,0,0,,Сіздің кітабыңыздағы адам нағыз мен бе?
Dialogue: 0,0:23:32.67,0:23:36.14,Default,,0,0,0,,Мен үшін әлі де кеш емес, солай ма?
Dialogue: 0,0:23:36.44,0:23:38.45,Default,,0,0,0,,Айтыңызшы, әлі де кеш емес
Dialogue: 0,0:23:38.55,0:23:39.41,Default,,0,0,0,,БоДжек…
Dialogue: 0,0:23:39.51,0:23:41.72,Default,,0,0,0,,Маған жақсы адам екеніңді айт
Dialogue: 0,0:23:41.85,0:23:44.08,Default,,0,0,0,,Өзімшіл, нарциссист болғанымен.
Dialogue: 0,0:23:44.18,0:23:47.05,Default,,0,0,0,,Ол жақсы жігіт.
Dialogue: 0,0:23:47.15,0:23:48.86,Default,,0,0,0,,Мен сенің аузыңнан естігім келеді
Dialogue: 0,0:23:49.19,0:23:49.99,Default,,0,0,0,,Дайан
Dialogue: 0,0:23:51.06,0:23:53.69,Default,,0,0,0,,Маған жақсы адам екеніңді айт
Dialogue: 0,0:24:09.11,0:24:12.71,Default,,0,0,0,,Сен «атсың ба, әлде аласапырансың ба?»
Dialogue: 0,0:24:14.21,0:24:20.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
