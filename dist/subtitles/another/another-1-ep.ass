Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.24,0:00:10.10,Default,,0,0,0,,Мисакиді білесіз бе?
Dialogue: 0,0:00:11.17,0:00:13.98,Default,,0,0,0,,Мисаки 3-сынып, 3-сынып
Dialogue: 0,0:00:14.20,0:00:16.94,Default,,0,0,0,,3-сыныпта осындай адам болды ма?
Dialogue: 0,0:00:17.33,0:00:19.12,Default,,0,0,0,,Бұл жиырма алты жыл бұрын болды.
Dialogue: 0,0:00:20.30,0:00:21.39,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:00:21.54,0:00:23.63,Default,,0,0,0,,Ол бірінші курстан бастап танымал болды.
Dialogue: 0,0:00:24.07,0:00:26.78,Default,,0,0,0,,Оның басы, жүзі, мінезі жақсы болған көрінеді.
Dialogue: 0,0:00:27.61,0:00:30.96,Default,,0,0,0,,Сондықтан мені студенттер де, мұғалімдер де жақсы көреді.
Dialogue: 0,0:00:31.25,0:00:34.29,Default,,0,0,0,,Әр сыныпта осындай біреу бар.
Dialogue: 0,0:00:34.75,0:00:36.61,Default,,0,0,0,,Алайда үшінші курсқа кіргеннен кейін көп ұзамай
Dialogue: 0,0:00:36.94,0:00:38.86,Default,,0,0,0,,Мисаки қайтыс болды.
Dialogue: 0,0:00:40.21,0:00:41.01,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:00:41.15,0:00:42.33,Default,,0,0,0,,Мен мұны оқыс оқиға деп естідім.
Dialogue: 0,0:00:43.27,0:00:44.05,Default,,0,0,0,,Осымен
Dialogue: 0,0:00:44.22,0:00:46.22,Default,,0,0,0,,Барлығы қатты шок болды.
Dialogue: 0,0:00:46.51,0:00:48.83,Default,,0,0,0,,Осы кезде кенет біреу бірдеңе айта бастады.
Dialogue: 0,0:00:49.63,0:00:50.25,Default,,0,0,0,,Не?
Dialogue: 0,0:00:51.91,0:00:54.18,Default,,0,0,0,,Мисаки пайдаланған партаны көрсетіп.
Dialogue: 0,0:00:54.67,0:00:56.04,Default,,0,0,0,,Мисаки сонда
Dialogue: 0,0:00:56.27,0:00:57.98,Default,,0,0,0,,Мисаки өлген жоқ.
Dialogue: 0,0:00:58.51,0:00:59.66,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:01:00.15,0:01:01.98,Default,,0,0,0,,Бұл жай ғана елестету.
Dialogue: 0,0:01:02.51,0:01:04.67,Default,,0,0,0,,Содан бастап 3-сынып жалғастырылды.
Dialogue: 0,0:01:05.00,0:01:08.17,Default,,0,0,0,,Мисаки өзін тірімін деп көрсетуді шешті.
Dialogue: 0,0:01:09.26,0:01:11.13,Default,,0,0,0,,Бұл аздап қорқынышты.
Dialogue: 0,0:01:12.10,0:01:15.00,Default,,0,0,0,,Ақырында, бұл сылтау оқу бітіргенге дейін жалғасты.
Dialogue: 0,0:01:15.44,0:01:17.63,Default,,0,0,0,,Мектеп бітіру рәсімін директор ұйымдастырды.
Dialogue: 0,0:01:17.75,0:01:19.61,Default,,0,0,0,,Мисакидің орны дайындалған сияқты.
Dialogue: 0,0:01:20.07,0:01:21.21,Default,,0,0,0,,Жақсы әңгіме емес.
Dialogue: 0,0:01:22.25,0:01:23.62,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:01:24.70,0:01:27.12,Default,,0,0,0,,Жалғасы бар
Dialogue: 0,0:01:28.03,0:01:30.23,Default,,0,0,0,,Жалғасы қандай?
Dialogue: 0,0:01:41.05,0:01:44.60,Default,,0,0,0,,Түнді жабу үшін қабақтарыңызды ашыңыз
Dialogue: 0,0:01:44.60,0:01:47.90,Default,,0,0,0,,Күресіп жатқан көлеңкеден қорық.
Dialogue: 0,0:01:51.20,0:01:55.94,Default,,0,0,0,,Қараңғы табыттан
Dialogue: 0,0:01:57.37,0:02:04.24,Default,,0,0,0,,Жаңа туған қуыршақ сияқты
Dialogue: 0,0:02:04.36,0:02:09.24,Default,,0,0,0,,Дене қызарып, қатып қалады.
Dialogue: 0,0:02:10.68,0:02:17.95,Default,,0,0,0,,Менің жүрегім қараңғылықта өседі және қамқорлық жасайды.
Dialogue: 0,0:02:17.95,0:02:21.14,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,0:02:21.14,0:02:24.27,Default,,0,0,0,,Бізді байланыстыратын қолдың суықтығына
Dialogue: 0,0:02:24.27,0:02:27.50,Default,,0,0,0,,Жаңа қанның тырнақтары
Dialogue: 0,0:02:27.50,0:02:31.01,Default,,0,0,0,,Қастарыңды біріктіріп қара
Dialogue: 0,0:02:32.21,0:02:39.04,Default,,0,0,0,,Жұмбақтарға толы аяқталу үшін бір-бірімізді құртайық
Dialogue: 0,0:02:39.04,0:02:42.48,Default,,0,0,0,,Қанаттарым мен аяғым әлі үзілген.
Dialogue: 0,0:02:42.48,0:02:46.08,Default,,0,0,0,,Бос жерде шіріп кеткендей
Dialogue: 0,0:02:46.08,0:02:49.20,Default,,0,0,0,,Басқа мен бар
Dialogue: 0,0:02:49.20,0:02:54.64,Default,,0,0,0,,Мен біреуді қатты жақсы көремін, ол ауырады
Dialogue: 0,0:02:55.54,0:03:01.13,Default,,0,0,0,,Енді қайсысы иллюзия?
Dialogue: 0,0:03:09.82,0:03:11.61,Default,,0,0,0,,Бұл ауыртпайды.
Dialogue: 0,0:03:13.01,0:03:13.83,Default,,0,0,0,,Иә
Dialogue: 0,0:03:14.89,0:03:19.39,Default,,0,0,0,,​​Мен мұнда келген бойда шынымен солай сезіндім.
Dialogue: 0,0:03:20.07,0:03:21.49,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:03:21.64,0:03:25.23,Default,,0,0,0,,Ум, кешіріңіз, әже.
Dialogue: 0,0:03:25.49,0:03:28.24,Default,,0,0,0,,Жоқ, бұл туралы алаңдамаңыз.
Dialogue: 0,0:03:28.25,0:03:29.56,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:03:29.66,0:03:31.74,Default,,0,0,0,,Сол әкеге
Dialogue: 0,0:03:31.90,0:03:33.62,Default,,0,0,0,,Мен саған әлі айтқан жоқпын.
Dialogue: 0,0:03:33.84,0:03:36.80,Default,,0,0,0,,Йосуке-сан, сен қазір Үндістанда немесе бір жерде болуың керек.
Dialogue: 0,0:03:37.29,0:03:38.28,Default,,0,0,0,,Айтсам ба?
Dialogue: 0,0:03:38.47,0:03:40.28,Default,,0,0,0,,Мен сіздің ұялы телефон нөміріңізді білемін.
Dialogue: 0,0:03:40.38,0:03:40.96,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:41.18,0:03:44.34,Default,,0,0,0,,Мен сізге өзім хабарласамын.
Dialogue: 0,0:03:44.76,0:03:47.17,Default,,0,0,0,,Иә, бұл жақсырақ.
Dialogue: 0,0:03:47.18,0:03:48.68,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:03:49.00,0:03:51.69,Default,,0,0,0,,Йосуке-сан да сыпайы адам.
Dialogue: 0,0:03:52.41,0:03:55.77,Default,,0,0,0,,Рицуконың қайтыс болғанына көп уақыт өтті.
Dialogue: 0,0:03:57.43,0:04:00.50,Default,,0,0,0,,Йомияма өзені қаланың ортасынан ағып өтеді.
Dialogue: 0,0:04:01.12,0:04:03.54,Default,,0,0,0,,Одан арғы жерді көрмейсің бе?
Dialogue: 0,0:04:04.45,0:04:07.33,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:04:07.34,0:04:08.08,Default,,0,0,0,,Иә
Dialogue: 0,0:04:08.20,0:04:10.71,Default,,0,0,0,,Бұл Коуичи-кун оқитын орта мектеп.
Dialogue: 0,0:04:11.95,0:04:15.96,Default,,0,0,0,,Рейко-сан да сол орта мектепте көп уақыт бұрын оқыды ма?
Dialogue: 0,0:04:15.97,0:04:18.58,Default,,0,0,0,,Иә, бұл 14 жыл бұрын болды.
Dialogue: 0,0:04:19.40,0:04:20.87,Default,,0,0,0,,Анашым да.
Dialogue: 0,0:04:20.88,0:04:24.08,Default,,0,0,0,,Иә, Рицуко-ни-сан да Йомикитадан болған.
Dialogue: 0,0:04:24.46,0:04:25.41,Default,,0,0,0,,Солтүстік түн
Dialogue: 0,0:04:25.79,0:04:27.80,Default,,0,0,0,,Ямиямакита орта мектебі
Dialogue: 0,0:04:27.96,0:04:28.54,Default,,0,0,0,,О
Dialogue: 0,0:04:29.15,0:04:31.91,Default,,0,0,0,,Жеке және мемлекеттік мектептер арасында айырмашылық бар деп ойлаймын.
Dialogue: 0,0:04:32.12,0:04:33.78,Default,,0,0,0,,Сіз бұл бөлікке үйренесіз.
Dialogue: 0,0:04:34.38,0:04:36.88,Default,,0,0,0,,Менің ойымша, Коуичи-кун тез үйренеді.
Dialogue: 0,0:04:37.25,0:04:38.75,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:04:38.98,0:04:39.69,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:04:40.54,0:04:44.13,Default,,0,0,0,,Ауруханадан шыққанда, Йомикитаға қалай дайындалу керектігін айтамын.
Dialogue: 0,0:04:47.79,0:04:49.87,Default,,0,0,0,,Бұл жолы доктор Кинг пе?
Dialogue: 0,0:04:50.15,0:04:51.27,Default,,0,0,0,,Қорқынышты бала
Dialogue: 0,0:04:55.66,0:04:58.30,Default,,0,0,0,,Олай болса, өзіңе қамқор бол.
Dialogue: 0,0:05:03.27,0:05:07.30,Default,,0,0,0,,Біз Ямиямакита орта мектебінің 3 және 3 сынып оқушыларымыз.
Dialogue: 0,0:05:08.58,0:05:09.28,Default,,0,0,0,,Иә
Dialogue: 0,0:05:09.56,0:05:11.35,Default,,0,0,0,,Менің атым Казами.
Dialogue: 0,0:05:11.47,0:05:12.61,Default,,0,0,0,,Томохико Казами
Dialogue: 0,0:05:13.45,0:05:14.87,Default,,0,0,0,,Бұл Сакураги-сан
Dialogue: 0,0:05:15.31,0:05:18.35,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Юкари Сакурагимін.
Dialogue: 0,0:05:19.04,0:05:19.54,Default,,0,0,0,,Бұл
Dialogue: 0,0:05:19.48,0:05:20.52,Default,,0,0,0,,Изуми Акадава
Dialogue: 0,0:05:24.13,0:05:25.63,Default,,0,0,0,,Бұл бір нәрсе
Dialogue: 0,0:05:26.23,0:05:27.51,Default,,0,0,0,,Түсінемін.
Dialogue: 0,0:05:27.86,0:05:30.34,Default,,0,0,0,,Сакураги-сан екеуміз сынып жетекшіміз.
Dialogue: 0,0:05:30.64,0:05:32.60,Default,,0,0,0,,Акадава мырза қарсы шараларға жауапты.
Dialogue: 0,0:05:33.26,0:05:35.80,Default,,0,0,0,,Мен бүгін 3-топтың өкілі ретінде келдім.
Dialogue: 0,0:05:36.72,0:05:37.91,Default,,0,0,0,,Қарсы шаралар бөлімі
Dialogue: 0,0:05:38.43,0:05:40.09,Default,,0,0,0,,Сіз басқа мектепке ауыстыңыз деп ойлаймын.
Dialogue: 0,0:05:40.13,0:05:43.32,Default,,0,0,0,,Негізі ол дүйсенбіде шығуы керек еді.
Dialogue: 0,0:05:43.39,0:05:45.36,Default,,0,0,0,,Мен сенің кенеттен ауырып қалғаныңды естідім.
Dialogue: 0,0:05:45.87,0:05:50.10,Default,,0,0,0,,Біз онымен кездесуге біздің сыныптың атынан бару туралы сөйлестік.
Dialogue: 0,0:05:50.42,0:05:52.97,Default,,0,0,0,,Бұл барлығынан
Dialogue: 0,0:05:54.60,0:05:57.23,Default,,0,0,0,,Сіз Токиодан көшіп келдіңіз, солай ма?
Dialogue: 0,0:05:57.53,0:05:58.11,Default,,0,0,0,,Иә
Dialogue: 0,0:05:58.70,0:06:00.90,Default,,0,0,0,,Бұл Токиодағы жеке мектеп, солай ма?
Dialogue: 0,0:06:01.27,0:06:02.46,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:03.42,0:06:05.30,Default,,0,0,0,,Кейбір отбасылық жағдайларға байланысты.
Dialogue: 0,0:06:06.36,0:06:10.35,Default,,0,0,0,,Ямиямада бірінші рет тұрып жатырсыз ба?
Dialogue: 0,0:06:10.75,0:06:11.72,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:06:12.35,0:06:15.96,Default,,0,0,0,,Хмм, менің ойымша, сіз бұрын осында тұратынсыз.
Dialogue: 0,0:06:16.64,0:06:18.02,Default,,0,0,0,,Мен мұнда бұрын болғанмын.
Dialogue: 0,0:06:18.49,0:06:19.80,Default,,0,0,0,,Мен ол жерде ешқашан тұрған емеспін.
Dialogue: 0,0:06:19.89,0:06:21.32,Default,,0,0,0,,Ұзақ мерзімді болу үшін
Dialogue: 0,0:06:22.02,0:06:25.16,Default,,0,0,0,,Қазір, мен шынымен есімде жоқ.
Dialogue: 0,0:06:25.54,0:06:28.45,Default,,0,0,0,,Мен әлдеқайда жас кезім ше?
Dialogue: 0,0:06:32.94,0:06:33.60,Default,,0,0,0,,Ууух!
Dialogue: 0,0:06:34.39,0:06:37.53,Default,,0,0,0,,Бірінші семестр басталғаннан бері алған жазбаларымды көшіріп алдым.
Dialogue: 0,0:06:38.09,0:06:38.89,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:40.01,0:06:42.86,Default,,0,0,0,,Мен Алтын аптадан кейін мектепке баратын шығармын деп ойлаймын.
Dialogue: 0,0:06:43.03,0:06:43.65,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:06:46.77,0:06:49.07,Default,,0,0,0,,Сол Сакакибара-кун
Dialogue: 0,0:06:49.20,0:06:49.83,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:06:51.50,0:06:52.42,Default,,0,0,0,,Жақсы
Dialogue: 0,0:06:52.49,0:06:53.58,Default,,0,0,0,,Сакакибара…
Dialogue: 0,0:06:55.10,0:06:56.49,Default,,0,0,0,,Коичи-кун, солай ма?
Dialogue: 0,0:06:57.04,0:06:58.74,Default,,0,0,0,,Сіз мені Коичи-кун деп атай аласыз.
Dialogue: 0,0:06:59.68,0:07:00.25,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:03.14,0:07:04.80,Default,,0,0,0,,Үздіксіз қолдауыңыз үшін рахмет.
Dialogue: 0,0:07:05.51,0:07:06.53,Default,,0,0,0,,Коичи-кун
Dialogue: 0,0:07:08.18,0:07:10.72,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:07:19.47,0:07:20.59,Default,,0,0,0,,Коичи-кун
Dialogue: 0,0:07:21.26,0:07:24.09,Default,,0,0,0,,Мен Йомиямада ешқашан өмір сүрген емеспін.
Dialogue: 0,0:07:25.64,0:07:29.08,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:07:52.03,0:07:52.88,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:22.74,0:08:25.68,Default,,0,0,0,,Сіз Йомикитаның студентісіз.
Dialogue: 0,0:08:30.21,0:08:32.20,Default,,0,0,0,,Екінші жертөле қабатында бірдеңе істеу керек.
Dialogue: 0,0:08:33.70,0:08:34.43,Default,,0,0,0,,Иә
Dialogue: 0,0:08:35.52,0:08:37.33,Default,,0,0,0,,Бірақ екінші жертөле қабаты?
Dialogue: 0,0:08:39.81,0:08:41.36,Default,,0,0,0,,Менің жеткізуім керек нәрсе бар.
Dialogue: 0,0:08:43.89,0:08:44.96,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:08:47.19,0:08:49.80,Default,,0,0,0,,Менің бейшара жартым сонда
Dialogue: 0,0:09:10.72,0:09:11.76,Default,,0,0,0,,Эй, сен
Dialogue: 0,0:09:17.41,0:09:19.67,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:09:31.11,0:09:31.82,Default,,0,0,0,,мамыр
Dialogue: 0,0:09:32.02,0:09:33.53,Default,,0,0,0,,Мэй Мисаки
Dialogue: 0,0:10:03.77,0:10:06.09,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:06.71,0:10:09.04,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:10.75,0:10:11.56,Default,,0,0,0,,Генки
Dialogue: 0,0:10:12.76,0:10:13.57,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:14.92,0:10:15.66,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:19.37,0:10:21.42,Default,,0,0,0,,О, қайырлы таң, қалайсың?
Dialogue: 0,0:10:22.46,0:10:23.28,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:23.33,0:10:25.09,Default,,0,0,0,,Бұл жерде түнгі сағат екі.
Dialogue: 0,0:10:25.12,0:10:26.82,Default,,0,0,0,,Үндістанда күн ыстық.
Dialogue: 0,0:10:27.89,0:10:28.86,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:10:29.19,0:10:31.01,Default,,0,0,0,,Менің ойымша, бұл бүгін мектеп.
Dialogue: 0,0:10:31.03,0:10:33.09,Default,,0,0,0,,Ынталандырған қоңырауыңыз үшін рахмет.
Dialogue: 0,0:10:33.19,0:10:34.40,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,0:10:34.71,0:10:35.66,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:10:35.74,0:10:36.65,Default,,0,0,0,,Ауруханадан шыққаннан кейін...
Dialogue: 0,0:10:38.24,0:10:39.27,Default,,0,0,0,,Сіз мені ести аласыз ба? Коичи
Dialogue: 0,0:10:39.35,0:10:41.95,Default,,0,0,0,,Бір минут күте тұрыңыз, менің ойымша, сигнал нашар.
Dialogue: 0,0:10:45.36,0:10:46.80,Default,,0,0,0,,Мен өзімді жақсы сезінемін.
Dialogue: 0,0:10:47.40,0:10:48.59,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:10:48.73,0:10:51.25,Default,,0,0,0,,Пневмоторакс туралы көп уайымдамаңыз.
Dialogue: 0,0:10:51.50,0:10:53.87,Default,,0,0,0,,Мен де жас кезімде солай істедім.
Dialogue: 0,0:10:54.65,0:10:55.88,Default,,0,0,0,,Мен оны бірінші рет естідім
Dialogue: 0,0:10:55.89,0:10:57.46,Default,,0,0,0,,Мен оны айтуды ұмытып кетіппін.
Dialogue: 0,0:10:57.47,0:11:00.01,Default,,0,0,0,,​​Адамдардың бізді қандас туыс деп айтуын қаламадым.
Dialogue: 0,0:11:01.32,0:11:02.31,Default,,0,0,0,,Қан тегі?
Dialogue: 0,0:11:02.84,0:11:06.03,Default,,0,0,0,,Мен мұны екі рет жасадым, бірақ содан бері менде ешқандай белгілер болған жоқ.
Dialogue: 0,0:11:06.21,0:11:08.18,Default,,0,0,0,,Егер бұл қандас болса, онда бұл соңы.
Dialogue: 0,0:11:08.55,0:11:09.93,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:11:10.08,0:11:12.55,Default,,0,0,0,,Бұл енді қайталанбайды деп ойлаймын.
Dialogue: 0,0:11:12.56,0:11:15.04,Default,,0,0,0,,Иықтарыңызды ауыртпастан бар күшіңізді салыңыз.
Dialogue: 0,0:11:16.08,0:11:17.32,Default,,0,0,0,,Мен оны жеңілдетемін.
Dialogue: 0,0:11:17.89,0:11:19.86,Default,,0,0,0,,Қайын ата мен енеңізге сәлем айтыңыз.
Dialogue: 0,0:11:20.08,0:11:22.20,Default,,0,0,0,,Үндістанда күн ыстық
Dialogue: 0,0:11:28.94,0:11:30.59,Default,,0,0,0,,Қайырлы таң Ре Чан
Dialogue: 0,0:11:31.02,0:11:31.82,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:11:32.65,0:11:34.76,Default,,0,0,0,,Ре-чан сіздің атыңыз, солай ма?
Dialogue: 0,0:11:34.82,0:11:37.33,Default,,0,0,0,,Көңіл көтер, көңіл көтер.
Dialogue: 0,0:11:37.47,0:11:39.14,Default,,0,0,0,,Иә, рахмет.
Dialogue: 0,0:11:46.33,0:11:47.34,Default,,0,0,0,,Келесі
Dialogue: 0,0:11:47.53,0:11:50.14,Default,,0,0,0,,Йомикитада дайындалатын үшінші нәрсе
Dialogue: 0,0:11:50.38,0:11:53.59,Default,,0,0,0,,Әрқашан сынып ережелерін сақтаңыз.
Dialogue: 0,0:11:53.79,0:11:54.36,Default,,0,0,0,,Иә
Dialogue: 0,0:11:54.94,0:11:57.67,Default,,0,0,0,,Менің ойымша, бұл Токиодағы мектептен сәл өзгеше.
Dialogue: 0,0:11:57.85,0:12:01.04,Default,,0,0,0,,Біздің жеке тұлға емес, топ ретінде қалай екеніміз маңызды.
Dialogue: 0,0:12:01.79,0:12:03.61,Default,,0,0,0,,Менің ойымша, бұл дұрыс.
Dialogue: 0,0:12:04.91,0:12:07.48,Default,,0,0,0,,Сонымен, Йомикитада дайындалатын төртінші нәрсе ...
Dialogue: 0,0:12:07.51,0:12:08.50,Default,,0,0,0,,Коичи-чан
Dialogue: 0,0:12:10.57,0:12:12.14,Default,,0,0,0,,Бұл күріш.
Dialogue: 0,0:12:13.06,0:12:15.72,Default,,0,0,0,,Күрішке келгенде, Коичи
Dialogue: 0,0:12:16.98,0:12:18.58,Default,,0,0,0,,Қайырлы таң ата
Dialogue: 0,0:12:19.69,0:12:20.67,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:21.22,0:12:23.96,Default,,0,0,0,,Коуичи әлі ауруханада жатыр ма?
Dialogue: 0,0:12:24.17,0:12:25.76,Default,,0,0,0,,Мен қазірдің өзінде ауруханадан шықтым.
Dialogue: 0,0:12:26.28,0:12:27.48,Default,,0,0,0,,Мектеп бүгін басталады.
Dialogue: 0,0:12:28.31,0:12:30.08,Default,,0,0,0,,О, мектеп?
Dialogue: 0,0:12:30.26,0:12:33.31,Default,,0,0,0,,Коуичи қазірдің өзінде орта мектеп оқушысы ма?
Dialogue: 0,0:12:33.69,0:12:35.23,Default,,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:12:35.45,0:12:37.77,Default,,0,0,0,,Сіздің энергияңыз бәрінен де маңызды.
Dialogue: 0,0:12:38.25,0:12:39.30,Default,,0,0,0,,Мен орта мектептің үшінші курс студентімін.
Dialogue: 0,0:12:39.71,0:12:40.96,Default,,0,0,0,,Келесі жылы орта мектеп
Dialogue: 0,0:12:42.17,0:12:46.99,Default,,0,0,0,,Рицуко да, бұлай болмағанын қалаймын.
Dialogue: 0,0:12:47.69,0:12:49.96,Default,,0,0,0,,Коуичи-чан, бұл тамақ.
Dialogue: 0,0:12:49.97,0:12:50.47,Default,,0,0,0,,Иә
Dialogue: 0,0:12:50.50,0:12:52.29,Default,,0,0,0,,Неліктен Re-chan?
Dialogue: 0,0:12:52.41,0:12:53.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:56.37,0:12:58.91,Default,,0,0,0,,Қалай болғанда да, бәрімен дос болыңыз.
Dialogue: 0,0:12:59.73,0:13:02.15,Default,,0,0,0,,Егер сізде қандай да бір қиындық болса,
Dialogue: 0,0:13:02.58,0:13:04.70,Default,,0,0,0,,Бізбен кеңесіңіз.
Dialogue: 0,0:13:05.11,0:13:09.85,Default,,0,0,0,,Әрине, тіпті менің сынып жетекшісінің орынбасары Миками мырзаға да.
Dialogue: 0,0:13:09.96,0:13:12.16,Default,,0,0,0,,Цуки… Цуки…
Dialogue: 0,0:13:13.02,0:13:14.57,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:13:23.78,0:13:27.13,Default,,0,0,0,,Мен бұл жерге әкемнің жұмысына байланысты келдім.
Dialogue: 0,0:13:27.45,0:13:30.01,Default,,0,0,0,,Мен қазір атам мен әжемнің қолында тұрамын.
Dialogue: 0,0:13:30.52,0:13:33.18,Default,,0,0,0,,Ум, көп рахмет.
Dialogue: 0,0:13:35.97,0:13:40.68,Default,,0,0,0,,3-сыныптың жаңа мүшелері сияқты жақсы араласайық.
Dialogue: 0,0:13:41.35,0:13:44.80,Default,,0,0,0,,Бір-бірімізге көмектесіп, қолымыздан келгеннің бәрін бірге жасайық.
Dialogue: 0,0:13:45.15,0:13:46.78,Default,,0,0,0,,Келесі жылдың наурыз айында
Dialogue: 0,0:13:47.39,0:13:50.77,Default,,0,0,0,,Сондықтан бәріміз бірге жақсы оқуды бітіреміз.
Dialogue: 0,0:13:52.05,0:13:54.91,Default,,0,0,0,,Олай болса, Сакакибара-кун, мына жерге отыр.
Dialogue: 0,0:13:55.28,0:13:55.94,Default,,0,0,0,,Иә
Dialogue: 0,0:14:15.74,0:14:17.46,Default,,0,0,0,,Менің ауруым қазір жақсы ма?
Dialogue: 0,0:14:18.00,0:14:19.74,Default,,0,0,0,,Иә, толығымен
Dialogue: 0,0:14:19.93,0:14:21.82,Default,,0,0,0,,Токио мен мұнда ше?
Dialogue: 0,0:14:22.06,0:14:23.54,Default,,0,0,0,,Бұл соншалықты өзгермейді.
Dialogue: 0,0:14:23.65,0:14:25.77,Default,,0,0,0,,Бірақ, жарайды, Токио.
Dialogue: 0,0:14:26.08,0:14:29.85,Default,,0,0,0,,Ямияма сияқты ауылдық қалалар бұл күндері барған сайын әсерсіз болып барады.
Dialogue: 0,0:14:29.90,0:14:33.04,Default,,0,0,0,,Дұрыс, бұл жерде қызық ештеңе жоқ.
Dialogue: 0,0:14:33.05,0:14:35.19,Default,,0,0,0,,Онда маған ұнамайтын нәрселер бар.
Dialogue: 0,0:14:35.47,0:14:37.63,Default,,0,0,0,,Қала шулы, мен өзімді еркін сезінбеймін.
Dialogue: 0,0:14:37.91,0:14:40.58,Default,,0,0,0,,Егер сіз сонда тұрсаңыз, солай болуы мүмкін.
Dialogue: 0,0:14:40.59,0:14:41.47,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:14:41.85,0:14:43.94,Default,,0,0,0,,Мен Токиода тұрып көргім келеді.
Dialogue: 0,0:14:44.29,0:14:46.92,Default,,0,0,0,,Менің ойымша, бұл жерде әлдеқайда тыныш.
Dialogue: 0,0:14:47.22,0:14:48.34,Default,,0,0,0,,Табиғат өте көп.
Dialogue: 0,0:14:48.90,0:14:51.78,Default,,0,0,0,,Бұл Токиода өмір сүрген адамға ғана тән пікір.
Dialogue: 0,0:14:51.94,0:14:54.16,Default,,0,0,0,,Сіздің әкеңіз университет профессоры екенін естідім.
Dialogue: 0,0:14:54.41,0:14:56.97,Default,,0,0,0,,Сондықтан ол зерттеумен айналысу үшін шетелге барады.
Dialogue: 0,0:14:57.42,0:14:58.73,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,0:14:58.98,0:15:00.21,Default,,0,0,0,,Барлығы біледі
Dialogue: 0,0:15:00.22,0:15:02.18,Default,,0,0,0,,Өйткені Кубодера мырза осылай деді.
Dialogue: 0,0:15:02.26,0:15:04.75,Default,,0,0,0,,Мен көремін. Сондай-ақ менің бұрынғы орта мектебім туралы.
Dialogue: 0,0:15:04.76,0:15:06.63,Default,,0,0,0,,Көпшілік біледі
Dialogue: 0,0:15:06.82,0:15:08.98,Default,,0,0,0,,Мен Миками мырзадан естідім.
Dialogue: 0,0:15:09.11,0:15:10.17,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,0:15:10.34,0:15:13.83,Default,,0,0,0,,Миками мырза менің сыныптағы мұғалімім болса жақсы болар еді.
Dialogue: 0,0:15:14.09,0:15:16.43,Default,,0,0,0,,Ол әдемі және өткір.
Dialogue: 0,0:15:16.77,0:15:18.26,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:15:18.41,0:15:22.69,Default,,0,0,0,,О, Коуичи-чан әдемі ханымдарды ұнатпайды.
Dialogue: 0,0:15:22.70,0:15:23.95,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:15:23.98,0:15:27.29,Default,,0,0,0,,Сонымен, Сакакибара-кунға қандай адам ұнайды?
Dialogue: 0,0:15:27.35,0:15:28.38,Default,,0,0,0,,Маған үзіліс беріңіз.
Dialogue: 0,0:15:28.39,0:15:31.32,Default,,0,0,0,,Айтпақшы, әкеңіз шетелге қайда барады?
Dialogue: 0,0:15:31.33,0:15:32.03,Default,,0,0,0,,Үндістан.
Dialogue: 0,0:15:32.21,0:15:34.12,Default,,0,0,0,,Осы көктемнен бастап шамамен бір жыл
Dialogue: 0,0:15:34.13,0:15:37.50,Default,,0,0,0,,Ей, Үндістан, қайтадан ыстық болатын сияқты.
Dialogue: 0,0:15:37.66,0:15:39.97,Default,,0,0,0,,Мен ыстық заттарды ұнатпаймын, сондықтан бұл мүмкін емес.
Dialogue: 0,0:15:39.99,0:15:44.71,Default,,0,0,0,,Мен өте қуаныштымын. Қанша тырыссаңыз да, зерттеуіңізбен Үндістанға бара алмайсыз.
Dialogue: 0,0:15:44.77,0:15:47.09,Default,,0,0,0,,Эй, мен бара алмаймын.
Dialogue: 0,0:15:51.53,0:15:54.72,Default,,0,0,0,,Не болды? Сізді алаңдататын нәрсе бар ма?
Dialogue: 0,0:15:55.14,0:15:56.21,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:15:57.14,0:16:00.71,Default,,0,0,0,,Айтпақшы, маған қонаққа келген Акадава мырза болды.
Dialogue: 0,0:16:01.18,0:16:02.22,Default,,0,0,0,,Бүгін демалыс күні.
Dialogue: 0,0:16:02.37,0:16:04.93,Default,,0,0,0,,Міне, бүгін демалыс күні сияқты.
Dialogue: 0,0:16:06.26,0:16:10.00,Default,,0,0,0,,Түскі үзіліс кезінде сізге мектепті қысқаша шолуға не жетсін?
Dialogue: 0,0:16:10.18,0:16:11.75,Default,,0,0,0,,Білмесеңіз ыңғайсыз болар еді.
Dialogue: 0,0:16:11.77,0:16:13.31,Default,,0,0,0,,Иә, мұны істейік.
Dialogue: 0,0:16:13.66,0:16:14.32,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:15.26,0:16:16.22,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:16:21.34,0:16:22.36,Default,,0,0,0,,Иә
Dialogue: 0,0:16:34.50,0:16:35.90,Default,,0,0,0,,Сіз жүгіргіңіз келетін сияқтысыз.
Dialogue: 0,0:16:37.13,0:16:39.29,Default,,0,0,0,,Иә, өйткені мен жүгіруді ұнатамын.
Dialogue: 0,0:16:39.56,0:16:40.17,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:40.97,0:16:43.33,Default,,0,0,0,,Сіз бұрын жүгірдіңіз, солай ма?
Dialogue: 0,0:16:43.34,0:16:44.72,Default,,0,0,0,,Иә
Dialogue: 0,0:16:45.97,0:16:49.61,Default,,0,0,0,,Менің ойымша, Такабаяси-кунның жүрегі жақсы емес пе?
Dialogue: 0,0:16:49.87,0:16:51.23,Default,,0,0,0,,Мен туылғаннан бері.
Dialogue: 0,0:16:51.47,0:16:54.65,Default,,0,0,0,,Мен жүгірудің қандай екенін білмеймін
Dialogue: 0,0:16:57.86,0:17:00.12,Default,,0,0,0,,Мен де қолымнан келгенше жүгіргім келеді
Dialogue: 0,0:17:01.57,0:17:04.05,Default,,0,0,0,,Мүмкін бір күні мен мұны істей аламын
Dialogue: 0,0:17:06.84,0:17:08.12,Default,,0,0,0,,Yes, that's right.
Dialogue: 0,0:17:08.67,0:17:09.91,Default,,0,0,0,,Сіз мұны бір күні жасай аласыз, солай ма?
Dialogue: 0,0:17:17.99,0:17:22.25,Default,,0,0,0,,Мен медбике бөлмесінде бір сәт жатайын.
Dialogue: 0,0:17:22.38,0:17:23.03,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:23.03,0:17:24.41,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:17:24.60,0:17:25.89,Default,,0,0,0,,Мен жалғыз бара аламын.
Dialogue: 0,0:17:33.61,0:17:37.53,Default,,0,0,0,,Сакакибара-кун Такабаяши-кун
Dialogue: 0,0:17:38.02,0:17:39.77,Default,,0,0,0,,Ол медбике бөлмесінде демалуға бара жатқанын айтты.
Dialogue: 0,0:17:41.38,0:17:42.25,Default,,0,0,0,,Иә
Dialogue: 0,0:17:46.08,0:17:48.31,Default,,0,0,0,,Мен кеше құлап, аяғымды сындырып алдым.
Dialogue: 0,0:17:49.57,0:17:53.10,Default,,0,0,0,,Дұрыс, дене шынықтыру сабағы екі сабақта бірге өткізілмейді.
Dialogue: 0,0:17:53.59,0:17:55.86,Default,,0,0,0,,Тек үш жиынтық әртүрлі.
Dialogue: 0,0:17:56.24,0:17:59.97,Default,,0,0,0,,1 және 2 топтар, 4 және 5 топтар бірлескен.
Dialogue: 0,0:18:02.60,0:18:06.95,Default,,0,0,0,,Түскі үзілісте сіз Казами-кун мен Тешигахара-кунмен бірге болдыңыз.
Dialogue: 0,0:18:07.60,0:18:08.62,Default,,0,0,0,,Бұл туралы бірдеңе
Dialogue: 0,0:18:09.85,0:18:10.80,Default,,0,0,0,,Мен естідім
Dialogue: 0,0:18:11.27,0:18:13.11,Default,,0,0,0,,Маған мектеп бойынша экскурсия жасалды.
Dialogue: 0,0:18:13.21,0:18:13.97,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:18:16.96,0:18:17.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:19.11,0:18:22.46,Default,,0,0,0,,Егер сіз мұны дұрыс жасамасаңыз, Акадава мырза сізге ұрысады.
Dialogue: 0,0:18:27.27,0:18:28.96,Default,,0,0,0,,Сакураги мырза
Dialogue: 0,0:18:29.02,0:18:29.78,Default,,0,0,0,,Иә
Dialogue: 0,0:18:30.26,0:18:31.25,Default,,0,0,0,,Қараңызшы.
Dialogue: 0,0:18:32.24,0:18:33.01,Default,,0,0,0,,Мисаки-сан
Dialogue: 0,0:18:37.29,0:18:39.25,Default,,0,0,0,,Мей Мисаки есімді қыз
Dialogue: 0,0:18:39.42,0:18:41.62,Default,,0,0,0,,Қараңдаршы, мен сол көзіме көзді таңғыш қойдым.
Dialogue: 0,0:18:45.50,0:18:47.46,Default,,0,0,0,,Түскі үзіліс кезінде де мен сыныпта болған жоқпын.
Dialogue: 0,0:18:59.58,0:19:00.89,Default,,0,0,0,,Сакакибара-кун
Dialogue: 0,0:19:21.14,0:19:23.05,Default,,0,0,0,,Эй, Мисаки-сан
Dialogue: 0,0:19:23.76,0:19:26.32,Default,,0,0,0,,Дене шынықтыру Сіз де экскурсияға қатысасыз, солай емес пе?
Dialogue: 0,0:19:28.47,0:19:30.76,Default,,0,0,0,,Мұнда қалу дұрыс па?
Dialogue: 0,0:19:32.37,0:19:33.18,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:19:34.38,0:19:37.45,Default,,0,0,0,,Оған жақыннан қараудың қажеті жоқ.
Dialogue: 0,0:19:39.74,0:19:42.56,Default,,0,0,0,,Сенің мұндай болғаның дұрыс па?
Dialogue: 0,0:19:44.06,0:19:44.73,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:19:47.09,0:19:48.89,Default,,0,0,0,,Мен сурет салып жаттым.
Dialogue: 0,0:19:54.45,0:19:55.60,Default,,0,0,0,,Мей
Dialogue: 0,0:19:56.20,0:19:57.53,Default,,0,0,0,,Сіз қандай кейіпкерлерді жазасыз?
Dialogue: 0,0:19:58.29,0:20:00.08,Default,,0,0,0,,``naku'' кейіпкері
Dialogue: 0,0:20:00.48,0:20:02.13,Default,,0,0,0,,Резонанстық дыбыс
Dialogue: 0,0:20:02.14,0:20:03.17,Default,,0,0,0,,Айқайдың дыбысы
Dialogue: 0,0:20:03.73,0:20:04.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:05.34,0:20:06.17,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:20:06.54,0:20:09.75,Default,,0,0,0,,Мен сені кеше Йомияма ауруханасында кездестіргенім есімде.
Dialogue: 0,0:20:11.70,0:20:12.97,Default,,0,0,0,,Лифтке отырыңыз
Dialogue: 0,0:20:13.21,0:20:14.93,Default,,0,0,0,,Сіз екінші жертөле қабатына түсесіз.
Dialogue: 0,0:20:17.84,0:20:20.37,Default,,0,0,0,,Бұл болған болуы мүмкін.
Dialogue: 0,0:20:20.42,0:20:22.66,Default,,0,0,0,,Сіз сол кезде екінші жертөле қабатында не істеп жүрдіңіз?
Dialogue: 0,0:20:22.89,0:20:24.53,Default,,0,0,0,,Сіз мұны жеткізу деп айттыңыз.
Dialogue: 0,0:20:24.99,0:20:27.05,Default,,0,0,0,,Менде ақ қуыршаққа ұқсайтын бір нәрсе болды.
Dialogue: 0,0:20:27.06,0:20:27.86,Default,,0,0,0,,Бұл жеткізу
Dialogue: 0,0:20:27.90,0:20:30.32,Default,,0,0,0,,Мен мұндай сұрақтар қоюды жек көремін.
Dialogue: 0,0:20:30.59,0:20:31.60,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:20:32.28,0:20:34.12,Default,,0,0,0,,Мен сені сұрауға мәжбүрлемек емеспін.
Dialogue: 0,0:20:34.29,0:20:35.80,Default,,0,0,0,,Дәл осы
Dialogue: 0,0:20:38.08,0:20:39.24,Default,,0,0,0,,Сол күні
Dialogue: 0,0:20:40.01,0:20:41.75,Default,,0,0,0,,Өйткені қайғылы оқиға болды
Dialogue: 0,0:20:45.96,0:20:48.10,Default,,0,0,0,,Сіз Коичи Сакакибарасыз
Dialogue: 0,0:20:48.62,0:20:49.63,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:20:50.65,0:20:52.81,Default,,0,0,0,,Сыныптағылардың бәрі ештеңе айтпайды.
Dialogue: 0,0:20:54.33,0:20:55.13,Default,,0,0,0,,Не
Dialogue: 0,0:20:56.02,0:20:58.85,Default,,0,0,0,,​​Өйткені сенің есімің маған өлімді еске түсіреді.
Dialogue: 0,0:20:59.95,0:21:01.69,Default,,0,0,0,,Және бұл жай ғана өлім емес.
Dialogue: 0,0:21:03.25,0:21:04.68,Default,,0,0,0,,Мектеп - бұл жағдай
Dialogue: 0,0:21:05.41,0:21:07.39,Default,,0,0,0,,Қатыгез және негізсіз өлім
Dialogue: 0,0:21:08.44,0:21:09.69,Default,,0,0,0,,Бұл мектеп
Dialogue: 0,0:21:10.43,0:21:12.22,Default,,0,0,0,,Олардың ішінде 3 және 3 сыныптар
Dialogue: 0,0:21:12.76,0:21:14.72,Default,,0,0,0,,Мен өлімге жақынмын
Dialogue: 0,0:21:15.97,0:21:19.73,Default,,0,0,0,,Кез келген басқа сыныпқа қарағанда әлдеқайда көп
Dialogue: 0,0:21:19.86,0:21:22.28,Default,,0,0,0,,Өлімге жақын
Dialogue: 0,0:21:23.65,0:21:25.22,Default,,0,0,0,,Сіз ештеңе білмейсіз бе?
Dialogue: 0,0:21:25.72,0:21:27.01,Default,,0,0,0,,Сакакибара-кун
Dialogue: 0,0:21:28.10,0:21:29.72,Default,,0,0,0,,Сіз ештеңе білмейсіз.
Dialogue: 0,0:21:30.72,0:21:32.42,Default,,0,0,0,,Мен ешкімнен естіген жоқпын.
Dialogue: 0,0:21:32.88,0:21:33.70,Default,,0,0,0,,Не
Dialogue: 0,0:21:34.80,0:21:36.49,Default,,0,0,0,,Біз мұны ақырында анықтаймыз.
Dialogue: 0,0:21:38.77,0:21:41.21,Default,,0,0,0,,Менен аулақ болғаныңыз жөн.
Dialogue: 0,0:21:42.20,0:21:45.60,Default,,0,0,0,,Біз қазір сөйлесуді тоқтатуымыз керек.
Dialogue: 0,0:21:46.52,0:21:47.35,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:21:47.85,0:21:49.75,Default,,0,0,0,,Ақырында білетін боласыз.
Dialogue: 0,0:21:50.36,0:21:51.37,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:21:59.65,0:22:04.33,Default,,0,0,0,,Жақында кездескенше Са Ка Ки Бара-кун
Dialogue: 0,0:22:36.08,0:22:39.45,Default,,0,0,0,,Сыныптағылардың бәрімен жақсы тіл табысамын деп ойлайсыз ба?
Dialogue: 0,0:22:39.93,0:22:41.89,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:22:49.60,0:22:51.18,Default,,0,0,0,,Не болды?
Dialogue: 0,0:22:51.28,0:22:52.89,Default,,0,0,0,,Атап айтқанда, кез келген нәрсе
Dialogue: 0,0:23:04.25,0:23:19.30,Default,,0,0,0,,Фильм сияқты өшеді
Dialogue: 0,0:23:22.01,0:23:37.06,Default,,0,0,0,,Тіпті белгілі бір сыйлық ақырында бұлыңғыр болады
Dialogue: 0,0:23:37.08,0:23:46.06,Default,,0,0,0,,Ештеңеге бірге күлдік
Dialogue: 0,0:23:46.06,0:23:55.31,Default,,0,0,0,,Уақыт пен жарық
Dialogue: 0,0:23:55.80,0:24:04.80,Default,,0,0,0,,Байланысты естеліктеріміздің түбінде
Dialogue: 0,0:24:04.80,0:24:23.76,Default,,0,0,0,,Мен әлі де біреудің таба алатынына сенемін.
Dialogue: 0,0:24:25.26,0:24:30.26,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
