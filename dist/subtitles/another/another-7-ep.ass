Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.94,0:00:19.10,Default,,0,0,0,,Түнде қабақтар ашылады
Dialogue: 0,0:00:19.16,0:00:23.17,Default,,0,0,0,,Мен жаман көлеңкеден қорқамын
Dialogue: 0,0:00:26.19,0:00:30.93,Default,,0,0,0,,Қараңғы табыттан
Dialogue: 0,0:00:32.48,0:00:38.99,Default,,0,0,0,,Тастап кеткен қуыршақ сияқты
Dialogue: 0,0:00:39.48,0:00:44.19,Default,,0,0,0,,Денем қызарып, тоңып қалды
Dialogue: 0,0:00:45.68,0:00:52.43,Default,,0,0,0,,Жүрек қараңғыда өседі
Dialogue: 0,0:00:52.75,0:00:56.02,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,0:00:56.02,0:00:59.09,Default,,0,0,0,,Ұстаған қолдарымыздың салқындығы
Dialogue: 0,0:00:59.12,0:01:02.25,Default,,0,0,0,,Жаңа қанның тырнақтары
Dialogue: 0,0:01:02.31,0:01:06.32,Default,,0,0,0,,Қастарыңа қара.
Dialogue: 0,0:01:07.10,0:01:13.79,Default,,0,0,0,,Жұмбақ аяқталу үшін бір-бірімізді құртайық
Dialogue: 0,0:01:13.87,0:01:17.40,Default,,0,0,0,,Қанаттары мен аяқтары жұлынған
Dialogue: 0,0:01:17.46,0:01:20.85,Default,,0,0,0,,Бос жерде шіріп кетуден гөрі
Dialogue: 0,0:01:20.88,0:01:24.13,Default,,0,0,0,,Басқа мен бар
Dialogue: 0,0:01:24.15,0:01:29.23,Default,,0,0,0,,Мен біреуді қатты жақсы көремін, ол ауырады
Dialogue: 0,0:01:30.70,0:01:36.21,Default,,0,0,0,,Енді қайсысы иллюзия?
Dialogue: 0,0:02:53.98,0:02:55.02,Default,,0,0,0,,Барлығы шығады.
Dialogue: 0,0:02:55.09,0:02:55.80,Default,,0,0,0,,Сыртта
Dialogue: 0,0:02:56.99,0:02:58.81,Default,,0,0,0,,Жедел полиция және төтенше жағдайлар қызметі
Dialogue: 0,0:03:04.40,0:03:06.24,Default,,0,0,0,,Ешкім зардап шеккен жоқ.
Dialogue: 0,0:03:07.58,0:03:09.28,Default,,0,0,0,,Сакакибара-кун сен
Dialogue: 0,0:03:09.88,0:03:11.61,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:14.87,0:03:16.87,Default,,0,0,0,,Кеттік, Сакакибара-күн
Dialogue: 0,0:03:18.16,0:03:23.52,Default,,0,0,0,,«Жоғалғандардың» санын екіге жеткізсек те нәтиже бермеген сияқты.
Dialogue: 0,0:03:34.62,0:03:36.19,Default,,0,0,0,,Отыр. О…
Dialogue: 0,0:03:36.93,0:03:38.08,Default,,0,0,0,,Мен шаршадым
Dialogue: 0,0:03:39.69,0:03:43.45,Default,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:03:43.86,0:03:45.32,Default,,0,0,0,,Кубодера мырза
Dialogue: 0,0:03:46.31,0:03:49.77,Default,,0,0,0,,Сіз түсінесіз, солай ма?
Dialogue: 0,0:03:50.31,0:03:53.75,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:04:00.10,0:04:03.57,Default,,0,0,0,,Мен бұған көмектесе алмадым, өйткені мен бұл туралы алаңдадым.
Dialogue: 0,0:04:07.71,0:04:08.69,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:11.03,0:04:12.10,Default,,0,0,0,,Осымен
Dialogue: 0,0:04:12.73,0:04:15.89,Default,,0,0,0,,Полиция мұғалімнің үйін тексеруге кеткен кезде
Dialogue: 0,0:04:16.23,0:04:18.12,Default,,0,0,0,,Маңызды нәрсе болып жатқан сияқты.
Dialogue: 0,0:04:19.07,0:04:20.81,Default,,0,0,0,,Кубодера мырза бойдақ.
Dialogue: 0,0:04:20.99,0:04:23.44,Default,,0,0,0,,Мен әрқашан анаммен бірге тұрдым.
Dialogue: 0,0:04:23.92,0:04:25.78,Default,,0,0,0,,Менің анам қартайған.
Dialogue: 0,0:04:26.19,0:04:30.49,Default,,0,0,0,,Мен ауыр сырқаттан зардап шегіп, ұзақ уақыт төсек тартып жаттым.
Dialogue: 0,0:04:31.53,0:04:33.25,Default,,0,0,0,,Бұл ана.
Dialogue: 0,0:04:33.82,0:04:36.19,Default,,0,0,0,,Ол төсегінде қайтыс болғанға ұқсайды.
Dialogue: 0,0:04:36.73,0:04:38.91,Default,,0,0,0,,Жағдайда бұл кісі өлтіру екені анық.
Dialogue: 0,0:04:39.40,0:04:42.43,Default,,0,0,0,,Мейірбике күтімінің шаршауы: апаттардың үш тобы
Dialogue: 0,0:04:43.87,0:04:46.23,Default,,0,0,0,,Қолайсыз психикалық күйге ұшырады
Dialogue: 0,0:04:46.25,0:04:48.85,Default,,0,0,0,,Мен анама қауіп төндірдім.
Dialogue: 0,0:04:49.50,0:04:51.17,Default,,0,0,0,,Бұл дегенді білдіреді деп ойлаймын
Dialogue: 0,0:04:52.32,0:04:55.33,Default,,0,0,0,,Ол өз шәкірттерінің көзінше өз-өзіне қол жұмсады.
Dialogue: 0,0:04:56.97,0:05:00.24,Default,,0,0,0,,Бұл ақылсыз таңдау туралы не ойлайсыз?
Dialogue: 0,0:05:00.50,0:05:03.01,Default,,0,0,0,,Бұл да «құбылыстың» нәтижесі
Dialogue: 0,0:05:04.31,0:05:07.60,Default,,0,0,0,,Осылайша, әдетте болмайды
Dialogue: 0,0:05:07.66,0:05:09.69,Default,,0,0,0,,Мен өлімге тартылдым.
Dialogue: 0,0:05:11.47,0:05:13.59,Default,,0,0,0,,Бұлай ойлаудың өзі орынды.
Dialogue: 0,0:05:15.59,0:05:17.44,Default,,0,0,0,,Апат ешқашан тоқтамайды
Dialogue: 0,0:05:18.38,0:05:21.08,Default,,0,0,0,,Адамдар өле береді
Dialogue: 0,0:05:22.07,0:05:23.46,Default,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,0:05:23.50,0:05:25.99,Default,,0,0,0,,Сақаки, бұлай күйзелме.
Dialogue: 0,0:05:26.15,0:05:27.82,Default,,0,0,0,,Тіпті өзіңді кінәласаң да
Dialogue: 0,0:05:27.95,0:05:29.70,Default,,0,0,0,,Қазір бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:05:31.23,0:05:33.00,Default,,0,0,0,,Соңғы уақытқа дейін
Dialogue: 0,0:05:33.36,0:05:35.73,Default,,0,0,0,,Менің жүрегім ауырды.
Dialogue: 0,0:05:37.49,0:05:39.78,Default,,0,0,0,,Сіз жағдай туралы бәрін білетін шығарсыз.
Dialogue: 0,0:05:40.06,0:05:41.98,Default,,0,0,0,,Олай болса, түсініңіз.
Dialogue: 0,0:05:42.19,0:05:43.82,Default,,0,0,0,,Мен мұны жақсы түсінемін.
Dialogue: 0,0:05:44.40,0:05:45.32,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:05:46.47,0:05:49.16,Default,,0,0,0,,Мисаки де иығынан жүк түскендей сезінеді.
Dialogue: 0,0:05:50.35,0:05:53.94,Default,,0,0,0,,Алғашында бұл ауыр болған жоқ.
Dialogue: 0,0:05:55.22,0:05:57.25,Default,,0,0,0,,​​Сіз шынымен өзгердіңіз.
Dialogue: 0,0:06:00.22,0:06:01.01,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:06:05.62,0:06:07.45,Default,,0,0,0,,Сіз кенеттен не істеп жатырсыз?
Dialogue: 0,0:06:07.72,0:06:09.57,Default,,0,0,0,,«Көрінбейтін» аяқталды, бірақ
Dialogue: 0,0:06:09.73,0:06:11.63,Default,,0,0,0,,Тек дайын болыңыз.
Dialogue: 0,0:06:12.05,0:06:12.79,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:06:14.72,0:06:16.58,Default,,0,0,0,,«Бұл сіздің кінәңіз.»
Dialogue: 0,0:06:17.37,0:06:18.33,Default,,0,0,0,,Ой
Dialogue: 0,0:06:19.84,0:06:20.95,Default,,0,0,0,,Дейтін дауыс
Dialogue: 0,0:06:21.73,0:06:24.60,Default,,0,0,0,,Бір-біріне жауапкершілік жоқ деп айтуға болмайды.
Dialogue: 0,0:06:25.07,0:06:28.13,Default,,0,0,0,,Мені де «біліксіз» деп сынға алмасқа болмайды.
Dialogue: 0,0:06:28.20,0:06:29.34,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:31.04,0:06:32.54,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:06:37.19,0:06:39.26,Default,,0,0,0,,Мен Коичи-кунды кінәлай алмаймын.
Dialogue: 0,0:06:39.56,0:06:41.03,Default,,0,0,0,,Не қажет болса да.
Dialogue: 0,0:06:41.93,0:06:43.34,Default,,0,0,0,,Біз Мисаны екінші Кира болуы мүмкін деген күдікпен қамауға алдық
Dialogue: 0,0:06:43.60,0:06:47.14,Default,,0,0,0,,Апаттар және қарсы іс-қимыл қызметкерлерінің жұмысы
Dialogue: 0,0:06:48.07,0:06:49.65,Default,,0,0,0,,Алда әлі көп нәрсе бар.
Dialogue: 0,0:06:52.11,0:06:55.61,Default,,0,0,0,,Қызық, кейбіреулер жазғы демалысқа дейін шықпай ма?
Dialogue: 0,0:06:55.75,0:06:57.10,Default,,0,0,0,,Сөзсіз бар.
Dialogue: 0,0:06:57.27,0:07:00.25,Default,,0,0,0,,Кейбір адамдар қаладан қашып кеткен шығар.
Dialogue: 0,0:07:00.43,0:07:01.28,Default,,0,0,0,,Қашу
Dialogue: 0,0:07:01.62,0:07:03.78,Default,,0,0,0,,Иә, жыл сайын бір болатын сияқты.
Dialogue: 0,0:07:04.05,0:07:07.06,Default,,0,0,0,,Жазғы демалыс кезінде Ямияма тауынан қашып жатқан адамдар
Dialogue: 0,0:07:07.23,0:07:09.58,Default,,0,0,0,,Иә, менің ойымша.
Dialogue: 0,0:07:10.11,0:07:13.49,Default,,0,0,0,,Мисаки, сен анық өзгердің.
Dialogue: 0,0:07:13.57,0:07:15.49,Default,,0,0,0,,Кадр мәселесі сияқты сабырлы
Dialogue: 0,0:07:15.60,0:07:16.25,Default,,0,0,0,,Иә
Dialogue: 0,0:07:17.03,0:07:20.97,Default,,0,0,0,,Шын мәнінде, сіз шынымен биылғы «басқа» адамсыз.
Dialogue: 0,0:07:22.13,0:07:25.22,Default,,0,0,0,,Бұл Тешигахара-кунға қатысты болуы мүмкін.
Dialogue: 0,0:07:25.42,0:07:26.42,Default,,0,0,0,,Әй, мен
Dialogue: 0,0:07:26.65,0:07:27.61,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:28.02,0:07:29.38,Default,,0,0,0,,Әзіл емес.
Dialogue: 0,0:07:29.89,0:07:31.07,Default,,0,0,0,,Шынында да күтпеген жағдай
Dialogue: 0,0:07:31.39,0:07:35.46,Default,,0,0,0,,Жоқ, жоқ, жоқ, оның өлгені туралы менде шамалы ой жоқ.
Dialogue: 0,0:07:35.72,0:07:36.70,Default,,0,0,0,,Мен мақтанбаймын, бірақ
Dialogue: 0,0:07:36.72,0:07:39.35,Default,,0,0,0,,Бала кезімде істеген істерім анық есімде.
Dialogue: 0,0:07:58.39,0:07:59.48,Default,,0,0,0,,Сіз жақсы көрінесіз.
Dialogue: 0,0:08:00.72,0:08:01.77,Default,,0,0,0,,«Алдау?» Оны алдау үшін не істемексің?
Dialogue: 0,0:08:02.69,0:08:05.55,Default,,0,0,0,,Аказава мырза мен Чихики мырза туралы бірдеңе.
Dialogue: 0,0:08:05.89,0:08:07.66,Default,,0,0,0,,Өйткені мен қарсы шараларға жауаптымын.
Dialogue: 0,0:08:07.68,0:08:08.93,Default,,0,0,0,,Мен мұнда жиі келемін.
Dialogue: 0,0:08:09.40,0:08:10.93,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,0:08:11.59,0:08:13.26,Default,,0,0,0,,Ол күшті қыз
Dialogue: 0,0:08:13.39,0:08:15.52,Default,,0,0,0,,Оны өзі де біледі.
Dialogue: 0,0:08:16.16,0:08:18.21,Default,,0,0,0,,Менің күресетін ешкімім жоқ.
Dialogue: 0,0:08:20.08,0:08:21.46,Default,,0,0,0,,Мені аяма
Dialogue: 0,0:08:23.63,0:08:27.21,Default,,0,0,0,,Айтпақшы, Миками-сенсей де бүгін осында.
Dialogue: 0,0:08:27.29,0:08:29.46,Default,,0,0,0,,Миками мырза
Dialogue: 0,0:08:30.10,0:08:32.99,Default,,0,0,0,,Ол менің өмір сүргенім туралы да біледі.
Dialogue: 0,0:08:33.23,0:08:35.62,Default,,0,0,0,,Сондықтан мен тағы да кеңесуді жөн көрдім.
Dialogue: 0,0:08:36.06,0:08:37.90,Default,,0,0,0,,Ал сендер
Dialogue: 0,0:08:38.37,0:08:41.90,Default,,0,0,0,,Он бес жыл бұрын мен оның жарты жолда тоқтағанын естідім.
Dialogue: 0,0:08:42.18,0:08:42.99,Default,,0,0,0,,Сонымен
Dialogue: 0,0:08:46.37,0:08:50.49,Default,,0,0,0,,Бұл соңғы 25 жылда жарты жолда тоқтаған жалғыз жыл.
Dialogue: 0,0:08:56.69,0:08:58.25,Default,,0,0,0,,Сол жылдың құрбандары болды
Dialogue: 0,0:08:58.30,0:09:01.72,Default,,0,0,0,,Мен білмеген Рицуко-кунды қоспағанда, жеті адам.
Dialogue: 0,0:09:02.31,0:09:03.92,Default,,0,0,0,,Рицуко-кун қашан?
Dialogue: 0,0:09:04.73,0:09:05.94,Default,,0,0,0,,Бұл шілде.
Dialogue: 0,0:09:06.73,0:09:07.58,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:09:08.16,0:09:10.75,Default,,0,0,0,,Бұл тамыз айында тоқтағанын білдіре ме?
Dialogue: 0,0:09:10.86,0:09:13.69,Default,,0,0,0,,​​Тамыз күнін қараңыз.
Dialogue: 0,0:09:14.76,0:09:16.54,Default,,0,0,0,,9 тамыз
Dialogue: 0,0:09:16.88,0:09:21.54,Default,,0,0,0,,Негізі сол жылғы 3-топ 8 тамыздан бастап оқу-жаттығу жиынын өткізді.
Dialogue: 0,0:09:22.04,0:09:22.94,Default,,0,0,0,,Оқу-жаттығу лагері
Dialogue: 0,0:09:23.53,0:09:26.10,Default,,0,0,0,,Жазғы демалыста бірдеңе болғанына сенімдімін.
Dialogue: 0,0:09:26.24,0:09:28.93,Default,,0,0,0,,Сол жаттығу лагерінде екі адам апатқа ұшырады.
Dialogue: 0,0:09:30.00,0:09:33.28,Default,,0,0,0,,Сол оқу-жаттығу жиынында бірдеңе болды.
Dialogue: 0,0:09:33.46,0:09:35.19,Default,,0,0,0,,Апат тоқтады
Dialogue: 0,0:09:35.42,0:09:39.85,Default,,0,0,0,,Ол бетте «өлгендердің» аты жазылмаған шығар.
Dialogue: 0,0:09:40.91,0:09:45.05,Default,,0,0,0,,Сол жылы кімнің «өлген» екенін растау мүмкін болмады.
Dialogue: 0,0:09:45.23,0:09:47.26,Default,,0,0,0,,Неліктен ол тоқтады?
Dialogue: 0,0:09:47.50,0:09:49.19,Default,,0,0,0,,Сенімсіз
Dialogue: 0,0:09:50.05,0:09:53.70,Default,,0,0,0,,Ол жай ғана оқу-жаттығу жиыны кезінде Ямияма храмына барған сияқты.
Dialogue: 0,0:09:53.99,0:09:54.55,Default,,0,0,0,,Ғибадатхана
Dialogue: 0,0:09:56.31,0:09:57.68,Default,,0,0,0,,Бұл ескі ғибадатхана.
Dialogue: 0,0:09:58.03,0:10:00.47,Default,,0,0,0,,«Ямияма» деп аталатын таудың ортасында орналасқан.
Dialogue: 0,0:10:00.71,0:10:02.95,Default,,0,0,0,,Оқу-жаттығу лагері де сол таудың етегінде.
Dialogue: 0,0:10:03.10,0:10:05.12,Default,,0,0,0,,Олай болса, сол қасиетті жерге барайық.
Dialogue: 0,0:10:05.64,0:10:09.23,Default,,0,0,0,,Әрине, ол осыдан кейін «бір жыл» киелі жерді зиярат етуге барған сияқты.
Dialogue: 0,0:10:10.12,0:10:12.96,Default,,0,0,0,,Алайда ешқандай әсер болмады.
Dialogue: 0,0:10:14.85,0:10:16.70,Default,,0,0,0,,Мағынасы жоқ еді.
Dialogue: 0,0:10:16.91,0:10:18.85,Default,,0,0,0,,Жоқ, мен нақты айта алмаймын.
Dialogue: 0,0:10:19.52,0:10:24.76,Default,,0,0,0,,Бұл тиімді болуы мүмкін, себебі тамыз айының басында көп адам барды.
Dialogue: 0,0:10:25.64,0:10:27.09,Default,,0,0,0,,Сапарға қарамастан
Dialogue: 0,0:10:27.15,0:10:28.76,Default,,0,0,0,,Тағы бір нәрсе болды.
Dialogue: 0,0:10:28.91,0:10:31.36,Default,,0,0,0,,Әрине, бұл мүмкіндікті жоққа шығаруға болмайды.
Dialogue: 0,0:10:31.72,0:10:36.11,Default,,0,0,0,,Шын мәнінде, бұл бүгін профессор Миками келгенде талқылау тақырыбы болды.
Dialogue: 0,0:10:37.72,0:10:39.22,Default,,0,0,0,,Бұл кенеттен болған оқиға, бірақ
Dialogue: 0,0:10:39.55,0:10:44.29,Default,,0,0,0,,8-10 тамыз аралығында екі түн, үш күндік сыныптық оқу-жаттығу жиыны өтеді.
Dialogue: 0,0:10:45.42,0:10:47.94,Default,,0,0,0,,Мұны маңызды оқиға деп есептеңіз.
Dialogue: 0,0:10:48.91,0:10:51.80,Default,,0,0,0,,Қол жетімді адамдар мүмкіндігінше қатысуы керек.
Dialogue: 0,0:10:52.33,0:10:56.73,Default,,0,0,0,,Жақында сізге қосымша ақпарат жіберіледі.
Dialogue: 0,0:10:57.41,0:10:58.24,Default,,0,0,0,,Question
Dialogue: 0,0:11:03.01,0:11:03.87,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:11:16.95,0:11:18.13,Default,,0,0,0,,“Өлілер” кімдер?
Dialogue: 0,0:11:20.56,0:11:21.73,Default,,0,0,0,,“Өлілер” кімдер?
Dialogue: 0,0:11:30.13,0:11:31.86,Default,,0,0,0,,“Өлілер” кімдер?
Dialogue: 0,0:11:43.45,0:11:46.10,Default,,0,0,0,,«Өлі» сізсіз
Dialogue: 0,0:11:47.54,0:11:48.94,Default,,0,0,0,,Бо Боку
Dialogue: 0,0:12:19.65,0:12:20.15,Default,,0,0,0,,Иә
Dialogue: 0,0:12:20.14,0:12:22.46,Default,,0,0,0,,Үндістанда күн күннен-күнге ыстық болып барады.
Dialogue: 0,0:12:22.54,0:12:23.70,Default,,0,0,0,,Жағдайыңыз жақсы ма?
Dialogue: 0,0:12:25.02,0:12:26.23,Default,,0,0,0,,Әділ.
Dialogue: 0,0:12:30.14,0:12:31.62,Default,,0,0,0,,Барлығы жақсы жұмыс істейді.
Dialogue: 0,0:12:34.82,0:12:36.04,Default,,0,0,0,,Әй, әке
Dialogue: 0,0:12:36.88,0:12:39.93,Default,,0,0,0,,Мен сіздің анаңыздың орта мектеп кезіндегі суреттерін көрдім.
Dialogue: 0,0:12:40.50,0:12:41.41,Default,,0,0,0,,Мими-уэ отырған вагонда әйелді мазалаған бір ер адам құлап қалды.
Dialogue: 0,0:12:41.96,0:12:45.61,Default,,0,0,0,,Менің ойымша, ол маған өзінің бітіру альбомын біз құда түскен кезде көрсетті.
Dialogue: 0,0:12:46.51,0:12:47.26,Default,,0,0,0,,Басқа фотосуреттер
Dialogue: 0,0:12:48.12,0:12:52.79,Default,,0,0,0,,Мен орта мектепті бітіру рәсімі күні түсірілген топтық суретті көрдім.
Dialogue: 0,0:12:52.87,0:12:55.34,Default,,0,0,0,,Топтық сурет Неліктен?
Dialogue: 0,0:12:56.00,0:12:58.68,Default,,0,0,0,,Бұл фото сәл оғаш болды.
Dialogue: 0,0:12:59.23,0:13:01.88,Default,,0,0,0,,Ал, елес фотосурет сияқты.
Dialogue: 0,0:13:02.27,0:13:04.83,Default,,0,0,0,,Оны қайдан алдың? Осындай әңгімелер
Dialogue: 0,0:13:05.12,0:13:07.52,Default,,0,0,0,,Айтпақшы, сізде елес фото деген нәрсе жоқ.
Dialogue: 0,0:13:07.56,0:13:09.03,Default,,0,0,0,,Жоқ, бұл
Dialogue: 0,0:13:09.94,0:13:13.96,Default,,0,0,0,,Ойланып қарасам, мен мұндай әңгімені баяғыда естідім.
Dialogue: 0,0:13:14.89,0:13:17.28,Default,,0,0,0,,Кейбір қорқынышты фотосуреттер бар.
Dialogue: 0,0:13:18.15,0:13:19.25,Default,,0,0,0,,Мен бұл фотоны көрдім
Dialogue: 0,0:13:19.76,0:13:24.12,Default,,0,0,0,,Жоқ, мен мұны қаламадым, сондықтан оны ата-анамның үйіне қалдырдым.
Dialogue: 0,0:13:24.60,0:13:25.13,Default,,0,0,0,,Үйде
Dialogue: 0,0:13:26.28,0:13:28.96,Default,,0,0,0,,Эй, Коуичи, сонда бірдеңе болды ма?
Dialogue: 0,0:13:29.51,0:13:32.60,Default,,0,0,0,,А, жоқ, жоқ, сәл қызықсыз.
Dialogue: 0,0:13:33.32,0:13:34.32,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:35.65,0:13:39.03,Default,,0,0,0,,Рицуко шын мәнінде сүйкімді адам болды.
Dialogue: 0,0:13:39.63,0:13:42.71,Default,,0,0,0,,Оған деген сезімім әлі мүлде өзгерген жоқ.
Dialogue: 0,0:13:43.24,0:13:45.34,Default,,0,0,0,,Сонымен, Коичи, сен мен үшінсің.
Dialogue: 0,0:13:45.37,0:13:46.42,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:13:46.47,0:13:47.43,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:13:54.90,0:13:55.64,Default,,0,0,0,,Иноя
Dialogue: 0,0:13:57.07,0:13:59.17,Default,,0,0,0,,Мен бұл дүкеннің қайда екенін білемін, бірақ
Dialogue: 0,0:13:59.78,0:14:00.37,Default,,0,0,0,,Бүгін
Dialogue: 0,0:14:02.28,0:14:03.42,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:04.24,0:14:06.84,Default,,0,0,0,,Мүмкін Нару-чанмен кездесу?
Dialogue: 0,0:14:07.30,0:14:09.05,Default,,0,0,0,,Сонымен, сіз не туралы айтып отырсыз?
Dialogue: 0,0:14:09.34,0:14:11.69,Default,,0,0,0,,Қалай болғанда да, мен сізбен жеке кездесіп, сөйлескім келеді.
Dialogue: 0,0:14:12.16,0:14:13.77,Default,,0,0,0,,Егер бұл кездесу болса, қызыңды да ала кел.
Dialogue: 0,0:14:14.06,0:14:15.70,Default,,0,0,0,,Бұл да таптық мәселе.
Dialogue: 0,0:14:18.79,0:14:19.78,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:14:22.76,0:14:25.07,Default,,0,0,0,,Койчи-кун, мұнда кел.
Dialogue: 0,0:14:26.04,0:14:27.03,Default,,0,0,0,,Акадава мырза
Dialogue: 0,0:14:27.81,0:14:29.64,Default,,0,0,0,,Менің ойымша, сізді Тешигахараға шақырған.
Dialogue: 0,0:14:30.03,0:14:31.02,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:31.81,0:14:32.52,Default,,0,0,0,,Мен отырғанда
Dialogue: 0,0:14:33.76,0:14:34.65,Default,,0,0,0,,Акадава мырза да
Dialogue: 0,0:14:35.06,0:14:38.42,Default,,0,0,0,,Иә, бұл сынып мәселесі.
Dialogue: 0,0:14:38.90,0:14:42.63,Default,,0,0,0,,Әйтпесе, мені мұндай адам шақыруы мүмкін емес.
Dialogue: 0,0:14:45.25,0:14:47.06,Default,,0,0,0,,Мен оның көбін Тешигахарадан естідім.
Dialogue: 0,0:14:47.69,0:14:49.15,Default,,0,0,0,,15 жыл бұрынғы оқиға
Dialogue: 0,0:14:49.55,0:14:53.05,Default,,0,0,0,,Сондай-ақ Коуичидің анасы туралы.
Dialogue: 0,0:14:53.72,0:14:54.41,Default,,0,0,0,,Иә
Dialogue: 0,0:14:55.83,0:14:56.55,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:14:59.96,0:15:01.52,Default,,0,0,0,,Изумидің досы
Dialogue: 0,0:15:01.76,0:15:04.97,Default,,0,0,0,,Иә, бұл менің сыныптасым Коичи Сакакибара.
Dialogue: 0,0:15:05.20,0:15:07.85,Default,,0,0,0,,О, онда сен Юя-кунның досысың.
Dialogue: 0,0:15:08.28,0:15:10.30,Default,,0,0,0,,Кіші інім маған үнемі қамқорлық жасайды.
Dialogue: 0,0:15:11.08,0:15:14.52,Default,,0,0,0,,Мен Чикамын, Юя Мочизукидің әпкесі. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:15:14.74,0:15:16.61,Default,,0,0,0,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:15:16.93,0:15:19.52,Default,,0,0,0,,Мен Юя-куннан көп нәрсені естідім.
Dialogue: 0,0:15:19.98,0:15:20.83,Default,,0,0,0,,Тапсырыстар үшін
Dialogue: 0,0:15:21.03,0:15:23.05,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:15:23.25,0:15:24.50,Default,,0,0,0,,Мен сияқты
Dialogue: 0,0:15:25.41,0:15:28.85,Default,,0,0,0,,О, мен қатты қорықтым.
Dialogue: 0,0:15:31.35,0:15:33.49,Default,,0,0,0,,Акадава мырза, сіз не ішіп жатырсыз?
Dialogue: 0,0:15:34.01,0:15:34.69,Default,,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 0,0:15:35.10,0:15:38.00,Default,,0,0,0,,Менің кофем ащы, сондықтан мен оны іше алмаймын.
Dialogue: 0,0:15:38.40,0:15:40.21,Default,,0,0,0,,Мұндағы кофе шынайы.
Dialogue: 0,0:15:40.75,0:15:43.24,Default,,0,0,0,,Hawaii Kona Extra Fancy
Dialogue: 0,0:15:44.04,0:15:46.81,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, уақытыңызды бөліңіз.
Dialogue: 0,0:15:48.92,0:15:51.45,Default,,0,0,0,,Алданып қалдым деп ойлап, оны ішіңіз.
Dialogue: 0,0:15:58.69,0:16:00.85,Default,,0,0,0,,Ащы, бірақ тәтті
Dialogue: 0,0:16:01.40,0:16:02.64,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:16:06.40,0:16:09.05,Default,,0,0,0,,Коичи-кун Токиоға оралмады.
Dialogue: 0,0:16:10.05,0:16:13.34,Default,,0,0,0,,​​Иә, бұл қашуға ұқсайды.
Dialogue: 0,0:16:16.63,0:16:19.73,Default,,0,0,0,,Мен өзімді «өлі» деп ойлаймын
Dialogue: 0,0:16:20.12,0:16:22.91,Default,,0,0,0,,Сіз туылмаған болуыңыз мүмкін.
Dialogue: 0,0:16:25.16,0:16:29.88,Default,,0,0,0,,Осыдан он бес жыл бұрын анаңыз «апат» салдарынан дүниеден өтті.
Dialogue: 0,0:16:30.44,0:16:33.28,Default,,0,0,0,,Ал сен де туылған жоқсың.
Dialogue: 0,0:16:33.86,0:16:35.65,Default,,0,0,0,,Міне, содан бері 15 жыл өтті.
Dialogue: 0,0:16:35.99,0:16:39.33,Default,,0,0,0,,Сіз ауысу студенті ретінде 3-сыныпқа қайта қабылдандыңыз.
Dialogue: 0,0:16:40.25,0:16:41.10,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:16:41.36,0:16:43.18,Default,,0,0,0,,Мұндай ақымақ әңгіме
Dialogue: 0,0:16:48.29,0:16:49.44,Default,,0,0,0,,Мұны байыппен қабылдамаңыз
Dialogue: 0,0:16:50.76,0:16:52.98,Default,,0,0,0,,Мен бұл мүмкіндікті қарастырғаным рас.
Dialogue: 0,0:16:54.07,0:16:54.63,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:56.62,0:16:57.18,Default,,0,0,0,,Қол алысу
Dialogue: 0,0:17:04.08,0:17:06.47,Default,,0,0,0,,Өйткені мен сені бір жерде кездестірдім.
Dialogue: 0,0:17:07.02,0:17:10.59,Default,,0,0,0,,Жоқ, менің ойымша, мен сенімен бір жерде қол алыстым.
Dialogue: 0,0:17:10.95,0:17:12.55,Default,,0,0,0,,О, солай деп ойлаймын.
Dialogue: 0,0:17:13.04,0:17:15.38,Default,,0,0,0,,Менің ойымда бұл есімде жоқ.
Dialogue: 0,0:17:16.19,0:17:18.56,Default,,0,0,0,,Қолым есімде, денем есімде.
Dialogue: 0,0:17:21.35,0:17:23.93,Default,,0,0,0,,Ойланып қарасақ, біз де ауруханада қол алыстық.
Dialogue: 0,0:17:24.64,0:17:25.88,Default,,0,0,0,,Бұл бірдеңені білдіреді ме?
Dialogue: 0,0:17:26.62,0:17:30.14,Default,,0,0,0,,Өлгендердің қолдары таң қаларлықтай суық деген қауесет бар.
Dialogue: 0,0:17:31.70,0:17:33.55,Default,,0,0,0,,Бірақ бұл өтірік шығар.
Dialogue: 0,0:17:33.94,0:17:36.15,Default,,0,0,0,,Егер сіз оны қарапайым түрде түсінсеңіз
Dialogue: 0,0:17:36.93,0:17:38.42,Default,,0,0,0,,О, қош келдіңіз.
Dialogue: 0,0:17:38.83,0:17:40.01,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:17:42.20,0:17:43.26,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:17:47.44,0:17:48.50,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:48.53,0:17:50.41,Default,,0,0,0,,Мені қатты жек көреді
Dialogue: 0,0:17:50.95,0:17:52.15,Default,,0,0,0,,Маған анық айтқым келеді
Dialogue: 0,0:17:52.88,0:17:54.24,Default,,0,0,0,,Бұл да жаман емес.
Dialogue: 0,0:17:54.42,0:17:56.03,Default,,0,0,0,,Бүгін жақсы.
Dialogue: 0,0:17:58.97,0:17:59.94,Default,,0,0,0,,Әңгіме дегеніміз не?
Dialogue: 0,0:18:00.62,0:18:02.93,Default,,0,0,0,,Мочизуки Сіз сөйлейтін адамсыз.
Dialogue: 0,0:18:03.19,0:18:03.69,Default,,0,0,0,,Иә
Dialogue: 0,0:18:05.61,0:18:09.91,Default,,0,0,0,,Бұл жағдайда сіздің әпкеңіздің де қатысы бар болуы мүмкін.
Dialogue: 0,0:18:10.38,0:18:12.53,Default,,0,0,0,,Бұл менің әпкем
Dialogue: 0,0:18:12.75,0:18:13.93,Default,,0,0,0,,Бұл Чика, солай ма?
Dialogue: 0,0:18:14.34,0:18:19.32,Default,,0,0,0,,Иә, сондықтан мен үндемей тұра алмаймын.
Dialogue: 0,0:18:19.53,0:18:20.65,Default,,0,0,0,,Мен жағдай туралы айттым.
Dialogue: 0,0:18:21.55,0:18:22.78,Default,,0,0,0,,Егжей-тегжейлі
Dialogue: 0,0:18:23.36,0:18:25.99,Default,,0,0,0,,Сіздің әпкеңіз де Йомикитадан.
Dialogue: 0,0:18:26.30,0:18:28.21,Default,,0,0,0,,Менің ойымша, ол 3-сынып туралы қауесеттер туралы білген.
Dialogue: 0,0:18:28.60,0:18:29.74,Default,,0,0,0,,Сол кезде мен өзімді жеңілген адам ретінде өмір сүруді бастадым.
Dialogue: 0,0:18:29.90,0:18:33.16,Default,,0,0,0,,Чика-сан таңқаларлық ақпаратпен шықты.
Dialogue: 0,0:18:38.32,0:18:42.33,Default,,0,0,0,,Кацуми Мацунага - менің үйімнің тұрақты тұтынушысы.
Dialogue: 0,0:18:42.66,0:18:45.05,Default,,0,0,0,,Мен сіздің Йомикитадан екеніңізді білдім.
Dialogue: 0,0:18:45.72,0:18:48.94,Default,,0,0,0,,Мен 3-сыныпта оқитынымды жақында ғана білдім.
Dialogue: 0,0:18:49.77,0:18:52.12,Default,,0,0,0,,Сондықтан мен суға түсіп, бардым.
Dialogue: 0,0:18:52.65,0:18:55.40,Default,,0,0,0,,«Мацунага мырзаның жылы белгілі бір жыл болды ма?»
Dialogue: 0,0:18:55.54,0:18:56.47,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:18:57.59,0:19:01.79,Default,,0,0,0,,Сол жылдың қарғысы менде болды, бұл менің кінәм емес.
Dialogue: 0,0:19:02.39,0:19:03.75,Default,,0,0,0,,Мен барлығына көмектестім.
Dialogue: 0,0:19:05.16,0:19:06.63,Default,,0,0,0,,Мен саған көмектестім.
Dialogue: 0,0:19:06.98,0:19:09.45,Default,,0,0,0,,Сондықтан мен саған айтуым керек деп ойладым.
Dialogue: 0,0:19:09.66,0:19:11.87,Default,,0,0,0,,Мен «солды» қалдырдым
Dialogue: 0,0:19:13.46,0:19:15.39,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:19:16.00,0:19:18.28,Default,,0,0,0,,Ол кісі есімде мүлде жоқ.
Dialogue: 0,0:19:18.68,0:19:21.85,Default,,0,0,0,,Осыдан кейін қанша сұрасам да, олар жай ғана: «Білмеймін» деді.
Dialogue: 0,0:19:22.31,0:19:24.12,Default,,0,0,0,,​​Бұл оқиға сізді қызықтыруы мүмкін.
Dialogue: 0,0:19:24.53,0:19:27.29,Default,,0,0,0,,Мацунага есімді адам «апатты» тоқтатты
Dialogue: 0,0:19:27.87,0:19:30.87,Default,,0,0,0,,Және ізін бір жерде қалдырды
Dialogue: 0,0:19:31.21,0:19:32.43,Default,,0,0,0,,Осымен.
Dialogue: 0,0:19:33.06,0:19:38.24,Default,,0,0,0,,Мацунага деген жігіттен оның не айтатынын сұрауымыз керек деп ойлаймын.
Dialogue: 0,0:19:38.91,0:19:40.89,Default,,0,0,0,,Мацунага деген адам қайда?
Dialogue: 0,0:19:42.01,0:19:43.95,Default,,0,0,0,,Қай жерде тұрсаңыз да.
Dialogue: 0,0:19:44.18,0:19:45.23,Default,,0,0,0,,Секір!!
Dialogue: 0,0:19:46.31,0:19:50.90,Default,,0,0,0,,Коичи-кун, сенің қасыңда Мацунага-санның сыныптастары болған жоқ.
Dialogue: 0,0:19:56.90,0:20:00.13,Default,,0,0,0,,Иә, мен апаңның сыныптасымын.
Dialogue: 0,0:20:00.52,0:20:03.94,Default,,0,0,0,,Мацунаганың қайда екенін білсем
Dialogue: 0,0:20:04.84,0:20:06.22,Default,,0,0,0,,Мисаки де сенімен бірге барады.
Dialogue: 0,0:20:12.47,0:20:15.83,Default,,0,0,0,,Өйткені, сен сол қуыршақтың үлгісісің.
Dialogue: 0,0:20:16.53,0:20:18.17,Default,,0,0,0,,Сіз оның жартысы ғана дедіңіз.
Dialogue: 0,0:20:18.51,0:20:19.45,Default,,0,0,0,,Олар бір-біріне ұқсайды
Dialogue: 0,0:20:20.04,0:20:24.69,Default,,0,0,0,,Бұл бала сол кісіден он екі жыл бұрын дүниеге келген.
Dialogue: 0,0:20:25.08,0:20:26.04,Default,,0,0,0,,Әй, әпке
Dialogue: 0,0:20:26.25,0:20:29.10,Default,,0,0,0,,Бірақ ол дүниеге келгенде бала өліп қалған еді.
Dialogue: 0,0:20:32.98,0:20:38.58,Default,,0,0,0,,Бұл оның тірі қалмаған баласын ойлап отырып жасаған қуыршақ.
Dialogue: 0,0:20:39.15,0:20:42.07,Default,,0,0,0,,Сондықтан мен жарты немесе одан азмын
Dialogue: 0,0:20:44.85,0:20:49.02,Default,,0,0,0,,Негізі ертең шығуым керек.
Dialogue: 0,0:20:49.24,0:20:50.31,Default,,0,0,0,,Е, қайда?
Dialogue: 0,0:20:50.82,0:20:55.17,Default,,0,0,0,,Әкем мен анам үшеуміз виллаға баруымыз керек деді.
Dialogue: 0,0:20:56.01,0:20:58.15,Default,,0,0,0,,Жоқ деп айта алмаймын.
Dialogue: 0,0:20:58.75,0:21:00.00,Default,,0,0,0,,Ямияма қаласының сыртында
Dialogue: 0,0:21:00.54,0:21:01.04,Default,,0,0,0,,Иә
Dialogue: 0,0:21:01.61,0:21:03.07,Default,,0,0,0,,Қаладан қашу
Dialogue: 0,0:21:05.05,0:21:07.29,Default,,0,0,0,,Мен шамамен бір аптадан кейін қайтуды жоспарлап отырмын.
Dialogue: 0,0:21:07.58,0:21:10.25,Default,,0,0,0,,Мен қайта оралып, оқу-жаттығу жиынына баруды жоспарлап отырмын.
Dialogue: 0,0:21:10.49,0:21:11.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:18.21,0:21:22.92,Default,,0,0,0,,Эй, мен ата-анаңның үйінде болуы мүмкін деген топтық фотосуретті таптым.
Dialogue: 0,0:21:23.31,0:21:24.92,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:21:25.35,0:21:27.85,Default,,0,0,0,,Егер сіз оны тапсаңыз, мен сізге фотосуретті көрсетемін.
Dialogue: 0,0:21:28.42,0:21:28.97,Default,,0,0,0,,Иә
Dialogue: 0,0:21:34.86,0:21:36.96,Default,,0,0,0,,Егер бірдеңе болса, осы нөмірге хабарласыңыз
Dialogue: 0,0:21:39.31,0:21:41.44,Default,,0,0,0,,Бұл телефон нөмірі қандай?
Dialogue: 0,0:21:42.41,0:21:43.08,Default,,0,0,0,,Ұялы
Dialogue: 0,0:21:43.22,0:21:43.85,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:21:44.36,0:21:45.04,Default,,0,0,0,,Мисаки
Dialogue: 0,0:21:45.31,0:21:45.81,Default,,0,0,0,,Иә
Dialogue: 0,0:21:46.76,0:21:48.59,Default,,0,0,0,,Сіз бұл жиіркенішті машина дедіңіз де.
Dialogue: 0,0:21:49.08,0:21:50.43,Default,,0,0,0,,Бұл маған ұнамайды.
Dialogue: 0,0:21:50.70,0:21:54.69,Default,,0,0,0,,Тәулігіне 46 сағат радиотолқындар арқылы қосылу жиіркенішті.
Dialogue: 0,0:21:55.41,0:21:56.51,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:21:57.07,0:21:58.36,Default,,0,0,0,,Ол өткізілуде
Dialogue: 0,0:21:58.98,0:22:02.31,Default,,0,0,0,,Кейде бұл адам мазасызданып, оған көмектесе алмайды.
Dialogue: 0,0:22:03.20,0:22:04.08,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:22:06.46,0:22:07.44,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:22:07.66,0:22:09.01,Default,,0,0,0,,Не?
Dialogue: 0,0:22:09.37,0:22:13.18,Default,,0,0,0,,Сіз «өлі» болдыңыз ба деп ойлағаныңызды айттыңыз.
Dialogue: 0,0:22:13.59,0:22:14.22,Default,,0,0,0,,О
Dialogue: 0,0:22:14.58,0:22:16.17,Default,,0,0,0,,Күмәндер шешілді
Dialogue: 0,0:22:16.52,0:22:17.38,Default,,0,0,0,,Иә
Dialogue: 0,0:22:31.47,0:22:32.09,Default,,0,0,0,,Бұл
Dialogue: 0,0:22:32.46,0:22:35.83,Default,,0,0,0,,Осының ішіне жаңа қуыршақ салынатын сияқты.
Dialogue: 0,0:22:50.00,0:22:51.04,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:22:51.92,0:22:53.10,Default,,0,0,0,,«Өлі» емес
Dialogue: 0,0:22:54.53,0:22:57.78,Default,,0,0,0,,Сакакибара-кун «өлі» емес
Dialogue: 0,0:23:04.83,0:23:19.70,Default,,0,0,0,,Фильм сияқты өшеді
Dialogue: 0,0:23:22.57,0:23:37.46,Default,,0,0,0,,Тіпті белгілі бір сыйлық ақырында бұлыңғыр болады
Dialogue: 0,0:23:37.48,0:23:46.46,Default,,0,0,0,,Ештеңеге бірге күлдік
Dialogue: 0,0:23:46.46,0:23:55.71,Default,,0,0,0,,Уақыт пен жарық
Dialogue: 0,0:23:56.20,0:24:05.20,Default,,0,0,0,,Біздің естеліктеріміздің түбіне қосылу
Dialogue: 0,0:24:05.20,0:24:24.16,Default,,0,0,0,,Мен әлі де біреудің таба алатынына сенемін.
Dialogue: 0,0:24:25.66,0:24:30.66,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
