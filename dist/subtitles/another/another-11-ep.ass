Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.06,0:00:09.28,Default,,0,0,0,,Ол кезде мен өлтірдім...
Dialogue: 0,0:00:10.12,0:00:11.86,Default,,0,0,0,,Бұл факт шындық болып қала береді.
Dialogue: 0,0:00:12.59,0:00:16.09,Default,,0,0,0,,Сондықтан мен осы жерде мойындауды жөн көрдім.
Dialogue: 0,0:00:16.96,0:00:19.59,Default,,0,0,0,,Бұл менің күнәмды мойындауым.
Dialogue: 0,0:00:20.63,0:00:22.05,Default,,0,0,0,,Оқу-жаттығу жиынынан екі аптадан кейін
Dialogue: 0,0:00:22.67,0:00:26.74,Default,,0,0,0,,Бұл... сыныпта болғаны ешкімнің есінде жоқ.
Dialogue: 0,0:00:27.91,0:00:29.58,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:00:30.41,0:00:32.85,Default,,0,0,0,,Мен ғана... өліміне қатты араластым.
Dialogue: 0,0:00:33.00,0:00:34.84,Default,,0,0,0,,Ол әлі есімде
Dialogue: 0,0:00:36.07,0:00:39.49,Default,,0,0,0,,Бірақ мен бұл тек уақыт мәселесі сияқты сезінемін.
Dialogue: 0,0:00:40.36,0:00:43.55,Default,,0,0,0,,Сонымен, менің жадым әлі анық
Dialogue: 0,0:00:43.91,0:00:44.94,Default,,0,0,0,,Бұл факт
Dialogue: 0,0:00:45.98,0:00:49.41,Default,,0,0,0,,Мен сізге апатты қалай тоқтатуға болатынын айтқым келді.
Dialogue: 0,0:00:51.00,0:00:51.75,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:00:51.95,0:00:53.52,Default,,0,0,0,,«Өлі» өлсін
Dialogue: 0,0:00:54.47,0:00:56.16,Default,,0,0,0,,«Өлі» өлсін
Dialogue: 0,0:00:57.13,0:01:01.58,Default,,0,0,0,,Бұл басталған апатты тоқтатудың жолы.
Dialogue: 0,0:01:10.91,0:01:14.07,Default,,0,0,0,,Түнде қабақтар ашылады
Dialogue: 0,0:01:14.13,0:01:18.14,Default,,0,0,0,,Мен жаман көлеңкеден қорқамын
Dialogue: 0,0:01:21.16,0:01:25.90,Default,,0,0,0,,Қараңғы табыттан
Dialogue: 0,0:01:27.45,0:01:33.96,Default,,0,0,0,,Құлаған қуыршақ сияқты
Dialogue: 0,0:01:34.45,0:01:39.16,Default,,0,0,0,,Денем қызарып, қатып қалады.
Dialogue: 0,0:01:40.65,0:01:47.40,Default,,0,0,0,,Жүрек қараңғыда өседі
Dialogue: 0,0:01:47.72,0:01:50.99,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,0:01:50.99,0:01:54.06,Default,,0,0,0,,Ұстаған қолдарымыздың салқындығы
Dialogue: 0,0:01:54.09,0:01:57.22,Default,,0,0,0,,Жаңа қанның тырнақтары
Dialogue: 0,0:01:57.28,0:02:01.29,Default,,0,0,0,,Қастарыңа қара.
Dialogue: 0,0:02:02.07,0:02:08.76,Default,,0,0,0,,Жұмбақ аяқталу үшін бір-бірімізді құртайық
Dialogue: 0,0:02:08.84,0:02:12.37,Default,,0,0,0,,Қанаттары мен аяқтары жұлынған
Dialogue: 0,0:02:12.43,0:02:15.82,Default,,0,0,0,,Бос жерде шіріп кетуден гөрі
Dialogue: 0,0:02:15.85,0:02:19.10,Default,,0,0,0,,Басқа мен бар
Dialogue: 0,0:02:19.12,0:02:24.20,Default,,0,0,0,,Мен біреуді қатты жақсы көремін, ол ауырады
Dialogue: 0,0:02:25.67,0:02:31.18,Default,,0,0,0,,Енді қайсысы иллюзия?
Dialogue: 0,0:02:35.24,0:02:36.64,Default,,0,0,0,,Мен бастауыш мектепте оқып жүрген кезім
Dialogue: 0,0:02:36.86,0:02:38.84,Default,,0,0,0,,Дәл сол балаға ұқсайтын бір бала болды.
Dialogue: 0,0:02:39.11,0:02:41.48,Default,,0,0,0,,Бұл қыз Мисаки-сан.
Dialogue: 0,0:02:41.79,0:02:42.47,Default,,0,0,0,,Иә
Dialogue: 0,0:02:43.15,0:02:45.80,Default,,0,0,0,,Мисаки-сан жалғыз бала болуы керек.
Dialogue: 0,0:02:46.46,0:02:48.42,Default,,0,0,0,,Біз ешқашан бір сыныпта болған емеспіз.
Dialogue: 0,0:02:49.04,0:02:50.86,Default,,0,0,0,,Ол «Мисаки» деп аталды.
Dialogue: 0,0:02:52.00,0:02:53.08,Default,,0,0,0,,Бұл күлкілі емес пе?
Dialogue: 0,0:02:53.56,0:02:55.01,Default,,0,0,0,,Мисаки мырзаның мекенжайы
Dialogue: 0,0:02:55.09,0:02:57.52,Default,,0,0,0,,Мен сізбен бір мектепте оқымас едім.
Dialogue: 0,0:02:57.95,0:02:58.99,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:02:59.34,0:03:00.76,Default,,0,0,0,,Сондықтан мен бұл біртүрлі деп ойладым.
Dialogue: 0,0:03:03.86,0:03:06.18,Default,,0,0,0,,Көз жамылғысы сол көзде.
Dialogue: 0,0:03:08.29,0:03:09.56,Default,,0,0,0,,Мен болмады.
Dialogue: 0,0:03:10.53,0:03:14.06,Default,,0,0,0,,Ол төрт жасында сол көзінен айырылды.
Dialogue: 0,0:03:14.70,0:03:16.89,Default,,0,0,0,,Е, онда анау бала.
Dialogue: 0,0:03:40.78,0:03:43.24,Default,,0,0,0,,Ол осы оқу-жаттығу жиынына келе ме?
Dialogue: 0,0:03:48.63,0:03:49.74,Default,,0,0,0,,«Басқа адам» болып табылады
Dialogue: 0,0:03:52.45,0:03:53.29,Default,,0,0,0,,Ол келеді.
Dialogue: 0,0:04:00.80,0:04:01.79,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:04:03.66,0:04:04.60,Default,,0,0,0,,Сакаки
Dialogue: 0,0:04:04.89,0:04:05.49,Default,,0,0,0,,Мен
Dialogue: 0,0:04:05.69,0:04:06.91,Default,,0,0,0,,Мен мұны істеген болармын
Dialogue: 0,0:04:07.27,0:04:08.22,Default,,0,0,0,,Тешигахара
Dialogue: 0,0:04:08.52,0:04:09.36,Default,,0,0,0,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 0,0:04:12.17,0:04:15.01,Default,,0,0,0,,Саған сұрақ қоя аламын ба?
Dialogue: 0,0:04:15.52,0:04:16.79,Default,,0,0,0,,Бұл кенеттен не болды?
Dialogue: 0,0:04:19.04,0:04:21.57,Default,,0,0,0,,Сіз Томохико Казамиді білесіз бе?
Dialogue: 0,0:04:22.17,0:04:22.80,Default,,0,0,0,,болып табылады
Dialogue: 0,0:04:23.42,0:04:25.27,Default,,0,0,0,,Сондықтан мен тыңдап отырмын.
Dialogue: 0,0:04:25.46,0:04:27.25,Default,,0,0,0,,Казами туралы білесіз бе?
Dialogue: 0,0:04:27.46,0:04:28.49,Default,,0,0,0,,Бұл қандай жігіт?
Dialogue: 0,0:04:28.85,0:04:30.20,Default,,0,0,0,,Мен ештеңе білмеймін
Dialogue: 0,0:04:30.48,0:04:33.33,Default,,0,0,0,,Ол сынып президенті және Тешигахарамен туыс болса керек.
Dialogue: 0,0:04:34.06,0:04:34.81,Default,,0,0,0,,Мисаки
Dialogue: 0,0:04:35.43,0:04:37.12,Default,,0,0,0,,Сіз білмеуіңіз мүмкін емес.
Dialogue: 0,0:04:41.74,0:04:44.49,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті
Dialogue: 0,0:04:45.13,0:04:46.40,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:47.22,0:04:49.71,Default,,0,0,0,,​​Мүмкін мен қателескен шығармын.
Dialogue: 0,0:04:50.37,0:04:52.47,Default,,0,0,0,,Не дұрыс емес?
Dialogue: 0,0:04:54.15,0:04:55.88,Default,,0,0,0,,мен мен
Dialogue: 0,0:04:56.61,0:04:59.46,Default,,0,0,0,,Мен оны «басқасы» деп ойладым.
Dialogue: 0,0:05:00.01,0:05:00.93,Default,,0,0,0,,Қазір
Dialogue: 0,0:05:02.58,0:05:04.67,Default,,0,0,0,,Ол сол.
Dialogue: 0,0:05:05.64,0:05:06.75,Default,,0,0,0,,Бұл Казами.
Dialogue: 0,0:05:07.16,0:05:07.96,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:08.26,0:05:09.96,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,0:05:11.22,0:05:12.20,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:05:12.77,0:05:15.14,Default,,0,0,0,,Мұндай өтірікпен не істеуім керек?
Dialogue: 0,0:05:16.20,0:05:18.34,Default,,0,0,0,,Мен оны тергеуге тырыстым.
Dialogue: 0,0:05:18.59,0:05:20.76,Default,,0,0,0,,Соңғы кездері ол біртүрлі әрекет етіп жүр.
Dialogue: 0,0:05:21.16,0:05:24.95,Default,,0,0,0,,Сосын кездесіп жүргенде не істегеніміз есіме түсті.
Dialogue: 0,0:05:25.02,0:05:25.99,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:05:26.45,0:05:29.61,Default,,0,0,0,,Оның айтуынша, ол бастауыш мектептегі оқиғалар туралы көп есіне түсірмейді.
Dialogue: 0,0:05:29.96,0:05:30.70,Default,,0,0,0,,Сонымен
Dialogue: 0,0:05:31.64,0:05:33.96,Default,,0,0,0,,Мен шешім қабылдадым және сұрақ қойдым.
Dialogue: 0,0:05:34.24,0:05:36.82,Default,,0,0,0,,«Сіз шынымен флюгер емессіз, солай ма?»
Dialogue: 0,0:05:37.15,0:05:40.34,Default,,0,0,0,,«Сыныпқа тайып басқан сенсің ғой, солай ма?»
Dialogue: 0,0:05:40.94,0:05:44.44,Default,,0,0,0,,Сосын ол қатты қорқып, үрейленді.
Dialogue: 0,0:05:44.58,0:05:45.93,Default,,0,0,0,,Ақыры ашуланды
Dialogue: 0,0:05:46.57,0:05:47.42,Default,,0,0,0,,Ресми құжаттарды жариялаған екен.
Dialogue: 0,0:05:47.54,0:05:49.97,Default,,0,0,0,,Мен бұл жігіт деп ойладым.
Dialogue: 0,0:05:50.62,0:05:52.22,Default,,0,0,0,,Мен таспада айтқанымдай
Dialogue: 0,0:05:52.28,0:05:53.45,Default,,0,0,0,,Бұл жігіт өлсе
Dialogue: 0,0:05:53.50,0:05:54.86,Default,,0,0,0,,Мен «өлімге» оралған кезде
Dialogue: 0,0:05:54.89,0:05:56.63,Default,,0,0,0,,Осылайша барлығы құтқарылады.
Dialogue: 0,0:05:58.25,0:05:59.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:00.98,0:06:01.85,Default,,0,0,0,,Өлтірілді
Dialogue: 0,0:06:02.63,0:06:03.77,Default,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:06:04.61,0:06:07.39,Default,,0,0,0,,Мен оны өлтіруді мақсат еткенмін.
Dialogue: 0,0:06:08.37,0:06:11.05,Default,,0,0,0,,Бір-бірімізді ұстап, балконға шықтық.
Dialogue: 0,0:06:11.50,0:06:13.18,Default,,0,0,0,,Байқасаңыз, сол жерден
Dialogue: 0,0:06:14.38,0:06:17.21,Default,,0,0,0,,Ол жерге құлап, қозғалмады.
Dialogue: 0,0:06:17.87,0:06:19.60,Default,,0,0,0,,Менің басымнан да қан шығып жатты.
Dialogue: 0,0:06:20.11,0:06:22.41,Default,,0,0,0,,Содан мен қорқып кеттім
Dialogue: 0,0:06:23.58,0:06:24.98,Default,,0,0,0,,Дәлізге секіріңіз
Dialogue: 0,0:06:25.76,0:06:29.43,Default,,0,0,0,,Мен Сакакидің бұл бөлмеге кіргенін бұрын көрдім.
Dialogue: 0,0:06:30.16,0:06:31.45,Default,,0,0,0,,Бұл растау болды ма?
Dialogue: 0,0:06:32.01,0:06:34.30,Default,,0,0,0,,Казами-кун «басқасы» болды ма?
Dialogue: 0,0:06:34.94,0:06:37.95,Default,,0,0,0,,Әй, «басқасы» өлсе
Dialogue: 0,0:06:38.14,0:06:41.89,Default,,0,0,0,,Осыдан кейін бірден ол жоқ болды.
Dialogue: 0,0:06:42.70,0:06:45.68,Default,,0,0,0,,Бірақ сендер Казамиді білесіңдер.
Dialogue: 0,0:06:46.66,0:06:48.32,Default,,0,0,0,,Мен қателестім бе?
Dialogue: 0,0:06:49.42,0:06:51.75,Default,,0,0,0,,Сакаки ше?
Dialogue: 0,0:06:52.61,0:06:55.15,Default,,0,0,0,,Мен қателестім бе? Мүмкін мен өлмеген шығармын.
Dialogue: 0,0:06:56.78,0:06:59.77,Default,,0,0,0,,Егер сіз екі қабатты болсаңыз, міндетті түрде өлмейсіз.
Dialogue: 0,0:07:09.97,0:07:11.69,Default,,0,0,0,,Мен оны бұл жерден көре алмаймын.
Dialogue: 0,0:07:12.81,0:07:14.51,Default,,0,0,0,,Бұл бұтаның сыртында
Dialogue: 0,0:07:15.82,0:07:19.55,Default,,0,0,0,,Алдымен, Казами-кунның тірі екенін тексерейік.
Dialogue: 0,0:08:03.35,0:08:04.99,Default,,0,0,0,,Маедзима-кун, не болды?
Dialogue: 0,0:08:09.42,0:08:10.13,Default,,0,0,0,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:08:13.35,0:08:15.38,Default,,0,0,0,,Артық емес
Dialogue: 0,0:08:15.47,0:08:17.45,Default,,0,0,0,,Мені пышақтады.
Dialogue: 0,0:08:17.67,0:08:20.72,Default,,0,0,0,,Мен асханаға қараған кезде
Dialogue: 0,0:08:21.37,0:08:23.36,Default,,0,0,0,,Немесе әкімші
Dialogue: 0,0:08:23.80,0:08:24.82,Default,,0,0,0,,Әкімші
Dialogue: 0,0:08:49.06,0:08:50.85,Default,,0,0,0,,Маедзима-кун, мен қашуым керек.
Dialogue: 0,0:08:51.45,0:08:53.55,Default,,0,0,0,,Коуичи-кун, сіз шу шығарып жатырсыз.
Dialogue: 0,0:08:53.94,0:08:55.61,Default,,0,0,0,,Сакаки, ​​не болды?
Dialogue: 0,0:08:56.28,0:08:57.11,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:08:57.58,0:08:58.76,Default,,0,0,0,,Бұл Мэдзима-кун.
Dialogue: 0,0:08:59.22,0:09:00.49,Default,,0,0,0,,Мен жарақат алдым.
Dialogue: 0,0:09:00.66,0:09:01.50,Default,,0,0,0,,Шыгандшинаға баратын жолды іздеуге аттанған Зерттеу корпусы,
Dialogue: 0,0:09:01.67,0:09:02.83,Default,,0,0,0,,Мені пышақтап жатыр.
Dialogue: 0,0:09:02.86,0:09:04.66,Default,,0,0,0,,Ал асханада өрт болды.
Dialogue: 0,0:09:05.43,0:09:06.55,Default,,0,0,0,,Өрт
Dialogue: 0,0:09:06.74,0:09:08.77,Default,,0,0,0,,Менеджер іште өлді.
Dialogue: 0,0:09:08.96,0:09:10.04,Default,,0,0,0,,Ол өлтірілуде.
Dialogue: 0,0:09:10.13,0:09:12.04,Default,,0,0,0,,Өртті кінәлі бастаған болуы керек.
Dialogue: 0,0:09:12.25,0:09:13.16,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:09:16.15,0:09:16.89,Default,,0,0,0,,Әлі емес.
Dialogue: 0,0:09:20.06,0:09:21.09,Default,,0,0,0,,Казами-кун
Dialogue: 0,0:09:22.82,0:09:23.94,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:09:27.83,0:09:29.88,Default,,0,0,0,,Такако қазір
Dialogue: 0,0:09:29.94,0:09:30.92,Default,,0,0,0,,Сугиура мырза
Dialogue: 0,0:09:31.21,0:09:33.69,Default,,0,0,0,,Сіз Мэйдзима-кунды қауіпсіз жерге апардыңыз.
Dialogue: 0,0:09:33.74,0:09:34.84,Default,,0,0,0,,119 саны
Dialogue: 0,0:09:35.36,0:09:35.97,Default,,0,0,0,,Иә
Dialogue: 0,0:09:51.18,0:09:52.10,Default,,0,0,0,,Бұл бөлме
Dialogue: 0,0:09:52.71,0:09:55.06,Default,,0,0,0,,Мен және Такаконың бөлмесі
Dialogue: 0,0:10:00.80,0:10:02.71,Default,,0,0,0,,Такако сонда
Dialogue: 0,0:10:04.59,0:10:05.94,Default,,0,0,0,,Такако
Dialogue: 0,0:10:06.38,0:10:07.82,Default,,0,0,0,,Такако қайда орналасқан?
Dialogue: 0,0:10:08.02,0:10:08.73,Default,,0,0,0,,Такако
Dialogue: 0,0:10:12.25,0:10:13.40,Default,,0,0,0,,Сакакибара-кун
Dialogue: 0,0:10:15.06,0:10:15.92,Default,,0,0,0,,Не
Dialogue: 0,0:10:16.93,0:10:19.18,Default,,0,0,0,,Мен Сугиура мырза мен Казами мырзаны көрмедім.
Dialogue: 0,0:10:19.79,0:10:21.04,Default,,0,0,0,,Казами-кун
Dialogue: 0,0:10:21.44,0:10:25.20,Default,,0,0,0,,Біраз уақыт бұрын ол лай басқан бөлмеме кіріп, беті өзгерді.
Dialogue: 0,0:10:25.54,0:10:27.50,Default,,0,0,0,,«Тешигахара біртүрлі»
Dialogue: 0,0:10:28.90,0:10:30.32,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:30.36,0:10:31.68,Default,,0,0,0,,Үлкен шеберлікпен
Dialogue: 0,0:10:32.25,0:10:34.76,Default,,0,0,0,,Сонда бұл таспа туралы ма?
Dialogue: 0,0:10:35.38,0:10:36.27,Default,,0,0,0,,сөйледі
Dialogue: 0,0:10:36.81,0:10:37.51,Default,,0,0,0,,Иә
Dialogue: 0,0:10:41.90,0:10:42.77,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:10:43.91,0:10:44.55,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:10:44.97,0:10:46.72,Default,,0,0,0,,Менде магнитофон жоқ.
Dialogue: 0,0:10:47.05,0:10:48.31,Default,,0,0,0,,Неге?
Dialogue: 0,0:10:48.70,0:10:49.51,Default,,0,0,0,,Сакаки
Dialogue: 0,0:10:50.54,0:10:51.31,Default,,0,0,0,,Казами
Dialogue: 0,0:10:54.27,0:10:55.35,Default,,0,0,0,,Маедзима-кун
Dialogue: 0,0:10:55.74,0:10:58.30,Default,,0,0,0,,Айғайлаған дауысты естігенде сыртқа секіріп кеткен жігітке қалдырдым.
Dialogue: 0,0:10:59.50,0:11:00.27,Default,,0,0,0,,Эй
Dialogue: 0,0:11:01.61,0:11:03.46,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:11:07.35,0:11:09.24,Default,,0,0,0,,Бөлініп Казами-кунды іздейік.
Dialogue: 0,0:11:09.62,0:11:12.18,Default,,0,0,0,,Артқы бөлмені айналып өтіп, барлығына қашуды айт.
Dialogue: 0,0:11:14.80,0:11:16.28,Default,,0,0,0,,Өрт шығып жатыр, жүгір!
Dialogue: 0,0:11:16.71,0:11:18.84,Default,,0,0,0,,О, от
Dialogue: 0,0:11:19.90,0:11:21.57,Default,,0,0,0,,Не? Өлтіруші ме?
Dialogue: 0,0:11:21.81,0:11:23.74,Default,,0,0,0,,Мен осы ғимараттамын.
Dialogue: 0,0:11:24.42,0:11:27.15,Default,,0,0,0,,Оның үстіне асхана өртеніп жатқан сияқты.
Dialogue: 0,0:11:27.58,0:11:29.93,Default,,0,0,0,,Мен Казамидің қайда кеткенін де білмеймін.
Dialogue: 0,0:11:30.09,0:11:31.59,Default,,0,0,0,,Бұл қазірдің өзінде тәртіпсіздік
Dialogue: 0,0:11:33.18,0:11:35.16,Default,,0,0,0,,Мен Миками-сенсейге айтуым керек.
Dialogue: 0,0:11:37.93,0:11:39.90,Default,,0,0,0,,Мұғалім Миками Сенсей
Dialogue: 0,0:11:43.43,0:11:44.57,Default,,0,0,0,,Мен кіремін.
Dialogue: 0,0:11:49.20,0:11:50.40,Default,,0,0,0,,Бұл жақсы емес
Dialogue: 0,0:11:56.62,0:11:58.09,Default,,0,0,0,,Бұл қан, солай емес пе?
Dialogue: 0,0:11:58.41,0:11:59.17,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:11:59.58,0:12:02.21,Default,,0,0,0,,Мүмкін Миками мырзамен бірдеңе болған шығар?
Dialogue: 0,0:12:02.32,0:12:07.54,Default,,0,0,0,,О, білесің бе, сыртқа шығып полиция шақыру керек емес пе?
Dialogue: 0,0:12:07.56,0:12:08.52,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:12:08.84,0:12:11.12,Default,,0,0,0,,Миками мырзаның жақсы екеніне көз жеткізуім керек.
Dialogue: 0,0:12:23.54,0:12:24.52,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:12:49.17,0:12:49.97,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:12:50.40,0:12:51.45,Default,,0,0,0,,Тешигахара
Dialogue: 0,0:12:51.52,0:12:53.22,Default,,0,0,0,,Және Мочизуки-кун.
Dialogue: 0,0:12:53.65,0:12:55.05,Default,,0,0,0,,Бұл төменнен болды, солай ма?
Dialogue: 0,0:12:57.10,0:12:57.98,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:18.44,0:13:19.28,Default,,0,0,0,,болды
Dialogue: 0,0:13:19.61,0:13:20.52,Default,,0,0,0,,Такако
Dialogue: 0,0:13:20.91,0:13:21.99,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:13:23.30,0:13:24.29,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:24.95,0:13:26.90,Default,,0,0,0,,Изуми де өлсе ше?
Dialogue: 0,0:13:27.06,0:13:28.72,Default,,0,0,0,,Мен өмір сүре алмаймын
Dialogue: 0,0:13:31.23,0:13:33.33,Default,,0,0,0,,Изуми менсіз
Dialogue: 0,0:13:33.96,0:13:34.76,Default,,0,0,0,,Такако
Dialogue: 0,0:13:38.23,0:13:40.01,Default,,0,0,0,,«Өлілерді» өлтіріңіз
Dialogue: 0,0:13:47.46,0:13:48.54,Default,,0,0,0,,Бұл
Dialogue: 0,0:13:49.04,0:13:51.03,Default,,0,0,0,,Тешигахара-кун, қашайық
Dialogue: 0,0:13:51.61,0:13:52.48,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:14:05.23,0:14:06.74,Default,,0,0,0,,Өлімге оралу
Dialogue: 0,0:14:06.77,0:14:07.68,Default,,0,0,0,,Тоқта
Dialogue: 0,0:14:11.44,0:14:13.18,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:14:28.38,0:14:30.17,Default,,0,0,0,,«Өлілерді» өлімге қайтару
Dialogue: 0,0:14:30.82,0:14:32.25,Default,,0,0,0,,Неліктен Сугиура мырза?
Dialogue: 0,0:14:33.25,0:14:36.16,Default,,0,0,0,,Бұл қыз таспаны естіді
Dialogue: 0,0:14:37.95,0:14:40.08,Default,,0,0,0,,Сіз оны ескі Санкумиден таптыңыз деп ойлаймын.
Dialogue: 0,0:14:40.89,0:14:42.26,Default,,0,0,0,,Огурадан естіген
Dialogue: 0,0:14:44.45,0:14:47.01,Default,,0,0,0,,Мен апатты тоқтату үшін анықтамалар іздеп келдім.
Dialogue: 0,0:14:47.29,0:14:48.63,Default,,0,0,0,,Е, шындап.
Dialogue: 0,0:14:49.17,0:14:50.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:50.95,0:14:52.14,Default,,0,0,0,,Мұнда таспа
Dialogue: 0,0:14:52.54,0:14:54.87,Default,,0,0,0,,Иә, Мочизуки-кун.
Dialogue: 0,0:14:55.55,0:14:58.76,Default,,0,0,0,,Қарсы шара офицері ретінде сұраудан басқа амалым қалмады.
Dialogue: 0,0:14:59.77,0:15:02.53,Default,,0,0,0,,Бірақ неге Мисаки «өлі» болды?
Dialogue: 0,0:15:03.18,0:15:05.60,Default,,0,0,0,,Такако теңізден қайтып келді
Dialogue: 0,0:15:06.01,0:15:08.57,Default,,0,0,0,,Мен өзімді әбден психикалық бұзылған сезіне бастадым.
Dialogue: 0,0:15:10.68,0:15:12.61,Default,,0,0,0,,Мен Такаконы іздеп жүрмін.
Dialogue: 0,0:15:12.97,0:15:14.85,Default,,0,0,0,,Аказава-сан, жалғыз болу қауіпті.
Dialogue: 0,0:15:15.25,0:15:16.62,Default,,0,0,0,,Қарсы шаралар қызметкерлерінен
Dialogue: 0,0:15:16.78,0:15:19.65,Default,,0,0,0,,3-сыныптың барлық мүшелеріне маңызды ескерту.
Dialogue: 0,0:15:20.55,0:15:22.70,Default,,0,0,0,,Мен сізге айтайын деп отырған таспа
Dialogue: 0,0:15:23.13,0:15:27.96,Default,,0,0,0,,Бұл 15 жыл бұрын апаттың ортасында қалған таспа.
Dialogue: 0,0:15:33.76,0:15:37.42,Default,,0,0,0,,Мен апатты қалай тоқтатуға болатынын айтқым келді.
Dialogue: 0,0:15:38.69,0:15:39.40,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:15:39.97,0:15:41.51,Default,,0,0,0,,«Өлілерді» өлімге қайтарыңыз
Dialogue: 0,0:15:42.58,0:15:44.35,Default,,0,0,0,,«Өлілерді» өлімге қайтарыңыз
Dialogue: 0,0:15:45.34,0:15:49.40,Default,,0,0,0,,Бұл басталған апатты тоқтатудың жолы.
Dialogue: 0,0:15:53.03,0:15:53.84,Default,,0,0,0,,Фактілер
Dialogue: 0,0:15:54.45,0:15:57.26,Default,,0,0,0,,Он бес жыл бұрын апат жарты жолда тоқтады.
Dialogue: 0,0:15:57.91,0:16:00.44,Default,,0,0,0,,Ал биылғы "өлі"
Dialogue: 0,0:16:02.42,0:16:03.60,Default,,0,0,0,,Бұл Мэй Мисаки.
Dialogue: 0,0:16:04.53,0:16:05.35,Default,,0,0,0,,Ойласам, ол бәріне белгілі нәрсе ғой.
Dialogue: 0,0:16:05.62,0:16:07.37,Default,,0,0,0,,Мен бастауыш мектепте оқып жүрген кезім
Dialogue: 0,0:16:07.58,0:16:11.53,Default,,0,0,0,,Сол көзінен айырылмаған Мисаки мырзамен бір мектепте оқыдым.
Dialogue: 0,0:16:12.23,0:16:15.84,Default,,0,0,0,,Бірақ қазір ол сол көзінен айырылды.
Dialogue: 0,0:16:16.66,0:16:18.67,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:19.88,0:16:22.99,Default,,0,0,0,,​​Бұл оның толық емес қайта тірілуіне байланысты.
Dialogue: 0,0:16:23.55,0:16:25.62,Default,,0,0,0,,Қазіргі Мей Мисаки - жалған.
Dialogue: 0,0:16:27.47,0:16:28.34,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:16:31.82,0:16:34.16,Default,,0,0,0,,өлтіру
Dialogue: 0,0:16:34.33,0:16:34.96,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:50.46,0:16:52.45,Default,,0,0,0,,«Өлілерді» өлтіріңіз
Dialogue: 0,0:16:52.83,0:16:54.08,Default,,0,0,0,,Өлімге оралу
Dialogue: 0,0:16:54.91,0:16:55.96,Default,,0,0,0,,«Өлі»
Dialogue: 0,0:16:57.78,0:16:58.72,Default,,0,0,0,,Тоқта
Dialogue: 0,0:17:00.09,0:17:01.05,Default,,0,0,0,,Миками мырза
Dialogue: 0,0:17:02.10,0:17:04.18,Default,,0,0,0,,Сыныптастарыңды өлтіре алмайсың.
Dialogue: 0,0:17:05.12,0:17:06.85,Default,,0,0,0,,«Өлілерді» өлімге қайтарсақ
Dialogue: 0,0:17:07.16,0:17:08.93,Default,,0,0,0,,Ешкім өлмейді.
Dialogue: 0,0:17:09.10,0:17:11.68,Default,,0,0,0,,Мисакиді өлтірсек, апат тоқтайды.
Dialogue: 0,0:17:11.72,0:17:12.40,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:14.01,0:17:15.73,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:17:15.89,0:17:17.78,Default,,0,0,0,,Сонымен, «өлгендер» кімдер?
Dialogue: 0,0:17:19.00,0:17:19.88,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:17:20.61,0:17:21.23,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:23.24,0:17:24.06,Default,,0,0,0,,Бо Бо
Dialogue: 0,0:17:24.11,0:17:27.50,Default,,0,0,0,,Менің өлгім келмейді
Dialogue: 0,0:17:27.98,0:17:28.79,Default,,0,0,0,,No
Dialogue: 0,0:17:44.52,0:17:45.30,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:17:47.65,0:17:48.51,Default,,0,0,0,,Сен
Dialogue: 0,0:18:02.23,0:18:02.73,Default,,0,0,0,,болды
Dialogue: 0,0:18:02.55,0:18:03.25,Default,,0,0,0,,«Өлі»
Dialogue: 0,0:18:04.65,0:18:06.27,Default,,0,0,0,,Менің ағамның жауы
Dialogue: 0,0:18:06.30,0:18:06.89,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:06.98,0:18:07.75,Default,,0,0,0,,Коро
Dialogue: 0,0:18:08.85,0:18:09.55,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:17.34,0:18:18.36,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:18:18.42,0:18:19.16,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:18:22.01,0:18:23.06,Default,,0,0,0,,Қабылдамау
Dialogue: 0,0:18:34.22,0:18:35.90,Default,,0,0,0,,Сақ болыңыз, өйткені тайып кетесіз.
Dialogue: 0,0:18:41.61,0:18:42.26,Default,,0,0,0,,болды
Dialogue: 0,0:18:45.40,0:18:48.22,Default,,0,0,0,,«Өлілерді» өлтіріңіз
Dialogue: 0,0:19:01.11,0:19:02.05,Default,,0,0,0,,Огура
Dialogue: 0,0:19:05.32,0:19:06.52,Default,,0,0,0,,Мен дәлізден шықтым.
Dialogue: 0,0:19:15.11,0:19:16.77,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:25.00,0:19:26.79,Default,,0,0,0,,Төменнен айнала кел.
Dialogue: 0,0:19:29.44,0:19:31.12,Default,,0,0,0,,Бұл шынымен Мисаки-сан ба?
Dialogue: 0,0:19:31.72,0:19:33.88,Default,,0,0,0,,Бұл әйел күдікті.
Dialogue: 0,0:19:33.95,0:19:35.11,Default,,0,0,0,,Иә, бірақ келіңіз.
Dialogue: 0,0:19:39.29,0:19:42.00,Default,,0,0,0,,Бір нәрсенің күйген иісі бар.
Dialogue: 0,0:19:42.20,0:19:44.28,Default,,0,0,0,,Сіз бұл өрт деп айттыңыз.
Dialogue: 0,0:19:45.37,0:19:47.32,Default,,0,0,0,,Мен өртті көре алмаймын
Dialogue: 0,0:19:50.28,0:19:51.24,Default,,0,0,0,,Асхана?
Dialogue: 0,0:19:53.98,0:19:55.59,Default,,0,0,0,,Бұл жерде бәрі жақсы сияқты.
Dialogue: 0,0:20:22.38,0:20:23.59,Default,,0,0,0,,Ол жайғасты.
Dialogue: 0,0:20:23.98,0:20:25.35,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:25.95,0:20:28.46,Default,,0,0,0,,Мүмкін асханада жарылыс болған шығар.
Dialogue: 0,0:20:28.89,0:20:29.62,Default,,0,0,0,,Иә
Dialogue: 0,0:20:31.32,0:20:33.98,Default,,0,0,0,,Маедзима-кун асхананың алдында құлап қалды.
Dialogue: 0,0:20:35.38,0:20:36.84,Default,,0,0,0,,Мүмкін Сугиура мырза
Dialogue: 0,0:20:36.90,0:20:38.11,Default,,0,0,0,,(Бас сарапшы) Жаза тағайындау мен оны орындауды жеделдете алмаймыз ба?
Dialogue: 0,0:20:47.14,0:20:48.72,Default,,0,0,0,,Мүмкін әлгі қарт аң
Dialogue: 0,0:20:49.19,0:20:50.25,Default,,0,0,0,,Әже
Dialogue: 0,0:20:52.10,0:20:53.10,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:20:53.54,0:20:54.53,Default,,0,0,0,,Кедергі
Dialogue: 0,0:20:56.32,0:20:59.11,Default,,0,0,0,,Бірақ ол «өлі» емес, сондықтан мен оны өлтірмеймін.
Dialogue: 0,0:20:59.69,0:21:02.00,Default,,0,0,0,,Бұл Изумидің сүйіктісі.
Dialogue: 0,0:21:11.58,0:21:14.16,Default,,0,0,0,,«Өлілерді» өлтіріңіз
Dialogue: 0,0:21:53.06,0:21:53.94,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:21:55.30,0:21:57.86,Default,,0,0,0,,Бұл неліктен болып жатыр?
Dialogue: 0,0:22:00.27,0:22:01.19,Default,,0,0,0,,Коичи-кун
Dialogue: 0,0:22:03.06,0:22:04.06,Default,,0,0,0,,Акадава мырза
Dialogue: 0,0:22:04.50,0:22:06.65,Default,,0,0,0,,Е, бұл кім?
Dialogue: 0,0:22:10.47,0:22:11.29,Default,,0,0,0,,Такако
Dialogue: 0,0:22:14.14,0:22:17.29,Default,,0,0,0,,Мэй Мисаки
Dialogue: 0,0:22:17.66,0:22:19.73,Default,,0,0,0,,Ақыр соңында, сен
Dialogue: 0,0:22:19.78,0:22:20.39,Default,,0,0,0,,Ол сөзсіз осында—
Dialogue: 0,0:22:20.41,0:22:21.25,Default,,0,0,0,,Акадава мырза
Dialogue: 0,0:22:21.39,0:22:22.47,Default,,0,0,0,,Сугиура мырза
Dialogue: 0,0:22:23.65,0:22:25.31,Default,,0,0,0,,Э? Қайда?
Dialogue: 0,0:22:26.66,0:22:28.48,Default,,0,0,0,,Егер «өлілер» болмаса
Dialogue: 0,0:22:31.04,0:22:32.76,Default,,0,0,0,,Сондай өкінішті нәрсе
Dialogue: 0,0:22:35.24,0:22:36.89,Default,,0,0,0,,Бұл тоқтауы керек, солай ма?
Dialogue: 0,0:22:45.83,0:22:46.76,Default,,0,0,0,,Мисаки
Dialogue: 0,0:22:49.18,0:22:49.80,Default,,0,0,0,,Мисаки
Dialogue: 0,0:22:53.86,0:22:55.83,Default,,0,0,0,,Мисаки
Dialogue: 0,0:23:04.78,0:23:19.65,Default,,0,0,0,,Фильм сияқты өшеді
Dialogue: 0,0:23:22.52,0:23:37.41,Default,,0,0,0,,Тіпті белгілі бір сыйлық ақырында бұлыңғыр болады
Dialogue: 0,0:23:37.43,0:23:46.41,Default,,0,0,0,,Ештеңеге бірге күлдік
Dialogue: 0,0:23:46.41,0:23:55.66,Default,,0,0,0,,Уақыт пен жарық
Dialogue: 0,0:23:56.15,0:24:05.15,Default,,0,0,0,,Байланысты естеліктеріміздің түбінде
Dialogue: 0,0:24:05.15,0:24:24.11,Default,,0,0,0,,Мен әлі де біреудің таба алатынына сенемін.
