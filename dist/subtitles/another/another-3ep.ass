Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.27,Default,,0,0,0,,Сізге көрсетейін бе?
Dialogue: 0,0:00:06.44,0:00:07.05,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:00:08.34,0:00:10.10,Default,,0,0,0,,Саған көрсетейін бе?
Dialogue: 0,0:00:10.76,0:00:13.99,Default,,0,0,0,,Осы көздің астында
Dialogue: 0,0:00:34.80,0:00:38.39,Default,,0,0,0,,Түнді жабу үшін қабақтарыңызды ашыңыз
Dialogue: 0,0:00:38.39,0:00:42.03,Default,,0,0,0,,Күресіп жатқан көлеңкеден қорық.
Dialogue: 0,0:00:45.19,0:00:49.79,Default,,0,0,0,,Қараңғы табыттан
Dialogue: 0,0:00:51.48,0:00:57.85,Default,,0,0,0,,Жаңа туған қуыршақ сияқты
Dialogue: 0,0:00:58.43,0:01:03.05,Default,,0,0,0,,Дене қызарып, қатып қалады.
Dialogue: 0,0:01:04.66,0:01:11.29,Default,,0,0,0,,Менің жүрегім өсіп, қараңғылық қамқорлық жасайды.
Dialogue: 0,0:01:11.66,0:01:15.05,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,0:01:15.08,0:01:18.01,Default,,0,0,0,,Бізді байланыстыратын қолдың салқындығы
Dialogue: 0,0:01:18.06,0:01:21.28,Default,,0,0,0,,Жаңа қанның тырнақтары
Dialogue: 0,0:01:21.28,0:01:25.18,Default,,0,0,0,,Қастарыңды біріктіріп қара
Dialogue: 0,0:01:25.96,0:01:32.65,Default,,0,0,0,,Жұмбақтарға толы аяқталу үшін бір-бірімізді құртайық
Dialogue: 0,0:01:32.73,0:01:36.26,Default,,0,0,0,,Қанаттары да, аяқтары да жұлынған.
Dialogue: 0,0:01:36.32,0:01:39.85,Default,,0,0,0,,Бос жерде шіріп кеткендей
Dialogue: 0,0:01:39.91,0:01:43.21,Default,,0,0,0,,Басқа мен бар
Dialogue: 0,0:01:43.27,0:01:48.09,Default,,0,0,0,,Мен біреуді қатты жақсы көремін, ол ауырады
Dialogue: 0,0:01:49.56,0:01:55.07,Default,,0,0,0,,Енді қайсысы иллюзия?
Dialogue: 0,0:02:09.77,0:02:10.70,Default,,0,0,0,,Жасанды көз
Dialogue: 0,0:02:11.24,0:02:14.25,Default,,0,0,0,,Менің сол көзім – «қуыршақтың көзі»
Dialogue: 0,0:02:15.12,0:02:17.67,Default,,0,0,0,,Өйткені сіз көрудің қажеті жоқ нәрселерді көре аласыз.
Dialogue: 0,0:02:18.15,0:02:19.57,Default,,0,0,0,,Мен оны әдетте жасырамын.
Dialogue: 0,0:02:21.41,0:02:22.69,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін
Dialogue: 0,0:02:25.48,0:02:28.99,Default,,0,0,0,,Егер сіз үйренбеген болсаңыз, бұл жер жақсы болмауы мүмкін.
Dialogue: 0,0:02:29.47,0:02:30.47,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:02:32.27,0:02:33.49,Default,,0,0,0,,Қуыршақтар
Dialogue: 0,0:02:38.75,0:02:41.09,Default,,0,0,0,,Қуыршақ қуыс.
Dialogue: 0,0:02:43.03,0:02:45.74,Default,,0,0,0,,Менің денем мен ойым өте бос
Dialogue: 0,0:02:46.95,0:02:49.96,Default,,0,0,0,,Өлімге апаратын бостық.
Dialogue: 0,0:02:50.59,0:02:54.62,Default,,0,0,0,,Қуыс заттар оны бір нәрсемен толтырғысы келеді
Dialogue: 0,0:02:55.56,0:02:59.37,Default,,0,0,0,,Мен осында болғанда, мені сорып жатқандай сезінбеймін.
Dialogue: 0,0:02:59.43,0:03:00.93,Default,,0,0,0,,Өз ішімнен
Dialogue: 0,0:03:04.10,0:03:05.06,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:03:05.85,0:03:08.20,Default,,0,0,0,,Өйткені мұндағыдан жоғарыда жақсырақ
Dialogue: 0,0:03:10.11,0:03:12.30,Default,,0,0,0,,Үй осында ма?
Dialogue: 0,0:03:13.00,0:03:13.62,Default,,0,0,0,,Иә
Dialogue: 0,0:03:15.23,0:03:18.58,Default,,0,0,0,,«Түннің ымыртында»
Dialogue: 0,0:03:18.83,0:03:20.85,Default,,0,0,0,,Осы дүкеннің атауы
Dialogue: 0,0:03:23.52,0:03:25.24,Default,,0,0,0,,“Кобо м” – бұл
Dialogue: 0,0:03:26.15,0:03:27.54,Default,,0,0,0,,Кириканың шеберханасы
Dialogue: 0,0:03:27.94,0:03:29.01,Default,,0,0,0,,Мұнда екінші қабат
Dialogue: 0,0:03:29.52,0:03:30.34,Default,,0,0,0,,Кирика
Dialogue: 0,0:03:31.37,0:03:34.93,Default,,0,0,0,,Жоғарыдағы шеберханада қуыршақ жасайтын адам
Dialogue: 0,0:03:37.56,0:03:38.91,Default,,0,0,0,,Жертөледе де қуыршақтар
Dialogue: 0,0:03:40.32,0:03:43.78,Default,,0,0,0,,Кириканың барлық шығармалары шығар
Dialogue: 0,0:03:48.04,0:03:49.74,Default,,0,0,0,,Бұл не қуыршақ?
Dialogue: 0,0:03:50.41,0:03:53.18,Default,,0,0,0,,Неліктен ол сізге қатты ұқсайды?
Dialogue: 0,0:03:54.34,0:03:55.06,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:03:56.27,0:04:01.22,Default,,0,0,0,,Біз алғаш кездескен кезде сізде болған қуыршақ да болатын.
Dialogue: 0,0:04:01.50,0:04:02.21,Default,,0,0,0,,Иә
Dialogue: 0,0:04:03.33,0:04:07.95,Default,,0,0,0,,Сол күні ауруханада қайтыс болған бір қыз бар деп естідім.
Dialogue: 0,0:04:08.91,0:04:10.36,Default,,0,0,0,,Балаға
Dialogue: 0,0:04:12.96,0:04:14.43,Default,,0,0,0,,Ум, мм
Dialogue: 0,0:04:15.27,0:04:18.45,Default,,0,0,0,,Қайтыс болған бала: «Мисаки» немесе «Масаки»?
Dialogue: 0,0:04:18.64,0:04:20.20,Default,,0,0,0,,Бұл атау
Dialogue: 0,0:04:21.25,0:04:25.49,Default,,0,0,0,,Мисаки-сан, сенің әпкең немесе қарындасың бар ма?
Dialogue: 0,0:04:30.48,0:04:35.90,Default,,0,0,0,,Ол жалғыз қызы болғандықтан ата-анасы қатты күйзеліп, қиналған.
Dialogue: 0,0:04:40.36,0:04:41.53,Default,,0,0,0,,Неге сен
Dialogue: 0,0:04:42.27,0:04:44.41,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:45.55,0:04:48.62,Default,,0,0,0,,Басқа тұтынушылар жоқ.
Dialogue: 0,0:04:54.33,0:04:57.39,Default,,0,0,0,,Менен сұрағыңыз келетін басқа да нәрселер бар деп ойлаймын.
Dialogue: 0,0:04:59.17,0:04:59.94,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:02.20,0:05:04.86,Default,,0,0,0,,Біртүрлі сезінетін көптеген нәрселер бар.
Dialogue: 0,0:05:05.65,0:05:06.50,Default,,0,0,0,,Бұл
Dialogue: 0,0:05:07.39,0:05:09.98,Default,,0,0,0,,Мен сізге алыс болғаныңыз жақсы дедім.
Dialogue: 0,0:05:11.73,0:05:13.62,Default,,0,0,0,,Бірақ тым кеш болуы мүмкін
Dialogue: 0,0:05:13.92,0:05:14.55,Default,,0,0,0,,баяу
Dialogue: 0,0:05:15.38,0:05:18.08,Default,,0,0,0,,Сен ештеңе білмейсің, Сакакибара-күн.
Dialogue: 0,0:05:21.14,0:05:22.91,Default,,0,0,0,,Ескі әңгіме бар ма?
Dialogue: 0,0:05:23.98,0:05:27.10,Default,,0,0,0,,3, 3, 26 жыл бұрынғы сыныптың оқиғасы
Dialogue: 0,0:05:28.94,0:05:30.94,Default,,0,0,0,,Сіз ешкімнен естіген жоқсыз, солай ма?
Dialogue: 0,0:05:37.36,0:05:39.01,Default,,0,0,0,,Бір студент болды.
Dialogue: 0,0:05:40.10,0:05:42.21,Default,,0,0,0,,Мен оқи аламын және жаттығу жасай аламын.
Dialogue: 0,0:05:42.67,0:05:44.41,Default,,0,0,0,,Барлығына мейірімді бол
Dialogue: 0,0:05:45.25,0:05:48.34,Default,,0,0,0,,Ол мұғалімдерге де, студенттерге де өте ұнады.
Dialogue: 0,0:05:49.75,0:05:52.99,Default,,0,0,0,,Алайда үшінші курсқа кіргеннен кейін көп ұзамай
Dialogue: 0,0:05:53.06,0:05:54.94,Default,,0,0,0,,Бала қайтыс болды.
Dialogue: 0,0:05:55.57,0:05:56.33,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:57.41,0:06:01.29,Default,,0,0,0,,Менің отбасым мінген ұшақтың құлағанын естідім.
Dialogue: 0,0:06:01.55,0:06:03.39,Default,,0,0,0,,Басқа да көптеген теориялар бар.
Dialogue: 0,0:06:04.26,0:06:06.11,Default,,0,0,0,,Бұл көлік апаты болды.
Dialogue: 0,0:06:06.52,0:06:08.40,Default,,0,0,0,,Үйде өрт болды.
Dialogue: 0,0:06:09.53,0:06:13.79,Default,,0,0,0,,Сондықтан сыныптағылардың бәрі шошып кетті.
Dialogue: 0,0:06:14.94,0:06:18.48,Default,,0,0,0,,Барлығы өте қатты қайғырды.
Dialogue: 0,0:06:18.96,0:06:22.04,Default,,0,0,0,,Осының ортасында кенет біреу бірдеңе деді.
Dialogue: 0,0:06:22.74,0:06:25.05,Default,,0,0,0,,Ол өлген жоқ
Dialogue: 0,0:06:25.74,0:06:28.38,Default,,0,0,0,,Бала пайдаланып жатқан үстелді көрсетіңіз.
Dialogue: 0,0:06:28.63,0:06:30.62,Default,,0,0,0,,Қараңызшы, ол сонда.
Dialogue: 0,0:06:31.82,0:06:34.37,Default,,0,0,0,,Мен сенің сонда тірі және жақсы болатыныңа сенімдімін.
Dialogue: 0,0:06:37.41,0:06:41.64,Default,,0,0,0,,Сосын кейбір балалар дәл осылай айта бастады.
Dialogue: 0,0:06:42.50,0:06:45.53,Default,,0,0,0,,Бұл рас, ол өлген жоқ.
Dialogue: 0,0:06:47.01,0:06:50.87,Default,,0,0,0,,Ол тізбекті реакция сияқты сыныпқа тарады.
Dialogue: 0,0:06:51.62,0:06:53.61,Default,,0,0,0,,Оған ешкім сенгісі келмеді.
Dialogue: 0,0:06:54.18,0:06:56.10,Default,,0,0,0,,Сіз оны қабылдағыңыз келмеді.
Dialogue: 0,0:06:56.39,0:06:58.04,Default,,0,0,0,,Қатал шындық
Dialogue: 0,0:06:58.98,0:07:01.36,Default,,0,0,0,,Сенің сезіміңді білмеймін.
Dialogue: 0,0:07:03.34,0:07:06.63,Default,,0,0,0,,Өйткені, сыныптағылардың бәрі
Dialogue: 0,0:07:06.87,0:07:10.22,Default,,0,0,0,,Бала өзін тірідей етіп көрсете берді.
Dialogue: 0,0:07:10.55,0:07:12.75,Default,,0,0,0,,Сынып жетекшісімен ынтымақтасыңыз.
Dialogue: 0,0:07:13.45,0:07:15.59,Default,,0,0,0,,Ол жігіттің тірі екені сөзсіз.
Dialogue: 0,0:07:15.98,0:07:19.31,Default,,0,0,0,,Ендеше бәріміз бірге тынбай еңбек етуді жалғастырайық.
Dialogue: 0,0:07:19.71,0:07:22.84,Default,,0,0,0,,Бітіру күнін бәріміз бірге тойлайық.
Dialogue: 0,0:07:23.54,0:07:26.34,Default,,0,0,0,,Мектеп бітіру рәсімінде директор ұйымдастырды
Dialogue: 0,0:07:26.63,0:07:29.60,Default,,0,0,0,,Бала үшін орын дайындалуы мүмкін.
Dialogue: 0,0:07:29.90,0:07:32.00,Default,,0,0,0,,​​Эй, бұл шынайы оқиға.
Dialogue: 0,0:07:32.28,0:07:37.53,Default,,0,0,0,,Сонымен, мектеп бітіру рәсімінен кейін сыныпта естелік суретке түстік.
Dialogue: 0,0:07:37.85,0:07:40.02,Default,,0,0,0,,Бүкіл сыныппен және мұғаліммен
Dialogue: 0,0:07:40.74,0:07:45.02,Default,,0,0,0,,Дегенмен, барлығы дайын фотоны көргенде, олар мұны түсінді
Dialogue: 0,0:07:45.47,0:07:47.01,Default,,0,0,0,,Фотосуреттің бұрышында
Dialogue: 0,0:07:47.05,0:07:50.04,Default,,0,0,0,,Ол жерде болмауы тиіс баланың суреті болды.
Dialogue: 0,0:07:50.34,0:07:52.62,Default,,0,0,0,,Өлген адамдай бозарған жүзімен
Dialogue: 0,0:07:52.98,0:07:55.00,Default,,0,0,0,,Басқалар сияқты күліңіз
Dialogue: 0,0:07:55.92,0:07:59.40,Default,,0,0,0,,Сол бала, анау өлген студент.
Dialogue: 0,0:08:01.85,0:08:04.21,Default,,0,0,0,,Оның аты «Мисаки» болды
Dialogue: 0,0:08:10.03,0:08:11.43,Default,,0,0,0,,Бұл әңгімеде
Dialogue: 0,0:08:12.49,0:08:14.19,Default,,0,0,0,,Алда тағы бар ма?
Dialogue: 0,0:08:20.24,0:08:20.98,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:25.65,0:08:27.64,Default,,0,0,0,,Кешіріңіз, әже
Dialogue: 0,0:08:28.87,0:08:30.25,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:08:32.15,0:08:33.70,Default,,0,0,0,,Мен аздап айналма жолмен жүрдім.
Dialogue: 0,0:08:34.41,0:08:35.60,Default,,0,0,0,,Мен қазір үйге бара жатырмын
Dialogue: 0,0:08:42.95,0:08:44.20,Default,,0,0,0,,Жиренішті машина
Dialogue: 0,0:08:45.00,0:08:47.70,Default,,0,0,0,,Қай жерде болсаңыз да, байланысып, ұстайсыз.
Dialogue: 0,0:08:49.96,0:08:51.73,Default,,0,0,0,,Жабу уақыты келді.
Dialogue: 0,0:08:52.46,0:08:54.60,Default,,0,0,0,,Бүгін үйге қайтыңыз.
Dialogue: 0,0:09:07.96,0:09:10.77,Default,,0,0,0,,Емтиханнан кейін мен кәсіптік бағдар аламын ба?
Dialogue: 0,0:09:10.90,0:09:16.16,Default,,0,0,0,,Ұстазыңызбен бұлай сөйлесудің өзі өте жиіркенішті.
Dialogue: 0,0:09:16.32,0:09:20.47,Default,,0,0,0,,Орта мектепке түсу деңгейі қазір 95%-дан асады.
Dialogue: 0,0:09:20.71,0:09:24.18,Default,,0,0,0,,Ештеңе емес, сіз де оқуға болатын орта мектеп бар.
Dialogue: 0,0:09:24.51,0:09:26.12,Default,,0,0,0,,Сіз мені жігерлендіріп жатырсыз ба?
Dialogue: 0,0:09:26.66,0:09:28.05,Default,,0,0,0,,Бұл менің ниетім.
Dialogue: 0,0:09:29.11,0:09:30.82,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:09:33.80,0:09:34.66,Default,,0,0,0,,Нишитака
Dialogue: 0,0:09:36.27,0:09:38.56,Default,,0,0,0,,Сіздің бағаларыңыз жақсы болды ма?
Dialogue: 0,0:09:39.13,0:09:40.73,Default,,0,0,0,,Мен бар күшімді салудамын.
Dialogue: 0,0:09:45.04,0:09:46.49,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:09:48.67,0:09:52.25,Default,,0,0,0,,Қалай жүрсем де, оқу бітіргенше сенімен арам-қатынасым бұзылады.
Dialogue: 0,0:09:52.34,0:09:53.84,Default,,0,0,0,,Шебер сияқты өмір сүр
Dialogue: 0,0:09:54.03,0:09:55.22,Default,,0,0,0,,Шірік
Dialogue: 0,0:09:55.57,0:09:58.47,Default,,0,0,0,,Менің ойымша, бұл бастауыш мектептің екінші жылы болды.
Dialogue: 0,0:09:59.38,0:10:00.75,Default,,0,0,0,,Менің үйім де жақын жерде.
Dialogue: 0,0:10:01.01,0:10:04.20,Default,,0,0,0,,Бала кезімде мен жай ғана араласып, ақымақ істермен айналыстым.
Dialogue: 0,0:10:04.30,0:10:08.55,Default,,0,0,0,,Бұл импровизация жасай алмайтын осындай құрметті студентке айналды.
Dialogue: 0,0:10:08.70,0:10:10.01,Default,,0,0,0,,Менің көзқарасым бойынша
Dialogue: 0,0:10:10.13,0:10:12.50,Default,,0,0,0,,Сіз өзгермеген сияқтысыз.
Dialogue: 0,0:10:12.61,0:10:14.89,Default,,0,0,0,,Мен де қатты өзгердім.
Dialogue: 0,0:10:15.41,0:10:17.02,Default,,0,0,0,,Мен туралы не білесіз?
Dialogue: 0,0:10:19.12,0:10:22.75,Default,,0,0,0,,Мен сен туралы сен білмейтін бір нәрсені білемін
Dialogue: 0,0:10:23.98,0:10:25.41,Default,,0,0,0,,Сіз не білесіз?
Dialogue: 0,0:10:26.90,0:10:29.19,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:10:31.67,0:10:32.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:33.79,0:10:36.35,Default,,0,0,0,,Сонымен Сакаки орта мектепте не істеп жүр?
Dialogue: 0,0:10:36.80,0:10:38.18,Default,,0,0,0,,Токиоға қайтып барасыз ба?
Dialogue: 0,0:10:39.35,0:10:42.10,Default,,0,0,0,,Менің әкем келесі көктемде Жапонияға оралады.
Dialogue: 0,0:10:42.24,0:10:43.64,Default,,0,0,0,,Сол жеке мектепте
Dialogue: 0,0:10:43.78,0:10:44.70,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:10:45.16,0:10:46.79,Default,,0,0,0,,Сізде бұл қол болды ма?
Dialogue: 0,0:10:47.38,0:10:49.07,Default,,0,0,0,,Бұл не қол?
Dialogue: 0,0:10:49.48,0:10:52.31,Default,,0,0,0,,Мен Токиодағы жеке мектепке де баруым мүмкін.
Dialogue: 0,0:10:52.92,0:10:55.15,Default,,0,0,0,,Коичи-кун қай мектепте оқиды?
Dialogue: 0,0:10:55.31,0:10:57.84,Default,,0,0,0,,Е, бұл К орта мектебі.
Dialogue: 0,0:10:58.33,0:10:59.43,Default,,0,0,0,,K жоғары?
Dialogue: 0,0:11:00.46,0:11:02.46,Default,,0,0,0,,Аказава-сан, сен Токиоға барасың ба?
Dialogue: 0,0:11:02.74,0:11:05.01,Default,,0,0,0,,Мен Токиода жалғыз тұрамын деп ойлаймын.
Dialogue: 0,0:11:10.99,0:11:14.40,Default,,0,0,0,,Сейшін барлық қыздарға арналған орта мектепте оқитын жоқ па еді?
Dialogue: 0,0:11:14.71,0:11:17.76,Default,,0,0,0,,Мен барғым келетіні туралы бірдеңе айтқаным есімде жоқ.
Dialogue: 0,0:11:18.85,0:11:21.14,Default,,0,0,0,,Сіз де бекер жұмыс істеп жатырсыз.
Dialogue: 0,0:11:48.42,0:11:49.69,Default,,0,0,0,,Сакакибара-кун
Dialogue: 0,0:11:52.21,0:11:55.17,Default,,0,0,0,,Қолшатыр әкелген жоқсың ба?
Dialogue: 0,0:11:58.45,0:12:00.68,Default,,0,0,0,,Мен бұл жақсы болады деп ойладым.
Dialogue: 0,0:12:03.00,0:12:03.65,Default,,0,0,0,,Бұл
Dialogue: 0,0:12:04.70,0:12:07.30,Default,,0,0,0,,Олай болса, неге менімен үйге бармайсың?
Dialogue: 0,0:12:08.27,0:12:12.80,Default,,0,0,0,,Менің үйім Сакакибара-кунның үйінің қарсысында.
Dialogue: 0,0:12:14.34,0:12:17.39,Default,,0,0,0,,Бірақ бұл өте жаман.
Dialogue: 0,0:12:23.61,0:12:25.52,Default,,0,0,0,,Ұстамаңыз Ұстамаңыз
Dialogue: 0,0:12:25.67,0:12:27.07,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:12:34.08,0:12:35.23,Default,,0,0,0,,Ойланып қарасаңшы.
Dialogue: 0,0:12:35.52,0:12:37.35,Default,,0,0,0,,Мектеп сапарында не болады?
Dialogue: 0,0:12:37.61,0:12:39.96,Default,,0,0,0,,Мен Токиоға өткен жылы бардым.
Dialogue: 0,0:12:40.13,0:12:44.04,Default,,0,0,0,,Мен үлкен ойын-сауық саябағына барып, Токио мұнарасына шықтым.
Dialogue: 0,0:12:44.52,0:12:45.87,Default,,0,0,0,,Бұл көңілді болды.
Dialogue: 0,0:12:45.93,0:12:47.74,Default,,0,0,0,,А, мен Токиоға бардым.
Dialogue: 0,0:12:47.89,0:12:51.68,Default,,0,0,0,,Токио Көптеген қызықты нәрселер бар, солай емес пе?
Dialogue: 0,0:12:52.04,0:12:54.62,Default,,0,0,0,,Мен де Токиода оқығым келеді.
Dialogue: 0,0:12:55.02,0:12:55.83,Default,,0,0,0,,Егер
Dialogue: 0,0:12:57.97,0:12:59.77,Default,,0,0,0,,Бұл біз үшін мүмкін емес
Dialogue: 0,0:13:03.84,0:13:07.66,Default,,0,0,0,,Менің айтайын дегенім, мектеп саяхаттары үшінші жыл сайын болатын нәрсе емес пе?
Dialogue: 0,0:13:08.09,0:13:11.88,Default,,0,0,0,,Йомикита екінші жылдың күзінде шешілетін сияқты.
Dialogue: 0,0:13:12.01,0:13:15.25,Default,,0,0,0,,Мен ол жерге үшінші курстың көктемінде баратынмын деп ойлаймын.
Dialogue: 0,0:13:16.02,0:13:16.95,Default,,0,0,0,,Өткенде
Dialogue: 0,0:13:17.89,0:13:18.71,Default,,0,0,0,,Иә
Dialogue: 0,0:13:19.42,0:13:21.69,Default,,0,0,0,,Мен сағат қанша екенін білмеймін.
Dialogue: 0,0:13:28.12,0:13:29.99,Default,,0,0,0,,Мен жаңбырды жек көрмеймін
Dialogue: 0,0:13:31.33,0:13:32.84,Default,,0,0,0,,Бұл Сакурай мырза
Dialogue: 0,0:13:33.61,0:13:36.70,Default,,0,0,0,,Мисаки-сан қандай қыз?
Dialogue: 0,0:13:43.53,0:13:44.71,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:13:45.69,0:13:46.58,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:13:52.05,0:13:54.43,Default,,0,0,0,,3-сыныпта бұлай айту жақсы емес.
Dialogue: 0,0:14:00.77,0:14:01.87,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:05.26,0:14:05.79,Default,,0,0,0,,Арамызда
Dialogue: 0,0:14:05.84,0:14:08.48,Default,,0,0,0,,А, жаңбыр күшейіп бара жатқан сияқты.
Dialogue: 0,0:14:10.31,0:14:14.87,Default,,0,0,0,,Мен 26 жыл бұрынғы 3/3 сынып туралы оқиғаны білемін.
Dialogue: 0,0:14:18.91,0:14:23.15,Default,,0,0,0,,Сіз мұндай әңгімеге сендіңіз бе?
Dialogue: 0,0:14:24.77,0:14:25.63,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:27.07,0:14:28.94,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:14:29.62,0:14:32.36,Default,,0,0,0,,Әйтеуір бұл қауесет
Dialogue: 0,0:14:35.09,0:14:36.35,Default,,0,0,0,,Сіз қаншалықты тыңдадыңыз?
Dialogue: 0,0:14:36.65,0:14:39.05,Default,,0,0,0,,Танымал нәрселер кенеттен өлді
Dialogue: 0,0:14:39.29,0:14:44.83,Default,,0,0,0,,Ал өлген бала бітіру кешіндегі суретте болды.
Dialogue: 0,0:14:45.74,0:14:46.71,Default,,0,0,0,,Бұл туралы
Dialogue: 0,0:14:47.54,0:14:50.95,Default,,0,0,0,,Бұл тек бірінші жыл ба?
Dialogue: 0,0:14:55.10,0:14:59.27,Default,,0,0,0,,Не болды? Үшеулерің байсалды көріндіңдер.
Dialogue: 0,0:14:59.73,0:15:04.28,Default,,0,0,0,,Сакакибара-кун басталған жыл туралы айтады.
Dialogue: 0,0:15:04.44,0:15:07.26,Default,,0,0,0,,Қайта Чан Қайырлы таң Қайта Чан
Dialogue: 0,0:15:07.80,0:15:09.51,Default,,0,0,0,,Иә иә Қайырлы таң
Dialogue: 0,0:15:10.69,0:15:13.43,Default,,0,0,0,,Иә, қиын мәселе
Dialogue: 0,0:15:14.01,0:15:15.67,Default,,0,0,0,,Мүмкіндігінше тыныш
Dialogue: 0,0:15:16.17,0:15:18.66,Default,,0,0,0,,Өйткені, қазір уақыт.
Dialogue: 0,0:15:18.88,0:15:20.39,Default,,0,0,0,,Қалай болғанда да, оның қалай өтетінін көрейік.
Dialogue: 0,0:15:26.49,0:15:28.56,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:15:33.45,0:15:34.63,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:15:38.93,0:15:42.59,Default,,0,0,0,,Келесі аптада емтихан жоқ па?
Dialogue: 0,0:15:43.02,0:15:45.39,Default,,0,0,0,,Бұл оңай жеңіс сияқты.
Dialogue: 0,0:15:45.47,0:15:46.89,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:15:47.20,0:15:50.20,Default,,0,0,0,,Мен әлі де қажетінше оқып жатырмын.
Dialogue: 0,0:15:50.36,0:15:52.58,Default,,0,0,0,,Бұл үшін кешіріңіз.
Dialogue: 0,0:15:57.93,0:15:59.68,Default,,0,0,0,,Мен бүгін шаршадым.
Dialogue: 0,0:16:00.99,0:16:02.42,Default,,0,0,0,,Сол Рейко-сан
Dialogue: 0,0:16:03.30,0:16:07.82,Default,,0,0,0,,Анаңыз орта мектептің үшінші курсында оқып жүргенде қай сыныпта оқығаны есіңізде ме?
Dialogue: 0,0:16:11.37,0:16:12.30,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:16:16.19,0:16:20.05,Default,,0,0,0,,Сонымен 26 жыл бұрынғы 3-сынып туралы не деуге болады?
Dialogue: 0,0:16:23.51,0:16:25.23,Default,,0,0,0,,Рейко
Dialogue: 0,0:16:27.29,0:16:31.88,Default,,0,0,0,,Бұл 26 жыл бұрынғы 3-сыныптың оқиғасы.
Dialogue: 0,0:16:35.10,0:16:38.30,Default,,0,0,0,,Бұл ертеден бері айтылып келе жатқан әңгіме.
Dialogue: 0,0:16:38.32,0:16:41.82,Default,,0,0,0,,Сол әңгіменің жалғасы бар деп естідім.
Dialogue: 0,0:16:42.25,0:16:45.69,Default,,0,0,0,,Сен соншалықты көп білмейсің, Койчи-кун.
Dialogue: 0,0:16:47.97,0:16:50.70,Default,,0,0,0,,Білесің бе, Рейко-сан.
Dialogue: 0,0:16:51.99,0:16:55.99,Default,,0,0,0,,Себебі оның әртүрлі құйрық қанаттары бар.
Dialogue: 0,0:16:58.55,0:17:02.41,Default,,0,0,0,,Менің ойымша, Коуичи-кун бұл туралы көп уайымдамауы керек.
Dialogue: 0,0:17:03.54,0:17:07.54,Default,,0,0,0,,Заттар туралы білудің уақыты бар.
Dialogue: 0,0:17:09.80,0:17:12.58,Default,,0,0,0,,Рицуко-сан 3-сыныпта оқиды.
Dialogue: 0,0:17:17.71,0:17:21.71,Default,,0,0,0,,Неге, Ре-чан, неге?
Dialogue: 0,0:17:37.73,0:17:38.62,Default,,0,0,0,,Біраз
Dialogue: 0,0:17:52.46,0:17:53.13,Default,,0,0,0,,Иә
Dialogue: 0,0:17:53.42,0:17:54.78,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:17:55.31,0:17:56.45,Default,,0,0,0,,Бұл кенеттен не болды?
Dialogue: 0,0:17:56.48,0:17:58.69,Default,,0,0,0,,Мен мұны қауіпті деп ойлап, жүгірдім.
Dialogue: 0,0:17:59.08,0:18:01.94,Default,,0,0,0,,Акадаваның жігіті кез келген сәтте жарылып кететін сияқты.
Dialogue: 0,0:18:02.62,0:18:04.18,Default,,0,0,0,,Неліктен Акадава мырза?
Dialogue: 0,0:18:05.19,0:18:06.31,Default,,0,0,0,,Тыңда, Сакаки.
Dialogue: 0,0:18:06.45,0:18:08.45,Default,,0,0,0,,Онда жоқ адаммен араласпа
Dialogue: 0,0:18:09.55,0:18:11.67,Default,,0,0,0,,Не айтып тұрсың өзі?
Dialogue: 0,0:18:11.69,0:18:13.03,Default,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:18:13.43,0:18:16.56,Default,,0,0,0,,Сондай-ақ, менің кеше айтқаным жиырма алты жыл бұрын болды.
Dialogue: 0,0:18:16.98,0:18:19.31,Default,,0,0,0,,Жарайды, келесі айда айтамын.
Dialogue: 0,0:18:19.65,0:18:22.50,Default,,0,0,0,,Сонымен, осы айдың қалған бөлігі үшін
Dialogue: 0,0:18:32.69,0:18:37.21,Default,,0,0,0,,Бұл өткен күні палатада қайтыс болған қыз туралы.
Dialogue: 0,0:18:38.34,0:18:39.78,Default,,0,0,0,,Мен бір нәрсені түсіндім
Dialogue: 0,0:18:39.99,0:18:42.28,Default,,0,0,0,,Менің ойымша, оның есімі Мисаки болды.
Dialogue: 0,0:18:42.66,0:18:44.75,Default,,0,0,0,,Масаки емес, Мисаки
Dialogue: 0,0:18:45.53,0:18:48.10,Default,,0,0,0,,«Саки» — болашақтың «унында» гүлдейтін гүл
Dialogue: 0,0:18:48.50,0:18:50.63,Default,,0,0,0,,Мен оның фамилиясын Фудзиока деп естідім.
Dialogue: 0,0:18:51.19,0:18:53.55,Default,,0,0,0,,Мисаки Фудзиока
Dialogue: 0,0:18:55.46,0:18:58.31,Default,,0,0,0,,Неліктен ол бала туралы білгіңіз келді?
Dialogue: 0,0:18:58.72,0:19:00.69,Default,,0,0,0,,Бұл
Dialogue: 0,0:19:00.71,0:19:02.64,Default,,0,0,0,,Бұл дәл қазір болмауы керек.
Dialogue: 0,0:19:03.00,0:19:04.62,Default,,0,0,0,,Бірақ ақыр соңында
Dialogue: 0,0:19:05.04,0:19:05.62,Default,,0,0,0,,Иә
Dialogue: 0,0:19:05.76,0:19:08.14,Default,,0,0,0,,Ал енді емтихан алдында.
Dialogue: 0,0:19:08.56,0:19:09.56,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:19:09.74,0:19:12.26,Default,,0,0,0,,Менің інім де жақсы оқиды.
Dialogue: 0,0:19:12.69,0:19:13.55,Default,,0,0,0,,іні
Dialogue: 0,0:19:13.71,0:19:14.89,Default,,0,0,0,,Бізбен бірге болыңыз.
Dialogue: 0,0:19:15.13,0:19:19.05,Default,,0,0,0,,Бұл жігіттердің бәрі қазір бұлшықет ақымақтары.
Dialogue: 0,0:19:19.12,0:19:20.91,Default,,0,0,0,,Оқуға мүлдем қызықпайды
Dialogue: 0,0:19:21.04,0:19:23.54,Default,,0,0,0,,Менің ойымша, ол ешқашан мангадан басқа ештеңе оқымаған.
Dialogue: 0,0:19:23.63,0:19:25.33,Default,,0,0,0,,Мәселелер болады.
Dialogue: 0,0:19:49.86,0:19:51.81,Default,,0,0,0,,Әр жолы жылдам.
Dialogue: 0,0:19:52.38,0:19:53.11,Default,,0,0,0,,Иә
Dialogue: 0,0:19:59.23,0:20:01.88,Default,,0,0,0,,Мен кеше және бүгін жолда болдым.
Dialogue: 0,0:20:02.59,0:20:03.57,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:20:04.30,0:20:06.71,Default,,0,0,0,,Жақсы, мен.
Dialogue: 0,0:20:10.60,0:20:15.65,Default,,0,0,0,,Сол күні қайтыс болған қыз Мисаки Фудзиока болатын.
Dialogue: 0,0:20:16.91,0:20:17.93,Default,,0,0,0,,Мисаки
Dialogue: 0,0:20:19.60,0:20:22.07,Default,,0,0,0,,Мисаки менің немере ағам
Dialogue: 0,0:20:23.65,0:20:27.85,Default,,0,0,0,,Бұрын біз бір-бірімізбен тығыз байланыста болатынбыз.
Dialogue: 0,0:20:28.66,0:20:30.00,Default,,0,0,0,,Біз қосылдық
Dialogue: 0,0:20:33.45,0:20:34.14,Default,,0,0,0,,Осымен
Dialogue: 0,0:20:36.26,0:20:38.35,Default,,0,0,0,,Жиырма алты жыл бұрын, 3-сынып
Dialogue: 0,0:20:40.60,0:20:42.67,Default,,0,0,0,,Бұл оқиғаның жалғасы қандай?
Dialogue: 0,0:20:44.96,0:20:46.64,Default,,0,0,0,,Маған ешкім айтпайды
Dialogue: 0,0:20:47.65,0:20:48.38,Default,,0,0,0,,Иә
Dialogue: 0,0:20:48.95,0:20:50.82,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:20:52.37,0:20:54.39,Default,,0,0,0,,Мен сізден біраз уақыттан бері осыны сұрағым келді.
Dialogue: 0,0:20:57.24,0:21:00.43,Default,,0,0,0,,Жаңа мектепке ауысқаннан бері мен бұл туралы ойланып жүрмін.
Dialogue: 0,0:21:01.33,0:21:02.95,Default,,0,0,0,,Қызық, неге?
Dialogue: 0,0:21:03.02,0:21:07.03,Default,,0,0,0,,Сынып және мұғалім, сен неге мұндасың?
Dialogue: 0,0:21:07.05,0:21:08.67,Default,,0,0,0,,Өйткені ол жерде жоқ
Dialogue: 0,0:21:10.57,0:21:11.58,Default,,0,0,0,,Тыңда, Сакаки.
Dialogue: 0,0:21:11.94,0:21:13.98,Default,,0,0,0,,Онда жоқ адаммен араласпа
Dialogue: 0,0:21:15.44,0:21:16.42,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:21:17.34,0:21:18.80,Default,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:21:20.73,0:21:21.61,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:21.87,0:21:25.18,Default,,0,0,0,,Мені бәрі көре алмайды
Dialogue: 0,0:21:27.86,0:21:32.15,Default,,0,0,0,,Менің көретін жалғыз адамым сенсің, Сакакибара-күн.
Dialogue: 0,0:21:33.50,0:21:34.79,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:21:36.76,0:21:37.43,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:39.85,0:21:40.66,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:21:43.93,0:21:44.99,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:22:11.33,0:22:12.35,Default,,0,0,0,,Не болды?
Dialogue: 0,0:23:04.35,0:23:19.40,Default,,0,0,0,,Фильм сияқты өшеді
Dialogue: 0,0:23:22.11,0:23:37.16,Default,,0,0,0,,Тіпті белгілі бір сыйлық ақырында бұлыңғыр болады
Dialogue: 0,0:23:37.18,0:23:46.16,Default,,0,0,0,,Ештеңеге бірге күлдік
Dialogue: 0,0:23:46.16,0:23:55.41,Default,,0,0,0,,Уақыт пен жарық
Dialogue: 0,0:23:55.90,0:24:04.90,Default,,0,0,0,,Байланысты естеліктеріміздің түбінде
Dialogue: 0,0:24:04.90,0:24:23.86,Default,,0,0,0,,Мен әлі де біреудің таба алатынына сенемін.
Dialogue: 0,0:24:25.36,0:24:30.36,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
