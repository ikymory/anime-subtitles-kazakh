Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.03,0:00:22.91,Default,Sorata,0,0,0,,Әр күнім соңғы күнге ұқсайтын менің өмірімдегі бір нәрсе мені жалықтырды.
Dialogue: 0,0:00:18.08,0:00:22.48,*Default-ja,NTP,0,0,0,,Мен баяғы күнделікті өмір әйтеуір қызықсыз деп ойладым.
Dialogue: 0,0:00:24.04,0:00:28.00,Default,Sorata,0,0,0,,Өзгерістердің жоқтығын басқаларды кінәлайтынмын.
Dialogue: 0,0:00:24.08,0:00:27.77,*Default-ja,NTP,0,0,0,,Болмаған нәрсеге біреуді кінәлау
Dialogue: 0,0:00:34.09,0:00:35.22,Default,Sorata,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:00:34.11,0:00:34.56,*Default-ja,NTP,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:00:45.39,0:00:50.36,TS - Handwriting,,0,0,0,,Шешім!
Dialogue: 0,0:00:45.39,0:00:50.36,TS - Handwriting,,0,0,0,,Сакурадан қашыңыз!
Dialogue: 0,0:01:01.58,0:01:03.45,Default,Sorata,0,0,0,,Қандай қайғылы.
Dialogue: 0,0:01:01.70,0:01:02.81,*Default-ja,NTP,0,0,0,,Бұл қайғылы.
Dialogue: 0,0:01:05.62,0:01:11.80,TS - Handwriting,,0,0,0,,Шешім!
Dialogue: 0,0:01:05.62,0:01:11.80,TS - Handwriting,,0,0,0,,Сакурадан қашыңыз!
Dialogue: 0,0:01:06.25,0:01:08.75,Default,Sorata,0,0,0,,Мысықтың бөксесін ояту?
Dialogue: 0,0:01:06.39,0:01:07.96,*Default-ja,NTP,0,0,0,,Оянсам жастығым мысықтың бөксесіндей. Бұл өте аянышты.
Dialogue: 0,0:01:09.34,0:01:11.80,Default,Sorata,0,0,0,,Менің жасөспірім өмірім қаншалықты қайғылы болуы мүмкін?
Dialogue: 0,0:01:17.55,0:01:22.06,TS - Handwriting,,0,0,0,,Сакурадан қашыңыз!
Dialogue: 0,0:01:17.55,0:01:24.52,TS - Handwriting,,0,0,0,,Шешім!
Dialogue: 0,0:01:17.89,0:01:22.97,Default,Sorata,0,0,0,,Адамның бөксесін ояту өз алдына бір мәселе.
Dialogue: 0,0:01:17.90,0:01:22.60,*Default-ja,NTP,0,0,0,,Адамның бөксесімен оянсаң, бұл да мәселе.
Dialogue: 0,0:01:22.06,0:01:22.18,TS - Handwriting,,0,0,0,,Сакурадан қашыңыз!
Dialogue: 0,0:01:22.18,0:01:22.31,TS - Handwriting,,0,0,0,,Сакурадан қашыңыз!
Dialogue: 0,0:01:22.31,0:01:22.43,TS - Handwriting,,0,0,0,,Сакурадан қашыңыз!
Dialogue: 0,0:01:22.43,0:01:22.56,TS - Handwriting,,0,0,0,,Сакурадан қашыңыз!
Dialogue: 0,0:01:22.56,0:01:22.68,TS - Handwriting,,0,0,0,,Сакура -су!!
Dialogue: 0,0:01:22.68,0:01:22.81,TS - Handwriting,,0,0,0,,S -сонымен
Dialogue: 0,0:01:22.89,0:01:23.02,TS - Handwriting,,0,0,0,,Сакурадан қашыңыз!
Dialogue: 0,0:01:23.02,0:01:24.52,TS - Handwriting,,0,0,0,,Сакурадан қашыңыз!
Dialogue: 0,0:01:24.52,0:01:26.31,TS - Handwriting,,0,0,0,,Шешім!
Dialogue: 0,0:01:24.52,0:01:26.31,TS - Handwriting,,0,0,0,,Сакурадан қашыңыз!
Dialogue: 0,0:01:26.31,0:01:29.56,TS - Handwriting,,0,0,0,,Шешім!
Dialogue: 0,0:01:26.31,0:01:30.36,Default,Sorata,0,0,0,,Мисаки-сенпай, сен мұнда ұйықтай алмадың ба?
Dialogue: 0,0:01:26.66,0:01:29.82,*Default-ja,NTP,0,0,0,,Мисаки-сенпай, өтінемін, мұндай жерде жатпа.
Dialogue: 0,0:01:33.11,0:01:36.53,Default,Misaki,0,0,0,,Мен өскенде үйленгім келеді!
Dialogue: 0,0:01:33.53,0:01:36.51,*Default-ja,NTP,0,0,0,,Мен болашақта сенің әйелің болғым келеді.
Dialogue: 0,0:01:36.53,0:01:40.16,Default,Sorata,0,0,0,,Адамдар әдетте ұйықтап жатқанда ұйықтап сөйлеседі.
Dialogue: 0,0:01:36.68,0:01:40.01,*Default-ja,NTP,0,0,0,,Бұл дүниеде мысықтар ұйықтағаннан кейін ғана сөйлесетін заңдылық.
Dialogue: 0,0:01:40.09,0:01:40.82,*Default-ja,NTP,0,0,0,,Қош келдің үйге.
Dialogue: 0,0:01:40.16,0:01:42.37,Default,Misaki,0,0,0,,Үйге қош келдіңіз, қымбаттым. Сіз бүгін кешке ерте келдіңіз.
Dialogue: 0,0:01:40.85,0:01:41.35,*Default-ja,NTP,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:01:41.49,0:01:42.20,*Default-ja,NTP,0,0,0,,Бұл тез болды.
Dialogue: 0,0:01:42.03,0:01:44.20,Alternative,Sorata,0,0,0,,Сен тез есейдің...
Dialogue: 0,0:01:43.25,0:01:45.22,*Default-ja,NTP,0,0,0,,Тамақ іш, суға шомыл
Dialogue: 0,0:01:43.33,0:01:45.37,Default,Misaki,0,0,0,,Кешкі асты қалайсыз ба? Монша?
Dialogue: 0,0:01:45.37,0:01:46.37,Default,Misaki,0,0,0,,Қолдауыңызға рахмет
Dialogue: 0,0:01:45.46,0:01:48.93,*Default-ja,NTP,0,0,0,,Немесе ма-ва-ши
Dialogue: 0,0:01:47.37,0:01:49.33,Default,Misaki,0,0,0,,Шахта денесі?
Dialogue: 0,0:01:49.33,0:01:51.79,Default,Sorata,0,0,0,,Бұл 16 ғасыр емес, білесіз бе.
Dialogue: 0,0:01:49.57,0:01:51.56,*Default-ja,NTP,0,0,0,,Бұл сумо мейрамханасы емес
Dialogue: 0,0:01:51.79,0:01:52.84,Default,Misaki,0,0,0,,«Өзім бе?»
Dialogue: 0,0:01:51.85,0:01:52.65,*Default-ja,NTP,0,0,0,,Тырнау
Dialogue: 0,0:01:52.69,0:01:54.53,*Default-ja,NTP,0,0,0,,Мен бол.
Dialogue: 0,0:01:52.84,0:01:54.67,Default,Sorata,0,0,0,,Қарапайым "мен" болса жақсы болар еді!
Dialogue: 0,0:01:54.42,0:01:56.07,*Default-ja,NTP,0,0,0,,Бірақ ойнайық
Dialogue: 0,0:01:54.67,0:01:56.38,Default,Misaki,0,0,0,,Бірақ ойын ойнайтын уақыт келді!
Dialogue: 0,0:01:55.51,0:01:57.84,Alternative,Sorata,0,0,0,,Бұл дұрыс емес жалғау!
Dialogue: 0,0:01:55.94,0:01:57.53,*Default-ja,NTP,0,0,0,,Жалғаулар жалғанбайды.
Dialogue: 0,0:01:57.78,0:01:59.45,*Default-ja,NTP,0,0,0,,Сонымен, сен бүгін мектепке барасың.
Dialogue: 0,0:01:57.84,0:01:59.89,Alternative,Sorata,0,0,94,,Ең бастысы, бұл мектептің бірінші күні!
Dialogue: 0,0:01:58.67,0:02:01.09,*Default-ja,NTP,0,0,0,,Жарайсыңдар, сенің кіші балаң жеңді.
Dialogue: 1,0:01:58.76,0:02:01.30,Default,Misaki,0,0,0,,Сен мені ұрған сайын ше?
Dialogue: 0,0:01:59.71,0:02:00.73,*Default-ja,NTP,0,0,0,,Маған дайындалу керек
Dialogue: 0,0:01:59.89,0:02:01.30,Alternative,Sorata,0,0,94,,Біз дайындалуымыз керек!
Dialogue: 0,0:02:01.26,0:02:04.00,*Default-ja,NTP,0,0,0,,Мен бір уақытта бір бөлікті шешемін деген ереже ше?
Dialogue: 1,0:02:01.30,0:02:04.18,Default,Misaki,0,0,0,,Мен бір киімді шешемін бе?
Dialogue: 0,0:02:04.18,0:02:06.10,Default,Misaki,0,0,0,,Сіз сенбейтін көз кәмпит!
Dialogue: 0,0:02:04.21,0:02:06.07,*Default-ja,NTP,0,0,0,,Көзді қорғау шаралары да тамаша.
Dialogue: 0,0:02:06.10,0:02:08.60,Default,Misaki,0,0,0,,Романтика! Жасөспірімдік шақтың жарқыраған мәні!
Dialogue: 0,0:02:06.29,0:02:08.70,*Default-ja,NTP,0,0,0,,Толқып кеттім, көзімде жастық шақ.
Dialogue: 0,0:02:08.60,0:02:10.65,Default,Misaki,0,0,0,,Еркек болу жолында жақсы боласыз!
Dialogue: 0,0:02:08.77,0:02:10.39,*Default-ja,NTP,0,0,0,,Бұл ересек болудың баспалдақтары.
Dialogue: 0,0:02:10.53,0:02:12.94,*Default-ja,NTP,0,0,0,,Бұл нәпсінің тізбегі.
Dialogue: 0,0:02:10.65,0:02:13.11,Default,Misaki,0,0,0,,Нәпсінің мәңгілік жібі!
Dialogue: 0,0:02:14.15,0:02:15.23,Default,Chihiro,0,0,0,,Сәлем, Канда.
Dialogue: 0,0:02:14.28,0:02:15.36,*Default-ja,NTP,0,0,0,,Сәлем Канда
Dialogue: 0,0:02:15.86,0:02:19.03,Default,Sorata,0,0,0,,Сенсей! Бұл агрессивті разрядтың несі бар?!
Dialogue: 0,0:02:15.91,0:02:17.43,*Default-ja,NTP,0,0,0,,Мұғалім, бұл не?
Dialogue: 0,0:02:17.48,0:02:20.70,*Default-ja,NTP,0,0,0,,Бұл арандатушы сандық бүгінгі кіру рәсімі.
Dialogue: 0,0:02:19.03,0:02:20.70,Default,Sorata,0,0,0,,Бүгін кіру салтанаты!
Dialogue: 0,0:02:20.70,0:02:24.20,Default,Chihiro,0,0,0,,«Рәсім» балалар, алып кетуге баратын жердің эвфемизмі ғана.
Dialogue: 0,0:02:20.79,0:02:24.24,*Default-ja,NTP,0,0,0,,Шики есімі әзіл ретінде ойлап табылған және ер адамдар жиналатын орын.
Dialogue: 0,0:02:24.20,0:02:26.70,Default,Sorata,0,0,0,,Сіз бірінші курс студенттеріне соғуды жоспарлап отырсыз ба?!
Dialogue: 0,0:02:24.26,0:02:26.48,*Default-ja,NTP,0,0,0,,Жаңа студенттермен араласуды жоспарлап отырсыз ба?
Dialogue: 0,0:02:26.64,0:02:27.58,*Default-ja,NTP,0,0,0,,Сен ақымақ
Dialogue: 0,0:02:26.70,0:02:27.66,Default,Chihiro,0,0,0,,Уау, қалың екенсің.
Dialogue: 0,0:02:27.66,0:02:30.33,Default,Chihiro,0,0,0,,Ыстық, жалғызбасты әке сонда болуы мүмкін.
Dialogue: 0,0:02:27.73,0:02:29.83,*Default-ja,NTP,0,0,0,,Сіздің жалғызбасты әкеңіз жақсы болуы мүмкін.
Dialogue: 0,0:02:30.29,0:02:32.15,*Default-ja,NTP,0,0,0,,Бұл одан жақсырақ.
Dialogue: 0,0:02:30.33,0:02:32.71,Default,Chihiro,0,0,0,,Қалай болғанда да, мынаны алыңыз.
