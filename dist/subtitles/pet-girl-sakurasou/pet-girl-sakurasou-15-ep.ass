Dialogue: 0,0:12:14.50,0:12:18.00,handwriting,,0,0,0,,Мұнда сурет салу керек пе?
Dialogue: 10,0:12:18.59,0:12:21.26,Default,Sorata,0,0,0,,Осымен менің ұсынысым аяқталады.
Dialogue: 0,0:12:18.70,0:12:20.31,*Default-ja,NTP,0,0,0,,Осымен жобаның түсіндірмесі аяқталады.
Dialogue: 10,0:12:21.26,0:12:22.59,Default,Sorata,0,0,0,,тыңдағандарыңызға рахмет!
Dialogue: 0,0:12:21.32,0:12:22.19,*Default-ja,NTP,0,0,0,,Сізге көп рахмет
Dialogue: 10,0:12:22.59,0:12:24.64,Default,Yuuko,0,0,0,,Бұл керемет болды, Онии-чан!
Dialogue: 0,0:12:22.65,0:12:23.80,*Default-ja,NTP,0,0,0,,Бұл керемет, ағайын.
Dialogue: 0,0:12:24.55,0:12:25.93,*Default-ja,NTP,0,0,0,,Қолынан келетін адам сияқты.
Dialogue: 10,0:12:24.64,0:12:26.22,Default,Yuuko,0,0,0,,Сіз өте бақылауда көріндіңіз!
Dialogue: 10,0:12:26.22,0:12:28.26,Default,Nanami,0,0,0,,Иә, қазір түсіну әлдеқайда оңай!
Dialogue: 0,0:12:26.97,0:12:27.76,*Default-ja,NTP,0,0,0,,Түсіну әлдеқайда оңай
Dialogue: 10,0:12:27.55,0:12:29.14,Alternative,Yuuko,0,0,0,,Бұл менің Онии-чаным!
Dialogue: 10,0:12:28.26,0:12:30.43,Default,Mom,0,0,0,,Менің, Сората ер жеткен!
Dialogue: 0,0:12:28.49,0:12:30.46,*Default-ja,NTP,0,0,0,,Сората да керемет болды.
Dialogue: 10,0:12:29.14,0:12:31.23,Alternative,Yuuko,0,0,0,,Бұл менің Онии-чаным, жарайды!
Dialogue: 10,0:12:31.23,0:12:33.31,Alternative,Yuuko,0,0,0,,Ол өте керемет! Мен мұны қайтадан естігім келеді!
Dialogue: 0,0:12:31.30,0:12:32.84,*Default-ja,NTP,0,0,0,,Керемет Мен оны қайта тыңдағым келеді
Dialogue: 10,0:12:35.52,0:12:37.77,Default,Sorata,0,0,0,,Бұларды сен жасадың ба, Аояма?
Dialogue: 0,0:12:35.62,0:12:36.96,*Default-ja,NTP,0,0,0,,Мұны Аояма жасады ма?
Dialogue: 10,0:12:37.77,0:12:39.23,Default,Sorata,0,0,0,,Мен анам солай деп ойладым.
Dialogue: 0,0:12:37.86,0:12:38.69,*Default-ja,NTP,0,0,0,,Мен анам деп ойладым.
Dialogue: 10,0:12:39.23,0:12:41.86,Default,Sorata,0,0,0,,Ол маған үнемі жасап беретін.
Dialogue: 0,0:12:39.69,0:12:40.97,*Default-ja,NTP,0,0,0,,Өйткені ол маған бұрыннан жасап беретін.
Dialogue: 10,0:12:41.86,0:12:44.32,Default,Nanami,0,0,0,,И-Иә, ол маған үйретті.
Dialogue: 0,0:12:41.99,0:12:44.49,*Default-ja,NTP,0,0,0,,Иә, мен оны үйрендім. Бұл дәмді.
Dialogue: 10,0:12:44.32,0:12:45.11,Default,Nanami,0,0,0,,Олар жақсы ма?
Dialogue: 10,0:12:45.11,0:12:46.82,Default,Sorata,0,0,0,,Иә. Өте жақсы.
Dialogue: 0,0:12:45.42,0:12:46.99,*Default-ja,NTP,0,0,0,,Иә, дәмді, рахмет
Dialogue: 10,0:12:46.82,0:12:47.78,Default,Sorata,0,0,0,,Хиёри, қош келдің.
Dialogue: 10,0:12:47.78,0:12:49.24,Default,Nanami,0,0,0,,Мен-көрдім.
Dialogue: 0,0:12:47.99,0:12:49.64,*Default-ja,NTP,0,0,0,,Олай болса жақсы болар еді.
Dialogue: 10,0:12:49.24,0:12:50.54,Default,Nanami,0,0,0,,Бұл тыңдау жақсы.
Dialogue: 10,0:12:50.54,0:12:54.08,Default,Nanami,0,0,0,,Сен сонша көңіл бөлдің, тіпті кешкі ас ішпедің.
Dialogue: 0,0:12:50.77,0:12:51.97,*Default-ja,NTP,0,0,0,,Канда-кун тіпті кешкі ас ішпеді.
Dialogue: 0,0:12:52.54,0:12:53.22,*Default-ja,NTP,0,0,0,,Мен шоғырланып жатырмын.
Dialogue: 10,0:12:54.62,0:12:56.42,Default,Sorata,0,0,0,,Жаңа жыл кеші ғой, иә?
Dialogue: 0,0:12:54.83,0:12:55.43,*Default-ja,NTP,0,0,0,,Жаңа жыл түні?
Dialogue: 10,0:12:56.42,0:12:59.25,Default,Sorata,0,0,0,,Менің презентациям үзіліс аяқталғаннан кейін.
Dialogue: 0,0:12:56.47,0:12:58.24,*Default-ja,NTP,0,0,0,,Үзілістен кейін презентациям болды.
Dialogue: 10,0:12:59.25,0:13:01.96,Default,Sorata,0,0,0,,Оны жинауға біраз уақыт кетті.
Dialogue: 0,0:12:59.33,0:13:01.13,*Default-ja,NTP,0,0,0,,Қалыптастыру үшін біраз уақыт қажет болды.
Dialogue: 10,0:13:01.96,0:13:03.34,Default,Nanami,0,0,0,,Бірақ бұл өте керемет шықты!
Dialogue: 0,0:13:02.04,0:13:02.84,*Default-ja,NTP,0,0,0,,Жақсы болды, өте жақсы болды.
Dialogue: 10,0:13:03.34,0:13:06.55,Default,Sorata,0,0,0,,Дегенмен, мен өзімді сенімді емеспін.
Dialogue: 0,0:13:03.66,0:13:05.72,*Default-ja,NTP,0,0,0,,Бірақ мен әлі біраз уайымдап жүрмін.
Dialogue: 10,0:13:06.55,0:13:10.39,Default,Sorata,0,0,0,,Егер сіз емтихан алушы болсаңыз, презентацияда не тыңдағыңыз келеді?
Dialogue: 0,0:13:06.70,0:13:07.75,*Default-ja,NTP,0,0,0,,Егер Аояма судья болса
Dialogue: 0,0:13:08.33,0:13:09.88,*Default-ja,NTP,0,0,0,,Презентацияда қандай әңгіме тыңдағыларыңыз келеді?
Dialogue: 10,0:13:10.39,0:13:12.39,Default,Nanami,0,0,0,,Иә? Мен?
Dialogue: 0,0:13:10.47,0:13:11.36,*Default-ja,NTP,0,0,0,,Ех I
Dialogue: 10,0:13:12.39,0:13:15.02,Default,Nanami,0,0,0,,Мен ойындар туралы онша білмеймін, бірақ...
Dialogue: 0,0:13:12.44,0:13:14.00,*Default-ja,NTP,0,0,0,,Мен ойын туралы көп білмеймін.
Dialogue: 10,0:13:15.02,0:13:16.06,Default,Nanami,0,0,0,,Ойланып көрейін.
Dialogue: 0,0:13:15.06,0:13:17.43,*Default-ja,NTP,0,0,0,,Иә, егер сіз компания қызметкері болсаңыз.
Dialogue: 0,0:13:16.06,0:13:20.82,TS1,,0,0,0,,«Кел, ойын жасайық» ұсынысы Rhythm Battler ~Rhythm Battler ойыны.
Dialogue: 0,0:13:16.06,0:13:20.82,TS1,,0,0,0,,Кіру Канда Сората
Dialogue: 0,0:13:16.06,0:13:20.82,handwriting,,0,0,0,,Ойын
Dialogue: 0,0:13:16.06,0:13:20.82,handwriting,,0,0,0,,Ұсыныстың мазмұны
Dialogue: 0,0:13:16.06,0:13:20.82,handwriting,,0,0,0,,Қызықты жерлер
Dialogue: 0,0:13:16.06,0:13:20.82,handwriting,,0,0,0,,Мақсат
Dialogue: 0,0:13:16.06,0:13:20.82,handwriting,,0,0,0,,Тұжырымдама
Dialogue: 0,0:13:16.06,0:13:20.82,handwriting,,0,0,0,,Пайда
Dialogue: 0,0:13:16.06,0:13:20.82,handwriting,,0,0,0,,Қалай ойнау керек
Dialogue: 0,0:13:16.06,0:13:20.82,handwriting,,0,0,0,,Жүйе
Dialogue: 0,0:13:16.06,0:13:20.82,handwriting,,0,0,0,,Оларды бір нәрсе қызықтырады ма?
Dialogue: 10,0:13:16.48,0:13:20.82,Default,Nanami,0,0,0,,Егер мен компанияда жұмыс істейтін болсам, ойынның сатылатын-сатылмауын білгім келеді.
Dialogue: 0,0:13:18.11,0:13:19.10,*Default-ja,NTP,0,0,0,,Ол сатады, сатпайды.
Dialogue: 0,0:13:19.64,0:13:20.31,*Default-ja,NTP,0,0,0,,Қызық, оларға мән бере ме?
Dialogue: 10,0:13:21.57,0:13:24.44,Default,Nanami,0,0,0,,Кешіріңіз. Менің ойымша, бұл айқынды білдіреді.
Dialogue: 0,0:13:21.89,0:13:23.54,*Default-ja,NTP,0,0,0,,Кешіріңіз, мүмкін бұл анық, бірақ
Dialogue: 10,0:13:24.44,0:13:25.40,Default,Sorata,0,0,0,,Мүлде жоқ!
Dialogue: 0,0:13:24.51,0:13:26.15,*Default-ja,NTP,0,0,0,,Жоқ, бұл қызық емес.
Dialogue: 10,0:13:25.40,0:13:29.20,Default,Sorata,0,0,0,,Қызықты ма, жоқ па деген ойға қатты көңіл бөлгенім сонша, мен оны мүлдем ұмытып кеттім!
Dialogue: 0,0:13:26.72,0:13:28.44,*Default-ja,NTP,0,0,0,,Тұтқынға түсіп қалғаным сонша, сырғып кете алдым.
Dialogue: 0,0:13:29.19,0:13:30.82,*Default-ja,NTP,0,0,0,,Бұл керемет, рахмет Аояма
Dialogue: 10,0:13:29.20,0:13:31.58,Default,Sorata,0,0,0,,Бұл тамаша! Рахмет, Аояма!
Dialogue: 10,0:13:32.62,0:13:36.08,Default,Sorata,0,0,0,,Сіз маған үнемі көмектесіп жүрген сияқтысыз.
Dialogue: 0,0:13:32.81,0:13:33.75,*Default-ja,NTP,0,0,0,,Қалай болғанда да Аоямада
Dialogue: 0,0:13:34.29,0:13:35.27,*Default-ja,NTP,0,0,0,,Маған үнемі көмек көрсетілді.
Dialogue: 10,0:13:36.08,0:13:40.88,Default,Sorata,0,0,0,,Мен де бірінші презентацияма дайындалып жатқанда маған күріш шарларын дайындадың ғой, солай емес пе?
Dialogue: 0,0:13:36.19,0:13:38.05,*Default-ja,NTP,0,0,0,,Менің ойымша, бұл менің алғашқы презентациям кезінде болды.
Dialogue: 0,0:13:38.60,0:13:39.73,*Default-ja,NTP,0,0,0,,Ол саған күріштен шарлар жасаған шығар.
Dialogue: 0,0:13:41.00,0:13:41.04,SPK-TS,,0,0,0,,Денеңізді күтіңіз
Dialogue: 0,0:13:41.04,0:13:41.09,SPK-TS,,0,0,0,,Денеңізді күтіңіз
Dialogue: 0,0:13:41.09,0:13:41.13,SPK-TS,,0,0,0,,Денеңізді күтіңіз
Dialogue: 0,0:13:41.13,0:13:41.17,SPK-TS,,0,0,0,,Денеңізді күтіңіз
Dialogue: 0,0:13:41.17,0:13:42.34,SPK-TS,,0,0,0,,Денеңізді күтіңіз
Dialogue: 0,0:13:42.34,0:13:42.38,SPK-TS,,0,0,0,,Денеңізді күтіңіз
Dialogue: 0,0:13:42.38,0:13:42.42,SPK-TS,,0,0,0,,Денеңізді күтіңіз
Dialogue: 0,0:13:42.42,0:13:42.46,SPK-TS,,0,0,0,,Денеңізді күтіңіз
Dialogue: 0,0:13:42.46,0:13:42.50,SPK-TS,,0,0,0,,Денеңізді күтіңіз
Dialogue: 10,0:13:42.59,0:13:44.72,Default,Sorata,0,0,0,,Барлығы үшін рахмет.
Dialogue: 0,0:13:42.93,0:13:43.90,*Default-ja,NTP,0,0,0,,Әдеттегідей рахмет
Dialogue: 10,0:13:44.72,0:13:47.47,Default,Sorata,0,0,0,,Сізді де алаңдататын тыңдау бар.
Dialogue: 0,0:13:44.82,0:13:45.45,*Default-ja,NTP,0,0,0,,Тіпті Аояма
Dialogue: 0,0:13:46.30,0:13:47.18,*Default-ja,NTP,0,0,0,,Менде тыңдау бар.
Dialogue: 10,0:13:47.47,0:13:49.85,Default,Sorata,0,0,0,,Мен бұған қатты өкінемін.
Dialogue: 0,0:13:48.08,0:13:49.05,*Default-ja,NTP,0,0,0,,Кешіріңіз.
Dialogue: 10,0:13:49.85,0:13:51.72,Default,Nanami,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:13:49.91,0:13:50.80,*Default-ja,NTP,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 10,0:13:51.72,0:13:53.06,Default,Nanami,0,0,0,,Мен мұны өзім қалағандықтан істеп жатырмын.
Dialogue: 0,0:13:51.73,0:13:52.76,*Default-ja,NTP,0,0,0,,Мен мұны істеймін, өйткені мен мұны істеймін.
Dialogue: 10,0:13:53.47,0:13:57.64,Default,Nanami,0,0,0,,Оның үстіне дәл қазір өзімді басқа нәрсемен айналысқаным дұрыс.
Dialogue: 0,0:13:53.50,0:13:56.09,*Default-ja,NTP,0,0,0,,Оның үстіне, мен қазір басқа нәрсемен айналысқанды жөн көремін.
Dialogue: 0,0:13:56.66,0:13:57.38,*Default-ja,NTP,0,0,0,,Мен алаңдадым
Dialogue: 10,0:13:58.23,0:14:02.94,Default,Nanami,0,0,0,,Олар маған тыңдау сценарийін жібермейінше, мен өзімді тек ойша дайындай аламын.
Dialogue: 0,0:13:58.31,0:13:59.64,*Default-ja,NTP,0,0,0,,Тапсырма сценарийі келгенше
Dialogue: 0,0:14:00.60,0:14:02.29,*Default-ja,NTP,0,0,0,,Сіздің қолыңыздан келетіні – ойша дайындалу.
Dialogue: 10,0:14:03.65,0:14:04.94,Default,Sorata,0,0,0,,Аояма.
Dialogue: 0,0:14:03.72,0:14:04.23,*Default-ja,NTP,0,0,0,,Аояма
Dialogue: 10,0:14:04.94,0:14:06.28,Default,Nanami,0,0,0,,Бұл туралы айтатын болсақ,
Dialogue: 0,0:14:05.19,0:14:05.98,*Default-ja,NTP,0,0,0,,Сен кімсің? Және неге Буггаратиды білесің?
Dialogue: 10,0:14:06.28,0:14:12.24,Default,Nanami,0,0,0,,Мен сценарийді алған кезде, сіз менің тәжірибеме көмектесетін боласыз.
Dialogue: 0,0:14:06.56,0:14:07.43,*Default-ja,NTP,0,0,0,,Сценарий келгенде
Dialogue: 0,0:14:08.10,0:14:09.36,*Default-ja,NTP,0,0,0,,Мен тыңдауларға да жаттығамын
Dialogue: 0,0:14:10.07,0:14:11.52,*Default-ja,NTP,0,0,0,,Мен Канда-куннан көмек сұраймын.
Dialogue: 0,0:14:12.20,0:14:12.64,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 10,0:14:12.24,0:14:13.20,Default,Nanami,0,0,0,,Міне, келдіңіз.
Dialogue: 10,0:14:13.20,0:14:14.91,Default,Sorata,0,0,0,,Менен сұраудың қажеті жоқ.
Dialogue: 0,0:14:13.25,0:14:14.41,*Default-ja,NTP,0,0,0,,Мұны істеудің қажеті жоқ
Dialogue: 0,0:14:14.84,0:14:15.83,*Default-ja,NTP,0,0,0,,Егер мен Аоямаға көмектесе алсам
Dialogue: 10,0:14:14.91,0:14:17.41,Default,Sorata,0,0,0,,Мен саған көмектесу үшін қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:14:16.44,0:14:16.98,*Default-ja,NTP,0,0,0,,Мен бәрін істеймін
Dialogue: 10,0:14:17.41,0:14:19.08,Default,Nanami,0,0,0,,Қалай болды?
Dialogue: 0,0:14:17.58,0:14:18.27,*Default-ja,NTP,0,0,0,,Неліктен?
Dialogue: 0,0:14:18.88,0:14:19.84,*Default-ja,NTP,0,0,0,,Аа, дұрыс.
Dialogue: 10,0:14:19.08,0:14:23.05,Default,Sorata,0,0,0,,W-Жақсы, өйткені мен сенің тыңдалымнан өткеніңді қалаймын.
Dialogue: 0,0:14:20.35,0:14:21.68,*Default-ja,NTP,0,0,0,,Аоямада тыңдау болды.
Dialogue: 0,0:14:22.21,0:14:22.84,*Default-ja,NTP,0,0,0,,Себебі мен сенің өткеніңді қалаймын
Dialogue: 10,0:14:23.59,0:14:28.72,Default,Sorata,0,0,0,,Мен сенің өткен жылдан бері қанша еңбектенгеніңді көрдім.
Dialogue: 0,0:14:23.63,0:14:24.70,*Default-ja,NTP,0,0,0,,Аояма не істемекші
Dialogue: 0,0:14:25.46,0:14:26.14,*Default-ja,NTP,0,0,0,,Бір жастан бастап
Dialogue: 0,0:14:26.76,0:14:27.56,*Default-ja,NTP,0,0,0,,Мен сенің жаныңнан қарап тұрдым.
Dialogue: 10,0:14:28.72,0:14:31.39,Default,Nanami,0,0,0,,Мен... қараңыз.
Dialogue: 0,0:14:28.77,0:14:30.14,*Default-ja,NTP,0,0,0,,Бұл дұрыс
Dialogue: 10,0:14:32.10,0:14:40.40,Default,Sorata,0,0,0,,Бірақ шындығында, мүмкін, мен сенің еңбектің жемісін беретінін дәлелдегеніңді қалаймын.
Dialogue: 0,0:14:32.23,0:14:33.41,*Default-ja,NTP,0,0,0,,Бірақ шын мәнінде
Dialogue: 0,0:14:33.93,0:14:40.40,SPK-TS,,0,0,0,,«Кел, ойын жасайық» ұсынысы Rhythm Battler ~ Ырғақты экшн шайқас ойыны~
Dialogue: 0,0:14:33.93,0:14:40.40,handwriting,,0,0,0,,Ойын
Dialogue: 0,0:14:33.93,0:14:40.40,handwriting,,0,0,0,,Ұсыныстың мазмұны
Dialogue: 0,0:14:33.93,0:14:40.40,handwriting,,0,0,0,,Қызықты жерлер
Dialogue: 0,0:14:33.93,0:14:40.40,handwriting,,0,0,0,,Қалай ойнау керек
Dialogue: 0,0:14:33.93,0:14:40.40,handwriting,,0,0,0,,Жүйе
Dialogue: 0,0:14:33.93,0:14:40.40,handwriting,,0,0,0,,Оларды бір нәрсе қызықтырады ма?
Dialogue: 0,0:14:34.59,0:14:36.00,*Default-ja,NTP,0,0,0,,Еңбектің жемісін беретіні
Dialogue: 0,0:14:37.11,0:14:38.30,*Default-ja,NTP,0,0,0,,Мен Аояманың дәлелдегенін қалаймын.
Мүмкін тек
Dialogue: 0,0:14:38.84,0:14:39.70,*Default-ja,NTP,0,0,0,,...
Dialogue: 10,0:14:42.65,0:14:45.36,Default,Sorata,0,0,0,,Кешіріңіз. Мен олай айтпауым керек еді.
Dialogue: 0,0:14:43.04,0:14:44.59,*Default-ja,NTP,0,0,0,,Нашар Мен жай ғана қажет емес нәрсе айттым.
Dialogue: 0,0:14:45.62,0:14:47.39,*Default-ja,NTP,0,0,0,,Жоқ, ондай ештеңе жоқ.
Dialogue: 10,0:14:45.82,0:14:47.95,Default,Nanami,0,0,0,,Жоқ, жақсы.
Dialogue: 10,0:14:47.95,0:14:50.03,Default,Sorata,0,0,0,,Екеуміз еңбектенейік.
Dialogue: 0,0:14:48.27,0:14:49.21,*Default-ja,NTP,0,0,0,,Бірге қолдан келгеннің бәрін жасайық
Dialogue: 0,0:14:50.23,0:14:50.68,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 10,0:14:54.49,0:14:56.12,Default,Mashiro,0,0,0,,Мен де солай боламын.
Dialogue: 0,0:14:54.80,0:14:55.76,*Default-ja,NTP,0,0,0,,Мен де бар күшімді саламын
Dialogue: 0,0:14:56.08,0:14:56.51,*Default-ja,NTP,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 10,0:14:57.45,0:14:59.83,Default,Mashiro,0,0,0,,Мен сендермен бірге көп жұмыс істегім келеді.
Dialogue: 0,0:14:57.49,0:14:58.69,*Default-ja,NTP,0,0,0,,Мен де бірге қолымнан келгеннің бәрін жасағым келеді.
Dialogue: 10,0:14:59.83,0:15:02.38,Default,Sorata,0,0,0,,Үнемі тынбай жұмыс істеп жүрген жоқсың ба?
Dialogue: 0,0:14:59.91,0:15:01.75,*Default-ja,NTP,0,0,0,,Шиина әрқашан қолынан келгеннің бәрін жасайды.
Dialogue: 10,0:15:02.38,0:15:04.54,Default,Nanami,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:15:02.59,0:15:03.65,*Default-ja,NTP,0,0,0,,Аа, мен де солай ойлаймын.
Dialogue: 10,0:15:07.13,0:15:10.26,Default,Mashiro,0,0,0,,Соңғы кездері мен түсінбейтін нәрселер көп болды.
Dialogue: 0,0:15:07.25,0:15:09.01,*Default-ja,NTP,0,0,0,,Соңғы уақытта нені түсінбеймін
Dialogue: 0,0:15:09.61,0:15:10.15,*Default-ja,NTP,0,0,0,,Көп
Dialogue: 10,0:15:11.80,0:15:13.30,Default,Mashiro,0,0,0,,Қарсы емес.
Dialogue: 0,0:15:11.88,0:15:12.55,*Default-ja,NTP,0,0,0,,Бұл ештеңе емес.
Dialogue: 10,0:15:16.06,0:15:17.35,Default,Sorata,0,0,0,,Шиина?
Dialogue: 0,0:15:16.21,0:15:17.02,*Default-ja,NTP,0,0,0,,Шиина
Dialogue: 10,0:15:31.82,0:15:33.87,Default,Mashiro,0,0,0,,Мен түсінбейтін көп нәрсе бар.
Dialogue: 0,0:15:32.00,0:15:33.26,*Default-ja,NTP,0,0,0,,Мен түсінбейтін нәрселер өте көп
Dialogue: 10,0:15:33.87,0:15:35.49,Default,Misaki,0,0,0,,Маширо?
Dialogue: 0,0:15:34.37,0:15:34.74,*Default-ja,NTP,0,0,0,,таза ақ
Dialogue: 10,0:15:35.49,0:15:38.75,Default,Mashiro,0,0,0,,Джинмен қандай қарым-қатынаста болғың келеді?
Dialogue: 0,0:15:35.74,0:15:37.96,*Default-ja,NTP,0,0,0,,Мисаки Джинмен не істегісі келеді?
Dialogue: 10,0:15:38.75,0:15:40.50,Default,Mashiro,0,0,0,,Менің түсінігіме көңілім толмайды.
Dialogue: 0,0:15:38.85,0:15:40.12,*Default-ja,NTP,0,0,0,,Бұл өте қызықсыз.
Dialogue: 0,0:15:40.79,0:15:42.31,*Default-ja,NTP,0,0,0,,Не?
Dialogue: 10,0:15:41.42,0:15:43.58,Default,Misaki,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 10,0:15:43.58,0:15:46.42,Default,Mashiro,0,0,0,,Менің мангамда екеуің біргесіңдер.
Dialogue: 0,0:15:43.72,0:15:45.65,*Default-ja,NTP,0,0,0,,Менің комикстегі екі адам бірге.
Dialogue: 10,0:15:46.42,0:15:47.84,Default,Mashiro,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:15:46.46,0:15:47.52,*Default-ja,NTP,0,0,0,,Бұл дұрыс емес
Dialogue: 10,0:15:48.21,0:15:50.26,Default,Mashiro,0,0,0,,Мен мұны қалай істеуім керек еді?
Dialogue: 0,0:15:48.41,0:15:49.44,*Default-ja,NTP,0,0,0,,Нені істеген дұрыс?
Dialogue: 10,0:15:50.26,0:15:52.30,Default,Misaki,0,0,0,,Сізге қалай...?
Dialogue: 0,0:15:50.35,0:15:51.51,*Default-ja,NTP,0,0,0,,Мен не істеуім керек?
Dialogue: 10,0:15:54.59,0:15:57.31,Default,Misaki,0,0,0,,Мен Джинмен бірге болғым келеді.
Dialogue: 0,0:15:54.70,0:15:56.25,*Default-ja,NTP,0,0,0,,Мен Джинмен бірге болғым келеді
Dialogue: 10,0:15:57.31,0:16:02.52,Default,Misaki,0,0,0,,Егер мен аниме түсіру арқылы Джинді ренжітсем,
Dialogue: 0,0:15:57.47,0:15:58.86,*Default-ja,NTP,0,0,0,,Аниме жасау арқылы
Dialogue: 0,0:15:59.54,0:16:01.62,*Default-ja,NTP,0,0,0,,Джинді ренжітіп жатсаңыз.
Dialogue: 10,0:16:02.52,0:16:04.65,Default,Misaki,0,0,0,,онда мен аниме жасауды доғарамын.
Dialogue: 0,0:16:02.63,0:16:04.20,*Default-ja,NTP,0,0,0,,Аниме жасауды тоқтатыңыз
Dialogue: 10,0:16:05.27,0:16:06.02,Default,Mashiro,0,0,0,,Б... бір сызық
Dialogue: 0,0:16:05.54,0:16:06.07,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 10,0:16:06.48,0:16:09.07,Default,Mashiro,0,0,0,,Джинге осындай Мисаки ұнай ма?
Dialogue: 0,0:16:06.67,0:16:08.65,*Default-ja,NTP,0,0,0,,Джин Мисакиді осылай жақсы көреді.
Dialogue: 10,0:16:10.44,0:16:15.57,Default,Mashiro,0,0,0,,Соратаға манга салғанды ​​ұнататын мені ұнатады.
Dialogue: 0,0:16:10.61,0:16:11.99,*Default-ja,NTP,0,0,0,,Маған Соратаны ұнатамын
Dialogue: 0,0:16:12.90,0:16:14.84,*Default-ja,NTP,0,0,0,,Мен манга салғанды жақсы көремін.
Dialogue: 10,0:16:15.57,0:16:18.29,Default,Mashiro,0,0,0,,Джинге сенің қандай мінезің ұнайды?
Dialogue: 0,0:16:15.69,0:16:16.65,*Default-ja,NTP,0,0,0,,Джинге не ұнайды?
Dialogue: 0,0:16:17.31,0:16:17.86,*Default-ja,NTP,0,0,0,,Қандай Мисаки
Dialogue: 10,0:16:21.96,0:16:24.00,Default,Aoyama,0,0,0,,Сізде таяқшалар жеткілікті ме?
Dialogue: 0,0:16:22.30,0:16:23.44,*Default-ja,NTP,0,0,0,,Онда менде таяқшалар жеткілікті.
Dialogue: 10,0:16:24.00,0:16:24.79,Default,Sorata,0,0,0,,Оқу, оқу
Dialogue: 10,0:16:24.79,0:16:25.67,Default,Sorata,0,0,0,,Көрейік...
Dialogue: 0,0:16:24.83,0:16:25.28,*Default-ja,NTP,0,0,0,,Э-э-э—
Dialogue: 10,0:16:25.67,0:16:27.34,Default,Mom,0,0,0,,Айтыңызшы, сізде бір сәт бар ма?
Dialogue: 0,0:16:25.89,0:16:26.82,*Default-ja,NTP,0,0,0,,Эй, бұл жақсы.
Dialogue: 10,0:16:29.05,0:16:32.22,Default,Mom,0,0,0,,Мен оның бұлай тынбай оқитынын көрген емеспін.
Dialogue: 0,0:16:29.15,0:16:30.14,*Default-ja,NTP,0,0,0,,Сіз осылай оқисыз ба?
Dialogue: 0,0:16:30.66,0:16:31.22,*Default-ja,NTP,0,0,0,,Бұл менің бірінші рет.
Dialogue: 10,0:16:32.22,0:16:35.51,Default,Mom,0,0,0,,Әкесі оның Sui High үшін сынақтан өтуіне рұқсат бермейді.
Dialogue: 0,0:16:32.32,0:16:34.58,*Default-ja,NTP,0,0,0,,Бірақ әкем су орта мектебіне түсу емтиханын тапсыруға қарсы.
Dialogue: 10,0:16:35.51,0:16:39.10,Default,Sorata,0,0,0,,Егер сіз онымен сөйлессеңіз, ол бірден көнетін еді.
Dialogue: 0,0:16:35.68,0:16:36.93,*Default-ja,NTP,0,0,0,,Анамның әкеме айтқаны
Dialogue: 0,0:16:37.51,0:16:38.64,*Default-ja,NTP,0,0,0,,Ол сені бір рет кешіреді.
Dialogue: 10,0:16:39.47,0:16:42.68,Default,Mom,0,0,0,,Бірақ Юуко сенен көмек сұрады.
Dialogue: 0,0:16:39.57,0:16:41.69,*Default-ja,NTP,0,0,0,,Бірақ Юко сұраған Сората болды.
Dialogue: 10,0:16:43.31,0:16:46.44,Default,Sorata,0,0,0,,Содан кейін әкеме мынаны айт:
Dialogue: 0,0:16:43.54,0:16:45.05,*Default-ja,NTP,0,0,0,,Онда әкеңе айт.
Dialogue: 10,0:16:46.44,0:16:49.52,Default,Sorata,0,0,0,,Уақыты келгенде мен онымен сөйлескім келеді.
Dialogue: 0,0:16:46.68,0:16:47.62,*Default-ja,NTP,0,0,0,,Уақытыңыз болса жақсы
Dialogue: 0,0:16:48.33,0:16:49.13,*Default-ja,NTP,0,0,0,,Әңгімелейтін нәрсе бар.
Dialogue: 10,0:16:49.78,0:16:51.07,Default,Mom,0,0,0,,Сөзсіз!
Dialogue: 0,0:16:49.94,0:16:50.61,*Default-ja,NTP,0,0,0,,Yes
Dialogue: 10,0:16:53.90,0:16:56.53,Default,Mom,0,0,0,,Келіңіздер. Соба кеспесі дымқыл болады.
Dialogue: 0,0:16:54.06,0:16:55.72,*Default-ja,NTP,0,0,0,,Қараңдар, соба кеспесі өседі.
Dialogue: 10,0:17:00.58,0:17:05.75,Default,Sorata,0,0,0,,Мен анама айттым, бірақ мен әкемді қалай көндіремін?
Dialogue: 0,0:17:00.75,0:17:02.17,*Default-ja,NTP,0,0,0,,Мен мұны анама айттым.
Dialogue: 0,0:17:03.03,0:17:04.84,*Default-ja,NTP,0,0,0,,Әкеңді қалай сендірдің?
Dialogue: 10,0:17:07.33,0:17:09.13,Default,Dad,0,0,0,,Мүмкіндік ешкімді күтпейді!
Dialogue: 0,0:17:07.35,0:17:08.83,*Default-ja,NTP,0,0,0,,Мүмкіндік көп күтпейді
Dialogue: 10,0:17:09.13,0:17:12.05,Default,Sorata,0,0,0,,Не істеп жатырсың?!
Dialogue: 0,0:17:10.34,0:17:11.17,*Default-ja,NTP,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:12.05,0:17:12.85,*Default-ja,NTP,0,0,0,,Менің дайындығым
Dialogue: 10,0:17:12.05,0:17:16.43,Default,Dad,0,0,0,,Егер сіз әлі дайын емеспіз деп, мүмкіндікті көз алдыңызда өткізіп жіберсеңіз,
Dialogue: 0,0:17:12.92,0:17:13.71,*Default-ja,NTP,0,0,0,,Өйткені ол орнында емес.
Dialogue: 0,0:17:14.58,0:17:15.82,*Default-ja,NTP,0,0,0,,Егер сіз дәл алдыңызда мүмкіндікті жіберіп алсаңыз
Dialogue: 10,0:17:16.43,0:17:18.89,Default,Dad,0,0,0,,сізге ешқашан басқа мүмкіндік болмайды!
Dialogue: 0,0:17:16.44,0:17:17.07,*Default-ja,NTP,0,0,0,,Келесі мүмкіндік т.б.
Dialogue: 0,0:17:17.82,0:17:18.39,*Default-ja,NTP,0,0,0,,Мен ешқашан бармаймын
Dialogue: 10,0:17:18.89,0:17:20.85,Default,Sorata,0,0,0,,C-C-Қиып таста!
Dialogue: 10,0:17:20.85,0:17:22.31,Default,Sorata,0,0,0,,Мен-мен-мен барамын...
Dialogue: 10,0:17:22.31,0:17:24.06,Default,Dad,0,0,0,,Сонда менімен сөйлескіңіз келе ме?
Dialogue: 0,0:17:22.48,0:17:23.79,*Default-ja,NTP,0,0,0,,Менің ойымша, сөйлесетін нәрсе бар.
Dialogue: 10,0:17:24.06,0:17:26.14,Default,Dad,0,0,0,,Маған анаң айтты.
Dialogue: 0,0:17:24.48,0:17:25.10,*Default-ja,NTP,0,0,0,,Мен анамнан естідім
Dialogue: 0,0:17:26.10,0:17:27.08,*Default-ja,NTP,0,0,0,,Иә, сондықтан мен кірдім.
Dialogue: 10,0:17:26.14,0:17:27.48,Default,Sorata,0,0,0,,Сен осындасың ба?
Dialogue: 10,0:17:27.48,0:17:29.27,Default,Dad,0,0,0,,Маңызды емес. Оны қазірдің өзінде түкіріп тастаңыз.
Dialogue: 0,0:17:27.65,0:17:28.43,*Default-ja,NTP,0,0,0,,Жарайды, тез сөйлесейік.
Dialogue: 10,0:17:29.27,0:17:31.15,Default,Sorata,0,0,0,,Мен мұны ваннада жасамағаным жөн...
Dialogue: 0,0:17:29.35,0:17:30.71,*Default-ja,NTP,0,0,0,,Мен мұны ваннадан шыққаннан кейін жасағаныңызды қалаймын.
Dialogue: 0,0:17:31.08,0:17:32.42,*Default-ja,NTP,0,0,0,,Менің көзім өте жақын
Dialogue: 10,0:17:31.15,0:17:35.32,Default,Dad,0,0,0,,Қолымнан келгенше саған өмірлік сабақ берейін!
Dialogue: 0,0:17:33.14,0:17:34.89,*Default-ja,NTP,0,0,0,,Мен өз өмірім туралы айтып берейін.
Dialogue: 10,0:17:35.32,0:17:37.74,Default,Dad,0,0,0,,Мүмкіндіктер күтпейді—
Dialogue: 0,0:17:35.76,0:17:36.71,*Default-ja,NTP,0,0,0,,Мүмкіндік көп күтпейді
Dialogue: 10,0:17:36.82,0:17:39.70,Alternative,Sorata,0,0,0,,Мен түсіндім! Бұл Юко туралы!
Dialogue: 0,0:17:36.90,0:17:38.43,*Default-ja,NTP,0,0,0,,Мен түсіндім, бұл Юко туралы.
Dialogue: 10,0:17:39.70,0:17:42.41,Default,Sorata,0,0,0,,Ол ынтамен оқиды.
Dialogue: 0,0:17:40.07,0:17:41.52,*Default-ja,NTP,0,0,0,,Сіз шындап оқып жатқан сияқтысыз.
Dialogue: 10,0:17:42.41,0:17:45.91,Default,Sorata,0,0,0,,Неліктен оған Sui High қабылдау емтиханын тапсыруға рұқсат бере алмайсыз?
Dialogue: 0,0:17:42.52,0:17:43.94,*Default-ja,NTP,0,0,0,,Судың биіктігі сынағынан өткенше
Dialogue: 0,0:17:44.46,0:17:45.33,*Default-ja,NTP,0,0,0,,Кешірген дұрыс емес пе?
Dialogue: 10,0:17:46.75,0:17:49.38,Default,Sorata,0,0,0,,Егер ол сынақтан өте алмаса, ол тырысқанына риза болады.
Dialogue: 0,0:17:46.81,0:17:47.36,*Default-ja,NTP,0,0,0,,Түсінбесеңіз
Dialogue: 0,0:17:47.94,0:17:48.94,*Default-ja,NTP,0,0,0,,Юко келіседі.
Dialogue: 10,0:17:49.84,0:17:54.59,Default,Sorata,0,0,0,,Сосын ол осы жердегі мектепке барады, сіз уайымдамайсыз.
Dialogue: 0,0:17:49.95,0:17:51.08,*Default-ja,NTP,0,0,0,,Осылайша мен осы орта мектепке бардым.
Dialogue: 0,0:17:51.59,0:17:52.12,*Default-ja,NTP,0,0,0,,Қатысуды шешсеңіз
Dialogue: 0,0:17:52.80,0:17:54.10,*Default-ja,NTP,0,0,0,,Әкем үшін де қауіпсіз емес пе?
Dialogue: 0,0:17:55.57,0:17:57.94,*Default-ja,NTP,0,0,0,,Иә, сіз сәл құрметті болып кеттіңіз.
Dialogue: 10,0:17:56.30,0:17:58.30,Default,Dad,0,0,0,,Еркек болып кеткен сияқтысың.
Dialogue: 0,0:17:58.65,0:17:58.96,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 10,0:17:59.59,0:18:01.39,Default,Sorata,0,0,0,,Бұлай айтқанда не қарап тұрсың?!
Dialogue: 0,0:17:59.69,0:18:00.97,*Default-ja,NTP,0,0,0,,Сіз қайда сөйлесіп жатырсыз?
Dialogue: 10,0:18:01.39,0:18:02.10,Default,Dad,0,0,0,,Ұлым!
Dialogue: 0,0:18:01.57,0:18:01.99,*Default-ja,NTP,0,0,0,,Менің ұлым.
Dialogue: 0,0:18:01.94,0:18:02.42,*Default-ja,NTP,0,0,0,,Өтінемін
Dialogue: 10,0:18:02.10,0:18:03.60,Default,Sorata,0,0,0,,Өтінемін, шелекті теуіп жібере аласыз ба?
Dialogue: 0,0:18:02.93,0:18:03.29,*Default-ja,NTP,0,0,0,,Өтінемін.
Dialogue: 10,0:18:03.60,0:18:05.85,Default,Dad,0,0,0,,Сонымен? Сіз олардың қайсысына ілесесіз?
Dialogue: 0,0:18:03.85,0:18:04.85,*Default-ja,NTP,0,0,0,,Қай бала ұнайды?
Dialogue: 0,0:18:05.80,0:18:06.38,*Default-ja,NTP,0,0,0,,Жауап жоқ.
Dialogue: 10,0:18:05.85,0:18:07.06,Default,Sorata,0,0,0,,Сен берілмейсің, солай ма?
Dialogue: 0,0:18:06.95,0:18:07.06,*Default-ja,NTP,0,0,0,,Үлкен
Dialogue: 10,0:18:07.06,0:18:09.52,Default,Sorata,0,0,0,,Оның үстіне далаға шыққанда балалардың өсек айтатын түрі бар!
Dialogue: 0,0:18:07.19,0:18:08.39,*Default-ja,NTP,0,0,0,,Неліктен мектеп саяхатының түні туралы сұрақтар қоясыз?
Dialogue: 0,0:18:09.48,0:18:10.48,*Default-ja,NTP,0,0,0,,Шешімсіздік жақсы емес.
Dialogue: 10,0:18:09.52,0:18:10.90,Default,Dad,0,0,0,,Соншалықты шешімсіз болмаңыз!
Dialogue: 10,0:18:10.90,0:18:14.44,Default,Dad,0,0,0,,Менің мұндай трикотажды көтергенім есімде жоқ!
Dialogue: 0,0:18:11.25,0:18:12.31,*Default-ja,NTP,0,0,0,,Сені сондай кішкентай ақымақ қыл
Dialogue: 0,0:18:13.00,0:18:13.77,*Default-ja,NTP,0,0,0,,Мені өсірген сенсің
Dialogue: 0,0:18:14.28,0:18:15.25,*Default-ja,NTP,0,0,0,,Сонда менің отставкаға кеткенімді қалайсың ба?
Dialogue: 10,0:18:14.44,0:18:15.78,Default,Sorata,0,0,0,,Сіз мұны қазірдің өзінде тоқтата аласыз ба?
Dialogue: 10,0:18:15.78,0:18:18.28,Default,Dad,0,0,0,,Бірақ бұл сіздің өміріңіз.
Dialogue: 0,0:18:16.02,0:18:17.30,*Default-ja,NTP,0,0,0,,Бірақ бұл сенің өмірің.
Dialogue: 10,0:18:18.28,0:18:20.03,Default,Dad,0,0,0,,Онымен қалағаныңды істе.
Dialogue: 0,0:18:18.39,0:18:19.13,*Default-ja,NTP,0,0,0,,Өзіңіз ойлаған нәрсені жасаңыз
Dialogue: 10,0:18:20.03,0:18:22.62,Default,Dad,0,0,0,,Егер сіз колледжге түскіңіз келсе, уайымдамаңыз.
Dialogue: 0,0:18:20.05,0:18:21.00,*Default-ja,NTP,0,0,0,,Егер сіз де университетке түскіңіз келсе
Dialogue: 0,0:18:21.31,0:18:21.79,*Default-ja,NTP,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 10,0:18:22.62,0:18:25.16,Default,Dad,0,0,0,,Біз сіздің және Юуконың оқу ақысына жеткілікті ақша табамыз.
Dialogue: 0,0:18:22.90,0:18:24.02,*Default-ja,NTP,0,0,0,,Сіз және Юко үшін оқу ақысына келетін болсақ.
Dialogue: 0,0:18:24.55,0:18:24.87,*Default-ja,NTP,0,0,0,,Мен ақша табамын
Dialogue: 10,0:18:26.08,0:18:28.08,Default,Dad,0,0,0,,Мен мұны қайталамаймын.
Dialogue: 0,0:18:26.22,0:18:26.69,*Default-ja,NTP,0,0,0,,Мен мұны қайталамаймын
Dialogue: 10,0:18:28.08,0:18:29.08,Default,Sorata,0,0,0,,Әке...
Dialogue: 0,0:18:28.28,0:18:28.54,*Default-ja,NTP,0,0,0,,Әке
