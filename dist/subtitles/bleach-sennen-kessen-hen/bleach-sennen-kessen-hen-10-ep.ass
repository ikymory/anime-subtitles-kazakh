Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.09,0:00:11.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:13.26,0:00:13.84,Default,,0,0,0,,Сол бала менің одақтасым болады дегің келе ме?
Dialogue: 0,0:00:17.14,0:00:19.22,Default,,0,0,0,,Мен тағы да есінен танып қалдым.
Dialogue: 0,0:00:22.77,0:00:23.56,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:24.06,0:00:25.40,Default,,0,0,0,,Бұл неше рет болды?
Dialogue: 0,0:00:26.19,0:00:30.53,Default,,0,0,0,,Қайта-қайта шайқастың ортасында ес-түсімді жоғалтамын.
Dialogue: 0,0:00:30.61,0:00:33.03,Default,,0,0,0,,Шайқасқа оралу
Dialogue: 0,0:00:41.62,0:00:43.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:44.00,0:00:45.79,Default,,0,0,0,,Жекпе-жек қызық, бірақ
Dialogue: 0,0:00:45.87,0:00:49.80,Default,,0,0,0,,Мен өзімді ешқашан ұмытқан емеспін, оның арасында ес-түсімді жоғалтқан емеспін.
Dialogue: 0,0:00:50.75,0:00:52.80,Default,,0,0,0,,Бұл тек бір рет болды...
Dialogue: 0,0:00:54.34,0:00:57.64,Default,,0,0,0,,Мен сенімен ұрысқан жалғыз күнім болды.
Dialogue: 0,0:00:58.64,0:01:00.64,Default,,0,0,0,,♪～
Dialogue: 0,0:02:26.02,0:02:28.02,Default,,0,0,0,,～♪
Dialogue: 0,0:02:41.82,0:02:42.49,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:02:50.50,0:02:51.58,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:02:52.21,0:02:53.50,Default,,0,0,0,,Бұл әлі де мүмкін емес.
Dialogue: 0,0:02:53.59,0:02:55.42,Default,,0,0,0,,Рықонғайды қанша іздесем де
Dialogue: 0,0:02:55.50,0:02:59.59,Default,,0,0,0,,Капитанның көңілінен шығатындай мықты адамды таба алмайсың деп ойлаймын.
Dialogue: 0,0:03:00.93,0:03:03.35,Default,,0,0,0,,Сіз шынымен шындықты көрдіңіз.
Dialogue: 0,0:03:03.43,0:03:09.48,Default,,0,0,0,,Рюконғайдың ұстаушыларын қанша өлтірсең де, Сейрейтейдің тыныштығына пайдасы жоқ.
Dialogue: 0,0:03:09.56,0:03:11.60,Default,,0,0,0,,Мәйіттердің бұл тауының көлемі
Dialogue: 0,0:03:11.69,0:03:14.73,Default,,0,0,0,,Капитанның қанағаттанбау дәрежесі бұрынғыша.
Dialogue: 0,0:03:16.02,0:03:19.74,Default,,0,0,0,,Ондай тау қашаннан бері болды?
Dialogue: 0,0:03:19.82,0:03:22.70,Default,,0,0,0,,Иә? Капитан өлген жоқ па?
Dialogue: 0,0:03:22.78,0:03:23.66,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:28.16,0:03:29.79,Default,,0,0,0,,Не? Ол бала
Dialogue: 0,0:03:29.87,0:03:31.00,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:32.37,0:03:34.04,Default,,0,0,0,,Мен шаршадым
Dialogue: 0,0:03:34.83,0:03:36.67,Default,,0,0,0,,Қылышқа Ұрысқа
Dialogue: 0,0:03:37.38,0:03:41.26,Default,,0,0,0,,Сондықтан қылышқа лайық жау іздеп,
Dialogue: 0,0:03:41.34,0:03:43.18,Default,,0,0,0,,Әр жерде кезіп жүрді
Dialogue: 0,0:03:44.30,0:03:49.10,Default,,0,0,0,,Демек, қылыш одан шаршағандардың басын қосқан болуы керек.
Dialogue: 0,0:03:50.10,0:03:51.27,Default,,0,0,0,,Бақыт
Dialogue: 0,0:03:52.48,0:03:54.35,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:03:54.44,0:03:58.02,Default,,0,0,0,,Осылай баламен қылыш айқасамын ба деп ойлаймын.
Dialogue: 0,0:03:58.11,0:04:01.03,Default,,0,0,0,,Бұрын-соңды болмаған ләззат алу
Dialogue: 0,0:04:01.61,0:04:08.49,Default,,0,0,0,,Ол бала менімен ұрысып қалса, өз-өзіне кісен сала ма, білмеймін.
Dialogue: 0,0:04:12.79,0:04:14.08,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:04:14.17,0:04:18.42,Default,,0,0,0,,Жаңа ғана жауап берген қылыш рефлекс арқылы жауап береді.
Dialogue: 0,0:04:18.50,0:04:22.38,Default,,0,0,0,,Есімнен айырылып, оянған сайын қайта туылғандай боламын.
Dialogue: 0,0:04:24.22,0:04:28.18,Default,,0,0,0,,Кенпачи Зараки Сіз байқамаған боларсыз.
Dialogue: 0,0:04:28.26,0:04:30.14,Default,,0,0,0,,Бейсаналық
Dialogue: 0,0:04:30.22,0:04:35.77,Default,,0,0,0,,Шайқастың ортасында мен өз күшімді бөгеп қалдым.
Dialogue: 0,0:04:36.90,0:04:41.57,Default,,0,0,0,,Неліктен Ичиго Куросакимен шайқаста жеңілдіңіз?
Dialogue: 0,0:04:42.90,0:04:46.24,Default,,0,0,0,,Неліктен Ннойтра Джиргаға қарсы шықтыңыз?
Dialogue: 0,0:04:46.32,0:04:48.41,Default,,0,0,0,,Бұл соңғы минуттағы жеңіс пе?
Dialogue: 0,0:04:49.58,0:04:51.37,Default,,0,0,0,,Қарсылас мықты болды
Dialogue: 0,0:04:51.45,0:04:53.75,Default,,0,0,0,,Сырттан бақылаушыға, әрине, солай көрінді.
Dialogue: 0,0:04:54.71,0:04:57.54,Default,,0,0,0,,Бірақ мен олай емес екенін білдім.
Dialogue: 0,0:04:58.84,0:05:04.80,Default,,0,0,0,,Мұның бәрі сіз өзіңіздің билігіңіздің шегіне дейін мөрленгендіктен.
Dialogue: 0,0:05:06.30,0:05:11.43,Default,,0,0,0,,Сол шайқаста біз бұрын-соңды болмаған өзара ләззат алдық.
Dialogue: 0,0:05:12.31,0:05:16.14,Default,,0,0,0,,Сол шайқаста сен ғана ерекшелендің.
Dialogue: 0,0:05:16.23,0:05:19.65,Default,,0,0,0,,Жекпе-жек қуанышын соңғы сәтте білдім.
Dialogue: 0,0:05:19.73,0:05:22.69,Default,,0,0,0,,Бұл менің күнәм
Dialogue: 0,0:05:23.40,0:05:25.40,Default,,0,0,0,,Сіз бақытты болған шығарсыз.
Dialogue: 0,0:05:25.49,0:05:27.61,Default,,0,0,0,,Жан-жағыма қарасам да, акулалардан басқа ештеңе көрмеймін
Dialogue: 0,0:05:27.70,0:05:30.16,Default,,0,0,0,,Қылыш сынайтын жау жоқ.
Dialogue: 0,0:05:30.24,0:05:31.58,Default,,0,0,0,,Сізге
Dialogue: 0,0:05:32.29,0:05:36.75,Default,,0,0,0,,Күштері біркелкі жаумен бірінші рет кездестім.
Dialogue: 0,0:05:37.25,0:05:38.67,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:05:39.75,0:05:42.05,Default,,0,0,0,,Мен сенен әлсіз едім
Dialogue: 0,0:05:42.88,0:05:45.67,Default,,0,0,0,,Өмірімде алғаш кездескен жау деп атайтын адамым
Dialogue: 0,0:05:46.17,0:05:47.30,Default,,0,0,0,,Егер мен мұны жоғалтып алсам
Dialogue: 0,0:05:47.38,0:05:51.81,Default,,0,0,0,,Сіз енді ешқашан ұрысудан ләззат алмаймын деп ойладыңыз.
Dialogue: 0,0:05:51.89,0:05:56.81,Default,,0,0,0,,Бірте-бірте, бейсаналық, әлсіз өзіме бейімделгендей
Dialogue: 0,0:05:56.89,0:06:03.57,Default,,0,0,0,,Қараңғы және терең, ол өз күшін қысып, мөрмен бекітті.
Dialogue: 0,0:06:04.32,0:06:06.11,Default,,0,0,0,,Менің үмітім үзілді
Dialogue: 0,0:06:06.61,0:06:10.82,Default,,0,0,0,,Мен сені өз құнсыздығың үшін билікке тосқауыл қоюға мәжбүр еттім.
Dialogue: 0,0:06:11.57,0:06:14.04,Default,,0,0,0,,Бірақ бір күні мен түсіндім
Dialogue: 0,0:06:14.12,0:06:18.12,Default,,0,0,0,,Күшті жаумен соғысып, ажалға жақындаған сайын,
Dialogue: 0,0:06:18.21,0:06:23.84,Default,,0,0,0,,Сіз өзіңізге тағылған бұғауларды бұзып, бұрынғы күйіңізге оралдыңыз.
Dialogue: 0,0:06:26.30,0:06:29.68,Default,,0,0,0,,Мен сенен басқа ешкімнен күштімін
Dialogue: 0,0:06:30.26,0:06:33.68,Default,,0,0,0,,Сондықтан мен сені өлтіремін
Dialogue: 0,0:06:34.31,0:06:36.10,Default,,0,0,0,,Тіпті жүз градус немесе мың градус
Dialogue: 0,0:06:37.27,0:06:40.48,Default,,0,0,0,,Сондықтан мен сені емдеймін.
Dialogue: 0,0:06:40.56,0:06:43.11,Default,,0,0,0,,Неше есе көп есе
Dialogue: 0,0:06:43.82,0:06:47.11,Default,,0,0,0,,Сіз өзіңіздің шынайы болмысыңызға оралғанша
Dialogue: 0,0:06:49.36,0:06:53.03,Default,,0,0,0,,Менен жоғары биіктерге
Dialogue: 0,0:06:53.53,0:06:54.45,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:06:54.53,0:06:55.62,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:07:02.79,0:07:05.75,Default,,0,0,0,,Сіз оны өлді деп ойладыңыз, солай ма?
Dialogue: 0,0:07:05.84,0:07:06.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:06.50,0:07:07.42,Default,,0,0,0,,Жылы
Dialogue: 0,0:07:08.97,0:07:12.55,Default,,0,0,0,,Мен неліктен айналып өтуді үйрендім?
Dialogue: 0,0:07:12.64,0:07:15.76,Default,,0,0,0,,Сіз білмеуіңіз мүмкін емес.
Dialogue: 0,0:07:19.23,0:07:20.69,Default,,0,0,0,,Банкай
Dialogue: 0,0:07:25.52,0:07:27.61,Default,,0,0,0,,Шаршау
Dialogue: 0,0:07:29.32,0:07:30.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:34.91,0:07:37.70,Default,,0,0,0,,Бұл шоудың соңы
Dialogue: 0,0:07:40.71,0:07:42.83,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:07:44.13,0:07:44.71,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:07:49.76,0:07:50.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:06.77,0:08:07.73,Default,,0,0,0,,Иә
Dialogue: 0,0:08:16.53,0:08:18.83,Default,,0,0,0,,Ах... ериді
Dialogue: 0,0:08:25.17,0:08:27.13,Default,,0,0,0,,Балқу
Dialogue: 0,0:08:27.88,0:08:28.50,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:38.64,0:08:40.01,Default,,0,0,0,,плюс отбасылық әулеттік қорқыныш, деп ойлаймын
Dialogue: 0,0:08:40.52,0:08:41.93,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:44.69,0:08:45.40,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:46.19,0:08:50.02,Default,,0,0,0,,Бәрі басқа... бәрі басқа.
Dialogue: 0,0:08:50.69,0:08:51.82,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:53.36,0:08:55.53,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:09:01.12,0:09:02.04,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:02.12,0:09:04.83,Default,,0,0,0,,Осы уақытқа дейін ұйықтап қалдым ба?
Dialogue: 0,0:09:06.08,0:09:10.25,Default,,0,0,0,,Мен ұйықтап жатқанда, мен сенімен осы алмасуды ойлап отыр едім.
Dialogue: 0,0:09:10.34,0:09:12.84,Default,,0,0,0,,Мен оны түсімде іздеп жүрдім
Dialogue: 0,0:09:13.55,0:09:17.18,Default,,0,0,0,,Мен әрқашан бұл алмасудың аты жоқ деп ойладым.
Dialogue: 0,0:09:17.68,0:09:21.06,Default,,0,0,0,,Ал енді сізге рахмет
Dialogue: 0,0:09:21.14,0:09:23.85,Default,,0,0,0,,Мен ақыры біле алдым
Dialogue: 0,0:09:24.60,0:09:25.77,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:25.85,0:09:26.56,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:27.90,0:09:29.15,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:29.73,0:09:32.61,Default,,0,0,0,,Бұл шайқас!
Dialogue: 0,0:09:33.53,0:09:35.74,Default,,0,0,0,,Эй, байқадың ба?
Dialogue: 0,0:09:36.49,0:09:39.37,Default,,0,0,0,,Маған төбелескен ұнайды, маған ұнайды.
Dialogue: 0,0:09:39.45,0:09:42.20,Default,,0,0,0,,Мен мұнымен ештеңе істей алмаймын.
Dialogue: 0,0:09:42.29,0:09:44.91,Default,,0,0,0,,Иә, мен оны байқадым.
Dialogue: 0,0:09:45.00,0:09:47.46,Default,,0,0,0,,Сенен бері көп уақыт өткеніне сенімдімін.
Dialogue: 0,0:09:48.71,0:09:50.59,Default,,0,0,0,,Сәлем Кенпачи Зараки
Dialogue: 0,0:09:51.25,0:09:56.72,Default,,0,0,0,,Сіз жекпе-жектен мәңгі ләззат алу үшін өзіңізді құлыптауды үйрендіңіз.
Dialogue: 0,0:09:58.05,0:10:03.56,Default,,0,0,0,,Мен күресуден мәңгі рахат алу үшін өзімді емдеуді үйрендім.
Dialogue: 0,0:10:04.06,0:10:07.60,Default,,0,0,0,,Бірақ мен қазір сенімдімін
Dialogue: 0,0:10:07.69,0:10:13.11,Default,,0,0,0,,Мен алған бұл күш осы бір шайқас үшін болды.
Dialogue: 0,0:10:14.48,0:10:16.61,Default,,0,0,0,,Бір дәуірде бір ғана Кенпачи бар
Dialogue: 0,0:10:17.32,0:10:20.82,Default,,0,0,0,,Бұл заң және сонымен бірге бұлтартпас тағдыр
Dialogue: 0,0:10:21.32,0:10:25.66,Default,,0,0,0,,Өйткені мықтылар келесі күшті тапқанда
Dialogue: 0,0:10:25.75,0:10:29.33,Default,,0,0,0,,Өйткені мен енді өзім үшін қылыш ұстай алмаймын.
Dialogue: 0,0:10:29.96,0:10:33.00,Default,,0,0,0,,Ол кезде найзаның ұшы керек
Dialogue: 0,0:10:33.09,0:10:35.46,Default,,0,0,0,,Келесі күшті адамды өлтіру үшін?
Dialogue: 0,0:10:35.55,0:10:38.93,Default,,0,0,0,,тәрбиелеуге немесе тәрбиелеуге бағытталған
Dialogue: 0,0:10:39.72,0:10:41.47,Default,,0,0,0,,Менің командирім...
Dialogue: 0,0:10:50.69,0:10:51.85,Default,,0,0,0,,Бұл бала.
Dialogue: 0,0:10:51.94,0:10:55.98,Default,,0,0,0,,Бұл бала Кенпачи деген атқа лайық.
Dialogue: 0,0:10:56.61,0:10:57.44,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:58.90,0:11:00.24,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:11:00.99,0:11:02.99,Default,,0,0,0,,Дүниеде бір ғана адам...
Dialogue: 0,0:11:05.41,0:11:08.00,Default,,0,0,0,,Маған ұнаған адам
Dialogue: 0,0:11:11.62,0:11:14.84,Default,,0,0,0,,Ғажайып Кенпачи Зараки
Dialogue: 0,0:11:16.42,0:11:18.63,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:11:23.26,0:11:24.68,Default,,0,0,0,,бітті ме?
Dialogue: 0,0:11:25.56,0:11:28.31,Default,,0,0,0,,Әй, сен өлесің бе?
Dialogue: 0,0:11:29.27,0:11:31.27,Default,,0,0,0,,Ей, өлме.
Dialogue: 0,0:11:31.81,0:11:34.90,Default,,0,0,0,,Әлі жоқ, әлі де жеткіліксіз
Dialogue: 0,0:11:35.90,0:11:38.65,Default,,0,0,0,,Өтінемін, өлме.
Dialogue: 0,0:11:39.24,0:11:40.74,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:41.40,0:11:44.70,Default,,0,0,0,,Өлме!
Dialogue: 0,0:11:45.58,0:11:48.20,Default,,0,0,0,,Хехе, бала сияқты.
Dialogue: 0,0:11:48.95,0:11:51.58,Default,,0,0,0,,Біз не үшін қайғыра аламыз?
Dialogue: 0,0:11:52.29,0:11:56.34,Default,,0,0,0,,Күшіңді қайтарып, мені жеңген саған
Dialogue: 0,0:11:56.84,0:11:58.59,Default,,0,0,0,,Мен көптеген шайқастарды көремін
Dialogue: 0,0:11:58.67,0:12:02.97,Default,,0,0,0,,Жалғыздықпен айналысатын қызықсыз әрекеттерге қайта оралуыңыз мүмкін.
Dialogue: 0,0:12:03.72,0:12:07.60,Default,,0,0,0,,Бірақ қазір сенің де дұшпандарың бар, сіз қанағаттанарлықтай күресе аласыз.
Dialogue: 0,0:12:08.68,0:12:11.10,Default,,0,0,0,,Теңдей жарыса алатын достары да бар.
Dialogue: 0,0:12:11.18,0:12:13.06,Default,,0,0,0,,Ең бастысы
Dialogue: 0,0:12:13.14,0:12:17.65,Default,,0,0,0,,Сізбен бірге оянған серіктес жоқ па?
Dialogue: 0,0:12:20.03,0:12:25.36,Default,,0,0,0,,Менде бар нәрсенің бәрін мен саған бердім.
Dialogue: 0,0:12:25.87,0:12:29.54,Default,,0,0,0,,Енді менің қолымда ештеңе жоқ
Dialogue: 0,0:12:30.16,0:12:34.37,Default,,0,0,0,,Ол кезде мен де саған Кенпачидің атын айта алмадым.
Dialogue: 0,0:12:34.46,0:12:37.29,Default,,0,0,0,,Ақыры қолымнан жоғалып кетті.
Dialogue: 0,0:12:38.29,0:12:41.42,Default,,0,0,0,,Кенпачи Зараки мерекесін тойлаңыз
Dialogue: 0,0:12:42.34,0:12:44.51,Default,,0,0,0,,Мен үшін өледі
Dialogue: 0,0:12:46.09,0:12:47.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:48.01,0:12:53.73,Default,,0,0,0,,Өз рөліңді орындап өлу қандай бақытты!
Dialogue: 0,0:13:09.74,0:13:13.08,Default,,0,0,0,,Кенпачи… Зараки Кенпачи
Dialogue: 0,0:13:13.58,0:13:16.29,Default,,0,0,0,,Бұл кім? Мені кім шақырып жатыр!
Dialogue: 0,0:13:16.37,0:13:18.25,Default,,0,0,0,,Шық!
Dialogue: 0,0:13:19.04,0:13:22.71,Default,,0,0,0,,Менің дауысым сізге жетті.
Dialogue: 0,0:13:22.80,0:13:23.80,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:24.80,0:13:26.97,Default,,0,0,0,,Мен сені басқалардан ұзағырақ ұстаймын
Dialogue: 0,0:13:27.76,0:13:31.56,Default,,0,0,0,,Көптен бері көрген дауысым басқалардан жақынырақ...
Dialogue: 0,0:13:34.60,0:13:36.98,Default,,0,0,0,,О? Бұл кім?
Dialogue: 0,0:13:38.48,0:13:39.48,Default,,0,0,0,,Кенпачи
Dialogue: 0,0:13:40.27,0:13:41.98,Default,,0,0,0,,Бұл Заракиден келген Кенпачи.
Dialogue: 0,0:13:42.82,0:13:45.74,Default,,0,0,0,,Кенпачи Зараки танысқаныма қуаныштымын
Dialogue: 0,0:13:47.24,0:13:48.49,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:14:02.38,0:14:04.71,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:14:09.14,0:14:10.55,Default,,0,0,0,,Мұнда ешкім жоқ
Dialogue: 0,0:14:11.30,0:14:12.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:12.14,0:14:14.02,Default,,0,0,0,,(қатты музыка)
Dialogue: 0,0:14:14.10,0:14:16.69,Default,,0,0,0,,Жоқ... (Ичиго) Бұл қандай дыбыс?
Dialogue: 0,0:14:16.77,0:14:19.90,Default,,0,0,0,,Басым биік, Басым биік! Басқаша айтқанда...
Dialogue: 0,0:14:19.98,0:14:22.40,Default,,0,0,0,,Менің басым өте жоғары!
Dialogue: 0,0:14:23.86,0:14:27.61,Default,,0,0,0,,Мен бірінші нөмірлі Занпакуто Крейрамын!
Dialogue: 0,0:14:27.70,0:14:29.28,Default,,0,0,0,,Нимаия О-Эцу!
Dialogue: 0,0:14:29.36,0:14:32.78,Default,,0,0,0,,Ｓ Ｉ Ｋ Ｕ Ｙ Ｏ Ｒ Ｏ
Dialogue: 0,0:14:32.87,0:14:35.91,Default,,0,0,0,,Шикуоро десу
Dialogue: 0,0:14:36.00,0:14:39.04,Default,,0,0,0,,Занпакуто~!
Dialogue: 0,0:14:39.12,0:14:39.71,Default,,0,0,0,,Сүйемін!
Dialogue: 0,0:14:39.79,0:14:40.79,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:42.71,0:14:44.17,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:14:44.25,0:14:45.92,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:14:46.01,0:14:47.42,Default,,0,0,0,,(Әдемі әйелдердің сәлемі)
Dialogue: 0,0:14:47.51,0:14:50.14,Default,,0,0,0,,Өте әсерлі! Эротикалық (Ренджи) Бұл не?
Dialogue: 0,0:14:50.22,0:14:52.39,Default,,0,0,0,,Жұмақ Жұмақ! (Әдемі әйел) Қызылы - Ренжи, солай ма?
Dialogue: 0,0:14:52.47,0:14:54.39,Default,,0,0,0,,Құрметпен (Ичиго) Алданбаңыз.
Dialogue: 0,0:14:54.47,0:14:57.89,Default,,0,0,0,,Шындығында, олардың барлығы иллюзия немесе соған ұқсас нәрсе, мен сенімдімін.
Dialogue: 0,0:14:58.39,0:14:59.52,Default,,0,0,0,,Шулы
Dialogue: 0,0:14:59.60,0:15:02.56,Default,,0,0,0,,Сондықтан Куросаки-чан мен Абараи-чан
Dialogue: 0,0:15:02.65,0:15:04.90,Default,,0,0,0,,Ал жұмбақ тұлып
Dialogue: 0,0:15:04.98,0:15:08.78,Default,,0,0,0,,Сізге сәлемдесу шоуы шынымен ұнады ма?
Dialogue: 0,0:15:08.86,0:15:14.49,Default,,0,0,0,,Танысқаныма қуаныштымын, Чанбок - Феникс Холлдың иесі Нимаия Вангюэ!
Dialogue: 0,0:15:16.70,0:15:18.58,Default,,0,0,0,,Шикуоро десу!
Dialogue: 0,0:15:19.62,0:15:22.25,Default,,0,0,0,,Ммм! Пан папан! Эй!
Dialogue: 0,0:15:22.33,0:15:24.50,Default,,0,0,0,,Жоқ, мені ауыстырыңыз.
Dialogue: 0,0:15:24.59,0:15:27.34,Default,,0,0,0,,Мен бұл кісінің ой-өрісіне толықтай ілесе алмаймын.
Dialogue: 0,0:15:27.42,0:15:30.13,Default,,0,0,0,,Ақымақ, мен тіпті жете алмаймын.
Dialogue: 0,0:15:30.22,0:15:33.51,Default,,0,0,0,,Хмм, бірдеңе дұрыс емес.
Dialogue: 0,0:15:33.60,0:15:36.35,Default,,0,0,0,,Балалар, көңіл күйлерің нашар.
Dialogue: 0,0:15:37.31,0:15:37.85,Default,,0,0,0,,Үйге барасыз ба?
Dialogue: 0,0:15:37.93,0:15:38.89,Default,,0,0,0,,Не!
Dialogue: 0,0:15:41.44,0:15:43.61,Default,,0,0,0,,Мен қайтпаймын! (Ренджи) Сізге көп рахмет!
Dialogue: 0,0:15:43.69,0:15:44.36,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:44.44,0:15:46.36,Default,,0,0,0,,Жоқ-жоқ емес-жоқ!
Dialogue: 0,0:15:46.44,0:15:49.44,Default,,0,0,0,,Сіздің «өтінемін» деп айтуыңыз дөрекі!
Dialogue: 0,0:15:49.53,0:15:52.49,Default,,0,0,0,,Бұл Хууденнің ресми стилі!
Dialogue: 0,0:15:53.91,0:15:54.82,Default,,0,0,0,,Сұраңыз!
Dialogue: 0,0:15:54.91,0:15:56.37,Default,,0,0,0,,Сіз осылай поза бере аласыз ба?
Dialogue: 0,0:15:56.45,0:15:59.20,Default,,0,0,0,,Сабыр ет, Ичиго, біз мұны істеуіміз керек!
Dialogue: 0,0:16:00.50,0:16:01.29,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:16:03.50,0:16:04.83,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:16:04.92,0:16:06.17,Default,,0,0,0,,Керемет поза!
Dialogue: 0,0:16:06.25,0:16:08.63,Default,,0,0,0,,Мына Бал-чандарға қараңдар.
Dialogue: 0,0:16:08.71,0:16:09.84,Default,,0,0,0,,Бананға ұқсайды!
Dialogue: 0,0:16:09.92,0:16:11.97,Default,,0,0,0,,Хахаха (Ичиго/Ренджи) бейбақ...
Dialogue: 0,0:16:12.55,0:16:14.22,Default,,0,0,0,,Ах~ Бұл қанша уақытқа созылады...
Dialogue: 0,0:16:14.30,0:16:16.60,Default,,0,0,0,,Мен мұны істедім!
Dialogue: 0,0:16:16.68,0:16:19.06,Default,,0,0,0,,Не істеп жатырсың, Мера-чан?
Dialogue: 0,0:16:19.56,0:16:20.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:21.81,0:16:23.10,Default,,0,0,0,,Тіпті ең озық заманауи—
Dialogue: 0,0:16:27.36,0:16:29.73,Default,,0,0,0,,Бұл нағыз Феникс Холл.
Dialogue: 0,0:16:30.32,0:16:32.03,Default,,0,0,0,,Бас...
Dialogue: 0,0:16:32.11,0:16:33.36,Default,,0,0,0,,Жүр, кірме.
Dialogue: 0,0:16:33.45,0:16:37.87,Default,,0,0,0,,Мен бұл жалғыз жерді жек көремін! Жоғарыда айтқаным жақсы!
Dialogue: 0,0:16:37.95,0:16:40.12,Default,,0,0,0,,Дұрыс па? Жұмбақ тұлыптар!
Dialogue: 0,0:16:40.20,0:16:43.29,Default,,0,0,0,,Менің сезімімді түсіне аласыз ба?
Dialogue: 0,0:16:43.79,0:16:45.58,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:16:45.67,0:16:46.96,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:48.09,0:16:49.00,Default,,0,0,0,,Сіз —
Dialogue: 0,0:16:49.09,0:16:50.96,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:16:51.05,0:16:54.18,Default,,0,0,0,,Куросаки-чан, Абарай-чан, сен білесің бе?
Dialogue: 0,0:16:54.26,0:16:55.80,Default,,0,0,0,,Балалар сендер осында келгенше
Dialogue: 0,0:16:55.89,0:16:59.47,Default,,0,0,0,,Чанбокудан басқа мен Шинигамиді кездестірмедім.
Dialogue: 0,0:16:59.56,0:17:00.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:01.56,0:17:04.48,Default,,0,0,0,,Бұрынғы барлық бал-шандар...
Dialogue: 0,0:17:04.98,0:17:06.48,Default,,0,0,0,,Занпакуто
Dialogue: 0,0:17:06.56,0:17:08.11,Default,,0,0,0,,Занпакуто...
Dialogue: 0,0:17:08.19,0:17:11.94,Default,,0,0,0,,Не? Бұл біртүрлі, бұл Сиока емес пе?
Dialogue: 0,0:17:12.03,0:17:17.07,Default,,0,0,0,,Синигами болсаң да, Синигами мен Занпакутоны ажырата алмайсың.
Dialogue: 0,0:17:17.16,0:17:19.37,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:19.45,0:17:23.08,Default,,0,0,0,,Олар мұны өздерінің Занпакутасына жасайтын сүйіспеншіліксіз адамдар.
Dialogue: 0,0:17:23.16,0:17:25.58,Default,,0,0,0,,Мен оларды ажырата алмаймын ба?
Dialogue: 0,0:17:25.67,0:17:27.54,Default,,0,0,0,,Ах! (Ренджи) Эй, мен мұны білмей тұрып...
Dialogue: 0,0:17:28.96,0:17:30.00,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:30.09,0:17:33.63,Default,,0,0,0,,А-ла-ла, махаббатты қабылдамайтын Занпакуто
Dialogue: 0,0:17:33.72,0:17:37.30,Default,,0,0,0,,Ол оңай бұзылады.
Dialogue: 0,0:17:37.39,0:17:42.43,Default,,0,0,0,,Занпакутоның ашуы айналаңызда толып тұр.
Dialogue: 0,0:17:42.52,0:17:43.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:44.35,0:17:46.44,Default,,0,0,0,,Ол жерден тірі шықсаң
Dialogue: 0,0:17:46.52,0:17:49.27,Default,,0,0,0,,Занпакуто пішінін өзгертуге болады.
Dialogue: 0,0:17:49.36,0:17:50.40,Default,,0,0,0,,Оны ұмытып қалдың ба?
Dialogue: 0,0:17:50.48,0:17:52.28,Default,,0,0,0,,Мен тағы бір айтайын!
Dialogue: 0,0:17:52.36,0:17:56.03,Default,,0,0,0,,Мен бірінші нөмірлі Занпакуто Крейрамын!
Dialogue: 0,0:17:56.11,0:17:59.28,Default,,0,0,0,,19 8 7 6 5 дана
Dialogue: 0,0:17:59.37,0:18:01.03,Default,,0,0,0,,Соңында, үш бөлік
Dialogue: 0,0:18:01.12,0:18:03.04,Default,,0,0,0,,Нимаия О-Эцу!
Dialogue: 0,0:18:03.12,0:18:05.75,Default,,0,0,0,,Зако ұстайтын қылыш жоқ.
Dialogue: 0,0:18:05.83,0:18:06.66,Default,,0,0,0,,Теме...
Dialogue: 0,0:18:06.75,0:18:09.42,Default,,0,0,0,,Шикуоро десу
Dialogue: 0,0:18:11.21,0:18:12.84,Default,,0,0,0,,Маған ұнамайтын нәрсе
Dialogue: 0,0:18:12.92,0:18:13.76,Default,,0,0,0,,О
Dialogue: 0,0:18:13.84,0:18:15.92,Default,,0,0,0,,Қорқатын ештеңе жоқ
Dialogue: 0,0:18:16.51,0:18:19.89,Default,,0,0,0,,Олар бәрін жасай алатын ең күшті Занпакуто.
Dialogue: 0,0:18:20.39,0:18:22.06,Default,,0,0,0,,Бұл таяз соққы.
Dialogue: 0,0:18:23.01,0:18:24.52,Default,,0,0,0,,Таяз соққы…
Dialogue: 0,0:18:26.10,0:18:31.15,Default,,0,0,0,,Готей 13 корпусының 6000-нан астам мүшесі
Dialogue: 0,0:18:31.23,0:18:35.74,Default,,0,0,0,,Магистратура студенті кезінде уақытша несие берілді, әскерге қабылданған кезде ресми түрде марапатталады⸺
Dialogue: 0,0:18:35.82,0:18:37.40,Default,,0,0,0,,Аты жоқ Занпакуто
Dialogue: 0,0:18:37.99,0:18:43.33,Default,,0,0,0,,Барлық Шинигами осы Асаучимен және қайта-қайта жаттығу арқылы тамақтанып, ұйықтайды.
Dialogue: 0,0:18:43.41,0:18:47.04,Default,,0,0,0,,Жаныңыздың мәнін Асаучиге көшіріңіз
Dialogue: 0,0:18:47.12,0:18:50.17,Default,,0,0,0,,Өзіңіздің Занпакутоны жасаңыз
Dialogue: 0,0:18:50.25,0:18:54.21,Default,,0,0,0,,Сол таяз жұмыстың бәрін өзі жасады.
Dialogue: 0,0:18:54.30,0:18:58.30,Default,,0,0,0,,Бұл Чанбоку қылыш құдайы Нимаия Оэцу!
Dialogue: 0,0:18:58.38,0:19:00.64,Default,,0,0,0,,Неліктен біз бұл таяз жігіттерміз?
Dialogue: 0,0:19:00.72,0:19:02.30,Default,,0,0,0,,Маған шабуыл жасау керек!
Dialogue: 0,0:19:02.39,0:19:06.14,Default,,0,0,0,,Неліктен деп ойланудың қажеті жоқ.
Dialogue: 0,0:19:06.22,0:19:10.02,Default,,0,0,0,,Ең бастысы, олар сізге ашуланады.
Dialogue: 0,0:19:10.10,0:19:11.02,Default,,0,0,0,,Не?
Dialogue: 0,0:19:11.10,0:19:13.73,Default,,0,0,0,,Zanpakuto қалай пайдалануға болады
Dialogue: 0,0:19:13.82,0:19:15.27,Default,,0,0,0,,Қалай қолдануға болады?
Dialogue: 0,0:19:15.36,0:19:17.36,Default,,0,0,0,,Білмеймін, таңқаларлық емес
Dialogue: 0,0:19:17.44,0:19:19.32,Default,,0,0,0,,Қалай күресу керек? Оны қалай шайқауға болады?
Dialogue: 0,0:19:19.40,0:19:21.66,Default,,0,0,0,,Жоқ, жоқ, айырмашылығы неде?
Dialogue: 0,0:19:22.16,0:19:24.58,Default,,0,0,0,,Олар сіз туралы осылай ойлайды
Dialogue: 0,0:19:24.66,0:19:26.16,Default,,0,0,0,,Негізінен басқаша
Dialogue: 0,0:19:26.24,0:19:28.79,Default,,0,0,0,,Қайсысы жақсы, Занпакуто немесе Шинигами?
Dialogue: 0,0:19:28.87,0:19:31.12,Default,,0,0,0,,Сол жерден сөйлесейік!
Dialogue: 0,0:19:31.62,0:19:32.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:42.39,0:19:44.39,Default,,0,0,0,,♪～
Dialogue: 0,0:21:09.81,0:21:11.81,Default,,0,0,0,,～♪
Dialogue: 0,0:21:17.02,0:21:19.98,Default,,0,0,0,,71 сағат 48 минут
Dialogue: 0,0:21:20.07,0:21:23.82,Default,,0,0,0,,Сіз үш күн, үш түн шын мәнінде көп жұмыс істедіңіз, бұл өте жақсы болды.
Dialogue: 0,0:21:24.90,0:21:27.32,Default,,0,0,0,,Сен өттің, Ренжи Чан.
Dialogue: 0,0:21:29.41,0:21:32.54,Default,,0,0,0,,Сіз сәтсіздікке ұшырадыңыз.
Dialogue: 0,0:21:33.12,0:21:35.08,Default,,0,0,0,,Ичиго-чан
Dialogue: 0,0:21:35.16,0:21:38.00,Default,,0,0,0,,Ал... күте тұрыңыз, әлі жоқ...
Dialogue: 0,0:21:38.08,0:21:39.17,Default,,0,0,0,,Дамм
Dialogue: 0,0:21:39.25,0:21:42.75,Default,,0,0,0,,Күтпе, бітті Фаил Чан Чан ♪
Dialogue: 0,0:21:42.84,0:21:45.80,Default,,0,0,0,,Мен... Әлі де қолымнан келеді.
Dialogue: 0,0:21:46.30,0:21:49.72,Default,,0,0,0,,Маған рұқсат етіңіз! Уақытымыз біткен сияқты емес!
Dialogue: 0,0:21:49.80,0:21:53.10,Default,,0,0,0,,Менің уақытым таусылды, ойым жоқ
Dialogue: 0,0:21:53.18,0:21:56.94,Default,,0,0,0,,Мен мұны істей аламын ба, жоқ па деп отырған жоқпын.
Dialogue: 0,0:21:57.02,0:22:00.69,Default,,0,0,0,,Сіз Асаучиге таңдалған жоқсыз, барлығы осы.
Dialogue: 0,0:22:00.77,0:22:04.07,Default,,0,0,0,,Сондықтан мен енді мұны істей алмаймын, Чан Чан♪
Dialogue: 0,0:22:04.15,0:22:05.03,Default,,0,0,0,,(Танжиро) Тұр, тұр! Тоқта, Иносукэ~!
Dialogue: 0,0:22:05.11,0:22:06.40,Default,,0,0,0,,Бұл жағымсыз
Dialogue: 0,0:22:06.49,0:22:10.53,Default,,0,0,0,,Төгілген жігіт мәңгі айқайламайды.
Dialogue: 0,0:22:11.12,0:22:13.41,Default,,0,0,0,,Соңғы үш күнде мен анық білдім
Dialogue: 0,0:22:13.49,0:22:18.04,Default,,0,0,0,,Ренжи - Шинигами, ал Ичиго - Шинигами емес.
Dialogue: 0,0:22:18.12,0:22:22.21,Default,,0,0,0,,Жарайды, мен тікелей осы жерден жол ашамын.
Dialogue: 0,0:22:22.29,0:22:23.17,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:22:23.92,0:22:25.92,Default,,0,0,0,,Үйге бару керек.
Dialogue: 0,0:22:29.68,0:22:30.39,Default,,0,0,0,,А...
Dialogue: 0,0:22:31.39,0:22:33.56,Default,,0,0,0,,Мера-чан, мені тартып шығар.
Dialogue: 0,0:22:33.64,0:22:34.18,Default,,0,0,0,,О
Dialogue: 0,0:22:34.26,0:22:37.27,Default,,0,0,0,,Ал... күте тұрыңыз, өтірік айтасыз! Эй!
Dialogue: 0,0:22:38.81,0:22:42.52,Default,,0,0,0,,Аа, дұрыс. Қайтадан Soul Society жүйесіне кірмеңіз.
Dialogue: 0,0:22:43.19,0:22:45.69,Default,,0,0,0,,Жан қоғамы - азғындардың елі
Dialogue: 0,0:22:45.78,0:22:50.16,Default,,0,0,0,,Занпакутосы жоқ қарапайым адамның кіруге құқығы жоқ.
Dialogue: 0,0:22:50.24,0:22:51.82,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:22:51.91,0:22:56.04,Default,,0,0,0,,Егер сізге осы уақытқа дейін келсеңіз және үйге қайтыңыз десе, сіз мойынсұнушылықпен үйге қайтамын деп ойлайсыз ба?
Dialogue: 0,0:22:56.54,0:22:59.71,Default,,0,0,0,,Қазір қайтып келсем, Зангецу не болады?
Dialogue: 0,0:23:00.21,0:23:02.88,Default,,0,0,0,,Қайтсем де, қайтпасам да жаныңда боламын.
Dialogue: 0,0:23:02.96,0:23:04.96,Default,,0,0,0,,Зангецу ешқашан қалпына келмейді
Dialogue: 0,0:23:05.05,0:23:07.71,Default,,0,0,0,,Жоқ... Мен оны түземеймін.
Dialogue: 0,0:23:09.22,0:23:09.84,Default,,0,0,0,,Мен саған айттым
Dialogue: 0,0:23:10.51,0:23:12.59,Default,,0,0,0,,19 8 7 6 5 дана
Dialogue: 0,0:23:12.68,0:23:15.89,Default,,0,0,0,,Соңында, үш бөлік, екі бөлік, Ван Юэ!
Dialogue: 0,0:23:15.97,0:23:19.35,Default,,0,0,0,,Өлімнің жалған құдайы ұстайтын қылыш жоқ.
Dialogue: 0,0:23:20.35,0:23:21.06,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:23:22.35,0:23:23.15,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:23.65,0:23:24.19,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:23:24.86,0:23:25.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:25.69,0:23:28.49,Default,,0,0,0,,Қош бол Ичиго-чан
Dialogue: 0,0:23:32.86,0:23:36.12,Default,,0,0,0,,Қазіргідей жақсы емес, Ичиго-чан.
Dialogue: 0,0:23:36.20,0:23:39.08,Default,,0,0,0,,Сіз тайыз соққышы ретінде таңдалмайтыныңызды білесіз.
Dialogue: 0,0:23:39.16,0:23:42.96,Default,,0,0,0,,Мен осы уақытқа дейін таяз шабуыл жасамай күресе алдым.
Dialogue: 0,0:23:43.04,0:23:46.50,Default,,0,0,0,,Мен қанша екенін білмеймін
Dialogue: 0,0:23:47.50,0:23:51.43,Default,,0,0,0,,Мен өз тамырыма қайта оралуым керек
Dialogue: 0,0:23:51.51,0:23:55.60,Default,,0,0,0,,Ал сіз өз тамырыңызды білуіңіз керек
Dialogue: 0,0:23:57.97,0:23:58.81,Default,,0,0,0,,Ха…
Dialogue: 0,0:23:59.73,0:24:04.90,Default,,0,0,0,,Тамырыңды біліп, қайтып келе алмасаң да
Dialogue: 0,0:24:08.98,0:24:11.15,Default,,0,0,0,,Сіз кінәсізсіз
Dialogue: 0,0:24:11.78,0:24:13.41,Default,,0,0,0,,Күн сияқты
Dialogue: 0,0:24:14.91,0:24:20.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
