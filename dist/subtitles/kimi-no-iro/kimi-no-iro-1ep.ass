Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:47.50,0:00:48.63,Default,,0,0,0,,Құдай
Dialogue: 0,0:00:49.34,0:00:52.34,Default,,0,0,0,,Өзгертуге болмайтын заттар туралы
Dialogue: 0,0:00:52.84,0:00:58.26,Default,,0,0,0,,Маған оны қабылдауға тыныштық беріңіз.
Dialogue: 0,0:01:02.18,0:01:03.56,Default,,0,0,0,,Аумин
Dialogue: 0,0:01:04.19,0:01:06.10,Default,,0,0,0,,Қадірлейік
Dialogue: 0,0:01:06.85,0:01:10.90,Default,,0,0,0,,Қолдар мұқият - ұзын мойын
Dialogue: 0,0:01:11.19,0:01:13.11,Default,,0,0,0,,Мұқият өтіңіз
Dialogue: 0,0:01:13.90,0:01:16.28,Default,,0,0,0,,Өкшеңіздің бағытына назар аударыңыз
Dialogue: 0,0:01:16.45,0:01:18.53,Default,,0,0,0,,Музыка әуенінен қалыс қалмаңыз
Dialogue: 0,0:01:19.03,0:01:20.95,Default,,0,0,0,,Басыңызды төмен түсіріңіз
Dialogue: 0,0:01:21.91,0:01:25.21,Default,,0,0,0,,Тірі ағзалардың түсті танитын мағынасы
Dialogue: 0,0:01:26.29,0:01:29.92,Default,,0,0,0,,Эволюция нәтижесінде алынған сияқты.
Dialogue: 0,0:01:31.05,0:01:35.22,Default,,0,0,0,,Жарық қабылдаған зат сол жарықтың түсін жұтады
Dialogue: 0,0:01:35.38,0:01:40.64,Default,,0,0,0,,Көздің тор қабығы арқылы миға түсті шағылыстырып, жеткізеді
Dialogue: 0,0:01:42.14,0:01:45.85,Default,,0,0,0,,Түстер жарық толқындары сияқты.
Dialogue: 0,0:01:46.89,0:01:47.69,Default,,0,0,0,,Қызыл алма
Dialogue: 0,0:01:48.90,0:01:50.31,Default,,0,0,0,,Жасыл жапырақтар
Dialogue: 0,0:01:51.27,0:01:52.48,Default,,0,0,0,,Көк балық
Dialogue: 0,0:01:53.36,0:01:57.82,Default,,0,0,0,,Әртүрлі ұзындықтағы жарық толқындары түрлі түсті пішіндерді жасайды
Dialogue: 0,0:02:00.28,0:02:01.03,Default,,0,0,0,,Шамасы
Dialogue: 0,0:02:03.83,0:02:08.04,Default,,0,0,0,,Дегенмен, мен сезінген «түс».
Dialogue: 0,0:02:08.71,0:02:13.59,Default,,0,0,0,,Мен оны басқа жерде де сезінемін.
Dialogue: 0,0:02:26.48,0:02:28.39,Default,,0,0,0,,Менің де қызғылт түсті болғым келеді
Dialogue: 0,0:02:28.98,0:02:30.86,Default,,0,0,0,,Накчан – мандариннің түсі.
Dialogue: 0,0:02:31.98,0:02:33.77,Default,,0,0,0,,Әдемі көк...
Dialogue: 0,0:02:35.19,0:02:39.61,Default,,0,0,0,,Көбелектер мен аралардың әдемі гүлдерді танитыны сияқты.
Dialogue: 0,0:02:40.70,0:02:44.37,Default,,0,0,0,,Дельфиндер адам ести алмайтын дыбыстарды естиді.
Dialogue: 0,0:02:46.20,0:02:51.04,Default,,0,0,0,,Сіз «көретін» немесе «сезетін» түстер бар.
Dialogue: 0,0:02:52.46,0:02:54.17,Default,,0,0,0,,Сіз әдемі «түс» сезінгенде
Dialogue: 0,0:02:56.09,0:02:58.34,Default,,0,0,0,,Мен өзімді өте қайғылы сезінемін.
Dialogue: 0,0:03:00.72,0:03:05.18,Default,,0,0,0,,Мен қиын нәрселерді түсінбеймін, бірақ
Dialogue: 0,0:03:18.36,0:03:22.20,Default,,0,0,0,,Егер сіз өз түсіңізді көре алсаңыз
Dialogue: 0,0:03:22.87,0:03:25.70,Default,,0,0,0,,Бұл қандай түс?
Dialogue: 0,0:03:33.29,0:03:36.67,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:03:37.67,0:03:39.63,Default,,0,0,0,,Қайырлы таң (2-оқушы) Қайырлы таң
Dialogue: 0,0:03:42.76,0:03:45.10,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:04:21.17,0:04:22.97,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:04:30.22,0:04:32.94,Default,,0,0,0,,Қайырлы таң (4-оқушы) Қайырлы таң
Dialogue: 0,0:04:42.24,0:04:44.70,Default,,0,0,0,,Қайырлы таң (6-оқушы) Қайырлы таң
Dialogue: 0,0:04:44.82,0:04:47.16,Default,,0,0,0,,Иә (8-оқушы) Мен де солай ойладым.
Dialogue: 0,0:04:55.71,0:04:59.04,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:04:59.80,0:05:02.21,Default,,0,0,0,,Шұғыл қоңырау
Dialogue: 0,0:05:02.34,0:05:05.51,Default,,0,0,0,,Келесі жолы кешігіп қалсам, бұл волонтерлік әрекет.
Dialogue: 0,0:05:05.63,0:05:06.68,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:13.10,0:05:14.89,Default,,0,0,0,,Жүгірме!
Dialogue: 0,0:05:15.44,0:05:16.98,Default,,0,0,0,,Қайырлы таң (Хиёсико апа) Тыныш болыңыз!
Dialogue: 0,0:05:17.10,0:05:18.56,Default,,0,0,0,,Жүгірме!!
Dialogue: 0,0:05:21.78,0:05:24.36,Default,,0,0,0,,Тыныш, сабырлы
Dialogue: 0,0:05:24.53,0:05:26.57,Default,,0,0,0,,Жүгірме!
Dialogue: 0,0:05:27.57,0:05:28.87,Default,,0,0,0,,Томоко!!
Dialogue: 0,0:05:29.87,0:05:31.12,Default,,0,0,0,,Иә!!
Dialogue: 0,0:05:33.04,0:05:35.54,Default,,0,0,0,,Хмм, мен оны уақытында жасадым.
Dialogue: 0,0:05:36.21,0:05:37.42,Default,,0,0,0,,Қауіпсіз
Dialogue: 0,0:05:37.75,0:05:39.42,Default,,0,0,0,,(Сумиканың гуілдеуі)
Dialogue: 0,0:05:40.13,0:05:41.88,Default,,0,0,0,,Ха... у...
Dialogue: 0,0:05:43.71,0:05:44.84,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:05:46.55,0:05:47.30,Default,,0,0,0,,Юкине, сен...
Dialogue: 0,0:05:47.68,0:05:49.89,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:50.39,0:05:52.47,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:59.40,0:06:02.27,Default,,0,0,0,,Сакунага мырза, сіз бұрын викторинаны қалай орындадыңыз?
Dialogue: 0,0:06:02.40,0:06:03.61,Default,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:06:03.86,0:06:05.19,Default,,0,0,0,,Е, тіпті Сакунага-сан!?
Dialogue: 0,0:06:06.57,0:06:07.65,Default,,0,0,0,,Бекіткіш шығып кетті.
Dialogue: 0,0:06:08.03,0:06:10.24,Default,,0,0,0,,Өткен күні мен 100 балл алдым.
Dialogue: 0,0:06:10.37,0:06:11.87,Default,,0,0,0,,Күтілгендей~
Dialogue: 0,0:06:12.12,0:06:14.41,Default,,0,0,0,,Бүгін? Мектептен кейінгі студенттер кеңесі?
Dialogue: 0,0:06:14.58,0:06:16.25,Default,,0,0,0,,Иә, мен сенімдімін.
Dialogue: 0,0:06:16.41,0:06:17.83,Default,,0,0,0,,Айқай~
Dialogue: 0,0:06:19.46,0:06:20.54,Default,,0,0,0,,Кими Сенпай
Dialogue: 0,0:06:20.96,0:06:23.30,Default,,0,0,0,,Хордың жаттығу кестесіне қатысты.
Dialogue: 0,0:06:23.59,0:06:25.71,Default,,0,0,0,,Менің талқылайтын нәрсем бар.
Dialogue: 0,0:06:25.84,0:06:27.26,Default,,0,0,0,,Иә, не болды?
Dialogue: 0,0:06:48.20,0:06:50.57,Default,,0,0,0,,Сізге ыңғайлы
Dialogue: 0,0:06:50.70,0:06:52.24,Default,,0,0,0,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,0:06:52.37,0:06:54.28,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:06:56.95,0:06:59.29,Default,,0,0,0,,Доджбол, солай ма?
Dialogue: 0,0:07:00.92,0:07:01.88,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:07:02.00,0:07:04.75,Default,,0,0,0,,(Қолдау дауыстары)
Dialogue: 0,0:07:07.17,0:07:08.55,Default,,0,0,0,,Кел, кел, кел
Dialogue: 0,0:07:10.30,0:07:11.97,Default,,0,0,0,,Тигіз!
Dialogue: 0,0:07:17.43,0:07:18.64,Default,,0,0,0,,...
Dialogue: 0,0:07:24.02,0:07:25.07,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:07:29.24,0:07:30.20,Default,,0,0,0,,Кесу...
Dialogue: 0,0:07:30.82,0:07:31.82,Default,,0,0,0,,Бірақ
Dialogue: 0,0:07:33.45,0:07:34.45,Default,,0,0,0,,Тоцуко!!
Dialogue: 0,0:07:34.95,0:07:35.66,Default,,0,0,0,,Ха
Dialogue: 0,0:07:39.04,0:07:41.29,Default,,0,0,0,,Тоцуко, жақсысың ба?
Dialogue: 0,0:07:41.46,0:07:42.04,Default,,0,0,0,,Ха
Dialogue: 0,0:07:42.92,0:07:45.04,Default,,0,0,0,,Амансың ба? (Тоцуко) Гугу...
Dialogue: 0,0:07:46.34,0:07:47.50,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:07:48.30,0:07:50.88,Default,,0,0,0,,Тоцуко!! Эй, оян!
Dialogue: 0,0:07:51.01,0:07:51.93,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:52.26,0:07:54.14,Default,,0,0,0,,Көріскенше~ (2-оқушы) Кездескенше~
Dialogue: 0,0:07:54.26,0:07:56.35,Default,,0,0,0,,Егер жаттығу жасамасаңыз, сіз тек Shinai (Тано) қолдана аласыз!
Dialogue: 0,0:07:56.47,0:07:58.56,Default,,0,0,0,,20 минут жаяу!? (6-оқушы) Сәттілік!
Dialogue: 0,0:08:20.70,0:08:22.16,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:08:22.79,0:08:23.50,Default,,0,0,0,,Хмм?
Dialogue: 0,0:08:53.45,0:08:56.99,Default,,0,0,0,,(Гитара шкаласының орындау дыбысы)
Dialogue: 0,0:09:00.41,0:09:03.08,Default,,0,0,0,,Хэхе... Хэхе...
Dialogue: 0,0:09:03.66,0:09:05.54,Default,,0,0,0,,Токко Дошитан
Dialogue: 0,0:09:05.92,0:09:10.34,Default,,0,0,0,,А, иә, мен оның жарқырағанын сеземін...
Dialogue: 0,0:09:12.09,0:09:15.22,Default,,0,0,0,,Сіз PE-де тым көп ақылыңызды жоғалттыңыз ба?
Dialogue: 0,0:09:15.34,0:09:16.68,Default,,0,0,0,,Иә, бар.
Dialogue: 0,0:09:21.31,0:09:22.81,Default,,0,0,0,,Хаа... хаа...
Dialogue: 0,0:09:22.93,0:09:24.94,Default,,0,0,0,,Үлкен... күшті? Кешіріңіз...
Dialogue: 0,0:09:25.10,0:09:29.27,Default,,0,0,0,,Жарайды, шынымен де жақсы
Dialogue: 0,0:09:29.40,0:09:30.19,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:09:30.44,0:09:31.78,Default,,0,0,0,,Дехехе…
Dialogue: 0,0:09:32.69,0:09:35.61,Default,,0,0,0,,Басу… итеру… хмм…
Dialogue: 0,0:09:35.78,0:09:36.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:04.22,0:10:08.73,Default,,0,0,0,,Сакунага мырза жоғалып кетті.
Dialogue: 0,0:10:08.90,0:10:11.19,Default,,0,0,0,,Nja кафе шешілді! (Йосимару) Мен келісемін!
Dialogue: 0,0:10:18.11,0:10:22.74,Default,,0,0,0,,(♪ «Massy Fukaki» хорының әні)
Dialogue: 0,0:10:29.46,0:10:31.79,Default,,0,0,0,,Бүгінгі сырттай оқыту Бұл әдеттегіден басқа кабинет, солай емес пе?
Dialogue: 0,0:10:31.92,0:10:32.79,Default,,0,0,0,,Ах (Такебаяши) Солай ма?
Dialogue: 0,0:10:32.92,0:10:34.17,Default,,0,0,0,,Мұғалім осылай деді.
Dialogue: 0,0:10:34.30,0:10:35.67,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:10:36.34,0:10:37.51,Default,,0,0,0,,Ум...
Dialogue: 0,0:10:38.80,0:10:45.18,Default,,0,0,0,,Кими Сакунага, мен сені соңғы кездері көрмей қалдым... Қызық, үзіліс жасап жатырсың ба әлде бірдеңе?
Dialogue: 0,0:10:46.02,0:10:50.19,Default,,0,0,0,,Білмейсіз бе? Кими Чан, сен мектепті тастадың.
Dialogue: 0,0:10:50.31,0:10:52.48,Default,,0,0,0,,Біз де таң қалдық.
Dialogue: 0,0:10:53.48,0:10:54.61,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:54.86,0:10:57.07,Default,,0,0,0,,Ұстазыңызға қарсы шықтыңыз ба?
Dialogue: 0,0:10:57.44,0:10:59.86,Default,,0,0,0,,Менің бір баламен кездесіп жүргенім анықталды...
Dialogue: 0,0:11:01.37,0:11:03.20,Default,,0,0,0,,Түрлі қауесеттер...
Dialogue: 0,0:11:03.49,0:11:04.91,Default,,0,0,0,,Бар.
Dialogue: 0,0:11:05.37,0:11:08.50,Default,,0,0,0,,Жақында хордың қатысатын концерті бар...
Dialogue: 0,0:11:08.62,0:11:10.37,Default,,0,0,0,,Сонымен... әзірге
Dialogue: 0,0:11:11.12,0:11:12.54,Default,,0,0,0,,Сен оны білесің бе?
Dialogue: 0,0:11:36.36,0:11:39.57,Default,,0,0,0,,Эй, мен сені өткен күні көрдім деп ойлаймын.
Dialogue: 0,0:11:39.69,0:11:42.45,Default,,0,0,0,,Өтірік. Қайда?
Dialogue: 0,0:11:42.57,0:11:45.08,Default,,0,0,0,,Сауда ауданында... кітап дүкені
Dialogue: 0,0:11:45.20,0:11:47.37,Default,,0,0,0,,Мүмкін ол кассада болған шығар.
Dialogue: 0,0:12:20.24,0:12:21.53,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:12:22.74,0:12:23.95,Default,,0,0,0,,Құдай
Dialogue: 0,0:12:24.32,0:12:26.78,Default,,0,0,0,,Өзгертуге болмайтын заттар туралы
Dialogue: 0,0:12:27.24,0:12:32.04,Default,,0,0,0,,Маған оны қабылдауға тыныштық беріңіз.
Dialogue: 0,0:12:32.91,0:12:34.04,Default,,0,0,0,,Аумин
Dialogue: 0,0:12:35.54,0:12:37.04,Default,,0,0,0,,Аумин
Dialogue: 0,0:12:38.25,0:12:39.55,Default,,0,0,0,,Хиёсико Сенсэй...
Dialogue: 0,0:12:42.34,0:12:43.72,Default,,0,0,0,,Хигураши мырза
Dialogue: 0,0:12:44.47,0:12:47.47,Default,,0,0,0,,Нибурдың дұғасының сөздері жалғасады.
Dialogue: 0,0:12:50.52,0:12:54.90,Default,,0,0,0,,«Өзгертуге болатын нәрселерді өзгертуге батылдық танытыңыз».
Dialogue: 0,0:12:55.40,0:12:58.77,Default,,0,0,0,,«Нені өзгертуге болады және нені өзгертуге болмайды»
Dialogue: 0,0:12:58.90,0:13:01.36,Default,,0,0,0,,«Маған ажырата алатын даналық бер».
Dialogue: 0,0:13:02.44,0:13:03.57,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:13:05.57,0:13:08.53,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:13:09.49,0:13:13.50,Default,,0,0,0,,Ең алдымен жан тыныштығын қалаймын.
Dialogue: 0,0:13:14.16,0:13:15.96,Default,,0,0,0,,Сіз бір нәрсеге алаңдайсыз ба?
Dialogue: 0,0:13:17.83,0:13:18.67,Default,,0,0,0,,Егер мойындау қажет болса...
Dialogue: 0,0:13:18.96,0:13:20.34,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:22.05,0:13:24.01,Default,,0,0,0,,Хиёсико Сенсей
Dialogue: 0,0:13:26.13,0:13:28.64,Default,,0,0,0,,Сізде әдемі түстер бар.
Dialogue: 0,0:13:32.31,0:13:33.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:33.31,0:13:36.56,Default,,0,0,0,,Кешіріңіз, бұл ештеңе емес...
Dialogue: 0,0:13:36.69,0:13:37.48,Default,,0,0,0,,Сиқыршы культішілер.
Dialogue: 0,0:13:37.98,0:13:39.94,Default,,0,0,0,,Хун хун хун хун...
Dialogue: 0,0:13:42.32,0:13:45.24,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:13:48.32,0:13:49.62,Default,,0,0,0,,Бұл үшін тағы да кешіріңіз.
Dialogue: 0,0:13:49.74,0:13:52.12,Default,,0,0,0,,Бұл жақсы~
Dialogue: 0,0:13:53.20,0:13:54.33,Default,,0,0,0,,Дәмді
Dialogue: 0,0:13:54.45,0:13:56.75,Default,,0,0,0,,Токко Дошитан
Dialogue: 0,0:13:57.25,0:13:58.17,Default,,0,0,0,,Қызу!
Dialogue: 0,0:13:58.29,0:14:00.84,Default,,0,0,0,,А, жоқ, ештеңе.
Dialogue: 0,0:14:01.13,0:14:02.30,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:14:02.75,0:14:05.05,Default,,0,0,0,,Тамақ ішпеңіз. Ол жақсы.
Dialogue: 0,0:14:05.42,0:14:08.30,Default,,0,0,0,,Рахмет саған, Орманның үш әпкесі
Dialogue: 0,0:14:08.43,0:14:11.76,Default,,0,0,0,,Иә? (Тоцуко) Бұл «түс» сияқты...
Dialogue: 0,0:14:11.89,0:14:14.72,Default,,0,0,0,,Атмосфера емес пе? Бірақ...
Dialogue: 0,0:14:15.23,0:14:18.48,Default,,0,0,0,,Сабырлы және жұмсақ...
Dialogue: 0,0:14:18.60,0:14:20.19,Default,,0,0,0,,Сабыр?
Dialogue: 0,0:14:20.69,0:14:22.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:23.28,0:14:25.49,Default,,0,0,0,,Әже келе жатыр.
Dialogue: 0,0:14:27.45,0:14:30.78,Default,,0,0,0,,Үстел үстіндегі түскі ас қорабына қош келдіңіздер.
Dialogue: 0,0:14:31.49,0:14:33.54,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:15:06.36,0:15:07.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:09.95,0:15:12.37,Default,,0,0,0,,Қайырлы күн
Dialogue: 0,0:15:13.16,0:15:14.62,Default,,0,0,0,,Әй, біз бүгін не істейміз?
Dialogue: 0,0:15:27.51,0:15:30.51,Default,,0,0,0,,(♪ «Ave Maria» гитара орындауындағы дыбыс)
Dialogue: 0,0:15:47.40,0:15:50.32,Default,,0,0,0,,Юта~! (2-бала) Күте тұрыңыз, Юта!
Dialogue: 0,0:15:50.45,0:15:52.07,Default,,0,0,0,,Күтіңіз~ (2 бала) Хаха
Dialogue: 0,0:15:52.49,0:15:55.33,Default,,0,0,0,,Ей, қорап жоқ.
Dialogue: 0,0:15:55.58,0:15:57.62,Default,,0,0,0,,Ах, бұл өте жақсы!
Dialogue: 0,0:15:57.74,0:16:00.83,Default,,0,0,0,,Иә? Бірақ жағдай жақсы.
Dialogue: 0,0:16:01.00,0:16:02.17,Default,,0,0,0,,Иә
Dialogue: 0,0:16:04.00,0:16:05.84,Default,,0,0,0,,Иә, рахмет.
Dialogue: 0,0:16:12.09,0:16:13.30,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:16:21.35,0:16:25.77,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:16:29.61,0:16:31.03,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:16:39.16,0:16:41.37,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:16:42.41,0:16:44.54,Default,,0,0,0,,Сіз шытырман оқиғаға барасыз ба?
Dialogue: 0,0:16:46.54,0:16:49.84,Default,,0,0,0,,Мен біреуді іздеп жүрмін.
Dialogue: 0,0:17:18.28,0:17:19.33,Default,,0,0,0,,Ах
Dialogue: 0,0:17:36.93,0:17:37.97,Default,,0,0,0,,болды
Dialogue: 0,0:17:39.39,0:17:40.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:41.14,0:17:42.77,Default,,0,0,0,,Бұл кітап дүкені.
Dialogue: 0,0:17:43.89,0:17:48.73,Default,,0,0,0,,(♪ «Ave Maria» гитарасының дыбысы және сіздің ызылдағаныңыз)
Dialogue: 0,0:18:01.08,0:18:02.62,Default,,0,0,0,,Бұл ән...
Dialogue: 0,0:18:25.31,0:18:26.52,Default,,0,0,0,,Табылды...
Dialogue: 0,0:18:29.44,0:18:30.15,Default,,0,0,0,,Ха
Dialogue: 0,0:18:30.69,0:18:33.07,Default,,0,0,0,,Ах! Ах, сол
Dialogue: 0,0:18:33.36,0:18:34.98,Default,,0,0,0,,Егер сіз кездейсоқ кірсеңіз...
Dialogue: 0,0:18:35.61,0:18:36.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:36.86,0:18:41.16,Default,,0,0,0,,Дұрыс, мынау, мынау, мынаны іздеп жүрмін.
Dialogue: 0,0:18:41.57,0:18:44.83,Default,,0,0,0,,Ия, мен оны таптым!
Dialogue: 0,0:18:45.20,0:18:48.00,Default,,0,0,0,,Аа, мен өте қуаныштымын.
Dialogue: 0,0:18:48.83,0:18:50.33,Default,,0,0,0,,Мынаны маған бер!
Dialogue: 0,0:18:52.17,0:18:54.30,Default,,0,0,0,,Фортепианода ойнау
Dialogue: 0,0:18:54.42,0:18:56.80,Default,,0,0,0,,А, м...
Dialogue: 0,0:18:57.55,0:18:58.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:00.47,0:19:03.56,Default,,0,0,0,,Сакунага мырза гитарада ойнайды ма?
Dialogue: 0,0:19:03.93,0:19:05.81,Default,,0,0,0,,Иә, жаттығу
Dialogue: 0,0:19:06.02,0:19:08.69,Default,,0,0,0,,Әй, бұл керемет.
Dialogue: 0,0:19:09.10,0:19:13.19,Default,,0,0,0,,А, кешіріңіз, дене шынықтыру сабағында.
Dialogue: 0,0:19:13.31,0:19:14.69,Default,,0,0,0,,Сенгісіз!
Dialogue: 0,0:19:14.98,0:19:18.19,Default,,0,0,0,,Маған бұрынғы ән ұнайды.
Dialogue: 0,0:19:18.36,0:19:21.70,Default,,0,0,0,,А... Мен үнемі хорда ән айтатынмын.
Dialogue: 0,0:19:22.74,0:19:23.95,Default,,0,0,0,,ол маған шексіз артықшылық беретін қаруға айналады.
Dialogue: 0,0:19:29.16,0:19:32.46,Default,,0,0,0,,Сакунага мырза қазірдің өзінде мектепте...
Dialogue: 0,0:19:36.00,0:19:38.05,Default,,0,0,0,,Мм...
Dialogue: 0,0:19:39.17,0:19:40.38,Default,,0,0,0,,Умм
Dialogue: 0,0:19:41.72,0:19:42.89,Default,,0,0,0,,♪ Вуф-вуф, вуф-вуф
Dialogue: 0,0:19:43.05,0:19:44.22,Default,,0,0,0,,Иә
Dialogue: 0,0:19:44.93,0:19:48.47,Default,,0,0,0,,Екеуіңіз топтасыз ба?
Dialogue: 0,0:19:48.60,0:19:51.77,Default,,0,0,0,,Иә, біз сондаймыз!?
Dialogue: 0,0:19:52.73,0:19:58.28,Default,,0,0,0,,Мен әрқашан гитарада ойнаймын, сондықтан мүмкін деп ойладым
Dialogue: 0,0:19:59.94,0:20:04.37,Default,,0,0,0,,Кенет өзгергенім үшін кешіріңіз, мен бір күні бірдеңе айтайын деп едім.
Dialogue: 0,0:20:09.37,0:20:14.92,Default,,0,0,0,,Шындығында, біз қазір топ мүшелерін жинап жатырмыз.
Dialogue: 0,0:20:15.59,0:20:19.67,Default,,0,0,0,,Біздің топқа қосылғыңыз келе ме?
Dialogue: 0,0:20:25.05,0:20:27.10,Default,,0,0,0,,Мен аһ, бірақ
Dialogue: 0,0:20:27.26,0:20:30.56,Default,,0,0,0,,Мен мұны әлі де өз күшіммен істегендей сезінемін.
Dialogue: 0,0:20:30.68,0:20:33.23,Default,,0,0,0,,Иә? Дәлірек айтқанда, сен ұл емессің бе?
Dialogue: 0,0:20:33.35,0:20:34.23,Default,,0,0,0,,Аумин
Dialogue: 0,0:20:34.44,0:20:36.44,Default,,0,0,0,,Амансың ба? (Тоцуко) Мм...
Dialogue: 0,0:20:38.27,0:20:39.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:40.61,0:20:44.61,Default,,0,0,0,,Кешіріңіз, Сакунага мырза, егер сізге ұнамаса, жақсы.
Dialogue: 0,0:20:44.78,0:20:45.78,Default,,0,0,0,,Бірақ бұл қызық болады...
Dialogue: 0,0:20:45.91,0:20:46.62,Default,,0,0,0,,Мен мұны істегім келеді
Dialogue: 0,0:20:46.91,0:20:48.70,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:12.23,0:21:14.89,Default,,0,0,0,,Эй Хигураши-сан, сыртқа қара.
Dialogue: 0,0:21:15.23,0:21:16.81,Default,,0,0,0,,Өте әдемі...
Dialogue: 0,0:21:17.02,0:21:17.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:18.15,0:21:19.73,Default,,0,0,0,,Иә
Dialogue: 0,0:21:19.98,0:21:21.32,Default,,0,0,0,,Не болды!?
Dialogue: 0,0:21:21.69,0:21:22.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:22.94,0:21:27.20,Default,,0,0,0,,Эй... Мен сәл ғана маспын...
Dialogue: 0,0:21:28.28,0:21:29.03,Default,,0,0,0,,Мынадай...
Dialogue: 0,0:21:30.16,0:21:30.99,Default,,0,0,0,,Жақсысың ба!?
Dialogue: 0,0:21:32.66,0:21:34.66,Default,,0,0,0,,Су... Менде бар...
Dialogue: 0,0:21:36.33,0:21:38.17,Default,,0,0,0,,Біраз жатқыңыз келе ме?
Dialogue: 0,0:21:40.09,0:21:42.13,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:21:42.46,0:21:43.59,Default,,0,0,0,,Иә
Dialogue: 0,0:21:45.17,0:21:47.51,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:21:48.30,0:21:51.31,Default,,0,0,0,,(Тоцуконың ауыр тыныс алуы)
Dialogue: 0,0:21:54.39,0:21:55.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:56.35,0:21:58.23,Default,,0,0,0,,Радиотолқындар жоқ...
Dialogue: 0,0:21:58.40,0:22:01.32,Default,,0,0,0,,(теңіз спрейінің дыбысы)
Dialogue: 0,0:22:04.32,0:22:07.24,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:22:07.36,0:22:09.07,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:22:09.91,0:22:11.49,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:22:11.70,0:22:14.79,Default,,0,0,0,,Хаха! Эй!
Dialogue: 0,0:22:15.33,0:22:18.29,Default,,0,0,0,,Мен қуаныштымын. Мен сені шынымен келер деп ойламадым.
Dialogue: 0,0:22:18.42,0:22:21.00,Default,,0,0,0,,Жол бойында радио толқындары маған жетуді тоқтатты.
Dialogue: 0,0:22:21.84,0:22:24.38,Default,,0,0,0,,Хигураши мырза, жақсысыз ба?
Dialogue: 0,0:22:24.59,0:22:27.72,Default,,0,0,0,,Таза ауа алуға бола ма?
Dialogue: 0,0:22:31.72,0:22:34.02,Default,,0,0,0,,Келіңіз.
Dialogue: 0,0:22:35.22,0:22:39.35,Default,,0,0,0,,Бұл енді пайдаланылмайтын шіркеу.
Dialogue: 0,0:22:39.48,0:22:43.07,Default,,0,0,0,,Бұл өте маңызды ғимарат, сондықтан ол сақталған.
Dialogue: 0,0:22:43.65,0:22:46.99,Default,,0,0,0,,Менің шартым мына жерді тазалаймын.
Dialogue: 0,0:22:47.20,0:22:49.41,Default,,0,0,0,,Маған оны жасырын түрде пайдалануға рұқсат етілген.
Dialogue: 0,0:22:58.21,0:22:59.29,Default,,0,0,0,,Керемет…
Dialogue: 0,0:22:59.71,0:23:00.75,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:23:01.58,0:23:04.42,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:23:22.02,0:23:24.07,Default,,0,0,0,,(Термин үні)
Dialogue: 0,0:23:34.41,0:23:35.66,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:23:39.91,0:23:43.92,Default,,0,0,0,,(♪ «Ave Maria» орындау дыбысы)
Dialogue: 0,0:24:00.60,0:24:02.60,Default,,0,0,0,,(Сөмкені ашқан дыбыс)
Dialogue: 0,0:24:08.61,0:24:12.53,Default,,0,0,0,,(Сөмкенің ішіндегісін түрткен дыбыс)
Dialogue: 0,0:24:21.66,0:24:24.88,Default,,0,0,0,,(гитара мен онда орындалатын дыбыс)
Dialogue: 0,0:24:27.75,0:24:28.84,Default,,0,0,0,,Ха…
Dialogue: 0,0:24:52.03,0:24:53.03,Default,,0,0,0,,Ваниль
Dialogue: 0,0:24:53.20,0:24:54.20,Default,,0,0,0,,Хош иісті жаңғақтар
Dialogue: 0,0:24:54.32,0:24:55.45,Default,,0,0,0,,Шоколадты жалбыз
Dialogue: 0,0:25:00.58,0:25:02.71,Default,,0,0,0,,Супер балмұздақ
Dialogue: 0,0:25:02.87,0:25:05.29,Default,,0,0,0,,Не? Топ аты?
Dialogue: 0,0:25:05.67,0:25:06.63,Default,,0,0,0,,Иә
Dialogue: 0,0:25:09.75,0:25:12.22,Default,,0,0,0,,Иә, еркіндік жақсы болуы мүмкін.
Dialogue: 0,0:25:12.51,0:25:15.84,Default,,0,0,0,,Өте жақсы және біршама күшті
Dialogue: 0,0:25:16.55,0:25:20.18,Default,,0,0,0,,Ах, Кагехира-кун, сен бұрын қандай аспап туралы айтып едің...
Dialogue: 0,0:25:20.31,0:25:21.35,Default,,0,0,0,,Ондамин
Dialogue: 0,0:25:21.52,0:25:23.23,Default,,0,0,0,,Эй
Dialogue: 0,0:25:29.86,0:25:33.57,Default,,0,0,0,,Кешіріңіз, мен ұлдармен сөйлесуге дағдыланбадым.
Dialogue: 0,0:25:33.69,0:25:36.45,Default,,0,0,0,,Бұл ақылға сыйымсыз деп ойламайсыз ба?
Dialogue: 0,0:25:36.57,0:25:39.33,Default,,0,0,0,,Парасатты болу қандай сезімде болады?
Dialogue: 0,0:25:39.45,0:25:41.41,Default,,0,0,0,,Аа, қазір сияқты.
Dialogue: 0,0:25:41.58,0:25:42.91,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:25:43.08,0:25:44.41,Default,,0,0,0,,Сол сияқты
Dialogue: 0,0:25:46.33,0:25:47.12,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:25:49.04,0:25:53.09,Default,,0,0,0,,Ки... Мен сені Кими-чан деп атасам бола ма? Кана
Dialogue: 0,0:25:54.22,0:25:55.26,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:25:58.64,0:26:00.76,Default,,0,0,0,,Ал Луи-кун!
Dialogue: 0,0:26:01.43,0:26:02.60,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:26:03.77,0:26:04.60,Default,,0,0,0,,Ах
Dialogue: 0,0:26:07.90,0:26:09.31,Default,,0,0,0,,Кеме жақында келеді.
Dialogue: 0,0:26:17.57,0:26:18.61,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:26:18.74,0:26:19.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:20.62,0:26:25.37,Default,,0,0,0,,Негізі мен пианинода онша жақсы емеспін.
Dialogue: 0,0:26:29.04,0:26:31.25,Default,,0,0,0,,Мен сенің көңіліңді қалдыруым мүмкін.
Dialogue: 0,0:26:31.67,0:26:35.55,Default,,0,0,0,,Мен гитарамен жаңадан айналысып жатырмын.
Dialogue: 0,0:26:36.63,0:26:39.01,Default,,0,0,0,,Өйткені ағам әйтеуір сонда қалдырған
Dialogue: 0,0:26:39.30,0:26:41.64,Default,,0,0,0,,Ой, сенің үлкен ағаң бар.
Dialogue: 0,0:26:41.80,0:26:44.64,Default,,0,0,0,,Иә, мен жұмысқа кеттім.
Dialogue: 0,0:26:44.81,0:26:45.98,Default,,0,0,0,,Эй
Dialogue: 0,0:26:52.11,0:26:54.48,Default,,0,0,0,,Мен келесі аптада бірдеңе жаттығамын.
Dialogue: 0,0:26:57.15,0:27:01.28,Default,,0,0,0,,Тәжірибе жасасақ, нағыз топтағы сияқты неше түрлі әндер шығара аламыз.
Dialogue: 0,0:27:01.41,0:27:04.87,Default,,0,0,0,,Нағыз топтың не екенін білмеймін, бірақ хехе
Dialogue: 0,0:27:13.63,0:27:16.67,Default,,0,0,0,,Жақында кездескенше, Кими-чан.
Dialogue: 0,0:27:16.92,0:27:18.05,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:27:18.26,0:27:20.63,Default,,0,0,0,,Иә, сонда
Dialogue: 0,0:27:40.07,0:27:41.32,Default,,0,0,0,,Өтірік
Dialogue: 0,0:27:41.45,0:27:42.66,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:27:43.49,0:27:45.03,Default,,0,0,0,,Бұл жабайы мысық емес пе еді?
Dialogue: 0,0:27:45.16,0:27:46.91,Default,,0,0,0,,Жоқ, жоқ, бұл дұрыс емес.
Dialogue: 0,0:27:47.04,0:27:49.33,Default,,0,0,0,,Хаха, мен сенемін.
Dialogue: 0,0:27:49.46,0:27:50.71,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:27:58.26,0:27:59.30,Default,,0,0,0,,Хмм
Dialogue: 0,0:27:59.42,0:28:00.67,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:28:01.55,0:28:05.10,Default,,0,0,0,,Қайтадан қош келдіңіз, кешкі ас біраз уақыт алады.
Dialogue: 0,0:28:05.22,0:28:06.22,Default,,0,0,0,,Иә
Dialogue: 0,0:28:07.81,0:28:11.19,Default,,0,0,0,,Кими-чан, бұл хормен жаттығу болды ма?
Dialogue: 0,0:28:11.31,0:28:14.15,Default,,0,0,0,,Шын мәнінде емес, бірақ аздап.
Dialogue: 0,0:28:14.27,0:28:14.94,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:28:15.69,0:28:16.90,Default,,0,0,0,,Ол өзгереді
Dialogue: 0,0:28:17.07,0:28:18.36,Default,,0,0,0,,Иә
Dialogue: 0,0:28:20.53,0:28:22.82,Default,,0,0,0,,Иә, дәмді болды.
Dialogue: 0,0:28:23.11,0:28:26.78,Default,,0,0,0,,Мен сені де тамақтандырайын ба?
Dialogue: 0,0:28:29.12,0:28:31.25,Default,,0,0,0,,Әже, сіз білесіз бе?
Dialogue: 0,0:28:32.25,0:28:33.21,Default,,0,0,0,,Оны ұмытып қалдың ба?
Dialogue: 0,0:28:34.25,0:28:36.17,Default,,0,0,0,,Әй, бұл ештеңе емес.
Dialogue: 0,0:28:37.17,0:28:40.05,Default,,0,0,0,,Аа, дұрыс, біркелкі.
Dialogue: 0,0:28:40.46,0:28:45.39,Default,,0,0,0,,Жақында жазғы киімдер келеді, солай ма? Мен көктемгі киімімді тазалауым керек.
Dialogue: 0,0:28:45.51,0:28:46.51,Default,,0,0,0,,Иә
Dialogue: 0,0:28:46.64,0:28:51.73,Default,,0,0,0,,Әжемен бірдей форма киюге болмайды.
Dialogue: 0,0:28:51.85,0:28:53.14,Default,,0,0,0,,Иә
Dialogue: 0,0:29:31.39,0:29:35.27,Default,,0,0,0,,Қызық, Луи-кун дыбыстарды ести алады ма?
Dialogue: 0,0:29:37.10,0:29:39.61,Default,,0,0,0,,Мен бір нәрсені байқап көргім келеді
Dialogue: 0,0:29:42.07,0:29:43.32,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:29:43.78,0:29:46.11,Default,,0,0,0,,Сіз өз әндеріңізді жазасыз ба?
Dialogue: 0,0:29:46.32,0:29:47.74,Default,,0,0,0,,Иә
Dialogue: 0,0:29:47.99,0:29:50.78,Default,,0,0,0,,Сіз мұны істей аласыз ба!? Сіз жасай аласыз ба?
Dialogue: 0,0:29:50.91,0:29:52.91,Default,,0,0,0,,Мен бірдеңе істей алатындай сезінемін
Dialogue: 0,0:29:53.87,0:29:57.21,Default,,0,0,0,,Иә, мен Луи-кун жазған әнді тыңдағым келеді.
Dialogue: 0,0:29:58.29,0:29:59.67,Default,,0,0,0,,Оны да екі адам жасайды.
Dialogue: 0,0:29:59.84,0:30:00.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:08.01,0:30:10.80,Default,,0,0,0,,Сіздің де ән жазғаныңызды естідім, солай ма?
Dialogue: 0,0:30:10.93,0:30:14.98,Default,,0,0,0,,Иә, мені қызықтырады, мен оны көргім келеді.
Dialogue: 0,0:30:15.10,0:30:18.23,Default,,0,0,0,,Бұл таңқаларлық. Мен көбірек тырысуым керек.
Dialogue: 0,0:30:18.98,0:30:20.31,Default,,0,0,0,,Тоцуко да?
Dialogue: 0,0:30:20.48,0:30:21.77,Default,,0,0,0,,Уау
Dialogue: 0,0:30:24.57,0:30:26.70,Default,,0,0,0,,Луи-кун, не болды?
Dialogue: 0,0:30:26.82,0:30:29.28,Default,,0,0,0,,Хмм, ештеңе жоқ.
Dialogue: 0,0:30:29.95,0:30:33.91,Default,,0,0,0,,Келесі жексенбіде кездескенше...
Dialogue: 0,0:30:37.41,0:30:40.75,Default,,0,0,0,,(Жел мен қайық моторының дыбысы)
Dialogue: 0,0:30:42.38,0:30:44.55,Default,,0,0,0,,Мүмкін бұл сенің анаң шығар.
Dialogue: 0,0:30:46.13,0:30:49.43,Default,,0,0,0,,Мүмкін олар біздің көрінгенімізді қаламаған шығар.
Dialogue: 0,0:30:49.97,0:30:56.06,Default,,0,0,0,,Мені де біреу көрсе, жаман болмай ма? Менің мектебім ер-әйел қарым-қатынасына жол бермейді.
Dialogue: 0,0:30:56.73,0:31:00.98,Default,,0,0,0,,Сол себепті мен бір бөлмедегі қызға мен барлық қыздар тобында екенімді айтамын.
Dialogue: 0,0:31:01.40,0:31:06.49,Default,,0,0,0,,Ах, бұл мен тәубеге келуді сұрайтын жағдай болуы мүмкін.
Dialogue: 0,0:31:06.90,0:31:09.36,Default,,0,0,0,,Қайтып келе сала соборға барайық...
Dialogue: 0,0:31:11.20,0:31:14.70,Default,,0,0,0,,Кешіріңіз, мен мектеп туралы айтқанды ұнатпаймын.
Dialogue: 0,0:31:14.83,0:31:17.00,Default,,0,0,0,,Хмм, бұл туралы алаңдамаңыз.
Dialogue: 0,0:31:19.25,0:31:21.50,Default,,0,0,0,,Ән шығарсам
Dialogue: 0,0:31:23.79,0:31:24.80,Default,,0,0,0,,Күннің айналасында -
Dialogue: 0,0:31:24.80,0:31:26.42,Default,,0,0,0,,Күнді айнала -
Dialogue: 0,0:31:24.80,0:31:26.42,Default,,0,0,0,,Ән шығарсам
Dialogue: 0,0:31:26.59,0:31:29.22,Default,,0,0,0,,«Түсіңді» дыбысқа айналдырғым келеді
Dialogue: 0,0:31:26.59,0:31:29.22,Default,,0,0,0,,Аспан денелерінің барлық түрлері бар.
Dialogue: 0,0:31:29.84,0:31:30.80,Default,,0,0,0,,Ақырында
Dialogue: 0,0:31:30.93,0:31:32.09,Default,,0,0,0,,Планета деп аталады.
Dialogue: 0,0:31:32.22,0:31:34.89,Default,,0,0,0,,Түсіңіз өте әдемі...
Dialogue: 0,0:31:32.22,0:31:34.89,Default,,0,0,0,,Жерді қосқанда сегіз аспан денесі бар.
Dialogue: 0,0:31:34.89,0:31:35.31,Default,,0,0,0,,Жерді қосқанда сегіз аспан денесі бар.
Dialogue: 0,0:31:35.31,0:31:36.22,Default,,0,0,0,,Жерді қосқанда сегіз аспан денесі бар.
Dialogue: 0,0:31:35.31,0:31:36.22,Default,,0,0,0,,Толқу сезімі...
Dialogue: 0,0:31:36.35,0:31:38.81,Default,,0,0,0,,Сіз шыдай алмайсыз
Dialogue: 0,0:31:36.35,0:31:38.81,Default,,0,0,0,,Күнді айналады.
Dialogue: 0,0:31:39.02,0:31:39.56,Default,,0,0,0,,Бұл революция деп аталады
Dialogue: 0,0:31:39.56,0:31:41.35,Default,,0,0,0,,Бұл революция деп аталады
Dialogue: 0,0:31:39.56,0:31:41.35,Default,,0,0,0,,Күннің айналасында...
Dialogue: 0,0:31:41.85,0:31:43.11,Default,,0,0,0,,Таза
Dialogue: 0,0:31:43.23,0:31:44.40,Default,,0,0,0,,Сен
Dialogue: 0,0:31:44.52,0:31:46.23,Default,,0,0,0,,Барған сайын ұйқым қашып барады
Dialogue: 0,0:31:46.36,0:31:46.90,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:31:46.90,0:31:49.49,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:31:46.90,0:31:49.49,Default,,0,0,0,,Мен, Тоцуко, біртіндеп
Dialogue: 0,0:31:49.49,0:31:49.61,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:31:49.61,0:31:51.66,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:31:49.61,0:31:51.66,Default,,0,0,0,,Мен ғаламның арғы жағына барамын
Dialogue: 0,0:32:01.62,0:32:06.09,Default,,0,0,0,,...Ол бұрын болған үлкен жарылыстан туған.
Dialogue: 0,0:32:06.96,0:32:08.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:08.21,0:32:09.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:09.72,0:32:13.39,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:32:15.93,0:32:17.06,Default,,0,0,0,,(басылған жарық қосқышының дыбысы)
Dialogue: 0,0:32:18.39,0:32:19.81,Default,,0,0,0,,Ха
Dialogue: 0,0:32:28.19,0:32:31.53,Default,,0,0,0,,Түсіңіз өте әдемі.
Dialogue: 0,0:32:34.57,0:32:37.28,Default,,0,0,0,,Мен қатты толқып тұрмын...
Dialogue: 0,0:33:01.43,0:33:03.48,Default,,0,0,0,,Қызықты планета
Dialogue: 0,0:33:20.45,0:33:25.58,Default,,0,0,0,,Сәрсенбі, Жұма, Жер, От, Бейсенбі, Жер, Аспан Әумин
Dialogue: 0,0:33:25.96,0:33:31.42,Default,,0,0,0,,Жер/Аспан Аумин
Dialogue: 0,0:33:34.97,0:33:37.34,Default,,0,0,0,,Аййййошико-сенсэй!
Dialogue: 0,0:33:40.06,0:33:43.02,Default,,0,0,0,,Хигураши мырза, мектептен кететін уақыт келді.
Dialogue: 0,0:33:43.23,0:33:47.19,Default,,0,0,0,,Кешіріңіз, мен қазір үйге барамын! Бір сәтте...
Dialogue: 0,0:33:49.31,0:33:51.73,Default,,0,0,0,,Мен қатты дұға естідім,
Dialogue: 0,0:33:52.74,0:33:54.70,Default,,0,0,0,,Әумин
Dialogue: 0,0:33:54.99,0:33:59.53,Default,,0,0,0,,Жоқ, ештеңе! Кешіріңіз. Қайырлы күн!!
Dialogue: 0,0:33:59.78,0:34:02.24,Default,,0,0,0,,(Аяқ дыбысы)
Dialogue: 0,0:34:06.12,0:34:09.13,Default,,0,0,0,,(Тоцуконың ызылдаған және пернетақта ойнаған дыбысы)
Dialogue: 0,0:34:10.04,0:34:14.01,Default,,0,0,0,,♪ Фуфунфун Дотен Әумин...
Dialogue: 0,0:34:18.18,0:34:20.97,Default,,0,0,0,,(бірдей әуенді пернетақта өнімділігінің дыбысы)
Dialogue: 0,0:34:21.35,0:34:25.39,Default,,0,0,0,,А, бұл дыбыс Луи-кунның түсіне ұқсайды.
Dialogue: 0,0:34:25.68,0:34:27.44,Default,,0,0,0,,Бұл дыбыс сізсіз
Dialogue: 0,0:34:32.61,0:34:34.49,Default,,0,0,0,,Бұл не? Бұл бала ғой!
Dialogue: 0,0:34:35.15,0:34:37.57,Default,,0,0,0,,Моккай, моккай
Dialogue: 0,0:34:37.70,0:34:38.82,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:34:39.36,0:34:41.41,Default,,0,0,0,,Олай болса, өтінемін
Dialogue: 0,0:34:41.53,0:34:42.79,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:34:43.12,0:34:45.50,Default,,0,0,0,,Умма, мен естідім.
Dialogue: 0,0:34:46.08,0:34:47.87,Default,,0,0,0,,Сіз не істеп жатырсыз? иә?
Dialogue: 0,0:34:48.29,0:34:50.08,Default,,0,0,0,,Бейнелеу бәсекесі
Dialogue: 0,0:34:50.83,0:34:53.59,Default,,0,0,0,,Бұл Сумиканың әпкесі Юри
Dialogue: 0,0:34:53.71,0:34:56.01,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:34:56.17,0:34:58.72,Default,,0,0,0,,Ұқсас.
Dialogue: 0,0:35:00.30,0:35:02.89,Default,,0,0,0,,Көремін, жазып жатырмын...
Dialogue: 0,0:35:04.06,0:35:05.81,Default,,0,0,0,,Тоцуко да солай жасайды.
Dialogue: 0,0:35:05.93,0:35:08.19,Default,,0,0,0,,Иә, мен мұны кейінірек жасаймын.
Dialogue: 0,0:35:08.73,0:35:10.60,Default,,0,0,0,,Саку Мен келесі күні Йошико-сенсэйге барамын.
Dialogue: 0,0:35:10.73,0:35:12.40,Default,,0,0,0,,Жарайды, жасайық.
Dialogue: 0,0:35:12.82,0:35:15.44,Default,,0,0,0,,Бір минут күтіңіз, мен жаттығамын.
Dialogue: 0,0:35:15.57,0:35:16.61,Default,,0,0,0,,Ааа~
Dialogue: 0,0:35:17.32,0:35:20.74,Default,,0,0,0,,(Гитараны баптау дыбысы және смартфонның діріл дыбысы)
Dialogue: 0,0:35:20.86,0:35:21.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:30.12,0:35:31.71,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:35:38.88,0:35:42.85,Default,,0,0,0,,Бұл қазірдің өзінде жасалды, бұл керемет
Dialogue: 0,0:35:48.02,0:35:50.64,Default,,0,0,0,,(Тоцуконың жөтелі)
Dialogue: 0,0:35:50.85,0:35:54.06,Default,,0,0,0,,♪ Су Метал Жер От Ағаш Жер Аспан Әумин
Dialogue: 0,0:35:54.27,0:35:57.53,Default,,0,0,0,,(Тоцуконың гуілдеуі)
Dialogue: 0,0:35:57.65,0:36:00.86,Default,,0,0,0,,♪ Су, Металл, Жер, От, Ағаш, Жер, Аспан Әумин
Dialogue: 0,0:36:00.99,0:36:03.99,Default,,0,0,0,,(Тоцуконың гуілдеуі)
Dialogue: 0,0:36:06.87,0:36:08.66,Default,,0,0,0,,Дәлізде жүгірме!
Dialogue: 0,0:36:08.79,0:36:09.45,Default,,0,0,0,,Гяха…
Dialogue: 0,0:36:09.66,0:36:11.12,Default,,0,0,0,,(Таңданған Хиёсико Кими Луи апаның дауысы)
Dialogue: 0,0:36:11.25,0:36:12.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:20.42,0:36:24.43,Default,,0,0,0,,(♪ «Сәрсенбі, Металл, Жер, От, Бейсенбі, Жер және Аспан Аумин» аяқталмаған нұсқасы орындау дыбысы)
Dialogue: 0,0:36:45.03,0:36:48.24,Default,,0,0,0,,Жарайды, мен саған кәдімгі дәрі берем.
Dialogue: 0,0:36:48.62,0:36:50.12,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:36:51.46,0:36:53.58,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:36:54.96,0:36:56.59,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:36:59.50,0:37:01.76,Default,,0,0,0,,Қайтадан қош келдіңіз.
Dialogue: 0,0:37:02.30,0:37:04.84,Default,,0,0,0,,Бүгінгі күндізгі мектеп туралы не деуге болады? Жоқ.
Dialogue: 0,0:37:05.09,0:37:08.43,Default,,0,0,0,,Жақсы, мен саған жейтін бірдеңе сатып алайын.
Dialogue: 0,0:37:08.60,0:37:12.43,Default,,0,0,0,,Мен егжей-тегжейлі ештеңе жасамаймын, сондықтан жақсы.
Dialogue: 0,0:37:12.60,0:37:14.10,Default,,0,0,0,,Оқу жақсы ма?
Dialogue: 0,0:37:14.35,0:37:17.15,Default,,0,0,0,,Жарайды, сынақ емтиханы да жаман болған жоқ.
Dialogue: 0,0:37:17.52,0:37:19.52,Default,,0,0,0,,Көңілсіз болмаңыз
Dialogue: 0,0:37:19.65,0:37:23.45,Default,,0,0,0,,Луис - біздің бизнесімізді басқара алатын жалғыз адам.
Dialogue: 0,0:37:24.32,0:37:25.91,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:37:26.28,0:37:27.49,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:37:28.78,0:37:31.91,Default,,0,0,0,,Широ-кун да Обон үшін үйге келмейді.
Dialogue: 0,0:37:33.08,0:37:34.62,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:37:34.75,0:37:39.21,Default,,0,0,0,,Сонымен, сен демалыс күні қызыңның ата-анасының үйіне барасың деп естідім.
Dialogue: 0,0:37:39.34,0:37:40.38,Default,,0,0,0,,Иә
Dialogue: 0,0:37:40.59,0:37:43.38,Default,,0,0,0,,Сіздер үшін де жазғы демалыс басталып жатыр.
Dialogue: 0,0:37:46.43,0:37:47.14,Default,,0,0,0,,Иә
Dialogue: 0,0:37:47.30,0:37:50.10,Default,,0,0,0,,Мен сені бір жерге апарғым келеді.
Dialogue: 0,0:37:50.22,0:37:52.64,Default,,0,0,0,,Толық емес жұмыс күнімнен үзіліс жасай алмаймын деп ойлаймын.
Dialogue: 0,0:37:52.77,0:37:56.85,Default,,0,0,0,,Жарайды, менде де көп нәрсе бар, рахмет.
Dialogue: 0,0:37:57.31,0:38:00.82,Default,,0,0,0,,А, хор? Бұл өте қиын
Dialogue: 0,0:38:01.07,0:38:04.28,Default,,0,0,0,,Бірақ директор маған бұрын айтты.
Dialogue: 0,0:38:04.40,0:38:07.86,Default,,0,0,0,,Егер сіз болсаңыз, мен өз хорымды сізге қалдырар едім.
Dialogue: 0,0:38:08.28,0:38:11.16,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:38:13.83,0:38:18.46,Default,,0,0,0,,Әже, мен онша жақсы адам емеспін.
Dialogue: 0,0:38:26.76,0:38:28.84,Default,,0,0,0,,(доптардың бір-біріне соғылған дыбысы)
Dialogue: 0,0:38:44.07,0:38:47.07,Default,,0,0,0,,(Сіздің ызылдаған және гитарада ойнаған дыбыс)
Dialogue: 0,0:39:04.34,0:39:07.26,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:39:07.26,0:39:08.38,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:39:07.26,0:39:08.38,Default,,0,0,0,,Кими-чан
Dialogue: 0,0:39:12.22,0:39:14.22,Default,,0,0,0,,Дәл қазір мен өлең жазып жатырмын.
Dialogue: 0,0:39:15.35,0:39:19.64,Default,,0,0,0,,Жоқ!! Менде әлі жоқ. Бұл керемет.
Dialogue: 0,0:39:20.40,0:39:22.15,Default,,0,0,0,,Мен оны кейін жіберемін.
Dialogue: 0,0:39:23.11,0:39:25.15,Default,,0,0,0,,Тоцуконы да тыңдауым керек.
Dialogue: 0,0:39:27.15,0:39:30.49,Default,,0,0,0,,Бірақ бұл өте жарқын ән болмауы мүмкін.
Dialogue: 0,0:39:32.70,0:39:35.70,Default,,0,0,0,,(♪ «Аруку» кіріспе орындау дыбысы)
Dialogue: 0,0:39:56.60,0:39:58.02,Default,,0,0,0,,Хигураши мырза
Dialogue: 0,0:39:58.98,0:40:00.52,Default,,0,0,0,,Хиёсико Сенсей
Dialogue: 0,0:40:00.94,0:40:02.44,Default,,0,0,0,,Мен көрші үйде тұра аламын ба?
Dialogue: 0,0:40:02.56,0:40:04.86,Default,,0,0,0,,Иә, әрине!
Dialogue: 0,0:40:12.32,0:40:13.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:14.66,0:40:18.04,Default,,0,0,0,,Хигураши-сан жазғы демалыс бойы жатақханада болады ма?
Dialogue: 0,0:40:18.16,0:40:22.37,Default,,0,0,0,,Аа, иә, мен бір істегім келеді.
Dialogue: 0,0:40:22.83,0:40:27.13,Default,,0,0,0,,Түсінемін, бұл да нұсқа.
Dialogue: 0,0:40:28.21,0:40:30.38,Default,,0,0,0,,Сіз не істегіңіз келеді
Dialogue: 0,0:40:31.63,0:40:34.72,Default,,0,0,0,,Әй, мен бұл әнді шығардым...
Dialogue: 0,0:40:36.47,0:40:38.89,Default,,0,0,0,,Ал, жаңа ән?
Dialogue: 0,0:40:39.02,0:40:40.60,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:40:41.94,0:40:44.35,Default,,0,0,0,,Мен соншалықты керемет ештеңе істеген жоқпын...
Dialogue: 0,0:40:45.31,0:40:50.82,Default,,0,0,0,,Бұл менің сезімім туралы, дәлірек айтсақ, бақыт туралы ән.
Dialogue: 0,0:40:51.90,0:40:54.57,Default,,0,0,0,,Жақсы нәрселер, әдемі заттар
Dialogue: 0,0:40:54.70,0:40:57.28,Default,,0,0,0,,Музыка шындықты жырласа
Dialogue: 0,0:40:58.16,0:41:00.58,Default,,0,0,0,,Оны ән деп атауға болады.
Dialogue: 0,0:41:05.33,0:41:10.01,Default,,0,0,0,,Мұңды немесе азапты әндер гимн бола ма?
Dialogue: 0,0:41:11.67,0:41:17.26,Default,,0,0,0,,Сезімдегі азапты ән айту да әнұран деп ойлаймын.
Dialogue: 0,0:41:18.47,0:41:20.43,Default,,0,0,0,,Қабылдау
Dialogue: 0,0:41:22.60,0:41:28.02,Default,,0,0,0,,Мен әннің Хигураши-санды қорғайтынына сенімдімін.
Dialogue: 0,0:41:30.40,0:41:34.82,Default,,0,0,0,,Негізі мен топтамын.
Dialogue: 0,0:41:39.37,0:41:43.75,Default,,0,0,0,,Күндіз саған күн түспесін;
Dialogue: 0,0:41:44.37,0:41:48.25,Default,,0,0,0,,Түнде ай саған соқпайды
Dialogue: 0,0:41:48.54,0:41:52.71,Default,,0,0,0,,Жаратқан Ие сені барлық жамандықтан сақтайды
Dialogue: 0,0:41:52.88,0:41:55.76,Default,,0,0,0,,Ол сенің жаныңды қорғайды
Dialogue: 0,0:41:56.59,0:41:59.97,Default,,0,0,0,,Жаратқан Ие сенің баруың да, қайтуың да...
Dialogue: 0,0:42:00.10,0:42:02.14,Default,,0,0,0,,Қорғау
Dialogue: 0,0:42:03.18,0:42:06.14,Default,,0,0,0,,Бұдан былай мәңгілік
Dialogue: 0,0:42:09.23,0:42:12.23,Default,,0,0,0,,Е, бұл қауіпті, Ирохазака қауіпті.
Dialogue: 0,0:42:13.11,0:42:14.57,Default,,0,0,0,,Гунегунежанан
Dialogue: 0,0:42:14.69,0:42:16.86,Default,,0,0,0,,Осы уақыт бойы автобуспен жүрсіз бе?
Dialogue: 0,0:42:17.24,0:42:18.70,Default,,0,0,0,,Автобус…
Dialogue: 0,0:42:18.99,0:42:20.70,Default,,0,0,0,,Рагудан басқа да тағамдарды мүмкіндігінше тезірек жақсы пісіре білгім келеді.
Dialogue: 0,0:42:20.83,0:42:23.08,Default,,0,0,0,,Эй, бұлардың бәрі шын ба?
Dialogue: 0,0:42:23.25,0:42:24.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:42:24.16,0:42:26.29,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:42:27.25,0:42:29.92,Default,,0,0,0,,Иә Темпура Соба Омачидо
Dialogue: 0,0:42:31.25,0:42:34.21,Default,,0,0,0,,Бұл мектептегі саяхат. Біздің топ бірге, солай ма?
Dialogue: 0,0:42:34.51,0:42:36.34,Default,,0,0,0,,Иә, бірге.
Dialogue: 0,0:42:37.22,0:42:39.68,Default,,0,0,0,,Сіз не қарап тұрсыз? Маймыл?
Dialogue: 0,0:42:39.89,0:42:41.26,Default,,0,0,0,,Сүйкімді маймыл
Dialogue: 0,0:42:41.39,0:42:42.89,Default,,0,0,0,,Бірге суретке түсе аламыз ба?
Dialogue: 0,0:42:54.69,0:42:55.94,Default,,0,0,0,,Кими-чан
Dialogue: 0,0:42:56.07,0:42:57.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:58.11,0:42:59.41,Default,,0,0,0,,Тоцуко
Dialogue: 0,0:43:01.78,0:43:03.12,Default,,0,0,0,,Қызу!
Dialogue: 0,0:43:15.05,0:43:17.22,Default,,0,0,0,,Хехе... Уау!
Dialogue: 0,0:43:17.34,0:43:18.80,Default,,0,0,0,,Мен Тоцукоға байланып қалдым
Dialogue: 0,0:43:19.51,0:43:21.14,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:43:23.05,0:43:24.35,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:43:24.56,0:43:26.64,Default,,0,0,0,,Мияу, солай ма?
Dialogue: 0,0:43:29.06,0:43:35.03,Default,,0,0,0,,Кими-чан, көп сұрағаным үшін кешір. Бірдеңе болды ма?
Dialogue: 0,0:43:38.90,0:43:40.24,Default,,0,0,0,,Мм.
Dialogue: 0,0:43:43.37,0:43:45.83,Default,,0,0,0,,Иә, мен келесі аптада.
Dialogue: 0,0:43:46.12,0:43:48.33,Default,,0,0,0,,Мектепке саяхат... солай ма?
Dialogue: 0,0:43:49.16,0:43:50.29,Default,,0,0,0,,Иә
Dialogue: 0,0:43:52.38,0:43:55.67,Default,,0,0,0,,Тоцуко, сен кері шегінбей тыңдай аласың ба?
Dialogue: 0,0:43:56.09,0:43:57.26,Default,,0,0,0,,Иә
Dialogue: 0,0:43:58.30,0:44:02.84,Default,,0,0,0,,Мен әжеме мектепті тастағанымды әлі айтқан жоқпын.
Dialogue: 0,0:44:06.14,0:44:09.93,Default,,0,0,0,,Мен мектептегі саяхат кезінде үйден қашып кетемін деп ойлаймын.
Dialogue: 0,0:44:11.60,0:44:17.03,Default,,0,0,0,,Мен әжеме шындықты айтуға қорқамын.
Dialogue: 0,0:44:20.78,0:44:22.07,Default,,0,0,0,,Мен сені ренжітемін
Dialogue: 0,0:44:30.71,0:44:31.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:33.67,0:44:34.79,Default,,0,0,0,,Мен дүкенге қараймын.
Dialogue: 0,0:44:34.79,0:44:35.92,Default,,0,0,0,,Мен дүкенге қараймын.
Dialogue: 0,0:44:34.79,0:44:35.92,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:44:36.17,0:44:37.09,Default,,0,0,0,,Иә
Dialogue: 0,0:44:37.21,0:44:38.38,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:44:42.09,0:44:43.34,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:44:44.72,0:44:46.14,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:44:51.39,0:44:52.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:53.56,0:44:55.86,Default,,0,0,0,,Амансың ба? Тонко
Dialogue: 0,0:44:55.98,0:44:58.32,Default,,0,0,0,,Мен саған кәдесый сатып аламын.
Dialogue: 0,0:44:59.19,0:45:00.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:45:01.15,0:45:03.24,Default,,0,0,0,,Мен сонда барамын.
Dialogue: 0,0:45:03.41,0:45:06.16,Default,,0,0,0,,Парта үстіндегі тәттілерді де жеуге болады.
Dialogue: 0,0:45:06.83,0:45:07.24,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:45:07.24,0:45:09.41,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:45:07.24,0:45:09.41,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:45:09.58,0:45:12.25,Default,,0,0,0,,Абайлаңыз~
Dialogue: 0,0:45:13.54,0:45:14.92,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:45:18.84,0:45:20.76,Default,,0,0,0,,Мектепке саяхатқа бара алмайтыныма сене алар емеспін.
Dialogue: 0,0:45:20.92,0:45:22.38,Default,,0,0,0,,Мен сені қатты аяймын.
Dialogue: 0,0:45:22.55,0:45:24.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:45:24.43,0:45:27.10,Default,,0,0,0,,Раббым, мені кешіре гөр!
Dialogue: 0,0:45:38.57,0:45:40.28,Default,,0,0,0,,Су, металл, жер, от, ағаш
Dialogue: 0,0:45:41.11,0:45:42.78,Default,,0,0,0,,Жер Аспан Аумин
Dialogue: 0,0:45:49.91,0:45:53.62,Default,,0,0,0,,Құпия бақшаға қош келдіңіздер
Dialogue: 0,0:45:55.12,0:45:57.08,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:46:03.30,0:46:04.42,Default,,0,0,0,,Ах
Dialogue: 0,0:46:10.39,0:46:11.10,Default,,0,0,0,,Мысық!
Dialogue: 0,0:46:11.68,0:46:12.89,Default,,0,0,0,,(Мысықтың мияуы)
Dialogue: 0,0:46:34.04,0:46:35.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:41.54,0:46:43.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:08.61,0:47:10.37,Default,,0,0,0,,Мазалағаным үшін кешіріңіз...
Dialogue: 0,0:47:12.99,0:47:14.41,Default,,0,0,0,,Сүйкімді бөлме...
Dialogue: 0,0:47:15.62,0:47:16.75,Default,,0,0,0,,Кими-чан а
Dialogue: 0,0:47:16.87,0:47:19.96,Default,,0,0,0,,Сіз аштыңыз ба? Иә, бәрібір
Dialogue: 0,0:47:20.38,0:47:26.55,Default,,0,0,0,,Ішім ауырып тұр деп, сұлы жедім.
Dialogue: 0,0:47:28.30,0:47:32.22,Default,,0,0,0,,Сонда Тоцуконың қарны көбірек емес пе?
Dialogue: 0,0:47:32.39,0:47:34.35,Default,,0,0,0,,Мен көп нәрсені сатып алдым.
Dialogue: 0,0:47:34.56,0:47:36.06,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,0:47:36.18,0:47:38.23,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз...
Dialogue: 0,0:47:38.35,0:47:39.89,Default,,0,0,0,,Мен тілеймін...
Dialogue: 0,0:47:40.77,0:47:44.07,Default,,0,0,0,,Тоцуко, кешіріңіз.
Dialogue: 0,0:47:44.36,0:47:48.74,Default,,0,0,0,,Жоқ, мен де автобусқа отырудың қажеті жоқ.
Dialogue: 0,0:47:50.03,0:47:52.99,Default,,0,0,0,,Мектепке саяхатқа барғанда...
Dialogue: 0,0:47:53.78,0:47:57.25,Default,,0,0,0,,Мен қатты ауырып қалған шығармын.
Dialogue: 0,0:48:02.96,0:48:08.88,Default,,0,0,0,,Саку-чан және басқалары да көп тәттілерді тастап кетті, ендеше той жасайық.
Dialogue: 0,0:48:10.34,0:48:11.38,Default,,0,0,0,,Иә
Dialogue: 0,0:49:11.99,0:49:13.61,Default,,0,0,0,,
Dialogue: 0,0:49:18.83,0:49:20.83,Default,,0,0,0,,
Dialogue: 0,0:49:21.62,0:49:23.21,Default,,0,0,0,,Хигураши мырза
Dialogue: 0,0:49:23.79,0:49:25.58,Default,,0,0,0,,Хиосико-сенсэй...
Dialogue: 0,0:49:38.76,0:49:39.89,Default,,0,0,0,,Хмф!
Dialogue: 0,0:49:45.69,0:49:46.85,Default,,0,0,0,,Иә
Dialogue: 0,0:49:46.98,0:49:49.32,Default,,0,0,0,,Мен дауысты естідім...
Dialogue: 0,0:49:49.44,0:49:51.03,Default,,0,0,0,,Мұның бәрі өзім үшін!
Dialogue: 0,0:49:51.15,0:49:52.99,Default,,0,0,0,,Ояу жүрген дұрыс па?
Dialogue: 0,0:49:53.11,0:49:56.82,Default,,0,0,0,,А, енді мынау!
Dialogue: 0,0:49:59.45,0:50:02.12,Default,,0,0,0,,Оны дәлізде қалдырыңыз.
Dialogue: 0,0:50:02.45,0:50:04.50,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:50:04.66,0:50:06.83,Default,,0,0,0,,Әлі де... сәл...
Dialogue: 0,0:50:07.21,0:50:09.17,Default,,0,0,0,,Ертең ауруханаға барайық.
Dialogue: 0,0:50:09.29,0:50:13.34,Default,,0,0,0,,Ах, бірақ мен өзімді бүгінгі таңғыдан әлдеқайда жақсы сезінемін...
Dialogue: 0,0:50:13.63,0:50:16.55,Default,,0,0,0,,Маған тиісті медициналық тексеруден өту керек.
Dialogue: 0,0:50:18.30,0:50:20.30,Default,,0,0,0,,Бұл бір нәрсе
Dialogue: 0,0:50:20.43,0:50:21.51,Default,,0,0,0,,Ах
Dialogue: 0,0:50:22.85,0:50:23.89,Default,,0,0,0,,Жоқ
Dialogue: 0,0:50:24.60,0:50:25.64,Default,,0,0,0,,(Масато) Денең болмауы біраз қиын ғой, иә?
Dialogue: 0,0:50:26.31,0:50:27.48,Default,,0,0,0,,(Масато) Денең болмауы біраз қиын ғой, иә?
Dialogue: 0,0:50:28.10,0:50:30.73,Default,,0,0,0,,Кімге... Хэхе...
Dialogue: 0,0:50:31.23,0:50:34.44,Default,,0,0,0,,Олай болса жақсылап демалыңыз.
Dialogue: 0,0:50:34.57,0:50:36.95,Default,,0,0,0,,Иә! (Хиёсико апа) Қайырлы түн.
Dialogue: 0,0:50:37.82,0:50:38.91,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:50:40.87,0:50:42.58,Default,,0,0,0,,Қайырлы күн...
Dialogue: 0,0:50:50.50,0:50:54.26,Default,,0,0,0,,Мен не істеуім керек? Өтірікке өтірік...
Dialogue: 0,0:50:55.21,0:50:56.84,Default,,0,0,0,,Тоцуко... (Тоцуко) Иә.
Dialogue: 0,0:50:57.34,0:51:00.80,Default,,0,0,0,,Жарайды! Мен кейін мойындаймын!
Dialogue: 0,0:51:04.68,0:51:05.10,Default,,0,0,0,,(шу)
Dialogue: 0,0:51:05.10,0:51:06.27,Default,,0,0,0,,(шу)
Dialogue: 0,0:51:05.10,0:51:06.27,Default,,0,0,0,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,0:51:06.39,0:51:07.31,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:51:07.44,0:51:10.35,Default,,0,0,0,,Хмм, сәл кішкентай.
Dialogue: 0,0:51:10.48,0:51:14.78,Default,,0,0,0,,Нфуфу Кими-чан, сіз футоныңыздасыз ба?
Dialogue: 0,0:51:15.36,0:51:19.28,Default,,0,0,0,,Ах... Артында бірдеңе жазылған ба?
Dialogue: 0,0:51:19.61,0:51:21.45,Default,,0,0,0,,А, бұл?
Dialogue: 0,0:51:21.91,0:51:26.08,Default,,0,0,0,,Мына төсекті пайдаланған адам ойып салғанға ұқсайды.
Dialogue: 0,0:51:27.91,0:51:30.75,Default,,0,0,0,,Мен күн сайын ризашылықпен дұға етемін.
Dialogue: 0,0:51:33.67,0:51:35.42,Default,,0,0,0,,Соңында 300-ден астам оқ аттым
Dialogue: 0,0:51:35.55,0:51:36.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:39.38,0:51:40.68,Default,,0,0,0,,Сәлем Тоцуко
Dialogue: 0,0:51:40.97,0:51:42.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:42.64,0:51:46.93,Default,,0,0,0,,Мен Тоцукоға өтірік айттым.
Dialogue: 0,0:51:52.10,0:51:55.32,Default,,0,0,0,,Мен...
Dialogue: 0,0:51:56.86,0:51:58.32,Default,,0,0,0,,Кими-чан
Dialogue: 0,0:51:58.99,0:52:04.33,Default,,0,0,0,,Мен қазір өте көңілді және бақыттымын.
Dialogue: 0,0:52:10.00,0:52:15.00,Default,,0,0,0,,Сондай-ақ, мен сіз айтқыңыз келмейтін нәрсені тыңдамаймын.
Dialogue: 0,0:52:16.13,0:52:20.51,Default,,0,0,0,,Менің ойымша, алдымен әжеңе айту керек.
Dialogue: 0,0:52:21.30,0:52:25.43,Default,,0,0,0,,Қорықсаң, мен сенімен келемін.
Dialogue: 0,0:52:26.51,0:52:30.52,Default,,0,0,0,,Иә, мен үйге келгенде әжеме айтамын.
Dialogue: 0,0:52:31.98,0:52:33.77,Default,,0,0,0,,Тоцукоға рахмет
Dialogue: 0,0:52:39.36,0:52:40.74,Default,,0,0,0,,Тоцуко…
Dialogue: 0,0:52:40.86,0:52:41.82,Default,,0,0,0,,(Тоцуконың қорылдаған дыбысы)
Dialogue: 0,0:52:41.95,0:52:43.70,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:52:44.24,0:52:45.95,Default,,0,0,0,,О~ Бес күн бұрын D-хат келген екен.
Dialogue: 0,0:52:55.84,0:52:56.63,Default,,0,0,0,,Хмм?
Dialogue: 0,0:53:04.72,0:53:08.81,Default,,0,0,0,,(Әпкелер кездесуі)
Dialogue: 0,0:53:21.78,0:53:25.78,Default,,0,0,0,,(♪ «Аменокисаки» хорының ән айту дауысы)
Dialogue: 0,0:53:43.13,0:53:48.60,Default,,0,0,0,,Мм... Мен мектептегі саяхат кезінде түнеуімді ұсындым.
Dialogue: 0,0:53:49.10,0:53:52.89,Default,,0,0,0,,Кими-чан... Сакунага-сан жаман емес.
Dialogue: 0,0:53:53.60,0:53:54.69,Default,,0,0,0,,Хигураши мырза
Dialogue: 0,0:53:54.81,0:53:59.36,Default,,0,0,0,,Жатақханада қандай да бір себептермен бөгде адамдардың тұруына тыйым салынады.
Dialogue: 0,0:54:02.32,0:54:07.03,Default,,0,0,0,,Сіз бір ай бойы күн сайын рефлексия мен қызмет көрсету әрекетін аяқтайсыз.
Dialogue: 0,0:54:07.41,0:54:08.57,Default,,0,0,0,,Иә
Dialogue: 0,0:54:13.54,0:54:17.08,Default,,0,0,0,,Мектеп директоры Сакунага да волонтерлік іс-шараларға қатысты.
Dialogue: 0,0:54:17.67,0:54:21.55,Default,,0,0,0,,Сакунага мырза енді біздің мектепте оқушы емес.
Dialogue: 0,0:54:22.42,0:54:26.80,Default,,0,0,0,,Солай болса да, оған қосылу үшін орын беріңіз.
Dialogue: 0,0:54:30.22,0:54:34.23,Default,,0,0,0,,(♪ «Аменокисаки» хорының ән айту дауысы)
Dialogue: 0,0:54:47.07,0:54:48.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:51.62,0:54:52.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:53.54,0:54:55.54,Default,,0,0,0,,Ура!
Dialogue: 0,0:55:15.56,0:55:18.35,Default,,0,0,0,,А... ха
Dialogue: 0,0:55:18.48,0:55:20.10,Default,,0,0,0,,Хаа…
Dialogue: 0,0:55:24.65,0:55:25.74,Default,,0,0,0,,Ах
Dialogue: 0,0:55:26.86,0:55:27.99,Default,,0,0,0,,Ах
Dialogue: 0,0:55:29.78,0:55:30.78,Default,,0,0,0,,Ах
Dialogue: 0,0:55:33.53,0:55:34.70,Default,,0,0,0,,Ах
Dialogue: 0,0:55:36.66,0:55:37.71,Default,,0,0,0,,Ах
Dialogue: 0,0:55:37.96,0:55:41.00,Default,,0,0,0,,Уау, мен оны қолдана аламын.
Dialogue: 0,0:55:41.13,0:55:43.13,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:55:46.42,0:55:47.76,Default,,0,0,0,,Тоцуко-чан
Dialogue: 0,0:56:20.54,0:56:23.63,Default,,0,0,0,,Және бір, және екі
Dialogue: 0,0:56:29.17,0:56:31.63,Default,,0,0,0,,Және бір, және...
Dialogue: 0,0:56:37.10,0:56:40.14,Default,,0,0,0,,№ 5 Доуми және екеуі
Dialogue: 0,0:56:47.86,0:56:49.28,Default,,0,0,0,,Тоцуко
Dialogue: 0,0:56:52.70,0:56:53.91,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:56:56.41,0:56:57.79,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:57:23.10,0:57:25.15,Default,,0,0,0,,Сәлеметсіз бе, ә
Dialogue: 0,0:57:26.90,0:57:27.73,Default,,0,0,0,,Ах
Dialogue: 0,0:57:28.48,0:57:30.15,Default,,0,0,0,,Сакунага мырза
Dialogue: 0,0:57:30.94,0:57:32.99,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:57:33.20,0:57:35.16,Default,,0,0,0,,Мектеп саяхаты туралы не айтасыз?
Dialogue: 0,0:57:35.91,0:57:37.07,Default,,0,0,0,,Иә
Dialogue: 0,0:57:37.83,0:57:41.16,Default,,0,0,0,,Мен сенен естімегеніме көп болды деп ойладым.
Dialogue: 0,0:57:43.04,0:57:44.62,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:57:46.33,0:57:50.67,Default,,0,0,0,,Тоцуко: Мен автобустарды ұнатпаймын, сондықтан жақсы болар деп ойладым.
Dialogue: 0,0:57:54.59,0:57:58.30,Default,,0,0,0,,Сіз оны қанатыңыздың астына алғыңыз келетін дос таптыңыз.
Dialogue: 0,0:57:59.31,0:58:03.35,Default,,0,0,0,,Негізі мен саған көп ұрысуым керек деп ойладым.
Dialogue: 0,0:58:05.98,0:58:09.36,Default,,0,0,0,,Эй, сен сүйкімдісің.
Dialogue: 0,0:58:10.86,0:58:14.32,Default,,0,0,0,,Тоцуко да солай болған, есіңізде ме?
Dialogue: 0,0:58:15.99,0:58:17.16,Default,,0,0,0,,Иә
Dialogue: 0,0:58:17.99,0:58:21.54,Default,,0,0,0,,Айналыңыз, айналаңыз, көңілді көрінеді.
Dialogue: 0,0:58:23.29,0:58:24.37,Default,,0,0,0,,Иә
Dialogue: 0,0:58:25.12,0:58:29.71,Default,,0,0,0,,Кешіріңіз, қызықты кітаптар өте көп.
Dialogue: 0,0:58:29.88,0:58:33.51,Default,,0,0,0,,Мүлдем емес Өтінемін, көп оқып көріңіз.
Dialogue: 0,0:58:45.18,0:58:46.98,Default,,0,0,0,,Осыны орындайық
Dialogue: 0,0:58:48.44,0:58:49.73,Default,,0,0,0,,Сакунага мырза
Dialogue: 0,0:58:50.73,0:58:52.73,Default,,0,0,0,,Мен осы кітапты таңдадым.
Dialogue: 0,0:58:53.23,0:58:54.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:58:55.44,0:58:57.28,Default,,0,0,0,,500 иен
Dialogue: 0,0:58:58.07,0:58:59.91,Default,,0,0,0,,Бұл рефлексия ма?
Dialogue: 0,0:59:00.53,0:59:01.74,Default,,0,0,0,,Иә
Dialogue: 0,0:59:02.79,0:59:09.00,Default,,0,0,0,,Рефлексия... сәл формальды.
Dialogue: 0,0:59:09.75,0:59:15.76,Default,,0,0,0,,Осыған байланысты бірдеңе мені жеңілдетеді...
Dialogue: 0,0:59:19.30,0:59:23.39,Default,,0,0,0,,Жүрегіңізде не бар екенін өлең жазуға қалай қарайсыз?
Dialogue: 0,0:59:24.39,0:59:25.43,Default,,0,0,0,,Ән?
Dialogue: 0,0:59:25.64,0:59:29.35,Default,,0,0,0,,Сіз Хигураши мырзамен топтасыз ба?
Dialogue: 0,0:59:30.56,0:59:31.31,Default,,0,0,0,,Иә
Dialogue: 0,0:59:31.44,0:59:34.53,Default,,0,0,0,,Жоқ, дұрыс.
Dialogue: 0,0:59:35.07,0:59:38.15,Default,,0,0,0,,Мен осы парақшаны осы жердегі дүкендерге қойғанын қалаймын.
Dialogue: 0,0:59:38.28,0:59:39.70,Default,,0,0,0,,Бүгін мен саған қонаққа бардым.
Dialogue: 0,0:59:39.82,0:59:44.03,Default,,0,0,0,,Маған келгенде көзім бір керемет кітапқа ауды...
Dialogue: 0,0:59:45.29,0:59:47.71,Default,,0,0,0,,Әулие Валентин күні
Dialogue: 0,0:59:47.96,0:59:52.38,Default,,0,0,0,,Бұл жыл сайынғы фестиваль, сондықтан Сакунага-сан да бұл туралы білетін шығар.
Dialogue: 0,0:59:52.75,0:59:53.84,Default,,0,0,0,,Иә
Dialogue: 0,0:59:55.38,0:59:59.72,Default,,0,0,0,,Сакунага мырза, сіз Хигураши мырзамен қыдырғыңыз келе ме?
Dialogue: 0,0:59:59.84,1:00:01.09,Default,,0,0,0,,Мм...
Dialogue: 0,1:00:01.93,1:00:04.76,Default,,0,0,0,,Түлектер де қатыса алады.
Dialogue: 0,1:00:04.97,1:00:07.22,Default,,0,0,0,,Мен бітірушімін...
Dialogue: 0,1:00:07.77,1:00:10.23,Default,,0,0,0,,Сіз осы мектепті бітірдіңіз.
Dialogue: 0,1:00:11.65,1:00:14.23,Default,,0,0,0,,Өз уақытыңыз бойынша
Dialogue: 0,1:00:16.90,1:00:18.86,Default,,0,0,0,,Және Сакунага мырза
Dialogue: 0,1:00:19.65,1:00:22.49,Default,,0,0,0,,Сізді жақсы көретін басқа студенттер
Dialogue: 0,1:00:22.61,1:00:26.62,Default,,0,0,0,,Мен сенің жақсы болғаныңды көргім келеді.
Dialogue: 0,1:00:28.79,1:00:31.08,Default,,0,0,0,,Сіз өтірік айттыңыз
Dialogue: 0,1:00:32.21,1:00:36.05,Default,,0,0,0,,Мен кемпірді жатақханаға алдап кіргіздім.
Dialogue: 0,1:00:36.25,1:00:41.68,Default,,0,0,0,,Бірақ мұның бәрі күнә емес, күнә.
Dialogue: 0,1:00:42.68,1:00:45.10,Default,,0,0,0,,Сіз жай ғана көңіл бөлдіңіз.
Dialogue: 0,1:00:46.06,1:00:50.18,Default,,0,0,0,,Бұл өтірік сені де жаралады.
Dialogue: 0,1:00:50.35,1:00:52.85,Default,,0,0,0,,Тезірек оралыңыз~
Dialogue: 0,1:00:52.98,1:00:56.73,Default,,0,0,0,,Біз қайта-қайта жүре аламыз.
Dialogue: 0,1:00:57.40,1:01:00.19,Default,,0,0,0,,Егер сізде сұрақтар туындаса, маған дереу электрондық пошта арқылы хабарлаңыз.
Dialogue: 0,1:01:00.99,1:01:05.03,Default,,0,0,0,,Бұл Ишаяның сөздері, 43-тарау, 4-тармақ.
Dialogue: 0,1:01:07.62,1:01:11.87,Default,,0,0,0,,Сен менің көзімде қымбатсың, қымбатсың
Dialogue: 0,1:01:12.75,1:01:16.63,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:01:20.84,1:01:22.01,Default,,0,0,0,,Хой
Dialogue: 0,1:01:22.63,1:01:25.68,Default,,0,0,0,,Қызметтік әрекеттер бүгін аяқталады.
Dialogue: 0,1:01:26.22,1:01:27.51,Default,,0,0,0,,Иә
Dialogue: 0,1:01:28.56,1:01:29.64,Default,,0,0,0,,Ах
Dialogue: 0,1:01:32.77,1:01:35.60,Default,,0,0,0,,Хиёсико-сенсэй менің көрінгім келе ме деп сұрады.
Dialogue: 0,1:01:35.81,1:01:36.61,Default,,0,0,0,,Не!
Dialogue: 0,1:01:37.27,1:01:39.57,Default,,0,0,0,,Егер сіз ән ойнасаңыз
Dialogue: 0,1:01:39.94,1:01:42.36,Default,,0,0,0,,(Тоцуко) Иә.
Dialogue: 0,1:01:43.32,1:01:45.32,Default,,0,0,0,,(Органның орындау дыбысы)
Dialogue: 0,1:02:01.67,1:02:04.68,Default,,0,0,0,,(Органның орындауындағы дыбыстарды жазу және ойнату)
Dialogue: 0,1:02:14.18,1:02:16.19,Default,,0,0,0,,(онда орындау дыбысы)
Dialogue: 0,1:02:19.65,1:02:21.65,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:02:21.78,1:02:22.94,Default,,0,0,0,,Луи-кун
Dialogue: 0,1:02:24.11,1:02:25.28,Default,,0,0,0,,Ах!
Dialogue: 0,1:02:28.16,1:02:29.16,Default,,0,0,0,,Көп уақыт өтті...
Dialogue: 0,1:02:29.28,1:02:30.95,Default,,0,0,0,,Уау
Dialogue: 0,1:02:31.08,1:02:33.62,Default,,0,0,0,,(Тоцуконың күлкісі)
Dialogue: 0,1:02:34.91,1:02:38.25,Default,,0,0,0,,Мен сені кездестірдім! Біраз болды!!
Dialogue: 0,1:02:38.38,1:02:39.59,Default,,0,0,0,,Уау
Dialogue: 0,1:02:39.71,1:02:42.46,Default,,0,0,0,,Иә Иә Иә Иә
Dialogue: 0,1:02:42.59,1:02:43.46,Default,,0,0,0,,Иә!
Dialogue: 0,1:02:44.80,1:02:46.43,Default,,0,0,0,,Қалайсың!?
Dialogue: 0,1:02:49.01,1:02:51.89,Default,,0,0,0,,Қызметтік әрекеттеріңіз үшін рахмет.
Dialogue: 0,1:02:52.14,1:02:55.06,Default,,0,0,0,,Мен де көптеген рефлексиялар жаздым.
Dialogue: 0,1:02:55.43,1:02:59.56,Default,,0,0,0,,Сондай-ақ, «Сәр, Метал, Жер, От, Бейсенбі, Жер, Аспан, Әумин» екінші өлеңі.
Dialogue: 0,1:02:59.94,1:03:01.19,Default,,0,0,0,,Луис ше?
Dialogue: 0,1:03:01.48,1:03:04.11,Default,,0,0,0,,Мен мектепке бардым және сынақ емтихандарын тапсырдым...
Dialogue: 0,1:03:04.65,1:03:05.99,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,1:03:06.15,1:03:10.78,Default,,0,0,0,,Маған арнап жасаған әніңізге бірнеше сөз тіркестерін қостым.
Dialogue: 0,1:03:15.37,1:03:17.16,Default,,0,0,0,,Бұл ұят нәрсе.
Dialogue: 0,1:03:18.17,1:03:21.17,Default,,0,0,0,,(♪ «Аруку» ойнату дыбысы)
Dialogue: 0,1:03:40.35,1:03:46.24,Default,,0,0,0,,♪ Ла-ла-ла-ла-ла-ла...
Dialogue: 0,1:03:46.36,1:03:50.11,Default,,0,0,0,,Себебі мен аздап мұңайдым...
Dialogue: 0,1:03:51.78,1:04:01.00,Default,,0,0,0,,♪ Лалалалалалалла
Dialogue: 0,1:04:03.21,1:04:08.59,Default,,0,0,0,,♪ Лалалалалаллаалла
Dialogue: 0,1:04:09.01,1:04:14.14,Default,,0,0,0,,♪ Лалалаллалилалилалла
Dialogue: 0,1:04:14.64,1:04:19.73,Default,,0,0,0,,♪ Лалала ла ла ла ла ла ла
Dialogue: 0,1:04:19.85,1:04:25.11,Default,,0,0,0,,♪ Лалалалалаллаалла
Dialogue: 0,1:04:26.86,1:04:28.57,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,1:04:29.28,1:04:30.40,Default,,0,0,0,,Иә
Dialogue: 0,1:04:33.70,1:04:35.58,Default,,0,0,0,,Луи-кунға ұқсайды
Dialogue: 0,1:04:36.20,1:04:37.58,Default,,0,0,0,,Сүйкімді
Dialogue: 0,1:04:40.91,1:04:44.21,Default,,0,0,0,,Мұны Луи-кунға береміз бе?
Dialogue: 0,1:04:46.04,1:04:47.17,Default,,0,0,0,,Рождествода
Dialogue: 0,1:04:52.26,1:04:53.80,Default,,0,0,0,,Кими-чан?
Dialogue: 0,1:04:55.05,1:04:56.22,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,1:05:11.19,1:05:13.45,Default,,0,0,0,,Сіз жасаған әнге -
Dialogue: 0,1:05:14.28,1:05:16.45,Default,,0,0,0,,Луи-кун жасаған ән
Dialogue: 0,1:05:17.08,1:05:22.12,Default,,0,0,0,,Ал сол түсті мен сенен сездім
Dialogue: 0,1:05:22.33,1:05:24.63,Default,,0,0,0,,Тонко кәдесый ментайко
Dialogue: 0,1:05:24.75,1:05:26.92,Default,,0,0,0,,Не, сізде әлі бар ма? Иә.
Dialogue: 0,1:05:27.04,1:05:27.63,Default,,0,0,0,,Өте жақсы болды!
Dialogue: 0,1:05:27.63,1:05:29.84,Default,,0,0,0,,Бұл өте жақсы болды!
Dialogue: 0,1:05:27.63,1:05:29.84,Default,,0,0,0,,Менде әлі стакан рамен қалды.
Dialogue: 0,1:05:29.96,1:05:32.26,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:05:36.18,1:05:39.18,Default,,0,0,0,,(Тыныс алу және терең дем шығару)
Dialogue: 0,1:05:43.27,1:05:44.65,Default,,0,0,0,,(органның орындау дыбысы)
Dialogue: 0,1:05:43.27,1:05:44.65,Default,,0,0,0,,♪ Jingle Bell Джинл Белл
Dialogue: 0,1:05:44.65,1:05:46.61,Default,,0,0,0,,♪ Jingle Bell Джинл Белл
Dialogue: 0,1:05:46.73,1:05:49.98,Default,,0,0,0,,♪ Қоңырау соғылып жатыр
Dialogue: 0,1:05:50.11,1:05:58.41,Default,,0,0,0,,♪ Бүгін Рождество мерекесі!
Dialogue: 0,1:05:59.16,1:06:02.00,Default,,0,0,0,,...
Dialogue: 0,1:06:03.87,1:06:06.17,Default,,0,0,0,,Жаттығу жасаймыз ба?
Dialogue: 0,1:06:20.01,1:06:24.35,Default,,0,0,0,,(♪ «Сәрсенбі, алтын, жер, от, ағаш, жер, көк, әумин» орындау дыбысы)
Dialogue: 0,1:06:34.15,1:06:36.07,Default,,0,0,0,,Иә, Тоцуко-чан
Dialogue: 0,1:06:36.41,1:06:37.11,Default,,0,0,0,,Осы 8 шара үшін осы тұтқаны біртіндеп бұраңыз.
Dialogue: 0,1:06:37.11,1:06:40.74,Default,,0,0,0,,Осы 8 өлшем үшін осы тұтқаны біртіндеп бұраңыз.
Dialogue: 0,1:06:37.11,1:06:40.74,Default,,0,0,0,,(Ән айтып жатқанда рифті жаттықтырыңыз)
Dialogue: 0,1:06:41.49,1:06:44.20,Default,,0,0,0,,Мұнда? Еске түсіре аласыз ба?
Dialogue: 0,1:06:45.00,1:06:46.50,Default,,0,0,0,,Соған стикер жапсырайық
Dialogue: 0,1:06:53.00,1:06:54.38,Default,,0,0,0,,Нфуфу
Dialogue: 0,1:06:55.01,1:06:58.30,Default,,0,0,0,,Ей, қар, бұл әдемі.
Dialogue: 0,1:07:05.85,1:07:08.35,Default,,0,0,0,,Қалай болса да, үйіліп жатыр...
Dialogue: 0,1:07:08.56,1:07:09.56,Default,,0,0,0,,Жақсы.
Dialogue: 0,1:07:09.56,1:07:10.98,Default,,0,0,0,,Жақсы
Dialogue: 0,1:07:09.56,1:07:10.98,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,1:07:13.61,1:07:15.86,Default,,0,0,0,,Кеме тоқтатылды!!
Dialogue: 0,1:07:15.99,1:07:17.99,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,1:07:18.24,1:07:21.16,Default,,0,0,0,,Тоцуко мен аламын
Dialogue: 0,1:07:23.58,1:07:24.66,Default,,0,0,0,,Иә
Dialogue: 0,1:07:25.75,1:07:26.91,Default,,0,0,0,,Дәмді
Dialogue: 0,1:07:27.04,1:07:27.79,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,1:07:27.79,1:07:28.62,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,1:07:27.79,1:07:28.62,Default,,0,0,0,,Хмм?
Dialogue: 0,1:07:30.79,1:07:31.92,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,1:07:33.55,1:07:34.59,Default,,0,0,0,,Не болды?
Dialogue: 0,1:07:34.76,1:07:37.09,Default,,0,0,0,,Бірдеңе дұрыс емес...
Dialogue: 0,1:07:37.26,1:07:41.60,Default,,0,0,0,,Гигураши мырза қардың кесірінен аралдан үйіне бара алмайтын сияқты.
Dialogue: 0,1:07:43.26,1:07:45.60,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:07:46.06,1:07:47.31,Default,,0,0,0,,Йошика мырза
Dialogue: 0,1:07:47.52,1:07:49.73,Default,,0,0,0,,Хигураши мырзаға қазір қоңырау шалыңыз.
Dialogue: 0,1:07:49.85,1:07:51.86,Default,,0,0,0,,(Смартфон қоңырау үні)
Dialogue: 0,1:07:52.27,1:07:53.94,Default,,0,0,0,,О, сәлем Сумика-чан...
Dialogue: 0,1:07:54.07,1:07:56.99,Default,,0,0,0,,Хигураши мырза, мен сіздің әңгімеңізді естідім.
Dialogue: 0,1:07:57.24,1:07:59.45,Default,,0,0,0,,Иа, Хиёсико мырза...
Dialogue: 0,1:08:00.28,1:08:02.45,Default,,0,0,0,,Ол жерден үйге бара алмайсың ба?
Dialogue: 0,1:08:03.87,1:08:05.16,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,1:08:06.45,1:08:08.62,Default,,0,0,0,,Мм... жоқ
Dialogue: 0,1:08:09.16,1:08:15.50,Default,,0,0,0,,Сакунага мырза және топтың басқа мүшесі Кагехира мырза...
Dialogue: 0,1:08:16.21,1:08:17.63,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:08:17.80,1:08:21.09,Default,,0,0,0,,Иә, бұл өте қауіпсіз...
Dialogue: 0,1:08:22.51,1:08:28.56,Default,,0,0,0,,Мен аманмын, бірақ бүгін үйге бара алмаймын...
Dialogue: 0,1:08:31.14,1:08:32.44,Default,,0,0,0,,Хмм...
Dialogue: 0,1:08:42.11,1:08:42.86,Default,,0,0,0,,Оқу-жаттығу лагері…
Dialogue: 0,1:08:43.20,1:08:44.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:45.28,1:08:48.75,Default,,0,0,0,,Балалар, бүгін оқу-жаттығу жиынындасыңдар.
Dialogue: 0,1:08:48.87,1:08:50.41,Default,,0,0,0,,Оқу-жаттығу лагері…
Dialogue: 0,1:08:50.87,1:08:53.17,Default,,0,0,0,,Енді сіз сондасыз
Dialogue: 0,1:08:53.29,1:08:55.50,Default,,0,0,0,,Оны мағыналы деп есептеңіз
Dialogue: 0,1:08:55.96,1:08:59.34,Default,,0,0,0,,Ешқашан өзіңізді кінәламаңыз
Dialogue: 0,1:08:59.51,1:09:04.09,Default,,0,0,0,,Мұны Сакунага-санға және басқа адамға айтыңыз.
Dialogue: 0,1:09:05.76,1:09:08.43,Default,,0,0,0,,Қалғаны өзіме байланысты.
Dialogue: 0,1:09:09.43,1:09:10.93,Default,,0,0,0,,Оқу-жаттығу лагері…
Dialogue: 0,1:09:11.39,1:09:16.15,Default,,0,0,0,,Мен көп көрпе мен заттар әкелдім, сондықтан мен кем дегенде бір түнге жақсы боламын.
Dialogue: 0,1:09:16.36,1:09:17.86,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,1:09:18.02,1:09:20.03,Default,,0,0,0,,Мен де осындамын.
Dialogue: 0,1:09:20.15,1:09:20.90,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,1:09:21.03,1:09:22.82,Default,,0,0,0,,Луи-кун үйіне қайтуы керек.
Dialogue: 0,1:09:22.95,1:09:23.91,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:09:24.36,1:09:26.87,Default,,0,0,0,,Мен оны екеумізге қалдырамыз ба деп уайымдаймын.
Dialogue: 0,1:09:27.91,1:09:31.04,Default,,0,0,0,,Сонымен қатар, бұл оқу-жаттығу жиыны.
Dialogue: 0,1:09:33.87,1:09:39.25,Default,,0,0,0,,Иә, иә, жақсы
Dialogue: 0,1:09:40.30,1:09:43.55,Default,,0,0,0,,Мен дос таптым
Dialogue: 0,1:09:44.30,1:09:47.14,Default,,0,0,0,,Сондықтан бізде оқу-жаттығу жиыны бар
Dialogue: 0,1:09:47.60,1:09:48.76,Default,,0,0,0,,Суық емес пе?
Dialogue: 0,1:09:49.18,1:09:52.85,Default,,0,0,0,,Жарайды, мен үйден біраз заттар әкелдім.
Dialogue: 0,1:09:52.98,1:09:54.23,Default,,0,0,0,,Қашан бұрын?
Dialogue: 0,1:09:56.56,1:09:57.77,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:09:58.36,1:10:00.15,Default,,0,0,0,,Өйткені біз ескі шіркеудеміз
Dialogue: 0,1:10:00.65,1:10:02.86,Default,,0,0,0,,Жылы болуды қадағалаңыз
Dialogue: 0,1:10:03.19,1:10:05.20,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:10:05.32,1:10:05.99,Default,,0,0,0,,Ха~
Dialogue: 0,1:10:06.99,1:10:09.95,Default,,0,0,0,,Ия... хех
Dialogue: 0,1:10:13.00,1:10:14.66,Default,,0,0,0,,О!?
Dialogue: 0,1:10:20.50,1:10:22.17,Default,,0,0,0,,(сіріңкені соққан дыбыс)
Dialogue: 0,1:10:44.40,1:10:47.24,Default,,0,0,0,,Екеуің көктемнен бастап не істейсіңдер?
Dialogue: 0,1:10:47.91,1:10:49.07,Default,,0,0,0,,Көктемнен?
Dialogue: 0,1:10:49.20,1:10:53.95,Default,,0,0,0,,Иә, мен университетке барамын.
Dialogue: 0,1:10:56.41,1:11:00.92,Default,,0,0,0,,Үй Бұл аралда ұзақ уақыт бойы операция жасап жүрген дәрігер.
Dialogue: 0,1:11:01.09,1:11:03.13,Default,,0,0,0,,Мен мұны мұрагер ету керек деп ойладым...
Dialogue: 0,1:11:05.59,1:11:09.14,Default,,0,0,0,,Топ шынымен де осында жаттығады...
Dialogue: 0,1:11:10.51,1:11:16.35,Default,,0,0,0,,Негізі мен үйде музыкамен айналысып жүргенімді жасырамын.
Dialogue: 0,1:11:16.73,1:11:22.32,Default,,0,0,0,,Мен үшін алаңдағаныңызды қаламаймын, өйткені мен ғана үйді мұрагер етіп аламын.
Dialogue: 0,1:11:25.78,1:11:28.20,Default,,0,0,0,,Мектепке оқуға түсу үшін қалаға бару
Dialogue: 0,1:11:28.74,1:11:33.66,Default,,0,0,0,,Қаладағы қайта өңдеу цехына барған сайын құрал-жабдық сатып аламын.
Dialogue: 0,1:11:33.99,1:11:35.66,Default,,0,0,0,,Мұнда жасырын түрде
Dialogue: 0,1:11:37.04,1:11:41.38,Default,,0,0,0,,Мен сіздің пайдаланылған кітап дүкенінде әрқашан гитарада ойнағаныңызды көрдім.
Dialogue: 0,1:11:43.50,1:11:47.84,Default,,0,0,0,,Мен сол кезде сізге батылдықпен хабарласқаныма өте қуаныштымын.
Dialogue: 0,1:11:48.68,1:11:51.51,Default,,0,0,0,,Мен қазір шынымен бақыттымын.
Dialogue: 0,1:11:53.22,1:11:56.52,Default,,0,0,0,,Мен бұл туралы әлі ойлаған жоқпын.
Dialogue: 0,1:11:57.85,1:12:00.02,Default,,0,0,0,,Енді не болады?
Dialogue: 0,1:12:01.90,1:12:05.86,Default,,0,0,0,,Мен көп нәрсені дұрыс емес ретпен алдым деп ойлаймын.
Dialogue: 0,1:12:08.07,1:12:09.28,Default,,0,0,0,,Мен
Dialogue: 0,1:12:09.65,1:12:14.99,Default,,0,0,0,,Үйден шық, әжең сені ағаңның қасында өсірсін.
Dialogue: 0,1:12:17.20,1:12:21.42,Default,,0,0,0,,Себебі сен мені өте бағалайсың.
Dialogue: 0,1:12:22.92,1:12:29.09,Default,,0,0,0,,Мен шынымен де жақсы қыз болмасам да, үмітімді ақтағым келеді.
Dialogue: 0,1:12:30.30,1:12:34.05,Default,,0,0,0,,Қашып кеткеніме өкіндім.
Dialogue: 0,1:12:34.89,1:12:38.18,Default,,0,0,0,,Мектепті тастағаныңызға өкінесіз бе?
Dialogue: 0,1:12:40.39,1:12:41.90,Default,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,1:12:43.44,1:12:46.90,Default,,0,0,0,,Бірақ бұл менің шешімім болды.
Dialogue: 0,1:12:47.03,1:12:49.94,Default,,0,0,0,,Сенің ашуланғаның дұрыс емес деп ойлаймын.
Dialogue: 0,1:12:50.65,1:12:54.16,Default,,0,0,0,,Сен және Луи өте әдемісіңдер.
Dialogue: 0,1:12:54.87,1:12:59.62,Default,,0,0,0,,Сабырлы, түсінікті, түсі сондай.
Dialogue: 0,1:13:01.16,1:13:02.46,Default,,0,0,0,,Мен...
Dialogue: 0,1:13:02.71,1:13:05.84,Default,,0,0,0,,Адамдарды түрлі түсте көретін әдетім бар...
Dialogue: 0,1:13:06.13,1:13:11.47,Default,,0,0,0,,Мен мұны құпия ұстаймын, өйткені адамдар мені біртүрлі деп ойлайды...
Dialogue: 0,1:13:12.05,1:13:14.47,Default,,0,0,0,,Түстерді көру деген нені білдіреді?
Dialogue: 0,1:13:16.14,1:13:18.06,Default,,0,0,0,,Луи-кун жасыл түсті
Dialogue: 0,1:13:18.39,1:13:20.27,Default,,0,0,0,,Сен көксің
Dialogue: 0,1:13:20.98,1:13:27.23,Default,,0,0,0,,Адам бойындағы әдемі түстерді сезіну сияқты...
Dialogue: 0,1:13:27.90,1:13:29.61,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,1:13:32.53,1:13:36.99,Default,,0,0,0,,Енді біз махаббат пен құпиялармен бөлісеміз
Dialogue: 0,1:13:45.17,1:13:46.46,Default,,0,0,0,,Хм
Dialogue: 0,1:13:46.63,1:13:48.75,Default,,0,0,0,,Луи-кун бірдеңе деді.
Dialogue: 0,1:13:48.88,1:13:49.55,Default,,0,0,0,,Ах
Dialogue: 0,1:13:50.63,1:13:54.63,Default,,0,0,0,,Дұрыс, ауа райы туралы ақпарат...
Dialogue: 0,1:13:56.22,1:13:57.68,Default,,0,0,0,,(Радио шуы)
Dialogue: 0,1:13:57.80,1:14:01.14,Default,,0,0,0,,Радиотолқындарды ұстау қиын.
Dialogue: 0,1:14:03.31,1:14:05.73,Default,,0,0,0,,(Радио дұрыс реттелген)
Dialogue: 0,1:14:06.31,1:14:08.94,Default,,0,0,0,,(♪ «Жизель, I акт: Pas seul - Pas de deux des jeunes paysans»)
Dialogue: 0,1:14:09.15,1:14:10.32,Default,,0,0,0,,Ха
Dialogue: 0,1:14:10.69,1:14:12.11,Default,,0,0,0,,Не болды?
Dialogue: 0,1:14:12.40,1:14:13.61,Default,,0,0,0,,Бұл Жизель.
Dialogue: 0,1:14:14.74,1:14:16.16,Default,,0,0,0,,Бұл сіздің сүйікті әніңіз бе?
Dialogue: 0,1:14:16.49,1:14:18.95,Default,,0,0,0,,Иә, арман әнім
Dialogue: 0,1:14:19.49,1:14:24.37,Default,,0,0,0,,Мен кішкентай кезімде балет сабағын алдым, үйімнің бірінші қабатында балет сабағы болатын.
Dialogue: 0,1:14:25.71,1:14:30.13,Default,,0,0,0,,Мен жұмыстан шықтым, өйткені мен онша жақсы емес едім.
Dialogue: 0,1:14:30.92,1:14:33.84,Default,,0,0,0,,Бұл әнге билеу менің арманым еді.
Dialogue: 0,1:14:35.18,1:14:38.85,Default,,0,0,0,,Тоцуко-чан, сіз бұл әнді біраз ойнай аласыз.
Dialogue: 0,1:14:44.43,1:14:46.27,Default,,0,0,0,,(онда орындау дыбысы)
Dialogue: 0,1:14:54.69,1:14:58.70,Default,,0,0,0,,(♪ «Жизель, I акт: Pas seul - Pas de deux des jeunes paysans» Тереминнің орындауындағы дыбыс)
Dialogue: 0,1:15:14.63,1:15:17.18,Default,,0,0,0,,Эххе, мынандай бірдеңе...
Dialogue: 0,1:15:18.51,1:15:20.64,Default,,0,0,0,,Мен қиын істерді істей алмаймын...
Dialogue: 0,1:15:21.22,1:15:24.60,Default,,0,0,0,,Мен оны дұрыс меңгермегендіктен, көзбен көшіріп алдым.
Dialogue: 0,1:15:25.23,1:15:27.27,Default,,0,0,0,,Құлақпен көшіру сияқты ма?
Dialogue: 0,1:15:27.77,1:15:29.06,Default,,0,0,0,,Сонымен
Dialogue: 0,1:15:29.69,1:15:32.27,Default,,0,0,0,,Күте тұрыңыз, мен де оны ойнағым келеді.
Dialogue: 0,1:15:33.36,1:15:36.74,Default,,0,0,0,,(Гитара мен онда орындалатын дыбыс)
Dialogue: 0,1:15:50.83,1:15:52.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:05.18,1:16:07.02,Default,,0,0,0,,Уау...
Dialogue: 0,1:16:13.40,1:16:16.11,Default,,0,0,0,,Кешегі күн үшін көп рахмет.
Dialogue: 0,1:16:16.28,1:16:17.78,Default,,0,0,0,,Жоқ
Dialogue: 0,1:16:18.53,1:16:21.28,Default,,0,0,0,,Оқу-жаттығу жиыны қалай өтті?
Dialogue: 0,1:16:21.41,1:16:23.03,Default,,0,0,0,,Иә
Dialogue: 0,1:16:24.08,1:16:26.45,Default,,0,0,0,,Өзгертуге болмайтын нәрсені қабылдаңыз
Dialogue: 0,1:16:26.58,1:16:29.08,Default,,0,0,0,,Өзгертуге болатын нәрсені өзгерту батылдығы.
Dialogue: 0,1:16:29.21,1:16:33.63,Default,,0,0,0,,Мен аздап түсінгендей болдым.
Dialogue: 0,1:16:35.25,1:16:37.46,Default,,0,0,0,,Ұзақ уақыт үнсіз қалғаным үшін кешіріңіз.
Dialogue: 0,1:16:37.96,1:16:40.26,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,1:16:40.68,1:16:43.43,Default,,0,0,0,,Мен университетке дұрыс барамын.
Dialogue: 0,1:16:44.05,1:16:46.64,Default,,0,0,0,,Сізден бірдеңе жасырғаным үшін кешіріңіз.
Dialogue: 0,1:16:46.89,1:16:49.98,Default,,0,0,0,,Бірақ мен әрқашан музыканы жақсы көретінмін.
Dialogue: 0,1:16:51.56,1:16:53.10,Default,,0,0,0,,Мен танысқан балалармен
Dialogue: 0,1:16:53.35,1:16:55.57,Default,,0,0,0,,Топ құру
Dialogue: 0,1:16:57.28,1:16:59.90,Default,,0,0,0,,Келесі жолы мен ойнаймын
Dialogue: 0,1:17:00.53,1:17:02.78,Default,,0,0,0,,Бұл өте қызық
Dialogue: 0,1:17:04.57,1:17:07.24,Default,,0,0,0,,Сіз мені көруге келе аласыз ба?
Dialogue: 0,1:17:07.66,1:17:09.20,Default,,0,0,0,,Келгеніңді қалаймын.
Dialogue: 0,1:17:15.59,1:17:19.17,Default,,0,0,0,,(жанды орындауға дайындық)
Dialogue: 0,1:17:45.70,1:17:47.74,Default,,0,0,0,,Иә, өтінемін, Иә
Dialogue: 0,1:17:48.99,1:17:49.95,Default,,0,0,0,,Суретке түсір, суретке түсір!
Dialogue: 0,1:17:51.50,1:17:52.16,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,1:17:53.83,1:17:57.00,Default,,0,0,0,,Біз тобымыз үшін аккаунт жасадық.
Dialogue: 0,1:17:57.13,1:17:59.84,Default,,0,0,0,,Уау, Широнекодо
Dialogue: 0,1:17:59.96,1:18:02.42,Default,,0,0,0,,Келесі жасаған әнімді жүктей аламын ба?
Dialogue: 0,1:18:03.09,1:18:06.51,Default,,0,0,0,,Не?! Біз интернет әлеміндеміз!?
Dialogue: 0,1:18:06.84,1:18:10.06,Default,,0,0,0,,Мен оны біреудің тыңдағанын қалаймын.
Dialogue: 0,1:18:10.43,1:18:13.52,Default,,0,0,0,,Ой, бұл керемет, балам.
Dialogue: 0,1:18:14.27,1:18:15.98,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,1:18:16.69,1:18:18.31,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,1:18:18.94,1:18:19.77,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:20.23,1:18:22.15,Default,,0,0,0,,I Бұл туралы ойласам,
Dialogue: 0,1:18:22.28,1:18:24.99,Default,,0,0,0,,Мектепті тастап кетсем де, бүгін тікелей эфирде болғаным жақсы болды ма деп ойлаймын.
Dialogue: 0,1:18:25.66,1:18:29.83,Default,,0,0,0,,Не айтып тұрсың, сен сондай ынталы адам сияқтысың ба?
Dialogue: 0,1:18:29.95,1:18:32.50,Default,,0,0,0,,Мен мүлдем бөгде адаммын ба?
Dialogue: 0,1:18:32.62,1:18:34.96,Default,,0,0,0,,Хигураши-сан Кими-чан!!
Dialogue: 0,1:18:35.33,1:18:36.67,Default,,0,0,0,,Қалайсың!?
Dialogue: 0,1:18:36.96,1:18:39.13,Default,,0,0,0,,Уау, сенің киімің керемет екен.
Dialogue: 0,1:18:39.54,1:18:43.21,Default,,0,0,0,,Кенет үнсіз қалғаным үшін кешіріңіз...
Dialogue: 0,1:18:43.71,1:18:47.34,Default,,0,0,0,,Сондай-ақ, мен бүгін өнер көрсетуім керек...
Dialogue: 0,1:18:48.93,1:18:51.01,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,1:18:51.18,1:18:52.43,Default,,0,0,0,,Барлығы
Dialogue: 0,1:18:53.43,1:18:56.14,Default,,0,0,0,,Қазір сахнаға өтіңіз.
Dialogue: 0,1:18:58.56,1:19:01.52,Default,,0,0,0,,Хиёсико-сенсэй, бұл Руи Кагехира.
Dialogue: 0,1:19:01.73,1:19:05.03,Default,,0,0,0,,Бұл Кагехира! Бүгінгі күн үшін рахмет!
Dialogue: 0,1:19:05.15,1:19:07.91,Default,,0,0,0,,Жоқ, мен оны асыға күтемін.
Dialogue: 0,1:19:08.07,1:19:09.82,Default,,0,0,0,,Бүгін ойналатын ән -
Dialogue: 0,1:19:10.28,1:19:13.41,Default,,0,0,0,,Мен Хигураши мырзадан оны алдын ала тыңдауын өтіндім...
Dialogue: 0,1:19:13.79,1:19:18.50,Default,,0,0,0,,«Рефлексия ~Жақсы, әдемі және шындық~»
Dialogue: 0,1:19:18.62,1:19:21.25,Default,,0,0,0,,-дегі гитара рифі керемет.
Dialogue: 0,1:19:21.79,1:19:26.22,Default,,0,0,0,,Дыбыссыз күйде соққы Бұл менің жүрегімді қатты тебірентті
Dialogue: 0,1:19:26.34,1:19:27.26,Default,,0,0,0,,Мен үшін одан да көп...
Dialogue: 0,1:19:27.38,1:19:30.51,Default,,0,0,0,,Мұғалім, сіз өте білімдісіз.
Dialogue: 0,1:19:30.68,1:19:32.14,Default,,0,0,0,,Хмм...
Dialogue: 0,1:19:32.93,1:19:36.48,Default,,0,0,0,,Кешіріңіз, жабдықты тексеріңіз.
Dialogue: 0,1:19:36.73,1:19:37.98,Default,,0,0,0,,Иә!
Dialogue: 0,1:19:38.48,1:19:39.90,Default,,0,0,0,,Шын мәнінде
Dialogue: 0,1:19:41.94,1:19:42.90,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:43.02,1:19:48.61,Default,,0,0,0,,Мен сіздің жасыңызда рок тобында ойнадым...
Dialogue: 0,1:19:49.45,1:19:54.04,Default,,0,0,0,,Мен қорқамын... Топ атымен "Алла тағала"
Dialogue: 0,1:19:57.00,1:19:59.50,Default,,0,0,0,,Мүмкін болса өшіргім келеді...
Dialogue: 0,1:20:00.12,1:20:05.05,Default,,0,0,0,,Мұғалім, өзгерте алмайтын нәрселерді неге қабылдауға тырыспайсыз?
Dialogue: 0,1:20:09.51,1:20:12.68,Default,,0,0,0,,Осыдан кейін Широнекодо тобының орындауы.
Dialogue: 0,1:20:12.80,1:20:15.18,Default,,0,0,0,,Барлығыңыз, ләззат алыңыз.
Dialogue: 0,1:20:15.31,1:20:17.93,Default,,0,0,0,,(шапалақтау)
Dialogue: 0,1:20:23.02,1:20:26.86,Default,,0,0,0,,Эй, Тоцуко, Тоцуко қандай түсті?
Dialogue: 0,1:20:27.49,1:20:29.82,Default,,0,0,0,,Негізі мен білмеймін.
Dialogue: 0,1:20:31.78,1:20:32.99,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:20:35.99,1:20:36.74,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,1:20:37.29,1:20:38.20,Default,,0,0,0,,Ах
Dialogue: 0,1:20:38.45,1:20:40.04,Default,,0,0,0,,Басталып жатыр!
Dialogue: 0,1:20:45.75,1:20:46.59,Default,,0,0,0,,
Dialogue: 0,1:20:46.92,1:20:49.92,Default,,0,0,0,,(♪ «Рефлексия ~Жақсы, әдемі, шындық~» орындау дыбысы)
Dialogue: 0,1:21:19.66,1:21:26.09,Default,,0,0,0,,♪ Ертең
Dialogue: 0,1:21:26.25,1:21:34.26,Default,,0,0,0,,♪ Мен де ертең келемін
Dialogue: 0,1:21:34.84,1:21:41.43,Default,,0,0,0,,♪ Күнге
Dialogue: 0,1:21:41.60,1:21:49.69,Default,,0,0,0,,♪ Жарық жолы
Dialogue: 0,1:21:50.15,1:21:57.20,Default,,0,0,0,,♪ Аспан әлі де жарқырап, жылтыр
Dialogue: 0,1:21:57.74,1:22:05.37,Default,,0,0,0,,♪ Бірге, құдіретті АЛЛА
Dialogue: 0,1:22:20.97,1:22:27.56,Default,,0,0,0,,♪ Көп мағыналы
Dialogue: 0,1:22:27.69,1:22:35.78,Default,,0,0,0,,♪ Шекара жоқ
Dialogue: 0,1:22:36.20,1:22:43.29,Default,,0,0,0,,♪ Жүрегімнің үніне өт
Dialogue: 0,1:22:43.70,1:22:51.50,Default,,0,0,0,,♪ Мен сені жақсы көремін
Dialogue: 0,1:23:07.35,1:23:08.69,Default,,0,0,0,,Сіз... (Симокава) Ол кім?
Dialogue: 0,1:23:08.81,1:23:09.69,Default,,0,0,0,,Неге...
Dialogue: 0,1:23:09.94,1:23:11.11,Default,,0,0,0,,Кими-сенпай!?
Dialogue: 0,1:23:11.23,1:23:13.61,Default,,0,0,0,,Ал қалғандары кімдер? Дұрыс па?
Dialogue: 0,1:23:13.73,1:23:15.15,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:23:15.82,1:23:18.32,Default,,0,0,0,,Соборда күнде жалғыз болатын бала
Dialogue: 0,1:23:18.45,1:23:19.28,Default,,0,0,0,,Эй
Dialogue: 0,1:23:19.41,1:23:20.66,Default,,0,0,0,,Хмм...
Dialogue: 0,1:23:23.70,1:23:26.62,Default,,0,0,0,,Тоцуко!!
Dialogue: 0,1:23:28.04,1:23:31.04,Default,,0,0,0,,(♪ «Арку» орындау дыбысы)
Dialogue: 0,1:23:50.27,1:24:01.03,Default,,0,0,0,,♪ Жарықты жағыңыз
Dialogue: 0,1:24:01.62,1:24:11.54,Default,,0,0,0,,♪ Біреудің арманы
Dialogue: 0,1:24:13.13,1:24:23.93,Default,,0,0,0,,♪ Жарықтан гөрі сүйіспеншілікке еріңіз
Dialogue: 0,1:24:24.47,1:24:34.77,Default,,0,0,0,,♪ Гүлге айналып, гүлденгім келеді
Dialogue: 0,1:24:35.61,1:24:37.61,Default,,0,0,0,,(онда орындау дыбысы)
Dialogue: 0,1:24:58.01,1:25:08.77,Default,,0,0,0,,♪ Жарық жыпылықтайды
Dialogue: 0,1:25:09.60,1:25:18.94,Default,,0,0,0,,♪ Жұмсақ
Dialogue: 0,1:25:20.95,1:25:31.79,Default,,0,0,0,,♪ Көтерілген судың сыбдырын біл
Dialogue: 0,1:25:32.25,1:25:43.05,Default,,0,0,0,,♪ Бір орында тұрып саған махаббат әнін айтамын
Dialogue: 0,1:25:43.51,1:25:54.52,Default,,0,0,0,,♪ Сіз жүре аламын деп ойлайсыз ба? Сіз оны ести аласыз ба?
Dialogue: 0,1:25:54.65,1:26:05.28,Default,,0,0,0,,♪ Дыбыс толқындары және осы дауыс
Dialogue: 0,1:26:43.49,1:26:46.49,Default,,0,0,0,,(♪ «Сәрсенбі, алтын, жер, от, ағаш, жер, көк, әумин» орындау дыбысы)
Dialogue: 0,1:26:58.25,1:27:01.21,Default,,0,0,0,,♪ Су, Металл, Жер, От, Ағаш, Жер, Аспан Әумин
Dialogue: 0,1:27:04.84,1:27:08.05,Default,,0,0,0,,♪ Су, Металл, Жер, От, Ағаш, Жер, Аспан Әумин
Dialogue: 0,1:27:24.69,1:27:31.24,Default,,0,0,0,,♪ Түсің атылып кетті, миым көкке толды, Әумин.
Dialogue: 0,1:27:31.45,1:27:34.54,Default,,0,0,0,,♪ Кенет пайда болды.
Dialogue: 0,1:27:34.66,1:27:37.96,Default,,0,0,0,,♪ Расында Луи безі, кемпірқосақ түсті перделер
Dialogue: 0,1:27:38.21,1:27:41.13,Default,,0,0,0,,♪ Айналдыру және жыпылықтау
Dialogue: 0,1:27:41.46,1:27:44.63,Default,,0,0,0,,♪ Айналдыру және жарқырау
Dialogue: 0,1:27:44.80,1:27:47.84,Default,,0,0,0,,♪ Айналдыру және жыпылықтау
Dialogue: 0,1:27:47.97,1:27:49.59,Default,,0,0,0,,♪ Толқынды, қызық, толқытады
Dialogue: 0,1:27:49.72,1:27:51.14,Default,,0,0,0,,♪ Мен планетамын
Dialogue: 0,1:27:51.30,1:27:52.89,Default,,0,0,0,,♪ Су, Металл, Жер, От, Ағаш
Dialogue: 0,1:27:53.01,1:27:54.22,Default,,0,0,0,,♪ Жер жәннәт аумин
Dialogue: 0,1:27:54.39,1:27:56.02,Default,,0,0,0,,♪ Кешегі тамақ қандай болды?
Dialogue: 0,1:27:56.31,1:27:57.52,Default,,0,0,0,,♪ Жылы
Dialogue: 0,1:27:57.85,1:27:59.44,Default,,0,0,0,,♪ Су, Металл, Жер, От, Ағаш
Dialogue: 0,1:27:59.56,1:28:00.94,Default,,0,0,0,,♪ Жер жәннәт аумин
Dialogue: 0,1:28:01.15,1:28:06.40,Default,,0,0,0,,♪ Дәл осылай, екеуміз ғаламның ақырына дейін
Dialogue: 0,1:28:24.55,1:28:25.88,Default,,0,0,0,,♪ Су, Металл, Жер, От, Ағаш
Dialogue: 0,1:28:26.01,1:28:27.38,Default,,0,0,0,,♪ Жер жәннат аумин
Dialogue: 0,1:28:27.55,1:28:29.26,Default,,0,0,0,,♪ Кешегі тамақ қандай болды?
Dialogue: 0,1:28:29.38,1:28:30.93,Default,,0,0,0,,♪ Жылы
Dialogue: 0,1:28:31.05,1:28:32.68,Default,,0,0,0,,♪ Су, Металл, Жер, От, Ағаш
Dialogue: 0,1:28:32.80,1:28:34.10,Default,,0,0,0,,♪ Жер жәннәт аумин
Dialogue: 0,1:28:34.26,1:28:37.56,Default,,0,0,0,,♪ Дәл осылай, екеуміз ғаламның ақырына дейін
Dialogue: 0,1:28:37.68,1:28:39.14,Default,,0,0,0,,♪ Су, Металл, Жер, От, Ағаш
Dialogue: 0,1:28:39.27,1:28:40.73,Default,,0,0,0,,♪ Жер жәннат аумин
Dialogue: 0,1:28:40.85,1:28:42.52,Default,,0,0,0,,♪ Кешегі тамақ қандай болды?
Dialogue: 0,1:28:42.65,1:28:44.02,Default,,0,0,0,,♪ Жылы
Dialogue: 0,1:28:44.15,1:28:45.86,Default,,0,0,0,,♪ Су, Металл, Жер, От, Ағаш
Dialogue: 0,1:28:45.98,1:28:47.36,Default,,0,0,0,,♪ Жер жәннәт аумин
Dialogue: 0,1:28:47.53,1:28:54.20,Default,,0,0,0,,♪ Дәл осылай, екеуміз ғаламның ақырына дейін
Dialogue: 0,1:29:18.85,1:29:20.85,Default,,0,0,0,,Тоцуко~!
Dialogue: 0,1:29:18.85,1:29:20.85,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:29:22.73,1:29:24.27,Default,,0,0,0,,Мен сені жақсы көремін~!
Dialogue: 0,1:29:57.60,1:30:00.60,Default,,0,0,0,,(фортепианоның әлсіз дыбысы)
Dialogue: 0,1:30:19.95,1:30:23.96,Default,,0,0,0,,(♪ «Жизель, I акт: Pas seul - Pas de deux des jeunes paysans» орындау дыбысы)
Dialogue: 0,1:31:37.53,1:31:38.61,Default,,0,0,0,,Мен оны көріп тұрмын!
Dialogue: 0,1:31:53.71,1:31:56.01,Default,,0,0,0,,(Ойнау аялдамасы)
Dialogue: 0,1:31:56.76,1:32:01.01,Default,,0,0,0,,Ах… Хехе…
Dialogue: 0,1:32:05.85,1:32:08.85,Default,,0,0,0,,(Ұзатуға шыққан адамдардың дауысы)
Dialogue: 0,1:32:16.49,1:32:18.11,Default,,0,0,0,,Жақында кездескенше!
Dialogue: 0,1:32:19.28,1:32:20.99,Default,,0,0,0,,Аман болыңыз!
Dialogue: 0,1:32:37.34,1:32:39.80,Default,,0,0,0,,Дұрыс кездеспегеніміз жақсы болды деп ойлаймын.
Dialogue: 0,1:32:43.10,1:32:44.93,Default,,0,0,0,,Жақында тағы кездесеміз
Dialogue: 0,1:32:45.76,1:32:47.22,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,1:32:47.64,1:32:48.73,Default,,0,0,0,,Иә
Dialogue: 0,1:32:53.81,1:32:55.40,Default,,0,0,0,,Бұл көңілді болды.
Dialogue: 0,1:32:59.99,1:33:01.03,Default,,0,0,0,,Иә
Dialogue: 0,1:33:01.32,1:33:03.12,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,1:33:05.99,1:33:08.83,Default,,0,0,0,,Бұл Луи-кунның қайығы. Сен, кеттік...
Dialogue: 0,1:33:11.42,1:33:12.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:20.26,1:33:21.43,Default,,0,0,0,,Ах
Dialogue: 0,1:33:35.69,1:33:38.69,Default,,0,0,0,,(Сіздің қатты тыныс алуыңыз)
Dialogue: 0,1:33:40.40,1:33:41.65,Default,,0,0,0,,(Сіз терең дем аласыз)
Dialogue: 0,1:33:41.78,1:33:45.66,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:33:48.83,1:33:51.00,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:33:51.12,1:33:53.62,Default,,0,0,0,,Луи-кун!
Dialogue: 0,1:33:55.71,1:34:00.51,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:34:18.82,1:34:20.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:20.94,1:34:22.28,Default,,0,0,0,,(Тоцуко ентігу дыбысы)
Dialogue: 0,1:35:06.24,1:35:13.08,Default,,0,0,0,,♪ Жоғарыға қарасам, басыма бұлт үйіріледі
Dialogue: 0,1:35:13.58,1:35:21.71,Default,,0,0,0,,♪ Пішінін еркін өзгертетін және қозғалатын бұлттар
Dialogue: 0,1:35:21.84,1:35:28.59,Default,,0,0,0,,♪ Өзімді өзім күткеннен де көп іздеу
Dialogue: 0,1:35:29.18,1:35:36.35,Default,,0,0,0,,♪ Мен абдырап, ауырып, аяғыма ғана қарап отырдым.
Dialogue: 0,1:35:36.48,1:35:44.11,Default,,0,0,0,,♪ Ресми түрде ойланбай-ақ көңіл көтеруге болады.
Dialogue: 0,1:35:44.78,1:35:53.24,Default,,0,0,0,,♪ Сол күні сен маған басқан пернетақтаның дыбысын үйреттің.
Dialogue: 0,1:35:54.29,1:36:02.75,Default,,0,0,0,,♪ Күмәнімді былтыр күртешенің қалтасында қалдырдым.
Dialogue: 0,1:36:02.88,1:36:10.26,Default,,0,0,0,,♪ Жаңа «мен» бүгін басталады
Dialogue: 0,1:36:10.39,1:36:18.35,Default,,0,0,0,,♪ Жүрегім әлі тұрақсыз, шымылдықтай тербеледі
Dialogue: 0,1:36:18.48,1:36:25.36,Default,,0,0,0,,♪ Соққан желдің жайлылығын сезін
Dialogue: 0,1:36:28.15,1:36:34.83,Default,,0,0,0,,♪ Тәжірибе ұпайларын жинау арқылы сәтсіздікке жол бермеңіз
Dialogue: 0,1:36:35.41,1:36:43.59,Default,,0,0,0,,♪ Жауапты оңай шығаруды біліңіз
Dialogue: 0,1:36:43.71,1:36:50.63,Default,,0,0,0,,♪ Бірақ ол бір жерде қырылған болуы керек.
Dialogue: 0,1:36:51.13,1:36:58.18,Default,,0,0,0,,♪ Батыл және көріксіз маңызды нәрселер бар.
Dialogue: 0,1:36:58.31,1:37:06.27,Default,,0,0,0,,♪ «Сіз өзіңізге ұнайтын кез келген түсті таңдап, сурет сала аласыз».
Dialogue: 0,1:37:06.65,1:37:15.45,Default,,0,0,0,,♪ Егер бала сурет салуға қабілетсіз болса, соны айтып, сурет салу қағазын беріңіз.
Dialogue: 0,1:37:17.08,1:37:18.58,Default,,0,0,0,,♪ Не...
Dialogue: 0,1:37:18.70,1:37:26.59,Default,,0,0,0,,♪ Шатастырылған аяқ киімінің бауын шешуге тырыстым.
Dialogue: 0,1:37:26.71,1:37:34.14,Default,,0,0,0,,♪ Мен оны ұмытып, ойнай бастадым, мен білмей тұрып шешілді.
Dialogue: 0,1:37:34.26,1:37:42.23,Default,,0,0,0,,♪ Оқиғалар тізбегі орын алса да, бәрі жоспарланғандай болмаса да
Dialogue: 0,1:37:42.35,1:37:49.11,Default,,0,0,0,,♪ Білсеңіз, ләззат алыңыз.
Dialogue: 0,1:37:50.36,1:37:55.32,Default,,0,0,0,,♪ Әр адамның жүрегінде
Dialogue: 0,1:37:58.12,1:38:06.63,Default,,0,0,0,,♪ Бұлыңғыр және лайлы ландшафт бар.
Dialogue: 0,1:38:08.88,1:38:16.51,Default,,0,0,0,,♪ Еркін болудың көптеген жолдары бар.
Dialogue: 0,1:38:16.93,1:38:25.77,Default,,0,0,0,,♪ Кеше түнде шерткен алты ішектің дыбысы маған үйретті
Dialogue: 0,1:38:28.40,1:38:36.82,Default,,0,0,0,,♪ Мұңымды кешегі көйлек қалтасында қалдырамын.
Dialogue: 0,1:38:36.95,1:38:44.41,Default,,0,0,0,,♪ Жаңа сіз бүгін бастайсыз
Dialogue: 0,1:38:44.54,1:38:52.46,Default,,0,0,0,,♪ Жүрегім тұрақсыз болды, шымылдықтай тербеледі
Dialogue: 0,1:38:52.59,1:38:59.30,Default,,0,0,0,,♪ Соққан желдің жайлылығын сезініңіз
Dialogue: 0,1:39:00.64,1:39:05.27,Default,,0,0,0,,♪ Мен осы сәттен ләззат алғым келеді
Dialogue: 0,1:39:30.54,1:39:31.67,Default,,0,0,0,,Басылды!
Dialogue: 0,1:39:31.80,1:39:32.84,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:39:32.96,1:39:35.01,Default,,0,0,0,,Ах! Кассета айналып жатыр ма?
Dialogue: 0,1:39:35.13,1:39:36.68,Default,,0,0,0,,Иә! Айналып жатыр
Dialogue: 0,1:39:38.09,1:39:39.05,Default,,0,0,0,,Сонымен…
Dialogue: 0,1:39:39.18,1:39:40.76,Default,,0,0,0,,Иә!
Dialogue: 0,1:39:40.89,1:39:44.89,Default,,0,0,0,,(♪ «Ср, Металл, Жер, От, Ағаш, Жер, Аспан, Аумин» ойнату дыбысы)
Dialogue: 0,1:40:02.03,1:40:08.71,Default,,0,0,0,,♪ Түсіңіз жарылып кетті. Миым жерге толып кетті аумин.
Dialogue: 0,1:40:08.83,1:40:11.88,Default,,0,0,0,,♪ Кенет пайда болды.
Dialogue: 0,1:40:12.00,1:40:15.42,Default,,0,0,0,,♪ Расында Луи бездері, кемпірқосақ түсті перделер
Dialogue: 0,1:40:15.55,1:40:18.59,Default,,0,0,0,,♪ Айналдыру және жыпылықтау
Dialogue: 0,1:40:18.72,1:40:22.05,Default,,0,0,0,,♪ Айналдыру және жарқырау
Dialogue: 0,1:40:22.18,1:40:25.18,Default,,0,0,0,,♪ Айналдыру және жыпылықтау
Dialogue: 0,1:40:25.31,1:40:27.06,Default,,0,0,0,,♪ Толқынды, қызық, толқытады
Dialogue: 0,1:40:27.18,1:40:28.73,Default,,0,0,0,,♪ Мен планетамын
Dialogue: 0,1:40:28.85,1:40:30.27,Default,,0,0,0,,♪ Су, Металл, Жер, От, Ағаш
Dialogue: 0,1:40:30.40,1:40:31.73,Default,,0,0,0,,♪ Жер жәннәт аумин
Dialogue: 0,1:40:33.23,1:40:39.23,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
