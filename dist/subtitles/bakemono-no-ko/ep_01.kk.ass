Dialogue: 0,1:28:04.91,1:28:08.92,Default,,0000,0000,0000,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,1:28:15.92,1:28:19.93,Default,,0000,0000,0000,,Кешіріңіз... Ичирохико Кешіріңіз.
Dialogue: 0,1:28:19.93,1:28:21.93,Default,,0000,0000,0000,,Ичирохиконың бұл күші➡
Dialogue: 0,1:28:21.93,1:28:24.93,Default,,0000,0000,0000,,Құбыжықтар телекинезінде және т.б.
Dialogue: 0,1:28:21.93,1:28:24.93,Default,,0000,0000,0000,,Ешқашан
Dialogue: 0,1:28:24.93,1:28:29.94,Default,,0000,0000,0000,,Адамның кеудесінде ғана орналасса керек
Dialogue: 0,1:28:24.93,1:28:29.94,Default,,0000,0000,0000,,Қараңғылықтан туған күш.
Dialogue: 0,1:28:29.94,1:28:34.94,Default,,0000,0000,0000,,Соши-сама... бұрынғыдан.
Dialogue: 0,1:28:29.94,1:28:34.94,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,1:28:34.94,1:28:38.95,Default,,0000,0000,0000,,Инозан Маған аудармасын айтып беріңізші.
Dialogue: 0,1:28:44.95,1:28:49.96,Default,,0000,0000,0000,,(нәресте жылады)
Dialogue: 0,1:28:52.96,1:28:55.96,Default,,0000,0000,0000,,(нәресте жылады)
Dialogue: 0,1:28:57.97,1:29:01.90,Default,,0000,0000,0000,,(нәресте жылады)
Dialogue: 0,1:29:01.90,1:29:05.91,Default,,0000,0000,0000,,Нағыз ата-анаға
Dialogue: 0,1:29:01.90,1:29:05.91,Default,,0000,0000,0000,,Кейбір ауыр жағдайлар болуы керек.
Dialogue: 0,1:29:05.91,1:29:08.91,Default,,0000,0000,0000,,Оны барлығынан жасырыңыз
Dialogue: 0,1:29:05.91,1:29:08.91,Default,,0000,0000,0000,,Мен оны жасырын көтеруді шештім.
Dialogue: 0,1:29:08.91,1:29:12.91,Default,,0000,0000,0000,,Адамдардың жүрегінде қараңғылық бар
Dialogue: 0,1:29:08.91,1:29:12.91,Default,,0000,0000,0000,,Мен оны білдім➡
Dialogue: 0,1:29:12.91,1:29:15.92,Default,,0000,0000,0000,,Өзім көтерсем жарайды деп ойладым.
Dialogue: 0,1:29:15.92,1:29:18.92,Default,,0000,0000,0000,,Енді ойлап қарасам, мен тәкаппар болдым.
Dialogue: 0,1:29:18.92,1:29:22.92,Default,,0000,0000,0000,,Бұл менің қуанышым болды.
Dialogue: 0,1:29:22.92,1:29:26.93,Default,,0000,0000,0000,,(Ичирохико)
Dialogue: 0,1:29:22.92,1:29:26.93,Default,,0000,0000,0000,,((Мен неге әкеме ұқсаймын?
Dialogue: 0,1:29:22.92,1:29:26.93,Default,,0000,0000,0000,,Азу тістерің жоқ па? ))
Dialogue: 0,1:29:26.93,1:29:29.93,Default,,0000,0000,0000,,((Уайымдамаңыз
Dialogue: 0,1:29:26.93,1:29:29.93,Default,,0000,0000,0000,,Бір күні өседі))
Dialogue: 0,1:29:29.93,1:29:33.94,Default,,0000,0000,0000,,(Ичирохико)
Dialogue: 0,1:29:29.93,1:29:33.94,Default,,0000,0000,0000,,((Менің мұрным неге сенікі сияқты?
Dialogue: 0,1:29:29.93,1:29:33.94,Default,,0000,0000,0000,,Ол ұзақ өспей ме? ))
Dialogue: 0,1:29:33.94,1:29:37.94,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:29:37.94,1:29:40.94,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:29:40.94,1:29:43.95,Default,,0000,0000,0000,,(Иозан)
Dialogue: 0,1:29:40.94,1:29:43.95,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:29:43.95,1:29:49.95,Default,,0000,0000,0000,,((Басқа ешкім жоқ
Dialogue: 0,1:29:43.95,1:29:49.95,Default,,0000,0000,0000,,Мен Иозанның ұлымын))
Dialogue: 0,1:29:49.95,1:29:52.95,Default,,0000,0000,0000,,Құбыжық бала болса
Dialogue: 0,1:29:49.95,1:29:52.95,Default,,0000,0000,0000,,Мені сендіргісі келген сайын➡
Dialogue: 0,1:29:52.95,1:29:58.96,Default,,0000,0000,0000,,Ичирохико өзіне сене алмайды
Dialogue: 0,1:29:52.95,1:29:58.96,Default,,0000,0000,0000,,Қараңғылықты тереңдеттің.
Dialogue: 0,1:29:58.96,1:30:03.97,Default,,0000,0000,0000,,Құбыжықтар әлемінің атмосферасы
Dialogue: 0,1:29:58.96,1:30:03.97,Default,,0000,0000,0000,,Адамның кеудесіндегі тесік➡
Dialogue: 0,1:30:03.97,1:30:06.97,Default,,0000,0000,0000,,Осыншама ашады деп күтпедім.
Dialogue: 0,1:30:06.97,1:30:09.97,Default,,0000,0000,0000,,Қараңғылық дегеніміз не?
Dialogue: 0,1:30:09.97,1:30:11.97,Default,,0000,0000,0000,,Ей, сен ақымақсың, сондықтан түсінбейсің.
Dialogue: 0,1:30:11.97,1:30:14.98,Default,,0000,0000,0000,,Менің ағам
Dialogue: 0,1:30:11.97,1:30:14.98,Default,,0000,0000,0000,,Қайдан шыққанын білмеймін
Dialogue: 0,1:30:14.98,1:30:17.98,Default,,0000,0000,0000,,Майлағыштарға арналған
Dialogue: 0,1:30:14.98,1:30:17.98,Default,,0000,0000,0000,,Үлкен аға - үлкен аға
Dialogue: 0,1:30:17.98,1:30:21.98,Default,,0000,0000,0000,,Джиромару…
Dialogue: 0,1:30:17.98,1:30:21.98,Default,,0000,0000,0000,,Соши-сама, біз қазірдің өзінде
Dialogue: 0,1:30:21.98,1:30:24.99,Default,,0000,0000,0000,,Ичирохикомен бірге тұру
Dialogue: 0,1:30:21.98,1:30:24.99,Default,,0000,0000,0000,,Бұл мүмкін емес пе?
Dialogue: 0,1:30:24.99,1:30:27.99,Default,,0000,0000,0000,,Барлығын қайталау
Dialogue: 0,1:30:24.99,1:30:27.99,Default,,0000,0000,0000,,Бұл мүмкін емес пе?
Dialogue: 0,1:30:27.99,1:30:31.99,Default,,0000,0000,0000,,Ичирохико
Dialogue: 0,1:30:27.99,1:30:31.99,Default,,0000,0000,0000,,Әлі де бір жерде қаңғып жүр
Dialogue: 0,1:30:31.99,1:30:36.00,Default,,0000,0000,0000,,Сол қараңғылық
Dialogue: 0,1:30:31.99,1:30:36.00,Default,,0000,0000,0000,,Егер Ичирохико сізді қуып жібермесе➡
Dialogue: 0,1:30:36.00,1:30:39.00,Default,,0000,0000,0000,,Ештеңе болуы мүмкін емес.
Dialogue: 0,1:30:42.00,1:30:45.01,Default,,0000,0000,0000,,Кюта
Dialogue: 0,1:30:45.01,1:30:48.01,Default,,0000,0000,0000,,Сіз Куматецуды жалғыз қалдырасыз ба?
Dialogue: 0,1:30:50.01,1:30:55.02,Default,,0000,0000,0000,,Ақымақ! Жауыңыздан кек алуды жоспарлап отырсыз ба?
Dialogue: 0,1:30:50.01,1:30:55.02,Default,,0000,0000,0000,,Мұны істеудің мәні неде?
Dialogue: 0,1:30:55.02,1:30:58.02,Default,,0000,0000,0000,,О... Эй... Хякушюбо...
Dialogue: 0,1:30:55.02,1:30:58.02,Default,,0000,0000,0000,,Мен енді шыдай алмаймын!
Dialogue: 0,1:30:58.02,1:31:01.96,Default,,0000,0000,0000,,Жүзім тәтті болсын
Dialogue: 0,1:30:58.02,1:31:01.96,Default,,0000,0000,0000,,Егер сіз мұны істеп жатырмын деп ойласаңыз, қателесесіз!
Dialogue: 0,1:31:01.96,1:31:05.96,Default,,0000,0000,0000,,Куматецудың сыртқы түріне қараңыз
Dialogue: 0,1:31:01.96,1:31:05.96,Default,,0000,0000,0000,,Ештеңе үйренбе, ақымақ!
Dialogue: 0,1:31:11.97,1:31:14.97,Default,,0000,0000,0000,,Я...
Dialogue: 0,1:31:14.97,1:31:17.97,Default,,0000,0000,0000,,Сіз әлі барасыз ба?
Dialogue: 0,1:31:19.97,1:31:24.98,Default,,0000,0000,0000,,Маған ұрысқаныңызға рахмет.
Dialogue: 0,1:31:19.97,1:31:24.98,Default,,0000,0000,0000,,Сіздің арқаңызда омыртқам түзеле бастады.
Dialogue: 0,1:31:24.98,1:31:27.98,Default,,0000,0000,0000,,Бірақ оның кек алудан айырмашылығы бар.
Dialogue: 0,1:31:27.98,1:31:29.98,Default,,0000,0000,0000,,Мен және Ичирохико бірдей➡
Dialogue: 0,1:31:29.98,1:31:33.99,Default,,0000,0000,0000,,Мен қателессем, Ичирохико сияқты боламын.
Dialogue: 0,1:31:29.98,1:31:33.99,Default,,0000,0000,0000,,Бұл болуы мүмкін
Dialogue: 0,1:31:33.99,1:31:35.99,Default,,0000,0000,0000,,Бұл болған жоқ ➡
Dialogue: 0,1:31:35.99,1:31:39.99,Default,,0000,0000,0000,,Мені өсірді
Dialogue: 0,1:31:35.99,1:31:39.99,Default,,0000,0000,0000,,Көп адамдарға рахмет
Dialogue: 0,1:31:39.99,1:31:44.00,Default,,0000,0000,0000,,Тада-сан, Хьяку-сан және барлығының
Dialogue: 0,1:31:44.00,1:31:47.00,Default,,0000,0000,0000,,Кюта, сен...
Dialogue: 0,1:31:47.00,1:31:50.00,Default,,0000,0000,0000,,Сол себепті
Dialogue: 0,1:31:47.00,1:31:50.00,Default,,0000,0000,0000,,Сіз мұны басқа адамдар үшін жасай алмайсыз.
Dialogue: 0,1:31:50.00,1:31:53.01,Default,,0000,0000,0000,,Ичирохиконың мәселесі
Dialogue: 0,1:31:50.00,1:31:53.01,Default,,0000,0000,0000,,Өйткені бұл менің де проблемам.
Dialogue: 0,1:31:53.01,1:31:57.01,Default,,0000,0000,0000,,Сонымен... мен барамын
Dialogue: 0,1:31:57.01,1:32:00.01,Default,,0000,0000,0000,,Өтінемін, оған қамқорлық жасаңыз.
Dialogue: 0,1:32:01.95,1:32:06.95,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,1:32:01.95,1:32:06.95,Default,,0000,0000,0000,,Мен сіздің шешіміңізді түсінемін!
Dialogue: 0,1:32:06.95,1:32:10.96,Default,,0000,0000,0000,,Куматецуды жай қалдырыңыз.
Dialogue: 0,1:32:06.95,1:32:10.96,Default,,0000,0000,0000,,Мен сені қадағалаймын!
Dialogue: 0,1:32:10.96,1:32:13.96,Default,,0000,0000,0000,,Қане, кел!
Dialogue: 0,1:32:13.96,1:32:18.97,Default,,0000,0000,0000,,(Татараның жылағаны)
Dialogue: 0,1:32:18.97,1:32:31.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:32:31.98,1:32:36.98,Default,,0000,0000,0000,,«Мені өсірген адам
Dialogue: 0,1:32:31.98,1:32:36.98,Default,,0000,0000,0000,,Көптеген адамдар...
Dialogue: 0,1:32:36.98,1:32:40.99,Default,,0000,0000,0000,,Ортада
Dialogue: 0,1:32:36.98,1:32:40.99,Default,,0000,0000,0000,,Мен бізді қосылды деп ешқашан ойламаппын...
Dialogue: 0,1:32:40.99,1:32:44.99,Default,,0000,0000,0000,,Кюта кішкентай кезінен бастап
Dialogue: 0,1:32:40.99,1:32:44.99,Default,,0000,0000,0000,,Өйткені біз мәңгі бірге болдық
Dialogue: 0,1:32:44.99,1:32:49.00,Default,,0000,0000,0000,,О
Dialogue: 0,1:32:44.99,1:32:49.00,Default,,0000,0000,0000,,Бастапқыда мен ерке, ұнамсыз бала едім.
Dialogue: 0,1:32:49.00,1:32:53.00,Default,,0000,0000,0000,,Жаңбырлы, желді күндері
Dialogue: 0,1:32:49.00,1:32:53.00,Default,,0000,0000,0000,,Күнделікті тәртіпсіз жүр
Dialogue: 0,1:32:53.00,1:32:55.00,Default,,0000,0000,0000,,Мен саған қамқор болсам да➡
Dialogue: 0,1:32:55.00,1:32:57.00,Default,,0000,0000,0000,,Алғыс білдірген жүз
Dialogue: 0,1:32:55.00,1:32:57.00,Default,,0000,0000,0000,,Бір нәрсені істеме
Dialogue: 0,1:32:57.00,1:33:00.94,Default,,0000,0000,0000,,Мен мұны түсінгенде
Dialogue: 0,1:32:57.00,1:33:00.94,Default,,0000,0000,0000,,Үлкен болып өсу
Dialogue: 0,1:33:00.94,1:33:03.95,Default,,0000,0000,0000,,Көп ауыз
Dialogue: 0,1:33:00.94,1:33:03.95,Default,,0000,0000,0000,,Өйткені сен жақсысың
Dialogue: 0,1:33:05.95,1:33:09.95,Default,,0000,0000,0000,,Мен мақтанамын
Dialogue: 0,1:33:05.95,1:33:09.95,Default,,0000,0000,0000,,Мен мақтанамын...
Dialogue: 0,1:33:11.95,1:33:13.96,Default,,0000,0000,0000,,Уууу…
Dialogue: 0,1:33:11.95,1:33:13.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:33:13.96,1:33:15.96,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,1:33:13.96,1:33:15.96,Default,,0000,0000,0000,,Куматецу!
Dialogue: 0,1:33:17.96,1:33:21.96,Default,,0000,0000,0000,,
Dialogue: 0,1:33:34.98,1:33:36.98,Default,,0000,0000,0000,,🖁 (дірілдеткіш)
Dialogue: 0,1:33:36.98,1:33:38.98,Default,,0000,0000,0000,,Рен-кун?
Dialogue: 0,1:33:38.98,1:33:43.99,Default,,0000,0000,0000,,(теледидар дыбысы)
Dialogue: 0,1:33:38.98,1:33:43.99,Default,,0000,0000,0000,,Токио қор нарығында Nikkei Stock Average болып табылады
Dialogue: 0,1:33:38.98,1:33:43.99,Default,,0000,0000,0000,,Біз бағаны сәл көтердік...
Dialogue: 0,1:33:56.00,1:33:59.00,Default,,0000,0000,0000,,Осыны сақтағаныңызды қалаймын.
Dialogue: 0,1:33:59.00,1:34:01.94,Default,,0000,0000,0000,,Неліктен?Неліктен?
Dialogue: 0,1:34:01.94,1:34:04.94,Default,,0000,0000,0000,,Есеп айырысу
Dialogue: 0,1:34:01.94,1:34:04.94,Default,,0000,0000,0000,,Сізбен күресу керек біреу бар.
Dialogue: 0,1:34:04.94,1:34:06.94,Default,,0000,0000,0000,,Мен жеңе алатынымды білмеймін
Dialogue: 0,1:34:06.94,1:34:09.94,Default,,0000,0000,0000,,Егер сіз жоғалтсаңыз
Dialogue: 0,1:34:06.94,1:34:09.94,Default,,0000,0000,0000,,Барлығы аяқталуы мүмкін
Dialogue: 0,1:34:09.94,1:34:12.95,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,1:34:09.94,1:34:12.95,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:34:12.95,1:34:14.95,Default,,0000,0000,0000,,Мен Каэдемен кездескеніме қуаныштымын.
Dialogue: 0,1:34:14.95,1:34:18.95,Default,,0000,0000,0000,,Каэде бар, мен білмейтін нәрселер
Dialogue: 0,1:34:14.95,1:34:18.95,Default,,0000,0000,0000,,Мен көп нәрсені білдім
Dialogue: 0,1:34:18.95,1:34:21.96,Default,,0000,0000,0000,,Дүние өте үлкен
Dialogue: 0,1:34:18.95,1:34:21.96,Default,,0000,0000,0000,,Бұл маған шынымен де көрінді
Dialogue: 0,1:34:21.96,1:34:24.96,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Әлі алда...
Dialogue: 0,1:34:24.96,1:34:27.96,Default,,0000,0000,0000,,Бірге оқуға мүмкіндік алдым.
Dialogue: 0,1:34:24.96,1:34:27.96,Default,,0000,0000,0000,,Мен бақытты болдым.
Dialogue: 0,1:34:27.96,1:34:30.97,Default,,0000,0000,0000,,Сол себепті рахмет айтқым келді
Dialogue: 0,1:34:30.97,1:34:33.97,Default,,0000,0000,0000,,Тоқта... Маған ұнамайды!
Dialogue: 0,1:34:33.97,1:34:37.97,Default,,0000,0000,0000,,Маған бұл ұнамайды...
Dialogue: 0,1:34:37.97,1:34:39.97,Default,,0000,0000,0000,,Шықыр!
Dialogue: 0,1:34:39.97,1:34:43.98,Default,,0000,0000,0000,,Кюта...
Dialogue: 0,1:34:39.97,1:34:43.98,Default,,0000,0000,0000,,Қолымыздан келмейді ғой, иә? Сен оны қалайсың ба?
Dialogue: 0,1:34:43.98,1:34:46.98,Default,,0000,0000,0000,,Кешпеймін…
Dialogue: 0,1:34:46.98,1:34:49.98,Default,,0000,0000,0000,,Біз адам болсақ та...
Dialogue: 0,1:34:49.98,1:34:52.99,Default,,0000,0000,0000,,Қарғыс атсын... Осындай жерде...
Dialogue: 0,1:34:49.98,1:34:52.99,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,1:34:54.99,1:34:57.99,Default,,0000,0000,0000,,Бұл қауіпті, қаш.
Dialogue: 0,1:34:57.99,1:35:00.93,Default,,0000,0000,0000,,Ах, ах…
Dialogue: 0,1:35:00.93,1:35:02.93,Default,,0000,0000,0000,,Сіз не істеп жатырсыз!? Тез жүріңіз!
Dialogue: 0,1:35:02.93,1:35:07.94,Default,,0000,0000,0000,,Жоқ! Себебі мен сені жібермеймін...
Dialogue: 0,1:35:07.94,1:35:09.94,Default,,0000,0000,0000,,Шықыр!
Dialogue: 0,1:35:07.94,1:35:09.94,Default,,0000,0000,0000,,Ха!?
Dialogue: 0,1:35:09.94,1:35:11.94,Default,,0000,0000,0000,,Қайтарушы Турбо
Dialogue: 0,1:35:13.94,1:35:15.94,Default,,0000,0000,0000,,(Әйелдің айғайы)
Dialogue: 0,1:35:13.94,1:35:15.94,Default,,0000,0000,0000,,Барынша жылдам жүгіріңіз!
Dialogue: 0,1:35:15.94,1:35:18.95,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:35:15.94,1:35:18.95,Default,,0000,0000,0000,,Уф!
Dialogue: 0,1:35:18.95,1:35:21.95,Default,,0000,0000,0000,,(Айқай)
Dialogue: 0,1:35:21.95,1:35:23.95,Default,,0000,0000,0000,,Алыс болыңыз!
Dialogue: 0,1:35:21.95,1:35:23.95,Default,,0000,0000,0000,,Ах…
Dialogue: 0,1:35:26.95,1:35:29.96,Default,,0000,0000,0000,,(Кюта мен Ичирохиконың айқайы)
Dialogue: 0,1:35:29.96,1:35:33.96,Default,,0000,0000,0000,,Не ол?
Dialogue: 0,1:35:29.96,1:35:33.96,Default,,0000,0000,0000,,Бұл теледидар түсірілімі ме?
Dialogue: 0,1:35:33.96,1:35:36.96,Default,,0000,0000,0000,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,1:35:40.97,1:35:43.97,Default,,0000,0000,0000,,Уф! Уф...
Dialogue: 0,1:35:43.97,1:35:48.98,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:35:43.97,1:35:48.98,Default,,0000,0000,0000,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,1:35:48.98,1:35:51.98,Default,,0000,0000,0000,,Ннн!
Dialogue: 0,1:35:48.98,1:35:51.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:35:51.98,1:35:53.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:35:56.98,1:36:00.92,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:36:00.92,1:36:02.92,Default,,0000,0000,0000,,Ха!?
Dialogue: 0,1:36:05.93,1:36:07.93,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:36:07.93,1:36:09.93,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,1:36:09.93,1:36:12.93,Default,,0000,0000,0000,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:36:12.93,1:36:14.94,Default,,0000,0000,0000,,Рен-кун!
Dialogue: 0,1:36:14.94,1:36:19.94,Default,,0000,0000,0000,,(Айқай)
Dialogue: 0,1:36:19.94,1:36:22.94,Default,,0000,0000,0000,,Фу…
Dialogue: 0,1:36:22.94,1:36:27.95,Default,,0000,0000,0000,,Қат! Мұнда емес
Dialogue: 0,1:36:22.94,1:36:27.95,Default,,0000,0000,0000,,Бір жерде...
Dialogue: 0,1:36:27.95,1:36:33.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:36:33.95,1:36:35.96,Default,,0000,0000,0000,,Кит...
Dialogue: 0,1:36:37.96,1:36:40.96,Default,,0000,0000,0000,,Қауіпті!
Dialogue: 0,1:36:37.96,1:36:40.96,Default,,0000,0000,0000,,Онда барма!
Dialogue: 0,1:36:40.96,1:36:42.96,Default,,0000,0000,0000,,Тез қаш!
Dialogue: 0,1:36:49.97,1:36:51.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:36:49.97,1:36:51.97,Default,,0000,0000,0000,,Не? Бұл
Dialogue: 0,1:36:51.97,1:36:53.97,Default,,0000,0000,0000,,Қандай көлеңке?
Dialogue: 0,1:36:53.97,1:36:55.98,Default,,0000,0000,0000,,
Dialogue: 0,1:36:55.98,1:37:03.92,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:37:03.92,1:37:06.92,Default,,0000,0000,0000,,Қандай әйелдер ұнайды саған?
Dialogue: 0,1:37:03.92,1:37:06.92,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:37:06.92,1:37:09.92,Default,,0000,0000,0000,,Кит?
Dialogue: 0,1:37:09.92,1:37:21.94,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:37:21.94,1:37:25.94,Default,,0000,0000,0000,,Ха!?
Dialogue: 0,1:37:21.94,1:37:25.94,Default,,0000,0000,0000,,Көліктен түс! Жарайды!
Dialogue: 0,1:37:25.94,1:37:34.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:37:34.95,1:37:36.95,Default,,0000,0000,0000,,Ха!?
Dialogue: 0,1:37:36.95,1:37:38.95,Default,,0000,0000,0000,,Уау! Не?!
Dialogue: 0,1:37:38.95,1:37:40.96,Default,,0000,0000,0000,,(ер)
Dialogue: 0,1:37:38.95,1:37:40.96,Default,,0000,0000,0000,,Эй, жүгір! Тез қаш!
Dialogue: 0,1:37:47.96,1:37:49.96,Default,,0000,0000,0000,,Каэде!
Dialogue: 0,1:37:51.97,1:37:53.97,Default,,0000,0000,0000,,Ах... Ах...
Dialogue: 0,1:38:00.91,1:38:03.91,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:38:09.92,1:38:13.92,Default,,0000,0000,0000,,Мен ол жігітті қалай жеңемін...
Dialogue: 0,1:38:13.92,1:38:15.92,Default,,0000,0000,0000,,Мұнда!
Dialogue: 0,1:38:15.92,1:38:17.93,Default,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,1:38:37.95,1:38:39.95,Default,,0000,0000,0000,,Ах... Ах?
Dialogue: 0,1:38:51.96,1:38:56.96,Default,,0000,0000,0000,,《Оған қарсы тұру үшін
Dialogue: 0,1:38:51.96,1:38:56.96,Default,,0000,0000,0000,,Не істеуім керек? 》
Dialogue: 0,1:38:56.96,1:39:01.90,Default,,0000,0000,0000,,《Бос кеудемнің ішін аш
Dialogue: 0,1:38:56.96,1:39:01.90,Default,,0000,0000,0000,,Егер мен оның барлық қараңғылығын жауып тастасам➡
Dialogue: 0,1:39:01.90,1:39:06.91,Default,,0000,0000,0000,,Өзіңе қарсы қылыш ұстап, мені де өзіңмен бірге ал
Dialogue: 0,1:39:01.90,1:39:06.91,Default,,0000,0000,0000,,Мен бұл дүниеден ғайып боламын ба...》
Dialogue: 0,1:39:06.91,1:39:11.91,Default,,0000,0000,0000,,《Мен енді ештеңе істей алмаймын.
Dialogue: 0,1:39:06.91,1:39:11.91,Default,,0000,0000,0000,,Бұл жалғыз нұсқа ма...》
Dialogue: 0,1:39:11.91,1:39:16.92,Default,,0000,0000,0000,,Енді менмін.
Dialogue: 0,1:39:11.91,1:39:16.92,Default,,0000,0000,0000,,Мен бұл туралы біраз уақыт ойладым ...
Dialogue: 0,1:39:16.92,1:39:21.92,Default,,0000,0000,0000,,Сен неге Реннің қолын ұстап тұрсың?
Dialogue: 0,1:39:16.92,1:39:21.92,Default,,0000,0000,0000,,Менің ойымша, біз бірге жүгіреміз.
Dialogue: 0,1:39:21.92,1:39:25.93,Default,,0000,0000,0000,,Қорыққаным сонша, шыдай алмаймын
Dialogue: 0,1:39:21.92,1:39:25.93,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,1:39:25.93,1:39:28.93,Default,,0000,0000,0000,,есіме түсті
Dialogue: 0,1:39:28.93,1:39:32.93,Default,,0000,0000,0000,,Алдымен мен Ренкунмен таныстым.
Dialogue: 0,1:39:28.93,1:39:32.93,Default,,0000,0000,0000,,Бірге оқуды бастаған кез
Dialogue: 0,1:39:32.93,1:39:34.94,Default,,0000,0000,0000,,Мен шынымен бақытты болдым.
Dialogue: 0,1:39:34.94,1:39:40.94,Default,,0000,0000,0000,,Өйткені бұл өте қызықты көрінеді
Dialogue: 0,1:39:34.94,1:39:40.94,Default,,0000,0000,0000,,Оқытатын басқа ешкім жоқ.
Dialogue: 0,1:39:40.94,1:39:45.95,Default,,0000,0000,0000,,Мен сенімен бірге болсам, мен де қолымнан келгеннің бәрін жасайтын сияқтымын.
Dialogue: 0,1:39:40.94,1:39:45.95,Default,,0000,0000,0000,,Бұл маған батылдық берді.
Dialogue: 0,1:39:45.95,1:39:48.95,Default,,0000,0000,0000,,Сонымен, қазір де солай.
Dialogue: 0,1:39:48.95,1:39:52.95,Default,,0000,0000,0000,,Егер Рен төбелесіп жатса
Dialogue: 0,1:39:48.95,1:39:52.95,Default,,0000,0000,0000,,Мен де сенімен біргемін
Dialogue: 0,1:39:52.95,1:39:55.96,Default,,0000,0000,0000,,Біз әрқашан бар екенімізді ұмытпа➡
Dialogue: 0,1:39:55.96,1:39:58.96,Default,,0000,0000,0000,,Жалғыз
Dialogue: 0,1:39:55.96,1:39:58.96,Default,,0000,0000,0000,,Біз ұрысып жатқан жоқпыз.
Dialogue: 0,1:39:58.96,1:40:01.96,Default,,0000,0000,0000,,Каэде…
Dialogue: 0,1:40:01.96,1:40:03.96,Default,,0000,0000,0000,,
Dialogue: 0,1:40:01.96,1:40:03.96,Default,,0000,0000,0000,,Біз тұтынушыға хабарлаймыз
Dialogue: 0,1:40:03.96,1:40:05.97,Default,,0000,0000,0000,,Шибуя станциясының жанында
Dialogue: 0,1:40:03.96,1:40:05.97,Default,,0000,0000,0000,,Өрт салдарынан➡
Dialogue: 0,1:40:05.97,1:40:09.97,Default,,0000,0000,0000,,Бұл пойыз осы станцияда жұмысын тоқтатты.
Dialogue: 0,1:40:05.97,1:40:09.97,Default,,0000,0000,0000,,Біраз уақытқа...
Dialogue: 0,1:40:09.97,1:40:13.97,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:40:13.97,1:40:16.98,Default,,0000,0000,0000,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:40:13.97,1:40:16.98,Default,,0000,0000,0000,,Не? Бұл діріл
Dialogue: 0,1:40:16.98,1:40:20.98,Default,,0000,0000,0000,,Ичирохико Кютаны көздейді
Dialogue: 0,1:40:16.98,1:40:20.98,Default,,0000,0000,0000,,Адамдарға толы қалада дүрілдеп жатыр!
Dialogue: 0,1:40:20.98,1:40:23.98,Default,,0000,0000,0000,,Біздің әлем және
Dialogue: 0,1:40:20.98,1:40:23.98,Default,,0000,0000,0000,,Бір-бірімен резонанс тудырса да➡
Dialogue: 0,1:40:23.98,1:40:25.99,Default,,0000,0000,0000,,Оның әсері сондай...
Dialogue: 0,1:40:25.99,1:40:30.99,Default,,0000,0000,0000,,Неліктен адамдар арасындағы қақтығыстарда соғысамыз?
Dialogue: 0,1:40:25.99,1:40:30.99,Default,,0000,0000,0000,,Мен қатысуым керек пе?
Dialogue: 0,1:40:30.99,1:40:36.00,Default,,0000,0000,0000,,Бірінші кезекте біздің әлемде
Dialogue: 0,1:40:30.99,1:40:36.00,Default,,0000,0000,0000,,Адамдарды кіргізу қате болды.
Dialogue: 0,1:40:36.00,1:40:38.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:40:36.00,1:40:38.00,Default,,0000,0000,0000,,О...
Dialogue: 0,1:40:38.00,1:40:42.00,Default,,0000,0000,0000,,Хахаха...
Dialogue: 0,1:40:42.00,1:40:45.01,Default,,0000,0000,0000,,О... Сәлем Куматецу
Dialogue: 0,1:40:42.00,1:40:45.01,Default,,0000,0000,0000,,Шатаспа, өлесің!
Dialogue: 0,1:40:45.01,1:40:49.01,Default,,0000,0000,0000,,Егер дұрыс қозғала алсаңыз
Dialogue: 0,1:40:45.01,1:40:49.01,Default,,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,1:40:45.01,1:40:49.01,Default,,0000,0000,0000,,Шу!
Dialogue: 0,1:40:49.01,1:40:54.01,Default,,0000,0000,0000,,Мен жағдайды естідім.
Dialogue: 0,1:40:49.01,1:40:54.01,Default,,0000,0000,0000,,Мен бірдеңе істеймін. мен...
Dialogue: 0,1:40:54.01,1:40:56.02,Default,,0000,0000,0000,,Куматецу…
Dialogue: 0,1:40:56.02,1:40:58.02,Default,,0000,0000,0000,,Сіз не істей аласыз!
Dialogue: 0,1:40:58.02,1:41:02.96,Default,,0000,0000,0000,,Соуши, сен маған керексің
Dialogue: 0,1:40:58.02,1:41:02.96,Default,,0000,0000,0000,,Сіз бұл туралы бірдеңе жасай аласыз ...
Dialogue: 0,1:41:02.96,1:41:05.96,Default,,0000,0000,0000,,Бірақ сіз қалай екенін білесіз
Dialogue: 0,1:41:02.96,1:41:05.96,Default,,0000,0000,0000,,Оны ішіңізде сақтаңыз, сыртқа шығармаңыз
Dialogue: 0,1:41:05.96,1:41:09.96,Default,,0000,0000,0000,,Қалай?
Dialogue: 0,1:41:05.96,1:41:09.96,Default,,0000,0000,0000,,Қандай әдістер бар?
Dialogue: 0,1:41:09.96,1:41:13.97,Default,,0000,0000,0000,,Кюта
Dialogue: 0,1:41:09.96,1:41:13.97,Default,,0000,0000,0000,,Мен өзімді толыққанды адаммын деп ойлаймын, бірақ
Dialogue: 0,1:41:13.97,1:41:17.97,Default,,0000,0000,0000,,Дәл қазір маған біреудің көмегі керек.
Dialogue: 0,1:41:17.97,1:41:20.97,Default,,0000,0000,0000,,Мен жарымжан ақымақпын.
Dialogue: 0,1:41:20.97,1:41:22.98,Default,,0000,0000,0000,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,1:41:20.97,1:41:22.98,Default,,0000,0000,0000,,Мен оған бар күшімді саламын.
Dialogue: 0,1:41:22.98,1:41:27.98,Default,,0000,0000,0000,,Оның кеудесінде не жетіспейді?
Dialogue: 0,1:41:22.98,1:41:27.98,Default,,0000,0000,0000,,Мен оны толтырамын.
Dialogue: 0,1:41:27.98,1:41:32.99,Default,,0000,0000,0000,,Менің, жарымжан адамның қолынан келетіні осы.
Dialogue: 0,1:41:27.98,1:41:32.99,Default,,0000,0000,0000,,Бұл бір ғана нәрсе!
Dialogue: 0,1:41:32.99,1:41:36.99,Default,,0000,0000,0000,,(соққы дыбысы)
Dialogue: 0,1:41:32.99,1:41:36.99,Default,,0000,0000,0000,,
Dialogue: 0,1:41:36.99,1:41:43.00,Default,,0000,0000,0000,,Хмм... сен
Dialogue: 0,1:41:36.99,1:41:43.00,Default,,0000,0000,0000,,Сіз мұндай сөзді қалай айта аласыз?
Dialogue: 0,1:41:43.00,1:41:48.00,Default,,0000,0000,0000,,Бұл жігіт менің
Dialogue: 0,1:41:43.00,1:41:48.00,Default,,0000,0000,0000,,Маған реинкарнация құқығын беруіңізді сұраймын.
Dialogue: 0,1:41:48.00,1:41:51.00,Default,,0000,0000,0000,,Егер сіз құдай болып реинкарнациялансаңыз ше?
Dialogue: 0,1:41:51.00,1:41:54.01,Default,,0000,0000,0000,,Ақымақ! Бұл дұрыс емес
Dialogue: 0,1:41:51.00,1:41:54.01,Default,,0000,0000,0000,,Оны кәдімгі құбыжыққа айналдыра алмайсың!
Dialogue: 0,1:41:54.01,1:41:57.01,Default,,0000,0000,0000,,Міне
Dialogue: 0,1:41:54.01,1:41:57.01,Default,,0000,0000,0000,,Мен Соши-сама болуым керек...
Dialogue: 0,1:41:57.01,1:41:59.95,Default,,0000,0000,0000,,А... а?
Dialogue: 0,1:41:59.95,1:42:02.95,Default,,0000,0000,0000,,(Иида) Турбо Герой Ингениумды білесің бе?
Dialogue: 0,1:41:59.95,1:42:02.95,Default,,0000,0000,0000,,Куматецу – бас діни қызметкер...
Dialogue: 0,1:42:02.95,1:42:05.95,Default,,0000,0000,0000,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,1:42:02.95,1:42:05.95,Default,,0000,0000,0000,,Мұқият тыңда, Куматецу.
Dialogue: 0,1:42:05.95,1:42:11.96,Default,,0000,0000,0000,,Шешім қабылданғаннан кейін артқа жол жоқ.
Dialogue: 0,1:42:05.95,1:42:11.96,Default,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,1:42:15.96,1:42:21.97,Default,,0000,0000,0000,,Сен, жігіт, абдырап қалдың.
Dialogue: 0,1:42:15.96,1:42:21.97,Default,,0000,0000,0000,,Бозарған көздеріңді әжім...
Dialogue: 0,1:42:32.98,1:42:34.98,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:42:34.98,1:42:37.99,Default,,0000,0000,0000,,Ичирохико…
Dialogue: 0,1:42:37.99,1:42:40.99,Default,,0000,0000,0000,,Жоғалып кетті ме? Иә?
Dialogue: 0,1:42:46.99,1:42:49.00,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:42:54.00,1:42:57.00,Default,,0000,0000,0000,,Қайтарушы Турбо
Dialogue: 0,1:42:57.00,1:42:59.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:43:05.95,1:43:10.95,Default,,0000,0000,0000,,Қаш, Каэде, ол мені көздеп тұр.
Dialogue: 0,1:43:10.95,1:43:12.95,Default,,0000,0000,0000,,Каэде!
Dialogue: 0,1:43:12.95,1:43:14.96,Default,,0000,0000,0000,,Сізге не керек?
Dialogue: 0,1:43:14.96,1:43:17.96,Default,,0000,0000,0000,,Сіз жек көретін адам
Dialogue: 0,1:43:14.96,1:43:17.96,Default,,0000,0000,0000,,Оны ұсақтап жыртқыңыз келе ме?
Dialogue: 0,1:43:17.96,1:43:20.96,Default,,0000,0000,0000,,Табанды
Dialogue: 0,1:43:17.96,1:43:20.96,Default,,0000,0000,0000,,Мен күшпен басып, қанағаттанамын⁉
Dialogue: 0,1:43:20.96,1:43:23.96,Default,,0000,0000,0000,,Сіз сондайсыз.
Dialogue: 0,1:43:23.96,1:43:26.97,Default,,0000,0000,0000,,Кектікке бой алдырған
Dialogue: 0,1:43:23.96,1:43:26.97,Default,,0000,0000,0000,,Адамның өзі!
Dialogue: 0,1:43:26.97,1:43:29.97,Default,,0000,0000,0000,,Бірақ бұл шынымен дұрыс па?
Dialogue: 0,1:43:26.97,1:43:29.97,Default,,0000,0000,0000,,Бәрімізде бірдей қараңғылық бар
Dialogue: 0,1:43:29.97,1:43:32.97,Default,,0000,0000,0000,,Тіпті Ренде де бар! Мен де!
Dialogue: 0,1:43:32.97,1:43:37.98,Default,,0000,0000,0000,,Мен оны әлі қолымда ұстаймын
Dialogue: 0,1:43:32.97,1:43:37.98,Default,,0000,0000,0000,,Қатты күресу
Dialogue: 0,1:43:37.98,1:43:42.98,Default,,0000,0000,0000,,Сондықтан қараңғылыққа оңай түсу
Dialogue: 0,1:43:37.98,1:43:42.98,Default,,0000,0000,0000,,Сіз туралы бірдеңені жұттым➡
Dialogue: 0,1:43:42.98,1:43:45.99,Default,,0000,0000,0000,,Ренкунның жеңіліп қалуы мүмкін емес.
Dialogue: 0,1:43:45.99,1:43:47.99,Default,,0000,0000,0000,,Біз
Dialogue: 0,1:43:45.99,1:43:47.99,Default,,0000,0000,0000,,Біз жоғалтуға жол жоқ!
Dialogue: 0,1:43:47.99,1:43:50.99,Default,,0000,0000,0000,,оған үкім шығарсын деп қалайтынын.
Dialogue: 0,1:43:47.99,1:43:50.99,Default,,0000,0000,0000,,(киттердің ақыруы)
Dialogue: 0,1:43:50.99,1:43:52.99,Default,,0000,0000,0000,,Каэде!
Dialogue: 0,1:43:52.99,1:43:59.93,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:43:59.93,1:44:01.94,Default,,0000,0000,0000,,Рен-кун!
Dialogue: 0,1:44:01.94,1:44:03.94,Default,,0000,0000,0000,,《Басқа таңдау жоқ》
Dialogue: 0,1:44:03.94,1:44:05.94,Default,,0000,0000,0000,,Ичирохико! Қараңдар!
Dialogue: 0,1:44:09.94,1:44:13.95,Default,,0000,0000,0000,,Мен сенің барлық қараңғылығыңды аламын!
Dialogue: 0,1:44:13.95,1:44:19.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:44:19.95,1:44:21.96,Default,,0000,0000,0000,,
Dialogue: 0,1:44:19.95,1:44:21.96,Default,,0000,0000,0000,,Сықырлау, сықырлау, сықырлау...
Dialogue: 0,1:44:21.96,1:44:24.96,Default,,0000,0000,0000,,Шықыр!
Dialogue: 0,1:44:26.96,1:44:28.96,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:44:26.96,1:44:28.96,Default,,0000,0000,0000,,Шықыр!
Dialogue: 0,1:44:28.96,1:44:30.96,Default,,0000,0000,0000,,Ренкун, мүмкін емес...
Dialogue: 0,1:44:33.97,1:44:36.97,Default,,0000,0000,0000,,Менімен бірге жоғал!
Dialogue: 0,1:44:36.97,1:44:38.97,Default,,0000,0000,0000,,Рен-кун!
Dialogue: 0,1:44:38.97,1:44:41.98,Default,,0000,0000,0000,,Шыу!
Dialogue: 0,1:44:41.98,1:44:43.98,Default,,0000,0000,0000,,Жоғалтып алмаңыз!
Dialogue: 0,1:44:43.98,1:44:46.98,Default,,0000,0000,0000,,Шыу!
Dialogue: 0,1:44:46.98,1:44:48.98,Default,,0000,0000,0000,,Кюта!
Dialogue: 0,1:44:46.98,1:44:48.98,Default,,0000,0000,0000,,Ха!?
Dialogue: 0,1:44:51.99,1:44:55.99,Default,,0000,0000,0000,,(кит дыбысы)
Dialogue: 0,1:45:02.93,1:45:06.93,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:45:02.93,1:45:06.93,Default,,0000,0000,0000,,Кюта! Ол Куматецу!
Dialogue: 0,1:45:06.93,1:45:10.94,Default,,0000,0000,0000,,Тоқсан тоғыз құдай ретінде реинкарнацияланды
Dialogue: 0,1:45:06.93,1:45:10.94,Default,,0000,0000,0000,,Ол сол ұлы қылышқа айналды!
Dialogue: 0,1:45:10.94,1:45:14.94,Default,,0000,0000,0000,,Бұл ол ма?
Dialogue: 0,1:45:14.94,1:45:19.95,Default,,0000,0000,0000,,Мен бұған жол бермеймін. Мен бұған жол бермеймін!
Dialogue: 0,1:45:14.94,1:45:19.95,Default,,0000,0000,0000,,Жүрегіңдегі қылыш болады.
Dialogue: 0,1:45:19.95,1:45:22.95,Default,,0000,0000,0000,,Кеудедегі қылыш?
Dialogue: 0,1:45:22.95,1:45:27.95,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:45:22.95,1:45:27.95,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:45:27.95,1:45:29.96,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:45:29.96,1:45:33.96,Default,,0000,0000,0000,,((Міне, мынау!
Dialogue: 0,1:45:29.96,1:45:33.96,Default,,0000,0000,0000,,Мұнда және мұнда! ))
Dialogue: 0,1:45:33.96,1:45:35.96,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:45:35.96,1:45:41.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:45:41.97,1:45:44.97,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:45:44.97,1:45:46.97,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:45:48.98,1:45:52.98,Default,,0000,0000,0000,,((Hehehehehe…
Dialogue: 0,1:45:48.98,1:45:52.98,Default,,0000,0000,0000,,Онда сен қазірден бастап "Кюта"сың))
Dialogue: 0,1:45:54.98,1:45:59.92,Default,,0000,0000,0000,,((Жарайды, Кюта! Мықты бол!
Dialogue: 0,1:45:54.98,1:45:59.92,Default,,0000,0000,0000,,Мен сені жаттықтырамын, дайындал! ))
Dialogue: 0,1:45:59.92,1:46:05.93,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:46:08.93,1:46:16.94,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:46:16.94,1:46:18.94,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:46:18.94,1:46:21.94,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:46:21.94,1:46:24.95,Default,,0000,0000,0000,,((Мезо
Dialogue: 0,1:46:21.94,1:46:24.95,Default,,0000,0000,0000,,Мен оны жек көремін! ))
Dialogue: 0,1:46:28.95,1:46:32.95,Default,,0000,0000,0000,,Шулы! Жылама!
Dialogue: 0,1:46:32.95,1:46:34.96,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:46:34.96,1:46:38.96,Default,,0000,0000,0000,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:46:46.97,1:46:48.97,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:46:50.97,1:46:52.97,Default,,0000,0000,0000,,Кюта...
Dialogue: 0,1:46:50.97,1:46:52.97,Default,,0000,0000,0000,,Рен-кун…
Dialogue: 0,1:46:56.98,1:47:01.92,Default,,0000,0000,0000,,((Әлі емес!
Dialogue: 0,1:46:56.98,1:47:01.92,Default,,0000,0000,0000,,Одан да өткірлендіріңіз! ))
Dialogue: 0,1:47:01.92,1:47:03.92,Default,,0000,0000,0000,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:47:05.92,1:47:07.92,Default,,0000,0000,0000,,《Бұл...》
Dialogue: 0,1:47:07.92,1:47:15.93,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:47:15.93,1:47:19.93,Default,,0000,0000,0000,,《Секіру сәті
Dialogue: 0,1:47:15.93,1:47:19.93,Default,,0000,0000,0000,,Ичирохико міндетті түрде шығады...》
Dialogue: 0,1:47:19.93,1:47:21.94,Default,,0000,0000,0000,,《…》
Dialogue: 0,1:47:23.94,1:47:27.94,Default,,0000,0000,0000,,((Бір нәрсені қараңыз!
Dialogue: 0,1:47:23.94,1:47:27.94,Default,,0000,0000,0000,,Сол жерде ойланбастан оқ атыңыз! ))
Dialogue: 0,1:47:27.94,1:47:29.94,Default,,0000,0000,0000,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:47:31.95,1:47:35.95,Default,,0000,0000,0000,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:47:39.95,1:47:41.96,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:47:43.96,1:47:49.96,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:47:56.97,1:47:58.97,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:48:04.91,1:48:12.92,Default,,0000,0000,0000,,(Ичирохиконың айқайы)
Dialogue: 0,1:48:12.92,1:48:16.92,Default,,0000,0000,0000,,(киттердің ақыруы)
Dialogue: 0,1:48:27.93,1:48:29.94,Default,,0000,0000,0000,,Сіз мұны жасадыңыз ба?
Dialogue: 0,1:48:29.94,1:48:32.94,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,1:48:29.94,1:48:32.94,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:48:34.94,1:48:39.95,Default,,0000,0000,0000,,Адамдар...
Dialogue: 0,1:48:41.95,1:48:45.95,Default,,0000,0000,0000,,Ичирохико... сен де мен сияқтысың
Dialogue: 0,1:48:48.96,1:48:52.96,Default,,0000,0000,0000,,Құбыжықтар өсірді
Dialogue: 0,1:48:48.96,1:48:52.96,Default,,0000,0000,0000,,Бұл құбыжық бала.
Dialogue: 0,1:48:54.96,1:48:57.96,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,1:48:57.96,1:48:59.97,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,1:49:05.91,1:49:07.91,Default,,0000,0000,0000,,Ха…
Dialogue: 0,1:49:11.91,1:49:17.92,Default,,0000,0000,0000,,Мына жер қайда?
Dialogue: 0,1:49:17.92,1:49:22.92,Default,,0000,0000,0000,,Әкесі Ана… Джиромару…
Dialogue: 0,1:49:22.92,1:49:25.93,Default,,0000,0000,0000,,Мен не істеп жүрмін...
Dialogue: 0,1:49:25.93,1:49:29.93,Default,,0000,0000,0000,,Мен бәрімен бірге аренаға шыққаныма сенімдімін...
Dialogue: 0,1:49:29.93,1:49:31.93,Default,,0000,0000,0000,,Уф…
Dialogue: 0,1:49:37.94,1:49:42.94,Default,,0000,0000,0000,,Бұл Кютаның...
Dialogue: 0,1:49:42.94,1:49:44.95,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:49:44.95,1:49:55.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:49:55.96,1:49:57.96,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:49:57.96,1:50:01.96,Default,,0000,0000,0000,,((Мен осындаймын деп шешкеннен кейін)
Dialogue: 0,1:49:57.96,1:50:01.96,Default,,0000,0000,0000,,Ары қарай иілмейтін менің табиғатым ғой))
Dialogue: 0,1:50:01.96,1:50:04.97,Default,,0000,0000,0000,,А... Мен білемін.
Dialogue: 0,1:50:04.97,1:50:07.97,Default,,0000,0000,0000,,((Мен шатасқан кезде...
Dialogue: 0,1:50:04.97,1:50:07.97,Default,,0000,0000,0000,,Мен сені дәл кеудеңе үрлеймін))
Dialogue: 0,1:50:07.97,1:50:10.97,Default,,0000,0000,0000,,Уайымдама, адасып қалма
Dialogue: 0,1:50:10.97,1:50:13.97,Default,,0000,0000,0000,,((мен келуім керек
Dialogue: 0,1:50:10.97,1:50:13.97,Default,,0000,0000,0000,,Хи хи хи...))
Dialogue: 0,1:50:13.97,1:50:16.98,Default,,0000,0000,0000,,Мен не істеймін
Dialogue: 0,1:50:13.97,1:50:16.98,Default,,0000,0000,0000,,Аузыңды жап, қарап тұр.
Dialogue: 0,1:50:16.98,1:50:20.98,Default,,0000,0000,0000,,((Оу
Dialogue: 0,1:50:16.98,1:50:20.98,Default,,0000,0000,0000,,көрсетейін))
Dialogue: 0,1:50:20.98,1:50:24.99,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:50:24.99,1:50:28.99,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:50:28.99,1:50:45.01,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:50:45.01,1:50:49.01,Default,,0000,0000,0000,,Кеше түнде Токио, Шибуя қаласында
Dialogue: 0,1:50:45.01,1:50:49.01,Default,,0000,0000,0000,,Ұшқышсыз үлкен тіркеме бақылаудан шығып қалды➡
Dialogue: 0,1:50:49.01,1:50:51.01,Default,,0000,0000,0000,,Үлкен жарылыс болды.
Dialogue: 0,1:50:51.01,1:50:55.02,Default,,0000,0000,0000,,Эвакуация кезінде құлап қалсаңыз және т.б.
Dialogue: 0,1:50:51.01,1:50:55.02,Default,,0000,0000,0000,,Көптеген адамдар жарақат алды➡
Dialogue: 0,1:50:55.02,1:50:57.02,Default,,0000,0000,0000,,Барлық жарақаттар жеңіл.
Dialogue: 0,1:50:57.02,1:51:00.95,Default,,0000,0000,0000,,Полицияның хабарлауынша, апаттың алдында
Dialogue: 0,1:50:57.02,1:51:00.95,Default,,0000,0000,0000,,Кит тәрізді фигураны көргені туралы есеп
Dialogue: 0,1:51:00.95,1:51:02.96,Default,,0000,0000,0000,,Көптеген
Dialogue: 0,1:51:00.95,1:51:02.96,Default,,0000,0000,0000,,Мен оның қабылданғанын түсінемін.
Dialogue: 0,1:51:02.96,1:51:05.96,Default,,0000,0000,0000,,Қауіпсіздік камералары бар
Dialogue: 0,1:51:02.96,1:51:05.96,Default,,0000,0000,0000,,Ештеңе көрсетілмеді...
Dialogue: 0,1:51:07.96,1:51:13.97,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:51:13.97,1:51:15.97,Default,,0000,0000,0000,,Мұқият қараңыз
Dialogue: 0,1:51:15.97,1:51:18.97,Default,,0000,0000,0000,,Алдымен сол Кюта
Dialogue: 0,1:51:15.97,1:51:18.97,Default,,0000,0000,0000,,Ол жай ғана әлсіз бала еді.
Dialogue: 0,1:51:18.97,1:51:23.98,Default,,0000,0000,0000,,Менің айтайын дегенім, сендер де балалар.
Dialogue: 0,1:51:18.97,1:51:23.98,Default,,0000,0000,0000,,Өзіңізді күнделікті жаттығуларға арнасаңыз➡
Dialogue: 0,1:51:23.98,1:51:27.98,Default,,0000,0000,0000,,Бір күні мен толыққанды адам боламын.
Dialogue: 0,1:51:23.98,1:51:27.98,Default,,0000,0000,0000,,Уау...
Dialogue: 0,1:51:27.98,1:51:30.98,Default,,0000,0000,0000,,...мүмкін
Dialogue: 0,1:51:27.98,1:51:30.98,Default,,0000,0000,0000,,...мүмкін
Dialogue: 0,1:51:30.98,1:51:32.99,Default,,0000,0000,0000,,(Шәкірттердің күрсінуі)
Dialogue: 0,1:51:32.99,1:51:34.99,Default,,0000,0000,0000,,Құдай ретіндегі реинкарнация
Dialogue: 0,1:51:32.99,1:51:34.99,Default,,0000,0000,0000,,Бұл мүмкіндікті пайдаланыңыз➡
Dialogue: 0,1:51:34.99,1:51:37.99,Default,,0000,0000,0000,,Менің өмірімді жоғалтуыма Куматецу кінәлі болды.
Dialogue: 0,1:51:37.99,1:51:40.99,Default,,0000,0000,0000,,Шебердің орнына қайта оралыңыз.
Dialogue: 0,1:51:40.99,1:51:45.00,Default,,0000,0000,0000,,Утаж
Dialogue: 0,1:51:40.99,1:51:45.00,Default,,0000,0000,0000,,Ал, бүгін Кютаны тойлауға арналған мереке.
Dialogue: 0,1:51:45.00,1:51:47.00,Default,,0000,0000,0000,,Сәлеметсіз бе...
Dialogue: 0,1:51:45.00,1:51:47.00,Default,,0000,0000,0000,,Һм?
Dialogue: 0,1:51:47.00,1:51:49.00,Default,,0000,0000,0000,,О, мынаны қара!
Dialogue: 0,1:51:49.00,1:51:55.01,Default,,0000,0000,0000,,Ол қыз да
Dialogue: 0,1:51:49.00,1:51:55.01,Default,,0000,0000,0000,,Кютаны қолдаған адамдардың бірі
Dialogue: 0,1:51:55.01,1:51:58.01,Default,,0000,0000,0000,,Каэде! Неге мұндасың?
Dialogue: 0,1:51:58.01,1:52:00.95,Default,,0000,0000,0000,,Хехе... Мені шақырды.
Dialogue: 0,1:52:00.95,1:52:02.95,Default,,0000,0000,0000,,Әй, бұл!
Dialogue: 0,1:52:00.95,1:52:02.95,Default,,0000,0000,0000,,Мен оны жолда тастадым➡
Dialogue: 0,1:52:02.95,1:52:07.95,Default,,0000,0000,0000,,Мен оны іздеуде қиналдым.
Dialogue: 0,1:52:02.95,1:52:07.95,Default,,0000,0000,0000,,Иә, қайтарыңыз!
Dialogue: 0,1:52:07.95,1:52:11.96,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,1:52:07.95,1:52:11.96,Default,,0000,0000,0000,,Және бұл! Жоғары тану үшін өтініш нысаны
Dialogue: 0,1:52:11.96,1:52:14.96,Default,,0000,0000,0000,,Не істеу керек? Сіз оны әлі де қабылдауға дайынсыз ба?
Dialogue: 0,1:52:14.96,1:52:16.96,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,1:52:16.96,1:52:20.97,Default,,0000,0000,0000,,Рен не істеу керектігін өзі таңдайды.
Dialogue: 0,1:52:20.97,1:52:22.97,Default,,0000,0000,0000,,Қабылдау
Dialogue: 0,1:52:22.97,1:52:26.97,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:52:22.97,1:52:26.97,Default,,0000,0000,0000,,Мен солай ойладым!
Dialogue: 0,1:52:26.97,1:52:28.98,Default,,0000,0000,0000,,Барымызды бірге жасайық
Dialogue: 0,1:52:26.97,1:52:28.98,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:52:28.98,1:52:31.98,Default,,0000,0000,0000,,Отшашуды атайық!
Dialogue: 0,1:52:35.98,1:52:39.99,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:52:39.99,1:52:51.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:52:51.00,1:53:02.94,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:53:02.94,1:53:04.94,Default,,0000,0000,0000,,Бұл алғаш рет.
Dialogue: 0,1:53:04.94,1:53:06.95,Default,,0000,0000,0000,,Хэхе...
Dialogue: 0,1:53:06.95,1:53:08.95,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:53:08.95,1:53:11.95,Default,,0000,0000,0000,,(Хякушюбо)
Dialogue: 0,1:53:08.95,1:53:11.95,Default,,0000,0000,0000,,Содан Кюта Шибүтенғайдан шығып кетті➡
Dialogue: 0,1:53:11.95,1:53:14.95,Default,,0000,0000,0000,,Ешқашан қылыш ұстамады
Dialogue: 0,1:53:14.95,1:53:18.96,Default,,0000,0000,0000,,Бірақ ол басқалардан мықты қылышшы.
Dialogue: 0,1:53:14.95,1:53:18.96,Default,,0000,0000,0000,,О
Dialogue: 0,1:53:18.96,1:53:23.96,Default,,0000,0000,0000,,Кеудеде
Dialogue: 0,1:53:18.96,1:53:23.96,Default,,0000,0000,0000,,Ол Куматецу атты семсері бар жалғыз қылышшы.
Dialogue: 0,1:53:23.96,1:53:27.97,Default,,0000,0000,0000,,(татара)
Dialogue: 0,1:53:23.96,1:53:27.97,Default,,0000,0000,0000,,Ол қазірден қанша қашықтыққа барады?
Dialogue: 0,1:53:23.96,1:53:27.97,Default,,0000,0000,0000,,Маған қиын болды➡
Dialogue: 0,1:53:27.97,1:53:29.97,Default,,0000,0000,0000,,Сіз оны орындайтыныңызға сенімдімін.
Dialogue: 0,1:53:29.97,1:53:37.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:53:37.98,1:53:40.98,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:53:40.98,1:53:54.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:53:54.99,1:53:59.00,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:54:03.94,1:54:09.94,Default,,0000,0000,0000,,♬『Басынан бастау』
Dialogue: 0,1:54:09.94,1:54:20.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:54:20.95,1:54:30.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:54:30.96,1:54:37.97,Default,,0000,0000,0000,,♬ Ұлғайтылған құбыжық басы
Dialogue: 0,1:54:37.97,1:54:43.98,Default,,0000,0000,0000,,♬ Жасырылған шолақ мылтықпен өлтіру
Dialogue: 0,1:54:43.98,1:54:49.98,Default,,0000,0000,0000,,Екілену
Dialogue: 0,1:54:43.98,1:54:49.98,Default,,0000,0000,0000,,♬ Бұл жолы ойланбастан
Dialogue: 0,1:54:49.98,1:54:55.99,Default,,0000,0000,0000,,♬ Мен триггерді тартқым келеді
Dialogue: 0,1:54:55.99,1:55:02.93,Default,,0000,0000,0000,,♬ Ол шынымен бос әурешілік пе?
Dialogue: 0,1:55:02.93,1:55:07.93,Default,,0000,0000,0000,,♬ Сәтсіздіктен қорқу?
Dialogue: 0,1:55:07.93,1:55:14.94,Default,,0000,0000,0000,,♬ Жоғары көтерілді, аяққа тұрып
Dialogue: 0,1:55:14.94,1:55:19.95,Default,,0000,0000,0000,,♬ Өзін-өзі бағалаудың жоғарылауы?
Dialogue: 0,1:55:19.95,1:55:26.95,Default,,0000,0000,0000,,♬ Енді тұрақсыз тыныс алуды реттеңіз.
Dialogue: 0,1:55:26.95,1:55:34.96,Default,,0000,0000,0000,,♬ Саусағыңыздың ұшына санаңызды бағыттаңыз
Dialogue: 0,1:55:34.96,1:55:40.97,Default,,0000,0000,0000,,♬ Мен ғана баратын дүниеде
Dialogue: 0,1:55:34.96,1:55:40.97,Default,,0000,0000,0000,,Әйтеуір, мен жігітпін ғой.
Dialogue: 0,1:55:34.96,1:55:40.97,Default,,0000,0000,0000,,Мылтық дыбыстары естіледі
Dialogue: 0,1:55:40.97,1:55:46.97,Default,,0000,0000,0000,,Таңқаларлық
Dialogue: 0,1:55:40.97,1:55:46.97,Default,,0000,0000,0000,,Эфемерлі
Dialogue: 0,1:55:40.97,1:55:46.97,Default,,0000,0000,0000,,♬ Жарқыраған, өткінші жарқыл жүгіріп өтті
Dialogue: 0,1:55:46.97,1:55:52.98,Default,,0000,0000,0000,,♬ «Бірдеңе бітті
Dialogue: 0,1:55:46.97,1:55:52.98,Default,,0000,0000,0000,,Бірдеңе қайта басталып жатыр».
Dialogue: 0,1:55:52.98,1:56:01.92,Default,,0000,0000,0000,,♬ Иә, мен сенімдімін
Dialogue: 0,1:55:52.98,1:56:01.92,Default,,0000,0000,0000,,Сол жарық маған айқайлап тұр
Dialogue: 0,1:56:01.92,1:56:11.93,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:56:11.93,1:56:17.94,Default,,0000,0000,0000,,♬ Бұрыштағы құбыжық
Dialogue: 0,1:56:11.93,1:56:17.94,Default,,0000,0000,0000,,Көздің артында
Dialogue: 0,1:56:17.94,1:56:23.94,Default,,0000,0000,0000,,♬ Жалғыздық пен тазалықты табу
Dialogue: 0,1:56:23.94,1:56:29.95,Default,,0000,0000,0000,,♬ Тастанды котенка сияқты
Dialogue: 0,1:56:29.95,1:56:35.96,Default,,0000,0000,0000,,Дене
Dialogue: 0,1:56:29.95,1:56:35.96,Default,,0000,0000,0000,,неге бізге сондай әңгіме айтқанына таңғаламын…
Dialogue: 0,1:56:29.95,1:56:35.96,Default,,0000,0000,0000,,♬ Қорқыныштан бүйрегі бұрылды
Dialogue: 0,1:56:35.96,1:56:42.96,Default,,0000,0000,0000,,Мен не істеуім керек деп ойлайсың?
Dialogue: 0,1:56:35.96,1:56:42.96,Default,,0000,0000,0000,,♬ Аа, мені осылай арқанмен байланыстыршы
Dialogue: 0,1:56:42.96,1:56:49.97,Default,,0000,0000,0000,,♬ Үйренуге болады
Dialogue: 0,1:56:42.96,1:56:49.97,Default,,0000,0000,0000,,Мүмкін болса
Dialogue: 0,1:56:49.97,1:56:55.98,Default,,0000,0000,0000,,♬ Көптеген таңдаулар және
Dialogue: 0,1:56:49.97,1:56:55.98,Default,,0000,0000,0000,,Мүмкіндіктермен қоршалған
Dialogue: 0,1:56:55.98,1:57:01.91,Default,,0000,0000,0000,,♬ Іздегенім, қалағаным
Dialogue: 0,1:56:55.98,1:57:01.91,Default,,0000,0000,0000,,Бұлыңғыр болу
Dialogue: 0,1:57:01.91,1:57:07.92,Default,,0000,0000,0000,,♬ «Бірдеңе туады
Dialogue: 0,1:57:01.91,1:57:07.92,Default,,0000,0000,0000,,Бірдеңе қайтадан өліп жатыр».
Dialogue: 0,1:57:07.92,1:57:16.93,Default,,0000,0000,0000,,♬ Иә, сол жерден екеніне сенімдімін.
Dialogue: 0,1:57:07.92,1:57:16.93,Default,,0000,0000,0000,,Сіз қашып құтыла алмайсыз
Dialogue: 0,1:57:16.93,1:57:23.94,Default,,0000,0000,0000,,♬ Тым тыныш ымырт
Dialogue: 0,1:57:16.93,1:57:23.94,Default,,0000,0000,0000,,Шидзима
Dialogue: 0,1:57:16.93,1:57:23.94,Default,,0000,0000,0000,,Түн ортасы тыныштық
Dialogue: 0,1:57:23.94,1:57:28.94,Default,,0000,0000,0000,,♬ Құбыжықтар қайтадан қобалжи бастады
Dialogue: 0,1:57:28.94,1:57:35.95,Default,,0000,0000,0000,,♬ Мен демімді басып қалдым.
Dialogue: 0,1:57:28.94,1:57:35.95,Default,,0000,0000,0000,,Журналды жүктеу
Dialogue: 0,1:57:35.95,1:57:44.96,Default,,0000,0000,0000,,♬ Бұл тыныш өлтіру ниеті
Dialogue: 0,1:57:35.95,1:57:44.96,Default,,0000,0000,0000,,Сізге назар аудармау үшін
Dialogue: 0,1:57:44.96,1:57:51.96,Default,,0000,0000,0000,,♬ Бүгін де мен ғана баратын дүниеде
Dialogue: 0,1:57:44.96,1:57:51.96,Default,,0000,0000,0000,,Мылтық дыбысы естіледі
Dialogue: 0,1:57:51.96,1:57:57.97,Default,,0000,0000,0000,,♬ Жарқыраған, өткінші жарқыл жүгіріп өтті
Dialogue: 0,1:57:57.97,1:58:03.91,Default,,0000,0000,0000,,♬ «Бірдеңе бітті
Dialogue: 0,1:57:57.97,1:58:03.91,Default,,0000,0000,0000,,Бірдеңе қайта басталып жатыр».
Dialogue: 0,1:58:03.91,1:58:10.92,Default,,0000,0000,0000,,♬ Бұл мәңгілікке ұнайды
Dialogue: 0,1:58:03.91,1:58:10.92,Default,,0000,0000,0000,,Бұл дүние айналады
Dialogue: 0,1:58:10.92,1:58:16.92,Default,,0000,0000,0000,,♬ «Бірдеңе бітті
Dialogue: 0,1:58:10.92,1:58:16.92,Default,,0000,0000,0000,,Бірдеңе қайта басталып жатыр».
Dialogue: 0,1:58:16.92,1:58:24.93,Default,,0000,0000,0000,,♬ Әрине
Dialogue: 0,1:58:24.93,1:58:44.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:58:44.95,1:58:58.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
