Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.25,0:00:06.25,Default,,0,0,0,,♪～
Dialogue: 0,0:01:25.96,0:01:30.96,Default,,0,0,0,,～♪
Dialogue: 0,0:01:56.19,0:01:57.49,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:01:57.61,0:02:02.62,Default,,0,0,0,,Сен кімсің өзі…
Dialogue: 0,0:02:03.37,0:02:05.04,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:06.58,0:02:08.41,Default,,0,0,0,,Сондай-ақ... Морита мырза
Dialogue: 0,0:02:09.96,0:02:11.13,Default,,0,0,0,,О...
Dialogue: 0,0:02:11.67,0:02:13.29,Default,,0,0,0,,Көз алмасының маңдай бөлігі
Dialogue: 0,0:02:13.42,0:02:16.80,Default,,0,0,0,,Мынау бауыр, мынау он екі елі ішек...
Dialogue: 0,0:02:17.38,0:02:19.30,Default,,0,0,0,,Барлығы бөлшектелген
Dialogue: 0,0:02:19.68,0:02:22.39,Default,,0,0,0,,Мен бұл адамның жұмысы екеніне сене алар емеспін.
Dialogue: 0,0:02:22.51,0:02:24.97,Default,,0,0,0,,Бұл ауытқу содан бері орын алып келеді.
Dialogue: 0,0:02:25.27,0:02:28.56,Default,,0,0,0,,Бес жыл бұрынғы кісі өлтірулер сериясы...
Dialogue: 0,0:02:36.40,0:02:37.78,Default,,0,0,0,,Морита мырза...
Dialogue: 0,0:02:38.19,0:02:41.32,Default,,0,0,0,,(Әйелдің айғайы)
Dialogue: 0,0:02:41.57,0:02:42.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:45.37,0:02:46.16,Default,,0,0,0,,Ах
Dialogue: 0,0:02:55.92,0:02:57.21,Default,,0,0,0,,Иә иә…
Dialogue: 0,0:02:57.63,0:02:58.67,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:14.40,0:03:19.40,Default,,0,0,0,,(Манаканың күлкісі)
Dialogue: 0,0:03:28.49,0:03:29.58,Default,,0,0,0,,Хехе…
Dialogue: 0,0:03:32.50,0:03:35.50,Default,,0,0,0,,Шизуэ Вакаса қандай адам болды?
Dialogue: 0,0:03:35.63,0:03:37.17,Default,,0,0,0,,Сізде біреуге өшпенділік бар ма?
Dialogue: 0,0:03:37.30,0:03:39.67,Default,,0,0,0,,Шизу ондай адам емес!
Dialogue: 0,0:03:40.55,0:03:43.01,Default,,0,0,0,,Қарсы болмасаңыз, менімен сөйлесе аласыз ба?
Dialogue: 0,0:03:44.43,0:03:47.64,Default,,0,0,0,,Жарқын және мейірімді
Dialogue: 0,0:03:49.39,0:03:51.73,Default,,0,0,0,,Бұл кейде қиын болды, бірақ...
Dialogue: 0,0:03:52.89,0:03:54.52,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:03:55.40,0:03:57.44,Default,,0,0,0,,Өйткені Шизу күшті адам болатын.
Dialogue: 0,0:03:57.82,0:03:58.69,Default,,0,0,0,,Күшті?
Dialogue: 0,0:03:59.11,0:04:00.61,Default,,0,0,0,,Қалай?
Dialogue: 0,0:04:02.65,0:04:04.86,Default,,0,0,0,,Менің сезімім түзу...
Dialogue: 0,0:04:05.41,0:04:07.62,Default,,0,0,0,,ақыл-ойы күшті
Dialogue: 0,0:04:07.91,0:04:10.12,Default,,0,0,0,,Ол сенімді болды... әлде бір нәрсе ме?
Dialogue: 0,0:04:10.79,0:04:11.41,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:11.79,0:04:13.50,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:18.09,0:04:20.21,Default,,0,0,0,,Рика-сан дедіңіз бе?
Dialogue: 0,0:04:20.67,0:04:24.76,Default,,0,0,0,,Мен Шизуэ-санмен алмасу күнделігін жүргіздім.
Dialogue: 0,0:04:26.34,0:04:28.10,Default,,0,0,0,,Мен сіздің қозғалып жатқаныңызды естідім...
Dialogue: 0,0:04:28.72,0:04:30.43,Default,,0,0,0,,Әдепті болыңыз.
Dialogue: 0,0:04:31.27,0:04:33.14,Default,,0,0,0,,Мен шынымен абдырап қалдым.
Dialogue: 0,0:04:33.69,0:04:36.48,Default,,0,0,0,,Анама көрсете аламын ба?
Dialogue: 0,0:04:42.86,0:04:45.36,Default,,0,0,0,,Өйткені екеуміз де уайымымызды қағазға түсірдік.
Dialogue: 0,0:04:45.49,0:04:46.20,Default,,0,0,0,,Ум...
Dialogue: 0,0:04:48.07,0:04:50.37,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:04:51.37,0:04:52.87,Default,,0,0,0,,Бұл да естеліктер.
Dialogue: 0,0:04:53.96,0:04:55.75,Default,,0,0,0,,Амансың деп үміттенемін.
Dialogue: 0,0:05:03.88,0:05:04.92,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:05:05.76,0:05:08.72,Default,,0,0,0,,Өткен күн бұл күндері қалаға оралады.
Dialogue: 0,0:05:09.18,0:05:09.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:18.06,0:05:18.73,Default,,0,0,0,,Шизу
Dialogue: 0,0:05:20.48,0:05:21.32,Default,,0,0,0,,Мені кешіріңіз...
Dialogue: 0,0:05:21.40,0:05:22.57,Default,,0,0,0,,(Субару) Қабыл ал! (Шаттер дыбысы)
Dialogue: 0,0:05:35.58,0:05:37.54,Default,,0,0,0,,"Рика-нчи, келесің бе? Сен сабаққа барасың ба?"
Dialogue: 0,0:05:38.58,0:05:40.63,Default,,0,0,0,,«Екеуі де келетініне сенімдімін».
Dialogue: 0,0:05:40.75,0:05:43.09,Default,,0,0,0,,«Бірақ олар кездесуде жүрген сияқты».
Dialogue: 0,0:05:43.21,0:05:45.38,Default,,0,0,0,,«Сен маған не киемін деп жатырсың?»
Dialogue: 0,0:05:52.31,0:05:52.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:53.26,0:05:56.52,Default,,0,0,0,,«Кешіріңіз, сізді алаңдатқаным үшін кешіріңіз».
Dialogue: 0,0:05:56.64,0:05:58.60,Default,,0,0,0,,«Мен бүгін жаза алатыным осы ғана»
Dialogue: 0,0:05:58.73,0:06:01.52,Default,,0,0,0,,«Көз жасым тоқтаса, мен баяу сөйлеймін».
Dialogue: 0,0:06:03.07,0:06:03.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:12.87,0:06:16.00,Default,,0,0,0,,(Шидзу жылайды)
Dialogue: 0,0:06:16.12,0:06:17.41,Default,,0,0,0,,Әкем…
Dialogue: 0,0:06:17.54,0:06:22.54,Default,,0,0,0,,(Шидзу жылайды)
Dialogue: 0,0:06:23.34,0:06:25.34,Default,,0,0,0,,Қашанға дейін жылайсың?
Dialogue: 0,0:06:26.13,0:06:27.67,Default,,0,0,0,,Оқу уақыты келді
Dialogue: 0,0:06:27.80,0:06:32.80,Default,,0,0,0,,(Шидзу мен Сачиконың айқайы)
Dialogue: 0,0:06:35.26,0:06:37.27,Default,,0,0,0,,Мен де сенімен бірге жасаймын.
Dialogue: 0,0:06:47.15,0:06:49.20,Default,,0,0,0,,«Мен шынымен жылауды тоқтата алмадым».
Dialogue: 0,0:06:50.07,0:06:53.62,Default,,0,0,0,,«Менің анам сақтандыру агенті ретінде жұмысқа орналасуды шешіп қойған».
Dialogue: 0,0:06:54.37,0:06:56.95,Default,,0,0,0,,«Енді көз жасыңды менің алдымда көрсетпе...»
Dialogue: 0,0:06:57.62,0:06:59.37,Default,,0,0,0,,Жарайды, тек оны аяқтау керек.
Dialogue: 0,0:06:59.50,0:07:02.13,Default,,0,0,0,,Мен келемін. (Шизэ) Қош келдіңіз.
Dialogue: 0,0:07:04.04,0:07:06.46,Default,,0,0,0,,«Әкем қайтыс болғанына бір апта болды»
Dialogue: 0,0:07:06.59,0:07:10.09,Default,,0,0,0,,«Мен әлі емтихан сұрақтар кітапшасын ашқан жоқпын...»
Dialogue: 0,0:07:11.47,0:07:16.14,Default,,0,0,0,,``Сол күні мен анама алғаш рет жасанды күлкі сыйладым.''
Dialogue: 0,0:07:16.26,0:07:21.27,Default,,0,0,0,,(Екінші қолдың дыбысы)
Dialogue: 0,0:07:30.57,0:07:31.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:35.07,0:07:35.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:41.71,0:07:46.71,Default,,0,0,0,,(Манаканың күлкісі)
Dialogue: 0,0:07:53.55,0:07:55.64,Default,,0,0,0,,Бірақ үйде босану...
Dialogue: 0,0:07:55.76,0:07:58.51,Default,,0,0,0,,Маюми шынымен де өз қарқынымен жүруді ұнататын сияқты.
Dialogue: 0,0:07:58.64,0:08:01.43,Default,,0,0,0,,Сен орта мектептен бері мүлде өзгерген жоқсың.
Dialogue: 0,0:08:01.56,0:08:03.85,Default,,0,0,0,,Менің өз қарқыныммен...
Dialogue: 0,0:08:04.48,0:08:07.52,Default,,0,0,0,,Егер сіз ауруханада болсаңыз, сізді мұқият тексереді, солай ма?
Dialogue: 0,0:08:07.65,0:08:09.19,Default,,0,0,0,,Жалғыз басты ана дейсіз бе?
Dialogue: 0,0:08:09.86,0:08:13.36,Default,,0,0,0,,Бұл бүгінде жиі кездесетін әңгіме.
Dialogue: 0,0:08:14.24,0:08:15.87,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:08:16.24,0:08:19.33,Default,,0,0,0,,Тітіркену және психикалық денсаулық туралы не деуге болады?
Dialogue: 0,0:08:19.70,0:08:22.16,Default,,0,0,0,,Сізге рахмет, менде бәрі жақсы.
Dialogue: 0,0:08:22.75,0:08:26.50,Default,,0,0,0,,Мүмкін Макиконың маған берген инъекциясы жұмыс істеді.
Dialogue: 0,0:08:27.29,0:08:28.29,Default,,0,0,0,,Иә
Dialogue: 0,0:08:28.54,0:08:31.05,Default,,0,0,0,,Сонда бәрі жақсы.
Dialogue: 0,0:08:31.17,0:08:34.84,Default,,0,0,0,,Бірақ кешеден бері аздап ауырып жүрмін.
Dialogue: 0,0:08:35.13,0:08:37.35,Default,,0,0,0,,Босануға ерте сияқты...
Dialogue: 0,0:08:37.80,0:08:40.14,Default,,0,0,0,,Кейде сондай адамдар болады.
Dialogue: 0,0:08:40.26,0:08:41.35,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:08:48.81,0:08:51.90,Default,,0,0,0,,Зәр және қан қалыпты.
Dialogue: 0,0:08:52.49,0:08:55.11,Default,,0,0,0,,Сацуки ауруы емес пе?
Dialogue: 0,0:08:55.24,0:08:57.37,Default,,0,0,0,,Менің ішім неге ауырады?
Dialogue: 0,0:08:57.49,0:08:58.70,Default,,0,0,0,,Қалай...
Dialogue: 0,0:08:58.82,0:09:01.83,Default,,0,0,0,,Тамақ ішер алдында немесе тамақтан кейін ауырсынуды сезінесіз бе?
Dialogue: 0,0:09:02.58,0:09:05.62,Default,,0,0,0,,Шашыңыз ұзын болса жақсырақ болмайсыз ба?
Dialogue: 0,0:09:06.33,0:09:08.00,Default,,0,0,0,,Мен дәрі алғым келеді.
Dialogue: 0,0:09:08.13,0:09:11.42,Default,,0,0,0,,Сіз дәріханада сатылатын дәрілерден де күшті дәрілерді ала аласыз, солай ма?
Dialogue: 0,0:09:11.55,0:09:12.92,Default,,0,0,0,,Тағы да
Dialogue: 0,0:09:13.05,0:09:15.97,Default,,0,0,0,,Мұндай жағымсыз сөздерді айтатын науқастар көп.
Dialogue: 0,0:09:16.09,0:09:18.84,Default,,0,0,0,,Жүр, мен сенің ішіңді тексеремін, киіміңді көтер.
Dialogue: 0,0:09:19.18,0:09:20.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:20.93,0:09:22.60,Default,,0,0,0,,Не болды? Келіңіздер
Dialogue: 0,0:09:23.27,0:09:24.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:26.23,0:09:28.06,Default,,0,0,0,,Жоқ... тоқтатыңыз.
Dialogue: 0,0:09:28.56,0:09:29.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:30.11,0:09:30.77,Default,,0,0,0,,Сіз!
Dialogue: 0,0:09:30.90,0:09:32.65,Default,,0,0,0,,Жарайды... тиіспе.
Dialogue: 0,0:09:32.78,0:09:35.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:42.95,0:09:45.45,Default,,0,0,0,,Анау диантус әдемі, солай емес пе?
Dialogue: 0,0:09:45.71,0:09:48.46,Default,,0,0,0,,Негізі ол жаздан күзге дейін гүлдеп тұруы керек.
Dialogue: 0,0:09:48.58,0:09:50.38,Default,,0,0,0,,Бұл жерде күн жылы
Dialogue: 0,0:09:50.96,0:09:54.13,Default,,0,0,0,,Адамдық тілмен айтқанда, бұл шала туылу дегенді білдіре ме?
Dialogue: 0,0:09:54.76,0:09:57.97,Default,,0,0,0,,Аа... Кешіріңіз, үзіліс алдыңыз.
Dialogue: 0,0:09:59.14,0:09:59.80,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:00.55,0:10:02.47,Default,,0,0,0,,Әлде олар бір Caryophyllidae тұқымдасына жататындықтан ба?
Dialogue: 0,0:10:02.85,0:10:05.52,Default,,0,0,0,,Мүмкін мен оны жұлып алып саған беруім керек шығар.
Dialogue: 0,0:10:05.64,0:10:06.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.06,0:10:09.52,Default,,0,0,0,,Өйткені бүгін аналар күні.
Dialogue: 0,0:10:10.10,0:10:10.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:14.86,0:10:16.32,Default,,0,0,0,,Алдымен мынаны айтайын...
Dialogue: 0,0:10:16.44,0:10:19.07,Default,,0,0,0,,Психосоматикалық терапия бөлек ақы.
Dialogue: 0,0:10:19.70,0:10:23.49,Default,,0,0,0,,Түсіндің бе? Тіпті дәрігерлердің де қабылдауына бес рет жазылады.
Dialogue: 0,0:10:25.16,0:10:25.91,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:26.29,0:10:29.92,Default,,0,0,0,,Менің тәжірибемнен бұл PTSD болуы мүмкін.
Dialogue: 0,0:10:30.04,0:10:33.04,Default,,0,0,0,,Жарақаттан туындаған жүйкелік жедел гастрит.
Dialogue: 0,0:10:33.17,0:10:36.13,Default,,0,0,0,,Сол жарақатты жою ғана қалды.
Dialogue: 0,0:10:36.26,0:10:38.38,Default,,0,0,0,,бастайық.
Dialogue: 0,0:10:40.22,0:10:41.97,Default,,0,0,0,,Менің ойымша, бұл ысырап.
Dialogue: 0,0:10:43.22,0:10:46.39,Default,,0,0,0,,Бәрібір ешкім түсінбейді...
Dialogue: 0,0:10:47.73,0:10:49.60,Default,,0,0,0,,Оны күштеп емдеудің қажеті жоқ, солай ма?
Dialogue: 0,0:10:50.81,0:10:55.15,Default,,0,0,0,,Кейде әйелдер әлсіз кезде бақыттырақ болады.
Dialogue: 0,0:10:55.27,0:10:58.86,Default,,0,0,0,,Әйел неғұрлым күшті болса, соғұрлым арсыз еркектің көзіне түсуі ықтимал.
Dialogue: 0,0:10:58.99,0:11:02.95,Default,,0,0,0,,Тәкаппарлығыңды жұлып алудан ләззат алатын қанішер сияқты.
Dialogue: 0,0:11:03.07,0:11:03.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:04.83,0:11:07.41,Default,,0,0,0,,Мен мұны сізді жігерлендіру үшін айттым.
Dialogue: 0,0:11:07.54,0:11:10.29,Default,,0,0,0,,Бірақ бұл жаман ұқсастық болды.
Dialogue: 0,0:11:11.17,0:11:12.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:13.58,0:11:16.38,Default,,0,0,0,,Мен ерекше күшті болғым келмейді.
Dialogue: 0,0:11:25.10,0:11:28.22,Default,,0,0,0,,(Шизэдің ауыр тыныс алуы)
Dialogue: 0,0:11:28.77,0:11:29.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:30.64,0:11:34.61,Default,,0,0,0,,Егер әлі де сөйлескіңіз келмесе, бүгін жақсы.
Dialogue: 0,0:11:36.32,0:11:39.03,Default,,0,0,0,,Мен армандаймын...
Dialogue: 0,0:11:39.40,0:11:40.28,Default,,0,0,0,,Не?
Dialogue: 0,0:11:42.11,0:11:44.74,Default,,0,0,0,,Аң... шабуыл жасайды.
Dialogue: 0,0:11:45.78,0:11:46.70,Default,,0,0,0,,Сіз?
Dialogue: 0,0:11:48.16,0:11:49.33,Default,,0,0,0,,Менің анам.
Dialogue: 0,0:11:50.04,0:11:51.50,Default,,0,0,0,,Қандай аң?
Dialogue: 0,0:11:53.08,0:11:53.75,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:54.96,0:11:57.04,Default,,0,0,0,,Менің анам қашпайды.
Dialogue: 0,0:12:02.80,0:12:06.72,Default,,0,0,0,,«Мен қыркүйекті биылғыдай көп аралас сезіммен қарсы алмаймын деп ойлаймын».
Dialogue: 0,0:12:06.85,0:12:09.89,Default,,0,0,0,,«Мен барлығын мектеп басталғанын көргеніме қуаныштымын».
Dialogue: 0,0:12:10.02,0:12:11.93,Default,,0,0,0,,«Әкемнің қайтыс болған күні де қыркүйекте»
Dialogue: 0,0:12:12.64,0:12:15.73,Default,,0,0,0,,«Күнтізбедегі сандар күнге байланысты әр түрлі мағына береді...»
Dialogue: 0,0:12:18.94,0:12:21.28,Default,,0,0,0,,Мама, мен мынаны киемін.
Dialogue: 0,0:12:21.40,0:12:24.66,Default,,0,0,0,,Қабірлерді зиярат ету үшін қызыл киім киген адамдарды қайдан табасың?
Dialogue: 0,0:12:24.78,0:12:27.91,Default,,0,0,0,,Әкем бұл Шизуге жақсы көрінеді деді.
Dialogue: 0,0:12:28.03,0:12:31.75,Default,,0,0,0,,Ей, ана да солай істесін! сонда әкем бақытты болады
Dialogue: 0,0:12:31.87,0:12:33.29,Default,,0,0,0,,Мұны істейік!
Dialogue: 0,0:12:33.41,0:12:36.50,Default,,0,0,0,,Әй, мама, сәл күте тұрыңыз, аппақ шаш.
Dialogue: 0,0:12:37.21,0:12:40.17,Default,,0,0,0,,Ах... кешіріңіз, алып тастасам көбейе ме?
Dialogue: 0,0:12:40.88,0:12:41.59,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:12:43.92,0:12:47.30,Default,,0,0,0,,Сіз ешқашан жалғыздықты көрсетпедіңіз.
Dialogue: 0,0:12:47.51,0:12:48.76,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:12:48.89,0:12:52.60,Default,,0,0,0,,Мен жеңілуге шыдай алмаймын. Мен бұл бала үшін бар күшімді салуым керек.
Dialogue: 0,0:12:52.73,0:12:56.85,Default,,0,0,0,,Біріншіден, ең болмаса университетті бітіргенше орта мектепті оқы.
Dialogue: 0,0:12:58.65,0:12:59.65,Default,,0,0,0,,Осы жоспармен...
Dialogue: 0,0:12:59.77,0:13:01.65,Default,,0,0,0,,Жеке жазатайым оқиғаға тап болсаңыз да
Dialogue: 0,0:13:02.11,0:13:04.86,Default,,0,0,0,,Сіз жұмысшылардың өтемақысын алатындай өтемақы аласыз.
Dialogue: 0,0:13:04.99,0:13:06.36,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:13:10.03,0:13:10.62,Default,,0,0,0,,Я...
Dialogue: 0,0:13:11.91,0:13:14.83,Default,,0,0,0,,Вакаса-кун, неге оны бір күн деп атамайсың?
Dialogue: 0,0:13:15.16,0:13:18.46,Default,,0,0,0,,Жоқ, ертеңге дейін цитата беруге уәде бердім.
Dialogue: 0,0:13:21.92,0:13:24.05,Default,,0,0,0,,Сіз шынымен кереметсіз, солай емес пе?
Dialogue: 0,0:13:24.17,0:13:24.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:26.05,0:13:30.22,Default,,0,0,0,,Осы бір ауыз сөзбен бүкіл денемнен күш-қуат шығып кеткендей болды.
Dialogue: 0,0:13:31.22,0:13:32.47,Default,,0,0,0,,Бүкіл денеден...
Dialogue: 0,0:13:41.32,0:13:42.02,Default,,0,0,0,,Ах
Dialogue: 0,0:13:46.57,0:13:47.78,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:13:50.99,0:13:52.03,Default,,0,0,0,,Шизу?
Dialogue: 0,0:13:58.37,0:13:59.25,Default,,0,0,0,,Шизу...
Dialogue: 0,0:14:04.17,0:14:05.38,Default,,0,0,0,,Қандай аң?
Dialogue: 0,0:14:07.17,0:14:08.26,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:15.60,0:14:16.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:16.98,0:14:18.31,Default,,0,0,0,,Сабырлы болыңыз.
Dialogue: 0,0:14:18.44,0:14:22.06,Default,,0,0,0,,Бұл жерден қашып кетсем де, ауырсыну басылмас
Dialogue: 0,0:14:22.44,0:14:23.77,Default,,0,0,0,,Кел, сөйлес.
Dialogue: 0,0:14:24.28,0:14:25.61,Default,,0,0,0,,Я...
Dialogue: 0,0:14:27.07,0:14:30.28,Default,,0,0,0,,«Рика, мұны жазғаным үшін кешірім сұраймын...»
Dialogue: 0,0:14:30.61,0:14:32.20,Default,,0,0,0,,«Сіз мені ауыртып жібердіңіз».
Dialogue: 0,0:14:33.12,0:14:36.70,Default,,0,0,0,,«Бірақ... мен өзімді жүз есе нашар сезіндім».
Dialogue: 0,0:14:37.08,0:14:39.58,Default,,0,0,0,,«Бүгін көргенім жай ғана елес болды деп үміттенемін...»
Dialogue: 0,0:14:41.08,0:14:42.67,Default,,0,0,0,,Шизу? (Шизу) Оған тиме!
Dialogue: 0,0:14:45.34,0:14:48.13,Default,,0,0,0,,«Өкінішті, бірақ бұл шындық еді».
Dialogue: 0,0:14:48.92,0:14:52.60,Default,,0,0,0,,«Менің анам көлікте болған ақ көйлек киген».
Dialogue: 0,0:14:53.76,0:14:56.22,Default,,0,0,0,,«Мен ешқашан ақ көйлек кимеймін»
Dialogue: 0,0:14:59.60,0:15:01.65,Default,,0,0,0,,``Бүгін мені қатты тастап кетті.''
Dialogue: 0,0:15:01.77,0:15:04.48,Default,,0,0,0,,``Мен өткен күні электрондық пошта арқылы өз сезімдерімді мойындасам да.''
Dialogue: 0,0:15:04.61,0:15:06.61,Default,,0,0,0,,«Рика, біз не істеуіміз керек?»
Dialogue: 0,0:15:07.15,0:15:09.07,Default,,0,0,0,,Жоқ... жоқ, тоқта...
Dialogue: 0,0:15:09.65,0:15:12.28,Default,,0,0,0,,Шизу, кешіріңіз, мен шыдай алмаймын.
Dialogue: 0,0:15:12.74,0:15:13.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:14.07,0:15:14.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:18.00,0:15:20.50,Default,,0,0,0,,Бірінші көргенім секс болды.
Dialogue: 0,0:15:20.62,0:15:22.92,Default,,0,0,0,,Өкінішке орай ол ана болды.
Dialogue: 0,0:15:23.54,0:15:25.63,Default,,0,0,0,,Сен қатты жақсы көретін әкеңді
Dialogue: 0,0:15:25.75,0:15:29.13,Default,,0,0,0,,Сол сияқты мен де анам мені әлі де жақсы көреді деп ойладым...
Dialogue: 0,0:15:29.26,0:15:30.26,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:30.97,0:15:35.30,Default,,0,0,0,,Содан бері мен жыныстық қатынасты қажетінен гөрі бір қабықпен шектедім.
Dialogue: 0,0:15:36.26,0:15:38.81,Default,,0,0,0,,Осылай қалсам, мәңгі өмір сүремін...
Dialogue: 0,0:15:39.56,0:15:41.73,Default,,0,0,0,,Маған бұл ұнамайды
Dialogue: 0,0:15:42.19,0:15:43.15,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:43.85,0:15:45.48,Default,,0,0,0,,Мұғалім, өтінемін!
Dialogue: 0,0:15:46.11,0:15:47.36,Default,,0,0,0,,Өтінемін, мені емдеңіз!
Dialogue: 0,0:15:47.48,0:15:50.03,Default,,0,0,0,,Мен бұлай жеңілгім келмейді.
Dialogue: 0,0:15:50.15,0:15:51.45,Default,,0,0,0,,Жоғалғыңыз келмей ме?
Dialogue: 0,0:15:51.78,0:15:55.53,Default,,0,0,0,,Мен мұндай ананың кесірінен құрдымға кеткім келмейді!
Dialogue: 0,0:15:55.74,0:15:56.78,Default,,0,0,0,,Менің ойымша, солай ма?
Dialogue: 0,0:15:57.37,0:16:00.25,Default,,0,0,0,,Қанша уақыт өтсе де...
Dialogue: 0,0:16:00.37,0:16:01.21,Default,,0,0,0,,Сіз аласыз!
Dialogue: 0,0:16:02.41,0:16:04.83,Default,,0,0,0,,Бұл сенімділік қайдан келеді?
Dialogue: 0,0:16:05.38,0:16:07.17,Default,,0,0,0,,Мен білдім...
Dialogue: 0,0:16:08.50,0:16:10.42,Default,,0,0,0,,Шизу! Аш, Шизу! (Есік тұтқасын бұру дыбысы)
Dialogue: 0,0:16:11.76,0:16:14.43,Default,,0,0,0,,Осылай жүре берсем, керексіз болып қалармын деп ойладым.
Dialogue: 0,0:16:14.55,0:16:17.43,Default,,0,0,0,,Мен өзімді бөлмеме қамап, үнемі сабақ оқитынмын.
Dialogue: 0,0:16:17.93,0:16:19.43,Default,,0,0,0,,Әр түн, әр түн...
Dialogue: 0,0:16:19.56,0:16:22.89,Default,,0,0,0,,Бағаларым көтеріліп, өзім қалаған мектепке түстім.
Dialogue: 0,0:16:23.14,0:16:24.02,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:16:24.77,0:16:27.65,Default,,0,0,0,,Сіздің күшіңіз жетпейді
Dialogue: 0,0:16:32.24,0:16:35.61,Default,,0,0,0,,«Гүл болғысы келетін кез келген өсімдік жақсы».
Dialogue: 0,0:16:35.74,0:16:37.41,Default,,0,0,0,,«Одуванчик...»
Dialogue: 0,0:16:37.91,0:16:40.83,Default,,0,0,0,,«Егер одуванчик тұқым болып туса...»
Dialogue: 0,0:16:40.95,0:16:42.71,Default,,0,0,0,,«Жел оны алып кетеді»
Dialogue: 0,0:16:43.29,0:16:46.04,Default,,0,0,0,,«Иә, сіз жақында жалғыз боласыз».
Dialogue: 0,0:16:46.58,0:16:49.13,Default,,0,0,0,,«Ата-анамның бетіне қарамай...»
Dialogue: 0,0:16:52.63,0:16:55.22,Default,,0,0,0,,(Сағат қоңырауының дыбысы)
Dialogue: 0,0:16:55.34,0:16:58.93,Default,,0,0,0,,Шизу, сіз байқадыңыз.
Dialogue: 0,0:16:59.35,0:17:00.39,Default,,0,0,0,,Мен білдім
Dialogue: 0,0:17:01.81,0:17:03.31,Default,,0,0,0,,Бірақ мен айта алмадым
Dialogue: 0,0:17:05.10,0:17:06.56,Default,,0,0,0,,Менің батылым жетпеді...
Dialogue: 0,0:17:08.40,0:17:12.61,Default,,0,0,0,,Бір сөзді қайта айта алмаймын деп өзімді кінәлай отырып, өзімді жұмысқа арнаудан басқа амалым жоқ деп ойладым.
Dialogue: 0,0:17:12.74,0:17:15.82,Default,,0,0,0,,Ең болмағанда оқу ақысына қатысты бірдеңе істеймін.
Dialogue: 0,0:17:17.70,0:17:18.95,Default,,0,0,0,,Ата-ананы алдау
Dialogue: 0,0:17:19.53,0:17:21.49,Default,,0,0,0,,Сіз мені кешіре алмайсыз...
Dialogue: 0,0:17:28.29,0:17:31.25,Default,,0,0,0,,Маған тиіспе
Dialogue: 0,0:17:33.46,0:17:34.59,Default,,0,0,0,,Шизу...
Dialogue: 0,0:17:39.60,0:17:40.10,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:00.53,0:18:01.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:04.08,0:18:04.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:06.87,0:18:08.46,Default,,0,0,0,,Чип! Чип, чип, чип, чип!
Dialogue: 0,0:18:09.67,0:18:12.21,Default,,0,0,0,,Біз тағы кездестік.
Dialogue: 0,0:18:12.34,0:18:12.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:13.34,0:18:15.01,Default,,0,0,0,,Мен ауруханадан біреуді шақырамын.
Dialogue: 0,0:18:15.13,0:18:17.42,Default,,0,0,0,,Жарайды (Шизэ) бірақ...
Dialogue: 0,0:18:18.68,0:18:19.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:19.97,0:18:23.56,Default,,0,0,0,,Мен сенің не айтарыңды бәрібір білемін.
Dialogue: 0,0:18:23.93,0:18:26.89,Default,,0,0,0,,«Қазір кеш емес, босанудан бас тарт»
Dialogue: 0,0:18:27.18,0:18:28.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:28.64,0:18:31.56,Default,,0,0,0,,Кеше менің жергілікті акушерім де осыны айтты.
Dialogue: 0,0:18:31.86,0:18:35.69,Default,,0,0,0,,Сондықтан мен бір нәрседен бас тарту үшін психиатр досыма келдім.
Dialogue: 0,0:18:35.82,0:18:37.82,Default,,0,0,0,,Бірақ...онда күйеуің...
Dialogue: 0,0:18:38.45,0:18:39.78,Default,,0,0,0,,Мен ол жерде емеспін (Шизэ) Иә?
Dialogue: 0,0:18:39.91,0:18:42.45,Default,,0,0,0,,Ах... Керек емес нәрселер үшін кешірім сұраймын.
Dialogue: 0,0:18:43.41,0:18:47.33,Default,,0,0,0,,Мүлдем емес, мен қазір жалғызбасты анамын.
Dialogue: 0,0:18:48.16,0:18:52.46,Default,,0,0,0,,Мен өз атыма ``гүл'' сөзін қосуды ұйғардым.
Dialogue: 0,0:18:53.21,0:18:55.09,Default,,0,0,0,,Қыз болса, Манака
Dialogue: 0,0:18:55.42,0:18:56.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:01.39,0:19:03.72,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:19:03.85,0:19:04.43,Default,,0,0,0,,Ум...
Dialogue: 0,0:19:05.18,0:19:06.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:06.22,0:19:08.02,Default,,0,0,0,,Сіз өзіңізді жалғыз сезінбейсіз бе?
Dialogue: 0,0:19:08.64,0:19:09.73,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:19:10.02,0:19:11.02,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:19:14.61,0:19:17.11,Default,,0,0,0,,Мен өзімді әйел ретінде жалғыз сезінемін.
Dialogue: 0,0:19:18.53,0:19:21.57,Default,,0,0,0,,Бірақ мен ана ретінде ризамын.
Dialogue: 0,0:19:22.16,0:19:24.83,Default,,0,0,0,,Сенің анаң да бар екеніне сенімдімін.
Dialogue: 0,0:19:25.49,0:19:26.87,Default,,0,0,0,,Не, менікі?
Dialogue: 0,0:19:27.29,0:19:31.33,Default,,0,0,0,,А... Мен ертерек көрші бөлмеде демалып жатқанмын.
Dialogue: 0,0:19:31.46,0:19:33.96,Default,,0,0,0,,Кешіріңіз, мен сіздің айтқаныңызды ести алмадым.
Dialogue: 0,0:19:34.42,0:19:36.75,Default,,0,0,0,,No, it's fine.
Dialogue: 0,0:19:37.38,0:19:40.17,Default,,0,0,0,,Мен жүкті екенімді білдім.
Dialogue: 0,0:19:40.72,0:19:44.51,Default,,0,0,0,,Еркектерге қарағанда біздің екі жүзіміз бар.
Dialogue: 0,0:19:46.35,0:19:48.06,Default,,0,0,0,,Әйелдің беті мен ананың жүзі
Dialogue: 0,0:19:48.39,0:19:49.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:50.64,0:19:53.52,Default,,0,0,0,,Қараңдаршы, өсімдіктердің де гүлдері мен жапырақтары бар емес пе?
Dialogue: 0,0:19:54.31,0:19:57.57,Default,,0,0,0,,Күн сәулесінің әсеріне ұшырап, қоректік заттарды қатты сіңіретін жапырақтар...
Dialogue: 0,0:19:57.69,0:20:00.99,Default,,0,0,0,,Бұл өзін әдемі етіп көрсеткісі келетін гүл.
Dialogue: 0,0:20:02.24,0:20:05.82,Default,,0,0,0,,Гүл - әйелдің жүзі, жапырақтар - ананың жүзі
Dialogue: 0,0:20:08.74,0:20:09.24,Default,,0,0,0,,Ах
Dialogue: 0,0:20:12.92,0:20:13.79,Default,,0,0,0,,Ақ шаш…
Dialogue: 0,0:20:14.67,0:20:17.00,Default,,0,0,0,,Әй, мама, сәл күте тұрыңыз, сонда қалдырыңыз.
Dialogue: 0,0:20:17.17,0:20:19.17,Default,,0,0,0,,Иә? Itaa
Dialogue: 0,0:20:19.30,0:20:22.97,Default,,0,0,0,,Ах... бірақ кешіріңіз, мен оны алып тастасам көбейе ме? gray hair
Dialogue: 0,0:20:23.09,0:20:24.22,Default,,0,0,0,,Мориёх қандай әдемі қала.
Dialogue: 0,0:20:25.55,0:20:29.72,Default,,0,0,0,,А... жоқ, мен оны жақсы қарауым керек.
Dialogue: 0,0:20:29.85,0:20:31.73,Default,,0,0,0,,Әдемі гүлдер бұзылды.
Dialogue: 0,0:20:34.73,0:20:37.73,Default,,0,0,0,,Сонша барсаң... туасың ба?
Dialogue: 0,0:20:38.94,0:20:39.65,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:20:55.25,0:20:55.92,Default,,0,0,0,,Ах
Dialogue: 0,0:21:00.59,0:21:04.42,Default,,0,0,0,,(Жел қоңырауының дыбысы)
Dialogue: 0,0:21:10.51,0:21:11.35,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:16.35,0:21:17.27,Default,,0,0,0,,Shizue...
Dialogue: 0,0:21:18.77,0:21:22.44,Default,,0,0,0,,Мен ұзақ уақыт бойы депрессияда болдым.
Dialogue: 0,0:21:23.69,0:21:25.82,Default,,0,0,0,,Don't become weak
Dialogue: 0,0:21:27.57,0:21:29.87,Default,,0,0,0,,Сіз әрқашан қыңыр болдыңыз ...
Dialogue: 0,0:21:32.04,0:21:32.87,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:33.37,0:21:35.58,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:21:44.67,0:21:45.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:46.59,0:21:47.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:51.81,0:21:55.48,Default,,0,0,0,,Рахмет сізге Шизу
Dialogue: 0,0:22:07.28,0:22:10.37,Default,,0,0,0,,(Манаканың күлкісі)
Dialogue: 0,0:22:11.78,0:22:16.79,Default,,0,0,0,,♪～
