Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.12,0:00:06.13,Default,,0,0,0,,♪～
Dialogue: 0,0:01:26.00,0:01:31.00,Default,,0,0,0,,～♪
Dialogue: 0,0:01:31.59,0:01:36.59,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:01:49.23,0:01:50.27,Default,,0,0,0,,Иә...
Dialogue: 0,0:01:50.73,0:01:52.57,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:01:53.69,0:01:54.73,Default,,0,0,0,,Иә
Dialogue: 0,0:02:00.91,0:02:01.91,Default,,0,0,0,,Таң
Dialogue: 0,0:02:02.03,0:02:03.28,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:16.80,0:02:19.43,Default,,0,0,0,,Қарашы, Фудика, уақыт келді.
Dialogue: 0,0:02:20.72,0:02:22.22,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:02:22.72,0:02:25.06,Default,,0,0,0,,Ах... қайырлы таң
Dialogue: 0,0:02:26.47,0:02:27.43,Default,,0,0,0,,Жақсы ұйықтадың ба?
Dialogue: 0,0:02:27.77,0:02:29.19,Default,,0,0,0,,Сіз қалай ойлайсыз...
Dialogue: 0,0:02:29.31,0:02:31.48,Default,,0,0,0,,Мен сағат 2-ден кейін ұйықтамадым.
Dialogue: 0,0:02:32.06,0:02:33.40,Default,,0,0,0,,Мен де
Dialogue: 0,0:02:33.69,0:02:36.19,Default,,0,0,0,,Қобалжығаным сонша, сағат 4-ке дейін ұйықтай алмадым.
Dialogue: 0,0:02:36.32,0:02:37.36,Default,,0,0,0,,Уау...
Dialogue: 0,0:02:37.49,0:02:40.45,Default,,0,0,0,,Сонда сіз үш сағаттан сәл астам ғана ұйықтадыңыз.
Dialogue: 0,0:02:40.57,0:02:41.99,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:02:42.12,0:02:43.62,Default,,0,0,0,,Әй, ұялма, келші
Dialogue: 0,0:02:43.74,0:02:46.33,Default,,0,0,0,,Жарайды Каззуко
Dialogue: 0,0:02:46.62,0:02:47.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:48.00,0:02:49.25,Default,,0,0,0,,Бұл маған көбірек!
Dialogue: 0,0:02:49.62,0:02:51.62,Default,,0,0,0,,Өтпеді/өтпейді деп шешті C.
Dialogue: 0,0:02:52.42,0:02:55.38,Default,,0,0,0,,Желтоқсандағы сынақ емтиханы ерекше қиын болды.
Dialogue: 0,0:02:55.50,0:02:58.42,Default,,0,0,0,,Сонымен қатар, Фудика сол уақыттан бері қатты жұмыс істейді.
Dialogue: 0,0:02:58.55,0:02:59.80,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:03:01.26,0:03:02.22,Default,,0,0,0,,Барымызды салайық
Dialogue: 0,0:03:05.18,0:03:08.39,Default,,0,0,0,,(Казуко мен Фуджиканың күлкісі)
Dialogue: 0,0:03:16.73,0:03:20.32,Default,,0,0,0,,Бұрмаланған кемпірқосақ жоғалғанына бір жылдан астам уақыт өтті.
Dialogue: 0,0:03:20.95,0:03:22.95,Default,,0,0,0,,Біз үшінші курста...
Dialogue: 0,0:03:23.07,0:03:27.74,Default,,0,0,0,,Бүгін қабылдау емтихандарына оқуға арналған жыл аяқталды.
Dialogue: 0,0:03:28.87,0:03:30.04,Default,,0,0,0,,Бос
Dialogue: 0,0:03:30.16,0:03:31.46,Default,,0,0,0,,бос
Dialogue: 0,0:03:31.58,0:03:33.04,Default,,0,0,0,,Күмәншіл
Dialogue: 0,0:03:33.17,0:03:34.46,Default,,0,0,0,,скептик
Dialogue: 0,0:03:35.21,0:03:36.75,Default,,0,0,0,,Құлықсыз
Dialogue: 0,0:03:36.88,0:03:38.88,Default,,0,0,0,,Неге ол бізді өзінен алыстатқысы келеді?
Dialogue: 0,0:03:39.01,0:03:40.72,Default,,0,0,0,,Ах, құлықсыз.
Dialogue: 0,0:03:40.84,0:03:41.67,Default,,0,0,0,,Қарқынды
Dialogue: 0,0:03:42.47,0:03:44.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:45.89,0:03:48.43,Default,,0,0,0,,Екеуміз емтихан тапсырып жатырмыз.
Dialogue: 0,0:03:48.56,0:03:52.02,Default,,0,0,0,,Мен соңғы күні Токиодағы іскер қонақүйде болдым.
Dialogue: 0,0:03:52.52,0:03:54.02,Default,,0,0,0,,Спорттық костюмім мен кроссовкаларым мінсіз күйде, бір жыртығы да жоқ.
Dialogue: 0,0:03:54.40,0:03:57.82,Default,,0,0,0,,Шин-Очаномизудан түсіп, Марунучи линиясымен жүріңіз...
Dialogue: 0,0:03:57.94,0:03:59.03,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:03:59.15,0:04:01.90,Default,,0,0,0,,Жаяу жүру керек емес пе? Оханомизу станциясына
Dialogue: 0,0:04:02.03,0:04:04.28,Default,,0,0,0,,Билет қақпасы туралы не істеуім керек?
Dialogue: 0,0:04:04.66,0:04:07.28,Default,,0,0,0,,Мен Токио пойыздарын түсінбеймін.
Dialogue: 0,0:04:07.41,0:04:09.16,Default,,0,0,0,,Корпус дегеніміз не?
Dialogue: 0,0:04:12.87,0:04:15.08,Default,,0,0,0,,Ұят (Казуко) Ұят
Dialogue: 0,0:04:15.21,0:04:16.33,Default,,0,0,0,,Мәңгі
Dialogue: 0,0:04:16.46,0:04:18.46,Default,,0,0,0,,мәңгілік
Dialogue: 0,0:04:19.50,0:04:21.26,Default,,0,0,0,,Онымен бірге екі қыс.
Dialogue: 0,0:04:21.38,0:04:24.63,Default,,0,0,0,,Дайындық мектебінде қысқы сыныпта кездескеннен бері доспыз.
Dialogue: 0,0:04:24.84,0:04:27.89,Default,,0,0,0,,Әртүрлі сыныпта оқысақ та, бір-бірімізді ұнататынбыз...
Dialogue: 0,0:04:28.01,0:04:30.01,Default,,0,0,0,,Біз енді ең жақын дос болдық.
Dialogue: 0,0:04:35.81,0:04:36.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:37.86,0:04:38.86,Default,,0,0,0,,Ах
Dialogue: 0,0:04:44.82,0:04:46.20,Default,,0,0,0,,Эй мынау...
Dialogue: 0,0:04:46.45,0:04:47.49,Default,,0,0,0,,Осы жерде ме?
Dialogue: 0,0:04:47.62,0:04:49.37,Default,,0,0,0,,Дұрысы, Акиба?
Dialogue: 0,0:04:49.49,0:04:51.41,Default,,0,0,0,,Жұқпалы ауру болса қорқынышты болар еді.
Dialogue: 0,0:04:53.41,0:04:54.54,Default,,0,0,0,,Мына жерде!
Dialogue: 0,0:04:54.66,0:04:56.37,Default,,0,0,0,,Уау, айналма жол
Dialogue: 0,0:04:56.50,0:04:58.42,Default,,0,0,0,,Не!
Dialogue: 0,0:04:58.79,0:04:59.21,Default,,0,0,0,,4-платформа Пойыз кетеді.
Dialogue: 0,0:04:59.21,0:05:00.92,Default,,0,0,0,,4-платформа Пойыз кетеді.
Dialogue: 0,0:04:59.21,0:05:00.92,Default,,0,0,0,,Фуджика асығыңыз!
Dialogue: 0,0:05:00.92,0:05:01.30,Default,,0,0,0,,4-платформа Пойыз кетеді.
Dialogue: 0,0:05:01.42,0:05:02.01,Default,,0,0,0,,Уау
Dialogue: 0,0:05:02.01,0:05:02.96,Default,,0,0,0,,Уау
Dialogue: 0,0:05:02.01,0:05:02.96,Default,,0,0,0,,Есік жабылған кезде абай болыңыз
Dialogue: 0,0:05:02.96,0:05:04.09,Default,,0,0,0,,Есік жабылған кезде абай болыңыз
Dialogue: 0,0:05:04.09,0:05:05.55,Default,,0,0,0,,Есік жабылған кезде абай болыңыз
Dialogue: 0,0:05:04.09,0:05:05.55,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:05:12.68,0:05:13.89,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:14.14,0:05:17.35,Default,,0,0,0,,Әй, неге сонша әкелдің?
Dialogue: 0,0:05:17.56,0:05:20.73,Default,,0,0,0,,Әртүрлі заттар... киім ауыстыру, анықтамалық т.б.
Dialogue: 0,0:05:21.32,0:05:23.11,Default,,0,0,0,,Иә? (Фудзихана) Иә?
Dialogue: 0,0:05:35.29,0:05:36.79,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:05:36.91,0:05:39.63,Default,,0,0,0,,Мен... сонда.
Dialogue: 0,0:05:40.67,0:05:42.17,Default,,0,0,0,,Барымызды салайық!
Dialogue: 0,0:05:42.67,0:05:44.42,Default,,0,0,0,,Олай болса (Фудзихана) Иә.
Dialogue: 0,0:06:10.95,0:06:14.20,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:06:18.75,0:06:20.25,Default,,0,0,0,,(Екінші қолдың дыбысы)
Dialogue: 0,0:06:20.25,0:06:21.42,Default,,0,0,0,,(Екінші қолдың дыбысы)
Dialogue: 0,0:06:20.25,0:06:21.42,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:06:21.42,0:06:24.84,Default,,0,0,0,,(Екінші қолдың дыбысы)
Dialogue: 0,0:06:51.99,0:06:52.87,Default,,0,0,0,,Оған дейін
Dialogue: 0,0:06:52.99,0:06:55.08,Default,,0,0,0,,(Емтихан тапсырушылардың күрсінісі)
Dialogue: 0,0:06:55.87,0:06:58.87,Default,,0,0,0,,(Тест тапсырушылардың сөйлеген дыбыстары)
Dialogue: 0,0:06:59.00,0:07:00.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:02.00,0:07:03.25,Default,,0,0,0,,Я...
Dialogue: 0,0:07:15.56,0:07:16.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:27.86,0:07:29.11,Default,,0,0,0,,Фуджик?
Dialogue: 0,0:07:36.70,0:07:40.08,Default,,0,0,0,,(Редакция бөлімінің шуы)
Dialogue: 0,0:07:40.83,0:07:43.25,Default,,0,0,0,,Токиоға оралғаныма бір жылдан асты.
Dialogue: 0,0:07:43.79,0:07:46.09,Default,,0,0,0,,Мен сол қалада кездестірген оқиға...
Dialogue: 0,0:07:46.21,0:07:49.51,Default,,0,0,0,,Біз жұмбақ ұйымның қатысы бар екенін анықтадық.
Dialogue: 0,0:07:50.17,0:07:54.05,Default,,0,0,0,,Ол адам адам қоғамына білмей араласып кеткен.
Dialogue: 0,0:07:54.47,0:07:55.85,Default,,0,0,0,,Есепті жариялағанда да...
Dialogue: 0,0:07:55.97,0:07:58.85,Default,,0,0,0,,Сіз қарсыласыңызды мұқият бағалауыңыз керек.
Dialogue: 0,0:07:59.18,0:08:01.31,Default,,0,0,0,,Жаңа емессің, кеше бастағансың!
Dialogue: 0,0:08:01.31,0:08:02.10,Default,,0,0,0,,Жаңа емессің, кеше бастағансың!
Dialogue: 0,0:08:01.31,0:08:02.10,Default,,0,0,0,,Сондықтан мен күнде бір баспадан екіншісіне барамын.
Dialogue: 0,0:08:02.10,0:08:02.23,Default,,0,0,0,,Сондықтан мен күнде бір баспадан екіншісіне барамын.
Dialogue: 0,0:08:02.23,0:08:04.15,Default,,0,0,0,,Сондықтан мен күнде бір баспадан екіншісіне барамын.
Dialogue: 0,0:08:02.23,0:08:04.15,Default,,0,0,0,,Еліңе қайт! Елге!
Dialogue: 0,0:08:04.27,0:08:07.94,Default,,0,0,0,,Бұл есеп Кирима Нагиге біраз көмек болады деп үміттенемін...
Dialogue: 0,0:08:08.07,0:08:10.15,Default,,0,0,0,,Иә? Сіз Токиодасыз ба?
Dialogue: 0,0:08:10.28,0:08:11.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:12.65,0:08:14.61,Default,,0,0,0,,Жарайсың ба? Мен білген бойда жауап беремін!
Dialogue: 0,0:08:15.57,0:08:19.04,Default,,0,0,0,,Енді маған тиіспеген құдайдың қарғысы жоқ.
Dialogue: 0,0:08:24.25,0:08:27.04,Default,,0,0,0,,Тоқтау керек деп ойлаймын...
Dialogue: 0,0:08:27.50,0:08:28.34,Default,,0,0,0,,Ах
Dialogue: 0,0:08:30.21,0:08:32.09,Default,,0,0,0,,Менің кеңсеме келгіңіз келе ме?
Dialogue: 0,0:08:32.92,0:08:34.34,Default,,0,0,0,,Мен сіздермен ақылдасамын.
Dialogue: 0,0:08:34.88,0:08:35.97,Default,,0,0,0,,А...
Dialogue: 0,0:08:57.11,0:08:58.32,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:09:05.50,0:09:09.34,Default,,0,0,0,,Мен мұнда не үшін келдім?
Dialogue: 0,0:09:15.88,0:09:16.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:17.30,0:09:21.39,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:09:31.94,0:09:36.95,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:09:39.28,0:09:40.91,Default,,0,0,0,,О...
Dialogue: 0,0:09:41.03,0:09:46.08,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:09:55.42,0:09:56.67,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:56.80,0:10:00.01,Default,,0,0,0,,Өзін басқаларға сеніп тапсыруға ұмтылу
Dialogue: 0,0:10:00.18,0:10:04.39,Default,,0,0,0,,Олар оны энергияға айналдырып, оны жеу арқылы аман қалды.
Dialogue: 0,0:10:05.31,0:10:06.89,Default,,0,0,0,,Не айтып тұрсың өзі?
Dialogue: 0,0:10:07.64,0:10:11.02,Default,,0,0,0,,Сені табу үшін маған бір жылдан астам уақыт кетті.
Dialogue: 0,0:10:11.36,0:10:12.40,Default,,0,0,0,,Мантикора
Dialogue: 0,0:10:13.02,0:10:14.19,Default,,0,0,0,,Мантикора?
Dialogue: 0,0:10:14.86,0:10:18.53,Default,,0,0,0,,Дәлірек айтсақ, бұл сіздің ішіңіздегі мантикораның қалдықтары.\NМенің ойымша, сіз
Dialogue: 0,0:10:18.65,0:10:20.53,Default,,0,0,0,,айта аласыз
Dialogue: 0,0:10:20.74,0:10:23.95,Default,,0,0,0,,Бастапқыда сол қаланың электромагниттік өрісі жоғалып кетті
Dialogue: 0,0:10:24.08,0:10:26.54,Default,,0,0,0,,Жоғалып кетуі керек еді
Dialogue: 0,0:10:26.66,0:10:29.50,Default,,0,0,0,,Өткенді арқалаған қыз жаратқан саған
Dialogue: 0,0:10:29.62,0:10:32.88,Default,,0,0,0,,Ол жақсы араласып, осы жолмен қашып кетті.
Dialogue: 0,0:10:33.79,0:10:35.63,Default,,0,0,0,,Өткенді алып жүру…
Dialogue: 0,0:10:35.88,0:10:36.76,Default,,0,0,0,,Өндірілген...
Dialogue: 0,0:10:38.42,0:10:41.64,Default,,0,0,0,,Мен сені бір рет кездестірдім.
Dialogue: 0,0:10:42.26,0:10:43.30,Default,,0,0,0,,Детектив
Dialogue: 0,0:11:01.95,0:11:04.62,Default,,0,0,0,,Мен сол кезде дүниеге келген сияқтымын.
Dialogue: 0,0:11:05.41,0:11:06.83,Default,,0,0,0,,Егер сіз психолог болсаңыз...
Dialogue: 0,0:11:06.95,0:11:10.50,Default,,0,0,0,,Менің ойымша, сіз мұны өлім куәгерінің жарақаты деп атауға болады.
Dialogue: 0,0:11:10.62,0:11:14.17,Default,,0,0,0,,Бірақ менің атым кім, Кишида?
Dialogue: 0,0:11:14.67,0:11:15.92,Default,,0,0,0,,Егер сіз детектив болсаңыз...
Dialogue: 0,0:11:16.05,0:11:20.55,Default,,0,0,0,,Оның бірнеше бүркеншік аттарды қолдануы қызық емес пе?
Dialogue: 0,0:11:20.97,0:11:22.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:22.89,0:11:26.31,Default,,0,0,0,,Нагидің әкесі туралы білу үшін қолданылған есім...
Dialogue: 0,0:11:26.43,0:11:28.10,Default,,0,0,0,,Қыздың қабілеті –
Dialogue: 0,0:11:28.22,0:11:32.27,Default,,0,0,0,,Бұл сол сәтте тек сен ғана өмірге оралдың деген сөз.
Dialogue: 0,0:11:32.44,0:11:33.77,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:11:33.90,0:11:37.02,Default,,0,0,0,,Мен осы уақытқа дейін зерттеген ұйымның құпиялары...
Dialogue: 0,0:11:37.19,0:11:39.44,Default,,0,0,0,,Шын мәнінде Куроданың естелігі
Dialogue: 0,0:11:39.94,0:11:42.61,Default,,0,0,0,,Ойланып қарасаң...
Dialogue: 0,0:11:43.07,0:11:47.28,Default,,0,0,0,,Жалаң репортаж жазушының оларға соншалықты жақын болуы мүмкін емес пе?
Dialogue: 0,0:11:48.20,0:11:49.87,Default,,0,0,0,,Хэхехехе...
Dialogue: 0,0:11:50.12,0:11:51.21,Default,,0,0,0,,Осы уақытқа дейін-
Dialogue: 0,0:11:51.33,0:11:55.29,Default,,0,0,0,,Мен Кишида болдым деген сенім бұғатталған естеліктер...
Dialogue: 0,0:11:55.42,0:11:57.17,Default,,0,0,0,,Сіз өмірге қайта оралған сияқтысыз.
Dialogue: 0,0:11:58.42,0:12:02.30,Default,,0,0,0,,Оның эволюциясын тоқтату үшін мен оған вакцина бердім...
Dialogue: 0,0:12:06.35,0:12:08.18,Default,,0,0,0,,Қарғыс атсын... (жүгірген дыбыс)
Dialogue: 0,0:12:08.60,0:12:10.72,Default,,0,0,0,,(ампуланың домалату дыбысы)
Dialogue: 0,0:12:12.35,0:12:13.44,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:12:13.56,0:12:18.57,Default,,0,0,0,,(Куроданың ауыр тыныс алуы)
Dialogue: 0,0:12:18.90,0:12:19.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:25.57,0:12:26.99,Default,,0,0,0,,(Қанның шашырауы)
Dialogue: 0,0:12:28.28,0:12:33.21,Default,,0,0,0,,Ал, ұйымға опасыздық жасаған менмен жұмыс жасалды.
Dialogue: 0,0:12:37.71,0:12:39.25,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:46.14,0:12:47.76,Default,,0,0,0,,Ол дәрі кейінірек келеді.
Dialogue: 0,0:12:47.89,0:12:51.14,Default,,0,0,0,,Бұл тағы бір құбыжықты дүниеге әкелді...
Dialogue: 0,0:12:51.27,0:12:53.73,Default,,0,0,0,,Мен одан да құтылдым.
Dialogue: 0,0:12:55.23,0:12:56.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:56.60,0:12:59.57,Default,,0,0,0,,Ой... а!
Dialogue: 0,0:13:01.11,0:13:03.99,Default,,0,0,0,,Мантикора пайда болды.
Dialogue: 0,0:13:04.40,0:13:07.70,Default,,0,0,0,,Сіз мені бұрышта қалдым деп ойлайтын шығарсыз, бірақ олай емес.
Dialogue: 0,0:13:07.99,0:13:10.53,Default,,0,0,0,,There are many places to escape here.
Dialogue: 0,0:13:14.62,0:13:15.75,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:16.71,0:13:17.54,Default,,0,0,0,,Гуха!
Dialogue: 0,0:13:17.71,0:13:19.29,Default,,0,0,0,,Ugh, this guy...
Dialogue: 0,0:13:19.42,0:13:20.84,Default,,0,0,0,,Kill me! (Manticore Fantom) Chikusho!
Dialogue: 0,0:13:20.96,0:13:23.09,Default,,0,0,0,,Мен бұл затты жауып жатқанда, (Мантикор фантомы) Оны босат! Босатыңыз!
Dialogue: 0,0:13:23.42,0:13:24.84,Default,,0,0,0,,Өлтір!
Dialogue: 0,0:13:25.22,0:13:26.09,Default,,0,0,0,,Жібер!
Dialogue: 0,0:13:26.22,0:13:27.64,Default,,0,0,0,,Мен мұны істеуге ниеттімін.
Dialogue: 0,0:13:28.14,0:13:30.14,Default,,0,0,0,,(Manticore Phantom's distressed voice)
Dialogue: 0,0:13:31.76,0:13:32.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:33.27,0:13:35.89,Default,,0,0,0,,Бұл мен жерасты туннельінен тапқан нәрсем.
Dialogue: 0,0:13:36.02,0:13:39.19,Default,,0,0,0,,Менде олар көп болды, сондықтан мен оларды төменгі қабаттағы қоқыс дүкеніне қалдырдым.
Dialogue: 0,0:13:39.48,0:13:42.15,Default,,0,0,0,,А, а... а...
Dialogue: 0,0:13:48.61,0:13:52.24,Default,,0,0,0,,Наги... Қызық, Наги білді ме?
Dialogue: 0,0:13:52.58,0:13:54.54,Default,,0,0,0,,Егер мен Курода болсам
Dialogue: 0,0:13:55.58,0:13:57.41,Default,,0,0,0,,You'll be sad.
Dialogue: 0,0:13:57.54,0:14:00.75,Default,,0,0,0,,Мен осындай болып кеткенімді білгенде...
Dialogue: 0,0:14:00.88,0:14:03.34,Default,,0,0,0,,It's not your fault either.
Dialogue: 0,0:14:03.50,0:14:04.76,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:14:04.88,0:14:10.30,Default,,0,0,0,,(Manticore Phantom's scream)
Dialogue: 0,0:14:11.55,0:14:14.10,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:14:14.22,0:14:16.60,Default,,0,0,0,,Life is a strange thing.
Dialogue: 0,0:14:16.81,0:14:20.65,Default,,0,0,0,,Мен де солай өмір сүруге тырысамын.
Dialogue: 0,0:14:21.48,0:14:24.28,Default,,0,0,0,,He said the same thing.
Dialogue: 0,0:14:24.69,0:14:27.07,Default,,0,0,0,,They're asleep
Dialogue: 0,0:14:27.19,0:14:28.74,Default,,0,0,0,,Even if the body perishes
Dialogue: 0,0:14:28.86,0:14:33.24,Default,,0,0,0,,Осылайша нейрондар бүкіл қалаға таралады.
Dialogue: 0,0:14:33.37,0:14:35.08,Default,,0,0,0,,Keep dreaming
Dialogue: 0,0:14:35.20,0:14:39.92,Default,,0,0,0,,Ерте эволюция нормаға айналатын күн келгенше...
Dialogue: 0,0:14:44.46,0:14:47.30,Default,,0,0,0,,But it's vain.
Dialogue: 0,0:14:47.42,0:14:50.43,Default,,0,0,0,,Өз бар екендігіңді көрсетуге мүмкіндік жоқ деген нені білдіреді?
Dialogue: 0,0:14:51.47,0:14:55.01,Default,,0,0,0,,Менің ойымша, бұл жігіттің адамдарды жейтіні сондықтан.
Dialogue: 0,0:15:01.73,0:15:03.15,Default,,0,0,0,,Әдеттегідей, түссізді тек менде ғана. Уф.
Dialogue: 0,0:15:03.27,0:15:08.07,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:15:09.78,0:15:10.86,Default,,0,0,0,,(қосылған қосқыштың дыбысы)
Dialogue: 0,0:15:12.70,0:15:14.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:25.25,0:15:26.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:26.96,0:15:28.38,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:30.76,0:15:31.68,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:15:32.89,0:15:36.39,Default,,0,0,0,,I did something bad to Fujika Miyashita.
Dialogue: 0,0:15:41.06,0:15:43.35,Default,,0,0,0,,Thank you for waiting! (Kazuko) How was it?
Dialogue: 0,0:15:43.48,0:15:46.48,Default,,0,0,0,,Мен өзімді мүлдем ештеңе істей алмайтындай сезінемін.
Dialogue: 0,0:15:46.61,0:15:47.94,Default,,0,0,0,,Мен де
Dialogue: 0,0:15:50.40,0:15:53.03,Default,,0,0,0,,That's right. Where did you go during your mid-term break?
Dialogue: 0,0:15:53.16,0:15:55.99,Default,,0,0,0,,Не? I was looking for it too!
Dialogue: 0,0:15:56.12,0:15:57.37,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,0:15:57.49,0:15:59.37,Default,,0,0,0,,Хехе…
Dialogue: 0,0:15:59.79,0:16:03.00,Default,,0,0,0,,Ah, there's a place I'd like to stop by. Бұл жақсы ма?
Dialogue: 0,0:16:09.25,0:16:10.63,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:16:10.76,0:16:11.76,Default,,0,0,0,,Енді ешкімді жаралағым келмейді.
Dialogue: 0,0:16:12.38,0:16:13.59,Default,,0,0,0,,Ондамин
Dialogue: 0,0:16:13.72,0:16:15.05,Default,,0,0,0,,Theremin?
Dialogue: 0,0:16:15.18,0:16:17.72,Default,,0,0,0,,(Шығу қоңырауының дыбысы)
Dialogue: 0,0:16:18.43,0:16:20.68,Default,,0,0,0,,Yes (Fujihana) Thank you
Dialogue: 0,0:16:24.52,0:16:25.98,Default,,0,0,0,,That's scary...
Dialogue: 0,0:16:26.23,0:16:27.36,Default,,0,0,0,,Не?
Dialogue: 0,0:16:27.48,0:16:30.44,Default,,0,0,0,,I feel like I'm going to be swallowed up.
Dialogue: 0,0:16:37.74,0:16:41.54,Default,,0,0,0,,Токиоға келсек те өзгермейміз, солай ма?
Dialogue: 0,0:16:42.45,0:16:44.71,Default,,0,0,0,,We've been friends forever, right?
Dialogue: 0,0:16:45.71,0:16:46.75,Default,,0,0,0,,Иә
Dialogue: 0,0:16:48.29,0:16:50.34,Default,,0,0,0,,I'm sure you'll be fine
Dialogue: 0,0:16:50.46,0:16:53.17,Default,,0,0,0,,I'm not confident...
Dialogue: 0,0:16:54.59,0:16:59.05,Default,,0,0,0,,Айта алмай жұтқан сөздерім кеудемді ауыртты.
Dialogue: 0,0:17:01.14,0:17:03.68,Default,,0,0,0,,Содан бері уақыт аяусыз өте берді.
Dialogue: 0,0:17:03.93,0:17:09.02,Default,,0,0,0,,Мектептің қалған санаулы күндері көзді ашып-жұмғанша өтіп жатыр.
Dialogue: 0,0:17:18.24,0:17:19.66,Default,,0,0,0,,(Казуконың терең тыныс алуы)
Dialogue: 0,0:17:20.45,0:17:21.29,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:21.41,0:17:23.25,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:17:25.04,0:17:26.71,Default,,0,0,0,,Иә, бұл Суэма.
Dialogue: 0,0:17:27.33,0:17:29.92,Default,,0,0,0,,Аа, Фудика, қалай болды?
Dialogue: 0,0:17:32.63,0:17:33.71,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:34.59,0:17:35.80,Default,,0,0,0,,Мен?
Dialogue: 0,0:17:36.59,0:17:37.63,Default,,0,0,0,,Иә
Dialogue: 0,0:17:38.59,0:17:39.89,Default,,0,0,0,,Бұл субтитрлер JOJO's Bizarre Adventure форумы, Yuhari Subtitles және Gods Subtitles Group бірлесіп дайындады
Dialogue: 0,0:17:40.80,0:17:41.85,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:42.56,0:17:45.48,Default,,0,0,0,,Құрметті мектеп бітірушілер
Dialogue: 0,0:17:45.60,0:17:47.35,Default,,0,0,0,,Бұл анық...
Dialogue: 0,0:17:47.48,0:17:51.48,Default,,0,0,0,,Бұл оқу және Шинё Гакуэн біз...
Dialogue: 0,0:17:51.61,0:17:56.65,Default,,0,0,0,,Сіз мектепке жаңа бірінші курс студенті ретінде кіргенде, сіздің жоғары сыныптарыңыздың барлығы екінші курс студенттері...
Dialogue: 0,0:17:56.78,0:17:58.82,Default,,0,0,0,,Уау, мен бітіремін.
Dialogue: 0,0:17:58.95,0:18:00.03,Default,,0,0,0,,Бірақ ертең...
Dialogue: 0,0:18:03.08,0:18:04.58,Default,,0,0,0,,Дұрыс суретке түсіріңіз!
Dialogue: 0,0:18:04.70,0:18:06.66,Default,,0,0,0,,Әй, Суэма!
Dialogue: 0,0:18:07.37,0:18:09.08,Default,,0,0,0,,Сондай-ақ Суэманы қосыңыз
Dialogue: 0,0:18:09.21,0:18:10.88,Default,,0,0,0,,О... күте тұрыңыз.
Dialogue: 0,0:18:11.54,0:18:13.46,Default,,0,0,0,,Кирима-сан, менімен бірге кір.
Dialogue: 0,0:18:13.59,0:18:14.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:14.92,0:18:15.88,Default,,0,0,0,,Ии!
Dialogue: 0,0:18:16.22,0:18:17.93,Default,,0,0,0,,О, эй... ей!
Dialogue: 0,0:18:18.05,0:18:20.14,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:24.77,0:18:26.77,Default,,0,0,0,,Бұл аймақ та өзгерді.
Dialogue: 0,0:18:27.14,0:18:30.52,Default,,0,0,0,,А, менің ойымша, ол толып қалды.
Dialogue: 0,0:18:30.65,0:18:31.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:31.61,0:18:36.61,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:53.88,0:18:57.30,Default,,0,0,0,,Жақсы болды ма? Мен олармен кешке баруым керек.
Dialogue: 0,0:18:57.42,0:18:59.34,Default,,0,0,0,,Мен олай сезінбеймін.
Dialogue: 0,0:18:59.47,0:19:01.18,Default,,0,0,0,,Соңғы күн болса да?
Dialogue: 0,0:19:02.01,0:19:05.72,Default,,0,0,0,,Мен сенімен бірге болғым келмейді, себебі бұл соңғы рет.
Dialogue: 0,0:19:08.89,0:19:10.06,Default,,0,0,0,,Кадзуко!
Dialogue: 0,0:19:10.19,0:19:11.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:11.44,0:19:12.31,Default,,0,0,0,,Фудзи гүлі
Dialogue: 0,0:19:12.44,0:19:13.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:16.65,0:19:17.78,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:19:18.82,0:19:22.07,Default,,0,0,0,,Соңғы үш жылда көп нәрсе болды.
Dialogue: 0,0:19:22.24,0:19:25.45,Default,,0,0,0,,Үш жылға бірдей уақытты жұмсау
Dialogue: 0,0:19:26.24,0:19:31.79,Default,,0,0,0,,Бірақ әр адамда мүлде әртүрлі тәжірибе болады...
Dialogue: 0,0:19:38.59,0:19:40.63,Default,,0,0,0,,Не? (Фудика) Не болды?
Dialogue: 0,0:19:41.18,0:19:45.43,Default,,0,0,0,,Жоқ, мен музыка естідім деп ойладым.
Dialogue: 0,0:19:55.90,0:19:57.11,Default,,0,0,0,,(Термин музыкасы)
Dialogue: 0,0:19:57.11,0:19:59.94,Default,,0,0,0,,(Термин музыкасы)
Dialogue: 0,0:19:57.11,0:19:59.94,Default,,0,0,0,,А, бұл ән ше?
Dialogue: 0,0:19:59.94,0:20:00.40,Default,,0,0,0,,(Термин музыкасы)
Dialogue: 0,0:20:00.53,0:20:05.53,Default,,0,0,0,,(Термин музыкасы)
Dialogue: 0,0:20:18.88,0:20:22.76,Default,,0,0,0,,Қаланың естеліктері әуен ойнап тұрғанына сенімдімін.
Dialogue: 0,0:20:22.88,0:20:23.38,Default,,0,0,0,,(Термин музыкасы)
Dialogue: 0,0:20:23.38,0:20:25.14,Default,,0,0,0,,(Термин музыкасы)
Dialogue: 0,0:20:23.38,0:20:25.14,Default,,0,0,0,,Қала туралы естеліктер?
Dialogue: 0,0:20:25.14,0:20:25.30,Default,,0,0,0,,(Термин музыкасы)
Dialogue: 0,0:20:25.30,0:20:28.85,Default,,0,0,0,,(Термин музыкасы)
Dialogue: 0,0:20:25.30,0:20:28.85,Default,,0,0,0,,Біз өткізген осы қала туралы естеліктер
Dialogue: 0,0:20:28.97,0:20:32.06,Default,,0,0,0,,Көркем сөздің болмауы қиын...
Dialogue: 0,0:20:32.18,0:20:35.65,Default,,0,0,0,,Сізді ешкім тыңдамайтыны өкінішті емес пе?
Dialogue: 0,0:20:37.44,0:20:38.48,Default,,0,0,0,,Мүмкін осындай нәрсе бар шығар.
Dialogue: 0,0:20:38.48,0:20:40.40,Default,,0,0,0,,Мүмкін осындай нәрсе бар шығар.
Dialogue: 0,0:20:38.48,0:20:40.40,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:40.40,0:20:41.44,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:41.74,0:20:43.65,Default,,0,0,0,,Міне болды! Фудика!
Dialogue: 0,0:20:43.78,0:20:44.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:45.20,0:20:48.28,Default,,0,0,0,,Сіз қайда болдыңыз? Барлығы жиналып үлгерді
Dialogue: 0,0:20:48.83,0:20:50.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:51.41,0:20:53.25,Default,,0,0,0,,Жарайды, мен кетейін.
Dialogue: 0,0:20:53.37,0:20:54.75,Default,,0,0,0,,Аа, Мияшита мырза
Dialogue: 0,0:20:55.25,0:20:56.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:56.67,0:20:57.13,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:20:57.13,0:20:59.17,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:20:57.13,0:20:59.17,Default,,0,0,0,,Онымен жақсы қарым-қатынаста болыңыз
Dialogue: 0,0:20:59.17,0:21:01.88,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:21:02.05,0:21:04.01,Default,,0,0,0,,Иә! Хахаха... (Әйел) Дұрыс па? Хахаха...
Dialogue: 0,0:21:10.35,0:21:12.89,Default,,0,0,0,,Онда мен де барамын.
Dialogue: 0,0:21:18.15,0:21:21.57,Default,,0,0,0,,Мен бұл сезімді бір күні есіме аламын ба?
Dialogue: 0,0:21:22.53,0:21:26.03,Default,,0,0,0,,Біздің мектептегі өміріміз біткен осы сәтте...
Dialogue: 0,0:21:27.91,0:21:30.66,Default,,0,0,0,,Мен бірдеңені жоғалтып алғандықтан ауырып тұрғандай.
Dialogue: 0,0:21:30.83,0:21:32.70,Default,,0,0,0,,Менің кеудемдегі бұл ауырсыну...
Dialogue: 0,0:21:32.83,0:21:37.83,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:21:52.51,0:21:59.27,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:22:05.36,0:22:10.37,Default,,0,0,0,,♪～
Dialogue: 0,0:23:00.17,0:23:05.17,Default,,0,0,0,,～♪
