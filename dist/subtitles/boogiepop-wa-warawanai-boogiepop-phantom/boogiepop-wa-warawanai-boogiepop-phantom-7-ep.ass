Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.25,0:00:06.25,Default,,0,0,0,,♪～
Dialogue: 0,0:01:25.96,0:01:30.96,Default,,0,0,0,,～♪
Dialogue: 0,0:01:31.96,0:01:36.97,Default,,0,0,0,,(Саёконың ауыр тыныс алуы)
Dialogue: 0,0:01:45.31,0:01:48.56,Default,,0,0,0,,Суық Суық...
Dialogue: 0,0:01:48.69,0:01:49.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:51.44,0:01:55.07,Default,,0,0,0,,Кешіріңіз, бірақ сіз маған қарызға ақша бере аласыз ба?
Dialogue: 0,0:01:56.49,0:01:59.32,Default,,0,0,0,,Оның болуы жақсы.
Dialogue: 0,0:02:00.57,0:02:02.24,Default,,0,0,0,,Осы жерде күтіңіз!
Dialogue: 0,0:02:02.74,0:02:04.24,Default,,0,0,0,,Бұл жақсы емес, солай ма?
Dialogue: 0,0:02:04.37,0:02:07.91,Default,,0,0,0,,Төлеу керек болғандықтан, төлеу қалыпты жағдай.
Dialogue: 0,0:02:08.25,0:02:10.63,Default,,0,0,0,,Уф... таптым.
Dialogue: 0,0:02:11.17,0:02:12.88,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:02:14.71,0:02:15.84,Default,,0,0,0,,Сізге қажет емес заттар
Dialogue: 0,0:02:15.96,0:02:18.68,Default,,0,0,0,,О? Уау... аа...
Dialogue: 0,0:02:19.47,0:02:22.39,Default,,0,0,0,,(Деликвент 3-тің ыңырануы)
Dialogue: 0,0:02:23.35,0:02:25.01,Default,,0,0,0,,Не... не!?
Dialogue: 0,0:02:26.93,0:02:28.69,Default,,0,0,0,,Не...
Dialogue: 0,0:02:29.81,0:02:34.23,Default,,0,0,0,,Қажет емес нәрселердің барлығын бөлшектеңіз
Dialogue: 0,0:02:35.61,0:02:40.45,Default,,0,0,0,,Әрі қарай, мен сені бөліп аламын.
Dialogue: 0,0:02:40.82,0:02:42.41,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:02:42.70,0:02:44.58,Default,,0,0,0,,Уау! Гррр...
Dialogue: 0,0:02:44.70,0:02:46.87,Default,,0,0,0,,Ах... Қол қол!
Dialogue: 0,0:02:47.00,0:02:49.41,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:02:49.54,0:02:51.21,Default,,0,0,0,,Ба... құбыжық!
Dialogue: 0,0:02:51.46,0:02:53.54,Default,,0,0,0,,Оның қалай бөлінуін қалайсыз?
Dialogue: 0,0:02:54.04,0:02:58.63,Default,,0,0,0,,Бөлшектенгіңіз келе ме, әлде...
Dialogue: 0,0:03:00.93,0:03:05.14,Default,,0,0,0,,Қалай болғанда да, мен сені ақырында ізін қалдырмай өшіремін.
Dialogue: 0,0:03:05.64,0:03:07.52,Default,,0,0,0,,Келме, Келме!
Dialogue: 0,0:03:07.64,0:03:08.98,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:03:10.64,0:03:11.64,Default,,0,0,0,,Дайкоку-сан
Dialogue: 0,0:03:14.73,0:03:16.82,Default,,0,0,0,,(Құқық бұзушылардың айқайы)
Dialogue: 0,0:03:18.36,0:03:23.36,Default,,0,0,0,,(Шиннің күш айқайы)
Dialogue: 0,0:03:24.74,0:03:27.04,Default,,0,0,0,,Маған кедергі жасама дедім.
Dialogue: 0,0:03:27.41,0:03:30.54,Default,,0,0,0,,Бұл жігіттер қажет емес еді.
Dialogue: 0,0:03:30.66,0:03:31.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:32.42,0:03:37.42,Default,,0,0,0,,Сен кімсің өзі…
Dialogue: 0,0:03:37.80,0:03:41.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:44.55,0:03:45.64,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,0:03:46.68,0:03:48.81,Default,,0,0,0,,Күн суық, ағайын.
Dialogue: 0,0:04:09.91,0:04:12.79,Default,,0,0,0,,Сіздің кететін уақытыңыз болды.
Dialogue: 0,0:04:15.54,0:04:17.50,Default,,0,0,0,,Әке мен шеше...
Dialogue: 0,0:04:17.79,0:04:20.17,Default,,0,0,0,,Мен ағамның «қуатын» білмеймін
Dialogue: 0,0:04:21.76,0:04:26.55,Default,,0,0,0,,1 month ago «Нұр» ағама берген құдірет туралы.
Dialogue: 0,0:04:33.02,0:04:34.77,Default,,0,0,0,,Біраз өсіп алғанша күтсеңші.
Dialogue: 0,0:04:38.61,0:04:40.02,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:04:40.44,0:04:42.90,Default,,0,0,0,,Қайсысы? (Сайоко) Иә?
Dialogue: 0,0:04:43.19,0:04:44.57,Default,,0,0,0,,Қажет емес бөліктер
Dialogue: 0,0:04:46.57,0:04:49.99,Default,,0,0,0,,Бүлінудің қажеті жоқ.
Dialogue: 0,0:04:50.49,0:04:53.00,Default,,0,0,0,,Сізге қажет емес нәрселер міндетті түрде болады.
Dialogue: 0,0:04:54.04,0:04:55.75,Default,,0,0,0,,Мынаны табыңыз...
Dialogue: 0,0:04:57.33,0:04:59.00,Default,,0,0,0,,Біліңіз...
Dialogue: 0,0:04:59.13,0:05:00.42,Default,,0,0,0,,Бауырым, доғар.
Dialogue: 0,0:05:00.55,0:05:02.01,Default,,0,0,0,,Өтінемін, өтінемін...
Dialogue: 0,0:05:04.22,0:05:04.92,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:29.53,0:05:30.37,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:41.50,0:05:43.96,Default,,0,0,0,,Мен саған бір қызық көрсетемін
Dialogue: 0,0:05:46.72,0:05:47.93,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:05:51.14,0:05:51.97,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:05:52.10,0:05:53.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:54.93,0:05:57.31,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:57.44,0:06:00.06,Default,,0,0,0,,Хе хехе...
Dialogue: 0,0:06:00.23,0:06:02.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:04.36,0:06:06.11,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,0:06:08.95,0:06:10.41,Default,,0,0,0,,Сайоко
Dialogue: 0,0:06:10.66,0:06:14.79,Default,,0,0,0,,Бұл дүниеде бізге қажет емес нәрселер өте көп деп ойламайсыз ба?
Dialogue: 0,0:06:16.41,0:06:19.58,Default,,0,0,0,,Бөлшектеліп, қайта салынуы керек
Dialogue: 0,0:06:20.54,0:06:23.92,Default,,0,0,0,,Бұл мағынаны білдіреді деп ойламайсыз ба?
Dialogue: 0,0:06:24.13,0:06:26.88,Default,,0,0,0,,Сайоко Сайоко
Dialogue: 0,0:06:27.13,0:06:27.97,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:31.72,0:06:33.55,Default,,0,0,0,,Бүгінгі үлкен аға үшін-
Dialogue: 0,0:06:33.68,0:06:36.60,Default,,0,0,0,,Бұл дүние – шатастырылған бөліктерден тұрады.
Dialogue: 0,0:06:38.27,0:06:40.31,Default,,0,0,0,,Солардың ішінде менің ағам...
Dialogue: 0,0:06:40.40,0:06:43.15,Default,,0,0,0,,Мен қажет емес нәрсені өшіруге тырысамын
Dialogue: 0,0:06:43.61,0:06:44.19,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:46.36,0:06:49.70,Default,,0,0,0,,Сол жарық ағамның тілегін енді ғана орындады.
Dialogue: 0,0:06:51.36,0:06:52.91,Default,,0,0,0,,Қашан басталғанын білгім келеді
Dialogue: 0,0:06:54.24,0:06:56.58,Default,,0,0,0,,Сенің ағаң қашаннан бері...
Dialogue: 0,0:07:04.67,0:07:07.96,Default,,0,0,0,,Бауырым, не істеп жатырсың?
Dialogue: 0,0:07:08.09,0:07:10.30,Default,,0,0,0,,Бұл сыбызғы киімі.
Dialogue: 0,0:07:11.13,0:07:13.72,Default,,0,0,0,,Мен келесі пьесамда «Гамелиннің қаракөзін» ойнайтын боламын.
Dialogue: 0,0:07:16.47,0:07:20.60,Default,,0,0,0,,Иә, менің ағам ондай емес еді.
Dialogue: 0,0:07:20.81,0:07:24.61,Default,,0,0,0,,Мен заттар жасағанды ұнатамын, мен...
Dialogue: 0,0:07:24.73,0:07:25.69,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:25.82,0:07:26.77,Default,,0,0,0,,Ойкава
Dialogue: 0,0:07:28.82,0:07:30.19,Default,,0,0,0,,Анно Сенпай
Dialogue: 0,0:07:31.45,0:07:34.87,Default,,0,0,0,,Өкінішті, Тачибананың хатын оқыдың ба?
Dialogue: 0,0:07:35.41,0:07:37.79,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:07:37.91,0:07:42.17,Default,,0,0,0,,Оның бәрін маған тапсыруға батылы жетпейді.
Dialogue: 0,0:07:43.00,0:07:44.96,Default,,0,0,0,,жауапқа келетін болсақ...
Dialogue: 0,0:07:46.42,0:07:47.42,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:48.67,0:07:51.76,Default,,0,0,0,,Түсіндім, саған ұнайтын тағы біреу бар...
Dialogue: 0,0:07:53.76,0:07:54.80,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:07:55.64,0:07:57.93,Default,,0,0,0,,Тачибанаға өзім айтамын.
Dialogue: 0,0:07:58.06,0:08:00.73,Default,,0,0,0,,А, бұл туралы уайымдамаңыз.
Dialogue: 0,0:08:01.27,0:08:01.93,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:08:02.81,0:08:05.73,Default,,0,0,0,,(Төмен түсетін баспалдақтың дыбысы)
Dialogue: 0,0:08:10.99,0:08:11.94,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:08:12.07,0:08:13.99,Default,,0,0,0,,Не болып жатыр (Морита)?
Dialogue: 0,0:08:14.11,0:08:17.62,Default,,0,0,0,,Бұл эволюцияның себебі. Сіз бірдеңе таптыңыз ба?
Dialogue: 0,0:08:17.74,0:08:19.95,Default,,0,0,0,,Бір-біріңді білесіңдер ме? Морита мырза (Морита) Сіз...
Dialogue: 0,0:08:20.33,0:08:22.46,Default,,0,0,0,,Қорқынышты электр
Dialogue: 0,0:08:24.21,0:08:25.50,Default,,0,0,0,,Жаңғырық.
Dialogue: 0,0:08:25.92,0:08:29.46,Default,,0,0,0,,Бұл қалаға Мантикораны қуып келген болса керек.
Dialogue: 0,0:08:29.67,0:08:31.88,Default,,0,0,0,,Иә? (Үрейлі E) Күткендей.
Dialogue: 0,0:08:32.01,0:08:35.43,Default,,0,0,0,,Ол сонымен қатар синтетикалық адамдардың негізгі денесі болып табылады.
Dialogue: 0,0:08:35.55,0:08:39.26,Default,,0,0,0,,Біздің эволюцияны қолдайтынымыз таңқаларлық емес.
Dialogue: 0,0:08:39.39,0:08:40.89,Default,,0,0,0,,Морита мырза?
Dialogue: 0,0:08:41.02,0:08:45.31,Default,,0,0,0,,Қалай болғанда да, оған жаңа, түсініксіз түр көмектесе алмайды.
Dialogue: 0,0:08:45.44,0:08:47.81,Default,,0,0,0,,Әрқайсысын өлтіріңіз.
Dialogue: 0,0:08:47.94,0:08:49.23,Default,,0,0,0,,Жасап жатыр
Dialogue: 0,0:08:49.82,0:08:51.19,Default,,0,0,0,,Морита мырза, не...
Dialogue: 0,0:08:51.61,0:08:53.78,Default,,0,0,0,,Бұл не? Морита мырза қазір...
Dialogue: 0,0:08:54.53,0:08:56.66,Default,,0,0,0,,Ал өлтіру ше...
Dialogue: 0,0:08:57.16,0:08:57.87,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:09:15.93,0:09:20.10,Default,,0,0,0,,Бұл күндері мен өткен оқиғаларды жиі еске аламын.
Dialogue: 0,0:09:21.14,0:09:24.60,Default,,0,0,0,,Есіңде ме? Үлкен ағасы: «Гамелиннің пирожныйы»
Dialogue: 0,0:09:24.73,0:09:25.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:27.35,0:09:28.65,Default,,0,0,0,,Болжау?
Dialogue: 0,0:09:30.11,0:09:31.69,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,0:09:31.90,0:09:34.15,Default,,0,0,0,,Сіз тітіркендіргішсіз.
Dialogue: 0,0:09:34.82,0:09:35.40,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:36.53,0:09:37.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:38.20,0:09:40.66,Default,,0,0,0,,Осындай жерде кіші мектеп оқушысын қалай ұруға болады?
Dialogue: 0,0:09:40.95,0:09:42.33,Default,,0,0,0,,Бұл тыныш емес.
Dialogue: 0,0:09:42.62,0:09:43.74,Default,,0,0,0,,Менің әпкем
Dialogue: 0,0:09:44.04,0:09:46.00,Default,,0,0,0,,Әпкемді ұрған дұрыс па?
Dialogue: 0,0:09:47.08,0:09:48.42,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:09:50.08,0:09:50.96,Default,,0,0,0,,Жібер
Dialogue: 0,0:09:51.09,0:09:51.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:53.42,0:09:54.96,Default,,0,0,0,,Мұнда емес!
Dialogue: 0,0:09:55.92,0:09:59.39,Default,,0,0,0,,Мені жалғыз қалдырыңызшы. Бізді мазалама.
Dialogue: 0,0:10:00.76,0:10:02.72,Default,,0,0,0,,Үлкен аға! (құлаған заттардың дыбысы)
Dialogue: 0,0:10:06.27,0:10:07.98,Default,,0,0,0,,Мен оны тастадым (Сайоко) Ха...
Dialogue: 0,0:10:10.65,0:10:13.11,Default,,0,0,0,,Бұл нені білдіреді? Мұнда емес
Dialogue: 0,0:10:14.90,0:10:17.07,Default,,0,0,0,,Сіздің ағаңыз, кез келген жағдайда...
Dialogue: 0,0:10:22.87,0:10:25.54,Default,,0,0,0,,Менің қазіргі ағам менің нағыз ағам емес.
Dialogue: 0,0:10:26.08,0:10:29.17,Default,,0,0,0,,Бірақ ағам міндетті түрде қайтып келеді.
Dialogue: 0,0:10:30.08,0:10:31.67,Default,,0,0,0,,Тіпті сол кезде...
Dialogue: 0,0:10:38.09,0:10:39.01,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,0:10:39.13,0:10:40.38,Default,,0,0,0,,Жоқ, бұл жерде емес.
Dialogue: 0,0:10:41.01,0:10:43.93,Default,,0,0,0,,Менің ойымша, екеуміз алысқа бара алмаймыз.
Dialogue: 0,0:10:44.06,0:10:46.60,Default,,0,0,0,,Тағы біраз ізденейік
Dialogue: 0,0:10:49.23,0:10:51.31,Default,,0,0,0,,Бауырым, менің аяғым ауырып тұр.
Dialogue: 0,0:10:51.90,0:10:55.57,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз, жақында барлығына қайта ораласыз.
Dialogue: 0,0:10:58.94,0:11:01.45,Default,,0,0,0,,Мен үйге барғым келеді
Dialogue: 0,0:11:12.58,0:11:14.54,Default,,0,0,0,,Сонда адам айтты
Dialogue: 0,0:11:14.92,0:11:17.88,Default,,0,0,0,,Осы қалашықтағы барлық егеуқұйрықтарды жойайық.
Dialogue: 0,0:11:18.30,0:11:20.22,Default,,0,0,0,,Сосын ысқырық...
Dialogue: 0,0:11:20.34,0:11:24.18,Default,,0,0,0,,Қаланың түкпір-түкпірінен келген егеуқұйрықтар адамның айналасына жиналды.
Dialogue: 0,0:11:25.10,0:11:28.47,Default,,0,0,0,,Ағай, күн суық, қарным ашты.
Dialogue: 0,0:11:28.60,0:11:30.27,Default,,0,0,0,,Орындалды (Сайоко) Иә?
Dialogue: 0,0:11:34.36,0:11:35.40,Default,,0,0,0,,Тұмар
Dialogue: 0,0:11:37.02,0:11:39.36,Default,,0,0,0,,Адасып қалсам да қасымда.
Dialogue: 0,0:11:39.49,0:11:41.20,Default,,0,0,0,,Мен үйге бара алатыныма сенімдімін
Dialogue: 0,0:11:43.70,0:11:44.66,Default,,0,0,0,,Біраз өсіп алғанша күтсеңші.
Dialogue: 0,0:11:46.45,0:11:48.29,Default,,0,0,0,,Мен көмекке шақырамын.
Dialogue: 0,0:11:49.33,0:11:51.54,Default,,0,0,0,,Себебі ол қуыршақ сені қорғайды...
Dialogue: 0,0:11:51.66,0:11:54.67,Default,,0,0,0,,Уайымдама, күте тұр, жарай ма?
Dialogue: 0,0:11:55.63,0:11:57.71,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:01.76,0:12:04.76,Default,,0,0,0,,Оны өмірімде бірінші рет ағам берді.
Dialogue: 0,0:12:04.89,0:12:06.68,Default,,0,0,0,,Бұл қолдан жасалған қуыршақ болды.
Dialogue: 0,0:12:15.31,0:12:16.61,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:12:17.15,0:12:20.15,Default,,0,0,0,,Жақсысың ба, қыз? (3-ші өрт сөндіруші) Маған көрпе әкел. Көрпе.
Dialogue: 0,0:12:25.28,0:12:29.79,Default,,0,0,0,,Бұл көңілді ойын емес пе?
Dialogue: 0,0:12:35.25,0:12:36.25,Default,,0,0,0,,Ана?
Dialogue: 0,0:12:36.92,0:12:37.92,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:12:38.67,0:12:42.38,Default,,0,0,0,,Бұл? Білесің бе, бірдеңе жасау...
Dialogue: 0,0:12:42.51,0:12:45.68,Default,,0,0,0,,Бұл аяққа тұруға мүмкіндік болуы мүмкін.
Dialogue: 0,0:12:47.47,0:12:52.35,Default,,0,0,0,,Қараңызшы, әке, бұл триггер... Эй?
Dialogue: 0,0:12:53.06,0:12:53.81,Default,,0,0,0,,Сонымен
Dialogue: 0,0:12:54.94,0:12:57.31,Default,,0,0,0,,Ха... ағайын
Dialogue: 0,0:13:13.83,0:13:16.54,Default,,0,0,0,,Менің ойымша, бұл психогендік нәрсе...
Dialogue: 0,0:13:16.67,0:13:19.17,Default,,0,0,0,,Мұғалім осылай деді.
Dialogue: 0,0:13:19.88,0:13:23.34,Default,,0,0,0,,Ештеңе болмаса да, қалай жүрегім айнуы мүмкін?
Dialogue: 0,0:13:24.34,0:13:26.68,Default,,0,0,0,,Керемет, Ойкава-сан.
Dialogue: 0,0:13:26.80,0:13:28.84,Default,,0,0,0,,Әрқашан ағаңмен бірге жүр
Dialogue: 0,0:13:28.97,0:13:30.39,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:13:30.51,0:13:31.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:32.85,0:13:36.85,Default,,0,0,0,,Мен сенің күшің болып, жаныңда болғым келеді.
Dialogue: 0,0:13:52.12,0:13:54.04,Default,,0,0,0,,Ах... Ахаха
Dialogue: 0,0:13:55.50,0:13:56.83,Default,,0,0,0,,Біраз өсіп алғанша күтсеңші.
Dialogue: 0,0:14:03.55,0:14:05.05,Default,,0,0,0,,Бауырым, мына кісі...
Dialogue: 0,0:14:05.34,0:14:08.05,Default,,0,0,0,,Хэхехе аха... ах...
Dialogue: 0,0:14:10.76,0:14:12.39,Default,,0,0,0,,Хехе...
Dialogue: 0,0:14:15.06,0:14:17.35,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:14:18.44,0:14:19.27,Default,,0,0,0,,Хе-хе…
Dialogue: 0,0:14:19.40,0:14:20.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:22.11,0:14:25.53,Default,,0,0,0,,Эй, Сайоко, бұл Пейсли саябағы деп аталады.
Dialogue: 0,0:14:25.65,0:14:27.74,Default,,0,0,0,,Оны әкемнің компаниясы салады.
Dialogue: 0,0:14:28.07,0:14:29.57,Default,,0,0,0,,Did you get it?
Dialogue: 0,0:14:29.70,0:14:31.57,Default,,0,0,0,,Ах, тарту кезеңінен
Dialogue: 0,0:14:31.70,0:14:34.03,Default,,0,0,0,,Геоқалаларды жоспарлаумен ынтымақтастықты қолдаған кім?
Dialogue: 0,0:14:34.16,0:14:37.91,Default,,0,0,0,,Бұл тек біз едік, сондықтан мен қазірден бастап бос боламын.
Dialogue: 0,0:14:38.04,0:14:39.87,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:14:40.17,0:14:42.54,Default,,0,0,0,,Әкем (Тацуро) Чика?
Dialogue: 0,0:14:42.67,0:14:43.75,Default,,0,0,0,,Уәде есіңізде ме?
Dialogue: 0,0:14:44.80,0:14:46.92,Default,,0,0,0,,Уәде? Ал...
Dialogue: 0,0:14:47.05,0:14:48.38,Default,,0,0,0,,Ата-аналар қонаққа барады
Dialogue: 0,0:14:48.51,0:14:50.97,Default,,0,0,0,,Сенің әкең келесі жексенбіде келеді.
Dialogue: 0,0:14:51.09,0:14:52.68,Default,,0,0,0,,Уәде бермедің бе?
Dialogue: 0,0:14:52.80,0:14:56.81,Default,,0,0,0,,А... а, дұрыс. Жарайды, мен міндетті түрде барамын.
Dialogue: 0,0:14:56.93,0:14:58.77,Default,,0,0,0,,Мен сенімдімін, бұл уәде.
Dialogue: 0,0:15:00.44,0:15:02.02,Default,,0,0,0,,Ақшаға айырбастау
Dialogue: 0,0:15:02.19,0:15:04.77,Default,,0,0,0,,Осы қалашықтағы егеуқұйрықтардан құтылайық.
Dialogue: 0,0:15:06.78,0:15:09.70,Default,,0,0,0,,Мына ысқырықпен тышқанды алып кетейік.
Dialogue: 0,0:15:13.28,0:15:15.91,Default,,0,0,0,,Балаларды неге алып кеттің?
Dialogue: 0,0:15:16.04,0:15:19.08,Default,,0,0,0,,Маған қайтаруыңызды өтінемін, балаларымды қайтарыңыз
Dialogue: 0,0:15:21.12,0:15:25.84,Default,,0,0,0,,Балалар қайтып келмейді, өйткені сен уәдеңді бұздың.
Dialogue: 0,0:15:26.71,0:15:28.34,Default,,0,0,0,,Өйткені сен уәдеңді бұздың!
Dialogue: 0,0:15:29.47,0:15:32.84,Default,,0,0,0,,Әкең жұмыстан қолы бос емес еді.
Dialogue: 0,0:15:48.90,0:15:50.40,Default,,0,0,0,,Ондай әңгіме бар ма?
Dialogue: 0,0:15:50.53,0:15:53.03,Default,,0,0,0,,Geocity дөңгелегі жарылғаны... дегенді білдірмейді.
Dialogue: 0,0:15:53.45,0:15:55.03,Default,,0,0,0,,Моши Моши Моши Моши!
Dialogue: 0,0:16:00.96,0:16:02.71,Default,,0,0,0,,Не? what now
Dialogue: 0,0:16:03.54,0:16:06.13,Default,,0,0,0,,Дұрыс... (Сайоко) Үлкен аға?
Dialogue: 0,0:16:07.13,0:16:08.13,Default,,0,0,0,,Табылды
Dialogue: 0,0:16:09.34,0:16:10.42,Default,,0,0,0,,Сізге қажет емес заттар
Dialogue: 0,0:16:10.55,0:16:12.09,Default,,0,0,0,,Сізге не қажет емес?
Dialogue: 0,0:16:12.84,0:16:13.93,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:16:18.56,0:16:19.97,Default,,0,0,0,,Солай ма? Үлкен аға
Dialogue: 0,0:16:20.10,0:16:21.98,Default,,0,0,0,,Дәл қазір не болды, шынымен...
Dialogue: 0,0:16:22.10,0:16:22.85,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:25.85,0:16:30.57,Default,,0,0,0,,Қандай суық? Бұл не!
Dialogue: 0,0:16:35.70,0:16:38.49,Default,,0,0,0,,Сіз осында ауруханаға жатқызылдыңыз ба?
Dialogue: 0,0:16:38.62,0:16:41.54,Default,,0,0,0,,Иә, мен бірнеше күн бұрын қамауға алындым.
Dialogue: 0,0:16:42.54,0:16:44.67,Default,,0,0,0,,Бірақ мен оны біраз уақыттан бері көрмедім.
Dialogue: 0,0:16:45.21,0:16:46.92,Default,,0,0,0,,Барлығымыз оны іздейміз.
Dialogue: 0,0:16:48.17,0:16:50.21,Default,,0,0,0,,Um, this thing hasn't happened yet.
Dialogue: 0,0:16:50.34,0:16:52.80,Default,,0,0,0,,Well... it's also a hospital.
Dialogue: 0,0:16:52.92,0:16:56.80,Default,,0,0,0,,I understand. I'm busy. Кешіріңіз.
Dialogue: 0,0:16:57.97,0:17:02.98,Default,,0,0,0,,(Tatsuro's groan)
Dialogue: 0,0:17:05.44,0:17:07.81,Default,,0,0,0,,Mom, Mom, stay strong.
Dialogue: 0,0:17:07.94,0:17:10.69,Default,,0,0,0,,What about your brother? Сіздің ағаңыз қайда кетті?
Dialogue: 0,0:17:11.78,0:17:15.15,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:17:15.28,0:17:16.45,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:24.46,0:17:27.37,Default,,0,0,0,,Сағат тілі бағыты бойынша айналу.
Dialogue: 0,0:17:30.75,0:17:32.13,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:39.09,0:17:40.55,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:17:41.01,0:17:42.64,Default,,0,0,0,,This is it (Sayoko) Huh?
Dialogue: 0,0:17:44.10,0:17:46.44,Default,,0,0,0,,Бұл сәтсіз ойын-сауық саябағы
Dialogue: 0,0:17:46.56,0:17:49.15,Default,,0,0,0,,It was the most unnecessary thing in this world.
Dialogue: 0,0:17:50.19,0:17:53.15,Default,,0,0,0,,Маған мынау керек, маған мынау керек...
Dialogue: 0,0:17:53.23,0:17:54.23,Default,,0,0,0,,Тоқта, ағайын!
Dialogue: 0,0:17:54.32,0:17:55.74,Default,,0,0,0,,Тоқта (Сайоко) Ха...
Dialogue: 0,0:17:59.99,0:18:00.82,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:18:02.79,0:18:04.91,Default,,0,0,0,,Мұнда қалай сауда жасау керектігін түсіндірейін
Dialogue: 0,0:18:08.29,0:18:09.63,Default,,0,0,0,,Ах... Уф
Dialogue: 0,0:18:09.75,0:18:10.33,Default,,0,0,0,,Ах
Dialogue: 0,0:18:11.79,0:18:13.84,Default,,0,0,0,,(Morita's scream)
Dialogue: 0,0:18:15.55,0:18:18.30,Default,,0,0,0,,Сізде күш жоқ.
Dialogue: 0,0:18:18.63,0:18:20.09,Default,,0,0,0,,Гах...
Dialogue: 0,0:18:22.35,0:18:24.14,Default,,0,0,0,,(Chin's groan)
Dialogue: 0,0:18:24.52,0:18:26.56,Default,,0,0,0,,Ah, brother...
Dialogue: 0,0:18:26.64,0:18:29.44,Default,,0,0,0,,Бөлшектеу... Жасай беріңіз!
Dialogue: 0,0:18:30.65,0:18:33.57,Default,,0,0,0,,(Fat Gum) Бірақ! Егер біреуге арқаңды сүйенсең, сеніміңді арта отырып, бәрін оларға тапсыру – ер адамның парызы!
Dialogue: 0,0:18:36.24,0:18:38.53,Default,,0,0,0,,Хаха...
Dialogue: 0,0:18:38.65,0:18:41.57,Default,,0,0,0,,Бұл суық есімде...
Dialogue: 0,0:18:41.99,0:18:43.87,Default,,0,0,0,,Күн суық, ағайын.
Dialogue: 0,0:18:52.42,0:18:53.96,Default,,0,0,0,,Ол кезде болды
Dialogue: 0,0:18:54.84,0:18:57.26,Default,,0,0,0,,Содан бері мен ағамды ойлап келемін...
Dialogue: 0,0:19:00.76,0:19:01.59,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:19:02.14,0:19:03.30,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:03.43,0:19:05.76,Default,,0,0,0,,That... That's...
Dialogue: 0,0:19:07.39,0:19:11.02,Default,,0,0,0,,The light didn't give Пауэр to my brother.
Dialogue: 0,0:19:11.44,0:19:12.77,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:14.19,0:19:17.07,Default,,0,0,0,,Жарық маған күш берді.
Dialogue: 0,0:19:18.24,0:19:21.95,Default,,0,0,0,,The Пауэр to make your brother's wishes come true
Dialogue: 0,0:19:29.75,0:19:32.04,Default,,0,0,0,,Was that you?
Dialogue: 0,0:19:33.38,0:19:35.42,Default,,0,0,0,,Бәрі жақсы болды.
Dialogue: 0,0:19:35.67,0:19:39.97,Default,,0,0,0,,I wanted to be by your side and be your strength.
Dialogue: 0,0:19:40.30,0:19:41.13,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,0:19:41.26,0:19:42.72,Default,,0,0,0,,Ақшаға айырбастау -
Dialogue: 0,0:19:42.84,0:19:45.05,Default,,0,0,0,,Осы қалашықтағы егеуқұйрықтардан құтылайық.
Dialogue: 0,0:19:52.69,0:19:53.44,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:19:58.32,0:19:59.15,Default,,0,0,0,,Күтіңіз...
Dialogue: 0,0:20:03.07,0:20:05.16,Default,,0,0,0,,Wait, don't go.
Dialogue: 0,0:20:12.41,0:20:13.62,Default,,0,0,0,,Өтінемін, бармаңыз...
Dialogue: 0,0:20:23.72,0:20:28.39,Default,,0,0,0,,Мүмкін мен оны бұрыннан білетін шығармын.
Dialogue: 0,0:20:29.06,0:20:30.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:31.89,0:20:33.64,Default,,0,0,0,,Сізге шынымен не қажет емес
Dialogue: 0,0:20:36.52,0:20:39.27,Default,,0,0,0,,Сол кезде мен оны көрдім...
Dialogue: 0,0:20:41.65,0:20:43.57,Default,,0,0,0,,Бұрын кім болғанымды тастап кеткен
Dialogue: 0,0:20:46.45,0:20:52.96,Default,,0,0,0,,Бәлкім, менің өшіргім келгені өзім шығар.
Dialogue: 0,0:20:56.54,0:20:59.13,Default,,0,0,0,,Үлкен аға (Шин) иә?
Dialogue: 0,0:21:01.05,0:21:04.93,Default,,0,0,0,,Сіз мені бөлшектей аласыз ба?
Dialogue: 0,0:21:06.64,0:21:07.68,Default,,0,0,0,,Disassemble
Dialogue: 0,0:21:08.80,0:21:10.64,Default,,0,0,0,,Мен үшін, аға...
Dialogue: 0,0:21:11.22,0:21:12.98,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:21:15.10,0:21:16.98,Default,,0,0,0,,Мен бөлшектеуді таңдадым
Dialogue: 0,0:21:18.19,0:21:21.40,Default,,0,0,0,,Сайоко мұны жүзеге асырды.
Dialogue: 0,0:21:22.03,0:21:25.53,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:21:26.95,0:21:30.08,Default,,0,0,0,,Мен тағы да адасып қалдым.
Dialogue: 0,0:21:32.45,0:21:33.29,Default,,0,0,0,,Біраз өсіп алғанша күтсеңші.
Dialogue: 0,0:21:37.29,0:21:38.96,Default,,0,0,0,,Қош келдіңіз аға
Dialogue: 0,0:21:39.08,0:21:41.88,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:22:11.16,0:22:16.16,Default,,0,0,0,,♪～
Dialogue: 0,0:23:06.09,0:23:10.59,Default,,0,0,0,,～♪
Dialogue: 0,0:23:11.89,0:23:13.18,Default,,0,0,0,,Оның тарихын айту үшін сол күнге оралуымыз керек.
Dialogue: 0,0:23:13.18,0:23:14.01,Default,,0,0,0,,Оның тарихын айту үшін біз сол күнге оралуымыз керек.
Dialogue: 0,0:23:13.18,0:23:14.01,Default,,0,0,0,,Сіз-
Dialogue: 0,0:23:14.01,0:23:14.14,Default,,0,0,0,,Оның тарихын айту үшін сол күнге оралуымыз керек.
Dialogue: 0,0:23:14.14,0:23:15.51,Default,,0,0,0,,Оның тарихын айту үшін біз сол күнге оралуымыз керек.
Dialogue: 0,0:23:14.14,0:23:15.51,Default,,0,0,0,,Сіз бірдеңені қуып жүрсіз бе?
Dialogue: 0,0:23:15.51,0:23:15.64,Default,,0,0,0,,Сіз бірдеңені қуып жүрсіз бе?
Dialogue: 0,0:23:15.64,0:23:16.52,Default,,0,0,0,,Сіз бірдеңені қуып жүрсіз бе?
Dialogue: 0,0:23:15.64,0:23:16.52,Default,,0,0,0,,Мен сол кезде дүниеге келген сияқтымын.
Dialogue: 0,0:23:16.52,0:23:16.64,Default,,0,0,0,,Мен сол кезде дүниеге келген сияқтымын.
Dialogue: 0,0:23:16.64,0:23:18.31,Default,,0,0,0,,Мен сол кезде дүниеге келген сияқтымын.
