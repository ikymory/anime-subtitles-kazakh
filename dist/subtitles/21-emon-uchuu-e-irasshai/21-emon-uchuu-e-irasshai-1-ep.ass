Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:48.46,0:00:50.45,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:00:50.45,0:00:54.44,Default,,0,0,0,,Эхх
Dialogue: 0,0:00:54.44,0:00:56.44,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:00:56.44,0:00:59.44,Default,,0,0,0,,Әй! ау
Dialogue: 0,0:01:03.45,0:01:05.45,Default,,0,0,0,,Уф
Dialogue: 0,0:01:05.45,0:01:07.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:12.44,0:01:14.44,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:01:16.44,0:01:19.44,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:01:25.45,0:01:28.45,Default,,0,0,0,,Уау, құм ағыны!
Dialogue: 0,0:01:42.45,0:01:44.45,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:01:44.45,0:01:46.45,Default,,0,0,0,,Жарғыштың жылу сәулелеріне ұшыраңыз!
Dialogue: 0,0:01:52.44,0:01:54.45,Default,,0,0,0,,Бұл жерде ыңғайсыздық бар.
Dialogue: 0,0:01:54.45,0:01:57.45,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:02:02.45,0:02:04.44,Default,,0,0,0,,Жылдамдықтан гөрі сабыр сақтауды басты ұстаным ет.
Dialogue: 0,0:02:04.44,0:02:06.44,Default,,0,0,0,,Біз бәріміз бірге отырып, бір шыныаяқ ішкен күн де болар еді.
Dialogue: 0,0:02:09.44,0:02:11.45,Default,,0,0,0,,Ах
Dialogue: 0,0:02:11.45,0:02:13.45,Default,,0,0,0,,Әке, бұл қорқынышты. Жақсы жер болды.
Dialogue: 0,0:02:13.45,0:02:16.45,Default,,0,0,0,,21 Эмон «қорқынышты» деген не?
Dialogue: 0,0:02:16.45,0:02:19.45,Default,,0,0,0,,Бос уақытым болған сайын 3D теледидарды қараймын.
Dialogue: 0,0:02:19.45,0:02:21.44,Default,,0,0,0,,Менің қонақ үйіме аздап көмектесіңізші.
Dialogue: 0,0:02:21.44,0:02:25.44,Default,,0,0,0,,Мен сізге көмектессем де, әке, тұтынушылар болмады.
Dialogue: 0,0:02:25.44,0:02:27.45,Default,,0,0,0,,Тікұшақ деп айтпаңыз.
Dialogue: 0,0:02:27.45,0:02:30.45,Default,,0,0,0,,Сіз Цузурея 21 Эмонсыз.
Dialogue: 0,0:02:30.45,0:02:33.45,Default,,0,0,0,,Мм, ескі жиіркенішті есім.
Dialogue: 0,0:02:33.45,0:02:36.46,Default,,0,0,0,,Жақында осы 20 Эмон табысқа жетеді.
Dialogue: 0,0:02:36.46,0:02:39.44,Default,,0,0,0,,Қонақ үй иесі болыңыз
Dialogue: 0,0:02:39.44,0:02:42.44,Default,,0,0,0,,Қонақтарыңыз болмаса да Мастер бола аласыз ба?
Dialogue: 0,0:02:42.44,0:02:44.45,Default,,0,0,0,,Қайтадан айтыңыз
Dialogue: 0,0:02:44.45,0:02:47.45,Default,,0,0,0,,Әділ айтсам, менің ұрпағыма дейін жалғаса ма?
Dialogue: 0,0:02:47.45,0:02:49.45,Default,,0,0,0,,Ууу...
Dialogue: 0,0:02:49.45,0:02:51.45,Default,,0,0,0,,Уайымдамаңыз, әке.
Dialogue: 0,0:02:51.45,0:02:54.46,Default,,0,0,0,,Мен қазір ғарышкер болып, сені тамақтандырамын.
Dialogue: 0,0:02:54.46,0:02:56.44,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:02:56.44,0:02:58.44,Default,,0,0,0,,Иә
Dialogue: 0,0:02:58.44,0:03:00.44,Default,,0,0,0,,Иә? Ақымақ! Жаншылдыру соншалықты оңай ма?
Dialogue: 0,0:03:06.45,0:03:08.45,Default,,0,0,0,,Жүр, тез кетейік.
Dialogue: 0,0:03:08.45,0:03:10.46,Default,,0,0,0,,жұмыс жұмысының көрінісі
Dialogue: 0,0:03:10.46,0:03:13.44,Default,,0,0,0,,Тез не істейсің?
Dialogue: 0,0:03:13.44,0:03:15.44,Default,,0,0,0,,...
Dialogue: 0,0:04:19.46,0:04:23.45,Default,,0,0,0,,Мен құрметті гобелен цехын басып алып, қиратамын.
Dialogue: 0,0:04:23.45,0:04:26.45,Default,,0,0,0,,Ата-бабаңа қатты өкінемін.
Dialogue: 0,0:04:26.45,0:04:30.45,Default,,0,0,0,,Біріншіден, бірінші ұрпақ 1 Эмон қонақ үйді бастады.
Dialogue: 0,0:04:30.45,0:04:33.46,Default,,0,0,0,,Токугава сегунатының басталуымен бір уақытта
Dialogue: 0,0:04:33.46,0:04:38.44,Default,,0,0,0,,500 жылдан кейін 2 Эмон 3 Эмон 4 Эмон
Dialogue: 0,0:04:38.44,0:04:41.45,Default,,0,0,0,,5 Эмон 6 Эмон 7 Эмон
Dialogue: 0,0:04:41.45,0:04:45.45,Default,,0,0,0,,8 Эмон 9 Эмон 10 Эмон 11 Эмон
Dialogue: 0,0:04:45.45,0:04:47.45,Default,,0,0,0,,О
Dialogue: 0,0:04:47.45,0:04:49.45,Default,,0,0,0,,Әке, біз ғарыш әуежайына жақындап қалдық.
Dialogue: 0,0:04:49.45,0:04:52.46,Default,,0,0,0,,Жақында қолмен жұмыс режиміне ауысуым керек.
Dialogue: 0,0:04:52.46,0:04:54.46,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:20.45,0:05:23.46,Default,,0,0,0,,Андромедадан Плутон арқылы
Dialogue: 0,0:05:23.46,0:05:26.46,Default,,0,0,0,,603-ші ғарыш колониясының трансфер рейсі келді.
Dialogue: 0,0:05:33.45,0:05:35.45,Default,,0,0,0,,Бұл үлкен ғарыш кемесі.
Dialogue: 0,0:05:35.45,0:05:37.45,Default,,0,0,0,,Ол 10 000 адамға арналған.
Dialogue: 0,0:05:41.46,0:05:44.46,Default,,0,0,0,,Енді мен тұтынушыларды тартамын.
Dialogue: 0,0:05:44.46,0:05:47.46,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:05:49.45,0:05:53.45,Default,,0,0,0,,Ал, ерте келіп, Цузуреяға түне.
Dialogue: 0,0:05:53.45,0:05:55.45,Default,,0,0,0,,Әкем лас.
Dialogue: 0,0:05:55.45,0:05:57.46,Default,,0,0,0,,Ғарыштан келген тұтынушылар
Dialogue: 0,0:05:57.46,0:05:59.46,Default,,0,0,0,,Орион қонақ үйі сізді алып кетуге келді.
Dialogue: 0,0:05:59.46,0:06:04.46,Default,,0,0,0,,Бұл Эйрбас сізді қонақүйдің кіреберісіне апарады.
Dialogue: 0,0:06:04.46,0:06:06.45,Default,,0,0,0,,Ғарыштан келген тұтынушылар
Dialogue: 0,0:06:06.45,0:06:08.45,Default,,0,0,0,,Орион қонақ үйі сізді алып кетуге келді.
Dialogue: 0,0:06:08.45,0:06:10.45,Default,,0,0,0,,О, сен тағы да мейірімдісің.
Dialogue: 0,0:06:10.45,0:06:13.46,Default,,0,0,0,,Мен осында шештім.
Dialogue: 0,0:06:13.46,0:06:15.46,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:06:21.46,0:06:23.45,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:06:23.45,0:06:26.45,Default,,0,0,0,,Бұл Галактика қонақ үйі.
Dialogue: 0,0:06:26.45,0:06:28.45,Default,,0,0,0,,Мен осыны таңдадым.
Dialogue: 0,0:06:32.46,0:06:35.46,Default,,0,0,0,,Мама, мен соған мінгім келеді.
Dialogue: 0,0:06:35.46,0:06:37.46,Default,,0,0,0,,КЛАССИК ҚОНАҚ үй
Dialogue: 0,0:06:37.46,0:06:39.45,Default,,0,0,0,,Сізді 1900 жылдардағы классикалық көлік алып кетеді.
Dialogue: 0,0:06:39.45,0:06:42.45,Default,,0,0,0,,Мен сізді Шинкансенге апаруға келдім.
Dialogue: 0,0:06:42.45,0:06:44.45,Default,,0,0,0,,Бұл романтикалық.
Dialogue: 0,0:06:44.45,0:06:48.46,Default,,0,0,0,,Әй, сәл ғана, менің жүгімді сол жаққа апарып тасташы.
Dialogue: 0,0:06:48.46,0:06:52.46,Default,,0,0,0,,Жарайды... жаңа ғана менің үйімде боламын дегеніңмен.
Dialogue: 0,0:06:52.46,0:06:54.46,Default,,0,0,0,,Угья
Dialogue: 0,0:06:59.45,0:07:02.45,Default,,0,0,0,,Бұл ұят болды. Бұл тағы бір дем болды.
Dialogue: 0,0:07:02.45,0:07:05.46,Default,,0,0,0,,Бірақ 21 Эмон
Dialogue: 0,0:07:05.46,0:07:08.46,Default,,0,0,0,,Бұл нәрселерге көңіліңізді түсірмеңіз.
Dialogue: 0,0:07:08.46,0:07:11.46,Default,,0,0,0,,Бизнес құлдырау мен құлдыраумен келеді.
Dialogue: 0,0:07:11.46,0:07:15.45,Default,,0,0,0,,Бүгін жұмыс істемесе, ертең әрқашан бар, солай емес пе? 21 Эмон
Dialogue: 0,0:07:15.45,0:07:19.45,Default,,0,0,0,,Ой, не? сурет? иә?
Dialogue: 0,0:07:19.45,0:07:21.46,Default,,0,0,0,,Уау
Dialogue: 0,0:07:21.46,0:07:23.46,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:07:23.46,0:07:26.46,Default,,0,0,0,,Мен жақында ұшқыш болғым келеді.
Dialogue: 0,0:07:26.46,0:07:28.46,Default,,0,0,0,,Сәлем! 21 Эмон
Dialogue: 0,0:07:28.46,0:07:30.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:30.47,0:07:34.45,Default,,0,0,0,,21Эмон Мен қатты уайымдап отырмын.
Dialogue: 0,0:07:34.45,0:07:36.45,Default,,0,0,0,,Сіз
Dialogue: 0,0:07:36.45,0:07:38.46,Default,,0,0,0,,Иә, енді түсіндім.
Dialogue: 0,0:07:38.46,0:07:40.46,Default,,0,0,0,,Уау, ауырып тұр
Dialogue: 0,0:07:40.46,0:07:44.46,Default,,0,0,0,,Бұл кім? Мұндай жерге кім тас қояды?
Dialogue: 0,0:07:44.46,0:07:47.47,Default,,0,0,0,,Иә? Не? Бұл тас
Dialogue: 0,0:07:47.47,0:07:49.45,Default,,0,0,0,,Ах
Dialogue: 0,0:07:49.45,0:07:52.45,Default,,0,0,0,,«Не?» менің желісім. Бұл құрметсіздік, жердегілер.
Dialogue: 0,0:07:52.45,0:07:56.46,Default,,0,0,0,,Аа, кешіріңіз, сіз жаңа ғана пайдаланған зымыранмен келдіңіз бе?
Dialogue: 0,0:07:56.46,0:07:59.46,Default,,0,0,0,,Ора Геккелодани тұмандығынан.
Dialogue: 0,0:07:59.46,0:08:03.47,Default,,0,0,0,,Ол Тамба жұлдыздар жүйесінен, Сасаямадан келді.
Dialogue: 0,0:08:03.47,0:08:06.45,Default,,0,0,0,,Папа, сіз Сасаяма жұлдызы туралы білесіз бе?
Dialogue: 0,0:08:06.45,0:08:09.45,Default,,0,0,0,,Сасаяма? Хмм
Dialogue: 0,0:08:09.45,0:08:11.46,Default,,0,0,0,,Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:08:11.46,0:08:14.46,Default,,0,0,0,,Бұл өте шалғай жерде шығар.
Dialogue: 0,0:08:14.46,0:08:17.46,Default,,0,0,0,,Ах! Мен Оланы мазақ еттім.
Dialogue: 0,0:08:17.46,0:08:19.46,Default,,0,0,0,,Мен «инакамон» дедім
Dialogue: 0,0:08:19.46,0:08:21.47,Default,,0,0,0,,Е... бұл сенгісіз.
Dialogue: 0,0:08:21.47,0:08:24.45,Default,,0,0,0,,Қалалық стиль, сәнді пропорциялар
Dialogue: 0,0:08:24.45,0:08:27.46,Default,,0,0,0,,Өте асыл сөздер
Dialogue: 0,0:08:27.46,0:08:29.46,Default,,0,0,0,,Сізге не қолайлы?
Dialogue: 0,0:08:29.46,0:08:31.46,Default,,0,0,0,,Бұл Цузурея қонақ үйі Иә.
Dialogue: 0,0:08:31.46,0:08:35.46,Default,,0,0,0,,Әй, ұрыс па?
Dialogue: 0,0:08:35.46,0:08:38.47,Default,,0,0,0,,Е... жоқ, таспа цехында.
Dialogue: 0,0:08:38.47,0:08:41.45,Default,,0,0,0,,Ахахха, бұл бұзылған дүкен.
Dialogue: 0,0:08:41.45,0:08:43.46,Default,,0,0,0,,Жоқ, мен бастермін.
Dialogue: 0,0:08:43.46,0:08:45.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:45.46,0:08:49.46,Default,,0,0,0,,Жоқ, маған бұл есім ұнайды. Түнде болайық.
Dialogue: 0,0:08:49.46,0:08:51.46,Default,,0,0,0,,Не? Бұл рас па?
Dialogue: 0,0:08:51.46,0:08:54.46,Default,,0,0,0,,Ал, көп рахмет.
Dialogue: 0,0:09:02.46,0:09:05.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:05.46,0:09:07.46,Default,,0,0,0,,Ах
Dialogue: 0,0:09:07.46,0:09:12.47,Default,,0,0,0,,Мынау жылтыр да әдемі қонақ үй гобелен ме?
Dialogue: 0,0:09:12.47,0:09:15.45,Default,,0,0,0,,Жоқ, бұл Орион қонақ үйі.
Dialogue: 0,0:09:15.45,0:09:18.46,Default,,0,0,0,,Біздің үй осының алдында.
Dialogue: 0,0:09:18.46,0:09:21.46,Default,,0,0,0,,О, анау үлкен жігіт пе?
Dialogue: 0,0:09:21.46,0:09:24.46,Default,,0,0,0,,Не? Бұл Галакси қонақ үйі
Dialogue: 0,0:09:24.46,0:09:29.47,Default,,0,0,0,,Көрші есік – Цузурея қонақ үйіміз.
Dialogue: 0,0:09:29.47,0:09:33.46,Default,,0,0,0,,Солай ма? Бұл өте кішкентай.
Dialogue: 0,0:09:33.46,0:09:36.46,Default,,0,0,0,,Қызмет көрсету – қонақүйлердің кілті.
Dialogue: 0,0:09:36.46,0:09:39.46,Default,,0,0,0,,Бұл үлкен болу ғана емес.
Dialogue: 0,0:09:39.46,0:09:42.46,Default,,0,0,0,,Әй, жақсы сөздер айтасың.
Dialogue: 0,0:09:57.46,0:10:00.47,Default,,0,0,0,,О, мен қайтып келдім.
Dialogue: 0,0:10:00.47,0:10:04.47,Default,,0,0,0,,Бұл – тұтынушы, бұл әдеттен тыс.
Dialogue: 0,0:10:04.47,0:10:07.46,Default,,0,0,0,,Гонске Құрметті тұтынушы.
Dialogue: 0,0:10:07.46,0:10:09.46,Default,,0,0,0,,Сіз мені Ола деп атадыңыз ба?
Dialogue: 0,0:10:09.46,0:10:13.46,Default,,0,0,0,,Онабе, бөлмеңді дайында.
Dialogue: 0,0:10:13.46,0:10:16.46,Default,,0,0,0,,Иә, ханым
Dialogue: 0,0:10:16.46,0:10:19.47,Default,,0,0,0,,Бұл сіздің бөлмеңіздің электрондық кілті.
Dialogue: 0,0:10:19.47,0:10:22.47,Default,,0,0,0,,25-кабинет туралы ақпарат
Dialogue: 0,0:10:22.47,0:10:24.46,Default,,0,0,0,,Эй, мұнда кел.
Dialogue: 0,0:10:24.46,0:10:26.46,Default,,0,0,0,,Қаншама сөз шоғыры
Dialogue: 0,0:10:26.46,0:10:30.46,Default,,0,0,0,,Мені ауылдан деп ойлап, мазақ қылдың.
Dialogue: 0,0:10:30.46,0:10:32.46,Default,,0,0,0,,Сөзбен жаман болу туғаннан келеді.
Dialogue: 0,0:10:32.46,0:10:34.47,Default,,0,0,0,,Иә, сол тұтынушы.
Dialogue: 0,0:10:34.47,0:10:36.47,Default,,0,0,0,,Бастапқыда Гонске болды
Dialogue: 0,0:10:36.47,0:10:39.47,Default,,0,0,0,,Таудың тереңінен картоп қазу үшін жасалған робот.
Dialogue: 0,0:10:39.47,0:10:43.46,Default,,0,0,0,,Мен құлдыраудың алдында тұрғанымда, оны мына тоцама сатып алды.
Dialogue: 0,0:10:43.46,0:10:45.46,Default,,0,0,0,,Мен заттарды ұнататын адаммын Ахахха...
Dialogue: 0,0:10:45.46,0:10:48.46,Default,,0,0,0,,Менің ақшам болмағандықтан басқа амалым болмады.
Dialogue: 0,0:10:48.46,0:10:50.47,Default,,0,0,0,,Сіз жүгіңізді тез әкеле аласыз ба?
Dialogue: 0,0:10:50.47,0:10:52.47,Default,,0,0,0,,Иә
Dialogue: 0,0:10:52.47,0:10:54.47,Default,,0,0,0,,О
Dialogue: 0,0:10:54.47,0:10:56.47,Default,,0,0,0,,О, бұған тиіспе.
Dialogue: 0,0:10:56.47,0:10:58.46,Default,,0,0,0,,Не? Аа, кешіріңіз
Dialogue: 0,0:10:58.46,0:11:00.46,Default,,0,0,0,,Гонсуке, мына жүкті өзіңізбен бірге алып келіңіз.
Dialogue: 0,0:11:00.46,0:11:02.46,Default,,0,0,0,,Иә
Dialogue: 0,0:11:05.46,0:11:09.47,Default,,0,0,0,,Аа, ішінде өте маңызды нәрсе бар сияқты.
Dialogue: 0,0:11:09.47,0:11:12.47,Default,,0,0,0,,Бөлмеңізді Сасаямаға сәйкес етіп реттеңіз.
Dialogue: 0,0:11:12.47,0:11:16.46,Default,,0,0,0,,Бұл тіпті Планетарлық энциклопедияда да жоқ.
Dialogue: 0,0:11:16.46,0:11:19.46,Default,,0,0,0,,Ғаламның бұрышындағы жұлдыз...
Dialogue: 0,0:11:19.46,0:11:22.46,Default,,0,0,0,,Тынш! олай айтпа
Dialogue: 0,0:11:22.46,0:11:24.47,Default,,0,0,0,,Коноджо дабе
Dialogue: 0,0:11:24.47,0:11:26.47,Default,,0,0,0,,Иә
Dialogue: 0,0:11:26.47,0:11:28.47,Default,,0,0,0,,Кешіктірме, тез тұр.
Dialogue: 0,0:11:28.47,0:11:32.47,Default,,0,0,0,,А, бұл эскалатор қозғалмайды.
Dialogue: 0,0:11:32.47,0:11:34.46,Default,,0,0,0,,Мен Оланы мазақ еттім.
Dialogue: 0,0:11:34.46,0:11:36.46,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:11:36.46,0:11:39.46,Default,,0,0,0,,Бұл қонақүй апатты, бұзылған, қозғалмайды.
Dialogue: 0,0:11:39.46,0:11:42.47,Default,,0,0,0,,Ауылдан келгендердің мінезі қысқа.
Dialogue: 0,0:11:42.47,0:11:44.47,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:11:44.47,0:11:47.47,Default,,0,0,0,,Ах! Бұл жай ғана ауыл жері, ақылсыз.
Dialogue: 0,0:11:47.47,0:11:49.47,Default,,0,0,0,,Гонсуке, кешірім сұра.
Dialogue: 0,0:11:49.47,0:11:51.46,Default,,0,0,0,,Бірінші дәрежелі қонақүйде әлі бала ма?
Dialogue: 0,0:11:51.46,0:11:54.46,Default,,0,0,0,,Эй, эй, бұл картоп қазатын робот.
Dialogue: 0,0:11:54.46,0:11:57.47,Default,,0,0,0,,Жетер, мен саған жол көрсетемін.
Dialogue: 0,0:11:57.47,0:11:59.47,Default,,0,0,0,,Мен мұны басынан бастап істеуім керек еді.
Dialogue: 0,0:11:59.47,0:12:01.47,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:12:01.47,0:12:04.47,Default,,0,0,0,,Қайсысы шебер екенін білмеймін.
Dialogue: 0,0:12:06.47,0:12:08.46,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:08.46,0:12:12.46,Default,,0,0,0,,Ханым, біз электронды ми орталығынан жауап алдық.
Dialogue: 0,0:12:12.46,0:12:14.47,Default,,0,0,0,,Бұл көмектесті.
Dialogue: 0,0:12:14.47,0:12:16.47,Default,,0,0,0,,Сасаяманың атмосферасы А типті.
Dialogue: 0,0:12:16.47,0:12:21.47,Default,,0,0,0,,Атмосфералық қысым 3,5 Температура 78 градус Гравитация 1,7Г
Dialogue: 0,0:12:21.47,0:12:24.46,Default,,0,0,0,,Eh, атмосфера А және
Dialogue: 0,0:12:24.46,0:12:26.46,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:26.46,0:12:29.46,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:12:29.46,0:12:32.47,Default,,0,0,0,,Ах! Сіз мен туралы өте ақымақсыз ...
Dialogue: 0,0:12:32.47,0:12:34.47,Default,,0,0,0,,«Сен мені мазақ қылдың».
Dialogue: 0,0:12:34.47,0:12:37.47,Default,,0,0,0,,«Маған орындықтары жоқ шағын бөлмені көрсетіңізші, солай ма?
Dialogue: 0,0:12:37.47,0:12:39.47,Default,,0,0,0,,...
Dialogue: 0,0:12:39.47,0:12:41.48,Default,,0,0,0,,Қонақ бөлмесі артқы жағында.
Dialogue: 0,0:12:41.48,0:12:44.48,Default,,0,0,0,,Біз қазір оны жұлдызыңызға сәйкестендіру үшін реттеп жатырмыз.
Dialogue: 0,0:12:47.47,0:12:49.47,Default,,0,0,0,,Енді бәрі жақсы. Өтінемін, бөлмеңе бар.
Dialogue: 0,0:12:49.47,0:12:52.47,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:12:52.47,0:12:54.47,Default,,0,0,0,,Уақытыңызды бөліңіз
Dialogue: 0,0:12:54.47,0:12:59.48,Default,,0,0,0,,Ха, бұл бала туралы көп нәрсе көруге болады.
Dialogue: 0,0:12:59.48,0:13:02.46,Default,,0,0,0,,Аа, менің жүйкем шаршады.
Dialogue: 0,0:13:02.46,0:13:04.46,Default,,0,0,0,,Өйткені, ғарышкер болған жақсы.
Dialogue: 0,0:13:09.47,0:13:12.47,Default,,0,0,0,,Сұрақтар қойылмайды, қазір үйге қайтыңыз.
Dialogue: 0,0:13:12.47,0:13:15.48,Default,,0,0,0,,Әкем ашулы, бұл сирек.
Dialogue: 0,0:13:15.48,0:13:18.46,Default,,0,0,0,,Үйге қайт десем, үйге қайт!
Dialogue: 0,0:13:18.46,0:13:21.47,Default,,0,0,0,,Сіз сенімдісіз бе? қоштасу
Dialogue: 0,0:13:21.47,0:13:24.47,Default,,0,0,0,,А, мен Галакси қонақ үйінің менеджерімін.
Dialogue: 0,0:13:24.47,0:13:27.47,Default,,0,0,0,,Мен көршіге деген ізгі ниетпен бейбіт өтініш жасадым.
Dialogue: 0,0:13:27.47,0:13:30.48,Default,,0,0,0,,Президенттің сезімін неге түсінбейсіз?
Dialogue: 0,0:13:30.48,0:13:32.48,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:13:32.48,0:13:34.48,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:34.48,0:13:38.47,Default,,0,0,0,,Сіз бізді қайтадан сатамыз деп жатырсыз ба? Галактика мырза
Dialogue: 0,0:13:38.47,0:13:40.47,Default,,0,0,0,,Бұл сонымен қатар көбірек дәретханалар салу.
Dialogue: 0,0:13:40.47,0:13:42.47,Default,,0,0,0,,Ауырсыну қалай?
Dialogue: 0,0:13:42.47,0:13:44.47,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:13:44.47,0:13:46.47,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:13:46.47,0:13:48.48,Default,,0,0,0,,Егер сіз оны қойма ретінде пайдаланғыңыз келсе, бәрібір.
Dialogue: 0,0:13:48.48,0:13:50.48,Default,,0,0,0,,Ең болмағанда бұл қойма...
Dialogue: 0,0:13:50.48,0:13:52.46,Default,,0,0,0,,Иә? Ууу!
Dialogue: 0,0:13:52.46,0:13:54.47,Default,,0,0,0,,Ақымақ! Құрылғанына 500 жыл толды...
Dialogue: 0,0:13:54.47,0:13:56.47,Default,,0,0,0,,А, бұл телефон қоңырауы.
Dialogue: 0,0:14:00.47,0:14:02.47,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:14:02.47,0:14:04.48,Default,,0,0,0,,Сәлем, көрші үйдегі Луна
Dialogue: 0,0:14:04.48,0:14:06.48,Default,,0,0,0,,Шындығында, бүгін
Dialogue: 0,0:14:06.48,0:14:08.48,Default,,0,0,0,,Эмонның сыныптасы емес.
Dialogue: 0,0:14:08.48,0:14:11.47,Default,,0,0,0,,Мен Галакси қонақ үйінің атынан айтқым келеді.
Dialogue: 0,0:14:11.47,0:14:15.47,Default,,0,0,0,,Әкеңнің өкілісің бе?
Dialogue: 0,0:14:15.47,0:14:18.47,Default,,0,0,0,,Қош бол, әкеңе айт
Dialogue: 0,0:14:18.47,0:14:21.48,Default,,0,0,0,,Маған таспа дүкенімді сатуға көндіргім келеді.
Dialogue: 0,0:14:21.48,0:14:24.48,Default,,0,0,0,,Бұл мүмкін емес, ол өте қыңыр.
Dialogue: 0,0:14:24.48,0:14:27.47,Default,,0,0,0,,Мм, олай айтпа, эй.
Dialogue: 0,0:14:27.47,0:14:30.47,Default,,0,0,0,,Луна-чан, мысықтың сипап тұрған дауысымен айтшы.
Dialogue: 0,0:14:30.47,0:14:33.47,Default,,0,0,0,,Ал, «мысықтың сылап дауысы» дегеніміз не?
Dialogue: 0,0:14:33.47,0:14:35.47,Default,,0,0,0,,Адамдар маған жақсы сөздер айтып жатса да
Dialogue: 0,0:14:35.47,0:14:38.48,Default,,0,0,0,,Дұрыс, бұл Луна-чанға ұқсайды.
Dialogue: 0,0:14:38.48,0:14:40.48,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:14:40.48,0:14:42.48,Default,,0,0,0,,Ах
Dialogue: 0,0:14:42.48,0:14:45.47,Default,,0,0,0,,Эмон түсінбейді!
Dialogue: 0,0:14:45.47,0:14:47.47,Default,,0,0,0,,Көріп отырғаныңыздай.
Dialogue: 0,0:14:47.47,0:14:49.47,Default,,0,0,0,,Тас бастардың екі буыны
Dialogue: 0,0:14:49.47,0:14:51.47,Default,,0,0,0,,Бұл туралы ештеңе істеуге болмайды.
Dialogue: 0,0:14:51.47,0:14:53.47,Default,,0,0,0,,…бізді ажырата алмайды!
Dialogue: 0,0:14:53.47,0:14:57.48,Default,,0,0,0,,Жарайды, мен де көршілерді мұңайтқым келмейді.
Dialogue: 0,0:14:57.48,0:14:59.48,Default,,0,0,0,,Бұл да бір кәсіп қой.
Dialogue: 0,0:14:59.48,0:15:01.47,Default,,0,0,0,,Сіз не істемексіз? әке
Dialogue: 0,0:15:01.47,0:15:04.47,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:15:04.47,0:15:07.47,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:07.47,0:15:10.48,Default,,0,0,0,,Қанша ақша болса да сатасың.
Dialogue: 0,0:15:10.48,0:15:13.48,Default,,0,0,0,,Мен таспа цехын өз қолыма аламын.
Dialogue: 0,0:15:13.48,0:15:16.48,Default,,0,0,0,,Қараңдаршы, мен сені әлемдегі ең жақсы қонақ үйге айналдырғалы жатырмын.
Dialogue: 0,0:15:16.48,0:15:18.47,Default,,0,0,0,,Ах
Dialogue: 0,0:15:18.47,0:15:21.47,Default,,0,0,0,,Жақсы айтты, сондықтан ол менің ұлым.
Dialogue: 0,0:15:21.47,0:15:23.47,Default,,0,0,0,,Жаман болды
Dialogue: 0,0:15:26.47,0:15:29.48,Default,,0,0,0,,Біртүрлі күткен кезде бұл мәселе.
Dialogue: 0,0:15:29.48,0:15:33.48,Default,,0,0,0,,Менің арманым ғарышкер болу.
Dialogue: 0,0:15:33.48,0:15:35.48,Default,,0,0,0,,А, эй, мектептің басталатын уақыты.
Dialogue: 0,0:15:45.48,0:15:48.48,Default,,0,0,0,,Сәлем, бәріңе. Қалдарыңыз қалай?
Dialogue: 0,0:15:48.48,0:15:52.48,Default,,0,0,0,,Бүгін де 3D теледидар арқылы сабақты қызықты өткізейік.
Dialogue: 0,0:15:52.48,0:15:54.47,Default,,0,0,0,,Сабаққа қатысу
Dialogue: 0,0:15:54.47,0:15:56.47,Default,,0,0,0,,Луна-кун
Dialogue: 0,0:15:56.47,0:15:58.47,Default,,0,0,0,,Иә
Dialogue: 0,0:15:58.47,0:16:00.48,Default,,0,0,0,,Камекичи-кун
Dialogue: 0,0:16:00.48,0:16:02.48,Default,,0,0,0,,Кавасаки-кун
Dialogue: 0,0:16:02.48,0:16:04.48,Default,,0,0,0,,P-көшірме-көшіру-көшіру-көшіру-көшіру-көшіру-көшіру-көшіру
Dialogue: 0,0:16:04.48,0:16:06.48,Default,,0,0,0,,О? Мінеки! Қайтадан ойнайық
Dialogue: 0,0:16:06.48,0:16:08.48,Default,,0,0,0,,Иә
Dialogue: 0,0:16:08.48,0:16:10.47,Default,,0,0,0,,21 Эмон-кун
Dialogue: 0,0:16:10.47,0:16:12.47,Default,,0,0,0,,21 Эмон-кун?
Dialogue: 0,0:16:12.47,0:16:15.47,Default,,0,0,0,,Мм, қонақүй ме, әлде ұшқыш па?
Dialogue: 0,0:16:15.47,0:16:18.48,Default,,0,0,0,,Қонақ үйдегі жұмысымды тастауым керек пе, әлде авиатор болу керек пе?
Dialogue: 0,0:16:18.48,0:16:20.48,Default,,0,0,0,,Мәселе мынада.
Dialogue: 0,0:16:20.48,0:16:22.48,Default,,0,0,0,,21 Эмон!
Dialogue: 0,0:16:22.48,0:16:24.48,Default,,0,0,0,,Не? Не? Ямада мырза
Dialogue: 0,0:16:24.48,0:16:27.47,Default,,0,0,0,,Бұл «Не?» емес. сабақ басталғанына қарамастан.
Dialogue: 0,0:16:27.47,0:16:31.47,Default,,0,0,0,,Ой, кешіріңіз, мұғалім, мен қазір маңызды нәрсе туралы ойлап отырмын.
Dialogue: 0,0:16:31.47,0:16:34.48,Default,,0,0,0,,Бейне үшін мен сізге оны кейінірек баяу көруге рұқсат етемін.
Dialogue: 0,0:16:34.48,0:16:37.48,Default,,0,0,0,,А, міне! Күте тұрыңыз!
Dialogue: 0,0:16:37.48,0:16:40.48,Default,,0,0,0,,Әй, бұл өмірлік мәселе, жақсылап ойланайық.
Dialogue: 0,0:16:43.48,0:16:46.47,Default,,0,0,0,,Кешіріңіз, мұнда біреу бар ма?
Dialogue: 0,0:16:46.47,0:16:49.47,Default,,0,0,0,,Иә? О, бұл клиент.
Dialogue: 0,0:16:49.47,0:16:52.48,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:16:52.48,0:16:54.48,Default,,0,0,0,,Мен сізге біраздан бері телефон соғып жатырмын.
Dialogue: 0,0:16:54.48,0:16:56.48,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:16:56.48,0:16:58.48,Default,,0,0,0,,Тапсырыс берушінің тарапынан, тіпті жарнама болмаса да.
Dialogue: 0,0:16:58.48,0:17:00.48,Default,,0,0,0,,Менің келуім сирек...
Dialogue: 0,0:17:00.48,0:17:02.47,Default,,0,0,0,,Мұнымен нені айтасыз?
Dialogue: 0,0:17:02.47,0:17:04.47,Default,,0,0,0,,Вахахаха
Dialogue: 0,0:17:04.47,0:17:06.47,Default,,0,0,0,,Ей, мен дүниенің шетіндегі жұлдыздарды араладым.
Dialogue: 0,0:17:06.47,0:17:09.48,Default,,0,0,0,,Бұл көңіл-күй мен үшін тамаша
Dialogue: 0,0:17:09.48,0:17:11.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:19.47,0:17:23.47,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:17:23.47,0:17:26.48,Default,,0,0,0,,Мен бұл адамды бір жерден көргендей сезінемін.
Dialogue: 0,0:17:26.48,0:17:28.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:28.48,0:17:30.48,Default,,0,0,0,,Сіз әйгілі ғарыш зерттеушісісіз.
Dialogue: 0,0:17:30.48,0:17:32.48,Default,,0,0,0,,Бұл Сканли мырза емес пе?
Dialogue: 0,0:17:32.48,0:17:35.49,Default,,0,0,0,,Қош бол, мен Сканлимін.
Dialogue: 0,0:17:35.49,0:17:37.47,Default,,0,0,0,,Стереко тұмандықты зерттеуден
Dialogue: 0,0:17:37.47,0:17:39.47,Default,,0,0,0,,Мен жаңа ғана оралдым.
Dialogue: 0,0:17:39.47,0:17:41.48,Default,,0,0,0,,Ой, бұл арман шығар
Dialogue: 0,0:17:41.48,0:17:44.48,Default,,0,0,0,,Мен... Мен жанкүйермін, қол қоюыңызды өтінемін.
Dialogue: 0,0:17:44.48,0:17:48.48,Default,,0,0,0,,Ахахахаха. Мен қайда баруым керек?
Dialogue: 0,0:17:48.48,0:17:50.48,Default,,0,0,0,,Иә, бұл?
Dialogue: 0,0:17:50.48,0:17:54.47,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:17:54.47,0:17:56.47,Default,,0,0,0,,Енді бұл туралы не деуге болады?
Dialogue: 0,0:17:56.47,0:18:00.48,Default,,0,0,0,,Уау! Сізге көп рахмет
Dialogue: 0,0:18:00.48,0:18:02.48,Default,,0,0,0,,Керемет, ғалам
Dialogue: 0,0:18:02.48,0:18:05.48,Default,,0,0,0,,Әңгімені естігеннің өзінде жүрегім қалтырап кетеді.
Dialogue: 0,0:18:05.48,0:18:07.48,Default,,0,0,0,,Хмм, иә.
Dialogue: 0,0:18:23.48,0:18:26.49,Default,,0,0,0,,Уау
Dialogue: 0,0:18:26.49,0:18:28.47,Default,,0,0,0,,Мына жұлдыздар теңізіне қараңдар
Dialogue: 0,0:18:28.47,0:18:30.47,Default,,0,0,0,,Сіз олардың сыбырларын естисіз бе?
Dialogue: 0,0:18:30.47,0:18:33.48,Default,,0,0,0,,Жұлдыздардың бұлай айтқанын тыңдау керек.
Dialogue: 0,0:18:33.48,0:18:35.48,Default,,0,0,0,,Жастар, өршіл болыңдар.
Dialogue: 0,0:18:35.48,0:18:37.48,Default,,0,0,0,,Сен де өскенде
Dialogue: 0,0:18:37.48,0:18:39.48,Default,,0,0,0,,Біздің жолымызды қуғаныңызды қалаймыз.
Dialogue: 0,0:18:39.48,0:18:41.48,Default,,0,0,0,,Не? иә!
Dialogue: 0,0:18:45.47,0:18:47.48,Default,,0,0,0,,Мистер Сканли керемет.
Dialogue: 0,0:18:47.48,0:18:51.48,Default,,0,0,0,,Егер бұл орын алса, мен бірден ұшқыштар бойынша дайындықтан өтемін.
Dialogue: 0,0:18:51.48,0:18:55.48,Default,,0,0,0,,Мен бірден әкеммен сөйлесуім керек.
Dialogue: 0,0:18:55.48,0:18:58.49,Default,,0,0,0,,Бірақ бұл мәселе.
Dialogue: 0,0:18:58.49,0:19:02.47,Default,,0,0,0,,Менің әкем мойынсұнып, жарайды дей ме?
Dialogue: 0,0:19:02.47,0:19:06.48,Default,,0,0,0,,Сонда да ата-ананың ыңғайына қарай шешіледі.
Dialogue: 0,0:19:06.48,0:19:08.48,Default,,0,0,0,,Ал, мен айтайын.
Dialogue: 0,0:19:08.48,0:19:11.48,Default,,0,0,0,,Онда мүмкіндігінше тезірек жұмысты бастаңыз.
Dialogue: 0,0:19:11.48,0:19:13.48,Default,,0,0,0,,Иә, мен ақылдымын.
Dialogue: 0,0:19:13.48,0:19:15.48,Default,,0,0,0,,Сәлем
Dialogue: 0,0:19:17.49,0:19:19.49,Default,,0,0,0,,Білесіз бе, әке.
Dialogue: 0,0:19:19.49,0:19:21.48,Default,,0,0,0,,Мен өзімді әлсіз сезінемін.
Dialogue: 0,0:19:21.48,0:19:23.48,Default,,0,0,0,,Мен көп нәрсені ойладым.
Dialogue: 0,0:19:23.48,0:19:25.48,Default,,0,0,0,,Қонақ үй лицензиясынан айырылса, ол аяқталды.
Dialogue: 0,0:19:25.48,0:19:27.48,Default,,0,0,0,,Иә! Рұқсат па?
Dialogue: 0,0:19:27.48,0:19:30.48,Default,,0,0,0,,Ғарыш агенттігінің ережелері қатаң.
Dialogue: 0,0:19:30.48,0:19:34.49,Default,,0,0,0,,А, ол енді ғарыш агенттігінің мүшесі болды ма?
Dialogue: 0,0:19:34.49,0:19:37.48,Default,,0,0,0,,Жабдық ескі және стандартқа сай емес.
Dialogue: 0,0:19:37.48,0:19:40.48,Default,,0,0,0,,Мен оның ескі екенін білемін.
Dialogue: 0,0:19:40.48,0:19:43.48,Default,,0,0,0,,Өзгерту үшін ақша қажет.
Dialogue: 0,0:19:43.48,0:19:46.48,Default,,0,0,0,,Тергеуші қазір не үшін келді?
Dialogue: 0,0:19:46.48,0:19:48.49,Default,,0,0,0,,Бұл Галактиканың депозиті.
Dialogue: 0,0:19:48.49,0:19:50.49,Default,,0,0,0,,Галактика қонақ үйі?
Dialogue: 0,0:19:50.49,0:19:52.49,Default,,0,0,0,,Көршіңіз айтты.
Dialogue: 0,0:19:52.49,0:19:54.48,Default,,0,0,0,,Ол лас
Dialogue: 0,0:19:54.48,0:19:56.48,Default,,0,0,0,,Мен шағымдана алмаймын
Dialogue: 0,0:19:56.48,0:19:59.48,Default,,0,0,0,,Біздің жабдықтың ескіргеніне сенімдімін.
Dialogue: 0,0:19:59.48,0:20:01.48,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:20:01.48,0:20:04.49,Default,,0,0,0,,Айтпақшы, бұл не? сіздің тарихыңыз
Dialogue: 0,0:20:04.49,0:20:07.49,Default,,0,0,0,,Не? А, жоқ, олай емес.
Dialogue: 0,0:20:07.49,0:20:09.49,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:20:09.49,0:20:12.48,Default,,0,0,0,,Ах
Dialogue: 0,0:20:12.48,0:20:14.48,Default,,0,0,0,,О? Мистер Сканли қоңырау шалып жатыр.
Dialogue: 0,0:20:14.48,0:20:17.48,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:20:17.48,0:20:19.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:19.48,0:20:21.49,Default,,0,0,0,,Ваннада ыстық су жоқ.
Dialogue: 0,0:20:21.49,0:20:23.49,Default,,0,0,0,,Иә, кешіріңіз, қазір...
Dialogue: 0,0:20:23.49,0:20:26.49,Default,,0,0,0,,Ах
Dialogue: 0,0:20:26.49,0:20:29.48,Default,,0,0,0,,Жоқ... не болды? сол дене
Dialogue: 0,0:20:29.48,0:20:32.48,Default,,0,0,0,,Иә? А, бұл дене?
Dialogue: 0,0:20:32.48,0:20:34.48,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:20:34.48,0:20:36.48,Default,,0,0,0,,Қозғалтқыш екі рет жарылып, демонстрация үш рет шайқасты.
Dialogue: 0,0:20:36.48,0:20:40.49,Default,,0,0,0,,Бұл сізді метеоритпен соғып, магма жұтқанда болды.
Dialogue: 0,0:20:40.49,0:20:43.49,Default,,0,0,0,,Ұшқыштардың ішінде мен ғана аман қалдым.
Dialogue: 0,0:20:43.49,0:20:45.49,Default,,0,0,0,,Вахахахахахаха
Dialogue: 0,0:20:45.49,0:20:49.48,Default,,0,0,0,,Вахахахахахахахаха
Dialogue: 0,0:20:49.48,0:20:51.48,Default,,0,0,0,,Тс. Олардың қаншасы бар?
Dialogue: 0,0:20:51.48,0:20:53.48,Default,,0,0,0,,Бүгін таңертең, Жер уақыты бойынша таңғы 6-дан кейін.
Dialogue: 0,0:20:53.48,0:20:57.49,Default,,0,0,0,,Сириус жұлдызының жанында жоғалған зерттеу зымыраны жойылды.
Dialogue: 0,0:20:57.49,0:21:02.49,Default,,0,0,0,,Капитан мен барлық экипаж мүшелерінің қаза болуы қайғылы...
Dialogue: 0,0:21:41.48,0:21:44.49,Default,,0,0,0,,Жақсы қыз, тұрайық.
Dialogue: 0,0:21:44.49,0:21:47.49,Default,,0,0,0,,Уақыт таяп қалды. Орнымыздан тұрайық.
Dialogue: 0,0:21:47.49,0:21:49.49,Default,,0,0,0,,Иә
Dialogue: 0,0:21:49.49,0:21:52.49,Default,,0,0,0,,Иә? Эй! Міне, балам!
Dialogue: 0,0:21:52.49,0:21:56.48,Default,,0,0,0,,Оян! Оян, оян, оян
Dialogue: 0,0:21:56.48,0:22:00.48,Default,,0,0,0,,Оян, оян, оян, оян, оян
Dialogue: 0,0:22:00.48,0:22:05.48,Default,,0,0,0,,Ммм
Dialogue: 0,0:22:08.49,0:22:11.49,Default,,0,0,0,,Гах! Ауырады, ауырады, ауырады, ауырады
Dialogue: 0,0:22:17.49,0:22:19.49,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:22:19.49,0:22:21.49,Default,,0,0,0,,Қайырлы таң әке
Dialogue: 0,0:22:21.49,0:22:24.49,Default,,0,0,0,,Әлі ерте емес 21 Эмон
Dialogue: 0,0:22:24.49,0:22:26.49,Default,,0,0,0,,Сканли мырза кетіп қалды.
Dialogue: 0,0:22:26.49,0:22:28.50,Default,,0,0,0,,Не? Сіз әлдеқашан кеттіңіз бе?
Dialogue: 0,0:22:28.50,0:22:31.48,Default,,0,0,0,,Иә, сәлем айтыңыз.
Dialogue: 0,0:22:31.48,0:22:33.48,Default,,0,0,0,,Қызық, Гонскеге не болды?
Dialogue: 0,0:22:33.48,0:22:36.49,Default,,0,0,0,,Аа, мен біраздан бері дыбыстық сигналды басып жүрмін.
Dialogue: 0,0:22:36.49,0:22:39.49,Default,,0,0,0,,Ешқандай жауап жоқ.
Dialogue: 0,0:22:39.49,0:22:41.49,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:22:41.49,0:22:45.50,Default,,0,0,0,,А, Сасаяма планетасындағы қонақтарға таңғы ас әкеле аласыз ба?
Dialogue: 0,0:22:45.50,0:22:48.48,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:22:48.48,0:22:51.49,Default,,0,0,0,,Сіз? О, ауыр екен
Dialogue: 0,0:22:51.49,0:22:54.49,Default,,0,0,0,,Анашым, бұл қандай тағам?
Dialogue: 0,0:22:54.49,0:22:57.49,Default,,0,0,0,,Сынап сорпасында ауыр никель майына байланысты
Dialogue: 0,0:22:57.49,0:22:59.49,Default,,0,0,0,,Мыс табақ стейк
Dialogue: 0,0:22:59.49,0:23:01.50,Default,,0,0,0,,Бұл ауыр.
Dialogue: 0,0:23:01.50,0:23:04.50,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:23:07.48,0:23:12.49,Default,,0,0,0,,Иә
Dialogue: 0,0:23:12.49,0:23:15.49,Default,,0,0,0,,Кел, енді қиын болады.
Dialogue: 0,0:23:15.49,0:23:17.49,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:23:17.49,0:23:20.50,Default,,0,0,0,,Уау-
Dialogue: 0,0:23:20.50,0:23:26.49,Default,,0,0,0,,Уау, ғарыш агенттігі шағымдануы керек. Апыр-ай.
Dialogue: 0,0:23:26.49,0:23:29.49,Default,,0,0,0,,Мен саған таңғы ас әкелдім.
Dialogue: 0,0:23:29.49,0:23:31.49,Default,,0,0,0,,Ішке кіріңіз
Dialogue: 0,0:23:31.49,0:23:33.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:37.50,0:23:40.50,Default,,0,0,0,,Ұмытып қалдым, ішіндегі ауа қысымы басқа.
Dialogue: 0,0:23:43.49,0:23:47.49,Default,,0,0,0,,Ха, мен скафандрымды киюім керек.
Dialogue: 0,0:23:47.49,0:23:50.49,Default,,0,0,0,,Эй, мен оны жедім.
Dialogue: 0,0:23:50.49,0:23:52.50,Default,,0,0,0,,Тіс шұқығыш Курея
Dialogue: 0,0:23:52.50,0:23:54.50,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:23:54.50,0:23:56.48,Default,,0,0,0,,Жоғары марганецті болаттан жасалған тіс тазалағыш
Dialogue: 0,0:23:56.48,0:23:58.49,Default,,0,0,0,,Иә
Dialogue: 0,0:23:58.49,0:24:03.49,Default,,0,0,0,,Хмм, мен көмектесе алмаймын. Бұл шынымен қышиды. Бұл шынымен қышиды.
Dialogue: 0,0:24:03.49,0:24:05.49,Default,,0,0,0,,Төсекте қателер болды ма?
Dialogue: 0,0:24:05.49,0:24:09.50,Default,,0,0,0,,Жоқ, жоқ, денең тот басады.
Dialogue: 0,0:24:09.50,0:24:11.50,Default,,0,0,0,,Ах
Dialogue: 0,0:24:11.50,0:24:14.49,Default,,0,0,0,,Олай болса, сыртқа шығамыз ба?
Dialogue: 0,0:24:14.49,0:24:18.49,Default,,0,0,0,,А, мен жүктеріңді әкелейін.
Dialogue: 0,0:24:18.49,0:24:20.49,Default,,0,0,0,,Ах! Оған тиме!
Dialogue: 0,0:24:20.49,0:24:22.49,Default,,0,0,0,,Уау
Dialogue: 0,0:24:22.49,0:24:24.50,Default,,0,0,0,,Бұл сөмкеде маңызды нәрсе бар.
Dialogue: 0,0:24:24.50,0:24:27.50,Default,,0,0,0,,Түсіндім. Кешіріңіз.
Dialogue: 0,0:24:32.49,0:24:34.49,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:24:34.49,0:24:36.49,Default,,0,0,0,,Өтінемін, осы.
Dialogue: 0,0:24:36.49,0:24:39.49,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:24:39.49,0:24:41.50,Default,,0,0,0,,Не ол?
Dialogue: 0,0:24:41.50,0:24:44.50,Default,,0,0,0,,Эй, эй, бұл не? Не болып жатыр?
Dialogue: 0,0:24:44.50,0:24:46.50,Default,,0,0,0,,Бұл лифт.
Dialogue: 0,0:24:46.50,0:24:48.49,Default,,0,0,0,,Мен лифттерді де түсінемін.
Dialogue: 0,0:24:48.49,0:24:50.49,Default,,0,0,0,,Неліктен оны мінуге болмайды?
Dialogue: 0,0:24:50.49,0:24:53.49,Default,,0,0,0,,Мені ауылдан деп ойлап, мазақ қылдың ғой, солай ма?
Dialogue: 0,0:24:53.49,0:24:57.49,Default,,0,0,0,,Не? Бұл күлкілі. Негізі менің жағдайым сәл нашар.
Dialogue: 0,0:24:57.49,0:25:01.50,Default,,0,0,0,,Дайын болыңыз.
Dialogue: 0,0:25:01.50,0:25:06.49,Default,,0,0,0,,Ух... бұл Жердің элеваторы.
Dialogue: 0,0:25:06.49,0:25:11.49,Default,,0,0,0,,Сол үшін айтпадың ба?
Dialogue: 0,0:25:11.49,0:25:13.49,Default,,0,0,0,,Қалай болды? Тұтынушы
Dialogue: 0,0:25:13.49,0:25:15.50,Default,,0,0,0,,Аа, жақсы.
Dialogue: 0,0:25:15.50,0:25:17.50,Default,,0,0,0,,Оның несі жақсы болды?
Dialogue: 0,0:25:17.50,0:25:19.50,Default,,0,0,0,,Ал, қазіргі лифт
Dialogue: 0,0:25:19.50,0:25:21.49,Default,,0,0,0,,Маған массаж қызметі ұнады.
Dialogue: 0,0:25:21.49,0:25:24.49,Default,,0,0,0,,Сіздің арқаңызда менің денемдегі көптеген тот түсті.
Dialogue: 0,0:25:24.49,0:25:26.49,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:25:26.49,0:25:29.49,Default,,0,0,0,,Енді тұру ақысына тоқталайық.
Dialogue: 0,0:25:29.49,0:25:31.50,Default,,0,0,0,,А? тұру?
Dialogue: 0,0:25:31.50,0:25:33.50,Default,,0,0,0,,Иә? Не? Бұл дұрыс
Dialogue: 0,0:25:33.50,0:25:35.50,Default,,0,0,0,,Шот туралы не деуге болады?
Dialogue: 0,0:25:35.50,0:25:37.50,Default,,0,0,0,,Аа, маған мұндай нәрсе керек емес.
Dialogue: 0,0:25:37.50,0:25:40.49,Default,,0,0,0,,Жоқ, мен мынаны аламын.
Dialogue: 0,0:25:40.49,0:25:42.49,Default,,0,0,0,,Қый!
Dialogue: 0,0:25:42.49,0:25:44.49,Default,,0,0,0,,Бұл ақша.
Dialogue: 0,0:25:44.49,0:25:46.49,Default,,0,0,0,,Ақша? Қорқынышты нәрсе емес пе?
Dialogue: 0,0:25:46.49,0:25:48.50,Default,,0,0,0,,Мен өзімді әлсіз сезінемін.
Dialogue: 0,0:25:48.50,0:25:51.50,Default,,0,0,0,,Папа папа, қараңызшы.
Dialogue: 0,0:25:51.50,0:25:53.50,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:25:53.50,0:25:56.49,Default,,0,0,0,,Не? Сасаяма шетелдіктері ақша туралы білмей ме?
Dialogue: 0,0:25:56.49,0:25:58.49,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:25:58.49,0:26:00.49,Default,,0,0,0,,Маған бұл қонақүй ұнады.
Dialogue: 0,0:26:00.49,0:26:02.49,Default,,0,0,0,,Оланың ең маңыздысы
Dialogue: 0,0:26:02.49,0:26:04.50,Default,,0,0,0,,​​О?
Dialogue: 0,0:26:04.50,0:26:07.50,Default,,0,0,0,,Монгер!
Dialogue: 0,0:26:07.50,0:26:10.50,Default,,0,0,0,,Сіздің сүйкімді үй жануарыңыздың жағдайы жақсы деп үміттенемін.
Dialogue: 0,0:26:10.50,0:26:13.49,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:26:13.49,0:26:17.49,Default,,0,0,0,,Муимуимуи
Dialogue: 0,0:26:17.49,0:26:19.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:19.49,0:26:22.50,Default,,0,0,0,,Ах
Dialogue: 0,0:26:22.50,0:26:24.50,Default,,0,0,0,,Уха
Dialogue: 0,0:26:24.50,0:26:26.50,Default,,0,0,0,,Бұл қиын, ханым, Гонсуке - Гонсуке.
Dialogue: 0,0:26:26.50,0:26:28.50,Default,,0,0,0,,Не болды? Онабе
Dialogue: 0,0:26:28.50,0:26:30.49,Default,,0,0,0,,Ал, келіңдер.
Dialogue: 0,0:26:30.49,0:26:33.49,Default,,0,0,0,,Осы жолмен
Dialogue: 0,0:26:33.49,0:26:35.49,Default,,0,0,0,,(Шың) Мен… мен біттім. Мен аяқталдым.
Dialogue: 0,0:26:35.49,0:26:38.50,Default,,0,0,0,,Гонсуке бұл жерде біртүрлі әрекет етеді.
Dialogue: 0,0:26:38.50,0:26:41.50,Default,,0,0,0,,Бұл бөлме пайдаланылмайды, өйткені жаңбыр нашар ағып жатыр.
Dialogue: 0,0:26:41.50,0:26:43.50,Default,,0,0,0,,Гон…
Dialogue: 0,0:26:43.50,0:26:45.50,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:26:45.50,0:26:47.49,Default,,0,0,0,,Гонсуке, сен не істеп жүрсің?
Dialogue: 0,0:26:47.49,0:26:51.49,Default,,0,0,0,,Гонсуке, Гонсукені аш.
Dialogue: 0,0:26:51.49,0:26:54.50,Default,,0,0,0,,Сен оны құлыптадың, Гонсуке, аш.
Dialogue: 0,0:26:54.50,0:26:56.50,Default,,0,0,0,,Ішке қалай кіруге болады?
Dialogue: 0,0:26:56.50,0:26:58.50,Default,,0,0,0,,Монгер!
Dialogue: 0,0:26:58.50,0:27:00.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:00.50,0:27:02.50,Default,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:27:02.50,0:27:04.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:04.51,0:27:07.49,Default,,0,0,0,,Бұл не? Гонсуке!
Dialogue: 0,0:27:07.49,0:27:10.49,Default,,0,0,0,,Ола Бастапқыда оны картоп қазатын робот жасаған.
Dialogue: 0,0:27:10.49,0:27:13.50,Default,,0,0,0,,Мен картопты қазып алғым келеді.
Dialogue: 0,0:27:13.50,0:27:15.50,Default,,0,0,0,,Бұл сұмдық!
Dialogue: 0,0:27:15.50,0:27:18.50,Default,,0,0,0,,Бастапқы әдемі бөлмеге дереу оралыңыз.
Dialogue: 0,0:27:18.50,0:27:22.49,Default,,0,0,0,,Маған бәрібір сен оны пайдалансаң да, бұл жай ғана бөлме.
Dialogue: 0,0:27:22.49,0:27:25.49,Default,,0,0,0,,Қонақтар келгенде пайдаланыңыз!
Dialogue: 0,0:27:25.49,0:27:27.49,Default,,0,0,0,,Сонымен, сен мені кешіруді жоспарлап отырсың ба?
Dialogue: 0,0:27:27.49,0:27:29.50,Default,,0,0,0,,Әрине!
Dialogue: 0,0:27:29.50,0:27:31.50,Default,,0,0,0,,Әрине? Анықталған
Dialogue: 0,0:27:34.50,0:27:36.50,Default,,0,0,0,,Ах
Dialogue: 0,0:27:36.50,0:27:40.49,Default,,0,0,0,,Сен мені кешірмесең де, мен сені кешіремін.
Dialogue: 0,0:27:40.49,0:27:42.49,Default,,0,0,0,,Ах
Dialogue: 0,0:27:42.49,0:27:44.50,Default,,0,0,0,,Енді жұмысқа кірісу уақыты келді.
Dialogue: 0,0:27:44.50,0:27:46.50,Default,,0,0,0,,Монгер
Dialogue: 0,0:27:46.50,0:27:48.50,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:27:48.50,0:27:50.50,Default,,0,0,0,,Сізде бағытты сезінбейсіз бе?
Dialogue: 0,0:27:52.50,0:27:54.51,Default,,0,0,0,,Монгер!
Dialogue: 0,0:27:54.51,0:27:57.49,Default,,0,0,0,,Иә!
Dialogue: 0,0:27:57.49,0:28:00.49,Default,,0,0,0,,Сіз не істеп жатырсыз? Гонсуке
Dialogue: 0,0:28:00.49,0:28:03.50,Default,,0,0,0,,Менің көзім... аа...
Dialogue: 0,0:28:03.50,0:28:05.50,Default,,0,0,0,,Менің көзім айналады
Dialogue: 0,0:28:05.50,0:28:07.50,Default,,0,0,0,,Сіз мені алдамақшысыз ба?
Dialogue: 0,0:28:07.50,0:28:09.50,Default,,0,0,0,,Қауіпті, өтінемін
Dialogue: 0,0:28:09.50,0:28:11.51,Default,,0,0,0,,Уау! Жүгіріп кету!
Dialogue: 0,0:28:11.51,0:28:13.51,Default,,0,0,0,,Әй, мені мазақ ет
Dialogue: 0,0:28:13.51,0:28:15.49,Default,,0,0,0,,Монгер!
Dialogue: 0,0:28:15.49,0:28:18.50,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:28:18.50,0:28:20.50,Default,,0,0,0,,Уау
Dialogue: 0,0:28:20.50,0:28:22.50,Default,,0,0,0,,Ааа
Dialogue: 0,0:28:22.50,0:28:24.50,Default,,0,0,0,,Уау
Dialogue: 0,0:28:24.50,0:28:27.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:27.50,0:28:30.51,Default,,0,0,0,,Мен бұл не екенін білмеймін.
Dialogue: 0,0:28:30.51,0:28:32.49,Default,,0,0,0,,Хання?
Dialogue: 0,0:28:32.49,0:28:34.49,Default,,0,0,0,,Муи
Dialogue: 0,0:28:34.49,0:28:36.50,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,0:28:36.50,0:28:38.50,Default,,0,0,0,,Муи
Dialogue: 0,0:28:38.50,0:28:42.50,Default,,0,0,0,,Ракон ит? ит? О, екі жол да жақсы.
Dialogue: 0,0:28:42.50,0:28:45.51,Default,,0,0,0,,Муимуимуи
Dialogue: 0,0:28:45.51,0:28:49.49,Default,,0,0,0,,Бұл Оланың асыл өрісі, оған ешкім кіре алмайды.
Dialogue: 0,0:28:49.49,0:28:51.50,Default,,0,0,0,,Муи
Dialogue: 0,0:28:51.50,0:28:54.50,Default,,0,0,0,,Мені енді ешкім түсінбейді.
Dialogue: 0,0:28:54.50,0:28:56.50,Default,,0,0,0,,Толығырақ!
Dialogue: 0,0:28:56.50,0:28:59.50,Default,,0,0,0,,О! Қайдан кірдің?
Dialogue: 0,0:28:59.50,0:29:01.51,Default,,0,0,0,,Муи
Dialogue: 0,0:29:01.51,0:29:04.51,Default,,0,0,0,,Кешіріңіз бұл бейбақ... Монгер!
Dialogue: 0,0:29:04.51,0:29:06.51,Default,,0,0,0,,Сәлем! Дааа
Dialogue: 0,0:29:10.50,0:29:12.50,Default,,0,0,0,,Бірақ бұл жақсы орындалды.
Dialogue: 0,0:29:12.50,0:29:14.50,Default,,0,0,0,,Әке, бұл дәмді көрінеді.
Dialogue: 0,0:29:14.50,0:29:16.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:29:16.50,0:29:18.51,Default,,0,0,0,,Содан кейін оны қонақ бөлмесінде қалдырмай,
Dialogue: 0,0:29:18.51,0:29:21.51,Default,,0,0,0,,Картоп жасау ұтымдырақ па?
Dialogue: 0,0:29:21.51,0:29:23.49,Default,,0,0,0,,Сонымен
Dialogue: 0,0:29:23.49,0:29:26.50,Default,,0,0,0,,Енді сіз картоп жасауға жауаптысыз.
Dialogue: 0,0:29:26.50,0:29:28.50,Default,,0,0,0,,Ника
Dialogue: 0,0:29:28.50,0:29:31.50,Default,,0,0,0,,О! Оланың арманы орындалды
Dialogue: 0,0:29:31.50,0:29:33.50,Default,,0,0,0,,Сізге көп рахмет. Сізге көп рахмет.
Dialogue: 0,0:29:33.50,0:29:35.51,Default,,0,0,0,,Мистер Абдул: «Жекпе-жекті жалғыз жүргізбе» деді.
Dialogue: 0,0:29:35.51,0:29:37.51,Default,,0,0,0,,Мұндай шалқып жатқан шөлде мотоцикліммен келе жатқанда —
Dialogue: 0,0:29:37.51,0:29:40.49,Default,,0,0,0,,Айтпақшы, мәселе мына саудагерде.
Dialogue: 0,0:29:40.49,0:29:43.50,Default,,0,0,0,,Осыншама оғаш оқиғалардың болғанына сен кінәлі емессің бе?
Dialogue: 0,0:29:43.50,0:29:45.50,Default,,0,0,0,,Муимимимимимуи
Dialogue: 0,0:29:45.50,0:29:47.50,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды түсінбеймін.
Dialogue: 0,0:29:47.50,0:29:50.50,Default,,0,0,0,,Аа, дұрыс, Ямада мырзадан сұрайық.
Dialogue: 0,0:29:50.50,0:29:52.51,Default,,0,0,0,,Менің бөлмеме кел
Dialogue: 0,0:29:52.51,0:29:54.51,Default,,0,0,0,,Муи
Dialogue: 0,0:29:54.51,0:29:57.49,Default,,0,0,0,,Сіздің сұрағыңыз соңғы жылдары болмаған сирек оқиға.
Dialogue: 0,0:29:57.49,0:30:00.50,Default,,0,0,0,,Мен қуана түсіндіремін
Dialogue: 0,0:30:00.50,0:30:04.50,Default,,0,0,0,,Ондағы саудагерлер мүлдем тірі жаратылыстар.
Dialogue: 0,0:30:04.50,0:30:09.51,Default,,0,0,0,,Басқаша айтқанда, ондаған мың градус ыстықта да,
Dialogue: 0,0:30:09.51,0:30:13.51,Default,,0,0,0,,Абсолюттік нөлдік салқын әсер етпеген
Dialogue: 0,0:30:13.51,0:30:17.50,Default,,0,0,0,,Және не қаласаңыз, соны жеп, оны энергияға жұмсаңыз
Dialogue: 0,0:30:17.50,0:30:19.50,Default,,0,0,0,,Гаага Ват
Dialogue: 0,0:30:19.50,0:30:22.50,Default,,0,0,0,,Оның ерекше шеберлігі – ол кез келген жерді көре алады.
Dialogue: 0,0:30:22.50,0:30:25.51,Default,,0,0,0,,Телепортация
Dialogue: 0,0:30:25.51,0:30:27.51,Default,,0,0,0,,Телепортация?
Dialogue: 0,0:30:27.51,0:30:31.51,Default,,0,0,0,,Қош бол Сіз бірден басқа жерге ауыса аласыз
Dialogue: 0,0:30:31.51,0:30:35.50,Default,,0,0,0,,Дегенмен диапазон 3 км шегінде шектелген.
Dialogue: 0,0:30:35.50,0:30:37.50,Default,,0,0,0,,Жарайды, сондай жаратылыс.
Dialogue: 0,0:30:37.50,0:30:39.50,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:30:39.50,0:30:41.51,Default,,0,0,0,,Эй, солай ма?
Dialogue: 0,0:30:41.51,0:30:44.51,Default,,0,0,0,,О, сонымен қатар ол өте ақылды және сөйлей алады.
Dialogue: 0,0:30:44.51,0:30:47.51,Default,,0,0,0,,Бір күнде бір ғана сөз айта аласыз.
Dialogue: 0,0:30:47.51,0:30:49.50,Default,,0,0,0,,Бір сөз: Үндемейсің.
Dialogue: 0,0:30:49.50,0:30:51.50,Default,,0,0,0,,Мур
Dialogue: 0,0:30:51.50,0:30:53.50,Default,,0,0,0,,Мұғалім сізге көп рахмет.
Dialogue: 0,0:30:53.50,0:30:55.50,Default,,0,0,0,,Жарайды, мен анам мен әкеме хабарлаймын.
Dialogue: 0,0:30:55.50,0:30:57.50,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:30:57.50,0:31:00.51,Default,,0,0,0,,Эй Эмон, сен тағы не оқисың?
Dialogue: 0,0:31:00.51,0:31:03.51,Default,,0,0,0,,Папа Мама, мен Монгердің кім екенін білдім.
Dialogue: 0,0:31:03.51,0:31:05.51,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:31:05.51,0:31:07.50,Default,,0,0,0,,Жоқ, әйтеуір солай.
Dialogue: 0,0:31:07.50,0:31:09.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:09.50,0:31:13.50,Default,,0,0,0,,Жоқ, саған қарыз беретін ақшам болса.
Dialogue: 0,0:31:13.50,0:31:16.51,Default,,0,0,0,,Мен оны Галаксиге қарызға беремін және Цузуреяны жұмыстан шығарамын.
Dialogue: 0,0:31:16.51,0:31:18.51,Default,,0,0,0,,Сонымен... бұл ақылға қонымсыз.
Dialogue: 0,0:31:18.51,0:31:21.51,Default,,0,0,0,,Бұл әлдеқайда пайдалы болар еді хахахаха
Dialogue: 0,0:31:21.51,0:31:25.50,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын және бизнесте сәттілік тілеймін.
Dialogue: 0,0:31:25.50,0:31:27.50,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:31:27.50,0:31:30.50,Default,,0,0,0,,Бұл көп емес. Мен мұндай адамнан ешқашан қарызға ақша алмас едім.
Dialogue: 0,0:31:30.50,0:31:33.51,Default,,0,0,0,,Мен келісемін, бірақ жабдықты қарызбен жөндеуіміз керек.
Dialogue: 0,0:31:33.51,0:31:35.51,Default,,0,0,0,,Менің қонақ үй лицензиямнан айырылады.
Dialogue: 0,0:31:35.51,0:31:37.51,Default,,0,0,0,,Бұл орын алған соң, тым кеш
Dialogue: 0,0:31:48.51,0:31:52.51,Default,,0,0,0,,Күрсіну... Бұл да соңғы сурет пе?
Dialogue: 0,0:31:52.51,0:31:55.51,Default,,0,0,0,,Сіздің әкеңіз Токиодағы соңғы монша дүкенінен.
Dialogue: 0,0:31:55.51,0:31:57.51,Default,,0,0,0,,Бұл сіз сатып алған сурет емес пе?
Dialogue: 0,0:31:57.51,0:31:59.50,Default,,0,0,0,,Иә, бірақ қонақүйден шықсаңыз.
Dialogue: 0,0:31:59.50,0:32:03.50,Default,,0,0,0,,Оны көрсету үшін енді бос орын болмайды.
Dialogue: 0,0:32:03.50,0:32:06.51,Default,,0,0,0,,Сонымен, сіз өз шешіміңізді қабылдадыңыз ба?
Dialogue: 0,0:32:06.51,0:32:08.51,Default,,0,0,0,,Иә
Dialogue: 0,0:32:08.51,0:32:10.51,Default,,0,0,0,,Ата-бабаңды аяймын.
Dialogue: 0,0:32:10.51,0:32:13.51,Default,,0,0,0,,Менің атымнан гобелен цехы есігін жабады.
Dialogue: 0,0:32:13.51,0:32:15.50,Default,,0,0,0,,Минерва біз үшін осындай қауіпсіз орын дайындап қойған еді
Dialogue: 0,0:32:15.50,0:32:18.50,Default,,0,0,0,,Тұтынушылар санын көбейтудің жолы болса ғой
Dialogue: 0,0:32:18.50,0:32:21.51,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:32:21.51,0:32:23.51,Default,,0,0,0,,Муи... Тынш! сатушы
Dialogue: 0,0:32:23.51,0:32:25.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:25.51,0:32:27.51,Default,,0,0,0,,Иә? Эмон!
Dialogue: 0,0:32:27.51,0:32:29.51,Default,,0,0,0,,Сәлем әке, ана
Dialogue: 0,0:32:29.51,0:32:31.52,Default,,0,0,0,,Осы гобелен дүкенінің тұтынушылары көп болса жақсы емес пе?
Dialogue: 0,0:32:31.52,0:32:34.50,Default,,0,0,0,,Эмон, тыңдадың ба?
Dialogue: 0,0:32:34.50,0:32:36.50,Default,,0,0,0,,Эй, тұтынушылардың санын қалағанша көбейтуге болады.
Dialogue: 0,0:32:36.50,0:32:38.51,Default,,0,0,0,,Не?
Dialogue: 0,0:32:38.51,0:32:40.51,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:32:40.51,0:32:43.51,Default,,0,0,0,,Менде осы саудагер болғанша, мен бұл жерде жүрмін.
Dialogue: 0,0:32:43.51,0:32:47.51,Default,,0,0,0,,Түс сияқты не айтып тұрсың?
Dialogue: 0,0:32:47.51,0:32:49.52,Default,,0,0,0,,Мен ол келеді деп ойладым.
Dialogue: 0,0:32:49.52,0:32:51.50,Default,,0,0,0,,Амансың ба? сатушы
Dialogue: 0,0:32:51.50,0:32:53.50,Default,,0,0,0,,Әуежай арқылы қарап, тұтынушыны телепорттаңыз.
Dialogue: 0,0:32:53.50,0:32:55.51,Default,,0,0,0,,Муи
Dialogue: 0,0:32:55.51,0:32:58.51,Default,,0,0,0,,Монгер Мен оның мүмкіндігінше үлкен болғанын қалаймын.
Dialogue: 0,0:32:58.51,0:33:00.51,Default,,0,0,0,,Муи! Жарайды телепорт
Dialogue: 0,0:33:00.51,0:33:02.51,Default,,0,0,0,,Монгер! Апыр-ай!
Dialogue: 0,0:33:04.51,0:33:07.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:07.50,0:33:09.50,Default,,0,0,0,,Ой... тым үлкен, Муа
Dialogue: 0,0:33:11.51,0:33:13.51,Default,,0,0,0,,Жерге қош келдіңіз
Dialogue: 0,0:33:13.51,0:33:16.51,Default,,0,0,0,,Ханымдар мен мырзалар, Галактика қонақ үйі
Dialogue: 0,0:33:16.51,0:33:18.51,Default,,0,0,0,,Сізді алып кетуге арнайы автобус келді.
Dialogue: 0,0:33:18.51,0:33:22.52,Default,,0,0,0,,Қонақ үйге тікелей автобуспен барыңыз.
Dialogue: 0,0:33:22.52,0:33:24.52,Default,,0,0,0,,Ал, қайда кетті?
Dialogue: 0,0:33:26.50,0:33:28.51,Default,,0,0,0,,Иә, қош келдіңіз.
Dialogue: 0,0:33:28.51,0:33:30.51,Default,,0,0,0,,Е, 37-бөлмеге қарай.
Dialogue: 0,0:33:30.51,0:33:32.51,Default,,0,0,0,,Мына Джин не болып жатыр?
Dialogue: 0,0:33:32.51,0:33:35.51,Default,,0,0,0,,Бұл біздің қонақүйдің мақтан тұтатын телепорт қызметі.
Dialogue: 0,0:33:35.51,0:33:37.51,Default,,0,0,0,,Кешіріңіз. Кешіріңіз.
Dialogue: 0,0:33:37.51,0:33:39.52,Default,,0,0,0,,Ханым, енді бос бөлмелер жоқ.
Dialogue: 0,0:33:39.52,0:33:41.52,Default,,0,0,0,,Мовахаха…
Dialogue: 0,0:33:41.52,0:33:43.50,Default,,0,0,0,,Монгер, жетеді хахаха...
Dialogue: 0,0:33:43.50,0:33:45.50,Default,,0,0,0,,Монгер!
Dialogue: 0,0:33:48.51,0:33:51.51,Default,,0,0,0,,Не? Цузурея қонақ үйі өте гүлденген бе?
Dialogue: 0,0:33:51.51,0:33:54.51,Default,,0,0,0,,Иә, мұның бәрі Эмонның идеясы болған сияқты.
Dialogue: 0,0:33:54.51,0:33:56.52,Default,,0,0,0,,Хо
Dialogue: 0,0:33:56.52,0:33:59.50,Default,,0,0,0,,Гобелен цехының да жұмысы көп емес пе?
Dialogue: 0,0:33:59.50,0:34:01.50,Default,,0,0,0,,Сен де сабыр сақтай алмайсың.
Dialogue: 0,0:34:01.50,0:34:03.51,Default,,0,0,0,,Осыны ескере отырып, мен бүгін мектепке бардым.
Dialogue: 0,0:34:03.51,0:34:07.51,Default,,0,0,0,,Мен күн сайын қонақүйді басқару туралы лекция оқимын деп шештім, әке.
Dialogue: 0,0:34:07.51,0:34:11.51,Default,,0,0,0,,О, бұл сенімді.
Dialogue: 0,0:34:11.51,0:34:13.52,Default,,0,0,0,,Айтпақшы Луна
Dialogue: 0,0:34:13.52,0:34:15.52,Default,,0,0,0,,Бір күні сіз 21 Эмон боласыз.
Dialogue: 0,0:34:15.52,0:34:18.51,Default,,0,0,0,,Сіз ұшқыш болғыңыз келетінін айттыңыз, солай ма? белгілі
Dialogue: 0,0:34:18.51,0:34:20.51,Default,,0,0,0,,Иә, бұл неге?
Dialogue: 0,0:34:20.51,0:34:25.51,Default,,0,0,0,,Жоқ, жастардың армандағаны жақсы емес пе?
Dialogue: 0,0:34:25.51,0:34:29.52,Default,,0,0,0,,Армандарымызды орындауға көмектесіңізші.
Dialogue: 0,0:34:29.52,0:34:32.52,Default,,0,0,0,,Сіз өз күшіңізді қалай бересіз?
Dialogue: 0,0:34:32.52,0:34:34.50,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:34:34.50,0:34:37.51,Default,,0,0,0,,Эмон ұшқыш боламын ба, жоқ па деп ойлады.
Dialogue: 0,0:34:37.51,0:34:39.51,Default,,0,0,0,,Еш ойланбастан...
Dialogue: 0,0:34:39.51,0:34:41.51,Default,,0,0,0,,Ах! Түсіндім
Dialogue: 0,0:34:41.51,0:34:44.51,Default,,0,0,0,,Оған ұшқыш болуды айтыңыз және оған жарылыс беріңіз.
Dialogue: 0,0:34:44.51,0:34:46.51,Default,,0,0,0,,Олай болса, папа.
Dialogue: 0,0:34:50.52,0:34:54.51,Default,,0,0,0,,Хехе... Кешіріңіз, президент.
Dialogue: 0,0:34:54.51,0:34:56.51,Default,,0,0,0,,Мұрагер болмаса
Dialogue: 0,0:34:56.51,0:34:59.51,Default,,0,0,0,,20Эмон-сан да мотивациясын жоғалтады, солай ма?
Dialogue: 0,0:34:59.51,0:35:02.52,Default,,0,0,0,,Иә
Dialogue: 0,0:35:02.52,0:35:05.52,Default,,0,0,0,,Көршілер үшін де.
Dialogue: 0,0:35:05.52,0:35:07.52,Default,,0,0,0,,Муи?
Dialogue: 0,0:35:07.52,0:35:10.51,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл керемет пластикалық модель болар еді
Dialogue: 0,0:35:10.51,0:35:13.51,Default,,0,0,0,,Өмір өлшеміндегі классикалық биплан
Dialogue: 0,0:35:13.51,0:35:16.51,Default,,0,0,0,,Ол батареялармен жақсы ұшады.
Dialogue: 0,0:35:18.52,0:35:21.52,Default,,0,0,0,,Бәріне сәлем, қалдарыңыз қалай?
Dialogue: 0,0:35:21.52,0:35:24.52,Default,,0,0,0,,Бүгін де 3D теледидар арқылы сабақты қызықты өткізейік.
Dialogue: 0,0:35:24.52,0:35:27.51,Default,,0,0,0,,Сонымен бүгінгі оқулық...
Dialogue: 0,0:35:27.51,0:35:29.51,Default,,0,0,0,,Мұғалім, мен қазір аздап бос емеспін.
Dialogue: 0,0:35:29.51,0:35:31.51,Default,,0,0,0,,Дәріс бейнетаспаға түсіріледі.
Dialogue: 0,0:35:31.51,0:35:33.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:33.51,0:35:35.52,Default,,0,0,0,,Ке... Бұл шектен шыққан!
Dialogue: 0,0:35:35.52,0:35:37.52,Default,,0,0,0,,Эмон, тағы сен!
Dialogue: 0,0:35:39.52,0:35:41.52,Default,,0,0,0,,Уншо
Dialogue: 0,0:35:41.52,0:35:43.51,Default,,0,0,0,,Міне, орындалды.
Dialogue: 0,0:35:43.51,0:35:45.51,Default,,0,0,0,,Хе хе... Ммммм...
Dialogue: 0,0:35:45.51,0:35:47.51,Default,,0,0,0,,Ах! Мен оны қойдым
Dialogue: 0,0:35:50.51,0:35:52.52,Default,,0,0,0,,Есікті бұзбай көтере алмайсың.
Dialogue: 0,0:35:52.52,0:35:54.52,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:35:54.52,0:35:56.52,Default,,0,0,0,,Монгер!
Dialogue: 0,0:35:56.52,0:35:58.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:35:58.52,0:36:01.51,Default,,0,0,0,,Сіз өзіңіздің ыңғайлы екеніңізді білесіз бе?
Dialogue: 0,0:36:01.51,0:36:03.51,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:36:19.51,0:36:21.51,Default,,0,0,0,,Мууа...!
Dialogue: 0,0:36:21.51,0:36:24.51,Default,,0,0,0,,«Керемет» сияқты бірдеңе айта алмайсыз ба?
Dialogue: 0,0:36:26.52,0:36:28.52,Default,,0,0,0,,Бүгінгі сабақ әзірше
Dialogue: 0,0:36:28.52,0:36:33.52,Default,,0,0,0,,Ал, мырзалар, келесі жексенбіде мектепте кездесейік.
Dialogue: 0,0:36:33.52,0:36:35.51,Default,,0,0,0,,А, мен тоқтаймын.
Dialogue: 0,0:36:35.51,0:36:37.51,Default,,0,0,0,,Мектепке бару – қиыншылық.
Dialogue: 0,0:36:37.51,0:36:40.51,Default,,0,0,0,,Жексенбі ешқашан келмеуі керек
Dialogue: 0,0:36:40.51,0:36:43.52,Default,,0,0,0,,Эй, бұл Эмон.
Dialogue: 0,0:36:43.52,0:36:45.52,Default,,0,0,0,,Эмон-кун Эмон-кун, өтінемін.
Dialogue: 0,0:36:45.52,0:36:49.52,Default,,0,0,0,,О, Луна-чан, өтінемін.
Dialogue: 0,0:36:49.52,0:36:52.51,Default,,0,0,0,,Мен қазір сені бөлмемнен бақылап тұрмын
Dialogue: 0,0:36:52.51,0:36:54.51,Default,,0,0,0,,Керемет ұшқыш.
Dialogue: 0,0:36:54.51,0:36:57.51,Default,,0,0,0,,Мен ғарышқа ұшқым келетін сезімді толық түсінемін.
Dialogue: 0,0:36:57.51,0:36:59.52,Default,,0,0,0,,Бұл.
Dialogue: 0,0:36:59.52,0:37:03.52,Default,,0,0,0,,Өйткені, мен гобелен цехын өз қолыма алғым келеді.
Dialogue: 0,0:37:03.52,0:37:05.52,Default,,0,0,0,,Жарайды, бұл ысырап
Dialogue: 0,0:37:05.52,0:37:09.51,Default,,0,0,0,,Бұл ұшқыштық шеберліктің шіріп кетуіне жол беру адамзат үшін шығын болар еді.
Dialogue: 0,0:37:09.51,0:37:11.51,Default,,0,0,0,,Мен сондай жақсымын ба?
Dialogue: 0,0:37:11.51,0:37:13.51,Default,,0,0,0,,Әрине, Эмон-кун.
Dialogue: 0,0:37:13.51,0:37:15.52,Default,,0,0,0,,Маған сәл сальто жасап көрейін.
Dialogue: 0,0:37:15.52,0:37:17.52,Default,,0,0,0,,Жақсы, міне келдік!
Dialogue: 0,0:37:20.52,0:37:22.52,Default,,0,0,0,,Уау, керемет!
Dialogue: 0,0:37:22.52,0:37:24.52,Default,,0,0,0,,Енді жапырақтарды түсіріңіз
Dialogue: 0,0:37:24.52,0:37:26.52,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:37:32.52,0:37:34.52,Default,,0,0,0,,Мууа...!
Dialogue: 0,0:37:34.52,0:37:36.52,Default,,0,0,0,,Монгер Бұл әлі де керемет деп ойламайсыз ба?
Dialogue: 0,0:37:39.52,0:37:41.52,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл таңқаларлық емес пе?
Dialogue: 0,0:37:41.52,0:37:44.51,Default,,0,0,0,,Құйрықсыз ұша аласыз!
Dialogue: 0,0:37:44.51,0:37:46.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:46.51,0:37:48.51,Default,,0,0,0,,Ах! Жабысқақ қабығы кетіп қалды.
Dialogue: 0,0:37:51.52,0:37:53.52,Default,,0,0,0,,Уау! Мваа…
Dialogue: 0,0:37:53.52,0:37:55.52,Default,,0,0,0,,О, маған көмектес!
Dialogue: 0,0:37:58.53,0:38:00.53,Default,,0,0,0,,Монгер! иә?
Dialogue: 0,0:38:00.53,0:38:03.51,Default,,0,0,0,,Фугия... Муа
Dialogue: 0,0:38:03.51,0:38:05.51,Default,,0,0,0,,Рахмет, бұл пайдалы болды.
Dialogue: 0,0:38:08.52,0:38:10.52,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:38:15.53,0:38:17.53,Default,,0,0,0,,Мен мұны мақтау ретінде айтып отырған жоқпын.
Dialogue: 0,0:38:17.53,0:38:20.51,Default,,0,0,0,,Эмонның техникасы, батылдығы және шытырман рухы
Dialogue: 0,0:38:20.51,0:38:23.52,Default,,0,0,0,,Іс бұрынғыдай жалғаса берсе, бұл босқа кетеді деп ойлаймын.
Dialogue: 0,0:38:23.52,0:38:26.52,Default,,0,0,0,,Иә... Мені көп мақтағаныңызға ризамын.
Dialogue: 0,0:38:26.52,0:38:28.52,Default,,0,0,0,,Расында, Эмон-кун.
Dialogue: 0,0:38:28.52,0:38:31.52,Default,,0,0,0,,Мен сенің маған жақсы қарсылас болғаныңды қалаймын.
Dialogue: 0,0:38:31.52,0:38:33.53,Default,,0,0,0,,Қарсылас?
Dialogue: 0,0:38:33.53,0:38:35.51,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:38:35.51,0:38:37.51,Default,,0,0,0,,Мен Галактика қонақ үйінің келесі президентімін.
Dialogue: 0,0:38:37.51,0:38:39.52,Default,,0,0,0,,Президент?
Dialogue: 0,0:38:39.52,0:38:42.52,Default,,0,0,0,,Егер бұл орын алса, оны одан да үлкейтіңіз.
Dialogue: 0,0:38:42.52,0:38:45.52,Default,,0,0,0,,Мен басқа планеталарда да көбірек филиалдар ашуды жоспарлап отырмын.
Dialogue: 0,0:38:45.52,0:38:47.52,Default,,0,0,0,,Эй, бұл қатты.
Dialogue: 0,0:38:47.52,0:38:49.52,Default,,0,0,0,,Мууа
Dialogue: 0,0:38:55.52,0:38:57.52,Default,,0,0,0,,Әй, күнде ғарыштан
Dialogue: 0,0:38:57.52,0:38:59.52,Default,,0,0,0,,Тұтынушылар көп.
Dialogue: 0,0:38:59.52,0:39:03.52,Default,,0,0,0,,Қонақ үйлер – Жер мен ғарыш арасындағы терезе.
Dialogue: 0,0:39:03.52,0:39:05.53,Default,,0,0,0,,Цузурея мен Галактиканың қосылуы
Dialogue: 0,0:39:05.53,0:39:08.53,Default,,0,0,0,,Бұл Орион қонақүйінен үлкен қонақүй болады.
Dialogue: 0,0:39:11.51,0:39:13.51,Default,,0,0,0,,Біріктіру...
Dialogue: 0,0:39:16.52,0:39:19.52,Default,,0,0,0,,Галактикамен қосылу әзіл емес.
Dialogue: 0,0:39:22.53,0:39:24.53,Default,,0,0,0,,Не? Тойлап жатқандай
Dialogue: 0,0:39:41.53,0:39:43.53,Default,,0,0,0,,Полковник Марс.
Dialogue: 0,0:39:43.53,0:39:45.52,Default,,0,0,0,,Сол атақты ғарыш ұшқышы.
Dialogue: 0,0:39:45.52,0:39:47.52,Default,,0,0,0,,Теледидарда пайда болды
Dialogue: 0,0:39:47.52,0:39:49.52,Default,,0,0,0,,Полковник бүгін Магеллан тұманынан қайтып келеді.
Dialogue: 0,0:40:01.53,0:40:03.53,Default,,0,0,0,,Полковник Марс...
Dialogue: 0,0:40:09.52,0:40:12.53,Default,,0,0,0,,Жасайық! Мен міндетті түрде ғарыш ұшқышы боламын.
Dialogue: 0,0:40:12.53,0:40:14.53,Default,,0,0,0,,Бұл сенің рухың, Эмон-кун.
Dialogue: 0,0:40:14.53,0:40:16.53,Default,,0,0,0,,Мен сендей болмасам да қолдаймын.
Dialogue: 0,0:40:16.53,0:40:18.53,Default,,0,0,0,,Иә, Луна-чанға рахмет
Dialogue: 0,0:40:18.53,0:40:20.52,Default,,0,0,0,,Қалай болғанда да, полковник Марс
Dialogue: 0,0:40:20.52,0:40:23.52,Default,,0,0,0,,Неге бас киіміңді шешпедің?
Dialogue: 0,0:40:23.52,0:40:25.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:25.52,0:40:27.52,Default,,0,0,0,,Сіз ұялшақ адамсыз, мен сенімдімін.
Dialogue: 0,0:40:33.53,0:40:35.53,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:40:35.53,0:40:39.53,Default,,0,0,0,,Адамдармен жұмыс істеу үдеуден немесе атмосфералық қысымнан гөрі шаршатады.
Dialogue: 0,0:40:45.53,0:40:48.53,Default,,0,0,0,,Мен анам мен әкемді сендіру үшін қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:40:48.53,0:40:50.53,Default,,0,0,0,,Ғарышқа ұшу
Dialogue: 0,0:40:53.52,0:40:55.52,Default,,0,0,0,,Мугю!
Dialogue: 0,0:40:55.52,0:40:57.52,Default,,0,0,0,,Ау, ауырып тұр...
Dialogue: 0,0:40:57.52,0:41:00.52,Default,,0,0,0,,Мен бұл күндері автоматты емес есіктерге мән бермеймін.
Dialogue: 0,0:41:00.52,0:41:02.53,Default,,0,0,0,,Маған бұл қонақүй ұнады, иә?
Dialogue: 0,0:41:02.53,0:41:04.53,Default,,0,0,0,,Өте жақсы көрінеді
Dialogue: 0,0:41:04.53,0:41:06.53,Default,,0,0,0,,Айтпадың ғой, солай ма?
Dialogue: 0,0:41:06.53,0:41:08.53,Default,,0,0,0,,Мен бүгінге дейін сөйлестім.
Dialogue: 0,0:41:08.53,0:41:11.52,Default,,0,0,0,,Мен түнеймін, мені алып кетіңдер.
Dialogue: 0,0:41:11.52,0:41:13.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:13.52,0:41:15.52,Default,,0,0,0,,Неге мені ерте алып кетпейсің? Иә? Анашым!
Dialogue: 0,0:41:15.52,0:41:18.52,Default,,0,0,0,,Сіз кенеттен не айтып тұрсыз? анам
Dialogue: 0,0:41:18.52,0:41:22.52,Default,,0,0,0,,Ш... Менің айтайын дегенім жоқ. Менің аузым өздігінен қозғалады.
Dialogue: 0,0:41:24.53,0:41:26.53,Default,,0,0,0,,Муимуи...
Dialogue: 0,0:41:26.53,0:41:28.52,Default,,0,0,0,,Монгер!
Dialogue: 0,0:41:28.52,0:41:30.52,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:41:30.52,0:41:32.52,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:41:32.52,0:41:35.53,Default,,0,0,0,,Монгер, сен неліктен бұл өсіретін өсімдікті телепорттадың?
Dialogue: 0,0:41:35.53,0:41:38.53,Default,,0,0,0,,Ақымақ болып көрме, бөлмеңді көрсет.
Dialogue: 0,0:41:38.53,0:41:40.53,Default,,0,0,0,,Сөйлеу қандай тапқыр.
Dialogue: 0,0:41:40.53,0:41:43.53,Default,,0,0,0,,Аузыңды жап! Сіз мені қандай деп ойлайсыз?
Dialogue: 0,0:41:43.53,0:41:45.52,Default,,0,0,0,,Уау... Әке
Dialogue: 0,0:41:45.52,0:41:48.52,Default,,0,0,0,,Не болды?
Dialogue: 0,0:41:48.52,0:41:50.52,Default,,0,0,0,,Ал, әке! Жақсы жұмыс
Dialogue: 0,0:41:50.52,0:41:53.53,Default,,0,0,0,,Әй... Әке! Қайда бара жатырсың?
Dialogue: 0,0:41:53.53,0:41:56.53,Default,,0,0,0,,Түсінбедім, аяқ-қолым өздігінен қозғалады.
Dialogue: 0,0:41:56.53,0:41:58.53,Default,,0,0,0,,О, күте тұрыңыз.
Dialogue: 0,0:41:58.53,0:42:00.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:00.53,0:42:02.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:42:05.52,0:42:07.52,Default,,0,0,0,,Не? Әй
Dialogue: 0,0:42:07.52,0:42:09.53,Default,,0,0,0,,Бұл не... лифт?
Dialogue: 0,0:42:09.53,0:42:11.53,Default,,0,0,0,,Сіз мүлде қозғалмайсыз деп ойлаймын.
Dialogue: 0,0:42:11.53,0:42:13.53,Default,,0,0,0,,Бұл туралы әкем жақсы біледі.
Dialogue: 0,0:42:13.53,0:42:15.53,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:42:15.53,0:42:17.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:17.53,0:42:19.54,Default,,0,0,0,,Хахаха... Әй, бұл әке!
Dialogue: 0,0:42:19.54,0:42:22.54,Default,,0,0,0,,Оттотто…
Dialogue: 0,0:42:24.52,0:42:26.53,Default,,0,0,0,,Доккоишотто Хух…
Dialogue: 0,0:42:26.53,0:42:29.53,Default,,0,0,0,,Міне! Оны дөрекі қоймаңыз!
Dialogue: 0,0:42:29.53,0:42:31.53,Default,,0,0,0,,Конняро Бұл жігіт...
Dialogue: 0,0:42:31.53,0:42:33.53,Default,,0,0,0,,Ал...
Dialogue: 0,0:42:33.53,0:42:36.54,Default,,0,0,0,,Ой! Мен не істеп жатырмын, өзімді ұрып жатырмын ба?
Dialogue: 0,0:42:36.54,0:42:38.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:42:38.52,0:42:40.52,Default,,0,0,0,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:42:40.52,0:42:42.53,Default,,0,0,0,,Бұл табиғаттан тыс күштері бар өсімдік болуы мүмкін.
Dialogue: 0,0:42:42.53,0:42:44.53,Default,,0,0,0,,Айтып қояйын, жігіттер — дереу сол иттен алыстаңдар.
Dialogue: 0,0:42:44.53,0:42:46.53,Default,,0,0,0,,Қуыршақ ойнаған кезде
Dialogue: 0,0:42:46.53,0:42:48.53,Default,,0,0,0,,Ол бізді басқарады.
Dialogue: 0,0:42:48.53,0:42:51.53,Default,,0,0,0,,Мен бұл туралы мистер Сканлиден сұрадым.
Dialogue: 0,0:42:51.53,0:42:56.52,Default,,0,0,0,,Мангадағы өсімдіктерге ұқсайтын өсімдіктер бар ма? Хахаха...
Dialogue: 0,0:42:56.52,0:42:59.53,Default,,0,0,0,,Мен ғарышта қалқып жүрген қалқып тұрған ағашпын
Dialogue: 0,0:42:59.53,0:43:01.53,Default,,0,0,0,,Сәлем, сау бол
Dialogue: 0,0:43:01.53,0:43:05.53,Default,,0,0,0,,Қараңғы дүниеден жалығып, мына ғаламшарды аралауға келдім.
Dialogue: 0,0:43:05.53,0:43:08.53,Default,,0,0,0,,Бұл жақсы нәрсе.
Dialogue: 0,0:43:08.53,0:43:12.52,Default,,0,0,0,,Оңаша сөйлескенде таң қаламын.
Dialogue: 0,0:43:12.52,0:43:14.52,Default,,0,0,0,,Сіз роботтарды басқара аласыз ба?
Dialogue: 0,0:43:14.52,0:43:16.53,Default,,0,0,0,,Өкінішке орай, тек тірі организмдер
Dialogue: 0,0:43:16.53,0:43:19.53,Default,,0,0,0,,Балалар, бір-бірлеріңе еш қатысың жоқ.
Dialogue: 0,0:43:19.53,0:43:21.53,Default,,0,0,0,,Олай болса мен картоп қазып жатырмын.
Dialogue: 0,0:43:21.53,0:43:23.53,Default,,0,0,0,,Мен де барамын хаха...
Dialogue: 0,0:43:23.53,0:43:25.54,Default,,0,0,0,,Онабе Гонсуке, бұл сіздің тұтынушыңыз.
Dialogue: 0,0:43:25.54,0:43:27.54,Default,,0,0,0,,Қызметті өзіңіз ғана көрсете аласыз.
Dialogue: 0,0:43:27.54,0:43:29.52,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:43:29.52,0:43:31.52,Default,,0,0,0,,Бұл сіз туралы!
Dialogue: 0,0:43:31.52,0:43:33.53,Default,,0,0,0,,Энякола
Dialogue: 0,0:43:33.53,0:43:36.53,Default,,0,0,0,,Адамдар аянышты екен, келіңдер.
Dialogue: 0,0:43:38.53,0:43:41.53,Default,,0,0,0,,Мен робот болғанымызға қуаныштымын.
Dialogue: 0,0:43:43.54,0:43:46.52,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:43:46.52,0:43:49.53,Default,,0,0,0,,А, серуендеу жақсы сезінеді.
Dialogue: 0,0:43:49.53,0:43:51.53,Default,,0,0,0,,Бұл ауыр. Шағымдамаңыз!
Dialogue: 0,0:43:51.53,0:43:53.53,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:43:53.53,0:43:55.53,Default,,0,0,0,,О, бұл өте жақсы бақ.
Dialogue: 0,0:43:55.53,0:43:58.53,Default,,0,0,0,,Мынау көрші Галактика қонақ үйі.
Dialogue: 0,0:43:58.53,0:44:00.54,Default,,0,0,0,,А, бұл Эмон.
Dialogue: 0,0:44:00.54,0:44:02.54,Default,,0,0,0,,Эмон-кун
Dialogue: 0,0:44:04.52,0:44:06.53,Default,,0,0,0,,Бұл дұрыс болды.
Dialogue: 0,0:44:06.53,0:44:09.53,Default,,0,0,0,,Мен, әкем екеуміз Күн жүйесіне саяхатқа шығамыз.
Dialogue: 0,0:44:09.53,0:44:11.53,Default,,0,0,0,,Әкем Эмонды да шақыруымды өтінді.
Dialogue: 0,0:44:11.53,0:44:13.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:44:13.53,0:44:15.54,Default,,0,0,0,,Мені саяхатқа апарасың ба?
Dialogue: 0,0:44:15.54,0:44:17.54,Default,,0,0,0,,Сіз ғарыш ұшқышы болғыңыз келеді, солай ма?
Dialogue: 0,0:44:17.54,0:44:19.54,Default,,0,0,0,,Бірінші қадам – ғарышқа саяхат.
Dialogue: 0,0:44:19.54,0:44:22.53,Default,,0,0,0,,Луна-чан дұрыс айтады. Өтінемін, мені өзіңізбен бірге алыңыз.
Dialogue: 0,0:44:22.53,0:44:25.53,Default,,0,0,0,,Бұл адам кім? Жерден келген әйел ме?
Dialogue: 0,0:44:25.53,0:44:27.53,Default,,0,0,0,,Жақсы! Не?
Dialogue: 0,0:44:27.53,0:44:30.53,Default,,0,0,0,,Жоқ, бұл қыз. Ол әдемі емес пе?
Dialogue: 0,0:44:30.53,0:44:33.54,Default,,0,0,0,,Сіз осындай әдемі әйелді айтасыз ба?
Dialogue: 0,0:44:33.54,0:44:35.54,Default,,0,0,0,,Жоқ... мұның себебі бар.
Dialogue: 0,0:44:35.54,0:44:39.53,Default,,0,0,0,,Мен білмеймін! Неге, мен арқамда лас ағашты көтеріп жүрмін
Dialogue: 0,0:44:39.53,0:44:41.53,Default,,0,0,0,,Ол ағашты қайдан алдың?
Dialogue: 0,0:44:41.53,0:44:43.53,Default,,0,0,0,,А...? Кя!
Dialogue: 0,0:44:43.53,0:44:46.53,Default,,0,0,0,,Ой, мен жасадым, қарашы.
Dialogue: 0,0:44:46.53,0:44:48.53,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:44:48.53,0:44:50.54,Default,,0,0,0,,Не болды? Луна
Dialogue: 0,0:44:50.54,0:44:52.54,Default,,0,0,0,,Мен саған ешқашан қамқорлық жасамаймын, Эмон.
Dialogue: 0,0:44:52.54,0:44:55.53,Default,,0,0,0,,Сізді ғарыш сапарына кім шақырады?
Dialogue: 0,0:44:55.53,0:44:58.53,Default,,0,0,0,,Енді мен бұл туралы бірдеңе істеуім керек.
Dialogue: 0,0:45:00.53,0:45:02.53,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:45:02.53,0:45:04.53,Default,,0,0,0,,Таң атады ма?
Dialogue: 0,0:45:04.53,0:45:06.54,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:45:06.54,0:45:08.54,Default,,0,0,0,,Таң атқанша әлі біраз уақыт бар.
Dialogue: 0,0:45:08.54,0:45:11.54,Default,,0,0,0,,Ал, енді маған биіңді көрсет.
Dialogue: 0,0:45:11.54,0:45:14.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:14.53,0:45:17.53,Default,,0,0,0,,Маған көмектес, жоқ, ха...
Dialogue: 0,0:45:17.53,0:45:21.53,Default,,0,0,0,,Қыңырмаңыз, жақында бәрі келеді.
Dialogue: 0,0:45:21.53,0:45:23.54,Default,,0,0,0,,Хаа...
Dialogue: 0,0:45:23.54,0:45:25.54,Default,,0,0,0,,Жоқ... не істеуіміз керек? Эй, эй...
Dialogue: 0,0:45:25.54,0:45:28.54,Default,,0,0,0,,Хахахаха, бұл өте керемет.
Dialogue: 0,0:45:28.54,0:45:31.53,Default,,0,0,0,,Бұл таңды күту сәті
Dialogue: 0,0:45:31.53,0:45:35.53,Default,,0,0,0,,Туған жерімді ойласам, мәңгілік түнекке толған ғалам
Dialogue: 0,0:45:35.53,0:45:39.54,Default,,0,0,0,,Жерде туылғаныңа шүкіршілік ету керек.
Dialogue: 0,0:45:39.54,0:45:41.54,Default,,0,0,0,,Өйткені бұл дүниеде
Dialogue: 0,0:45:41.54,0:45:43.54,Default,,0,0,0,,Өйткені таң бар
Dialogue: 0,0:45:43.54,0:45:46.54,Default,,0,0,0,,Бітпейтін түн болмайды
Dialogue: 0,0:45:57.54,0:45:59.54,Default,,0,0,0,,Өл… жоқ, әйелім мен арбашы қазірдің өзінде қайтыс болды.
Dialogue: 0,0:46:07.53,0:46:09.53,Default,,0,0,0,,Таң болды
Dialogue: 0,0:46:16.54,0:46:18.54,Default,,0,0,0,,Түсіндім, бүгін таң.
Dialogue: 0,0:46:18.54,0:46:21.54,Default,,0,0,0,,Мен мұны көргім келді
Dialogue: 0,0:46:44.53,0:46:46.54,Default,,0,0,0,,Барлық көмектеріңіз үшін рахмет.
Dialogue: 0,0:46:46.54,0:46:49.54,Default,,0,0,0,,Мен ғарышқа қайта ораламын
Dialogue: 0,0:46:49.54,0:46:51.54,Default,,0,0,0,,Бұл жай ғана рахмет.
Dialogue: 0,0:46:57.53,0:46:59.53,Default,,0,0,0,,Ах... уау...
Dialogue: 0,0:47:01.53,0:47:03.54,Default,,0,0,0,,Ой, бұл қиын...
Dialogue: 0,0:47:03.54,0:47:05.54,Default,,0,0,0,,Бұл таңғажайып рубин
Dialogue: 0,0:47:05.54,0:47:07.54,Default,,0,0,0,,Бұл... Әрқашан қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:47:07.54,0:47:11.54,Default,,0,0,0,,Олай болса, сені ғарыш әуежайына апарайық.
Dialogue: 0,0:47:11.54,0:47:14.53,Default,,0,0,0,,Бұл шатыр жақсы.
Dialogue: 0,0:47:14.53,0:47:16.53,Default,,0,0,0,,Муи?
Dialogue: 0,0:47:27.54,0:47:29.54,Default,,0,0,0,,Ах... уау...
Dialogue: 0,0:47:44.54,0:47:47.54,Default,,0,0,0,,Ааа... керемет...
Dialogue: 0,0:47:54.54,0:47:57.54,Default,,0,0,0,,Бәріңе сау болыңдар
Dialogue: 0,0:48:10.54,0:48:12.54,Default,,0,0,0,,Уау! Ааа?
Dialogue: 0,0:48:12.54,0:48:14.54,Default,,0,0,0,,А? Муи?
Dialogue: 0,0:48:27.54,0:48:30.54,Default,,0,0,0,,Қазір демалуға болатын сияқты.
Dialogue: 0,0:48:30.54,0:48:32.54,Default,,0,0,0,,Әзірге сақтықты төмендетпеңіз.
Dialogue: 0,0:48:32.54,0:48:34.54,Default,,0,0,0,,Бухгалтерлік кітаптарды жүргізіңіз
Dialogue: 0,0:48:34.54,0:48:36.55,Default,,0,0,0,,Әке иә?
Dialogue: 0,0:48:36.55,0:48:38.55,Default,,0,0,0,,Компьютер дайын.
Dialogue: 0,0:48:38.55,0:48:41.53,Default,,0,0,0,,Осындай нәрсені пайдалану үшін ақша керек.
Dialogue: 0,0:48:41.53,0:48:43.54,Default,,0,0,0,,Осыны орындайық
Dialogue: 0,0:48:43.54,0:48:45.54,Default,,0,0,0,,Иә, мені кешіріңіз...
Dialogue: 0,0:48:45.54,0:48:47.54,Default,,0,0,0,,Бұл өте өкінішті
Dialogue: 0,0:48:47.54,0:48:49.54,Default,,0,0,0,,Ұшқыш болу үшін ақша керек.
Dialogue: 0,0:48:49.54,0:48:51.54,Default,,0,0,0,,Ғарышқа саяхат жасау оңай емес.
Dialogue: 0,0:48:51.54,0:48:54.55,Default,,0,0,0,,Ах! Жақында біреу мені ғарышқа сапарға шақырды.
Dialogue: 0,0:48:54.55,0:48:57.55,Default,,0,0,0,,Уау! Қарғыс атсын, Луна!
Dialogue: 0,0:48:57.55,0:48:59.55,Default,,0,0,0,,Мугю…
Dialogue: 0,0:49:02.54,0:49:06.54,Default,,0,0,0,,Монгер, ғарыш әуежайына телепорт, өтінемін.
Dialogue: 0,0:49:06.54,0:49:08.54,Default,,0,0,0,,Монгер!
Dialogue: 0,0:49:20.54,0:49:23.54,Default,,0,0,0,,Галактика баяғыда жойылып кеткен.
Dialogue: 0,0:49:23.54,0:49:25.54,Default,,0,0,0,,Муи…
Dialogue: 0,0:49:33.54,0:49:35.54,Default,,0,0,0,,Ақымақ Эмон-кун
Dialogue: 0,0:49:35.54,0:49:37.54,Default,,0,0,0,,Мен сізді шақыруға қиналсам да.
Dialogue: 0,0:49:45.55,0:49:47.55,Default,,0,0,0,,Бұл не бәрі, не ештеңе, әке.
Dialogue: 0,0:49:47.55,0:49:49.54,Default,,0,0,0,,Әке, сенің қалтаң маған тағы бір жыл керек емес, мені сапарға шығарып салшы.
Dialogue: 0,0:49:49.54,0:49:51.54,Default,,0,0,0,,Муи... Иә, солай.
Dialogue: 0,0:49:51.54,0:49:53.54,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:49:53.54,0:49:55.54,Default,,0,0,0,,Тынш! Әке, мен шаршадым.
Dialogue: 0,0:49:55.54,0:49:57.54,Default,,0,0,0,,Оны жайына қалдырайық.
Dialogue: 0,0:50:03.55,0:50:05.55,Default,,0,0,0,,Мен ғарышқа саяхатқа шыққым келеді.
Dialogue: 0,0:50:05.55,0:50:07.55,Default,,0,0,0,,21 Эмон... Иә!
Dialogue: 0,0:50:09.54,0:50:12.54,Default,,0,0,0,,Монгер... Муки!
Dialogue: 0,0:50:12.54,0:50:15.54,Default,,0,0,0,,Цузуреяға көмектескеніңіз үшін рахмет.
Dialogue: 0,0:50:15.54,0:50:17.55,Default,,0,0,0,,Не, ұйықтап жатып сөйлеп тұрсың ба?
Dialogue: 0,0:50:17.55,0:50:20.55,Default,,0,0,0,,Екеуіңнен менің артымнан жүрулеріңді сұраймын.
Dialogue: 0,0:50:20.55,0:50:22.55,Default,,0,0,0,,А... Маған бұны істеуді тапсырды.
Dialogue: 0,0:50:22.55,0:50:24.55,Default,,0,0,0,,Мухи
Dialogue: 0,0:50:30.54,0:50:32.55,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:50:32.55,0:50:34.55,Default,,0,0,0,,Сіз ғалам туралы бірдеңе білесіз бе?
Dialogue: 0,0:50:40.55,0:50:42.55,Default,,0,0,0,,Муи жұлдыздары туралы жеткілікті
Dialogue: 0,0:50:46.54,0:50:48.54,Default,,0,0,0,,Тоқта! Муки!
Dialogue: 0,0:50:50.55,0:50:52.55,Default,,0,0,0,,Келіңіздер! сатушы
Dialogue: 0,0:50:52.55,0:50:54.55,Default,,0,0,0,,Өтірікші!
Dialogue: 0,0:50:54.55,0:50:57.55,Default,,0,0,0,,Ғарыш ұшқышы болғым келсе де!
Dialogue: 0,0:50:57.55,0:51:00.54,Default,,0,0,0,,Иә? Осымен бүгінгі сұхбатымыз аяқталды.
Dialogue: 0,0:51:00.54,0:51:03.54,Default,,0,0,0,,Өзіңді мәжбүрлеме, Монгер.
Dialogue: 0,0:51:03.54,0:51:05.54,Default,,0,0,0,,Олар маған ғарыш крейсеріне тегін мінгіземіз деді.
Dialogue: 0,0:51:05.54,0:51:08.55,Default,,0,0,0,,Егер сізде сөйлесетін нәрсе болмаса.
Dialogue: 0,0:51:08.55,0:51:10.55,Default,,0,0,0,,Мугю…
Dialogue: 0,0:51:10.55,0:51:12.55,Default,,0,0,0,,Иә, Эмон, саған.
Dialogue: 0,0:51:12.55,0:51:14.55,Default,,0,0,0,,Кімнен? Қосылу
Dialogue: 0,0:51:17.54,0:51:19.54,Default,,0,0,0,,А, Эмон-кун, солай ма?
Dialogue: 0,0:51:19.54,0:51:24.55,Default,,0,0,0,,Ваша ұл-қыздың ғарыштық достығын насихаттау одағының кеңесі
Dialogue: 0,0:51:24.55,0:51:29.55,Default,,0,0,0,,Мекеме дайындау жөніндегі комитет төрағасының уақытша міндетін атқарушы
Dialogue: 0,0:51:29.55,0:51:31.55,Default,,0,0,0,,Құттықтаймыз.
Dialogue: 0,0:51:31.55,0:51:33.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:33.54,0:51:36.54,Default,,0,0,0,,Шын мәнінде, белгілі бір зымыран компаниясы жаңа өнімді аяқтады.
Dialogue: 0,0:51:36.54,0:51:38.54,Default,,0,0,0,,Ғарыш туралы армандайтын жастарға арналған
Dialogue: 0,0:51:38.54,0:51:41.55,Default,,0,0,0,,Маған сынақ жүргізу туралы ұсыныс түсті.
Dialogue: 0,0:51:41.55,0:51:44.55,Default,,0,0,0,,Қатаң іріктеу нәтижелері
Dialogue: 0,0:51:44.55,0:51:48.55,Default,,0,0,0,,Цузурея 21 Егер Эмон дұрыс адам болса, бұл осыған байланысты.
Dialogue: 0,0:51:48.55,0:51:50.54,Default,,0,0,0,,Мен... зымыранға мінсем бола ма?
Dialogue: 0,0:51:50.54,0:51:53.54,Default,,0,0,0,,Иә, Күн жүйесінің айналасында.
Dialogue: 0,0:51:53.54,0:51:55.54,Default,,0,0,0,,Тек нәтижелерді хабарлаңыз.
Dialogue: 0,0:51:55.54,0:51:57.55,Default,,0,0,0,,Қарапайым тілмен айтқанда, ол тегін бе?
Dialogue: 0,0:51:57.55,0:51:59.55,Default,,0,0,0,,Кеш болса да, тегін.
Dialogue: 0,0:51:59.55,0:52:01.55,Default,,0,0,0,,Өтінемін? Ұсынысты қабылдайсыз ба?
Dialogue: 0,0:52:01.55,0:52:03.55,Default,,0,0,0,,да... Әрине!
Dialogue: 0,0:52:03.55,0:52:05.55,Default,,0,0,0,,Муи Муи!
Dialogue: 0,0:52:05.55,0:52:08.54,Default,,0,0,0,,Енді сіз телексаттаған уақыт пен орынға келіңіз.
Dialogue: 0,0:52:08.54,0:52:10.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:52:10.54,0:52:14.55,Default,,0,0,0,,Осындай нәрсе туралы не деуге болады? президент
Dialogue: 0,0:52:14.55,0:52:16.55,Default,,0,0,0,,Эй, эй...
Dialogue: 0,0:52:16.55,0:52:18.55,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:52:18.55,0:52:21.55,Default,,0,0,0,,Осымен 21 Эмон-кунның армандары жанып кетеді.
Dialogue: 0,0:52:21.55,0:52:24.54,Default,,0,0,0,,Бұл құмарлық немесе құмарлық емес.
Dialogue: 0,0:52:24.54,0:52:27.54,Default,,0,0,0,,Мен міндетті түрде ғарыш ұшқышы боламын.
Dialogue: 0,0:52:27.54,0:52:29.55,Default,,0,0,0,,Бірінші қадам ретінде
Dialogue: 0,0:52:29.55,0:52:31.55,Default,,0,0,0,,Мен ғарышқа саяхатқа шыққым келеді
Dialogue: 0,0:52:31.55,0:52:33.55,Default,,0,0,0,,Сіз мұны оңай айтасыз.
Dialogue: 0,0:52:33.55,0:52:36.55,Default,,0,0,0,,Сіз қанша тұратынын білесіз бе?
Dialogue: 0,0:52:36.55,0:52:39.56,Default,,0,0,0,,Мен әкеме ешқашан қиындық келтірмеймін.
Dialogue: 0,0:52:39.56,0:52:42.54,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге бір иен төлей алмаймын. Бұл жақсы ма?
Dialogue: 0,0:52:42.54,0:52:44.54,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:52:46.55,0:52:48.55,Default,,0,0,0,,Анашым
Dialogue: 0,0:52:48.55,0:52:50.55,Default,,0,0,0,,Ғарышқа ұшуыма әкем рұқсат берді.
Dialogue: 0,0:52:50.55,0:52:52.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:52.55,0:52:54.55,Default,,0,0,0,,Сіз мұны істей алмайсыз, солай ма?
Dialogue: 0,0:52:54.55,0:52:56.56,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:52:56.56,0:52:59.54,Default,,0,0,0,,Ғарышқа саяхат миллиондаған тұрады.
Dialogue: 0,0:52:59.54,0:53:02.54,Default,,0,0,0,,Баланың күші ештеңе істей алмайды. Уайымдама.
Dialogue: 0,0:53:02.54,0:53:04.55,Default,,0,0,0,,Себебі сол бала
Dialogue: 0,0:53:04.55,0:53:06.55,Default,,0,0,0,,«Мен тегін жүруге мүмкіндік беретін ғарыш кемесін таптым».
Dialogue: 0,0:53:06.55,0:53:08.55,Default,,0,0,0,,Уа! Мен мұны тыңдамаймын.
Dialogue: 0,0:53:08.55,0:53:10.55,Default,,0,0,0,,Сіз әзілге жақсысыз.
Dialogue: 0,0:53:10.55,0:53:13.56,Default,,0,0,0,,Бұл шынымен ғарышқа сапарға шыққандай.
Dialogue: 0,0:53:13.56,0:53:15.56,Default,,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:53:15.56,0:53:18.54,Default,,0,0,0,,Идиот, бала жалғыз бара ала ма?
Dialogue: 0,0:53:18.54,0:53:20.55,Default,,0,0,0,,Мен сол үшін барамын
Dialogue: 0,0:53:20.55,0:53:22.55,Default,,0,0,0,,Мен тамашамын
Dialogue: 0,0:53:22.55,0:53:24.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:24.55,0:53:27.55,Default,,0,0,0,,Ғарышта көптеген қауіпті заттар бар.
Dialogue: 0,0:53:27.55,0:53:29.56,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:53:29.56,0:53:32.56,Default,,0,0,0,,Ғарыштағы апаттардың жылдамдығы қандай?
Dialogue: 0,0:53:32.56,0:53:35.54,Default,,0,0,0,,Бұл әуе көлігі апаттарынан аз.
Dialogue: 0,0:53:35.54,0:53:37.55,Default,,0,0,0,,Эмон!
Dialogue: 0,0:53:37.55,0:53:41.55,Default,,0,0,0,,Әке! Әкем ғаламға қарай ұшуға тырысады
Dialogue: 0,0:53:41.55,0:53:45.55,Default,,0,0,0,,Менің болашағымды өшіргіңіз келе ме?
Dialogue: 0,0:53:45.55,0:53:47.56,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:53:47.56,0:53:50.56,Default,,0,0,0,,Жастар, өршіл болыңдар.
Dialogue: 0,0:53:50.56,0:53:52.54,Default,,0,0,0,,Әкесі де еркек болса
Dialogue: 0,0:53:52.54,0:53:54.55,Default,,0,0,0,,Болашағымды жарылқа.
Dialogue: 0,0:53:54.55,0:53:56.55,Default,,0,0,0,,Мен көптен бері армандадым
Dialogue: 0,0:53:56.55,0:53:59.55,Default,,0,0,0,,Ғарыш ұшқышы болудың алғашқы қадамын жасай отырып, мен...
Dialogue: 0,0:53:59.55,0:54:01.55,Default,,0,0,0,,Мен шығайын деп жатырмын.
Dialogue: 0,0:54:01.55,0:54:04.56,Default,,0,0,0,,Иә, тамаша! 21 Эмон
Dialogue: 0,0:54:04.56,0:54:08.54,Default,,0,0,0,,Міне! Ешқашан қайтып келмесем не істеуім керек?
Dialogue: 0,0:54:08.54,0:54:12.55,Default,,0,0,0,,Жылама, ғарыш Жерден де қауіпсіз дейді.
Dialogue: 0,0:54:12.55,0:54:15.55,Default,,0,0,0,,Жерде қалсаң, құламайсың.
Dialogue: 0,0:54:15.55,0:54:18.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:18.55,0:54:22.56,Default,,0,0,0,,Иә? Әйеліңді кім жылатты?
Dialogue: 0,0:54:22.56,0:54:24.56,Default,,0,0,0,,Ғарышқа не үшін бару керек?
Dialogue: 0,0:54:24.56,0:54:26.55,Default,,0,0,0,,Сен бағынбайтын бала!
Dialogue: 0,0:54:26.55,0:54:28.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:28.55,0:54:31.55,Default,,0,0,0,,Ал... ғалам бар.
Dialogue: 0,0:54:31.55,0:54:34.55,Default,,0,0,0,,Ғаламда жасырылған көптеген жұмбақтар бар.
Dialogue: 0,0:54:34.55,0:54:36.56,Default,,0,0,0,,Мухи
Dialogue: 0,0:54:36.56,0:54:38.56,Default,,0,0,0,,Белгісіз тау Белгісіз аңғар
Dialogue: 0,0:54:38.56,0:54:42.54,Default,,0,0,0,,Әлі ешкім ашпаған жануарлар мен өсімдіктер
Dialogue: 0,0:54:42.54,0:54:45.55,Default,,0,0,0,,Не? Өсімдіктер мен картоп та өсімдік, солай емес пе?
Dialogue: 0,0:54:45.55,0:54:47.55,Default,,0,0,0,,(Жан) Эй, бір минут — мұндай жерде шынымен біреу тұра ма?
Dialogue: 0,0:54:47.55,0:54:50.55,Default,,0,0,0,,Расында да, ғаламда картоп бар ма?
Dialogue: 0,0:54:50.55,0:54:52.55,Default,,0,0,0,,Әрине солай.
Dialogue: 0,0:54:52.55,0:54:54.56,Default,,0,0,0,,Кептірілген картоп деген бар.
Dialogue: 0,0:54:54.56,0:54:56.56,Default,,0,0,0,,Ғалам кең, іздесең...
Dialogue: 0,0:54:56.56,0:54:59.56,Default,,0,0,0,,Тіпті картопқа толы картоп жұлдызы болуы мүмкін.
Dialogue: 0,0:54:59.56,0:55:02.55,Default,,0,0,0,,... планета картопқа толы ма?
Dialogue: 0,0:55:02.55,0:55:05.55,Default,,0,0,0,,Ғарыш сапарына кедергі келтірген ешкімді кешірмеймін.
Dialogue: 0,0:55:05.55,0:55:08.55,Default,,0,0,0,,Мен картопты бұзған адамды кешірмеймін!
Dialogue: 0,0:55:08.55,0:55:11.56,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:55:11.56,0:55:13.56,Default,,0,0,0,,Кеттік
Dialogue: 0,0:55:16.56,0:55:19.56,Default,,0,0,0,,Эмон…
Dialogue: 0,0:55:23.55,0:55:25.55,Default,,0,0,0,,Бұл ана үшін жаман болды ма?
Dialogue: 0,0:55:25.55,0:55:27.55,Default,,0,0,0,,Му…
Dialogue: 0,0:55:29.56,0:55:34.55,Default,,0,0,0,,Уақытша айдың жарығы 101 қақпадан шығады.
Dialogue: 0,0:55:34.55,0:55:38.55,Default,,0,0,0,,Цузурея 21 Эмон және оның партиясы, отырыңыз.
Dialogue: 0,0:55:38.55,0:55:41.55,Default,,0,0,0,,Цузурея 21 Эмон және оның партиясы, отырыңыз.
Dialogue: 0,0:55:41.55,0:55:44.56,Default,,0,0,0,,О, бұл біз туралы.
Dialogue: 0,0:55:44.56,0:55:46.56,Default,,0,0,0,,101 қақпа сол жақта.
Dialogue: 0,0:56:02.56,0:56:05.56,Default,,0,0,0,,Мвааа... уау
Dialogue: 0,0:56:05.56,0:56:08.56,Default,,0,0,0,,Керемет тамаша…
Dialogue: 0,0:56:10.55,0:56:12.55,Default,,0,0,0,,Ах Онабе
Dialogue: 0,0:56:12.55,0:56:14.55,Default,,0,0,0,,Маған да жазылыңыз.
Dialogue: 0,0:56:14.55,0:56:16.56,Default,,0,0,0,,Бұл фурошики орамасы қандай?
Dialogue: 0,0:56:16.56,0:56:18.56,Default,,0,0,0,,Жолда әйеліңізде қаржылық қиындықтар туындаса, қиындық тудырар еді.
Dialogue: 0,0:56:18.56,0:56:20.56,Default,,0,0,0,,Мынаны алыңыз.
Dialogue: 0,0:56:20.56,0:56:23.56,Default,,0,0,0,,Иә? Әй, бұл мен Укики ағашынан алған рубин.
Dialogue: 0,0:56:23.56,0:56:26.55,Default,,0,0,0,,Анам да маған саяхаттауға рұқсат берді.
Dialogue: 0,0:56:26.55,0:56:29.55,Default,,0,0,0,,Рахмет анашым
Dialogue: 0,0:56:29.55,0:56:31.55,Default,,0,0,0,,Бірақ бұл саған жаман, Онабе.
Dialogue: 0,0:56:31.55,0:56:33.56,Default,,0,0,0,,Мынаны ал да, менің үйіме қайт.
Dialogue: 0,0:56:33.56,0:56:35.56,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:56:35.56,0:56:37.56,Default,,0,0,0,,Оны неге үйге апардың?
Dialogue: 0,0:56:37.56,0:56:41.56,Default,,0,0,0,,``Таспа цехындағы жабдықты жөндеу үшін осы асыл тасты пайдаланыңыз.''
Dialogue: 0,0:56:41.56,0:56:44.55,Default,,0,0,0,,«Мен әкеме уәде бердім».
Dialogue: 0,0:56:44.55,0:56:48.55,Default,,0,0,0,,Мен: «Мен ешқашан қиындық тудырмаймын» дедім.
Dialogue: 0,0:56:48.55,0:56:50.55,Default,,0,0,0,,Сол ханым
Dialogue: 0,0:57:02.55,0:57:04.55,Default,,0,0,0,,О, тәңірім.
Dialogue: 0,0:57:04.55,0:57:06.56,Default,,0,0,0,,Мен ақыры ауыр орындықтан шыға аламын.
Dialogue: 0,0:57:06.56,0:57:08.56,Default,,0,0,0,,Уа, нөлдік гравитация
Dialogue: 0,0:57:08.56,0:57:11.56,Default,,0,0,0,,Муи... Вахааа
Dialogue: 0,0:57:11.56,0:57:14.56,Default,,0,0,0,,Ханымдар мен мырзалар, кеме қазір
Dialogue: 0,0:57:14.56,0:57:18.55,Default,,0,0,0,,Ай мен жердің арасындағы салмақсыз кеңістікте ұшу
Dialogue: 0,0:57:18.55,0:57:21.55,Default,,0,0,0,,Сусыннан ләззат алыңыз.
Dialogue: 0,0:57:21.55,0:57:24.56,Default,,0,0,0,,Біраз уақыт толқудан ләззат алыңыз
Dialogue: 0,0:57:24.56,0:57:26.56,Default,,0,0,0,,Иә, хаха...
Dialogue: 0,0:57:29.56,0:57:31.56,Default,,0,0,0,,Уа-у-у-у-у-у-у...
Dialogue: 0,0:57:31.56,0:57:33.57,Default,,0,0,0,,Тоқтамайды Тоқтамайды Уау!
Dialogue: 0,0:57:33.57,0:57:35.57,Default,,0,0,0,,Муи хахаха
Dialogue: 0,0:57:39.55,0:57:41.55,Default,,0,0,0,,Уау, бұл әдемі
Dialogue: 0,0:57:45.56,0:57:47.56,Default,,0,0,0,,О... маған көмектесіңізші
Dialogue: 0,0:57:47.56,0:57:49.56,Default,,0,0,0,,Муи
Dialogue: 0,0:57:51.57,0:57:54.55,Default,,0,0,0,,Тоқта, ол тоқтамайды.
Dialogue: 0,0:57:54.55,0:57:56.56,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:57:56.56,0:57:58.56,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:57:58.56,0:58:01.56,Default,,0,0,0,,-де біз жасанды гравитация жасаймыз.
Dialogue: 0,0:58:04.56,0:58:06.57,Default,,0,0,0,,Ғарышқа саяхаттау да оңай емес, иә?
Dialogue: 0,0:58:06.57,0:58:08.57,Default,,0,0,0,,Ай сәулесіне қош келдіңіздер
Dialogue: 0,0:58:08.57,0:58:11.55,Default,,0,0,0,,Мен бұл кеменің эксклюзивті гидмін.
Dialogue: 0,0:58:11.55,0:58:15.56,Default,,0,0,0,,Мен қазір сіздің бөлмеңізді жинап жатырмын.
Dialogue: 0,0:58:15.56,0:58:17.56,Default,,0,0,0,,Тазалау? Муи?
Dialogue: 0,0:58:23.57,0:58:25.57,Default,,0,0,0,,Иә? Муи
Dialogue: 0,0:58:28.55,0:58:30.56,Default,,0,0,0,,Уау! Сіз?
Dialogue: 0,0:58:30.56,0:58:32.56,Default,,0,0,0,,Мучё!
Dialogue: 0,0:58:32.56,0:58:35.56,Default,,0,0,0,,Уау... бұл керемет
Dialogue: 0,0:58:35.56,0:58:37.56,Default,,0,0,0,,Оны маған жапсырғың келе ме!?》
Dialogue: 0,0:58:39.56,0:58:42.56,Default,,0,0,0,,Бұл жолы 16 арналы стерео.
Dialogue: 0,0:58:44.55,0:58:46.55,Default,,0,0,0,,Муи... Муи!
Dialogue: 0,0:58:48.56,0:58:50.56,Default,,0,0,0,,Уау, бұл дәмді көрінеді.
Dialogue: 0,0:58:50.56,0:58:52.56,Default,,0,0,0,,Картопқа мінбе! Картоп!
Dialogue: 0,0:58:55.56,0:58:58.57,Default,,0,0,0,,Әй, мен кабинаға көз салғым келеді.
Dialogue: 0,0:58:58.57,0:59:01.55,Default,,0,0,0,,Өкінішке орай, кеме жүзіп бара жатқанда экскурсия жасау мүмкін емес.
Dialogue: 0,0:59:01.55,0:59:03.55,Default,,0,0,0,,Оның орнына бақылау бөлмесіне барыңыз.
Dialogue: 0,0:59:08.56,0:59:10.56,Default,,0,0,0,,А... А...
Dialogue: 0,0:59:10.56,0:59:12.56,Default,,0,0,0,,Кеше теңіз жағалауға барып келгенімізге байланысты,
Dialogue: 0,0:59:12.56,0:59:15.56,Default,,0,0,0,,Уау, эй...
Dialogue: 0,0:59:21.56,0:59:23.56,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:59:23.56,0:59:25.56,Default,,0,0,0,,Жұлдыздарға толы
Dialogue: 0,0:59:25.56,0:59:27.56,Default,,0,0,0,,Сіз жақсырақ көре аласыз, өйткені ауа жоқ.
Dialogue: 0,0:59:27.56,0:59:30.57,Default,,0,0,0,,Оның бұлай жыпылықтамауының себебі, жұлдыз толығымен сынғандықтан?
Dialogue: 0,0:59:30.57,0:59:32.57,Default,,0,0,0,,Бұл да ауаның жоқтығынан.
Dialogue: 0,0:59:32.57,0:59:34.57,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:59:34.57,0:59:36.56,Default,,0,0,0,,Мына жерде картоп бар ма?
Dialogue: 0,0:59:36.56,0:59:38.56,Default,,0,0,0,,Уау...
Dialogue: 0,0:59:40.56,0:59:42.56,Default,,0,0,0,,Не?
Dialogue: 0,0:59:42.56,0:59:44.56,Default,,0,0,0,,Мен оны уақытында орындағаныма қуаныштымын.
Dialogue: 0,0:59:44.56,0:59:46.57,Default,,0,0,0,,Арыстан метеорлық жауын
Dialogue: 0,0:59:46.57,0:59:49.57,Default,,0,0,0,,33 жыл сайын аспанды бояйтын жұлдызды шаң
Dialogue: 0,0:59:49.57,0:59:51.57,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:59:51.57,0:59:53.56,Default,,0,0,0,,Ах! Жұлдыз жоғалып кетті, Мваа!
Dialogue: 0,0:59:53.56,0:59:57.56,Default,,0,0,0,,Кеме енді бұрылысқа түсті.
Dialogue: 0,0:59:57.56,0:59:59.56,Default,,0,0,0,,Не? Бұл бұрыс
Dialogue: 0,0:59:59.56,1:00:01.56,Default,,0,0,0,,А, мен саған түсіндіремін.
Dialogue: 0,1:00:01.56,1:00:03.57,Default,,0,0,0,,Әлем үлкен.
Dialogue: 0,1:00:03.57,1:00:05.57,Default,,0,0,0,,Жарық жылдамдығымен ұшсаңыз да, тым көп уақыт алады
Dialogue: 0,1:00:05.57,1:00:08.57,Default,,0,0,0,,Сонымен, бұл шеңберден осы крестке жетудің ең жылдам жолы қандай?
Dialogue: 0,1:00:08.57,1:00:10.56,Default,,0,0,0,,Жарайды, түз жүру - ең жылдам жол.
Dialogue: 0,1:00:10.56,1:00:12.56,Default,,0,0,0,,Бұл шынымен де мәселе.
Dialogue: 0,1:00:12.56,1:00:16.56,Default,,0,0,0,,Егер мұны жасасаңыз, шеңберлер мен кресттер бір-біріне жабысып қалады және сіз төте жолды ала аласыз.
Dialogue: 0,1:00:16.56,1:00:18.56,Default,,0,0,0,,Бұл жалған!
Dialogue: 0,1:00:18.56,1:00:20.57,Default,,0,0,0,,Өйткені бұл бұрма.
Dialogue: 0,1:00:20.57,1:00:22.57,Default,,0,0,0,,Осы әдістің ашылуының арқасында
Dialogue: 0,1:00:22.57,1:00:26.57,Default,,0,0,0,,Енді біз Магеллан бұлты сияқты алыс қашықтықтарға саяхаттай аламыз.
Dialogue: 0,1:00:26.57,1:00:28.56,Default,,0,0,0,,Жай... Жай ғана?
Dialogue: 0,1:00:28.56,1:00:30.56,Default,,0,0,0,,Бұрыштан өткенде
Dialogue: 0,1:00:30.56,1:00:32.56,Default,,0,0,0,,Мен ішкі кеңістіктің табиғатын түсінбеймін, сондықтан
Dialogue: 0,1:00:32.56,1:00:34.56,Default,,0,0,0,,Кейде қиындық туындайды
Dialogue: 0,1:00:34.56,1:00:36.57,Default,,0,0,0,,Бұл қандай қиындық?
Dialogue: 0,1:00:36.57,1:00:38.57,Default,,0,0,0,,Кеңістікте магнит өрісі бар
Dialogue: 0,1:00:38.57,1:00:42.57,Default,,0,0,0,,Жер асты кеңістігінде магниттілігі күшті орын бар... Гагага...
Dialogue: 0,1:00:42.57,1:00:44.57,Default,,0,0,0,,Саған не болды?
Dialogue: 0,1:00:46.56,1:00:48.56,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:54.57,1:00:57.57,Default,,0,0,0,,Бұл қорқынышты! Ол картопқа толы
Dialogue: 0,1:00:57.57,1:01:00.57,Default,,0,0,0,,Ей, мен ғарышқа келгеніме қуаныштымын. Ах...
Dialogue: 0,1:01:00.57,1:01:02.56,Default,,0,0,0,,Гонске Тағы бір қызық нәрсе...
Dialogue: 0,1:01:02.56,1:01:04.56,Default,,0,0,0,,Ааа...
Dialogue: 0,1:01:04.56,1:01:07.56,Default,,0,0,0,,Картоп Агага...
Dialogue: 0,1:01:11.57,1:01:13.57,Default,,0,0,0,,Ах, кешіріңіз.
Dialogue: 0,1:01:13.57,1:01:15.57,Default,,0,0,0,,Қиындық біткен сияқты.
Dialogue: 0,1:01:49.57,1:01:51.57,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:01:51.57,1:01:55.56,Default,,0,0,0,,Ғарышты аңсау, Марсты аңсау
Dialogue: 0,1:01:55.56,1:01:59.56,Default,,0,0,0,,Жарайды! Бұл толқудан бүкіл денеңізбен ләззат алыңыз
Dialogue: 0,1:01:59.56,1:02:01.57,Default,,0,0,0,,Ах, тұтынушы.
Dialogue: 0,1:02:01.57,1:02:04.57,Default,,0,0,0,,Бұл бөлме қазір ұшатын аппарат.
Dialogue: 0,1:02:04.57,1:02:06.57,Default,,0,0,0,,Кемені тастап кетесіз бе?
Dialogue: 0,1:02:06.57,1:02:09.57,Default,,0,0,0,,Сонда сіз шыға алмайсыз ба? иә
Dialogue: 0,1:02:09.57,1:02:11.56,Default,,0,0,0,,Біз сізді қонақ үйге апарамыз.
Dialogue: 0,1:02:11.56,1:02:13.56,Default,,0,0,0,,олар ондағы жазбаларды сақтау үшін көшіріп жазады—
Dialogue: 0,1:02:13.56,1:02:15.56,Default,,0,0,0,,Жақсы
Dialogue: 0,1:02:31.56,1:02:34.57,Default,,0,0,0,,Хмм? иә?
Dialogue: 0,1:02:34.57,1:02:37.57,Default,,0,0,0,,Марста ормандар бар ма?
Dialogue: 0,1:02:37.57,1:02:42.57,Default,,0,0,0,,Менің атым Оксилоя, ол оттегін өндіретін өсімдік.
Dialogue: 0,1:02:44.58,1:02:48.56,Default,,0,0,0,,Бұл бізге скафандрдың қажеті жоқ дегенді білдіре ме?
Dialogue: 0,1:02:48.56,1:02:50.57,Default,,0,0,0,,11 жыл бұрын
Dialogue: 0,1:02:50.57,1:02:55.57,Default,,0,0,0,,Жерден келген иммигранттардың бірінші тобы Марсты ашты.
Dialogue: 0,1:02:55.57,1:02:59.57,Default,,0,0,0,,Қазір Марстың астанасы Сыртистің айналасында орналасқан.
Dialogue: 0,1:02:59.57,1:03:02.58,Default,,0,0,0,,Атмосфераның Жердікінен еш айырмашылығы жоқ.
Dialogue: 0,1:03:02.58,1:03:06.56,Default,,0,0,0,,Хмм, демек Марста құмды дауыл болмайды ма?
Dialogue: 0,1:03:06.56,1:03:09.57,Default,,0,0,0,,Иә, енді жоқ
Dialogue: 0,1:03:09.57,1:03:12.57,Default,,0,0,0,,Ұзын аяқты ғимарат бұрыннан көрініп тұр
Dialogue: 0,1:03:12.57,1:03:16.57,Default,,0,0,0,,Бұл құмды дауылдар көп болған дәуірдегі ғимарат.
Dialogue: 0,1:03:16.57,1:03:20.56,Default,,0,0,0,,Бірақ гравитация Жердің 38% құрайды
Dialogue: 0,1:03:20.56,1:03:22.56,Default,,0,0,0,,Бұл өзгермейді ме? Иә.
Dialogue: 0,1:03:22.56,1:03:25.57,Default,,0,0,0,,Оң қолға артқа қара
Dialogue: 0,1:03:25.57,1:03:27.57,Default,,0,0,0,,Бұл жылу сәулелену пеші.
Dialogue: 0,1:03:27.57,1:03:32.57,Default,,0,0,0,,Ядролық синтез атмосфералық температураны арттыра отырып, жер астында жүреді.
Dialogue: 0,1:03:32.57,1:03:37.56,Default,,0,0,0,,Хмм, енді адамдар Марста өмір сүре алады ма?
Dialogue: 0,1:03:37.56,1:03:40.57,Default,,0,0,0,,Картоп қайда? Ақтүйнек?
Dialogue: 0,1:03:40.57,1:03:43.57,Default,,0,0,0,,Картоп туралы айтсақ... бұл картоп па?
Dialogue: 0,1:03:43.57,1:03:45.57,Default,,0,0,0,,Картоп – картоп тұшпарасы
Dialogue: 0,1:03:45.57,1:03:48.57,Default,,0,0,0,,Өкінішке орай, Марста картоп жоқ.
Dialogue: 0,1:03:48.57,1:03:51.58,Default,,0,0,0,,Ахахах... хахаха...
Dialogue: 0,1:03:51.58,1:03:55.56,Default,,0,0,0,,Қарғыс атсын, мен әлі артта қалдым. Хмф!
Dialogue: 0,1:03:55.56,1:03:59.57,Default,,0,0,0,,Оның орнына танымал ерекшелігі - канал және сегізаяқ тәрізді Марсиан.
Dialogue: 0,1:03:59.57,1:04:04.57,Default,,0,0,0,,Иә! Бұл ежелден адамдар елестеткен нәрсе емес пе?
Dialogue: 0,1:04:04.57,1:04:07.57,Default,,0,0,0,,Дегенмен, ол әлі де бар.
Dialogue: 0,1:04:11.56,1:04:13.57,Default,,0,0,0,,Марс мұнарасынан қараңыз.
Dialogue: 0,1:04:13.57,1:04:16.57,Default,,0,0,0,,Марс мұнарасы?
Dialogue: 0,1:04:16.57,1:04:20.57,Default,,0,0,0,,Уау! Ахахха...
Dialogue: 0,1:04:20.57,1:04:24.57,Default,,0,0,0,,Уау! Керемет көрініс
Dialogue: 0,1:04:28.58,1:04:31.57,Default,,0,0,0,,Ах! арнада су ағып жатыр
Dialogue: 0,1:04:31.57,1:04:34.57,Default,,0,0,0,,Әйгілі Лоуэлл каналы, иә?
Dialogue: 0,1:04:34.57,1:04:37.57,Default,,0,0,0,,Марс каналдарындағы су баяғыда таусылған болуы керек, солай ма?
Dialogue: 0,1:04:37.57,1:04:39.57,Default,,0,0,0,,Не? Бұл рас...
Dialogue: 0,1:04:39.57,1:04:41.58,Default,,0,0,0,,Уау! Сондай-ақ құмды дауыл бар
Dialogue: 0,1:04:41.58,1:04:44.58,Default,,0,0,0,,Уау! Марсиандар да бар
Dialogue: 0,1:04:44.58,1:04:46.56,Default,,0,0,0,,Жоқ... Қызық, неге мұндай нәрсе бар?
Dialogue: 0,1:04:46.56,1:04:49.57,Default,,0,0,0,,Негізінде, олардың барлығы туризмге арналған, иә?
Dialogue: 0,1:04:49.57,1:04:53.57,Default,,0,0,0,,Барлық марсиялықтар Жерден өзгерген сегізаяқтар!
Dialogue: 0,1:04:53.57,1:04:55.57,Default,,0,0,0,,Сегізаяқ? Күрсін...
Dialogue: 0,1:04:57.58,1:05:00.58,Default,,0,0,0,,Иә, Марстан келген ашықхат ше?
Dialogue: 0,1:05:00.58,1:05:03.57,Default,,0,0,0,,Марс күріш крекерлері ше? Марс құмы туралы не айтасыз?
Dialogue: 0,1:05:03.57,1:05:05.57,Default,,0,0,0,,Марс шоколады мен Марс кокеши қуыршақтары ше?
Dialogue: 0,1:05:05.57,1:05:08.57,Default,,0,0,0,,Марс сырасы Тағам ретінде жержаңғақ алғыңыз келе ме?
Dialogue: 0,1:05:08.57,1:05:10.57,Default,,0,0,0,,Марс… Марс құмы…
Dialogue: 0,1:05:10.57,1:05:14.57,Default,,0,0,0,,үшін, маған керегі жоқ! иә?
Dialogue: 0,1:05:28.57,1:05:30.58,Default,,0,0,0,,Міне, қонақ үйге де келдік.
Dialogue: 0,1:05:30.58,1:05:33.58,Default,,0,0,0,,Бұл қонақүйдің билеті.
Dialogue: 0,1:05:33.58,1:05:35.58,Default,,0,0,0,,Өзіңізге ұнайтын нәрседен ләззат алыңыз.
Dialogue: 0,1:05:35.58,1:05:37.58,Default,,0,0,0,,Рахмет
Dialogue: 0,1:05:37.58,1:05:39.57,Default,,0,0,0,,Жарайды, ертең сені алып кетемін.
Dialogue: 0,1:05:39.57,1:05:42.57,Default,,0,0,0,,Оған дейін уақытыңызды бөліңіз
Dialogue: 0,1:05:42.57,1:05:45.57,Default,,0,0,0,,Муимуи еңбегіңіз үшін рахмет
Dialogue: 0,1:05:57.57,1:06:01.57,Default,,0,0,0,,Муи! Апыр-ай! Бұл Марста күн батуы
Dialogue: 0,1:06:01.57,1:06:04.58,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,1:06:04.58,1:06:08.58,Default,,0,0,0,,Монгер Гонске Ғалам керемет, солай емес пе?
Dialogue: 0,1:06:08.58,1:06:10.58,Default,,0,0,0,,Монгер
Dialogue: 0,1:06:10.58,1:06:12.57,Default,,0,0,0,,Егер сізде картоп болмаса, сіз бастай алмайсыз.
Dialogue: 0,1:06:12.57,1:06:15.57,Default,,0,0,0,,Не? сенде арман жоқ
Dialogue: 0,1:06:15.57,1:06:17.57,Default,,0,0,0,,Ах! Мен оны картоппен еске түсірдім
Dialogue: 0,1:06:17.57,1:06:19.57,Default,,0,0,0,,А, қарным ашты! Күріш!
Dialogue: 0,1:06:19.57,1:06:21.57,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:23.58,1:06:26.58,Default,,0,0,0,,...
Dialogue: 0,1:06:26.58,1:06:30.58,Default,,0,0,0,,Мен мұндай қонақүйдің тегін екеніне сене алмаймын.
Dialogue: 0,1:06:43.58,1:06:47.57,Default,,0,0,0,,Сонымен қатар, бұл осындай сәнді асханада тегін тамақ.
Dialogue: 0,1:06:47.57,1:06:49.57,Default,,0,0,0,,Бірдеңе дұрыс емес сияқты.
Dialogue: 0,1:06:49.57,1:06:52.57,Default,,0,0,0,,Күткенім үшін кешіріңіз, 10-кесте.
Dialogue: 0,1:06:54.58,1:06:56.58,Default,,0,0,0,,Жоқ, қарным ашты.
Dialogue: 0,1:06:56.58,1:06:59.58,Default,,0,0,0,,Итадакимасу! О...
Dialogue: 0,1:06:59.58,1:07:01.58,Default,,0,0,0,,Иә, бұл дәмді.
Dialogue: 0,1:07:01.58,1:07:03.59,Default,,0,0,0,,Анамның тамақ дайындағаны сияқты.
Dialogue: 0,1:07:03.59,1:07:07.57,Default,,0,0,0,,Монгер Сіз қалай ойлайсыз? Гаха…
Dialogue: 0,1:07:07.57,1:07:11.58,Default,,0,0,0,,Әдеттегідей, бұл дөрекі тамақтану тәсілі.
Dialogue: 0,1:07:11.58,1:07:15.58,Default,,0,0,0,,Маған қарашы, мен сыныппын.
Dialogue: 0,1:07:15.58,1:07:18.58,Default,,0,0,0,,Балалар, сендермен бірге тамақ ішу біртүрлі болып тұр.
Dialogue: 0,1:07:18.58,1:07:22.57,Default,,0,0,0,,Ах... Ах! Мына жақта...
Dialogue: 0,1:07:22.57,1:07:25.57,Default,,0,0,0,,Сканли мырза! Иә?
Dialogue: 0,1:07:25.57,1:07:28.58,Default,,0,0,0,,Ал, сен...
Dialogue: 0,1:07:28.58,1:07:30.58,Default,,0,0,0,,Иә, мен сенімдімін. Эмон, бастер.
Dialogue: 0,1:07:30.58,1:07:32.58,Default,,0,0,0,,Жоқ, бұл гобелен цехы.
Dialogue: 0,1:07:32.58,1:07:34.58,Default,,0,0,0,,Хахаха...
Dialogue: 0,1:07:34.58,1:07:37.59,Default,,0,0,0,,Олай болса, мен осында отыра аламын ба? Сондай-ақ... әрине!
Dialogue: 0,1:07:37.59,1:07:39.57,Default,,0,0,0,,Рахмет
Dialogue: 0,1:07:39.57,1:07:42.57,Default,,0,0,0,,Ғарышқа саяхат туралы арманыңыз орындалған сияқты.
Dialogue: 0,1:07:42.57,1:07:44.58,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,1:07:44.58,1:07:47.58,Default,,0,0,0,,Сканли мырза, келесі жерде қай жерді зерттейсіз?
Dialogue: 0,1:07:47.58,1:07:51.58,Default,,0,0,0,,Олай айтсаң ұят.
Dialogue: 0,1:07:51.58,1:07:54.59,Default,,0,0,0,,Дәл қазір менің толық емес жұмыс күнім бар.
Dialogue: 0,1:07:54.59,1:07:56.57,Default,,0,0,0,,Толық емес жұмыс күні?
Dialogue: 0,1:07:56.57,1:07:58.57,Default,,0,0,0,,Ай сәулесі деп аталатын зымыранды ұшыңыз.
Dialogue: 0,1:07:58.57,1:08:00.58,Default,,0,0,0,,Не? Ай сәулесі!
Dialogue: 0,1:08:00.58,1:08:02.58,Default,,0,0,0,,Мистер Сканли? Иә
Dialogue: 0,1:08:02.58,1:08:05.58,Default,,0,0,0,,Зымыран компаниясы жүргізетін сынақтың енгізілуімен.
Dialogue: 0,1:08:05.58,1:08:10.59,Default,,0,0,0,,Маған күн жүйесін аралау туралы біртүрлі өтініш түсті.
Dialogue: 0,1:08:10.59,1:08:14.57,Default,,0,0,0,,Түрту? Бұл біртүрлі
Dialogue: 0,1:08:14.57,1:08:17.58,Default,,0,0,0,,Бұны кім бұйырды?
Dialogue: 0,1:08:17.58,1:08:21.58,Default,,0,0,0,,Бұл Галактика менеджерінен. Галактика...
Dialogue: 0,1:08:24.58,1:08:26.58,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:08:29.59,1:08:33.57,Default,,0,0,0,,Эмон-кун, не болды?
Dialogue: 0,1:08:33.57,1:08:36.58,Default,,0,0,0,,Мен тұзаққа түсіп қалдым ба?
Dialogue: 0,1:08:36.58,1:08:38.58,Default,,0,0,0,,Мен бұл шындық болу үшін тым жақсы естіледі деп ойладым.
Dialogue: 0,1:08:38.58,1:08:40.58,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:08:43.58,1:08:45.59,Default,,0,0,0,,Мистер Сканли, кешіріңіз.
Dialogue: 0,1:08:45.59,1:08:47.59,Default,,0,0,0,,Гонсуке Монгер Бұл жерден кетейік Муи
Dialogue: 0,1:08:47.59,1:08:50.58,Default,,0,0,0,,Сәлем, Эмон! Мен қандаймын...
Dialogue: 0,1:08:50.58,1:08:55.58,Default,,0,0,0,,Бұл күндері ұлдардың көңіл-күйін білмейміз.
Dialogue: 0,1:09:03.59,1:09:05.57,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:09:05.57,1:09:07.58,Default,,0,0,0,,Шынымен де мүлде бос…
Dialogue: 0,1:09:07.58,1:09:09.58,Default,,0,0,0,,Мен Галактиканың ақшасымен түнеуге бола ма?
Dialogue: 0,1:09:09.58,1:09:11.58,Default,,0,0,0,,Муи Муи Муи Муи…
Dialogue: 0,1:09:11.58,1:09:14.58,Default,,0,0,0,,Сонда Айдың жарығына да міне алмайсың.
Dialogue: 0,1:09:14.58,1:09:16.58,Default,,0,0,0,,Әрине!
Dialogue: 0,1:09:16.58,1:09:18.59,Default,,0,0,0,,Егер бұл орын алса, мен бүгін лагерьге шығамын.
Dialogue: 0,1:09:18.59,1:09:20.59,Default,,0,0,0,,Ертең біз басқа зымыран іздеп барамыз!
Dialogue: 0,1:09:20.59,1:09:23.57,Default,,0,0,0,,Кемпинг? Марсиандар пайда болса не істер едіңіз?
Dialogue: 0,1:09:23.57,1:09:25.58,Default,,0,0,0,,Сен сол сегізаяқты айтып тұрсың ба?
Dialogue: 0,1:09:25.58,1:09:27.58,Default,,0,0,0,,Біз жаңа ғана фойеде сөйлесіп тұрдық.
Dialogue: 0,1:09:27.58,1:09:30.58,Default,,0,0,0,,Сегізаяқ жабайы және жауыз болды.
Dialogue: 0,1:09:30.58,1:09:33.58,Default,,0,0,0,,Эй, мұнда саудагер бар.
Dialogue: 0,1:09:33.58,1:09:35.58,Default,,0,0,0,,Муи Муи Муи Муи…
Dialogue: 0,1:09:37.59,1:09:40.58,Default,,0,0,0,,Уф... күн суыта бастады.
Dialogue: 0,1:09:40.58,1:09:43.58,Default,,0,0,0,,Атмосфералық температураны төмендеткен сияқтысыз.
Dialogue: 0,1:09:43.58,1:09:46.58,Default,,0,0,0,,Жарайды, менің ойымша, осы Оксироя орманында температура тұрақты.
Dialogue: 0,1:09:46.58,1:09:49.58,Default,,0,0,0,,Осы жерде ұйықтап алайық Муи
Dialogue: 0,1:09:49.58,1:09:51.58,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,1:10:02.58,1:10:05.58,Default,,0,0,0,,Менің ойымша, ғарышқа тегін саяхаттау қателік болды.
Dialogue: 0,1:10:05.58,1:10:07.59,Default,,0,0,0,,Муи…
Dialogue: 0,1:10:07.59,1:10:11.59,Default,,0,0,0,,Әке, ана, кешіріңіз.
Dialogue: 0,1:10:16.58,1:10:19.58,Default,,0,0,0,,Ғалам үлкен, иә?
Dialogue: 0,1:10:19.58,1:10:21.58,Default,,0,0,0,,Не? Муи...
Dialogue: 0,1:10:21.58,1:10:23.58,Default,,0,0,0,,Күннің сөзі, Монгер.
Dialogue: 0,1:10:37.58,1:10:39.58,Default,,0,0,0,,Тері-фу…
Dialogue: 0,1:10:49.58,1:10:51.58,Default,,0,0,0,,Муки?
Dialogue: 0,1:10:54.58,1:10:56.58,Default,,0,0,0,,Ммм…
Dialogue: 0,1:11:00.59,1:11:02.59,Default,,0,0,0,,Мукимуки Мукимуки!
Dialogue: 0,1:11:02.59,1:11:05.59,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,1:11:05.59,1:11:07.58,Default,,0,0,0,,Уау...
Dialogue: 0,1:11:07.58,1:11:09.58,Default,,0,0,0,,Монгер Монгер тез... тез телепортация.
Dialogue: 0,1:11:09.58,1:11:11.58,Default,,0,0,0,,Әй... Сені көрмейінше өлгім келмейді.
Dialogue: 0,1:11:11.58,1:11:13.58,Default,,0,0,0,,Телепортты жылдам телепорттау! сатушы
Dialogue: 0,1:11:13.58,1:11:16.59,Default,,0,0,0,,Монгер!
Dialogue: 0,1:11:16.59,1:11:19.59,Default,,0,0,0,,Идиот! Осындай жерге телепортация жасайтын нәрсе бар ма?
Dialogue: 0,1:11:19.59,1:11:21.59,Default,,0,0,0,,Сен аянышты жігіт!
Dialogue: 0,1:11:21.59,1:11:23.58,Default,,0,0,0,,О, Гонсуке, Монгерді қатты ұстама!
Dialogue: 0,1:11:23.58,1:11:25.58,Default,,0,0,0,,Ей, сені көрмейінше өлгім келмейді!
Dialogue: 0,1:11:25.58,1:11:27.58,Default,,0,0,0,,Егер ол жұмыс істемесе, Мугю!
Dialogue: 0,1:11:27.58,1:11:29.58,Default,,0,0,0,,Бар, сонда бар! Монгер!
Dialogue: 0,1:11:29.58,1:11:31.59,Default,,0,0,0,,Уау! Жүгіріп кету!
Dialogue: 0,1:11:31.59,1:11:34.59,Default,,0,0,0,,Монгер Сәлем? Сен не істеп жатырсың?
Dialogue: 0,1:11:34.59,1:11:36.59,Default,,0,0,0,,Не? Мен оны қойдым
Dialogue: 0,1:11:36.59,1:11:38.59,Default,,0,0,0,,Монгер өсті!
Dialogue: 0,1:11:43.58,1:11:46.58,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:46.58,1:11:48.59,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:48.59,1:11:50.59,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:50.59,1:11:52.59,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,1:11:52.59,1:11:56.59,Default,,0,0,0,,Марстың тартылыс күші Жердің 38% құрайды, сондықтан ол жеңілірек.
Dialogue: 0,1:11:56.59,1:11:59.58,Default,,0,0,0,,Уау... Гонсуке бар күшімен секірді.
Dialogue: 0,1:11:59.58,1:12:01.58,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:12:03.58,1:12:06.59,Default,,0,0,0,,Міне, солай! Ах, жарайды.
Dialogue: 0,1:12:06.59,1:12:08.59,Default,,0,0,0,,А, бұл жақсы.
Dialogue: 0,1:12:08.59,1:12:10.59,Default,,0,0,0,,Міне! Міне бітті!
Dialogue: 0,1:12:10.59,1:12:12.59,Default,,0,0,0,,А, бұл! Сәттілік 12...
Dialogue: 0,1:12:12.59,1:12:14.60,Default,,0,0,0,,Міне! Міне бітті!
Dialogue: 0,1:12:14.60,1:12:16.58,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:12:16.58,1:12:18.58,Default,,0,0,0,,Ах! Қарғыс атсын, бұл канал.
Dialogue: 0,1:12:20.59,1:12:22.59,Default,,0,0,0,,Гонске!
Dialogue: 0,1:12:22.59,1:12:24.59,Default,,0,0,0,,Әй, жарайды.
Dialogue: 0,1:12:24.59,1:12:26.59,Default,,0,0,0,,Себебі оны жасау оңай
Dialogue: 0,1:12:26.59,1:12:29.59,Default,,0,0,0,,Ей, саудагер, мынау бір уақытта қалайша созылып кетесің!
Dialogue: 0,1:12:29.59,1:12:31.60,Default,,0,0,0,,Енот ит, ұйықтап қалма! Эй, Монгер, өзіңді ұста!
Dialogue: 0,1:12:31.60,1:12:33.60,Default,,0,0,0,,Таку! Монгер қазірдің өзінде!
Dialogue: 0,1:12:36.58,1:12:38.59,Default,,0,0,0,,Не? Апыр-ай! Мен оны қойдым
Dialogue: 0,1:12:38.59,1:12:40.59,Default,,0,0,0,,Бұл туристік сарқырама!
Dialogue: 0,1:12:40.59,1:12:42.59,Default,,0,0,0,,Сарқырама?
Dialogue: 0,1:12:42.59,1:12:44.59,Default,,0,0,0,,Монгер Монгер! Ах... Монгер!
Dialogue: 0,1:12:44.59,1:12:46.59,Default,,0,0,0,,Монгер, оян!
Dialogue: 0,1:12:46.59,1:12:48.60,Default,,0,0,0,,Бұл сарқырама! Бұл сарқырама! Сарқырама!
Dialogue: 0,1:12:48.60,1:12:50.58,Default,,0,0,0,,Монгер Монгер!
Dialogue: 0,1:12:50.58,1:12:53.58,Default,,0,0,0,,Эй, оян! Монгер!
Dialogue: 0,1:12:53.58,1:12:55.59,Default,,0,0,0,,Монгер... Уау...
Dialogue: 0,1:12:55.59,1:12:57.59,Default,,0,0,0,,Монгер!
Dialogue: 0,1:12:57.59,1:12:59.59,Default,,0,0,0,,Уау! О?
Dialogue: 0,1:12:59.59,1:13:01.59,Default,,0,0,0,,(Норияки Какёин) Мистер Джоэстар? (Жан) Эй, не болды?
Dialogue: 0,1:13:01.59,1:13:03.59,Default,,0,0,0,,Жақсы, мен сені кездестіре аламын.
Dialogue: 0,1:13:03.59,1:13:06.58,Default,,0,0,0,,Ахха Монгер Рахмет саған Муи
Dialogue: 0,1:13:06.58,1:13:08.58,Default,,0,0,0,,Не, не?
Dialogue: 0,1:13:11.59,1:13:13.59,Default,,0,0,0,,Уау! Не?
Dialogue: 0,1:13:19.59,1:13:23.59,Default,,0,0,0,,А, бұл жер Марс әуежайының жанында болды ма?
Dialogue: 0,1:13:25.58,1:13:28.59,Default,,0,0,0,,Жарайды, анау зымыранға мінейік.
Dialogue: 0,1:13:28.59,1:13:31.59,Default,,0,0,0,,Монгер сұрайды
Dialogue: 0,1:13:31.59,1:13:33.59,Default,,0,0,0,,Монгер!
Dialogue: 0,1:13:33.59,1:13:35.59,Default,,0,0,0,,Уау! Гррр…
Dialogue: 0,1:13:35.59,1:13:38.60,Default,,0,0,0,,Ах... Гррр...
Dialogue: 0,1:13:38.60,1:13:41.58,Default,,0,0,0,,Ку... азапты Муй?
Dialogue: 0,1:13:41.58,1:13:43.58,Default,,0,0,0,,Бұл ауырлық күші көп.
Dialogue: 0,1:13:43.58,1:13:45.59,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:45.59,1:13:49.59,Default,,0,0,0,,Адамдар қандай ыңғайсыздықтан жаратылған.
Dialogue: 0,1:13:49.59,1:13:51.59,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:13:51.59,1:13:54.60,Default,,0,0,0,,Мен сендерді қызғанамын...
Dialogue: 0,1:13:54.60,1:13:56.60,Default,,0,0,0,,Муи
Dialogue: 0,1:14:04.59,1:14:08.59,Default,,0,0,0,,Ах... Марстың атмосферасы сонша қалың болмауы керек.
Dialogue: 0,1:14:08.59,1:14:11.59,Default,,0,0,0,,Жарайды, тез арада қашамыз.
Dialogue: 0,1:14:20.59,1:14:22.59,Default,,0,0,0,,Мм... Көңілім қалды.
Dialogue: 0,1:14:22.59,1:14:25.59,Default,,0,0,0,,А, бұл Бета класындағы жүк кемесі.
Dialogue: 0,1:14:25.59,1:14:28.60,Default,,0,0,0,,Монгер, бұл зымыран қайда бара жатыр?
Dialogue: 0,1:14:28.60,1:14:30.60,Default,,0,0,0,,Муимуи
Dialogue: 0,1:14:30.60,1:14:32.60,Default,,0,0,0,,«Муимуи» мағынасы жоқ.
Dialogue: 0,1:14:32.60,1:14:34.59,Default,,0,0,0,,Муи-муи-муи!
Dialogue: 0,1:14:34.59,1:14:36.59,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,1:14:36.59,1:14:38.59,Default,,0,0,0,,Әй, сен күніне бір ғана сөз айта алатынсың.
Dialogue: 0,1:14:38.59,1:14:41.59,Default,,0,0,0,,Бұл ыңғайсыз енот ит!
Dialogue: 0,1:14:41.59,1:14:44.60,Default,,0,0,0,,Тынш! Монгер, мен сені естимін.
Dialogue: 0,1:14:44.60,1:14:47.60,Default,,0,0,0,,Ей, сенің даусың әрқашан сондай үлкен.
Dialogue: 0,1:14:47.60,1:14:49.60,Default,,0,0,0,,Муи! Қарама!
Dialogue: 0,1:14:49.60,1:14:51.59,Default,,0,0,0,,Әй, кетті. Ол әлдеқашан табылған сияқты.
Dialogue: 0,1:14:51.59,1:14:53.59,Default,,0,0,0,,Іштен бір дыбыс естідім. Мен сенімдімін. Кірейік.
Dialogue: 0,1:14:53.59,1:14:55.59,Default,,0,0,0,,Онда біреу бар ма? Монгер!
Dialogue: 0,1:14:55.59,1:14:57.59,Default,,0,0,0,,Ittete... Эй!
Dialogue: 0,1:14:57.59,1:15:00.59,Default,,0,0,0,,Әй, ақымақ, сен қайда телепорталмақсың?
Dialogue: 0,1:15:00.59,1:15:02.60,Default,,0,0,0,,Бұл сіздің сүйектеріңізді сындырады.
Dialogue: 0,1:15:02.60,1:15:04.60,Default,,0,0,0,,Монгер!
Dialogue: 0,1:15:04.60,1:15:06.60,Default,,0,0,0,,Монгер
Dialogue: 0,1:15:06.60,1:15:08.59,Default,,0,0,0,,Эй, қазір не болып жатыр? Ол қазір...
Dialogue: 0,1:15:08.59,1:15:10.59,Default,,0,0,0,,Уау! Монгер!
Dialogue: 0,1:15:10.59,1:15:13.59,Default,,0,0,0,,Хмм... бұл жеңіл ғарыш ауруы сияқты.
Dialogue: 0,1:15:15.59,1:15:17.60,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:15:17.60,1:15:19.60,Default,,0,0,0,,Сәлем, қаш!
Dialogue: 0,1:15:19.60,1:15:21.60,Default,,0,0,0,,Эй, күте тұр, күте тұр.
Dialogue: 0,1:15:21.60,1:15:23.60,Default,,0,0,0,,Қозғалмайтын интрузия Айқындап кіру
Dialogue: 0,1:15:23.60,1:15:26.59,Default,,0,0,0,,Қозғалмайтын басып кіру Қашқынды басып кіру...
Dialogue: 0,1:15:26.59,1:15:28.59,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,1:15:28.59,1:15:31.59,Default,,0,0,0,,Тез телепорт монгер!
Dialogue: 0,1:15:31.59,1:15:33.59,Default,,0,0,0,,Ууу
Dialogue: 0,1:15:33.59,1:15:36.60,Default,,0,0,0,,Монгер! Уууу...
Dialogue: 0,1:15:36.60,1:15:39.60,Default,,0,0,0,,Монгер Ууу...
Dialogue: 0,1:15:39.60,1:15:41.60,Default,,0,0,0,,Монгер!
Dialogue: 0,1:15:41.60,1:15:44.59,Default,,0,0,0,,Монгер, өт!
Dialogue: 0,1:15:44.59,1:15:47.59,Default,,0,0,0,,Маған деген кекіңіз бар ма?
Dialogue: 0,1:15:47.59,1:15:49.59,Default,,0,0,0,,Муки…
Dialogue: 0,1:15:52.60,1:15:54.60,Default,,0,0,0,,Ах! Мен осындамын, қозғалма!
Dialogue: 0,1:15:54.60,1:15:57.60,Default,,0,0,0,,Уау! Қарғыс атсын, Монгер, сыртқа жүгіруден басқа амалым жоқ.
Dialogue: 0,1:15:57.60,1:16:00.59,Default,,0,0,0,,Тез кел, қазір қашып құтыла алмайсың.
Dialogue: 0,1:16:00.59,1:16:03.59,Default,,0,0,0,,Жарайды, оттегі маскасын киеміз.
Dialogue: 0,1:16:03.59,1:16:06.59,Default,,0,0,0,,Жарайды, торды ал. Иә.
Dialogue: 0,1:16:06.59,1:16:08.60,Default,,0,0,0,,Монгер Гуд.
Dialogue: 0,1:16:08.60,1:16:10.60,Default,,0,0,0,,Келесі жолы қателеспеңіз!
Dialogue: 0,1:16:10.60,1:16:12.60,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,1:16:12.60,1:16:15.60,Default,,0,0,0,,Монгер Асығыңыз! Монгер!
Dialogue: 0,1:16:18.59,1:16:22.59,Default,,0,0,0,,Ха... Мен мұнда басынан келуім керек еді.
Dialogue: 0,1:16:22.59,1:16:25.60,Default,,0,0,0,,Жарайды, енді круиздік кеме келгенде, телепортқа кетіңіз.
Dialogue: 0,1:16:25.60,1:16:27.60,Default,,0,0,0,,Атқа мінейік.
Dialogue: 0,1:16:27.60,1:16:30.60,Default,,0,0,0,,Ах! Бұл қазірдің өзінде соншалықты тұрақты
Dialogue: 0,1:16:41.60,1:16:43.60,Default,,0,0,0,,Ах! Мен бара алмаймын
Dialogue: 0,1:16:52.59,1:16:54.59,Default,,0,0,0,,Аа, жақсы.
Dialogue: 0,1:16:54.59,1:16:57.60,Default,,0,0,0,,Мен қауіпті жағдайға түсіп қала жаздадым.
Dialogue: 0,1:16:57.60,1:17:00.60,Default,,0,0,0,,Эй, мұнда кел!
Dialogue: 0,1:17:00.60,1:17:03.60,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:17:03.60,1:17:06.60,Default,,0,0,0,,Жақсы жұмыс Монгер, рахмет.
Dialogue: 0,1:17:06.60,1:17:09.60,Default,,0,0,0,,Енді мына планетаны зерттейік.
Dialogue: 0,1:17:11.59,1:17:13.59,Default,,0,0,0,,Кету!
Dialogue: 0,1:17:13.59,1:17:15.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:15.60,1:17:19.60,Default,,0,0,0,,Не? Бұл сатушы
Dialogue: 0,1:17:19.60,1:17:22.60,Default,,0,0,0,,Не? Бұл астероид емес пе?
Dialogue: 0,1:17:25.59,1:17:28.59,Default,,0,0,0,,Не? Мен сені ести алмаймын!
Dialogue: 0,1:17:28.59,1:17:30.59,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,1:17:30.59,1:17:33.60,Default,,0,0,0,,Бұл вакуум болғандықтан, сырттан дауыстар естілмейді.
Dialogue: 0,1:17:33.60,1:17:35.60,Default,,0,0,0,,Бұл капсула қабылдағыш.
Dialogue: 0,1:17:35.60,1:17:37.60,Default,,0,0,0,,Оны аузыңа сал
Dialogue: 0,1:17:43.59,1:17:47.60,Default,,0,0,0,,Мұндай жерге телепортация жасауға қалай дәтің бар!
Dialogue: 0,1:17:47.60,1:17:50.60,Default,,0,0,0,,Сіз жасайтын нәрселердің көбісі сіз әрқашан құтыласыз!
Dialogue: 0,1:17:50.60,1:17:52.60,Default,,0,0,0,,Муи муи муи!
Dialogue: 0,1:17:52.60,1:17:54.60,Default,,0,0,0,,Шығыс Дануки! Маған картоп беріңізші
Dialogue: 0,1:17:54.60,1:17:57.61,Default,,0,0,0,,Не! Бұл иммо робот...
Dialogue: 0,1:17:57.61,1:17:59.61,Default,,0,0,0,,Ооо! Сіз көп сөйледіңіз.
Dialogue: 0,1:17:59.61,1:18:03.59,Default,,0,0,0,,Екеуің ұрысуды доғарыңдар.
Dialogue: 0,1:18:03.59,1:18:07.59,Default,,0,0,0,,Ғарышқа бару қателік болды деп ойлаймын.
Dialogue: 0,1:18:19.59,1:18:22.60,Default,,0,0,0,,Монгер Сіз бірдеңе көре аласыз ба?
Dialogue: 0,1:18:22.60,1:18:24.60,Default,,0,0,0,,Муи…
Dialogue: 0,1:18:24.60,1:18:29.60,Default,,0,0,0,,Егер бұл орын алса, кеңістікте дөңгеленіп, мәңгі қараңғылықта қыдырайық.
Dialogue: 0,1:18:29.60,1:18:31.61,Default,,0,0,0,,Ола Янда
Dialogue: 0,1:18:31.61,1:18:35.59,Default,,0,0,0,,Картопты көрмейінше, мұндай романтик бола алмайсың.
Dialogue: 0,1:18:35.59,1:18:37.60,Default,,0,0,0,,Мысалы, осы жағдайда—
Dialogue: 0,1:18:37.60,1:18:39.60,Default,,0,0,0,,Ах! Зымыран болуы мүмкін
Dialogue: 0,1:18:39.60,1:18:41.60,Default,,0,0,0,,Мен картоп бар-жоғын білмеймін.
Dialogue: 0,1:18:44.60,1:18:47.60,Default,,0,0,0,,Муки! Бұл зымыран емес, метеорит!
Dialogue: 0,1:18:49.61,1:18:51.61,Default,,0,0,0,,Уау!
Dialogue: 0,1:18:56.60,1:18:58.60,Default,,0,0,0,,Анашым! Муки!
Dialogue: 0,1:18:58.60,1:19:01.60,Default,,0,0,0,,Оймо!
Dialogue: 0,1:19:01.60,1:19:03.60,Default,,0,0,0,,Я...
Dialogue: 0,1:19:05.61,1:19:09.59,Default,,0,0,0,,Мен бітті деп ойладым
Dialogue: 0,1:19:09.59,1:19:12.59,Default,,0,0,0,,Бұл жолы жұмыс істемеуі мүмкін, бірақ не?
Dialogue: 0,1:19:14.60,1:19:16.60,Default,,0,0,0,,Уау! Қайтадан
Dialogue: 0,1:19:18.60,1:19:20.60,Default,,0,0,0,,Ах! Бұл метеорит емес, бұл зымыран.
Dialogue: 0,1:19:20.60,1:19:23.60,Default,,0,0,0,,Муи картоп ака?
Dialogue: 0,1:19:25.61,1:19:27.60,Default,,0,0,0,,Монгер Телепорт Жақсы орындаңыз
Dialogue: 0,1:19:27.60,1:19:29.60,Default,,0,0,0,,Муимуи
Dialogue: 0,1:19:29.60,1:19:32.60,Default,,0,0,0,,Эй, эй!
Dialogue: 0,1:19:32.60,1:19:34.60,Default,,0,0,0,,Уау!
Dialogue: 0,1:19:37.61,1:19:39.61,Default,,0,0,0,,О, жоқ болып кетті.
Dialogue: 0,1:19:49.60,1:19:52.60,Default,,0,0,0,,Жоқ, массаметрдің бұрмалануы тек артады.
Dialogue: 0,1:19:52.60,1:19:55.61,Default,,0,0,0,,Қозғалтқыш өнімділігі 150%
Dialogue: 0,1:19:55.61,1:19:57.61,Default,,0,0,0,,Артық қуат өндірілмейді.
Dialogue: 0,1:20:02.60,1:20:04.60,Default,,0,0,0,,О...
Dialogue: 0,1:20:04.60,1:20:08.60,Default,,0,0,0,,Біртүрлі екен, әке, жұлдызды картаға қарашы.
Dialogue: 0,1:20:08.60,1:20:11.61,Default,,0,0,0,,Жұлдыздардың таралуы мүлде басқаша.
Dialogue: 0,1:20:11.61,1:20:14.61,Default,,0,0,0,,Ал, қайықты кәсіпқойларға тапсырыңыз.
Dialogue: 0,1:20:14.61,1:20:18.61,Default,,0,0,0,,Өйткені олар әйтеуір бір жерді айналып жүрген сияқты.
Dialogue: 0,1:20:28.61,1:20:31.61,Default,,0,0,0,,А... Муи...
Dialogue: 0,1:20:37.60,1:20:39.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:39.60,1:20:43.60,Default,,0,0,0,,Жоқ! Менде галлюцинация бар
Dialogue: 0,1:20:43.60,1:20:46.61,Default,,0,0,0,,Муки! Иә?
Dialogue: 0,1:20:46.61,1:20:48.61,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,1:20:48.61,1:20:50.61,Default,,0,0,0,,Бұрынғы зымыран тағы да келді.
Dialogue: 0,1:20:50.61,1:20:53.61,Default,,0,0,0,,Монгер, бұл жолы жақсырақ істе.
Dialogue: 0,1:20:53.61,1:20:56.60,Default,,0,0,0,,Муи!
Dialogue: 0,1:20:56.60,1:20:58.60,Default,,0,0,0,,Монгер!
Dialogue: 0,1:20:58.60,1:21:00.60,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:00.60,1:21:02.61,Default,,0,0,0,,Жоқ... не? сендер жігіттер
Dialogue: 0,1:21:02.61,1:21:05.61,Default,,0,0,0,,Ал, Эмон-кун, Луна-чан.
Dialogue: 0,1:21:05.61,1:21:09.61,Default,,0,0,0,,Демек, бұл Галактика? Тамаша!
Dialogue: 0,1:21:09.61,1:21:11.60,Default,,0,0,0,,Олай болса, тезірек менің тіземнен түс!
Dialogue: 0,1:21:11.60,1:21:13.60,Default,,0,0,0,,Не? Апыр-ай! Бұл...
Dialogue: 0,1:21:13.60,1:21:17.60,Default,,0,0,0,,Жолаушылар, тынышталып, тыңдаңыздар.
Dialogue: 0,1:21:17.60,1:21:23.61,Default,,0,0,0,,Кемені қатты гравитациялық дауыл соғып, басқаруды жоғалтты.
Dialogue: 0,1:21:23.61,1:21:25.61,Default,,0,0,0,,Орынды тез арада қалыпты жағдайына келтіріңіз
Dialogue: 0,1:21:25.61,1:21:28.61,Default,,0,0,0,,А класындағы ескерту күйін сақтаңыз.
Dialogue: 0,1:21:30.60,1:21:34.61,Default,,0,0,0,,Дұрыс! Бір қиындықтан кейін тағы бір...
Dialogue: 0,1:21:34.61,1:21:37.61,Default,,0,0,0,,Эмон-кун, тез орныңызға отырыңыз. Бұлай жүре берсең қауіпті.
Dialogue: 0,1:21:37.61,1:21:40.61,Default,,0,0,0,,Дәл солай, иә?
Dialogue: 0,1:21:40.61,1:21:43.61,Default,,0,0,0,,Ғарыштағы апаттардың алдын алуға болмайды
Dialogue: 0,1:21:43.61,1:21:45.62,Default,,0,0,0,,Менің өлгім келмейді!
Dialogue: 0,1:21:45.62,1:21:48.60,Default,,0,0,0,,Мені Галактика қонақ үйі алдап өлтірді!
Dialogue: 0,1:21:48.60,1:21:51.61,Default,,0,0,0,,Эмон-кун... Әке, не айтып тұрсыз?
Dialogue: 0,1:21:51.61,1:21:53.61,Default,,0,0,0,,Мен ұшқышқа барамын.
Dialogue: 0,1:21:53.61,1:21:55.61,Default,,0,0,0,,Гонсуке Монгер Муи
Dialogue: 0,1:21:55.61,1:21:57.61,Default,,0,0,0,,Эмон-кун
Dialogue: 0,1:22:04.60,1:22:06.60,Default,,0,0,0,,Мен өзіме қажет нәрсені жасадым.
Dialogue: 0,1:22:06.60,1:22:09.61,Default,,0,0,0,,Бұдан былай мен мұны сәттілікке қалдырамын.
Dialogue: 0,1:22:09.61,1:22:11.61,Default,,0,0,0,,Мен берілмеймін
Dialogue: 0,1:22:11.61,1:22:13.61,Default,,0,0,0,,Бұл кім? сен
Dialogue: 0,1:22:13.61,1:22:16.61,Default,,0,0,0,,Осы жерде өлсем, анам мен әкемді аяймын.
Dialogue: 0,1:22:16.61,1:22:18.62,Default,,0,0,0,,Монгер Гонсуке Муи
Dialogue: 0,1:22:18.62,1:22:20.60,Default,,0,0,0,,Жоқ, күте тұрыңыз, балалар мұны істей алмайсыз.
Dialogue: 0,1:22:20.60,1:22:22.60,Default,,0,0,0,,Мен бәрін сынап көрдім
Dialogue: 0,1:22:22.60,1:22:25.61,Default,,0,0,0,,Алты қосалқы қозғалтқыштар да істен шықты.
Dialogue: 0,1:22:25.61,1:22:27.61,Default,,0,0,0,,Әлі қалды!
Dialogue: 0,1:22:27.61,1:22:29.61,Default,,0,0,0,,Монгер! Муи?
Dialogue: 0,1:22:29.61,1:22:32.61,Default,,0,0,0,,Осы кемені толығымен телепортациялаңыз, Муи?
Dialogue: 0,1:22:32.61,1:22:35.62,Default,,0,0,0,,Телепортацияның гравитацияға еш қатысы жоқ, солай ма? сатушы
Dialogue: 0,1:22:35.62,1:22:37.62,Default,,0,0,0,,Муи
Dialogue: 0,1:22:37.62,1:22:40.60,Default,,0,0,0,,Олай болса, оларды бір мезгілде 3 км, бір уақытта 3 км гравитациялық дауылдан шығарыңыз.
Dialogue: 0,1:22:40.60,1:22:42.61,Default,,0,0,0,,Муи! Өтінемін, Монгер.
Dialogue: 0,1:22:42.61,1:22:47.61,Default,,0,0,0,,О, мен картоп жұлдызын таппайынша, сынғым келмейді. Мен бұзылғым келмейді!
Dialogue: 0,1:22:47.61,1:22:50.61,Default,,0,0,0,,Ммм…
Dialogue: 0,1:22:50.61,1:22:52.61,Default,,0,0,0,,Монгер!
Dialogue: 0,1:22:56.60,1:22:58.61,Default,,0,0,0,,Жоқ! қайтадан біріктірілді
Dialogue: 0,1:22:58.61,1:23:00.61,Default,,0,0,0,,Тағы да Монгер!
Dialogue: 0,1:23:00.61,1:23:02.61,Default,,0,0,0,,Монгер!
Dialogue: 0,1:23:02.61,1:23:06.61,Default,,0,0,0,,Сәттілік Монгер Монгер!
Dialogue: 0,1:23:08.62,1:23:11.62,Default,,0,0,0,,Монгер! Монгер!
Dialogue: 0,1:23:11.62,1:23:14.61,Default,,0,0,0,,Монгер!
Dialogue: 0,1:23:14.61,1:23:16.61,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Монгер.
Dialogue: 0,1:23:16.61,1:23:18.61,Default,,0,0,0,,Сәттілік Монгер
Dialogue: 0,1:23:18.61,1:23:20.61,Default,,0,0,0,,Мо… ай… Монгер!
Dialogue: 0,1:23:23.61,1:23:27.62,Default,,0,0,0,,Монгер! Монгер!
Dialogue: 0,1:23:27.62,1:23:29.60,Default,,0,0,0,,Әй, менің...
Dialogue: 0,1:23:29.60,1:23:32.60,Default,,0,0,0,,Менің мына қолым ғарыш кемесін қозғалтатын күшке ие болса ғой
Dialogue: 0,1:23:34.61,1:23:36.61,Default,,0,0,0,,Ум! Эй сен!
Dialogue: 0,1:23:36.61,1:23:38.61,Default,,0,0,0,,Маған тиіспе, эй!
Dialogue: 0,1:23:38.61,1:23:41.63,Default,,0,0,0,,Тоқтамасаң, бәлеге қаласың.
Dialogue: 0,1:23:41.63,1:23:43.62,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:23:43.62,1:23:46.60,Default,,0,0,0,,Күте тұрыңыз! Қозғалтқыш өмірге оралды
Dialogue: 0,1:23:46.60,1:23:48.61,Default,,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,1:23:48.61,1:23:50.61,Default,,0,0,0,,О... бұл рас.
Dialogue: 0,1:23:50.61,1:23:52.61,Default,,0,0,0,,А, мұндай нәрсе бар ма?
Dialogue: 0,1:23:55.61,1:23:58.62,Default,,0,0,0,,Монгер, тағы бір дем.
Dialogue: 0,1:23:58.62,1:24:00.62,Default,,0,0,0,,Монгер Бадди Ей, өзіңізді ұстаңыз!
Dialogue: 0,1:24:00.62,1:24:02.60,Default,,0,0,0,,Ей, ей!
Dialogue: 0,1:24:02.60,1:24:04.61,Default,,0,0,0,,Монгер өлді!
Dialogue: 0,1:24:04.61,1:24:08.61,Default,,0,0,0,,Монгер Келесі жолы телепорталсаңыз, сізді кері қайтармайды!
Dialogue: 0,1:24:08.61,1:24:11.61,Default,,0,0,0,,Монгер, қолыңнан келгеннің бәрін жаса! Қараңызшы, дем алатын уақыт келді!
Dialogue: 0,1:24:23.61,1:24:26.61,Default,,0,0,0,,Монгер!
Dialogue: 0,1:24:36.62,1:24:39.61,Default,,0,0,0,,О? әке
Dialogue: 0,1:24:39.61,1:24:43.61,Default,,0,0,0,,Әке, магниттік дауылдан аман қалған сияқтымыз. иә?
Dialogue: 0,1:24:43.61,1:24:45.61,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,1:24:48.62,1:24:52.62,Default,,0,0,0,,Монгер, сіз сәтті болдыңыз. Жарайсың.
Dialogue: 0,1:24:52.62,1:24:55.61,Default,,0,0,0,,Капитан, бұл шынымен де керемет.
Dialogue: 0,1:24:55.61,1:24:58.61,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,1:24:58.61,1:25:01.61,Default,,0,0,0,,Жарайды, ескертуді жіберейік. Иә.
Dialogue: 0,1:25:01.61,1:25:05.62,Default,,0,0,0,,Капитан, бұл нені білдіреді?
Dialogue: 0,1:25:05.62,1:25:07.62,Default,,0,0,0,,Білмеймін, бірақ мені мына бала құтқарды.
Dialogue: 0,1:25:07.62,1:25:09.62,Default,,0,0,0,,Нағыз данышпан
Dialogue: 0,1:25:09.62,1:25:11.62,Default,,0,0,0,,Бала?
Dialogue: 0,1:25:13.61,1:25:15.61,Default,,0,0,0,,Эмон-кун!
Dialogue: 0,1:25:15.61,1:25:18.61,Default,,0,0,0,,Бұл Эмон болды ма? Бұл керемет
Dialogue: 0,1:25:18.61,1:25:21.62,Default,,0,0,0,,Рахмет, Эмон. Қауіп өткен сияқты.
Dialogue: 0,1:25:21.62,1:25:24.62,Default,,0,0,0,,Рахмет, қалғанын өзіміз шешеміз.
Dialogue: 0,1:25:24.62,1:25:27.62,Default,,0,0,0,,Луна-чан, Монгер мен Гонсуке ше?
Dialogue: 0,1:25:27.62,1:25:29.61,Default,,0,0,0,,Монгер Жақсысың ба?
Dialogue: 0,1:25:29.61,1:25:32.61,Default,,0,0,0,,Ештеңе етпейді, мен мұндай нәрселерге көнбейтін енот емеспін.
Dialogue: 0,1:25:32.61,1:25:34.61,Default,,0,0,0,,Муэ!
Dialogue: 0,1:25:34.61,1:25:36.61,Default,,0,0,0,,Ахаха аа...
Dialogue: 0,1:25:36.61,1:25:38.61,Default,,0,0,0,,Эмон-кун! Эмон-кун
Dialogue: 0,1:25:43.62,1:25:46.61,Default,,0,0,0,,Эмон, әкең сені алдады.
Dialogue: 0,1:25:46.61,1:25:48.61,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,1:25:48.61,1:25:51.61,Default,,0,0,0,,Жарайды, мен сіздің арқаңызда ғарышқа саяхаттай алдым.
Dialogue: 0,1:25:51.61,1:25:54.61,Default,,0,0,0,,Сонымен қатар мен көп тәжірибе жинақтай алдым.
Dialogue: 0,1:25:54.61,1:25:57.62,Default,,0,0,0,,Мен сіздің армандарыңызды үлкенірек еткім келді
Dialogue: 0,1:25:57.62,1:25:59.62,Default,,0,0,0,,Ол ешкімнің жан дүниесін бақылауға мүлде қауқарсыз
Dialogue: 0,1:25:59.62,1:26:01.62,Default,,0,0,0,,Сіз сияқты шебер
Dialogue: 0,1:26:01.62,1:26:03.62,Default,,0,0,0,,Сіз керемет ғарыш ұшқышы бола аласыз.
Dialogue: 0,1:26:03.62,1:26:06.61,Default,,0,0,0,,Жоқ, мен оны сынамадым.
Dialogue: 0,1:26:06.61,1:26:08.61,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:08.61,1:26:11.61,Default,,0,0,0,,Рахмет саған Укики ағашы
Dialogue: 0,1:26:25.61,1:26:29.62,Default,,0,0,0,,Бұл кеңістікте жиі болады. Ах...
Dialogue: 0,1:26:29.62,1:26:35.62,Default,,0,0,0,,Бұл жер бетінде әдемі таң болды, сондықтан мен аздап көмектестім.
Dialogue: 0,1:26:37.62,1:26:41.62,Default,,0,0,0,,Ал, үйге барғанда абай бол.
Dialogue: 0,1:26:53.62,1:26:55.62,Default,,0,0,0,,Қош бол Укики ағашы
Dialogue: 0,1:27:15.61,1:27:18.62,Default,,0,0,0,,Жер ғаламның шетінде болса керек...
Dialogue: 0,1:27:18.62,1:27:21.62,Default,,0,0,0,,Бірақ бәрібір әдемі.
Dialogue: 0,1:27:21.62,1:27:25.62,Default,,0,0,0,,Бұл әдемі. Маған Жер ұнайды.
Dialogue: 0,1:27:25.62,1:27:27.62,Default,,0,0,0,,Иә? Бүгінгі сөз шықты
Dialogue: 0,1:27:27.62,1:27:30.61,Default,,0,0,0,,Ракон ит болсаң да, түсінбейсің бе? Муи!
Dialogue: 0,1:27:30.61,1:27:32.61,Default,,0,0,0,,Монгер!
Dialogue: 0,1:27:32.61,1:27:35.61,Default,,0,0,0,,Ахахха... хехехе...
Dialogue: 0,1:27:37.62,1:27:39.62,Default,,0,0,0,,Уау!
Dialogue: 0,1:27:39.62,1:27:41.62,Default,,0,0,0,,Мына ақымақ Дануки!
Dialogue: 0,1:27:41.62,1:27:44.62,Default,,0,0,0,,Келесі жолы сені көргенде, мен оны әбігерге саламын...
Dialogue: 0,1:27:44.62,1:27:48.61,Default,,0,0,0,,Ия... Яя Яяя!
Dialogue: 0,1:27:48.61,1:27:51.62,Default,,0,0,0,,Аа, мен сені қатты сағындым.
Dialogue: 0,1:27:51.62,1:27:53.62,Default,,0,0,0,,Оймо!
Dialogue: 0,1:28:09.62,1:28:11.62,Default,,0,0,0,,Монгер, барлығы үшін рахмет.
Dialogue: 0,1:28:11.62,1:28:15.62,Default,,0,0,0,,Ғарышқа саяхат шынымен қызықты болды Муи
Dialogue: 0,1:28:15.62,1:28:19.63,Default,,0,0,0,,Иә, енді мен шешім қабылдадым.
Dialogue: 0,1:28:19.63,1:28:22.61,Default,,0,0,0,,Эмон, бір сәт осында кел.
Dialogue: 0,1:28:22.61,1:28:24.61,Default,,0,0,0,,Эмон, онда.
Dialogue: 0,1:28:24.61,1:28:26.62,Default,,0,0,0,,Шешіміңізді тыңдайық.
Dialogue: 0,1:28:26.62,1:28:29.62,Default,,0,0,0,,Сіз шынымен ғарыш ұшқышы болғыңыз келе ме?
Dialogue: 0,1:28:29.62,1:28:32.62,Default,,0,0,0,,Уайымдама, мен гобелен цехын өз қолыма аламын.
Dialogue: 0,1:28:32.62,1:28:34.62,Default,,0,0,0,,Эмон хахаха...
Dialogue: 0,1:28:34.62,1:28:36.63,Default,,0,0,0,,Көрдім, жақсы болды, жақсы болды.
Dialogue: 0,1:28:36.63,1:28:39.61,Default,,0,0,0,,Сондықтан бұл 21-ші буын.
Dialogue: 0,1:28:39.61,1:28:42.62,Default,,0,0,0,,Оның орнына, әке, оны өз қалауымша өзгертуге рұқсат етіңіз.
Dialogue: 0,1:28:42.62,1:28:44.62,Default,,0,0,0,,Осы қонақүйді қалайсыз ба? Иә, жақсы
Dialogue: 0,1:28:44.62,1:28:47.62,Default,,0,0,0,,Алдымен қонақ үйдің қабырғаларын екі еселендіріңіз.
Dialogue: 0,1:28:47.62,1:28:49.62,Default,,0,0,0,,Хун ғұн
Dialogue: 0,1:28:49.62,1:28:52.63,Default,,0,0,0,,Жанармай қоймасын ұлғайту Әрине.
Dialogue: 0,1:28:52.63,1:28:54.63,Default,,0,0,0,,Машина бөлмесін қосу...
Dialogue: 0,1:28:54.63,1:28:56.63,Default,,0,0,0,,Нарухо…
Dialogue: 0,1:28:56.63,1:28:58.62,Default,,0,0,0,,Не? қозғалтқыш?
Dialogue: 0,1:28:58.62,1:29:01.62,Default,,0,0,0,,Мен кабинаны өз бөлмеме айналдырамын.
Dialogue: 0,1:29:01.62,1:29:04.62,Default,,0,0,0,,Міне! Эймон, сен не айтып тұрсың?
Dialogue: 0,1:29:04.62,1:29:06.62,Default,,0,0,0,,Әрине қонақ үйлер!
Dialogue: 0,1:29:06.62,1:29:08.63,Default,,0,0,0,,Ұшатын қонақүй!
Dialogue: 0,1:29:08.63,1:29:10.63,Default,,0,0,0,,Ұшатын қонақ үй?
Dialogue: 0,1:29:20.62,1:29:24.62,Default,,0,0,0,,Бұл 21 ғасырдың ең жақсы қонақ үйі
Dialogue: 0,1:29:24.62,1:29:28.63,Default,,0,0,0,,Клиенттерді қарсы алу үшін ғарышта еркін ұшыңыз
Dialogue: 0,1:29:28.63,1:29:30.63,Default,,0,0,0,,Муи
Dialogue: 0,1:29:30.63,1:29:33.62,Default,,0,0,0,,Бір күні мен мұны істеймін, мен мұны істейтініме сенімдімін!
Dialogue: 0,1:29:33.62,1:29:36.62,Default,,0,0,0,,Эмон-кун Эмон-кун!
Dialogue: 0,1:29:36.62,1:29:39.62,Default,,0,0,0,,О, құдай-ау, тағы да мектеп. Жақсы.
Dialogue: 0,1:29:39.62,1:29:42.63,Default,,0,0,0,,Мектеп басталды.
Dialogue: 0,1:29:42.63,1:29:44.63,Default,,0,0,0,,Уа!
Dialogue: 0,1:29:44.63,1:29:46.63,Default,,0,0,0,,Бүгін тура 100 жыл бұрын болды
Dialogue: 0,1:29:46.63,1:29:48.52,Default,,0,0,0,,Ғарыш кемесі ұшырылды
Dialogue: 0,1:29:48.52,1:29:50.52,Default,,0,0,0,,Бұл мерейтой.
Dialogue: 0,1:29:52.02,1:29:58.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
