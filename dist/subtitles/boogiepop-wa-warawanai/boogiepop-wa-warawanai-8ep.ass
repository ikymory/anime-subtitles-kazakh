Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.75,0:00:07.13,Default,,0,0,0,,♪～
Dialogue: 0,0:01:23.66,0:01:28.67,Default,,0,0,0,,～♪
Dialogue: 0,0:01:32.05,0:01:34.30,Default,,0,0,0,,«Сенің барлық үмітің ақталады...»
Dialogue: 0,0:01:34.42,0:01:36.97,Default,,0,0,0,,«Болашақта, бәрібір».
Dialogue: 0,0:01:37.63,0:01:42.47,Default,,0,0,0,,«Қанша армандасаң да, сен емес, кейінгі ұрпақ алады».
Dialogue: 0,0:01:42.72,0:01:45.39,Default,,0,0,0,,«Ал олар үшін бұл арман емес...»
Dialogue: 0,0:01:45.52,0:01:47.60,Default,,0,0,0,,«Бұл жай ғана орындалды»
Dialogue: 0,0:01:48.31,0:01:51.73,Default,,0,0,0,,«Мұндай құрбандықтар адамдарды жалғастырады».
Dialogue: 0,0:01:54.11,0:01:55.24,Default,,0,0,0,,Құрбан шалу?
Dialogue: 0,0:01:55.65,0:01:59.24,Default,,0,0,0,,Иә, ол төрт күн бойы хабарсыз кеткен сияқты.
Dialogue: 0,0:01:59.53,0:02:00.91,Default,,0,0,0,,Тест қалай өтті?
Dialogue: 0,0:01:59.53,0:02:00.91,Default,,0,0,0,,Сондай-ақ, мен біртүрлі өсек естідім.
Dialogue: 0,0:02:00.91,0:02:01.03,Default,,0,0,0,,Сондай-ақ, мен біртүрлі өсек естідім.
Dialogue: 0,0:02:01.03,0:02:01.74,Default,,0,0,0,,Сондай-ақ, мен біртүрлі өсек естідім.
Dialogue: 0,0:02:01.03,0:02:01.74,Default,,0,0,0,,Хмм, бұл біртүрлі болды.
Dialogue: 0,0:02:01.74,0:02:02.78,Default,,0,0,0,,Хмм, бұл біртүрлі болды.
Dialogue: 0,0:02:02.91,0:02:04.16,Default,,0,0,0,,Сіз маған үйреткен нәрсені істей алдым, бірақ...
Dialogue: 0,0:02:04.16,0:02:05.41,Default,,0,0,0,,Сіз маған үйреткен нәрсені істей алдым, бірақ...
Dialogue: 0,0:02:04.16,0:02:05.41,Default,,0,0,0,,Иә, бұл Кинугава мырза туралы.
Dialogue: 0,0:02:05.41,0:02:06.41,Default,,0,0,0,,Иә, бұл Кинугава мырза туралы.
Dialogue: 0,0:02:06.54,0:02:07.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:08.58,0:02:10.13,Default,,0,0,0,,Бұл бала, мен сенімдімін...
Dialogue: 0,0:02:12.88,0:02:14.59,Default,,0,0,0,,Не болды, Суэма?
Dialogue: 0,0:02:14.71,0:02:16.76,Default,,0,0,0,,Барабан ырғағымен бірге қозғалып, ол жыртқыш жануардың тырнақ іздерінің пішінін алды.
Dialogue: 0,0:02:17.26,0:02:19.13,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:02:20.97,0:02:22.68,Default,,0,0,0,,Егер сізде бірдеңе болса...
Dialogue: 0,0:02:22.80,0:02:23.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:23.76,0:02:26.18,Default,,0,0,0,,Достарыңмен сөйлесу керек
Dialogue: 0,0:02:26.52,0:02:28.81,Default,,0,0,0,,Достық осы үшін керек.
Dialogue: 0,0:02:29.89,0:02:31.69,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:02:31.94,0:02:32.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:33.73,0:02:36.99,Default,,0,0,0,,Соңғы кездері оның төңірегінде қауесеттер айтылып жүр.
Dialogue: 0,0:02:39.82,0:02:41.41,Default,,0,0,0,,Бұл мен үшін маңызды...
Dialogue: 0,0:02:41.53,0:02:44.24,Default,,0,0,0,,Жасөспірімдік шақта болатын заттардың қандай түрлері бар?
Dialogue: 0,0:02:44.37,0:02:46.29,Default,,0,0,0,,Бұл басқаша көрінді.
Dialogue: 0,0:02:48.04,0:02:50.46,Default,,0,0,0,,Әрине, мен онымен тікелей кездескендей әсер алдым, бірақ...
Dialogue: 0,0:02:50.46,0:02:51.79,Default,,0,0,0,,Әрине, мен онымен тікелей кездескендей әсер алдым, бірақ...
Dialogue: 0,0:02:50.46,0:02:51.79,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:51.79,0:02:52.54,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:52.54,0:02:55.88,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:52.54,0:02:55.88,Default,,0,0,0,,Мен нәрселердің мағынасы жоқ екенін сезінбеймін.
Dialogue: 0,0:02:56.46,0:02:58.26,Default,,0,0,0,,Сіз Хитоши Асукайсыз ба?
Dialogue: 0,0:02:59.47,0:03:02.39,Default,,0,0,0,,Иә, бірақ сіз мұнда студентсіз бе?
Dialogue: 0,0:03:02.68,0:03:05.89,Default,,0,0,0,,Мен сенімен біраз сөйлескім келеді, жарай ма?
Dialogue: 0,0:03:06.14,0:03:08.77,Default,,0,0,0,,А, жарайды. Менің ойымша, бұл мансаптық кеңес беру.
Dialogue: 0,0:03:09.18,0:03:12.40,Default,,0,0,0,,Жоқ, Котоэ Кинугаваның досы ретінде.
Dialogue: 0,0:03:15.40,0:03:16.44,Default,,0,0,0,,Кинугава мырза
Dialogue: 0,0:03:16.57,0:03:19.90,Default,,0,0,0,,Жақында жағдай өзгерді дегенді естімедің бе?
Dialogue: 0,0:03:20.19,0:03:23.74,Default,,0,0,0,,А, мен енді білдім.
Dialogue: 0,0:03:24.20,0:03:25.53,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:03:25.83,0:03:26.83,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:03:27.20,0:03:30.37,Default,,0,0,0,,Сіз Кинугава мырзаға ұнап қалдыңыз.
Dialogue: 0,0:03:30.79,0:03:33.42,Default,,0,0,0,,А, Усусу байқады.
Dialogue: 0,0:03:33.96,0:03:36.21,Default,,0,0,0,,Бірақ Киногава-сан қазір...
Dialogue: 0,0:03:36.34,0:03:39.30,Default,,0,0,0,,Ол сіз туралы ештеңе ойламайтын шығар.
Dialogue: 0,0:03:39.42,0:03:41.63,Default,,0,0,0,,Бұл оған жақсырақ.
Dialogue: 0,0:03:42.18,0:03:44.68,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:03:44.80,0:03:45.72,Default,,0,0,0,,Не?
Dialogue: 0,0:03:46.47,0:03:49.10,Default,,0,0,0,,Ол неге өзгерді?
Dialogue: 0,0:03:50.10,0:03:51.68,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:03:52.14,0:03:53.85,Default,,0,0,0,,Әйтеуір менде солай...
Dialogue: 0,0:03:54.40,0:03:57.69,Default,,0,0,0,,Кинугава мырза сізді уайымдады.
Dialogue: 0,0:03:57.82,0:03:59.86,Default,,0,0,0,,Мазасыз ба? Не айтқың келеді?
Dialogue: 0,0:04:00.32,0:04:03.28,Default,,0,0,0,,Мен уәде бергендіктен айта алмаймын.
Dialogue: 0,0:04:04.03,0:04:05.24,Default,,0,0,0,,Бірақ танысайық...
Dialogue: 0,0:04:05.37,0:04:08.37,Default,,0,0,0,,Мен Киногава-санның сезімін аздап түсінгендей болдым.
Dialogue: 0,0:04:08.91,0:04:10.58,Default,,0,0,0,,Ол да өзгерді...
Dialogue: 0,0:04:10.70,0:04:14.75,Default,,0,0,0,,Мүмкін сіз де өзгерген шығарсыз.
Dialogue: 0,0:04:14.96,0:04:16.42,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:04:16.88,0:04:21.09,Default,,0,0,0,,Мен оның сезіміне жауап бере алмаймын деп ойлаймын.
Dialogue: 0,0:04:21.21,0:04:22.76,Default,,0,0,0,,Болды (Асукай) А?
Dialogue: 0,0:04:23.17,0:04:24.43,Default,,0,0,0,,Өткенде сіз үшін...
Dialogue: 0,0:04:24.55,0:04:28.01,Default,,0,0,0,,Менің бұлай қамқорлық жасау сәні болмады деп ойлаймын.
Dialogue: 0,0:04:28.26,0:04:32.77,Default,,0,0,0,,Киногава-сан сіздің күшіңіз болғысы келгеніне сенімдімін.
Dialogue: 0,0:04:34.64,0:04:36.52,Default,,0,0,0,,Бұл жалғыз сурет, солай емес пе?
Dialogue: 0,0:04:37.06,0:04:39.27,Default,,0,0,0,,Бұл тек сіз екеніңізге сенімдімін.
Dialogue: 0,0:04:39.40,0:04:40.36,Default,,0,0,0,,Өзгертпес бұрын
Dialogue: 0,0:04:40.48,0:04:42.15,Default,,0,0,0,,Менің сізден сурет салу туралы сұрағым бар...
Dialogue: 0,0:04:47.87,0:04:51.16,Default,,0,0,0,,Жоқ, сіз өте ақылды сияқтысыз.
Dialogue: 0,0:04:51.79,0:04:52.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:52.75,0:04:55.62,Default,,0,0,0,,Сондықтан болар, бұл іс оңға баспайды.
Dialogue: 0,0:04:55.75,0:04:56.83,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:04:56.96,0:04:58.33,Default,,0,0,0,,Сіз доспын дедіңіз...
Dialogue: 0,0:04:58.46,0:05:01.80,Default,,0,0,0,,Менің ойымша, сіз және Котоэ онша жақсы араласатын түрі жоқ.
Dialogue: 0,0:05:02.67,0:05:05.09,Default,,0,0,0,,Сіз тек өзіңізді сендіргіңіз келеді
Dialogue: 0,0:05:05.63,0:05:06.76,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:05:07.55,0:05:10.68,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:11.26,0:05:12.81,Default,,0,0,0,,Бірақ... (Асукай) Не?
Dialogue: 0,0:05:13.18,0:05:14.85,Default,,0,0,0,,Мен оны құтқарғым келеді.
Dialogue: 0,0:05:14.98,0:05:16.31,Default,,0,0,0,,Өйткені біз жақын емеспіз...
Dialogue: 0,0:05:16.73,0:05:19.11,Default,,0,0,0,,Мен Кинугава-санға көмектескім келеді.
Dialogue: 0,0:05:19.36,0:05:20.48,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:20.82,0:05:24.82,Default,,0,0,0,,Ол үшін алдымен сенімен танысуым керек деп ойлаймын...
Dialogue: 0,0:05:25.15,0:05:26.49,Default,,0,0,0,,Мен туралы
Dialogue: 0,0:05:27.91,0:05:30.49,Default,,0,0,0,,Менің не істеп жатқанымды білгің келе ме?
Dialogue: 0,0:05:30.62,0:05:31.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:31.91,0:05:34.58,Default,,0,0,0,,Мен әлемді өзгерткім келеді
Dialogue: 0,0:05:35.25,0:05:39.13,Default,,0,0,0,,Адамдардың жүрегіндегі жетіспейтін нәрсені әйтеуір толтыруға тырысу...
Dialogue: 0,0:05:39.25,0:05:40.59,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:05:40.96,0:05:42.55,Default,,0,0,0,,Мұны істеу әдісі ретінде -
Dialogue: 0,0:05:42.67,0:05:46.09,Default,,0,0,0,,Адамдардың жүрегіне «гүл тұқымын» себу ойымда бар.
Dialogue: 0,0:05:47.80,0:05:50.30,Default,,0,0,0,,Мәселе «түрлердің» тепе-теңдігі болды.
Dialogue: 0,0:05:50.72,0:05:53.18,Default,,0,0,0,,Ештеңе қалыптаспаған...
Dialogue: 0,0:05:53.47,0:05:56.18,Default,,0,0,0,,Бірде-бір тілегім орындалмады.
Dialogue: 0,0:05:56.31,0:05:59.81,Default,,0,0,0,,Алайда, сондықтан оның барлық элементтері бар деп айтылады.
Dialogue: 0,0:05:59.94,0:06:01.94,Default,,0,0,0,,Осындай «түрлердің» балансы
Dialogue: 0,0:06:02.69,0:06:03.98,Default,,0,0,0,,Не дегенің? Сендер бір жақта емессіңдер ме?
Dialogue: 0,0:06:04.11,0:06:08.07,Default,,0,0,0,,Мен мұндай тепе-теңдігі бар қызды бұрын да көргенмін.
Dialogue: 0,0:06:08.86,0:06:13.08,Default,,0,0,0,,Бар болғаны қызды тауып, «тұқымдарын» шығарып, бүкіл әлемге тарату.
Dialogue: 0,0:06:14.33,0:06:16.04,Default,,0,0,0,,Ақырында тамыр жайған «тұқыммен» -
Dialogue: 0,0:06:16.16,0:06:18.50,Default,,0,0,0,,Дүниенің адамдары, тіпті байқамай...
Dialogue: 0,0:06:18.62,0:06:20.83,Default,,0,0,0,,Жүрегіңдегі бос орын толтырылады
Dialogue: 0,0:06:21.75,0:06:23.42,Default,,0,0,0,,Қыз сол үшін құрбандыққа шалынады.
Dialogue: 0,0:06:23.54,0:06:24.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:25.38,0:06:27.84,Default,,0,0,0,,Сенің де жүрегіңде бірдеңе жетіспейді
Dialogue: 0,0:06:27.97,0:06:29.34,Default,,0,0,0,,Оны өзіңіз білесіз.
Dialogue: 0,0:06:29.47,0:06:30.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:30.80,0:06:33.64,Default,,0,0,0,,Егер мен оны толтырамын десем...
Dialogue: 0,0:06:34.26,0:06:35.68,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:06:36.89,0:06:38.43,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:38.56,0:06:41.02,Default,,0,0,0,,Маған басқа біреу көмектесті.
Dialogue: 0,0:06:41.69,0:06:43.44,Default,,0,0,0,,Кім?
Dialogue: 0,0:06:43.86,0:06:45.27,Default,,0,0,0,,Бугипоп.
Dialogue: 0,0:06:45.78,0:06:48.78,Default,,0,0,0,,Әй, сол әділдік одақтасы ма?
Dialogue: 0,0:06:48.90,0:06:51.03,Default,,0,0,0,,Бұл оңай емес...
Dialogue: 0,0:06:51.36,0:06:53.74,Default,,0,0,0,,Сонда сіз...
Dialogue: 0,0:06:53.87,0:06:55.54,Default,,0,0,0,,Әлемді өзгерту...
Dialogue: 0,0:06:55.66,0:06:56.79,Default,,0,0,0,,Сурет бойынша әңгіме
Dialogue: 0,0:06:57.29,0:06:58.91,Default,,0,0,0,,Не? (Асукай) Ой
Dialogue: 0,0:06:59.04,0:07:01.79,Default,,0,0,0,,Барлық суретшілердің сезімдері ұқсас.
Dialogue: 0,0:07:02.04,0:07:05.71,Default,,0,0,0,,Бірақ қыздың құрбандыққа шалынатынын айттыңыз.
Dialogue: 0,0:07:05.84,0:07:08.76,Default,,0,0,0,,Ахаха... Суреттің үлгісі 8 сағатқа жуық уақытты алды.
Dialogue: 0,0:07:08.88,0:07:10.55,Default,,0,0,0,,Сіз қозғалмай тұруыңыз керек.
Dialogue: 0,0:07:11.43,0:07:14.43,Default,,0,0,0,,Қыз... жарайды, ол модель.
Dialogue: 0,0:07:14.72,0:07:17.81,Default,,0,0,0,,Котое қызғаныш сезімін тудыратын шығар.
Dialogue: 0,0:07:18.06,0:07:21.06,Default,,0,0,0,,Сондықтан мен Котое-чанмен кездесіп, түсінбеушіліктерді түзетемін.
Dialogue: 0,0:07:23.98,0:07:25.73,Default,,0,0,0,,Солай ма...?
Dialogue: 0,0:07:27.23,0:07:28.44,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:29.28,0:07:30.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:37.79,0:07:40.33,Default,,0,0,0,,Сіз бұл баланы қайдан білдіңіз?
Dialogue: 0,0:07:41.33,0:07:44.46,Default,,0,0,0,,Бұл ерекше ештеңе болған жоқ.
Dialogue: 0,0:07:46.42,0:07:48.75,Default,,0,0,0,,Ол дұрыс.
Dialogue: 0,0:07:49.09,0:07:51.97,Default,,0,0,0,,Алдымен осымен айналысуымыз керек сияқты.
Dialogue: 0,0:07:53.09,0:07:54.84,Default,,0,0,0,,Қарсыласу енді болмай қоймайды
Dialogue: 0,0:07:55.80,0:07:57.85,Default,,0,0,0,,Spooky E ойынын тікелей ойнаңыз
Dialogue: 0,0:08:02.85,0:08:04.85,Default,,0,0,0,,Бұл, әрине, ол.
Dialogue: 0,0:08:05.31,0:08:07.86,Default,,0,0,0,,Мен сенің мұндай жерде ұйықтап жатқаныңды білмедім.
Dialogue: 0,0:08:08.52,0:08:13.24,Default,,0,0,0,,Эй, мен Бугипопты өте байсалды ойнаймын.
Dialogue: 0,0:08:24.58,0:08:28.29,Default,,0,0,0,,Оны киген 2 адам... Жоқ, барлығы 6 адам.
Dialogue: 0,0:08:30.34,0:08:32.92,Default,,0,0,0,,Бірақ ол әйел мені неге қалады?
Dialogue: 0,0:08:33.76,0:08:36.22,Default,,0,0,0,,Күткендей, бұл әйел бірдеңені біледі...
Dialogue: 0,0:08:36.34,0:08:37.43,Default,,0,0,0,,Ешқандай қате жоқ сияқты.
Dialogue: 0,0:08:39.68,0:08:40.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:42.14,0:08:44.60,Default,,0,0,0,,(миниондардың ауыр тыныс алуы)
Dialogue: 0,0:08:52.28,0:08:53.78,Default,,0,0,0,,Бір жерде жасырылған сияқты
Dialogue: 0,0:08:53.90,0:08:55.57,Default,,0,0,0,,Іздеуді бөлу керек пе?
Dialogue: 0,0:08:56.28,0:08:59.33,Default,,0,0,0,,Күте тұрыңыз, менде бір идея бар.
Dialogue: 0,0:09:00.62,0:09:02.70,Default,,0,0,0,,Сәлем Масаки Танигучи
Dialogue: 0,0:09:03.25,0:09:07.42,Default,,0,0,0,,Сіз бұл қыз үшін Бугипоп жасай бересіз, солай ма?
Dialogue: 0,0:09:07.54,0:09:11.21,Default,,0,0,0,,Бірақ мұндай әйелге міндетті болудың қажеті жоқ.
Dialogue: 0,0:09:12.13,0:09:15.59,Default,,0,0,0,,Маған қызық, ол баланы кім не қылды...
Dialogue: 0,0:09:15.72,0:09:16.80,Default,,0,0,0,,Себебі мен сені жақсы білемін
Dialogue: 0,0:09:17.30,0:09:18.51,Default,,0,0,0,,Және фитнес тестінде де мен нашар өттім…
Dialogue: 0,0:09:18.64,0:09:21.81,Default,,0,0,0,,Сол қызды артындағы «қоғамдық әжетхана» дейді.
Dialogue: 0,0:09:22.22,0:09:24.81,Default,,0,0,0,,Ойланып қарасаң, сен де аянышты адамсың.
Dialogue: 0,0:09:24.93,0:09:28.31,Default,,0,0,0,,Жүрегімнің таза келбеті мені алдады
Dialogue: 0,0:09:31.23,0:09:32.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:34.74,0:09:35.86,Default,,0,0,0,,Практикалық емтихан: Дайын бол, баста!
Dialogue: 0,0:09:40.07,0:09:40.95,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:09:42.66,0:09:43.87,Default,,0,0,0,,Гуах
Dialogue: 0,0:09:46.71,0:09:47.62,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:49.17,0:09:50.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:51.67,0:09:52.63,Default,,0,0,0,,Гррр…
Dialogue: 0,0:09:54.71,0:09:57.55,Default,,0,0,0,,Мұны істеме Масаки Танигучи
Dialogue: 0,0:09:58.01,0:09:59.72,Default,,0,0,0,,Мен Масаки Танигучи емеспін
Dialogue: 0,0:10:01.51,0:10:03.01,Default,,0,0,0,,Бугипоп
Dialogue: 0,0:10:03.31,0:10:05.02,Default,,0,0,0,,Егер сіз Axis-ке есеп берсеңіз
Dialogue: 0,0:10:05.14,0:10:07.56,Default,,0,0,0,,Оны негізгі мәтін ретінде қалауыңыз мүмкін.
Dialogue: 0,0:10:07.85,0:10:09.48,Default,,0,0,0,,Мен сөйлесе аламын ба?
Dialogue: 0,0:10:09.60,0:10:12.11,Default,,0,0,0,,Тоқу станогы не үшін жасалды?
Dialogue: 0,0:10:12.23,0:10:15.15,Default,,0,0,0,,Не... білмесем бақыттырақ болармын
Dialogue: 0,0:10:15.65,0:10:17.24,Default,,0,0,0,,Сіз бұған жол бердіңіз бе?
Dialogue: 0,0:10:17.36,0:10:18.86,Default,,0,0,0,,Ал егер?
Dialogue: 0,0:10:21.03,0:10:24.49,Default,,0,0,0,,Неге менің артымнан келе жатырсың? Тоқыма станок қайда!
Dialogue: 0,0:10:24.62,0:10:26.62,Default,,0,0,0,,Енді ол қайда?
Dialogue: 0,0:10:27.20,0:10:28.54,Default,,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 0,0:10:30.21,0:10:32.67,Default,,0,0,0,,Біріншіден, менің сізге еру себебім...
Dialogue: 0,0:10:32.79,0:10:35.00,Default,,0,0,0,,Сізді және Бугипоптың мәйітін өлтіріңіз-
Dialogue: 0,0:10:35.13,0:10:37.21,Default,,0,0,0,,Себебі мен сені әшкерелемек болдым.
Dialogue: 0,0:10:37.34,0:10:38.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:38.34,0:10:39.76,Default,,0,0,0,,Біріншіден, мен неге...
Dialogue: 0,0:10:39.88,0:10:43.14,Default,,0,0,0,,Сіз осындай ақымақтық жасап жатырсыз ба деп ойладыңыз ба?
Dialogue: 0,0:10:43.55,0:10:44.89,Default,,0,0,0,,Бұл нені білдіреді!?
Dialogue: 0,0:10:45.18,0:10:47.10,Default,,0,0,0,,Хе... Мен сені өлтірсем ше?
Dialogue: 0,0:10:47.39,0:10:48.23,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:48.77,0:10:50.31,Default,,0,0,0,,Ашық адам да жақсы...
Dialogue: 0,0:10:50.44,0:10:53.06,Default,,0,0,0,,Оны қанішер қылу жаман емес.
Dialogue: 0,0:10:53.19,0:10:54.32,Default,,0,0,0,,Отбасымнан алыста~!
Dialogue: 0,0:10:54.98,0:10:56.82,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:57.11,0:10:58.44,Default,,0,0,0,,Гухаа
Dialogue: 0,0:11:00.61,0:11:02.91,Default,,0,0,0,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:11:03.66,0:11:05.66,Default,,0,0,0,,Біреуге біреуді өлтіруге рұқсат етсеңіз...
Dialogue: 0,0:11:05.79,0:11:08.33,Default,,0,0,0,,Ата-анаңмен бетпе-бет келуге болмайды деп ойлаймын.
Dialogue: 0,0:11:08.62,0:11:10.58,Default,,0,0,0,,Не... Наги-ни-сан?
Dialogue: 0,0:11:11.37,0:11:14.42,Default,,0,0,0,,Ол олай киінбейді деп ойлаймын.
Dialogue: 0,0:11:14.75,0:11:17.00,Default,,0,0,0,,Оны сенің бойыңа кім сіңірді?
Dialogue: 0,0:11:22.34,0:11:23.97,Default,,0,0,0,,Кешіріңіз Наги-ни!
Dialogue: 0,0:11:25.30,0:11:26.64,Default,,0,0,0,,Хмм... Эй!
Dialogue: 0,0:11:28.18,0:11:29.85,Default,,0,0,0,,Цк, анау ақымақ.
Dialogue: 0,0:11:29.98,0:11:31.39,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:31.52,0:11:35.61,Default,,0,0,0,,Ой, сен қозғалмайсың, Котоэ Кинугаваның жалғаншысы.
Dialogue: 0,0:11:36.52,0:11:40.65,Default,,0,0,0,,Мен неге Котоэ Кинугаваның мінез-құлқы кенет нашарлап кетті деп ойладым...
Dialogue: 0,0:11:40.78,0:11:42.36,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:42.70,0:11:47.37,Default,,0,0,0,,Шинё академиясының студенттері арасында мен туралы білмейтін ешкім жоқ.
Dialogue: 0,0:11:47.66,0:11:48.95,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:49.08,0:11:50.83,Default,,0,0,0,,Мынаны тыңдау керек.
Dialogue: 0,0:11:50.96,0:11:52.75,Default,,0,0,0,,Сенің сөмкеңдегі жігіт кім?
Dialogue: 0,0:11:53.87,0:11:54.92,Default,,0,0,0,,Жауап жоқ
Dialogue: 0,0:11:55.33,0:11:56.71,Default,,0,0,0,,tsk (саусақтарды сермеу)
Dialogue: 0,0:11:56.84,0:11:59.38,Default,,0,0,0,,(миниондардың күлкісі)
Dialogue: 0,0:12:01.09,0:12:05.80,Default,,0,0,0,,(миниондардың күлкісі)
Dialogue: 0,0:12:06.26,0:12:07.10,Default,,0,0,0,,Иә
Dialogue: 0,0:12:08.89,0:12:11.89,Default,,0,0,0,,Бірінші осыны аяқтаудан басқа амалым жоқ.
Dialogue: 0,0:12:13.10,0:12:14.10,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:14.23,0:12:15.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:16.40,0:12:17.86,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:17.98,0:12:18.82,Default,,0,0,0,,Хмм (минион) Гувах
Dialogue: 0,0:12:19.11,0:12:20.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:22.74,0:12:23.95,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:12:26.82,0:12:27.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:27.99,0:12:29.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:29.20,0:12:30.04,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:30.49,0:12:33.37,Default,,0,0,0,,Менің ойымша, бұл сол жігіттің жұмысы шығар.
Dialogue: 0,0:12:33.50,0:12:35.62,Default,,0,0,0,,Бұл жұмыс істеуі керек.
Dialogue: 0,0:12:35.75,0:12:36.67,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:12:51.52,0:12:54.14,Default,,0,0,0,,Хмм... ол не істеп жатыр...
Dialogue: 0,0:12:56.23,0:12:57.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:57.31,0:12:59.61,Default,,0,0,0,,Мен неге мұндамын...
Dialogue: 0,0:12:59.73,0:13:02.23,Default,,0,0,0,,Дұрыс, мен ол жігітпін.
Dialogue: 0,0:13:03.19,0:13:04.07,Default,,0,0,0,,Цк
Dialogue: 0,0:13:05.70,0:13:06.57,Default,,0,0,0,,Ах
Dialogue: 0,0:13:10.03,0:13:12.04,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:13:12.29,0:13:14.29,Default,,0,0,0,,бұл... жібер!
Dialogue: 0,0:13:15.00,0:13:15.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:18.17,0:13:20.88,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:13:21.34,0:13:22.55,Default,,0,0,0,,Котоэ-чан
Dialogue: 0,0:13:23.05,0:13:25.76,Default,,0,0,0,,Мен сіздің сезімдеріңізді көптен бері білемін.
Dialogue: 0,0:13:26.72,0:13:29.89,Default,,0,0,0,,Мен сенің мен туралы ойлайтыныңды білдім.
Dialogue: 0,0:13:30.35,0:13:34.43,Default,,0,0,0,,Сонымен бірге ол таңдану немесе аяушылық түрі де болуы мүмкін.
Dialogue: 0,0:13:35.02,0:13:37.77,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:13:38.48,0:13:41.36,Default,,0,0,0,,Сізде ғашық болатын ештеңе жоқ...
Dialogue: 0,0:13:41.48,0:13:43.78,Default,,0,0,0,,Мен үнемі мұңайып жүретінмін.
Dialogue: 0,0:13:44.69,0:13:46.78,Default,,0,0,0,,Сол себепті маған ұнадың
Dialogue: 0,0:13:47.57,0:13:51.78,Default,,0,0,0,,Менде де сен сияқты мұң бар деген елес астында
Dialogue: 0,0:13:52.83,0:13:58.04,Default,,0,0,0,,Иә, сенікінен айырмашылығы, менікі жай ғана үмітсіздік.
Dialogue: 0,0:13:58.71,0:14:01.38,Default,,0,0,0,,(Котоэ жылайды)
Dialogue: 0,0:14:01.50,0:14:05.01,Default,,0,0,0,,Мен тіпті мұңаймаймын.
Dialogue: 0,0:14:05.13,0:14:10.05,Default,,0,0,0,,(Котоэ жылайды)
Dialogue: 0,0:14:11.14,0:14:14.89,Default,,0,0,0,,Сол себепті мен сіздің сезімдеріңізге жауап бере алмадым.
Dialogue: 0,0:14:15.39,0:14:20.69,Default,,0,0,0,,(Котоэ жылайды)
Dialogue: 0,0:14:20.81,0:14:23.77,Default,,0,0,0,,Көмектесіңіз... көмектесіңізші
Dialogue: 0,0:14:24.57,0:14:29.20,Default,,0,0,0,,Маған көмектесші... Джин-ни-сан, маған көмектес.
Dialogue: 0,0:14:29.57,0:14:32.78,Default,,0,0,0,,Аа, мен әрқашан солай ойлайтынмын.
Dialogue: 0,0:14:32.91,0:14:34.62,Default,,0,0,0,,Бірақ мен мұны істей алмаймын.
Dialogue: 0,0:14:34.74,0:14:37.96,Default,,0,0,0,,Қазірдің өзінде мен не істерімді білмеймін.
Dialogue: 0,0:14:39.67,0:14:42.46,Default,,0,0,0,,Джин... Бауырым
Dialogue: 0,0:14:48.84,0:14:50.47,Default,,0,0,0,,Рем – Рем
Dialogue: 0,0:14:50.59,0:14:53.97,Default,,0,0,0,,Мен өзімді ешқашан сен сияқты сезінбейтін әлем жасаймын.
Dialogue: 0,0:14:54.85,0:14:57.85,Default,,0,0,0,,Мен түр бар жерге барамын.
Dialogue: 0,0:14:58.48,0:15:02.35,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:15:02.69,0:15:06.53,Default,,0,0,0,,Не деп тұрсыңдар, ақымақтар?
Dialogue: 0,0:15:06.98,0:15:09.32,Default,,0,0,0,,Ешкім шықпайды.
Dialogue: 0,0:15:09.45,0:15:12.41,Default,,0,0,0,,Терминалдар... не болып жатыр!
Dialogue: 0,0:15:15.87,0:15:19.66,Default,,0,0,0,,Егер бұл менің басымнан өтсе...
Dialogue: 0,0:15:20.16,0:15:21.58,Default,,0,0,0,,Немесе (Үрейлі Е) О.
Dialogue: 0,0:15:21.71,0:15:23.79,Default,,0,0,0,,Мысалдағы «дезинфекциялаушы» дегеніміз не?
Dialogue: 0,0:15:23.92,0:15:25.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:26.71,0:15:30.59,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын, Spooky Electric.
Dialogue: 0,0:15:30.72,0:15:33.30,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:33.43,0:15:37.72,Default,,0,0,0,,Иә? Сіз мені іздеуіңіз керек еді, солай ма?
Dialogue: 0,0:15:37.85,0:15:39.89,Default,,0,0,0,,Жоқ... болмайды!
Dialogue: 0,0:15:40.35,0:15:44.19,Default,,0,0,0,,Ой, балалар, оларды «Қиялданушылар» деп атайсыңдар.
Dialogue: 0,0:15:44.56,0:15:47.61,Default,,0,0,0,,Сен не істедің? Неліктен миды жуу...
Dialogue: 0,0:15:47.73,0:15:50.40,Default,,0,0,0,,Сіз бен біз әртүрлі деңгейдеміз.
Dialogue: 0,0:15:50.99,0:15:54.66,Default,,0,0,0,,«Біріктіру ұйымы», солай ма? сіз тиесілі ұйым
Dialogue: 0,0:15:54.78,0:15:56.24,Default,,0,0,0,,Жоқ, бұл жүйе.
Dialogue: 0,0:15:56.83,0:15:58.79,Default,,0,0,0,,Бір нәрсе өзгеруде
Dialogue: 0,0:15:58.91,0:16:02.83,Default,,0,0,0,,Балалар, өзгерістерді бақылап отырсыңдар, солай ма?
Dialogue: 0,0:16:03.33,0:16:07.50,Default,,0,0,0,,Сіз қарапайым адамдарға дәрі беріп, олардың реакциясын тексересіз...
Dialogue: 0,0:16:07.63,0:16:09.88,Default,,0,0,0,,Біз оның дәрежесін іздейміз.
Dialogue: 0,0:16:10.01,0:16:11.84,Default,,0,0,0,,Солай емес пе? (Үрейлі Е) Уф...
Dialogue: 0,0:16:12.30,0:16:14.84,Default,,0,0,0,,Менің соншалықты көп білгенім...
Dialogue: 0,0:16:14.97,0:16:16.85,Default,,0,0,0,,Бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:16:17.18,0:16:18.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:18.14,0:16:21.68,Default,,0,0,0,,Қайта біріктіру ұйымымен жау ретінде өмір сүре аламын деп ойламаңыз!
Dialogue: 0,0:16:21.81,0:16:25.31,Default,,0,0,0,,Менімен не істесең де, бәрібір бітті.
Dialogue: 0,0:16:25.44,0:16:26.36,Default,,0,0,0,,«Жау»?
Dialogue: 0,0:16:26.61,0:16:28.07,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:28.19,0:16:31.40,Default,,0,0,0,,Жаулар туралы айтқанда, сен білесің бе?
Dialogue: 0,0:16:31.74,0:16:32.61,Default,,0,0,0,,Не?
Dialogue: 0,0:16:32.86,0:16:37.37,Default,,0,0,0,,Сіз жүргізген «экспериментте» бірнеше адам қайтыс болды.
Dialogue: 0,0:16:37.95,0:16:40.54,Default,,0,0,0,,Сіз берген дәріге аллергияңыз болса.
Dialogue: 0,0:16:40.66,0:16:42.96,Default,,0,0,0,,Шок белгілері пайда болады
Dialogue: 0,0:16:43.08,0:16:46.13,Default,,0,0,0,,Бұған не болды? маңызды емес
Dialogue: 0,0:16:46.42,0:16:49.63,Default,,0,0,0,,Дұрыс, маңызды емес.
Dialogue: 0,0:16:49.75,0:16:53.97,Default,,0,0,0,,Жол-көлік оқиғасы сияқты нәрселер туралы айтатын болсақ, бәрі сәтсіздікке байланысты.
Dialogue: 0,0:16:54.97,0:16:59.89,Default,,0,0,0,,Сәттілік мүлде жоқ. Бұл адам шынымен бақытсыз болды.
Dialogue: 0,0:17:01.47,0:17:05.23,Default,,0,0,0,,Сіз нені айтасыз? Сіз бұрын не туралы айтып отырсыз?
Dialogue: 0,0:17:06.19,0:17:07.40,Default,,0,0,0,,Бұл тарих.
Dialogue: 0,0:17:07.81,0:17:08.73,Default,,0,0,0,,Не?
Dialogue: 0,0:17:08.86,0:17:13.40,Default,,0,0,0,,Жаумен бетпе-бет келгенде ең дұрыс таңдау қандай?
Dialogue: 0,0:17:13.86,0:17:15.86,Default,,0,0,0,,Оны тарих дәлелдейді
Dialogue: 0,0:17:16.66,0:17:19.37,Default,,0,0,0,,Бұл жауды одақтасқа айналдыру туралы.
Dialogue: 0,0:17:19.66,0:17:23.37,Default,,0,0,0,,Бұл ең ақылды және тиімді әдіс
Dialogue: 0,0:17:24.37,0:17:26.12,Default,,0,0,0,,Жау жоқ-
Dialogue: 0,0:17:26.54,0:17:29.13,Default,,0,0,0,,Сені менің жауым деп айту керек.
Dialogue: 0,0:17:29.50,0:17:30.71,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:17:30.84,0:17:33.84,Default,,0,0,0,,Сіз бен біздің қабілеттеріміз ұқсас
Dialogue: 0,0:17:34.17,0:17:36.68,Default,,0,0,0,,Бұл өте ыңғайлы.
Dialogue: 0,0:17:36.97,0:17:40.72,Default,,0,0,0,,Басқаша айтқанда, мен осыған ұқсас нәрсені жасасам да, Біріккен Ұйымның ... мүмкін емес еді.
Dialogue: 0,0:17:40.85,0:17:43.97,Default,,0,0,0,,Сіз мұны істеп жатқан сияқтысыз.
Dialogue: 0,0:17:44.10,0:17:46.64,Default,,0,0,0,,Ха... Сен, мен күтпедім...
Dialogue: 0,0:17:46.94,0:17:48.56,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:48.77,0:17:52.27,Default,,0,0,0,,Мен сізді Қайта біріктіру ұйымын басқару үшін қақпақ ретінде пайдаланамын.
Dialogue: 0,0:17:52.61,0:17:56.78,Default,,0,0,0,,Біріктіру ұйымында елестетушілер көп болады.
Dialogue: 0,0:17:56.90,0:17:58.91,Default,,0,0,0,,Бұл менің ойым
Dialogue: 0,0:17:59.16,0:18:00.87,Default,,0,0,0,,Міне солай болды...
Dialogue: 0,0:18:00.99,0:18:03.41,Default,,0,0,0,,Иә, бұл сөзсіз.
Dialogue: 0,0:18:03.99,0:18:07.33,Default,,0,0,0,,Менің жоспарымды бүкіл әлемде жүзеге асыру үшін...
Dialogue: 0,0:18:07.46,0:18:10.83,Default,,0,0,0,,Күшті ұйымдастырушылық қолдау өте маңызды.
Dialogue: 0,0:18:10.96,0:18:12.80,Default,,0,0,0,,Жоспар... сонда?
Dialogue: 0,0:18:13.21,0:18:14.55,Default,,0,0,0,,Қарапайым тілмен айтқанда
Dialogue: 0,0:18:14.67,0:18:18.63,Default,,0,0,0,,Бүкіл адамзаттың рухын бір күйге келтіру.
Dialogue: 0,0:18:18.76,0:18:23.01,Default,,0,0,0,,Солай етсек, енді қайғылы түсініспеушілік немесе түсінбеушілік болмайды, солай ма?
Dialogue: 0,0:18:23.14,0:18:26.02,Default,,0,0,0,,Бұл жігіт мүлде ақылсыз.
Dialogue: 0,0:18:26.68,0:18:27.94,Default,,0,0,0,,Иә
Dialogue: 0,0:18:33.11,0:18:34.44,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:34.57,0:18:38.45,Default,,0,0,0,,Гах... менің денем... менің денем...
Dialogue: 0,0:18:38.90,0:18:41.70,Default,,0,0,0,,Бұл дене емес, бұл қалаусыздық.
Dialogue: 0,0:18:41.95,0:18:44.20,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:18:44.33,0:18:46.54,Default,,0,0,0,,«Гүліңнен» «тікенді» алдым
Dialogue: 0,0:18:47.25,0:18:48.50,Default,,0,0,0,,Осымен
Dialogue: 0,0:18:48.87,0:18:49.92,Default,,0,0,0,,Уг!?
Dialogue: 0,0:18:50.04,0:18:54.92,Default,,0,0,0,,Мен сенен шабуылға деген құштарлықты алып тастадым деген сөз.
Dialogue: 0,0:18:55.17,0:18:57.46,Default,,0,0,0,,Бұл өте ақымақ.
Dialogue: 0,0:18:57.92,0:19:01.72,Default,,0,0,0,,Мен саған айттым ба? «Мен сенен басқа деңгейдемін»
Dialogue: 0,0:19:02.30,0:19:03.35,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:03.47,0:19:04.30,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:19:04.43,0:19:08.85,Default,,0,0,0,,Электрлік ынталандыру арқылы миды басқару қабілетіңіз...
Dialogue: 0,0:19:08.98,0:19:11.85,Default,,0,0,0,,«Жан» ұғымы жоқ.
Dialogue: 0,0:19:12.44,0:19:16.11,Default,,0,0,0,,Сіз адамдарды жетелейтін негізгі болмысты білмейсіз...
Dialogue: 0,0:19:16.23,0:19:20.07,Default,,0,0,0,,Бұл жай ғана сіздің санаңызға өрескел үлгіні басып шығарады.
Dialogue: 0,0:19:22.11,0:19:23.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:23.53,0:19:27.66,Default,,0,0,0,,Бұл адамдарға шешуші өзгерістер әкеле алмайды.
Dialogue: 0,0:19:28.08,0:19:32.58,Default,,0,0,0,,Біріншіден, адамдардың жүрегіндегі олқылықтарды және оны қалай толтыру керектігін түсініңіз.
Dialogue: 0,0:19:33.21,0:19:35.21,Default,,0,0,0,,Осылай ойлаудың маңызы зор
Dialogue: 0,0:19:36.13,0:19:38.67,Default,,0,0,0,,Бұл трансплантация сияқты... иә?
Dialogue: 0,0:19:38.80,0:19:40.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:40.59,0:19:42.30,Default,,0,0,0,,Серіктес табыла салысымен -
Dialogue: 0,0:19:42.43,0:19:44.93,Default,,0,0,0,,Мен саған да бірден «тамыр» саламын.
Dialogue: 0,0:19:45.51,0:19:47.93,Default,,0,0,0,,Керісінше мен сенен мықты «сандық» аламын.
Dialogue: 0,0:19:49.18,0:19:52.64,Default,,0,0,0,,Сіздің күшті психикалық күшіңіз біршама төмендесе де...
Dialogue: 0,0:19:53.06,0:19:55.48,Default,,0,0,0,,Қуаныш әлдеқайда басым
Dialogue: 0,0:19:56.90,0:19:58.07,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:19:58.86,0:20:00.07,Default,,0,0,0,,Әзірге.
Dialogue: 0,0:20:00.61,0:20:03.20,Default,,0,0,0,,Дегенмен, адамдар қатты қуанды.
Dialogue: 0,0:20:03.32,0:20:06.12,Default,,0,0,0,,Барлығы мен жағында болды.
Dialogue: 0,0:20:06.24,0:20:08.58,Default,,0,0,0,,Жоқ, білмеймін...
Dialogue: 0,0:20:08.70,0:20:12.50,Default,,0,0,0,,Сізді мұны істеуге мәжбүр ететін не қызық?
Dialogue: 0,0:20:13.21,0:20:15.50,Default,,0,0,0,,Енді бұл маңызды емес.
Dialogue: 0,0:20:16.88,0:20:22.34,Default,,0,0,0,,Мен оны біраз уақыттан бері сынап көргім келді, бірақ жек көрушілік тым күшті болды, сондықтан мен жасай алмадым.
Dialogue: 0,0:20:23.26,0:20:26.72,Default,,0,0,0,,Бәлкім, сіз айтқан «тікенектер» кеткендіктен болар.
Dialogue: 0,0:20:29.35,0:20:30.72,Default,,0,0,0,,Елестетуші
Dialogue: 0,0:20:31.43,0:20:34.81,Default,,0,0,0,,Boogiepop сізге бағытталған.
Dialogue: 0,0:20:44.91,0:20:47.37,Default,,0,0,0,,Ой... а
Dialogue: 0,0:20:48.49,0:20:50.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:50.41,0:20:52.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:53.25,0:20:57.25,Default,,0,0,0,,Әйтеуір... Мен әйтеуір қашуым керек.
Dialogue: 0,0:20:58.54,0:20:59.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:59.50,0:21:00.84,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:01.17,0:21:02.34,Default,,0,0,0,,Да... кім?
Dialogue: 0,0:21:06.26,0:21:08.43,Default,,0,0,0,,Қалайсың...
Dialogue: 0,0:21:09.10,0:21:11.85,Default,,0,0,0,,Ей, сенің есіңе түскеніңді көремін.
Dialogue: 0,0:21:12.43,0:21:14.02,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:21:14.14,0:21:16.35,Default,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 0,0:21:16.77,0:21:18.98,Default,,0,0,0,,Өкінішке орай, мен мұны істей алмаймын.
Dialogue: 0,0:21:19.11,0:21:19.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:20.07,0:21:21.86,Default,,0,0,0,,Сен құрбан боласың
Dialogue: 0,0:21:22.15,0:21:24.49,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:24.61,0:21:26.24,Default,,0,0,0,,Менің уақытым көп емес
Dialogue: 0,0:21:26.78,0:21:29.62,Default,,0,0,0,,Spooky E-нің өлімі есептелмеген.
Dialogue: 0,0:21:30.45,0:21:31.79,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:21:32.29,0:21:35.79,Default,,0,0,0,,Бір күні бұл қалаға Бірлік ұйымынан біреу келеді.
Dialogue: 0,0:21:36.00,0:21:39.29,Default,,0,0,0,,Оған дейін жалғыз осы қалашықта қар жаудырайық.
Dialogue: 0,0:21:39.42,0:21:40.84,Default,,0,0,0,,Сонда ол адам...
Dialogue: 0,0:21:40.96,0:21:42.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:50.60,0:21:52.10,Default,,0,0,0,,Тоқу станок! Тоқу станогы!?
Dialogue: 0,0:21:52.43,0:21:54.89,Default,,0,0,0,,Ах... Масаки
Dialogue: 0,0:21:55.31,0:21:57.69,Default,,0,0,0,,Сәлеметсіз бе? сәлем?
Dialogue: 0,0:21:58.19,0:22:00.02,Default,,0,0,0,,Тоқу станоктары! Сен ондасың ба?
Dialogue: 0,0:22:00.15,0:22:01.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:01.36,0:22:04.11,Default,,0,0,0,,Тоқу станок... Тоқу станок!?
Dialogue: 0,0:22:04.86,0:22:09.16,Default,,0,0,0,,Маған жауап беріңізші, Лоом! станок!
Dialogue: 0,0:22:11.37,0:22:16.71,Default,,0,0,0,,♪～
Dialogue: 0,0:23:34.70,0:23:38.91,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.41,0:23:46.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory