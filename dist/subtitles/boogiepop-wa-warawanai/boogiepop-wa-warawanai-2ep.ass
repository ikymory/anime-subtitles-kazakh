Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.75,0:00:07.13,Default,,0,0,0,,♪～
Dialogue: 0,0:01:23.66,0:01:28.67,Default,,0,0,0,,～♪
Dialogue: 0,0:01:31.59,0:01:34.42,Default,,0,0,0,,(Тақтадағы жазу дыбысы)
Dialogue: 0,0:01:34.55,0:01:35.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:45.31,0:01:48.19,Default,,0,0,0,,Эй Суэма, сенің бүгінгі жоспарың бар ма?
Dialogue: 0,0:01:48.60,0:01:51.56,Default,,0,0,0,,Қарсы болмасаң, менімен үйге барғың келе ме?
Dialogue: 0,0:01:51.69,0:01:54.32,Default,,0,0,0,,Иә, қарсы емеспін.
Dialogue: 0,0:02:00.45,0:02:03.33,Default,,0,0,0,,Әй, үйге неге басқа жолмен бармайсың?
Dialogue: 0,0:02:04.58,0:02:05.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:06.50,0:02:07.33,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:02:08.37,0:02:10.38,Default,,0,0,0,,Себебі біреу сізге шабуыл жасап өлтіреді ме?
Dialogue: 0,0:02:10.50,0:02:11.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:11.96,0:02:14.55,Default,,0,0,0,,Себебі мен жағдайды түсінбеймін...
Dialogue: 0,0:02:14.67,0:02:17.55,Default,,0,0,0,,Мен сенемін, сенің мұндай нәрсе туралы тым көп ойланатыныңа сенімдімін.
Dialogue: 0,0:02:18.51,0:02:19.84,Default,,0,0,0,,Жарайсың ба? Киоко
Dialogue: 0,0:02:19.97,0:02:23.10,Default,,0,0,0,,Адамдар оңайлықпен өлтірілмейді.
Dialogue: 0,0:02:24.10,0:02:25.18,Default,,0,0,0,,Ах
Dialogue: 0,0:02:25.31,0:02:28.35,Default,,0,0,0,,Куу... Ах Куу...
Dialogue: 0,0:02:35.82,0:02:40.74,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:02:41.66,0:02:43.78,Default,,0,0,0,,Бұл сөзсіз мантикора.
Dialogue: 0,0:02:52.46,0:02:53.96,Default,,0,0,0,,Мантикора?
Dialogue: 0,0:02:55.04,0:02:59.30,Default,,0,0,0,,Ежелгі грек сөзі «адам жегіш» дегенді білдіреді
Dialogue: 0,0:03:09.98,0:03:11.19,Default,,0,0,0,,Мен де қызметтес боламын.
Dialogue: 0,0:03:11.31,0:03:12.15,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:12.81,0:03:14.61,Default,,0,0,0,,Сен, неге...
Dialogue: 0,0:03:14.73,0:03:16.52,Default,,0,0,0,,Себебі мен сені жақсы көремін
Dialogue: 0,0:03:17.53,0:03:21.86,Default,,0,0,0,,Екеумізді қоршаған әлемді қайта жасайық.
Dialogue: 0,0:03:24.57,0:03:26.03,Default,,0,0,0,,Соның арқасында бәрі жақсы аяқталды.
Dialogue: 0,0:03:27.24,0:03:30.50,Default,,0,0,0,,Сонымен, Акико Кусацу есімді қызға не болды?
Dialogue: 0,0:03:30.62,0:03:32.08,Default,,0,0,0,,«Медицина» дегеніміз не?
Dialogue: 0,0:03:32.21,0:03:33.83,Default,,0,0,0,,(Киоконың жылауы)
Dialogue: 0,0:03:33.96,0:03:35.88,Default,,0,0,0,,Жыласаң да түсінбейсің.
Dialogue: 0,0:03:37.09,0:03:40.09,Default,,0,0,0,,Ешкімге айтпауға уәде бересің бе?
Dialogue: 0,0:03:40.22,0:03:41.05,Default,,0,0,0,,Иә
Dialogue: 0,0:03:41.67,0:03:46.72,Default,,0,0,0,,1-D сыныбынан келген Акико Кусацу – менің орта мектептің кіші оқушысы...
Dialogue: 0,0:03:47.26,0:03:49.06,Default,,0,0,0,,Сіз бір клубта болдыңыз ба?
Dialogue: 0,0:03:49.18,0:03:51.77,Default,,0,0,0,,Иә, бұл Акико.
Dialogue: 0,0:03:51.89,0:03:55.40,Default,,0,0,0,,Шамамен жылдың ортасы, яғни 3 ай болды.
Dialogue: 0,0:03:55.52,0:03:57.23,Default,,0,0,0,,Біртүрлі дәрі тарата бастадым.
Dialogue: 0,0:03:58.65,0:03:59.98,Default,,0,0,0,,«Көңілді»
Dialogue: 0,0:04:00.11,0:04:03.40,Default,,0,0,0,,«Бұл сіздің басыңызды сергітеді, сондықтан емтихан кезінде демалу үшін жақсы».
Dialogue: 0,0:04:03.53,0:04:04.82,Default,,0,0,0,,Барлығына
Dialogue: 0,0:04:04.95,0:04:06.87,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:04:07.24,0:04:08.87,Default,,0,0,0,,Учиса
Dialogue: 0,0:04:08.99,0:04:12.79,Default,,0,0,0,,Менің кейбір достарым үйден қаша бастады.
Dialogue: 0,0:04:12.91,0:04:15.92,Default,,0,0,0,,Барлығы ешкімге айтпай жоғалып кетеді.
Dialogue: 0,0:04:16.04,0:04:17.88,Default,,0,0,0,,Сосын Акико да жоғалып кетті...
Dialogue: 0,0:04:19.59,0:04:21.76,Default,,0,0,0,,Сіз бұл біртүрлі деп ойлайсыз, солай емес пе?
Dialogue: 0,0:04:21.88,0:04:24.05,Default,,0,0,0,,Аа, мүлде емес...жалғастыру
Dialogue: 0,0:04:24.18,0:04:26.43,Default,,0,0,0,,Мұндай жағдай жиі болады.
Dialogue: 0,0:04:26.80,0:04:27.64,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:28.72,0:04:32.98,Default,,0,0,0,,Сондықтан бәрі есірткінің кесірінен деп ойлады.
Dialogue: 0,0:04:33.10,0:04:36.40,Default,,0,0,0,,Кирима Наги барлығына келді, бұрынғыдай...
Dialogue: 0,0:04:36.85,0:04:39.19,Default,,0,0,0,,«Медицинаны ұмыт»
Dialogue: 0,0:04:39.77,0:04:42.11,Default,,0,0,0,,Бұл менмін, Наги Кирима.
Dialogue: 0,0:04:42.24,0:04:46.20,Default,,0,0,0,,Осы себепті оны мектептен әдейі шеттеткен сияқты.
Dialogue: 0,0:04:46.61,0:04:50.12,Default,,0,0,0,,Мен Акико және басқалары Кирима Нагиді кездестіретініне сенімдімін...
Dialogue: 0,0:04:50.37,0:04:52.29,Default,,0,0,0,,Эй, Суэма, тыңдап тұрсың ба?
Dialogue: 0,0:04:52.41,0:04:53.71,Default,,0,0,0,,Иә?А... иә
Dialogue: 0,0:04:54.29,0:04:56.46,Default,,0,0,0,,Шынымен, ешкімге айтпа.
Dialogue: 0,0:04:56.58,0:04:59.34,Default,,0,0,0,,Мен де көп ұзамай ұмытамын.
Dialogue: 0,0:05:00.04,0:05:01.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:14.35,0:05:16.69,Default,,0,0,0,,Мекенжай осында...
Dialogue: 0,0:05:21.19,0:05:23.36,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:05:31.70,0:05:33.08,Default,,0,0,0,,Иә, мырза.... (Суэма) Иә?
Dialogue: 0,0:05:34.00,0:05:35.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:37.04,0:05:39.75,Default,,0,0,0,,Эй, сен Нагидің досысың ба?
Dialogue: 0,0:05:39.88,0:05:40.75,Default,,0,0,0,,Шындығында, 2-сыныпты үш тәжірибеші мен бір 1-сыныпты тәжірибеші қызмет барысында қаза тапты.
Dialogue: 0,0:05:41.34,0:05:44.76,Default,,0,0,0,,Маған қазір қоңырау шалыңыз, мен оның жақын арада келетініне сенімдімін, сондықтан асықпаңыз.
Dialogue: 0,0:05:44.88,0:05:46.59,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:05:46.72,0:05:48.22,Default,,0,0,0,,Бұл менің інім (Суэма) Ах.
Dialogue: 0,0:05:48.34,0:05:49.76,Default,,0,0,0,,Қандас болмасақ та.
Dialogue: 0,0:05:52.10,0:05:54.43,Default,,0,0,0,,Жоғарыда Суэма мырзамен сөйлесейік
Dialogue: 0,0:05:56.10,0:05:58.39,Default,,0,0,0,,Сондықтан бұл «Танигучи».
Dialogue: 0,0:05:58.60,0:06:02.07,Default,,0,0,0,,Әй, анамның қазіргі күйеуінің тегі.
Dialogue: 0,0:06:02.19,0:06:04.90,Default,,0,0,0,,Мен қартымның фамилиясын рұқсатсыз алып жатырмын.
Dialogue: 0,0:06:05.57,0:06:06.82,Default,,0,0,0,,Әке?
Dialogue: 0,0:06:07.28,0:06:09.70,Default,,0,0,0,,Иә? Сіз мұнда келгеніңізді білмедіңіз бе?
Dialogue: 0,0:06:09.82,0:06:11.37,Default,,0,0,0,,Сейчи Кирима деген кім?
Dialogue: 0,0:06:11.49,0:06:13.53,Default,,0,0,0,,Көп кітап шығарған жігіт.
Dialogue: 0,0:06:14.74,0:06:15.66,Default,,0,0,0,,Иә? өтірік
Dialogue: 0,0:06:17.12,0:06:18.62,Default,,0,0,0,,«Өтірік» дегеніміз не?
Dialogue: 0,0:06:18.75,0:06:21.50,Default,,0,0,0,,Себебі сол жазушы Сейичи Кирима?
Dialogue: 0,0:06:21.63,0:06:22.79,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:06:22.92,0:06:24.50,Default,,0,0,0,,«Кісі өлтірушілер өз ойларын өзгертеді».
Dialogue: 0,0:06:24.63,0:06:27.09,Default,,0,0,0,,«Менің жүрегімдегі жылау – Бірнеше тұлға туралы»
Dialogue: 0,0:06:27.22,0:06:29.51,Default,,0,0,0,,«Біреу бірін өлтіргенде» «Зеріккен шайтан»
Dialogue: 0,0:06:29.63,0:06:31.43,Default,,0,0,0,,«VS (Қарсы) елестетуші»
Dialogue: 0,0:06:31.97,0:06:33.72,Default,,0,0,0,,Ол менің қарт адамым.
Dialogue: 0,0:06:34.22,0:06:36.22,Default,,0,0,0,,Ол мен 10 жасымда қайтыс болды.
Dialogue: 0,0:06:36.35,0:06:37.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:39.89,0:06:43.65,Default,,0,0,0,,Кеше болды, Кирима-сан, неге...
Dialogue: 0,0:06:43.77,0:06:46.23,Default,,0,0,0,,А, себебі?
Dialogue: 0,0:06:46.61,0:06:49.53,Default,,0,0,0,,Иә, сен Киокого неге көмектестің?
Dialogue: 0,0:06:53.03,0:06:55.58,Default,,0,0,0,,Менің ойымша, сіз оған жақсы көмектескенсіз.
Dialogue: 0,0:06:55.95,0:06:58.62,Default,,0,0,0,,Ах, куу... а...
Dialogue: 0,0:06:58.96,0:07:00.71,Default,,0,0,0,,Мен оны осылай бүктеуім керек пе?
Dialogue: 0,0:07:00.83,0:07:03.21,Default,,0,0,0,,Қайта қалпына келсе де, уақыт керек, Мантикора.
Dialogue: 0,0:07:03.33,0:07:04.17,Default,,0,0,0,,Кирима мырза?
Dialogue: 0,0:07:04.29,0:07:06.30,Default,,0,0,0,,Ауырды, ауырады! Тоқта!
Dialogue: 0,0:07:06.42,0:07:09.26,Default,,0,0,0,,Мен ғана емес, Жаңғырық та сені іздейді.
Dialogue: 0,0:07:09.38,0:07:12.64,Default,,0,0,0,,Мен мұны енді қайталамаймын. Мен енді есірткі қабылдамаймын!
Dialogue: 0,0:07:12.84,0:07:15.81,Default,,0,0,0,,Сіз Акико Кусацуды өлтіргіңіз келгенде не айтып тұрсыз?
Dialogue: 0,0:07:15.93,0:07:19.14,Default,,0,0,0,,Білмейсің, мен дәріні сол баладан алдым...
Dialogue: 0,0:07:19.35,0:07:21.81,Default,,0,0,0,,Цк, сен қарапайым адамсың ба?
Dialogue: 0,0:07:23.27,0:07:26.40,Default,,0,0,0,,Киоко! Не... мынау несі?!
Dialogue: 0,0:07:27.23,0:07:30.70,Default,,0,0,0,,Көпшіліктің көз алдында болғаннан жақсы, Киношита.
Dialogue: 0,0:07:31.99,0:07:34.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:36.74,0:07:39.16,Default,,0,0,0,,Мен бүкіл оқиғаны Киокодан естідім.
Dialogue: 0,0:07:40.08,0:07:44.96,Default,,0,0,0,,Кирима-сан, сен оларды күдікті есірткіден құтқардың, солай ма?
Dialogue: 0,0:07:45.08,0:07:46.54,Default,,0,0,0,,Ал, сен қалай ойлайсың?
Dialogue: 0,0:07:47.25,0:07:48.92,Default,,0,0,0,,Мен Киокого айттым...
Dialogue: 0,0:07:49.05,0:07:51.84,Default,,0,0,0,,Мантикора және жаңғырық дегеніміз не?
Dialogue: 0,0:07:51.97,0:07:54.80,Default,,0,0,0,,Оның қашып кеткен балаларға қатысы бар ма?
Dialogue: 0,0:07:55.93,0:07:58.43,Default,,0,0,0,,Мұның сізге ешқандай қатысы жоқ.
Dialogue: 0,0:07:58.64,0:07:59.47,Default,,0,0,0,,Ах
Dialogue: 0,0:08:00.31,0:08:03.69,Default,,0,0,0,,Мәсіх кешені дегеніміз не?
Dialogue: 0,0:08:05.10,0:08:06.98,Default,,0,0,0,,Міне, көп нәрсе болды.
Dialogue: 0,0:08:07.27,0:08:09.98,Default,,0,0,0,,Мен қалыпты болуды қойдым.
Dialogue: 0,0:08:10.82,0:08:14.57,Default,,0,0,0,,Оның үстіне мұны біреу істеу керек, солай ма?
Dialogue: 0,0:08:14.70,0:08:16.28,Default,,0,0,0,,Мұғалімдерге сенуге болмайды.
Dialogue: 0,0:08:17.28,0:08:21.79,Default,,0,0,0,,Жарайды, мен сені қараңғы түскенше апарамын, Суэма-сан.
Dialogue: 0,0:08:30.63,0:08:32.42,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:08:32.55,0:08:33.59,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:33.84,0:08:36.72,Default,,0,0,0,,Жарайды, онда ертең мектепте.
Dialogue: 0,0:08:36.84,0:08:37.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:38.10,0:08:41.10,Default,,0,0,0,,Аа, тоқтата тұру ертең аяқталады.
Dialogue: 0,0:08:41.22,0:08:42.68,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:08:43.14,0:08:46.06,Default,,0,0,0,,Әй, Суэма-сан (Суэма)?
Dialogue: 0,0:08:46.73,0:08:49.82,Default,,0,0,0,,Өткенді де мәңгілікке сүйреме.
Dialogue: 0,0:08:49.94,0:08:50.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:50.94,0:08:53.57,Default,,0,0,0,,Егер сіз тым талғампаз болсаңыз, жұмыстан босатыласыз.
Dialogue: 0,0:09:02.95,0:09:05.33,Default,,0,0,0,,Наги Кирима қайтып келді.
Dialogue: 0,0:09:06.12,0:09:07.33,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:09:09.59,0:09:11.96,Default,,0,0,0,,Жарайды, айттым ба?
Dialogue: 0,0:09:12.09,0:09:14.42,Default,,0,0,0,,«Жағдай біздің пайдамызға»
Dialogue: 0,0:09:15.17,0:09:19.60,Default,,0,0,0,,Өйткені, оған Саотоме-кун ұнайтын сияқты.
Dialogue: 0,0:09:20.60,0:09:21.43,Default,,0,0,0,,Хун
Dialogue: 0,0:09:28.48,0:09:29.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:48.17,0:09:49.00,Default,,0,0,0,,Ах
Dialogue: 0,0:10:04.72,0:10:06.98,Default,,0,0,0,,Юрихара...?
Dialogue: 0,0:10:10.06,0:10:11.02,Default,,0,0,0,,Ах
Dialogue: 0,0:10:11.36,0:10:12.40,Default,,0,0,0,,Уф
Dialogue: 0,0:10:13.52,0:10:16.07,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:16.19,0:10:17.36,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:10:17.78,0:10:20.66,Default,,0,0,0,,Көрсең, тірі қалма
Dialogue: 0,0:10:21.45,0:10:22.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:22.49,0:10:24.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:24.45,0:10:26.12,Default,,0,0,0,,А... а...
Dialogue: 0,0:10:26.37,0:10:28.12,Default,,0,0,0,,Хэхе... хехе...
Dialogue: 0,0:10:28.83,0:10:30.71,Default,,0,0,0,,Сізді өлтіргіңіз келе ме?
Dialogue: 0,0:10:32.79,0:10:37.01,Default,,0,0,0,,Сізге ол әйелден гөрі еркек болған ыңғайлырақ сияқты.
Dialogue: 0,0:10:38.13,0:10:40.26,Default,,0,0,0,,Сізді көшіріп алайық
Dialogue: 0,0:10:40.72,0:10:42.01,Default,,0,0,0,,Көшіру?
Dialogue: 0,0:10:42.14,0:10:43.26,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:43.39,0:10:46.68,Default,,0,0,0,,Мен саған өзгеремін және адам қоғамына араласамын.
Dialogue: 0,0:10:47.31,0:10:49.48,Default,,0,0,0,,Сізді ешкімге табуға мүмкіндік бермеңіз
Dialogue: 0,0:10:50.31,0:10:52.23,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:10:52.36,0:10:55.15,Default,,0,0,0,,Олай болса, мен сені тірі қалдырғаным дұрыс...
Dialogue: 0,0:10:55.27,0:10:56.40,Default,,0,0,0,,Бұл тиімді
Dialogue: 0,0:10:57.36,0:10:58.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:59.74,0:11:03.28,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:11:13.21,0:11:14.25,Default,,0,0,0,,Иә
Dialogue: 0,0:11:15.29,0:11:17.17,Default,,0,0,0,,(Караоке музыкасы)
Dialogue: 0,0:11:17.30,0:11:19.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:28.60,0:11:30.14,Default,,0,0,0,,Ия
Dialogue: 0,0:11:30.64,0:11:32.81,Default,,0,0,0,,Келесі, Саотоме-кун, сен де ән айтшы.
Dialogue: 0,0:11:32.94,0:11:35.36,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:11:35.48,0:11:36.73,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:03.09,0:12:05.39,Default,,0,0,0,,Оны бірден жей алмасаң, өлдің.
Dialogue: 0,0:12:06.10,0:12:07.72,Default,,0,0,0,,Енді мен шыдамды болуым керек.
Dialogue: 0,0:12:19.02,0:12:21.15,Default,,0,0,0,,Мен саған күш бердім
Dialogue: 0,0:12:21.44,0:12:23.90,Default,,0,0,0,,Маған құдіретіңмен адамдарды бер
Dialogue: 0,0:12:29.37,0:12:33.83,Default,,0,0,0,,Жарайсың ба? Сіз өз еркіңізбен құлайсыз.
Dialogue: 0,0:12:33.96,0:12:35.79,Default,,0,0,0,,А... а...
Dialogue: 0,0:12:37.54,0:12:39.84,Default,,0,0,0,,Иә? мен...
Dialogue: 0,0:12:40.30,0:12:41.42,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:48.43,0:12:50.39,Default,,0,0,0,,Бұл жұмыс істеді, солай ма? модификация
Dialogue: 0,0:12:50.72,0:12:53.85,Default,,0,0,0,,Иә, бұл керемет қабілет.
Dialogue: 0,0:12:53.98,0:12:57.77,Default,,0,0,0,,Енді сол әйелде шығу тегі белгісіз есірткі бар.
Dialogue: 0,0:12:57.90,0:13:00.27,Default,,0,0,0,,Мен оны қасымдағы достарыма шегуге рұқсат етемін.
Dialogue: 0,0:13:08.20,0:13:12.66,Default,,0,0,0,,Өзіңіздің ми жасушаларыңызда сіз байқамай синтезделген дәрілер.
Dialogue: 0,0:13:13.50,0:13:14.62,Default,,0,0,0,,О
Dialogue: 0,0:13:14.75,0:13:17.63,Default,,0,0,0,,Егер сіз есірткімен айналысатын азғын адам болсаңыз...
Dialogue: 0,0:13:17.75,0:13:20.13,Default,,0,0,0,,Біреудің кенеттен жоғалып кетуі табиғи емес.
Dialogue: 0,0:13:20.25,0:13:21.88,Default,,0,0,0,,Сен данышпансың, Саотоме-кун.
Dialogue: 0,0:13:22.00,0:13:22.92,Default,,0,0,0,,Ах
Dialogue: 0,0:13:23.34,0:13:25.63,Default,,0,0,0,,Кешіріңіз (қызметші) Кешіріңіз.
Dialogue: 0,0:13:26.34,0:13:27.30,Default,,0,0,0,,Я...
Dialogue: 0,0:13:27.72,0:13:30.14,Default,,0,0,0,,Сіз қорқасыз ба? Мекемедегі жігіттер
Dialogue: 0,0:13:30.93,0:13:31.97,Default,,0,0,0,,Иә
Dialogue: 0,0:13:32.10,0:13:35.39,Default,,0,0,0,,Осындай ауқымдағы істерді орындайтын адамдар.
Dialogue: 0,0:13:35.52,0:13:38.31,Default,,0,0,0,,Мен бір-екі қуғыншы бар екеніне сенімдімін.
Dialogue: 0,0:13:38.77,0:13:40.40,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:13:40.52,0:13:44.44,Default,,0,0,0,,Егер бұл құлдың ауысуы жақсы болса, бізде де жауынгерлік күш болады.
Dialogue: 0,0:13:44.90,0:13:47.07,Default,,0,0,0,,Осылайша, қарсы шабуылға шығуға болады.
Dialogue: 0,0:13:47.20,0:13:50.12,Default,,0,0,0,,Мені сәтсіз деп өшіруге тырысатындар
Dialogue: 0,0:13:50.24,0:13:51.91,Default,,0,0,0,,Керісінше, өшіру дегенді білдіреді.
Dialogue: 0,0:13:52.54,0:13:53.62,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:13:53.87,0:13:55.12,Default,,0,0,0,,Физика шекараларын да бағындыратын күш—
Dialogue: 0,0:13:55.70,0:14:00.75,Default,,0,0,0,,Сәтсіздіктен алыс, сіз жаңа әлемнің патшасысыз.
Dialogue: 0,0:14:01.46,0:14:05.46,Default,,0,0,0,,Саотоме-кун, сен менің ханзадасың.
Dialogue: 0,0:14:06.63,0:14:09.47,Default,,0,0,0,,Эй, басқа құл жасағың келе ме?
Dialogue: 0,0:14:10.05,0:14:12.56,Default,,0,0,0,,О, тағы біраз.
Dialogue: 0,0:14:12.89,0:14:15.93,Default,,0,0,0,,Мен мұны ақыр соңында кең ауқымда орындауға тура келетініне сенімдімін.
Dialogue: 0,0:14:21.40,0:14:22.73,Default,,0,0,0,,Неге...
Dialogue: 0,0:14:23.23,0:14:25.19,Default,,0,0,0,,Неге оянбайсың!
Dialogue: 0,0:14:26.11,0:14:29.20,Default,,0,0,0,,Жарайды, оны жеп, тастаңыз. (Юрихара) Қарғыс атсын...
Dialogue: 0,0:14:40.25,0:14:41.13,Default,,0,0,0,,Цк
Dialogue: 0,0:14:41.88,0:14:47.21,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:14:48.59,0:14:49.88,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:50.26,0:14:52.18,Default,,0,0,0,,Мен келесі жолы жақсырақ істеймін
Dialogue: 0,0:14:55.93,0:14:57.43,Default,,0,0,0,,Дүрбелеңге түспеңіз
Dialogue: 0,0:14:57.89,0:15:00.14,Default,,0,0,0,,Мүмкіндіктер әлі де көп.
Dialogue: 0,0:15:01.85,0:15:03.90,Default,,0,0,0,,Кусацу... Акико?
Dialogue: 0,0:15:04.36,0:15:08.15,Default,,0,0,0,,Ах, Саотоме-кун, сен онымен бір сыныптасың, солай ма?
Dialogue: 0,0:15:08.28,0:15:09.28,Default,,0,0,0,,Сіз жақсы араластыңыз ба?
Dialogue: 0,0:15:09.78,0:15:12.36,Default,,0,0,0,,Жоқ, бұл... (Наги) Иә?
Dialogue: 0,0:15:12.49,0:15:14.41,Default,,0,0,0,,Біз бір рет кездесуге бардық.
Dialogue: 0,0:15:14.53,0:15:16.04,Default,,0,0,0,,Бірақ тек бір рет...
Dialogue: 0,0:15:16.16,0:15:19.71,Default,,0,0,0,,Сол кезде біртүрлі нәрсе болды ма?
Dialogue: 0,0:15:19.83,0:15:22.04,Default,,0,0,0,,Жоқ, әсіресе...
Dialogue: 0,0:15:22.63,0:15:25.17,Default,,0,0,0,,Мм... Кусацу не болды?
Dialogue: 0,0:15:25.29,0:15:27.67,Default,,0,0,0,,Маған жараса, қуат... А.
Dialogue: 0,0:15:28.63,0:15:30.13,Default,,0,0,0,,Сенпай, бұл...
Dialogue: 0,0:15:31.30,0:15:33.01,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:15:33.34,0:15:34.64,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:15:39.35,0:15:41.35,Default,,0,0,0,,Кирима Бұл не?
Dialogue: 0,0:15:41.48,0:15:42.90,Default,,0,0,0,,(Құлаған заттардың дыбысы)
Dialogue: 0,0:15:43.73,0:15:46.40,Default,,0,0,0,,Наги Кирима Неге ол жігіт...
Dialogue: 0,0:15:46.52,0:15:47.78,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:15:47.90,0:15:50.90,Default,,0,0,0,,Дегенмен, Кирима Наги бір нәрсені сезетіні сөзсіз.
Dialogue: 0,0:15:51.24,0:15:54.49,Default,,0,0,0,,Неге! біз жақсы істеп жатырмыз
Dialogue: 0,0:15:54.62,0:15:56.74,Default,,0,0,0,,Ах, дәл солай.
Dialogue: 0,0:15:56.87,0:16:00.00,Default,,0,0,0,,Сондықтан ол да бізге жеткен жоқ.
Dialogue: 0,0:16:00.12,0:16:03.21,Default,,0,0,0,,Бірақ мектеп ішінде әрекет етуден аулақ болыңыз.
Dialogue: 0,0:16:03.62,0:16:05.29,Default,,0,0,0,,Егер сіз күдіктенсеңіз, бұл қиын.
Dialogue: 0,0:16:05.42,0:16:07.25,Default,,0,0,0,,Кирима Нагиді өлтірмейсің бе?
Dialogue: 0,0:16:08.13,0:16:09.13,Default,,0,0,0,,Иә
Dialogue: 0,0:16:09.42,0:16:12.72,Default,,0,0,0,,Оның нені және қаншалықты білетінін анықтағанша.
Dialogue: 0,0:16:12.84,0:16:14.22,Default,,0,0,0,,Өлтірейік!
Dialogue: 0,0:16:14.34,0:16:16.68,Default,,0,0,0,,Жарайды, артыма ешқандай дәлел қалдырмаймын.
Dialogue: 0,0:16:16.80,0:16:18.10,Default,,0,0,0,,Оның үстіне ол біртүрлі...
Dialogue: 0,0:16:18.39,0:16:19.93,Default,,0,0,0,,Ол жоғалып кетсе де... (Саотоме) Білмейсің бе?
Dialogue: 0,0:16:20.06,0:16:22.52,Default,,0,0,0,,Оның қазіргі ата-анасы ауқатты.
Dialogue: 0,0:16:22.64,0:16:25.48,Default,,0,0,0,,Жоғалып кетсең, қашып кеткен бұзық қыз болмайсың.
Dialogue: 0,0:16:27.52,0:16:29.86,Default,,0,0,0,,Бұл шынымен сізге керек пе? (Саотоме) Иә?
Dialogue: 0,0:16:30.48,0:16:34.03,Default,,0,0,0,,Саотоме-кун, ол саған ұнамай ма?
Dialogue: 0,0:16:35.28,0:16:36.62,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:16:37.62,0:16:40.20,Default,,0,0,0,,Жоқ? Бұл хит, солай ма?
Dialogue: 0,0:16:40.70,0:16:42.50,Default,,0,0,0,,Жаңғырық Сіз осындасыз ба?
Dialogue: 0,0:16:42.87,0:16:43.91,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:16:44.67,0:16:45.83,Default,,0,0,0,,Гах...
Dialogue: 0,0:16:52.05,0:16:56.43,Default,,0,0,0,,Анау... Жаңғырық... Анау жігіт... Анау...
Dialogue: 0,0:16:56.55,0:16:59.43,Default,,0,0,0,,Не болды? Бұл «жаңғырық» деген не?
Dialogue: 0,0:17:00.64,0:17:02.93,Default,,0,0,0,,Менің түпнұсқам
Dialogue: 0,0:17:03.14,0:17:05.10,Default,,0,0,0,,Тым көп дамыған адам...
Dialogue: 0,0:17:06.52,0:17:08.11,Default,,0,0,0,,Жаңғырық…
Dialogue: 0,0:17:09.73,0:17:11.28,Default,,0,0,0,,(жаңғырық күрсінісі)
Dialogue: 0,0:17:15.95,0:17:18.95,Default,,0,0,0,,Қайсысы адам?
Dialogue: 0,0:17:20.28,0:17:21.20,Default,,0,0,0,,Я...
Dialogue: 0,0:17:25.29,0:17:26.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:29.21,0:17:30.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:31.80,0:17:35.84,Default,,0,0,0,,Сіз бірдеңені қуып жүрсіз бе?
Dialogue: 0,0:17:36.30,0:17:37.89,Default,,0,0,0,,Олай болса, неге жылайсың?
Dialogue: 0,0:17:38.01,0:17:40.76,Default,,0,0,0,,Мұны жасамас бұрын анықтаған дұрыс.
Dialogue: 0,0:17:41.72,0:17:42.77,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:58.16,0:17:59.95,Default,,0,0,0,,Сіз ауырып қалдыңыз.
Dialogue: 0,0:18:00.07,0:18:01.62,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:05.95,0:18:08.83,Default,,0,0,0,,Сіздің атыңыз кім? Үй қайда?
Dialogue: 0,0:18:10.75,0:18:13.09,Default,,0,0,0,,Хмм, мен қиналып қалдым.
Dialogue: 0,0:18:13.63,0:18:15.21,Default,,0,0,0,,Менің полицияға барудан басқа амалым жоқ...
Dialogue: 0,0:18:17.84,0:18:20.34,Default,,0,0,0,,Түсіндім, себебі бар.
Dialogue: 0,0:18:20.47,0:18:21.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:24.43,0:18:25.52,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:25.64,0:18:28.14,Default,,0,0,0,,Менің көңілді досым бар.
Dialogue: 0,0:18:28.27,0:18:30.85,Default,,0,0,0,,Мен оның бұл туралы бірдеңе істей алатынына сенімдімін.
Dialogue: 0,0:18:31.48,0:18:33.73,Default,,0,0,0,,Сіз жаман адам болуыңыз керек.
Dialogue: 0,0:18:34.82,0:18:36.74,Default,,0,0,0,,Иә? Сіз еркекті жасырасыз ба?
Dialogue: 0,0:18:37.15,0:18:38.99,Default,,0,0,0,,Тыныш! Даусыңыз қатты
Dialogue: 0,0:18:39.40,0:18:41.91,Default,,0,0,0,,Мұнда ешкім жоқ, сондықтан бәрі жақсы.
Dialogue: 0,0:18:42.32,0:18:45.33,Default,,0,0,0,,Танака есімді бірінші курс студенті болғаныңыз дұрыс па?
Dialogue: 0,0:18:45.45,0:18:49.00,Default,,0,0,0,,А, жоқ, олай емес.
Dialogue: 0,0:18:49.62,0:18:52.67,Default,,0,0,0,,Әй, бала ғарыштан келді десе ше?
Dialogue: 0,0:18:52.79,0:18:53.75,Default,,0,0,0,,Наги сенесің бе?
Dialogue: 0,0:18:55.46,0:18:57.55,Default,,0,0,0,,Жарайды, егер солай десеңіз.
Dialogue: 0,0:18:57.67,0:18:58.51,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:59.09,0:19:02.76,Default,,0,0,0,,Ғарыштан шығып кетудің мәні неде? Сол
Dialogue: 0,0:19:02.89,0:19:05.35,Default,,0,0,0,,Осы планетада адамзатты сынау
Dialogue: 0,0:19:05.47,0:19:08.52,Default,,0,0,0,,Ғаламда осындай ұлы сана бар.
Dialogue: 0,0:19:09.06,0:19:11.02,Default,,0,0,0,,Бұл таңғажайып оқиға.
Dialogue: 0,0:19:11.15,0:19:12.73,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:19:12.86,0:19:17.73,Default,,0,0,0,,Негізінде, ол адам кейпіне еніп, тергеу жүргізуі керек еді...
Dialogue: 0,0:19:17.86,0:19:21.53,Default,,0,0,0,,Мен қателесіп, тым дамыған тіршілік иесіне айналған сияқтымын.
Dialogue: 0,0:19:22.20,0:19:27.33,Default,,0,0,0,,Қай үкімет өз билігін пайдалануға тырысты? Бір компания ұстады...
Dialogue: 0,0:19:27.45,0:19:31.96,Default,,0,0,0,,Оған «Жаңғырық» деген атау беріліп, тіпті көшірмесі де жасалған.
Dialogue: 0,0:19:32.58,0:19:33.54,Default,,0,0,0,,Жаңғырық?
Dialogue: 0,0:19:33.92,0:19:37.71,Default,,0,0,0,,Иә, өйткені мен тек басқалардың айтқанын қайталай аламын...
Dialogue: 0,0:19:37.84,0:19:39.05,Default,,0,0,0,,«Жаңғырық»
Dialogue: 0,0:19:39.17,0:19:41.88,Default,,0,0,0,,Өзінің эволюциясына қарамастан, ол әлі де ыңғайсыз.
Dialogue: 0,0:19:42.26,0:19:43.80,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:19:44.72,0:19:47.60,Default,,0,0,0,,Өйткені жаңғырық адамның мейірімді немесе мейірімді екенін білмейді.
Dialogue: 0,0:19:47.72,0:19:49.31,Default,,0,0,0,,Мен жаңа ғана білу үшін келдім.
Dialogue: 0,0:19:49.89,0:19:51.85,Default,,0,0,0,,Біреуге мейірімді болу-
Dialogue: 0,0:19:51.98,0:19:55.06,Default,,0,0,0,,Ештеңе үшін өзіңізді сотқа берудің қажеті жоқ.
Dialogue: 0,0:19:55.77,0:19:58.98,Default,,0,0,0,,Бірақ Echoes-тен айырмашылығы, көшірме...
Dialogue: 0,0:19:59.11,0:20:01.53,Default,,0,0,0,,Сұмдық адам жегішке айналды
Dialogue: 0,0:20:01.65,0:20:05.20,Default,,0,0,0,,Ғылыми-зерттеу институтында барлығын өлтіріп, қашып кетті...
Dialogue: 0,0:20:05.32,0:20:08.33,Default,,0,0,0,,Басқаша айтқанда, жаңғырық және басқалар жауапкершілікті сезінеді...
Dialogue: 0,0:20:08.45,0:20:10.91,Default,,0,0,0,,Сіз бұл көшірмені қуып жүрсіз бе?
Dialogue: 0,0:20:11.33,0:20:14.96,Default,,0,0,0,,Сіз бұл туралы бірінші рет қалай естідіңіз?
Dialogue: 0,0:20:15.08,0:20:17.13,Default,,0,0,0,,Жаңғырық сөйлей алмайды, солай ма?
Dialogue: 0,0:20:17.67,0:20:19.63,Default,,0,0,0,,Әйтеуір... Менің ойымша
Dialogue: 0,0:20:19.76,0:20:22.30,Default,,0,0,0,,Жүректен-жүрекке байланысты бір нәрсе бар ма?
Dialogue: 0,0:20:23.55,0:20:25.80,Default,,0,0,0,,Оның көшірмесін табуымды қалайсың ба?
Dialogue: 0,0:20:26.47,0:20:27.43,Default,,0,0,0,,Иә
Dialogue: 0,0:20:28.10,0:20:31.14,Default,,0,0,0,,Ехос қазір қайда?
Dialogue: 0,0:20:31.39,0:20:32.39,Default,,0,0,0,,Мектеп
Dialogue: 0,0:20:32.52,0:20:35.35,Default,,0,0,0,,Неге екені белгісіз, мен бұл ең қауіпсіз деп ойладым.
Dialogue: 0,0:20:35.48,0:20:36.69,Default,,0,0,0,,Маған айтпа
Dialogue: 0,0:20:38.27,0:20:41.57,Default,,0,0,0,,Олай болса, мен жақында мектептен босатыламын.
Dialogue: 0,0:20:43.61,0:20:45.78,Default,,0,0,0,,Рахмет Наги
Dialogue: 0,0:20:48.78,0:20:54.79,Default,,0,0,0,,(Юрихараның үрейлі дауысы)
Dialogue: 0,0:20:57.38,0:21:02.17,Default,,0,0,0,,Жарайды, Мантикора, жағдай біздің пайдамызға.
Dialogue: 0,0:21:05.93,0:21:09.30,Default,,0,0,0,,Сіз Наоко Камикиджоның мәйітін тастадыңыз.
Dialogue: 0,0:21:09.55,0:21:11.14,Default,,0,0,0,,Бұл жерде ештеңе жоқ
Dialogue: 0,0:21:11.68,0:21:15.27,Default,,0,0,0,,Тек басқа қыз жоғалып кетті.
Dialogue: 0,0:21:19.36,0:21:22.78,Default,,0,0,0,,Эй Наги, егер жаңғырық ғарышқа оралса ше?
Dialogue: 0,0:21:22.90,0:21:26.45,Default,,0,0,0,,Ол адамдарды ғаламмен қалай таныстырар еді?
Dialogue: 0,0:21:26.57,0:21:27.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:27.61,0:21:31.33,Default,,0,0,0,,«Жарайды, жақсы жаратылыс» дейсіз бе?
Dialogue: 0,0:21:31.45,0:21:32.29,Default,,0,0,0,,Иә
Dialogue: 0,0:21:32.79,0:21:35.08,Default,,0,0,0,,Мүмкін жақсы аралассаңыз
Dialogue: 0,0:21:35.21,0:21:37.29,Default,,0,0,0,,Әйтпесе құтқарылу жоқ.
Dialogue: 0,0:21:39.08,0:21:40.71,Default,,0,0,0,,деп үміттенемін
Dialogue: 0,0:21:57.56,0:21:59.52,Default,,0,0,0,,Наоко жоғалып кетті
Dialogue: 0,0:21:59.94,0:22:01.19,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:22:05.36,0:22:06.86,Default,,0,0,0,,Бірдеңе айт
Dialogue: 0,0:22:07.28,0:22:08.53,Default,,0,0,0,,Жаңғырық
Dialogue: 0,0:22:11.45,0:22:16.79,Default,,0,0,0,,♪～
Dialogue: 0,0:23:34.78,0:23:39.00,Default,,0,0,0,,～♪
