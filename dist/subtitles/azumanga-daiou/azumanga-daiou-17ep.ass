Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.69,0:01:37.36,Default,,0000,0000,0000,,Үйге қайтайық, Чио-чан.
Dialogue: 0,0:01:37.36,0:01:41.53,Default,,0000,0000,0000,,А, кітап дүкеніне барайық.
Dialogue: 0,0:01:37.36,0:01:41.53,Default,,0000,0000,0000,,Мен тоқтай аламын ба?
Dialogue: 0,0:01:41.53,0:01:43.53,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:01:43.53,0:01:46.37,Default,,0000,0000,0000,,Қызықты кітаптар бар ма?
Dialogue: 0,0:01:46.37,0:01:50.87,Default,,0000,0000,0000,,Бүгінгі күн өте сүйкімді
Dialogue: 0,0:01:46.37,0:01:50.87,Default,,0000,0000,0000,,Пандалар туралы фотокітап шығады.
Dialogue: 0,0:01:50.87,0:01:54.88,Default,,0000,0000,0000,,өтіңіз.
Dialogue: 0,0:01:50.87,0:01:54.88,Default,,0000,0000,0000,,Бірақ жақсы беделге ие сияқты➡
Dialogue: 0,0:01:54.88,0:01:57.55,Default,,0000,0000,0000,,сатылуы керек
Dialogue: 0,0:01:54.88,0:01:57.55,Default,,0000,0000,0000,,Жарайды, бірақ...
Dialogue: 0,0:01:57.55,0:01:59.55,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:01:59.55,0:02:02.32,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:02:02.32,0:02:04.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:02.32,0:02:04.32,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:02:04.32,0:02:06.32,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:02:10.33,0:02:13.83,Default,,0000,0000,0000,,Коллер Дәлізде жүгірме!
Dialogue: 0,0:02:13.83,0:02:17.83,Default,,0000,0000,0000,,Қазірдің өзінде... Не асығыстық екен деп ойлаймын.
Dialogue: 0,0:02:17.83,0:02:21.84,Default,,0000,0000,0000,,Айтпақшы, Чио-чан.
Dialogue: 0,0:02:17.83,0:02:21.84,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:02:21.84,0:02:24.17,Default,,0000,0000,0000,,Бұл панда.
Dialogue: 0,0:02:21.84,0:02:24.17,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:02:24.17,0:02:28.18,Default,,0000,0000,0000,,Қай жерде ақ, ​​қай жерде қара?
Dialogue: 0,0:02:28.18,0:02:31.85,Default,,0000,0000,0000,,Ммм...
Dialogue: 0,0:02:31.85,0:02:40.36,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:40.36,0:02:43.36,Default,,0000,0000,0000,,Иә. Орындалды.
Dialogue: 0,0:02:47.86,0:02:51.20,Default,,0000,0000,0000,,Сәл айырмашылық жоқ па?
Dialogue: 0,0:02:51.20,0:02:53.70,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:02:53.70,0:02:56.20,Default,,0000,0000,0000,,Мен солай сезінемін.
Dialogue: 0,0:02:56.20,0:02:59.40,Default,,0000,0000,0000,,Мен оны теледидардан көргеніме сенімдімін...
Dialogue: 0,0:03:01.48,0:03:03.48,Default,,0000,0000,0000,,Және...
Dialogue: 0,0:03:03.48,0:03:14.99,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:03:14.99,0:03:18.33,Default,,0000,0000,0000,,Мұндағы тіршілік иелері...
Dialogue: 0,0:03:18.33,0:03:22.66,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:03:18.33,0:03:22.66,Default,,0000,0000,0000,,Бұл панда емес.
Dialogue: 0,0:03:22.66,0:03:25.56,Default,,0000,0000,0000,,Сүйегім сынды!
Dialogue: 0,0:03:22.66,0:03:25.56,Default,,0000,0000,0000,,Үйге барайық Үйге қайтайық.
Dialogue: 0,0:03:27.67,0:03:30.67,Default,,0000,0000,0000,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:03:27.67,0:03:30.67,Default,,0000,0000,0000,,Жануар?
Dialogue: 0,0:03:30.67,0:03:33.37,Default,,0000,0000,0000,,Бұл панда.
Dialogue: 0,0:03:30.67,0:03:33.37,Default,,0000,0000,0000,,Панда~.
Dialogue: 0,0:03:35.34,0:03:37.68,Default,,0000,0000,0000,,Панда?
Dialogue: 0,0:03:37.68,0:03:42.68,Default,,0000,0000,0000,,Мен шын мәнінде пандамын
Dialogue: 0,0:03:37.68,0:03:42.68,Default,,0000,0000,0000,,Мен оны әлі көрген жоқпын.
Dialogue: 0,0:03:42.68,0:03:47.69,Default,,0000,0000,0000,,А, мен оны бұрын көргенмін.
Dialogue: 0,0:03:42.68,0:03:47.69,Default,,0000,0000,0000,,Хайуанаттар бағында.
Dialogue: 0,0:03:47.69,0:03:51.03,Default,,0000,0000,0000,,Иә, сүйкімді.
Dialogue: 0,0:03:47.69,0:03:51.03,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:03:51.03,0:03:53.53,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:03:51.03,0:03:53.53,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:53.53,0:03:56.36,Default,,0000,0000,0000,,Ақ түсте қараны қолдандыңыз ба?
Dialogue: 0,0:03:56.36,0:03:59.56,Default,,0000,0000,0000,,Әлде қараның үстінде ақ па?
Dialogue: 0,0:04:02.47,0:04:04.64,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:04:04.64,0:04:07.81,Default,,0000,0000,0000,,Содан кейін келесі жолы
Dialogue: 0,0:04:04.64,0:04:07.81,Default,,0000,0000,0000,,Бәріміз барып көрейік.
Dialogue: 0,0:04:07.81,0:04:10.98,Default,,0000,0000,0000,,А, бұл жақсы болуы мүмкін.
Dialogue: 0,0:04:07.81,0:04:10.98,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:04:10.98,0:04:16.15,Default,,0000,0000,0000,,Мен де пандаларды көргім келеді.
Dialogue: 0,0:04:10.98,0:04:16.15,Default,,0000,0000,0000,,Мен көргім келетін тағы бір нәрсе бар.
Dialogue: 0,0:04:16.15,0:04:19.32,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:04:16.15,0:04:19.32,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:04:19.32,0:04:22.82,Default,,0000,0000,0000,,Қараңдаршы, сен не айттың?
Dialogue: 0,0:04:25.33,0:04:27.53,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:04:30.50,0:04:34.60,Default,,0000,0000,0000,,Ах! Сол жүгіретін шам.
Dialogue: 0,0:04:36.84,0:04:38.84,Default,,0000,0000,0000,,Олай етпе.
Dialogue: 0,0:04:38.84,0:04:43.51,Default,,0000,0000,0000,,Ойлап қарасам, кеше
Dialogue: 0,0:04:38.84,0:04:43.51,Default,,0000,0000,0000,,Менде қорқынышты оқиға болды.
Dialogue: 0,0:04:43.51,0:04:46.18,Default,,0000,0000,0000,,О! Әңгімені тыңдайық.
Dialogue: 0,0:04:43.51,0:04:46.18,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:04:46.18,0:04:49.68,Default,,0000,0000,0000,,Мен ешқашан таңертең оянамын деп ойламадым
Dialogue: 0,0:04:46.18,0:04:49.68,Default,,0000,0000,0000,,Бұл стандартты тілге айналды! ?
Dialogue: 0,0:04:49.68,0:04:54.08,Default,,0000,0000,0000,,О! Бұл да қорқынышты.
Dialogue: 0,0:04:56.19,0:04:59.36,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:04:59.36,0:05:01.63,Default,,0000,0000,0000,,Әй, ау.
Dialogue: 0,0:05:01.63,0:05:05.03,Default,,0000,0000,0000,,Бұл стандартты тіл емес.
Dialogue: 0,0:05:01.63,0:05:05.03,Default,,0000,0000,0000,,Жарайды, әрі қарай жүрейік.
Dialogue: 0,0:05:07.97,0:05:10.14,Default,,0000,0000,0000,,Өткен түн...
Dialogue: 0,0:05:10.14,0:05:15.31,Default,,0000,0000,0000,,Мен бөлмемде жалғыз қалғанда
Dialogue: 0,0:05:10.14,0:05:15.31,Default,,0000,0000,0000,,Бірден...
Dialogue: 0,0:05:15.31,0:05:17.48,Default,,0000,0000,0000,,(Аңқылдаған дыбыс)
Dialogue: 0,0:05:17.48,0:05:21.48,Default,,0000,0000,0000,,Менің
Dialogue: 0,0:05:17.48,0:05:21.48,Default,,0000,0000,0000,,Осардың иісі бар.
Dialogue: 0,0:05:27.16,0:05:29.66,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:05:29.66,0:05:32.66,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:05:32.66,0:05:35.00,Default,,0000,0000,0000,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:05:35.00,0:05:38.67,Default,,0000,0000,0000,,(Тыныс алу жүгіру)
Dialogue: 0,0:05:38.67,0:05:41.00,Default,,0000,0000,0000,,Яббе~ Мен тағы да кешігіп қалдым.
Dialogue: 0,0:05:41.00,0:05:43.17,Default,,0000,0000,0000,,(Тыныс алу жүгіру)
Dialogue: 0,0:05:43.17,0:05:46.51,Default,,0000,0000,0000,,Танизаки мырза.
Dialogue: 0,0:05:46.51,0:05:48.51,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:05:50.51,0:05:53.18,Default,,0000,0000,0000,,Желтоқсан болғандықтан ба?
Dialogue: 0,0:05:50.51,0:05:53.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:53.18,0:05:56.35,Default,,0000,0000,0000,,Желтоқсан болғандықтан жүгіріп жатырсыз ба? ?
Dialogue: 0,0:05:56.35,0:06:00.79,Default,,0000,0000,0000,,Өйткені, Танизаки мырза
Dialogue: 0,0:05:56.35,0:06:00.79,Default,,0000,0000,0000,,Сізде әзіл-оспақ бар.
Dialogue: 0,0:06:00.79,0:06:03.12,Default,,0000,0000,0000,,Ха~ Хахаха!
Dialogue: 0,0:06:03.12,0:06:06.13,Default,,0000,0000,0000,,Мм... Мен біраз асығып тұрмын.
Dialogue: 0,0:06:06.13,0:06:10.47,Default,,0000,0000,0000,,Ей, желтоқсан туралы
Dialogue: 0,0:06:06.13,0:06:10.47,Default,,0000,0000,0000,,Сіз не айттыңыз?
Dialogue: 0,0:06:10.47,0:06:12.80,Default,,0000,0000,0000,,Иә, ақжелмек?
Dialogue: 0,0:06:12.80,0:06:15.47,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:06:12.80,0:06:15.47,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:06:15.47,0:06:18.14,Default,,0000,0000,0000,,Маған ұнады — тым драмалық естіледі!
Dialogue: 0,0:06:15.47,0:06:18.14,Default,,0000,0000,0000,,Бұл "шивасу"!
Dialogue: 0,0:06:18.14,0:06:22.48,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:06:18.14,0:06:22.48,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:06:18.14,0:06:22.48,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:06:22.48,0:06:25.31,Default,,0000,0000,0000,,Жоқ, Чио-чан, цуккомиге тырыссаңыз.
Dialogue: 0,0:06:25.31,0:06:28.15,Default,,0000,0000,0000,,Иә, бұл Ақан.
Dialogue: 0,0:06:28.15,0:06:30.35,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:33.99,0:06:36.16,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:06:36.16,0:06:39.66,Default,,0000,0000,0000,,Кешіріңіз, кешіріңіз, кешіріңіз!
Dialogue: 0,0:06:39.66,0:06:43.00,Default,,0000,0000,0000,,Мына жігіттер не дейді
Dialogue: 0,0:06:39.66,0:06:43.00,Default,,0000,0000,0000,,Мұқият тыңдамаңыз.
Dialogue: 0,0:06:43.00,0:06:47.67,Default,,0000,0000,0000,,Уф, гохон. Аа~ Онда.
Dialogue: 0,0:06:47.67,0:06:51.34,Default,,0000,0000,0000,,Желтоқсан туралы не айттым?
Dialogue: 0,0:06:47.67,0:06:51.34,Default,,0000,0000,0000,,Қайталанбаңыз!
Dialogue: 0,0:06:51.34,0:06:54.34,Default,,0000,0000,0000,,Иә, отырыңыз!
Dialogue: 0,0:06:54.34,0:06:57.85,Default,,0000,0000,0000,,Мен әрқашан тек ағылшын тілін үйретемін.
Dialogue: 0,0:06:54.34,0:06:57.85,Default,,0000,0000,0000,,Мен жалықтым!
Dialogue: 0,0:06:57.85,0:07:00.78,Default,,0000,0000,0000,,Сонымен бүгін
Dialogue: 0,0:06:57.85,0:07:00.78,Default,,0000,0000,0000,,Мен саған математикадан сабақ беремін.
Dialogue: 0,0:07:00.78,0:07:02.98,Default,,0000,0000,0000,,Математика?
Dialogue: 0,0:07:08.79,0:07:10.79,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:07:13.63,0:07:15.80,Default,,0000,0000,0000,,Гаа~! !
Dialogue: 0,0:07:15.80,0:07:19.13,Default,,0000,0000,0000,,Дене шынықтырумен айналысыңыз Барлығы сыртқа шығыңыз!
Dialogue: 0,0:07:19.13,0:07:26.14,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:07:26.14,0:07:28.31,Default,,0000,0000,0000,,Усабу~.
Dialogue: 0,0:07:28.31,0:07:31.15,Default,,0000,0000,0000,,Бірақ неге ағылшын тілі?
Dialogue: 0,0:07:28.31,0:07:31.15,Default,,0000,0000,0000,,Сіз дене шынықтыру пәнінен өтесіз бе?
Dialogue: 0,0:07:31.15,0:07:34.32,Default,,0000,0000,0000,,Юкари Сенсейдің дене тәрбиесі
Dialogue: 0,0:07:31.15,0:07:34.32,Default,,0000,0000,0000,,Сіз не істемексіз?
Dialogue: 0,0:07:34.32,0:07:37.49,Default,,0000,0000,0000,,Бұл американдық дене тәрбиесі ме?
Dialogue: 0,0:07:37.49,0:07:41.66,Default,,0000,0000,0000,,Америка болсын, Англия болсын, мен жеңілмеймін, Сакаки!
Dialogue: 0,0:07:41.66,0:07:44.83,Default,,0000,0000,0000,,Жарайды! Футбол ойнайық. Футбол.
Dialogue: 0,0:07:44.83,0:07:47.16,Default,,0000,0000,0000,,Юкари-чан, сен ережелерді білесің бе?
Dialogue: 0,0:07:47.16,0:07:49.16,Default,,0000,0000,0000,,Маған қалдырыңыз!
Dialogue: 0,0:07:49.16,0:07:51.83,Default,,0000,0000,0000,,I Наката.
Dialogue: 0,0:07:49.16,0:07:51.83,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:51.83,0:07:54.84,Default,,0000,0000,0000,,Наката мұны жасайды.
Dialogue: 0,0:07:54.84,0:07:56.84,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:08:00.44,0:08:03.95,Default,,0000,0000,0000,,Урия Урья
Dialogue: 0,0:08:00.44,0:08:03.95,Default,,0000,0000,0000,,Урия Урия Урия….
Dialogue: 0,0:08:03.95,0:08:05.95,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:08:11.29,0:08:13.29,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:13.29,0:08:15.29,Default,,0000,0000,0000,,Мақсат! !
Dialogue: 0,0:08:15.29,0:08:18.79,Default,,0000,0000,0000,,Мақсат Мақсат Мақсат! Мақсат Мақсат Мақсат....
Dialogue: 0,0:08:18.79,0:08:21.63,Default,,0000,0000,0000,,Мұғалім, бұл сіздің командаңыздың мақсаты.
Dialogue: 0,0:08:21.63,0:08:25.63,Default,,0000,0000,0000,,Хехехе... Негізі мен шпион едім.
Dialogue: 0,0:08:25.63,0:08:27.80,Default,,0000,0000,0000,,Мен оны түсінбеймін.
Dialogue: 0,0:08:31.47,0:08:34.81,Default,,0000,0000,0000,,Урия Урия Урия.
Dialogue: 0,0:08:31.47,0:08:34.81,Default,,0000,0000,0000,,Бұл жолы барайық!
Dialogue: 0,0:08:34.81,0:08:38.31,Default,,0000,0000,0000,,Урия Урья
Dialogue: 0,0:08:34.81,0:08:38.31,Default,,0000,0000,0000,,Урия Урья Урья~!
Dialogue: 0,0:08:38.31,0:08:40.48,Default,,0000,0000,0000,,Жолдан кет, жолдан кет, жолдан кет!
Dialogue: 0,0:08:40.48,0:08:42.48,Default,,0000,0000,0000,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:08:45.99,0:08:51.33,Default,,0000,0000,0000,,(дыбысты дауыс)
Dialogue: 0,0:08:51.33,0:08:53.49,Default,,0000,0000,0000,,Футболдан бас тарт! Доджбол ойнайық!
Dialogue: 0,0:08:53.49,0:08:59.67,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:59.67,0:09:03.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:59.67,0:09:03.94,Default,,0000,0000,0000,,Неліктен Юкари сыныбында дене тәрбиесі бар?
Dialogue: 0,0:09:03.94,0:09:06.11,Default,,0000,0000,0000,,Акан Аканте.
Dialogue: 0,0:09:06.11,0:09:08.11,Default,,0000,0000,0000,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:09:08.11,0:09:10.44,Default,,0000,0000,0000,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:09:08.11,0:09:10.44,Default,,0000,0000,0000,,Бар, Сакаки-сан!
Dialogue: 0,0:09:10.44,0:09:13.95,Default,,0000,0000,0000,,Жоқ...!
Dialogue: 0,0:09:10.44,0:09:13.95,Default,,0000,0000,0000,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:09:13.95,0:09:17.29,Default,,0000,0000,0000,,Кя!
Dialogue: 0,0:09:13.95,0:09:17.29,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:17.29,0:09:19.29,Default,,0000,0000,0000,,Мен жеңілдім!
Dialogue: 0,0:09:19.29,0:09:21.62,Default,,0000,0000,0000,,А... бұл.
Dialogue: 0,0:09:21.62,0:09:24.63,Default,,0000,0000,0000,,Уау, мен жалғызбын!
Dialogue: 0,0:09:24.63,0:09:26.63,Default,,0000,0000,0000,,Чиосуке, дайын бол!
Dialogue: 0,0:09:26.63,0:09:32.30,Default,,0000,0000,0000,,(Қашып бара жатқан дауыс)
Dialogue: 0,0:09:32.30,0:09:35.14,Default,,0000,0000,0000,,А, аа! ! Эй...
Dialogue: 0,0:09:35.14,0:09:37.97,Default,,0000,0000,0000,,(Наширо) Рей (Джузо Сузуя) Хм?
Dialogue: 0,0:09:37.97,0:09:39.97,Default,,0000,0000,0000,,Қазірдің өзінде болжаңыз.
Dialogue: 0,0:09:39.97,0:09:43.64,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:43.64,0:09:46.31,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:09:46.31,0:09:49.48,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:09:46.31,0:09:49.48,Default,,0000,0000,0000,,Сондай байсалды жүзбен.
Dialogue: 0,0:09:49.48,0:09:52.65,Default,,0000,0000,0000,,Сіз не қарап тұрсыз?
Dialogue: 0,0:09:49.48,0:09:52.65,Default,,0000,0000,0000,,Жыл соңындағы сыйлықтар каталогы.
Dialogue: 0,0:09:52.65,0:09:56.16,Default,,0000,0000,0000,,Эй, сен маған бірдеңе бересің бе? кімге?
Dialogue: 0,0:09:56.16,0:09:58.99,Default,,0000,0000,0000,,Не? Хахаха….
Dialogue: 0,0:09:58.99,0:10:02.50,Default,,0000,0000,0000,,Біреуге бірдеңе бергенде не істейсің?
Dialogue: 0,0:09:58.99,0:10:02.50,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:02.50,0:10:06.17,Default,,0000,0000,0000,,Бірақ, мен осындай нәрсені көргенде➡
Dialogue: 0,0:10:06.17,0:10:09.67,Default,,0000,0000,0000,,Бұл сіздің жүрегіңізді байытады, солай емес пе?
Dialogue: 0,0:10:06.17,0:10:09.67,Default,,0000,0000,0000,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:10:09.67,0:10:12.67,Default,,0000,0000,0000,,Бұл ма?
Dialogue: 0,0:10:12.67,0:10:15.68,Default,,0000,0000,0000,,Жоқ, бұл.
Dialogue: 0,0:10:15.68,0:10:18.51,Default,,0000,0000,0000,,О~ Бұны да тастау қиын.
Dialogue: 0,0:10:18.51,0:10:21.52,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:10:21.52,0:10:25.02,Default,,0000,0000,0000,,Әй, ыдыс-аяқ жинағы жақсы екен.
Dialogue: 0,0:10:21.52,0:10:25.02,Default,,0000,0000,0000,,Иә! !
Dialogue: 0,0:10:25.02,0:10:28.52,Default,,0000,0000,0000,,О, ауырып тұр! Сен не істеп жатырсың?
Dialogue: 0,0:10:25.02,0:10:28.52,Default,,0000,0000,0000,,Сіз ақымақсыз ба?
Dialogue: 0,0:10:28.52,0:10:30.86,Default,,0000,0000,0000,,Бұл салқын болатын уақыт емес.
Dialogue: 0,0:10:30.86,0:10:34.03,Default,,0000,0000,0000,,Қараңдаршы, қар шаян! Қар шаян!
Dialogue: 0,0:10:34.03,0:10:37.70,Default,,0000,0000,0000,,Мүлдем... Шаян жақсырақ.
Dialogue: 0,0:10:34.03,0:10:37.70,Default,,0000,0000,0000,,Мен жақсы екеніне сенімдімін.
Dialogue: 0,0:10:37.70,0:10:41.54,Default,,0000,0000,0000,,Иә? Кішкене, Минамо-сан.
Dialogue: 0,0:10:37.70,0:10:41.54,Default,,0000,0000,0000,,Негізгісі – ой.
Dialogue: 0,0:10:41.54,0:10:46.37,Default,,0000,0000,0000,,Мацузака сиыр етін жеп көрдіңіз бе?
Dialogue: 0,0:10:46.37,0:10:49.54,Default,,0000,0000,0000,,№.
Dialogue: 0,0:10:49.54,0:10:52.64,Default,,0000,0000,0000,,Дәмді екен.
Dialogue: 0,0:10:49.54,0:10:52.64,Default,,0000,0000,0000,,Бұл солай сияқты.
Dialogue: 0,0:10:54.72,0:10:56.72,Default,,0000,0000,0000,,Юкари Сенсей.
Dialogue: 0,0:10:54.72,0:10:56.72,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:56.72,0:11:00.66,Default,,0000,0000,0000,,Иә, мен мұны әкелдім.
Dialogue: 0,0:10:56.72,0:11:00.66,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:11:00.66,0:11:02.99,Default,,0000,0000,0000,,Токичиосуке.
Dialogue: 0,0:11:00.66,0:11:02.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:02.99,0:11:06.16,Default,,0000,0000,0000,,Мацузака сиыр еті дегеніміз не?
Dialogue: 0,0:11:02.99,0:11:06.16,Default,,0000,0000,0000,,Сіз оны жеп көрдіңіз бе?
Dialogue: 0,0:11:06.16,0:11:09.83,Default,,0000,0000,0000,,Иә? Иә. Сонда бар.
Dialogue: 0,0:11:09.83,0:11:11.83,Default,,0000,0000,0000,,Ауырды!
Dialogue: 0,0:11:11.83,0:11:14.83,Default,,0000,0000,0000,,Олай болса, сен
Dialogue: 0,0:11:11.83,0:11:14.83,Default,,0000,0000,0000,,Осылардың қайсысын қалайсыз?
Dialogue: 0,0:11:18.51,0:11:22.01,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:11:22.01,0:11:25.68,Default,,0000,0000,0000,,А, мына балмұздақ жинағы дәмді көрінеді.
Dialogue: 0,0:11:25.68,0:11:27.85,Default,,0000,0000,0000,,Балмұздақ?
Dialogue: 0,0:11:27.85,0:11:30.02,Default,,0000,0000,0000,,Бұл сіздің бала екеніңізді білдіре ме?
Dialogue: 0,0:11:30.02,0:11:33.02,Default,,0000,0000,0000,,Әлде буржуазиялық сән-салтанат па?
Dialogue: 0,0:11:33.02,0:11:36.02,Default,,0000,0000,0000,,Мацузака сиыр еті дәмдірек!
Dialogue: 0,0:11:39.53,0:11:42.03,Default,,0000,0000,0000,,Рождество мерекесімен.
Dialogue: 0,0:11:42.03,0:11:45.20,Default,,0000,0000,0000,,Не болды, Осака мырза?
Dialogue: 0,0:11:45.20,0:11:48.04,Default,,0000,0000,0000,,Рождество мерекесімен.
Dialogue: 0,0:11:48.04,0:11:51.04,Default,,0000,0000,0000,,Әй, Рождество жақындап қалды.
Dialogue: 0,0:11:51.04,0:11:54.88,Default,,0000,0000,0000,,Дұрыс, Рождество мерекесімен.
Dialogue: 0,0:11:54.88,0:11:58.88,Default,,0000,0000,0000,,Биылғы жыл – сыйлық
Dialogue: 0,0:11:54.88,0:11:58.88,Default,,0000,0000,0000,,Мен не алатынымды асыға күтемін.
Dialogue: 0,0:11:58.88,0:12:02.32,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:11:58.88,0:12:02.32,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:12:02.32,0:12:05.15,Default,,0000,0000,0000,,Эй, бұл Чиё Чан.
Dialogue: 0,0:12:02.32,0:12:05.15,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:05.15,0:12:08.16,Default,,0000,0000,0000,,Сіз әлі де Аяз атаға сенесіз бе?
Dialogue: 0,0:12:08.16,0:12:11.49,Default,,0000,0000,0000,,Енді оны неге тікелей сұрамайсың?
Dialogue: 0,0:12:11.49,0:12:15.99,Default,,0000,0000,0000,,Чиёчан сен
Dialogue: 0,0:12:11.49,0:12:15.99,Default,,0000,0000,0000,,Сіз әлі де Аяз атаға сенесіз бе?
Dialogue: 0,0:12:11.49,0:12:15.99,Default,,0000,0000,0000,,Гаа! !
Dialogue: 0,0:12:18.00,0:12:20.50,Default,,0000,0000,0000,,Идиот!
Dialogue: 0,0:12:20.50,0:12:22.84,Default,,0000,0000,0000,,Сенсең не істер едің?
Dialogue: 0,0:12:22.84,0:12:25.51,Default,,0000,0000,0000,,Сіз өз арманыңызды жоя алмайсыз!
Dialogue: 0,0:12:25.51,0:12:29.34,Default,,0000,0000,0000,,Сонымен, оны қалай түсіндіресіз?
Dialogue: 0,0:12:25.51,0:12:29.34,Default,,0000,0000,0000,,Қый!
Dialogue: 0,0:12:29.34,0:12:33.18,Default,,0000,0000,0000,,Бұл шексіз тұйық
Dialogue: 0,0:12:29.34,0:12:33.18,Default,,0000,0000,0000,,Еліміз бойынша балаларға арналған сыйлықтардың құны ➡
Dialogue: 0,0:12:33.18,0:12:35.68,Default,,0000,0000,0000,,Біреу сізден оның қайдан келгенін сұраса ше?
Dialogue: 0,0:12:35.68,0:12:37.69,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:12:37.69,0:12:41.19,Default,,0000,0000,0000,,Бұл ел! Ел Аяз атаға төлейді.
Dialogue: 0,0:12:41.19,0:12:44.36,Default,,0000,0000,0000,,Енді Энтцу деген нәрсе жоқ.
Dialogue: 0,0:12:41.19,0:12:44.36,Default,,0000,0000,0000,,Мен қайда кіремін?
Dialogue: 0,0:12:44.36,0:12:46.53,Default,,0000,0000,0000,,Аяз атаны жалама!
Dialogue: 0,0:12:46.53,0:12:48.70,Default,,0000,0000,0000,,Құлыптарды таңдаудың таңғажайып техникасы
Dialogue: 0,0:12:46.53,0:12:48.70,Default,,0000,0000,0000,,Менде бар!
Dialogue: 0,0:12:48.70,0:12:50.70,Default,,0000,0000,0000,,Мен кез келген нәрсені аша аламын!
Dialogue: 0,0:12:50.70,0:12:54.20,Default,,0000,0000,0000,,Бұл бір түнде қалай болды?
Dialogue: 0,0:12:50.70,0:12:54.20,Default,,0000,0000,0000,,Сіз дүние жүзіндегі үйлерді аралайсыз ба?
Dialogue: 0,0:12:54.20,0:12:56.70,Default,,0000,0000,0000,,Бұл жылдам!
Dialogue: 0,0:12:54.20,0:12:56.70,Default,,0000,0000,0000,,Бұл өте жылдам!
Dialogue: 0,0:12:56.70,0:13:00.47,Default,,0000,0000,0000,,100 Mach туралы!
Dialogue: 0,0:12:56.70,0:13:00.47,Default,,0000,0000,0000,,Өтірік айтпа. Ондай адам жоқ.
Dialogue: 0,0:13:00.47,0:13:02.48,Default,,0000,0000,0000,,Аяз ата адам емес!
Dialogue: 0,0:13:00.47,0:13:02.48,Default,,0000,0000,0000,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:13:02.48,0:13:04.48,Default,,0000,0000,0000,,Сонда мені бөтен планеталық деп атағың келе ме?
Dialogue: 0,0:13:04.48,0:13:06.65,Default,,0000,0000,0000,,Ол ғарыштан келген жоқ.
Dialogue: 0,0:13:04.48,0:13:06.65,Default,,0000,0000,0000,,Мен олай ойламаймын...
Dialogue: 0,0:13:06.65,0:13:09.32,Default,,0000,0000,0000,,Сонда ол жер астында ма? Теңіздің астында ма?
Dialogue: 0,0:13:09.32,0:13:12.65,Default,,0000,0000,0000,,Мм... жарайды.
Dialogue: 0,0:13:09.32,0:13:12.65,Default,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:13:12.65,0:13:14.66,Default,,0000,0000,0000,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:13:12.65,0:13:14.66,Default,,0000,0000,0000,,Сіз бөтен планеталық екеніңізге сенімдісіз бе?
Dialogue: 0,0:13:14.66,0:13:18.66,Default,,0000,0000,0000,,Әлде жер астындағы адамдар ма?
Dialogue: 0,0:13:14.66,0:13:18.66,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:13:18.66,0:13:21.83,Default,,0000,0000,0000,,Аяз ата - әке!
Dialogue: 0,0:13:21.83,0:13:25.67,Default,,0000,0000,0000,,Әке?
Dialogue: 0,0:13:21.83,0:13:25.67,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:13:25.67,0:13:29.00,Default,,0000,0000,0000,,Дұрыс, хехехе.
Dialogue: 0,0:13:29.00,0:13:32.60,Default,,0000,0000,0000,,Аяз ата... сенің әкең бе?
Dialogue: 0,0:13:35.18,0:13:38.18,Default,,0000,0000,0000,,Чионың әкесі: Мэри
Dialogue: 0,0:13:38.18,0:13:42.85,Default,,0000,0000,0000,,Уф... ой...
Dialogue: 0,0:13:42.85,0:13:45.02,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:13:45.02,0:13:48.02,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:13:50.19,0:13:53.86,Default,,0000,0000,0000,,Рождество мерекесімен.
Dialogue: 0,0:13:53.86,0:13:58.37,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:13:53.86,0:13:58.37,Default,,0000,0000,0000,,Ия, менің әкем Аяз ата!
Dialogue: 0,0:13:58.37,0:14:01.57,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:14:03.64,0:14:08.81,Default,,0000,0000,0000,,Ақшаны үкімет береді.
Dialogue: 0,0:14:03.64,0:14:08.81,Default,,0000,0000,0000,,Керемет.
Dialogue: 0,0:14:08.81,0:14:13.65,Default,,0000,0000,0000,,Ол 100 м-де ұшады.
Dialogue: 0,0:14:08.81,0:14:13.65,Default,,0000,0000,0000,,Таңғажайып ғажайып
Dialogue: 0,0:14:13.65,0:14:16.82,Default,,0000,0000,0000,,Хмм... Уф...
Dialogue: 0,0:14:16.82,0:14:19.15,Default,,0000,0000,0000,,ше? иә?
Dialogue: 0,0:14:22.32,0:14:25.16,Default,,0000,0000,0000,,Сәлем күнтізбе.
Dialogue: 0,0:14:22.32,0:14:25.16,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:14:25.16,0:14:29.83,Default,,0000,0000,0000,,Білесің бе, бұл Рождестволық сыйлық.
Dialogue: 0,0:14:25.16,0:14:29.83,Default,,0000,0000,0000,,Егер менде бір нәрсе болса➡
Dialogue: 0,0:14:29.83,0:14:33.33,Default,,0000,0000,0000,,Не жақсы?
Dialogue: 0,0:14:29.83,0:14:33.33,Default,,0000,0000,0000,,Кез келген….
Dialogue: 0,0:14:33.33,0:14:35.84,Default,,0000,0000,0000,,Бұл шынымен де бір нәрсе ме?
Dialogue: 0,0:14:35.84,0:14:38.01,Default,,0000,0000,0000,,100 триллион иен дұрыс па?
Dialogue: 0,0:14:38.01,0:14:40.84,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:14:40.84,0:14:44.18,Default,,0000,0000,0000,,Мен нақтырақырақ нәрсені қалаймын.
Dialogue: 0,0:14:44.18,0:14:47.35,Default,,0000,0000,0000,,Бұл шынайы ма?
Dialogue: 0,0:14:47.35,0:14:52.35,Default,,0000,0000,0000,,Қаншалықты шынайы? 10 миллион жақсы ма?
Dialogue: 0,0:14:52.35,0:14:55.86,Default,,0000,0000,0000,,Қызық, қанша тұрады...
Dialogue: 0,0:14:55.86,0:14:57.86,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:14:57.86,0:15:02.63,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:14:57.86,0:15:02.63,Default,,0000,0000,0000,,Жаңа жылдық сыйлыққа не қалайсыз?
Dialogue: 0,0:15:02.63,0:15:04.80,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:15:04.80,0:15:08.97,Default,,0000,0000,0000,,Аа, вокзалдың алдында үлкен ағаш бар.
Dialogue: 0,0:15:04.80,0:15:08.97,Default,,0000,0000,0000,,солай емес пе?
Dialogue: 0,0:15:08.97,0:15:12.64,Default,,0000,0000,0000,,Сол Теппен
Dialogue: 0,0:15:08.97,0:15:12.64,Default,,0000,0000,0000,,Маған үлкен жұлдыз керек.
Dialogue: 0,0:15:12.64,0:15:17.65,Default,,0000,0000,0000,,Мен мұны көптен бері қалаймын.
Dialogue: 0,0:15:12.64,0:15:17.65,Default,,0000,0000,0000,,өтіңіз.
Dialogue: 0,0:15:17.65,0:15:20.65,Default,,0000,0000,0000,,Бұл кіршіксіз жүрек
Dialogue: 0,0:15:17.65,0:15:20.65,Default,,0000,0000,0000,,Оны Коёми-кун деп атайды.
Dialogue: 0,0:15:20.65,0:15:23.98,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:15:20.65,0:15:23.98,Default,,0000,0000,0000,,Бұл 100 триллион иен болды ма?
Dialogue: 0,0:15:23.98,0:15:27.15,Default,,0000,0000,0000,,Э~?
Dialogue: 0,0:15:23.98,0:15:27.15,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:15:27.15,0:15:30.66,Default,,0000,0000,0000,,Сәлем, не болып жатыр?
Dialogue: 0,0:15:30.66,0:15:32.66,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:15:30.66,0:15:32.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:32.66,0:15:34.83,Default,,0000,0000,0000,,Сізден бірдеңе сұрасам болады ма?
Dialogue: 0,0:15:34.83,0:15:36.83,Default,,0000,0000,0000,,Иә? Не өзгерді?
Dialogue: 0,0:15:36.83,0:15:40.03,Default,,0000,0000,0000,,Аяз ата болмаса да...
Dialogue: 0,0:15:36.83,0:15:40.03,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:15:42.67,0:15:46.34,Default,,0000,0000,0000,,Бұғылар бар, солай ма?
Dialogue: 0,0:15:46.34,0:15:51.01,Default,,0000,0000,0000,,Уку кукукуку... Ахахаха!
Dialogue: 0,0:15:51.01,0:15:53.68,Default,,0000,0000,0000,,Мен бұл бұғыға сенемін!
Dialogue: 0,0:15:51.01,0:15:53.68,Default,,0000,0000,0000,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:15:53.68,0:15:57.18,Default,,0000,0000,0000,,Иә! !
Dialogue: 0,0:15:57.18,0:15:59.52,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:59.52,0:16:01.96,Default,,0000,0000,0000,,Бұғылар бар.
Dialogue: 0,0:15:59.52,0:16:01.96,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:01.96,0:16:06.13,Default,,0000,0000,0000,,Ұшатын бұғы жоқ.
Dialogue: 0,0:16:06.13,0:16:09.13,Default,,0000,0000,0000,,Сіз мені алдамақ болдыңыз дедіңіз.
Dialogue: 0,0:16:06.13,0:16:09.13,Default,,0000,0000,0000,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:16:09.13,0:16:13.63,Default,,0000,0000,0000,,Ахахха.
Dialogue: 0,0:16:09.13,0:16:13.63,Default,,0000,0000,0000,,Ой, мына жігіт байсалды екен.
Dialogue: 0,0:16:13.63,0:16:16.64,Default,,0000,0000,0000,,Ей, эй, бұл дүниеде
Dialogue: 0,0:16:13.63,0:16:16.64,Default,,0000,0000,0000,,Бұғылар жоқ.
Dialogue: 0,0:16:16.64,0:16:19.81,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:16.64,0:16:19.81,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:16:19.81,0:16:22.48,Default,,0000,0000,0000,,Эй Осака, бұғы бар ма?
Dialogue: 0,0:16:22.48,0:16:25.31,Default,,0000,0000,0000,,Оруде.
Dialogue: 0,0:16:22.48,0:16:25.31,Default,,0000,0000,0000,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:16:25.31,0:16:27.31,Default,,0000,0000,0000,,Бұғылар бар.
Dialogue: 0,0:16:27.31,0:16:30.99,Default,,0000,0000,0000,,Аспанда ұша алмасам да
Dialogue: 0,0:16:27.31,0:16:30.99,Default,,0000,0000,0000,,Мынау.
Dialogue: 0,0:16:30.99,0:16:33.59,Default,,0000,0000,0000,,Бұғы мен бұғы екі түрлі заттар.
Dialogue: 0,0:16:37.83,0:16:43.16,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:16:37.83,0:16:43.16,Default,,0000,0000,0000,,Мен ақымақ емеспін. Мен ақымақ емеспін!
Dialogue: 0,0:16:43.16,0:16:46.33,Default,,0000,0000,0000,,Мен жаңа жылдық ашықхат жазуым керек.
Dialogue: 0,0:16:46.33,0:16:49.34,Default,,0000,0000,0000,,На~Чи-чан.
Dialogue: 0,0:16:46.33,0:16:49.34,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:49.34,0:16:54.17,Default,,0000,0000,0000,,Келесі жылы не істедің?
Dialogue: 0,0:16:49.34,0:16:54.17,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:16:54.17,0:16:59.68,Default,,0000,0000,0000,,Ей, бұл сиыр.
Dialogue: 0,0:16:54.17,0:16:59.68,Default,,0000,0000,0000,,Тацуми~.
Dialogue: 0,0:16:59.68,0:17:02.45,Default,,0000,0000,0000,,Осы жылы не істедіңіз?
Dialogue: 0,0:17:02.45,0:17:04.62,Default,,0000,0000,0000,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:17:04.62,0:17:09.32,Default,,0000,0000,0000,,Ей, бұл сиыр.
Dialogue: 0,0:17:04.62,0:17:09.32,Default,,0000,0000,0000,,Тацуми~.
Dialogue: 0,0:17:12.63,0:17:17.30,Default,,0000,0000,0000,,Ей, бұл сиыр.
Dialogue: 0,0:17:12.63,0:17:17.30,Default,,0000,0000,0000,,Тацуми~.
Dialogue: 0,0:17:17.30,0:17:20.80,Default,,0000,0000,0000,,Шамамен
Dialogue: 0,0:17:17.30,0:17:20.80,Default,,0000,0000,0000,,Мен Тацумиден кейін не болатынын түсінбеймін.
Dialogue: 0,0:17:20.80,0:17:23.47,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:17:23.47,0:17:27.77,Default,,0000,0000,0000,,Ей, бұл сиыр.
Dialogue: 0,0:17:23.47,0:17:27.77,Default,,0000,0000,0000,,Тацуми~.
Dialogue: 0,0:17:30.31,0:17:32.31,Default,,0000,0000,0000,,А, есімде.
Dialogue: 0,0:17:32.31,0:17:34.65,Default,,0000,0000,0000,,Биыл бұл айдаһар. Тацу.
Dialogue: 0,0:17:34.65,0:17:37.65,Default,,0000,0000,0000,,Хона ми~я ми~.
Dialogue: 0,0:17:37.65,0:17:40.82,Default,,0000,0000,0000,,Ми~.
Dialogue: 0,0:17:40.82,0:17:44.62,Default,,0000,0000,0000,,Ми~?
Dialogue: 0,0:17:40.82,0:17:44.62,Default,,0000,0000,0000,,Ми~?
Dialogue: 0,0:17:50.33,0:17:53.33,Default,,0000,0000,0000,,Ал, мен саған есеп парағын беремін.
Dialogue: 0,0:17:53.33,0:17:56.34,Default,,0000,0000,0000,,Олай болса, алдымен Чиё Чан.
Dialogue: 0,0:17:53.33,0:17:56.34,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:17:56.34,0:17:59.34,Default,,0000,0000,0000,,Чио-чан қазірдің өзінде сыныбының жоғарғы жағында.
Dialogue: 0,0:17:59.34,0:18:01.28,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:17:59.34,0:18:01.28,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:18:01.28,0:18:05.28,Default,,0000,0000,0000,,Уау, мен қоғамға шыққанда да осындай оқу.
Dialogue: 0,0:18:01.28,0:18:05.28,Default,,0000,0000,0000,,Бұл көп көмектеспейді.
Dialogue: 0,0:18:07.28,0:18:10.28,Default,,0000,0000,0000,,Келесі Томо-чан.
Dialogue: 0,0:18:07.28,0:18:10.28,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:10.28,0:18:12.79,Default,,0000,0000,0000,,Кішкене тырысу керек.
Dialogue: 0,0:18:10.28,0:18:12.79,Default,,0000,0000,0000,,Е.
Dialogue: 0,0:18:12.79,0:18:15.96,Default,,0000,0000,0000,,Бірақ қоғамға шықсаңыз да
Dialogue: 0,0:18:12.79,0:18:15.96,Default,,0000,0000,0000,,Бұл пайдасыз, солай ма?
Dialogue: 0,0:18:15.96,0:18:19.29,Default,,0000,0000,0000,,Ақымақ! Болды
Dialogue: 0,0:18:15.96,0:18:19.29,Default,,0000,0000,0000,,Мұның бәрі оқуға байланысты!
Dialogue: 0,0:18:19.29,0:18:22.30,Default,,0000,0000,0000,,Күнделікті өмірге пайдалы даналық
Dialogue: 0,0:18:19.29,0:18:22.30,Default,,0000,0000,0000,,Қаласаңыз➡
Dialogue: 0,0:18:22.30,0:18:24.50,Default,,0000,0000,0000,,Тіпті әженің даналық дорбасымен
Dialogue: 0,0:18:22.30,0:18:24.50,Default,,0000,0000,0000,,Оқыңыз.
Dialogue: 0,0:18:29.47,0:18:31.81,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:18:31.81,0:18:33.97,Default,,0000,0000,0000,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:18:33.97,0:18:37.98,Default,,0000,0000,0000,,Жарайды~ Рождество мерекесімен!
Dialogue: 0,0:18:33.97,0:18:37.98,Default,,0000,0000,0000,,Бүгін ойнайық!
Dialogue: 0,0:18:37.98,0:18:40.15,Default,,0000,0000,0000,,Бүгінгі мәзір!
Dialogue: 0,0:18:40.15,0:18:42.48,Default,,0000,0000,0000,,Бюстгалтерге барып, караокеге бардым➡
Dialogue: 0,0:18:42.48,0:18:45.99,Default,,0000,0000,0000,,Чиёчанчиде торт жеу
Dialogue: 0,0:18:42.48,0:18:45.99,Default,,0000,0000,0000,,Бұл күні ұйықтау кеші!
Dialogue: 0,0:18:45.99,0:18:48.09,Default,,0000,0000,0000,,Олай болса, кеттік!
Dialogue: 0,0:18:51.99,0:18:56.16,Default,,0000,0000,0000,,Жыл сайын Рождествода
Dialogue: 0,0:18:51.99,0:18:56.16,Default,,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:18:56.16,0:18:58.17,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:18:58.17,0:19:01.60,Default,,0000,0000,0000,,Қызыл мұрын бұғы бар.
Dialogue: 0,0:19:01.60,0:19:05.11,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:19:01.60,0:19:05.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:05.11,0:19:09.28,Default,,0000,0000,0000,,Қараңғы түнгі көшелерде,
Dialogue: 0,0:19:05.11,0:19:09.28,Default,,0000,0000,0000,,Жылтыр мұрын пайдалы...
Dialogue: 0,0:19:09.28,0:19:11.61,Default,,0000,0000,0000,,Мен мұны орындаймын.
Dialogue: 0,0:19:11.61,0:19:16.45,Default,,0000,0000,0000,,Таз адамға
Dialogue: 0,0:19:11.61,0:19:16.45,Default,,0000,0000,0000,,Түнде жолда көмекке келгенімде таяқ жедім.
Dialogue: 0,0:19:16.45,0:19:20.55,Default,,0000,0000,0000,,Аяз ата да қорқынышты нәрселерді айтады.
Dialogue: 0,0:19:16.45,0:19:20.55,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:19:24.46,0:19:28.30,Default,,0000,0000,0000,,Бірақ бұғы да бұғы.
Dialogue: 0,0:19:24.46,0:19:28.30,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:19:28.30,0:19:31.63,Default,,0000,0000,0000,,Түнде жолды жарықтандыратын қандай мұрын?
Dialogue: 0,0:19:31.63,0:19:33.63,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:19:33.63,0:19:37.64,Default,,0000,0000,0000,,Мүмкін бұл бұғы шығар!
Dialogue: 0,0:19:37.64,0:19:41.64,Default,,0000,0000,0000,,Бұл басқа нәрсе болуы керек...
Dialogue: 0,0:19:37.64,0:19:41.64,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:19:41.64,0:19:47.15,Default,,0000,0000,0000,,♬ «Міне, уақыт тротуары»
Dialogue: 0,0:19:47.15,0:19:49.85,Default,,0000,0000,0000,,Профессор Такаянаги
Dialogue: 0,0:19:54.32,0:19:56.99,Default,,0000,0000,0000,,65 ұпай.
Dialogue: 0,0:19:56.99,0:19:58.99,Default,,0000,0000,0000,,Менің ойымша, бұл өте жақсы болды.
Dialogue: 0,0:19:58.99,0:20:00.99,Default,,0000,0000,0000,,Бұл сынақ ұпайынан жақсырақ балл.
Dialogue: 0,0:20:00.99,0:20:04.67,Default,,0000,0000,0000,,А, түсіндім.
Dialogue: 0,0:20:00.99,0:20:04.67,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:04.67,0:20:12.01,Default,,0000,0000,0000,,♬ «Мен жалғызбын.
Dialogue: 0,0:20:04.67,0:20:12.01,Default,,0000,0000,0000,,Тоқтаймыз ба?»
Dialogue: 0,0:20:12.01,0:20:19.35,Default,,0000,0000,0000,,♬ «Менің жүрегім – қыз және парашют»
Dialogue: 0,0:20:19.35,0:20:24.85,Default,,0000,0000,0000,,♬ «Мен оны саябақта күтіп отырып байқадым.»
Dialogue: 0,0:20:24.85,0:20:30.36,Default,,0000,0000,0000,,♬ «Үйге қайтар жолдағы айналма жол».
Dialogue: 0,0:20:30.36,0:20:34.86,Default,,0000,0000,0000,,♬ «Мен барлығымен бірге болғым келеді».
Dialogue: 0,0:20:36.86,0:20:40.53,Default,,0000,0000,0000,,Профессор Такаянаги
Dialogue: 0,0:20:40.53,0:20:42.54,Default,,0000,0000,0000,,Сакаки мырза керемет.
Dialogue: 0,0:20:42.54,0:20:46.64,Default,,0000,0000,0000,,Сіз шынымен жақсысыз.
Dialogue: 0,0:20:42.54,0:20:46.64,Default,,0000,0000,0000,,Хонма, мен таң қалдым.
Dialogue: 0,0:20:48.71,0:20:51.55,Default,,0000,0000,0000,,Менің де уақытым келді.
Dialogue: 0,0:20:48.71,0:20:51.55,Default,,0000,0000,0000,,О, жасайық!
Dialogue: 0,0:20:51.55,0:21:00.99,Default,,0000,0000,0000,,♬
Dialogue: 0,0:21:00.99,0:21:06.83,Default,,0000,0000,0000,,♬ «Пён Пён Пён
Dialogue: 0,0:21:00.99,0:21:06.83,Default,,0000,0000,0000,,Сәлемдесіп секіру».
Dialogue: 0,0:21:06.83,0:21:13.17,Default,,0000,0000,0000,,♬ «Динг-донг дин-донг, қоңырау соғылады.
Dialogue: 0,0:21:06.83,0:21:13.17,Default,,0000,0000,0000,,Анау төбе, мына төбе».
Dialogue: 0,0:21:13.17,0:21:16.00,Default,,0000,0000,0000,,А, мен ән айттым. мен ән айттым.
Dialogue: 0,0:21:16.00,0:21:19.51,Default,,0000,0000,0000,,Шикаши Коёмидің ән салған дауысы керемет болды.
Dialogue: 0,0:21:19.51,0:21:21.51,Default,,0000,0000,0000,,Мен тағы да таң қалдым.
Dialogue: 0,0:21:21.51,0:21:26.51,Default,,0000,0000,0000,,Бұл жігіт сабақты жақсы оқиды, спортпен айналысады, бірақ ән айтуда нашар.
Dialogue: 0,0:21:26.51,0:21:29.68,Default,,0000,0000,0000,,Көрдің бе, ән айту жүрек туралы.
Dialogue: 0,0:21:29.68,0:21:31.69,Default,,0000,0000,0000,,Жүрек.
Dialogue: 0,0:21:31.69,0:21:33.69,Default,,0000,0000,0000,,Уа.
Dialogue: 0,0:21:31.69,0:21:33.69,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:21:37.86,0:21:39.86,Default,,0000,0000,0000,,Қар жауды.
Dialogue: 0,0:21:39.86,0:21:43.36,Default,,0000,0000,0000,,Рождествода қар жауады ма?
Dialogue: 0,0:21:39.86,0:21:43.36,Default,,0000,0000,0000,,Бұл романтикалық, солай емес пе?
Dialogue: 0,0:21:45.53,0:21:47.53,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:21:45.53,0:21:47.53,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:47.53,0:21:50.70,Default,,0000,0000,0000,,Ақ Рождество... солай ма?
Dialogue: 0,0:21:50.70,0:21:54.70,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:21:56.20,0:22:02.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory