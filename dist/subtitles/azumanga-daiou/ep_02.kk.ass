Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.83,0:00:07.30,Default,,0,0,0,,Лу Ла Лу Ла Пианино - әлемдік
Dialogue: 0,0:00:07.33,0:00:10.81,Default,,0,0,0,,Арман гүлдеген далада әуен
Dialogue: 0,0:00:10.84,0:00:14.27,Default,,0,0,0,,Сынған сағатқа сену
Dialogue: 0,0:00:14.30,0:00:17.73,Default,,0,0,0,,Уақыт сенің жаныңда кім?
Dialogue: 0,0:00:17.76,0:00:21.10,Default,,0,0,0,,Менің кеудем неге үлкен?
Dialogue: 0,0:00:21.31,0:00:24.72,Default,,0,0,0,,Сіз мейірімді адамды күтесіз бе?
Dialogue: 0,0:00:24.80,0:00:28.29,Default,,0,0,0,,Маған тамаша болашағыңыз туралы айтып беріңіз
Dialogue: 0,0:00:28.32,0:00:28.99,Default,,0,0,0,,Ай
Dialogue: 0,0:00:29.08,0:00:29.84,Default,,0,0,0,,Жарық
Dialogue: 0,0:00:29.96,0:00:31.70,Default,,0,0,0,,Ай сәулесі ұйықтап жатыр
Dialogue: 0,0:00:31.73,0:00:35.27,Default,,0,0,0,,Лу Ла Лу Ла Есте сақтау алмасына
Dialogue: 0,0:00:35.30,0:00:38.64,Default,,0,0,0,,Оянған қыз мені сүйеді
Dialogue: 0,0:00:38.68,0:00:42.19,Default,,0,0,0,,Азаппен жайылған кітапта
Dialogue: 0,0:00:42.22,0:00:45.46,Default,,0,0,0,,Екі қоңырау соғылады
Dialogue: 0,0:00:45.61,0:00:48.90,Default,,0,0,0,,Мен жақсы көретін адам, өйткені мен оны құшақтағым келеді
Dialogue: 0,0:00:49.14,0:00:52.67,Default,,0,0,0,,Енді жылама Қош бол қайғы
Dialogue: 0,0:00:52.69,0:00:56.17,Default,,0,0,0,,Жұмбақ есіктегі жазу
Dialogue: 0,0:00:56.20,0:00:59.61,Default,,0,0,0,,«Сорамими торты»
Dialogue: 0,0:00:59.63,0:01:00.94,Default,,0,0,0,,Ғажайыптар әлемі!
Dialogue: 0,0:01:00.97,0:01:02.69,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:02.72,0:01:04.01,Default,,0,0,0,,Ертегілер елі!
Dialogue: 0,0:01:04.04,0:01:05.68,Default,,0,0,0,,Бұл махаббаттың сиқыры
Dialogue: 0,0:01:05.71,0:01:07.02,Default,,0,0,0,,Махаббат бәрібір!
Dialogue: 0,0:01:07.05,0:01:08.80,Default,,0,0,0,,Күн сайын үлпілдек
Dialogue: 0,0:01:08.83,0:01:12.29,Default,,0,0,0,,Бидайдың азғыруы
Dialogue: 0,0:01:12.32,0:01:13.59,Default,,0,0,0,,Сізге арналған торт!
Dialogue: 0,0:01:13.62,0:01:15.32,Default,,0,0,0,,Бүгін кешке тамақтаныңыз.
Dialogue: 0,0:01:15.34,0:01:16.66,Default,,0,0,0,,Сізге шай!
Dialogue: 0,0:01:16.69,0:01:18.38,Default,,0,0,0,,Шоқжұлдыз шай ішу
Dialogue: 0,0:01:18.40,0:01:19.69,Default,,0,0,0,,Терезеде
Dialogue: 0,0:01:19.72,0:01:21.46,Default,,0,0,0,,Періштелер хоры
Dialogue: 0,0:01:21.49,0:01:24.87,Default,,0,0,0,,Құлағыңыз бос па?
Dialogue: 0,0:01:24.90,0:01:28.46,Default,,0,0,0,,Мен сені сүйемін, мен сені сүйемін дауыс
Dialogue: 0,0:01:41.97,0:01:44.15,Default,,0,0,0,,I Аюму Касуга
Dialogue: 0,0:01:44.53,0:01:47.56,Default,,0,0,0,,Жақында мен Осакадан ауыстым.
Dialogue: 0,0:01:49.90,0:01:51.33,Default,,0,0,0,,Токиодағы адамдар
Dialogue: 0,0:01:51.35,0:01:54.31,Default,,0,0,0,,Қызыл шамда дұрыс тоқтаңыз
Dialogue: 0,0:01:56.91,0:01:58.40,Default,,0,0,0,,Осакадағы адамдар
Dialogue: 0,0:01:58.42,0:02:01.78,Default,,0,0,0,,Қиын, өйткені сіз кесіп өте бересіз.
Dialogue: 0,0:02:06.83,0:02:09.04,Default,,0,0,0,,А, мен де өткім келмейді...
Dialogue: 0,0:02:14.70,0:02:16.87,Default,,0,0,0,,Қарғыс атсын, мен өзгердім.
Dialogue: 0,0:02:20.54,0:02:21.45,Default,,0,0,0,,Мектеп
Dialogue: 0,0:02:21.47,0:02:25.01,Default,,0,0,0,,Токио мен Осака арасында көп айырмашылық жоқ.
Dialogue: 0,0:02:26.39,0:02:26.99,Default,,0,0,0,,О
Dialogue: 0,0:02:28.10,0:02:29.41,Default,,0,0,0,,Уа!
Dialogue: 0,0:02:30.89,0:02:31.71,Default,,0,0,0,,Ум...
Dialogue: 0,0:02:31.74,0:02:34.18,Default,,0,0,0,,Бұл кішкентай бала қандай?
Dialogue: 0,0:02:34.82,0:02:36.60,Default,,0,0,0,,О, бұл Чиё Чан.
Dialogue: 0,0:02:36.89,0:02:38.04,Default,,0,0,0,,Данышпан қыз
Dialogue: 0,0:02:38.64,0:02:39.98,Default,,0,0,0,,Данышпан қыз?
Dialogue: 0,0:02:40.39,0:02:44.17,Default,,0,0,0,,Мен 10 жастамын, бірақ мен данышпанмын, сондықтан мен орта мектепте оқимын.
Dialogue: 0,0:02:44.56,0:02:45.63,Default,,0,0,0,,… өтіңіз.
Dialogue: 0,0:02:46.24,0:02:46.73,Default,,0,0,0,,Ах
Dialogue: 0,0:02:46.75,0:02:47.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:47.21,0:02:47.73,Default,,0,0,0,,Соя
Dialogue: 0,0:02:48.15,0:02:49.29,Default,,0,0,0,,Сондай-ақ менің көршімде
Dialogue: 0,0:02:49.32,0:02:52.59,Default,,0,0,0,,Шота-күн деген жас бала болыпты.
Dialogue: 0,0:02:53.03,0:02:54.92,Default,,0,0,0,,Оның тамаша нұсқасы.
Dialogue: 0,0:02:55.49,0:02:58.18,Default,,0,0,0,,Менің ойымша, бұл сәл басқаша ...
Dialogue: 0,0:03:02.91,0:03:05.48,Default,,0,0,0,,Мен Осакада болғанда
Dialogue: 0,0:03:05.51,0:03:08.86,Default,,0,0,0,,Ол жалқау, есінен танып қалған екен.
Dialogue: 0,0:03:12.32,0:03:14.71,Default,,0,0,0,,Мен өзім олай ойламаймын.
Dialogue: 0,0:03:14.75,0:03:18.36,Default,,0,0,0,,Сіз соншалықты аңқаусыз ба деп ойлаймын.
Dialogue: 0,0:03:32.15,0:03:34.13,Default,,0,0,0,,Мен суланып кеттім
Dialogue: 0,0:04:01.17,0:04:03.19,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:04:03.45,0:04:06.56,Default,,0,0,0,,Сіз кейде көзіңізде кірді көресіз бе?
Dialogue: 0,0:04:07.23,0:04:09.51,Default,,0,0,0,,Мен оны қазір бақылап жатырмын.
Dialogue: 0,0:04:10.43,0:04:12.51,Default,,0,0,0,,Иә? Сәттілік...
Dialogue: 0,0:04:12.85,0:04:13.41,Default,,0,0,0,,Иә
Dialogue: 0,0:04:13.88,0:04:14.80,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:04:16.31,0:04:18.26,Default,,0,0,0,,Міне...
Dialogue: 0,0:04:18.29,0:04:19.01,Default,,0,0,0,,(біреудің айқайы)
Dialogue: 0,0:04:19.73,0:04:21.79,Default,,0,0,0,,Уау, бұл тарақан!
Dialogue: 0,0:04:21.82,0:04:23.13,Default,,0,0,0,,Мен сонда бардым!
Dialogue: 0,0:04:23.15,0:04:25.07,Default,,0,0,0,,Жоқ, мен тарақандарды жек көремін!
Dialogue: 0,0:04:28.33,0:04:29.11,Default,,0,0,0,,Ей!
Dialogue: 0,0:04:29.19,0:04:30.72,Default,,0,0,0,,Біреу мені ұстап алсын!
Dialogue: 0,0:04:31.11,0:04:33.71,Default,,0,0,0,,Жарайсыңдар! Маған қалдырыңыз!
Dialogue: 0,0:04:41.23,0:04:44.14,Default,,0,0,0,,Қарғыс атсын саған жылдам жүгіруші!
Dialogue: 0,0:04:44.23,0:04:46.10,Default,,0,0,0,,Сіз қайда көздеп отырсыз?
Dialogue: 0,0:04:46.18,0:04:47.99,Default,,0,0,0,,Сіз мұны әдейі істеп жатырсыз ба?
Dialogue: 0,0:04:49.83,0:04:51.23,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:04:53.03,0:04:54.99,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:59.77,0:05:01.20,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:05:03.80,0:05:08.01,Default,,0,0,0,,Дұрыс. Бұл кімнің айқайы бірінші болды?
Dialogue: 0,0:05:08.11,0:05:09.01,Default,,0,0,0,,Saa
Dialogue: 0,0:05:09.58,0:05:10.58,Default,,0,0,0,,Бұрын менің жинақтағы ақшам 20 000 йен болатын! Ах, ах…
Dialogue: 0,0:05:12.72,0:05:13.85,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:05:14.16,0:05:16.45,Default,,0,0,0,,Жақында сабақтар жалғасады!
Dialogue: 0,0:05:16.78,0:05:17.84,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:05:19.70,0:05:21.36,Default,,0,0,0,,Не? не болды?
Dialogue: 0,0:05:21.85,0:05:25.29,Default,,0,0,0,,Бұрынғы тарақан мен оны оқулығыммен басып тастадым...
Dialogue: 0,0:05:26.05,0:05:27.64,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:05:29.09,0:05:30.88,Default,,0,0,0,,Келме! Жақын келме!
Dialogue: 0,0:05:31.19,0:05:32.84,Default,,0,0,0,,Ой, өзімді ұстап қалдым ба?
Dialogue: 0,0:05:36.60,0:05:37.80,Default,,0,0,0,,Осака қаласында
Dialogue: 0,0:05:37.82,0:05:41.18,Default,,0,0,0,,Үнемі жүгіруге келгенде мен сыныптағы ең баяу болдым.
Dialogue: 0,0:05:43.06,0:05:43.84,Default,,0,0,0,,Сейаға
Dialogue: 0,0:05:43.86,0:05:46.32,Default,,0,0,0,,Бұл сыныпта бастауыш сынып оқушылары бар.
Dialogue: 0,0:05:47.93,0:05:49.52,Default,,0,0,0,,Олай болса кеттік!
Dialogue: 0,0:05:49.90,0:05:51.40,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:05:51.42,0:05:52.44,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:52.46,0:05:53.49,Default,,0,0,0,,Дон!
Dialogue: 0,0:05:55.82,0:05:58.29,Default,,0,0,0,,Жоғалта алмаймын!
Dialogue: 0,0:06:00.19,0:06:01.49,Default,,0,0,0,,Чио-чан
Dialogue: 0,0:06:01.87,0:06:03.79,Default,,0,0,0,,Қанша данышпанмын десең де,
Dialogue: 0,0:06:04.57,0:06:06.05,Default,,0,0,0,,Мен жеңілуге шамасы жоқ
Dialogue: 0,0:06:06.55,0:06:08.30,Default,,0,0,0,,Бұған не болды!
Dialogue: 0,0:06:15.75,0:06:16.94,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:06:18.07,0:06:18.90,Default,,0,0,0,,Өйткені
Dialogue: 0,0:06:19.88,0:06:20.74,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:06:21.41,0:06:23.91,Default,,0,0,0,,Мен данышпанмен бәсекелесе алмаймын деп ойлаймын...
Dialogue: 0,0:06:24.75,0:06:27.04,Default,,0,0,0,,Мен Чио-чаннан жүгіру арқылы жеңілдім.
Dialogue: 0,0:06:27.14,0:06:28.67,Default,,0,0,0,,Сен менің біріншісің...
Dialogue: 0,0:06:32.21,0:06:34.83,Default,,0,0,0,,Бүгінгі дене шынықтыру сыныбы волейбол ойнайды.
Dialogue: 0,0:06:35.26,0:06:36.98,Default,,0,0,0,,Бір уақытта 6 адам жинаңыз.
Dialogue: 0,0:06:39.10,0:06:40.10,Default,,0,0,0,,Алты адам?
Dialogue: 0,0:06:42.02,0:06:44.37,Default,,0,0,0,,Мынадай комбинация бола ма? …
Dialogue: 0,0:06:44.51,0:06:47.39,Default,,0,0,0,,Жарайды, біз 10 миллион жүлдені мақсат етіп отырмыз!
Dialogue: 0,0:06:47.60,0:06:49.57,Default,,0,0,0,,Күте тұрыңыз, Уимблдон!
Dialogue: 0,0:06:50.99,0:06:53.35,Default,,0,0,0,,ПЭ уақытында мұндай нәрсе бар ма?
Dialogue: 0,0:06:53.77,0:06:54.78,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:06:59.69,0:07:00.93,Default,,0,0,0,,Керемет Чиё Чан!
Dialogue: 0,0:07:01.47,0:07:02.22,Default,,0,0,0,,Онда!
Dialogue: 0,0:07:08.40,0:07:10.36,Default,,0,0,0,,Сакаки мырза керемет!
Dialogue: 0,0:07:12.88,0:07:15.31,Default,,0,0,0,,Сакаки-сан өте керемет!
Dialogue: 0,0:07:15.77,0:07:18.77,Default,,0,0,0,,Сол кісі Сакаки-сан жасады ма?
Dialogue: 0,0:07:18.82,0:07:20.56,Default,,0,0,0,,Керемет...
Dialogue: 0,0:07:21.34,0:07:22.39,Default,,0,0,0,,солай емес пе?
Dialogue: 0,0:07:22.47,0:07:23.75,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:24.11,0:07:24.53,Default,,0,0,0,,Иә
Dialogue: 0,0:07:25.33,0:07:28.14,Default,,0,0,0,,Жарайды, мен де ол кісіні көздеймін!
Dialogue: 0,0:07:28.37,0:07:28.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:29.03,0:07:31.25,Default,,0,0,0,,Ей, көздеп тұрған сенсің!
Dialogue: 0,0:07:31.42,0:07:35.56,Default,,0,0,0,,Мен де сол керемет қыз болуды мақсат тұтамын!
Dialogue: 0,0:07:35.78,0:07:36.56,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:07:36.83,0:07:38.88,Default,,0,0,0,,Әй, көздеу деген осындай ғой...
Dialogue: 0,0:07:39.24,0:07:41.60,Default,,0,0,0,,бұл... иә...
Dialogue: 0,0:07:43.06,0:07:45.08,Default,,0,0,0,,Бірақ сіз мұны істей алмайсыз.
Dialogue: 0,0:07:46.57,0:07:48.33,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:07:58.34,0:08:00.59,Default,,0,0,0,,Аа, кешіріңіз, кешіріңіз.
Dialogue: 0,0:08:00.74,0:08:03.27,Default,,0,0,0,,Ауыртады Ауыртады
Dialogue: 0,0:08:03.37,0:08:04.57,Default,,0,0,0,,Оны жіберіп алмаңыз! Оны жіберіп алмаңыз!
Dialogue: 0,0:08:04.94,0:08:06.10,Default,,0,0,0,,Сіз айтасыз!
Dialogue: 0,0:08:09.94,0:08:13.06,Default,,0,0,0,,Кенеттен сәйкестік қауіпті сияқты.
Dialogue: 0,0:08:13.42,0:08:16.30,Default,,0,0,0,,Жұппен лақтыруға жаттықтыру.
Dialogue: 0,0:08:16.72,0:08:19.33,Default,,0,0,0,,Чио-чан, бірге істейміз бе?
Dialogue: 0,0:08:19.46,0:08:20.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:20.84,0:08:22.45,Default,,0,0,0,,Чио-чан, кеттік!
Dialogue: 0,0:08:22.56,0:08:23.40,Default,,0,0,0,,Уа!
Dialogue: 0,0:08:23.53,0:08:25.51,Default,,0,0,0,,Кез келген уақыт жақсы!
Dialogue: 0,0:08:25.78,0:08:27.32,Default,,0,0,0,,Хонай Куде!
Dialogue: 0,0:08:27.61,0:08:28.93,Default,,0,0,0,,Міне!
Dialogue: 0,0:08:33.27,0:08:35.62,Default,,0,0,0,,Чио-чан, уайымдама!
Dialogue: 0,0:08:35.80,0:08:36.99,Default,,0,0,0,,Иә
Dialogue: 0,0:08:38.30,0:08:40.64,Default,,0,0,0,,Осака мырза, кеттік!
Dialogue: 0,0:08:41.38,0:08:42.28,Default,,0,0,0,,Міне!
Dialogue: 0,0:08:47.85,0:08:50.60,Default,,0,0,0,,Осака мырза! Сенімен бәрі жақсы ма?
Dialogue: 0,0:08:50.76,0:08:52.09,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:08:52.93,0:08:54.55,Default,,0,0,0,,Мен де бір рет барамын!
Dialogue: 0,0:08:55.14,0:08:56.18,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:00.93,0:09:03.34,Default,,0,0,0,,Чио-чан, бірдеңе дұрыс емес пе?
Dialogue: 0,0:09:03.41,0:09:04.32,Default,,0,0,0,,Иә
Dialogue: 0,0:09:05.45,0:09:07.24,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:09:07.54,0:09:08.61,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:14.60,0:09:17.07,Default,,0,0,0,,Кешіріңіз Осака-сан!
Dialogue: 0,0:09:17.35,0:09:18.47,Default,,0,0,0,,О!
Dialogue: 0,0:09:19.54,0:09:20.48,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:09:20.80,0:09:21.81,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:09:27.39,0:09:28.69,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:09:29.13,0:09:29.96,Default,,0,0,0,,Бұл~
Dialogue: 0,0:09:33.91,0:09:35.17,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:09:35.30,0:09:36.11,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:09:36.84,0:09:38.35,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:09:49.14,0:09:52.03,Default,,0,0,0,,Амансың ба? Бұл қауіпті
Dialogue: 0,0:09:52.24,0:09:53.10,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:09:53.13,0:09:54.11,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:09:55.15,0:09:57.83,Default,,0,0,0,,Фу~ Мен оны тірі қалдырдым.
Dialogue: 0,0:09:58.09,0:09:59.32,Default,,0,0,0,,Қайдан оралдыңыз?
Dialogue: 0,0:10:00.12,0:10:02.41,Default,,0,0,0,,Жарайды, тамақ ішейік.
Dialogue: 0,0:10:02.99,0:10:03.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:04.28,0:10:07.47,Default,,0,0,0,,О! Қуырылған тауық еті, қуырылған жұмыртқа және котлеттер
Dialogue: 0,0:10:07.50,0:10:08.29,Default,,0,0,0,,Неге олай? Өте суықсың ғой.
Dialogue: 0,0:10:08.32,0:10:10.76,Default,,0,0,0,,Томо-чанның барлық сүйікті тағамдары!
Dialogue: 0,0:10:10.82,0:10:13.37,Default,,0,0,0,,Олай болса, алайық!
Dialogue: 0,0:10:14.54,0:10:17.04,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:10:17.18,0:10:18.88,Default,,0,0,0,,Енді менімен сөйлеспе.
Dialogue: 0,0:10:27.42,0:10:28.32,Default,,0,0,0,,Не!
Dialogue: 0,0:10:28.48,0:10:29.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:30.80,0:10:31.77,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:32.18,0:10:33.47,Default,,0,0,0,,Томо-чан Томо-чан
Dialogue: 0,0:10:33.56,0:10:34.06,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:10:35.88,0:10:38.74,Default,,0,0,0,,Оның таза сынғанына ризасың ба?
Dialogue: 0,0:10:39.87,0:10:40.59,Default,,0,0,0,,Күнтізбе
Dialogue: 0,0:10:40.62,0:10:41.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:41.95,0:10:44.75,Default,,0,0,0,,Бұл не крокет? Іші ашық қызыл
Dialogue: 0,0:10:45.27,0:10:46.40,Default,,0,0,0,,О, бұл
Dialogue: 0,0:10:47.13,0:10:49.03,Default,,0,0,0,,Ащы чили бұрышынан жасалған крокет
Dialogue: 0,0:10:49.60,0:10:51.92,Default,,0,0,0,,Коёми ащы тағамды жақсы көреді.
Dialogue: 0,0:10:52.21,0:10:53.74,Default,,0,0,0,,Ауырсынатын көрінеді.
Dialogue: 0,0:10:54.07,0:10:55.79,Default,,0,0,0,,Осака ащы тағамды ұната ма?
Dialogue: 0,0:10:56.20,0:10:58.50,Default,,0,0,0,,Мен мүлдем ащы емеспін
Dialogue: 0,0:10:59.26,0:11:00.04,Default,,0,0,0,,Хэхе (lol)
Dialogue: 0,0:11:00.35,0:11:02.81,Default,,0,0,0,,Эй, осының біразын алғың келе ме?
Dialogue: 0,0:11:03.08,0:11:05.97,Default,,0,0,0,,Ащы болса жарайды дейді.
Dialogue: 0,0:11:06.20,0:11:08.68,Default,,0,0,0,,Басқалардың айтқанын тыңдама
Dialogue: 0,0:11:08.86,0:11:12.38,Default,,0,0,0,,Жарайды, өйткені онда да сұңқар тырнақтары көп.
Dialogue: 0,0:11:12.89,0:11:14.12,Default,,0,0,0,,Таканоцуме?
Dialogue: 0,0:11:14.52,0:11:15.96,Default,,0,0,0,,Олай десеңіз.
Dialogue: 0,0:11:15.98,0:11:19.07,Default,,0,0,0,,Бұл акула жүзбегі немесе қарлығаш ұясы сияқты ма?
Dialogue: 0,0:11:19.53,0:11:20.29,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:20.74,0:11:22.57,Default,,0,0,0,,Енді сәл ғана
Dialogue: 0,0:11:22.72,0:11:23.40,Default,,0,0,0,,Бұл!
Dialogue: 0,0:11:32.05,0:11:34.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:36.27,0:11:38.18,Default,,0,0,0,,Бұл өте қорқынышты...
Dialogue: 0,0:11:38.33,0:11:39.65,Default,,0,0,0,,Мен өлемін деп ойладым.
Dialogue: 0,0:11:39.80,0:11:40.98,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:11:43.20,0:11:43.74,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:11:45.21,0:11:45.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:46.08,0:11:46.53,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:11:48.35,0:11:48.63,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:11:49.12,0:11:50.26,Default,,0,0,0,,Не?
Dialogue: 0,0:11:50.46,0:11:51.86,Default,,0,0,0,,Бұл жолы ықырық болады ма?
Dialogue: 0,0:11:52.17,0:11:52.62,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:11:53.06,0:11:56.51,Default,,0,0,0,,А, мен ащы бірдеңе жегендіктен болар!
Dialogue: 0,0:11:56.73,0:11:57.88,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:57.96,0:11:58.32,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:11:59.38,0:12:00.29,Default,,0,0,0,,Ана
Dialogue: 0,0:12:00.56,0:12:01.07,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:12:03.07,0:12:03.59,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:12:04.54,0:12:05.21,Default,,0,0,0,,Эй
Dialogue: 0,0:12:05.30,0:12:05.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:06.07,0:12:07.91,Default,,0,0,0,,Ауыз су емдемейді ме?
Dialogue: 0,0:12:08.15,0:12:08.93,Default,,0,0,0,,Су?
Dialogue: 0,0:12:12.70,0:12:14.59,Default,,0,0,0,,Мүмкін шырын...
Dialogue: 0,0:12:14.79,0:12:16.07,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:12:16.16,0:12:18.97,Default,,0,0,0,,Ах, менің ойымша, газдалған нәрсе пайдалы болар еді.
Dialogue: 0,0:12:19.51,0:12:22.61,Default,,0,0,0,,Маған көмір қышқылы ұнамайды.
Dialogue: 0,0:12:22.91,0:12:23.71,Default,,0,0,0,,Асо
Dialogue: 0,0:12:27.07,0:12:27.50,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:12:30.09,0:12:30.73,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:12:35.95,0:12:36.44,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:12:37.33,0:12:39.03,Default,,0,0,0,,Бұл қыңыр ықылық.
Dialogue: 0,0:12:39.24,0:12:42.02,Default,,0,0,0,,Ішіп отырып мұрынды ұстау жақсы деп естідім.
Dialogue: 0,0:12:42.45,0:12:45.53,Default,,0,0,0,,Құлағын жауып ішкен жақсы деп естідім.
Dialogue: 0,0:12:45.83,0:12:46.21,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:12:46.82,0:12:48.77,Default,,0,0,0,,Жақсы! Екеуін де байқап көрейік!
Dialogue: 0,0:12:49.00,0:12:49.66,Default,,0,0,0,,өтіңіз бе?
Dialogue: 0,0:12:56.23,0:12:57.45,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:12:57.63,0:12:58.43,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:01.01,0:13:02.20,Default,,0,0,0,,Бұл! жалғастыра бер!
Dialogue: 0,0:13:04.43,0:13:05.82,Default,,0,0,0,,Сіз қалай ойлайсыз? Емделді ме?
Dialogue: 0,0:13:06.50,0:13:08.52,Default,,0,0,0,,Хмм...не істеуіміз керек?
Dialogue: 0,0:13:11.83,0:13:12.33,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:13:13.81,0:13:14.90,Default,,0,0,0,,Ол емделмейді.
Dialogue: 0,0:13:15.78,0:13:16.94,Default,,0,0,0,,Ах! Бұл дұрыс!
Dialogue: 0,0:13:19.13,0:13:20.10,Default,,0,0,0,,Таяқшаларда
Dialogue: 0,0:13:20.12,0:13:22.85,Default,,0,0,0,,Үстіне кесе қойып ішкен жақсы сияқты.
Dialogue: 0,0:13:23.08,0:13:24.19,Default,,0,0,0,,Шынымен солай ма?
Dialogue: 0,0:13:33.17,0:13:35.63,Default,,0,0,0,,Келесі кезекте музыка. Тез барайық.
Dialogue: 0,0:13:35.65,0:13:36.35,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:13:36.65,0:13:38.26,Default,,0,0,0,,О, мм...
Dialogue: 0,0:13:43.40,0:13:43.88,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:14:03.23,0:14:04.82,Default,,0,0,0,,Осака Урусее!
Dialogue: 0,0:14:05.11,0:14:05.61,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:14:06.41,0:14:07.04,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:14:07.98,0:14:08.43,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:14:09.31,0:14:10.43,Default,,0,0,0,,Үйге қайтайық!
Dialogue: 0,0:14:10.46,0:14:10.81,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:14:11.43,0:14:13.47,Default,,0,0,0,,Иә? Әлі емделмеген бе?
Dialogue: 0,0:14:13.58,0:14:13.90,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:14:14.85,0:14:17.45,Default,,0,0,0,,Бұл екі сағаттан астам уақыт болды.
Dialogue: 0,0:14:18.04,0:14:19.33,Default,,0,0,0,,Қазір ойлап қарасам, менде ықыласы бар.
Dialogue: 0,0:14:19.35,0:14:22.04,Default,,0,0,0,,Бір күн жалғаса берсе, өлесің... деп естідім.
Dialogue: 0,0:14:22.46,0:14:23.44,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:14:23.50,0:14:25.55,Default,,0,0,0,,Таң қалыңыз, Осака-сан!
Dialogue: 0,0:14:25.58,0:14:26.96,Default,,0,0,0,,Таң қалыңыз!
Dialogue: 0,0:14:27.11,0:14:28.58,Default,,0,0,0,,Ой! шеңбер! Апыр-ай!
Dialogue: 0,0:14:28.76,0:14:31.94,Default,,0,0,0,,Жоқ, бұл мені мүлдем таң қалдырмайды.
Dialogue: 0,0:14:33.10,0:14:33.49,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:14:34.45,0:14:36.04,Default,,0,0,0,,Иә! есіме түсті!
Dialogue: 0,0:14:36.09,0:14:36.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:40.26,0:14:43.82,Default,,0,0,0,,Осылай арқасынан қаққан қандай жақсы!
Dialogue: 0,0:14:43.93,0:14:44.61,Default,,0,0,0,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,0:14:45.31,0:14:48.64,Default,,0,0,0,,Сол кезде тамағыңа бірдеңе тығылып қалады...
Dialogue: 0,0:14:48.69,0:14:49.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.69,0:14:52.01,Default,,0,0,0,,Wariiwarii
Dialogue: 0,0:14:52.16,0:14:53.67,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:54.21,0:14:55.69,Default,,0,0,0,,Мен бұл ықылық екеніне сенімдімін
Dialogue: 0,0:14:55.72,0:14:57.73,Default,,0,0,0,,Бір нәрсе дірілдеп тұрған болуы керек.
Dialogue: 0,0:14:58.23,0:15:00.16,Default,,0,0,0,,Иә! Бұл диафрагма
Dialogue: 0,0:15:00.56,0:15:01.96,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:15:02.21,0:15:03.74,Default,,0,0,0,,Өкпенің төменгі бөлігінде.
Dialogue: 0,0:15:03.85,0:15:05.99,Default,,0,0,0,,Осылай?!
Dialogue: 0,0:15:08.04,0:15:10.48,Default,,0,0,0,,Бұл Хатоо!
Dialogue: 0,0:15:11.00,0:15:12.80,Default,,0,0,0,,Бұл адам денесінің маңызды нүктесі.
Dialogue: 0,0:15:13.05,0:15:13.65,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:15:15.52,0:15:16.40,Default,,0,0,0,,Сіз емделдіңіз бе?
Dialogue: 0,0:15:20.33,0:15:20.69,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:15:21.49,0:15:22.67,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:15:22.88,0:15:23.23,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:15:24.11,0:15:25.32,Default,,0,0,0,,Ықылық
Dialogue: 0,0:15:25.34,0:15:27.62,Default,,0,0,0,,Құрманың сабағын қайнатып ішсең, жазыласың.
Dialogue: 0,0:15:28.18,0:15:28.84,Default,,0,0,0,,Құрма?
Dialogue: 0,0:15:29.40,0:15:31.14,Default,,0,0,0,,Сіз Шибуды қалай емдеу керектігін білесіз.
Dialogue: 0,0:15:31.53,0:15:33.80,Default,,0,0,0,,Бірақ мен құрмаға қарсы емеспін.
Dialogue: 0,0:15:33.83,0:15:34.12,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:15:34.82,0:15:36.90,Default,,0,0,0,,Содан кейін деміңізді біраз уақыт ұстаңыз.
Dialogue: 0,0:15:36.94,0:15:37.20,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:15:38.81,0:15:40.69,Default,,0,0,0,,Жарайды, бастайық!
Dialogue: 0,0:15:46.11,0:15:47.62,Default,,0,0,0,,Сіз өте жылдамсыз.
Dialogue: 0,0:15:48.23,0:15:49.80,Default,,0,0,0,,Көз алмасын басу
Dialogue: 0,0:15:50.25,0:15:51.93,Default,,0,0,0,,Ауырады, ауырады, ауырады
Dialogue: 0,0:15:52.03,0:15:52.32,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:15:53.06,0:15:54.09,Default,,0,0,0,,Тілді тарту
Dialogue: 0,0:16:01.15,0:16:01.87,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:16:03.08,0:16:04.54,Default,,0,0,0,,Ол емделмейді.
Dialogue: 0,0:16:04.67,0:16:05.17,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:16:05.59,0:16:07.67,Default,,0,0,0,,Басқа ештеңе жоқ па?
Dialogue: 0,0:16:08.24,0:16:09.04,Default,,0,0,0,,Мм...
Dialogue: 0,0:16:10.51,0:16:11.43,Default,,0,0,0,,Басқаларға жіберу
Dialogue: 0,0:16:12.22,0:16:14.06,Default,,0,0,0,,Бұл кенеттен күдікті болды.
Dialogue: 0,0:16:14.56,0:16:16.08,Default,,0,0,0,,Адамға жұғады
Dialogue: 0,0:16:16.17,0:16:16.55,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:16:18.13,0:16:18.62,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:16:20.17,0:16:20.57,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:16:21.43,0:16:22.80,Default,,0,0,0,,Не қарап тұрсыз?
Dialogue: 0,0:16:22.87,0:16:23.28,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:16:24.28,0:16:26.95,Default,,0,0,0,,Егер ол жақсармаса, сіз ауырып қалуыңыз мүмкін.
Dialogue: 0,0:16:27.79,0:16:29.13,Default,,0,0,0,,Ауруханаға бару керек...
Dialogue: 0,0:16:29.52,0:16:31.67,Default,,0,0,0,,Ауру дегеніміз не? …
Dialogue: 0,0:16:32.13,0:16:32.55,Default,,0,0,0,,《Ықылық дыбысы》
Dialogue: 0,0:16:35.94,0:16:36.70,Default,,0,0,0,,Ми
Dialogue: 0,0:16:36.82,0:16:37.45,Default,,0,0,0,,Ми⁈
Dialogue: 0,0:16:38.08,0:16:38.73,Default,,0,0,0,,Ах
Dialogue: 0,0:16:38.85,0:16:39.75,Default,,0,0,0,,О
Dialogue: 0,0:16:39.96,0:16:41.92,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:42.28,0:16:43.22,Default,,0,0,0,,Эй
Dialogue: 0,0:16:43.46,0:16:46.36,Default,,0,0,0,,Сіздің миыңызда ақау бар сияқты.
Dialogue: 0,0:16:47.16,0:16:48.38,Default,,0,0,0,,Мәселе неде?
Dialogue: 0,0:16:48.67,0:16:50.86,Default,,0,0,0,,Өйткені бұл кейде біртүрлі.
Dialogue: 0,0:16:51.05,0:16:52.55,Default,,0,0,0,,Сізде қандай да бір белгілер бар ма?
Dialogue: 0,0:16:52.73,0:16:54.41,Default,,0,0,0,,Симптомдары?
Dialogue: 0,0:16:54.70,0:16:55.45,Default,,0,0,0,,Эй?
Dialogue: 0,0:16:55.71,0:16:56.45,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:56.77,0:16:59.97,Default,,0,0,0,,Симптом дегеніміз – қандай да бір субъективті белгілердің болмауы...
Dialogue: 0,0:17:00.21,0:17:03.04,Default,,0,0,0,,Бұл не? Мен түсінбеймін
Dialogue: 0,0:17:03.67,0:17:04.63,Default,,0,0,0,,Мм...
Dialogue: 0,0:17:04.88,0:17:07.62,Default,,0,0,0,,Ықылығыңыз тоқтады ма?
Dialogue: 0,0:17:11.44,0:17:12.48,Default,,0,0,0,,Ахонмая
Dialogue: 0,0:17:12.72,0:17:13.81,Default,,0,0,0,,Емдеу
Dialogue: 0,0:17:14.28,0:17:16.01,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:17:16.06,0:17:17.37,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:17.69,0:17:20.18,Default,,0,0,0,,Бірақ ол неге тоқтады? …
Dialogue: 0,0:17:20.33,0:17:21.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:21.41,0:17:22.85,Default,,0,0,0,,Қандай пайда болды?
Dialogue: 0,0:17:24.64,0:17:25.36,Default,,0,0,0,,《Чио-чанның ықыласы》
Dialogue: 0,0:17:26.48,0:17:27.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:27.62,0:17:28.29,Default,,0,0,0,,《Чио-чанның ықыласы》
Dialogue: 0,0:17:29.46,0:17:30.00,Default,,0,0,0,,《Чио-чанның ықырық дыбысы》
Dialogue: 0,0:17:31.04,0:17:31.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:31.65,0:17:33.46,Default,,0,0,0,,Чио-чанға берілді.
Dialogue: 0,0:17:33.83,0:17:35.37,Default,,0,0,0,,Шын мәнінде жұқпалы деген не?
Dialogue: 0,0:17:35.81,0:17:38.91,Default,,0,0,0,,Олай болса, Осакада басынан бастап сынап көрейік!
Dialogue: 0,0:17:39.11,0:17:40.05,Default,,0,0,0,,Сейана
Dialogue: 0,0:17:40.21,0:17:41.92,Default,,0,0,0,,Ең алдымен...
Dialogue: 0,0:17:43.02,0:17:45.18,Default,,0,0,0,,Арқаңнан қаққан соң, сен маған шоқпар бердің.
Dialogue: 0,0:17:45.63,0:17:46.76,Default,,0,0,0,,Ах, дұрыс
Dialogue: 0,0:17:47.59,0:17:49.03,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:02.80,0:18:04.40,Default,,0,0,0,,Акулалар – балықтар
Dialogue: 0,0:18:05.00,0:18:07.04,Default,,0,0,0,,Дельфиндер – сүтқоректілер
Dialogue: 0,0:18:08.16,0:18:09.40,Default,,0,0,0,,Хоннарая
Dialogue: 0,0:18:10.61,0:18:11.94,Default,,0,0,0,,Ұлу дегеніміз не?
Dialogue: 0,0:18:12.20,0:18:13.14,Default,,0,0,0,,Жәндіктер!
Dialogue: 0,0:18:13.28,0:18:14.36,Default,,0,0,0,,Не!
Dialogue: 0,0:18:15.02,0:18:17.40,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:18.55,0:18:22.43,Default,,0,0,0,,Мен ненің шын екенін түсінбеймін...
Dialogue: 0,0:18:24.87,0:18:26.83,Default,,0,0,0,,Менің ойымша, бұл жәндік емес.
Dialogue: 0,0:18:28.50,0:18:29.68,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:31.14,0:18:33.59,Default,,0,0,0,,Жоқ, мен шынымен білмеймін...
Dialogue: 0,0:18:36.72,0:18:38.87,Default,,0,0,0,,Бұл бәрінен кейін болатын сияқты.
Dialogue: 0,0:18:39.16,0:18:39.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:40.25,0:18:43.36,Default,,0,0,0,,Ұлулар жәндіктер жинағымен араласса
Dialogue: 0,0:18:43.38,0:18:44.81,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:18:46.24,0:18:49.19,Default,,0,0,0,,Жоқ, бұл дегеніміз...
Dialogue: 0,0:18:51.03,0:18:52.63,Default,,0,0,0,,Ұсақ-түйек!
Dialogue: 0,0:18:53.91,0:18:55.43,Default,,0,0,0,,На Сатоши-чан
Dialogue: 0,0:18:55.46,0:18:56.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:56.99,0:18:59.53,Default,,0,0,0,,Сіз Эдамаманы жақсы көресіз бе?
Dialogue: 0,0:19:00.12,0:19:01.32,Default,,0,0,0,,Иә
Dialogue: 0,0:19:05.25,0:19:06.96,Default,,0,0,0,,Аканва Сатоши-чан
Dialogue: 0,0:19:07.06,0:19:07.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:09.39,0:19:11.06,Default,,0,0,0,,Ұсақ-түйек!
Dialogue: 0,0:19:12.33,0:19:13.66,Default,,0,0,0,,Ей, тыңда—
Dialogue: 0,0:19:13.96,0:19:14.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:15.15,0:19:17.67,Default,,0,0,0,,Сіз Эдамаманы жақсы көрмейсіз бе?
Dialogue: 0,0:19:18.71,0:19:19.91,Default,,0,0,0,,Иә
Dialogue: 0,0:19:23.21,0:19:24.64,Default,,0,0,0,,Кеттік
Dialogue: 0,0:19:24.87,0:19:25.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:26.17,0:19:28.51,Default,,0,0,0,,Бұл тривиа, сондықтан
Dialogue: 0,0:19:28.53,0:19:31.71,Default,,0,0,0,,Мен шамалы білім алғым келеді...
Dialogue: 0,0:19:32.86,0:19:33.96,Default,,0,0,0,,А...
Dialogue: 0,0:19:34.20,0:19:35.18,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:40.91,0:19:42.67,Default,,0,0,0,,Мен қазір сабақтамын.
Dialogue: 0,0:19:43.02,0:19:46.19,Default,,0,0,0,,Кешіріңіз, мен бүгін көп нәрсені ойладым.
Dialogue: 0,0:19:48.39,0:19:49.95,Default,,0,0,0,,Қарастыру 1
Dialogue: 0,0:19:50.65,0:19:54.28,Default,,0,0,0,,Чио-чанның өрімі екі жағынан біріктірілген.
Dialogue: 0,0:19:54.84,0:19:56.60,Default,,0,0,0,,Қазір тәжірибе жасайық!
Dialogue: 0,0:20:04.41,0:20:05.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:05.51,0:20:07.45,Default,,0,0,0,,Шынымен байланысты!
Dialogue: 0,0:20:08.16,0:20:10.02,Default,,0,0,0,,Қарастыру 2
Dialogue: 0,0:20:11.00,0:20:14.97,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:20:15.46,0:20:16.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:19.31,0:20:20.67,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:20:20.88,0:20:23.58,Default,,0,0,0,,Ол алынбалы!
Dialogue: 0,0:20:24.92,0:20:26.66,Default,,0,0,0,,Қарастыру 3
Dialogue: 0,0:20:27.12,0:20:29.52,Default,,0,0,0,,Егер солай болса, онда бұл да болады
Dialogue: 0,0:20:29.99,0:20:31.88,Default,,0,0,0,,Рождестволық сыйлықтар үшін
Dialogue: 0,0:20:31.91,0:20:34.18,Default,,0,0,0,,Мынаны алдым!
Dialogue: 0,0:20:34.42,0:20:35.23,Default,,0,0,0,,Иә
Dialogue: 0,0:20:35.40,0:20:36.47,Default,,0,0,0,,Не?
Dialogue: 0,0:20:36.98,0:20:37.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:37.84,0:20:39.11,Default,,0,0,0,,Міне!
Dialogue: 0,0:20:48.67,0:20:50.11,Default,,0,0,0,,Не?Бұл
Dialogue: 0,0:20:51.35,0:20:53.23,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:03.00,0:21:04.97,Default,,0,0,0,,Бұл жаңа!
Dialogue: 0,0:21:05.35,0:21:06.21,Default,,0,0,0,,Эхехе (lol)
Dialogue: 0,0:21:11.04,0:21:12.01,Default,,0,0,0,,Осака
Dialogue: 0,0:21:12.95,0:21:14.99,Default,,0,0,0,,Сәлем! Осака!
Dialogue: 0,0:21:18.32,0:21:20.25,Default,,0,0,0,,О, мұғалім.
Dialogue: 0,0:21:20.85,0:21:23.26,Default,,0,0,0,,Басқа біреу жұмыс істеп жатқанда ұйықтамаңыз!
Dialogue: 0,0:21:23.86,0:21:25.43,Default,,0,0,0,,Иә
Dialogue: 0,0:21:26.32,0:21:29.10,Default,,0,0,0,,Мен білмей жатып ұйықтап қалдым.
Dialogue: 0,0:21:30.82,0:21:34.10,Default,,0,0,0,,Мен бұл туралы көп ойлағандықтан болса керек.
Dialogue: 0,0:21:35.90,0:21:38.53,Default,,0,0,0,,Бүгін ерте жатайық.
Dialogue: 0,0:21:40.08,0:21:42.58,Default,,0,0,0,,《Осакадағы Акуби》
Dialogue: 0,0:21:48.53,0:21:50.18,Default,,0,0,0,,Сәлем! Ұйықтама!
Dialogue: 0,0:21:59.18,0:22:01.74,Default,,0,0,0,,Жүрегіңде қанат қағып
Dialogue: 0,0:22:03.36,0:22:06.46,Default,,0,0,0,,Жүрегіңдегі сыбырларды айт
Dialogue: 0,0:22:07.61,0:22:10.29,Default,,0,0,0,,Енді желде
Dialogue: 0,0:22:13.95,0:22:16.51,Default,,0,0,0,,Жүрек жұлдыздардың сыртында
Dialogue: 0,0:22:18.18,0:22:21.32,Default,,0,0,0,,Тілектер әрқашан орындалады
Dialogue: 0,0:22:22.39,0:22:30.00,Default,,0,0,0,,Кел мені көр, кілті болашақтың
Dialogue: 0,0:22:31.13,0:22:35.28,Default,,0,0,0,,Терезеге ақырын шақырған дауыс
Dialogue: 0,0:22:35.38,0:22:39.12,Default,,0,0,0,,Махаббатты алдын ала ескерту және
Dialogue: 0,0:22:39.68,0:22:43.32,Default,,0,0,0,,Махаббат әлі алыс болса да
Dialogue: 0,0:22:43.62,0:22:45.60,Default,,0,0,0,,Мен ертеңге сенемін
Dialogue: 0,0:22:45.63,0:22:47.64,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:22:47.76,0:22:49.61,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:49.65,0:22:55.10,Default,,0,0,0,,Жалғыз болмаймын деп уәде бердің, аспан
Dialogue: 0,0:22:56.24,0:22:58.05,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:58.12,0:22:59.78,Default,,0,0,0,,Тәтті көз жас
Dialogue: 0,0:23:00.18,0:23:04.51,Default,,0,0,0,,Жұмақта тағы да күлімде
Dialogue: 0,0:23:04.74,0:23:06.49,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:23:06.57,0:23:12.05,Default,,0,0,0,,Мен сені нәзік армандардың аспанына алып кетуге келдім
Dialogue: 0,0:23:13.20,0:23:16.86,Default,,0,0,0,,Таңқурай аспаны мен саған қайтып келемін
Dialogue: 0,0:23:17.16,0:23:21.48,Default,,0,0,0,,Жұмақ гүлі жайқалған күні
Dialogue: 0,0:23:21.61,0:23:23.58,Default,,0,0,0,,Сен және мен...
Dialogue: 0,0:23:24.19,0:23:28.46,Default,,0,0,0,,Бірге кездесейік
Dialogue: 0,0:23:33.78,0:23:35.88,Default,,0,0,0,,Енді шешім қабылдайтын кез келді
Dialogue: 0,0:23:35.99,0:23:37.65,Default,,0,0,0,,Ағылшын тілі мұғалімдері және дене шынықтыру мұғалімдері
Dialogue: 0,0:23:37.67,0:23:39.73,Default,,0,0,0,,Қайсысы жақсы екенін көрейік!
Dialogue: 0,0:23:39.76,0:23:42.80,Default,,0,0,0,,Өрмелеу...Мұғаліммен мұғалім бірдей.
Dialogue: 0,0:23:42.83,0:23:43.64,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:23:43.67,0:23:46.17,Default,,0,0,0,,Ағылшын тілі мұғалімдерінде эго бар
Dialogue: 0,0:23:46.19,0:23:48.18,Default,,0,0,0,,Дене шынықтыру пәнінің мұғалімдері спортпен шұғылданады!
Dialogue: 0,0:23:48.20,0:23:49.05,Default,,0,0,0,,Не!
Dialogue: 0,0:23:49.08,0:23:50.90,Default,,0,0,0,,Сол себепті еркек болмайды
Dialogue: 0,0:23:50.93,0:23:52.40,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:23:52.42,0:23:53.85,Default,,0,0,0,,Сіз де.
Dialogue: 0,0:23:53.88,0:23:56.68,Default,,0,0,0,,Келесі аптада Азуманга Дайохты күтіңіз!
Dialogue: 0,0:23:56.70,0:23:58.06,Default,,0,0,0,,Алдамаңыз!!
Dialogue: 0,0:23:59.56,0:24:05.56,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory