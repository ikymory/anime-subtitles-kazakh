Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.02,0:01:32.69,Default,,0000,0000,0000,,Жоқ! Не!
Dialogue: 0,0:01:32.69,0:01:36.59,Default,,0000,0000,0000,,Нааааааа~!
Dialogue: 0,0:01:39.36,0:01:49.20,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:52.04,0:01:54.21,Default,,0000,0000,0000,,Солай болды ма?
Dialogue: 0,0:01:54.21,0:01:57.38,Default,,0000,0000,0000,,Сеянен
Dialogue: 0,0:01:54.21,0:01:57.38,Default,,0000,0000,0000,,Менің айтайын дегенім осы.
Dialogue: 0,0:01:57.38,0:02:00.32,Default,,0000,0000,0000,,Сәлем балалар
Dialogue: 0,0:01:57.38,0:02:00.32,Default,,0000,0000,0000,,Жаңа жыл құтты болсын.
Dialogue: 0,0:02:00.32,0:02:03.65,Default,,0000,0000,0000,,Құттықтаймын.
Dialogue: 0,0:02:00.32,0:02:03.65,Default,,0000,0000,0000,,Құттықтаймыз.
Dialogue: 0,0:02:03.65,0:02:06.16,Default,,0000,0000,0000,,Жаңа жыл құтты болсын.
Dialogue: 0,0:02:06.16,0:02:08.82,Default,,0000,0000,0000,,Жаңа жыл қалай өтті?
Dialogue: 0,0:02:08.82,0:02:11.66,Default,,0000,0000,0000,,Мен пеште демалып отырдым.
Dialogue: 0,0:02:11.66,0:02:14.83,Default,,0000,0000,0000,,Күлсін... Еріп бара жатты.
Dialogue: 0,0:02:14.83,0:02:18.17,Default,,0000,0000,0000,,Жаңа жылдың тыныш күні болды.
Dialogue: 0,0:02:18.17,0:02:20.67,Default,,0000,0000,0000,,Коёми-сан ше?
Dialogue: 0,0:02:18.17,0:02:20.67,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:02:20.67,0:02:23.17,Default,,0000,0000,0000,,Коёми-сан ше?
Dialogue: 0,0:02:23.17,0:02:25.51,Default,,0000,0000,0000,,Тоқта, күт!
Dialogue: 0,0:02:25.51,0:02:29.51,Default,,0000,0000,0000,,Коёми-сан қалай болды?
Dialogue: 0,0:02:25.51,0:02:29.51,Default,,0000,0000,0000,,Сіз тыңдауыңыз керек!
Dialogue: 0,0:02:29.51,0:02:32.85,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:02:29.51,0:02:32.85,Default,,0000,0000,0000,,Мен Хоккайдоға біраз уақыт бардым.
Dialogue: 0,0:02:32.85,0:02:34.85,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:32.85,0:02:34.85,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:02:34.85,0:02:38.52,Default,,0000,0000,0000,,Айтпақшы, барлығы
Dialogue: 0,0:02:34.85,0:02:38.52,Default,,0000,0000,0000,,Сіз ұшақта болдыңыз ба?
Dialogue: 0,0:02:38.52,0:02:40.69,Default,,0000,0000,0000,,Хмм, жарайды.
Dialogue: 0,0:02:40.69,0:02:43.19,Default,,0000,0000,0000,,Мен де емес.
Dialogue: 0,0:02:43.19,0:02:45.36,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:02:43.19,0:02:45.36,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:02:45.36,0:02:47.36,Default,,0000,0000,0000,,Куфу.
Dialogue: 0,0:02:47.36,0:02:50.37,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:02:47.36,0:02:50.37,Default,,0000,0000,0000,,Сол жерде сөйлесейік пе?
Dialogue: 0,0:02:50.37,0:02:52.37,Default,,0000,0000,0000,,Бұл сенің де бірінші рет!
Dialogue: 0,0:02:52.37,0:02:54.57,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:02:57.87,0:03:00.48,Default,,0000,0000,0000,,Иә Сувенир.
Dialogue: 0,0:02:57.87,0:03:00.48,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:03:00.48,0:03:02.98,Default,,0000,0000,0000,,Рахмет, мм?
Dialogue: 0,0:03:02.98,0:03:08.15,Default,,0000,0000,0000,,Ақ дос... Қара ма?
Dialogue: 0,0:03:08.15,0:03:10.15,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:03:10.15,0:03:12.15,Default,,0000,0000,0000,,Сакаки~.
Dialogue: 0,0:03:10.15,0:03:12.15,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:12.15,0:03:14.16,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:03:14.16,0:03:16.56,Default,,0000,0000,0000,,Сакаки
Dialogue: 0,0:03:14.16,0:03:16.56,Default,,0000,0000,0000,,Мен сізді аюды жақсы көреді деп естідім.
Dialogue: 0,0:03:18.49,0:03:20.66,Default,,0000,0000,0000,,Ішінде аю бар.
Dialogue: 0,0:03:20.66,0:03:23.50,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:03:20.66,0:03:23.50,Default,,0000,0000,0000,,Ой, иә.
Dialogue: 0,0:03:23.50,0:03:25.50,Default,,0000,0000,0000,,Сізге жақсы, Сакаки-сан.
Dialogue: 0,0:03:25.50,0:03:28.17,Default,,0000,0000,0000,,(Мокугё дыбысы)
Dialogue: 0,0:03:28.17,0:03:30.17,Default,,0000,0000,0000,,Ах! күнтізбе!
Dialogue: 0,0:03:30.17,0:03:33.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:30.17,0:03:33.84,Default,,0000,0000,0000,,Сіз Жаңа жылда➡
Dialogue: 0,0:03:33.84,0:03:37.18,Default,,0000,0000,0000,,Сіз аздап салмақ қостыңыз!
Dialogue: 0,0:03:37.18,0:03:40.35,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:03:37.18,0:03:40.35,Default,,0000,0000,0000,,Вахахаха! Жұлдыз ба?
Dialogue: 0,0:03:40.35,0:03:43.85,Default,,0000,0000,0000,,Хоккайдода өзімді еркін сезіндім.
Dialogue: 0,0:03:40.35,0:03:43.85,Default,,0000,0000,0000,,Бұл сіздің тым көп жегеніңізді білдіре ме?
Dialogue: 0,0:03:43.85,0:03:46.36,Default,,0000,0000,0000,,Ахахха! Сіз маған айта аласыз ба?
Dialogue: 0,0:03:46.36,0:03:48.52,Default,,0000,0000,0000,,Мочи? Зенцай?
Dialogue: 0,0:03:48.52,0:03:52.53,Default,,0000,0000,0000,,Ka… Ni….
Dialogue: 0,0:03:48.52,0:03:52.53,Default,,0000,0000,0000,,О? Оны жай ғана дауыстап айтыңыз, ә?
Dialogue: 0,0:03:52.53,0:03:54.53,Default,,0000,0000,0000,,Шаян.
Dialogue: 0,0:03:54.53,0:03:56.53,Default,,0000,0000,0000,,Кя~!
Dialogue: 0,0:03:54.53,0:03:56.53,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,0:03:56.53,0:03:58.53,Default,,0000,0000,0000,,Ку Өйткені мен қалағанымша жей алатынмын...
Dialogue: 0,0:03:58.53,0:04:00.80,Default,,0000,0000,0000,,Мия! Барлығын жеуге болады!
Dialogue: 0,0:04:00.80,0:04:04.47,Default,,0000,0000,0000,,Бұл краб! Идиот!
Dialogue: 0,0:04:04.47,0:04:08.14,Default,,0000,0000,0000,,Мұғалімге айтамын!
Dialogue: 0,0:04:08.14,0:04:12.65,Default,,0000,0000,0000,,Хоккайдода краб жеуге болады! ?
Dialogue: 0,0:04:12.65,0:04:15.32,Default,,0000,0000,0000,,Күнтізбе – бұл... Күнтізбе – бұл...
Dialogue: 0,0:04:15.32,0:04:17.32,Default,,0000,0000,0000,,Мен сені осында шынымен әкелдім!
Dialogue: 0,0:04:17.32,0:04:21.16,Default,,0000,0000,0000,,Бұл дәмді болды! ? Дәмді болды ма? Ол өте дәмдә болды!
Dialogue: 0,0:04:21.16,0:04:23.16,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:04:21.16,0:04:23.16,Default,,0000,0000,0000,,Кя~!
Dialogue: 0,0:04:23.16,0:04:26.50,Default,,0000,0000,0000,,Бұл жай шаяндар емес! Тағы не жедің? ?
Dialogue: 0,0:04:26.50,0:04:29.33,Default,,0000,0000,0000,,Шыңғыс хан т.б.
Dialogue: 0,0:04:29.33,0:04:31.33,Default,,0000,0000,0000,,Шыңғыс хан! ?
Dialogue: 0,0:04:31.33,0:04:34.84,Default,,0000,0000,0000,,Шыңғыс хан дегеніміз не?
Dialogue: 0,0:04:31.33,0:04:34.84,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:04:34.84,0:04:37.67,Default,,0000,0000,0000,,Чио-чаннан сұрайық.
Dialogue: 0,0:04:34.84,0:04:37.67,Default,,0000,0000,0000,,Есіңізде болсын!
Dialogue: 0,0:04:37.67,0:04:40.34,Default,,0000,0000,0000,,Шыңғыс хан➡
Dialogue: 0,0:04:40.34,0:04:43.35,Default,,0000,0000,0000,,Қой еті
Dialogue: 0,0:04:40.34,0:04:43.35,Default,,0000,0000,0000,,Бірегей кастрюльде гриль жасап жеңіз➡
Dialogue: 0,0:04:43.35,0:04:45.35,Default,,0000,0000,0000,,Хоккайдо аралының мамандығы.
Dialogue: 0,0:04:45.35,0:04:47.35,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:47.35,0:04:50.02,Default,,0000,0000,0000,,Бұл жақсы ма?
Dialogue: 0,0:04:47.35,0:04:50.02,Default,,0000,0000,0000,,Бұл дәмді.
Dialogue: 0,0:04:50.02,0:04:52.02,Default,,0000,0000,0000,,Ки!
Dialogue: 0,0:04:50.02,0:04:52.02,Default,,0000,0000,0000,,Жүр! Бар!
Dialogue: 0,0:04:52.02,0:04:54.69,Default,,0000,0000,0000,,Басқа ештеңе жоқ! ?
Dialogue: 0,0:04:52.02,0:04:54.69,Default,,0000,0000,0000,,Сізге тағы бір нәрсе ұнады!
Dialogue: 0,0:04:54.69,0:04:56.69,Default,,0000,0000,0000,,Ах! Сіз ыстық бұлақ алдыңыз!
Dialogue: 0,0:04:56.69,0:04:58.69,Default,,0000,0000,0000,,Ашық моншада...
Dialogue: 0,0:04:58.69,0:05:01.80,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:04:58.69,0:05:01.80,Default,,0000,0000,0000,,Сыртта? Жалаңаш па?
Dialogue: 0,0:05:01.80,0:05:04.13,Default,,0000,0000,0000,,Азғын!
Dialogue: 0,0:05:01.80,0:05:04.13,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:05:04.13,0:05:06.13,Default,,0000,0000,0000,,Ыстық бұлақ қай жерде?
Dialogue: 0,0:05:06.13,0:05:10.31,Default,,0000,0000,0000,,Ноборибецу.
Dialogue: 0,0:05:06.13,0:05:10.31,Default,,0000,0000,0000,,Ноборибецу?
Dialogue: 0,0:05:10.31,0:05:12.31,Default,,0000,0000,0000,,Ноборибецу Карлус!
Dialogue: 0,0:05:12.31,0:05:14.98,Default,,0000,0000,0000,,А, солай!
Dialogue: 0,0:05:12.31,0:05:14.98,Default,,0000,0000,0000,,Ваннаға арналған ақ тұздар!
Dialogue: 0,0:05:14.98,0:05:16.98,Default,,0000,0000,0000,,Егер солай болса, мен де сонда болдым!
Dialogue: 0,0:05:16.98,0:05:19.31,Default,,0000,0000,0000,,Бұл керемет, Ноборибецу!
Dialogue: 0,0:05:19.31,0:05:21.32,Default,,0000,0000,0000,,Өйткені, бұл Ноборибецу!
Dialogue: 0,0:05:21.32,0:05:24.99,Default,,0000,0000,0000,,Уау! ванна тұздарымен
Dialogue: 0,0:05:21.32,0:05:24.99,Default,,0000,0000,0000,,Мен бұл адамды дос деп санаймын!
Dialogue: 0,0:05:24.99,0:05:28.32,Default,,0000,0000,0000,,Аю да
Dialogue: 0,0:05:24.99,0:05:28.32,Default,,0000,0000,0000,,Бұл сәйкес келетін сияқты!
Dialogue: 0,0:05:28.32,0:05:30.66,Default,,0000,0000,0000,,《Күнтізбе: Мақтануды қояйық.
Dialogue: 0,0:05:30.66,0:05:33.16,Default,,0000,0000,0000,,Әсіресе мына жігіттердің алдында》
Dialogue: 0,0:05:38.50,0:05:40.80,Default,,0000,0000,0000,,(Батырма басылған дыбысы)
Dialogue: 0,0:05:44.51,0:05:47.51,Default,,0000,0000,0000,,Мен қайсысын таңдауым керек?
Dialogue: 0,0:05:47.51,0:05:49.61,Default,,0000,0000,0000,,Хмм... бұл!
Dialogue: 0,0:05:53.85,0:05:55.85,Default,,0000,0000,0000,,(Сауда автоматының дыбысы)
Dialogue: 0,0:05:55.85,0:05:58.35,Default,,0000,0000,0000,,Иә? О, кесе!
Dialogue: 0,0:05:58.35,0:06:00.29,Default,,0000,0000,0000,,Менің сүтті шайым!
Dialogue: 0,0:06:00.29,0:06:02.29,Default,,0000,0000,0000,,Тоқта! тоқта!
Dialogue: 0,0:06:02.29,0:06:04.59,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:02.29,0:06:04.59,Default,,0000,0000,0000,,Апат немесе...
Dialogue: 0,0:06:06.96,0:06:10.97,Default,,0000,0000,0000,,Ах... а...
Dialogue: 0,0:06:10.97,0:06:13.80,Default,,0000,0000,0000,,Мен сендім...
Dialogue: 0,0:06:13.80,0:06:16.50,Default,,0000,0000,0000,,Мм... ішгің келе ме?
Dialogue: 0,0:06:18.97,0:06:22.48,Default,,0000,0000,0000,,Бұл сауда автоматы
Dialogue: 0,0:06:18.97,0:06:22.48,Default,,0000,0000,0000,,Мен оны енді қолдануға қорқамын...
Dialogue: 0,0:06:22.48,0:06:25.98,Default,,0000,0000,0000,,Сенімнен айырылдыңыз.
Dialogue: 0,0:06:25.98,0:06:27.98,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:25.98,0:06:27.98,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:06:27.98,0:06:31.82,Default,,0000,0000,0000,,Ах~ Коёми-кун
Dialogue: 0,0:06:27.98,0:06:31.82,Default,,0000,0000,0000,,Шырын сатып алыңыз.
Dialogue: 0,0:06:31.82,0:06:35.16,Default,,0000,0000,0000,,Айтпастан сатып алуға келдім.
Dialogue: 0,0:06:35.16,0:06:37.16,Default,,0000,0000,0000,,Сүтті шай ішейік.
Dialogue: 0,0:06:37.16,0:06:39.86,Default,,0000,0000,0000,,(Сауда автоматының дыбысы)
Dialogue: 0,0:06:42.50,0:06:45.67,Default,,0000,0000,0000,,Иә? Екі кесе...
Dialogue: 0,0:06:45.67,0:06:47.67,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:06:45.67,0:06:47.67,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:47.67,0:06:49.84,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:06:49.84,0:06:53.51,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:06:49.84,0:06:53.51,Default,,0000,0000,0000,,Сондай-ақ! Сондай-ақ! Сондай-ақ!
Dialogue: 0,0:06:53.51,0:06:56.85,Default,,0000,0000,0000,,Kii~! О! Даа~!
Dialogue: 0,0:06:56.85,0:07:00.28,Default,,0000,0000,0000,,Дааааааааааааааааааааааааааа!
Dialogue: 0,0:06:56.85,0:07:00.28,Default,,0000,0000,0000,,Мен бірдеңе істедім бе?
Dialogue: 0,0:07:00.28,0:07:02.28,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:07:02.28,0:07:04.79,Default,,0000,0000,0000,,Уау! Ах~!
Dialogue: 0,0:07:04.79,0:07:06.99,Default,,0000,0000,0000,,(Уақыт сигналы)
Dialogue: 0,0:07:09.79,0:07:14.80,Default,,0000,0000,0000,,(шулы дауыстар)
Dialogue: 0,0:07:14.80,0:07:19.47,Default,,0000,0000,0000,,Жарайды, мен де шаңғы тептім.
Dialogue: 0,0:07:14.80,0:07:19.47,Default,,0000,0000,0000,,Ұнтақ қар өте құрғақ.
Dialogue: 0,0:07:19.47,0:07:21.47,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:07:21.47,0:07:25.64,Default,,0000,0000,0000,,Эй, Карри удон.
Dialogue: 0,0:07:21.47,0:07:25.64,Default,,0000,0000,0000,,Бұл да жасалуы мүмкін еді.
Dialogue: 0,0:07:25.64,0:07:27.64,Default,,0000,0000,0000,,Карри удон!
Dialogue: 0,0:07:25.64,0:07:27.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:27.64,0:07:31.48,Default,,0000,0000,0000,,Бұл қауіпті, бәрі қашады!
Dialogue: 0,0:07:27.64,0:07:31.48,Default,,0000,0000,0000,,Осы жігіттің үстінен шырын ұшып жатыр!
Dialogue: 0,0:07:31.48,0:07:34.48,Default,,0000,0000,0000,,Жарайды, мен абай боламын.
Dialogue: 0,0:07:34.48,0:07:36.99,Default,,0000,0000,0000,,Сәлем! Сақ болудың пайдасы жоқ!
Dialogue: 0,0:07:36.99,0:07:40.66,Default,,0000,0000,0000,,Ол міндетті түрде ұшады!
Dialogue: 0,0:07:36.99,0:07:40.66,Default,,0000,0000,0000,,Ал соңы карриге толы!
Dialogue: 0,0:07:40.66,0:07:43.99,Default,,0000,0000,0000,,Ақырында, күнтізбе де тағам
Dialogue: 0,0:07:40.66,0:07:43.99,Default,,0000,0000,0000,,Қасіретпен бетпе-бет келетін кез келді!
Dialogue: 0,0:07:43.99,0:07:47.33,Default,,0000,0000,0000,,Сәлем~ Сәлем~ Сәлем~.
Dialogue: 0,0:07:47.33,0:07:51.67,Default,,0000,0000,0000,,Сәлем… Сәлем~ Сәлем?
Dialogue: 0,0:07:51.67,0:07:54.50,Default,,0000,0000,0000,,Уау, бұл дәмді.
Dialogue: 0,0:07:54.50,0:07:58.01,Default,,0000,0000,0000,,Шырын мүлде ұшпайды, бұл үлкен мәселе емес.
Dialogue: 0,0:07:58.01,0:07:59.94,Default,,0000,0000,0000,,Бұл керемет, Коёми-сан.
Dialogue: 0,0:07:59.94,0:08:02.94,Default,,0000,0000,0000,,Кішкентай кезімнен
Dialogue: 0,0:07:59.94,0:08:02.94,Default,,0000,0000,0000,,Өйткені маған удон ұнады.
Dialogue: 0,0:08:02.94,0:08:07.78,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:02.94,0:08:07.78,Default,,0000,0000,0000,,Әй, ой... Мен сені кешіре алмаймын!
Dialogue: 0,0:08:07.78,0:08:09.78,Default,,0000,0000,0000,,А, сен бұрын не істедің?
Dialogue: 0,0:08:09.78,0:08:12.79,Default,,0000,0000,0000,,Куке~!
Dialogue: 0,0:08:09.78,0:08:12.79,Default,,0000,0000,0000,,Бүгінгі күн қандай?
Dialogue: 0,0:08:12.79,0:08:14.79,Default,,0000,0000,0000,,Қашпа!
Dialogue: 0,0:08:14.79,0:08:16.79,Default,,0000,0000,0000,,және Томо-чан! Ах!
Dialogue: 0,0:08:16.79,0:08:18.79,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:16.79,0:08:18.79,Default,,0000,0000,0000,,Мұнда келме!
Dialogue: 0,0:08:18.79,0:08:23.47,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:08:18.79,0:08:23.47,Default,,0000,0000,0000,,Уау, қалада шу шықты.
Dialogue: 0,0:08:23.47,0:08:26.47,Default,,0000,0000,0000,,(шулы дауыс)
Dialogue: 0,0:08:26.47,0:08:29.47,Default,,0000,0000,0000,,Э? Естімеймін.
Dialogue: 0,0:08:26.47,0:08:29.47,Default,,0000,0000,0000,,Хехехе….
Dialogue: 0,0:08:29.47,0:08:31.47,Default,,0000,0000,0000,,Тоқта, маған айтсаң түсінесің.
Dialogue: 0,0:08:31.47,0:08:35.48,Default,,0000,0000,0000,,Сүтті шайдың кегі...
Dialogue: 0,0:08:31.47,0:08:35.48,Default,,0000,0000,0000,,Жоқ, бұл бәрі емес.
Dialogue: 0,0:08:35.48,0:08:38.98,Default,,0000,0000,0000,,Шаянның өшпенділігі мен Шыңғысханның кегі!
Dialogue: 0,0:08:38.98,0:08:42.48,Default,,0000,0000,0000,,Тек сіз үшін
Dialogue: 0,0:08:38.98,0:08:42.48,Default,,0000,0000,0000,,Маған сізді жақсы сезінуге мүмкіндік бермеңіз!
Dialogue: 0,0:08:42.48,0:08:44.48,Default,,0000,0000,0000,,Неліктен? ?
Dialogue: 0,0:08:46.82,0:08:49.49,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:49.49,0:08:51.49,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:51.49,0:09:21.12,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:21.12,0:09:23.12,Default,,0000,0000,0000,,Мия!
Dialogue: 0,0:09:23.12,0:09:25.12,Default,,0000,0000,0000,,Ааааааааа!
Dialogue: 0,0:09:23.12,0:09:25.12,Default,,0000,0000,0000,,Мен әскермен бәрін реттедім.
Dialogue: 0,0:09:27.13,0:09:29.13,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:09:29.13,0:09:31.63,Default,,0000,0000,0000,,(Чи мен Юкари дауысы)
Dialogue: 0,0:09:36.47,0:09:39.98,Default,,0000,0000,0000,,Ол өсті...
Dialogue: 0,0:09:39.98,0:09:43.48,Default,,0000,0000,0000,,Кездескенше!
Dialogue: 0,0:09:39.98,0:09:43.48,Default,,0000,0000,0000,,Асықпасаң, жоқ боласың.
Dialogue: 0,0:09:43.48,0:09:45.78,Default,,0000,0000,0000,,Дәл.
Dialogue: 0,0:09:49.48,0:09:51.82,Default,,0000,0000,0000,,Осака мырза, үйге қайтайық.
Dialogue: 0,0:09:51.82,0:09:53.82,Default,,0000,0000,0000,,Сіз не оқып жатырсыз?
Dialogue: 0,0:09:53.82,0:09:57.16,Default,,0000,0000,0000,,Хмм? Ақпараттық журнал.
Dialogue: 0,0:09:57.16,0:10:00.33,Default,,0000,0000,0000,,Мен Коёми-чанның Хоккайдо туралы әңгімесін тыңдап отырғанымда➡
Dialogue: 0,0:10:00.33,0:10:05.67,Default,,0000,0000,0000,,Менің де бір жерге барғым келеді.
Dialogue: 0,0:10:00.33,0:10:05.67,Default,,0000,0000,0000,,Менің көңіл-күйім көтерілді.
Dialogue: 0,0:10:05.67,0:10:08.50,Default,,0000,0000,0000,,Сонымен мен назарымды аударған нәрсе таптым.
Dialogue: 0,0:10:08.50,0:10:10.84,Default,,0000,0000,0000,,Ах! Бұл сиқырлы жер!
Dialogue: 0,0:10:10.84,0:10:15.18,Default,,0000,0000,0000,,Сиқырлы жер?
Dialogue: 0,0:10:10.84,0:10:15.18,Default,,0000,0000,0000,,Жақында ашылған
Dialogue: 0,0:10:10.84,0:10:15.18,Default,,0000,0000,0000,,Бұл ойын-сауық саябағы!
Dialogue: 0,0:10:15.18,0:10:17.35,Default,,0000,0000,0000,,Менің барғым келді!
Dialogue: 0,0:10:17.35,0:10:19.85,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:10:19.85,0:10:24.35,Default,,0000,0000,0000,,Иә! Келесі мерекеңізге
Dialogue: 0,0:10:19.85,0:10:24.35,Default,,0000,0000,0000,,Барлығымыз осында барамыз ба?
Dialogue: 0,0:10:24.35,0:10:27.19,Default,,0000,0000,0000,,О.
Dialogue: 0,0:10:24.35,0:10:27.19,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:24.35,0:10:27.19,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:10:27.19,0:10:29.19,Default,,0000,0000,0000,,Осындай оқиғалармен бөлісуіңізді өтінемін!
Dialogue: 0,0:10:29.19,0:10:32.36,Default,,0000,0000,0000,,Мен міндім! Мен мінемін! Тек мін! Алақай! Алақай!
Dialogue: 0,0:10:32.36,0:10:34.36,Default,,0000,0000,0000,,Менде бәрі жақсы.
Dialogue: 0,0:10:32.36,0:10:34.36,Default,,0000,0000,0000,,Иә! Алақай!
Dialogue: 0,0:10:34.36,0:10:36.36,Default,,0000,0000,0000,,Бұл ойын-сауық саябағы. Бұл ойын-сауық саябағы. Хяхо!
Dialogue: 0,0:10:36.36,0:10:38.37,Default,,0000,0000,0000,,Балалар.
Dialogue: 0,0:10:36.36,0:10:38.37,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:10:38.37,0:10:41.04,Default,,0000,0000,0000,,Содан кейін сіз
Dialogue: 0,0:10:38.37,0:10:41.04,Default,,0000,0000,0000,,Сіз оны асыға күтпеймін дейсіз бе? ?
Dialogue: 0,0:10:41.04,0:10:43.87,Default,,0000,0000,0000,,Ең болмағанда
Dialogue: 0,0:10:41.04,0:10:43.87,Default,,0000,0000,0000,,Бұл соншалықты қызықты емес.
Dialogue: 0,0:10:43.87,0:10:45.87,Default,,0000,0000,0000,,Ke! Сонымен жетілген!
Dialogue: 0,0:10:45.87,0:10:50.55,Default,,0000,0000,0000,,Көздерің бала кезіңдегідей.
Dialogue: 0,0:10:45.87,0:10:50.55,Default,,0000,0000,0000,,Ол өзінің жылтырлығын жоғалтты!
Dialogue: 0,0:10:50.55,0:10:53.21,Default,,0000,0000,0000,,Бұл не...?
Dialogue: 0,0:10:50.55,0:10:53.21,Default,,0000,0000,0000,,Коёми-чан Коёми-чан.
Dialogue: 0,0:10:53.21,0:10:55.22,Default,,0000,0000,0000,,Үлкен жаңалық!
Dialogue: 0,0:10:53.21,0:10:55.22,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:55.22,0:10:59.72,Default,,0000,0000,0000,,Бұл жерде ролик бар.
Dialogue: 0,0:10:55.22,0:10:59.72,Default,,0000,0000,0000,,Жапониядағы ең жақсы.
Dialogue: 0,0:10:59.72,0:11:02.66,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:10:59.72,0:11:02.66,Default,,0000,0000,0000,,Керемет естіледі! Жапонияда №1!
Dialogue: 0,0:11:02.66,0:11:05.49,Default,,0000,0000,0000,,Қандай да бір себепті,
Dialogue: 0,0:11:02.66,0:11:05.49,Default,,0000,0000,0000,,Бұл өте қорқынышты көрінеді!
Dialogue: 0,0:11:05.49,0:11:08.00,Default,,0000,0000,0000,,Кейбіреулер жылайды
Dialogue: 0,0:11:05.49,0:11:08.00,Default,,0000,0000,0000,,Олар көп сияқты...
Dialogue: 0,0:11:08.00,0:11:10.00,Default,,0000,0000,0000,,Ал көршілес аттракцион➡
Dialogue: 0,0:11:10.00,0:11:12.50,Default,,0000,0000,0000,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:11:10.00,0:11:12.50,Default,,0000,0000,0000,,Өте қызықты көрінеді!
Dialogue: 0,0:11:12.50,0:11:17.67,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:11:12.50,0:11:17.67,Default,,0000,0000,0000,,Хоора күнтізбесі де
Dialogue: 0,0:11:12.50,0:11:17.67,Default,,0000,0000,0000,,Көңілім көтеріліп барады.
Dialogue: 0,0:11:17.67,0:11:21.34,Default,,0000,0000,0000,,(Оқушы) Қайырлы таң. (Оқушы) Қайырлы таң. Ой, күйіп кеткен екен!
Dialogue: 0,0:11:17.67,0:11:21.34,Default,,0000,0000,0000,,А, түсіндім, көремін...
Dialogue: 0,0:11:21.34,0:11:24.51,Default,,0000,0000,0000,,Күнтізбеге барсам, балаша жүгіре бастадым.
Dialogue: 0,0:11:24.51,0:11:27.68,Default,,0000,0000,0000,,А, қарашы, қарашы, құладым, жыламаймын, жыламаймын.
Dialogue: 0,0:11:27.68,0:11:30.08,Default,,0000,0000,0000,,Біртүрлі нәрселерге қарамаңыз!
Dialogue: 0,0:11:27.68,0:11:30.08,Default,,0000,0000,0000,,Жүгіру.
Dialogue: 0,0:11:39.69,0:11:42.20,Default,,0000,0000,0000,,Әй, Коёми-сан!
Dialogue: 0,0:11:39.69,0:11:42.20,Default,,0000,0000,0000,,Уа.
Dialogue: 0,0:11:39.69,0:11:42.20,Default,,0000,0000,0000,,(сыбырлау)
Dialogue: 0,0:11:42.20,0:11:44.20,Default,,0000,0000,0000,,Ааа~ Чио-чан.
Dialogue: 0,0:11:44.20,0:11:47.87,Default,,0000,0000,0000,,А, сіз шоппинг жасайсыз ба?
Dialogue: 0,0:11:44.20,0:11:47.87,Default,,0000,0000,0000,,Жақсы...
Dialogue: 0,0:11:47.87,0:11:51.71,Default,,0000,0000,0000,,I Сиқырлы жер бойынша нұсқаулық
Dialogue: 0,0:11:47.87,0:11:51.71,Default,,0000,0000,0000,,Мен сатып алуға келдім!
Dialogue: 0,0:11:51.71,0:11:55.21,Default,,0000,0000,0000,,Ертең осында!
Dialogue: 0,0:11:51.71,0:11:55.21,Default,,0000,0000,0000,,Қызықты!
Dialogue: 0,0:11:55.21,0:11:58.88,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:11:55.21,0:11:58.88,Default,,0000,0000,0000,,Коёми-сан не сатып алды?
Dialogue: 0,0:11:58.88,0:12:01.65,Default,,0000,0000,0000,,Иә? Бұл анықтамалық!
Dialogue: 0,0:12:01.65,0:12:04.49,Default,,0000,0000,0000,,Әй, анама.
Dialogue: 0,0:12:01.65,0:12:04.49,Default,,0000,0000,0000,,Шоппинг Маған мұны істеуді өтінді!
Dialogue: 0,0:12:04.49,0:12:07.49,Default,,0000,0000,0000,,Жақында кездескенше~ Чио-чан!
Dialogue: 0,0:12:04.49,0:12:07.49,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:12:07.49,0:12:09.99,Default,,0000,0000,0000,,Ертең кездескенше!
Dialogue: 0,0:12:07.49,0:12:09.99,Default,,0000,0000,0000,,Айай….
Dialogue: 0,0:12:09.99,0:12:25.17,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:25.17,0:12:27.18,Default,,0000,0000,0000,,Нихи.
Dialogue: 0,0:12:27.18,0:12:31.51,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:33.52,0:12:35.82,Default,,0000,0000,0000,,А... мүмкін емес... мүмкін емес...
Dialogue: 0,0:12:40.19,0:12:42.19,Default,,0000,0000,0000,,Жарайды ма? Суық па?
Dialogue: 0,0:12:44.53,0:12:46.53,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:12:50.70,0:12:52.70,Default,,0000,0000,0000,,(сыбырлау)
Dialogue: 0,0:12:52.70,0:12:55.20,Default,,0000,0000,0000,,Менің ойымша, бұл мүмкін емес.
Dialogue: 0,0:12:55.20,0:12:57.71,Default,,0000,0000,0000,,Бұл да...
Dialogue: 0,0:12:57.71,0:13:01.98,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:12:57.71,0:13:01.98,Default,,0000,0000,0000,,Мен мұны түзетуім керек.
Dialogue: 0,0:13:01.98,0:13:04.31,Default,,0000,0000,0000,,А, мен мұны міндетті түрде мінемін!
Dialogue: 0,0:13:04.31,0:13:06.48,Default,,0000,0000,0000,,50 минут күтсем де мінемін.
Dialogue: 0,0:13:06.48,0:13:09.32,Default,,0000,0000,0000,,Бір сағаттық күту туралы не айтасыз?
Dialogue: 0,0:13:09.32,0:13:11.82,Default,,0000,0000,0000,,Хмм, не істеуім керек...
Dialogue: 0,0:13:11.82,0:13:13.82,Default,,0000,0000,0000,,Жоқ, бірақ….
Dialogue: 0,0:13:13.82,0:13:16.49,Default,,0000,0000,0000,,Хмм... Сатоши өзін ұстай алады ма деп ойлаймын.
Dialogue: 0,0:13:16.49,0:13:18.66,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:13:18.66,0:13:21.00,Default,,0000,0000,0000,,А, бұл сілтеме!
Dialogue: 0,0:13:21.00,0:13:24.50,Default,,0000,0000,0000,,Сонда сөзсіз...
Dialogue: 0,0:13:27.67,0:13:31.51,Default,,0000,0000,0000,,Жақсы! Уриури….
Dialogue: 0,0:13:31.51,0:13:34.68,Default,,0000,0000,0000,,Иә! О, сен?
Dialogue: 0,0:13:34.68,0:13:38.68,Default,,0000,0000,0000,,Е, мен бара алмаймын! ? неге?
Dialogue: 0,0:13:38.68,0:13:40.68,Default,,0000,0000,0000,,Жылу~! ?
Dialogue: 0,0:13:40.68,0:13:42.68,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:13:45.02,0:13:47.69,Default,,0000,0000,0000,,Иә! Коёми-сан ыстық! ?
Dialogue: 0,0:13:47.69,0:13:49.69,Default,,0000,0000,0000,,Бүгін таңертең кенеттен болды.
Dialogue: 0,0:13:49.69,0:13:52.36,Default,,0000,0000,0000,,Иә, күнтізбе де апат.
Dialogue: 0,0:13:52.36,0:13:56.20,Default,,0000,0000,0000,,Онда мен бүгінгі сапарымды тоқтатамын.
Dialogue: 0,0:13:52.36,0:13:56.20,Default,,0000,0000,0000,,Қойоми-санға қонаққа барайық.
Dialogue: 0,0:13:56.20,0:13:58.53,Default,,0000,0000,0000,,Читчитчи.
Dialogue: 0,0:13:58.53,0:14:00.80,Default,,0000,0000,0000,,Чио-чан.
Dialogue: 0,0:13:58.53,0:14:00.80,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:14:00.80,0:14:03.97,Default,,0000,0000,0000,,Чио-чан, сен жай ғана баласың.
Dialogue: 0,0:14:03.97,0:14:06.81,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:14:03.97,0:14:06.81,Default,,0000,0000,0000,,Амансың ба? Солай жасасаңыз➡
Dialogue: 0,0:14:06.81,0:14:08.98,Default,,0000,0000,0000,,Күнтізбеге де көңіл бөлесің, солай ма?
Dialogue: 0,0:14:08.98,0:14:11.65,Default,,0000,0000,0000,,Сондықтан күнтізбені әзірге жалғыз қалдырыңыз➡
Dialogue: 0,0:14:11.65,0:14:14.82,Default,,0000,0000,0000,,Толығымен
Dialogue: 0,0:14:11.65,0:14:14.82,Default,,0000,0000,0000,,Дұрыс жауап - көңіл көтеру!
Dialogue: 0,0:14:14.82,0:14:18.65,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:14:18.65,0:14:22.16,Default,,0000,0000,0000,,Міне, солай!
Dialogue: 0,0:14:18.65,0:14:22.16,Default,,0000,0000,0000,,Міне кеттік!
Dialogue: 0,0:14:22.16,0:14:24.16,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:14:24.16,0:14:27.00,Default,,0000,0000,0000,,Баспалдақпен жүгіру
Dialogue: 0,0:14:24.16,0:14:27.00,Default,,0000,0000,0000,,Бұл қауіпті!
Dialogue: 0,0:14:27.00,0:14:32.00,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:14:27.00,0:14:32.00,Default,,0000,0000,0000,,Платформада көңіл көтеру қауіпті!
Dialogue: 0,0:14:32.00,0:14:34.00,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:14:34.00,0:14:36.50,Default,,0000,0000,0000,,(Сағат дыбысы)
Dialogue: 0,0:14:39.51,0:14:42.01,Default,,0000,0000,0000,,《Бәрі қазір...
Dialogue: 0,0:14:42.01,0:14:44.01,Default,,0000,0000,0000,,Ах, бірақ мүмкін➡
Dialogue: 0,0:14:44.01,0:14:47.68,Default,,0000,0000,0000,,Таң қалдыруға тырысады
Dialogue: 0,0:14:44.01,0:14:47.68,Default,,0000,0000,0000,,Ол маған қонаққа келді...》
Dialogue: 0,0:14:44.01,0:14:47.68,Default,,0000,0000,0000,,📞
Dialogue: 0,0:14:47.68,0:14:50.58,Default,,0000,0000,0000,,📞 (күнтізбенің анасы) күнтізбе ~
Dialogue: 0,0:14:47.68,0:14:50.58,Default,,0000,0000,0000,,Сізге Такино мырза хабарласады.
Dialogue: 0,0:14:52.52,0:14:55.02,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:14:52.52,0:14:55.02,Default,,0000,0000,0000,,📞 (Томо) Сәлеметсіз бе, күнтізбе~?
Dialogue: 0,0:14:55.02,0:14:58.69,Default,,0000,0000,0000,,📞Қазір жағалауға мінейік!
Dialogue: 0,0:14:55.02,0:14:58.69,Default,,0000,0000,0000,,Сондықтан мен сіздерге тікелей эфир беремін!
Dialogue: 0,0:14:58.69,0:15:01.46,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:14:58.69,0:15:01.46,Default,,0000,0000,0000,,(телефонның тұтқасын қою дыбысы)
Dialogue: 0,0:15:01.46,0:15:04.63,Default,,0000,0000,0000,,(Өзен шуы)
Dialogue: 0,0:15:04.63,0:15:07.13,Default,,0000,0000,0000,,(Екінші қолдың дыбысы)
Dialogue: 0,0:15:12.14,0:15:15.14,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:15:15.14,0:15:17.98,Default,,0000,0000,0000,,Мұнда….
Dialogue: 0,0:15:15.14,0:15:17.98,Default,,0000,0000,0000,,📞
Dialogue: 0,0:15:17.98,0:15:19.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:17.98,0:15:19.98,Default,,0000,0000,0000,,📞
Dialogue: 0,0:15:19.98,0:15:22.82,Default,,0000,0000,0000,,📞 (күнтізбенің анасы) күнтізбе ~
Dialogue: 0,0:15:19.98,0:15:22.82,Default,,0000,0000,0000,,Чио-чан қоңырау шалып жатыр.
Dialogue: 0,0:15:22.82,0:15:25.82,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:15:25.82,0:15:28.82,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:15:25.82,0:15:28.82,Default,,0000,0000,0000,,📞Аа, Коёми-сан, жақсысың ба?
Dialogue: 0,0:15:28.82,0:15:30.83,Default,,0000,0000,0000,,📞Қызбағыңыз төмендеді ме?
Dialogue: 0,0:15:30.83,0:15:32.83,Default,,0000,0000,0000,,Иә, аздап.
Dialogue: 0,0:15:32.83,0:15:36.50,Default,,0000,0000,0000,,📞Жоқ, мен қызғанып, жалаңаш ұйықтаймын.
Dialogue: 0,0:15:36.50,0:15:39.83,Default,,0000,0000,0000,,Бір минут күтіңіз!
Dialogue: 0,0:15:36.50,0:15:39.83,Default,,0000,0000,0000,,Бұл не? ?
Dialogue: 0,0:15:39.83,0:15:41.84,Default,,0000,0000,0000,,Даналық? Сатоси осылай деді ме? ?
Dialogue: 0,0:15:41.84,0:15:45.01,Default,,0000,0000,0000,,📞Е, у...
Dialogue: 0,0:15:41.84,0:15:45.01,Default,,0000,0000,0000,,Тек оған қоңырау шалыңыз!
Dialogue: 0,0:15:45.01,0:15:47.84,Default,,0000,0000,0000,,📞Мен түсінемін!
Dialogue: 0,0:15:45.01,0:15:47.84,Default,,0000,0000,0000,,Мен сені қазір ауыстырамын!
Dialogue: 0,0:15:47.84,0:15:49.84,Default,,0000,0000,0000,,📞Бір минут күтіңіз!
Dialogue: 0,0:15:49.84,0:15:52.68,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:52.68,0:15:54.85,Default,,0000,0000,0000,,📞 (Кагура) Уау!
Dialogue: 0,0:15:52.68,0:15:54.85,Default,,0000,0000,0000,,📞Сол Томо-чан!
Dialogue: 0,0:15:54.85,0:15:58.85,Default,,0000,0000,0000,,📞(Чи) Ахахха! Бұл қызықты болды!
Dialogue: 0,0:15:58.85,0:16:01.96,Default,,0000,0000,0000,,📞Мм... сол телефон қоңырауы...
Dialogue: 0,0:15:58.85,0:16:01.96,Default,,0000,0000,0000,,📞 (Адымдап) Ах~ Бұл не? Бұл.
Dialogue: 0,0:16:01.96,0:16:03.96,Default,,0000,0000,0000,,📞Күтіңіз!
Dialogue: 0,0:16:03.96,0:16:07.30,Default,,0000,0000,0000,,📞 (Кагура) Болды, болды!
Dialogue: 0,0:16:03.96,0:16:07.30,Default,,0000,0000,0000,,📞Кёми-санның телефон қоңырауы!
Dialogue: 0,0:16:07.30,0:16:09.80,Default,,0000,0000,0000,,📞 (Аюму) Бұл мені өлтіреді.
Dialogue: 0,0:16:07.30,0:16:09.80,Default,,0000,0000,0000,,📞Сәлеметсіз бе!
Dialogue: 0,0:16:09.80,0:16:11.97,Default,,0000,0000,0000,,📞 (Чи) Келесіде солай істейік!
Dialogue: 0,0:16:09.80,0:16:11.97,Default,,0000,0000,0000,,📞Сәлеметсіз бе!
Dialogue: 0,0:16:11.97,0:16:14.47,Default,,0000,0000,0000,,📞 (Томо/Аюму/Кагура) Ахахаха!
Dialogue: 0,0:16:19.31,0:16:21.64,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:16:21.64,0:16:24.65,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:16:21.64,0:16:24.65,Default,,0000,0000,0000,,Қайырлы таң күнтізбесі.
Dialogue: 0,0:16:24.65,0:16:27.32,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:16:27.32,0:16:30.32,Default,,0000,0000,0000,,Коёми-сан, сен сауығып кеттің.
Dialogue: 0,0:16:30.32,0:16:32.82,Default,,0000,0000,0000,,Кешегі күн көңілсіз болды...
Dialogue: 0,0:16:32.82,0:16:36.99,Default,,0000,0000,0000,,Ах, рахмет.
Dialogue: 0,0:16:32.82,0:16:36.99,Default,,0000,0000,0000,,Кешегі күн қызық болды ма?
Dialogue: 0,0:16:36.99,0:16:42.00,Default,,0000,0000,0000,,《Иә? Шынымды айтсам, қызық болды.
Dialogue: 0,0:16:36.99,0:16:42.00,Default,,0000,0000,0000,,Айтсам ба? Немесе...》
Dialogue: 0,0:16:42.00,0:16:44.00,Default,,0000,0000,0000,,Жоқ, бұл ең жақсы!
Dialogue: 0,0:16:42.00,0:16:44.00,Default,,0000,0000,0000,,Бұл – Огимотоя.
Dialogue: 0,0:16:44.00,0:16:47.17,Default,,0000,0000,0000,,Енді аттракциондар жоқ
Dialogue: 0,0:16:44.00,0:16:47.17,Default,,0000,0000,0000,,Бұл өте әсерлі!
Dialogue: 0,0:16:47.17,0:16:50.00,Default,,0000,0000,0000,,Бірақ көп адам болды!
Dialogue: 0,0:16:50.00,0:16:54.84,Default,,0000,0000,0000,,Бұл қазірдің өзінде көптеген адамдар.
Dialogue: 0,0:16:50.00,0:16:54.84,Default,,0000,0000,0000,,Осының өзі мені шаршатады.
Dialogue: 0,0:16:54.84,0:16:57.51,Default,,0000,0000,0000,,Бірақ қанша күтсем де
Dialogue: 0,0:16:54.84,0:16:57.51,Default,,0000,0000,0000,,Мінуге тұрарлық заттар➡
Dialogue: 0,0:16:57.51,0:17:00.78,Default,,0000,0000,0000,,Барлығы осыған байланысты болды!
Dialogue: 0,0:16:57.51,0:17:00.78,Default,,0000,0000,0000,,Жоқ, Кагура-сан, бұл рас!
Dialogue: 0,0:17:00.78,0:17:03.79,Default,,0000,0000,0000,,Сатоши-чан
Dialogue: 0,0:17:00.78,0:17:03.79,Default,,0000,0000,0000,,Қай жерде дүниеге келдіңіз?
Dialogue: 0,0:17:03.79,0:17:06.62,Default,,0000,0000,0000,,Айтпақшы, Сатоши-чан ол кезде өте шулы болатын.
Dialogue: 0,0:17:06.62,0:17:10.12,Default,,0000,0000,0000,,О, мінекей! Менің ағам
Dialogue: 0,0:17:06.62,0:17:10.12,Default,,0000,0000,0000,,Не шулы?
Dialogue: 0,0:17:10.12,0:17:13.29,Default,,0000,0000,0000,,Иә! Бонус➡
Dialogue: 0,0:17:13.29,0:17:15.63,Default,,0000,0000,0000,,Әртүрлі заттар
Dialogue: 0,0:17:13.29,0:17:15.63,Default,,0000,0000,0000,,Ол ұшып кетеді.
Dialogue: 0,0:17:15.63,0:17:17.83,Default,,0000,0000,0000,,Қыста тер, Еріншекпін.
Dialogue: 0,0:17:19.97,0:17:21.97,Default,,0000,0000,0000,,Хахаха!
Dialogue: 0,0:17:21.97,0:17:24.14,Default,,0000,0000,0000,,Бұл күлкі емес!
Dialogue: 0,0:17:24.14,0:17:27.48,Default,,0000,0000,0000,,Өте орынды.
Dialogue: 0,0:17:27.48,0:17:29.81,Default,,0000,0000,0000,,Біз туралы
Dialogue: 0,0:17:27.48,0:17:29.81,Default,,0000,0000,0000,,Өмірден ләззат алмасаңыз➡
Dialogue: 0,0:17:29.81,0:17:32.65,Default,,0000,0000,0000,,Көңілді бола алмайсың!
Dialogue: 0,0:17:32.65,0:17:34.65,Default,,0000,0000,0000,,Олай емес.
Dialogue: 0,0:17:34.65,0:17:36.65,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:17:36.65,0:17:41.32,Default,,0000,0000,0000,,Сондықтан жоқ.
Dialogue: 0,0:17:36.65,0:17:41.32,Default,,0000,0000,0000,,Мен келе алмағаныма өте қуаныштымын!
Dialogue: 0,0:17:41.32,0:17:43.83,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:41.32,0:17:43.83,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:17:43.83,0:17:45.99,Default,,0000,0000,0000,,Укии~!
Dialogue: 0,0:17:45.99,0:17:50.00,Default,,0000,0000,0000,,Ах! Күнтізбе бұзылды!
Dialogue: 0,0:17:55.00,0:17:57.10,Default,,0000,0000,0000,,бұл...
Dialogue: 0,0:18:10.79,0:18:13.45,Default,,0000,0000,0000,,Сол Коёми-сан...
Dialogue: 0,0:18:13.45,0:18:16.12,Default,,0000,0000,0000,,Дәл қазір...
Dialogue: 0,0:18:16.12,0:18:18.79,Default,,0000,0000,0000,,Чио-чан ешқашан кешірім сұрамайды.
Dialogue: 0,0:18:18.79,0:18:23.80,Default,,0000,0000,0000,,Бұл нағыз кәдесый!
Dialogue: 0,0:18:23.80,0:18:26.00,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:18:27.97,0:18:30.14,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:18:30.14,0:18:34.48,Default,,0000,0000,0000,,Ішінде не бар?
Dialogue: 0,0:18:30.14,0:18:34.48,Default,,0000,0000,0000,,Бұл Сиқырлы жердің бойтұмары.
Dialogue: 0,0:18:34.48,0:18:36.48,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:18:36.48,0:18:42.15,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:18:42.15,0:18:44.55,Default,,0000,0000,0000,,Рахмет, Чио-чан.
Dialogue: 0,0:18:46.65,0:18:48.99,Default,,0000,0000,0000,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:18:48.99,0:18:52.16,Default,,0000,0000,0000,,Коёми-сан.
Dialogue: 0,0:18:48.99,0:18:52.16,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:52.16,0:18:57.17,Default,,0000,0000,0000,,Бұл жолы
Dialogue: 0,0:18:52.16,0:18:57.17,Default,,0000,0000,0000,,Коёми-сан да менімен... иә?
Dialogue: 0,0:18:57.17,0:18:59.57,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:19:03.27,0:19:07.11,Default,,0000,0000,0000,,Уау! Суық!
Dialogue: 0,0:19:07.11,0:19:11.78,Default,,0000,0000,0000,,Қар?
Dialogue: 0,0:19:07.11,0:19:11.78,Default,,0000,0000,0000,,О, бұл рас!
Dialogue: 0,0:19:11.78,0:19:13.95,Default,,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,0:19:13.95,0:19:41.64,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:41.64,0:19:43.98,Default,,0000,0000,0000,,Үйіліп қалса тамаша болар еді.
Dialogue: 0,0:19:43.98,0:19:46.65,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:19:59.66,0:20:01.66,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:01.66,0:20:05.17,Default,,0000,0000,0000,,Ақ!
Dialogue: 0,0:20:01.66,0:20:05.17,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:20:01.66,0:20:05.17,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:20:05.17,0:20:08.17,Default,,0000,0000,0000,,Бұл әдемі!
Dialogue: 0,0:20:08.17,0:20:11.17,Default,,0000,0000,0000,,Ой, бірдеңе істейік!
Dialogue: 0,0:20:08.17,0:20:11.17,Default,,0000,0000,0000,,Бірдеңе істе! Бірдеңе істейік!
Dialogue: 0,0:20:11.17,0:20:13.34,Default,,0000,0000,0000,,Қарлы шайқас!
Dialogue: 0,0:20:11.17,0:20:13.34,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:20:13.34,0:20:15.34,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:20:15.34,0:20:17.54,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:20.51,0:20:23.52,Default,,0000,0000,0000,,Ахахха Құлап кетсем де ауырмайды.
Dialogue: 0,0:20:23.52,0:20:26.52,Default,,0000,0000,0000,,Уау! Өте әдемі!
Dialogue: 0,0:20:23.52,0:20:26.52,Default,,0000,0000,0000,,Нахахахаха! Сақтығыңызды төмендетпеңіз!
Dialogue: 0,0:20:26.52,0:20:29.52,Default,,0000,0000,0000,,Э? Естімеймін.
Dialogue: 0,0:20:26.52,0:20:29.52,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:20:29.52,0:20:32.86,Default,,0000,0000,0000,,Сіз мұны жасадыңыз!
Dialogue: 0,0:20:29.52,0:20:32.86,Default,,0000,0000,0000,,Ахахха!
Dialogue: 0,0:20:32.86,0:20:35.86,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:20:32.86,0:20:35.86,Default,,0000,0000,0000,,Таа~!
Dialogue: 0,0:20:35.86,0:20:39.37,Default,,0000,0000,0000,,Ахахха!
Dialogue: 0,0:20:35.86,0:20:39.37,Default,,0000,0000,0000,,Бұл сергітеді.
Dialogue: 0,0:20:39.37,0:20:42.37,Default,,0000,0000,0000,,Хо-хо!
Dialogue: 0,0:20:39.37,0:20:42.37,Default,,0000,0000,0000,,Сакаки мырза керемет!
Dialogue: 0,0:20:42.37,0:20:44.37,Default,,0000,0000,0000,,Өте беделді адамды әкеліпсің ғой, иә?
Dialogue: 0,0:20:42.37,0:20:44.37,Default,,0000,0000,0000,,Жоқ, жақсы...
Dialogue: 0,0:20:44.37,0:20:46.71,Default,,0000,0000,0000,,Уау, бұл бейберекетсіздік.
Dialogue: 0,0:20:44.37,0:20:46.71,Default,,0000,0000,0000,,Мен сені күттім, Батыр. ➡
Dialogue: 0,0:20:46.71,0:20:50.04,Default,,0000,0000,0000,,Кеттік! Ах!
Dialogue: 0,0:20:50.04,0:20:52.88,Default,,0000,0000,0000,,Оныо! ?
Dialogue: 0,0:20:50.04,0:20:52.88,Default,,0000,0000,0000,,Нахахаха!
Dialogue: 0,0:20:52.88,0:20:57.72,Default,,0000,0000,0000,,Хоккайдоға қайтар жолды бағаламаңыз!
Dialogue: 0,0:20:57.72,0:21:00.82,Default,,0000,0000,0000,,Мен айттым!
Dialogue: 0,0:21:00.82,0:21:03.66,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:21:03.66,0:21:06.16,Default,,0000,0000,0000,,Хо хо... таа~!
Dialogue: 0,0:21:06.16,0:21:08.16,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:21:08.16,0:21:10.16,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:10.16,0:21:12.17,Default,,0000,0000,0000,,Әдемі~ Уау!
Dialogue: 0,0:21:12.17,0:21:14.17,Default,,0000,0000,0000,,Охохохо!
Dialogue: 0,0:21:14.17,0:21:16.50,Default,,0000,0000,0000,,Сатоши-чан қу!
Dialogue: 0,0:21:16.50,0:21:19.84,Default,,0000,0000,0000,,А, а, а, а....
Dialogue: 0,0:21:19.84,0:21:33.69,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:21:33.69,0:21:37.36,Default,,0000,0000,0000,,Хекш….
Dialogue: 0,0:21:33.69,0:21:37.36,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:21:37.36,0:21:40.19,Default,,0000,0000,0000,,Хекш….
Dialogue: 0,0:21:40.19,0:21:42.39,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:21:47.87,0:21:50.57,Default,,0000,0000,0000,,(Сағат дыбысы)
Dialogue: 0,0:21:52.87,0:21:54.87,Default,,0000,0000,0000,,Идиот...
Dialogue: 0,0:21:56.37,0:22:02.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory