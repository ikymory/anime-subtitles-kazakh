Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.83,0:00:07.30,Default,,0,0,0,,Лу Ла Лу Ла Пианино - әлемдік
Dialogue: 0,0:00:07.33,0:00:10.81,Default,,0,0,0,,Арман гүлдеген далада әуен
Dialogue: 0,0:00:10.84,0:00:14.27,Default,,0,0,0,,Сынған сағатқа сену
Dialogue: 0,0:00:14.30,0:00:17.73,Default,,0,0,0,,Уақыт сенің жаныңда кім?
Dialogue: 0,0:00:17.76,0:00:21.10,Default,,0,0,0,,Менің кеудем неге үлкен?
Dialogue: 0,0:00:21.31,0:00:24.72,Default,,0,0,0,,Сіз мейірімді адамды күтесіз бе?
Dialogue: 0,0:00:24.80,0:00:28.29,Default,,0,0,0,,Маған тамаша болашағыңыз туралы айтып беріңіз
Dialogue: 0,0:00:28.32,0:00:28.99,Default,,0,0,0,,Ай
Dialogue: 0,0:00:29.08,0:00:29.84,Default,,0,0,0,,Жарық
Dialogue: 0,0:00:29.96,0:00:31.70,Default,,0,0,0,,Ай сәулесі ұйықтап жатыр
Dialogue: 0,0:00:31.73,0:00:35.27,Default,,0,0,0,,Лу Ла Лу Ла Есте сақтау алмасына
Dialogue: 0,0:00:35.30,0:00:38.64,Default,,0,0,0,,Оянған қыз мені сүйеді
Dialogue: 0,0:00:38.68,0:00:42.19,Default,,0,0,0,,Азаппен жайылған кітапта
Dialogue: 0,0:00:42.22,0:00:45.46,Default,,0,0,0,,Екі қоңырау соғылады
Dialogue: 0,0:00:45.61,0:00:48.90,Default,,0,0,0,,Мен жақсы көретін адам, өйткені мен оны құшақтағым келеді
Dialogue: 0,0:00:49.14,0:00:52.67,Default,,0,0,0,,Енді жылама Қош бол қайғы
Dialogue: 0,0:00:52.69,0:00:56.17,Default,,0,0,0,,Жұмбақ есіктегі жазу
Dialogue: 0,0:00:56.20,0:00:59.61,Default,,0,0,0,,«Сорамими торты»
Dialogue: 0,0:00:59.63,0:01:00.94,Default,,0,0,0,,Ғажайыптар әлемі!
Dialogue: 0,0:01:00.97,0:01:02.69,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:02.72,0:01:04.01,Default,,0,0,0,,Ертегілер елі!
Dialogue: 0,0:01:04.04,0:01:05.68,Default,,0,0,0,,Бұл махаббаттың сиқыры
Dialogue: 0,0:01:05.71,0:01:07.02,Default,,0,0,0,,Махаббат бәрібір!
Dialogue: 0,0:01:07.05,0:01:08.80,Default,,0,0,0,,Күн сайын үлпілдек
Dialogue: 0,0:01:08.83,0:01:12.29,Default,,0,0,0,,Бидайдың азғыруы
Dialogue: 0,0:01:12.32,0:01:13.59,Default,,0,0,0,,Сізге арналған торт!
Dialogue: 0,0:01:13.62,0:01:15.32,Default,,0,0,0,,Бүгін кешке тамақтаныңыз.
Dialogue: 0,0:01:15.34,0:01:16.66,Default,,0,0,0,,Сізге шай!
Dialogue: 0,0:01:16.69,0:01:18.38,Default,,0,0,0,,Шоқжұлдыз шай ішу
Dialogue: 0,0:01:18.40,0:01:19.69,Default,,0,0,0,,Терезеде
Dialogue: 0,0:01:19.72,0:01:21.46,Default,,0,0,0,,Періштелер хоры
Dialogue: 0,0:01:21.49,0:01:24.87,Default,,0,0,0,,Құлағыңыз бос па?
Dialogue: 0,0:01:24.90,0:01:28.46,Default,,0,0,0,,Мен сені сүйемін, мен сені сүйемін дауыс
Dialogue: 0,0:01:33.76,0:01:37.28,Default,,0,0,0,,Ұлы жол сан алуан болған сайын қойын жоғалтады.
Dialogue: 0,0:01:37.94,0:01:40.25,Default,,0,0,0,,Әртүрлі деген мағынаны білдіреді.
Dialogue: 0,0:01:40.49,0:01:43.73,Default,,0,0,0,,Үлкен жолда бірнеше қоштасу жолдары бар.
Dialogue: 0,0:01:43.76,0:01:45.92,Default,,0,0,0,,Қашқан қойдың ізін жоғалтты
Dialogue: 0,0:01:45.95,0:01:46.76,Default,,0,0,0,,Иә.
Dialogue: 0,0:01:47.32,0:01:50.34,Default,,0,0,0,,Өмірде жолдарды ажыратудың көптеген жолдары бар.
Dialogue: 0,0:01:50.46,0:01:53.18,Default,,0,0,0,,Адасып қалмасқа амалым жоқ.
Dialogue: 0,0:01:54.60,0:01:57.50,Default,,0,0,0,,Сондықтан мақсат қойып өмір сүрген дұрыс.
Dialogue: 0,0:01:57.53,0:01:58.86,Default,,0,0,0,,сөзі
Dialogue: 0,0:01:59.71,0:02:01.94,Default,,0,0,0,,Сондықтан әр адам өзінің кәсіптік жолын таңдауы керек.
Dialogue: 0,0:02:01.97,0:02:04.39,Default,,0,0,0,,Бұл туралы мұқият ойластырған жөн.
Dialogue: 0,0:02:04.68,0:02:05.62,Default,,0,0,0,,Уа!
Dialogue: 0,0:02:05.86,0:02:06.35,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:06.56,0:02:09.92,Default,,0,0,0,,Кимура мырза неге мұғалім болды?
Dialogue: 0,0:02:10.22,0:02:12.08,Default,,0,0,0,,Өйткені маған жоғары сыныптағы қыздар ұнайды.
Dialogue: 0,0:02:22.61,0:02:24.94,Default,,0,0,0,,Эй, бұл Кимура туралы не болды?
Dialogue: 0,0:02:25.75,0:02:27.65,Default,,0,0,0,,Аға, анық айтсам да...
Dialogue: 0,0:02:27.69,0:02:28.89,Default,,0,0,0,,Жоқ!!
Dialogue: 0,0:02:29.61,0:02:32.09,Default,,0,0,0,,Балалар бәріміз де жақсы әсер алдық!
Dialogue: 0,0:02:32.54,0:02:35.88,Default,,0,0,0,,Студенттермен соншалықты адал болғаныңызға сене алар емеспін.
Dialogue: 0,0:02:35.91,0:02:39.09,Default,,0,0,0,,Аа, мен мұндай мұғалімді көрген емеспін.
Dialogue: 0,0:02:39.11,0:02:40.45,Default,,0,0,0,,Ура!
Dialogue: 0,0:02:40.93,0:02:45.69,Default,,0,0,0,,Кимура мырза сияқты басқалар болса қиын болар еді.
Dialogue: 0,0:02:46.05,0:02:48.01,Default,,0,0,0,,Бір ғана адам проблеманы шешуге жеткілікті.
Dialogue: 0,0:02:49.70,0:02:50.43,Default,,0,0,0,,О
Dialogue: 0,0:02:51.57,0:02:55.25,Default,,0,0,0,,Осы уақытқа дейін проблема болмағанына сенімдімін.
Dialogue: 0,0:02:55.50,0:02:58.37,Default,,0,0,0,,Негізі оны мектеп жасырады.
Dialogue: 0,0:02:59.33,0:03:01.19,Default,,0,0,0,,Тоқтау.
Dialogue: 0,0:03:01.77,0:03:03.29,Default,,0,0,0,,Жоқ, мен олай ойламаймын.
Dialogue: 0,0:03:03.41,0:03:06.07,Default,,0,0,0,,Келесі - бассейн.
Dialogue: 0,0:03:06.51,0:03:09.55,Default,,0,0,0,,Киіміңді тез ауыстырмасаң, кешігіп қаласың.
Dialogue: 0,0:03:14.62,0:03:15.62,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:15.78,0:03:19.45,Default,,0,0,0,,Куросава мырза маған арнайы тапсырыс берді.
Dialogue: 0,0:03:19.96,0:03:20.98,Default,,0,0,0,,Иә
Dialogue: 0,0:03:21.39,0:03:24.22,Default,,0,0,0,,Мен оны форманың астына киіп жүрмін.
Dialogue: 0,0:03:25.02,0:03:27.36,Default,,0,0,0,,Бастауыш сынып оқушысы сияқты әрекет етпеңіз.
Dialogue: 0,0:03:28.78,0:03:29.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:30.61,0:03:31.82,Default,,0,0,0,,Америкалықтар және
Dialogue: 0,0:03:31.90,0:03:34.26,Default,,0,0,0,,Бір ғана американдық бар!
Dialogue: 0,0:03:34.53,0:03:36.05,Default,,0,0,0,,О, әрине
Dialogue: 0,0:03:36.08,0:03:38.98,Default,,0,0,0,,Өткен жылға дейін кіші мектеп оқушысы болғаныңа сене алар емеспін.
Dialogue: 0,0:03:43.74,0:03:44.40,Default,,0,0,0,,Не?
Dialogue: 0,0:03:45.38,0:03:46.41,Default,,0,0,0,,Жапон халқы
Dialogue: 0,0:03:46.51,0:03:48.05,Default,,0,0,0,,Не?!
Dialogue: 0,0:03:48.71,0:03:52.83,Default,,0,0,0,,Жоқ, оның жапонша екеніне сенімдімін, бірақ маған мағынасы жоқ.
Dialogue: 0,0:03:52.93,0:03:55.86,Default,,0,0,0,,Иә! Жапон, иә
Dialogue: 0,0:03:56.41,0:03:57.90,Default,,0,0,0,,Сонымен күнтізбе туралы не деуге болады?
Dialogue: 0,0:04:03.65,0:04:04.42,Default,,0,0,0,,Гавайи
Dialogue: 0,0:04:04.44,0:04:05.32,Default,,0,0,0,,Гавайи?
Dialogue: 0,0:04:07.11,0:04:08.98,Default,,0,0,0,,Бұл Америка.
Dialogue: 0,0:04:09.23,0:04:12.28,Default,,0,0,0,,Егер сіз оны жай ғана үш бөлікке бөлсеңіз.
Dialogue: 0,0:04:12.78,0:04:14.50,Default,,0,0,0,,Сақаки мырзаның бір тобы бар.
Dialogue: 0,0:04:15.05,0:04:15.93,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:04:16.06,0:04:19.04,Default,,0,0,0,,Содан кейін Каорин мен Чихиро тобы болды.
Dialogue: 0,0:04:19.09,0:04:19.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:20.16,0:04:20.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:21.33,0:04:22.38,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:04:23.49,0:04:25.13,Default,,0,0,0,,Біз сондамыз ба?
Dialogue: 0,0:04:25.26,0:04:27.69,Default,,0,0,0,,Хмф
Dialogue: 0,0:04:28.10,0:04:29.86,Default,,0,0,0,,Чио Чанның тобы
Dialogue: 0,0:04:30.23,0:04:31.01,Default,,0,0,0,,Не?!
Dialogue: 0,0:04:31.93,0:04:32.89,Default,,0,0,0,,Не ол?
Dialogue: 0,0:04:34.42,0:04:36.28,Default,,0,0,0,,Чио-чан, бар күшіңді сал
Dialogue: 0,0:04:36.53,0:04:37.13,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:37.15,0:04:39.54,Default,,0,0,0,,Чио-чан менің досым
Dialogue: 0,0:04:39.56,0:04:41.58,Default,,0,0,0,,Бұл тағы бірнеше жыл болуы мүмкін.
Dialogue: 0,0:04:42.56,0:04:43.16,Default,,0,0,0,,Уау
Dialogue: 0,0:04:43.80,0:04:44.79,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:44.86,0:04:47.55,Default,,0,0,0,,Сакаки-санға ұқсайтын шығарсың!
Dialogue: 0,0:04:47.71,0:04:48.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:50.27,0:04:52.14,Default,,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:04:55.60,0:04:56.78,Default,,0,0,0,,Сатқын
Dialogue: 0,0:04:57.05,0:04:57.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:57.82,0:04:59.63,Default,,0,0,0,,Иә, сатқын!
Dialogue: 0,0:05:00.03,0:05:00.91,Default,,0,0,0,,Сатқын
Dialogue: 0,0:05:00.96,0:05:02.30,Default,,0,0,0,,Сатқын!
Dialogue: 0,0:05:03.99,0:05:06.26,Default,,0,0,0,,Уайымдама, мен қалдырамын.
Dialogue: 0,0:05:07.27,0:05:08.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:09.46,0:05:10.42,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:05:11.01,0:05:11.49,Default,,0,0,0,,На
Dialogue: 0,0:05:13.73,0:05:15.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:16.92,0:05:21.64,Default,,0,0,0,,Кинконканконкинконканконкинконкан!
Dialogue: 0,0:05:27.26,0:05:28.09,Default,,0,0,0,,Шынымен осындай нәрсені киесің бе?
Dialogue: 0,0:05:29.23,0:05:29.81,Default,,0,0,0,,Қоңырау?
Dialogue: 0,0:05:31.15,0:05:34.41,Default,,0,0,0,,Бұл сіздің өткеніңізді білдіре ме? Мен түсінбеймін...
Dialogue: 0,0:05:47.74,0:05:49.60,Default,,0,0,0,,Қатты ойна және көп үйрен!
Dialogue: 0,0:05:49.79,0:05:52.95,Default,,0,0,0,,Оқудан кейінгі салқындық ерекше.
Dialogue: 0,0:05:53.40,0:05:55.11,Default,,0,0,0,,Сіз мұны істеген жоқсыз, солай емес пе?
Dialogue: 0,0:05:55.60,0:05:57.44,Default,,0,0,0,,Мен шу көтере алмаймын.
Dialogue: 0,0:06:14.05,0:06:16.25,Default,,0,0,0,,Иә, бәрі сапқа тұр!
Dialogue: 0,0:06:19.71,0:06:22.26,Default,,0,0,0,,Біз бәріміз осындамыз, сонда...
Dialogue: 0,0:06:22.29,0:06:24.93,Default,,0,0,0,,Жәй ғана спортзалға барып, баскетбол ойнайық.
Dialogue: 0,0:06:24.93,0:06:25.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:27.21,0:06:29.08,Default,,0,0,0,,Бірақ дымқыл болғаны жақсы...
Dialogue: 0,0:06:29.36,0:06:31.36,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:06:32.72,0:06:34.67,Default,,0,0,0,,Кимура мырза...
Dialogue: 0,0:06:34.98,0:06:35.64,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:36.77,0:06:37.13,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:06:37.16,0:06:39.62,Default,,0,0,0,,Спортзалға барар алдында купальникті бір рет пайдаланыңыз
Dialogue: 0,0:06:39.66,0:06:40.65,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:41.54,0:06:43.26,Default,,0,0,0,,Онда волейбол жақсырақ.
Dialogue: 0,0:06:43.81,0:06:49.08,Default,,0,0,0,,Су полосын ойнауға бола ма?
Dialogue: 0,0:06:57.70,0:07:00.02,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:07:03.45,0:07:06.07,Default,,0,0,0,,Кимура-сенсэйдің сабағы жақсы ма?
Dialogue: 0,0:07:06.74,0:07:09.02,Default,,0,0,0,,Мен Гото мырзаны өз орныма алуын өтіндім.
Dialogue: 0,0:07:10.38,0:07:11.68,Default,,0,0,0,,Бар болғаны...
Dialogue: 0,0:07:13.13,0:07:15.25,Default,,0,0,0,,Ал, мен экскурсияға қарсы емеспін.
Dialogue: 0,0:07:15.37,0:07:16.97,Default,,0,0,0,,Тыныш отырыңыз
Dialogue: 0,0:07:17.77,0:07:18.76,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:18.90,0:07:20.38,Default,,0,0,0,,Міне, бірінші күн.
Dialogue: 0,0:07:22.64,0:07:26.42,Default,,0,0,0,,Бірінші күні келуді жалғастыруды жоспарлайсыз ба?
Dialogue: 0,0:07:27.01,0:07:27.56,Default,,0,0,0,,Бір
Dialogue: 0,0:07:27.78,0:07:28.34,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:07:28.48,0:07:29.12,Default,,0,0,0,,...
Dialogue: 0,0:07:29.21,0:07:29.71,Default,,0,0,0,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:07:30.12,0:07:30.78,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:07:30.86,0:07:31.22,Default,,0,0,0,,Roku
Dialogue: 0,0:07:31.56,0:07:31.91,Default,,0,0,0,,Шичи
Dialogue: 0,0:07:32.22,0:07:32.65,Default,,0,0,0,,Бал
Dialogue: 0,0:07:32.96,0:07:33.51,Default,,0,0,0,,Бір
Dialogue: 0,0:07:33.74,0:07:34.30,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:07:34.44,0:07:35.07,Default,,0,0,0,,...
Dialogue: 0,0:07:35.16,0:07:35.66,Default,,0,0,0,,Сенімен танысқаныма қуаныштымын, Аня.
