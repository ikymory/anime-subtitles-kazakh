Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.83,0:00:07.30,Default,,0,0,0,,Лу Ла Лу Ла Пианино - әлемдік
Dialogue: 0,0:00:07.33,0:00:10.81,Default,,0,0,0,,Арман гүлдеген далада әуен
Dialogue: 0,0:00:10.84,0:00:14.27,Default,,0,0,0,,Сынған сағатқа сену
Dialogue: 0,0:00:14.30,0:00:17.73,Default,,0,0,0,,Уақыт сенің жаныңда кім?
Dialogue: 0,0:00:17.76,0:00:21.10,Default,,0,0,0,,Менің кеудем неге үлкен?
Dialogue: 0,0:00:21.31,0:00:24.72,Default,,0,0,0,,Сіз мейірімді адамды күтесіз бе?
Dialogue: 0,0:00:24.80,0:00:28.29,Default,,0,0,0,,Маған тамаша болашағыңыз туралы айтып беріңіз
Dialogue: 0,0:00:28.32,0:00:28.99,Default,,0,0,0,,Ай
Dialogue: 0,0:00:29.08,0:00:29.84,Default,,0,0,0,,Жарық
Dialogue: 0,0:00:29.96,0:00:31.70,Default,,0,0,0,,Ай сәулесі ұйықтап жатыр
Dialogue: 0,0:00:31.73,0:00:35.27,Default,,0,0,0,,Лу Ла Лу Ла Есте сақтау алмасына
Dialogue: 0,0:00:35.30,0:00:38.64,Default,,0,0,0,,Оянған қыз мені сүйеді
Dialogue: 0,0:00:38.68,0:00:42.19,Default,,0,0,0,,Азаппен жайылған кітапта
Dialogue: 0,0:00:42.22,0:00:45.46,Default,,0,0,0,,Екі қоңырау соғылады
Dialogue: 0,0:00:45.61,0:00:48.90,Default,,0,0,0,,Мен жақсы көретін адам, өйткені мен оны құшақтағым келеді
Dialogue: 0,0:00:49.14,0:00:52.67,Default,,0,0,0,,Енді жылама Қош бол қайғы
Dialogue: 0,0:00:52.69,0:00:56.17,Default,,0,0,0,,Жұмбақ есіктегі жазу
Dialogue: 0,0:00:56.20,0:00:59.61,Default,,0,0,0,,«Сорамими торты»
Dialogue: 0,0:00:59.63,0:01:00.94,Default,,0,0,0,,Ғажайыптар әлемі!
Dialogue: 0,0:01:00.97,0:01:02.69,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:02.72,0:01:04.01,Default,,0,0,0,,Ертегілер елі!
Dialogue: 0,0:01:04.04,0:01:05.68,Default,,0,0,0,,Бұл махаббаттың сиқыры
Dialogue: 0,0:01:05.71,0:01:07.02,Default,,0,0,0,,Махаббат бәрібір!
Dialogue: 0,0:01:07.05,0:01:08.80,Default,,0,0,0,,Күн сайын үлпілдек
Dialogue: 0,0:01:08.83,0:01:12.29,Default,,0,0,0,,Бидайдың азғыруы
Dialogue: 0,0:01:12.32,0:01:13.59,Default,,0,0,0,,Сізге арналған торт!
Dialogue: 0,0:01:13.62,0:01:15.32,Default,,0,0,0,,Бүгін кешке тамақтаныңыз.
Dialogue: 0,0:01:15.34,0:01:16.66,Default,,0,0,0,,Сізге шай!
Dialogue: 0,0:01:16.69,0:01:18.38,Default,,0,0,0,,Шоқжұлдыз шай ішу
Dialogue: 0,0:01:18.40,0:01:19.69,Default,,0,0,0,,Терезеде
Dialogue: 0,0:01:19.72,0:01:21.46,Default,,0,0,0,,Періштелер хоры
Dialogue: 0,0:01:21.49,0:01:24.87,Default,,0,0,0,,Құлағыңыз бос па?
Dialogue: 0,0:01:24.90,0:01:28.46,Default,,0,0,0,,Мен сені сүйемін, мен сені сүйемін дауыс
Dialogue: 0,0:01:46.28,0:01:48.24,Default,,0,0,0,,Азуманга үлкен
Dialogue: 0,0:01:57.24,0:01:59.63,Default,,0,0,0,,Ой! Бұл қазірдің өзінде ұзақ
Dialogue: 0,0:02:11.40,0:02:11.95,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:19.42,0:02:21.79,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:02:23.84,0:02:26.03,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:26.31,0:02:28.96,Default,,0,0,0,,Жоқ! Кеш, кеш!
Dialogue: 0,0:02:33.25,0:02:35.57,Default,,0,0,0,,Юкари-сенсэй, не болды?
Dialogue: 0,0:02:35.76,0:02:38.67,Default,,0,0,0,,Ой, мен қазірдің өзінде тітіркеніп кеттім.
Dialogue: 0,0:02:38.76,0:02:41.13,Default,,0,0,0,,Мектептің бірінші күнінен кешігіп қалсам ше?
Dialogue: 0,0:02:41.21,0:02:43.65,Default,,0,0,0,,Директордың ыңылдауы тағы да жалғасады.
Dialogue: 0,0:02:43.86,0:02:44.73,Default,,0,0,0,,Юкари Сенсей
Dialogue: 0,0:02:44.78,0:02:47.85,Default,,0,0,0,,Танизаки мырза, сіз неше рет кешіктіңіз?
Dialogue: 0,0:02:48.04,0:02:50.72,Default,,0,0,0,,Бұлай жалғаса берсе, мен оқушыларыма ештеңе көрсете алмаймын.
Dialogue: 0,0:02:51.02,0:02:53.59,Default,,0,0,0,,Бұл кез әр адамның сезімтал болатын кезі.
Dialogue: 0,0:02:53.63,0:02:55.85,Default,,0,0,0,,Сезімтал болудан не пайда?
Dialogue: 0,0:02:55.89,0:02:56.78,Default,,0,0,0,,Такумо!
Dialogue: 0,0:02:56.81,0:02:57.68,Default,,0,0,0,,Юкари Сенсей!
Dialogue: 0,0:02:57.70,0:03:00.62,Default,,0,0,0,,Ой, енді есіме түссе, ашуланып барады.
Dialogue: 0,0:03:00.85,0:03:03.37,Default,,0,0,0,,Қарғыс атсын, қарғыс атсын, қарғыс атсын!
Dialogue: 0,0:03:03.40,0:03:04.56,Default,,0,0,0,,Мугия
Dialogue: 0,0:03:08.89,0:03:09.96,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:03:10.76,0:03:12.86,Default,,0,0,0,,Мұғалім! Ол бұзылады
Dialogue: 0,0:03:13.47,0:03:16.75,Default,,0,0,0,,Сәлем, мұғалім! Мұғалім! мұғалім!
Dialogue: 0,0:03:17.85,0:03:18.83,Default,,0,0,0,,Не?
Dialogue: 0,0:03:18.85,0:03:20.94,Default,,0,0,0,,Шынжыр жаңа ғана үзілді, солай ма?
Dialogue: 0,0:03:21.16,0:03:22.76,Default,,0,0,0,,Бұл бірден орындалады
Dialogue: 0,0:03:22.93,0:03:24.24,Default,,0,0,0,,Эххе бақытты
Dialogue: 0,0:03:24.27,0:03:26.63,Default,,0,0,0,,Мұғаліммен бірге болсаңыз, кешігіп қалуға жол беріледі.
Dialogue: 0,0:03:27.88,0:03:29.85,Default,,0,0,0,,Әй, ұстаз, бүгінгі...
Dialogue: 0,0:03:31.33,0:03:34.85,Default,,0,0,0,,Ах! Менің велосипедім! !
Dialogue: 0,0:03:42.98,0:03:44.31,Default,,0,0,0,,Егер қаласаңыз, мен оны сіздің атыңыздан жеткізе аламын.
Dialogue: 0,0:03:45.02,0:03:46.14,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:03:46.16,0:03:49.04,Default,,0,0,0,,Енді тізбекті қараңыз.
Dialogue: 0,0:03:50.22,0:03:51.38,Default,,0,0,0,,Э? Бірақ Браун мырза әлі төменде жүр ғой, иә?
Dialogue: 0,0:03:51.99,0:03:54.41,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:03:56.59,0:03:57.70,Default,,0,0,0,,Уа!
Dialogue: 0,0:03:58.04,0:04:00.88,Default,,0,0,0,,Мен Танизакимін, 3-сыныптың сынып жетекшісімін!
Dialogue: 0,0:04:01.17,0:04:03.38,Default,,0,0,0,,Мен түсінбеген нәрсені сұрадың!
Dialogue: 0,0:04:03.93,0:04:05.24,Default,,0,0,0,,Сол мұғалім...
Dialogue: 0,0:04:05.45,0:04:08.33,Default,,0,0,0,,А, жоқ, жоқ! Мүмкін емес!
Dialogue: 0,0:04:09.29,0:04:12.10,Default,,0,0,0,,Үш өлшем - құпия!
Dialogue: 0,0:04:12.22,0:04:12.96,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:13.08,0:04:14.39,Default,,0,0,0,,Өйткені стиль жақсы емес
Dialogue: 0,0:04:14.41,0:04:16.62,Default,,0,0,0,,Айтуға ұялғаным емес.
Dialogue: 0,0:04:16.96,0:04:18.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:18.43,0:04:19.98,Default,,0,0,0,,Бұл өте үлкен мәселе, солай емес пе?
Dialogue: 0,0:04:20.00,0:04:22.34,Default,,0,0,0,,А, енді! Сіз не айтпақсыз?
Dialogue: 0,0:04:22.36,0:04:24.40,Default,,0,0,0,,Жоқ, кемпір!
Dialogue: 0,0:04:24.86,0:04:28.14,Default,,0,0,0,,Жоқ, анау мұғалімнің сыныбы көрші...
Dialogue: 0,0:04:29.55,0:04:30.81,Default,,0,0,0,,Бұл төрт топ...
Dialogue: 0,0:04:45.54,0:04:46.62,Default,,0,0,0,,Иә
Dialogue: 0,0:04:47.12,0:04:50.19,Default,,0,0,0,,Танизаки, мен бүгіннен бастап 3-сыныпқа жауаптымын.
Dialogue: 0,0:04:50.50,0:04:51.35,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:04:54.60,0:04:55.63,Default,,0,0,0,,Итатата
Dialogue: 0,0:04:56.15,0:04:57.90,Default,,0,0,0,,Иә
Dialogue: 0,0:04:59.15,0:05:00.28,Default,,0,0,0,,Бірден
Dialogue: 0,0:05:00.37,0:05:02.14,Default,,0,0,0,,Ауыстырушы студентті таныстыру
Dialogue: 0,0:05:02.66,0:05:04.31,Default,,0,0,0,,Бұл Михама Чио-чан.
Dialogue: 0,0:05:05.04,0:05:06.38,Default,,0,0,0,,Бұл Чио Михама.
Dialogue: 0,0:05:07.34,0:05:09.52,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:05:10.17,0:05:11.98,Default,,0,0,0,,Чио-чан 10 жаста
Dialogue: 0,0:05:12.11,0:05:13.61,Default,,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:05:13.63,0:05:15.69,Default,,0,0,0,,Мен орта мектепке ауыстым
Dialogue: 0,0:05:17.33,0:05:19.43,Default,,0,0,0,,Мен бала болсам да, оқи аламын.
Dialogue: 0,0:05:19.47,0:05:21.01,Default,,0,0,0,,Өтінемін, мені қорламаңыз
Dialogue: 0,0:05:23.60,0:05:24.86,Default,,0,0,0,,Чио-чан жекпе-жегі~!
Dialogue: 0,0:05:25.40,0:05:26.83,Default,,0,0,0,,Мен сені қолдаймын!
Dialogue: 0,0:05:27.67,0:05:28.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:35.16,0:05:36.81,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:05:36.95,0:05:38.67,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:05:38.69,0:05:42.07,Default,,0,0,0,,Енді не істей аламыз?
Dialogue: 0,0:05:42.65,0:05:44.61,Default,,0,0,0,,Иә! Орындалды!
Dialogue: 0,0:05:46.12,0:05:47.79,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:05:47.92,0:05:49.65,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:05:49.76,0:05:53.22,Default,,0,0,0,,Ал, біз не істей аламыз?
Dialogue: 0,0:05:53.62,0:05:55.60,Default,,0,0,0,,Иә! Орындалды!
Dialogue: 0,0:05:57.35,0:05:58.39,Default,,0,0,0,,Міне.
Dialogue: 0,0:05:58.50,0:06:01.10,Default,,0,0,0,,Бұл мүлдем пісірілмейді, солай ма?
Dialogue: 0,0:06:01.47,0:06:02.09,Default,,0,0,0,,Хэхе (lol)
Dialogue: 0,0:06:17.83,0:06:19.21,Default,,0,0,0,,Мүмкін, саған кішкене сабақ беруім керек шығар.
Dialogue: 0,0:06:22.40,0:06:23.86,Default,,0,0,0,,Арарахио-чан
Dialogue: 0,0:06:23.97,0:06:26.05,Default,,0,0,0,,Сіз маған бірден айтып жатырсыз, солай емес пе?
Dialogue: 0,0:06:26.21,0:06:29.36,Default,,0,0,0,,О, жақсы, тамаша фантастикалық
Dialogue: 0,0:06:30.18,0:06:33.15,Default,,0,0,0,,Түсінбейтін кез келген нәрсені әркімнен сұрауға болады.
Dialogue: 0,0:06:33.55,0:06:34.27,Default,,0,0,0,,Иә
Dialogue: 0,0:06:35.14,0:06:36.21,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:06:36.75,0:06:37.99,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:06:38.93,0:06:40.42,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:06:44.74,0:06:48.51,Default,,0,0,0,,Негізі оны үйреткен мен едім.
Dialogue: 0,0:06:48.89,0:06:51.61,Default,,0,0,0,,А, мен ақымақпын ба...?
Dialogue: 0,0:06:51.64,0:06:54.04,Default,,0,0,0,,Мм...біз сыныптаспыз...
Dialogue: 0,0:06:55.30,0:06:57.43,Default,,0,0,0,,Са бенто бенто~
Dialogue: 0,0:07:00.12,0:07:01.34,Default,,0,0,0,,Жылама, жылама
Dialogue: 0,0:07:01.78,0:07:04.60,Default,,0,0,0,,Чиёчан! Бірге түскі ас ішеміз бе?
Dialogue: 0,0:07:04.82,0:07:05.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:06.49,0:07:08.54,Default,,0,0,0,,Бастауыш мектеп түскі ас болды
Dialogue: 0,0:07:08.56,0:07:11.02,Default,,0,0,0,,Түскі ас қораптары көңілді.
Dialogue: 0,0:07:12.87,0:07:15.70,Default,,0,0,0,,Бірақ ерте тұрып, оған жету қиын.
Dialogue: 0,0:07:17.06,0:07:19.56,Default,,0,0,0,,Сонымен, сіз оны өзіңіз жасайсыз ба?
Dialogue: 0,0:07:20.89,0:07:22.62,Default,,0,0,0,,Түскі ас, спорт күндері және т.б.
Dialogue: 0,0:07:22.65,0:07:24.99,Default,,0,0,0,,Себебі бұл экскурсия кезіндегі Деби.
Dialogue: 0,0:07:28.77,0:07:31.42,Default,,0,0,0,,Бұл өте дәмді көрінеді.
Dialogue: 0,0:07:32.99,0:07:36.06,Default,,0,0,0,,Бұл жігіт мінсіз адам ба?!
Dialogue: 0,0:07:44.32,0:07:46.14,Default,,0,0,0,,Иә! Бұл Ниджубаши
Dialogue: 0,0:07:46.51,0:07:49.90,Default,,0,0,0,,Эй, Чио-чанның қолынан бәрі келеді.
Dialogue: 0,0:07:50.10,0:07:51.59,Default,,0,0,0,,Сіз жақсы емес нәрсе жоқ, солай ма?
Dialogue: 0,0:07:51.98,0:07:54.05,Default,,0,0,0,,Ондай нәрсе бар!
Dialogue: 0,0:07:54.32,0:07:55.72,Default,,0,0,0,,Спорттық костюмім мен кроссовкаларым мінсіз күйде, бір жыртығы да жоқ.
Dialogue: 0,0:07:56.11,0:07:58.61,Default,,0,0,0,,Ах! Тілді бұрмалауға шебер емеспін!
Dialogue: 0,0:07:58.92,0:08:00.30,Default,,0,0,0,,Тілді бұрау?
Dialogue: 0,0:08:00.46,0:08:01.48,Default,,0,0,0,,Мен жасап көремін!
Dialogue: 0,0:08:01.95,0:08:03.55,Default,,0,0,0,,автобус газ автобусы
Dialogue: 0,0:08:03.69,0:08:05.30,Default,,0,0,0,,Басгас Бакухаку
Dialogue: 0,0:08:05.45,0:08:07.77,Default,,0,0,0,,Гасбак хаку хаку!
Dialogue: 0,0:08:08.24,0:08:09.43,Default,,0,0,0,,Эхехе (lol)
Dialogue: 0,0:08:10.02,0:08:13.20,Default,,0,0,0,,Ой, сен сондай сүйкімдісің
Dialogue: 0,0:08:13.90,0:08:16.04,Default,,0,0,0,,Үй тапсырмасын орындамағандар
Dialogue: 0,0:08:16.06,0:08:17.02,Default,,0,0,0,,Қолыңызды көтеріңіз!
Dialogue: 0,0:08:17.33,0:08:19.98,Default,,0,0,0,,(Бұл сен бе? Жоқ)
Dialogue: 0,0:08:26.17,0:08:28.53,Default,,0,0,0,,Бүгінгі күн үшін кешірім сұраймын, балалар!
Dialogue: 0,0:08:28.77,0:08:30.52,Default,,0,0,0,,Жарайды, алға!
Dialogue: 0,0:08:39.09,0:08:41.23,Default,,0,0,0,,Мұны қазірден бастап дұрыс орындаңыз!
Dialogue: 0,0:08:41.40,0:08:41.91,Default,,0,0,0,,Иә
Dialogue: 0,0:08:52.21,0:08:52.97,Default,,0,0,0,,Ум...
Dialogue: 0,0:08:53.15,0:08:54.86,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:08:54.96,0:08:56.72,Default,,0,0,0,,Мен сәл салақ болдым...
Dialogue: 0,0:08:57.21,0:09:00.14,Default,,0,0,0,,Мен мұны істеуді ойладым!
Dialogue: 0,0:09:01.51,0:09:03.88,Default,,0,0,0,,Мен ұмытып қалдым.
Dialogue: 0,0:09:10.76,0:09:12.48,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:09:12.63,0:09:14.38,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:09:14.45,0:09:18.08,Default,,0,0,0,,Енді не істей аламыз?
Dialogue: 0,0:09:18.34,0:09:20.56,Default,,0,0,0,,Иә! Орындалды!
Dialogue: 0,0:09:21.60,0:09:23.32,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:09:23.45,0:09:25.19,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:09:25.25,0:09:28.65,Default,,0,0,0,,Енді не істей аламыз?
Dialogue: 0,0:09:29.35,0:09:31.60,Default,,0,0,0,,Иә! Орындалды!
Dialogue: 0,0:09:33.24,0:09:34.85,Default,,0,0,0,,Бұл жолы сәттілік!
Dialogue: 0,0:09:35.33,0:09:37.12,Default,,0,0,0,,Жүр, бәріміз тамақтанайық.
Dialogue: 0,0:09:37.22,0:09:40.08,Default,,0,0,0,,Ой! Оны әлі жеме!
Dialogue: 0,0:09:44.31,0:09:45.09,Default,,0,0,0,,Ум...
Dialogue: 0,0:09:45.12,0:09:48.11,Default,,0,0,0,,Сіз мансап таңдауыңызға қатысты сауалнаманы жібердіңіз бе?
Dialogue: 0,0:09:48.49,0:09:50.94,Default,,0,0,0,,Ой, кешіріңіз, күте тұрыңыз.
Dialogue: 0,0:09:51.07,0:09:51.61,Default,,0,0,0,,Иә
Dialogue: 0,0:09:52.29,0:09:55.37,Default,,0,0,0,,Мен сіздің мансап таңдау сауалнамасын жинауға келдім.
Dialogue: 0,0:09:55.39,0:09:56.97,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:09:57.26,0:09:58.73,Default,,0,0,0,,Кейінірек
Dialogue: 0,0:10:02.84,0:10:03.70,Default,,0,0,0,,Ум...
Dialogue: 0,0:10:03.78,0:10:04.43,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:04.98,0:10:05.66,Default,,0,0,0,,Бұл
Dialogue: 0,0:10:05.73,0:10:08.71,Default,,0,0,0,,Мен мансап жолым үшін құжаттарды жинап жатырмын...
Dialogue: 0,0:10:08.77,0:10:09.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:11.01,0:10:12.49,Default,,0,0,0,,Иә, рахмет.
Dialogue: 0,0:10:13.06,0:10:15.37,Default,,0,0,0,,Қорқынышты көрінетін адам.
Dialogue: 0,0:10:19.97,0:10:24.66,Default,,0,0,0,,Ветеринар, гүл сатушы, тұлып сатушы
Dialogue: 0,0:10:28.97,0:10:30.62,Default,,0,0,0,,Ол жақсы адам болуы мүмкін...
Dialogue: 0,0:10:32.18,0:10:32.98,Default,,0,0,0,,Нене
Dialogue: 0,0:10:33.21,0:10:34.94,Default,,0,0,0,,Сакаки-сан керемет, солай ма?
Dialogue: 0,0:10:35.32,0:10:36.53,Default,,0,0,0,,Иә, иә, ең жақсы!
Dialogue: 0,0:10:36.55,0:10:39.11,Default,,0,0,0,,Ол жігіттерден әлдеқайда жақсы!
Dialogue: 0,0:10:39.46,0:10:40.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:40.66,0:10:42.89,Default,,0,0,0,,Маған да сенің тыныш жүргенің ұнайды.
Dialogue: 0,0:10:48.51,0:10:50.29,Default,,0,0,0,,Иә? не болды?
Dialogue: 0,0:10:51.26,0:10:52.22,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:54.49,0:10:56.89,Default,,0,0,0,,Енді бірдеңе...
Dialogue: 0,0:10:57.30,0:11:00.01,Default,,0,0,0,,Мен шынымен сүйкімді нәрсе көргендей болдым...
Dialogue: 0,0:11:02.65,0:11:03.47,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:11:03.80,0:11:04.57,Default,,0,0,0,,Сакаки мырза
Dialogue: 0,0:11:04.72,0:11:05.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:06.08,0:11:07.05,Default,,0,0,0,,Сакаки-сан деген кім?
Dialogue: 0,0:11:07.08,0:11:08.80,Default,,0,0,0,,Сіз бір жерде клубтасыз ба?
Dialogue: 0,0:11:09.40,0:11:11.36,Default,,0,0,0,,Жоқ... ол қосылмаған...
Dialogue: 0,0:11:13.07,0:11:14.03,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:14.05,0:11:16.61,Default,,0,0,0,,Мен астрономия үйірмесіне қатысамын...
Dialogue: 0,0:11:17.14,0:11:17.93,Default,,0,0,0,,Астрономия үйірмесі?
Dialogue: 0,0:11:18.07,0:11:19.59,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:11:19.84,0:11:21.51,Default,,0,0,0,,Жұлдыздарды зерттеу
Dialogue: 0,0:11:21.69,0:11:23.53,Default,,0,0,0,,Ғарыш туралы әңгімелеу
Dialogue: 0,0:11:23.84,0:11:25.97,Default,,0,0,0,,Мен жұлдыздарды қарауға шығамын.
Dialogue: 0,0:11:26.41,0:11:27.50,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:27.52,0:11:29.83,Default,,0,0,0,,Қарсы болмасаң... Сакаки-сан да...
Dialogue: 0,0:11:30.44,0:11:31.38,Default,,0,0,0,,Мен де?
Dialogue: 0,0:11:31.58,0:11:32.73,Default,,0,0,0,,Ах! үй!
Dialogue: 0,0:11:32.91,0:11:35.61,Default,,0,0,0,,Әсіресе Сакаки-сан ондай нәрсеге қызықпаса.
Dialogue: 0,0:11:35.64,0:11:36.71,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:36.99,0:11:39.45,Default,,0,0,0,,Мм... менің айтқанымды елемеңізші!
Dialogue: 0,0:11:39.99,0:11:40.76,Default,,0,0,0,,Секір!!
Dialogue: 0,0:11:47.64,0:11:49.66,Default,,0,0,0,,Мені шақыруыңды қаладым...
Dialogue: 0,0:12:21.32,0:12:21.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:25.46,0:12:26.19,Default,,0,0,0,,мысық
Dialogue: 0,0:12:54.32,0:12:55.48,Default,,0,0,0,,Сакаки мырза...
Dialogue: 0,0:12:56.50,0:12:57.60,Default,,0,0,0,,Сакаки мырза!
Dialogue: 0,0:12:57.71,0:12:58.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:58.68,0:13:00.86,Default,,0,0,0,,Сен мұнымен не істедің?
Dialogue: 0,0:13:01.48,0:13:02.91,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:13:07.25,0:13:09.86,Default,,0,0,0,,Менің көңіл-күйім нашар болды...
Dialogue: 0,0:13:10.59,0:13:12.90,Default,,0,0,0,,Сіз төбелесіп қалдыңыз ба? …
Dialogue: 0,0:13:17.03,0:13:18.59,Default,,0,0,0,,Осы жерде шығар
Dialogue: 0,0:13:19.66,0:13:21.18,Default,,0,0,0,,Бүгін таңғы мысық!
Dialogue: 0,0:13:23.44,0:13:24.69,Default,,0,0,0,,Мияу
Dialogue: 0,0:13:25.59,0:13:27.79,Default,,0,0,0,,Аа, міне, осында.
Dialogue: 0,0:13:27.88,0:13:29.01,Default,,0,0,0,,Мияу
Dialogue: 0,0:13:33.83,0:13:35.78,Default,,0,0,0,,Бұл жолы көңіл-күйіңіз жақсы сияқты
Dialogue: 0,0:13:45.33,0:13:46.82,Default,,0,0,0,,Мен Сатоси Такино!
Dialogue: 0,0:13:47.07,0:13:48.83,Default,,0,0,0,,Тек менің энергиям ешкімнен кем емес
Dialogue: 0,0:13:48.98,0:13:51.22,Default,,0,0,0,,Қашқын мектеп оқушысы!
Dialogue: 0,0:13:53.65,0:13:55.02,Default,,0,0,0,,Баршаңызға қайырлы таң!
Dialogue: 0,0:13:56.16,0:13:57.74,Default,,0,0,0,,Юкари-чан қазірдің өзінде осында
Dialogue: 0,0:13:57.86,0:13:59.59,Default,,0,0,0,,Бұл кешігіп қалдың дегенді білдіре ме?
Dialogue: 0,0:13:59.68,0:14:01.39,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:01.71,0:14:03.78,Default,,0,0,0,,Мұғалім! кешіккені үшін жаза ретінде
Dialogue: 0,0:14:03.80,0:14:04.99,Default,,0,0,0,,Мен дәлізде тұрамын!
Dialogue: 0,0:14:07.46,0:14:08.85,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:14:14.54,0:14:16.98,Default,,0,0,0,,Мен оны бір рет көргім келді! Бұл
Dialogue: 0,0:14:17.45,0:14:19.22,Default,,0,0,0,,Дәлізде тұруға мәжбүрлеу
Dialogue: 0,0:14:19.24,0:14:21.55,Default,,0,0,0,,Мұндай кезде сирек кездеседі.
Dialogue: 0,0:14:21.67,0:14:23.56,Default,,0,0,0,,Жақсы! Мұнда жазба жасаңыз
Dialogue: 0,0:14:23.58,0:14:25.32,Default,,0,0,0,,Мен барлығын таң қалдырамын
Dialogue: 0,0:14:29.09,0:14:30.62,Default,,0,0,0,,Оңай жеңіс! Жеңіл жеңіс!
Dialogue: 0,0:14:33.41,0:14:34.33,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:14:35.64,0:14:37.32,Default,,0,0,0,,Ку~ Келді, келді
Dialogue: 0,0:14:37.39,0:14:39.68,Default,,0,0,0,,Бұл жазалау сияқты.
Dialogue: 0,0:14:41.14,0:14:44.67,Default,,0,0,0,,Куах~ Жоғалтасың ба~?
Dialogue: 0,0:14:46.78,0:14:48.57,Default,,0,0,0,,Сіз өте жақсы істеп жатырсыз, солай емес пе?
Dialogue: 0,0:14:48.72,0:14:50.07,Default,,0,0,0,,Иә? Сенің атың кім?
Dialogue: 0,0:14:50.42,0:14:52.14,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:14:52.57,0:14:55.21,Default,,0,0,0,,Қарғыс атсын, есіңде болсын!
Dialogue: 0,0:14:59.70,0:15:02.67,Default,,0,0,0,,＃
Dialogue: 0,0:15:03.54,0:15:05.39,Default,,0,0,0,,Қазірдің өзінде тым шулы~
Dialogue: 0,0:15:05.81,0:15:07.50,Default,,0,0,0,,Джанчакачан!
Dialogue: 0,0:15:07.93,0:15:10.06,Default,,0,0,0,,Чио-чанды оқуға шақырыңыз!
Dialogue: 0,0:15:12.69,0:15:14.07,Default,,0,0,0,,Бұл мүмкін емес деп ойлаймын.
Dialogue: 0,0:15:14.41,0:15:15.11,Default,,0,0,0,,Міне
Dialogue: 0,0:15:15.40,0:15:16.89,Default,,0,0,0,,Чио-чанды түсінесің бе?
Dialogue: 0,0:15:17.09,0:15:18.73,Default,,0,0,0,,Ah, um...
Dialogue: 0,0:15:18.95,0:15:19.77,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:15:19.83,0:15:20.47,Default,,0,0,0,,Уа!
Dialogue: 0,0:15:20.77,0:15:21.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:21.83,0:15:23.00,Default,,0,0,0,,Олай болса, Такино мырза.
Dialogue: 0,0:15:23.02,0:15:24.49,Default,,0,0,0,,Мен де білмеймін!
Dialogue: 0,0:15:25.96,0:15:28.48,Default,,0,0,0,,Чио-Чан - тең ойын! Алақай!
Dialogue: 0,0:15:31.19,0:15:32.23,Default,,0,0,0,,Жарайды, күндіз!
Dialogue: 0,0:15:32.34,0:15:34.80,Default,,0,0,0,,Бүгін нан! Нан жасайық!
Dialogue: 0,0:15:35.41,0:15:36.99,Default,,0,0,0,,Ал, мен нан сатып алайын.
Dialogue: 0,0:15:37.53,0:15:38.35,Default,,0,0,0,,Мен де!
Dialogue: 0,0:15:38.77,0:15:39.68,Default,,0,0,0,,Менікі де
Dialogue: 0,0:15:39.98,0:15:41.04,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:15:42.01,0:15:44.30,Default,,0,0,0,,Осындай кезде сіз оған сене аласыз, солай ма?
Dialogue: 0,0:15:44.59,0:15:45.51,Default,,0,0,0,,Шынымен, шынымен!
Dialogue: 0,0:15:45.71,0:15:47.14,Default,,0,0,0,,Эхехе (lol)
Dialogue: 0,0:15:49.22,0:15:50.35,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:15:50.95,0:15:52.71,Default,,0,0,0,,Сіз оны сатып алдыңыз ба?
Dialogue: 0,0:15:52.97,0:15:54.26,Default,,0,0,0,,Керемет жылдамдық
Dialogue: 0,0:15:54.81,0:15:56.13,Default,,0,0,0,,уақыт нешеге тең?
Dialogue: 0,0:15:56.66,0:15:57.56,Default,,0,0,0,,Оны өлшемеңіз.
Dialogue: 0,0:15:57.89,0:15:59.77,Default,,0,0,0,,Джанчакачан!
Dialogue: 0,0:16:00.14,0:16:01.86,Default,,0,0,0,,Екінші сынақ сериясы!
Dialogue: 0,0:16:02.25,0:16:04.37,Default,,0,0,0,,Сакаки мырзаны PE бойынша шақыру
Dialogue: 0,0:16:04.83,0:16:05.97,Default,,0,0,0,,Қатар дегеніміз не?
Dialogue: 0,0:16:06.92,0:16:08.66,Default,,0,0,0,,100 метрге жүгіруде жарысыңыз
Dialogue: 0,0:16:08.84,0:16:09.73,Default,,0,0,0,,Сакаки мырза
Dialogue: 0,0:16:10.02,0:16:12.36,Default,,0,0,0,,Сәттілік, Сакаки-сан!
Dialogue: 0,0:16:12.64,0:16:15.04,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:16:15.75,0:16:17.38,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:16:17.82,0:16:18.38,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:19.19,0:16:20.87,Default,,0,0,0,,Сакаки-санға шақыру...
Dialogue: 0,0:16:21.25,0:16:23.54,Default,,0,0,0,,Сакаки-сан өте спортшы.
Dialogue: 0,0:16:24.16,0:16:25.57,Default,,0,0,0,,Томо-чан туралы бірдеңе
Dialogue: 0,0:16:25.59,0:16:27.72,Default,,0,0,0,,Құпия жоспар немесе жеңіске жету мүмкіндігі бар емес пе?
Dialogue: 0,0:16:28.11,0:16:30.09,Default,,0,0,0,,Жоқ, мен ештеңе жоқ деп ойлаймын.
Dialogue: 0,0:16:31.99,0:16:34.04,Default,,0,0,0,,Орналасқан жері туралы Жақсы!
Dialogue: 0,0:16:34.06,0:16:35.44,Default,,0,0,0,,Өтінемін, алғаш ретімді маған берші— Мен бұрын қыздың қолын да ұстаған емеспін.
Dialogue: 0,0:16:35.52,0:16:36.40,Default,,0,0,0,,Сакаки мырза
Dialogue: 0,0:16:36.49,0:16:38.46,Default,,0,0,0,,Өйткені сенің кеудең менен 8 см үлкен.
Dialogue: 0,0:16:38.48,0:16:39.98,Default,,0,0,0,,8 сантиметр төмен түсіңіз.
Dialogue: 0,0:16:42.36,0:16:44.68,Default,,0,0,0,,Бұл не?! Ол лас!
Dialogue: 0,0:16:45.17,0:16:46.44,Default,,0,0,0,,8 см…
Dialogue: 0,0:16:46.47,0:16:49.23,Default,,0,0,0,,Олай болса, бұл жолы барайық!
Dialogue: 0,0:16:49.30,0:16:50.65,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:16:50.76,0:16:51.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:51.96,0:16:52.62,Default,,0,0,0,,Жүгіру!
Dialogue: 0,0:16:55.80,0:16:57.32,Default,,0,0,0,,Томо-чан алға шықты!
Dialogue: 0,0:16:57.54,0:16:58.70,Default,,0,0,0,,Бұл тек уақыт мәселесі
Dialogue: 0,0:17:01.75,0:17:03.56,Default,,0,0,0,,Шүкір, жеңілеміз бе?!
Dialogue: 0,0:17:10.32,0:17:11.00,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:17:11.35,0:17:13.54,Default,,0,0,0,,Сакаки-сан жеңеді!
Dialogue: 0,0:17:20.19,0:17:21.29,Default,,0,0,0,,Сакаки-сан!
Dialogue: 0,0:17:21.64,0:17:22.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:23.09,0:17:24.93,Default,,0,0,0,,Сакаки-сан керемет!
Dialogue: 0,0:17:25.42,0:17:25.95,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:26.08,0:17:26.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:26.66,0:17:27.16,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:31.18,0:17:32.78,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:17:32.93,0:17:34.06,Default,,0,0,0,,Толық жеңілу.
Dialogue: 0,0:17:34.43,0:17:36.19,Default,,0,0,0,,Екінші орын!
Dialogue: 0,0:17:36.25,0:17:38.23,Default,,0,0,0,,Мен жеңілген жоқпын, екінші орын алдым!
Dialogue: 0,0:17:38.35,0:17:38.79,Default,,0,0,0,,квази
Dialogue: 0,0:17:38.90,0:17:39.30,Default,,0,0,0,,Ю
Dialogue: 0,0:17:39.35,0:17:41.30,Default,,0,0,0,,Жеңіс~Ах!
Dialogue: 0,0:17:41.53,0:17:42.31,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:42.44,0:17:43.55,Default,,0,0,0,,Түсіндім, үйге қайтайық!
Dialogue: 0,0:17:43.68,0:17:44.99,Default,,0,0,0,,Екінші орын!
Dialogue: 0,0:17:45.02,0:17:45.85,Default,,0,0,0,,Ұсталу аяқталды.
Dialogue: 0,0:17:45.97,0:17:47.82,Default,,0,0,0,,Содан кейін 2 саны~
Dialogue: 0,0:17:47.98,0:17:48.58,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:17:50.45,0:17:52.95,Default,,0,0,0,,Негізі, мен бүгін сабақты бастаймын.
Dialogue: 0,0:17:52.98,0:17:54.17,Default,,0,0,0,,Ауыстырушы студент келе жатыр.
Dialogue: 0,0:17:55.91,0:17:59.08,Default,,0,0,0,,Бұл жолы жаңа күш Осакадан!
Dialogue: 0,0:17:59.51,0:18:01.65,Default,,0,0,0,,Мен оны алуда біраз қиындық көрдім.
Dialogue: 0,0:18:03.80,0:18:04.67,Default,,0,0,0,,Осака тұрғындары
Dialogue: 0,0:18:05.10,0:18:06.24,Default,,0,0,0,,Осака туралы айту
Dialogue: 0,0:18:10.20,0:18:12.11,Default,,0,0,0,,Қарсылас пайда болады!
Dialogue: 0,0:18:12.72,0:18:15.66,Default,,0,0,0,,Мен оның керемет Цуккомимен жабдықталғанына сенімдімін!
Dialogue: 0,0:18:16.22,0:18:18.70,Default,,0,0,0,,Күнтізбе «Неге?» деп сұрап көріңіз!
Dialogue: 0,0:18:18.99,0:18:19.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:20.08,0:18:20.77,Default,,0,0,0,,Sa!
Dialogue: 0,0:18:21.21,0:18:22.01,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:28.60,0:18:32.00,Default,,0,0,0,,Менің ойымша, оны осындай жарқыраған қабылдаған дұрыс па?
Dialogue: 0,0:18:32.47,0:18:33.69,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:34.87,0:18:37.50,Default,,0,0,0,,Олай болса, парта жинақы екен.
Dialogue: 0,0:18:37.59,0:18:39.27,Default,,0,0,0,,Мен оны жақында таныстырамын.
Dialogue: 0,0:18:39.90,0:18:40.85,Default,,0,0,0,,Касуга-сан
Dialogue: 0,0:18:51.85,0:18:53.47,Default,,0,0,0,,Енді өзіңізді таныстырыңыз.
Dialogue: 0,0:18:53.91,0:18:54.47,Default,,0,0,0,,Иә
Dialogue: 0,0:18:55.50,0:18:56.88,Default,,0,0,0,,Мен Осакадан келдім.
Dialogue: 0,0:18:56.92,0:18:58.70,Default,,0,0,0,,Менің атым Аюму Касуга.
Dialogue: 0,0:18:59.13,0:19:00.89,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:19:01.05,0:19:02.34,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:19:02.50,0:19:03.83,Default,,0,0,0,,Сақ болыңыз
Dialogue: 0,0:19:03.86,0:19:06.05,Default,,0,0,0,,Қалыпты тілде сөйлеудің қажеті жоқ
Dialogue: 0,0:19:06.19,0:19:06.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:07.00,0:19:09.30,Default,,0,0,0,,Өтінемін, маған жалынба!
Dialogue: 0,0:19:09.46,0:19:11.77,Default,,0,0,0,,Тіпті Осакада...
Dialogue: 0,0:19:11.87,0:19:12.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:14.84,0:19:16.96,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:19:18.32,0:19:19.99,Default,,0,0,0,,Осакадағы адамдар
Dialogue: 0,0:19:20.22,0:19:23.32,Default,,0,0,0,,Жарық қызыл жанған кезде де жаяу жүргіншілер өткелінен өтуге болатыны рас па?
Dialogue: 0,0:19:24.13,0:19:25.34,Default,,0,0,0,,Біз не істеуіміз керек? …
Dialogue: 0,0:19:25.60,0:19:27.23,Default,,0,0,0,,Мен өтпеймін
Dialogue: 0,0:19:27.56,0:19:29.98,Default,,0,0,0,,Мен тым бос емес болғанды ұнатпаймын.
Dialogue: 0,0:19:30.14,0:19:31.26,Default,,0,0,0,,Касуга-сан деген кім?
Dialogue: 0,0:19:31.29,0:19:33.48,Default,,0,0,0,,Мен өзімді Осака адамы сияқты сезінбеймін.
Dialogue: 0,0:19:34.00,0:19:36.27,Default,,0,0,0,,Мен шулырақ біреуді елестеттім.
Dialogue: 0,0:19:36.65,0:19:39.91,Default,,0,0,0,,Осака тұрғындарының бәрі шулы емес.
Dialogue: 0,0:19:39.94,0:19:41.30,Default,,0,0,0,,Жалған!
Dialogue: 0,0:19:42.00,0:19:42.80,Default,,0,0,0,,Жалған?
Dialogue: 0,0:19:43.34,0:19:44.67,Default,,0,0,0,,Мен жалғанмын ба?
Dialogue: 0,0:19:45.31,0:19:47.08,Default,,0,0,0,,Адамдар оны жалған десе де
Dialogue: 0,0:19:47.42,0:19:49.03,Default,,0,0,0,,Олай болса түскі асыңды көрсет!
Dialogue: 0,0:19:49.23,0:19:50.99,Default,,0,0,0,,Оны көргенде анық көрінеді
Dialogue: 0,0:19:51.46,0:19:54.92,Default,,0,0,0,,Осакандардың түскі ас қораптарында такояки болуы керек.
Dialogue: 0,0:19:55.37,0:19:58.82,Default,,0,0,0,,Не? Бұл Осака болғандықтан.
Dialogue: 0,0:19:59.60,0:20:00.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:02.74,0:20:03.82,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:04.26,0:20:07.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:07.81,0:20:10.87,Default,,0,0,0,,Жұмысты аяқтай алмай бос емес едім
Dialogue: 0,0:20:11.16,0:20:13.78,Default,,0,0,0,,Мен Осакада болғанда
Dialogue: 0,0:20:13.87,0:20:16.69,Default,,0,0,0,,Маған жиі айтатын, мені аңдыған.
Dialogue: 0,0:20:16.96,0:20:19.56,Default,,0,0,0,,Бірақ мектептерді ауыстыру мүмкіндігін пайдаланып
Dialogue: 0,0:20:19.58,0:20:22.29,Default,,0,0,0,,Менің ойымша, күшті болу маңызды.
Dialogue: 0,0:20:22.56,0:20:25.01,Default,,0,0,0,,Мықты, берік, нық...
Dialogue: 0,0:20:25.14,0:20:26.41,Default,,0,0,0,,Касуга мырза
Dialogue: 0,0:20:26.43,0:20:27.79,Default,,0,0,0,,Мықты, берік...
Dialogue: 0,0:20:27.83,0:20:28.85,Default,,0,0,0,,Касуга-сан!
Dialogue: 0,0:20:29.63,0:20:31.73,Default,,0,0,0,,Касуга-сан, сен мұны естідің бе?
Dialogue: 0,0:20:32.08,0:20:33.65,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:34.00,0:20:36.43,Default,,0,0,0,,Қазір жақсы болыңыз.
Dialogue: 0,0:20:36.85,0:20:38.42,Default,,0,0,0,,Ояма-кун!
Dialogue: 0,0:20:38.61,0:20:39.03,Default,,0,0,0,,Иә
Dialogue: 0,0:20:39.40,0:20:43.05,Default,,0,0,0,,Мықты, берік, нық...
Dialogue: 0,0:20:44.61,0:20:46.46,Default,,0,0,0,,О, бітті ме?
Dialogue: 0,0:20:47.13,0:20:48.81,Default,,0,0,0,,Мұғалім үшін бүгін бітті.
Dialogue: 0,0:20:49.00,0:20:50.64,Default,,0,0,0,,Онья Адиос!
Dialogue: 0,0:20:51.03,0:20:52.56,Default,,0,0,0,,(Жарайды! Бұл аяқталды!)
Dialogue: 0,0:20:52.69,0:20:54.26,Default,,0,0,0,,Бұл аяқталды
Dialogue: 0,0:20:54.78,0:20:56.63,Default,,0,0,0,,Ертеңнен бастап жақсы болайық
Dialogue: 0,0:20:56.94,0:20:58.88,Default,,0,0,0,,Мықты, берік...
Dialogue: 0,0:20:58.99,0:21:00.09,Default,,0,0,0,,Осака Осака!
Dialogue: 0,0:21:00.50,0:21:00.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:01.48,0:21:02.59,Default,,0,0,0,,Сәлем Осака
Dialogue: 0,0:21:02.62,0:21:05.23,Default,,0,0,0,,Окономияки тағамы шынымен бар ма?
Dialogue: 0,0:21:05.58,0:21:07.04,Default,,0,0,0,,Не? Осака?
Dialogue: 0,0:21:07.26,0:21:10.30,Default,,0,0,0,,Иә! Қансайдың адамдары өте әртүрлі!
Dialogue: 0,0:21:10.55,0:21:13.41,Default,,0,0,0,,Окономияки мен күрішті бірге жеу!
Dialogue: 0,0:21:14.06,0:21:15.67,Default,,0,0,0,,Осакада да солай ма?
Dialogue: 0,0:21:16.05,0:21:18.12,Default,,0,0,0,,Осака? Мен ше?
Dialogue: 0,0:21:18.20,0:21:20.18,Default,,0,0,0,,Иә! сіздің лақап атыңыз
Dialogue: 0,0:21:20.20,0:21:22.17,Default,,0,0,0,,Осака, өйткені мен Осакаданмын!
Dialogue: 0,0:21:22.34,0:21:25.58,Default,,0,0,0,,Не? О, бұл өте оңай.
Dialogue: 0,0:21:25.84,0:21:29.54,Default,,0,0,0,,Барлығы түсінді ме? Касуга-сан бүгіннен бастап Осакада!
Dialogue: 0,0:21:29.70,0:21:30.38,Default,,0,0,0,,А?!
Dialogue: 0,0:21:30.56,0:21:31.80,Default,,0,0,0,,А, жарайды.
Dialogue: 0,0:21:32.09,0:21:32.83,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:33.43,0:21:35.60,Default,,0,0,0,,Иә, түсіндім!
Dialogue: 0,0:21:36.04,0:21:36.85,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:21:38.16,0:21:41.24,Default,,0,0,0,,Сонымен, сіз Осакаға баруды шештіңіз!
Dialogue: 0,0:21:41.67,0:21:43.47,Default,,0,0,0,,Әрқашан қолдау көрсеткеніңіз үшін рахмет!
Dialogue: 0,0:21:43.75,0:21:48.12,Default,,0,0,0,,Білмей тұрып лақап атым Осака болып қалды.
Dialogue: 0,0:21:48.79,0:21:50.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:59.18,0:22:01.74,Default,,0,0,0,,Жүрегіңде қанат қағып
Dialogue: 0,0:22:03.36,0:22:06.46,Default,,0,0,0,,Жүрегіңдегі сыбырды айт
Dialogue: 0,0:22:07.61,0:22:10.29,Default,,0,0,0,,Енді желде
Dialogue: 0,0:22:13.95,0:22:16.51,Default,,0,0,0,,Жүрек жұлдыздардан тыс
Dialogue: 0,0:22:18.18,0:22:21.32,Default,,0,0,0,,Тілектер әрқашан орындалады
Dialogue: 0,0:22:22.39,0:22:30.00,Default,,0,0,0,,Кел мені көр, Кілт – болашақ
Dialogue: 0,0:22:31.13,0:22:35.28,Default,,0,0,0,,Терезеге ақырын шақырған дауыс
Dialogue: 0,0:22:35.38,0:22:39.12,Default,,0,0,0,,Махаббатты алдын ала ескерту және
Dialogue: 0,0:22:39.68,0:22:43.32,Default,,0,0,0,,Махаббат әлі алыс болса да
Dialogue: 0,0:22:43.62,0:22:45.60,Default,,0,0,0,,Мен ертеңге сенемін
Dialogue: 0,0:22:45.63,0:22:47.64,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:22:47.76,0:22:49.61,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:49.65,0:22:55.10,Default,,0,0,0,,Жалғыз болмаймын деп уәде бердің, аспан
Dialogue: 0,0:22:56.24,0:22:58.05,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:58.12,0:22:59.78,Default,,0,0,0,,Тәтті көз жас
Dialogue: 0,0:23:00.18,0:23:04.51,Default,,0,0,0,,Жұмақта тағы да күлімде
Dialogue: 0,0:23:04.74,0:23:06.49,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:23:06.57,0:23:12.05,Default,,0,0,0,,Мен сені нәзік армандар аспанына алып кетуге келдім
Dialogue: 0,0:23:13.20,0:23:16.86,Default,,0,0,0,,Таңқурай аспаны мен саған қайтып келемін
Dialogue: 0,0:23:17.16,0:23:21.48,Default,,0,0,0,,Жұмақ гүлі жайқалған күні
Dialogue: 0,0:23:21.61,0:23:23.58,Default,,0,0,0,,Сіз және мен...
Dialogue: 0,0:23:24.19,0:23:28.46,Default,,0,0,0,,Бірге кездесейік
Dialogue: 0,0:23:33.51,0:23:35.92,Default,,0,0,0,,Бұл Азуманга Дайо ма?
Dialogue: 0,0:23:35.95,0:23:37.24,Default,,0,0,0,,Бұл не? Икенари
Dialogue: 0,0:23:37.30,0:23:39.48,Default,,0,0,0,,Ханзада Азуманга қайда?
Dialogue: 0,0:23:39.60,0:23:41.66,Default,,0,0,0,,Ханзада патшаның баласы, солай ма?
Dialogue: 0,0:23:41.94,0:23:44.22,Default,,0,0,0,,Сонымен бұған дейін не таратылды?
Dialogue: 0,0:23:44.27,0:23:45.95,Default,,0,0,0,,Бұл кейінгі бағдарлама емес пе?
Dialogue: 0,0:23:46.06,0:23:49.14,Default,,0,0,0,,Әу бастан Ұлы Патша болғаны қызық.
Dialogue: 0,0:23:49.26,0:23:51.72,Default,,0,0,0,,Иә, кінәлі осында.
Dialogue: 0,0:23:52.00,0:23:52.86,Default,,0,0,0,,Кінәлі кім?
Dialogue: 0,0:23:53.04,0:23:55.64,Default,,0,0,0,,Бұл алдын ала қарау - Азуманга Оудзи!
Dialogue: 0,0:23:56.17,0:23:57.97,Default,,0,0,0,,Ой, ой
Dialogue: 0,0:23:59.47,0:24:05.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory