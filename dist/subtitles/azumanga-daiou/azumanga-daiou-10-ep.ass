Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.02,0:01:32.35,Default,,0000,0000,0000,,Міне, үшінші семестр аяқталды!
Dialogue: 0,0:01:32.35,0:01:34.36,Default,,0000,0000,0000,,Қазір бәрі екінші курс студенті болғаны жақсы!
Dialogue: 0,0:01:34.36,0:01:37.53,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:01:37.53,0:01:41.70,Default,,0000,0000,0000,,Тұрыңыз ~ Сақ болыңыз және рахмет!
Dialogue: 0,0:01:41.70,0:01:44.70,Default,,0000,0000,0000,,(Сергітетін дауыс)
Dialogue: 0,0:01:48.37,0:01:51.87,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,0:01:56.71,0:01:59.55,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:01:59.55,0:02:01.98,Default,,0000,0000,0000,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:02:01.98,0:02:04.15,Default,,0000,0000,0000,,О, төңкеріліп!
Dialogue: 0,0:02:04.15,0:02:06.99,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:02:06.99,0:02:09.29,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:11.99,0:02:14.00,Default,,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,0:02:14.00,0:02:16.67,Default,,0000,0000,0000,,Өзіңізді жақсы сезінбейсіз бе? О, Сақа-сан!
Dialogue: 0,0:02:16.67,0:02:19.57,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:02:22.84,0:02:26.01,Default,,0000,0000,0000,,Осака мырза?
Dialogue: 0,0:02:22.84,0:02:26.01,Default,,0000,0000,0000,,Сәлем, Чио-чан.
Dialogue: 0,0:02:26.01,0:02:29.01,Default,,0000,0000,0000,,Біз екінші жыл боламыз.
Dialogue: 0,0:02:33.85,0:02:37.69,Default,,0000,0000,0000,,Не болды, мырза Мокки!
Dialogue: 0,0:02:33.85,0:02:37.69,Default,,0000,0000,0000,,Біз екінші жыл боламыз.
Dialogue: 0,0:02:37.69,0:02:40.86,Default,,0000,0000,0000,,Екінші курс студенті деген нені білдіреді?
Dialogue: 0,0:02:40.86,0:02:42.86,Default,,0000,0000,0000,,Сыныпты ауыстыру...
Dialogue: 0,0:02:42.86,0:02:45.06,Default,,0000,0000,0000,,А, дұрыс!
Dialogue: 0,0:02:47.03,0:02:51.87,Default,,0000,0000,0000,,Мен Чиё Чанмен тағы бір сыныпта оқи аламын деп үміттенемін...
Dialogue: 0,0:02:51.87,0:02:54.04,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:02:54.04,0:02:56.21,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:02:56.21,0:03:00.48,Default,,0000,0000,0000,,Болу
Dialogue: 0,0:02:56.21,0:03:00.48,Default,,0000,0000,0000,,Біз қайтадан бір сыныпта болуымыз мүмкін!
Dialogue: 0,0:03:00.48,0:03:03.81,Default,,0000,0000,0000,,Томо-чан мен Коёми-чан ➡
Dialogue: 0,0:03:03.81,0:03:08.48,Default,,0000,0000,0000,,Мен Сакаки-санмен тағы бір сыныпта оқимын.
Dialogue: 0,0:03:03.81,0:03:08.48,Default,,0000,0000,0000,,Алғым келеді, бірақ...
Dialogue: 0,0:03:08.48,0:03:11.58,Default,,0000,0000,0000,,Болу
Dialogue: 0,0:03:08.48,0:03:11.58,Default,,0000,0000,0000,,Біз қайтадан бір сыныпта болуымыз мүмкін!
Dialogue: 0,0:03:14.49,0:03:16.49,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:03:18.66,0:03:23.17,Default,,0000,0000,0000,,Келесі жолы, Юкари-сенсей
Dialogue: 0,0:03:18.66,0:03:23.17,Default,,0000,0000,0000,,Сіз сынып мұғалімі болсаңыз жақсы болар еді.
Dialogue: 0,0:03:23.17,0:03:26.00,Default,,0000,0000,0000,,Сіз міндетті түрде бірі бола аласыз!
Dialogue: 0,0:03:26.00,0:03:28.10,Default,,0000,0000,0000,,Тіпті екінші жылы
Dialogue: 0,0:03:26.00,0:03:28.10,Default,,0000,0000,0000,,Біз бәріміз біргеміз!
Dialogue: 0,0:03:30.51,0:03:32.51,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:03:36.85,0:03:39.35,Default,,0000,0000,0000,,Уайымдамаңыз, бәрі жақсы.
Dialogue: 0,0:03:39.35,0:03:41.35,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:41.35,0:03:43.35,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:43.35,0:03:45.35,Default,,0000,0000,0000,,Юкари Сенсей?
Dialogue: 0,0:03:45.35,0:03:48.02,Default,,0000,0000,0000,,2-сынып оқушыларына да жауапты боламын.
Dialogue: 0,0:03:48.02,0:03:50.69,Default,,0000,0000,0000,,Ммм….
Dialogue: 0,0:03:50.69,0:03:52.69,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:03:52.69,0:03:56.03,Default,,0000,0000,0000,,Және Чио Чан
Dialogue: 0,0:03:52.69,0:03:56.03,Default,,0000,0000,0000,,Мен оны мақсат етіп отырмын, өйткені ол күш болады!
Dialogue: 0,0:03:56.03,0:04:00.47,Default,,0000,0000,0000,,Яй Юкари Сенсей
Dialogue: 0,0:03:56.03,0:04:00.47,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:04:00.47,0:04:02.64,Default,,0000,0000,0000,,Ия, иә, иә!
Dialogue: 0,0:04:02.64,0:04:05.14,Default,,0000,0000,0000,,Эй, эй, эй! Банзай!
Dialogue: 0,0:04:02.64,0:04:05.14,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:05.14,0:04:07.14,Default,,0000,0000,0000,,Банзай иә!
Dialogue: 0,0:04:05.14,0:04:07.14,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:07.14,0:04:09.48,Default,,0000,0000,0000,,Ура!
Dialogue: 0,0:04:09.48,0:04:11.48,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:04:11.48,0:04:24.83,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:04:24.83,0:04:28.33,Default,,0000,0000,0000,,2 курс студенттері де Сакаки-санмен
Dialogue: 0,0:04:24.83,0:04:28.33,Default,,0000,0000,0000,,Біз бір сыныпта оқи аламыз...
Dialogue: 0,0:04:28.33,0:04:31.33,Default,,0000,0000,0000,,Біз бір сыныпта бола алмаймыз.
Dialogue: 0,0:04:31.33,0:04:33.67,Default,,0000,0000,0000,,болуы мүмкін.
Dialogue: 0,0:04:33.67,0:04:35.67,Default,,0000,0000,0000,,Мен бір бола алмаймын.
Dialogue: 0,0:04:35.67,0:04:38.01,Default,,0000,0000,0000,,болуы мүмкін.
Dialogue: 0,0:04:38.01,0:04:40.18,Default,,0000,0000,0000,,Мен бола алмаймын...
Dialogue: 0,0:04:40.18,0:04:43.51,Default,,0000,0000,0000,,Сіз… бола аласыз.
Dialogue: 0,0:04:43.51,0:04:45.51,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:04:45.51,0:04:48.35,Default,,0000,0000,0000,,Гүлп!
Dialogue: 0,0:04:48.35,0:04:50.69,Default,,0000,0000,0000,,Уау! Ах!
Dialogue: 0,0:04:50.69,0:04:53.19,Default,,0000,0000,0000,,На на на наре на….
Dialogue: 0,0:04:53.19,0:04:56.53,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:56.53,0:04:58.69,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:04:58.69,0:05:02.09,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:04:58.69,0:05:02.09,Default,,0000,0000,0000,,Эх хе.
Dialogue: 0,0:05:04.80,0:05:07.47,Default,,0000,0000,0000,,Айналады
Dialogue: 0,0:05:04.80,0:05:07.47,Default,,0000,0000,0000,,Мен бір бола алмаймын!
Dialogue: 0,0:05:07.47,0:05:12.14,Default,,0000,0000,0000,,Айналмайды
Dialogue: 0,0:05:07.47,0:05:12.14,Default,,0000,0000,0000,,Мен бола алмаймын!
Dialogue: 0,0:05:12.14,0:05:14.81,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:05:14.81,0:05:18.15,Default,,0000,0000,0000,,Наре на на на….
Dialogue: 0,0:05:18.15,0:05:21.98,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:05:21.98,0:05:23.99,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:05:23.99,0:05:25.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:30.16,0:05:33.00,Default,,0000,0000,0000,,Бірге болайық, Каорин.
Dialogue: 0,0:05:33.00,0:05:35.00,Default,,0000,0000,0000,,​​Тоқта!
Dialogue: 0,0:05:35.00,0:05:37.50,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:37.50,0:05:41.50,Default,,0000,0000,0000,,Апамды айқайлата алмай тұрып, оған не істедің?
Dialogue: 0,0:05:41.50,0:05:44.51,Default,,0000,0000,0000,,Yaho! Жаңа семестр!
Dialogue: 0,0:05:44.51,0:05:46.51,Default,,0000,0000,0000,,О!
Dialogue: 0,0:05:46.51,0:05:50.31,Default,,0000,0000,0000,,Viva сыныпты ауыстыру АЛҒА АЛҒА АЛҒА~!
Dialogue: 0,0:05:52.68,0:05:55.52,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:05:55.52,0:05:58.19,Default,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:05:55.52,0:05:58.19,Default,,0000,0000,0000,,Бір сыныпта оқитын болсақ жақсы болар еді.
Dialogue: 0,0:05:58.19,0:06:00.96,Default,,0000,0000,0000,,Томо-чан мен Коёми-сан
Dialogue: 0,0:05:58.19,0:06:00.96,Default,,0000,0000,0000,,Бастауыш мектептен бері➡
Dialogue: 0,0:06:00.96,0:06:02.96,Default,,0000,0000,0000,,Бір сыныпта оқығандай.
Dialogue: 0,0:06:04.96,0:06:06.96,Default,,0000,0000,0000,,Бастауыш мектептен
Dialogue: 0,0:06:04.96,0:06:06.96,Default,,0000,0000,0000,,Менімен мәңгі бірге болған адам➡
Dialogue: 0,0:06:06.96,0:06:09.63,Default,,0000,0000,0000,,Мен мұнда болмағандықтан қызғанамын.
Dialogue: 0,0:06:09.63,0:06:11.63,Default,,0000,0000,0000,,Сіз мысқылдайсыз ба? Эй!
Dialogue: 0,0:06:09.63,0:06:11.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:13.97,0:06:16.14,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:06:16.14,0:06:18.14,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:06:18.14,0:06:20.64,Default,,0000,0000,0000,,Мен Юкари-сенсэйдің сыныбындамын!
Dialogue: 0,0:06:20.64,0:06:23.15,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:06:20.64,0:06:23.15,Default,,0000,0000,0000,,Аа, бұл рас.
Dialogue: 0,0:06:23.15,0:06:25.15,Default,,0000,0000,0000,,Хе, мен де...
Dialogue: 0,0:06:25.15,0:06:27.98,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:06:27.98,0:06:30.15,Default,,0000,0000,0000,,Барлығы қайтадан бірге.
Dialogue: 0,0:06:30.15,0:06:33.82,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:06:33.82,0:06:36.62,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:39.83,0:06:41.83,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:06:41.83,0:06:44.13,Default,,0000,0000,0000,,Каорин.
Dialogue: 0,0:06:41.83,0:06:44.13,Default,,0000,0000,0000,,Ха! Хахахаха….
Dialogue: 0,0:06:46.17,0:06:48.84,Default,,0000,0000,0000,,Ой... ой...
Dialogue: 0,0:06:48.84,0:06:50.84,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:06:53.51,0:06:56.35,Default,,0000,0000,0000,,Мм...!
Dialogue: 0,0:06:56.35,0:06:58.35,Default,,0000,0000,0000,,Жауынгерлік емес күш туралы хабарлама дегеніміз не?
Dialogue: 0,0:06:58.35,0:07:01.12,Default,,0000,0000,0000,,Чиёчан.
Dialogue: 0,0:06:58.35,0:07:01.12,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,0:07:01.12,0:07:03.12,Default,,0000,0000,0000,,Сіз тез арада достар табасыз!
Dialogue: 0,0:07:03.12,0:07:05.29,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:07:03.12,0:07:05.29,Default,,0000,0000,0000,,Қалайсың?
Dialogue: 0,0:07:05.29,0:07:07.29,Default,,0000,0000,0000,,Онда!
Dialogue: 0,0:07:09.46,0:07:12.29,Default,,0000,0000,0000,,Бұл Осака
Dialogue: 0,0:07:09.46,0:07:12.29,Default,,0000,0000,0000,,Бұл сіз туралы емес пе?
Dialogue: 0,0:07:12.29,0:07:15.63,Default,,0000,0000,0000,,А... иә?
Dialogue: 0,0:07:15.63,0:07:17.63,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:17.63,0:07:21.83,Default,,0000,0000,0000,,Осака мені білдіреді ме?
Dialogue: 0,0:07:23.97,0:07:26.31,Default,,0000,0000,0000,,Фуккуфуфу…!
Dialogue: 0,0:07:26.31,0:07:29.14,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:07:29.14,0:07:33.64,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:07:35.65,0:07:41.65,Default,,0000,0000,0000,,Са-ка-ки-сан!
Dialogue: 0,0:07:53.34,0:07:56.17,Default,,0000,0000,0000,,Қайырлы таң, Сакаки-сан.
Dialogue: 0,0:07:56.17,0:08:01.07,Default,,0000,0000,0000,,Біз қайтадан бір сыныпта болдық.
Dialogue: 0,0:07:56.17,0:08:01.07,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:03.61,0:08:06.11,Default,,0000,0000,0000,,Ха, мен шаршадым!
Dialogue: 0,0:08:06.11,0:08:08.12,Default,,0000,0000,0000,,Уф, солай!
Dialogue: 0,0:08:08.12,0:08:12.95,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:12.95,0:08:15.29,Default,,0000,0000,0000,,Спортқа шебер Кагура-сан!
Dialogue: 0,0:08:15.29,0:08:19.13,Default,,0000,0000,0000,,Ей, біз бір сыныпта оқимыз.
Dialogue: 0,0:08:19.13,0:08:22.80,Default,,0000,0000,0000,,Мен сені бір рет кездестірдім
Dialogue: 0,0:08:19.13,0:08:22.80,Default,,0000,0000,0000,,Мен сенімен дұрыс сөйлескім келді.
Dialogue: 0,0:08:22.80,0:08:25.47,Default,,0000,0000,0000,,Маған ұқсас нәрсе
Dialogue: 0,0:08:22.80,0:08:25.47,Default,,0000,0000,0000,,Мен бір➡ бар екенін естідім
Dialogue: 0,0:08:25.47,0:08:28.80,Default,,0000,0000,0000,,Жарайды, сұраудың қажеті жоқ.
Dialogue: 0,0:08:25.47,0:08:28.80,Default,,0000,0000,0000,,Екеуміз де сезіндік...
Dialogue: 0,0:08:28.80,0:08:34.48,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:34.48,0:08:36.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:36.48,0:08:41.15,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:41.15,0:08:44.82,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:08:41.15,0:08:44.82,Default,,0000,0000,0000,,Мені есіңе түсірмейсің бе?
Dialogue: 0,0:08:44.82,0:08:50.16,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:50.16,0:08:52.16,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:08:52.16,0:08:55.16,Default,,0000,0000,0000,,Мен көремін...
Dialogue: 0,0:08:55.16,0:08:59.50,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:59.50,0:09:03.27,Default,,0000,0000,0000,,Қараңдаршы, спорт мерекесі де.
Dialogue: 0,0:08:59.50,0:09:03.27,Default,,0000,0000,0000,,Марафон турнирлері және доп ойыны бойынша турнирлер➡
Dialogue: 0,0:09:03.27,0:09:06.27,Default,,0000,0000,0000,,Сондықтан
Dialogue: 0,0:09:03.27,0:09:06.27,Default,,0000,0000,0000,,Біз соғыстық!
Dialogue: 0,0:09:06.27,0:09:18.45,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:18.45,0:09:21.79,Default,,0000,0000,0000,,Шынында да солай емес пе?
Dialogue: 0,0:09:18.45,0:09:21.79,Default,,0000,0000,0000,,Есіңізде жоқ екеніне сенімдісіз бе?
Dialogue: 0,0:09:21.79,0:09:25.96,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:25.96,0:09:27.96,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:09:30.80,0:09:33.30,Default,,0000,0000,0000,,Қалай болғанда да, біз қарсыласпыз!
Dialogue: 0,0:09:33.30,0:09:35.80,Default,,0000,0000,0000,,(Изуку) Мүмкін. Оятып алғаным үшін кешір.
Dialogue: 0,0:09:33.30,0:09:35.80,Default,,0000,0000,0000,,А, а.
Dialogue: 0,0:09:35.80,0:09:39.98,Default,,0000,0000,0000,,《Юкари-сенсэй спорт мерекесіне қатты қуанды! 》
Dialogue: 0,0:09:39.98,0:09:43.98,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:09:47.98,0:09:50.82,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:47.98,0:09:50.82,Default,,0000,0000,0000,,Бүгіннен бастап барлығыңыз екінші курс студенттерісіз.
Dialogue: 0,0:09:50.82,0:09:54.16,Default,,0000,0000,0000,,Және мен
Dialogue: 0,0:09:50.82,0:09:54.16,Default,,0000,0000,0000,,Юкари Танизаки - менің сынып жетекшім.
Dialogue: 0,0:09:54.16,0:09:56.16,Default,,0000,0000,0000,,Барлықтарыңызбен танысқаныма қуаныштымын!
Dialogue: 0,0:09:56.16,0:09:58.49,Default,,0000,0000,0000,,Осыны қарасаңыз.
Dialogue: 0,0:09:56.16,0:09:58.49,Default,,0000,0000,0000,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:09:58.49,0:10:03.16,Default,,0000,0000,0000,,Неге екені белгісіз, жасымнан бері.
Dialogue: 0,0:09:58.49,0:10:03.16,Default,,0000,0000,0000,,Менің қасымда бірнеше адам бар!
Dialogue: 0,0:10:03.16,0:10:05.50,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:10:03.16,0:10:05.50,Default,,0000,0000,0000,,(Номудың айғайы)
Dialogue: 0,0:10:05.50,0:10:08.00,Default,,0000,0000,0000,,Осы жылы қолыңыздан келгеннің бәрін жасаңыз➡
Dialogue: 0,0:10:08.00,0:10:10.67,Default,,0000,0000,0000,,Мықты, берік….
Dialogue: 0,0:10:10.67,0:10:14.68,Default,,0000,0000,0000,,Қызық, неге~?
Dialogue: 0,0:10:10.67,0:10:14.68,Default,,0000,0000,0000,,Бұл өте біртүрлі.
Dialogue: 0,0:10:14.68,0:10:17.85,Default,,0000,0000,0000,,Жаңа нәрсені үйрену қиын ба?
Dialogue: 0,0:10:17.85,0:10:19.85,Default,,0000,0000,0000,,Сондай-ақ «Twilight» код атымен де белгілі
Dialogue: 0,0:10:17.85,0:10:19.85,Default,,0000,0000,0000,,Сіз бұл жалпы ➡ деп айтуға болады
Dialogue: 0,0:10:19.85,0:10:21.85,Default,,0000,0000,0000,,Жоқ, өтінемін.
Dialogue: 0,0:10:24.85,0:10:28.52,Default,,0000,0000,0000,,(өрт сөндіру машинасының дыбысы)
Dialogue: 0,0:10:28.52,0:10:31.69,Default,,0000,0000,0000,,О, және
Dialogue: 0,0:10:28.52,0:10:31.69,Default,,0000,0000,0000,,Орындар ретін өзгертпеңіз.
Dialogue: 0,0:10:31.69,0:10:34.20,Default,,0000,0000,0000,,Әрине, сынып оқушылары да ренжіді.
Dialogue: 0,0:10:34.20,0:10:38.20,Default,,0000,0000,0000,,(Сиырдың улауы)
Dialogue: 0,0:10:38.20,0:10:41.54,Default,,0000,0000,0000,,Иә, сондықтан
Dialogue: 0,0:10:38.20,0:10:41.54,Default,,0000,0000,0000,,Сынып оқушыларының сәлемі.
Dialogue: 0,0:10:41.54,0:10:43.54,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:10:41.54,0:10:43.54,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:10:43.54,0:10:45.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:45.54,0:10:47.54,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:10:47.54,0:10:50.38,Default,,0000,0000,0000,,Иә, иә, жарайды.
Dialogue: 0,0:10:47.54,0:10:50.38,Default,,0000,0000,0000,,Ол үшін уайымдама, алға шық.
Dialogue: 0,0:10:50.38,0:10:52.71,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:52.71,0:10:56.38,Default,,0000,0000,0000,,Чио-чан нағыз атақты адам.
Dialogue: 0,0:10:52.71,0:10:56.38,Default,,0000,0000,0000,,Бұл өте сүйкімді.
Dialogue: 0,0:10:56.38,0:11:00.99,Default,,0000,0000,0000,,Бұл нүкте қай жерде?
Dialogue: 0,0:10:56.38,0:11:00.99,Default,,0000,0000,0000,,Ол атақты мектептен қашып кеткен ақымақтан мүлдем бөлек.
Dialogue: 0,0:11:00.99,0:11:04.16,Default,,0000,0000,0000,,Эхехе Сәлеметсіз бе, бұл атақты мектеп...
Dialogue: 0,0:11:04.16,0:11:07.83,Default,,0000,0000,0000,,Атақты мектептен қашқан ақымақ кім?
Dialogue: 0,0:11:04.16,0:11:07.83,Default,,0000,0000,0000,,Сіз нені айтасыз!
Dialogue: 0,0:11:07.83,0:11:10.17,Default,,0000,0000,0000,,Баннен Сакаки-санның есегін айнала жүгіріп келе жатқан әйел!
Dialogue: 0,0:11:10.17,0:11:12.33,Default,,0000,0000,0000,,О, ақымақтан гөрі күте тұрыңыз➡
Dialogue: 0,0:11:12.33,0:11:14.50,Default,,0000,0000,0000,,Асса жақсырақ
Dialogue: 0,0:11:12.33,0:11:14.50,Default,,0000,0000,0000,,Пайдаланушы бар екенін білесіз бе?
Dialogue: 0,0:11:14.50,0:11:16.67,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:11:14.50,0:11:16.67,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:11:16.67,0:11:18.67,Default,,0000,0000,0000,,Ол, әрине, бақылаусыз ақымақ...
Dialogue: 0,0:11:18.67,0:11:21.68,Default,,0000,0000,0000,,О, бұл тамаша.
Dialogue: 0,0:11:18.67,0:11:21.68,Default,,0000,0000,0000,,Бұл Бонкура~!
Dialogue: 0,0:11:21.68,0:11:25.01,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:11:21.68,0:11:25.01,Default,,0000,0000,0000,,Барлығыңыз жарасып жүріңіздер.
Dialogue: 0,0:11:25.01,0:11:27.02,Default,,0000,0000,0000,,Өйткені ол маңызды күш.
Dialogue: 0,0:11:27.02,0:11:30.85,Default,,0000,0000,0000,,Оря, оря!
Dialogue: 0,0:11:30.85,0:11:33.19,Default,,0000,0000,0000,,Мықты түрде➡
Dialogue: 0,0:11:33.19,0:11:35.69,Default,,0000,0000,0000,,Мықты.
Dialogue: 0,0:11:39.36,0:11:41.53,Default,,0000,0000,0000,,Сәлем Сакаки!
Dialogue: 0,0:11:41.53,0:11:45.37,Default,,0000,0000,0000,,Бүгін клуб жаттығуы жоқ.
Dialogue: 0,0:11:41.53,0:11:45.37,Default,,0000,0000,0000,,Үйге бірге барайық!
Dialogue: 0,0:11:45.37,0:11:48.87,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:11:48.87,0:11:51.71,Default,,0000,0000,0000,,Осымен
Dialogue: 0,0:11:48.87,0:11:51.71,Default,,0000,0000,0000,,Мен сізден біраз уақыт сұрайын деп едім➡
Dialogue: 0,0:11:51.71,0:11:54.41,Default,,0000,0000,0000,,Сакаки әдетте
Dialogue: 0,0:11:51.71,0:11:54.41,Default,,0000,0000,0000,,Сіз спортпен айналысасыз ба?
Dialogue: 0,0:11:56.71,0:11:59.05,Default,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,0:11:56.71,0:11:59.05,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:11:59.05,0:12:02.48,Default,,0000,0000,0000,,Сонымен спорт мерекесі
Dialogue: 0,0:11:59.05,0:12:02.48,Default,,0000,0000,0000,,Марафон немесе доп ойыны турнирінде➡
Dialogue: 0,0:12:02.48,0:12:06.66,Default,,0000,0000,0000,,Ол керемет жұмыс істеп жатыр.
Dialogue: 0,0:12:02.48,0:12:06.66,Default,,0000,0000,0000,,Бұл керемет.
Dialogue: 0,0:12:06.66,0:12:10.16,Default,,0000,0000,0000,,(Жұмысқа қабылдау тобының дауысы)
Dialogue: 0,0:12:15.16,0:12:17.83,Default,,0000,0000,0000,,Үйірмеге кіру және т.б.
Dialogue: 0,0:12:15.16,0:12:17.83,Default,,0000,0000,0000,,Ойланбайсыз ба?
Dialogue: 0,0:12:17.83,0:12:21.17,Default,,0000,0000,0000,,Атлетика бөлімі осыншама жұмыс істей алса.
Dialogue: 0,0:12:17.83,0:12:21.17,Default,,0000,0000,0000,,Сіз үндемейсіз бе?
Dialogue: 0,0:12:21.17,0:12:25.51,Default,,0000,0000,0000,,Сакаки-сан!
Dialogue: 0,0:12:21.17,0:12:25.51,Default,,0000,0000,0000,,Осы жылы жіберіп алмаңыз!
Dialogue: 0,0:12:21.17,0:12:25.51,Default,,0000,0000,0000,,Менің бөліміме!
Dialogue: 0,0:12:25.51,0:12:28.01,Default,,0000,0000,0000,,Мен аздап спортшымын...
Dialogue: 0,0:12:28.01,0:12:30.68,Default,,0000,0000,0000,,Ах, күткендей.
Dialogue: 0,0:12:30.68,0:12:32.68,Default,,0000,0000,0000,,Күтілгендей ме?
Dialogue: 0,0:12:32.68,0:12:37.02,Default,,0000,0000,0000,,Сакаки-сан!
Dialogue: 0,0:12:32.68,0:12:37.02,Default,,0000,0000,0000,,Осы жылды жіберіп алмаңыз!
Dialogue: 0,0:12:32.68,0:12:37.02,Default,,0000,0000,0000,,Менің бөліміме!
Dialogue: 0,0:12:37.02,0:12:39.69,Default,,0000,0000,0000,,(Жұмысқа қабылдау тобының дауысы)
Dialogue: 0,0:12:39.69,0:12:43.53,Default,,0000,0000,0000,,Сонымен, мысалы, жүзу үйірмесі ше?
Dialogue: 0,0:12:43.53,0:12:47.36,Default,,0000,0000,0000,,(Жұмысқа қабылдау тобының дауысы)
Dialogue: 0,0:12:47.36,0:12:50.03,Default,,0000,0000,0000,,Әйтеуір өсек айтқандай.
Dialogue: 0,0:12:50.03,0:12:54.37,Default,,0000,0000,0000,,Мен көп жиналуды жек көремін.
Dialogue: 0,0:12:50.03,0:12:54.37,Default,,0000,0000,0000,,Мен сені жалғыз адам деп естідім.
Dialogue: 0,0:12:54.37,0:12:56.37,Default,,0000,0000,0000,,Қасқыр?
Dialogue: 0,0:12:56.37,0:12:58.71,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:12:58.71,0:13:01.64,Default,,0000,0000,0000,,Сакаки-сан!
Dialogue: 0,0:12:58.71,0:13:01.64,Default,,0000,0000,0000,,Біздің клубқа қосылыңыз!
Dialogue: 0,0:13:01.64,0:13:04.04,Default,,0000,0000,0000,,Чикишо!
Dialogue: 0,0:13:01.64,0:13:04.04,Default,,0000,0000,0000,,Сакаки Бұл өте керемет!
Dialogue: 0,0:13:05.98,0:13:07.98,Default,,0000,0000,0000,,Қасқыр….
Dialogue: 0,0:13:07.98,0:13:11.65,Default,,0000,0000,0000,,Уф уф!
Dialogue: 0,0:13:11.65,0:13:15.32,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,0:13:15.32,0:13:19.49,Default,,0000,0000,0000,,《Бақыт~
Dialogue: 0,0:13:15.32,0:13:19.49,Default,,0000,0000,0000,,Ертең ағама не айтайын...》
Dialogue: 0,0:13:19.49,0:13:22.49,Default,,0000,0000,0000,,Хмм... мм?
Dialogue: 0,0:13:24.67,0:13:27.00,Default,,0000,0000,0000,,Бұл мысық.
Dialogue: 0,0:13:27.00,0:13:29.30,Default,,0000,0000,0000,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:13:33.84,0:13:35.84,Default,,0000,0000,0000,,Қандай ақымақ!
Dialogue: 0,0:13:35.84,0:13:39.04,Default,,0000,0000,0000,,Вахаха! Бұл сергітетін болды!
Dialogue: 0,0:13:42.18,0:13:45.19,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:47.19,0:13:49.86,Default,,0000,0000,0000,,《Бәрі түсінбейді! 》
Dialogue: 0,0:13:49.86,0:13:52.36,Default,,0000,0000,0000,,Бірінші сынып оқушысы сені сүйкімді деп атады ма?
Dialogue: 0,0:13:52.36,0:13:56.20,Default,,0000,0000,0000,,Дұрыс! Осака-санмен
Dialogue: 0,0:13:52.36,0:13:56.20,Default,,0000,0000,0000,,Бірінші қабаттағы қызметкерлер бөлмесіне қайтып келе жатқанда➡
Dialogue: 0,0:13:56.20,0:13:58.20,Default,,0000,0000,0000,,Мені бірінші курс студенттері қоршап алды...
Dialogue: 0,0:13:58.20,0:14:00.14,Default,,0000,0000,0000,,Сіз әйгілі Чио-чансыз!
Dialogue: 0,0:14:00.14,0:14:02.64,Default,,0000,0000,0000,,Бұл кішкентай!
Dialogue: 0,0:14:00.14,0:14:02.64,Default,,0000,0000,0000,,Өте сүйкімді!
Dialogue: 0,0:14:02.64,0:14:04.64,Default,,0000,0000,0000,,Кя~!
Dialogue: 0,0:14:02.64,0:14:04.64,Default,,0000,0000,0000,,Өй...
Dialogue: 0,0:14:04.64,0:14:07.98,Default,,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,0:14:04.64,0:14:07.98,Default,,0000,0000,0000,,Мен екінші курс студентімін!
Dialogue: 0,0:14:07.98,0:14:09.98,Default,,0000,0000,0000,,Сосын Коёми-сан келгенде...
Dialogue: 0,0:14:09.98,0:14:12.31,Default,,0000,0000,0000,,Ахахха! Дұрыс, бірінші курс студенттері➡
Dialogue: 0,0:14:12.31,0:14:14.82,Default,,0000,0000,0000,,Мен Чио-чанды бірінші рет көргенде
Dialogue: 0,0:14:12.31,0:14:14.82,Default,,0000,0000,0000,,Сіз таң қаласыз!
Dialogue: 0,0:14:14.82,0:14:17.62,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:14:14.82,0:14:17.62,Default,,0000,0000,0000,,Жай ғана сүйкімді болған дұрыс, жарайды!
Dialogue: 0,0:14:19.82,0:14:21.99,Default,,0000,0000,0000,,Ахаха ахаха.
Dialogue: 0,0:14:21.99,0:14:24.33,Default,,0000,0000,0000,,...
Dialogue: 0,0:14:21.99,0:14:24.33,Default,,0000,0000,0000,,2 курсты үлкен әріппен жаз➡
Dialogue: 0,0:14:24.33,0:14:27.16,Default,,0000,0000,0000,,Оны кеудеге іліп қойыңыз
Dialogue: 0,0:14:24.33,0:14:27.16,Default,,0000,0000,0000,,Мен оны қалдыруым керек пе? Қараңдар!
Dialogue: 0,0:14:27.16,0:14:29.16,Default,,0000,0000,0000,,Оны бір нәрсе деп ойлаңыз!
Dialogue: 0,0:14:29.16,0:14:31.50,Default,,0000,0000,0000,,Мен бірінші курс студентімін.
Dialogue: 0,0:14:29.16,0:14:31.50,Default,,0000,0000,0000,,Сүйкімді немесе кішкентай➡
Dialogue: 0,0:14:31.50,0:14:34.67,Default,,0000,0000,0000,,Балалар?
Dialogue: 0,0:14:31.50,0:14:34.67,Default,,0000,0000,0000,,Маған айтқаныңды қаламаймын!
Dialogue: 0,0:14:34.67,0:14:36.67,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:14:36.67,0:14:39.87,Default,,0000,0000,0000,,Сакаки-сан, менің сезімім
Dialogue: 0,0:14:36.67,0:14:39.87,Default,,0000,0000,0000,,Түсінесіз бе?
Dialogue: 0,0:14:42.18,0:14:45.35,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:14:45.35,0:14:48.68,Default,,0000,0000,0000,,2: Керемет! Қазір шашы ұзын адам!
Dialogue: 0,0:14:48.68,0:14:51.35,Default,,0000,0000,0000,,Тіпті екінші курс студенті!
Dialogue: 0,0:14:48.68,0:14:51.35,Default,,0000,0000,0000,,Бұл 3-сынып!
Dialogue: 0,0:14:51.35,0:14:54.86,Default,,0000,0000,0000,,Есімі Сакаки-сан! Бойы 174 см!
Dialogue: 0,0:14:54.86,0:14:57.86,Default,,0000,0000,0000,,Сакаки-сан керемет!
Dialogue: 0,0:14:57.86,0:14:59.96,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:14:59.96,0:15:04.30,Default,,0000,0000,0000,,Егер Сакаки мырза
Dialogue: 0,0:14:59.96,0:15:04.30,Default,,0000,0000,0000,,Түсінесіз!
Dialogue: 0,0:15:04.30,0:15:06.30,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:15:06.30,0:15:08.64,Default,,0000,0000,0000,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:15:08.64,0:15:11.54,Default,,0000,0000,0000,,(Ұшақ дыбысы)
Dialogue: 0,0:15:13.64,0:15:16.48,Default,,0000,0000,0000,,《Күтілгендей
Dialogue: 0,0:15:13.64,0:15:16.48,Default,,0000,0000,0000,,Адамдар түсінбейді! 》
Dialogue: 0,0:15:16.48,0:15:19.65,Default,,0000,0000,0000,,Иә? Неге балалар...
Dialogue: 0,0:15:19.65,0:15:22.15,Default,,0000,0000,0000,,(Студент дауыстары)
Dialogue: 0,0:15:27.49,0:15:29.49,Default,,0000,0000,0000,,Сіз жаңа студентсіз!
Dialogue: 0,0:15:29.49,0:15:31.49,Default,,0000,0000,0000,,Иә, бірақ...
Dialogue: 0,0:15:31.49,0:15:34.66,Default,,0000,0000,0000,,Мен Михама Чиомын! Мен екінші курс студентімін!
Dialogue: 0,0:15:34.66,0:15:37.83,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:34.66,0:15:37.83,Default,,0000,0000,0000,,Бұл Михама-сенпай!
Dialogue: 0,0:15:37.83,0:15:42.17,Default,,0000,0000,0000,,А-а...
Dialogue: 0,0:15:42.17,0:15:44.67,Default,,0000,0000,0000,,Михама Сенпай….
Dialogue: 0,0:15:46.67,0:15:48.68,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:15:48.68,0:15:53.35,Default,,0000,0000,0000,,Жарайды. Ахаха!
Dialogue: 0,0:15:53.35,0:15:55.52,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:15:55.52,0:15:59.02,Default,,0000,0000,0000,,Сенпай?
Dialogue: 0,0:15:59.02,0:16:01.46,Default,,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:16:01.46,0:16:04.13,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:16:01.46,0:16:04.13,Default,,0000,0000,0000,,А?
Dialogue: 0,0:16:04.13,0:16:07.96,Default,,0000,0000,0000,,Мен оны мүлдем түсінбедім
Dialogue: 0,0:16:04.13,0:16:07.96,Default,,0000,0000,0000,,Соңғы уақытқа дейін біз➡
Dialogue: 0,0:16:07.96,0:16:09.96,Default,,0000,0000,0000,,Мен бірінші курс студенті болдым.
Dialogue: 0,0:16:09.96,0:16:13.80,Default,,0000,0000,0000,,Жарайды, үй тапсырмасын тез көшіріп ал.
Dialogue: 0,0:16:13.80,0:16:17.14,Default,,0000,0000,0000,,О, қаншама күш-жігер
Dialogue: 0,0:16:13.80,0:16:17.14,Default,,0000,0000,0000,,Себебі мен екінші курс студентімін➡
Dialogue: 0,0:16:17.14,0:16:19.81,Default,,0000,0000,0000,,Екінші курс студентіне тән нәрселер
Dialogue: 0,0:16:17.14,0:16:19.81,Default,,0000,0000,0000,,Мен қалаймын!
Dialogue: 0,0:16:19.81,0:16:23.31,Default,,0000,0000,0000,,Иә, иә, көшіруді аяқтағаннан кейін.
Dialogue: 0,0:16:23.31,0:16:25.31,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:16:30.32,0:16:32.82,Default,,0000,0000,0000,,Уау! Сіз тым тез сөйлейсіз бе?
Dialogue: 0,0:16:32.82,0:16:37.83,Default,,0000,0000,0000,,Тым көп идеялар
Dialogue: 0,0:16:32.82,0:16:37.83,Default,,0000,0000,0000,,Бұл аңғал болуы мүмкін, бірақ карри...
Dialogue: 0,0:16:37.83,0:16:41.16,Default,,0000,0000,0000,,Жоғары сынып оқушылары екінші курсқа келгенде
Dialogue: 0,0:16:37.83,0:16:41.16,Default,,0000,0000,0000,,Енді тез сөйлеуге болмайды➡
Dialogue: 0,0:16:41.16,0:16:43.83,Default,,0000,0000,0000,,Жалпы оқу керек
Dialogue: 0,0:16:41.16,0:16:43.83,Default,,0000,0000,0000,,Қолдануға болмайтын жалпы мағына➡
Dialogue: 0,0:16:43.83,0:16:48.67,Default,,0000,0000,0000,,алыс
Dialogue: 0,0:16:43.83,0:16:48.67,Default,,0000,0000,0000,,Негіздердің негізгі кезеңі….
Dialogue: 0,0:16:48.67,0:16:50.67,Default,,0000,0000,0000,,Бұл жерде!
Dialogue: 0,0:16:50.67,0:16:53.84,Default,,0000,0000,0000,,Сатоши-чан
Dialogue: 0,0:16:50.67,0:16:53.84,Default,,0000,0000,0000,,Жақында сабақтар басталады!
Dialogue: 0,0:16:53.84,0:16:57.18,Default,,0000,0000,0000,,Хмф! Сабақтан қорқамын, бірақ тез сөйлей аламын ба?
Dialogue: 0,0:16:57.18,0:16:59.18,Default,,0000,0000,0000,,Көбінесе➡
Dialogue: 0,0:16:59.18,0:17:03.28,Default,,0000,0000,0000,,Балалар еліктей алмайтын қулық шығар...
Dialogue: 0,0:17:03.28,0:17:07.29,Default,,0000,0000,0000,,Хо-хо-хо-хо-хо-хо-хо-хо.
Dialogue: 0,0:17:03.28,0:17:07.29,Default,,0000,0000,0000,,Бұл қалай? Ол қалай?
Dialogue: 0,0:17:07.29,0:17:10.79,Default,,0000,0000,0000,,Түскі үзіліске осы сағат қалғанда
Dialogue: 0,0:17:07.29,0:17:10.79,Default,,0000,0000,0000,,Жылдам сөйлеудің таңғажайып әлеміне➡
Dialogue: 0,0:17:10.79,0:17:13.80,Default,,0000,0000,0000,,Балалар
Dialogue: 0,0:17:10.79,0:17:13.80,Default,,0000,0000,0000,,Сіз аман қала аласыз ба?
Dialogue: 0,0:17:22.97,0:17:24.97,Default,,0000,0000,0000,,А?
Dialogue: 0,0:17:32.31,0:17:36.01,Default,,0000,0000,0000,,Кешіріңіз. Түскі үзілісте болдыңыз ба?
Dialogue: 0,0:17:42.32,0:17:45.99,Default,,0000,0000,0000,,А? О?
Dialogue: 0,0:17:45.99,0:17:49.09,Default,,0000,0000,0000,,11 сағат? Король жүгері!
Dialogue: 0,0:17:51.33,0:17:54.50,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:17:54.50,0:17:57.01,Default,,0000,0000,0000,,Қат! Мен үйге жақындадым.
Dialogue: 0,0:17:57.01,0:17:59.01,Default,,0000,0000,0000,,Ах, Юкари-сенсей.
Dialogue: 0,0:17:59.01,0:18:01.94,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:17:59.01,0:18:01.94,Default,,0000,0000,0000,,Балалар, келіңдер!
Dialogue: 0,0:18:01.94,0:18:03.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:03.95,0:18:05.95,Default,,0000,0000,0000,,Мен мұны жаңа ғана алдым.
Dialogue: 0,0:18:05.95,0:18:08.45,Default,,0000,0000,0000,,Мен оны ашсам жарылып кете ме?
Dialogue: 0,0:18:08.45,0:18:10.62,Default,,0000,0000,0000,,Табылған заттар қауіпті болуы мүмкін➡
Dialogue: 0,0:18:10.62,0:18:12.95,Default,,0000,0000,0000,,Оны жеңіл ашқан дұрыс емес.
Dialogue: 0,0:18:12.95,0:18:16.29,Default,,0000,0000,0000,,Қауіпті болса, жақсырақ.
Dialogue: 0,0:18:16.29,0:18:19.29,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:18:16.29,0:18:19.29,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:19.29,0:18:21.96,Default,,0000,0000,0000,,Бұл котенка!
Dialogue: 0,0:18:21.96,0:18:24.63,Default,,0000,0000,0000,,Кішкентай!
Dialogue: 0,0:18:21.96,0:18:24.63,Default,,0000,0000,0000,,Ұйқы~.
Dialogue: 0,0:18:24.63,0:18:27.64,Default,,0000,0000,0000,,Сіздің мұрын қызғылт түсті.
Dialogue: 0,0:18:27.64,0:18:30.81,Default,,0000,0000,0000,,Қандай кішкентай табан.
Dialogue: 0,0:18:30.81,0:18:33.81,Default,,0000,0000,0000,,Көздерің кір!
Dialogue: 0,0:18:33.81,0:18:37.15,Default,,0000,0000,0000,,Сонымен…
Dialogue: 0,0:18:33.81,0:18:37.15,Default,,0000,0000,0000,,Біреу мына котенканы ұстауды өтінемін!
Dialogue: 0,0:18:37.15,0:18:40.48,Default,,0000,0000,0000,,Е! Юкари оны сақтайды емес пе?
Dialogue: 0,0:18:40.48,0:18:42.65,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:18:40.48,0:18:42.65,Default,,0000,0000,0000,,Жоқ, мен бос емеспін!
Dialogue: 0,0:18:42.65,0:18:45.15,Default,,0000,0000,0000,,Жарайсың ба? Сондай кішкентай котенка➡
Dialogue: 0,0:18:45.15,0:18:47.32,Default,,0000,0000,0000,,Жалғыз
Dialogue: 0,0:18:45.15,0:18:47.32,Default,,0000,0000,0000,,Сіз өмір сүре алмайсыз!
Dialogue: 0,0:18:47.32,0:18:49.32,Default,,0000,0000,0000,,Оны аямайсың ба?
Dialogue: 0,0:18:49.32,0:18:51.49,Default,,0000,0000,0000,,Өйткені, Юкари-чан сақтау керек!
Dialogue: 0,0:18:51.49,0:18:54.33,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:18:51.49,0:18:54.33,Default,,0000,0000,0000,,Мен бос емеспін!
Dialogue: 0,0:18:54.33,0:18:56.66,Default,,0000,0000,0000,,Сакаки, ​​не болды~?
Dialogue: 0,0:18:56.66,0:18:59.06,Default,,0000,0000,0000,,Жарайсың ба? Котяталарға келетін болсақ ...
Dialogue: 0,0:19:01.60,0:19:05.77,Default,,0000,0000,0000,,Тек біреуді ұстаңыз!
Dialogue: 0,0:19:01.60,0:19:05.77,Default,,0000,0000,0000,,Үй жануарларын ұста деп айту оңай емес.
Dialogue: 0,0:19:05.77,0:19:08.94,Default,,0000,0000,0000,,Біздің үй бос.
Dialogue: 0,0:19:05.77,0:19:08.94,Default,,0000,0000,0000,,Біз де алмаймыз.
Dialogue: 0,0:19:08.94,0:19:10.95,Default,,0000,0000,0000,,Өйткені менің итім бар.
Dialogue: 0,0:19:10.95,0:19:13.95,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:19:10.95,0:19:13.95,Default,,0000,0000,0000,,Тадаёси мырза да...
Dialogue: 0,0:19:13.95,0:19:15.95,Default,,0000,0000,0000,,Бұл не, мысық?
Dialogue: 0,0:19:15.95,0:19:18.45,Default,,0000,0000,0000,,Сакаки ше?
Dialogue: 0,0:19:15.95,0:19:18.45,Default,,0000,0000,0000,,Біз де алмаймыз.
Dialogue: 0,0:19:18.45,0:19:20.45,Default,,0000,0000,0000,,Мен қиналып жатырмын...
Dialogue: 0,0:19:23.46,0:19:28.63,Default,,0000,0000,0000,,《Сакаки: Бұйралаған...
Dialogue: 0,0:19:23.46,0:19:28.63,Default,,0000,0000,0000,,Мару… Мару… Маруико….
Dialogue: 0,0:19:28.63,0:19:32.30,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:28.63,0:19:32.30,Default,,0000,0000,0000,,Мына баланың атын Марко деп қояйық.
Dialogue: 0,0:19:32.30,0:19:36.14,Default,,0000,0000,0000,,Сәлем Сакаки~.
Dialogue: 0,0:19:32.30,0:19:36.14,Default,,0000,0000,0000,,《Марко туралы айтатын болсақ, бұл оқиға...》
Dialogue: 0,0:19:36.14,0:19:38.64,Default,,0000,0000,0000,,Сакаки?
Dialogue: 0,0:19:38.64,0:19:43.31,Default,,0000,0000,0000,,《Күтілгендей, бұл бала да
Dialogue: 0,0:19:38.64,0:19:43.31,Default,,0000,0000,0000,,3000 ли анамды іздеуде...》
Dialogue: 0,0:19:43.31,0:19:45.81,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:19:43.31,0:19:45.81,Default,,0000,0000,0000,,《12 000 км➡
Dialogue: 0,0:19:45.81,0:19:48.15,Default,,0000,0000,0000,,Жалғыз
Dialogue: 0,0:19:45.81,0:19:48.15,Default,,0000,0000,0000,,Ол саяхаттай ма?
Dialogue: 0,0:19:48.15,0:19:50.15,Default,,0000,0000,0000,,Сәлем?
Dialogue: 0,0:19:50.15,0:19:53.65,Default,,0000,0000,0000,,《Мен сенімдімін... Мен бір сөзбен сенімдімін
Dialogue: 0,0:19:50.15,0:19:53.65,Default,,0000,0000,0000,,Айтуға тым өкінішті нәрсе➡
Dialogue: 0,0:19:53.65,0:19:57.99,Default,,0000,0000,0000,,Бұл қиын...
Dialogue: 0,0:19:53.65,0:19:57.99,Default,,0000,0000,0000,,Өте көп...》
Dialogue: 0,0:19:57.99,0:20:01.50,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:19:57.99,0:20:01.50,Default,,0000,0000,0000,,Сәлем….
Dialogue: 0,0:20:01.50,0:20:05.17,Default,,0000,0000,0000,,Сәттілік Марко!
Dialogue: 0,0:20:01.50,0:20:05.17,Default,,0000,0000,0000,,Ма Марко?
Dialogue: 0,0:20:05.17,0:20:09.17,Default,,0000,0000,0000,,Тама~!
Dialogue: 0,0:20:05.17,0:20:09.17,Default,,0000,0000,0000,,Тама~.
Dialogue: 0,0:20:05.17,0:20:09.17,Default,,0000,0000,0000,,Тама~.
Dialogue: 0,0:20:09.17,0:20:12.17,Default,,0000,0000,0000,,Ах! Таманы сыныпта ұстаңыз
Dialogue: 0,0:20:09.17,0:20:12.17,Default,,0000,0000,0000,,ше?
Dialogue: 0,0:20:12.17,0:20:15.18,Default,,0000,0000,0000,,Сонда?
Dialogue: 0,0:20:12.17,0:20:15.18,Default,,0000,0000,0000,,А, түсіндім.
Dialogue: 0,0:20:15.18,0:20:18.85,Default,,0000,0000,0000,,Қызметкерлер оларды тамақтандырады.
Dialogue: 0,0:20:18.85,0:20:20.85,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:20:18.85,0:20:20.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:20.85,0:20:23.52,Default,,0000,0000,0000,,Чио-чан күткендей
Dialogue: 0,0:20:20.85,0:20:23.52,Default,,0000,0000,0000,,Бұл ақылсыз.
Dialogue: 0,0:20:23.52,0:20:26.85,Default,,0000,0000,0000,,Содан кейін I
Dialogue: 0,0:20:23.52,0:20:26.85,Default,,0000,0000,0000,,Сіз хайуанаттар бағының қызметкері бола аласыз!
Dialogue: 0,0:20:26.85,0:20:31.36,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:20:26.85,0:20:31.36,Default,,0000,0000,0000,,Жоқ, жоқ
Dialogue: 0,0:20:26.85,0:20:31.36,Default,,0000,0000,0000,,Бұл алтын балық ұстаудан басқа.
Dialogue: 0,0:20:31.36,0:20:34.20,Default,,0000,0000,0000,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:20:31.36,0:20:34.20,Default,,0000,0000,0000,,Киімімді шешіп алайын.
Dialogue: 0,0:20:34.20,0:20:37.37,Default,,0000,0000,0000,,Сонымен?
Dialogue: 0,0:20:34.20,0:20:37.37,Default,,0000,0000,0000,,Аташыншы
Dialogue: 0,0:20:34.20,0:20:37.37,Default,,0000,0000,0000,,Негізі, денсаулық орталығы жақын жерде!
Dialogue: 0,0:20:37.37,0:20:41.20,Default,,0000,0000,0000,,Сонда бұл жақсы емес.
Dialogue: 0,0:20:41.20,0:20:44.54,Default,,0000,0000,0000,,А, Тама оянды.
Dialogue: 0,0:20:41.20,0:20:44.54,Default,,0000,0000,0000,,(котенка мияу)
Dialogue: 0,0:20:44.54,0:20:46.54,Default,,0000,0000,0000,,(котенка мияу)
Dialogue: 0,0:20:46.54,0:20:48.71,Default,,0000,0000,0000,,Уау, сондай сүйкімді!
Dialogue: 0,0:20:48.71,0:20:50.71,Default,,0000,0000,0000,,Мен сені ұстаймын!
Dialogue: 0,0:20:52.88,0:20:55.22,Default,,0000,0000,0000,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:20:55.22,0:20:58.22,Default,,0000,0000,0000,,Өте сүйкімді!
Dialogue: 0,0:20:58.22,0:21:01.66,Default,,0000,0000,0000,,О, мен де! Иә, бұл мысық.
Dialogue: 0,0:21:01.66,0:21:04.66,Default,,0000,0000,0000,,Келесі! Мен келесі боламын!
Dialogue: 0,0:21:04.66,0:21:06.66,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:06.66,0:21:08.66,Default,,0000,0000,0000,,А, бұл қауіпті...
Dialogue: 0,0:21:08.66,0:21:10.83,Default,,0000,0000,0000,,А, қазірдің өзінде
Dialogue: 0,0:21:08.66,0:21:10.83,Default,,0000,0000,0000,,Сатоши Бұл қауіпті.
Dialogue: 0,0:21:10.83,0:21:13.67,Default,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:21:10.83,0:21:13.67,Default,,0000,0000,0000,,Сіз оны осылай мұқият ұстайсыз.
Dialogue: 0,0:21:13.67,0:21:16.00,Default,,0000,0000,0000,,А, күнтізбені алдау!
Dialogue: 0,0:21:16.00,0:21:18.01,Default,,0000,0000,0000,,Сакакиді де ұстағыңыз келе ме?
Dialogue: 0,0:21:18.01,0:21:21.18,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:21.18,0:21:25.58,Default,,0000,0000,0000,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:21:28.18,0:21:30.69,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:21:30.69,0:21:33.02,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:21:33.02,0:21:35.69,Default,,0000,0000,0000,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:21:35.69,0:21:38.19,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:21:38.19,0:21:41.20,Default,,0000,0000,0000,,Сәлем! ?
Dialogue: 0,0:21:38.19,0:21:41.20,Default,,0000,0000,0000,,Гяа!
Dialogue: 0,0:21:41.20,0:21:43.70,Default,,0000,0000,0000,,А, мен қашып кеттім.
Dialogue: 0,0:21:45.70,0:21:49.20,Default,,0000,0000,0000,,(Кагураның ауыр тыныс алуы)
Dialogue: 0,0:21:49.20,0:21:52.54,Default,,0000,0000,0000,,Жарайды, анау бала.
Dialogue: 0,0:21:49.20,0:21:52.54,Default,,0000,0000,0000,,Мен жалғыз өмір сүре аламын.
Dialogue: 0,0:21:52.54,0:21:54.64,Default,,0000,0000,0000,,Бұл менің бірінші айтқанымнан басқа!
Dialogue: 0,0:21:56.14,0:22:02.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory