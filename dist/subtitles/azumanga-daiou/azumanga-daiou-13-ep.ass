Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.02,0:01:37.03,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:01:34.02,0:01:37.03,Default,,0000,0000,0000,,Бүгінгі сабақта осымен бітті➡
Dialogue: 0,0:01:37.03,0:01:39.19,Default,,0000,0000,0000,,Барлығың дайынсыңдар ма?
Dialogue: 0,0:01:41.20,0:01:43.37,Default,,0000,0000,0000,,Бұл соңғы емтиханға жақын қалды, солай ма?
Dialogue: 0,0:01:43.37,0:01:45.70,Default,,0000,0000,0000,,Барлығына арналған
Dialogue: 0,0:01:43.37,0:01:45.70,Default,,0000,0000,0000,,Бұл қиын уақыт.
Dialogue: 0,0:01:45.70,0:01:48.54,Default,,0000,0000,0000,,Бірақ соған қарамастан,
Dialogue: 0,0:01:45.70,0:01:48.54,Default,,0000,0000,0000,,Күнделікті ➡
Dialogue: 0,0:01:48.54,0:01:51.54,Default,,0000,0000,0000,,Үй тапсырмасын мұқият орындаймын.
Dialogue: 0,0:01:48.54,0:01:51.54,Default,,0000,0000,0000,,Салиқалы адамдарға➡
Dialogue: 0,0:01:51.54,0:01:53.84,Default,,0000,0000,0000,,Бұл оңай.
Dialogue: 0,0:01:57.71,0:01:59.88,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:01:59.88,0:02:01.82,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:02:01.82,0:02:04.99,Default,,0000,0000,0000,,Чио-чанның үй тапсырмасының толық көшірмесі ➡
Dialogue: 0,0:02:04.99,0:02:09.29,Default,,0000,0000,0000,,Томо-чан сияқты біреу үшін
Dialogue: 0,0:02:04.99,0:02:09.29,Default,,0000,0000,0000,,Бұл мүмкін емес пе?
Dialogue: 0,0:02:11.83,0:02:13.83,Default,,0000,0000,0000,,Күнтізбе де араласқан.
Dialogue: 0,0:02:13.83,0:02:15.83,Default,,0000,0000,0000,,Шулы ақымақ!
Dialogue: 0,0:02:15.83,0:02:18.83,Default,,0000,0000,0000,,Бүгін тағы да ыстық.
Dialogue: 0,0:02:15.83,0:02:18.83,Default,,0000,0000,0000,,Мен қырынған мұз жегім келеді.
Dialogue: 0,0:02:20.84,0:02:22.84,Default,,0000,0000,0000,,Күнтізбе ~.
Dialogue: 0,0:02:20.84,0:02:22.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:22.84,0:02:25.34,Default,,0000,0000,0000,,Бұл түстен кейін математика болды.
Dialogue: 0,0:02:25.34,0:02:27.34,Default,,0000,0000,0000,,Үй тапсырмасын көрсет!
Dialogue: 0,0:02:27.34,0:02:29.51,Default,,0000,0000,0000,,Тағы кездескенше...
Dialogue: 0,0:02:29.51,0:02:32.68,Default,,0000,0000,0000,,Мен де бұрын Юкари-сенсеймен сөйлескенмін.
Dialogue: 0,0:02:29.51,0:02:32.68,Default,,0000,0000,0000,,Сізге жаңа ғана ескерту берілді.
Dialogue: 0,0:02:32.68,0:02:37.35,Default,,0000,0000,0000,,Бұл жолы
Dialogue: 0,0:02:32.68,0:02:37.35,Default,,0000,0000,0000,,Чио-чандікі емес, сенікі.
Dialogue: 0,0:02:37.35,0:02:40.02,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:02:40.02,0:02:42.36,Default,,0000,0000,0000,,Сіз мұны анда-санда өзіңіз жасауыңыз керек.
Dialogue: 0,0:02:42.36,0:02:44.86,Default,,0000,0000,0000,,Жоқ, мен ынталымын.
Dialogue: 0,0:02:44.86,0:02:47.36,Default,,0000,0000,0000,,Үй тапсырмасының көлемі Тыңдаған жоқпын.
Dialogue: 0,0:02:49.36,0:02:51.37,Default,,0000,0000,0000,,Сіз мұны қаламайсыз.
Dialogue: 0,0:02:51.37,0:02:55.04,Default,,0000,0000,0000,,Жарайды, содан кейін келесі.
Dialogue: 0,0:02:51.37,0:02:55.04,Default,,0000,0000,0000,,Мен де саған келемін.
Dialogue: 0,0:02:55.04,0:02:58.21,Default,,0000,0000,0000,,Жақсы. Бұл бәрібір қате болуы мүмкін.
Dialogue: 0,0:02:58.21,0:03:02.14,Default,,0000,0000,0000,,Өзіңіз жасаңыз.
Dialogue: 0,0:02:58.21,0:03:02.14,Default,,0000,0000,0000,,Олай болса, бәрібір.
Dialogue: 0,0:02:58.21,0:03:02.14,Default,,0000,0000,0000,,Маған көрсетсең болғаны!
Dialogue: 0,0:03:02.14,0:03:04.31,Default,,0000,0000,0000,,Өз үлесіңізді қосыңыз!
Dialogue: 0,0:03:04.31,0:03:07.65,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:03:04.31,0:03:07.65,Default,,0000,0000,0000,,Эй, Коёми, бұл жақсы.
Dialogue: 0,0:03:07.65,0:03:11.32,Default,,0000,0000,0000,,Ештеңе айтпа! Екеуің доссыңдар, солай ма?
Dialogue: 0,0:03:11.32,0:03:13.32,Default,,0000,0000,0000,,күрсіну...
Dialogue: 0,0:03:15.32,0:03:19.83,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:03:15.32,0:03:19.83,Default,,0000,0000,0000,,Ой уау~ Қарыз бер, маған қарыз~!
Dialogue: 0,0:03:19.83,0:03:21.83,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:21.83,0:03:27.50,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:03:27.50,0:03:32.84,Default,,0000,0000,0000,,Иә. Рахмет, солай ма?
Dialogue: 0,0:03:27.50,0:03:32.84,Default,,0000,0000,0000,,(Жарық дыбысы)
Dialogue: 0,0:03:32.84,0:03:36.18,Default,,0000,0000,0000,,Иә? Сен не айтып тұрсың?
Dialogue: 0,0:03:36.18,0:03:38.58,Default,,0000,0000,0000,,Сен ақымақ емессің бе?
Dialogue: 0,0:03:42.68,0:03:45.02,Default,,0000,0000,0000,,Идиоттар...
Dialogue: 0,0:03:45.02,0:03:47.86,Default,,0000,0000,0000,,～
Dialogue: 0,0:03:45.02,0:03:47.86,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:03:47.86,0:03:50.56,Default,,0000,0000,0000,,Уау~ Коно Яро!
Dialogue: 0,0:03:47.86,0:03:50.56,Default,,0000,0000,0000,,Ммммммм!
Dialogue: 0,0:03:52.53,0:03:56.36,Default,,0000,0000,0000,,А, ммм, екеуің де.
Dialogue: 0,0:03:52.53,0:03:56.36,Default,,0000,0000,0000,,Тынышталыңыз!
Dialogue: 0,0:03:56.36,0:03:58.37,Default,,0000,0000,0000,,Ааа! Ах...
Dialogue: 0,0:03:58.37,0:04:00.37,Default,,0000,0000,0000,,Таку….
Dialogue: 0,0:04:02.30,0:04:04.50,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:04:12.81,0:04:15.32,Default,,0000,0000,0000,,Идиот.
Dialogue: 0,0:04:15.32,0:04:17.65,Default,,0000,0000,0000,,Тоқта, тоқтат!
Dialogue: 0,0:04:15.32,0:04:17.65,Default,,0000,0000,0000,,(төбелес дауыстары)
Dialogue: 0,0:04:17.65,0:04:20.15,Default,,0000,0000,0000,,Дұрысы, тоқтатыңыз!
Dialogue: 0,0:04:20.15,0:04:22.82,Default,,0000,0000,0000,,Сол себепті күнтізбе сараң.
Dialogue: 0,0:04:22.82,0:04:26.66,Default,,0000,0000,0000,,Мәселе бұл емес.
Dialogue: 0,0:04:22.82,0:04:26.66,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:04:26.66,0:04:29.00,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:04:26.66,0:04:29.00,Default,,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:04:29.00,0:04:31.33,Default,,0000,0000,0000,,Коёми не дейді
Dialogue: 0,0:04:29.00,0:04:31.33,Default,,0000,0000,0000,,Бұл мағынасы бар.
Dialogue: 0,0:04:31.33,0:04:35.50,Default,,0000,0000,0000,,Өйткені, бұл сынақ алдында болды.
Dialogue: 0,0:04:31.33,0:04:35.50,Default,,0000,0000,0000,,Еңбек еткен жақсы...
Dialogue: 0,0:04:35.50,0:04:38.51,Default,,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:04:38.51,0:04:41.34,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:38.51,0:04:41.34,Default,,0000,0000,0000,,Себебі мен күнде ештеңе істемеймін➡
Dialogue: 0,0:04:41.34,0:04:43.68,Default,,0000,0000,0000,,Қазір әрекеттенсеңіз де, ол басталмайды.
Dialogue: 0,0:04:43.68,0:04:45.85,Default,,0000,0000,0000,,Бұл шындыққа айналады.
Dialogue: 0,0:04:45.85,0:04:50.18,Default,,0000,0000,0000,,Хахахаха! Ахаха!
Dialogue: 0,0:04:45.85,0:04:50.18,Default,,0000,0000,0000,,Ах аа... а...
Dialogue: 0,0:04:50.18,0:04:52.52,Default,,0000,0000,0000,,Мына жігіттің түрі осындай.
Dialogue: 0,0:04:52.52,0:04:56.52,Default,,0000,0000,0000,,Сондықтан оны уайымдау босқа кетеді.
Dialogue: 0,0:04:52.52,0:04:56.52,Default,,0000,0000,0000,,Чио-чан.
Dialogue: 0,0:04:52.52,0:04:56.52,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:04:56.52,0:04:59.03,Default,,0000,0000,0000,,Мен мүлде қиналдым.
Dialogue: 0,0:04:59.03,0:05:01.30,Default,,0000,0000,0000,,Бұл сіз туралы! Бұл сіз туралы!
Dialogue: 0,0:05:01.30,0:05:04.80,Default,,0000,0000,0000,,Хи хи.
Dialogue: 0,0:05:01.30,0:05:04.80,Default,,0000,0000,0000,,Уф, не?
Dialogue: 0,0:05:04.80,0:05:07.64,Default,,0000,0000,0000,,Сіз Цуккомиде өте жақсысыз.
Dialogue: 0,0:05:07.64,0:05:10.81,Default,,0000,0000,0000,,Хонма, мен не істерімді білмеймін.
Dialogue: 0,0:05:10.81,0:05:15.48,Default,,0000,0000,0000,,Көрші үйдегі құрма - тұтынушылар жиі жейтін құрал!
Dialogue: 0,0:05:15.48,0:05:18.65,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:05:15.48,0:05:18.65,Default,,0000,0000,0000,,Қане, қазып алайық.
Dialogue: 0,0:05:18.65,0:05:21.35,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:05:18.65,0:05:21.35,Default,,0000,0000,0000,,(соққы дыбысы)
Dialogue: 0,0:05:23.32,0:05:25.99,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:25.99,0:05:28.99,Default,,0000,0000,0000,,(Құлау дыбысы)
Dialogue: 0,0:05:28.99,0:05:30.99,Default,,0000,0000,0000,,Бұл жұмыс істеді...
Dialogue: 0,0:05:30.99,0:05:35.09,Default,,0000,0000,0000,,Сіздің... сол жақ жоғарғы бұрышыңыз Ух...
Dialogue: 0,0:05:37.17,0:05:39.83,Default,,0000,0000,0000,,Сәлем күнтізбе!
Dialogue: 0,0:05:37.17,0:05:39.83,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:05:39.83,0:05:43.00,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:05:39.83,0:05:43.00,Default,,0000,0000,0000,,Сіз әлі ештеңе айтқан жоқсыз, солай ма?
Dialogue: 0,0:05:43.00,0:05:45.01,Default,,0000,0000,0000,,Мен сенен тағы бір жақсылық сұраймын, солай ма?
Dialogue: 0,0:05:45.01,0:05:47.18,Default,,0000,0000,0000,,Үй тапсырмасы т.б.
Dialogue: 0,0:05:47.18,0:05:50.85,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:05:47.18,0:05:50.85,Default,,0000,0000,0000,,Сонда бұл не?
Dialogue: 0,0:05:50.85,0:05:53.05,Default,,0000,0000,0000,,Ағылшын тілінен тест ауқымы Айтыңызшы.
Dialogue: 0,0:05:55.02,0:05:57.19,Default,,0000,0000,0000,,Бұл жақсылық...
Dialogue: 0,0:05:57.19,0:06:00.46,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес~
Dialogue: 0,0:05:57.19,0:06:00.46,Default,,0000,0000,0000,,Себебі мен ұмытып қалдым.
Dialogue: 0,0:06:00.46,0:06:02.62,Default,,0000,0000,0000,,Мен саған ешқашан айтпаймын!
Dialogue: 0,0:06:02.62,0:06:06.63,Default,,0000,0000,0000,,Сен сияқты ұмытшақ адамдар
Dialogue: 0,0:06:02.62,0:06:06.63,Default,,0000,0000,0000,,Өмір бойы ұмытпа!
Dialogue: 0,0:06:06.63,0:06:08.96,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:06:08.96,0:06:11.47,Default,,0000,0000,0000,,Мен ұмытып қалдым.
Dialogue: 0,0:06:11.47,0:06:13.80,Default,,0000,0000,0000,,Ой….
Dialogue: 0,0:06:13.80,0:06:17.31,Default,,0000,0000,0000,,Ұмытсам, ұтылмаймын.
Dialogue: 0,0:06:17.31,0:06:19.31,Default,,0000,0000,0000,,О, Осака да! Бұлай етпе!
Dialogue: 0,0:06:19.31,0:06:21.81,Default,,0000,0000,0000,,Бір минут күте тұрыңыз!
Dialogue: 0,0:06:21.81,0:06:24.48,Default,,0000,0000,0000,,Сен де мені ұмытсаң, қиналып қалар едім!
Dialogue: 0,0:06:24.48,0:06:27.32,Default,,0000,0000,0000,,О! Тіпті Кагура!
Dialogue: 0,0:06:27.32,0:06:31.82,Default,,0000,0000,0000,,Сонымен…
Dialogue: 0,0:06:27.32,0:06:31.82,Default,,0000,0000,0000,,Үшеумізге де махаббат қолдары!
Dialogue: 0,0:06:31.82,0:06:34.32,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:34.32,0:06:39.83,Default,,0000,0000,0000,,Мен барлық пәндер бойынша тест ауқымын ұмытып қалдым.
Dialogue: 0,0:06:39.83,0:06:42.33,Default,,0000,0000,0000,,О! Өте ақымақ!
Dialogue: 0,0:06:42.33,0:06:45.03,Default,,0000,0000,0000,,Мм... Айтпақшы...
Dialogue: 0,0:06:47.00,0:06:49.50,Default,,0000,0000,0000,,Тест тапсыруды қашан бастадыңыз?
Dialogue: 0,0:06:49.50,0:06:52.51,Default,,0000,0000,0000,,Уау! Сіз кестеңізді ұмытып қалдыңыз ба?
Dialogue: 0,0:06:52.51,0:06:56.68,Default,,0000,0000,0000,,Күтілгендей, ұмытылған заттардың Ұлы патшасының есімі
Dialogue: 0,0:06:52.51,0:06:56.68,Default,,0000,0000,0000,,Қалағанын істейтін әйел!
Dialogue: 0,0:06:56.68,0:07:00.11,Default,,0000,0000,0000,,Бұл жігіт...
Dialogue: 0,0:07:00.11,0:07:03.28,Default,,0000,0000,0000,,Міне осылай.
Dialogue: 0,0:07:00.11,0:07:03.28,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:07:03.28,0:07:07.12,Default,,0000,0000,0000,,Келесі сынақтың көлемін айтыңызшы!
Dialogue: 0,0:07:03.28,0:07:07.12,Default,,0000,0000,0000,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:07:07.12,0:07:10.96,Default,,0000,0000,0000,,Айтыңызшы.
Dialogue: 0,0:07:07.12,0:07:10.96,Default,,0000,0000,0000,,Айтыңызшы.
Dialogue: 0,0:07:07.12,0:07:10.96,Default,,0000,0000,0000,,Айтыңызшы.
Dialogue: 0,0:07:10.96,0:07:15.96,Default,,0000,0000,0000,,Сынақ көлемі ~.
Dialogue: 0,0:07:10.96,0:07:15.96,Default,,0000,0000,0000,,Айтыңызшы.
Dialogue: 0,0:07:10.96,0:07:15.96,Default,,0000,0000,0000,,Мен саған не үйретерімді білмеймін.
Dialogue: 0,0:07:15.96,0:07:19.47,Default,,0000,0000,0000,,Айтыңызшы.
Dialogue: 0,0:07:15.96,0:07:19.47,Default,,0000,0000,0000,,Айтыңызшы.
Dialogue: 0,0:07:19.47,0:07:24.14,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:07:19.47,0:07:24.14,Default,,0000,0000,0000,,Сіз сияқты Бонклерлерге!
Dialogue: 0,0:07:24.14,0:07:26.31,Default,,0000,0000,0000,,Бонкрасқа!
Dialogue: 0,0:07:24.14,0:07:26.31,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:07:26.31,0:07:29.11,Default,,0000,0000,0000,,Бұл Бонкраз! ?
Dialogue: 0,0:07:26.31,0:07:29.11,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:07:32.15,0:07:35.32,Default,,0000,0000,0000,,Иә? неге сендер балалар
Dialogue: 0,0:07:32.15,0:07:35.32,Default,,0000,0000,0000,,Сіз тынышсыз ба?
Dialogue: 0,0:07:35.32,0:07:39.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:35.32,0:07:39.32,Default,,0000,0000,0000,,Осака мен Кагура да бірдеңемен дауласуы керек!
Dialogue: 0,0:07:39.32,0:07:42.32,Default,,0000,0000,0000,,үшін? Бонкура?
Dialogue: 0,0:07:42.32,0:07:44.32,Default,,0000,0000,0000,,Зу да зу!
Dialogue: 0,0:07:49.16,0:07:51.17,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,0:07:51.17,0:07:53.33,Default,,0000,0000,0000,,Бонкраз деген кім?
Dialogue: 0,0:07:51.17,0:07:53.33,Default,,0000,0000,0000,,Бонкраз деген кім?
Dialogue: 0,0:07:53.33,0:07:56.17,Default,,0000,0000,0000,,Хмм... мм.
Dialogue: 0,0:07:56.17,0:08:00.78,Default,,0000,0000,0000,,Жарайды, егер көп айтсаң.
Dialogue: 0,0:07:56.17,0:08:00.78,Default,,0000,0000,0000,,Мен енді сенен сұрамаймын!
Dialogue: 0,0:08:00.78,0:08:05.28,Default,,0000,0000,0000,,Егер сіз бәрібір диапазонды білмесеңіз
Dialogue: 0,0:08:00.78,0:08:05.28,Default,,0000,0000,0000,,Әр түкпір-түкпірді зерттегенше!
Dialogue: 0,0:08:05.28,0:08:07.48,Default,,0000,0000,0000,,Иә! Үш адам бірге жұмыс істейді!
Dialogue: 0,0:08:09.45,0:08:12.45,Default,,0000,0000,0000,,Маған қара~ Мен оны саған қайтарамын~!
Dialogue: 0,0:08:15.29,0:08:17.79,Default,,0000,0000,0000,,Бонкрастың атынан
Dialogue: 0,0:08:15.29,0:08:17.79,Default,,0000,0000,0000,,Оны киіңіз!
Dialogue: 0,0:08:17.79,0:08:22.46,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:22.46,0:08:25.13,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:08:22.46,0:08:25.13,Default,,0000,0000,0000,,Мен мұнда түсінбедім...
Dialogue: 0,0:08:25.13,0:08:27.14,Default,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:08:27.14,0:08:30.14,Default,,0000,0000,0000,,Дүрбелең болмаңыз, бірге жұмыс жасайық
Dialogue: 0,0:08:27.14,0:08:30.14,Default,,0000,0000,0000,,Бірдеңе болады!
Dialogue: 0,0:08:30.14,0:08:35.48,Default,,0000,0000,0000,,Эй, Коёмиден кешірім сұра.
Dialogue: 0,0:08:30.14,0:08:35.48,Default,,0000,0000,0000,,Маған тест көлемін айтыңызшы...
Dialogue: 0,0:08:35.48,0:08:38.08,Default,,0000,0000,0000,,Жеңілсең, ұтыласың!
Dialogue: 0,0:08:40.15,0:08:42.15,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:08:40.15,0:08:42.15,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:42.15,0:08:44.15,Default,,0000,0000,0000,,«Брюс Ли»➡
Dialogue: 0,0:08:44.15,0:08:47.99,Default,,0000,0000,0000,,«Көк» сіздің фамилияңыз ба?
Dialogue: 0,0:08:44.15,0:08:47.99,Default,,0000,0000,0000,,Бұл кенеттен...
Dialogue: 0,0:08:47.99,0:08:51.99,Default,,0000,0000,0000,,Ахахха! Бұл ақымақ. Сен не айтып тұрсың?
Dialogue: 0,0:08:51.99,0:08:55.66,Default,,0000,0000,0000,,«Брюс Ли» - геджин, солай ма?
Dialogue: 0,0:08:51.99,0:08:55.66,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:08:55.66,0:08:59.06,Default,,0000,0000,0000,,Сондықтан «Үш» оның фамилиясы.
Dialogue: 0,0:09:01.77,0:09:04.11,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:04.11,0:09:06.11,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:09:06.11,0:09:09.44,Default,,0000,0000,0000,,Солай ма? Сіздің даналығыңыз керемет!
Dialogue: 0,0:09:09.44,0:09:11.45,Default,,0000,0000,0000,,Әрине.
Dialogue: 0,0:09:11.45,0:09:16.62,Default,,0000,0000,0000,,Хона «Бір» және «Екі»
Dialogue: 0,0:09:11.45,0:09:16.62,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:09:16.62,0:09:20.62,Default,,0000,0000,0000,,Яааа~! Айя! Хооооо!
Dialogue: 0,0:09:20.62,0:09:26.32,Default,,0000,0000,0000,,Көк бестің айналасында
Dialogue: 0,0:09:20.62,0:09:26.32,Default,,0000,0000,0000,,Мүмкін Джеки Чанмен...
Dialogue: 0,0:09:29.13,0:09:31.13,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:31.13,0:09:33.83,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:09:36.97,0:09:39.97,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:09:43.48,0:09:45.48,Default,,0000,0000,0000,,Бонкура жиналса да➡
Dialogue: 0,0:09:45.48,0:09:48.48,Default,,0000,0000,0000,,Ештеңе жасауға болмайтыны анықталды.
Dialogue: 0,0:09:45.48,0:09:48.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:48.48,0:09:50.99,Default,,0000,0000,0000,,Бірақ ертең сынақ!
Dialogue: 0,0:09:50.99,0:09:53.49,Default,,0000,0000,0000,,Мен бірдеңе істеуім керек деп ойладым...
Dialogue: 0,0:09:53.49,0:09:57.66,Default,,0000,0000,0000,,Бірақ сыныптың мазмұны т.б.
Dialogue: 0,0:09:53.49,0:09:57.66,Default,,0000,0000,0000,,Мен ештеңе жазбадым...
Dialogue: 0,0:09:57.66,0:10:00.83,Default,,0000,0000,0000,,Дұрыс, Сакаки...
Dialogue: 0,0:10:00.83,0:10:04.00,Default,,0000,0000,0000,,Өтінемін! сіздің дәптеріңіз
Dialogue: 0,0:10:00.83,0:10:04.00,Default,,0000,0000,0000,,Маған мынаны көрсете аласыз ба?
Dialogue: 0,0:10:04.00,0:10:07.34,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:10:07.34,0:10:09.34,Default,,0000,0000,0000,,Әй, рахмет!
Dialogue: 0,0:10:09.34,0:10:12.01,Default,,0000,0000,0000,,Сізде не болуы керек
Dialogue: 0,0:10:09.34,0:10:12.01,Default,,0000,0000,0000,,Ол қарсылас!
Dialogue: 0,0:10:12.01,0:10:14.51,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:10:14.51,0:10:19.01,Default,,0000,0000,0000,,Енді неден бастау керек?
Dialogue: 0,0:10:19.01,0:10:24.02,Default,,0000,0000,0000,,《Мен білмеймін...
Dialogue: 0,0:10:19.01,0:10:24.02,Default,,0000,0000,0000,,Білмеймін, білмеймін! 》
Dialogue: 0,0:10:19.01,0:10:24.02,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:10:24.02,0:10:28.02,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:10:28.02,0:10:32.02,Default,,0000,0000,0000,,《Мен білмеймін...
Dialogue: 0,0:10:28.02,0:10:32.02,Default,,0000,0000,0000,,Хмм, білмеймін, білмеймін! 》
Dialogue: 0,0:10:34.86,0:10:38.53,Default,,0000,0000,0000,,《Мен білмеймін...
Dialogue: 0,0:10:34.86,0:10:38.53,Default,,0000,0000,0000,,Мен білмеймін, білмеймін! 》
Dialogue: 0,0:10:38.53,0:10:42.87,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:38.53,0:10:42.87,Default,,0000,0000,0000,,《Мынау не, Сакакидің дуды?
Dialogue: 0,0:10:42.87,0:10:45.54,Default,,0000,0000,0000,,Сізде көркемдік сезім жоқ~》
Dialogue: 0,0:10:45.54,0:10:48.71,Default,,0000,0000,0000,,Сакаки~ Рахмет~.
Dialogue: 0,0:10:48.71,0:10:52.21,Default,,0000,0000,0000,,Мен қазір жай ғана жазбаларға қарасам да
Dialogue: 0,0:10:48.71,0:10:52.21,Default,,0000,0000,0000,,Мен шынымен түсінбеймін.
Dialogue: 0,0:10:52.21,0:10:54.21,Default,,0000,0000,0000,,Олай болса!
Dialogue: 0,0:10:52.21,0:10:54.21,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:10:56.22,0:10:58.62,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:01.99,0:11:04.49,Default,,0000,0000,0000,,(Шоқ дыбысы)
Dialogue: 0,0:11:04.49,0:11:06.49,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:11:06.49,0:11:09.00,Default,,0000,0000,0000,,Сенсей.
Dialogue: 0,0:11:09.00,0:11:13.67,Default,,0000,0000,0000,,Иә? Бұл не, Осака?
Dialogue: 0,0:11:09.00,0:11:13.67,Default,,0000,0000,0000,,Менің сұрағым бар...
Dialogue: 0,0:11:13.67,0:11:16.34,Default,,0000,0000,0000,,Ал... сынақ жақындаған сайын ➡
Dialogue: 0,0:11:16.34,0:11:19.01,Default,,0000,0000,0000,,Тіпті Осакада
Dialogue: 0,0:11:16.34,0:11:19.01,Default,,0000,0000,0000,,Сіз оқуға қызығасыз ба?
Dialogue: 0,0:11:19.01,0:11:22.18,Default,,0000,0000,0000,,Олай болса, менен кез келген нәрсені сұрай аласыз.
Dialogue: 0,0:11:22.18,0:11:25.35,Default,,0000,0000,0000,,Бұл... Америка...
Dialogue: 0,0:11:22.18,0:11:25.35,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:11:25.35,0:11:29.18,Default,,0000,0000,0000,,Америкада...
Dialogue: 0,0:11:25.35,0:11:29.18,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:11:29.18,0:11:32.35,Default,,0000,0000,0000,,Сіз аяқ киіммен кіресіз бе?
Dialogue: 0,0:11:32.35,0:11:34.36,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:11:34.36,0:11:36.66,Default,,0000,0000,0000,,Шынымен, егер….
Dialogue: 0,0:11:38.69,0:11:42.36,Default,,0000,0000,0000,,Жолда иттің тезегін басып қалды...
Dialogue: 0,0:11:38.69,0:11:42.36,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:42.36,0:11:46.70,Default,,0000,0000,0000,,Мен байқамай үйге барсам...
Dialogue: 0,0:11:42.36,0:11:46.70,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:11:46.70,0:11:49.54,Default,,0000,0000,0000,,Американдық әке мен шеше➡
Dialogue: 0,0:11:49.54,0:11:53.54,Default,,0000,0000,0000,,Үлкен ұл мен қызы бірге
Dialogue: 0,0:11:49.54,0:11:53.54,Default,,0000,0000,0000,,Нәжіске бас, байқама➡
Dialogue: 0,0:11:53.54,0:11:56.04,Default,,0000,0000,0000,,Үйге барсаң...
Dialogue: 0,0:11:56.04,0:12:01.98,Default,,0000,0000,0000,,♬ (мырылдау)
Dialogue: 0,0:12:01.98,0:12:04.15,Default,,0000,0000,0000,,Бұл көп орын.
Dialogue: 0,0:12:01.98,0:12:04.15,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:12:04.15,0:12:06.15,Default,,0000,0000,0000,,Сіз ештеңе істеп жатқан жоқсыз ба?
Dialogue: 0,0:12:06.15,0:12:08.16,Default,,0000,0000,0000,,Ертең сынақ.
Dialogue: 0,0:12:08.16,0:12:10.16,Default,,0000,0000,0000,,А... Иә.
Dialogue: 0,0:12:10.16,0:12:12.16,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:12.16,0:12:17.83,Default,,0000,0000,0000,,Хехехе хехехе!
Dialogue: 0,0:12:17.83,0:12:23.17,Default,,0000,0000,0000,,Ахахха! Ахахха! Ахахха!
Dialogue: 0,0:12:23.17,0:12:26.67,Default,,0000,0000,0000,,Менің құпия жоспарым бар! Мынаны қара!
Dialogue: 0,0:12:26.67,0:12:29.17,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:31.68,0:12:36.85,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:12:31.68,0:12:36.85,Default,,0000,0000,0000,,Фуфуфу яма.
Dialogue: 0,0:12:31.68,0:12:36.85,Default,,0000,0000,0000,,Yama?
Dialogue: 0,0:12:36.85,0:12:39.85,Default,,0000,0000,0000,,Мен қолымнан келгеннің бәрін жасадым!
Dialogue: 0,0:12:36.85,0:12:39.85,Default,,0000,0000,0000,,Бұл құпия жоспар ма?
Dialogue: 0,0:12:39.85,0:12:44.53,Default,,0000,0000,0000,,Атарумо Хакуа
Dialogue: 0,0:12:39.85,0:12:44.53,Default,,0000,0000,0000,,Бұл да багуа.
Dialogue: 0,0:12:39.85,0:12:44.53,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:12:44.53,0:12:46.69,Default,,0000,0000,0000,,Сондықтан енді асықпа!
Dialogue: 0,0:12:46.69,0:12:50.70,Default,,0000,0000,0000,,Қазір бәрі жақсы!
Dialogue: 0,0:12:46.69,0:12:50.70,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:12:50.70,0:12:54.87,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:12:50.70,0:12:54.87,Default,,0000,0000,0000,,Қалғандары жақсы ма?
Dialogue: 0,0:12:54.87,0:12:59.71,Default,,0000,0000,0000,,Құдай-ау, бекер қарсылық танытып жатқандар бар.
Dialogue: 0,0:12:59.71,0:13:01.64,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:13:01.64,0:13:05.98,Default,,0000,0000,0000,,Бұл бір түндік қарым-қатынас па?
Dialogue: 0,0:13:01.64,0:13:05.98,Default,,0000,0000,0000,,Қазір есіңе түсіре аласың ба?
Dialogue: 0,0:13:05.98,0:13:10.48,Default,,0000,0000,0000,,Русе~! Ұмытасың!
Dialogue: 0,0:13:05.98,0:13:10.48,Default,,0000,0000,0000,,Иә, иә, ешкімді ұрма!
Dialogue: 0,0:13:10.48,0:13:12.65,Default,,0000,0000,0000,,Барлығына жақсы жаңалық!
Dialogue: 0,0:13:12.65,0:13:16.82,Default,,0000,0000,0000,,Томо-чанның сұрақтар бойынша болжамдары!
Dialogue: 0,0:13:12.65,0:13:16.82,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:13:16.82,0:13:22.16,Default,,0000,0000,0000,,Мысалы, ағылшын!
Dialogue: 0,0:13:16.82,0:13:22.16,Default,,0000,0000,0000,,32 беттік жапон аудармасы міндетті түрде шығады!
Dialogue: 0,0:13:22.16,0:13:24.56,Default,,0000,0000,0000,,Барлығымыз, қазір есімізге түсірейік!
Dialogue: 0,0:13:26.50,0:13:29.10,Default,,0000,0000,0000,,Содан кейін сынақ басталады!
Dialogue: 0,0:13:31.51,0:13:34.18,Default,,0000,0000,0000,,Шық!
Dialogue: 0,0:13:34.18,0:13:36.88,Default,,0000,0000,0000,,? сурет?
Dialogue: 0,0:13:42.18,0:13:45.02,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:13:56.86,0:14:00.80,Default,,0000,0000,0000,,Хмм, 30 ұпай...
Dialogue: 0,0:14:00.80,0:14:03.64,Default,,0000,0000,0000,,Бұл өте қиын болған шығар...
Dialogue: 0,0:14:03.64,0:14:07.84,Default,,0000,0000,0000,,Бұл өте төмен деңгейдегі жекпе-жек болатын сияқты.
Dialogue: 0,0:14:10.31,0:14:12.31,Default,,0000,0000,0000,,Сәлем Сакаки...
Dialogue: 0,0:14:14.32,0:14:17.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:14.32,0:14:17.12,Default,,0000,0000,0000,,Жоқ, бұл ештеңе емес...
Dialogue: 0,0:14:20.15,0:14:22.49,Default,,0000,0000,0000,,Мен Сакакиді соншалықты ақылды деп ойламаппын...
Dialogue: 0,0:14:22.49,0:14:25.99,Default,,0000,0000,0000,,Мен бұл жолы сенімдімін
Dialogue: 0,0:14:22.49,0:14:25.99,Default,,0000,0000,0000,,Ол керемет формада болса керек.
Dialogue: 0,0:14:25.99,0:14:29.66,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:14:25.99,0:14:29.66,Default,,0000,0000,0000,,Мен сенімдімін! Иә.
Dialogue: 0,0:14:29.66,0:14:32.50,Default,,0000,0000,0000,,Каорин
Dialogue: 0,0:14:29.66,0:14:32.50,Default,,0000,0000,0000,,Тестілеуден қанша балл алдың?
Dialogue: 0,0:14:32.50,0:14:34.84,Default,,0000,0000,0000,,Бұл 85 ұпай болды.
Dialogue: 0,0:14:34.84,0:14:37.67,Default,,0000,0000,0000,,Жарайды~ 80 ұпай жинадым.
Dialogue: 0,0:14:37.67,0:14:40.34,Default,,0000,0000,0000,,Бұл жолы салыстырмалы түрде оңай болды.
Dialogue: 0,0:14:40.34,0:14:43.51,Default,,0000,0000,0000,,Оған не болды?
Dialogue: 0,0:14:40.34,0:14:43.51,Default,,0000,0000,0000,,Орташа балл жоғары болуы керек.
Dialogue: 0,0:14:43.51,0:14:45.85,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:14:43.51,0:14:45.85,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:14:45.85,0:14:48.68,Default,,0000,0000,0000,,《Бұл жолы салыстырмалы түрде оңай болды...
Dialogue: 0,0:14:48.68,0:14:50.68,Default,,0000,0000,0000,,Орташа балл жоғары….
Dialogue: 0,0:14:50.68,0:14:54.36,Default,,0000,0000,0000,,Бұл барлығын білдіреді
Dialogue: 0,0:14:50.68,0:14:54.36,Default,,0000,0000,0000,,Бұл жақсы нәрсе...
Dialogue: 0,0:14:54.36,0:14:57.69,Default,,0000,0000,0000,,Мм... бұл...
Dialogue: 0,0:14:57.69,0:14:59.86,Default,,0000,0000,0000,,Мүмкін...
Dialogue: 0,0:14:59.86,0:15:02.06,Default,,0000,0000,0000,,Бұл шынымен жаман ба? 》
Dialogue: 0,0:15:06.30,0:15:08.30,Default,,0000,0000,0000,,Сәлем Осака!
Dialogue: 0,0:15:08.30,0:15:10.80,Default,,0000,0000,0000,,Қалай болды?
Dialogue: 0,0:15:08.30,0:15:10.80,Default,,0000,0000,0000,,Ақан Ақан~.
Dialogue: 0,0:15:10.80,0:15:14.64,Default,,0000,0000,0000,,Иә, бұл жерде ештеңе жоқ.
Dialogue: 0,0:15:10.80,0:15:14.64,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:15:14.64,0:15:17.98,Default,,0000,0000,0000,,Олай болса, кеттік.
Dialogue: 0,0:15:14.64,0:15:17.98,Default,,0000,0000,0000,,Сех!
Dialogue: 0,0:15:17.98,0:15:20.65,Default,,0000,0000,0000,,Иә, мен жеңілдім! Мен 31 ұпай алдым!
Dialogue: 0,0:15:20.65,0:15:23.48,Default,,0000,0000,0000,,Хехехе, мен жасадым! 42 ұпай!
Dialogue: 0,0:15:23.48,0:15:27.66,Default,,0000,0000,0000,,Уау~ Осакадан жеңілу...
Dialogue: 0,0:15:23.48,0:15:27.66,Default,,0000,0000,0000,,Эхе~.
Dialogue: 0,0:15:27.66,0:15:30.16,Default,,0000,0000,0000,,Иә, Бонкраз!
Dialogue: 0,0:15:30.16,0:15:33.66,Default,,0000,0000,0000,,«Бонкрас» деп өзім айтсам не істеуім керек?
Dialogue: 0,0:15:30.16,0:15:33.66,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:15:33.66,0:15:36.16,Default,,0000,0000,0000,,Сонымен?
Dialogue: 0,0:15:33.66,0:15:36.16,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:36.16,0:15:38.33,Default,,0000,0000,0000,,Сізде қанша ұпай бар?
Dialogue: 0,0:15:38.33,0:15:41.50,Default,,0000,0000,0000,,Амал жоқ, мақтануға тырысқаның сондай жақсы! ?
Dialogue: 0,0:15:41.50,0:15:44.67,Default,,0000,0000,0000,,30 ұпай!
Dialogue: 0,0:15:41.50,0:15:44.67,Default,,0000,0000,0000,,Ой….
Dialogue: 0,0:15:44.67,0:15:47.51,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:15:44.67,0:15:47.51,Default,,0000,0000,0000,,Менен де жамансың!
Dialogue: 0,0:15:47.51,0:15:52.51,Default,,0000,0000,0000,,Өйткені, мен 31 ұпай алдым!
Dialogue: 0,0:15:52.51,0:15:56.02,Default,,0000,0000,0000,,Уау~ мен жеңіліп қалдым! Қарғыс атсын!
Dialogue: 0,0:15:56.02,0:15:59.85,Default,,0000,0000,0000,,Бұл өте жиіркенішті.
Dialogue: 0,0:15:56.02,0:15:59.85,Default,,0000,0000,0000,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:15:59.85,0:16:02.62,Default,,0000,0000,0000,,Эй, рычаг қандай?
Dialogue: 0,0:16:02.62,0:16:08.13,Default,,0000,0000,0000,,Мен 42 ұпай алдым
Dialogue: 0,0:16:02.62,0:16:08.13,Default,,0000,0000,0000,,Бұл оның Бонкрастың көшбасшысы екенін білдіре ме?
Dialogue: 0,0:16:08.13,0:16:10.63,Default,,0000,0000,0000,,Жоқ, мені басшы десеңіз де...
Dialogue: 0,0:16:10.63,0:16:13.13,Default,,0000,0000,0000,,Мен сені мүлде қызғанбаймын...
Dialogue: 0,0:16:13.13,0:16:15.30,Default,,0000,0000,0000,,Иә? Солай ма?
Dialogue: 0,0:16:15.30,0:16:17.30,Default,,0000,0000,0000,,Бірінші орында, Бонкраз➡ ретінде
Dialogue: 0,0:16:17.30,0:16:20.60,Default,,0000,0000,0000,,Ұпай неғұрлым төмен болса
Dialogue: 0,0:16:17.30,0:16:20.60,Default,,0000,0000,0000,,Бұл керемет емес пе?
Dialogue: 0,0:16:17.30,0:16:20.60,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,0:16:23.48,0:16:25.65,Default,,0000,0000,0000,,Бұл қандай көздер?
Dialogue: 0,0:16:25.65,0:16:29.48,Default,,0000,0000,0000,,Көшбасшы!
Dialogue: 0,0:16:25.65,0:16:29.48,Default,,0000,0000,0000,,Мен сенің соңынан еремін!
Dialogue: 0,0:16:29.48,0:16:32.65,Default,,0000,0000,0000,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:16:29.48,0:16:32.65,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:16:32.65,0:16:34.66,Default,,0000,0000,0000,,Көшбасшы!
Dialogue: 0,0:16:34.66,0:16:38.49,Default,,0000,0000,0000,,Шамамен 30 немесе 31 ұпай
Dialogue: 0,0:16:34.66,0:16:38.49,Default,,0000,0000,0000,,Бұл көп өзгеріс әкелмейтін шығар!
Dialogue: 0,0:16:38.49,0:16:42.33,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:16:38.49,0:16:42.33,Default,,0000,0000,0000,,Жеңіс - бұл бір ұпай болса да жеңіс.
Dialogue: 0,0:16:42.33,0:16:44.67,Default,,0000,0000,0000,,Уау, бұл сүйкімді.
Dialogue: 0,0:16:44.67,0:16:48.17,Default,,0000,0000,0000,,Жоқ, сізден артық.
Dialogue: 0,0:16:44.67,0:16:48.17,Default,,0000,0000,0000,,Ол сүйкімді және өзіне сенімді.
Dialogue: 0,0:16:48.17,0:16:51.51,Default,,0000,0000,0000,,Уау, бұл тітіркендіргіш...
Dialogue: 0,0:16:48.17,0:16:51.51,Default,,0000,0000,0000,,Сонымен?
Dialogue: 0,0:16:51.51,0:16:54.34,Default,,0000,0000,0000,,Эй, эй, сен қанша ұпай алдың, Чио-чан?
Dialogue: 0,0:16:54.34,0:16:57.01,Default,,0000,0000,0000,,Эххе~ Коёми-сан қалай болды?
Dialogue: 0,0:16:57.01,0:16:59.51,Default,,0000,0000,0000,,Хмм, бәрі жақсы деп ойлаймын.
Dialogue: 0,0:16:59.51,0:17:02.45,Default,,0000,0000,0000,,Олай болса, құрастырайық
Dialogue: 0,0:16:59.51,0:17:02.45,Default,,0000,0000,0000,,Бір-бірімізге көрсетейік!
Dialogue: 0,0:17:02.45,0:17:05.75,Default,,0000,0000,0000,,Жарайды. Жарайды, кеттік.
Dialogue: 0,0:17:02.45,0:17:05.75,Default,,0000,0000,0000,,Сех!
Dialogue: 0,0:17:08.29,0:17:10.46,Default,,0000,0000,0000,,Ой, 100 ұпай!
Dialogue: 0,0:17:10.46,0:17:14.46,Default,,0000,0000,0000,,Мен бұлай жеңе алмаймын...
Dialogue: 0,0:17:10.46,0:17:14.46,Default,,0000,0000,0000,,Мен 92 ұпай жинадым.
Dialogue: 0,0:17:14.46,0:17:18.47,Default,,0000,0000,0000,,Боқ~ Бұл жолы сәл
Dialogue: 0,0:17:14.46,0:17:18.47,Default,,0000,0000,0000,,Мен жеңетініме сенімді болдым.
Dialogue: 0,0:17:18.47,0:17:23.64,Default,,0000,0000,0000,,Эххе бұл жолы
Dialogue: 0,0:17:18.47,0:17:23.64,Default,,0000,0000,0000,,Сіз жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:17:23.64,0:17:25.84,Default,,0000,0000,0000,,Иә? а….
Dialogue: 0,0:17:29.64,0:17:32.31,Default,,0000,0000,0000,,Хмм... у...
Dialogue: 0,0:17:32.31,0:17:36.65,Default,,0000,0000,0000,,42 ұпай!
Dialogue: 0,0:17:32.31,0:17:36.65,Default,,0000,0000,0000,,30 ұпай!
Dialogue: 0,0:17:32.31,0:17:36.65,Default,,0000,0000,0000,,31 ұпай!
Dialogue: 0,0:17:36.65,0:17:38.99,Default,,0000,0000,0000,,3 адамға барлығы 103 ұпай!
Dialogue: 0,0:17:38.99,0:17:41.16,Default,,0000,0000,0000,,Бонкуразу жеңісі~!
Dialogue: 0,0:17:41.16,0:17:45.83,Default,,0000,0000,0000,,Қырықша… әрине!
Dialogue: 0,0:17:41.16,0:17:45.83,Default,,0000,0000,0000,,Бонкраз емес!
Dialogue: 0,0:17:45.83,0:17:49.33,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:17:45.83,0:17:49.33,Default,,0000,0000,0000,,(шулы дауыс)
Dialogue: 0,0:17:51.33,0:17:53.83,Default,,0000,0000,0000,,Бұл кенеттен!
Dialogue: 0,0:17:53.83,0:17:57.34,Default,,0000,0000,0000,,Бонкрас бүгін таратылады!
Dialogue: 0,0:17:57.34,0:17:59.34,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:57.34,0:17:59.34,Default,,0000,0000,0000,,Себебі➡
Dialogue: 0,0:17:59.34,0:18:02.78,Default,,0000,0000,0000,,Мен қазірдің өзінде
Dialogue: 0,0:17:59.34,0:18:02.78,Default,,0000,0000,0000,,Өйткені ол енді Бонкураван болмайды!
Dialogue: 0,0:18:02.78,0:18:06.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:02.78,0:18:06.11,Default,,0000,0000,0000,,Мен мұны істеудің жолын таптым!
Dialogue: 0,0:18:06.11,0:18:08.62,Default,,0000,0000,0000,,Хехехехе…. бұл!
Dialogue: 0,0:18:08.62,0:18:11.29,Default,,0000,0000,0000,,Чио-чан және Сакаки-чан
Dialogue: 0,0:18:08.62,0:18:11.29,Default,,0000,0000,0000,,Мүмкіндікті алыңыз~!
Dialogue: 0,0:18:11.29,0:18:13.29,Default,,0000,0000,0000,,Ей, көмектес! Оның алдыңғы тістерін жұлып ал—мен оларды тіс дәрігеріне апарамын!
Dialogue: 0,0:18:11.29,0:18:13.29,Default,,0000,0000,0000,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:18:13.29,0:18:15.29,Default,,0000,0000,0000,,Сакаки-чанның спорттық қабілеті!
Dialogue: 0,0:18:15.29,0:18:18.29,Default,,0000,0000,0000,,Чио-чанның данышпандық қабілеті
Dialogue: 0,0:18:15.29,0:18:18.29,Default,,0000,0000,0000,,Оны алыңыз!
Dialogue: 0,0:18:18.29,0:18:21.63,Default,,0000,0000,0000,,Енді тамаша!
Dialogue: 0,0:18:18.29,0:18:21.63,Default,,0000,0000,0000,,Мен сені енді Бонкраз деп атамаймын!
Dialogue: 0,0:18:21.63,0:18:23.63,Default,,0000,0000,0000,,Ахахаха~!
Dialogue: 0,0:18:23.63,0:18:25.63,Default,,0000,0000,0000,,А, енді ше?
Dialogue: 0,0:18:23.63,0:18:25.63,Default,,0000,0000,0000,,Егер мені түрткілегеніме қарсы болмасаңыз...
Dialogue: 0,0:18:25.63,0:18:28.47,Default,,0000,0000,0000,,О, солай.
Dialogue: 0,0:18:25.63,0:18:28.47,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:28.47,0:18:33.31,Default,,0000,0000,0000,,Сондай-ақ, менің кешігіп қалу қабілетім
Dialogue: 0,0:18:28.47,0:18:33.31,Default,,0000,0000,0000,,Мен сізге заттарды ұмыту қабілетін де беремін.
Dialogue: 0,0:18:33.31,0:18:37.14,Default,,0000,0000,0000,,Уха! Ол кетті...
Dialogue: 0,0:18:33.31,0:18:37.14,Default,,0000,0000,0000,,Мен қосымша қабілет алдым.
Dialogue: 0,0:18:37.14,0:18:40.98,Default,,0000,0000,0000,,Сонда не болады?
Dialogue: 0,0:18:37.14,0:18:40.98,Default,,0000,0000,0000,,Иә, солай болады!
Dialogue: 0,0:18:40.98,0:18:43.65,Default,,0000,0000,0000,,Бұл жағдайда, егер...
Dialogue: 0,0:18:43.65,0:18:45.65,Default,,0000,0000,0000,,Қайырлы таң!
Dialogue: 0,0:18:45.65,0:18:48.99,Default,,0000,0000,0000,,Юкари-сенсэй, мен кешігіп қалдым! Кешіріңіз!
Dialogue: 0,0:18:48.99,0:18:51.99,Default,,0000,0000,0000,,Жай отырыңыз.
Dialogue: 0,0:18:48.99,0:18:51.99,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:51.99,0:18:54.99,Default,,0000,0000,0000,,Уряаа~!
Dialogue: 0,0:18:51.99,0:18:54.99,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:57.00,0:18:59.50,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:18:59.50,0:19:02.27,Default,,0000,0000,0000,,Жауабы бар
Dialogue: 0,0:18:59.50,0:19:02.27,Default,,0000,0000,0000,,«Сергітетін жел»!
Dialogue: 0,0:19:02.27,0:19:06.27,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:19:02.27,0:19:06.27,Default,,0000,0000,0000,,Мен оқулығымды ұмытып қалдым! айналады.
Dialogue: 0,0:19:06.27,0:19:10.61,Default,,0000,0000,0000,,Қараңызшы, мен Осака қабілетімнің арқасында біртүрлі болып қалдым.
Dialogue: 0,0:19:10.61,0:19:13.61,Default,,0000,0000,0000,,Жақсы жерге барсам да.
Dialogue: 0,0:19:13.61,0:19:16.12,Default,,0000,0000,0000,,Аа, кешіріңіз.
Dialogue: 0,0:19:16.12,0:19:19.79,Default,,0000,0000,0000,,Бұл сен~
Dialogue: 0,0:19:16.12,0:19:19.79,Default,,0000,0000,0000,,Мықты және адал мінезді басқалар ➡
Dialogue: 0,0:19:19.79,0:19:21.96,Default,,0000,0000,0000,,Бұдан былай ештеңе болмайды.
Dialogue: 0,0:19:21.96,0:19:23.96,Default,,0000,0000,0000,,Тек осындай сынақтар ғана емес➡
Dialogue: 0,0:19:23.96,0:19:26.63,Default,,0000,0000,0000,,Мен келесі жылы емтихан тапсырамын.
Dialogue: 0,0:19:26.63,0:19:29.63,Default,,0000,0000,0000,,Менің ойымша, солай ма?
Dialogue: 0,0:19:26.63,0:19:29.63,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:19:29.63,0:19:31.97,Default,,0000,0000,0000,,Әйтеуір жақсы болады.
Dialogue: 0,0:19:31.97,0:19:35.14,Default,,0000,0000,0000,,Қырықша… әрине!
Dialogue: 0,0:19:31.97,0:19:35.14,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:19:35.14,0:19:39.47,Default,,0000,0000,0000,,Даналық – бұл...
Dialogue: 0,0:19:35.14,0:19:39.47,Default,,0000,0000,0000,,Мен осы орта мектепке қабылдандым деп ойлаймын...
Dialogue: 0,0:19:39.47,0:19:43.98,Default,,0000,0000,0000,,Иә? Мен бұл сөздің мағынасын түсінбеймін.
Dialogue: 0,0:19:43.98,0:19:47.15,Default,,0000,0000,0000,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:19:43.98,0:19:47.15,Default,,0000,0000,0000,,Ағылшын тілінде бірдеңе айта аласыз ба?
Dialogue: 0,0:19:47.15,0:19:49.32,Default,,0000,0000,0000,,Ағылшын тілінде! ?
Dialogue: 0,0:19:47.15,0:19:49.32,Default,,0000,0000,0000,,Ағылшын тілінде.
Dialogue: 0,0:19:49.32,0:19:52.99,Default,,0000,0000,0000,,Аю ю….
Dialogue: 0,0:19:52.99,0:19:55.99,Default,,0000,0000,0000,,Ю... Сен~ Ақымақ!
Dialogue: 0,0:19:55.99,0:19:57.99,Default,,0000,0000,0000,,Не?! ?
Dialogue: 0,0:19:57.99,0:20:01.16,Default,,0000,0000,0000,,Басқаша айтқанда, сен ақымақ болсаң да
Dialogue: 0,0:19:57.99,0:20:01.16,Default,,0000,0000,0000,,Мені өте жақсы қабылдады деп айтқым келеді!
Dialogue: 0,0:20:01.16,0:20:04.33,Default,,0000,0000,0000,,Ақымақ... Бұл тым көп түйіндеме. Ақымақ.
Dialogue: 0,0:20:04.33,0:20:06.50,Default,,0000,0000,0000,,Сіз де➡
Dialogue: 0,0:20:06.50,0:20:11.17,Default,,0000,0000,0000,,Басқаша айтқанда, ағылшын тілінде you~! да!
Dialogue: 0,0:20:06.50,0:20:11.17,Default,,0000,0000,0000,,Бұл да!
Dialogue: 0,0:20:11.17,0:20:15.84,Default,,0000,0000,0000,,Қарғыс атсын... Бұл көңілсіз.
Dialogue: 0,0:20:11.17,0:20:15.84,Default,,0000,0000,0000,,Бұл мүлдем дұрыс!
Dialogue: 0,0:20:15.84,0:20:20.51,Default,,0000,0000,0000,,Хехехе…. Сондықтан мен өзіме қарсыласпын.
Dialogue: 0,0:20:15.84,0:20:20.51,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:20:20.51,0:20:22.52,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:20:20.51,0:20:22.52,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:22.52,0:20:24.69,Default,,0000,0000,0000,,Міне, бұл.
Dialogue: 0,0:20:24.69,0:20:27.19,Default,,0000,0000,0000,,Мұндай қолайсыз жағдайлар
Dialogue: 0,0:20:24.69,0:20:27.19,Default,,0000,0000,0000,,Оны арқаңызға көтеріп жүргенде➡
Dialogue: 0,0:20:27.19,0:20:29.52,Default,,0000,0000,0000,,Сонда да сіз осындасыз➡
Dialogue: 0,0:20:29.52,0:20:33.69,Default,,0000,0000,0000,,Тіпті бұл мен емес.
Dialogue: 0,0:20:29.52,0:20:33.69,Default,,0000,0000,0000,,Бұл емтиханды қандай да бір жолмен тапсыра алатынымды білдіре ме?
Dialogue: 0,0:20:33.69,0:20:36.03,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:20:36.03,0:20:38.03,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:36.03,0:20:38.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:20:38.03,0:20:40.20,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:40.20,0:20:43.20,Default,,0000,0000,0000,,Даналық кіші мектептің екінші курсына дейін
Dialogue: 0,0:20:40.20,0:20:43.20,Default,,0000,0000,0000,,Бұл қалыпты болды ➡
Dialogue: 0,0:20:43.20,0:20:45.60,Default,,0000,0000,0000,,Орта мектептің үшінші курс студенті болғаннан кейін
Dialogue: 0,0:20:43.20,0:20:45.60,Default,,0000,0000,0000,,Сіз кенеттен оқуды бастадыңыз.
Dialogue: 0,0:20:47.71,0:20:51.71,Default,,0000,0000,0000,,Иә! Оған дейін
Dialogue: 0,0:20:47.71,0:20:51.71,Default,,0000,0000,0000,,Мен мүлде оқымадым.
Dialogue: 0,0:20:51.71,0:20:55.72,Default,,0000,0000,0000,,Оқулықтар жаңа сияқты!
Dialogue: 0,0:20:51.71,0:20:55.72,Default,,0000,0000,0000,,Бұл сізді мақтаныш сезіміне бөлей ме?
Dialogue: 0,0:20:55.72,0:20:57.72,Default,,0000,0000,0000,,Сонымен біздің орта мектепте?
Dialogue: 0,0:20:57.72,0:21:00.82,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:20:57.72,0:21:00.82,Default,,0000,0000,0000,,Егер сіз тырыссаңыз, мұны істей аласыз.
Dialogue: 0,0:21:00.82,0:21:04.32,Default,,0000,0000,0000,,Жақсы. Жоқ, күнтізбе
Dialogue: 0,0:21:00.82,0:21:04.32,Default,,0000,0000,0000,,Мен сізді осы жерден алатыныңызды естідім.
Dialogue: 0,0:21:04.32,0:21:07.66,Default,,0000,0000,0000,,Содан кейін, Коёми-санмен.
Dialogue: 0,0:21:04.32,0:21:07.66,Default,,0000,0000,0000,,Орта мектепке бірге барғыңыз келе ме?
Dialogue: 0,0:21:07.66,0:21:10.16,Default,,0000,0000,0000,,Жоқ, олай емес...
Dialogue: 0,0:21:10.16,0:21:14.67,Default,,0000,0000,0000,,Болды~ Сосын мен де аламын десем, Коёми➡ деді
Dialogue: 0,0:21:14.67,0:21:19.17,Default,,0000,0000,0000,,Хун: Сатоши үшін бұл мүмкін емес.
Dialogue: 0,0:21:14.67,0:21:19.17,Default,,0000,0000,0000,,Өйткені сіз осындай нәрсені айттыңыз.
Dialogue: 0,0:21:19.17,0:21:21.51,Default,,0000,0000,0000,,Сондықтан мен көп оқыдым.
Dialogue: 0,0:21:21.51,0:21:26.35,Default,,0000,0000,0000,,Нәтижесі жарияланғанда, менің өткенімді айтты.
Dialogue: 0,0:21:21.51,0:21:26.35,Default,,0000,0000,0000,,Білсең күнтізбенің беті!
Dialogue: 0,0:21:26.35,0:21:29.02,Default,,0000,0000,0000,,Куу~ Мен ұмыта алмаймын~!
Dialogue: 0,0:21:29.02,0:21:32.85,Default,,0000,0000,0000,,Егер сізді бірдеңе ынталандырса
Dialogue: 0,0:21:29.02,0:21:32.85,Default,,0000,0000,0000,,Сондықтан мұны жасауға болады.
Dialogue: 0,0:21:32.85,0:21:35.85,Default,,0000,0000,0000,,Келіңдер, бәрің
Dialogue: 0,0:21:32.85,0:21:35.85,Default,,0000,0000,0000,,Маған жомарт мақтау көрсет!
Dialogue: 0,0:21:37.86,0:21:40.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:37.86,0:21:40.19,Default,,0000,0000,0000,,Неліктен адамдарға ұнамайды➡
Dialogue: 0,0:21:40.19,0:21:42.20,Default,,0000,0000,0000,,Мен бар күшімді салуым керек пе?
Dialogue: 0,0:21:42.20,0:21:44.20,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:44.20,0:21:48.70,Default,,0000,0000,0000,,Жоқ... бұрынғыдан.
Dialogue: 0,0:21:44.20,0:21:48.70,Default,,0000,0000,0000,,Бастауыш сыныптан бері солай.
Dialogue: 0,0:21:48.70,0:21:52.04,Default,,0000,0000,0000,,Бұл менмін.
Dialogue: 0,0:21:48.70,0:21:52.04,Default,,0000,0000,0000,,Жаман көрінеді!
Dialogue: 0,0:21:52.04,0:21:54.64,Default,,0000,0000,0000,,Біліңіз.
Dialogue: 0,0:21:52.04,0:21:54.64,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:21:56.14,0:22:02.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory