Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:42.03,0:01:44.20,Default,,0000,0000,0000,,Бәрі де шарасыз.
Dialogue: 0,0:01:44.20,0:01:48.54,Default,,0000,0000,0000,,Не? Сіз мұны жай сөз тіркесі сияқты айтып отырсыз. Сіз де емтихан тапсырасыз, солай ма?
Dialogue: 0,0:01:48.54,0:01:51.87,Default,,0000,0000,0000,,Ахаха! Уайымдама!
Dialogue: 0,0:01:51.87,0:01:55.88,Default,,0000,0000,0000,,Мен өте жақсымын
Dialogue: 0,0:01:51.87,0:01:55.88,Default,,0000,0000,0000,,Менде тамаша идея болды.
Dialogue: 0,0:01:55.88,0:01:57.88,Default,,0000,0000,0000,,Идея?
Dialogue: 0,0:01:55.88,0:01:57.88,Default,,0000,0000,0000,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:01:57.88,0:02:02.15,Default,,0000,0000,0000,,Чио-чан емтиханға қатыспайды, себебі ол шетелде оқиды, солай ма?
Dialogue: 0,0:01:57.88,0:02:02.15,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:02:02.15,0:02:06.32,Default,,0000,0000,0000,,Егер мен шетелде оқысам,
Dialogue: 0,0:02:02.15,0:02:06.32,Default,,0000,0000,0000,,Емтихан тапсырудың қажеті жоқ!
Dialogue: 0,0:02:06.32,0:02:08.66,Default,,0000,0000,0000,,Мен өте ақылдымын!
Dialogue: 0,0:02:08.66,0:02:10.66,Default,,0000,0000,0000,,Содан кейін мұны жасаңыз.
Dialogue: 0,0:02:10.66,0:02:13.16,Default,,0000,0000,0000,,Әй, сөздік кітап!
Dialogue: 0,0:02:13.16,0:02:16.17,Default,,0000,0000,0000,,Маған сұрақ қойыңыз!
Dialogue: 0,0:02:13.16,0:02:16.17,Default,,0000,0000,0000,,Бұл кенеттен...
Dialogue: 0,0:02:16.17,0:02:20.17,Default,,0000,0000,0000,,Иә~
Dialogue: 0,0:02:16.17,0:02:20.17,Default,,0000,0000,0000,,Жазғы жемістер туралы айтсақ!
Dialogue: 0,0:02:20.17,0:02:22.34,Default,,0000,0000,0000,,А... Бұл не...?
Dialogue: 0,0:02:22.34,0:02:24.67,Default,,0000,0000,0000,,Жаздың бәрі қарбыз туралы.
Dialogue: 0,0:02:24.67,0:02:28.87,Default,,0000,0000,0000,,Боу! Дұрыс жауап – «хурма»!
Dialogue: 0,0:02:24.67,0:02:28.87,Default,,0000,0000,0000,,Өйткені қазір жаз!
Dialogue: 0,0:02:32.51,0:02:34.68,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:02:34.68,0:02:37.35,Default,,0000,0000,0000,,Сенімді болғаным үшін кешіріңіз, бірақ...
Dialogue: 0,0:02:37.35,0:02:41.36,Default,,0000,0000,0000,,Сонда көліктерді қирататын адам кім?
Dialogue: 0,0:02:41.36,0:02:45.86,Default,,0000,0000,0000,,Юкари Сенсей?
Dialogue: 0,0:02:41.36,0:02:45.86,Default,,0000,0000,0000,,Мен сіздің сезіміңізді түсінемін, бірақ олай емес.
Dialogue: 0,0:02:45.86,0:02:48.36,Default,,0000,0000,0000,,Сонымен, сіз бұзу мердігерісіз бе?
Dialogue: 0,0:02:48.36,0:02:51.87,Default,,0000,0000,0000,,Боу! Дұрыс жауап - тіс дәрігері!
Dialogue: 0,0:02:51.87,0:02:54.20,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:02:54.20,0:02:56.40,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:58.37,0:03:00.48,Default,,0000,0000,0000,,А, сен не істеп жатырсың?
Dialogue: 0,0:03:00.48,0:03:02.98,Default,,0000,0000,0000,,Чио-чанға
Dialogue: 0,0:03:00.48,0:03:02.98,Default,,0000,0000,0000,,Ол сұрақ қойды.
Dialogue: 0,0:03:02.98,0:03:04.98,Default,,0000,0000,0000,,Иә~ Қандай~?
Dialogue: 0,0:03:04.98,0:03:08.82,Default,,0000,0000,0000,,Полициямен жаман қарым-қатынаста болған қандай құс?
Dialogue: 0,0:03:04.98,0:03:08.82,Default,,0000,0000,0000,,Герон?
Dialogue: 0,0:03:08.82,0:03:10.99,Default,,0000,0000,0000,,Ах! ? Мен бірден жауап бердім!
Dialogue: 0,0:03:10.99,0:03:13.66,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:03:10.99,0:03:13.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:13.66,0:03:17.16,Default,,0000,0000,0000,,Сонда Осака қамалын салған кім?
Dialogue: 0,0:03:13.66,0:03:17.16,Default,,0000,0000,0000,,Ұста?
Dialogue: 0,0:03:17.16,0:03:20.16,Default,,0000,0000,0000,,Жапон тілі – Жапонияның тілі.
Dialogue: 0,0:03:17.16,0:03:20.16,Default,,0000,0000,0000,,Сонымен, ағылшын тілі қандай тіл?
Dialogue: 0,0:03:20.16,0:03:22.16,Default,,0000,0000,0000,,Жапония, солай ма?
Dialogue: 0,0:03:22.16,0:03:24.50,Default,,0000,0000,0000,,Жүк көлігі асқабақ баклажаны
Dialogue: 0,0:03:22.16,0:03:24.50,Default,,0000,0000,0000,,Оның үстінде қызанақ бар.
Dialogue: 0,0:03:24.50,0:03:27.17,Default,,0000,0000,0000,,Мен өткір қисық алған кезде не болды?
Dialogue: 0,0:03:24.50,0:03:27.17,Default,,0000,0000,0000,,Бұл жылдамдық па?
Dialogue: 0,0:03:27.17,0:03:29.34,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:03:27.17,0:03:29.34,Default,,0000,0000,0000,,(дұрыс дыбыс)
Dialogue: 0,0:03:29.34,0:03:33.51,Default,,0000,0000,0000,,Керемет! Бұл не жігіт?
Dialogue: 0,0:03:29.34,0:03:33.51,Default,,0000,0000,0000,,Иә? Бұл хит!
Dialogue: 0,0:03:33.51,0:03:37.35,Default,,0000,0000,0000,,Чио-чан, сенен сұрайын дегенім бар.
Dialogue: 0,0:03:37.35,0:03:39.35,Default,,0000,0000,0000,,Иә, бұл не?
Dialogue: 0,0:03:39.35,0:03:43.02,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:03:39.35,0:03:43.02,Default,,0000,0000,0000,,Сізге қандай жұмыс сәйкес келеді деп ойлайсыз?
Dialogue: 0,0:03:43.02,0:03:46.19,Default,,0000,0000,0000,,Хмм. Мен келісемін….
Dialogue: 0,0:03:46.19,0:03:50.69,Default,,0000,0000,0000,,Ах, мектеп мұғалімі.
Dialogue: 0,0:03:46.19,0:03:50.69,Default,,0000,0000,0000,,Мен артынан келіп, оның көзі мен аузын жауып, «Сізді екінші Кира болуы мүмкін деген күдікпен қамауға аламыз» дедім.
Dialogue: 0,0:03:46.19,0:03:50.69,Default,,0000,0000,0000,,О!
Dialogue: 0,0:03:50.69,0:03:54.53,Default,,0000,0000,0000,,Осака мырза
Dialogue: 0,0:03:50.69,0:03:54.53,Default,,0000,0000,0000,,Оқушыларды икемді ойлауға тәрбиелеу!
Dialogue: 0,0:03:54.53,0:03:58.20,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:03:54.53,0:03:58.20,Default,,0000,0000,0000,,《Күнтізбе: Менің ойымша...》
Dialogue: 0,0:03:58.20,0:04:01.97,Default,,0000,0000,0000,,Юкари Сенсей!
Dialogue: 0,0:03:58.20,0:04:01.97,Default,,0000,0000,0000,,О~ Осака~!
Dialogue: 0,0:04:01.97,0:04:04.97,Default,,0000,0000,0000,,Мен өзім таңдаған мектепке құжат тапсырған жоқпын.
Dialogue: 0,0:04:01.97,0:04:04.97,Default,,0000,0000,0000,,Бұл тек сенсің.
Dialogue: 0,0:04:04.97,0:04:07.31,Default,,0000,0000,0000,,Тез шешім қабылдаңыз.
Dialogue: 0,0:04:07.31,0:04:12.15,Default,,0000,0000,0000,,Бұл емес.
Dialogue: 0,0:04:07.31,0:04:12.15,Default,,0000,0000,0000,,Мен мектеп мұғалімі боламын.
Dialogue: 0,0:04:12.15,0:04:14.15,Default,,0000,0000,0000,,Не, есі дұрыс! ?
Dialogue: 0,0:04:14.15,0:04:18.32,Default,,0000,0000,0000,,Иә. Чиё Чан
Dialogue: 0,0:04:14.15,0:04:18.32,Default,,0000,0000,0000,,Ол маған жақсы көрінетінін айтты.
Dialogue: 0,0:04:18.32,0:04:21.62,Default,,0000,0000,0000,,Не болды! ?
Dialogue: 0,0:04:18.32,0:04:21.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:23.83,0:04:25.83,Default,,0000,0000,0000,,Кула~ Чийосуке!
Dialogue: 0,0:04:25.83,0:04:29.33,Default,,0000,0000,0000,,Сен, мен
Dialogue: 0,0:04:25.83,0:04:29.33,Default,,0000,0000,0000,,Сіз мені ақымақ деп ойлайсыз!
Dialogue: 0,0:04:29.33,0:04:33.50,Default,,0000,0000,0000,,Мұғалім болу тіпті ақымақ адамның қолынан келетін нәрсе деп ойлайтын шығарсыз!
Dialogue: 0,0:04:33.50,0:04:35.50,Default,,0000,0000,0000,,Дұрыс! Сіз данышпан болғандықтан ғана➡
Dialogue: 0,0:04:35.50,0:04:38.17,Default,,0000,0000,0000,,Түсінбеймін, егер сіз үнсіз әрекет етсеңіз!
Dialogue: 0,0:04:38.17,0:04:42.18,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:04:38.17,0:04:42.18,Default,,0000,0000,0000,,Маған оқуды үйрет!
Dialogue: 0,0:04:42.18,0:04:45.68,Default,,0000,0000,0000,,Сакаки-сан да келе жатыр.
Dialogue: 0,0:04:42.18,0:04:45.68,Default,,0000,0000,0000,,Әй, дұрыс!
Dialogue: 0,0:04:45.68,0:04:52.19,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:04:52.19,0:04:54.36,Default,,0000,0000,0000,,Енді соған біраз күш салайық!
Dialogue: 0,0:04:54.36,0:04:56.69,Default,,0000,0000,0000,,Бірақ котацу қауіпті...
Dialogue: 0,0:04:56.69,0:04:59.96,Default,,0000,0000,0000,,Мен ұйықтап кеткім келеді.
Dialogue: 0,0:04:56.69,0:04:59.96,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:04:59.96,0:05:04.63,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:59.96,0:05:04.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:59.96,0:05:04.63,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:04.63,0:05:13.14,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:13.14,0:05:16.65,Default,,0000,0000,0000,,Бұл емес...
Dialogue: 0,0:05:16.65,0:05:19.31,Default,,0000,0000,0000,,Чива~!
Dialogue: 0,0:05:16.65,0:05:19.31,Default,,0000,0000,0000,,Маған оқуды үйрет!
Dialogue: 0,0:05:19.31,0:05:22.15,Default,,0000,0000,0000,,Чи және басқалары да келе ме?
Dialogue: 0,0:05:22.15,0:05:25.15,Default,,0000,0000,0000,,Иә! Мен Сакаки-санмен бірге оқимын.
Dialogue: 0,0:05:25.15,0:05:28.35,Default,,0000,0000,0000,,Уххх... Аха...
Dialogue: 0,0:05:25.15,0:05:28.35,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:05:30.49,0:05:35.00,Default,,0000,0000,0000,,Оқу?
Dialogue: 0,0:05:30.49,0:05:35.00,Default,,0000,0000,0000,,Иә, иә...
Dialogue: 0,0:05:35.00,0:05:39.00,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:05:42.84,0:05:44.84,Default,,0000,0000,0000,,Жаңа жыл!
Dialogue: 0,0:05:44.84,0:05:48.18,Default,,0000,0000,0000,,Жаңа жыл құтты болсын
Dialogue: 0,0:05:44.84,0:05:48.18,Default,,0000,0000,0000,,Құттықтаймыз!
Dialogue: 0,0:05:48.18,0:05:50.18,Default,,0000,0000,0000,,Чио-чан Фурисоде, иә?
Dialogue: 0,0:05:50.18,0:05:53.18,Default,,0000,0000,0000,,Бұл сізге жақсы көрінеді.
Dialogue: 0,0:05:50.18,0:05:53.18,Default,,0000,0000,0000,,Эхехе….
Dialogue: 0,0:05:53.18,0:05:56.52,Default,,0000,0000,0000,,Уау! Ах~!
Dialogue: 0,0:05:56.52,0:05:59.02,Default,,0000,0000,0000,,Ханя керемет адам!
Dialogue: 0,0:05:59.02,0:06:02.79,Default,,0000,0000,0000,,Әйтеуір... осылай қала береді.
Dialogue: 0,0:05:59.02,0:06:02.79,Default,,0000,0000,0000,,Біз ажырасып жатырмыз!
Dialogue: 0,0:06:02.79,0:06:05.63,Default,,0000,0000,0000,,Жарайды, кездесу орнын шешейік!
Dialogue: 0,0:06:05.63,0:06:09.30,Default,,0000,0000,0000,,Барлығы~ Егер адасып қалсаңыз
Dialogue: 0,0:06:05.63,0:06:09.30,Default,,0000,0000,0000,,Сакаки-чанның айналасына жиналыңдар!
Dialogue: 0,0:06:09.30,0:06:11.80,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,0:06:09.30,0:06:11.80,Default,,0000,0000,0000,,Түсінікті!
Dialogue: 0,0:06:11.80,0:06:13.80,Default,,0000,0000,0000,,Ммм….
Dialogue: 0,0:06:13.80,0:06:17.14,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:06:17.14,0:06:21.48,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:06:17.14,0:06:21.48,Default,,0000,0000,0000,,Ұйқыңыз келген сияқты.
Dialogue: 0,0:06:21.48,0:06:25.15,Default,,0000,0000,0000,,Аа, мен жаңа жыл қоңырауын тыңдап отырып, сабақ оқып жүрдім...
Dialogue: 0,0:06:25.15,0:06:29.82,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:06:25.15,0:06:29.82,Default,,0000,0000,0000,,Ұлттық орталық тесті жақындап қалды...
Dialogue: 0,0:06:29.82,0:06:32.49,Default,,0000,0000,0000,,Жарайды, түсіндім!
Dialogue: 0,0:06:32.49,0:06:36.32,Default,,0000,0000,0000,,Емтиханға қатыспаудың орнына
Dialogue: 0,0:06:32.49,0:06:36.32,Default,,0000,0000,0000,,Мен барлығы үшін дұға етемін!
Dialogue: 0,0:06:36.32,0:06:40.83,Default,,0000,0000,0000,,О! Чио-чанның данышпан күшімен
Dialogue: 0,0:06:36.32,0:06:40.83,Default,,0000,0000,0000,,Маған өтуге рұқсат етіңіз!
Dialogue: 0,0:06:40.83,0:06:42.83,Default,,0000,0000,0000,,Мен?
Dialogue: 0,0:06:44.83,0:06:48.50,Default,,0000,0000,0000,,Ах~ Уақыт келді
Dialogue: 0,0:06:44.83,0:06:48.50,Default,,0000,0000,0000,,Сыйлықты дайында.
Dialogue: 0,0:06:48.50,0:06:50.67,Default,,0000,0000,0000,,Жарайды, биылғы жыл үлкен серпіліс...
Dialogue: 0,0:06:50.67,0:06:56.18,Default,,0000,0000,0000,,Бұл 500 иендік монета!
Dialogue: 0,0:06:50.67,0:06:56.18,Default,,0000,0000,0000,,Уф... Мен де ұтыла алмаймын.
Dialogue: 0,0:06:56.18,0:06:59.51,Default,,0000,0000,0000,,Не! ? Бұл белгі ме? ?
Dialogue: 0,0:06:56.18,0:06:59.51,Default,,0000,0000,0000,,Бұл!
Dialogue: 0,0:06:59.51,0:07:01.62,Default,,0000,0000,0000,,Бұл не, 10 иен?
Dialogue: 0,0:07:01.62,0:07:04.45,Default,,0000,0000,0000,,Олай етпе! Сосын құлайсың.
Dialogue: 0,0:07:04.45,0:07:09.29,Default,,0000,0000,0000,,Жоқ! Бұл 10 иен
Dialogue: 0,0:07:04.45,0:07:09.29,Default,,0000,0000,0000,,Таңдалғанға 10 иен!
Dialogue: 0,0:07:09.29,0:07:12.96,Default,,0000,0000,0000,,О! ?
Dialogue: 0,0:07:09.29,0:07:12.96,Default,,0000,0000,0000,,Біреу мұны айтқанда
Dialogue: 0,0:07:09.29,0:07:12.96,Default,,0000,0000,0000,,Міне, мен көре бастадым!
Dialogue: 0,0:07:12.96,0:07:15.30,Default,,0000,0000,0000,,Неліктен таңдалған?
Dialogue: 0,0:07:15.30,0:07:17.47,Default,,0000,0000,0000,,Бұл 10 иен дегеніміз не?
Dialogue: 0,0:07:17.47,0:07:20.64,Default,,0000,0000,0000,,Неге екені белгісіз, мен оны қандай автоматқа салсам да,
Dialogue: 0,0:07:17.47,0:07:20.64,Default,,0000,0000,0000,,Сіз қайтып келдіңіз...
Dialogue: 0,0:07:20.64,0:07:22.64,Default,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,0:07:24.64,0:07:28.14,Default,,0000,0000,0000,,Күлсін... Ақыры кезек бізге жетті.
Dialogue: 0,0:07:28.14,0:07:31.31,Default,,0000,0000,0000,,Қатты дұға етіңіз.
Dialogue: 0,0:07:31.31,0:07:35.32,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:07:35.32,0:07:38.99,Default,,0000,0000,0000,,《Бәрі бірге
Dialogue: 0,0:07:35.32,0:07:38.99,Default,,0000,0000,0000,,Сіз өтесіз деп үміттенемін...》
Dialogue: 0,0:07:38.99,0:07:41.32,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:07:41.32,0:07:44.02,Default,,0000,0000,0000,,Хэхехехехехе….
Dialogue: 0,0:07:41.32,0:07:44.02,Default,,0000,0000,0000,,Осака мырза….
Dialogue: 0,0:07:46.16,0:07:48.16,Default,,0000,0000,0000,,Барлығы~ Өз байлығыңызды алыңыз~!
Dialogue: 0,0:07:48.16,0:07:50.16,Default,,0000,0000,0000,,Жарайды, алыңыз да, тұрыңыз.
Dialogue: 0,0:07:52.17,0:07:56.00,Default,,0000,0000,0000,,Хэхе!
Dialogue: 0,0:07:56.00,0:07:58.01,Default,,0000,0000,0000,,№8!
Dialogue: 0,0:07:56.00,0:07:58.01,Default,,0000,0000,0000,,№ 15!
Dialogue: 0,0:07:58.01,0:08:00.44,Default,,0000,0000,0000,,Накайоши!
Dialogue: 0,0:07:58.01,0:08:00.44,Default,,0000,0000,0000,,Жамандық!
Dialogue: 0,0:08:00.44,0:08:02.61,Default,,0000,0000,0000,,Еееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее!
Dialogue: 0,0:08:02.61,0:08:06.28,Default,,0000,0000,0000,,Зұлымдық?
Dialogue: 0,0:08:02.61,0:08:06.28,Default,,0000,0000,0000,,Зұлымдық?
Dialogue: 0,0:08:02.61,0:08:06.28,Default,,0000,0000,0000,,Жаман ба?
Dialogue: 0,0:08:06.28,0:08:08.45,Default,,0000,0000,0000,,Иә... жаман...
Dialogue: 0,0:08:08.45,0:08:12.79,Default,,0000,0000,0000,,Уау, бұл рас...
Dialogue: 0,0:08:08.45,0:08:12.79,Default,,0000,0000,0000,,Мен оны бірінші рет көріп тұрмын. Бұл керемет...
Dialogue: 0,0:08:12.79,0:08:15.12,Default,,0000,0000,0000,,Сатоши-чан, бұл өте дәмді...
Dialogue: 0,0:08:15.12,0:08:17.79,Default,,0000,0000,0000,,Жамандық... Не істеуім керек! ?
Dialogue: 0,0:08:17.79,0:08:21.30,Default,,0000,0000,0000,,Бұл туралы не істеуім керек? ?
Dialogue: 0,0:08:17.79,0:08:21.30,Default,,0000,0000,0000,,Оны ағашқа байлаңыз! ?
Dialogue: 0,0:08:21.30,0:08:24.13,Default,,0000,0000,0000,,Байлығың байланғанына сенімдімін
Dialogue: 0,0:08:21.30,0:08:24.13,Default,,0000,0000,0000,,Тазартылған➡
Dialogue: 0,0:08:24.13,0:08:27.14,Default,,0000,0000,0000,,Жаман нәрселер жойылады ма?
Dialogue: 0,0:08:24.13,0:08:27.14,Default,,0000,0000,0000,,Мен бұл туралы естідім.
Dialogue: 0,0:08:27.14,0:08:29.14,Default,,0000,0000,0000,,Онда біз оны байлауымыз керек!
Dialogue: 0,0:08:29.14,0:08:33.64,Default,,0000,0000,0000,,Бірақ байлау керек дейді
Dialogue: 0,0:08:29.14,0:08:33.64,Default,,0000,0000,0000,,Оның орындалғанын жиі естимін.
Dialogue: 0,0:08:33.64,0:08:35.81,Default,,0000,0000,0000,,Иә! ? Бұл жақсы емес!
Dialogue: 0,0:08:35.81,0:08:38.48,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:08:35.81,0:08:38.48,Default,,0000,0000,0000,,Мен не істеуім керек? ?
Dialogue: 0,0:08:38.48,0:08:41.65,Default,,0000,0000,0000,,Бұл енді жақсы емес екеніне сенімдімін.
Dialogue: 0,0:08:38.48,0:08:41.65,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:08:41.65,0:08:44.55,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,0:08:41.65,0:08:44.55,Default,,0000,0000,0000,,Үйге бара жатқанда бірдеңе жеу керек пе?
Dialogue: 0,0:08:46.49,0:08:48.82,Default,,0000,0000,0000,,Бұдан басқа
Dialogue: 0,0:08:46.49,0:08:48.82,Default,,0000,0000,0000,,Дәмді тәттілер сататын дүкен бар.
Dialogue: 0,0:08:48.82,0:08:50.99,Default,,0000,0000,0000,,Сіздің диетаңызға не болды?
Dialogue: 0,0:08:50.99,0:08:54.83,Default,,0000,0000,0000,,Қанттың тиісті мөлшері
Dialogue: 0,0:08:50.99,0:08:54.83,Default,,0000,0000,0000,,Миды белсендіру үшін қажет.
Dialogue: 0,0:08:54.83,0:08:56.83,Default,,0000,0000,0000,,Әйел мұғалім табылды!
Dialogue: 0,0:08:56.83,0:08:59.33,Default,,0000,0000,0000,,Хмм, бұл жаман!
Dialogue: 0,0:08:56.83,0:08:59.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:59.33,0:09:02.27,Default,,0000,0000,0000,,Юкари-чанның жаңа жылдық сыйлығы
Dialogue: 0,0:08:59.33,0:09:02.27,Default,,0000,0000,0000,,Маған жаңа жылдық сыйлық беріңіз!
Dialogue: 0,0:09:02.27,0:09:04.94,Default,,0000,0000,0000,,Оны маған беріңіз~!
Dialogue: 0,0:09:02.27,0:09:04.94,Default,,0000,0000,0000,,Өтінемін!
Dialogue: 0,0:09:04.94,0:09:07.44,Default,,0000,0000,0000,,Ах~ мен ештеңе естімеймін~!
Dialogue: 0,0:09:07.44,0:09:09.44,Default,,0000,0000,0000,,Сараң!
Dialogue: 0,0:09:07.44,0:09:09.44,Default,,0000,0000,0000,,Сараң!
Dialogue: 0,0:09:07.44,0:09:09.44,Default,,0000,0000,0000,,Сараң!
Dialogue: 0,0:09:09.44,0:09:12.28,Default,,0000,0000,0000,,Не?!
Dialogue: 0,0:09:09.44,0:09:12.28,Default,,0000,0000,0000,,Маңыздысы – қазіргі сәт.
Dialogue: 0,0:09:12.28,0:09:16.28,Default,,0000,0000,0000,,Куросава мырза! Танысқаныма қуаныштымын
Dialogue: 0,0:09:12.28,0:09:16.28,Default,,0000,0000,0000,,Құттықтаймыз!
Dialogue: 0,0:09:16.28,0:09:19.79,Default,,0000,0000,0000,,Құттықтаймыз. Барлығы жаңа жылдық сапардан оралды ма?
Dialogue: 0,0:09:19.79,0:09:22.46,Default,,0000,0000,0000,,Иә, ғибадатханада.
Dialogue: 0,0:09:22.46,0:09:24.96,Default,,0000,0000,0000,,Ой, балалар сендер білмедіңдер ме?
Dialogue: 0,0:09:24.96,0:09:26.96,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:09:26.96,0:09:29.97,Default,,0000,0000,0000,,Сол ғибадатхананың ұлы
Dialogue: 0,0:09:26.96,0:09:29.97,Default,,0000,0000,0000,,Сіз университеттен өтпей қалдыңыз ба?
Dialogue: 0,0:09:29.97,0:09:31.97,Default,,0000,0000,0000,,Кикане~.
Dialogue: 0,0:09:31.97,0:09:33.97,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:09:31.97,0:09:33.97,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:09:36.14,0:09:38.14,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:09:43.48,0:09:46.98,Default,,0000,0000,0000,,Енді бұл ұлттық орталық емтиханы!
Dialogue: 0,0:09:46.98,0:09:49.48,Default,,0000,0000,0000,,Мұнда барлығы бірге➡
Dialogue: 0,0:09:49.48,0:09:52.49,Default,,0000,0000,0000,,Жаман балл алайық!
Dialogue: 0,0:09:49.48,0:09:52.49,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:52.49,0:09:55.49,Default,,0000,0000,0000,,Артық емес.
Dialogue: 0,0:09:52.49,0:09:55.49,Default,,0000,0000,0000,,О.
Dialogue: 0,0:09:55.49,0:09:58.16,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:09:55.49,0:09:58.16,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:09:58.16,0:10:01.86,Default,,0000,0000,0000,,Иә, мен саған заклинание үйреттім.
Dialogue: 0,0:09:58.16,0:10:01.86,Default,,0000,0000,0000,,Заклинание?
Dialogue: 0,0:10:04.00,0:10:08.00,Default,,0000,0000,0000,,Варибаши?
Dialogue: 0,0:10:04.00,0:10:08.00,Default,,0000,0000,0000,,Барлығы, сіз оны алдыңыз, солай ма?
Dialogue: 0,0:10:08.00,0:10:10.01,Default,,0000,0000,0000,,Енді тыңдаңыз.
Dialogue: 0,0:10:10.01,0:10:13.01,Default,,0000,0000,0000,,Егер бұл таза бұзылса
Dialogue: 0,0:10:10.01,0:10:13.01,Default,,0000,0000,0000,,Емтихан жақсы өтеді.
Dialogue: 0,0:10:13.01,0:10:15.01,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:10:13.01,0:10:15.01,Default,,0000,0000,0000,,Не?! ?
Dialogue: 0,0:10:15.01,0:10:18.51,Default,,0000,0000,0000,,Иә~ Солай ма?
Dialogue: 0,0:10:15.01,0:10:18.51,Default,,0000,0000,0000,,Мен заклинание туралы бірінші рет естіп тұрмын.
Dialogue: 0,0:10:18.51,0:10:21.68,Default,,0000,0000,0000,,Мен әзірлеген.
Dialogue: 0,0:10:18.51,0:10:21.68,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:21.68,0:10:25.69,Default,,0000,0000,0000,,Жарайды, ол жұмыс істейді.
Dialogue: 0,0:10:21.68,0:10:25.69,Default,,0000,0000,0000,,Рұқсатсыз оны дамытпаңыз!
Dialogue: 0,0:10:25.69,0:10:28.36,Default,,0000,0000,0000,,Барлығы күдіктенеді.
Dialogue: 0,0:10:28.36,0:10:31.56,Default,,0000,0000,0000,,Иә? мен
Dialogue: 0,0:10:28.36,0:10:31.56,Default,,0000,0000,0000,,Мен сізге мысал көрсетемін.
Dialogue: 0,0:10:33.53,0:10:35.70,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:10:35.70,0:10:38.10,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:10:40.54,0:10:42.70,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:10:40.54,0:10:42.70,Default,,0000,0000,0000,,Бұл жақсы емес...
Dialogue: 0,0:10:42.70,0:10:47.04,Default,,0000,0000,0000,,Мен мұны бұрыннан айтуға тырыстым.
Dialogue: 0,0:10:42.70,0:10:47.04,Default,,0000,0000,0000,,Мен ойладым...
Dialogue: 0,0:10:47.04,0:10:51.55,Default,,0000,0000,0000,,Таяқшаның ұшын ұстаңыз
Dialogue: 0,0:10:47.04,0:10:51.55,Default,,0000,0000,0000,,Баяу ашсаңыз...
Dialogue: 0,0:10:51.55,0:10:53.55,Default,,0000,0000,0000,,Қара, таза.
Dialogue: 0,0:10:53.55,0:10:57.55,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:10:53.55,0:10:57.55,Default,,0000,0000,0000,,Ондай қулық бар ма?
Dialogue: 0,0:10:59.72,0:11:05.66,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:10:59.72,0:11:05.66,Default,,0000,0000,0000,,Екіге бөлінгені соншалық...
Dialogue: 0,0:11:05.66,0:11:08.50,Default,,0000,0000,0000,,Осыны пайдалансаңыз, университетке түсе аласыз...
Dialogue: 0,0:11:08.50,0:11:12.50,Default,,0000,0000,0000,,Барлығы~ Тағы бір рет
Dialogue: 0,0:11:08.50,0:11:12.50,Default,,0000,0000,0000,,Маған мысал көрсетіңіз!
Dialogue: 0,0:11:12.50,0:11:15.67,Default,,0000,0000,0000,,Осылайша...
Dialogue: 0,0:11:15.67,0:11:18.67,Default,,0000,0000,0000,,Бұл Томо-чан ба?
Dialogue: 0,0:11:15.67,0:11:18.67,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:18.67,0:11:22.18,Default,,0000,0000,0000,,Ол дұрыс сынбайды!
Dialogue: 0,0:11:18.67,0:11:22.18,Default,,0000,0000,0000,,Иә~
Dialogue: 0,0:11:22.18,0:11:25.68,Default,,0000,0000,0000,,Әй, сен бірінші бұзбадың! ?
Dialogue: 0,0:11:22.18,0:11:25.68,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:11:25.68,0:11:28.85,Default,,0000,0000,0000,,Алда! Мен саған кестеден озып кетпеуіңді айттым!
Dialogue: 0,0:11:28.85,0:11:33.02,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:11:28.85,0:11:33.02,Default,,0000,0000,0000,,Басқаларды тыңда! Кілт~!
Dialogue: 0,0:11:33.02,0:11:37.69,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:11:33.02,0:11:37.69,Default,,0000,0000,0000,,Е, неге ашуланасың?
Dialogue: 0,0:11:37.69,0:11:42.36,Default,,0000,0000,0000,,Күрсіну…. Ақан
Dialogue: 0,0:11:37.69,0:11:42.36,Default,,0000,0000,0000,,Мотомо-чан, мен білмеймін...
Dialogue: 0,0:11:42.36,0:11:44.37,Default,,0000,0000,0000,,Қандай өтірік! ?
Dialogue: 0,0:11:44.37,0:11:50.04,Default,,0000,0000,0000,,А, анау... Мен бәріне тұмар дайындап қойдым...
Dialogue: 0,0:11:50.04,0:11:52.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:50.04,0:11:52.04,Default,,0000,0000,0000,,Тұмар?
Dialogue: 0,0:11:52.04,0:11:55.38,Default,,0000,0000,0000,,Жаңа жылдық сапар кезінде
Dialogue: 0,0:11:52.04,0:11:55.38,Default,,0000,0000,0000,,Мен оны сатып аламын деп ойладым➡
Dialogue: 0,0:11:55.38,0:11:58.55,Default,,0000,0000,0000,,Мен мұны өзім жасадым!
Dialogue: 0,0:11:58.55,0:12:01.15,Default,,0000,0000,0000,,Бұл біз үшін бе?
Dialogue: 0,0:11:58.55,0:12:01.15,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:12:01.15,0:12:03.49,Default,,0000,0000,0000,,Барлығына біреу бар.
Dialogue: 0,0:12:03.49,0:12:05.99,Default,,0000,0000,0000,,Хоо~.
Dialogue: 0,0:12:03.49,0:12:05.99,Default,,0000,0000,0000,,Иә, Сакаки-сан!
Dialogue: 0,0:12:07.99,0:12:10.99,Default,,0000,0000,0000,,Ихихи хехе….
Dialogue: 0,0:12:07.99,0:12:10.99,Default,,0000,0000,0000,,Рахмет….
Dialogue: 0,0:12:10.99,0:12:16.33,Default,,0000,0000,0000,,Эй, мен жасадым.
Dialogue: 0,0:12:10.99,0:12:16.33,Default,,0000,0000,0000,,Бұл жұмыс істейтін сияқты!
Dialogue: 0,0:12:16.33,0:12:19.17,Default,,0000,0000,0000,,Уақыт таяп қалды.
Dialogue: 0,0:12:16.33,0:12:19.17,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:12:19.17,0:12:22.34,Default,,0000,0000,0000,,Мен жай ғана істеуім керек нәрсені жасадым.
Dialogue: 0,0:12:19.17,0:12:22.34,Default,,0000,0000,0000,,Сізге бар күш-жігеріңізді салу керек!
Dialogue: 0,0:12:22.34,0:12:24.51,Default,,0000,0000,0000,,Сояна.
Dialogue: 0,0:12:22.34,0:12:24.51,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:12:24.51,0:12:29.51,Default,,0000,0000,0000,,Сонда мен, барлығы
Dialogue: 0,0:12:24.51,0:12:29.51,Default,,0000,0000,0000,,Бар жақсылықты тілеймін.
Dialogue: 0,0:12:29.51,0:12:31.68,Default,,0000,0000,0000,,Олай болса, кеттік!
Dialogue: 0,0:12:29.51,0:12:31.68,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:12:31.68,0:12:34.18,Default,,0000,0000,0000,,Бұл!
Dialogue: 0,0:12:31.68,0:12:34.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:34.18,0:12:36.38,Default,,0000,0000,0000,,Сәттілік!
Dialogue: 0,0:12:34.18,0:12:36.38,Default,,0000,0000,0000,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:12:38.52,0:12:40.52,Default,,0000,0000,0000,,Қашып шығу үшін
Dialogue: 0,0:12:43.86,0:12:47.66,Default,,0000,0000,0000,,Аа, еңбегіңіз үшін рахмет! Қалай болды?
Dialogue: 0,0:12:49.86,0:12:54.04,Default,,0000,0000,0000,,Маған бәрібір, жарайды!
Dialogue: 0,0:12:49.86,0:12:54.04,Default,,0000,0000,0000,,А, бұл жұмыс істемеді ...
Dialogue: 0,0:12:54.04,0:12:56.54,Default,,0000,0000,0000,,Уф. 2➡ дейін
Dialogue: 0,0:12:56.54,0:12:59.04,Default,,0000,0000,0000,,Мен жауапты қысқарта аламын, бірақ
Dialogue: 0,0:12:56.54,0:12:59.04,Default,,0000,0000,0000,,көп болды...
Dialogue: 0,0:13:00.98,0:13:02.98,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:13:02.98,0:13:06.31,Default,,0000,0000,0000,,Бұл өте қызық мәселе.
Dialogue: 0,0:13:06.31,0:13:09.48,Default,,0000,0000,0000,,Юкари Сенсейдің сынағы жақсырақ
Dialogue: 0,0:13:06.31,0:13:09.48,Default,,0000,0000,0000,,Қызықты.
Dialogue: 0,0:13:09.48,0:13:12.82,Default,,0000,0000,0000,,Мұндай есепте
Dialogue: 0,0:13:09.48,0:13:12.82,Default,,0000,0000,0000,,Интеллект өлшеусіз!
Dialogue: 0,0:13:12.82,0:13:16.16,Default,,0000,0000,0000,,Дүрбелең емес!
Dialogue: 0,0:13:12.82,0:13:16.16,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:13:16.16,0:13:18.16,Default,,0000,0000,0000,,Сәлем, Чио-чан!
Dialogue: 0,0:13:18.16,0:13:20.83,Default,,0000,0000,0000,,Чио-чанға
Dialogue: 0,0:13:18.16,0:13:20.83,Default,,0000,0000,0000,,Алдыңғы Наротако пайда болды.
Dialogue: 0,0:13:20.83,0:13:24.67,Default,,0000,0000,0000,,Бұл бақыт!
Dialogue: 0,0:13:20.83,0:13:24.67,Default,,0000,0000,0000,,Иә, сіз бақыттысыз!
Dialogue: 0,0:13:24.67,0:13:28.00,Default,,0000,0000,0000,,Осака Чио-чан
Dialogue: 0,0:13:24.67,0:13:28.00,Default,,0000,0000,0000,,Сізді оқытып жатыр ма?
Dialogue: 0,0:13:28.00,0:13:31.34,Default,,0000,0000,0000,,Соңғы уақытта демалыс күндерім аздап қалды.
Dialogue: 0,0:13:31.34,0:13:33.68,Default,,0000,0000,0000,,Ах! Сондықтан бүгінгі күн де ​​тамаша! ?
Dialogue: 0,0:13:33.68,0:13:38.01,Default,,0000,0000,0000,,Дәл қазір
Dialogue: 0,0:13:33.68,0:13:38.01,Default,,0000,0000,0000,,Чио-чан айтқандай➡
Dialogue: 0,0:13:38.01,0:13:42.52,Default,,0000,0000,0000,,Мұндай есепте
Dialogue: 0,0:13:38.01,0:13:42.52,Default,,0000,0000,0000,,Менің ақылым оны түсінбейді.
Dialogue: 0,0:13:42.52,0:13:45.02,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:13:45.02,0:13:52.03,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:13:52.03,0:13:54.86,Default,,0000,0000,0000,,Чиё Әкесі: Сәлем Everynyan.
Dialogue: 0,0:13:52.03,0:13:54.86,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:54.86,0:13:59.97,Default,,0000,0000,0000,,Қалайсың. Жақсы рахмет.
Dialogue: 0,0:13:54.86,0:13:59.97,Default,,0000,0000,0000,,О, Құдайым!
Dialogue: 0,0:13:59.97,0:14:03.97,Default,,0000,0000,0000,,Ах. Мен құс болғанымды қалаймын.
Dialogue: 0,0:14:03.97,0:14:06.31,Default,,0000,0000,0000,,Неліктен ағылшын тілінде сөйлейсіз?
Dialogue: 0,0:14:06.31,0:14:09.14,Default,,0000,0000,0000,,Менің қызым Америкаға барады.
Dialogue: 0,0:14:09.14,0:14:14.48,Default,,0000,0000,0000,,Құстар ше?
Dialogue: 0,0:14:09.14,0:14:14.48,Default,,0000,0000,0000,,Құс емес. Менің немере ағам мысық.
Dialogue: 0,0:14:14.48,0:14:17.65,Default,,0000,0000,0000,,Бұл мысық болмаса ше?
Dialogue: 0,0:14:17.65,0:14:20.65,Default,,0000,0000,0000,,Бетіңіз сізге қатты ұқсайды.
Dialogue: 0,0:14:23.32,0:14:26.49,Default,,0000,0000,0000,,Мори… Бұрынғы премьер-министр….
Dialogue: 0,0:14:26.49,0:14:29.33,Default,,0000,0000,0000,,Хэхе...
Dialogue: 0,0:14:29.33,0:14:33.63,Default,,0000,0000,0000,,Саңырауқұлақ….
Dialogue: 0,0:14:29.33,0:14:33.63,Default,,0000,0000,0000,,О~ Аймусо~ри~!
Dialogue: 0,0:14:36.17,0:14:41.01,Default,,0000,0000,0000,,Хмм? Сіз нағыз мысықсыз ба?
Dialogue: 0,0:14:41.01,0:14:45.85,Default,,0000,0000,0000,,Менің мысық тілім бар, қалай ойлайсың? мысық.
Dialogue: 0,0:14:45.85,0:14:48.35,Default,,0000,0000,0000,,А, менің де мысық тілім бар!
Dialogue: 0,0:14:48.35,0:14:51.52,Default,,0000,0000,0000,,Сосын сол тіл
Dialogue: 0,0:14:48.35,0:14:51.52,Default,,0000,0000,0000,,Ол оны тартып алады~!
Dialogue: 0,0:14:51.52,0:14:53.52,Default,,0000,0000,0000,,Иә~ Неге~!
Dialogue: 0,0:14:53.52,0:14:57.69,Default,,0000,0000,0000,,Аа, солай.
Dialogue: 0,0:14:53.52,0:14:57.69,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:14:57.69,0:15:01.59,Default,,0000,0000,0000,,Ұйықтама.
Dialogue: 0,0:14:57.69,0:15:01.59,Default,,0000,0000,0000,,Мен дұрыс оқыдым.
Dialogue: 0,0:15:03.80,0:15:07.30,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:15:03.80,0:15:07.30,Default,,0000,0000,0000,,Чио Чанның үйі.
Dialogue: 0,0:15:07.30,0:15:09.30,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:15:07.30,0:15:09.30,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:15:09.30,0:15:12.81,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:15:12.81,0:15:15.64,Default,,0000,0000,0000,,Иә, түскі ас уақыты!
Dialogue: 0,0:15:15.64,0:15:17.98,Default,,0000,0000,0000,,Бүгін миль-фелье.
Dialogue: 0,0:15:17.98,0:15:20.48,Default,,0000,0000,0000,,О!
Dialogue: 0,0:15:17.98,0:15:20.48,Default,,0000,0000,0000,,Мен көптен күттім!
Dialogue: 0,0:15:20.48,0:15:24.65,Default,,0000,0000,0000,,Қант психикалық сергектік үшін қажет.
Dialogue: 0,0:15:20.48,0:15:24.65,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:24.65,0:15:28.55,Default,,0000,0000,0000,,Сондықтан солай емес пе? Тіпті жесең де.
Dialogue: 0,0:15:24.65,0:15:28.55,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:30.83,0:15:32.99,Default,,0000,0000,0000,,Бұл Сакаки мырза.
Dialogue: 0,0:15:32.99,0:15:35.83,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Сол кезде...
Dialogue: 0,0:15:35.83,0:15:38.33,Default,,0000,0000,0000,,А... Мен қозғала алмаймын...
Dialogue: 0,0:15:38.33,0:15:42.00,Default,,0000,0000,0000,,Сакаки мырза, бұл жеңіл тамақ.
Dialogue: 0,0:15:42.00,0:15:44.51,Default,,0000,0000,0000,,Ах, рахмет.
Dialogue: 0,0:15:44.51,0:15:46.67,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:46.67,0:15:49.01,Default,,0000,0000,0000,,Жоқ, мен оны саған бермеймін.
Dialogue: 0,0:15:49.01,0:15:52.01,Default,,0000,0000,0000,,А, мен саған торт бермеймін бе?
Dialogue: 0,0:15:52.01,0:15:56.35,Default,,0000,0000,0000,,Иә, мүмкіндігінше тәттілер
Dialogue: 0,0:15:52.01,0:15:56.35,Default,,0000,0000,0000,,Мен оны бермеуге тырысамын.
Dialogue: 0,0:15:56.35,0:16:01.79,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:16:01.79,0:16:05.79,Default,,0000,0000,0000,,Күрсін, дәмді болды. Мейрам мырза~
Dialogue: 0,0:16:05.79,0:16:08.80,Default,,0000,0000,0000,,Эй?
Dialogue: 0,0:16:05.79,0:16:08.80,Default,,0000,0000,0000,,Қант психикалық сергектік үшін қажет, солай ма?
Dialogue: 0,0:16:08.80,0:16:13.13,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:16:08.80,0:16:13.13,Default,,0000,0000,0000,,Дұрыс, дұрыс.
Dialogue: 0,0:16:13.13,0:16:17.64,Default,,0000,0000,0000,,Жарайды, соңғы итеру
Dialogue: 0,0:16:13.13,0:16:17.64,Default,,0000,0000,0000,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:16:13.13,0:16:17.64,Default,,0000,0000,0000,,Жоғалтпа!
Dialogue: 0,0:16:17.64,0:16:32.15,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:16:32.15,0:16:35.16,Default,,0000,0000,0000,,Иә? Чиё Чанға не болды?
Dialogue: 0,0:16:35.16,0:16:39.66,Default,,0000,0000,0000,,Эхехе... ақыры
Dialogue: 0,0:16:35.16,0:16:39.66,Default,,0000,0000,0000,,Мен мектеп бітіремін деп ойлаймын.
Dialogue: 0,0:16:39.66,0:16:43.33,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:16:39.66,0:16:43.33,Default,,0000,0000,0000,,Қабылдау емтиханында оқып жүргенде бұл туралы мүлдем ұмытып кеттім.
Dialogue: 0,0:16:43.33,0:16:47.84,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:16:43.33,0:16:47.84,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:16:43.33,0:16:47.84,Default,,0000,0000,0000,,Аман-есен бітірсем.
Dialogue: 0,0:16:47.84,0:16:50.84,Default,,0000,0000,0000,,Бұлай айту сізді қынжылтпай ма?
Dialogue: 0,0:16:50.84,0:16:54.84,Default,,0000,0000,0000,,Бірақ мен барлығын кездестірдім
Dialogue: 0,0:16:50.84,0:16:54.84,Default,,0000,0000,0000,,Үш жыл болды.
Dialogue: 0,0:16:54.84,0:16:59.18,Default,,0000,0000,0000,,Мен екінші курста ғана болдым.
Dialogue: 0,0:16:54.84,0:16:59.18,Default,,0000,0000,0000,,Көп нәрсе болды.
Dialogue: 0,0:16:59.18,0:17:03.12,Default,,0000,0000,0000,,Шынымен~ 3 жыл?
Dialogue: 0,0:16:59.18,0:17:03.12,Default,,0000,0000,0000,,Бұл өте тез өтеді.
Dialogue: 0,0:17:03.12,0:17:06.45,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:17:03.12,0:17:06.45,Default,,0000,0000,0000,,Бұл өте үлкен болды.
Dialogue: 0,0:17:06.45,0:17:08.62,Default,,0000,0000,0000,,Еее? Солай ма?
Dialogue: 0,0:17:08.62,0:17:12.96,Default,,0000,0000,0000,,Сакаки-чанның кеудесі де үлкен болды.
Dialogue: 0,0:17:08.62,0:17:12.96,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:12.96,0:17:15.46,Default,,0000,0000,0000,,Мен өте жақсымын
Dialogue: 0,0:17:12.96,0:17:15.46,Default,,0000,0000,0000,,Ол жақсарды.
Dialogue: 0,0:17:15.46,0:17:18.46,Default,,0000,0000,0000,,Ал Томо-чан...
Dialogue: 0,0:17:15.46,0:17:18.46,Default,,0000,0000,0000,,Ей, мені елеме!
Dialogue: 0,0:17:20.47,0:17:25.47,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:25.47,0:17:30.14,Default,,0000,0000,0000,,《Чиё: Соңында барлығы.
Dialogue: 0,0:17:25.47,0:17:30.14,Default,,0000,0000,0000,,Әрбір емтихан басталды.
Dialogue: 0,0:17:30.14,0:17:34.04,Default,,0000,0000,0000,,Менің қолымнан келетіні
Dialogue: 0,0:17:30.14,0:17:34.04,Default,,0000,0000,0000,,Тек дұға ет》
Dialogue: 0,0:17:35.98,0:17:38.15,Default,,0000,0000,0000,,《Чиё: Өтінемін, бар күшіңді сал! 》
Dialogue: 0,0:17:38.15,0:17:47.15,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:50.16,0:17:53.00,Default,,0000,0000,0000,,Қайырлы таң!
Dialogue: 0,0:17:50.16,0:17:53.00,Default,,0000,0000,0000,,Қайырлы таң!
Dialogue: 0,0:17:53.00,0:17:57.00,Default,,0000,0000,0000,,Эй, Кагура бүгін болды, солай ма? Нәтижелер туралы хабарландыру!
Dialogue: 0,0:17:57.00,0:17:59.84,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:17:57.00,0:17:59.84,Default,,0000,0000,0000,,Бұл не...?
Dialogue: 0,0:17:59.84,0:18:03.11,Default,,0000,0000,0000,,Өйткені олар менің шәкірттерім.
Dialogue: 0,0:17:59.84,0:18:03.11,Default,,0000,0000,0000,,Дұрыс есте сақта.
Dialogue: 0,0:18:03.11,0:18:05.28,Default,,0000,0000,0000,,Әй, дәл солай.
Dialogue: 0,0:18:05.28,0:18:08.45,Default,,0000,0000,0000,,Мұғалім! өттім! өттім!
Dialogue: 0,0:18:08.45,0:18:10.79,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:18:08.45,0:18:10.79,Default,,0000,0000,0000,,Құттықтаймыз!
Dialogue: 0,0:18:10.79,0:18:13.96,Default,,0000,0000,0000,,Жоқ, мен
Dialogue: 0,0:18:10.79,0:18:13.96,Default,,0000,0000,0000,,Сіз өтемін деп сендіңіз, солай ма?
Dialogue: 0,0:18:13.96,0:18:17.63,Default,,0000,0000,0000,,Жаңа ғана «е» деп айтқан жоқсың ба?
Dialogue: 0,0:18:17.63,0:18:20.29,Default,,0000,0000,0000,,Кагура өтті! ?
Dialogue: 0,0:18:20.29,0:18:23.97,Default,,0000,0000,0000,,Құттықтаймыз!
Dialogue: 0,0:18:20.29,0:18:23.97,Default,,0000,0000,0000,,Бұл өте жақсы болды!
Dialogue: 0,0:18:23.97,0:18:27.97,Default,,0000,0000,0000,,Рахмет. Мұның бәрі Чио-чанның тұмарының арқасында.
Dialogue: 0,0:18:27.97,0:18:31.31,Default,,0000,0000,0000,,Міне! Бұл Кагураның қабілеті!
Dialogue: 0,0:18:31.31,0:18:33.31,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:18:31.31,0:18:33.31,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:33.31,0:18:36.98,Default,,0000,0000,0000,,Дәл қазір сен тым таңқаларлықсың~!
Dialogue: 0,0:18:33.31,0:18:36.98,Default,,0000,0000,0000,,Сіз жақсы болмадыңыз ба?
Dialogue: 0,0:18:36.98,0:18:40.82,Default,,0000,0000,0000,,Ух... осындай нәрсе.
Dialogue: 0,0:18:36.98,0:18:40.82,Default,,0000,0000,0000,,Тегіс конверт келді➡
Dialogue: 0,0:18:40.82,0:18:43.32,Default,,0000,0000,0000,,Ішінде «Жоқ» деп жазылған.
Dialogue: 0,0:18:43.32,0:18:47.16,Default,,0000,0000,0000,,Жарайды! Әзірге хабарландыру жоқ
Dialogue: 0,0:18:43.32,0:18:47.16,Default,,0000,0000,0000,,Ол әлі де бар!
Dialogue: 0,0:18:47.16,0:18:49.16,Default,,0000,0000,0000,,Бұл қабылданды!
Dialogue: 0,0:18:49.16,0:18:53.16,Default,,0000,0000,0000,,Шынымен бе? Өз өміріңізді тәуекел етесіз бе?
Dialogue: 0,0:18:49.16,0:18:53.16,Default,,0000,0000,0000,,Қоңырау шалайық!
Dialogue: 0,0:18:49.16,0:18:53.16,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:18:53.16,0:18:56.16,Default,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:18:53.16,0:18:56.16,Default,,0000,0000,0000,,Әй, Осака-сан!
Dialogue: 0,0:18:56.16,0:19:00.10,Default,,0000,0000,0000,,Анна~
Dialogue: 0,0:18:56.16,0:19:00.10,Default,,0000,0000,0000,,Мен емтихан нәтижелері туралы хабарлама алдым.
Dialogue: 0,0:19:00.10,0:19:02.44,Default,,0000,0000,0000,,Бірақ мен оны әлі көрген жоқпын.
Dialogue: 0,0:19:02.44,0:19:05.61,Default,,0000,0000,0000,,Чио-чанға
Dialogue: 0,0:19:02.44,0:19:05.61,Default,,0000,0000,0000,,Көмек көрсеткеніңіз үшін көп рахмет➡
Dialogue: 0,0:19:05.61,0:19:07.61,Default,,0000,0000,0000,,Мен оны сенімен бірге көремін деп ойладым...
Dialogue: 0,0:19:07.61,0:19:09.78,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:19:09.78,0:19:13.11,Default,,0000,0000,0000,,Енді қалай ойлайсыңдар?
Dialogue: 0,0:19:09.78,0:19:13.11,Default,,0000,0000,0000,,《Чиё/Томо: Өте жатық! 》
Dialogue: 0,0:19:13.11,0:19:15.81,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:19:13.11,0:19:15.81,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:19:18.45,0:19:20.62,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:19:20.62,0:19:23.29,Default,,0000,0000,0000,,Көңіліңізді түсірмеңіз!
Dialogue: 0,0:19:20.62,0:19:23.29,Default,,0000,0000,0000,,Әлі біраз қалды!
Dialogue: 0,0:19:23.29,0:19:26.96,Default,,0000,0000,0000,,Бірақ бұл
Dialogue: 0,0:19:23.29,0:19:26.96,Default,,0000,0000,0000,,Мен оны сырғып кетпеуге тырыстым, бірақ...
Dialogue: 0,0:19:26.96,0:19:30.63,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:26.96,0:19:30.63,Default,,0000,0000,0000,,Жарайды! бәрі жақсы!
Dialogue: 0,0:19:30.63,0:19:32.97,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:19:30.63,0:19:32.97,Default,,0000,0000,0000,,Мен өз өмірімді қатерге тігемін!
Dialogue: 0,0:19:32.97,0:19:35.14,Default,,0000,0000,0000,,Чио-чан, өлуге асықпа...
Dialogue: 0,0:19:35.14,0:19:38.31,Default,,0000,0000,0000,,Эй, Сакаки-чан, нәтиже алдың ба?
Dialogue: 0,0:19:38.31,0:19:42.81,Default,,0000,0000,0000,,Иә, біріншіден өттім. Менің сүйіктім әлі жоқ.
Dialogue: 0,0:19:42.81,0:19:46.98,Default,,0000,0000,0000,,А, бұл жақсы.
Dialogue: 0,0:19:42.81,0:19:46.98,Default,,0000,0000,0000,,Бұл ветеринарларға арналған университет пе?
Dialogue: 0,0:19:46.98,0:19:50.82,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:46.98,0:19:50.82,Default,,0000,0000,0000,,Ах, мал дәрігері.
Dialogue: 0,0:19:46.98,0:19:50.82,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:50.82,0:19:55.12,Default,,0000,0000,0000,,Қоңыздарды да қарай аласыз ба?
Dialogue: 0,0:19:50.82,0:19:55.12,Default,,0000,0000,0000,,Мм...
Dialogue: 0,0:19:57.16,0:20:01.33,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:01.33,0:20:03.66,Default,,0000,0000,0000,,Енді, ақырында
Dialogue: 0,0:20:01.33,0:20:03.66,Default,,0000,0000,0000,,...
Dialogue: 0,0:20:03.66,0:20:07.00,Default,,0000,0000,0000,,Бұл сыни сәт!
Dialogue: 0,0:20:03.66,0:20:07.00,Default,,0000,0000,0000,,Рұқсатсыз не істеп жатырсың!
Dialogue: 0,0:20:07.00,0:20:09.50,Default,,0000,0000,0000,,Чио-чан, өмір немесе өлім!
Dialogue: 0,0:20:07.00,0:20:09.50,Default,,0000,0000,0000,,Қаа!
Dialogue: 0,0:20:11.51,0:20:13.67,Default,,0000,0000,0000,,Жарайды, презентацияны көрмес бұрын➡
Dialogue: 0,0:20:13.67,0:20:17.35,Default,,0000,0000,0000,,Сәттілік үшін дұға ету үшін Чио-чанның күшін қайта зарядтаңыз!
Dialogue: 0,0:20:17.35,0:20:20.35,Default,,0000,0000,0000,,Түсіндім! Ммм.
Dialogue: 0,0:20:20.35,0:20:22.52,Default,,0000,0000,0000,,Ммммм~ Кааааааааааааааааааааааааааааааааа
Dialogue: 0,0:20:20.35,0:20:22.52,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:22.52,0:20:26.19,Default,,0000,0000,0000,,Иә, бұл жақсы!
Dialogue: 0,0:20:22.52,0:20:26.19,Default,,0000,0000,0000,,О...
Dialogue: 0,0:20:26.19,0:20:28.52,Default,,0000,0000,0000,,О, менікі де.
Dialogue: 0,0:20:30.52,0:20:33.36,Default,,0000,0000,0000,,Жарайды, көрейік!
Dialogue: 0,0:20:30.52,0:20:33.36,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:20:33.36,0:20:37.70,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:37.70,0:20:39.87,Default,,0000,0000,0000,,Мм. Ха!
Dialogue: 0,0:20:39.87,0:20:42.87,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:42.87,0:20:44.87,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:20:42.87,0:20:44.87,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:44.87,0:20:55.55,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:55.55,0:20:58.05,Default,,0000,0000,0000,,《Чиё: Бірақ
Dialogue: 0,0:20:55.55,0:20:58.05,Default,,0000,0000,0000,,Коёми екі➡ алды
Dialogue: 0,0:20:58.05,0:21:00.65,Default,,0000,0000,0000,,Екеуі құлады...》
Dialogue: 0,0:21:03.66,0:21:06.16,Default,,0000,0000,0000,,Ааа, мен кітапты сағындым... Хм...
Dialogue: 0,0:21:06.16,0:21:09.33,Default,,0000,0000,0000,,Әй! Дипломдық сапар...
Dialogue: 0,0:21:09.33,0:21:14.00,Default,,0000,0000,0000,,Тынш! Жоқ! Әлі ондай әңгіме жоқ!
Dialogue: 0,0:21:09.33,0:21:14.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:14.00,0:21:19.01,Default,,0000,0000,0000,,Бізде бәрі жақсы, бірақ...
Dialogue: 0,0:21:14.00,0:21:19.01,Default,,0000,0000,0000,,Не, бірдеңе айтқың келіп тұр ма?
Dialogue: 0,0:21:19.01,0:21:22.51,Default,,0000,0000,0000,,Уайымдамаңыз, келесі жолы өтетініңізге сенімдімін!
Dialogue: 0,0:21:22.51,0:21:24.68,Default,,0000,0000,0000,,Сені аяма!
Dialogue: 0,0:21:24.68,0:21:29.52,Default,,0000,0000,0000,,Әлі де сүйіктісі қалды.
Dialogue: 0,0:21:24.68,0:21:29.52,Default,,0000,0000,0000,,Мен міндетті түрде өтемін!
Dialogue: 0,0:21:29.52,0:21:32.85,Default,,0000,0000,0000,,Мен өтсем, ойнауға шығамын~
Dialogue: 0,0:21:29.52,0:21:32.85,Default,,0000,0000,0000,,Барлығына!
Dialogue: 0,0:21:32.85,0:21:35.36,Default,,0000,0000,0000,,Иә! Бәріміз кеттік!
Dialogue: 0,0:21:35.36,0:21:38.53,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:21:35.36,0:21:38.53,Default,,0000,0000,0000,,Бәріміз бірге барамыз деп үміттенемін!
Dialogue: 0,0:21:38.53,0:21:41.36,Default,,0000,0000,0000,,Сіз айтқан кезде
Dialogue: 0,0:21:38.53,0:21:41.36,Default,,0000,0000,0000,,Мен әйтеуір тұрып қалдым!
Dialogue: 0,0:21:41.36,0:21:44.87,Default,,0000,0000,0000,,Ах~ бәрібір құлап қалдым.
Dialogue: 0,0:21:41.36,0:21:44.87,Default,,0000,0000,0000,,Мен ғана.
Dialogue: 0,0:21:44.87,0:21:47.54,Default,,0000,0000,0000,,Ахаха ахахаха.
Dialogue: 0,0:21:47.54,0:21:49.87,Default,,0000,0000,0000,,Күнтізбе Күнтізбе енді жақсы емес!
Dialogue: 0,0:21:49.87,0:21:52.37,Default,,0000,0000,0000,,Мықты болыңыз!
Dialogue: 0,0:21:53.87,0:21:59.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory