Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.19,0:01:34.19,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:01:43.20,0:01:45.20,Default,,0000,0000,0000,,Әй, анашым...
Dialogue: 0,0:01:48.04,0:01:50.54,Default,,0000,0000,0000,,Иә... Мен фотоны көрдім.
Dialogue: 0,0:01:50.54,0:01:53.88,Default,,0000,0000,0000,,Бұл, әрине, жаман оқиға емес.
Dialogue: 0,0:01:50.54,0:01:53.88,Default,,0000,0000,0000,,Мүмкін ➡
Dialogue: 0,0:01:53.88,0:01:56.21,Default,,0000,0000,0000,,Үйлену тойына әлі ерте.
Dialogue: 0,0:01:56.21,0:01:58.38,Default,,0000,0000,0000,,Сіз мені неше жаста деп ойлайсыз?
Dialogue: 0,0:01:58.38,0:02:00.48,Default,,0000,0000,0000,,📞 (Анашым) Не айтып тұрсыз?
Dialogue: 0,0:02:00.48,0:02:03.99,Default,,0000,0000,0000,,📞Сіз әрқашан сонда боласыз
Dialogue: 0,0:02:00.48,0:02:03.99,Default,,0000,0000,0000,,Мен жас емеспін.
Dialogue: 0,0:02:03.99,0:02:07.99,Default,,0000,0000,0000,,📞Бұл өте жақсы әңгіме, көп рет
Dialogue: 0,0:02:03.99,0:02:07.99,Default,,0000,0000,0000,,Ондай емес...
Dialogue: 0,0:02:07.99,0:02:10.99,Default,,0000,0000,0000,,Иә... Иә...
Dialogue: 0,0:02:10.99,0:02:14.00,Default,,0000,0000,0000,,Жарайды, мен сенімен кездесемін.
Dialogue: 0,0:02:14.00,0:02:17.33,Default,,0000,0000,0000,,Иә, сонда
Dialogue: 0,0:02:14.00,0:02:17.33,Default,,0000,0000,0000,,Мен де саған хабарласамын.
Dialogue: 0,0:02:17.33,0:02:19.33,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,0:02:22.00,0:02:24.80,Default,,0000,0000,0000,,(көлік дыбысы)
Dialogue: 0,0:02:35.35,0:02:37.35,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:02:42.52,0:02:46.32,Default,,0000,0000,0000,,(көлік дыбысы)
Dialogue: 0,0:02:59.37,0:03:02.48,Default,,0000,0000,0000,,Мәңгілік жас болмайсың...
Dialogue: 0,0:03:02.48,0:03:04.48,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:03:04.48,0:03:06.48,Default,,0000,0000,0000,,Сіз әлі жассыз.
Dialogue: 0,0:03:06.48,0:03:09.15,Default,,0000,0000,0000,,Ах! Иә иә иә!
Dialogue: 0,0:03:09.15,0:03:15.16,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:03:19.66,0:03:21.66,Default,,0000,0000,0000,,Э? Тұр... не?
Dialogue: 0,0:03:21.66,0:03:24.50,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:03:24.50,0:03:27.50,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:03:27.50,0:03:30.01,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:03:30.01,0:03:32.67,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:03:30.01,0:03:32.67,Default,,0000,0000,0000,,Неге сонша ұйықтап жатырсың?
Dialogue: 0,0:03:32.67,0:03:35.34,Default,,0000,0000,0000,,Айтайын дегенім, сен әбден ұйықтап қалдың!
Dialogue: 0,0:03:35.34,0:03:38.35,Default,,0000,0000,0000,,Бұл көңілді болса, көмектесу мүмкін емес.
Dialogue: 0,0:03:38.35,0:03:41.52,Default,,0000,0000,0000,,Бүгін ауа-райы өте нашар...
Dialogue: 0,0:03:41.52,0:03:44.69,Default,,0000,0000,0000,,Дұрыс~ Хмм.
Dialogue: 0,0:03:44.69,0:03:53.53,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:03:53.53,0:03:56.53,Default,,0000,0000,0000,,Осылайша
Dialogue: 0,0:03:53.53,0:03:56.53,Default,,0000,0000,0000,,Күн түскенде➡
Dialogue: 0,0:03:56.53,0:04:00.63,Default,,0000,0000,0000,,Үлпілдек футон сияқты
Dialogue: 0,0:03:56.53,0:04:00.63,Default,,0000,0000,0000,,Орап қалған сияқты...
Dialogue: 0,0:04:02.64,0:04:07.14,Default,,0000,0000,0000,,Хехе...хехехе.
Dialogue: 0,0:04:07.14,0:04:09.14,Default,,0000,0000,0000,,Хехехехе….
Dialogue: 0,0:04:11.65,0:04:13.65,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:15.65,0:04:19.49,Default,,0000,0000,0000,,Жоқ, мен оған сүйсінбей тұра алмадым, өйткені ол өте әдемі болды.
Dialogue: 0,0:04:19.49,0:04:21.49,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:04:21.49,0:04:25.99,Default,,0000,0000,0000,,Totttttttttttttttttttttttttttttttttttttttsssssssssssssssr-tttttttttttttttttttttttttttttttttttttttttttttttttttt!
Dialogue: 0,0:04:25.99,0:04:30.50,Default,,0000,0000,0000,,Керемет! Мен мұндай керемет акубиді бірінші рет көріп тұрмын!
Dialogue: 0,0:04:30.50,0:04:33.50,Default,,0000,0000,0000,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:04:30.50,0:04:33.50,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:33.50,0:04:38.01,Default,,0000,0000,0000,,Дәл Ақүбі елінен
Dialogue: 0,0:04:33.50,0:04:38.01,Default,,0000,0000,0000,,Ол Акубиді таратуға келген сияқты!
Dialogue: 0,0:04:38.01,0:04:40.01,Default,,0000,0000,0000,,Сәлем, Акуби шебері!
Dialogue: 0,0:04:40.01,0:04:42.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:40.01,0:04:42.84,Default,,0000,0000,0000,,Мен ештеңе айтпасам да...
Dialogue: 0,0:04:42.84,0:04:45.51,Default,,0000,0000,0000,,Мұны істеме - Осака!
Dialogue: 0,0:04:42.84,0:04:45.51,Default,,0000,0000,0000,,Бір адам туралы➡
Dialogue: 0,0:04:45.51,0:04:48.85,Default,,0000,0000,0000,,Оның жақсы жақтары бар Ахахаха!
Dialogue: 0,0:04:48.85,0:04:51.85,Default,,0000,0000,0000,,Енді сол есінеуді тоқтатайық.
Dialogue: 0,0:04:48.85,0:04:51.85,Default,,0000,0000,0000,,Маған да үйретіңізші!
Dialogue: 0,0:04:51.85,0:04:53.86,Default,,0000,0000,0000,,Акуби Дожо!
Dialogue: 0,0:04:53.86,0:04:57.36,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:04:53.86,0:04:57.36,Default,,0000,0000,0000,,Эй, эй….
Dialogue: 0,0:04:57.36,0:05:01.80,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:05:01.80,0:05:05.47,Default,,0000,0000,0000,,Бұл бұрынғыдан өзгеше.
Dialogue: 0,0:05:01.80,0:05:05.47,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:05:05.47,0:05:07.64,Default,,0000,0000,0000,,Мені де араластырыңызшы!
Dialogue: 0,0:05:07.64,0:05:09.97,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:05:09.97,0:05:11.97,Default,,0000,0000,0000,,Мен алдымен сыныпқа қайтамын.
Dialogue: 0,0:05:11.97,0:05:14.64,Default,,0000,0000,0000,,Мен де...
Dialogue: 0,0:05:14.64,0:05:20.34,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:05:26.49,0:05:30.49,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:05:36.50,0:05:39.67,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:05:36.50,0:05:39.67,Default,,0000,0000,0000,,Түстен кейінгі сабақ басталып кетті~!
Dialogue: 0,0:05:39.67,0:05:43.01,Default,,0000,0000,0000,,Ахх
Dialogue: 0,0:05:39.67,0:05:43.01,Default,,0000,0000,0000,,Бәріне Томо-чан кінәлі!
Dialogue: 0,0:05:43.01,0:05:45.01,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:05:45.01,0:05:47.84,Default,,0000,0000,0000,,Күтіңіз~ Ха...
Dialogue: 0,0:05:49.85,0:05:52.68,Default,,0000,0000,0000,,Сіз шатырда ұйықтадыңыз ба? Неліктен?
Dialogue: 0,0:05:52.68,0:05:56.88,Default,,0000,0000,0000,,Мм, шынымен емес
Dialogue: 0,0:05:52.68,0:05:56.88,Default,,0000,0000,0000,,Өйткені аспан көгілдір еді... немесе бірдеңе.
Dialogue: 0,0:05:58.85,0:06:01.12,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:05:58.85,0:06:01.12,Default,,0000,0000,0000,,Балалар, мектеп ауласының 10 айналымы!
Dialogue: 0,0:06:01.12,0:06:03.13,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:06:03.13,0:06:07.46,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:06:07.46,0:06:09.46,Default,,0000,0000,0000,,Ай!
Dialogue: 0,0:06:13.14,0:06:17.14,Default,,0000,0000,0000,,Хмф... Мүлде жоқ.
Dialogue: 0,0:06:13.14,0:06:17.14,Default,,0000,0000,0000,,Бұл балалар ше?
Dialogue: 0,0:06:17.14,0:06:19.14,Default,,0000,0000,0000,,Мен келесі жылы емтихан тапсыратын болсам да...
Dialogue: 0,0:06:19.14,0:06:21.48,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:06:19.14,0:06:21.48,Default,,0000,0000,0000,,Мен тітіркеніп барамын.
Dialogue: 0,0:06:21.48,0:06:23.48,Default,,0000,0000,0000,,Ештеңе.
Dialogue: 0,0:06:23.48,0:06:26.82,Default,,0000,0000,0000,,Сыныбыңдағы балалар
Dialogue: 0,0:06:23.48,0:06:26.82,Default,,0000,0000,0000,,Мен түскі үзілісте Акубимен жаттығып жүрдім➡
Dialogue: 0,0:06:26.82,0:06:28.82,Default,,0000,0000,0000,,Ол ұйықтап қалғанын айтты.
Dialogue: 0,0:06:26.82,0:06:28.82,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:28.82,0:06:32.32,Default,,0000,0000,0000,,Акубидің тәжірибесі қандай?
Dialogue: 0,0:06:28.82,0:06:32.32,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:06:32.32,0:06:35.49,Default,,0000,0000,0000,,Мен шынымен түсінбеймін.
Dialogue: 0,0:06:32.32,0:06:35.49,Default,,0000,0000,0000,,Жақсы емес пе?
Dialogue: 0,0:06:35.49,0:06:37.99,Default,,0000,0000,0000,,Алаңсыз да мораторийдің артықшылығы болып табылады.
Dialogue: 0,0:06:37.99,0:06:40.00,Default,,0000,0000,0000,,Бұл артықшылық...
Dialogue: 0,0:06:40.00,0:06:42.83,Default,,0000,0000,0000,,Сонымен қатар мораторий
Dialogue: 0,0:06:40.00,0:06:42.83,Default,,0000,0000,0000,,Мағынасы жоқ па?
Dialogue: 0,0:06:42.83,0:06:46.17,Default,,0000,0000,0000,,Одан жақсырақ.
Dialogue: 0,0:06:42.83,0:06:46.17,Default,,0000,0000,0000,,Шие гүлін тамашалауға барғыңыз келе ме?
Dialogue: 0,0:06:46.17,0:06:48.84,Default,,0000,0000,0000,,Шие гүлін көру...?
Dialogue: 0,0:06:48.84,0:06:51.84,Default,,0000,0000,0000,,көріскенше сау болыңыз.
Dialogue: 0,0:06:51.84,0:06:53.84,Default,,0000,0000,0000,,О~ О~ Күте тұрыңыз! Уа!
Dialogue: 0,0:06:53.84,0:07:16.30,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:07:16.30,0:07:18.80,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:07:16.30,0:07:18.80,Default,,0000,0000,0000,,Бұл карри емес➡
Dialogue: 0,0:07:18.80,0:07:20.97,Default,,0000,0000,0000,,Бұл Хаяши болды!
Dialogue: 0,0:07:20.97,0:07:24.47,Default,,0000,0000,0000,,Карри дегеніміз не?
Dialogue: 0,0:07:20.97,0:07:24.47,Default,,0000,0000,0000,,Хаяшидің айырмашылығын да айта алмайсың ба?
Dialogue: 0,0:07:24.47,0:07:27.48,Default,,0000,0000,0000,,Аа, жесем де, менде хайаши мен карри бар➡
Dialogue: 0,0:07:27.48,0:07:30.15,Default,,0000,0000,0000,,Мен түсінбейтін нәрселер бар.
Dialogue: 0,0:07:27.48,0:07:30.15,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:07:30.15,0:07:33.82,Default,,0000,0000,0000,,Дәмі тым күшті.
Dialogue: 0,0:07:30.15,0:07:33.82,Default,,0000,0000,0000,,Сіз айтасыз! ?
Dialogue: 0,0:07:33.82,0:07:36.49,Default,,0000,0000,0000,,Әй, алдымен үйге барамыз.
Dialogue: 0,0:07:36.49,0:07:40.32,Default,,0000,0000,0000,,Кеткен кезде жарықты өшіріңіз.
Dialogue: 0,0:07:36.49,0:07:40.32,Default,,0000,0000,0000,,Рёкай!
Dialogue: 0,0:07:40.32,0:07:42.66,Default,,0000,0000,0000,,Осыншама ұзақ...
Dialogue: 0,0:07:42.66,0:07:45.33,Default,,0000,0000,0000,,Сыртта қараңғы...
Dialogue: 0,0:07:45.33,0:07:47.33,Default,,0000,0000,0000,,Хонма.
Dialogue: 0,0:07:47.33,0:07:49.66,Default,,0000,0000,0000,,Үйге қайтайық?
Dialogue: 0,0:07:49.66,0:07:57.67,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:07:57.67,0:07:59.67,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:59.67,0:08:09.12,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:09.12,0:08:13.32,Default,,0000,0000,0000,,(Жүгіру тынысы)
Dialogue: 0,0:08:15.96,0:08:18.63,Default,,0000,0000,0000,,Кагура-сан...
Dialogue: 0,0:08:18.63,0:08:21.63,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:08:18.63,0:08:21.63,Default,,0000,0000,0000,,Жастық шақ сияқты.
Dialogue: 0,0:08:21.63,0:08:24.13,Default,,0000,0000,0000,,(көлік дыбысы)
Dialogue: 0,0:08:24.13,0:08:27.30,Default,,0000,0000,0000,,Негізгі дене дайындығы?
Dialogue: 0,0:08:24.13,0:08:27.30,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:08:27.30,0:08:29.30,Default,,0000,0000,0000,,Бұл клубтық іс-шараларға арналған ба?
Dialogue: 0,0:08:29.30,0:08:32.64,Default,,0000,0000,0000,,Биыл
Dialogue: 0,0:08:29.30,0:08:32.64,Default,,0000,0000,0000,,Себебі мен Inter-High-ке қатысқым келеді.
Dialogue: 0,0:08:32.64,0:08:36.31,Default,,0000,0000,0000,,Мен аздап көңілім көтеріліп жатыр.
Dialogue: 0,0:08:32.64,0:08:36.31,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:08:36.31,0:08:40.32,Default,,0000,0000,0000,,Жаздан басқа жүзу үйірмесі
Dialogue: 0,0:08:36.31,0:08:40.32,Default,,0000,0000,0000,,Мен сені демалып жатыр деп ойладым.
Dialogue: 0,0:08:40.32,0:08:44.65,Default,,0000,0000,0000,,Ақымақ, сендер сияқты үйге қайту клубымен.
Dialogue: 0,0:08:40.32,0:08:44.65,Default,,0000,0000,0000,,Араластырмаңыз.
Dialogue: 0,0:08:44.65,0:08:48.16,Default,,0000,0000,0000,,Үйге қайту клубы? Үйге қайту клубы дегеніміз не?
Dialogue: 0,0:08:48.16,0:08:52.83,Default,,0000,0000,0000,,Ой, үйірмеге бармай-ақ.
Dialogue: 0,0:08:48.16,0:08:52.83,Default,,0000,0000,0000,,Сабақтан кейін бірден үйге баратын оқушылар.
Dialogue: 0,0:08:52.83,0:08:54.83,Default,,0000,0000,0000,,Бұл бізді білдіреді.
Dialogue: 0,0:08:54.83,0:08:59.00,Default,,0000,0000,0000,,Сонымен, балалар, сендер неге?
Dialogue: 0,0:08:54.83,0:08:59.00,Default,,0000,0000,0000,,Сіз мектепте осыншама уақыт болдыңыз ба?
Dialogue: 0,0:08:59.00,0:09:02.60,Default,,0000,0000,0000,,О, мына жігіт
Dialogue: 0,0:08:59.00,0:09:02.60,Default,,0000,0000,0000,,Мен іздеп жүрген кітап бар дейді.
Dialogue: 0,0:09:02.60,0:09:05.77,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:09:02.60,0:09:05.77,Default,,0000,0000,0000,,Мен кітапханаға бара жатыр едім.
Dialogue: 0,0:09:05.77,0:09:09.11,Default,,0000,0000,0000,,Бірақ мәңгі
Dialogue: 0,0:09:05.77,0:09:09.11,Default,,0000,0000,0000,,Мен бұл туралы айтып тұрғандай болдым.
Dialogue: 0,0:09:09.11,0:09:11.78,Default,,0000,0000,0000,,Бұл жақсы...
Dialogue: 0,0:09:11.78,0:09:14.62,Default,,0000,0000,0000,,Колт! Оу!
Dialogue: 0,0:09:11.78,0:09:14.62,Default,,0000,0000,0000,,Менде аздап еркіндік бар сияқты...
Dialogue: 0,0:09:14.62,0:09:16.79,Default,,0000,0000,0000,,Мүмкіндік...?
Dialogue: 0,0:09:16.79,0:09:20.79,Default,,0000,0000,0000,,Әй, қызыл нүктелердің алдында тұрғандар үшін➡
Dialogue: 0,0:09:20.79,0:09:24.13,Default,,0000,0000,0000,,Мен оны көтере алатыныма сене алмаймын.
Dialogue: 0,0:09:20.79,0:09:24.13,Default,,0000,0000,0000,,Сен, сен!
Dialogue: 0,0:09:24.13,0:09:26.29,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:09:26.29,0:09:29.46,Default,,0000,0000,0000,,Егер Томо-чан...
Dialogue: 0,0:09:26.29,0:09:29.46,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:29.46,0:09:33.30,Default,,0000,0000,0000,,Е! ? Қазір сонша
Dialogue: 0,0:09:29.46,0:09:33.30,Default,,0000,0000,0000,,Бұл қызық болмады! ?
Dialogue: 0,0:09:33.30,0:09:35.30,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:09:35.30,0:09:37.30,Default,,0000,0000,0000,,Эй, эй!
Dialogue: 0,0:09:45.15,0:09:47.98,Default,,0000,0000,0000,,Эй, бұл жақсы дүкен емес.
Dialogue: 0,0:09:47.98,0:09:50.15,Default,,0000,0000,0000,,Жоқ, мұндай жерде➡
Dialogue: 0,0:09:50.15,0:09:52.65,Default,,0000,0000,0000,,Дұрысырақ
Dialogue: 0,0:09:50.15,0:09:52.65,Default,,0000,0000,0000,,Бұл әдемі көрінуі керек еді...
Dialogue: 0,0:09:52.65,0:09:54.66,Default,,0000,0000,0000,,Мен шие гүлін көру деп естідім...
Dialogue: 0,0:09:54.66,0:09:57.83,Default,,0000,0000,0000,,Не, қонақ үй бар ма?
Dialogue: 0,0:09:54.66,0:09:57.83,Default,,0000,0000,0000,,Маған айтпадың ба?
Dialogue: 0,0:09:57.83,0:10:00.66,Default,,0000,0000,0000,,Мен тыңдамаймын!
Dialogue: 0,0:09:57.83,0:10:00.66,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:10:00.66,0:10:02.66,Default,,0000,0000,0000,,А, сәл күте тұрыңыз!
Dialogue: 0,0:10:02.66,0:10:14.84,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:10:14.84,0:10:17.68,Default,,0000,0000,0000,,Эй, Эйко бөлім меңгерушісі.
Dialogue: 0,0:10:17.68,0:10:20.02,Default,,0000,0000,0000,,Компания туралы
Dialogue: 0,0:10:17.68,0:10:20.02,Default,,0000,0000,0000,,Мен түсінбеймін, бірақ➡
Dialogue: 0,0:10:20.02,0:10:22.02,Default,,0000,0000,0000,,Бұл үлкен мәселе емес пе?
Dialogue: 0,0:10:22.02,0:10:24.69,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:10:22.02,0:10:24.69,Default,,0000,0000,0000,,Бірақ жұмыс енді ғана өсті➡
Dialogue: 0,0:10:24.69,0:10:26.69,Default,,0000,0000,0000,,Менің істегенім өзгермейді.
Dialogue: 0,0:10:26.69,0:10:30.03,Default,,0000,0000,0000,,Қол астындағы қызметкерді сөгіп едім, бастығым ұрысты...
Dialogue: 0,0:10:30.03,0:10:33.86,Default,,0000,0000,0000,,Менің жұмысым – бұл менің сату көрсеткішім.
Dialogue: 0,0:10:30.03,0:10:33.86,Default,,0000,0000,0000,,Тура байланыс мағынасында➡
Dialogue: 0,0:10:33.86,0:10:36.36,Default,,0000,0000,0000,,Бұл тұр ма?
Dialogue: 0,0:10:36.36,0:10:39.87,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:10:36.36,0:10:39.87,Default,,0000,0000,0000,,Эйко ересек адамға ұқсайды.
Dialogue: 0,0:10:39.87,0:10:43.04,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:10:39.87,0:10:43.04,Default,,0000,0000,0000,,Балалар сендер де ересек емессіңдер.
Dialogue: 0,0:10:43.04,0:10:45.54,Default,,0000,0000,0000,,Бұл дұрыс, бірақ...
Dialogue: 0,0:10:45.54,0:10:49.38,Default,,0000,0000,0000,,Иә! Тіпті біз болашағы зор жастармыз➡
Dialogue: 0,0:10:49.38,0:10:52.71,Default,,0000,0000,0000,,Білім беру
Dialogue: 0,0:10:49.38,0:10:52.71,Default,,0000,0000,0000,,Бұл қиын жұмыс➡
Dialogue: 0,0:10:52.71,0:10:55.72,Default,,0000,0000,0000,,Сіз кәмелетке толғансыз! Ахахаха!
Dialogue: 0,0:10:55.72,0:10:59.05,Default,,0000,0000,0000,,Сәлем, бәріңе
Dialogue: 0,0:10:55.72,0:10:59.05,Default,,0000,0000,0000,,Ол дене шынықтыру пәнінің мұғалімі болған, солай ма?
Dialogue: 0,0:10:59.05,0:11:01.99,Default,,0000,0000,0000,,Жұмысыңызды ауыстырғыңыз келмейді ме?
Dialogue: 0,0:10:59.05,0:11:01.99,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:11:01.99,0:11:04.33,Default,,0000,0000,0000,,Біздің еншілес спорт залда➡
Dialogue: 0,0:11:04.33,0:11:07.00,Default,,0000,0000,0000,,Мен бас нұсқаушы іздеймін.
Dialogue: 0,0:11:07.00,0:11:09.33,Default,,0000,0000,0000,,Әрине, қызметкердің қарым-қатынасы.
Dialogue: 0,0:11:09.33,0:11:13.00,Default,,0000,0000,0000,,Өйткені бұл жоғары дәрежелі орын
Dialogue: 0,0:11:09.33,0:11:13.00,Default,,0000,0000,0000,,Жалақыңызды екі есе көбейтіңіз, күмәнсіз.
Dialogue: 0,0:11:13.00,0:11:16.50,Default,,0000,0000,0000,,Жұмыс орнын ауыстыру….
Dialogue: 0,0:11:16.50,0:11:19.17,Default,,0000,0000,0000,,Жоқ, олай таң қалмаңыз.
Dialogue: 0,0:11:19.17,0:11:21.67,Default,,0000,0000,0000,,Ал егер
Dialogue: 0,0:11:19.17,0:11:21.67,Default,,0000,0000,0000,,Егер сізге ұнаса.
Dialogue: 0,0:11:24.18,0:11:26.85,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:11:24.18,0:11:26.85,Default,,0000,0000,0000,,Өйткені бұл кенеттен айтылды➡
Dialogue: 0,0:11:26.85,0:11:28.85,Default,,0000,0000,0000,,Мен таң қалдым...
Dialogue: 0,0:11:28.85,0:11:30.85,Default,,0000,0000,0000,,Ойланып көріңізші?
Dialogue: 0,0:11:30.85,0:11:34.36,Default,,0000,0000,0000,,Жоқ, мен жұмысты ауыстырмаймын.
Dialogue: 0,0:11:34.36,0:11:37.36,Default,,0000,0000,0000,,Себебі мен қазіргі жұмысымды жақсы көремін.
Dialogue: 0,0:11:37.36,0:11:39.86,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:11:37.36,0:11:39.86,Default,,0000,0000,0000,,Бірақ?
Dialogue: 0,0:11:39.86,0:11:43.87,Default,,0000,0000,0000,,Жұмыс орнын ауыстыру туралы не деуге болады?
Dialogue: 0,0:11:39.86,0:11:43.87,Default,,0000,0000,0000,,Мен бұл туралы ешқашан ойламадым...
Dialogue: 0,0:11:43.87,0:11:46.37,Default,,0000,0000,0000,,Жоқ! Тоқта, Эйко!
Dialogue: 0,0:11:46.37,0:11:48.54,Default,,0000,0000,0000,,Егер нямогай болмаса
Dialogue: 0,0:11:46.37,0:11:48.54,Default,,0000,0000,0000,,Менің мектебіме➡
Dialogue: 0,0:11:48.54,0:11:50.54,Default,,0000,0000,0000,,Сізге жаяу жүру керек! ?
Dialogue: 0,0:11:50.54,0:11:52.54,Default,,0000,0000,0000,,Бұл не...?
Dialogue: 0,0:11:54.88,0:11:57.88,Default,,0000,0000,0000,,(ит үреді)
Dialogue: 0,0:11:57.88,0:12:01.48,Default,,0000,0000,0000,,Ах, өшіргіш...
Dialogue: 0,0:12:01.48,0:12:03.82,Default,,0000,0000,0000,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:12:03.82,0:12:05.82,Default,,0000,0000,0000,,Түсіндім... Әкем де бүгін➡
Dialogue: 0,0:12:05.82,0:12:08.32,Default,,0000,0000,0000,,Менің анам да шығып жатыр...
Dialogue: 0,0:12:11.16,0:12:13.16,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:12:16.33,0:12:18.33,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:12:20.84,0:12:24.67,Default,,0000,0000,0000,,Хмф! Эй! Ха!
Dialogue: 0,0:12:24.67,0:12:27.18,Default,,0000,0000,0000,,Сәлем! Ха!
Dialogue: 0,0:12:27.18,0:12:30.68,Default,,0000,0000,0000,,Сәлем! Мүмкін емес! Ха!
Dialogue: 0,0:12:30.68,0:12:33.52,Default,,0000,0000,0000,,Қый!
Dialogue: 0,0:12:33.52,0:12:35.52,Default,,0000,0000,0000,,Мен не істеуім керек...?
Dialogue: 0,0:12:33.52,0:12:35.52,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:35.52,0:12:38.69,Default,,0000,0000,0000,,Кя~! Өтінемін көмектесіңізші!
Dialogue: 0,0:12:35.52,0:12:38.69,Default,,0000,0000,0000,,Жоқ, жоқ! кешіріңіз!
Dialogue: 0,0:12:38.69,0:12:42.36,Default,,0000,0000,0000,,Сабыр ет, сабыр ет!
Dialogue: 0,0:12:38.69,0:12:42.36,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:42.36,0:12:45.69,Default,,0000,0000,0000,,Сүйегім сынды!
Dialogue: 0,0:12:42.36,0:12:45.69,Default,,0000,0000,0000,,Осындай уақытта жалғыз.
Dialogue: 0,0:12:45.69,0:12:48.86,Default,,0000,0000,0000,,Hiii... Дүкен жоқ...➡
Dialogue: 0,0:12:48.86,0:12:51.70,Default,,0000,0000,0000,,Уф... Өшіргіш... Уф.
Dialogue: 0,0:12:51.70,0:12:55.37,Default,,0000,0000,0000,,Мен өшіргіш сатып алу үшін дүкенге бардым.
Dialogue: 0,0:12:51.70,0:12:55.37,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:12:55.37,0:12:59.21,Default,,0000,0000,0000,,Жалғыздық өте кеш
Dialogue: 0,0:12:55.37,0:12:59.21,Default,,0000,0000,0000,,Мен бірінші рет шығып тұрмын.
Dialogue: 0,0:12:59.21,0:13:02.98,Default,,0000,0000,0000,,Абайлаңыз
Dialogue: 0,0:12:59.21,0:13:02.98,Default,,0000,0000,0000,,Мына жерден шығып жатқан сияқты...
Dialogue: 0,0:13:02.98,0:13:06.65,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:13:06.65,0:13:08.65,Default,,0000,0000,0000,,Не шығады...?
Dialogue: 0,0:13:08.65,0:13:10.65,Default,,0000,0000,0000,,Бұл.
Dialogue: 0,0:13:10.65,0:13:13.66,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:13:15.66,0:13:18.16,Default,,0000,0000,0000,,А, мен.
Dialogue: 0,0:13:18.16,0:13:22.33,Default,,0000,0000,0000,,Иә, мен қазір ішіп жатырмын.
Dialogue: 0,0:13:18.16,0:13:22.33,Default,,0000,0000,0000,,Бір минут күтіңіз.
Dialogue: 0,0:13:22.33,0:13:25.50,Default,,0000,0000,0000,,Ум, Юкари және Минамо
Dialogue: 0,0:13:22.33,0:13:25.50,Default,,0000,0000,0000,,Қазір жақсы адам бар ма?
Dialogue: 0,0:13:25.50,0:13:28.34,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:13:25.50,0:13:28.34,Default,,0000,0000,0000,,Міне біз➡
Dialogue: 0,0:13:28.34,0:13:31.67,Default,,0000,0000,0000,,Кездейсоқ оқиға
Dialogue: 0,0:13:28.34,0:13:31.67,Default,,0000,0000,0000,,Бұл өте нашар.
Dialogue: 0,0:13:31.67,0:13:35.51,Default,,0000,0000,0000,,Жарайды! Адамдардың саны өте жақсы! Өтінемін тезірек кел.
Dialogue: 0,0:13:35.51,0:13:39.01,Default,,0000,0000,0000,,Бірақ біз соншалықты жақын таныс емеспіз, сондықтан мен оның жеке ісіне араласқым келмейді, сондықтан [Сыртта: 583134B86E7D90960F64C5B863196978]
Dialogue: 0,0:13:35.51,0:13:39.01,Default,,0000,0000,0000,,Негізі жұмыстағы жігіттерге➡
Dialogue: 0,0:13:39.01,0:13:41.18,Default,,0000,0000,0000,,Мен сендер туралы айтып едім.
Dialogue: 0,0:13:41.18,0:13:45.02,Default,,0000,0000,0000,,Екеуі де өте жақсы адамдар.
Dialogue: 0,0:13:41.18,0:13:45.02,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:13:45.02,0:13:47.62,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:13:52.53,0:13:54.70,Default,,0000,0000,0000,,Шие гүлін көргендей.
Dialogue: 0,0:13:54.70,0:13:57.53,Default,,0000,0000,0000,,Маған сыйлық сатып алғаныңыз өкінішті.
Dialogue: 0,0:13:57.53,0:14:01.97,Default,,0000,0000,0000,,Жарайды, дүкенге барыңыз.
Dialogue: 0,0:13:57.53,0:14:01.97,Default,,0000,0000,0000,,Мен сенен менің артымнан жүруіңді өтіндім.
Dialogue: 0,0:14:01.97,0:14:05.97,Default,,0000,0000,0000,,Маған осылай қарасаң
Dialogue: 0,0:14:01.97,0:14:05.97,Default,,0000,0000,0000,,Мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:14:05.97,0:14:09.31,Default,,0000,0000,0000,,Түнгі дүкендер көңілді.
Dialogue: 0,0:14:09.31,0:14:13.48,Default,,0000,0000,0000,,Өскенде, Түн ортасы болса да
Dialogue: 0,0:14:09.31,0:14:13.48,Default,,0000,0000,0000,,Осылайша сіз дүкенге бара аласыз.
Dialogue: 0,0:14:13.48,0:14:17.15,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:14:13.48,0:14:17.15,Default,,0000,0000,0000,,Тезірек есейгім келеді.
Dialogue: 0,0:14:17.15,0:14:19.99,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:14:17.15,0:14:19.99,Default,,0000,0000,0000,,Мен мүмкіндігінше тезірек ересек болғым келеді.
Dialogue: 0,0:14:19.99,0:14:22.16,Default,,0000,0000,0000,,Кагура-сан басқаша ма?
Dialogue: 0,0:14:22.16,0:14:26.33,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:14:22.16,0:14:26.33,Default,,0000,0000,0000,,Мен бұл туралы шынымен ойлаған жоқпын.
Dialogue: 0,0:14:26.33,0:14:30.00,Default,,0000,0000,0000,,Егер сіз жұмыс істесеңіз
Dialogue: 0,0:14:26.33,0:14:30.00,Default,,0000,0000,0000,,Мен үйленгім келмейді...
Dialogue: 0,0:14:30.00,0:14:32.33,Default,,0000,0000,0000,,Мен оны әлі елестете алмаймын.
Dialogue: 0,0:14:32.33,0:14:36.17,Default,,0000,0000,0000,,Сіз жұмыс істейсіз бе, әлде тұрмысқа шығасыз ба?
Dialogue: 0,0:14:36.17,0:14:39.51,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:14:36.17,0:14:39.51,Default,,0000,0000,0000,,Оны елестету қиын.
Dialogue: 0,0:14:39.51,0:14:41.51,Default,,0000,0000,0000,,Жоқ, Чио-чан ➡ жағдайында
Dialogue: 0,0:14:41.51,0:14:44.18,Default,,0000,0000,0000,,Бұл әлі кішкентай.
Dialogue: 0,0:14:41.51,0:14:44.18,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:14:44.18,0:14:46.58,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,0:14:44.18,0:14:46.58,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:48.52,0:14:52.52,Default,,0000,0000,0000,,Бірақ мен бәрібір
Dialogue: 0,0:14:48.52,0:14:52.52,Default,,0000,0000,0000,,Тезірек есейгім келеді.
Dialogue: 0,0:14:52.52,0:14:56.36,Default,,0000,0000,0000,,📻Иә Қайырлы кеш~
Dialogue: 0,0:14:52.52,0:14:56.36,Default,,0000,0000,0000,,Бұл Нак деген атпен белгілі Шичикуро Танака!
Dialogue: 0,0:14:56.36,0:14:58.53,Default,,0000,0000,0000,,📻Бұл Мичиру Огино, сонымен қатар Мичи деген атпен белгілі!
Dialogue: 0,0:14:58.53,0:15:02.13,Default,,0000,0000,0000,,📻 (Nack/Mitchy) Knack және Mitchy
Dialogue: 0,0:14:58.53,0:15:02.13,Default,,0000,0000,0000,,Жастар Токимеки бульвары~!
Dialogue: 0,0:15:02.13,0:15:04.63,Default,,0000,0000,0000,,📻Сіз Мичті көрдіңіз бе? Қалада шие гүлдейді.
Dialogue: 0,0:15:04.63,0:15:06.63,Default,,0000,0000,0000,,📻Гүлдер биыл ерте гүлдейді.
Dialogue: 0,0:15:06.63,0:15:09.64,Default,,0000,0000,0000,,📻Иә, мен көрдім!
Dialogue: 0,0:15:06.63,0:15:09.64,Default,,0000,0000,0000,,Студия жанындағы саябақтағы шие гүлдері ше➡
Dialogue: 0,0:15:09.64,0:15:11.64,Default,,0000,0000,0000,,Ол қазірдің өзінде гүлдеді!
Dialogue: 0,0:15:09.64,0:15:11.64,Default,,0000,0000,0000,,📻Иә.
Dialogue: 0,0:15:14.14,0:15:16.64,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:15:14.14,0:15:16.64,Default,,0000,0000,0000,,Келдің бе?
Dialogue: 0,0:15:16.64,0:15:18.64,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:21.65,0:15:23.65,Default,,0000,0000,0000,,📻Шие гүлдері дегеніміз не?
Dialogue: 0,0:15:21.65,0:15:23.65,Default,,0000,0000,0000,,Ол шашырап кетеді, солай ма?
Dialogue: 0,0:15:23.65,0:15:26.65,Default,,0000,0000,0000,,📻Бұл менмін, шие гүлдейді
Dialogue: 0,0:15:23.65,0:15:26.65,Default,,0000,0000,0000,,Мен сені жақсы көремін, бірақ...
Dialogue: 0,0:15:26.65,0:15:28.66,Default,,0000,0000,0000,,Басқа адам мұны істемейді.
Dialogue: 0,0:15:28.66,0:15:31.99,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:15:31.99,0:15:35.50,Default,,0000,0000,0000,,📻Сондықтан біз шие гүлін тамашалауға барамыз.
Dialogue: 0,0:15:31.99,0:15:35.50,Default,,0000,0000,0000,,Маған ұнамайды.
Dialogue: 0,0:15:35.50,0:15:39.33,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:39.33,0:15:41.84,Default,,0000,0000,0000,,Әй, безеуіңіз жақсы емес пе еді?
Dialogue: 0,0:15:41.84,0:15:44.04,Default,,0000,0000,0000,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,0:15:47.51,0:15:50.01,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:15:50.01,0:15:53.68,Default,,0000,0000,0000,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:15:50.01,0:15:53.68,Default,,0000,0000,0000,,Өйткені сіз осылай айтасыз➡
Dialogue: 0,0:15:53.68,0:15:56.35,Default,,0000,0000,0000,,Сол адамдар
Dialogue: 0,0:15:53.68,0:15:56.35,Default,,0000,0000,0000,,Менің ойымша, сіз оны тартып алдыңыз.
Dialogue: 0,0:15:56.35,0:15:58.85,Default,,0000,0000,0000,,Эххе~ Сәтсіздік.
Dialogue: 0,0:15:58.85,0:16:02.29,Default,,0000,0000,0000,,Танымал болады деп ойладым.
Dialogue: 0,0:15:58.85,0:16:02.29,Default,,0000,0000,0000,,Бұл өте тегіс болды.
Dialogue: 0,0:16:02.29,0:16:04.96,Default,,0000,0000,0000,,Шынымен мектеп кезімнен➡
Dialogue: 0,0:16:04.96,0:16:06.96,Default,,0000,0000,0000,,Көңіл-күй өзгермейді...
Dialogue: 0,0:16:06.96,0:16:08.96,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:16:06.96,0:16:08.96,Default,,0000,0000,0000,,Бұл өте қызық➡
Dialogue: 0,0:16:08.96,0:16:11.30,Default,,0000,0000,0000,,Ер адамдар мені жек көрді.
Dialogue: 0,0:16:11.30,0:16:14.30,Default,,0000,0000,0000,,Эй, қызықсыз адамдар.
Dialogue: 0,0:16:14.30,0:16:16.30,Default,,0000,0000,0000,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:16:14.30,0:16:16.30,Default,,0000,0000,0000,,Сізге ұнамады ма?
Dialogue: 0,0:16:18.64,0:16:20.81,Default,,0000,0000,0000,,Ах! Нямо деген осы ма?
Dialogue: 0,0:16:20.81,0:16:23.48,Default,,0000,0000,0000,,Сіз шынымен де еркекті алғыңыз келді ме? ?
Dialogue: 0,0:16:23.48,0:16:26.98,Default,,0000,0000,0000,,Тш... Жасайсың десең жаман ба?
Dialogue: 0,0:16:26.98,0:16:28.98,Default,,0000,0000,0000,,А, солай ма?
Dialogue: 0,0:16:28.98,0:16:31.82,Default,,0000,0000,0000,,Ал, рахмет.
Dialogue: 0,0:16:28.98,0:16:31.82,Default,,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,0:16:31.82,0:16:34.49,Default,,0000,0000,0000,,Иә! Мен тағы бір ішемін!
Dialogue: 0,0:16:34.49,0:16:36.66,Default,,0000,0000,0000,,Мен мұнымен келісемін!
Dialogue: 0,0:16:36.66,0:16:38.99,Default,,0000,0000,0000,,📻Е~ Менің атым
Dialogue: 0,0:16:36.66,0:16:38.99,Default,,0000,0000,0000,,Daifuku шоколады дегеніміз не➡
Dialogue: 0,0:16:38.99,0:16:41.00,Default,,0000,0000,0000,,Бұл өте тәтті есім.
Dialogue: 0,0:16:41.00,0:16:43.00,Default,,0000,0000,0000,,📻Е~
Dialogue: 0,0:16:41.00,0:16:43.00,Default,,0000,0000,0000,,Дайфуку шоколадының тапсырысы бойынша➡
Dialogue: 0,0:16:43.00,0:16:45.17,Default,,0000,0000,0000,,Ю Асакаваның «Жүрек - қыз және парашют»!
Dialogue: 0,0:16:45.17,0:16:47.17,Default,,0000,0000,0000,,📻Аа, мен бұл әнді жақсы көремін!
Dialogue: 0,0:16:47.17,0:16:50.17,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:16:50.17,0:16:52.34,Default,,0000,0000,0000,,Ойланып көріңізші.
Dialogue: 0,0:16:52.34,0:16:54.34,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:16:54.34,0:16:57.35,Default,,0000,0000,0000,,Бүгін Кагура музыкасы➡
Dialogue: 0,0:16:57.35,0:17:00.62,Default,,0000,0000,0000,,Біз оны төлей аламыз ба?
Dialogue: 0,0:16:57.35,0:17:00.62,Default,,0000,0000,0000,,Айтпадың ба?
Dialogue: 0,0:17:00.62,0:17:03.02,Default,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:17:04.95,0:17:07.96,Default,,0000,0000,0000,,Аа, дұрыс...
Dialogue: 0,0:17:07.96,0:17:11.29,Default,,0000,0000,0000,,Үйірме немесе оқу
Dialogue: 0,0:17:07.96,0:17:11.29,Default,,0000,0000,0000,,Еңбек етсең➡
Dialogue: 0,0:17:11.29,0:17:13.46,Default,,0000,0000,0000,,Мақсатқа жету мүмкіндігіне байланысты➡
Dialogue: 0,0:17:13.46,0:17:15.96,Default,,0000,0000,0000,,Мен өзімді шыдамсыз сезінемін
Dialogue: 0,0:17:13.46,0:17:15.96,Default,,0000,0000,0000,,Бұл солай емес пе?
Dialogue: 0,0:17:15.96,0:17:18.63,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:18.63,0:17:21.97,Default,,0000,0000,0000,,Біз көп жұмыс істейміз
Dialogue: 0,0:17:18.63,0:17:21.97,Default,,0000,0000,0000,,Өйткені істейтін ештеңе жоқ➡
Dialogue: 0,0:17:21.97,0:17:25.81,Default,,0000,0000,0000,,Мен шыдамсыз болғандықтан
Dialogue: 0,0:17:21.97,0:17:25.81,Default,,0000,0000,0000,,Бұл сіздің қолыңыздан келетінін білдіреді.
Dialogue: 0,0:17:25.81,0:17:28.31,Default,,0000,0000,0000,,Жақсы, мен.
Dialogue: 0,0:17:25.81,0:17:28.31,Default,,0000,0000,0000,,Бір нәрсеге көңіл бөлетіндер➡
Dialogue: 0,0:17:28.31,0:17:32.31,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:17:28.31,0:17:32.31,Default,,0000,0000,0000,,Мен қызғанамын, бірақ...
Dialogue: 0,0:17:32.31,0:17:34.32,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:34.32,0:17:42.16,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:42.16,0:17:45.33,Default,,0000,0000,0000,,Ха! неге мен
Dialogue: 0,0:17:42.16,0:17:45.33,Default,,0000,0000,0000,,Мен клубтық іс-шаралармен айналыспадым! ?
Dialogue: 0,0:17:45.33,0:17:47.83,Default,,0000,0000,0000,,Неге қазір...?
Dialogue: 0,0:17:47.83,0:17:49.83,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:17:52.00,0:17:55.34,Default,,0000,0000,0000,,Мектепте де жүгір
Dialogue: 0,0:17:52.00,0:17:55.34,Default,,0000,0000,0000,,Сіз де түнде жүгіресіз бе?
Dialogue: 0,0:17:55.34,0:17:58.01,Default,,0000,0000,0000,,Жоқ, мен қатты ұйықтай алмаймын➡
Dialogue: 0,0:17:58.01,0:18:01.28,Default,,0000,0000,0000,,Мен өзімді сергек сезінгім келгендіктен жүгірдім.
Dialogue: 0,0:18:01.28,0:18:03.61,Default,,0000,0000,0000,,Бірақ мен мына шие гүлін көргенде➡
Dialogue: 0,0:18:03.61,0:18:05.61,Default,,0000,0000,0000,,Мен ұйықтайтын сияқтымын.
Dialogue: 0,0:18:05.61,0:18:08.95,Default,,0000,0000,0000,,(Жел дыбысы)
Dialogue: 0,0:18:08.95,0:18:12.62,Default,,0000,0000,0000,,Бір қызығы, мен
Dialogue: 0,0:18:08.95,0:18:12.62,Default,,0000,0000,0000,,Мен мұны жақсы көретіндіктен істеп жүрсем де➡
Dialogue: 0,0:18:12.62,0:18:15.62,Default,,0000,0000,0000,,Сондықтан мен күйзеліске түсемін.
Dialogue: 0,0:18:15.62,0:18:18.79,Default,,0000,0000,0000,,Мен Inter-High-ге қатыса аламын деп үміттенемін.
Dialogue: 0,0:18:18.79,0:18:21.96,Default,,0000,0000,0000,,Иә? О, рахмет.
Dialogue: 0,0:18:21.96,0:18:25.13,Default,,0000,0000,0000,,Қолымнан келгенше тырысамын.
Dialogue: 0,0:18:21.96,0:18:25.13,Default,,0000,0000,0000,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:18:25.13,0:18:28.14,Default,,0000,0000,0000,,📻 Сонымен
Dialogue: 0,0:18:25.13,0:18:28.14,Default,,0000,0000,0000,,Сайтама префектурасынан Сачин-кун.
Dialogue: 0,0:18:28.14,0:18:30.14,Default,,0000,0000,0000,,📻Әрине
Dialogue: 0,0:18:28.14,0:18:30.14,Default,,0000,0000,0000,,Жүректен айырылу қайғылы болу керек➡
Dialogue: 0,0:18:30.14,0:18:32.97,Default,,0000,0000,0000,,Сезімдерің жетпесе қиын
Dialogue: 0,0:18:30.14,0:18:32.97,Default,,0000,0000,0000,,Сіз жалғыз емессіз.
Dialogue: 0,0:18:32.97,0:18:34.98,Default,,0000,0000,0000,,📻Иә.
Dialogue: 0,0:18:32.97,0:18:34.98,Default,,0000,0000,0000,,Тіпті Нактың жүрегі талай рет жараланған.
Dialogue: 0,0:18:34.98,0:18:36.98,Default,,0000,0000,0000,,📻Ой, дұрыс.
Dialogue: 0,0:18:34.98,0:18:36.98,Default,,0000,0000,0000,,Студент кезімнен➡
Dialogue: 0,0:18:36.98,0:18:38.98,Default,,0000,0000,0000,,Мені қыздар тастап кете береді➡
Dialogue: 0,0:18:38.98,0:18:42.32,Default,,0000,0000,0000,,Менің лақап атым «Жарылған жүректердің императоры» болды.
Dialogue: 0,0:18:38.98,0:18:42.32,Default,,0000,0000,0000,,Сіз нені айтасыз? Маған айтпа!
Dialogue: 0,0:18:42.32,0:18:44.82,Default,,0000,0000,0000,,📻Уххх кешіріңіз.
Dialogue: 0,0:18:42.32,0:18:44.82,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:18:44.82,0:18:47.32,Default,,0000,0000,0000,,Осы сияқты бағдарламалар үшін
Dialogue: 0,0:18:44.82,0:18:47.32,Default,,0000,0000,0000,,Ашық хаттар жіберетін жігіт ➡
Dialogue: 0,0:18:47.32,0:18:49.82,Default,,0000,0000,0000,,Маған ұнамайды!
Dialogue: 0,0:18:49.82,0:18:53.83,Default,,0000,0000,0000,,📻Қалам аты
Dialogue: 0,0:18:49.82,0:18:53.83,Default,,0000,0000,0000,,Ах, «Көз жасы тоқылған диеталық қыз».
Dialogue: 0,0:18:53.83,0:18:55.83,Default,,0000,0000,0000,,📻Ах, есімде.
Dialogue: 0,0:18:53.83,0:18:55.83,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:55.83,0:18:58.00,Default,,0000,0000,0000,,📻Бұл бұған дейін
Dialogue: 0,0:18:55.83,0:18:58.00,Default,,0000,0000,0000,,Диетаның әртүрлі әдістері➡
Dialogue: 0,0:18:58.00,0:19:00.94,Default,,0000,0000,0000,,Тырысып жатқан сенсің! Ахахха!
Dialogue: 0,0:19:00.94,0:19:02.94,Default,,0000,0000,0000,,📻Барлығы диетаға қатысты
Dialogue: 0,0:19:00.94,0:19:02.94,Default,,0000,0000,0000,,Мен осылай істеп жатырмын.
Dialogue: 0,0:19:02.94,0:19:05.94,Default,,0000,0000,0000,,📻Аздап
Dialogue: 0,0:19:02.94,0:19:05.94,Default,,0000,0000,0000,,Күлгеніме ренжідім, Нак.
Dialogue: 0,0:19:05.94,0:19:08.28,Default,,0000,0000,0000,,📻Қыздарға арналған
Dialogue: 0,0:19:05.94,0:19:08.28,Default,,0000,0000,0000,,Бұл үлкен мәселе.
Dialogue: 0,0:19:08.28,0:19:10.95,Default,,0000,0000,0000,,📻Аа, дұрыс, иә.
Dialogue: 0,0:19:08.28,0:19:10.95,Default,,0000,0000,0000,,Күлмеу керек.
Dialogue: 0,0:19:10.95,0:19:13.78,Default,,0000,0000,0000,,📻Ух~
Dialogue: 0,0:19:10.95,0:19:13.78,Default,,0000,0000,0000,,«Тыңда, Нек Мичи.
Dialogue: 0,0:19:13.78,0:19:18.62,Default,,0000,0000,0000,,📻Мен қазір
Dialogue: 0,0:19:13.78,0:19:18.62,Default,,0000,0000,0000,,Мен астықсыз диетаны қолданып көрдім.
Dialogue: 0,0:19:18.62,0:19:20.62,Default,,0000,0000,0000,,📻Иә~ Дәнсіз диета!
Dialogue: 0,0:19:20.62,0:19:22.62,Default,,0000,0000,0000,,Дәнсіз диета➡
Dialogue: 0,0:19:22.62,0:19:24.63,Default,,0000,0000,0000,,Өткен айда күнтізбе болды
Dialogue: 0,0:19:22.62,0:19:24.63,Default,,0000,0000,0000,,Ол сәтсіздікке ұшырады.
Dialogue: 0,0:19:24.63,0:19:27.63,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:19:24.63,0:19:27.63,Default,,0000,0000,0000,,Иә? Кез келген жағдайда! ?
Dialogue: 0,0:19:27.63,0:19:29.63,Default,,0000,0000,0000,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:19:29.63,0:19:33.47,Default,,0000,0000,0000,,А, бұл жұлдыз!
Dialogue: 0,0:19:29.63,0:19:33.47,Default,,0000,0000,0000,,Уау! Бұл ұят!
Dialogue: 0,0:19:33.47,0:19:36.30,Default,,0000,0000,0000,,Осы сияқты бағдарламалар үшін
Dialogue: 0,0:19:33.47,0:19:36.30,Default,,0000,0000,0000,,Мен ашық хаттар жіберемін!
Dialogue: 0,0:19:36.30,0:19:39.31,Default,,0000,0000,0000,,Уау~ Күнтізбені оқығанда ұят болды!
Dialogue: 0,0:19:39.31,0:19:41.81,Default,,0000,0000,0000,,Көз жасы төгілген диеталық қыз!
Dialogue: 0,0:19:41.81,0:19:44.65,Default,,0000,0000,0000,,Ой, бұл мені жылатады!
Dialogue: 0,0:19:41.81,0:19:44.65,Default,,0000,0000,0000,,Шулы, шулы!
Dialogue: 0,0:19:44.65,0:19:46.65,Default,,0000,0000,0000,,📻 3 күнде бірінші рет тамақ жеу ➡
Dialogue: 0,0:19:46.65,0:19:49.65,Default,,0000,0000,0000,,Дәмді заттар туралы айту
Dialogue: 0,0:19:46.65,0:19:49.65,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:19:49.65,0:19:53.82,Default,,0000,0000,0000,,📻Бұл өте дәмді
Dialogue: 0,0:19:49.65,0:19:53.82,Default,,0000,0000,0000,,Мен тіпті екінші көмекке тапсырыс бердім!
Dialogue: 0,0:19:53.82,0:19:56.49,Default,,0000,0000,0000,,📻Эх~ Келесі күні салмақ өлшегенде➡
Dialogue: 0,0:19:56.49,0:19:58.66,Default,,0000,0000,0000,,Үш күн бұрынғыдан өсті.
Dialogue: 0,0:19:58.66,0:20:01.33,Default,,0000,0000,0000,,📻Әрине!
Dialogue: 0,0:19:58.66,0:20:01.33,Default,,0000,0000,0000,,Астықсыз диетаның жауы ➡
Dialogue: 0,0:20:01.33,0:20:04.33,Default,,0000,0000,0000,,Бұл менің анамның мәзірі еді!
Dialogue: 0,0:20:01.33,0:20:04.33,Default,,0000,0000,0000,,Сендер тым талапшылсыңдар — менің кимоном мүлдем кір емес.
Dialogue: 0,0:20:04.33,0:20:07.84,Default,,0000,0000,0000,,Күлме!
Dialogue: 0,0:20:04.33,0:20:07.84,Default,,0000,0000,0000,,Өйткені бұл жай ғана күлдіретін әзіл!
Dialogue: 0,0:20:07.84,0:20:10.50,Default,,0000,0000,0000,,Менің алдымда адамдар маған күлсе ашуланамын!
Dialogue: 0,0:20:10.50,0:20:13.17,Default,,0000,0000,0000,,📻Күрішсіз карри міндетті түрде
Dialogue: 0,0:20:10.50,0:20:13.17,Default,,0000,0000,0000,,Тамақ жеу қиын сияқты.
Dialogue: 0,0:20:13.17,0:20:15.34,Default,,0000,0000,0000,,📻Бұл көңілді қалдырды.
Dialogue: 0,0:20:13.17,0:20:15.34,Default,,0000,0000,0000,,Диетаның көзіне жас алған қыз!
Dialogue: 0,0:20:15.34,0:20:17.68,Default,,0000,0000,0000,,📻Келесі диетаны қайталап көргенде
Dialogue: 0,0:20:15.34,0:20:17.68,Default,,0000,0000,0000,,Хабарлаңыз!
Dialogue: 0,0:20:17.68,0:20:20.35,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:20:17.68,0:20:20.35,Default,,0000,0000,0000,,📻Мен де сіздерді жақсы көремін!
Dialogue: 0,0:20:20.35,0:20:22.35,Default,,0000,0000,0000,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:20:22.35,0:20:24.35,Default,,0000,0000,0000,,Бакка!
Dialogue: 0,0:20:24.35,0:20:26.35,Default,,0000,0000,0000,,Радиоға жауап беру!
Dialogue: 0,0:20:26.35,0:20:28.36,Default,,0000,0000,0000,,Қырықша… әрине!
Dialogue: 0,0:20:26.35,0:20:28.36,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:20:28.36,0:20:31.86,Default,,0000,0000,0000,,Уау, көз жасы тамған диета қыз!
Dialogue: 0,0:20:28.36,0:20:31.86,Default,,0000,0000,0000,,Өте өкінішті! ?
Dialogue: 0,0:20:31.86,0:20:34.70,Default,,0000,0000,0000,,Жаман емес
Dialogue: 0,0:20:31.86,0:20:34.70,Default,,0000,0000,0000,,Өте күлкілі!
Dialogue: 0,0:20:34.70,0:20:38.37,Default,,0000,0000,0000,,Сіз оны төлей аласыз ба? Бұл нені білдіреді?
Dialogue: 0,0:20:38.37,0:20:41.54,Default,,0000,0000,0000,,Менің қолымнан келмейді...
Dialogue: 0,0:20:41.54,0:20:45.71,Default,,0000,0000,0000,,Эйко, не болып жатыр?
Dialogue: 0,0:20:41.54,0:20:45.71,Default,,0000,0000,0000,,Бұл қатты болды, солай емес пе?
Dialogue: 0,0:20:45.71,0:20:48.21,Default,,0000,0000,0000,,А, солай ма?
Dialogue: 0,0:20:48.21,0:20:51.05,Default,,0000,0000,0000,,Эйко әкелген адам➡
Dialogue: 0,0:20:51.05,0:20:54.88,Default,,0000,0000,0000,,Бізді балаша дейді.
Dialogue: 0,0:20:51.05,0:20:54.88,Default,,0000,0000,0000,,Сіз олай ойламадыңыз ба?
Dialogue: 0,0:20:54.88,0:20:58.89,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:20:54.88,0:20:58.89,Default,,0000,0000,0000,,Мен солай сезінемін.
Dialogue: 0,0:20:58.89,0:21:01.09,Default,,0000,0000,0000,,Бұл менің қиялым ғана ма?
Dialogue: 0,0:21:03.99,0:21:07.50,Default,,0000,0000,0000,,Менің ойымша, мен келісімді некеге тұруға тырысамын ...
Dialogue: 0,0:21:07.50,0:21:11.00,Default,,0000,0000,0000,,Сәйкестік?
Dialogue: 0,0:21:07.50,0:21:11.00,Default,,0000,0000,0000,,Осындай әңгіме бар.
Dialogue: 0,0:21:11.00,0:21:13.00,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:21:13.00,0:21:15.84,Default,,0000,0000,0000,,Бұл мен туралы.
Dialogue: 0,0:21:15.84,0:21:19.34,Default,,0000,0000,0000,,Дұрыс...бұл мен туралы.
Dialogue: 0,0:21:21.34,0:21:23.34,Default,,0000,0000,0000,,Сонымен, сіз келісімді некеге тұрасыз ба?
Dialogue: 0,0:21:26.18,0:21:28.18,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:21:31.02,0:21:33.02,Default,,0000,0000,0000,,(ысқырық)
Dialogue: 0,0:21:33.02,0:21:36.19,Default,,0000,0000,0000,,Неліктен көктем деп аталады?
Dialogue: 0,0:21:33.02,0:21:36.19,Default,,0000,0000,0000,,Сіз осылай ұйықтағыңыз келеді.
Dialogue: 0,0:21:36.19,0:21:38.19,Default,,0000,0000,0000,,Хигу!
Dialogue: 0,0:21:36.19,0:21:38.19,Default,,0000,0000,0000,,(ысқырық)
Dialogue: 0,0:21:38.19,0:21:40.70,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:21:38.19,0:21:40.70,Default,,0000,0000,0000,,Себебі мен кеш қалатынмын.
Dialogue: 0,0:21:40.70,0:21:42.70,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:21:40.70,0:21:42.70,Default,,0000,0000,0000,,(ысқырық)
Dialogue: 0,0:21:42.70,0:21:45.37,Default,,0000,0000,0000,,Осака ~ Мықты болыңыз!
Dialogue: 0,0:21:45.37,0:21:47.37,Default,,0000,0000,0000,,де...
Dialogue: 0,0:21:47.37,0:21:49.37,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:49.37,0:21:51.87,Default,,0000,0000,0000,,О! Керемет жұмыс!
Dialogue: 0,0:21:51.87,0:21:54.07,Default,,0000,0000,0000,,Қандай керемет акуби!
Dialogue: 0,0:21:51.87,0:21:54.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:55.57,0:22:01.57,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory