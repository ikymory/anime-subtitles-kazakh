Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.02,0:01:33.69,Default,,0000,0000,0000,,Міне, келесі ай да келді.
Dialogue: 0,0:01:30.02,0:01:33.69,Default,,0000,0000,0000,,Мектепке саяхат болады.
Dialogue: 0,0:01:33.69,0:01:37.69,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:01:33.69,0:01:37.69,Default,,0000,0000,0000,,Бұл қызық болатын сияқты, Чио-чан.
Dialogue: 0,0:01:37.69,0:01:42.53,Default,,0000,0000,0000,,Хааа~!
Dialogue: 0,0:01:42.53,0:01:45.53,Default,,0000,0000,0000,,Шын мәнінде
Dialogue: 0,0:01:42.53,0:01:45.53,Default,,0000,0000,0000,,Мектеп саяхаты тоқтатылды.
Dialogue: 0,0:01:45.53,0:01:47.53,Default,,0000,0000,0000,,Гаа! ?
Dialogue: 0,0:01:49.70,0:01:51.71,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:01:51.71,0:01:53.71,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:01:53.71,0:01:59.21,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:59.21,0:02:02.32,Default,,0000,0000,0000,,Бұл өтірік!
Dialogue: 0,0:01:59.21,0:02:02.32,Default,,0000,0000,0000,,Эхехе.
Dialogue: 0,0:01:59.21,0:02:02.32,Default,,0000,0000,0000,,(Оқушылар күрсінеді)
Dialogue: 0,0:02:02.32,0:02:07.32,Default,,0000,0000,0000,,Я~ Чио-чан
Dialogue: 0,0:02:02.32,0:02:07.32,Default,,0000,0000,0000,,Сіз күліп тұрғанда...
Dialogue: 0,0:02:07.32,0:02:09.62,Default,,0000,0000,0000,,Иә. Мен түссіндім.
Dialogue: 0,0:02:11.99,0:02:14.00,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:02:14.00,0:02:17.00,Default,,0000,0000,0000,,Енді осында
Dialogue: 0,0:02:14.00,0:02:17.00,Default,,0000,0000,0000,,Мектеп саяхатының бетбелгісі бар.
Dialogue: 0,0:02:17.00,0:02:19.17,Default,,0000,0000,0000,,Мен қараймын.
Dialogue: 0,0:02:19.17,0:02:23.84,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:02:19.17,0:02:23.84,Default,,0000,0000,0000,,Мектепке бару ермек үшін емес.
Dialogue: 0,0:02:23.84,0:02:27.68,Default,,0000,0000,0000,,Бұл сыныптың бір бөлігі ме?
Dialogue: 0,0:02:23.84,0:02:27.68,Default,,0000,0000,0000,,Толық хабардар...
Онда
Dialogue: 0,0:02:27.68,0:02:30.35,Default,,0000,0000,0000,,Хехе….
Dialogue: 0,0:02:27.68,0:02:30.35,Default,,0000,0000,0000,,➡ деп жазылған
Dialogue: 0,0:02:30.35,0:02:33.01,Default,,0000,0000,0000,,Бұл жай ғана ойын.
Dialogue: 0,0:02:30.35,0:02:33.01,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:02:33.01,0:02:35.01,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:02:37.52,0:02:40.36,Default,,0000,0000,0000,,Бірақ! Көңілді бағаламаңыз!
Dialogue: 0,0:02:40.36,0:02:43.53,Default,,0000,0000,0000,,Белгісіз қалада, шектеулі уақытқа➡
Dialogue: 0,0:02:43.53,0:02:46.53,Default,,0000,0000,0000,,Жақсы ойнау қиын.
Dialogue: 0,0:02:46.53,0:02:48.53,Default,,0000,0000,0000,,Бұл адамдардың кейбірі ➡
Dialogue: 0,0:02:48.53,0:02:51.20,Default,,0000,0000,0000,,Мектепке өкінішпен саяхатта
Dialogue: 0,0:02:48.53,0:02:51.20,Default,,0000,0000,0000,,Бұл аяқталады.
Dialogue: 0,0:02:51.20,0:02:54.60,Default,,0000,0000,0000,,Хехехе... Ухехехе.
Dialogue: 0,0:02:57.87,0:03:00.31,Default,,0000,0000,0000,,Соңында, мектеп саяхаты!
Dialogue: 0,0:03:00.31,0:03:02.81,Default,,0000,0000,0000,,Бұл менің мектепке бірінші рет баруым.
Dialogue: 0,0:03:02.81,0:03:04.81,Default,,0000,0000,0000,,～
Dialogue: 0,0:03:04.81,0:03:07.32,Default,,0000,0000,0000,,Чио-чан бастауыш мектебі
Dialogue: 0,0:03:04.81,0:03:07.32,Default,,0000,0000,0000,,Жолдың жартысы ғана қалды.
Dialogue: 0,0:03:07.32,0:03:11.32,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:03:07.32,0:03:11.32,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:07.32,0:03:11.32,Default,,0000,0000,0000,,Заңды айтып берейін.
Dialogue: 0,0:03:11.32,0:03:13.32,Default,,0000,0000,0000,,Әй, оян! ?
Dialogue: 0,0:03:13.32,0:03:15.99,Default,,0000,0000,0000,,Кәдесый ретінде ағаш қылыш сатып ал!
Dialogue: 0,0:03:15.99,0:03:17.99,Default,,0000,0000,0000,,Ағаш қылыш! ?
Dialogue: 0,0:03:17.99,0:03:20.16,Default,,0000,0000,0000,,Шинсенгуми ағаш қылышта бақытты!
Dialogue: 0,0:03:20.16,0:03:23.16,Default,,0000,0000,0000,,Бақытты! ? Бақытты….
Dialogue: 0,0:03:23.16,0:03:27.17,Default,,0000,0000,0000,,Чио-чан….
Dialogue: 0,0:03:23.16,0:03:27.17,Default,,0000,0000,0000,,Команда Шешім бе, әлде бір нәрсе ме, білмеймін.
Dialogue: 0,0:03:27.17,0:03:30.67,Default,,0000,0000,0000,,Бір топ
Dialogue: 0,0:03:27.17,0:03:30.67,Default,,0000,0000,0000,,Сіз 6 адам дедіңіз!
Dialogue: 0,0:03:30.67,0:03:34.84,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:03:30.67,0:03:34.84,Default,,0000,0000,0000,,Сосын мен, Чио-чан және Осака.
Dialogue: 0,0:03:34.84,0:03:37.51,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:03:34.84,0:03:37.51,Default,,0000,0000,0000,,Сакаки мен Кагура.
Dialogue: 0,0:03:37.51,0:03:39.51,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:39.51,0:03:43.18,Default,,0000,0000,0000,,5 адамнан тұратын команда жеткілікті.
Dialogue: 0,0:03:39.51,0:03:43.18,Default,,0000,0000,0000,,Болмады ма?
Dialogue: 0,0:03:43.18,0:03:46.19,Default,,0000,0000,0000,,Эй, сен мені қалжыңдап тұрсың, сеньор.
Dialogue: 0,0:03:46.19,0:03:49.09,Default,,0000,0000,0000,,Чио-чан, нұсқаулықты көргің келе ме?
Dialogue: 0,0:03:46.19,0:03:49.09,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:03:51.03,0:03:53.36,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:03:53.36,0:03:56.20,Default,,0000,0000,0000,,А, мен оны асыға күтемін.
Dialogue: 0,0:03:56.20,0:03:59.03,Default,,0000,0000,0000,,Бұл өте қызық болатынына сенімдімін.
Dialogue: 0,0:03:59.03,0:04:01.80,Default,,0000,0000,0000,,Иә! Бұл дұрыс!
Dialogue: 0,0:04:01.80,0:04:05.81,Default,,0000,0000,0000,,Ол кезде солай болатын
Dialogue: 0,0:04:01.80,0:04:05.81,Default,,0000,0000,0000,,Қандай апатты сапар➡
Dialogue: 0,0:04:05.81,0:04:08.98,Default,,0000,0000,0000,,Мен бұл туралы ешқашан армандаған емеспін ...
Dialogue: 0,0:04:08.98,0:04:11.65,Default,,0000,0000,0000,,т.б.
Dialogue: 0,0:04:08.98,0:04:11.65,Default,,0000,0000,0000,,Біртүрлі әңгімені қоспаңыз!
Dialogue: 0,0:04:11.65,0:04:15.82,Default,,0000,0000,0000,,♬ «Қызықты, қызық, қызық ай»
Dialogue: 0,0:04:15.82,0:04:18.12,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:04:21.32,0:04:24.66,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:04:24.66,0:04:29.00,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:04:29.00,0:04:31.17,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:04:31.17,0:04:34.00,Default,,0000,0000,0000,,Сәлеметсіз бе?
Dialogue: 0,0:04:31.17,0:04:34.00,Default,,0000,0000,0000,,Оқыдыңыз ба?
Dialogue: 0,0:04:34.00,0:04:37.34,Default,,0000,0000,0000,,Томо~ Окинаваға уақыт таяп қалды~.
Dialogue: 0,0:04:37.34,0:04:39.54,Default,,0000,0000,0000,,Ах!?
Dialogue: 0,0:04:42.68,0:04:45.01,Default,,0000,0000,0000,,Жарайсыңдар! Барлығы сонда ма?
Dialogue: 0,0:04:45.01,0:04:48.35,Default,,0000,0000,0000,,Егер жоқ болсаң, қолыңды көтер~! О құдайым-ай!
Dialogue: 0,0:04:48.35,0:04:50.52,Default,,0000,0000,0000,,Иә! Мен мұнда емеспін!
Dialogue: 0,0:04:50.52,0:04:52.52,Default,,0000,0000,0000,,Міне, сіз!
Dialogue: 0,0:04:52.52,0:04:55.69,Default,,0000,0000,0000,,Иә! Бұдан былай
Dialogue: 0,0:04:52.52,0:04:55.69,Default,,0000,0000,0000,,Мен Окинаваға бара жатырмын➡
Dialogue: 0,0:04:55.69,0:04:57.86,Default,,0000,0000,0000,,Үйге жеткенше мектеп саяхаты!
Dialogue: 0,0:04:57.86,0:04:59.86,Default,,0000,0000,0000,,Ура.
Dialogue: 0,0:04:57.86,0:04:59.86,Default,,0000,0000,0000,,Әуежай кәдесыйы!
Dialogue: 0,0:04:59.86,0:05:02.06,Default,,0000,0000,0000,,Ол ұшып келеді.
Dialogue: 0,0:04:59.86,0:05:02.06,Default,,0000,0000,0000,,Ой, мен оны сатып алдым...
Dialogue: 0,0:05:04.47,0:05:07.47,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:05:07.47,0:05:09.80,Default,,0000,0000,0000,,Бірақ мен біраз қобалжыдым...
Dialogue: 0,0:05:09.80,0:05:13.10,Default,,0000,0000,0000,,Иә, бортта қаншама адам бар.
Dialogue: 0,0:05:09.80,0:05:13.10,Default,,0000,0000,0000,,Ол ұша алмауы мүмкін.
Dialogue: 0,0:05:18.98,0:05:20.98,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:05:20.98,0:05:23.99,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:05:20.98,0:05:23.99,Default,,0000,0000,0000,,Уа, мен ұшқым келеді!
Dialogue: 0,0:05:20.98,0:05:23.99,Default,,0000,0000,0000,,Капитан!
Dialogue: 0,0:05:23.99,0:05:26.32,Default,,0000,0000,0000,,Уау! ?
Dialogue: 0,0:05:23.99,0:05:26.32,Default,,0000,0000,0000,,(ұшу дыбысы)
Dialogue: 0,0:05:26.32,0:05:28.32,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:28.32,0:05:31.83,Default,,0000,0000,0000,,Керемет күш!
Dialogue: 0,0:05:28.32,0:05:31.83,Default,,0000,0000,0000,,Бұл ұшады! Сіз ұша аласыз!
Dialogue: 0,0:05:31.83,0:05:35.33,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:31.83,0:05:35.33,Default,,0000,0000,0000,,Шулы.
Dialogue: 0,0:05:35.33,0:05:38.63,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:05:44.84,0:05:48.18,Default,,0000,0000,0000,,(Жел мен толқынның дыбысы)
Dialogue: 0,0:05:48.18,0:05:51.85,Default,,0000,0000,0000,,Окинава….
Dialogue: 0,0:05:51.85,0:05:55.35,Default,,0000,0000,0000,,Окинава….
Dialogue: 0,0:05:55.35,0:05:57.35,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:05:57.35,0:06:00.62,Default,,0000,0000,0000,,Аспан көк! Ааа….
Dialogue: 0,0:06:00.62,0:06:05.13,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:05.13,0:06:07.46,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:06:05.13,0:06:07.46,Default,,0000,0000,0000,,Дүрбелең емес!
Dialogue: 0,0:06:07.46,0:06:10.80,Default,,0000,0000,0000,,Ааа….
Dialogue: 0,0:06:10.80,0:06:13.63,Default,,0000,0000,0000,,Иә! Ахаха!
Dialogue: 0,0:06:13.63,0:06:17.31,Default,,0000,0000,0000,,Ах, бұл Окинава сөзі.
Dialogue: 0,0:06:17.31,0:06:19.31,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:06:19.31,0:06:21.64,Default,,0000,0000,0000,,Сәлеметсіз бе? сол.
Dialogue: 0,0:06:21.64,0:06:23.64,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:06:23.64,0:06:27.32,Default,,0000,0000,0000,,Не….
Dialogue: 0,0:06:23.64,0:06:27.32,Default,,0000,0000,0000,,Мұндай жағдайларда
Dialogue: 0,0:06:23.64,0:06:27.32,Default,,0000,0000,0000,,Бұл Окинава деп қалай айтасыз?
Dialogue: 0,0:06:27.32,0:06:30.15,Default,,0000,0000,0000,,Осындай кездерде?
Dialogue: 0,0:06:27.32,0:06:30.15,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:30.15,0:06:32.15,Default,,0000,0000,0000,,Сәлем! Атта!
Dialogue: 0,0:06:32.15,0:06:34.66,Default,,0000,0000,0000,,«Аға~» дейді...
Dialogue: 0,0:06:34.66,0:06:37.33,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:06:37.33,0:06:39.53,Default,,0000,0000,0000,,Өте беделді адамды әкеліпсің ғой, иә?
Dialogue: 0,0:06:43.83,0:06:46.50,Default,,0000,0000,0000,,О, бұл Шуреймон ба?
Dialogue: 0,0:06:46.50,0:06:48.84,Default,,0000,0000,0000,,Иә, мүмкін, анық.
Dialogue: 0,0:06:48.84,0:06:51.67,Default,,0000,0000,0000,,Эххе~.
Dialogue: 0,0:06:51.67,0:06:53.67,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:06:53.67,0:06:56.01,Default,,0000,0000,0000,,О, бұл керемет! Бұл 2000 иендік купюра!
Dialogue: 0,0:06:56.01,0:06:58.51,Default,,0000,0000,0000,,О.
Dialogue: 0,0:06:58.51,0:07:00.78,Default,,0000,0000,0000,,Хоо~.
Dialogue: 0,0:07:00.78,0:07:04.62,Default,,0000,0000,0000,,өтіңіз.
Dialogue: 0,0:07:00.78,0:07:04.62,Default,,0000,0000,0000,,Бұл шынымен де солай.
Dialogue: 0,0:07:04.62,0:07:07.46,Default,,0000,0000,0000,,Тіпті суда
Dialogue: 0,0:07:04.62,0:07:07.46,Default,,0000,0000,0000,,Шуреймон қақпасы ішінде.
Dialogue: 0,0:07:07.46,0:07:09.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:07.46,0:07:09.96,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:07:09.96,0:07:12.13,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:07:12.13,0:07:15.13,Default,,0000,0000,0000,,Уа.
Dialogue: 0,0:07:15.13,0:07:17.13,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:07:17.13,0:07:19.13,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:07:19.13,0:07:24.64,Default,,0000,0000,0000,,♬ (саншин)
Dialogue: 0,0:07:24.64,0:07:28.98,Default,,0000,0000,0000,,Ах! Шиса бар.
Dialogue: 0,0:07:28.98,0:07:33.48,Default,,0000,0000,0000,,«Бұл Шиса ма?» деп қалай айтасыз? Окинаванда?
Dialogue: 0,0:07:35.48,0:07:39.49,Default,,0000,0000,0000,,Бұл Шиса ма, әлде Иби-ми ме?
Dialogue: 0,0:07:39.49,0:07:42.99,Default,,0000,0000,0000,,Шиса Яиби-ми?
Dialogue: 0,0:07:42.99,0:07:46.16,Default,,0000,0000,0000,,Уре~ Шиса Яиби~н.
Dialogue: 0,0:07:46.16,0:07:49.00,Default,,0000,0000,0000,,6 жоғары сынып оқушылары!
Dialogue: 0,0:07:49.00,0:07:52.00,Default,,0000,0000,0000,,Жарайды, кеттік!
Dialogue: 0,0:07:52.00,0:07:56.50,Default,,0000,0000,0000,,♬ (Чи) “Окинава Окинава Окинава”
Dialogue: 0,0:07:56.50,0:07:58.67,Default,,0000,0000,0000,,Панпан!
Dialogue: 0,0:07:58.67,0:08:01.11,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:08:01.11,0:08:04.61,Default,,0000,0000,0000,,Мұнда да Шиса мүсіндері бар.
Dialogue: 0,0:08:04.61,0:08:08.45,Default,,0000,0000,0000,,Ерм, м...
Dialogue: 0,0:08:08.45,0:08:12.45,Default,,0000,0000,0000,,Шиса Яйбин.
Dialogue: 0,0:08:12.45,0:08:15.96,Default,,0000,0000,0000,,Шиса Яйбин.
Dialogue: 0,0:08:15.96,0:08:17.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:17.96,0:08:20.13,Default,,0000,0000,0000,,Шиса Яиби-ми?
Dialogue: 0,0:08:20.13,0:08:23.80,Default,,0000,0000,0000,,О, бұл Шиса Айбиран!
Dialogue: 0,0:08:23.80,0:08:26.63,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:08:26.63,0:08:30.81,Default,,0000,0000,0000,,Окинава～ Окинава～.
Dialogue: 0,0:08:30.81,0:08:33.47,Default,,0000,0000,0000,,Окинава.
Dialogue: 0,0:08:33.47,0:08:35.48,Default,,0000,0000,0000,,Шулы.
Dialogue: 0,0:08:35.48,0:08:46.28,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:48.66,0:08:50.99,Default,,0000,0000,0000,,Қонақ үй!
Dialogue: 0,0:08:48.66,0:08:50.99,Default,,0000,0000,0000,,О!
Dialogue: 0,0:08:50.99,0:08:54.00,Default,,0000,0000,0000,,Кешкі ас!
Dialogue: 0,0:08:50.99,0:08:54.00,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:54.00,0:08:56.50,Default,,0000,0000,0000,,О! Викинг!
Dialogue: 0,0:08:56.50,0:08:58.50,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:09:00.43,0:09:03.77,Default,,0000,0000,0000,,Ха!?
Dialogue: 0,0:09:00.43,0:09:03.77,Default,,0000,0000,0000,,Шектегіш жойылды!
Dialogue: 0,0:09:03.77,0:09:05.77,Default,,0000,0000,0000,,Сіз ұтыласыз ба?
Dialogue: 0,0:09:05.77,0:09:08.97,Default,,0000,0000,0000,,Мынаны да же! Мынаны да жеп ал!
Dialogue: 0,0:09:05.77,0:09:08.97,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:09:10.95,0:09:13.61,Default,,0000,0000,0000,,бұл...
Dialogue: 0,0:09:10.95,0:09:13.61,Default,,0000,0000,0000,,О, Чампуруя.
Dialogue: 0,0:09:13.61,0:09:17.12,Default,,0000,0000,0000,,Иә, өйткені бұл Окинава.
Dialogue: 0,0:09:13.61,0:09:17.12,Default,,0000,0000,0000,,Мен мұны жеуім керек!
Dialogue: 0,0:09:17.12,0:09:19.29,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:09:19.29,0:09:22.29,Default,,0000,0000,0000,,Гойя Чампуру.
Dialogue: 0,0:09:22.29,0:09:25.13,Default,,0000,0000,0000,,Фуучампур~.
Dialogue: 0,0:09:25.13,0:09:28.30,Default,,0000,0000,0000,,Сомин Чампуру~.
Dialogue: 0,0:09:28.30,0:09:32.97,Default,,0000,0000,0000,,Ерм, ерм, ерм….
Dialogue: 0,0:09:32.97,0:09:36.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:32.97,0:09:36.07,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:09:38.64,0:09:41.04,Default,,0000,0000,0000,,Чампуру~!
Dialogue: 0,0:09:44.15,0:09:46.48,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:09:46.48,0:09:49.65,Default,,0000,0000,0000,,Кеше Шури сарайы болса, бүгін Манза мүйісі.
Dialogue: 0,0:09:49.65,0:09:52.15,Default,,0000,0000,0000,,Сізге негізгі курс ұнаған сияқты.
Dialogue: 0,0:09:52.15,0:09:54.16,Default,,0000,0000,0000,,Yaho!
Dialogue: 0,0:09:54.16,0:09:57.99,Default,,0000,0000,0000,,Бұл жартас. Бұл жартас...
Dialogue: 0,0:09:54.16,0:09:57.99,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:09:57.99,0:10:00.33,Default,,0000,0000,0000,,Чиёчан.
Dialogue: 0,0:09:57.99,0:10:00.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:00.33,0:10:02.66,Default,,0000,0000,0000,,Жоғары!
Dialogue: 0,0:10:00.33,0:10:02.66,Default,,0000,0000,0000,,Гяаааа Чи-чан!
Dialogue: 0,0:10:02.66,0:10:04.67,Default,,0000,0000,0000,,Міне міне міне.
Dialogue: 0,0:10:02.66,0:10:04.67,Default,,0000,0000,0000,,Міне! Чи, тоқта!
Dialogue: 0,0:10:04.67,0:10:07.17,Default,,0000,0000,0000,,Чио-чан!
Dialogue: 0,0:10:04.67,0:10:07.17,Default,,0000,0000,0000,,Гяаааа~!
Dialogue: 0,0:10:07.17,0:10:09.84,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:07.17,0:10:09.84,Default,,0000,0000,0000,,Чиёчан!
Dialogue: 0,0:10:09.84,0:10:12.34,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:10:09.84,0:10:12.34,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:10:12.34,0:10:14.84,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:10:12.34,0:10:14.84,Default,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,0:10:14.84,0:10:17.01,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:10:17.01,0:10:19.01,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:10:19.01,0:10:21.52,Default,,0000,0000,0000,,Осака жеткілікті.
Dialogue: 0,0:10:19.01,0:10:21.52,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:21.52,0:10:25.69,Default,,0000,0000,0000,,Иә Назар аударыңыз!
Dialogue: 0,0:10:21.52,0:10:25.69,Default,,0000,0000,0000,,Келесі - сынақтық дайвинг!
Dialogue: 0,0:10:25.69,0:10:29.02,Default,,0000,0000,0000,,Мен мұны сіздің командаңызбен бірге орындаймын.
Dialogue: 0,0:10:29.02,0:10:32.19,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:10:29.02,0:10:32.19,Default,,0000,0000,0000,,Бірінші рет сүңгу!
Dialogue: 0,0:10:32.19,0:10:34.36,Default,,0000,0000,0000,,Эй, мен оны асыға күтемін! Эй!
Dialogue: 0,0:10:34.36,0:10:37.03,Default,,0000,0000,0000,,Аа, мен мұны бұрын жасағанмын.
Dialogue: 0,0:10:37.03,0:10:39.37,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:10:39.37,0:10:43.87,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:10:39.37,0:10:43.87,Default,,0000,0000,0000,,О! Мына баланы теңізге лақтыр!
Dialogue: 0,0:10:43.87,0:11:27.18,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:11:27.18,0:11:31.85,Default,,0000,0000,0000,,Теңіз Теңіз Теңіз Теңіз~.
Dialogue: 0,0:11:31.85,0:11:36.19,Default,,0000,0000,0000,,Бұл өте қызықты болды.
Dialogue: 0,0:11:31.85,0:11:36.19,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:11:36.19,0:11:38.69,Default,,0000,0000,0000,,О! Бұл өте қызықты болды!
Dialogue: 0,0:11:38.69,0:11:41.53,Default,,0000,0000,0000,,Бұл жігіт керемет
Dialogue: 0,0:11:38.69,0:11:41.53,Default,,0000,0000,0000,,Сіз бұлай айта алмайсыз!
Dialogue: 0,0:11:41.53,0:11:43.53,Default,,0000,0000,0000,,Не айта аламын...
Dialogue: 0,0:11:46.20,0:11:48.20,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:11:46.20,0:11:48.20,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:11:48.20,0:11:50.90,Default,,0000,0000,0000,,Бұл өте қызықты болды!
Dialogue: 0,0:11:54.71,0:11:56.71,Default,,0000,0000,0000,,Кәдесый ретінде не алуым керек?
Dialogue: 0,0:11:56.71,0:12:06.99,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:06.99,0:12:08.99,Default,,0000,0000,0000,,Чинсукоу.
Dialogue: 0,0:12:06.99,0:12:08.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:08.99,0:12:10.99,Default,,0000,0000,0000,,Чинсукоу.
Dialogue: 0,0:12:10.99,0:12:14.83,Default,,0000,0000,0000,,Сіз оны сатып аласыз ба?
Dialogue: 0,0:12:10.99,0:12:14.83,Default,,0000,0000,0000,,Чинсукоу.
Dialogue: 0,0:12:14.83,0:12:17.16,Default,,0000,0000,0000,,Чинсукоу!
Dialogue: 0,0:12:17.16,0:12:20.50,Default,,0000,0000,0000,,Чинсуку Чинсуку.
Dialogue: 0,0:12:20.50,0:12:22.50,Default,,0000,0000,0000,,Чинсукоу.
Dialogue: 0,0:12:22.50,0:12:24.80,Default,,0000,0000,0000,,Бұл шулы.
Dialogue: 0,0:12:27.51,0:12:29.51,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:12:29.51,0:12:32.68,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:12:29.51,0:12:32.68,Default,,0000,0000,0000,,Мына кішкентай Шиса өте сүйкімді!
Dialogue: 0,0:12:32.68,0:12:36.18,Default,,0000,0000,0000,,Иә! Күшті.
Dialogue: 0,0:12:36.18,0:12:38.19,Default,,0000,0000,0000,,Ахаха.
Dialogue: 0,0:12:38.19,0:12:43.19,Default,,0000,0000,0000,,Әрбір бөліктің бет-әлпеті аздап ерекшеленеді, бұл оған қолдан жасалған сезім береді.
Dialogue: 0,0:12:43.19,0:12:45.86,Default,,0000,0000,0000,,Бұл... жоқ, бұл?
Dialogue: 0,0:12:45.86,0:12:48.03,Default,,0000,0000,0000,,Мен мұны істеймін~!
Dialogue: 0,0:12:48.03,0:12:50.03,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:12:50.03,0:12:52.70,Default,,0000,0000,0000,,Шиса Яйбин.
Dialogue: 0,0:12:50.03,0:12:52.70,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:52.70,0:12:55.04,Default,,0000,0000,0000,,Осака мырза, Кагура мырза.
Dialogue: 0,0:12:55.04,0:12:59.87,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:12:55.04,0:12:59.87,Default,,0000,0000,0000,,Хахахаха Чио-чан!
Dialogue: 0,0:12:59.87,0:13:01.81,Default,,0000,0000,0000,,500 метр радиустағы тұрғындар да көшірілді.
Dialogue: 0,0:13:01.81,0:13:04.15,Default,,0000,0000,0000,,Жақсы иіс шығады.
Dialogue: 0,0:13:01.81,0:13:04.15,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:04.15,0:13:06.81,Default,,0000,0000,0000,,Кункункун….
Dialogue: 0,0:13:06.81,0:13:08.82,Default,,0000,0000,0000,,Не деген...?
Dialogue: 0,0:13:08.82,0:13:10.82,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:13:08.82,0:13:10.82,Default,,0000,0000,0000,,Томо-чан.
Dialogue: 0,0:13:10.82,0:13:12.82,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:13:10.82,0:13:12.82,Default,,0000,0000,0000,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:13:12.82,0:13:14.99,Default,,0000,0000,0000,,Бұл не? Тәттілер! ?
Dialogue: 0,0:13:14.99,0:13:17.83,Default,,0000,0000,0000,,Сата Андағи.
Dialogue: 0,0:13:17.83,0:13:21.50,Default,,0000,0000,0000,,Тәттілер! ?
Dialogue: 0,0:13:17.83,0:13:21.50,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:13:17.83,0:13:21.50,Default,,0000,0000,0000,,Томо-чанға сатып алу...
Dialogue: 0,0:13:21.50,0:13:24.00,Default,,0000,0000,0000,,Сата Андағи.
Dialogue: 0,0:13:24.00,0:13:26.67,Default,,0000,0000,0000,,Бұл қанша тұрады?
Dialogue: 0,0:13:24.00,0:13:26.67,Default,,0000,0000,0000,,Бұл 100 иен болды.
Dialogue: 0,0:13:26.67,0:13:28.67,Default,,0000,0000,0000,,Сата Андағи.
Dialogue: 0,0:13:28.67,0:13:31.51,Default,,0000,0000,0000,,Қайда сатуға болады...
Dialogue: 0,0:13:28.67,0:13:31.51,Default,,0000,0000,0000,,Сата Андағи.
Dialogue: 0,0:13:31.51,0:13:33.51,Default,,0000,0000,0000,,Бұл өте қатты!
Dialogue: 0,0:13:33.51,0:13:35.51,Default,,0000,0000,0000,,Сата Андағи.
Dialogue: 0,0:13:35.51,0:13:38.01,Default,,0000,0000,0000,,Сонымен!
Dialogue: 0,0:13:35.51,0:13:38.01,Default,,0000,0000,0000,,Сата Андағи.
Dialogue: 0,0:13:38.01,0:13:41.02,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:13:38.01,0:13:41.02,Default,,0000,0000,0000,,Иә? О, бұл...
Dialogue: 0,0:13:41.02,0:13:43.68,Default,,0000,0000,0000,,Сата Андай!
Dialogue: 0,0:13:43.68,0:13:45.69,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:13:45.69,0:13:54.36,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:13:54.36,0:13:56.56,Default,,0000,0000,0000,,Сакаки-сан!
Dialogue: 0,0:13:58.53,0:14:00.97,Default,,0000,0000,0000,,Қайырлы таң!
Dialogue: 0,0:13:58.53,0:14:00.97,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:14:00.97,0:14:03.97,Default,,0000,0000,0000,,Бүгінгі алыстағы аралдың жоспары
Dialogue: 0,0:14:00.97,0:14:03.97,Default,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:14:03.97,0:14:06.31,Default,,0000,0000,0000,,Біз Миякодзимамыз.
Dialogue: 0,0:14:06.31,0:14:09.31,Default,,0000,0000,0000,,Мен... Ириомот жабайы мысық.
Dialogue: 0,0:14:12.15,0:14:16.98,Default,,0000,0000,0000,,А... А, Ириомот аралы? Мен саған бар жақсылықты тілеймін.
Dialogue: 0,0:14:16.98,0:14:18.99,Default,,0000,0000,0000,,Мен қолымнан келгеннің бәрін жасаймын Ah...
Dialogue: 0,0:14:18.99,0:14:20.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:20.99,0:14:22.99,Default,,0000,0000,0000,,Сол футболка….
Dialogue: 0,0:14:22.99,0:14:25.99,Default,,0000,0000,0000,,А, мен оны сол жердегі дүкеннен сатып алдым.
Dialogue: 0,0:14:25.99,0:14:28.00,Default,,0000,0000,0000,,Жоқ, бұл...
Dialogue: 0,0:14:28.00,0:14:30.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:35.50,0:14:37.60,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:14:40.17,0:14:43.51,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:43.51,0:14:45.51,Default,,0000,0000,0000,,Мен киім ауыстырғалы жатырмын!
Dialogue: 0,0:14:47.51,0:14:49.52,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:14:49.52,0:14:51.52,Default,,0000,0000,0000,,Мияу.
Dialogue: 0,0:14:51.52,0:14:54.52,Default,,0000,0000,0000,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:14:57.36,0:15:00.29,Default,,0000,0000,0000,,Әй, көрдім, көрдім!
Dialogue: 0,0:15:00.29,0:15:03.96,Default,,0000,0000,0000,,Ал, тағы да тексеріп көрейік.
Dialogue: 0,0:15:00.29,0:15:03.96,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:03.96,0:15:09.97,Default,,0000,0000,0000,,Жақсы... Охара портынан серуендеу
Dialogue: 0,0:15:03.96,0:15:09.97,Default,,0000,0000,0000,,Жабайы табиғатты қорғау орталығына барыңыз ➡
Dialogue: 0,0:15:09.97,0:15:14.14,Default,,0000,0000,0000,,Айналыңыз
Dialogue: 0,0:15:09.97,0:15:14.14,Default,,0000,0000,0000,,Ураучи өзенінде серуендеу қайығына мініңіз➡
Dialogue: 0,0:15:14.14,0:15:16.48,Default,,0000,0000,0000,,Мариюду сарқырамасын қараңыз.
Dialogue: 0,0:15:16.48,0:15:19.98,Default,,0000,0000,0000,,Қалғандары
Dialogue: 0,0:15:16.48,0:15:19.98,Default,,0000,0000,0000,,Мен Уэхарадан кәдесый сатып алып, үйге барамын.
Dialogue: 0,0:15:19.98,0:15:24.32,Default,,0000,0000,0000,,Хмм, үйге қайтып бара жатқанда қайықты жіберіп алмас үшін➡
Dialogue: 0,0:15:24.32,0:15:27.15,Default,,0000,0000,0000,,Абайлаңыз.
Dialogue: 0,0:15:24.32,0:15:27.15,Default,,0000,0000,0000,,Ммм, дәмді екен.
Dialogue: 0,0:15:27.15,0:15:32.99,Default,,0000,0000,0000,,Уау~ Бұл арал.
Dialogue: 0,0:15:32.99,0:15:35.66,Default,,0000,0000,0000,,Тан! Ириомот!
Dialogue: 0,0:15:35.66,0:15:37.67,Default,,0000,0000,0000,,Суретке түсейік!
Dialogue: 0,0:15:37.67,0:15:39.67,Default,,0000,0000,0000,,Кезекпен отырайық!
Dialogue: 0,0:15:39.67,0:15:48.51,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:15:48.51,0:15:52.35,Default,,0000,0000,0000,,Жабайы мысық Жабайы мысық….
Dialogue: 0,0:15:52.35,0:15:56.35,Default,,0000,0000,0000,,Жабайы мысықтар болуы мүмкін!
Dialogue: 0,0:15:52.35,0:15:56.35,Default,,0000,0000,0000,,Баяу!
Dialogue: 0,0:15:56.35,0:15:59.35,Default,,0000,0000,0000,,Бар болуы мүмкін!
Dialogue: 0,0:15:56.35,0:15:59.35,Default,,0000,0000,0000,,О, керемет!
Dialogue: 0,0:15:59.35,0:16:02.96,Default,,0000,0000,0000,,Хона: Біз де баяулауымыз керек.
Dialogue: 0,0:16:02.96,0:16:04.96,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:16:02.96,0:16:04.96,Default,,0000,0000,0000,,Қажет емес.
Dialogue: 0,0:16:04.96,0:16:07.13,Default,,0000,0000,0000,,Ириомот мысық Мен оны көре аламын ба?
Dialogue: 0,0:16:07.13,0:16:09.63,Default,,0000,0000,0000,,Жоқ, бұл мүмкін емес еді.
Dialogue: 0,0:16:09.63,0:16:11.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:11.63,0:16:13.83,Default,,0000,0000,0000,,Көп нәрсені күтпеңіз.
Dialogue: 0,0:16:15.80,0:16:19.31,Default,,0000,0000,0000,,Не керек, қарсылас жабайы мысық.
Dialogue: 0,0:16:19.31,0:16:21.51,Default,,0000,0000,0000,,Бұл тегін болмауы мүмкін.
Dialogue: 0,0:16:23.64,0:16:27.15,Default,,0000,0000,0000,,Сүйкімді
Dialogue: 0,0:16:23.64,0:16:27.15,Default,,0000,0000,0000,,Жабайы мысықтардың тауарлары болса жақсы болар еді.
Dialogue: 0,0:16:27.15,0:16:30.65,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:27.15,0:16:30.65,Default,,0000,0000,0000,,Аа, мен оны неге көрмеймін?
Dialogue: 0,0:16:30.65,0:16:34.82,Default,,0000,0000,0000,,Бірақ егер бұл Сакаки болса, мен оған күшімді салар едім.
Dialogue: 0,0:16:30.65,0:16:34.82,Default,,0000,0000,0000,,Бұл ас үйден шығуы мүмкін.
Dialogue: 0,0:16:34.82,0:16:37.02,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:16:39.99,0:16:42.00,Default,,0000,0000,0000,,Мағынасыздық
Dialogue: 0,0:16:42.00,0:16:56.01,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:16:56.01,0:16:58.01,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:16:58.01,0:17:07.62,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:07.62,0:17:09.62,Default,,0000,0000,0000,,Ах... ха.
Dialogue: 0,0:17:09.62,0:17:17.30,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:17.30,0:17:19.60,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:17:22.80,0:17:26.81,Default,,0000,0000,0000,,Сакаки мырза Бұл жыланның шабуылына ұшыраған бақа.
Dialogue: 0,0:17:26.81,0:17:30.98,Default,,0000,0000,0000,,Иә, менің таңдауым жоқ. Кагура!
Dialogue: 0,0:17:26.81,0:17:30.98,Default,,0000,0000,0000,,О!
Dialogue: 0,0:17:30.98,0:17:32.98,Default,,0000,0000,0000,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:17:30.98,0:17:32.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:32.98,0:17:35.65,Default,,0000,0000,0000,,Жолбарыс тәрізді бұлдыр жүз!
Dialogue: 0,0:17:35.65,0:17:39.32,Default,,0000,0000,0000,,Қысқа аяқ және қалың құйрық!
Dialogue: 0,0:17:35.65,0:17:39.32,Default,,0000,0000,0000,,Денедегі дақты өрнек!
Dialogue: 0,0:17:39.32,0:17:41.99,Default,,0000,0000,0000,,Және дөңгелек құлақтар!
Dialogue: 0,0:17:41.99,0:17:44.09,Default,,0000,0000,0000,,Ямапикаря~!
Dialogue: 0,0:17:50.00,0:17:53.67,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:53.67,0:17:55.67,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:55.67,0:17:58.34,Default,,0000,0000,0000,,Ямапикаря?
Dialogue: 0,0:17:55.67,0:17:58.34,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:17:58.34,0:18:02.94,Default,,0000,0000,0000,,Ямапикарья дегеніміз не? Бұл сөз Ириомот жабайы мысығына қатысты!
Dialogue: 0,0:18:02.94,0:18:05.61,Default,,0000,0000,0000,,Ямапикаря?
Dialogue: 0,0:18:02.94,0:18:05.61,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:02.94,0:18:05.61,Default,,0000,0000,0000,,өтіңіз.
Dialogue: 0,0:18:05.61,0:18:07.61,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:05.61,0:18:07.61,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:09.62,0:18:12.45,Default,,0000,0000,0000,,Уау! Мен Сакаки-санға байланып қалдым!
Dialogue: 0,0:18:12.45,0:18:14.45,Default,,0000,0000,0000,,О.
Dialogue: 0,0:18:16.46,0:18:20.13,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:18:20.13,0:18:22.33,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:18:26.63,0:18:28.64,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:18:28.64,0:18:38.15,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:18:38.15,0:18:40.35,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:18:43.32,0:18:45.82,Default,,0000,0000,0000,,Хаха, сен мені сипап аласың!
Dialogue: 0,0:18:45.82,0:18:48.49,Default,,0000,0000,0000,,Жарайды, Сакаки-чан, жүр!
Dialogue: 0,0:18:48.49,0:18:50.66,Default,,0000,0000,0000,,Мені алып кет! Ауызыңды жап!
Dialogue: 0,0:18:50.66,0:18:52.66,Default,,0000,0000,0000,,Гю~!
Dialogue: 0,0:18:55.66,0:18:58.00,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:18:58.00,0:19:01.94,Default,,0000,0000,0000,,Камado Танжиро.
Dialogue: 0,0:18:58.00,0:19:01.94,Default,,0000,0000,0000,,Сен әлі баласың!
Dialogue: 0,0:19:01.94,0:19:05.11,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:19:05.11,0:19:07.94,Default,,0000,0000,0000,,Ямамая….
Dialogue: 0,0:19:07.94,0:19:09.94,Default,,0000,0000,0000,,Яма Майя!
Dialogue: 0,0:19:09.94,0:19:12.45,Default,,0000,0000,0000,,Ямамая жабайы мысық дегенді де білдіреді!
Dialogue: 0,0:19:12.45,0:19:15.95,Default,,0000,0000,0000,,Иә, иә!
Dialogue: 0,0:19:15.95,0:19:18.45,Default,,0000,0000,0000,,Ямапикарья.
Dialogue: 0,0:19:18.45,0:19:21.12,Default,,0000,0000,0000,,Ямапикарья.
Dialogue: 0,0:19:21.12,0:19:24.46,Default,,0000,0000,0000,,Бұл бала есейгенде
Dialogue: 0,0:19:21.12,0:19:24.46,Default,,0000,0000,0000,,Міне осылай болады!
Dialogue: 0,0:19:24.46,0:19:27.13,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:24.46,0:19:27.13,Default,,0000,0000,0000,,Сосын солай болады.
Dialogue: 0,0:19:27.13,0:19:30.30,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:30.30,0:19:33.80,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:30.30,0:19:33.80,Default,,0000,0000,0000,,Қандай керемет сүйек.
Dialogue: 0,0:19:36.80,0:19:39.64,Default,,0000,0000,0000,,А, жылан жүзіп келе жатыр.
Dialogue: 0,0:19:36.80,0:19:39.64,Default,,0000,0000,0000,,Қайда! ?
Dialogue: 0,0:19:39.64,0:19:47.65,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:47.65,0:19:49.82,Default,,0000,0000,0000,,Дааааааааааааааааааааааааааааа!
Dialogue: 0,0:19:49.82,0:19:52.82,Default,,0000,0000,0000,,Банзай Банзай Банзай!
Dialogue: 0,0:19:52.82,0:20:00.83,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:00.83,0:20:02.83,Default,,0000,0000,0000,,(толқынды дыбыс)
Dialogue: 0,0:20:09.17,0:20:11.67,Default,,0000,0000,0000,,(Жел дыбысы)
Dialogue: 0,0:20:11.67,0:20:13.67,Default,,0000,0000,0000,,Қош бол...
Dialogue: 0,0:20:13.67,0:20:16.34,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:20:13.67,0:20:16.34,Default,,0000,0000,0000,,Мені үйге апармау керек...
Dialogue: 0,0:20:16.34,0:20:19.01,Default,,0000,0000,0000,,Үйде мысық ұстай алмаймыз➡
Dialogue: 0,0:20:19.01,0:20:24.35,Default,,0000,0000,0000,,Не керек, сен ерекше табиғат ескерткішісің.
Dialogue: 0,0:20:24.35,0:20:26.35,Default,,0000,0000,0000,,Менің артымнан ерме.
Dialogue: 0,0:20:26.35,0:20:30.02,Default,,0000,0000,0000,,Сакаки мырза….
Dialogue: 0,0:20:30.02,0:20:32.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:30.02,0:20:32.12,Default,,0000,0000,0000,,(шу)
Dialogue: 0,0:20:36.03,0:20:38.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:20:38.03,0:20:40.03,Default,,0000,0000,0000,,Ана?
Dialogue: 0,0:20:40.03,0:20:42.04,Default,,0000,0000,0000,,(Жел дыбысы)
Dialogue: 0,0:20:42.04,0:21:16.84,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:16.84,0:21:20.14,Default,,0000,0000,0000,,Иә? Әуежайдағы кәдесыйлар...
Dialogue: 0,0:21:29.35,0:21:31.35,Default,,0000,0000,0000,,Куркума шайы!
Dialogue: 0,0:21:31.35,0:21:33.35,Default,,0000,0000,0000,,Куркума шайы! Куркума шай!
Dialogue: 0,0:21:33.35,0:21:35.86,Default,,0000,0000,0000,,Куркума шайы!
Dialogue: 0,0:21:33.35,0:21:35.86,Default,,0000,0000,0000,,Куркума шайы Куркума шайы Куркума шайы Куркума шайы….
Dialogue: 0,0:21:35.86,0:21:38.19,Default,,0000,0000,0000,,Куркума шайы~!
Dialogue: 0,0:21:35.86,0:21:38.19,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:21:38.19,0:21:40.36,Default,,0000,0000,0000,,Окинава көңілді болды!
Dialogue: 0,0:21:40.36,0:21:42.36,Default,,0000,0000,0000,,Көңілді болды.
Dialogue: 0,0:21:42.36,0:21:44.70,Default,,0000,0000,0000,,Сакаки мырза.
Dialogue: 0,0:21:42.36,0:21:44.70,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:44.70,0:21:46.70,Default,,0000,0000,0000,,Мен тағы да келгім келеді.
Dialogue: 0,0:21:48.70,0:21:50.70,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:50.70,0:21:53.20,Default,,0000,0000,0000,,Тағы келейік...
Dialogue: 0,0:21:54.70,0:22:00.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory