Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.02,0:01:34.02,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:34.02,0:01:36.02,Default,,0000,0000,0000,,Мияу~.
Dialogue: 0,0:01:36.02,0:01:39.86,Default,,0000,0000,0000,,Майк!
Dialogue: 0,0:01:36.02,0:01:39.86,Default,,0000,0000,0000,,Мя~.
Dialogue: 0,0:01:39.86,0:01:42.20,Default,,0000,0000,0000,,Жақсы... Жақсы...
Dialogue: 0,0:01:42.20,0:01:44.20,Default,,0000,0000,0000,,Мияу.
Dialogue: 0,0:01:42.20,0:01:44.20,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:01:44.20,0:01:47.37,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:47.37,0:01:49.37,Default,,0000,0000,0000,,Бұл қызықты болды ма?
Dialogue: 0,0:01:49.37,0:01:51.37,Default,,0000,0000,0000,,Иә, мен аздап жыладым.
Dialogue: 0,0:01:51.37,0:01:54.38,Default,,0000,0000,0000,,Сәлем, анашым.
Dialogue: 0,0:01:51.37,0:01:54.38,Default,,0000,0000,0000,,Оны ұмытып қалдың ба?
Dialogue: 0,0:01:54.38,0:01:57.38,Default,,0000,0000,0000,,Артынан қарап тұрдым.
Dialogue: 0,0:01:54.38,0:01:57.38,Default,,0000,0000,0000,,Үлкен әпке де➡
Dialogue: 0,0:01:57.38,0:01:59.38,Default,,0000,0000,0000,,Мен қатты жыладым.
Dialogue: 0,0:01:59.38,0:02:01.32,Default,,0000,0000,0000,,Үлкен әпке?
Dialogue: 0,0:02:01.32,0:02:05.65,Default,,0000,0000,0000,,(жылау)
Dialogue: 0,0:02:05.65,0:02:18.83,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:18.83,0:02:20.84,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:02:20.84,0:02:24.67,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,0:02:24.67,0:02:26.67,Default,,0000,0000,0000,,Мысық….
Dialogue: 0,0:02:26.67,0:02:32.35,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:32.35,0:02:36.18,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:02:41.02,0:02:43.69,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:02:41.02,0:02:43.69,Default,,0000,0000,0000,,Кя~! Сондай сүйкімді!
Dialogue: 0,0:02:43.69,0:02:46.03,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:02:43.69,0:02:46.03,Default,,0000,0000,0000,,Ал мына бала➡
Dialogue: 0,0:02:46.03,0:02:49.03,Default,,0000,0000,0000,,Шар жіппен ойнау
Dialogue: 0,0:02:46.03,0:02:49.03,Default,,0000,0000,0000,,Бұл тағы да сүйкімді!
Dialogue: 0,0:02:49.03,0:02:51.53,Default,,0000,0000,0000,,Бұл өте сүйкімді!
Dialogue: 0,0:02:51.53,0:02:55.70,Default,,0000,0000,0000,,Үлпілдек
Dialogue: 0,0:02:51.53,0:02:55.70,Default,,0000,0000,0000,,Екі шаш шары бар сияқты.
Dialogue: 0,0:02:55.70,0:02:58.87,Default,,0000,0000,0000,,Шынымен~
Dialogue: 0,0:02:55.70,0:02:58.87,Default,,0000,0000,0000,,Ұйқыларыңыз жайлы болсын!
Dialogue: 0,0:02:58.87,0:03:01.48,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:02:58.87,0:03:01.48,Default,,0000,0000,0000,,Сакаки-санға да қараңызшы!
Dialogue: 0,0:03:01.48,0:03:03.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:03.48,0:03:06.82,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:03:03.48,0:03:06.82,Default,,0000,0000,0000,,Менің мысығым бала туды!
Dialogue: 0,0:03:11.82,0:03:14.02,Default,,0000,0000,0000,,Ухуху.
Dialogue: 0,0:03:16.16,0:03:19.99,Default,,0000,0000,0000,,Қайта басып шығаруға тапсырысты артқы жағына жазуым керек пе?
Dialogue: 0,0:03:19.99,0:03:23.16,Default,,0000,0000,0000,,Е, Сакаки-сан, сен де мысықтарды жақсы көресің бе?
Dialogue: 0,0:03:23.16,0:03:26.17,Default,,0000,0000,0000,,Иә, аздап...
Dialogue: 0,0:03:26.17,0:03:28.67,Default,,0000,0000,0000,,Сонымен, сіз оны үйде сақтайсыз ба?
Dialogue: 0,0:03:28.67,0:03:32.17,Default,,0000,0000,0000,,Жоқ, біз мысықтарды ата-ана ретінде асырай алмаймыз.
Dialogue: 0,0:03:32.17,0:03:35.57,Default,,0000,0000,0000,,Солай ма? Бұл ұят...
Dialogue: 0,0:03:38.01,0:03:40.01,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:03:40.01,0:03:52.86,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:03:52.86,0:03:56.20,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:03:56.20,0:03:58.20,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:58.20,0:04:08.14,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:04:08.14,0:04:11.84,Default,,0000,0000,0000,,(Ысырма дыбысы)
Dialogue: 0,0:04:14.98,0:04:17.08,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:04:21.66,0:04:24.06,Default,,0000,0000,0000,,Бұл жақсы ма?
Dialogue: 0,0:04:25.99,0:04:28.00,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:04:28.00,0:04:30.50,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:04:30.50,0:04:33.84,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:04:33.84,0:04:35.84,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:35.84,0:04:38.84,Default,,0000,0000,0000,,О... ой….
Dialogue: 0,0:04:38.84,0:04:40.84,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:40.84,0:04:44.18,Default,,0000,0000,0000,,О… ой….
Dialogue: 0,0:04:44.18,0:04:46.68,Default,,0000,0000,0000,,Ой! о….
Dialogue: 0,0:04:46.68,0:04:50.35,Default,,0000,0000,0000,,Ах... ой... а...
Dialogue: 0,0:04:50.35,0:04:53.02,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:53.02,0:04:55.02,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:55.02,0:04:59.86,Default,,0000,0000,0000,,Бағана. ➡
Dialogue: 0,0:04:59.86,0:05:01.86,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:05:03.80,0:05:06.80,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:05:03.80,0:05:06.80,Default,,0000,0000,0000,,Ха! Уф….
Dialogue: 0,0:05:06.80,0:05:09.97,Default,,0000,0000,0000,,Чио-чан.
Dialogue: 0,0:05:06.80,0:05:09.97,Default,,0000,0000,0000,,Әй, Сакаки-сан!
Dialogue: 0,0:05:09.97,0:05:11.97,Default,,0000,0000,0000,,Бұған не болды?
Dialogue: 0,0:05:11.97,0:05:15.98,Default,,0000,0000,0000,,Мен сауда көшесінде лотерея ұтып алдым.
Dialogue: 0,0:05:15.98,0:05:17.98,Default,,0000,0000,0000,,Сәл күте тұрыңыз.
Dialogue: 0,0:05:17.98,0:05:21.82,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:05:21.82,0:05:23.82,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:26.65,0:05:29.99,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:05:26.65,0:05:29.99,Default,,0000,0000,0000,,Маған рұқсат етіңіз.
Dialogue: 0,0:05:29.99,0:05:32.99,Default,,0000,0000,0000,,Жоқ, бәрі жақсы...
Dialogue: 0,0:05:35.00,0:05:39.00,Default,,0000,0000,0000,,Қайырлы таң!
Dialogue: 0,0:05:39.00,0:05:41.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:39.00,0:05:41.00,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:05:41.00,0:05:43.00,Default,,0000,0000,0000,,Сіз осылай істедіңіз бе?
Dialogue: 0,0:05:43.00,0:05:45.51,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:05:45.51,0:05:47.68,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:05:45.51,0:05:47.68,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:05:47.68,0:05:50.68,Default,,0000,0000,0000,,Қайырлы таң, Сакаки-сан.
Dialogue: 0,0:05:50.68,0:05:52.85,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:05:50.68,0:05:52.85,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:05:52.85,0:05:56.02,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:05:52.85,0:05:56.02,Default,,0000,0000,0000,,Көңілді сияқты.
Dialogue: 0,0:05:56.02,0:05:59.02,Default,,0000,0000,0000,,О
Dialogue: 0,0:05:56.02,0:05:59.02,Default,,0000,0000,0000,,Мен Чио-чан туралы айттым.
Dialogue: 0,0:05:59.02,0:06:01.29,Default,,0000,0000,0000,,Жақында сіздің туған күніңіз.
Dialogue: 0,0:06:01.29,0:06:03.63,Default,,0000,0000,0000,,Туған күн?
Dialogue: 0,0:06:03.63,0:06:06.79,Default,,0000,0000,0000,,Иә! Бұл жексенбі.
Dialogue: 0,0:06:06.79,0:06:09.63,Default,,0000,0000,0000,,Мен қазірдің өзінде 11 жастамын.
Dialogue: 0,0:06:09.63,0:06:12.80,Default,,0000,0000,0000,,Ол кішкентай әпке болады!
Dialogue: 0,0:06:12.80,0:06:14.80,Default,,0000,0000,0000,,11 жас….
Dialogue: 0,0:06:14.80,0:06:17.80,Default,,0000,0000,0000,,Бірақ Чио Чан?
Dialogue: 0,0:06:14.80,0:06:17.80,Default,,0000,0000,0000,,Сіз әлдеқайда жас көрінесіз.
Dialogue: 0,0:06:19.97,0:06:21.98,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:21.98,0:06:28.65,Default,,0000,0000,0000,,Бастауыш сыныпта да бой ретімен сапқа тұрғанда,
Dialogue: 0,0:06:21.98,0:06:28.65,Default,,0000,0000,0000,,Ол әрқашан майданда болды...
Dialogue: 0,0:06:28.65,0:06:30.65,Default,,0000,0000,0000,,Сакаки мырза!
Dialogue: 0,0:06:28.65,0:06:30.65,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:06:30.65,0:06:33.99,Default,,0000,0000,0000,,Сакаки мырза неге танымал?
Dialogue: 0,0:06:30.65,0:06:33.99,Default,,0000,0000,0000,,Бойыңыз ұзын ба?
Dialogue: 0,0:06:33.99,0:06:36.16,Default,,0000,0000,0000,,Келіңіздер...
Dialogue: 0,0:06:36.16,0:06:38.86,Default,,0000,0000,0000,,Менің де бойым биік болса екен.
Dialogue: 0,0:06:40.83,0:06:43.67,Default,,0000,0000,0000,,Кіші
Dialogue: 0,0:06:40.83,0:06:43.67,Default,,0000,0000,0000,,Бұл сүйкімді...
Dialogue: 0,0:06:43.67,0:06:48.17,Default,,0000,0000,0000,,Иә, бірақ баға соғұрлым жоғары болады
Dialogue: 0,0:06:43.67,0:06:48.17,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:06:48.17,0:06:50.17,Default,,0000,0000,0000,,Керемет пе?
Dialogue: 0,0:06:50.17,0:06:53.17,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:06:53.17,0:06:56.18,Default,,0000,0000,0000,,Хэхехе!
Dialogue: 0,0:06:56.18,0:06:58.68,Default,,0000,0000,0000,,Керемет емес
Dialogue: 0,0:06:56.18,0:06:58.68,Default,,0000,0000,0000,,Ең сүйкімдісі...
Dialogue: 0,0:06:58.68,0:07:01.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:58.68,0:07:01.62,Default,,0000,0000,0000,,Бұл….
Dialogue: 0,0:07:01.62,0:07:03.82,Default,,0000,0000,0000,,Күшті.
Dialogue: 0,0:07:06.45,0:07:08.46,Default,,0000,0000,0000,,Күшті?
Dialogue: 0,0:07:08.46,0:07:12.29,Default,,0000,0000,0000,,Айтпақшы, Сакаки мырза?
Dialogue: 0,0:07:08.46,0:07:12.29,Default,,0000,0000,0000,,Бойыңыз әлі өсіп жатыр ма?
Dialogue: 0,0:07:12.29,0:07:14.30,Default,,0000,0000,0000,,сияқты.
Dialogue: 0,0:07:12.29,0:07:14.30,Default,,0000,0000,0000,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:07:14.30,0:07:16.63,Default,,0000,0000,0000,,Бұл көктемдегіден үлкенірек!
Dialogue: 0,0:07:16.63,0:07:19.30,Default,,0000,0000,0000,,170-тен жоғары?
Dialogue: 0,0:07:16.63,0:07:19.30,Default,,0000,0000,0000,,асып кетті.
Dialogue: 0,0:07:19.30,0:07:22.47,Default,,0000,0000,0000,,О!
Dialogue: 0,0:07:22.47,0:07:24.97,Default,,0000,0000,0000,,Чиёчан!
Dialogue: 0,0:07:26.97,0:07:30.47,Default,,0000,0000,0000,,Сакаки-сан мені сіңіріп жатқандай сезінемін!
Dialogue: 0,0:07:33.48,0:07:35.48,Default,,0000,0000,0000,,Сакаки мырза.
Dialogue: 0,0:07:33.48,0:07:35.48,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:07:35.48,0:07:38.32,Default,,0000,0000,0000,,Менің бойымды алдың ба?
Dialogue: 0,0:07:38.32,0:07:40.66,Default,,0000,0000,0000,,А... жоқ...
Dialogue: 0,0:07:40.66,0:07:44.16,Default,,0000,0000,0000,,Сіз оны алдыңыз, солай ма?
Dialogue: 0,0:07:40.66,0:07:44.16,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:44.16,0:07:47.66,Default,,0000,0000,0000,,Сіз оны алдыңыз, солай ма?
Dialogue: 0,0:07:44.16,0:07:47.66,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:07:47.66,0:07:51.00,Default,,0000,0000,0000,,Сіз оны алдыңыз, солай ма?
Dialogue: 0,0:07:47.66,0:07:51.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:51.00,0:07:55.34,Default,,0000,0000,0000,,Сіз оны алдыңыз.
Dialogue: 0,0:07:51.00,0:07:55.34,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:55.34,0:07:57.67,Default,,0000,0000,0000,,Түсіндіңіз!
Dialogue: 0,0:07:57.67,0:08:00.78,Default,,0000,0000,0000,,Жоқ, а...
Dialogue: 0,0:08:00.78,0:08:02.78,Default,,0000,0000,0000,,Қайтарыңыз!
Dialogue: 0,0:08:00.78,0:08:02.78,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:08:02.78,0:08:04.78,Default,,0000,0000,0000,,Мектеп формасы ма? Тамаша! Қызық!
Dialogue: 0,0:08:02.78,0:08:04.78,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:08:04.78,0:08:07.78,Default,,0000,0000,0000,,Қайтарыңыз! Қайтарыңыз!
Dialogue: 0,0:08:04.78,0:08:07.78,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:08:07.78,0:08:11.12,Default,,0000,0000,0000,,Қайтарыңыз! Қайтарыңыз!
Dialogue: 0,0:08:07.78,0:08:11.12,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:11.12,0:08:13.96,Default,,0000,0000,0000,,Мектеп формасы ма? Тамаша! Қызық!
Dialogue: 0,0:08:11.12,0:08:13.96,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:08:13.96,0:08:15.96,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:08:13.96,0:08:15.96,Default,,0000,0000,0000,,Қайтарыңыз!
Dialogue: 0,0:08:15.96,0:08:18.96,Default,,0000,0000,0000,,О~ Сакаки-сан, мен қиналдым, қиналып қалдым.
Dialogue: 0,0:08:18.96,0:08:20.96,Default,,0000,0000,0000,,Бұлай етпе, Чио-чан.
Dialogue: 0,0:08:20.96,0:08:24.30,Default,,0000,0000,0000,,11 жастағы бала күткендей.
Dialogue: 0,0:08:24.30,0:08:26.80,Default,,0000,0000,0000,,Сәлем Чиё Чан.
Dialogue: 0,0:08:24.30,0:08:26.80,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:26.80,0:08:30.64,Default,,0000,0000,0000,,Осы жексенбіде біз Качио-чанның туған күнін өткіземіз.
Dialogue: 0,0:08:30.64,0:08:33.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:30.64,0:08:33.98,Default,,0000,0000,0000,,Чио-чан Чини
Dialogue: 0,0:08:30.64,0:08:33.98,Default,,0000,0000,0000,,Барлығымыз жиналайық.
Dialogue: 0,0:08:33.98,0:08:36.14,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:33.98,0:08:36.14,Default,,0000,0000,0000,,Мен міндім!
Dialogue: 0,0:08:36.14,0:08:38.65,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:08:38.65,0:08:40.65,Default,,0000,0000,0000,,Барыңыз.
Dialogue: 0,0:08:40.65,0:08:43.82,Default,,0000,0000,0000,,Шынымен! Мен сондай қуаныштымын!
Dialogue: 0,0:08:43.82,0:08:46.49,Default,,0000,0000,0000,,Ешқандай сыйлық дайындамаңыз.
Dialogue: 0,0:08:46.49,0:08:50.16,Default,,0000,0000,0000,,О! Ойланып көрейікші
Dialogue: 0,0:08:46.49,0:08:50.16,Default,,0000,0000,0000,,Өткен жылы не алдыңыз?
Dialogue: 0,0:08:50.16,0:08:52.83,Default,,0000,0000,0000,,Иә, мен лента алдым.
Dialogue: 0,0:08:52.83,0:08:55.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:09:00.43,0:09:02.53,Default,,0000,0000,0000,,《Таспа…》
Dialogue: 0,0:09:05.61,0:09:08.78,Default,,0000,0000,0000,,Эххе
Dialogue: 0,0:09:08.78,0:09:10.78,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:09:14.28,0:09:16.95,Default,,0000,0000,0000,,Сакаки мырза, не болды?
Dialogue: 0,0:09:16.95,0:09:19.45,Default,,0000,0000,0000,,Жоқ, жоқ….
Dialogue: 0,0:09:25.79,0:09:28.49,Default,,0000,0000,0000,,Мен осы құдай таңдаған ессіз ғалыммын…
Dialogue: 0,0:09:31.30,0:09:33.60,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:09:38.81,0:09:40.81,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:09:40.81,0:09:46.98,Default,,0000,0000,0000,,Қашып шығу үшін
Dialogue: 0,0:09:46.98,0:10:24.35,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:10:24.35,0:10:27.19,Default,,0000,0000,0000,,(Мысықтың мияулауы)
Dialogue: 0,0:10:27.19,0:10:29.39,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:10:31.53,0:10:36.03,Default,,0000,0000,0000,,Уау! Ухуху
Dialogue: 0,0:10:36.03,0:10:39.03,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:10:39.03,0:10:41.04,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:10:41.04,0:10:44.04,Default,,0000,0000,0000,,Уау, сондай сүйкімді!
Dialogue: 0,0:10:48.04,0:10:51.21,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:48.04,0:10:51.21,Default,,0000,0000,0000,,Иә, ол 1500 иен болады.
Dialogue: 0,0:10:51.21,0:10:53.71,Default,,0000,0000,0000,,(касса дыбысы)
Dialogue: 0,0:10:59.05,0:11:01.49,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:10:59.05,0:11:01.49,Default,,0000,0000,0000,,(Мысықтың мияулауы)
Dialogue: 0,0:11:01.49,0:11:03.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:01.49,0:11:03.99,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:11:03.99,0:11:06.49,Default,,0000,0000,0000,,Бұл қызық!
Dialogue: 0,0:11:03.99,0:11:06.49,Default,,0000,0000,0000,,(айқай)
Dialogue: 0,0:11:06.49,0:11:08.50,Default,,0000,0000,0000,,Эй, сатып ал!
Dialogue: 0,0:11:06.49,0:11:08.50,Default,,0000,0000,0000,,(айқай)
Dialogue: 0,0:11:08.50,0:11:15.34,Default,,0000,0000,0000,,(айқай)
Dialogue: 0,0:11:15.34,0:11:17.64,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:15.34,0:11:17.64,Default,,0000,0000,0000,,(Біртүрлі жылау)
Dialogue: 0,0:11:20.34,0:11:23.14,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:25.68,0:11:27.68,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:11:31.52,0:11:44.20,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:11:44.20,0:11:46.20,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:11:46.20,0:11:54.71,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:11:54.71,0:11:56.71,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:11:56.71,0:12:07.82,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:07.82,0:12:09.82,Default,,0000,0000,0000,,Га.
Dialogue: 0,0:12:09.82,0:12:12.32,Default,,0000,0000,0000,,Мен оны сатып алдым.
Dialogue: 0,0:12:09.82,0:12:12.32,Default,,0000,0000,0000,,Қазір ғана құмар көздеріңмен мені шолып тұрдың ғой, иә?
Dialogue: 0,0:12:16.66,0:12:18.86,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:12:25.84,0:12:28.14,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:12:32.85,0:12:42.35,Default,,0000,0000,0000,,(НЛО ұстаушы дыбыс)
Dialogue: 0,0:12:47.36,0:12:50.53,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:50.53,0:12:52.53,Default,,0000,0000,0000,,(ақшаны салу дыбысы)
Dialogue: 0,0:12:52.53,0:13:04.98,Default,,0000,0000,0000,,(Ойын дыбысы)
Dialogue: 0,0:13:04.98,0:13:07.08,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:13.65,0:13:33.65,Default,,0000,0000,0000,,(Ойын дыбысы)
Dialogue: 0,0:13:39.18,0:13:41.38,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:13:45.02,0:13:48.02,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:13:45.02,0:13:48.02,Default,,0000,0000,0000,,(домофон)
Dialogue: 0,0:13:48.02,0:13:50.36,Default,,0000,0000,0000,,(Аня) Кешкі асқа не бермек екен? (Іштің күркіреген дыбысы)
Dialogue: 0,0:13:50.36,0:13:52.36,Default,,0000,0000,0000,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:13:52.36,0:13:54.70,Default,,0000,0000,0000,,Туған күнің құтты болсын!
Dialogue: 0,0:13:54.70,0:13:56.70,Default,,0000,0000,0000,,Құттықтаймыз!
Dialogue: 0,0:13:56.70,0:13:58.87,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:13:56.70,0:13:58.87,Default,,0000,0000,0000,,Мен саған сыйлық әкелдім.
Dialogue: 0,0:13:58.87,0:14:01.80,Default,,0000,0000,0000,,Ха! рақмет сізге!
Dialogue: 0,0:14:01.80,0:14:04.31,Default,,0000,0000,0000,,Қалай болғанда да, бөлмеңе бар.
Dialogue: 0,0:14:04.31,0:14:07.51,Default,,0000,0000,0000,,Не? Сакаки ше?
Dialogue: 0,0:14:13.31,0:14:16.82,Default,,0000,0000,0000,,Сакаки мырза Сакаки мырза!
Dialogue: 0,0:14:13.31,0:14:16.82,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:16.82,0:14:21.32,Default,,0000,0000,0000,,Енді бұдан былай
Dialogue: 0,0:14:16.82,0:14:21.32,Default,,0000,0000,0000,,Үлкен сыйлық байқауының басы!
Dialogue: 0,0:14:21.32,0:14:23.32,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:14:23.32,0:14:25.33,Default,,0000,0000,0000,,Ең жақсы қамыр - менмін!
Dialogue: 0,0:14:25.33,0:14:29.03,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:14:25.33,0:14:29.03,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:14:33.33,0:14:35.34,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:14:35.34,0:14:37.84,Default,,0000,0000,0000,,Менің сезімдерім!
Dialogue: 0,0:14:37.84,0:14:39.84,Default,,0000,0000,0000,,Иә? Бұл танымал емес пе?
Dialogue: 0,0:14:39.84,0:14:43.18,Default,,0000,0000,0000,,Не, сәтсіздік пе?
Dialogue: 0,0:14:39.84,0:14:43.18,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:14:43.18,0:14:46.35,Default,,0000,0000,0000,,Иә, бұл нағыз сыйлық!
Dialogue: 0,0:14:46.35,0:14:49.85,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:14:46.35,0:14:49.85,Default,,0000,0000,0000,,Сиқырлы таяқша!
Dialogue: 0,0:14:49.85,0:14:53.35,Default,,0000,0000,0000,,Бұны пайдалансаң, Чио-чан да
Dialogue: 0,0:14:49.85,0:14:53.35,Default,,0000,0000,0000,,Сіз өсе аласыз!
Dialogue: 0,0:14:53.35,0:14:56.86,Default,,0000,0000,0000,,Мен қазірдің өзінде
Dialogue: 0,0:14:53.35,0:14:56.86,Default,,0000,0000,0000,,Мен бұған сенетін жаста емеспін.
Dialogue: 0,0:14:56.86,0:14:58.86,Default,,0000,0000,0000,,Жарайды. Жарайды.
Dialogue: 0,0:14:58.86,0:15:01.13,Default,,0000,0000,0000,,Иә, бұл менің тарапымнан.
Dialogue: 0,0:15:01.13,0:15:04.13,Default,,0000,0000,0000,,Сізге көп рахмет!
Dialogue: 0,0:15:04.13,0:15:06.13,Default,,0000,0000,0000,,Мен мұны істеймін.
Dialogue: 0,0:15:06.13,0:15:09.14,Default,,0000,0000,0000,,Сакаки
Dialogue: 0,0:15:06.13,0:15:09.14,Default,,0000,0000,0000,,Бұл толтырылған мысық па?
Dialogue: 0,0:15:09.14,0:15:11.31,Default,,0000,0000,0000,,Уау, сондай сүйкімді!
Dialogue: 0,0:15:11.31,0:15:13.31,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:15:13.31,0:15:16.81,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:15:13.31,0:15:16.81,Default,,0000,0000,0000,,Оны қалай атау керек?
Dialogue: 0,0:15:16.81,0:15:20.81,Default,,0000,0000,0000,,Монпетит.
Dialogue: 0,0:15:16.81,0:15:20.81,Default,,0000,0000,0000,,А, оның аты бар.
Dialogue: 0,0:15:20.81,0:15:22.82,Default,,0000,0000,0000,,Мен оны бағалаймын!
Dialogue: 0,0:15:22.82,0:15:24.82,Default,,0000,0000,0000,,Мені еркелетіңізші.
Dialogue: 0,0:15:24.82,0:15:26.82,Default,,0000,0000,0000,,Бірақ бұл таң қалдырады.
Dialogue: 0,0:15:26.82,0:15:30.66,Default,,0000,0000,0000,,Сакаки-сан да тұлыпқа айналады
Dialogue: 0,0:15:26.82,0:15:30.66,Default,,0000,0000,0000,,Сіз оған ат беріңіз.
Dialogue: 0,0:15:30.66,0:15:33.33,Default,,0000,0000,0000,,Танысқаныма қуаныштымын, Монпетит.
Dialogue: 0,0:15:33.33,0:15:35.33,Default,,0000,0000,0000,,Монпетит...
Dialogue: 0,0:15:33.33,0:15:35.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:35.33,0:15:37.50,Default,,0000,0000,0000,,Монпетит менің сіңілім.
Dialogue: 0,0:15:37.50,0:15:40.17,Default,,0000,0000,0000,,Жоғарыда үлкен әпке бар.
Dialogue: 0,0:15:40.17,0:15:42.17,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:42.17,0:15:44.17,Default,,0000,0000,0000,,Аты Утатарана➡
Dialogue: 0,0:15:44.17,0:15:48.68,Default,,0000,0000,0000,,Ат жарысының көптеген сүйкімді атаулары бар екенін білдім.
Dialogue: 0,0:15:48.68,0:15:51.68,Default,,0000,0000,0000,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:15:48.68,0:15:51.68,Default,,0000,0000,0000,,Ал, ➡
Dialogue: 0,0:15:51.68,0:15:57.18,Default,,0000,0000,0000,,Мен Кацухиме ханшайымына сенімдімін.
Dialogue: 0,0:15:51.68,0:15:57.18,Default,,0000,0000,0000,,Сіз Эсприма Комаконы ойнадыңыз ба?
Dialogue: 0,0:15:57.18,0:15:59.19,Default,,0000,0000,0000,,Бұл өлімнен кейінгі әлем емес.
Dialogue: 0,0:15:57.18,0:15:59.19,Default,,0000,0000,0000,,Бала да➡
Dialogue: 0,0:15:59.19,0:16:01.59,Default,,0000,0000,0000,,Мұндай атау туралы не деуге болады?
Dialogue: 0,0:16:03.46,0:16:05.79,Default,,0000,0000,0000,,№.
Dialogue: 0,0:16:03.46,0:16:05.79,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:16:05.79,0:16:08.80,Default,,0000,0000,0000,,№.
Dialogue: 0,0:16:05.79,0:16:08.80,Default,,0000,0000,0000,,А... жақсы, иә.
Dialogue: 0,0:16:08.80,0:16:11.13,Default,,0000,0000,0000,,Менікі де тұлып.
Dialogue: 0,0:16:11.13,0:16:13.13,Default,,0000,0000,0000,,Иә, өтінемін.
Dialogue: 0,0:16:13.13,0:16:15.80,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:16:15.80,0:16:17.81,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:16:17.81,0:16:19.81,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:16:19.81,0:16:22.48,Default,,0000,0000,0000,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:16:19.81,0:16:22.48,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:16:22.48,0:16:24.48,Default,,0000,0000,0000,,Әке….
Dialogue: 0,0:16:24.48,0:16:28.15,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:16:28.15,0:16:31.15,Default,,0000,0000,0000,,Бұл менің әкем.
Dialogue: 0,0:16:31.15,0:16:33.49,Default,,0000,0000,0000,,Бұл баланыкі ме?
Dialogue: 0,0:16:33.49,0:16:36.32,Default,,0000,0000,0000,,Чио-чандікі.
Dialogue: 0,0:16:33.49,0:16:36.32,Default,,0000,0000,0000,,Менікі ме?
Dialogue: 0,0:16:36.32,0:16:40.49,Default,,0000,0000,0000,,Хмф! Қалай болғанда да, менің сыйлығым
Dialogue: 0,0:16:36.32,0:16:40.49,Default,,0000,0000,0000,,Мен бұған риза болмадым➡
Dialogue: 0,0:16:40.49,0:16:42.83,Default,,0000,0000,0000,,Бұл туралы тіпті айтылмаған да!
Dialogue: 0,0:16:42.83,0:16:45.67,Default,,0000,0000,0000,,Ах! Чиё-чан Чио-чан.
Dialogue: 0,0:16:45.67,0:16:47.67,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:16:47.67,0:16:51.01,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:16:47.67,0:16:51.01,Default,,0000,0000,0000,,Чио-чан Гиганттардың жанкүйері ме?
Dialogue: 0,0:16:51.01,0:16:54.17,Default,,0000,0000,0000,,Иә! Биыл жеңімпаз!
Dialogue: 0,0:16:54.17,0:16:56.51,Default,,0000,0000,0000,,Жоқ, жоқ, қандай алып.
Dialogue: 0,0:16:56.51,0:16:59.51,Default,,0000,0000,0000,,Биыл бұл Ханшин.
Dialogue: 0,0:16:56.51,0:16:59.51,Default,,0000,0000,0000,,Бұл алып!
Dialogue: 0,0:16:59.51,0:17:01.45,Default,,0000,0000,0000,,Ханшин!
Dialogue: 0,0:16:59.51,0:17:01.45,Default,,0000,0000,0000,,Бұл алып!
Dialogue: 0,0:17:01.45,0:17:04.45,Default,,0000,0000,0000,,Ханшин!
Dialogue: 0,0:17:01.45,0:17:04.45,Default,,0000,0000,0000,,Бұл алып!
Dialogue: 0,0:17:01.45,0:17:04.45,Default,,0000,0000,0000,,Hanshin Databa!
Dialogue: 0,0:17:04.45,0:17:06.45,Default,,0000,0000,0000,,Бұл алып!
Dialogue: 0,0:17:04.45,0:17:06.45,Default,,0000,0000,0000,,Ханшин!
Dialogue: 0,0:17:06.45,0:17:08.46,Default,,0000,0000,0000,,Абсолютті алып!
Dialogue: 0,0:17:08.46,0:17:13.46,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:13.46,0:17:15.46,Default,,0000,0000,0000,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:17:13.46,0:17:15.46,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:15.46,0:17:24.47,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:24.47,0:17:31.81,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:31.81,0:17:35.98,Default,,0000,0000,0000,,Бірақ Алыптар жыл сайын және әрқашан жоғалтады дейді.
Dialogue: 0,0:17:35.98,0:17:37.99,Default,,0000,0000,0000,,Биыл да мүмкін емес.
Dialogue: 0,0:17:37.99,0:17:39.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:17:39.99,0:17:42.49,Default,,0000,0000,0000,,Жоқ, көрдіңіз бе...
Dialogue: 0,0:17:42.49,0:17:44.49,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:17:42.49,0:17:44.49,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:44.49,0:17:46.49,Default,,0000,0000,0000,,Менің әкем.
Dialogue: 0,0:17:46.49,0:17:50.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:50.00,0:17:58.34,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:58.34,0:18:00.44,Default,,0000,0000,0000,,Онда мен үйге барамын.
Dialogue: 0,0:18:00.44,0:18:02.78,Default,,0000,0000,0000,,Бұл өте қызық болды.
Dialogue: 0,0:18:02.78,0:18:05.45,Default,,0000,0000,0000,,А, мен де!
Dialogue: 0,0:18:02.78,0:18:05.45,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:05.45,0:18:07.95,Default,,0000,0000,0000,,Оған дейін мен сені шығарып саламын!
Dialogue: 0,0:18:07.95,0:18:10.62,Default,,0000,0000,0000,,Тадаёси-санның серуені де бар.
Dialogue: 0,0:18:10.62,0:18:14.12,Default,,0000,0000,0000,,Түсіндім, бірге барайық!
Dialogue: 0,0:18:14.12,0:18:16.12,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:16.12,0:18:31.97,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:18:31.97,0:18:35.64,Default,,0000,0000,0000,,♬ (Чиёның ызылдағаны)
Dialogue: 0,0:18:35.64,0:18:39.31,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:35.64,0:18:39.31,Default,,0000,0000,0000,,Егер сіз осы жолмен жүрсеңіз, бұл төте жол!
Dialogue: 0,0:18:39.31,0:18:50.51,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:18:57.00,0:18:59.00,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:18:57.00,0:18:59.00,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:18:59.00,0:19:00.93,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:00.93,0:19:06.94,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:06.94,0:19:08.94,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:19:08.94,0:19:10.94,Default,,0000,0000,0000,,Бұл өте үлкен.
Dialogue: 0,0:19:10.94,0:19:13.61,Default,,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,0:19:13.61,0:19:17.62,Default,,0000,0000,0000,,Мен соған сіңіп кеткендей болдым.
Dialogue: 0,0:19:17.62,0:19:39.14,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:39.14,0:19:42.14,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:19:42.14,0:19:45.15,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:19:45.15,0:19:47.98,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:19:47.98,0:19:49.98,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:19:49.98,0:19:52.65,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:52.65,0:19:58.66,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:19:58.66,0:20:01.50,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:20:01.50,0:20:03.50,Default,,0000,0000,0000,,Хаха! Міне, міне!
Dialogue: 0,0:20:01.50,0:20:03.50,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:20:03.50,0:20:06.17,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:20:06.17,0:20:10.17,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:20:06.17,0:20:10.17,Default,,0000,0000,0000,,Ах! Күте тұрыңыз!
Dialogue: 0,0:20:10.17,0:20:13.01,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:20:13.01,0:20:17.85,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:20:17.85,0:20:21.85,Default,,0000,0000,0000,,Тоқта, күт!
Dialogue: 0,0:20:17.85,0:20:21.85,Default,,0000,0000,0000,,Сен екеуің алда барыңдар!
Dialogue: 0,0:20:21.85,0:20:30.36,Default,,0000,0000,0000,,(Тыныс алу жүгіру)
Dialogue: 0,0:20:30.36,0:20:32.36,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:20:32.36,0:20:40.20,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:40.20,0:20:43.54,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:20:43.54,0:20:46.87,Default,,0000,0000,0000,,Ахха Са-каки-сан!
Dialogue: 0,0:20:46.87,0:20:48.88,Default,,0000,0000,0000,,Хехехе!
Dialogue: 0,0:20:46.87,0:20:48.88,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:20:48.88,0:21:13.50,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:21:13.50,0:21:18.17,Default,,0000,0000,0000,,(Жел дыбысы)
Dialogue: 0,0:21:18.17,0:21:20.67,Default,,0000,0000,0000,,Мен бұған ешқашан жол бермеймін, иә?
Dialogue: 0,0:21:20.67,0:21:22.68,Default,,0000,0000,0000,,Мен ертең мектепке қайтамын.
Dialogue: 0,0:21:22.68,0:21:24.68,Default,,0000,0000,0000,,Қош бол.
Dialogue: 0,0:21:24.68,0:21:28.02,Default,,0000,0000,0000,,Бұл не? Һмм… Білгің келе ме?
Dialogue: 0,0:21:28.02,0:21:49.04,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:49.04,0:21:51.14,Default,,0000,0000,0000,,Мияу.
Dialogue: 0,0:21:49.04,0:21:51.14,Default,,0000,0000,0000,,Ах...
