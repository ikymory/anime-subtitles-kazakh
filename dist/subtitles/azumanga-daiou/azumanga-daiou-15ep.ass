Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.69,0:01:36.69,Default,,0000,0000,0000,,♪ Ка-та-на
Dialogue: 0,0:01:34.69,0:01:36.69,Default,,0000,0000,0000,,Біз мұны биыл тағы да жасадық!
Dialogue: 0,0:01:36.69,0:01:38.69,Default,,0000,0000,0000,,Ертең спорт мерекесі!
Dialogue: 0,0:01:40.70,0:01:44.20,Default,,0000,0000,0000,,Екінші топты жеңіңіз!
Dialogue: 0,0:01:40.70,0:01:44.20,Default,,0000,0000,0000,,Екі жиын?
Dialogue: 0,0:01:44.20,0:01:46.20,Default,,0000,0000,0000,,Бұл Нямо-чанның сыныбы.
Dialogue: 0,0:01:46.20,0:01:48.87,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:01:46.20,0:01:48.87,Default,,0000,0000,0000,,Не...?
Dialogue: 0,0:01:48.87,0:01:51.87,Default,,0000,0000,0000,,Барын салып, талпын
Dialogue: 0,0:01:48.87,0:01:51.87,Default,,0000,0000,0000,,Жеңіске қол жеткізіңіз...
Dialogue: 0,0:01:51.87,0:01:53.88,Default,,0000,0000,0000,,Әдемі емес пе?
Dialogue: 0,0:01:53.88,0:01:56.71,Default,,0000,0000,0000,,Атап айтқанда
Dialogue: 0,0:01:53.88,0:01:56.71,Default,,0000,0000,0000,,10 000 иен әдемі!
Dialogue: 0,0:01:56.71,0:01:59.88,Default,,0000,0000,0000,,Иә Иә!
Dialogue: 0,0:01:56.71,0:01:59.88,Default,,0000,0000,0000,,Олай болса, екінші топты жеңсеңіз➡
Dialogue: 0,0:01:59.88,0:02:02.15,Default,,0000,0000,0000,,Жеңбесең де, маған шырын сатып ал!
Dialogue: 0,0:02:02.15,0:02:04.15,Default,,0000,0000,0000,,Nonnonnon.
Dialogue: 0,0:02:04.15,0:02:07.99,Default,,0000,0000,0000,,Мұндай төмен ұмтылыспен бірдеңе істеудің мәні жоқ.
Dialogue: 0,0:02:07.99,0:02:09.99,Default,,0000,0000,0000,,Жеңіске ұмтыл!
Dialogue: 0,0:02:09.99,0:02:13.16,Default,,0000,0000,0000,,Одан әрі ұтқан жағдайда
Dialogue: 0,0:02:09.99,0:02:13.16,Default,,0000,0000,0000,,Сусындар сіз үшін төленеді!
Dialogue: 0,0:02:13.16,0:02:17.00,Default,,0000,0000,0000,,Якинику да қол жетімді!
Dialogue: 0,0:02:17.00,0:02:20.84,Default,,0000,0000,0000,,Якинику, иә?
Dialogue: 0,0:02:20.84,0:02:22.84,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:02:22.84,0:02:26.01,Default,,0000,0000,0000,,Бірақ өте ащы тұздық - жоқ-жоқ.
Dialogue: 0,0:02:26.01,0:02:29.18,Default,,0000,0000,0000,,Мен ауырғанға қарсы емеспін.
Dialogue: 0,0:02:29.18,0:02:31.51,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:02:31.51,0:02:34.35,Default,,0000,0000,0000,,Якинику мен Спорт мерекесінің байланысы қандай?
Dialogue: 0,0:02:34.35,0:02:37.85,Default,,0000,0000,0000,,Сұңқыр тырнақтары чили бұрышы екенін білесіз бе?
Dialogue: 0,0:02:39.85,0:02:43.53,Default,,0000,0000,0000,,Кола! Сол екі адам! Балалар сендер байсалды екенсіңдер
Dialogue: 0,0:02:39.85,0:02:43.53,Default,,0000,0000,0000,,Сіздің жеңіске деген ниетіңіз бар ма?
Dialogue: 0,0:02:43.53,0:02:45.86,Default,,0000,0000,0000,,Әсіресе Кагура! Неге қазір?
Dialogue: 0,0:02:45.86,0:02:47.86,Default,,0000,0000,0000,,Сіз осы сыныптасыз ба?
Dialogue: 0,0:02:45.86,0:02:47.86,Default,,0000,0000,0000,,Түсіндің бе? ?
Dialogue: 0,0:02:47.86,0:02:50.53,Default,,0000,0000,0000,,《Күнтізбе/Каорин: күткендей
Dialogue: 0,0:02:47.86,0:02:50.53,Default,,0000,0000,0000,,Солай болды ма?》
Dialogue: 0,0:02:50.53,0:02:52.53,Default,,0000,0000,0000,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:02:50.53,0:02:52.53,Default,,0000,0000,0000,,Көңіл-күйлеріңіз көтеріңкі болсын!
Dialogue: 0,0:02:52.53,0:02:54.87,Default,,0000,0000,0000,,Екі топты құлат! Мақсат - жеңіс!
Dialogue: 0,0:02:54.87,0:02:56.87,Default,,0000,0000,0000,,Еее!
Dialogue: 0,0:02:56.87,0:02:59.54,Default,,0000,0000,0000,,Eeeio~.
Dialogue: 0,0:02:59.54,0:03:02.14,Default,,0000,0000,0000,,Менің рухым жетпейді!
Dialogue: 0,0:02:59.54,0:03:02.14,Default,,0000,0000,0000,,Тағы да!
Dialogue: 0,0:03:02.14,0:03:04.15,Default,,0000,0000,0000,,Еее!
Dialogue: 0,0:03:04.15,0:03:06.31,Default,,0000,0000,0000,,Еее!
Dialogue: 0,0:03:06.31,0:03:08.32,Default,,0000,0000,0000,,Онда мен сабаққа қатысамын.
Dialogue: 0,0:03:10.99,0:03:14.16,Default,,0000,0000,0000,,Бірақ маған Якинику қайтадан ұнайды...
Dialogue: 0,0:03:14.16,0:03:16.16,Default,,0000,0000,0000,,Егер біз жеңсек ше?
Dialogue: 0,0:03:16.16,0:03:18.16,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:03:16.16,0:03:18.16,Default,,0000,0000,0000,,Сакаки-саннан басқа биыл ➡
Dialogue: 0,0:03:18.16,0:03:20.33,Default,,0000,0000,0000,,Кагура-сан да осында, сондықтан ол күшті.
Dialogue: 0,0:03:20.33,0:03:23.33,Default,,0000,0000,0000,,Бірақ бізді тежейтін адамдар да бар.
Dialogue: 0,0:03:20.33,0:03:23.33,Default,,0000,0000,0000,,Өйткені бар.
Dialogue: 0,0:03:23.33,0:03:27.00,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:03:27.00,0:03:29.17,Default,,0000,0000,0000,,Мені ұстап тұрған сенсің!
Dialogue: 0,0:03:29.17,0:03:32.51,Default,,0000,0000,0000,,Менің өткен жылғы жетістіктерім
Dialogue: 0,0:03:29.17,0:03:32.51,Default,,0000,0000,0000,,Сіз оны көрмедіңіз бе? ?
Dialogue: 0,0:03:32.51,0:03:36.68,Default,,0000,0000,0000,,А, мен сенің мақсаттың алдында құлағаныңды көрдім➡
Dialogue: 0,0:03:36.68,0:03:41.18,Default,,0000,0000,0000,,Кейінгі жүйріктердің қатысуымен болған апат
Dialogue: 0,0:03:36.68,0:03:41.18,Default,,0000,0000,0000,,Оған себеп болған сол үлкен жетістік.
Dialogue: 0,0:03:41.18,0:03:43.69,Default,,0000,0000,0000,,Не~!
Dialogue: 0,0:03:41.18,0:03:43.69,Default,,0000,0000,0000,,Менің сол өнерпазым➡
Dialogue: 0,0:03:43.69,0:03:45.69,Default,,0000,0000,0000,,Түсінбедің бе!
Dialogue: 0,0:03:45.69,0:03:49.86,Default,,0000,0000,0000,,Аа, мен қатысып жатқан жарыс.
Dialogue: 0,0:03:45.69,0:03:49.86,Default,,0000,0000,0000,,азайтыңыз….
Dialogue: 0,0:03:49.86,0:03:53.03,Default,,0000,0000,0000,,Неліктен барлығы 10 км марафонға қатысады?
Dialogue: 0,0:03:53.03,0:03:55.36,Default,,0000,0000,0000,,Нан жеу жарысы болғаны дұрыс емес пе?
Dialogue: 0,0:03:55.36,0:03:57.87,Default,,0000,0000,0000,,Бұл рас!
Dialogue: 0,0:03:55.36,0:03:57.87,Default,,0000,0000,0000,,Мен әдейі құладым!
Dialogue: 0,0:03:57.87,0:04:01.47,Default,,0000,0000,0000,,Жарайды Чиё Чан.
Dialogue: 0,0:03:57.87,0:04:01.47,Default,,0000,0000,0000,,Өйткені ол маңызды күш.
Dialogue: 0,0:04:01.47,0:04:04.47,Default,,0000,0000,0000,,Көңіл көтеру сайысы
Dialogue: 0,0:04:01.47,0:04:04.47,Default,,0000,0000,0000,,Биыл қандай костюм кигенім дұрыс?
Dialogue: 0,0:04:04.47,0:04:06.81,Default,,0000,0000,0000,,Бұл үшін бір нәрсе
Dialogue: 0,0:04:04.47,0:04:06.81,Default,,0000,0000,0000,,Менің бір ұсынысым бар.
Dialogue: 0,0:04:06.81,0:04:09.48,Default,,0000,0000,0000,,Гяа!
Dialogue: 0,0:04:09.48,0:04:12.31,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:12.31,0:04:15.48,Default,,0000,0000,0000,,Бұл жолы жұмбақ таяқша
Dialogue: 0,0:04:12.31,0:04:15.48,Default,,0000,0000,0000,,Ұпайлар...
Dialogue: 0,0:04:15.48,0:04:17.65,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:17.65,0:04:20.49,Default,,0000,0000,0000,,А? Не?
Dialogue: 0,0:04:20.49,0:04:22.99,Default,,0000,0000,0000,,Әйелдің суреті.
Dialogue: 0,0:04:22.99,0:04:25.66,Default,,0000,0000,0000,,Қандай әдемі адам.
Dialogue: 0,0:04:22.99,0:04:25.66,Default,,0000,0000,0000,,Кім?
Dialogue: 0,0:04:25.66,0:04:28.33,Default,,0000,0000,0000,,Менің әйелім.
Dialogue: 0,0:04:25.66,0:04:28.33,Default,,0000,0000,0000,,Өтірікші! ?
Dialogue: 0,0:04:28.33,0:04:30.67,Default,,0000,0000,0000,,Не? Өйткені не?
Dialogue: 0,0:04:30.67,0:04:33.17,Default,,0000,0000,0000,,Сондай сұлулық... Иә?
Dialogue: 0,0:04:35.34,0:04:37.51,Default,,0000,0000,0000,,Гаг?
Dialogue: 0,0:04:35.34,0:04:37.51,Default,,0000,0000,0000,,Маған не айтқыңыз келіп тұр?
Dialogue: 0,0:04:37.51,0:04:39.51,Default,,0000,0000,0000,,Бұл олардың бірге түскен суреті.
Dialogue: 0,0:04:43.18,0:04:45.85,Default,,0000,0000,0000,,Сол бала...
Dialogue: 0,0:04:43.18,0:04:45.85,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:04:45.85,0:04:48.02,Default,,0000,0000,0000,,Әй, қызым.
Dialogue: 0,0:04:48.02,0:04:51.35,Default,,0000,0000,0000,,《Ақылды бала сияқтысың...》
Dialogue: 0,0:04:48.02,0:04:51.35,Default,,0000,0000,0000,,өтіңіз.
Dialogue: 0,0:04:51.35,0:04:53.35,Default,,0000,0000,0000,,Бұл біртүрлі...
Dialogue: 0,0:04:51.35,0:04:53.35,Default,,0000,0000,0000,,Сейана.
Dialogue: 0,0:04:53.35,0:04:57.19,Default,,0000,0000,0000,,Ақыр соңында, қалай ойласаңыз да
Dialogue: 0,0:04:53.35,0:04:57.19,Default,,0000,0000,0000,,Кимураға: Анау әйел біртүрлі екен!
Dialogue: 0,0:04:57.19,0:04:59.96,Default,,0000,0000,0000,,Шынында да….
Dialogue: 0,0:04:57.19,0:04:59.96,Default,,0000,0000,0000,,Олардың бәрі қорқынышты!
Dialogue: 0,0:04:59.96,0:05:02.46,Default,,0000,0000,0000,,Ол, әрине, ерекше мұғалім!
Dialogue: 0,0:05:02.46,0:05:04.80,Default,,0000,0000,0000,,Бұның иісі қастандық сияқты.
Dialogue: 0,0:05:04.80,0:05:08.47,Default,,0000,0000,0000,,Аа, Кимураны таңдауға мотивация жеткіліксіз.
Dialogue: 0,0:05:08.47,0:05:10.81,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:05:08.47,0:05:10.81,Default,,0000,0000,0000,,Сіздің хоббиіңіз бар екеніне сенімдімін...
Dialogue: 0,0:05:10.81,0:05:14.48,Default,,0000,0000,0000,,Әйелі қандай хобби.
Dialogue: 0,0:05:10.81,0:05:14.48,Default,,0000,0000,0000,,Мм, түсіндім!
Dialogue: 0,0:05:14.48,0:05:17.98,Default,,0000,0000,0000,,Бұл әйел керемет
Dialogue: 0,0:05:14.48,0:05:17.98,Default,,0000,0000,0000,,Оның мінезі нашар болуы мүмкін. Сол себепті...
Dialogue: 0,0:05:17.98,0:05:19.98,Default,,0000,0000,0000,,Жоқ, солай!
Dialogue: 0,0:05:19.98,0:05:23.48,Default,,0000,0000,0000,,Мұны кешіруге жеткілікті
Dialogue: 0,0:05:19.98,0:05:23.48,Default,,0000,0000,0000,,Ол мейірімді әйел сияқты.
Dialogue: 0,0:05:23.48,0:05:26.32,Default,,0000,0000,0000,,Сонымен, сіз періште дейсіз бе...?
Dialogue: 0,0:05:26.32,0:05:35.00,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:35.00,0:05:37.33,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:37.33,0:05:39.83,Default,,0000,0000,0000,,Күн ашық және ашық.
Dialogue: 0,0:05:39.83,0:05:42.00,Default,,0000,0000,0000,,Не болды? Қайғылы жүз жасаңыз.
Dialogue: 0,0:05:42.00,0:05:45.17,Default,,0000,0000,0000,,Кедергілермен жарыс
Dialogue: 0,0:05:42.00,0:05:45.17,Default,,0000,0000,0000,,Оны асыға күтпедің бе?
Dialogue: 0,0:05:45.17,0:05:49.01,Default,,0000,0000,0000,,Жарайды. Мәселе басқа.
Dialogue: 0,0:05:49.01,0:05:53.18,Default,,0000,0000,0000,,Мәселе?
Dialogue: 0,0:05:49.01,0:05:53.18,Default,,0000,0000,0000,,Иә, бұл үлкен мәселе.
Dialogue: 0,0:05:53.18,0:05:56.02,Default,,0000,0000,0000,,Мен марафондарда жақсы емеспін.
Dialogue: 0,0:05:56.02,0:05:58.69,Default,,0000,0000,0000,,Бұл барлығы қатысатын 10 км марафон.
Dialogue: 0,0:05:58.69,0:06:01.12,Default,,0000,0000,0000,,Бұл мені де үмітсіз етеді.
Dialogue: 0,0:06:01.12,0:06:04.63,Default,,0000,0000,0000,,Мен сен сияқты... жақсы емеспін.
Dialogue: 0,0:06:01.12,0:06:04.63,Default,,0000,0000,0000,,Сіз немен айналысасыз?
Dialogue: 0,0:06:04.63,0:06:08.30,Default,,0000,0000,0000,,Хмм... басқатырғыштар...!
Dialogue: 0,0:06:08.30,0:06:10.97,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:06:10.97,0:06:13.47,Default,,0000,0000,0000,,Өтірік Пазл қабылданбайды.
Dialogue: 0,0:06:13.47,0:06:15.77,Default,,0000,0000,0000,,Жартылай қарауды доғар.
Dialogue: 0,0:06:20.31,0:06:22.48,Default,,0000,0000,0000,,А, маған ұнамайды...
Dialogue: 0,0:06:22.48,0:06:24.48,Default,,0000,0000,0000,,Оны диета деп есептеңіз.
Dialogue: 0,0:06:24.48,0:06:27.65,Default,,0000,0000,0000,,А, түсіндім.
Dialogue: 0,0:06:27.65,0:06:29.65,Default,,0000,0000,0000,,Өз еркімен ұзақ қашықтыққа жүгіру➡
Dialogue: 0,0:06:29.65,0:06:32.49,Default,,0000,0000,0000,,Мен мұны ешқашан жасамаймын.
Dialogue: 0,0:06:29.65,0:06:32.49,Default,,0000,0000,0000,,Менің ойымша, бұл мүмкіндік.
Dialogue: 0,0:06:32.49,0:06:35.66,Default,,0000,0000,0000,,Бірақ мен семіз әрі біртүрлімін.
Dialogue: 0,0:06:35.66,0:06:38.06,Default,,0000,0000,0000,,Күте тұрыңыз, мен айттыңыз ба?
Dialogue: 0,0:06:35.66,0:06:38.06,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:06:41.50,0:06:43.50,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:06:47.00,0:06:51.51,Default,,0000,0000,0000,,Ах, мен кедергілер жолын асыға күтемін.
Dialogue: 0,0:06:51.51,0:06:54.51,Default,,0000,0000,0000,,Олай болса, бүгін барымызды салайық!
Dialogue: 0,0:06:54.51,0:06:58.01,Default,,0000,0000,0000,,Дұрыс, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:06:58.01,0:07:00.28,Default,,0000,0000,0000,,Мұны қалай айтасыз?
Dialogue: 0,0:07:00.28,0:07:03.45,Default,,0000,0000,0000,,Кисама тырысқан сайын мен Юкари-чан➡ боламын
Dialogue: 0,0:07:03.45,0:07:06.29,Default,,0000,0000,0000,,Сіз шырын сатып ала аласыз.
Dialogue: 0,0:07:06.29,0:07:09.29,Default,,0000,0000,0000,,Ең көбі мен үшін жұмыс істе!
Dialogue: 0,0:07:09.29,0:07:11.96,Default,,0000,0000,0000,,Ахахха Ахахха!
Dialogue: 0,0:07:09.29,0:07:11.96,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:07:11.96,0:07:14.13,Default,,0000,0000,0000,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:07:14.13,0:07:16.96,Default,,0000,0000,0000,,Олар арзан жігіттер...
Dialogue: 0,0:07:16.96,0:07:19.97,Default,,0000,0000,0000,,Бірінші жүлде~!
Dialogue: 0,0:07:19.97,0:07:24.27,Default,,0000,0000,0000,,📢Спорт фестивалі атқару комитеті төрағасының хабарламасы
Dialogue: 0,0:07:19.97,0:07:24.27,Default,,0000,0000,0000,,Бұл сәлемдесу болды.
Dialogue: 0,0:07:26.97,0:07:28.97,Default,,0000,0000,0000,,Ммм!
Dialogue: 0,0:07:32.65,0:07:35.82,Default,,0000,0000,0000,,📢Жарайды онда
Dialogue: 0,0:07:32.65,0:07:35.82,Default,,0000,0000,0000,,Енді доптарды салуды бастаймыз.
Dialogue: 0,0:07:35.82,0:07:37.99,Default,,0000,0000,0000,,Өткен жылы тіпті бір емес
Dialogue: 0,0:07:35.82,0:07:37.99,Default,,0000,0000,0000,,Себебі мен кіре алмадым➡
Dialogue: 0,0:07:37.99,0:07:40.15,Default,,0000,0000,0000,,Осы жылы біреуін қоямын!
Dialogue: 0,0:07:40.15,0:07:42.49,Default,,0000,0000,0000,,Мен де былтыр
Dialogue: 0,0:07:40.15,0:07:42.49,Default,,0000,0000,0000,,Тіпті біреуі де кірмеді➡
Dialogue: 0,0:07:42.49,0:07:44.83,Default,,0000,0000,0000,,3 бөлікті салайық!
Dialogue: 0,0:07:42.49,0:07:44.83,Default,,0000,0000,0000,,О!
Dialogue: 0,0:07:44.83,0:07:48.66,Default,,0000,0000,0000,,Өткен жылы мені де жақсы көр
Dialogue: 0,0:07:44.83,0:07:48.66,Default,,0000,0000,0000,,Біреуін де қоя алмадым➡
Dialogue: 0,0:07:48.66,0:07:51.00,Default,,0000,0000,0000,,5 бөлікті салыңыз!
Dialogue: 0,0:07:48.66,0:07:51.00,Default,,0000,0000,0000,,О!
Dialogue: 0,0:07:51.00,0:07:54.17,Default,,0000,0000,0000,,Сонда менде 3 плюс бар
Dialogue: 0,0:07:51.00,0:07:54.17,Default,,0000,0000,0000,,Барлығы 6 бөлікті салайық!
Dialogue: 0,0:07:54.17,0:07:56.34,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:07:54.17,0:07:56.34,Default,,0000,0000,0000,,Мен екеуін қосқым келеді!
Dialogue: 0,0:07:56.34,0:07:58.67,Default,,0000,0000,0000,,Олар бізді пайдаланбайды.
Dialogue: 0,0:07:56.34,0:07:58.67,Default,,0000,0000,0000,,Қолымыздан келгеннің бәрін жасайық.
Dialogue: 0,0:07:58.67,0:08:00.61,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:08:00.61,0:08:03.28,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:08:03.28,0:08:05.28,Default,,0000,0000,0000,,(Тапанша дыбысы)
Dialogue: 0,0:08:05.28,0:08:07.62,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:07.62,0:08:09.62,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:07.62,0:08:09.62,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:08:09.62,0:08:11.62,Default,,0000,0000,0000,,《Қорқпа. Дем ал.》
Dialogue: 0,0:08:13.96,0:08:15.96,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:13.96,0:08:15.96,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:08:15.96,0:08:17.96,Default,,0000,0000,0000,,《Қорқпа. Дем ал.》
Dialogue: 0,0:08:19.96,0:08:21.96,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:19.96,0:08:21.96,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:08:21.96,0:08:23.96,Default,,0000,0000,0000,,Ех!
Dialogue: 0,0:08:26.13,0:08:28.47,Default,,0000,0000,0000,,Ах! Мен қазір кірдім!
Dialogue: 0,0:08:28.47,0:08:31.97,Default,,0000,0000,0000,,Мен қазір осындамын!
Dialogue: 0,0:08:28.47,0:08:31.97,Default,,0000,0000,0000,,Менің доп кірді!
Dialogue: 0,0:08:31.97,0:08:33.98,Default,,0000,0000,0000,,Мен кіремін!
Dialogue: 0,0:08:33.98,0:08:36.64,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:08:33.98,0:08:36.64,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:36.64,0:08:39.15,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:08:36.64,0:08:39.15,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:39.15,0:08:41.82,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:08:39.15,0:08:41.82,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:41.82,0:08:44.65,Default,,0000,0000,0000,,📢Келесі допты домалату.
Dialogue: 0,0:08:44.65,0:08:48.16,Default,,0000,0000,0000,,Чичио жұбы, мен бар күшімді саламын!
Dialogue: 0,0:08:44.65,0:08:48.16,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:08:48.16,0:08:50.16,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:08:50.16,0:08:52.83,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:08:52.83,0:08:55.16,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:08:55.16,0:08:57.33,Default,,0000,0000,0000,,Күтіңіз, күтіңіз!
Dialogue: 0,0:08:57.33,0:09:00.10,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:09:00.10,0:09:02.10,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:09:02.10,0:09:05.11,Default,,0000,0000,0000,,📢Келесі кедергілер жолы.
Dialogue: 0,0:09:05.11,0:09:07.28,Default,,0000,0000,0000,,Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:09:07.28,0:09:09.44,Default,,0000,0000,0000,,Осака кедергілерден өтуде➡
Dialogue: 0,0:09:09.44,0:09:12.78,Default,,0000,0000,0000,,Бұл мүлде қате емес пе?
Dialogue: 0,0:09:09.44,0:09:12.78,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:09:12.78,0:09:17.62,Default,,0000,0000,0000,,Жоқ, бұл адамның өзі.
Dialogue: 0,0:09:12.78,0:09:17.62,Default,,0000,0000,0000,,Маған мұны істегіңіз келетінін айтыңыз.
Dialogue: 0,0:09:17.62,0:09:20.45,Default,,0000,0000,0000,,Қараңдар, бетіңді ұнтақта.
Dialogue: 0,0:09:17.62,0:09:20.45,Default,,0000,0000,0000,,Кәмпит алатын адам➡
Dialogue: 0,0:09:20.45,0:09:22.79,Default,,0000,0000,0000,,Міне, мен мұны істегім келеді.
Dialogue: 0,0:09:20.45,0:09:22.79,Default,,0000,0000,0000,,Ах~аа~.
Dialogue: 0,0:09:22.79,0:09:25.63,Default,,0000,0000,0000,,өтіңіз.
Dialogue: 0,0:09:22.79,0:09:25.63,Default,,0000,0000,0000,,Хаха.
Dialogue: 0,0:09:25.63,0:09:28.30,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:09:28.30,0:09:31.30,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:09:31.30,0:09:33.30,Default,,0000,0000,0000,,Нхухухуху.
Dialogue: 0,0:09:33.30,0:09:36.14,Default,,0000,0000,0000,,Хе-у-хаха.
Dialogue: 0,0:09:36.14,0:09:39.97,Default,,0000,0000,0000,,Хэхехехехе~.
Dialogue: 0,0:09:39.97,0:09:42.98,Default,,0000,0000,0000,,Ахахха Уфуфу~.
Dialogue: 0,0:09:39.97,0:09:42.98,Default,,0000,0000,0000,,Иә, Осака мырза.
Dialogue: 0,0:09:42.98,0:09:45.15,Default,,0000,0000,0000,,Бетіңізді сүртіңіз.
Dialogue: 0,0:09:45.15,0:09:47.32,Default,,0000,0000,0000,,Бірақ бұл төртеуі неліктен?
Dialogue: 0,0:09:47.32,0:09:49.65,Default,,0000,0000,0000,,Ахахха Уфуфу.
Dialogue: 0,0:09:49.65,0:09:52.32,Default,,0000,0000,0000,,📢Келесі әйелдер атты әскер сайысы.
Dialogue: 0,0:09:52.32,0:09:54.32,Default,,0000,0000,0000,,Жанкен!
Dialogue: 0,0:09:54.32,0:09:56.66,Default,,0000,0000,0000,,Поп!
Dialogue: 0,0:09:54.32,0:09:56.66,Default,,0000,0000,0000,,Поп.
Dialogue: 0,0:09:56.66,0:09:59.33,Default,,0000,0000,0000,,Яри Томо-чан жеңді!
Dialogue: 0,0:09:59.33,0:10:03.00,Default,,0000,0000,0000,,Енді жарамсыз емес пе?
Dialogue: 0,0:09:59.33,0:10:03.00,Default,,0000,0000,0000,,Біреу кешігіп келді!
Dialogue: 0,0:10:03.00,0:10:07.00,Default,,0000,0000,0000,,Мен кешігіп қалу үшін жолдан шықтым.
Dialogue: 0,0:10:03.00,0:10:07.00,Default,,0000,0000,0000,,Жеңілгендер бар ма? Эй, Осака?
Dialogue: 0,0:10:07.00,0:10:10.00,Default,,0000,0000,0000,,Томо-чан, сен тасты, қағазды, қайшыны жақсы меңгересің.
Dialogue: 0,0:10:10.00,0:10:12.34,Default,,0000,0000,0000,,Қарғыс атсын, бұл ең нашар комбинация...
Dialogue: 0,0:10:12.34,0:10:14.51,Default,,0000,0000,0000,,Жарайды, солай!
Dialogue: 0,0:10:14.51,0:10:16.68,Default,,0000,0000,0000,,Томо-чан, қозғалма!
Dialogue: 0,0:10:16.68,0:10:18.68,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:10:22.18,0:10:24.69,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:24.69,0:10:26.69,Default,,0000,0000,0000,,Жарайсыңдар, бейбақтар!
Dialogue: 0,0:10:24.69,0:10:26.69,Default,,0000,0000,0000,,Қуатыңызды көтеріңіз!
Dialogue: 0,0:10:26.69,0:10:28.69,Default,,0000,0000,0000,,Біз де жолға шығамыз!
Dialogue: 0,0:10:28.69,0:10:30.69,Default,,0000,0000,0000,,Чио-чан, жақсысың ба?
Dialogue: 0,0:10:30.69,0:10:34.20,Default,,0000,0000,0000,,Аха ахаха Жарайды....
Dialogue: 0,0:10:34.20,0:10:36.20,Default,,0000,0000,0000,,Ух... Сонымен...
Dialogue: 0,0:10:36.20,0:10:39.03,Default,,0000,0000,0000,,Ммм, дұрыс айтасыз!
Dialogue: 0,0:10:39.03,0:10:41.04,Default,,0000,0000,0000,,Оңға жүріңіз! Дұрыс, дұрыс!
Dialogue: 0,0:10:41.04,0:10:43.54,Default,,0000,0000,0000,,Дұрыс~?
Dialogue: 0,0:10:41.04,0:10:43.54,Default,,0000,0000,0000,,Таяқтарды ұстайтын қол!
Dialogue: 0,0:10:43.54,0:10:46.54,Default,,0000,0000,0000,,Аа, мм...
Dialogue: 0,0:10:46.54,0:10:48.54,Default,,0000,0000,0000,,Осы жолмен?
Dialogue: 0,0:10:48.54,0:10:51.05,Default,,0000,0000,0000,,Ах~аа~!
Dialogue: 0,0:10:48.54,0:10:51.05,Default,,0000,0000,0000,,Түсінген бойда қолдарыңызды артқа қойыңыз!
Dialogue: 0,0:10:51.05,0:10:54.55,Default,,0000,0000,0000,,Чио-чан ұзаққа созылмайды!
Dialogue: 0,0:10:51.05,0:10:54.55,Default,,0000,0000,0000,,Бұл енді жақсы емес...
Dialogue: 0,0:10:54.55,0:10:56.88,Default,,0000,0000,0000,,Уф! Ақымақ, жігеріңді көрсет!
Dialogue: 0,0:10:56.88,0:11:00.49,Default,,0000,0000,0000,,Сен ақымақсың!
Dialogue: 0,0:10:56.88,0:11:00.49,Default,,0000,0000,0000,,Не! Цуккоми көзілдірігі!
Dialogue: 0,0:11:00.49,0:11:03.99,Default,,0000,0000,0000,,Капитан менмін! Не қарсы келеді
Dialogue: 0,0:11:00.49,0:11:03.99,Default,,0000,0000,0000,,Мына кемеден түс!
Dialogue: 0,0:11:03.99,0:11:06.16,Default,,0000,0000,0000,,Сіз түсе алатыныңызға сенімдісіз бе?
Dialogue: 0,0:11:06.16,0:11:08.83,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:11:06.16,0:11:08.83,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:11:08.83,0:11:11.83,Default,,0000,0000,0000,,Мен оны аяймын...
Dialogue: 0,0:11:08.83,0:11:11.83,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:11:11.83,0:11:14.67,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:11.83,0:11:14.67,Default,,0000,0000,0000,,Бұл аздап қорқынышты...
Dialogue: 0,0:11:14.67,0:11:16.67,Default,,0000,0000,0000,,Басқа жерге барамыз ба?
Dialogue: 0,0:11:16.67,0:11:19.67,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:16.67,0:11:19.67,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:19.67,0:11:21.68,Default,,0000,0000,0000,,Хаха!
Dialogue: 0,0:11:19.67,0:11:21.68,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,0:11:21.68,0:11:25.18,Default,,0000,0000,0000,,Чиё-чан, жақсысың ба?
Dialogue: 0,0:11:21.68,0:11:25.18,Default,,0000,0000,0000,,Әйтеуір...
Dialogue: 0,0:11:25.18,0:11:27.68,Default,,0000,0000,0000,,Иә! Шырынды ішіңіз!
Dialogue: 0,0:11:27.68,0:11:29.85,Default,,0000,0000,0000,,Сіз жоғалтқан суды толтыруыңыз керек.
Dialogue: 0,0:11:29.85,0:11:31.85,Default,,0000,0000,0000,,Шырын - жеңімпаз.
Dialogue: 0,0:11:29.85,0:11:31.85,Default,,0000,0000,0000,,Юкари-чан➡
Dialogue: 0,0:11:31.85,0:11:33.85,Default,,0000,0000,0000,,Мені емдегеніңізді қалаймын!
Dialogue: 0,0:11:33.85,0:11:35.86,Default,,0000,0000,0000,,Сондықтан спорт мерекесі біткенше➡
Dialogue: 0,0:11:35.86,0:11:38.03,Default,,0000,0000,0000,,Мен ештеңе ішпеймін
Dialogue: 0,0:11:35.86,0:11:38.03,Default,,0000,0000,0000,,Мен оны түсіндіре алмаймын.
Dialogue: 0,0:11:38.03,0:11:41.03,Default,,0000,0000,0000,,Су! Оған дейін
Dialogue: 0,0:11:38.03,0:11:41.03,Default,,0000,0000,0000,,Тек су ішіңіз!
Dialogue: 0,0:11:41.03,0:11:43.33,Default,,0000,0000,0000,,Ал егер?
Dialogue: 0,0:11:41.03,0:11:43.33,Default,,0000,0000,0000,,Содан бір күні бір сәуле жарқырап түсті,
Dialogue: 0,0:11:46.03,0:11:48.04,Default,,0000,0000,0000,,Хаха...!
Dialogue: 0,0:11:46.03,0:11:48.04,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:11:48.04,0:11:50.20,Default,,0000,0000,0000,,Крандағы су жақсы болды ма?
Dialogue: 0,0:11:48.04,0:11:50.20,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:50.20,0:11:52.21,Default,,0000,0000,0000,,(шырын ішкен дыбыс)
Dialogue: 0,0:11:52.21,0:11:54.21,Default,,0000,0000,0000,,Бұл менікі!
Dialogue: 0,0:11:54.21,0:11:56.88,Default,,0000,0000,0000,,Ал, күте тұрыңыз, мынаны қараңыз.
Dialogue: 0,0:11:56.88,0:11:59.21,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:56.88,0:11:59.21,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:11:59.21,0:12:01.65,Default,,0000,0000,0000,,Бұл... болуы мүмкін бе?
Dialogue: 0,0:12:01.65,0:12:04.15,Default,,0000,0000,0000,,Кимураның әйелі?
Dialogue: 0,0:12:01.65,0:12:04.15,Default,,0000,0000,0000,,Мен және ұлым
Dialogue: 0,0:12:04.15,0:12:07.15,Default,,0000,0000,0000,,《Ол шынымен бар ма?...》
Dialogue: 0,0:12:04.15,0:12:07.15,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:12:07.15,0:12:10.49,Default,,0000,0000,0000,,Жарайды, қанша?
Dialogue: 0,0:12:07.15,0:12:10.49,Default,,0000,0000,0000,,Оның жақсы адам екеніне көз жеткізейік.
Dialogue: 0,0:12:10.49,0:12:12.59,Default,,0000,0000,0000,,Сіз не істемексіз?
Dialogue: 0,0:12:10.49,0:12:12.59,Default,,0000,0000,0000,,Мұны орындаңыз.
Dialogue: 0,0:12:14.66,0:12:16.66,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:12:16.66,0:12:20.17,Default,,0000,0000,0000,,О, ой, ой!
Dialogue: 0,0:12:20.17,0:12:23.17,Default,,0000,0000,0000,,Сен… кімсің?
Dialogue: 0,0:12:20.17,0:12:23.17,Default,,0000,0000,0000,,Ол өте жақсы адам сияқты...
Dialogue: 0,0:12:23.17,0:12:25.34,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:12:25.34,0:12:28.68,Default,,0000,0000,0000,,Доки!
Dialogue: 0,0:12:25.34,0:12:28.68,Default,,0000,0000,0000,,А, мен осы жолмен келе жатырмын.
Dialogue: 0,0:12:28.68,0:12:31.18,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:12:28.68,0:12:31.18,Default,,0000,0000,0000,,О, менің ➡
Dialogue: 0,0:12:31.18,0:12:33.18,Default,,0000,0000,0000,,Сен, Чио-чан.
Dialogue: 0,0:12:33.18,0:12:35.68,Default,,0000,0000,0000,,Уау~ Өте сүйкімді.
Dialogue: 0,0:12:35.68,0:12:38.85,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:12:35.68,0:12:38.85,Default,,0000,0000,0000,,Сіз қайдан білесіз?
Dialogue: 0,0:12:38.85,0:12:40.86,Default,,0000,0000,0000,,Аа, кешіріңіз.
Dialogue: 0,0:12:40.86,0:12:43.19,Default,,0000,0000,0000,,Менің күйеуім мұнда мұғалім болып жұмыс істейді.
Dialogue: 0,0:12:43.19,0:12:46.36,Default,,0000,0000,0000,,Сонымен кішкентай және сүйкімді бала
Dialogue: 0,0:12:43.19,0:12:46.36,Default,,0000,0000,0000,,Мен біреу бар деп естідім.
Dialogue: 0,0:12:46.36,0:12:49.36,Default,,0000,0000,0000,,Сіз осылай айттыңыз ба?
Dialogue: 0,0:12:49.36,0:12:52.37,Default,,0000,0000,0000,,Бүгін спорт мерекесі.
Dialogue: 0,0:12:49.36,0:12:52.37,Default,,0000,0000,0000,,Сен оны көруге келдің бе?
Dialogue: 0,0:12:52.37,0:12:55.87,Default,,0000,0000,0000,,Иә көбірек
Dialogue: 0,0:12:52.37,0:12:55.87,Default,,0000,0000,0000,,Мен ертерек келуді жоспарлап едім➡
Dialogue: 0,0:12:55.87,0:12:58.54,Default,,0000,0000,0000,,Түскі ас қорабын жасауға барынша тырыссаңыз
Dialogue: 0,0:12:55.87,0:12:58.54,Default,,0000,0000,0000,,Кеш болды.
Dialogue: 0,0:12:58.54,0:13:00.47,Default,,0000,0000,0000,,О, қымбатты әйел бенто!
Dialogue: 0,0:13:00.47,0:13:02.48,Default,,0000,0000,0000,,А, солай.
Dialogue: 0,0:13:02.48,0:13:05.15,Default,,0000,0000,0000,,Сол адам
Dialogue: 0,0:13:02.48,0:13:05.15,Default,,0000,0000,0000,,Бұл махаббат әйелі бенто деп аталады.
Dialogue: 0,0:13:05.15,0:13:07.48,Default,,0000,0000,0000,,《Күнтізбе: Әйелді жақсы көр! 》
Dialogue: 0,0:13:05.15,0:13:07.48,Default,,0000,0000,0000,,《Даналық: Неге ағылшын!
Dialogue: 0,0:13:07.48,0:13:09.82,Default,,0000,0000,0000,,Бұл дұрыс емес және сасық! 》
Dialogue: 0,0:13:09.82,0:13:14.49,Default,,0000,0000,0000,,О, Кимура мырзаныкі
Dialogue: 0,0:13:09.82,0:13:14.49,Default,,0000,0000,0000,,Қайсысы жақсы?
Dialogue: 0,0:13:14.49,0:13:17.79,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:13:14.49,0:13:17.79,Default,,0000,0000,0000,,Хмм, иә.
Dialogue: 0,0:13:19.99,0:13:22.50,Default,,0000,0000,0000,,Бұл салқын жер ме?
Dialogue: 0,0:13:19.99,0:13:22.50,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:13:22.50,0:13:24.50,Default,,0000,0000,0000,,《Даналық: Бұл кісі
Dialogue: 0,0:13:22.50,0:13:24.50,Default,,0000,0000,0000,,Адамдарға көзің жетпейді! 》
Dialogue: 0,0:13:24.50,0:13:28.67,Default,,0000,0000,0000,,Әрине, бұл адам.
Dialogue: 0,0:13:24.50,0:13:28.67,Default,,0000,0000,0000,,Қазір онша танымал емес.
Dialogue: 0,0:13:28.67,0:13:33.34,Default,,0000,0000,0000,,Бірақ қараңызшы, 70-ші жылдардағы киімдер бүгінде трендте.
Dialogue: 0,0:13:28.67,0:13:33.34,Default,,0000,0000,0000,,Қайтадан пайда болатын сияқты➡
Dialogue: 0,0:13:33.34,0:13:36.18,Default,,0000,0000,0000,,Ол осылай айналады.
Dialogue: 0,0:13:36.18,0:13:38.51,Default,,0000,0000,0000,,Бәлкім, мен заман ағымынан тайған шығармын.
Dialogue: 0,0:13:38.51,0:13:41.02,Default,,0000,0000,0000,,《Даналық: Жоқ. Менің білуімше➡
Dialogue: 0,0:13:41.02,0:13:45.02,Default,,0000,0000,0000,,Қанша айналып жүрсе де
Dialogue: 0,0:13:41.02,0:13:45.02,Default,,0000,0000,0000,,Кимураның кезегі емес! 》
Dialogue: 0,0:13:45.02,0:13:47.86,Default,,0000,0000,0000,,🔊Келесі қарызға алынған жарыс.
Dialogue: 0,0:13:47.86,0:13:51.03,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:13:51.03,0:13:54.36,Default,,0000,0000,0000,,Қолыңнан келгеннің бәрін жаса, Чио-чан.
Dialogue: 0,0:13:51.03,0:13:54.36,Default,,0000,0000,0000,,Якинику!
Dialogue: 0,0:13:54.36,0:13:56.36,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:13:54.36,0:13:56.36,Default,,0000,0000,0000,,(Тапанша дыбысы)
Dialogue: 0,0:13:58.37,0:14:00.80,Default,,0000,0000,0000,,Чио-чан жекпе-жегі~!
Dialogue: 0,0:13:58.37,0:14:00.80,Default,,0000,0000,0000,,Оны құлат!
Dialogue: 0,0:14:00.80,0:14:03.47,Default,,0000,0000,0000,,Ешқашан қайталанбасын
Dialogue: 0,0:14:00.80,0:14:03.47,Default,,0000,0000,0000,,Тұра алмайтыныңызға көз жеткізіңіз!
Dialogue: 0,0:14:03.47,0:14:06.31,Default,,0000,0000,0000,,Қарыз жарысында? ДДСҰ?
Dialogue: 0,0:14:03.47,0:14:06.31,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:14:06.31,0:14:08.31,Default,,0000,0000,0000,,Хахахаха.
Dialogue: 0,0:14:08.31,0:14:14.65,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:14.65,0:14:17.32,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:14:14.65,0:14:17.32,Default,,0000,0000,0000,,Хахахаха.
Dialogue: 0,0:14:14.65,0:14:17.32,Default,,0000,0000,0000,,Бұл жерде.
Dialogue: 0,0:14:17.32,0:14:20.32,Default,,0000,0000,0000,,Хахаха, у...
Dialogue: 0,0:14:20.32,0:14:23.16,Default,,0000,0000,0000,,Сіз қайтадан көзілдірік киіп жүрсіз бе?
Dialogue: 0,0:14:20.32,0:14:23.16,Default,,0000,0000,0000,,Иә, солай.
Dialogue: 0,0:14:23.16,0:14:25.16,Default,,0000,0000,0000,,Ерм...
Dialogue: 0,0:14:23.16,0:14:25.16,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:14:25.16,0:14:27.16,Default,,0000,0000,0000,,Гүлдерімді шешуім керек пе?
Dialogue: 0,0:14:27.16,0:14:29.33,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:14:27.16,0:14:29.33,Default,,0000,0000,0000,,Бұл дұрыс емес...
Dialogue: 0,0:14:29.33,0:14:31.50,Default,,0000,0000,0000,,Сатоши-чан, кел!
Dialogue: 0,0:14:29.33,0:14:31.50,Default,,0000,0000,0000,,О!
Dialogue: 0,0:14:31.50,0:14:34.34,Default,,0000,0000,0000,,Эх, Сатоси... Олай емес! ?
Dialogue: 0,0:14:34.34,0:14:36.67,Default,,0000,0000,0000,,А, мен солай екеніне сенімдімін.
Dialogue: 0,0:14:36.67,0:14:39.34,Default,,0000,0000,0000,,Чио-чан да
Dialogue: 0,0:14:36.67,0:14:39.34,Default,,0000,0000,0000,,Сізде ептілік бар...
Dialogue: 0,0:14:39.34,0:14:41.84,Default,,0000,0000,0000,,Мақсат!
Dialogue: 0,0:14:39.34,0:14:41.84,Default,,0000,0000,0000,,Хахаха...
Dialogue: 0,0:14:41.84,0:14:45.01,Default,,0000,0000,0000,,Ей, не алдың?
Dialogue: 0,0:14:45.01,0:14:48.35,Default,,0000,0000,0000,,Сұлу апа, құрметтейтін адам?
Dialogue: 0,0:14:48.35,0:14:51.19,Default,,0000,0000,0000,,Мүмкін жақын дос шығар? Мен қатты ұялып тұрмын.
Dialogue: 0,0:14:51.19,0:14:54.69,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:14:51.19,0:14:54.69,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:14:54.69,0:14:57.69,Default,,0000,0000,0000,,(Ұшақ дыбысы)
Dialogue: 0,0:14:57.69,0:15:01.30,Default,,0000,0000,0000,,Эх~ Чихиро
Dialogue: 0,0:14:57.69,0:15:01.30,Default,,0000,0000,0000,,Сіз аяғыңызды сындырдыңыз ба?
Dialogue: 0,0:15:01.30,0:15:03.46,Default,,0000,0000,0000,,Иә, мен қазір емханаға барамын.
Dialogue: 0,0:15:03.46,0:15:06.63,Default,,0000,0000,0000,,Мен не істеуім керек? Бұл екеуміз ғана.
Dialogue: 0,0:15:06.63,0:15:08.64,Default,,0000,0000,0000,,Не, бос орын бар ма?
Dialogue: 0,0:15:08.64,0:15:11.47,Default,,0000,0000,0000,,Иә, менің үш адамдық сапардағы серіктесім...
Dialogue: 0,0:15:11.47,0:15:16.14,Default,,0000,0000,0000,,Хмм, күткендей.
Dialogue: 0,0:15:11.47,0:15:16.14,Default,,0000,0000,0000,,Менің орныма мықты біреу келгенін қалаймын.
Dialogue: 0,0:15:16.14,0:15:18.14,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:15:20.48,0:15:22.48,Default,,0000,0000,0000,,Сәлем Сакаки.
Dialogue: 0,0:15:22.48,0:15:24.82,Default,,0000,0000,0000,,Сен бірге бол.
Dialogue: 0,0:15:24.82,0:15:26.82,Default,,0000,0000,0000,,Иә, бірақ...
Dialogue: 0,0:15:26.82,0:15:29.49,Default,,0000,0000,0000,,Сакаки мырза
Dialogue: 0,0:15:26.82,0:15:29.49,Default,,0000,0000,0000,,Осындай қарапайым оқиға үшін...
Dialogue: 0,0:15:29.49,0:15:31.49,Default,,0000,0000,0000,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:15:29.49,0:15:31.49,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:15:31.49,0:15:35.66,Default,,0000,0000,0000,,Мен штативті екі рет қолданып көргім келді.
Dialogue: 0,0:15:31.49,0:15:35.66,Default,,0000,0000,0000,,Бұл қызықты көрінеді.
Dialogue: 0,0:15:35.66,0:15:37.67,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:15:37.67,0:15:39.83,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:15:37.67,0:15:39.83,Default,,0000,0000,0000,,Барымызды салайық.
Dialogue: 0,0:15:39.83,0:15:41.83,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:15:44.17,0:15:46.51,Default,,0000,0000,0000,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:15:44.17,0:15:46.51,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:15:46.51,0:15:51.68,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:15:51.68,0:15:54.01,Default,,0000,0000,0000,,Бірақ менің ең үлкен күнәм —
Dialogue: 0,0:15:54.01,0:15:56.02,Default,,0000,0000,0000,,Каорин!
Dialogue: 0,0:15:56.02,0:15:58.85,Default,,0000,0000,0000,,Ақыр аяғында шығу үшін бар күшімді салуым керек пе?
Dialogue: 0,0:15:58.85,0:16:00.79,Default,,0000,0000,0000,,Бұл соншалықты үлкен мәміле емес еді.
Dialogue: 0,0:16:00.79,0:16:04.63,Default,,0000,0000,0000,,Хмм, хмм, хмм, хмм…
Dialogue: 0,0:16:00.79,0:16:04.63,Default,,0000,0000,0000,,Ах, у...
Dialogue: 0,0:16:04.63,0:16:08.80,Default,,0000,0000,0000,,Хмм, хмм, хмм, хмм…
Dialogue: 0,0:16:08.80,0:16:11.30,Default,,0000,0000,0000,,Сәттілік...
Dialogue: 0,0:16:13.30,0:16:16.30,Default,,0000,0000,0000,,🔊Келесі - үш адамдық штатив.
Dialogue: 0,0:16:16.30,0:16:19.14,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:16:19.14,0:16:21.98,Default,,0000,0000,0000,,барын салады...
Dialogue: 0,0:16:19.14,0:16:21.98,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:21.98,0:16:24.31,Default,,0000,0000,0000,,Өлім ниетімен
Dialogue: 0,0:16:21.98,0:16:24.31,Default,,0000,0000,0000,,Өлсем деген ниетпен барымды саламын...
Dialogue: 0,0:16:24.31,0:16:27.31,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:16:24.31,0:16:27.31,Default,,0000,0000,0000,,Өл мен өлемін!
Dialogue: 0,0:16:27.31,0:16:29.82,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:16:29.82,0:16:32.65,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:16:29.82,0:16:32.65,Default,,0000,0000,0000,,Жарайды, бар күшімізді салайық.
Dialogue: 0,0:16:32.65,0:16:34.65,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:16:32.65,0:16:34.65,Default,,0000,0000,0000,,(Тапанша дыбысы)
Dialogue: 0,0:16:38.16,0:16:40.16,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:40.16,0:16:43.66,Default,,0000,0000,0000,,Ичини Ичини
Dialogue: 0,0:16:40.16,0:16:43.66,Default,,0000,0000,0000,,Ичини Ичини Ини.
Dialogue: 0,0:16:43.66,0:16:46.33,Default,,0000,0000,0000,,Ичини Ичини
Dialogue: 0,0:16:43.66,0:16:46.33,Default,,0000,0000,0000,,Ичини Ичини Ини.
Dialogue: 0,0:16:46.33,0:16:52.33,Default,,0000,0000,0000,,(Әндер)
Dialogue: 0,0:17:00.28,0:17:04.62,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:17:04.62,0:17:08.79,Default,,0000,0000,0000,,Яй Сакаки-сан No1 No1!
Dialogue: 0,0:17:08.79,0:17:11.79,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:17:08.79,0:17:11.79,Default,,0000,0000,0000,,Уау! Күрсіну….
Dialogue: 0,0:17:11.79,0:17:14.13,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:17:14.13,0:17:16.63,Default,,0000,0000,0000,,Хахаха... түсіндім.
Dialogue: 0,0:17:16.63,0:17:19.47,Default,,0000,0000,0000,,Аа, тым болмаса осы жалау үшін рахмет...
Dialogue: 0,0:17:19.47,0:17:21.47,Default,,0000,0000,0000,,Жоқ, бәрі жақсы...
Dialogue: 0,0:17:21.47,0:17:23.80,Default,,0000,0000,0000,,Ендеше не істеуім керек... Ой, түсіндім.
Dialogue: 0,0:17:23.80,0:17:25.81,Default,,0000,0000,0000,,Осындай нәрсе туралы не деуге болады?
Dialogue: 0,0:17:25.81,0:17:28.64,Default,,0000,0000,0000,,Тоттутттттттттттттттттттттттттт!
Dialogue: 0,0:17:25.81,0:17:28.64,Default,,0000,0000,0000,,А, жоқ... бұл...
Dialogue: 0,0:17:28.64,0:17:30.64,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:17:32.65,0:17:35.98,Default,,0000,0000,0000,,Хм... Мен оны шеше алмаймын.
Dialogue: 0,0:17:35.98,0:17:39.32,Default,,0000,0000,0000,,Егер ол кері қайтарылмаса, оны күштеп салыңыз.
Dialogue: 0,0:17:35.98,0:17:39.32,Default,,0000,0000,0000,,Бәлкім, оны шешпеген дұрыс шығар.
Dialogue: 0,0:17:39.32,0:17:41.49,Default,,0000,0000,0000,,Жоқ, сондықтан емес...
Dialogue: 0,0:17:41.49,0:17:44.66,Default,,0000,0000,0000,,Мен үшін алаңдама.
Dialogue: 0,0:17:44.66,0:17:47.83,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:44.66,0:17:47.83,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:17:47.83,0:17:50.00,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:17:50.00,0:17:54.34,Default,,0000,0000,0000,,🔊Соңғы жарыс болды
Dialogue: 0,0:17:50.00,0:17:54.34,Default,,0000,0000,0000,,Бұл 10 км марафон, оған барлығы қатыса алады.
Dialogue: 0,0:17:54.34,0:17:57.67,Default,,0000,0000,0000,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:17:54.34,0:17:57.67,Default,,0000,0000,0000,,Бұл жігіт жеңімпаз болады!
Dialogue: 0,0:17:57.67,0:17:59.67,Default,,0000,0000,0000,,Біз жарысты аяқтауды мақсат етеміз!
Dialogue: 0,0:17:59.67,0:18:02.44,Default,,0000,0000,0000,,Ей, ақымақ, сенде мұндай төмен амбиция болмайды!
Dialogue: 0,0:17:59.67,0:18:02.44,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:02.44,0:18:04.45,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:18:04.45,0:18:08.78,Default,,0000,0000,0000,,Дұрыс, мен жүгіремін
Dialogue: 0,0:18:04.45,0:18:08.78,Default,,0000,0000,0000,,Өміріңізді бақылаңыз!
Dialogue: 0,0:18:08.78,0:18:10.78,Default,,0000,0000,0000,,перде артындағы бөлме – священник кіретін бөлме екенін
Dialogue: 0,0:18:08.78,0:18:10.78,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:18:10.78,0:18:14.96,Default,,0000,0000,0000,,Әй, ақыры осы уақыт келді.
Dialogue: 0,0:18:10.78,0:18:14.96,Default,,0000,0000,0000,,Келуге тым кеш.
Dialogue: 0,0:18:14.96,0:18:18.29,Default,,0000,0000,0000,,Сол қызықты кедергілер жолы ➡
Dialogue: 0,0:18:18.29,0:18:21.96,Default,,0000,0000,0000,,Енді бұл
Dialogue: 0,0:18:18.29,0:18:21.96,Default,,0000,0000,0000,,Сонау өткен күннен естеліктер.
Dialogue: 0,0:18:21.96,0:18:24.13,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:18:24.13,0:18:26.63,Default,,0000,0000,0000,,Кедергі жарысының қайтуы!
Dialogue: 0,0:18:26.63,0:18:29.97,Default,,0000,0000,0000,,《Мен көп нәрсені қаламаймын
Dialogue: 0,0:18:26.63,0:18:29.97,Default,,0000,0000,0000,,Осы айда тайяки мөлшерін азайтыңыз.
Dialogue: 0,0:18:29.97,0:18:31.97,Default,,0000,0000,0000,,Оны азайтыңыз! 》
Dialogue: 0,0:18:31.97,0:18:34.48,Default,,0000,0000,0000,,Барлығына сәттілік.
Dialogue: 0,0:18:34.48,0:18:36.48,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:18:38.65,0:18:42.15,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:18:38.65,0:18:42.15,Default,,0000,0000,0000,,(Тапанша дыбысы)
Dialogue: 0,0:18:42.15,0:18:45.15,Default,,0000,0000,0000,,Соңғы соққы!
Dialogue: 0,0:18:45.15,0:18:47.15,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:18:47.15,0:18:50.32,Default,,0000,0000,0000,,О, жарайды, Икке Сатоши.
Dialogue: 0,0:18:47.15,0:18:50.32,Default,,0000,0000,0000,,Бутчигире~!
Dialogue: 0,0:18:50.32,0:18:53.52,Default,,0000,0000,0000,,Yakiniku Hmph алыңыз!
Dialogue: 0,0:18:58.83,0:19:02.63,Default,,0000,0000,0000,,Сәттілік, апалар!
Dialogue: 0,0:19:07.94,0:19:12.61,Default,,0000,0000,0000,,Хахаха...
Dialogue: 0,0:19:12.61,0:19:15.81,Default,,0000,0000,0000,,Хахахаха….
Dialogue: 0,0:19:19.95,0:19:21.96,Default,,0000,0000,0000,,Ах, Томо-чан.
Dialogue: 0,0:19:21.96,0:19:26.26,Default,,0000,0000,0000,,Хахахаха….
Dialogue: 0,0:19:28.30,0:19:30.46,Default,,0000,0000,0000,,Соңында бәрібір
Dialogue: 0,0:19:28.30,0:19:30.46,Default,,0000,0000,0000,,Бірінші бола алмасаңыз➡
Dialogue: 0,0:19:30.46,0:19:32.63,Default,,0000,0000,0000,,Тек басында...
Dialogue: 0,0:19:32.63,0:19:35.80,Default,,0000,0000,0000,,Сол себепті бірінші шақырымнан кейін алда болдым.
Dialogue: 0,0:19:35.80,0:19:37.81,Default,,0000,0000,0000,,Бір сәт болса да жарқырап тұрды.
Dialogue: 0,0:19:37.81,0:19:41.48,Default,,0000,0000,0000,,Немесе салқын.
Dialogue: 0,0:19:37.81,0:19:41.48,Default,,0000,0000,0000,,Бұл Томо-чанның өмір салты!
Dialogue: 0,0:19:41.48,0:19:43.98,Default,,0000,0000,0000,,Жарайды, мен де!
Dialogue: 0,0:19:43.98,0:19:45.98,Default,,0000,0000,0000,,О, Чио-чан!
Dialogue: 0,0:19:48.32,0:19:50.32,Default,,0000,0000,0000,,Хахаха...
Dialogue: 0,0:19:50.32,0:19:53.32,Default,,0000,0000,0000,,Хэ-хэ-хэ….
Dialogue: 0,0:19:56.16,0:19:58.49,Default,,0000,0000,0000,,Чио-чан, қош келдіңіз~.
Dialogue: 0,0:19:58.49,0:20:02.00,Default,,0000,0000,0000,,Бұл өмір жолы жақсы емес...
Dialogue: 0,0:20:02.00,0:20:04.10,Default,,0000,0000,0000,,Мен де солай ойлаймын.
Dialogue: 0,0:20:07.17,0:20:09.84,Default,,0000,0000,0000,,Хахаха...
Dialogue: 0,0:20:07.17,0:20:09.84,Default,,0000,0000,0000,,Ха, мен төменгі жағындамын.
Dialogue: 0,0:20:09.84,0:20:12.01,Default,,0000,0000,0000,,Буби.
Dialogue: 0,0:20:12.01,0:20:14.01,Default,,0000,0000,0000,,Хахаха...
Dialogue: 0,0:20:12.01,0:20:14.01,Default,,0000,0000,0000,,Бұл қылыш не өзі?!➡
Dialogue: 0,0:20:14.01,0:20:16.01,Default,,0000,0000,0000,,Ах, рахмет!
Dialogue: 0,0:20:16.01,0:20:19.01,Default,,0000,0000,0000,,Сакаки мырза бұл қандай сан?
Dialogue: 0,0:20:19.01,0:20:21.01,Default,,0000,0000,0000,,Бұл 1-ші нөмір ме?
Dialogue: 0,0:20:21.01,0:20:24.02,Default,,0000,0000,0000,,Жоқ. Мен алыс қашықтыққа жақсы емеспін, сондықтан мен 6-шы болдым.
Dialogue: 0,0:20:24.02,0:20:26.85,Default,,0000,0000,0000,,Е, жұп 6 саны керемет!
Dialogue: 0,0:20:26.85,0:20:28.86,Default,,0000,0000,0000,,Менің рейтингімді де тыңдаңыз!
Dialogue: 0,0:20:28.86,0:20:30.86,Default,,0000,0000,0000,,Кагура-сан қандай сан?
Dialogue: 0,0:20:30.86,0:20:33.36,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:20:30.86,0:20:33.36,Default,,0000,0000,0000,,Пар?
Dialogue: 0,0:20:33.36,0:20:36.20,Default,,0000,0000,0000,,Бұл 5 саны!
Dialogue: 0,0:20:33.36,0:20:36.20,Default,,0000,0000,0000,,Хехехехе.
Dialogue: 0,0:20:36.20,0:20:38.20,Default,,0000,0000,0000,,№ 5 № 6?
Dialogue: 0,0:20:38.20,0:20:41.87,Default,,0000,0000,0000,,Бірақ 1 км-ге дейін мен жеңемін!
Dialogue: 0,0:20:38.20,0:20:41.87,Default,,0000,0000,0000,,Бұл матч тең!
Dialogue: 0,0:20:41.87,0:20:45.21,Default,,0000,0000,0000,,көремін.
Dialogue: 0,0:20:41.87,0:20:45.21,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,0:20:45.21,0:20:49.71,Default,,0000,0000,0000,,🔊Қорытынды сайыс
Dialogue: 0,0:20:45.21,0:20:49.71,Default,,0000,0000,0000,,Марафон ұпайлары есептелді.
Dialogue: 0,0:20:49.71,0:20:51.71,Default,,0000,0000,0000,,Хабарландыру~!
Dialogue: 0,0:20:51.71,0:20:53.71,Default,,0000,0000,0000,,Хмм, хехе.
Dialogue: 0,0:20:53.71,0:20:56.38,Default,,0000,0000,0000,,Жеңімпаз!
Dialogue: 0,0:20:56.38,0:20:58.39,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:20:58.39,0:21:00.82,Default,,0000,0000,0000,,Юкари-чан шырыны!
Dialogue: 0,0:21:00.82,0:21:03.16,Default,,0000,0000,0000,,Ухухухуху...
Dialogue: 0,0:21:03.16,0:21:06.49,Default,,0000,0000,0000,,Нямо жеңді!
Dialogue: 0,0:21:03.16,0:21:06.49,Default,,0000,0000,0000,,Бұл ұят болды.
Dialogue: 0,0:21:06.49,0:21:09.83,Default,,0000,0000,0000,,Бірақ барлығы жақсы жұмыс жасады.
Dialogue: 0,0:21:06.49,0:21:09.83,Default,,0000,0000,0000,,Жеңіс!
Dialogue: 0,0:21:09.83,0:21:12.83,Default,,0000,0000,0000,,Жарайды, марапаттау.
Dialogue: 0,0:21:09.83,0:21:12.83,Default,,0000,0000,0000,,Сізге шырын сатып алайын ба?
Dialogue: 0,0:21:12.83,0:21:15.84,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:12.83,0:21:15.84,Default,,0000,0000,0000,,Мен Куросава мырзаны жақсы көремін!
Dialogue: 0,0:21:15.84,0:21:19.17,Default,,0000,0000,0000,,Бұл не? Жеңілсем де, өзімді сергек сезіндім.
Dialogue: 0,0:21:19.17,0:21:22.34,Default,,0000,0000,0000,,Huh~ Жеңілген команда, жеңілген команда!
Dialogue: 0,0:21:22.34,0:21:25.85,Default,,0000,0000,0000,,Сүйікті сүйікті!
Dialogue: 0,0:21:22.34,0:21:25.85,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:25.85,0:21:29.02,Default,,0000,0000,0000,,Бұл көңілсіз болуы керек, иә?
Dialogue: 0,0:21:25.85,0:21:29.02,Default,,0000,0000,0000,,Шырын….
Dialogue: 0,0:21:29.02,0:21:31.02,Default,,0000,0000,0000,,Ішкім келеді ме?
Dialogue: 0,0:21:31.02,0:21:34.19,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:21:31.02,0:21:34.19,Default,,0000,0000,0000,,Жеңілген, жеңілген!
Dialogue: 0,0:21:34.19,0:21:36.69,Default,,0000,0000,0000,,Ия, жоқ, жеңілген команда!
Dialogue: 0,0:21:36.69,0:21:40.19,Default,,0000,0000,0000,,Команданы жоғалтыңыз!
Dialogue: 0,0:21:40.19,0:21:52.87,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:52.87,0:21:54.87,Default,,0000,0000,0000,,(Номудың айғайы)
Dialogue: 0,0:21:56.37,0:22:02.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory