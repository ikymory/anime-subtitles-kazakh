Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:31.02,0:01:36.19,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:01:39.86,0:01:43.70,Default,,0000,0000,0000,,Бұл жерде!
Dialogue: 0,0:01:43.70,0:01:46.03,Default,,0000,0000,0000,,Тамақ бергеніңіз үшін рахмет.
Dialogue: 0,0:01:43.70,0:01:46.03,Default,,0000,0000,0000,,Ас үшін рахмет.
Dialogue: 0,0:01:46.03,0:01:48.04,Default,,0000,0000,0000,,Э-э, не істеп жатырсыз, мырза?
Dialogue: 0,0:01:46.03,0:01:48.04,Default,,0000,0000,0000,,Мен жеңілдім.
Dialogue: 0,0:01:48.04,0:01:50.04,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:01:50.04,0:01:54.54,Default,,0000,0000,0000,,Не, Осака, сен әлі жейсің бе?
Dialogue: 0,0:01:50.04,0:01:54.54,Default,,0000,0000,0000,,Кеш болды.
Dialogue: 0,0:01:54.54,0:01:56.88,Default,,0000,0000,0000,,Балалар сендер тым жылдамсыңдар.
Dialogue: 0,0:01:56.88,0:01:58.88,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:01:58.88,0:02:01.15,Default,,0000,0000,0000,,Әй, бәрі.
Dialogue: 0,0:01:58.88,0:02:01.15,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:02:01.15,0:02:03.65,Default,,0000,0000,0000,,Бұл спорт мерекесінен алынған баспа.
Dialogue: 0,0:02:03.65,0:02:07.32,Default,,0000,0000,0000,,Биылғы жарыс
Dialogue: 0,0:02:03.65,0:02:07.32,Default,,0000,0000,0000,,Ол толығымен қайта өңделетін сияқты.
Dialogue: 0,0:02:07.32,0:02:09.62,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:02:07.32,0:02:09.62,Default,,0000,0000,0000,,Ах!?
Dialogue: 0,0:02:16.33,0:02:18.67,Default,,0000,0000,0000,,Уа, ау...
Dialogue: 0,0:02:16.33,0:02:18.67,Default,,0000,0000,0000,,Па!
Dialogue: 0,0:02:18.67,0:02:21.00,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:02:18.67,0:02:21.00,Default,,0000,0000,0000,,Нан➡
Dialogue: 0,0:02:21.00,0:02:23.00,Default,,0000,0000,0000,,Күй чо~!
Dialogue: 0,0:02:23.00,0:02:28.60,Default,,0000,0000,0000,,Панкюйчё Панкюичё Панкюичё
Dialogue: 0,0:02:23.00,0:02:28.60,Default,,0000,0000,0000,,Панкюйчо Панкюичё.
Dialogue: 0,0:02:32.35,0:02:34.85,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:32.35,0:02:34.85,Default,,0000,0000,0000,,Анко….
Dialogue: 0,0:02:43.86,0:02:47.03,Default,,0000,0000,0000,,Нан жеу сайысы өтіп жатыр! ?
Dialogue: 0,0:02:43.86,0:02:47.03,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:02:47.03,0:02:50.53,Default,,0000,0000,0000,,Бұл нан жеу сайысы ма?
Dialogue: 0,0:02:50.53,0:02:54.87,Default,,0000,0000,0000,,А, бар, бар.
Dialogue: 0,0:02:50.53,0:02:54.87,Default,,0000,0000,0000,,Нан жеу сайысы.
Dialogue: 0,0:02:54.87,0:02:57.87,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:02:54.87,0:02:57.87,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:02:57.87,0:03:00.31,Default,,0000,0000,0000,,Нан жеу сайысы өтіп жатыр!
Dialogue: 0,0:03:00.31,0:03:02.98,Default,,0000,0000,0000,,Мұны бірден орындаңыз.
Dialogue: 0,0:03:02.98,0:03:04.98,Default,,0000,0000,0000,,Оларда қызыл бұршақ пастасы да бар.
Dialogue: 0,0:03:10.32,0:03:13.52,Default,,0000,0000,0000,,Ақан Жіп жоқ.
Dialogue: 0,0:03:10.32,0:03:13.52,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:03:15.82,0:03:17.82,Default,,0000,0000,0000,,Ah~.
Dialogue: 0,0:03:19.83,0:03:22.16,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:03:22.16,0:03:24.50,Default,,0000,0000,0000,,Ah~.
Dialogue: 0,0:03:24.50,0:03:26.50,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:03:26.50,0:03:29.50,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:03:26.50,0:03:29.50,Default,,0000,0000,0000,,Ах, Кагура-сан.
Dialogue: 0,0:03:29.50,0:03:32.84,Default,,0000,0000,0000,,Жоқ, алдыңғы сәтсіздіктен сабақ алыңыз➡
Dialogue: 0,0:03:32.84,0:03:35.68,Default,,0000,0000,0000,,Мен қызыл бұршақ пастасы мен жіп дайындадым.
Dialogue: 0,0:03:35.68,0:03:37.85,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:03:37.85,0:03:39.85,Default,,0000,0000,0000,,Уау! Өте әдемі!
Dialogue: 0,0:03:39.85,0:03:41.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:44.02,0:03:46.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:46.02,0:03:48.86,Default,,0000,0000,0000,,Нанды қалай іледі?
Dialogue: 0,0:03:48.86,0:03:51.03,Default,,0000,0000,0000,,Мен оны жай ғана байлауым керек пе?
Dialogue: 0,0:03:51.03,0:03:55.36,Default,,0000,0000,0000,,Бұл емес пе?
Dialogue: 0,0:03:51.03,0:03:55.36,Default,,0000,0000,0000,,Қармақпен қармақ сияқты.
Dialogue: 0,0:03:55.36,0:03:57.37,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:03:57.37,0:04:00.67,Default,,0000,0000,0000,,(Барлық дыбыс)
Dialogue: 0,0:04:02.64,0:04:10.14,Default,,0000,0000,0000,,(Барлық дыбыс)
Dialogue: 0,0:04:10.14,0:04:13.65,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:04:13.65,0:04:16.99,Default,,0000,0000,0000,,бірақ газ бітті, қабырғаға өре алмаймыз.
Dialogue: 0,0:04:13.65,0:04:16.99,Default,,0000,0000,0000,,Сіз қауіпті жарыс ойнадыңыз ба?
Dialogue: 0,0:04:16.99,0:04:20.32,Default,,0000,0000,0000,,О, жоқ па?
Dialogue: 0,0:04:20.32,0:04:22.66,Default,,0000,0000,0000,,Юкари-чан!
Dialogue: 0,0:04:22.66,0:04:25.66,Default,,0000,0000,0000,,Жеңіске жетсең, мен саған шырын сатып аламын!
Dialogue: 0,0:04:28.33,0:04:30.63,Default,,0000,0000,0000,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:04:28.33,0:04:30.63,Default,,0000,0000,0000,,Шырынды соншалықты жақсы көресіз бе?
Dialogue: 0,0:04:32.67,0:04:37.01,Default,,0000,0000,0000,,Мен оны соншалықты қалаймын ба деп сұрасаңыз, мен оны шынымен қаламаймын ...
Dialogue: 0,0:04:37.01,0:04:39.01,Default,,0000,0000,0000,,Жарайды, сіз бәс тігесіз!
Dialogue: 0,0:04:39.01,0:04:41.34,Default,,0000,0000,0000,,Бұл тиімді!
Dialogue: 0,0:04:39.01,0:04:41.34,Default,,0000,0000,0000,,Бұл шын болса да➡
Dialogue: 0,0:04:41.34,0:04:45.18,Default,,0000,0000,0000,,Олар ақша тауып жатқан жоқ сияқты!
Dialogue: 0,0:04:41.34,0:04:45.18,Default,,0000,0000,0000,,Не, не туралы айтып тұрсың?
Dialogue: 0,0:04:45.18,0:04:47.18,Default,,0000,0000,0000,,Қарапайым тілмен айтқанда.
Dialogue: 0,0:04:47.18,0:04:50.18,Default,,0000,0000,0000,,Осака Келіңіздер.
Dialogue: 0,0:04:47.18,0:04:50.18,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:04:50.18,0:04:52.69,Default,,0000,0000,0000,,Осака Юкичиді шақырайық.
Dialogue: 0,0:04:52.69,0:04:54.69,Default,,0000,0000,0000,,Юкичи мырза?
Dialogue: 0,0:04:54.69,0:04:57.53,Default,,0000,0000,0000,,Юкичи мырза.
Dialogue: 0,0:04:54.69,0:04:57.53,Default,,0000,0000,0000,,Юкичи мырза.
Dialogue: 0,0:04:57.53,0:05:00.96,Default,,0000,0000,0000,,Жеңіске жетсең, Осака қаласын аласың!
Dialogue: 0,0:05:00.96,0:05:02.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:02.96,0:05:05.13,Default,,0000,0000,0000,,Мен шынымен түсінбеймін, бірақ ағып кетсін.
Dialogue: 0,0:05:05.13,0:05:07.47,Default,,0000,0000,0000,,Жеңіс!
Dialogue: 0,0:05:07.47,0:05:09.47,Default,,0000,0000,0000,,Оны Осакадан алыңыз!
Dialogue: 0,0:05:09.47,0:05:12.14,Default,,0000,0000,0000,,Мен оны алдым.
Dialogue: 0,0:05:12.14,0:05:16.48,Default,,0000,0000,0000,,Алайда, көп ұзамай Осака Нямоноға кетті.
Dialogue: 0,0:05:16.48,0:05:19.31,Default,,0000,0000,0000,,Сау болыңыз.
Dialogue: 0,0:05:19.31,0:05:21.32,Default,,0000,0000,0000,,Сау болыңыз.
Dialogue: 0,0:05:21.32,0:05:27.99,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:27.99,0:05:30.16,Default,,0000,0000,0000,,Сіз жалғыз болуыңыз керек! ?
Dialogue: 0,0:05:30.16,0:05:32.66,Default,,0000,0000,0000,,Нені айтасыз?
Dialogue: 0,0:05:35.66,0:05:38.50,Default,,0000,0000,0000,,Жарайды, ертең спорт мерекесі!
Dialogue: 0,0:05:38.50,0:05:40.50,Default,,0000,0000,0000,,Уа, жанып тұр!
Dialogue: 0,0:05:40.50,0:05:43.67,Default,,0000,0000,0000,,О, жаттығу
Dialogue: 0,0:05:40.50,0:05:43.67,Default,,0000,0000,0000,,Маған қалдырыңыз!
Dialogue: 0,0:05:43.67,0:05:45.67,Default,,0000,0000,0000,,Мен оны асыға күтемін. Хохо!
Dialogue: 0,0:05:45.67,0:05:48.51,Default,,0000,0000,0000,,Жану, жану!
Dialogue: 0,0:05:45.67,0:05:48.51,Default,,0000,0000,0000,,Осы жылы орындаймыз!
Dialogue: 0,0:05:48.51,0:05:51.35,Default,,0000,0000,0000,,Жану жақсы, бірақ
Dialogue: 0,0:05:48.51,0:05:51.35,Default,,0000,0000,0000,,Маған да көмектесіңізші.
Dialogue: 0,0:05:51.35,0:05:53.85,Default,,0000,0000,0000,,Мұны бәріміз бірге орындауымыз керек
Dialogue: 0,0:05:51.35,0:05:53.85,Default,,0000,0000,0000,,Сіз оны уақытында орындамайсыз.
Dialogue: 0,0:05:53.85,0:05:56.85,Default,,0000,0000,0000,,О, шатыр!
Dialogue: 0,0:05:53.85,0:05:56.85,Default,,0000,0000,0000,,Шатыр шатыр~!
Dialogue: 0,0:05:56.85,0:05:58.85,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:05:58.85,0:06:00.79,Default,,0000,0000,0000,,Мен не істеймін?
Dialogue: 0,0:06:00.79,0:06:02.79,Default,,0000,0000,0000,,Томо-чанның аяғы ➡
Dialogue: 0,0:06:02.79,0:06:05.13,Default,,0000,0000,0000,,Кагура-сан
Dialogue: 0,0:06:02.79,0:06:05.13,Default,,0000,0000,0000,,Осыны ұстаңыз.
Dialogue: 0,0:06:05.13,0:06:07.30,Default,,0000,0000,0000,,Жарайды, кеттік!
Dialogue: 0,0:06:05.13,0:06:07.30,Default,,0000,0000,0000,,Мен жеңілмеймін!
Dialogue: 0,0:06:07.30,0:06:09.96,Default,,0000,0000,0000,,Жарайды, орнымыздан тұрайық.
Dialogue: 0,0:06:09.96,0:06:12.47,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:06:09.96,0:06:12.47,Default,,0000,0000,0000,,Дон-дон-дон!
Dialogue: 0,0:06:12.47,0:06:14.47,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:06:12.47,0:06:14.47,Default,,0000,0000,0000,,Бум!
Dialogue: 0,0:06:14.47,0:06:17.31,Default,,0000,0000,0000,,Сіз мұны істейсіз бе?
Dialogue: 0,0:06:14.47,0:06:17.31,Default,,0000,0000,0000,,Эй, ойнама!
Dialogue: 0,0:06:17.31,0:06:20.14,Default,,0000,0000,0000,,Шабуыл!
Dialogue: 0,0:06:17.31,0:06:20.14,Default,,0000,0000,0000,,Хэхе!
Dialogue: 0,0:06:20.14,0:06:22.31,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:06:20.14,0:06:22.31,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:06:20.14,0:06:22.31,Default,,0000,0000,0000,,Уау! Ах!
Dialogue: 0,0:06:22.31,0:06:24.31,Default,,0000,0000,0000,,Ой, ой!
Dialogue: 0,0:06:24.31,0:06:26.65,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:06:26.65,0:06:28.65,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:06:38.49,0:06:42.50,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:06:38.49,0:06:42.50,Default,,0000,0000,0000,,Мен мұны жасадым деп ойладым, бірақ...
Dialogue: 0,0:06:42.50,0:06:44.50,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:06:46.50,0:06:49.50,Default,,0000,0000,0000,,Кешіріңіз, мен қалжыңдадым...
Dialogue: 0,0:06:49.50,0:06:53.01,Default,,0000,0000,0000,,Ах~ Кагура қорқады!
Dialogue: 0,0:06:53.01,0:06:56.18,Default,,0000,0000,0000,,Мен бұздым!
Dialogue: 0,0:06:56.18,0:06:58.35,Default,,0000,0000,0000,,Барлығымыз көп жұмыс жасадық➡
Dialogue: 0,0:06:58.35,0:07:01.45,Default,,0000,0000,0000,,Кагура бұзды!
Dialogue: 0,0:07:01.45,0:07:03.45,Default,,0000,0000,0000,,Ха...
Dialogue: 0,0:07:06.62,0:07:08.79,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:07:08.79,0:07:11.13,Default,,0000,0000,0000,,Қанға боялған жерде жатқан Курису Макисе және
Dialogue: 0,0:07:11.13,0:07:14.13,Default,,0000,0000,0000,,Мен орта мектепте оқып жүргенде бір сыныптасымның —
Dialogue: 0,0:07:14.13,0:07:17.63,Default,,0000,0000,0000,,Чиё-чан, кешіріңіз.
Dialogue: 0,0:07:17.63,0:07:19.97,Default,,0000,0000,0000,,Бәріміз мұны істедік...
Dialogue: 0,0:07:19.97,0:07:22.64,Default,,0000,0000,0000,,Иә, жоқ, солай...
Dialogue: 0,0:07:22.64,0:07:25.64,Default,,0000,0000,0000,,Неліктен мен➡
Dialogue: 0,0:07:25.64,0:07:27.64,Default,,0000,0000,0000,,Осылай дөрекі ме деп ойлаймын.
Dialogue: 0,0:07:27.64,0:07:31.14,Default,,0000,0000,0000,,Қалғанын өзім істеймін.
Dialogue: 0,0:07:35.15,0:07:37.32,Default,,0000,0000,0000,,Tsk, сіз қателесесіз!
Dialogue: 0,0:07:37.32,0:07:41.82,Default,,0000,0000,0000,,Міне, «Мен даналықта жаманмын».
Dialogue: 0,0:07:37.32,0:07:41.82,Default,,0000,0000,0000,,Оны маған беріңіз!
Dialogue: 0,0:07:41.82,0:07:44.33,Default,,0000,0000,0000,,Кейде байсалды болмаңыз!
Dialogue: 0,0:07:44.33,0:07:46.33,Default,,0000,0000,0000,,Кагура мырза.
Dialogue: 0,0:07:44.33,0:07:46.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:46.33,0:07:48.50,Default,,0000,0000,0000,,Бәріміз орындайық.
Dialogue: 0,0:07:48.50,0:07:50.83,Default,,0000,0000,0000,,Дайындық қызықты болуы керек.
Dialogue: 0,0:07:50.83,0:07:53.17,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:07:53.17,0:07:55.17,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:07:55.17,0:07:57.67,Default,,0000,0000,0000,,Жарайды, жасайық.
Dialogue: 0,0:07:55.17,0:07:57.67,Default,,0000,0000,0000,,Жасайық!
Dialogue: 0,0:07:57.67,0:07:59.67,Default,,0000,0000,0000,,Жарайды, жасайық!
Dialogue: 0,0:08:03.44,0:08:05.45,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,0:08:05.45,0:08:18.29,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:18.29,0:08:20.80,Default,,0000,0000,0000,,Хаха.
Dialogue: 0,0:08:20.80,0:08:23.30,Default,,0000,0000,0000,,Уряуряурия~!
Dialogue: 0,0:08:20.80,0:08:23.30,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:23.30,0:08:26.30,Default,,0000,0000,0000,,(жылжымалы құбырлардың дыбысы)
Dialogue: 0,0:08:29.30,0:08:31.30,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:36.81,0:08:38.81,Default,,0000,0000,0000,,Мм...!
Dialogue: 0,0:08:38.81,0:08:40.98,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:40.98,0:08:43.65,Default,,0000,0000,0000,,Иә, жақсы.
Dialogue: 0,0:08:43.65,0:08:45.65,Default,,0000,0000,0000,,Жарайды, сен мені мазалайсың.
Dialogue: 0,0:08:48.82,0:08:50.83,Default,,0000,0000,0000,,А, қарным ашты.
Dialogue: 0,0:08:50.83,0:08:53.66,Default,,0000,0000,0000,,Мен бүгін артық ұйықтадым.
Dialogue: 0,0:08:50.83,0:08:53.66,Default,,0000,0000,0000,,Себебі таңғы ас іше алмадым.
Dialogue: 0,0:08:53.66,0:08:55.66,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:08:55.66,0:08:59.50,Default,,0000,0000,0000,,Я~
Dialogue: 0,0:08:55.66,0:08:59.50,Default,,0000,0000,0000,,Катсудон жиынтығы Собаның үлкен порциясы.
Dialogue: 0,0:08:59.50,0:09:01.44,Default,,0000,0000,0000,,Сіз салмақ қосасыз.
Dialogue: 0,0:09:01.44,0:09:03.44,Default,,0000,0000,0000,,Жарайды Жарайды.
Dialogue: 0,0:09:03.44,0:09:07.28,Default,,0000,0000,0000,,Қанша жесем де
Dialogue: 0,0:09:03.44,0:09:07.28,Default,,0000,0000,0000,,Мен салмақ қоспайтын түріммін.
Dialogue: 0,0:09:07.28,0:09:11.78,Default,,0000,0000,0000,,Мен мүлде тамақтанбағанды жөн көремін
Dialogue: 0,0:09:07.28,0:09:11.78,Default,,0000,0000,0000,,Бұл жақсы емес, өйткені қуат шықпайды.
Dialogue: 0,0:09:14.45,0:09:16.45,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:09:16.45,0:09:18.79,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:09:16.45,0:09:18.79,Default,,0000,0000,0000,,Маған 100 тостаған катсудон жеуге рұқсат етіңіз!
Dialogue: 0,0:09:18.79,0:09:20.79,Default,,0000,0000,0000,,Неге сонша ашуланасың?
Dialogue: 0,0:09:20.79,0:09:22.79,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:09:22.79,0:09:26.29,Default,,0000,0000,0000,,Маған ұнайды
Dialogue: 0,0:09:22.79,0:09:26.29,Default,,0000,0000,0000,,Сен-сан, мен оны жей алмаймын.
Dialogue: 0,0:09:26.29,0:09:29.80,Default,,0000,0000,0000,,Иә, көп пе?
Dialogue: 0,0:09:29.80,0:09:31.80,Default,,0000,0000,0000,,Оның жартысы….
Dialogue: 0,0:09:31.80,0:09:35.30,Default,,0000,0000,0000,,Ішім 1/3 болса да ісіп кетті.
Dialogue: 0,0:09:35.30,0:09:37.31,Default,,0000,0000,0000,,Бұл сізді бақытты етеді!
Dialogue: 0,0:09:37.31,0:09:39.51,Default,,0000,0000,0000,,Неге сонша ашуланасың?
Dialogue: 0,0:09:42.81,0:09:46.81,Default,,0000,0000,0000,,Жарайды, бірге жасайық!
Dialogue: 0,0:09:42.81,0:09:46.81,Default,,0000,0000,0000,,О!
Dialogue: 0,0:09:46.81,0:09:49.98,Default,,0000,0000,0000,,Жауынгер дірілдеп тұр!
Dialogue: 0,0:09:49.98,0:09:52.82,Default,,0000,0000,0000,,Нан жеу сайысы.
Dialogue: 0,0:09:52.82,0:09:54.82,Default,,0000,0000,0000,,Сәттілік.
Dialogue: 0,0:09:54.82,0:09:57.16,Default,,0000,0000,0000,,Біз әртүрлі сыныпта болсақ та, мен сені қолдаймын!
Dialogue: 0,0:09:57.16,0:09:59.33,Default,,0000,0000,0000,,А, рахмет.
Dialogue: 0,0:09:59.33,0:10:04.03,Default,,0000,0000,0000,,Бірақ біз неге әлі күнге дейін гүл шоқтарын киеміз?
Dialogue: 0,0:10:07.50,0:10:09.67,Default,,0000,0000,0000,,Банзай!
Dialogue: 0,0:10:07.50,0:10:09.67,Default,,0000,0000,0000,,Гах! ?
Dialogue: 0,0:10:09.67,0:10:11.84,Default,,0000,0000,0000,,Банзай!
Dialogue: 0,0:10:09.67,0:10:11.84,Default,,0000,0000,0000,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:10:11.84,0:10:13.84,Default,,0000,0000,0000,,Банзай!
Dialogue: 0,0:10:11.84,0:10:13.84,Default,,0000,0000,0000,,Ах!?
Dialogue: 0,0:10:13.84,0:10:15.84,Default,,0000,0000,0000,,Банзай!
Dialogue: 0,0:10:13.84,0:10:15.84,Default,,0000,0000,0000,,Уау! ?
Dialogue: 0,0:10:15.84,0:10:19.64,Default,,0000,0000,0000,,Банзай!
Dialogue: 0,0:10:22.02,0:10:24.02,Default,,0000,0000,0000,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:10:22.02,0:10:24.02,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:10:24.02,0:10:26.85,Default,,0000,0000,0000,,Менің ойымша➡
Dialogue: 0,0:10:26.85,0:10:29.05,Default,,0000,0000,0000,,Мен оны жақсы көремін.
Dialogue: 0,0:10:31.53,0:10:34.13,Default,,0000,0000,0000,,Маған ұнайды.
Dialogue: 0,0:10:36.20,0:10:39.20,Default,,0000,0000,0000,,Сіз.
Dialogue: 0,0:10:36.20,0:10:39.20,Default,,0000,0000,0000,,(Құстардың сайрауы)
Dialogue: 0,0:10:39.20,0:10:41.20,Default,,0000,0000,0000,,Сіз! ?
Dialogue: 0,0:10:43.87,0:10:45.87,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:10:45.87,0:10:47.88,Default,,0000,0000,0000,,(Қолдау дауыстары)
Dialogue: 0,0:10:47.88,0:10:55.38,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:10:55.38,0:10:57.72,Default,,0000,0000,0000,,Гю~!
Dialogue: 0,0:10:57.72,0:11:02.32,Default,,0000,0000,0000,,Хахаха хахаха хахаха!
Dialogue: 0,0:11:02.32,0:11:05.83,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:11:05.83,0:11:09.33,Default,,0000,0000,0000,,📢Келесі - костюмдер сайысы.
Dialogue: 0,0:11:09.33,0:11:13.17,Default,,0000,0000,0000,,Киім сайысы дегеніміз не?
Dialogue: 0,0:11:09.33,0:11:13.17,Default,,0000,0000,0000,,Бұл Томо мен Чио-чан жұбы, солай ма?
Dialogue: 0,0:11:13.17,0:11:15.17,Default,,0000,0000,0000,,Сіз қандай бетперде киіп жүрсіз?
Dialogue: 0,0:11:15.17,0:11:17.67,Default,,0000,0000,0000,,Әйел полиция қызметкері?
Dialogue: 0,0:11:17.67,0:11:20.34,Default,,0000,0000,0000,,қаңтар қаңтар қаңтар!
Dialogue: 0,0:11:20.34,0:11:22.34,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:11:22.34,0:11:25.18,Default,,0000,0000,0000,,О, ICPO болуды мақсат еткен әйел күткендей!
Dialogue: 0,0:11:25.18,0:11:28.18,Default,,0000,0000,0000,,Чио-чан ше?
Dialogue: 0,0:11:25.18,0:11:28.18,Default,,0000,0000,0000,,Сәлем Ане-сан.
Dialogue: 0,0:11:28.18,0:11:30.18,Default,,0000,0000,0000,,Көмегің үшін рахмет.
Dialogue: 0,0:11:30.18,0:11:32.85,Default,,0000,0000,0000,,Чийосуке кінәлі.
Dialogue: 0,0:11:30.18,0:11:32.85,Default,,0000,0000,0000,,Гах! ?
Dialogue: 0,0:11:32.85,0:11:35.19,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:11:35.19,0:11:38.36,Default,,0000,0000,0000,,Иә, рұқсат етіңіз, жол ашыңыз!
Dialogue: 0,0:11:38.36,0:11:40.36,Default,,0000,0000,0000,,Мазасыз және алаңдатады!
Dialogue: 0,0:11:40.36,0:11:44.20,Default,,0000,0000,0000,,Жолды ашыңыз
Dialogue: 0,0:11:40.36,0:11:44.20,Default,,0000,0000,0000,,Қараңызшы, бұл жолдан шығып кетті!
Dialogue: 0,0:11:44.20,0:11:46.20,Default,,0000,0000,0000,,Сіз кедергісіз! Эй!
Dialogue: 0,0:11:46.20,0:11:48.20,Default,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,0:11:48.20,0:11:50.20,Default,,0000,0000,0000,,Мазасыз Мазасыз Мазасыз Мазасыз!
Dialogue: 0,0:11:50.20,0:11:53.21,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:11:53.21,0:11:56.54,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:11:53.21,0:11:56.54,Default,,0000,0000,0000,,Сіз қандай қылмыс жасадыңыз?
Dialogue: 0,0:11:56.54,0:11:59.21,Default,,0000,0000,0000,,Әй, жолыңды аш.
Dialogue: 0,0:11:56.54,0:11:59.21,Default,,0000,0000,0000,,Сіз шаршаған болуыңыз керек!
Dialogue: 0,0:11:59.21,0:12:01.65,Default,,0000,0000,0000,,Жарайды, бірінші нөмір!
Dialogue: 0,0:11:59.21,0:12:01.65,Default,,0000,0000,0000,,Уа, мен жеңдім!
Dialogue: 0,0:12:01.65,0:12:03.82,Default,,0000,0000,0000,,📢Келесі нан жеу сайысы.
Dialogue: 0,0:12:03.82,0:12:10.83,Default,,0000,0000,0000,,Сайысқа қатысушылар кіреберіс қақпасының алдында болуы керек.
Dialogue: 0,0:12:03.82,0:12:10.83,Default,,0000,0000,0000,,Жиналыңыз.
Dialogue: 0,0:12:10.83,0:12:13.16,Default,,0000,0000,0000,,Енді сіздің кезегіңіз.
Dialogue: 0,0:12:13.16,0:12:17.66,Default,,0000,0000,0000,,(Қолдау дауыстары)
Dialogue: 0,0:12:19.67,0:12:21.67,Default,,0000,0000,0000,,Орналасқан жеріне қатысты.
Dialogue: 0,0:12:21.67,0:12:24.51,Default,,0000,0000,0000,,📢Осы нан жеу сайысында➡
Dialogue: 0,0:12:24.51,0:12:26.51,Default,,0000,0000,0000,,1 курстан бастап➡
Dialogue: 0,0:12:26.51,0:12:29.18,Default,,0000,0000,0000,,Анпан Кілегей нан Тосап нан➡
Dialogue: 0,0:12:29.18,0:12:32.18,Default,,0000,0000,0000,,Карри нан Қауын нан ілінді.
Dialogue: 0,0:12:29.18,0:12:32.18,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:12:32.18,0:12:35.35,Default,,0000,0000,0000,,📢Олардың кез келгенін пайдалана аласыз.
Dialogue: 0,0:12:35.35,0:12:37.35,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? ?
Dialogue: 0,0:12:37.35,0:12:41.02,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:12:37.35,0:12:41.02,Default,,0000,0000,0000,,Кремді карри джемі.
Dialogue: 0,0:12:41.02,0:12:44.02,Default,,0000,0000,0000,,Қауын? Аа, аа….
Dialogue: 0,0:12:44.02,0:12:46.69,Default,,0000,0000,0000,,Ух, уф...
Dialogue: 0,0:12:46.69,0:12:49.20,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:12:49.20,0:12:52.87,Default,,0000,0000,0000,,《Ақан мені
Dialogue: 0,0:12:49.20,0:12:52.87,Default,,0000,0000,0000,,Мен тек қызыл бұршақ пастасымен жаттығамын.
Dialogue: 0,0:12:52.87,0:12:54.87,Default,,0000,0000,0000,,Бірақ дәл сондай тәтті болса➡
Dialogue: 0,0:12:54.87,0:12:57.87,Default,,0000,0000,0000,,Тосап нан немесе кілегей нан.
Dialogue: 0,0:12:57.87,0:13:00.81,Default,,0000,0000,0000,,Айтпақшы, неліктен кілегей нан?
Dialogue: 0,0:13:00.81,0:13:03.14,Default,,0000,0000,0000,,Ол сондай үлпілдек, солай емес пе?
Dialogue: 0,0:13:03.14,0:13:05.81,Default,,0000,0000,0000,,Дөңгелек болса да жарамайды ма?
Dialogue: 0,0:13:05.81,0:13:08.98,Default,,0000,0000,0000,,Иә, бір шеттетілген адам бар.
Dialogue: 0,0:13:08.98,0:13:11.65,Default,,0000,0000,0000,,Карри наны қуырылған.
Dialogue: 0,0:13:11.65,0:13:15.16,Default,,0000,0000,0000,,Мен оны шынымен қуыруым керек.
Dialogue: 0,0:13:11.65,0:13:15.16,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:13:15.16,0:13:17.16,Default,,0000,0000,0000,,Шонен.
Dialogue: 0,0:13:17.16,0:13:19.49,Default,,0000,0000,0000,,Қызыл бұршақ пастасы дөңгелек ➡
Dialogue: 0,0:13:19.49,0:13:21.66,Default,,0000,0000,0000,,Кілегей нан үлпілдек➡
Dialogue: 0,0:13:21.66,0:13:24.00,Default,,0000,0000,0000,,Тосапты тоқаштардың іші ұсақталған.
Dialogue: 0,0:13:24.00,0:13:27.00,Default,,0000,0000,0000,,Ах~ Ах~ түсінбедім》
Dialogue: 0,0:13:32.01,0:13:34.01,Default,,0000,0000,0000,,Мен соңғы орынға шықтым.
Dialogue: 0,0:13:34.01,0:13:36.68,Default,,0000,0000,0000,,(Насиро) Рей! (Сузуя) Ол қазір Джузо~
Dialogue: 0,0:13:36.68,0:13:38.68,Default,,0000,0000,0000,,Мен қауыннан нан жасадым.
Dialogue: 0,0:13:38.68,0:13:41.68,Default,,0000,0000,0000,,(Насиро) Рей! (Сузуя) Ол қазір Джузо~
Dialogue: 0,0:13:41.68,0:13:43.68,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:13:47.52,0:13:51.69,Default,,0000,0000,0000,,Оңға оңға солға алдыңғы төменге секіру.
Dialogue: 0,0:13:51.69,0:13:53.69,Default,,0000,0000,0000,,А, күнтізбе~.
Dialogue: 0,0:13:53.69,0:13:56.20,Default,,0000,0000,0000,,О.
Dialogue: 0,0:13:53.69,0:13:56.20,Default,,0000,0000,0000,,Күнтізбе Черлидинг ойнайық.
Dialogue: 0,0:13:56.20,0:13:58.37,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:56.20,0:13:58.37,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:13:58.37,0:14:01.97,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:13:58.37,0:14:01.97,Default,,0000,0000,0000,,Өте сүйкімді.
Dialogue: 0,0:14:01.97,0:14:04.47,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:14:01.97,0:14:04.47,Default,,0000,0000,0000,,Чио-чан.
Dialogue: 0,0:14:04.47,0:14:07.47,Default,,0000,0000,0000,,Оңға оңға солға.
Dialogue: 0,0:14:07.47,0:14:09.81,Default,,0000,0000,0000,,Алдыңғы төменгі секіру.
Dialogue: 0,0:14:09.81,0:14:12.31,Default,,0000,0000,0000,,Эххехе!
Dialogue: 0,0:14:09.81,0:14:12.31,Default,,0000,0000,0000,,Өте сүйкімді.
Dialogue: 0,0:14:12.31,0:14:14.65,Default,,0000,0000,0000,,Шпион табылды!
Dialogue: 0,0:14:14.65,0:14:17.99,Default,,0000,0000,0000,,Неліктен басқа сыныптағы адамдар мұнда!
Dialogue: 0,0:14:17.99,0:14:19.99,Default,,0000,0000,0000,,Әй, Гакуран.
Dialogue: 0,0:14:19.99,0:14:22.82,Default,,0000,0000,0000,,Иә, мен және Кагура➡
Dialogue: 0,0:14:22.82,0:14:25.16,Default,,0000,0000,0000,,Сакаки-чан студент!
Dialogue: 0,0:14:25.16,0:14:29.66,Default,,0000,0000,0000,,Ха!?
Dialogue: 0,0:14:25.16,0:14:29.66,Default,,0000,0000,0000,,Сакаки-чан студент!
Dialogue: 0,0:14:29.66,0:14:33.83,Default,,0000,0000,0000,,Сакаки-чан студент!
Dialogue: 0,0:14:29.66,0:14:33.83,Default,,0000,0000,0000,,күрсіну….
Dialogue: 0,0:14:33.83,0:14:37.67,Default,,0000,0000,0000,,Э? Тұр... не?
Dialogue: 0,0:14:33.83,0:14:37.67,Default,,0000,0000,0000,,Сакаки-чан студент!
Dialogue: 0,0:14:37.67,0:14:40.67,Default,,0000,0000,0000,,Хо, ха, қараңдар!
Dialogue: 0,0:14:40.67,0:14:43.07,Default,,0000,0000,0000,,Қандай керемет?
Dialogue: 0,0:14:40.67,0:14:43.07,Default,,0000,0000,0000,,Қайда! ?
Dialogue: 0,0:14:47.35,0:14:50.55,Default,,0000,0000,0000,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:14:57.02,0:15:00.32,Default,,0000,0000,0000,,Ха ха ха….
Dialogue: 0,0:15:03.96,0:15:05.96,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:15:07.97,0:15:10.97,Default,,0000,0000,0000,,Урааа!
Dialogue: 0,0:15:10.97,0:15:13.31,Default,,0000,0000,0000,,Урааа!
Dialogue: 0,0:15:13.31,0:15:16.31,Default,,0000,0000,0000,,Жарайсың, Жарайсың!
Dialogue: 0,0:15:18.31,0:15:20.31,Default,,0000,0000,0000,,Соңында реле бар.
Dialogue: 0,0:15:20.31,0:15:22.82,Default,,0000,0000,0000,,Сыныптық сайыс «барлығы» эстафетасы!
Dialogue: 0,0:15:22.82,0:15:25.32,Default,,0000,0000,0000,,Келіңдер, келіңдер!
Dialogue: 0,0:15:25.32,0:15:27.66,Default,,0000,0000,0000,,Қатты қобалжып, құлап қалмаңыз.
Dialogue: 0,0:15:27.66,0:15:30.32,Default,,0000,0000,0000,,Кел, шарықтау шегі!
Dialogue: 0,0:15:30.32,0:15:32.33,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:32.33,0:15:35.00,Default,,0000,0000,0000,,Гах Мен бар күшімді салуым керек Мен барынша тырысуым керек.
Dialogue: 0,0:15:35.00,0:15:37.00,Default,,0000,0000,0000,,Бірақ...➡
Dialogue: 0,0:15:37.00,0:15:40.67,Default,,0000,0000,0000,,Сондай-ақ, мен әркімнің аяғымын
Dialogue: 0,0:15:37.00,0:15:40.67,Default,,0000,0000,0000,,Егер сіз оны тартсаңыз...
Dialogue: 0,0:15:40.67,0:15:42.67,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:15:40.67,0:15:42.67,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:15:42.67,0:15:45.34,Default,,0000,0000,0000,,Сакаки мырза….
Dialogue: 0,0:15:42.67,0:15:45.34,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:15:45.34,0:15:49.01,Default,,0000,0000,0000,,Иә, менің сыныбымда
Dialogue: 0,0:15:45.34,0:15:49.01,Default,,0000,0000,0000,,Сакаки мен Кагура осында.
Dialogue: 0,0:15:49.01,0:15:51.51,Default,,0000,0000,0000,,Чио-чан, демал.
Dialogue: 0,0:15:51.51,0:15:53.85,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:15:51.51,0:15:53.85,Default,,0000,0000,0000,,Мен де осындамын!
Dialogue: 0,0:15:53.85,0:15:55.85,Default,,0000,0000,0000,,Сіз ше?
Dialogue: 0,0:15:55.85,0:15:58.69,Default,,0000,0000,0000,,Бұл не? Қараңызшы, бұл бірінші орында!
Dialogue: 0,0:15:58.69,0:16:00.96,Default,,0000,0000,0000,,Бұл сенімділік қайдан келеді?
Dialogue: 0,0:16:00.96,0:16:03.79,Default,,0000,0000,0000,,Чиёчан
Dialogue: 0,0:16:00.96,0:16:03.79,Default,,0000,0000,0000,,Иә, мен сізге стратегияны айтып беремін.
Dialogue: 0,0:16:03.79,0:16:05.79,Default,,0000,0000,0000,,Жақсы стратегия?
Dialogue: 0,0:16:05.79,0:16:07.80,Default,,0000,0000,0000,,Хэхехехе!
Dialogue: 0,0:16:07.80,0:16:09.80,Default,,0000,0000,0000,,Чакин!
Dialogue: 0,0:16:09.80,0:16:13.30,Default,,0000,0000,0000,,Қолымды осылай жайып жүгірсем
Dialogue: 0,0:16:09.80,0:16:13.30,Default,,0000,0000,0000,,Оны басып озу қиын.
Dialogue: 0,0:16:13.30,0:16:15.97,Default,,0000,0000,0000,,Хи хи хи.
Dialogue: 0,0:16:15.97,0:16:18.81,Default,,0000,0000,0000,,Хехе хахаха.
Dialogue: 0,0:16:15.97,0:16:18.81,Default,,0000,0000,0000,,Демон Көзі: Тағдырды анықтау.
Dialogue: 0,0:16:18.81,0:16:21.98,Default,,0000,0000,0000,,Мен шыдай алмаймын.
Dialogue: 0,0:16:21.98,0:16:24.14,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,0:16:24.14,0:16:26.15,Default,,0000,0000,0000,,📢Соңында барлығы қатысады➡
Dialogue: 0,0:16:26.15,0:16:29.98,Default,,0000,0000,0000,,Сыныптық жарыс 4000 метрге эстафета.
Dialogue: 0,0:16:29.98,0:16:31.99,Default,,0000,0000,0000,,Ичибан!
Dialogue: 0,0:16:31.99,0:16:34.49,Default,,0000,0000,0000,,Бірінші жүгірушіден күтулер Күту!
Dialogue: 0,0:16:34.49,0:16:37.49,Default,,0000,0000,0000,,Үлкен үміт ~ Маңызды Маңызды!
Dialogue: 0,0:16:37.49,0:16:39.99,Default,,0000,0000,0000,,О~ Мен жеңілмеймін~!
Dialogue: 0,0:16:39.99,0:16:43.66,Default,,0000,0000,0000,,Күнтізбе ~ Бірінші жүлде
Dialogue: 0,0:16:39.99,0:16:43.66,Default,,0000,0000,0000,,Мен сізге эстафетаны беремін!
Dialogue: 0,0:16:43.66,0:16:48.00,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:16:43.66,0:16:48.00,Default,,0000,0000,0000,,Бастамас бұрын менің энергиям таусылатын сияқты.
Dialogue: 0,0:16:48.00,0:16:51.01,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:16:51.01,0:16:53.34,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:51.01,0:16:53.34,Default,,0000,0000,0000,,Жақсы бастама.
Dialogue: 0,0:16:53.34,0:16:55.68,Default,,0000,0000,0000,,Оряоря Оряоря!
Dialogue: 0,0:16:55.68,0:16:58.01,Default,,0000,0000,0000,,Керемет! Бұл шың!
Dialogue: 0,0:16:58.01,0:16:59.95,Default,,0000,0000,0000,,Жарайды, Сатоси, жүр!
Dialogue: 0,0:16:59.95,0:17:01.95,Default,,0000,0000,0000,,Мен де ұтыла алмаймын.
Dialogue: 0,0:17:01.95,0:17:03.95,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:17:03.95,0:17:06.45,Default,,0000,0000,0000,,Ах~ Ах~!
Dialogue: 0,0:17:06.45,0:17:09.79,Default,,0000,0000,0000,,Сондықтан сіз старт алдында тым көп шу шығардыңыз!
Dialogue: 0,0:17:06.45,0:17:09.79,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:09.79,0:17:12.46,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:17:09.79,0:17:12.46,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:17:12.46,0:17:15.30,Default,,0000,0000,0000,,Күнтізбе~ Орындау~.
Dialogue: 0,0:17:15.30,0:17:18.10,Default,,0000,0000,0000,,Диета!
Dialogue: 0,0:17:15.30,0:17:18.10,Default,,0000,0000,0000,,Шулы~ Идиот!
Dialogue: 0,0:17:21.47,0:17:23.57,Default,,0000,0000,0000,,өту~ Жарып өту~!
Dialogue: 0,0:17:26.64,0:17:29.34,Default,,0000,0000,0000,,Эй, сен жалықтысың ғой!
Dialogue: 0,0:17:32.15,0:17:34.98,Default,,0000,0000,0000,,А, сен не істеп жатырсың?
Dialogue: 0,0:17:34.98,0:17:37.82,Default,,0000,0000,0000,,Қараңыз, сол жерден қашыңыз.
Dialogue: 0,0:17:34.98,0:17:37.82,Default,,0000,0000,0000,,Эй, эй, эй!
Dialogue: 0,0:17:37.82,0:17:39.99,Default,,0000,0000,0000,,Жарайсыңдар!
Dialogue: 0,0:17:37.82,0:17:39.99,Default,,0000,0000,0000,,Осака!
Dialogue: 0,0:17:39.99,0:17:42.49,Default,,0000,0000,0000,,Жақсы, міне келдік! Шакин!
Dialogue: 0,0:17:42.49,0:17:47.83,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:47.83,0:17:50.00,Default,,0000,0000,0000,,Шығарылып жатыр Шығарып жатыр!
Dialogue: 0,0:17:50.00,0:17:52.33,Default,,0000,0000,0000,,Күрсін!
Dialogue: 0,0:17:52.33,0:17:55.50,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:17:52.33,0:17:55.50,Default,,0000,0000,0000,,Өте жылдам.
Dialogue: 0,0:17:52.33,0:17:55.50,Default,,0000,0000,0000,,Күтілгендей.
Dialogue: 0,0:17:55.50,0:17:57.67,Default,,0000,0000,0000,,Хахаха!
Dialogue: 0,0:17:57.67,0:18:01.11,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:17:57.67,0:18:01.11,Default,,0000,0000,0000,,Тағы бір адам қалды!
Dialogue: 0,0:17:57.67,0:18:01.11,Default,,0000,0000,0000,,Жоғарғы.
Dialogue: 0,0:18:01.11,0:18:04.61,Default,,0000,0000,0000,,Кагура~ Тез
Dialogue: 0,0:18:01.11,0:18:04.61,Default,,0000,0000,0000,,Сен мені жұдырықтайсың ба?
Dialogue: 0,0:18:04.61,0:18:06.81,Default,,0000,0000,0000,,Хахахаха!
Dialogue: 0,0:18:10.78,0:18:14.46,Default,,0000,0000,0000,,Чио-чан! Хаха….
Dialogue: 0,0:18:14.46,0:18:16.96,Default,,0000,0000,0000,,Му!
Dialogue: 0,0:18:14.46,0:18:16.96,Default,,0000,0000,0000,,Чио-чан, жүр!
Dialogue: 0,0:18:16.96,0:18:18.96,Default,,0000,0000,0000,,Жоғалтпа!
Dialogue: 0,0:18:16.96,0:18:18.96,Default,,0000,0000,0000,,Жүгіру!
Dialogue: 0,0:18:18.96,0:18:21.96,Default,,0000,0000,0000,,《Мен бұл күні бар күшімді салуым керек➡
Dialogue: 0,0:18:21.96,0:18:24.30,Default,,0000,0000,0000,,Мен әр түнде жүгіріп, жаттығатынмын!
Dialogue: 0,0:18:24.30,0:18:28.30,Default,,0000,0000,0000,,кем дегенде
Dialogue: 0,0:18:24.30,0:18:28.30,Default,,0000,0000,0000,,Сакаки-сан, сенен озып кетуіме жол берме.
Dialogue: 0,0:18:28.30,0:18:30.30,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:30.30,0:18:34.14,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:18:34.14,0:18:36.64,Default,,0000,0000,0000,,《Осындай нәрсе
Dialogue: 0,0:18:34.14,0:18:36.64,Default,,0000,0000,0000,,Мен жаман нәрсе істеп жатқан сияқтымын...》
Dialogue: 0,0:18:36.64,0:18:39.98,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:39.98,0:18:43.48,Default,,0000,0000,0000,,Хахаха! Сіз жаяу жүрсіз бе?
Dialogue: 0,0:18:43.48,0:18:46.82,Default,,0000,0000,0000,,3-топ Сіз жеңгіңіз келмейді, солай ма?
Dialogue: 0,0:18:46.82,0:18:48.82,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:18:48.82,0:18:50.82,Default,,0000,0000,0000,,Әй, қолыңнан келгеннің бәрін істе.
Dialogue: 0,0:18:50.82,0:18:52.83,Default,,0000,0000,0000,,Сәттілік!
Dialogue: 0,0:18:52.83,0:19:01.94,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:01.94,0:19:04.24,Default,,0000,0000,0000,,Кел, Сакаки-сан...!
Dialogue: 0,0:19:07.11,0:19:09.11,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:19:09.11,0:19:11.61,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:19:11.61,0:19:13.95,Default,,0000,0000,0000,,Эй, хаха….
Dialogue: 0,0:19:13.95,0:19:16.45,Default,,0000,0000,0000,,Жақсы жұмыс!
Dialogue: 0,0:19:16.45,0:19:19.95,Default,,0000,0000,0000,,Ха, аа
Dialogue: 0,0:19:16.45,0:19:19.95,Default,,0000,0000,0000,,Бірақ мені көп басып озды.
Dialogue: 0,0:19:19.95,0:19:21.96,Default,,0000,0000,0000,,Жарайды, Сакаки жазылып кетеді.
Dialogue: 0,0:19:21.96,0:19:25.13,Default,,0000,0000,0000,,Дебют
Dialogue: 0,0:19:21.96,0:19:25.13,Default,,0000,0000,0000,,Қалған сыныптар ұлдар мен жеңіл атлетика...
Dialogue: 0,0:19:25.13,0:19:30.80,Default,,0000,0000,0000,,О!
Dialogue: 0,0:19:25.13,0:19:30.80,Default,,0000,0000,0000,,Чиосуке Мынаны қара!
Dialogue: 0,0:19:30.80,0:19:32.80,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:19:32.80,0:19:38.81,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:38.81,0:19:41.81,Default,,0000,0000,0000,,Конверт пе?
Dialogue: 0,0:19:41.81,0:19:43.98,Default,,0000,0000,0000,,Ха ха ха!
Dialogue: 0,0:19:43.98,0:19:45.98,Default,,0000,0000,0000,,Тағы бір рет!
Dialogue: 0,0:19:45.98,0:19:47.98,Default,,0000,0000,0000,,Сакаки-сан, жүр, жүр, жүр!
Dialogue: 0,0:19:47.98,0:19:51.82,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:51.82,0:19:53.82,Default,,0000,0000,0000,,Ха ха ха!
Dialogue: 0,0:19:53.82,0:19:56.49,Default,,0000,0000,0000,,Керемет, мен барлығынан өттім!
Dialogue: 0,0:19:56.49,0:19:59.16,Default,,0000,0000,0000,,Жақсы, Сакаки, ​​1 орын!
Dialogue: 0,0:19:59.16,0:20:02.66,Default,,0000,0000,0000,,Жүр, Сақаки, қалғанын маған қалдыр!
Dialogue: 0,0:20:02.66,0:20:05.83,Default,,0000,0000,0000,,Зәкір – менің сынып жетекшім!
Dialogue: 0,0:20:05.83,0:20:08.00,Default,,0000,0000,0000,,Рая Рая~!
Dialogue: 0,0:20:08.00,0:20:10.34,Default,,0000,0000,0000,,Юкари-чан, қашып кет~!
Dialogue: 0,0:20:08.00,0:20:10.34,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:20:10.34,0:20:12.34,Default,,0000,0000,0000,,Өте тәтті!
Dialogue: 0,0:20:12.34,0:20:14.51,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:20:12.34,0:20:14.51,Default,,0000,0000,0000,,Уау, Нямо-чан өте жылдам!
Dialogue: 0,0:20:14.51,0:20:18.18,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:20:18.18,0:20:22.02,Default,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:20:18.18,0:20:22.02,Default,,0000,0000,0000,,Юкари-сенсэй, барыңды сал!
Dialogue: 0,0:20:22.02,0:20:24.12,Default,,0000,0000,0000,,Юкари Сенсэй~!
Dialogue: 0,0:20:27.35,0:20:29.35,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:27.35,0:20:29.35,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:58.55,0:21:00.49,Default,,0000,0000,0000,,Ах~ Ах~.
Dialogue: 0,0:21:00.49,0:21:02.49,Default,,0000,0000,0000,,Юкари-чанның арқасында
Dialogue: 0,0:21:00.49,0:21:02.49,Default,,0000,0000,0000,,Ол қираған.
Dialogue: 0,0:21:04.49,0:21:06.49,Default,,0000,0000,0000,,Мен шырын іше алмадым.
Dialogue: 0,0:21:06.49,0:21:09.16,Default,,0000,0000,0000,,Сонымен, сіз
Dialogue: 0,0:21:06.49,0:21:09.16,Default,,0000,0000,0000,,Шырынды соншалықты жақсы көресіз бе?
Dialogue: 0,0:21:09.16,0:21:11.67,Default,,0000,0000,0000,,Бірақ қызық болды.
Dialogue: 0,0:21:11.67,0:21:15.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:11.67,0:21:15.00,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:21:15.00,0:21:17.00,Default,,0000,0000,0000,,Өйткені мен соңғы орында болдым.
Dialogue: 0,0:21:17.00,0:21:19.17,Default,,0000,0000,0000,,Мен саған шырын сатып ала алмадым.
Dialogue: 0,0:21:19.17,0:21:21.17,Default,,0000,0000,0000,,Сонымен шырынға тойдым.
Dialogue: 0,0:21:21.17,0:21:23.51,Default,,0000,0000,0000,,Көңілді болды.
Dialogue: 0,0:21:23.51,0:21:25.51,Default,,0000,0000,0000,,Эй, Сакаки-сан.
Dialogue: 0,0:21:23.51,0:21:25.51,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:25.51,0:21:27.85,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:21:27.85,0:21:31.52,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:27.85,0:21:31.52,Default,,0000,0000,0000,,Қараңдаршы, қызық болды.
Dialogue: 0,0:21:31.52,0:21:34.52,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:21:31.52,0:21:34.52,Default,,0000,0000,0000,,Жеңілгенге ашуланудың қажеті жоқ.
Dialogue: 0,0:21:34.52,0:21:36.86,Default,,0000,0000,0000,,Мен жеңілгенге ашуланбаймын.
Dialogue: 0,0:21:36.86,0:21:38.86,Default,,0000,0000,0000,,Не? Сіз жеңілгеніңізге ашуланасыз ба?
Dialogue: 0,0:21:38.86,0:21:41.19,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:21:38.86,0:21:41.19,Default,,0000,0000,0000,,Себебі мен жеңілгенді жек көремін.
Dialogue: 0,0:21:41.19,0:21:46.20,Default,,0000,0000,0000,,Бұл дұрыс емес~ Ах~ Сакаки-сан.
Dialogue: 0,0:21:41.19,0:21:46.20,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:46.20,0:21:49.70,Default,,0000,0000,0000,,Жарайды, қызық болды.
Dialogue: 0,0:21:46.20,0:21:49.70,Default,,0000,0000,0000,,Осымен қалдырайық!
Dialogue: 0,0:21:49.70,0:21:53.40,Default,,0000,0000,0000,,Шынында да
Dialogue: 0,0:21:49.70,0:21:53.40,Default,,0000,0000,0000,,Бұл өте қызық болды!
Dialogue: 0,0:21:54.90,0:22:00.90,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory