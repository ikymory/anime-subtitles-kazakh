Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.83,0:00:07.30,Default,,0,0,0,,Лу Ла Лу Ла Пианино - әлемдік
Dialogue: 0,0:00:07.33,0:00:10.81,Default,,0,0,0,,Арман гүлдеген далада әуен
Dialogue: 0,0:00:10.84,0:00:14.27,Default,,0,0,0,,Сынған сағатқа сену
Dialogue: 0,0:00:14.30,0:00:17.73,Default,,0,0,0,,Уақыт сенің жаныңда кім?
Dialogue: 0,0:00:17.76,0:00:21.10,Default,,0,0,0,,Менің кеудем неге үлкен?
Dialogue: 0,0:00:21.31,0:00:24.72,Default,,0,0,0,,Сіз мейірімді адамды күтесіз бе?
Dialogue: 0,0:00:24.80,0:00:28.29,Default,,0,0,0,,Маған тамаша болашағыңыз туралы айтып беріңіз
Dialogue: 0,0:00:28.32,0:00:28.99,Default,,0,0,0,,Ай
Dialogue: 0,0:00:29.08,0:00:29.84,Default,,0,0,0,,Жарық
Dialogue: 0,0:00:29.96,0:00:31.70,Default,,0,0,0,,Ай сәулесі ұйықтап жатыр
Dialogue: 0,0:00:31.73,0:00:35.27,Default,,0,0,0,,Лу Ла Лу Ла Есте сақтау алмасына
Dialogue: 0,0:00:35.30,0:00:38.64,Default,,0,0,0,,Оянған қыз мені сүйеді
Dialogue: 0,0:00:38.68,0:00:42.19,Default,,0,0,0,,Азаппен жайылған кітапта
Dialogue: 0,0:00:42.22,0:00:45.46,Default,,0,0,0,,Екі қоңырау соғылады
Dialogue: 0,0:00:45.61,0:00:48.90,Default,,0,0,0,,Мен жақсы көретін адам, өйткені мен оны құшақтағым келеді
Dialogue: 0,0:00:49.14,0:00:52.67,Default,,0,0,0,,Енді жылама Қош бол қайғы
Dialogue: 0,0:00:52.69,0:00:56.17,Default,,0,0,0,,Жұмбақ есіктегі жазу
Dialogue: 0,0:00:56.20,0:00:59.61,Default,,0,0,0,,«Сорамими торты»
Dialogue: 0,0:00:59.63,0:01:00.94,Default,,0,0,0,,Ғажайыптар әлемі!
Dialogue: 0,0:01:00.97,0:01:02.69,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:02.72,0:01:04.01,Default,,0,0,0,,Ертегілер елі!
Dialogue: 0,0:01:04.04,0:01:05.68,Default,,0,0,0,,Бұл махаббаттың сиқыры
Dialogue: 0,0:01:05.71,0:01:07.02,Default,,0,0,0,,Махаббат бәрібір!
Dialogue: 0,0:01:07.05,0:01:08.80,Default,,0,0,0,,Күн сайын үлпілдек
Dialogue: 0,0:01:08.83,0:01:12.29,Default,,0,0,0,,Бидайдың азғыруы
Dialogue: 0,0:01:12.32,0:01:13.59,Default,,0,0,0,,Сізге арналған торт!
Dialogue: 0,0:01:13.62,0:01:15.32,Default,,0,0,0,,Бүгін кешке тамақтаныңыз.
Dialogue: 0,0:01:15.34,0:01:16.66,Default,,0,0,0,,Сізге шай!
Dialogue: 0,0:01:16.69,0:01:18.38,Default,,0,0,0,,Шоқжұлдыз шай ішу
Dialogue: 0,0:01:18.40,0:01:19.69,Default,,0,0,0,,Терезеде
Dialogue: 0,0:01:19.72,0:01:21.46,Default,,0,0,0,,Періштелер хоры
Dialogue: 0,0:01:21.49,0:01:24.87,Default,,0,0,0,,Құлағыңыз бос па?
Dialogue: 0,0:01:24.90,0:01:28.46,Default,,0,0,0,,Мен сені сүйемін, мен сені сүйемін дауыс
Dialogue: 0,0:01:30.89,0:01:32.43,Default,,0,0,0,,Бүгінгі сабақ бөлмесі
Dialogue: 0,0:01:32.46,0:01:35.11,Default,,0,0,0,,Мен мектеп фестивалінде не істеу керектігін шешкім келеді.
Dialogue: 0,0:01:35.55,0:01:38.25,Default,,0,0,0,,Пікір бар ма?
Dialogue: 0,0:01:38.79,0:01:40.02,Default,,0,0,0,,Арулар үйі
Dialogue: 0,0:01:40.43,0:01:40.99,Default,,0,0,0,,Иә
Dialogue: 0,0:01:41.72,0:01:44.48,Default,,0,0,0,,Арулар үйі
Dialogue: 0,0:01:47.22,0:01:48.91,Default,,0,0,0,,Басқа нәрсе…
Dialogue: 0,0:01:49.12,0:01:49.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:50.22,0:01:51.40,Default,,0,0,0,,Кофехана!
Dialogue: 0,0:01:51.51,0:01:52.25,Default,,0,0,0,,Иә
Dialogue: 0,0:01:52.75,0:01:54.05,Default,,0,0,0,,Кофехана…
Dialogue: 0,0:01:54.60,0:01:56.73,Default,,0,0,0,,Басқалары бар ма?
Dialogue: 0,0:01:59.06,0:02:01.13,Default,,0,0,0,,Аруақ үйлері мен кофеханалардан басқа
Dialogue: 0,0:02:01.16,0:02:02.95,Default,,0,0,0,,Сізге қажет нәрсе бар ма?
Dialogue: 0,0:02:07.31,0:02:08.65,Default,,0,0,0,,Кафе…
Dialogue: 0,0:02:09.24,0:02:10.71,Default,,0,0,0,,Кафе…
Dialogue: 0,0:02:11.56,0:02:12.07,Default,,0,0,0,,Түтін…
Dialogue: 0,0:02:12.83,0:02:13.43,Default,,0,0,0,,Түтін…
Dialogue: 0,0:02:14.19,0:02:14.77,Default,,0,0,0,,Түтін…
Dialogue: 0,0:02:15.19,0:02:15.69,Default,,0,0,0,,Түтін...
Dialogue: 0,0:02:16.12,0:02:16.94,Default,,0,0,0,,Түтін……
Dialogue: 0,0:02:24.69,0:02:25.71,Default,,0,0,0,,Міне
Dialogue: 0,0:02:29.98,0:02:32.95,Default,,0,0,0,,Басқа ештеңе болмаса, мен мұнымен келісемін.
Dialogue: 0,0:02:33.11,0:02:35.91,Default,,0,0,0,,Қайсысы жақсы: арулар үйі ме, әлде кофехана ма?
Dialogue: 0,0:02:35.93,0:02:37.24,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:02:37.92,0:02:41.40,Default,,0,0,0,,Стандарттар мен православие - барлаудың зираты.
Dialogue: 0,0:02:41.81,0:02:44.25,Default,,0,0,0,,Егер мен мұны бәрібір орындайтын болсам, бұл әдеттен тыс болар еді.
Dialogue: 0,0:02:45.18,0:02:46.64,Default,,0,0,0,,Жақсы мүмкіндік, сондықтан мәселені түпкілікті анықтап алайық.
Dialogue: 0,0:02:47.80,0:02:49.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:56.18,0:02:57.95,Default,,0,0,0,,Менің ойымша, кофехана да жақсы болар еді!
Dialogue: 0,0:03:00.93,0:03:02.51,Default,,0,0,0,,Нұсқаулық
Dialogue: 0,0:03:03.52,0:03:04.39,Default,,0,0,0,,Қазір
Dialogue: 0,0:03:04.41,0:03:07.52,Default,,0,0,0,,Мен ерекше қойылымдар болады деп сенемін.
Dialogue: 0,0:03:07.60,0:03:09.53,Default,,0,0,0,,Ерекше орындау...
Dialogue: 0,0:03:12.13,0:03:13.57,Default,,0,0,0,,Тек біздің сыныпқа арналған
Dialogue: 0,0:03:13.59,0:03:15.82,Default,,0,0,0,,Спорт мерекесінде не істеуіміз керек?
Dialogue: 0,0:03:17.03,0:03:18.93,Default,,0,0,0,,Сен мұны біле тұра айтып тұрсың ба?
Dialogue: 0,0:03:19.39,0:03:22.55,Default,,0,0,0,,О! Бұл ма? Нұсқау дегеніміз не?
Dialogue: 0,0:03:22.77,0:03:24.10,Default,,0,0,0,,Таң қалмаңыз
Dialogue: 0,0:03:24.12,0:03:25.75,Default,,0,0,0,,Бір нәрсе қосу туралы не айтасыз?
Dialogue: 0,0:03:31.77,0:03:34.08,Default,,0,0,0,,Әй, енді не салдың?
Dialogue: 0,0:03:34.91,0:03:35.83,Default,,0,0,0,,Бес иен!
Dialogue: 0,0:03:36.07,0:03:38.44,Default,,0,0,0,,Орындау ұсынысын енгізіңіз.
Dialogue: 0,0:03:40.59,0:03:42.69,Default,,0,0,0,,Осы стандартты темекі туралы аңыз бойынша
Dialogue: 0,0:03:42.71,0:03:44.15,Default,,0,0,0,,Аңыз деген сөз жоқ!
Dialogue: 0,0:03:46.03,0:03:48.99,Default,,0,0,0,,Енді тағы да мәдени фестиваль қойылымдарына тоқталайық.
Dialogue: 0,0:03:49.02,0:03:50.81,Default,,0,0,0,,Мен сөйлескім келеді
Dialogue: 0,0:03:51.13,0:03:53.34,Default,,0,0,0,,Алдымен нұсқаулықты қарастырайық.
Dialogue: 0,0:03:56.68,0:03:57.37,Default,,0,0,0,,Ах
Dialogue: 0,0:04:05.53,0:04:07.06,Default,,0,0,0,,Менің ойымша, ол енді жоқ...
Dialogue: 0,0:04:07.64,0:04:09.60,Default,,0,0,0,,Ах! сонда болды!
Dialogue: 0,0:04:12.34,0:04:13.61,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:14.59,0:04:17.38,Default,,0,0,0,,А, бұл ұсыныс жақсы болуы мүмкін.
Dialogue: 0,0:04:17.67,0:04:20.52,Default,,0,0,0,,Е, тұлыптар көрмесі!
Dialogue: 0,0:04:20.83,0:04:24.25,Default,,0,0,0,,Осы мектепте барлығында болатын тұлыптар
Dialogue: 0,0:04:24.28,0:04:27.43,Default,,0,0,0,,Барлығымызды біріктіретін көрме өткіземіз.
Dialogue: 0,0:04:27.59,0:04:29.32,Default,,0,0,0,,Толтырылған жануарлар да
Dialogue: 0,0:04:29.34,0:04:32.81,Default,,0,0,0,,Мен көп достар тапқаныма қуаныштымын.
Dialogue: 0,0:04:33.60,0:04:34.84,Default,,0,0,0,,Ол солай деді.
Dialogue: 0,0:04:35.41,0:04:36.81,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:37.73,0:04:38.73,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:04:38.81,0:04:40.11,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:04:40.27,0:04:41.23,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:04:41.25,0:04:43.64,Default,,0,0,0,,Менде аркададан алғаным да бар.
Dialogue: 0,0:04:44.11,0:04:47.11,Default,,0,0,0,,Ей, кім ойлады?
Dialogue: 0,0:04:47.63,0:04:50.57,Default,,0,0,0,,Мен анонимді қалғым келеді.
Dialogue: 0,0:04:52.60,0:04:53.81,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:53.84,0:04:57.90,Default,,0,0,0,,Ертегі формасын жасап, оны да киіп көрсек қалай болады?
Dialogue: 0,0:04:59.60,0:05:01.24,Default,,0,0,0,,Осы мәселеге қатысты
Dialogue: 0,0:05:01.27,0:05:03.59,Default,,0,0,0,,Менің де ұсынысым бар...
Dialogue: 0,0:05:03.61,0:05:05.39,Default,,0,0,0,,Нүкте үлпілдек
Dialogue: 0,0:05:05.42,0:05:07.26,Default,,0,0,0,,Менің оны көргім келмейді!
Dialogue: 0,0:05:07.30,0:05:09.94,Default,,0,0,0,,Біз де сынып тұмарын жасайық!
Dialogue: 0,0:05:10.13,0:05:11.91,Default,,0,0,0,,Ол киюге жеткілікті үлкен бе?
Dialogue: 0,0:05:12.14,0:05:13.57,Default,,0,0,0,,Жақсы сияқты
Dialogue: 0,0:05:13.60,0:05:16.33,Default,,0,0,0,,Бәріміз Чио-чанның үйіне жиналып, жетейік!
Dialogue: 0,0:05:17.61,0:05:20.12,Default,,0,0,0,,Бұл үлпілдек...
Dialogue: 0,0:05:20.27,0:05:21.75,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:05:21.80,0:05:22.60,Default,,0,0,0,,Сонымен қатар
Dialogue: 0,0:05:22.62,0:05:25.01,Default,,0,0,0,,Иә, Кимура мырза, шығыңызшы!
Dialogue: 0,0:05:25.03,0:05:26.60,Default,,0,0,0,,Сәл күте тұрыңыз
Dialogue: 0,0:05:26.62,0:05:28.62,Default,,0,0,0,,Бір минут күтіңіз! Аз ғана! Аз ғана!
Dialogue: 0,0:05:51.39,0:05:52.68,Default,,0,0,0,,Иә, мен жасадым.
Dialogue: 0,0:05:54.17,0:05:56.57,Default,,0,0,0,,Мен стандартпын ба?
Dialogue: 0,0:05:56.60,0:05:58.15,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:05:58.69,0:06:01.42,Default,,0,0,0,,Менде шырын жоқ, сондықтан мен сатып аламын.
Dialogue: 0,0:06:01.91,0:06:02.96,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:06:03.33,0:06:04.33,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:04.42,0:06:05.00,Default,,0,0,0,,Эххе (lol)
Dialogue: 0,0:06:05.73,0:06:07.89,Default,,0,0,0,,Жүр, Тадаёси-сан, кеттік.
Dialogue: 0,0:06:07.91,0:06:08.48,Default,,0,0,0,,Бір!
Dialogue: 0,0:06:33.23,0:06:33.81,Default,,0,0,0,,Бір!
Dialogue: 0,0:06:34.60,0:06:36.26,Default,,0,0,0,,Сакаки мырза
Dialogue: 0,0:06:36.60,0:06:38.42,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:06:38.60,0:06:40.56,Default,,0,0,0,,Барлығы күтіп тұрды.
Dialogue: 0,0:06:40.60,0:06:42.93,Default,,0,0,0,,А...кешіріңіз...мен кешігіп қалдым.
Dialogue: 0,0:06:45.74,0:06:46.46,Default,,0,0,0,,Бұл…
Dialogue: 0,0:06:46.87,0:06:48.90,Default,,0,0,0,,О, шырын?
Dialogue: 0,0:06:49.08,0:06:51.52,Default,,0,0,0,,Мен дүкенге барайын деп жатыр едім.
Dialogue: 0,0:06:53.60,0:06:55.42,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:55.71,0:06:56.58,Default,,0,0,0,,Иә
Dialogue: 0,0:07:01.73,0:07:04.37,Default,,0,0,0,,Бұл ит Тадайоши!
Dialogue: 0,0:07:05.39,0:07:06.59,Default,,0,0,0,,Тадаёси мырза?
Dialogue: 0,0:07:06.95,0:07:07.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:07.84,0:07:09.57,Default,,0,0,0,,Мен біреуін үйде ұстаймын.
Dialogue: 0,0:07:10.22,0:07:12.60,Default,,0,0,0,,Мен сені еркелетсем жақсы ма?
Dialogue: 0,0:07:12.97,0:07:13.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:14.68,0:07:16.87,Default,,0,0,0,,Тадаёси мырза жақсы адам.
Dialogue: 0,0:07:16.89,0:07:18.57,Default,,0,0,0,,Мен ашуланбаймын.
Dialogue: 0,0:07:18.79,0:07:19.56,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:19.68,0:07:21.39,Default,,0,0,0,,Осымен, егер сізді тістеп алсаңыз
Dialogue: 0,0:07:21.41,0:07:22.49,Default,,0,0,0,,Сөз тіркесі қолданылмаған.
Dialogue: 0,0:07:22.98,0:07:24.65,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:47.60,0:07:49.93,Default,,0,0,0,,Қараңызшы, бәрі жақсы болды!
Dialogue: 0,0:08:30.97,0:08:33.20,Default,,0,0,0,,Ум... уақыт келді...
Dialogue: 0,0:08:33.60,0:08:35.44,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:08:37.30,0:08:38.08,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:08:38.49,0:08:41.14,Default,,0,0,0,,Егер бұл үлкен болса, сіз оның үстіне шығуыңыз мүмкін.
Dialogue: 0,0:08:41.23,0:08:43.60,Default,,0,0,0,,О, мен міне аламын.
Dialogue: 0,0:08:47.85,0:08:49.15,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:08:56.29,0:08:58.60,Default,,0,0,0,,Енді барлығымызға барайық!
Dialogue: 0,0:08:58.86,0:09:00.22,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:09:24.78,0:09:26.78,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:09:27.10,0:09:28.46,Default,,0,0,0,,Тадаёси мырза...
Dialogue: 0,0:09:30.59,0:09:32.01,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:09:46.54,0:09:49.18,Default,,0,0,0,,Бұл тағы да мектептегі фестиваль маусымы ма?
Dialogue: 0,0:09:49.60,0:09:52.85,Default,,0,0,0,,Есіңде ме? біздің уақыт туралы
Dialogue: 0,0:09:53.51,0:09:54.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:58.44,0:09:59.04,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:59.57,0:10:00.41,Default,,0,0,0,,Эхехе (lol)
Dialogue: 0,0:10:01.95,0:10:03.29,Default,,0,0,0,,Есіңде жоқ па? …
Dialogue: 0,0:10:03.70,0:10:04.68,Default,,0,0,0,,Эхахаха
Dialogue: 0,0:10:05.79,0:10:07.01,Default,,0,0,0,,Жалпы?
Dialogue: 0,0:10:19.80,0:10:21.57,Default,,0,0,0,,Менде жақсы нәрсе бар!
Dialogue: 0,0:10:21.90,0:10:22.49,Default,,0,0,0,,Иә
Dialogue: 0,0:10:36.86,0:10:38.27,Default,,0,0,0,,Олай болса, бәріңе!
Dialogue: 0,0:10:38.30,0:10:39.88,Default,,0,0,0,,Мынаны киіңіз.
Dialogue: 0,0:10:49.74,0:10:51.64,Default,,0,0,0,,Сакаки-сан керемет.
Dialogue: 0,0:10:51.99,0:10:53.28,Default,,0,0,0,,Хмм, түсіндім...
Dialogue: 0,0:10:53.57,0:10:55.78,Default,,0,0,0,,Иә! Саған өте жарасады
Dialogue: 0,0:10:56.44,0:10:58.05,Default,,0,0,0,,Бұл да орындалды.
Dialogue: 0,0:10:58.31,0:11:00.39,Default,,0,0,0,,Уау, сүйкімді
Dialogue: 0,0:11:00.69,0:11:01.99,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:04.19,0:11:05.64,Default,,0,0,0,,Тәтті тәтті!
Dialogue: 0,0:11:07.98,0:11:10.64,Default,,0,0,0,,Бұл жаман емес...
Dialogue: 0,0:11:05.71,0:11:06.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:10.86,0:11:13.30,Default,,0,0,0,,Мен дұрыс киінбеймін деп ойлаймын...
Dialogue: 0,0:11:13.32,0:11:14.62,Default,,0,0,0,,Қалай киіну керек?
Dialogue: 0,0:11:15.13,0:11:16.06,Default,,0,0,0,,Сіз өзгерткіңіз келе ме?
Dialogue: 0,0:11:20.30,0:11:21.52,Default,,0,0,0,,Иә, Томо-чан
Dialogue: 0,0:11:21.63,0:11:22.45,Default,,0,0,0,,Әу
Dialogue: 0,0:11:26.40,0:11:28.25,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:11:29.61,0:11:30.61,Default,,0,0,0,,Онда!
Dialogue: 0,0:11:30.99,0:11:32.01,Default,,0,0,0,,Онда!
Dialogue: 0,0:11:32.37,0:11:33.30,Default,,0,0,0,,Онда!
Dialogue: 0,0:11:33.69,0:11:35.38,Default,,0,0,0,,Міне.
Dialogue: 0,0:11:39.29,0:11:40.63,Default,,0,0,0,,Ах! Не?!
Dialogue: 0,0:11:49.38,0:11:50.21,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:11:57.32,0:11:59.16,Default,,0,0,0,,Не?
Dialogue: 0,0:12:07.08,0:12:09.97,Default,,0,0,0,,Не? Не? Не? Не? Не?
Dialogue: 0,0:12:11.79,0:12:14.39,Default,,0,0,0,,Эй, мен үйдемін.
Dialogue: 0,0:12:14.48,0:12:16.94,Default,,0,0,0,,Уау, мен шаршадым.
Dialogue: 0,0:12:17.35,0:12:19.06,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:12:19.40,0:12:20.14,Default,,0,0,0,,Жарнама
Dialogue: 0,0:12:20.53,0:12:23.10,Default,,0,0,0,,Мен сүйкімділігімді бүкіл мектепке таратып жүрмін!
Dialogue: 0,0:12:23.56,0:12:25.89,Default,,0,0,0,,Бұл өте қорқынышты болды...
Dialogue: 0,0:12:37.34,0:12:38.86,Default,,0,0,0,,Жүзу клубы!
Dialogue: 0,0:12:39.10,0:12:40.90,Default,,0,0,0,,Сіз сусын алғыңыз келе ме?
Dialogue: 0,0:12:41.40,0:12:42.85,Default,,0,0,0,,Сусындар!
Dialogue: 0,0:12:43.49,0:12:44.31,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:12:44.60,0:12:45.93,Default,,0,0,0,,Әй, ұстаз!
Dialogue: 0,0:12:46.13,0:12:47.81,Default,,0,0,0,,Сіз қалай ойлайсыз? Қалың қалай?
Dialogue: 0,0:12:48.21,0:12:50.26,Default,,0,0,0,,Хмм... бұл...
Dialogue: 0,0:12:52.61,0:12:54.18,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:54.34,0:12:56.55,Default,,0,0,0,,Не айтқым келгенін сұрасаңыз да...
Dialogue: 0,0:12:56.97,0:12:58.42,Default,,0,0,0,,Өте қорқынышты!
Dialogue: 0,0:12:59.77,0:13:00.92,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:01.21,0:13:02.21,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:13:02.47,0:13:05.15,Default,,0,0,0,,Аа, Куросава мырза, жақсы жерде.
Dialogue: 0,0:13:05.39,0:13:06.21,Default,,0,0,0,,Иә...
Dialogue: 0,0:13:06.60,0:13:09.23,Default,,0,0,0,,Мұғаліміңізге де хабарлаңыз.
Dialogue: 0,0:13:09.34,0:13:11.25,Default,,0,0,0,,Бұл біртүрлі деп ойламайсың ба?
Dialogue: 0,0:13:11.45,0:13:14.31,Default,,0,0,0,,Бұл жүзу клубының дүкені болса да, купальник сатпайды.
Dialogue: 0,0:13:20.95,0:13:22.60,Default,,0,0,0,,Ал, купальникпен жеткілікті.
Dialogue: 0,0:13:22.80,0:13:23.54,Default,,0,0,0,,Иә
Dialogue: 0,0:13:24.90,0:13:27.80,Default,,0,0,0,,Енді бассейннен бір стақан су ішуге бола ма?
Dialogue: 0,0:13:28.36,0:13:29.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:32.28,0:13:33.79,Default,,0,0,0,,Бұл бассейн суы!
Dialogue: 0,0:13:33.86,0:13:36.17,Default,,0,0,0,,Барлығыңыз кірген бассейндегі су!!
Dialogue: 0,0:13:36.69,0:13:38.28,Default,,0,0,0,,Ондай нәрсе жоқ!!
Dialogue: 0,0:13:45.28,0:13:47.05,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:13:47.40,0:13:49.18,Default,,0,0,0,,Қарап көріңізші!
Dialogue: 0,0:13:51.00,0:13:52.66,Default,,0,0,0,,(Аня) Кешкі асқа не бермек екен? (Іштің күркіреген дыбысы)
Dialogue: 0,0:13:52.96,0:13:55.12,Default,,0,0,0,,Уау! сүйкімді!
Dialogue: 0,0:13:58.60,0:14:00.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:00.09,0:14:01.71,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:04.41,0:14:05.86,Default,,0,0,0,,Бұл ит
Dialogue: 0,0:14:06.43,0:14:07.87,Default,,0,0,0,,Бұл мысық
Dialogue: 0,0:14:11.06,0:14:13.06,Default,,0,0,0,,Менің ойымша, бұл керісінше болды ...
Dialogue: 0,0:14:15.08,0:14:15.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:16.55,0:14:18.04,Default,,0,0,0,,Мм... бұл? …
Dialogue: 0,0:14:18.53,0:14:20.83,Default,,0,0,0,,Бұл Цутенкаку
Dialogue: 0,0:14:21.80,0:14:23.31,Default,,0,0,0,,Цутенкаку…
Dialogue: 0,0:14:23.62,0:14:24.38,Default,,0,0,0,,Иә
Dialogue: 0,0:14:29.55,0:14:31.31,Default,,0,0,0,,Бұл бұрышта қандай кішкентай нәрсе бар?
Dialogue: 0,0:14:31.87,0:14:33.29,Default,,0,0,0,,Ханшин
Dialogue: 0,0:14:36.83,0:14:38.16,Default,,0,0,0,,Ханшин…
Dialogue: 0,0:14:38.27,0:14:38.98,Default,,0,0,0,,Иә
Dialogue: 0,0:14:44.29,0:14:45.29,Default,,0,0,0,,Ханшин
Dialogue: 0,0:14:47.26,0:14:48.55,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:14:48.87,0:14:51.13,Default,,0,0,0,,Бұл ертегілер тобы!
Dialogue: 0,0:14:51.35,0:14:52.88,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:14:53.35,0:14:54.85,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:14:55.13,0:14:56.67,Default,,0,0,0,,Өзгеріс уақыты келді
Dialogue: 0,0:14:56.89,0:14:57.89,Default,,0,0,0,,Иә
Dialogue: 0,0:15:02.11,0:15:04.48,Default,,0,0,0,,Бұл жерде өте ыстық.
Dialogue: 0,0:15:04.92,0:15:05.92,Default,,0,0,0,,(Виолет) Енді біз майордан бұйрық алмаймыз ба?
Dialogue: 0,0:15:07.11,0:15:08.05,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:15:09.78,0:15:11.67,Default,,0,0,0,,Енді мен келесімін.
Dialogue: 0,0:15:11.93,0:15:15.06,Default,,0,0,0,,О, мен де киіп көрсем болады ма?
Dialogue: 0,0:15:15.41,0:15:16.74,Default,,0,0,0,,Олай болса өзгерейік
Dialogue: 0,0:15:16.88,0:15:17.65,Default,,0,0,0,,Уа!
Dialogue: 0,0:15:24.56,0:15:26.48,Default,,0,0,0,,Бұл қорқынышты...
Dialogue: 0,0:15:27.42,0:15:28.99,Default,,0,0,0,,Чи Чио-чан…
Dialogue: 0,0:15:29.59,0:15:31.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:31.15,0:15:31.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:32.13,0:15:33.65,Default,,0,0,0,,Сіз қоңырау шалдыңыз ба?
Dialogue: 0,0:15:51.34,0:15:54.22,Default,,0,0,0,,Уау, бұл сондай біртүрлі және сүйкімді!
Dialogue: 0,0:15:54.54,0:15:56.24,Default,,0,0,0,,Шынымен біртүрлі
Dialogue: 0,0:15:58.35,0:16:00.35,Default,,0,0,0,,Ум, мынаны маған берші.
Dialogue: 0,0:16:00.40,0:16:01.17,Default,,0,0,0,,Иә
Dialogue: 0,0:16:06.00,0:16:08.12,Default,,0,0,0,,Сіз оны сатып алғыңыз келе ме? …
Dialogue: 0,0:16:08.29,0:16:09.09,Default,,0,0,0,,Иә
Dialogue: 0,0:16:15.02,0:16:16.34,Default,,0,0,0,,Бір ғана?
Dialogue: 0,0:16:16.43,0:16:17.89,Default,,0,0,0,,Иә, осылай.
Dialogue: 0,0:16:21.05,0:16:23.24,Default,,0,0,0,,Мысық бірдей болса жарай ма...?
Dialogue: 0,0:16:23.75,0:16:24.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:26.17,0:16:28.17,Default,,0,0,0,,Жоқ, ит...
Dialogue: 0,0:16:41.05,0:16:42.73,Default,,0,0,0,,Бақытты бол...
Dialogue: 0,0:16:48.23,0:16:49.67,Default,,0,0,0,,Ах, Сакаки-сан.
Dialogue: 0,0:16:50.48,0:16:51.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:51.34,0:16:53.64,Default,,0,0,0,,Суретке түсіре аласыз ба?
Dialogue: 0,0:16:53.84,0:16:54.85,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,0:16:55.51,0:16:56.98,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:16:58.95,0:17:00.50,Default,,0,0,0,,Иә Сыр
Dialogue: 0,0:17:02.79,0:17:04.79,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:17:05.01,0:17:06.26,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:17:06.50,0:17:07.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:07.37,0:17:09.84,Default,,0,0,0,,Айтпақшы... Мен де...
Dialogue: 0,0:17:10.12,0:17:11.91,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:17:12.38,0:17:14.02,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:17:14.64,0:17:16.22,Default,,0,0,0,,Иә Сыр
Dialogue: 0,0:17:18.65,0:17:20.46,Default,,0,0,0,,Иә, мен суретке түсіре алдым.
Dialogue: 0,0:17:21.00,0:17:21.92,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:22.46,0:17:23.51,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:17:23.53,0:17:26.37,Default,,0,0,0,,Қазір кім бар?
Dialogue: 0,0:17:29.87,0:17:30.54,Default,,0,0,0,,Иә
Dialogue: 0,0:17:30.77,0:17:31.67,Default,,0,0,0,,(Демін ала-шала)
Dialogue: 0,0:17:39.79,0:17:41.17,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:17:42.11,0:17:43.50,Default,,0,0,0,,Сакаки-сан!
Dialogue: 0,0:17:44.56,0:17:46.05,Default,,0,0,0,,(Кашиваги) Олай деу дұрыс па?
Dialogue: 0,0:17:47.51,0:17:48.94,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:17:51.09,0:17:52.79,Default,,0,0,0,,Ойланып көріңізші.
Dialogue: 0,0:17:53.07,0:17:56.61,Default,,0,0,0,,Тіпті мектепте оқып жүрген кезімізде мектеп фестивалінде.
Dialogue: 0,0:17:57.53,0:17:59.19,Default,,0,0,0,,Ақыры есіңе түсті ме?
Dialogue: 0,0:18:01.00,0:18:02.29,Default,,0,0,0,,Кофехана…
Dialogue: 0,0:18:02.47,0:18:04.98,Default,,0,0,0,,Иә, есімде.
Dialogue: 0,0:18:05.48,0:18:06.48,Default,,0,0,0,,Сіз дұрыс түсіндіңіз бе?
Dialogue: 0,0:18:06.89,0:18:09.33,Default,,0,0,0,,Идиот, бұл викторина емес.
Dialogue: 0,0:18:09.81,0:18:10.81,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:18:10.84,0:18:14.17,Default,,0,0,0,,Оқушылардың өткен жылы не істегені есімде де жоқ.
Dialogue: 0,0:18:14.46,0:18:17.05,Default,,0,0,0,,Мақтанба, мен жалғызбын
Dialogue: 0,0:18:17.75,0:18:19.18,Default,,0,0,0,,Өткен өмірмен айналыспа!
Dialogue: 0,0:18:19.60,0:18:21.81,Default,,0,0,0,,Осы сәтте өмір сүр!
Dialogue: 0,0:18:22.24,0:18:24.63,Default,,0,0,0,,Апельсин шырынын ішуге болмайды
Dialogue: 0,0:18:24.88,0:18:26.13,Default,,0,0,0,,Ақымақ! ! ! #
Dialogue: 0,0:18:26.24,0:18:27.41,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:18:43.69,0:18:46.60,Default,,0,0,0,,Мұны менің әпкем жасады.
Dialogue: 0,0:18:47.15,0:18:48.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:51.59,0:18:53.13,Default,,0,0,0,,Қаласаң, беремін.
Dialogue: 0,0:18:56.53,0:18:57.65,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:19:07.83,0:19:08.87,Default,,0,0,0,,Олай болса
Dialogue: 0,0:19:09.02,0:19:11.74,Default,,0,0,0,,Мектеп фестивалінің сәтті аяқталуымен құттықтаймыз
Dialogue: 0,0:19:11.76,0:19:13.60,Default,,0,0,0,,Шырынмен құттықтаймыз!
Dialogue: 0,0:19:13.85,0:19:14.98,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:15.12,0:19:17.12,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:20.82,0:19:22.04,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:19:22.23,0:19:24.55,Default,,0,0,0,,Иә! Баршаңызға еңбектеріңіз үшін рахмет!
Dialogue: 0,0:19:25.45,0:19:26.21,Default,,0,0,0,,Олай болса
Dialogue: 0,0:19:26.25,0:19:27.75,Default,,0,0,0,,Мына тұлып
Dialogue: 0,0:19:27.77,0:19:29.20,Default,,0,0,0,,Барлығы
Dialogue: 0,0:19:29.52,0:19:30.56,Default,,0,0,0,,Нан пісірейік!
Dialogue: 0,0:19:33.41,0:19:36.72,Default,,0,0,0,,Не? Соңында еске алу ретінде пісірілген емес пе?
Dialogue: 0,0:19:37.17,0:19:38.70,Default,,0,0,0,,Бұл қандай еске алу кеші?
Dialogue: 0,0:19:44.22,0:19:46.52,Default,,0,0,0,,Клиенттер өте аз болды.
Dialogue: 0,0:19:46.78,0:19:49.61,Default,,0,0,0,,Иә, сауалнамалар өте көп.
Dialogue: 0,0:19:49.63,0:19:52.13,Default,,0,0,0,,Тұлыптар да жақсы сатылды.
Dialogue: 0,0:19:52.60,0:19:56.38,Default,,0,0,0,,Тұлыптар көрмесі өте сәтті өтті.
Dialogue: 0,0:20:00.47,0:20:03.13,Default,,0,0,0,,Не болды? Күрсініп
Dialogue: 0,0:20:03.45,0:20:04.82,Default,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:20:05.15,0:20:07.99,Default,,0,0,0,,Жоқ, менің ойымша, аяқталуға жақын
Dialogue: 0,0:20:08.07,0:20:10.31,Default,,0,0,0,,Мен өзімді жалғыз сезінемін...
Dialogue: 0,0:20:11.73,0:20:14.73,Default,,0,0,0,,Ертең де мектеп фестивалі өтсе жақсы болар еді.
Dialogue: 0,0:20:15.45,0:20:17.97,Default,,0,0,0,,Мен бұлай жұмыс істемейтініне сенімдімін.
Dialogue: 0,0:20:21.48,0:20:23.67,Default,,0,0,0,,Жарайды! Бұл салтанатты шеру!
Dialogue: 0,0:20:24.08,0:20:24.99,Default,,0,0,0,,О!
Dialogue: 0,0:20:25.30,0:20:26.50,Default,,0,0,0,,Жеңіспен оралу...
Dialogue: 0,0:21:52.02,0:21:53.92,Default,,0,0,0,,Тадаёси-сан
Dialogue: 0,0:21:59.18,0:22:01.74,Default,,0,0,0,,Жүрегімде қанаттым
Dialogue: 0,0:22:03.36,0:22:06.46,Default,,0,0,0,,Жүрегіңдегі сыбырды айт
Dialogue: 0,0:22:07.61,0:22:10.29,Default,,0,0,0,,Енді желде
Dialogue: 0,0:22:13.95,0:22:16.51,Default,,0,0,0,,Менің жүрегім жұлдыздардан тыс
Dialogue: 0,0:22:18.18,0:22:21.32,Default,,0,0,0,,Тілектер әрқашан орындалады
Dialogue: 0,0:22:22.39,0:22:30.00,Default,,0,0,0,,Кел мені көр, кілті болашақтың
Dialogue: 0,0:22:31.13,0:22:35.28,Default,,0,0,0,,Терезеге ақырын шақырған дауыс
Dialogue: 0,0:22:35.38,0:22:39.12,Default,,0,0,0,,Махаббатты алдын ала ескерту және
Dialogue: 0,0:22:39.68,0:22:43.32,Default,,0,0,0,,Махаббат әлі алыс болса да
Dialogue: 0,0:22:43.62,0:22:45.60,Default,,0,0,0,,Мен ертеңге сенемін
Dialogue: 0,0:22:45.63,0:22:47.64,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:22:47.76,0:22:49.61,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:49.65,0:22:55.10,Default,,0,0,0,,Жалғыз болмаймын деп уәде бердің, аспан
Dialogue: 0,0:22:56.24,0:22:58.05,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:58.12,0:22:59.78,Default,,0,0,0,,Тәтті көз жасы
Dialogue: 0,0:23:00.18,0:23:04.51,Default,,0,0,0,,Жұмақта тағы да күл
Dialogue: 0,0:23:04.74,0:23:06.49,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:23:06.57,0:23:12.05,Default,,0,0,0,,Мен сені нәзік армандардың аспанына алып кетуге келдім
Dialogue: 0,0:23:13.20,0:23:16.86,Default,,0,0,0,,Таңқурай аспаны, мен саған қайтамын
Dialogue: 0,0:23:17.16,0:23:21.48,Default,,0,0,0,,Жұмақ гүлі жайқалған күні
Dialogue: 0,0:23:21.61,0:23:23.58,Default,,0,0,0,,Сен және мен...
Dialogue: 0,0:23:24.19,0:23:28.46,Default,,0,0,0,,Бірге кездесейік
Dialogue: 0,0:23:33.77,0:23:36.53,Default,,0,0,0,,Келесі Азуманга Дайо...
Dialogue: 0,0:23:36.72,0:23:39.00,Default,,0,0,0,,Бұл менің бірінші арманымның оқиғасы.
Dialogue: 0,0:23:39.93,0:23:43.36,Default,,0,0,0,,Мен әркім қандай армандарды көреді деп ойлаймын
Dialogue: 0,0:23:44.52,0:23:48.59,Default,,0,0,0,,Маған ұшу және секіру армандары ұнайды.
Dialogue: 0,0:23:49.94,0:23:53.30,Default,,0,0,0,,Жағымды түс көрсем екен
Dialogue: 0,0:23:54.05,0:23:55.87,Default,,0,0,0,,А, қызыл нәрсе ме?
Dialogue: 0,0:23:56.10,0:23:59.71,Default,,0,0,0,,[Уау, ақыры аяқталды... Мен оны екі аптаға жуық өңдедім, бірақ ол мінсіз емес. Көрермендер түсінетін субтитрлерде жоқ сөйлемдер болса, оларды Steam тіркелгімнің түсініктемелер бөліміне жазыңыз. Мен v2 шығара аламын. /id/Anyck/】
Dialogue: 0,0:24:01.21,0:24:07.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory