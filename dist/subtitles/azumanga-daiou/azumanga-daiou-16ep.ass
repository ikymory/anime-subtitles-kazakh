Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:39.70,0:01:43.03,Default,,0000,0000,0000,,Биыл да
Dialogue: 0,0:01:39.70,0:01:43.03,Default,,0000,0000,0000,,Мектеп мерекесі жақындап қалды.
Dialogue: 0,0:01:43.03,0:01:46.03,Default,,0000,0000,0000,,Мәдени фестиваль
Dialogue: 0,0:01:43.03,0:01:46.03,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:01:46.03,0:01:48.70,Default,,0000,0000,0000,,Кофехана.
Dialogue: 0,0:01:46.03,0:01:48.70,Default,,0000,0000,0000,,Арулар үйі.
Dialogue: 0,0:01:48.70,0:01:50.71,Default,,0000,0000,0000,,Тағы да?
Dialogue: 0,0:01:50.71,0:01:54.11,Default,,0000,0000,0000,,Аа, мм...
Dialogue: 0,0:01:56.21,0:01:58.88,Default,,0000,0000,0000,,Ах~
Dialogue: 0,0:01:56.21,0:01:58.88,Default,,0000,0000,0000,,Жақсы, қалағаныңды істе.
Dialogue: 0,0:01:58.88,0:02:01.82,Default,,0000,0000,0000,,Оқушылардың дербестігі
Dialogue: 0,0:01:58.88,0:02:01.82,Default,,0000,0000,0000,,Өйткені бұл өте нашар.
Dialogue: 0,0:02:04.32,0:02:06.32,Default,,0000,0000,0000,,Мектептен кейін!
Dialogue: 0,0:02:08.32,0:02:10.33,Default,,0000,0000,0000,,Сайып келгенде, биылғы жыл да нұсқаулық қорап болып табылады.
Dialogue: 0,0:02:10.33,0:02:14.00,Default,,0000,0000,0000,,Менің ойыма келетін жалғыз идеялар - кофеханалар мен елікті үйлер.
Dialogue: 0,0:02:14.00,0:02:18.17,Default,,0000,0000,0000,,Иә? Онда 5 иендік монета салмаңыз.
Dialogue: 0,0:02:18.17,0:02:22.17,Default,,0000,0000,0000,,Иә! екеуін біріктіріңіз
Dialogue: 0,0:02:18.17,0:02:22.17,Default,,0000,0000,0000,,Арулар үйі кафесі дегеніміз не? ?
Dialogue: 0,0:02:22.17,0:02:26.34,Default,,0000,0000,0000,,Біреу шай ішіп отырғанда
Dialogue: 0,0:02:22.17,0:02:26.34,Default,,0000,0000,0000,,Уау, сен мені таң қалдырдың!
Dialogue: 0,0:02:26.34,0:02:29.18,Default,,0000,0000,0000,,Аяқтауға жақын
Dialogue: 0,0:02:26.34,0:02:29.18,Default,,0000,0000,0000,,Сіз ішуге болмайтын кофехана.
Dialogue: 0,0:02:29.18,0:02:32.35,Default,,0000,0000,0000,,Эй, бұл жұмыс істеуі мүмкін! үзіліс! ?
Dialogue: 0,0:02:32.35,0:02:34.85,Default,,0000,0000,0000,,Бұл бастауыш мектептің түскі асына ұқсайды.
Dialogue: 0,0:02:34.85,0:02:38.69,Default,,0000,0000,0000,,Аа, бірақ сәл жақсы шығар.
Dialogue: 0,0:02:34.85,0:02:38.69,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:38.69,0:02:41.02,Default,,0000,0000,0000,,Мүмкін.
Dialogue: 0,0:02:38.69,0:02:41.02,Default,,0000,0000,0000,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:02:41.02,0:02:44.12,Default,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:02:46.36,0:02:50.70,Default,,0000,0000,0000,,Кофеімді ішсем, ішінде тарақан бар екен! ?
Dialogue: 0,0:02:50.70,0:02:53.54,Default,,0000,0000,0000,,Уау, әпке
Dialogue: 0,0:02:50.70,0:02:53.54,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:02:53.54,0:02:56.04,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:02:53.54,0:02:56.04,Default,,0000,0000,0000,,Бұл арулар үйі емес шығар.
Dialogue: 0,0:02:56.04,0:02:59.98,Default,,0000,0000,0000,,Барлық даяшылар
Dialogue: 0,0:02:56.04,0:02:59.98,Default,,0000,0000,0000,,Ол елес сияқты киінген.
Dialogue: 0,0:02:59.98,0:03:03.98,Default,,0000,0000,0000,,Бұл ақылға қонымды сызық.
Dialogue: 0,0:02:59.98,0:03:03.98,Default,,0000,0000,0000,,Бұл мені таң қалдырмайды.
Dialogue: 0,0:03:03.98,0:03:07.48,Default,,0000,0000,0000,,Мен таң қалуым керек пе?
Dialogue: 0,0:03:03.98,0:03:07.48,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:03:07.48,0:03:09.99,Default,,0000,0000,0000,,Чио-чан, бояймыз.
Dialogue: 0,0:03:09.99,0:03:12.99,Default,,0000,0000,0000,,Бояу беті? Неліктен?
Dialogue: 0,0:03:12.99,0:03:15.99,Default,,0000,0000,0000,,Орындаңыз.
Dialogue: 0,0:03:15.99,0:03:18.49,Default,,0000,0000,0000,,《Чи/Кёми: Бұл сүйкімді болуы мүмкін...》
Dialogue: 0,0:03:18.49,0:03:20.50,Default,,0000,0000,0000,,Эхехехехе.
Dialogue: 0,0:03:20.50,0:03:23.83,Default,,0000,0000,0000,,Иә, бұл сүтті шай.
Dialogue: 0,0:03:23.83,0:03:26.67,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:03:26.67,0:03:29.84,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:03:29.84,0:03:33.34,Default,,0000,0000,0000,,Басқа елестер
Dialogue: 0,0:03:29.84,0:03:33.34,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:03:33.34,0:03:36.51,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:33.34,0:03:36.51,Default,,0000,0000,0000,,Мм, мазақ ете ме?
Dialogue: 0,0:03:36.51,0:03:39.51,Default,,0000,0000,0000,,Уф... Ах!
Dialogue: 0,0:03:39.51,0:03:41.85,Default,,0000,0000,0000,,Әй, ақан!
Dialogue: 0,0:03:41.85,0:03:46.19,Default,,0000,0000,0000,,Арулар кафесінде құрылымдық ақаулар бар.
Dialogue: 0,0:03:41.85,0:03:46.19,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:03:46.19,0:03:49.52,Default,,0000,0000,0000,,А, солай! Үйден келген жүгіру!
Dialogue: 0,0:03:46.19,0:03:49.52,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:03:49.52,0:03:52.69,Default,,0000,0000,0000,,Аруақ үйіне ұқсайтын кофехана ➡
Dialogue: 0,0:03:52.69,0:03:55.69,Default,,0000,0000,0000,,Кофехана сияқты
Dialogue: 0,0:03:52.69,0:03:55.69,Default,,0000,0000,0000,,Арулар үйі ше?
Dialogue: 0,0:03:57.70,0:04:01.30,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:03:57.70,0:04:01.30,Default,,0000,0000,0000,,Үйге жүгіру...?
Dialogue: 0,0:04:01.30,0:04:04.14,Default,,0000,0000,0000,,Бірақ бұл мәдени фестиваль ғой➡
Dialogue: 0,0:04:04.14,0:04:06.48,Default,,0000,0000,0000,,Басқа қандай сыныптар бар?
Dialogue: 0,0:04:04.14,0:04:06.48,Default,,0000,0000,0000,,Мен өзімді ерекшелгім келеді.
Dialogue: 0,0:04:06.48,0:04:09.14,Default,,0000,0000,0000,,Міне! Басқа сыныптар үшін ➡
Dialogue: 0,0:04:09.14,0:04:11.65,Default,,0000,0000,0000,,Ешқашан еліктеуге болмайтын іспен айналысайық!
Dialogue: 0,0:04:11.65,0:04:14.65,Default,,0000,0000,0000,,Осы сыныпта
Dialogue: 0,0:04:11.65,0:04:14.65,Default,,0000,0000,0000,,Басқа жерде кездеспейтін заттар….
Dialogue: 0,0:04:14.65,0:04:19.49,Default,,0000,0000,0000,,Хмм, осы сыныпта.
Dialogue: 0,0:04:14.65,0:04:19.49,Default,,0000,0000,0000,,Басқа қандай сыныптарда жоқ...
Dialogue: 0,0:04:19.49,0:04:21.66,Default,,0000,0000,0000,,Чио-чан туралы айтасыз ба?
Dialogue: 0,0:04:19.49,0:04:21.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:21.66,0:04:23.83,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:04:23.83,0:04:27.33,Default,,0000,0000,0000,,О! Куу!
Dialogue: 0,0:04:23.83,0:04:27.33,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:04:27.33,0:04:30.00,Default,,0000,0000,0000,,Ха~!
Dialogue: 0,0:04:27.33,0:04:30.00,Default,,0000,0000,0000,,Бірдеңе ойладың ба?
Dialogue: 0,0:04:30.00,0:04:32.17,Default,,0000,0000,0000,,Чио-чан шоуы!
Dialogue: 0,0:04:32.17,0:04:34.17,Default,,0000,0000,0000,,Бәріміз Чио-чан болайық!
Dialogue: 0,0:04:34.17,0:04:36.17,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:04:34.17,0:04:36.17,Default,,0000,0000,0000,,Ол Чио-чанға айналады ма? ?
Dialogue: 0,0:04:36.17,0:04:39.34,Default,,0000,0000,0000,,Иә! Шашыңыз осылай болсын.
Dialogue: 0,0:04:39.34,0:04:41.84,Default,,0000,0000,0000,,Иә, мен осындамын.
Dialogue: 0,0:04:41.84,0:04:43.85,Default,,0000,0000,0000,,Ол данышпан.
Dialogue: 0,0:04:43.85,0:04:47.35,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:04:43.85,0:04:47.35,Default,,0000,0000,0000,,100 ұпай.
Dialogue: 0,0:04:47.35,0:04:49.35,Default,,0000,0000,0000,,Мен баймын.
Dialogue: 0,0:04:49.35,0:04:52.35,Default,,0000,0000,0000,,Мм...!
Dialogue: 0,0:04:49.35,0:04:52.35,Default,,0000,0000,0000,,《Аа, ренжідім, ренжідім》
Dialogue: 0,0:04:52.35,0:04:56.36,Default,,0000,0000,0000,,Құнды заттың бәрін аламын!
Dialogue: 0,0:04:52.35,0:04:56.36,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:56.36,0:04:58.36,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:04:56.36,0:04:58.36,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:58.36,0:05:00.30,Default,,0000,0000,0000,,Чио десуйо.
Dialogue: 0,0:05:00.30,0:05:02.30,Default,,0000,0000,0000,,Бұл дұрыс емес!
Dialogue: 0,0:05:02.30,0:05:04.30,Default,,0000,0000,0000,,Біреуі жоқ...
Dialogue: 0,0:05:06.30,0:05:08.30,Default,,0000,0000,0000,,Мәдени мерекелік қойылым?
Dialogue: 0,0:05:08.30,0:05:11.47,Default,,0000,0000,0000,,Бірден
Dialogue: 0,0:05:08.30,0:05:11.47,Default,,0000,0000,0000,,Мен кофехана ашқым келеді.
Dialogue: 0,0:05:11.47,0:05:14.81,Default,,0000,0000,0000,,Бірақ мен жасағым келетін сабақ
Dialogue: 0,0:05:11.47,0:05:14.81,Default,,0000,0000,0000,,Бұл көп емес пе? Бұл атлас.
Dialogue: 0,0:05:14.81,0:05:16.81,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:05:16.81,0:05:19.82,Default,,0000,0000,0000,,Арулар үйі және
Dialogue: 0,0:05:16.81,0:05:19.82,Default,,0000,0000,0000,,Кофеханалар көп сияқты.
Dialogue: 0,0:05:19.82,0:05:22.98,Default,,0000,0000,0000,,Соякара
Dialogue: 0,0:05:19.82,0:05:22.98,Default,,0000,0000,0000,,Иә, мен жоспар туралы ойлаудың қажеті жоқ.
Dialogue: 0,0:05:22.98,0:05:24.99,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:05:24.99,0:05:28.99,Default,,0000,0000,0000,,Ах! Оны арулар үйімен біріктіріңіз
Dialogue: 0,0:05:24.99,0:05:28.99,Default,,0000,0000,0000,,Арулар кафесі! ?
Dialogue: 0,0:05:28.99,0:05:30.99,Default,,0000,0000,0000,,Бұл жақсы идея болуы мүмкін!
Dialogue: 0,0:05:30.99,0:05:32.99,Default,,0000,0000,0000,,Бірдей деңгей.
Dialogue: 0,0:05:30.99,0:05:32.99,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:05:32.99,0:05:35.00,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:05:35.00,0:05:39.50,Default,,0000,0000,0000,,Өткен жылы сіздің сабағыңыз ертегі болды.
Dialogue: 0,0:05:35.00,0:05:39.50,Default,,0000,0000,0000,,Сіз сүйкімді нәрсе жасадыңыз.
Dialogue: 0,0:05:39.50,0:05:41.84,Default,,0000,0000,0000,,Иә, бұл өте танымал болды!
Dialogue: 0,0:05:41.84,0:05:43.84,Default,,0000,0000,0000,,Иә, бұл жақсы болды➡
Dialogue: 0,0:05:43.84,0:05:45.84,Default,,0000,0000,0000,,Мен оны ``ah'' дегенмен біріктірсем ше?
Dialogue: 0,0:05:45.84,0:05:47.84,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,0:05:47.84,0:05:50.68,Default,,0000,0000,0000,,Иә, сүйкімді елікті үй.
Dialogue: 0,0:05:50.68,0:05:52.68,Default,,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:05:52.68,0:05:54.68,Default,,0000,0000,0000,,Толтырылған жануарлар дәмханасы?
Dialogue: 0,0:05:54.68,0:05:56.69,Default,,0000,0000,0000,,Өткен жылғы рефлексияны пайдаланыңыз➡
Dialogue: 0,0:05:56.69,0:05:58.85,Default,,0000,0000,0000,,Жақсы нәрсе
Dialogue: 0,0:05:56.69,0:05:58.85,Default,,0000,0000,0000,,Мүмкін болуы мүмкін!
Dialogue: 0,0:05:58.85,0:06:01.46,Default,,0000,0000,0000,,Кері жүгіру!
Dialogue: 0,0:05:58.85,0:06:01.46,Default,,0000,0000,0000,,Сол бала менің одақтасым болады дегің келе ме?
Dialogue: 0,0:06:01.46,0:06:04.13,Default,,0000,0000,0000,,Барлығы бірге➡
Dialogue: 0,0:06:04.13,0:06:08.46,Default,,0000,0000,0000,,Сүйкімді жануарлар
Dialogue: 0,0:06:04.13,0:06:08.46,Default,,0000,0000,0000,,Қорқынышты, еліктіретін кофехана.
Dialogue: 0,0:06:08.46,0:06:11.13,Default,,0000,0000,0000,,Сіз не айтып жатырсыз?
Dialogue: 0,0:06:08.46,0:06:11.13,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:06:11.13,0:06:13.64,Default,,0000,0000,0000,,Және солай
Dialogue: 0,0:06:11.13,0:06:13.64,Default,,0000,0000,0000,,Бұл үйден келген жүгіру емес.
Dialogue: 0,0:06:13.64,0:06:16.81,Default,,0000,0000,0000,,Басқаша айтқанда, түсіндіру.
Dialogue: 0,0:06:13.64,0:06:16.81,Default,,0000,0000,0000,,Тыңдаңыз.
Dialogue: 0,0:06:16.81,0:06:20.61,Default,,0000,0000,0000,,Кофехана іші
Dialogue: 0,0:06:16.81,0:06:20.61,Default,,0000,0000,0000,,Иттер мен мысықтар көп болды...
Dialogue: 0,0:06:23.81,0:06:25.81,Default,,0000,0000,0000,,Барлығы өлді.
Dialogue: 0,0:06:25.81,0:06:27.82,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:27.82,0:06:29.82,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:06:29.82,0:06:32.49,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:06:32.49,0:06:35.16,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:06:35.16,0:06:38.16,Default,,0000,0000,0000,,Осы жерде қысқаша баяндасақ жақсы болар еді.
Dialogue: 0,0:06:41.16,0:06:43.83,Default,,0000,0000,0000,,Бірақ бәрібір
Dialogue: 0,0:06:41.16,0:06:43.83,Default,,0000,0000,0000,,Сіз оны жақын арада пайдалана аласыз➡
Dialogue: 0,0:06:43.83,0:06:46.13,Default,,0000,0000,0000,,Осында қалдырған дұрыс...
Dialogue: 0,0:06:50.17,0:06:52.67,Default,,0000,0000,0000,,Бірақ бір ғана
Dialogue: 0,0:06:50.17,0:06:52.67,Default,,0000,0000,0000,,Егер ол басқа жерде болса➡
Dialogue: 0,0:06:52.67,0:06:56.51,Default,,0000,0000,0000,,Бұл ұмытылуы мүмкін...
Dialogue: 0,0:06:56.51,0:07:00.78,Default,,0000,0000,0000,,Ах, бірақ таңқаларлық
Dialogue: 0,0:06:56.51,0:07:00.78,Default,,0000,0000,0000,,Мұндағы ыңғайлылық жақсырақ➡
Dialogue: 0,0:07:00.78,0:07:04.45,Default,,0000,0000,0000,,Сіздің жеңіске жетуіңіз мүмкін емес пе?
Dialogue: 0,0:07:04.45,0:07:07.29,Default,,0000,0000,0000,,Біраз уақыттан бері
Dialogue: 0,0:07:04.45,0:07:07.29,Default,,0000,0000,0000,,Бекер не істеп жатырсың?
Dialogue: 0,0:07:07.29,0:07:09.29,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:07:09.29,0:07:11.63,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:09.29,0:07:11.63,Default,,0000,0000,0000,,Мұнда не болады? ?
Dialogue: 0,0:07:11.63,0:07:14.30,Default,,0000,0000,0000,,Орындық мына жерде
Dialogue: 0,0:07:11.63,0:07:14.30,Default,,0000,0000,0000,,Оны одан әрі төмендетіңіз!
Dialogue: 0,0:07:14.30,0:07:16.97,Default,,0000,0000,0000,,Эй~ Ертең мектеп мерекесі~!
Dialogue: 0,0:07:14.30,0:07:16.97,Default,,0000,0000,0000,,Бұл парта қабырғаның алдында!
Dialogue: 0,0:07:16.97,0:07:21.47,Default,,0000,0000,0000,,А, тоқта!
Dialogue: 0,0:07:16.97,0:07:21.47,Default,,0000,0000,0000,,Алдымен панельді жалға алыңыз!
Dialogue: 0,0:07:21.47,0:07:24.47,Default,,0000,0000,0000,,Жұмыс үстелі
Dialogue: 0,0:07:21.47,0:07:24.47,Default,,0000,0000,0000,,Оны дәлізге сөндіріңіз!
Dialogue: 0,0:07:24.47,0:07:27.48,Default,,0000,0000,0000,,А, мәзір қағазы.
Dialogue: 0,0:07:24.47,0:07:27.48,Default,,0000,0000,0000,,Оны кесіңіз!
Dialogue: 0,0:07:27.48,0:07:31.65,Default,,0000,0000,0000,,А, ыдыс-аяқ.
Dialogue: 0,0:07:27.48,0:07:31.65,Default,,0000,0000,0000,,Оларды түрі бойынша алып жүріңіз!
Dialogue: 0,0:07:31.65,0:07:33.98,Default,,0000,0000,0000,,Ах! тым кеш!
Dialogue: 0,0:07:33.98,0:07:37.98,Default,,0000,0000,0000,,Біреу сағатты кері бұрсын!
Dialogue: 0,0:07:40.16,0:07:42.16,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:42.16,0:07:48.66,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:07:48.66,0:07:50.67,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:07:50.67,0:07:53.50,Default,,0000,0000,0000,,Аа, мен сізге жете алмаймын.
Dialogue: 0,0:07:53.50,0:07:56.17,Default,,0000,0000,0000,,Осака-сан, жұмыс істе!
Dialogue: 0,0:07:56.17,0:07:59.01,Default,,0000,0000,0000,,(Дыбыс салу)
Dialogue: 0,0:07:59.01,0:08:01.94,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:59.01,0:08:01.94,Default,,0000,0000,0000,,Дизайн.
Dialogue: 0,0:08:01.94,0:08:03.95,Default,,0000,0000,0000,,Сенімсіз.
Dialogue: 0,0:08:03.95,0:08:07.45,Default,,0000,0000,0000,,Оны маған қалдырыңыз.
Dialogue: 0,0:08:03.95,0:08:07.45,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:08:07.45,0:08:11.05,Default,,0000,0000,0000,,Мына жәшік... о, басқа...
Dialogue: 0,0:08:17.63,0:08:20.30,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:08:17.63,0:08:20.30,Default,,0000,0000,0000,,«хмм» не болды?
Dialogue: 0,0:08:20.30,0:08:22.96,Default,,0000,0000,0000,,Ах~ мен уақытында үлгермей қалуым мүмкін~!
Dialogue: 0,0:08:22.96,0:08:25.30,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:22.96,0:08:25.30,Default,,0000,0000,0000,,Сол Сакаки-сан.
Dialogue: 0,0:08:25.30,0:08:28.30,Default,,0000,0000,0000,,Мен сізге көмектесетін нәрсе бар ма?
Dialogue: 0,0:08:25.30,0:08:28.30,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:28.30,0:08:30.64,Default,,0000,0000,0000,,А, бұл дизайн сызбасы ма?
Dialogue: 0,0:08:30.64,0:08:33.14,Default,,0000,0000,0000,,Не ол?
Dialogue: 0,0:08:30.64,0:08:33.14,Default,,0000,0000,0000,,Шляпа….
Dialogue: 0,0:08:33.14,0:08:35.64,Default,,0000,0000,0000,,Ей, Сакаки-сан, мұнда кел!
Dialogue: 0,0:08:35.64,0:08:37.65,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:08:37.65,0:08:39.65,Default,,0000,0000,0000,,Өтінемін.
Dialogue: 0,0:08:39.65,0:08:41.65,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:08:41.65,0:08:43.65,Default,,0000,0000,0000,,Сен не істеп жатырсың, Каорин?
Dialogue: 0,0:08:43.65,0:08:46.49,Default,,0000,0000,0000,,Мен Сакаки-санмен сөйлестім...
Dialogue: 0,0:08:46.49,0:08:50.16,Default,,0000,0000,0000,,Уау~
Dialogue: 0,0:08:46.49,0:08:50.16,Default,,0000,0000,0000,,Шляпа….
Dialogue: 0,0:08:50.16,0:08:53.83,Default,,0000,0000,0000,,Ах~ мен уақытында үлгермеуім мүмкін~!
Dialogue: 0,0:08:53.83,0:08:57.00,Default,,0000,0000,0000,,Бұл жер
Dialogue: 0,0:08:53.83,0:08:57.00,Default,,0000,0000,0000,,Мен оны саған бере алмаймын!
Dialogue: 0,0:08:57.00,0:08:59.00,Default,,0000,0000,0000,,Киша~!
Dialogue: 0,0:08:59.00,0:09:02.94,Default,,0000,0000,0000,,Ша~ Ша~ Ша~ Ша~! Шува~!
Dialogue: 0,0:09:02.94,0:09:05.44,Default,,0000,0000,0000,,О! Сіз ұша аласыз ба!? ?
Dialogue: 0,0:09:05.44,0:09:09.44,Default,,0000,0000,0000,,Сонда бұл да!
Dialogue: 0,0:09:05.44,0:09:09.44,Default,,0000,0000,0000,,Уа! Жақсы ойын!
Dialogue: 0,0:09:09.44,0:09:11.45,Default,,0000,0000,0000,,Гаруруру~! Куи~ин!
Dialogue: 0,0:09:11.45,0:09:13.45,Default,,0000,0000,0000,,Гяаан! Шваван!
Dialogue: 0,0:09:13.45,0:09:16.62,Default,,0000,0000,0000,,Хмм, сен қашып барасың ба? ? Габурин!
Dialogue: 0,0:09:13.45,0:09:16.62,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:16.62,0:09:19.79,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:09:16.62,0:09:19.79,Default,,0000,0000,0000,,Мені тістеген жоқпын!
Dialogue: 0,0:09:19.79,0:09:23.49,Default,,0000,0000,0000,,Не! ? Хмм, не? тоқтату?
Dialogue: 0,0:09:25.46,0:09:27.46,Default,,0000,0000,0000,,Фон.
Dialogue: 0,0:09:27.46,0:09:31.13,Default,,0000,0000,0000,,Не, Сакаки-сан мұны салды ма?
Dialogue: 0,0:09:31.13,0:09:35.64,Default,,0000,0000,0000,,Жерді қорғау үшін шайқастың фонында болу тым қарапайым емес➡
Dialogue: 0,0:09:35.64,0:09:39.97,Default,,0000,0000,0000,,Осыған ұқсас нәрсе жақсырақ атмосфера жасайды.
Dialogue: 0,0:09:39.97,0:09:43.48,Default,,0000,0000,0000,,Қытырлақ~!
Dialogue: 0,0:09:39.97,0:09:43.48,Default,,0000,0000,0000,,Мен саған ұнайтын нәрсені істеуге рұқсат бермеймін!
Dialogue: 0,0:09:43.48,0:09:47.65,Default,,0000,0000,0000,,Беріңіз, мен жеңемін!
Dialogue: 0,0:09:43.48,0:09:47.65,Default,,0000,0000,0000,,Мен жеңілмеймін!
Dialogue: 0,0:09:47.65,0:09:50.15,Default,,0000,0000,0000,,Хухахаха! Фухахаха!
Dialogue: 0,0:09:50.15,0:09:52.15,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:09:50.15,0:09:52.15,Default,,0000,0000,0000,,Жұмыс~!
Dialogue: 0,0:09:52.15,0:09:55.16,Default,,0000,0000,0000,,Жетеді!
Dialogue: 0,0:09:52.15,0:09:55.16,Default,,0000,0000,0000,,Мектеп мерекесі ертең!
Dialogue: 0,0:09:55.16,0:09:57.16,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:09:55.16,0:09:57.16,Default,,0000,0000,0000,,Ах~ Ах~!
Dialogue: 0,0:09:57.16,0:09:59.49,Default,,0000,0000,0000,,Шынында да
Dialogue: 0,0:09:57.16,0:09:59.49,Default,,0000,0000,0000,,Мен уақытында үлгермей қалуым мүмкін!
Dialogue: 0,0:09:59.49,0:10:01.50,Default,,0000,0000,0000,,Чиёчан!
Dialogue: 0,0:09:59.49,0:10:01.50,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:10:01.50,0:10:03.50,Default,,0000,0000,0000,,Төраға, бұл...?
Dialogue: 0,0:10:01.50,0:10:03.50,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:03.50,0:10:07.17,Default,,0000,0000,0000,,Мұнда кел!
Dialogue: 0,0:10:03.50,0:10:07.17,Default,,0000,0000,0000,,Иә? Кагураның жігіті қашып кетті ме?
Dialogue: 0,0:10:07.17,0:10:09.50,Default,,0000,0000,0000,,Жүзу үйірмесіне дайындық
Dialogue: 0,0:10:07.17,0:10:09.50,Default,,0000,0000,0000,,Мен саған көмектесемін!
Dialogue: 0,0:10:09.50,0:10:11.51,Default,,0000,0000,0000,,Ах! не істеуім керек
Dialogue: 0,0:10:09.50,0:10:11.51,Default,,0000,0000,0000,,Мен енді түсінбеймін!
Dialogue: 0,0:10:11.51,0:10:14.34,Default,,0000,0000,0000,,Сатоши-чан
Dialogue: 0,0:10:11.51,0:10:14.34,Default,,0000,0000,0000,,Міне, өтінемін!
Dialogue: 0,0:10:14.34,0:10:28.02,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:10:28.02,0:10:30.86,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:10:30.86,0:10:33.86,Default,,0000,0000,0000,,Сіз оны уақытында орындадыңыз!
Dialogue: 0,0:10:33.86,0:10:36.53,Default,,0000,0000,0000,,Бұл мәдени мереке!
Dialogue: 0,0:10:33.86,0:10:36.53,Default,,0000,0000,0000,,Бұл мәдени мереке!
Dialogue: 0,0:10:36.53,0:10:39.20,Default,,0000,0000,0000,,Бәріңе сәлем
Dialogue: 0,0:10:36.53,0:10:39.20,Default,,0000,0000,0000,,Дайынсың ба?
Dialogue: 0,0:10:39.20,0:10:41.20,Default,,0000,0000,0000,,Өткізілетін орын ашылды.
Dialogue: 0,0:10:41.20,0:10:44.71,Default,,0000,0000,0000,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:10:41.20,0:10:44.71,Default,,0000,0000,0000,,Иә, әйтеуір.
Dialogue: 0,0:10:44.71,0:10:46.71,Default,,0000,0000,0000,,Уау! Қандай сүйкімді!
Dialogue: 0,0:10:46.71,0:10:51.38,Default,,0000,0000,0000,,Бұл әкенің бас киімі. Бұл форма.
Dialogue: 0,0:10:46.71,0:10:51.38,Default,,0000,0000,0000,,Әке?
Dialogue: 0,0:10:51.38,0:10:54.22,Default,,0000,0000,0000,,Сакаки-сан туралы бірдеңе
Dialogue: 0,0:10:51.38,0:10:54.22,Default,,0000,0000,0000,,Маған осылай қоңырау шала бастаңыз...
Dialogue: 0,0:10:54.22,0:10:58.39,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:10:54.22,0:10:58.39,Default,,0000,0000,0000,,Тек Сакаки-сан ғана түсінеді...
Dialogue: 0,0:10:58.39,0:11:01.16,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:01.16,0:11:03.66,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:03.66,0:11:06.83,Default,,0000,0000,0000,,Кофені жылдам алып жүруге жаттығыңыз!
Dialogue: 0,0:11:06.83,0:11:09.16,Default,,0000,0000,0000,,Сіз не алып жүрсіз?
Dialogue: 0,0:11:09.16,0:11:11.33,Default,,0000,0000,0000,,Мысық мысық….
Dialogue: 0,0:11:11.33,0:11:13.33,Default,,0000,0000,0000,,Тез мұздатылған кофе... Уау!
Dialogue: 0,0:11:13.33,0:11:16.17,Default,,0000,0000,0000,,Мысық мысық….
Dialogue: 0,0:11:13.33,0:11:16.17,Default,,0000,0000,0000,,(әйнек сынған дыбыс)
Dialogue: 0,0:11:16.17,0:11:18.84,Default,,0000,0000,0000,,Жоқ, мен мұны білемін, бірақ...
Dialogue: 0,0:11:18.84,0:11:20.84,Default,,0000,0000,0000,,Түсіндірейін...
Dialogue: 0,0:11:20.84,0:11:24.51,Default,,0000,0000,0000,,Әр адамға қалпақ жасау
Dialogue: 0,0:11:20.84,0:11:24.51,Default,,0000,0000,0000,,Себебі мен уақытында үлгере алмадым➡
Dialogue: 0,0:11:24.51,0:11:27.52,Default,,0000,0000,0000,,Мен оны осылай көрдім.
Dialogue: 0,0:11:27.52,0:11:30.35,Default,,0000,0000,0000,,Ммм….
Dialogue: 0,0:11:30.35,0:11:33.52,Default,,0000,0000,0000,,Жоқ, жақсы, бірақ...
Dialogue: 0,0:11:33.52,0:11:36.52,Default,,0000,0000,0000,,Хаха, қандай қызық! ?
Dialogue: 0,0:11:33.52,0:11:36.52,Default,,0000,0000,0000,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:11:36.52,0:11:39.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:36.52,0:11:39.19,Default,,0000,0000,0000,,Айтпақшы, Чио-чан ше?
Dialogue: 0,0:11:39.19,0:11:42.86,Default,,0000,0000,0000,,Ах, Чио-чан
Dialogue: 0,0:11:39.19,0:11:42.86,Default,,0000,0000,0000,,Ерекше костюмге ауысу.
Dialogue: 0,0:11:42.86,0:11:45.87,Default,,0000,0000,0000,,Арнайы?
Dialogue: 0,0:11:42.86,0:11:45.87,Default,,0000,0000,0000,,Мен Каоринто!
Dialogue: 0,0:11:45.87,0:11:47.87,Default,,0000,0000,0000,,Мен, Чихиро!
Dialogue: 0,0:11:47.87,0:11:49.87,Default,,0000,0000,0000,,Бірге
Dialogue: 0,0:11:47.87,0:11:49.87,Default,,0000,0000,0000,,Арнайы жасалған➡
Dialogue: 0,0:11:49.87,0:11:51.87,Default,,0000,0000,0000,,«Арнайы костюм»!
Dialogue: 0,0:11:51.87,0:11:54.71,Default,,0000,0000,0000,,Арнайы….
Dialogue: 0,0:11:51.87,0:11:54.71,Default,,0000,0000,0000,,Мен үйдемін!
Dialogue: 0,0:11:54.71,0:11:57.21,Default,,0000,0000,0000,,Иә? Оны ашу қиын...
Dialogue: 0,0:11:57.21,0:11:59.55,Default,,0000,0000,0000,,ашылды!
Dialogue: 0,0:11:57.21,0:11:59.55,Default,,0000,0000,0000,,О!
Dialogue: 0,0:11:59.55,0:12:02.65,Default,,0000,0000,0000,,Әй, ұстаз! Бұл туралы не ойлайсыз?
Dialogue: 0,0:11:59.55,0:12:02.65,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:12:02.65,0:12:05.65,Default,,0000,0000,0000,,Сенсей!
Dialogue: 0,0:12:05.65,0:12:08.49,Default,,0000,0000,0000,,Вааааааааааааааааа….
Dialogue: 0,0:12:08.49,0:12:12.33,Default,,0000,0000,0000,,Сенсей!
Dialogue: 0,0:12:08.49,0:12:12.33,Default,,0000,0000,0000,,Уау, өте сүйкімді!
Dialogue: 0,0:12:12.33,0:12:14.33,Default,,0000,0000,0000,,​​Уау...!
Dialogue: 0,0:12:18.17,0:12:20.50,Default,,0000,0000,0000,,Хигья! Ахх!
Dialogue: 0,0:12:20.50,0:12:22.50,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:22.50,0:12:25.34,Default,,0000,0000,0000,,Аха~ Әйтеуір...
Dialogue: 0,0:12:22.50,0:12:25.34,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:25.34,0:12:28.01,Default,,0000,0000,0000,,Уау! Чио-чан өте сүйкімді!
Dialogue: 0,0:12:25.34,0:12:28.01,Default,,0000,0000,0000,,Бұл не? Мо~!
Dialogue: 0,0:12:28.01,0:12:30.18,Default,,0000,0000,0000,,Уф! Алданбаңыз!
Dialogue: 0,0:12:30.18,0:12:33.38,Default,,0000,0000,0000,,Міне осылай сүйкімділікпен тартасың
Dialogue: 0,0:12:30.18,0:12:33.38,Default,,0000,0000,0000,,Сіз мені алдамақ болдыңыз!
Dialogue: 0,0:12:39.02,0:12:42.36,Default,,0000,0000,0000,,Дәл, Томо-чан
Dialogue: 0,0:12:39.02,0:12:42.36,Default,,0000,0000,0000,,Бірден жағымсыз нәрсені айту.
Dialogue: 0,0:12:42.36,0:12:45.86,Default,,0000,0000,0000,,Хмм, қазірдің өзінде...
Dialogue: 0,0:12:42.36,0:12:45.86,Default,,0000,0000,0000,,Ах, сондай сүйкімді...
Dialogue: 0,0:12:48.53,0:12:52.37,Default,,0000,0000,0000,,Жарайды, қонақтарды кіргізетін уақыт келді.
Dialogue: 0,0:12:48.53,0:12:52.37,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:12:52.37,0:12:54.54,Default,,0000,0000,0000,,Жүр, кеттік!
Dialogue: 0,0:12:54.54,0:12:57.04,Default,,0000,0000,0000,,Бірақ мен аздап қобалжыдым.
Dialogue: 0,0:12:57.04,0:13:00.14,Default,,0000,0000,0000,,Тұтынушы
Dialogue: 0,0:12:57.04,0:13:00.14,Default,,0000,0000,0000,,Қалайсыз ба?
Dialogue: 0,0:13:02.14,0:13:04.15,Default,,0000,0000,0000,,Сіз мұны істей алмайсыз!
Dialogue: 0,0:13:04.15,0:13:07.32,Default,,0000,0000,0000,,Қысымға берілме
Dialogue: 0,0:13:04.15,0:13:07.32,Default,,0000,0000,0000,,Жыл сайынғы мәдени фестиваль➡
Dialogue: 0,0:13:07.32,0:13:09.48,Default,,0000,0000,0000,,Көңілді болайық!
Dialogue: 0,0:13:09.48,0:13:12.49,Default,,0000,0000,0000,,Гимнастика жақсы.
Dialogue: 0,0:13:12.49,0:13:16.32,Default,,0000,0000,0000,,Сәлем, сәлем! Сәлем сәлем!
Dialogue: 0,0:13:16.32,0:13:19.49,Default,,0000,0000,0000,,Ио, сәлем, сәлем, сәлем! Ах!
Dialogue: 0,0:13:19.49,0:13:22.50,Default,,0000,0000,0000,,А, мен құладым!
Dialogue: 0,0:13:22.50,0:13:25.67,Default,,0000,0000,0000,,Өте сүйкімді...
Dialogue: 0,0:13:22.50,0:13:25.67,Default,,0000,0000,0000,,Тұру қиын!
Dialogue: 0,0:13:25.67,0:13:28.84,Default,,0000,0000,0000,,О! Мен өзім тұрдым!
Dialogue: 0,0:13:25.67,0:13:28.84,Default,,0000,0000,0000,,(Шапалақтау)
Dialogue: 0,0:13:28.84,0:13:31.01,Default,,0000,0000,0000,,Өйткені, бұл ағаш
Dialogue: 0,0:13:28.84,0:13:31.01,Default,,0000,0000,0000,,Бұл жақсырақ….
Dialogue: 0,0:13:31.01,0:13:33.01,Default,,0000,0000,0000,,Осака~!
Dialogue: 0,0:13:31.01,0:13:33.01,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:13:33.01,0:13:35.01,Default,,0000,0000,0000,,Сіз мұны дәл қазір көрдіңіз бе? ?
Dialogue: 0,0:13:35.01,0:13:37.01,Default,,0000,0000,0000,,Хмм, не?
Dialogue: 0,0:13:37.01,0:13:40.35,Default,,0000,0000,0000,,Чио-чанның пингвин гимнастикасы!
Dialogue: 0,0:13:37.01,0:13:40.35,Default,,0000,0000,0000,,Қарау біртүрлі.
Dialogue: 0,0:13:40.35,0:13:42.35,Default,,0000,0000,0000,,Идиот!
Dialogue: 0,0:13:40.35,0:13:42.35,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:42.35,0:13:44.85,Default,,0000,0000,0000,,《Неге? 》
Dialogue: 0,0:13:44.85,0:13:49.02,Default,,0000,0000,0000,,Иә, өтінемін!
Dialogue: 0,0:13:44.85,0:13:49.02,Default,,0000,0000,0000,,Қош келдіңіз!
Dialogue: 0,0:13:49.02,0:13:51.32,Default,,0000,0000,0000,,Сәлем, қош келдіңіз!
Dialogue: 0,0:14:05.64,0:14:09.14,Default,,0000,0000,0000,,Шармен балық аулау!
Dialogue: 0,0:14:05.64,0:14:09.14,Default,,0000,0000,0000,,Фестивальдардың барлығы шармен балық аулауға арналған!
Dialogue: 0,0:14:09.14,0:14:12.81,Default,,0000,0000,0000,,2/4 сынып кабинеті!
Dialogue: 0,0:14:12.81,0:14:15.82,Default,,0000,0000,0000,,Аа, мұғалім, шәй ішкіңіз келе ме?
Dialogue: 0,0:14:15.82,0:14:18.65,Default,,0000,0000,0000,,Ах~
Dialogue: 0,0:14:15.82,0:14:18.65,Default,,0000,0000,0000,,Сіз кофехананы басқарасыз ба?
Dialogue: 0,0:14:18.65,0:14:20.66,Default,,0000,0000,0000,,Сүйкімді емес пе?
Dialogue: 0,0:14:20.66,0:14:22.66,Default,,0000,0000,0000,,Бұл нені білдіреді деп ойлаймын.
Dialogue: 0,0:14:22.66,0:14:24.66,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:14:24.66,0:14:27.33,Default,,0000,0000,0000,,Балалар, сендер осылай істеп жатырсыңдар, сондықтан абай болуларың керек.
Dialogue: 0,0:14:27.33,0:14:29.33,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:14:29.33,0:14:32.53,Default,,0000,0000,0000,,Өлген мысықтың айыбы жоқ.
Dialogue: 0,0:14:29.33,0:14:32.53,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:14:37.34,0:14:39.84,Default,,0000,0000,0000,,Бұл күндері бос.
Dialogue: 0,0:14:39.84,0:14:41.84,Default,,0000,0000,0000,,Иә, онда мен оны осында қоямын.
Dialogue: 0,0:14:41.84,0:14:43.85,Default,,0000,0000,0000,,Терезенің жанында.
Dialogue: 0,0:14:43.85,0:14:46.18,Default,,0000,0000,0000,,Мен кофе аламын ба деп ойлаймын.
Dialogue: 0,0:14:43.85,0:14:46.18,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:14:46.18,0:14:49.02,Default,,0000,0000,0000,,Бір кофе!
Dialogue: 0,0:14:46.18,0:14:49.02,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:49.02,0:14:53.35,Default,,0000,0000,0000,,Хмм, өте күрделі нәрселер бар.
Dialogue: 0,0:14:53.35,0:14:56.52,Default,,0000,0000,0000,,Маған кофе әкелші~ Чиё-чан~.
Dialogue: 0,0:14:53.35,0:14:56.52,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:56.52,0:14:59.36,Default,,0000,0000,0000,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:14:56.52,0:14:59.36,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:14:59.36,0:15:01.30,Default,,0000,0000,0000,,Иә? Ах!
Dialogue: 0,0:15:01.30,0:15:04.13,Default,,0000,0000,0000,,бұл...
Dialogue: 0,0:15:04.13,0:15:07.14,Default,,0000,0000,0000,,Хахахаха.
Dialogue: 0,0:15:07.14,0:15:10.14,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:10.14,0:15:13.14,Default,,0000,0000,0000,,Хехехехе.
Dialogue: 0,0:15:13.14,0:15:15.98,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:15:15.98,0:15:18.08,Default,,0000,0000,0000,,Эхехехе.
Dialogue: 0,0:15:21.15,0:15:23.99,Default,,0000,0000,0000,,Ой...
Dialogue: 0,0:15:23.99,0:15:26.32,Default,,0000,0000,0000,,Иә, кофе.
Dialogue: 0,0:15:26.32,0:15:29.16,Default,,0000,0000,0000,,№.
Dialogue: 0,0:15:26.32,0:15:29.16,Default,,0000,0000,0000,,Өте сүйкімді.
Dialogue: 0,0:15:29.16,0:15:31.49,Default,,0000,0000,0000,,Сүт.
Dialogue: 0,0:15:29.16,0:15:31.49,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:15:31.49,0:15:34.16,Default,,0000,0000,0000,,Уақытыңызды бөліңіз!
Dialogue: 0,0:15:34.16,0:15:37.50,Default,,0000,0000,0000,,Ах, жақсысың ба, Чио-чан?
Dialogue: 0,0:15:37.50,0:15:40.84,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:15:40.84,0:15:43.17,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:15:43.17,0:15:45.17,Default,,0000,0000,0000,,Керемет….
Dialogue: 0,0:15:45.17,0:15:47.18,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:15:45.17,0:15:47.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:47.18,0:15:49.18,Default,,0000,0000,0000,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:15:49.18,0:15:51.51,Default,,0000,0000,0000,,Бұл сүйкімділікке ештеңе жетпейді➡
Dialogue: 0,0:15:51.51,0:15:54.02,Default,,0000,0000,0000,,Менің ойымша, басқа ештеңе жоқ!
Dialogue: 0,0:15:54.02,0:15:56.02,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,0:15:56.02,0:15:58.52,Default,,0000,0000,0000,,Неге сен?
Dialogue: 0,0:15:56.02,0:15:58.52,Default,,0000,0000,0000,,Сіз сондай мақтаншақсыз ба?
Dialogue: 0,0:15:58.52,0:16:00.46,Default,,0000,0000,0000,,Хмм? Хмф.
Dialogue: 0,0:16:00.46,0:16:03.46,Default,,0000,0000,0000,,Мен Чио Чанның сынып жетекшісімін~?
Dialogue: 0,0:16:03.46,0:16:07.30,Default,,0000,0000,0000,,Нямо, сен сол баланың сынып жетекшісі болғың келді, солай ма?
Dialogue: 0,0:16:07.30,0:16:10.13,Default,,0000,0000,0000,,Мен Ахахха болғым келді!
Dialogue: 0,0:16:10.13,0:16:13.63,Default,,0000,0000,0000,,《Бұл сынып
Dialogue: 0,0:16:10.13,0:16:13.63,Default,,0000,0000,0000,,Тек сынып мұғалімі бұрмаланған...》
Dialogue: 0,0:16:20.31,0:16:22.31,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:16:28.65,0:16:30.65,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:16:28.65,0:16:30.65,Default,,0000,0000,0000,,Қалай!
Dialogue: 0,0:16:30.65,0:16:34.16,Default,,0000,0000,0000,,Тапсырысыңыз ше?
Dialogue: 0,0:16:30.65,0:16:34.16,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:34.16,0:16:36.66,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:16:36.66,0:16:40.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:42.33,0:16:44.33,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:16:46.33,0:16:50.17,Default,,0000,0000,0000,,Даяшы мырза, тапсырыс беруге бола ма?
Dialogue: 0,0:16:46.33,0:16:50.17,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:50.17,0:16:52.51,Default,,0000,0000,0000,,Біз не істейміз?
Dialogue: 0,0:16:52.51,0:16:54.51,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:16:52.51,0:16:54.51,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:54.51,0:16:57.18,Default,,0000,0000,0000,,Сол қалпақ
Dialogue: 0,0:16:54.51,0:16:57.18,Default,,0000,0000,0000,,Сіз маған біреуін бере аласыз ба?
Dialogue: 0,0:16:57.18,0:17:00.28,Default,,0000,0000,0000,,Иә? міне, ұстаңыз.
Dialogue: 0,0:17:00.28,0:17:02.28,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:17:06.29,0:17:09.09,Default,,0000,0000,0000,,Жоқ! Ия, иә, иә!
Dialogue: 0,0:17:11.13,0:17:13.96,Default,,0000,0000,0000,,Орындалды.
Dialogue: 0,0:17:11.13,0:17:13.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:13.96,0:17:16.30,Default,,0000,0000,0000,,Толтырылған жануарлар кафесі!
Dialogue: 0,0:17:13.96,0:17:16.30,Default,,0000,0000,0000,,Э? Естімеймін.
Dialogue: 0,0:17:16.30,0:17:19.63,Default,,0000,0000,0000,,Өте сүйкімді! Толтырылған жануарлар дәмханасы!
Dialogue: 0,0:17:16.30,0:17:19.63,Default,,0000,0000,0000,,Ай!
Dialogue: 0,0:17:19.63,0:17:21.80,Default,,0000,0000,0000,,Жақын кел!
Dialogue: 0,0:17:19.63,0:17:21.80,Default,,0000,0000,0000,,Ой~!
Dialogue: 0,0:17:21.80,0:17:24.64,Default,,0000,0000,0000,,Келіңіздер, бұл сүйкімді!
Dialogue: 0,0:17:24.64,0:17:27.31,Default,,0000,0000,0000,,Тартуға көмектесу
Dialogue: 0,0:17:24.64,0:17:27.31,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:17:27.31,0:17:29.31,Default,,0000,0000,0000,,Э~?
Dialogue: 0,0:17:29.31,0:17:31.61,Default,,0000,0000,0000,,О, қой, қоя бер
Dialogue: 0,0:17:29.31,0:17:31.61,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:17:34.65,0:17:38.49,Default,,0000,0000,0000,,Бұл Кагура~ Оның бойы 156 см➡
Dialogue: 0,0:17:38.49,0:17:41.16,Default,,0000,0000,0000,,Оның мектеп фестиваліне қатысы жоқ!
Dialogue: 0,0:17:41.16,0:17:44.99,Default,,0000,0000,0000,,А, Сакаки... Мм...
Dialogue: 0,0:17:44.99,0:17:46.99,Default,,0000,0000,0000,,Кел, сүйкімді!
Dialogue: 0,0:17:50.00,0:17:52.83,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:17:50.00,0:17:52.83,Default,,0000,0000,0000,,Сүйкімді болды Сүйкімді болды.
Dialogue: 0,0:17:52.83,0:17:55.00,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:17:55.00,0:17:58.17,Default,,0000,0000,0000,,Иә? Каорин де
Dialogue: 0,0:17:55.00,0:17:58.17,Default,,0000,0000,0000,,Бұл қалпақ болды ма?
Dialogue: 0,0:17:58.17,0:18:01.11,Default,,0000,0000,0000,,Әй, дәл осы уақытқа дейін.
Dialogue: 0,0:17:58.17,0:18:01.11,Default,,0000,0000,0000,,Ол сол жерде болды...
Dialogue: 0,0:18:01.11,0:18:03.95,Default,,0000,0000,0000,,Ах! Бұл мен Кимураға қарызға бергенім бе?
Dialogue: 0,0:18:03.95,0:18:05.95,Default,,0000,0000,0000,,Ол әлі оралмады ма?
Dialogue: 0,0:18:05.95,0:18:09.28,Default,,0000,0000,0000,,Жақсы! Каориннің әкесінің қалпағы
Dialogue: 0,0:18:05.95,0:18:09.28,Default,,0000,0000,0000,,Барып қайтарайық!
Dialogue: 0,0:18:09.28,0:18:12.29,Default,,0000,0000,0000,,Сізге барудың қажеті жоқ.
Dialogue: 0,0:18:12.29,0:18:14.46,Default,,0000,0000,0000,,Сіз мектепті үнемі кезіп жүрдіңіз, солай ма?
Dialogue: 0,0:18:14.46,0:18:16.46,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:18:16.46,0:18:18.63,Default,,0000,0000,0000,,О, Чио-чан.
Dialogue: 0,0:18:16.46,0:18:18.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:18.63,0:18:21.13,Default,,0000,0000,0000,,Тұтынушылар саны азайды➡
Dialogue: 0,0:18:21.13,0:18:23.30,Default,,0000,0000,0000,,Үзілістерді ретімен жасаңыз
Dialogue: 0,0:18:21.13,0:18:23.30,Default,,0000,0000,0000,,Оны алған жақсы емес пе?
Dialogue: 0,0:18:23.30,0:18:25.30,Default,,0000,0000,0000,,Ммм, дәмді екен.
Dialogue: 0,0:18:25.30,0:18:28.14,Default,,0000,0000,0000,,Ендеше мен бірінші боламын... Атта!
Dialogue: 0,0:18:28.14,0:18:30.81,Default,,0000,0000,0000,,Осакадан Чио-чанмен бірге
Dialogue: 0,0:18:28.14,0:18:30.81,Default,,0000,0000,0000,,Алдымен үзіліс жасаңыз.
Dialogue: 0,0:18:30.81,0:18:35.14,Default,,0000,0000,0000,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:18:30.81,0:18:35.14,Default,,0000,0000,0000,,Яй, Чио-чан, кеттік.
Dialogue: 0,0:18:35.14,0:18:37.31,Default,,0000,0000,0000,,Мен әртүрлі заттарды сатып аламын және жеймін!
Dialogue: 0,0:18:37.31,0:18:39.31,Default,,0000,0000,0000,,Бір минут күте тұрыңыз, Чио-чан!
Dialogue: 0,0:18:39.31,0:18:41.32,Default,,0000,0000,0000,,Мектепті аралағыңыз келсе➡
Dialogue: 0,0:18:41.32,0:18:44.32,Default,,0000,0000,0000,,Сонымен қатар, мен де біраз жарнама жасадым...!
Dialogue: 0,0:18:44.32,0:18:47.32,Default,,0000,0000,0000,,О, бұл тамаша!
Dialogue: 0,0:18:47.32,0:18:49.32,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:18:49.32,0:18:51.99,Default,,0000,0000,0000,,Мен мектеп фестивалін тамашалаймын.
Dialogue: 0,0:18:51.99,0:18:55.16,Default,,0000,0000,0000,,Келесі мен.
Dialogue: 0,0:18:51.99,0:18:55.16,Default,,0000,0000,0000,,Даналық кейінге қалдырылды.
Dialogue: 0,0:18:55.16,0:18:57.16,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:55.16,0:18:57.16,Default,,0000,0000,0000,,Аха!
Dialogue: 0,0:18:59.17,0:19:02.77,Default,,0000,0000,0000,,Осака-сан, бұл такояки!
Dialogue: 0,0:18:59.17,0:19:02.77,Default,,0000,0000,0000,,Хонма!
Dialogue: 0,0:19:02.77,0:19:05.27,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:19:02.77,0:19:05.27,Default,,0000,0000,0000,,Такояки мектеп фестивалінде➡
Dialogue: 0,0:19:05.27,0:19:08.28,Default,,0000,0000,0000,,Оны есте сақтаңыз
Dialogue: 0,0:19:05.27,0:19:08.28,Default,,0000,0000,0000,,Ештеңе.
Dialogue: 0,0:19:08.28,0:19:10.78,Default,,0000,0000,0000,,Тамақтану.
Dialogue: 0,0:19:08.28,0:19:10.78,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:19:10.78,0:19:12.78,Default,,0000,0000,0000,,Шыдамдылығыңыз үшін рахмет.
Dialogue: 0,0:19:12.78,0:19:15.78,Default,,0000,0000,0000,,Ммм.
Dialogue: 0,0:19:15.78,0:19:18.12,Default,,0000,0000,0000,,Дәмді көрінеді.
Dialogue: 0,0:19:18.12,0:19:20.12,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:19:18.12,0:19:20.12,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:19:20.12,0:19:22.62,Default,,0000,0000,0000,,Мен оны жей алмаймын, өйткені ол келмейді...
Dialogue: 0,0:19:22.62,0:19:24.79,Default,,0000,0000,0000,,Бұл мәселе болар еді...
Dialogue: 0,0:19:24.79,0:19:27.63,Default,,0000,0000,0000,,Шынымды айтсам, Чио-чан, «А!»
Dialogue: 0,0:19:27.63,0:19:30.97,Default,,0000,0000,0000,,Аа... Ах!
Dialogue: 0,0:19:27.63,0:19:30.97,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:19:30.97,0:19:32.97,Default,,0000,0000,0000,,Ммм!
Dialogue: 0,0:19:32.97,0:19:36.30,Default,,0000,0000,0000,,Бұл дәмді ме?
Dialogue: 0,0:19:32.97,0:19:36.30,Default,,0000,0000,0000,,Саған жақсы, Чиё-чан.
Dialogue: 0,0:19:36.30,0:19:38.47,Default,,0000,0000,0000,,Бұл дәмді!
Dialogue: 0,0:19:38.47,0:19:40.47,Default,,0000,0000,0000,,Чиё-чан, саған такояки ұнай ма?
Dialogue: 0,0:19:40.47,0:19:43.07,Default,,0000,0000,0000,,Иә, мен сені қазірдің өзінде жақсы көремін!
Dialogue: 0,0:19:46.65,0:19:50.99,Default,,0000,0000,0000,,Осака мырза, бұл жолы тайяки, не істеуіміз керек?
Dialogue: 0,0:19:50.99,0:19:55.16,Default,,0000,0000,0000,,Әрине мектеп фестивалінде
Dialogue: 0,0:19:50.99,0:19:55.16,Default,,0000,0000,0000,,Тайякиді де жемеңіз.
Dialogue: 0,0:19:55.16,0:19:57.66,Default,,0000,0000,0000,,Тайяки
Dialogue: 0,0:19:55.16,0:19:57.66,Default,,0000,0000,0000,,Бірден, өтінемін!
Dialogue: 0,0:19:59.66,0:20:02.33,Default,,0000,0000,0000,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:19:59.66,0:20:02.33,Default,,0000,0000,0000,,Итадакимасу... Ах.
Dialogue: 0,0:20:02.33,0:20:06.67,Default,,0000,0000,0000,,Міне, солай! Тайяки
Dialogue: 0,0:20:02.33,0:20:06.67,Default,,0000,0000,0000,,Басынан жейтін адамдар➡
Dialogue: 0,0:20:06.67,0:20:09.34,Default,,0000,0000,0000,,Құйрықтан
Dialogue: 0,0:20:06.67,0:20:09.34,Default,,0000,0000,0000,,Тамақ ішетін адам бар ма?
Dialogue: 0,0:20:09.34,0:20:12.17,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:20:09.34,0:20:12.17,Default,,0000,0000,0000,,Ең алдымен қайсысын жеу керек?
Dialogue: 0,0:20:12.17,0:20:14.68,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:20:12.17,0:20:14.68,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:20:14.68,0:20:18.35,Default,,0000,0000,0000,,Чио-чан: «Ах!»
Dialogue: 0,0:20:14.68,0:20:18.35,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:18.35,0:20:20.35,Default,,0000,0000,0000,,Чио-чан бірінші барады ма?
Dialogue: 0,0:20:20.35,0:20:22.35,Default,,0000,0000,0000,,Құйрықтан шығамыз ба?
Dialogue: 0,0:20:22.35,0:20:24.35,Default,,0000,0000,0000,,Басынан бастаңыз.
Dialogue: 0,0:20:24.35,0:20:26.85,Default,,0000,0000,0000,,Жарайды, сәлем.
Dialogue: 0,0:20:24.35,0:20:26.85,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:20:26.85,0:20:29.52,Default,,0000,0000,0000,,Хмм, бұл дәмді!
Dialogue: 0,0:20:29.52,0:20:31.62,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:20:29.52,0:20:31.62,Default,,0000,0000,0000,,Сізге тайяки ұнайды ма?
Dialogue: 0,0:20:34.70,0:20:38.03,Default,,0000,0000,0000,,Менің орта мектебімде мектеп мерекесі бар.
Dialogue: 0,0:20:34.70,0:20:38.03,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:20:38.03,0:20:41.87,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:20:38.03,0:20:41.87,Default,,0000,0000,0000,,Себебі менде мектеп фестивалі бар➡
Dialogue: 0,0:20:41.87,0:20:45.54,Default,,0000,0000,0000,,1 жыл қызық
Dialogue: 0,0:20:41.87,0:20:45.54,Default,,0000,0000,0000,,Бұл мен өмір сүре алатын нәрсе.
Dialogue: 0,0:20:45.54,0:20:47.54,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:20:49.54,0:20:53.38,Default,,0000,0000,0000,,Мен қайтып келдім!
Dialogue: 0,0:20:49.54,0:20:53.38,Default,,0000,0000,0000,,Маған қатты ұнады!
Dialogue: 0,0:20:53.38,0:20:55.38,Default,,0000,0000,0000,,Чио-чан, сен қандай жарнама жасадың?
Dialogue: 0,0:20:53.38,0:20:55.38,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:55.38,0:20:57.38,Default,,0000,0000,0000,,Жарнама әсері тым көп!
Dialogue: 0,0:20:57.38,0:20:59.99,Default,,0000,0000,0000,,Демалуға уақыт жоқ!
Dialogue: 0,0:20:59.99,0:21:01.99,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:21:01.99,0:21:03.99,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:21:01.99,0:21:03.99,Default,,0000,0000,0000,,Бұл пингвин!
Dialogue: 0,0:21:03.99,0:21:05.99,Default,,0000,0000,0000,,Өте сүйкімді!
Dialogue: 0,0:21:05.99,0:21:08.83,Default,,0000,0000,0000,,Жоқ, сатылды, сатылды!
Dialogue: 0,0:21:08.83,0:21:11.50,Default,,0000,0000,0000,,Мен шаршадым!
Dialogue: 0,0:21:08.83,0:21:11.50,Default,,0000,0000,0000,,Бұл үлкен хит болды.
Dialogue: 0,0:21:11.50,0:21:14.17,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:21:14.17,0:21:16.17,Default,,0000,0000,0000,,Чиёчан!
Dialogue: 0,0:21:14.17,0:21:16.17,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:21:16.17,0:21:19.87,Default,,0000,0000,0000,,Қалған шырынмен тост жасайық!
Dialogue: 0,0:21:16.17,0:21:19.87,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:21:22.34,0:21:24.35,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:24.35,0:21:32.35,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:32.35,0:21:34.36,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:21:34.36,0:21:36.52,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:36.52,0:21:44.70,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:44.70,0:21:46.87,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:21:46.87,0:21:53.67,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:55.17,0:22:01.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory