Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.83,0:00:07.30,Default,,0,0,0,,Лу Ла Лу Ла Пианино - әлемдік
Dialogue: 0,0:00:07.33,0:00:10.81,Default,,0,0,0,,Арман гүлдеген далада әуен
Dialogue: 0,0:00:10.84,0:00:14.27,Default,,0,0,0,,Сынған сағатқа сену
Dialogue: 0,0:00:14.30,0:00:17.73,Default,,0,0,0,,Уақыт сенің жаныңда кім?
Dialogue: 0,0:00:17.76,0:00:21.10,Default,,0,0,0,,Менің кеудем неге үлкен?
Dialogue: 0,0:00:21.31,0:00:24.72,Default,,0,0,0,,Сіз мейірімді адамды күтесіз бе?
Dialogue: 0,0:00:24.80,0:00:28.29,Default,,0,0,0,,Маған тамаша болашағыңыз туралы айтып беріңіз
Dialogue: 0,0:00:28.32,0:00:28.99,Default,,0,0,0,,Ай
Dialogue: 0,0:00:29.08,0:00:29.84,Default,,0,0,0,,Жарық
Dialogue: 0,0:00:29.96,0:00:31.70,Default,,0,0,0,,Ай сәулесі ұйықтап жатыр
Dialogue: 0,0:00:31.73,0:00:35.27,Default,,0,0,0,,Лу Ла Лу Ла Есте сақтау алмасына
Dialogue: 0,0:00:35.30,0:00:38.64,Default,,0,0,0,,Оянған қыз мені сүйеді
Dialogue: 0,0:00:38.68,0:00:42.19,Default,,0,0,0,,Азаппен жайылған кітапта
Dialogue: 0,0:00:42.22,0:00:45.46,Default,,0,0,0,,Екі қоңырау соғылады
Dialogue: 0,0:00:45.61,0:00:48.90,Default,,0,0,0,,Мен жақсы көретін адам, өйткені мен оны құшақтағым келеді
Dialogue: 0,0:00:49.14,0:00:52.67,Default,,0,0,0,,Енді жылама Қош бол қайғы
Dialogue: 0,0:00:52.69,0:00:56.17,Default,,0,0,0,,Жұмбақ есіктегі жазу
Dialogue: 0,0:00:56.20,0:00:59.61,Default,,0,0,0,,«Сорамими торты»
Dialogue: 0,0:00:59.63,0:01:00.94,Default,,0,0,0,,Ғажайыптар әлемі!
Dialogue: 0,0:01:00.97,0:01:02.69,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:02.72,0:01:04.01,Default,,0,0,0,,Ертегілер елі!
Dialogue: 0,0:01:04.04,0:01:05.68,Default,,0,0,0,,Бұл махаббаттың сиқыры
Dialogue: 0,0:01:05.71,0:01:07.02,Default,,0,0,0,,Махаббат бәрібір!
Dialogue: 0,0:01:07.05,0:01:08.80,Default,,0,0,0,,Күн сайын үлпілдек
Dialogue: 0,0:01:08.83,0:01:12.29,Default,,0,0,0,,Бидайдың азғыруы
Dialogue: 0,0:01:12.32,0:01:13.59,Default,,0,0,0,,Сізге арналған торт!
Dialogue: 0,0:01:13.62,0:01:15.32,Default,,0,0,0,,Бүгін кешке тамақтаныңыз.
Dialogue: 0,0:01:15.34,0:01:16.66,Default,,0,0,0,,Сізге шай!
Dialogue: 0,0:01:16.69,0:01:18.38,Default,,0,0,0,,Шоқжұлдыз шай ішу
Dialogue: 0,0:01:18.40,0:01:19.69,Default,,0,0,0,,Терезеде
Dialogue: 0,0:01:19.72,0:01:21.46,Default,,0,0,0,,Періштелер хоры
Dialogue: 0,0:01:21.49,0:01:24.87,Default,,0,0,0,,Құлағыңыз бос па?
Dialogue: 0,0:01:24.90,0:01:28.46,Default,,0,0,0,,Мен сені сүйемін, мен сені сүйемін дауыс
Dialogue: 0,0:01:39.01,0:01:40.46,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:01:40.49,0:01:42.69,Default,,0,0,0,,Спорт мерекесі осында аяқталды.
Dialogue: 0,0:01:44.13,0:01:44.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:54.33,0:01:55.43,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:01:55.77,0:01:58.86,Default,,0,0,0,,Менің ойымша, гимнастикаға арналған киім-кешектерді гүл шоқтарының ішіне салған дұрыс.
Dialogue: 0,0:02:02.07,0:02:03.00,Default,,0,0,0,,Олай болса, ұстаз!
Dialogue: 0,0:02:03.05,0:02:04.20,Default,,0,0,0,,Ер балаларға арналған спорттық киім
Dialogue: 0,0:02:04.23,0:02:06.12,Default,,0,0,0,,Оны салған дұрыс па, әлде шығарған дұрыс па?
Dialogue: 0,0:02:13.17,0:02:15.48,Default,,0,0,0,,Не дедіңіз...
Dialogue: 0,0:02:15.50,0:02:16.77,Default,,0,0,0,,Сабақ барысында...
Dialogue: 0,0:02:16.79,0:02:17.63,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:02:18.25,0:02:19.83,Default,,0,0,0,,Жақында спорт мерекесі болады
Dialogue: 0,0:02:20.77,0:02:22.53,Default,,0,0,0,,Токио спорт фестивалі
Dialogue: 0,0:02:23.54,0:02:28.19,Default,,0,0,0,,Мен Токио спорт фестиваліне бірінші рет қатысып отырмын, сондықтан мен оны асыға күтемін.
Dialogue: 0,0:02:28.69,0:02:31.61,Default,,0,0,0,,Токио мен Осака арасында қандай да бір айырмашылықтар бар ма?
Dialogue: 0,0:02:31.88,0:02:34.61,Default,,0,0,0,,Иә, бұл мүлдем басқаша.
Dialogue: 0,0:02:34.82,0:02:36.65,Default,,0,0,0,,Қалай?
Dialogue: 0,0:02:37.17,0:02:38.83,Default,,0,0,0,,Осака спорт фестивалі
Dialogue: 0,0:02:38.86,0:02:41.59,Default,,0,0,0,,Бірінші орынды жеңіп алсаңыз, ол сізге такояки береді.
Dialogue: 0,0:02:45.00,0:02:47.06,Default,,0,0,0,,Кешіріңіз, бұл өтірік.
Dialogue: 0,0:02:49.88,0:02:51.30,Default,,0,0,0,,Спорт мерекесі туралы айту
Dialogue: 0,0:02:51.37,0:02:53.83,Default,,0,0,0,,Ақыры менің кезегім келді.
Dialogue: 0,0:02:53.85,0:02:56.93,Default,,0,0,0,,Жанып жатыр! Жанып жатыр!
Dialogue: 0,0:02:57.17,0:02:57.99,Default,,0,0,0,,Бұрылу?
Dialogue: 0,0:02:58.39,0:02:59.06,Default,,0,0,0,,Не?
Dialogue: 0,0:02:59.19,0:03:00.84,Default,,0,0,0,,Ху ха ха ха
Dialogue: 0,0:03:00.86,0:03:03.29,Default,,0,0,0,,Қысқа және орташа қашықтыққа марафон
Dialogue: 0,0:03:03.31,0:03:05.98,Default,,0,0,0,,Ұзындыққа және биіктікке секіруде бұл атты әскер шайқасы
Dialogue: 0,0:03:06.00,0:03:08.91,Default,,0,0,0,,Барлығында бірінші орынға ұмтылыңыз!
Dialogue: 0,0:03:10.32,0:03:13.08,Default,,0,0,0,,Менің ойымша, кез келген адам жай ғана көздей алады.
Dialogue: 0,0:03:13.50,0:03:15.77,Default,,0,0,0,,Ахахахаха
Dialogue: 0,0:03:15.90,0:03:18.16,Default,,0,0,0,,Томо-чан үшін бұл мүмкін емес.
Dialogue: 0,0:03:18.22,0:03:18.91,Default,,0,0,0,,Не? !!
Dialogue: 0,0:03:19.67,0:03:23.23,Default,,0,0,0,,Өйткені Сакаки-сан осында.
Dialogue: 0,0:03:23.26,0:03:25.07,Default,,0,0,0,,Сакаки спортпен шұғылданады
Dialogue: 0,0:03:25.09,0:03:27.71,Default,,0,0,0,,Сатоши-чанның жеңу мүмкіндігі жоқ.
Dialogue: 0,0:03:27.92,0:03:29.09,Default,,0,0,0,,Хаа
Dialogue: 0,0:03:29.12,0:03:32.20,Default,,0,0,0,,Оның спорт мерекесінде ең керемет болатынына сенімдімін.
Dialogue: 0,0:03:32.58,0:03:35.51,Default,,0,0,0,,Хмф, онда мен сүйкімділік бойынша жарысамын!
Dialogue: 0,0:03:35.53,0:03:36.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:37.21,0:03:39.73,Default,,0,0,0,,Спорт мерекесінде сүйкімділігіңді көрсет
Dialogue: 0,0:03:39.75,0:03:40.47,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:03:40.49,0:03:44.83,Default,,0,0,0,,Мені немесе Сакаки-санды таңдауға бүкіл мектеп дауыс береді!
Dialogue: 0,0:03:44.89,0:03:47.82,Default,,0,0,0,,Әрине, мен жеңдім!
Dialogue: 0,0:03:47.85,0:03:49.15,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:03:49.18,0:03:51.79,Default,,0,0,0,,Сүйкімді болғаннан гөрі салқын болған жақсы!
Dialogue: 0,0:03:51.81,0:03:54.33,Default,,0,0,0,,Не?! Сүйкімділері жақсырақ!
Dialogue: 0,0:03:54.35,0:03:55.09,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:03:55.26,0:03:56.35,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:03:56.51,0:03:59.31,Default,,0,0,0,,Nnnnnnnnn
Dialogue: 0,0:03:59.61,0:04:03.30,Default,,0,0,0,,Күнтізбе! Қайсысы жақсы деп ойлайсыз?
Dialogue: 0,0:04:04.72,0:04:06.20,Default,,0,0,0,,Қайсысы да жақсы.
Dialogue: 0,0:04:13.65,0:04:14.75,Default,,0,0,0,,Барлығының назарына!
Dialogue: 0,0:04:15.20,0:04:17.90,Default,,0,0,0,,Осы екі әріпті осы жерде барлығына берейік.
Dialogue: 0,0:04:18.38,0:04:19.33,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:19.53,0:04:21.03,Default,,0,0,0,,Жеңіс!
Dialogue: 0,0:04:21.90,0:04:22.78,Default,,0,0,0,,Жеңіс?
Dialogue: 0,0:04:23.44,0:04:24.79,Default,,0,0,0,,Алдағы спорт мерекесі
Dialogue: 0,0:04:24.81,0:04:26.07,Default,,0,0,0,,Көңіл-күйлеріңіз көтеріңкі болсын!
Dialogue: 0,0:04:26.10,0:04:27.60,Default,,0,0,0,,Ал жеңіңіз!
Dialogue: 0,0:04:27.63,0:04:29.82,Default,,0,0,0,,Әсіресе 5-сынып үшін!
Dialogue: 0,0:04:30.37,0:04:31.79,Default,,0,0,0,,Неліктен бес сынып?
Dialogue: 0,0:04:32.30,0:04:35.20,Default,,0,0,0,,Қараңызшы, бұл Куросава мырзаның сыныбы.
Dialogue: 0,0:04:35.23,0:04:36.18,Default,,0,0,0,,Ах
Dialogue: 0,0:04:36.25,0:04:39.20,Default,,0,0,0,,Ештеңеге қарамастан жеңу туралы ойла!
Dialogue: 0,0:04:40.13,0:04:43.11,Default,,0,0,0,,Қажет болса, мен не қажет болса, соны істеймін!
Dialogue: 0,0:04:43.50,0:04:45.56,Default,,0,0,0,,Олар не айтса да
Dialogue: 0,0:04:46.10,0:04:47.55,Default,,0,0,0,,Олай болса, Юкари-чан!
Dialogue: 0,0:04:47.58,0:04:49.97,Default,,0,0,0,,Егер сіз жеңсеңіз, барлығына шырын сатып алыңыз
Dialogue: 0,0:04:50.22,0:04:51.14,Default,,0,0,0,,Шырын?
Dialogue: 0,0:04:52.00,0:04:56.20,Default,,0,0,0,,Жақсы, бір бөтелкеге ​​120 иен.
Dialogue: 0,0:05:03.71,0:05:06.83,Default,,0,0,0,,Жақсы! Жеңсем, бірдеңе сатып аламын
Dialogue: 0,0:05:07.14,0:05:08.99,Default,,0,0,0,,Қанша бәс тігесіз?
Dialogue: 0,0:05:09.77,0:05:11.92,Default,,0,0,0,,Ертең күн ашық болады деп үміттенемін
Dialogue: 0,0:05:11.94,0:05:14.45,Default,,0,0,0,,Теру теру бозуымды безендіремін.
Dialogue: 0,0:05:15.09,0:05:17.30,Default,,0,0,0,,Эй, мен мұны істеп көремін.
Dialogue: 0,0:05:17.40,0:05:18.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:19.85,0:05:21.55,Default,,0,0,0,,Мен мұны сол жерге лақтырамын.
Dialogue: 0,0:05:21.74,0:05:24.11,Default,,0,0,0,,Ах! Бұл ауа райы болжамы
Dialogue: 0,0:05:25.15,0:05:25.95,Default,,0,0,0,,Пун
Dialogue: 0,0:05:39.04,0:05:40.81,Default,,0,0,0,,Чихиро неде пайда болады?
Dialogue: 0,0:05:40.83,0:05:42.62,Default,,0,0,0,,Эстафеталық және атты әскер шайқасы.
Dialogue: 0,0:05:42.75,0:05:44.76,Default,,0,0,0,,Мен күнтізбеге кіре алмаймын.
Dialogue: 0,0:05:44.84,0:05:45.88,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:05:46.27,0:05:47.63,Default,,0,0,0,,Күн ашық, солай емес пе?
Dialogue: 0,0:05:47.91,0:05:50.28,Default,,0,0,0,,Сіз бұл аяқ киімді алдыңызда жасадыңыз.
Dialogue: 0,0:05:50.56,0:05:53.71,Default,,0,0,0,,Енді спорт мерекесін бастайық.
Dialogue: 0,0:05:54.84,0:05:55.90,Default,,0,0,0,,Ең алдымен
Dialogue: 0,0:05:56.24,0:05:59.15,Default,,0,0,0,,Спорт фестивалінің Атқару комитеті төрағасының сәлемі
Dialogue: 0,0:06:05.92,0:06:07.16,Default,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:06:11.00,0:06:15.73,Default,,0,0,0,,Бірінші жүлде! !
Dialogue: 0,0:06:28.10,0:06:29.61,Default,,0,0,0,,Чиёчан
Dialogue: 0,0:06:30.02,0:06:30.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:30.99,0:06:32.38,Default,,0,0,0,,Кокчи кокчи
Dialogue: 0,0:06:34.05,0:06:35.59,Default,,0,0,0,,Содан кейін оны басыңыз.
Dialogue: 0,0:06:35.61,0:06:37.16,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:06:39.54,0:06:40.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:43.78,0:06:45.14,Default,,0,0,0,,Эхехе (lol)
Dialogue: 0,0:06:46.63,0:06:47.50,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:06:47.53,0:06:48.42,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:53.79,0:06:56.56,Default,,0,0,0,,Жарайды, біраз созылайық! созылу!
Dialogue: 0,0:06:56.58,0:06:58.20,Default,,0,0,0,,Сенде бәрі жақсы.
Dialogue: 0,0:06:58.47,0:06:59.93,Default,,0,0,0,,Жарайды, мен сенің арқаңнан сипап қояйын.
Dialogue: 0,0:06:59.95,0:07:02.05,Default,,0,0,0,,Мм, түсіндім...
Dialogue: 0,0:07:02.19,0:07:03.15,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:07:03.19,0:07:05.87,Default,,0,0,0,,Пюун
Dialogue: 0,0:07:05.90,0:07:08.29,Default,,0,0,0,,Мен сенің сыныбыңнан жеңілмеймін!
Dialogue: 0,0:07:08.31,0:07:10.23,Default,,0,0,0,,Біз де жеңілмейміз.
Dialogue: 0,0:07:10.50,0:07:11.39,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:11.41,0:07:13.77,Default,,0,0,0,,Менің сыныбымда Сакаки бар.
Dialogue: 0,0:07:13.79,0:07:16.01,Default,,0,0,0,,Менің жеңіліп қалуым мүмкін емес.
Dialogue: 0,0:07:16.59,0:07:19.12,Default,,0,0,0,,Бізде де бір керемет адам бар!
Dialogue: 0,0:07:19.15,0:07:20.01,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:07:20.04,0:07:22.88,Default,,0,0,0,,Бұл Хикио, Хикио!
Dialogue: 0,0:07:22.99,0:07:24.15,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:24.18,0:07:24.94,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:27.11,0:07:28.35,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,0:07:28.38,0:07:29.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:29.80,0:07:32.42,Default,,0,0,0,,5-сыныптағы ұлы жігіт кім? айтшы
Dialogue: 0,0:07:32.54,0:07:33.85,Default,,0,0,0,,5-сынып?
Dialogue: 0,0:07:34.18,0:07:36.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:36.92,0:07:39.22,Default,,0,0,0,,Ах! Егер солай болса, бұл Кагура-сан.
Dialogue: 0,0:07:39.85,0:07:40.72,Default,,0,0,0,,Кагура?
Dialogue: 0,0:07:41.31,0:07:43.28,Default,,0,0,0,,Қараңызшы, бұл сол адам.
Dialogue: 0,0:07:45.34,0:07:47.65,Default,,0,0,0,,Куросава мырзаның жүзу клубының мүшелігі
Dialogue: 0,0:07:48.00,0:07:51.25,Default,,0,0,0,,Бұл жай ғана жүзу емес, спортпен шұғылдану.
Dialogue: 0,0:07:54.84,0:07:56.07,Default,,0,0,0,,Кагура-сан
Dialogue: 0,0:07:56.38,0:07:56.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:58.37,0:08:00.33,Default,,0,0,0,,Эй, сен анпан жегің келе ме?
Dialogue: 0,0:08:00.52,0:08:01.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:02.34,0:08:02.94,Default,,0,0,0,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:08:04.33,0:08:05.92,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:08:06.34,0:08:07.14,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:08:07.47,0:08:08.90,Default,,0,0,0,,Сәлем Юкари!
Dialogue: 0,0:08:09.32,0:08:11.15,Default,,0,0,0,,Не істеп жатырсың?!
Dialogue: 0,0:08:11.22,0:08:12.05,Default,,0,0,0,,Цк
Dialogue: 0,0:08:13.55,0:08:15.50,Default,,0,0,0,,Жарайды, бәрі жинал!
Dialogue: 0,0:08:17.11,0:08:18.25,Default,,0,0,0,,Олай болса, Ачио-чан
Dialogue: 0,0:08:18.41,0:08:18.99,Default,,0,0,0,,Иә
Dialogue: 0,0:08:19.34,0:08:21.31,Default,,0,0,0,,Барлығына жігер беретін сөздер
Dialogue: 0,0:08:21.37,0:08:22.08,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:26.50,0:08:28.31,Default,,0,0,0,,Мм...
Dialogue: 0,0:08:30.10,0:08:31.35,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:08:31.71,0:08:34.32,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:08:35.05,0:08:36.60,Default,,0,0,0,,Дебют
Dialogue: 0,0:08:36.92,0:08:37.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:38.45,0:08:41.63,Default,,0,0,0,,Уау, мен барлығын ұстадым.
Dialogue: 0,0:08:42.09,0:08:44.93,Default,,0,0,0,,Мен үшін жеңілсең...
Dialogue: 0,0:08:44.95,0:08:46.75,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:46.77,0:08:48.87,Default,,0,0,0,,Спорт мерекесі тек көңіл көтеру үшін.
Dialogue: 0,0:08:48.90,0:08:49.90,Default,,0,0,0,,Тиісті
Dialogue: 0,0:08:49.92,0:08:51.20,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:08:51.25,0:08:51.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:52.87,0:08:53.95,Default,,0,0,0,,Жақсы балалар
Dialogue: 0,0:08:54.07,0:08:55.99,Default,,0,0,0,,Мен бүгін міндетті түрде жеңемін!
Dialogue: 0,0:08:56.19,0:08:58.50,Default,,0,0,0,,Спорт мерекесі тек көңіл көтеру үшін деп ойламаңыз.
Dialogue: 0,0:08:58.52,0:09:00.46,Default,,0,0,0,,Барлығын ұстамаңыз!
Dialogue: 0,0:09:01.40,0:09:02.38,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:09:02.95,0:09:03.55,Default,,0,0,0,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,0:09:03.58,0:09:05.36,Default,,0,0,0,,Жарайсыңдар бәріңе
Dialogue: 0,0:09:05.45,0:09:07.26,Default,,0,0,0,,Көңіл-күйімізді көтерейік!
Dialogue: 0,0:09:07.88,0:09:10.21,Default,,0,0,0,,Чио-чанға не болды? Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:09:10.24,0:09:11.43,Default,,0,0,0,,Иә, тағы бір рет!
Dialogue: 0,0:09:11.46,0:09:12.74,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:09:12.95,0:09:15.92,Default,,0,0,0,,400 метрге жүгіруге қатысатын спортшылар
Dialogue: 0,0:09:15.94,0:09:18.18,Default,,0,0,0,,Кіре берісте кездесіңіз.
Dialogue: 0,0:09:19.04,0:09:20.62,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:09:20.91,0:09:22.99,Default,,0,0,0,,Мен үшін жеңілсең...
Dialogue: 0,0:09:26.46,0:09:28.50,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:09:31.79,0:09:33.37,Default,,0,0,0,,Сакаки мырза
Dialogue: 0,0:09:35.32,0:09:36.64,Default,,0,0,0,,Қуа——!!
Dialogue: 0,0:09:36.68,0:09:37.59,Default,,0,0,0,,Таң қалдырыңыз!
Dialogue: 0,0:09:37.63,0:09:39.82,Default,,0,0,0,,Сакаки-сан керемет
Dialogue: 0,0:09:40.19,0:09:43.94,Default,,0,0,0,,Енді біз 400 метрге жүгіруді бастаймыз.
Dialogue: 0,0:09:51.39,0:09:53.19,Default,,0,0,0,,Сәттілік, Сакаки-сан!
Dialogue: 0,0:09:53.21,0:09:54.40,Default,,0,0,0,,Бар!
Dialogue: 0,0:09:54.63,0:09:55.93,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:10:00.50,0:10:01.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:02.29,0:10:03.10,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:08.46,0:10:11.40,Default,,0,0,0,,Әй, Сақаки-сан, тез, тез!
Dialogue: 0,0:10:11.60,0:10:12.68,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:12.71,0:10:15.18,Default,,0,0,0,,Әрине, бұл Сакаки-сан.
Dialogue: 0,0:10:16.67,0:10:20.60,Default,,0,0,0,,(Юкари мен Куросава қарлыққан дауыспен қуанады)
Dialogue: 0,0:10:20.62,0:10:23.03,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:10:23.06,0:10:25.63,Default,,0,0,0,,Жарайды! 10 000 иен
Dialogue: 0,0:10:27.85,0:10:29.59,Default,,0,0,0,,(аудиторияны қолдау)
Dialogue: 0,0:10:32.44,0:10:35.23,Default,,0,0,0,,Керемет, Сакаки! Жәй жүр!
Dialogue: 0,0:10:35.26,0:10:37.78,Default,,0,0,0,,Кагура! Өлсең де же!
Dialogue: 0,0:10:45.40,0:10:46.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:46.86,0:10:49.56,Default,,0,0,0,,Керемет, Сакаки-сан, сен ең жақсысың.
Dialogue: 0,0:10:49.59,0:10:51.77,Default,,0,0,0,,Бұл сонымен қатар 100 электрондық хаттардың ішіндегі ең жақсысы болды.
Dialogue: 0,0:10:52.32,0:10:54.25,Default,,0,0,0,,Күткендей Сакаки-сан ең жақсы!
Dialogue: 0,0:10:54.77,0:10:55.57,Default,,0,0,0,,Сен тым наивсің.
Dialogue: 0,0:10:55.70,0:10:56.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:00.10,0:11:03.20,Default,,0,0,0,,Тәтті екен, спортзалға арналған киімдеріңізді блумерлеріңізге салмайсыз!!
Dialogue: 0,0:11:06.58,0:11:08.85,Default,,0,0,0,,Жүріңдер, сендер де кіріңдер.
Dialogue: 0,0:11:08.98,0:11:10.76,Default,,0,0,0,,Тыныш! Ауызыңды жап!
Dialogue: 0,0:11:11.18,0:11:13.43,Default,,0,0,0,,Келесі үш аяқты штатив.
Dialogue: 0,0:11:21.48,0:11:22.80,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:11:23.25,0:11:23.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:24.31,0:11:25.10,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:11:30.15,0:11:32.55,Default,,0,0,0,,Айқайлап, тынышталайық!
Dialogue: 0,0:11:32.57,0:11:34.51,Default,,0,0,0,,Сейана ақырын
Dialogue: 0,0:11:35.72,0:11:37.85,Default,,0,0,0,,Бір ааа
Dialogue: 0,0:11:43.61,0:11:45.50,Default,,0,0,0,,Бір ааа
Dialogue: 0,0:11:46.63,0:11:48.95,Default,,0,0,0,,Арқан тартуға қатысатын спортшылар
Dialogue: 0,0:11:48.98,0:11:51.50,Default,,0,0,0,,Орталық қақпаның алдында қарсы алыңыздар.
Dialogue: 0,0:11:52.19,0:11:53.08,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:11:53.10,0:11:53.78,Default,,0,0,0,,Иә
Dialogue: 0,0:11:54.25,0:11:55.26,Default,,0,0,0,,Бұл арқан тартыс
Dialogue: 0,0:11:55.51,0:11:58.65,Default,,0,0,0,,1 курстағы 3-сынып 1-ші курстағы 5-сынып
Dialogue: 0,0:11:58.75,0:12:01.64,Default,,0,0,0,,Жарайды, қолымыздан келгеннің бәрін жасайық!
Dialogue: 0,0:12:01.67,0:12:02.62,Default,,0,0,0,,Оу!
Dialogue: 0,0:12:06.19,0:12:07.88,Default,,0,0,0,,Бұл тікелей қарсыласу.
Dialogue: 0,0:12:07.91,0:12:09.75,Default,,0,0,0,,Мұны да алыңыз.
Dialogue: 0,0:12:09.77,0:12:11.77,Default,,0,0,0,,Мен мұнда да жеңілмеймін.
Dialogue: 0,0:12:12.21,0:12:13.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:14.34,0:12:15.34,Default,,0,0,0,,Қазір мен сөйлесіп тұрған адам – басқа емес,
Dialogue: 0,0:12:15.54,0:12:16.54,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:17.07,0:12:18.14,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:18.49,0:12:19.47,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:19.90,0:12:21.02,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:21.31,0:12:23.85,Default,,0,0,0,,(Юкари мен Куросава қарлыққан дауыспен қуанады)
Dialogue: 0,0:12:24.08,0:12:25.36,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:25.59,0:12:26.73,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:27.06,0:12:28.05,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:28.53,0:12:29.57,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:30.18,0:12:31.23,Default,,0,0,0,,(OS!)
Dialogue: 0,0:12:31.73,0:12:32.75,Default,,0,0,0,,(OS!)
Dialogue: 0,0:12:33.17,0:12:35.85,Default,,0,0,0,,ОЖ дегеніміз не...
Dialogue: 0,0:12:36.35,0:12:37.46,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:37.74,0:12:38.92,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:39.32,0:12:40.34,Default,,0,0,0,,(OS!)
Dialogue: 0,0:12:40.75,0:12:43.83,Default,,0,0,0,,На Томо-чан, ОЖ дегеніміз не?
Dialogue: 0,0:12:43.86,0:12:45.47,Default,,0,0,0,,Шулы! Тартыңыз!
Dialogue: 0,0:12:45.60,0:12:46.70,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:46.85,0:12:47.97,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:48.30,0:12:50.79,Default,,0,0,0,,(Юкари мен Куросава қарлыққан дауыспен қуанады)
Dialogue: 0,0:12:51.32,0:12:52.48,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:52.74,0:12:53.80,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:54.12,0:12:55.27,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:55.48,0:12:56.75,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:57.05,0:12:58.32,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:12:58.76,0:12:59.83,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:13:05.05,0:13:05.88,Default,,0,0,0,,ОЖ!
Dialogue: 0,0:13:09.01,0:13:10.38,Default,,0,0,0,,Бес топ жеңеді!
Dialogue: 0,0:13:12.49,0:13:13.07,Default,,0,0,0,,Кио
Dialogue: 0,0:13:13.54,0:13:16.02,Default,,0,0,0,,Ерлер тобының гимнастикасымен жалғасты
Dialogue: 0,0:13:17.18,0:13:18.07,Default,,0,0,0,,（）
Dialogue: 0,0:13:19.59,0:13:21.70,Default,,0,0,0,,（）
Dialogue: 0,0:13:21.81,0:13:24.79,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:13:25.02,0:13:28.06,Default,,0,0,0,,Ерлер тобының гимнастикасы қызықты көрінеді.
Dialogue: 0,0:13:28.08,0:13:29.68,Default,,0,0,0,,оның қазір қайда екенін немесе не істеп жатқанын білуге рұқсат жоқ па? Тіпті соны да білмейміз бе?
Dialogue: 0,0:13:29.72,0:13:30.42,Default,,0,0,0,,Чио-чан
Dialogue: 0,0:13:30.50,0:13:31.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:31.84,0:13:33.10,Default,,0,0,0,,Қол қимылын жасайық!
Dialogue: 0,0:13:33.18,0:13:34.46,Default,,0,0,0,,Е, дедедебуто
Dialogue: 0,0:13:34.66,0:13:36.89,Default,,0,0,0,,Жарайды, мен сені дұрыс қолдаймын.
Dialogue: 0,0:13:37.05,0:13:39.34,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:39.76,0:13:40.82,Default,,0,0,0,,Ара Құт
Dialogue: 0,0:13:41.00,0:13:41.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:41.72,0:13:42.40,Default,,0,0,0,,Даналық!
Dialogue: 0,0:13:42.51,0:13:42.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:51.41,0:13:53.53,Default,,0,0,0,,Таңқаларлық нәтиже жаман емес.
Dialogue: 0,0:13:53.56,0:13:57.14,Default,,0,0,0,,Жаман емес, баға алу үміткері.
Dialogue: 0,0:13:57.51,0:13:59.41,Default,,0,0,0,,Бірақ келіңіз.
Dialogue: 0,0:14:00.64,0:14:01.26,Default,,0,0,0,,Иә
Dialogue: 0,0:14:01.61,0:14:04.02,Default,,0,0,0,,Мен 5-сыныпқа аздап ұтылып жатырмын.
Dialogue: 0,0:14:06.01,0:14:08.17,Default,,0,0,0,,Өйткені мен жүкпін
Dialogue: 0,0:14:08.21,0:14:09.84,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:14:10.07,0:14:13.64,Default,,0,0,0,,Бірақ бүгін маған пайдасы жоқ.
Dialogue: 0,0:14:17.54,0:14:19.56,Default,,0,0,0,,Бұл туралы уайымдамаңыз!
Dialogue: 0,0:14:20.74,0:14:22.91,Default,,0,0,0,,Чио-чан, уақыт келді.
Dialogue: 0,0:14:25.37,0:14:27.09,Default,,0,0,0,,Эй, бірдеңе болды ма? …
Dialogue: 0,0:14:27.12,0:14:28.78,Default,,0,0,0,,Әртүрлі заттар.
Dialogue: 0,0:14:28.83,0:14:29.39,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:29.72,0:14:32.20,Default,,0,0,0,,Келесіде көңіл көтеру сайысы.
Dialogue: 0,0:14:32.89,0:14:35.23,Default,,0,0,0,,5-сынып Кеттік!
Dialogue: 0,0:14:35.27,0:14:37.69,Default,,0,0,0,,5-сынып, 5-сынып, кеттік!
Dialogue: 0,0:14:39.40,0:14:40.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:40.59,0:14:41.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:41.73,0:14:46.23,Default,,0,0,0,,Үш топ Өтетін орны!
Dialogue: 0,0:14:46.29,0:14:48.72,Default,,0,0,0,,Мына қыз қандай сүйкімді!
Dialogue: 0,0:14:49.72,0:14:53.79,Default,,0,0,0,,Үш топ Өтетін орны!
Dialogue: 0,0:14:55.47,0:14:57.32,Default,,0,0,0,,Керемет! Бұл күлкілі емес пе?
Dialogue: 0,0:14:57.46,0:14:59.70,Default,,0,0,0,,Бірақ бұл ұпай болып есептелмейді, солай ма?
Dialogue: 0,0:15:01.42,0:15:03.36,Default,,0,0,0,,Қарыз алу бәсекесі
Dialogue: 0,0:15:04.34,0:15:06.46,Default,,0,0,0,,Сәттілік Осака-сан!
Dialogue: 0,0:15:06.60,0:15:07.93,Default,,0,0,0,,Жоғалтпа!
Dialogue: 0,0:15:07.99,0:15:08.69,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:16.92,0:15:17.76,Default,,0,0,0,,Көзілдірік
Dialogue: 0,0:15:18.20,0:15:20.66,Default,,0,0,0,,Көзілдірігіңді маған бер! көзілдірік!
Dialogue: 0,0:15:21.89,0:15:22.54,Default,,0,0,0,,Иә
Dialogue: 0,0:15:22.57,0:15:23.68,Default,,0,0,0,,Мектепке арналған купальник
Dialogue: 0,0:15:28.01,0:15:29.91,Default,,0,0,0,,Оны іліп қоюдың қажеті жоқ!
Dialogue: 0,0:15:30.84,0:15:32.97,Default,,0,0,0,,Енді финалдық сайыстың уақыты келді
Dialogue: 0,0:15:32.99,0:15:34.89,Default,,0,0,0,,Әр топ арасындағы эстафета
Dialogue: 0,0:15:35.61,0:15:38.52,Default,,0,0,0,,Осылай жеңсек, кестені айналдырып, оқу жылын жеңеміз.
Dialogue: 0,0:15:38.55,0:15:39.65,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:15:40.52,0:15:41.96,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:15:43.52,0:15:45.04,Default,,0,0,0,,Бұл оны шешеді.
Dialogue: 0,0:15:45.12,0:15:48.88,Default,,0,0,0,,Жең, жең, жең, жең, жең, жең, жең, жең, жең, жең.
Dialogue: 0,0:15:49.05,0:15:50.33,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:51.72,0:15:52.29,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:52.47,0:15:53.59,Default,,0,0,0,,Бар!
Dialogue: 0,0:15:53.65,0:15:55.79,Default,,0,0,0,,Чихиро-сан барын салды!
Dialogue: 0,0:15:59.93,0:16:02.27,Default,,0,0,0,,Таяқшаны беру кезінде абай болыңыз.
Dialogue: 0,0:16:02.97,0:16:04.14,Default,,0,0,0,,Чихиро!
Dialogue: 0,0:16:05.99,0:16:06.58,Default,,0,0,0,,Иә
Dialogue: 0,0:16:06.62,0:16:08.86,Default,,0,0,0,,Доя!
Dialogue: 0,0:16:09.22,0:16:11.38,Default,,0,0,0,,Маған Сатоши-чан қатты ұнайды
Dialogue: 0,0:16:11.54,0:16:14.22,Default,,0,0,0,,Бірақ айырмашылық мүлдем жабылмайды.
Dialogue: 0,0:16:14.48,0:16:16.30,Default,,0,0,0,,Көбінесе жайылған
Dialogue: 0,0:16:16.39,0:16:18.54,Default,,0,0,0,,Жарайды, жағдай қалай!
Dialogue: 0,0:16:18.71,0:16:20.04,Default,,0,0,0,,Бар, жүр!
Dialogue: 0,0:16:20.32,0:16:21.05,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:16:21.08,0:16:21.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:21.46,0:16:22.64,Default,,0,0,0,,Оны маған қалдыр!
Dialogue: 0,0:16:23.00,0:16:24.89,Default,,0,0,0,,Коёми-сан, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:16:24.95,0:16:26.20,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:16:29.35,0:16:31.94,Default,,0,0,0,,Жарайды, оны Кагураға қосыңыз!
Dialogue: 0,0:16:31.97,0:16:33.17,Default,,0,0,0,,Күнтізбе!
Dialogue: 0,0:16:33.28,0:16:35.38,Default,,0,0,0,,Сақақиға берсең менікі!
Dialogue: 0,0:16:35.42,0:16:37.41,Default,,0,0,0,,Таяқшаны түсіріп алмаңыз!
Dialogue: 0,0:16:44.61,0:16:45.22,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:16:45.45,0:16:47.82,Default,,0,0,0,,Сәттілік! Бар, Сакаки-сан!
Dialogue: 0,0:16:51.32,0:16:53.55,Default,,0,0,0,,Жарайды! Сакакиді өзгерту!
Dialogue: 0,0:16:53.60,0:16:55.20,Default,,0,0,0,,Кагурадан бас тартпа!
Dialogue: 0,0:16:58.28,0:16:59.33,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:16:59.46,0:17:01.91,Default,,0,0,0,,Кагура! Маған бірінші орынды көрсет!
Dialogue: 0,0:17:05.93,0:17:06.53,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:17:06.55,0:17:07.57,Default,,0,0,0,,Бұзыңыз!
Dialogue: 0,0:17:07.60,0:17:09.16,Default,,0,0,0,,Сіз нені айтасыз?!
Dialogue: 0,0:17:09.25,0:17:11.87,Default,,0,0,0,,Өз сыныбыңды қолдағанның несі жаман?
Dialogue: 0,0:17:11.89,0:17:13.46,Default,,0,0,0,,Бұл, әрине, жаман емес!
Dialogue: 0,0:17:18.65,0:17:20.39,Default,,0,0,0,,Жүр! Сакаки!
Dialogue: 0,0:17:20.42,0:17:21.50,Default,,0,0,0,,Кагура!
Dialogue: 0,0:17:36.48,0:17:38.65,Default,,0,0,0,,Біз жеңдік! Мен жеңдім! Мен жеңдім!
Dialogue: 0,0:17:39.10,0:17:40.26,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:17:40.87,0:17:42.83,Default,,0,0,0,,Сакаки-сан күткендей.
Dialogue: 0,0:17:43.30,0:17:46.31,Default,,0,0,0,,Енді біз оқу жылының жеңімпаздарымыз!
Dialogue: 0,0:17:46.34,0:17:47.57,Default,,0,0,0,,Аман болсын!
Dialogue: 0,0:17:47.98,0:17:49.62,Default,,0,0,0,,Бұл сенің шаруаң емес!
Dialogue: 0,0:17:50.17,0:17:52.32,Default,,0,0,0,,Баршаңызға еңбектеріңіз үшін рахмет
Dialogue: 0,0:17:52.50,0:17:53.71,Default,,0,0,0,,Соңында
Dialogue: 0,0:17:53.78,0:17:55.57,Default,,0,0,0,,Біз халық биін орындаймыз.
Dialogue: 0,0:17:55.66,0:17:58.69,Default,,0,0,0,,Қатысқысы келетіндер жерге жиналуы керек.
Dialogue: 0,0:17:59.69,0:18:00.94,Default,,0,0,0,,О!
Dialogue: 0,0:18:01.02,0:18:02.53,Default,,0,0,0,,Кеттік, Осака-сан.
Dialogue: 0,0:18:02.61,0:18:03.61,Default,,0,0,0,,Ей, кеттік, кеттік
Dialogue: 0,0:18:03.63,0:18:04.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:16.98,0:18:18.68,Default,,0,0,0,,Сағыныш.
Dialogue: 0,0:18:18.71,0:18:20.42,Default,,0,0,0,,Сізде Нямо жоқ па?
Dialogue: 0,0:18:21.81,0:18:22.41,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:24.04,0:18:25.18,Default,,0,0,0,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:18:43.91,0:18:45.07,Default,,0,0,0,,Сакаки мырза
Dialogue: 0,0:18:45.84,0:18:48.38,Default,,0,0,0,,Адам санына байланысты...ұлдарға...
Dialogue: 0,0:19:00.60,0:19:02.26,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:19:04.07,0:19:05.24,Default,,0,0,0,,(Сакаки мырза)
Dialogue: 0,0:19:05.74,0:19:06.89,Default,,0,0,0,,Сакаки мырза
Dialogue: 0,0:19:07.09,0:19:08.17,Default,,0,0,0,,Сакаки мырза!
Dialogue: 0,0:19:08.35,0:19:09.89,Default,,0,0,0,,Сакаки-сан!
Dialogue: 0,0:19:10.47,0:19:11.30,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:19:11.64,0:19:12.39,Default,,0,0,0,,Менің қолым...
Dialogue: 0,0:19:12.77,0:19:13.71,Default,,0,0,0,,Менің қолым...
Dialogue: 0,0:19:14.15,0:19:15.12,Default,,0,0,0,,Қолдар
Dialogue: 0,0:19:15.26,0:19:16.07,Default,,0,0,0,,Қолдар!
Dialogue: 0,0:19:16.23,0:19:17.23,Default,,0,0,0,,Қолдар ~!
Dialogue: 0,0:19:17.31,0:19:18.44,Default,,0,0,0,,Ең жақсы…
Dialogue: 0,0:19:18.66,0:19:19.47,Default,,0,0,0,,Ең жақсы…
Dialogue: 0,0:19:19.85,0:19:21.05,Default,,0,0,0,,Физика шекараларын да бағындыратын күш—
Dialogue: 0,0:19:21.11,0:19:23.41,Default,,0,0,0,,Ең жақсы!
Dialogue: 0,0:19:23.49,0:19:24.95,Default,,0,0,0,,Мәңгі осылай қалады...
Dialogue: 0,0:19:25.03,0:19:26.18,Default,,0,0,0,,Мәңгі осылай қал
Dialogue: 0,0:19:26.29,0:19:27.54,Default,,0,0,0,,Мәңгі осылай қал
Dialogue: 0,0:19:27.71,0:19:29.16,Default,,0,0,0,,Мәңгі осылай қал
Dialogue: 0,0:19:29.26,0:19:30.28,Default,,0,0,0,,(өлу)
Dialogue: 0,0:19:30.37,0:19:31.36,Default,,0,0,0,,Өл
Dialogue: 0,0:19:31.53,0:19:32.42,Default,,0,0,0,,Өл
Dialogue: 0,0:19:32.66,0:19:34.50,Default,,0,0,0,,Өлу~
Dialogue: 0,0:19:34.78,0:19:36.86,Default,,0,0,0,,Енді өлгені дұрыс
Dialogue: 0,0:19:36.95,0:19:37.57,Default,,0,0,0,,Ум...
Dialogue: 0,0:19:37.77,0:19:38.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:39.49,0:19:40.88,Default,,0,0,0,,Өзгеріс уақыты келді...
Dialogue: 0,0:19:40.91,0:19:41.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:41.83,0:19:44.76,Default,,0,0,0,,А-а, кешіріңіз.
Dialogue: 0,0:19:45.16,0:19:45.83,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:19:48.42,0:19:51.73,Default,,0,0,0,,Халық биіне қатысу өте жақсы болды.
Dialogue: 0,0:19:53.94,0:19:56.66,Default,,0,0,0,,Қош келдіңіз! Келесі мен!
Dialogue: 0,0:19:57.06,0:19:59.56,Default,,0,0,0,,Уау! !
Dialogue: 0,0:19:59.82,0:20:00.52,Default,,0,0,0,,Ах
Dialogue: 0,0:20:10.54,0:20:14.78,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу қол...
Dialogue: 0,0:20:14.81,0:20:15.56,Default,,0,0,0,,Қолдар!
Dialogue: 0,0:20:16.16,0:20:19.41,Default,,0,0,0,,Уууу өл, өл! Мен өлемін!
Dialogue: 0,0:20:19.43,0:20:22.29,Default,,0,0,0,,Өл, өл, өл, өл - уау.
Dialogue: 0,0:20:22.44,0:20:25.12,Default,,0,0,0,,Ааахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахаахах ahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahahah! ! Хахахаха!
Dialogue: 0,0:20:25.64,0:20:27.89,Default,,0,0,0,,Көңілді болыңыз! Каорин!
Dialogue: 0,0:20:27.92,0:20:30.04,Default,,0,0,0,,Маған Каорин деп қоңырау шалмаңыз!
Dialogue: 0,0:20:30.93,0:20:32.99,Default,,0,0,0,,Мен бүгін жеңе алмадым, бірақ
Dialogue: 0,0:20:33.12,0:20:34.93,Default,,0,0,0,,Жарайсыңдар бәріңе.
Dialogue: 0,0:20:35.08,0:20:36.74,Default,,0,0,0,,Келесі жылы тағы да бар күшімізді салайық
Dialogue: 0,0:20:36.86,0:20:37.50,Default,,0,0,0,,Иә
Dialogue: 0,0:20:38.82,0:20:41.40,Default,,0,0,0,,Ей, мәңгілік жылама.
Dialogue: 0,0:20:41.52,0:20:42.14,Default,,0,0,0,,Иә
Dialogue: 0,0:20:42.18,0:20:46.55,Default,,0,0,0,,Сәлем! Уәде етілген нәрсе, уәде етілген нәрсе!
Dialogue: 0,0:20:47.34,0:20:48.51,Default,,0,0,0,,Не уәде болды?
Dialogue: 0,0:20:48.54,0:20:51.45,Default,,0,0,0,,Ах! Бұл ештеңе емес, бұл ештеңе емес!
Dialogue: 0,0:20:52.41,0:20:54.28,Default,,0,0,0,,Сондықтан мен ұнатпаймын дедім
Dialogue: 0,0:20:54.30,0:20:56.13,Default,,0,0,0,,Жарайды, тез, тез
Dialogue: 0,0:20:56.73,0:20:57.17,Default,,0,0,0,,Иә
Dialogue: 0,0:20:57.20,0:20:58.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:58.39,0:21:00.84,Default,,0,0,0,,Бұл аванстық несие 10 000 иен
Dialogue: 0,0:21:01.55,0:21:03.15,Default,,0,0,0,,Мен оны қайтарып аламын.
Dialogue: 0,0:21:06.29,0:21:07.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:07.54,0:21:09.24,Default,,0,0,0,,Жүр, бәріміз үйге қайтайық.
Dialogue: 0,0:21:09.63,0:21:11.60,Default,,0,0,0,,Мұғалім, ол ақша ше?
Dialogue: 0,0:21:11.94,0:21:13.78,Default,,0,0,0,,А, бұл ештеңе емес.
Dialogue: 0,0:21:14.16,0:21:15.14,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:15.16,0:21:17.72,Default,,0,0,0,,Мен осы ақшаға барлығына шырын сатып аламын.
Dialogue: 0,0:21:18.11,0:21:19.33,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:19.60,0:21:20.91,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:21:25.45,0:21:26.83,Default,,0,0,0,,Юкари-чан!
Dialogue: 0,0:21:28.57,0:21:29.99,Default,,0,0,0,,Уәде бер!
Dialogue: 0,0:21:30.27,0:21:30.86,Default,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:21:31.24,0:21:34.10,Default,,0,0,0,,Мен ұтқандықтан, маған шырын сатып беріңізші!
Dialogue: 0,0:21:34.48,0:21:35.56,Default,,0,0,0,,Шырын?
Dialogue: 0,0:21:35.58,0:21:36.47,Default,,0,0,0,,Иә
Dialogue: 0,0:21:36.68,0:21:37.57,Default,,0,0,0,,Ах
Dialogue: 0,0:21:38.69,0:21:39.38,Default,,0,0,0,,О! !
Dialogue: 0,0:21:46.47,0:21:47.56,Default,,0,0,0,,Бұл жылдам
Dialogue: 0,0:21:47.82,0:21:48.42,Default,,0,0,0,,Иә
Dialogue: 0,0:21:48.93,0:21:52.68,Default,,0,0,0,,Мен спорт мерекесіне қатысқанымды қалаймын.
Dialogue: 0,0:21:59.18,0:22:01.74,Default,,0,0,0,,Жүрегіңде қанат қағып
Dialogue: 0,0:22:03.36,0:22:06.46,Default,,0,0,0,,Жүрегіңдегі сыбырды айт
Dialogue: 0,0:22:07.61,0:22:10.29,Default,,0,0,0,,Енді желде
Dialogue: 0,0:22:13.95,0:22:16.51,Default,,0,0,0,,Жүрек жұлдыздардан тыс
Dialogue: 0,0:22:18.18,0:22:21.32,Default,,0,0,0,,Тілектер әрқашан орындалады
Dialogue: 0,0:22:22.39,0:22:30.00,Default,,0,0,0,,Кел мені көр, Кілт – болашақ
Dialogue: 0,0:22:31.13,0:22:35.28,Default,,0,0,0,,Терезеге ақырын шақырған дауыс
Dialogue: 0,0:22:35.38,0:22:39.12,Default,,0,0,0,,Махаббатты алдын ала ескерту және
Dialogue: 0,0:22:39.68,0:22:43.32,Default,,0,0,0,,Махаббат әлі алыс болса да
Dialogue: 0,0:22:43.62,0:22:45.60,Default,,0,0,0,,Мен ертеңге сенемін
Dialogue: 0,0:22:45.63,0:22:47.64,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:22:47.76,0:22:49.61,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:49.65,0:22:55.10,Default,,0,0,0,,Жалғыз болмаймын деп уәде бердің, аспан
Dialogue: 0,0:22:56.24,0:22:58.05,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:58.12,0:22:59.78,Default,,0,0,0,,Тәтті көз жасы
Dialogue: 0,0:23:00.18,0:23:04.51,Default,,0,0,0,,Жұмақта тағы да күл
Dialogue: 0,0:23:04.74,0:23:06.49,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:23:06.57,0:23:12.05,Default,,0,0,0,,Мен сені нәзік армандардың аспанына алып кетуге келдім
Dialogue: 0,0:23:13.20,0:23:16.86,Default,,0,0,0,,Таңқурай аспаны мен саған қайтып келемін
Dialogue: 0,0:23:17.16,0:23:21.48,Default,,0,0,0,,Жұмақ гүлі жайқалған күні
Dialogue: 0,0:23:21.61,0:23:23.58,Default,,0,0,0,,Сен және мен...
Dialogue: 0,0:23:24.19,0:23:28.46,Default,,0,0,0,,Бірге кездесейік
Dialogue: 0,0:23:33.74,0:23:35.73,Default,,0,0,0,,Келесі аптада мектеп мерекесі.
Dialogue: 0,0:23:35.77,0:23:39.12,Default,,0,0,0,,Бізде бастауыш мектепте мектеп фестивалі болған жоқ, сондықтан мен оны асыға күтемін!
Dialogue: 0,0:23:39.25,0:23:41.31,Default,,0,0,0,,Жазғы фестивальдегі жақсы би
Dialogue: 0,0:23:41.43,0:23:43.55,Default,,0,0,0,,Спорттық мерекедегі халық биі
Dialogue: 0,0:23:43.66,0:23:47.28,Default,,0,0,0,,Хонарая: Мектептегі мерекеде қандай би билейсің?
Dialogue: 0,0:23:47.40,0:23:49.13,Default,,0,0,0,,Дұрыс, бұл мәдениетті би!
Dialogue: 0,0:23:49.19,0:23:51.90,Default,,0,0,0,,Мәдениет Мәдениет Мәдениет Woo!
Dialogue: 0,0:23:51.94,0:23:54.26,Default,,0,0,0,,Мәдени биді міндетті түрде билейсіз
Dialogue: 0,0:23:54.36,0:23:55.78,Default,,0,0,0,,Мәдениет Woo!
Dialogue: 0,0:23:57.28,0:24:03.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory