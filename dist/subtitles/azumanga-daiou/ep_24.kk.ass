Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.52,0:01:34.36,Default,,0000,0000,0000,,(Қала шуы)
Dialogue: 0,0:01:46.87,0:01:49.37,Default,,0000,0000,0000,,Эй Чи!
Dialogue: 0,0:01:49.37,0:01:51.71,Default,,0000,0000,0000,,Мен бастауыш сынып оқушысы емеспін.
Dialogue: 0,0:01:49.37,0:01:51.71,Default,,0000,0000,0000,,Тыныш болыңыз!
Dialogue: 0,0:01:51.71,0:01:55.04,Default,,0000,0000,0000,,Әй, ұстайық!
Dialogue: 0,0:01:51.71,0:01:55.04,Default,,0000,0000,0000,,Конча….
Dialogue: 0,0:01:55.04,0:02:12.33,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:12.33,0:02:14.53,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:02:17.17,0:02:19.17,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:02:21.34,0:02:25.67,Default,,0000,0000,0000,,А?
Dialogue: 0,0:02:21.34,0:02:25.67,Default,,0000,0000,0000,,Сакаки-чан, сен не істеп жатырсың?
Dialogue: 0,0:02:25.67,0:02:29.18,Default,,0000,0000,0000,,Аа, мен интернетті түсінемін.
Dialogue: 0,0:02:29.18,0:02:32.68,Default,,0000,0000,0000,,О, бұл интернет.
Dialogue: 0,0:02:32.68,0:02:34.68,Default,,0000,0000,0000,,Қазіргі уақытта сұрақтар жоқ.
Dialogue: 0,0:02:34.68,0:02:36.69,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:02:36.69,0:02:38.89,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:36.69,0:02:38.89,Default,,0000,0000,0000,,Осака мырза….
Dialogue: 0,0:02:41.69,0:02:44.19,Default,,0000,0000,0000,,Ах, Пиканья өліп жатыр.
Dialogue: 0,0:02:44.19,0:02:47.70,Default,,0000,0000,0000,,Бұл Ямапикарья. Немесе Ямамая.
Dialogue: 0,0:02:47.70,0:02:51.70,Default,,0000,0000,0000,,Бұл жазатайым оқиға болды ма?
Dialogue: 0,0:02:47.70,0:02:51.70,Default,,0000,0000,0000,,Ямамайаның өлімінің басты себептерінің бірі екеніне сенімдімін➡
Dialogue: 0,0:02:51.70,0:02:53.70,Default,,0000,0000,0000,,Жол-көлік оқиғасы болған сияқты.
Dialogue: 0,0:02:53.70,0:02:56.04,Default,,0000,0000,0000,,Пиканья Өте сүйкімді.
Dialogue: 0,0:02:56.04,0:02:58.04,Default,,0000,0000,0000,,(Хироко) Һм? О…
Dialogue: 0,0:02:58.04,0:03:01.14,Default,,0000,0000,0000,,Бұл мысық….
Dialogue: 0,0:03:01.14,0:03:03.31,Default,,0000,0000,0000,,Мен өзімді сол кездегі ана мысық сияқты сезінемін...
Dialogue: 0,0:03:03.31,0:03:06.32,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:03:03.31,0:03:06.32,Default,,0000,0000,0000,,Қайғылы оқиға қашан болды?
Dialogue: 0,0:03:06.32,0:03:08.48,Default,,0000,0000,0000,,Бұл мектеп саяхатының келесі күні.
Dialogue: 0,0:03:08.48,0:03:12.65,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:08.48,0:03:12.65,Default,,0000,0000,0000,,Мен ажырата алмаймын...
Dialogue: 0,0:03:12.65,0:03:17.83,Default,,0000,0000,0000,,Мен сені аяймын.
Dialogue: 0,0:03:12.65,0:03:17.83,Default,,0000,0000,0000,,Біраз жалқау болсаң жақсы, бірақ...
Dialogue: 0,0:03:17.83,0:03:19.83,Default,,0000,0000,0000,,А, бұл жақсы емес, бірақ...
Dialogue: 0,0:03:19.83,0:03:21.83,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:03:25.67,0:03:28.50,Default,,0000,0000,0000,,《Жақсысың ба, анау бала...》
Dialogue: 0,0:03:28.50,0:03:30.51,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,0:03:30.51,0:03:33.51,Default,,0000,0000,0000,,Тадаёси мырза
Dialogue: 0,0:03:30.51,0:03:33.51,Default,,0000,0000,0000,,Мен бүгін таңертең жартылай ұйықтап жатырмын деп ойлаймын.
Dialogue: 0,0:03:33.51,0:03:36.68,Default,,0000,0000,0000,,А... А? Ешқандай атау тақтайшасы жоқ.
Dialogue: 0,0:03:36.68,0:03:39.51,Default,,0000,0000,0000,,А, бұл үй
Dialogue: 0,0:03:36.68,0:03:39.51,Default,,0000,0000,0000,,Мен көштім.
Dialogue: 0,0:03:39.51,0:03:43.35,Default,,0000,0000,0000,,Ал, бері қарай! Жарыл енді!
Dialogue: 0,0:03:39.51,0:03:43.35,Default,,0000,0000,0000,,Мұнда үлкен мысық болды.
Dialogue: 0,0:03:43.35,0:03:45.35,Default,,0000,0000,0000,,Дұрыс, Мару-чан.
Dialogue: 0,0:03:45.35,0:03:48.19,Default,,0000,0000,0000,,Үлкен
Dialogue: 0,0:03:45.35,0:03:48.19,Default,,0000,0000,0000,,Бұл әдемі мысық еді, солай емес пе?
Dialogue: 0,0:03:48.19,0:03:50.53,Default,,0000,0000,0000,,Иә. Ол осы жерде бастық болды.
Dialogue: 0,0:03:50.53,0:03:53.36,Default,,0000,0000,0000,,Сонда бастық ауыстырылады!
Dialogue: 0,0:03:53.36,0:03:56.37,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:03:53.36,0:03:56.37,Default,,0000,0000,0000,,Бұл жерде мысықтар өте көп.
Dialogue: 0,0:03:56.37,0:03:58.37,Default,,0000,0000,0000,,Бастық да қиын, солай емес пе?
Dialogue: 0,0:03:58.37,0:04:00.37,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:04:04.64,0:04:08.14,Default,,0000,0000,0000,,(көлік дыбысы)
Dialogue: 0,0:04:15.32,0:04:18.65,Default,,0000,0000,0000,,♬ «Сабақ кестесі»
Dialogue: 0,0:04:18.65,0:04:21.55,Default,,0000,0000,0000,,♬ «Алдымен оларды жинап алайық».
Dialogue: 0,0:04:23.49,0:04:26.50,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:26.50,0:04:28.83,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:04:28.83,0:04:33.17,Default,,0000,0000,0000,,Тадаёси мырза, көліктерге және т.б.
Dialogue: 0,0:04:28.83,0:04:33.17,Default,,0000,0000,0000,,Сақ болыңыз.
Dialogue: 0,0:04:33.17,0:04:35.17,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:04:35.17,0:04:37.17,Default,,0000,0000,0000,,Не? Не болды?
Dialogue: 0,0:04:37.17,0:04:39.68,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:37.17,0:04:39.68,Default,,0000,0000,0000,,Ит!
Dialogue: 0,0:04:39.68,0:04:43.68,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:04:39.68,0:04:43.68,Default,,0000,0000,0000,,Мен Тадайоши-саннан жақсымын➡
Dialogue: 0,0:04:43.68,0:04:46.18,Default,,0000,0000,0000,,Сау болу керек.
Dialogue: 0,0:04:46.18,0:04:49.35,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:49.35,0:04:52.69,Default,,0000,0000,0000,,Дұрыс, мен мұны жазуым керек.
Dialogue: 0,0:04:52.69,0:04:58.53,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:04:58.53,0:05:01.13,Default,,0000,0000,0000,,Иә, маған бұл жер өте ұнайды.
Dialogue: 0,0:05:01.13,0:05:04.63,Default,,0000,0000,0000,,Бірақ мұнда жүру қиын➡
Dialogue: 0,0:05:04.63,0:05:06.83,Default,,0000,0000,0000,,Мен жалғыз өмір сүруім керек сияқты...
Dialogue: 0,0:05:09.97,0:05:11.97,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:05:11.97,0:05:16.31,Default,,0000,0000,0000,,Егер сіз жалғыз тұрсаңыз, үй жануарларын ұстауға болады.
Dialogue: 0,0:05:16.31,0:05:19.65,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:05:19.65,0:05:21.98,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:05:21.98,0:05:32.78,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:38.50,0:05:42.50,Default,,0000,0000,0000,,Түсіндім, сақаки – жануар.
Dialogue: 0,0:05:38.50,0:05:42.50,Default,,0000,0000,0000,,Дәрігер болғыңыз келе ме?
Dialogue: 0,0:05:42.50,0:05:46.51,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:05:42.50,0:05:46.51,Default,,0000,0000,0000,,Бірақ ветеринарлық университеттер өте аз.
Dialogue: 0,0:05:46.51,0:05:48.51,Default,,0000,0000,0000,,Кагура ше?
Dialogue: 0,0:05:48.51,0:05:51.18,Default,,0000,0000,0000,,Дене шынықтыру университеттері
Dialogue: 0,0:05:48.51,0:05:51.18,Default,,0000,0000,0000,,Мен оны алуды ойлап жүрмін.
Dialogue: 0,0:05:51.18,0:05:53.52,Default,,0000,0000,0000,,Мен жүзуді сәл ұзағырақ жалғастырғым келеді.
Dialogue: 0,0:05:53.52,0:05:55.52,Default,,0000,0000,0000,,Сіз дене шынықтыру мұғалімі боласыз ба?
Dialogue: 0,0:05:55.52,0:05:58.52,Default,,0000,0000,0000,,Мен бұл туралы шынымен ойлаған жоқпын.
Dialogue: 0,0:05:55.52,0:05:58.52,Default,,0000,0000,0000,,Менің ойымша, бұл да мүмкін.
Dialogue: 0,0:05:58.52,0:06:00.46,Default,,0000,0000,0000,,Сакаки-сан!
Dialogue: 0,0:05:58.52,0:06:00.46,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:00.46,0:06:02.62,Default,,0000,0000,0000,,Бұл мен бұрын айтқан мысықтар каталогы.
Dialogue: 0,0:06:02.62,0:06:04.79,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:06:02.62,0:06:04.79,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:06:04.79,0:06:07.13,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:06:04.79,0:06:07.13,Default,,0000,0000,0000,,Рахмет, Чиё-чан.
Dialogue: 0,0:06:07.13,0:06:09.13,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:06:07.13,0:06:09.13,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:06:09.13,0:06:11.13,Default,,0000,0000,0000,,Сакаки Сізде мысық бар ма?
Dialogue: 0,0:06:11.13,0:06:14.64,Default,,0000,0000,0000,,Жоқ, ата-анамыз жақсы емес.
Dialogue: 0,0:06:11.13,0:06:14.64,Default,,0000,0000,0000,,Қарап тұр.
Dialogue: 0,0:06:14.64,0:06:16.64,Default,,0000,0000,0000,,Әй, сен мысықтарға қарсысың ба?
Dialogue: 0,0:06:16.64,0:06:20.98,Default,,0000,0000,0000,,Жоқ, анашым
Dialogue: 0,0:06:16.64,0:06:20.98,Default,,0000,0000,0000,,Менің мысықтарға және басқаларға аллергиям бар.
Dialogue: 0,0:06:20.98,0:06:25.31,Default,,0000,0000,0000,,Бұл аллергия ма? Менің ойымша, оған көмектесу мүмкін емес.
Dialogue: 0,0:06:25.31,0:06:29.15,Default,,0000,0000,0000,,Бұл тамаша! Мен оны сақтасам да
Dialogue: 0,0:06:25.31,0:06:29.15,Default,,0000,0000,0000,,Мен бәрібір үйрене алмаймын!
Dialogue: 0,0:06:29.15,0:06:32.32,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:06:29.15,0:06:32.32,Default,,0000,0000,0000,,Позитивті ойлау! Позитивті ойлау!
Dialogue: 0,0:06:32.32,0:06:35.49,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:06:32.32,0:06:35.49,Default,,0000,0000,0000,,Plus?
Dialogue: 0,0:06:32.32,0:06:35.49,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:35.49,0:06:38.49,Default,,0000,0000,0000,,Бұл дұрыс емес, Сакаки мырза.
Dialogue: 0,0:06:38.49,0:06:41.16,Default,,0000,0000,0000,,Оқуды бітіріп, университетке қабылданғаннан кейін➡
Dialogue: 0,0:06:41.16,0:06:46.00,Default,,0000,0000,0000,,Жалғыз өмір сүруді бастау
Dialogue: 0,0:06:41.16,0:06:46.00,Default,,0000,0000,0000,,Мен мысық алуды ойлап жүрмін.
Dialogue: 0,0:06:46.00,0:06:48.00,Default,,0000,0000,0000,,О.
Dialogue: 0,0:06:48.00,0:06:50.84,Default,,0000,0000,0000,,Бірақ сакаки мысықтары мені жек көреді.
Dialogue: 0,0:06:50.84,0:06:54.18,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:06:54.18,0:06:56.51,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:54.18,0:06:56.51,Default,,0000,0000,0000,,Мен оны сақтай аламын ба?
Dialogue: 0,0:06:56.51,0:07:00.81,Default,,0000,0000,0000,,Мәселе мынада... Сакаки мырза
Dialogue: 0,0:06:56.51,0:07:00.81,Default,,0000,0000,0000,,Позитивті ойлау! Позитивті ойлау!
Dialogue: 0,0:07:03.45,0:07:07.12,Default,,0000,0000,0000,,Мансап Утара
Dialogue: 0,0:07:03.45,0:07:07.12,Default,,0000,0000,0000,,Чио-чан Америкадан, солай ма?
Dialogue: 0,0:07:07.12,0:07:10.63,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:07:07.12,0:07:10.63,Default,,0000,0000,0000,,Расында, Тадаёси-санға не болады?
Dialogue: 0,0:07:10.63,0:07:12.63,Default,,0000,0000,0000,,Ана жақтағы танысымның үйінде➡
Dialogue: 0,0:07:12.63,0:07:15.46,Default,,0000,0000,0000,,Тұрғын үй мәселесіне келгенде
Dialogue: 0,0:07:12.63,0:07:15.46,Default,,0000,0000,0000,,Мен солай ойлаймын➡
Dialogue: 0,0:07:15.46,0:07:18.30,Default,,0000,0000,0000,,Тадайоши-сан онымен бірге болғаным дұрыс екенін айтты.
Dialogue: 0,0:07:15.46,0:07:18.30,Default,,0000,0000,0000,,Ол солай дейді.
Dialogue: 0,0:07:18.30,0:07:20.60,Default,,0000,0000,0000,,Бұл жақсы болды.
Dialogue: 0,0:07:22.80,0:07:28.50,Default,,0000,0000,0000,,Тадаёси мырза, француз,
Dialogue: 0,0:07:22.80,0:07:28.50,Default,,0000,0000,0000,,Жапондық Чио-чанмен...
Dialogue: 0,0:07:31.31,0:07:33.32,Default,,0000,0000,0000,,Америкаға барыңыз.
Dialogue: 0,0:07:33.32,0:07:35.98,Default,,0000,0000,0000,,Шетелдіктің кім екенін білмеймін.
Dialogue: 0,0:07:35.98,0:07:37.99,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:07:37.99,0:07:40.82,Default,,0000,0000,0000,,《Чиё: Осака-сан керемет》
Dialogue: 0,0:07:40.82,0:07:44.33,Default,,0000,0000,0000,,Ертең кездескенше.
Dialogue: 0,0:07:40.82,0:07:44.33,Default,,0000,0000,0000,,Қош бол!
Dialogue: 0,0:07:40.82,0:07:44.33,Default,,0000,0000,0000,,Олай болса.
Dialogue: 0,0:07:44.33,0:07:47.83,Default,,0000,0000,0000,,Сакаки мырза
Dialogue: 0,0:07:44.33,0:07:47.83,Default,,0000,0000,0000,,Сіз ветеринарлық университетке барасыз, солай ма?
Dialogue: 0,0:07:47.83,0:07:49.83,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:47.83,0:07:49.83,Default,,0000,0000,0000,,Бірақ➡
Dialogue: 0,0:07:49.83,0:07:52.33,Default,,0000,0000,0000,,Сакаки-сан да
Dialogue: 0,0:07:49.83,0:07:52.33,Default,,0000,0000,0000,,Мысықпен бірге тұру жақсы болар еді.
Dialogue: 0,0:07:52.33,0:07:55.17,Default,,0000,0000,0000,,Иә, ә.
Dialogue: 0,0:07:52.33,0:07:55.17,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:07:55.17,0:07:58.34,Default,,0000,0000,0000,,Бұл мысық.
Dialogue: 0,0:07:58.34,0:08:00.28,Default,,0000,0000,0000,,(Мысық мияу)
Dialogue: 0,0:08:00.28,0:08:03.45,Default,,0000,0000,0000,,Уау! не?
Dialogue: 0,0:08:00.28,0:08:03.45,Default,,0000,0000,0000,,Көп нәрсе шықты!
Dialogue: 0,0:08:03.45,0:08:05.45,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:08:05.45,0:08:08.78,Default,,0000,0000,0000,,(Мысық мияу)
Dialogue: 0,0:08:08.78,0:08:10.79,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:08.78,0:08:10.79,Default,,0000,0000,0000,,Қайта….
Dialogue: 0,0:08:10.79,0:08:15.46,Default,,0000,0000,0000,,(қорқынышты дауыс)
Dialogue: 0,0:08:15.46,0:08:18.79,Default,,0000,0000,0000,,Барлығы сондай ашулы!
Dialogue: 0,0:08:15.46,0:08:18.79,Default,,0000,0000,0000,,Бұл біртүрлі! ?
Dialogue: 0,0:08:18.79,0:08:21.63,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:08:18.79,0:08:21.63,Default,,0000,0000,0000,,Фугия!
Dialogue: 0,0:08:21.63,0:08:23.63,Default,,0000,0000,0000,,Каминеко!
Dialogue: 0,0:08:21.63,0:08:23.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:23.63,0:08:27.14,Default,,0000,0000,0000,,Мен неге екенін білмеймін
Dialogue: 0,0:08:23.63,0:08:27.14,Default,,0000,0000,0000,,Мені жау санайтын мысық...
Dialogue: 0,0:08:27.14,0:08:30.04,Default,,0000,0000,0000,,Сәлем! ? Ал...
Dialogue: 0,0:08:32.31,0:08:35.64,Default,,0000,0000,0000,,Ахх! мысықтың тырнақтары
Dialogue: 0,0:08:32.31,0:08:35.64,Default,,0000,0000,0000,,Микробтар өте көп➡
Dialogue: 0,0:08:35.64,0:08:38.98,Default,,0000,0000,0000,,Әжені тырнап алды
Dialogue: 0,0:08:35.64,0:08:38.98,Default,,0000,0000,0000,,Өте ісіп кеткен!
Dialogue: 0,0:08:38.98,0:08:40.98,Default,,0000,0000,0000,,Артқа қадам жасаңыз.
Dialogue: 0,0:08:40.98,0:08:44.15,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:44.15,0:08:46.99,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:08:44.15,0:08:46.99,Default,,0000,0000,0000,,Кяа~!
Dialogue: 0,0:08:46.99,0:08:49.49,Default,,0000,0000,0000,,(мысықтардың айқайы)
Dialogue: 0,0:08:49.49,0:08:51.49,Default,,0000,0000,0000,,Фугия! ?
Dialogue: 0,0:08:49.49,0:08:51.49,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:08:51.49,0:08:56.67,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:56.67,0:08:58.67,Default,,0000,0000,0000,,Яма Майя! ?
Dialogue: 0,0:08:56.67,0:08:58.67,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:08:58.67,0:09:05.44,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:05.44,0:09:08.54,Default,,0000,0000,0000,,Гяууууу!
Dialogue: 0,0:09:11.45,0:09:14.62,Default,,0000,0000,0000,,Няа… няа….
Dialogue: 0,0:09:14.62,0:09:21.12,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:21.12,0:09:23.12,Default,,0000,0000,0000,,Керемет! Мен оны қуып жібердім!
Dialogue: 0,0:09:23.12,0:09:25.13,Default,,0000,0000,0000,,Ямамая….
Dialogue: 0,0:09:25.13,0:09:27.53,Default,,0000,0000,0000,,Неге мұндасың...?
Dialogue: 0,0:09:30.30,0:09:32.97,Default,,0000,0000,0000,,Ах! Эй, жақсысың ба! ?
Dialogue: 0,0:09:32.97,0:09:35.30,Default,,0000,0000,0000,,Мүмкін сен әлсіз шығарсың!
Dialogue: 0,0:09:35.30,0:09:37.81,Default,,0000,0000,0000,,Тадайоши жақын жерден келе жатыр.
Dialogue: 0,0:09:35.30,0:09:37.81,Default,,0000,0000,0000,,Бізде мал дәрігері бар!
Dialogue: 0,0:09:37.81,0:09:41.48,Default,,0000,0000,0000,,Онда!
Dialogue: 0,0:09:37.81,0:09:41.48,Default,,0000,0000,0000,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:09:41.48,0:09:44.65,Default,,0000,0000,0000,,Сакаки-сан, міне! мұғалім!
Dialogue: 0,0:09:44.65,0:09:47.32,Default,,0000,0000,0000,,Мұғалім! Исихара мырза!
Dialogue: 0,0:09:47.32,0:09:49.32,Default,,0000,0000,0000,,Ах, Михама-сан, Чино-чан.
Dialogue: 0,0:09:49.32,0:09:52.32,Default,,0000,0000,0000,,Тездетіңізші, мұғалім! тез!
Dialogue: 0,0:09:52.32,0:09:54.32,Default,,0000,0000,0000,,Мұғалім қазір тамақ ішіп отыр.... (есіктің ашылған дыбысы)
Dialogue: 0,0:09:54.32,0:09:56.83,Default,,0000,0000,0000,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:09:54.32,0:09:56.83,Default,,0000,0000,0000,,Шулы емес пе? мұғалім!
Dialogue: 0,0:09:56.83,0:10:00.50,Default,,0000,0000,0000,,О~ Чио-чан?
Dialogue: 0,0:09:56.83,0:10:00.50,Default,,0000,0000,0000,,Ол үлкенірек болды.
Dialogue: 0,0:10:00.50,0:10:02.66,Default,,0000,0000,0000,,Жақында 2 метрден асады.
Dialogue: 0,0:10:02.66,0:10:04.67,Default,,0000,0000,0000,,Иә, рахмет!
Dialogue: 0,0:10:04.67,0:10:07.00,Default,,0000,0000,0000,,Сіз көбірек көргіңіз келетін бала бар ма?
Dialogue: 0,0:10:04.67,0:10:07.00,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:10:07.00,0:10:10.51,Default,,0000,0000,0000,,О.
Dialogue: 0,0:10:10.51,0:10:12.81,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:10:16.18,0:10:18.18,Default,,0000,0000,0000,,Осы жерде күтейік.
Dialogue: 0,0:10:18.18,0:10:22.02,Default,,0000,0000,0000,,Ишихара мырзаға қалдырсаңыз, бәрі жақсы болады.
Dialogue: 0,0:10:18.18,0:10:22.02,Default,,0000,0000,0000,,Сакаки мырза.
Dialogue: 0,0:10:22.02,0:10:24.35,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:10:22.02,0:10:24.35,Default,,0000,0000,0000,,Ишихара мырзаға рахмет➡
Dialogue: 0,0:10:24.35,0:10:26.69,Default,,0000,0000,0000,,Тадайоши-санның да көңіл-күйі әрқашан жақсы.
Dialogue: 0,0:10:26.69,0:10:29.09,Default,,0000,0000,0000,,Орнымызға отырайық.
Dialogue: 0,0:10:26.69,0:10:29.09,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:32.36,0:10:34.86,Default,,0000,0000,0000,,Мына мысық, мен ойладым...
Dialogue: 0,0:10:34.86,0:10:40.04,Default,,0000,0000,0000,,Сөз жоқ. біз
Dialogue: 0,0:10:34.86,0:10:40.04,Default,,0000,0000,0000,,Бұл Ямамая, мен оны мектептегі саяхатта кездестірдім.
Dialogue: 0,0:10:40.04,0:10:42.70,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:10:42.70,0:10:46.88,Default,,0000,0000,0000,,Бірақ мен Сакаки-санды жиі көремін.
Dialogue: 0,0:10:42.70,0:10:46.88,Default,,0000,0000,0000,,Түсінді.
Dialogue: 0,0:10:46.88,0:10:49.04,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:49.04,0:10:54.22,Default,,0000,0000,0000,,《Иә, Ямамая
Dialogue: 0,0:10:49.04,0:10:54.22,Default,,0000,0000,0000,,Ол маған келді》
Dialogue: 0,0:10:54.22,0:10:56.22,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:54.22,0:10:56.22,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:56.22,0:10:59.72,Default,,0000,0000,0000,,О Чио-чан
Dialogue: 0,0:10:56.22,0:10:59.72,Default,,0000,0000,0000,,Ол бұрынғыдан үлкенірек.
Dialogue: 0,0:10:59.72,0:11:01.82,Default,,0000,0000,0000,,Иә! рақмет сізге!
Dialogue: 0,0:11:01.82,0:11:04.16,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:01.82,0:11:04.16,Default,,0000,0000,0000,,Бұл көмектеседі, солай ма?
Dialogue: 0,0:11:04.16,0:11:08.83,Default,,0000,0000,0000,,Жарайды, мен физикалық тұрғыдан әлсізмін, бірақ
Dialogue: 0,0:11:04.16,0:11:08.83,Default,,0000,0000,0000,,Не, жарайды.
Dialogue: 0,0:11:08.83,0:11:12.00,Default,,0000,0000,0000,,Тамақтану
Dialogue: 0,0:11:08.83,0:11:12.00,Default,,0000,0000,0000,,Біраз демалсаңыз, сауығып кетесіз.
Dialogue: 0,0:11:12.00,0:11:15.34,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:11:12.00,0:11:15.34,Default,,0000,0000,0000,,Бұл біртүрлі мысық.
Dialogue: 0,0:11:15.34,0:11:18.34,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:11:15.34,0:11:18.34,Default,,0000,0000,0000,,Мен де көптен бері мал дәрігері болдым➡
Dialogue: 0,0:11:18.34,0:11:20.34,Default,,0000,0000,0000,,Иә, бұл менің бірінші рет.
Dialogue: 0,0:11:20.34,0:11:23.18,Default,,0000,0000,0000,,Не айтайын, Ириомот сияқты...
Dialogue: 0,0:11:23.18,0:11:25.18,Default,,0000,0000,0000,,Бұл гибрид.
Dialogue: 0,0:11:23.18,0:11:25.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:25.18,0:11:27.68,Default,,0000,0000,0000,,Бұл гибрид.
Dialogue: 0,0:11:27.68,0:11:31.52,Default,,0000,0000,0000,,Мен көремін. Бұл гибрид.
Dialogue: 0,0:11:31.52,0:11:35.19,Default,,0000,0000,0000,,Моңғол Маңғол Ол бала – бөбек.
Dialogue: 0,0:11:35.19,0:11:38.86,Default,,0000,0000,0000,,Шынымен бе? Чиё-чан.
Dialogue: 0,0:11:35.19,0:11:38.86,Default,,0000,0000,0000,,Иә! Бұл гибрид!
Dialogue: 0,0:11:38.86,0:11:41.70,Default,,0000,0000,0000,,Олай болса, мені үйге апарыңыз.
Dialogue: 0,0:11:41.70,0:11:44.03,Default,,0000,0000,0000,,Абайлаңыз.
Dialogue: 0,0:11:41.70,0:11:44.03,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:11:44.03,0:11:46.03,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:11:46.03,0:11:48.04,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:11:48.04,0:11:50.71,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,0:11:50.71,0:11:53.54,Default,,0000,0000,0000,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:11:50.71,0:11:53.54,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:11:53.54,0:11:56.38,Default,,0000,0000,0000,,Не істейсің, Ямамая?
Dialogue: 0,0:11:56.38,0:11:59.71,Default,,0000,0000,0000,,Нені істеген дұрыс?
Dialogue: 0,0:11:56.38,0:11:59.71,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:11:59.71,0:12:06.99,Default,,0000,0000,0000,,Бірақ бұл бала маған сенеді.
Dialogue: 0,0:11:59.71,0:12:06.99,Default,,0000,0000,0000,,Мен мұнда өмірімді қатерге тігіп келдім деп ойлаймын.
Dialogue: 0,0:12:06.99,0:12:12.33,Default,,0000,0000,0000,,Менің ойымша, бұл өте... қиын болды.
Dialogue: 0,0:12:12.33,0:12:17.17,Default,,0000,0000,0000,,Сол сезімге бар күшімді салдым
Dialogue: 0,0:12:12.33,0:12:17.17,Default,,0000,0000,0000,,Сіз жауап беруіңіз керек.
Dialogue: 0,0:12:17.17,0:12:19.17,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:12:19.17,0:12:22.50,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:12:19.17,0:12:22.50,Default,,0000,0000,0000,,Сакаки-санның орнында анасы...
Dialogue: 0,0:12:22.50,0:12:24.51,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:12:24.51,0:12:28.01,Default,,0000,0000,0000,,Иә! Көктемге дейін
Dialogue: 0,0:12:24.51,0:12:28.01,Default,,0000,0000,0000,,Оны бізге қалдырыңыз!
Dialogue: 0,0:12:28.01,0:12:30.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:30.01,0:12:33.35,Default,,0000,0000,0000,,Сакаки-сан жалғыз өмір сүре бастағанда
Dialogue: 0,0:12:30.01,0:12:33.35,Default,,0000,0000,0000,,Мені өзіңізбен бірге алыңыз.
Dialogue: 0,0:12:33.35,0:12:35.35,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:12:33.35,0:12:35.35,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:12:35.35,0:12:38.19,Default,,0000,0000,0000,,Жарайсың ба? Сонымен... Ямамая.
Dialogue: 0,0:12:38.19,0:12:40.39,Default,,0000,0000,0000,,Гяв….
Dialogue: 0,0:12:38.19,0:12:40.39,Default,,0000,0000,0000,,Ах! Мен жауап бердім!
Dialogue: 0,0:12:43.69,0:12:48.03,Default,,0000,0000,0000,,Иә, Майя.
Dialogue: 0,0:12:43.69,0:12:48.03,Default,,0000,0000,0000,,Мына баланың атын Майя деп қояйық.
Dialogue: 0,0:12:48.03,0:12:51.70,Default,,0000,0000,0000,,Майя Тадаёсимен
Dialogue: 0,0:12:48.03,0:12:51.70,Default,,0000,0000,0000,,Біз жақсы араласа аламыз ба?
Dialogue: 0,0:12:51.70,0:12:53.70,Default,,0000,0000,0000,,Мен аламын.
Dialogue: 0,0:12:55.70,0:12:59.87,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:59.87,0:13:02.81,Default,,0000,0000,0000,,Өтірік! Ямамая осында! ? Керемет!
Dialogue: 0,0:13:02.81,0:13:05.98,Default,,0000,0000,0000,,Бұл қазір менің ішімде, солай емес пе?
Dialogue: 0,0:13:05.98,0:13:08.98,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:05.98,0:13:08.98,Default,,0000,0000,0000,,Керемет! Бұл керемет, Ямамая!
Dialogue: 0,0:13:08.98,0:13:11.49,Default,,0000,0000,0000,,Керемет
Dialogue: 0,0:13:08.98,0:13:11.49,Default,,0000,0000,0000,,Даналықты тым асырып жіберген.
Dialogue: 0,0:13:11.49,0:13:13.66,Default,,0000,0000,0000,,Иә! Ха!
Dialogue: 0,0:13:13.66,0:13:16.66,Default,,0000,0000,0000,,Шынымды айтсам, барлығы
Dialogue: 0,0:13:13.66,0:13:16.66,Default,,0000,0000,0000,,Үйге барар жолда тоқтауым керек пе?
Dialogue: 0,0:13:16.66,0:13:19.66,Default,,0000,0000,0000,,Мен сізбен біраз уақыттан кейін бірінші рет кездескім келеді.
Dialogue: 0,0:13:19.66,0:13:22.16,Default,,0000,0000,0000,,Жарайды! Чиё Чан, кеттік!
Dialogue: 0,0:13:22.16,0:13:25.00,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:13:22.16,0:13:25.00,Default,,0000,0000,0000,,Коёми мен Кагура да барады, солай ма?
Dialogue: 0,0:13:25.00,0:13:27.67,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:13:25.00,0:13:27.67,Default,,0000,0000,0000,,Бүгін менде үйірме жұмыстары жоқ.
Dialogue: 0,0:13:27.67,0:13:30.17,Default,,0000,0000,0000,,Сонымен, кәдімгі алты адам...
Dialogue: 0,0:13:30.17,0:13:34.01,Default,,0000,0000,0000,,Иә? иә? Сакаки ше?
Dialogue: 0,0:13:34.01,0:13:36.85,Default,,0000,0000,0000,,Бұл дәретхана ма?
Dialogue: 0,0:13:36.85,0:13:38.85,Default,,0000,0000,0000,,Бұл! ? Қазірдің өзінде сыртта!
Dialogue: 0,0:13:38.85,0:13:41.05,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:13:46.86,0:13:50.86,Default,,0000,0000,0000,,Осыған ұқсас нәрсе
Dialogue: 0,0:13:46.86,0:13:50.86,Default,,0000,0000,0000,,«Ақырын жүру» деп аталады.
Dialogue: 0,0:13:50.86,0:13:53.36,Default,,0000,0000,0000,,Біреуге қамқорлық жасау қиын ба?
Dialogue: 0,0:13:53.36,0:13:56.87,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:53.36,0:13:56.87,Default,,0000,0000,0000,,Мен әртүрлі кітаптарды оқып, зерттедім.
Dialogue: 0,0:13:56.87,0:14:00.97,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:13:56.87,0:14:00.97,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:00.97,0:14:02.97,Default,,0000,0000,0000,,Мм... Мм.
Dialogue: 0,0:14:02.97,0:14:04.97,Default,,0000,0000,0000,,Нишихё аралының экожүйесі...
Dialogue: 0,0:14:04.97,0:14:06.98,Default,,0000,0000,0000,,Бұл Ириомот~.
Dialogue: 0,0:14:06.98,0:14:10.31,Default,,0000,0000,0000,,Менің білетінім осы ғана!
Dialogue: 0,0:14:06.98,0:14:10.31,Default,,0000,0000,0000,,Бұл әдейі! Бұл жерде!
Dialogue: 0,0:14:10.31,0:14:13.82,Default,,0000,0000,0000,,Қайсысы?
Dialogue: 0,0:14:10.31,0:14:13.82,Default,,0000,0000,0000,,Бірақ Пиканя, сен осындасың!
Dialogue: 0,0:14:13.82,0:14:16.82,Default,,0000,0000,0000,,Демек, бұл Пиканха емес.
Dialogue: 0,0:14:16.82,0:14:21.49,Default,,0000,0000,0000,,Иә? Пика….
Dialogue: 0,0:14:21.49,0:14:26.33,Default,,0000,0000,0000,,Пикан... Мияу?
Dialogue: 0,0:14:26.33,0:14:28.33,Default,,0000,0000,0000,,Пикка~ Пикка….
Dialogue: 0,0:14:28.33,0:14:30.67,Default,,0000,0000,0000,,Енді Пиканха жоқ
Dialogue: 0,0:14:28.33,0:14:30.67,Default,,0000,0000,0000,,Оны аламыз ба?
Dialogue: 0,0:14:30.67,0:14:33.17,Default,,0000,0000,0000,,Жоқ, көңіл көтеру жақсы емес.
Dialogue: 0,0:14:33.17,0:14:37.34,Default,,0000,0000,0000,,Ах! Чиё-чан
Dialogue: 0,0:14:33.17,0:14:37.34,Default,,0000,0000,0000,,Тадайоши-сан, жақсысың ба?
Dialogue: 0,0:14:37.34,0:14:39.51,Default,,0000,0000,0000,,Сізді жеп қояды!
Dialogue: 0,0:14:39.51,0:14:43.34,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:14:39.51,0:14:43.34,Default,,0000,0000,0000,,Бұл өте үлкен.
Dialogue: 0,0:14:43.34,0:14:48.35,Default,,0000,0000,0000,,Ириомот жабайы мысығы кейде тіпті жабайы қабан болады.
Dialogue: 0,0:14:43.34,0:14:48.35,Default,,0000,0000,0000,,Аң аулау және жеу.
Dialogue: 0,0:14:48.35,0:14:55.35,Default,,0000,0000,0000,,Ха! Ааааааааааааааааааааааааааааа!
Dialogue: 0,0:14:57.53,0:15:00.13,Default,,0000,0000,0000,,Үйге тез жетейік!
Dialogue: 0,0:14:57.53,0:15:00.13,Default,,0000,0000,0000,,Асығыңыз!тез!
Dialogue: 0,0:15:00.13,0:15:02.13,Default,,0000,0000,0000,,Уайымдамаңыз.
Dialogue: 0,0:15:02.13,0:15:04.13,Default,,0000,0000,0000,,Чио-чан жүгіріп келеді!
Dialogue: 0,0:15:04.13,0:15:06.13,Default,,0000,0000,0000,,Жарайсыңдар, жарыс!
Dialogue: 0,0:15:06.13,0:15:08.14,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:15:08.14,0:15:11.64,Default,,0000,0000,0000,,А, күте тұрыңыз!
Dialogue: 0,0:15:11.64,0:15:13.64,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:15:11.64,0:15:13.64,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:15:13.64,0:15:17.31,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:15:13.64,0:15:17.31,Default,,0000,0000,0000,,Күтіңіз...
Dialogue: 0,0:15:17.31,0:15:21.65,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:15:21.65,0:15:24.65,Default,,0000,0000,0000,,Чио-чан, сен әлі келдің бе?
Dialogue: 0,0:15:24.65,0:15:27.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:29.66,0:15:31.99,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:31.99,0:15:35.16,Default,,0000,0000,0000,,Жоқ! Мен уақытында үлгермедім...
Dialogue: 0,0:15:35.16,0:15:37.16,Default,,0000,0000,0000,,(Каэдэ) Қайтып келдіңіз, аға.
Dialogue: 0,0:15:39.17,0:15:41.17,Default,,0000,0000,0000,,(қақпаның ашылу/жабылу дыбысы)
Dialogue: 0,0:15:41.17,0:15:43.67,Default,,0000,0000,0000,,Тадаёси-сан!
Dialogue: 0,0:15:41.17,0:15:43.67,Default,,0000,0000,0000,,Майя!
Dialogue: 0,0:15:43.67,0:15:49.01,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:15:49.01,0:15:51.35,Default,,0000,0000,0000,,Сәлем! ?
Dialogue: 0,0:15:51.35,0:15:54.18,Default,,0000,0000,0000,,Майя.
Dialogue: 0,0:15:51.35,0:15:54.18,Default,,0000,0000,0000,,Мияу.
Dialogue: 0,0:15:54.18,0:15:56.18,Default,,0000,0000,0000,,Жақсы! О! ?
Dialogue: 0,0:15:58.19,0:16:00.39,Default,,0000,0000,0000,,Тадайоши-сан Ах!
Dialogue: 0,0:16:03.29,0:16:05.29,Default,,0000,0000,0000,,Жалғастырыңыз.
Dialogue: 0,0:16:05.29,0:16:07.63,Default,,0000,0000,0000,,Уау! иә!
Dialogue: 0,0:16:07.63,0:16:10.30,Default,,0000,0000,0000,,Үлкен котацу!
Dialogue: 0,0:16:10.30,0:16:12.30,Default,,0000,0000,0000,,Чиё-чан, котацуға келе аламыз ба?
Dialogue: 0,0:16:12.30,0:16:14.64,Default,,0000,0000,0000,,Мен дәретхананы қарызға алдым.
Dialogue: 0,0:16:12.30,0:16:14.64,Default,,0000,0000,0000,,Жалғастырыңыз.
Dialogue: 0,0:16:14.64,0:16:16.64,Default,,0000,0000,0000,,Ол қазірдің өзінде бар ма?
Dialogue: 0,0:16:16.64,0:16:19.64,Default,,0000,0000,0000,,Иә, котацу жақсы.
Dialogue: 0,0:16:21.98,0:16:25.28,Default,,0000,0000,0000,,О? Біраз уақыт өтті~ Пи….
Dialogue: 0,0:16:27.32,0:16:29.98,Default,,0000,0000,0000,,Пика... Мияу?
Dialogue: 0,0:16:29.98,0:16:32.48,Default,,0000,0000,0000,,Мен енді Пиканхаға қарсы емеспін...
Dialogue: 0,0:16:35.82,0:16:38.16,Default,,0000,0000,0000,,Тадайоши~! Мен оны жеймін!
Dialogue: 0,0:16:38.16,0:16:41.33,Default,,0000,0000,0000,,Қараңдар, қараңдар!
Dialogue: 0,0:16:38.16,0:16:41.33,Default,,0000,0000,0000,,Мая осылай істесең ашуланады.
Dialogue: 0,0:16:41.33,0:16:43.50,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:43.50,0:16:45.50,Default,,0000,0000,0000,,Хи хи хи!
Dialogue: 0,0:16:45.50,0:16:49.17,Default,,0000,0000,0000,,Мен Ириомот жабайы мысықпын~!
Dialogue: 0,0:16:45.50,0:16:49.17,Default,,0000,0000,0000,,Иә, Котацу жақсы.
Dialogue: 0,0:16:49.17,0:16:52.17,Default,,0000,0000,0000,,Гао! Гагаогао!
Dialogue: 0,0:16:49.17,0:16:52.17,Default,,0000,0000,0000,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:16:52.17,0:16:54.68,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:16:54.68,0:16:56.68,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:56.68,0:16:58.68,Default,,0000,0000,0000,,Ауырды.
Dialogue: 0,0:16:56.68,0:16:58.68,Default,,0000,0000,0000,,Э? Естімеймін.
Dialogue: 0,0:16:58.68,0:17:02.62,Default,,0000,0000,0000,,Ауырды... Ауырды...
Dialogue: 0,0:16:58.68,0:17:02.62,Default,,0000,0000,0000,,Қан Қаншама қан!
Dialogue: 0,0:17:02.62,0:17:06.12,Default,,0000,0000,0000,,Қара, ештеңе айтпа.
Dialogue: 0,0:17:02.62,0:17:06.12,Default,,0000,0000,0000,,Аурухана ауруханасы!
Dialogue: 0,0:17:06.12,0:17:08.46,Default,,0000,0000,0000,,Адамдарды тырнауға болмайды.
Dialogue: 0,0:17:08.46,0:17:11.63,Default,,0000,0000,0000,,Жоқ! Жарайсың! Майя!
Dialogue: 0,0:17:08.46,0:17:11.63,Default,,0000,0000,0000,,(Томоның жылаған дауысы)
Dialogue: 0,0:17:11.63,0:17:14.03,Default,,0000,0000,0000,,Сіз тым алшақсыз!
Dialogue: 0,0:17:16.13,0:17:18.80,Default,,0000,0000,0000,,Ертең мектепте кездескенше.
Dialogue: 0,0:17:18.80,0:17:21.47,Default,,0000,0000,0000,,Котацу қайтадан!
Dialogue: 0,0:17:18.80,0:17:21.47,Default,,0000,0000,0000,,Сакаки ше?
Dialogue: 0,0:17:21.47,0:17:23.47,Default,,0000,0000,0000,,Менде тағы біраз қалды.
Dialogue: 0,0:17:23.47,0:17:25.47,Default,,0000,0000,0000,,Сатоши-чан, жақсысың ба?
Dialogue: 0,0:17:25.47,0:17:27.48,Default,,0000,0000,0000,,Уф, мен оны жек көремін.
Dialogue: 0,0:17:27.48,0:17:31.15,Default,,0000,0000,0000,,Бұл сен кінәлі.
Dialogue: 0,0:17:27.48,0:17:31.15,Default,,0000,0000,0000,,Мен бір рет жарақат алғаныма қуаныштымын.
Dialogue: 0,0:17:31.15,0:17:33.31,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:17:31.15,0:17:33.31,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:17:33.31,0:17:35.32,Default,,0000,0000,0000,,Егер бұл рас болса.
Dialogue: 0,0:17:35.32,0:17:37.49,Default,,0000,0000,0000,,Иә, онда!
Dialogue: 0,0:17:37.49,0:17:41.49,Default,,0000,0000,0000,,Ауырды...
Dialogue: 0,0:17:37.49,0:17:41.49,Default,,0000,0000,0000,,Жақсы дәрі. Аздап ойланыңыз.
Dialogue: 0,0:17:41.49,0:17:43.99,Default,,0000,0000,0000,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:17:41.49,0:17:43.99,Default,,0000,0000,0000,,Барка.
Dialogue: 0,0:17:41.49,0:17:43.99,Default,,0000,0000,0000,,Барка.
Dialogue: 0,0:17:43.99,0:17:47.50,Default,,0000,0000,0000,,《Жарақат алсам да, маған осылай айтты.
Dialogue: 0,0:17:43.99,0:17:47.50,Default,,0000,0000,0000,,Бұл керемет…》
Dialogue: 0,0:17:47.50,0:17:50.00,Default,,0000,0000,0000,,Котацу қайтадан!
Dialogue: 0,0:17:50.00,0:17:54.50,Default,,0000,0000,0000,,Сакаки мырза, бүгін түнде қалсақ қалай болады? (сағат дыбысы)
Dialogue: 0,0:17:54.50,0:17:56.84,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:17:54.50,0:17:56.84,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:17:56.84,0:17:59.51,Default,,0000,0000,0000,,Майямен бірге болыңыз.
Dialogue: 0,0:17:59.51,0:18:02.11,Default,,0000,0000,0000,,(Сағат дыбысы)
Dialogue: 0,0:18:02.11,0:18:04.28,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:18:02.11,0:18:04.28,Default,,0000,0000,0000,,Олай болса, Сакаки мырза➡
Dialogue: 0,0:18:04.28,0:18:06.95,Default,,0000,0000,0000,,Алдымен бөлмеңізге оралыңыз.
Dialogue: 0,0:18:06.95,0:18:08.95,Default,,0000,0000,0000,,Мен саған кофе дайындаймын.
Dialogue: 0,0:18:08.95,0:18:12.62,Default,,0000,0000,0000,,♬ «Жасай берейік
Dialogue: 0,0:18:08.95,0:18:12.62,Default,,0000,0000,0000,,Жасайық».
Dialogue: 0,0:18:12.62,0:18:16.52,Default,,0000,0000,0000,,♬ «Енді мен не істей аламын?»
Dialogue: 0,0:18:30.30,0:18:37.98,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:18:37.98,0:18:40.31,Default,,0000,0000,0000,,Мияу.
Dialogue: 0,0:18:40.31,0:18:43.65,Default,,0000,0000,0000,,Оқуды бітіргеннен кейін
Dialogue: 0,0:18:40.31,0:18:43.65,Default,,0000,0000,0000,,Біз күнде бірге өмір сүре аламыз.
Dialogue: 0,0:18:43.65,0:18:45.82,Default,,0000,0000,0000,,Майя.
Dialogue: 0,0:18:43.65,0:18:45.82,Default,,0000,0000,0000,,Мияу.
Dialogue: 0,0:18:45.82,0:18:48.66,Default,,0000,0000,0000,,Ах ха….
Dialogue: 0,0:18:48.66,0:18:50.99,Default,,0000,0000,0000,,Майя.
Dialogue: 0,0:18:48.66,0:18:50.99,Default,,0000,0000,0000,,Мя.
Dialogue: 0,0:18:50.99,0:18:53.49,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,0:18:56.16,0:18:58.17,Default,,0000,0000,0000,,Няу.
Dialogue: 0,0:18:58.17,0:19:01.60,Default,,0000,0000,0000,,А, өте сүйкімді.
Dialogue: 0,0:19:01.60,0:19:11.45,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:11.45,0:19:14.45,Default,,0000,0000,0000,,Күткеніңізге рахмет!
Dialogue: 0,0:19:14.45,0:19:17.45,Default,,0000,0000,0000,,Бұл кофе...
Dialogue: 0,0:19:21.29,0:19:24.13,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:19:21.29,0:19:24.13,Default,,0000,0000,0000,,Уа...
Dialogue: 0,0:19:24.13,0:19:27.30,Default,,0000,0000,0000,,Чиёчанчи Котацу Дұрыс.
Dialogue: 0,0:19:27.30,0:19:29.46,Default,,0000,0000,0000,,Чикусо Ауырды.
Dialogue: 0,0:19:29.46,0:19:31.47,Default,,0000,0000,0000,,Өзің кінәлісің.
Dialogue: 0,0:19:31.47,0:19:33.97,Default,,0000,0000,0000,,Сіз енді жануарларға сенесіз бе?
Dialogue: 0,0:19:33.97,0:19:37.47,Default,,0000,0000,0000,,Бұл жаман даналық.
Dialogue: 0,0:19:33.97,0:19:37.47,Default,,0000,0000,0000,,Майя сен оны жек көрдің, солай ма?
Dialogue: 0,0:19:37.47,0:19:40.64,Default,,0000,0000,0000,,Оған не болды?
Dialogue: 0,0:19:37.47,0:19:40.64,Default,,0000,0000,0000,,Оларға мейірімділік танытсаң, олар тістемейді.
Dialogue: 0,0:19:40.64,0:19:42.98,Default,,0000,0000,0000,,Мысық бар.
Dialogue: 0,0:19:40.64,0:19:42.98,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:19:42.98,0:19:45.65,Default,,0000,0000,0000,,Мяу мысық.
Dialogue: 0,0:19:42.98,0:19:45.65,Default,,0000,0000,0000,,Мысал келтіріңіз.
Dialogue: 0,0:19:45.65,0:19:47.82,Default,,0000,0000,0000,,Сатоси, кел!
Dialogue: 0,0:19:45.65,0:19:47.82,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:47.82,0:19:50.65,Default,,0000,0000,0000,,Эй, келіңдер.
Dialogue: 0,0:19:50.65,0:19:54.99,Default,,0000,0000,0000,,Қараңдаршы, мен қорықпаймын.
Dialogue: 0,0:19:54.99,0:19:56.99,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:19:54.99,0:19:56.99,Default,,0000,0000,0000,,Уау! ?
Dialogue: 0,0:19:56.99,0:19:59.83,Default,,0000,0000,0000,,Қорықпа.
Dialogue: 0,0:19:59.83,0:20:02.66,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:20:02.66,0:20:04.83,Default,,0000,0000,0000,,Ня….
Dialogue: 0,0:20:04.83,0:20:07.50,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:04.83,0:20:07.50,Default,,0000,0000,0000,,Мен Неко-няға бардым.
Dialogue: 0,0:20:07.50,0:20:10.00,Default,,0000,0000,0000,,Менің қолымды не үшін пайдаландың?
Dialogue: 0,0:20:10.00,0:20:12.84,Default,,0000,0000,0000,,Өйткені мені тістеп алғым келмейді.
Dialogue: 0,0:20:10.00,0:20:12.84,Default,,0000,0000,0000,,О, қой, қоя бер
Dialogue: 0,0:20:12.84,0:20:16.01,Default,,0000,0000,0000,,Кейде даналық
Dialogue: 0,0:20:12.84,0:20:16.01,Default,,0000,0000,0000,,Қорыққан жақсы.
Dialogue: 0,0:20:16.01,0:20:20.85,Default,,0000,0000,0000,,♬ «Жуынайық
Dialogue: 0,0:20:16.01,0:20:20.85,Default,,0000,0000,0000,,Жуайық».
Dialogue: 0,0:20:20.85,0:20:24.19,Default,,0000,0000,0000,,Аяқтауға жақын. Жақсы бала.
Dialogue: 0,0:20:24.19,0:20:27.19,Default,,0000,0000,0000,,Өйткені, бұл Сакаки-сан.
Dialogue: 0,0:20:24.19,0:20:27.19,Default,,0000,0000,0000,,Тыныш, солай емес пе?
Dialogue: 0,0:20:27.19,0:20:30.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:27.19,0:20:30.02,Default,,0000,0000,0000,,Кеше мен жууға тырысқанда➡
Dialogue: 0,0:20:30.02,0:20:32.36,Default,,0000,0000,0000,,Ол шынымен жабайы болды.
Dialogue: 0,0:20:32.36,0:20:35.36,Default,,0000,0000,0000,,Маған күшіңді бересің бе?
Dialogue: 0,0:20:35.36,0:20:37.70,Default,,0000,0000,0000,,Ағын болсын.
Dialogue: 0,0:20:37.70,0:20:39.90,Default,,0000,0000,0000,,Қараңызшы, қазір таза.
Dialogue: 0,0:20:45.04,0:20:47.04,Default,,0000,0000,0000,,Сіз сенімдісіз бе? Сакаки мырза.
Dialogue: 0,0:20:47.04,0:20:50.38,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:20:47.04,0:20:50.38,Default,,0000,0000,0000,,Иә Жою.
Dialogue: 0,0:20:50.38,0:20:52.38,Default,,0000,0000,0000,,Майя.
Dialogue: 0,0:20:52.38,0:20:54.38,Default,,0000,0000,0000,,Ахаха!
Dialogue: 0,0:20:54.38,0:20:56.38,Default,,0000,0000,0000,,Мияу.
Dialogue: 0,0:20:56.38,0:20:59.72,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:59.72,0:21:01.66,Default,,0000,0000,0000,,Хэхе….
Dialogue: 0,0:21:01.66,0:21:06.33,Default,,0000,0000,0000,,Сакаки-сан деген кім?
Dialogue: 0,0:21:01.66,0:21:06.33,Default,,0000,0000,0000,,Сіз жануарларды өте жақсы көресіз.
Dialogue: 0,0:21:06.33,0:21:09.33,Default,,0000,0000,0000,,Маған сүйкімді нәрселер ұнайды.
Dialogue: 0,0:21:09.33,0:21:14.34,Default,,0000,0000,0000,,Мен кішкентайымнан үлкенмін.
Dialogue: 0,0:21:09.33,0:21:14.34,Default,,0000,0000,0000,,Өйткені ол сүйкімді емес еді.
Dialogue: 0,0:21:14.34,0:21:16.34,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:21:16.34,0:21:20.17,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:16.34,0:21:20.17,Default,,0000,0000,0000,,Дәл қазір
Dialogue: 0,0:21:16.34,0:21:20.17,Default,,0000,0000,0000,,Сакаки мырза Майямен ойнап отырды➡
Dialogue: 0,0:21:20.17,0:21:22.84,Default,,0000,0000,0000,,Өте сүйкімді болды.
Dialogue: 0,0:21:22.84,0:21:25.18,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:21:25.18,0:21:27.18,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,0:21:27.18,0:21:29.38,Default,,0000,0000,0000,,Иә! Бұл сүйкімді болды.
Dialogue: 0,0:21:31.52,0:21:33.69,Default,,0000,0000,0000,,Мя.
Dialogue: 0,0:21:31.52,0:21:33.69,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:33.69,0:21:39.03,Default,,0000,0000,0000,,Майя - Сакаки-сан
Dialogue: 0,0:21:33.69,0:21:39.03,Default,,0000,0000,0000,,Менің анам деп ойлаймын.
Dialogue: 0,0:21:39.03,0:21:49.54,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:49.54,0:21:53.04,Default,,0000,0000,0000,,Қайырлы түн Майя.
Dialogue: 0,0:21:54.54,0:22:00.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory