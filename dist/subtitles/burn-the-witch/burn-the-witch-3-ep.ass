Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.01,0:00:18.30,Default,,0,0,0,,Йо
Dialogue: 0,0:00:18.89,0:00:22.31,Default,,0,0,0,,Соңғы қоштасуларыңызды айттыңыз ба?
Dialogue: 0,0:00:23.64,0:00:24.89,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:31.69,0:00:34.99,Default,,0,0,0,,Мүлікке зиян келтіру, тұлғааралық ұрыс
Dialogue: 0,0:00:35.49,0:00:37.78,Default,,0,0,0,,Witchkit пайдалану ережелерін бұзу
Dialogue: 0,0:00:38.28,0:00:41.29,Default,,0,0,0,,Сондай-ақ, маған әртүрлі айыптар тағылды.
Dialogue: 0,0:00:41.79,0:00:43.71,Default,,0,0,0,,үшінн қалдырыңыз.
Dialogue: 0,0:00:44.50,0:00:46.58,Default,,0,0,0,,Әзірше осы.
Dialogue: 0,0:00:50.34,0:00:51.92,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:00:52.01,0:00:54.76,Default,,0,0,0,,Барго Парктерді зиянды айдаһар ретінде белгілеу аяқталды.
Dialogue: 0,0:00:54.84,0:00:57.18,Default,,0,0,0,,Осы сәттен бастап сол адам
Dialogue: 0,0:00:57.26,0:01:00.14,Default,,0,0,0,,Кері Лондонның барлық сиқыршыларынан
Dialogue: 0,0:01:00.22,0:01:02.64,Default,,0,0,0,,Бағындыру нысанасы ретінде бағытталған
Dialogue: 0,0:01:03.27,0:01:06.19,Default,,0,0,0,,Не, мені нысанаға алып жатыр ма? неге?
Dialogue: 0,0:01:06.27,0:01:08.90,Default,,0,0,0,,Мен оқиғаны мүлдем көре алмаймын...
Dialogue: 0,0:01:09.56,0:01:12.90,Default,,0,0,0,,Не, сен оған әлі ештеңе айтқан жоқсың ба?
Dialogue: 0,0:01:13.40,0:01:17.78,Default,,0,0,0,,Жарайды, өлетін адамға неге өлетінін айтпайсың?
Dialogue: 0,0:01:18.41,0:01:21.24,Default,,0,0,0,,Мүмкін бұл жай ғана рақым шығар!
Dialogue: 0,0:01:22.41,0:01:25.21,Default,,0,0,0,,Уау, сенің айтқаның да, жүзің де қорқынышты.
Dialogue: 0,0:01:25.29,0:01:26.16,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:01:26.25,0:01:29.50,Default,,0,0,0,,Нинни-чан үш санға ұшқын шашады
Dialogue: 0,0:01:29.58,0:01:30.92,Default,,0,0,0,,Екіге бөлейік.
Dialogue: 0,0:01:31.00,0:01:31.67,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:32.30,0:01:33.88,Default,,0,0,0,,Варго мырза мен Мэйси мырза
Dialogue: 0,0:01:33.96,0:01:35.22,Default,,0,0,0,,Сізге қайсысы ұнайды?
Dialogue: 0,0:01:35.30,0:01:37.30,Default,,0,0,0,,Сұраудың мәні бар ма? ол
Dialogue: 0,0:01:39.59,0:01:41.81,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды білмеймін.
Dialogue: 0,0:01:41.89,0:01:44.31,Default,,0,0,0,,Мені Реверс Лондонның түкпір-түкпірінен нысанаға алып жатыр.
Dialogue: 0,0:01:44.39,0:01:46.77,Default,,0,0,0,,Қай жаққа қашып бара жатырсың?
Dialogue: 0,0:01:47.27,0:01:48.65,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:01:49.15,0:01:50.56,Default,,0,0,0,,Бруно мырза...
Dialogue: 0,0:01:50.65,0:01:53.82,Default,,0,0,0,,Ха! Эллидің дауысы...
Dialogue: 0,0:01:53.90,0:01:55.40,Default,,0,0,0,,Жақындау
Dialogue: 0,0:01:58.66,0:02:01.07,Default,,0,0,0,,(айқай)
Dialogue: 0,0:02:02.16,0:02:02.83,Default,,0,0,0,,Элли!
Dialogue: 0,0:02:02.91,0:02:03.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:04.49,0:02:05.83,Default,,0,0,0,,Сіз менің артымнан жүрдіңіз бе?
Dialogue: 0,0:02:10.04,0:02:12.96,Default,,0,0,0,,Бірақ бұл сізге өте жаман...
Dialogue: 0,0:02:13.55,0:02:14.80,Default,,0,0,0,,Менің бизнесім жоқ.
Dialogue: 0,0:02:18.05,0:02:18.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:19.05,0:02:21.22,Default,,0,0,0,,Жоқ! (Нинни) Ха...
Dialogue: 0,0:02:22.05,0:02:24.22,Default,,0,0,0,,Ойлап қарасам, алғаш көргенде...
Dialogue: 0,0:02:24.31,0:02:28.98,Default,,0,0,0,,Мен қараңғылықтан шыққандықтан солай көрінді деп ойладым, бірақ олай емес.
Dialogue: 0,0:02:29.48,0:02:31.23,Default,,0,0,0,,Жоқ болды.
Dialogue: 0,0:02:31.31,0:02:35.36,Default,,0,0,0,,Ақымақ болма! Бұл жасырын шкала ма?
Dialogue: 0,0:02:35.44,0:02:37.74,Default,,0,0,0,,Бұл айдаһарлар қолданатын әдіс емес!
Dialogue: 0,0:02:40.32,0:02:40.82,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:47.20,0:02:48.41,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:03:20.03,0:03:21.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:24.16,0:03:25.24,Default,,0,0,0,,Элли?
Dialogue: 0,0:03:43.76,0:03:46.97,Default,,0,0,0,,Бұл не? Пішіні мен өлшемі толығымен өзгерді
Dialogue: 0,0:03:49.18,0:03:51.52,Default,,0,0,0,,Ай сәулесінен шыққан шығар.
Dialogue: 0,0:03:51.60,0:03:53.56,Default,,0,0,0,,Бұл не? Дәл солай...
Dialogue: 0,0:03:53.65,0:03:55.19,Default,,0,0,0,,Иә, «дәл солай»
Dialogue: 0,0:03:55.27,0:03:56.27,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:57.48,0:04:00.57,Default,,0,0,0,,Ай сәулесінің әсерінен пайда болатын жасырын шкала
Dialogue: 0,0:04:00.65,0:04:03.66,Default,,0,0,0,,Және алты саусақ.
Dialogue: 0,0:04:04.16,0:04:07.49,Default,,0,0,0,,Қате болма, мына жігіт...
Dialogue: 0,0:04:08.24,0:04:09.70,Default,,0,0,0,,Ертегідегі айдаһар
Dialogue: 0,0:04:11.33,0:04:13.79,Default,,0,0,0,,Мен... Märchens дегеніміз не?
Dialogue: 0,0:04:14.29,0:04:17.71,Default,,0,0,0,,Кері Лондон туылғанға дейін болған дейді
Dialogue: 0,0:04:17.79,0:04:21.42,Default,,0,0,0,,Ертегінің атымен аталған жеті айдаһар.
Dialogue: 0,0:04:21.51,0:04:26.09,Default,,0,0,0,,Ақшақар қызыл көйлек Алтын балта
Dialogue: 0,0:04:26.59,0:04:31.06,Default,,0,0,0,,Көпіршіктер қант үйі жануарлар тобы
Dialogue: 0,0:04:31.14,0:04:32.27,Default,,0,0,0,,Және…
Dialogue: 0,0:04:34.06,0:04:38.06,Default,,0,0,0,,Айдаһарлар ай сәулесінен шығып, түнде ғана ересек айдаһарға айналады дейді.
Dialogue: 0,0:04:39.02,0:04:40.15,Default,,0,0,0,,Золушка
Dialogue: 0,0:04:40.65,0:04:42.44,Default,,0,0,0,,Золушка…
Dialogue: 0,0:04:44.49,0:04:48.32,Default,,0,0,0,,Атауы түнде ғана жетілетін ерекше экологиядан шыққан.
Dialogue: 0,0:04:49.16,0:04:50.95,Default,,0,0,0,,Қозған кезде шашу
Dialogue: 0,0:04:51.04,0:04:53.20,Default,,0,0,0,,Жұлдызды күл деп аталатын ұнтақта кездеседі
Dialogue: 0,0:04:54.50,0:04:56.21,Default,,0,0,0,,Ұнтақты ұстасаңыз...
Dialogue: 0,0:05:01.75,0:05:03.51,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:05:05.55,0:05:10.43,Default,,0,0,0,,Сөздікте бәрі жарықпен қоршалған... делінген.
Dialogue: 0,0:05:10.51,0:05:13.47,Default,,0,0,0,,Нені анық айтып тұрсың? Бұл бомба!
Dialogue: 0,0:05:15.31,0:05:18.02,Default,,0,0,0,,Варго саябақтары! Иә!
Dialogue: 0,0:05:18.90,0:05:21.40,Default,,0,0,0,,Мен сені бағындыруды кейінге қалдырамын.
Dialogue: 0,0:05:22.19,0:05:25.53,Default,,0,0,0,,...
Dialogue: 0,0:05:25.61,0:05:31.41,Default,,0,0,0,,Зұлым айдаһардың белгісі, тұрақты бағынышты нысанасы, бар екені белгісіз адамзаттың жауы...
Dialogue: 0,0:05:31.91,0:05:34.58,Default,,0,0,0,,Мен оны өз көзіммен көремін деп ойламадым.
Dialogue: 0,0:05:36.25,0:05:37.83,Default,,0,0,0,,Бұл мені тоңазытады.
Dialogue: 0,0:05:38.33,0:05:41.54,Default,,0,0,0,,Күте тұрыңыз! Сіз шынымен бұл нәрсемен күрескіңіз келе ме?
Dialogue: 0,0:05:41.63,0:05:44.05,Default,,0,0,0,,Ақымақ болма, ұрыспа.
Dialogue: 0,0:05:44.13,0:05:45.47,Default,,0,0,0,,Не? (Бруно) Мені өлтір.
Dialogue: 0,0:05:46.26,0:05:49.05,Default,,0,0,0,,Несие алмасаң, менен артық емессің.
Dialogue: 0,0:05:49.14,0:05:51.10,Default,,0,0,0,,Менің жолыма түспе, қарғыс атқыр бала.
Dialogue: 0,0:05:52.01,0:05:54.39,Default,,0,0,0,,Сіз мұны 3 бөлікпен жасай аласыз ба? риккенбэкер
Dialogue: 0,0:05:54.97,0:05:55.68,Default,,0,0,0,,(айқай)
Dialogue: 0,0:05:56.39,0:05:57.44,Default,,0,0,0,,Жақсы бала
Dialogue: 0,0:06:00.23,0:06:01.36,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:06:03.86,0:06:06.36,Default,,0,0,0,,Мен ол жерге шындап бардым, ол жігіт...
Dialogue: 0,0:06:07.36,0:06:09.70,Default,,0,0,0,,Ниха! Мұнда тікелей тәсілмен барайық.
Dialogue: 0,0:06:09.78,0:06:11.32,Default,,0,0,0,,Штабқа күшейтуді сұраңыз!
Dialogue: 0,0:06:11.41,0:06:13.37,Default,,0,0,0,,Маған ұнамайды (Нинни) Иә?
Dialogue: 0,0:06:13.87,0:06:15.95,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:06:16.58,0:06:19.46,Default,,0,0,0,,Варга-санның зиянды айдаһар ретінде тағайындалуының мерзімі өткен жоқ.
Dialogue: 0,0:06:19.96,0:06:23.38,Default,,0,0,0,,Егер сіз күшейтуді сұрасаңыз, Варго мырза өлтіріледі.
Dialogue: 0,0:06:23.46,0:06:25.30,Default,,0,0,0,,Жарайды... дұрыс, бірақ
Dialogue: 0,0:06:25.38,0:06:27.67,Default,,0,0,0,,Тіпті бас кеңседе, төтенше жағдайда...
Dialogue: 0,0:06:28.30,0:06:28.80,Default,,0,0,0,,А...
Dialogue: 0,0:06:28.88,0:06:30.89,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:34.64,0:06:37.81,Default,,0,0,0,,Бұл не? Жұлдыз Эш тірі ме?
Dialogue: 0,0:06:37.89,0:06:39.27,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:06:39.77,0:06:41.10,Default,,0,0,0,,Сөздік ақпараты ше?
Dialogue: 0,0:06:41.60,0:06:44.40,Default,,0,0,0,,Бұл Мархенс атты айдаһар.
Dialogue: 0,0:06:44.48,0:06:47.44,Default,,0,0,0,,Сөздіктегі жалғыз ақпарат – аңыз.
Dialogue: 0,0:07:00.54,0:07:02.46,Default,,0,0,0,,Шығарылым коды 0575
Dialogue: 0,0:07:03.75,0:07:04.88,Default,,0,0,0,,Құлып ашылды!
Dialogue: 0,0:07:05.55,0:07:08.34,Default,,0,0,0,,Кел, аштық көлеңке!
Dialogue: 0,0:07:15.81,0:07:17.22,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:07:25.98,0:07:26.90,Default,,0,0,0,,Чи…
Dialogue: 0,0:07:27.48,0:07:30.40,Default,,0,0,0,,Аштық көлеңкесінде тіпті қан кете алмайсыз ба?
Dialogue: 0,0:07:35.83,0:07:38.83,Default,,0,0,0,,Ей, ақыры келдіңіздер, бәйбішелер.
Dialogue: 0,0:07:39.91,0:07:43.46,Default,,0,0,0,,Оларға не болды? Сен оны қауіпсіз жерге қалдырдың ба?
Dialogue: 0,0:07:43.54,0:07:46.09,Default,,0,0,0,,Қай жерде қауіпсіз?
Dialogue: 0,0:07:46.17,0:07:48.09,Default,,0,0,0,,Мен оны сонда қалдырдым.
Dialogue: 0,0:07:48.17,0:07:50.76,Default,,0,0,0,,Барлық жерде дерлік мұндағыдан жақсы.
Dialogue: 0,0:07:51.42,0:07:52.97,Default,,0,0,0,,Айырмашылығы жоқ.
Dialogue: 0,0:07:55.01,0:07:56.51,Default,,0,0,0,,Мені қолдаңыз!
Dialogue: 0,0:07:57.35,0:08:01.89,Default,,0,0,0,,Золушканың маңдайындағы тәж тәрізді мүйізді сындырып өлтіруге болады.
Dialogue: 0,0:08:02.85,0:08:05.27,Default,,0,0,0,,Бұл жай ғана аңыз емес пе?
Dialogue: 0,0:08:05.35,0:08:07.77,Default,,0,0,0,,Мен ертегімен күресіп жатырмын.
Dialogue: 0,0:08:07.86,0:08:10.03,Default,,0,0,0,,Аңыздардан басқа не нәрсеге сүйенуге болады?
Dialogue: 0,0:08:11.82,0:08:15.87,Default,,0,0,0,,Сенің көмегіңмен жеңе алсақ, сенің де абыройың көтеріледі.
Dialogue: 0,0:08:16.37,0:08:19.79,Default,,0,0,0,,Содан кейін оны жындар тобына апаруға болады.
Dialogue: 0,0:08:19.87,0:08:21.62,Default,,0,0,0,,Олай емес...
Dialogue: 0,0:08:21.70,0:08:23.54,Default,,0,0,0,,Сұрағаным есімде жоқ.
Dialogue: 0,0:08:28.88,0:08:32.55,Default,,0,0,0,,Аа... Балалар, шынымен де тітіркендіргіш екенсіңдер.
Dialogue: 0,0:08:34.72,0:08:37.64,Default,,0,0,0,,Ниха Мен байқамай сытылып шығамын.
Dialogue: 0,0:08:38.14,0:08:39.06,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:08:44.14,0:08:46.44,Default,,0,0,0,,Өтірік! Ол қазірдің өзінде анықталды.
Dialogue: 0,0:08:47.94,0:08:49.57,Default,,0,0,0,,Мен бұзып өтемін, Маршалл.
Dialogue: 0,0:09:02.66,0:09:05.87,Default,,0,0,0,,Биік жұлдызды жол, түннің соңы
Dialogue: 0,0:09:05.96,0:09:07.83,Default,,0,0,0,,Ақ Арва сызықты құрайды
Dialogue: 0,0:09:07.92,0:09:12.59,Default,,0,0,0,,Лидс лизинг жарық шамы Аспанға қарасаңыз, ол сонда аяқталады
Dialogue: 0,0:09:13.17,0:09:15.34,Default,,0,0,0,,Сиқырлы сан 68 (алпыс сегіз)
Dialogue: 0,0:09:15.97,0:09:17.43,Default,,0,0,0,,Спанальды түрме!
Dialogue: 0,0:09:23.52,0:09:24.93,Default,,0,0,0,,(айқай)
Dialogue: 0,0:09:30.48,0:09:32.32,Default,,0,0,0,,Жарайсыңдар балалар
Dialogue: 0,0:09:33.03,0:09:36.45,Default,,0,0,0,,2028 шығарылым коды ашылды!
Dialogue: 0,0:09:36.53,0:09:39.45,Default,,0,0,0,,Кел, ашкөз перде!
Dialogue: 0,0:09:41.24,0:09:44.25,Default,,0,0,0,,Бұл жігіт оралған ештеңенің қашып кетуіне жол бермейді.
Dialogue: 0,0:09:44.75,0:09:46.87,Default,,0,0,0,,Теме жарып жібермек болса
Dialogue: 0,0:09:46.96,0:09:50.42,Default,,0,0,0,,Бұл жарылыс сені өлтіреді, Золушка!
Dialogue: 0,0:09:51.54,0:09:53.46,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:09:53.55,0:09:54.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:56.09,0:09:57.26,Default,,0,0,0,,Ол өзін-өзі жойды ма?
Dialogue: 0,0:09:57.76,0:09:58.51,Default,,0,0,0,,Элли!
Dialogue: 0,0:09:59.01,0:09:59.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:01.22,0:10:03.26,Default,,0,0,0,,Екі адам құлап жатыр!
Dialogue: 0,0:10:03.35,0:10:03.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:03.97,0:10:05.22,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:05.31,0:10:06.64,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:10:09.52,0:10:10.73,Default,,0,0,0,,Ноэру-чан, кешіріңіз.
Dialogue: 0,0:10:10.81,0:10:11.40,Default,,0,0,0,,Нина-чан!
Dialogue: 0,0:10:16.65,0:10:18.99,Default,,0,0,0,,Боқ... Мен тірімін.
Dialogue: 0,0:10:19.99,0:10:22.99,Default,,0,0,0,,Теменің жарылысы оны өлтірмейді, солай ма?
Dialogue: 0,0:10:23.99,0:10:25.41,Default,,0,0,0,,Құбыжық бар
Dialogue: 0,0:10:29.75,0:10:32.17,Default,,0,0,0,,Бұл өзін-өзі жоюға ұқсамайды.
Dialogue: 0,0:10:32.25,0:10:34.13,Default,,0,0,0,,Бұл не? Бұл алдау.
Dialogue: 0,0:10:34.21,0:10:37.21,Default,,0,0,0,,Бұл... Жақсысың ба? Ноэру-чан
Dialogue: 0,0:10:37.72,0:10:39.09,Default,,0,0,0,,Бәрі жақсы
Dialogue: 0,0:10:45.64,0:10:46.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:49.98,0:10:50.77,Default,,0,0,0,,Не?
Dialogue: 0,0:10:52.10,0:10:53.61,Default,,0,0,0,,Сіз қайда барасыз?
Dialogue: 0,0:10:55.11,0:10:56.48,Default,,0,0,0,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,0:11:00.36,0:11:02.91,Default,,0,0,0,,Золушка осы жолмен келе жатыр.
Dialogue: 0,0:11:02.99,0:11:03.66,Default,,0,0,0,,Қалқан!
Dialogue: 0,0:11:03.74,0:11:05.41,Default,,0,0,0,,Иә? Уа!
Dialogue: 0,0:11:05.99,0:11:09.46,Default,,0,0,0,,Сен мұнда не үшін келдің? Мен оған ренжідім.
Dialogue: 0,0:11:09.54,0:11:11.42,Default,,0,0,0,,Уау, керемет сиқыр!
Dialogue: 0,0:11:11.50,0:11:12.75,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:13.88,0:11:16.30,Default,,0,0,0,,Мүмкін ол мені көруге келе жатқан шығар.
Dialogue: 0,0:11:16.80,0:11:18.92,Default,,0,0,0,,Өлтіруден басқа амалдар бар ғой...
Dialogue: 0,0:11:19.01,0:11:21.68,Default,,0,0,0,,Мэйси, сен әлі де солай айтасың!
Dialogue: 0,0:11:21.76,0:11:23.55,Default,,0,0,0,,Нинни-чан концентраты!
Dialogue: 0,0:11:23.64,0:11:24.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:24.76,0:11:26.43,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:28.02,0:11:30.27,Default,,0,0,0,,Уф... Нина-чан!
Dialogue: 0,0:11:30.81,0:11:32.44,Default,,0,0,0,,Ашық...
Dialogue: 0,0:11:33.69,0:11:34.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:34.77,0:11:37.07,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:11:39.69,0:11:40.70,Default,,0,0,0,,(Декү) Кешір мені (Каири) Ах…
Dialogue: 0,0:11:41.32,0:11:42.70,Default,,0,0,0,,Тоқта, Элли!
Dialogue: 0,0:11:43.61,0:11:45.45,Default,,0,0,0,,Сіз мені түсінбейсіз бе?
Dialogue: 0,0:11:52.21,0:11:53.21,Default,,0,0,0,,Элли
Dialogue: 0,0:11:58.21,0:11:59.96,Default,,0,0,0,,Ху... (Нинни) артқа тұрыңыз.
Dialogue: 0,0:12:01.55,0:12:02.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:06.72,0:12:08.97,Default,,0,0,0,,Сонда сіз бұл мүмкін емес дейсіз бе?
Dialogue: 0,0:12:10.64,0:12:12.64,Default,,0,0,0,,Мен сені қанша жақсы көрсем де
Dialogue: 0,0:12:13.77,0:12:17.11,Default,,0,0,0,,Не істесең де, қолың жетпеген адамға жете алмайсың.
Dialogue: 0,0:12:17.98,0:12:20.15,Default,,0,0,0,,Сіз мұны қанша уақыттан бері айтып жүрсіз?
Dialogue: 0,0:12:21.44,0:12:23.95,Default,,0,0,0,,Сол қыз маған күш береді
Dialogue: 0,0:12:24.45,0:12:27.41,Default,,0,0,0,,Ол қыз мені ерекше жерге апарады.
Dialogue: 0,0:12:28.37,0:12:30.49,Default,,0,0,0,,Ертегі сияқты сөздерді айтуды тоқтата аласыз ба?
Dialogue: 0,0:12:31.91,0:12:33.16,Default,,0,0,0,,Нина-чан...
Dialogue: 0,0:12:34.00,0:12:35.71,Default,,0,0,0,,Ертегілер боқ, солай ма?
Dialogue: 0,0:12:38.59,0:12:41.21,Default,,0,0,0,,Жарты жолда шешілетін сиқырдың қандай жақсы жағы бар?
Dialogue: 0,0:12:42.09,0:12:44.13,Default,,0,0,0,,Мен ештеңе істей алмаймын, өйткені мен уәдемді бұздым.
Dialogue: 0,0:12:44.93,0:12:47.01,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені уақыт өтті.
Dialogue: 0,0:12:47.51,0:12:48.64,Default,,0,0,0,,Неге көмектесуге болмайды?
Dialogue: 0,0:12:49.22,0:12:50.39,Default,,0,0,0,,Ақымақ сияқты!
Dialogue: 0,0:12:52.68,0:12:57.65,Default,,0,0,0,,Сиқырдың бұзылу себебін сіз де, басқа ешкім де білмейді.
Dialogue: 0,0:12:58.65,0:13:00.69,Default,,0,0,0,,Сиқырды орта жолда бұзуға болады
Dialogue: 0,0:13:02.07,0:13:04.24,Default,,0,0,0,,Бұл менің күшім емес.
Dialogue: 0,0:13:05.65,0:13:09.91,Default,,0,0,0,,Мэйси, сиқырды біз шығардық.
Dialogue: 0,0:13:11.79,0:13:13.95,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:13:15.29,0:13:16.62,Default,,0,0,0,,Келе жатыр, Нинни-чан
Dialogue: 0,0:13:16.71,0:13:19.17,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:13:19.88,0:13:22.25,Default,,0,0,0,,Ноэру-чан, мен не істей аламын?
Dialogue: 0,0:13:22.34,0:13:22.92,Default,,0,0,0,,Маған біртіндеп орал
Dialogue: 0,0:13:23.59,0:13:27.43,Default,,0,0,0,,Маған берген құбырды ұстап, бұрышта қалтырап.
Dialogue: 0,0:13:27.51,0:13:28.93,Default,,0,0,0,,Денесі немесе қақпағы жоқ!
Dialogue: 0,0:13:29.01,0:13:30.22,Default,,0,0,0,,Дий!
Dialogue: 0,0:13:30.30,0:13:31.31,Default,,0,0,0,,Бухаа…
Dialogue: 0,0:13:31.39,0:13:33.47,Default,,0,0,0,,Түсінсем, бірден кетемін.
Dialogue: 0,0:13:33.56,0:13:35.60,Default,,0,0,0,,Осши сені ренжітпесін!
Dialogue: 0,0:13:35.68,0:13:37.06,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:13:37.65,0:13:40.90,Default,,0,0,0,,Бірге тыныш болайық, Осуши-чан.
Dialogue: 0,0:13:46.78,0:13:48.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:51.03,0:13:51.70,Default,,0,0,0,,Уау~
Dialogue: 0,0:13:51.78,0:13:53.33,Default,,0,0,0,,Бұл сызық!
Dialogue: 0,0:13:53.41,0:13:56.08,Default,,0,0,0,,Шынымен, бұл не қылыш?
Dialogue: 0,0:13:56.16,0:13:58.08,Default,,0,0,0,,Маған берген құбырдан шығып жатыр ма?
Dialogue: 0,0:13:58.17,0:13:59.33,Default,,0,0,0,,Қандай логика бойынша?
Dialogue: 0,0:14:01.04,0:14:03.05,Default,,0,0,0,,Мен сені көріп тұрмын, Рикенбэкер!
Dialogue: 0,0:14:06.05,0:14:08.72,Default,,0,0,0,,А? Бұл біртүрлі
Dialogue: 0,0:14:08.80,0:14:10.22,Default,,0,0,0,,Эй, оны қалай шығардың?
Dialogue: 0,0:14:10.30,0:14:11.01,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:14:11.10,0:14:12.47,Default,,0,0,0,,Тыңдап тұрсың ба? Иә...
Dialogue: 0,0:14:15.64,0:14:18.35,Default,,0,0,0,,Золушка қозғалуды тоқтатты...
Dialogue: 0,0:14:36.66,0:14:37.41,Default,,0,0,0,,Аа...
Dialogue: 0,0:14:38.75,0:14:42.42,Default,,0,0,0,,Әй... Қызық, әйтеуір солай болды ма?
Dialogue: 0,0:14:49.51,0:14:54.39,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:14:57.06,0:14:58.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:58.77,0:15:01.31,Default,,0,0,0,,Біздің сыйлығымыз неге нөлге тең?
Dialogue: 0,0:15:02.15,0:15:03.98,Default,,0,0,0,,Бұл нөл емес, солай ма?
Dialogue: 0,0:15:04.48,0:15:06.07,Default,,0,0,0,,Мұқият қараңыз.
Dialogue: 0,0:15:06.65,0:15:08.74,Default,,0,0,0,,5 ұпай және 5 шкала фунты
Dialogue: 0,0:15:08.82,0:15:10.45,Default,,0,0,0,,Бұл нөлге ұқсайды.
Dialogue: 0,0:15:10.53,0:15:15.33,Default,,0,0,0,,Аңызға айналған айдаһарды жеңу Бұл мағынасыз, солай емес пе?
Dialogue: 0,0:15:15.99,0:15:17.83,Default,,0,0,0,,Мүліктік зиянның сомасын шегеру
Dialogue: 0,0:15:17.91,0:15:21.33,Default,,0,0,0,,Бұл теріс емес, сондықтан таңқаларлық емес пе?
Dialogue: 0,0:15:21.92,0:15:24.46,Default,,0,0,0,,Бірінші кезекте соңғы соққыны берген адам болды
Dialogue: 0,0:15:24.54,0:15:27.34,Default,,0,0,0,,Мен сізді директор Бэнгкнайф деп естідім бе?
Dialogue: 0,0:15:27.42,0:15:29.80,Default,,0,0,0,,Иә? Бұл не! Бұл не?
Dialogue: 0,0:15:29.88,0:15:31.84,Default,,0,0,0,,Бұл тіпті ол емес!
Dialogue: 0,0:15:32.43,0:15:36.18,Default,,0,0,0,,«Мо» сіз де емессіз дегенді білдіреді.
Dialogue: 0,0:15:36.68,0:15:39.89,Default,,0,0,0,,Мм... (Бастық) Дұрыс.
Dialogue: 0,0:15:40.39,0:15:43.10,Default,,0,0,0,,Золушканы әзірлеушілер тобы жинап, сақтап қалды (Patchworks)
Dialogue: 0,0:15:43.77,0:15:46.73,Default,,0,0,0,,Онда кіріңіз, кіріңіз.
Dialogue: 0,0:15:47.69,0:15:49.44,Default,,0,0,0,,Ах... (Нинни) Иә?
Dialogue: 0,0:15:51.20,0:15:53.24,Default,,0,0,0,,Мэйси, бұл не?
Dialogue: 0,0:15:54.16,0:15:56.95,Default,,0,0,0,,Біз сені қайтадан қорғаймыз деп жатқан жоқсың ғой, солай ма?
Dialogue: 0,0:15:57.03,0:15:59.62,Default,,0,0,0,,Уау, бұл өткір~ (Нинни) Ия...
Dialogue: 0,0:15:59.70,0:16:00.83,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:16:01.33,0:16:04.88,Default,,0,0,0,,Оның да жеңіл айдаһарға ие болғаны белгілі болды.
Dialogue: 0,0:16:05.38,0:16:08.71,Default,,0,0,0,,Мен оған қамқорлық жасауды шештім~ хехехе
Dialogue: 0,0:16:09.21,0:16:11.05,Default,,0,0,0,,Бұл көңілді болатын сияқты
Dialogue: 0,0:16:11.13,0:16:13.63,Default,,0,0,0,,Мен сіздің пікіріңізді естімедім!
Dialogue: 0,0:16:13.72,0:16:15.97,Default,,0,0,0,,Фуфуфуфуфуфуфу… (Нинни) Уф…
Dialogue: 0,0:16:16.93,0:16:20.27,Default,,0,0,0,,Қызық болатын сияқты, Нина-чан
Dialogue: 0,0:16:20.35,0:16:21.60,Default,,0,0,0,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,0:16:22.60,0:16:24.48,Default,,0,0,0,,Варго мырзамен не болады?
Dialogue: 0,0:16:25.69,0:16:27.77,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:16:28.61,0:16:30.11,Default,,0,0,0,,Барго саябақтары
Dialogue: 0,0:16:30.19,0:16:33.07,Default,,0,0,0,,Зиянды айдаһар белгісін жою туралы өтініш
Dialogue: 0,0:16:33.74,0:16:36.66,Default,,0,0,0,,Мен мұны сізден күткен жоқпын.
Dialogue: 0,0:16:37.53,0:16:40.29,Default,,0,0,0,,Шынында да, зерттеулер бойынша
Dialogue: 0,0:16:41.12,0:16:43.54,Default,,0,0,0,,Балго саябақтары және Мэйси Булгер
Dialogue: 0,0:16:43.62,0:16:46.17,Default,,0,0,0,,2 ай бұрын хабарласқан
Dialogue: 0,0:16:46.75,0:16:52.80,Default,,0,0,0,,Егер бұл Золушканың осы жолы пайда болуына себеп болған болса.
Dialogue: 0,0:16:52.88,0:16:56.59,Default,,0,0,0,,Оны тірі қалдыруға жеткілікті себеп
Dialogue: 0,0:16:57.09,0:17:03.02,Default,,0,0,0,,Ол мархендіктерді бағындыру үшін трафик бола алса.
Dialogue: 0,0:17:06.40,0:17:08.69,Default,,0,0,0,,Есепті оқыдың ба? Золушка
Dialogue: 0,0:17:08.77,0:17:11.65,Default,,0,0,0,,Мен оны оқыдым, әлі де сене алар емеспін
Dialogue: 0,0:17:12.15,0:17:13.07,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:17:13.99,0:17:16.61,Default,,0,0,0,,Қайырлы таң, директор Сквайр!
Dialogue: 0,0:17:17.53,0:17:18.70,Default,,0,0,0,,Менің бір сұрағым бар.
Dialogue: 0,0:17:19.83,0:17:21.91,Default,,0,0,0,,Бұл жер қашан қоймаға айналды?
Dialogue: 0,0:17:22.41,0:17:25.00,Default,,0,0,0,,Ах! кешіріңіз
Dialogue: 0,0:17:25.08,0:17:26.08,Default,,0,0,0,,Дереу тазалаңыз
Dialogue: 0,0:17:26.17,0:17:28.08,Default,,0,0,0,,Әй, тезірек (А қызметкері) Ах.
Dialogue: 0,0:17:29.88,0:17:30.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:42.01,0:17:43.10,Default,,0,0,0,,Кіші Мен...
Dialogue: 0,0:17:43.97,0:17:46.73,Default,,0,0,0,,Мен олар тым көп сатып алмаған сияқты болдым.
Dialogue: 0,0:17:47.64,0:17:49.31,Default,,0,0,0,,Батырдың баласы
Dialogue: 0,0:17:50.94,0:17:53.61,Default,,0,0,0,,Хмм, Осуши-чан!
Dialogue: 0,0:17:54.32,0:17:56.61,Default,,0,0,0,,Бүгін де сүйкімді көрінесің!
Dialogue: 0,0:17:56.70,0:17:59.53,Default,,0,0,0,,Сүйкімді болу арқылы үй салуға болады~
Dialogue: 0,0:18:00.03,0:18:02.66,Default,,0,0,0,,А, қош келдіңіз, Ноэру-чан
Dialogue: 0,0:18:03.16,0:18:07.62,Default,,0,0,0,,Бастық дәл қазір келіп, менің плащым мен сыбызғымды алды.
Dialogue: 0,0:18:08.25,0:18:11.42,Default,,0,0,0,,Мен мұны түсінбейсің бе деп қорқамын.
Dialogue: 0,0:18:11.50,0:18:12.00,Default,,0,0,0,,Куун
Dialogue: 0,0:18:13.13,0:18:13.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:14.67,0:18:17.13,Default,,0,0,0,,Ноэру-чан? Эх...
Dialogue: 0,0:18:24.81,0:18:27.56,Default,,0,0,0,,... бірдеңе болды ма?
Dialogue: 0,0:18:28.89,0:18:29.73,Default,,0,0,0,,Маған біртіндеп орал
Dialogue: 0,0:18:30.85,0:18:33.94,Default,,0,0,0,,Сонымен, жақсы нәрсе болды ма?
Dialogue: 0,0:18:35.32,0:18:36.11,Default,,0,0,0,,Иә
Dialogue: 0,0:18:37.28,0:18:38.24,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:38.74,0:18:41.49,Default,,0,0,0,,Саған жақсы, Ноэру-чан
Dialogue: 0,0:18:44.91,0:18:47.54,Default,,0,0,0,,Шалбар Miseteee~
Dialogue: 0,0:18:49.87,0:18:50.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:51.58,0:18:53.54,Default,,0,0,0,,Ноэль Чан
Dialogue: 0,0:18:54.55,0:18:57.42,Default,,0,0,0,,Шалбар Misete~
Dialogue: 0,0:18:58.30,0:19:00.68,Default,,0,0,0,,Жарайды, жарайды!
Dialogue: 0,0:19:01.18,0:19:02.51,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:03.80,0:19:06.56,Default,,0,0,0,,Ол ақырында түзетілді.
Dialogue: 0,0:19:11.52,0:19:12.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:15.44,0:19:17.32,Default,,0,0,0,,Ха ха ха... (Нинни) Иә?
Dialogue: 0,0:19:18.94,0:19:20.15,Default,,0,0,0,,Күте тұрыңыз, Варго мырза.
Dialogue: 0,0:19:20.24,0:19:21.20,Default,,0,0,0,,Балго!
Dialogue: 0,0:19:21.28,0:19:22.95,Default,,0,0,0,,Осуши-чан
Dialogue: 0,0:19:23.57,0:19:24.83,Default,,0,0,0,,Тыныштық
Dialogue: 0,0:19:27.87,0:19:29.87,Default,,0,0,0,,♪～
Dialogue: 0,0:20:39.57,0:20:41.57,Default,,0,0,0,,～♪
