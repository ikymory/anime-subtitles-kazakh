Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:07.50,0:01:09.59,Dialogue,,0,0,0,,Мен сандарға сенемін!
Dialogue: 0,0:01:07.77,0:01:09.39,*Default-ja,NTP,0,0,0,,Мен сандарға сенемін!
Dialogue: 0,0:01:10.09,0:01:11.24,*Default-ja,NTP,0,0,0,,Міне!
Dialogue: 0,0:01:10.09,0:01:11.33,Dialogue,,0,0,0,,Түсіндік!
Dialogue: 0,0:01:11.33,0:01:13.02,Dialogue,,0,0,0,,Бұл долларлар ма?!
Dialogue: 0,0:01:11.53,0:01:13.03,*Default-ja,NTP,0,0,0,,Бұл... Доллар ма?
Dialogue: 0,0:01:13.02,0:01:14.00,Dialogue,,0,0,0,,Бұл не болып жатыр өзі?!
Dialogue: 0,0:01:13.29,0:01:16.09,*Default-ja,NTP,0,0,0,,Бұл не? Осы жігіттердің бәрі?
Dialogue: 0,0:01:14.00,0:01:15.79,Dialogue,,0,0,0,,Олардың бәрі болуы мүмкін емес...
Dialogue: 0,0:01:15.79,0:01:18.09,Dialogue,,0,0,0,,Мысалы, сен маған тұрмысқа шыға аласың.
Dialogue: 0,0:01:16.31,0:01:18.35,*Default-ja,NTP,0,0,0,,Мысалы, жай ғана маған үйлен.
Dialogue: 0,0:01:18.09,0:01:21.88,Dialogue,,0,0,0,,Сіз біздің «сол туралы» құпияны сақтайсыз ба?
Dialogue: 0,0:01:18.67,0:01:22.09,*Default-ja,NTP,0,0,0,,Ол да бұл құпияны сақтауда.
Dialogue: 0,0:01:21.88,0:01:22.96,Dialogue,,0,0,0,,Селти...
Dialogue: 0,0:01:22.26,0:01:23.10,*Default-ja,NTP,0,0,0,,Келти
Dialogue: 0,0:01:22.96,0:01:25.59,Dialogue,,0,0,0,,Бұл мен ойлағаннан әлдеқайда қызықты.
Dialogue: 0,0:01:23.41,0:01:25.49,*Default-ja,NTP,0,0,0,,Бұл мен күткеннен де қызық болды.
Dialogue: 0,0:01:25.59,0:01:28.90,Dialogue,,0,0,0,,«Мен дәл осы жерде және қазір тудым!» деп айқайлап жатырмын.
Dialogue: 0,0:01:25.74,0:01:28.93,*Default-ja,NTP,0,0,0,,Айқайлап тұр! Мен қазір осында тудым!
Dialogue: 0,0:01:29.81,0:01:32.52,Dialogue,,0,0,0,,Селти маған қайтарыңыз!
Dialogue: 0,0:01:30.14,0:01:32.76,*Default-ja,NTP,0,0,0,,Маған Селтиді қайтарып беріңізші~?
Dialogue: 0,0:02:05.35,0:02:07.85,Dialogue,,0,0,0,,Мен сізге алғыс айтуым керек деп ойлаймын.
Dialogue: 0,0:02:05.94,0:02:07.78,*Default-ja,NTP,0,0,0,,Мен сізге алғыс айтуым керек.
Dialogue: 0,0:02:07.85,0:02:13.36,Dialogue,,0,0,0,,Егер сен болмасаң, әпкем оны тағы да анау тар зерттеу мекемесіне қамап тастар еді.
Dialogue: 0,0:02:08.13,0:02:09.14,*Default-ja,NTP,0,0,0,,Сенсіз
Dialogue: 0,0:02:09.45,0:02:13.63,*Default-ja,NTP,0,0,0,,Әпкесі оны тағы да шағын зертханаға қамап тастар еді.
Dialogue: 0,0:02:13.88,0:02:14.73,Dialogue,,0,0,0,,Ягири...
Dialogue: 0,0:02:14.12,0:02:15.03,*Default-ja,NTP,0,0,0,,Ягири-кун...
Dialogue: 0,0:02:17.18,0:02:18.15,Dialogue,,0,0,0,,Сен сияқты жеңілген адамға ешкім мән бермейді.
Dialogue: 0,0:02:17.65,0:02:18.49,*Default-ja,NTP,0,0,0,,Амансың ба!?
Dialogue: 0,0:02:18.48,0:02:20.55,Dialogue,,0,0,0,,Қалай болғанда да, Селти маған қайтарып бер.
Dialogue: 0,0:02:18.79,0:02:20.36,*Default-ja,NTP,0,0,0,,Әйтеуір, маған Селтиді қайтар.
Dialogue: 0,0:02:20.55,0:02:23.84,Dialogue,,0,0,0,,Полиция келгенше мен онымен бірге қашуым керек.
Dialogue: 0,0:02:20.74,0:02:23.47,*Default-ja,NTP,0,0,0,,Полицейлер келгенше қызыммен қашуым керек.
Dialogue: 0,0:02:23.84,0:02:25.41,Dialogue,,0,0,0,,Сондықтан сіз...
Dialogue: 0,0:02:24.25,0:02:25.80,*Default-ja,NTP,0,0,0,,Сондықтан...
Dialogue: 0,0:02:25.84,0:02:31.49,Dialogue,,0,0,0,,Мен оны бала кезімнен бақылап келемін.
Dialogue: 0,0:02:25.96,0:02:27.28,*Default-ja,NTP,0,0,0,,Сен не білесің?
Dialogue: 0,0:02:27.66,0:02:30.92,*Default-ja,NTP,0,0,0,,Мен оған бала кезімнен бері қараймын.
Dialogue: 0,0:02:31.49,0:02:33.24,Dialogue,,0,0,0,,Мен оны босатқым келді...
Dialogue: 0,0:02:31.77,0:02:33.17,*Default-ja,NTP,0,0,0,,Мен сені босатқым келді.
Dialogue: 0,0:02:33.24,0:02:35.41,Dialogue,,0,0,0,,Оның кең әлемде еркін жүруіне мүмкіндік беру үшін...
Dialogue: 0,0:02:33.46,0:02:35.37,*Default-ja,NTP,0,0,0,,Кең дүние сені азат етсін
Dialogue: 0,0:02:35.41,0:02:38.20,Dialogue,,0,0,0,,Мен онымен сонда тұрар едім.
Dialogue: 0,0:02:35.91,0:02:37.89,*Default-ja,NTP,0,0,0,,Мен де сол жерде тұрамын.
Dialogue: 0,0:02:38.20,0:02:43.58,Dialogue,,0,0,0,,Мен әрқашан, әрқашан, әрқашан, әрқашан, әрқашан, әрқашан осы ойлардан басқа ештеңе ойламағанмын.
Dialogue: 0,0:02:38.53,0:02:43.30,*Default-ja,NTP,0,0,0,,Міне, мен әрқашан, әрқашан, әрқашан... әрқашан ойлайтынмын.
Dialogue: 0,0:02:44.26,0:02:48.77,Dialogue,,0,0,0,,Махаббат күшін тоқтата алмайсың, білесің.
Dialogue: 0,0:02:44.73,0:02:48.66,*Default-ja,NTP,0,0,0,,Жоқ, махаббаттың күшін ешкім тоқтата алмайды, солай ма?
Dialogue: 0,0:02:48.77,0:02:51.35,Dialogue,,0,0,0,,Бұған қарама-қарсы, сен кімсің?
Dialogue: 0,0:02:49.01,0:02:51.10,*Default-ja,NTP,0,0,0,,айырбас, сен кімсің?
Dialogue: 0,0:02:51.35,0:02:54.98,Dialogue,,0,0,0,,Сен сол кезде де, қазір де сандық күшке ғана сендің.
Dialogue: 0,0:02:51.61,0:02:54.33,*Default-ja,NTP,0,0,0,,Дәл қазір және тек сандарға сүйену...
Dialogue: 0,0:02:56.69,0:02:59.31,Dialogue,,0,0,0,,Менің махаббатым оңайлықпен ыдырап кетпейді!
Dialogue: 0,0:02:57.29,0:02:59.35,*Default-ja,NTP,0,0,0,,Менің махаббатым бұл деңгейде бұзылмайды
Dialogue: 0,0:03:02.24,0:03:03.37,Dialogue,,0,0,0,,Бұл жұмыс істемейді!
Dialogue: 0,0:03:02.73,0:03:03.48,*Default-ja,NTP,0,0,0,,Бұл жұмыс істемейді!
Dialogue: 0,0:03:03.37,0:03:05.26,Dialogue,,0,0,0,,Мен ауырып тұрмын, бірақ мен оны ұмытамын!
Dialogue: 0,0:03:03.67,0:03:04.96,*Default-ja,NTP,0,0,0,,Ауырды, бірақ мен оны ұмытамын!
Dialogue: 0,0:03:05.26,0:03:07.82,Dialogue,,0,0,0,,Селтимен бірге өтетін өмірде азаптың қажеті жоқ!
Dialogue: 0,0:03:05.50,0:03:07.84,*Default-ja,NTP,0,0,0,,Ауырсыну маған және Селтидің өміріне қажет емес!
Dialogue: 0,0:03:07.82,0:03:11.10,Dialogue,,0,0,0,,Сондықтан мен сенің қиналып жатқаныңды сезбеймін!
Dialogue: 0,0:03:08.10,0:03:11.25,*Default-ja,NTP,0,0,0,,Сондықтан мен осында және қазір алған ауырсынудан ешқандай ауыртпалық сезінбеймін!
Dialogue: 0,0:03:11.10,0:03:12.12,Dialogue,,0,0,0,,Бұл күлкілі!
Dialogue: 0,0:03:11.54,0:03:12.34,*Default-ja,NTP,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:03:21.09,0:03:22.86,Dialogue,,0,0,0,,Бұл жалғыздықты тек шыңға шыққандар ғана түсіне алады
Dialogue: 0,0:03:21.42,0:03:23.13,*Default-ja,NTP,0,0,0,,Тоқтатасың ба?
Dialogue: 0,0:03:26.25,0:03:27.52,Dialogue,,0,0,0,,Өтінемін, тоқтаңыз!
Dialogue: 0,0:03:26.55,0:03:27.55,*Default-ja,NTP,0,0,0,,Тоқта!
Dialogue: 0,0:03:27.52,0:03:32.64,Dialogue,,0,0,0,,Сейджи қатал, қатыгез және көпшіліктен ерекше, бірақ ол жаман адам емес!
Dialogue: 0,0:03:27.76,0:03:31.26,*Default-ja,NTP,0,0,0,,Сэйджи-сан қатал, қатыгез және басқа адамдардан ерекше.
Dialogue: 0,0:03:31.58,0:03:32.77,*Default-ja,NTP,0,0,0,,Мен жаман адам емеспін!
Dialogue: 0,0:03:32.93,0:03:36.65,Dialogue,,0,0,0,,Оның жақсы көретін адамы бар!
Dialogue: 0,0:03:33.24,0:03:34.29,*Default-ja,NTP,0,0,0,,Бірақ содан кейін...
Dialogue: 0,0:03:34.48,0:03:35.66,*Default-ja,NTP,0,0,0,,Бұл адам әлдеқашан біреуді ұнатады...
Dialogue: 0,0:03:35.03,0:03:36.65,Secondary Thought,,0,0,0,,Бұл ол емес.
Dialogue: 0,0:03:35.80,0:03:36.38,*Default-ja,NTP,0,0,0,,Жоқ
Dialogue: 0,0:03:36.65,0:03:38.25,Thought,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,0:03:37.20,0:03:40.07,*Default-ja,NTP,0,0,0,,Жоқ... мүмкін емес...
Dialogue: 0,0:03:37.67,0:03:38.25,Secondary,,0,0,0,,Шекара сызықтары?
Dialogue: 0,0:03:38.25,0:03:39.65,Thought,,0,0,0,,Бұл мүмкін емес! Бұл мүмкін емес еді! Бұл мүмкін емес еді!
Dialogue: 0,0:03:39.65,0:03:41.65,Thought,,0,0,0,,Бұл ол емес. Сол қыз...
Dialogue: 0,0:03:40.35,0:03:41.87,*Default-ja,NTP,0,0,0,,Жоқ, бұл бала...
Dialogue: 0,0:03:43.74,0:03:45.74,Thought,,0,0,0,,Бұл... менің басым емес.
Dialogue: 0,0:03:43.75,0:03:46.25,*Default-ja,NTP,0,0,0,,Бұл... менің мойным емес.
Dialogue: 0,0:03:46.23,0:03:47.56,Thought,,0,0,0,,Сол қыз...
Dialogue: 0,0:03:46.47,0:03:49.03,*Default-ja,NTP,0,0,0,,Бұл бала... Бұл баланың аты...
Dialogue: 0,0:03:47.56,0:03:48.97,Thought,,0,0,0,,Оның аты...
Dialogue: 0,0:03:49.87,0:03:51.50,Dialogue,,0,0,0,,Харима...Мика?
Dialogue: 0,0:03:50.30,0:03:54.26,*Default-ja,NTP,0,0,0,,Мика Харима? Солай емес пе?
Dialogue: 0,0:03:52.87,0:03:54.29,Dialogue,,0,0,0,,Мен дұрыс айтамын, солай емес пе?
Dialogue: 0,0:03:54.29,0:03:59.00,Dialogue,,0,0,0,,Сіз Харима Микасыз, Сейджи өлтірді деген қыз, солай ма?
Dialogue: 0,0:03:54.60,0:03:58.88,*Default-ja,NTP,0,0,0,,Сіз Ягири-кун өлтіруі тиіс Мика Харимасыз ба?
Dialogue: 0,0:04:00.79,0:04:02.25,Dialogue,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:04:01.17,0:04:02.10,*Default-ja,NTP,0,0,0,,Авдол мен басқалар… келе жатыр…
Dialogue: 0,0:04:03.53,0:04:04.36,Dialogue,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:04:03.99,0:04:06.65,*Default-ja,NTP,0,0,0,,Сәлем? Бұл өтірік емес пе?
Dialogue: 0,0:04:05.48,0:04:06.42,Dialogue,,0,0,0,,Ол өтірік айтады, солай ма?
Dialogue: 0,0:04:07.71,0:04:08.83,Dialogue,,0,0,0,,Неге?!
Dialogue: 0,0:04:08.01,0:04:09.01,*Default-ja,NTP,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:04:09.26,0:04:11.89,Dialogue,,0,0,0,,Эй, сен барсың ғой, Сейджи?
Dialogue: 0,0:04:09.70,0:04:11.83,*Default-ja,NTP,0,0,0,,Эй, эй, эй, сен барсың ғой, солай ма? Сейджи мырза!
Dialogue: 0,0:04:11.89,0:04:12.84,Dialogue,,0,0,0,,Мен тағы да келдім!
Dialogue: 0,0:04:12.09,0:04:13.19,*Default-ja,NTP,0,0,0,,Ол да бүгін келді!
Dialogue: 0,0:04:13.44,0:04:16.16,Dialogue,,0,0,0,,Әй, сен есікті тағы да ашық қалдыруды ұмытып кетіпсің.
Dialogue: 0,0:04:13.71,0:04:16.05,*Default-ja,NTP,0,0,0,,Қатты! Мен оны ашуды ұмытып кетіппін!
Dialogue: 0,0:04:16.16,0:04:17.93,Dialogue,,0,0,0,,Сен мұны істесең мен кіре алмаймын.
Dialogue: 0,0:04:16.39,0:04:17.88,*Default-ja,NTP,0,0,0,,Бұл мені кіргізбейді!
Dialogue: 0,0:04:17.93,0:04:19.85,Dialogue,,0,0,0,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,0:04:18.08,0:04:19.60,*Default-ja,NTP,0,0,0,,Сіз ұйықтап жатқан шығарсыз?
Dialogue: 0,0:04:20.48,0:04:21.86,Dialogue,,0,0,0,,Есіңде ме?
Dialogue: 0,0:04:20.99,0:04:22.15,*Default-ja,NTP,0,0,0,,Есіңде ме?
Dialogue: 0,0:04:21.86,0:04:25.67,Dialogue,,0,0,0,,Сейджи, қабылдау емтихандары кезінде мен сенің қасыңа отырдым.
Dialogue: 0,0:04:22.46,0:04:26.04,*Default-ja,NTP,0,0,0,,Емтихан кезінде Сейджи мырзаның қасында отырдым.
Dialogue: 0,0:04:26.51,0:04:30.21,Dialogue,,0,0,0,,Менің оң жағымдағы адамның есімі «Рюгамин Микадо...» болғандықтан
Dialogue: 0,0:04:26.82,0:04:30.22,*Default-ja,NTP,0,0,0,,Оң жақта отырған қыздың тегі Рюгамин сияқты таңғажайып еді.
Dialogue: 0,0:04:30.21,0:04:33.37,Dialogue,,0,0,0,,Мен сол жақтағы адамның есімі қандай екен деп ойладым...
Dialogue: 0,0:04:30.50,0:04:33.40,*Default-ja,NTP,0,0,0,,Мен сол жағымдағы адамның аты кім деп ойладым.
Dialogue: 0,0:04:33.37,0:04:35.71,Dialogue,,0,0,0,,Ал мен жалт қарасам, бір көргеннен ғашық болдым.
Dialogue: 0,0:04:33.73,0:04:35.50,*Default-ja,NTP,0,0,0,,Жалт қарасам, бір көргеннен махаббат екен.
Dialogue: 0,0:04:35.71,0:04:37.52,Dialogue,,0,0,0,,Көзіміз түйіскен кезде тіпті күліп жібердің, Сейджи.
Dialogue: 0,0:04:36.08,0:04:38.12,*Default-ja,NTP,0,0,0,,Менің көзіме түскен Сейджи-сан да күлді...
Dialogue: 0,0:04:40.59,0:04:43.40,Dialogue,,0,0,0,,Олай болса, өзіңді көрсетші, Сейджи!
Dialogue: 0,0:04:41.18,0:04:43.37,*Default-ja,NTP,0,0,0,,Сонымен Сейджи-сан, маған бетіңді көрсетші.
Dialogue: 0,0:04:43.40,0:04:45.04,Dialogue,,0,0,0,,Керемет пе?
Dialogue: 0,0:04:43.61,0:04:45.05,*Default-ja,NTP,0,0,0,,Өтінемін, өтінемін
Dialogue: 0,0:04:45.04,0:04:47.07,Dialogue,,0,0,0,,Мүмкін өзіңізді жақсы сезінбей жатқан шығарсыз?
Dialogue: 0,0:04:45.35,0:04:46.96,*Default-ja,NTP,0,0,0,,Сіз өзіңізді жақсы сезінбей жүрсіз бе?
Dialogue: 0,0:04:47.07,0:04:48.49,Dialogue,,0,0,0,,Есікті неге ашпай жүрсің?
Dialogue: 0,0:04:47.21,0:04:48.45,*Default-ja,NTP,0,0,0,,Сол себепті кете алмайсың ба?
Dialogue: 0,0:04:48.49,0:04:50.97,Dialogue,,0,0,0,,Олай болса мен оны саған ашамын. Сәл күте тұрыңыз.
Dialogue: 0,0:04:48.70,0:04:51.41,*Default-ja,NTP,0,0,0,,Ондай жағдайда мен оны сізге ашамын. Күте тұрыңыз!
Dialogue: 0,0:04:51.36,0:04:52.86,Dialogue,,0,0,0,,Мен дәл сол жерде боламын.
Dialogue: 0,0:04:51.71,0:04:52.54,*Default-ja,NTP,0,0,0,,Енді...
Dialogue: 0,0:04:54.80,0:04:58.11,Dialogue,,0,0,0,,Мен сол күннен кейін біраз нәрселерді қарастырдым.
Dialogue: 0,0:04:55.17,0:04:58.29,*Default-ja,NTP,0,0,0,,Мен, емтихан тапсырған күннен бастап көп іздендім.
Dialogue: 0,0:04:58.11,0:05:01.48,Dialogue,,0,0,0,,Туған күніңізді және отбасыңыз туралы ақпаратты...
Dialogue: 0,0:04:58.58,0:05:00.58,*Default-ja,NTP,0,0,0,,Сейджидің туған күні және отбасы...
Dialogue: 0,0:05:12.15,0:05:14.33,Dialogue,,0,0,0,,Се-Сэйджи...
Dialogue: 0,0:05:12.76,0:05:14.58,*Default-ja,NTP,0,0,0,,Seiji-san?
Dialogue: 0,0:05:15.48,0:05:16.33,Dialogue,,0,0,0,,Сонымен, сіз оны көрдіңіз.
Dialogue: 0,0:05:15.92,0:05:16.55,*Default-ja,NTP,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:05:16.33,0:05:18.77,Dialogue,,0,0,0,,Им, қате, мен, жақсы...
Dialogue: 0,0:05:16.70,0:05:18.64,*Default-ja,NTP,0,0,0,,Um... I...
Dialogue: 0,0:05:18.77,0:05:21.11,Dialogue,,0,0,0,,Уф, мен ешкімге айтпаймын!
Dialogue: 0,0:05:18.97,0:05:20.77,*Default-ja,NTP,0,0,0,,Жарайды... Ешкімге айтпаймын.
Dialogue: 0,0:05:21.11,0:05:23.62,Dialogue,,0,0,0,,Умм, ммм, жарайды!
Dialogue: 0,0:05:22.52,0:05:26.36,*Default-ja,NTP,0,0,0,,Ум, м... жарайды! Сіздің хоббиіңіз қандай болса да, мен оны сізге сәйкестендіремін.
Dialogue: 0,0:05:23.62,0:05:26.33,Dialogue,,0,0,0,,Қандай хоббиіңіз болса да, мен сізге ұнайтын нәрсені ұнататын боламын!
Dialogue: 0,0:05:26.33,0:05:28.31,Dialogue,,0,0,0,,Мм, солай етпеңіз...
Dialogue: 0,0:05:26.66,0:05:28.44,*Default-ja,NTP,0,0,0,,Well... So...
Dialogue: 0,0:05:28.31,0:05:29.09,Dialogue,,0,0,0,,Жарайды.
Dialogue: 0,0:05:28.67,0:05:29.45,*Default-ja,NTP,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:05:29.09,0:05:31.43,Dialogue,,0,0,0,,Сейджи...
Dialogue: 0,0:05:29.64,0:05:30.64,*Default-ja,NTP,0,0,0,,Mr. Seiji
Dialogue: 0,0:05:31.88,0:05:32.89,Dialogue,,0,0,0,,Жарайды.
Dialogue: 0,0:05:32.22,0:05:33.20,*Default-ja,NTP,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:05:33.33,0:05:35.60,Dialogue,,0,0,0,,Сейджи...?
Dialogue: 0,0:05:33.66,0:05:35.75,*Default-ja,NTP,0,0,0,,Сейджи мырза?
Dialogue: 0,0:05:35.60,0:05:37.14,Dialogue,,0,0,0,,Жарайды.
Dialogue: 0,0:05:36.02,0:05:36.85,*Default-ja,NTP,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:05:40.04,0:05:41.45,Dialogue,,0,0,0,,Неге?!
Dialogue: 0,0:05:40.49,0:05:43.61,*Default-ja,NTP,0,0,0,,Кешіріңіз! I wasn't dead yet!
Dialogue: 0,0:05:41.45,0:05:43.73,Dialogue,,0,0,0,,Мен шынымен өлген жоқпын!
Dialogue: 0,0:05:43.73,0:05:46.53,Dialogue,,0,0,0,,Олай болса, әпкең...
Dialogue: 0,0:05:44.03,0:05:46.19,*Default-ja,NTP,0,0,0,,Сосын Сейджидің үлкен әпкесі...
Dialogue: 0,0:05:46.97,0:05:49.28,Dialogue,,0,0,0,,Сейджи сізді ұнатқанын қалайсыз ба?
Dialogue: 0,0:05:47.28,0:05:49.59,*Default-ja,NTP,0,0,0,,Сейджи сізге ғашық болғанын қалайсыз ба?
Dialogue: 0,0:05:50.91,0:05:52.16,Dialogue,,0,0,0,,Қандай жақсы қыз.
Dialogue: 0,0:05:51.55,0:05:52.70,*Default-ja,NTP,0,0,0,,Жақсы қыз.
Dialogue: 0,0:05:52.16,0:05:55.30,Dialogue,,0,0,0,,Ал... және ол жерде дәрігер де болды.
Dialogue: 0,0:05:52.84,0:05:55.29,*Default-ja,NTP,0,0,0,,Сосын... сосын дәрігер келді.
Dialogue: 0,0:05:55.30,0:06:01.17,Dialogue,,0,0,0,,Ол аздап косметикалық ота жасап, боянып: «Мен дәл осы бас сияқты боламын - сен ғашық болған бас!
Dialogue: 0,0:05:55.68,0:05:57.46,*Default-ja,NTP,0,0,0,,Кішкене пластикалық операция және макияж
Dialogue: 0,0:05:57.78,0:06:01.30,*Default-ja,NTP,0,0,0,,Анау мойын... дәл Сейджидің сүйікті мойнына ұқсайды.
Dialogue: 0,0:06:01.45,0:06:05.67,Dialogue,,0,0,0,,Ол: «Сен қазір Селтисің, өйткені оның аты солай», - деді.
Dialogue: 0,0:06:01.73,0:06:05.52,*Default-ja,NTP,0,0,0,,Сенің атың Селти, себебі бұл сенің мойныңдағы есім.
Dialogue: 0,0:06:05.95,0:06:09.18,Dialogue,,0,0,0,,Сондықтан мен сен үшін Селти сияқты болуға тырыстым!
Dialogue: 0,0:06:06.27,0:06:09.04,*Default-ja,NTP,0,0,0,,Сондықтан мен Сейджи-сан үшін Селти болуға тырыстым...
Dialogue: 0,0:06:09.18,0:06:11.80,Dialogue,,0,0,0,,Бірақ Нами мұның жеткіліксіз екенін айтты.
Dialogue: 0,0:06:09.60,0:06:11.74,*Default-ja,NTP,0,0,0,,Бірақ Нами мырза мұның тым жайбарақат екенін айтады.
Dialogue: 0,0:06:11.80,0:06:16.77,Dialogue,,0,0,0,,Ол сіз мұны анықтайсыз, сондықтан олар менің жадым жоғалту үшін операция мен дәрі-дәрмек қолданатынын айтты.
Dialogue: 0,0:06:12.04,0:06:13.31,*Default-ja,NTP,0,0,0,,Мен болсам, бірден білемін.
Dialogue: 0,0:06:13.49,0:06:16.66,*Default-ja,NTP,0,0,0,,Ол операция немесе дәрі-дәрмек менің эмоцияларымды және естеліктерімді өшіретінін айтты.
Dialogue: 0,0:06:16.77,0:06:23.19,Dialogue,,0,0,0,,Бірақ мен естеліктерімді жоғалтқым келмеді!
Dialogue: 0,0:06:16.93,0:06:19.65,Secondary Thought,,0,0,0,,Менің атымды білетін адам.
Dialogue: 0,0:06:17.34,0:06:22.82,*Default-ja,NTP,0,0,0,,Менің атымды білетін адам... Дуллахан екенімді білетін дәрігер...
Dialogue: 0,0:06:20.02,0:06:23.19,Secondary Thought,,0,0,0,,Дуллахан екенімді білген дәрігер.
Dialogue: 0,0:06:23.59,0:06:27.94,Thought,,0,0,0,,Бұл қалада мұндай адам бір ғана!
Dialogue: 0,0:06:23.99,0:06:27.36,*Default-ja,NTP,0,0,0,,Бұл қалада мұндай адам бір ғана.
Dialogue: 0,0:06:27.94,0:06:29.94,Dialogue,,0,0,0,,Мен жай ғана сенімен болғым келді!
Dialogue: 0,0:06:28.43,0:06:29.79,*Default-ja,NTP,0,0,0,,Себебі мен Сейджи-санмен бірге болғым келді!
Dialogue: 0,0:06:29.94,0:06:31.20,Dialogue,,0,0,0,,Сондықтан мен мұның барлығынан өттім!
Dialogue: 0,0:06:29.97,0:06:31.26,*Default-ja,NTP,0,0,0,,Сондықтан мен бар күшімді салдым!
Dialogue: 0,0:06:36.45,0:06:39.07,Dialogue,,0,0,0,,Бұл өтірік болуы керек.
Dialogue: 0,0:06:37.26,0:06:39.04,*Default-ja,NTP,0,0,0,,Бұл өтірік... Бұл...
Dialogue: 0,0:06:39.07,0:06:40.51,Dialogue,,0,0,0,,Сонда мен...
Dialogue: 0,0:06:39.44,0:06:40.43,*Default-ja,NTP,0,0,0,,Сонда мен...
Dialogue: 0,0:06:40.51,0:06:45.01,Dialogue,,0,0,0,,Демек, алаяқты шынайы заттан ажырата алмадың.
Dialogue: 0,0:06:40.79,0:06:44.69,*Default-ja,NTP,0,0,0,,Жарайды, шын мен жалғанның арасын да ажырата алмадың.
Dialogue: 0,0:06:45.01,0:06:47.70,Dialogue,,0,0,0,,Бұл сіздің махаббатыңыздың барлығын құрағанын білдірсе керек.
Dialogue: 0,0:06:45.33,0:06:47.83,*Default-ja,NTP,0,0,0,,Бұл сіздің махаббатыңыздың ауқымы.
Dialogue: 0,0:06:47.70,0:06:49.67,Dialogue,,0,0,0,,Жақсы жұмыс.
Dialogue: 0,0:06:48.24,0:06:49.32,*Default-ja,NTP,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:06:51.55,0:06:52.93,Dialogue,,0,0,0,,Сейджи!
Dialogue: 0,0:06:51.64,0:06:52.57,*Default-ja,NTP,0,0,0,,Сэйдзи-сан!
Dialogue: 0,0:06:53.70,0:06:59.31,Dialogue,,0,0,0,,Мм, оны қайтарып алу үшін өз өміріңді қатерге тігіп жүргенің ғажап деп ойлаймын.
Dialogue: 0,0:06:54.12,0:06:58.75,*Default-ja,NTP,0,0,0,,Жарайды...Оны қайтару үшін өз өміріңді қатерге тігіп алғаның ғажап деп ойлаймын.
Dialogue: 0,0:06:59.31,0:07:02.59,Dialogue,,0,0,0,,Мен сені дұрыс түсінбедім, Харима.
Dialogue: 0,0:06:59.60,0:07:02.29,*Default-ja,NTP,0,0,0,,Мен Харима мырзаны дұрыс түсінбедім.
Dialogue: 0,0:07:02.59,0:07:07.14,Dialogue,,0,0,0,,Сізде, әрине, кейбір тұлғалық проблемалар бар, бірақ сіз аңдыушы емессіз.
Dialogue: 0,0:07:02.85,0:07:05.16,*Default-ja,NTP,0,0,0,,Оның тұлғалық проблемалары бар.
Dialogue: 0,0:07:05.80,0:07:07.60,*Default-ja,NTP,0,0,0,,Мен аңдыушы емеспін.
Dialogue: 0,0:07:07.79,0:07:14.52,Dialogue,,0,0,0,,Менің айтайын дегенім, сен ол үшін өз өміріңді қиясың, бұл өзімшілдікпен жасай алмайтын шығарсың.
Dialogue: 0,0:07:08.08,0:07:11.12,*Default-ja,NTP,0,0,0,,Өйткені сен Ягири-кун үшін өміріңді қатерге тіктің.
Dialogue: 0,0:07:11.38,0:07:14.94,*Default-ja,NTP,0,0,0,,Бұл сіздің өзімшілдік қалауларыңызбен жасай алмайтын нәрсе емес пе?
Dialogue: 0,0:07:15.45,0:07:18.85,Dialogue,,0,0,0,,Сізді өлтіре жаздаған жігітті әлі де жақсы көруіңіз керемет.
Dialogue: 0,0:07:15.74,0:07:18.75,*Default-ja,NTP,0,0,0,,Сізді өлтіре жаздаған адамды әлі де жақсы көруіңіз ғажап деп ойлаймын.
Dialogue: 0,0:07:18.85,0:07:20.42,Dialogue,,0,0,0,,Әртүрлі тәсілдермен.
Dialogue: 0,0:07:19.09,0:07:20.03,*Default-ja,NTP,0,0,0,,Көптеген жолдармен
Dialogue: 0,0:07:20.42,0:07:25.59,Dialogue,,0,0,0,,Харима, сен Ягириге қатты ұқсайсың деп ойлаймын.
Dialogue: 0,0:07:20.65,0:07:25.01,*Default-ja,NTP,0,0,0,,Менің ойымша, Харима-сан Ягири-кунға өте ұқсас.
Dialogue: 0,0:07:30.02,0:07:31.76,Dialogue,,0,0,0,,Үйге қош келдіңіз.
Dialogue: 0,0:07:30.40,0:07:31.24,*Default-ja,NTP,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:07:35.68,0:07:38.25,Dialogue,,0,0,0,,«Мұның мәні неде» дегің келеді, солай ма?
Dialogue: 0,0:07:36.17,0:07:38.49,*Default-ja,NTP,0,0,0,,«Сіз нені айтып тұрсыз?» Айтқыңыз келеді деп ойлаймын.
Dialogue: 0,0:07:39.19,0:07:41.58,Dialogue,,0,0,0,,Ал келесіде сіз мынаны айтар едіңіз:
Dialogue: 0,0:07:39.46,0:07:41.17,*Default-ja,NTP,0,0,0,,Әрі қарай не айтқыңыз келеді?
Dialogue: 0,0:07:41.58,0:07:46.11,Dialogue,,0,0,0,,«Демек, сіз менің басымның сол зерттеу мекемесінде екенін білдіңіз».
Dialogue: 0,0:07:41.81,0:07:43.31,*Default-ja,NTP,0,0,0,,«Сіз мұны білдіңіз бе?»
Dialogue: 0,0:07:43.69,0:07:45.94,*Default-ja,NTP,0,0,0,,«Менің басым сол зертханада».
Dialogue: 0,0:07:46.11,0:07:50.78,Dialogue,,0,0,0,,«Демек, сіз де, әкеңіз де Yagiri Pharmaceuticals компаниясымен сөз байласып жатырсыз».
Dialogue: 0,0:07:46.35,0:07:50.59,*Default-ja,NTP,0,0,0,,«Әкең екеуің Yagiri Pharmaceutical компаниясымен басынан бері ынтымақтасасыңдар, солай емес пе?»
Dialogue: 0,0:07:50.78,0:07:54.49,Dialogue,,0,0,0,,«Менің басымды ұрлаған әкең болса керек!
Dialogue: 0,0:07:51.01,0:07:54.70,*Default-ja,NTP,0,0,0,,«Менің басымды алған әкең шығар!?»
Dialogue: 0,0:07:54.77,0:08:00.72,Dialogue,,0,0,0,,«Бірақ сен оны менен жасырып, өліп жатқан қызды кесіп тастадың».
Dialogue: 0,0:07:55.09,0:07:57.34,*Default-ja,NTP,0,0,0,,«Бірақ сен оны менен жасырдың».
Dialogue: 0,0:07:57.77,0:08:00.28,*Default-ja,NTP,0,0,0,,«Өлім алдында тұрған әйелдің бетін рұқсатсыз кесіңіз!»
Dialogue: 0,0:08:00.72,0:08:05.38,Dialogue,,0,0,0,,«Мен құбыжық шығармын, бірақ адамдарды шайнап, түкіру сені нағыз құбыжық етеді».
Dialogue: 0,0:08:00.97,0:08:02.39,*Default-ja,NTP,0,0,0,,«Мен де құбыжықпын».
Dialogue: 0,0:08:02.65,0:08:05.46,*Default-ja,NTP,0,0,0,,«Сіз сөздің шын мағынасында адамдарды өлтіретін құбыжықсыз!»
Dialogue: 0,0:08:05.38,0:08:06.71,Dialogue,,0,0,0,,Мен дұрыс айтамын ба?
Dialogue: 0,0:08:05.90,0:08:06.81,*Default-ja,NTP,0,0,0,,сияқты бір жерде ме?
Dialogue: 0,0:08:06.99,0:08:10.46,Dialogue,,0,0,0,,Иә, түсінбеушіліктерді жою үшін мен мұны алдын ала айтамын.
Dialogue: 0,0:08:08.20,0:08:10.31,*Default-ja,NTP,0,0,0,,Аа, түсініспеушілік болмас үшін алдын ала айтып берейін.
Dialogue: 0,0:08:10.46,0:08:14.69,Dialogue,,0,0,0,,Сенің басыңды ұрлаған әкем болды ма, соны білмеймін де, бәрібір.
Dialogue: 0,0:08:10.77,0:08:14.61,*Default-ja,NTP,0,0,0,,Сенің басыңды ұрлаған қария ма, білмеймін, маған қызық емес.
Dialogue: 0,0:08:14.69,0:08:18.27,Dialogue,,0,0,0,,Ал қыз біздің оған кішігірім ота жасауымызды қалады.
Dialogue: 0,0:08:14.95,0:08:17.58,*Default-ja,NTP,0,0,0,,Сондай-ақ, кішкентай пластикалық ота ол мұны қалағандықтан жасалды ...
Dialogue: 0,0:08:18.27,0:08:21.82,Dialogue,,0,0,0,,Сол Ягири адамдары оны бұл шешімге жетелеген болуы мүмкін.
Dialogue: 0,0:08:18.63,0:08:21.44,*Default-ja,NTP,0,0,0,,«Ягиридің» жігіттері оған жол көрсеткен шығар.
Dialogue: 0,0:08:21.82,0:08:23.81,Dialogue,,0,0,0,,Бірақ бұл менің шаруам емес.
Dialogue: 0,0:08:22.03,0:08:24.19,*Default-ja,NTP,0,0,0,,Бұл мен білетін нәрсе емес.
Dialogue: 0,0:08:25.31,0:08:30.04,Dialogue,,0,0,0,,«Менің ойымды түсіне аласың ба?»
Dialogue: 0,0:08:25.80,0:08:29.83,*Default-ja,NTP,0,0,0,,«Менің не ойлап тұрғанымды білесің бе?»
Dialogue: 0,0:08:30.53,0:08:32.57,Dialogue,,0,0,0,,Иә, аламын.
Dialogue: 0,0:08:30.54,0:08:32.19,*Default-ja,NTP,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:08:32.57,0:08:35.04,Dialogue,,0,0,0,,Мен сені жиырма жыл бойы сүйдім.
Dialogue: 0,0:08:32.84,0:08:34.97,*Default-ja,NTP,0,0,0,,Мен сені 20 жыл бойы сүйдім
Dialogue: 0,0:08:35.04,0:08:36.56,Dialogue,,0,0,0,,Әрине, мен мұндай нәрсені түсінетін едім.
Dialogue: 0,0:08:35.26,0:08:36.76,*Default-ja,NTP,0,0,0,,Мен мұны жақсы түсінемін.
Dialogue: 0,0:08:37.41,0:08:39.07,Dialogue,,0,0,0,,Неге қазір...?!
Dialogue: 0,0:08:37.94,0:08:39.00,*Default-ja,NTP,0,0,0,,Қазір не істеп жатырсың...
Dialogue: 0,0:08:39.07,0:08:41.48,Dialogue,,0,0,0,,Менің басымның орналасқан жері туралы неге үндемедің?!
Dialogue: 0,0:08:39.25,0:08:41.98,*Default-ja,NTP,0,0,0,,Олай болса, осы уақытқа дейін мойныңның орналасқан жеріне неге үндемей келдің!?
Dialogue: 0,0:08:42.91,0:08:44.85,Dialogue,,0,0,0,,Себебі мен сені жақсы көремін.
Dialogue: 0,0:08:43.43,0:08:44.58,*Default-ja,NTP,0,0,0,,ұнайды
Dialogue: 0,0:08:44.85,0:08:47.17,Dialogue,,0,0,0,,Сондықтан мен бұл туралы үндемедім.
Dialogue: 0,0:08:45.10,0:08:47.28,*Default-ja,NTP,0,0,0,,Сондықтан мойын қайда деп үндемедім.
Dialogue: 0,0:08:47.17,0:08:50.70,Dialogue,,0,0,0,,Егер сіз оны тапсаңыз, бір жерден кетіп қалар едіңіз.
Dialogue: 0,0:08:47.77,0:08:50.48,*Default-ja,NTP,0,0,0,,Басыңды алсам, кетесің.
Dialogue: 0,0:08:50.70,0:08:52.95,Dialogue,,0,0,0,,Мен бұған шыдай алмадым.
Dialogue: 0,0:08:51.04,0:08:52.57,*Default-ja,NTP,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:08:52.95,0:08:56.17,Dialogue,,0,0,0,,Сен бақытты болуың үшін мен бас тартамын деп айтпаймын.
Dialogue: 0,0:08:53.32,0:08:56.42,*Default-ja,NTP,0,0,0,,Мен сенің бақытың үшін бас тартамын деп айтпаймын.
Dialogue: 0,0:08:56.88,0:09:00.04,Dialogue,,0,0,0,,Бұл күресте бір-бірімізге деген сүйіспеншілігіміз бар.
Dialogue: 0,0:08:57.14,0:08:59.51,*Default-ja,NTP,0,0,0,,Бұл сіз бен менің арамыздағы махаббат үшін шайқас.
Dialogue: 0,0:09:00.83,0:09:03.01,Dialogue,,0,0,0,,Мен сені ешқашан жібермеймін.
Dialogue: 0,0:09:01.13,0:09:02.85,*Default-ja,NTP,0,0,0,,Мен сені ешқашан жібермеймін
Dialogue: 0,0:09:03.01,0:09:11.16,Dialogue,,0,0,0,,Олай етпейтініне көз жеткізу үшін мен басқалардың сүйіспеншілігін, олардың өлімін, өзімді және (бұл қарама-қайшы көрінуі мүмкін), бірақ тіпті сіздің сезімдеріңізді пайдаланамын.
Dialogue: 0,0:09:03.23,0:09:05.86,*Default-ja,NTP,0,0,0,,Егер солай болса, маған басқа біреудің махаббаты, тіпті өлімі керек болады.
Dialogue: 0,0:09:06.04,0:09:08.46,*Default-ja,NTP,0,0,0,,Мен өзіме қарама-қайшы болып жатқан сияқтымын.
Dialogue: 0,0:09:08.87,0:09:10.83,*Default-ja,NTP,0,0,0,,Мен тіпті сіздің ойларыңызды пайдаланамын
Dialogue: 0,0:09:14.79,0:09:19.53,Dialogue,,0,0,0,,Мен басымды қайтарсам да, мен кетуді ешқашан ойламас едім...
Dialogue: 0,0:09:15.18,0:09:19.51,*Default-ja,NTP,0,0,0,,Басымды қайтарсам да сені тастамас едім...
Dialogue: 0,0:09:19.88,0:09:23.61,Dialogue,,0,0,0,,Бірақ сіз бұлай ойласаңыз да, сіздің басыңыздың болмауы мүмкін.
Dialogue: 0,0:09:20.14,0:09:24.07,*Default-ja,NTP,0,0,0,,Бұл сіздің еркіңіз болса да, бұл сіздің басыңыздың еркі дегенді білдірмейді.
Dialogue: 0,0:09:24.42,0:09:25.98,Dialogue,,0,0,0,,Мен ойланып қалдым.
Dialogue: 0,0:09:24.74,0:09:25.78,*Default-ja,NTP,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:09:25.98,0:09:31.74,Dialogue,,0,0,0,,Неліктен сен сияқты пері бұл дүниеде адамдардың алдына шықты?
Dialogue: 0,0:09:26.25,0:09:31.04,*Default-ja,NTP,0,0,0,,Неліктен сен, пері, бұл дүниеде адамдардың алдына шығасың?
Dialogue: 0,0:09:31.74,0:09:37.38,Dialogue,,0,0,0,,Бәлкім, сіз дәл осы дүниеде өзіңізді басын жоғалтқаныңыз үшін көрсете алдыңыз.
Dialogue: 0,0:09:31.98,0:09:37.18,*Default-ja,NTP,0,0,0,,Сенің бұл дүниеде заттай бола алғаның басыңнан айырылғандықтан емес пе? Тон
Dialogue: 0,0:09:37.38,0:09:44.39,Dialogue,,0,0,0,,Бәлкім, сіздің басыңыз қайта қолыңызға түсіп, жадыңыз қайта оралғанда, сіз түтіннің түтініндей бұл дүниеден сөніп қаласыз ...
Dialogue: 0,0:09:37.92,0:09:41.33,*Default-ja,NTP,0,0,0,,Бұл жағдайда сіз басын алып, естеліктеріңізді қалпына келтірдіңіз.
Dialogue: 0,0:09:41.83,0:09:46.81,*Default-ja,NTP,0,0,0,,Осы уақытқа дейін бәрі түтін боп ғайып бола ма деп ойлаймын, бұл елес сияқты...
Dialogue: 0,0:09:44.39,0:09:47.13,Dialogue,,0,0,0,,...осы уақытқа дейін болғанның бәрі елес сияқты.
Dialogue: 0,0:09:47.14,0:09:49.44,Dialogue,,0,0,0,,Мен олай болады деп қорқамын.
Dialogue: 0,0:09:47.54,0:09:49.11,*Default-ja,NTP,0,0,0,,Менің қорқатыным осы
Dialogue: 0,0:09:57.45,0:10:00.43,Dialogue,,0,0,0,,Менің айтқаныма сенесің бе?
Dialogue: 0,0:09:58.00,0:09:59.98,*Default-ja,NTP,0,0,0,,Маған сенесің бе?
Dialogue: 0,0:10:01.23,0:10:03.19,Dialogue,,0,0,0,,Мен саған сенемін.
Dialogue: 0,0:10:01.52,0:10:03.05,*Default-ja,NTP,0,0,0,,Мен саған сенемін
Dialogue: 0,0:10:03.19,0:10:05.68,Dialogue,,0,0,0,,офлайн, сен мен сенбейтін жалғыз адамсың.
Dialogue: 0,0:10:03.56,0:10:06.05,*Default-ja,NTP,0,0,0,,Керісінше мен саған ғана сенемін.
Dialogue: 0,0:10:06.39,0:10:08.86,Dialogue,,0,0,0,,Мен де қорқамын.
Dialogue: 0,0:10:08.86,0:10:10.71,Dialogue,,0,0,0,,Мен өлуден қорқамын.
Dialogue: 0,0:10:11.57,0:10:15.96,Dialogue,,0,0,0,,Мен мұнда мені өлтіретін ешкім жоқ екенін түсінемін.
Dialogue: 0,0:10:11.83,0:10:16.04,*Default-ja,NTP,0,0,0,,Мен қазір мені өлтіретін ешкім жоқ екенін түсіндім.
Dialogue: 0,0:10:15.96,0:10:17.56,Dialogue,,0,0,0,,Мен мақтанбаймын.
Dialogue: 0,0:10:16.44,0:10:20.15,*Default-ja,NTP,0,0,0,,Бұл қулық емес; бұл қарапайым факт.
Dialogue: 0,0:10:17.56,0:10:20.46,Dialogue,,0,0,0,,Мен оны қарапайым факт ретінде қабылдаймын.
Dialogue: 0,0:10:20.46,0:10:23.57,Dialogue,,0,0,0,,Менің оны қабылдауымда ешқандай қуаныш пен сезім жоқ.
Dialogue: 0,0:10:20.72,0:10:23.53,*Default-ja,NTP,0,0,0,,Мен оны жай ғана қабылдап жатырмын, онда қуаныш та, эмоция да жоқ.
Dialogue: 0,0:10:23.57,0:10:27.54,Dialogue,,0,0,0,,Бірақ, мүмкін сол себепті де, мен қорқамын.
Dialogue: 0,0:10:24.04,0:10:24.70,*Default-ja,NTP,0,0,0,,Бірақ…
Dialogue: 0,0:10:25.30,0:10:27.13,*Default-ja,NTP,0,0,0,,Жоқ, сондықтан қорқынышты
Dialogue: 0,0:10:27.54,0:10:31.63,Dialogue,,0,0,0,,Менің өлімімді басқаратын менің ішкі өзегім жоқ.
Dialogue: 0,0:10:27.84,0:10:31.54,*Default-ja,NTP,0,0,0,,Менде өлімді басқаратын өзек жоқ.
Dialogue: 0,0:10:31.63,0:10:34.82,Dialogue,,0,0,0,,Менің басымның өзі сол ядро.
Dialogue: 0,0:10:31.93,0:10:34.10,*Default-ja,NTP,0,0,0,,Менің мойным оның өзегі.
Dialogue: 0,0:10:34.78,0:10:36.64,*Default-ja,NTP,0,0,0,,Біреу менің мойынымды бұзады
Dialogue: 0,0:10:34.82,0:10:37.01,Dialogue,,0,0,0,,Егер біреу сол ядроны жойса...
Dialogue: 0,0:10:37.01,0:10:41.06,Dialogue,,0,0,0,,Олай болса, менің еркім мен жағдайға қарамастан...
Dialogue: 0,0:10:37.33,0:10:41.76,*Default-ja,NTP,0,0,0,,Олай болса, мен қазіргі адам менің ниетіме де, жағдайыма да қатысы жоқ...
Dialogue: 0,0:10:44.06,0:10:45.58,Dialogue,,0,0,0,,Сенер ме едіңіз...
Dialogue: 0,0:10:44.77,0:10:45.97,*Default-ja,NTP,0,0,0,,Сенесің бе?
Dialogue: 0,0:10:46.01,0:10:49.41,Dialogue,,0,0,0,,Менің көзім болмаса да, миым болмаса да қорқынышты түс көремін?
Dialogue: 0,0:10:49.86,0:10:53.33,Dialogue,,0,0,0,,Көрген түнде қорқыныштан дірілдеген адамға сенер ме едіңіз?
Dialogue: 0,0:10:50.12,0:10:53.13,*Default-ja,NTP,0,0,0,,Сол түнді көріп, қорқып қалтырап тұрғаныма сенесің бе?
Dialogue: 0,0:10:53.33,0:10:59.67,Dialogue,,0,0,0,,Мен одан қорықтым, сондықтан ерік-жігерімді басқару үшін басымды іздедім.
Dialogue: 0,0:10:53.67,0:10:54.73,*Default-ja,NTP,0,0,0,,Өйткені бұл қорқынышты
Dialogue: 0,0:10:55.03,0:10:57.37,*Default-ja,NTP,0,0,0,,Өйткені мен өз өлімімді басқарғым келеді
Dialogue: 0,0:10:57.56,0:10:59.10,*Default-ja,NTP,0,0,0,,Басыңды сұрай бердім...
Dialogue: 0,0:10:59.67,0:11:02.67,Dialogue,,0,0,0,,Мен мұны айтсам, сенер ме едің?
Dialogue: 0,0:11:00.14,0:11:03.16,*Default-ja,NTP,0,0,0,,Мен мұны айтсам сенер ме едің?
Dialogue: 0,0:11:03.89,0:11:07.17,Dialogue,,0,0,0,,Мен айттым ғой, солай емес пе? Мен сенетін жалғыз сенсің.
Dialogue: 0,0:11:04.35,0:11:07.04,*Default-ja,NTP,0,0,0,,Мен айттым ғой, солай ма? Мен саған ғана сенемін
Dialogue: 0,0:11:07.17,0:11:09.07,Dialogue,,0,0,0,,Мен толық жоғалдым.
Dialogue: 0,0:11:07.38,0:11:08.73,*Default-ja,NTP,0,0,0,,Тұманға бес миль қалды.
Dialogue: 0,0:11:09.07,0:11:13.90,Dialogue,,0,0,0,,Біз қыңыр болғанымыз сонша, біз алыпсатарлық шеңберінен ешқашан кетпейміз.
Dialogue: 0,0:11:09.30,0:11:13.22,*Default-ja,NTP,0,0,0,,Менің ойымша, біз алыпсатарлықтан басқа емес идеялармен айналыстық.
Dialogue: 0,0:11:14.61,0:11:16.15,Dialogue,,0,0,0,,Біз ақымақпыз.
Dialogue: 0,0:11:14.92,0:11:16.14,*Default-ja,NTP,0,0,0,,Қауын мүсіні
Dialogue: 0,0:11:16.15,0:11:17.40,Dialogue,,0,0,0,,Иә.
Dialogue: 0,0:11:17.40,0:11:18.50,Dialogue,,0,0,0,,Сәлем, Шинра.
Dialogue: 0,0:11:17.61,0:11:18.48,*Default-ja,NTP,0,0,0,,Сәлем Силла
Dialogue: 0,0:11:18.50,0:11:19.93,Dialogue,,0,0,0,,Жер
Dialogue: 0,0:11:18.73,0:11:19.36,*Default-ja,NTP,0,0,0,,Не?
Dialogue: 0,0:11:22.74,0:11:23.98,Dialogue,,0,0,0,,Мен сені бір рет жұдырықтаймын.
Dialogue: 0,0:11:24.69,0:11:25.91,Dialogue,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:11:25.01,0:11:25.68,*Default-ja,NTP,0,0,0,,Жарайды.
Dialogue: 0,0:11:29.44,0:11:32.19,Dialogue,,0,0,0,,Жарайды, енді мен сені жұдырығыммен ұрайын.
Dialogue: 0,0:11:30.08,0:11:32.24,*Default-ja,NTP,0,0,0,,Олай болса мен де сені бір рет ұрайын.
Dialogue: 0,0:11:44.34,0:11:47.26,Dialogue,,0,0,0,,Қарашы, сен өзіңе адал болған кезде ең әдемісің.
Dialogue: 0,0:11:44.73,0:11:47.56,*Default-ja,NTP,0,0,0,,Көрдіңіз бе, Селтидің нағыз жүзі ең әдемі.
Dialogue: 0,0:11:49.47,0:11:53.16,Dialogue,,0,0,0,,Сол соққы біздің үйлену тойындағы сүйіспеншілікті алмастырды.
Dialogue: 0,0:11:50.12,0:11:52.91,*Default-ja,NTP,0,0,0,,Бұл жұдырық антпен сүйіспеншілікті алмастыра ма?
Dialogue: 0,0:11:53.16,0:11:54.08,Dialogue,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:12:04.75,0:12:06.51,Dialogue,,0,0,0,,Сіз жылап жатырсыз ба?
Dialogue: 0,0:12:05.05,0:12:06.14,*Default-ja,NTP,0,0,0,,Сіз жылап жатырсыз ба?
Dialogue: 0,0:12:18.34,0:12:21.34,Dialogue,,0,0,0,,Дегенмен, бұл өте таңқаларлық.
Dialogue: 0,0:12:18.97,0:12:20.95,*Default-ja,NTP,0,0,0,,Бірақ бұл таңқаларлық.
Dialogue: 0,0:12:25.60,0:12:27.13,Dialogue,,0,0,0,,Йо, Изая.
Dialogue: 0,0:12:25.95,0:12:26.88,*Default-ja,NTP,0,0,0,,Йо Изая
Dialogue: 0,0:12:27.13,0:12:29.22,Dialogue,,0,0,0,,О, Дотачин. Ұзақ уақытта көрмеу.
Dialogue: 0,0:12:27.68,0:12:29.35,*Default-ja,NTP,0,0,0,,О, Дотачин, біраз уақыт өтті.
Dialogue: 0,0:12:29.22,0:12:30.70,Dialogue,,0,0,0,,Мені олай атама.
Dialogue: 0,0:12:29.50,0:12:30.91,*Default-ja,NTP,0,0,0,,Оны олай атамаңыз.
Dialogue: 0,0:12:30.70,0:12:34.26,Dialogue,,0,0,0,,Айтпақшы, сіз The Dollars атауын қалай алғанын білесіз бе?
Dialogue: 0,0:12:31.05,0:12:33.74,*Default-ja,NTP,0,0,0,,Айтпақшы, сіз доллар атауының шығу тегін білесіз бе?
Dialogue: 0,0:12:34.26,0:12:36.69,Dialogue,,0,0,0,,«Долларыңды бер!» дегеннен емес пе? әлде соған ұқсас нәрсе ме?
Dialogue: 0,0:12:34.57,0:12:36.97,*Default-ja,NTP,0,0,0,,Бұл маған доллар бергендей емес пе?
Dialogue: 0,0:12:36.69,0:12:38.74,Dialogue,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:12:37.28,0:12:38.85,*Default-ja,NTP,0,0,0,,Бұл айырмашылық.
Dialogue: 0,0:12:38.74,0:12:41.15,Dialogue,,0,0,0,,Бұл ұйым негізінен ештеңе істемейтіндіктен.
Dialogue: 0,0:12:38.99,0:12:41.10,*Default-ja,NTP,0,0,0,,Бұл ұйым негізінен ештеңе істемейді.
Dialogue: 0,0:12:41.15,0:12:43.70,Dialogue,,0,0,0,,Олар «Доллар» болып табылады, өйткені олар «дара дара» арқылы айналады.
Dialogue: 0,0:12:41.39,0:12:43.43,*Default-ja,NTP,0,0,0,,Доллар, өйткені мен ерініп жүрмін
Dialogue: 0,0:12:43.70,0:12:44.57,Dialogue,,0,0,0,,Бұл өте талғамсыз екен.
Dialogue: 0,0:12:43.86,0:12:45.09,*Default-ja,NTP,0,0,0,,Міне, солай.
Dialogue: 0,0:12:45.13,0:12:47.44,Dialogue,,0,0,0,,Дотачин, дәл қазір көрдіңіз бе?
Dialogue: 0,0:12:45.45,0:12:47.42,*Default-ja,NTP,0,0,0,,Дотачин Сіз мұны бұрын көрдіңіз бе?
Dialogue: 0,0:12:47.44,0:12:48.52,Dialogue,,0,0,0,,Қара байкер —
Dialogue: 0,0:12:47.59,0:12:48.71,*Default-ja,NTP,0,0,0,,Қара велосипед...
Dialogue: 0,0:12:48.52,0:12:50.31,Dialogue,,0,0,0,,Жоқ, бұл шынымен болды ма?
Dialogue: 0,0:12:48.83,0:12:50.30,*Default-ja,NTP,0,0,0,,Жоқ, жоқ, жоқ, бұл маңызды ма?
Dialogue: 0,0:12:50.31,0:12:53.07,Dialogue,,0,0,0,,Бұл жай ғана елес емес еді...
Dialogue: 0,0:12:50.47,0:12:53.10,*Default-ja,NTP,0,0,0,,Бұл мен үшін оптикалық иллюзия емес еді!
Dialogue: 0,0:12:53.07,0:12:55.39,Dialogue,,0,0,0,,Мүмкін, бұл CG түрі болуы мүмкін.
Dialogue: 0,0:12:53.30,0:12:55.54,*Default-ja,NTP,0,0,0,,"Сонымен, бұл CG емес пе?"
Dialogue: 0,0:12:55.39,0:12:58.42,Dialogue,,0,0,0,,Бұл CG заты долларда да бар, сіз білесіз.
Dialogue: 0,0:12:55.71,0:12:58.18,*Default-ja,NTP,0,0,0,,Бұл CG де доллардың мүшесі болып табылады.
Dialogue: 0,0:12:59.17,0:13:03.67,Dialogue,,0,0,0,,Керемет!
Dialogue: 0,0:12:59.47,0:13:00.17,Secondary,,0,0,0,,Бұл рас па?
Dialogue: 0,0:12:59.54,0:13:03.89,*Default-ja,NTP,0,0,0,,Керемет! Керемет! Керемет!
Dialogue: 0,0:12:59.61,0:13:00.48,*Default-ja,NTP,0,0,0,,Мистер Столкер
Dialogue: 0,0:13:06.87,0:13:09.01,Dialogue,,0,0,0,,Мен шынымды айтсам таң қалдым.
Dialogue: 0,0:13:07.22,0:13:08.72,*Default-ja,NTP,0,0,0,,Шынымды айтсам, таң қалдым.
Dialogue: 0,0:13:09.01,0:13:13.46,Dialogue,,0,0,0,,Мен көптеген адамдарды онлайн режимінде доллармен есептейтінін білетінмін.
Dialogue: 0,0:13:09.18,0:13:13.52,*Default-ja,NTP,0,0,0,,Мен көптеген адамдар желіде өздерін доллар деп атайтынын білдім.
Dialogue: 0,0:13:13.46,0:13:19.19,Dialogue,,0,0,0,,Алайда, мен экспромттық жиынға осыншама көп адам келетінін білмедім.
Dialogue: 0,0:13:13.80,0:13:16.74,*Default-ja,NTP,0,0,0,,Бірақ олар кенет бүгін жиналыс өткіземіз деді.
Dialogue: 0,0:13:17.04,0:13:19.88,*Default-ja,NTP,0,0,0,,Мен осында жиналу үшін бар күш-жігерін салып жатқан адамдардың көп екеніне сене алар емеспін.
Dialogue: 0,0:13:20.61,0:13:22.69,Dialogue,,0,0,0,,Адамдар шынымен менің күткенімнен асып түседі.
Dialogue: 0,0:13:20.79,0:13:23.21,*Default-ja,NTP,0,0,0,,Адамдар шынымен сіз елестеткеннен де көп.
Dialogue: 0,0:13:23.11,0:13:31.58,Dialogue,,0,0,0,,Күнделікті өмірден қашуды армандаған сияқтысыз, бірақ алты айдан кейін Токиодағы өмір сіз үшін әдеттегідей болады.
Dialogue: 0,0:13:23.39,0:13:27.23,*Default-ja,NTP,0,0,0,,Алайда, Микадо-кун күнделікті өмірден қашуды армандайтын сияқты.
Dialogue: 0,0:13:27.87,0:13:29.27,*Default-ja,NTP,0,0,0,,Токионың өмірі қандай?
Dialogue: 0,0:13:29.53,0:13:31.50,*Default-ja,NTP,0,0,0,,Жарты жылдан кейін бұл күнделікті әдетке айналады, солай ма?
Dialogue: 0,0:13:31.58,0:13:39.08,Dialogue,,0,0,0,,Сонымен қатар, егер сіз күнделікті емес нәрсеге қол жеткізгіңіз келсе, сіз басқа жерге көшуіңіз керек немесе көбірек «жер асты» істерімен айналысуыңыз керек.
Dialogue: 0,0:13:32.04,0:13:34.32,*Default-ja,NTP,0,0,0,,Егер сіз одан да ерекше болғыңыз келсе
Dialogue: 0,0:13:34.49,0:13:39.17,*Default-ja,NTP,0,0,0,,Мен басқа жерге баруым керек немесе астыртын бірдеңені сынап көруім керек.
Dialogue: 0,0:13:39.08,0:13:44.42,Dialogue,,0,0,0,,Бірақ сіз бұл әлемге қадам басқан кезде, оның да қалыпты болып көрінуі үшін шамамен үш күн қажет болады.
Dialogue: 0,0:13:39.70,0:13:41.52,*Default-ja,NTP,0,0,0,,Бірақ егер біз де сол жаққа кіретін болсақ.
Dialogue: 0,0:13:42.18,0:13:44.89,*Default-ja,NTP,0,0,0,,Бұл үш күннен кейін күнделікті әдетке айналуы мүмкін.
Dialogue: 0,0:13:45.89,0:13:51.05,Dialogue,,0,0,0,,Егер сіз шынымен де күнделікті өмірден қашуды қаласаңыз, дамуды жалғастырудан басқа амалыңыз жоқ.
Dialogue: 0,0:13:46.23,0:13:48.41,*Default-ja,NTP,0,0,0,,Күнделікті өмірден шынымен қашқыңыз келсе
Dialogue: 0,0:13:48.77,0:13:51.03,*Default-ja,NTP,0,0,0,,Бізде дамуды жалғастырудан басқа амал жоқ.
Dialogue: 0,0:13:51.05,0:13:54.78,Dialogue,,0,0,0,,Жоғары немесе төмен көздегеніңізге қарамастан.
Dialogue: 0,0:13:51.68,0:13:54.64,*Default-ja,NTP,0,0,0,,Сіз жоғарыға немесе төменге ұмтыласыз ба.
Dialogue: 0,0:13:55.73,0:13:57.44,Dialogue,,0,0,0,,Күнделікті өмірден ләззат алыңыз!
Dialogue: 0,0:13:56.10,0:13:57.88,*Default-ja,NTP,0,0,0,,Күнделікті өмірден ләззат алыңыз
Dialogue: 0,0:13:57.98,0:14:09.27,Dialogue,,0,0,0,,Сізге деген құрметім үшін Ягири Намидің телефон нөмірін тегін бердім және ешкімге сіздің The Dollars негізін қалаушы екеніңізді айтпаймын.
Dialogue: 0,0:13:58.25,0:14:01.19,*Default-ja,NTP,0,0,0,,Сіздің құрметіңізге
Dialogue: 0,0:14:01.44,0:14:05.53,*Default-ja,NTP,0,0,0,,Мен Нами Ягиридің телефон нөмірі туралы әңгімені тегін қалдырамын.
Dialogue: 0,0:14:06.01,0:14:09.83,*Default-ja,NTP,0,0,0,,Dollars негізін қалаушы екеніңіз туралы ақпаратты сатпаңыз.
Dialogue: 0,0:14:10.16,0:14:11.54,Dialogue,,0,0,0,,Бұл сіздің ұйымыңыз.
Dialogue: 0,0:14:10.50,0:14:11.55,*Default-ja,NTP,0,0,0,,Бұл сіздің ұйымыңыз.
Dialogue: 0,0:14:11.54,0:14:13.28,Dialogue,,0,0,0,,Оны қалаған кезде пайдаланыңыз.
Dialogue: 0,0:14:11.80,0:14:13.83,*Default-ja,NTP,0,0,0,,Егер сіз оны пайдаланғыңыз келсе, өз қалауыңыз бойынша жасаңыз.
Dialogue: 0,0:14:20.42,0:14:22.54,Dialogue,,0,0,0,,IIIзааааааа!
Dialogue: 0,0:14:20.85,0:14:23.15,*Default-ja,NTP,0,0,0,,Бұл болады
Dialogue: 0,0:14:22.83,0:14:25.55,Dialogue,,0,0,0,,Кездесуіміздің аяқталатын уақыты келді.
Dialogue: 0,0:14:23.30,0:14:25.30,*Default-ja,NTP,0,0,0,,Құтқару уақыты жақындап қалған сияқты.
Dialogue: 0,0:14:25.88,0:14:29.30,Dialogue,,0,0,0,,Сәттілік, Танака Таро!
Dialogue: 0,0:14:26.16,0:14:28.87,*Default-ja,NTP,0,0,0,,Олай болса, бар күшіңді сал! Таро Танака
Dialogue: 0,0:14:29.30,0:14:31.51,Dialogue,,0,0,0,,Күте тұрыңыз, бейбақ!
Dialogue: 0,0:14:29.95,0:14:34.62,*Default-ja,NTP,0,0,0,,Эй, күт! Мінеки біз!
Dialogue: 0,0:14:31.51,0:14:34.25,Dialogue,,0,0,0,,IIIзааааааа!
Dialogue: 0,0:14:38.16,0:14:41.02,Dialogue,,0,0,0,,А? Амал жоқ...
Dialogue: 0,0:14:38.53,0:14:40.26,*Default-ja,NTP,0,0,0,,Аа, мүмкін емес...
Dialogue: 0,0:14:41.02,0:14:42.22,Dialogue,,0,0,0,,Сол қызға не болды?
Dialogue: 0,0:14:43.38,0:14:47.86,Thought,,0,0,0,,Келесі күні өмір таңғажайып қалыпты жағдайға оралды.
Dialogue: 0,0:14:43.82,0:14:47.66,*Default-ja,NTP,0,0,0,,Келесі күні өмір қалпына келді.
Dialogue: 0,0:14:47.86,0:14:48.51,Thought,,0,0,0,,Ол үшін...
Dialogue: 0,0:14:48.12,0:14:50.45,*Default-ja,NTP,0,0,0,,Оған да
Dialogue: 0,0:14:49.18,0:14:50.06,Thought,,0,0,0,,Ал ол...
Dialogue: 0,0:14:50.71,0:14:52.13,Thought,,0,0,0,,Бала сияқты...
Dialogue: 0,0:14:51.00,0:14:52.25,*Default-ja,NTP,0,0,0,,Тіпті сол балаға
Dialogue: 0,0:14:52.13,0:14:53.29,Dialogue,,0,0,0,,Сәлем, Микадо.
Dialogue: 0,0:14:52.57,0:14:54.75,*Default-ja,NTP,0,0,0,,Білесің бе, Тейжин, мен оны интернеттен көрдім.
Dialogue: 0,0:14:53.29,0:14:56.99,Dialogue,,0,0,0,,Мен желіде доллардың кездесуі болғанын көрдім!
Dialogue: 0,0:14:54.99,0:14:57.30,*Default-ja,NTP,0,0,0,,Мен кеше доллар раллиі болғанын естідім!
Dialogue: 0,0:14:56.99,0:15:01.25,Dialogue,,0,0,0,,Саймон мен Сидзуо да долларда бар!
Dialogue: 0,0:14:57.48,0:15:01.35,*Default-ja,NTP,0,0,0,,Саймон мен Сидзуо да доллардың мүшелері болған сияқты!
Dialogue: 0,0:15:01.25,0:15:03.86,Dialogue,,0,0,0,,Сонымен қатар, мен қара байкердің басы жоқ деп естідім,
Dialogue: 0,0:15:01.50,0:15:03.88,*Default-ja,NTP,0,0,0,,Оның үстіне әлгі қара мотоциклдің мойны жоқ сияқты.
Dialogue: 0,0:15:03.86,0:15:04.91,Dialogue,,0,0,0,,ол қабырғадан құлады,
Dialogue: 0,0:15:04.01,0:15:06.29,*Default-ja,NTP,0,0,0,,Қабырға бойымен жүгіріп, орақты шығару
Dialogue: 0,0:15:04.91,0:15:05.95,Dialogue,,0,0,0,,үлкен орақты суырып алды,
Dialogue: 0,0:15:05.95,0:15:08.21,Dialogue,,0,0,0,,барлығы: «Бваа»
Dialogue: 0,0:15:06.41,0:15:08.14,*Default-ja,NTP,0,0,0,,Бұл, Уау!
Dialogue: 0,0:15:08.21,0:15:09.59,Dialogue,,0,0,0,,және бұл керемет болды!
Dialogue: 0,0:15:08.26,0:15:09.65,*Default-ja,NTP,0,0,0,,Бұл керемет болды!
Dialogue: 0,0:15:09.59,0:15:10.93,Dialogue,,0,0,0,,Мен сенің айтқаныңның ешқайсысын түсінбеймін.
Dialogue: 0,0:15:09.83,0:15:11.37,*Default-ja,NTP,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:15:11.90,0:15:13.86,Thought,,0,0,0,,Олар үшін де.
Dialogue: 0,0:15:12.26,0:15:13.94,*Default-ja,NTP,0,0,0,,Және де оларға
Dialogue: 0,0:15:13.86,0:15:16.59,Dialogue,,0,0,0,,Мен сені сүймеймін.
Dialogue: 0,0:15:14.31,0:15:16.46,*Default-ja,NTP,0,0,0,,Мен сені сүймеймін
Dialogue: 0,0:15:16.59,0:15:22.56,Dialogue,,0,0,0,,Бірақ мен саған қарап оған деген махаббатымды ұмыта алмаймын.
Dialogue: 0,0:15:17.03,0:15:19.30,*Default-ja,NTP,0,0,0,,Бірақ мен саған қарап тұрғанымша
Dialogue: 0,0:15:19.65,0:15:22.14,*Default-ja,NTP,0,0,0,,Мен оған деген махаббатымды ешқашан ұмытпаймын
Dialogue: 0,0:15:22.56,0:15:25.06,Dialogue,,0,0,0,,Ендеше мен сенің маған деген махаббатыңды қабылдаймын.
Dialogue: 0,0:15:22.85,0:15:24.94,*Default-ja,NTP,0,0,0,,Сондықтан мен сенің махаббатыңды қабылдаймын
Dialogue: 0,0:15:25.06,0:15:28.82,Dialogue,,0,0,0,,Мен оны қайтарып алғанша.
Dialogue: 0,0:15:25.62,0:15:28.06,*Default-ja,NTP,0,0,0,,Мен оны бір күні қайтарып алғанша
Dialogue: 0,0:15:37.33,0:15:38.22,Chat,,0,0,0,,Танака Таро чат бөлмесіне кірді.
Dialogue: 0,0:15:38.22,0:15:39.49,Chat,,0,0,0,,Қайырлы кеш.
Dialogue: 0,0:15:39.49,0:15:41.36,Chat,,0,0,0,,Кеш. Мен күттім.
Dialogue: 0,0:15:41.36,0:15:42.49,Chat,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,0:15:42.49,0:15:45.20,Chat,,0,0,0,,Мен бүгін қатты шаршадым, сондықтан мен ертерек жазыламын.
Dialogue: 0,0:15:45.20,0:15:47.91,Chat,,0,0,0,,О, сондықтан көп ұйықтамадың ба? Сіз түнгі түнді немесе басқа нәрсені тарттыңыз ба?
Dialogue: 0,0:15:47.91,0:15:49.34,Chat,,0,0,0,,Иә, солай.
Dialogue: 0,0:15:49.34,0:15:51.51,Chat,,0,0,0,,Менің ойымша, Канра бұл жерде әлі жоқ.
Dialogue: 0,0:15:51.51,0:15:52.54,Chat,,0,0,0,,Канра...
Dialogue: 0,0:15:52.54,0:15:54.00,Chat,,0,0,0,,...келеді, солай ма?
Dialogue: 0,0:15:54.00,0:15:56.71,Chat,,0,0,0,,Әй, бірдеңе шықты.
Dialogue: 0,0:15:56.71,0:15:58.01,Chat,,0,0,0,,О, түсіндім.
Dialogue: 0,0:15:58.01,0:16:00.14,Chat,,0,0,0,,Кешіріңіз, бірақ мен кетуім керек.
Dialogue: 0,0:16:00.14,0:16:01.48,Chat,,0,0,0,,Кездескенше.
Dialogue: 0,0:16:01.71,0:16:02.77,Chat,,0,0,0,,Сеттон сөйлесу бөлмесінен шықты.
Dialogue: 0,0:16:04.44,0:16:06.77,Dialogue,,0,0,0,,Сіздің көңіл көтеруіңізге араласқаным үшін кешіріңіз.
Dialogue: 0,0:16:05.08,0:16:06.84,*Default-ja,NTP,0,0,0,,Бұл өте жаман. Енді қызық бөлігі.
Dialogue: 0,0:16:06.77,0:16:07.81,Dialogue,,0,0,0,,Бұл шұғыл жұмыс.
Dialogue: 0,0:16:07.06,0:16:08.08,*Default-ja,NTP,0,0,0,,Бұл шұғыл жұмыс.
Dialogue: 0,0:16:08.67,0:16:09.94,Dialogue,,0,0,0,,Бұл өте талғамсыз екен.
Dialogue: 0,0:16:10.29,0:16:13.95,Thought,,0,0,0,,Ал қазір менің күнделікті өмірім бұрынғыдай жалғасуда.
Dialogue: 0,0:16:10.65,0:16:13.56,*Default-ja,NTP,0,0,0,,Ал менің күнделікті өмірім әдеттегідей.
Dialogue: 0,0:16:13.95,0:16:18.33,Thought,,0,0,0,,Мен кездескім келмейтін адамдармен кездесіп қалуым мүлде өзгерген жоқ.
Dialogue: 0,0:16:14.20,0:16:18.79,*Default-ja,NTP,0,0,0,,Бұл әрқашан кездескіңіз келмейтін адаммен кездесіп қалудан еш айырмашылығы жоқ.
Dialogue: 0,0:16:19.83,0:16:21.84,Dialogue,,0,0,0,,Бәрі жойылған сияқты.
Dialogue: 0,0:16:20.10,0:16:21.64,*Default-ja,NTP,0,0,0,,Ол ұшып кеткен сияқты
Dialogue: 0,0:16:21.83,0:16:28.70,Dialogue,,0,0,0,,Ал, елестер қорқынышты, өйткені олар үнемі жасырынып жүреді, содан кейін күтпеген жерден пайда болады және сіз кіре бердіңіз.
Dialogue: 0,0:16:22.03,0:16:26.77,*Default-ja,NTP,0,0,0,,Ал, елестер қорқынышты, өйткені олар жасырын және кенеттен пайда болады.
Dialogue: 0,0:16:27.30,0:16:29.19,*Default-ja,NTP,0,0,0,,Ол сондай керемет көрініс жасады.
Dialogue: 0,0:16:29.54,0:16:32.27,Dialogue,,0,0,0,,Енді сенен ешкім қорықпайды.
Dialogue: 0,0:16:29.87,0:16:32.12,*Default-ja,NTP,0,0,0,,Енді сенен ешкім қорықпайды.
Dialogue: 0,0:16:32.27,0:16:34.59,Dialogue,,0,0,0,,Айтпақшы, сен ешкімді өлтірген жоқсың ғой?
Dialogue: 0,0:16:32.57,0:16:34.99,*Default-ja,NTP,0,0,0,,Ақырында мен ешкімді өлтірген жоқпын.
Dialogue: 0,0:16:34.59,0:16:35.94,Dialogue,,0,0,0,,Мына орақтың несі бар?
Dialogue: 0,0:16:35.21,0:16:36.83,*Default-ja,NTP,0,0,0,,Мынау не орақ? Сіз оны кесіп тастай алмайсыз ба?
Dialogue: 0,0:16:35.94,0:16:36.80,Dialogue,,0,0,0,,Тіпті кесуге бола ма?
Dialogue: 0,0:16:37.30,0:16:39.52,Dialogue,,0,0,0,,Сен сол қызды қуып жүрсің бе?
Dialogue: 0,0:16:37.63,0:16:39.50,*Default-ja,NTP,0,0,0,,Сіз бұл әйелді кездейсоқ қуып жүрсіз бе?
Dialogue: 0,0:16:39.52,0:16:41.71,Dialogue,,0,0,0,,Мен сізге қажет кезде көмектесе аламын.
Dialogue: 0,0:16:39.77,0:16:41.27,*Default-ja,NTP,0,0,0,,Сізге қажет болса, мен әрқашан көмектесемін.
Dialogue: 0,0:16:41.71,0:16:42.30,Dialogue,,0,0,0,,Маған қоңырау шалыңыз.
Dialogue: 0,0:16:41.97,0:16:42.91,*Default-ja,NTP,0,0,0,,Маған қоңырау шалыңыз
Dialogue: 0,0:16:45.39,0:16:46.77,Dialogue,,0,0,0,,Кейінірек кездескенше.
Dialogue: 0,0:16:45.85,0:16:46.90,*Default-ja,NTP,0,0,0,,Жақында кездескенше
Dialogue: 0,0:16:46.77,0:16:49.77,Thought,,0,0,0,,Мен Ягири Намидің қайда екенін білмеймін.
Dialogue: 0,0:16:47.41,0:16:49.54,*Default-ja,NTP,0,0,0,,Нами Ягири қайда екенін білмеймін.
Dialogue: 0,0:16:49.77,0:16:51.43,Thought,,0,0,0,,Бірақ маған бәрібір.
Dialogue: 0,0:16:50.13,0:16:51.25,*Default-ja,NTP,0,0,0,,Бірақ бұл маңызды емес
Dialogue: 0,0:16:51.43,0:16:54.28,Thought,,0,0,0,,Мен кім болсам, сол сияқтымын және бұл жерде ешқандай қателік жоқ.
Dialogue: 0,0:16:51.72,0:16:54.19,*Default-ja,NTP,0,0,0,,Мен өзіммін, ешбір жағынан кем емеспін.
Dialogue: 0,0:16:54.70,0:16:56.56,Thought,,0,0,0,,Күндер бұрынғыдай жалғасады.
Dialogue: 0,0:16:54.86,0:16:56.34,*Default-ja,NTP,0,0,0,,Әдеттегідей күндер
Dialogue: 0,0:16:56.56,0:16:59.16,Thought,,0,0,0,,Олар шамадан тыс қалауды да, үмітсіздікті де әкелмейді.
Dialogue: 0,0:16:56.65,0:16:59.17,*Default-ja,NTP,0,0,0,,Шамадан тыс үміт пен үмітсіздіксіз күнделікті өмір
Dialogue: 0,0:16:59.16,0:17:00.70,Thought,,0,0,0,,Ештеңе өзгерген жоқ.
Dialogue: 0,0:16:59.49,0:17:00.51,*Default-ja,NTP,0,0,0,,Шынында… олардың әрқайсысы «Стэйн», «Стэйн» деп тоқтамай сөйлей береді…
Dialogue: 0,0:17:00.70,0:17:05.29,Thought,,0,0,0,,Сонда да мені қанағаттанарлық сезім билейді.
Dialogue: 0,0:17:01.06,0:17:04.77,*Default-ja,NTP,0,0,0,,Бірақ бұл орындалу сезімі қандай!
Dialogue: 0,0:17:05.29,0:17:07.17,Thought,,0,0,0,,Мен дәл осындамын.
Dialogue: 0,0:17:05.90,0:17:08.75,*Default-ja,NTP,0,0,0,,Мен мұндамын, сен сондасың
Dialogue: 0,0:17:07.17,0:17:08.92,Thought,,0,0,0,,Сіз сондасыз.
Dialogue: 0,0:17:08.98,0:17:13.25,Thought,,0,0,0,,Мен сенің құтқарушың болсам, сен менікісің.
Dialogue: 0,0:17:09.29,0:17:10.99,*Default-ja,NTP,0,0,0,,Егер мен сенің құтқарушың болсам
Dialogue: 0,0:17:11.43,0:17:13.19,*Default-ja,NTP,0,0,0,,Сен де менің құтқарушымсың
Dialogue: 0,0:17:17.26,0:17:19.58,Thought,,0,0,0,,Сонымен, бала ойланып қалды.
Dialogue: 0,0:17:17.57,0:17:19.25,*Default-ja,NTP,0,0,0,,Ал бала ойланады
Dialogue: 0,0:17:19.58,0:17:22.06,Thought,,0,0,0,,Ол Орихара Изаяның айтқанын ойлады.
Dialogue: 0,0:17:19.78,0:17:21.76,*Default-ja,NTP,0,0,0,,Изая Орихараның маған айтқаны
Dialogue: 0,0:17:22.06,0:17:28.86,Thought,,0,0,0,,Адам сенгісіз шындықты аңсаған бала мәңгілікке жаңасын іздеуді жалғастыра алар ма еді?
Dialogue: 0,0:17:22.33,0:17:24.45,*Default-ja,NTP,0,0,0,,Мен мүмкін емес шындықты аңсаймын
Dialogue: 0,0:17:24.70,0:17:28.65,*Default-ja,NTP,0,0,0,,Біз шын мәнінде мәңгілікті жаңа шындықтан іздей аламыз ба?
Dialogue: 0,0:17:28.86,0:17:33.17,Thought,,0,0,0,,Бұл мәңгілік ол үшін қалыпты жағдайға айнала ма?
Dialogue: 0,0:17:29.22,0:17:33.23,*Default-ja,NTP,0,0,0,,Ал сол мәңгілік күнделікті бола ма?
Dialogue: 0,0:17:34.07,0:17:36.13,Dialogue,,0,0,0,,Мен жасаған барлық істерім үшін кешірім сұраймын.
Dialogue: 0,0:17:34.52,0:17:36.33,*Default-ja,NTP,0,0,0,,Көп жағынан жаман болды.
Dialogue: 0,0:17:36.13,0:17:36.82,Dialogue,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,0:17:36.46,0:17:37.41,*Default-ja,NTP,0,0,0,,Еңбек тәжірибесі бағдарламасына оралды
Dialogue: 0,0:17:44.05,0:17:46.36,Dialogue,,0,0,0,,Эй, бұл менің орным!
Dialogue: 0,0:17:44.35,0:17:46.41,*Default-ja,NTP,0,0,0,,Эй... Сәлем, менің орным.
Dialogue: 0,0:17:46.36,0:17:49.02,Dialogue,,0,0,0,,О, сіз сынып өкілінің артында тұрсыз дейді.
Dialogue: 0,0:17:46.58,0:17:49.07,*Default-ja,NTP,0,0,0,,Сынып комитеті мүшесінің артында бос орын бар.
Dialogue: 0,0:17:49.02,0:17:51.90,Dialogue,,0,0,0,,Иә? Сізге не болды?
Dialogue: 0,0:17:50.68,0:17:54.17,*Default-ja,NTP,0,0,0,,Бұл не? Бұл кенеттен келді, мен неге екенін түсінбеймін.
Dialogue: 0,0:17:51.90,0:17:54.92,Dialogue,,0,0,0,,Сіз күтпеген жерден шығып, Китакаваның жанына отырасыз...
Dialogue: 0,0:17:58.43,0:18:03.35,Thought,,0,0,0,,Ол ешқашан Харима Микамен бұрынғыдай араласа алмайды.
Dialogue: 0,0:17:58.95,0:18:03.71,*Default-ja,NTP,0,0,0,,Мен оның бұрынғыдай Мика Харимамен жұмыс істемейтініне сенімдімін.
Dialogue: 0,0:18:03.96,0:18:08.57,Thought,,0,0,0,,Бұл жақсы нәрсе ме, жоқ па, оны тек оның өзі біледі.
Dialogue: 0,0:18:04.29,0:18:08.24,*Default-ja,NTP,0,0,0,,Бұл жақсы нәрсе екенін тек ол біледі.
Dialogue: 0,0:18:08.57,0:18:10.34,Thought,,0,0,0,,Бірақ бұл рас па?
Dialogue: 0,0:18:08.89,0:18:10.17,*Default-ja,NTP,0,0,0,,Бірақ бұл шынымен солай ма?
Dialogue: 0,0:18:10.34,0:18:14.36,Thought,,0,0,0,,Мүмкін адамдар өзін-өзі түсінбейтін шығар.
Dialogue: 0,0:18:10.69,0:18:14.02,*Default-ja,NTP,0,0,0,,Өйткені, адамдар адамның жүрегін түсінбейді ме?
Dialogue: 0,0:18:14.36,0:18:17.02,Thought,,0,0,0,,Олардың қолынан келетіні – дамуды жалғастыру.
Dialogue: 0,0:18:14.63,0:18:16.80,*Default-ja,NTP,0,0,0,,«Бізде үнемі дамудан басқа амал жоқ».
Dialogue: 0,0:18:17.02,0:18:20.28,Thought,,0,0,0,,Ол кісінің сөзі сыныпта жаңғырық болды.
Dialogue: 0,0:18:17.39,0:18:19.57,*Default-ja,NTP,0,0,0,,Сол кісінің сөзі ойымда жаңғырып тұр
Dialogue: 0,0:18:20.71,0:18:25.89,Thought,,0,0,0,,Осыншама батыл әрекет жасағаннан кейін ол бәрін істей аламын деп ойлады.
Dialogue: 0,0:18:21.18,0:18:23.26,*Default-ja,NTP,0,0,0,,Осындай батыл әрекет жасағаннан кейін
Dialogue: 0,0:18:23.56,0:18:25.65,*Default-ja,NTP,0,0,0,,Мен бәрін істей аламын деп ойладым.
Dialogue: 0,0:18:25.89,0:18:29.78,Thought,,0,0,0,,Ол бір секундты ойлаған да емес...
Dialogue: 0,0:18:26.07,0:18:29.48,*Default-ja,NTP,0,0,0,,Бірақ бала мұны шамалы да болжаған жоқ.
Dialogue: 0,0:18:29.78,0:18:34.55,Thought,,0,0,0,,Өз сыныбынан қызды шақыру үшін сонша батылдық керек еді.
Dialogue: 0,0:18:30.00,0:18:35.10,*Default-ja,NTP,0,0,0,,Сыныптағы бір қызды кездесуге шақыру соншалықты батылдықты қажет етеді деп ойламаппын...
Dialogue: 0,0:18:39.55,0:18:43.05,Thought,,0,0,0,,Қызға жеткенше қалған уақыт: отыз секунд.
Dialogue: 0,0:18:39.97,0:18:43.09,*Default-ja,NTP,0,0,0,,Бала қызды тапқанша 30 секунд қалды
Dialogue: 0,0:18:43.40,0:18:48.18,Thought,,0,0,0,,Досының қызды ұрып жатқанын тапқанға дейін қалған уақыт: отыз бес секунд.
Dialogue: 0,0:18:43.74,0:18:48.25,*Default-ja,NTP,0,0,0,,35 секунд қалды, ол жігіт өзінің ең жақын досын қызды еркелетіп жатқанын тапқанша
Dialogue: 0,0:18:48.18,0:18:52.44,Thought,,0,0,0,,Ол досына күшті соққы бергенше қалды: қырық бес секунд.
Dialogue: 0,0:18:48.69,0:18:52.12,*Default-ja,NTP,0,0,0,,Бала ең жақын досын тепкенше 45 секунд қалды
Dialogue: 0,0:18:52.44,0:18:56.96,Thought,,0,0,0,,Оның шай беру ұсынысынан бас тартқанға дейін қалған уақыт: жетпіс бес секунд.
Dialogue: 0,0:18:52.88,0:18:56.89,*Default-ja,NTP,0,0,0,,74 секунд қалды, қыз балаға шайдан бас тартты
Dialogue: 0,0:18:56.96,0:19:02.45,Thought,,0,0,0,,Ол оны шатырда өзімен бірге түскі ас ішуге шақырғанға дейін қалды: жетпіс сегіз секунд.
Dialogue: 0,0:18:57.33,0:19:01.91,*Default-ja,NTP,0,0,0,,78 секунд қыз баланы төбесінде түскі асқа шақырғанша қалды
Dialogue: 0,0:19:02.73,0:19:06.08,Thought,,0,0,0,,Оған ғашық болғанға дейін қалған уақыт:...
Dialogue: 0,0:19:03.04,0:19:06.15,*Default-ja,NTP,0,0,0,,Жігіт қызға ғашық болғанша...
Dialogue: 0,0:19:06.38,0:19:09.83,Thought,,0,0,0,,Ол оған мойындағанша уақыт қалды:...
Dialogue: 0,0:19:06.68,0:19:10.38,*Default-ja,NTP,0,0,0,,Бала қызды мойындағанша...
Dialogue: 0,0:19:14.26,0:19:17.32,Dialogue,,0,0,0,,Бірақ сен де ақымақтық жасадың.
Dialogue: 0,0:19:14.70,0:19:17.87,*Default-ja,NTP,0,0,0,,Бірақ сіз де ақымақтық жасадыңыз.
Dialogue: 0,0:19:19.89,0:19:24.22,Dialogue,,0,0,0,,Ағаңның бұралған махаббаты үшін бәрін тастадың.
Dialogue: 0,0:19:20.25,0:19:24.68,*Default-ja,NTP,0,0,0,,Інімнің бұрмаланған махаббаты үшін мен бәрін сүрттім...
Dialogue: 0,0:19:33.68,0:19:37.25,Dialogue,,0,0,0,,Әлде сенің ағаңа деген бұрмаланған махаббатыңды айтайын ба?
Dialogue: 0,0:19:34.14,0:19:37.89,*Default-ja,NTP,0,0,0,,Жоқ. Дәлірек айтқанда, інісіне деген бұрмаланған махаббат па?
Dialogue: 0,0:19:38.01,0:19:39.89,Dialogue,,0,0,0,,Әйтеуір, қиналған жоқсың ба?
Dialogue: 0,0:19:38.21,0:19:41.74,*Default-ja,NTP,0,0,0,,Қауіпті емес пе? Бұл «Тумандықпен» абсорбциялық біріктіру емес пе?
Dialogue: 0,0:19:39.89,0:19:41.98,Dialogue,,0,0,0,,Тұмандықпен бірігу бар, солай ма?
Dialogue: 0,0:19:41.98,0:19:44.46,Dialogue,,0,0,0,,Егер бұл туралы сөз осыған байланысты шығып кетсе ...
Dialogue: 0,0:19:42.18,0:19:44.27,*Default-ja,NTP,0,0,0,,Егер сіз осындай нәрсені әкелсеңіз ше?
Dialogue: 0,0:19:44.45,0:19:50.58,Dialogue,,0,0,0,,Мафия немесе шынымен де білікті мерген "Бэм!"
Dialogue: 0,0:19:44.75,0:19:47.94,*Default-ja,NTP,0,0,0,,Мафия немесе білікті мерген.
Dialogue: 0,0:19:48.34,0:19:51.75,*Default-ja,NTP,0,0,0,,Қастарыңды соғып ал...
Dialogue: 0,0:19:50.58,0:19:51.36,Dialogue,,0,0,0,,Мат.
Dialogue: 0,0:19:52.25,0:19:53.11,Dialogue,,0,0,0,,Тазалау бригадасы?
Dialogue: 0,0:19:52.58,0:19:53.45,*Default-ja,NTP,0,0,0,,Тазалау көлігі?
Dialogue: 0,0:19:53.11,0:19:56.05,Dialogue,,0,0,0,,Иә, олар әрқашан оларды қалай алады.
Dialogue: 0,0:19:53.74,0:19:56.24,*Default-ja,NTP,0,0,0,,Иә, әдеттегі қалпына келтіру тобы.
Dialogue: 0,0:19:56.05,0:19:56.86,Dialogue,,0,0,0,,Бір қолымда оқпен зарядталған винтовка
Dialogue: 0,0:19:56.44,0:19:57.23,*Default-ja,NTP,0,0,0,,Түсіндім
Dialogue: 0,0:20:00.64,0:20:04.14,Dialogue,,0,0,0,,Сәлеметсіз бе? Іс біршама күрделене түсті.
Dialogue: 0,0:20:00.95,0:20:04.35,*Default-ja,NTP,0,0,0,,Сәлеметсіз бе? Іс күрделене түсуде.
Dialogue: 0,0:20:04.14,0:20:06.12,Dialogue,,0,0,0,,Сіз дәл қазір ол бөлмеден шыға аласыз ба?
Dialogue: 0,0:20:04.68,0:20:06.23,*Default-ja,NTP,0,0,0,,Қазір бөлмеден шыға аласыз ба?
Dialogue: 0,0:20:09.09,0:20:13.79,Dialogue,,0,0,0,,Сізде қос мат болуы мүмкін емес, солай ма?
Dialogue: 0,0:20:09.48,0:20:13.56,*Default-ja,NTP,0,0,0,,Патшалар арасындағы жеке шайқастың ережесі бар емес пе?
Dialogue: 0,0:20:14.38,0:20:18.33,Dialogue,,0,0,0,,Ағаң да мен сияқты болғанына сенімдімін.
Dialogue: 0,0:20:14.78,0:20:18.25,*Default-ja,NTP,0,0,0,,Ағаң да мен сияқты болғанына сенімдімін.
Dialogue: 0,0:20:18.32,0:20:25.41,Dialogue,,0,0,0,,Ол әлемге ешкімнен кем сенді, өлімнен бәрінен де қорқады, Аспанды бәрінен де қатты қастерледі.
Dialogue: 0,0:20:18.58,0:20:20.45,*Default-ja,NTP,0,0,0,,Мен о дүниелік өмірге ешкімнен артық сенбеймін.
Dialogue: 0,0:20:20.78,0:20:22.31,*Default-ja,NTP,0,0,0,,Мен басқалардан гөрі өлімнен қорқамын
Dialogue: 0,0:20:22.60,0:20:24.65,*Default-ja,NTP,0,0,0,,Аспанды басқалардан артық қалау
Dialogue: 0,0:20:25.41,0:20:26.03,Dialogue,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:20:25.78,0:20:28.09,*Default-ja,NTP,0,0,0,,Дегенмен, мен де сенімді болдым.
Dialogue: 0,0:20:26.46,0:20:28.06,Dialogue,,0,0,0,,Ицумида-сан ба?
Dialogue: 0,0:20:28.06,0:20:29.16,Dialogue,,0,0,0,,Бұл әлем бар.
Dialogue: 0,0:20:28.30,0:20:30.66,*Default-ja,NTP,0,0,0,,Ақырғы өмір бар, соны қалдырайық.
Dialogue: 0,0:20:29.16,0:20:30.54,Dialogue,,0,0,0,,Осымен қалдырайық.
Dialogue: 0,0:20:31.70,0:20:36.27,Dialogue,,0,0,0,,Дуллахандардың бәрі әйел дейді.
Dialogue: 0,0:20:32.20,0:20:35.87,*Default-ja,NTP,0,0,0,,Дуллахандар негізінен тек әйел адамдары дейді.
Dialogue: 0,0:20:36.27,0:20:37.46,Dialogue,,0,0,0,,Неліктен екенін білесіз бе?
Dialogue: 0,0:20:36.50,0:20:37.74,*Default-ja,NTP,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:20:37.46,0:20:38.94,Dialogue,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:20:37.97,0:20:41.85,*Default-ja,NTP,0,0,0,,Жоқ, кейбір қарамағындағылар мифологияны зерттеп жүрген.
Dialogue: 0,0:20:38.94,0:20:43.47,Dialogue,,0,0,0,,Менің қарамағындағыларымның бірі мұны біраз уақыт зерттеді, бірақ мен оны мағынасыз деп санадым...
Dialogue: 0,0:20:42.13,0:20:43.83,*Default-ja,NTP,0,0,0,,Өйткені мен мұны босқа кетті деп ойладым
Dialogue: 0,0:20:43.88,0:20:45.81,Dialogue,,0,0,0,,Рационалист, мен түсінемін.
Dialogue: 0,0:20:44.23,0:20:45.93,*Default-ja,NTP,0,0,0,,Сіз рационалистсіз, солай емес пе?
Dialogue: 0,0:20:45.81,0:20:47.81,Dialogue,,0,0,0,,Олай болса...
Dialogue: 0,0:20:46.17,0:20:47.67,*Default-ja,NTP,0,0,0,,Ал, мұны бір жаққа қалдырыңыз.
Dialogue: 0,0:20:47.81,0:20:51.18,Dialogue,,0,0,0,,Бұл аспан – техникалық жағынан аспан болмаса да – Валхалла деп аталады.
Dialogue: 0,0:20:48.11,0:20:49.47,*Default-ja,NTP,0,0,0,,Валхалла деп аталатын аспан...
Dialogue: 0,0:20:49.77,0:20:51.26,*Default-ja,NTP,0,0,0,,Дәл емес.
Dialogue: 0,0:20:51.18,0:20:59.82,Dialogue,,0,0,0,,Сканданавия аңызында батыл сарбаздардың рухын Валхаллаға апаратын валькири деп аталатын сауыт киген періште әйелдер бар.
Dialogue: 0,0:20:51.86,0:20:55.96,*Default-ja,NTP,0,0,0,,Скандинавия мифологиясында Валькирия деп аталатын сауыт киген періште әйел бар.
Dialogue: 0,0:20:56.13,0:20:59.76,*Default-ja,NTP,0,0,0,,Ержүрек жауынгерлердің рухын Валхаллаға бағыттау туралы әңгіме бар.
Dialogue: 0,0:20:59.83,0:21:02.27,Dialogue,,0,0,0,,Өлгенге сәлем беретін әйелдер...
Dialogue: 0,0:21:00.12,0:21:02.14,*Default-ja,NTP,0,0,0,,Әйел өлгендерді алып кетуге барады...
Dialogue: 0,0:21:02.27,0:21:04.70,Dialogue,,0,0,0,,Бұл әңгіме таныс сияқты ма?
Dialogue: 0,0:21:02.56,0:21:04.53,*Default-ja,NTP,0,0,0,,Сіз мұны бір жерден естідім деп ойламайсыз ба?
Dialogue: 0,0:21:04.70,0:21:10.10,Dialogue,,0,0,0,,Дуллахандар жер шарын кезіп жүрген валкирлердің формасы деген теория бар.
Dialogue: 0,0:21:05.17,0:21:09.90,*Default-ja,NTP,0,0,0,,Жерді кезіп жүрген Валкирлердің фигуралары Дуллахан деген теория бар.
Dialogue: 0,0:21:10.10,0:21:11.86,Dialogue,,0,0,0,,Егер солай болса...
Dialogue: 0,0:21:10.58,0:21:14.07,*Default-ja,NTP,0,0,0,,Олай болса, мен осыны күтіп тұрғаныма сенімдімін.
Dialogue: 0,0:21:11.86,0:21:13.83,Dialogue,,0,0,0,,Ол күтіп тұрған болуы керек...
Dialogue: 0,0:21:13.83,0:21:16.67,Dialogue,,0,0,0,,Оның оянуы үшін, шайқастар үшін...
Dialogue: 0,0:21:14.52,0:21:16.78,*Default-ja,NTP,0,0,0,,Соғыс уақытын ояту
Dialogue: 0,0:21:16.67,0:21:19.58,Dialogue,,0,0,0,,Барлығы Валхаллаға кіру үшін қасиетті сарбаздарды іздеу үшін.
Dialogue: 0,0:21:16.96,0:21:19.89,*Default-ja,NTP,0,0,0,,Валхаллаға қарсы алу үшін қасиетті жауынгерді табу
Dialogue: 0,0:21:20.26,0:21:24.32,Dialogue,,0,0,0,,Тірі болса да, оянған жоқ, өйткені бұл соғыс алаңы емес.
Dialogue: 0,0:21:20.65,0:21:24.89,*Default-ja,NTP,0,0,0,,Бұл заттың тірі болса да оянбауының себебі, бұл жер ұрыс алаңы емес.
Dialogue: 0,0:21:25.05,0:21:28.09,Dialogue,,0,0,0,,Мүмкін болса, мен де солдат болып сайланғым келеді.
Dialogue: 0,0:21:25.36,0:21:28.79,*Default-ja,NTP,0,0,0,,Мүмкін болса, мен де сол жауынгер ретінде таңдалғым келеді.
Dialogue: 0,0:21:28.97,0:21:33.35,Dialogue,,0,0,0,,Егер Валхалла шынымен өлімнен кейін біреуді күтсе, мен не істеуім керек?
Dialogue: 0,0:21:29.24,0:21:32.05,*Default-ja,NTP,0,0,0,,Өлгеннен кейін шынымен Валхалла бар болса
Dialogue: 0,0:21:32.23,0:21:33.76,*Default-ja,NTP,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:21:33.85,0:21:37.45,Dialogue,,0,0,0,,Соғыс болған жерге барып өзімді дәлелдей алатыныма күмәнім бар.
Dialogue: 0,0:21:34.23,0:21:37.60,*Default-ja,NTP,0,0,0,,Қақтығыс аймағына барып белсенділік таныта алмаймын деп ойлаймын.
Dialogue: 0,0:21:37.45,0:21:40.36,Dialogue,,0,0,0,,Сонда мен тек мен ғана тудыратын соғысты бастауым керек.
Dialogue: 0,0:21:37.82,0:21:40.89,*Default-ja,NTP,0,0,0,,Ондай жағдайда мен тек менің қолымнан келетін шайқасқа шығамын.
Dialogue: 0,0:21:40.87,0:21:41.77,Dialogue,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:21:41.15,0:21:41.97,*Default-ja,NTP,0,0,0,,Қайдасың?
Dialogue: 0,0:21:42.68,0:21:44.86,Dialogue,,0,0,0,,Мен қаншалықты бақыттымын?
Dialogue: 0,0:21:42.99,0:21:44.70,*Default-ja,NTP,0,0,0,,Мен қаншалықты бақыттымын?
Dialogue: 0,0:21:44.86,0:21:52.24,Dialogue,,0,0,0,,Мен ақырет өміріне сенбеймін, мен ешқашан Жәннатқа кірмейтіндей өмір сүремін, бірақ мен оның кесірінен құлаған періштені кездестіремін.
Dialogue: 0,0:21:45.03,0:21:48.79,*Default-ja,NTP,0,0,0,,Мен аспанға сенбеймін және аспаннан алыс өмір сүрдім.
Dialogue: 0,0:21:49.18,0:21:52.65,*Default-ja,NTP,0,0,0,,Сондықтан жерге құлаған өлім періштесін кездестіруге болады.
Dialogue: 0,0:21:52.24,0:21:53.26,Dialogue,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:21:52.83,0:21:55.28,*Default-ja,NTP,0,0,0,,Бұл сіздің болжамыңыз емес.
Dialogue: 0,0:21:53.26,0:21:55.18,Dialogue,,0,0,0,,Мұның бәрі сіздің тарапыңыздан жасалған болжам.
Dialogue: 0,0:21:55.18,0:21:57.19,Dialogue,,0,0,0,,Сенгендер құтқарылады.
Dialogue: 0,0:21:55.52,0:21:57.24,*Default-ja,NTP,0,0,0,,Сенгендер құтқарылады
Dialogue: 0,0:21:57.19,0:21:59.85,Dialogue,,0,0,0,,Оның үстіне бұл жай сақтандыру полисі деп айтпадым ба?
Dialogue: 0,0:21:57.48,0:21:59.74,*Default-ja,NTP,0,0,0,,Және бұл сақтандыру дейді, солай ма?
Dialogue: 0,0:21:59.83,0:22:06.63,Dialogue,,0,0,0,,Мен бар болғанша, мен тозаққа барамын ба, ол жерде тек азап бар ма, бәрібір.
Dialogue: 0,0:22:00.18,0:22:03.43,*Default-ja,NTP,0,0,0,,Тозақ болса да, Азап болса да
Dialogue: 0,0:22:03.67,0:22:06.06,*Default-ja,NTP,0,0,0,,Мен сонда болғанша маңызды емес.
Dialogue: 0,0:22:06.63,0:22:11.42,Dialogue,,0,0,0,,Бірақ, егер қолымнан келсе, мен жұмаққа барғым келеді.
Dialogue: 0,0:22:06.98,0:22:11.03,*Default-ja,NTP,0,0,0,,Бірақ, мүмкін болса, аспан жақсырақ болар еді.
Dialogue: 0,0:22:11.42,0:22:14.78,Dialogue,,0,0,0,,Эй, Нами ханым, бәріміз бірге Жұмаққа барайық.
Dialogue: 0,0:22:11.72,0:22:14.81,*Default-ja,NTP,0,0,0,,Эй Нами-сан, бәріміз жұмаққа барайық.
Dialogue: 0,0:22:15.42,0:22:18.84,Dialogue,,0,0,0,,The Dollars мүшесі ретінде мен мұны ұстанамын.
Dialogue: 0,0:22:15.73,0:22:18.90,*Default-ja,NTP,0,0,0,,Доллар мүшесі ретінде мен бұған жауапты боламын.
Dialogue: 0,0:22:18.84,0:22:20.38,Dialogue,,0,0,0,,Сіздің алдыңызда не тұрғанын көру қиын.
Dialogue: 0,0:22:19.17,0:22:20.68,*Default-ja,NTP,0,0,0,,Маяк астындағы қараңғылық
Dialogue: 0,0:22:20.38,0:22:25.94,Dialogue,,0,0,0,,Селти оның басы өзі тиесілі топтың бір бөлігі екенін ешқашан болжауы мүмкін емес.
Dialogue: 0,0:22:20.84,0:22:26.02,*Default-ja,NTP,0,0,0,,Менің ойымша, Селти оның басы өзі тиесілі ұйымда болды деп ойламайды.
Dialogue: 0,0:22:26.33,0:22:29.40,Dialogue,,0,0,0,,Дұрыс, сіз де The Dollars-қа қосылуыңыз керек.
Dialogue: 0,0:22:26.69,0:22:29.04,*Default-ja,NTP,0,0,0,,Иә, сіз де долларға қосыла аласыз.
Dialogue: 0,0:22:29.40,0:22:33.24,Dialogue,,0,0,0,,Біздің бастық біздің жаңадан келгендерді бір нәрсеге сүйрегенді ұнатады.
Dialogue: 0,0:22:29.78,0:22:33.08,*Default-ja,NTP,0,0,0,,Біздің бастығымыз ''Кім келсе де сүйреп апарамыз'' деген саясатты ұстанады.
Dialogue: 0,0:22:33.24,0:22:38.01,Dialogue,,0,0,0,,Әрине, соңғы кездері рекрутингпен көп айналысатын адаммын.
Dialogue: 0,0:22:33.63,0:22:37.62,*Default-ja,NTP,0,0,0,,Дегенмен жарты жолда адамдарды жинай бастаған мен болдым.
Dialogue: 0,0:22:38.88,0:22:43.71,Dialogue,,0,0,0,,Осы құлаған періштенің қанаттарын қағып жіберейік.
Dialogue: 0,0:22:39.25,0:22:43.87,*Default-ja,NTP,0,0,0,,Жерге құлаған періштелерді қолымызбен қанат қатайтайық.
Dialogue: 0,0:22:43.71,0:22:44.71,Dialogue,,0,0,0,,Біз жасаймыз ба?
Dialogue: 0,0:22:44.45,0:22:45.18,*Default-ja,NTP,0,0,0,,Эй?
Dialogue: 0,0:24:15.10,0:24:19.72,staff,NTP,0,0,0,,Өндіріс: lastzzz Rest Cloud akira Akira
Dialogue: 0,0:24:15.19,0:24:16.93,Dialogue,,0,0,0,,Оның күнделікті өмірі:
Dialogue: 0,0:24:15.62,0:24:16.86,*Default-ja,NTP,0,0,0,,Оның күнделікті өмірі
