Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:07.88,0:01:08.67,Dialogue,,0,0,0,,Керемет...
Dialogue: 0,0:01:08.04,0:01:09.21,*Default-ja,NTP,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:01:08.95,0:01:10.75,Dialogue,,0,0,0,,Бұл Камизакура-мачи Гинзаға қарағанда салқынырақ.
Dialogue: 0,0:01:09.30,0:01:11.24,*Default-ja,NTP,0,0,0,,Камисакурамачи Гинзаға қарағанда ғажайып
Dialogue: 0,0:01:10.75,0:01:18.64,Dialogue,,0,0,0,,Мен ол туралы көп білмеймін, бірақ айналада басқа да қауіпті адамдар көп, сондықтан сақ болыңыз.
Dialogue: 0,0:01:11.36,0:01:13.01,*Default-ja,NTP,0,0,0,,Өйткені мен де жартысын білемін.
Dialogue: 0,0:01:13.09,0:01:15.18,*Default-ja,NTP,0,0,0,,Мен не болғанын нақты білмеймін.
Dialogue: 0,0:01:15.46,0:01:18.80,*Default-ja,NTP,0,0,0,,Бұл жерде басқа да қауіпті адамдар көп, сондықтан сақ болыңыз.
Dialogue: 0,0:01:18.64,0:01:20.65,Chat,,0,0,0,,Иә, мен оны бүгін көрдім.
Dialogue: 0,0:01:19.05,0:01:22.58,*Default-ja,NTP,0,0,0,,Айтпақшы, мен бүгін сол қара велосипедті көрдім.
Dialogue: 0,0:01:20.65,0:01:21.96,Chat,,0,0,0,,Мына қара велосипед.
Dialogue: 0,0:01:22.68,0:01:25.89,Dialogue,,0,0,0,,Бізде көптен бері жасөспірім қыз болмаған.
Dialogue: 0,0:01:22.94,0:01:26.24,*Default-ja,NTP,0,0,0,,Мен дәмді нәрсенің дәмін татып көрмегелі көп болды. Жасөспірім қыз
Dialogue: 0,0:01:25.89,0:01:27.52,Dialogue,,0,0,0,,Иә, біз алған ақпараттың арқасында.
Dialogue: 0,0:01:26.40,0:01:27.98,*Default-ja,NTP,0,0,0,,Ақпарат беруші мырза.
Dialogue: 0,0:01:27.98,0:01:32.57,Dialogue,,0,0,0,,Сол кезде мен қалтырап тұрғанымды байқадым.
Dialogue: 0,0:01:28.41,0:01:32.38,*Default-ja,NTP,0,0,0,,Сол кезде мен денемнің дірілдеп тұрғанын байқадым.
Dialogue: 0,0:01:58.89,0:02:04.82,Dialogue,,0,0,0,,Сіз қабылдаған шындық шынымен жалғыз ма?
Dialogue: 0,0:01:59.23,0:02:01.46,*Default-ja,NTP,0,0,0,,Сіз көріп отырған шындық
Dialogue: 0,0:02:02.31,0:02:04.48,*Default-ja,NTP,0,0,0,,Бұл шынымен де шынайы ма?
Dialogue: 0,0:02:05.35,0:02:09.14,Dialogue,,0,0,0,,Сіз ешқашан өзгермейтін декорация...
Dialogue: 0,0:02:05.66,0:02:08.41,*Default-ja,NTP,0,0,0,,Таныс пейзаж бұрынғысынша өзгеріссіз қалады.
Dialogue: 0,0:02:09.73,0:02:14.04,Dialogue,,0,0,0,,Баршаңызды оқуға түсуіңізбен құттықтаймыз.
Dialogue: 0,0:02:10.06,0:02:13.59,*Default-ja,NTP,0,0,0,,Барлығыңызды қабылдауыңызбен құттықтаймыз.
Dialogue: 0,0:02:14.04,0:02:19.70,Dialogue,,0,0,0,,Қазіргі уақытта туу деңгейінің төмендігі, байлар мен кедейлер арасындағы алшақтықтың кеңеюі сияқты жағымсыз тақырыптар барлық жапондықтардың аузында.
Dialogue: 0,0:02:14.16,0:02:19.45,*Default-ja,NTP,0,0,0,,Қазіргі уақытта Жапонияда туу деңгейінің төмендеуі және қоғам теңсіздігі сияқты көптеген қараңғы тақырыптар бар...
Dialogue: 0,0:02:19.70,0:02:25.33,Dialogue,,0,0,0,,Алайда, егер бұл адамдар осы рәсімде барлығына қарап тұрса, олар Жапонияның болашағы жарқын деген қорытындыға келетініне сенімдімін.
Dialogue: 0,0:02:19.83,0:02:22.84,*Default-ja,NTP,0,0,0,,Барлығыңызға қарап
Dialogue: 0,0:02:23.15,0:02:25.20,*Default-ja,NTP,0,0,0,,Бұл елдің болашағы жарқын
Dialogue: 0,0:02:25.33,0:02:30.04,Dialogue,,0,0,0,,Олар Жапонияны әлі де құтқаруға болатынына сенімді болар еді.
Dialogue: 0,0:02:25.54,0:02:29.83,*Default-ja,NTP,0,0,0,,Менің ойымша, Жапония әлі де жақсы жағдайда.
Dialogue: 0,0:02:30.04,0:02:31.50,*Default-ja,NTP,0,0,0,,Мен жігерлендім.
Dialogue: 0,0:02:30.04,0:02:31.54,Dialogue,,0,0,0,,Бұл оларға күш берер еді.
Dialogue: 0,0:02:31.54,0:02:35.80,Dialogue,,0,0,0,,Бұл күн бәріңнің есінде қалады. Дегенмен, сонымен бірге...
Dialogue: 0,0:02:32.04,0:02:35.02,*Default-ja,NTP,0,0,0,,Бүгін барлығына шуақты күн, бірақ...
Dialogue: 0,0:02:35.80,0:02:43.30,Dialogue,,0,0,0,,Сіз дәл қазір мұнда күнделікті оқиға болып жатқанына сенбейсіз бе?
Dialogue: 0,0:02:36.41,0:02:38.25,*Default-ja,NTP,0,0,0,,Барлық жерде күнделікті өмір
Dialogue: 0,0:02:38.61,0:02:43.01,*Default-ja,NTP,0,0,0,,Оның бүгінде осында таралып жатқанына сенбейсің бе?
Dialogue: 0,0:02:46.35,0:02:48.21,*Default-ja,NTP,0,0,0,,Рю... Бұл Микадо Рюгамин.
Dialogue: 0,0:02:46.60,0:02:48.90,Dialogue,,0,0,0,,Мен Рюгамин Микадомын.
Dialogue: 0,0:02:48.90,0:02:52.10,Dialogue,,0,0,0,,Токиоға жаңадан келген ұяң бала...
Dialogue: 0,0:02:49.19,0:02:52.48,*Default-ja,NTP,0,0,0,,Токиоға жаңа келген ұяң бала
Dialogue: 0,0:02:52.10,0:02:56.66,Dialogue,,0,0,0,,Мен Сонохара Анримін. Барлығыңызбен танысқаныма қуаныштымын.
Dialogue: 0,0:02:52.82,0:02:53.97,*Default-ja,NTP,0,0,0,,Бұл Анри Сонохара.
Dialogue: 0,0:02:54.80,0:02:56.26,*Default-ja,NTP,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:02:57.66,0:03:00.97,Dialogue,,0,0,0,,...біршама алшақ қыз.
Dialogue: 0,0:02:57.99,0:03:01.22,*Default-ja,NTP,0,0,0,,Дүниеден сәл алыстап кеткен қыз
Dialogue: 0,0:03:02.24,0:03:04.22,Dialogue,,0,0,0,,Мен Кида Масаомимін!
Dialogue: 0,0:03:02.76,0:03:03.95,*Default-ja,NTP,0,0,0,,Бұл Масамоми Кида!
Dialogue: 0,0:03:04.22,0:03:12.22,Dialogue,,0,0,0,,Мен ересек адам сияқты көрінетін шығармын, бірақ мен басқа он бес жасар бала сияқты нәзік және осалмын.
Dialogue: 0,0:03:04.47,0:03:07.06,*Default-ja,NTP,0,0,0,,Бұл ересектерге ұқсайды.
Dialogue: 0,0:03:07.49,0:03:09.10,*Default-ja,NTP,0,0,0,,Ішінде бәрі бірдей
Dialogue: 0,0:03:09.25,0:03:11.05,*Default-ja,NTP,0,0,0,,Сынғыш және оңай зақымдалады
Dialogue: 0,0:03:11.24,0:03:12.40,*Default-ja,NTP,0,0,0,,Мен 15 жастамын!
Dialogue: 0,0:03:12.22,0:03:14.83,Dialogue,,0,0,0,,Топта жалғыз бақытты болып көрінетін бала.
Dialogue: 0,0:03:12.66,0:03:15.09,*Default-ja,NTP,0,0,0,,Бір ғана бақытты бала
Dialogue: 0,0:03:14.83,0:03:18.64,Dialogue,,0,0,0,,Мен Камичика Риомын. Жыл жақсы өтеді деп үміттенемін.
Dialogue: 0,0:03:15.20,0:03:16.39,*Default-ja,NTP,0,0,0,,Бұл Рио Камичика.
Dialogue: 0,0:03:16.90,0:03:18.36,*Default-ja,NTP,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:03:18.64,0:03:21.76,Dialogue,,0,0,0,,Жұмбақ қыз;
Dialogue: 0,0:03:18.88,0:03:21.49,*Default-ja,NTP,0,0,0,,Қараңғы жағы бар қыз
Dialogue: 0,0:03:22.26,0:03:25.12,Dialogue,,0,0,0,,Айналаңызда осындай адамдар бар.
Dialogue: 0,0:03:22.50,0:03:25.68,*Default-ja,NTP,0,0,0,,Сіздің айналаңызда қандай адамдар бар
Dialogue: 0,0:03:25.12,0:03:27.59,Dialogue,,0,0,0,,Ух, Харима...
Dialogue: 0,0:03:26.12,0:03:27.02,*Default-ja,NTP,0,0,0,,Харима…
Dialogue: 0,0:03:28.12,0:03:30.43,Dialogue,,0,0,0,,Харима Мика осында ма?
Dialogue: 0,0:03:28.42,0:03:30.64,*Default-ja,NTP,0,0,0,,Мика Харима жоқ па?
Dialogue: 0,0:03:33.62,0:03:35.52,Dialogue,,0,0,0,,Жоқ, иә...
Dialogue: 0,0:03:34.15,0:03:35.79,*Default-ja,NTP,0,0,0,,Жоқ және
Dialogue: 0,0:03:35.52,0:03:39.76,Dialogue,,0,0,0,,Бұл кез келген адам бұрын көрген деп ант ете алатын қарапайым көрініс болды.
Dialogue: 0,0:03:36.12,0:03:39.68,*Default-ja,NTP,0,0,0,,Бұрын бір жерден көрген нәрсе сияқты көрінетін қарапайым көрініс.
Dialogue: 0,0:03:40.68,0:03:43.45,Dialogue,,0,0,0,,Әй, оқу жылын кешіккеннен бастаймыз ба?
Dialogue: 0,0:03:41.05,0:03:43.38,*Default-ja,NTP,0,0,0,,Ах~ Бірінші күннен кешігіп қалдыңыз ба?
Dialogue: 0,0:03:43.76,0:03:45.86,Dialogue,,0,0,0,,Біз өзімізді таныстырудың ортасындамыз.
Dialogue: 0,0:03:44.05,0:03:45.90,*Default-ja,NTP,0,0,0,,Мен қазір өзімді таныстырып жатырмын.
Dialogue: 0,0:03:45.86,0:03:47.45,Dialogue,,0,0,0,,Тұрған жеріңізден өзіңіздікін жасаңыз.
Dialogue: 0,0:03:46.03,0:03:47.72,*Default-ja,NTP,0,0,0,,Оны орнында орындаңыз
Dialogue: 0,0:03:47.45,0:03:51.90,Dialogue,,0,0,0,,Мен Ягири Сейджимін. Жыл жақсы өтеді деп үміттенемін.
Dialogue: 0,0:03:47.91,0:03:49.34,*Default-ja,NTP,0,0,0,,Бұл Сейджи Ягири.
Dialogue: 0,0:03:50.03,0:03:51.61,*Default-ja,NTP,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:03:52.73,0:04:00.93,Dialogue,,0,0,0,,Бірақ күтпеген оқиғалардың арқасында осы уақытқа дейін көзге көрінбейтін басқа шындық кейде қазіргіге назар аудара алады.
Dialogue: 0,0:03:53.03,0:03:55.60,*Default-ja,NTP,0,0,0,,Алайда, кездейсоқ
Dialogue: 0,0:03:55.95,0:04:00.75,*Default-ja,NTP,0,0,0,,Шындық бізге тағы бір белгісіз шындықтың көрінісін бере алады.
Dialogue: 0,0:04:00.93,0:04:04.96,Dialogue,,0,0,0,,Олай болса, Ягири, сен қазір отыра аласың.
Dialogue: 0,0:04:01.33,0:04:02.91,*Default-ja,NTP,0,0,0,,Кел, Ягири
Dialogue: 0,0:04:03.02,0:04:04.99,*Default-ja,NTP,0,0,0,,Орныңызға ерте отырыңыз.
Dialogue: 0,0:04:04.96,0:04:05.97,Dialogue,,0,0,0,,Маған қажет емес.
Dialogue: 0,0:04:05.24,0:04:06.32,*Default-ja,NTP,0,0,0,,Келмейді
Dialogue: 0,0:04:06.25,0:04:07.43,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:04:07.43,0:04:13.56,Dialogue,,0,0,0,,Мен мектепке біраз уақыт келемін деп ойламаймын — жоқ, енді ешқашан келмейтін шығармын.
Dialogue: 0,0:04:07.74,0:04:11.02,*Default-ja,NTP,0,0,0,,Біраз уақыт мектепке келе алмаймын деп ойлаймын.
Dialogue: 0,0:04:11.18,0:04:14.04,*Default-ja,NTP,0,0,0,,Жоқ, ол енді келмеуі мүмкін.
Dialogue: 0,0:04:13.56,0:04:14.81,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:04:14.81,0:04:16.88,Dialogue,,0,0,0,,Мен осыны айтайын деп келдім.
Dialogue: 0,0:04:15.24,0:04:16.79,*Default-ja,NTP,0,0,0,,Соны айтайын деп келдім.
Dialogue: 0,0:04:16.88,0:04:18.50,Dialogue,,0,0,0,,Онда оны киемін!
Dialogue: 0,0:04:17.11,0:04:18.19,*Default-ja,NTP,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:19.07,0:04:22.31,Dialogue,,0,0,0,,Эй, Ягири, бұл дүниеде не...
Dialogue: 0,0:04:19.49,0:04:22.45,*Default-ja,NTP,0,0,0,,Эй Ягири, бұл не...
Dialogue: 0,0:04:23.05,0:04:24.94,Dialogue,,0,0,0,,Бұл дәл солай.
Dialogue: 0,0:04:23.32,0:04:24.71,*Default-ja,NTP,0,0,0,,Бұл сізге де, маған да тиімді мәміле, иә?
Dialogue: 0,0:04:24.94,0:04:29.16,Dialogue,,0,0,0,,Бұл мен үшін өте маңызды нәрсе.
Dialogue: 0,0:04:25.22,0:04:29.10,*Default-ja,NTP,0,0,0,,Мен үшін бұл менің өмірімдегі өте маңызды нәрсе.
Dialogue: 0,0:04:29.16,0:04:32.33,Dialogue,,0,0,0,,Менің сіз сияқтылармен босқа кететін уақытым жоқ.
Dialogue: 0,0:04:29.51,0:04:32.11,*Default-ja,NTP,0,0,0,,Менің сендермен айналысатын уақытым жоқ.
Dialogue: 0,0:04:32.33,0:04:34.08,Dialogue,,0,0,0,,Өтінемін, кешіріңіз.
Dialogue: 0,0:04:32.76,0:04:33.80,*Default-ja,NTP,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:34.47,0:04:38.08,Dialogue,,0,0,0,,Ягири, күте тұр. Мен «күте тұрыңыз!» дедім.
Dialogue: 0,0:04:34.84,0:04:38.15,*Default-ja,NTP,0,0,0,,Ах... Эй Ягири, күт... күт.
Dialogue: 0,0:04:38.08,0:04:43.59,Dialogue,,0,0,0,,Бейбіт, күнделікті өмірінде кенеттен жарықтар пайда болғанда адамдар шошып кетеді.
Dialogue: 0,0:04:38.42,0:04:41.61,*Default-ja,NTP,0,0,0,,Бейбіт күнделікті өмірде кенеттен пайда болған жарықшақ
Dialogue: 0,0:04:41.88,0:04:43.62,*Default-ja,NTP,0,0,0,,адамдарды ренжітеді
Dialogue: 0,0:04:44.03,0:04:48.60,Dialogue,,0,0,0,,Мұндағы бір қыз әлгі жарықшақтарды қарап шықты.
Dialogue: 0,0:04:44.31,0:04:48.12,*Default-ja,NTP,0,0,0,,Бұл жерде де бір қыз бар екен...
Dialogue: 0,0:04:48.60,0:04:53.23,Dialogue,,0,0,0,,Ол екі күн бұрын қайтыс болуы керек еді.
Dialogue: 0,0:04:49.04,0:04:50.42,*Default-ja,NTP,0,0,0,,...
Dialogue: 0,0:04:50.60,0:04:53.12,*Default-ja,NTP,0,0,0,,Негізі екі күн бұрын өлуі керек еді.
Dialogue: 0,0:04:56.50,0:05:00.73,Dialogue,,0,0,0,,Бұл қыз да басқалар сияқты қарапайым отбасында дүниеге келген.
Dialogue: 0,0:04:56.89,0:05:00.71,*Default-ja,NTP,0,0,0,,Қыз қарапайым отбасында дүниеге келген.
Dialogue: 0,0:05:01.08,0:05:05.18,Dialogue,,0,0,0,,Оның өмірінде қиыншылықтар мен қолайсыздықтар болған жоқ.
Dialogue: 0,0:05:01.40,0:05:05.16,*Default-ja,NTP,0,0,0,,Күн сайын еш қиындықсыз және ыңғайсыздықсыз
Dialogue: 0,0:05:08.16,0:05:14.41,Dialogue,,0,0,0,,Алайда ол орта мектеп оқушысы болған кезде оның үйіне бірдеңе келді.
Dialogue: 0,0:05:08.24,0:05:11.18,*Default-ja,NTP,0,0,0,,Бірақ ол кіші мектеп оқушысы болған кезде
Dialogue: 0,0:05:11.54,0:05:14.81,*Default-ja,NTP,0,0,0,,Күтпеген жерден жеткізілді.
Dialogue: 0,0:05:21.00,0:05:22.75,Dialogue,,0,0,0,,Онда не болды?
Dialogue: 0,0:05:21.31,0:05:22.98,*Default-ja,NTP,0,0,0,,Онда не болды?
Dialogue: 0,0:05:22.75,0:05:24.52,Dialogue,,0,0,0,,Суреттер.
Dialogue: 0,0:05:23.28,0:05:24.37,*Default-ja,NTP,0,0,0,,Фото
Dialogue: 0,0:05:24.52,0:05:28.87,Dialogue,,0,0,0,,Әкем анамды алдап жүрген сияқты, олар оны басқа әйелмен көрсетеді.
Dialogue: 0,0:05:24.78,0:05:26.77,*Default-ja,NTP,0,0,0,,Менің әкем бір қылық болған сияқты.
Dialogue: 0,0:05:27.08,0:05:28.73,*Default-ja,NTP,0,0,0,,Әйелмен
Dialogue: 0,0:05:28.87,0:05:30.26,Dialogue,,0,0,0,,Сондай-ақ жазба да болды.
Dialogue: 0,0:05:29.17,0:05:30.25,*Default-ja,NTP,0,0,0,,Кейінгі хат
Dialogue: 0,0:05:30.55,0:05:33.27,Dialogue,,0,0,0,,"Сіз мұндай нәрсені кешіре аласыз ба?"
Dialogue: 0,0:05:30.80,0:05:33.60,*Default-ja,NTP,0,0,0,,"Бұл рұқсат етілген бе?"
Dialogue: 0,0:05:33.82,0:05:37.72,Dialogue,,0,0,0,,Оны әйелді білетін адам жіберген шығар.
Dialogue: 0,0:05:34.00,0:05:37.36,*Default-ja,NTP,0,0,0,,Оны жіберген адам әйелге қатысты сияқты.
Dialogue: 0,0:05:37.72,0:05:41.77,Dialogue,,0,0,0,,Әрине, сенің әкең сұмдық жасады, бірақ ол адам онша жақсы емес.
Dialogue: 0,0:05:38.14,0:05:41.62,*Default-ja,NTP,0,0,0,,Менің әкем қорқынышты, бірақ ол да қорқынышты.
Dialogue: 0,0:05:43.48,0:05:50.24,Dialogue,,0,0,0,,Мен не істерімді білмедім, сондықтан мен оларды жасыруды жөн көрдім.
Dialogue: 0,0:05:44.15,0:05:46.91,*Default-ja,NTP,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:05:47.32,0:05:50.30,*Default-ja,NTP,0,0,0,,Мен оны әзірше жасырайын деп шештім.
Dialogue: 0,0:05:51.24,0:05:57.95,Dialogue,,0,0,0,,Содан бері ата-анамның араласқанын көру қандай да бір дөрекі болып көрінетін.
Dialogue: 0,0:05:51.50,0:05:54.85,*Default-ja,NTP,0,0,0,,Сол күннен бастап көрініс біршама өзгерді.
Dialogue: 0,0:05:55.10,0:05:57.54,*Default-ja,NTP,0,0,0,,Бұл өте жиіркенішті болды...
Dialogue: 0,0:05:58.28,0:06:00.01,Dialogue,,0,0,0,,Бұл сізге қатты тиген болуы керек.
Dialogue: 0,0:05:58.65,0:05:59.85,*Default-ja,NTP,0,0,0,,Бұл қиын емес пе?
Dialogue: 0,0:06:00.01,0:06:02.09,Dialogue,,0,0,0,,Хм? Бірдеңе дұрыс емес пе, Рио?
Dialogue: 0,0:06:00.73,0:06:01.99,*Default-ja,NTP,0,0,0,,Иә? ше? Рио
Dialogue: 0,0:06:02.53,0:06:05.42,Dialogue,,0,0,0,,Тұтас алты ай бойы шыдадым.
Dialogue: 0,0:06:02.84,0:06:05.10,*Default-ja,NTP,0,0,0,,Жарты жылдай шыдадым.
Dialogue: 0,0:06:06.09,0:06:09.94,Dialogue,,0,0,0,,Мен бәрі ашық жерде болса жақсы болар еді деп ойладым.
Dialogue: 0,0:06:06.42,0:06:09.72,*Default-ja,NTP,0,0,0,,Мен бәрі түсінікті болса, оңайырақ болар еді деп ойладым...
Dialogue: 0,0:06:13.43,0:06:16.60,Dialogue,,0,0,0,,Осындай нәрселерге келгенде, өзіңізді қатты итермеу керек.
Dialogue: 0,0:06:13.88,0:06:16.64,*Default-ja,NTP,0,0,0,,Егер айту қиын болса, өзіңізді мәжбүрлемеңіз.
Dialogue: 0,0:06:17.47,0:06:20.85,Dialogue,,0,0,0,,Мен де айтқым келмейтін кейбір нәрселер бар.
Dialogue: 0,0:06:17.86,0:06:20.63,*Default-ja,NTP,0,0,0,,Кейбір нәрселерді айту қиынға соғады.
Dialogue: 0,0:06:20.85,0:06:21.56,Dialogue,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:06:21.10,0:06:23.52,*Default-ja,NTP,0,0,0,,Менде бәрі жақсы, білгеніңізді қалаймын.
Dialogue: 0,0:06:21.95,0:06:24.23,Dialogue,,0,0,0,,Мен оның білгенін қалаймын.
Dialogue: 0,0:06:26.32,0:06:29.68,Dialogue,,0,0,0,,Ұялы телефондарымызды тартып алғандарына сене алар емеспін!
Dialogue: 0,0:06:27.99,0:06:30.22,Secondary,,0,0,0,,Бірақ ештеңе өзгерген жоқ.
Dialogue: 0,0:06:28.35,0:06:29.96,*Default-ja,NTP,0,0,0,,Ештеңе өзгерген жоқ
Dialogue: 0,0:06:29.68,0:06:30.22,Dialogue,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:06:30.22,0:06:30.98,Dialogue,,0,0,0,,Мен ештеңе істей алмадым.
Dialogue: 0,0:06:30.98,0:06:37.02,Dialogue,,0,0,0,,Мен анам ештеңе айтпады ма, әлде мен жоқта сөйлесті ме, білмеймін.
Dialogue: 0,0:06:31.26,0:06:32.90,*Default-ja,NTP,0,0,0,,Анам үндемеді ме?
Dialogue: 0,0:06:33.21,0:06:36.89,*Default-ja,NTP,0,0,0,,Ата-анам мен білмей сөйледі ме, білмеймін.
Dialogue: 0,0:06:35.68,0:06:37.21,Secondary,,0,0,0,,Сенде де солай болды ғой, Рио?
Dialogue: 0,0:06:37.21,0:06:45.25,Dialogue,,0,0,0,,Әкемнің ақсақ әзілдері де, анамның пісірілген көкөністерінің тым тәтті дәмі де емес.
Dialogue: 0,0:06:37.47,0:06:41.60,*Default-ja,NTP,0,0,0,,Әкемнің қызықсыз әзілдері мен анамның тым тәтті пісірілген тағамы.
Dialogue: 0,0:06:42.04,0:06:45.20,*Default-ja,NTP,0,0,0,,Бәрібір ештеңе өзгерген жоқ.
Dialogue: 0,0:06:48.26,0:06:52.87,Dialogue,,0,0,0,,«Мен неге бұл дүниені тастап кетпеймін?» деп ойладым.
Dialogue: 0,0:06:48.88,0:06:52.82,*Default-ja,NTP,0,0,0,,Сондықтан мен жоғалып көрейін деп ойладым.
Dialogue: 0,0:06:55.56,0:06:59.52,Dialogue,,0,0,0,,Менің біраздан бері ойлағаным осы ғана.
Dialogue: 0,0:06:56.20,0:06:59.41,*Default-ja,NTP,0,0,0,,Мен бұл туралы соңғы уақытта көп ойлайтын болдым.
Dialogue: 0,0:07:00.94,0:07:04.02,Dialogue,,0,0,0,,Бұл маған қатты ұқсайды.
Dialogue: 0,0:07:01.35,0:07:03.76,*Default-ja,NTP,0,0,0,,Мен де солай сезінемін.
Dialogue: 0,0:07:04.02,0:07:07.32,Dialogue,,0,0,0,,Менің жағдайым сен сияқты жаман емес шығар, қызыл қызыл, бірақ...
Dialogue: 0,0:07:04.32,0:07:07.21,*Default-ja,NTP,0,0,0,,Бұл Magenta-san сияқты маңызды болмауы мүмкін.
Dialogue: 0,0:07:07.79,0:07:09.61,Dialogue,,0,0,0,,Не болды?
Dialogue: 0,0:07:08.11,0:07:09.45,*Default-ja,NTP,0,0,0,,Не болды?
Dialogue: 0,0:07:09.94,0:07:14.53,Dialogue,,0,0,0,,Мен біреумен кездесіп жүрдім, бірақ ол мұны әкеммен жасады...
Dialogue: 0,0:07:10.25,0:07:12.27,*Default-ja,NTP,0,0,0,,Мен кездесіп жүрген бір қыз бар еді.
Dialogue: 0,0:07:12.50,0:07:14.33,*Default-ja,NTP,0,0,0,,Мен оны әкеммен бірге жасадым
Dialogue: 0,0:07:14.53,0:07:15.73,Dialogue,,0,0,0,,Қандай қорқынышты.
Dialogue: 0,0:07:14.75,0:07:15.85,*Default-ja,NTP,0,0,0,,Қорқынышты...
Dialogue: 0,0:07:15.73,0:07:19.12,Dialogue,,0,0,0,,Бірақ, мен мүлде кешіре алмайтын адам – анам.
Dialogue: 0,0:07:16.03,0:07:19.25,*Default-ja,NTP,0,0,0,,Бірақ мен ең кешіре алмаған адамым анам болды.
Dialogue: 0,0:07:19.54,0:07:20.75,Dialogue,,0,0,0,,Ол не деді?
Dialogue: 0,0:07:19.85,0:07:21.22,*Default-ja,NTP,0,0,0,,Олар не айтты?
Dialogue: 0,0:07:21.45,0:07:26.54,Dialogue,,0,0,0,,«Мұндай жағдай үнемі болады, егер сіз бұл туралы үлкен мәміле жасасаңыз, біз жай ғана беделімізді жоғалтамыз».
Dialogue: 0,0:07:21.76,0:07:23.30,*Default-ja,NTP,0,0,0,,Бұл кең таралған
Dialogue: 0,0:07:23.56,0:07:26.44,*Default-ja,NTP,0,0,0,,Сыйлылығың бар деп шу шығарма.
Dialogue: 0,0:07:26.54,0:07:29.98,Dialogue,,0,0,0,,Ол өзінің сезімі туралы ештеңе айтпады.
Dialogue: 0,0:07:26.92,0:07:29.48,*Default-ja,NTP,0,0,0,,Мен ойлағанымды ешқашан айтқан емеспін.
Dialogue: 0,0:07:29.98,0:07:35.66,Dialogue,,0,0,0,,Ал...Менің ойымша, бұл менің отбасымыздың бейнесі менен маңыздырақ екенін білдіреді.
Dialogue: 0,0:07:30.17,0:07:35.16,*Default-ja,NTP,0,0,0,,Менің ойымша, бұл сенің сыртқы түрің маған қарағанда маңыздырақ дегенді білдіреді.
Dialogue: 0,0:07:35.66,0:07:40.77,Dialogue,,0,0,0,,Бірақ, менің ойымша, ол менің болашағым туралы ойлаған болар...
Dialogue: 0,0:07:35.93,0:07:40.80,*Default-ja,NTP,0,0,0,,Бірақ ол да менің болашағымды ойлағандықтан шығар.
Dialogue: 0,0:07:40.77,0:07:42.27,Dialogue,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:07:41.15,0:07:42.35,*Default-ja,NTP,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:07:42.27,0:07:43.73,Dialogue,,0,0,0,,Рабу
Dialogue: 0,0:07:42.61,0:07:43.68,*Default-ja,NTP,0,0,0,,Солай ма?
Dialogue: 0,0:07:43.73,0:07:46.93,Dialogue,,0,0,0,,Ол сені мүлде ойламайды, Накура.
Dialogue: 0,0:07:43.98,0:07:47.01,*Default-ja,NTP,0,0,0,,Мен Накура-сан туралы мүлде ойламаймын.
Dialogue: 0,0:07:46.93,0:07:49.37,Dialogue,,0,0,0,,Ол тек өзін ойлап отыр!
Dialogue: 0,0:07:47.19,0:07:49.21,*Default-ja,NTP,0,0,0,,Сіз тек өзіңіз туралы ойлайсыз
Dialogue: 0,0:07:50.03,0:07:52.49,Dialogue,,0,0,0,,Кешкі ас дайын.
Dialogue: 0,0:07:50.33,0:07:52.12,*Default-ja,NTP,0,0,0,,Тамақ дайын.
Dialogue: 0,0:07:52.49,0:07:54.03,Dialogue,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:07:52.80,0:07:53.80,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:07:58.06,0:08:02.53,Dialogue,,0,0,0,,Қызғылт ханым, біз неге бірге жоғалып кетпейміз?
Dialogue: 0,0:08:02.53,0:08:08.46,Dialogue,,0,0,0,,Екеуміз де өлсек, біздің сезімімізді түсінетін шығар.
Dialogue: 0,0:08:02.81,0:08:05.43,*Default-ja,NTP,0,0,0,,Күлгін екеуміз бірге өлсек ше?
Dialogue: 0,0:08:05.90,0:08:08.23,*Default-ja,NTP,0,0,0,,Ұнамаса да түсінеді деп ойлаймын.
Dialogue: 0,0:08:08.46,0:08:12.05,Dialogue,,0,0,0,,Және олар шын мәнінде нені көбірек бағалауы керек.
Dialogue: 0,0:08:08.73,0:08:11.96,*Default-ja,NTP,0,0,0,,Шын мәнінде не маңызды болды?
Dialogue: 0,0:08:15.24,0:08:20.43,Dialogue,,0,0,0,,Бұл қазір ақымақ ой сияқты көрінеді, бірақ ол кеткенде солай сезінді.
Dialogue: 0,0:08:15.54,0:08:17.95,*Default-ja,NTP,0,0,0,,Қазір ойлап қарасам, бұл ақымақтық еді.
Dialogue: 0,0:08:18.12,0:08:20.56,*Default-ja,NTP,0,0,0,,Қыз әлдебір сезіммен сыртқа шықты.
Dialogue: 0,0:08:21.01,0:08:29.51,Dialogue,,0,0,0,,Оны Накураның сөздері итермелеп, өзі сияқты ойлайтын адамды кездестіргісі келді.
Dialogue: 0,0:08:21.28,0:08:23.92,*Default-ja,NTP,0,0,0,,Себебі мен Накураның сөзінен күшті сезіндім
Dialogue: 0,0:08:24.32,0:08:29.90,*Default-ja,NTP,0,0,0,,Себебі, мен сияқты ойлайтын адамдардың жүзін көргім келді.
Dialogue: 0,0:08:30.41,0:08:35.55,Dialogue,,0,0,0,,Ол алданып жатса да, оның жоғалтатын ештеңесі жоқ еді.
Dialogue: 0,0:08:30.72,0:08:32.77,*Default-ja,NTP,0,0,0,,Өтірік болса да
Dialogue: 0,0:08:32.98,0:08:35.28,*Default-ja,NTP,0,0,0,,Менің жоғалтатын ештеңем жоқ
Dialogue: 0,0:08:34.57,0:08:36.78,Secondary,,0,0,0,,Мен қыздармен жақсы қарым-қатынастамын, сондықтан...
Dialogue: 0,0:08:35.55,0:08:36.78,Dialogue,,0,0,0,,Немесе ол сенді.
Dialogue: 0,0:08:35.89,0:08:37.44,*Default-ja,NTP,0,0,0,,Бұл болуы керек еді
Dialogue: 0,0:08:42.00,0:08:43.51,Dialogue,,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:08:42.23,0:08:43.17,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:08:43.51,0:08:45.00,Dialogue,,0,0,0,,Сіз «Қызыл қызылсың ба?»
Dialogue: 0,0:08:43.76,0:08:44.88,*Default-ja,NTP,0,0,0,,Қып-қызыл мырза?
Dialogue: 0,0:08:45.00,0:08:46.17,Dialogue,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:08:45.23,0:08:46.06,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:08:46.17,0:08:48.43,Dialogue,,0,0,0,,О, сонда сен "Накурасың ба?"
Dialogue: 0,0:08:46.36,0:08:48.58,*Default-ja,NTP,0,0,0,,А, сен Накура-сансың ба?
Dialogue: 0,0:08:48.43,0:08:51.48,Dialogue,,0,0,0,,Керемет! I knew it was you.
Dialogue: 0,0:08:48.68,0:08:51.53,*Default-ja,NTP,0,0,0,,Жақсы!
Dialogue: 0,0:08:48.85,0:08:51.48,Secondary,,0,0,0,,Оның бетін көрген бойда...
Dialogue: 0,0:08:49.21,0:08:51.39,*Default-ja,NTP,0,0,0,,Сенің жүзіңді көргенде солай ойладым
Dialogue: 0,0:08:51.48,0:08:53.04,Dialogue,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:08:51.48,0:08:54.88,Secondary,,0,0,0,,«Бұл Накура емес пе?» деп ойлады.
Dialogue: 0,0:08:51.84,0:08:54.81,*Default-ja,NTP,0,0,0,,Бұл адам Накура емес пе?
Dialogue: 0,0:08:53.04,0:08:54.13,Dialogue,,0,0,0,,Маған қамқорлық жасаңыз.
Dialogue: 0,0:08:54.88,0:08:56.74,Secondary,,0,0,0,,Сізбен де танысқаныма қуаныштымын.
Dialogue: 0,0:08:54.88,0:09:01.75,Dialogue,,0,0,0,,Бірақ ол оның соңынан ерді, өйткені ол артқа бұрылса, өзін кешіре алмайды.
Dialogue: 0,0:08:55.62,0:08:57.56,*Default-ja,NTP,0,0,0,,Сонда да мен соңынан ердім
Dialogue: 0,0:08:56.74,0:08:58.75,Secondary,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:08:57.84,0:09:01.39,*Default-ja,NTP,0,0,0,,Өйткені мен мұнда қашып кеткенімді кешіре алмаймын деп ойладым.
Dialogue: 0,0:08:59.90,0:09:01.13,Secondary,,0,0,0,,Жарайды...
Dialogue: 0,0:09:14.03,0:09:16.44,Dialogue,,0,0,0,,Сондықтан, тіпті бұл болған кезде де...
Dialogue: 0,0:09:14.44,0:09:16.62,*Default-ja,NTP,0,0,0,,Сонымен, бұл шынымен болған кезде де...
Dialogue: 0,0:09:16.44,0:09:17.78,Dialogue,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:09:16.85,0:09:17.77,*Default-ja,NTP,0,0,0,,Сәлем
Dialogue: 0,0:09:18.33,0:09:19.57,Dialogue,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:09:18.64,0:09:19.57,*Default-ja,NTP,0,0,0,,Сәлем
Dialogue: 0,0:09:19.57,0:09:21.26,Dialogue,,0,0,0,,Біз түсініктіміз бе?
Dialogue: 0,0:09:19.83,0:09:21.00,*Default-ja,NTP,0,0,0,,Айналаңызда бәрі жақсы ма?
Dialogue: 0,0:09:21.26,0:09:23.61,Dialogue,,0,0,0,,Айналада ешкім жоқ.
Dialogue: 0,0:09:21.45,0:09:23.55,*Default-ja,NTP,0,0,0,,Бірде-бір адам қалмады.
Dialogue: 0,0:09:23.61,0:09:26.75,Dialogue,,0,0,0,,Олай болса, сізді алдағаным үшін кешіріңіз!
Dialogue: 0,0:09:23.92,0:09:27.85,*Default-ja,NTP,0,0,0,,Сонда сен мені алдадың...
Dialogue: 0,0:09:25.56,0:09:28.50,Secondary,,0,0,0,,Ол таңданыс, наразылық, өкініш сияқты эмоцияларға толы болды...
Dialogue: 0,0:09:25.92,0:09:28.48,*Default-ja,NTP,0,0,0,,Таңдану, қарсылық және өкініш
Dialogue: 0,0:09:28.50,0:09:34.47,Dialogue,,0,0,0,,Бірақ ол есінен танып кетер алдында...
Dialogue: 0,0:09:29.05,0:09:31.14,*Default-ja,NTP,0,0,0,,Various thoughts have come and gone, but
Dialogue: 0,0:09:31.49,0:09:33.98,*Default-ja,NTP,0,0,0,,Есімнен танып қалар алдында осылай ойладым.
Dialogue: 0,0:09:34.47,0:09:40.92,Dialogue,,0,0,0,,«Бұл менің тағдырым. Уақыт келді».
Dialogue: 0,0:09:34.84,0:09:36.40,*Default-ja,NTP,0,0,0,,Бұл тағдыр
Dialogue: 0,0:09:36.84,0:09:40.62,*Default-ja,NTP,0,0,0,,Осы кезеңде өзіңізге күтім жасаудың қажеттілігі қандай?
Dialogue: 0,0:09:40.92,0:09:46.52,Dialogue,,0,0,0,,«Мен бұл дүниеден... ешкім білмей ғайып боламын».
Dialogue: 0,0:09:41.20,0:09:43.68,*Default-ja,NTP,0,0,0,,Дүниеден кенет жоғалып кету
Dialogue: 0,0:09:44.15,0:09:46.33,*Default-ja,NTP,0,0,0,,Қалай болса да, ешкім білмейді
Dialogue: 0,0:09:47.31,0:09:48.90,Dialogue,,0,0,0,,Қазір тек екеуміз ғана қалдық.
Dialogue: 0,0:09:47.64,0:09:48.72,*Default-ja,NTP,0,0,0,,Бірақ...
Dialogue: 0,0:10:01.53,0:10:04.48,Dialogue,,0,0,0,,Сіз осындай жерде жалғызсыз ба?
Dialogue: 0,0:10:01.88,0:10:04.05,*Default-ja,NTP,0,0,0,,Мұнда бір ғана адам бар.
Dialogue: 0,0:10:08.13,0:10:12.38,Dialogue,,0,0,0,,Ол ес-түссіз жатқанда, әлем әлі қозғалып жатты...
Dialogue: 0,0:10:08.50,0:10:11.20,*Default-ja,NTP,0,0,0,,Қыз ес-түссіз жатқанда
Dialogue: 0,0:10:11.38,0:10:12.67,*Default-ja,NTP,0,0,0,,Дүние қозғалады
Dialogue: 0,0:10:13.61,0:10:16.72,Dialogue,,0,0,0,,Бұл жұмыс соншалықты қиын емес сияқты.
Dialogue: 0,0:10:13.89,0:10:17.35,*Default-ja,NTP,0,0,0,,Бұл соншалықты қиын жұмыс емес сияқты.
Dialogue: 0,0:10:17.93,0:10:20.18,Dialogue,,0,0,0,,Дегенмен, сақ болыңыз.
Dialogue: 0,0:10:18.20,0:10:19.44,*Default-ja,NTP,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:10:24.15,0:10:27.89,Dialogue,,0,0,0,,Оның ойлары мен тілектеріне алаңдамай.
Dialogue: 0,0:10:24.58,0:10:27.95,*Default-ja,NTP,0,0,0,,Оның ойына немесе еркіне қарамастан
Dialogue: 0,0:10:54.79,0:10:56.25,Dialogue,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:10:55.40,0:10:58.95,*Default-ja,NTP,0,0,0,,Бұл жақсы емес... Мен ақша жинай алмаймын...
Dialogue: 0,0:10:56.25,0:10:59.22,Dialogue,,0,0,0,,Мен мұндай ақшаны жинай алмаймын.
Dialogue: 0,0:10:59.22,0:11:01.47,Dialogue,,0,0,0,,Мен оны қайтармаймын деп жатқан жоқпын.
Dialogue: 0,0:10:59.56,0:11:01.44,*Default-ja,NTP,0,0,0,,Мен оны қайтармаймын деп айтпаймын.
Dialogue: 0,0:11:01.47,0:11:06.74,Dialogue,,0,0,0,,Бірақ, егер маған бірдеңе болса, Авакусу қауымдастығының өкілі Шики мырзаның үндемейтінін білмеймін.
Dialogue: 0,0:11:01.63,0:11:03.54,*Default-ja,NTP,0,0,0,,Бірақ маған бірдеңе болса
Dialogue: 0,0:11:03.70,0:11:07.20,*Default-ja,NTP,0,0,0,,Авакусу-кайдағы Йоцуки мырза бұл туралы үндемей ме деп ойлаймын.
Dialogue: 0,0:11:06.74,0:11:07.81,Dialogue,,0,0,0,,Сен кәрі лүпіл!
Dialogue: 0,0:11:07.24,0:11:08.05,*Default-ja,NTP,0,0,0,,Қария
Dialogue: 0,0:11:07.81,0:11:09.29,Dialogue,,0,0,0,,Менің бұған уақытым жоқ.
Dialogue: 0,0:11:08.13,0:11:09.50,*Default-ja,NTP,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:11:09.29,0:11:15.27,Dialogue,,0,0,0,,Менің қолым бос емес; Мен өмірімнің 2,5 минуттан артық уақытын сенімен өткізгім келмейді!
Dialogue: 0,0:11:09.58,0:11:10.89,*Default-ja,NTP,0,0,0,,Мен бос емес сияқтымын.
Dialogue: 0,0:11:11.04,0:11:13.25,*Default-ja,NTP,0,0,0,,Өмірімде саған арнаған уақытым
Dialogue: 0,0:11:13.47,0:11:15.51,*Default-ja,NTP,0,0,0,,Бізде екі жарым минуттай ғана уақыт қалды!!
Dialogue: 0,0:11:18.03,0:11:19.50,Dialogue,,0,0,0,,О, тағы бір жігіт сен...
Dialogue: 0,0:11:18.28,0:11:19.52,*Default-ja,NTP,0,0,0,,Басқа адам...
Dialogue: 0,0:11:19.50,0:11:20.45,Dialogue,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:11:33.34,0:11:39.09,Dialogue,,0,0,0,,Эй, мен сен сияқты тамаша курьерді еске түсіруім керек деп ойлаймын, бірақ...
Dialogue: 0,0:11:33.77,0:11:36.87,*Default-ja,NTP,0,0,0,,Сіз сияқты тамаша курьер үшін.
Dialogue: 0,0:11:37.11,0:11:39.25,*Default-ja,NTP,0,0,0,,Бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:11:39.83,0:11:42.14,Dialogue,,0,0,0,,Мен сенен сұрағанымнан артық ештеңе істеудің қажеті жоқ.
Dialogue: 0,0:11:40.10,0:11:42.03,*Default-ja,NTP,0,0,0,,Мен сұрағаннан артық істеудің қажеті жоқ.
Dialogue: 0,0:11:42.14,0:11:45.60,Dialogue,,0,0,0,,Басқа жігіттерді сәл шатастырыңыз.
Dialogue: 0,0:11:42.31,0:11:45.56,*Default-ja,NTP,0,0,0,,Ол жақтағы жігіттер өз қалауынша қарауы керек.
Dialogue: 0,0:11:45.60,0:11:47.51,Dialogue,,0,0,0,,Қалай болғанда да, мен саған сенемін!
Dialogue: 0,0:11:46.03,0:11:47.47,*Default-ja,NTP,0,0,0,,Олай болса, танысқаныма қуаныштымын.
Dialogue: 0,0:11:48.83,0:11:51.12,Dialogue,,0,0,0,,Дүние қозғалады.
Dialogue: 0,0:11:49.26,0:11:50.68,*Default-ja,NTP,0,0,0,,Дүние қозғалады
Dialogue: 0,0:11:51.12,0:11:56.11,Dialogue,,0,0,0,,Қыз өз тағдыры өтірік деп сенген бағытта болуы міндетті емес.
Dialogue: 0,0:11:51.40,0:11:53.89,*Default-ja,NTP,0,0,0,,Қыздың сенгені – тағдыр
Dialogue: 0,0:11:54.05,0:11:56.09,*Default-ja,NTP,0,0,0,,Бағытты аздап өзгерту кезінде
Dialogue: 0,0:11:56.11,0:11:57.53,Dialogue,,0,0,0,,Та-да!
Dialogue: 0,0:12:17.54,0:12:20.55,Dialogue,,0,0,0,,Кім-Не деген сұмсың?!
Dialogue: 0,0:12:18.88,0:12:21.82,*Default-ja,NTP,0,0,0,,Не... бұл не?!
Dialogue: 0,0:13:00.32,0:13:07.07,Dialogue,,0,0,0,,Онда: «Сені белгілі бір жерге апарамын деп бұйырды» деп жазылған.
Dialogue: 0,0:13:00.86,0:13:06.62,*Default-ja,NTP,0,0,0,,Онда: ''Мен сені белгілі бір жерге жеткізуді сұрадым'' деп жазылған.
Dialogue: 0,0:13:07.07,0:13:12.32,Dialogue,,0,0,0,,Велосипед қозғалған кезде дыбыс шығармады, бірақ кейде жылқы сияқты қыңырлайды.
Dialogue: 0,0:13:07.44,0:13:09.38,*Default-ja,NTP,0,0,0,,Велосипед үнсіз жүгіреді
Dialogue: 0,0:13:09.57,0:13:11.85,*Default-ja,NTP,0,0,0,,Кейде жылқыдай иіскейтін.
Dialogue: 0,0:13:12.32,0:13:16.14,Dialogue,,0,0,0,,Ол шындыққа мүлдем ұқсамайды.
Dialogue: 0,0:13:12.58,0:13:15.43,*Default-ja,NTP,0,0,0,,Бұл шынайы емес сияқты болды.
Dialogue: 0,0:13:16.14,0:13:20.91,Dialogue,,0,0,0,,Дегенмен, дененің оған қысым жасағанын сезінуі сөзсіз шынайы болды.
Dialogue: 0,0:13:16.28,0:13:18.83,*Default-ja,NTP,0,0,0,,Бірақ бұл дененің сезімі
Dialogue: 0,0:13:19.04,0:13:20.94,*Default-ja,NTP,0,0,0,,Бұл сөзсіз шындық еді.
Dialogue: 0,0:13:21.60,0:13:25.51,Dialogue,,0,0,0,,Қыз сол жылылықтың арғы жағындағы адам туралы ойлады.
Dialogue: 0,0:13:21.88,0:13:25.29,*Default-ja,NTP,0,0,0,,Қыз жылылықтың арғы жағында не жатыр деп ойлады.
Dialogue: 0,0:13:25.51,0:13:30.16,Dialogue,,0,0,0,,Олар не ойлайды? Олар не біледі? Олардың өмірі қандай болды?
Dialogue: 0,0:13:25.76,0:13:27.96,*Default-ja,NTP,0,0,0,,Нені ойлап, нені білу керек
Dialogue: 0,0:13:28.13,0:13:29.93,*Default-ja,NTP,0,0,0,,Сіз өз өміріңізді қалай өткіздіңіз?
Dialogue: 0,0:13:30.16,0:13:33.87,Dialogue,,0,0,0,,Бұл кісінің көзіне ол қандай көрінді?
Dialogue: 0,0:13:30.62,0:13:34.23,*Default-ja,NTP,0,0,0,,Мен бұл адамға қалай көрінемін?
Dialogue: 0,0:13:40.15,0:13:42.15,Dialogue,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:13:40.46,0:13:41.70,*Default-ja,NTP,0,0,0,,Түсінікті
Dialogue: 0,0:14:32.57,0:14:34.26,Dialogue,,0,0,0,,Қызғылт қызғылт ханым!
Dialogue: 0,0:14:33.09,0:14:34.26,*Default-ja,NTP,0,0,0,,Қып-қызыл мырза!
Dialogue: 0,0:14:39.57,0:14:41.27,Dialogue,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:14:39.83,0:14:42.58,*Default-ja,NTP,0,0,0,,Танысқаныма қуаныштымын, мен Накурамын.
Dialogue: 0,0:14:41.27,0:14:42.27,Dialogue,,0,0,0,,Мен Накурамын.
Dialogue: 0,0:14:42.84,0:14:44.73,Dialogue,,0,0,0,,Сіз шынымен Накурасыз ба?
Dialogue: 0,0:14:43.02,0:14:44.89,*Default-ja,NTP,0,0,0,,Накура-сан шынымен бе?
Dialogue: 0,0:14:44.73,0:14:47.53,Dialogue,,0,0,0,,Мен жай ғана жоғалып кеткісі келетін Накурамын.
Dialogue: 0,0:14:45.15,0:14:47.69,*Default-ja,NTP,0,0,0,,Бұл мүлдем жоғалып кеткісі келетін Накура.
Dialogue: 0,0:14:49.03,0:14:50.91,Dialogue,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:14:49.61,0:14:50.81,*Default-ja,NTP,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:14:50.91,0:14:55.00,Dialogue,,0,0,0,,Мені құтқарған сенсің бе?
Dialogue: 0,0:14:51.12,0:14:54.67,*Default-ja,NTP,0,0,0,,Саған көмектескен Нагура-сан болды ма?
Dialogue: 0,0:14:55.00,0:14:57.20,Dialogue,,0,0,0,,Иә, бұл менмін.
Dialogue: 0,0:14:55.19,0:14:56.74,*Default-ja,NTP,0,0,0,,Иә, бұл менмін.
Dialogue: 0,0:14:57.20,0:14:59.04,Dialogue,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:14:57.47,0:14:58.95,*Default-ja,NTP,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:59.04,0:15:01.33,Dialogue,,0,0,0,,Сен қорқтың ба?
Dialogue: 0,0:14:59.55,0:15:00.88,*Default-ja,NTP,0,0,0,,...
Dialogue: 0,0:15:01.33,0:15:02.70,Dialogue,,0,0,0,,Иә...
Dialogue: 0,0:15:01.78,0:15:02.69,*Default-ja,NTP,0,0,0,,Иә...
Dialogue: 0,0:15:02.70,0:15:04.04,Dialogue,,0,0,0,,Саған қиын болған шығар.
Dialogue: 0,0:15:02.98,0:15:04.16,*Default-ja,NTP,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:15:04.04,0:15:05.50,Dialogue,,0,0,0,,Иә...
Dialogue: 0,0:15:05.99,0:15:08.38,Dialogue,,0,0,0,,Бірақ, сен қайдан білдің?
Dialogue: 0,0:15:06.28,0:15:08.32,*Default-ja,NTP,0,0,0,,...
Dialogue: 0,0:15:08.38,0:15:13.39,Dialogue,,0,0,0,,Себебі сізді ұрлап әкеткен менмін, қызғылт ханым.
Dialogue: 0,0:15:08.68,0:15:13.28,*Default-ja,NTP,0,0,0,,Өйткені мен оларға Қызыл қызды ұрлап кетіңдер деп айтқан адам едім.
Dialogue: 0,0:15:14.76,0:15:17.77,Dialogue,,0,0,0,,Мен де сені құтқарған адаммын.
Dialogue: 0,0:15:14.93,0:15:18.00,*Default-ja,NTP,0,0,0,,Маған көмектесу үшін жолыңнан шығып кет деген мен едім.
Dialogue: 0,0:15:18.93,0:15:20.52,Dialogue,,0,0,0,,Түсінбедім...
Dialogue: 0,0:15:19.30,0:15:20.59,*Default-ja,NTP,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:20.52,0:15:29.01,Dialogue,,0,0,0,,Сіз өзіңізді өлтірмек болдыңыз, бірақ ұрланғанда қорқып қалғаныңызға өкіндіңіз...
Dialogue: 0,0:15:20.95,0:15:23.89,*Default-ja,NTP,0,0,0,,Мен өлемін деп ойладым, бірақ мені ұрлап кетті.
Dialogue: 0,0:15:24.08,0:15:26.53,*Default-ja,NTP,0,0,0,,Мен бұл жерде не нәрседен қорқып кеттім деп ойладым.
Dialogue: 0,0:15:26.58,0:15:28.91,*Default-ja,NTP,0,0,0,,Мен аздап өкінемін.
Dialogue: 0,0:15:29.01,0:15:32.56,Dialogue,,0,0,0,,Бірақ, егер сіз қарсылық көрсетсеңіз, онда сіз өлуге деген ерік-жігеріңізге қайшы болған боларсыз...
Dialogue: 0,0:15:29.19,0:15:30.31,*Default-ja,NTP,0,0,0,,Бірақ егер сіз қарсылық көрсетсеңіз
Dialogue: 0,0:15:30.39,0:15:32.64,*Default-ja,NTP,0,0,0,,Өйткені сіз өлетін адамнан бас тартасыз.
Dialogue: 0,0:15:32.56,0:15:40.29,Dialogue,,0,0,0,,Осылайша сіз мұны өз тағдырыңыз ретінде қабылдауды шештіңіз, бірақ құтқарылғаныңыз үшін шын мәнінде жеңілдіңіз.
Dialogue: 0,0:15:32.78,0:15:36.70,*Default-ja,NTP,0,0,0,,Мен бұл менің тағдырым деп ойладым және оны жай ғана қабылдаймын деп ойладым.
Dialogue: 0,0:15:36.89,0:15:40.06,*Default-ja,NTP,0,0,0,,Бірақ маған көмектесетін болса, мен жеңілдеп қалар едім.
Dialogue: 0,0:15:40.84,0:15:43.79,Dialogue,,0,0,0,,Осының бәрінен кейін сіздің жүзіңіздегі өрнекті көргім келді.
Dialogue: 0,0:15:41.08,0:15:44.02,*Default-ja,NTP,0,0,0,,Себебі мен сенің жүзіңді осылай көргім келді
Dialogue: 0,0:15:45.38,0:15:50.88,Dialogue,,0,0,0,,Қарапайым тілмен айтқанда, мен сенің не ойлап тұрғаныңды біліп, сені үнсіз қалдырғаннан кейін сіздің сөзіңізді көргім келді.
Dialogue: 0,0:15:45.41,0:15:48.33,*Default-ja,NTP,0,0,0,,Бір сөзбен айтқанда, барлығы көзге түсті.
Dialogue: 0,0:15:48.45,0:15:50.96,*Default-ja,NTP,0,0,0,,Себебі мен сенің тілсіз жүзіңді көргім келді
Dialogue: 0,0:15:52.79,0:15:54.25,Dialogue,,0,0,0,,Неліктен...?
Dialogue: 0,0:15:53.27,0:15:54.40,*Default-ja,NTP,0,0,0,,Неліктен?
Dialogue: 0,0:15:54.25,0:15:55.48,Dialogue,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:15:54.52,0:15:55.55,*Default-ja,NTP,0,0,0,,Неліктен?
Dialogue: 0,0:15:55.48,0:15:56.69,Dialogue,,0,0,0,,Адам, ол қандай ұлт болуы керек еді?
Dialogue: 0,0:15:55.72,0:15:56.82,*Default-ja,NTP,0,0,0,,Дұрыс.
Dialogue: 0,0:15:56.69,0:16:01.80,Dialogue,,0,0,0,,Менің жауабым сізге өте философиялық болып көрінеді деп ойлаймын.
Dialogue: 0,0:15:57.01,0:16:01.78,*Default-ja,NTP,0,0,0,,Менің ойымша, бұл сұрақтың жауабы сізге өте философиялық болып көрінеді.
Dialogue: 0,0:16:01.80,0:16:06.35,Dialogue,,0,0,0,,Сонымен, мұндай түсініктемелерден аулақ болу үшін мен тек адамдарды жақсы көретіндіктен айтайын.
Dialogue: 0,0:16:02.07,0:16:03.81,*Default-ja,NTP,0,0,0,,...
Dialogue: 0,0:16:04.19,0:16:06.27,*Default-ja,NTP,0,0,0,,Менің ойымша, бұл маған адамдарды ұнататынын білдіреді.
Dialogue: 0,0:16:06.35,0:16:10.53,Dialogue,,0,0,0,,Адамдар сондай қызық, сондай қызық.
Dialogue: 0,0:16:06.60,0:16:08.30,*Default-ja,NTP,0,0,0,,...
Dialogue: 0,0:16:08.42,0:16:10.74,*Default-ja,NTP,0,0,0,,Маған қызық көрінбесе амалым жоқ.
Dialogue: 0,0:16:10.85,0:16:15.49,Dialogue,,0,0,0,,О, бірақ мен адамдарды жақсы көремін, әсіресе сені емес.
Dialogue: 0,0:16:11.88,0:16:16.79,*Default-ja,NTP,0,0,0,,А, мен сені емес, адамдарды жақсы көремін, сондықтан бұл маңызды.
Dialogue: 0,0:16:15.49,0:16:17.03,Dialogue,,0,0,0,,Бұл маңызды бөлік.
Dialogue: 0,0:16:19.86,0:16:22.12,Dialogue,,0,0,0,,Бұл...бәрі өтірік болды...?
Dialogue: 0,0:16:20.22,0:16:21.99,*Default-ja,NTP,0,0,0,,Мұның бәрі өтірік болды ма?
Dialogue: 0,0:16:22.12,0:16:25.00,Dialogue,,0,0,0,,Сіз өз рөліңізді түсіндіңіз бе?
Dialogue: 0,0:16:22.56,0:16:25.09,*Default-ja,NTP,0,0,0,,Сіз өз ұстанымыңызды түсіндіңіз бе?
Dialogue: 0,0:16:25.40,0:16:26.58,Dialogue,,0,0,0,,Келіңіздер.
Dialogue: 0,0:16:25.71,0:16:26.55,*Default-ja,NTP,0,0,0,,Келіңіздер
Dialogue: 0,0:16:33.80,0:16:37.83,Dialogue,,0,0,0,,Бұл ғимараттан көптеген адамдар секірді.
Dialogue: 0,0:16:34.01,0:16:37.64,*Default-ja,NTP,0,0,0,,Мұнда бірнеше адам секіреді.
Dialogue: 0,0:16:37.83,0:16:43.05,Dialogue,,0,0,0,,Оны атақты ету жеткіліксіз, бірақ бұл жерден секірсең, міндетті түрде өлесің деп естідім.
Dialogue: 0,0:16:38.05,0:16:40.09,*Default-ja,NTP,0,0,0,,Әйгілі жер деп айтпас едім.
Dialogue: 0,0:16:40.38,0:16:43.19,*Default-ja,NTP,0,0,0,,Бұл жерден міндетті түрде өлуге болады дейді.
Dialogue: 0,0:16:43.05,0:16:45.31,Dialogue,,0,0,0,,Менің айтайын дегенім, мына жердегі даққа қараңызшы.
Dialogue: 0,0:16:43.39,0:16:45.67,*Default-ja,NTP,0,0,0,,Қараңдар, мына даққа қараңдаршы.
Dialogue: 0,0:16:53.17,0:16:56.74,Dialogue,,0,0,0,,Сіз өзіңізді ерекшемін деп ойлайсыз, солай емес пе?
Dialogue: 0,0:16:53.63,0:16:56.76,*Default-ja,NTP,0,0,0,,Жалғыз өзіңді ерекшемін деп ойламайсың ба?
Dialogue: 0,0:16:56.74,0:17:00.48,Dialogue,,0,0,0,,Сіз олай емессіз. Барлығы бірдей.
Dialogue: 0,0:16:57.14,0:16:58.48,*Default-ja,NTP,0,0,0,,Бұлай емес.
Dialogue: 0,0:16:58.71,0:16:59.97,*Default-ja,NTP,0,0,0,,Өйткені біз бәріміз бірдейміз
Dialogue: 0,0:17:00.48,0:17:07.75,Dialogue,,0,0,0,,Бүкіл өмірін толығымен бұзылмай өткізе алатын ешкім жоқ.
Dialogue: 0,0:17:00.74,0:17:02.58,*Default-ja,NTP,0,0,0,,Кім таза және жазықсыз өмір сүре алады?
Dialogue: 0,0:17:03.04,0:17:07.64,*Default-ja,NTP,0,0,0,,Ол еш жерде жоқ.
Dialogue: 0,0:17:07.75,0:17:12.00,Dialogue,,0,0,0,,Менің айтайын дегенім, сізде кем дегенде бір-екі құпия бар емес пе?
Dialogue: 0,0:17:08.10,0:17:12.00,*Default-ja,NTP,0,0,0,,Сізде бір-екі құпия бар шығар, солай ма?
Dialogue: 0,0:17:12.00,0:17:16.63,Dialogue,,0,0,0,,Неліктен сен жақсысың, ал ата-анаң неге соншалықты жаман екен деп ойладың ба?
Dialogue: 0,0:17:12.33,0:17:16.82,*Default-ja,NTP,0,0,0,,Сен жақсысың ба, ал ата-анаң жаман ба деп ойладың ба?
Dialogue: 0,0:17:17.90,0:17:19.65,Dialogue,,0,0,0,,Ал...
Dialogue: 0,0:17:18.21,0:17:19.33,*Default-ja,NTP,0,0,0,,Бұл...
Dialogue: 0,0:17:19.65,0:17:24.44,Dialogue,,0,0,0,,Егер сіз маған жауап беруге рұқсат етсеңіз, сіз біреуді алдап жатсаңыз немесе сізді алдап жатсаңыз да,
Dialogue: 0,0:17:19.90,0:17:21.80,*Default-ja,NTP,0,0,0,,Сөзімді қорытындылаймын
Dialogue: 0,0:17:22.04,0:17:24.21,*Default-ja,NTP,0,0,0,,Егер сіз алдасаңыз немесе бұл туралы білсеңіз де
Dialogue: 0,0:17:24.44,0:17:29.90,Dialogue,,0,0,0,,Жаман әзілдерге бәрі күледі, тым тәтті пісірілген көкөністерді жейді.
Dialogue: 0,0:17:24.65,0:17:26.79,*Default-ja,NTP,0,0,0,,Қызық әзілдерге бәрі күледі.
Dialogue: 0,0:17:27.00,0:17:30.34,*Default-ja,NTP,0,0,0,,Сіз тым тәтті қайнатылған тағамды жеу арқылы өмір сүріп жатырмын деп ойлайсыз.
Dialogue: 0,0:17:34.19,0:17:35.37,Dialogue,,0,0,0,,Айналаңызға қараңыз.
Dialogue: 0,0:17:34.69,0:17:35.70,*Default-ja,NTP,0,0,0,,Қараңыз
Dialogue: 0,0:17:35.37,0:17:38.76,Dialogue,,0,0,0,,Сізде қандай уайым болса да, барлығы қарапайым дақ.
Dialogue: 0,0:17:35.74,0:17:37.06,*Default-ja,NTP,0,0,0,,Қандай қиыншылық болса да
Dialogue: 0,0:17:37.14,0:17:39.72,*Default-ja,NTP,0,0,0,,Қазір бәріміз дақпыз, дақ.
Dialogue: 0,0:17:38.76,0:17:39.81,Dialogue,,0,0,0,,Дақтар.
Dialogue: 0,0:17:39.81,0:17:40.70,Dialogue,,0,0,0,,Ерекшеліктер жоқ.
Dialogue: 0,0:17:40.01,0:17:44.57,*Default-ja,NTP,0,0,0,,Құдайдың алдында бәрі тең
Dialogue: 0,0:17:40.70,0:17:42.41,Dialogue,,0,0,0,,Барлығы.
Dialogue: 0,0:17:42.41,0:17:44.95,Dialogue,,0,0,0,,Құдай алдында бәрі бірдей.
Dialogue: 0,0:17:46.15,0:17:47.92,Dialogue,,0,0,0,,Мен сені жіберейін бе?
Dialogue: 0,0:17:46.51,0:17:47.69,*Default-ja,NTP,0,0,0,,Мен сені жіберейін бе?
Dialogue: 0,0:17:54.44,0:17:55.42,Dialogue,,0,0,0,,Қараңыз.
Dialogue: 0,0:17:54.72,0:17:55.88,*Default-ja,NTP,0,0,0,,Ура
Dialogue: 0,0:17:57.97,0:18:05.76,Dialogue,,0,0,0,,Бүгінгі эмоцияларыңыздың толық және ыңғайсыз спектрін көргеніме қуаныштымын.
Dialogue: 0,0:17:58.35,0:18:00.14,*Default-ja,NTP,0,0,0,,Міне, бүгінгі күн.
Dialogue: 0,0:18:01.76,0:18:05.52,*Default-ja,NTP,0,0,0,,Мен сенің көңіл-күйіңді байқағаныма қуаныштымын.
Dialogue: 0,0:18:05.76,0:18:12.00,Dialogue,,0,0,0,,Мені сіздің жеке мәселелеріңіз емес, алаңдаған кезде қалай ұстайтыныңыз қызықтырады.
Dialogue: 0,0:18:05.98,0:18:09.43,*Default-ja,NTP,0,0,0,,Мені шынымен қызықтыратын нәрсе сенің қиындықтарың емес.
Dialogue: 0,0:18:09.56,0:18:11.70,*Default-ja,NTP,0,0,0,,Себебі сізді алаңдататын сіздің биологияңыз.
Dialogue: 0,0:18:11.96,0:18:15.95,*Default-ja,NTP,0,0,0,,Айтпақшы, сіздің өміріңіз жоспарланғандай және қызықсыз болды.
Dialogue: 0,0:18:12.00,0:18:15.90,Dialogue,,0,0,0,,Айтпақшы, сіздің мінез-құлқыңыз мен күткендей қызықсыз болды.
Dialogue: 0,0:18:15.90,0:18:19.16,Dialogue,,0,0,0,,Менің ойымша, бұл сенің өлгің келмейтінін басынан-ақ білгендіктен шығар.
Dialogue: 0,0:18:16.30,0:18:19.09,*Default-ja,NTP,0,0,0,,Мен өлгім келмейтінімді әу бастан білдім.
Dialogue: 0,0:18:19.16,0:18:23.61,Dialogue,,0,0,0,,Олай болса сау болыңыз. Мен көңілді болдым, қызғылт ханым.
Dialogue: 0,0:18:19.50,0:18:20.45,*Default-ja,NTP,0,0,0,,Олай болса!
Dialogue: 0,0:18:20.60,0:18:23.16,*Default-ja,NTP,0,0,0,,Көңілді болды, қызыл қызыл.
Dialogue: 0,0:18:36.98,0:18:39.52,Dialogue,,0,0,0,,Ол бір сәт кідірді.
Dialogue: 0,0:18:37.42,0:18:39.46,*Default-ja,NTP,0,0,0,,Мен біраз абдырап қалдым.
Dialogue: 0,0:18:40.46,0:18:45.34,Dialogue,,0,0,0,,Ол секіру арқылы ол адамға зиян тигізуі мүмкін екенін түсінді.
Dialogue: 0,0:18:40.72,0:18:44.81,*Default-ja,NTP,0,0,0,,Мен оны осылай ренжіте аламын ба?
Dialogue: 0,0:18:45.34,0:18:47.21,Dialogue,,0,0,0,,Алайда ол да ойлады...
Dialogue: 0,0:18:45.71,0:18:46.90,*Default-ja,NTP,0,0,0,,Бірақ мен ойладым
Dialogue: 0,0:18:47.21,0:18:50.87,Dialogue,,0,0,0,,«Мен жаңа ғана мүмкіндікті күтіп жүрген шығармын».
Dialogue: 0,0:18:47.56,0:18:50.58,*Default-ja,NTP,0,0,0,,Мүмкін мен жай ғана мүмкіндік күтіп тұрған шығармын.
Dialogue: 0,0:18:50.87,0:18:55.46,Dialogue,,0,0,0,,«Ал әлгі адамның сөзі сол мүмкіндік...»
Dialogue: 0,0:18:51.15,0:18:55.08,*Default-ja,NTP,0,0,0,,Ол кісінің сөзі болса да
Dialogue: 0,0:18:58.22,0:19:02.03,Dialogue,,0,0,0,,Бірақ оны білмей...
Dialogue: 0,0:18:58.63,0:19:01.86,*Default-ja,NTP,0,0,0,,Бірақ қыздың хабарынсыз...
Dialogue: 0,0:19:32.81,0:19:33.77,Dialogue,,0,0,0,,Умм...
Dialogue: 0,0:19:33.14,0:19:34.04,*Default-ja,NTP,0,0,0,,Ум...
Dialogue: 0,0:19:37.01,0:19:38.54,Dialogue,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:19:37.28,0:19:38.36,*Default-ja,NTP,0,0,0,,Неліктен?
Dialogue: 0,0:19:54.38,0:19:57.84,Dialogue,,0,0,0,,Мен мұны істеудің қажеті жоқ дедім...
Dialogue: 0,0:19:54.74,0:19:57.25,*Default-ja,NTP,0,0,0,,…
Dialogue: 0,0:20:01.67,0:20:06.02,Dialogue,,0,0,0,,Қыз анасы мен әкесі туралы ойлады.
Dialogue: 0,0:20:02.17,0:20:05.46,*Default-ja,NTP,0,0,0,,Қыз әкесі мен анасы туралы ойлады.
Dialogue: 0,0:20:06.02,0:20:08.00,Dialogue,,0,0,0,,Әкесі туралы, оның ханымы туралы...
Dialogue: 0,0:20:06.32,0:20:08.04,*Default-ja,NTP,0,0,0,,Әке мен әкенің үй иесі
Dialogue: 0,0:20:08.00,0:20:09.75,Dialogue,,0,0,0,,Екі ата-анасы туралы.
Dialogue: 0,0:20:08.36,0:20:09.48,*Default-ja,NTP,0,0,0,,Әке мен ана
Dialogue: 0,0:20:09.75,0:20:13.19,Dialogue,,0,0,0,,Әркімнің өзінің жеке уақыты бар.
Dialogue: 0,0:20:10.05,0:20:12.81,*Default-ja,NTP,0,0,0,,Әрқайсымыз өзіміз білмейтін уақытты ойладық.
Dialogue: 0,0:20:13.19,0:20:20.99,Dialogue,,0,0,0,,Бәлкім, бұл ол ойлағандай жеккөрушілік, жеккөрушілік немесе өшпенділік емес шығар.
Dialogue: 0,0:20:13.41,0:20:16.13,*Default-ja,NTP,0,0,0,,Мен солай ойладым
Dialogue: 0,0:20:16.30,0:20:20.46,*Default-ja,NTP,0,0,0,,Ол зұлымдықпен, есеппен немесе өшпенділікпен боялмаған болуы мүмкін.
Dialogue: 0,0:20:20.99,0:20:25.49,Dialogue,,0,0,0,,Мүмкін бұл шын мәнінде ымыраға келу немесе әлсіздікті жасыру тәсілі емес шығар.
Dialogue: 0,0:20:21.32,0:20:25.40,*Default-ja,NTP,0,0,0,,Бұл ымыраға келу немесе әлсіздік арқылы жасырынбаған болуы мүмкін.
Dialogue: 0,0:20:26.05,0:20:31.70,Dialogue,,0,0,0,,Үйін ақтарып отырып, ол отбасын кешіруді шешті.
Dialogue: 0,0:20:26.32,0:20:27.80,*Default-ja,NTP,0,0,0,,Үйге барар жолды іздеу кезінде
Dialogue: 0,0:20:28.15,0:20:31.58,*Default-ja,NTP,0,0,0,,Қыз оларды кешіргісі келді.
Dialogue: 0,0:20:34.06,0:20:37.70,Dialogue,,0,0,0,,Сол күннен бастап ол әлемге басқаша көзқараспен қарайтын болды.
Dialogue: 0,0:20:34.38,0:20:37.18,*Default-ja,NTP,0,0,0,,Сол күннен бастап дүние өзгерген сияқты.
Dialogue: 0,0:20:37.70,0:20:41.51,Dialogue,,0,0,0,,Адам қанша болса, сонша естелік пен сыр бар.
Dialogue: 0,0:20:37.94,0:20:39.58,*Default-ja,NTP,0,0,0,,Қанша адам болса, сонша ой
Dialogue: 0,0:20:39.88,0:20:41.63,*Default-ja,NTP,0,0,0,,Қанша адам болса, сонша құпия
Dialogue: 0,0:20:41.81,0:20:45.01,Dialogue,,0,0,0,,Бұл түсіну оған ақыры анық болды.
Dialogue: 0,0:20:42.06,0:20:45.19,*Default-ja,NTP,0,0,0,,Мен мұны қалыпты жағдай деп сезінемін.
Dialogue: 0,0:20:45.01,0:20:46.81,Dialogue,,0,0,0,,Біз қайда баруымыз керек?
Dialogue: 0,0:20:45.70,0:20:46.83,*Default-ja,NTP,0,0,0,,Біз қайда барамыз?
Dialogue: 0,0:20:46.81,0:20:49.24,Dialogue,,0,0,0,,Мен сені қалаған жерге апарамын, менің тамағымның ақшасын төле.
Dialogue: 0,0:20:47.11,0:20:49.23,*Default-ja,NTP,0,0,0,,Мен саған кез келген жерді көрсетемін, сондықтан бүгін өзіңді емде.
Dialogue: 0,0:20:49.24,0:20:52.52,Dialogue,,0,0,0,,Жарайды, кітап дүкені ше?
Dialogue: 0,0:20:49.42,0:20:52.20,*Default-ja,NTP,0,0,0,,Дұрыс, сонда кітап дүкені ме?
Dialogue: 0,0:20:52.50,0:20:55.44,*Default-ja,NTP,0,0,0,,Кітап дүкені болса, көп нәрсе болар еді...
Dialogue: 0,0:20:52.52,0:20:56.07,Dialogue,,0,0,0,,Кітап дүкенін кез келген бұрыштан табуға болады...
Dialogue: 0,0:20:54.91,0:21:00.07,Secondary,,0,0,0,,Кез келген жерден табатын бұл екеуінің де сыры бар шығар.
Dialogue: 0,0:20:55.44,0:20:57.70,*Default-ja,NTP,0,0,0,,Олар барлық жерде бар сияқты
Dialogue: 0,0:20:57.34,0:21:02.53,Dialogue,,0,0,0,,Ал, алдымен үйге қайтайық, сосын...
Dialogue: 0,0:20:58.00,0:20:59.52,*Default-ja,NTP,0,0,0,,Бір құпия болуы керек
Dialogue: 0,0:21:00.08,0:21:02.53,Secondary,,0,0,0,,Олардың ешкімнің естігісі келмейтін ойлары бар.
Dialogue: 0,0:21:00.40,0:21:02.71,*Default-ja,NTP,0,0,0,,Ешкімге айта алмайтын сезімдерім бар.
Dialogue: 0,0:21:03.58,0:21:05.05,Dialogue,,0,0,0,,Өтінемін, күте тұрыңыз!
Dialogue: 0,0:21:03.77,0:21:04.97,*Default-ja,NTP,0,0,0,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:21:05.05,0:21:08.20,Dialogue,,0,0,0,,Ягири, бірдеңе емес пе...
Dialogue: 0,0:21:05.50,0:21:08.45,*Default-ja,NTP,0,0,0,,Ягири-кун, шындығы қандай...
Dialogue: 0,0:21:08.20,0:21:09.23,Dialogue,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:21:08.49,0:21:09.53,*Default-ja,NTP,0,0,0,,Мен білмеймін
Dialogue: 0,0:21:09.23,0:21:13.07,Dialogue,,0,0,0,,Бұл-Бірақ...мектептің бірінші күні болмағандықтан...
Dialogue: 0,0:21:09.60,0:21:13.12,*Default-ja,NTP,0,0,0,,Сонымен...бірақ ол бірінші күні болмаған...
Dialogue: 0,0:21:13.07,0:21:14.72,Dialogue,,0,0,0,,Мен білмеймін дедім!
Dialogue: 0,0:21:13.38,0:21:14.84,*Default-ja,NTP,0,0,0,,Егер сіз білмесеңіз!
Dialogue: 0,0:21:14.72,0:21:15.55,Dialogue,,0,0,0,,Шынымен
Dialogue: 0,0:21:14.95,0:21:15.84,*Default-ja,NTP,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:21:15.55,0:21:16.79,Dialogue,,0,0,0,,Умм...
Dialogue: 0,0:21:15.90,0:21:16.92,*Default-ja,NTP,0,0,0,,Мм...
Dialogue: 0,0:21:16.79,0:21:18.25,Dialogue,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:21:17.34,0:21:18.41,*Default-ja,NTP,0,0,0,,Не болды?
Dialogue: 0,0:21:23.15,0:21:24.98,Dialogue,,0,0,0,,Не болды деп ойлаймын...
Dialogue: 0,0:21:23.51,0:21:24.54,*Default-ja,NTP,0,0,0,,Чип! Чип, чип, чип, чип!
Dialogue: 0,0:21:25.58,0:21:27.37,Dialogue,,0,0,0,,Мен сондай күнәкар адаммын.
Dialogue: 0,0:21:25.99,0:21:27.29,*Default-ja,NTP,0,0,0,,Мен де күнәһар адаммын
Dialogue: 0,0:21:27.37,0:21:27.92,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:21:27.92,0:21:30.69,Dialogue,,0,0,0,,Әлгі көзілдірік киген қыз маған қатты ұнады.
Dialogue: 0,0:21:28.20,0:21:30.75,*Default-ja,NTP,0,0,0,,Әлгі көзілдірік киген жігіт, сен маған ғашық болып қалдың ба?
Dialogue: 0,0:21:30.69,0:21:35.78,Dialogue,,0,0,0,,Ол менімен бірге болатын қауіпті және қауіпті күндеріне мүлдем сенімсіз болды.
Dialogue: 0,0:21:30.87,0:21:35.86,*Default-ja,NTP,0,0,0,,Ол басталатын қауіпті және қауіпті Тәуекелді күндерге алаңдағандай болды.
Dialogue: 0,0:21:35.78,0:21:37.94,Dialogue,,0,0,0,,Сіз мен үшін жапон тілінде сөйлей аласыз ба?
Dialogue: 0,0:21:36.00,0:21:37.97,*Default-ja,NTP,0,0,0,,Кешіріңіз, сіз жапон тілінде сөйлей аласыз ба?
Dialogue: 0,0:21:38.30,0:21:45.44,Dialogue,,0,0,0,,Ол үшін де, ол үшін де шындық сіз көргендей емес.
Dialogue: 0,0:21:38.57,0:21:39.73,*Default-ja,NTP,0,0,0,,Ол да
Dialogue: 0,0:21:40.10,0:21:41.53,*Default-ja,NTP,0,0,0,,Оған да
Dialogue: 0,0:21:42.03,0:21:44.66,*Default-ja,NTP,0,0,0,,Сіз көрген нәрсе міндетті түрде шындық емес
Dialogue: 0,0:21:45.40,0:21:46.65,*Default-ja,NTP,0,0,0,,Қыз ойланады
Dialogue: 0,0:21:45.44,0:21:46.78,Dialogue,,0,0,0,,Осылайша ол ойлады ...
Dialogue: 0,0:21:46.78,0:21:51.14,Dialogue,,0,0,0,,«Мен мұны бір күні біреуге айта аламын ба?»
Dialogue: 0,0:21:46.97,0:21:50.64,*Default-ja,NTP,0,0,0,,Бір күні біреуге айта аламын ба?
Dialogue: 0,0:21:51.14,0:21:56.25,Dialogue,,0,0,0,,«Дүние сен ойлағандай қорқынышты емес».
Dialogue: 0,0:21:51.41,0:21:56.67,*Default-ja,NTP,0,0,0,,Дүние сен ойлағандай жаман емес.
Dialogue: 0,0:22:00.50,0:22:05.51,Dialogue,,0,0,0,,Мен сенің әділдік үшін крест жорығына айналғаның туралы ештеңе естімедім.
Dialogue: 0,0:22:00.73,0:22:05.90,*Default-ja,NTP,0,0,0,,Әділдіктің одақтасы болғаныңды естімеппін.
Dialogue: 0,0:22:07.75,0:22:13.01,Dialogue,,0,0,0,,Мен жай ғана тамаша курьерден өз жұмысын орындауды сұраймын деп ойладым...
Dialogue: 0,0:22:08.16,0:22:12.52,*Default-ja,NTP,0,0,0,,Мен бұл жұмысты тамаша курьерден сұрауым керек еді.
Dialogue: 0,0:22:15.98,0:22:17.76,Dialogue,,0,0,0,,Қалай!
Dialogue: 0,0:22:16.66,0:22:17.81,*Default-ja,NTP,0,0,0,,Жоқ!
Dialogue: 0,0:22:17.76,0:22:21.69,Dialogue,,0,0,0,,Мен сияқты қарапайым ақпарат таратушы олай жаман емес.
Dialogue: 0,0:22:17.94,0:22:21.95,*Default-ja,NTP,0,0,0,,Ақпарат беруші Изая Орихара соншалықты жаман деп ойламаймын.
Dialogue: 0,0:22:23.36,0:22:28.24,Dialogue,,0,0,0,,Өзін-өзі өлтіруден өлгісі келетін адамды тоқтататын адамды «жақсы» деп атауға болатынын білмеймін.
Dialogue: 0,0:22:23.83,0:22:28.41,*Default-ja,NTP,0,0,0,,Менің ойымша, ол өлгісі келетін адамды тоқтатуға жарамайды.
Dialogue: 0,0:22:31.99,0:22:35.70,Dialogue,,0,0,0,,Мен көңілді болдым, тамаша курьер.
Dialogue: 0,0:22:32.65,0:22:35.90,*Default-ja,NTP,0,0,0,,Көңілді болды, тамаша курьер.
Dialogue: 0,0:24:14.95,0:24:19.57,staff,NTP,0,0,0,,Өндіріс: LASTZZZ Демалыс бұлт акира Акира
Dialogue: 0,0:24:15.13,0:24:16.05,Dialogue,,0,0,0,,Икебукуро:
Dialogue: 0,0:24:15.62,0:24:20.07,*Default-ja,NTP,0,0,0,,Икебукуро... Ол, ол, мен, сен де бірдеңе іздеп жүрсің.
Dialogue: 0,0:24:16.39,0:24:24.23,Dialogue,,0,0,0,,Ол, ол, сен, мен бәріміз осы қалаға бірдеңе іздеп, бірдеңе іздеп, бір нәрсені өзгерткіміз келеді.
Dialogue: 0,0:24:19.73,0:24:24.72,staff,NTP,0,0,0,,Manyu субтитрлер жұбы http://popgo.net/bbs/
Dialogue: 0,0:24:20.24,0:24:24.08,*Default-ja,NTP,0,0,0,,Олар бұл қалаға бірдеңе іздеп, бір нәрсені өзгерту үшін келеді.
Dialogue: 0,0:24:24.23,0:24:25.77,Dialogue,,0,0,0,,Келесі жолы: Running Rampant
Dialogue: 0,0:24:26.09,0:24:27.27,Dialogue,,0,0,0,,Суши жегіңіз келе ме? Суши жақсы.
Dialogue: 0,0:24:26.31,0:24:27.62,*Default-ja,NTP,0,0,0,,Сіз суши жейсіз бе? Жақсы
Dialogue: 0,0:24:27.27,0:24:29.57,Dialogue,,0,0,0,,Көптен бері көрмедім, мырза.
Dialogue: 0,0:24:27.69,0:24:29.29,*Default-ja,NTP,0,0,0,,Ониисан Хисаши~Бури!
Dialogue: 0,0:24:31.07,0:24:37.07,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory