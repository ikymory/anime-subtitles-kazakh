Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:07.88,0:01:10.36,*Default-ja,NTP,0,0,0,,Рюгамин... Бұл Микадо.
Dialogue: 0,0:01:07.89,0:01:09.84,Dialogue,,0,0,0,,Мен Рюгаминмін...Микадо.
Dialogue: 0,0:01:09.84,0:01:12.70,Dialogue,,0,0,0,,Мүмкін емес! Бұл шынымен сенсің бе, Кида?
Dialogue: 0,0:01:11.03,0:01:12.71,*Default-ja,NTP,0,0,0,,Кида-кун! Сіз Кида-кунсыз ба?
Dialogue: 0,0:01:12.70,0:01:15.34,Dialogue,,0,0,0,,Жақында бандылардың белсенділігі де төмендеді.
Dialogue: 0,0:01:13.02,0:01:14.91,*Default-ja,NTP,0,0,0,,Соңғы уақытта түрлі-түсті бандалар азайды.
Dialogue: 0,0:01:15.34,0:01:18.55,Dialogue,,0,0,0,,Олар Сайтама жігіттерімен төбелесіп, бір топ адам ұсталды.
Dialogue: 0,0:01:15.56,0:01:18.72,*Default-ja,NTP,0,0,0,,Сайтамамен қақтығыс болып, ондаған адам ұрланған.
Dialogue: 0,0:01:18.84,0:01:22.42,Dialogue,,0,0,0,,Мен Сонохара Анримін. Жыл жақсы өтеді деп үміттенемін.
Dialogue: 0,0:01:19.08,0:01:20.39,*Default-ja,NTP,0,0,0,,Бұл Анри Сонохара.
Dialogue: 0,0:01:20.98,0:01:22.49,*Default-ja,NTP,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:01:22.42,0:01:23.42,Dialogue,,0,0,0,,Харима!
Dialogue: 0,0:01:22.63,0:01:23.42,*Default-ja,NTP,0,0,0,,Харима мырза!
Dialogue: 0,0:01:24.18,0:01:25.23,Dialogue,,0,0,0,,Мен сені басқа біреу деп ойладым!
Dialogue: 0,0:01:24.26,0:01:25.34,*Default-ja,NTP,0,0,0,,Бұл дұрыс емес адам болды!
Dialogue: 0,0:01:25.23,0:01:29.31,Dialogue,,0,0,0,,Сіз керемет Икебукюрер болуға уәде бердіңіз, сондықтан бәрімізге көрсетіңіз және бұл қиыншылықты жеңіңіз!
Dialogue: 0,0:01:25.49,0:01:27.37,*Default-ja,NTP,0,0,0,,Егер сіз керемет Икебукуро адамы болуға ант етсеңіз.
Dialogue: 0,0:01:27.69,0:01:29.64,*Default-ja,NTP,0,0,0,,Мен бұл сынақты жеңемін!
Dialogue: 0,0:01:30.02,0:01:32.52,Dialogue,,0,0,0,,Мен сені таптым, менің...махаббатым.
Dialogue: 0,0:01:30.10,0:01:32.82,*Default-ja,NTP,0,0,0,,Мен... махаббатымды таптым
Dialogue: 0,0:02:11.39,0:02:12.82,Dialogue,,0,0,0,,Мұнда.
Dialogue: 0,0:02:11.63,0:02:14.09,*Default-ja,NTP,0,0,0,,Юта Отокоцу
Dialogue: 0,0:02:12.82,0:02:14.65,Dialogue,,0,0,0,,Неге?!
Dialogue: 0,0:02:14.65,0:02:16.74,Dialogue,,0,0,0,,Мен оны қайтарамын! Мен оны қайтарамын!
Dialogue: 0,0:02:15.22,0:02:16.81,*Default-ja,NTP,0,0,0,,Қайтарыңыз! Мен оны қайтарамын!
Dialogue: 0,0:02:17.53,0:02:18.95,Dialogue,,0,0,0,,Өтінемін, мені кешіріңіз.
Dialogue: 0,0:02:17.81,0:02:18.99,*Default-ja,NTP,0,0,0,,Не... мені кешіріңізші.
Dialogue: 0,0:02:39.76,0:02:40.88,Dialogue,,0,0,0,,Бұл жаман.
Dialogue: 0,0:02:41.76,0:02:43.50,Dialogue,,0,0,0,,Бұл өте жаман.
Dialogue: 0,0:02:44.10,0:02:46.35,Dialogue,,0,0,0,,Бәріне менің кінәм, Селти.
Dialogue: 0,0:02:44.38,0:02:45.80,*Default-ja,NTP,0,0,0,,Бұл менің кінәм Селти
Dialogue: 0,0:02:46.34,0:02:48.81,*Default-ja,NTP,0,0,0,,Мен қызықсыз жұмысқа қабылданғандықтан...
Dialogue: 0,0:02:46.35,0:02:48.85,Dialogue,,0,0,0,,Мұның бәрі сені сол күлкілі жұмысқа мен мәжбүрлегенім үшін.
Dialogue: 0,0:02:49.67,0:02:56.02,Dialogue,,0,0,0,,Мен оны еш қиындықсыз аяқтауым керек еді; себебі бұл нәрсе кездейсоқ пайда болды.
Dialogue: 0,0:02:50.00,0:02:52.45,*Default-ja,NTP,0,0,0,,Жұмысты тез орындау керек еді.
Dialogue: 0,0:02:52.77,0:02:56.12,*Default-ja,NTP,0,0,0,,Бұл кездейсоқ пайда болды...
Dialogue: 0,0:03:10.41,0:03:14.38,Dialogue,,0,0,0,,Сіз адам емессіз. Сіз құбыжықсыз! Құбыжық! Құбыжық!
Dialogue: 0,0:03:10.45,0:03:14.27,*Default-ja,NTP,0,0,0,,Адам емес, құбыжық, құбыжық, құбыжық...
Dialogue: 0,0:03:15.07,0:03:17.21,Dialogue,,0,0,0,,Сіз жараңыздан шыққан дауысты естідіңіз бе?
Dialogue: 0,0:03:15.38,0:03:17.24,*Default-ja,NTP,0,0,0,,«Жарадан шыққан дауысты естідім»?
Dialogue: 0,0:03:17.21,0:03:19.70,Dialogue,,0,0,0,,Бұл мені құбыжық деп атады!
Dialogue: 0,0:03:17.62,0:03:19.80,*Default-ja,NTP,0,0,0,,Сен мені құбыжық деп атадың.
Dialogue: 0,0:03:19.70,0:03:23.71,Dialogue,,0,0,0,,Не деген дөрекі шал. Бұл сізді кем дегенде сиқыршы деп атауы керек еді.
Dialogue: 0,0:03:20.07,0:03:21.53,*Default-ja,NTP,0,0,0,,Қандай дөрекі жігіт.
Dialogue: 0,0:03:21.73,0:03:23.80,*Default-ja,NTP,0,0,0,,Сіз оны ең болмағанда фемма фатале деп атайсыз деп үміттенемін.
Dialogue: 0,0:03:23.71,0:03:25.51,Dialogue,,0,0,0,,Бұл не?
Dialogue: 0,0:03:23.87,0:03:24.86,*Default-ja,NTP,0,0,0,,Шынында да солай емес пе?
Dialogue: 0,0:03:27.97,0:03:29.98,Dialogue,,0,0,0,,Шетелдік болса ше?!
Dialogue: 0,0:03:31.45,0:03:32.48,Dialogue,,0,0,0,,Селти...
Dialogue: 0,0:03:31.80,0:03:32.93,*Default-ja,NTP,0,0,0,,Celty…
Dialogue: 0,0:03:33.01,0:03:35.52,Dialogue,,0,0,0,,Бұл күлкілі болуы керек пе?
Dialogue: 0,0:03:33.33,0:03:34.98,*Default-ja,NTP,0,0,0,,Бұл күлкілі ме?
Dialogue: 0,0:03:37.21,0:03:39.03,Dialogue,,0,0,0,,Мо-монстр!
Dialogue: 0,0:03:37.49,0:03:39.27,*Default-ja,NTP,0,0,0,,Ба... құбыжық!
Dialogue: 0,0:03:42.66,0:03:44.41,Dialogue,,0,0,0,,Жер
Dialogue: 0,0:03:43.14,0:03:43.85,*Default-ja,NTP,0,0,0,,Кеттік!
Dialogue: 0,0:03:46.09,0:03:51.69,Dialogue,,0,0,0,,Бұл қала әзіл-қалжың, каприз және кездейсоқтықтан тұрады.
Dialogue: 0,0:03:46.54,0:03:51.47,*Default-ja,NTP,0,0,0,,Бұл қалашық әзіл-қалжың, қыңырлық пен кездейсоқтықтан құралған сияқты.
Dialogue: 0,0:03:55.08,0:03:55.79,Chat,,0,0,0,,Сайка сөйлесу бөлмесіне кірді.
Dialogue: 0,0:03:55.83,0:03:56.50,Chat,,0,0,0,,Адамдар
Dialogue: 0,0:03:56.50,0:03:57.13,Chat,,0,0,0,,Күшті
Dialogue: 0,0:03:57.13,0:03:57.75,Chat,,0,0,0,,Үміт
Dialogue: 0,0:03:57.75,0:03:58.17,Chat,,0,0,0,,Махаббат
Dialogue: 0,0:03:58.17,0:03:58.59,Chat,,0,0,0,,Сүйетін және үміттенетін адамдар
Dialogue: 0,0:03:58.59,0:03:58.96,Chat,,0,0,0,,Because hope is strong people human love. Өйткені үміт бар.
Dialogue: 0,0:03:58.96,0:03:59.21,Chat,,0,0,0,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:03:59.21,0:03:59.42,Chat,,0,0,0,,мен, сондықтан үміттенемін.
Dialogue: 0,0:03:59.42,0:03:59.63,Chat,,0,0,0,,...
Dialogue: 0,0:03:59.63,0:03:59.92,Chat,,0,0,0,,Мықты адамдар
Dialogue: 0,0:03:59.92,0:04:00.13,Chat,,0,0,0,,Үміт
Dialogue: 0,0:04:00.13,0:04:00.42,Chat,,0,0,0,,Мен, махаббат
Dialogue: 0,0:04:00.42,0:04:00.71,Chat,,0,0,0,,өйткені
Dialogue: 0,0:04:00.71,0:04:05.22,Dialogue,,0,0,0,,Бұл жағдай да Құдайдың әзіл-қалжыңының бірі болуы мүмкін.
Dialogue: 0,0:04:01.37,0:04:05.49,*Default-ja,NTP,0,0,0,,Бұл жағдай да Құдайдың қыңырлығы ма, әлде қалжың ба...
Dialogue: 0,0:04:05.71,0:04:09.12,Dialogue,,0,0,0,,Мектеп табалдырығын аттағалы бері бір көргеннен ғашық болған отыз жеті қыз бар.
Dialogue: 0,0:04:06.04,0:04:09.06,*Default-ja,NTP,0,0,0,,37 қыз кіру салтанатында бір көргеннен ғашық болды
Dialogue: 0,0:04:09.12,0:04:16.56,Dialogue,,0,0,0,,Драмадағы сюжетті бұрмалау сияқты, мен мектептен үйге менің бестігімнің бірімен келемін, ол кездейсоқ осы көзілдірік киген қыз...
Dialogue: 0,0:04:09.42,0:04:12.23,*Default-ja,NTP,0,0,0,,Үздік 5 көзілдірік киген қыз
Dialogue: 0,0:04:12.45,0:04:16.28,*Default-ja,NTP,0,0,0,,Бұл драма сияқты болды және біз мектептен бірге шықтық.
Dialogue: 0,0:04:16.56,0:04:20.50,Dialogue,,0,0,0,,Бірақ бұл елдік бұзық жолға түсіп жатыр.
Dialogue: 0,0:04:16.84,0:04:20.54,*Default-ja,NTP,0,0,0,,Мұндай жабайы аңның мазасын алу ұят.
Dialogue: 0,0:04:21.88,0:04:23.76,Dialogue,,0,0,0,,Бұл сізге қатты тиген болуы керек.
Dialogue: 0,0:04:22.14,0:04:23.90,*Default-ja,NTP,0,0,0,,Өткен күні қиын болды.
Dialogue: 0,0:04:23.76,0:04:25.24,Dialogue,,0,0,0,,Иә...
Dialogue: 0,0:04:24.77,0:04:25.58,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:04:31.37,0:04:33.00,Thought,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:04:31.85,0:04:33.14,*Default-ja,NTP,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:04:33.00,0:04:35.70,Dialogue,,0,0,0,,Мен сонда қатты таң қалдым.
Dialogue: 0,0:04:33.55,0:04:35.78,*Default-ja,NTP,0,0,0,,Мен оны көргенде қатты таң қалдым.
Dialogue: 0,0:04:35.70,0:04:37.88,Dialogue,,0,0,0,,Менсіз қашып кеткеніңе сенбеймін.
Dialogue: 0,0:04:35.99,0:04:38.00,*Default-ja,NTP,0,0,0,,Микадоның менен қашып бара жатқанына сене алар емеспін.
Dialogue: 0,0:04:37.88,0:04:40.13,Dialogue,,0,0,0,,Бұлай емес еді...
Dialogue: 0,0:04:38.38,0:04:39.91,*Default-ja,NTP,0,0,0,,Осылайша қашасың...
Dialogue: 0,0:04:41.93,0:04:43.63,Dialogue,,0,0,0,,Жоқ! Микадо!
Dialogue: 0,0:04:42.21,0:04:43.85,*Default-ja,NTP,0,0,0,,Өтірік! Тэйцзин!
Dialogue: 0,0:04:43.63,0:04:45.40,Dialogue,,0,0,0,,Бірақ сен маған көмектестің.
Dialogue: 0,0:04:44.04,0:04:45.55,*Default-ja,NTP,0,0,0,,Бірақ бұл көмектесті.
Dialogue: 0,0:04:45.40,0:04:49.34,Dialogue,,0,0,0,,Мен сенің орнында болсам, мұндай мүмкіндікті жіберіп алмас едім.
Dialogue: 0,0:04:45.70,0:04:49.44,*Default-ja,NTP,0,0,0,,Егер мен сенің орнында болсам, мұндай мүмкіндікті жіберіп алмас едім.
Dialogue: 0,0:04:49.34,0:04:53.18,Dialogue,,0,0,0,,Дәл қазір біз West Gate саябағында бір-бірімізге деген сүйіспеншілігімізді білдіретін едік...
Dialogue: 0,0:04:49.59,0:04:53.28,*Default-ja,NTP,0,0,0,,Екеуі Нишигучи саябағында махаббаттары туралы сөйлескісі келеді.
Dialogue: 0,0:04:53.88,0:04:55.52,Dialogue,,0,0,0,,Осы жазба бойынша менімен бірге шығуыңызды өтінемін!
Dialogue: 0,0:04:54.23,0:04:55.48,*Default-ja,NTP,0,0,0,,Олай болса, араласайық!
Dialogue: 0,0:04:56.06,0:04:57.55,Dialogue,,0,0,0,,Вай—, Кида!
Dialogue: 0,0:04:56.44,0:04:57.84,*Default-ja,NTP,0,0,0,,Эй... Кида-кун!
Dialogue: 0,0:04:57.55,0:04:59.39,Dialogue,,0,0,0,,Умм, мен...
Dialogue: 0,0:04:58.01,0:04:59.19,*Default-ja,NTP,0,0,0,,Мм... мен...
Dialogue: 0,0:04:59.39,0:05:01.55,Dialogue,,0,0,0,,Бірден жауап берудің қажеті жоқ.
Dialogue: 0,0:04:59.75,0:05:01.55,*Default-ja,NTP,0,0,0,,Бірден жауап берудің қажеті жоқ.
Dialogue: 0,0:05:01.55,0:05:05.53,Dialogue,,0,0,0,,Қазір мен хабар күтетін жеті қыз бар, мен қайсысымен кездесетінімді әлі шешіп жатырмын.
Dialogue: 0,0:05:01.72,0:05:03.72,*Default-ja,NTP,0,0,0,,Жауап күтіп тұрған 7 бала.
Dialogue: 0,0:05:03.85,0:05:05.68,*Default-ja,NTP,0,0,0,,Өйткені мен қай қызбен кездесуді шешіп жатырмын.
Dialogue: 0,0:05:05.53,0:05:08.55,Dialogue,,0,0,0,,Оны шындап қабылдаудың қажеті жоқ, Сонохара.
Dialogue: 0,0:05:05.90,0:05:08.63,*Default-ja,NTP,0,0,0,,Сонохара мырза, онымен шындап араласудың қажеті жоқ.
Dialogue: 0,0:05:08.55,0:05:10.22,Dialogue,,0,0,0,,Ол сізді шаршатады.
Dialogue: 0,0:05:08.87,0:05:10.30,*Default-ja,NTP,0,0,0,,Бұл жай ғана шаршатады
Dialogue: 0,0:05:10.22,0:05:14.87,Dialogue,,0,0,0,,Ол сенімен ойнап тұрғандай естіледі, бірақ бұл маңызды емес. Тіпті ол сені ұрса да, сайып келгенде...
Dialogue: 0,0:05:10.50,0:05:13.68,*Default-ja,NTP,0,0,0,,Сонымен қатар, сіз жай ғана көңіл көтеру сияқты нәрселерді айтсаңыз, бұл үлкен мәселе емес.
Dialogue: 0,0:05:13.76,0:05:15.14,*Default-ja,NTP,0,0,0,,Мен оны көтеріп алсам да, соңында...
Dialogue: 0,0:05:14.87,0:05:16.16,Dialogue,,0,0,0,,Эй, сен, Микадо!
Dialogue: 0,0:05:15.14,0:05:15.98,*Default-ja,NTP,0,0,0,,Сәлем, Микадо!
Dialogue: 0,0:05:19.00,0:05:22.55,Dialogue,,0,0,0,,Бұл жігіт менің ең жақын досым, Рюгамин Микадо.
Dialogue: 0,0:05:19.65,0:05:22.53,*Default-ja,NTP,0,0,0,,Бұл жігіт Рюгамин Микадо менің ең жақын досым.
Dialogue: 0,0:05:22.55,0:05:25.22,Dialogue,,0,0,0,,Ол Икебукурода бірнеше күн болған елді мекен.
Dialogue: 0,0:05:22.83,0:05:25.65,*Default-ja,NTP,0,0,0,,Икебукурада бірнеше күн болған адам.
Dialogue: 0,0:05:25.51,0:05:31.22,Dialogue,,0,0,0,,Ол қарапайым және аңғал болса да, ол біртүрлі қыңыр және сіз жалғыз қалдыра алмайтын адам.
Dialogue: 0,0:05:25.86,0:05:29.36,*Default-ja,NTP,0,0,0,,Ол аңғал, аңғал болса да, біртүрлі қыңыр.
Dialogue: 0,0:05:29.42,0:05:31.30,*Default-ja,NTP,0,0,0,,Неге екені белгісіз, мен оны жалғыз қалдыра алмаймын
Dialogue: 0,0:05:31.22,0:05:34.83,Dialogue,,0,0,0,,Мен бұл пәк баламен әйтеуір махаббат үшбұрышына араластым.
Dialogue: 0,0:05:31.64,0:05:34.79,*Default-ja,NTP,0,0,0,,Осындай пәк баламен күтпеген махаббат үшбұрышы
Dialogue: 0,0:05:34.83,0:05:36.92,Dialogue,,0,0,0,,«Жастар» деген осы ма?
Dialogue: 0,0:05:35.12,0:05:36.82,*Default-ja,NTP,0,0,0,,Жастық деген осы ма?
Dialogue: 0,0:05:37.86,0:05:39.16,Dialogue,,0,0,0,,Ой, бұл ауырды -
Dialogue: 0,0:05:38.63,0:05:39.48,*Default-ja,NTP,0,0,0,,Ой!
Dialogue: 0,0:05:39.16,0:05:41.19,Dialogue,,0,0,0,,Қане, Кида!
Dialogue: 0,0:05:39.71,0:05:41.94,Secondary,,0,0,0,,Сіз... бір-біріңізбен өте татусың.
Dialogue: 0,0:05:40.06,0:05:42.02,*Default-ja,NTP,0,0,0,,Біз жақсы доспыз, солай емес пе?
Dialogue: 0,0:05:41.94,0:05:43.63,Dialogue,,0,0,0,,Иә, біз.
Dialogue: 0,0:05:42.52,0:05:43.76,*Default-ja,NTP,0,0,0,,Иә, жақсы.
Dialogue: 0,0:05:43.63,0:05:45.84,Dialogue,,0,0,0,,Біз болғымыз келмейді, бірақ біз ажырамаспыз.
Dialogue: 0,0:05:43.85,0:05:45.22,*Default-ja,NTP,0,0,0,,Бұл шірік байланыс.
Dialogue: 0,0:05:45.84,0:05:46.53,Dialogue,,0,0,0,,Аға, аға, аға!
Dialogue: 0,0:05:46.06,0:05:47.05,*Default-ja,NTP,0,0,0,,Беріңіз Бер бер!
Dialogue: 0,0:05:46.93,0:05:49.36,Dialogue,,0,0,0,,Мұның бәрі қалай болғанын түсіндіру үшін...
Dialogue: 0,0:05:47.05,0:05:49.21,*Default-ja,NTP,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:05:49.36,0:05:51.58,Dialogue,,0,0,0,,Біз ашылу салтанатына дейінгі қадамдарымызды қайталауымыз керек.
Dialogue: 0,0:05:49.80,0:05:51.96,*Default-ja,NTP,0,0,0,,Оқиға ашылу салтанатына дейін созылады.
Dialogue: 0,0:05:53.54,0:05:55.88,Dialogue,,0,0,0,,Мен Ягири Сейджимін.
Dialogue: 0,0:05:54.01,0:05:55.46,*Default-ja,NTP,0,0,0,,Бұл Сейджи Ягири.
Dialogue: 0,0:05:55.88,0:05:57.75,Dialogue,,0,0,0,,Жыл жақсы өтеді деп үміттенемін.
Dialogue: 0,0:05:56.14,0:05:57.66,*Default-ja,NTP,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:05:57.75,0:06:01.92,Dialogue,,0,0,0,,Олай болса, Ягири, сен қазір отыра аласың.
Dialogue: 0,0:05:58.12,0:05:59.51,*Default-ja,NTP,0,0,0,,Кел, Ягири
Dialogue: 0,0:05:59.94,0:06:01.90,*Default-ja,NTP,0,0,0,,Орныңызға ерте отырыңыз.
Dialogue: 0,0:06:01.92,0:06:02.92,Dialogue,,0,0,0,,Маған қажет емес.
Dialogue: 0,0:06:02.18,0:06:03.12,*Default-ja,NTP,0,0,0,,Келмейді
Dialogue: 0,0:06:02.92,0:06:03.71,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:06:03.71,0:06:10.38,Dialogue,,0,0,0,,Мен мектепке біраз уақыт келемін деп ойламаймын — жоқ, енді ешқашан келмейтін шығармын.
Dialogue: 0,0:06:03.89,0:06:07.02,*Default-ja,NTP,0,0,0,,Біраз уақыт мектепке келе алмаймын деп ойлаймын.
Dialogue: 0,0:06:07.34,0:06:10.62,*Default-ja,NTP,0,0,0,,Жоқ, ол енді келмеуі мүмкін.
Dialogue: 0,0:06:11.18,0:06:15.05,Dialogue,,0,0,0,,Бұл мен үшін өте маңызды нәрсе.
Dialogue: 0,0:06:11.58,0:06:15.26,*Default-ja,NTP,0,0,0,,Мен үшін бұл менің өмірімдегі өте маңызды нәрсе.
Dialogue: 0,0:06:15.05,0:06:17.96,Dialogue,,0,0,0,,Менің сіз сияқтылармен босқа кететін уақытым жоқ.
Dialogue: 0,0:06:15.45,0:06:17.88,*Default-ja,NTP,0,0,0,,Менің сендермен айналысатын уақытым жоқ.
Dialogue: 0,0:06:17.96,0:06:19.77,Dialogue,,0,0,0,,Өтінемін, кешіріңіз.
Dialogue: 0,0:06:18.22,0:06:19.15,*Default-ja,NTP,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:20.11,0:06:23.72,Dialogue,,0,0,0,,Ягири, күте тұр. Мен: «Күте тұр!» дедім.
Dialogue: 0,0:06:20.47,0:06:21.90,*Default-ja,NTP,0,0,0,,Сәлем Ягири
Dialogue: 0,0:06:21.98,0:06:23.74,*Default-ja,NTP,0,0,0,,Күтіңіз... күтіңіз
Dialogue: 0,0:06:23.72,0:06:27.05,Dialogue,,0,0,0,,Дүние әртүрлі адамдарға толы...
Dialogue: 0,0:06:24.13,0:06:27.18,*Default-ja,NTP,0,0,0,,Ішінде неше түрлі адам бар деп ойлаймын.
Dialogue: 0,0:06:26.37,0:06:28.55,Secondary,,0,0,0,,Ягири, күте тұр!
Dialogue: 0,0:06:27.05,0:06:29.24,Dialogue,,0,0,0,,Немесе Микадо маған солай айтады.
Dialogue: 0,0:06:27.34,0:06:29.83,*Default-ja,NTP,0,0,0,,Мен мұны Микадодан кейін естідім және ойладым...
Dialogue: 0,0:06:30.11,0:06:31.57,Dialogue,,0,0,0,,Өтінемін, күте тұрыңыз!
Dialogue: 0,0:06:30.49,0:06:31.60,*Default-ja,NTP,0,0,0,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:06:31.57,0:06:34.80,Dialogue,,0,0,0,,Ғашық болу осындай болуы мүмкін бе?
Dialogue: 0,0:06:31.57,0:06:34.80,Secondary,,0,0,0,,Ягири, бірдеңе емес пе...
Dialogue: 0,0:06:32.11,0:06:34.61,*Default-ja,NTP,0,0,0,,Дәл осы сәт Fallen Love!
Dialogue: 0,0:06:34.80,0:06:35.78,Secondary,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:06:34.80,0:06:37.31,Dialogue,,0,0,0,,Оның маған күлгенінен ғана кеудем дірілдейді!
Dialogue: 0,0:06:34.96,0:06:37.27,*Default-ja,NTP,0,0,0,,Оның сүйкімді күлкісі жүрегімді елжіретеді!
Dialogue: 0,0:06:36.27,0:06:39.54,Secondary,,0,0,0,,Бұл-Бірақ...мектептің бірінші күні келмеу...
Dialogue: 0,0:06:37.31,0:06:39.54,Dialogue,,0,0,0,,Менің ойымша, ол күлген жоқ, бірақ бәрібір...
Dialogue: 0,0:06:37.66,0:06:39.13,*Default-ja,NTP,0,0,0,,Хаха... Жоқ, мен күлген жоқпын.
Dialogue: 0,0:06:39.54,0:06:41.17,Dialogue,,0,0,0,,Мен білмеймін дедім!
Dialogue: 0,0:06:39.84,0:06:41.14,*Default-ja,NTP,0,0,0,,Егер сіз білмесеңіз!
Dialogue: 0,0:06:41.17,0:06:42.01,Dialogue,,0,0,0,,Шынымен
Dialogue: 0,0:06:41.35,0:06:42.19,*Default-ja,NTP,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:42.01,0:06:43.29,Dialogue,,0,0,0,,Умм...
Dialogue: 0,0:06:42.34,0:06:43.25,*Default-ja,NTP,0,0,0,,Мм...
Dialogue: 0,0:06:43.29,0:06:44.80,Dialogue,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:06:43.76,0:06:44.70,*Default-ja,NTP,0,0,0,,Не болды?
Dialogue: 0,0:06:48.88,0:06:55.68,Dialogue,,0,0,0,,Қалай болғанда да, мен мүмкін болатын құрбылар тізіміндегі бірінші орындағы қызды бірден жаңарттым.
Dialogue: 0,0:06:49.37,0:06:54.75,*Default-ja,NTP,0,0,0,,Қалай болғанда да, менің дос қызымның кандидаттар тізімінде жылдам бірінші орынға ие болған қызбен.
Dialogue: 0,0:06:55.12,0:06:56.07,*Default-ja,NTP,0,0,0,,Бүгін...
Dialogue: 0,0:07:00.30,0:07:02.49,Dialogue,,0,0,0,,Сәлем, Сонохара.
Dialogue: 0,0:07:00.70,0:07:02.07,*Default-ja,NTP,0,0,0,,Сәлем Сонохара
Dialogue: 0,0:07:03.52,0:07:05.37,Dialogue,,0,0,0,,Үйге бара жатырсыз ба?
Dialogue: 0,0:07:04.03,0:07:05.23,*Default-ja,NTP,0,0,0,,Қазір үйге барасыз ба?
Dialogue: 0,0:07:05.37,0:07:06.56,Dialogue,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:07:05.74,0:07:06.53,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:07:07.98,0:07:12.67,Dialogue,,0,0,0,,Эй, Сонохара, сені бірдеңе мазалайды, солай ма?
Dialogue: 0,0:07:08.39,0:07:09.49,*Default-ja,NTP,0,0,0,,Сәлем Сонохара
Dialogue: 0,0:07:10.01,0:07:12.15,*Default-ja,NTP,0,0,0,,Саған бірдеңе жоқ па?
Dialogue: 0,0:07:12.67,0:07:16.99,Dialogue,,0,0,0,,Мүмкін сізді қорлап жатқан шығарсыз немесе қандай да бір қиыншылыққа қатысыңыз бар ма?
Dialogue: 0,0:07:12.88,0:07:16.83,*Default-ja,NTP,0,0,0,,Қорқыту немесе қиындыққа түсу
Dialogue: 0,0:07:16.99,0:07:17.99,Dialogue,,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,0:07:17.25,0:07:18.04,*Default-ja,NTP,0,0,0,,Жоқ…
Dialogue: 0,0:07:17.99,0:07:20.79,Dialogue,,0,0,0,,Бірдеңе болып қалса, бірден айт.
Dialogue: 0,0:07:18.36,0:07:20.98,*Default-ja,NTP,0,0,0,,Егер бірдеңе болса, маған дереу айт.
Dialogue: 0,0:07:22.10,0:07:23.46,Dialogue,,0,0,0,,Менде бәрі жақсы...
Dialogue: 0,0:07:22.48,0:07:23.64,*Default-ja,NTP,0,0,0,,Жарайды
Dialogue: 0,0:07:23.91,0:07:25.44,Dialogue,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:07:24.36,0:07:25.23,*Default-ja,NTP,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:07:25.44,0:07:28.12,Dialogue,,0,0,0,,Иә, Харима әлі мектепке келмеді, солай ма?
Dialogue: 0,0:07:25.64,0:07:28.17,*Default-ja,NTP,0,0,0,,Ойланып қарасам, Харима мектепке әлі келген жоқ па?
Dialogue: 0,0:07:28.12,0:07:30.46,Dialogue,,0,0,0,,Екеуің бір сыныпта болсаңдар да...
Dialogue: 0,0:07:28.38,0:07:30.72,*Default-ja,NTP,0,0,0,,Екеуміз бір сыныпта оқитын едік.
Dialogue: 0,0:07:31.13,0:07:35.97,Dialogue,,0,0,0,,Екеуіңді бір сыныпқа алу үшін көп еңбек еттім, білесің бе.
Dialogue: 0,0:07:31.47,0:07:35.59,*Default-ja,NTP,0,0,0,,Мен сізбен бір сыныпта болу үшін көп күш жұмсадым.
Dialogue: 0,0:07:35.97,0:07:40.55,Dialogue,,0,0,0,,Сіздің орта мектебіңізден Сайтоу мырза да екеуіңіздің бірге болуыңызды талап етті.
Dialogue: 0,0:07:36.35,0:07:40.35,*Default-ja,NTP,0,0,0,,Менің орта сыныптағы мұғалімім Сайто маған көмектесуімді өтінді.
Dialogue: 0,0:07:40.55,0:07:43.48,Dialogue,,0,0,0,,Сондықтан сіз тартынудың қажеті жоқ.
Dialogue: 0,0:07:40.78,0:07:42.96,*Default-ja,NTP,0,0,0,,Сондықтан сіз де ұстанбайсыз, солай ма?
Dialogue: 0,0:07:43.48,0:07:46.79,Dialogue,,0,0,0,,Дұрыс, бүгін сені үйге апарсам қалай болады?
Dialogue: 0,0:07:43.70,0:07:46.56,*Default-ja,NTP,0,0,0,,Дұрыс, мен сені бүгін сонда апарамын.
Dialogue: 0,0:07:46.79,0:07:51.49,Dialogue,,0,0,0,,Сіз «Слешер» фильмінің Икебукурода қайтадан пайда болғанын білесіз, солай емес пе?
Dialogue: 0,0:07:47.08,0:07:51.11,*Default-ja,NTP,0,0,0,,Сіз білесіз бе? Риппер Икебукурада қайтадан пайда болды.
Dialogue: 0,0:07:52.69,0:07:54.99,Dialogue,,0,0,0,,Насудзима мырза, сіз оған жыныстық қудалайсыз ба?!
Dialogue: 0,0:07:53.08,0:07:55.25,*Default-ja,NTP,0,0,0,,Доктор Насудзима, бұл жыныстық қудалау ма?
Dialogue: 0,0:07:57.24,0:08:01.40,Dialogue,,0,0,0,,Джэ, көзілдірік киген сынып өкілі айқайлап жіберді ме?
Dialogue: 0,0:07:57.72,0:08:01.10,*Default-ja,NTP,0,0,0,,Уау! Тәкаппар көзілдірік төраға тіпті сөйлей берсін.
Dialogue: 0,0:08:01.40,0:08:05.03,Dialogue,,0,0,0,,Бұл толық жыныстық қудалау емес пе?
Dialogue: 0,0:08:01.62,0:08:04.99,*Default-ja,NTP,0,0,0,,Бұл шынымен жыныстық қудалау ма?
Dialogue: 0,0:08:05.03,0:08:07.55,Dialogue,,0,0,0,,Әлде бұл сексуалдық ұят сияқты ма?
Dialogue: 0,0:08:05.36,0:08:07.70,*Default-ja,NTP,0,0,0,,Бұл сексуалды қудалау шоуына көбірек ұқсай ма?
Dialogue: 0,0:08:07.55,0:08:10.34,Dialogue,,0,0,0,,Жүр, Кида, ақымақтықты доғар.
Dialogue: 0,0:08:08.20,0:08:10.15,*Default-ja,NTP,0,0,0,,Кида Қалжыңдама!
Dialogue: 0,0:08:10.34,0:08:13.88,Dialogue,,0,0,0,,Сонохара, сен қате түсініп, біртүрлі қауесеттерді бастамайсың, солай ма?
Dialogue: 0,0:08:10.61,0:08:14.12,*Default-ja,NTP,0,0,0,,Сонохара, өтінемін, қате түсініп, біртүрлі қауесет таратпа.
Dialogue: 0,0:08:13.88,0:08:17.01,Dialogue,,0,0,0,,Ол жеңілтек әйелге ұқсайды ма?
Dialogue: 0,0:08:14.50,0:08:16.96,*Default-ja,NTP,0,0,0,,Ол сондай жеңілтек әйелге ұқсайды ма?
Dialogue: 0,0:08:17.01,0:08:19.89,Dialogue,,0,0,0,,Дұрыс айтасың, мен оны сенімен қалдырамын.
Dialogue: 0,0:08:17.18,0:08:18.84,*Default-ja,NTP,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:18.96,0:08:19.83,*Default-ja,NTP,0,0,0,,Өтінемін, мүлде.
Dialogue: 0,0:08:20.55,0:08:24.23,Dialogue,,0,0,0,,Уайымдама, өсек тарататын мен боламын!
Dialogue: 0,0:08:20.87,0:08:24.43,*Default-ja,NTP,0,0,0,,Негізі, қауесет тарататын менмін, уайымдамаңыз.
Dialogue: 0,0:08:28.15,0:08:30.57,Thought,,0,0,0,,Бұл мені қазіргі уақытта әділдіктің крест жорығына айналдыра ма?
Dialogue: 0,0:08:28.54,0:08:30.75,*Default-ja,NTP,0,0,0,,Сіз әділдіктің одақтасысыз ба?
Dialogue: 0,0:08:30.57,0:08:32.26,Thought,,0,0,0,,Мен дәл қазір сондай керемет болдым, солай емес пе?
Dialogue: 0,0:08:30.83,0:08:32.14,*Default-ja,NTP,0,0,0,,Мен қазір жақсы көрінемін, солай емес пе?
Dialogue: 0,0:08:32.26,0:08:34.86,Thought,,0,0,0,,Одан кейін кім болса да маған құмар еді.
Dialogue: 0,0:08:32.49,0:08:34.02,*Default-ja,NTP,0,0,0,,Әдетте сізге ұнайды.
Dialogue: 0,0:08:34.86,0:08:36.62,Dialogue,,0,0,0,,Кида? Ал Сонохара?
Dialogue: 0,0:08:35.10,0:08:36.97,*Default-ja,NTP,0,0,0,,Кида-кун? Сонохара мырза да
Dialogue: 0,0:08:36.62,0:08:39.62,Thought,,0,0,0,,Сіз одан да нашар уақытта келе аласыз ба?
Dialogue: 0,0:08:37.24,0:08:39.49,*Default-ja,NTP,0,0,0,,Қандай уақыт...
Dialogue: 0,0:08:44.24,0:08:45.62,Dialogue,,0,0,0,,Күткенім үшін кешіріңіз.
Dialogue: 0,0:08:44.57,0:08:45.53,*Default-ja,NTP,0,0,0,,Мүмкін… Сондықтан сендер
Dialogue: 0,0:08:45.62,0:08:47.13,Dialogue,,0,0,0,,Жер
Dialogue: 0,0:08:46.28,0:08:47.03,*Default-ja,NTP,0,0,0,,Хой
Dialogue: 0,0:08:47.13,0:08:48.96,Dialogue,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:08:47.36,0:08:48.77,*Default-ja,NTP,0,0,0,,Рахмет
Dialogue: 0,0:08:50.51,0:08:53.67,Dialogue,,0,0,0,,Бірақ бәрібір сақ болу керек.
Dialogue: 0,0:08:51.04,0:08:53.66,*Default-ja,NTP,0,0,0,,Бірақ сіз шынымен сақ болуыңыз керек.
Dialogue: 0,0:08:53.67,0:09:00.05,Dialogue,,0,0,0,,Насудзима туралы қауесеттердің көпшілігі дәл солай, бірақ оның студентке қолын созғаны рас.
Dialogue: 0,0:08:54.24,0:08:57.61,*Default-ja,NTP,0,0,0,,Насу аралынан келген бейбақ туралы қауесеттердің көпшілігі жай ғана қауесет.
Dialogue: 0,0:08:57.92,0:09:00.27,*Default-ja,NTP,0,0,0,,Оның шәкіртіне қолын қойғаны маңызды.
Dialogue: 0,0:09:00.05,0:09:00.81,Dialogue,,0,0,0,,Сол қызға не болды?
Dialogue: 0,0:09:00.81,0:09:06.00,Dialogue,,0,0,0,,Ниекава Харуна есімді екінші курс студенті екінші тоқсанда оқуға ауыстырылды.
Dialogue: 0,0:09:00.96,0:09:03.34,*Default-ja,NTP,0,0,0,,Харуна Такугава менен екі жас үлкен.
Dialogue: 0,0:09:03.58,0:09:05.88,*Default-ja,NTP,0,0,0,,Мен мектептерді өткен жылдың екінші семестрінде ауыстырдым.
Dialogue: 0,0:09:06.00,0:09:10.31,Dialogue,,0,0,0,,Оған себеп, адамдар оның Насудзимамен кездесіп жүргенін білуі болса керек.
Dialogue: 0,0:09:06.16,0:09:10.32,*Default-ja,NTP,0,0,0,,Ол Насудзимамен кездесіп жүргенін біліп алайын деп тұрған сияқты.
Dialogue: 0,0:09:10.31,0:09:11.38,Dialogue,,0,0,0,,Мен бір қолымда оқ жалғанған винтовка ұстап тұрмын
Dialogue: 0,0:09:10.53,0:09:11.43,*Default-ja,NTP,0,0,0,,Шынымен!?
Dialogue: 0,0:09:11.38,0:09:17.11,Dialogue,,0,0,0,,Оның ауыстырғысы келді ме, Насудзима оны қорқытты ма, әлде мектеп оны мәжбүрледі ме, ешкім білмейді.
Dialogue: 0,0:09:11.65,0:09:14.58,*Default-ja,NTP,0,0,0,,Сіз өз еркіңізбен тастадыңыз ба әлде Насудзима қорқытты ма?
Dialogue: 0,0:09:14.70,0:09:17.39,*Default-ja,NTP,0,0,0,,Мектеп мені ауыстыруға мәжбүр етті ме, білмеймін.
Dialogue: 0,0:09:17.11,0:09:20.94,Dialogue,,0,0,0,,Қалай болғанда да, егер саған бірдеңе болса, Микадо екеуміз бірдеңе жасаймыз.
Dialogue: 0,0:09:17.91,0:09:20.92,*Default-ja,NTP,0,0,0,,Ал, егер бірдеңе болса, Микадо екеуміз бірдеңе жасаймыз.
Dialogue: 0,0:09:20.94,0:09:22.34,Dialogue,,0,0,0,,Дұрыс, Микадо?
Dialogue: 0,0:09:21.14,0:09:21.92,*Default-ja,NTP,0,0,0,,Сәлем Микадо
Dialogue: 0,0:09:22.00,0:09:23.32,*Default-ja,NTP,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:09:23.26,0:09:28.11,Dialogue,,0,0,0,,Мен жағдайды толық түсінбеймін, бірақ мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:09:23.67,0:09:25.68,*Default-ja,NTP,0,0,0,,Мен жағдайды толық түсіне алмаймын.
Dialogue: 0,0:09:26.02,0:09:28.16,*Default-ja,NTP,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:09:28.11,0:09:33.51,Dialogue,,0,0,0,,Уф. Бұл жерде сіз «Мен мұны істей алмайтын шығармын, бірақ мен махаббаттың күшімен істей аламын!» деуіңіз керек.
Dialogue: 0,0:09:28.32,0:09:29.94,*Default-ja,NTP,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:09:30.05,0:09:33.34,*Default-ja,NTP,0,0,0,,«Бұл менің қолымнан келмейтін нәрсе болуы мүмкін, бірақ махаббаттың күшімен мен мұны істеймін».
Dialogue: 0,0:09:33.51,0:09:36.07,Dialogue,,0,0,0,,Осылай айтпасаң, еркек емессің.
Егер сіз
Dialogue: 0,0:09:33.70,0:09:36.23,*Default-ja,NTP,0,0,0,,сияқты бірдеңе айта алмасаңыз, сіз еркек емессіз.
Dialogue: 0,0:09:36.07,0:09:38.09,Dialogue,,0,0,0,,А? Бұл қайшылық емес пе?
Dialogue: 0,0:09:36.74,0:09:37.94,*Default-ja,NTP,0,0,0,,Бұл қайшылық.
Dialogue: 0,0:09:38.09,0:09:39.21,Dialogue,,0,0,0,,Мен тек ағынмен жүрмін.
Dialogue: 0,0:09:38.14,0:09:39.09,*Default-ja,NTP,0,0,0,,Өйткені бұл ойық
Dialogue: 0,0:09:39.21,0:09:41.10,Dialogue,,0,0,0,,Ең бастысы, бұрын...
Dialogue: 0,0:09:39.47,0:09:40.94,*Default-ja,NTP,0,0,0,,Бұған дейін
Dialogue: 0,0:09:41.10,0:09:41.98,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:09:41.98,0:09:44.31,Dialogue,,0,0,0,,Сізді қорлаған қыздар сіздің орта мектебіңізден еді ғой?
Dialogue: 0,0:09:42.22,0:09:44.55,*Default-ja,NTP,0,0,0,,Сені қорлаған балалар да солай емес пе?
Dialogue: 0,0:09:44.31,0:09:46.10,Dialogue,,0,0,0,,H-Сен қайдан білдің?
Dialogue: 0,0:09:45.03,0:09:46.46,*Default-ja,NTP,0,0,0,,Нені...қайдан білесің?
Dialogue: 0,0:09:46.10,0:09:52.87,Dialogue,,0,0,0,,Әңгімеңізді тыңдай отырып, мен олар болуы керек деп ойладым.
Dialogue: 0,0:09:46.77,0:09:49.41,*Default-ja,NTP,0,0,0,,Жоқ, сол әңгімеге қарағанда...
Dialogue: 0,0:09:49.63,0:09:52.76,*Default-ja,NTP,0,0,0,,Мен орта мектепте оқып жүргенімде маған өнерлі балалар көмектесті.
Dialogue: 0,0:09:52.87,0:09:56.82,Dialogue,,0,0,0,,«Сізді жақсы адам құтқарды, бірақ қазір ол жоғалып кеткеннен кейін олар қайтып келді» деген сияқты.
Dialogue: 0,0:09:53.11,0:09:56.85,*Default-ja,NTP,0,0,0,,Бала кеткен бойда кәрі жігіттер тағы келді.
Dialogue: 0,0:09:56.82,0:10:01.28,Dialogue,,0,0,0,,Хмм? Досың жоғалып кетті ме? Оны әлі ешкім тапқан жоқ...
Dialogue: 0,0:09:57.12,0:10:00.05,*Default-ja,NTP,0,0,0,,Бұл не? кеткен достар
Dialogue: 0,0:10:00.21,0:10:01.47,*Default-ja,NTP,0,0,0,,Мен оны әлі таба алмаймын.
Dialogue: 0,0:10:01.28,0:10:04.64,Dialogue,,0,0,0,,Бұл біздің сыныптағы Харима Мика, солай емес пе?
Dialogue: 0,0:10:01.74,0:10:04.21,*Default-ja,NTP,0,0,0,,Бұл менің сыныптағы Мика Харима, солай ма?
Dialogue: 0,0:10:06.75,0:10:14.50,Dialogue,,0,0,0,,Мика мектепте жоқ деп белгіленді, бірақ ол ашылу салтанатына дейін үйге келмеді.
Dialogue: 0,0:10:07.23,0:10:11.08,*Default-ja,NTP,0,0,0,,Мика-сан, сен сабаққа келмейсің.
Dialogue: 0,0:10:11.33,0:10:14.52,*Default-ja,NTP,0,0,0,,Мен үйге кіру рәсімінен бұрын келген жоқпын.
Dialogue: 0,0:10:14.50,0:10:16.80,Dialogue,,0,0,0,,Бұл туралы полицияға айту керек.
Dialogue: 0,0:10:14.83,0:10:16.55,*Default-ja,NTP,0,0,0,,Бұл полицияның ауыр оқиғасы.
Dialogue: 0,0:10:16.80,0:10:21.12,Dialogue,,0,0,0,,Ол менің ұялы телефоныма және Хариманың үйіне хабарласты.
Dialogue: 0,0:10:17.24,0:10:20.88,*Default-ja,NTP,0,0,0,,Менің ұялы телефоныма және Харима мырзаның үйіне хабарласты.
Dialogue: 0,0:10:21.12,0:10:25.01,Dialogue,,0,0,0,,Ол: «Жаратқан жүрегімді емдеу үшін сапарға барамын, уайымдама» деді.
Dialogue: 0,0:10:21.39,0:10:24.92,*Default-ja,NTP,0,0,0,,«Мен азғантай саяхатқа барамын, бұл туралы уайымдама».
Dialogue: 0,0:10:25.01,0:10:27.51,Dialogue,,0,0,0,,Оның жараланған жүрегін емдеуге сапар? Бірдеңе болды ма?
Dialogue: 0,0:10:25.36,0:10:27.59,*Default-ja,NTP,0,0,0,,Жүректің ауыруы ма? Бірдеңе болды ма?
Dialogue: 0,0:10:27.51,0:10:32.56,Dialogue,,0,0,0,,Умм...сен ренжімей тыңдауға уәде бересің бе?
Dialogue: 0,0:10:27.80,0:10:29.87,*Default-ja,NTP,0,0,0,,Бұл... у...
Dialogue: 0,0:10:30.42,0:10:32.62,*Default-ja,NTP,0,0,0,,Таң қалмай тыңдай аласыз ба?
Dialogue: 0,0:10:32.56,0:10:36.49,Dialogue,,0,0,0,,Соңғы бірнеше күнде болған оқиғадан кейін мені көп нәрсе таң қалдырмайды.
Dialogue: 0,0:10:32.98,0:10:36.42,*Default-ja,NTP,0,0,0,,Соңғы бірнеше күнде көп нәрсе мені таң қалдырмайды.
Dialogue: 0,0:10:37.36,0:10:41.03,Dialogue,,0,0,0,,Харима... аңдыушы.
Dialogue: 0,0:10:37.76,0:10:41.06,*Default-ja,NTP,0,0,0,,Харима мырза аңдыушы.
Dialogue: 0,0:10:42.57,0:10:43.94,Dialogue,,0,0,0,,Б... бір сызық
Dialogue: 0,0:10:42.98,0:10:44.10,*Default-ja,NTP,0,0,0,,Мен көремін.
Dialogue: 0,0:10:43.94,0:10:46.54,Dialogue,,0,0,0,,Міне, сіз ол жігіттен осы туралы сұрадыңыз.
Dialogue: 0,0:10:44.16,0:10:46.86,*Default-ja,NTP,0,0,0,,Демек, ол кеше сен сұраған жігіт пе?
Dialogue: 0,0:10:46.54,0:10:51.31,Dialogue,,0,0,0,,Мика өзін аңдып жүрген жігітті лақтырып жібергеннен кейін жүрегін жаралаған сапарға шықты.
Dialogue: 0,0:10:47.15,0:10:48.66,*Default-ja,NTP,0,0,0,,Мен оның соңынан ердім...
Dialogue: 0,0:10:48.80,0:10:51.39,*Default-ja,NTP,0,0,0,,Жоқ, қыз алысып жүрген Мика-чан
Dialogue: 0,0:10:51.31,0:10:53.38,Dialogue,,0,0,0,,Оның отбасына қалдырғаннан басқа қолымыздан ештеңе келмейтін сияқты.
Dialogue: 0,0:10:51.54,0:10:53.80,*Default-ja,NTP,0,0,0,,Ол тастап кеткендіктен жүрегі жаралы сапарға шыққанын айтты.
Dialogue: 0,0:10:54.57,0:10:59.49,Dialogue,,0,0,0,,Егер ол әлі оралмаса, біз тек полицияға хабарласуымыз керек.
Dialogue: 0,0:10:54.99,0:10:57.18,*Default-ja,NTP,0,0,0,,Мен мұны отбасыма қалдыруым керек шығар.
Dialogue: 0,0:10:57.40,0:10:59.30,*Default-ja,NTP,0,0,0,,Уақыты келгенде полицияға айтасың.
Dialogue: 0,0:11:01.41,0:11:04.18,Dialogue,,0,0,0,,Ол сенімен жақын дос болды ма, Сонохара?
Dialogue: 0,0:11:01.72,0:11:04.35,*Default-ja,NTP,0,0,0,,Сонохара-санмен жақсы дос болдың ба?
Dialogue: 0,0:11:04.18,0:11:06.18,Thought,,0,0,0,,Сұраулы сөйлемде не бар?
Dialogue: 0,0:11:04.74,0:11:06.32,*Default-ja,NTP,0,0,0,,Не? Сұрақ формасы
Dialogue: 0,0:11:06.93,0:11:09.89,Dialogue,,0,0,0,,Әрқашан бірге болғанымыз рас.
Dialogue: 0,0:11:07.33,0:11:10.03,*Default-ja,NTP,0,0,0,,Әрқашан бірге болғанымыз рас.
Dialogue: 0,0:11:09.89,0:11:12.90,Thought,,0,0,0,,Менің ойымша, оның интуициясы кейбір нәрселерге жақсы.
Dialogue: 0,0:11:10.47,0:11:12.77,*Default-ja,NTP,0,0,0,,Бұл жігіттің біртүрлі жағынан жақсы түйсігі бар.
Dialogue: 0,0:11:12.90,0:11:21.15,Dialogue,,0,0,0,,Мен көп нәрседен ыңғайсызмын және адамдармен қарым-қатынас жасауда онша жақсы емеспін, бірақ Мика мені әрқашан жеңетін.
Dialogue: 0,0:11:13.23,0:11:17.79,*Default-ja,NTP,0,0,0,,Мен көп жағынан ебедеймін, адамдармен жақсы араласпаймын.
Dialogue: 0,0:11:18.03,0:11:20.96,*Default-ja,NTP,0,0,0,,Мені үнемі тартып тұратын Мика еді...
Dialogue: 0,0:11:21.52,0:11:27.20,Dialogue,,0,0,0,,Оның менімен бір орта мектепті таңдағанына өзімді жаман сезіндім.
Dialogue: 0,0:11:21.83,0:11:24.64,*Default-ja,NTP,0,0,0,,Сіз мен сияқты орта мектепті таңдау үшін бар күшіңізді салдыңыз.
Dialogue: 0,0:11:24.99,0:11:27.22,*Default-ja,NTP,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:11:27.20,0:11:28.54,Dialogue,,0,0,0,,Бұл...
Dialogue: 0,0:11:27.91,0:11:28.76,*Default-ja,NTP,0,0,0,,Бұл...
Dialogue: 0,0:11:28.54,0:11:35.96,Thought,,0,0,0,,Мика оны ерекшелеу үшін пайдаланғандықтан оны жібергісі келмеді деп ойласаңыз да, бұлай айтпауыңыз керек, Микадо.
Dialogue: 0,0:11:28.79,0:11:32.01,*Default-ja,NTP,0,0,0,,Себебі мен сені жібергім келмеді, менің фольгам...
Dialogue: 0,0:11:32.06,0:11:36.05,*Default-ja,NTP,0,0,0,,Не ойласаң да, дауыстап айтпа, Микадо-кун.
Dialogue: 0,0:11:35.96,0:11:36.96,Dialogue,,0,0,0,,Мұнда.
Dialogue: 0,0:11:36.21,0:11:37.24,*Default-ja,NTP,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:11:36.96,0:11:37.54,Dialogue,,0,0,0,,Тағы бір қосымша сабақ па, иә...
Dialogue: 0,0:11:37.54,0:11:38.46,Dialogue,,0,0,0,,Сіз не білесіз?
Dialogue: 0,0:11:37.86,0:11:38.81,*Default-ja,NTP,0,0,0,,Не?
Dialogue: 0,0:11:38.46,0:11:41.77,Dialogue,,0,0,0,,Ол мені жай ғана әдемі көріну үшін пайдаланды.
Dialogue: 0,0:11:38.97,0:11:41.68,*Default-ja,NTP,0,0,0,,Мен Миканың фольгасымын
Dialogue: 0,0:11:41.77,0:11:45.01,Dialogue,,0,0,0,,Мен де оны пайдаландым.
Dialogue: 0,0:11:42.04,0:11:44.62,*Default-ja,NTP,0,0,0,,Сондықтан мен де оны қолдандым.
Dialogue: 0,0:11:45.01,0:11:50.31,Dialogue,,0,0,0,,Өмір жеңіл болады деп ойладым, оған тәуелді болмасам өмір сүре алмаймын.
Dialogue: 0,0:11:45.23,0:11:47.62,*Default-ja,NTP,0,0,0,,Тәуелді өмір сүру оңайырақ
Dialogue: 0,0:11:47.93,0:11:50.23,*Default-ja,NTP,0,0,0,,Себебі мен мұны істемесем өмір сүре алмаймын деп ойладым.
Dialogue: 0,0:11:50.31,0:11:51.44,Dialogue,,0,0,0,,Жарайды...
Dialogue: 0,0:11:51.44,0:11:56.14,Dialogue,,0,0,0,,Бірақ қазір бұл соншалықты маңызды емес деп ойлаймын.
Dialogue: 0,0:11:51.69,0:11:55.73,*Default-ja,NTP,0,0,0,,Бірақ қазір бұл соншалықты қажет емес деп ойлаймын.
Dialogue: 0,0:11:56.14,0:12:00.01,Dialogue,,0,0,0,,Мен онсыз өмір сүруге бейімделдім.
Dialogue: 0,0:11:56.52,0:11:59.99,*Default-ja,NTP,0,0,0,,Мен қызым жоқ жағдайға үйреніп бара жатырмын.
Dialogue: 0,0:12:00.01,0:12:09.17,Dialogue,,0,0,0,,Мен сынып жетекшісі болдым, өйткені ол қалағандықтан, мен оны кем дегенде оның орнына жасауым керек деп ойладым.
Dialogue: 0,0:12:00.26,0:12:01.84,*Default-ja,NTP,0,0,0,,Мен де сынып мүшесі болдым.
Dialogue: 0,0:12:02.09,0:12:05.17,*Default-ja,NTP,0,0,0,,Сынып өкілі Харима мырза ұстағысы келетін лауазым болды.
Dialogue: 0,0:12:05.90,0:12:08.79,*Default-ja,NTP,0,0,0,,Ең болмағанда мен мұны сен үшін істеуім керек.
Dialogue: 0,0:12:09.79,0:12:13.93,Dialogue,,0,0,0,,Мен сынып жетекшісі болсам, одан асып түсетіндей болдым.
Dialogue: 0,0:12:10.25,0:12:13.61,*Default-ja,NTP,0,0,0,,Мен сынып өкілі болсам, одан асып түсетін сияқтымын.
Dialogue: 0,0:12:13.93,0:12:16.34,Dialogue,,0,0,0,,Бұл алдау сияқты, солай емес пе?
Dialogue: 0,0:12:14.13,0:12:16.14,*Default-ja,NTP,0,0,0,,Бұл жасырын, солай емес пе? Мынадай нәрсе...
Dialogue: 0,0:12:17.31,0:12:20.55,Dialogue,,0,0,0,,Менің ойымша, алдау дегеніміз – осының бәрін адамдарға айту.
Dialogue: 0,0:12:17.69,0:12:20.58,*Default-ja,NTP,0,0,0,,Менің ойымша, ең қиын нәрсе - адамдарға мұны айту үшін бар күшіңізбен бару.
Dialogue: 0,0:12:21.76,0:12:25.76,Dialogue,,0,0,0,,Сіз біреуді кешіруге тырысып жатқан сияқтысыз.
Dialogue: 0,0:12:22.14,0:12:25.59,*Default-ja,NTP,0,0,0,,Біреуді кешіруге тырысатын сияқты.
Dialogue: 0,0:12:25.76,0:12:29.93,Dialogue,,0,0,0,,Харимадан асып түсуге тырысу - дұрыс әрекет.
Dialogue: 0,0:12:26.25,0:12:29.79,*Default-ja,NTP,0,0,0,,Харима мырзадан жақсы болуды мақсат ету - дұрыс таңдау.
Dialogue: 0,0:12:29.93,0:12:34.23,Dialogue,,0,0,0,,Сондықтан сіз басыңызды жоғары ұстап, сенімдірек болуыңыз керек.
Dialogue: 0,0:12:30.37,0:12:33.84,*Default-ja,NTP,0,0,0,,Сондықтан кеудеңізді көбірек созып, абыройлы болғаныңыз дұрыс болар еді деп ойлаймын.
Dialogue: 0,0:12:35.88,0:12:36.98,Dialogue,,0,0,0,,Умм...
Dialogue: 0,0:12:40.65,0:12:42.55,Dialogue,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:12:40.99,0:12:44.21,*Default-ja,NTP,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:12:42.55,0:12:43.61,Dialogue,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:12:44.11,0:12:48.48,Thought,,0,0,0,,Маған бұл жігіт ұнайды.
Dialogue: 0,0:12:44.43,0:12:47.84,*Default-ja,NTP,0,0,0,,Маған бұл жігіттің осы қыры қатты ұнайды.
Dialogue: 0,0:12:51.34,0:12:52.54,Dialogue,,0,0,0,,Бала!
Dialogue: 0,0:12:51.56,0:12:52.76,*Default-ja,NTP,0,0,0,,Кида-кун!
Dialogue: 0,0:12:52.54,0:12:53.89,Dialogue,,0,0,0,,Сен сондай ақсақсың!
Dialogue: 0,0:12:53.10,0:12:53.99,*Default-ja,NTP,0,0,0,,Өте жаман!
Dialogue: 0,0:12:53.89,0:12:56.18,Dialogue,,0,0,0,,«Ақсақ», иә?
Dialogue: 0,0:12:54.10,0:12:55.43,*Default-ja,NTP,0,0,0,,Бұл тамаша емес...
Dialogue: 0,0:12:59.12,0:13:01.44,Dialogue,,0,0,0,,А? Икебукуродағы ең күшті?
Dialogue: 0,0:12:59.42,0:13:01.50,*Default-ja,NTP,0,0,0,,Иә~ Икебукуроның мықтысы ма?
Dialogue: 0,0:13:01.44,0:13:03.00,Dialogue,,0,0,0,,Иә, ең күшті.
Dialogue: 0,0:13:01.61,0:13:02.88,*Default-ja,NTP,0,0,0,,Иә, ең күшті
Dialogue: 0,0:13:03.00,0:13:04.45,Dialogue,,0,0,0,,Сіз қандай да бір журналдансыз ба?
Dialogue: 0,0:13:03.16,0:13:04.40,*Default-ja,NTP,0,0,0,,Ағай: Журналист жігіт пе?
Dialogue: 0,0:13:04.45,0:13:06.25,Dialogue,,0,0,0,,«Ең күшті?» дегенді білдіреді. Бұл тым күлкілі.
Dialogue: 0,0:13:04.66,0:13:06.40,*Default-ja,NTP,0,0,0,,Ең күштісі қандай? Өте танымал
Dialogue: 0,0:13:06.25,0:13:09.65,Dialogue,,0,0,0,,Егер сіз Икебукуродағы ең күшті адам туралы айтып жатсаңыз, бұл қара байкер болуы керек.
Dialogue: 0,0:13:06.51,0:13:08.44,*Default-ja,NTP,0,0,0,,Дұрыс, ең күшті болса ше?
Dialogue: 0,0:13:08.52,0:13:09.77,*Default-ja,NTP,0,0,0,,Мынау қара велосипед мінген жігіт.
Dialogue: 0,0:13:09.65,0:13:10.47,Dialogue,,0,0,0,,Мен бұл туралы естідім.
Dialogue: 0,0:13:09.87,0:13:10.81,*Default-ja,NTP,0,0,0,,Мен білемін
Dialogue: 0,0:13:10.47,0:13:12.26,Dialogue,,0,0,0,,Оның басы жоқ, солай ма?
Dialogue: 0,0:13:10.92,0:13:12.28,*Default-ja,NTP,0,0,0,,Бұл басы жоқ, солай ма?
Dialogue: 0,0:13:12.26,0:13:13.54,Dialogue,,0,0,0,,Ұнады, мүмкін емес!
Dialogue: 0,0:13:12.56,0:13:13.55,*Default-ja,NTP,0,0,0,,Өтірік~
Dialogue: 0,0:13:13.54,0:13:15.97,Dialogue,,0,0,0,,The Slasher туралы не деуге болады?
Dialogue: 0,0:13:13.67,0:13:15.98,*Default-ja,NTP,0,0,0,,Ал Риппер ше?
Dialogue: 0,0:13:15.97,0:13:17.48,Dialogue,,0,0,0,,Иә, бұл.
Dialogue: 0,0:13:16.33,0:13:17.96,*Default-ja,NTP,0,0,0,,А, солай~
Dialogue: 0,0:13:17.99,0:13:21.34,Dialogue,,0,0,0,,Бірақ сіз бұл жерде ең күшті топ Доллар деп айтар едіңіз, солай емес пе?
Dialogue: 0,0:13:18.20,0:13:21.37,*Default-ja,NTP,0,0,0,,Бірақ дәл қазір бұл қаладағы ең күшті адам доллар болар еді, солай емес пе?
Dialogue: 0,0:13:21.34,0:13:22.11,Dialogue,,0,0,0,,Доллар?
Dialogue: 0,0:13:21.56,0:13:22.53,*Default-ja,NTP,0,0,0,,Доллар?
Dialogue: 0,0:13:22.11,0:13:23.99,Dialogue,,0,0,0,,Иә, доллар!
Dialogue: 0,0:13:22.75,0:13:24.20,*Default-ja,NTP,0,0,0,,Иә, доллар!
Dialogue: 0,0:13:23.99,0:13:26.02,Dialogue,,0,0,0,,Мен бұл жерден басқа жолмен барамын.
Dialogue: 0,0:13:24.48,0:13:25.90,*Default-ja,NTP,0,0,0,,Онда мен осындамын
Dialogue: 0,0:13:26.02,0:13:28.01,Dialogue,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:13:26.17,0:13:27.92,*Default-ja,NTP,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:13:28.01,0:13:29.14,Dialogue,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:13:28.16,0:13:29.38,*Default-ja,NTP,0,0,0,,Сіз, Басшының орынбасары, қазір тергеу штабында қанша адам қалғанын білесіз ғой.
Dialogue: 0,0:13:29.14,0:13:30.78,Dialogue,,0,0,0,,Қош бол, Анри!
Dialogue: 0,0:13:29.46,0:13:31.05,*Default-ja,NTP,0,0,0,,Сау бол Анри Чан
Dialogue: 0,0:13:31.12,0:13:36.53,Dialogue,,0,0,0,,Мен бұл туралы бұрын ойлағанмын, бірақ бәлкім, біз әлгі Мика қызды Ягиримен бірге табатын шығармыз.
Dialogue: 0,0:13:31.48,0:13:32.46,*Default-ja,NTP,0,0,0,,Мен ойладым
Dialogue: 0,0:13:32.97,0:13:36.46,*Default-ja,NTP,0,0,0,,Менің ойымша, Ягири-кун мен Мика бірге ғой?
Dialogue: 0,0:13:36.53,0:13:38.32,Dialogue,,0,0,0,,Сіз аңдыушы және оның құрбаны сияқты дейсіз бе?
Dialogue: 0,0:13:36.81,0:13:38.43,*Default-ja,NTP,0,0,0,,Сталкер және құрбан?
Dialogue: 0,0:13:38.32,0:13:41.49,Dialogue,,0,0,0,,Мүмкін ол оны ұрлап кеткен шығар.
Dialogue: 0,0:13:38.61,0:13:41.24,*Default-ja,NTP,0,0,0,,Ягири-кунды сол бала ұрлап әкетті.
Dialogue: 0,0:13:41.49,0:13:42.54,Dialogue,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:13:41.87,0:13:42.90,*Default-ja,NTP,0,0,0,,Мен көремін.
Dialogue: 0,0:13:42.54,0:13:44.01,Dialogue,,0,0,0,,Адамдар жоғалып кетті...
Dialogue: 0,0:13:42.99,0:13:45.47,*Default-ja,NTP,0,0,0,,Мен біреуді іздеуден басқа не істеуім керек?
Dialogue: 0,0:13:44.01,0:13:45.11,Dialogue,,0,0,0,,Бірақ біз оларды қалай іздейміз?
Dialogue: 0,0:13:45.11,0:13:48.15,Dialogue,,0,0,0,,Оларды жай қалдырыңыз. Ол уайымдама деді.
Dialogue: 0,0:13:45.53,0:13:48.28,*Default-ja,NTP,0,0,0,,Оны жайына қалдырыңыз, ол жеткілікті айтты.
Dialogue: 0,0:13:48.15,0:13:51.19,Dialogue,,0,0,0,,Мұны тек ұйымдасқан топ жеңе алады...
Dialogue: 0,0:13:48.35,0:13:50.72,*Default-ja,NTP,0,0,0,,Менің ойымша, бұл ұйымсыз немесе басқа нәрсесіз мүмкін емес пе?
Dialogue: 0,0:13:51.19,0:13:52.51,Dialogue,,0,0,0,,Доллар сияқты.
Dialogue: 0,0:13:51.57,0:13:52.74,*Default-ja,NTP,0,0,0,,Доллар және т.б.
Dialogue: 0,0:13:52.84,0:13:54.03,Dialogue,,0,0,0,,Микадо...
Dialogue: 0,0:13:53.19,0:13:56.91,*Default-ja,NTP,0,0,0,,Микадо... Сіз шынымен долларға қосылғыңыз келеді деп ойлайсыз ба?
Dialogue: 0,0:13:54.03,0:13:56.81,Dialogue,,0,0,0,,Сіз The Dollars-қа қосылуды ойламайсыз, солай ма?
Dialogue: 0,0:13:56.81,0:13:58.84,Dialogue,,0,0,0,,А? Жоқ.
Dialogue: 0,0:13:57.82,0:13:58.87,*Default-ja,NTP,0,0,0,,Жоқ!
Dialogue: 0,0:13:58.84,0:14:00.64,Dialogue,,0,0,0,,Жоқ.
Dialogue: 0,0:13:59.15,0:14:00.55,*Default-ja,NTP,0,0,0,,Шынымен, тоқтатыңыз.
Dialogue: 0,0:14:00.64,0:14:03.20,Dialogue,,0,0,0,,Адамдар жас және әсерлі болған кезде ғана бандаларға қосылады.
Dialogue: 0,0:14:00.81,0:14:03.13,*Default-ja,NTP,0,0,0,,Түсті бандалар жастық қиялға жатады.
Dialogue: 0,0:14:03.20,0:14:05.11,Dialogue,,0,0,0,,Сонымен қатар, адамдардың көпшілігі оларға қосылғанына өкінеді.
Dialogue: 0,0:14:03.36,0:14:05.23,*Default-ja,NTP,0,0,0,,Мен әдетте кейін өкінемін.
Dialogue: 0,0:14:05.11,0:14:08.61,Dialogue,,0,0,0,,Умм...иә, бірақ біз әлі жаспыз және әсерліміз...
Dialogue: 0,0:14:05.44,0:14:06.19,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:14:06.42,0:14:08.71,*Default-ja,NTP,0,0,0,,Бірақ біз әлі де жастық бейімділіктеміз.
Dialogue: 0,0:14:09.03,0:14:10.43,Dialogue,,0,0,0,,Мен өттім.
Dialogue: 0,0:14:10.32,0:14:11.03,*Default-ja,NTP,0,0,0,,Шынымен...
Dialogue: 0,0:14:10.43,0:14:11.95,Dialogue,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:14:11.13,0:14:11.68,*Default-ja,NTP,0,0,0,,Не? иә?
Dialogue: 0,0:14:11.95,0:14:17.06,Dialogue,,0,0,0,,Микадо Икебукураға келгенге дейін мен қатты күйзелдім.
Dialogue: 0,0:14:12.38,0:14:14.04,*Default-ja,NTP,0,0,0,,Микадо Икебукураға келгенге дейін
Dialogue: 0,0:14:14.70,0:14:16.25,*Default-ja,NTP,0,0,0,,Мен қатты күйзелдім.
Dialogue: 0,0:14:17.06,0:14:22.03,Dialogue,,0,0,0,,Мен көптеген адамдардың арқасында осы күнді жеңе аламын...
Dialogue: 0,0:14:17.52,0:14:19.85,*Default-ja,NTP,0,0,0,,Мен қазір осындай нәрсені жасай аламын.
Dialogue: 0,0:14:20.43,0:14:22.09,*Default-ja,NTP,0,0,0,,Міне, мұның бәрі көп адамның арқасы.
Dialogue: 0,0:14:22.03,0:14:24.59,Dialogue,,0,0,0,,Бірақ бұл да Микадоның арқасында.
Dialogue: 0,0:14:22.57,0:14:24.27,*Default-ja,NTP,0,0,0,,Бұл да Тэйджиннің арқасында...
Dialogue: 0,0:14:24.90,0:14:30.59,Dialogue,,0,0,0,,Ол Икебукуроға жаңадан таныс және әлі де ыстық атмосфераға осал.
Dialogue: 0,0:14:25.29,0:14:27.85,*Default-ja,NTP,0,0,0,,Ол жаңа ғана Икебукураға келді.
Dialogue: 0,0:14:28.23,0:14:30.25,*Default-ja,NTP,0,0,0,,Бұл қаланың ыстығы мені ренжіте береді.
Dialogue: 0,0:14:30.59,0:14:33.27,Dialogue,,0,0,0,,Ол жаңа болғандықтан, оның қиындыққа түсуі ықтимал.
Dialogue: 0,0:14:30.85,0:14:32.54,*Default-ja,NTP,0,0,0,,Оны қарау өте қауіпті
Dialogue: 0,0:14:30.89,0:14:34.52,Secondary,,0,0,0,,Барлығы осы ма?! Бұл одан да жаман сатыла алмайды!
Dialogue: 0,0:14:33.27,0:14:37.95,Dialogue,,0,0,0,,Мен оны суық сумен шайып аламын, бірақ мен оның жарқыраған көздеріне қарасам,
Dialogue: 0,0:14:33.37,0:14:35.42,*Default-ja,NTP,0,0,0,,Оны суық сумен де себуге болады.
Dialogue: 0,0:14:35.70,0:14:39.56,*Default-ja,NTP,0,0,0,,Әлгі жігіттің жарқыраған көздеріне қарасам, тіпті ондай сезім жоқ.
Dialogue: 0,0:14:37.95,0:14:40.01,Dialogue,,0,0,0,,Мен тіпті бұл жұмыс істейтінін білмеймін.
Dialogue: 0,0:14:40.01,0:14:43.23,Dialogue,,0,0,0,,Сондықтан мен онымен мүмкіндігінше бірге болуға тырысамын.
Dialogue: 0,0:14:40.29,0:14:43.77,*Default-ja,NTP,0,0,0,,Сондықтан мен ең болмағанда сенімен бірге болуға тырысамын...
Dialogue: 0,0:14:44.69,0:14:49.53,Dialogue,,0,0,0,,Мен оның осы қаладағы қараңғылыққа жақындағанын қаламаймын.
Dialogue: 0,0:14:45.05,0:14:49.29,*Default-ja,NTP,0,0,0,,Мүмкін болса, оның бұл қаланың қараңғылығына жақындағанын қаламаймын.
Dialogue: 0,0:14:51.16,0:14:52.97,Dialogue,,0,0,0,,Немесе мен.
Dialogue: 0,0:14:51.79,0:14:52.80,*Default-ja,NTP,0,0,0,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,0:14:54.14,0:14:54.95,Dialogue,,0,0,0,,Жарылыс.
Dialogue: 0,0:14:59.09,0:15:03.38,Dialogue,,0,0,0,,Мен енді ол жерге ешқашан... бармаймын дедім.
Dialogue: 0,0:14:59.61,0:15:03.41,*Default-ja,NTP,0,0,0,,Мен ол жерге енді ешқашан бармаймын деп шештім.
Dialogue: 0,0:15:31.45,0:15:32.66,Chat,,0,0,0,,Сайка сөйлесу бөлмесіне кірді.
Dialogue: 0,0:15:32.66,0:15:33.87,Chat,,0,0,0,,Күшті
Dialogue: 0,0:15:33.87,0:15:34.91,Chat,,0,0,0,,Күшті, махаббат, үміт
Dialogue: 0,0:15:34.91,0:15:35.66,Chat,,0,0,0,,Мен, қалаймын, үміттенемін
Dialogue: 0,0:15:35.66,0:15:36.16,Chat,,0,0,0,,Мен, қалаймын, күштірек, сүйемін
Dialogue: 0,0:15:36.16,0:15:36.66,Chat,,0,0,0,,Күшті, адам, сүйетін
Dialogue: 0,0:15:36.66,0:15:37.04,Chat,,0,0,0,,Үміт, мен, ана, ана
Dialogue: 0,0:15:37.04,0:15:39.91,Chat,,0,0,0,,Ана
Dialogue: 0,0:15:39.91,0:15:41.41,Chat,,0,0,0,,Сайка чат бөлмесінен шығып кетті.
Dialogue: 0,0:15:41.41,0:15:43.71,Chat,,0,0,0,,Біреу бізге спам жіберуі мүмкін бе?
Dialogue: 0,0:15:43.71,0:15:45.04,Chat,,0,0,0,,Бұл жат планеталық сияқты.
Dialogue: 0,0:15:45.04,0:15:46.25,Chat,,0,0,0,,Күліп тұрған шығар...
Dialogue: 0,0:15:46.25,0:15:47.58,Chat,,0,0,0,,Қандай қорқынышты...
Dialogue: 0,0:15:47.58,0:15:49.37,Chat,,0,0,0,,Қараңызшы, анаға арналған канжи «хаха», сондықтан...
Dialogue: 0,0:15:49.37,0:15:51.47,Chat,,0,0,0,,Жоқ, мен бұл жат планеталық деп қорықпаймын.
Dialogue: 0,0:15:51.47,0:15:52.59,Chat,,0,0,0,,Немесе осыған ұқсас нәрсе.
Dialogue: 0,0:15:54.01,0:15:55.18,Dialogue,,0,0,0,,ЦумиУта?
Dialogue: 0,0:15:54.33,0:15:55.37,*Default-ja,NTP,0,0,0,,Күнә әні?
Dialogue: 0,0:15:55.47,0:15:57.52,Dialogue,,0,0,0,,Немесе бұл «Зайка» болуы мүмкін.
Dialogue: 0,0:15:55.73,0:15:57.40,*Default-ja,NTP,0,0,0,,Әлде күнә әні ме?
Dialogue: 0,0:15:59.02,0:16:00.39,Dialogue,,0,0,0,,"Зайка" "меншік?"
Dialogue: 0,0:16:00.39,0:16:02.23,Dialogue,,0,0,0,,Мен оны кейінірек қарастырамын.
Dialogue: 0,0:16:00.86,0:16:02.09,*Default-ja,NTP,0,0,0,,Мен оны кейінірек қарастырамын.
Dialogue: 0,0:16:02.23,0:16:04.64,Dialogue,,0,0,0,,Ең бастысы, Селти, менің саған жұмысым бар.
Dialogue: 0,0:16:02.46,0:16:04.30,*Default-ja,NTP,0,0,0,,Одан гөрі, Селти, бұл жұмыс.
Dialogue: 0,0:16:04.64,0:16:06.95,Dialogue,,0,0,0,,Бұл тағы да Авакусу қауымдастығының Шики мырзасынан.
Dialogue: 0,0:16:04.88,0:16:06.66,*Default-ja,NTP,0,0,0,,Сондай-ақ Авакусукай Йоцуки мырзадан
Dialogue: 0,0:16:06.95,0:16:10.40,Dialogue,,0,0,0,,Бұл соншалықты керемет жұмыс емес, бірақ сіз мұны істейсіз бе?
Dialogue: 0,0:16:07.14,0:16:09.74,*Default-ja,NTP,0,0,0,,Бұл өте жақсы жұмыс емес, бірақ сіз мұны істейсіз бе?
Dialogue: 0,0:16:11.08,0:16:12.39,Dialogue,,0,0,0,,Басқа курьерлік жұмыс?
Dialogue: 0,0:16:11.54,0:16:12.70,*Default-ja,NTP,0,0,0,,Басқа курьер?
Dialogue: 0,0:16:12.39,0:16:14.14,Dialogue,,0,0,0,,Иә, бұл курьерлік жұмыс.
Dialogue: 0,0:16:12.79,0:16:13.94,*Default-ja,NTP,0,0,0,,Иә Курьер
Dialogue: 0,0:16:14.14,0:16:17.74,Dialogue,,0,0,0,,Дегенмен, сіз тауарды қайтарудан бастауыңыз керек.
Dialogue: 0,0:16:14.36,0:16:17.39,*Default-ja,NTP,0,0,0,,Дегенмен, біз затты қайтарудан бастауымыз керек.
Dialogue: 0,0:16:17.74,0:16:22.50,Dialogue,,0,0,0,,Мен тауардың не екенін білмеймін, немесе бұл «сұрама, айтпа» деген жағдай болды деп айтуым керек.
Dialogue: 0,0:16:18.07,0:16:19.73,*Default-ja,NTP,0,0,0,,Мен бұл заттың не екенін естіген жоқпын.
Dialogue: 0,0:16:20.12,0:16:22.55,*Default-ja,NTP,0,0,0,,Дәлірек айтсақ, екеуміздің де сұрамауымыз керек.
Dialogue: 0,0:16:22.50,0:16:23.75,Dialogue,,0,0,0,,Бір қолымда оқпен зарядталған винтовка
Dialogue: 0,0:16:23.02,0:16:24.10,*Default-ja,NTP,0,0,0,,Мен білемін
Dialogue: 0,0:16:23.75,0:16:28.21,Dialogue,,0,0,0,,Жарайды, енді элемент туралы. Оны ұрлаған жігіт бір жерде жүгіріп жүр.
Dialogue: 0,0:16:24.20,0:16:25.60,*Default-ja,NTP,0,0,0,,Міне, бұл.
Dialogue: 0,0:16:26.02,0:16:27.98,*Default-ja,NTP,0,0,0,,Ұрлаған жігіт қашып бара жатқан сияқты.
Dialogue: 0,0:16:28.21,0:16:33.76,Dialogue,,0,0,0,,Сіз жасырынатын орындардың көбінің қай жерде екенін білесіз, сондықтан оны оңай бұрышқа түсіре алуыңыз керек.
Dialogue: 0,0:16:28.46,0:16:30.55,*Default-ja,NTP,0,0,0,,Мен шамамен жасырынатын жерді білемін.
Dialogue: 0,0:16:30.85,0:16:32.55,*Default-ja,NTP,0,0,0,,Жақында бұрышта болуы керек
Dialogue: 0,0:16:33.76,0:16:35.51,Dialogue,,0,0,0,,Роджер.
Dialogue: 0,0:16:34.19,0:16:35.22,*Default-ja,NTP,0,0,0,,Түсінікті
Dialogue: 0,0:16:37.86,0:16:42.56,Dialogue,,0,0,0,,Абайлаңыз; Бұл Слэшер соңғы уақытта сыртта болды.
Dialogue: 0,0:16:38.30,0:16:42.03,*Default-ja,NTP,0,0,0,,Риппер жақында пайда болған сияқты, сондықтан абай болыңыз.
Dialogue: 0,0:16:42.56,0:16:43.92,Dialogue,,0,0,0,,Слейзер?
Dialogue: 0,0:16:42.87,0:16:43.95,*Default-ja,NTP,0,0,0,,Риппер?
Dialogue: 0,0:16:43.92,0:16:47.01,Dialogue,,0,0,0,,Иә, Слейзер. Ол қайтадан пайда болды.
Dialogue: 0,0:16:44.24,0:16:45.91,*Default-ja,NTP,0,0,0,,Иә, Риппер
Dialogue: 0,0:16:46.01,0:16:47.07,*Default-ja,NTP,0,0,0,,Қайтадан пайда болған сияқты.
Dialogue: 0,0:16:47.01,0:16:49.65,Dialogue,,0,0,0,,Ол жай ғана жара салған соң кетеді, бірақ ешқашан ешкімді өлтірмейді.
Dialogue: 0,0:16:47.26,0:16:49.97,*Default-ja,NTP,0,0,0,,Мені өлтірме, жәй ғана жаралап, YO-дан кет
Dialogue: 0,0:16:49.65,0:16:52.20,Dialogue,,0,0,0,,Сонда оны ең мықты деп айта алмайсың ғой?
Dialogue: 0,0:16:50.08,0:16:52.09,*Default-ja,NTP,0,0,0,,Жарайды, мен оны ең күшті деп айта алмаймын.
Dialogue: 0,0:16:52.20,0:16:54.65,Dialogue,,0,0,0,,Бұл қаладағы ең күшті адам...
Dialogue: 0,0:16:52.45,0:16:54.40,*Default-ja,NTP,0,0,0,,Егер сіз осы қаланың ең мықтысы болсаңыз, онда...
Dialogue: 0,0:16:54.65,0:16:56.52,Dialogue,,0,0,0,,Ресейден келген Саймон Суши.
Dialogue: 0,0:16:54.95,0:16:56.74,*Default-ja,NTP,0,0,0,,«Ресей сушисінің» Саймоны
Dialogue: 0,0:16:56.52,0:17:00.03,Dialogue,,0,0,0,,Бұл ақпарат алушы Синджукуға көшті, бірақ ол ше?
Dialogue: 0,0:16:56.92,0:16:58.57,*Default-ja,NTP,0,0,0,,Мен қазір Синджукуға көштім.
Dialogue: 0,0:16:58.64,0:17:00.01,*Default-ja,NTP,0,0,0,,Бұл ақпарат беруші
Dialogue: 0,0:17:00.03,0:17:01.58,Dialogue,,0,0,0,,Орихара Изая.
Dialogue: 0,0:17:00.32,0:17:01.78,*Default-ja,NTP,0,0,0,,Орихара Изая
Dialogue: 0,0:17:01.58,0:17:04.00,Dialogue,,0,0,0,,Жоқ, болуы керек...
Dialogue: 0,0:17:01.83,0:17:03.86,*Default-ja,NTP,0,0,0,,Онда ол болуы керек.
Dialogue: 0,0:17:04.00,0:17:05.83,Dialogue,,0,0,0,,Хэйвадзима Шизуо!
Dialogue: 0,0:17:04.30,0:17:05.90,*Default-ja,NTP,0,0,0,,Шизуо Хэйвадзима!
Dialogue: 0,0:17:09.04,0:17:10.83,Dialogue,,0,0,0,,Ең күшті түсті топ?
Dialogue: 0,0:17:09.39,0:17:10.87,*Default-ja,NTP,0,0,0,,Түстер тобы ең күшті ме? Егер сіз оны алсаңыз
Dialogue: 0,0:17:10.83,0:17:12.70,Dialogue,,0,0,0,,Қазір бұл доллар ма?
Dialogue: 0,0:17:11.05,0:17:12.81,*Default-ja,NTP,0,0,0,,Қазір доллар YO
Dialogue: 0,0:17:12.70,0:17:14.21,Dialogue,,0,0,0,,Бірақ доллардың түсі жоқ.
Dialogue: 0,0:17:12.87,0:17:14.43,*Default-ja,NTP,0,0,0,,Доллардың түсі жоқ
Dialogue: 0,0:17:14.21,0:17:17.31,Dialogue,,0,0,0,,Сол сары банда өткен жылға дейін ең көп үстемдік етті.
Dialogue: 0,0:17:14.49,0:17:17.22,*Default-ja,NTP,0,0,0,,Өткен жылға дейін сары түс басым болды.
Dialogue: 0,0:17:17.31,0:17:18.27,Dialogue,,0,0,0,,Сары?
Dialogue: 0,0:17:17.54,0:17:18.33,*Default-ja,NTP,0,0,0,,Сары…
Dialogue: 0,0:17:18.27,0:17:20.75,Dialogue,,0,0,0,,Иә, олар «Сары орамалдар» деп аталады.
Dialogue: 0,0:17:19.12,0:17:20.65,*Default-ja,NTP,0,0,0,,Сары тақиялы қарақшылар - YO...
Dialogue: 0,0:17:20.75,0:17:26.00,Dialogue,,0,0,0,,Мен олардың «Көгілдір квадраттармен» ессіз төбелесіп, көптеген адамдар шығарылғанын естідім.
Dialogue: 0,0:17:20.95,0:17:26.21,*Default-ja,NTP,0,0,0,,Өткен жылы Көк алаңның басқа түсті топпен төбелесіп, екеуі құлап қалғанын естідім.
Dialogue: 0,0:17:26.00,0:17:29.90,Dialogue,,0,0,0,,Иә, мен олардың ойынға оралғанын естідім.
Dialogue: 0,0:17:26.30,0:17:28.98,*Default-ja,NTP,0,0,0,,Жоқ, жақында қайта оралған сияқты.
Dialogue: 0,0:17:29.90,0:17:33.52,Dialogue,,0,0,0,,Келіңіздер, тапсырыстар келе берсін!
Dialogue: 0,0:17:30.02,0:17:32.93,*Default-ja,NTP,0,0,0,,Келіңіздер, қазір тапсырыс беріңіздер!
Dialogue: 0,0:17:33.52,0:17:37.48,Dialogue,,0,0,0,,Бізде Энгава тарақшалары бар. Олар арзан, олар арзан!
Dialogue: 0,0:17:33.74,0:17:36.51,*Default-ja,NTP,0,0,0,,Ең арзанға...
Dialogue: 0,0:17:36.04,0:17:38.48,Secondary,,0,0,0,,Айтшы, сен оларды бұл күндері көп көрмейсің бе?
Dialogue: 0,0:17:36.54,0:17:38.59,*Default-ja,NTP,0,0,0,,Ойланып қарасам, соңғы кездері мені жиі көрмейсің бе?
Dialogue: 0,0:17:38.48,0:17:39.64,Dialogue,,0,0,0,,Нені көрдіңіз?
Dialogue: 0,0:17:38.66,0:17:39.49,*Default-ja,NTP,0,0,0,,Не?
Dialogue: 0,0:17:39.64,0:17:42.37,Dialogue,,0,0,0,,Сары киімді жігіттер, солай ма? Сонымен, сіз байқадыңыз.
Dialogue: 0,0:17:39.82,0:17:40.92,*Default-ja,NTP,0,0,0,,Бұл сары, солай ма?
Dialogue: 0,0:17:41.11,0:17:42.26,*Default-ja,NTP,0,0,0,,Сіз шынымен байқадыңыз ба?
Dialogue: 0,0:17:42.37,0:17:43.83,Dialogue,,0,0,0,,Сары? Сіз айтасыз -
Dialogue: 0,0:17:42.62,0:17:43.80,*Default-ja,NTP,0,0,0,,Сары шынымен...
Dialogue: 0,0:17:43.83,0:17:44.88,Dialogue,,0,0,0,,Жұмсақ тыртықтар!
Dialogue: 0,0:17:43.90,0:17:45.10,*Default-ja,NTP,0,0,0,,Хёкин тайпасы
Dialogue: 0,0:17:44.88,0:17:46.01,Dialogue,,0,0,0,,Сіз «Сары орамалдарды» айтып отырсыз.
Dialogue: 0,0:17:45.13,0:17:46.24,*Default-ja,NTP,0,0,0,,Сары тақиялар, солай ма?
Dialogue: 0,0:17:46.01,0:17:47.06,Dialogue,,0,0,0,,Иә, солай.
Dialogue: 0,0:17:46.28,0:17:47.25,*Default-ja,NTP,0,0,0,,Иә, бұл
Dialogue: 0,0:17:47.06,0:17:48.92,Dialogue,,0,0,0,,Бұл Герместің желісі.
Dialogue: 0,0:17:47.46,0:17:48.60,*Default-ja,NTP,0,0,0,,Гермес қазір.
Dialogue: 0,0:17:48.92,0:17:53.30,Dialogue,,0,0,0,,Оларды Көк шаршылармен шайқастан кейін жою керек еді.
Dialogue: 0,0:17:49.25,0:17:53.54,*Default-ja,NTP,0,0,0,,Жоқ, Сары тақиялар Көк алаңмен қақтығыс кезінде жойылуы керек еді.
Dialogue: 0,0:17:53.30,0:17:55.01,Dialogue,,0,0,0,,"Жоқ" жағын бөгеп, жоятын есілік балалары
Dialogue: 0,0:17:53.99,0:17:55.06,*Default-ja,NTP,0,0,0,,Иә.
Dialogue: 0,0:17:55.01,0:17:58.13,Dialogue,,0,0,0,,Олардың бастығы кетіп қалды.
Dialogue: 0,0:17:55.23,0:17:57.53,*Default-ja,NTP,0,0,0,,Сол жақтағы бастық кері шегіну керек еді...
Dialogue: 0,0:17:56.87,0:18:00.55,Secondary,,0,0,0,,Маған кез келген уақытта қоңырау шалыңыз. О, қош келдіңіз!
Dialogue: 0,0:17:58.99,0:18:00.20,*Default-ja,NTP,0,0,0,,Сәлем, Раши!
Dialogue: 0,0:18:05.42,0:18:08.09,Dialogue,,0,0,0,,Доллар туралы айтып бере аласыз ба?
Dialogue: 0,0:18:05.68,0:18:08.08,*Default-ja,NTP,0,0,0,,Доллар туралы айтып бере аласыз ба?
Dialogue: 0,0:18:08.09,0:18:08.78,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:18:08.78,0:18:11.90,Dialogue,,0,0,0,,Менің досым оларға қосылуды ойлайды, бірақ мен оны тоқтатқым келеді.
Dialogue: 0,0:18:08.96,0:18:11.96,*Default-ja,NTP,0,0,0,,Менің қарағым мені ұруға тырысады, мен оны тоқтатқым келеді.
Dialogue: 0,0:18:13.89,0:18:15.53,Dialogue,,0,0,0,,Неге бізден сұрап тұрсың?
Dialogue: 0,0:18:14.31,0:18:15.81,*Default-ja,NTP,0,0,0,,Неге бізден сұрап тұрсың?
Dialogue: 0,0:18:15.53,0:18:18.24,Dialogue,,0,0,0,,Жарайды, басқа ешкімнен сұрай алмаймын.
Dialogue: 0,0:18:15.98,0:18:18.20,*Default-ja,NTP,0,0,0,,Жоқ... Басқа тыңдайтын ешкімім жоқ.
Dialogue: 0,0:18:18.24,0:18:21.57,Dialogue,,0,0,0,,Сіз бәрібір Орихара Изаядан сұрағыңыз келмейді.
Dialogue: 0,0:18:18.42,0:18:21.73,*Default-ja,NTP,0,0,0,,Мен Изая Орихарадан сұрай алмаймын.
Dialogue: 0,0:18:24.37,0:18:28.99,Dialogue,,0,0,0,,Біз доллар туралы көп білмейтін сияқтымыз.
Dialogue: 0,0:18:24.74,0:18:28.66,*Default-ja,NTP,0,0,0,,Жоқ, біз доллар туралы көп білмейміз.
Dialogue: 0,0:18:28.99,0:18:31.53,Dialogue,,0,0,0,,Бірақ мен сізге білетініміздің бәрін айтып беремін.
Dialogue: 0,0:18:29.13,0:18:31.31,*Default-ja,NTP,0,0,0,,Мен саған білгенімнің бәрін айтамын.
Dialogue: 0,0:18:32.18,0:18:36.41,Dialogue,,0,0,0,,Кейде... бұл қала сені түгел жұтып қоя жаздады.
Dialogue: 0,0:18:32.64,0:18:35.77,*Default-ja,NTP,0,0,0,,Кейде мені осы қалаға жұтып қоятындай сезінемін.
Dialogue: 0,0:18:36.41,0:18:40.33,Dialogue,,0,0,0,,Алайда мен сені онша алысқа жібермеймін, Микадо.
Dialogue: 0,0:18:36.71,0:18:37.77,*Default-ja,NTP,0,0,0,,Бірақ Микадо
Dialogue: 0,0:18:38.30,0:18:39.94,*Default-ja,NTP,0,0,0,,Мен сені ол жаққа жібермеймін
Dialogue: 0,0:18:55.48,0:18:56.90,Dialogue,,0,0,0,,Микадо?
Dialogue: 0,0:18:55.76,0:18:56.58,*Default-ja,NTP,0,0,0,,Микадо?
Dialogue: 0,0:18:58.22,0:18:58.74,Dialogue,,0,0,0,,9-эпизод
Dialogue: 0,0:18:58.42,0:18:59.07,*Default-ja,NTP,0,0,0,,Нашар
Dialogue: 0,0:18:58.74,0:19:01.61,Dialogue,,0,0,0,,Сіз мұны жай ғана жасай алмайсыз.
Dialogue: 0,0:18:59.65,0:19:01.23,*Default-ja,NTP,0,0,0,,Солай емес пе?
Dialogue: 0,0:19:01.91,0:19:04.95,Dialogue,,0,0,0,,Сіз біздің сары орамалдар екенімізді бір қарап-ақ айта аласыз, солай емес пе?
Dialogue: 0,0:19:02.19,0:19:05.53,*Default-ja,NTP,0,0,0,,Бізді көргенде сары тақиялы екенімізді білетін боласың, солай ма?
Dialogue: 0,0:19:06.79,0:19:07.95,Dialogue,,0,0,0,,Ягири!
Dialogue: 0,0:19:07.14,0:19:08.08,*Default-ja,NTP,0,0,0,,Ягири-кун!
Dialogue: 0,0:19:10.91,0:19:11.83,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:19:11.32,0:19:14.47,*Default-ja,NTP,0,0,0,,Иә? Мика Харима емес...
Dialogue: 0,0:19:12.45,0:19:14.50,Dialogue,,0,0,0,,Бұл емес...Харима Мика.
Dialogue: 0,0:19:14.78,0:19:19.01,Dialogue,,0,0,0,,Сенің кім екеніңді білмеймін, бірақ біздің махаббат ұшқанымызға кедергі жасама.
Dialogue: 0,0:19:15.05,0:19:16.36,*Default-ja,NTP,0,0,0,,Мен оның кім екенін білмеймін.
Dialogue: 0,0:19:16.71,0:19:19.28,*Default-ja,NTP,0,0,0,,Біздің махаббаттан қашуымызға кедергі жасама
Dialogue: 0,0:19:19.01,0:19:21.13,Dialogue,,0,0,0,,«Махаббат ұшуы...?»
Dialogue: 0,0:19:19.46,0:19:21.00,*Default-ja,NTP,0,0,0,,Махаббаттың қашуы...
Dialogue: 0,0:19:21.13,0:19:22.66,Dialogue,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:19:21.64,0:19:22.31,*Default-ja,NTP,0,0,0,,Кеттік
Dialogue: 0,0:19:26.60,0:19:29.31,Dialogue,,0,0,0,,Сонда бұл кім?
Dialogue: 0,0:19:26.88,0:19:28.64,*Default-ja,NTP,0,0,0,,Бірақ сіз кімсіз? Бұл
Dialogue: 0,0:19:33.29,0:19:34.31,Dialogue,,0,0,0,,Бала!
Dialogue: 0,0:19:33.66,0:19:34.53,*Default-ja,NTP,0,0,0,,Кида-кун
Dialogue: 0,0:19:40.05,0:19:42.52,Dialogue,,0,0,0,,Балалар сендер шынымен де «Сары орамалдар» фильміндесіңдер ме?
Dialogue: 0,0:19:40.54,0:19:42.70,*Default-ja,NTP,0,0,0,,Сіз шынымен сары тақиялы қарақшысыз ба?
Dialogue: 0,0:19:42.52,0:19:44.15,Dialogue,,0,0,0,,Иә, әрине!
Dialogue: 0,0:19:43.26,0:19:44.30,*Default-ja,NTP,0,0,0,,Менің ойымша, бұл шешілді.
Dialogue: 0,0:19:44.15,0:19:45.99,Dialogue,,0,0,0,,Мен айта алмағандықтан сұрап отырмын.
Dialogue: 0,0:19:44.41,0:19:45.73,*Default-ja,NTP,0,0,0,,Мен түсінбеймін, сондықтан сұраймын.
Dialogue: 0,0:19:47.08,0:19:48.71,Dialogue,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:19:47.31,0:19:48.34,*Default-ja,NTP,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:19:48.71,0:19:50.16,Dialogue,,0,0,0,,Бала!
Dialogue: 0,0:19:48.84,0:19:49.76,*Default-ja,NTP,0,0,0,,Ки... Кида-кун!
Dialogue: 0,0:19:51.37,0:19:54.13,Dialogue,,0,0,0,,Жоқ, Микадо, сен де неге?
Dialogue: 0,0:19:51.88,0:19:54.14,*Default-ja,NTP,0,0,0,,Эй, Микадо, сен неге?
Dialogue: 0,0:20:02.80,0:20:05.01,Dialogue,,0,0,0,,Мо-монстр!
Dialogue: 0,0:20:03.03,0:20:04.81,*Default-ja,NTP,0,0,0,,Ба... құбыжық!
Dialogue: 0,0:20:05.01,0:20:06.01,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:20:08.01,0:20:08.97,Dialogue,,0,0,0,,Жер
Dialogue: 0,0:20:08.42,0:20:09.14,*Default-ja,NTP,0,0,0,,Кеттік!
Dialogue: 0,0:20:38.25,0:20:40.73,Dialogue,,0,0,0,,Аға, сен мені уайымдадың!
Dialogue: 0,0:20:38.32,0:20:40.40,*Default-ja,NTP,0,0,0,,Мазалаған сенсің.
Dialogue: 0,0:20:40.73,0:20:41.50,*Default-ja,NTP,0,0,0,,Осымен
Dialogue: 0,0:20:40.73,0:20:42.08,Dialogue,,0,0,0,,Дәл осы жерде!
Dialogue: 0,0:20:41.05,0:20:45.93,Secondary,,0,0,0,,Ақырында, мен оған тәуелді адам болуым мүмкін.
Dialogue: 0,0:20:41.52,0:20:45.99,*Default-ja,NTP,0,0,0,,Бәлкім, соған байланысты мен шығармын.
Dialogue: 0,0:20:42.08,0:20:43.51,Dialogue,,0,0,0,,Менің ойымша.
Dialogue: 0,0:20:46.85,0:20:51.43,Dialogue,,0,0,0,,Микадо осында келгеннен кейін мен өзімнің батылдығым нағыз батылдыққа айналғандай сезінемін.
Dialogue: 0,0:20:47.10,0:20:48.55,*Default-ja,NTP,0,0,0,,Микадо келген соң
Dialogue: 0,0:20:49.12,0:20:51.84,*Default-ja,NTP,0,0,0,,Мен мұнда атмосфера шынайы бола бастағандай сезінемін.
Dialogue: 0,0:20:52.84,0:20:57.64,Dialogue,,0,0,0,,Мен оны қазір қашпай-ақ қарсы алатын шығармын.
Dialogue: 0,0:20:53.08,0:20:54.09,*Default-ja,NTP,0,0,0,,Қазір...
Dialogue: 0,0:20:54.68,0:20:57.84,*Default-ja,NTP,0,0,0,,Мүмкін бұл жолы қашпай-ақ кездесіп қалармын.
Dialogue: 0,0:20:57.64,0:20:58.40,Dialogue,,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:20:58.16,0:20:58.87,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:20:58.40,0:21:01.92,Dialogue,,0,0,0,,Ол менен неғұрлым көп күтсе, соғұрлым мен мұны істей алатын сияқтымын.
Dialogue: 0,0:20:58.96,0:21:01.64,*Default-ja,NTP,0,0,0,,Бұл дерлік...
Dialogue: 0,0:21:03.53,0:21:06.20,Dialogue,,0,0,0,,Мен сені енді осында келеді деп ойламадым.
Dialogue: 0,0:21:03.92,0:21:06.49,*Default-ja,NTP,0,0,0,,Мен сені уже келеді деп ойладым.
Dialogue: 0,0:21:08.58,0:21:09.86,Dialogue,,0,0,0,,Изая.
Dialogue: 0,0:21:08.95,0:21:10.13,*Default-ja,NTP,0,0,0,,Изая мырза
Dialogue: 0,0:21:09.86,0:21:10.91,Dialogue,,0,0,0,,Та-да!
Dialogue: 0,0:21:10.33,0:21:11.13,*Default-ja,NTP,0,0,0,,Сәлем
Dialogue: 0,0:21:12.80,0:21:14.60,Dialogue,,0,0,0,,Сіздің жігітіңіз қалай болды?
Dialogue: 0,0:21:13.16,0:21:14.38,*Default-ja,NTP,0,0,0,,Оның соңғы кездері қалай болды?
Dialogue: 0,0:21:14.60,0:21:17.61,Dialogue,,0,0,0,,Ол маған кейде келеді.
Dialogue: 0,0:21:14.75,0:21:17.45,*Default-ja,NTP,0,0,0,,Иә... кейде келеді.
Dialogue: 0,0:21:18.21,0:21:20.13,Dialogue,,0,0,0,,Ол дәл осының алдындағыдай.
Dialogue: 0,0:21:18.60,0:21:19.76,*Default-ja,NTP,0,0,0,,Оған дейін...
Dialogue: 0,0:21:32.03,0:21:33.10,Dialogue,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:21:32.58,0:21:33.47,*Default-ja,NTP,0,0,0,,Мен үйдемін~
Dialogue: 0,0:21:35.52,0:21:38.15,Dialogue,,0,0,0,,Харуна, сен міндетті түрде тамақтандың ба?
Dialogue: 0,0:21:35.98,0:21:37.93,*Default-ja,NTP,0,0,0,,Харуна~ Дұрыс тамақтандың ба?
Dialogue: 0,0:21:38.15,0:21:39.82,Dialogue,,0,0,0,,Харуна?
Dialogue: 0,0:21:38.62,0:21:39.51,*Default-ja,NTP,0,0,0,,Харуна~!
Dialogue: 0,0:21:47.78,0:21:51.28,Chat,,0,0,0,,О, мен спамерге тыйым салдым.
Dialogue: 0,0:21:51.28,0:21:53.07,Chat,,0,0,0,,Енді қайтадан тыныш болуы мүмкін.
Dialogue: 0,0:21:53.07,0:21:54.74,Chat,,0,0,0,,Егер солай болса жақсы болар еді...
Dialogue: 0,0:21:54.74,0:21:59.24,Chat,,0,0,0,,Айтпақшы, «Сары орамалдылар» тобының мүшелері кесілген деп естідім.
Dialogue: 0,0:21:59.24,0:22:01.13,Chat,,0,0,0,,Сары орамалдар дегеніміз не?
Dialogue: 0,0:22:01.13,0:22:03.46,Chat,,0,0,0,,Мүмкін The Slasher The Dollars үшін жұмыс істеп жатқан шығар.
Dialogue: 0,0:22:03.46,0:22:05.00,Chat,,0,0,0,,Не? Мүмкін емес!
Dialogue: 0,0:22:05.00,0:22:07.05,Chat,,0,0,0,,Соғыс басталуы мүмкін.
Dialogue: 0,0:22:07.90,0:22:12.04,Dialogue,,0,0,0,,Бұл қалада болып жатқан оқиғалар бір қарағанда мүлдем байланыссыз болып көрінуі мүмкін...
Dialogue: 0,0:22:08.29,0:22:10.03,*Default-ja,NTP,0,0,0,,Бұл қалада не болып жатыр
Dialogue: 0,0:22:10.52,0:22:12.22,*Default-ja,NTP,0,0,0,,Бір қарағанда бір-бірінен ажыраған сияқты.
Dialogue: 0,0:22:12.04,0:22:14.13,Dialogue,,0,0,0,,Бірақ олар белгілі бір уақытта қосылады...
Dialogue: 0,0:22:12.37,0:22:14.08,*Default-ja,NTP,0,0,0,,Мен олардың бір жерде қосылғанына сенімдімін
Dialogue: 0,0:22:14.13,0:22:15.03,Dialogue,,0,0,0,,Иә!
Dialogue: 0,0:22:15.03,0:22:19.52,Dialogue,,0,0,0,,Біз тіпті түсіне алмайтын бұрмаланған білім де болуы мүмкін.
Dialogue: 0,0:22:15.23,0:22:18.81,*Default-ja,NTP,0,0,0,,Бізге түсініксіз және бұрмаланған шындық жүктелуі керек.
Dialogue: 0,0:22:15.77,0:22:17.94,Secondary,,0,0,0,,Қайырлы таң, Кида.
Dialogue: 0,0:22:19.52,0:22:20.19,Dialogue,,0,0,0,,Дегенмен...
Dialogue: 0,0:22:19.86,0:22:20.68,*Default-ja,NTP,0,0,0,,Бірақ…
Dialogue: 0,0:22:22.36,0:22:24.41,Dialogue,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:22:22.75,0:22:23.65,*Default-ja,NTP,0,0,0,,Қайырлы таң!
Dialogue: 0,0:22:24.98,0:22:27.59,Dialogue,,0,0,0,,Қайырлы таң, Сонохара.
Dialogue: 0,0:22:25.28,0:22:27.00,*Default-ja,NTP,0,0,0,,Қайырлы таң, Сонохара-сан.
Dialogue: 0,0:22:27.59,0:22:29.20,Secondary,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:22:27.59,0:22:33.55,Dialogue,,0,0,0,,Мен оны жаңа ғана байқадым, бірақ бұл қарым-қатынас өте ыңғайлы.
Dialogue: 0,0:22:27.82,0:22:29.32,*Default-ja,NTP,0,0,0,,Мен мұны енді ғана түсіндім
Dialogue: 0,0:22:30.13,0:22:32.87,*Default-ja,NTP,0,0,0,,Маған бұл қарым-қатынас өте ыңғайлы сияқты.
Dialogue: 0,0:22:33.55,0:22:36.00,Dialogue,,0,0,0,,Нүктелер ақырында бір-бірімен қосылады...
Dialogue: 0,0:22:33.80,0:22:35.52,*Default-ja,NTP,0,0,0,,Бір күні нүктелер қосылады
Dialogue: 0,0:22:36.00,0:22:39.10,Dialogue,,0,0,0,,Тіпті біз қазір айта алмайтын нәрсе әшкереленсе де...
Dialogue: 0,0:22:36.12,0:22:38.37,*Default-ja,NTP,0,0,0,,Тіпті қазір көрінбейтін нәрсе ашылып қалса да
Dialogue: 0,0:22:39.10,0:22:44.75,Dialogue,,0,0,0,,Біздің қарым-қатынасымыз бұрынғысынша сақталады деп сенемін.
Dialogue: 0,0:22:39.32,0:22:43.89,*Default-ja,NTP,0,0,0,,Мен енді біздің қарым-қатынасымыз бұрынғыдай болатынына сенемін.
Dialogue: 0,0:24:15.10,0:24:19.72,staff,NTP,0,0,0,,Өндіріс: LASTZZZ Демалыс бұлт акира Акира
Dialogue: 0,0:24:15.43,0:24:16.72,Dialogue,,0,0,0,,Доллар?
Dialogue: 0,0:24:15.53,0:24:16.52,*Default-ja,NTP,0,0,0,,Доллар?
Dialogue: 0,0:24:16.72,0:24:18.60,Dialogue,,0,0,0,,Олар туралы көп айта алмаймын.
Dialogue: 0,0:24:16.91,0:24:18.80,*Default-ja,NTP,0,0,0,,Менен сұрасаң да, көп айта алмаймын.
Dialogue: 0,0:24:18.60,0:24:23.72,Dialogue,,0,0,0,,Әйтеуір, қазірдің өзінде атақты Қазтано оқиғасы туралы бәрін айтып беремін.
Dialogue: 0,0:24:19.30,0:24:23.53,*Default-ja,NTP,0,0,0,,Қазір аңызға айналған Казутано оқиғасының жай-жапсарын айтып берейін.
