Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:08.54,0:01:12.30,Dialogue,,0,0,0,,Менің ойымша, бұл даму Бірибиридің кейіпкер болатынының белгісі болуы керек!
Dialogue: 0,0:01:08.71,0:01:12.26,*Default-ja,NTP,0,0,0,,Бұл даму оның кейіпкер болғанының белгісі деп ойлаймын!
Dialogue: 0,0:01:12.80,0:01:14.00,Dialogue,,0,0,0,,Сіз...
Dialogue: 0,0:01:13.24,0:01:14.09,*Default-ja,NTP,0,0,0,,Сен…
Dialogue: 0,0:01:14.00,0:01:14.84,Dialogue,,0,0,0,,Маған көмектес!
Dialogue: 0,0:01:14.18,0:01:14.94,*Default-ja,NTP,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:01:14.84,0:01:18.04,Dialogue,,0,0,0,,Сіз маған өз мүддеңіз үшін оны денесінен бөлетініңізді айтасыз ба?
Dialogue: 0,0:01:15.02,0:01:18.44,*Default-ja,NTP,0,0,0,,Адам болып тірідей көрінетін мойынға не істеу керек?
Dialogue: 0,0:01:18.04,0:01:20.80,Dialogue,,0,0,0,,Мен оны көруім керек, не болса да!
Dialogue: 0,0:01:18.60,0:01:20.51,*Default-ja,NTP,0,0,0,,Мен ол қызбен танысқым келеді
Dialogue: 0,0:01:20.80,0:01:23.77,Dialogue,,0,0,0,,Олар Yagiri Pharmaceuticals компаниясынан шығар.
Dialogue: 0,0:01:20.96,0:01:23.60,*Default-ja,NTP,0,0,0,,Бұл Yagiri Pharmaceuticals компаниясының жігіттері шығар.
Dialogue: 0,0:01:23.77,0:01:26.51,Dialogue,,0,0,0,,Жарайды. Бәрін әпкеңе қалдыр.
Dialogue: 0,0:01:23.92,0:01:26.81,*Default-ja,NTP,0,0,0,,Жарайды, бәрін апаңа қалдыр.
Dialogue: 0,0:01:26.51,0:01:29.73,Dialogue,,0,0,0,,Шынымды айтсам, мен оны жартылай ойладым.
Dialogue: 0,0:01:27.13,0:01:29.81,*Default-ja,NTP,0,0,0,,Шынымды айтсам, мен жартылай күмәнмен қарадым.
Dialogue: 0,0:01:29.73,0:01:32.55,Dialogue,,0,0,0,,Бүгін кешке доп менің алаңымда.
Dialogue: 0,0:01:29.93,0:01:33.00,*Default-ja,NTP,0,0,0,,Бөлшектер менің қолымда
Dialogue: 0,0:01:58.51,0:02:00.18,Thought,,0,0,0,,Менің кетуім керек.
Dialogue: 0,0:01:58.86,0:02:02.38,*Default-ja,NTP,0,0,0,,Менің кетуім керек... Мен оны қайтаруым керек.
Dialogue: 0,0:02:00.18,0:02:03.01,Thought,,0,0,0,,Мен оны қайтаруым керек.
Dialogue: 0,0:02:03.01,0:02:05.35,Thought,,0,0,0,,Менің әпкем мұны істей алмайды.
Dialogue: 0,0:02:03.30,0:02:06.70,*Default-ja,NTP,0,0,0,,Әпкем болса жақсы емес, мен емес...
Dialogue: 0,0:02:05.35,0:02:06.80,Thought,,0,0,0,,Бұл болуы керек...
Dialogue: 0,0:02:06.80,0:02:09.19,Thought,,0,0,0,,Бұл мен болуым керек.
Dialogue: 0,0:02:07.27,0:02:08.83,*Default-ja,NTP,0,0,0,,Бұл мен болуым керек
Dialogue: 0,0:02:09.19,0:02:11.44,Dialogue,,0,0,0,,Ол сонда болмады ма?
Dialogue: 0,0:02:09.53,0:02:11.35,*Default-ja,NTP,0,0,0,,Ол жоқ еді!?
Dialogue: 0,0:02:11.44,0:02:12.74,Dialogue,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:02:11.97,0:02:12.96,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:02:12.74,0:02:17.65,Dialogue,,0,0,0,,Астындағылар оның келгенше кетіп қалғанын айтты.
Dialogue: 0,0:02:13.09,0:02:17.31,*Default-ja,NTP,0,0,0,,Төмендегілер барғанда, әйел қалмаған сияқты.
Dialogue: 0,0:02:17.65,0:02:22.45,Dialogue,,0,0,0,,Сіз бұл бөлмені жалға алатын студентті Рюгамин деп айттыңыз, солай емес пе?
Dialogue: 0,0:02:17.87,0:02:22.31,*Default-ja,NTP,0,0,0,,Сол бөлмедегі студент... Рюгамин деп аталады, солай ма?
Dialogue: 0,0:02:23.53,0:02:24.58,Dialogue,,0,0,0,,Ол туралы не деуге болады?
Dialogue: 0,0:02:23.86,0:02:24.74,*Default-ja,NTP,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:02:24.58,0:02:30.96,Dialogue,,0,0,0,,Қайтып келгенде, олар оған бірнеше сұрақтар қойды, егер олай болса, оны қайтаратын болды...
Dialogue: 0,0:02:25.02,0:02:27.10,*Default-ja,NTP,0,0,0,,Қайтып келгенде ертегіні тыңдаңыз.
Dialogue: 0,0:02:27.48,0:02:30.73,*Default-ja,NTP,0,0,0,,Оның қасында біреу болған сияқты...
Dialogue: 0,0:02:30.96,0:02:33.93,Dialogue,,0,0,0,,Алайда оның достары бар сияқты...
Dialogue: 0,0:02:31.21,0:02:33.00,*Default-ja,NTP,0,0,0,,Егер серігіңмен келе алсаң.
Dialogue: 0,0:02:33.93,0:02:37.37,Dialogue,,0,0,0,,Оның достары да келуі керек еді.
Dialogue: 0,0:02:34.19,0:02:37.00,*Default-ja,NTP,0,0,0,,Сізге жақсы, солай ма?
Dialogue: 0,0:02:37.37,0:02:39.52,Dialogue,,0,0,0,,Сен түкке тұрғысызсың.
Dialogue: 0,0:02:37.66,0:02:39.13,*Default-ja,NTP,0,0,0,,Сіз оны пайдалана алмайсыз.
Dialogue: 0,0:02:40.15,0:02:41.59,Dialogue,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:02:40.41,0:02:41.67,*Default-ja,NTP,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:02:52.21,0:02:54.16,Dialogue,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:02:52.75,0:02:53.96,*Default-ja,NTP,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:02:54.16,0:02:56.72,Dialogue,,0,0,0,,Бұл Ягири Нами ханым ба?
Dialogue: 0,0:02:54.58,0:02:56.28,*Default-ja,NTP,0,0,0,,Сіз Нами Ягирисіз бе?
Dialogue: 0,0:02:56.72,0:02:58.53,Dialogue,,0,0,0,,Сіз кім болуыңыз мүмкін?
Dialogue: 0,0:02:56.96,0:02:58.41,*Default-ja,NTP,0,0,0,,Сіз қайсысысыз?
Dialogue: 0,0:03:00.45,0:03:04.48,Dialogue,,0,0,0,,Менің атым...Рюгамин Микадо.
Dialogue: 0,0:03:00.80,0:03:04.28,*Default-ja,NTP,0,0,0,,Менің атым Микадо Рюгамин.
Dialogue: 0,0:03:05.28,0:03:07.29,Dialogue,,0,0,0,,Келісім жасаймыз ба?
Dialogue: 0,0:03:05.68,0:03:07.15,*Default-ja,NTP,0,0,0,,Мәміле жасағыңыз келе ме?
Dialogue: 0,0:03:25.05,0:03:27.07,Dialogue,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:03:30.19,0:03:31.14,Dialogue,,0,0,0,,Менің...
Dialogue: 0,0:03:31.14,0:03:33.90,Dialogue,,0,0,0,,Қош келдіңіз, қош келдіңіз!
Dialogue: 0,0:03:31.73,0:03:34.20,*Default-ja,NTP,0,0,0,,Ираша~и Ираша~и
Dialogue: 0,0:03:34.31,0:03:35.27,Dialogue,,0,0,0,,Орыс сушиі?
Dialogue: 0,0:03:34.52,0:03:37.70,*Default-ja,NTP,0,0,0,,«Русский Зуши» Бұл дәмді және арзан!
Dialogue: 0,0:03:35.27,0:03:36.51,Dialogue,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:03:36.51,0:03:37.65,Dialogue,,0,0,0,,Бұл арзан!
Dialogue: 0,0:03:37.65,0:03:39.88,Dialogue,,0,0,0,,«Өмір дегеніміз не?»
Dialogue: 0,0:03:37.98,0:03:39.57,*Default-ja,NTP,0,0,0,,«Өмір дегеніміз не?»
Dialogue: 0,0:03:38.20,0:03:39.88,Secondary,,0,0,0,,Сәлеметсіз бе, мырза.
Dialogue: 0,0:03:39.88,0:03:41.87,Secondary,,0,0,0,,Қарныңыз ашты ма?
Dialogue: 0,0:03:39.88,0:03:42.49,Dialogue,,0,0,0,,«Адамдар не үшін өмір сүреді?»
Dialogue: 0,0:03:40.14,0:03:41.89,*Default-ja,NTP,0,0,0,,«Адамдар не үшін өмір сүреді?»
Dialogue: 0,0:03:41.87,0:03:44.02,Secondary,,0,0,0,,Бүгін бізде жақсы ингредиенттер бар.
Dialogue: 0,0:03:42.49,0:03:47.53,Dialogue,,0,0,0,,Немесе біреу менен сұрады, мен оны өмірінің бір дюйміне дейін ұрдым.
Dialogue: 0,0:03:42.88,0:03:47.40,*Default-ja,NTP,0,0,0,,Ол маған бұл сұрақты қойғанда, мен оны өлім аузында ұрдым.
Dialogue: 0,0:03:44.02,0:03:47.53,Secondary,,0,0,0,,Иә, бұл сізді ауыртпайды.
Dialogue: 0,0:03:47.53,0:03:49.11,Dialogue,,0,0,0,,Б... бір сызық
Dialogue: 0,0:03:47.71,0:03:48.83,*Default-ja,NTP,0,0,0,,Дұрыс.
Dialogue: 0,0:03:49.11,0:03:54.56,Dialogue,,0,0,0,,Егер ол орта мектептегі арманшыл болса, басқаша болуы мүмкін, бірақ ересек якудзаның бұлай айтуы қылмыс болуы керек, солай ма?
Dialogue: 0,0:03:49.35,0:03:51.66,*Default-ja,NTP,0,0,0,,Поэтикалық кіші мектеп оқушысы болсаң да.
Dialogue: 0,0:03:52.16,0:03:54.55,*Default-ja,NTP,0,0,0,,Жасы 20-дан асқан якудзаның бұлай айтуы қылмыс емес пе?
Dialogue: 0,0:03:54.56,0:03:55.88,Dialogue,,0,0,0,,Б... бір сызық
Dialogue: 0,0:03:54.71,0:03:55.50,*Default-ja,NTP,0,0,0,,Дұрыс.
Dialogue: 0,0:03:55.88,0:04:01.01,Dialogue,,0,0,0,,Эй, Саймон...сен менің айтқанымды түсінбедің, солай ма?
Dialogue: 0,0:03:56.37,0:03:57.66,*Default-ja,NTP,0,0,0,,Дәлірек айтсақ, Саймон.
Dialogue: 0,0:03:58.35,0:04:01.11,*Default-ja,NTP,0,0,0,,Сіз менің не айтып тұрғанымды шынымен түсінбейсіз, солай ма?
Dialogue: 0,0:04:01.01,0:04:03.58,Dialogue,,0,0,0,,Иә, дұрыс айтасыз.
Dialogue: 0,0:04:01.71,0:04:02.87,*Default-ja,NTP,0,0,0,,Ммм, дұрыс.
Dialogue: 0,0:04:08.42,0:04:11.98,Thought,,0,0,0,,Мен өзгердім бе?
Dialogue: 0,0:04:08.79,0:04:11.38,*Default-ja,NTP,0,0,0,,Мен өзгердім бе?
Dialogue: 0,0:04:11.98,0:04:13.67,Thought,,0,0,0,,Мен осы қалада тұрдым...
Dialogue: 0,0:04:12.26,0:04:15.25,*Default-ja,NTP,0,0,0,,Мен осы қалада 20 жыл тұрдым...
Dialogue: 0,0:04:13.67,0:04:15.46,Thought,,0,0,0,,Жиырма жыл бойы...
Dialogue: 0,0:04:15.73,0:04:17.97,Dialogue,,0,0,0,,Олар бекерге кеткен жоқ.
Dialogue: 0,0:04:16.24,0:04:17.56,*Default-ja,NTP,0,0,0,,Бұл ысырап емес.
Dialogue: 0,0:04:17.97,0:04:21.66,Dialogue,,0,0,0,,Мұнда өмір сүрген жиырма жылыңыз текке кеткен жоқ.
Dialogue: 0,0:04:18.15,0:04:21.09,*Default-ja,NTP,0,0,0,,Сіз өмір сүрген 20 жыл текке кеткен жоқ.
Dialogue: 0,0:04:21.66,0:04:25.86,Dialogue,,0,0,0,,Сіз оларды өміріңіздің соңына дейін пайдалансаңыз, ештеңе бекер болмайды.
Dialogue: 0,0:04:21.90,0:04:23.61,*Default-ja,NTP,0,0,0,,Егер сіз оны болашақ өміріңізде пайдалана алсаңыз
Dialogue: 0,0:04:23.91,0:04:25.67,*Default-ja,NTP,0,0,0,,Еш нәрсе бекер емес
Dialogue: 0,0:04:26.31,0:04:27.98,Dialogue,,0,0,0,,Оларды пайдалану керек пе?
Dialogue: 0,0:04:26.57,0:04:29.89,*Default-ja,NTP,0,0,0,,Оны пайдаланасыз ба? Онымен не істегенімді қалайсың!?
Dialogue: 0,0:04:27.98,0:04:29.61,Dialogue,,0,0,0,,Мен мұны қалай істеуім керек?!
Dialogue: 0,0:04:30.43,0:04:32.17,Dialogue,,0,0,0,,Мысалы...
Dialogue: 0,0:04:30.64,0:04:31.87,*Default-ja,NTP,0,0,0,,Жақсы мүмкіндік, сондықтан мәселені түпкілікті анықтап алайық.
Dialogue: 0,0:04:32.17,0:04:34.87,Dialogue,,0,0,0,,Маған үйленуге болады.
Dialogue: 0,0:04:32.66,0:04:34.02,*Default-ja,NTP,0,0,0,,Маған үйлен
Dialogue: 0,0:04:35.44,0:04:37.63,Thought,,0,0,0,,Шинра...
Dialogue: 0,0:04:35.70,0:04:36.76,*Default-ja,NTP,0,0,0,,Силла…
Dialogue: 0,0:04:59.49,0:05:01.89,Dialogue,,0,0,0,,Сіз Микадосыз ба?
Dialogue: 0,0:04:59.95,0:05:01.40,*Default-ja,NTP,0,0,0,,Сіз Микадо-кунсыз ба?
Dialogue: 0,0:05:08.37,0:05:12.19,Dialogue,,0,0,0,,Сіз мен ойлағаннан әлдеқайда мойынсұнғышсыз.
Dialogue: 0,0:05:08.78,0:05:11.78,*Default-ja,NTP,0,0,0,,Ол мен ойлағаннан әлдеқайда тыныш сияқты.
Dialogue: 0,0:05:12.19,0:05:15.91,Dialogue,,0,0,0,,Немесе дәл осы күндері сізде осындай бала болуы мүмкін бе?
Dialogue: 0,0:05:12.42,0:05:15.71,*Default-ja,NTP,0,0,0,,Әлде қазір мұндай балалар қауіпті ме?
Dialogue: 0,0:05:25.36,0:05:28.55,Dialogue,,0,0,0,,Қалай болғанда да, сіз айтқан бұл қандай келісім?
Dialogue: 0,0:05:25.57,0:05:28.19,*Default-ja,NTP,0,0,0,,Сонымен, мәміле қандай?
Dialogue: 0,0:05:31.62,0:05:36.37,Dialogue,,0,0,0,,Менде сіз іздеген адам бар.
Dialogue: 0,0:05:31.97,0:05:35.54,*Default-ja,NTP,0,0,0,,Менде сіз іздеген адам бар
Dialogue: 0,0:05:36.37,0:05:37.36,Dialogue,,0,0,0,,Б... бір сызық
Dialogue: 0,0:05:36.56,0:05:38.82,*Default-ja,NTP,0,0,0,,Иә, сізге қанша керек?
Dialogue: 0,0:05:37.36,0:05:39.23,Dialogue,,0,0,0,,Сізге қанша керек?
Dialogue: 0,0:05:39.23,0:05:41.87,Dialogue,,0,0,0,,Маған ақша керек емес.
Dialogue: 0,0:05:39.50,0:05:41.55,*Default-ja,NTP,0,0,0,,Жоқ, маған ақша керек емес.
Dialogue: 0,0:05:41.87,0:05:44.95,Dialogue,,0,0,0,,Сонда сізге не керек?
Dialogue: 0,0:05:42.05,0:05:43.73,*Default-ja,NTP,0,0,0,,Сонымен не қалайсыз?
Dialogue: 0,0:05:44.95,0:05:47.44,Dialogue,,0,0,0,,Шындық.
Dialogue: 0,0:05:45.15,0:05:46.35,*Default-ja,NTP,0,0,0,,Бұл рас
Dialogue: 0,0:05:47.45,0:05:50.38,Dialogue,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:05:47.83,0:05:50.08,*Default-ja,NTP,0,0,0,,Жаңа ғана не айттыңыз?
Dialogue: 0,0:05:50.38,0:05:53.87,Dialogue,,0,0,0,,Мен сенің ағаңның Харима Микаға істегенін мойындауыңды қалаймын...
Dialogue: 0,0:05:50.61,0:05:53.64,*Default-ja,NTP,0,0,0,,Сіздің ағаңыз Мика Хариманы не істеді
Dialogue: 0,0:05:53.87,0:05:59.46,Dialogue,,0,0,0,,...және екеуің оның денесіне не істедіңдер.
Dialogue: 0,0:05:54.02,0:05:58.55,*Default-ja,NTP,0,0,0,,Миканың денесіне не істегеніңізді бәріңіз мойындауларыңызды қалаймын.
Dialogue: 0,0:06:00.40,0:06:04.50,Dialogue,,0,0,0,,Өкінішке орай, менде тек жанама дәлелдер бар...
Dialogue: 0,0:06:00.67,0:06:03.65,*Default-ja,NTP,0,0,0,,Өкінішке орай, тек жанама дәлелдер бар.
Dialogue: 0,0:06:06.46,0:06:08.50,Dialogue,,0,0,0,,Сондықтан мен сенімен тікелей сөйлесемін.
Dialogue: 0,0:06:06.71,0:06:10.11,*Default-ja,NTP,0,0,0,,Шынымды айтсам, өзіңізді тапсырыңыз.
Dialogue: 0,0:06:08.50,0:06:10.76,Dialogue,,0,0,0,,Өзіңізді тапсырыңыз.
Dialogue: 0,0:06:15.70,0:06:19.17,Dialogue,,0,0,0,,көремін. Сіз сондай адамсыз.
Dialogue: 0,0:06:15.95,0:06:18.92,*Default-ja,NTP,0,0,0,,Иә, сен кімсің.
Dialogue: 0,0:06:19.17,0:06:20.77,Dialogue,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:06:22.71,0:06:27.12,Dialogue,,0,0,0,,Ағамның жолын кескен адамды кешірмеймін.
Dialogue: 0,0:06:23.00,0:06:26.35,*Default-ja,NTP,0,0,0,,Ағамның жолына түскеніңді кешіре алмаймын.
Dialogue: 0,0:06:27.12,0:06:28.92,Dialogue,,0,0,0,,Менде болмайды!
Dialogue: 0,0:06:27.42,0:06:28.87,*Default-ja,NTP,0,0,0,,Сіз...
Dialogue: 0,0:06:28.92,0:06:33.62,Dialogue,,0,0,0,,Ағамның жолына бөгет болған адам...болмауы керек.
Dialogue: 0,0:06:29.11,0:06:33.37,*Default-ja,NTP,0,0,0,,Мен ағамның жолына ешкімнің кедергі болғанын қаламаймын!
Dialogue: 0,0:06:34.86,0:06:36.42,Thought,,0,0,0,,Б... бір сызық
Dialogue: 0,0:06:35.36,0:06:39.89,*Default-ja,NTP,0,0,0,,Түсіндім, мына адам осындай ма?
Dialogue: 0,0:06:36.42,0:06:40.23,Thought,,0,0,0,,Міне, солай... бұл адам.
Dialogue: 0,0:06:40.23,0:06:42.96,Dialogue,,0,0,0,,Эй, айтшы.
Dialogue: 0,0:06:40.80,0:06:44.99,*Default-ja,NTP,0,0,0,,Әй, айтшы, апаң қайда?
Dialogue: 0,0:06:42.96,0:06:45.38,Dialogue,,0,0,0,,Менің әпкем қайда?
Dialogue: 0,0:06:45.38,0:06:47.92,Dialogue,,0,0,0,,Менің кетуім керек.
Dialogue: 0,0:06:45.81,0:06:50.41,*Default-ja,NTP,0,0,0,,Менің кетуім керек, мен оған керекпін.
Dialogue: 0,0:06:47.92,0:06:50.68,Dialogue,,0,0,0,,Қызға мен керекпін.
Dialogue: 0,0:06:51.19,0:06:53.95,Dialogue,,0,0,0,,Мен онымен бірге болуым керек!
Dialogue: 0,0:06:51.48,0:06:53.36,*Default-ja,NTP,0,0,0,,Мен осында болуым керек
Dialogue: 0,0:06:55.66,0:06:58.68,Dialogue,,0,0,0,,Әй, айтшы!
Dialogue: 0,0:06:55.96,0:06:58.74,*Default-ja,NTP,0,0,0,,Эй, айтшы!
Dialogue: 0,0:06:59.81,0:07:01.67,Thought,,0,0,0,,Бұл себеп пе?
Dialogue: 0,0:07:00.15,0:07:01.69,*Default-ja,NTP,0,0,0,,Бұл себеп пе...
Dialogue: 0,0:07:02.40,0:07:08.40,Thought,,0,0,0,,Сол себепті біреу өліп, оның денесін осылай пайдаланды ма?!
Dialogue: 0,0:07:02.82,0:07:04.90,*Default-ja,NTP,0,0,0,,Соның кесірінен адамдар өлді.
Dialogue: 0,0:07:05.63,0:07:08.00,*Default-ja,NTP,0,0,0,,Сол денемен осындай нәрсе жасаңыз...
Dialogue: 0,0:07:09.02,0:07:11.41,Thought,,0,0,0,,Олар тіпті мені нысанаға алып жатыр...!
Dialogue: 0,0:07:09.31,0:07:11.09,*Default-ja,NTP,0,0,0,,Тіпті мені нысанаға алу...
Dialogue: 0,0:07:29.49,0:07:32.34,Dialogue,,0,0,0,,Біреуді өлтірудің себебі осы ма?
Dialogue: 0,0:07:29.89,0:07:32.32,*Default-ja,NTP,0,0,0,,Осы себепті біреудің өмірінен айырылдыңыз ба?
Dialogue: 0,0:07:32.34,0:07:37.43,Dialogue,,0,0,0,,Өзіңнің мейіріміңмен Ягириді бақытсыз қылмақсың ба?!
Dialogue: 0,0:07:32.82,0:07:36.92,*Default-ja,NTP,0,0,0,,Сіз өзіңіздің қанағаттанғаныңызға Ягири-кунды бақытсыз етуді жоспарлайсыз ба?
Dialogue: 0,0:07:37.43,0:07:39.51,Dialogue,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:07:37.80,0:07:39.78,*Default-ja,NTP,0,0,0,,Қазір не айтып тұрсың?
Dialogue: 0,0:07:39.51,0:07:48.14,Dialogue,,0,0,0,,Өсіп-өніп, осы дүниеге қадам басқаннан кейін осы ғана айта алатын болсаң, онда әлгі жағымсыз аузыңды жап.
Dialogue: 0,0:07:39.87,0:07:42.91,*Default-ja,NTP,0,0,0,,Сол жаста мен бұл дүниеге қадам бастым...
Dialogue: 0,0:07:43.27,0:07:45.17,Secondary Thought,,0,0,0,,Жарайды.
Dialogue: 0,0:07:43.62,0:07:44.69,*Default-ja,NTP,0,0,0,,Сен жақсы боласың, иә?
Dialogue: 0,0:07:45.95,0:07:47.96,*Default-ja,NTP,0,0,0,,Жап мына жиіркенішті ауызды
Dialogue: 0,0:07:48.14,0:07:51.02,Dialogue,,0,0,0,,Мен қант жабатын заттар болуы мүмкін ...
Dialogue: 0,0:07:48.40,0:07:50.45,*Default-ja,NTP,0,0,0,,Бұл шынымен де әдемі нәрсе болуы мүмкін.
Dialogue: 0,0:07:51.02,0:07:53.03,Dialogue,,0,0,0,,Бірақ мен болсам ше?!
Dialogue: 0,0:07:51.18,0:07:52.87,*Default-ja,NTP,0,0,0,,Сонымен, сіз нені айтасыз?
Dialogue: 0,0:07:53.03,0:07:59.44,Dialogue,,0,0,0,,Біреуді өлтіргені үшін тәубе ету керек екенін түсіне алмай жүрген сен емес пе?!
Dialogue: 0,0:07:53.47,0:07:55.70,*Default-ja,NTP,0,0,0,,Біреуді өлтіргені үшін өкінуін сұрады
Dialogue: 0,0:07:55.92,0:07:59.43,*Default-ja,NTP,0,0,0,,Осыған дейін не болғанын түсіне алмай жүргенің де осы емес пе?
Dialogue: 0,0:07:59.44,0:08:01.99,Dialogue,,0,0,0,,Сіз тым көп драма көресіз.
Dialogue: 0,0:07:59.87,0:08:01.47,*Default-ja,NTP,0,0,0,,Мен тым көп драма көремін
Dialogue: 0,0:08:01.99,0:08:06.24,Dialogue,,0,0,0,,Бұл жай ғана уәделер және Лейбництің алдын-ала белгіленген үйлесімділігі; we live in reality.
Dialogue: 0,0:08:02.13,0:08:06.90,*Default-ja,NTP,0,0,0,,Уәде етілген барлық алдын ала белгіленген үйлесімділік осында шынайы, солай емес пе?
Dialogue: 0,0:08:07.03,0:08:09.10,Secondary Thought,,0,0,0,,Бұл жұмыс істейді, солай ма?
Dialogue: 0,0:08:07.03,0:08:09.34,Dialogue,,0,0,0,,Бұл эпикалық поэма емес.
Dialogue: 0,0:08:07.38,0:08:08.50,*Default-ja,NTP,0,0,0,,It'll work, right?
Dialogue: 0,0:08:09.34,0:08:11.35,Dialogue,,0,0,0,,Сіз де батыр емессіз.
Dialogue: 0,0:08:09.49,0:08:13.20,*Default-ja,NTP,0,0,0,,Сіз батыр емессіз. Know your worth!
Dialogue: 0,0:08:11.35,0:08:13.49,Dialogue,,0,0,0,,Өз орныңды біл!
Dialogue: 0,0:08:13.63,0:08:16.04,Dialogue,,0,0,0,,Мұның несі жаман?!
Dialogue: 0,0:08:13.94,0:08:15.99,*Default-ja,NTP,0,0,0,,Бұл не болды?
Dialogue: 0,0:08:16.04,0:08:20.03,Dialogue,,0,0,0,,Алдын ала орнатылған келісім, уәде, оппортунизм?!
Dialogue: 0,0:08:16.52,0:08:19.60,*Default-ja,NTP,0,0,0,,Жоспарланған үйлесімділік, уәделер және оппортунизм
Dialogue: 0,0:08:20.03,0:08:22.99,Dialogue,,0,0,0,,Мен бақытты аяқталуды жақсы көремін!
Dialogue: 0,0:08:20.15,0:08:22.60,*Default-ja,NTP,0,0,0,,Мен еріксіз бақытты аяқталуды жақсы көремін!
Dialogue: 0,0:08:22.99,0:08:25.94,Dialogue,,0,0,0,,Алғысы келгеннің несі жаман?!
Dialogue: 0,0:08:23.22,0:08:26.23,*Default-ja,NTP,0,0,0,,Бұны мақсат еткеннің несі айып!
Dialogue: 0,0:08:27.44,0:08:31.44,Dialogue,,0,0,0,,Мен мұны адамзат немесе дүние үшін деп айтпаймын...
Dialogue: 0,0:08:27.77,0:08:31.48,*Default-ja,NTP,0,0,0,,Мен оны адамдар үшін немесе әлем үшін деп айтпаймын.
Dialogue: 0,0:08:31.44,0:08:33.66,Dialogue,,0,0,0,,Мен тек біреуін көргім келеді!
Dialogue: 0,0:08:31.84,0:08:35.31,*Default-ja,NTP,0,0,0,,Мен оны көргім келеді! I want to believe it!
Dialogue: 0,0:08:33.66,0:08:35.45,Dialogue,,0,0,0,,Мен оларға сенгім келеді!
Dialogue: 0,0:08:36.85,0:08:39.20,Thought,,0,0,0,,Дұрыс. Мен сенемін.
Dialogue: 0,0:08:37.15,0:08:41.24,*Default-ja,NTP,0,0,0,,Yes, I believe. Мен сенемін.
Dialogue: 0,0:08:39.49,0:08:40.95,Thought,,0,0,0,,Мен сенемін!
Dialogue: 0,0:08:45.17,0:08:48.42,Thought,,0,0,0,,Барлығы... сөзсіз...
Dialogue: 0,0:08:45.99,0:08:48.19,*Default-ja,NTP,0,0,0,,Мен барлығына сенімдімін...
Dialogue: 0,0:08:49.77,0:08:53.48,Dialogue,,0,0,0,,Бұл қарапайым ой болуы мүмкін...
Dialogue: 0,0:08:50.11,0:08:53.56,*Default-ja,NTP,0,0,0,,Иә, бұл ортақ идея болуы мүмкін.
Dialogue: 0,0:08:53.48,0:09:00.26,Dialogue,,0,0,0,,Бірақ оның қарапайым екені бәрінің бұл туралы көп ойлайтынын білдіреді!
Dialogue: 0,0:08:53.74,0:08:59.89,*Default-ja,NTP,0,0,0,,Бірақ бұл қарапайым болғандықтан, бәрі бұл туралы ойлайды дегенді білдіреді!
Dialogue: 0,0:09:06.37,0:09:09.48,Dialogue,,0,0,0,,Айтқыңыз келгені осы ғана ма?
Dialogue: 0,0:09:06.74,0:09:08.88,*Default-ja,NTP,0,0,0,,Айтқыңыз келгені осы ма?
Dialogue: 0,0:09:16.92,0:09:22.33,Dialogue,,0,0,0,,Ақыл-ойды түсінбейтін адамға қарсы шығуға күшім де, білімім де жоқ.
Dialogue: 0,0:09:17.32,0:09:18.99,*Default-ja,NTP,0,0,0,,Сізбен пікірлесе алмайтын адамға
Dialogue: 0,0:09:19.23,0:09:22.05,*Default-ja,NTP,0,0,0,,Менде қиындықты жеңуге күшім де, даналығым да жоқ.
Dialogue: 0,0:09:22.33,0:09:25.57,Dialogue,,0,0,0,,Менің де тырысуға уақытым жоқ.
Dialogue: 0,0:09:22.54,0:09:24.93,*Default-ja,NTP,0,0,0,,Тіпті күш салуға уақыт берілмеді
Dialogue: 0,0:09:25.57,0:09:26.75,Dialogue,,0,0,0,,Шекара сызықтары?
Dialogue: 0,0:09:25.82,0:09:26.86,*Default-ja,NTP,0,0,0,,Сол себепті!
Dialogue: 0,0:09:31.21,0:09:34.05,Dialogue,,0,0,0,,Мен сандарға сенемін!
Dialogue: 0,0:09:31.66,0:09:33.45,*Default-ja,NTP,0,0,0,,Мен сандарға сенемін!
Dialogue: 0,0:10:05.58,0:10:07.33,Dialogue,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:10:06.00,0:10:06.87,*Default-ja,NTP,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,0:10:16.01,0:10:17.38,Dialogue,,0,0,0,,Бұл керемет!
Dialogue: 0,0:10:16.45,0:10:19.45,*Default-ja,NTP,0,0,0,,Уау! Мұның бәрі солай емес пе?
Dialogue: 0,0:10:17.38,0:10:19.51,Dialogue,,0,0,0,,Олардың барлығы осының бөліктері, солай ма?
Dialogue: 0,0:10:19.51,0:10:20.91,Dialogue,,0,0,0,,Бұл керемет!
Dialogue: 0,0:10:19.66,0:10:24.19,*Default-ja,NTP,0,0,0,,Awesome! Бұл «Сағыныштың» жұмбақ құбылысы сияқты!
Dialogue: 0,0:10:20.91,0:10:23.99,Dialogue,,0,0,0,,Бұл "Сағыныш!"
Dialogue: 0,0:10:23.50,0:10:26.06,*Default-ja,NTP,0,0,0,,Ботчан, бұл электрондық пошта.
Dialogue: 0,0:10:23.99,0:10:28.07,Dialogue,,0,0,0,,Мырза, сізде пошта бар. Мырза, сізде пошта бар.
Dialogue: 0,0:10:25.64,0:10:28.07,Secondary,,0,0,0,,Бір рет өліп көргіңіз келе ме?
Dialogue: 0,0:10:26.10,0:10:27.72,*Default-ja,NTP,0,0,0,,Бірден өлгіңіз келе ме?
Dialogue: 0,0:10:28.07,0:10:29.59,Dialogue,,0,0,0,,Түсіндік!
Dialogue: 0,0:10:28.39,0:10:29.71,*Default-ja,NTP,0,0,0,,Міне!
Dialogue: 0,0:10:29.59,0:10:31.88,Dialogue,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:10:30.35,0:10:31.47,*Default-ja,NTP,0,0,0,,Джикайо
Dialogue: 0,0:10:37.81,0:10:39.60,Dialogue,,0,0,0,,Олай болса...
Dialogue: 0,0:10:38.21,0:10:39.60,*Default-ja,NTP,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:10:39.60,0:10:42.35,Dialogue,,0,0,0,,Тоғуса, мен саған сенемін.
Dialogue: 0,0:10:39.89,0:10:41.58,*Default-ja,NTP,0,0,0,,Ватакуса: Қалғанын сұрадым.
Dialogue: 0,0:10:42.35,0:10:43.01,Dialogue,,0,0,0,,Оқу, оқу
Dialogue: 0,0:10:43.68,0:10:44.78,Dialogue,,0,0,0,,Осыны орындайық.
Dialogue: 0,0:10:43.97,0:10:45.01,*Default-ja,NTP,0,0,0,,Кеттік
Dialogue: 0,0:11:39.37,0:11:41.58,Dialogue,,0,0,0,,Олардың қаншасы бар?
Dialogue: 0,0:11:39.87,0:11:41.82,*Default-ja,NTP,0,0,0,,Неше адам бар?
Dialogue: 0,0:11:41.58,0:11:47.33,Dialogue,,0,0,0,,Уау, біздің алғашқы жиналысымызға осыншама көп адам келгеніне сене алар емеспін!
Dialogue: 0,0:11:41.94,0:11:45.72,*Default-ja,NTP,0,0,0,,Жоқ, жоқ, жоқ, бірінші кездесуге көп адам жиналғанына сене алар емеспін.
Dialogue: 0,0:11:45.97,0:11:47.27,*Default-ja,NTP,0,0,0,,Қандай таң қалдырды!
Dialogue: 0,0:11:48.18,0:11:49.84,Dialogue,,0,0,0,,Бұл...
Dialogue: 0,0:11:48.54,0:11:51.30,*Default-ja,NTP,0,0,0,,Бұл... Доллар ма?
Dialogue: 0,0:11:49.84,0:11:52.14,Dialogue,,0,0,0,,Доллар?!
Dialogue: 0,0:12:02.11,0:12:04.91,Dialogue,,0,0,0,,Сәлем, Ысқақ!
Dialogue: 0,0:12:02.54,0:12:04.43,*Default-ja,NTP,0,0,0,,Сәлем Ысқақ!
Dialogue: 0,0:12:04.91,0:12:06.86,Dialogue,,0,0,0,,Бұл не, Мирия?
Dialogue: 0,0:12:05.06,0:12:07.04,*Default-ja,NTP,0,0,0,,What is it? Милия
Dialogue: 0,0:12:06.86,0:12:10.50,Dialogue,,0,0,0,,Бұл адамдар да доллардың бір бөлігі ме?
Dialogue: 0,0:12:07.40,0:12:10.73,*Default-ja,NTP,0,0,0,,Бұл адамдар да доллардың бір бөлігі ме?
Dialogue: 0,0:12:10.50,0:12:13.29,Dialogue,,0,0,0,,Иә, солай, Мирия!
Dialogue: 0,0:12:11.01,0:12:13.67,*Default-ja,NTP,0,0,0,,Аа, дұрыс, Мирия.
Dialogue: 0,0:12:15.08,0:12:17.60,Dialogue,,0,0,0,,Жарайды, тыңда.
Dialogue: 0,0:12:15.37,0:12:17.15,*Default-ja,NTP,0,0,0,,Okay? listen carefully
Dialogue: 0,0:12:17.60,0:12:22.42,Dialogue,,0,0,0,,Біз ең «қазірдің», ең жастың және ең көп талқыланатындардың бөлігіміз—
Dialogue: 0,0:12:17.67,0:12:22.39,*Default-ja,NTP,0,0,0,,Осымен біз де дәл қазір көшедегі ең ыстық жастармыз...
Dialogue: 0,0:12:22.42,0:12:24.13,Dialogue,,0,0,0,,Бұл не болып жатыр өзі?!
Dialogue: 0,0:12:22.90,0:12:26.27,*Default-ja,NTP,0,0,0,,Бұл не? Әйтеуір, осы жігіттердің бәрі?
Dialogue: 0,0:12:24.13,0:12:26.46,Dialogue,,0,0,0,,Олардың бәрі болуы мүмкін емес еді...?!
Dialogue: 0,0:12:26.46,0:12:29.30,Dialogue,,0,0,0,,Жоқ. Мүмкін емес!
Dialogue: 0,0:12:26.72,0:12:29.30,Secondary Thought,,0,0,0,,Қараңдар! Бұл франшиза!
Dialogue: 0,0:12:27.17,0:12:29.30,*Default-ja,NTP,0,0,0,,Өтірік... Өтірік!
Dialogue: 0,0:12:29.30,0:12:32.54,Dialogue,,0,0,0,,Бірақ біз енді ғана кездестік!
Dialogue: 0,0:12:29.56,0:12:32.94,*Default-ja,NTP,0,0,0,,Не! Біз бүгін алғаш рет кездестік!?
Dialogue: 0,0:12:32.80,0:12:37.06,Dialogue,,0,0,0,,Керемет!
Dialogue: 0,0:12:33.11,0:12:39.22,*Default-ja,NTP,0,0,0,,Керемет! Керемет! Сооо...
Dialogue: 0,0:12:47.68,0:12:51.17,Thought,,0,0,0,,Туған жерімнің аспаны ашық, кең еді.
Dialogue: 0,0:12:47.91,0:12:50.71,*Default-ja,NTP,0,0,0,,Жергілікті аспан биік және кең болды.
Dialogue: 0,0:12:51.17,0:12:52.45,Thought,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:12:51.41,0:12:54.73,*Default-ja,NTP,0,0,0,,Бірақ... ештеңе болмады.
Dialogue: 0,0:12:53.34,0:12:55.53,Thought,,0,0,0,,Ол да бос болды.
Dialogue: 0,0:12:57.97,0:13:02.55,Thought,,0,0,0,,Бала кезімде бұл қала шытырман оқиғаға толы болатын.
Dialogue: 0,0:12:58.32,0:13:01.67,*Default-ja,NTP,0,0,0,,Бала кезімде бұл қала да шытырман оқиғаларға толы болатын.
Dialogue: 0,0:13:02.48,0:13:05.63,*Default-ja,NTP,0,0,0,,Қашаннан бері? Міне осылай шықты
Dialogue: 0,0:13:02.55,0:13:05.77,Thought,,0,0,0,,Барлығы қашан өзгерді?
Dialogue: 0,0:13:07.56,0:13:10.05,Thought,,0,0,0,,Мен бір нәрсені өзгерткім келді.
Dialogue: 0,0:13:07.99,0:13:09.58,*Default-ja,NTP,0,0,0,,Мен бір нәрсені өзгерткім келді
Dialogue: 0,0:13:10.45,0:13:14.20,Thought,,0,0,0,,Бірақ менде кетуге не ерік, не себеп болған жоқ.
Dialogue: 0,0:13:10.70,0:13:13.88,*Default-ja,NTP,0,0,0,,Бірақ менде секіруге не себеп, не батылдық болмады.
Dialogue: 0,0:13:14.20,0:13:15.52,Thought,,0,0,0,,Дәл сол кезде болды.
Dialogue: 0,0:13:14.45,0:13:15.55,*Default-ja,NTP,0,0,0,,Бұл уақыт еді...
Dialogue: 0,0:13:32.09,0:13:35.07,Dialogue,,0,0,0,,Екі рет...екі рет...
Dialogue: 0,0:13:32.58,0:13:34.66,*Default-ja,NTP,0,0,0,,Ерм~ Екі рет... Екі рет
Dialogue: 0,0:13:38.01,0:13:41.21,Thought,,0,0,0,,Ол жерде мен үшін түрлі дүниелер ашылды.
Dialogue: 0,0:13:38.41,0:13:41.40,*Default-ja,NTP,0,0,0,,Онда неше түрлі дүниелер болды.
Dialogue: 0,0:13:42.13,0:13:45.63,Thought,,0,0,0,,Мен білмеген, жете алмаған дүниелер...
Dialogue: 0,0:13:42.55,0:13:45.57,*Default-ja,NTP,0,0,0,,Білмейтін дүние, жете алмас дүние
Dialogue: 0,0:13:47.34,0:13:51.82,Thought,,0,0,0,,Мен Кидамен Токиоға көшіп кетсе де, онымен қайта сөйлесе алдым.
Dialogue: 0,0:13:47.80,0:13:51.52,*Default-ja,NTP,0,0,0,,Мен Кида-кунмен Токиоға көшкеннен кейін қайта араласа бастадым.
Dialogue: 0,0:13:55.39,0:13:58.39,Thought,,0,0,0,,Мен де жаңа достар таптым.
Dialogue: 0,0:13:55.80,0:13:57.63,*Default-ja,NTP,0,0,0,,Мен де жаңа таныстар таптым.
Dialogue: 0,0:13:59.53,0:14:02.32,Thought,,0,0,0,,Бір күні кенет ойыма бір нәрсе келді.
Dialogue: 0,0:13:59.74,0:14:01.66,*Default-ja,NTP,0,0,0,,Бір күні маған кенет ой келді.
Dialogue: 0,0:14:02.32,0:14:05.40,Thought,,0,0,0,,Басында бұл жай ғана әзіл болды.
Dialogue: 0,0:14:02.45,0:14:04.97,*Default-ja,NTP,0,0,0,,Басында бұл жай ғана әзіл болды
Dialogue: 0,0:14:05.40,0:14:07.03,Chat,,0,0,0,,Топ?
Dialogue: 0,0:14:05.97,0:14:06.86,*Default-ja,NTP,0,0,0,,Команда?
Dialogue: 0,0:14:07.03,0:14:07.69,Chat,,0,0,0,,Оқу, оқу
Dialogue: 0,0:14:07.20,0:14:07.87,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:14:07.69,0:14:11.86,Chat,,0,0,0,,Мен Токиода әртүрлі топтар бар екенін естідім.
Dialogue: 0,0:14:11.86,0:14:14.99,Chat,,0,0,0,,Интернетте топ құру дейсіз бе?
Dialogue: 0,0:14:14.99,0:14:19.17,Chat,,0,0,0,,Жоқ, біз шын мәнінде... нақты өмірде жасаймыз.
Dialogue: 0,0:14:19.17,0:14:24.17,Chat,,0,0,0,,Ол Икебукурода орналасады және біз бұл туралы желіде қауесеттер тарататын едік.
Dialogue: 0,0:14:24.17,0:14:27.76,Thought,,0,0,0,,Біз адамдарға долларда екенімізді айтпайтын едік.
Dialogue: 0,0:14:24.73,0:14:27.62,*Default-ja,NTP,0,0,0,,Біз өзімізді доллар мүшелері ретінде көрсетпейміз.
Dialogue: 0,0:14:27.76,0:14:33.93,Thought,,0,0,0,,Біз олар туралы басқа біреуден естігенімізді айтамыз және осылайша атымызды шығарамыз.
Dialogue: 0,0:14:28.13,0:14:31.43,*Default-ja,NTP,0,0,0,,Сырттан естігендей өсек айту.
Dialogue: 0,0:14:31.84,0:14:33.10,*Default-ja,NTP,0,0,0,,Өз есіміңізді таратыңыз
Dialogue: 0,0:14:33.93,0:14:36.38,Thought,,0,0,0,,Мен тіпті топтық сайт жасадым.
Dialogue: 0,0:14:34.33,0:14:36.16,*Default-ja,NTP,0,0,0,,Мен командалық веб-сайтты да жасадым.
Dialogue: 0,0:14:36.38,0:14:38.66,Thought,,0,0,0,,Ол құпия сөзбен қорғалған.
Dialogue: 0,0:14:36.66,0:14:38.13,*Default-ja,NTP,0,0,0,,Толық құпия сөз жүйесі
Dialogue: 0,0:14:38.66,0:14:42.77,Thought,,0,0,0,,Біз парольді электрондық пошта және әртүрлі хабарлар тақталары арқылы таратып алдық.
Dialogue: 0,0:14:38.88,0:14:42.22,*Default-ja,NTP,0,0,0,,Құпия сөздер электрондық пошта және әртүрлі хабарландыру тақталары арқылы бөлісілді
Dialogue: 0,0:14:43.94,0:14:47.74,Thought,,0,0,0,,Біз хабарлама тақталарында көптеген мүше жазбаларын жасадық.
Dialogue: 0,0:14:44.09,0:14:47.75,*Default-ja,NTP,0,0,0,,Біз сондай-ақ хабарландыру тақтасындағы мүшелерден көптеген хабарламалар дайындадық.
Dialogue: 0,0:14:47.97,0:14:50.78,Thought,,0,0,0,,Әрине, бізге сенбегендер көп болды.
Dialogue: 0,0:14:48.32,0:14:50.67,*Default-ja,NTP,0,0,0,,Әрине сенбегендер көп болды.
Dialogue: 0,0:14:50.78,0:14:53.73,Thought,,0,0,0,,Бірақ кейін басқалар бізді жақтай бастады...
Dialogue: 0,0:14:51.19,0:14:53.91,*Default-ja,NTP,0,0,0,,Ақыры оны қорғауға біраз адамдар келді.
Dialogue: 0,0:14:54.43,0:14:56.94,Thought,,0,0,0,,Барлығы бақытты болды.
Dialogue: 0,0:14:54.75,0:14:56.79,*Default-ja,NTP,0,0,0,,Барлығының қуанышында шек болмады.
Dialogue: 0,0:14:55.33,0:14:56.94,Chat,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:14:56.94,0:14:58.42,Chat,,0,0,0,,Оған бәрі сенеді!
Dialogue: 0,0:14:57.52,0:14:58.91,Chat,,0,0,0,,Бұл адамдар ақымақ!
Dialogue: 0,0:14:58.42,0:15:00.81,Thought,,0,0,0,,Мен бұл туралы жағымсыз сезімде болдым.
Dialogue: 0,0:14:58.54,0:15:00.73,*Default-ja,NTP,0,0,0,,Менде жағымсыз сезім болды...
Dialogue: 0,0:15:08.80,0:15:13.68,Thought,,0,0,0,,Шынайы өмірде адамдар өздерін доллар деп атай бастады.
Dialogue: 0,0:15:09.18,0:15:12.94,*Default-ja,NTP,0,0,0,,Өздерін доллар деп атайтын адамдар шынайы әлемде пайда бола бастады.
Dialogue: 0,0:15:13.68,0:15:15.60,Thought,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:15:13.75,0:15:15.00,*Default-ja,NTP,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:15:16.41,0:15:19.31,Thought,,0,0,0,,Біз назар аудармаған кезде мүшелер саны көбейе берді.
Dialogue: 0,0:15:16.71,0:15:19.84,*Default-ja,NTP,0,0,0,,Мүшелер мен білместен көбейе берді.
Dialogue: 0,0:15:20.32,0:15:23.33,Thought,,0,0,0,,Құпия сөзді беруді тоқтатқанымызға қарамастан...
Dialogue: 0,0:15:20.64,0:15:23.09,*Default-ja,NTP,0,0,0,,Мен құпия сөзімді беруді тоқтатқан едім.
Dialogue: 0,0:15:23.33,0:15:26.03,Thought,,0,0,0,,Бір жерде біреу сияқты болды...
Dialogue: 0,0:15:23.69,0:15:28.05,*Default-ja,NTP,0,0,0,,Бір жерде біреу ақпарат таратып жатқандай...
Dialogue: 0,0:15:26.03,0:15:27.82,Thought,,0,0,0,,Ақпаратты таратып отырды.
Dialogue: 0,0:15:29.15,0:15:31.71,Chat,,0,0,0,,Барлығы қарап тұр ма?
Dialogue: 0,0:15:31.71,0:15:33.82,Chat,,0,0,0,,Хей!
Dialogue: 0,0:15:32.24,0:15:33.82,Thought,,0,0,0,,Олар қорқып кеткен шығар...
Dialogue: 0,0:15:32.51,0:15:33.66,*Default-ja,NTP,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:15:33.82,0:15:38.49,Thought,,0,0,0,,Бірақ мен The Dollars жасаған адамдар жоғалып кетті.
Dialogue: 0,0:15:34.10,0:15:37.60,*Default-ja,NTP,0,0,0,,Долларды бірге жасағандардың бәрі кетті.
Dialogue: 0,0:15:41.75,0:15:44.10,Thought,,0,0,0,,Сонда да мен кеткен жоқпын.
Dialogue: 0,0:15:42.20,0:15:44.06,*Default-ja,NTP,0,0,0,,Мен әлі де тастамадым
Dialogue: 0,0:15:44.10,0:15:46.50,Thought,,0,0,0,,Жоқ, мен бас тарта алмадым.
Dialogue: 0,0:15:44.34,0:15:46.60,*Default-ja,NTP,0,0,0,,Жоқ, мен тоқтай алмадым.
Dialogue: 0,0:15:46.87,0:15:50.76,Thought,,0,0,0,,Тіпті неге екенін білмеймін, бірақ...
Dialogue: 0,0:15:47.17,0:15:48.86,*Default-ja,NTP,0,0,0,,Неге екенін өзім де білмеймін
Dialogue: 0,0:15:49.56,0:15:50.49,*Default-ja,NTP,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:15:52.12,0:15:54.15,Chat,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:15:54.15,0:15:56.32,Chat,,0,0,0,,Бұл жерде кейбір жаман адамдар болуы мүмкін.
Dialogue: 0,0:15:56.32,0:15:59.52,Chat,,0,0,0,,Дегенмен, ондай емес адамдар болуы керек.
Dialogue: 0,0:15:59.52,0:16:04.00,Chat,,0,0,0,,Бізге тек The Dollars тобын жақсы топқа айналдыру керек, солай емес пе?
Dialogue: 0,0:15:59.99,0:16:03.78,*Default-ja,NTP,0,0,0,,Біз долларды жақсы топқа айналдыруымыз керек емес пе?
Dialogue: 0,0:16:04.00,0:16:08.76,Chat,,0,0,0,,Жаман атағымыздан құтылатын нәрселерді жасай алар едік.
Dialogue: 0,0:16:04.23,0:16:08.45,*Default-ja,NTP,0,0,0,,Жамандық жасайтын адамдардың әсерлерін өшіру үшін сіз жеткілікті жақсылық жасайсыз ба?
Dialogue: 0,0:16:12.92,0:16:17.28,Chat,,0,0,0,,Қаланың айналасындағы қоқыстарды жинау немесе граффитиді өшіру сияқты...
Dialogue: 0,0:16:13.22,0:16:17.49,*Default-ja,NTP,0,0,0,,Мысалы, көшеде қоқыс жинау немесе қабырғалардағы граффитилерді өшіру...
Dialogue: 0,0:16:24.54,0:16:28.06,Dialogue,,0,0,0,,Сонымен, тұрғындар әбден абдырап қалды.
Dialogue: 0,0:16:24.62,0:16:27.85,*Default-ja,NTP,0,0,0,,Сондықтан тұрғындар да абдырап қалды.
Dialogue: 0,0:16:28.06,0:16:33.50,Dialogue,,0,0,0,,Бұл қабырғадағы граффити кеше осында екені анық...
Dialogue: 0,0:16:28.23,0:16:30.39,*Default-ja,NTP,0,0,0,,Мұнда қабырғадағы граффити
Dialogue: 0,0:16:30.71,0:16:33.43,*Default-ja,NTP,0,0,0,,Кеше түн ортасына дейін сонда болғанына сенімдімін.
Dialogue: 0,0:16:33.50,0:16:36.30,Dialogue,,0,0,0,,Көріп отырғаныңыздай, ол қазір толығымен жойылды.
Dialogue: 0,0:16:33.80,0:16:36.33,*Default-ja,NTP,0,0,0,,Осылай таза жоғалып кетті
Dialogue: 0,0:16:36.30,0:16:40.94,Dialogue,,0,0,0,,Бір адамның өшіруі екіталай...
Dialogue: 0,0:16:36.85,0:16:38.44,*Default-ja,NTP,0,0,0,,Тек ауқымды граффити
Dialogue: 0,0:16:38.67,0:16:40.56,*Default-ja,NTP,0,0,0,,Мен оны өзім жойғаныма сене алар емеспін.
Dialogue: 0,0:16:40.94,0:16:44.32,Dialogue,,0,0,0,,...оны салуға көптеген адамдарды салған бұл граффити...
Dialogue: 0,0:16:40.95,0:16:43.83,*Default-ja,NTP,0,0,0,,Көрші тұрғындар да абдырап қалды...
Dialogue: 0,0:16:41.50,0:16:44.31,Secondary,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,0:16:41.71,0:16:43.24,*Default-ja,NTP,0,0,0,,Мен сенбеймін...
Dialogue: 0,0:16:44.56,0:16:47.17,Thought,,0,0,0,,Мен Киданың шақыруымен Токиоға кеттім.
Dialogue: 0,0:16:44.62,0:16:47.20,*Default-ja,NTP,0,0,0,,Кида-кун мені Токиоға шақырды.
Dialogue: 0,0:16:47.19,0:16:48.00,Thought,,0,0,0,,Және ...
Dialogue: 0,0:16:47.46,0:16:48.05,*Default-ja,NTP,0,0,0,,Ол дерлік сатылып кеткен екен.
Dialogue: 0,0:16:47.74,0:16:48.44,Dialogue,,0,0,0,,Доллар?
Dialogue: 0,0:16:48.05,0:16:48.67,*Default-ja,NTP,0,0,0,,Доллар?
Dialogue: 0,0:16:48.44,0:16:51.82,Dialogue,,0,0,0,,Мен де олар туралы көп білмеймін.
Dialogue: 0,0:16:48.69,0:16:51.86,*Default-ja,NTP,0,0,0,,Мен де егжей-тегжейлі білмеймін.
Dialogue: 0,0:16:51.82,0:16:56.89,Dialogue,,0,0,0,,Қалай болғанда да, олар көп сияқты және олардың бәрінің мінезі қысқа.
Dialogue: 0,0:16:52.46,0:16:56.74,*Default-ja,NTP,0,0,0,,Қалай болғанда да, адамдардың көп болғаны сонша, бұл бір үзік сызықты команда сияқты көрінді.
Dialogue: 0,0:16:56.89,0:17:00.36,Dialogue,,0,0,0,,Олар банда сияқты, бірақ олардың түсі қандай екенін ешкім білмейді.
Dialogue: 0,0:16:57.00,0:17:00.40,*Default-ja,NTP,0,0,0,,Бұл түсті топ сияқты, бірақ мен оның түсі қандай екенін білмеймін.
Dialogue: 0,0:17:00.36,0:17:02.36,Dialogue,,0,0,0,,Тек қызығушылықпен оларға жақындамаңыз.
Dialogue: 0,0:17:00.48,0:17:02.53,*Default-ja,NTP,0,0,0,,Оған тек қызығушылықпен жақындамаған дұрыс.
Dialogue: 0,0:17:03.25,0:17:06.29,Dialogue,,0,0,0,,Қажетсіз ізденімпаз болмаңыз.
Dialogue: 0,0:17:03.45,0:17:05.86,*Default-ja,NTP,0,0,0,,Қажетсіз тексеруден аулақ болыңыз.
Dialogue: 0,0:17:06.29,0:17:09.30,Dialogue,,0,0,0,,Бірақ қазір қаладағы ең күшті адамдар - долларлар, солай ма?
Dialogue: 0,0:17:06.32,0:17:09.33,*Default-ja,NTP,0,0,0,,Бірақ дәл қазір бұл қаладағы ең күшті адам доллар болар еді, солай ма?
Dialogue: 0,0:17:09.30,0:17:12.03,Dialogue,,0,0,0,,Сонымен, бұл долларлар қандай топқа жатады?
Dialogue: 0,0:17:09.50,0:17:12.00,*Default-ja,NTP,0,0,0,,Сонымен, долларлар қандай команда?
Dialogue: 0,0:17:12.79,0:17:16.26,Dialogue,,0,0,0,,Егер мен айту керек болса, олар «анық түссіз» деп ойлаймын.
Dialogue: 0,0:17:13.14,0:17:15.87,*Default-ja,NTP,0,0,0,,Айту керек болса, түссіз, мөлдір дер едім.
Dialogue: 0,0:17:17.96,0:17:20.61,Dialogue,,0,0,0,,Доллар? Мен оларды білемін.
Dialogue: 0,0:17:18.33,0:17:20.23,*Default-ja,NTP,0,0,0,,Доллар? Мен білемін
Dialogue: 0,0:17:20.61,0:17:22.80,Dialogue,,0,0,0,,Өйткені мен бірмін.
Dialogue: 0,0:17:20.77,0:17:23.04,*Default-ja,NTP,0,0,0,,Айтайын дегенім, мен доллармын.
Dialogue: 0,0:17:22.80,0:17:25.56,Dialogue,,0,0,0,,Мен The Dollars тобына қосылу арқылы қыз таптым!
Dialogue: 0,0:17:23.28,0:17:25.58,*Default-ja,NTP,0,0,0,,Мен Dollars-қа қосылып, қыз таптым!
Dialogue: 0,0:17:25.56,0:17:28.52,Dialogue,,0,0,0,,Олар хабарлама тақталарына ақымақ нәрселер жазады.
Dialogue: 0,0:17:26.07,0:17:28.82,*Default-ja,NTP,0,0,0,,Хабарландыру тақтасына сандырақ жазу...
Dialogue: 0,0:17:28.52,0:17:31.02,Dialogue,,0,0,0,,Біреу әрқашан сіздің жазбаларыңызға жауап береді.
Dialogue: 0,0:17:28.98,0:17:31.30,*Default-ja,NTP,0,0,0,,Біреу әйтеуір жауап береді.
Dialogue: 0,0:17:31.02,0:17:35.82,Dialogue,,0,0,0,,Бұл жаста сіз жұмыстан тыс ешкіммен қарым-қатынас жасай алмайсыз.
Dialogue: 0,0:17:31.43,0:17:35.80,*Default-ja,NTP,0,0,0,,Бұл жаста мен жұмыстан тыс қарым-қатынас жасай алмаймын.
Dialogue: 0,0:17:35.82,0:17:42.04,Dialogue,,0,0,0,,Сіз естідіңіз бе? Доллар кейбір адамдарды адам саудагерлерінен құтқарды!
Dialogue: 0,0:17:36.30,0:17:42.56,*Default-ja,NTP,0,0,0,,Сіз білесіз бе!? Адамды аңшы ұрлап әкетпек болған жігітті доллар құтқарып қалды!
Dialogue: 0,0:17:42.40,0:17:44.01,Dialogue,,0,0,0,,Доллар ең күшті!
Dialogue: 0,0:17:42.69,0:17:44.18,*Default-ja,NTP,0,0,0,,Доллар ең жақсы!
Dialogue: 0,0:17:44.83,0:17:47.78,Dialogue,,0,0,0,,Шын мәнінде емес. Бұл қызық; жеткілікті емес пе?
Dialogue: 0,0:17:45.41,0:17:48.20,*Default-ja,NTP,0,0,0,,Шынымен де... Қызық, солай емес пе?
Dialogue: 0,0:18:05.83,0:18:09.05,Dialogue,,0,0,0,,Бұл мен ойлағаннан әлдеқайда қызықты.
Dialogue: 0,0:18:06.10,0:18:08.80,*Default-ja,NTP,0,0,0,,Бұл мен күткеннен де қызық болды.
Dialogue: 0,0:18:10.73,0:18:12.86,Dialogue,,0,0,0,,Бұл қызық, солай емес пе?
Dialogue: 0,0:18:11.17,0:18:12.46,*Default-ja,NTP,0,0,0,,Бұл қызық, солай емес пе?
Dialogue: 0,0:18:15.94,0:18:17.25,Dialogue,,0,0,0,,Жер
Dialogue: 0,0:18:16.25,0:18:18.30,*Default-ja,NTP,0,0,0,,Не!? Бұл не?
Dialogue: 0,0:18:17.25,0:18:17.99,Dialogue,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:18:18.38,0:18:20.45,Dialogue,,0,0,0,,Бұл адамдар кімдер?!
Dialogue: 0,0:18:18.59,0:18:20.51,*Default-ja,NTP,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:18:23.42,0:18:27.46,Dialogue,,0,0,0,,Эй, қалай ойлайсың, The Dollars негізін қалаушы қайдан?
Dialogue: 0,0:18:23.79,0:18:27.25,*Default-ja,NTP,0,0,0,,Эй, эй, доллардың негізін қалаушы кім?
Dialogue: 0,0:18:27.46,0:18:30.19,Dialogue,,0,0,0,,Мұнда араб мұнай магнаты бар ма?
Dialogue: 0,0:18:27.62,0:18:30.04,*Default-ja,NTP,0,0,0,,Араб мұнай магнатына ұқсайтын адам бар ма?
Dialogue: 0,0:18:30.19,0:18:32.16,Dialogue,,0,0,0,,Оған ұқсамайды.
Dialogue: 0,0:18:30.42,0:18:32.10,*Default-ja,NTP,0,0,0,,Ол жоқ.
Dialogue: 0,0:18:32.16,0:18:37.30,Dialogue,,0,0,0,,Бізге бұл жауапты жіберген адам The Dollars-тың негізін қалаушы болып табылады, солай емес пе?
Dialogue: 0,0:18:32.35,0:18:37.30,*Default-ja,NTP,0,0,0,,Ватакуса-сан, бізге жауап берген адам нағыз құрылтайшы, солай ма?
Dialogue: 0,0:18:37.30,0:18:40.26,Dialogue,,0,0,0,,Уф... мен естідім...
Dialogue: 0,0:18:38.96,0:18:40.48,*Default-ja,NTP,0,0,0,,Бірақ...
Dialogue: 0,0:18:40.26,0:18:42.47,Dialogue,,0,0,0,,Тоғуса, жарық қызыл!
Dialogue: 0,0:18:40.81,0:18:43.64,*Default-ja,NTP,0,0,0,,Ватакуса! Бағдаршам қызыл қызыл! Қызыл~?
Dialogue: 0,0:18:42.47,0:18:44.06,Dialogue,,0,0,0,,Бұл қызыл! Бұл қызыл!
Dialogue: 0,0:18:52.80,0:18:55.00,Dialogue,,0,0,0,,Тыныш түрі, иә?
Dialogue: 0,0:18:52.99,0:18:54.56,*Default-ja,NTP,0,0,0,,Жарай ма?
Dialogue: 0,0:18:56.10,0:18:58.08,Dialogue,,0,0,0,,Дотачин, Дотачин!
Dialogue: 0,0:18:56.35,0:18:57.75,*Default-ja,NTP,0,0,0,,Dotachin Dotachin!
Dialogue: 0,0:18:58.08,0:19:00.03,Dialogue,,0,0,0,,Мен саған олай атама дедім.
Dialogue: 0,0:18:58.22,0:18:59.90,*Default-ja,NTP,0,0,0,,Сонымен, бұл атаумен ...
Dialogue: 0,0:19:00.03,0:19:02.86,Dialogue,,0,0,0,,Біреу Dollars хабарлама тақтасындағы жазбама жауап берді.
Dialogue: 0,0:19:00.47,0:19:03.24,*Default-ja,NTP,0,0,0,,Бұл! Мен Dollars хабарландыру тақтасында жауап алдым!
Dialogue: 0,0:19:12.50,0:19:14.81,Dialogue,,0,0,0,,Барлығы тәртіппен.
Dialogue: 0,0:19:12.94,0:19:14.56,*Default-ja,NTP,0,0,0,,Шаралар орындалды
Dialogue: 0,0:19:14.81,0:19:17.26,Dialogue,,0,0,0,,Мен саған онымен кездесуге рұқсат етемін.
Dialogue: 0,0:19:14.91,0:19:16.24,*Default-ja,NTP,0,0,0,,Маған онымен танысуға рұқсат етіңіз
Dialogue: 0,0:19:18.31,0:19:23.22,Dialogue,,0,0,0,,Керісінше, менімен де қызметтес болғаныңызды қалаймын.
Dialogue: 0,0:19:18.59,0:19:22.84,*Default-ja,NTP,0,0,0,,Керісінше, менімен ынтымақтасуыңызды өтінемін.
Dialogue: 0,0:19:57.50,0:19:59.59,Dialogue,,0,0,0,,Келти.
Dialogue: 0,0:19:57.76,0:19:59.12,*Default-ja,NTP,0,0,0,,Келти
Dialogue: 0,0:20:11.75,0:20:12.78,Dialogue,,0,0,0,,Ол мұнда жоқ.
Dialogue: 0,0:20:12.02,0:20:12.84,*Default-ja,NTP,0,0,0,,Жоқ...
Dialogue: 0,0:20:12.78,0:20:14.66,Dialogue,,0,0,0,,Сіз не үшін бос жүрсіз?!
Dialogue: 0,0:20:12.92,0:20:16.15,*Default-ja,NTP,0,0,0,,Не туралы күбірлеп тұрсың? Тез іздеңіз!
Dialogue: 0,0:20:14.66,0:20:16.11,Dialogue,,0,0,0,,Оны іздеуді бастаңыз!
Dialogue: 0,0:20:16.11,0:20:17.67,Dialogue,,0,0,0,,Иә, ханым. Оны жылжытыңыз!
Dialogue: 0,0:20:16.52,0:20:16.97,*Default-ja,NTP,0,0,0,,Иә!
Dialogue: 0,0:20:17.03,0:20:17.69,*Default-ja,NTP,0,0,0,,Жолдан кет!
Dialogue: 0,0:20:17.67,0:20:18.85,Dialogue,,0,0,0,,Ол қайда кетті?
Dialogue: 0,0:20:17.94,0:20:18.74,*Default-ja,NTP,0,0,0,,Қайда бардың!
Dialogue: 0,0:20:18.85,0:20:20.39,Dialogue,,0,0,0,,Боқ. Оны жылжытыңыз!
Dialogue: 0,0:20:19.09,0:20:20.68,*Default-ja,NTP,0,0,0,,Қарғыс атсын! Жолдан кет!
Dialogue: 0,0:20:20.78,0:20:21.93,*Default-ja,NTP,0,0,0,,Ол қайда!?
Dialogue: 0,0:20:21.00,0:20:21.86,Dialogue,,0,0,0,,Менің жолымнан кет.
Dialogue: 0,0:20:33.99,0:20:35.46,Dialogue,,0,0,0,,Менде болды!
Dialogue: 0,0:20:37.75,0:20:38.88,Dialogue,,0,0,0,,Мұны кім айтты?
Dialogue: 0,0:20:38.09,0:20:39.07,*Default-ja,NTP,0,0,0,,Кімнің дауысы?
Dialogue: 0,0:20:40.18,0:20:41.88,Dialogue,,0,0,0,,Менің басым жоқ!
Dialogue: 0,0:20:40.25,0:20:43.59,*Default-ja,NTP,0,0,0,,Менің басым жоқ! Мен құбыжықпын!
Dialogue: 0,0:20:42.19,0:20:43.95,Dialogue,,0,0,0,,Мен құбыжықпын!
Dialogue: 0,0:20:43.95,0:20:47.64,Dialogue,,0,0,0,,Менің сөйлесетін аузым да, тіпті басқаларға құмарлығымды жеткізетін көзім де жоқ!
Dialogue: 0,0:20:43.97,0:20:47.55,*Default-ja,NTP,0,0,0,,Көп айтуға аузым да, құмарлықымды өзгеге жеткізер көзім де жоқ!
Dialogue: 0,0:20:48.80,0:20:49.98,Dialogue,,0,0,0,,Сіз бірдеңе естіп тұрсыз ба?
Dialogue: 0,0:20:49.10,0:20:49.92,*Default-ja,NTP,0,0,0,,Мен бірдеңе естідім
Dialogue: 0,0:20:49.98,0:20:50.88,Dialogue,,0,0,0,,Бұл қайдан келеді?
Dialogue: 0,0:20:49.98,0:20:51.08,*Default-ja,NTP,0,0,0,,Бұл қандай дауыс?
Dialogue: 0,0:20:50.88,0:20:52.64,Dialogue,,0,0,0,,Олай етпесем ше?!
Dialogue: 0,0:20:51.34,0:20:55.49,*Default-ja,NTP,0,0,0,,Бірақ бұл туралы не деуге болады! Бұған не болды?
Dialogue: 0,0:20:52.96,0:20:55.89,Dialogue,,0,0,0,,Олай етпесем ше?!
Dialogue: 0,0:20:56.67,0:20:57.73,Dialogue,,0,0,0,,Селти...
Dialogue: 0,0:20:56.90,0:20:58.09,*Default-ja,NTP,0,0,0,,Celty…
Dialogue: 0,0:21:09.04,0:21:10.94,Dialogue,,0,0,0,,Мен дәл осындамын.
Dialogue: 0,0:21:09.36,0:21:13.68,*Default-ja,NTP,0,0,0,,Мен осындамын. Мен мұндамын.
Dialogue: 0,0:21:11.56,0:21:13.99,Dialogue,,0,0,0,,Мен бұл жерде міндетті түрде бармын.
Dialogue: 0,0:21:13.99,0:21:15.66,Dialogue,,0,0,0,,Сен кімсің?!
Dialogue: 0,0:21:14.21,0:21:15.03,*Default-ja,NTP,0,0,0,,Бұл не?!
Dialogue: 0,0:21:16.86,0:21:18.52,Dialogue,,0,0,0,,Сіз—
Dialogue: 0,0:21:20.67,0:21:26.10,Dialogue,,0,0,0,,Менің көзім жоқ болғандықтан, мен саған шын мәнінде қандай екенімді көрсетемін!
Dialogue: 0,0:21:21.00,0:21:22.53,*Default-ja,NTP,0,0,0,,Көздеріңіз болмаса
Dialogue: 0,0:21:22.82,0:21:25.62,*Default-ja,NTP,0,0,0,,Менің барлық істеріме мұқият қараңыз!
Dialogue: 0,0:21:27.87,0:21:28.60,Dialogue,,0,0,0,,Өл!
Dialogue: 0,0:21:28.14,0:21:28.74,*Default-ja,NTP,0,0,0,,Олай болса!
Dialogue: 0,0:21:28.60,0:21:33.82,Dialogue,,0,0,0,,Құбыжықты көргендердің айқайын қалағаныңызша тыңдаңыз!
Dialogue: 0,0:21:28.80,0:21:33.52,*Default-ja,NTP,0,0,0,,Құбыжықтың қаһарына ұшырағандардың зарын тыңда!
Dialogue: 0,0:22:01.13,0:22:04.21,Dialogue,,0,0,0,,Басы жоқ шабандоз...
Dialogue: 0,0:22:01.59,0:22:03.96,*Default-ja,NTP,0,0,0,,Ку… Басы жоқ шабандоз…
Dialogue: 0,0:22:04.63,0:22:06.28,Dialogue,,0,0,0,,Басы жоқ шабандоз.
Dialogue: 0,0:22:04.82,0:22:05.97,*Default-ja,NTP,0,0,0,,Басы жоқ шабандоз!
Dialogue: 0,0:22:06.28,0:22:07.05,Dialogue,,0,0,0,,Кім?
Dialogue: 0,0:22:06.54,0:22:08.35,*Default-ja,NTP,0,0,0,,Бұл... Басы жоқ шабандоз!?
Dialogue: 0,0:22:07.05,0:22:08.53,Dialogue,,0,0,0,,Басы жоқ шабандоз?
Dialogue: 0,0:22:08.97,0:22:11.30,Dialogue,,0,0,0,,Мен осындамын.
Dialogue: 0,0:22:09.66,0:22:13.88,*Default-ja,NTP,0,0,0,,Мен мұндамын, мен мұндамын... Мен мұндамын.
Dialogue: 0,0:22:11.30,0:22:12.60,Dialogue,,0,0,0,,Мен дәл осындамын.
Dialogue: 0,0:22:12.60,0:22:14.00,Dialogue,,0,0,0,,Мен дәл осындамын!
Dialogue: 0,0:22:14.00,0:22:17.94,Dialogue,,0,0,0,,Мен қазірдің өзінде жылап жатырмын ... деп жылап жатырмын ...!
Dialogue: 0,0:22:14.67,0:22:17.65,*Default-ja,NTP,0,0,0,,Айқайлап жатырмын... Айқайлап жатырмын!
Dialogue: 0,0:22:17.94,0:22:19.98,Dialogue,,0,0,0,,«Мен дәл осы жерде және қазір тудым!»
Dialogue: 0,0:22:18.20,0:22:20.12,*Default-ja,NTP,0,0,0,,Мен қазір осында тудым!
Dialogue: 0,0:22:20.34,0:22:24.73,Dialogue,,0,0,0,,Менің бар болуым осы қалада жазылуы үшін!
Dialogue: 0,0:22:20.81,0:22:24.99,*Default-ja,NTP,0,0,0,,Менің осы қалада болуым туралы мөртаңба қою үшін!
Dialogue: 0,0:22:30.85,0:22:33.37,Dialogue,,0,0,0,,Сонда сен Рюгамин Микадосың ба?
Dialogue: 0,0:22:30.95,0:22:32.77,*Default-ja,NTP,0,0,0,,Сіз Рюгамин Микадосыз ба?
Dialogue: 0,0:22:37.45,0:22:39.11,Dialogue,,0,0,0,,Селти...
Dialogue: 0,0:22:37.92,0:22:42.42,*Default-ja,NTP,0,0,0,,Селти... Маған Селтиді қайтарып беріңізші~?
Dialogue: 0,0:22:39.11,0:22:42.13,Dialogue,,0,0,0,,Селти маған қайтарыңыз!
Dialogue: 0,0:24:14.68,0:24:16.28,Dialogue,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:24:15.10,0:24:19.72,staff,NTP,0,0,0,,Өндіріс: lastzzz Rest Cloud akira Akira
Dialogue: 0,0:24:15.34,0:24:19.33,*Default-ja,NTP,0,0,0,,Иә, мен бұл қалада бір шындықты аштым.
Dialogue: 0,0:24:16.28,0:24:19.64,Dialogue,,0,0,0,,Мен бұл қалада бір шындықты білдім.
Dialogue: 0,0:24:19.64,0:24:23.59,Dialogue,,0,0,0,,Мен тым қарапайым, табу оңай нәрсе іздедім.
Dialogue: 0,0:24:19.81,0:24:23.35,*Default-ja,NTP,0,0,0,,Мен тым қарапайым, тым қарапайым нәрсе таптым.
Dialogue: 0,0:24:19.88,0:24:24.87,staff,NTP,0,0,0,,Manyu субтитрлер жұбы http://popgo.net/bbs/
Dialogue: 0,0:24:23.59,0:24:26.39,Dialogue,,0,0,0,,Әлгі бала тағы да...
Dialogue: 0,0:24:23.73,0:24:26.09,*Default-ja,NTP,0,0,0,,Мүмкін ол бала да...
Dialogue: 0,0:24:26.39,0:24:29.57,Dialogue,,0,0,0,,Келесі жолы: Барлығы салыстырмалы.
