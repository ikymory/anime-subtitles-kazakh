Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:08.04,0:01:09.21,*Default,NTP,0000,0000,0000,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:01:09.30,0:01:11.24,*Default,NTP,0000,0000,0000,,Камисакурамачи Гинзаға қарағанда ғажайып
Dialogue: 0,0:01:11.36,0:01:13.01,*Default,NTP,0000,0000,0000,,Өйткені мен де жартысын білемін.
Dialogue: 0,0:01:13.09,0:01:15.18,*Default,NTP,0000,0000,0000,,Мен не болғанын нақты білмеймін.
Dialogue: 0,0:01:15.46,0:01:18.80,*Default,NTP,0000,0000,0000,,Бұл жерде басқа да қауіпті адамдар көп, сондықтан сақ болыңыз.
Dialogue: 0,0:01:19.05,0:01:22.58,*Default,NTP,0000,0000,0000,,Айтпақшы, мен бүгін сол қара велосипедті көрдім.
Dialogue: 0,0:01:22.94,0:01:26.24,*Default,NTP,0000,0000,0000,,Мен дәмді нәрсенің дәмін татып көрмегелі көп болды. Жасөспірім қыз
Dialogue: 0,0:01:26.40,0:01:27.98,*Default,NTP,0000,0000,0000,,Ақпарат беруші мырза.
Dialogue: 0,0:01:28.41,0:01:32.38,*Default,NTP,0000,0000,0000,,Сол кезде мен денемнің дірілдеп тұрғанын байқадым.
Dialogue: 0,0:01:59.23,0:02:01.46,*Default,NTP,0000,0000,0000,,Сіз көріп отырған шындық
Dialogue: 0,0:02:02.31,0:02:04.48,*Default,NTP,0000,0000,0000,,Бұл шынымен де шынайы ма?
Dialogue: 0,0:02:05.66,0:02:08.41,*Default,NTP,0000,0000,0000,,Таныс пейзаж бұрынғысынша өзгеріссіз қалады.
Dialogue: 0,0:02:10.06,0:02:13.59,*Default,NTP,0000,0000,0000,,Барлығыңызды қабылдауыңызбен құттықтаймыз.
Dialogue: 0,0:02:14.16,0:02:19.45,*Default,NTP,0000,0000,0000,,Қазіргі уақытта Жапонияда туу деңгейінің төмендеуі және қоғам теңсіздігі сияқты көптеген қараңғы тақырыптар бар...
Dialogue: 0,0:02:19.83,0:02:22.84,*Default,NTP,0000,0000,0000,,Барлығыңызға қарап
Dialogue: 0,0:02:23.15,0:02:25.20,*Default,NTP,0000,0000,0000,,Бұл елдің болашағы жарқын
Dialogue: 0,0:02:25.54,0:02:29.83,*Default,NTP,0000,0000,0000,,Менің ойымша, Жапония әлі де жақсы жағдайда.
Dialogue: 0,0:02:30.04,0:02:31.50,*Default,NTP,0000,0000,0000,,Мен жігерлендім.
Dialogue: 0,0:02:32.04,0:02:35.02,*Default,NTP,0000,0000,0000,,Бүгін барлығына шуақты күн, бірақ...
Dialogue: 0,0:02:36.41,0:02:38.25,*Default,NTP,0000,0000,0000,,Барлық жерде күнделікті өмір
Dialogue: 0,0:02:38.61,0:02:43.01,*Default,NTP,0000,0000,0000,,Оның бүгінде осында таралып жатқанына сенбейсің бе?
Dialogue: 0,0:02:46.35,0:02:48.21,*Default,NTP,0000,0000,0000,,Рю... Бұл Микадо Рюгамин.
Dialogue: 0,0:02:49.19,0:02:52.48,*Default,NTP,0000,0000,0000,,Токиоға жаңа келген ұяң бала
Dialogue: 0,0:02:52.82,0:02:53.97,*Default,NTP,0000,0000,0000,,Бұл Анри Сонохара.
Dialogue: 0,0:02:54.80,0:02:56.26,*Default,NTP,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:02:57.99,0:03:01.22,*Default,NTP,0000,0000,0000,,Дүниеден сәл алыстап кеткен қыз
Dialogue: 0,0:03:02.76,0:03:03.95,*Default,NTP,0000,0000,0000,,Бұл Масамоми Кида!
Dialogue: 0,0:03:04.47,0:03:07.06,*Default,NTP,0000,0000,0000,,Бұл ересектерге ұқсайды.
Dialogue: 0,0:03:07.49,0:03:09.10,*Default,NTP,0000,0000,0000,,Ішінде бәрі бірдей
Dialogue: 0,0:03:09.25,0:03:11.05,*Default,NTP,0000,0000,0000,,Сынғыш және оңай зақымдалады
Dialogue: 0,0:03:11.24,0:03:12.40,*Default,NTP,0000,0000,0000,,Мен 15 жастамын!
Dialogue: 0,0:03:12.66,0:03:15.09,*Default,NTP,0000,0000,0000,,Бір ғана бақытты бала
Dialogue: 0,0:03:15.20,0:03:16.39,*Default,NTP,0000,0000,0000,,Бұл Рио Камичика.
Dialogue: 0,0:03:16.90,0:03:18.36,*Default,NTP,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:03:18.88,0:03:21.49,*Default,NTP,0000,0000,0000,,Қараңғы жағы бар қыз
Dialogue: 0,0:03:22.50,0:03:25.68,*Default,NTP,0000,0000,0000,,Сіздің айналаңызда қандай адамдар бар
Dialogue: 0,0:03:26.12,0:03:27.02,*Default,NTP,0000,0000,0000,,Харима…
Dialogue: 0,0:03:28.42,0:03:30.64,*Default,NTP,0000,0000,0000,,Мика Харима жоқ па?
Dialogue: 0,0:03:34.15,0:03:35.79,*Default,NTP,0000,0000,0000,,Жоқ және
Dialogue: 0,0:03:36.12,0:03:39.68,*Default,NTP,0000,0000,0000,,Бұрын бір жерден көрген нәрсе сияқты көрінетін қарапайым көрініс.
Dialogue: 0,0:03:41.05,0:03:43.38,*Default,NTP,0000,0000,0000,,Ах~ Бірінші күннен кешігіп қалдыңыз ба?
Dialogue: 0,0:03:44.05,0:03:45.90,*Default,NTP,0000,0000,0000,,Мен қазір өзімді таныстырып жатырмын.
Dialogue: 0,0:03:46.03,0:03:47.72,*Default,NTP,0000,0000,0000,,Оны орнында орындаңыз
Dialogue: 0,0:03:47.91,0:03:49.34,*Default,NTP,0000,0000,0000,,Бұл Сейджи Ягири.
Dialogue: 0,0:03:50.03,0:03:51.61,*Default,NTP,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:03:53.03,0:03:55.60,*Default,NTP,0000,0000,0000,,Алайда, кездейсоқ
Dialogue: 0,0:03:55.95,0:04:00.75,*Default,NTP,0000,0000,0000,,Шындық бізге тағы бір белгісіз шындықтың көрінісін бере алады.
Dialogue: 0,0:04:01.33,0:04:02.91,*Default,NTP,0000,0000,0000,,Кел, Ягири
Dialogue: 0,0:04:03.02,0:04:04.99,*Default,NTP,0000,0000,0000,,Орныңызға ерте отырыңыз.
Dialogue: 0,0:04:05.24,0:04:06.32,*Default,NTP,0000,0000,0000,,Келмейді
Dialogue: 0,0:04:07.74,0:04:11.02,*Default,NTP,0000,0000,0000,,Біраз уақыт мектепке келе алмаймын деп ойлаймын.
Dialogue: 0,0:04:11.18,0:04:14.04,*Default,NTP,0000,0000,0000,,Жоқ, ол енді келмеуі мүмкін.
Dialogue: 0,0:04:15.24,0:04:16.79,*Default,NTP,0000,0000,0000,,Соны айтайын деп келдім.
Dialogue: 0,0:04:17.11,0:04:18.19,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:04:19.49,0:04:22.45,*Default,NTP,0000,0000,0000,,Эй Ягири, бұл не...
Dialogue: 0,0:04:23.32,0:04:24.71,*Default,NTP,0000,0000,0000,,Бұл сізге де, маған да тиімді мәміле, иә?
Dialogue: 0,0:04:25.22,0:04:29.10,*Default,NTP,0000,0000,0000,,Мен үшін бұл менің өмірімдегі өте маңызды нәрсе.
Dialogue: 0,0:04:29.51,0:04:32.11,*Default,NTP,0000,0000,0000,,Менің сендермен айналысатын уақытым жоқ.
Dialogue: 0,0:04:32.76,0:04:33.80,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:04:34.84,0:04:38.15,*Default,NTP,0000,0000,0000,,Ах... Эй Ягири, күт... күт.
Dialogue: 0,0:04:38.42,0:04:41.61,*Default,NTP,0000,0000,0000,,Бейбіт күнделікті өмірде кенеттен пайда болған жарықшақ
Dialogue: 0,0:04:41.88,0:04:43.62,*Default,NTP,0000,0000,0000,,адамдарды ренжітеді
Dialogue: 0,0:04:44.31,0:04:48.12,*Default,NTP,0000,0000,0000,,Бұл жерде де бір қыз бар екен...
Dialogue: 0,0:04:49.04,0:04:50.42,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:04:50.60,0:04:53.12,*Default,NTP,0000,0000,0000,,Негізі екі күн бұрын өлуі керек еді.
Dialogue: 0,0:04:56.89,0:05:00.71,*Default,NTP,0000,0000,0000,,Қыз қарапайым отбасында дүниеге келген.
Dialogue: 0,0:05:01.40,0:05:05.16,*Default,NTP,0000,0000,0000,,Күн сайын еш қиындықсыз және ыңғайсыздықсыз
Dialogue: 0,0:05:08.24,0:05:11.18,*Default,NTP,0000,0000,0000,,Бірақ ол кіші мектеп оқушысы болған кезде
Dialogue: 0,0:05:11.54,0:05:14.81,*Default,NTP,0000,0000,0000,,Күтпеген жерден жеткізілді.
Dialogue: 0,0:05:21.31,0:05:22.98,*Default,NTP,0000,0000,0000,,Онда не болды?
Dialogue: 0,0:05:23.28,0:05:24.37,*Default,NTP,0000,0000,0000,,Фото
Dialogue: 0,0:05:24.78,0:05:26.77,*Default,NTP,0000,0000,0000,,Менің әкем бір қылық болған сияқты.
Dialogue: 0,0:05:27.08,0:05:28.73,*Default,NTP,0000,0000,0000,,Әйелмен
Dialogue: 0,0:05:29.17,0:05:30.25,*Default,NTP,0000,0000,0000,,Кейінгі хат
Dialogue: 0,0:05:30.80,0:05:33.60,*Default,NTP,0000,0000,0000,,"Бұл рұқсат етілген бе?"
Dialogue: 0,0:05:34.00,0:05:37.36,*Default,NTP,0000,0000,0000,,Оны жіберген адам әйелге қатысты сияқты.
Dialogue: 0,0:05:38.14,0:05:41.62,*Default,NTP,0000,0000,0000,,Менің әкем қорқынышты, бірақ ол да қорқынышты.
Dialogue: 0,0:05:44.15,0:05:46.91,*Default,NTP,0000,0000,0000,,Мен не істерімді білмеймін
Dialogue: 0,0:05:47.32,0:05:50.30,*Default,NTP,0000,0000,0000,,Мен оны әзірше жасырайын деп шештім.
Dialogue: 0,0:05:51.50,0:05:54.85,*Default,NTP,0000,0000,0000,,Сол күннен бастап көрініс біршама өзгерді.
Dialogue: 0,0:05:55.10,0:05:57.54,*Default,NTP,0000,0000,0000,,Бұл өте жиіркенішті болды...
Dialogue: 0,0:05:58.65,0:05:59.85,*Default,NTP,0000,0000,0000,,Бұл қиын емес пе?
Dialogue: 0,0:06:00.73,0:06:01.99,*Default,NTP,0000,0000,0000,,Иә? ше? Рио
Dialogue: 0,0:06:02.84,0:06:05.10,*Default,NTP,0000,0000,0000,,Жарты жылдай шыдадым.
Dialogue: 0,0:06:06.42,0:06:09.72,*Default,NTP,0000,0000,0000,,Мен бәрі түсінікті болса, оңайырақ болар еді деп ойладым...
Dialogue: 0,0:06:13.88,0:06:16.64,*Default,NTP,0000,0000,0000,,Егер айту қиын болса, өзіңізді мәжбүрлемеңіз.
Dialogue: 0,0:06:17.86,0:06:20.63,*Default,NTP,0000,0000,0000,,Кейбір нәрселерді айту қиынға соғады.
Dialogue: 0,0:06:21.10,0:06:23.52,*Default,NTP,0000,0000,0000,,Менде бәрі жақсы, білгеніңізді қалаймын.
Dialogue: 0,0:06:28.35,0:06:29.96,*Default,NTP,0000,0000,0000,,Ештеңе өзгерген жоқ
Dialogue: 0,0:06:31.26,0:06:32.90,*Default,NTP,0000,0000,0000,,Анам үндемеді ме?
Dialogue: 0,0:06:33.21,0:06:36.89,*Default,NTP,0000,0000,0000,,Ата-анам мен білмей сөйледі ме, білмеймін.
Dialogue: 0,0:06:37.47,0:06:41.60,*Default,NTP,0000,0000,0000,,Әкемнің қызықсыз әзілдері мен анамның тым тәтті пісірілген тағамы.
Dialogue: 0,0:06:42.04,0:06:45.20,*Default,NTP,0000,0000,0000,,Бәрібір ештеңе өзгерген жоқ.
Dialogue: 0,0:06:48.88,0:06:52.82,*Default,NTP,0000,0000,0000,,Сондықтан мен жоғалып көрейін деп ойладым.
Dialogue: 0,0:06:56.20,0:06:59.41,*Default,NTP,0000,0000,0000,,Мен бұл туралы соңғы уақытта көп ойлайтын болдым.
Dialogue: 0,0:07:01.35,0:07:03.76,*Default,NTP,0000,0000,0000,,Мен де солай сезінемін.
Dialogue: 0,0:07:04.32,0:07:07.21,*Default,NTP,0000,0000,0000,,Бұл Magenta-san сияқты маңызды болмауы мүмкін.
Dialogue: 0,0:07:08.11,0:07:09.45,*Default,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:07:10.25,0:07:12.27,*Default,NTP,0000,0000,0000,,Мен кездесіп жүрген бір қыз бар еді.
Dialogue: 0,0:07:12.50,0:07:14.33,*Default,NTP,0000,0000,0000,,Мен оны әкеммен бірге жасадым
Dialogue: 0,0:07:14.75,0:07:15.85,*Default,NTP,0000,0000,0000,,Қорқынышты...
Dialogue: 0,0:07:16.03,0:07:19.25,*Default,NTP,0000,0000,0000,,Бірақ мен ең кешіре алмаған адамым анам болды.
Dialogue: 0,0:07:19.85,0:07:21.22,*Default,NTP,0000,0000,0000,,Олар не айтты?
Dialogue: 0,0:07:21.76,0:07:23.30,*Default,NTP,0000,0000,0000,,Бұл кең таралған
Dialogue: 0,0:07:23.56,0:07:26.44,*Default,NTP,0000,0000,0000,,Сыйлылығың бар деп шу шығарма.
Dialogue: 0,0:07:26.92,0:07:29.48,*Default,NTP,0000,0000,0000,,Мен ойлағанымды ешқашан айтқан емеспін.
Dialogue: 0,0:07:30.17,0:07:35.16,*Default,NTP,0000,0000,0000,,Менің ойымша, бұл сенің сыртқы түрің маған қарағанда маңыздырақ дегенді білдіреді.
Dialogue: 0,0:07:35.93,0:07:40.80,*Default,NTP,0000,0000,0000,,Бірақ ол да менің болашағымды ойлағандықтан шығар.
Dialogue: 0,0:07:41.15,0:07:42.35,*Default,NTP,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:07:42.61,0:07:43.68,*Default,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:07:43.98,0:07:47.01,*Default,NTP,0000,0000,0000,,Мен Накура-сан туралы мүлде ойламаймын.
Dialogue: 0,0:07:47.19,0:07:49.21,*Default,NTP,0000,0000,0000,,Сіз тек өзіңіз туралы ойлайсыз
Dialogue: 0,0:07:50.33,0:07:52.12,*Default,NTP,0000,0000,0000,,Тамақ дайын.
Dialogue: 0,0:07:52.80,0:07:53.80,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:08:02.81,0:08:05.43,*Default,NTP,0000,0000,0000,,Күлгін екеуміз бірге өлсек ше?
Dialogue: 0,0:08:05.90,0:08:08.23,*Default,NTP,0000,0000,0000,,Ұнамаса да түсінеді деп ойлаймын.
Dialogue: 0,0:08:08.73,0:08:11.96,*Default,NTP,0000,0000,0000,,Шын мәнінде не маңызды болды?
Dialogue: 0,0:08:15.54,0:08:17.95,*Default,NTP,0000,0000,0000,,Қазір ойлап қарасам, бұл ақымақтық еді.
Dialogue: 0,0:08:18.12,0:08:20.56,*Default,NTP,0000,0000,0000,,Қыз әлдебір сезіммен сыртқа шықты.
Dialogue: 0,0:08:21.28,0:08:23.92,*Default,NTP,0000,0000,0000,,Себебі мен Накураның сөзінен күшті сезіндім
Dialogue: 0,0:08:24.32,0:08:29.90,*Default,NTP,0000,0000,0000,,Себебі, мен сияқты ойлайтын адамдардың жүзін көргім келді.
Dialogue: 0,0:08:30.72,0:08:32.77,*Default,NTP,0000,0000,0000,,Өтірік болса да
Dialogue: 0,0:08:32.98,0:08:35.28,*Default,NTP,0000,0000,0000,,Менің жоғалтатын ештеңем жоқ
Dialogue: 0,0:08:35.89,0:08:37.44,*Default,NTP,0000,0000,0000,,Бұл болуы керек еді
Dialogue: 0,0:08:42.23,0:08:43.17,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:08:43.76,0:08:44.88,*Default,NTP,0000,0000,0000,,Қып-қызыл мырза?
Dialogue: 0,0:08:45.23,0:08:46.06,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:08:46.36,0:08:48.58,*Default,NTP,0000,0000,0000,,А, сен Накура-сансың ба?
Dialogue: 0,0:08:48.68,0:08:51.53,*Default,NTP,0000,0000,0000,,Жақсы!
Dialogue: 0,0:08:49.21,0:08:51.39,*Default,NTP,0000,0000,0000,,Сенің жүзіңді көргенде солай ойладым
Dialogue: 0,0:08:51.84,0:08:54.81,*Default,NTP,0000,0000,0000,,Бұл адам Накура емес пе?
Dialogue: 0,0:08:55.62,0:08:57.56,*Default,NTP,0000,0000,0000,,Сонда да мен соңынан ердім
Dialogue: 0,0:08:57.84,0:09:01.39,*Default,NTP,0000,0000,0000,,Өйткені мен мұнда қашып кеткенімді кешіре алмаймын деп ойладым.
Dialogue: 0,0:09:14.44,0:09:16.62,*Default,NTP,0000,0000,0000,,Сонымен, бұл шынымен болған кезде де...
Dialogue: 0,0:09:16.85,0:09:17.77,*Default,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:09:18.64,0:09:19.57,*Default,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:09:19.83,0:09:21.00,*Default,NTP,0000,0000,0000,,Айналаңызда бәрі жақсы ма?
Dialogue: 0,0:09:21.45,0:09:23.55,*Default,NTP,0000,0000,0000,,Бірде-бір адам қалмады.
Dialogue: 0,0:09:23.92,0:09:27.85,*Default,NTP,0000,0000,0000,,Сонда сен мені алдадың...
Dialogue: 0,0:09:25.92,0:09:28.48,*Default,NTP,0000,0000,0000,,Таңдану, қарсылық және өкініш
Dialogue: 0,0:09:29.05,0:09:31.14,*Default,NTP,0000,0000,0000,,Various thoughts have come and gone, but
Dialogue: 0,0:09:31.49,0:09:33.98,*Default,NTP,0000,0000,0000,,Есімнен танып қалар алдында осылай ойладым.
Dialogue: 0,0:09:34.84,0:09:36.40,*Default,NTP,0000,0000,0000,,Бұл тағдыр
Dialogue: 0,0:09:36.84,0:09:40.62,*Default,NTP,0000,0000,0000,,Осы кезеңде өзіңізге күтім жасаудың қажеттілігі қандай?
Dialogue: 0,0:09:41.20,0:09:43.68,*Default,NTP,0000,0000,0000,,Дүниеден кенет жоғалып кету
Dialogue: 0,0:09:44.15,0:09:46.33,*Default,NTP,0000,0000,0000,,Қалай болса да, ешкім білмейді
Dialogue: 0,0:09:47.64,0:09:48.72,*Default,NTP,0000,0000,0000,,Бірақ...
Dialogue: 0,0:10:01.88,0:10:04.05,*Default,NTP,0000,0000,0000,,Мұнда бір ғана адам бар.
Dialogue: 0,0:10:08.50,0:10:11.20,*Default,NTP,0000,0000,0000,,Қыз ес-түссіз жатқанда
Dialogue: 0,0:10:11.38,0:10:12.67,*Default,NTP,0000,0000,0000,,Дүние қозғалады
Dialogue: 0,0:10:13.89,0:10:17.35,*Default,NTP,0000,0000,0000,,Бұл соншалықты қиын жұмыс емес сияқты.
Dialogue: 0,0:10:18.20,0:10:19.44,*Default,NTP,0000,0000,0000,,Сақ болыңыз.
Dialogue: 0,0:10:24.58,0:10:27.95,*Default,NTP,0000,0000,0000,,Оның ойына немесе еркіне қарамастан
Dialogue: 0,0:10:55.40,0:10:58.95,*Default,NTP,0000,0000,0000,,Бұл жақсы емес... Мен ақша жинай алмаймын...
Dialogue: 0,0:10:59.56,0:11:01.44,*Default,NTP,0000,0000,0000,,Мен оны қайтармаймын деп айтпаймын.
Dialogue: 0,0:11:01.63,0:11:03.54,*Default,NTP,0000,0000,0000,,Бірақ маған бірдеңе болса
Dialogue: 0,0:11:03.70,0:11:07.20,*Default,NTP,0000,0000,0000,,Авакусу-кайдағы Йоцуки мырза бұл туралы үндемей ме деп ойлаймын.
Dialogue: 0,0:11:07.24,0:11:08.05,*Default,NTP,0000,0000,0000,,Қария
Dialogue: 0,0:11:08.13,0:11:09.50,*Default,NTP,0000,0000,0000,,Менің уақытым жоқ
Dialogue: 0,0:11:09.58,0:11:10.89,*Default,NTP,0000,0000,0000,,Мен бос емес сияқтымын.
Dialogue: 0,0:11:11.04,0:11:13.25,*Default,NTP,0000,0000,0000,,Өмірімде саған арнаған уақытым
Dialogue: 0,0:11:13.47,0:11:15.51,*Default,NTP,0000,0000,0000,,Бізде екі жарым минуттай ғана уақыт қалды!!
Dialogue: 0,0:11:18.28,0:11:19.52,*Default,NTP,0000,0000,0000,,Басқа адам...
Dialogue: 0,0:11:33.77,0:11:36.87,*Default,NTP,0000,0000,0000,,Сіз сияқты тамаша курьер үшін.
Dialogue: 0,0:11:37.11,0:11:39.25,*Default,NTP,0000,0000,0000,,Бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:11:40.10,0:11:42.03,*Default,NTP,0000,0000,0000,,Мен сұрағаннан артық істеудің қажеті жоқ.
Dialogue: 0,0:11:42.31,0:11:45.56,*Default,NTP,0000,0000,0000,,Ол жақтағы жігіттер өз қалауынша қарауы керек.
Dialogue: 0,0:11:46.03,0:11:47.47,*Default,NTP,0000,0000,0000,,Олай болса, танысқаныма қуаныштымын.
Dialogue: 0,0:11:49.26,0:11:50.68,*Default,NTP,0000,0000,0000,,Дүние қозғалады
Dialogue: 0,0:11:51.40,0:11:53.89,*Default,NTP,0000,0000,0000,,Қыздың сенгені – тағдыр
Dialogue: 0,0:11:54.05,0:11:56.09,*Default,NTP,0000,0000,0000,,Бағытты аздап өзгерту кезінде
Dialogue: 0,0:12:18.88,0:12:21.82,*Default,NTP,0000,0000,0000,,Не... бұл не?!
Dialogue: 0,0:13:00.86,0:13:06.62,*Default,NTP,0000,0000,0000,,Онда: ''Мен сені белгілі бір жерге жеткізуді сұрадым'' деп жазылған.
Dialogue: 0,0:13:07.44,0:13:09.38,*Default,NTP,0000,0000,0000,,Велосипед үнсіз жүгіреді
Dialogue: 0,0:13:09.57,0:13:11.85,*Default,NTP,0000,0000,0000,,Кейде жылқыдай иіскейтін.
Dialogue: 0,0:13:12.58,0:13:15.43,*Default,NTP,0000,0000,0000,,Бұл шынайы емес сияқты болды.
Dialogue: 0,0:13:16.28,0:13:18.83,*Default,NTP,0000,0000,0000,,Бірақ бұл дененің сезімі
Dialogue: 0,0:13:19.04,0:13:20.94,*Default,NTP,0000,0000,0000,,Бұл сөзсіз шындық еді.
Dialogue: 0,0:13:21.88,0:13:25.29,*Default,NTP,0000,0000,0000,,Қыз жылылықтың арғы жағында не жатыр деп ойлады.
Dialogue: 0,0:13:25.76,0:13:27.96,*Default,NTP,0000,0000,0000,,Нені ойлап, нені білу керек
Dialogue: 0,0:13:28.13,0:13:29.93,*Default,NTP,0000,0000,0000,,Сіз өз өміріңізді қалай өткіздіңіз?
Dialogue: 0,0:13:30.62,0:13:34.23,*Default,NTP,0000,0000,0000,,Мен бұл адамға қалай көрінемін?
Dialogue: 0,0:13:40.46,0:13:41.70,*Default,NTP,0000,0000,0000,,Түсінікті
Dialogue: 0,0:14:33.09,0:14:34.26,*Default,NTP,0000,0000,0000,,Қып-қызыл мырза!
Dialogue: 0,0:14:39.83,0:14:42.58,*Default,NTP,0000,0000,0000,,Танысқаныма қуаныштымын, мен Накурамын.
Dialogue: 0,0:14:43.02,0:14:44.89,*Default,NTP,0000,0000,0000,,Накура-сан шынымен бе?
Dialogue: 0,0:14:45.15,0:14:47.69,*Default,NTP,0000,0000,0000,,Бұл мүлдем жоғалып кеткісі келетін Накура.
Dialogue: 0,0:14:49.61,0:14:50.81,*Default,NTP,0000,0000,0000,,Танысқаныма қуаныштымын
Dialogue: 0,0:14:51.12,0:14:54.67,*Default,NTP,0000,0000,0000,,Саған көмектескен Нагура-сан болды ма?
Dialogue: 0,0:14:55.19,0:14:56.74,*Default,NTP,0000,0000,0000,,Иә, бұл менмін.
Dialogue: 0,0:14:57.47,0:14:58.95,*Default,NTP,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:14:59.55,0:15:00.88,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:01.78,0:15:02.69,*Default,NTP,0000,0000,0000,,Иә...
Dialogue: 0,0:15:02.98,0:15:04.16,*Default,NTP,0000,0000,0000,,Бұл қиын болды.
Dialogue: 0,0:15:06.28,0:15:08.32,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:08.68,0:15:13.28,*Default,NTP,0000,0000,0000,,Өйткені мен оларға Қызыл қызды ұрлап кетіңдер деп айтқан адам едім.
Dialogue: 0,0:15:14.93,0:15:18.00,*Default,NTP,0000,0000,0000,,Маған көмектесу үшін жолыңнан шығып кет деген мен едім.
Dialogue: 0,0:15:19.30,0:15:20.59,*Default,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:15:20.95,0:15:23.89,*Default,NTP,0000,0000,0000,,Мен өлемін деп ойладым, бірақ мені ұрлап кетті.
Dialogue: 0,0:15:24.08,0:15:26.53,*Default,NTP,0000,0000,0000,,Мен бұл жерде не нәрседен қорқып кеттім деп ойладым.
Dialogue: 0,0:15:26.58,0:15:28.91,*Default,NTP,0000,0000,0000,,Мен аздап өкінемін.
Dialogue: 0,0:15:29.19,0:15:30.31,*Default,NTP,0000,0000,0000,,Бірақ егер сіз қарсылық көрсетсеңіз
Dialogue: 0,0:15:30.39,0:15:32.64,*Default,NTP,0000,0000,0000,,Өйткені сіз өлетін адамнан бас тартасыз.
Dialogue: 0,0:15:32.78,0:15:36.70,*Default,NTP,0000,0000,0000,,Мен бұл менің тағдырым деп ойладым және оны жай ғана қабылдаймын деп ойладым.
Dialogue: 0,0:15:36.89,0:15:40.06,*Default,NTP,0000,0000,0000,,Бірақ маған көмектесетін болса, мен жеңілдеп қалар едім.
Dialogue: 0,0:15:41.08,0:15:44.02,*Default,NTP,0000,0000,0000,,Себебі мен сенің жүзіңді осылай көргім келді
Dialogue: 0,0:15:45.41,0:15:48.33,*Default,NTP,0000,0000,0000,,Бір сөзбен айтқанда, барлығы көзге түсті.
Dialogue: 0,0:15:48.45,0:15:50.96,*Default,NTP,0000,0000,0000,,Себебі мен сенің тілсіз жүзіңді көргім келді
Dialogue: 0,0:15:53.27,0:15:54.40,*Default,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:15:54.52,0:15:55.55,*Default,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:15:55.72,0:15:56.82,*Default,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:15:57.01,0:16:01.78,*Default,NTP,0000,0000,0000,,Менің ойымша, бұл сұрақтың жауабы сізге өте философиялық болып көрінеді.
Dialogue: 0,0:16:02.07,0:16:03.81,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:16:04.19,0:16:06.27,*Default,NTP,0000,0000,0000,,Менің ойымша, бұл маған адамдарды ұнататынын білдіреді.
Dialogue: 0,0:16:06.60,0:16:08.30,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:16:08.42,0:16:10.74,*Default,NTP,0000,0000,0000,,Маған қызық көрінбесе амалым жоқ.
Dialogue: 0,0:16:11.88,0:16:16.79,*Default,NTP,0000,0000,0000,,А, мен сені емес, адамдарды жақсы көремін, сондықтан бұл маңызды.
Dialogue: 0,0:16:20.22,0:16:21.99,*Default,NTP,0000,0000,0000,,Мұның бәрі өтірік болды ма?
Dialogue: 0,0:16:22.56,0:16:25.09,*Default,NTP,0000,0000,0000,,Сіз өз ұстанымыңызды түсіндіңіз бе?
Dialogue: 0,0:16:25.71,0:16:26.55,*Default,NTP,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:16:34.01,0:16:37.64,*Default,NTP,0000,0000,0000,,Мұнда бірнеше адам секіреді.
Dialogue: 0,0:16:38.05,0:16:40.09,*Default,NTP,0000,0000,0000,,Әйгілі жер деп айтпас едім.
Dialogue: 0,0:16:40.38,0:16:43.19,*Default,NTP,0000,0000,0000,,Бұл жерден міндетті түрде өлуге болады дейді.
Dialogue: 0,0:16:43.39,0:16:45.67,*Default,NTP,0000,0000,0000,,Қараңдар, мына даққа қараңдаршы.
Dialogue: 0,0:16:53.63,0:16:56.76,*Default,NTP,0000,0000,0000,,Жалғыз өзіңді ерекшемін деп ойламайсың ба?
Dialogue: 0,0:16:57.14,0:16:58.48,*Default,NTP,0000,0000,0000,,Бұлай емес.
Dialogue: 0,0:16:58.71,0:16:59.97,*Default,NTP,0000,0000,0000,,Өйткені біз бәріміз бірдейміз
Dialogue: 0,0:17:00.74,0:17:02.58,*Default,NTP,0000,0000,0000,,Кім таза және жазықсыз өмір сүре алады?
Dialogue: 0,0:17:03.04,0:17:07.64,*Default,NTP,0000,0000,0000,,Ол еш жерде жоқ.
Dialogue: 0,0:17:08.10,0:17:12.00,*Default,NTP,0000,0000,0000,,Сізде бір-екі құпия бар шығар, солай ма?
Dialogue: 0,0:17:12.33,0:17:16.82,*Default,NTP,0000,0000,0000,,Сен жақсысың ба, ал ата-анаң жаман ба деп ойладың ба?
Dialogue: 0,0:17:18.21,0:17:19.33,*Default,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,0:17:19.90,0:17:21.80,*Default,NTP,0000,0000,0000,,Сөзімді қорытындылаймын
Dialogue: 0,0:17:22.04,0:17:24.21,*Default,NTP,0000,0000,0000,,Егер сіз алдасаңыз немесе бұл туралы білсеңіз де
Dialogue: 0,0:17:24.65,0:17:26.79,*Default,NTP,0000,0000,0000,,Қызық әзілдерге бәрі күледі.
Dialogue: 0,0:17:27.00,0:17:30.34,*Default,NTP,0000,0000,0000,,Сіз тым тәтті қайнатылған тағамды жеу арқылы өмір сүріп жатырмын деп ойлайсыз.
Dialogue: 0,0:17:34.69,0:17:35.70,*Default,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:17:35.74,0:17:37.06,*Default,NTP,0000,0000,0000,,Қандай қиыншылық болса да
Dialogue: 0,0:17:37.14,0:17:39.72,*Default,NTP,0000,0000,0000,,Қазір бәріміз дақпыз, дақ.
Dialogue: 0,0:17:40.01,0:17:44.57,*Default,NTP,0000,0000,0000,,Құдайдың алдында бәрі тең
Dialogue: 0,0:17:46.51,0:17:47.69,*Default,NTP,0000,0000,0000,,Мен сені жіберейін бе?
Dialogue: 0,0:17:54.72,0:17:55.88,*Default,NTP,0000,0000,0000,,Ура
Dialogue: 0,0:17:58.35,0:18:00.14,*Default,NTP,0000,0000,0000,,Міне, бүгінгі күн.
Dialogue: 0,0:18:01.76,0:18:05.52,*Default,NTP,0000,0000,0000,,Мен сенің көңіл-күйіңді байқағаныма қуаныштымын.
Dialogue: 0,0:18:05.98,0:18:09.43,*Default,NTP,0000,0000,0000,,Мені шынымен қызықтыратын нәрсе сенің қиындықтарың емес.
Dialogue: 0,0:18:09.56,0:18:11.70,*Default,NTP,0000,0000,0000,,Себебі сізді алаңдататын сіздің биологияңыз.
Dialogue: 0,0:18:11.96,0:18:15.95,*Default,NTP,0000,0000,0000,,Айтпақшы, сіздің өміріңіз жоспарланғандай және қызықсыз болды.
Dialogue: 0,0:18:16.30,0:18:19.09,*Default,NTP,0000,0000,0000,,Мен өлгім келмейтінімді әу бастан білдім.
Dialogue: 0,0:18:19.50,0:18:20.45,*Default,NTP,0000,0000,0000,,Олай болса!
Dialogue: 0,0:18:20.60,0:18:23.16,*Default,NTP,0000,0000,0000,,Көңілді болды, қызыл қызыл.
Dialogue: 0,0:18:37.42,0:18:39.46,*Default,NTP,0000,0000,0000,,Мен біраз абдырап қалдым.
Dialogue: 0,0:18:40.72,0:18:44.81,*Default,NTP,0000,0000,0000,,Мен оны осылай ренжіте аламын ба?
Dialogue: 0,0:18:45.71,0:18:46.90,*Default,NTP,0000,0000,0000,,Бірақ мен ойладым
Dialogue: 0,0:18:47.56,0:18:50.58,*Default,NTP,0000,0000,0000,,Мүмкін мен жай ғана мүмкіндік күтіп тұрған шығармын.
Dialogue: 0,0:18:51.15,0:18:55.08,*Default,NTP,0000,0000,0000,,Ол кісінің сөзі болса да
Dialogue: 0,0:18:58.63,0:19:01.86,*Default,NTP,0000,0000,0000,,Бірақ қыздың хабарынсыз...
Dialogue: 0,0:19:33.14,0:19:34.04,*Default,NTP,0000,0000,0000,,Ум...
Dialogue: 0,0:19:37.28,0:19:38.36,*Default,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:19:54.74,0:19:57.25,*Default,NTP,0000,0000,0000,,…
Dialogue: 0,0:20:02.17,0:20:05.46,*Default,NTP,0000,0000,0000,,Қыз әкесі мен анасы туралы ойлады.
Dialogue: 0,0:20:06.32,0:20:08.04,*Default,NTP,0000,0000,0000,,Әке мен әкенің үй иесі
Dialogue: 0,0:20:08.36,0:20:09.48,*Default,NTP,0000,0000,0000,,Әке мен ана
Dialogue: 0,0:20:10.05,0:20:12.81,*Default,NTP,0000,0000,0000,,Әрқайсымыз өзіміз білмейтін уақытты ойладық.
Dialogue: 0,0:20:13.41,0:20:16.13,*Default,NTP,0000,0000,0000,,Мен солай ойладым
Dialogue: 0,0:20:16.30,0:20:20.46,*Default,NTP,0000,0000,0000,,Ол зұлымдықпен, есеппен немесе өшпенділікпен боялмаған болуы мүмкін.
Dialogue: 0,0:20:21.32,0:20:25.40,*Default,NTP,0000,0000,0000,,Бұл ымыраға келу немесе әлсіздік арқылы жасырынбаған болуы мүмкін.
Dialogue: 0,0:20:26.32,0:20:27.80,*Default,NTP,0000,0000,0000,,Үйге барар жолды іздеу кезінде
Dialogue: 0,0:20:28.15,0:20:31.58,*Default,NTP,0000,0000,0000,,Қыз оларды кешіргісі келді.
Dialogue: 0,0:20:34.38,0:20:37.18,*Default,NTP,0000,0000,0000,,Сол күннен бастап дүние өзгерген сияқты.
Dialogue: 0,0:20:37.94,0:20:39.58,*Default,NTP,0000,0000,0000,,Қанша адам болса, сонша ой
Dialogue: 0,0:20:39.88,0:20:41.63,*Default,NTP,0000,0000,0000,,Қанша адам болса, сонша құпия
Dialogue: 0,0:20:42.06,0:20:45.19,*Default,NTP,0000,0000,0000,,Мен мұны қалыпты жағдай деп сезінемін.
Dialogue: 0,0:20:45.70,0:20:46.83,*Default,NTP,0000,0000,0000,,Біз қайда барамыз?
Dialogue: 0,0:20:47.11,0:20:49.23,*Default,NTP,0000,0000,0000,,Мен саған кез келген жерді көрсетемін, сондықтан бүгін өзіңді емде.
Dialogue: 0,0:20:49.42,0:20:52.20,*Default,NTP,0000,0000,0000,,Дұрыс, сонда кітап дүкені ме?
Dialogue: 0,0:20:52.50,0:20:55.44,*Default,NTP,0000,0000,0000,,Кітап дүкені болса, көп нәрсе болар еді...
Dialogue: 0,0:20:55.44,0:20:57.70,*Default,NTP,0000,0000,0000,,Олар барлық жерде бар сияқты
Dialogue: 0,0:20:58.00,0:20:59.52,*Default,NTP,0000,0000,0000,,Бір құпия болуы керек
Dialogue: 0,0:21:00.40,0:21:02.71,*Default,NTP,0000,0000,0000,,Ешкімге айта алмайтын сезімдерім бар.
Dialogue: 0,0:21:03.77,0:21:04.97,*Default,NTP,0000,0000,0000,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:21:05.50,0:21:08.45,*Default,NTP,0000,0000,0000,,Ягири-кун, шындығы қандай...
Dialogue: 0,0:21:08.49,0:21:09.53,*Default,NTP,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:21:09.60,0:21:13.12,*Default,NTP,0000,0000,0000,,Сонымен...бірақ ол бірінші күні болмаған...
Dialogue: 0,0:21:13.38,0:21:14.84,*Default,NTP,0000,0000,0000,,Егер сіз білмесеңіз!
Dialogue: 0,0:21:14.95,0:21:15.84,*Default,NTP,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:21:15.90,0:21:16.92,*Default,NTP,0000,0000,0000,,Мм...
Dialogue: 0,0:21:17.34,0:21:18.41,*Default,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:21:23.51,0:21:24.54,*Default,NTP,0000,0000,0000,,Чип! Чип, чип, чип, чип!
Dialogue: 0,0:21:25.99,0:21:27.29,*Default,NTP,0000,0000,0000,,Мен де күнәһар адаммын
Dialogue: 0,0:21:28.20,0:21:30.75,*Default,NTP,0000,0000,0000,,Әлгі көзілдірік киген жігіт, сен маған ғашық болып қалдың ба?
Dialogue: 0,0:21:30.87,0:21:35.86,*Default,NTP,0000,0000,0000,,Ол басталатын қауіпті және қауіпті Тәуекелді күндерге алаңдағандай болды.
Dialogue: 0,0:21:36.00,0:21:37.97,*Default,NTP,0000,0000,0000,,Кешіріңіз, сіз жапон тілінде сөйлей аласыз ба?
Dialogue: 0,0:21:38.57,0:21:39.73,*Default,NTP,0000,0000,0000,,Ол да
Dialogue: 0,0:21:40.10,0:21:41.53,*Default,NTP,0000,0000,0000,,Оған да
Dialogue: 0,0:21:42.03,0:21:44.66,*Default,NTP,0000,0000,0000,,Сіз көрген нәрсе міндетті түрде шындық емес
Dialogue: 0,0:21:45.40,0:21:46.65,*Default,NTP,0000,0000,0000,,Қыз ойланады
Dialogue: 0,0:21:46.97,0:21:50.64,*Default,NTP,0000,0000,0000,,Бір күні біреуге айта аламын ба?
Dialogue: 0,0:21:51.41,0:21:56.67,*Default,NTP,0000,0000,0000,,Дүние сен ойлағандай жаман емес.
Dialogue: 0,0:22:00.73,0:22:05.90,*Default,NTP,0000,0000,0000,,Әділдіктің одақтасы болғаныңды естімеппін.
Dialogue: 0,0:22:08.16,0:22:12.52,*Default,NTP,0000,0000,0000,,Мен бұл жұмысты тамаша курьерден сұрауым керек еді.
Dialogue: 0,0:22:16.66,0:22:17.81,*Default,NTP,0000,0000,0000,,Жоқ!
Dialogue: 0,0:22:17.94,0:22:21.95,*Default,NTP,0000,0000,0000,,Ақпарат беруші Изая Орихара соншалықты жаман деп ойламаймын.
Dialogue: 0,0:22:23.83,0:22:28.41,*Default,NTP,0000,0000,0000,,Менің ойымша, ол өлгісі келетін адамды тоқтатуға жарамайды.
Dialogue: 0,0:22:32.65,0:22:35.90,*Default,NTP,0000,0000,0000,,Көңілді болды, тамаша курьер.
Dialogue: 0,0:24:15.62,0:24:20.07,*Default,NTP,0000,0000,0000,,Икебукуро... Ол, ол, мен, сен де бірдеңе іздеп жүрсің.
Dialogue: 0,0:24:20.24,0:24:24.08,*Default,NTP,0000,0000,0000,,Олар бұл қалаға бірдеңе іздеп, бір нәрсені өзгерту үшін келеді.
Dialogue: 0,0:24:26.31,0:24:27.62,*Default,NTP,0000,0000,0000,,Сіз суши жейсіз бе? Жақсы
Dialogue: 0,0:24:27.69,0:24:29.29,*Default,NTP,0000,0000,0000,,Ониисан Хисаши~Бури!
Dialogue: 0,0:24:14.95,0:24:19.57,staff,NTP,0000,0000,0000,,Өндіріс: LASTZZZ Демалыс бұлт акира Акира
Dialogue: 0,0:24:19.73,0:24:24.72,staff,NTP,0000,0000,0000,,Manyu субтитрлер жұбы http://popgo.net/bbs/
