Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:07.67,0:01:10.71,Dialogue,,0,0,0,,Бұл мен үшін өте маңызды нәрсе.
Dialogue: 0,0:01:07.75,0:01:10.86,*Default-ja,NTP,0,0,0,,Мен үшін бұл менің өмірімдегі өте маңызды нәрсе.
Dialogue: 0,0:01:10.71,0:01:14.26,Dialogue,,0,0,0,,Жақында өз бетімді де есіме түсірмеймін!
Dialogue: 0,0:01:10.99,0:01:14.42,*Default-ja,NTP,0,0,0,,Мен өз бетімді ұмытып кететін сияқтымын!
Dialogue: 0,0:01:14.67,0:01:15.33,*Default-ja,NTP,0,0,0,,Ум...
Dialogue: 0,0:01:14.76,0:01:15.21,Dialogue,,0,0,0,,Умм...
Dialogue: 0,0:01:15.21,0:01:16.54,Dialogue,,0,0,0,,Жоқ! Жоқ!
Dialogue: 0,0:01:15.39,0:01:16.95,*Default-ja,NTP,0,0,0,,Жоқ! Жоқ!
Dialogue: 0,0:01:16.54,0:01:17.29,Dialogue,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:01:17.29,0:01:19.14,Dialogue,,0,0,0,,Yagiri Pharmaceuticals, иә?
Dialogue: 0,0:01:17.55,0:01:19.15,*Default-ja,NTP,0,0,0,,«Ягири фармацевтика»...
Dialogue: 0,0:01:19.14,0:01:22.93,Dialogue,,0,0,0,,Бұл жерде шынымен де адам эксперименттері жүргізіліп жатыр ма?
Dialogue: 0,0:01:19.54,0:01:23.03,*Default-ja,NTP,0,0,0,,Бұл шынымен де осында ма? Сіз адамдарға эксперимент жасайсыз ба?
Dialogue: 0,0:01:22.96,0:01:24.60,Dialogue,,0,0,0,,Бұл Харима Мика емес...
Dialogue: 0,0:01:23.30,0:01:24.75,*Default-ja,NTP,0,0,0,,Мика Харима емес...
Dialogue: 0,0:01:24.60,0:01:28.39,Dialogue,,0,0,0,,Сіз қанша ақшаны қаласаңыз, сонша пайдалана аласыз.
Dialogue: 0,0:01:24.87,0:01:28.35,*Default-ja,NTP,0,0,0,,Қалағаныңызша ақша жұмсай аласыз.
Dialogue: 0,0:01:28.39,0:01:30.06,Dialogue,,0,0,0,,Біз мәңгі бірге боламыз.
Dialogue: 0,0:01:28.57,0:01:30.29,*Default-ja,NTP,0,0,0,,Біз қазір қандай боламыз, ол мәңгілік
Dialogue: 0,0:01:30.43,0:01:32.61,Dialogue,,0,0,0,,Мен сені сүйемін, Селти.
Dialogue: 0,0:01:30.69,0:01:32.68,*Default-ja,NTP,0,0,0,,Мен сені сүйемін Селти
Dialogue: 0,0:02:08.84,0:02:11.47,Thought,,0,0,0,,Олардың барлығы жалған.
Dialogue: 0,0:02:09.15,0:02:11.24,*Default-ja,NTP,0,0,0,,Барлығы жалған
Dialogue: 0,0:02:11.47,0:02:14.10,Thought,,0,0,0,,Дүние соларға толы.
Dialogue: 0,0:02:11.89,0:02:13.54,*Default-ja,NTP,0,0,0,,Дүние толы
Dialogue: 0,0:02:14.10,0:02:18.95,Thought,,0,0,0,,Олар «мен сені жақсы көремін» және «сен маған ұнайсың» деген сияқты сөздерді басқаларды байлау үшін айтады.
Dialogue: 0,0:02:14.43,0:02:16.70,*Default-ja,NTP,0,0,0,,Мені жақсы көретініңді немесе ұнататыныңды айт
Dialogue: 0,0:02:16.98,0:02:18.50,*Default-ja,NTP,0,0,0,,Тек байланыстырыңыз
Dialogue: 0,0:02:18.95,0:02:21.48,Thought,,0,0,0,,«Осы жаққа қара» және «Менің қасымда бол».
Dialogue: 0,0:02:19.16,0:02:21.60,*Default-ja,NTP,0,0,0,,Маған бұрылып, қасымда бол
Dialogue: 0,0:02:21.48,0:02:24.24,Thought,,0,0,0,,Олар жай ғана адамдарды аңсайды.
Dialogue: 0,0:02:21.86,0:02:24.53,*Default-ja,NTP,0,0,0,,Сұра, еркелет
Dialogue: 0,0:02:25.52,0:02:27.29,Thought,,0,0,0,,Менің махаббатым бөлек.
Dialogue: 0,0:02:25.67,0:02:27.37,*Default-ja,NTP,0,0,0,,Менің махаббатым бөлек
Dialogue: 0,0:02:30.71,0:02:34.71,Thought,,0,0,0,,Бұл кеңірек, толық нәрсе.
Dialogue: 0,0:02:31.29,0:02:34.84,*Default-ja,NTP,0,0,0,,Кеңірек және толық
Dialogue: 0,0:02:42.71,0:02:44.73,Dialogue,,0,0,0,,Мен білемін, әпке.
Dialogue: 0,0:02:42.91,0:02:44.08,*Default-ja,NTP,0,0,0,,Түсіндім, апа.
Dialogue: 0,0:02:44.73,0:02:47.51,Dialogue,,0,0,0,,Ақша аударымы үшін рахмет. Кездескенше.
Dialogue: 0,0:02:44.96,0:02:46.02,*Default-ja,NTP,0,0,0,,Тасымалдау Рахмет
Dialogue: 0,0:02:46.27,0:02:47.15,*Default-ja,NTP,0,0,0,,Сонда кездескенше
Dialogue: 0,0:02:49.46,0:02:52.53,Dialogue,,0,0,0,,Саған ішетін бірдеңе алып бергенімді қалайсың ба?
Dialogue: 0,0:02:49.94,0:02:52.19,*Default-ja,NTP,0,0,0,,Саған ішетін бірдеңе сатып алайын ба?
Dialogue: 0,0:02:53.44,0:02:57.55,Dialogue,,0,0,0,,Қараңызшы, дәл сол жақтағы автоматтан.
Dialogue: 0,0:02:53.81,0:02:56.78,*Default-ja,NTP,0,0,0,,Қараңызшы, сіз дәл сол жерде сауда автоматын көре аласыз.
Dialogue: 0,0:03:01.86,0:03:03.78,Dialogue,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:03:02.21,0:03:03.21,*Default-ja,NTP,0,0,0,,Каранэс ауданына оралу.
Dialogue: 0,0:03:31.10,0:03:32.58,Dialogue,,0,0,0,,Мен сені таңдадым, себебі маған асталы дүниеде ауыр қару-жарақ қажет болады.
Dialogue: 0,0:03:34.09,0:03:36.12,Dialogue,,0,0,0,,Сен сондай сүйкімдісің.
Dialogue: 0,0:03:34.51,0:03:35.78,*Default-ja,NTP,0,0,0,,Ол сүйкімді адам.
Dialogue: 0,0:03:41.45,0:03:43.45,Dialogue,,0,0,0,,Олар әлі табылған жоқ па?!
Dialogue: 0,0:03:41.90,0:03:43.53,*Default-ja,NTP,0,0,0,,Сіз оны әлі тапмадыңыз ба?
Dialogue: 0,0:03:43.45,0:03:46.46,Dialogue,,0,0,0,,Мен өте кешірім сұраймын...
Dialogue: 0,0:03:43.78,0:03:46.06,*Default-ja,NTP,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:03:46.46,0:03:49.15,Dialogue,,0,0,0,,Дүниеде қауіпсіздікті не істеп жүр еді?!
Dialogue: 0,0:03:46.76,0:03:48.93,*Default-ja,NTP,0,0,0,,Жетекші немен айналысты?
Dialogue: 0,0:03:49.15,0:03:51.48,Dialogue,,0,0,0,,Жауапты адамның айтуы бойынша,
Dialogue: 0,0:03:49.50,0:03:51.24,*Default-ja,NTP,0,0,0,,Кеше түнде жауапты адам айтты
Dialogue: 0,0:03:51.48,0:03:57.71,Dialogue,,0,0,0,,олар бір қонақүйде тұрды, бірақ түн ортасында Сейджи кенеттен орнын ауыстырды...
Dialogue: 0,0:03:51.55,0:03:53.97,*Default-ja,NTP,0,0,0,,Жақында біз бір қонақүйде болдық.
Dialogue: 0,0:03:54.44,0:03:57.71,*Default-ja,NTP,0,0,0,,Сейджи түн ортасында кенеттен орнын ауыстырған сияқты...
Dialogue: 0,0:03:57.71,0:04:01.32,Dialogue,,0,0,0,,Мен әлі де оның ұялы телефоны арқылы сағат жетіде хабарласа алатынмын.
Dialogue: 0,0:03:57.98,0:04:00.71,*Default-ja,NTP,0,0,0,,Сіздің ұялы телефоныңыз әлі сағат 7-де жұмыс істеп тұрды, солай ма?
Dialogue: 0,0:04:01.32,0:04:03.13,Dialogue,,0,0,0,,Егер оған бірдеңе болса...
Dialogue: 0,0:04:01.72,0:04:03.13,*Default-ja,NTP,0,0,0,,Егер бірдеңе болса...
Dialogue: 0,0:04:04.64,0:04:10.81,Dialogue,,0,0,0,,Ол Икебукуродан кетпеймін деп уәде берді, сондықтан оны жақын арада табамыз деп ойлаймын.
Dialogue: 0,0:04:05.17,0:04:08.49,*Default-ja,NTP,0,0,0,,Сіз Икебукурадан кетпеуге уәде бердіңіз.
Dialogue: 0,0:04:08.81,0:04:10.43,*Default-ja,NTP,0,0,0,,Мен оны жақын арада табамын деп үміттенемін
Dialogue: 0,0:04:10.81,0:04:11.60,Dialogue,,0,0,0,,Тыңдау.
Dialogue: 0,0:04:11.14,0:04:14.48,*Default-ja,NTP,0,0,0,,Жарайсың ба? Бұл полицияның назарына түссе ше?
Dialogue: 0,0:04:12.00,0:04:16.23,Dialogue,,0,0,0,,Полицияға бұл жел тисе, біздің жағдайымыз не болады деп ойлайсыз?!
Dialogue: 0,0:04:14.66,0:04:16.50,*Default-ja,NTP,0,0,0,,Бізбен не болады деп ойлайсыңдар?
Dialogue: 0,0:04:16.92,0:04:18.21,Dialogue,,0,0,0,,Бұл...
Dialogue: 0,0:04:17.18,0:04:18.22,*Default-ja,NTP,0,0,0,,Бұл...
Dialogue: 0,0:04:18.88,0:04:21.03,Dialogue,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:04:19.18,0:04:20.29,*Default-ja,NTP,0,0,0,,Жетеді
Dialogue: 0,0:04:21.03,0:04:23.61,Dialogue,,0,0,0,,Балалар мен сендерді күте алмаймын.
Dialogue: 0,0:04:21.35,0:04:23.16,*Default-ja,NTP,0,0,0,,Балалар мен сендерді күте алмаймын.
Dialogue: 0,0:04:23.61,0:04:24.45,Dialogue,,0,0,0,,Директор...!
Dialogue: 0,0:04:23.94,0:04:24.87,*Default-ja,NTP,0,0,0,,Негізгі
Dialogue: 0,0:04:24.45,0:04:26.78,Dialogue,,0,0,0,,Мен жақында ораламын.
Dialogue: 0,0:04:25.05,0:04:26.49,*Default-ja,NTP,0,0,0,,Жақында оралыңыз
Dialogue: 0,0:04:28.65,0:04:33.87,Thought,,0,0,0,,Мен үшін бұл жай қуыршақ болды.
Dialogue: 0,0:04:29.10,0:04:32.98,*Default-ja,NTP,0,0,0,,Мен үшін бұл жай қуыршақ болды.
Dialogue: 0,0:04:33.87,0:04:40.06,Thought,,0,0,0,,Ағам шетелге барғанда маған сатып алатын қымбат, әдемі қуыршақтардың бірі сияқты.
Dialogue: 0,0:04:34.24,0:04:36.69,*Default-ja,NTP,0,0,0,,Баяғыда ағам сатып алатын сияқты.
Dialogue: 0,0:04:36.93,0:04:39.63,*Default-ja,NTP,0,0,0,,Қымбат және әдемі әкелінген қуыршақтар
Dialogue: 0,0:04:40.06,0:04:45.00,Thought,,0,0,0,,Мен жас кезімде қуыршақтарды ұнатпайтынмын.
Dialogue: 0,0:04:40.55,0:04:43.74,*Default-ja,NTP,0,0,0,,Мен кішкентай кезімнен қуыршақтарды ұнатпайтынмын.
Dialogue: 0,0:04:45.00,0:04:53.68,Thought,,0,0,0,,Менің ойымша, ол мені қуантқысы келмеді, бірақ маған ұнаған нәрселерін жібере берді.
Dialogue: 0,0:04:45.34,0:04:48.39,*Default-ja,NTP,0,0,0,,Бәлкім, ағам маған ұнау үшін істемеген шығар.
Dialogue: 0,0:04:48.88,0:04:53.54,*Default-ja,NTP,0,0,0,,Менің ойымша, ол жай ғана өзіне ұнайтын нәрселерді бере берді.
Dialogue: 0,0:04:58.14,0:05:01.28,Dialogue,,0,0,0,,Эй, Сейджи, мынаны қарашы.
Dialogue: 0,0:04:58.71,0:05:00.50,*Default-ja,NTP,0,0,0,,Қарашы, Сейджи, қарашы.
Dialogue: 0,0:05:01.28,0:05:03.53,Dialogue,,0,0,0,,Бұл әдемі, солай емес пе?
Dialogue: 0,0:05:01.72,0:05:02.91,*Default-ja,NTP,0,0,0,,Әдемі емес пе?
Dialogue: 0,0:05:11.74,0:05:14.12,Dialogue,,0,0,0,,Олай болса, бұл жерде не деп ойлайсың?
Dialogue: 0,0:05:12.18,0:05:13.95,*Default-ja,NTP,0,0,0,,Енді бұл не?
Dialogue: 0,0:05:14.12,0:05:14.83,Dialogue,,0,0,0,,Жер
Dialogue: 0,0:05:14.24,0:05:15.12,*Default-ja,NTP,0,0,0,,Не?
Dialogue: 0,0:05:14.83,0:05:19.54,Thought,,0,0,0,,Ол үйде үнемі үнсіздік болды, ал біз әрқашан жалғыз болдық.
Dialogue: 0,0:05:15.17,0:05:17.55,*Default-ja,NTP,0,0,0,,Үйде тыныштық болды.
Dialogue: 0,0:05:17.66,0:05:19.96,*Default-ja,NTP,0,0,0,,Сейджи екеуміз әрқашан жалғызбыз
Dialogue: 0,0:05:20.08,0:05:24.76,Thought,,0,0,0,,Інім дүниеге келмей жатып-ақ ағам жиі қарап тұратын.
Dialogue: 0,0:05:20.44,0:05:25.51,*Default-ja,NTP,0,0,0,,Інім дүниеге келмей тұрып-ақ, мені ағамның үйінде жиі қалдыратын.
Dialogue: 0,0:05:24.76,0:05:27.76,Thought,,0,0,0,,Мен де оның кабинетіне қалаған кезде кіріп-шығатынмын.
Dialogue: 0,0:05:25.62,0:05:28.02,*Default-ja,NTP,0,0,0,,Оқуға да еркін кіріп-шығады.
Dialogue: 0,0:05:31.60,0:05:34.60,Thought,,0,0,0,,Міне...ол сол жерде болды.
Dialogue: 0,0:05:31.82,0:05:34.26,*Default-ja,NTP,0,0,0,,Ол сонда болды
Dialogue: 0,0:05:36.30,0:05:42.69,Thought,,0,0,0,,Ағам кейде шетелден алып келген затына есінен танып қалғандай қарайтын...
Dialogue: 0,0:05:36.63,0:05:39.41,*Default-ja,NTP,0,0,0,,Шетел мемлекетінен контрабандалық жолмен әкелінді деген болжам
Dialogue: 0,0:05:39.89,0:05:42.45,*Default-ja,NTP,0,0,0,,Ағам қызыққандай қарады.
Dialogue: 0,0:05:42.69,0:05:45.86,Thought,,0,0,0,,Кейде ол онымен сөйлесетін.
Dialogue: 0,0:05:42.95,0:05:45.56,*Default-ja,NTP,0,0,0,,Кейде бір-бірімізбен сөйлесетінбіз.
Dialogue: 0,0:05:46.52,0:05:48.99,Thought,,0,0,0,,Бұл, әрине, әдемі болды.
Dialogue: 0,0:05:46.85,0:05:51.71,*Default-ja,NTP,0,0,0,,Бұл ағам сыйлаған қуыршақтардан да әдемі болғаны сөзсіз.
Dialogue: 0,0:05:48.99,0:05:51.56,Thought,,0,0,0,,Оның маған берген кез келген қуыршақтарынан да артық.
Dialogue: 0,0:05:52.01,0:05:59.31,Thought,,0,0,0,,Бұл жұмбақ немесе қатыгез болып көрінбеді; оның басы тұтас бір тіршілік иесі сияқты көрінді.
Dialogue: 0,0:05:52.82,0:05:55.07,*Default-ja,NTP,0,0,0,,Бір қызығы, мен қатыгездікті сезінбеймін.
Dialogue: 0,0:05:55.56,0:05:59.57,*Default-ja,NTP,0,0,0,,Мойынның өзі бір тірі зат сияқты көрінді.
Dialogue: 0,0:06:00.25,0:06:02.54,Thought,,0,0,0,,Бірақ мен үшін бәрі осы болды.
Dialogue: 0,0:06:00.60,0:06:02.67,*Default-ja,NTP,0,0,0,,Бірақ мұның бәрі мен үшін
Dialogue: 0,0:06:04.94,0:06:09.18,Thought,,0,0,0,,Сол себепті мен ағамды кабинетке жасырын шақырғанда...
Dialogue: 0,0:06:05.41,0:06:06.70,*Default-ja,NTP,0,0,0,,Сол күні
Dialogue: 0,0:06:06.77,0:06:09.39,*Default-ja,NTP,0,0,0,,Кім інісін жасырын түрде кабинетіне шақырды?
Dialogue: 0,0:06:09.69,0:06:12.18,Thought,,0,0,0,,Мен жай ғана көңіл көтереміз деп ойладым.
Dialogue: 0,0:06:09.99,0:06:12.33,*Default-ja,NTP,0,0,0,,Бұл жай ғана көңіл көтеру үшін болды.
Dialogue: 0,0:06:12.65,0:06:15.68,Thought,,0,0,0,,Мен онымен сырымды бөліскім келген шығар.
Dialogue: 0,0:06:13.03,0:06:15.82,*Default-ja,NTP,0,0,0,,Мүмкін мен жай ғана сыр бөліскім келген шығар
Dialogue: 0,0:06:16.97,0:06:18.69,Dialogue,,0,0,0,,Бұл әдемі, солай емес пе?
Dialogue: 0,0:06:17.33,0:06:18.66,*Default-ja,NTP,0,0,0,,Әй, әдемі емес пе?
Dialogue: 0,0:06:31.66,0:06:34.33,Thought,,0,0,0,,Бұл бәрінің басы болды...
Dialogue: 0,0:06:31.99,0:06:34.09,*Default-ja,NTP,0,0,0,,Бәрі осылай басталды
Dialogue: 0,0:06:34.33,0:06:39.21,Thought,,0,0,0,,Бүгінгі күнге дейін жалғасып келе жатқан жалғыз өкінішім.
Dialogue: 0,0:06:34.52,0:06:39.10,*Default-ja,NTP,0,0,0,,Менің жалғыз өкінішім... және әлі күнге дейін жалғасып келе жатқан өкінішім
Dialogue: 0,0:06:50.73,0:06:53.23,Dialogue,,0,0,0,,Біз бірінші рет кездесіп тұрмыз, солай емес пе?
Dialogue: 0,0:06:51.01,0:06:53.25,*Default-ja,NTP,0,0,0,,Біз бірінші рет кездесіп тұрмыз, солай ма?
Dialogue: 0,0:06:53.23,0:06:58.31,Dialogue,,0,0,0,,Бұл заңсыз иммигранттар тізімі сізге пайдалы болды ма, Ягири Намие ханым?
Dialogue: 0,0:06:53.48,0:06:57.57,*Default-ja,NTP,0,0,0,,Заңсыз иммигранттар тізімі пайдалы болды ма? Нами Ягири
Dialogue: 0,0:06:59.40,0:07:01.07,Dialogue,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:06:59.74,0:07:07.07,*Default-ja,NTP,0,0,0,,Yagiri Pharmaceuticals компаниясының 6-зерттеу зертханасының директорының осындай шулы жерге келуге дайын болғанына өте қуаныштымын.
Dialogue: 0,0:07:01.07,0:07:06.99,Dialogue,,0,0,0,,Алтыншы ғылыми-зерттеу мекемесінің директорын осындай жерге дейін жеткізу үшін...
Dialogue: 0,0:07:06.99,0:07:10.53,Dialogue,,0,0,0,,Өтінемін, кез келген жерде отырыңыз.
Dialogue: 0,0:07:07.47,0:07:09.87,*Default-ja,NTP,0,0,0,,Өтінемін, оны бір жерге іліп қойыңыз.
Dialogue: 0,0:07:13.82,0:07:16.99,Dialogue,,0,0,0,,Бұл төтенше жағдай. Менің ағамның қайда екенін біліңіз.
Dialogue: 0,0:07:14.31,0:07:17.40,*Default-ja,NTP,0,0,0,,Тез арада ағамды табу керек.
Dialogue: 0,0:07:18.88,0:07:21.70,Dialogue,,0,0,0,,Мен сізге қанша қаласаңыз, сонша төлеймін.
Dialogue: 0,0:07:19.08,0:07:21.12,*Default-ja,NTP,0,0,0,,Біз сізге өтемақының кез келген мөлшерін төлейміз.
Dialogue: 0,0:07:21.70,0:07:24.19,Dialogue,,0,0,0,,Мен онымен кеше түннен бері хабарласа алмадым.
Dialogue: 0,0:07:21.94,0:07:23.98,*Default-ja,NTP,0,0,0,,Кеше түннен бері сізбен байланыса алмадым.
Dialogue: 0,0:07:24.19,0:07:26.07,Dialogue,,0,0,0,,Ол Икебукурода бір жерде болуы керек.
Dialogue: 0,0:07:24.39,0:07:26.23,*Default-ja,NTP,0,0,0,,Икебукураның бір жерінде болуы керек
Dialogue: 0,0:07:26.07,0:07:28.51,Dialogue,,0,0,0,,Сонша уақыт өткен жоқ, солай ма?
Dialogue: 0,0:07:26.31,0:07:28.39,*Default-ja,NTP,0,0,0,,Бұл әлі көп болған жоқ.
Dialogue: 0,0:07:28.51,0:07:30.54,Dialogue,,0,0,0,,Неге сонша уайымдап тұрсың?
Dialogue: 0,0:07:28.69,0:07:30.43,*Default-ja,NTP,0,0,0,,Неге сонша уайымдап тұрсың?
Dialogue: 0,0:07:30.54,0:07:34.76,Dialogue,,0,0,0,,Ол қызбен; мойнында жара бар.
Dialogue: 0,0:07:30.94,0:07:32.63,*Default-ja,NTP,0,0,0,,Әйелмен бірге болу
Dialogue: 0,0:07:32.74,0:07:35.05,*Default-ja,NTP,0,0,0,,Мойынында тыртықтары бар әйел
Dialogue: 0,0:07:34.76,0:07:36.26,Dialogue,,0,0,0,,Қыз ба?
Dialogue: 0,0:07:35.20,0:07:36.23,*Default-ja,NTP,0,0,0,,қуыршақтай киімінен мүлде алшақ еді—
Dialogue: 0,0:07:36.26,0:07:39.02,Dialogue,,0,0,0,,Білесіз бе, ол жаста.
Dialogue: 0,0:07:36.97,0:07:38.63,*Default-ja,NTP,0,0,0,,Міне, сіз қанша жастасыз.
Dialogue: 0,0:07:39.02,0:07:40.23,Dialogue,,0,0,0,,Қазір жүріңіз!
Dialogue: 0,0:07:39.23,0:07:40.56,*Default-ja,NTP,0,0,0,,Қазір қозғалыңыз!
Dialogue: 0,0:07:40.23,0:07:42.66,Dialogue,,0,0,0,,Бір секунд күтіңіз.
Dialogue: 0,0:07:40.79,0:07:47.06,*Default-ja,NTP,0,0,0,,Сәл күте тұрыңыз, басқа да көптеген маңызды нәрселерді қарастыру керек емес пе?
Dialogue: 0,0:07:42.66,0:07:47.56,Dialogue,,0,0,0,,Алдымен зерттеуіміз керек бұдан да маңызды нәрселер бар емес пе?
Dialogue: 0,0:07:47.56,0:07:53.96,Dialogue,,0,0,0,,Сіздің компанияңызды шетелдік Nebula компаниясы басып алмақшы деген қауесеттер бар, солай емес пе?
Dialogue: 0,0:07:47.82,0:07:53.77,*Default-ja,NTP,0,0,0,,Отаку компаниясы Шетелдік Nebula компаниясы үлкен компанияға сіңіп кетуі мүмкін деген қауесет бар, солай емес пе?
Dialogue: 0,0:07:53.96,0:07:55.62,Dialogue,,0,0,0,,Егер бұл рас болса, сіздің ұстанымыңыз—
Dialogue: 0,0:07:54.15,0:07:55.91,*Default-ja,NTP,0,0,0,,Егер бұл орын алса, сіздің позицияңыз да...
Dialogue: 0,0:07:55.62,0:07:59.16,Dialogue,,0,0,0,,Орихара Изая мырза, менің бос әңгімеге уақытым жоқ.
Dialogue: 0,0:07:55.93,0:07:59.44,*Default-ja,NTP,0,0,0,,Орихара Изая-сан, менің сөйлесетін уақытым жоқ.
Dialogue: 0,0:08:00.15,0:08:01.89,Dialogue,,0,0,0,,Қандай күтпеген.
Dialogue: 0,0:08:00.51,0:08:05.52,*Default-ja,NTP,0,0,0,,Сіздей тамаша әйел ағаңызды жақсы көретіні таң қалдырады.
Dialogue: 0,0:08:01.89,0:08:05.14,Dialogue,,0,0,0,,Өзі сияқты қабілетті әйелдің інісіне ғашық болатынын, яғни.
Dialogue: 0,0:08:05.75,0:08:07.71,Dialogue,,0,0,0,,Мен туралы не білесің?
Dialogue: 0,0:08:06.01,0:08:08.00,*Default-ja,NTP,0,0,0,,Мен туралы не білесің?
Dialogue: 0,0:08:07.71,0:08:11.30,Dialogue,,0,0,0,,Мен білетін Ягири Нами өте көрнекті әйел.
Dialogue: 0,0:08:08.20,0:08:11.65,*Default-ja,NTP,0,0,0,,Мен білетін Нами Ягири - керемет әйел.
Dialogue: 0,0:08:11.30,0:08:14.44,Dialogue,,0,0,0,,Айтайын дегенім, бұл отбасылық бизнес болса да,
Dialogue: 0,0:08:11.82,0:08:14.32,*Default-ja,NTP,0,0,0,,Қанша отбасылық компания болса да.
Dialogue: 0,0:08:14.44,0:08:20.89,Dialogue,,0,0,0,,әкең бұзып, оны ағаңа беруге мәжбүр болды, ол саған жақсылық жасамайды.
Dialogue: 0,0:08:14.55,0:08:17.45,*Default-ja,NTP,0,0,0,,Қарияң қателесіп, абыройынан айырылды.
Dialogue: 0,0:08:17.62,0:08:20.82,*Default-ja,NTP,0,0,0,,Қазіргі президенттің ағасы өте жақсы көрінеді.
Dialogue: 0,0:08:20.89,0:08:26.90,Dialogue,,0,0,0,,Сондықтан жұмысқа орналасу үшін сіз өзіңіздің қабілеттеріңізді пайдалануыңыз керек болды, енді сіз өте жас болғаныңызға қарамастан, осы уақытқа дейін келдіңіз.
Dialogue: 0,0:08:21.49,0:08:24.76,*Default-ja,NTP,0,0,0,,Осылайша Нами мырза компанияға өз бетімен қосылды.
Dialogue: 0,0:08:24.84,0:08:27.25,*Default-ja,NTP,0,0,0,,Бұл қызметке жас кезінде келген.
Dialogue: 0,0:08:27.19,0:08:28.90,Dialogue,,0,0,0,,Сіз де өте әдемісіз.
Dialogue: 0,0:08:27.44,0:08:29.28,*Default-ja,NTP,0,0,0,,Ол сондай әдемі
Dialogue: 0,0:08:30.00,0:08:32.45,Dialogue,,0,0,0,,Сіз мені жақсы танисыз.
Dialogue: 0,0:08:30.44,0:08:32.32,*Default-ja,NTP,0,0,0,,Күтілгендей, сіз өте жақсы білесіз.
Dialogue: 0,0:08:32.45,0:08:35.74,Dialogue,,0,0,0,,Олай болса, ағамды іздеу сізге оңай болуы керек.
Dialogue: 0,0:08:32.64,0:08:35.48,*Default-ja,NTP,0,0,0,,Ағаңызды іздеуге ешқандай себеп жоқ.
Dialogue: 0,0:08:35.74,0:08:38.20,Dialogue,,0,0,0,,Сіздің ағаңыз, иә?
Dialogue: 0,0:08:36.24,0:08:38.00,*Default-ja,NTP,0,0,0,,Сәлем, бауырым...
Dialogue: 0,0:08:38.20,0:08:40.98,Dialogue,,0,0,0,,Оның ісіне араласпау керек, білесің.
Dialogue: 0,0:08:38.61,0:08:41.16,*Default-ja,NTP,0,0,0,,Көп араласу жақсы емес.
Dialogue: 0,0:08:40.98,0:08:43.12,Dialogue,,0,0,0,,Мен араласпаймын!
Dialogue: 0,0:08:41.30,0:08:42.96,*Default-ja,NTP,0,0,0,,Бұл кедергі емес.
Dialogue: 0,0:08:43.12,0:08:45.87,Dialogue,,0,0,0,,Мен ғана оны қорғай аламын.
Dialogue: 0,0:08:43.44,0:08:46.07,*Default-ja,NTP,0,0,0,,Ол баланы мен ғана қорғаймын.
Dialogue: 0,0:08:45.87,0:08:50.20,Dialogue,,0,0,0,,Сталкерлер не істеп жатқанын ешқашан түсінбейтін сияқты.
Dialogue: 0,0:08:46.40,0:08:50.05,*Default-ja,NTP,0,0,0,,Сен ғана байқамайтын сияқтысың. Бұл аңдыушы.
Dialogue: 0,0:08:50.20,0:08:52.63,Dialogue,,0,0,0,,Олар әрқашан өздерін қорғайтындарын айтады -
Dialogue: 0,0:08:50.58,0:08:52.72,*Default-ja,NTP,0,0,0,,Ол өзін қорғауға тырысатынын айтты.
Dialogue: 0,0:08:52.63,0:08:55.34,Dialogue,,0,0,0,,Мені ешқандай аңдыушылармен біріктірмеңіз!
Dialogue: 0,0:08:52.90,0:08:55.29,*Default-ja,NTP,0,0,0,,Мені аңдыушымен араластырма!
Dialogue: 0,0:08:55.34,0:08:57.05,Dialogue,,0,0,0,,Сіз қорқыныштысыз.
Dialogue: 0,0:08:55.77,0:08:56.77,*Default-ja,NTP,0,0,0,,Қорқынышты!
Dialogue: 0,0:08:57.05,0:08:58.85,Dialogue,,0,0,0,,Бұл жай ғана әзіл болды.
Dialogue: 0,0:08:57.19,0:08:58.76,*Default-ja,NTP,0,0,0,,Қалжың емес!
Dialogue: 0,0:08:58.85,0:09:00.96,Dialogue,,0,0,0,,Жарайды, мен саған көмектесемін.
Dialogue: 0,0:08:59.38,0:09:01.05,*Default-ja,NTP,0,0,0,,Жарайды, ынтымақтасайық.
Dialogue: 0,0:09:00.96,0:09:03.27,Dialogue,,0,0,0,,Дегенмен, біз бәрін өз жолыммен жасаймыз.
Dialogue: 0,0:09:01.15,0:09:03.28,*Default-ja,NTP,0,0,0,,Бірақ өз жолыммен.
Dialogue: 0,0:09:03.27,0:09:05.85,Dialogue,,0,0,0,,Ақпараттық дилерлердің полициядан айырмашылығы.
Dialogue: 0,0:09:03.32,0:09:05.93,*Default-ja,NTP,0,0,0,,Полиция мен ақпарат берушілер әртүрлі.
Dialogue: 0,0:09:13.88,0:09:16.91,Dialogue,,0,0,0,,Сіз қандай ереже бойынша... ойнайсыз?
Dialogue: 0,0:09:14.31,0:09:16.14,*Default-ja,NTP,0,0,0,,Ережелер қандай?
Dialogue: 0,0:09:16.91,0:09:18.32,Dialogue,,0,0,0,,Менің сұрағым бар.
Dialogue: 0,0:09:17.15,0:09:18.52,*Default-ja,NTP,0,0,0,,Менің бір сұрағым бар.
Dialogue: 0,0:09:18.32,0:09:22.31,Dialogue,,0,0,0,,Мойнында жарасы бар қызды қызғанасыз ба?
Dialogue: 0,0:09:18.82,0:09:22.69,*Default-ja,NTP,0,0,0,,Мойнында тыртығы бар әйелді гриль жасап жатырсың ба?
Dialogue: 0,0:09:22.94,0:09:24.16,Dialogue,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:09:23.24,0:09:24.30,*Default-ja,NTP,0,0,0,,Неліктен?
Dialogue: 0,0:09:28.84,0:09:31.99,Thought,,0,0,0,,Мен оны қызғанатын шығармын!
Dialogue: 0,0:09:29.26,0:09:31.28,*Default-ja,NTP,0,0,0,,Мен ол қызды қызғана алмаймын.
Dialogue: 0,0:09:31.99,0:09:36.56,Thought,,0,0,0,,Адамдарды тот басқан қызылға бояйтын кеудені күйдіретін қызғаныш...
Dialogue: 0,0:09:32.63,0:09:36.35,*Default-ja,NTP,0,0,0,,Жүректі өртеп жіберген қызыл, тот басқан қызғаныш...
Dialogue: 0,0:09:36.56,0:09:40.68,Dialogue,,0,0,0,,Әпке...Менде... ұнайтын адам бар.
Dialogue: 0,0:09:36.89,0:09:40.79,*Default-ja,NTP,0,0,0,,Әпке... Менің өзіме ұнайтын қыз бар.
Dialogue: 0,0:09:42.12,0:09:46.55,Thought,,0,0,0,,Мен Сейджидің біртіндеп бөтен болып бара жатқанын білдім.
Dialogue: 0,0:09:42.44,0:09:46.14,*Default-ja,NTP,0,0,0,,Мен Сейджидің мінез-құлқы күннен-күнге оғаш болып бара жатқанын білдім.
Dialogue: 0,0:09:46.55,0:09:53.18,Thought,,0,0,0,,Ол ағамыздың кабинетіне еш себепсіз кіретін, сосын жасырын кірген сайын әлгі нәрсеге қарап отыратын.
Dialogue: 0,0:09:46.86,0:09:49.04,*Default-ja,NTP,0,0,0,,Мен үнемі ағамның оқуына барғым келеді.
Dialogue: 0,0:09:49.12,0:09:53.06,*Default-ja,NTP,0,0,0,,Мен кабинетке тығылып кіріп, қызыға қарадым.
Dialogue: 0,0:09:53.18,0:09:55.72,Thought,,0,0,0,,Сейджи адамға ғашық болған жоқ.
Dialogue: 0,0:09:53.39,0:09:55.60,*Default-ja,NTP,0,0,0,,Сейджидің сүйгені адам емес еді.
Dialogue: 0,0:09:55.72,0:09:59.20,Thought,,0,0,0,,Оның жаны, тіпті денесі де болған жоқ.
Dialogue: 0,0:09:55.93,0:09:58.68,*Default-ja,NTP,0,0,0,,Ақыл жоқ, дене жоқ...
Dialogue: 0,0:10:04.74,0:10:11.15,Thought,,0,0,0,,Мен Сейджидің ойынан алғым келді, сондықтан мен ағамнан компанияға кірген бойда оны жылжыта аламын ба деп сұрадым.
Dialogue: 0,0:10:05.36,0:10:07.43,*Default-ja,NTP,0,0,0,,Мен оны Сейджидің көзінен алыс ұстағым келді.
Dialogue: 0,0:10:07.81,0:10:11.11,*Default-ja,NTP,0,0,0,,Компанияға кіргеннен кейін ағамнан сұрадым
Dialogue: 0,0:10:11.15,0:10:14.52,Thought,,0,0,0,,және оны зерттеу нысаны ретінде нысанға әкелді.
Dialogue: 0,0:10:11.30,0:10:14.11,*Default-ja,NTP,0,0,0,,Мен оны зерттеу нысаны ретінде қасиетті жерге қойдым.
Dialogue: 0,0:10:18.05,0:10:19.92,Thought,,0,0,0,,Дәл сол кезде болды.
Dialogue: 0,0:10:18.69,0:10:22.18,*Default-ja,NTP,0,0,0,,«Тұмандық» байланысы осы кезде басталды.
Dialogue: 0,0:10:19.92,0:10:22.29,Thought,,0,0,0,,Тұмандық бізбен байланыса бастады,
Dialogue: 0,0:10:22.29,0:10:28.06,Thought,,0,0,0,,және мен ешбір ақпараттың ағып кетуіне жол бермеуге тырысып, есімді жоғалта бастағанда, менің қауіпсіздік картамды ұрлап кетті.
Dialogue: 0,0:10:22.41,0:10:25.86,*Default-ja,NTP,0,0,0,,Мен өз зерттеуімді құпия ұстауға тырысқанда
Dialogue: 0,0:10:26.12,0:10:28.19,*Default-ja,NTP,0,0,0,,Қауіпсіздік картасы ұрланды
Dialogue: 0,0:10:28.97,0:10:31.41,Thought,,0,0,0,,Менде ғана болған карта...
Dialogue: 0,0:10:29.36,0:10:31.57,*Default-ja,NTP,0,0,0,,Менде ғана болатын карта
Dialogue: 0,0:10:39.11,0:10:44.74,Dialogue,,0,0,0,,Әпке, мен біреуді өлтірген болармын.
Dialogue: 0,0:10:39.49,0:10:44.71,*Default-ja,NTP,0,0,0,,Әпке... Мен біреуді өлтірген болармын.
Dialogue: 0,0:10:44.74,0:10:46.90,Dialogue,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:10:45.35,0:10:46.40,*Default-ja,NTP,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:10:46.90,0:10:53.25,Thought,,0,0,0,,Ал сол сәтте кеудемді қағып алған қорқыныш та, ашу да емес, шексіз қуаныш болды.
Dialogue: 0,0:10:47.10,0:10:49.60,*Default-ja,NTP,0,0,0,,Осы кезде ойыма келгені
Dialogue: 0,0:10:49.84,0:10:51.70,*Default-ja,NTP,0,0,0,,Қорқыныш та, ашу да жоқ
Dialogue: 0,0:10:51.85,0:10:53.69,*Default-ja,NTP,0,0,0,,Бұл шексіз қуаныш болды.
Dialogue: 0,0:10:53.87,0:10:56.76,Thought,,0,0,0,,Мен Сейджиге керек болдым.
Dialogue: 0,0:10:54.16,0:10:56.61,*Default-ja,NTP,0,0,0,,Сейджиге керегі мен
Dialogue: 0,0:11:10.49,0:11:13.77,Dialogue,,0,0,0,,Ештеңеге алаңдаудың қажеті жоқ.
Dialogue: 0,0:11:10.97,0:11:13.63,*Default-ja,NTP,0,0,0,,Сізде алаңдайтын ештеңе жоқ
Dialogue: 0,0:11:13.77,0:11:16.05,Dialogue,,0,0,0,,Барлығын әпкеңе қалдыр.
Dialogue: 0,0:11:13.94,0:11:17.25,*Default-ja,NTP,0,0,0,,Бәрін әпкеңе қалдыр, жарай ма?
Dialogue: 0,0:11:16.05,0:11:17.84,Dialogue,,0,0,0,,О, Ято.
Dialogue: 0,0:11:17.84,0:11:21.49,Dialogue,,0,0,0,,Енді ол туралы, ол жақтағы қыз емес...
Dialogue: 0,0:11:17.97,0:11:21.30,*Default-ja,NTP,0,0,0,,Бұл әйел туралы емес, ол туралы.
Dialogue: 0,0:11:21.86,0:11:24.49,Dialogue,,0,0,0,,Сонымен, сіз оны алдыңыз ба?
Dialogue: 0,0:11:22.15,0:11:24.69,*Default-ja,NTP,0,0,0,,Оны сыртқа шығарған Сейджи болды.
Dialogue: 0,0:11:24.80,0:11:26.42,Dialogue,,0,0,0,,Жарайды.
Dialogue: 0,0:11:25.04,0:11:28.78,*Default-ja,NTP,0,0,0,,Жарайды, оны да маған қалдыр.
Dialogue: 0,0:11:26.42,0:11:29.08,Dialogue,,0,0,0,,Ол туралы бәрін маған қалдыр.
Dialogue: 0,0:11:29.08,0:11:32.47,Dialogue,,0,0,0,,Жарайды. Шынымен.
Dialogue: 0,0:11:29.35,0:11:31.93,*Default-ja,NTP,0,0,0,,Жарайды, мүлдем...
Dialogue: 0,0:11:33.83,0:11:42.51,Thought,,0,0,0,,Сол кезде мен Харима Мика есімді ақымақ қыз Сейджиді аңдып жүргенін білмедім.
Dialogue: 0,0:11:34.29,0:11:38.81,*Default-ja,NTP,0,0,0,,Шамамен осы уақытта Сейджиге Мика Харима есімді ақымақ аңдыушы келді.
Dialogue: 0,0:11:38.87,0:11:42.20,*Default-ja,NTP,0,0,0,,Мен оның артымнан келе жатқанын білмедім.
Dialogue: 0,0:11:42.51,0:11:46.97,Thought,,0,0,0,,Ол оның бөлмесіне рұқсатсыз басып кіріп, «оны» көргеннен кейін Сейджи жай ғана...
Dialogue: 0,0:11:43.07,0:11:46.62,*Default-ja,NTP,0,0,0,,Сейджи бөлмесіне кіріп, оны көрді...
Dialogue: 0,0:11:47.87,0:11:51.97,Thought,,0,0,0,,Мен сені қорғаймын, бәрібір.
Dialogue: 0,0:11:48.25,0:11:52.12,*Default-ja,NTP,0,0,0,,Мен сені не істесем де қорғаймын
Dialogue: 0,0:11:51.97,0:11:53.52,Dialogue,,0,0,0,,Ах, жарайды.
Dialogue: 0,0:11:52.48,0:11:53.65,*Default-ja,NTP,0,0,0,,Ах~ Иә иә
Dialogue: 0,0:11:53.94,0:11:57.02,Dialogue,,0,0,0,,Шамасы, үрейленбеу керек сияқты.
Dialogue: 0,0:11:54.33,0:11:56.89,*Default-ja,NTP,0,0,0,,Дүрбелеңнің қажеті жоқ сияқты.
Dialogue: 0,0:11:57.02,0:12:00.86,Dialogue,,0,0,0,,Полиция оларды алып, жақын арада сізбен байланысуы керек.
Dialogue: 0,0:11:57.31,0:12:01.21,*Default-ja,NTP,0,0,0,,Полиция сізді қорғап жатыр, мен сізге жақын арада қоңырау шалатынына сенімдімін.
Dialogue: 0,0:12:02.20,0:12:05.25,Dialogue,,0,0,0,,Мен «полиция» деп айттым, бірақ сіз жақсы болуыңыз керек.
Dialogue: 0,0:12:02.66,0:12:05.28,*Default-ja,NTP,0,0,0,,Жоқ, мен полициямен жақсымын.
Dialogue: 0,0:12:05.25,0:12:07.10,Dialogue,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:12:05.48,0:12:08.51,*Default-ja,NTP,0,0,0,,Бұл үлкен мәселе емес шығар~
Dialogue: 0,0:12:07.10,0:12:08.19,Dialogue,,0,0,0,,Менің ойымша.
Dialogue: 0,0:12:08.19,0:12:10.52,Dialogue,,0,0,0,,Менімен ойнама!
Dialogue: 0,0:12:08.57,0:12:09.73,*Default-ja,NTP,0,0,0,,Егер мен тым егжей-тегжейге тоқталсам,
Dialogue: 0,0:12:13.88,0:12:15.86,Dialogue,,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:12:14.36,0:12:14.77,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:12:15.86,0:12:17.46,Dialogue,,0,0,0,,Иә, солай.
Dialogue: 0,0:12:16.13,0:12:17.30,*Default-ja,NTP,0,0,0,,Иә, бұл рас...
Dialogue: 0,0:12:40.64,0:12:42.69,Dialogue,,0,0,0,,Не? Не болды?
Dialogue: 0,0:12:41.09,0:12:42.62,*Default-ja,NTP,0,0,0,,Не? не болды?
Dialogue: 0,0:12:44.05,0:12:45.67,Dialogue,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:12:44.57,0:12:46.96,*Default-ja,NTP,0,0,0,,Сен барасың ба? Бірақ бәрібір...
Dialogue: 0,0:12:45.67,0:12:47.89,Dialogue,,0,0,0,,Бірақ, біз әлі де...
Dialogue: 0,0:12:47.89,0:12:49.70,Dialogue,,0,0,0,,Шынымен
Dialogue: 0,0:12:48.24,0:12:49.00,*Default-ja,NTP,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:12:53.54,0:12:57.42,Dialogue,,0,0,0,,Мені қатты жақсы көретініңізге қуаныштымын.
Dialogue: 0,0:12:53.90,0:12:57.27,*Default-ja,NTP,0,0,0,,Мені қатты жақсы көретініңізге қуаныштымын
Dialogue: 0,0:12:57.42,0:13:00.06,Dialogue,,0,0,0,,Мен де сені жақсы көремін.
Dialogue: 0,0:12:58.03,0:13:02.42,*Default-ja,NTP,0,0,0,,Мен де сені сүйемін, мәңгілік және әрқашан.
Dialogue: 0,0:13:00.06,0:13:03.12,Dialogue,,0,0,0,,Мәңгі және мәңгі.
Dialogue: 0,0:13:03.86,0:13:05.38,Dialogue,,0,0,0,,содан кейін өзіңіз бен Фантомның арасында сызық сызып көріңіз.
Dialogue: 0,0:13:04.14,0:13:05.20,*Default-ja,NTP,0,0,0,,Мен қорқамын...
Dialogue: 0,0:13:05.38,0:13:06.53,Dialogue,,0,0,0,,Неден?
Dialogue: 0,0:13:05.60,0:13:06.47,*Default-ja,NTP,0,0,0,,Не?
Dialogue: 0,0:13:06.53,0:13:08.72,Dialogue,,0,0,0,,Өтінемін, мені алысқа апарыңыз...
Dialogue: 0,0:13:06.72,0:13:08.91,*Default-ja,NTP,0,0,0,,Өтінемін, алыс жерге барыңыз...
Dialogue: 0,0:13:09.43,0:13:14.73,Dialogue,,0,0,0,,Мен де сенімен жалғыз қалғым келеді, бірақ қайда барар едік?
Dialogue: 0,0:13:09.76,0:13:12.20,*Default-ja,NTP,0,0,0,,Мен де сенімен жалғыз қалғым келеді
Dialogue: 0,0:13:12.44,0:13:13.87,*Default-ja,NTP,0,0,0,,Бірақ қайда...
Dialogue: 0,0:13:15.63,0:13:17.23,Dialogue,,0,0,0,,Оларда не бар?
Dialogue: 0,0:13:16.11,0:13:17.04,*Default-ja,NTP,0,0,0,,Не? Бұл
Dialogue: 0,0:13:17.64,0:13:19.22,Dialogue,,0,0,0,,Ғашықтардың дауы?
Dialogue: 0,0:13:17.94,0:13:19.24,*Default-ja,NTP,0,0,0,,Жанжал ма?
Dialogue: 0,0:13:19.22,0:13:19.72,Dialogue,,0,0,0,,Келіңіздер.
Dialogue: 0,0:13:41.27,0:13:42.82,*Default-ja,NTP,0,0,0,,Жоқ! О жоқ!!
Dialogue: 0,0:13:41.51,0:13:42.25,Dialogue,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:13:42.78,0:13:44.92,Dialogue,,0,0,0,,Бұл жалғыздықты тек шыңға шыққандар ғана түсіне алады
Dialogue: 0,0:13:42.93,0:13:45.55,*Default-ja,NTP,0,0,0,,Тоқта! Жоқ... жоқ!!
Dialogue: 0,0:13:45.36,0:13:47.53,Dialogue,,0,0,0,,Жарайды, тынышталыңыз.
Dialogue: 0,0:13:45.71,0:13:49.91,*Default-ja,NTP,0,0,0,,Тынышталыңыз, біз аса күдікті емеспіз.
Dialogue: 0,0:13:47.53,0:13:50.25,Dialogue,,0,0,0,,Біз жаман адамдар емеспіз.
Dialogue: 0,0:13:50.25,0:13:52.68,Dialogue,,0,0,0,,Жоқ! Жоқ!
Dialogue: 0,0:13:50.39,0:13:51.81,*Default-ja,NTP,0,0,0,,Жоқ! О, жоқ!
Dialogue: 0,0:13:51.60,0:13:52.68,Secondary,,0,0,0,,Тек тыңдаңыз.
Dialogue: 0,0:13:51.82,0:13:52.53,*Default-ja,NTP,0,0,0,,Ертегіні тыңдау...
Dialogue: 0,0:13:52.68,0:13:55.27,Dialogue,,0,0,0,,Мені...кетемін! Маған... рұқсат етіңіз
Dialogue: 0,0:14:03.11,0:14:04.48,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:14:05.87,0:14:07.49,Dialogue,,0,0,0,,Оны жібер!
Dialogue: 0,0:14:06.18,0:14:07.66,*Default-ja,NTP,0,0,0,,Let her go!
Dialogue: 0,0:14:11.53,0:14:14.79,Dialogue,,0,0,0,,Менде бәрі жақсы. Бұл ауырмайды.
Dialogue: 0,0:14:12.33,0:14:13.45,*Default-ja,NTP,0,0,0,,Себебі менде бәрі жақсы
Dialogue: 0,0:14:13.84,0:14:15.57,*Default-ja,NTP,0,0,0,,Ауырмайды, жүр.
Dialogue: 0,0:14:14.79,0:14:15.54,Dialogue,,0,0,0,,Барыңыз.
Dialogue: 0,0:14:15.54,0:14:19.46,Dialogue,,0,0,0,,Мен оны шынымен түсінбеймін, бірақ оны қуу керек емес пе?
Dialogue: 0,0:14:15.98,0:14:19.17,*Default-ja,NTP,0,0,0,,Неге екенін білмеймін, бірақ қуып кетпесем қауіпті, солай ма?
Dialogue: 0,0:14:21.28,0:14:22.96,Dialogue,,0,0,0,,Мен әрқашан мынаны айтқым келді:
Dialogue: 0,0:14:21.58,0:14:23.09,*Default-ja,NTP,0,0,0,,Мен мұны бір рет айтқым келді.
Dialogue: 0,0:14:23.34,0:14:26.21,Dialogue,,0,0,0,,Бұны маған қалдыр да, әрі қарай жүр!
Dialogue: 0,0:14:23.65,0:14:25.94,*Default-ja,NTP,0,0,0,,«Мұны маған қалдыр да, бірінші бар.»
Dialogue: 0,0:14:27.88,0:14:29.18,Dialogue,,0,0,0,,Шынымен
Dialogue: 0,0:14:28.21,0:14:29.07,*Default-ja,NTP,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:14:51.78,0:14:53.53,Dialogue,,0,0,0,,Ой, кешіріңіз...
Dialogue: 0,0:14:52.22,0:14:54.62,*Default-ja,NTP,0,0,0,,Кешіріңіз. Сенімен бәрі жақсы ма?
Dialogue: 0,0:14:53.53,0:14:55.08,Dialogue,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,0:14:57.55,0:14:58.68,Dialogue,,0,0,0,,Сіз...
Dialogue: 0,0:14:57.88,0:14:58.80,*Default-ja,NTP,0,0,0,,А, сен...
Dialogue: 0,0:15:03.00,0:15:04.28,Dialogue,,0,0,0,,Шынымен
Dialogue: 0,0:15:03.20,0:15:04.30,*Default-ja,NTP,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:15:07.21,0:15:08.88,Dialogue,,0,0,0,,Жоқ, күте тұрыңыз!
Dialogue: 0,0:15:07.32,0:15:08.98,*Default-ja,NTP,0,0,0,,Жоқ, күте тұрыңыз.
Dialogue: 0,0:15:11.84,0:15:13.01,Dialogue,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:15:12.02,0:15:14.11,*Default-ja,NTP,0,0,0,,Жібер! Мен жібере алсам ғой!
Dialogue: 0,0:15:13.01,0:15:14.18,Dialogue,,0,0,0,,«Мені жіберіңізші!» дедім.
Dialogue: 0,0:15:15.05,0:15:17.35,Dialogue,,0,0,0,,Ол сенің қызың ба?
Dialogue: 0,0:15:15.59,0:15:17.41,*Default-ja,NTP,0,0,0,,Бұл сенің қызың ба?
Dialogue: 0,0:15:17.35,0:15:19.84,Dialogue,,0,0,0,,Иә, ол менің тағдырым!
Dialogue: 0,0:15:17.50,0:15:19.89,*Default-ja,NTP,0,0,0,,Дұрыс, бұл менің жан серігім!
Dialogue: 0,0:15:19.84,0:15:22.05,Dialogue,,0,0,0,,Ол неге олай көрінеді?
Dialogue: 0,0:15:20.15,0:15:22.28,*Default-ja,NTP,0,0,0,,Ол неге олай?
Dialogue: 0,0:15:22.05,0:15:23.35,Dialogue,,0,0,0,,Мен білетін сияқтымын!
Dialogue: 0,0:15:22.37,0:15:23.41,*Default-ja,NTP,0,0,0,,біз қайта орала аламыз.
Dialogue: 0,0:15:24.36,0:15:28.22,Dialogue,,0,0,0,,Уааааттың тааааты?!
Dialogue: 0,0:15:24.80,0:15:28.53,*Default-ja,NTP,0,0,0,,Бұл не?!
Dialogue: 0,0:15:39.33,0:15:42.61,Dialogue,,0,0,0,,Сіз өз қызыңызды танымаймын дейсіз бе?
Dialogue: 0,0:15:39.67,0:15:45.73,*Default-ja,NTP,0,0,0,,Сүйген адамың туралы білмеу сәл жауапсыздық емес пе?
Dialogue: 0,0:15:42.61,0:15:44.63,Dialogue,,0,0,0,,Бұл біраз жауапсыздық емес пе?
Dialogue: 0,0:15:44.63,0:15:45.88,Dialogue,,0,0,0,,өзі құдаймын деп айтқан адаммен кездескеннен бері.
Dialogue: 0,0:15:45.88,0:15:49.76,Dialogue,,0,0,0,,Біреуді жақсы көргенде мұндай нәрселер маңызды емес!
Dialogue: 0,0:15:46.35,0:15:49.92,*Default-ja,NTP,0,0,0,,Біреуді ұнатқанда маңызды емес!
Dialogue: 0,0:15:49.76,0:15:51.04,Dialogue,,0,0,0,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,0:15:51.04,0:15:52.20,Dialogue,,0,0,0,,Сонда неге?
Dialogue: 0,0:15:51.17,0:15:52.16,*Default-ja,NTP,0,0,0,,Сонда неге?
Dialogue: 0,0:15:52.20,0:15:54.25,Dialogue,,0,0,0,,Неліктен ол сіздің тағдырыңыз?
Dialogue: 0,0:15:52.38,0:15:54.34,*Default-ja,NTP,0,0,0,,Неге сен менің жан жарымсың?
Dialogue: 0,0:15:54.25,0:15:56.16,Dialogue,,0,0,0,,Себебі мен оны жақсы көремін!
Dialogue: 0,0:15:54.72,0:15:57.84,*Default-ja,NTP,0,0,0,,Мен сені жақсы көретіндіктен, басқа жауап жоқ!
Dialogue: 0,0:15:56.16,0:15:57.72,Dialogue,,0,0,0,,Басқа жауап жоқ!
Dialogue: 0,0:15:57.72,0:16:01.27,Dialogue,,0,0,0,,Мен оған «махаббат!» деген сөзден басқа сөзді қолдана алмаймын.
Dialogue: 0,0:15:57.98,0:16:01.14,*Default-ja,NTP,0,0,0,,Махаббатты сөзбен алмастыруға болмайды!
Dialogue: 0,0:16:03.27,0:16:05.27,Dialogue,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:16:03.78,0:16:05.10,*Default-ja,NTP,0,0,0,,Сондықтан мен...
Dialogue: 0,0:16:12.55,0:16:14.28,*Default-ja,NTP,0,0,0,,Kyaa~ Қара велосипед!
Dialogue: 0,0:16:12.92,0:16:14.06,Dialogue,,0,0,0,,Қара велосипед!
Dialogue: 0,0:16:14.06,0:16:16.12,Dialogue,,0,0,0,,...Мен соған сәйкес әрекет етемін!
Dialogue: 0,0:16:14.32,0:16:16.08,*Default-ja,NTP,0,0,0,,Мен оны іс-әрекетіммен көрсетемін!
Dialogue: 0,0:16:16.12,0:16:17.33,Dialogue,,0,0,0,,Мен оны қорғаймын!
Dialogue: 0,0:16:16.27,0:16:18.72,*Default-ja,NTP,0,0,0,,Оны қорғаңыз, болды!
Dialogue: 0,0:16:17.33,0:16:18.72,Dialogue,,0,0,0,,Бар болғаны осы!
Dialogue: 0,0:16:21.58,0:16:23.62,Dialogue,,0,0,0,,Сен маған Изаядан қатты ұнайсың.
Dialogue: 0,0:16:21.86,0:16:24.01,*Default-ja,NTP,0,0,0,,Маған бұл Изаяға қарағанда әлдеқайда ұнады.
Dialogue: 0,0:16:24.05,0:16:26.67,Dialogue,,0,0,0,,Сондықтан мен оны осымен қалдырамын.
Dialogue: 0,0:16:24.25,0:16:26.80,*Default-ja,NTP,0,0,0,,Ендеше мен саған үзіліс беремін!
Dialogue: 0,0:16:35.55,0:16:39.06,Dialogue,,0,0,0,,Мынаны суырып алсам, қан кетем, иә?
Dialogue: 0,0:16:36.61,0:16:38.56,*Default-ja,NTP,0,0,0,,Оны жұлып алсаң, қан шығады.
Dialogue: 0,0:16:39.35,0:16:41.32,Dialogue,,0,0,0,,Мен таңғышты сатып алғаннан кейін оны суырып аламын.
Dialogue: 0,0:16:39.71,0:16:41.32,*Default-ja,NTP,0,0,0,,Таңғышты сатып алыңыз, содан кейін оны шешіңіз.
Dialogue: 0,0:16:41.32,0:16:44.54,Dialogue,,0,0,0,,Жоқ, мүмкін жылдам желім жақсырақ болар ма еді?
Dialogue: 0,0:16:41.61,0:16:44.28,*Default-ja,NTP,0,0,0,,Жоқ. Жедел желім жақсы ма?
Dialogue: 0,0:16:53.39,0:16:57.32,Dialogue,,0,0,0,,Басқаша айтқанда, сіздің басыңыз басқа денеге жабысып жүрді ...
Dialogue: 0,0:16:53.51,0:16:54.29,*Default-ja,NTP,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:16:54.85,0:16:57.49,*Default-ja,NTP,0,0,0,,Мен жүргенімде сенің мойның менің денеме тиіп тұр.
Dialogue: 0,0:16:57.32,0:17:00.10,Dialogue,,0,0,0,,Сіз оны ұстаған кезде жоғары сынып оқушысы кедергі келтірді ...
Dialogue: 0,0:16:57.75,0:16:59.97,*Default-ja,NTP,0,0,0,,Мен оны ұстағанымда, оны жоғары сынып оқушылары бөлді.
Dialogue: 0,0:17:00.10,0:17:03.39,Dialogue,,0,0,0,,Сен қуып келе жатқанда тағы бір жоғары сынып оқушысы пайда болды...
Dialogue: 0,0:17:00.19,0:17:03.21,*Default-ja,NTP,0,0,0,,Артынан қуып барсам, тағы бір жоғары сынып оқушысы шықты.
Dialogue: 0,0:17:03.39,0:17:05.95,Dialogue,,0,0,0,,Ол онымен қашып кетті ме?
Dialogue: 0,0:17:03.59,0:17:05.78,*Default-ja,NTP,0,0,0,,Мен сенің басыңды тартып алдым...
Dialogue: 0,0:17:05.95,0:17:08.49,Dialogue,,0,0,0,,Осының бәріне сенгенімді қалайсың ба?
Dialogue: 0,0:17:06.23,0:17:08.09,*Default-ja,NTP,0,0,0,,Осындай дүниелік сөздерге сенесің бе?
Dialogue: 0,0:17:09.92,0:17:11.88,Dialogue,,0,0,0,,Мен мұның бәріне сенуіңді сұрамаймын.
Dialogue: 0,0:17:12.21,0:17:13.58,Dialogue,,0,0,0,,Жақсы, мен істеймін.
Dialogue: 0,0:17:12.49,0:17:13.53,*Default-ja,NTP,0,0,0,,Мен сенемін
Dialogue: 0,0:17:13.58,0:17:15.01,Dialogue,,0,0,0,,Бірақ Сидзуо неге сонда болды?
Dialogue: 0,0:17:13.81,0:17:15.45,*Default-ja,NTP,0,0,0,,Бірақ неге Сидзуо сонда?
Dialogue: 0,0:17:15.70,0:17:18.10,Dialogue,,0,0,0,,Мен бұл туралы мүлдем ұмытып кеткен едім...
Dialogue: 0,0:17:16.50,0:17:17.85,*Default-ja,NTP,0,0,0,,Мен бұл туралы мүлдем ұмытып кеттім
Dialogue: 0,0:17:18.04,0:17:20.87,*Default-ja,NTP,0,0,0,,Мен саябақта Изаядан жұмыс күтіп тұрдым.
Dialogue: 0,0:17:18.10,0:17:24.99,Dialogue,,0,0,0,,Мен Изаядан жұмыста жүргенде саябақта күтіп тұрдым, сол кезде Сизуо өтіп кетті, сөйтіп сөйлесе бастадық...
Dialogue: 0,0:17:21.46,0:17:24.33,*Default-ja,NTP,0,0,0,,Сидзуо өтіп бара жатып, біраз сөйлестік.
Dialogue: 0,0:17:26.02,0:17:31.90,Dialogue,,0,0,0,,Қалай болғанда да, маған жұмыс тоқтатылды деген хабарлама келді, сондықтан бәрі жақсы.
Dialogue: 0,0:17:26.32,0:17:30.85,*Default-ja,NTP,0,0,0,,Соңында маған кейінірек қоңырау соғып, жұмыс тоқтатылды деп айтты, бұл жақсы.
Dialogue: 0,0:17:32.55,0:17:35.65,Dialogue,,0,0,0,,Орихара, иә?
Dialogue: 0,0:17:32.89,0:17:34.70,*Default-ja,NTP,0,0,0,,Орихара-кун...
Dialogue: 0,0:17:35.65,0:17:38.16,Dialogue,,0,0,0,,Қалай болғанда да, мен сенімен сөйлескім келді...
Dialogue: 0,0:17:38.16,0:17:40.42,Dialogue,,0,0,0,,Сонымен, сіз әлі абдырап тұрсыз, иә?
Dialogue: 0,0:17:38.69,0:17:40.11,*Default-ja,NTP,0,0,0,,Әлі де абдырап қалды.
Dialogue: 0,0:17:40.42,0:17:43.28,Dialogue,,0,0,0,,Не айтсаң да тыңдаймын.
Dialogue: 0,0:17:40.67,0:17:42.41,*Default-ja,NTP,0,0,0,,Мен сенімен сөйлесу үшін бәрін істеймін.
Dialogue: 0,0:17:45.90,0:17:50.00,Dialogue,,0,0,0,,Неге менің басым басқаның денесінде?!
Dialogue: 0,0:17:46.20,0:17:49.37,*Default-ja,NTP,0,0,0,,Неліктен менің мойнымда менікіден басқа дене бар?
Dialogue: 0,0:17:50.00,0:17:57.04,Dialogue,,0,0,0,,Мен қараңғыдамын, өйткені мен оқиғалардың куәгері емеспін, бірақ мен болжам жасай алсам ...
Dialogue: 0,0:17:50.39,0:17:54.66,*Default-ja,NTP,0,0,0,,Мен оны көрмегендіктен не айтсам да, бұл Ширакава Йосен.
Dialogue: 0,0:17:55.23,0:17:56.70,*Default-ja,NTP,0,0,0,,Болжауға қарсы болмасаңыз
Dialogue: 0,0:17:57.04,0:17:58.55,Dialogue,,0,0,0,,Ал егер...
Dialogue: 0,0:17:57.48,0:18:02.91,*Default-ja,NTP,0,0,0,,Мысалы... Дене бітіміңіз ұқсас қызды табыңыз.
Dialogue: 0,0:17:59.94,0:18:05.80,Dialogue,,0,0,0,,Ол сіздің денеңізге ұқсайтын қызды тауып алып, оған жабысты.
Dialogue: 0,0:18:03.10,0:18:05.31,*Default-ja,NTP,0,0,0,,Менің ойымша, ол басын кездейсоқ өзгертті.
Dialogue: 0,0:18:06.44,0:18:07.93,Dialogue,,0,0,0,,Бұл қорқынышты...
Dialogue: 0,0:18:06.65,0:18:08.27,*Default-ja,NTP,0,0,0,,Жан түршігерлік заттар
Dialogue: 0,0:18:07.93,0:18:10.69,Dialogue,,0,0,0,,Ол жаңа өлген мәйітті табуы мүмкін еді.
Dialogue: 0,0:18:08.34,0:18:10.75,*Default-ja,NTP,0,0,0,,Жаңадан жасалған шұбардың мүрдесі болған деседі.
Dialogue: 0,0:18:12.04,0:18:13.32,Dialogue,,0,0,0,,Тоқта!
Dialogue: 0,0:18:14.77,0:18:17.12,Dialogue,,0,0,0,,Бірақ...жоқ...
Dialogue: 0,0:18:15.05,0:18:19.01,*Default-ja,NTP,0,0,0,,Бірақ... бұл...
Dialogue: 0,0:18:17.12,0:18:19.46,Dialogue,,0,0,0,,Бұл мүмкін емес еді...
Dialogue: 0,0:18:20.32,0:18:24.98,Thought,,0,0,0,,Мен қателескен жоқпын...
Dialogue: 0,0:18:20.75,0:18:24.61,*Default-ja,NTP,0,0,0,,Менің істеген ісімде еш қателік болған жоқ.
Dialogue: 0,0:18:24.98,0:18:29.79,Thought,,0,0,0,,Сол оқиғаның денесімен сол қызды жасау...Сейджи үшін...
Dialogue: 0,0:18:25.31,0:18:26.74,*Default-ja,NTP,0,0,0,,Сол оқиғадан кейін
Dialogue: 0,0:18:27.11,0:18:30.04,*Default-ja,NTP,0,0,0,,Мен ол баланы Сейджи үшін жараттым...
Dialogue: 0,0:18:30.29,0:18:31.81,Dialogue,,0,0,0,,Менің кетуім керек.
Dialogue: 0,0:18:30.91,0:18:31.99,*Default-ja,NTP,0,0,0,,Менің кетуім керек
Dialogue: 0,0:18:31.81,0:18:33.26,Dialogue,,0,0,0,,Жарайды.
Dialogue: 0,0:18:32.03,0:18:34.94,*Default-ja,NTP,0,0,0,,Жарайды, енді жақсы.
Dialogue: 0,0:18:33.26,0:18:35.24,Dialogue,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:18:33.60,0:18:35.25,Secondary,,0,0,0,,Ято өліп бара жатыр!
Dialogue: 0,0:18:33.93,0:18:35.01,*Default-ja,NTP,0,0,0,,Ол...
Dialogue: 0,0:18:35.25,0:18:37.28,Dialogue,,0,0,0,,Бұл қорқынышты болды, солай емес пе?
Dialogue: 0,0:18:35.57,0:18:36.68,*Default-ja,NTP,0,0,0,,Бұл қорқынышты болды.
Dialogue: 0,0:18:35.81,0:18:37.28,Secondary,,0,0,0,,Ято өліп бара жатыр!
Dialogue: 0,0:18:37.28,0:18:38.99,Dialogue,,0,0,0,,Бірақ ештеңе дұрыс болмады, солай ма?
Dialogue: 0,0:18:37.60,0:18:39.40,*Default-ja,NTP,0,0,0,,Бірақ ешқандай проблема болмады.
Dialogue: 0,0:18:38.99,0:18:46.44,Thought,,0,0,0,,Менің махаббатым ол қашып, Сейджимен кездессе де ешқашан сөнбеген.
Dialogue: 0,0:18:39.45,0:18:43.34,*Default-ja,NTP,0,0,0,,Әлгі бала бұл жерден қашып, Сейджиге жеткенде де.
Dialogue: 0,0:18:43.60,0:18:46.23,*Default-ja,NTP,0,0,0,,Махаббатым ешқашан сөнбеген
Dialogue: 0,0:18:46.44,0:18:49.73,Thought,,0,0,0,,Сейджидің махаббаты менің оған деген махаббатымды баспалдақ ретінде пайдаланады.
Dialogue: 0,0:18:46.68,0:18:49.96,*Default-ja,NTP,0,0,0,,Сейджидің махаббаты менің махаббатыма негізделген.
Dialogue: 0,0:18:49.73,0:18:54.90,Thought,,0,0,0,,Мұны ол біледі, мен де оның білетінін білемін.
Dialogue: 0,0:18:50.04,0:18:51.86,*Default-ja,NTP,0,0,0,,Мұны Сейджи біледі
Dialogue: 0,0:18:52.01,0:18:54.50,*Default-ja,NTP,0,0,0,,Мен сенің білетініңді білемін
Dialogue: 0,0:18:54.90,0:18:58.07,Thought,,0,0,0,,Барлығы бұрмаланған, бірақ бәрібір...
Dialogue: 0,0:18:55.23,0:18:58.23,*Default-ja,NTP,0,0,0,,Барлығы бұрмаланған, бірақ...
Dialogue: 0,0:18:58.07,0:19:01.81,Dialogue,,0,0,0,,Қарғыс атсын, бұл Раила академиясының формасы еді.
Dialogue: 0,0:18:58.59,0:19:01.35,*Default-ja,NTP,0,0,0,,Қарғыс атсын, Курара академиясының формасы...
Dialogue: 0,0:19:01.81,0:19:03.74,Dialogue,,0,0,0,,Ол кім болды?
Dialogue: 0,0:19:02.07,0:19:03.98,*Default-ja,NTP,0,0,0,,Бұл кім? Сол жігіт
Dialogue: 0,0:19:04.25,0:19:07.25,Dialogue,,0,0,0,,Мен білемін, сондықтан оны маған қалдырыңыз.
Dialogue: 0,0:19:04.58,0:19:07.42,*Default-ja,NTP,0,0,0,,Мен білемін, оны маған қалдырыңыз.
Dialogue: 0,0:19:07.69,0:19:10.39,Dialogue,,0,0,0,,Әйтеуір, Райладан бір қыз табуымыз керек.
Dialogue: 0,0:19:07.76,0:19:10.17,*Default-ja,NTP,0,0,0,,Қалай болғанда да, Құрараның баласын табыңыз
Dialogue: 0,0:19:10.39,0:19:12.70,Dialogue,,0,0,0,,Сонда менің қолымнан келетіні тек басымды кездестіріп, онымен сөйлесу.
Dialogue: 0,0:19:10.53,0:19:12.50,*Default-ja,NTP,0,0,0,,Сосын мойынға жолығып, сөйлесуден басқа амалым жоқ.
Dialogue: 0,0:19:12.70,0:19:16.54,Dialogue,,0,0,0,,Сізді көргенде ғана айқайлай алатын басты айтасыз ба?
Dialogue: 0,0:19:12.81,0:19:15.76,*Default-ja,NTP,0,0,0,,Сені көргенде ғана айқайлаған мойын?
Dialogue: 0,0:19:18.09,0:19:22.62,Dialogue,,0,0,0,,Толық адам ретінде өмір сүретін бас туралы не істейсіз?
Dialogue: 0,0:19:18.47,0:19:22.06,*Default-ja,NTP,0,0,0,,Адам болып тірідей көрінетін мойынға не істеу керек?
Dialogue: 0,0:19:22.62,0:19:26.76,Dialogue,,0,0,0,,Сіз маған өз мүддеңіз үшін оны денесінен бөлетініңізді айтасыз ба?
Dialogue: 0,0:19:22.67,0:19:26.71,*Default-ja,NTP,0,0,0,,Сен үшін басыңды кесіп аламын дейсің бе?
Dialogue: 0,0:19:30.21,0:19:32.18,Dialogue,,0,0,0,,Селти...
Dialogue: 0,0:19:30.55,0:19:31.56,*Default-ja,NTP,0,0,0,,Келти
Dialogue: 0,0:19:33.02,0:19:34.77,Dialogue,,0,0,0,,Мен мойындағым келмейді...
Dialogue: 0,0:19:33.40,0:19:34.66,*Default-ja,NTP,0,0,0,,Сол уақытта маған бір соққы тигізіп көрші
Dialogue: 0,0:19:35.26,0:19:38.28,Dialogue,,0,0,0,,Мен басымды және естеліктерімді жоғалттым ...
Dialogue: 0,0:19:35.57,0:19:38.53,*Default-ja,NTP,0,0,0,,Мойным да, жадым да кетті.
Dialogue: 0,0:19:38.75,0:19:43.11,Dialogue,,0,0,0,,Менің соңғы жиырма жылдағы барлық күш-жігерім бекер болды ...
Dialogue: 0,0:19:39.07,0:19:43.29,*Default-ja,NTP,0,0,0,,Соңғы 20 жыл бойы істеген істерімнің бәрі босқа кеткеніне сене алмаймын.
Dialogue: 0,0:19:45.30,0:19:47.91,Dialogue,,0,0,0,,Олар бекерге кеткен жоқ.
Dialogue: 0,0:19:45.53,0:19:47.02,*Default-ja,NTP,0,0,0,,Бұл ысырап емес.
Dialogue: 0,0:19:47.91,0:19:51.29,Dialogue,,0,0,0,,Мен оны саған қайтарамын.
Dialogue: 0,0:19:48.30,0:19:51.15,*Default-ja,NTP,0,0,0,,Мен оны міндетті түрде қайтарамын.
Dialogue: 0,0:19:51.29,0:19:53.87,Dialogue,,0,0,0,,Осы жерде күте тұрыңыз.
Dialogue: 0,0:19:51.62,0:19:53.30,*Default-ja,NTP,0,0,0,,Сіз осында күтіңіз
Dialogue: 0,0:19:57.02,0:20:00.07,Dialogue,,0,0,0,,Иә, ұялы телефоның қайда?
Dialogue: 0,0:19:57.41,0:20:01.39,*Default-ja,NTP,0,0,0,,Әй, ұялы телефоның ше? Сіз оны тастадыңыз ба?
Dialogue: 0,0:20:00.07,0:20:00.80,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:20:02.19,0:20:03.74,Dialogue,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,0:20:02.45,0:20:03.63,*Default-ja,NTP,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:20:03.74,0:20:06.68,Dialogue,,0,0,0,,Сөмкеге салсам да жоқ еді.
Dialogue: 0,0:20:03.93,0:20:06.55,*Default-ja,NTP,0,0,0,,Ол жерде болмады. Мен оны сөмкеме салдым.
Dialogue: 0,0:20:06.68,0:20:07.81,Dialogue,,0,0,0,,Тағы бір қосымша сабақ па, иә...
Dialogue: 0,0:20:07.81,0:20:10.68,Dialogue,,0,0,0,,Ол... маған керек.
Dialogue: 0,0:20:07.98,0:20:11.08,*Default-ja,NTP,0,0,0,,Ол маған керек
Dialogue: 0,0:20:10.96,0:20:13.53,Dialogue,,0,0,0,,Біз жалғыз қалуымыз керек.
Dialogue: 0,0:20:11.37,0:20:12.81,*Default-ja,NTP,0,0,0,,Біз жалғыз қалуымыз керек
Dialogue: 0,0:20:13.53,0:20:16.07,Dialogue,,0,0,0,,Шынымен бе? Менің ойымша...
Dialogue: 0,0:20:13.77,0:20:15.82,*Default-ja,NTP,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:20:16.07,0:20:20.07,Dialogue,,0,0,0,,Жарайды. Бәрін үлкен әпкеңе қалдыр.
Dialogue: 0,0:20:16.45,0:20:19.31,*Default-ja,NTP,0,0,0,,Жарайды, бәрін апаңа қалдыр.
Dialogue: 0,0:20:23.88,0:20:26.48,Thought,,0,0,0,,Қандай жүйке!
Dialogue: 0,0:20:24.34,0:20:25.86,*Default-ja,NTP,0,0,0,,Қандай ұят!
Dialogue: 0,0:20:28.65,0:20:33.51,Thought,,0,0,0,,Қуыршақтар қуыршақ сияқты әрекет етіп, олардың айтқанын орындауы керек.
Dialogue: 0,0:20:29.06,0:20:33.54,*Default-ja,NTP,0,0,0,,Қуыршақ қуыршақ сияқты тыныш болуы керек еді.
Dialogue: 0,0:20:33.51,0:20:36.50,Thought,,0,0,0,,Менің махаббатыма араласпа.
Dialogue: 0,0:20:33.83,0:20:35.83,*Default-ja,NTP,0,0,0,,Менің махаббатыма араласпа
Dialogue: 0,0:20:37.06,0:20:38.46,Thought,,0,0,0,,Мен шештім...
Dialogue: 0,0:20:37.37,0:20:40.52,*Default-ja,NTP,0,0,0,,Мен шештім. Мен енді өкінгім келмейді.
Dialogue: 0,0:20:38.46,0:20:40.52,Thought,,0,0,0,,Мен басқа ештеңеге өкінгім келмейді...
Dialogue: 0,0:20:40.52,0:20:42.47,Thought,,0,0,0,,Тағы да.
Dialogue: 0,0:20:40.74,0:20:41.65,*Default-ja,NTP,0,0,0,,Созылған жұдырық
Dialogue: 0,0:20:43.39,0:20:44.53,Dialogue,,0,0,0,,Тыңдау.
Dialogue: 0,0:20:43.68,0:20:47.31,*Default-ja,NTP,0,0,0,,Жарайсың ба? Төмендегі барлық адамдарға дереу хабарласыңыз.
Dialogue: 0,0:20:44.53,0:20:49.81,Dialogue,,0,0,0,,Біздің астарластарымызға хабарлама таратыңыз. Оның өлі-өлмейтіні маған бәрібір.
Dialogue: 0,0:20:47.49,0:20:48.95,*Default-ja,NTP,0,0,0,,Маған тірі ме, өлгенім бәрібір
Dialogue: 0,0:20:49.81,0:20:53.10,Dialogue,,0,0,0,,Жағдайға байланысты оны сол жерге тастаңыз.
Dialogue: 0,0:20:50.24,0:20:52.96,*Default-ja,NTP,0,0,0,,Жағдайға байланысты, онымен айналысыңыз!
Dialogue: 0,0:21:19.01,0:21:20.38,Dialogue,,0,0,0,,Б... бір сызық
Dialogue: 0,0:21:19.32,0:21:22.17,*Default-ja,NTP,0,0,0,,Байқадым~ Барлығы бос емес.
Dialogue: 0,0:21:20.38,0:21:21.92,Dialogue,,0,0,0,,Барлығы бос емес.
Dialogue: 0,0:21:22.20,0:21:23.77,Dialogue,,0,0,0,,Мен күте алмаймын!
Dialogue: 0,0:21:22.57,0:21:25.94,*Default-ja,NTP,0,0,0,,Тағатсыздана күтемін, асыға күтемін, асыға күтемін!
Dialogue: 0,0:21:23.77,0:21:24.70,Dialogue,,0,0,0,,Мен күте алмаймын!!
Dialogue: 0,0:21:24.70,0:21:26.18,Dialogue,,0,0,0,,Мен күте алмаймын!!!
Dialogue: 0,0:21:26.18,0:21:32.18,Dialogue,,0,0,0,,Бұл қалада үнемі пайда болып, жоғалып кететін мен білмейтін көптеген нәрселер бар!
Dialogue: 0,0:21:26.31,0:21:30.66,*Default-ja,NTP,0,0,0,,Бұл қалада әлі де мен, информатор, білмейтін нәрселер көп.
Dialogue: 0,0:21:30.74,0:21:32.13,*Default-ja,NTP,0,0,0,,Туады және жоғалады
Dialogue: 0,0:21:32.18,0:21:35.52,Dialogue,,0,0,0,,Сондықтан мен көп адам жиналатын қаладан кете алмаймын!
Dialogue: 0,0:21:32.66,0:21:35.74,*Default-ja,NTP,0,0,0,,Сондықтан мен адамдар жиналатын қаладан шыға алмаймын.
Dialogue: 0,0:21:36.06,0:21:37.21,*Default-ja,NTP,0,0,0,,Адамдар жақсы көреді!
Dialogue: 0,0:21:36.10,0:21:37.43,Dialogue,,0,0,0,,Адамдар жақсы көреді!
Dialogue: 0,0:21:37.43,0:21:38.76,Dialogue,,0,0,0,,Маған адамдар ұнайды!
Dialogue: 0,0:21:37.52,0:21:39.87,*Default-ja,NTP,0,0,0,,Маған адамдар ұнайды! мен сені жақсы көремін!
Dialogue: 0,0:21:38.76,0:21:40.06,Dialogue,,0,0,0,,Мен оларды жақсы көремін!
Dialogue: 0,0:21:40.06,0:21:40.98,Dialogue,,0,0,0,,Шекара сызықтары?
Dialogue: 0,0:21:40.19,0:21:41.38,*Default-ja,NTP,0,0,0,,Ол сонда бетінде ақымақтай күлкімен тұрып тұр, бір дюймге де қозғалмайды! Бұл Шинсоның Қвиркі ме?
Dialogue: 0,0:21:43.29,0:21:48.41,Dialogue,,0,0,0,,Адамдар мені де жақсы көруі керек.
Dialogue: 0,0:21:43.62,0:21:48.34,*Default-ja,NTP,0,0,0,,Адамдар да мені жақсы көруі керек, солай ма?
Dialogue: 0,0:21:55.39,0:21:56.68,Dialogue,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:21:55.74,0:21:56.90,*Default-ja,NTP,0,0,0,,Рахмет
Dialogue: 0,0:21:56.68,0:21:58.47,Dialogue,,0,0,0,,Сіз өзіңізді тыныш сезінесіз бе?
Dialogue: 0,0:21:56.98,0:21:58.28,*Default-ja,NTP,0,0,0,,Аздап тынышталдыңыз ба?
Dialogue: 0,0:21:58.47,0:22:00.77,Dialogue,,0,0,0,,Сұрақтарға жауап бере аласыз ба?
Dialogue: 0,0:21:58.62,0:22:00.21,*Default-ja,NTP,0,0,0,,Сұрақтарға жауап бере аласыз ба?
Dialogue: 0,0:22:01.66,0:22:05.41,Dialogue,,0,0,0,,Ештеңе есімде жоқ деп айттыңыз ғой, солай ма?
Dialogue: 0,0:22:02.02,0:22:04.57,*Default-ja,NTP,0,0,0,,Ештеңе есімде жоқ дедіңіз ғой, солай ма?
Dialogue: 0,0:22:05.41,0:22:10.19,Dialogue,,0,0,0,,Басқаша айтқанда, бұл...ммм...сенде амнезия бар ма?
Dialogue: 0,0:22:05.66,0:22:09.69,*Default-ja,NTP,0,0,0,,Бұл... е, есте сақтау қабілетінің жоғалуын білдіреді ме?
Dialogue: 0,0:22:11.76,0:22:17.74,Dialogue,,0,0,0,,Мен тағы айтамын, бірақ менің ойымша, полицияға немесе ауруханаға бару керек...
Dialogue: 0,0:22:12.15,0:22:14.36,*Default-ja,NTP,0,0,0,,Хмм... Тағы да айтамын.
Dialogue: 0,0:22:14.77,0:22:17.18,*Default-ja,NTP,0,0,0,,Полицияға немесе ауруханаға барған дұрыс...
Dialogue: 0,0:22:18.26,0:22:19.48,Dialogue,,0,0,0,,Неге?!
Dialogue: 0,0:22:18.55,0:22:19.43,*Default-ja,NTP,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:21.65,0:22:26.03,Dialogue,,0,0,0,,Неге?!
Dialogue: 0,0:22:21.90,0:22:23.95,*Default-ja,NTP,0,0,0,,Юта Отокоцу
Dialogue: 0,0:22:23.51,0:22:25.50,Secondary,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:22:24.01,0:22:26.69,*Default-ja,NTP,0,0,0,,Жоқ, жақсы, жақсы, кешірім сұрама.
Dialogue: 0,0:22:25.50,0:22:26.78,Secondary,,0,0,0,,Кешірім сұрамаңыз.
Dialogue: 0,0:22:27.55,0:22:29.32,Thought,,0,0,0,,Менің кетуім керек...
Dialogue: 0,0:22:28.08,0:22:32.20,*Default-ja,NTP,0,0,0,,Ол адам менің жолыма бөгет болғанша... кетуім керек.
Dialogue: 0,0:22:29.32,0:22:32.03,Thought,,0,0,0,,Ол араласпас бұрын...
Dialogue: 0,0:22:32.37,0:22:35.24,Thought,,0,0,0,,Мәңгі және мәңгі -
Dialogue: 0,0:22:32.72,0:22:35.22,*Default-ja,NTP,0,0,0,,Мәңгі, мәңгі...
Dialogue: 0,0:22:35.24,0:22:36.70,Thought,,0,0,0,,Менің кетуім керек.
Dialogue: 0,0:22:35.51,0:22:36.57,*Default-ja,NTP,0,0,0,,Менің кетуім керек…
Dialogue: 0,0:22:37.61,0:22:39.00,Thought,,0,0,0,,Сейджи...
Dialogue: 0,0:22:37.94,0:22:39.14,*Default-ja,NTP,0,0,0,,Сейджи...
Dialogue: 0,0:22:39.87,0:22:41.50,Thought,,0,0,0,,Сейджи...
Dialogue: 0,0:22:40.16,0:22:41.43,*Default-ja,NTP,0,0,0,,Сейджи мырза...
Dialogue: 0,0:22:42.51,0:22:44.25,Thought,,0,0,0,,Мен сені жақсы көремін.
Dialogue: 0,0:22:42.84,0:22:44.53,*Default-ja,NTP,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:24:15.10,0:24:19.72,staff,NTP,0,0,0,,Өндіріс: lastzzz Rest Cloud akira Akira
Dialogue: 0,0:24:15.18,0:24:16.10,Dialogue,,0,0,0,,Қате...
Dialogue: 0,0:24:15.69,0:24:18.41,*Default-ja,NTP,0,0,0,,Изая Орихара басы жоқ шабандоз ретінде
Dialogue: 0,0:24:16.43,0:24:20.89,Dialogue,,0,0,0,,Басы жоқ шабандоз Орихара Изая мен мойыны жаралы қыз қайтадан пайда болды...
Dialogue: 0,0:24:18.51,0:24:20.93,*Default-ja,NTP,0,0,0,,Мойнында тыртығы бар қыз қайтадан пайда болады.
Dialogue: 0,0:24:19.88,0:24:24.87,staff,NTP,0,0,0,,Manyu субтитрлер жұбы http://popgo.net/bbs/
Dialogue: 0,0:24:20.89,0:24:23.69,Dialogue,,0,0,0,,Ең бастысы, келесі сыныптың бір жігіті долларда!
Dialogue: 0,0:24:21.17,0:24:23.93,*Default-ja,NTP,0,0,0,,Ең сорақысы, қасымдағы сыныптағы жігіт доллармен...
Dialogue: 0,0:24:24.18,0:24:25.69,Dialogue,,0,0,0,,Келесі жолы: Бірінші және жалғыз.
Dialogue: 0,0:24:26.14,0:24:29.48,Dialogue,,0,0,0,,Мен әдеттен тыс өмір сүретін түс көрдім, бірақ...
Dialogue: 0,0:24:26.44,0:24:29.45,*Default-ja,NTP,0,0,0,,Мен ерекше өмірді армандадым, бірақ...
Dialogue: 0,0:24:30.98,0:24:36.98,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory