Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:26.86,0:00:27.90,Default,,0,0,0,,Ишиши
Dialogue: 0,0:00:27.98,0:00:29.48,Default,,0,0,0,,Қабан
Dialogue: 0,0:00:31.32,0:00:35.11,Default,,0,0,0,,Манзайге~ки~жу~♪
Dialogue: 0,0:00:35.86,0:00:38.95,Default,,0,0,0,,Ақырында, біздің сериямыз осында!
Dialogue: 0,0:00:39.03,0:00:40.95,Default,,0,0,0,,Бұл ұят болды.
Dialogue: 0,0:00:41.04,0:00:43.33,Default,,0,0,0,,Өйткені, фильм бұл кино~
Dialogue: 0,0:00:43.41,0:00:46.96,Default,,0,0,0,,Суреттер қызықты, бірақ мен бейсболды да жақсы көремін.
Dialogue: 0,0:00:47.04,0:00:49.75,Default,,0,0,0,,Жоқ, бұл ыстық.
Dialogue: 0,0:00:49.84,0:00:51.42,Default,,0,0,0,,Бұл жақсы нәрсе
Dialogue: 0,0:00:51.50,0:00:52.55,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:00:52.63,0:00:54.92,Default,,0,0,0,,Қапшы допқа тиеді.
Dialogue: 0,0:00:55.01,0:00:58.14,Default,,0,0,0,,Ах! Оны пышақтың үстіне қойыңыз. Оны нанға жағыңыз.
Dialogue: 0,0:00:59.05,0:01:00.56,Default,,0,0,0,,Сора майы
Dialogue: 0,0:01:00.64,0:01:02.10,Default,,0,0,0,,Хона Бұл солай ма?
Dialogue: 0,0:01:02.18,0:01:05.14,Default,,0,0,0,,Жасыл және шөпте серпілуде...
Dialogue: 0,0:01:05.23,0:01:06.60,Default,,0,0,0,,Әй, бұл шегіртке!
Dialogue: 0,0:01:06.69,0:01:08.40,Default,,0,0,0,,Келіңіздер! Қамыр!
Dialogue: 0,0:01:08.48,0:01:10.40,Default,,0,0,0,,Үйге жүгіру немесе бірдеңе соғу.
Dialogue: 0,0:01:10.48,0:01:12.11,Default,,0,0,0,,Ах! Қамыр
Dialogue: 0,0:01:12.19,0:01:13.40,Default,,0,0,0,,Иә, айтыңыз.
Dialogue: 0,0:01:13.49,0:01:15.74,Default,,0,0,0,,Сіз мұны біраздан бері айтпадыңыз ба?
Dialogue: 0,0:01:15.82,0:01:17.41,Default,,0,0,0,,Дұрыс, бірақ олай емес.
Dialogue: 0,0:01:17.49,0:01:19.53,Default,,0,0,0,,Жаңбырлы күндер - жоқ-жоқ.
Dialogue: 0,0:01:19.62,0:01:20.58,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:20.66,0:01:22.24,Default,,0,0,0,,Қамыр қаншалықты жақсы болса да,
Dialogue: 0,0:01:22.74,0:01:24.29,Default,,0,0,0,,«Өтен» Чуутене
Dialogue: 0,0:01:25.33,0:01:28.79,Default,,0,0,0,,Хаа... Мен сенімен енді істей алмаймын.
Dialogue: 0,0:01:28.88,0:01:30.63,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:01:32.30,0:01:35.09,Default,,0,0,0,,(Шырылдау!)
Dialogue: 0,0:01:55.49,0:01:57.95,Default,,0,0,0,,Дүние жүзі бойынша
Dialogue: 0,0:01:58.03,0:02:00.28,Default,,0,0,0,,Сансыз қазына таптым.
Dialogue: 0,0:02:01.20,0:02:03.99,Default,,0,0,0,,Қазына іздеушісі
Dialogue: 0,0:02:04.08,0:02:05.79,Default,,0,0,0,,Зоронд Рон
Dialogue: 0,0:02:06.62,0:02:11.84,Default,,0,0,0,,Бұл кісі қайда барса, қазына болады дейді.
Dialogue: 0,0:02:12.96,0:02:17.22,Default,,0,0,0,,Зоронд Ронның келесі нысанасы сізден.
Dialogue: 0,0:02:17.63,0:02:22.26,Default,,0,0,0,,Ғапапа ауылының шетінен көтерілген Ғапал тауында ұйықтау.
Dialogue: 0,0:02:23.39,0:02:26.43,Default,,0,0,0,,Емшек биі
Dialogue: 0,0:02:27.27,0:02:29.31,Default,,0,0,0,,Нағыз қазына іздеушісі
Dialogue: 0,0:02:29.73,0:02:32.27,Default,,0,0,0,,Бұл мен туралы.
Dialogue: 0,0:02:35.28,0:02:38.11,Default,,0,0,0,,Маған мұны істеуге рұқсат бересіз бе?
Dialogue: 0,0:02:38.19,0:02:40.41,Default,,0,0,0,,Хмф, сізге не ұнамайды?
Dialogue: 0,0:02:40.49,0:02:42.87,Default,,0,0,0,,Менен басқа біреу мені «ең жақсы» деп атайды.
Dialogue: 0,0:02:42.95,0:02:44.95,Default,,0,0,0,,Сізге қамқорлық жасайтын адамның болуы маңызды.
Dialogue: 0,0:02:45.41,0:02:46.33,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:46.41,0:02:49.58,Default,,0,0,0,,Қандай жағдай болмасын, Зорори-сенсей ең жақсы екені сөзсіз.
Dialogue: 0,0:02:50.12,0:02:52.13,Default,,0,0,0,,Бірақ бұл бүгінге дейін!
Dialogue: 0,0:02:52.21,0:02:53.59,Default,,0,0,0,,Гапал тауы дегеніміз не?
Dialogue: 0,0:02:53.67,0:02:56.46,Default,,0,0,0,,Бұл жерден бір тас лақтырылған жерде.
Dialogue: 0,0:02:56.80,0:02:58.34,Default,,0,0,0,,Біз жаңа ғана твиттер жаздык.
Dialogue: 0,0:02:58.42,0:02:59.26,Default,,0,0,0,,...
Dialogue: 0,0:02:59.76,0:03:03.68,Default,,0,0,0,,Ол бергенше біз сенікі береміз.
Dialogue: 0,0:03:03.97,0:03:06.10,Default,,0,0,0,,Содан кейін Зоорихо құрастырыңыз.
Dialogue: 0,0:03:06.18,0:03:09.18,Default,,0,0,0,,Әдемі гүлдердің туған күні құтты болсын
Dialogue: 0,0:03:09.27,0:03:12.81,Default,,0,0,0,,Менің жасым жетіп қалды.
Dialogue: 0,0:03:12.90,0:03:15.57,Default,,0,0,0,,Бірақ сізде мен үшін карта жоқ па?
Dialogue: 0,0:03:15.65,0:03:17.44,Default,,0,0,0,,Хехе, солай...
Dialogue: 0,0:03:17.53,0:03:19.24,Default,,0,0,0,,Менің тәтті тісім
Dialogue: 0,0:03:19.32,0:03:20.49,Default,,0,0,0,,Осы мұрынмен
Dialogue: 0,0:03:20.57,0:03:21.82,Default,,0,0,0,,Мен оны табамын!
Dialogue: 0,0:03:22.07,0:03:23.32,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:03:23.45,0:03:25.58,Default,,0,0,0,,Оның Зорори-сенсей екеніне күмән жоқ.
Dialogue: 0,0:03:25.87,0:03:27.41,Default,,0,0,0,,Вуохяхьяхья~
Dialogue: 0,0:03:27.49,0:03:29.87,Default,,0,0,0,,Такара мені шақырып жатыр!
Dialogue: 0,0:03:30.71,0:03:32.87,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:03:32.96,0:03:38.96,Default,,0,0,0,,♪～
Dialogue: 0,0:04:55.79,0:05:01.80,Default,,0,0,0,,～♪
Dialogue: 0,0:05:09.18,0:05:12.06,Default,,0,0,0,,Енді мен сендерден Ғапал тауына баратын жолды сұраймын.
Dialogue: 0,0:05:12.14,0:05:13.22,Default,,0,0,0,,Иә
Dialogue: 0,0:05:13.31,0:05:16.10,Default,,0,0,0,,Бірақ бұл станция...
Dialogue: 0,0:05:21.11,0:05:23.03,Default,,0,0,0,,Онда ешкім жоқ.
Dialogue: 0,0:05:23.28,0:05:24.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:24.74,0:05:26.82,Default,,0,0,0,,Уау, сол ғимаратта.
Dialogue: 0,0:05:26.90,0:05:28.53,Default,,0,0,0,,Мұнда көп адам жиналды.
Dialogue: 0,0:05:28.91,0:05:31.74,Default,,0,0,0,,Жарайды, кеттік Ишиши, Ношиши!
Dialogue: 0,0:05:32.12,0:05:32.95,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:34.33,0:05:35.83,Default,,0,0,0,,Ах, бастауыш мектеп.
Dialogue: 0,0:05:36.46,0:05:38.29,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:05:39.17,0:05:41.21,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:05:41.67,0:05:42.80,Default,,0,0,0,,Хакушун!
Dialogue: 0,0:05:42.88,0:05:44.01,Default,,0,0,0,,Мен – Соғысшылар корпусының капитаны Тео Магатпын.
Dialogue: 0,0:05:44.84,0:05:45.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:45.88,0:05:48.18,Default,,0,0,0,,Мен оны тез жаттығу залына апарып, демалуым керек.
Dialogue: 0,0:05:48.51,0:05:49.72,Default,,0,0,0,,Гимназия?
Dialogue: 0,0:05:49.84,0:05:50.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:51.47,0:05:53.68,Default,,0,0,0,,Не деген...
Dialogue: 0,0:05:55.10,0:05:57.19,Default,,0,0,0,,Келесі топ гимназияға кірсін!
Dialogue: 0,0:05:57.56,0:05:59.44,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:05:59.52,0:06:02.82,Default,,0,0,0,,Бұл тек балаларға ғана әсер ететін ауру...
Dialogue: 0,0:06:03.40,0:06:05.19,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:08.82,0:06:11.66,Default,,0,0,0,,Мұғалім... көмектесіңізші
Dialogue: 0,0:06:12.03,0:06:13.03,Default,,0,0,0,,Бұл ауырады
Dialogue: 0,0:06:13.49,0:06:16.25,Default,,0,0,0,,Мықты болыңыз! Менің мұғалімім бар.
Dialogue: 0,0:06:16.45,0:06:17.75,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:06:22.00,0:06:22.84,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:06:28.55,0:06:29.38,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:06:30.59,0:06:32.30,Default,,0,0,0,,Шай ішкіңіз келе ме? (3 адам) Иә?
Dialogue: 0,0:06:32.43,0:06:34.06,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:06:35.60,0:06:38.56,Default,,0,0,0,,Доктор Мурроуға келгеніңіз үшін рахмет.
Dialogue: 0,0:06:38.81,0:06:40.60,Default,,0,0,0,,Мұнда келудің өзі ештеңені білдірмейді.
Dialogue: 0,0:06:41.31,0:06:44.40,Default,,0,0,0,,Балаларымызды құтқаратын дәріні жетілдіруіміз керек.
Dialogue: 0,0:06:45.78,0:06:47.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:47.53,0:06:48.90,Default,,0,0,0,,Мен ойлағандай
Dialogue: 0,0:06:50.82,0:06:51.95,Default,,0,0,0,,Әке!
Dialogue: 0,0:06:52.49,0:06:54.41,Default,,0,0,0,,Медицина әлі де қолжетімді емес пе?
Dialogue: 0,0:06:54.53,0:06:56.16,Default,,0,0,0,,Кешіріңіз Ариус
Dialogue: 0,0:06:56.24,0:06:59.21,Default,,0,0,0,,Мен бір қадам ғана қалдым.
Dialogue: 0,0:06:59.33,0:07:01.21,Default,,0,0,0,,Мен бұған тоймаймын
Dialogue: 0,0:07:01.50,0:07:02.75,Default,,0,0,0,,(Бест Джинст) Жақында болған Хосу оқиғасынан шабыт алған зұлымдар—
Dialogue: 0,0:07:02.92,0:07:05.34,Default,,0,0,0,,Пиккаригоке және күлгін тас.
Dialogue: 0,0:07:05.42,0:07:08.21,Default,,0,0,0,,Білсең, бірден алайық!
Dialogue: 0,0:07:08.97,0:07:09.92,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:07:10.01,0:07:13.09,Default,,0,0,0,,Бұл оңай емес, қария.
Dialogue: 0,0:07:13.18,0:07:14.01,Default,,0,0,0,,Лұқт
Dialogue: 0,0:07:14.26,0:07:16.60,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:07:16.93,0:07:18.85,Default,,0,0,0,,Уау! Әдемі...
Dialogue: 0,0:07:18.93,0:07:20.23,Default,,0,0,0,,Тахаха…
Dialogue: 0,0:07:20.31,0:07:21.77,Default,,0,0,0,,Екі материал
Dialogue: 0,0:07:21.85,0:07:24.56,Default,,0,0,0,,Ғапал тауына бармайынша ала алмайсың.
Dialogue: 0,0:07:25.27,0:07:26.44,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:26.73,0:07:31.07,Default,,0,0,0,,Мұны сіз де білесіз бе? Ғапал тауы туралы аңыз
Dialogue: 0,0:07:32.20,0:07:35.37,Default,,0,0,0,,Баяғыда қарақшы қазынаны жасырған екен.
Dialogue: 0,0:07:35.45,0:07:37.03,Default,,0,0,0,,Аңыз арқылы сиқырланған
Dialogue: 0,0:07:37.12,0:07:40.20,Default,,0,0,0,,Сол тауға көптеген жындылар кірді.
Dialogue: 0,0:07:40.41,0:07:43.29,Default,,0,0,0,,Бірде-біреуі оралмады.
Dialogue: 0,0:07:43.92,0:07:45.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:47.09,0:07:48.88,Default,,0,0,0,,Мен... мен барамын
Dialogue: 0,0:07:49.63,0:07:51.42,Default,,0,0,0,,А... Профессор Ариус!
Dialogue: 0,0:07:51.51,0:07:52.43,Default,,0,0,0,,Даа!
Dialogue: 0,0:07:52.80,0:07:53.97,Default,,0,0,0,,Ал... күте тұрыңыз, Ариус!
Dialogue: 0,0:07:54.05,0:07:57.56,Default,,0,0,0,,Қымбатты жалғыз қызымның жаман жолға түсуіне жол бере алмаймын!
Dialogue: 0,0:07:58.22,0:07:59.68,Default,,0,0,0,,Мен бүгінмін.
Dialogue: 0,0:07:59.81,0:08:02.60,Default,,0,0,0,,Менің сол сүйкімді оқушыларды құтқаратын қабілетім бар.
Dialogue: 0,0:08:03.14,0:08:04.65,Default,,0,0,0,,Тек студенттер емес!
Dialogue: 0,0:08:04.73,0:08:07.11,Default,,0,0,0,,Бүкіл ауылдың балалары қиналып жатыр.
Dialogue: 0,0:08:07.19,0:08:09.73,Default,,0,0,0,,Жай отырып қарап отыруға болмайды!
Dialogue: 0,0:08:10.40,0:08:12.99,Default,,0,0,0,,Қария, қайта қарашы.
Dialogue: 0,0:08:13.07,0:08:14.07,Default,,0,0,0,,Бұл өте қауіпті.
Dialogue: 0,0:08:14.57,0:08:16.37,Default,,0,0,0,,Сонымен, басқа жақсы жол бар ма?
Dialogue: 0,0:08:16.87,0:08:18.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:19.91,0:08:21.75,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:08:22.04,0:08:23.37,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:08:24.67,0:08:27.29,Default,,0,0,0,,Мен барлық әңгімелерді естідім.
Dialogue: 0,0:08:27.84,0:08:28.71,Default,,0,0,0,,Қария
Dialogue: 0,0:08:28.79,0:08:31.09,Default,,0,0,0,,Біз сізге еріп барайық.
Dialogue: 0,0:08:31.21,0:08:32.67,Default,,0,0,0,,Мм... сен ше?
Dialogue: 0,0:08:33.55,0:08:35.51,Default,,0,0,0,,Міне, кімнің батылы бар
Dialogue: 0,0:08:35.59,0:08:38.18,Default,,0,0,0,,Мен қаншама қауіптерді жеңе алдым.
Dialogue: 0,0:08:38.26,0:08:39.89,Default,,0,0,0,,Саяхаттау және күресу!
Dialogue: 0,0:08:39.97,0:08:42.81,Default,,0,0,0,,Оның аты Кайкецу Зори-сенсэй!
Dialogue: 0,0:08:43.39,0:08:44.31,Default,,0,0,0,,Хо…
Dialogue: 0,0:08:44.39,0:08:46.48,Default,,0,0,0,,Бұл доктор Мурроу емес пе еді?
Dialogue: 0,0:08:46.56,0:08:47.77,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,0:08:47.86,0:08:49.61,Default,,0,0,0,,Қартты қорғау кезінде
Dialogue: 0,0:08:49.69,0:08:52.36,Default,,0,0,0,,Сол пикарикоке және күлгін тас.
Dialogue: 0,0:08:52.44,0:08:53.65,Default,,0,0,0,,Үйге апарайық
Dialogue: 0,0:08:54.70,0:08:55.53,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:08:56.32,0:08:58.12,Default,,0,0,0,,Бұл ақылсыз нәрсе
Dialogue: 0,0:08:58.20,0:09:00.45,Default,,0,0,0,,Мен сұлу әйелге өтірік айтпаймын
Dialogue: 0,0:09:00.95,0:09:01.83,Default,,0,0,0,,Нихи
Dialogue: 0,0:09:03.62,0:09:07.29,Default,,0,0,0,,Ариус-чанды қорғау үшін мені Гапал тауына жетелесеңіз.
Dialogue: 0,0:09:07.38,0:09:09.84,Default,,0,0,0,,Сіз оны менен оңай ала аласыз.
Dialogue: 0,0:09:10.00,0:09:12.21,Default,,0,0,0,,Сонымен қатар, Пикари Гоке және Күлгін тас.
Dialogue: 0,0:09:12.30,0:09:14.01,Default,,0,0,0,,Егер мен оны таба алсам...
Dialogue: 0,0:09:15.42,0:09:17.64,Default,,0,0,0,,Зорори керемет!
Dialogue: 0,0:09:18.05,0:09:20.76,Default,,0,0,0,,Сүйкімді Ариус-чанның жүрегін ұстаңыз!
Dialogue: 0,0:09:21.31,0:09:25.43,Default,,0,0,0,,Бұл Оширо мен Ойоме-санды бірден алудың тамаша мүмкіндігі.
Dialogue: 0,0:09:26.27,0:09:29.06,Default,,0,0,0,,Нуфуфу... Нуфуфуфу!
Dialogue: 0,0:09:29.19,0:09:30.40,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:09:32.78,0:09:33.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:34.94,0:09:36.49,Default,,0,0,0,,Мені де алып кетіңізші!
Dialogue: 0,0:09:36.57,0:09:37.41,Default,,0,0,0,,үшін? (Ишиши Ношиши) Иә?
Dialogue: 0,0:09:37.49,0:09:38.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:39.12,0:09:41.03,Default,,0,0,0,,Мен қыңыр болдым.
Dialogue: 0,0:09:41.33,0:09:43.95,Default,,0,0,0,,Бірақ Зооридің сөзі мені оятты.
Dialogue: 0,0:09:44.83,0:09:48.12,Default,,0,0,0,,Осы ауылдың балалары үшін бейтаныс
Dialogue: 0,0:09:48.21,0:09:50.84,Default,,0,0,0,,Сіздің өміріңізді қатерге тігіп, Ғапал тауына барғаныңызға сенбеймін.
Dialogue: 0,0:09:50.92,0:09:51.75,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:09:52.17,0:09:54.63,Default,,0,0,0,,А, жоқ... мені келуге мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:09:54.80,0:09:57.68,Default,,0,0,0,,Мен доктор Марроудың көмекшісімін.
Dialogue: 0,0:09:57.76,0:10:00.05,Default,,0,0,0,,Мен ұзақ уақыт бойы зерттеулерге көмектесіп келемін.
Dialogue: 0,0:10:00.14,0:10:02.39,Default,,0,0,0,,Мүк, тастар туралы мәліметтер берілген.
Dialogue: 0,0:10:02.72,0:10:03.60,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:10:03.89,0:10:04.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:05.35,0:10:08.44,Default,,0,0,0,,Негізі мен, Пиккари Гоке және Күлгін тас.
Dialogue: 0,0:10:08.52,0:10:10.98,Default,,0,0,0,,Мен оны бұрын ешқашан көрген емеспін...
Dialogue: 0,0:10:11.52,0:10:14.07,Default,,0,0,0,,А, иә... дұрыс.
Dialogue: 0,0:10:14.15,0:10:16.82,Default,,0,0,0,,Иә, жақсы... бұл қауіпсіз.
Dialogue: 0,0:10:16.90,0:10:19.24,Default,,0,0,0,,Ахаха ахахха...
Dialogue: 0,0:10:19.32,0:10:20.16,Default,,0,0,0,,Хаа~
Dialogue: 0,0:10:21.12,0:10:23.16,Default,,0,0,0,,Балаларға көмектесіңізші
Dialogue: 0,0:10:23.28,0:10:24.74,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:10:25.04,0:10:26.41,Default,,0,0,0,,Иә! (Ауыл тұрғыны Е) Өтінемін
Dialogue: 0,0:10:26.50,0:10:28.75,Default,,0,0,0,,Зоори мырза, сіз сенімдісіз бе?
Dialogue: 0,0:10:28.83,0:10:30.71,Default,,0,0,0,,Өзіммен жас ғалымды алып кетсем ше?
Dialogue: 0,0:10:30.79,0:10:33.25,Default,,0,0,0,,Мен оның кейінірек Қойға қарсылас болатынына сенімдімін.
Dialogue: 0,0:10:33.34,0:10:35.17,Default,,0,0,0,,Жоқ, мен білемін.
Dialogue: 0,0:10:35.38,0:10:36.26,Default,,0,0,0,,Ум...
Dialogue: 0,0:10:36.34,0:10:38.38,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:10:38.88,0:10:40.05,Default,,0,0,0,,(Юки) Бірақ Хори, сен мықтысың ғой, иә? (Хидэ Иура) Һмм…
Dialogue: 0,0:10:40.13,0:10:42.18,Default,,0,0,0,,Маған қалдыр, Чонмед~
Dialogue: 0,0:10:43.05,0:10:44.22,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:44.31,0:10:46.18,Default,,0,0,0,,Барма! (3 адам) Иә?
Dialogue: 0,0:10:47.31,0:10:49.98,Default,,0,0,0,,Мен жалғыз қалғым келмейді!
Dialogue: 0,0:10:50.31,0:10:51.60,Default,,0,0,0,,Дайдобуза
Dialogue: 0,0:10:51.81,0:10:53.98,Default,,0,0,0,,Жанжалдағы Зорори мырза менімен бірге.
Dialogue: 0,0:10:54.07,0:10:55.57,Default,,0,0,0,,Мен дұрыстап қайтамын.
Dialogue: 0,0:10:55.90,0:10:56.90,Default,,0,0,0,,Не!
Dialogue: 0,0:10:56.98,0:10:59.03,Default,,0,0,0,,Сүйкімді қыз болған жоқ па?
Dialogue: 0,0:10:59.11,0:11:01.49,Default,,0,0,0,,Аа~ Ааа~! Ыстық, ыстық
Dialogue: 0,0:11:01.61,0:11:04.41,Default,,0,0,0,,Бұл Койдың қарсыласы кеткенін білдіреді.
Dialogue: 0,0:11:05.24,0:11:06.37,Default,,0,0,0,,Қария!
Dialogue: 0,0:11:07.54,0:11:09.91,Default,,0,0,0,,Мен Рукутты үйге аман-есен жеткізіп беремін.
Dialogue: 0,0:11:10.00,0:11:10.83,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:12.50,0:11:14.25,Default,,0,0,0,,Уайымдамаңыз және күтіңіз!
Dialogue: 0,0:11:16.38,0:11:17.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:18.01,0:11:19.51,Default,,0,0,0,,Сақ болыңыз, иә
Dialogue: 0,0:11:19.59,0:11:20.76,Default,,0,0,0,,Ариус, чуван!
Dialogue: 0,0:11:21.38,0:11:23.05,Default,,0,0,0,,Мен Кёрюге көмектестім.
Dialogue: 0,0:11:23.14,0:11:25.93,Default,,0,0,0,,Мен Джигокудан қалай оралғанымды айттым ба?
Dialogue: 0,0:11:26.31,0:11:27.31,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:27.60,0:11:31.27,Default,,0,0,0,,Ах... эй! мені қалдырма!
Dialogue: 0,0:11:32.06,0:11:34.61,Default,,0,0,0,,Мен де жай демала алмаймын.
Dialogue: 0,0:11:35.02,0:11:37.53,Default,,0,0,0,,Зорири мен басқалары қайтып келгенше
Dialogue: 0,0:11:37.61,0:11:40.15,Default,,0,0,0,,Дәрі жасайтын машина толық жөндеуді қажет етеді.
Dialogue: 0,0:11:40.61,0:11:42.53,Default,,0,0,0,,Біздің де қолымыздан келетін нәрсе болса ше?
Dialogue: 0,0:11:42.61,0:11:43.99,Default,,0,0,0,,Маған бірдеңе айтыңызшы!
Dialogue: 0,0:11:44.07,0:11:45.53,Default,,0,0,0,,Мен де көмектесемін!
Dialogue: 0,0:11:46.53,0:11:48.12,Default,,0,0,0,,Мен де бәрін істеймін!
Dialogue: 0,0:11:48.20,0:11:49.08,Default,,0,0,0,,Мен де істеймін!
Dialogue: 0,0:11:49.54,0:11:50.87,Default,,0,0,0,,Айтыңызшы! Мен бәрін істеймін!
Dialogue: 0,0:11:50.96,0:11:52.75,Default,,0,0,0,,Маған көмектесуге рұқсат етіңіз! Біз жасайық
Dialogue: 0,0:11:52.96,0:11:55.00,Default,,0,0,0,,Мен де! Біз жасайық
Dialogue: 0,0:11:55.58,0:11:56.46,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:11:57.50,0:11:59.88,Default,,0,0,0,,Бұл ересек адамның міндеті.
Dialogue: 0,0:12:08.10,0:12:11.18,Default,,0,0,0,,Уф... бұл қорқынышты.
Dialogue: 0,0:12:11.77,0:12:15.19,Default,,0,0,0,,Бұл аруақтар мен жындар өмір сүретін жер...
Dialogue: 0,0:12:15.86,0:12:18.90,Default,,0,0,0,,Қорқынышты құбыжықты көргені рас.
Dialogue: 0,0:12:18.98,0:12:20.65,Default,,0,0,0,,Мен де әңгімені естідім.
Dialogue: 0,0:12:20.73,0:12:24.45,Default,,0,0,0,,Дегенмен, бұл Гапал тауында болатын жалғыз оқиға емес.
Dialogue: 0,0:12:24.66,0:12:26.20,Default,,0,0,0,,Тағы не бар?
Dialogue: 0,0:12:26.99,0:12:30.33,Default,,0,0,0,,Тауға апаратын жол өте күрделі.
Dialogue: 0,0:12:30.41,0:12:32.46,Default,,0,0,0,,Құбыжықтың шабуылынан гөрі
Dialogue: 0,0:12:32.54,0:12:34.96,Default,,0,0,0,,Мен жолдан адасып, солай істедім.
Dialogue: 0,0:12:35.04,0:12:36.38,Default,,0,0,0,,әлдеқайда көп
Dialogue: 0,0:12:36.88,0:12:38.34,Default,,0,0,0,,Елестер мен құбыжықтар
Dialogue: 0,0:12:38.42,0:12:40.59,Default,,0,0,0,,Мен көп адамдарды білемін, бірақ...
Dialogue: 0,0:12:40.67,0:12:42.09,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:42.30,0:12:44.47,Default,,0,0,0,,Сізге не туралы алаңдау керек?
Dialogue: 0,0:12:44.55,0:12:48.39,Default,,0,0,0,,Мұндағы адам Зоори мырза.
Dialogue: 0,0:12:48.47,0:12:50.47,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:12:50.60,0:12:52.10,Default,,0,0,0,,Келіңіздер! Асықшы!
Dialogue: 0,0:12:52.18,0:12:53.73,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:12:54.60,0:12:56.77,Default,,0,0,0,,Не деген көңілді адам.
Dialogue: 0,0:12:56.85,0:12:58.69,Default,,0,0,0,,Атақты жекпе-жектен күткендей!
Dialogue: 0,0:13:01.36,0:13:02.23,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:13:02.40,0:13:03.24,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:13:03.69,0:13:04.53,Default,,0,0,0,,Гү…
Dialogue: 0,0:13:05.86,0:13:07.11,Default,,0,0,0,,Уау, уау, уау...
Dialogue: 0,0:13:07.36,0:13:08.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:14.83,0:13:15.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:16.33,0:13:17.92,Default,,0,0,0,,Мен қандай да бір дыбысты естимін.
Dialogue: 0,0:13:18.21,0:13:19.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:21.00,0:13:23.38,Default,,0,0,0,,(Zah)
Dialogue: 0,0:13:23.46,0:13:24.84,Default,,0,0,0,,Әй, судың дыбысы!
Dialogue: 0,0:13:26.26,0:13:27.30,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:13:30.76,0:13:34.23,Default,,0,0,0,,Бұл саңырауқұлақ тотықұсқа апаратын жол ма?
Dialogue: 0,0:13:34.31,0:13:36.35,Default,,0,0,0,,Бұл жол ма?
Dialogue: 0,0:13:40.81,0:13:42.36,Default,,0,0,0,,Егер құлап қалсаңыз...
Dialogue: 0,0:13:42.78,0:13:44.94,Default,,0,0,0,,Тіпті біреуі де емес.
Dialogue: 0,0:13:45.44,0:13:47.15,Default,,0,0,0,,Өз өміріңді сақтап қалсаң да
Dialogue: 0,0:13:47.82,0:13:50.66,Default,,0,0,0,,Бұл өзен Ғапапа ауылына дейін жалғасады.
Dialogue: 0,0:13:50.74,0:13:52.95,Default,,0,0,0,,Бірден басына оралыңыз.
Dialogue: 0,0:13:53.33,0:13:54.91,Default,,0,0,0,,Басқа амал жоқ па?
Dialogue: 0,0:13:55.25,0:13:56.46,Default,,0,0,0,,Өкінішке орай...
Dialogue: 0,0:13:57.87,0:14:01.54,Default,,0,0,0,,Менің көзімше... жоқ сияқты.
Dialogue: 0,0:14:02.21,0:14:03.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:04.21,0:14:05.21,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:14:14.06,0:14:16.73,Default,,0,0,0,,Ариус мырза, тез көтеріліңіз.
Dialogue: 0,0:14:16.81,0:14:18.23,Default,,0,0,0,,Бұл дәмді
Dialogue: 0,0:14:18.31,0:14:19.23,Default,,0,0,0,,...
Dialogue: 0,0:14:19.31,0:14:20.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:22.69,0:14:25.07,Default,,0,0,0,,Мен өте аламын ба деп ойлаймын...
Dialogue: 0,0:14:25.15,0:14:27.61,Default,,0,0,0,,Жарайды, өйткені мен сенімен біргемін
Dialogue: 0,0:14:27.70,0:14:30.82,Default,,0,0,0,,Тыныштанып, менімен бірге дем ал.
Dialogue: 0,0:14:30.99,0:14:31.91,Default,,0,0,0,,Не!
Dialogue: 0,0:14:32.03,0:14:33.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:33.33,0:14:34.91,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:14:41.42,0:14:42.25,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:14:43.04,0:14:43.92,Default,,0,0,0,,Кя!
Dialogue: 0,0:14:45.21,0:14:46.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:48.13,0:14:49.80,Default,,0,0,0,,Мүмкін емес Мүмкін емес! Мүлдем мүмкін емес!
Dialogue: 0,0:14:49.88,0:14:51.89,Default,,0,0,0,,Менің аяғым мұздап, қозғала алмаймын.
Dialogue: 0,0:14:51.97,0:14:54.05,Default,,0,0,0,,Мен Зоори мырзаға сенемін.
Dialogue: 0,0:14:54.14,0:14:55.89,Default,,0,0,0,,Екеумізге бутерброд жасап берейік.
Dialogue: 0,0:14:55.97,0:14:57.14,Default,,0,0,0,,Мен сені қорғаймын.
Dialogue: 0,0:14:57.77,0:14:58.60,Default,,0,0,0,,Иә
Dialogue: 0,0:15:00.52,0:15:01.98,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:15:05.52,0:15:06.36,Default,,0,0,0,,Хмф!
Dialogue: 0,0:15:06.61,0:15:07.74,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:07.99,0:15:09.03,Default,,0,0,0,,Міне! Хмф!
Dialogue: 0,0:15:09.53,0:15:10.36,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:15:14.24,0:15:15.66,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:15:15.74,0:15:16.70,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:16.87,0:15:19.46,Default,,0,0,0,,Балалар! Дүрбелең емес, келіңіз!
Dialogue: 0,0:15:19.91,0:15:21.37,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:21.46,0:15:22.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:22.37,0:15:23.71,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:24.00,0:15:26.84,Default,,0,0,0,,Құлап жатыр, құлап жатыр!
Dialogue: 0,0:15:28.80,0:15:29.63,Default,,0,0,0,,Сол кезде мен сендерді ауылдан шығарған кезімде де,
Dialogue: 0,0:15:30.34,0:15:31.51,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:15:32.18,0:15:33.26,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:15:33.97,0:15:35.89,Default,,0,0,0,,Зоори мырза~! Маған көмектесіңізші...
Dialogue: 0,0:15:36.43,0:15:38.31,Default,,0,0,0,,Бар! Тек кел!
Dialogue: 0,0:15:38.93,0:15:40.48,Default,,0,0,0,,Мен онымен айналысамын!
Dialogue: 0,0:15:41.06,0:15:41.98,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:43.02,0:15:45.19,Default,,0,0,0,,Зоори мырза~! Апыр-ай!
Dialogue: 0,0:15:45.27,0:15:46.44,Default,,0,0,0,,А, сәл күте тұрыңыз...
Dialogue: 0,0:15:46.82,0:15:47.65,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:15:48.69,0:15:51.49,Default,,0,0,0,,Міне!
Dialogue: 0,0:15:51.90,0:15:53.24,Default,,0,0,0,,Хекшун!
Dialogue: 0,0:15:55.28,0:15:56.62,Default,,0,0,0,,Уау! О... мені ұста!
Dialogue: 0,0:15:59.50,0:16:00.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:00.62,0:16:02.00,Default,,0,0,0,,Угиджи…
Dialogue: 0,0:16:02.79,0:16:05.63,Default,,0,0,0,,Бұл қорқынышты~ Зорори мырза
Dialogue: 0,0:16:05.71,0:16:07.71,Default,,0,0,0,,Маған көмектесіңізші...
Dialogue: 0,0:16:07.80,0:16:09.42,Default,,0,0,0,,Бұл қымбат!
Dialogue: 0,0:16:10.05,0:16:12.97,Default,,0,0,0,,Гуджиджи! Құйрық, құйрық
Dialogue: 0,0:16:13.18,0:16:14.39,Default,,0,0,0,,Жыртылған...
Dialogue: 0,0:16:14.47,0:16:15.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:15.80,0:16:16.80,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,0:16:16.89,0:16:17.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:17.93,0:16:18.93,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:16:19.01,0:16:21.31,Default,,0,0,0,,Бұл дыбыс
Dialogue: 0,0:16:21.85,0:16:23.85,Default,,0,0,0,,Менің әдемі құйрығым...
Dialogue: 0,0:16:23.94,0:16:25.48,Default,,0,0,0,,(Пуцун Пуцун…)
Dialogue: 0,0:16:25.98,0:16:28.19,Default,,0,0,0,,Зори-сенсэйдің құйрығындағы шаш...
Dialogue: 0,0:16:28.27,0:16:30.61,Default,,0,0,0,,Иппон Нихон
Dialogue: 0,0:16:30.69,0:16:32.03,Default,,0,0,0,,Шииго мырза...
Dialogue: 0,0:16:32.11,0:16:33.78,Default,,0,0,0,,Есепке алмаңыз!
Dialogue: 0,0:16:34.20,0:16:35.41,Default,,0,0,0,,Боқ...
Dialogue: 0,0:16:36.12,0:16:36.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:37.12,0:16:37.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:38.03,0:16:39.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:40.74,0:16:43.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:44.12,0:16:45.54,Default,,0,0,0,,Бәрі сол қарттың кінәсі!
Dialogue: 0,0:16:46.25,0:16:47.13,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:16:48.00,0:16:48.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:49.29,0:16:50.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:50.38,0:16:51.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:51.67,0:16:52.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:52.59,0:16:53.42,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:16:53.88,0:16:55.93,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:16:56.01,0:16:56.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:57.34,0:16:59.68,Default,,0,0,0,,Мұғалім! Бас!
Dialogue: 0,0:17:00.18,0:17:01.52,Default,,0,0,0,,Иә? бас?
Dialogue: 0,0:17:02.02,0:17:03.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:04.94,0:17:05.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:06.06,0:17:07.48,Default,,0,0,0,,Взвод мүшелерінің бір-бірімен шайқасуына болмайды!
Dialogue: 0,0:17:28.54,0:17:29.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:29.59,0:17:32.30,Default,,0,0,0,,Мен өте бақыттымын!
Dialogue: 0,0:17:32.71,0:17:36.01,Default,,0,0,0,,Керемет! Зори-сан, сәттілік сенің жаныңда, солай емес пе?
Dialogue: 0,0:17:36.34,0:17:38.18,Default,,0,0,0,,Зоори мырза...
Dialogue: 0,0:17:38.39,0:17:40.14,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:40.22,0:17:41.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:41.18,0:17:42.22,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:42.31,0:17:45.14,Default,,0,0,0,,Дәл қазір қызыл нәрсе бар...
Dialogue: 0,0:17:46.64,0:17:48.10,Default,,0,0,0,,Онда ештеңе жоқ па?
Dialogue: 0,0:17:48.19,0:17:49.02,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:50.90,0:17:51.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:53.07,0:17:55.65,Default,,0,0,0,,Хаа... Ақыры жеттім.
Dialogue: 0,0:17:57.15,0:17:58.24,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:17:58.32,0:17:59.87,Default,,0,0,0,,Алға жол жоқ!
Dialogue: 0,0:18:00.53,0:18:01.70,Default,,0,0,0,,Не?
Dialogue: 0,0:18:02.41,0:18:04.20,Default,,0,0,0,,Иә... бұл рас.
Dialogue: 0,0:18:04.37,0:18:06.46,Default,,0,0,0,,Осы жерге жету үшін көп еңбектенсем де...
Dialogue: 0,0:18:08.29,0:18:09.58,Default,,0,0,0,,Хаа... (Хью)
Dialogue: 0,0:18:09.67,0:18:12.46,Default,,0,0,0,,Ах! Салқын, жел жақсы
Dialogue: 0,0:18:12.54,0:18:15.42,Default,,0,0,0,,Менің бөксем шаншып, өзін жақсы сезінеді.
Dialogue: 0,0:18:15.51,0:18:16.84,Default,,0,0,0,,Хаха, біз келдік!
Dialogue: 0,0:18:17.13,0:18:18.97,Default,,0,0,0,,Біз оны таптық! Біраз...
Dialogue: 0,0:18:19.05,0:18:20.18,Default,,0,0,0,,Жел?
Dialogue: 0,0:18:20.97,0:18:22.97,Default,,0,0,0,,Ммм...
Dialogue: 0,0:18:23.06,0:18:23.89,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:18:24.43,0:18:25.64,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:18:25.89,0:18:28.48,Default,,0,0,0,,Бұл жер бос жер.
Dialogue: 0,0:18:28.81,0:18:31.65,Default,,0,0,0,,Оның үстіне саңылаудың арғы жағында бірдеңе жарқырап тұрды...
Dialogue: 0,0:18:31.73,0:18:32.90,Default,,0,0,0,,Не?
Dialogue: 0,0:18:34.90,0:18:35.73,Default,,0,0,0,,Шынында да...
Dialogue: 0,0:18:36.32,0:18:37.99,Default,,0,0,0,,Бәрің маған көмектесіңдерші.
Dialogue: 0,0:18:39.20,0:18:41.62,Default,,0,0,0,,Мына қабырғаны бұзып, әрі қарай жүр!
Dialogue: 0,0:18:42.07,0:18:43.74,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:18:44.91,0:18:45.74,Default,,0,0,0,,Хмм…
Dialogue: 0,0:18:46.25,0:18:47.91,Default,,0,0,0,,Ей! сәуле!
Dialogue: 0,0:18:49.00,0:18:51.25,Default,,0,0,0,,Иә, иә, иә...
Dialogue: 0,0:18:51.83,0:18:53.34,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:18:55.84,0:18:56.96,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:58.01,0:18:59.17,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:18:59.80,0:19:00.63,Default,,0,0,0,,Аха!
Dialogue: 0,0:19:00.72,0:19:01.55,Default,,0,0,0,,Оча!
Dialogue: 0,0:19:01.64,0:19:03.05,Default,,0,0,0,,Генмайча!
Dialogue: 0,0:19:03.80,0:19:05.22,Default,,0,0,0,,Ыстық...
Dialogue: 0,0:19:07.77,0:19:09.85,Default,,0,0,0,,Сіз қозғалмайсыз.
Dialogue: 0,0:19:11.19,0:19:14.69,Default,,0,0,0,,Мен суық тиген сияқтымын.
Dialogue: 0,0:19:14.77,0:19:17.07,Default,,0,0,0,,Осындай сәттерде мен бар күшімді саламын.
Dialogue: 0,0:19:17.15,0:19:18.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:18.40,0:19:19.32,Default,,0,0,0,,Не?
Dialogue: 0,0:19:21.49,0:19:22.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:23.62,0:19:24.95,Default,,0,0,0,,О!
Dialogue: 0,0:19:25.08,0:19:27.24,Default,,0,0,0,,Мен оны кім жоғалтқанын білмеймін.
Dialogue: 0,0:19:27.33,0:19:29.58,Default,,0,0,0,,Мен оны біраз уақытқа қарызға аламын.
Dialogue: 0,0:19:30.33,0:19:34.04,Default,,0,0,0,,Барлығы~ Осындай бірдеңе шығып кетті.
Dialogue: 0,0:19:35.54,0:19:36.38,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:36.67,0:19:38.59,Default,,0,0,0,,О! Қабан үлкен
Dialogue: 0,0:19:38.67,0:19:39.51,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:39.59,0:19:41.72,Default,,0,0,0,,Мен болсаң, бақыттысың!
Dialogue: 0,0:19:42.26,0:19:44.55,Default,,0,0,0,,Біраз уақытқа қарызға алайық.
Dialogue: 0,0:19:56.11,0:19:57.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:57.19,0:19:58.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:59.40,0:20:01.82,Default,,0,0,0,,Мен бұл жерде ме деп ойлаймын...
Dialogue: 0,0:20:02.32,0:20:03.74,Default,,0,0,0,,Иә? Бұл...
Dialogue: 0,0:20:05.57,0:20:07.45,Default,,0,0,0,,Ах! Онда не жарқырайды
Dialogue: 0,0:20:08.49,0:20:10.70,Default,,0,0,0,,Бұл күлгін тас екені сөзсіз!
Dialogue: 0,0:20:10.79,0:20:11.83,Default,,0,0,0,,Шынымен бе? иә!
Dialogue: 0,0:20:12.41,0:20:13.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:13.71,0:20:14.79,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:20:14.88,0:20:15.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:16.34,0:20:19.09,Default,,0,0,0,,Аяқ киімнің артында бірдеңе жарқырап тұр.
Dialogue: 0,0:20:19.17,0:20:20.05,Default,,0,0,0,,Не?
Dialogue: 0,0:20:21.34,0:20:23.68,Default,,0,0,0,,Мүмкін... Пиккаригоке?
Dialogue: 0,0:20:24.34,0:20:25.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:25.80,0:20:28.72,Default,,0,0,0,,Мен бұл жерден ештеңе айта алмаймын.
Dialogue: 0,0:20:28.85,0:20:30.93,Default,,0,0,0,,Мен сізге жақындауыңызды сұрауым керек.
Dialogue: 0,0:20:31.02,0:20:32.06,Default,,0,0,0,,Олай болса, бірден
Dialogue: 0,0:20:32.14,0:20:33.27,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:20:35.35,0:20:37.44,Default,,0,0,0,,Бір уақытта екі элементті алуға болады.
Dialogue: 0,0:20:37.52,0:20:39.78,Default,,0,0,0,,Бұл тамаша мүмкіндік болуы мүмкін.
Dialogue: 0,0:20:39.86,0:20:43.40,Default,,0,0,0,,Екіге бөлініп, уақытты үнемдейік!
Dialogue: 0,0:20:43.49,0:20:45.03,Default,,0,0,0,,Бұл жақсы идея
Dialogue: 0,0:20:45.11,0:20:46.99,Default,,0,0,0,,Енді мен және ағам төменде...
Dialogue: 0,0:20:47.07,0:20:47.91,Default,,0,0,0,,Басқаша!
Dialogue: 0,0:20:48.41,0:20:50.29,Default,,0,0,0,,Жоқ, жоқ! Солай емес пе!
Dialogue: 0,0:20:50.66,0:20:51.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:51.58,0:20:55.62,Default,,0,0,0,,Лукуто Ишиши Ношишиді алып, жоғарыдағы Күлгін тасқа барады!
Dialogue: 0,0:20:55.75,0:20:57.71,Default,,0,0,0,,Сонымен мен және Ариус-чан
Dialogue: 0,0:20:57.79,0:21:00.17,Default,,0,0,0,,Төмен түсіп, бар мүкті алыңыз.
Dialogue: 0,0:21:01.13,0:21:04.38,Default,,0,0,0,,Толық тәртіпсіздік бар-жоғын кейінірек тексеруге болады.
Dialogue: 0,0:21:04.47,0:21:08.64,Default,,0,0,0,,Жоқ, одан да нақтырақ нәрсе сұраған дұрыс болар еді...
Dialogue: 0,0:21:08.72,0:21:10.60,Default,,0,0,0,,Зорори-сенсейін мұғалім ғана түсіне алады.
Dialogue: 0,0:21:10.68,0:21:12.35,Default,,0,0,0,,Менде терең ойлар бар!
Dialogue: 0,0:21:12.43,0:21:13.93,Default,,0,0,0,,Саса, өзіміз барып аламыз.
Dialogue: 0,0:21:14.02,0:21:14.85,Default,,0,0,0,,Не? Не? Не?
Dialogue: 0,0:21:15.02,0:21:16.94,Default,,0,0,0,,А, а... түсіндім.
Dialogue: 0,0:21:18.23,0:21:20.77,Default,,0,0,0,,Олай болса, ақсақал, сақ болыңыз.
Dialogue: 0,0:21:20.86,0:21:21.69,Default,,0,0,0,,Иә
Dialogue: 0,0:21:22.82,0:21:26.45,Default,,0,0,0,,Мен сіздің терең ойларыңызды тыңдағым келеді, Зорори мырза.
Dialogue: 0,0:21:26.53,0:21:27.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:27.45,0:21:30.49,Default,,0,0,0,,Жоқ, жақсы... мен не айта аламын?
Dialogue: 0,0:21:30.83,0:21:33.16,Default,,0,0,0,,Аман-есен оралсақ, жай сөйлесейік.
Dialogue: 0,0:21:33.25,0:21:36.25,Default,,0,0,0,,Қазір бәрі бар.
Dialogue: 0,0:21:36.33,0:21:38.83,Default,,0,0,0,,Аа... дұрыс.
Dialogue: 0,0:21:38.92,0:21:40.42,Default,,0,0,0,,Кеттік, иә!
Dialogue: 0,0:21:41.59,0:21:42.75,Default,,0,0,0,,Шын мәнінде...
Dialogue: 0,0:21:42.84,0:21:45.34,Default,,0,0,0,,Өйткені мен Ариус-чанмен жалғыз қалғым келеді.
Dialogue: 0,0:21:45.42,0:21:48.34,Default,,0,0,0,,Айтқым келсе де айта алмаймын...
Dialogue: 0,0:21:49.09,0:21:50.10,Default,,0,0,0,,Зоори мырза?
Dialogue: 0,0:21:50.18,0:21:51.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:51.10,0:21:52.93,Default,,0,0,0,,Кеттік! иә! Барайық!
Dialogue: 0,0:21:53.31,0:21:54.14,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:21:55.77,0:21:58.69,Default,,0,0,0,,Жақсысың ба? Абайлаңыз, аяқтарыңыз тайғақ болуы мүмкін
Dialogue: 0,0:21:59.35,0:22:01.19,Default,,0,0,0,,Бір күні тозаққа түсіп кетермін.
Dialogue: 0,0:22:01.65,0:22:02.61,Default,,0,0,0,,Аа...
Dialogue: 0,0:22:04.57,0:22:06.99,Default,,0,0,0,,Бұл біртүрлі, мен оны таба алмаймын.
Dialogue: 0,0:22:07.07,0:22:08.86,Default,,0,0,0,,Қызық, не жарқырап тұрды?
Dialogue: 0,0:22:13.12,0:22:14.87,Default,,0,0,0,,Мен осылай қарасам,
Dialogue: 0,0:22:14.95,0:22:18.92,Default,,0,0,0,,Жарқыраған күн сәулесі екі адамға бата беретін часовня іспетті...
Dialogue: 0,0:22:19.00,0:22:21.13,Default,,0,0,0,,А, бұл... иә?
Dialogue: 0,0:22:23.17,0:22:24.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:25.17,0:22:28.34,Default,,0,0,0,,Уккио! Мен өте бақыттымын
Dialogue: 0,0:22:28.47,0:22:30.72,Default,,0,0,0,,Үш қорап бар!
Dialogue: 0,0:22:31.18,0:22:33.01,Default,,0,0,0,,Сізге тек Зориджомо қажет
Dialogue: 0,0:22:33.10,0:22:36.10,Default,,0,0,0,,Ариуспен бәсекелестік жеткілікті!
Dialogue: 0,0:22:36.48,0:22:38.10,Default,,0,0,0,,Көңіл қалды...
Dialogue: 0,0:22:39.27,0:22:40.35,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:22:40.44,0:22:42.31,Default,,0,0,0,,Бұл толық тәртіпсіздік емес еді.
Dialogue: 0,0:22:42.40,0:22:43.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:43.36,0:22:45.98,Default,,0,0,0,,Енді біз басына оралдық.
Dialogue: 0,0:22:46.40,0:22:49.03,Default,,0,0,0,,А, не...
Dialogue: 0,0:22:49.11,0:22:51.32,Default,,0,0,0,,Бұл, әрине, толық сәтсіздік емес еді.
Dialogue: 0,0:22:51.41,0:22:53.28,Default,,0,0,0,,Дұрыстап іздесеңіз
Dialogue: 0,0:22:53.37,0:22:57.54,Default,,0,0,0,,Бұл сыйлық мүлдем пайдасыз сияқты емес...
Dialogue: 0,0:22:57.62,0:22:58.79,Default,,0,0,0,,(Бум!)
Dialogue: 0,0:23:03.96,0:23:05.42,Default,,0,0,0,,Не? Бұл кішкентай
Dialogue: 0,0:23:06.05,0:23:08.51,Default,,0,0,0,,Мені тапқаныңызға рахмет
Dialogue: 0,0:23:08.72,0:23:11.13,Default,,0,0,0,,Мені тастарды қыру қиындығынан құтқарды
Dialogue: 0,0:23:11.43,0:23:13.26,Default,,0,0,0,,Сонымен, сіз бұл жаттығуды жасадыңыз ба?
Dialogue: 0,0:23:13.85,0:23:16.81,Default,,0,0,0,,Оны кім қойғаны маңызды емес, солай ма?
Dialogue: 0,0:23:16.89,0:23:18.48,Default,,0,0,0,,Ал мына ана
Dialogue: 0,0:23:18.56,0:23:20.73,Default,,0,0,0,,Балалар, іздеп жүргендерің осы емес пе?
Dialogue: 0,0:23:20.81,0:23:22.15,Default,,0,0,0,,Ақылсыз сөз айтпа...
Dialogue: 0,0:23:22.48,0:23:23.31,Default,,0,0,0,,Әрине!
Dialogue: 0,0:23:23.73,0:23:24.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:26.36,0:23:29.11,Default,,0,0,0,,Балалардың ауруын емдеу үшін не істеу керек
Dialogue: 0,0:23:29.19,0:23:30.65,Default,,0,0,0,,Пайдасыз
Dialogue: 0,0:23:30.74,0:23:31.74,Default,,0,0,0,,Қоқыс!
Dialogue: 0,0:23:32.86,0:23:34.66,Default,,0,0,0,,Дұрыс? Зори-сан
Dialogue: 0,0:23:34.83,0:23:37.37,Default,,0,0,0,,А... әрине.
Dialogue: 0,0:23:37.54,0:23:39.33,Default,,0,0,0,,Бірақ егер сол адам—
Dialogue: 0,0:23:40.04,0:23:41.50,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:23:41.62,0:23:43.21,Default,,0,0,0,,Мен сененмін
Dialogue: 0,0:23:43.29,0:23:45.59,Default,,0,0,0,,Бір қызық боламыз делік.
Dialogue: 0,0:23:47.50,0:23:48.88,Default,,0,0,0,,Зоронд Рон!
Dialogue: 0,0:23:48.96,0:23:51.01,Default,,0,0,0,,Иә? Ол адам?
Dialogue: 0,0:23:51.09,0:23:52.38,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:23:52.47,0:23:54.64,Default,,0,0,0,,Онымен бірге алып жүретініңізге сенімдісіз бе?
Dialogue: 0,0:23:54.72,0:23:58.22,Default,,0,0,0,,Осындай кішкентай денемен сіз ең көбі бір ғана затты алып жүре аласыз.
Dialogue: 0,0:23:58.85,0:23:59.81,Default,,0,0,0,,Әй!
Dialogue: 0,0:24:00.02,0:24:01.43,Default,,0,0,0,,Иә! Хмф!
Dialogue: 0,0:24:04.06,0:24:06.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:06.61,0:24:07.44,Default,,0,0,0,,Вакуум!
Dialogue: 0,0:24:12.45,0:24:13.28,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:24:13.95,0:24:16.07,Default,,0,0,0,,Уау! Сен не істеп жатырсың?
Dialogue: 0,0:24:16.87,0:24:17.87,Default,,0,0,0,,Моттайнай...
Dialogue: 0,0:24:17.95,0:24:19.58,Default,,0,0,0,,Ах... (Бочан!)
Dialogue: 0,0:24:20.33,0:24:21.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:22.04,0:24:24.08,Default,,0,0,0,,Сіз қалай батылсыз
Dialogue: 0,0:24:24.50,0:24:26.08,Default,,0,0,0,,Соңында мен саған жақсы нәрсе айтайын.
Dialogue: 0,0:24:27.17,0:24:30.21,Default,,0,0,0,,Тас көпірдің артында не жарқырап тұр
Dialogue: 0,0:24:30.92,0:24:33.68,Default,,0,0,0,,Бұл дәл сіз іздеген нәрсе.
Dialogue: 0,0:24:34.18,0:24:36.97,Default,,0,0,0,,Бұл жарық мүлдем бос болды...
Dialogue: 0,0:24:37.30,0:24:38.68,Default,,0,0,0,,Жеңіліс пен сәтсіздіктің ащылығын татып, жараланасың—
Dialogue: 0,0:24:39.89,0:24:43.27,Default,,0,0,0,,Бірақ бұл балаларды құтқара алады.
Dialogue: 0,0:24:43.60,0:24:45.52,Default,,0,0,0,,Зоронд Ронға рахмет.
Dialogue: 0,0:24:45.81,0:24:47.40,Default,,0,0,0,,Дұрыс па? Зори-сан
Dialogue: 0,0:24:47.69,0:24:50.90,Default,,0,0,0,,Аха... ахахха
Dialogue: 0,0:24:51.32,0:24:52.15,Default,,0,0,0,,Куку кукукуку…
Dialogue: 0,0:24:52.49,0:24:53.65,Default,,0,0,0,,Гррр…
Dialogue: 0,0:24:53.86,0:24:55.20,Default,,0,0,0,,Зоори мырза
Dialogue: 0,0:24:55.66,0:24:58.99,Default,,0,0,0,,Енді тезірек кірді тазалап алайық!
Dialogue: 0,0:24:59.08,0:25:00.54,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:25:03.16,0:25:04.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:08.13,0:25:12.21,Default,,0,0,0,,Бұларға толы рюкзактарды жинауға біраз уақыт керек сияқты.
Dialogue: 0,0:25:12.34,0:25:14.55,Default,,0,0,0,,Сәттілік, Зори-сан!
Dialogue: 0,0:25:15.51,0:25:16.76,Default,,0,0,0,,Иә
Dialogue: 0,0:25:16.84,0:25:20.60,Default,,0,0,0,,Менің жолым болуы керек еді...
Dialogue: 0,0:25:22.81,0:25:25.02,Default,,0,0,0,,Иә? Бұл әкенің...
Dialogue: 0,0:25:26.48,0:25:27.81,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,0:25:27.90,0:25:28.81,Default,,0,0,0,,Э? Не? Мен тыңдамаппын.
Dialogue: 0,0:25:29.19,0:25:30.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:30.86,0:25:32.40,Default,,0,0,0,,Уф... аа!
Dialogue: 0,0:25:32.73,0:25:33.74,Default,,0,0,0,,Кяаааа! Уау...
Dialogue: 0,0:25:35.28,0:25:36.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:38.49,0:25:39.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:39.57,0:25:41.87,Default,,0,0,0,,Неге екенін білмеймін, бірақ маған көмектесті.
Dialogue: 0,0:25:41.95,0:25:44.45,Default,,0,0,0,,Зоори мырза, сіз не нәрсеге таң қалдыңыз?
Dialogue: 0,0:25:44.96,0:25:46.41,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:25:46.58,0:25:50.46,Default,,0,0,0,,Бұрын әлгі біртүрлі робот тепкен қазына қорабын.
Dialogue: 0,0:25:50.54,0:25:53.13,Default,,0,0,0,,Ол қызыл ұшақта ілулі тұрды.
Dialogue: 0,0:25:53.42,0:25:55.97,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:25:56.05,0:25:57.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:57.09,0:25:57.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:58.59,0:25:59.43,Default,,0,0,0,,(Миямура) Ә? Онда, бәлкім, бұл Иура-кунге қайтаруды ұмытып қалған дискім шығар…
Dialogue: 0,0:26:03.35,0:26:05.73,Default,,0,0,0,,Уау! Нанана... О, құдай!
Dialogue: 0,0:26:05.81,0:26:07.89,Default,,0,0,0,,Бұл үлкен өрмекшінің ұясы ма?
Dialogue: 0,0:26:07.98,0:26:10.73,Default,,0,0,0,,Осы уақытқа дейін қорапқа қол тиген жоқ.
Dialogue: 0,0:26:10.81,0:26:12.61,Default,,0,0,0,,Сол алып өрмекшіге байланысты болды.
Dialogue: 0,0:26:12.69,0:26:14.53,Default,,0,0,0,,Және... Әйтеуір, Нигеро!
Dialogue: 0,0:26:16.49,0:26:18.82,Default,,0,0,0,,Жіп үзілмейді...
Dialogue: 0,0:26:19.49,0:26:21.12,Default,,0,0,0,,Сәттілік Ариус
Dialogue: 0,0:26:22.62,0:26:23.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:26:24.20,0:26:26.91,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:26:27.91,0:26:28.75,Default,,0,0,0,,Ааах…
Dialogue: 0,0:26:28.83,0:26:31.96,Default,,0,0,0,,Мен үшін бақытсыз!
Dialogue: 0,0:26:40.01,0:26:42.35,Default,,0,0,0,,Міне! Шынымен күлгін тас
Dialogue: 0,0:26:42.68,0:26:43.76,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:26:43.85,0:26:45.72,Default,,0,0,0,,Мен оны бірден бұрғымен қазып аламын.
Dialogue: 0,0:26:46.89,0:26:48.56,Default,,0,0,0,,Уау! А... бұл қауіпті
Dialogue: 0,0:26:49.69,0:26:51.56,Default,,0,0,0,,Бұл жолы қауіпті
Dialogue: 0,0:26:54.11,0:26:55.57,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:26:55.69,0:26:57.90,Default,,0,0,0,,Ұзақ шыдай алмайды
Dialogue: 0,0:26:58.24,0:27:00.66,Default,,0,0,0,,Ол маған қандай да бір жолмен көмектескенін айтты...
Dialogue: 0,0:27:01.11,0:27:03.62,Default,,0,0,0,,(Пуо~цу)
Dialogue: 0,0:27:04.87,0:27:05.70,Default,,0,0,0,,Бұл осар!
Dialogue: 0,0:27:06.12,0:27:06.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:07.04,0:27:09.25,Default,,0,0,0,,Лукто ақылды, солай ма?
Dialogue: 0,0:27:09.33,0:27:11.88,Default,,0,0,0,,Бұл тасты жүк пойызына отырғызу үшін
Dialogue: 0,0:27:11.96,0:27:14.88,Default,,0,0,0,,Қандай бұрышпен және қандай күшпен итеріп шығару керек?
Dialogue: 0,0:27:14.96,0:27:16.76,Default,,0,0,0,,Мен оны есептеп көргім келеді.
Dialogue: 0,0:27:16.88,0:27:20.97,Default,,0,0,0,,Мен есептеулерді жасай аламын, бірақ бұл өте жалықтыратын тапсырма...
Dialogue: 0,0:27:21.05,0:27:22.76,Default,,0,0,0,,Уақытымыз таусылып жатыр
Dialogue: 0,0:27:22.84,0:27:23.72,Default,,0,0,0,,Жүр, асығыңыз!
Dialogue: 0,0:27:24.72,0:27:25.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:26.01,0:27:27.68,Default,,0,0,0,,Ух... түсіндім.
Dialogue: 0,0:27:29.48,0:27:31.94,Default,,0,0,0,,Осысақ, бәріміз жоқ боламыз!
Dialogue: 0,0:27:32.02,0:27:35.36,Default,,0,0,0,,Ал, осы жерден 45 градус бұрышта.
Dialogue: 0,0:27:35.44,0:27:37.65,Default,,0,0,0,,Ал, мен оны үлкен қағаз машинасына жаздым.
Dialogue: 0,0:27:37.73,0:27:40.40,Default,,0,0,0,,80… Жоқ. Бізге 82 бірлік керек пе?
Dialogue: 0,0:27:41.40,0:27:42.99,Default,,0,0,0,,Лукут Әлі емес пе?
Dialogue: 0,0:27:43.74,0:27:48.12,Default,,0,0,0,,Бағыт 10-ға қарай, бірақ пойыздың жылдамдығын ескере отырып...
Dialogue: 0,0:27:48.29,0:27:49.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:51.75,0:27:53.21,Default,,0,0,0,,Уайымдама...
Dialogue: 0,0:27:53.33,0:27:54.83,Default,,0,0,0,,Ең алдымен ауа ағыны туралы ойлануымыз керек...
Dialogue: 0,0:27:54.92,0:27:56.17,Default,,0,0,0,,(Ооо!)
Dialogue: 0,0:27:56.71,0:27:58.46,Default,,0,0,0,,Уау! (2 адам) Хаа...
Dialogue: 0,0:27:58.67,0:27:59.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:00.76,0:28:01.93,Default,,0,0,0,,Әй, кетті!
Dialogue: 0,0:28:02.01,0:28:04.22,Default,,0,0,0,,Лукто да желдей ұшып кетті!
Dialogue: 0,0:28:04.30,0:28:05.93,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:28:06.01,0:28:06.85,Default,,0,0,0,,Хаа…
Dialogue: 0,0:28:06.93,0:28:07.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:08.22,0:28:10.27,Default,,0,0,0,,Менің басым айналады...
Dialogue: 0,0:28:10.35,0:28:11.52,Default,,0,0,0,,Ишиши?
Dialogue: 0,0:28:11.60,0:28:15.44,Default,,0,0,0,,Ойлап қарасам, мектепте түшкірдім.
Dialogue: 0,0:28:15.86,0:28:18.53,Default,,0,0,0,,Бірақ ол ауру тек балаларда...
Dialogue: 0,0:28:18.73,0:28:20.86,Default,,0,0,0,,Онда неге...
Dialogue: 0,0:28:20.94,0:28:21.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:23.91,0:28:26.45,Default,,0,0,0,,Ишиши~!
Dialogue: 0,0:28:28.87,0:28:30.75,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:28:31.04,0:28:32.04,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааа!
Dialogue: 0,0:28:32.37,0:28:35.00,Default,,0,0,0,,Ишиши! Ишиши~!
Dialogue: 0,0:28:35.08,0:28:36.38,Default,,0,0,0,,Иә? Қабан?
Dialogue: 0,0:28:36.46,0:28:37.96,Default,,0,0,0,,Не қызық?
Dialogue: 0,0:28:38.04,0:28:41.63,Default,,0,0,0,,Мм... Дұрыс, көру керек.
Dialogue: 0,0:28:43.84,0:28:45.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:45.68,0:28:47.72,Default,,0,0,0,,Тоқта! Тоқта! (Сахна жасаңыз!)
Dialogue: 0,0:28:50.77,0:28:53.02,Default,,0,0,0,,Гү…
Dialogue: 0,0:28:53.39,0:28:54.73,Default,,0,0,0,,(Үлкен өрмекшінің айқайы)
Dialogue: 0,0:28:54.98,0:28:56.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:59.27,0:29:00.11,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:29:01.99,0:29:05.03,Default,,0,0,0,,А... бұл өте ақылсыз!
Dialogue: 0,0:29:12.91,0:29:14.79,Default,,0,0,0,,Ношишикикку!
Dialogue: 0,0:29:15.00,0:29:17.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:29:19.71,0:29:21.46,Default,,0,0,0,,Шеңбер бойымен жүр!
Dialogue: 0,0:29:21.71,0:29:23.26,Default,,0,0,0,,Менің көзім айналады!
Dialogue: 0,0:29:29.47,0:29:32.06,Default,,0,0,0,,Таки~!
Dialogue: 0,0:29:37.48,0:29:40.65,Default,,0,0,0,,Жарайды, оянсам қиын болар еді.
Dialogue: 0,0:29:40.73,0:29:43.69,Default,,0,0,0,,Өрмекші жастық болып, мен құтқарылдым.
Dialogue: 0,0:29:44.07,0:29:47.28,Default,,0,0,0,,Бұл мен көрген бірінші үлкен нәрсеге байланысты болды.
Dialogue: 0,0:29:47.36,0:29:50.53,Default,,0,0,0,,Ондай жағдайда тек өзен ағынымен жүре бер.
Dialogue: 0,0:29:50.62,0:29:52.33,Default,,0,0,0,,Ғапапа ауылына да оралуға болады.
Dialogue: 0,0:29:52.83,0:29:54.70,Default,,0,0,0,,Иә, түсіндім!
Dialogue: 0,0:29:54.79,0:29:55.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:55.71,0:29:59.21,Default,,0,0,0,,Неліктен Зоронд Рон қорапты тастады?
Dialogue: 0,0:30:01.17,0:30:03.71,Default,,0,0,0,,Ол қорапты тепсе де,
Dialogue: 0,0:30:04.09,0:30:07.22,Default,,0,0,0,,Мен оның осында жуылатынын білдім.
Dialogue: 0,0:30:07.97,0:30:09.76,Default,,0,0,0,,Сол жерде күте тұрыңыз.
Dialogue: 0,0:30:09.84,0:30:13.72,Default,,0,0,0,,Шыққан сөмкені ұшақпен алып кетті.
Dialogue: 0,0:30:14.06,0:30:15.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:30:15.35,0:30:18.14,Default,,0,0,0,,Бірақ мені бір ғана нәрсе мазалайды.
Dialogue: 0,0:30:19.31,0:30:22.23,Default,,0,0,0,,Бұл папаның қызыл ұшағына ұқсады.
Dialogue: 0,0:30:22.94,0:30:25.07,Default,,0,0,0,,Неліктен Зоронд Рон бұлай істеді?
Dialogue: 0,0:30:25.49,0:30:28.74,Default,,0,0,0,,Таки қайтадан?
Dialogue: 0,0:30:34.74,0:30:35.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:37.04,0:30:37.91,Default,,0,0,0,,Хмм…
Dialogue: 0,0:30:39.42,0:30:40.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:30:40.46,0:30:43.55,Default,,0,0,0,,Е! Эхх! Эхх!
Dialogue: 0,0:30:44.88,0:30:47.63,Default,,0,0,0,,О! Ариус Зори
Dialogue: 0,0:30:47.76,0:30:48.97,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,0:30:51.68,0:30:54.43,Default,,0,0,0,,Хаа... бүкіл денем жабысқақ.
Dialogue: 0,0:30:55.14,0:30:56.98,Default,,0,0,0,,Құйрығы да қысылады
Dialogue: 0,0:30:57.14,0:30:58.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:30:59.52,0:31:01.60,Default,,0,0,0,,Бұл мүлдем жеткіліксіз.
Dialogue: 0,0:31:01.90,0:31:02.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:02.98,0:31:05.36,Default,,0,0,0,,Сен тағы сол тауға қайтасың ба?
Dialogue: 0,0:31:05.44,0:31:06.99,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:31:07.36,0:31:09.53,Default,,0,0,0,,Өрмекшінің торында көп нәрсе кептеліп қалған.
Dialogue: 0,0:31:10.41,0:31:12.57,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:31:12.66,0:31:13.58,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:31:14.37,0:31:17.62,Default,,0,0,0,,Өрмекші торы ханымнан босатылған кезде, ол оған жабысып қалды.
Dialogue: 0,0:31:17.91,0:31:20.12,Default,,0,0,0,,Бұл тас пен қабан.
Dialogue: 0,0:31:20.21,0:31:21.25,Default,,0,0,0,,Хехехе!
Dialogue: 0,0:31:21.33,0:31:24.17,Default,,0,0,0,,Зорори-сенсейдің мені мақтағанына қуаныштымын.
Dialogue: 0,0:31:24.38,0:31:25.21,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:31:27.84,0:31:32.01,Default,,0,0,0,,Доктор Мурроу: Қандай да бір себептермен Ишиши ауырып қалды.
Dialogue: 0,0:31:32.26,0:31:33.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:33.18,0:31:35.64,Default,,0,0,0,,Дәрі-дәрмекті тез жасауыңызды қалаймын!
Dialogue: 0,0:31:36.26,0:31:37.31,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:31:37.43,0:31:40.27,Default,,0,0,0,,-де басқа материал, күлгін тас болып табылады
Dialogue: 0,0:31:40.35,0:31:41.31,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:31:41.64,0:31:42.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:42.56,0:31:44.23,Default,,0,0,0,,Ах! Бұл Лукут!
Dialogue: 0,0:31:44.31,0:31:46.61,Default,,0,0,0,,Мен Луктоны мүлдем ұмытып кеттім!
Dialogue: 0,0:31:46.69,0:31:48.19,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:31:48.28,0:31:49.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:50.03,0:31:52.78,Default,,0,0,0,,Біз бірге емеспіз бе? Лукто қайда?
Dialogue: 0,0:31:53.16,0:31:56.03,Default,,0,0,0,,Бұл... біз Күлгін таспен біргеміз.
Dialogue: 0,0:31:56.12,0:31:59.75,Default,,0,0,0,,Мен оны лүпілмен ұшырып жібергенім есімде...
Dialogue: 0,0:32:00.96,0:32:03.17,Default,,0,0,0,,Сіз оны осіретпен үрдіңіз бе?
Dialogue: 0,0:32:03.25,0:32:04.25,Default,,0,0,0,,Қандай сұмдық...
Dialogue: 0,0:32:05.13,0:32:06.34,Default,,0,0,0,,Уау! О, жоқ...
Dialogue: 0,0:32:06.42,0:32:09.46,Default,,0,0,0,,Ол жай ғана ұшып кеткен жоқ, Джижо...
Dialogue: 0,0:32:09.55,0:32:10.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:17.14,0:32:18.89,Default,,0,0,0,,Эй!
Dialogue: 0,0:32:20.31,0:32:22.85,Default,,0,0,0,,Күлгін тасты жақсы алып жүрдің.
Dialogue: 0,0:32:22.94,0:32:24.56,Default,,0,0,0,,...
Dialogue: 0,0:32:24.65,0:32:26.77,Default,,0,0,0,,Лукто Аман-есен болғаныңызға қуаныштымын.
Dialogue: 0,0:32:27.40,0:32:31.15,Default,,0,0,0,,Қаншама халықтың көзінше бір-бірімізбен осылай ашық күресеміз?
Dialogue: 0,0:32:31.24,0:32:32.40,Default,,0,0,0,,Құдай-ау, ыстық, ыстық
Dialogue: 0,0:32:32.49,0:32:33.91,Default,,0,0,0,,Жоқ, иә?
Dialogue: 0,0:32:34.70,0:32:36.95,Default,,0,0,0,,Енді сізде барлық материалдар бар
Dialogue: 0,0:32:37.41,0:32:40.87,Default,,0,0,0,,Келіңіздер! Біз дәрі-дәрмекті мүмкіндігінше тезірек аяқтауымыз керек.
Dialogue: 0,0:32:41.41,0:32:42.54,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:32:43.12,0:32:45.71,Default,,0,0,0,,Не, жақсы машина бар, солай емес пе?
Dialogue: 0,0:32:45.79,0:32:46.67,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:32:47.17,0:32:49.67,Default,,0,0,0,,Барлығы кеткен соң, доктор Маллоу
Dialogue: 0,0:32:49.75,0:32:52.17,Default,,0,0,0,,Оны құрастыру үшін көп еңбек еттіңіз.
Dialogue: 0,0:32:52.51,0:32:55.39,Default,,0,0,0,,Бірге жұмыс істегендердің барлығына рахмет
Dialogue: 0,0:32:55.51,0:32:58.55,Default,,0,0,0,,Мен жалғыз болсам, қанша уақыт керек еді?
Dialogue: 0,0:32:58.81,0:33:00.14,Default,,0,0,0,,Әкем…
Dialogue: 0,0:33:01.14,0:33:02.39,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:33:02.98,0:33:04.44,Default,,0,0,0,,Рахмет
Dialogue: 0,0:33:05.19,0:33:08.23,Default,,0,0,0,,Балаларыңыз дертінен айыққаннан кейін ғана өзіңізді жеңіл сезінесіз.
Dialogue: 0,0:33:08.44,0:33:09.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:10.11,0:33:11.94,Default,,0,0,0,,Келіңіз, доктор! Дереу дәрі қабылдаңыз
Dialogue: 0,0:33:12.99,0:33:14.24,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:33:14.82,0:33:15.78,Default,,0,0,0,,Қосыңыз!
Dialogue: 0,0:33:15.86,0:33:17.32,Default,,0,0,0,,(дыбыстық сигнал…)
Dialogue: 0,0:33:45.02,0:33:46.10,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:33:47.98,0:33:48.81,Default,,0,0,0,,Хмм…
Dialogue: 0,0:33:49.31,0:33:50.31,Default,,0,0,0,,Ол аяқталды!
Dialogue: 0,0:33:50.40,0:33:51.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:57.53,0:33:59.41,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:33:59.78,0:34:01.53,Default,,0,0,0,,Жүр, аузыңды аш.
Dialogue: 0,0:34:03.37,0:34:04.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:04.29,0:34:05.29,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:34:05.41,0:34:06.71,Default,,0,0,0,,Кохокохоко…
Dialogue: 0,0:34:06.83,0:34:07.67,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:34:07.92,0:34:09.08,Default,,0,0,0,,Уф
Dialogue: 0,0:34:09.83,0:34:12.05,Default,,0,0,0,,Дәрі қабылдамасаң, жазылмайсың, солай ма?
Dialogue: 0,0:34:13.55,0:34:14.46,Default,,0,0,0,,Ехо…
Dialogue: 0,0:34:14.71,0:34:15.96,Default,,0,0,0,,Ехо Эхо...
Dialogue: 0,0:34:20.39,0:34:21.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:22.31,0:34:23.14,Default,,0,0,0,,Буу~!
Dialogue: 0,0:34:23.39,0:34:25.43,Default,,0,0,0,,Айтуынша, кеше ол мөлдір сәбиді немесе сондай бір нәрсені тапқан екен—
Dialogue: 0,0:34:26.35,0:34:27.19,Default,,0,0,0,,Уф!
Dialogue: 0,0:34:27.27,0:34:29.60,Default,,0,0,0,,Нига~!
Dialogue: 0,0:34:29.69,0:34:30.65,Default,,0,0,0,,Абаба…
Dialogue: 0,0:34:31.86,0:34:32.98,Default,,0,0,0,,Зорори-сан
Dialogue: 0,0:34:33.23,0:34:34.86,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:34:35.40,0:34:37.53,Default,,0,0,0,,Дәрі тым ащы
Dialogue: 0,0:34:37.61,0:34:40.74,Default,,0,0,0,,Осындай нәрселермен балалардың қуанғаны таңқаларлық емес.
Dialogue: 0,0:34:44.62,0:34:45.91,Default,,0,0,0,,А... бұл рас.
Dialogue: 0,0:34:46.58,0:34:48.71,Default,,0,0,0,,Дәрі бітсе де
Dialogue: 0,0:34:49.04,0:34:51.17,Default,,0,0,0,,Мен жұтып алсам ғой...
Dialogue: 0,0:34:51.25,0:34:53.13,Default,,0,0,0,,Дәрі міндетті түрде әсер етеді.
Dialogue: 0,0:34:54.05,0:34:57.42,Default,,0,0,0,,Барлығы... Кешіріңіз.
Dialogue: 0,0:34:58.76,0:35:00.30,Default,,0,0,0,,Ариус-чан...
Dialogue: 0,0:35:00.51,0:35:05.43,Default,,0,0,0,,Мен осы жерден тамаша идеяны ойлап тапсам ғой.
Dialogue: 0,0:35:05.56,0:35:08.73,Default,,0,0,0,,Тым тәтті болса, тым болмаса ішемін.
Dialogue: 0,0:35:09.02,0:35:10.31,Default,,0,0,0,,Хехе, міне!
Dialogue: 0,0:35:11.27,0:35:12.11,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:35:12.94,0:35:14.07,Default,,0,0,0,,Бұл қол болды!
Dialogue: 0,0:35:15.23,0:35:16.07,Default,,0,0,0,,Зорори мырза?
Dialogue: 0,0:35:16.61,0:35:18.74,Default,,0,0,0,,Кешіріңіз, мен мұны бір секундқа қарызға аламын.
Dialogue: 0,0:35:19.74,0:35:20.57,Default,,0,0,0,,Міне!
Dialogue: 0,0:35:20.91,0:35:24.91,Default,,0,0,0,,Мен осы тәтті фабриканың президентімен таныспын.
Dialogue: 0,0:35:25.87,0:35:28.75,Default,,0,0,0,,Тәтті шоколадты ащы дәрімен араластырыңыз
Dialogue: 0,0:35:29.00,0:35:31.50,Default,,0,0,0,,Балаларға да оқу оңайырақ болады деп ойлаймын.
Dialogue: 0,0:35:31.83,0:35:33.38,Default,,0,0,0,,Ойлан...
Dialogue: 0,0:35:33.46,0:35:34.29,Default,,0,0,0,,Нихи
Dialogue: 0,0:35:34.71,0:35:36.92,Default,,0,0,0,,Зоори-сан күткендей! Бұл тамаша идея
Dialogue: 0,0:35:37.63,0:35:39.55,Default,,0,0,0,,О, жоқ, ахахха!
Dialogue: 0,0:35:39.76,0:35:41.30,Default,,0,0,0,,Бірінші дәрежелі шайқас дегеніміз не?
Dialogue: 0,0:35:41.38,0:35:45.30,Default,,0,0,0,,Бұрышқа ілінген кезде ғана сезімдеріңізді ашық айтасыз.
Dialogue: 0,0:35:45.60,0:35:47.18,Default,,0,0,0,,Зорори мырза?
Dialogue: 0,0:35:47.72,0:35:50.02,Default,,0,0,0,,Брул бізге қарап тұр...
Dialogue: 0,0:35:50.10,0:35:51.89,Default,,0,0,0,,Хахаха~!
Dialogue: 0,0:35:51.98,0:35:54.61,Default,,0,0,0,,Уайымдама, маған қалдыр
Dialogue: 0,0:35:57.02,0:35:59.53,Default,,0,0,0,,Олай болса дереу президентке қоңырау шалыңыз...
Dialogue: 0,0:36:00.90,0:36:01.95,Default,,0,0,0,,(пип-пап пап)
Dialogue: 0,0:36:02.03,0:36:07.45,Default,,0,0,0,,(Пуруруру…)
Dialogue: 0,0:36:07.54,0:36:09.29,Default,,0,0,0,,Аа, президент Брул?
Dialogue: 0,0:36:09.37,0:36:11.58,Default,,0,0,0,,Шынында, бұл жолы менің кінәм болды.
Dialogue: 0,0:36:11.66,0:36:13.96,Default,,0,0,0,,Гейктер үшін дәмді және дәмді шоколад
Dialogue: 0,0:36:14.04,0:36:16.67,Default,,0,0,0,,Мен жалпы сипаттағым келеді
Dialogue: 0,0:36:17.17,0:36:19.67,Default,,0,0,0,,Иә, иә, түсті бетте күйдіріңіз...
Dialogue: 0,0:36:19.92,0:36:22.59,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:36:24.51,0:36:26.64,Default,,0,0,0,,Енді алдыңғы көрініс мінсіз
Dialogue: 0,0:36:27.10,0:36:30.14,Default,,0,0,0,,Жарайсың, Зори-сенсэй, жылы!
Dialogue: 0,0:36:30.22,0:36:32.56,Default,,0,0,0,,Зори-сан президентті білсе де.
Dialogue: 0,0:36:32.98,0:36:34.98,Default,,0,0,0,,Неліктен мұндай айналмалы нәрсе?
Dialogue: 0,0:36:35.06,0:36:35.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:35.98,0:36:37.98,Default,,0,0,0,,Міне... Ах...
Dialogue: 0,0:36:38.07,0:36:40.11,Default,,0,0,0,,Президентпен кездескеніме көп уақыт болды.
Dialogue: 0,0:36:40.19,0:36:43.07,Default,,0,0,0,,Менің саған тосын сыйым бар еді.
Dialogue: 0,0:36:43.15,0:36:44.74,Default,,0,0,0,,Иә! Мен бұл жақсырақ екеніне сенімдімін
Dialogue: 0,0:36:44.82,0:36:47.62,Default,,0,0,0,,Менің шешімім сізді қуантады деп үміттенемін.
Dialogue: 0,0:36:49.62,0:36:51.87,Default,,0,0,0,,Аха, солай ма?
Dialogue: 0,0:36:51.95,0:36:53.75,Default,,0,0,0,,Бір-бірімізді танимыз деп өтірік деп ойладым.
Dialogue: 0,0:36:53.83,0:36:55.58,Default,,0,0,0,,Еркін! Эй, бұл дөрекі.
Dialogue: 0,0:36:55.67,0:36:56.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:36:56.92,0:36:58.96,Default,,0,0,0,,Ахахаха...
Dialogue: 0,0:36:59.05,0:37:01.26,Default,,0,0,0,,Зорори-сан, өңдеу уақытында орындалады ма?
Dialogue: 0,0:37:02.34,0:37:04.55,Default,,0,0,0,,Балалардың дене күшін ескеру
Dialogue: 0,0:37:04.88,0:37:08.97,Default,,0,0,0,,Келесі күні кешке дейін қайтып келіп жеуім керек...
Dialogue: 0,0:37:09.22,0:37:11.64,Default,,0,0,0,,Иә! Сізде сонша уақыт жоқ па?
Dialogue: 0,0:37:12.73,0:37:16.35,Default,,0,0,0,,Брул шоколад фабрикасы осы жерден қанша қашықтықта орналасқан?
Dialogue: 0,0:37:17.73,0:37:19.15,Default,,0,0,0,,Бұл Ғапапа ауылы.
Dialogue: 0,0:37:19.23,0:37:23.07,Default,,0,0,0,,Зауыт таудың үстінде, аңғардың үстінде, теңіздің үстінде
Dialogue: 0,0:37:23.65,0:37:25.32,Default,,0,0,0,,Бұл шешімнің бөлігі.
Dialogue: 0,0:37:25.74,0:37:27.82,Default,,0,0,0,,Бұл өте алыс.
Dialogue: 0,0:37:27.91,0:37:29.20,Default,,0,0,0,,Міне!
Dialogue: 0,0:37:29.87,0:37:32.54,Default,,0,0,0,,Қалыпты жүру үшін неше күн қажет?
Dialogue: 0,0:37:32.62,0:37:35.00,Default,,0,0,0,,Егер бұл орын алса, бұл машина! Жарыс көлігі!
Dialogue: 0,0:37:35.08,0:37:38.13,Default,,0,0,0,,Жоқ, соттайтын болсаң, "Йонку" болуың керек!
Dialogue: 0,0:37:38.63,0:37:42.59,Default,,0,0,0,,Маған осы ауылдағы ең көп ат күші бар көлікті алып бер!
Dialogue: 0,0:37:45.13,0:37:46.18,Default,,0,0,0,,Бұл...
Dialogue: 0,0:37:46.26,0:37:49.05,Default,,0,0,0,,Ауылдағы ең қуатты машина?
Dialogue: 0,0:37:49.80,0:37:52.47,Default,,0,0,0,,Негізі бұл ауылдағы жалғыз көлік...
Dialogue: 0,0:37:52.97,0:37:55.18,Default,,0,0,0,,О, құдайым!
Dialogue: 0,0:37:55.27,0:37:57.73,Default,,0,0,0,,Менің бұлай жетуім мүмкін емес!
Dialogue: 0,0:37:58.60,0:37:59.86,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:37:59.94,0:38:02.36,Default,,0,0,0,,Мен қаншалықты бақытсызмын?
Dialogue: 0,0:38:02.73,0:38:04.61,Default,,0,0,0,,Менің таңдауым жоқ! Мен қазір жасаймын
Dialogue: 0,0:38:04.69,0:38:05.53,Default,,0,0,0,,Не!
Dialogue: 0,0:38:05.99,0:38:09.03,Default,,0,0,0,,Мен мына автобустың негізінде бірдеңе жасаймын.
Dialogue: 0,0:38:09.82,0:38:13.24,Default,,0,0,0,,Мен бұл данышпан Зорори-сама үшін ештеңе істей алмаймын!
Dialogue: 0,0:38:13.33,0:38:14.16,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:38:15.58,0:38:18.62,Default,,0,0,0,,А...бірақ оны қазірден бастаңыз.
Dialogue: 0,0:38:18.71,0:38:21.54,Default,,0,0,0,,Ертең кешке қайтасың ба?
Dialogue: 0,0:38:22.09,0:38:22.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:23.17,0:38:24.38,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:38:24.46,0:38:26.97,Default,,0,0,0,,Зорори-сенсэй осылай істейтін еді...
Dialogue: 0,0:38:27.05,0:38:27.88,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:38:27.97,0:38:29.68,Default,,0,0,0,,Хмм... мм.
Dialogue: 0,0:38:29.93,0:38:30.93,Default,,0,0,0,,Зорори мырза?
Dialogue: 0,0:38:31.01,0:38:33.06,Default,,0,0,0,,Жасалуы оңай, бірақ
Dialogue: 0,0:38:33.14,0:38:34.52,Default,,0,0,0,,Материалдарды жинақтау
Dialogue: 0,0:38:36.10,0:38:38.94,Default,,0,0,0,,Шынымен, бірден кете алмайсың ба?
Dialogue: 0,0:38:39.60,0:38:42.27,Default,,0,0,0,,Сонда Ишиши не болады?
Dialogue: 0,0:38:43.07,0:38:44.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:44.73,0:38:47.03,Default,,0,0,0,,Құдай, Хотоке-сама! Кез келген адам жақсы!
Dialogue: 0,0:38:47.11,0:38:49.11,Default,,0,0,0,,Міне, керемет ёнку...
Dialogue: 0,0:38:49.28,0:38:50.78,Default,,0,0,0,,(Бум!)
Dialogue: 0,0:38:51.16,0:38:52.74,Default,,0,0,0,,Міне!
Dialogue: 0,0:38:55.95,0:38:58.16,Default,,0,0,0,,Сіз! Бұл жолы нені еліктейсің?
Dialogue: 0,0:38:58.75,0:38:59.58,Default,,0,0,0,,Әй!
Dialogue: 0,0:38:59.96,0:39:02.59,Default,,0,0,0,,Зоронд Ронның кішкентай сыйлығы.
Dialogue: 0,0:39:03.29,0:39:05.63,Default,,0,0,0,,Балалар сендерге рахмет, мен көп ақша таптым.
Dialogue: 0,0:39:05.71,0:39:08.92,Default,,0,0,0,,Осыншама көп бөліспесең, барабанды ұтасың, солай ма?
Dialogue: 0,0:39:09.13,0:39:10.89,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:39:10.97,0:39:13.05,Default,,0,0,0,,Увахахаха!
Dialogue: 0,0:39:13.18,0:39:15.06,Default,,0,0,0,,Әлгі жігіт тұр.
Dialogue: 0,0:39:15.31,0:39:18.35,Default,,0,0,0,,Зоронд Рон жігіт, ол бұл жолы не істейді...
Dialogue: 0,0:39:18.60,0:39:21.23,Default,,0,0,0,,Цк, мұндайды кім пайдаланады!
Dialogue: 0,0:39:21.31,0:39:23.48,Default,,0,0,0,,Енді сіз бірден кете аласыз!
Dialogue: 0,0:39:23.56,0:39:25.57,Default,,0,0,0,,Барып қайтып келетініңізге сенімдімін.
Dialogue: 0,0:39:25.94,0:39:28.11,Default,,0,0,0,,Шынымен де Ишиді құтқарады!
Dialogue: 0,0:39:28.19,0:39:29.45,Default,,0,0,0,,Балалар да!
Dialogue: 0,0:39:29.53,0:39:31.20,Default,,0,0,0,,Не, сен мынаны қолданасың ба?
Dialogue: 0,0:39:31.66,0:39:34.08,Default,,0,0,0,,Шатасып кеткендерге
Dialogue: 0,0:39:34.16,0:39:36.62,Default,,0,0,0,,Маған өте жақсы әсер болмады.
Dialogue: 0,0:39:36.83,0:39:38.54,Default,,0,0,0,,Бүгіннен бастап менің ойым мүлде өзгерді.
Dialogue: 0,0:39:39.58,0:39:41.08,Default,,0,0,0,,Менің атым Зори-сан.
Dialogue: 0,0:39:41.17,0:39:42.67,Default,,0,0,0,,Менің атым Зоронд Рон.
Dialogue: 0,0:39:42.75,0:39:45.38,Default,,0,0,0,,Керемет адамдар көп!
Dialogue: 0,0:39:45.46,0:39:47.76,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:39:48.92,0:39:49.92,Default,,0,0,0,,Бірден осымен
Dialogue: 0,0:39:50.13,0:39:52.51,Default,,0,0,0,,Кәмпит фабрикасына барайық!
Dialogue: 0,0:39:53.47,0:39:54.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:39:54.39,0:39:55.60,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:39:56.35,0:39:57.72,Default,,0,0,0,,Фува~а
Dialogue: 0,0:39:58.47,0:40:01.23,Default,,0,0,0,,Менің дайындаған дәрі-дәрмектің бәрі осы.
Dialogue: 0,0:40:01.35,0:40:03.15,Default,,0,0,0,,Өтінемін, балаларға рұқсат етіңіз...
Dialogue: 0,0:40:03.52,0:40:05.31,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:40:06.15,0:40:07.78,Default,,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:40:07.86,0:40:10.24,Default,,0,0,0,,Аа, мен де бұл жолы аман-есен ораламын.
Dialogue: 0,0:40:10.32,0:40:13.20,Default,,0,0,0,,Балалар сендер шынымен жақсы достарсыңдар.
Dialogue: 0,0:40:13.28,0:40:15.37,Default,,0,0,0,,Иә, әрине! Мен оны жақсы көремін
Dialogue: 0,0:40:15.74,0:40:16.58,Default,,0,0,0,,Хаха…
Dialogue: 0,0:40:16.66,0:40:19.16,Default,,0,0,0,,Бірақ сіз бұл сапарды тоқтатпайсыз ба?
Dialogue: 0,0:40:22.50,0:40:23.67,Default,,0,0,0,,Ариус мырза.
Dialogue: 0,0:40:24.75,0:40:28.13,Default,,0,0,0,,Зори-сан маған оның жанында өзімді қауіпсіз сезінетінімді айтты.
Dialogue: 0,0:40:28.21,0:40:29.88,Default,,0,0,0,,Уау! О...
Dialogue: 0,0:40:29.96,0:40:32.43,Default,,0,0,0,,Сіз Ариуспен жақсы доссыз ба?
Dialogue: 0,0:40:32.51,0:40:33.34,Default,,0,0,0,,Иә
Dialogue: 0,0:40:33.43,0:40:35.85,Default,,0,0,0,,Мүмкін болса, менің үлкен әпкем болғаныңды қалаймын.
Dialogue: 0,0:40:35.93,0:40:37.76,Default,,0,0,0,,Мұнда бәрі жақсы!
Dialogue: 0,0:40:38.47,0:40:40.43,Default,,0,0,0,,Иә, мен үйдемін!
Dialogue: 0,0:40:40.77,0:40:41.77,Default,,0,0,0,,Нихихихи…
Dialogue: 0,0:40:41.85,0:40:45.40,Default,,0,0,0,,Ақырында сен мені аға деп атайсың.
Dialogue: 0,0:40:45.77,0:40:47.94,Default,,0,0,0,,Күте тұрыңыз! иә?
Dialogue: 0,0:40:48.02,0:40:48.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:53.65,0:40:54.95,Default,,0,0,0,,Ишиши!
Dialogue: 0,0:40:55.87,0:40:58.95,Default,,0,0,0,,О, біз біргеміз...
Dialogue: 0,0:40:59.03,0:41:00.41,Default,,0,0,0,,Жоқ! сурет?
Dialogue: 0,0:41:01.29,0:41:04.50,Default,,0,0,0,,Біз сіздің дәрі-дәрмекті қабылдауыңызды қамтамасыз етеміз.
Dialogue: 0,0:41:04.62,0:41:05.58,Default,,0,0,0,,Тыныш күтіңіз!
Dialogue: 0,0:41:06.38,0:41:09.92,Default,,0,0,0,,Жоқ... Мен Зори-сенсей мен Ношиши үшін уайымдаймын!
Dialogue: 0,0:41:10.00,0:41:13.51,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мен Иши үшін уайымдап жүрмін.
Dialogue: 0,0:41:13.59,0:41:16.84,Default,,0,0,0,,Эй... Екеуіңмен бірге болғым келмейді!
Dialogue: 0,0:41:17.47,0:41:20.93,Default,,0,0,0,,Сәлем! Мені өзіңізбен бірге алыңыз!
Dialogue: 0,0:41:21.02,0:41:22.10,Default,,0,0,0,,Ишиши…
Dialogue: 0,0:41:23.89,0:41:24.73,Default,,0,0,0,,Абайсыз болмаңыз!
Dialogue: 0,0:41:25.14,0:41:27.94,Default,,0,0,0,,Егер шын айтсаң, мені емдеп, артымнан ер!
Dialogue: 0,0:41:28.36,0:41:29.57,Default,,0,0,0,,Ишиши!
Dialogue: 0,0:41:31.48,0:41:32.61,Default,,0,0,0,,Угья~!
Dialogue: 0,0:41:33.03,0:41:33.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:41:34.45,0:41:35.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:41:39.37,0:41:42.29,Default,,0,0,0,,Мен сол ащы дәріні жұтып қойдым...
Dialogue: 0,0:41:43.50,0:41:44.66,Default,,0,0,0,,Зоори мырза...
Dialogue: 0,0:41:44.75,0:41:47.46,Default,,0,0,0,,Эй, бұл дәрі.
Dialogue: 0,0:41:47.79,0:41:48.79,Default,,0,0,0,,О!
Dialogue: 0,0:41:48.88,0:41:49.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:51.00,0:41:52.38,Default,,0,0,0,,Дәрі жұмыс істеді!
Dialogue: 0,0:41:52.46,0:41:53.67,Default,,0,0,0,,Сіз жасадыңыз, доктор!
Dialogue: 0,0:41:53.92,0:41:54.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:55.13,0:41:57.18,Default,,0,0,0,,Уау~ Иши Бұл керемет болды!
Dialogue: 0,0:41:57.26,0:41:58.47,Default,,0,0,0,,Өте жақсы болды.
Dialogue: 0,0:41:58.55,0:42:02.10,Default,,0,0,0,,Мұндай ащы дәріні жұтқан үлкен үлкен!
Dialogue: 0,0:42:02.43,0:42:03.93,Default,,0,0,0,,Ол емделді!
Dialogue: 0,0:42:04.48,0:42:07.65,Default,,0,0,0,,Мұғалім! Мені де өзіңізбен бірге ала аласыз ба?
Dialogue: 0,0:42:08.40,0:42:09.86,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:42:10.94,0:42:11.86,Default,,0,0,0,,Жарайды
Dialogue: 0,0:42:12.69,0:42:14.28,Default,,0,0,0,,Енді бізде барлық актерлер бар!
Dialogue: 0,0:42:14.90,0:42:18.66,Default,,0,0,0,,Содан кейін Буруру зауытына қарай жүріңіз!
Dialogue: 0,0:42:19.16,0:42:20.95,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:42:40.43,0:42:41.39,Default,,0,0,0,,Ишиши
Dialogue: 0,0:42:41.47,0:42:42.93,Default,,0,0,0,,Қабан
Dialogue: 0,0:42:44.68,0:42:48.48,Default,,0,0,0,,Оядзи гаг~ки~жо~♪
Dialogue: 0,0:42:49.77,0:42:52.31,Default,,0,0,0,,Келесі «Комедия Шинкансенде» кездескенше
Dialogue: 0,0:42:52.40,0:42:53.77,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:42:55.28,0:42:56.11,Default,,0,0,0,,Керемет жігіт...
Dialogue: 0,0:42:57.11,0:42:59.82,Default,,0,0,0,,Жоқ~ Эйдің қарны сондай аш көрінеді.
Dialogue: 0,0:42:59.91,0:43:01.24,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:43:01.41,0:43:03.83,Default,,0,0,0,,Ол мейрамханадағы түскі ас адам төзгісіз...
Dialogue: 0,0:43:04.20,0:43:05.33,Default,,0,0,0,,Зукозукозуко~!
Dialogue: 0,0:43:05.91,0:43:07.16,Default,,0,0,0,,Қалай кенеттен?
Dialogue: 0,0:43:07.25,0:43:08.37,Default,,0,0,0,,Шынымды айтсам, мұнда да...
Dialogue: 0,0:43:08.54,0:43:10.79,Default,,0,0,0,,Стейк өте жақсы
Dialogue: 0,0:43:11.25,0:43:12.17,Default,,0,0,0,,Зукозукозуко~!
Dialogue: 0,0:43:12.67,0:43:13.92,Default,,0,0,0,,Артық қалмау үшін...
Dialogue: 0,0:43:14.13,0:43:15.55,Default,,0,0,0,,Мен де бауыр жесем ше?
Dialogue: 0,0:43:15.88,0:43:16.92,Default,,0,0,0,,Зукозукозуко~!
Dialogue: 0,0:43:17.72,0:43:19.72,Default,,0,0,0,,Жапон тағамдары сатылып кетті Уау, шок!
Dialogue: 0,0:43:20.05,0:43:21.09,Default,,0,0,0,,Зукозукозуко~!
Dialogue: 0,0:43:21.59,0:43:23.39,Default,,0,0,0,,Менма болмағаны үшін кешіріңіз.
Dialogue: 0,0:43:23.68,0:43:24.76,Default,,0,0,0,,Зукозукозуко~!
Dialogue: 0,0:43:25.39,0:43:27.31,Default,,0,0,0,,Оның орнына имбирь жеуге болады!
Dialogue: 0,0:43:27.64,0:43:28.64,Default,,0,0,0,,Зукозукозуко~!
Dialogue: 0,0:43:29.23,0:43:31.31,Default,,0,0,0,,Жаман сөз жоқ, сөз жоқ
Dialogue: 0,0:43:31.44,0:43:32.81,Default,,0,0,0,,Оны мазақ етпе
Dialogue: 0,0:43:32.90,0:43:34.32,Default,,0,0,0,,Мынау және мынау...
Dialogue: 0,0:43:35.32,0:43:37.69,Default,,0,0,0,,Неге кенет төңкеріп тұрсың?
Dialogue: 0,0:43:37.78,0:43:40.70,Default,,0,0,0,,Бұл нағыз Оядзи Гаку.
Dialogue: 0,0:43:40.90,0:43:43.24,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:43:43.32,0:43:44.74,Default,,0,0,0,,(Шырылдау!)
Dialogue: 0,0:43:56.13,0:43:58.13,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:43:58.51,0:43:59.97,Default,,0,0,0,,Зори-сан, жақсысың ба?
Dialogue: 0,0:44:00.17,0:44:03.09,Default,,0,0,0,,Бұл құмды дауыл сейілгенше, алаңдайтын ештеңе жоқ.
Dialogue: 0,0:44:03.22,0:44:05.72,Default,,0,0,0,,Мен не болса да зауытқа жетуім керек.
Dialogue: 0,0:44:06.60,0:44:10.27,Default,,0,0,0,,Осы уақытқа дейін сізге көптеген достар көмектесті, солай емес пе?
Dialogue: 0,0:44:11.64,0:44:17.65,Default,,0,0,0,,♪～
Dialogue: 0,0:45:32.93,0:45:38.94,Default,,0,0,0,,～♪
Dialogue: 0,0:45:39.15,0:45:42.23,Default,,0,0,0,,Әркімнің көмегі зая кетпеу үшін
Dialogue: 0,0:45:42.48,0:45:43.57,Default,,0,0,0,,Барымызды салайық!
Dialogue: 0,0:45:43.78,0:45:44.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:45:49.12,0:45:50.16,Default,,0,0,0,,Сәлем Лукут
Dialogue: 0,0:45:50.24,0:45:52.49,Default,,0,0,0,,Шынымды айтсам, Рукут Каноджоға ұнай ма?
Dialogue: 0,0:45:52.83,0:45:54.96,Default,,0,0,0,,Иә! Сіз қайдан білдіңіз?
Dialogue: 0,0:45:55.41,0:45:58.13,Default,,0,0,0,,Оны көрсең бірден білесің.
Dialogue: 0,0:45:58.46,0:46:00.75,Default,,0,0,0,,Сонымен... дұрыс.
Dialogue: 0,0:46:01.63,0:46:04.92,Default,,0,0,0,,Негізі бұл туралы көптен бері ойланып жүрмін.
Dialogue: 0,0:46:05.05,0:46:06.38,Default,,0,0,0,,Сенімсіз
Dialogue: 0,0:46:06.47,0:46:08.14,Default,,0,0,0,,Көңіліңіз қалмайды!
Dialogue: 0,0:46:08.22,0:46:11.39,Default,,0,0,0,,Ол да Рукутты жақсы көретінін айтты.
Dialogue: 0,0:46:11.47,0:46:13.02,Default,,0,0,0,,H... Шынымен бе?
Dialogue: 0,0:46:13.72,0:46:17.10,Default,,0,0,0,,Зорори-сенсей де, мен осы сапардан кейін қайтқанда.
Dialogue: 0,0:46:17.19,0:46:21.65,Default,,0,0,0,,Сіз жақсы көретін адамға сезімдеріңізді білдіруді шешкен сияқтысыз.
Dialogue: 0,0:46:23.11,0:46:25.82,Default,,0,0,0,,Зорори-сан ер адам ғой.
Dialogue: 0,0:46:26.61,0:46:27.49,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:46:27.95,0:46:29.32,Default,,0,0,0,,Мен де ауылға қайтқанда
Dialogue: 0,0:46:29.41,0:46:32.08,Default,,0,0,0,,Мен батылдығымды жинап, шешім қабылдаймын!
Dialogue: 0,0:46:32.16,0:46:33.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:35.62,0:46:36.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:37.00,0:46:39.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:46:47.97,0:46:48.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:49.64,0:46:53.51,Default,,0,0,0,,Ах! Барлық көлік жақсы жағдайда
Dialogue: 0,0:46:53.97,0:46:55.02,Default,,0,0,0,,Әй!
Dialogue: 0,0:46:55.81,0:46:58.14,Default,,0,0,0,,Жарайды, бастайық.
Dialogue: 0,0:46:59.31,0:47:02.94,Default,,0,0,0,,Бәріміз бірге жұмыс істеп, мына нәрсені қазып алайық!
Dialogue: 0,0:47:07.53,0:47:09.32,Default,,0,0,0,,Ацуши~
Dialogue: 0,0:47:11.07,0:47:14.03,Default,,0,0,0,,Қанша жіберсем де құм ағады.
Dialogue: 0,0:47:14.54,0:47:15.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:15.70,0:47:16.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:20.58,0:47:23.50,Default,,0,0,0,,Осындай кезде бір тамшы жаңбыр жауса...
Dialogue: 0,0:47:24.09,0:47:24.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:47:26.13,0:47:27.97,Default,,0,0,0,,Ыстық!
Dialogue: 0,0:47:29.13,0:47:30.26,Default,,0,0,0,,Каминари қария!
Dialogue: 0,0:47:30.51,0:47:33.60,Default,,0,0,0,,Жоқ! Рахмет сізге Kaminarijijii!
Dialogue: 0,0:47:33.68,0:47:35.81,Default,,0,0,0,,Хаха, біз де келдік~
Dialogue: 0,0:47:36.52,0:47:37.98,Default,,0,0,0,,Сәлем! Тоқта, тоқта!
Dialogue: 0,0:47:38.06,0:47:40.44,Default,,0,0,0,,Менің рюкзактағы дәрі суланып қалатын шығар!
Dialogue: 0,0:47:40.52,0:47:41.90,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:47:41.98,0:47:42.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:43.11,0:47:44.44,Default,,0,0,0,,О, ау
Dialogue: 0,0:47:44.52,0:47:47.99,Default,,0,0,0,,Қаминари қарияның мейірімі шынымен-ақ шықты.
Dialogue: 0,0:47:48.11,0:47:49.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:50.99,0:47:51.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:51.91,0:47:54.07,Default,,0,0,0,,Эххехе... Ештеңе емес~
Dialogue: 0,0:47:55.12,0:47:56.45,Default,,0,0,0,,Шикеччиттада
Dialogue: 0,0:47:58.16,0:48:00.33,Default,,0,0,0,,Айтпақшы, мұнда неге келдің?
Dialogue: 0,0:48:00.75,0:48:01.58,Default,,0,0,0,,Хмм
Dialogue: 0,0:48:01.67,0:48:04.08,Default,,0,0,0,,Алда тұратын мумия сұрайды
Dialogue: 0,0:48:04.17,0:48:07.71,Default,,0,0,0,,Міне, мен туған күнімнің суын алып, саған бердім...
Dialogue: 0,0:48:08.84,0:48:12.38,Default,,0,0,0,,Ғапар тауына жақындағанымызда,
Dialogue: 0,0:48:12.47,0:48:15.51,Default,,0,0,0,,Мен аздап төгіп алдым.
Dialogue: 0,0:48:15.97,0:48:19.18,Default,,0,0,0,,Ол кезде мен бәріңді жаңа ғана көрдім.
Dialogue: 0,0:48:19.81,0:48:22.64,Default,,0,0,0,,Мен саған біраз қиындық туғыздым деп ойладым.
Dialogue: 0,0:48:22.73,0:48:25.23,Default,,0,0,0,,Мен асығыс оралсам, сонда екен.
Dialogue: 0,0:48:25.69,0:48:26.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:26.65,0:48:27.73,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:48:27.82,0:48:30.90,Default,,0,0,0,,Менің мұрныма бірдеңе кіріп кеткен шығар!
Dialogue: 0,0:48:31.45,0:48:32.49,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:48:32.57,0:48:34.53,Default,,0,0,0,,Ишиши алапеспен ауырды.
Dialogue: 0,0:48:34.62,0:48:35.45,Default,,0,0,0,,Соған байланысты ма?
Dialogue: 0,0:48:35.74,0:48:36.70,Default,,0,0,0,,Қарсылас – Sparking Killing Boy!
Dialogue: 0,0:48:36.78,0:48:39.08,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:48:39.45,0:48:41.87,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:48:41.96,0:48:44.92,Default,,0,0,0,,Кешірім сұрауға болатын нәрсе бар ма?
Dialogue: 0,0:48:45.00,0:48:47.38,Default,,0,0,0,,О, мен мұны істей аламын! Сіз жасай аласыз!
Dialogue: 0,0:48:47.79,0:48:50.17,Default,,0,0,0,,Сіз бұл суна туралы бірдеңе істей аласыз ба?
Dialogue: 0,0:48:50.34,0:48:51.59,Default,,0,0,0,,Мен көремін. (Ношиши: Сыбырлап) Сүйкімді емес пе?
Dialogue: 0,0:48:51.67,0:48:52.97,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:48:54.38,0:48:55.43,Default,,0,0,0,,Сонымен... не?
Dialogue: 0,0:48:55.93,0:48:56.89,Default,,0,0,0,,Нигеро!
Dialogue: 0,0:48:57.01,0:48:58.81,Default,,0,0,0,,Каминари қария~!
Dialogue: 0,0:48:59.14,0:49:00.77,Default,,0,0,0,,Бұл арзан!
Dialogue: 0,0:49:00.85,0:49:02.39,Default,,0,0,0,,Буруруруру…
Dialogue: 0,0:49:06.23,0:49:07.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:07.52,0:49:09.02,Default,,0,0,0,,Ата! Тататата...
Dialogue: 0,0:49:18.62,0:49:19.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:49:19.87,0:49:20.79,Default,,0,0,0,,Жақсы
Dialogue: 0,0:49:20.87,0:49:23.79,Default,,0,0,0,,Ах! Тенджо Ол ашық қалды!
Dialogue: 0,0:49:23.87,0:49:26.04,Default,,0,0,0,,Мен сені кіргізбеймін.
Dialogue: 0,0:49:26.12,0:49:27.29,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:49:27.50,0:49:29.71,Default,,0,0,0,,Жарайсыңдар! Барлығы көлікке отырсын!
Dialogue: 0,0:49:29.80,0:49:31.25,Default,,0,0,0,,Иә! (Ишиши Ношиши) Сәлем!
Dialogue: 0,0:49:33.84,0:49:35.34,Default,,0,0,0,,Барлық көмектеріңіз үшін рахмет.
Dialogue: 0,0:49:35.76,0:49:36.84,Default,,0,0,0,,Рахмет
Dialogue: 0,0:49:42.43,0:49:44.56,Default,,0,0,0,,Сау болыңыз~!
Dialogue: 0,0:49:44.64,0:49:46.60,Default,,0,0,0,,Қайта кездескенше!
Dialogue: 0,0:49:51.23,0:49:53.15,Default,,0,0,0,,Уф... Не?!
Dialogue: 0,0:49:53.28,0:49:54.57,Default,,0,0,0,,Иши сөмкесін жоғалтып алды.
Dialogue: 0,0:49:54.95,0:49:57.53,Default,,0,0,0,,Ношишидің рюкзактары сынды ма?
Dialogue: 0,0:49:57.61,0:49:58.45,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:49:58.82,0:50:02.49,Default,,0,0,0,,Доктор Марроудың маған көбірек бергені жақсы болды.
Dialogue: 0,0:50:03.04,0:50:04.33,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:50:04.41,0:50:06.00,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:50:06.16,0:50:09.46,Default,,0,0,0,,Жоқ...жақсы, маған әрең жетеді.
Dialogue: 0,0:50:10.25,0:50:12.13,Default,,0,0,0,,Жай ғана...
Dialogue: 0,0:50:12.21,0:50:13.92,Default,,0,0,0,,Ишиши Ношиши
Dialogue: 0,0:50:15.17,0:50:16.63,Default,,0,0,0,,Қуаныңыз!
Dialogue: 0,0:50:17.05,0:50:18.05,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:50:19.18,0:50:21.64,Default,,0,0,0,,Ах~ Ах~ Микрофонды тексеру
Dialogue: 0,0:50:21.72,0:50:22.76,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:50:22.93,0:50:24.81,Default,,0,0,0,,Олай болса, келіскеніміздей жалғастырайық.
Dialogue: 0,0:50:25.43,0:50:27.98,Default,,0,0,0,,Біз өзімізді тілші болдық.
Dialogue: 0,0:50:28.06,0:50:30.23,Default,,0,0,0,,Сіз Брул мырзаның назарын аударасыз, солай емес пе?
Dialogue: 0,0:50:30.44,0:50:31.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:31.61,0:50:34.19,Default,,0,0,0,,Арасында біз артымыздан тығылып кірдік.
Dialogue: 0,0:50:34.28,0:50:35.65,Default,,0,0,0,,Дәрілік заттарды өңдеу
Dialogue: 0,0:50:35.94,0:50:38.28,Default,,0,0,0,,Қандай таң қалдырды!
Dialogue: 0,0:50:38.45,0:50:41.28,Default,,0,0,0,,Сіз ақпаратты президент Брулға қашан жеткізесіз?
Dialogue: 0,0:50:41.70,0:50:44.20,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:50:44.33,0:50:47.25,Default,,0,0,0,,Уақыты келгенде хабарлаймын.
Dialogue: 0,0:50:47.66,0:50:51.29,Default,,0,0,0,,Мен белгі бергенде, балалар сұхбатты аяқтайсыңдар.
Dialogue: 0,0:50:51.67,0:50:54.96,Default,,0,0,0,,Алдымен мына көлікке мініп, зауыттың артына кел.
Dialogue: 0,0:50:55.42,0:50:56.55,Default,,0,0,0,,Сенің әрекетің тым балалық… немесе жай ғана қысқа көзді.
Dialogue: 0,0:50:58.22,0:50:59.38,Default,,0,0,0,,Сәлем
Dialogue: 0,0:50:59.47,0:51:01.60,Default,,0,0,0,,Біз президент Брюльден сұхбат сұрадық.
Dialogue: 0,0:51:01.68,0:51:02.51,Default,,0,0,0,,Зашино...
Dialogue: 0,0:51:02.60,0:51:03.97,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:51:04.06,0:51:05.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:12.31,0:51:13.15,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:51:13.73,0:51:15.32,Default,,0,0,0,,Буруру тағам фабрикасына
Dialogue: 0,0:51:18.15,0:51:20.20,Default,,0,0,0,,Біз сізді күттік!
Dialogue: 0,0:51:20.28,0:51:22.28,Default,,0,0,0,,Ал, көп рахмет.
Dialogue: 0,0:51:23.07,0:51:25.37,Default,,0,0,0,,Қош келдіңіз. Келгеніңізге рахмет.
Dialogue: 0,0:51:25.99,0:51:28.16,Default,,0,0,0,,Келіңіздер, сізді президент Брул күтіп тұр.
Dialogue: 0,0:51:28.25,0:51:30.00,Default,,0,0,0,,Келіңіздер! Келіңіздер, келіңіздер!
Dialogue: 0,0:51:31.29,0:51:32.13,Default,,0,0,0,,Брул жігіт...
Dialogue: 0,0:51:33.84,0:51:35.96,Default,,0,0,0,,Сіз қаншалықты сақсыз?
Dialogue: 0,0:51:36.13,0:51:38.30,Default,,0,0,0,,Сіз Зорори-сенсейге айқайлап жатырсыз.
Dialogue: 0,0:51:38.72,0:51:39.55,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:51:39.63,0:51:43.14,Default,,0,0,0,,Бұл қулықпен мені жақсы сезінемін деп ойлама.
Dialogue: 0,0:51:43.47,0:51:45.51,Default,,0,0,0,,Жарайды, операцияны бастайық!
Dialogue: 0,0:51:45.60,0:51:46.52,Default,,0,0,0,,Иә, айса~!
Dialogue: 0,0:51:48.27,0:51:49.27,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,0:51:49.64,0:51:50.48,Default,,0,0,0,,Мұндай!
Dialogue: 0,0:51:51.02,0:51:51.94,Default,,0,0,0,,Мұндай!
Dialogue: 0,0:51:52.44,0:51:53.86,Default,,0,0,0,,Гашшин!
Dialogue: 0,0:51:54.48,0:51:56.78,Default,,0,0,0,,Бұл нағыз бөкселер
Dialogue: 0,0:51:57.07,0:51:59.53,Default,,0,0,0,,Ақымақ болмаңыз, бұрышты дұрыс реттеңіз.
Dialogue: 0,0:52:00.49,0:52:01.32,Default,,0,0,0,,Хмф!
Dialogue: 0,0:52:01.82,0:52:04.12,Default,,0,0,0,,Пипипипи…
Dialogue: 0,0:52:04.20,0:52:05.12,Default,,0,0,0,,Құлыптаңыз!
Dialogue: 0,0:52:05.45,0:52:06.45,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:52:06.62,0:52:07.45,Default,,0,0,0,,(Боу!)
Dialogue: 0,0:52:12.62,0:52:14.92,Default,,0,0,0,,Қозғалтқыштың екінші тұтануы!
Dialogue: 0,0:52:15.00,0:52:15.84,Default,,0,0,0,,(Ооо!)
Dialogue: 0,0:52:19.67,0:52:20.51,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:52:22.68,0:52:23.59,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:52:28.56,0:52:31.27,Default,,0,0,0,,Сіз қалай ойлайсыз? Синджу сияқты, солай ма?
Dialogue: 0,0:52:31.35,0:52:32.19,Default,,0,0,0,,Менің рамунам
Dialogue: 0,0:52:32.27,0:52:35.36,Default,,0,0,0,,Бұл басқа өнімдерден мүлдем өзгеше.
Dialogue: 0,0:52:35.48,0:52:36.31,Default,,0,0,0,,Бұл орын алғанша
Dialogue: 0,0:52:36.40,0:52:39.69,Default,,0,0,0,,Қанша уақыт пен ақша жұмсалды?
Dialogue: 0,0:52:39.82,0:52:40.69,Default,,0,0,0,,Гус…
Dialogue: 0,0:52:40.78,0:52:43.45,Default,,0,0,0,,Сол қиындық ақыры өз жемісін берді.
Dialogue: 0,0:52:43.53,0:52:46.07,Default,,0,0,0,,Ол келесі айда шығарылады.
Dialogue: 0,0:52:46.41,0:52:47.37,Default,,0,0,0,,Қалай
Dialogue: 0,0:52:47.45,0:52:50.12,Default,,0,0,0,,Буруру жігіт көп жұмыс істейді, солай емес пе?
Dialogue: 0,0:52:53.96,0:52:54.79,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:52:54.88,0:52:55.71,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:52:59.42,0:53:00.46,Default,,0,0,0,,Ношиши еңбекқорлығы
Dialogue: 0,0:53:00.55,0:53:01.55,Default,,0,0,0,,Мұндай
Dialogue: 0,0:53:01.63,0:53:03.59,Default,,0,0,0,,Бізде керемет топтық жұмыс бар.
Dialogue: 0,0:53:04.22,0:53:05.05,Default,,0,0,0,,Хмф!
Dialogue: 0,0:53:06.26,0:53:07.76,Default,,0,0,0,,Олай болса, жоспарлағандай барайық.
Dialogue: 0,0:53:08.39,0:53:10.93,Default,,0,0,0,,Ношиши Біз қайтып келгенше
Dialogue: 0,0:53:11.02,0:53:13.31,Default,,0,0,0,,Арқанды табудан сақ болыңыз
Dialogue: 0,0:53:13.77,0:53:16.15,Default,,0,0,0,,Ариус көлікпен келгенде,
Dialogue: 0,0:53:16.23,0:53:18.82,Default,,0,0,0,,Бірден асығуға дайын болыңыз.
Dialogue: 0,0:53:19.11,0:53:19.94,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:53:32.37,0:53:33.37,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:53:33.46,0:53:34.58,Default,,0,0,0,,Мынау
Dialogue: 0,0:53:34.66,0:53:35.79,Default,,0,0,0,,Не? ол
Dialogue: 0,0:53:35.87,0:53:37.96,Default,,0,0,0,,Бұл қатқанға дейін шоколад.
Dialogue: 0,0:53:42.55,0:53:43.38,Default,,0,0,0,,Ей!
Dialogue: 0,0:53:46.18,0:53:47.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:53:47.09,0:53:48.97,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:53:49.05,0:53:49.89,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:53:50.47,0:53:51.68,Default,,0,0,0,,U.A. Спорттық күні тез арада келіп жетті
Dialogue: 0,0:53:52.52,0:53:54.89,Default,,0,0,0,,Ах! Ол кептеліп қалды
Dialogue: 0,0:53:55.14,0:53:56.98,Default,,0,0,0,,Мен мұны бәрібір қолданып көруім керек пе?
Dialogue: 0,0:53:57.06,0:53:58.31,Default,,0,0,0,,Дәмді көрінеді~
Dialogue: 0,0:53:58.65,0:53:59.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:59.90,0:54:00.98,Default,,0,0,0,,Хмм!
Dialogue: 0,0:54:01.44,0:54:02.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:54:05.78,0:54:06.61,Default,,0,0,0,,Ах~
Dialogue: 0,0:54:07.20,0:54:10.49,Default,,0,0,0,,Шоколадпен араластырса ащы кетеді деп ойладым.
Dialogue: 0,0:54:10.58,0:54:12.45,Default,,0,0,0,,Сіздің ойыңыз қате болды ма?
Dialogue: 0,0:54:12.62,0:54:15.21,Default,,0,0,0,,Зоори мырза, біз не істеуіміз керек?
Dialogue: 0,0:54:15.29,0:54:16.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:54:16.79,0:54:17.75,Default,,0,0,0,,Сіз қалай ойлайсыз? Сол рамуна
Dialogue: 0,0:54:18.42,0:54:20.75,Default,,0,0,0,,Оны тістеп алсаң, сергітеді.
Dialogue: 0,0:54:20.84,0:54:21.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:54:22.34,0:54:23.34,Default,,0,0,0,,Не?
Dialogue: 0,0:54:23.88,0:54:25.09,Default,,0,0,0,,Асхана мәзірі
Dialogue: 0,0:54:25.17,0:54:26.88,Default,,0,0,0,,Буруру фабрикасында тәттілер жасау
Dialogue: 0,0:54:26.97,0:54:28.84,Default,,0,0,0,,Мұның бәрі автоматтандыру.
Dialogue: 0,0:54:28.93,0:54:30.26,Default,,0,0,0,,Бұл машина әлдеқашан
Dialogue: 0,0:54:30.35,0:54:32.56,Default,,0,0,0,,Оған көп ақша кетеді.
Dialogue: 0,0:54:32.89,0:54:35.52,Default,,0,0,0,,Маған зұлым адамдар талай рет шабуыл жасады...
Dialogue: 0,0:54:35.60,0:54:37.44,Default,,0,0,0,,Ариус-чан, сен мені естисің бе?
Dialogue: 0,0:54:37.56,0:54:38.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:38.52,0:54:40.86,Default,,0,0,0,,Мен де Рамуне машинасына трюк жасағым келеді.
Dialogue: 0,0:54:41.27,0:54:42.86,Default,,0,0,0,,Брул мен Коблды шығарып жібере аласыз ба?
Dialogue: 0,0:54:42.94,0:54:44.48,Default,,0,0,0,,Менің ең соңында жасағаным...
Dialogue: 0,0:54:44.57,0:54:45.40,Default,,0,0,0,,Президент Брул
Dialogue: 0,0:54:45.53,0:54:47.49,Default,,0,0,0,,Иә? Рамунеден басқа
Dialogue: 0,0:54:47.57,0:54:50.57,Default,,0,0,0,,Тәттілер әлі де көп, солай ма?
Dialogue: 0,0:54:50.66,0:54:51.87,Default,,0,0,0,,Әрине!
Dialogue: 0,0:54:51.95,0:54:53.28,Default,,0,0,0,,Сәлем, президент Брул.
Dialogue: 0,0:54:53.37,0:54:54.24,Default,,0,0,0,,О
Dialogue: 0,0:54:54.33,0:54:56.45,Default,,0,0,0,,Енді біздің компанияның тағдыры қауіп төніп тұр.
Dialogue: 0,0:54:56.54,0:54:59.79,Default,,0,0,0,,Біз сізді мәрмәр шоколадының Seizo желісіне бағыттаймыз.
Dialogue: 0,0:55:00.46,0:55:01.67,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:55:03.25,0:55:07.59,Default,,0,0,0,,Кеме әлі де сынақтан өтуде, сондықтан бұл алдын ала сұхбат.
Dialogue: 0,0:55:07.67,0:55:09.88,Default,,0,0,0,,Жүр, осында кел.
Dialogue: 0,0:55:11.14,0:55:11.97,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:55:12.68,0:55:13.81,Default,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:55:14.22,0:55:17.27,Default,,0,0,0,,Бұл рамун машинасы ұнтақты қатайтады.
Dialogue: 0,0:55:17.35,0:55:19.27,Default,,0,0,0,,Айнала шоколад сеуіп алсаңыз
Dialogue: 0,0:55:19.35,0:55:21.81,Default,,0,0,0,,Сіз дәрінің ащысын тоқтата аласыз, солай ма?
Dialogue: 0,0:55:22.23,0:55:24.73,Default,,0,0,0,,О! Бұл тамаша идея!
Dialogue: 0,0:55:39.21,0:55:40.67,Default,,0,0,0,,Бұл келе жатыр! Мен жоғарымын
Dialogue: 0,0:55:41.12,0:55:43.50,Default,,0,0,0,,Уау~
Dialogue: 0,0:55:44.79,0:55:46.84,Default,,0,0,0,,Қалғандарының барлығын жинаймын!
Dialogue: 0,0:55:46.92,0:55:47.84,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:55:49.47,0:55:51.80,Default,,0,0,0,,Ах~ менің қолдарым...
Dialogue: 0,0:55:51.89,0:55:53.97,Default,,0,0,0,,Хаа… Еңбегіңіз үшін рахмет.
Dialogue: 0,0:55:54.18,0:55:56.18,Default,,0,0,0,,Жарайсыз, Зоори мырза.
Dialogue: 0,0:55:56.26,0:55:58.18,Default,,0,0,0,,Мақсат мінсіз болды!
Dialogue: 0,0:55:58.27,0:56:00.31,Default,,0,0,0,,Иә, жақсы...
Dialogue: 0,0:56:00.69,0:56:02.23,Default,,0,0,0,,Сіз қалай ойлайсыз? Әдемі емес пе?
Dialogue: 0,0:56:02.77,0:56:04.31,Default,,0,0,0,,Иә, шынымен!
Dialogue: 0,0:56:04.40,0:56:06.02,Default,,0,0,0,,Үлкен күш-жігерден кейін
Dialogue: 0,0:56:06.11,0:56:08.07,Default,,0,0,0,,Буруру шоколадын жағу үшін Гиджуцу
Dialogue: 0,0:56:08.15,0:56:09.32,Default,,0,0,0,,Әзірленген
Dialogue: 0,0:56:09.65,0:56:10.53,Default,,0,0,0,,Міне
Dialogue: 0,0:56:10.61,0:56:12.78,Default,,0,0,0,,Bururu Foods Джиманның жаңа ақпараты
Dialogue: 0,0:56:12.86,0:56:14.66,Default,,0,0,0,,Бұл мәрмәр шоколад!
Dialogue: 0,0:56:14.87,0:56:15.70,Default,,0,0,0,,Құдай-ай! Сен кімсің, осы, сұм!
Dialogue: 0,0:56:16.20,0:56:17.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:56:17.33,0:56:21.37,Default,,0,0,0,,Егер сіз бұл құрылғыны қолдансаңыз, дәріні бірден жағуға болады.
Dialogue: 0,0:56:21.66,0:56:23.79,Default,,0,0,0,,Неғұрлым тезірек болса, соғұрлым жақсы!
Dialogue: 0,0:56:25.13,0:56:27.71,Default,,0,0,0,,Бұранданы өңдеу мұнда...
Dialogue: 0,0:56:27.80,0:56:29.34,Default,,0,0,0,,Президент Брул Хух?
Dialogue: 0,0:56:29.71,0:56:33.34,Default,,0,0,0,,Келесі жолы мен сүйкімді президенттің өзіне хабарласқым келеді.
Dialogue: 0,0:56:33.43,0:56:34.34,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:56:34.43,0:56:35.26,Default,,0,0,0,,Керемет...
Dialogue: 0,0:56:35.47,0:56:37.18,Default,,0,0,0,,«Ол менің кім екенімді де білмейді»
Dialogue: 0,0:56:37.26,0:56:38.35,Default,,0,0,0,,Нуфуфу~
Dialogue: 0,0:56:38.43,0:56:41.81,Default,,0,0,0,,Енді президент кабинетінде шай ішейік.
Dialogue: 0,0:56:41.89,0:56:44.23,Default,,0,0,0,,О, тамаша! Бұл жақсы
Dialogue: 0,0:56:47.48,0:56:49.73,Default,,0,0,0,,Ариус-чан, сен жақсы жұмыс істеген сияқтысың.
Dialogue: 0,0:56:52.24,0:56:55.28,Default,,0,0,0,,Уау! Бұл таңғажайып машина!
Dialogue: 0,0:56:55.37,0:56:57.74,Default,,0,0,0,,Брулдың неге ашуланып жатқанын түсіндім.
Dialogue: 0,0:56:58.28,0:56:59.91,Default,,0,0,0,,Менің таңдануға уақытым жоқ.
Dialogue: 0,0:57:00.12,0:57:02.75,Default,,0,0,0,,Менің сигналыммен машинаны жылжытыңыз!
Dialogue: 0,0:57:02.83,0:57:03.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:57:09.63,0:57:10.46,Default,,0,0,0,,Хмф!
Dialogue: 0,0:57:10.80,0:57:11.71,Default,,0,0,0,,Ишиши Жақсы!
Dialogue: 0,0:57:12.13,0:57:13.22,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:57:13.30,0:57:14.34,Default,,0,0,0,,Хмф! (дыбылдау)
Dialogue: 0,0:57:38.45,0:57:40.41,Default,,0,0,0,,Жарайды, Джунби жарайды!
Dialogue: 0,0:57:40.54,0:57:43.25,Default,,0,0,0,,Зорори мырза! Дәрі кетеді
Dialogue: 0,0:57:48.79,0:57:51.55,Default,,0,0,0,,Зоори мырза, жақсы өтті.
Dialogue: 0,0:57:52.01,0:57:52.88,Default,,0,0,0,,Бұл, сөзсіз, қоңырау шалған жігіт сияқты. Ол «Юхамон» қолданушысы да, жау да емес.
Dialogue: 0,0:57:53.97,0:57:57.51,Default,,0,0,0,,Мен Буруруды мақтағанды ​​ұнатпаймын, бірақ бұл жолы ол мені құтқарды.
Dialogue: 0,0:57:57.93,0:58:00.81,Default,,0,0,0,,Жүр, көп күтудің қажеті жоқ, қайтайық!
Dialogue: 0,0:58:01.01,0:58:01.93,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:58:03.93,0:58:05.39,Default,,0,0,0,,Айтпақшы, Зорори мырза
Dialogue: 0,0:58:05.48,0:58:07.85,Default,,0,0,0,,Төбеге түспесең, кері қайту мүмкін емес...
Dialogue: 0,0:58:07.94,0:58:08.77,Default,,0,0,0,,Ах
Dialogue: 0,0:58:09.15,0:58:09.98,Default,,0,0,0,,Ах
Dialogue: 0,0:58:10.19,0:58:11.02,Default,,0,0,0,,Ах
Dialogue: 0,0:58:14.11,0:58:14.94,Default,,0,0,0,,Хехе
Dialogue: 0,0:58:15.07,0:58:15.90,Default,,0,0,0,,Иә
Dialogue: 0,0:58:15.99,0:58:18.24,Default,,0,0,0,,Zo... Zorori?
Dialogue: 0,0:58:19.12,0:58:21.08,Default,,0,0,0,,Эй, сен мұнда не үшін келдің?
Dialogue: 0,0:58:21.49,0:58:23.41,Default,,0,0,0,,Мрамор шоколадына ұмтылыңыз!
Dialogue: 0,0:58:23.50,0:58:24.95,Default,,0,0,0,,Тістемеңіз
Dialogue: 0,0:58:25.08,0:58:26.58,Default,,0,0,0,,Гаттендешу~!
Dialogue: 0,0:58:26.66,0:58:28.63,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:58:29.38,0:58:30.88,Default,,0,0,0,,Ариус-чан, сен мені естисің бе?
Dialogue: 0,0:58:30.96,0:58:32.38,Default,,0,0,0,,Ах... Зорори-сан?
Dialogue: 0,0:58:33.67,0:58:34.96,Default,,0,0,0,,Юрусанцо
Dialogue: 0,0:58:36.38,0:58:38.38,Default,,0,0,0,,Біз дәрі-дәрмекті сәтті қаптадық.
Dialogue: 0,0:58:39.30,0:58:42.51,Default,,0,0,0,,Екеуіңіз дереу зауыттан шығып, көлігіңізді бұрыңыз!
Dialogue: 0,0:58:42.85,0:58:43.85,Default,,0,0,0,,Иә? мм...
Dialogue: 0,0:58:44.39,0:58:46.23,Default,,0,0,0,,Тосын оқиғаға не болды?
Dialogue: 0,0:58:46.52,0:58:48.39,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:58:49.27,0:58:50.23,Default,,0,0,0,,Зорори мырза?
Dialogue: 0,0:58:51.15,0:58:54.03,Default,,0,0,0,,Жоқ, жоқ, олар қорқады.
Dialogue: 0,0:58:54.69,0:58:56.36,Default,,0,0,0,,Таң қалудың орнына...
Dialogue: 0,0:58:56.44,0:58:58.24,Default,,0,0,0,,Сіз ашулы болдыңыз, солай емес пе?
Dialogue: 0,0:58:59.03,0:59:00.07,Default,,0,0,0,,Зорори~!
Dialogue: 0,0:59:01.03,0:59:02.24,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:59:02.33,0:59:03.58,Default,,0,0,0,,Бұл дұрыс болмады ма...
Dialogue: 0,0:59:03.66,0:59:04.62,Default,,0,0,0,,Нигасан!
Dialogue: 0,0:59:04.70,0:59:06.66,Default,,0,0,0,,Біреуіне отырыңыз!
Dialogue: 0,0:59:10.33,0:59:11.58,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:59:17.42,0:59:18.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:18.76,0:59:19.88,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:59:20.55,0:59:21.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:22.47,0:59:23.30,Default,,0,0,0,,Не?
Dialogue: 0,0:59:23.51,0:59:24.56,Default,,0,0,0,,Бұл жеп жатыр!
Dialogue: 0,0:59:26.93,0:59:27.98,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:59:30.90,0:59:31.73,Default,,0,0,0,,Зорори!
Dialogue: 0,0:59:31.90,0:59:33.77,Default,,0,0,0,,Оны бүлдірмеңіз
Dialogue: 0,0:59:33.86,0:59:35.02,Default,,0,0,0,,(бум)
Dialogue: 0,0:59:38.49,0:59:40.11,Default,,0,0,0,,Бұл жолы...
Dialogue: 0,0:59:40.28,0:59:44.45,Default,,0,0,0,,Бұл қандай қатынас? Президент Брюле мен Зоори
Dialogue: 0,0:59:44.53,0:59:45.37,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:59:45.66,0:59:46.62,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:59:47.95,0:59:49.25,Default,,0,0,0,,Зорори~!
Dialogue: 0,0:59:50.25,0:59:52.42,Default,,0,0,0,,Жарайды! Мен келген жолмен қайттым.
Dialogue: 0,0:59:53.17,0:59:55.09,Default,,0,0,0,,Тезірек Ношишиге оралыңыз!
Dialogue: 0,0:59:55.17,0:59:56.09,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:59:56.75,1:00:00.22,Default,,0,0,0,,Ахахах... Котлет дон иісі шығады.
Dialogue: 0,1:00:00.59,1:00:03.01,Default,,0,0,0,,Міне! Ерте тұр!
Dialogue: 0,1:00:04.14,1:00:05.93,Default,,0,0,0,,Қош келдіңіз...
Dialogue: 0,1:00:06.39,1:00:07.81,Default,,0,0,0,,Егер сіз жай ғана алаңсыз ұйықтап жатсаңыз!
Dialogue: 0,1:00:08.27,1:00:09.14,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:00:09.23,1:00:10.60,Default,,0,0,0,,Ах! сурет?
Dialogue: 0,1:00:10.85,1:00:12.60,Default,,0,0,0,,Котлеттің иісі шығады!
Dialogue: 0,1:00:12.69,1:00:13.94,Default,,0,0,0,,Катсудон! Кацудон жедің бе?
Dialogue: 0,1:00:14.02,1:00:15.19,Default,,0,0,0,,Зорори-сан...
Dialogue: 0,1:00:15.90,1:00:17.53,Default,,0,0,0,,Біз зауыттың артына келдік.
Dialogue: 0,1:00:19.57,1:00:21.36,Default,,0,0,0,,Катсудон!
Dialogue: 0,1:00:21.45,1:00:24.87,Default,,0,0,0,,Ношиши! Осы жерден қолымнан келгенше сені тамақтандырамын.
Dialogue: 0,1:00:25.12,1:00:26.83,Default,,0,0,0,,Джунби не болып жатыр...
Dialogue: 0,1:00:28.49,1:00:30.33,Default,,0,0,0,,Лукт! Мен арқанды лақтырамын
Dialogue: 0,1:00:30.41,1:00:33.46,Default,,0,0,0,,Оны көлігіңізге байлап, бірден жүргізуді бастаңыз.
Dialogue: 0,1:00:33.54,1:00:34.92,Default,,0,0,0,,Арқанды түзетіңіз
Dialogue: 0,1:00:35.13,1:00:37.34,Default,,0,0,0,,Енді бәрі жақсы!
Dialogue: 0,1:00:37.80,1:00:39.01,Default,,0,0,0,,Ахх!
Dialogue: 0,1:00:39.09,1:00:42.93,Default,,0,0,0,,Егер сіз ол затты ұшып жіберсеңіз, сіз оны ала алмайсыз!
Dialogue: 0,1:00:43.05,1:00:44.14,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:00:44.59,1:00:46.76,Default,,0,0,0,,Енді арқанды көлікке байлаңыз...
Dialogue: 0,1:00:49.52,1:00:50.77,Default,,0,0,0,,Жылжы!
Dialogue: 0,1:00:51.56,1:00:53.14,Default,,0,0,0,,Өтінемін, байлау құралдарын әкеліңдер!
Dialogue: 0,1:00:53.23,1:00:55.86,Default,,0,0,0,,Бұл арқан толық созылғанда
Dialogue: 0,1:00:56.11,1:00:58.27,Default,,0,0,0,,Осы шүберекпен, араларында арқанмен.
Dialogue: 0,1:00:59.11,1:01:01.44,Default,,0,0,0,,Егер сіз осылай төмен сырғып кетсеңіз...
Dialogue: 0,1:01:01.90,1:01:04.16,Default,,0,0,0,,Сіз бірден көлікке бара аласыз.
Dialogue: 0,1:01:04.36,1:01:06.99,Default,,0,0,0,,Осыдан кейін табыс енді қол жетімді болмайды.
Dialogue: 0,1:01:07.08,1:01:08.08,Default,,0,0,0,,(Қараңыз!)
Dialogue: 0,1:01:08.24,1:01:09.24,Default,,0,0,0,,Паки?
Dialogue: 0,1:01:11.70,1:01:13.50,Default,,0,0,0,,Се... Сешакузай?
Dialogue: 0,1:01:13.58,1:01:15.42,Default,,0,0,0,,Бұл сапасыз құрылыс жұмысы.
Dialogue: 0,1:01:15.71,1:01:18.38,Default,,0,0,0,,Брюль, құрылыс шығындарына сараң болдың.
Dialogue: 0,1:01:18.59,1:01:19.67,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:01:19.96,1:01:22.55,Default,,0,0,0,,Ахх!
Dialogue: 0,1:01:25.34,1:01:27.35,Default,,0,0,0,,Ариус-чан кетіп бара жатыр~!
Dialogue: 0,1:01:27.43,1:01:29.47,Default,,0,0,0,,Бұл қауіпті, Зоори мырза!
Dialogue: 0,1:01:29.56,1:01:32.43,Default,,0,0,0,,Мен Сакугото аламын деп ешқашан ойламаппын...
Dialogue: 0,1:01:32.52,1:01:33.81,Default,,0,0,0,,Зорори! (Ношиши Ишиши) Иә?
Dialogue: 0,1:01:34.44,1:01:38.27,Default,,0,0,0,,Ешқандай шаңсыз ішке кіріңіз.
Dialogue: 0,1:01:39.32,1:01:41.98,Default,,0,0,0,,Мен сізден сол рюкзактың ішіндегісін қайтаруыңызды сұраймын.
Dialogue: 0,1:01:42.36,1:01:43.78,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,1:01:44.07,1:01:47.62,Default,,0,0,0,,Мәрмәр шоколады - бұл біздің компанияның жарияланғанға дейінгі маңызды жаңа өнімі.
Dialogue: 0,1:01:47.91,1:01:49.62,Default,,0,0,0,,Мен саған ешнәрсе істемеймін!
Dialogue: 0,1:01:49.74,1:01:50.58,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:01:53.50,1:01:55.83,Default,,0,0,0,,Ойлан, Зори-кун
Dialogue: 0,1:01:55.92,1:01:59.00,Default,,0,0,0,,Жоқ... бұл жолы сәл басқаша!
Dialogue: 0,1:01:59.09,1:02:00.17,Default,,0,0,0,,Зорори...
Dialogue: 0,1:02:00.88,1:02:01.88,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:02:01.96,1:02:03.21,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:02:03.51,1:02:04.80,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,1:02:04.88,1:02:08.22,Default,,0,0,0,,Бұл көптеген балаларды құтқаратын маңызды дәрі...
Dialogue: 0,1:02:08.55,1:02:10.47,Default,,0,0,0,,Тағы да аузыңызға қалдырыңыз.
Dialogue: 0,1:02:10.56,1:02:12.89,Default,,0,0,0,,Жақсырақ өтірік ойлап көріңіз.
Dialogue: 0,1:02:12.97,1:02:14.39,Default,,0,0,0,,Жоқ, бұл рас!
Dialogue: 0,1:02:14.64,1:02:16.10,Default,,0,0,0,,Өйткені осы уақытқа дейін
Dialogue: 0,1:02:16.19,1:02:18.60,Default,,0,0,0,,Мен не айтсам да, олар маған сенбейді!
Dialogue: 0,1:02:18.69,1:02:19.98,Default,,0,0,0,,Қат!
Dialogue: 0,1:02:20.06,1:02:21.23,Default,,0,0,0,,Әй, мұғалім...
Dialogue: 0,1:02:21.32,1:02:22.15,Default,,0,0,0,,Әй?
Dialogue: 0,1:02:22.23,1:02:23.07,Default,,0,0,0,,Иә!
Dialogue: 0,1:02:26.20,1:02:28.24,Default,,0,0,0,,Бұл қаншалықты үлкен, Кейбиман?
Dialogue: 0,1:02:28.66,1:02:30.12,Default,,0,0,0,,Ишиши Ношиши кел!
Dialogue: 0,1:02:31.78,1:02:32.95,Default,,0,0,0,,Бұл тайғақ!
Dialogue: 0,1:02:33.04,1:02:34.62,Default,,0,0,0,,Көтерілу қиын
Dialogue: 0,1:02:34.83,1:02:35.87,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:02:37.92,1:02:41.21,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,1:02:43.80,1:02:45.97,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:02:46.05,1:02:47.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:51.72,1:02:52.97,Default,,0,0,0,,Сіз өте табандысыз
Dialogue: 0,1:02:53.51,1:02:54.35,Default,,0,0,0,,Хмф!
Dialogue: 0,1:02:54.89,1:02:56.43,Default,,0,0,0,,Уау! (Зорондо Робо) Бум!
Dialogue: 0,1:02:57.81,1:02:58.81,Default,,0,0,0,,Не... не?
Dialogue: 0,1:02:58.90,1:03:00.73,Default,,0,0,0,,Не!
Dialogue: 0,1:03:05.07,1:03:05.94,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,1:03:06.82,1:03:08.07,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,1:03:09.82,1:03:10.91,Default,,0,0,0,,Не...
Dialogue: 0,1:03:10.99,1:03:13.45,Default,,0,0,0,,Сен бізді қорғайсың ба?
Dialogue: 0,1:03:13.74,1:03:14.58,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,1:03:15.12,1:03:17.96,Default,,0,0,0,,Қазір ондай жерде қиналатын уақыт емес.
Dialogue: 0,1:03:18.29,1:03:19.54,Default,,0,0,0,,Дәріге не болды?
Dialogue: 0,1:03:21.54,1:03:24.17,Default,,0,0,0,,Маған сын айтудың қажеті жоқ!
Dialogue: 0,1:03:24.46,1:03:25.96,Default,,0,0,0,,Тіпті дәрі де осында.
Dialogue: 0,1:03:27.63,1:03:30.76,Default,,0,0,0,,Мен тіпті Косей-но-Уға көлік дайындадым.
Dialogue: 0,1:03:30.84,1:03:33.05,Default,,0,0,0,,Егер сәтсіздікке ұшырасаң, мен тұра алмаймын.
Dialogue: 0,1:03:33.47,1:03:34.31,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:34.39,1:03:37.39,Default,,0,0,0,,Бұл, әрине, көмектесті.
Dialogue: 0,1:03:37.81,1:03:40.10,Default,,0,0,0,,Олай болса, маған көрсеткеніңізді қалаймын.
Dialogue: 0,1:03:40.23,1:03:41.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:41.94,1:03:44.07,Default,,0,0,0,,Мен саған көбірек бақытты бол деп айтып отырмын.
Dialogue: 0,1:03:44.27,1:03:45.86,Default,,0,0,0,,Маған қарашы, бұл Банзай.
Dialogue: 0,1:03:45.94,1:03:46.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:47.24,1:03:49.40,Default,,0,0,0,,Банзай. Сіз білмейсіз бе?
Dialogue: 0,1:03:49.49,1:03:50.40,Default,,0,0,0,,Мен білемін!
Dialogue: 0,1:03:51.07,1:03:52.32,Default,,0,0,0,,Міне, кеттік.
Dialogue: 0,1:03:52.41,1:03:54.95,Default,,0,0,0,,Қолдарыңызды көтеріп, сәлем беріңіздер!
Dialogue: 0,1:03:55.58,1:03:57.37,Default,,0,0,0,,B… Banzai
Dialogue: 0,1:04:04.71,1:04:05.75,Default,,0,0,0,,Тістемеңіз!
Dialogue: 0,1:04:05.84,1:04:06.88,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:04:08.92,1:04:10.34,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:04:11.97,1:04:13.80,Default,,0,0,0,,Зори-сан және басқалары шықты.
Dialogue: 0,1:04:14.18,1:04:15.47,Default,,0,0,0,,Біз де кеттік!
Dialogue: 0,1:04:15.56,1:04:16.39,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:16.51,1:04:18.39,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:04:29.03,1:04:31.45,Default,,0,0,0,,Ах, менің етігім...
Dialogue: 0,1:04:31.95,1:04:35.20,Default,,0,0,0,,Ал, енді балаларды құтқара аламыз, жарай ма?
Dialogue: 0,1:04:36.66,1:04:37.49,Default,,0,0,0,,Нуху~!
Dialogue: 0,1:04:37.58,1:04:40.45,Default,,0,0,0,,Енді Ариус-чанға ұсыныс жасайтын кез келді.
Dialogue: 0,1:04:40.54,1:04:41.62,Default,,0,0,0,,Корпус мүшелеріне бір-біріне негізсіз қылыш кезенуге мүлде болмайды!
Dialogue: 0,1:04:41.71,1:04:42.54,Default,,0,0,0,,Уау... аа!
Dialogue: 0,1:04:42.96,1:04:47.38,Default,,0,0,0,,Лукуто да Зоори-сенсейден үлгі алатынын және мойындайтынын айтты.
Dialogue: 0,1:04:47.46,1:04:48.59,Default,,0,0,0,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,1:04:48.67,1:04:51.01,Default,,0,0,0,,Егер кері оралсақ, Кеккон формуласы
Dialogue: 0,1:04:51.09,1:04:53.22,Default,,0,0,0,,Сонымен, сіз екіні күтіп отырсыз.
Dialogue: 0,1:04:53.84,1:04:56.39,Default,,0,0,0,,Осы уақытқа дейін кез келген басқа шытырман оқиғадан жақсырақ.
Dialogue: 0,1:04:56.47,1:04:57.43,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,1:04:57.85,1:04:58.76,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,1:04:58.97,1:05:00.85,Default,,0,0,0,,Бір кезде мен не болар екен деп ойладым.
Dialogue: 0,1:05:01.31,1:05:02.52,Default,,0,0,0,,Мен қазір өзімді қауіпсіз сезінемін.
Dialogue: 0,1:05:03.02,1:05:05.94,Default,,0,0,0,,Солай болса да, Зорори мырза мен Зорондо Рон мырза...
Dialogue: 0,1:05:06.02,1:05:09.44,Default,,0,0,0,,Саған қарыздар болғаным сонша, ашуым кетсе де, оны тоқтата алмаймын.
Dialogue: 0,1:05:09.86,1:05:10.74,Default,,0,0,0,,Иә
Dialogue: 0,1:05:10.99,1:05:12.19,Default,,0,0,0,,Осы сапарда I
Dialogue: 0,1:05:12.28,1:05:15.20,Default,,0,0,0,,Мен Зори-саннан үлкен батылдық алған сияқтымын.
Dialogue: 0,1:05:15.82,1:05:16.74,Default,,0,0,0,,Иә.
Dialogue: 0,1:05:17.03,1:05:19.29,Default,,0,0,0,,Бұл жолы мен батылдығымды жинадым...
Dialogue: 0,1:05:20.49,1:05:21.62,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,1:05:23.96,1:05:25.12,Default,,0,0,0,,Мрамор шоколады
Dialogue: 0,1:05:25.21,1:05:28.54,Default,,0,0,0,,Біздің компанияның тағдырын анықтайтын маңызды жаңа оқиғалар
Dialogue: 0,1:05:28.79,1:05:30.76,Default,,0,0,0,,Оны кімге беруім керек?
Dialogue: 0,1:05:30.84,1:05:32.17,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:05:34.38,1:05:35.22,Default,,0,0,0,,Біз жетеміз!
Dialogue: 0,1:05:35.72,1:05:36.55,Default,,0,0,0,,Иә
Dialogue: 0,1:05:39.31,1:05:40.72,Default,,0,0,0,,Уф...
Dialogue: 0,1:05:47.52,1:05:48.36,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,1:05:48.44,1:05:50.07,Default,,0,0,0,,Жоқ, солға!
Dialogue: 0,1:06:05.25,1:06:06.08,Default,,0,0,0,,Хехе
Dialogue: 0,1:06:06.17,1:06:07.54,Default,,0,0,0,,...
Dialogue: 0,1:06:10.54,1:06:11.42,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:18.01,1:06:19.85,Default,,0,0,0,,Одан жалтармасаң, соғасың!
Dialogue: 0,1:06:21.14,1:06:22.01,Default,,0,0,0,,Бастайық!
Dialogue: 0,1:06:22.10,1:06:22.97,Default,,0,0,0,,Рюкай!
Dialogue: 0,1:06:24.81,1:06:25.64,Default,,0,0,0,,Гуфуфу
Dialogue: 0,1:06:31.86,1:06:32.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:36.03,1:06:36.99,Default,,0,0,0,,Ағам саған айтпады ма?
Dialogue: 0,1:06:37.45,1:06:38.91,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,1:06:38.99,1:06:41.24,Default,,0,0,0,,Бұл тікұшақ ұша алады.
Dialogue: 0,1:06:41.49,1:06:43.45,Default,,0,0,0,,Кішкентай тасты машинаның жөтеліне жол берсеңіз
Dialogue: 0,1:06:43.83,1:06:46.41,Default,,0,0,0,,Радар сізге қайда екеніңізді көрсетеді!
Dialogue: 0,1:06:47.00,1:06:49.08,Default,,0,0,0,,Бұл өте керемет!
Dialogue: 0,1:06:52.00,1:06:54.67,Default,,0,0,0,,Жүгіріп, жалтарыңыз!
Dialogue: 0,1:06:54.76,1:06:57.09,Default,,0,0,0,,Кобл-кун, оны осында әкел.
Dialogue: 0,1:06:57.30,1:06:58.38,Default,,0,0,0,,Иә, айса~!
Dialogue: 0,1:07:01.39,1:07:02.22,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,1:07:02.56,1:07:03.39,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:07:03.64,1:07:07.02,Default,,0,0,0,,Егер мен оны қайтара алмасам, мен мұны істеймін!
Dialogue: 0,1:07:07.60,1:07:08.98,Default,,0,0,0,,Эй!
Dialogue: 0,1:07:09.19,1:07:11.06,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:07:12.44,1:07:13.27,Default,,0,0,0,,Уф...
Dialogue: 0,1:07:13.36,1:07:14.23,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:16.90,1:07:18.53,Default,,0,0,0,,Сіз қалай батылсыз!
Dialogue: 0,1:07:18.61,1:07:22.16,Default,,0,0,0,,Медицина барлық балаларға қол жетімді болмайды!
Dialogue: 0,1:07:22.28,1:07:24.54,Default,,0,0,0,,Осы уақыт ішінде бізге қалдырыңыз!
Dialogue: 0,1:07:24.99,1:07:26.62,Default,,0,0,0,,Мен мұны сізге қалдыра алмаймын!
Dialogue: 0,1:07:26.95,1:07:28.50,Default,,0,0,0,,Ах, дәрі...
Dialogue: 0,1:07:28.83,1:07:30.54,Default,,0,0,0,,Бас тартуға әлі ерте!
Dialogue: 0,1:07:30.62,1:07:31.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:33.46,1:07:34.46,Default,,0,0,0,,Не істемекшісің?
Dialogue: 0,1:07:37.30,1:07:39.47,Default,,0,0,0,,Жарайды, маған қалдырыңыз!
Dialogue: 0,1:07:47.89,1:07:48.73,Default,,0,0,0,,Хахахаха…
Dialogue: 0,1:07:48.98,1:07:50.64,Default,,0,0,0,,Зоори мырза керемет.
Dialogue: 0,1:07:51.15,1:07:52.69,Default,,0,0,0,,Хаха, бұл жақсы.
Dialogue: 0,1:07:52.77,1:07:55.15,Default,,0,0,0,,Баратын жер дәл сіздің алдыңызда
Dialogue: 0,1:07:57.61,1:07:58.44,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:08:03.07,1:08:03.99,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:09.41,1:08:10.41,Default,,0,0,0,,Лукт!
Dialogue: 0,1:08:10.83,1:08:12.46,Default,,0,0,0,,Ариус! Жақсы болды ма?
Dialogue: 0,1:08:12.58,1:08:13.42,Default,,0,0,0,,Медицина ше?
Dialogue: 0,1:08:13.83,1:08:16.42,Default,,0,0,0,,Иә! Зори-сан әлі сонда ма?
Dialogue: 0,1:08:16.55,1:08:18.34,Default,,0,0,0,,(Brrrrrrr…)
Dialogue: 0,1:08:19.80,1:08:21.51,Default,,0,0,0,,Бұл Зори-сан және басқалар!
Dialogue: 0,1:08:23.84,1:08:26.39,Default,,0,0,0,,Сәлем! Мен сені күтуге мәжбүр еттім
Dialogue: 0,1:08:26.47,1:08:27.72,Default,,0,0,0,,Мен оны қазір аламын.
Dialogue: 0,1:08:27.85,1:08:28.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:28.93,1:08:29.89,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:31.52,1:08:32.35,Default,,0,0,0,,Тәтті
Dialogue: 0,1:08:32.69,1:08:34.02,Default,,0,0,0,,Эхе... эхехе
Dialogue: 0,1:08:39.24,1:08:40.78,Default,,0,0,0,,Не? (Зорондо Рон) Чи…
Dialogue: 0,1:08:43.36,1:08:44.20,Default,,0,0,0,,Хехе
Dialogue: 0,1:08:44.87,1:08:46.37,Default,,0,0,0,,Не? Сол тікұшақ
Dialogue: 0,1:08:46.58,1:08:47.95,Default,,0,0,0,,Неге кедергі жасау керек?
Dialogue: 0,1:08:48.04,1:08:50.37,Default,,0,0,0,,Доктор Мурроу! Қайтып келіңізші
Dialogue: 0,1:08:51.75,1:08:52.58,Default,,0,0,0,,Зоори мырза...
Dialogue: 0,1:08:53.42,1:08:55.21,Default,,0,0,0,,Өтінемін, асығыңыз!
Dialogue: 0,1:08:56.88,1:08:59.92,Default,,0,0,0,,Балалардың салмағы артып бара жатқан сияқты.
Dialogue: 0,1:09:00.17,1:09:01.34,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:09:03.26,1:09:05.34,Default,,0,0,0,,Сен жақсы қызсың. Сіз мені жақсы ұстадыңыз.
Dialogue: 0,1:09:05.64,1:09:06.47,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,1:09:06.55,1:09:08.72,Default,,0,0,0,,Маған жеңілірек нәрсе жасап көрейін.
Dialogue: 0,1:09:08.97,1:09:10.22,Default,,0,0,0,,Дәрі-дәрмекті жерге түсірмеңіз
Dialogue: 0,1:09:10.64,1:09:11.98,Default,,0,0,0,,Бұл... жоғалып кетті ме?
Dialogue: 0,1:09:12.18,1:09:13.77,Default,,0,0,0,,Президент Брул, өтінемін!
Dialogue: 0,1:09:13.85,1:09:14.69,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,1:09:20.32,1:09:21.90,Default,,0,0,0,,Ах, бұл жол...
Dialogue: 0,1:09:21.99,1:09:23.32,Default,,0,0,0,,Есіме түссе ашуланамын
Dialogue: 0,1:09:24.49,1:09:25.91,Default,,0,0,0,,Не? Міне осы!
Dialogue: 0,1:09:26.45,1:09:28.03,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:28.12,1:09:29.49,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:09:29.58,1:09:31.54,Default,,0,0,0,,Өздігінен ұшып кетті.
Dialogue: 0,1:09:31.66,1:09:32.50,Default,,0,0,0,,Артқа
Dialogue: 0,1:09:32.58,1:09:33.41,Default,,0,0,0,,О!
Dialogue: 0,1:09:35.00,1:09:36.71,Default,,0,0,0,,Қарғыс атсын саған Зори!
Dialogue: 0,1:09:37.75,1:09:40.09,Default,,0,0,0,,Доктор Мурроу! Бір сәтке келіңіз!
Dialogue: 0,1:09:40.42,1:09:41.30,Default,,0,0,0,,Енді жүр!
Dialogue: 0,1:09:42.13,1:09:43.38,Default,,0,0,0,,Ыстық бөртпе қорқынышты
Dialogue: 0,1:09:43.76,1:09:45.18,Default,,0,0,0,,Менің қызуым көтеріліп жатыр.
Dialogue: 0,1:09:45.30,1:09:46.93,Default,,0,0,0,,Ах
Dialogue: 0,1:09:47.93,1:09:49.26,Default,,0,0,0,,(Бум!)
Dialogue: 0,1:09:54.81,1:09:56.81,Default,,0,0,0,,Неге оралдың?
Dialogue: 0,1:09:56.90,1:09:59.57,Default,,0,0,0,,Жаман, іштегі балалар...
Dialogue: 0,1:09:59.65,1:10:00.48,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,1:10:02.23,1:10:04.07,Default,,0,0,0,,Қария! балалар
Dialogue: 0,1:10:05.28,1:10:06.86,Default,,0,0,0,,Барлығына! Балалар!
Dialogue: 0,1:10:17.96,1:10:18.79,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:24.13,1:10:25.17,Default,,0,0,0,,Шатыр...
Dialogue: 0,1:10:25.26,1:10:26.47,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,1:10:26.97,1:10:29.85,Default,,0,0,0,,Тағы біраз күтіңіз. Тағы біраз күтіңіз.
Dialogue: 0,1:10:30.51,1:10:32.77,Default,,0,0,0,,Мен оны осы жолы ішетініме сенімдімін.
Dialogue: 0,1:10:33.31,1:10:34.56,Default,,0,0,0,,Өйткені ол өте тәтті болды
Dialogue: 0,1:10:34.64,1:10:35.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:35.98,1:10:36.81,Default,,0,0,0,,Міне!
Dialogue: 0,1:10:37.14,1:10:38.90,Default,,0,0,0,,Ұшақтың жылдамдығы мен желдің бағыты...
Dialogue: 0,1:10:39.23,1:10:40.69,Default,,0,0,0,,Ха... жоқ, жоқ, жоқ
Dialogue: 0,1:10:41.19,1:10:44.19,Default,,0,0,0,,Есептер маңызды, бірақ жалғыз емес шығар.
Dialogue: 0,1:10:44.90,1:10:47.20,Default,,0,0,0,,Мен сол адамдардың мұны істейтініне сенімдімін!
Dialogue: 0,1:10:50.99,1:10:52.03,Default,,0,0,0,,(Бум!)
Dialogue: 0,1:10:53.66,1:10:54.66,Default,,0,0,0,,Зоронд Рон
Dialogue: 0,1:10:55.33,1:10:57.83,Default,,0,0,0,,Сіз маған роботыңызбен көмектесе аласыз ба?
Dialogue: 0,1:10:58.21,1:11:00.46,Default,,0,0,0,,Егер солай болса, біз дәріні бірден жеткізе аламыз.
Dialogue: 0,1:11:00.96,1:11:02.54,Default,,0,0,0,,Дадомо Зори Сенсей
Dialogue: 0,1:11:02.63,1:11:04.76,Default,,0,0,0,,Олай болса, Зори-сенсэйдің тістері...
Dialogue: 0,1:11:04.84,1:11:07.38,Default,,0,0,0,,Менің тырнақтарым және балаларымның өмірі
Dialogue: 0,1:11:07.55,1:11:10.26,Default,,0,0,0,,Мен енді таразыға қою сияқты нәрселерге еліктей алмаймын.
Dialogue: 0,1:11:10.59,1:11:11.43,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,1:11:12.01,1:11:13.18,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,1:11:14.14,1:11:16.31,Default,,0,0,0,,Ол жай ғана бұзылды.
Dialogue: 0,1:11:16.39,1:11:17.39,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,1:11:17.48,1:11:18.81,Default,,0,0,0,,Зорори-сан!
Dialogue: 0,1:11:19.31,1:11:21.02,Default,,0,0,0,,Иккокудың Ююйосы жоқ.
Dialogue: 0,1:11:21.48,1:11:22.56,Default,,0,0,0,,Аспаннан
Dialogue: 0,1:11:22.65,1:11:26.15,Default,,0,0,0,,Гимназиядағы балаларға дәрі шашыңыз.
Dialogue: 0,1:11:26.36,1:11:28.45,Default,,0,0,0,,Маған соңғы рет беріңізші!
Dialogue: 0,1:11:29.95,1:11:33.20,Default,,0,0,0,,Сол тар жерде бірде-бір кесек қалмады...
Dialogue: 0,1:11:33.53,1:11:36.16,Default,,0,0,0,,Біз оны жай ғана таратамыз, бірақ мұны істей аламыз ба?
Dialogue: 0,1:11:37.04,1:11:38.79,Default,,0,0,0,,Кімге айтып жатырсың?
Dialogue: 0,1:11:39.42,1:11:40.50,Default,,0,0,0,,Келіңіздер, бәріңіз!
Dialogue: 0,1:11:40.67,1:11:43.38,Default,,0,0,0,,Аспаннан тәтті шоколад түсіп жатыр
Dialogue: 0,1:11:43.71,1:11:45.55,Default,,0,0,0,,Аузыңызды кең ашып, күтіңіз.
Dialogue: 0,1:12:08.44,1:12:09.70,Default,,0,0,0,,Тәтті
Dialogue: 0,1:12:10.65,1:12:13.41,Default,,0,0,0,,А, жақсы... Мен келдім.
Dialogue: 0,1:12:14.03,1:12:14.91,Default,,0,0,0,,Бұл да!
Dialogue: 0,1:12:15.41,1:12:17.45,Default,,0,0,0,,Мұндағы барлық балалар!
Dialogue: 0,1:12:18.25,1:12:19.96,Default,,0,0,0,,Тәтті
Dialogue: 0,1:12:20.08,1:12:22.54,Default,,0,0,0,,Жақсы! Бұл бәріне көмектеседі!
Dialogue: 0,1:12:23.42,1:12:24.59,Default,,0,0,0,,Дұрыс!
Dialogue: 0,1:12:25.79,1:12:27.84,Default,,0,0,0,,Барлығына барайық!
Dialogue: 0,1:12:34.30,1:12:36.47,Default,,0,0,0,,Барлығы... Жақсы.
Dialogue: 0,1:12:37.26,1:12:41.23,Default,,0,0,0,,Рахмет, Зорори мырза және Зорондо Рон мырза!
Dialogue: 0,1:12:43.23,1:12:46.27,Default,,0,0,0,,Мен бұл жолы қателескен жоқпын.
Dialogue: 0,1:12:46.36,1:12:48.19,Default,,0,0,0,,Неліктен бұл орын алады?
Dialogue: 0,1:12:48.28,1:12:51.03,Default,,0,0,0,,Олар байқамайды деп үміттенемін.
Dialogue: 0,1:12:51.11,1:12:52.95,Default,,0,0,0,,Көмек!
Dialogue: 0,1:12:54.11,1:12:58.08,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,1:12:58.70,1:13:00.95,Default,,0,0,0,,Қазір бәрі жақсы сезінеді.
Dialogue: 0,1:13:01.25,1:13:03.54,Default,,0,0,0,,Дәрі дер кезінде келгеніне қуаныштымын.
Dialogue: 0,1:13:03.62,1:13:04.54,Default,,0,0,0,,Тыңда, тыңда!
Dialogue: 0,1:13:04.63,1:13:05.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:06.17,1:13:07.29,Default,,0,0,0,,Матч шешілді!
Dialogue: 0,1:13:07.38,1:13:08.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:08.30,1:13:10.92,Default,,0,0,0,,Лукто Сіз дұрыс мойындадыңыз!
Dialogue: 0,1:13:11.01,1:13:13.30,Default,,0,0,0,,Шынымды айтсам, келесі кезек Зорори-сенсейде!
Dialogue: 0,1:13:13.38,1:13:14.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:14.30,1:13:17.01,Default,,0,0,0,,Ой, жоқ~ Ахахаха
Dialogue: 0,1:13:17.39,1:13:18.39,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,1:13:18.47,1:13:19.81,Default,,0,0,0,,Ах, Ариус-чан
Dialogue: 0,1:13:21.23,1:13:22.06,Default,,0,0,0,,Ах
Dialogue: 0,1:13:22.14,1:13:23.69,Default,,0,0,0,,Агрессивті
Dialogue: 0,1:13:23.98,1:13:27.31,Default,,0,0,0,,Зори-сан, өтінемін, біздің тебу рәсімі...
Dialogue: 0,1:13:27.77,1:13:29.82,Default,,0,0,0,,Жоқ, жоқ, Ариус.
Dialogue: 0,1:13:29.94,1:13:32.69,Default,,0,0,0,,Мұндай істі ер адамдар бастауы керек.
Dialogue: 0,1:13:33.32,1:13:35.53,Default,,0,0,0,,Бірақ мен көпке дейін қолымды жібере алмадым.
Dialogue: 0,1:13:35.95,1:13:39.03,Default,,0,0,0,,Себебі балаларды құтқару бірінші орында...
Dialogue: 0,1:13:39.16,1:13:40.66,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,1:13:42.16,1:13:46.17,Default,,0,0,0,,Енді бәрі өзгерді...
Dialogue: 0,1:13:46.33,1:13:47.50,Default,,0,0,0,,Иә! иә?
Dialogue: 0,1:13:47.75,1:13:50.80,Default,,0,0,0,,Енді ғана сен мені ақыры мойындадың!
Dialogue: 0,1:13:50.92,1:13:53.92,Default,,0,0,0,,Не? Жоқ, мен әлі жоқпын...
Dialogue: 0,1:13:54.59,1:13:56.09,Default,,0,0,0,,Барлығына рахмет
Dialogue: 0,1:13:56.72,1:13:59.18,Default,,0,0,0,,Не? Не? Не айтқың келеді?
Dialogue: 0,1:13:59.39,1:14:02.85,Default,,0,0,0,,Мм...Мені Ишиши мырза мен Ношиши мырза итеріп жіберді.
Dialogue: 0,1:14:02.93,1:14:04.60,Default,,0,0,0,,Мен ақыры мойындадым.
Dialogue: 0,1:14:04.85,1:14:06.19,Default,,0,0,0,,Сонда, ақсақал...
Dialogue: 0,1:14:06.40,1:14:08.90,Default,,0,0,0,,Жоқ, Ариус мырза да жарайды деді.
Dialogue: 0,1:14:09.27,1:14:11.28,Default,,0,0,0,,Лукутоның серіктесі - Мами-чан...
Dialogue: 0,1:14:11.36,1:14:13.99,Default,,0,0,0,,Не? Мен Лукуттың әпкесімін
Dialogue: 0,1:14:14.40,1:14:15.24,Default,,0,0,0,,Наги…
Dialogue: 0,1:14:15.61,1:14:19.41,Default,,0,0,0,,Өйткені мен жалғызсырап, Лукутқа жабысып...
Dialogue: 0,1:14:20.03,1:14:22.62,Default,,0,0,0,,Бұл жігіт кішкентайынан жалғызсырап келеді.
Dialogue: 0,1:14:23.04,1:14:26.00,Default,,0,0,0,,Бірақ ағамның төбелесіне Дай-сан кінәлі!
Dialogue: 0,1:14:26.25,1:14:27.42,Default,,0,0,0,,Ариус сияқты
Dialogue: 0,1:14:27.50,1:14:30.54,Default,,0,0,0,,Сізде мейірімді және тамаша апа болуы мүмкін.
Dialogue: 0,1:14:30.79,1:14:32.67,Default,,0,0,0,,Сонда Ариус былай деді...
Dialogue: 0,1:14:32.75,1:14:35.01,Default,,0,0,0,,«Біздің тебу рәсімі» бұл...
Dialogue: 0,1:14:36.55,1:14:38.14,Default,,0,0,0,,Зоори мырза, біз...
Dialogue: 0,1:14:38.22,1:14:40.64,Default,,0,0,0,,Жоқ, бұл Ғапапа ауылындағы Онжин.
Dialogue: 0,1:14:40.93,1:14:45.06,Default,,0,0,0,,Сондықтан ертеңгі ашылу салтанатына қатысуыңызды қалаймын.
Dialogue: 0,1:14:45.52,1:14:48.27,Default,,0,0,0,,Ахаха ахахаха…
Dialogue: 0,1:14:49.31,1:14:52.23,Default,,0,0,0,,Ал, не болса да, жақсы, Лукут.
Dialogue: 0,1:14:52.57,1:14:54.23,Default,,0,0,0,,Ариусты да құттықтаймыз.
Dialogue: 0,1:14:54.74,1:14:59.03,Default,,0,0,0,,Иә! Балалар аман қалды, барлығы бақытты.
Dialogue: 0,1:14:59.32,1:15:02.12,Default,,0,0,0,,Мен де бар күшімді салдым, бірақ бәрібір.
Dialogue: 0,1:15:02.20,1:15:04.87,Default,,0,0,0,,Ах, бүгін түнде ауылды құтқарған Эйюуни.
Dialogue: 0,1:15:04.95,1:15:06.75,Default,,0,0,0,,Қанша әнін дайындап жатырмын.
Dialogue: 0,1:15:07.04,1:15:07.92,Default,,0,0,0,,Не!
Dialogue: 0,1:15:08.17,1:15:10.29,Default,,0,0,0,,Мен басты кейіпкерлерді, Зоориді және басқаларды көргім келеді...
Dialogue: 0,1:15:10.38,1:15:11.54,Default,,0,0,0,,Кацудон бар ма?
Dialogue: 0,1:15:12.54,1:15:14.34,Default,,0,0,0,,Бұл біз емес.
Dialogue: 0,1:15:14.76,1:15:15.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:16.05,1:15:19.34,Default,,0,0,0,,Дәл сол қызыл ұшақтың арқасында дәрі-дәрмекті тасымалдай алдық.
Dialogue: 0,1:15:20.43,1:15:23.14,Default,,0,0,0,,Сондықтан біз басты кейіпкер емеспіз.
Dialogue: 0,1:15:23.26,1:15:25.60,Default,,0,0,0,,Зоронд Рон.
Dialogue: 0,1:15:26.10,1:15:27.94,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:15:28.10,1:15:29.85,Default,,0,0,0,,Зори-санның талпынысы болмаса
Dialogue: 0,1:15:29.94,1:15:32.73,Default,,0,0,0,,Балалар дәрілерін іше алмады.
Dialogue: 0,1:15:32.90,1:15:36.57,Default,,0,0,0,,Доктор Маллоу да Зоронд Рон мырзамен сөйлеспекші.
Dialogue: 0,1:15:36.94,1:15:38.90,Default,,0,0,0,,Сондықтан, Зори-сан және басқалар, өтінемін
Dialogue: 0,1:15:43.16,1:15:44.28,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:15:44.37,1:15:47.66,Default,,0,0,0,,Ұшақтың қанатында ұзақ ілінгендіктен.
Dialogue: 0,1:15:47.75,1:15:49.87,Default,,0,0,0,,Менің денем толығымен суық.
Dialogue: 0,1:15:50.04,1:15:52.42,Default,,0,0,0,,Мен жылап отырып шомылғым келеді.
Dialogue: 0,1:15:53.04,1:15:55.96,Default,,0,0,0,,Түсіндім, мен сені өтетін жерде күтемін.
Dialogue: 0,1:15:56.21,1:15:57.09,Default,,0,0,0,,О
Dialogue: 0,1:15:57.42,1:15:58.92,Default,,0,0,0,,Ишиши Ношиши
Dialogue: 0,1:15:59.01,1:15:59.84,Default,,0,0,0,,Иә
Dialogue: 0,1:16:00.84,1:16:04.76,Default,,0,0,0,,Балалар да Зоориге және басқаларға алғыс айтқысы келеді.
Dialogue: 0,1:16:05.14,1:16:06.56,Default,,0,0,0,,Зоори мырза...
Dialogue: 0,1:16:06.81,1:16:08.14,Default,,0,0,0,,Мен білемін.
Dialogue: 0,1:16:08.31,1:16:10.31,Default,,0,0,0,,Адамның жүрегі мұңды
Dialogue: 0,1:16:11.02,1:16:12.48,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,1:16:14.82,1:16:16.86,Default,,0,0,0,,Сенің арқаңда ауыл аман қалды.
Dialogue: 0,1:16:17.07,1:16:20.49,Default,,0,0,0,,Ең болмаса, бұл жақсы сезім деп ойлаймын...
Dialogue: 0,1:16:21.82,1:16:24.70,Default,,0,0,0,,Кешіріңіз, бірақ келесі шытырман оқиға күтіп тұр.
Dialogue: 0,1:16:25.66,1:16:28.33,Default,,0,0,0,,Ал мен ашуланатын адам емеспін.
Dialogue: 0,1:16:28.45,1:16:29.71,Default,,0,0,0,,Президент Брул
Dialogue: 0,1:16:29.83,1:16:30.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:30.75,1:16:33.33,Default,,0,0,0,,Балалар дәрі іше бастады
Dialogue: 0,1:16:33.46,1:16:35.38,Default,,0,0,0,,Брул шоколадының арқасында.
Dialogue: 0,1:16:36.67,1:16:38.51,Default,,0,0,0,,Буруру фабрикасысыз
Dialogue: 0,1:16:38.59,1:16:41.76,Default,,0,0,0,,Балалар әлі өлмеген болар.
Dialogue: 0,1:16:42.09,1:16:44.51,Default,,0,0,0,,Бұл рас болуы мүмкін, бірақ...
Dialogue: 0,1:16:53.81,1:16:55.61,Default,,0,0,0,,Онда сіз сарапшы болуыңыз керек.
Dialogue: 0,1:16:56.11,1:16:58.07,Default,,0,0,0,,Соңында бір нәрсе айтыңызшы.
Dialogue: 0,1:16:59.03,1:17:00.90,Default,,0,0,0,,Неліктен алысқа бардың?
Dialogue: 0,1:17:01.53,1:17:03.20,Default,,0,0,0,,Сіз Зори-санға күш қолдандыңыз ба?
Dialogue: 0,1:17:12.00,1:17:13.42,Default,,0,0,0,,Неге...
Dialogue: 0,1:17:14.37,1:17:16.17,Default,,0,0,0,,Зори деген адам
Dialogue: 0,1:17:16.38,1:17:19.34,Default,,0,0,0,,Мен өзім туралы бірдеңе бар деп ойладым.
Dialogue: 0,1:17:19.80,1:17:20.80,Default,,0,0,0,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,1:17:22.72,1:17:23.63,Default,,0,0,0,,Иә
Dialogue: 0,1:17:23.80,1:17:25.68,Default,,0,0,0,,Жоқ, әлгі тәтті бала
Dialogue: 0,1:17:25.76,1:17:28.89,Default,,0,0,0,,Оның соншалықты күшті болып өскенін елестете алмаймын.
Dialogue: 0,1:17:30.18,1:17:31.98,Default,,0,0,0,,Сәлем Зоролин
Dialogue: 0,1:17:40.03,1:17:42.90,Default,,0,0,0,,Хаа~ Гокураку Гокураку
Dialogue: 0,1:17:43.40,1:17:46.74,Default,,0,0,0,,Көк аспан астында демалу
Dialogue: 0,1:17:46.82,1:17:49.95,Default,,0,0,0,,Барлығы кішкентай сияқты
Dialogue: 0,1:17:50.04,1:17:51.70,Default,,0,0,0,,Мынаны қараңыз! иә?
Dialogue: 0,1:17:52.25,1:17:54.96,Default,,0,0,0,,Президент Брул, сіз өте сыпайысың!
Dialogue: 0,1:17:55.79,1:17:58.13,Default,,0,0,0,,Жарайды, мен саған қалағаныңды жасай беремін.
Dialogue: 0,1:17:58.21,1:17:59.50,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:00.42,1:18:02.34,Default,,0,0,0,,Иә? Ношиши! Сіз...
Dialogue: 0,1:18:02.42,1:18:03.26,Default,,0,0,0,,Уау!
Dialogue: 0,1:18:04.01,1:18:05.88,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,1:18:05.97,1:18:09.01,Default,,0,0,0,,Бұл жолы қабандар да ауырды ма?
Dialogue: 0,1:18:09.10,1:18:10.35,Default,,0,0,0,,Неге қазір...
Dialogue: 0,1:18:10.43,1:18:12.56,Default,,0,0,0,,Зоори мырза, біз не істеуіміз керек?
Dialogue: 0,1:18:12.64,1:18:15.39,Default,,0,0,0,,Ауылға барып, дәрі алуым керек.
Dialogue: 0,1:18:15.48,1:18:17.44,Default,,0,0,0,,Мен осылай айтсам да...
Dialogue: 0,1:18:17.52,1:18:20.52,Default,,0,0,0,,Бұл тек алдыңғы жағы салқын шықты.
Dialogue: 0,1:18:21.53,1:18:24.82,Default,,0,0,0,,Хаа... Менің қызуым көтеріле бастады.
Dialogue: 0,1:18:25.11,1:18:25.95,Default,,0,0,0,,Ношиши!
Dialogue: 0,1:18:26.91,1:18:28.87,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,1:18:29.20,1:18:30.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:31.79,1:18:32.66,Default,,0,0,0,,Ношиши~!
Dialogue: 0,1:18:33.87,1:18:34.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:35.37,1:18:38.79,Default,,0,0,0,,Бұл ауру емес, күннің күйіп қалуы ғана емес пе?
Dialogue: 0,1:18:38.88,1:18:39.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:41.38,1:18:44.55,Default,,0,0,0,,Бұл тұтқаның арқасында болды ма?
Dialogue: 0,1:18:45.09,1:18:47.05,Default,,0,0,0,,Шынында да, бұл қызбалық...
Dialogue: 0,1:18:47.38,1:18:49.97,Default,,0,0,0,,Мен жай ғана көңілім қалды.
Dialogue: 0,1:18:50.22,1:18:51.60,Default,,0,0,0,,Ахаха мен көрдім.
Dialogue: 0,1:18:51.68,1:18:53.39,Default,,0,0,0,,Бұл мүлдем түсініксіз!
Dialogue: 0,1:18:54.06,1:18:55.02,Default,,0,0,0,,Хаа…
Dialogue: 0,1:18:55.43,1:18:58.77,Default,,0,0,0,,Айтпақшы, Зоронд Рон маған көп жағынан көмектесті.
Dialogue: 0,1:18:58.85,1:19:00.98,Default,,0,0,0,,Соңында рахметімді де айтпадым...
Dialogue: 0,1:19:01.44,1:19:04.69,Default,,0,0,0,,Жарайды, мен тапқан қазынамды ұрлап алдым.
Dialogue: 0,1:19:04.99,1:19:06.49,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,1:19:06.70,1:19:08.91,Default,,0,0,0,,Бұл жолы көп болды.
Dialogue: 0,1:19:08.99,1:19:10.99,Default,,0,0,0,,Такара да, Ариус та ұрланған...
Dialogue: 0,1:19:12.99,1:19:16.33,Default,,0,0,0,,Айтайын, мен тастаған жоқпын.
Dialogue: 0,1:19:16.50,1:19:17.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:17.54,1:19:20.33,Default,,0,0,0,,Өйткені мен ештеңені мойындаған жоқпын.
Dialogue: 0,1:19:20.50,1:19:22.92,Default,,0,0,0,,Мен мойындаған жоқпын немесе ұсыныс жасаған жоқпын.
Dialogue: 0,1:19:23.00,1:19:25.17,Default,,0,0,0,,Бұл сізді тастап кетті дегенді білдірмейді, солай ма?
Dialogue: 0,1:19:25.84,1:19:26.67,Default,,0,0,0,,Әй?
Dialogue: 0,1:19:27.22,1:19:28.38,Default,,0,0,0,,Бұл рас!
Dialogue: 0,1:19:29.05,1:19:35.06,Default,,0,0,0,,♪～
Dialogue: 0,1:21:08.78,1:21:10.74,Default,,0,0,0,,Жарайды ма? Ишиши Ношиши
Dialogue: 0,1:21:11.28,1:21:12.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:12.74,1:21:14.32,Default,,0,0,0,,Дәл қазір сәл қиын болса да
Dialogue: 0,1:21:14.53,1:21:15.87,Default,,0,0,0,,Мен тек бас тартуым керек
Dialogue: 0,1:21:15.95,1:21:17.83,Default,,0,0,0,,Мен ертең жақсы нәрсе болатынына сенімдімін.
Dialogue: 0,1:21:18.91,1:21:19.87,Default,,0,0,0,,Қуатыңызды жоғалтпаңыз!
Dialogue: 0,1:21:20.45,1:21:21.62,Default,,0,0,0,,Үмітті үзбе!
Dialogue: 0,1:21:22.41,1:21:24.62,Default,,0,0,0,,Жылаған жүзден күлкі артық
Dialogue: 0,1:21:25.21,1:21:27.54,Default,,0,0,0,,Бақыт періштесі де келеді
Dialogue: 0,1:21:28.71,1:21:30.38,Default,,0,0,0,,Сонымен, бүгінгі Данго туралы.
Dialogue: 0,1:21:30.46,1:21:31.80,Default,,0,0,0,,Тек бас тартыңыз
Dialogue: 0,1:21:31.88,1:21:32.84,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:21:33.17,1:21:36.22,Default,,0,0,0,,Сол үшін жақсы сөздер айттың ба?
Dialogue: 0,1:21:36.43,1:21:37.93,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:38.10,1:21:41.14,Default,,0,0,0,,Қош бол Данго!
Dialogue: 0,1:21:53.32,1:21:59.33,Default,,0,0,0,,～♪
Dialogue: 0,1:22:00.83,1:22:06.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory