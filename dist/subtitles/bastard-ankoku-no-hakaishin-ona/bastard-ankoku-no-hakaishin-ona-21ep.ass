Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.96,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:12.76,0:00:16.05,Default,,0,0,0,,Менің асыл қызымды ренжіттіңіз...
Dialogue: 0,0:00:16.80,0:00:19.47,Default,,0,0,0,,Мен саған лайықты тозақты көрсетемін
Dialogue: 0,0:00:20.10,0:00:21.43,Default,,0,0,0,,Куккукук…
Dialogue: 0,0:00:21.52,0:00:24.02,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:00:24.10,0:00:25.90,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:00:25.98,0:00:29.36,Default,,0,0,0,,Сіз мұнымен не істер едіңіз, Дирк Шнайдер?
Dialogue: 0,0:00:29.44,0:00:30.15,Default,,0,0,0,,Ней мырза!
Dialogue: 0,0:00:30.23,0:00:31.28,Default,,0,0,0,,Күл!
Dialogue: 0,0:00:31.36,0:00:32.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:32.69,0:00:34.61,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:00:34.70,0:00:36.53,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:00:36.61,0:00:37.74,Default,,0,0,0,,Golem Punch!
Dialogue: 0,0:00:37.82,0:00:38.66,Default,,0,0,0,,Сен менің курткамды ұшырып, мені де ұшырып жібердің ғой!
Dialogue: 0,0:00:39.41,0:00:40.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:42.91,0:00:45.17,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:00:45.25,0:00:46.79,Default,,0,0,0,,Сен мені алдадың.
Dialogue: 0,0:00:46.88,0:00:48.29,Default,,0,0,0,,Сіз алдап жатырсыз!
Dialogue: 0,0:00:48.38,0:00:49.79,Default,,0,0,0,,Шу!
Dialogue: 0,0:00:49.88,0:00:52.51,Default,,0,0,0,,Сіз мені әбден ашуландырдыңыз!
Dialogue: 0,0:00:52.59,0:00:54.42,Default,,0,0,0,,Дикіңізді шығарыңыз
Dialogue: 0,0:00:54.51,0:00:57.05,Default,,0,0,0,,Мен Ларсты тамақтандырамын!
Dialogue: 0,0:00:57.14,0:00:58.26,Default,,0,0,0,,Дарш!
Dialogue: 0,0:00:58.85,0:00:59.76,Default,,0,0,0,,Иә
Dialogue: 0,0:01:07.73,0:01:08.94,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:01:09.61,0:01:11.36,Default,,0,0,0,,Сіз бақытты екеніңізге сенімдімін.
Dialogue: 0,0:01:12.03,0:01:16.03,Default,,0,0,0,,Өйткені мен үшін жақсы көретін адам күрескен.
Dialogue: 0,0:01:17.28,0:01:19.03,Default,,0,0,0,,Мен де аздап түсіндім.
Dialogue: 0,0:01:20.03,0:01:22.99,Default,,0,0,0,,Мен мұндай лучты бірінші рет көруім.
Dialogue: 0,0:01:25.46,0:01:26.92,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:01:27.00,0:01:29.29,Default,,0,0,0,,Иә, өйткені менде сауыт болды...
Dialogue: 0,0:01:30.38,0:01:32.42,Default,,0,0,0,,Осы екеуінің арасында
Dialogue: 0,0:01:32.50,0:01:36.76,Default,,0,0,0,,Біздің байланысымыз соншалық, басқалар оны елестете де алмайды.
Dialogue: 0,0:01:37.76,0:01:39.14,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:01:39.22,0:01:42.64,Default,,0,0,0,,Ней мырза үшін Дирк Шнайдер есімді адам
Dialogue: 0,0:01:43.18,0:01:47.23,Default,,0,0,0,,Ол жай ғана әке емес.
Dialogue: 0,0:01:53.48,0:01:55.44,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:55.53,0:01:57.32,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:01:59.49,0:02:01.20,Default,,0,0,0,,♪～
Dialogue: 0,0:03:26.91,0:03:28.91,Default,,0,0,0,,～♪
Dialogue: 0,0:03:38.25,0:03:41.09,Default,,0,0,0,,Қорқақ Қараңғы Шнайдер!
Dialogue: 0,0:03:41.17,0:03:42.59,Default,,0,0,0,,Бұл алдау!
Dialogue: 0,0:03:42.68,0:03:44.68,Default,,0,0,0,,Алдау Алдау Алдау!
Dialogue: 0,0:03:44.76,0:03:48.06,Default,,0,0,0,,Бұл тітіркендіргіш, төңкерілген баклажан адам!
Dialogue: 0,0:03:48.14,0:03:51.23,Default,,0,0,0,,Жеңіске жеткенше төбелесуге болмайды!
Dialogue: 0,0:03:51.89,0:03:54.19,Default,,0,0,0,,Қандай арам қолды пайдалансаң да
Dialogue: 0,0:03:54.27,0:03:57.32,Default,,0,0,0,,Қарсыласын бірінші ұрған адам жеңеді!
Dialogue: 0,0:03:57.40,0:04:02.28,Default,,0,0,0,,Бұл барлық шайқастардың заңы!
Dialogue: 0,0:04:02.95,0:04:07.49,Default,,0,0,0,,Ну~ Мәңгі деңгейі төмен жігіт
Dialogue: 0,0:04:07.58,0:04:09.74,Default,,0,0,0,,Менің ойымша, олар бір деңгейде.
Dialogue: 0,0:04:09.83,0:04:10.45,Default,,0,0,0,,Агия
Dialogue: 0,0:04:11.33,0:04:11.96,Default,,0,0,0,,Қай жері ауырады?
Dialogue: 0,0:04:12.04,0:04:12.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:12.83,0:04:13.50,Default,,0,0,0,,Мен оны ысқылаймын.
Dialogue: 0,0:04:13.58,0:04:15.67,Default,,0,0,0,,(Тыңдаған дауыс)
Dialogue: 0,0:04:15.75,0:04:16.63,Default,,0,0,0,,(Шың) Мен… мен біттім. Мен аяқталдым.
Dialogue: 0,0:04:16.71,0:04:18.00,Default,,0,0,0,,Дарш…
Dialogue: 0,0:04:18.09,0:04:19.75,Default,,0,0,0,,Күте тұрыңыз, Дирк Шнайдер!
Dialogue: 0,0:04:19.84,0:04:21.30,Default,,0,0,0,,Мүлдем жоқ!
Dialogue: 0,0:04:21.38,0:04:23.93,Default,,0,0,0,,Бұл Бон Джовина рыцарь ретінде
Dialogue: 0,0:04:24.01,0:04:25.59,Default,,0,0,0,,Жоқ, мен саған ер адам ретінде айтамын.
Dialogue: 0,0:04:25.68,0:04:26.59,Default,,0,0,0,,(Тыңдаған дауыс)
Dialogue: 0,0:04:26.68,0:04:28.60,Default,,0,0,0,,Жексұрын жауға әділ қарау
Dialogue: 0,0:04:28.68,0:04:30.85,Default,,0,0,0,,Әділ көзқарас пен мінез-құлықпен әрекет ету
Dialogue: 0,0:04:31.43,0:04:32.81,Default,,0,0,0,,Сонда ғана біз жеңе аламыз
Dialogue: 0,0:04:32.89,0:04:36.56,Default,,0,0,0,,Жау өзінің зұлымдығынан ұялып, тәубенің көз жасына малынған.
Dialogue: 0,0:04:36.65,0:04:38.11,Default,,0,0,0,,Сүйіспеншілікке, әділдікке тәрбиелеу
Dialogue: 0,0:04:38.19,0:04:39.48,Default,,0,0,0,,(Тыңдаған дауыс)
Dialogue: 0,0:04:39.57,0:04:40.73,Default,,0,0,0,,Ер адам деген осы!
Dialogue: 0,0:04:40.82,0:04:42.19,Default,,0,0,0,,Негізгі ойларыңызды тастаңыз.
Dialogue: 0,0:04:42.28,0:04:43.65,Default,,0,0,0,,Алдамаңыз!
Dialogue: 0,0:04:43.74,0:04:45.49,Default,,0,0,0,,Түсінді ме? Мұнда!
Dialogue: 0,0:04:45.57,0:04:46.57,Default,,0,0,0,,Сіз мені тыңдайсыз ба?
Dialogue: 0,0:04:47.16,0:04:48.87,Default,,0,0,0,,Шулы қария!
Dialogue: 0,0:04:50.79,0:04:53.33,Default,,0,0,0,,Жау таза қолмен келсе
Dialogue: 0,0:04:53.41,0:04:56.67,Default,,0,0,0,,Мен сені бұдан да лас қолмен жаншып аламын!
Dialogue: 0,0:04:56.75,0:04:58.79,Default,,0,0,0,,Бұл жеңіс.
Dialogue: 0,0:04:58.88,0:05:00.88,Default,,0,0,0,,Ерлер төбелескенше
Dialogue: 0,0:05:00.96,0:05:03.80,Default,,0,0,0,,Біз жеңуіміз керек!
Dialogue: 0,0:05:03.88,0:05:05.97,Default,,0,0,0,,Кез келген нысанда
Dialogue: 0,0:05:06.05,0:05:08.51,Default,,0,0,0,,Жеңіліс бір унцияға да тұрмайды.
Dialogue: 0,0:05:08.59,0:05:12.02,Default,,0,0,0,,Мен жеңілсем, сүйкімді қызды қорғай алмаймын!
Dialogue: 0,0:05:12.10,0:05:14.02,Default,,0,0,0,,Алдымен басыңыз
Dialogue: 0,0:05:14.10,0:05:17.48,Default,,0,0,0,,Жауыңды өлгенше жұдырықтай бер!
Dialogue: 0,0:05:17.98,0:05:18.81,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:05:18.90,0:05:20.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:23.82,0:05:26.45,Default,,0,0,0,,Абигейл, кеттік!
Dialogue: 0,0:05:29.53,0:05:32.37,Default,,0,0,0,,Түсінемін, өте жақсы түсінемін.
Dialogue: 0,0:05:32.45,0:05:36.04,Default,,0,0,0,,Айтқаныңыз мағынасы бар.
Dialogue: 0,0:05:40.54,0:05:41.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:41.25,0:05:42.34,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:42.42,0:05:44.63,Default,,0,0,0,,Не істемексің, жігітім?
Dialogue: 0,0:05:44.71,0:05:45.97,Default,,0,0,0,,дәл қазір менің алдымда тұр!
Dialogue: 0,0:05:46.05,0:05:50.01,Default,,0,0,0,,Шындықтағы қуат айырмашылығына қатысты не істеуіміз керек?
Dialogue: 0,0:05:50.09,0:05:50.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:50.76,0:05:52.43,Default,,0,0,0,,Қазір менің алдымда
Dialogue: 0,0:05:52.51,0:05:55.60,Default,,0,0,0,,Сіз шаң сияқты емессіз!
Dialogue: 0,0:05:56.64,0:05:59.15,Default,,0,0,0,,Абигейл Колледер!
Dialogue: 0,0:06:01.19,0:06:02.32,Default,,0,0,0,,Не?
Dialogue: 0,0:06:15.29,0:06:17.66,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:06:18.96,0:06:21.46,Default,,0,0,0,,Бір голем ату...
Dialogue: 0,0:06:21.96,0:06:23.71,Default,,0,0,0,,О~
Dialogue: 0,0:06:23.80,0:06:25.80,Default,,0,0,0,,Хааах!
Dialogue: 0,0:06:25.88,0:06:28.88,Default,,0,0,0,,Қандай жойқын күш!
Dialogue: 0,0:06:29.38,0:06:31.76,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:06:32.51,0:06:34.06,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:06:34.60,0:06:36.60,Default,,0,0,0,,Сиқыр әрекетінің белгісі жоқ
Dialogue: 0,0:06:37.43,0:06:38.73,Default,,0,0,0,,Күтілгендей, бұл...
Dialogue: 0,0:06:39.27,0:06:43.15,Default,,0,0,0,,Түсіндім, бұл «ескі дүние» сиқыры.
Dialogue: 0,0:06:44.11,0:06:46.15,Default,,0,0,0,,Ей, бұл жігіт керемет.
Dialogue: 0,0:06:46.23,0:06:49.03,Default,,0,0,0,,Эй, эй, Дирк Шнайдер, сенің артыңда!
Dialogue: 0,0:06:50.99,0:06:52.74,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:06:52.82,0:06:55.62,Default,,0,0,0,,Дирк Шнайдер ше?
Dialogue: 0,0:06:55.70,0:06:58.54,Default,,0,0,0,,Бұлар бір кездері бүкіл адамзатты жойды.
Dialogue: 0,0:06:58.62,0:07:01.50,Default,,0,0,0,,Зұлымдықтың ұлы күшінің аз ғана бөлігі
Dialogue: 0,0:07:01.58,0:07:03.38,Default,,0,0,0,,Хаха
Dialogue: 0,0:07:03.46,0:07:06.67,Default,,0,0,0,,Бұл керемет күш, ол мені қалтыратады.
Dialogue: 0,0:07:06.75,0:07:10.97,Default,,0,0,0,,Мен де сиқырлы құрылғылар жиынтығын алғым келеді, Абигейл.
Dialogue: 0,0:07:11.05,0:07:14.05,Default,,0,0,0,,Антрасакстың өте жойқын қабілеті
Dialogue: 0,0:07:14.14,0:07:17.85,Default,,0,0,0,,Өлшеусіз екені ғажап.
Dialogue: 0,0:07:17.93,0:07:21.81,Default,,0,0,0,,Қосымша сиқырлы құрылғы осыншама қуатқа ие.
Dialogue: 0,0:07:21.89,0:07:23.02,Default,,0,0,0,,Не?
Dialogue: 0,0:07:25.82,0:07:27.02,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:07:27.11,0:07:28.94,Default,,0,0,0,,Сиқырлы құрылғылардың үш түрі...
Dialogue: 0,0:07:29.03,0:07:30.82,Default,,0,0,0,,Жою құдайы...
Dialogue: 0,0:07:35.07,0:07:37.79,Default,,0,0,0,,Кукукуку... Шынымен!
Dialogue: 0,0:07:37.87,0:07:41.29,Default,,0,0,0,,Үш сиқырлы ыдыс жойылу құдайы Антрасаксты жасады.
Dialogue: 0,0:07:41.37,0:07:44.21,Default,,0,0,0,,«Ескі әлемнің» сиқыршылары мен алхимиктері
Dialogue: 0,0:07:44.29,0:07:46.96,Default,,0,0,0,,Ұқсас құпия әдістерді қолдану арқылы жасалған қарулар
Dialogue: 0,0:07:47.75,0:07:51.72,Default,,0,0,0,,Ху... Дирк Шнайдер күткендей.
Dialogue: 0,0:07:51.80,0:07:53.80,Default,,0,0,0,,Аспандағы төрт патшаның үшеуімен салыстырғанда
Dialogue: 0,0:07:53.89,0:07:57.18,Default,,0,0,0,,Сіз өте қиын адамсыз.
Dialogue: 0,0:07:57.26,0:07:59.72,Default,,0,0,0,,Сіз тым ақылдысыз
Dialogue: 0,0:07:59.81,0:08:01.52,Default,,0,0,0,,Сіз тым ақылдысыз
Dialogue: 0,0:08:01.60,0:08:04.40,Default,,0,0,0,,Сізде сиқырлы күш тым көп
Dialogue: 0,0:08:04.48,0:08:06.94,Default,,0,0,0,,Сіз тым сараңсың
Dialogue: 0,0:08:07.02,0:08:09.40,Default,,0,0,0,,Сіз тым эмоционалдысыз
Dialogue: 0,0:08:09.48,0:08:11.15,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:08:11.24,0:08:13.86,Default,,0,0,0,,Сен тым жұмбақсың!
Dialogue: 0,0:08:14.86,0:08:16.24,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:08:16.32,0:08:18.33,Default,,0,0,0,,Осы Абигейлге тізе бүгіңіз
Dialogue: 0,0:08:18.41,0:08:20.70,Default,,0,0,0,,Шын жүректен мойынсұнуға уәде беріңіз
Dialogue: 0,0:08:21.29,0:08:25.21,Default,,0,0,0,,Олай болсаң, мен сенімен өз күшімді бөлісемін!
Dialogue: 0,0:08:25.29,0:08:26.21,Default,,0,0,0,,Не!
Dialogue: 0,0:08:26.29,0:08:27.34,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:27.42,0:08:28.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:30.51,0:08:31.13,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:08:31.96,0:08:32.97,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:08:33.05,0:08:34.97,Default,,0,0,0,,Онда өл!
Dialogue: 0,0:08:36.93,0:08:37.80,Default,,0,0,0,,О!
Dialogue: 0,0:08:37.89,0:08:38.76,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:08:39.31,0:08:40.72,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:08:40.81,0:08:42.68,Default,,0,0,0,,Вахахаха!
Dialogue: 0,0:08:42.77,0:08:44.39,Default,,0,0,0,,Қалайсыңдар балалар!
Dialogue: 0,0:08:44.48,0:08:47.02,Default,,0,0,0,,Бұл күш – «зұлымдық»!
Dialogue: 0,0:08:47.10,0:08:49.11,Default,,0,0,0,,Қараңғылығымның күші алдында
Dialogue: 0,0:08:49.19,0:08:52.99,Default,,0,0,0,,Тіпті аңызға айналған жын Дирк Шнайдердің де күші жоқ!
Dialogue: 0,0:08:53.07,0:08:57.11,Default,,0,0,0,,Енді соңғы мөрді алу ғана қалды.
Dialogue: 0,0:08:57.20,0:09:00.87,Default,,0,0,0,,Сонда бұл дүние тозаққа айналады~
Dialogue: 0,0:09:00.95,0:09:02.50,Default,,0,0,0,,Жақсылық толығымен жойылады
Dialogue: 0,0:09:02.58,0:09:05.58,Default,,0,0,0,,Өлім, қараңғылық және қорқыныш билейді.
Dialogue: 0,0:09:05.67,0:09:09.04,Default,,0,0,0,,На~ Дахахаха...
Dialogue: 0,0:09:09.13,0:09:11.00,Default,,0,0,0,,Бұл енді жақсы емес~
Dialogue: 0,0:09:11.09,0:09:13.09,Default,,0,0,0,,Дирк Шнайдер қайтыс болды
Dialogue: 0,0:09:13.17,0:09:14.51,Default,,0,0,0,,Дүние бітті
Dialogue: 0,0:09:15.17,0:09:16.72,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:09:18.14,0:09:19.39,Default,,0,0,0,,Люс!
Dialogue: 0,0:09:23.27,0:09:24.35,Default,,0,0,0,,Зұлымдық…
Dialogue: 0,0:09:24.43,0:09:25.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:26.31,0:09:27.73,Default,,0,0,0,,Зұлымдық?
Dialogue: 0,0:09:28.81,0:09:31.77,Default,,0,0,0,,Бұл сіздің қара күшіңіз бе?
Dialogue: 0,0:09:32.28,0:09:34.19,Default,,0,0,0,,Мынадай нәрсе!
Dialogue: 0,0:09:36.78,0:09:38.07,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:38.16,0:09:39.41,Default,,0,0,0,,Не?
Dialogue: 0,0:09:41.53,0:09:43.29,Default,,0,0,0,,Нууууу~
Dialogue: 0,0:09:43.37,0:09:46.66,Default,,0,0,0,,Ууууууууууу~
Dialogue: 0,0:09:46.75,0:09:49.63,Default,,0,0,0,,Ооо~
Dialogue: 0,0:09:52.34,0:09:53.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:54.05,0:09:55.72,Default,,0,0,0,,Абигейл!
Dialogue: 0,0:09:55.80,0:09:58.84,Default,,0,0,0,,Зұлымдықтың шынайы күші қаншалықты күшті?
Dialogue: 0,0:09:58.93,0:10:00.93,Default,,0,0,0,,Мен саған көрсетемін.
Dialogue: 0,0:10:01.01,0:10:01.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:01.72,0:10:03.39,Default,,0,0,0,,Менің жолыма кедергі болма!
Dialogue: 0,0:10:03.47,0:10:06.89,Default,,0,0,0,,Кір аяғыңызды қашанға дейін ұстайсыз?
Dialogue: 0,0:10:06.98,0:10:08.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:08.31,0:10:10.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:13.44,0:10:14.86,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:10:14.94,0:10:18.11,Default,,0,0,0,,Менің сұлу келбетіме қадам бас
Dialogue: 0,0:10:18.20,0:10:21.07,Default,,0,0,0,,Енді ойнауға болмайды!
Dialogue: 0,0:10:21.16,0:10:23.49,Default,,0,0,0,,Қазір тыныс алуды тоқтатыңыз!
Dialogue: 0,0:10:23.58,0:10:27.37,Default,,0,0,0,,Өте зұлым қара магия.
Dialogue: 0,0:10:27.87,0:10:29.25,Default,,0,0,0,,Рэй Вун!
Dialogue: 0,0:10:30.04,0:10:31.42,Default,,0,0,0,,Агия! (Йоко) Кя!
Dialogue: 0,0:10:33.17,0:10:34.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:34.25,0:10:35.17,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:10:36.71,0:10:37.80,Default,,0,0,0,,Гррр…
Dialogue: 0,0:10:37.88,0:10:39.93,Default,,0,0,0,,Ах, рахмет Гала.
Dialogue: 0,0:10:40.01,0:10:41.64,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:10:41.72,0:10:44.06,Default,,0,0,0,,Бұлай болғанда, сен тоқтай алмайсың, анау жігіт.
Dialogue: 0,0:10:44.14,0:10:44.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:44.97,0:10:46.39,Default,,0,0,0,,Аспаз аспаз!
Dialogue: 0,0:10:46.47,0:10:47.68,Default,,0,0,0,,Кеттік~
Dialogue: 0,0:10:47.77,0:10:49.23,Default,,0,0,0,,Бұл сезім жаман
Dialogue: 0,0:10:50.02,0:10:52.77,Default,,0,0,0,,Бұл Люстің таңдай қақтырмайтынының белгісі.
Dialogue: 0,0:10:54.07,0:10:57.40,Default,,0,0,0,,Мүмкін бәріміз қамалды көшіруіміз керек шығар...
Dialogue: 0,0:10:57.49,0:11:00.15,Default,,0,0,0,,Хмм, бұл қызық.
Dialogue: 0,0:11:00.24,0:11:03.78,Default,,0,0,0,,Сен маған сиқыр қолданғың келе ме?
Dialogue: 0,0:11:03.87,0:11:05.74,Default,,0,0,0,,Кукукукук…
Dialogue: 0,0:11:05.83,0:11:08.12,Default,,0,0,0,,Бірақ сен сиқыршысың.
Dialogue: 0,0:11:08.70,0:11:11.58,Default,,0,0,0,,Сондықтан күресуден басқа амалымыз жоқ.
Dialogue: 0,0:11:12.08,0:11:14.38,Default,,0,0,0,,Мен сізге бір нәрсені айтайын, Абигейл.
Dialogue: 0,0:11:14.46,0:11:15.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:15.17,0:11:18.76,Default,,0,0,0,,Қараңғы Шнайдердің сиқырлы күші теңдессіз!
Dialogue: 0,0:11:18.84,0:11:22.55,Default,,0,0,0,,400 жыл ішінде мен ешқашан шайқаста жеңілген емеспін!
Dialogue: 0,0:11:22.64,0:11:26.26,Default,,0,0,0,,Ал бұдан былай мен ешқашан жеңілмеймін!
Dialogue: 0,0:11:28.81,0:11:30.31,Default,,0,0,0,,Бірақ негізгі денені табуымыз керек дейді… оны қалайша тауып алуымыз керек?
Dialogue: 0,0:11:30.39,0:11:32.10,Default,,0,0,0,,Сиқырлау
Dialogue: 0,0:11:32.19,0:11:35.40,Default,,0,0,0,,Тәкаппар мұрныңның көпірін бұзамын!
Dialogue: 0,0:11:35.48,0:11:37.23,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:11:37.32,0:11:40.03,Default,,0,0,0,,Ән айтуды аяқтаған сәт - сенің соңың.
Dialogue: 0,0:11:40.11,0:11:41.86,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:11:41.95,0:11:45.12,Default,,0,0,0,,Жоқ! Бұл денеде сиқыр жұмыс істемейді
Dialogue: 0,0:11:45.62,0:11:49.91,Default,,0,0,0,,Абигейл өзінің сиқырлы күшін босатқан кездегі қорғансыз сәтті көздеп отыр.
Dialogue: 0,0:11:50.71,0:11:52.08,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:52.16,0:11:54.38,Default,,0,0,0,,Эго, эго, зарагорай...
Dialogue: 0,0:11:54.46,0:11:57.34,Default,,0,0,0,,Эго Эго Акула Рагон!
Dialogue: 0,0:11:57.42,0:12:02.26,Default,,0,0,0,,Қараңғылық ханзадасы, Зұлымдықтың тұңғышы және оның патшасы атынан
Dialogue: 0,0:12:02.34,0:12:03.88,Default,,0,0,0,,Кел!
Dialogue: 0,0:12:07.10,0:12:08.18,Default,,0,0,0,,О? (Йоко) Ха!
Dialogue: 0,0:12:08.26,0:12:10.14,Default,,0,0,0,,Мына қара шар қандай?
Dialogue: 0,0:12:10.22,0:12:11.27,Default,,0,0,0,,Қараңғы үңгір?
Dialogue: 0,0:12:11.93,0:12:15.23,Default,,0,0,0,,Бұл не сиқыр?
Dialogue: 0,0:12:15.31,0:12:16.40,Default,,0,0,0,,Тосқауыл?
Dialogue: 0,0:12:16.90,0:12:18.15,Default,,0,0,0,,Жоғары ежелгі?
Dialogue: 0,0:12:18.23,0:12:22.15,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:12:22.24,0:12:25.49,Default,,0,0,0,,Жоқ! Жоқ, бұл...
Dialogue: 0,0:12:25.57,0:12:27.83,Default,,0,0,0,,Бұл тыйым салынған заклинание! Барлығы жатады
Dialogue: 0,0:12:27.91,0:12:28.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:29.29,0:12:33.87,Default,,0,0,0,,Шайтанның еті, құрбандықты же!
Dialogue: 0,0:12:34.92,0:12:35.83,Default,,0,0,0,,Nu...
Dialogue: 0,0:12:35.92,0:12:39.50,Default,,0,0,0,,Мені жеп қойыңыз, артыңызда сүйек те, сүйек те қалдырмай!
Dialogue: 0,0:12:39.59,0:12:41.76,Default,,0,0,0,,Ха~хахахаха!
Dialogue: 0,0:12:41.84,0:12:44.34,Default,,0,0,0,,Edd Zeperion!
Dialogue: 0,0:12:44.43,0:12:47.51,Default,,0,0,0,,(Үру)
Dialogue: 0,0:12:48.55,0:12:52.06,Default,,0,0,0,,(Үру)
Dialogue: 0,0:12:52.14,0:12:53.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:53.10,0:12:54.48,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:12:54.56,0:12:55.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:56.02,0:12:57.65,Default,,0,0,0,,(Үру)
Dialogue: 0,0:12:57.73,0:12:58.77,Default,,0,0,0,,Не?
Dialogue: 0,0:13:08.32,0:13:09.95,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:13:10.03,0:13:13.29,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:14.46,0:13:17.17,Default,,0,0,0,,Ха~хахахаха!
Dialogue: 0,0:13:17.25,0:13:21.59,Default,,0,0,0,,Қараңғы бөгет ішінде тозақтан «елес рух» шақырылды!
Dialogue: 0,0:13:21.67,0:13:23.34,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:13:23.42,0:13:25.97,Default,,0,0,0,,Ол балалар бәрін жейді.
Dialogue: 0,0:13:26.55,0:13:30.14,Default,,0,0,0,,Аш рухта бар жалғыз нәрсе - қорқынышты аштық.
Dialogue: 0,0:13:30.22,0:13:32.72,Default,,0,0,0,,Мен әрқашан ашпын.
Dialogue: 0,0:13:32.81,0:13:34.52,Default,,0,0,0,,О... түсіндім.
Dialogue: 0,0:13:34.60,0:13:36.94,Default,,0,0,0,,Сиқырлы құралдарды тек жындар ғана пайдалана алады.
Dialogue: 0,0:13:37.02,0:13:41.02,Default,,0,0,0,,Олай болса, жын-шайтан дүниесінен шыққан мақұлық оны жоя алады ма?
Dialogue: 0,0:13:41.11,0:13:45.03,Default,,0,0,0,,О! Бұлай болса, тіпті қарапайым адам...
Dialogue: 0,0:13:45.53,0:13:47.82,Default,,0,0,0,,Эй... Әй!
Dialogue: 0,0:13:47.91,0:13:49.62,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:13:49.70,0:13:53.41,Default,,0,0,0,,Сіз мені қалқалап, тегін құтыла аласыз деп ойлайсыз ба?
Dialogue: 0,0:13:53.49,0:13:55.04,Default,,0,0,0,,Фухахаха!
Dialogue: 0,0:13:55.12,0:13:56.66,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:13:56.75,0:13:59.96,Default,,0,0,0,,Уаааааааааааааа!
Dialogue: 0,0:14:02.50,0:14:05.38,Default,,0,0,0,,Фуфуха~хахаха...
Dialogue: 0,0:14:05.46,0:14:06.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:07.17,0:14:11.01,Default,,0,0,0,,А~хахаха вахахаха...
Dialogue: 0,0:14:11.10,0:14:15.02,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:14:20.40,0:14:25.03,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:14:26.11,0:14:28.36,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:14:28.45,0:14:29.78,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:14:29.86,0:14:30.74,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:14:30.82,0:14:33.74,Default,,0,0,0,,Соңғы пломба әлі бұзылмаған болуы керек.
Dialogue: 0,0:14:34.83,0:14:36.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:36.45,0:14:40.71,Default,,0,0,0,,Сібір жарасы қозғалуда!
Dialogue: 0,0:14:40.79,0:14:41.67,Default,,0,0,0,,Ақымақ! Хе-хе-хе! ➡
Dialogue: 0,0:14:43.04,0:14:43.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:44.00,0:14:44.88,Default,,0,0,0,,Уф
Dialogue: 0,0:14:44.96,0:14:45.59,Default,,0,0,0,,О!
Dialogue: 0,0:14:45.67,0:14:46.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:46.42,0:14:46.96,Default,,0,0,0,,Шейла!
Dialogue: 0,0:14:47.05,0:14:48.80,Default,,0,0,0,,Ханшайым, не болды?
Dialogue: 0,0:14:48.88,0:14:51.47,Default,,0,0,0,,А... ыстық
Dialogue: 0,0:14:52.76,0:14:55.18,Default,,0,0,0,,Менің денем кенеттен...
Dialogue: 0,0:14:56.22,0:14:58.39,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:08.24,0:15:10.78,Default,,0,0,0,,Кукуку... аяқталды ма?
Dialogue: 0,0:15:12.62,0:15:13.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:14.41,0:15:15.83,Default,,0,0,0,,Тоя!
Dialogue: 0,0:15:15.91,0:15:18.54,Default,,0,0,0,,Не? тосқауыл ашты
Dialogue: 0,0:15:18.62,0:15:20.79,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:15:20.87,0:15:21.79,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:30.93,0:15:35.80,Default,,0,0,0,,Керемет!
Dialogue: 0,0:15:35.89,0:15:36.47,Default,,0,0,0,,Дарш!
Dialogue: 0,0:15:36.56,0:15:37.60,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:15:39.48,0:15:40.48,Default,,0,0,0,,Люс!
Dialogue: 0,0:15:44.48,0:15:50.36,Default,,0,0,0,,(Үру)
Dialogue: 0,0:15:50.44,0:15:54.32,Default,,0,0,0,,Ол... Ол Қараңғы Шнайдер!
Dialogue: 0,0:15:54.41,0:15:59.29,Default,,0,0,0,,Жарайды, осы Абигейлге!
Dialogue: 0,0:15:59.91,0:16:01.75,Default,,0,0,0,,Нуу Мен сене алар емеспін
Dialogue: 0,0:16:01.83,0:16:04.25,Default,,0,0,0,,Мен тыйым салынған бөгетті кесіп өттім.
Dialogue: 0,0:16:04.33,0:16:07.00,Default,,0,0,0,,Және ол мүлдем зардап шекпеді!
Dialogue: 0,0:16:07.09,0:16:09.71,Default,,0,0,0,,Менде жын әлемінен жын болса да жақсы емес пе?
Dialogue: 0,0:16:09.80,0:16:13.05,Default,,0,0,0,,Сиқырлы құрылғы қандай қорқынышты!
Dialogue: 0,0:16:13.55,0:16:17.97,Default,,0,0,0,,Сонымен, біріктірілген сиқырлы құрылғы бұзылмайды ма?
Dialogue: 0,0:16:18.76,0:16:20.60,Default,,0,0,0,,Ханшайым! Күшті болыңыз
Dialogue: 0,0:16:20.68,0:16:21.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:21.39,0:16:23.89,Default,,0,0,0,,Тынш, Шейла, не болды?
Dialogue: 0,0:16:23.98,0:16:25.06,Default,,0,0,0,,Өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:16:25.15,0:16:28.44,Default,,0,0,0,,Ух... аа... а...
Dialogue: 0,0:16:28.52,0:16:30.23,Default,,0,0,0,,Ол жарылып кете жаздады!
Dialogue: 0,0:16:30.73,0:16:33.40,Default,,0,0,0,,Сонымен, бас діни қызметкер, бұл не?
Dialogue: 0,0:16:34.03,0:16:35.03,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:16:35.11,0:16:35.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:36.87,0:16:39.70,Default,,0,0,0,,Қараңдаршы! Яһуданың аспаны
Dialogue: 0,0:16:40.29,0:16:43.54,Default,,0,0,0,,О, бұл не? Бұл дауыл қалай?
Dialogue: 0,0:16:44.37,0:16:45.29,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:16:46.50,0:16:47.79,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:16:47.88,0:16:49.25,Default,,0,0,0,,Жоқ, мен саған кеше айтқан жоқпын ба? Лукако – нағыз жігіт.
Dialogue: 0,0:16:49.34,0:16:52.01,Default,,0,0,0,,Төртінші пломба сынғалы жатыр ма?
Dialogue: 0,0:16:52.09,0:16:53.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:53.88,0:16:54.84,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:56.30,0:16:57.68,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:16:57.76,0:16:59.68,Default,,0,0,0,,Быееееееееееееееееееееееее!
Dialogue: 0,0:17:00.31,0:17:04.10,Default,,0,0,0,,Әкеміздің аурудан қайтыс болуы да жаман нәрсе сияқты естіледі.
Dialogue: 0,0:17:04.60,0:17:05.73,Default,,0,0,0,,Фу~!
Dialogue: 0,0:17:05.81,0:17:08.48,Default,,0,0,0,,Шлагбаумның ішін жын әлемімен байланыстыру нені білдіреді...
Dialogue: 0,0:17:08.56,0:17:12.44,Default,,0,0,0,,Мынадай үлкен сиқырлы Пауэрді бұл жігіт қайдан алды?
Dialogue: 0,0:17:12.53,0:17:14.07,Default,,0,0,0,,Куку…
Dialogue: 0,0:17:14.57,0:17:18.66,Default,,0,0,0,,Тозақтың жын-шайтандарының шабуылы жүйкеңізді аздап салқындатты ма?
Dialogue: 0,0:17:18.74,0:17:19.62,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:17:19.70,0:17:22.54,Default,,0,0,0,,Сіз өзіңіздің еркіндігіңізді көрсете аласыз ба?
Dialogue: 0,0:17:24.00,0:17:24.91,Default,,0,0,0,,Guboa!
Dialogue: 0,0:17:25.41,0:17:27.62,Default,,0,0,0,,Жоқ! Уф...
Dialogue: 0,0:17:27.71,0:17:30.04,Default,,0,0,0,,Дарш! Дарш!
Dialogue: 0,0:17:30.13,0:17:31.88,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:17:31.96,0:17:33.84,Default,,0,0,0,,Не болды, Дирк Шнайдер?
Dialogue: 0,0:17:33.92,0:17:35.51,Default,,0,0,0,,Дәл қазір ол қаншалықты күшті болды?
Dialogue: 0,0:17:35.59,0:17:36.97,Default,,0,0,0,,О? а?
Dialogue: 0,0:17:37.51,0:17:40.60,Default,,0,0,0,,Ораораораораораораораора~!
Dialogue: 0,0:17:40.68,0:17:42.31,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:42.39,0:17:44.56,Default,,0,0,0,,Жоқ! Бұл мені шынымен өлтіретін еді
Dialogue: 0,0:17:44.64,0:17:45.73,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:45.81,0:17:47.77,Default,,0,0,0,,Ха~ Енді жоқ!
Dialogue: 0,0:17:47.85,0:17:49.27,Default,,0,0,0,,Бұл жолы нақты!
Dialogue: 0,0:17:49.35,0:17:52.23,Default,,0,0,0,,Бұл аниме де аяқталды!
Dialogue: 0,0:17:52.32,0:17:53.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:04.16,0:18:06.91,Default,,0,0,0,,Мен оны анық сезінемін!
Dialogue: 0,0:18:07.79,0:18:09.88,Default,,0,0,0,,Жою құдайының орасан зор қараңғы Пауэр
Dialogue: 0,0:18:09.96,0:18:13.21,Default,,0,0,0,,Дирк Шнайдер мен Абигейлге ағу
Dialogue: 0,0:18:17.17,0:18:19.43,Default,,0,0,0,,Бұл екеуі кім...
Dialogue: 0,0:18:21.26,0:18:22.51,Default,,0,0,0,,Люс...
Dialogue: 0,0:18:22.60,0:18:23.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:23.43,0:18:25.35,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:18:26.98,0:18:28.81,Default,,0,0,0,,Кукукукук…
Dialogue: 0,0:18:28.89,0:18:30.23,Default,,0,0,0,,Періштенің нұры
Dialogue: 0,0:18:30.31,0:18:33.44,Default,,0,0,0,,Қараңғы Шнайдердің жеңілмейтін аңызы!
Dialogue: 0,0:18:36.53,0:18:40.16,Default,,0,0,0,,Ах... Дирк Шнайдер...
Dialogue: 0,0:18:41.07,0:18:42.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:42.95,0:18:44.08,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:47.50,0:18:48.66,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:18:48.75,0:18:51.13,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:18:51.21,0:18:55.00,Default,,0,0,0,,Осымен... сіз тозақ жасай аласыз!
Dialogue: 0,0:18:55.09,0:18:56.30,Default,,0,0,0,,Бұл жер бетінде
Dialogue: 0,0:18:56.38,0:19:00.55,Default,,0,0,0,,Айқайың мен айғайың, Әлсіздердің, толып жатыр!
Dialogue: 0,0:19:00.63,0:19:01.59,Default,,0,0,0,,Da~hahahaha…
Dialogue: 0,0:19:01.68,0:19:03.47,Default,,0,0,0,,Уа, Құдайым
Dialogue: 0,0:19:05.97,0:19:08.77,Default,,0,0,0,,Енді Шейла ханшайым қалды!
Dialogue: 0,0:19:09.27,0:19:13.90,Default,,0,0,0,,Тек денеңіздің ішіндегі тығыздағышты шығарыңыз!
Dialogue: 0,0:19:13.98,0:19:14.69,Default,,0,0,0,,Не!
Dialogue: 0,0:19:14.77,0:19:15.40,Default,,0,0,0,,Не!
Dialogue: 0,0:19:15.48,0:19:16.78,Default,,0,0,0,,Не?
Dialogue: 0,0:19:17.82,0:19:19.19,Default,,0,0,0,,Соңғы мөр...
Dialogue: 0,0:19:19.70,0:19:21.45,Default,,0,0,0,,Lady Sheila...
Dialogue: 0,0:19:21.53,0:19:23.16,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:19:23.24,0:19:24.53,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:19:24.62,0:19:27.12,Default,,0,0,0,,Неліктен олай істедің?
Dialogue: 0,0:19:27.20,0:19:28.95,Default,,0,0,0,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,0:19:29.04,0:19:30.79,Default,,0,0,0,,Сіз білесіз бе, Бас діни қызметкер?
Dialogue: 0,0:19:30.87,0:19:31.50,Default,,0,0,0,,Гах!
Dialogue: 0,0:19:31.58,0:19:34.96,Default,,0,0,0,,Сен біздің күшімізден қорқтың.
Dialogue: 0,0:19:35.09,0:19:37.96,Default,,0,0,0,,«Мөр» елде ең қиыны болып табылады
Dialogue: 0,0:19:38.05,0:19:41.34,Default,,0,0,0,,Мен оны қорғауға оңай болатын жерге көшіруді ойладым.
Dialogue: 0,0:19:41.43,0:19:43.84,Default,,0,0,0,,Басқаша айтқанда, ханшайымның «төменгі ішінде»
Dialogue: 0,0:19:43.93,0:19:48.18,Default,,0,0,0,,Менің ойымша, ол сиқырмен «трансплантациялау» идеясын ойлап тапты!
Dialogue: 0,0:19:48.89,0:19:49.52,Default,,0,0,0,,Қу!
Dialogue: 0,0:19:49.60,0:19:51.98,Default,,0,0,0,,Күте тұрыңдар, ақымақтар!
Dialogue: 0,0:19:52.06,0:19:57.07,Default,,0,0,0,,Бұл әлемді қанды үмітсіздіктің қараңғылығына жабады!
Dialogue: 0,0:19:57.15,0:20:00.28,Default,,0,0,0,,Жою құдайы Сібір жарасы!
Dialogue: 0,0:20:00.36,0:20:02.70,Default,,0,0,0,,Ва~хахахаха
Dialogue: 0,0:20:02.78,0:20:04.45,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:20:04.53,0:20:06.41,Default,,0,0,0,,А, мен келе жатырмын!
Dialogue: 0,0:20:06.49,0:20:09.16,Default,,0,0,0,,Осы уақытқа дейін?
Dialogue: 0,0:20:10.41,0:20:11.54,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:20:12.50,0:20:15.50,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:20:17.84,0:20:18.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:19.05,0:20:20.80,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:20:24.68,0:20:27.35,Default,,0,0,0,,Әлем...
Dialogue: 0,0:20:30.10,0:20:31.52,Default,,0,0,0,,Қорғаңыз
Dialogue: 0,0:20:36.36,0:20:37.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:40.78,0:20:42.74,Default,,0,0,0,,Мен күнәларымды өтеуді қалаймын.
Dialogue: 0,0:20:43.70,0:20:49.16,Default,,0,0,0,,(Үру)
Dialogue: 0,0:20:50.74,0:20:51.95,Default,,0,0,0,,бұл... Руш
Dialogue: 0,0:20:52.70,0:20:54.62,Default,,0,0,0,,Нууууу!
Dialogue: 0,0:20:55.46,0:20:56.38,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:20:56.46,0:20:58.38,Default,,0,0,0,,Бұл не дүние?
Dialogue: 0,0:20:58.46,0:21:01.88,Default,,0,0,0,,Ол сізді қалағаныңызды жасауға мәжбүрлеу үшін емес!
Dialogue: 0,0:21:02.76,0:21:05.01,Default,,0,0,0,,Әй... Әй, жиналыңдар.
Dialogue: 0,0:21:05.09,0:21:07.26,Default,,0,0,0,,Даркнесстің Пауэрі Қараңғы Шнайдерге айналады!
Dialogue: 0,0:21:07.34,0:21:10.31,Default,,0,0,0,,Бұл кең әдемі әлем
Dialogue: 0,0:21:10.39,0:21:12.72,Default,,0,0,0,,Бұл ешкім үшін емес!
Dialogue: 0,0:21:15.02,0:21:19.52,Default,,0,0,0,,Мен үшін ғана бар дүние.
Dialogue: 0,0:21:19.61,0:21:23.61,Default,,0,0,0,,Мен, иесі, онымен не істеу керектігін шешемін!
Dialogue: 0,0:21:27.36,0:21:29.57,Default,,0,0,0,,Кайзард Альзадо
Dialogue: 0,0:21:29.66,0:21:33.04,Default,,0,0,0,,Ки Сук Ханс Гросс Жібек!
Dialogue: 0,0:21:33.12,0:21:34.58,Default,,0,0,0,,Күлге айнал!
Dialogue: 0,0:21:34.66,0:21:36.62,Default,,0,0,0,,Жер асты әлемінің данышпаны
Dialogue: 0,0:21:36.71,0:21:38.63,Default,,0,0,0,,Жеті кілт бар
Dialogue: 0,0:21:38.71,0:21:40.92,Default,,0,0,0,,Тозақтың есігін аш!
Dialogue: 0,0:21:44.17,0:21:47.63,Default,,0,0,0,,Не? Ах, бұл сиқыр ...
Dialogue: 0,0:21:47.72,0:21:50.89,Default,,0,0,0,,Жоқ! Dark Schneider Ең үлкен және ең күшті...
Dialogue: 0,0:21:50.97,0:21:51.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:52.01,0:21:52.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:52.85,0:21:55.31,Default,,0,0,0,,Тоқта, тоқта!
Dialogue: 0,0:21:55.81,0:21:56.89,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:21:56.98,0:21:59.40,Default,,0,0,0,,Сіз жынданып кеттіңіз бе, Дирк Шнайдер?
Dialogue: 0,0:21:59.48,0:22:00.52,Default,,0,0,0,,Шу!
Dialogue: 0,0:22:00.61,0:22:02.86,Default,,0,0,0,,Сіз шыққан шымылдық емес!
Dialogue: 0,0:22:02.94,0:22:06.32,Default,,0,0,0,,Мына тозығы жеткен сарайды ұшырып жіберейік!
Dialogue: 0,0:22:06.40,0:22:10.37,Default,,0,0,0,,Харло Ен!
Dialogue: 0,0:22:23.17,0:22:24.50,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.54,0:23:46.55,Default,,0,0,0,,～♪
Dialogue: 0,0:23:48.05,0:23:54.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
