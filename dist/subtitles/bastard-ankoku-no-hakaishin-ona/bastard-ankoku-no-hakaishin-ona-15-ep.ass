Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.92,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:14.72,0:00:17.85,Default,,0,0,0,,Шынымен сенсің
Dialogue: 0,0:00:17.93,0:00:19.18,Default,,0,0,0,,Қандай жігіт
Dialogue: 0,0:00:19.72,0:00:23.85,Default,,0,0,0,,Эй, ол өте әдемі басты кейіпкер.
Dialogue: 0,0:00:24.89,0:00:26.02,Default,,0,0,0,,Руше
Dialogue: 0,0:00:26.81,0:00:30.07,Default,,0,0,0,,Егер бұл рас болса, Йоко-сан көз жасына малынған болар еді.
Dialogue: 0,0:00:30.15,0:00:32.61,Default,,0,0,0,,Ол мені құмарта сүйетін көрініс.
Dialogue: 0,0:00:32.69,0:00:35.28,Default,,0,0,0,,Ех! Ах...
Dialogue: 0,0:00:35.36,0:00:38.12,Default,,0,0,0,,Мен Рушқа қайта ораламын деп ойлаймын.
Dialogue: 0,0:00:38.20,0:00:39.49,Default,,0,0,0,,Мен оны төлеймін.
Dialogue: 0,0:00:40.20,0:00:44.16,Default,,0,0,0,,Йоко-санның сүйкімді қыздығы жойылған күнге дейін
Dialogue: 0,0:00:45.33,0:00:46.71,Default,,0,0,0,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:00:46.79,0:00:50.34,Default,,0,0,0,,Ой!
Dialogue: 0,0:00:51.05,0:00:53.21,Default,,0,0,0,,♪～
Dialogue: 0,0:02:18.93,0:02:20.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:21.47,0:02:23.76,Default,,0,0,0,,Нуну~ Бұл құбыжық
Dialogue: 0,0:02:23.85,0:02:26.22,Default,,0,0,0,,Бұл қарапайым нәрсе емес.
Dialogue: 0,0:02:26.31,0:02:27.14,Default,,0,0,0,,Сәлем Линч!
Dialogue: 0,0:02:27.23,0:02:29.89,Default,,0,0,0,,Тезірек бұл екеуіне қамқор бол!
Dialogue: 0,0:02:29.98,0:02:32.36,Default,,0,0,0,,Менде өте жағымсыз сезім бар.
Dialogue: 0,0:02:32.44,0:02:34.11,Default,,0,0,0,,Түсіндім, Доши.
Dialogue: 0,0:02:35.98,0:02:36.82,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:36.90,0:02:38.53,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:02:38.61,0:02:39.74,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:02:39.82,0:02:40.66,Default,,0,0,0,,Дарш?
Dialogue: 0,0:02:41.36,0:02:45.79,Default,,0,0,0,,Ей, егер мен ұзақ өмір сүрсем, мен қызықты нәрсе көре аламын.
Dialogue: 0,0:02:45.87,0:02:47.45,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:02:47.54,0:02:50.42,Default,,0,0,0,,Балалар, сендер бұл линчке тең келе алмайсыңдар.
Dialogue: 0,0:02:50.50,0:02:51.50,Default,,0,0,0,,Ей, ақымақтар!
Dialogue: 0,0:02:51.58,0:02:53.59,Default,,0,0,0,,Линчинг...
Dialogue: 0,0:02:53.67,0:02:56.55,Default,,0,0,0,,Бұл Доши-сама, өте әйгілі өлі адам,
Dialogue: 0,0:02:57.09,0:02:59.34,Default,,0,0,0,,Күшті жауынгерлер мен рыцарлардың 100 мәйітінен
Dialogue: 0,0:02:59.42,0:03:01.47,Default,,0,0,0,,Ең жақсы бөлшектерден жасалған.
Dialogue: 0,0:03:01.55,0:03:04.47,Default,,0,0,0,,Ол ең күшті өлмеген сарбаз.
Dialogue: 0,0:03:04.55,0:03:07.02,Default,,0,0,0,,Бұл өте әйгілі Доши-саманың сиқырлы күші мен
Dialogue: 0,0:03:07.10,0:03:10.39,Default,,0,0,0,,Сонымен қатар, бізге Абигейл-сама берген аты аңызға айналған қару.
Dialogue: 0,0:03:10.48,0:03:12.98,Default,,0,0,0,,... көмегімен Линч жеңілмейді!
Dialogue: 0,0:03:13.06,0:03:17.19,Default,,0,0,0,,Жеңіске жету мүмкін емес, өйткені сіз қазір жартылай аурусыз.
Dialogue: 0,0:03:17.28,0:03:18.82,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:03:18.90,0:03:21.53,Default,,0,0,0,,Бұл ұлы және әйгілі өлі адам
Dialogue: 0,0:03:21.61,0:03:24.78,Default,,0,0,0,,Енді Доши-сама жасаған көркем шығарманың алдында
Dialogue: 0,0:03:24.87,0:03:29.54,Default,,0,0,0,,Ниндзя шебері Гала және найзағай императоры Ней құлады.
Dialogue: 0,0:03:29.62,0:03:30.79,Default,,0,0,0,,Нухохохохо!
Dialogue: 0,0:03:30.87,0:03:32.17,Default,,0,0,0,,Идиот!
Dialogue: 0,0:03:32.25,0:03:34.63,Default,,0,0,0,,Мен сен туралы ештеңе білмеймін, кішкентай бала!
Dialogue: 0,0:03:34.71,0:03:35.50,Default,,0,0,0,,Иә
Dialogue: 0,0:03:35.59,0:03:37.80,Default,,0,0,0,,Мен сені барлық сауыт-саймандарыңмен қиып аламын.
Dialogue: 0,0:03:37.88,0:03:39.84,Default,,0,0,0,,Маған сол Декуді тезірек беріңіз!
Dialogue: 0,0:03:39.92,0:03:42.93,Default,,0,0,0,,Мен сізге құпия қылыштың күшін көрсетемін!
Dialogue: 0,0:03:43.01,0:03:45.60,Default,,0,0,0,,О! Бұл біртүрлі ұстаным туралы не деуге болады?
Dialogue: 0,0:03:45.68,0:03:47.64,Default,,0,0,0,,Гала-сама мен Ней-саманың ең үлкен құпиясы!
Dialogue: 0,0:03:47.72,0:03:49.10,Default,,0,0,0,,Уггя~!
Dialogue: 0,0:03:49.18,0:03:51.64,Default,,0,0,0,,Мен кішкентай емеспін!
Dialogue: 0,0:03:51.73,0:03:56.36,Default,,0,0,0,,Бар, Линч! Сатқындарды өлтіріңіз!
Dialogue: 0,0:03:56.44,0:03:58.23,Default,,0,0,0,,Нағыз жын семсер!
Dialogue: 0,0:03:58.32,0:04:01.49,Default,,0,0,0,,Хаукен Райгекишуусузан!
Dialogue: 0,0:04:03.53,0:04:04.66,Default,,0,0,0,,Не?
Dialogue: 0,0:04:04.74,0:04:05.82,Default,,0,0,0,,Иә
Dialogue: 0,0:04:05.91,0:04:07.62,Default,,0,0,0,,Әй, қарашы!
Dialogue: 0,0:04:10.08,0:04:10.70,Default,,0,0,0,,Не!
Dialogue: 0,0:04:12.33,0:04:13.50,Default,,0,0,0,,Не? тістер!
Dialogue: 0,0:04:13.58,0:04:15.92,Default,,0,0,0,,Бұл да тағдыр ма?
Dialogue: 0,0:04:16.00,0:04:17.17,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:17.25,0:04:17.79,Default,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:04:19.71,0:04:22.05,Default,,0,0,0,,Ня~хахаха!
Dialogue: 0,0:04:22.13,0:04:24.68,Default,,0,0,0,,Маған қараңдар, ақымақтар!
Dialogue: 0,0:04:24.76,0:04:27.68,Default,,0,0,0,,Мұндай қылыш ...-ге қарсы жұмыс істей ала ма?
Dialogue: 0,0:04:27.76,0:04:30.27,Default,,0,0,0,,Қарғыс атсын, ақымақ...
Dialogue: 0,0:04:30.35,0:04:32.77,Default,,0,0,0,,Мен шынымен де әлсіз болдым ба?
Dialogue: 0,0:04:34.69,0:04:37.81,Default,,0,0,0,,Иә, бұл бұрынғы Көктегі Төрт Патша ма?
Dialogue: 0,0:04:37.90,0:04:40.40,Default,,0,0,0,,Бұл туралы айтудың өзі тым әлсіз.
Dialogue: 0,0:04:40.98,0:04:42.86,Default,,0,0,0,,Ағымдағы Линч және ...
Dialogue: 0,0:04:42.94,0:04:45.03,Default,,0,0,0,,Сібір жарасы қайта оралуда.
Dialogue: 0,0:04:45.11,0:04:48.16,Default,,0,0,0,,Үлкен энергия мөлшері ағып жатыр.
Dialogue: 0,0:04:48.24,0:04:49.87,Default,,0,0,0,,Осы деңгейде
Dialogue: 0,0:04:49.95,0:04:53.54,Default,,0,0,0,,Құрышты тырнап тастай алмаймын, линч жасамақ түгілі.
Dialogue: 0,0:04:53.62,0:04:54.83,Default,,0,0,0,,Хе-хе-хе.
Dialogue: 0,0:04:55.42,0:04:56.75,Default,,0,0,0,,Қарғыс атқан ұрық метаморфозға ұшыраған жағдайда—
Dialogue: 0,0:04:57.25,0:04:59.54,Default,,0,0,0,,Дарш қайта тірілсе де...
Dialogue: 0,0:04:59.63,0:05:00.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:00.38,0:05:02.88,Default,,0,0,0,,Қат! Бұл жаман
Dialogue: 0,0:05:02.96,0:05:05.76,Default,,0,0,0,,Бұрынғы шоктан көзім бұлдырап қалды.
Dialogue: 0,0:05:05.84,0:05:07.51,Default,,0,0,0,,Қырылып қалсам да!
Dialogue: 0,0:05:08.14,0:05:10.68,Default,,0,0,0,,Жақсылыққа жататын күш
Dialogue: 0,0:05:10.76,0:05:13.56,Default,,0,0,0,,Жоюшы Құдайдың зұлым күшінің алдында
Dialogue: 0,0:05:13.64,0:05:16.48,Default,,0,0,0,,Ештеңе болмағанмен бірдей!
Dialogue: 0,0:05:16.56,0:05:18.69,Default,,0,0,0,,Түсіндіңіздер, ақымақтар!
Dialogue: 0,0:05:18.77,0:05:20.36,Default,,0,0,0,,Хяхахаха!
Dialogue: 0,0:05:20.44,0:05:23.90,Default,,0,0,0,,Енді Доши-саманы аздағаным үшін мені жазала.
Dialogue: 0,0:05:23.99,0:05:25.99,Default,,0,0,0,,Мен сізге қазір төлеуге мәжбүр етемін.
Dialogue: 0,0:05:26.99,0:05:28.16,Default,,0,0,0,,Мм... Аа!
Dialogue: 0,0:05:28.24,0:05:32.16,Default,,0,0,0,,Сен осы жерде өлесің!
Dialogue: 0,0:05:33.08,0:05:34.00,Default,,0,0,0,,Дарш…
Dialogue: 0,0:05:34.70,0:05:36.25,Default,,0,0,0,,Тамақтану~
Dialogue: 0,0:05:36.33,0:05:37.96,Default,,0,0,0,,Қаһарлы айқай! ()
Dialogue: 0,0:05:38.04,0:05:41.34,Default,,0,0,0,,Өлме!
Dialogue: 0,0:05:42.00,0:05:43.30,Default,,0,0,0,,Қолдану~
Dialogue: 0,0:05:43.80,0:05:44.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:45.30,0:05:46.22,Default,,0,0,0,,Хая~!
Dialogue: 0,0:05:46.30,0:05:49.18,Default,,0,0,0,,Ооо... сен...!
Dialogue: 0,0:05:49.89,0:05:50.80,Default,,0,0,0,,Дарш?
Dialogue: 0,0:05:51.47,0:05:54.31,Default,,0,0,0,,Зұлым күштердің әсерінен
Dialogue: 0,0:05:54.39,0:05:58.44,Default,,0,0,0,,Тек сен ғана күшейіп жатқан жоқсың!
Dialogue: 0,0:05:58.52,0:06:00.52,Default,,0,0,0,,Гаа~!
Dialogue: 0,0:06:01.81,0:06:03.23,Default,,0,0,0,,Қолдану~
Dialogue: 0,0:06:04.53,0:06:05.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:06.03,0:06:07.78,Default,,0,0,0,,Иә~
Dialogue: 0,0:06:07.86,0:06:10.91,Default,,0,0,0,,Өлгендерді алып, тозаққа қайт!
Dialogue: 0,0:06:10.99,0:06:11.99,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:12.08,0:06:13.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:27.92,0:06:29.13,Default,,0,0,0,,Дарш…
Dialogue: 0,0:06:29.93,0:06:31.05,Default,,0,0,0,,Дарш…
Dialogue: 0,0:06:31.14,0:06:32.43,Default,,0,0,0,,Дарш!
Dialogue: 0,0:06:34.22,0:06:35.85,Default,,0,0,0,,Дарш!
Dialogue: 0,0:06:36.43,0:06:39.35,Default,,0,0,0,,Жарайды, жарайды, ол жақсы қыз.
Dialogue: 0,0:06:39.44,0:06:40.90,Default,,0,0,0,,Енді жылама
Dialogue: 0,0:06:40.98,0:06:41.81,Default,,0,0,0,,Дарш…
Dialogue: 0,0:06:41.90,0:06:43.77,Default,,0,0,0,,Бұл не, сен...
Dialogue: 0,0:06:43.86,0:06:45.98,Default,,0,0,0,,Сіз шынымен тірісіз бе?
Dialogue: 0,0:06:46.07,0:06:47.78,Default,,0,0,0,,Сіз өлмегенсіз бе?
Dialogue: 0,0:06:47.86,0:06:50.99,Default,,0,0,0,,Ақымақ, анау ұзын аяқтарды қара!
Dialogue: 0,0:06:51.07,0:06:52.32,Default,,0,0,0,,Бұл шынайы
Dialogue: 0,0:06:52.41,0:06:55.28,Default,,0,0,0,,Өте әдемі бас кейіпкер өлмейді.
Dialogue: 0,0:06:55.37,0:06:56.20,Default,,0,0,0,,Теми сияқты
Dialogue: 0,0:06:56.29,0:06:59.16,Default,,0,0,0,,Үшінші бөлім, құдайдың еркелігімен жасалған сияқты көрінетін кішігірім рөл.
Dialogue: 0,0:06:59.25,0:07:01.96,Default,,0,0,0,,Өлсең, қайта тірілмейсің.
Dialogue: 0,0:07:02.04,0:07:03.00,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:07:03.08,0:07:04.67,Default,,0,0,0,,Бұл мыңжапырақ
Dialogue: 0,0:07:04.75,0:07:08.42,Default,,0,0,0,,Мені көп уайымдатпа, сен сондай ақылдысың.
Dialogue: 0,0:07:08.51,0:07:11.84,Default,,0,0,0,,Жай ғана салқын көрінуге тырыс және менің жүрегімді қазып ал.
Dialogue: 0,0:07:11.93,0:07:14.97,Default,,0,0,0,,Өмірге қалай оралу керектігін білмесеңіз де, не істеуді жоспарладыңыз?
Dialogue: 0,0:07:15.05,0:07:16.68,Default,,0,0,0,,Мына сегізаяқ!
Dialogue: 0,0:07:16.76,0:07:17.77,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:18.60,0:07:19.81,Default,,0,0,0,,Мен саған айттым
Dialogue: 0,0:07:19.89,0:07:22.44,Default,,0,0,0,,Әдемі-сама өлмес.
Dialogue: 0,0:07:23.19,0:07:24.27,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:07:25.23,0:07:27.86,Default,,0,0,0,,Аспандағы Төрт Патшаның екеуі болса
Dialogue: 0,0:07:27.94,0:07:30.78,Default,,0,0,0,,Мен оны әйтеуір тірілтіп аламын ба деп ойладым.
Dialogue: 0,0:07:32.03,0:07:36.28,Default,,0,0,0,,Сен ақымақсың, жоспарсыз қалағаныңды істеп жүрсің!
Dialogue: 0,0:07:39.16,0:07:41.50,Default,,0,0,0,,Я, менің ниндзя әскерім күткендей.
Dialogue: 0,0:07:41.58,0:07:43.37,Default,,0,0,0,,Жылдам әрекет.
Dialogue: 0,0:07:43.46,0:07:45.75,Default,,0,0,0,,Қандай керемет кремация.
Dialogue: 0,0:07:48.09,0:07:51.55,Default,,0,0,0,,Енді, батырдың жеңіспен оралуы!
Dialogue: 0,0:07:52.18,0:07:55.55,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:56.30,0:07:57.51,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:07:57.60,0:07:59.18,Default,,0,0,0,,Құрметті Дирк Шнайдер!
Dialogue: 0,0:07:59.27,0:08:00.77,Default,,0,0,0,,Ах~ Рахмет!
Dialogue: 0,0:08:01.39,0:08:03.44,Default,,0,0,0,,Бұл тамаша. Көңіл көтеру сияқты.
Dialogue: 0,0:08:03.52,0:08:04.85,Default,,0,0,0,,Келіңіздер, мойындаймыз
Dialogue: 0,0:08:04.94,0:08:08.48,Default,,0,0,0,,Біз енді осы патшалықтың құтқарушыларымыз.
Dialogue: 0,0:08:08.57,0:08:12.20,Default,,0,0,0,,Алайда бұл тек мен жеңген шайқас болды.
Dialogue: 0,0:08:12.28,0:08:13.95,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:08:14.03,0:08:15.95,Default,,0,0,0,,Люс! Гала!
Dialogue: 0,0:08:16.03,0:08:17.03,Default,,0,0,0,,Оу!
Dialogue: 0,0:08:17.12,0:08:19.12,Default,,0,0,0,,Йоко-сан... және Шейла
Dialogue: 0,0:08:20.33,0:08:21.54,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:23.96,0:08:24.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:24.87,0:08:27.00,Default,,0,0,0,,Ах! Ха...
Dialogue: 0,0:08:30.63,0:08:33.80,Default,,0,0,0,,Ах, уау, хаос көрінісі...
Dialogue: 0,0:08:36.01,0:08:36.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:37.39,0:08:38.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:39.60,0:08:41.97,Default,,0,0,0,,Иә? Не болды, Эше?
Dialogue: 0,0:08:42.06,0:08:43.94,Default,,0,0,0,,Мм... (Азаматтар) О!
Dialogue: 0,0:08:44.02,0:08:44.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:44.77,0:08:46.73,Default,,0,0,0,,Бұл керемет болды, Дирк Шнайдер!
Dialogue: 0,0:08:46.81,0:08:49.36,Default,,0,0,0,,Жарайсың, қайта тірілдің.
Dialogue: 0,0:08:49.44,0:08:51.07,Default,,0,0,0,,Шынымен өлмейтін.
Dialogue: 0,0:08:51.15,0:08:52.40,Default,,0,0,0,,Жоқ, мүлде емес.
Dialogue: 0,0:08:52.49,0:08:54.49,Default,,0,0,0,,Саса Йоко-доно да банкет бөлмесінде!
Dialogue: 0,0:08:54.57,0:08:56.49,Default,,0,0,0,,Не? Аз ғана~
Dialogue: 0,0:08:58.16,0:09:00.24,Default,,0,0,0,,үшін жай ғана Дирк Шнайдер
Dialogue: 0,0:09:00.33,0:09:02.87,Default,,0,0,0,,Сіз өз күшіңізбен қайта жандандым деп ойлайтын сияқтысыз.
Dialogue: 0,0:09:04.08,0:09:05.58,Default,,0,0,0,,Гео байқады ма?
Dialogue: 0,0:09:06.08,0:09:10.25,Default,,0,0,0,,Бұл қайта тірілуді іске қосылған зұлым құдай ирониялық түрде шығарды.
Dialogue: 0,0:09:10.34,0:09:13.09,Default,,0,0,0,,Оған күшті қара күш себеп болды...
Dialogue: 0,0:09:14.05,0:09:16.80,Default,,0,0,0,,Бірақ содан кейін мен көрдім
Dialogue: 0,0:09:16.88,0:09:19.80,Default,,0,0,0,,Дарк Шнайдердің Люс Ренренге айналуы
Dialogue: 0,0:09:19.89,0:09:21.72,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:25.06,0:09:27.69,Default,,0,0,0,,Люс Ренрен деген кім? Мүмкін...
Dialogue: 0,0:09:28.81,0:09:32.69,Default,,0,0,0,,Олай болса, Гала-доно Шиши-Фукуджин бұл кезде қалай болды!
Dialogue: 0,0:09:32.78,0:09:34.65,Default,,0,0,0,,? Солай ма?
Dialogue: 0,0:09:34.74,0:09:39.20,Default,,0,0,0,,Мен жарақатыма байланысты жоқпын. Мен сізге патшаның атынан алғыс айтқым келеді.
Dialogue: 0,0:09:39.87,0:09:40.87,Default,,0,0,0,,Рахмет Гала
Dialogue: 0,0:09:41.70,0:09:43.54,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:43.62,0:09:44.58,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:44.66,0:09:47.83,Default,,0,0,0,,Айтпақшы, мен Дирк Шнайдер мырзаны көре алмаймын...
Dialogue: 0,0:09:47.92,0:09:52.17,Default,,0,0,0,,Эй, ол шаршадым деп Нейсамамен бөлмесіне кетті.
Dialogue: 0,0:09:52.25,0:09:52.92,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:53.00,0:09:55.59,Default,,0,0,0,,Айтпақшы, жас ханым мұнда да жоқ.
Dialogue: 0,0:09:55.67,0:09:56.84,Default,,0,0,0,,Қызық
Dialogue: 0,0:09:56.92,0:09:58.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:00.43,0:10:03.60,Default,,0,0,0,,Әй, жарқырап сынған.
Dialogue: 0,0:10:03.68,0:10:06.06,Default,,0,0,0,,Аспаз аспаз Аспаз…
Dialogue: 0,0:10:07.48,0:10:08.31,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:08.39,0:10:09.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:09.81,0:10:13.48,Default,,0,0,0,,Сіз әлі де көңілді жүрсіз бе? Сіз... хмм?
Dialogue: 0,0:10:13.57,0:10:16.15,Default,,0,0,0,,Бұны мәңгі киіп жүрме, киіміңді ауыстыр.
Dialogue: 0,0:10:16.24,0:10:17.57,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:10:18.36,0:10:21.49,Default,,0,0,0,,Сізге әзіл-оспақ жетіспейді, солай емес пе?
Dialogue: 0,0:10:21.57,0:10:22.53,Default,,0,0,0,,Дарш…
Dialogue: 0,0:10:23.03,0:10:25.20,Default,,0,0,0,,Жүр, мен сені киіндіремін.
Dialogue: 0,0:10:26.58,0:10:30.00,Default,,0,0,0,,Кешіріңіз, мені кешіріңіз.
Dialogue: 0,0:10:31.92,0:10:34.38,Default,,0,0,0,,Күл, мен сені сүйемін.
Dialogue: 0,0:10:36.26,0:10:40.64,Default,,0,0,0,,Мен де... Мен де! мен сені сүйемін
Dialogue: 0,0:10:41.14,0:10:44.56,Default,,0,0,0,,Мен, мен... Мен Даршты өлтірмек болдым.
Dialogue: 0,0:10:45.10,0:10:47.22,Default,,0,0,0,,Дарш маған арналған...
Dialogue: 0,0:10:47.81,0:10:48.85,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:48.93,0:10:51.19,Default,,0,0,0,,Мені жек көрме!
Dialogue: 0,0:10:51.27,0:10:53.86,Default,,0,0,0,,Әй, сен ақымақсың.
Dialogue: 0,0:10:54.98,0:10:56.98,Default,,0,0,0,,Эш үшін
Dialogue: 0,0:10:57.07,0:10:59.78,Default,,0,0,0,,Жүрегіңді кез келген уақытта шығарамын.
Dialogue: 0,0:10:59.86,0:11:03.16,Default,,0,0,0,,Сен менің жалғыз сүйкімді қызымсың.
Dialogue: 0,0:11:04.45,0:11:05.53,Default,,0,0,0,,Қызым…
Dialogue: 0,0:11:06.79,0:11:09.66,Default,,0,0,0,,Жоқ... менің қызым болғаны дұрыс.
Dialogue: 0,0:11:09.75,0:11:11.71,Default,,0,0,0,,Сен мені сүйсең
Dialogue: 0,0:11:14.63,0:11:15.50,Default,,0,0,0,,Дарш…
Dialogue: 0,0:11:16.21,0:11:17.13,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:11:19.51,0:11:21.09,Default,,0,0,0,,Сол мыңжапырақ
Dialogue: 0,0:11:21.18,0:11:23.34,Default,,0,0,0,,Metallicana үшін, тіпті құтқарушы
Dialogue: 0,0:11:23.43,0:11:25.26,Default,,0,0,0,,Әйелдің табиғи жауы
Dialogue: 0,0:11:25.93,0:11:26.60,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:11:26.68,0:11:27.77,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:11:27.85,0:11:30.52,Default,,0,0,0,,Бұл сен болған кезден үлкен айырмашылық, Люс.
Dialogue: 0,0:11:31.19,0:11:34.81,Default,,0,0,0,,Әйелдің сезіміне мән бермейтін сияқты...
Dialogue: 0,0:11:35.52,0:11:40.49,Default,,0,0,0,,Бірақ қанша абдырап қалсаң да, бәрібір сенсің, Люс.
Dialogue: 0,0:11:41.24,0:11:45.07,Default,,0,0,0,,Әйтпесе, мен сені аяймын, Люси.
Dialogue: 0,0:11:46.74,0:11:49.66,Default,,0,0,0,,Мен сенімен танысқым келеді, Люс.
Dialogue: 0,0:11:52.62,0:11:54.08,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:54.17,0:11:57.29,Default,,0,0,0,,Хохохохо
Dialogue: 0,0:11:57.38,0:12:00.26,Default,,0,0,0,,Хохохохо
Dialogue: 0,0:12:00.34,0:12:03.26,Default,,0,0,0,,Хохохохо
Dialogue: 0,0:12:03.34,0:12:06.35,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:12:07.01,0:12:09.60,Default,,0,0,0,,Рождество мерекесімен Йоко-сан
Dialogue: 0,0:12:13.35,0:12:15.65,Default,,0,0,0,,Не істеп жатырсың, Люс?
Dialogue: 0,0:12:15.73,0:12:17.82,Default,,0,0,0,,Не? Не айтқың келеді?
Dialogue: 0,0:12:17.90,0:12:19.02,Default,,0,0,0,,Бүркіт – Аяз ата
Dialogue: 0,0:12:19.11,0:12:21.32,Default,,0,0,0,,Енді менің аяқ киімімнің астындағы сыйлық...
Dialogue: 0,0:12:21.40,0:12:22.61,Default,,0,0,0,,J-
Dialogue: 0,0:12:22.70,0:12:25.95,Default,,0,0,0,,Хмм... Сіз қайдан білдіңіз?
Dialogue: 0,0:12:26.70,0:12:27.87,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:27.95,0:12:30.58,Default,,0,0,0,,Қазіргі балалардың арманы жоқ.
Dialogue: 0,0:12:32.62,0:12:36.08,Default,,0,0,0,,Қарызға алған 500 иенімді қайтаруды ойлап келдім.
Dialogue: 0,0:12:36.17,0:12:36.83,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:12:36.92,0:12:40.63,Default,,0,0,0,,Қарыз алған ақшадан пайыз алынады, Аяз ата!
Dialogue: 0,0:12:41.59,0:12:42.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:42.51,0:12:44.09,Default,,0,0,0,,Оны саған денеммен қайтарамын.
Dialogue: 0,0:12:45.09,0:12:47.47,Default,,0,0,0,,Хмф! (Дирк Шнайдер) Иә!
Dialogue: 0,0:12:48.89,0:12:50.35,Default,,0,0,0,,Не?
Dialogue: 0,0:12:50.43,0:12:53.73,Default,,0,0,0,,Сіз Дирк Шнайдер қайта тірілді дейсіз бе?
Dialogue: 0,0:12:53.81,0:12:55.14,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:12:55.23,0:12:56.69,Default,,0,0,0,,Сонда біздің әскер...
Dialogue: 0,0:12:56.77,0:12:58.73,Default,,0,0,0,,Линчке не болды?
Dialogue: 0,0:12:58.81,0:13:01.28,Default,,0,0,0,,Бұл Сібір жарасы шығаратын зұлым толқындар.
Dialogue: 0,0:13:01.36,0:13:03.49,Default,,0,0,0,,Ең керемет зомбиге айналу керек еді
Dialogue: 0,0:13:03.57,0:13:06.78,Default,,0,0,0,,Оның үстіне, бұл жын поштасы сиқырдың барлық түрлерін қайтарады.
Dialogue: 0,0:13:06.86,0:13:09.70,Default,,0,0,0,,Кез келген қылыштан күшті жеңілмейтін сауыт!
Dialogue: 0,0:13:09.78,0:13:10.66,Default,,0,0,0,,Хаха…
Dialogue: 0,0:13:10.74,0:13:13.00,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:13:13.70,0:13:15.58,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:13:15.66,0:13:16.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:16.75,0:13:20.54,Default,,0,0,0,,Сіз маған секіріп тепкілеп, құлаттым дедіңіз бе?
Dialogue: 0,0:13:20.63,0:13:24.26,Default,,0,0,0,,Кя! Қандай сұмдық адам
Dialogue: 0,0:13:24.34,0:13:26.51,Default,,0,0,0,,Бір соққыдағы линч!
Dialogue: 0,0:13:26.59,0:13:28.72,Default,,0,0,0,,Ол адам адам емес.
Dialogue: 0,0:13:28.80,0:13:30.47,Default,,0,0,0,,Вахахаха
Dialogue: 0,0:13:30.55,0:13:33.89,Default,,0,0,0,,Белсендірілген Сібір жарасының күші
Dialogue: 0,0:13:33.97,0:13:36.48,Default,,0,0,0,,Тіпті Дирк Шнайдер де кірмеді ме?
Dialogue: 0,0:13:36.56,0:13:37.98,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:13:38.06,0:13:42.40,Default,,0,0,0,,Антрасакстың зұлым дірілдері Линчтің күшін екі есе арттырды.
Dialogue: 0,0:13:42.48,0:13:45.49,Default,,0,0,0,,Қараңғылыққа жақын адамдарға күшті әсер ету
Dialogue: 0,0:13:46.65,0:13:47.78,Default,,0,0,0,,Егер
Dialogue: 0,0:13:47.86,0:13:49.91,Default,,0,0,0,,Бір кездері қараңғылықтың шетінде
Dialogue: 0,0:13:49.99,0:13:52.83,Default,,0,0,0,,Тіпті жын деп аталған адам ең жақсы...
Dialogue: 0,0:13:53.45,0:13:54.12,Default,,0,0,0,,Иә
Dialogue: 0,0:13:54.20,0:13:57.83,Default,,0,0,0,,Антрасакстың қайта жандануы кері нәтиже берді ме?
Dialogue: 0,0:13:57.92,0:14:00.96,Default,,0,0,0,,Гала аударылып, Ней де аман қалды.
Dialogue: 0,0:14:01.04,0:14:04.34,Default,,0,0,0,,Енді Аспандағы Төрт патша екіге бөлініп, соғысады.
Dialogue: 0,0:14:06.38,0:14:09.59,Default,,0,0,0,,Қандай бақытсыз адам!
Dialogue: 0,0:14:11.64,0:14:13.43,Default,,0,0,0,,Эй, көрдің бе? Cal...
Dialogue: 0,0:14:13.93,0:14:15.27,Default,,0,0,0,,Бұл күлкілі болды
Dialogue: 0,0:14:15.35,0:14:17.10,Default,,0,0,0,,Мен оны бірінші рет көрдім.
Dialogue: 0,0:14:17.18,0:14:18.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:18.19,0:14:20.60,Default,,0,0,0,,Мен Қараңғы Шнайдермін!
Dialogue: 0,0:14:20.69,0:14:24.07,Default,,0,0,0,,Менің сүйкімді құбыжықтарым...
Dialogue: 0,0:14:24.15,0:14:27.24,Default,,0,0,0,,Сәлем! Абигейл ашулы
Dialogue: 0,0:14:27.32,0:14:29.53,Default,,0,0,0,,Хахаха мен бірінші рет көрдім
Dialogue: 0,0:14:29.61,0:14:31.95,Default,,0,0,0,,Осылай жалғаса берсе, кешіріңіз.
Dialogue: 0,0:14:32.03,0:14:33.70,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:14:33.83,0:14:39.50,Default,,0,0,0,,Мен келесі өлмеген солдаттың өлімін тоқтатуды қамтамасыз етемін.
Dialogue: 0,0:14:42.71,0:14:44.55,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:14:44.63,0:14:46.46,Default,,0,0,0,,Сен менің курткамды ұшырып, мені де ұшырып жібердің ғой!
Dialogue: 0,0:14:47.84,0:14:50.47,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:14:52.39,0:14:56.43,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:14:56.93,0:14:58.10,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:14:58.18,0:15:02.15,Default,,0,0,0,,Менің сұмдығым, сауыттың өзінде бірде-бір сызат жоқ.
Dialogue: 0,0:15:02.23,0:15:03.56,Default,,0,0,0,,...
Dialogue: 0,0:15:04.11,0:15:06.03,Default,,0,0,0,,Ежелгі құжаттар бойынша Жазылған тарихтан бері
Dialogue: 0,0:15:06.11,0:15:08.44,Default,,0,0,0,,Жер бетінде «Жын», «Ібіліс» және «Шайтан» атты адамдар бар.
Dialogue: 0,0:15:08.53,0:15:10.57,Default,,0,0,0,,Үш қару бар.
Dialogue: 0,0:15:10.65,0:15:13.24,Default,,0,0,0,,Олар «сиқырлы құралдардың үш түрі» деп аталады.
Dialogue: 0,0:15:13.82,0:15:16.70,Default,,0,0,0,,Олардың біреуі барлық сиқырды блоктайды.
Dialogue: 0,0:15:16.79,0:15:19.08,Default,,0,0,0,,Оны басқа қылыштардан да қаттырақ дейді.
Dialogue: 0,0:15:19.16,0:15:20.83,Default,,0,0,0,,Бұл жын поштасы
Dialogue: 0,0:15:20.92,0:15:23.42,Default,,0,0,0,,Менің жын семсерім және Нейдің найзағайы
Dialogue: 0,0:15:23.50,0:15:26.75,Default,,0,0,0,,Бұл сауытқа тиер алдында ол кері серпілді.
Dialogue: 0,0:15:26.84,0:15:29.17,Default,,0,0,0,,Осылай сауыт кисең, жеңілмессің.
Dialogue: 0,0:15:29.26,0:15:30.26,Default,,0,0,0,,Иә, Гео?
Dialogue: 0,0:15:30.34,0:15:31.97,Default,,0,0,0,,Оны тоқтатыңыз.
Dialogue: 0,0:15:32.47,0:15:34.72,Default,,0,0,0,,Ібіліс аты бар сиқырлы қару
Dialogue: 0,0:15:34.80,0:15:36.68,Default,,0,0,0,,Жындар әлемінің жаратылысы немесе өлмеген
Dialogue: 0,0:15:36.76,0:15:40.35,Default,,0,0,0,,Басқаша айтқанда, оны қараңғыда туғандар ғана кие алады.
Dialogue: 0,0:15:40.43,0:15:41.73,Default,,0,0,0,,Мен оны кигізсем ше?
Dialogue: 0,0:15:42.60,0:15:45.69,Default,,0,0,0,,Тірі тіршілік иесі осыны пайдаланса
Dialogue: 0,0:15:46.44,0:15:49.82,Default,,0,0,0,,Сауыт бірден жанды да, тәнді де жеді.
Dialogue: 0,0:15:49.90,0:15:52.45,Default,,0,0,0,,Бір кесек ет қалмайды.
Dialogue: 0,0:15:52.53,0:15:53.99,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:15:54.57,0:15:57.45,Default,,0,0,0,,Иә, солай ма? қорқынышты
Dialogue: 0,0:15:58.16,0:16:01.50,Default,,0,0,0,,Үш дегені тағы екеуі бар дегенді білдіреді, солай ма?
Dialogue: 0,0:16:02.00,0:16:04.08,Default,,0,0,0,,Абигейлдің жігіті, мүмкін...
Dialogue: 0,0:16:04.17,0:16:05.42,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:05.50,0:16:06.59,Default,,0,0,0,,Екінің бірі
Dialogue: 0,0:16:06.67,0:16:09.38,Default,,0,0,0,,Көне құжаттар қатты бүлінген, бірақ мен түсінбеймін.
Dialogue: 0,0:16:09.46,0:16:12.13,Default,,0,0,0,,Мен бұл туралы бір нәрсені білемін.
Dialogue: 0,0:16:12.63,0:16:17.30,Default,,0,0,0,,Бірақ мен мұндай сирек кездесетін үш қару жаудың қолында болады деп ешқашан ойламадым.
Dialogue: 0,0:16:17.39,0:16:19.39,Default,,0,0,0,,Ойлау қиын, бірақ...
Dialogue: 0,0:16:19.47,0:16:22.60,Default,,0,0,0,,Жарайды... Тағы не қалайсыз?
Dialogue: 0,0:16:24.48,0:16:28.15,Default,,0,0,0,,Ібіліс сойыл! Сондай-ақ Жер сойылы ретінде белгілі
Dialogue: 0,0:16:29.15,0:16:31.69,Default,,0,0,0,,Жердің тамырларын басқаратын найзағай құдайының қылыш.
Dialogue: 0,0:16:31.78,0:16:34.66,Default,,0,0,0,,Жалындаған қылышпен салыстыруға болатын аты аңызға айналған қару.
Dialogue: 0,0:16:34.74,0:16:38.41,Default,,0,0,0,,Сойыл күшті жер сілкінісі тудыратын күшке ие дейді.
Dialogue: 0,0:16:38.49,0:16:40.12,Default,,0,0,0,,Үлкен жер сілкінісі
Dialogue: 0,0:16:40.70,0:16:42.20,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:16:42.29,0:16:46.71,Default,,0,0,0,,Ібіліс Мэйстің қорқынышты қабілеттері бар сияқты.
Dialogue: 0,0:16:48.21,0:16:50.59,Default,,0,0,0,,Зақымданғандықтан оқи алмадым.
Dialogue: 0,0:16:50.67,0:16:51.80,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:16:51.88,0:16:55.84,Default,,0,0,0,,Жақсы, ол бәрібір қылышты алады, солай ма?
Dialogue: 0,0:16:55.93,0:16:57.68,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:16:57.76,0:17:01.81,Default,,0,0,0,,Қандай құбыжық болса да, Мұрасамеммен кесіп аламын!
Dialogue: 0,0:17:01.89,0:17:02.98,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:17:03.06,0:17:05.77,Default,,0,0,0,,Бас діни қызметкер! Жау шабуылы!
Dialogue: 0,0:17:05.85,0:17:07.69,Default,,0,0,0,,Үлкен сойылмен циклоп
Dialogue: 0,0:17:07.77,0:17:09.98,Default,,0,0,0,,Біз қала арқылы осы жолмен келе жатырмыз!
Dialogue: 0,0:17:10.07,0:17:12.69,Default,,0,0,0,,Не? Үлкен сойыл ма?
Dialogue: 0,0:17:12.78,0:17:14.78,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:15.99,0:17:18.16,Default,,0,0,0,,Иә! Не?
Dialogue: 0,0:17:18.82,0:17:19.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:21.99,0:17:24.58,Default,,0,0,0,,Иә? А, бұл не?
Dialogue: 0,0:17:24.66,0:17:26.37,Default,,0,0,0,,Сіз қанша уақыт болдыңыз?
Dialogue: 0,0:17:26.46,0:17:28.96,Default,,0,0,0,,Не? Қайда бара жатырсың?
Dialogue: 0,0:17:29.04,0:17:30.46,Default,,0,0,0,,Мені тастама!
Dialogue: 0,0:17:31.55,0:17:32.92,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:17:33.42,0:17:35.84,Default,,0,0,0,,Мен ешқайда бармаймын.
Dialogue: 0,0:17:35.92,0:17:39.34,Default,,0,0,0,,Өйткені, сен әрқашан бала боласың...
Dialogue: 0,0:17:42.14,0:17:43.56,Default,,0,0,0,,Қараңызшы, бұл от.
Dialogue: 0,0:17:44.73,0:17:47.85,Default,,0,0,0,,Қалаға бірдеңе кірген сияқты.
Dialogue: 0,0:17:49.65,0:17:50.69,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:17:50.77,0:17:51.65,Default,,0,0,0,,Мұнда және мұнда
Dialogue: 0,0:17:52.27,0:17:54.32,Default,,0,0,0,,Вахахаха!
Dialogue: 0,0:17:54.40,0:17:55.90,Default,,0,0,0,,Ей, ақымақтар!
Dialogue: 0,0:17:55.99,0:17:57.32,Default,,0,0,0,,Бұл сендерсіңдер, балалар
Dialogue: 0,0:17:57.40,0:18:00.16,Default,,0,0,0,,Қайта тірілген данышпан, өлілердің шебері, Доши-сама жасаған.
Dialogue: 0,0:18:00.24,0:18:04.50,Default,,0,0,0,,Сіз өлмеген Циклоп Вивианды жеңе аласыз ба... хаха
Dialogue: 0,0:18:04.58,0:18:05.75,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:05.83,0:18:07.12,Default,,0,0,0,,Эхехе
Dialogue: 0,0:18:07.21,0:18:09.00,Default,,0,0,0,,Бұл Вивиан кім?
Dialogue: 0,0:18:09.08,0:18:12.59,Default,,0,0,0,,Циклоптардың онсыз да күшті бұлшықеттері
Dialogue: 0,0:18:12.67,0:18:17.97,Default,,0,0,0,,Бұл антрасакс тінімен трансплантацияланған адам оқының түпкі түрі.
Dialogue: 0,0:18:18.05,0:18:20.22,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл әдемі, солай емес пе? Ә?
Dialogue: 0,0:18:20.30,0:18:21.68,Default,,0,0,0,,Осы Вивианға
Dialogue: 0,0:18:21.76,0:18:25.35,Default,,0,0,0,,Егер сізде Абигейлдің осы шайтан сойылы болса,
Dialogue: 0,0:18:25.43,0:18:28.14,Default,,0,0,0,,Дұрыс, бұл жын.
Dialogue: 0,0:18:28.23,0:18:30.31,Default,,0,0,0,,Кел, Вивиан!
Dialogue: 0,0:18:30.40,0:18:33.27,Default,,0,0,0,,Маған сойылдың күшін көрсет
Dialogue: 0,0:18:33.36,0:18:35.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:35.94,0:18:36.99,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:18:38.82,0:18:40.20,Default,,0,0,0,,Уф... не?
Dialogue: 0,0:18:40.28,0:18:41.07,Default,,0,0,0,,Джиджиджижи…
Dialogue: 0,0:18:41.16,0:18:41.82,Default,,0,0,0,,Жер сілкінісі!
Dialogue: 0,0:18:47.04,0:18:48.50,Default,,0,0,0,,Кя хохохо!
Dialogue: 0,0:18:48.58,0:18:50.00,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:50.08,0:18:52.46,Default,,0,0,0,,Егер бұлай болса, Дирк Шнайдер де хит болады.
Dialogue: 0,0:18:52.54,0:18:53.42,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:18:53.50,0:18:55.05,Default,,0,0,0,,Nyohohohoho!
Dialogue: 0,0:18:55.13,0:18:56.26,Default,,0,0,0,,Saateto
Dialogue: 0,0:18:56.34,0:18:58.76,Default,,0,0,0,,Оны Абигейлге әлі піскен кезде ұсыныңыз.
Dialogue: 0,0:18:58.84,0:19:02.68,Default,,0,0,0,,Сіз келесі өлмеген сарбаздың бөліктерін жинап жатырсыз ба?
Dialogue: 0,0:19:02.76,0:19:04.76,Default,,0,0,0,,Анашым! Анашым!
Dialogue: 0,0:19:05.47,0:19:06.64,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:19:07.31,0:19:08.48,Default,,0,0,0,,Гаки~
Dialogue: 0,0:19:08.56,0:19:09.73,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:09.81,0:19:13.19,Default,,0,0,0,,Сенің көздерің өте әдемі.
Dialogue: 0,0:19:13.73,0:19:14.98,Default,,0,0,0,,Оны маған беріңіз!
Dialogue: 0,0:19:15.07,0:19:16.65,Default,,0,0,0,,Nihihihi~
Dialogue: 0,0:19:16.73,0:19:17.53,Default,,0,0,0,,Оны маған бер!
Dialogue: 0,0:19:17.61,0:19:18.53,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:19.57,0:19:21.16,Default,,0,0,0,,Ах! Эмма!
Dialogue: 0,0:19:21.24,0:19:22.53,Default,,0,0,0,,Ия, тоқта!
Dialogue: 0,0:19:22.61,0:19:24.12,Default,,0,0,0,,Қызыма не істеп жүрсің... А!
Dialogue: 0,0:19:24.74,0:19:25.45,Default,,0,0,0,,Анашым!
Dialogue: 0,0:19:25.53,0:19:27.20,Default,,0,0,0,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:19:27.29,0:19:29.71,Default,,0,0,0,,және олқылықты пайдалану
Dialogue: 0,0:19:29.79,0:19:31.12,Default,,0,0,0,,Сәлем! Апыр-ай!
Dialogue: 0,0:19:31.21,0:19:32.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:32.17,0:19:34.75,Default,,0,0,0,,Мына баладан жалтарма!
Dialogue: 0,0:19:34.84,0:19:37.50,Default,,0,0,0,,Көз алмасын ақырын беріңіз!
Dialogue: 0,0:19:37.59,0:19:38.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:38.67,0:19:40.97,Default,,0,0,0,,Сізде көз алмасы бар ма?
Dialogue: 0,0:19:41.05,0:19:42.09,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:19:42.18,0:19:43.22,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:19:43.30,0:19:45.93,Default,,0,0,0,,Эй, сен...
Dialogue: 0,0:19:46.01,0:19:48.64,Default,,0,0,0,,Не? Не? о?
Dialogue: 0,0:19:48.72,0:19:50.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:54.40,0:19:57.44,Default,,0,0,0,,Жарайсыңдар, балалар.
Dialogue: 0,0:19:57.52,0:19:59.94,Default,,0,0,0,,Сіз өкінесіз
Dialogue: 0,0:20:00.03,0:20:01.07,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:01.15,0:20:02.70,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:20:04.49,0:20:06.28,Default,,0,0,0,,Гуфу фухахахаха!
Dialogue: 0,0:20:06.37,0:20:09.54,Default,,0,0,0,,Ақымақ, сені өлім тағдыры күтіп тұр...
Dialogue: 0,0:20:09.62,0:20:11.46,Default,,0,0,0,,Шыу!
Dialogue: 0,0:20:11.54,0:20:12.54,Default,,0,0,0,,Ия, тоқта!
Dialogue: 0,0:20:12.62,0:20:15.96,Default,,0,0,0,,Келесі жолы мені тепсең, өмірің бітеді.
Dialogue: 0,0:20:16.04,0:20:16.92,Default,,0,0,0,,(Танжиро) Бір сәт бұрын осы адам осы жерде жай ғана серуендеп жүрген еді…
Dialogue: 0,0:20:17.00,0:20:19.13,Default,,0,0,0,,Көз алмасын қалайсыз, солай ма?
Dialogue: 0,0:20:19.21,0:20:20.09,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:20:20.17,0:20:23.01,Default,,0,0,0,,Мен де саған сыйлық беремін!
Dialogue: 0,0:20:23.09,0:20:25.14,Default,,0,0,0,,Не? Расында ма?
Dialogue: 0,0:20:25.22,0:20:27.30,Default,,0,0,0,,Көз алмаларың!
Dialogue: 0,0:20:27.39,0:20:28.39,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:28.47,0:20:30.77,Default,,0,0,0,,Жоқ! Өтінемін тоқта!
Dialogue: 0,0:20:30.85,0:20:31.73,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:31.81,0:20:36.06,Default,,0,0,0,,Мен әлсіздерді жегенді жақсы көремін!
Dialogue: 0,0:20:36.15,0:20:37.90,Default,,0,0,0,,Kya~! сен не істемексің
Dialogue: 0,0:20:37.98,0:20:39.44,Default,,0,0,0,,Uggya~!
Dialogue: 0,0:20:39.52,0:20:43.28,Default,,0,0,0,,Ахахахахахха!
Dialogue: 0,0:20:43.36,0:20:46.99,Default,,0,0,0,,Содан бері ештеңе өзгермеген сияқты...
Dialogue: 0,0:20:47.07,0:20:48.37,Default,,0,0,0,,Керемет!
Dialogue: 0,0:20:51.04,0:20:54.08,Default,,0,0,0,,Uuu...
Dialogue: 0,0:20:54.16,0:20:56.83,Default,,0,0,0,,О~ Вивиан, мені өлтір!
Dialogue: 0,0:20:56.92,0:20:59.38,Default,,0,0,0,,Мына адамды өлтір!
Dialogue: 0,0:21:01.63,0:21:03.17,Default,,0,0,0,,(Үру)
Dialogue: 0,0:21:04.38,0:21:05.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:06.26,0:21:08.01,Default,,0,0,0,,Мені күлдірмеңіз!
Dialogue: 0,0:21:08.10,0:21:10.60,Default,,0,0,0,,Мен сенен 100 миллион есе күштімін!
Dialogue: 0,0:21:11.14,0:21:13.31,Default,,0,0,0,,...
Dialogue: 0,0:21:13.39,0:21:15.06,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:21:17.52,0:21:19.27,Default,,0,0,0,,О! Мен жасаймын!
Dialogue: 0,0:21:19.36,0:21:20.23,Default,,0,0,0,,Дарш!
Dialogue: 0,0:21:20.32,0:21:23.24,Default,,0,0,0,,Хе хи! Уау! Уау!
Dialogue: 0,0:21:23.32,0:21:25.95,Default,,0,0,0,,Ахахаха сен ақымақ!
Dialogue: 0,0:21:26.03,0:21:30.41,Default,,0,0,0,,Сіз мына Қараңғы Шнайдерді осындай Деку қуыршақпен жеңе аласыз ба?
Dialogue: 0,0:21:30.49,0:21:32.87,Default,,0,0,0,,Гуаааа...аааа...
Dialogue: 0,0:21:32.95,0:21:35.25,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:21:35.91,0:21:37.08,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:21:37.17,0:21:38.71,Default,,0,0,0,,Біз тек адамбыз; бәрі біз қалағандай бола бермейді.
Dialogue: 0,0:21:42.17,0:21:44.17,Default,,0,0,0,,Не? Тесік жабылады ма?
Dialogue: 0,0:21:44.26,0:21:45.51,Default,,0,0,0,,(Үру)
Dialogue: 0,0:21:45.59,0:21:46.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:48.22,0:21:51.22,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:21:51.31,0:21:54.93,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:21:55.93,0:21:57.89,Default,,0,0,0,,Уау! Бұл не?
Dialogue: 0,0:21:57.98,0:22:00.27,Default,,0,0,0,,Біртүрлі болып өзгереді.
Dialogue: 0,0:22:00.36,0:22:02.69,Default,,0,0,0,,(Үру)
Dialogue: 0,0:22:03.82,0:22:06.70,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:22:09.66,0:22:12.95,Default,,0,0,0,,(Үру)
Dialogue: 0,0:22:13.04,0:22:15.95,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:22:18.92,0:22:20.21,Default,,0,0,0,,Ол ата-анасының үйіне оралды
