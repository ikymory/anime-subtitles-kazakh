Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.96,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:14.51,0:00:17.64,Default,,0,0,0,,Не? Эй, бұл не?
Dialogue: 0,0:00:17.72,0:00:19.22,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:00:19.31,0:00:20.60,Default,,0,0,0,,Агия Агия!
Dialogue: 0,0:00:20.68,0:00:23.39,Default,,0,0,0,,Ух... Күл Ней
Dialogue: 0,0:00:23.48,0:00:27.40,Default,,0,0,0,,Сіз қорқынышты нәрсе жасадыңыз.
Dialogue: 0,0:00:27.48,0:00:29.57,Default,,0,0,0,,(Үру)
Dialogue: 0,0:00:29.65,0:00:33.11,Default,,0,0,0,,Абигейлдің денесін зақымдау нені білдіреді?
Dialogue: 0,0:00:33.19,0:00:36.07,Default,,0,0,0,,Сенің істегенің – Құдайға қарсы шығу!
Dialogue: 0,0:00:36.16,0:00:39.12,Default,,0,0,0,,Ха, мені күлдірме, Абигейл.
Dialogue: 0,0:00:39.20,0:00:43.20,Default,,0,0,0,,Оянғаннан кейін бәрін жойғанша жұмыс істейсің.
Dialogue: 0,0:00:43.29,0:00:47.71,Default,,0,0,0,,Сіз не істесеңіз де, оны тоқтата алмайсыз немесе өлтіре алмайсыз.
Dialogue: 0,0:00:47.79,0:00:51.34,Default,,0,0,0,,және ешқандай басқаруды немесе команданы қабылдамайды
Dialogue: 0,0:00:51.42,0:00:54.63,Default,,0,0,0,,Бұл сіздің Құдайыңыздың шынайы болмысы емес пе?
Dialogue: 0,0:00:55.22,0:00:55.97,Default,,0,0,0,,Иә
Dialogue: 0,0:00:56.05,0:00:58.64,Default,,0,0,0,,Олай болса, мұндай нәрсе Құдай емес.
Dialogue: 0,0:00:58.72,0:00:59.76,Default,,0,0,0,,Бұл шайтан!
Dialogue: 0,0:01:00.26,0:01:02.47,Default,,0,0,0,,Сен бізді Төрт Аспан Патшасын алдадың.
Dialogue: 0,0:01:02.56,0:01:06.44,Default,,0,0,0,,Бұл қазіргі заманда ескі дүниенің жындарын оятуды көздегенін білдіреді.
Dialogue: 0,0:01:07.10,0:01:09.65,Default,,0,0,0,,Кукуку… Ал егер?
Dialogue: 0,0:01:09.73,0:01:11.36,Default,,0,0,0,,Мен бұған жол бере алмаймын!
Dialogue: 0,0:01:11.44,0:01:14.49,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:01:17.53,0:01:19.78,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:01:22.12,0:01:23.41,Default,,0,0,0,,Nue!
Dialogue: 0,0:01:23.50,0:01:25.00,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:01:25.08,0:01:27.87,Default,,0,0,0,,Сен қалай өмірге келдің?
Dialogue: 0,0:01:29.42,0:01:31.38,Default,,0,0,0,,Рухтың қылышпен шабуылы!
Dialogue: 0,0:01:33.13,0:01:35.88,Default,,0,0,0,,О! Нуэ қылышқа айналады
Dialogue: 0,0:01:38.05,0:01:40.01,Default,,0,0,0,,Найзағай қылыш!
Dialogue: 0,0:01:46.48,0:01:48.19,Default,,0,0,0,,♪～
Dialogue: 0,0:03:13.90,0:03:15.90,Default,,0,0,0,,～♪
Dialogue: 0,0:03:16.86,0:03:18.86,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:03:22.45,0:03:26.83,Default,,0,0,0,,Осы континенттегі ең көне және ең сенімді ұрпақтары бар төрт корольдік отбасы
Dialogue: 0,0:03:27.41,0:03:32.25,Default,,0,0,0,,Зұлымдық пен қатыгез зұлымдық деп аталатын қара құрт құдайын жауып тастаған төрт мөр.
Dialogue: 0,0:03:32.33,0:03:34.79,Default,,0,0,0,,Әрқайсысына ескі дүние сеніп тапсырылған
Dialogue: 0,0:03:34.88,0:03:38.09,Default,,0,0,0,,Оны қорғау біздің міндетіміз болды.
Dialogue: 0,0:03:39.34,0:03:43.34,Default,,0,0,0,,Жоқ, керісінше мөрді қорғау міндеті
Dialogue: 0,0:03:43.43,0:03:46.47,Default,,0,0,0,,Ол патша отбасын құрды деп айтуға болады.
Dialogue: 0,0:03:47.18,0:03:51.81,Default,,0,0,0,,Бастапқыда патшалыққа жататын барлық мекемелер, соның ішінде рыцарьлар мен храмдар.
Dialogue: 0,0:03:52.52,0:03:56.44,Default,,0,0,0,,Бұл мөрді зұлымдықтан қорғау үшін бар.
Dialogue: 0,0:03:57.44,0:03:58.82,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:59.36,0:04:01.44,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:04:01.53,0:04:03.49,Default,,0,0,0,,Мен оны үнемі киетінмін.
Dialogue: 0,0:04:05.28,0:04:06.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:07.62,0:04:10.95,Default,,0,0,0,,Мм... бұл марқұм анамның естелігі.
Dialogue: 0,0:04:11.04,0:04:11.66,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:04:11.75,0:04:13.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:13.29,0:04:15.17,Default,,0,0,0,,О, солай емес пе?
Dialogue: 0,0:04:15.25,0:04:16.54,Default,,0,0,0,,Өйткені ол әрқашан негізгі нүктеде.
Dialogue: 0,0:04:16.63,0:04:19.00,Default,,0,0,0,,Сіз жай ғана қыбырлағансыз, солай емес пе?
Dialogue: 0,0:04:19.09,0:04:20.17,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:04:20.26,0:04:23.30,Default,,0,0,0,,Әй, бұл әдеті ғой.
Dialogue: 0,0:04:23.38,0:04:24.88,Default,,0,0,0,,Ей, көмектес! Оның алдыңғы тістерін жұлып ал—мен оларды тіс дәрігеріне апарамын!
Dialogue: 0,0:04:26.43,0:04:28.01,Default,,0,0,0,,Нағыз мөр
Dialogue: 0,0:04:28.10,0:04:31.06,Default,,0,0,0,,Оны табу қиынырақ жерде жасырылған.
Dialogue: 0,0:04:31.93,0:04:33.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:37.36,0:04:39.73,Default,,0,0,0,,Не? Мұндай жерге
Dialogue: 0,0:04:39.82,0:04:41.44,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:04:41.53,0:04:44.24,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:04:44.32,0:04:46.61,Default,,0,0,0,,Мөр ханшайымның...
Dialogue: 0,0:04:46.70,0:04:49.95,Default,,0,0,0,,Аа, мен мұндай нәрсе болады деп күткен емеспін...
Dialogue: 0,0:04:50.03,0:04:53.25,Default,,0,0,0,,Дүниенің тағдыры қанша қыл үстінде тұрса да
Dialogue: 0,0:04:53.33,0:04:55.25,Default,,0,0,0,,Бұл тым көп...
Dialogue: 0,0:04:57.25,0:04:58.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:01.75,0:05:03.30,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:05:31.16,0:05:33.66,Default,,0,0,0,,Мен саған ештеңе қарыз емеспін.
Dialogue: 0,0:05:34.25,0:05:35.62,Default,,0,0,0,,Сіз...
Dialogue: 0,0:05:35.71,0:05:39.38,Default,,0,0,0,,Сіз Ниндзя Фортына Йоко-сан үшін келген жоқсыз ба?
Dialogue: 0,0:05:40.29,0:05:42.34,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:05:42.42,0:05:45.38,Default,,0,0,0,,Жақсы, мен сені қорғаймын.
Dialogue: 0,0:05:45.47,0:05:47.30,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:05:48.34,0:05:49.39,Default,,0,0,0,,Иә
Dialogue: 0,0:05:56.73,0:05:58.06,Default,,0,0,0,,Дохи~
Dialogue: 0,0:05:58.14,0:05:59.10,Default,,0,0,0,,Агия
Dialogue: 0,0:06:01.15,0:06:02.36,Default,,0,0,0,,Жауап!
Dialogue: 0,0:06:02.90,0:06:06.03,Default,,0,0,0,,Егер жойылу Құдайын басқарудың жолы болмаса
Dialogue: 0,0:06:06.11,0:06:09.28,Default,,0,0,0,,Түпкі идеал қоғам, Сиқырлы Патшалық
Dialogue: 0,0:06:09.36,0:06:13.45,Default,,0,0,0,,Бұл бізге қарсы қастандық жасау үшін жасалған қиял-ғажайып сюжет пе еді, Абигейл?
Dialogue: 0,0:06:13.95,0:06:14.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:14.79,0:06:18.50,Default,,0,0,0,,Оны басқарудың жолы болса ше?
Dialogue: 0,0:06:18.58,0:06:21.96,Default,,0,0,0,,Біз артымыздан ергендерді ғана қалдыра аламыз, солай ма?
Dialogue: 0,0:06:22.88,0:06:25.84,Default,,0,0,0,,Жою құдайы Антрасаксты бақылау мүмкін емес пе?
Dialogue: 0,0:06:26.59,0:06:29.76,Default,,0,0,0,,Бұлай болса, дүние міндетті түрде жойылады.
Dialogue: 0,0:06:30.39,0:06:31.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:32.01,0:06:34.22,Default,,0,0,0,,Сонда Абигейл ше?
Dialogue: 0,0:06:34.31,0:06:37.35,Default,,0,0,0,,Неліктен сіз Жоюшы Құдайды қайта тірілтуге тырысасыз?
Dialogue: 0,0:06:38.48,0:06:40.52,Default,,0,0,0,,Кукукукук…
Dialogue: 0,0:06:40.60,0:06:43.90,Default,,0,0,0,,Күл Ней Құдай ашулы
Dialogue: 0,0:06:45.44,0:06:49.24,Default,,0,0,0,,Біздің Құдайдың мейірімділігі жоқ
Dialogue: 0,0:06:51.41,0:06:54.78,Default,,0,0,0,,Сіз Құдайдың жазасын алғыңыз келеді.
Dialogue: 0,0:07:01.33,0:07:02.25,Default,,0,0,0,,Гах!
Dialogue: 0,0:07:05.34,0:07:06.17,Default,,0,0,0,,Не?
Dialogue: 0,0:07:06.25,0:07:10.38,Default,,0,0,0,,~U~A~Оңға~ басыңыз
Dialogue: 0,0:07:10.47,0:07:15.30,Default,,0,0,0,,Та~о~эку~цу~
Dialogue: 0,0:07:15.39,0:07:22.15,Default,,0,0,0,,...
Dialogue: 0,0:07:22.23,0:07:26.94,Default,,0,0,0,,~U~A~Оңға~ басыңыз
Dialogue: 0,0:07:27.02,0:07:29.15,Default,,0,0,0,,Та~о~
Dialogue: 0,0:07:29.24,0:07:31.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:31.20,0:07:33.91,Default,,0,0,0,,Жын поштасы мен шайтан сойыл...
Dialogue: 0,0:07:33.99,0:07:36.91,Default,,0,0,0,,Үңгір ~ Жартас ~ Өріс ~
Dialogue: 0,0:07:36.99,0:07:39.25,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:07:39.33,0:07:40.75,Default,,0,0,0,,Сиқырлы құрал дегеніміз не?
Dialogue: 0,0:07:40.83,0:07:45.00,Default,,0,0,0,,Бастапқы қабілет үш машинаның бірігуі арқылы көрсетіледі.
Dialogue: 0,0:07:48.71,0:07:49.84,Default,,0,0,0,,(Үру)
Dialogue: 0,0:07:51.17,0:07:53.43,Default,,0,0,0,,Сиқырлы құрылғылардың үш түрі
Dialogue: 0,0:07:53.51,0:07:56.55,Default,,0,0,0,,Енді оны іске қосу уақыты келді.
Dialogue: 0,0:07:56.64,0:07:59.10,Default,,0,0,0,,Керемет сиқырлы пішін!
Dialogue: 0,0:08:04.23,0:08:07.40,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:08:07.48,0:08:09.82,Default,,0,0,0,,Ха~хахаха
Dialogue: 0,0:08:09.90,0:08:14.24,Default,,0,0,0,,Хя~хахаха...
Dialogue: 0,0:08:16.70,0:08:17.58,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:18.08,0:08:18.95,Default,,0,0,0,,Ni!
Dialogue: 0,0:08:19.04,0:08:22.33,Default,,0,0,0,,Ең керемет комбинация! Гигант Абигейл!
Dialogue: 0,0:08:25.88,0:08:27.75,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:08:27.84,0:08:29.80,Default,,0,0,0,,Біріктіру туралы не айтуға болады?
Dialogue: 0,0:08:29.88,0:08:32.34,Default,,0,0,0,,Ха~хахаха!
Dialogue: 0,0:08:32.42,0:08:35.47,Default,,0,0,0,,Жердің тамырын және адам рухын шексіз сіңіру.
Dialogue: 0,0:08:35.55,0:08:37.05,Default,,0,0,0,,Қараңғы үңгірді манипуляциялау
Dialogue: 0,0:08:37.14,0:08:39.85,Default,,0,0,0,,Және барлық сиқырды қайтарады
Dialogue: 0,0:08:39.93,0:08:42.52,Default,,0,0,0,,Оның үстіне, ол кез келген қылыштан да қиын!
Dialogue: 0,0:08:42.60,0:08:47.31,Default,,0,0,0,,Егер сіз осы Сиқыршы патшаның жазасына түссеңіз, міндетті түрде өлесіз!
Dialogue: 0,0:08:47.98,0:08:50.61,Default,,0,0,0,,Адамдар мұны құдайдың жазасы деп атайды!
Dialogue: 0,0:08:50.69,0:08:53.19,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:08:53.28,0:08:55.15,Default,,0,0,0,,Сіздің атыңыз жоқ!
Dialogue: 0,0:08:55.24,0:08:57.87,Default,,0,0,0,,Сәлем, Абигейл!
Dialogue: 0,0:08:57.95,0:09:03.70,Default,,0,0,0,,Онда! Құдайдың жазасы!
Dialogue: 0,0:09:05.75,0:09:07.04,Default,,0,0,0,,Кукукукукуку!
Dialogue: 0,0:09:07.12,0:09:08.46,Default,,0,0,0,,Өл, найзағай император!
Dialogue: 0,0:09:08.54,0:09:09.54,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:11.34,0:09:12.63,Default,,0,0,0,,Кя! Ұстап ал!
Dialogue: 0,0:09:12.71,0:09:15.76,Default,,0,0,0,,Абигейл Бастер!
Dialogue: 0,0:09:16.97,0:09:18.59,Default,,0,0,0,,Осыншама жылу...
Dialogue: 0,0:09:18.68,0:09:20.56,Default,,0,0,0,,Қашқаннан пайда жоқ!
Dialogue: 0,0:09:20.64,0:09:23.81,Default,,0,0,0,,Мені ренжіткеніңді түзе!
Dialogue: 0,0:09:26.39,0:09:27.19,Default,,0,0,0,,Қу!
Dialogue: 0,0:09:27.27,0:09:28.81,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:09:30.31,0:09:31.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:36.20,0:09:39.07,Default,,0,0,0,,Жоқ, бұл жерде найзағай құдайының қылышын пайдалана алмайсыз.
Dialogue: 0,0:09:39.16,0:09:42.03,Default,,0,0,0,,Егер сіз тиімдірек келісім нүктесіне ауыспасаңыз...
Dialogue: 0,0:09:42.12,0:09:43.58,Default,,0,0,0,,Қырылып қалсам да!
Dialogue: 0,0:09:43.66,0:09:44.45,Default,,0,0,0,,Қу!
Dialogue: 0,0:09:44.95,0:09:46.50,Default,,0,0,0,,Маған қашуға рұқсат етіңіз~
Dialogue: 0,0:09:46.58,0:09:50.33,Default,,0,0,0,,Ней, өл!
Dialogue: 0,0:09:50.42,0:09:54.55,Default,,0,0,0,,Абигейл Бим!
Dialogue: 0,0:09:55.34,0:09:55.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:56.01,0:09:57.17,Default,,0,0,0,,Мені ұстаңыз! Ұшайық!
Dialogue: 0,0:10:04.35,0:10:05.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:09.81,0:10:11.44,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:10:11.52,0:10:13.23,Default,,0,0,0,,Егер мен осылай тікелей соққы алсам...
Dialogue: 0,0:10:13.82,0:10:15.74,Default,,0,0,0,,Ней-сан, бұл да сиқыр ма?
Dialogue: 0,0:10:16.44,0:10:17.82,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:10:17.90,0:10:21.28,Default,,0,0,0,,Бірақ мен сиқырдан энергияның шоғырланғанын сезбедім.
Dialogue: 0,0:10:21.37,0:10:23.70,Default,,0,0,0,,Аруақтардың жұмыс істегенінің белгісі жоқ.
Dialogue: 0,0:10:24.20,0:10:27.54,Default,,0,0,0,,Бұл біз естіген ескі дүние сиқыры болуы мүмкін бе?
Dialogue: 0,0:10:31.63,0:10:33.00,Default,,0,0,0,,Nu...
Dialogue: 0,0:10:33.09,0:10:36.59,Default,,0,0,0,,Иә! Не болып жатыр?
Dialogue: 0,0:10:36.67,0:10:38.76,Default,,0,0,0,,Аспанда төрт патша болса да, бір ұры бар.
Dialogue: 0,0:10:38.84,0:10:40.22,Default,,0,0,0,,Сіз не істеуге уақыт бөліп жатырсыз?
Dialogue: 0,0:10:40.30,0:10:41.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:41.51,0:10:45.35,Default,,0,0,0,,Шындығында, Абигейл сиқырлы құрылғылардың үш түрімен біріктірілген.
Dialogue: 0,0:10:45.43,0:10:46.81,Default,,0,0,0,,Үлкен болып кеткен сияқты.
Dialogue: 0,0:10:46.89,0:10:48.52,Default,,0,0,0,,Не?
Dialogue: 0,0:10:49.27,0:10:50.23,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:10:50.31,0:10:52.23,Default,,0,0,0,,Бұндай жағдай болуы мүмкін емес...
Dialogue: 0,0:10:52.86,0:10:54.86,Default,,0,0,0,,Нуо... О!
Dialogue: 0,0:10:54.94,0:10:55.61,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:55.69,0:10:56.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:57.03,0:10:58.69,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:10:58.78,0:11:01.03,Default,,0,0,0,,Аби... Абигейл!
Dialogue: 0,0:11:02.20,0:11:03.53,Default,,0,0,0,,Хааах!
Dialogue: 0,0:11:05.66,0:11:07.66,Default,,0,0,0,,Нихехехе~
Dialogue: 0,0:11:07.75,0:11:10.83,Default,,0,0,0,,Маған қашып кетуге жол берме, Эшет Ней!
Dialogue: 0,0:11:30.98,0:11:32.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:32.52,0:11:33.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:33.94,0:11:35.36,Default,,0,0,0,,Құбыжық пайда болды!
Dialogue: 0,0:11:35.44,0:11:36.86,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:11:42.36,0:11:44.95,Default,,0,0,0,,Әй... құбыжықтың кеудесін қарашы!
Dialogue: 0,0:11:45.03,0:11:47.08,Default,,0,0,0,,Бұл ол, бұл Абигейл!
Dialogue: 0,0:11:47.16,0:11:48.08,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:11:48.62,0:11:51.29,Default,,0,0,0,,Сіз шынымен сиқырлы құрылғымен қосылдыңыз ба?
Dialogue: 0,0:11:51.37,0:11:52.87,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:11:52.96,0:11:55.88,Default,,0,0,0,,Атында шайтан бар сиқырлы қару
Dialogue: 0,0:11:55.96,0:11:57.92,Default,,0,0,0,,Тірі тіршілік иелері -
Dialogue: 0,0:11:58.00,0:12:01.13,Default,,0,0,0,,Тәнді де, жанды да жұтуы керек.
Dialogue: 0,0:12:01.22,0:12:03.01,Default,,0,0,0,,Не!
Dialogue: 0,0:12:03.09,0:12:06.72,Default,,0,0,0,,Олай болса, осы үш сиқырлы құрылғымен біріктірілген Абигейл туралы не деуге болады?
Dialogue: 0,0:12:06.80,0:12:10.68,Default,,0,0,0,,Ол кім, Бас діни қызметкер?
Dialogue: 0,0:12:11.77,0:12:16.11,Default,,0,0,0,,Бұл сиқырлы құрылғыны пайдалана алатын өлмейтін тіршілік иесі ме?
Dialogue: 0,0:12:16.61,0:12:20.15,Default,,0,0,0,,Яғни, тек қараңғыда туғандар
Dialogue: 0,0:12:20.69,0:12:21.78,Default,,0,0,0,,Қараңғылық…
Dialogue: 0,0:12:22.40,0:12:24.03,Default,,0,0,0,,Қараңғыда...
Dialogue: 0,0:12:24.11,0:12:26.16,Default,,0,0,0,,Хек...
Dialogue: 0,0:12:26.24,0:12:28.33,Default,,0,0,0,,Не болды? Сіз қазір қашып жатырсыз ба?
Dialogue: 0,0:12:28.41,0:12:31.91,Default,,0,0,0,,Ондай жағдайда мен саған тозақты көрсетемін!
Dialogue: 0,0:12:32.00,0:12:36.88,Default,,0,0,0,,Қандай жан түршігерлік жолдарды айтсам да, мен оны ешқашан жеңе алмаймын.
Dialogue: 0,0:12:36.96,0:12:38.71,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:12:40.42,0:12:41.30,Default,,0,0,0,,Demon Mail
Dialogue: 0,0:12:41.38,0:12:44.22,Default,,0,0,0,,Сиқырларды немесе қылышпен шабуылдарды қабылдамау
Dialogue: 0,0:12:44.30,0:12:46.55,Default,,0,0,0,,Линчинг кезінде дәлелденген
Dialogue: 0,0:12:46.64,0:12:49.10,Default,,0,0,0,,Найзағай соғуы, күтпеген жерден тырнақпен қиғаш соққы!
Dialogue: 0,0:12:49.72,0:12:51.18,Default,,0,0,0,,Эй, қарашы.
Dialogue: 0,0:12:52.27,0:12:52.93,Default,,0,0,0,,Не!
Dialogue: 0,0:12:53.02,0:12:54.10,Default,,0,0,0,,Не?
Dialogue: 0,0:12:55.14,0:12:57.31,Default,,0,0,0,,Бірақ ол тауларды да кесіп тастайды.
Dialogue: 0,0:12:57.40,0:13:00.27,Default,,0,0,0,,Маған ешқашан найзағай семсер тиген емес.
Dialogue: 0,0:13:00.36,0:13:02.86,Default,,0,0,0,,Ешбір қалқансыз осы күйде
Dialogue: 0,0:13:02.94,0:13:06.24,Default,,0,0,0,,Найзағай құдайының қылышы максималды жойқын күшке ие.
Dialogue: 0,0:13:06.32,0:13:09.16,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:13:11.66,0:13:14.46,Default,,0,0,0,,Өте баллистикалық найзағай қылыш!
Dialogue: 0,0:13:16.62,0:13:19.50,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:13:19.59,0:13:21.17,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:13:21.25,0:13:22.80,Default,,0,0,0,,Сен бейбақ!
Dialogue: 0,0:13:22.88,0:13:26.43,Default,,0,0,0,,Сібірдің күшімен әлемді жаулап аламыз.
Dialogue: 0,0:13:26.51,0:13:27.72,Default,,0,0,0,,Осы шатастырып алған дүниеде
Dialogue: 0,0:13:27.80,0:13:30.35,Default,,0,0,0,,Заң мен тәртіп орнату керек еді!
Dialogue: 0,0:13:30.43,0:13:33.64,Default,,0,0,0,,Дүниедегінің бәрін құртып не істейсің?
Dialogue: 0,0:13:33.72,0:13:36.39,Default,,0,0,0,,Сен тозақты көретін адамсың!
Dialogue: 0,0:13:37.98,0:13:39.98,Default,,0,0,0,,Өл, Абигейл!
Dialogue: 0,0:13:42.48,0:13:43.11,Default,,0,0,0,,Не?
Dialogue: 0,0:13:44.65,0:13:46.03,Default,,0,0,0,,Гаха!
Dialogue: 0,0:13:46.11,0:13:47.24,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:47.32,0:13:49.95,Default,,0,0,0,,Фухахаха!
Dialogue: 0,0:13:50.03,0:13:51.70,Default,,0,0,0,,Сен ақымақ~
Dialogue: 0,0:13:51.78,0:13:54.45,Default,,0,0,0,,Мен жаңа дүние жасадым деймін...
Dialogue: 0,0:13:54.54,0:13:58.62,Default,,0,0,0,,Сіз дөрекі нәрсені қалайтыныңызға шынымен сендіңіз бе?
Dialogue: 0,0:13:58.71,0:13:59.83,Default,,0,0,0,,Ммм
Dialogue: 0,0:13:59.92,0:14:01.67,Default,,0,0,0,,Сегізаяқ бесті!
Dialogue: 0,0:14:01.75,0:14:03.30,Default,,0,0,0,,Абигейл нені қалайды?
Dialogue: 0,0:14:03.38,0:14:06.09,Default,,0,0,0,,Жаратылыстан да асыл!
Dialogue: 0,0:14:06.76,0:14:08.59,Default,,0,0,0,,Фухахаха!
Dialogue: 0,0:14:08.68,0:14:10.39,Default,,0,0,0,,Бұл жойылу!
Dialogue: 0,0:14:10.47,0:14:12.68,Default,,0,0,0,,Толық жойылу!
Dialogue: 0,0:14:12.76,0:14:15.56,Default,,0,0,0,,Бұл дүниеде бәрін жойып, сарқыңыз!
Dialogue: 0,0:14:15.64,0:14:18.10,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл керемет емес пе?
Dialogue: 0,0:14:18.19,0:14:21.69,Default,,0,0,0,,Бүкіл тіршілік осы жерден алынады.
Dialogue: 0,0:14:21.77,0:14:25.36,Default,,0,0,0,,Барлық жаратылыс күлге айналады!
Dialogue: 0,0:14:25.44,0:14:26.40,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:14:26.49,0:14:31.37,Default,,0,0,0,,Ескі дүниенің жетімі, Сібірдің құртатын құдайы!
Dialogue: 0,0:14:32.24,0:14:33.87,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:14:33.95,0:14:38.21,Default,,0,0,0,,Бұл сақтық пен қорқынышты айлакер Дирк Шнайдерден айырмашылығы.
Dialogue: 0,0:14:38.29,0:14:42.33,Default,,0,0,0,,Сіз үшеуіңіз өте көп жұмыс істедіңіздер.
Dialogue: 0,0:14:42.42,0:14:46.59,Default,,0,0,0,,Сіздің арқаңызда мен тілегімді орындауға бір қадам жақындадым.
Dialogue: 0,0:14:46.67,0:14:50.30,Default,,0,0,0,,А... сен жындысың.
Dialogue: 0,0:14:50.38,0:14:52.01,Default,,0,0,0,,бұл... жоқ!
Dialogue: 0,0:14:52.55,0:14:54.89,Default,,0,0,0,,Менің өмір сүруімнің себебі осы
Dialogue: 0,0:14:54.97,0:14:58.77,Default,,0,0,0,,Бұл ескі дүниеден қалған асыл миссия!
Dialogue: 0,0:14:58.85,0:15:02.52,Default,,0,0,0,,Хмм... не? Сен кімсің...
Dialogue: 0,0:15:02.61,0:15:04.73,Default,,0,0,0,,Мұны білудің қажеті жоқ
Dialogue: 0,0:15:04.82,0:15:05.73,Default,,0,0,0,,Ішек
Dialogue: 0,0:15:05.82,0:15:08.40,Default,,0,0,0,,Ней, сен өлесің!
Dialogue: 0,0:15:08.49,0:15:11.28,Default,,0,0,0,,...
Dialogue: 0,0:15:11.36,0:15:13.57,Default,,0,0,0,,Жоқ! Бұл не сиқыр?
Dialogue: 0,0:15:13.66,0:15:16.95,Default,,0,0,0,,Мен адал қызметшіме бұйырамын
Dialogue: 0,0:15:17.04,0:15:19.33,Default,,0,0,0,,Иеміздің шақыруына жауап беріңіз
Dialogue: 0,0:15:19.87,0:15:23.71,Default,,0,0,0,,Колосс, оян, Морта Люси!
Dialogue: 0,0:15:25.13,0:15:27.88,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:30.17,0:15:32.64,Default,,0,0,0,,Бұл дыбыс...
Dialogue: 0,0:15:32.72,0:15:33.89,Default,,0,0,0,,Агия?
Dialogue: 0,0:15:40.52,0:15:41.31,Default,,0,0,0,,Иә
Dialogue: 0,0:15:41.39,0:15:42.65,Default,,0,0,0,,Дарш!
Dialogue: 0,0:15:42.73,0:15:43.77,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:15:43.85,0:15:45.48,Default,,0,0,0,,Сол кездегі голем?
Dialogue: 0,0:15:47.52,0:15:49.90,Default,,0,0,0,,О, Дирк Шнайдер!
Dialogue: 0,0:15:49.99,0:15:53.74,Default,,0,0,0,,О, голем қашан?
Dialogue: 0,0:15:53.82,0:15:57.08,Default,,0,0,0,,Түсіндім! У - бұл у, солай емес пе?
Dialogue: 0,0:15:57.16,0:16:02.62,Default,,0,0,0,,Бұл орын алған кезде, тіпті зұлым құбыжық қамқоршы құдай сияқты сенімді болады.
Dialogue: 0,0:16:02.71,0:16:04.04,Default,,0,0,0,,Сәлем, Абигейл!
Dialogue: 0,0:16:04.12,0:16:08.13,Default,,0,0,0,,Менің асыл қызыма сиқыңмен де, қолыңмен де тиіспе!
Dialogue: 0,0:16:08.21,0:16:09.05,Default,,0,0,0,,Өлтіремін!
Dialogue: 0,0:16:09.13,0:16:11.97,Default,,0,0,0,,Tsk tsk Дик сасып қалды ма?
Dialogue: 0,0:16:13.68,0:16:14.93,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:16:15.76,0:16:16.89,Default,,0,0,0,,Дарш…
Dialogue: 0,0:16:17.39,0:16:21.06,Default,,0,0,0,,Хе! Сіз қақпанға түсіп қалсаңыз да, мөрді қалайсыз ба?
Dialogue: 0,0:16:21.64,0:16:23.23,Default,,0,0,0,,Ол аянышты.
Dialogue: 0,0:16:23.31,0:16:25.06,Default,,0,0,0,,Nu...
Dialogue: 0,0:16:25.15,0:16:26.69,Default,,0,0,0,,Абайлаңыз Дарш!
Dialogue: 0,0:16:26.77,0:16:28.44,Default,,0,0,0,,Енді Абигейлде қылыш та, сиқыр да жоқ...
Dialogue: 0,0:16:28.52,0:16:29.69,Default,,0,0,0,,Үніңді жап, шошқа!
Dialogue: 0,0:16:30.23,0:16:31.65,Default,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:16:31.74,0:16:32.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:32.61,0:16:33.49,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:34.41,0:16:35.95,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:16:36.66,0:16:39.62,Default,,0,0,0,,Құлаған сенсің, Қараңғы Шнайдер!
Dialogue: 0,0:16:40.41,0:16:46.04,Default,,0,0,0,,Қараңғылық императоры, тозақтың мұрагер ханзадасы бір рет қараңғылықтың шегінде отырды.
Dialogue: 0,0:16:46.13,0:16:50.09,Default,,0,0,0,,Ол енді адамдарға және жақсылыққа жағымпазданатын екінші дәрежелі маймыл!
Dialogue: 0,0:16:50.96,0:16:52.42,Default,,0,0,0,,Абигейл
Dialogue: 0,0:16:52.97,0:16:54.17,Default,,0,0,0,,Кукукукукуку
Dialogue: 0,0:16:54.26,0:16:57.51,Default,,0,0,0,,Сен реинкарнацияда сәтсіздікке ұшырадың, бейшара бейбақ!
Dialogue: 0,0:16:57.59,0:16:59.22,Default,,0,0,0,,Теме...
Dialogue: 0,0:16:59.93,0:17:01.27,Default,,0,0,0,,Бізге ілесіп жүруді қойып, тезірек кетші!
Dialogue: 0,0:17:02.27,0:17:05.23,Default,,0,0,0,,О! Дирк Шнайдер орнатты~
Dialogue: 0,0:17:05.31,0:17:07.56,Default,,0,0,0,,Жүр, жүр! Оны құртайық!
Dialogue: 0,0:17:07.65,0:17:09.27,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:17:09.36,0:17:10.73,Default,,0,0,0,,Қу!
Dialogue: 0,0:17:10.82,0:17:12.36,Default,,0,0,0,,Күте тұрыңыз, Дирк Шнайдер!
Dialogue: 0,0:17:12.44,0:17:14.11,Default,,0,0,0,,Егер сіз оған абайсызда кірсеңіз, қауіпті болуы мүмкін!
Dialogue: 0,0:17:14.82,0:17:16.66,Default,,0,0,0,,Жоқ, Дарш!
Dialogue: 0,0:17:16.74,0:17:18.16,Default,,0,0,0,,Абигейл қазір...
Dialogue: 0,0:17:19.49,0:17:22.87,Default,,0,0,0,,Хе! Қорыққан сәтте сен
Dialogue: 0,0:17:22.95,0:17:26.71,Default,,0,0,0,,Өмір мен өлім арасындағы шекарадан секір!
Dialogue: 0,0:17:26.79,0:17:28.08,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:17:28.17,0:17:28.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:29.00,0:17:30.67,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:17:30.75,0:17:32.42,Default,,0,0,0,,Golem Punch!
Dialogue: 0,0:17:32.50,0:17:34.67,Default,,0,0,0,,Және теу!
Dialogue: 0,0:17:34.76,0:17:37.34,Default,,0,0,0,,Арх! Онда...
Dialogue: 0,0:17:38.84,0:17:41.18,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:17:41.26,0:17:44.14,Default,,0,0,0,,Nu~! Сіз...
Dialogue: 0,0:17:44.22,0:17:47.31,Default,,0,0,0,,Бұл біріктірілген сиқырлы патша, Омега Абигейл I...
Dialogue: 0,0:17:47.39,0:17:49.86,Default,,0,0,0,,Түпкілікті дененің жалғыз әлсіздігі
Dialogue: 0,0:17:49.94,0:17:53.82,Default,,0,0,0,,Бұл жалаңаш бет екенін қайдан білдің?
Dialogue: 0,0:17:53.90,0:17:55.07,Default,,0,0,0,,Иә
Dialogue: 0,0:17:55.74,0:17:56.70,Default,,0,0,0,,Теме...
Dialogue: 0,0:17:56.78,0:18:00.70,Default,,0,0,0,,Сіз бұл Дирк Шнайдердің данышпан екенін ұмыттыңыз ба?
Dialogue: 0,0:18:00.78,0:18:02.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:02.24,0:18:03.62,Default,,0,0,0,,Не!
Dialogue: 0,0:18:03.70,0:18:05.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:05.75,0:18:07.29,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:18:07.83,0:18:10.58,Default,,0,0,0,,Күтілгендей, бұл адам қауіпті.
Dialogue: 0,0:18:11.21,0:18:12.75,Default,,0,0,0,,Менің амбициям үшін
Dialogue: 0,0:18:12.84,0:18:16.17,Default,,0,0,0,,Мен оны шынымен де осында жоюым керек.
Dialogue: 0,0:18:16.26,0:18:17.80,Default,,0,0,0,,Бұл өте толық!
Dialogue: 0,0:18:19.30,0:18:22.68,Default,,0,0,0,,Менің асыл қызымды ренжіттіңіз...
Dialogue: 0,0:18:23.35,0:18:26.52,Default,,0,0,0,,Мен саған лайықты тозақты көрсетемін.
Dialogue: 0,0:18:26.60,0:18:28.73,Default,,0,0,0,,Дайын бол!
Dialogue: 0,0:18:28.81,0:18:30.69,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:18:30.77,0:18:33.32,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:18:33.40,0:18:34.57,Default,,0,0,0,,Міне! Міне бітті!
Dialogue: 0,0:18:34.65,0:18:37.95,Default,,0,0,0,,Сенің қазіргі әлсіздігің осы дейді!
Dialogue: 0,0:18:38.45,0:18:39.24,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:39.32,0:18:41.82,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:18:41.91,0:18:44.54,Default,,0,0,0,,Сіз мұнымен не істер едіңіз, Дирк Шнайдер?
Dialogue: 0,0:18:44.62,0:18:45.66,Default,,0,0,0,,Ней мырза!
Dialogue: 0,0:18:45.74,0:18:46.75,Default,,0,0,0,,Күл!
Dialogue: 0,0:18:47.25,0:18:48.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:48.58,0:18:49.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:50.00,0:18:52.50,Default,,0,0,0,,Хи хи хи хи!
Dialogue: 0,0:18:52.58,0:18:57.09,Default,,0,0,0,,Егер сіз 15 жыл бұрын болсаңыз, еш ойланбастан оған қарай бет алған болар едіңіз.
Dialogue: 0,0:18:57.17,0:19:01.59,Default,,0,0,0,,Ешбір заңмен немесе сезіммен шектелмеген таза зұлымдық!
Dialogue: 0,0:19:01.68,0:19:05.89,Default,,0,0,0,,Сені жынға айналдырған күш-қуаттың сыры осы еді!
Dialogue: 0,0:19:05.97,0:19:07.14,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:19:07.64,0:19:09.39,Default,,0,0,0,,Фухахаха!
Dialogue: 0,0:19:09.48,0:19:13.94,Default,,0,0,0,,Бірақ қазір бір ғана кішкентай қызды қалқан етіп алды. сіз қалай ойлайсыз?
Dialogue: 0,0:19:14.02,0:19:16.02,Default,,0,0,0,,Жақсылық деген осы.
Dialogue: 0,0:19:16.11,0:19:20.07,Default,,0,0,0,,Өте тәтті~ Тәтті, тәтті, тәтті, тәтті, тәтті!
Dialogue: 0,0:19:20.15,0:19:21.70,Default,,0,0,0,,Бар!
Dialogue: 0,0:19:21.78,0:19:23.78,Default,,0,0,0,,Қандай жексұрын адам!
Dialogue: 0,0:19:23.87,0:19:25.91,Default,,0,0,0,,Мен де Дирк Шнайдерді ұнатпаймын.
Dialogue: 0,0:19:25.99,0:19:28.04,Default,,0,0,0,,Ол одан да жаман.
Dialogue: 0,0:19:28.12,0:19:29.75,Default,,0,0,0,,Рыцарь ретінде мен мұны кешіре алмаймын!
Dialogue: 0,0:19:29.83,0:19:32.33,Default,,0,0,0,,Бірақ, сэр Джобина!
Dialogue: 0,0:19:32.42,0:19:35.71,Default,,0,0,0,,Егер ханым кепілде болса, мен сізге көмектесе алмаймын.
Dialogue: 0,0:19:36.25,0:19:37.34,Default,,0,0,0,,№~
Dialogue: 0,0:19:37.42,0:19:40.30,Default,,0,0,0,,Біраз уақыт сатып ал, ал әзірше...
Dialogue: 0,0:19:40.38,0:19:41.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:41.26,0:19:45.14,Default,,0,0,0,,Түсіндім, Абигейл!
Dialogue: 0,0:19:45.22,0:19:48.43,Default,,0,0,0,,Бұл менің жоғалтым.
Dialogue: 0,0:19:49.56,0:19:52.64,Default,,0,0,0,,...
Dialogue: 0,0:19:52.73,0:19:54.44,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,0:19:54.52,0:19:55.94,Default,,0,0,0,,Ухехехе!
Dialogue: 0,0:19:56.02,0:19:59.19,Default,,0,0,0,,Ей, Данна, дүниенің жойылуын қаласаң.
Dialogue: 0,0:19:59.28,0:20:01.90,Default,,0,0,0,,Мен сізге көмектесемін, мырза.
Dialogue: 0,0:20:01.99,0:20:05.37,Default,,0,0,0,,Маған қызметшідей қара!
Dialogue: 0,0:20:05.45,0:20:07.24,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:20:07.33,0:20:09.33,Default,,0,0,0,,Өтінемін, ол әйелді өлтірме.
Dialogue: 0,0:20:09.41,0:20:13.67,Default,,0,0,0,,Мен мұны өз өмірімнен де қымбат жалғыз қызыма беремін.
Dialogue: 0,0:20:13.75,0:20:15.79,Default,,0,0,0,,Күйеу~
Dialogue: 0,0:20:16.54,0:20:17.71,Default,,0,0,0,,Люс...
Dialogue: 0,0:20:19.09,0:20:20.13,Default,,0,0,0,,Дарш…
Dialogue: 0,0:20:20.80,0:20:22.97,Default,,0,0,0,,Э~хехехехе!
Dialogue: 0,0:20:23.05,0:20:24.72,Default,,0,0,0,,Бұл қызықты
Dialogue: 0,0:20:24.80,0:20:26.97,Default,,0,0,0,,Жарайды, Дирк Шнайдер.
Dialogue: 0,0:20:27.05,0:20:29.51,Default,,0,0,0,,Онда өл! Қазір өлейік
Dialogue: 0,0:20:29.60,0:20:32.73,Default,,0,0,0,,Егер солай болса, Ней сізге көмектесе алады.
Dialogue: 0,0:20:32.81,0:20:34.02,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:20:34.10,0:20:36.61,Default,,0,0,0,,Менің ханым ретінде!
Dialogue: 0,0:20:36.69,0:20:37.98,Default,,0,0,0,,Ха~хаха…
Dialogue: 0,0:20:38.07,0:20:39.61,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:20:41.53,0:20:43.65,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:20:43.74,0:20:46.82,Default,,0,0,0,,Ей, ақымақтар, мерекелеріңді өткізіп алмаңдар!
Dialogue: 0,0:20:47.53,0:20:48.41,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:52.04,0:20:53.91,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:20:54.00,0:20:55.58,Default,,0,0,0,,Сен мені алдадың.
Dialogue: 0,0:20:55.67,0:20:57.08,Default,,0,0,0,,Сіз алдап жатырсыз!
Dialogue: 0,0:20:57.17,0:20:58.59,Default,,0,0,0,,Шу!
Dialogue: 0,0:20:58.67,0:21:01.30,Default,,0,0,0,,Сіз мені әбден ашуландырдыңыз!
Dialogue: 0,0:21:01.38,0:21:03.30,Default,,0,0,0,,Дикіңізді шығарыңыз
Dialogue: 0,0:21:03.38,0:21:05.26,Default,,0,0,0,,Мен Ларсты тамақтандырамын!
Dialogue: 0,0:21:09.26,0:21:10.39,Default,,0,0,0,,Дарш!
Dialogue: 0,0:21:11.01,0:21:11.85,Default,,0,0,0,,Иә
Dialogue: 0,0:21:23.61,0:21:24.90,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:21:25.40,0:21:27.16,Default,,0,0,0,,Сіз бақытты екеніңізге сенімдімін.
Dialogue: 0,0:21:28.45,0:21:32.79,Default,,0,0,0,,Өйткені мен жақсы көретін адам мен үшін күресті.
Dialogue: 0,0:21:33.75,0:21:35.79,Default,,0,0,0,,Мен де аздап түсіндім.
Dialogue: 0,0:21:37.04,0:21:40.42,Default,,0,0,0,,Мен мұндай лучты бірінші рет көріп тұрмын.
Dialogue: 0,0:21:42.96,0:21:44.42,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:21:44.51,0:21:46.80,Default,,0,0,0,,Иә, өйткені менде сауыт болды...
Dialogue: 0,0:21:48.14,0:21:50.10,Default,,0,0,0,,Осы екеуінің арасында
Dialogue: 0,0:21:50.18,0:21:54.68,Default,,0,0,0,,Біздің байланысымыз соншалық, басқалар оны елестете де алмайды.
Dialogue: 0,0:21:55.27,0:21:56.77,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:21:56.85,0:22:00.15,Default,,0,0,0,,Ней мырза үшін Дирк Шнайдер есімді адам
Dialogue: 0,0:22:00.69,0:22:04.11,Default,,0,0,0,,Ол жай ғана әке емес.
Dialogue: 0,0:22:15.95,0:22:17.58,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:17.66,0:22:19.12,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:22:23.13,0:22:24.46,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.50,0:23:46.50,Default,,0,0,0,,～♪
