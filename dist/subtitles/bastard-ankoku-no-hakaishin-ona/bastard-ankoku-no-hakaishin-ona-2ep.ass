Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:12.09,0:00:14.18,Default,,0,0,0,,Сонымен Осборн жеңілді ме?
Dialogue: 0,0:00:14.76,0:00:16.80,Default,,0,0,0,,Өтірік айтпа~
Dialogue: 0,0:00:16.89,0:00:20.27,Default,,0,0,0,,200 жылдан астам өмір сүрген құбыжық дерлік.
Dialogue: 0,0:00:20.35,0:00:22.06,Default,,0,0,0,,Бұл Осборн?
Dialogue: 0,0:00:22.68,0:00:24.81,Default,,0,0,0,,Алайда, хабарланғандай
Dialogue: 0,0:00:24.89,0:00:28.94,Default,,0,0,0,,Осборнды жеңген кастер Бенонды пайдаланды...
Dialogue: 0,0:00:29.02,0:00:32.94,Default,,0,0,0,,Не! Бенон ше? ақымақ
Dialogue: 0,0:00:33.03,0:00:36.49,Default,,0,0,0,,Бұл әлемде Бенонның сиқырын қолдана алатын бір ғана адам бар.
Dialogue: 0,0:00:36.57,0:00:40.12,Default,,0,0,0,,Бірақ 15 жыл бұрын сол күні...
Dialogue: 0,0:00:40.91,0:00:42.33,Default,,0,0,0,,Дарш…
Dialogue: 0,0:00:43.87,0:00:48.75,Default,,0,0,0,,Бенон көмегімен құйғыштың сәйкестігін растау қажет.
Dialogue: 0,0:00:48.84,0:00:53.21,Default,,0,0,0,,Олай болса, Кебидабіні неге жібермеске?
Dialogue: 0,0:00:53.30,0:00:57.18,Default,,0,0,0,,Гидраны қолданған дұрыс емес пе?
Dialogue: 0,0:00:57.26,0:01:01.26,Default,,0,0,0,,Якко-сан жеңілсе, құюшы нағыз.
Dialogue: 0,0:01:01.35,0:01:03.60,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:01:03.68,0:01:05.23,Default,,0,0,0,,Негізгі күшпен шабуыл
Dialogue: 0,0:01:05.31,0:01:12.19,Default,,0,0,0,,Қараңғы көтерілісші әскеріміздің алға жылжуына кедергі болатынның бәрі жойылады.
Dialogue: 0,0:01:12.90,0:01:16.74,Default,,0,0,0,,Осы Яһуда патшалығы сияқты
Dialogue: 0,0:01:20.45,0:01:22.16,Default,,0,0,0,,♪～
Dialogue: 0,0:02:47.16,0:02:49.16,Default,,0,0,0,,～♪
Dialogue: 0,0:02:51.12,0:02:54.67,Default,,0,0,0,,Йоко-сан... Йоко-сан!
Dialogue: 0,0:02:54.75,0:02:56.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:59.92,0:03:01.43,Default,,0,0,0,,Йоко-сан...
Dialogue: 0,0:03:04.85,0:03:07.47,Default,,0,0,0,,...
Dialogue: 0,0:03:07.56,0:03:11.23,Default,,0,0,0,,Сіз...сіз! Сіз мөрді қалай бұздыңыз?
Dialogue: 0,0:03:11.31,0:03:13.94,Default,,0,0,0,,Ал сен неге үнемі жалаңашсың?
Dialogue: 0,0:03:14.73,0:03:17.86,Default,,0,0,0,,Жақсы, болды.
Dialogue: 0,0:03:19.15,0:03:23.03,Default,,0,0,0,,А... а... бұл арман... бұл...
Dialogue: 0,0:03:23.11,0:03:25.62,Default,,0,0,0,,Түсімде кездесіп жатырмыз, солай ма?
Dialogue: 0,0:03:26.28,0:03:29.25,Default,,0,0,0,,Жоқ, қараңыз.
Dialogue: 0,0:03:29.83,0:03:32.12,Default,,0,0,0,,Мен бас діни қызметкерді өлтірдім...
Dialogue: 0,0:03:32.21,0:03:33.21,Default,,0,0,0,,Әке!
Dialogue: 0,0:03:33.29,0:03:37.84,Default,,0,0,0,,Жаман құбыжықтар өте көп!
Dialogue: 0,0:03:38.71,0:03:42.01,Default,,0,0,0,,Сүйкімді емес пе, Йоко-сан?
Dialogue: 0,0:03:42.09,0:03:42.72,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:03:42.80,0:03:44.93,Default,,0,0,0,,Йоко-сан?
Dialogue: 0,0:03:45.01,0:03:49.18,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:53.44,0:03:55.56,Default,,0,0,0,,Юму…
Dialogue: 0,0:03:56.23,0:03:58.57,Default,,0,0,0,,Әй, Люси!
Dialogue: 0,0:04:00.03,0:04:03.07,Default,,0,0,0,,Қазірдің өзінде! Мен бұл жігітке ештеңе істей алмаймын.
Dialogue: 0,0:04:03.15,0:04:06.95,Default,,0,0,0,,Жоқ десем де, жастықпен тағы келдің...
Dialogue: 0,0:04:07.62,0:04:10.20,Default,,0,0,0,,Біртүрлі түс көрдім сен кінәлісің...
Dialogue: 0,0:04:10.29,0:04:11.41,Default,,0,0,0,,Уф
Dialogue: 0,0:04:11.50,0:04:12.54,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:04:13.83,0:04:18.21,Default,,0,0,0,,Иә! Иә, иә! (Люс) Ух
Dialogue: 0,0:04:18.29,0:04:23.13,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:04:23.22,0:04:26.43,Default,,0,0,0,,Бұл — «mercy rule» (рақымшылдық ережесі) бойынша ойын сол сәтте тоқтатылатынын ұмытпа
Dialogue: 0,0:04:35.27,0:04:37.73,Default,,0,0,0,,Люс-кун, бұл тамақ!
Dialogue: 0,0:04:37.81,0:04:39.11,Default,,0,0,0,,Уа!
Dialogue: 0,0:04:40.02,0:04:41.82,Default,,0,0,0,,Люс, жақсылап шайнаңыз.
Dialogue: 0,0:04:43.44,0:04:45.49,Default,,0,0,0,,Қараңызшы, сіз дұрыс шайнамайсыз!
Dialogue: 0,0:04:45.57,0:04:49.37,Default,,0,0,0,,Тамағын дұрыс шайнамаған балалардың тістері мен жақтары әлсіз болады.
Dialogue: 0,0:04:49.45,0:04:51.41,Default,,0,0,0,,Тіпті сіздің басыңыз да жақсармайды.
Dialogue: 0,0:04:51.95,0:04:53.37,Default,,0,0,0,,Күрішпен бірге келеді
Dialogue: 0,0:04:53.45,0:04:54.37,Default,,0,0,0,,Ммм
Dialogue: 0,0:04:54.46,0:04:57.79,Default,,0,0,0,,Бұл балабақша...
Dialogue: 0,0:04:57.88,0:05:00.46,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:05:01.00,0:05:03.72,Default,,0,0,0,,Ех! Бұл...
Dialogue: 0,0:05:04.26,0:05:06.47,Default,,0,0,0,,Уау, біртүрлі бұлттар
Dialogue: 0,0:05:06.55,0:05:08.30,Default,,0,0,0,,Иуда сарайы бағытында.
Dialogue: 0,0:05:09.05,0:05:13.02,Default,,0,0,0,,Қызық... Менде қатты жаман сезім бар.
Dialogue: 0,0:05:13.10,0:05:15.31,Default,,0,0,0,,Йоко Люс!
Dialogue: 0,0:05:15.39,0:05:18.02,Default,,0,0,0,,Әке! Бұл не деген қара бұлт?
Dialogue: 0,0:05:18.10,0:05:20.82,Default,,0,0,0,,Ұлы Діни Бұлт! Бұл біртүрлі!
Dialogue: 0,0:05:20.90,0:05:23.23,Default,,0,0,0,,Хмм, бұл жаман белгі.
Dialogue: 0,0:05:23.32,0:05:25.53,Default,,0,0,0,,Мен патша сарайына барамын
Dialogue: 0,0:05:26.03,0:05:27.86,Default,,0,0,0,,Екеуің бірге келесіңдер.
Dialogue: 0,0:05:27.95,0:05:30.45,Default,,0,0,0,,Иә Әке (Люс) Иә!
Dialogue: 0,0:05:31.08,0:05:32.66,Default,,0,0,0,,Ең нашар жағдай сценарийі…
Dialogue: 0,0:05:33.33,0:05:36.25,Default,,0,0,0,,Бұл сізді қайтадан оятуы мүмкін.
Dialogue: 0,0:05:39.58,0:05:41.34,Default,,0,0,0,,Бұл не бұлт?
Dialogue: 0,0:05:42.13,0:05:43.67,Default,,0,0,0,,Маған қарай келе жатыр.
Dialogue: 0,0:05:43.76,0:05:45.76,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:05:46.30,0:05:50.09,Default,,0,0,0,,Сіз Яһуда сарайы құлады дейсіз бе?
Dialogue: 0,0:05:50.18,0:05:53.26,Default,,0,0,0,,Ха, жаудың әскері көп...
Dialogue: 0,0:05:53.35,0:05:55.77,Default,,0,0,0,,Деми-адамдар мен құбыжықтардан тұрады.
Dialogue: 0,0:05:55.85,0:05:59.65,Default,,0,0,0,,Сонымен қатар, оған сиқыршының күшті сиқыры шабуыл жасады.
Dialogue: 0,0:05:59.73,0:06:01.65,Default,,0,0,0,,Менің патшам енді жоқ...
Dialogue: 0,0:06:01.73,0:06:04.03,Default,,0,0,0,,Яһудадан патша Гленн!
Dialogue: 0,0:06:04.11,0:06:05.61,Default,,0,0,0,,Не болды!
Dialogue: 0,0:06:05.69,0:06:09.41,Default,,0,0,0,,Оның үстіне, менің Яһудамды басып алған әскердің бір бөлігі
Dialogue: 0,0:06:09.49,0:06:12.45,Default,,0,0,0,,Біз сіздің еліңізге қарай жүреміз, Металликана.
Dialogue: 0,0:06:13.03,0:06:15.70,Default,,0,0,0,,Патша! Бұл ауыр дағдарыс.
Dialogue: 0,0:06:15.79,0:06:19.54,Default,,0,0,0,,Жау жын болса, кідіріс болмайды.
Dialogue: 0,0:06:19.62,0:06:23.88,Default,,0,0,0,,Сол қара бұлт зұлым сиқырдың әсерінен пайда болды дейсің бе?
Dialogue: 0,0:06:24.50,0:06:28.93,Default,,0,0,0,,Сол жақ мырза! Бұл қара бұлт табиғи болуы мүмкін емес.
Dialogue: 0,0:06:29.01,0:06:32.26,Default,,0,0,0,,Гео ескертпе сұрыптау Келгеніңізге рахмет.
Dialogue: 0,0:06:32.89,0:06:36.77,Default,,0,0,0,,Бұл Құрметті Ескертпе Йоко, Король, Шейла ханшайым.
Dialogue: 0,0:06:36.85,0:06:40.27,Default,,0,0,0,,О! Олар мен алдыңғы экспедициядан алыста жүргенде шабуыл жасады.
Dialogue: 0,0:06:40.35,0:06:43.73,Default,,0,0,0,,Жаман сиқырды жеңген әйел!
Dialogue: 0,0:06:43.82,0:06:46.48,Default,,0,0,0,,Жарайсың, және...
Dialogue: 0,0:06:46.57,0:06:47.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:47.74,0:06:49.28,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:06:49.36,0:06:52.12,Default,,0,0,0,,Хм... Ле Руш Уау!
Dialogue: 0,0:06:52.20,0:06:53.91,Default,,0,0,0,,Бұл Люси Ленглен.
Dialogue: 0,0:06:54.58,0:06:57.79,Default,,0,0,0,,Сол кезде бізді құтқарғаныңыз үшін рахмет.
Dialogue: 0,0:06:58.50,0:07:00.12,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:07:01.29,0:07:02.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:02.67,0:07:04.59,Default,,0,0,0,,Жоқ, Шейла...
Dialogue: 0,0:07:04.67,0:07:07.84,Default,,0,0,0,,Бұл бала сол кез туралы ештеңе есіне түсірмейді.
Dialogue: 0,0:07:07.92,0:07:08.88,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:07:09.38,0:07:13.39,Default,,0,0,0,,Бұл баланың аңызға айналған сиқыршысы бар...
Dialogue: 0,0:07:14.47,0:07:17.47,Default,,0,0,0,,Баршаңызға, мәселе шұғыл.
Dialogue: 0,0:07:17.97,0:07:22.69,Default,,0,0,0,,Соңғы айларда Metallicana жақын маңдағы үңгірлерде, ормандарда, сулы-батпақты жерлерде және т.б.
Dialogue: 0,0:07:22.77,0:07:26.44,Default,,0,0,0,,Құбыжық пен адамның деми белсенділігі артып келеді
Dialogue: 0,0:07:26.52,0:07:32.20,Default,,0,0,0,,Мұның бәрі қараңғылықтан зұлымдық тербелістерінің күшеюіне байланысты.
Dialogue: 0,0:07:32.28,0:07:36.91,Default,,0,0,0,,Сонда кенеттен қара бүлікші әскер пайда болып, көрші елді талқандады.
Dialogue: 0,0:07:36.99,0:07:39.16,Default,,0,0,0,,Табиғаттан тыс қара бұлт!
Dialogue: 0,0:07:40.04,0:07:41.25,Default,,0,0,0,,Мүмкін бұл...
Dialogue: 0,0:07:42.21,0:07:46.59,Default,,0,0,0,,Біртүрлі зұлым құдай Антрасакс қайта тірілудің белгісі болуы мүмкін.
Dialogue: 0,0:07:46.67,0:07:49.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:49.13,0:07:52.34,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:07:52.43,0:07:54.97,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:07:55.05,0:07:59.06,Default,,0,0,0,,Осборнды жерлегенін қанша құймашы айтады?
Dialogue: 0,0:07:59.14,0:08:02.44,Default,,0,0,0,,Осы Кебидабу-сама мұны көреді.
Dialogue: 0,0:08:02.52,0:08:04.40,Default,,0,0,0,,Жүр, Гидра!
Dialogue: 0,0:08:04.48,0:08:08.02,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:08:08.11,0:08:10.28,Default,,0,0,0,,Сізге алғысымды білдіргім келеді!
Dialogue: 0,0:08:10.36,0:08:14.74,Default,,0,0,0,,Гидра шығыс қақпа арқылы басып кірді! Жалын түкіру және жабайы болу
Dialogue: 0,0:08:14.82,0:08:16.82,Default,,0,0,0,,Марж?
Dialogue: 0,0:08:17.66,0:08:19.04,Default,,0,0,0,,Гидра…
Dialogue: 0,0:08:19.12,0:08:23.50,Default,,0,0,0,,Мұндай құбыжықтың адамдар қалашығына өздігінен келуі мүмкін емес.
Dialogue: 0,0:08:24.67,0:08:27.59,Default,,0,0,0,,Күшті сиқыршымен келетін шығар.
Dialogue: 0,0:08:28.13,0:08:30.46,Default,,0,0,0,,Гидраға қарсы тұру үшін...
Dialogue: 0,0:08:31.09,0:08:34.43,Default,,0,0,0,,Әйтеуір, менде қатты жаман сезім бар.
Dialogue: 0,0:08:35.34,0:08:37.26,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:08:37.35,0:08:40.97,Default,,0,0,0,,Бұл Дарк Шнайдерді өмірге қайтарудың жалғыз жолы!
Dialogue: 0,0:08:41.06,0:08:44.98,Default,,0,0,0,,Дұрыс! Бұл адамның сиқыры құбыжықтарды тойтарыс бере алады.
Dialogue: 0,0:08:45.06,0:08:46.19,Default,,0,0,0,,Мұның бәрі бар
Dialogue: 0,0:08:46.27,0:08:48.31,Default,,0,0,0,,Уау, мен мұны білдім!
Dialogue: 0,0:08:48.40,0:08:51.28,Default,,0,0,0,,Йоко-доно, өтінемін!
Dialogue: 0,0:08:51.36,0:08:54.28,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:08:54.36,0:08:58.28,Default,,0,0,0,,Сондай зұлым, жауыз, мейірімсіз, арам...
Dialogue: 0,0:08:58.37,0:08:59.99,Default,,0,0,0,,Маған ұнамайды, бәрібір!
Dialogue: 0,0:09:00.49,0:09:03.66,Default,,0,0,0,,Йоко... Дирк Шнайдерге бәс тігейік
Dialogue: 0,0:09:03.75,0:09:04.50,Default,,0,0,0,,Эх!
Dialogue: 0,0:09:05.29,0:09:10.29,Default,,0,0,0,,Діни қызметкерлерде кездесетін көптеген сиқырлар қорғаныс және емдік сиқырлар.
Dialogue: 0,0:09:10.38,0:09:13.55,Default,,0,0,0,,Сиқырлы адамдар мен құбыжықтарды қалай жеңуге болады
Dialogue: 0,0:09:13.63,0:09:16.47,Default,,0,0,0,,Сізге сиқыршы шабуылының сиқыры қажет.
Dialogue: 0,0:09:16.55,0:09:17.89,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:17.97,0:09:21.10,Default,,0,0,0,,Сонда маған не болады? Менің тазалығым ше?
Dialogue: 0,0:09:21.72,0:09:23.60,Default,,0,0,0,,Жарайды, жай ғана сүйісу.
Dialogue: 0,0:09:23.68,0:09:26.39,Default,,0,0,0,,Өз қызыңа айтасың ба?
Dialogue: 0,0:09:26.48,0:09:27.56,Default,,0,0,0,,Мұндай шалқып жатқан шөлде мотоцикліммен келе жатқанда —
Dialogue: 0,0:09:27.65,0:09:28.65,Default,,0,0,0,,О...!
Dialogue: 0,0:09:28.73,0:09:31.48,Default,,0,0,0,,Ухахаха! Саған не болды?
Dialogue: 0,0:09:31.57,0:09:34.69,Default,,0,0,0,,Мен бүкіл қаланы қиратамын, иә?
Dialogue: 0,0:09:34.78,0:09:36.82,Default,,0,0,0,,Шық, патшалықтың сиқыршысы!
Dialogue: 0,0:09:36.90,0:09:38.95,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:09:39.03,0:09:41.08,Default,,0,0,0,,күрсіну~ Му, жоқ~
Dialogue: 0,0:09:41.16,0:09:43.16,Default,,0,0,0,,Сәлем, өтінемін!
Dialogue: 0,0:09:45.00,0:09:48.12,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:48.96,0:09:49.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:51.29,0:09:55.42,Default,,0,0,0,,Басқа таңдау жоқ, солай ма?
Dialogue: 0,0:09:55.51,0:09:57.51,Default,,0,0,0,,Йоко-сан, сенің бетің қызарып кетті ме?
Dialogue: 0,0:09:57.59,0:10:01.55,Default,,0,0,0,,Шулы! Заклинание көп шоғырлануды қажет етеді.
Dialogue: 0,0:10:01.64,0:10:04.10,Default,,0,0,0,,Тыныш болыңыз және тыныш отырыңыз!
Dialogue: 0,0:10:04.18,0:10:05.56,Default,,0,0,0,,Иә
Dialogue: 0,0:10:07.85,0:10:11.19,Default,,0,0,0,,Мм... өтінемін, Люс-кун...
Dialogue: 0,0:10:11.27,0:10:13.94,Default,,0,0,0,,Көзіңізді жабыңыз
Dialogue: 0,0:10:14.03,0:10:15.82,Default,,0,0,0,,Эй... өтінемін
Dialogue: 0,0:10:15.90,0:10:18.03,Default,,0,0,0,,Иә
Dialogue: 0,0:10:19.95,0:10:21.16,Default,,0,0,0,,Қабылдау…
Dialogue: 0,0:10:21.99,0:10:26.25,Default,,0,0,0,,Сұлулықтың сүйікті құдайы Эно Матаның атымен
Dialogue: 0,0:10:26.33,0:10:30.29,Default,,0,0,0,,А... Мөр, шегін...
Dialogue: 0,0:10:32.67,0:10:34.55,Default,,0,0,0,,О!
Dialogue: 0,0:10:39.97,0:10:44.39,Default,,0,0,0,,Жаңғыру! Нухахаха!
Dialogue: 0,0:10:44.47,0:10:45.85,Default,,0,0,0,,О~
Dialogue: 0,0:10:45.93,0:10:49.10,Default,,0,0,0,,Бұл аңызға айналған шебер...
Dialogue: 0,0:10:49.19,0:10:49.94,Default,,0,0,0,,Иә
Dialogue: 0,0:10:50.77,0:10:52.90,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:10:54.19,0:10:55.61,Default,,0,0,0,,Люс...
Dialogue: 0,0:10:58.40,0:11:01.20,Default,,0,0,0,,Дирк Шнайдер Жақсы жұмыс, қайтып келдіңіз!
Dialogue: 0,0:11:01.28,0:11:04.28,Default,,0,0,0,,Тыңдаңдар, біз қазір дағдарыста тұрмыз.
Dialogue: 0,0:11:04.37,0:11:06.41,Default,,0,0,0,,Қалаған сыйлықты беремін!
Dialogue: 0,0:11:06.49,0:11:10.62,Default,,0,0,0,,Енді жауды тез жеңу үшін сиқырлы күшіңізді пайдаланыңыз! Бар!
Dialogue: 0,0:11:11.21,0:11:12.63,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:11:12.71,0:11:14.34,Default,,0,0,0,,Не?
Dialogue: 0,0:11:14.42,0:11:17.05,Default,,0,0,0,,Бұл қауіпті! Мен мұны істеуім керек еді
Dialogue: 0,0:11:17.13,0:11:21.51,Default,,0,0,0,,Бұл бұрынғыдан да қорқынышты.
Dialogue: 0,0:11:21.59,0:11:24.85,Default,,0,0,0,,Құрметті сіз! Біз осы патшалықтың министрлеріміз!
Dialogue: 0,0:11:24.93,0:11:26.85,Default,,0,0,0,,Сіз мені естімейсіз бе? Эй!
Dialogue: 0,0:11:26.93,0:11:28.39,Default,,0,0,0,,Бұл сұмдық!
Dialogue: 0,0:11:28.47,0:11:31.89,Default,,0,0,0,,Қандай үміт! Ол маған бәрін беремін дейді.
Dialogue: 0,0:11:31.98,0:11:34.19,Default,,0,0,0,,Қарттар, мұқият тыңдаңдар!
Dialogue: 0,0:11:34.27,0:11:35.94,Default,,0,0,0,,Менің қалағаным-
Dialogue: 0,0:11:36.02,0:11:39.40,Default,,0,0,0,,Бүкіл әлемнің билеушісі бол!
Dialogue: 0,0:11:39.49,0:11:41.11,Default,,0,0,0,,Уа!
Dialogue: 0,0:11:41.20,0:11:42.45,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:11:42.53,0:11:45.95,Default,,0,0,0,,Және Бас діни қызметкер
Dialogue: 0,0:11:46.03,0:11:48.62,Default,,0,0,0,,Сіз жұмыстан босатылдыңыз~
Dialogue: 0,0:11:48.70,0:11:50.00,Default,,0,0,0,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:11:51.79,0:11:54.42,Default,,0,0,0,,Мен...Мен оны ұстағым келмейді!
Dialogue: 0,0:11:54.50,0:11:55.50,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:57.25,0:11:58.88,Default,,0,0,0,,Гунзунро!
Dialogue: 0,0:11:58.96,0:12:01.34,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:12:01.42,0:12:04.80,Default,,0,0,0,,Король Шейла-сама... бұл қауіпті, осы жаққа кел!
Dialogue: 0,0:12:04.89,0:12:06.55,Default,,0,0,0,,Мм.
Dialogue: 0,0:12:07.35,0:12:09.14,Default,,0,0,0,,Гео ескертпе сұрыптау!
Dialogue: 0,0:12:09.68,0:12:11.10,Default,,0,0,0,,15 жыл бұрын -
Dialogue: 0,0:12:11.18,0:12:16.11,Default,,0,0,0,,Дүние үстемдігінің алдында тұрған мені жеңген бес адамның бірі
Dialogue: 0,0:12:16.19,0:12:21.07,Default,,0,0,0,,Менің реинкарнацияланған болмысымды құпия әдістермен жауып тастаған діни қызметкер.
Dialogue: 0,0:12:21.61,0:12:23.61,Default,,0,0,0,,Ақыры сені кездестірдім.
Dialogue: 0,0:12:23.70,0:12:28.53,Default,,0,0,0,,Өткен өмірімдегі қарызымды өтеуге рұқсат етіңіз! Фухаха...
Dialogue: 0,0:12:29.45,0:12:33.25,Default,,0,0,0,,15 жыл болды, Дирк Шнайдер
Dialogue: 0,0:12:33.75,0:12:38.13,Default,,0,0,0,,Сіз біршама қартадыңыз. Бұл дүниеде еш өкінбейсің бе?
Dialogue: 0,0:12:38.96,0:12:42.26,Default,,0,0,0,,Мен сізге бағыт-бағдар беремін!
Dialogue: 0,0:12:42.34,0:12:45.72,Default,,0,0,0,,Бұл не зұлым рух?
Dialogue: 0,0:12:46.26,0:12:47.43,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:12:47.51,0:12:51.68,Default,,0,0,0,,О! Гидраны сиқырлы күштеріңізбен бұлай қорқыта аласыз деп ойламадым...
Dialogue: 0,0:12:53.10,0:12:55.39,Default,,0,0,0,,Қарастырылып отырған кастер болуы мүмкін.
Dialogue: 0,0:12:56.15,0:12:58.06,Default,,0,0,0,,Сіз сарайға бардыңыз ба?
Dialogue: 0,0:12:58.15,0:13:01.57,Default,,0,0,0,,Хехе... Мен таптым.
Dialogue: 0,0:13:01.65,0:13:05.15,Default,,0,0,0,,Алға, Гео!
Dialogue: 0,0:13:05.24,0:13:06.16,Default,,0,0,0,,Сәлем Люс!
Dialogue: 0,0:13:06.24,0:13:07.66,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:07.74,0:13:09.99,Default,,0,0,0,,Мен бұған жол бермеймін!
Dialogue: 0,0:13:10.08,0:13:11.12,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:13:11.20,0:13:13.62,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:13:13.70,0:13:15.41,Default,,0,0,0,,Менің айтқанымды естімей тұрсың ба?
Dialogue: 0,0:13:15.50,0:13:18.83,Default,,0,0,0,,Жоқ! Осы жолы маған қайта-қайта көмектесесіз бе?
Dialogue: 0,0:13:18.92,0:13:21.05,Default,,0,0,0,,Әзіл емес, иә!
Dialogue: 0,0:13:21.13,0:13:22.92,Default,,0,0,0,,Не! (Дирк Шнайдер) Ах
Dialogue: 0,0:13:23.01,0:13:24.30,Default,,0,0,0,,Не болды!
Dialogue: 0,0:13:24.38,0:13:28.09,Default,,0,0,0,,Йоко-сан, мені тыңдау үшін тағы да зорлық-зомбылық жасамақшысың ба?
Dialogue: 0,0:13:28.18,0:13:32.26,Default,,0,0,0,,Сәлем! Сізге айтамын, мұндай қадам маған енді ешқашан әсер етпейді.
Dialogue: 0,0:13:32.35,0:13:37.44,Default,,0,0,0,,Бірінші: Өткен күнгі аласапыранмен мен сізге қарызымды толық өтедім.
Dialogue: 0,0:13:37.94,0:13:42.73,Default,,0,0,0,,Дүниені бағындыруға алғашқы қадам ретінде, Әкеңнің қанын құрбан етемін!
Dialogue: 0,0:13:42.82,0:13:44.32,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:13:44.40,0:13:45.07,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:45.15,0:13:45.69,Default,,0,0,0,,Хуха!
Dialogue: 0,0:13:45.78,0:13:46.70,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:13:46.78,0:13:49.87,Default,,0,0,0,,Мен сені бұлай тәртіпке салғаным есімде жоқ!
Dialogue: 0,0:13:50.66,0:13:53.08,Default,,0,0,0,,Кешіріңіз... Иә?
Dialogue: 0,0:13:53.16,0:13:56.21,Default,,0,0,0,,Сондықтан бұл қозғалыс маған әсер етпейді.
Dialogue: 0,0:13:56.29,0:14:01.17,Default,,0,0,0,,Ол кісі менің жауым! Мен оны ешқашан тірі қалдыра алмаймын
Dialogue: 0,0:14:01.25,0:14:02.13,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:04.13,0:14:05.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:05.59,0:14:10.72,Default,,0,0,0,,Өлген өлтірілген Балмор Қараңғылықтың күркіреуі!
Dialogue: 0,0:14:10.80,0:14:12.35,Default,,0,0,0,,Заклинание...
Dialogue: 0,0:14:12.43,0:14:14.06,Default,,0,0,0,,Найзағай сиқыры
Dialogue: 0,0:14:14.14,0:14:17.23,Default,,0,0,0,,Вахахаха! Өлең қария!
Dialogue: 0,0:14:17.31,0:14:18.85,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:14:18.94,0:14:20.81,Default,,0,0,0,,Элеле Наммейрин!
Dialogue: 0,0:14:20.90,0:14:23.52,Default,,0,0,0,,Киелі Рух, менің қалқаным бол
Dialogue: 0,0:14:23.61,0:14:24.73,Default,,0,0,0,,Strybar!
Dialogue: 0,0:14:24.82,0:14:27.44,Default,,0,0,0,,Балволт!
Dialogue: 0,0:14:32.03,0:14:34.37,Default,,0,0,0,,А? а?
Dialogue: 0,0:14:34.45,0:14:37.45,Default,,0,0,0,,Құдайдың қорғауы Құдайға қызмет ететіндерге түседі.
Dialogue: 0,0:14:37.96,0:14:41.00,Default,,0,0,0,,Сенің қара сиқырың мені жеңе алмайды.
Dialogue: 0,0:14:41.08,0:14:44.42,Default,,0,0,0,,Чии Сиқырға қарсы қабық!
Dialogue: 0,0:14:44.50,0:14:45.80,Default,,0,0,0,,Әке!
Dialogue: 0,0:14:46.30,0:14:50.34,Default,,0,0,0,,Бұл кедергіні бұзу мүмкін емес. Сіздің сиқырларыңыз енді күшсіз!
Dialogue: 0,0:14:50.43,0:14:52.26,Default,,0,0,0,,Бірақ сіздің барлық заклинаниеңіз
Dialogue: 0,0:14:52.34,0:14:54.43,Default,,0,0,0,,Оны сол тосқауыл жауып тастаған шығар!
Dialogue: 0,0:14:54.93,0:14:58.60,Default,,0,0,0,,Ондай жағдайда жалғыз нұсқа – қоян-қолтық ұрыс...
Dialogue: 0,0:14:58.68,0:15:00.23,Default,,0,0,0,,Сіз сенімдісіз бе...
Dialogue: 0,0:15:01.27,0:15:04.19,Default,,0,0,0,,Монах және жекпе-жек шебері, яғни монах.
Dialogue: 0,0:15:04.27,0:15:08.07,Default,,0,0,0,,Денсаулық шексіз! Gokuhagane Seikyou 120 Dan
Dialogue: 0,0:15:08.15,0:15:09.15,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:15:09.82,0:15:11.49,Default,,0,0,0,,Басқа идеялар жоқ
Dialogue: 0,0:15:11.57,0:15:13.41,Default,,0,0,0,,Дирк Шнайдер қалай
Dialogue: 0,0:15:13.49,0:15:16.49,Default,,0,0,0,,Катализаторсыз мұнша көп заклинанияны пайдалана алмайсыз.
Dialogue: 0,0:15:17.16,0:15:19.33,Default,,0,0,0,,Бұл бәрібір менде жұмыс істемейді...
Dialogue: 0,0:15:21.17,0:15:24.46,Default,,0,0,0,,А...қайтадан жаман сезім пайда болды...
Dialogue: 0,0:15:24.96,0:15:27.09,Default,,0,0,0,,Сонша шуламаңыз! Қарияны жап
Dialogue: 0,0:15:27.88,0:15:28.59,Default,,0,0,0,,Хмф!
Dialogue: 0,0:15:28.67,0:15:29.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:29.80,0:15:31.68,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:15:31.76,0:15:35.01,Default,,0,0,0,,Мен Металликана корольдік сарайының жерасты қоймасында екеніне сенімдімін.
Dialogue: 0,0:15:35.10,0:15:38.14,Default,,0,0,0,,Онда голем болуы керек, солай ма?
Dialogue: 0,0:15:38.22,0:15:40.52,Default,,0,0,0,,Құрметті сіз! Неге олай?
Dialogue: 0,0:15:40.60,0:15:42.69,Default,,0,0,0,,Бұл 15 жыл бұрын соғыс кезінде.
Dialogue: 0,0:15:42.77,0:15:44.81,Default,,0,0,0,,Мен пайдаланған шығармын!
Dialogue: 0,0:15:44.90,0:15:48.15,Default,,0,0,0,,Вахахаха...
Dialogue: 0,0:15:48.23,0:15:49.61,Default,,0,0,0,,Ммм, жоқ!
Dialogue: 0,0:15:49.69,0:15:52.57,Default,,0,0,0,,Сіз големге сиқырлы тізбекті ашуға тырысасыз ба?
Dialogue: 0,0:15:52.66,0:15:55.41,Default,,0,0,0,,Өлім өлімі Дел Дель Фар С
Dialogue: 0,0:15:55.49,0:15:57.95,Default,,0,0,0,,Мен адал қызметшіме бұйырамын
Dialogue: 0,0:15:58.04,0:16:00.45,Default,,0,0,0,,Иеміздің шақыруына жауап бер!
Dialogue: 0,0:16:00.54,0:16:01.83,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:01.91,0:16:03.67,Default,,0,0,0,,Маған заклинанияға көңіл бөлуге рұқсат етпе!
Dialogue: 0,0:16:03.75,0:16:05.54,Default,,0,0,0,,тым кеш!
Dialogue: 0,0:16:05.63,0:16:08.38,Default,,0,0,0,,Мотор Люси
Dialogue: 0,0:16:08.46,0:16:11.09,Default,,0,0,0,,Алып піл, оян!
Dialogue: 0,0:16:11.17,0:16:13.38,Default,,0,0,0,,Құдай-ай! «Енді бұдан әрі бәрі дәл болжағандай қалай болатынына таңғаламын!»
Dialogue: 0,0:16:13.47,0:16:17.05,Default,,0,0,0,,Мен мұндамын, мен мұндамын, жүр!
Dialogue: 0,0:16:18.51,0:16:20.39,Default,,0,0,0,,Өзінің зұлым күшімен
Dialogue: 0,0:16:20.47,0:16:23.23,Default,,0,0,0,,үшінн талқандау үшін!
Dialogue: 0,0:16:24.06,0:16:25.19,Default,,0,0,0,,Қалайсың, Гео!
Dialogue: 0,0:16:25.27,0:16:30.15,Default,,0,0,0,,Менің сиқырымды сол тосқауылмен бөгесеңіз де, големді өлтіре алмайсыз ба?
Dialogue: 0,0:16:30.78,0:16:32.78,Default,,0,0,0,,Голем туралы не деуге болады?
Dialogue: 0,0:16:32.86,0:16:34.99,Default,,0,0,0,,1 миллион тонна!
Dialogue: 0,0:16:35.07,0:16:36.95,Default,,0,0,0,,Мен сиқыр жасаймын.
Dialogue: 0,0:16:37.03,0:16:38.08,Default,,0,0,0,,Аһ!
Dialogue: 0,0:16:38.16,0:16:42.75,Default,,0,0,0,,Қазірдің өзінде! Гидраның өзі қалада дүрбелең тудырды.
Dialogue: 0,0:16:42.83,0:16:44.50,Default,,0,0,0,,Сондықтан мен Дирк Шнайдерді таңдадым.
Dialogue: 0,0:16:44.58,0:16:46.21,Default,,0,0,0,,Менің қайта тірілуіме қарсы болдыңыз!
Dialogue: 0,0:16:46.29,0:16:47.42,Default,,0,0,0,,Мен де қарсылық білдірдім!
Dialogue: 0,0:16:47.50,0:16:48.29,Default,,0,0,0,,Бүркіт те!
Dialogue: 0,0:16:48.38,0:16:52.13,Default,,0,0,0,,Фуфуфуфу... Хахахахаха!
Dialogue: 0,0:16:52.21,0:16:55.63,Default,,0,0,0,,Әзірше осымен! Білесің бе, бас діни қызметкер.
Dialogue: 0,0:16:55.72,0:16:58.76,Default,,0,0,0,,Кёе~! Қазір мұндай нәрсені жасайтын уақыт емес!
Dialogue: 0,0:16:59.39,0:17:01.72,Default,,0,0,0,,Хмм... Жоқ.
Dialogue: 0,0:17:01.81,0:17:03.85,Default,,0,0,0,,Мен...Мен тоқтауым керек...
Dialogue: 0,0:17:03.93,0:17:05.77,Default,,0,0,0,,Мен оны тоқтатуым керек
Dialogue: 0,0:17:05.85,0:17:10.65,Default,,0,0,0,,Бірақ... Бірақ... Қорыққаным сонша, аяғымды қозғай алмаймын!
Dialogue: 0,0:17:10.73,0:17:12.36,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:17:12.44,0:17:13.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:14.03,0:17:15.45,Default,,0,0,0,,Вахаха...
Dialogue: 0,0:17:15.53,0:17:18.57,Default,,0,0,0,,Өл, өл, өл, өл! Вахаха...
Dialogue: 0,0:17:18.66,0:17:20.74,Default,,0,0,0,,Сіз бұл Люс екеніне сенімдісіз бе?
Dialogue: 0,0:17:21.62,0:17:25.58,Default,,0,0,0,,Мен заттарды жою немесе адамдарды өлтіру туралы ойламаймын.
Dialogue: 0,0:17:25.66,0:17:28.46,Default,,0,0,0,,Маған ұнайды... Жоқ!
Dialogue: 0,0:17:29.92,0:17:32.21,Default,,0,0,0,,Менің Люс-куным толығырақ...
Dialogue: 0,0:17:32.30,0:17:34.84,Default,,0,0,0,,Сүйкімді, сондай сүйкімді…
Dialogue: 0,0:17:34.92,0:17:37.51,Default,,0,0,0,,Адал бол, адал бол...!
Dialogue: 0,0:17:38.01,0:17:40.68,Default,,0,0,0,,Біреу өтінемін Люс-кунды тоқтатыңыз.
Dialogue: 0,0:17:40.76,0:17:43.64,Default,,0,0,0,,Бастапқы Люсе-кунға оралыңыз!
Dialogue: 0,0:17:43.72,0:17:45.23,Default,,0,0,0,,Мұндай шалқып жатқан шөлде мотоцикліммен келе жатқанда —
Dialogue: 0,0:17:45.31,0:17:47.06,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:47.14,0:17:49.69,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:17:49.77,0:17:53.15,Default,,0,0,0,,Мен таптым~
Dialogue: 0,0:17:53.23,0:17:55.61,Default,,0,0,0,,Қоңырау шалған сен емес едің!
Dialogue: 0,0:17:55.69,0:17:57.15,Default,,0,0,0,,Бұл үмітсіз!
Dialogue: 0,0:17:57.24,0:17:59.57,Default,,0,0,0,,Хмф! Бұл сен~
Dialogue: 0,0:17:59.66,0:18:02.41,Default,,0,0,0,,Осборнды жеңген сиқыршы!
Dialogue: 0,0:18:02.49,0:18:06.37,Default,,0,0,0,,Мен сол құдіреттің куәсі болу үшін келдім!
Dialogue: 0,0:18:06.46,0:18:08.87,Default,,0,0,0,,Ей, ең жаманы ең жаманды әкелді!
Dialogue: 0,0:18:08.96,0:18:09.96,Default,,0,0,0,,Маған не болады?
Dialogue: 0,0:18:10.67,0:18:13.34,Default,,0,0,0,,Менің атым Кебидаб!
Dialogue: 0,0:18:13.42,0:18:19.59,Default,,0,0,0,,Мен бір күні дүниенің билеушісі болатын ұлы сиқыршы Калустың шәкіртімін!
Dialogue: 0,0:18:19.68,0:18:23.43,Default,,0,0,0,,Сіз қалай таң қалдыңыз? Вахахаха!
Dialogue: 0,0:18:23.51,0:18:24.56,Default,,0,0,0,,Не?
Dialogue: 0,0:18:24.64,0:18:26.27,Default,,0,0,0,,Каккакакака…
Dialogue: 0,0:18:26.89,0:18:28.48,Default,,0,0,0,,Бұл каллус!
Dialogue: 0,0:18:28.56,0:18:32.77,Default,,0,0,0,,Мен саған қара бүлікші әскеріміздің күшін көрсетемін!
Dialogue: 0,0:18:32.86,0:18:35.44,Default,,0,0,0,,Жүр, қайда болсаң да маған қоңырау шал!
Dialogue: 0,0:18:36.94,0:18:38.78,Default,,0,0,0,,Уайымдама...
Dialogue: 0,0:18:38.86,0:18:41.12,Default,,0,0,0,,Сен Фуджибитай бейбақ~!
Dialogue: 0,0:18:41.74,0:18:42.70,Default,,0,0,0,,Фуджибитай?
Dialogue: 0,0:18:42.78,0:18:43.74,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:18:43.83,0:18:46.45,Default,,0,0,0,,Қарашы, қансырап жатырсың!
Dialogue: 0,0:18:46.54,0:18:48.41,Default,,0,0,0,,Не керек, қоңырау шалып жатыр ма?
Dialogue: 0,0:18:48.50,0:18:50.54,Default,,0,0,0,,Теми сияқты жеңілген кейіпкер
Dialogue: 0,0:18:50.62,0:18:53.71,Default,,0,0,0,,Әдемі кейіпкерге айтатын жақсы жол осы ма?
Dialogue: 0,0:18:53.79,0:18:56.51,Default,,0,0,0,,Мен сені өлтіремін, дәл қазір осында түс!
Dialogue: 0,0:18:56.59,0:19:02.43,Default,,0,0,0,,Бұл... үлкен желбезектері бар балық жігіт! Вахаха...
Dialogue: 0,0:19:02.51,0:19:03.76,Default,,0,0,0,,Балық!
Dialogue: 0,0:19:06.35,0:19:12.65,Default,,0,0,0,,Куккококококо, арсыз адам~!
Dialogue: 0,0:19:13.61,0:19:15.32,Default,,0,0,0,,Голем!
Dialogue: 0,0:19:17.40,0:19:18.99,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:19:26.49,0:19:29.62,Default,,0,0,0,,Менің Гидрам!
Dialogue: 0,0:19:29.71,0:19:34.67,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:19:34.75,0:19:36.34,Default,,0,0,0,,Ниндзялар Эдо дәуірінде жойылып кеткен жоқ па?
Dialogue: 0,0:19:36.42,0:19:38.38,Default,,0,0,0,,Уау~ Гуггг...
Dialogue: 0,0:19:38.46,0:19:41.84,Default,,0,0,0,,Менің бетім қатты ауырады!
Dialogue: 0,0:19:41.93,0:19:44.26,Default,,0,0,0,,Бұл... Сәру-сүке...
Dialogue: 0,0:19:44.34,0:19:47.22,Default,,0,0,0,,Өлме!
Dialogue: 0,0:19:48.39,0:19:50.43,Default,,0,0,0,,Зазард Зазард
Dialogue: 0,0:19:50.52,0:19:52.44,Default,,0,0,0,,Скроно Роносук…
Dialogue: 0,0:19:52.52,0:19:56.15,Default,,0,0,0,,Қап-қара түнектің қойнауында тозақ оты жанып тұр...
Dialogue: 0,0:19:57.15,0:20:00.28,Default,,0,0,0,,Менің семсерім болып, жауды жой!
Dialogue: 0,0:20:00.36,0:20:02.32,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:20:02.40,0:20:04.03,Default,,0,0,0,,Бенон!
Dialogue: 0,0:20:04.11,0:20:09.70,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:20:13.25,0:20:18.63,Default,,0,0,0,,Хмф! Хахахаха!
Dialogue: 0,0:20:18.71,0:20:24.72,Default,,0,0,0,,Хахахаха! Фуфухахахаха...!
Dialogue: 0,0:20:24.80,0:20:28.51,Default,,0,0,0,,Бас діни қызметкер Енді Теменің кезегі!
Dialogue: 0,0:20:29.10,0:20:29.97,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:30.06,0:20:34.27,Default,,0,0,0,,Хахахаха өл!
Dialogue: 0,0:20:35.60,0:20:37.15,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:20:39.19,0:20:40.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:42.40,0:20:44.45,Default,,0,0,0,,Тоқташы, өтінемін!
Dialogue: 0,0:20:45.32,0:20:46.32,Default,,0,0,0,,Йоко-сан...
Dialogue: 0,0:20:46.41,0:20:47.62,Default,,0,0,0,,Бұл сөзсіз басқаша.
Dialogue: 0,0:20:47.70,0:20:50.41,Default,,0,0,0,,Сіз Люс-кун емессіз.
Dialogue: 0,0:20:51.08,0:20:53.87,Default,,0,0,0,,Мен білетін Люс-кун бұлай емес.
Dialogue: 0,0:20:53.96,0:20:55.58,Default,,0,0,0,,Сіз бәрібірсіз
Dialogue: 0,0:20:55.67,0:20:57.79,Default,,0,0,0,,Ол ежелгі зұлым сиқыршы!
Dialogue: 0,0:20:57.88,0:20:58.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:00.42,0:21:01.55,Default,,0,0,0,,Леви…
Dialogue: 0,0:21:01.63,0:21:04.26,Default,,0,0,0,,Маған менің Люс-кунымды қайтарыңыз!
Dialogue: 0,0:21:10.06,0:21:16.02,Default,,0,0,0,,Аа...себебі...Йоко-сан, мен де жалмауызмын.
Dialogue: 0,0:21:17.35,0:21:18.40,Default,,0,0,0,,Дирк Шнайдермен
Dialogue: 0,0:21:18.48,0:21:19.69,Default,,0,0,0,,Люс Ренрен
Dialogue: 0,0:21:19.77,0:21:24.44,Default,,0,0,0,,Бір адамның жан дүниесінде екі ғана қасиет пен кісілік болады.
Dialogue: 0,0:21:24.53,0:21:27.66,Default,,0,0,0,,Люс өлсе, Дирк Шнайдер де өледі.
Dialogue: 0,0:21:28.53,0:21:32.70,Default,,0,0,0,,Люс кімді жақсы көрсе, мен де жақсы көремін.
Dialogue: 0,0:21:36.96,0:21:41.30,Default,,0,0,0,,Түсіндім... сенбейсіз бе?
Dialogue: 0,0:21:43.17,0:21:45.22,Default,,0,0,0,,Хмм... аа! Хаха
Dialogue: 0,0:21:46.30,0:21:47.18,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:21:50.35,0:21:52.22,Default,,0,0,0,,Люс өлсе
Dialogue: 0,0:21:52.31,0:21:54.98,Default,,0,0,0,,Дирк Шнайдер де өледі.
Dialogue: 0,0:21:55.06,0:21:58.48,Default,,0,0,0,,Люс кімді жақсы көрсе, мен де жақсы көремін.
Dialogue: 0,0:22:08.61,0:22:09.78,Default,,0,0,0,,Йоко-сан?
Dialogue: 0,0:22:09.87,0:22:10.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:11.70,0:22:12.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:13.49,0:22:15.16,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:22:16.37,0:22:17.75,Default,,0,0,0,,Мистер Люс!
Dialogue: 0,0:22:23.13,0:22:25.13,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.50,0:23:46.50,Default,,0,0,0,,～♪
