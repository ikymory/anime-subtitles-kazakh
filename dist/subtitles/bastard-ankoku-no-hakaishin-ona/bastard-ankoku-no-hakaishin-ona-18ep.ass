Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.92,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:20.52,0:00:21.73,Default,,0,0,0,,Дарш…
Dialogue: 0,0:00:29.40,0:00:32.32,Default,,0,0,0,,Ах... тесігі жабылып жатыр.
Dialogue: 0,0:00:43.33,0:00:45.29,Default,,0,0,0,,Бұл өте қарапайым.
Dialogue: 0,0:00:49.46,0:00:51.67,Default,,0,0,0,,Әй, ақымақ!
Dialogue: 0,0:00:51.76,0:00:54.84,Default,,0,0,0,,Екінің бірі аман қалды...
Dialogue: 0,0:00:59.68,0:01:02.35,Default,,0,0,0,,Қандай қорқынышты сиқырлы күш!
Dialogue: 0,0:01:02.43,0:01:04.81,Default,,0,0,0,,Ней мырза мен Дирк Шнайдер мырза...
Dialogue: 0,0:01:07.44,0:01:09.11,Default,,0,0,0,,Ал, барамыз ба?
Dialogue: 0,0:01:10.86,0:01:13.32,Default,,0,0,0,,Күте тұрыңыз, жігітім.
Dialogue: 0,0:01:14.32,0:01:17.41,Default,,0,0,0,,Әй, қасынан өтіп кете алмайсың.
Dialogue: 0,0:01:28.54,0:01:31.04,Default,,0,0,0,,Ая~ Өлді!
Dialogue: 0,0:01:31.13,0:01:33.88,Default,,0,0,0,,Дирк Шнайдердің жігіті жеңілді!
Dialogue: 0,0:01:33.96,0:01:37.18,Default,,0,0,0,,Қиындық! Бұл патшалық және әлем
Dialogue: 0,0:01:37.26,0:01:40.51,Default,,0,0,0,,Эде-Е мен ниндзя сәйкес келмейді.
Dialogue: 0,0:01:40.60,0:01:44.10,Default,,0,0,0,,Енді менде Калдың алдында бас иіп, оның құлы болудан басқа амалым жоқ.
Dialogue: 0,0:01:44.60,0:01:45.23,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:45.31,0:01:46.06,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:46.60,0:01:47.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:48.52,0:01:53.23,Default,,0,0,0,,Бұл адам әрқашан абсолютті қолайсыздыққа қарсы күрескен.
Dialogue: 0,0:01:53.82,0:01:55.57,Default,,0,0,0,,Тіпті сіздің «өліміңіз»
Dialogue: 0,0:01:56.36,0:01:58.95,Default,,0,0,0,,Мен бұл жолы да сенімдімін...
Dialogue: 0,0:01:59.95,0:02:01.24,Default,,0,0,0,,Махаббат та, махаббатсыз неке де
Dialogue: 0,0:02:02.70,0:02:04.04,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:02:07.96,0:02:13.04,Default,,0,0,0,,Мен көтерілісшілер әскерінің көктегі төрт патшасының бірімін, Абигейлмін.
Dialogue: 0,0:02:13.13,0:02:17.13,Default,,0,0,0,,Адамдар мені жер асты елінің пайғамбары деп атайтын сияқты.
Dialogue: 0,0:02:17.22,0:02:19.30,Default,,0,0,0,,Аспан асты елінің пайғамбары…
Dialogue: 0,0:02:19.38,0:02:20.59,Default,,0,0,0,,Агия Агия
Dialogue: 0,0:02:21.43,0:02:24.43,Default,,0,0,0,,Әй, бұл шайтан сойыл.
Dialogue: 0,0:02:25.10,0:02:29.73,Default,,0,0,0,,Осылайша жақын маңдағы адамдардың тіршілік күшін өзіне сіңіреді.
Dialogue: 0,0:02:29.81,0:02:33.48,Default,,0,0,0,,Оны орасан зор сиқырлы күш ретінде сақтауға болады.
Dialogue: 0,0:02:35.98,0:02:37.36,Default,,0,0,0,,Ха! (Ларс) Агия
Dialogue: 0,0:02:37.86,0:02:41.87,Default,,0,0,0,,Шайтан сақинасының үшінші сиқырлы құрылғысының жақындағанын анықтайды.
Dialogue: 0,0:02:41.95,0:02:44.03,Default,,0,0,0,,Ол резонанс тудырады.
Dialogue: 0,0:02:44.12,0:02:45.79,Default,,0,0,0,,Үш сиқырлы құрылғы
Dialogue: 0,0:02:45.87,0:02:50.12,Default,,0,0,0,,Әу баста бір тіршілік иесі болған сияқты.
Dialogue: 0,0:02:50.62,0:02:53.46,Default,,0,0,0,,Сіз солай ойлайсыз ба, жас ханым?
Dialogue: 0,0:02:54.59,0:02:55.96,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:56.05,0:02:58.38,Default,,0,0,0,,Бұл аздап қисынсыз емес пе? Хахаха
Dialogue: 0,0:02:58.46,0:02:59.42,Default,,0,0,0,,Уф
Dialogue: 0,0:03:00.22,0:03:04.85,Default,,0,0,0,,Demon Mail Ібіліс сойыл Шайтан сақинасы
Dialogue: 0,0:03:05.35,0:03:08.52,Default,,0,0,0,,Сиқырлы аспаптардың осы үш түрі бір жерге жиналғанда,
Dialogue: 0,0:03:08.60,0:03:11.52,Default,,0,0,0,,Сіз не болатынын білгіңіз келеді, солай ма?
Dialogue: 0,0:03:11.60,0:03:13.02,Default,,0,0,0,,Кукукукукуку
Dialogue: 0,0:03:13.10,0:03:15.11,Default,,0,0,0,,Бұл бәрібір жиіркенішті нәрсе емес пе?
Dialogue: 0,0:03:15.19,0:03:16.07,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:16.15,0:03:18.07,Default,,0,0,0,,Мен мұны білгім келмейді.
Dialogue: 0,0:03:18.61,0:03:21.78,Default,,0,0,0,,Түсіндім, бұл ұят.
Dialogue: 0,0:03:24.32,0:03:26.99,Default,,0,0,0,,... кенет тоқтады.
Dialogue: 0,0:03:27.08,0:03:27.70,Default,,0,0,0,,Агия
Dialogue: 0,0:03:27.79,0:03:30.41,Default,,0,0,0,,Гилан-Ира жабылған сияқты.
Dialogue: 0,0:03:30.50,0:03:33.50,Default,,0,0,0,,Не? Гилан... не?
Dialogue: 0,0:03:33.58,0:03:36.17,Default,,0,0,0,,Эй, сен білгің келе ме?
Dialogue: 0,0:03:37.21,0:03:38.50,Default,,0,0,0,,Гилан-Ила!
Dialogue: 0,0:03:38.59,0:03:41.67,Default,,0,0,0,,Бұл аса ауырлық массасы.
Dialogue: 0,0:03:41.76,0:03:45.01,Default,,0,0,0,,Сіз баратын жер басқа өлшем, жер асты дүниесі тозағы!
Dialogue: 0,0:03:45.09,0:03:47.43,Default,,0,0,0,,Яғни, Дирк Шнайдер қайтыс болды.
Dialogue: 0,0:03:47.51,0:03:50.10,Default,,0,0,0,,Бұл дүниеден ғайып болды дегенді білдіреді.
Dialogue: 0,0:03:50.18,0:03:52.48,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:03:52.56,0:03:53.81,Default,,0,0,0,,Эй, сен!
Dialogue: 0,0:03:53.90,0:03:55.56,Default,,0,0,0,,Мұндай бейқам сөздерді айтпа!
Dialogue: 0,0:03:55.65,0:03:56.86,Default,,0,0,0,,Гах!
Dialogue: 0,0:03:56.94,0:04:00.24,Default,,0,0,0,,Менің Люсиім оңай өлмейді.
Dialogue: 0,0:04:00.78,0:04:04.20,Default,,0,0,0,,Мен оны өлтірсем де ол өлмейді!
Dialogue: 0,0:04:04.28,0:04:05.45,Default,,0,0,0,,Иә
Dialogue: 0,0:04:05.53,0:04:08.16,Default,,0,0,0,,Бірақ бұл жолы Қара Шу ғана...
Dialogue: 0,0:04:08.28,0:04:09.29,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:04:09.37,0:04:10.04,Default,,0,0,0,,Агия
Dialogue: 0,0:04:10.12,0:04:13.25,Default,,0,0,0,,Сен сондай бейбақ болсаң да, бәрібір басты кейіпкерсің!
Dialogue: 0,0:04:13.33,0:04:15.38,Default,,0,0,0,,Оның тірі екені анық!
Dialogue: 0,0:04:15.46,0:04:18.42,Default,,0,0,0,,...
Dialogue: 0,0:04:18.50,0:04:23.30,Default,,0,0,0,,Мынау... бұл қызбен күресу қиын.
Dialogue: 0,0:04:25.89,0:04:27.64,Default,,0,0,0,,ақымақ
Dialogue: 0,0:04:27.72,0:04:30.31,Default,,0,0,0,,Дирк Шнайдер кетіп қалды.
Dialogue: 0,0:04:30.93,0:04:33.27,Default,,0,0,0,,Сіз Йомироны да ұстанасыз ба?
Dialogue: 0,0:04:33.35,0:04:35.69,Default,,0,0,0,,Цк кәрі сегізаяқ
Dialogue: 0,0:04:36.31,0:04:38.27,Default,,0,0,0,,Көздерің бос па?
Dialogue: 0,0:04:39.11,0:04:41.28,Default,,0,0,0,,Жалынның қабырғасы жануды жалғастыруда
Dialogue: 0,0:04:41.36,0:04:44.36,Default,,0,0,0,,Қараңғы Шнайдердің сиқырлы күші маған әлі де жетеді.
Dialogue: 0,0:04:44.86,0:04:47.12,Default,,0,0,0,,Яғни, аман қалудың дәлелі!
Dialogue: 0,0:04:47.66,0:04:52.25,Default,,0,0,0,,Мен түсінемін, ол басқа өлшемде қалқып тұрған шығар.
Dialogue: 0,0:04:52.33,0:04:54.08,Default,,0,0,0,,Бірақ мен ақырында өлемін
Dialogue: 0,0:04:54.75,0:04:59.67,Default,,0,0,0,,Ол жақта су да, ауа да, тіпті жарық та жоқ.
Dialogue: 0,0:04:59.75,0:05:00.88,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:05:01.75,0:05:04.67,Default,,0,0,0,,Оған дейін мен сені өлтіремін.
Dialogue: 0,0:05:04.76,0:05:07.76,Default,,0,0,0,,Есікті тағы бір рет ашу үшін сол сақинаны қолданайық.
Dialogue: 0,0:05:10.85,0:05:12.85,Default,,0,0,0,,Мурасаме жүзі!
Dialogue: 0,0:05:13.60,0:05:17.31,Default,,0,0,0,,Бұл қылыш маған зиян тигізе алмайды
Dialogue: 0,0:05:17.40,0:05:19.15,Default,,0,0,0,,Жүр, кет.
Dialogue: 0,0:05:19.73,0:05:23.11,Default,,0,0,0,,Менде маңызды нәрсе бар.
Dialogue: 0,0:05:24.57,0:05:28.82,Default,,0,0,0,,Ол қорғансыз, алшақтықты жаба береді.
Dialogue: 0,0:05:28.91,0:05:30.37,Default,,0,0,0,,Жалаңыз!
Dialogue: 0,0:05:31.45,0:05:33.33,Default,,0,0,0,,Жарайды, олай айтпа.
Dialogue: 0,0:05:33.41,0:05:35.54,Default,,0,0,0,,Кел, жігіт!
Dialogue: 0,0:05:35.62,0:05:37.54,Default,,0,0,0,,Бұл табандылық.
Dialogue: 0,0:05:37.62,0:05:38.71,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:05:38.79,0:05:41.17,Default,,0,0,0,,Кенеттен нағыз жын қылыш!
Dialogue: 0,0:05:41.67,0:05:42.67,Default,,0,0,0,,Ga!
Dialogue: 0,0:05:46.55,0:05:47.51,Default,,0,0,0,,Nu...
Dialogue: 0,0:05:47.59,0:05:50.39,Default,,0,0,0,,Бұл жауаптың жоқтығы неде?
Dialogue: 0,0:05:50.93,0:05:54.22,Default,,0,0,0,,Қабық өкшесі Сабор Лан Форсо
Dialogue: 0,0:05:54.85,0:05:56.60,Default,,0,0,0,,Бірінші соққы
Dialogue: 0,0:05:56.68,0:05:59.44,Default,,0,0,0,,Ең үлкен жұмбақпен орындалатын даналық
Dialogue: 0,0:05:59.52,0:06:01.69,Default,,0,0,0,,Аспандағы төрт патшаның бірі...
Dialogue: 0,0:06:01.77,0:06:02.40,Default,,0,0,0,,Қу!
Dialogue: 0,0:06:02.90,0:06:06.86,Default,,0,0,0,,Бірақ кеңесті елемеу ақылсыздық болды.
Dialogue: 0,0:06:06.94,0:06:08.07,Default,,0,0,0,,Не?
Dialogue: 0,0:06:08.15,0:06:09.36,Default,,0,0,0,,Skid Roar!
Dialogue: 0,0:06:09.45,0:06:10.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:10.57,0:06:11.74,Default,,0,0,0,,Гала-сама!
Dialogue: 0,0:06:11.82,0:06:13.95,Default,,0,0,0,,Гах! Арх!
Dialogue: 0,0:06:18.00,0:06:20.75,Default,,0,0,0,,Ах~ Бұл жақсы емес!
Dialogue: 0,0:06:20.83,0:06:22.59,Default,,0,0,0,,Бұл ойын сияқты емес
Dialogue: 0,0:06:22.67,0:06:24.46,Default,,0,0,0,,Ей, сені өлтіреді!
Dialogue: 0,0:06:24.55,0:06:25.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:26.80,0:06:30.68,Default,,0,0,0,,Эде-Е денесі физикалық болмыс болғанымен,
Dialogue: 0,0:06:30.76,0:06:33.97,Default,,0,0,0,,Астральды денеге жақын орналасқан.
Dialogue: 0,0:06:34.06,0:06:38.89,Default,,0,0,0,,Яғни, бір уақытта екі өлшемде бар нәрсе.
Dialogue: 0,0:06:38.98,0:06:41.40,Default,,0,0,0,,Мұрасаме сиқырлы қылыш болса да
Dialogue: 0,0:06:41.48,0:06:44.73,Default,,0,0,0,,Денені басқа өлшемнен қиып алуға болмайды.
Dialogue: 0,0:06:45.40,0:06:49.74,Default,,0,0,0,,Бұл денені кесіп тастағаным дұрыс емес пе?
Dialogue: 0,0:06:50.61,0:06:52.41,Default,,0,0,0,,Бұл өлмейтін.
Dialogue: 0,0:06:53.32,0:06:54.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:54.70,0:06:57.66,Default,,0,0,0,,Сіз бұл сиқырдан кейін әлі тірісіз бе?
Dialogue: 0,0:06:58.66,0:07:01.00,Default,,0,0,0,,Оған және Дирк Шнайдерге қарағанда.
Dialogue: 0,0:07:01.08,0:07:02.79,Default,,0,0,0,,Бұл тірі дене
Dialogue: 0,0:07:03.33,0:07:06.21,Default,,0,0,0,,Өйткені ол «Хиейге» қарағанда қорғаныс күші жоғары «Хирю» киген.
Dialogue: 0,0:07:06.30,0:07:08.17,Default,,0,0,0,,Бұл әлі де жақсы болғанымен...
Dialogue: 0,0:07:09.13,0:07:12.80,Default,,0,0,0,,Егер маған тағы бір сиқыр тисе, мен өлемін.
Dialogue: 0,0:07:14.60,0:07:15.89,Default,,0,0,0,,Уф
Dialogue: 0,0:07:16.85,0:07:20.10,Default,,0,0,0,,Сиқыр, қылыш және жалын шабуылдары да нәтиже бермейді.
Dialogue: 0,0:07:20.18,0:07:23.56,Default,,0,0,0,,Онда шабуылға жол жоқ!
Dialogue: 0,0:07:24.31,0:07:28.11,Default,,0,0,0,,Осындай шақта менде жалындаған қылыш немесе найзағай қылыш болса...
Dialogue: 0,0:07:28.61,0:07:30.86,Default,,0,0,0,,Ха! Мен түсінемін.
Dialogue: 0,0:07:30.95,0:07:34.32,Default,,0,0,0,,Иә! Эдиді өлтірудің бір ғана жолы бар.
Dialogue: 0,0:07:34.41,0:07:36.12,Default,,0,0,0,,Не? Тез айт!
Dialogue: 0,0:07:36.20,0:07:38.29,Default,,0,0,0,,Мен Гала-самаға хабарлауым керек!
Dialogue: 0,0:07:39.58,0:07:41.50,Default,,0,0,0,,Гала-саманың сүйікті қылышы Мурасаме
Dialogue: 0,0:07:41.58,0:07:44.50,Default,,0,0,0,,Неліктен «жын қылыш» деп аталғанын білесіз бе?
Dialogue: 0,0:07:46.92,0:07:48.46,Default,,0,0,0,,Жын семсер Мурасаме
Dialogue: 0,0:07:49.01,0:07:51.22,Default,,0,0,0,,Көне заманнан бері келе жатыр.
Dialogue: 0,0:07:51.30,0:07:54.14,Default,,0,0,0,,Атақты қылышшылардың қолынан өткен атақты қылыш.
Dialogue: 0,0:07:54.97,0:07:58.60,Default,,0,0,0,,Жұмбақ жарқыраған алты фут бір дюймдік жүзді үнемі шық басып тұрады.
Dialogue: 0,0:07:58.68,0:08:01.23,Default,,0,0,0,,Тербетсең, тұманды самал шақырады дейді.
Dialogue: 0,0:08:01.93,0:08:04.27,Default,,0,0,0,,Бірақ мәні мынада
Dialogue: 0,0:08:04.35,0:08:08.19,Default,,0,0,0,,Пышақ зұлым рухтардан қорғайтын сиқырлы күшке ие.
Dialogue: 0,0:08:08.73,0:08:13.82,Default,,0,0,0,,Бірақ бұл қылыш пайдаланушының өмірлік күшін шегіне дейін жояды.
Dialogue: 0,0:08:14.53,0:08:17.83,Default,,0,0,0,,Мурасаме өзінің шынайы күшін көрсеткенде
Dialogue: 0,0:08:17.91,0:08:20.20,Default,,0,0,0,,Шебердің өмірін сорып ал
Dialogue: 0,0:08:20.29,0:08:22.16,Default,,0,0,0,,Бұл шынымен де сиқырлы қылыш.
Dialogue: 0,0:08:23.41,0:08:27.38,Default,,0,0,0,,Гала-сама дәл қазір осыны ойлап жүргеніне сенімдімін.
Dialogue: 0,0:08:28.29,0:08:29.21,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:08:31.05,0:08:31.71,Default,,0,0,0,,Әй
Dialogue: 0,0:08:32.55,0:08:35.68,Default,,0,0,0,,Оны қазір қолдансаңыз, өліп қалуыңыз мүмкін.
Dialogue: 0,0:08:39.47,0:08:41.56,Default,,0,0,0,,Әй, Мамайо!
Dialogue: 0,0:08:42.81,0:08:46.60,Default,,0,0,0,,Мені барлық ақылсыз нәрселерді жеуге мәжбүр еткен сол болды.
Dialogue: 0,0:08:46.69,0:08:50.15,Default,,0,0,0,,Енді сіздің төлеміңіз, оны алыңыз.
Dialogue: 0,0:08:50.23,0:08:53.36,Default,,0,0,0,,Ниндзя шебері Гала өледі!
Dialogue: 0,0:08:54.90,0:08:55.91,Default,,0,0,0,,Гала-сама!
Dialogue: 0,0:08:55.99,0:08:57.91,Default,,0,0,0,,Арх... Арх!
Dialogue: 0,0:08:57.99,0:08:59.03,Default,,0,0,0,,Хмф!
Dialogue: 0,0:09:00.54,0:09:02.41,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:09:05.58,0:09:06.96,Default,,0,0,0,,Мурасаме!
Dialogue: 0,0:09:07.04,0:09:09.59,Default,,0,0,0,,Сіздің шынайы күшіңіз
Dialogue: 0,0:09:09.67,0:09:12.84,Default,,0,0,0,,Оны маған қазір көрсет!
Dialogue: 0,0:09:12.92,0:09:14.22,Default,,0,0,0,,Қу!
Dialogue: 0,0:09:15.38,0:09:18.64,Default,,0,0,0,,Нуаааа~!
Dialogue: 0,0:09:18.72,0:09:20.10,Default,,0,0,0,,Қу!
Dialogue: 0,0:09:21.18,0:09:23.56,Default,,0,0,0,,Нуаааа~!
Dialogue: 0,0:09:23.64,0:09:24.39,Default,,0,0,0,,Мм!
Dialogue: 0,0:09:27.44,0:09:28.60,Default,,0,0,0,,Не?
Dialogue: 0,0:09:28.69,0:09:30.86,Default,,0,0,0,,Сіз қайтадан тұтқаға тартыласыз.
Dialogue: 0,0:09:31.82,0:09:34.78,Default,,0,0,0,,Әй, бұл қандай еліктеу екенін білмеймін.
Dialogue: 0,0:09:34.86,0:09:37.36,Default,,0,0,0,,Енді мен кішкентай трюктерді аяқтадым,
Dialogue: 0,0:09:37.45,0:09:40.78,Default,,0,0,0,,Сіздің өміріңіздің аяқталуында ештеңе жоқ!
Dialogue: 0,0:09:40.87,0:09:43.04,Default,,0,0,0,,Ku! О...
Dialogue: 0,0:09:43.12,0:09:44.75,Default,,0,0,0,,Енді өл!
Dialogue: 0,0:09:44.83,0:09:46.00,Default,,0,0,0,,Skid Roar!
Dialogue: 0,0:09:48.58,0:09:51.46,Default,,0,0,0,,Ах~ Гала-сама неге қозғалмайды?
Dialogue: 0,0:09:51.54,0:09:52.63,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:09:54.84,0:09:56.59,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:09:57.09,0:09:59.80,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:00.34,0:10:01.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.06,0:10:08.10,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:10:08.19,0:10:09.35,Default,,0,0,0,,О!
Dialogue: 0,0:10:09.44,0:10:10.56,Default,,0,0,0,,Гала-сама!
Dialogue: 0,0:10:12.73,0:10:14.23,Default,,0,0,0,,Жындарды қуу!
Dialogue: 0,0:10:16.28,0:10:19.57,Default,,0,0,0,,Жоқ, Гала-саманы біреу тоқтатсын!
Dialogue: 0,0:10:19.66,0:10:20.28,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:20.36,0:10:23.33,Default,,0,0,0,,Өртеп күлге айналдыр!
Dialogue: 0,0:10:23.83,0:10:24.62,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:25.20,0:10:26.83,Default,,0,0,0,,Менің өмірім!
Dialogue: 0,0:10:26.91,0:10:30.12,Default,,0,0,0,,Ақ жүзге айналып, оның тамағы
Dialogue: 0,0:10:30.21,0:10:31.67,Default,,0,0,0,,Бұзыңыз!
Dialogue: 0,0:10:31.75,0:10:33.29,Default,,0,0,0,,Не?
Dialogue: 0,0:10:35.09,0:10:40.38,Default,,0,0,0,,Шыу!
Dialogue: 0,0:10:40.47,0:10:41.59,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:10:43.64,0:10:45.77,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:45.85,0:10:47.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:47.22,0:10:48.39,Default,,0,0,0,,Гала ханым!
Dialogue: 0,0:10:50.14,0:10:50.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:52.77,0:10:53.94,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:56.28,0:10:57.23,Default,,0,0,0,,Гала-сама қайтыс болды...
Dialogue: 0,0:10:57.32,0:11:00.40,Default,,0,0,0,,Қандай қорқынышты қылыш!
Dialogue: 0,0:11:01.20,0:11:02.16,Default,,0,0,0,,Не?
Dialogue: 0,0:11:16.84,0:11:21.26,Default,,0,0,0,,Егер шайтан сойыл Унуның күшін екі есе азайтса ше?
Dialogue: 0,0:11:21.80,0:11:26.72,Default,,0,0,0,,Менің барлық керемет жоспарларым жойылуға жақын болды.
Dialogue: 0,0:11:26.81,0:11:28.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:28.97,0:11:30.73,Default,,0,0,0,,Ол зиянсыз ба?
Dialogue: 0,0:11:31.23,0:11:32.94,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:11:33.02,0:11:35.36,Default,,0,0,0,,Онда неге, Гала-сама...
Dialogue: 0,0:11:36.48,0:11:37.15,Default,,0,0,0,,Иә
Dialogue: 0,0:11:37.23,0:11:39.53,Default,,0,0,0,,Өйткені, әлсіз адамның күшімен
Dialogue: 0,0:11:39.61,0:11:43.11,Default,,0,0,0,,Сіз жын семсердің сиқырлы күшіне төтеп бере алмаған сияқтысыз.
Dialogue: 0,0:11:43.86,0:11:46.12,Default,,0,0,0,,Уф, ол жарылмады!
Dialogue: 0,0:11:46.62,0:11:48.41,Default,,0,0,0,,Тоқта, сегізаяқ!
Dialogue: 0,0:11:48.49,0:11:49.33,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:51.00,0:11:55.38,Default,,0,0,0,,Мен сатқым келетін бірдеңе қалды!
Dialogue: 0,0:11:55.46,0:11:56.84,Default,,0,0,0,,Гала-сама!
Dialogue: 0,0:11:57.42,0:12:01.05,Default,,0,0,0,,Егер мен ұйықтап қалсам, нені сағынатын едім
Dialogue: 0,0:12:01.84,0:12:07.18,Default,,0,0,0,,Қылыш жанымды құрғатты, күресуге күшім қалмады.
Dialogue: 0,0:12:07.26,0:12:12.39,Default,,0,0,0,,Егер сіз нашар әрекет етсеңіз, мен сізге көмектесе алмай тұрып өлесіз.
Dialogue: 0,0:12:13.23,0:12:14.85,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:12:14.94,0:12:19.11,Default,,0,0,0,,Кез келген сәтте төмендеп, жоғалып бара жатқандай көрінетін жалын қабырғасы...
Dialogue: 0,0:12:19.19,0:12:22.32,Default,,0,0,0,,Дирк Шнайдер мен Ней басқа өлшемде
Dialogue: 0,0:12:22.40,0:12:24.78,Default,,0,0,0,,Өлім алдындағы куәлік
Dialogue: 0,0:12:24.86,0:12:26.37,Default,,0,0,0,,тым кеш
Dialogue: 0,0:12:26.45,0:12:28.45,Default,,0,0,0,,Ал егер сат десең де
Dialogue: 0,0:12:28.53,0:12:32.66,Default,,0,0,0,,Сенде тек өз өмірің қалды.
Dialogue: 0,0:12:32.75,0:12:35.33,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:12:37.42,0:12:38.92,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:12:39.67,0:12:40.63,Default,,0,0,0,,Ней
Dialogue: 0,0:12:46.05,0:12:47.55,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:12:47.64,0:12:49.60,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:12:49.68,0:12:51.77,Default,,0,0,0,,Мен оны саттым, тұтынушы!
Dialogue: 0,0:12:51.85,0:12:53.06,Default,,0,0,0,,Гала-сама!
Dialogue: 0,0:12:53.14,0:12:55.44,Default,,0,0,0,,Жетеді, тоқтаңыз!
Dialogue: 0,0:12:55.52,0:12:57.06,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:12:57.15,0:13:00.36,Default,,0,0,0,,Өлмеген мендей емес, сен тірісің.
Dialogue: 0,0:13:00.44,0:13:03.65,Default,,0,0,0,,Ажал барудан құтылуға жол жоқ!
Dialogue: 0,0:13:03.74,0:13:06.41,Default,,0,0,0,,Неліктен? Өлімнен қорықпайсың ба?
Dialogue: 0,0:13:06.49,0:13:09.33,Default,,0,0,0,,Маған жақындау үшін неге сонша бардың?
Dialogue: 0,0:13:09.41,0:13:12.83,Default,,0,0,0,,Хе, әйтеуір.
Dialogue: 0,0:13:13.87,0:13:15.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:18.17,0:13:19.17,Default,,0,0,0,,О!
Dialogue: 0,0:13:19.25,0:13:21.17,Default,,0,0,0,,Не? Мурасаме!
Dialogue: 0,0:13:22.55,0:13:24.63,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:13:24.72,0:13:26.55,Default,,0,0,0,,Жүр!
Dialogue: 0,0:13:27.47,0:13:29.89,Default,,0,0,0,,Кейунки ниндзя қылышы!
Dialogue: 0,0:13:30.43,0:13:33.81,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:13:33.89,0:13:36.02,Default,,0,0,0,,Сен сондай ақымақсың...
Dialogue: 0,0:13:36.73,0:13:38.77,Default,,0,0,0,,♬~
Dialogue: 0,0:13:47.53,0:13:50.16,Default,,0,0,0,,Не болды? Не болып жатыр?
Dialogue: 0,0:13:50.24,0:13:53.12,Default,,0,0,0,,Түтіннен мен көрмеймін.
Dialogue: 0,0:13:53.20,0:13:57.67,Default,,0,0,0,,Олай болса, мен естіген Мұрасаме сиқырлы қылыштың шын құдіреті қандай?
Dialogue: 0,0:13:58.75,0:13:59.63,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:14:00.17,0:14:02.55,Default,,0,0,0,,Өлмеген дене және астральды дене
Dialogue: 0,0:14:02.63,0:14:05.38,Default,,0,0,0,,Сонымен бірге, ол ... толығымен бұзады.
Dialogue: 0,0:14:06.42,0:14:09.30,Default,,0,0,0,,Кей Кейунки Ниндзя қылыш!
Dialogue: 0,0:14:16.89,0:14:18.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:18.56,0:14:22.27,Default,,0,0,0,,Үшінші бөлім, Теме сияқты, құдайдың еркелігінің нәтижесі сияқты көрінетін кішігірім рөл.
Dialogue: 0,0:14:22.36,0:14:24.94,Default,,0,0,0,,Өлсең, қайта тірілмейсің.
Dialogue: 0,0:14:25.03,0:14:26.32,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:14:28.57,0:14:31.91,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:14:34.45,0:14:36.29,Default,,0,0,0,,Гала ханым!
Dialogue: 0,0:14:37.83,0:14:42.38,Default,,0,0,0,,Балалар, қалғанын орындаңдар.
Dialogue: 0,0:14:42.88,0:14:44.13,Default,,0,0,0,,Гала ханым!
Dialogue: 0,0:14:44.21,0:14:46.51,Default,,0,0,0,,Жоқ! жүрегім тоқтап қала жаздады
Dialogue: 0,0:14:46.59,0:14:47.76,Default,,0,0,0,,Емдеуге асығыңыз!
Dialogue: 0,0:14:49.22,0:14:51.34,Default,,0,0,0,,Өзін-өзі жапқан құпия қылыш
Dialogue: 0,0:14:51.84,0:14:54.89,Default,,0,0,0,,Мурасаменің бұрынғы иелерімен бірдей болса керек.
Dialogue: 0,0:14:54.97,0:14:57.14,Default,,0,0,0,,Гала-саманың өмірі де осы қылышта...
Dialogue: 0,0:14:59.48,0:15:03.90,Default,,0,0,0,,Лорд Гала өз өмірі үшін Эде-Еді жеңді.
Dialogue: 0,0:15:04.77,0:15:05.44,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:15:05.52,0:15:07.94,Default,,0,0,0,,Азғын болса да, құрметті адам еді.
Dialogue: 0,0:15:08.53,0:15:10.74,Default,,0,0,0,,Жылама! Мен әлі дем алып жатырмын
Dialogue: 0,0:15:10.82,0:15:12.66,Default,,0,0,0,,Мен Гала-сама өледі деп үміттенемін!
Dialogue: 0,0:15:12.74,0:15:15.62,Default,,0,0,0,,Жүр, тезірек Дирк Шнайдер-саманы және Ней-саманы алыңыз!
Dialogue: 0,0:15:15.70,0:15:18.37,Default,,0,0,0,,Жалынның қабырғасы сөніп барады.
Dialogue: 0,0:15:18.45,0:15:20.00,Default,,0,0,0,,Гала-саманың әрекетін босқа өткізбе...
Dialogue: 0,0:15:22.29,0:15:24.08,Default,,0,0,0,,Satan Ring!
Dialogue: 0,0:15:24.17,0:15:27.50,Default,,0,0,0,,Маған қалпына келтіру күшін беріңіз!
Dialogue: 0,0:15:28.01,0:15:30.47,Default,,0,0,0,,Сол құпия қылышты әлі алған жоқпын...
Dialogue: 0,0:15:31.05,0:15:32.93,Default,,0,0,0,,Сен қарғыс атқыр ниндзясың!
Dialogue: 0,0:15:33.01,0:15:35.18,Default,,0,0,0,,Мен адам екен деп сақамды түсірдім.
Dialogue: 0,0:15:35.26,0:15:40.39,Default,,0,0,0,,Мен сізге Ричи Эдидегі шынайы сиқырды көрсетемін!
Dialogue: 0,0:15:41.73,0:15:45.11,Default,,0,0,0,,Оның құдіреттері нағыз адамдардікінен тым бөлек.
Dialogue: 0,0:15:45.19,0:15:47.61,Default,,0,0,0,,Мен саған Гала-самаға тиісуге рұқсат бермеймін!
Dialogue: 0,0:15:47.69,0:15:50.95,Default,,0,0,0,,Құбыжық, егер өлтіргің келсе, бізді өлтір!
Dialogue: 0,0:15:51.03,0:15:51.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:51.86,0:15:54.11,Default,,0,0,0,,You idiots
Dialogue: 0,0:15:54.20,0:15:56.58,Default,,0,0,0,,Қаш! Жүгіріп кету!
Dialogue: 0,0:15:56.66,0:15:58.49,Default,,0,0,0,,Фухахаха!
Dialogue: 0,0:15:58.58,0:15:59.50,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:15:59.58,0:16:01.96,Default,,0,0,0,,Олай болса, өліңдер!
Dialogue: 0,0:16:04.96,0:16:06.84,Default,,0,0,0,,Қалғанын саған қалдырамын.
Dialogue: 0,0:16:06.92,0:16:07.59,Default,,0,0,0,,О!
Dialogue: 0,0:16:07.67,0:16:10.51,Default,,0,0,0,,Бұл Нуе! Бұл Раиджу Нуэ!
Dialogue: 0,0:16:10.59,0:16:11.47,Default,,0,0,0,,Және бұл ...
Dialogue: 0,0:16:11.55,0:16:14.93,Default,,0,0,0,,Oh, you...
Dialogue: 0,0:16:15.01,0:16:17.89,Default,,0,0,0,,Жалын жын Ифрит!
Dialogue: 0,0:16:17.97,0:16:20.02,Default,,0,0,0,,Қараңызшы! Бұл...
Dialogue: 0,0:16:20.10,0:16:21.52,Default,,0,0,0,,Сен менің курткамды ұшырып, мені де ұшырып жібердің ғой!
Dialogue: 0,0:16:21.60,0:16:24.60,Default,,0,0,0,,Ақымақ! Сендер...
Dialogue: 0,0:16:25.10,0:16:27.52,Default,,0,0,0,,Dark Schneider! Ней!
Dialogue: 0,0:16:29.36,0:16:31.40,Default,,0,0,0,,Hey monster!
Dialogue: 0,0:16:31.49,0:16:34.24,Default,,0,0,0,,Мен сені жылатамын!
Dialogue: 0,0:16:34.32,0:16:35.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:35.86,0:16:38.95,Default,,0,0,0,,Дирк Шнайдер-сама мен Ней-сама тірі қалды!
Dialogue: 0,0:16:39.54,0:16:40.83,Default,,0,0,0,,Төменгі еріннің астында, иә, Польнарефф?
Dialogue: 0,0:16:40.91,0:16:43.71,Default,,0,0,0,,Балалар, мұны қалай істейсіңдер?
Dialogue: 0,0:16:43.79,0:16:45.92,Default,,0,0,0,,Ол өліп жатқан болуы керек еді.
Dialogue: 0,0:16:46.42,0:16:48.59,Default,,0,0,0,,Иә, бұл оңай.
Dialogue: 0,0:16:49.21,0:16:52.80,Default,,0,0,0,,Басқа өлшемде дрейф кезінде сиқырлы анықтауды пайдаланыңыз.
Dialogue: 0,0:16:52.88,0:16:57.47,Default,,0,0,0,,Бұрын мен жоғары өлшемге ұшып кеткен екі сиқырлы қылышты шақырдым.
Dialogue: 0,0:16:57.97,0:17:00.97,Default,,0,0,0,,Ал біз, сиқырлы қылыштың сақшылары,
Dialogue: 0,0:17:01.06,0:17:04.02,Default,,0,0,0,,Екеуіңді күшті тосқауылмен қорғау
Dialogue: 0,0:17:04.10,0:17:06.85,Default,,0,0,0,,Мен үйге қайту мүмкіндігін күттім.
Dialogue: 0,0:17:06.94,0:17:08.40,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:17:08.48,0:17:11.44,Default,,0,0,0,,Галадан жеңілген қыз қиналып қайта тырысады.
Dialogue: 0,0:17:11.53,0:17:14.49,Default,,0,0,0,,Шайтан сақинасынан сиқыр тартудың уақыты келді.
Dialogue: 0,0:17:14.57,0:17:17.74,Default,,0,0,0,,Ку... Солай ма!
Dialogue: 0,0:17:17.82,0:17:19.16,Default,,0,0,0,,Gala...
Dialogue: 0,0:17:20.91,0:17:23.54,Default,,0,0,0,,О, сендер қандайсыңдар?
Dialogue: 0,0:17:24.04,0:17:26.21,Default,,0,0,0,,Бұл тез болды, lol
Dialogue: 0,0:17:26.87,0:17:29.54,Default,,0,0,0,,Гала, сен оны пайдаландың ба?
Dialogue: 0,0:17:30.13,0:17:33.51,Default,,0,0,0,,Эй, мен оған қарамай тұрып ұрып кетті.
Dialogue: 0,0:17:34.38,0:17:36.30,Default,,0,0,0,,Бірақ теме жағдайында бұл жақсы
Dialogue: 0,0:17:36.38,0:17:37.84,Default,,0,0,0,,Бұл әрқашан екінші.
Dialogue: 0,0:17:37.93,0:17:39.47,Default,,0,0,0,,Соңғы кездері осы қонақүйдің сапасы сәл төмендеген сияқты…
Dialogue: 0,0:17:40.26,0:17:41.10,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:17:42.31,0:17:42.97,Default,,0,0,0,,Иә
Dialogue: 0,0:17:44.93,0:17:45.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:46.39,0:17:47.31,Default,,0,0,0,,Гала?
Dialogue: 0,0:17:47.90,0:17:50.69,Default,,0,0,0,,Нуоо, ақымақ!
Dialogue: 0,0:17:50.77,0:17:53.28,Default,,0,0,0,,Өзін қауіпсіз сезінуге әлі ерте.
Dialogue: 0,0:17:53.36,0:17:57.74,Default,,0,0,0,,Менің күшім қазір бұрынғыдан 100 есе артық!
Dialogue: 0,0:17:57.82,0:18:02.20,Default,,0,0,0,,Ен У мен басқалары жиналса да, біз ештеңе істей алмаймыз.
Dialogue: 0,0:18:02.28,0:18:07.04,Default,,0,0,0,,Мен сізге адамдардың дәрменсіздігі туралы көбірек хабардар етемін!
Dialogue: 0,0:18:09.63,0:18:13.17,Default,,0,0,0,,Сен ұсқынсыз құбыжық
Dialogue: 0,0:18:13.25,0:18:18.01,Default,,0,0,0,,Менің әлсіз ініме ауыр жұмыс істеген сияқтысың.
Dialogue: 0,0:18:19.84,0:18:22.10,Default,,0,0,0,,Мен сені кешірмеймін!
Dialogue: 0,0:18:28.06,0:18:33.40,Default,,0,0,0,,Әлсіз адам мені ренжіте ала ма?
Dialogue: 0,0:18:33.48,0:18:35.03,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:18:35.98,0:18:38.65,Default,,0,0,0,,Мен бұл ақымақтықтан шаршадым.
Dialogue: 0,0:18:38.74,0:18:39.40,Default,,0,0,0,,Ой~!
Dialogue: 0,0:18:42.95,0:18:44.33,Default,,0,0,0,,Қалғанын саған қалдырамын.
Dialogue: 0,0:18:47.70,0:18:53.09,Default,,0,0,0,,Әй, өлмеген түріңіз сізді алдамасын.
Dialogue: 0,0:18:54.38,0:18:57.97,Default,,0,0,0,,Мен Дарк Шнайдермін!
Dialogue: 0,0:18:58.55,0:19:02.72,Default,,0,0,0,,Және... тағы бір қадам, Шайтанның барлық сақиналары.
Dialogue: 0,0:19:02.80,0:19:06.81,Default,,0,0,0,,Сол Абигейл мені...
Dialogue: 0,0:19:07.39,0:19:12.81,Default,,0,0,0,,Егер менде осы болса, менде өте күшті сиқырлы күшейткіш болса
Dialogue: 0,0:19:12.90,0:19:18.94,Default,,0,0,0,,Жоюшы құдайдан әлдеқайда жоғары «бұл күштің» құпиясы шешілді…
Dialogue: 0,0:19:19.03,0:19:19.74,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:20.70,0:19:23.20,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:19:23.28,0:19:25.28,Default,,0,0,0,,Қандай құбыжық!
Dialogue: 0,0:19:25.37,0:19:28.00,Default,,0,0,0,,Тезірек жоғалып кет!
Dialogue: 0,0:19:28.08,0:19:31.92,Default,,0,0,0,,Қалғанын саған қалдырамын.
Dialogue: 0,0:19:36.67,0:19:38.42,Default,,0,0,0,,Ооо!
Dialogue: 0,0:19:38.51,0:19:40.42,Default,,0,0,0,,Қараңғылық ашылады
Dialogue: 0,0:19:40.51,0:19:41.59,Default,,0,0,0,,Қазіргі жасыңда мәңгі қалу—
Dialogue: 0,0:19:44.93,0:19:45.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:47.60,0:19:48.43,Default,,0,0,0,,Гала...
Dialogue: 0,0:19:55.36,0:19:56.19,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:56.77,0:19:57.65,Default,,0,0,0,,Өтірік
Dialogue: 0,0:19:58.57,0:20:02.11,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:04.41,0:20:06.03,Default,,0,0,0,,Мен Ричи жасадым
Dialogue: 0,0:20:07.08,0:20:09.87,Default,,0,0,0,,Гала, жатқан жерің жайлы.
Dialogue: 0,0:20:11.91,0:20:14.42,Default,,0,0,0,,Ниндзя жауынгерінің гала қоштасуы
Dialogue: 0,0:20:14.92,0:20:19.55,Default,,0,0,0,,Біз сенің тамсандырған батыр тұлғаңды ешқашан ұмытпаймыз.
Dialogue: 0,0:20:21.51,0:20:22.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:22.72,0:20:23.63,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:20:24.55,0:20:25.84,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:20:25.93,0:20:28.93,Default,,0,0,0,,Сәлем! Күте тұрыңыз, бейбақ!
Dialogue: 0,0:20:29.01,0:20:32.39,Default,,0,0,0,,Өз монологыңды жазып, мені өлтірме!
Dialogue: 0,0:20:32.94,0:20:34.35,Default,,0,0,0,,О... Әй?
Dialogue: 0,0:20:34.44,0:20:35.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:36.10,0:20:39.32,Default,,0,0,0,,Гала-сама~!
Dialogue: 0,0:20:40.03,0:20:41.40,Default,,0,0,0,,Пульс... Импульс дегеніміз не?
Dialogue: 0,0:20:41.49,0:20:42.78,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:20:42.86,0:20:46.57,Default,,0,0,0,,Егер сіз аузыңызды жауып, тыңдасаңыз, сіз бір ақымақ көшірмеге қуанасыз!
Dialogue: 0,0:20:46.66,0:20:50.04,Default,,0,0,0,,«Қош болыңыз! Ал рахмет» деген не?
Dialogue: 0,0:20:50.12,0:20:50.79,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:50.87,0:20:52.87,Default,,0,0,0,,Ал, мен сенен сұрайын.
Dialogue: 0,0:20:52.96,0:20:53.66,Default,,0,0,0,,Мурасамеде
Dialogue: 0,0:20:53.75,0:20:55.08,Default,,0,0,0,,Кейун Нандара қылышын қолдансаңыз не істеу керек
Dialogue: 0,0:20:55.17,0:20:57.42,Default,,0,0,0,,Өмірің сорғаланып, өлдің емес пе?
Dialogue: 0,0:20:57.50,0:20:59.29,Default,,0,0,0,,Иә? Өте әсерлі!
Dialogue: 0,0:20:59.38,0:21:00.84,Default,,0,0,0,,Қайтарыңыз! бұл мен
Dialogue: 0,0:21:00.92,0:21:01.55,Default,,0,0,0,,An!
Dialogue: 0,0:21:02.17,0:21:02.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:03.59,0:21:05.97,Default,,0,0,0,,Мм... әрине.
Dialogue: 0,0:21:07.14,0:21:10.31,Default,,0,0,0,,Мен Keiunki Ninja семсерін бірінші рет пайдаландым
Dialogue: 0,0:21:10.39,0:21:13.98,Default,,0,0,0,,Мұрасаме жанымды сорып жатқандай болды.
Dialogue: 0,0:21:15.02,0:21:18.23,Default,,0,0,0,,Бірақ екінші рет, керісінше...
Dialogue: 0,0:21:19.19,0:21:22.82,Default,,0,0,0,,Мурасаме маған біраз күш берген сияқты...
Dialogue: 0,0:21:24.36,0:21:29.28,Default,,0,0,0,,Ендеше, әлсіреген астың кім, бейбақ!
Dialogue: 0,0:21:29.37,0:21:32.08,Default,,0,0,0,,Мен қашаннан бастап саған шәкірт болдым? а?
Dialogue: 0,0:21:32.16,0:21:33.08,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:21:33.16,0:21:34.29,Default,,0,0,0,,Бұл ұқсас емес пе?
Dialogue: 0,0:21:34.37,0:21:35.58,Default,,0,0,0,,Андато?
Dialogue: 0,0:21:37.62,0:21:40.96,Default,,0,0,0,,Қалай болғанда да, Ричидің соңғы сөзі
Dialogue: 0,0:21:41.67,0:21:44.30,Default,,0,0,0,,Жоюшы Құдайдан асып түсетін «бұл күш» дегеніміз не?
Dialogue: 0,0:21:45.30,0:21:47.88,Default,,0,0,0,,Эде-Е, оның астральды денесі бар,
Dialogue: 0,0:21:47.97,0:21:51.56,Default,,0,0,0,,Сіз одан да көп алғыңыз келетін күш...?
Dialogue: 0,0:21:52.64,0:21:53.56,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:54.10,0:21:57.77,Default,,0,0,0,,Бұл 15 жыл бұрын...
Dialogue: 0,0:21:59.94,0:22:01.94,Default,,0,0,0,,♪～
Dialogue: 0,0:22:04.78,0:22:05.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:06.65,0:22:08.16,Default,,0,0,0,,Бұл бұлыңғырлық~!
Dialogue: 0,0:22:08.24,0:22:12.16,Default,,0,0,0,,Мен сенің сиқырыңды қашан білдім? Чара хара тойо~
Dialogue: 0,0:22:12.24,0:22:13.41,Default,,0,0,0,,Қандай сегізаяқ!
Dialogue: 0,0:22:13.49,0:22:15.37,Default,,0,0,0,,Мен құтқарушымын!
Dialogue: 0,0:22:15.45,0:22:18.37,Default,,0,0,0,,Бұл сызық, маймыл!
Dialogue: 0,0:22:21.00,0:22:23.00,Default,,0,0,0,,～♪
Dialogue: 0,0:22:23.09,0:22:24.42,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.46,0:23:46.46,Default,,0,0,0,,～♪
