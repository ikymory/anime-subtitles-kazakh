Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.96,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:14.30,0:00:15.34,Default,,0,0,0,,Не?
Dialogue: 0,0:00:15.84,0:00:19.39,Default,,0,0,0,,Жақсылыққа не болды? Жамандық деген не?
Dialogue: 0,0:00:19.47,0:00:20.39,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:00:20.47,0:00:24.64,Default,,0,0,0,,Бұл мен үшін тіпті түкке тұрғысыз!
Dialogue: 0,0:00:24.73,0:00:26.56,Default,,0,0,0,,Жақсы ма? Жаман ба?
Dialogue: 0,0:00:26.65,0:00:30.15,Default,,0,0,0,,Мұндай уәденің ерлердің төбелесуіне қатысы бар ма?
Dialogue: 0,0:00:30.23,0:00:31.78,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:00:31.86,0:00:34.65,Default,,0,0,0,,Өлуің керек!
Dialogue: 0,0:00:34.74,0:00:37.53,Default,,0,0,0,,Абигейл Колледер!
Dialogue: 0,0:00:37.62,0:00:39.74,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:00:39.83,0:00:41.75,Default,,0,0,0,,Экс-Зордус!
Dialogue: 0,0:00:42.87,0:00:44.08,Default,,0,0,0,,Ухаха!
Dialogue: 0,0:00:44.16,0:00:45.50,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:00:45.58,0:00:50.30,Default,,0,0,0,,Омеганың сауыты сиқырды толығымен бөгеп тұрғанын көрмейсің бе?
Dialogue: 0,0:00:50.38,0:00:54.22,Default,,0,0,0,,Құрыштың мінсіз екеніне сенімдімін, Абигейл!
Dialogue: 0,0:00:54.30,0:00:55.38,Default,,0,0,0,,Бірақ сәлем
Dialogue: 0,0:00:55.47,0:00:59.39,Default,,0,0,0,,Одан басқа, өте нәзік көрінеді, солай емес пе?
Dialogue: 0,0:00:59.47,0:01:02.43,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:01:02.52,0:01:04.48,Default,,0,0,0,,Ақылсыз!
Dialogue: 0,0:01:04.56,0:01:08.65,Default,,0,0,0,,Сен жынды баласың!
Dialogue: 0,0:01:11.73,0:01:15.99,Default,,0,0,0,,Нуаа!
Dialogue: 0,0:01:18.62,0:01:19.70,Default,,0,0,0,,Иә
Dialogue: 0,0:01:21.70,0:01:22.74,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:31.67,0:01:32.71,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:33.21,0:01:33.84,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:36.22,0:01:39.30,Default,,0,0,0,,Жоқ, Дарш!
Dialogue: 0,0:01:39.80,0:01:43.14,Default,,0,0,0,,Дирк Шнайдер Эй...
Dialogue: 0,0:01:43.22,0:01:46.14,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:01:46.23,0:01:47.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:47.10,0:01:47.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:55.61,0:01:57.74,Default,,0,0,0,,Хе, Құдай...
Dialogue: 0,0:02:00.74,0:02:02.74,Default,,0,0,0,,Эй, сен жылап тұрсың ба?
Dialogue: 0,0:02:02.83,0:02:03.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:04.66,0:02:06.50,Default,,0,0,0,,Йоко саған өзінің пәктігін береді.
Dialogue: 0,0:02:06.58,0:02:07.71,Default,,0,0,0,,Сіз маған...
Dialogue: 0,0:02:07.79,0:02:08.37,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:08.96,0:02:10.79,Default,,0,0,0,,Ондай ештеңе жоқ!
Dialogue: 0,0:02:11.96,0:02:14.88,Default,,0,0,0,,Уф... өте өкінішті!
Dialogue: 0,0:02:14.96,0:02:15.88,Default,,0,0,0,,Ашық!
Dialogue: 0,0:02:15.96,0:02:18.05,Default,,0,0,0,,Сіз және Абигейл
Dialogue: 0,0:02:18.13,0:02:19.38,Default,,0,0,0,,Өлгенім жақсы болар еді!
Dialogue: 0,0:02:19.47,0:02:21.55,Default,,0,0,0,,Уау, кешіріңіз!
Dialogue: 0,0:02:21.64,0:02:22.51,Default,,0,0,0,,Хмм…
Dialogue: 0,0:02:24.81,0:02:25.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:26.27,0:02:27.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:31.10,0:02:31.81,Default,,0,0,0,,Не!
Dialogue: 0,0:02:32.98,0:02:36.36,Default,,0,0,0,,Сәлем, Абигейл!
Dialogue: 0,0:02:38.11,0:02:40.66,Default,,0,0,0,,Эй, сен тірі ме едің?
Dialogue: 0,0:02:42.28,0:02:45.24,Default,,0,0,0,,Ақымақ... Бұл қорқынышты түс пе?
Dialogue: 0,0:02:45.95,0:02:48.50,Default,,0,0,0,,Хи хи
Dialogue: 0,0:02:49.00,0:02:53.42,Default,,0,0,0,,Ku! Ух...хаа...
Dialogue: 0,0:02:53.50,0:02:55.88,Default,,0,0,0,,Оны бұлай қалдырмаңыз.
Dialogue: 0,0:02:55.96,0:02:58.38,Default,,0,0,0,,Мен барлығын ұстап тұрмын
Dialogue: 0,0:02:58.46,0:03:01.09,Default,,0,0,0,,Ку… уф
Dialogue: 0,0:03:01.18,0:03:03.97,Default,,0,0,0,,Йоко!
Dialogue: 0,0:03:04.51,0:03:06.22,Default,,0,0,0,,♪～
Dialogue: 0,0:04:31.89,0:04:33.89,Default,,0,0,0,,～♪
Dialogue: 0,0:04:36.19,0:04:37.56,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:04:37.65,0:04:42.32,Default,,0,0,0,,Мүлде мүмкін емес нәрсе болды.
Dialogue: 0,0:04:42.40,0:04:46.20,Default,,0,0,0,,... Ібіліс сойыл Шайтан сақинасы
Dialogue: 0,0:04:46.28,0:04:48.62,Default,,0,0,0,,Үш сиқырлы аспап бойынша -
Dialogue: 0,0:04:48.70,0:04:52.83,Default,,0,0,0,,Мен керемет сиқырлы пішінді жеңе алатын адам бар ма деп ойлаймын...
Dialogue: 0,0:04:53.50,0:04:56.54,Default,,0,0,0,,А, бұл қорқынышты.
Dialogue: 0,0:04:57.13,0:05:00.96,Default,,0,0,0,,Сіз керемет адамсыз Дирк Шнайдер
Dialogue: 0,0:05:01.50,0:05:05.43,Default,,0,0,0,,Мен сізді аздап бағаламаған сияқтымын.
Dialogue: 0,0:05:05.51,0:05:07.39,Default,,0,0,0,,Сәлем, Абигейл!
Dialogue: 0,0:05:07.47,0:05:09.51,Default,,0,0,0,,Сіздің жеңу мүмкіндігіңіз жоқ.
Dialogue: 0,0:05:10.10,0:05:12.72,Default,,0,0,0,,Күресуді тоқтатыңыз және есегіңізді жауып тастаңыз!
Dialogue: 0,0:05:13.35,0:05:15.94,Default,,0,0,0,,Тіпті Дарш соғыса алмаса да
Dialogue: 0,0:05:16.02,0:05:20.06,Default,,0,0,0,,Аспандағы Төрт патшаның екеуімен бетпе-бет келсең, міндетті түрде өлесің!
Dialogue: 0,0:05:20.15,0:05:21.27,Default,,0,0,0,,Иә
Dialogue: 0,0:05:21.90,0:05:25.53,Default,,0,0,0,,Қазіргі жағдайды дәл түсінетін жалғыз адам болса керек
Dialogue: 0,0:05:25.61,0:05:28.99,Default,,0,0,0,,Мен және Дирк Шнайдер ғана сияқты.
Dialogue: 0,0:05:29.07,0:05:30.12,Default,,0,0,0,,Не?
Dialogue: 0,0:05:30.66,0:05:31.62,Default,,0,0,0,,Ней
Dialogue: 0,0:05:31.70,0:05:36.16,Default,,0,0,0,,Бұрын менімен болған шайқаста сіз бірнеше қабырғаңызды сындырдыңыз.
Dialogue: 0,0:05:36.25,0:05:39.50,Default,,0,0,0,,Сондай-ақ, сіз өзіңіздің сиқырлы күшіңіздің шегіне жақындайсыз.
Dialogue: 0,0:05:39.58,0:05:40.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:40.29,0:05:42.17,Default,,0,0,0,,және гала
Dialogue: 0,0:05:42.25,0:05:46.92,Default,,0,0,0,,Сіз Ричимен жекпе-жекте басым қолыңыздың байламын зақымдадыңыз.
Dialogue: 0,0:05:47.01,0:05:49.80,Default,,0,0,0,,Бірнеше ішкі ағзалары жарылған.
Dialogue: 0,0:05:49.89,0:05:50.55,Default,,0,0,0,,Қу!
Dialogue: 0,0:05:50.64,0:05:52.22,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:05:52.31,0:05:57.60,Default,,0,0,0,,Күшті болуға талпынсаң да, күресу былай тұрсын, әрең тұрасың.
Dialogue: 0,0:05:57.69,0:06:00.48,Default,,0,0,0,,Және Дирк Шнайдер
Dialogue: 0,0:06:00.56,0:06:04.11,Default,,0,0,0,,Сенің ең үлкен әлсіздігің менің қолымда.
Dialogue: 0,0:06:04.82,0:06:08.11,Default,,0,0,0,,Бас діни қызметкердің қызы Жыртатын жазба Йоко!
Dialogue: 0,0:06:08.20,0:06:09.41,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:06:09.49,0:06:13.28,Default,,0,0,0,,Сіз және сіздің үй иесі Люс Ренрен.
Dialogue: 0,0:06:13.37,0:06:15.50,Default,,0,0,0,,Менің сүйікті қызым!
Dialogue: 0,0:06:15.58,0:06:17.12,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:06:17.21,0:06:18.54,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:06:18.62,0:06:20.00,Default,,0,0,0,,Тор!
Dialogue: 0,0:06:21.04,0:06:22.46,Default,,0,0,0,,Арх! Ха!
Dialogue: 0,0:06:23.67,0:06:24.46,Default,,0,0,0,,Дарш!
Dialogue: 0,0:06:24.55,0:06:26.42,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:06:26.51,0:06:28.67,Default,,0,0,0,,Қозғалмаңыз!
Dialogue: 0,0:06:28.76,0:06:31.47,Default,,0,0,0,,Бұл әйелге не болу керек?
Dialogue: 0,0:06:31.55,0:06:33.76,Default,,0,0,0,,Қарғыс атсын, лас болма!
Dialogue: 0,0:06:34.81,0:06:38.60,Default,,0,0,0,,Рахмет, бұл ең жақсы комплимент.
Dialogue: 0,0:06:40.27,0:06:41.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:41.73,0:06:42.86,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:42.94,0:06:45.07,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:06:45.15,0:06:47.15,Default,,0,0,0,,Ней мырза! Гала!
Dialogue: 0,0:06:47.74,0:06:49.40,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:06:49.49,0:06:52.62,Default,,0,0,0,,Ойынды сол жерде тыныш бақылаңыз.
Dialogue: 0,0:06:52.70,0:06:54.37,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:06:54.45,0:06:56.83,Default,,0,0,0,,О, бұл жақсы дауыс.
Dialogue: 0,0:06:56.91,0:06:58.83,Default,,0,0,0,,Қандай тамаша ыңырсыған.
Dialogue: 0,0:06:58.91,0:07:00.46,Default,,0,0,0,,Бұл адам емес!
Dialogue: 0,0:07:00.54,0:07:02.83,Default,,0,0,0,,Неге мұндай сұмдық жасайсың?
Dialogue: 0,0:07:02.92,0:07:04.54,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:04.63,0:07:08.76,Default,,0,0,0,,Осыншама адамды қинап, ештеңені ойламайсыз ба?
Dialogue: 0,0:07:09.80,0:07:10.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:11.63,0:07:14.55,Default,,0,0,0,,Хехехе... Мен оны жиі көремін.
Dialogue: 0,0:07:15.18,0:07:19.27,Default,,0,0,0,,Ақымақ адамдардың үмітсіздік пен азаптың зары
Dialogue: 0,0:07:19.35,0:07:25.40,Default,,0,0,0,,Бұл менің құдайыма, жойылу құдайы Антрасаксқа ең жақсы сый.
Dialogue: 0,0:07:25.48,0:07:27.98,Default,,0,0,0,,Әдемі жас ханым
Dialogue: 0,0:07:29.86,0:07:31.70,Default,,0,0,0,,Сәлем, Люс!
Dialogue: 0,0:07:31.78,0:07:33.78,Default,,0,0,0,,Мына жігітті жең!
Dialogue: 0,0:07:33.87,0:07:36.24,Default,,0,0,0,,Мен үшін уайымдама, төбелес!
Dialogue: 0,0:07:36.33,0:07:37.20,Default,,0,0,0,,Құт
Dialogue: 0,0:07:37.29,0:07:41.04,Default,,0,0,0,,Не болды? Сіз аңызға айналған жынсыз!
Dialogue: 0,0:07:41.12,0:07:44.21,Default,,0,0,0,,Тіпті Абигейл де қазіргі шайқастан шаршады.
Dialogue: 0,0:07:44.29,0:07:46.75,Default,,0,0,0,,Оны жеңе алатын жалғыз уақыт - қазір!
Dialogue: 0,0:07:48.38,0:07:52.13,Default,,0,0,0,,Бұл жер жұмақ емес, бірақ
Dialogue: 0,0:07:52.22,0:07:57.18,Default,,0,0,0,,Бірақ дәл қазір көптеген адамдар мен жаратылыстар толық өмір сүруде.
Dialogue: 0,0:07:57.93,0:08:00.73,Default,,0,0,0,,Жою Құдайын қайта тірілту мүлдем жақсы емес.
Dialogue: 0,0:08:00.81,0:08:02.60,Default,,0,0,0,,Өтінемін, Люс!
Dialogue: 0,0:08:02.69,0:08:04.85,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:08:05.40,0:08:06.27,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:11.03,0:08:12.11,Default,,0,0,0,,Йоко…
Dialogue: 0,0:08:16.78,0:08:17.58,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:18.66,0:08:19.95,Default,,0,0,0,,Иә
Dialogue: 0,0:08:20.62,0:08:24.29,Default,,0,0,0,,Бұл жас келіншек жағдайды бәрінен де жақсы түсінетін сияқты.
Dialogue: 0,0:08:24.37,0:08:26.50,Default,,0,0,0,,Егер сіз бір рет болған болсаңыз
Dialogue: 0,0:08:26.58,0:08:30.88,Default,,0,0,0,,Ол ойланбастан пышағын маған бағыттап тұрған шығар.
Dialogue: 0,0:08:32.42,0:08:34.13,Default,,0,0,0,,дәл қазір менің алдымда тұр!
Dialogue: 0,0:08:34.22,0:08:39.10,Default,,0,0,0,,Адамның әлсіз тұстары болған кезде сіз қалай сезінесіз?
Dialogue: 0,0:08:39.60,0:08:40.93,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:41.02,0:08:44.81,Default,,0,0,0,,Мен қазір қызымды бұл жігітке тастай алмаймын.
Dialogue: 0,0:08:44.89,0:08:45.69,Default,,0,0,0,,Құт
Dialogue: 0,0:08:46.52,0:08:47.48,Default,,0,0,0,,Дарш
Dialogue: 0,0:08:48.27,0:08:49.44,Default,,0,0,0,,Бас діни қызметкер!
Dialogue: 0,0:08:50.86,0:08:52.07,Default,,0,0,0,,Мен көмектесе алмаймын
Dialogue: 0,0:08:52.69,0:08:57.62,Default,,0,0,0,,Мен қызымның өміріне бүкіл әлемнің тағдырын айырбастай алмаймын.
Dialogue: 0,0:08:57.70,0:08:58.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:59.33,0:09:02.45,Default,,0,0,0,,Мен үшін уайымдама, тек күрес!
Dialogue: 0,0:09:02.54,0:09:04.08,Default,,0,0,0,,Люс!
Dialogue: 0,0:09:04.16,0:09:04.79,Default,,0,0,0,,Ах
Dialogue: 0,0:09:04.87,0:09:07.17,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:09:07.25,0:09:08.96,Default,,0,0,0,,Сіз әлі қозғала алмайсыз ба?
Dialogue: 0,0:09:09.04,0:09:10.25,Default,,0,0,0,,Тор!
Dialogue: 0,0:09:10.34,0:09:10.96,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:12.00,0:09:12.63,Default,,0,0,0,,Ga!
Dialogue: 0,0:09:12.71,0:09:13.51,Default,,0,0,0,,Дарш!
Dialogue: 0,0:09:13.59,0:09:14.80,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:09:19.01,0:09:20.39,Default,,0,0,0,,Люс!
Dialogue: 0,0:09:22.81,0:09:25.27,Default,,0,0,0,,Да Дирк Шнайдер...
Dialogue: 0,0:09:25.35,0:09:26.44,Default,,0,0,0,,Ах~
Dialogue: 0,0:09:26.94,0:09:29.56,Default,,0,0,0,,Ақымақ! не істеп жатырсың
Dialogue: 0,0:09:29.65,0:09:30.90,Default,,0,0,0,,Күресейік!
Dialogue: 0,0:09:30.98,0:09:36.11,Default,,0,0,0,,Сіздің ойыңызша, не маңыздырақ, бүкіл дүние ме, әлде бір қыздың өмірі ме?
Dialogue: 0,0:09:38.95,0:09:40.07,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:41.24,0:09:42.24,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:43.12,0:09:45.29,Default,,0,0,0,,Ол әйел жақсырақ
Dialogue: 0,0:09:51.09,0:09:53.05,Default,,0,0,0,,Бүкіл әлемнен артық
Dialogue: 0,0:09:54.09,0:09:55.84,Default,,0,0,0,,Әлгі әйел...
Dialogue: 0,0:09:56.80,0:09:58.30,Default,,0,0,0,,Йоко...
Dialogue: 0,0:09:59.80,0:10:02.35,Default,,0,0,0,,Боб I...
Dialogue: 0,0:10:04.31,0:10:06.35,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:10:06.43,0:10:07.39,Default,,0,0,0,,Иә
Dialogue: 0,0:10:08.02,0:10:09.56,Default,,0,0,0,,Махаббат деген не?
Dialogue: 0,0:10:09.65,0:10:13.86,Default,,0,0,0,,Махаббат деген неткен ақымақ сезім!
Dialogue: 0,0:10:14.36,0:10:17.78,Default,,0,0,0,,Махаббат байланыстырады және әлсіретеді
Dialogue: 0,0:10:17.86,0:10:19.86,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:10:19.95,0:10:23.66,Default,,0,0,0,,Сіз енді аңызға айналған жын немесе басқа нәрсе емессіз.
Dialogue: 0,0:10:23.74,0:10:26.45,Default,,0,0,0,,Ақымақ пен әлсіз, жай ғана адам.
Dialogue: 0,0:10:26.54,0:10:27.20,Default,,0,0,0,,Құт
Dialogue: 0,0:10:27.75,0:10:29.75,Default,,0,0,0,,Жүр, айқайла!
Dialogue: 0,0:10:29.83,0:10:33.42,Default,,0,0,0,,Өлім қорқынышынан қорқып, Ауырсынған
Dialogue: 0,0:10:33.50,0:10:36.13,Default,,0,0,0,,Сол айқай, соңғы айқай
Dialogue: 0,0:10:36.21,0:10:38.05,Default,,0,0,0,,Оны Жоюшы Құдайға ұсыныңыз!
Dialogue: 0,0:10:38.13,0:10:38.92,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:39.55,0:10:40.84,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:10:41.84,0:10:43.10,Default,,0,0,0,,Люс...
Dialogue: 0,0:10:44.43,0:10:47.31,Default,,0,0,0,,Уф… уф… ку
Dialogue: 0,0:10:47.39,0:10:49.64,Default,,0,0,0,,Тор…
Dialogue: 0,0:10:51.90,0:10:52.90,Default,,0,0,0,,На
Dialogue: 0,0:10:52.98,0:10:54.19,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:54.27,0:10:55.36,Default,,0,0,0,,Шикигумо!
Dialogue: 0,0:10:57.28,0:10:59.36,Default,,0,0,0,,Ku! Жоқ.
Dialogue: 0,0:10:59.45,0:11:01.11,Default,,0,0,0,,Махаббат үшін...
Dialogue: 0,0:11:01.20,0:11:05.12,Default,,0,0,0,,Адамдар шексіз күшті бола алады! иә?
Dialogue: 0,0:11:05.83,0:11:06.95,Default,,0,0,0,,Ga!
Dialogue: 0,0:11:09.12,0:11:10.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:10.75,0:11:12.54,Default,,0,0,0,,Сіз...
Dialogue: 0,0:11:12.63,0:11:14.34,Default,,0,0,0,,Кай Хан!
Dialogue: 0,0:11:15.46,0:11:16.96,Default,,0,0,0,,Шон Хари!
Dialogue: 0,0:11:17.46,0:11:19.97,Default,,0,0,0,,Ней мырза, кешіккенім үшін кешіріңіз.
Dialogue: 0,0:11:20.76,0:11:21.38,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:23.43,0:11:26.31,Default,,0,0,0,,Шон Хари Неге мұнда?
Dialogue: 0,0:11:26.39,0:11:27.47,Default,,0,0,0,,Анықталды
Dialogue: 0,0:11:28.10,0:11:30.18,Default,,0,0,0,,Ней-саманы қорғау үшін!
Dialogue: 0,0:11:31.31,0:11:33.90,Default,,0,0,0,,Дұрыс, бұл Кидо Санниншу!
Dialogue: 0,0:11:33.98,0:11:35.40,Default,,0,0,0,,Ку… га!
Dialogue: 0,0:11:35.48,0:11:38.57,Default,,0,0,0,,Қабыл ал! Йогеки Хьякуреза!
Dialogue: 0,0:11:41.03,0:11:43.11,Default,,0,0,0,,Үстел өзгерді, Абигейл.
Dialogue: 0,0:11:43.20,0:11:46.08,Default,,0,0,0,,Ну...нуууу
Dialogue: 0,0:11:46.74,0:11:48.08,Default,,0,0,0,,Абигейл!
Dialogue: 0,0:11:48.16,0:11:52.71,Default,,0,0,0,,Үш сиқырлы құрылғыны басқару арқылы сіз сиқырлы Пауэрдің көп бөлігін жұмсауыңыз керек еді.
Dialogue: 0,0:11:52.79,0:11:54.96,Default,,0,0,0,,Егер сіз әлі де ұрысқыңыз келсе...
Dialogue: 0,0:11:55.04,0:11:56.67,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:11:56.75,0:11:58.92,Default,,0,0,0,,Ku! Не болды?
Dialogue: 0,0:11:59.63,0:12:02.47,Default,,0,0,0,,Шынында да, сіз айтқандай
Dialogue: 0,0:12:02.55,0:12:07.64,Default,,0,0,0,,Мен сиқырымның және физикалық күшімнің көп бөлігін жұмсадым.
Dialogue: 0,0:12:07.72,0:12:11.68,Default,,0,0,0,,Бірақ менің Шатырдың төсі
Dialogue: 0,0:12:11.77,0:12:15.98,Default,,0,0,0,,Оған сібір жарасының жойылу құдайының ұлпа жасушалары ендірілген.
Dialogue: 0,0:12:16.06,0:12:16.86,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:16.94,0:12:19.32,Default,,0,0,0,,Ха, жойылу Құдайы...
Dialogue: 0,0:12:19.40,0:12:21.49,Default,,0,0,0,,Ұлпа жасушалары ше?
Dialogue: 0,0:12:21.57,0:12:24.32,Default,,0,0,0,,Жою құдайы ұлпа жасушаларынан шығады.
Dialogue: 0,0:12:24.41,0:12:26.20,Default,,0,0,0,,Сарқылмайтын энергия
Dialogue: 0,0:12:26.28,0:12:27.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:27.41,0:12:33.33,Default,,0,0,0,,Егер сіз мұны қолдансаңыз, мұндай нәрсе де мүмкін.
Dialogue: 0,0:12:39.84,0:12:41.51,Default,,0,0,0,,(Үру)
Dialogue: 0,0:12:41.59,0:12:43.47,Default,,0,0,0,,Ku! Не!
Dialogue: 0,0:12:51.02,0:12:51.85,Default,,0,0,0,,Агия
Dialogue: 0,0:12:51.93,0:12:54.56,Default,,0,0,0,,Әй, бұл Өлім Рыцарь!
Dialogue: 0,0:12:54.64,0:12:57.15,Default,,0,0,0,,Сәлем! Бұл не?
Dialogue: 0,0:12:57.23,0:12:59.27,Default,,0,0,0,,Қандай сан!
Dialogue: 0,0:12:59.36,0:13:03.24,Default,,0,0,0,,Ей, бұл жойқын Құдайдың құдіреті.
Dialogue: 0,0:13:04.15,0:13:06.20,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:13:06.28,0:13:08.66,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:13:08.74,0:13:12.62,Default,,0,0,0,,Кәне, жер асты әлемінің рыцарлары!
Dialogue: 0,0:13:13.29,0:13:16.96,Default,,0,0,0,,Бұл қамал елдегі барлық жандарды алып кетеді.
Dialogue: 0,0:13:17.04,0:13:21.17,Default,,0,0,0,,Бұл жойылу құдайы Антрасаксқа тарту болады!
Dialogue: 0,0:13:21.67,0:13:23.17,Default,,0,0,0,,Хмм!
Dialogue: 0,0:13:23.67,0:13:25.63,Default,,0,0,0,,Ә? Бөлме…
Dialogue: 0,0:13:26.76,0:13:30.68,Default,,0,0,0,,Абигейлдің бейбақ!
Dialogue: 0,0:13:37.73,0:13:40.82,Default,,0,0,0,,Жүріңдер, жер асты әлемінің рыцарлары!
Dialogue: 0,0:13:40.90,0:13:43.11,Default,,0,0,0,,Бәрінен асып түседі.
Dialogue: 0,0:13:43.19,0:13:44.69,Default,,0,0,0,,Жақсы тіл табысайық, иә?
Dialogue: 0,0:13:44.78,0:13:48.45,Default,,0,0,0,,Тек Металликана ханшайымы Шейла Тоэль
Dialogue: 0,0:13:48.53,0:13:50.87,Default,,0,0,0,,Онымен араласпаңыз
Dialogue: 0,0:13:50.95,0:13:52.03,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:13:52.12,0:13:54.75,Default,,0,0,0,,Оның ішіндегі мөрді ашыңыз
Dialogue: 0,0:13:54.83,0:14:00.17,Default,,0,0,0,,Біз жойылу Құдайын оятуымыз керек, Антрасакс.
Dialogue: 0,0:14:00.25,0:14:02.38,Default,,0,0,0,,Дарш көріністі сұраңыз
Dialogue: 0,0:14:02.46,0:14:03.67,Default,,0,0,0,,Иә, Ней мырза!
Dialogue: 0,0:14:03.75,0:14:06.67,Default,,0,0,0,,Олай болса, жабайы жүрейік!
Dialogue: 0,0:14:07.59,0:14:08.43,Default,,0,0,0,,Қу!
Dialogue: 0,0:14:09.68,0:14:10.39,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:11.97,0:14:16.18,Default,,0,0,0,,Сүйегім сынса да, Сиқырлы Пауэрім бітсе де
Dialogue: 0,0:14:16.77,0:14:19.06,Default,,0,0,0,,Мен саған Даршты бір саусақпен ұстауға рұқсат бермеймін!
Dialogue: 0,0:14:22.73,0:14:24.90,Default,,0,0,0,,(Үру)
Dialogue: 0,0:14:24.98,0:14:28.40,Default,,0,0,0,,Ооо!
Dialogue: 0,0:14:30.99,0:14:32.91,Default,,0,0,0,,Хауракен стиліндегі Кенпо құпия техникасы
Dialogue: 0,0:14:32.99,0:14:35.24,Default,,0,0,0,,Айдаһардың соққысы Ракшасаның қиғаш соққысы!
Dialogue: 0,0:14:36.62,0:14:37.79,Default,,0,0,0,,Уау
Dialogue: 0,0:14:37.87,0:14:40.08,Default,,0,0,0,,Сіз жасайсыз, апа.
Dialogue: 0,0:14:40.75,0:14:41.38,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:41.46,0:14:44.59,Default,,0,0,0,,Гала, ол жерден кет.
Dialogue: 0,0:14:45.92,0:14:48.17,Default,,0,0,0,,О? Эй, эй
Dialogue: 0,0:14:48.26,0:14:49.30,Default,,0,0,0,,Құпия техника!
Dialogue: 0,0:14:49.38,0:14:52.89,Default,,0,0,0,,Жоғарғы Патша қылышының найзағай соғуы таңқаларлық тырнақ соққысы!
Dialogue: 0,0:14:52.97,0:14:55.01,Default,,0,0,0,,Шыу!
Dialogue: 0,0:14:58.39,0:15:01.65,Default,,0,0,0,,Иа, әлі де сонша күш.
Dialogue: 0,0:15:02.15,0:15:05.36,Default,,0,0,0,,Бірақ ол қанша уақытқа созылады?
Dialogue: 0,0:15:05.44,0:15:06.32,Default,,0,0,0,,(Үру)
Dialogue: 0,0:15:06.40,0:15:08.19,Default,,0,0,0,,Ей Эй!
Dialogue: 0,0:15:08.28,0:15:10.15,Default,,0,0,0,,Цк, бұл керемет сан.
Dialogue: 0,0:15:10.24,0:15:11.53,Default,,0,0,0,,Тағы бір ату
Dialogue: 0,0:15:11.61,0:15:13.66,Default,,0,0,0,,Нағыз жын семсер!
Dialogue: 0,0:15:13.74,0:15:15.87,Default,,0,0,0,,(Үру)
Dialogue: 0,0:15:16.41,0:15:18.08,Default,,0,0,0,,Ойлан! Ку!
Dialogue: 0,0:15:19.08,0:15:20.41,Default,,0,0,0,,Шат!
Dialogue: 0,0:15:20.50,0:15:21.87,Default,,0,0,0,,Өл… жоқ, әйелім мен арбашы қазірдің өзінде қайтыс болды.
Dialogue: 0,0:15:21.96,0:15:23.50,Default,,0,0,0,,Шыу!
Dialogue: 0,0:15:23.58,0:15:25.59,Default,,0,0,0,,Ku! Хмф!
Dialogue: 0,0:15:25.67,0:15:27.84,Default,,0,0,0,,үшін керемет!
Dialogue: 0,0:15:27.92,0:15:30.84,Default,,0,0,0,,Ах! Сахна Люс!
Dialogue: 0,0:15:30.93,0:15:32.34,Default,,0,0,0,,Қарғыс сиқыры!
Dialogue: 0,0:15:32.43,0:15:33.55,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:33.64,0:15:34.55,Default,,0,0,0,,(Үру)
Dialogue: 0,0:15:34.64,0:15:35.93,Default,,0,0,0,,Шикигумо зұлым дене тағамы!
Dialogue: 0,0:15:38.64,0:15:40.73,Default,,0,0,0,,Тым көп
Dialogue: 0,0:15:40.81,0:15:41.44,Default,,0,0,0,,(Үру)
Dialogue: 0,0:15:41.52,0:15:42.23,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:15:42.85,0:15:43.48,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:15:43.56,0:15:44.90,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:15:47.02,0:15:48.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:48.19,0:15:50.07,Default,,0,0,0,,Хмм... жақсысың ба?
Dialogue: 0,0:15:50.15,0:15:53.61,Default,,0,0,0,,үшінмыз, біз де қосыламыз!
Dialogue: 0,0:15:53.70,0:15:56.03,Default,,0,0,0,,Metallicana-ны қорғаңыз!
Dialogue: 0,0:15:56.12,0:15:57.41,Default,,0,0,0,,О!
Dialogue: 0,0:15:57.49,0:15:58.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:59.33,0:16:00.41,Default,,0,0,0,,Біз де барайық!
Dialogue: 0,0:16:00.50,0:16:01.12,Default,,0,0,0,,О!
Dialogue: 0,0:16:03.67,0:16:05.08,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:16:05.17,0:16:05.83,Default,,0,0,0,,Га
Dialogue: 0,0:16:05.92,0:16:06.84,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:08.09,0:16:09.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:16.18,0:16:17.26,Default,,0,0,0,,Гала ханым!
Dialogue: 0,0:16:17.35,0:16:19.01,Default,,0,0,0,,О, балалар!
Dialogue: 0,0:16:19.10,0:16:20.27,Default,,0,0,0,,Grrgh...
Dialogue: 0,0:16:20.35,0:16:21.64,Default,,0,0,0,,Гала мырза, кешіріңіз...
Dialogue: 0,0:16:21.73,0:16:23.10,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:16:23.19,0:16:25.65,Default,,0,0,0,,Мен мұны қазір істей алмаймын деп ойлаймын, бірақ
Dialogue: 0,0:16:25.73,0:16:27.69,Default,,0,0,0,,үшінңыз, сақ болыңыздар!
Dialogue: 0,0:16:27.77,0:16:28.69,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,0:16:28.77,0:16:31.90,Default,,0,0,0,,Кеттік, Мұрасаме!
Dialogue: 0,0:16:31.99,0:16:33.24,Default,,0,0,0,,Жалмау
Dialogue: 0,0:16:33.32,0:16:34.86,Default,,0,0,0,,Кейунки ниндзя қылышы!
Dialogue: 0,0:16:37.66,0:16:41.37,Default,,0,0,0,,О! Біздің рыцарьлар - Гала ниндзя армиясы.
Dialogue: 0,0:16:41.45,0:16:44.96,Default,,0,0,0,,Осы екпінмен біз өлі рухтарды жеңе аламыз!
Dialogue: 0,0:16:45.04,0:16:47.96,Default,,0,0,0,,Жүр! Қызықты!
Dialogue: 0,0:16:50.38,0:16:52.13,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:16:52.72,0:16:57.34,Default,,0,0,0,,Шақыру санын көбейтсеңіз де, бұл рачиді ашпайды.
Dialogue: 0,0:16:57.43,0:16:58.68,Default,,0,0,0,,Жаман адамдар жоқ, және бұл оның басқа ерліктерімен салыстырғанда біршама қарапайым—
Dialogue: 0,0:16:59.18,0:17:02.22,Default,,0,0,0,,Супер некротикалық одақ мақұлданды!
Dialogue: 0,0:17:02.31,0:17:03.64,Default,,0,0,0,,Бағдарлама Drive!
Dialogue: 0,0:17:05.35,0:17:07.27,Default,,0,0,0,,Жоқ! Не?
Dialogue: 0,0:17:07.35,0:17:08.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:16.36,0:17:18.24,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:17:18.32,0:17:21.20,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:17:21.29,0:17:25.12,Default,,0,0,0,,Ахахахаха…
Dialogue: 0,0:17:29.21,0:17:29.84,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:17:29.92,0:17:31.84,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:17:31.92,0:17:36.68,Default,,0,0,0,,Бітті! Metallicana аяқталды
Dialogue: 0,0:17:37.34,0:17:40.55,Default,,0,0,0,,Кукукуку... Ал ше?
Dialogue: 0,0:17:40.64,0:17:43.85,Default,,0,0,0,,Бұл керемет фигура Өлім Рыцарының қосындысы.
Dialogue: 0,0:17:43.93,0:17:45.64,Default,,0,0,0,,Қандай керемет
Dialogue: 0,0:17:46.23,0:17:49.73,Default,,0,0,0,,Қабілет те, Пауэр де айтарлықтай өсті.
Dialogue: 0,0:17:49.81,0:17:50.61,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:17:50.69,0:17:53.73,Default,,0,0,0,,Нысана үлкенірек және оны кесу оңай!
Dialogue: 0,0:17:53.82,0:17:55.03,Default,,0,0,0,,Нағыз жын семсер!
Dialogue: 0,0:17:56.11,0:17:57.11,Default,,0,0,0,,Не?
Dialogue: 0,0:17:57.86,0:17:58.49,Default,,0,0,0,,О!
Dialogue: 0,0:17:58.57,0:18:00.87,Default,,0,0,0,,Ф Кит
Dialogue: 0,0:18:00.95,0:18:04.08,Default,,0,0,0,,Артымызда Құдай рухының қанымен, пәкті және құрбандық үстелі
Dialogue: 0,0:18:05.16,0:18:09.67,Default,,0,0,0,,Мен Киелі Рухқа соғуды бұйырамын, найзағай!
Dialogue: 0,0:18:09.75,0:18:11.54,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:18:11.63,0:18:12.25,Default,,0,0,0,,Арманым үшін.
Dialogue: 0,0:18:12.34,0:18:13.09,Default,,0,0,0,,Ней мырза!
Dialogue: 0,0:18:13.17,0:18:14.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:14.59,0:18:17.09,Default,,0,0,0,,Гу… Тесла!
Dialogue: 0,0:18:20.80,0:18:23.31,Default,,0,0,0,,Не? Оған шыдай аласың ба?
Dialogue: 0,0:18:23.39,0:18:25.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:29.31,0:18:30.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:30.35,0:18:32.19,Default,,0,0,0,,Ней! Сенімен бәрі жақсы ма?
Dialogue: 0,0:18:32.82,0:18:35.57,Default,,0,0,0,,Ақырында сиқырыңыз таусылды ма?
Dialogue: 0,0:18:36.19,0:18:38.11,Default,,0,0,0,,Бұл өкінішті болды.
Dialogue: 0,0:18:38.20,0:18:40.45,Default,,0,0,0,,Енді қарсы шабуылға шығайық.
Dialogue: 0,0:18:40.53,0:18:42.03,Default,,0,0,0,,(Үру)
Dialogue: 0,0:18:42.12,0:18:43.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:45.62,0:18:46.79,Default,,0,0,0,,Гуа!
Dialogue: 0,0:18:46.87,0:18:47.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:47.58,0:18:48.91,Default,,0,0,0,,Ku! Хмм...
Dialogue: 0,0:18:49.41,0:18:50.71,Default,,0,0,0,,бастап
Dialogue: 0,0:18:50.79,0:18:53.88,Default,,0,0,0,,Сиқырлы оқтар бірден!
Dialogue: 0,0:18:55.46,0:18:59.34,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:18:59.42,0:19:02.14,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:02.22,0:19:03.89,Default,,0,0,0,,Дирк Шнайдер ше?
Dialogue: 0,0:19:03.97,0:19:05.56,Default,,0,0,0,,Адамдар кіммен соғысып жатыр?
Dialogue: 0,0:19:10.14,0:19:12.02,Default,,0,0,0,,О, солай!
Dialogue: 0,0:19:12.90,0:19:14.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:15.02,0:19:16.32,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:19:16.40,0:19:17.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:17.94,0:19:20.28,Default,,0,0,0,,Кай! Мені қорғаңыз...
Dialogue: 0,0:19:20.36,0:19:21.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:21.70,0:19:25.49,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:19:25.58,0:19:26.29,Default,,0,0,0,,Йо
Dialogue: 0,0:19:26.37,0:19:27.08,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:27.16,0:19:29.20,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:19:30.62,0:19:33.50,Default,,0,0,0,,Гага гара Бұл қол...
Dialogue: 0,0:19:33.58,0:19:36.59,Default,,0,0,0,,Не, ол қайтадан өсіп жатыр ...
Dialogue: 0,0:19:36.67,0:19:37.96,Default,,0,0,0,,Ішек
Dialogue: 0,0:19:38.51,0:19:39.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:39.67,0:19:43.18,Default,,0,0,0,,Гах, менің оң аяғым...
Dialogue: 0,0:19:47.60,0:19:51.48,Default,,0,0,0,,Ой... Да, Дирк Шнайдер!
Dialogue: 0,0:19:51.56,0:19:52.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:52.98,0:19:56.94,Default,,0,0,0,,Ха! Тшш, жүрегімнің үні...
Dialogue: 0,0:19:57.02,0:19:59.82,Default,,0,0,0,,Маған бұл ұнамайды!
Dialogue: 0,0:20:00.44,0:20:02.78,Default,,0,0,0,,Дирк Шнайдер Оян!
Dialogue: 0,0:20:02.86,0:20:04.99,Default,,0,0,0,,Уф... оян!
Dialogue: 0,0:20:11.41,0:20:14.46,Default,,0,0,0,,Оян, оян
Dialogue: 0,0:20:17.59,0:20:20.71,Default,,0,0,0,,Оян, Дирк Шнайдер!
Dialogue: 0,0:20:29.51,0:20:30.56,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:20:32.35,0:20:36.02,Default,,0,0,0,,Иә? Люс Ленлен
Dialogue: 0,0:20:36.56,0:20:41.49,Default,,0,0,0,,Дирк Шнайдер Қазір құлайтын уақыт емес.
Dialogue: 0,0:20:42.44,0:20:45.03,Default,,0,0,0,,Metallicana-ны қорғаңыз
Dialogue: 0,0:20:45.78,0:20:50.41,Default,,0,0,0,,Ханшайымның ішінде жатқан мөр сынбасын.
Dialogue: 0,0:20:50.49,0:20:53.37,Default,,0,0,0,,Жоюшы Құдайды оятпа
Dialogue: 0,0:20:54.04,0:20:57.58,Default,,0,0,0,,Жарақат алған және құлаған достарыңызды қорғаңыз
Dialogue: 0,0:20:58.29,0:20:59.54,Default,,0,0,0,,Және-
Dialogue: 0,0:20:59.63,0:21:03.76,Default,,0,0,0,,Сіз және мен кімді жақсы көреміз
Dialogue: 0,0:21:03.84,0:21:05.72,Default,,0,0,0,,Дүние
Dialogue: 0,0:21:06.80,0:21:08.68,Default,,0,0,0,,Оны қорғаңыз!
Dialogue: 0,0:21:11.85,0:21:13.64,Default,,0,0,0,,Дирк Шнайдер?
Dialogue: 0,0:21:14.48,0:21:17.98,Default,,0,0,0,,Әй, бәрі әдемі нәрселер туралы...
Dialogue: 0,0:21:18.06,0:21:21.48,Default,,0,0,0,,Дүние дегеніміз не? Махаббат деген не?
Dialogue: 0,0:21:21.57,0:21:25.28,Default,,0,0,0,,Мен айтқандай, дүние менікі.
Dialogue: 0,0:21:25.95,0:21:27.53,Default,,0,0,0,,Дүниедегі барлық сұлулар
Dialogue: 0,0:21:27.61,0:21:29.70,Default,,0,0,0,,Мына сымбатты кісінікі.
Dialogue: 0,0:21:32.29,0:21:37.62,Default,,0,0,0,,Бұдан былай мен, Сұлу мырза, өзімді сондай ақымақ қылдым.
Dialogue: 0,0:21:38.29,0:21:40.84,Default,,0,0,0,,Абигейлдің бейбақ...
Dialogue: 0,0:21:43.59,0:21:45.26,Default,,0,0,0,,Жарайды онда
Dialogue: 0,0:21:48.55,0:21:52.68,Default,,0,0,0,,Мен білмей тұрып, біртүрлі оқиға болды...
Dialogue: 0,0:21:52.76,0:21:55.06,Default,,0,0,0,,Не? қараңғы шнайдер
Dialogue: 0,0:21:55.14,0:21:56.94,Default,,0,0,0,,Тікелей...
Dialogue: 0,0:21:57.73,0:21:59.35,Default,,0,0,0,,Сәлем, Абигейл!
Dialogue: 0,0:21:59.44,0:22:00.65,Default,,0,0,0,,Не!
Dialogue: 0,0:22:01.23,0:22:03.32,Default,,0,0,0,,Мен аман қалдым
Dialogue: 0,0:22:03.40,0:22:04.53,Default,,0,0,0,,Дарш
Dialogue: 0,0:22:04.61,0:22:06.49,Default,,0,0,0,,Агия! Агия!
Dialogue: 0,0:22:06.57,0:22:07.45,Default,,0,0,0,,Иә
Dialogue: 0,0:22:08.24,0:22:09.36,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:22:09.45,0:22:11.58,Default,,0,0,0,,Ха! Люс…
Dialogue: 0,0:22:11.66,0:22:13.83,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:22:13.91,0:22:16.16,Default,,0,0,0,,Жарайды онда
Dialogue: 0,0:22:23.13,0:22:24.46,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.50,0:23:46.50,Default,,0,0,0,,～♪
