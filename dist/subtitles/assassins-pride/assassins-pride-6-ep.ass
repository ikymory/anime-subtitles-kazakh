Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.00,Default,,0,0,0,,- Аудан-
Dialogue: 0,0:00:11.00,0:00:13.00,Default,,0,0,0,,Құрметпен айтсам, Басшының орынбасары,
Dialogue: 0,0:00:14.00,0:00:16.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:00:16.00,0:00:17.00,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:00:17.00,0:00:19.00,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:00:24.00,0:00:27.00,Default,,0,0,0,,Мен қорқынышты оқиғаны естідім.
Dialogue: 0,0:00:30.00,0:00:33.00,Default,,0,0,0,,Жарықты басқаша сөндіріңіз
Dialogue: 0,0:00:33.00,0:00:35.00,Default,,0,0,0,,Қараңғы жарық
Dialogue: 0,0:00:35.00,0:00:38.00,Default,,0,0,0,,Барған сайын Жарық шығыңыз
Dialogue: 0,0:00:38.00,0:00:40.00,Default,,0,0,0,,Мен көмектескім келеді
Dialogue: 0,0:00:40.00,0:00:42.00,Default,,0,0,0,,- Аудан-
Dialogue: 0,0:01:10.00,0:01:12.00,Default,,0,0,0,,- Аудан-
Dialogue: 0,0:01:40.00,0:01:42.00,Default,,0,0,0,,- Аудан-
Dialogue: 0,0:02:10.00,0:02:12.00,Default,,0,0,0,,- Аудан-
Dialogue: 0,0:02:40.00,0:02:42.00,Default,,0,0,0,,- Аудан-
Dialogue: 0,0:03:10.00,0:03:12.00,Default,,0,0,0,,- Аудан-
Dialogue: 0,0:03:33.00,0:03:36.00,Default,,0,0,0,,Құрметті Сент-Даутрих өкілі студенттер
Dialogue: 0,0:03:36.00,0:03:42.00,Default,,0,0,0,,Осы кеште Сент-Фрилесбедеден шақыруымызды қабыл алғаныңыз үшін алғысымызды білдіреміз.
Dialogue: 0,0:03:42.00,0:03:44.00,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:03:46.00,0:03:48.00,Default,,0,0,0,,Мені шақырғаныңызға рахмет.
Dialogue: 0,0:03:51.00,0:03:53.00,Default,,0,0,0,,Енді барлығыңызға бір стақан алыңыз.
Dialogue: 0,0:03:54.00,0:03:59.00,Default,,0,0,0,,Луна Люмьер іріктеу турнирі Ура жабайы фестивалі өтеді.
Dialogue: 0,0:03:59.00,0:04:01.00,Default,,0,0,0,,Алкоголь?
Dialogue: 0,0:04:01.00,0:04:04.00,Default,,0,0,0,,Эй, Харентина, бұл шырын болуы керек, солай ма?
Dialogue: 0,0:04:06.00,0:04:08.00,Default,,0,0,0,,Дәмді
Dialogue: 0,0:04:13.00,0:04:15.00,Default,,0,0,0,,Жаңа студенттер
Dialogue: 0,0:04:15.00,0:04:19.00,Default,,0,0,0,,Мектеп демеушілігімен өткен Юй-шо Сейшики алмасу кездесуінен
Dialogue: 0,0:04:19.00,0:04:24.00,Default,,0,0,0,,Біз өткізіп жатқан Ура жабайы фестивалі маңыздырақ болуы мүмкін.
Dialogue: 0,0:04:25.00,0:04:27.00,Default,,0,0,0,,Сезіңіз.
Dialogue: 0,0:04:27.00,0:04:29.00,Default,,0,0,0,,Кейра да тамаша
Dialogue: 0,0:04:30.00,0:04:33.00,Default,,0,0,0,,Дәл бұрыннан келе жатқан қоғамдық жиын сияқты
Dialogue: 0,0:04:33.00,0:04:35.00,Default,,0,0,0,,Бұл түнгі кеш те
Dialogue: 0,0:04:35.00,0:04:40.00,Default,,0,0,0,,Бұл біздің алдарымыздан федерацияға жалғасып келе жатқан дәстүрлі шара.
Dialogue: 0,0:04:40.00,0:04:42.00,Default,,0,0,0,,Шухо әпкесі
Dialogue: 0,0:04:42.00,0:04:44.00,Default,,0,0,0,,Бүгінгі түн одан да әдемі
Dialogue: 0,0:04:57.00,0:04:59.00,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:04:59.00,0:05:01.00,Default,,0,0,0,,Мен Ура жабайы фестивалі бар екеніне сене алмаймын.
Dialogue: 0,0:05:01.00,0:05:04.00,Default,,0,0,0,,Мен жасырын түрде қобалжыдым
Dialogue: 0,0:05:08.00,0:05:10.00,Default,,0,0,0,,Көңілді отырсың ба?
Dialogue: 0,0:05:13.00,0:05:15.00,Default,,0,0,0,,Екі періште аруы
Dialogue: 0,0:05:21.00,0:05:25.00,Default,,0,0,0,,Бұл жеңіс менің қабілетімді мойындау емес еді.
Dialogue: 0,0:05:25.00,0:05:28.00,Default,,0,0,0,,Нағыз жеңіс емес
Dialogue: 0,0:05:28.00,0:05:32.00,Default,,0,0,0,,Келесі жолы кім көрсе, оның нәтижесі отты көргеннен де айқынырақ болады.
Dialogue: 0,0:05:32.00,0:05:35.00,Default,,0,0,0,,Жүрегіңе ойып саламын
Dialogue: 0,0:05:37.00,0:05:39.00,Default,,0,0,0,,Мен қорқамын, Кира әпке
Dialogue: 0,0:05:39.00,0:05:43.00,Default,,0,0,0,,Көптеген романдарды жақсы көретін адам ретінде мынаны айтайын:
Dialogue: 0,0:05:43.00,0:05:46.00,Default,,0,0,0,,Әлі алыстағы соғыс туралы
Dialogue: 0,0:05:46.00,0:05:49.00,Default,,0,0,0,,Осындай сенімді сөздерді айту керек пе?
Dialogue: 0,0:05:49.00,0:05:52.00,Default,,0,0,0,,Сақ болған дұрыс деп ойлаймын.
Dialogue: 0,0:05:52.00,0:05:54.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:54.00,0:05:57.00,Default,,0,0,0,,Ендеше, жеңіске жеткеніңіз жақсы.
Dialogue: 0,0:05:57.00,0:05:59.00,Default,,0,0,0,,Бұл қызықтырақ болады.
Dialogue: 0,0:06:04.00,0:06:07.00,Default,,0,0,0,,Менің ойымша, сіз көңіліңізді қалдырмайтын адамсыз.
Dialogue: 0,0:06:07.00,0:06:09.00,Default,,0,0,0,,Кейра-сама деген кім?
Dialogue: 0,0:06:09.00,0:06:11.00,Default,,0,0,0,,Қызық, келесі жылы не болады?
Dialogue: 0,0:06:11.00,0:06:13.00,Default,,0,0,0,,Кез келген жағдайда I
Dialogue: 0,0:06:13.00,0:06:16.00,Default,,0,0,0,,Ританы жақсы қолдаңыз
Dialogue: 0,0:06:19.00,0:06:21.00,Default,,0,0,0,,Рахмет саған Эли
Dialogue: 0,0:06:27.00,0:06:29.00,Default,,0,0,0,,О
Dialogue: 0,0:06:30.00,0:06:34.00,Default,,0,0,0,,Енді келесі жылды ойлаудың қажеті жоқ.
Dialogue: 0,0:06:34.00,0:06:38.00,Default,,0,0,0,,Дәнді өсіретін уақыт.
Dialogue: 0,0:06:38.00,0:06:40.00,Default,,0,0,0,,Міне саған – қоштасу сүйісі.
Dialogue: 0,0:06:45.00,0:06:47.00,Default,,0,0,0,,Біз не ойнауымыз керек?
Dialogue: 0,0:06:47.00,0:06:48.00,Default,,0,0,0,,Трамп?
Dialogue: 0,0:06:48.00,0:06:51.00,Default,,0,0,0,,Жастық төбелестері де классика.
Dialogue: 0,0:06:51.00,0:06:54.00,Default,,0,0,0,,Менде екі бөлме де болса, өзімді жайсыз сезінемін.
Dialogue: 0,0:06:54.00,0:06:55.00,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:06:55.00,0:06:59.00,Default,,0,0,0,,Біз аздап әйелдік болуымыз керек.
Dialogue: 0,0:06:59.00,0:07:02.00,Default,,0,0,0,,Осындай жағдайда не істеу керек
Dialogue: 0,0:07:02.00,0:07:06.00,Default,,0,0,0,,Бұл махаббат туралы әңгіме.
Dialogue: 0,0:07:06.00,0:07:08.00,Default,,0,0,0,,Махаббат?
Dialogue: 0,0:07:08.00,0:07:10.00,Default,,0,0,0,,Енді Мелиза-чаннан бастайық.
Dialogue: 0,0:07:10.00,0:07:15.00,Default,,0,0,0,,Ах, мен сондаймын.
Dialogue: 0,0:07:15.00,0:07:17.00,Default,,0,0,0,,Ол осы уақытқа дейін болған жоқ.
Dialogue: 0,0:07:26.00,0:07:28.00,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:07:29.00,0:07:31.00,Default,,0,0,0,,Әй, сен сондай қашырсың.
Dialogue: 0,0:07:31.00,0:07:33.00,Default,,0,0,0,,Әрине мен де.
Dialogue: 0,0:07:34.00,0:07:36.00,Default,,0,0,0,,Сара ше?
Dialogue: 0,0:07:36.00,0:07:41.00,Default,,0,0,0,,Мен ұялшақпын, ғашық болу былай тұрсын.
Dialogue: 0,0:07:42.00,0:07:44.00,Default,,0,0,0,,Бұл қызықты емес.
Dialogue: 0,0:07:44.00,0:07:47.00,Default,,0,0,0,,Неге менен сұрамайсың?
Dialogue: 0,0:07:47.00,0:07:49.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:07:49.00,0:07:51.00,Default,,0,0,0,,Содан кейін тағы бір стандартты әңгіме
Dialogue: 0,0:07:51.00,0:07:53.00,Default,,0,0,0,,Қорқынышты оқиғаны айтып берейік
Dialogue: 0,0:07:53.00,0:07:55.00,Default,,0,0,0,,Не?
Dialogue: 0,0:07:55.00,0:07:59.00,Default,,0,0,0,,Жігітіммен ондай нәрселерде мен жақсы емеспін.
Dialogue: 0,0:07:59.00,0:08:00.00,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:08:00.00,0:08:02.00,Default,,0,0,0,,Бұл қорқынышты оқиға.
Dialogue: 0,0:08:02.00,0:08:06.00,Default,,0,0,0,,Әңгіме Бұл да махаббат хикаясы.
Dialogue: 0,0:08:07.00,0:08:10.00,Default,,0,0,0,,Су қаласы ретінде әйгілі.
Dialogue: 0,0:08:10.00,0:08:15.00,Default,,0,0,0,,Бұл Тенгу Аквариумындағы әйгілі оқиға.
Dialogue: 0,0:08:15.00,0:08:17.00,Default,,0,0,0,,Әй, бұл оқиға.
Dialogue: 0,0:08:17.00,0:08:19.00,Default,,0,0,0,,Баяғыда
Dialogue: 0,0:08:19.00,0:08:25.00,Default,,0,0,0,,Баяғыда ерлі-зайыптылар Тенгу аквариумына көшіп келді.
Dialogue: 0,0:08:25.00,0:08:27.00,Default,,0,0,0,,Суаренің құрсауынан құтылу
Dialogue: 0,0:08:27.00,0:08:31.00,Default,,0,0,0,,Фландрадан жаңа жер іздеу
Dialogue: 0,0:08:31.00,0:08:33.00,Default,,0,0,0,,Алайда Фландрия тұрғындары
Dialogue: 0,0:08:33.00,0:08:37.00,Default,,0,0,0,,Мен оларға өзімнің ашық пікіріммен шабуыл жасадым.
Dialogue: 0,0:08:37.00,0:08:39.00,Default,,0,0,0,,Тамақтың жеткіліксіздігі
Dialogue: 0,0:08:39.00,0:08:42.00,Default,,0,0,0,,Күйеуін күннен күнге бұрышқа итермелеп жатты.
Dialogue: 0,0:08:42.00,0:08:46.00,Default,,0,0,0,,Ақыры әйелімді қатты ұра бастадым.
Dialogue: 0,0:08:46.00,0:08:50.00,Default,,0,0,0,,Сонда да әйелім мықты болды.
Dialogue: 0,0:08:50.00,0:08:52.00,Default,,0,0,0,,Бірақ бір күні
Dialogue: 0,0:08:52.00,0:08:55.00,Default,,0,0,0,,Ақыры жүрегін жаралаған күйеу
Dialogue: 0,0:08:55.00,0:08:57.00,Default,,0,0,0,,Әйелін пышақпен ұрып өлтірген.
Dialogue: 0,0:08:57.00,0:09:01.00,Default,,0,0,0,,Мен оның жүрегін ойып алдым.
Dialogue: 0,0:09:01.00,0:09:03.00,Default,,0,0,0,,Есіне келген адам
Dialogue: 0,0:09:03.00,0:09:05.00,Default,,0,0,0,,Мен істеген ісімнен шошып кеттім.
Dialogue: 0,0:09:05.00,0:09:08.00,Default,,0,0,0,,Қолындағы ойылған жүректі алып қашып кетті.
Dialogue: 0,0:09:08.00,0:09:12.00,Default,,0,0,0,,Алайда жолда сүрініп қалдым.
Dialogue: 0,0:09:12.00,0:09:15.00,Default,,0,0,0,,Мен әйелімнің жүрегін жоғалттым
Dialogue: 0,0:09:15.00,0:09:19.00,Default,,0,0,0,,Сіз ол кезде жарақат алған жоқсыз.
Dialogue: 0,0:09:19.00,0:09:23.00,Default,,0,0,0,,Жүрек адамға қалай сөйледі
Dialogue: 0,0:09:23.00,0:09:26.00,Default,,0,0,0,,Адам ақыры есін жиды.
Dialogue: 0,0:09:26.00,0:09:28.00,Default,,0,0,0,,Сонда мен білдім
Dialogue: 0,0:09:28.00,0:09:32.00,Default,,0,0,0,,Әйелім мені қалай жақсы көрді
Dialogue: 0,0:09:32.00,0:09:37.00,Default,,0,0,0,,Мен қайтару мүмкін емес қанша нәрсе жасадым?
Dialogue: 0,0:09:37.00,0:09:40.00,Default,,0,0,0,,Ер адам әйелінің жүрегін ұстады
Dialogue: 0,0:09:40.00,0:09:44.00,Default,,0,0,0,,Өзін суға тастадым дейді.
Dialogue: 0,0:09:44.00,0:09:48.00,Default,,0,0,0,,Екеуі осылайша жолға шықты.
Dialogue: 0,0:09:49.00,0:09:51.00,Default,,0,0,0,,Өте қайғылы оқиға
Dialogue: 0,0:09:51.00,0:09:54.00,Default,,0,0,0,,Бұл сіздің сүйікті қорқынышты оқиғаңыз ба?
Dialogue: 0,0:09:54.00,0:09:55.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:55.00,0:10:00.00,Default,,0,0,0,,Негізінде бұл жалғанның екінші жартысы бар.
Dialogue: 0,0:10:02.00,0:10:07.00,Default,,0,0,0,,Мен еркек пен оның әйелінің жүректері жұмаққа кетеді деп үміттенемін.
Dialogue: 0,0:10:07.00,0:10:11.00,Default,,0,0,0,,Жүрегінен айырылып, оққа ұшқан әйелдің денесі
Dialogue: 0,0:10:11.00,0:10:14.00,Default,,0,0,0,,Мен ренішпен қозғала бастадым.
Dialogue: 0,0:10:15.00,0:10:16.00,Default,,0,0,0,,Қарапайым
Dialogue: 0,0:10:16.00,0:10:20.00,Default,,0,0,0,,Жүрегін іздеп қаланы кезеді.
Dialogue: 0,0:10:20.00,0:10:25.00,Default,,0,0,0,,Мен мұны білмей тұрып, ол сұр ведьма деп аталды.
Dialogue: 0,0:10:25.00,0:10:28.00,Default,,0,0,0,,Сұр сиқыр?
Dialogue: 0,0:10:28.00,0:10:30.00,Default,,0,0,0,,Ол қыдырып жүреді
Dialogue: 0,0:10:30.00,0:10:33.00,Default,,0,0,0,,Жас сұлу қызға шабуыл жасау
Dialogue: 0,0:10:33.00,0:10:37.00,Default,,0,0,0,,Олардың жүрегін ойып алып жатқан көрінеді.
Dialogue: 0,0:10:37.00,0:10:39.00,Default,,0,0,0,,Қазір де
Dialogue: 0,0:10:39.00,0:10:41.00,Default,,0,0,0,,Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,0:10:44.00,0:10:47.00,Default,,0,0,0,,Мықты болыңыз Элли
Dialogue: 0,0:10:47.00,0:10:51.00,Default,,0,0,0,,Егер бұл сізге қатты ұнаса, бұл туралы сөйлесетін жиналыс болуы керек еді.
Dialogue: 0,0:10:51.00,0:10:55.00,Default,,0,0,0,,Бірақ бұл жай ғана миф.
Dialogue: 0,0:10:55.00,0:10:57.00,Default,,0,0,0,,Менің жүрегім сөйлей бастайды
Dialogue: 0,0:10:57.00,0:11:00.00,Default,,0,0,0,,Сіз солай ойлайсыз ба? Негізі.
Dialogue: 0,0:11:01.00,0:11:05.00,Default,,0,0,0,,Бүкіл Фландрияда құрбан болғандардың жүректері ойылған деп айтылады.
Dialogue: 0,0:11:05.00,0:11:08.00,Default,,0,0,0,,Жан түршігерлік кісі өлтіру болып жатыр.
Dialogue: 0,0:11:08.00,0:11:11.00,Default,,0,0,0,,Ұрлаушы жай ғана анекдот па?
Dialogue: 0,0:11:11.00,0:11:13.00,Default,,0,0,0,,T: Бүгін айтатын сөздерім осы ғана.
Dialogue: 0,0:11:17.00,0:11:18.00,Default,,0,0,0,,Не?
Dialogue: 0,0:11:22.00,0:11:24.00,Default,,0,0,0,,Мүмкін жел кірген шығар?
Dialogue: 0,0:11:24.00,0:11:27.00,Default,,0,0,0,,Вина, маған сіріңкелерді әкел.
Dialogue: 0,0:11:27.00,0:11:28.00,Default,,0,0,0,,Вина
Dialogue: 0,0:11:28.00,0:11:31.00,Default,,0,0,0,,Вина мырза жоғалып кетті. Ол жоғалып кетті.
Dialogue: 0,0:11:31.00,0:11:34.00,Default,,0,0,0,,Егер ол жоғалып кетсе де, олай болмауы керек.
Dialogue: 0,0:11:34.00,0:11:35.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:11:37.00,0:11:39.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:39.00,0:11:41.00,Default,,0,0,0,,Сіз қалай кірдіңіз?
Dialogue: 0,0:11:50.00,0:11:53.00,Default,,0,0,0,,Сұр сиқыршы
Dialogue: 0,0:11:53.00,0:11:56.00,Default,,0,0,0,,Жүрегімізді қазып алу үшін келді.
Dialogue: 0,0:12:02.00,0:12:04.00,Default,,0,0,0,,үшінңыз көшіңіздер.
Dialogue: 0,0:12:04.00,0:12:05.00,Default,,0,0,0,,Менің уақытым
Dialogue: 0,0:12:23.00,0:12:27.00,Default,,0,0,0,,Дұрыс, қару тек болат емес.
Dialogue: 0,0:12:27.00,0:12:29.00,Default,,0,0,0,,Дұрыс, сэр.
Dialogue: 0,0:12:30.00,0:12:31.00,Default,,0,0,0,,үшінна жеңіс
Dialogue: 0,0:12:34.00,0:12:36.00,Default,,0,0,0,,Қаш!
Dialogue: 0,0:12:53.00,0:12:56.00,Default,,0,0,0,,Олар менің артымнан келмейтін сияқты.
Dialogue: 0,0:12:56.00,0:12:59.00,Default,,0,0,0,,үшін жақсы ма?
Dialogue: 0,0:12:59.00,0:13:01.00,Default,,0,0,0,,Әйтеуір жатақханаға қайтайық.
Dialogue: 0,0:13:01.00,0:13:02.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:08.00,0:13:10.00,Default,,0,0,0,,Келесі кезекте біз
Dialogue: 0,0:13:10.00,0:13:11.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:11.00,0:13:12.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:12.00,0:13:13.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:13.00,0:13:14.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:14.00,0:13:15.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:15.00,0:13:16.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:16.00,0:13:17.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:17.00,0:13:18.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:18.00,0:13:19.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:19.00,0:13:20.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:20.00,0:13:21.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:21.00,0:13:22.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:22.00,0:13:28.00,Default,,0,0,0,,Бұрынғы тонгари қалпағы, бұл шынымен сұр бақсы ма екен?
Dialogue: 0,0:13:28.00,0:13:33.00,Default,,0,0,0,,Мен түсінбеймін, бірақ Кира-ни-сама оңай жеңілді.
Dialogue: 0,0:13:33.00,0:13:36.00,Default,,0,0,0,,Бұл жай ғана нәрсе емес екені анық.
Dialogue: 0,0:13:36.00,0:13:40.00,Default,,0,0,0,,Бұл әзіл емес, бақсылар жай ғана миф.
Dialogue: 0,0:13:40.00,0:13:43.00,Default,,0,0,0,,Олардың шынымен бар болуы мүмкін емес.
Dialogue: 0,0:13:44.00,0:13:49.00,Default,,0,0,0,,Егер сіз профессор Куфамен сөйлессеңіз, ол сізге басқа адамның кім екенін айтады.
Dialogue: 0,0:13:52.00,0:13:54.00,Default,,0,0,0,,...
Dialogue: 0,0:13:54.00,0:13:57.00,Default,,0,0,0,,Не болды, Мерида?
Dialogue: 0,0:13:57.00,0:14:02.00,Default,,0,0,0,,Эй, мен бірдеңені басып қалдым. Бірдеңе құлап, сықырлап жатты.
Dialogue: 0,0:14:02.00,0:14:08.00,Default,,0,0,0,,Мен оның не екенін білмеймін.Ол жұмсақ, текстуралы және серпімді.
Dialogue: 0,0:14:08.00,0:14:13.00,Default,,0,0,0,,Бұл адамның терісіне көбірек ұқсайды.
Dialogue: 0,0:14:14.00,0:14:15.00,Default,,0,0,0,,Ішкі мүшелер
Dialogue: 0,0:14:17.00,0:14:18.00,Default,,0,0,0,,Бір нәрсе сияқты
Dialogue: 0,0:14:22.00,0:14:25.00,Default,,0,0,0,,Тез қашайық.
Dialogue: 0,0:14:30.00,0:14:32.00,Default,,0,0,0,,Жоқ, оны не басты?
Dialogue: 0,0:14:32.00,0:14:34.00,Default,,0,0,0,,Мен де оны басып қалдым.
Dialogue: 0,0:14:34.00,0:14:36.00,Default,,0,0,0,,Мен де сонда болдым.
Dialogue: 0,0:14:36.00,0:14:38.00,Default,,0,0,0,,Эрин, мықты бол.
Dialogue: 0,0:14:38.00,0:14:40.00,Default,,0,0,0,,Аяғым су болып кеткені сонша
Dialogue: 0,0:14:40.00,0:14:42.00,Default,,0,0,0,,Эрин нық
Dialogue: 0,0:14:52.00,0:14:53.00,Default,,0,0,0,,Ах
Dialogue: 0,0:15:03.00,0:15:07.00,Default,,0,0,0,,Осы су жолынан өткенше,
Dialogue: 0,0:15:12.00,0:15:15.00,Default,,0,0,0,,Хисша
Dialogue: 0,0:15:17.00,0:15:21.00,Default,,0,0,0,,Мұғалім сені осылай көрсе ше?
Dialogue: 0,0:15:23.00,0:15:24.00,Default,,0,0,0,,Өте қиын болды… Өтінемін, мені жалғыз қалдыр.
Dialogue: 0,0:15:24.00,0:15:26.00,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:15:26.00,0:15:28.00,Default,,0,0,0,,Жалақы
Dialogue: 0,0:15:37.00,0:15:40.00,Default,,0,0,0,,Оны шешу өте қиын
Dialogue: 0,0:15:40.00,0:15:42.00,Default,,0,0,0,,Эрин, асықпа.
Dialogue: 0,0:15:44.00,0:15:46.00,Default,,0,0,0,,Жіктегі
Dialogue: 0,0:15:46.00,0:15:49.00,Default,,0,0,0,,Әй, сен қиыншылықта қалдың, Сара.
Dialogue: 0,0:15:49.00,0:15:51.00,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:15:51.00,0:15:54.00,Default,,0,0,0,,Мен де саған көмектесемін, Сатқындықтың жемісі.
Dialogue: 0,0:15:54.00,0:15:56.00,Default,,0,0,0,,Шабдалы теру
Dialogue: 0,0:15:56.00,0:16:01.00,Default,,0,0,0,,Бұл қиын болуы керек. Бір үзім де қалдырмай, бар бидайымды аламын.
Dialogue: 0,0:16:01.00,0:16:03.00,Default,,0,0,0,,Енді қолыңызды тез алыңыз.
Dialogue: 0,0:16:03.00,0:16:06.00,Default,,0,0,0,,үшін қорқады
Dialogue: 0,0:16:06.00,0:16:08.00,Default,,0,0,0,,Ах
Dialogue: 0,0:16:18.00,0:16:20.00,Default,,0,0,0,,Сұр сиқыршы
Dialogue: 0,0:16:20.00,0:16:22.00,Default,,0,0,0,,Амал жоқ, апалар
Dialogue: 0,0:16:22.00,0:16:24.00,Default,,0,0,0,,Аннигиляция
Dialogue: 0,0:16:24.00,0:16:27.00,Default,,0,0,0,,Сізге ешкімнің араласуына жол бермеңіз
Dialogue: 0,0:16:36.00,0:16:38.00,Default,,0,0,0,,Жалақы
Dialogue: 0,0:16:44.00,0:16:46.00,Default,,0,0,0,,Сара-чан
Dialogue: 0,0:16:48.00,0:16:49.00,Default,,0,0,0,,Ели
Dialogue: 0,0:16:49.00,0:16:52.00,Default,,0,0,0,,Мен үшін күшті өмір сүр, Рито
Dialogue: 0,0:16:52.00,0:16:54.00,Default,,0,0,0,,Сен не айтып тұрсың, Эли?
Dialogue: 0,0:16:54.00,0:16:58.00,Default,,0,0,0,,Берілме, бірге күресеміз
Dialogue: 0,0:16:59.00,0:17:01.00,Default,,0,0,0,,Рито
Dialogue: 0,0:17:06.00,0:17:08.00,Default,,0,0,0,,Сюаньюй шайқасы
Dialogue: 0,0:17:08.00,0:17:10.00,Default,,0,0,0,,Білгіш.
Dialogue: 0,0:17:14.00,0:17:17.00,Default,,0,0,0,,Күшті Өте күшті
Dialogue: 0,0:17:17.00,0:17:20.00,Default,,0,0,0,,Қаш, бәрі тез қашады.
Dialogue: 0,0:17:20.00,0:17:22.00,Default,,0,0,0,,Осы су жолынан өтсеңіз
Dialogue: 0,0:17:29.00,0:17:32.00,Default,,0,0,0,,Біразырақ. Тағы да
Dialogue: 0,0:17:32.00,0:17:36.00,Default,,0,0,0,,Жатақханаға барсаң мұғалім көмектеседі.
Dialogue: 0,0:17:36.00,0:17:38.00,Default,,0,0,0,,Жалақы
Dialogue: 0,0:17:38.00,0:17:40.00,Default,,0,0,0,,Жалақы
Dialogue: 0,0:17:40.00,0:17:42.00,Default,,0,0,0,,Жалақы
Dialogue: 0,0:17:42.00,0:17:44.00,Default,,0,0,0,,Жалақы
Dialogue: 0,0:17:44.00,0:17:46.00,Default,,0,0,0,,Жалақы
Dialogue: 0,0:17:46.00,0:17:48.00,Default,,0,0,0,,Жалақы
Dialogue: 0,0:17:48.00,0:17:50.00,Default,,0,0,0,,көмек
Dialogue: 0,0:18:05.00,0:18:08.00,Default,,0,0,0,,Мен сізге осы уақытқа дейін ермеймін.
Dialogue: 0,0:18:08.00,0:18:10.00,Default,,0,0,0,,Профессор Куба
Dialogue: 0,0:18:10.00,0:18:12.00,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:18:12.00,0:18:15.00,Default,,0,0,0,,Бұл ханымдар
Dialogue: 0,0:18:16.00,0:18:18.00,Default,,0,0,0,,Мұғалім, қиын екен.
Dialogue: 0,0:18:18.00,0:18:19.00,Default,,0,0,0,,Қорқынышты заттар
Dialogue: 0,0:18:19.00,0:18:21.00,Default,,0,0,0,,Мен енді жаман сөз айтпаймын, сондықтан маған көмектесіңізші.
Dialogue: 0,0:18:21.00,0:18:23.00,Default,,0,0,0,,Өтінемін, профессор Куба.
Dialogue: 0,0:18:23.00,0:18:26.00,Default,,0,0,0,,Мен сізге кез келген соманы кейінірек беремін.
Dialogue: 0,0:18:26.00,0:18:29.00,Default,,0,0,0,,Менде де проблема болды.
Dialogue: 0,0:18:29.00,0:18:33.00,Default,,0,0,0,,Маған оны табуға көмектесе аласыз ба?
Dialogue: 0,0:18:33.00,0:18:35.00,Default,,0,0,0,,Іздеуші
Dialogue: 0,0:18:35.00,0:18:36.00,Default,,0,0,0,,Иә
Dialogue: 0,0:18:36.00,0:18:38.00,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:18:39.00,0:18:43.00,Default,,0,0,0,,Мен ойылған жүректі іздеймін.
Dialogue: 0,0:18:45.00,0:18:47.00,Default,,0,0,0,,Ааа
Dialogue: 0,0:18:55.00,0:18:57.00,Default,,0,0,0,,Рефлексия жасадыңыз ба?
Dialogue: 0,0:18:57.00,0:18:59.00,Default,,0,0,0,,Ханымдар
Dialogue: 0,0:19:00.00,0:19:01.00,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:19:01.00,0:19:03.00,Default,,0,0,0,,Томат соусы
Dialogue: 0,0:19:04.00,0:19:06.00,Default,,0,0,0,,Урако көкөністері туралы
Dialogue: 0,0:19:06.00,0:19:09.00,Default,,0,0,0,,Мұғалімдер барлығы білді.
Dialogue: 0,0:19:09.00,0:19:11.00,Default,,0,0,0,,Иә
Dialogue: 0,0:19:13.00,0:19:16.00,Default,,0,0,0,,Мен қорқынышты оқиғаны естідім.
Dialogue: 0,0:19:16.00,0:19:19.00,Default,,0,0,0,,Лорд ана айналымдарын аяқтағаннан кейін.
Dialogue: 0,0:19:19.00,0:19:21.00,Default,,0,0,0,,Бұл орын алатын сияқты.
Dialogue: 0,0:19:21.00,0:19:23.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:23.00,0:19:26.00,Default,,0,0,0,,Фридесвид пен Дортрихсей жиналды.
Dialogue: 0,0:19:26.00,0:19:29.00,Default,,0,0,0,,Менің естуімше, олар «урако көкөністері» деп аталатын нәрсе жасайды.
Dialogue: 0,0:19:29.00,0:19:33.00,Default,,0,0,0,,Неге оны менен сұрап тұрсың?
Dialogue: 0,0:19:33.00,0:19:36.00,Default,,0,0,0,,Менен сұрасаң, жалғыз қалдырмайсың.
Dialogue: 0,0:19:36.00,0:19:38.00,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:38.00,0:19:41.00,Default,,0,0,0,,Біз ханымдардан академиядағы тәртіпті сақтауды сұраймыз.
Dialogue: 0,0:19:41.00,0:19:44.00,Default,,0,0,0,,Бұл тәрбиешінің рөлі.
Dialogue: 0,0:19:44.00,0:19:45.00,Default,,0,0,0,,Умм
Dialogue: 0,0:19:45.00,0:19:49.00,Default,,0,0,0,,Содан кейін тізбекте пайда болған сұр бақсы
Dialogue: 0,0:19:49.00,0:19:51.00,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:19:51.00,0:19:53.00,Default,,0,0,0,,Бұл Розетти мырза.
Dialogue: 0,0:19:53.00,0:19:56.00,Default,,0,0,0,,Костюм ретінде бетке бояу кию де
Dialogue: 0,0:19:56.00,0:20:01.00,Default,,0,0,0,,Бәлкім, сіз бүгінгі түнгі әбігерге көбірек ләззат алған боларсыз.
Dialogue: 0,0:20:01.00,0:20:04.00,Default,,0,0,0,,Су жолына түскен оғаш елдер
Dialogue: 0,0:20:05.00,0:20:09.00,Default,,0,0,0,,Бұл пикси асыл тас
Dialogue: 0,0:20:09.00,0:20:11.00,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:20:11.00,0:20:13.00,Default,,0,0,0,,...
Dialogue: 0,0:20:13.00,0:20:15.00,Default,,0,0,0,,Бұл ойыншық.
Dialogue: 0,0:20:15.00,0:20:21.00,Default,,0,0,0,,Содан кейін оны төбеден тербеткен мұғалім болды.
Dialogue: 0,0:20:21.00,0:20:24.00,Default,,0,0,0,,Бұл үшін кешіріңіз
Dialogue: 0,0:20:24.00,0:20:28.00,Default,,0,0,0,,Мен мұндай үлкен шу болады деп күткен жоқпын.
Dialogue: 0,0:20:34.00,0:20:36.00,Default,,0,0,0,,Мұғалімнің қыры
Dialogue: 0,0:20:36.00,0:20:39.00,Default,,0,0,0,,Дене бітімдері әртүрлі студент қыздарға ұнамсыз.
Dialogue: 0,0:20:39.00,0:20:41.00,Default,,0,0,0,,Мені осылай көргеніңізге сене алар емеспін
Dialogue: 0,0:20:41.00,0:20:45.00,Default,,0,0,0,,Аспан денесі, көмекші, шайтан, бұйрық Роза мырза
Dialogue: 0,0:20:45.00,0:20:48.00,Default,,0,0,0,,Кімге ұрысып жатыр?
Dialogue: 0,0:20:48.00,0:20:52.00,Default,,0,0,0,,Бөлмеңізге қазір оралуыңызға болады.
Dialogue: 0,0:20:52.00,0:20:56.00,Default,,0,0,0,,Мен аяғыммен тұра алмаймын
Dialogue: 0,0:20:59.00,0:21:03.00,Default,,0,0,0,,Мүйіздегі толқу, қорқыныш және шиеленіс
Dialogue: 0,0:21:03.00,0:21:06.00,Default,,0,0,0,,Мен оны өте ұсынамын.
Dialogue: 0,0:21:06.00,0:21:08.00,Default,,0,0,0,,Бұл ойыншық.
Dialogue: 0,0:21:08.00,0:21:10.00,Default,,0,0,0,,Бұл ойыншық.
Dialogue: 0,0:21:10.00,0:21:12.00,Default,,0,0,0,,Бұл ойыншық
Dialogue: 0,0:21:12.00,0:21:14.00,Default,,0,0,0,,Бұл ойыншық
Dialogue: 0,0:21:14.00,0:21:16.00,Default,,0,0,0,,Бұл ойыншық
Dialogue: 0,0:21:16.00,0:21:18.00,Default,,0,0,0,,Бұл ойыншық.
Dialogue: 0,0:21:18.00,0:21:20.00,Default,,0,0,0,,Бұл ойыншық.
Dialogue: 0,0:21:20.00,0:21:22.00,Default,,0,0,0,,Қорқыныш пен шиеленіс
Dialogue: 0,0:21:22.00,0:21:26.00,Default,,0,0,0,,Ұзақ уақыт бойы шоқжұлдызға байланысты аяқтың ұюы ма?
Dialogue: 0,0:21:26.00,0:21:28.00,Default,,0,0,0,,Бірақ біз барамыз.
Dialogue: 0,0:21:28.00,0:21:30.00,Default,,0,0,0,,Бұл мен бұрыннан білетінім емес.
Dialogue: 0,0:21:30.00,0:21:34.00,Default,,0,0,0,,Алдымен алыңыз, сэр.
Dialogue: 0,0:21:50.00,0:21:52.00,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:21:56.00,0:22:00.00,Default,,0,0,0,,Мен бүгін түні бойы ұйықтамаймын.
Dialogue: 0,0:22:20.00,0:22:22.00,Default,,0,0,0,,Бұл ойыншық.
