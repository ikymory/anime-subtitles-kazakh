Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.12,0:00:04.92,Default,,0,0,0,,Бұл орын виртуалды кеңістік емес.
Dialogue: 0,0:00:05.33,0:00:09.59,Default,,0,0,0,,Бұл параллель әлемде Жермен бір жерде орналасқан планета.
Dialogue: 0,0:00:14.01,0:00:16.22,Default,,0,0,0,,Бұл дүниенің тұрғындары
Dialogue: 0,0:00:16.72,0:00:19.97,Default,,0,0,0,,Виртуалды емес, параллель дүниедегі жер адамы ма?
Dialogue: 0,0:00:30.19,0:00:33.45,Default,,0,0,0,,Біреуді өлтірді...
Dialogue: 0,0:00:45.83,0:00:47.04,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:00:52.09,0:00:55.18,Default,,0,0,0,,Сіз біреуді өлтірдіңіз бе?
Dialogue: 0,0:00:56.13,0:00:57.05,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:59.05,0:00:59.97,Default,,0,0,0,,Яби
Dialogue: 0,0:01:05.23,0:01:07.48,Default,,0,0,0,,Мен адамдарды жек көремін
Dialogue: 0,0:01:13.78,0:01:16.95,Default,,0,0,0,,Мен әрқашан құрып кетуім керек деп ойладым.
Dialogue: 0,0:01:19.28,0:01:21.41,Default,,0,0,0,,Жаңа ғана бір адамды өлтірді
Dialogue: 0,0:01:22.91,0:01:24.62,Default,,0,0,0,,Жүрегімнің соғуын тоқтата алмаймын
Dialogue: 0,0:01:26.08,0:01:27.54,Default,,0,0,0,,Ролик...
Dialogue: 0,0:01:27.92,0:01:30.88,Default,,0,0,0,,Жоқ, бұл парашютпен секіру бейнесі.
Dialogue: 0,0:01:41.18,0:01:42.85,Default,,0,0,0,,Артқа қайту жоқ
Dialogue: 0,0:01:45.27,0:01:47.60,Default,,0,0,0,,Менің қазір бастайын деген ойым жоқ еді...
Dialogue: 0,0:01:53.90,0:01:55.24,Default,,0,0,0,,Сол сөзге шебер, жалған мейірімді жігіт➡
Dialogue: 0,0:01:57.45,0:01:58.66,Default,,0,0,0,,Құлау
Dialogue: 0,0:02:06.33,0:02:12.34,Default,,0,0,0,,♪～
Dialogue: 0,0:03:29.83,0:03:35.84,Default,,0,0,0,,～♪
Dialogue: 0,0:03:36.75,0:03:42.97,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:03:46.60,0:03:48.14,Default,,0,0,0,,Әй, өт!
Dialogue: 0,0:03:50.52,0:03:51.35,Default,,0,0,0,,Эй!
Dialogue: 0,0:03:51.48,0:03:54.06,Default,,0,0,0,,Оған допты кім берді?
Dialogue: 0,0:03:54.90,0:03:55.73,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:04:01.57,0:04:02.40,Default,,0,0,0,,Керемет
Dialogue: 0,0:04:02.53,0:04:05.32,Default,,0,0,0,,Эй, ол шынымен де спортшы ма еді?
Dialogue: 0,0:04:05.45,0:04:06.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:07.33,0:04:08.28,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:04:12.79,0:04:13.62,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:04:17.63,0:04:20.17,Default,,0,0,0,,Біздің енді гастрольге бармайтынымыз таң қалдырады.
Dialogue: 0,0:04:20.71,0:04:23.47,Default,,0,0,0,,Сіз біраз күш жинадыңыз ба?
Dialogue: 0,0:04:23.80,0:04:27.30,Default,,0,0,0,,Мен де бұрынғыдан жеңілірек болдым.
Dialogue: 0,0:04:27.43,0:04:30.18,Default,,0,0,0,,Қызық, ол жақтағы дәреженің көтерілуінің әсері бар ма?
Dialogue: 0,0:04:30.31,0:04:31.14,Default,,0,0,0,,Мүмкін?
Dialogue: 0,0:04:31.85,0:04:34.69,Default,,0,0,0,,Ауруымнан айығып кеткендей емес.
Dialogue: 0,0:04:34.81,0:04:37.27,Default,,0,0,0,,Бұл жерде жүгіру қиын.
Dialogue: 0,0:04:37.40,0:04:41.53,Default,,0,0,0,,Аа, мен турнир алдында осындай нәрсені қалаған едім.
Dialogue: 0,0:04:43.32,0:04:46.91,Default,,0,0,0,,Йоцуя-кун, статус туралы білесің бе?
Dialogue: 0,0:04:48.32,0:04:50.54,Default,,0,0,0,,Содан бері сөйлескен жоқпыз.
Dialogue: 0,0:04:50.95,0:04:52.83,Default,,0,0,0,,Сөйлеу қиын ба?
Dialogue: 0,0:04:53.12,0:04:54.04,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:02.26,0:05:03.84,Default,,0,0,0,,Юка-сан Юка-сан!
Dialogue: 0,0:05:03.97,0:05:05.05,Default,,0,0,0,,Э? Не? Мен тыңдамаппын.
Dialogue: 0,0:05:05.63,0:05:07.30,Default,,0,0,0,,Йоцуя-кун, не болды?
Dialogue: 0,0:05:07.43,0:05:08.93,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:05:09.35,0:05:11.81,Default,,0,0,0,,Мен Альтерос сенушілеріне көмектескен кезде
Dialogue: 0,0:05:11.93,0:05:13.52,Default,,0,0,0,,Дұрыс сөйлеген жоқсың ба?
Dialogue: 0,0:05:13.64,0:05:14.48,Default,,0,0,0,,Иә
Dialogue: 0,0:05:16.69,0:05:17.60,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:05:18.44,0:05:21.52,Default,,0,0,0,,Ол бір адамды өлтірді.
Dialogue: 0,0:05:32.74,0:05:33.79,Default,,0,0,0,,Сәлем Йоцуя!
Dialogue: 0,0:05:35.66,0:05:37.33,Default,,0,0,0,,Дұрыс өту
Dialogue: 0,0:05:39.25,0:05:42.38,Default,,0,0,0,,Неліктен ол жалғыз өзі қамтып жатыр?
Dialogue: 0,0:05:44.34,0:05:47.51,Default,,0,0,0,,Бұл өте қиын, солай емес пе?
Dialogue: 0,0:05:53.39,0:05:54.52,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:05:54.64,0:05:56.06,Default,,0,0,0,,Жоқ, шын!
Dialogue: 0,0:06:00.98,0:06:04.15,Default,,0,0,0,,Жарайды, оны мен ғана өлтірдім.
Dialogue: 0,0:06:07.78,0:06:09.45,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:06:13.45,0:06:14.37,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:17.75,0:06:19.33,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:06:22.88,0:06:24.75,Default,,0,0,0,,Жоқ, бұл мүлдем дұрыс!
Dialogue: 0,0:06:24.88,0:06:25.84,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:06:25.96,0:06:27.26,Default,,0,0,0,,Артық емес, артық емес
Dialogue: 0,0:06:27.38,0:06:29.22,Default,,0,0,0,,Хахаха
Dialogue: 0,0:06:29.34,0:06:32.89,Default,,0,0,0,,Мен бұл қаланы жек көремін.
Dialogue: 0,0:06:34.43,0:06:35.47,Default,,0,0,0,,А…?
Dialogue: 0,0:06:38.68,0:06:39.89,Default,,0,0,0,,Ойын шебері?
Dialogue: 0,0:06:40.48,0:06:43.36,Default,,0,0,0,,Миссия? Немесе қайтадан мен бе?
Dialogue: 0,0:06:48.19,0:06:51.24,Default,,0,0,0,,Енді менің қашып кетуім мүмкін емес пе?
Dialogue: 0,0:07:10.43,0:07:13.22,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:07:17.35,0:07:20.31,Default,,0,0,0,,Мүмкін олар мені өлтіруді жоспарлаған болуы мүмкін бе?
Dialogue: 0,0:07:21.10,0:07:23.86,Default,,0,0,0,,Жоқ, бірақ бұл...
Dialogue: 0,0:07:25.61,0:07:26.86,Default,,0,0,0,,Ей, ей, ей! Бар дейсің бе? Қайда, нақты қай жерде?
Dialogue: 0,0:07:30.95,0:07:32.36,Default,,0,0,0,,Бұл менің шешімім.
Dialogue: 0,0:07:33.53,0:07:37.41,Default,,0,0,0,,Мен оның виртуалды екеніне сенгендіктен...
Dialogue: 0,0:07:37.95,0:07:38.79,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:07:42.87,0:07:43.71,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:54.51,0:07:55.39,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:55.76,0:07:56.72,Default,,0,0,0,,Кім?
Dialogue: 0,0:07:56.85,0:08:00.60,Default,,0,0,0,,Сәлем, менің электрондық поштама жауап беріңізші.
Dialogue: 0,0:08:00.77,0:08:03.02,Default,,0,0,0,,А... электрондық пошта? жауап беру?
Dialogue: 0,0:08:04.98,0:08:07.52,Default,,0,0,0,,Жоқ, сіз... Ұстаз?
Dialogue: 0,0:08:07.65,0:08:09.86,Default,,0,0,0,,Жоқ Болашақ халық тарапынан тағы бір жігіт?
Dialogue: 0,0:08:11.99,0:08:12.95,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:08:13.91,0:08:16.37,Default,,0,0,0,,Сұрақ қоюға құқығыңыз жоқ.
Dialogue: 0,0:08:16.66,0:08:17.99,Default,,0,0,0,,Сіз қожайынсыз!
Dialogue: 0,0:08:19.08,0:08:21.70,Default,,0,0,0,,Демек, сіз қалыпты сөйлеп жатырсыз.
Dialogue: 0,0:08:25.42,0:08:26.83,Default,,0,0,0,,А... жақсы.
Dialogue: 0,0:08:27.71,0:08:31.55,Default,,0,0,0,,Олар менің өлгенім дұрыс деп есептейтін адамдар.
Dialogue: 0,0:08:31.67,0:08:34.22,Default,,0,0,0,,Оның жартысы ғана дұрыс болды.
Dialogue: 0,0:08:36.55,0:08:37.68,Default,,0,0,0,,Сол жігіттер
Dialogue: 0,0:08:38.18,0:08:39.39,Default,,0,0,0,,Жазықсыз сенушілер
Dialogue: 0,0:08:39.51,0:08:42.31,Default,,0,0,0,,Мен сені мақтау үшін өлтірмек болдым.
Dialogue: 0,0:08:43.64,0:08:47.61,Default,,0,0,0,,Не керек, ол бізді алдап, тіпті өлтірмек болды.
Dialogue: 0,0:08:48.98,0:08:51.61,Default,,0,0,0,,Бұл мен үшін өте жаман.
Dialogue: 0,0:08:53.15,0:08:55.86,Default,,0,0,0,,Бірақ оның жартысы басқа.
Dialogue: 0,0:08:56.41,0:09:00.03,Default,,0,0,0,,Олардың әділдіктің өзіндік нұсқасы болды.
Dialogue: 0,0:09:01.12,0:09:02.41,Default,,0,0,0,,Сонымен... (қыз)?
Dialogue: 0,0:09:03.91,0:09:04.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:05.37,0:09:07.25,Default,,0,0,0,,Сұрақтарға жауаптар
Dialogue: 0,0:09:10.96,0:09:13.76,Default,,0,0,0,,Менің ойымша, оны өлтіру қателік болды.
Dialogue: 0,0:09:13.88,0:09:16.22,Default,,0,0,0,,Білсем сені өлтірмес едім.
Dialogue: 0,0:09:16.68,0:09:18.34,Default,,0,0,0,,Иә, соңы
Dialogue: 0,0:09:19.14,0:09:20.51,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:09:22.60,0:09:23.89,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:09:24.31,0:09:26.10,Default,,0,0,0,,Артық айтатын ештеңе жоқ
Dialogue: 0,0:09:28.06,0:09:29.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:30.27,0:09:32.94,Default,,0,0,0,,Олай болса, келесі ойыншы туралы сөйлесейік.
Dialogue: 0,0:09:33.07,0:09:35.36,Default,,0,0,0,,Иә? Шынайы ма?
Dialogue: 0,0:09:35.61,0:09:39.53,Default,,0,0,0,,Өткен жолғыдай, сенің кездескеніңді қалайтын адам бар.
Dialogue: 0,0:09:39.87,0:09:41.83,Default,,0,0,0,,Айтпақшы, Токитате мырза
Dialogue: 0,0:09:41.95,0:09:44.20,Default,,0,0,0,,Қыздарды жинауға қандай бұйрық берілді?
Dialogue: 0,0:09:44.45,0:09:47.12,Default,,0,0,0,,Сұрақ қоюға құқығыңыз жоқ.
Dialogue: 0,0:09:47.33,0:09:49.83,Default,,0,0,0,,Сонда сен айтпадың ба? Бұл дегеніміз осы
Dialogue: 0,0:09:50.84,0:09:52.13,Default,,0,0,0,,Не айтылды?
Dialogue: 0,0:09:52.34,0:09:54.84,Default,,0,0,0,,Адамдарды жинау үшін маған дәретханадан шығуға көмектесіңіз...
Dialogue: 0,0:09:55.34,0:09:57.76,Default,,0,0,0,,Ум, ұмытып кетіппін.
Dialogue: 0,0:09:57.88,0:10:00.80,Default,,0,0,0,,-те кездесеміз бе? Біз кездесеміз бе?
Dialogue: 0,0:10:01.22,0:10:02.72,Default,,0,0,0,,Жақында кездесеміз.
Dialogue: 0,0:10:05.47,0:10:06.60,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:10:07.44,0:10:10.06,Default,,0,0,0,,қалпақ? неге?
Dialogue: 0,0:10:20.70,0:10:24.12,Default,,0,0,0,,Әй, уақыт болды, дайындал.
Dialogue: 0,0:10:29.04,0:10:32.00,Default,,0,0,0,,Ішіндегі сорпа ыстық, сондықтан абай болыңыз.
Dialogue: 0,0:10:33.79,0:10:37.42,Default,,0,0,0,,Сонымен, бұл қытай мейрамханасы қандай?
Dialogue: 0,0:10:37.72,0:10:40.51,Default,,0,0,0,,Столдың артында отырған адам
Dialogue: 0,0:10:42.35,0:10:45.18,Default,,0,0,0,,Соңғы уақытқа дейін есірткі сатумен айналысқан.
Dialogue: 0,0:10:45.68,0:10:46.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:46.89,0:10:49.98,Default,,0,0,0,,Жаңа ойыншылар бұл дүкенге 20 секундтан кейін кіреді.
Dialogue: 0,0:10:50.10,0:10:52.15,Default,,0,0,0,,Мен оны өлтіруім керек.
Dialogue: 0,0:10:52.27,0:10:55.57,Default,,0,0,0,,Бір адам мені ешқашан ұсталмаймын деп алдады.
Dialogue: 0,0:10:55.69,0:10:57.94,Default,,0,0,0,,20 секунд! Өлтіру... Өлтіруші?
Dialogue: 0,0:10:58.07,0:10:59.61,Default,,0,0,0,,10 ９…
Dialogue: 0,0:10:59.74,0:11:00.74,Default,,0,0,0,,Бір сәт!
Dialogue: 0,0:11:00.99,0:11:02.16,Default,,0,0,0,,Ойыншының аты
Dialogue: 0,0:11:02.28,0:11:04.78,Default,,0,0,0,,Кейта Тории 19 жас ер
Dialogue: 0,0:11:04.91,0:11:08.66,Default,,0,0,0,,Менің 14 жастағы інім Шуджи де осы жоспардың бір бөлігі.
Dialogue: 0,0:11:08.79,0:11:10.75,Default,,0,0,0,,14 мені және Таме дегенді білдіреді.
Dialogue: 0,0:11:10.87,0:11:12.83,Default,,0,0,0,,３ ２…
Dialogue: 0,0:11:14.67,0:11:17.42,Default,,0,0,0,,Сәлем! Ол сонда болды.
Dialogue: 0,0:11:17.55,0:11:18.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:18.80,0:11:20.09,Default,,0,0,0,,Өл! (Тории/Шудзи) Уау!
Dialogue: 0,0:11:20.38,0:11:22.84,Default,,0,0,0,,қайсысы? Tsk!
Dialogue: 0,0:11:23.89,0:11:24.80,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:29.02,0:11:30.85,Default,,0,0,0,,Не... не? Теми
Dialogue: 0,0:11:30.98,0:11:33.98,Default,,0,0,0,,Енді өлтіруді доғарғаныңыз жөн.
Dialogue: 0,0:11:34.11,0:11:34.94,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:35.06,0:11:36.90,Default,,0,0,0,,Білмеймін, бірақ мені алдап жатқан сияқты...
Dialogue: 0,0:11:37.02,0:11:38.69,Default,,0,0,0,,Шулы, бейбақ!
Dialogue: 0,0:11:38.82,0:11:41.36,Default,,0,0,0,,Міне!
Dialogue: 0,0:11:41.86,0:11:43.11,Default,,0,0,0,,Сәлем! Арх!
Dialogue: 0,0:11:44.66,0:11:46.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:47.83,0:11:49.04,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:11:50.41,0:11:54.29,Default,,0,0,0,,Менің сөзімді түсіне алмайтын ақымақтар тітіркенеді!
Dialogue: 0,0:11:54.75,0:11:55.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:56.17,0:11:57.00,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:11:57.29,0:12:00.55,Default,,0,0,0,,Міне, мен ақымақпын деп алданып, осындай жерге келдім.
Dialogue: 0,0:12:00.67,0:12:01.67,Default,,0,0,0,,О!
Dialogue: 0,0:12:05.39,0:12:08.10,Default,,0,0,0,,Шуджи! Теме!
Dialogue: 0,0:12:08.22,0:12:10.89,Default,,0,0,0,,Шуджи сенің ініңнің есімі ме?
Dialogue: 0,0:12:11.14,0:12:12.44,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:12:15.15,0:12:17.02,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:12:20.86,0:12:22.86,Default,,0,0,0,,Нысана қашып үлгерді.
Dialogue: 0,0:12:23.07,0:12:25.28,Default,,0,0,0,,Полиция келе жатыр, ағаңды ертіп жүгір.
Dialogue: 0,0:12:25.41,0:12:26.28,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:12:26.53,0:12:27.66,Default,,0,0,0,,Мен сені өлтіруім керек!
Dialogue: 0,0:12:28.24,0:12:31.04,Default,,0,0,0,,Неге мені мазалайсың! Екінші адам - ​​топоз сатушысы.
Dialogue: 0,0:12:31.16,0:12:32.83,Default,,0,0,0,,Мен өлуге қарсы емеспін!
Dialogue: 0,0:12:32.96,0:12:34.25,Default,,0,0,0,,Неліктен сіз біреуді осылай қорғайсыз?
Dialogue: 0,0:12:34.37,0:12:36.00,Default,,0,0,0,,Оның кім екені маңызды емес.
Dialogue: 0,0:12:36.38,0:12:37.59,Default,,0,0,0,,Маған сені өлтіруге жол берме!
Dialogue: 0,0:12:39.75,0:12:40.63,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:41.34,0:12:42.59,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:12:42.72,0:12:44.13,Default,,0,0,0,,Уау, мен түсінбедім!
Dialogue: 0,0:12:44.26,0:12:46.51,Default,,0,0,0,,Бала... Орта мектеп туралы бала!
Dialogue: 0,0:12:47.18,0:12:48.51,Default,,0,0,0,,Гаки?
Dialogue: 0,0:12:48.64,0:12:49.64,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:12:50.35,0:12:51.56,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:12:54.60,0:12:56.35,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:13:01.69,0:13:02.69,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:13:04.70,0:13:07.70,Default,,0,0,0,,Сіз Кодангумиде жұмыс істейсіз бе?
Dialogue: 0,0:13:08.20,0:13:10.53,Default,,0,0,0,,Жоқ, ол басқаша.
Dialogue: 0,0:13:11.45,0:13:13.79,Default,,0,0,0,,Маған өтірік айтпа, балақай!
Dialogue: 0,0:13:17.12,0:13:19.00,Default,,0,0,0,,Эй Ю-кун
Dialogue: 0,0:13:29.85,0:13:31.18,Default,,0,0,0,,Оған өз күнәларының ауырлығын түсіну үшін—
Dialogue: 0,0:13:34.48,0:13:35.68,Default,,0,0,0,,Сіз оны пайдаланасыз ба?
Dialogue: 0,0:13:36.31,0:13:37.44,Default,,0,0,0,,Қолғап?
Dialogue: 0,0:13:41.11,0:13:41.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:42.07,0:13:42.90,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:13:46.32,0:13:47.91,Default,,0,0,0,,Биомагия!
Dialogue: 0,0:13:49.11,0:13:51.03,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:13:54.20,0:13:55.04,Default,,0,0,0,,Уау
Dialogue: 0,0:13:58.50,0:13:59.38,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:14:06.97,0:14:10.30,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:14:12.68,0:14:14.64,Default,,0,0,0,,Ах~ Иә!
Dialogue: 0,0:14:16.18,0:14:18.31,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:14:20.56,0:14:22.15,Default,,0,0,0,,Әй, ақыры келді.
Dialogue: 0,0:14:22.69,0:14:24.11,Default,,0,0,0,,Чип, полиция көлігі!
Dialogue: 0,0:14:24.23,0:14:25.15,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:14:25.53,0:14:27.19,Default,,0,0,0,,Неге ініңді алып қашпайсың?
Dialogue: 0,0:14:27.44,0:14:29.49,Default,,0,0,0,,Эй, сен...
Dialogue: 0,0:14:29.61,0:14:30.49,Default,,0,0,0,,(шу)
Dialogue: 0,0:14:30.61,0:14:31.45,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:14:33.49,0:14:34.33,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:36.54,0:14:37.41,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:14:37.96,0:14:41.21,Default,,0,0,0,,Сіздің өміріңіз кімге тиесілі деп ойлайсыз?
Dialogue: 0,0:14:41.33,0:14:42.67,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:14:43.54,0:14:46.59,Default,,0,0,0,,Бәйбішеден жеңіліп қана қоймай, арқамнан оқ тиіп кетті.
Dialogue: 0,0:14:49.01,0:14:51.43,Default,,0,0,0,,Әй, бәрі бітті!
Dialogue: 0,0:14:51.68,0:14:52.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:55.14,0:14:56.68,Default,,0,0,0,,Бауырым, тездет!
Dialogue: 0,0:14:57.73,0:14:59.60,Default,,0,0,0,,Не? А... аа
Dialogue: 0,0:15:03.52,0:15:06.44,Default,,0,0,0,,Олар қайда жоғалып кетті?
Dialogue: 0,0:15:08.82,0:15:10.86,Default,,0,0,0,,Бұл квестті аяқтайды, солай ма?
Dialogue: 0,0:15:10.99,0:15:11.99,Default,,0,0,0,,Онда мен үйге барамын...
Dialogue: 0,0:15:12.11,0:15:14.33,Default,,0,0,0,,Бір сәт сөйлесейік
Dialogue: 0,0:15:14.49,0:15:15.33,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:16.45,0:15:19.75,Default,,0,0,0,,Сіз бүгін кісі өлтіруді тоқтаттыңыз.
Dialogue: 0,0:15:20.41,0:15:21.25,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:15:22.25,0:15:26.46,Default,,0,0,0,,Біреуді өлтіргенде қандай сезімде болдыңыз?
Dialogue: 0,0:15:28.51,0:15:29.80,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:15:31.13,0:15:34.60,Default,,0,0,0,,Бірақ мен не істеу керектігін білемін деп ойлаймын.
Dialogue: 0,0:15:35.30,0:15:39.18,Default,,0,0,0,,Егер сол ағамыз қолға түссе, квесттің сәттілігі төмендейді, солай ма?
Dialogue: 0,0:15:41.85,0:15:45.77,Default,,0,0,0,,Токитате мырзаға көмектесер алдында айтқан сөздеріңіз есімде.
Dialogue: 0,0:15:51.28,0:15:55.53,Default,,0,0,0,,Мен шешкен соңғы квест Токитате мырза болды.
Dialogue: 0,0:15:56.08,0:15:59.45,Default,,0,0,0,,Себебі мен Токитате мырзаны қолыма алдым.
Dialogue: 0,0:15:59.58,0:16:01.66,Default,,0,0,0,,Бұл табыс деңгейінің жоғарылағанын білдіре ме?
Dialogue: 0,0:16:03.17,0:16:06.59,Default,,0,0,0,,Сол кісілік қасиетімен Токитате мырза соңына дейін шыдай алды.
Dialogue: 0,0:16:07.29,0:16:10.21,Default,,0,0,0,,Менің ешқандай жалаңаш фотосуреттер тарап кеткен жоқ
Dialogue: 0,0:16:10.34,0:16:13.93,Default,,0,0,0,,Оның қайтып оралғысы келген шынайы әлем бар болғандықтан ба?
Dialogue: 0,0:16:14.72,0:16:17.01,Default,,0,0,0,,Бұл тек психикалық аспектіде.
Dialogue: 0,0:16:17.14,0:16:19.93,Default,,0,0,0,,Квесттердің сәттілігі сөзсіз өсті.
Dialogue: 0,0:16:21.93,0:16:23.27,Default,,0,0,0,,Ал бұл жолы...
Dialogue: 0,0:16:25.98,0:16:28.65,Default,,0,0,0,,Жаңа ойыншылардың қайтқысы келетінін тудырады
Dialogue: 0,0:16:28.77,0:16:32.36,Default,,0,0,0,,Мен де, ағам да тұтқындалмаған дүние жасадым.
Dialogue: 0,0:16:33.15,0:16:35.91,Default,,0,0,0,,Бұл келесі жолы да табыс деңгейі жоғарылағанын білдіреді!
Dialogue: 0,0:16:36.03,0:16:37.24,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:16:37.62,0:16:38.53,Default,,0,0,0,,Не?
Dialogue: 0,0:16:39.70,0:16:41.58,Default,,0,0,0,,Өмірдің киелілігі туралы не айтасыз?
Dialogue: 0,0:16:43.58,0:16:46.50,Default,,0,0,0,,Ха, бұл қымбат емес пе?
Dialogue: 0,0:16:47.67,0:16:50.67,Default,,0,0,0,,Ондай ақымақ біреуді өлтіру үшін алданып қалады.
Dialogue: 0,0:16:50.80,0:16:52.72,Default,,0,0,0,,Әрқайсымыз өлеміз деп үміттенемін.
Dialogue: 0,0:16:56.22,0:16:58.10,Default,,0,0,0,,Біз шынымен адамбыз ба?
Dialogue: 0,0:16:58.22,0:17:00.60,Default,,0,0,0,,Ең төменгі мән бойынша өлу керек.
Dialogue: 0,0:17:01.18,0:17:02.27,Default,,0,0,0,,Тіпті сол аққұба
Dialogue: 0,0:17:02.39,0:17:04.81,Default,,0,0,0,,Ойыншы болмасаңыз, бұл сізге қажет емес.
Dialogue: 0,0:17:08.56,0:17:10.73,Default,,0,0,0,,Шынымен күлкілі (полиция көлігінің сиренасы)
Dialogue: 0,0:17:10.86,0:17:11.90,Default,,0,0,0,,Наката деген кім?
Dialogue: 0,0:17:12.03,0:17:14.57,Default,,0,0,0,,Теннис клубындағы жасөспірімдерге де ұнаған сияқты.
Dialogue: 0,0:17:14.70,0:17:15.78,Default,,0,0,0,,Басқа полиция көлігі?
Dialogue: 0,0:17:16.28,0:17:18.62,Default,,0,0,0,,Айтпақшы, біраздан бері шу болды.
Dialogue: 0,0:17:18.74,0:17:21.04,Default,,0,0,0,,Бірдеңе болды ма? (Қыз А) Кісі өлтіру ме?
Dialogue: 0,0:17:21.16,0:17:22.37,Default,,0,0,0,,Не? Қорқынышты!
Dialogue: 0,0:17:22.49,0:17:25.75,Default,,0,0,0,,Эй Иу, бұл кісі өлтіру немесе басқа нәрсе болса, қорқынышты болар еді.
Dialogue: 0,0:17:25.87,0:17:27.54,Default,,0,0,0,,Кісі өлтіру?
Dialogue: 0,0:17:28.13,0:17:29.92,Default,,0,0,0,,Бұл өте қиын, солай емес пе?
Dialogue: 0,0:17:30.29,0:17:33.30,Default,,0,0,0,,Тығыз дегенді қалай түсінесіңдер?
Dialogue: 0,0:17:33.46,0:17:35.55,Default,,0,0,0,,А... Кешіріңіз, мен бірдеңе дедім бе?
Dialogue: 0,0:17:35.67,0:17:37.34,Default,,0,0,0,,Иә? Сенімен бәрі жақсы ма?
Dialogue: 0,0:17:37.76,0:17:39.01,Default,,0,0,0,,Бүгін бізде кірпі...
Dialogue: 0,0:17:39.14,0:17:40.47,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:17:40.64,0:17:41.85,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:17:41.97,0:17:45.89,Default,,0,0,0,,Әй, мылтық ұстаған адамды вокзал алдында ұстады!
Dialogue: 0,0:17:46.02,0:17:47.35,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:17:49.19,0:17:50.19,Default,,0,0,0,,Сіз қорықпайсыз ба?
Dialogue: 0,0:17:50.31,0:17:51.65,Default,,0,0,0,,Бұл қорқынышты~
Dialogue: 0,0:17:54.44,0:17:57.95,Default,,0,0,0,,Жарайды, мен кешкі ас әзірлеймін, шомылуға бола ма?
Dialogue: 0,0:17:58.20,0:17:59.99,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:18:03.33,0:18:06.00,Default,,0,0,0,,Бұрын менің көршіме ұры кіріп кеткен.
Dialogue: 0,0:18:06.12,0:18:08.75,Default,,0,0,0,,Сен қорқып жылап тұрдың.
Dialogue: 0,0:18:11.25,0:18:13.67,Default,,0,0,0,,Синдо мырза мен Хакозаки мырзаның аман қалу деңгейі
Dialogue: 0,0:18:14.42,0:18:17.76,Default,,0,0,0,,Мен сізге оны тіпті 1% арттыруға көмектестім.
Dialogue: 0,0:18:18.22,0:18:21.05,Default,,0,0,0,,Сәлем! Сіз ұмыттыңыз ба? Біз туралы
Dialogue: 0,0:18:23.39,0:18:25.64,Default,,0,0,0,,Өйткені сіз мұнда соңғы кездері болған жоқсыз.
Dialogue: 0,0:18:25.77,0:18:28.73,Default,,0,0,0,,Жоқ, көп нәрсе болды.
Dialogue: 0,0:18:28.85,0:18:32.06,Default,,0,0,0,,Менің ойымша, сіз өзімді аздап көңілсіз сезіндім деп айта аласыз.
Dialogue: 0,0:18:32.19,0:18:34.40,Default,,0,0,0,,А, бірақ уайымдама! Мен қазір толықтай жақсымын...
Dialogue: 0,0:18:34.53,0:18:36.61,Default,,0,0,0,,Аа, бүгін үйге қайтып бара жатырмын.
Dialogue: 0,0:18:36.74,0:18:38.49,Default,,0,0,0,,Полиция көлігінің сиренасы шырылдады!
Dialogue: 0,0:18:38.61,0:18:40.20,Default,,0,0,0,,Әй, мен әңгіменің ортасындамын!
Dialogue: 0,0:18:40.32,0:18:42.70,Default,,0,0,0,,Не болды? Бұл өте қауіпті емес пе?
Dialogue: 0,0:18:42.83,0:18:44.08,Default,,0,0,0,,Интернетті қарасаңыз да, ақпарат жоқ...
Dialogue: 0,0:18:44.20,0:18:46.25,Default,,0,0,0,,Мен саған ішетін бірдеңе әкелемін.
Dialogue: 0,0:18:46.54,0:18:49.67,Default,,0,0,0,,Бұл біртүрлі. Біртүрлі!
Dialogue: 0,0:18:49.87,0:18:52.29,Default,,0,0,0,,Сол кезде мен ойладым
Dialogue: 0,0:18:52.42,0:18:56.00,Default,,0,0,0,,Қандай да бір сұмдық құпия жасырылған ба деп ойлаймын!
Dialogue: 0,0:18:56.13,0:18:57.42,Default,,0,0,0,,Күні кеше мен видео көріп отыр едім.
Dialogue: 0,0:18:57.55,0:18:59.59,Default,,0,0,0,,Сіз кеңестің жасырылғанын байқадыңыз!
Dialogue: 0,0:18:59.72,0:19:01.64,Default,,0,0,0,,Пуха~
Dialogue: 0,0:19:01.76,0:19:05.06,Default,,0,0,0,,Айтпақшы, келесі квест қашан?
Dialogue: 0,0:19:08.77,0:19:11.35,Default,,0,0,0,,Адамның құндылығы...
Dialogue: 0,0:19:12.60,0:19:14.86,Default,,0,0,0,,Анонимді интернет пайдаланушысы сияқты
Dialogue: 0,0:19:14.98,0:19:16.69,Default,,0,0,0,,Рұқсатсыз жоғарыдан қарау
Dialogue: 0,0:19:16.82,0:19:18.90,Default,,0,0,0,,Оны анықтаңыз
Dialogue: 0,0:19:19.99,0:19:22.61,Default,,0,0,0,,Сіздің ниетіңіз қандай?
Dialogue: 0,0:19:26.66,0:19:30.16,Default,,0,0,0,,Ол ештеңе емес, ол жай ғана бала.
Dialogue: 0,0:19:31.12,0:19:33.58,Default,,0,0,0,,Ол жай ғана орта мектеп ауруына шалдыққан сұм бала.
Dialogue: 0,0:19:34.54,0:19:37.84,Default,,0,0,0,,Мен қателескенімді түсіндім
Dialogue: 0,0:19:38.71,0:19:39.84,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:19:40.59,0:19:41.59,Default,,0,0,0,,Мен мойындаймын.
Dialogue: 0,0:19:42.72,0:19:44.89,Default,,0,0,0,,Мен шынымен білемін
Dialogue: 0,0:19:46.47,0:19:49.06,Default,,0,0,0,,Бірақ бұл не екені маған қызық.
Dialogue: 0,0:19:49.27,0:19:50.85,Default,,0,0,0,,Мен оны сезбеймін.
Dialogue: 0,0:19:51.19,0:19:54.90,Default,,0,0,0,,Менің ғана айтқаным дұрыс, қоғамда бәрі бұрыс
Dialogue: 0,0:19:55.44,0:19:57.07,Default,,0,0,0,,Соған ұқсайды.
Dialogue: 0,0:19:57.32,0:20:00.28,Default,,0,0,0,,Жарайды, бұл да Чуунибюдің белгісі.
Dialogue: 0,0:20:00.40,0:20:02.11,Default,,0,0,0,,Мен оны білім деп білемін.
Dialogue: 0,0:20:03.03,0:20:03.86,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:06.28,0:20:08.29,Default,,0,0,0,,«Сосын ше?» деген сұрақ.
Dialogue: 0,0:20:11.46,0:20:12.79,Default,,0,0,0,,Мен барлығына көмектескім келеді
Dialogue: 0,0:20:12.92,0:20:14.75,Default,,0,0,0,,Маған өлуге рұқсат етіңіз!
Dialogue: 0,0:20:14.88,0:20:15.83,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:20:17.04,0:20:17.88,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:20:18.55,0:20:19.55,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:20:21.22,0:20:22.47,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:20:29.14,0:20:30.64,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:20:33.39,0:20:36.61,Default,,0,0,0,,Мен тек әділдік деп сенетін нәрсе үшін күресемін.
Dialogue: 0,0:20:37.27,0:20:40.28,Default,,0,0,0,,Әрқашан болған және болады
Dialogue: 0,0:20:53.29,0:20:59.29,Default,,0,0,0,,♪～
Dialogue: 0,0:22:16.71,0:22:22.71,Default,,0,0,0,,～♪
Dialogue: 0,0:22:30.22,0:22:32.14,Default,,0,0,0,,Мен ол қаланы жек көремін.
Dialogue: 0,0:22:32.85,0:22:36.02,Default,,0,0,0,,Мен бұл қалада тұратын адамдарды жек көремін.
Dialogue: 0,0:22:44.27,0:22:45.32,Default,,0,0,0,,Ғарыш кеңістігі
Dialogue: 0,0:22:45.44,0:22:48.78,Default,,0,0,0,,Шиеленіс Токиодағыдан бірнеше есе жоғары!
Dialogue: 0,0:22:49.95,0:22:51.78,Default,,0,0,0,,Бұдан былай барлығына
Dialogue: 0,0:22:51.91,0:22:55.12,Default,,0,0,0,,Адамзат үшін жүрегіңді берші.
Dialogue: 0,0:23:11.05,0:23:12.84,Default,,0,0,0,,Менің тағамдарымды жеп жатыр
Dialogue: 0,0:23:13.14,0:23:15.26,Default,,0,0,0,,Хаха~!
Dialogue: 0,0:23:15.85,0:23:18.06,Default,,0,0,0,,Бірден көп ақиқат болуы мүмкін
Dialogue: 0,0:23:26.73,0:23:27.57,Default,,0,0,0,,Мен ЖоЖомен шайқасуға оралдым!
Dialogue: 0,0:23:27.82,0:23:28.65,Default,,0,0,0,,Мен де
Dialogue: 0,0:23:28.99,0:23:29.86,Default,,0,0,0,,Мен де
Dialogue: 0,0:23:30.40,0:23:31.61,Default,,0,0,0,,Біз...
Dialogue: 0,0:23:33.28,0:23:35.91,Default,,0,0,0,,«Мен миллион өмірдің үстінде тұрмын».
Dialogue: 0,0:23:36.03,0:23:37.49,Default,,0,0,0,,2 маусым…
Dialogue: 0,0:23:37.62,0:23:39.04,Default,,0,0,0,,Жақында.
Dialogue: 0,0:23:40.54,0:23:46.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory