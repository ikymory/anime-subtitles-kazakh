Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.21,0:00:12.05,Default,,0,0,0,,Угья~!
Dialogue: 0,0:00:17.80,0:00:18.64,Default,,0,0,0,,Ки!
Dialogue: 0,0:00:20.06,0:00:21.93,Default,,0,0,0,,Маған бір адам ұнайды
Dialogue: 0,0:00:26.31,0:00:28.11,Default,,0,0,0,,Мен ол қаланы жек көремін.
Dialogue: 0,0:00:33.90,0:00:37.20,Default,,0,0,0,,Мен сол қалада тұратындарды жек көремін.
Dialogue: 0,0:00:40.33,0:00:41.29,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:00:51.67,0:00:54.09,Default,,0,0,0,,Өмірге қауіп төнген жағдайда да
Dialogue: 0,0:00:54.55,0:00:58.60,Default,,0,0,0,,Бұл жерде шиеленіс Токиодағыдан бірнеше есе жоғары.
Dialogue: 0,0:01:03.35,0:01:09.36,Default,,0,0,0,,♪～
Dialogue: 0,0:02:26.52,0:02:32.52,Default,,0,0,0,,～♪
Dialogue: 0,0:02:52.75,0:02:54.71,Default,,0,0,0,,Бірінші кезеңдегі дене шынықтыру - бұл сұмдық.
Dialogue: 0,0:02:54.84,0:02:56.30,Default,,0,0,0,,А, бұл маңызды.
Dialogue: 0,0:02:56.42,0:02:58.05,Default,,0,0,0,,Кешегі Мико тікелей эфирде...
Dialogue: 0,0:02:58.17,0:03:00.05,Default,,0,0,0,,Жоқ, мен шынымен ұйықтап қалдым.
Dialogue: 0,0:03:00.17,0:03:01.76,Default,,0,0,0,,Шынымен, жылдам емес пе?
Dialogue: 0,0:03:02.76,0:03:03.72,Default,,0,0,0,,Юта Номура
Dialogue: 0,0:03:03.85,0:03:04.68,Default,,0,0,0,,Иә
Dialogue: 0,0:03:04.80,0:03:06.43,Default,,0,0,0,,Косуэ Хакозаки
Dialogue: 0,0:03:06.85,0:03:09.98,Default,,0,0,0,,... денсаулығына байланысты келмеген.
Dialogue: 0,0:03:10.31,0:03:13.02,Default,,0,0,0,,Хакозаки жақсы демалып жатыр.
Dialogue: 0,0:03:13.19,0:03:15.19,Default,,0,0,0,,Сіз әлсіз сияқтысыз.
Dialogue: 0,0:03:15.32,0:03:16.98,Default,,0,0,0,,Дене тәрбиесі де толығымен жабылған.
Dialogue: 0,0:03:17.11,0:03:18.15,Default,,0,0,0,,Эй, сен мұны естідің бе?
Dialogue: 0,0:03:18.28,0:03:20.86,Default,,0,0,0,,1-топтағы Наката мырза Синдо мырзаға қатты әсер еткен сияқты.
Dialogue: 0,0:03:20.99,0:03:21.82,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:03:22.07,0:03:22.95,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:03:23.07,0:03:24.28,Default,,0,0,0,,Мен бұған жол бере алмаймын.
Dialogue: 0,0:03:24.41,0:03:28.29,Default,,0,0,0,,Ах~ Мансап нұсқаларын ұсынбағандар ертеңге дейін тапсыруы керек.
Dialogue: 0,0:03:28.75,0:03:30.29,Default,,0,0,0,,Қазір караокеге барайық па?
Dialogue: 0,0:03:34.04,0:03:35.00,Default,,0,0,0,,Қараңдар, мынау, мынау, мынау.
Dialogue: 0,0:03:35.13,0:03:36.67,Default,,0,0,0,,Не? Бұл Синдо-сан.
Dialogue: 0,0:03:37.05,0:03:39.38,Default,,0,0,0,,Ол барлау жүргізді және «Петит Лимонды» оқып жатыр.
Dialogue: 0,0:03:39.51,0:03:40.84,Default,,0,0,0,,Бұл ауыр болды ма?
Dialogue: 0,0:03:41.22,0:03:43.13,Default,,0,0,0,,Ол әдемі және жақсы бағалары бар...
Dialogue: 0,0:03:43.51,0:03:44.34,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:44.47,0:03:45.51,Default,,0,0,0,,Кя~!
Dialogue: 0,0:03:45.64,0:03:46.47,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:46.60,0:03:48.01,Default,,0,0,0,,Хахаха
Dialogue: 0,0:03:48.97,0:03:50.64,Default,,0,0,0,,(Қоңырау үнін енгізу)
Dialogue: 0,0:03:56.40,0:03:57.48,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:03:58.57,0:04:00.74,Default,,0,0,0,,Ал... Хаа~
Dialogue: 0,0:04:01.78,0:04:03.49,Default,,0,0,0,,А, ештеңе жоқ.
Dialogue: 0,0:04:04.16,0:04:06.87,Default,,0,0,0,,Өйткені, сырттағы ағынның өзі солай.
Dialogue: 0,0:04:06.99,0:04:09.29,Default,,0,0,0,,Өте сақ екенсің Ахаха
Dialogue: 0,0:04:10.12,0:04:13.58,Default,,0,0,0,,Я... уф!
Dialogue: 0,0:04:14.58,0:04:16.83,Default,,0,0,0,,Жарайды, жүр, жүр, жүр!
Dialogue: 0,0:04:16.96,0:04:18.63,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:04:19.46,0:04:22.09,Default,,0,0,0,,Ху~ Бұл қауіпті болды.
Dialogue: 0,0:04:46.82,0:04:47.87,Default,,0,0,0,,Синдо мырза
Dialogue: 0,0:04:47.99,0:04:49.70,Default,,0,0,0,,Иә, кейінірек
Dialogue: 0,0:04:52.12,0:04:53.12,Default,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 0,0:04:59.50,0:05:01.25,Default,,0,0,0,,Ғажайып Синдо-сан
Dialogue: 0,0:05:01.38,0:05:03.42,Default,,0,0,0,,Ол өте әдемі.
Dialogue: 0,0:05:04.59,0:05:08.18,Default,,0,0,0,,Біз өмір сүріп жатқан әлем соншалық, менің ойыма ештеңе келмейді.
Dialogue: 0,0:05:08.85,0:05:10.64,Default,,0,0,0,,Бұл бүгін (Хокозаки) Иә.
Dialogue: 0,0:05:11.39,0:05:13.35,Default,,0,0,0,,Мен қобалжыдым.
Dialogue: 0,0:05:13.60,0:05:14.98,Default,,0,0,0,,Мен де
Dialogue: 0,0:05:15.31,0:05:17.02,Default,,0,0,0,,«Дене шынықтыру бойынша толық үзіліс»…
Dialogue: 0,0:05:17.60,0:05:20.27,Default,,0,0,0,,Бұл екеуі осылай араласқан ба?
Dialogue: 0,0:05:21.57,0:05:22.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:22.78,0:05:25.03,Default,,0,0,0,,Қазір не болып жатыр?
Dialogue: 0,0:05:28.28,0:05:32.70,Default,,0,0,0,,Мамандық таңдауды тапсырмаған жалғыз адамсың, Йоцуя.
Dialogue: 0,0:05:34.29,0:05:35.96,Default,,0,0,0,,Өйткені ол жылдам болды
Dialogue: 0,0:05:36.08,0:05:38.83,Default,,0,0,0,,Егер мен жеңіл атлетика үйірмесіне қосылсам, сол орта мектепке түсуім мүмкін еді.
Dialogue: 0,0:05:39.13,0:05:40.71,Default,,0,0,0,,күрсіну... Ах.
Dialogue: 0,0:05:47.30,0:05:48.89,Default,,0,0,0,,Тағы да екеуі
Dialogue: 0,0:05:49.22,0:05:51.93,Default,,0,0,0,,Солай болса да, бұл әдеттен тыс комбинация.
Dialogue: 0,0:05:52.06,0:05:54.60,Default,,0,0,0,,Сіз шынымен ештеңе істегіңіз келмейді ме?
Dialogue: 0,0:05:55.22,0:05:57.89,Default,,0,0,0,,Мен үйге ертерек барып, ойынды жалғастырғым келеді.
Dialogue: 0,0:05:58.64,0:06:01.19,Default,,0,0,0,,Мен көп нәрсені ойладым, бірақ ештеңе болмады.
Dialogue: 0,0:06:01.31,0:06:03.57,Default,,0,0,0,,Мені бұл мектеп қызықтырмайды.
Dialogue: 0,0:06:03.98,0:06:06.99,Default,,0,0,0,,Сіз әрқашан айтқыңыз келген нәрсені айтпайсыз.
Dialogue: 0,0:06:07.65,0:06:09.86,Default,,0,0,0,,Ашық сөйлесетін достарың жоқ сияқты.
Dialogue: 0,0:06:09.99,0:06:11.41,Default,,0,0,0,,Сен оны орта мектепте жасай алмайсың.
Dialogue: 0,0:06:11.70,0:06:12.99,Default,,0,0,0,,О, мен білдім.
Dialogue: 0,0:06:13.12,0:06:14.54,Default,,0,0,0,,Үйдегі мұғалім керемет
Dialogue: 0,0:06:14.87,0:06:17.12,Default,,0,0,0,,Мен солай деп ойлаймын.
Dialogue: 0,0:06:17.25,0:06:20.83,Default,,0,0,0,,Кәдімгі мектепке жақын қалаған мектепті тауып, жазып ал.
Dialogue: 0,0:06:21.13,0:06:22.92,Default,,0,0,0,,Қалай болғанда да, ертең жіберіңіз.
Dialogue: 0,0:06:23.04,0:06:23.92,Default,,0,0,0,,Иә
Dialogue: 0,0:06:25.63,0:06:27.59,Default,,0,0,0,,Үйге барып ойын ойнайық!
Dialogue: 0,0:06:28.09,0:06:29.84,Default,,0,0,0,,А, мен есікті құлыптаймын.
Dialogue: 0,0:06:29.97,0:06:31.47,Default,,0,0,0,,Мен кезекшімін, сондықтан...
Dialogue: 0,0:06:33.26,0:06:34.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:34.64,0:06:36.06,Default,,0,0,0,,Қашан шықты?
Dialogue: 0,0:06:43.69,0:06:44.98,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:06:45.11,0:06:46.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:48.57,0:06:49.45,Default,,0,0,0,,Ах
Dialogue: 0,0:06:56.70,0:06:57.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:01.33,0:07:02.25,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:07:03.08,0:07:05.09,Default,,0,0,0,,Ах, а... а~!
Dialogue: 0,0:07:11.38,0:07:15.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:19.85,0:07:22.02,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:07:23.06,0:07:24.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.69,0:07:26.40,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:07:30.61,0:07:33.28,Default,,0,0,0,,Не болды!
Dialogue: 0,0:07:33.95,0:07:35.99,Default,,0,0,0,,Уау, бұл ақылсыз! Бұл не?
Dialogue: 0,0:07:36.16,0:07:36.99,Default,,0,0,0,,Йоцуя-кун
Dialogue: 0,0:07:37.41,0:07:38.41,Default,,0,0,0,,Уа, ау?
Dialogue: 0,0:07:38.66,0:07:40.79,Default,,0,0,0,,Ия, ақыры ұл!
Dialogue: 0,0:07:40.91,0:07:45.21,Default,,0,0,0,,Синдо мырзамен... у...
Dialogue: 0,0:07:46.88,0:07:48.17,Default,,0,0,0,,Бұл Хакозаки
Dialogue: 0,0:07:50.55,0:07:52.01,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:52.22,0:07:54.22,Default,,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:07:54.34,0:07:57.05,Default,,0,0,0,,Көрдіңіз бе, бұдан былай жарты жүзді бұзық шығады.
Dialogue: 0,0:07:57.18,0:07:58.64,Default,,0,0,0,,Дүрбелеңсіз тыңдаңыз
Dialogue: 0,0:07:58.76,0:07:59.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:59.77,0:08:03.06,Default,,0,0,0,,Танысқаныма қуаныштымын. Сәлем.
Dialogue: 0,0:08:06.06,0:08:08.90,Default,,0,0,0,,Менің атым ойын шебері.
Dialogue: 0,0:08:09.57,0:08:10.86,Default,,0,0,0,,Осыдан кейін.
Dialogue: 0,0:08:11.03,0:08:12.45,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:08:12.70,0:08:14.36,Default,,0,0,0,,Бас ше? Бас... Бас!
Dialogue: 0,0:08:14.86,0:08:17.53,Default,,0,0,0,,Ережелерді түсіндіруді бастайық.
Dialogue: 0,0:08:17.66,0:08:18.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:18.62,0:08:23.00,Default,,0,0,0,,Бұдан былай мен саған, жаңадан келген адамға бұйрық беремін.
Dialogue: 0,0:08:23.29,0:08:26.29,Default,,0,0,0,,Оны бірге тазалаңыз.
Dialogue: 0,0:08:26.42,0:08:27.50,Default,,0,0,0,,Жоқ, не? Күте тұрыңыз
Dialogue: 0,0:08:27.63,0:08:28.71,Default,,0,0,0,,Тыңда, Йоцуя-кун.
Dialogue: 0,0:08:28.92,0:08:31.30,Default,,0,0,0,,Осы жерден іздеңіз.
Dialogue: 0,0:08:31.63,0:08:33.93,Default,,0,0,0,,Ауыл бастығының өтінішін орындау.
Dialogue: 0,0:08:34.05,0:08:36.30,Default,,0,0,0,,Уақыт шегі 14 күн.
Dialogue: 0,0:08:36.43,0:08:38.10,Default,,0,0,0,,Өз бетіңізше әрекет етпеңіз!
Dialogue: 0,0:08:38.22,0:08:40.06,Default,,0,0,0,,Жоқ, тыңдаңыз!
Dialogue: 0,0:08:40.31,0:08:42.73,Default,,0,0,0,,Бұл дүниеде құбыжықтар
Dialogue: 0,0:08:42.85,0:08:45.69,Default,,0,0,0,,Бізді ақымақтарды келіп өлтірмеңдер!
Dialogue: 0,0:08:45.81,0:08:46.69,Default,,0,0,0,,Бір рет күтіңіз!
Dialogue: 0,0:08:46.81,0:08:48.06,Default,,0,0,0,,Сонымен... (Йоцуя) Жоқ, өйткені!
Dialogue: 0,0:08:48.27,0:08:49.15,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:08:50.44,0:08:53.28,Default,,0,0,0,,Иә? Бұл ауырмайды
Dialogue: 0,0:08:53.57,0:08:56.61,Default,,0,0,0,,Толық басып алуға дейін 8 айналым қалды.
Dialogue: 0,0:08:57.11,0:09:00.70,Default,,0,0,0,,Әр айналымнан кейін адам саны бір адамға көбейді.
Dialogue: 0,0:09:00.83,0:09:04.21,Default,,0,0,0,,Соңында 10 адаммен тазалаңыз.
Dialogue: 0,0:09:05.33,0:09:07.58,Default,,0,0,0,,Стратегия? Таза?
Dialogue: 0,0:09:07.92,0:09:12.51,Default,,0,0,0,,Әр айналымды тазалағаныңыз үшін сыйақы туралы кейінірек екеуіңізден сұраңыз.
Dialogue: 0,0:09:13.30,0:09:14.88,Default,,0,0,0,,Иу Синдо
Dialogue: 0,0:09:16.80,0:09:19.18,Default,,0,0,0,,Сиқыршы [Жел]
Dialogue: 0,0:09:21.85,0:09:26.52,Default,,0,0,0,,Косуэ Хакозаки жауынгері [Қылыш]
Dialogue: 0,0:09:29.23,0:09:34.69,Default,,0,0,0,,Ал үшінші ойыншы Юсуке Йоцуяның жұмысы...
Dialogue: 0,0:09:35.36,0:09:36.20,Default,,0,0,0,,Дорууруру…
Dialogue: 0,0:09:36.53,0:09:38.07,Default,,0,0,0,,Теледидардан жиі көретініңіз!
Dialogue: 0,0:09:38.20,0:09:39.57,Default,,0,0,0,,Жауынгер кел, жауынгер!
Dialogue: 0,0:09:39.70,0:09:41.99,Default,,0,0,0,,О? Не маңызды...
Dialogue: 0,0:09:44.08,0:09:45.29,Default,,0,0,0,,Ноуми.
Dialogue: 0,0:09:46.37,0:09:47.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:47.83,0:09:50.46,Default,,0,0,0,,Сонда тағы кездескенше.
Dialogue: 0,0:09:54.67,0:09:55.84,Default,,0,0,0,,Мм...
Dialogue: 0,0:09:55.97,0:09:56.80,Default,,0,0,0,,Фермер
Dialogue: 0,0:09:56.92,0:09:59.47,Default,,0,0,0,,Хаа~ Менің ойымша, бұл өте сирек емес.
Dialogue: 0,0:09:59.76,0:10:02.85,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:10:09.52,0:10:10.77,Default,,0,0,0,,Синдо мырза және т.б
Dialogue: 0,0:10:10.90,0:10:13.19,Default,,0,0,0,,Сізді кенеттен осында әкелді ме?
Dialogue: 0,0:10:13.40,0:10:14.82,Default,,0,0,0,,Алдымен I
Dialogue: 0,0:10:15.15,0:10:16.90,Default,,0,0,0,,Мен әйтеуір квестті өзім шешіп алдым.
Dialogue: 0,0:10:17.03,0:10:19.11,Default,,0,0,0,,Бастапқы әлемге оралғанда
Dialogue: 0,0:10:19.28,0:10:22.24,Default,,0,0,0,,Ойын шебері маған тапсырма берді.
Dialogue: 0,0:10:22.37,0:10:25.12,Default,,0,0,0,,Қайтып келгеннен кейін де квесттер бар ма?
Dialogue: 0,0:10:25.58,0:10:28.50,Default,,0,0,0,,Сонымен, Синдо мырзадан...
Dialogue: 0,0:10:28.87,0:10:30.00,Default,,0,0,0,,Хакозаки мырза
Dialogue: 0,0:10:34.80,0:10:36.84,Default,,0,0,0,,Менімен дос болғың келе ме?
Dialogue: 0,0:10:38.92,0:10:40.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:41.64,0:10:42.85,Default,,0,0,0,,Досыма
Dialogue: 0,0:10:43.10,0:10:43.93,Default,,0,0,0,,Ойын шебері болыңыз
Dialogue: 0,0:10:44.06,0:10:46.43,Default,,0,0,0,,Маған Бенисуэмен дос болуды тапсырды.
Dialogue: 0,0:10:50.90,0:10:54.57,Default,,0,0,0,,Сондықтан мен бұл дүниеге келесі жолы келгенде, Бенисуэ сонда болды.
Dialogue: 0,0:11:00.78,0:11:02.28,Default,,0,0,0,,Аман-есен оралғанда
Dialogue: 0,0:11:02.41,0:11:06.41,Default,,0,0,0,,Келесі жолы маған сізбен, Бенисуэмен және менімен жалғыз қалу бұйырды.
Dialogue: 0,0:11:06.99,0:11:08.95,Default,,0,0,0,,Келесі - Йоцуя-кун.
Dialogue: 0,0:11:10.54,0:11:12.08,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:11:12.83,0:11:14.79,Default,,0,0,0,,Күндізгі ауысым болса, сынып есігін жабыңыз.
Dialogue: 0,0:11:14.92,0:11:17.88,Default,,0,0,0,,Соңына дейін сонда болғандықтан, бұл оңай жеңеді деп ойладым.
Dialogue: 0,0:11:18.01,0:11:20.05,Default,,0,0,0,,Мұғалім маған дәріс оқиды
Dialogue: 0,0:11:20.17,0:11:22.55,Default,,0,0,0,,Олай десеңіз де...
Dialogue: 0,0:11:23.18,0:11:24.64,Default,,0,0,0,,Мен қатты қобалжыдым.
Dialogue: 0,0:11:24.76,0:11:25.85,Default,,0,0,0,,Мен де
Dialogue: 0,0:11:25.97,0:11:28.56,Default,,0,0,0,,Мұғалімнің бірінші шыққанына көңілім толды.
Dialogue: 0,0:11:29.10,0:11:32.85,Default,,0,0,0,,Мен бұл арман емес екенін білемін.
Dialogue: 0,0:11:33.56,0:11:34.65,Default,,0,0,0,,Қарулар Бізде не бар?
Dialogue: 0,0:11:34.77,0:11:35.61,Default,,0,0,0,,Ол осы мамандық атауын беруге тікелей шабыт болған —
Dialogue: 0,0:11:35.82,0:11:37.15,Default,,0,0,0,,Көздеріңді қысыңдар
Dialogue: 0,0:11:37.27,0:11:38.15,Default,,0,0,0,,Уф
Dialogue: 0,0:11:39.19,0:11:40.07,Default,,0,0,0,,О!
Dialogue: 0,0:11:40.19,0:11:41.49,Default,,0,0,0,,Оны түртіңіз
Dialogue: 0,0:11:41.78,0:11:43.82,Default,,0,0,0,,Өйткені оны смартфон сияқты басқаруға болады
Dialogue: 0,0:11:43.99,0:11:46.08,Default,,0,0,0,,Уа, ау, ау!
Dialogue: 0,0:11:46.58,0:11:48.08,Default,,0,0,0,,Қару ретінде пайдалануға болатын заттар
Dialogue: 0,0:11:48.20,0:11:51.12,Default,,0,0,0,,Тек сонда бар нәрсеге ие бола аласыз ба?
Dialogue: 0,0:11:52.92,0:11:53.75,Default,,0,0,0,,шықты
Dialogue: 0,0:11:54.63,0:11:55.46,Default,,0,0,0,,Кішкентай!
Dialogue: 0,0:11:55.58,0:11:56.67,Default,,0,0,0,,Хаа~
Dialogue: 0,0:11:57.09,0:12:00.63,Default,,0,0,0,,Кеп пен орақ... Әй, егіншімін ғой.
Dialogue: 0,0:12:02.26,0:12:06.64,Default,,0,0,0,,Бұл виртуалды кеңістік пе? Ойындар әлемі...
Dialogue: 0,0:12:07.01,0:12:08.81,Default,,0,0,0,,А, бұл не?
Dialogue: 0,0:12:08.93,0:12:10.02,Default,,0,0,0,,Ах, журнал.
Dialogue: 0,0:12:10.35,0:12:11.18,Default,,0,0,0,,Журнал?
Dialogue: 0,0:12:11.31,0:12:14.73,Default,,0,0,0,,Иә, кейде менде бұрынғы уақыттағы кадрлар бар.
Dialogue: 0,0:12:15.06,0:12:16.40,Default,,0,0,0,,Оны түрту арқылы көруге болады.
Dialogue: 0,0:12:32.41,0:12:34.75,Default,,0,0,0,,Бұл мен келгеннен кейін болды!
Dialogue: 0,0:12:34.87,0:12:37.17,Default,,0,0,0,,А-а-а, өтінемін, қарамашы~
Dialogue: 0,0:12:37.46,0:12:39.21,Default,,0,0,0,,Күннің соңында мен осылай дедім.
Dialogue: 0,0:12:39.34,0:12:43.59,Default,,0,0,0,,Алғашында үрейленгенім сонша, күні бойы ештеңе істей алмадым.
Dialogue: 0,0:12:43.76,0:12:48.10,Default,,0,0,0,,-де мен бұл шындық екенін және анықталғанын түсіндім.
Dialogue: 0,0:12:48.30,0:12:51.43,Default,,0,0,0,,Мм... Йоцуя-кун келді.
Dialogue: 0,0:12:51.56,0:12:53.77,Default,,0,0,0,,Бұл шынымен де сендіреді.
Dialogue: 0,0:12:53.89,0:12:58.19,Default,,0,0,0,,Мәселе мынада, егер сіз тапсырманы орындасаңыз, бастапқы қалаңызға орала аласыз, солай ма?
Dialogue: 0,0:13:01.90,0:13:03.28,Default,,0,0,0,,Сол қалада...
Dialogue: 0,0:13:03.90,0:13:05.36,Default,,0,0,0,,Міне! (Йоцуя) А?
Dialogue: 0,0:13:05.86,0:13:06.70,Default,,0,0,0,,Гоблин
Dialogue: 0,0:13:06.82,0:13:07.82,Default,,0,0,0,,Гоблин?
Dialogue: 0,0:13:08.62,0:13:10.87,Default,,0,0,0,,Дәл солай сезіледі.
Dialogue: 0,0:13:11.70,0:13:15.29,Default,,0,0,0,,Келіспесем де, қабылдаймын!
Dialogue: 0,0:13:16.17,0:13:18.79,Default,,0,0,0,,Менің шытырман оқиғам енді басталды!
Dialogue: 0,0:13:20.46,0:13:21.71,Default,,0,0,0,,Ой, бұзылды!
Dialogue: 0,0:13:21.88,0:13:23.13,Default,,0,0,0,,Пайдалану мүмкін емес
Dialogue: 0,0:13:23.34,0:13:26.05,Default,,0,0,0,,Ал, бұл сиқыршы және жауынгер, солай ма?
Dialogue: 0,0:13:26.18,0:13:27.05,Default,,0,0,0,,Қарама...
Dialogue: 0,0:13:29.85,0:13:30.93,Default,,0,0,0,,Жел!
Dialogue: 0,0:13:34.56,0:13:35.39,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:13:35.68,0:13:38.31,Default,,0,0,0,,Жел сиқыры тек ауаны жылжытады.
Dialogue: 0,0:13:38.44,0:13:40.48,Default,,0,0,0,,Менің деңгейім төмен болғандықтан солай.
Dialogue: 0,0:13:40.61,0:13:41.57,Default,,0,0,0,,Не болды!
Dialogue: 0,0:13:41.73,0:13:43.98,Default,,0,0,0,,Ах, бірақ қылыш болса
Dialogue: 0,0:13:44.32,0:13:45.44,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:13:45.57,0:13:46.40,Default,,0,0,0,,Қылышты қолына алғаннан кейін екі айдың ішінде-ақ қоғам тірегіне айналғандар да бар.
Dialogue: 0,0:13:46.53,0:13:47.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:47.49,0:13:48.32,Default,,0,0,0,,Кя!
Dialogue: 0,0:13:49.03,0:13:50.74,Default,,0,0,0,,Оны қалай пайдалану керек Жоқ!
Dialogue: 0,0:13:51.83,0:13:52.66,Default,,0,0,0,,Жабыңыз!
Dialogue: 0,0:13:53.45,0:13:54.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:54.75,0:13:55.70,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:13:55.83,0:13:58.71,Default,,0,0,0,,Қару тек тағайындалған адамда болуы мүмкін.
Dialogue: 0,0:13:58.83,0:14:01.42,Default,,0,0,0,,Хаа~ Бұл одан да ойын.
Dialogue: 0,0:14:01.84,0:14:05.26,Default,,0,0,0,,Бірақ... әлі бір кетмен бар!
Dialogue: 0,0:14:06.01,0:14:07.17,Default,,0,0,0,,Сынған!
Dialogue: 0,0:14:07.30,0:14:08.59,Default,,0,0,0,,Укья~!
Dialogue: 0,0:14:08.72,0:14:09.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:11.68,0:14:13.60,Default,,0,0,0,,Иә? Шынайы ма?
Dialogue: 0,0:14:13.89,0:14:17.23,Default,,0,0,0,,Мен өлемін бе?
Dialogue: 0,0:14:17.77,0:14:18.69,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:14:21.81,0:14:22.65,Default,,0,0,0,,Ах
Dialogue: 0,0:14:25.78,0:14:26.74,Default,,0,0,0,,Мен?
Dialogue: 0,0:14:27.49,0:14:28.40,Default,,0,0,0,,Кя~!
Dialogue: 0,0:14:28.53,0:14:30.74,Default,,0,0,0,,Ах, Хакозаки мырза!
Dialogue: 0,0:14:34.54,0:14:35.74,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:14:41.38,0:14:42.63,Default,,0,0,0,,Өмірге қайта ораласыз ба?
Dialogue: 0,0:14:42.88,0:14:45.55,Default,,0,0,0,,Уайымдамаңыз, сіз 30 секундта қайта тірілесіз.
Dialogue: 0,0:14:45.80,0:14:48.22,Default,,0,0,0,,Алдымен бұл туралы айтып бере аласыз ба?
Dialogue: 0,0:14:48.67,0:14:51.64,Default,,0,0,0,,Өлуге қарсы болмасаң, қолыңнан келетін нәрсе бар.
Dialogue: 0,0:14:52.14,0:14:55.18,Default,,0,0,0,,Синдо мырза, ынтымақтастықта болыңыз.
Dialogue: 0,0:14:56.72,0:14:57.77,Default,,0,0,0,,Жел!
Dialogue: 0,0:15:00.69,0:15:01.52,Default,,0,0,0,,Йоцуя-кун
Dialogue: 0,0:15:01.65,0:15:02.48,Default,,0,0,0,,О!
Dialogue: 0,0:15:02.61,0:15:03.77,Default,,0,0,0,,Гах! (Йоцуя) Га!
Dialogue: 0,0:15:08.78,0:15:11.53,Default,,0,0,0,,Сауда арқылы оны қысқартсаңыз болғаны.
Dialogue: 0,0:15:16.12,0:15:17.16,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:15:20.21,0:15:22.42,Default,,0,0,0,,Йоцуя-кунның стратегиясы жақсы өтті.
Dialogue: 0,0:15:22.54,0:15:23.96,Default,,0,0,0,,Иә, мен оны қарап шықтым.
Dialogue: 0,0:15:24.08,0:15:25.25,Default,,0,0,0,,Бұл сәл ақсақ болды
Dialogue: 0,0:15:25.38,0:15:28.46,Default,,0,0,0,,Мақтаңыз немесе кемсітіңіз.
Dialogue: 0,0:15:29.05,0:15:32.38,Default,,0,0,0,,Бірақ мен осы уақытқа дейін солай істеп келемін.
Dialogue: 0,0:15:32.64,0:15:34.89,Default,,0,0,0,,Хмм, жақсы...
Dialogue: 0,0:15:38.43,0:15:40.06,Default,,0,0,0,,Сәлем! Я~!
Dialogue: 0,0:15:40.39,0:15:43.52,Default,,0,0,0,,Бірінші және екінші рет
Dialogue: 0,0:15:43.90,0:15:46.23,Default,,0,0,0,,Егер мен жеткілікті тырыссам, мен жеңе алар едім.
Dialogue: 0,0:15:46.36,0:15:47.57,Default,,0,0,0,,Егер біреуіміз тірі болса.
Dialogue: 0,0:15:47.69,0:15:49.07,Default,,0,0,0,,Бенисуэ, ерте оян~
Dialogue: 0,0:15:49.19,0:15:50.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:50.24,0:15:52.49,Default,,0,0,0,,Барлығы өлсе не болады?
Dialogue: 0,0:15:52.70,0:15:55.12,Default,,0,0,0,,Сен мұны айтпадың ба?
Dialogue: 0,0:15:55.53,0:15:58.24,Default,,0,0,0,,Егер бәрі өлсе, сен шынымен өлдің.
Dialogue: 0,0:15:58.79,0:15:59.62,Default,,0,0,0,,Ха...
Dialogue: 0,0:16:00.08,0:16:02.75,Default,,0,0,0,,Сен шынымен өлесің бе?
Dialogue: 0,0:16:08.67,0:16:09.84,Default,,0,0,0,,Бір кездері көшіп келген жер
Dialogue: 0,0:16:10.34,0:16:12.22,Default,,0,0,0,,Карта көрсетіледі.
Dialogue: 0,0:16:12.55,0:16:13.43,Default,,0,0,0,,Иә
Dialogue: 0,0:16:14.09,0:16:17.68,Default,,0,0,0,,Әйтеуір, ертең батыстағы ауылға барайық. Жақын
Dialogue: 0,0:16:17.81,0:16:20.27,Default,,0,0,0,,Бұл қиын сұрау емес деп үміттенемін.
Dialogue: 0,0:16:20.39,0:16:23.31,Default,,0,0,0,,Қалпына келтіру үшін 5 күн қажет пе?
Dialogue: 0,0:16:24.69,0:16:28.52,Default,,0,0,0,,Аа, квестті тазарту үшін сыйақы қандай?
Dialogue: 0,0:16:28.73,0:16:30.73,Default,,0,0,0,,Маған екі адамнан сұрауды айтты.
Dialogue: 0,0:16:31.19,0:16:34.20,Default,,0,0,0,,Ал, сіз шеберге бір сұрақ қоюға құқылысыз.
Dialogue: 0,0:16:34.32,0:16:35.16,Default,,0,0,0,,Чикчи!
Dialogue: 0,0:16:35.95,0:16:39.70,Default,,0,0,0,,Бірінші турда мен неге таңдалғанымды сұрадым...
Dialogue: 0,0:16:40.29,0:16:45.00,Default,,0,0,0,,Сіздің бір танысыңыз маған бірдеңе жасауды өтінді.
Dialogue: 0,0:16:45.37,0:16:50.34,Default,,0,0,0,,Екінші турда мен сендер кімсіңдер деп сұрадым.
Dialogue: 0,0:16:51.09,0:16:53.51,Default,,0,0,0,,Мен болашақтанмын.
Dialogue: 0,0:16:54.63,0:16:57.18,Default,,0,0,0,,Болашақ адамдарға...
Dialogue: 0,0:16:57.30,0:17:00.06,Default,,0,0,0,,Белгілі бір танысу.
Dialogue: 0,0:17:01.52,0:17:05.89,Default,,0,0,0,,Әйтеуір, мен алдымен сені бақылаймын.
Dialogue: 0,0:17:06.02,0:17:07.73,Default,,0,0,0,,Иә
Dialogue: 0,0:17:08.73,0:17:11.65,Default,,0,0,0,,Қандай сұрақ қоюым керек?
Dialogue: 0,0:17:14.90,0:17:16.82,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:19.95,0:17:23.08,Default,,0,0,0,,«Бәрі өлсе, сен шынымен өлесің»?
Dialogue: 0,0:17:23.95,0:17:27.29,Default,,0,0,0,,Бұл сіздің шынайы әлемде өлетініңізді білдіре ме?
Dialogue: 0,0:17:28.29,0:17:32.13,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ жағдайға байланысты одан аулақ болуым керек.
Dialogue: 0,0:17:32.63,0:17:33.55,Default,,0,0,0,,Йоцуя-кун!
Dialogue: 0,0:17:33.67,0:17:34.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:34.67,0:17:36.59,Default,,0,0,0,,Йоцуя-кун Йоцуя-кун!
Dialogue: 0,0:17:36.72,0:17:37.55,Default,,0,0,0,,Синдо мырза?
Dialogue: 0,0:17:40.64,0:17:41.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:42.01,0:17:45.31,Default,,0,0,0,,Йо... Йоцуя-кун
Dialogue: 0,0:17:45.64,0:17:47.81,Default,,0,0,0,,Хакозаки мырза! Не...
Dialogue: 0,0:17:47.94,0:17:48.81,Default,,0,0,0,,(бұтақтардың сынған дыбысы)
Dialogue: 0,0:17:49.15,0:17:49.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:02.16,0:18:04.08,Default,,0,0,0,,Гу…
Dialogue: 0,0:18:04.41,0:18:05.75,Default,,0,0,0,,Вааааааааааааааааааааааааааааааа...
Dialogue: 0,0:18:05.87,0:18:06.71,Default,,0,0,0,,Йоцуя-кун!
Dialogue: 0,0:18:07.12,0:18:08.79,Default,,0,0,0,,Қашып жеңе алмайсың!
Dialogue: 0,0:18:08.92,0:18:09.83,Default,,0,0,0,,Кя!
Dialogue: 0,0:18:13.34,0:18:14.76,Default,,0,0,0,,Жедіңіз бе?
Dialogue: 0,0:18:15.88,0:18:16.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:21.30,0:18:23.14,Default,,0,0,0,,Мен өлгенде бітеді
Dialogue: 0,0:18:25.97,0:18:28.10,Default,,0,0,0,,Хакозаки мырзаның қайта тірілгеніне дейін 30 секунд
Dialogue: 0,0:18:28.64,0:18:29.60,Default,,0,0,0,,Синдо мырза!
Dialogue: 0,0:18:29.73,0:18:30.81,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:18:30.94,0:18:32.52,Default,,0,0,0,,Алдымен ауылды мақсат ет!
Dialogue: 0,0:18:34.36,0:18:35.98,Default,,0,0,0,,Ағаш таяқпен дәрменсізсің.
Dialogue: 0,0:18:36.11,0:18:37.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:37.40,0:18:39.03,Default,,0,0,0,,Ол төбелеске жарамайды, солай емес пе?
Dialogue: 0,0:18:46.45,0:18:49.79,Default,,0,0,0,,Иә? Сол қолыңыз қалпына келмейді ме?
Dialogue: 0,0:18:50.00,0:18:53.21,Default,,0,0,0,,Мм, жегендіктен болар.
Dialogue: 0,0:18:53.50,0:18:56.76,Default,,0,0,0,,Сонымен Синдо-сан, сен өмірге қайта келмейсің ғой, солай ма?
Dialogue: 0,0:18:56.88,0:18:57.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:58.05,0:19:01.59,Default,,0,0,0,,Шынайы ма? Екі адам өлсе, бітті.
Dialogue: 0,0:19:02.14,0:19:04.18,Default,,0,0,0,,Менің шабуыл күшім нөлге тең.
Dialogue: 0,0:19:04.35,0:19:06.85,Default,,0,0,0,,Хакозаки мырзаның өмір сүруінің өзі дәрменсіз.
Dialogue: 0,0:19:07.35,0:19:08.31,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:19:08.43,0:19:09.94,Default,,0,0,0,,Бұл үлкен нәрсені елемеу.
Dialogue: 0,0:19:10.06,0:19:12.98,Default,,0,0,0,,Синдо-сансыз квестті жоюдан басқа амалым жоқ.
Dialogue: 0,0:19:15.98,0:19:18.86,Default,,0,0,0,,Батыр осында! Батыр осында!
Dialogue: 0,0:19:19.82,0:19:21.24,Default,,0,0,0,,Батыр дегеніміз...
Dialogue: 0,0:19:21.36,0:19:24.99,Default,,0,0,0,,Менің ойымша, бұл дүниеде бізді осылай атайды.
Dialogue: 0,0:19:25.78,0:19:27.20,Default,,0,0,0,,Манмаджан
Dialogue: 0,0:19:27.58,0:19:29.12,Default,,0,0,0,,Яй, батыр-сама.
Dialogue: 0,0:19:29.25,0:19:30.21,Default,,0,0,0,,Батыр!
Dialogue: 0,0:19:30.33,0:19:31.92,Default,,0,0,0,,Менің атым Сикас.
Dialogue: 0,0:19:32.04,0:19:33.38,Default,,0,0,0,,Ах... Танысқаныма қуаныштымын.
Dialogue: 0,0:19:33.50,0:19:35.63,Default,,0,0,0,,Батыр салқын екен ғой.
Dialogue: 0,0:19:36.04,0:19:37.80,Default,,0,0,0,,Мен фермермін.
Dialogue: 0,0:19:38.30,0:19:41.47,Default,,0,0,0,,Мен де Батыр-самадай мықты болғым келеді.
Dialogue: 0,0:19:41.59,0:19:42.72,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:19:42.84,0:19:44.64,Default,,0,0,0,,Оны бір адам жеуге болады.
Dialogue: 0,0:19:45.05,0:19:46.81,Default,,0,0,0,,Мен ауыл бастығымын.
Dialogue: 0,0:19:47.18,0:19:48.14,Default,,0,0,0,,Сәлем
Dialogue: 0,0:19:48.52,0:19:51.10,Default,,0,0,0,,Ал, өтініш дегенді қалай түсінесіңдер?
Dialogue: 0,0:19:51.23,0:19:52.98,Default,,0,0,0,,Негізі ауылдың шетінде
Dialogue: 0,0:19:53.10,0:19:56.02,Default,,0,0,0,,Тролль деп аталатын құбыжық пайда болды.
Dialogue: 0,0:19:56.15,0:19:58.94,Default,,0,0,0,,Әй, эй, ол емес пе?
Dialogue: 0,0:19:59.07,0:20:00.36,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:20:00.49,0:20:03.78,Default,,0,0,0,,Ауылды құтқару үшін мені жеңіңіз.
Dialogue: 0,0:20:04.03,0:20:05.41,Default,,0,0,0,,Кептеліп қалды...
Dialogue: 0,0:20:07.49,0:20:11.50,Default,,0,0,0,,Сіз гоблинді ешқашан жеңген емессіз, солай ма?
Dialogue: 0,0:20:11.83,0:20:13.71,Default,,0,0,0,,(Кёко мен Юки) Сен шынымен өзіңді қолыңа ал!
Dialogue: 0,0:20:13.83,0:20:15.75,Default,,0,0,0,,Маған қылыштың өзі оңай тимейді.
Dialogue: 0,0:20:16.13,0:20:18.50,Default,,0,0,0,,Айтайын дегенім, мен лақтырдым.
Dialogue: 0,0:20:19.09,0:20:21.30,Default,,0,0,0,,Өйткені тролльдердің арасында Ю-чан бар.
Dialogue: 0,0:20:21.42,0:20:23.63,Default,,0,0,0,,Оны қайта тірілту мүмкін емес деп ойлаймын.
Dialogue: 0,0:20:23.84,0:20:26.01,Default,,0,0,0,,Біз Ю-чанды қалай да құтқаруымыз керек.
Dialogue: 0,0:20:26.14,0:20:27.18,Default,,0,0,0,,Хаа~
Dialogue: 0,0:20:29.06,0:20:30.68,Default,,0,0,0,,Пайдалану мүмкін емес
Dialogue: 0,0:20:30.81,0:20:33.60,Default,,0,0,0,,Неліктен Синдо қалған жоқ?
Dialogue: 0,0:20:34.69,0:20:36.52,Default,,0,0,0,,Әлгі Йоцуя-кун?
Dialogue: 0,0:20:37.31,0:20:39.44,Default,,0,0,0,,Хакозаки мырза, ауылда қалуыңызды өтінемін.
Dialogue: 0,0:20:40.36,0:20:41.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:41.90,0:20:43.61,Default,,0,0,0,,Мен өз дәрежесін көтеремін.
Dialogue: 0,0:20:43.74,0:20:44.57,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:20:45.82,0:20:46.87,Default,,0,0,0,,Бұл!
Dialogue: 0,0:20:50.08,0:20:52.79,Default,,0,0,0,,Бірақ мен Ю-чанды да жақсы көремін!
Dialogue: 0,0:20:53.25,0:20:54.33,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:20:55.62,0:20:57.75,Default,,0,0,0,,Егер мен Хакозаки мырзаға қазір өлсем
Dialogue: 0,0:21:00.50,0:21:02.21,Default,,0,0,0,,Неліктен қиындыққа тап болдыңыз?
Dialogue: 0,0:21:05.38,0:21:08.76,Default,,0,0,0,,Жарайды, жүр, жүр, жүр!
Dialogue: 0,0:21:08.89,0:21:10.51,Default,,0,0,0,,Ал егер сенің станың кішірейгендіктен күшін жоғалтса…
Dialogue: 0,0:21:11.31,0:21:14.18,Default,,0,0,0,,Өл, өл, өл, өл
Dialogue: 0,0:21:14.31,0:21:17.10,Default,,0,0,0,,Өл, өл, өл, өл...
Dialogue: 0,0:21:17.23,0:21:20.32,Default,,0,0,0,,Өл, өл, өл, өл, өл, өл, өл~!
Dialogue: 0,0:21:22.86,0:21:25.11,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:21:25.32,0:21:26.91,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:21:28.57,0:21:30.91,Default,,0,0,0,,Өмірге қауіп төнген жағдайда да
Dialogue: 0,0:21:31.33,0:21:35.29,Default,,0,0,0,,Бұл жерде шиеленіс Токиодағыдан бірнеше есе жоғары.
Dialogue: 0,0:21:41.42,0:21:47.43,Default,,0,0,0,,♪～
Dialogue: 0,0:23:04.54,0:23:10.55,Default,,0,0,0,,～♪
Dialogue: 0,0:23:11.01,0:23:13.05,Default,,0,0,0,,Бүгінгі субквест...
Dialogue: 0,0:23:13.26,0:23:15.81,Default,,0,0,0,,Друруруруру... Бум!
Dialogue: 0,0:23:16.26,0:23:17.35,Default,,0,0,0,,«Мен ауыл бастығымын».
Dialogue: 0,0:23:17.47,0:23:18.68,Default,,0,0,0,,О, бұл дәмді, Шиндо-сан.
Dialogue: 0,0:23:19.02,0:23:20.23,Default,,0,0,0,,«Шын мәнінде ауылдың шетінде»
Dialogue: 0,0:23:20.35,0:23:23.23,Default,,0,0,0,,«Тролль деп аталатын құбыжық пайда болды».
Dialogue: 0,0:23:23.36,0:23:26.40,Default,,0,0,0,,«Ауылды құтқару үшін мені жеңіңіз.»
Dialogue: 0,0:23:26.57,0:23:29.49,Default,,0,0,0,,Келесі мен Юсуке Йоцуямын.
Dialogue: 0,0:23:29.61,0:23:32.41,Default,,0,0,0,,Бұл тағы да ауыл бастығының дубляжы ма? Бұл нөлдік ойын
Dialogue: 0,0:23:32.78,0:23:33.82,Default,,0,0,0,,«Мистер Хакозаки»
Dialogue: 0,0:23:34.20,0:23:36.62,Default,,0,0,0,,«Менімен дос болғың келе ме?»
Dialogue: 0,0:23:37.12,0:23:38.66,Default,,0,0,0,,Бұл жиіркенішті, сондықтан мен оны қалдырамын.
Dialogue: 0,0:23:38.79,0:23:40.87,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:23:42.37,0:23:48.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory