Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.26,0:00:04.80,Default,,0,0,0,,Деден!
Dialogue: 0,0:00:04.80,0:00:07.77,Default,,0,0,0,,Біз әрқашан осында соғысамыз!
Dialogue: 0,0:00:07.77,0:00:09.77,Default,,0,0,0,,Керемет...
Dialogue: 0,0:00:09.77,0:00:13.31,Default,,0,0,0,,Түнгі самал гүлдердің иісін таратады! ➡
Dialogue: 0,0:00:13.31,0:00:17.28,Default,,0,0,0,,Бүгін түнде Wonder Hill әдемі гүлзарға айналады! ➡
Dialogue: 0,0:00:17.28,0:00:19.28,Default,,0,0,0,,Түн ханшайымы оралды➡
Dialogue: 0,0:00:19.28,0:00:21.25,Default,,0,0,0,,Лука Мияко! ➡
Dialogue: 0,0:00:21.25,0:00:23.25,Default,,0,0,0,,~➡ қарсы
Dialogue: 0,0:00:23.25,0:00:25.25,Default,,0,0,0,,Қараңғылық біздің ханым….
Dialogue: 0,0:00:37.30,0:00:39.80,Default,,0,0,0,,Екеуінде де барын сал!
Dialogue: 0,0:00:39.80,0:00:42.77,Default,,0,0,0,,Лука-сан бірінші басшы, солай ма?
Dialogue: 0,0:00:42.77,0:00:46.28,Default,,0,0,0,,Әй, айтпақшы, мен сенімен бұрын сөйлескен емеспін.
Dialogue: 0,0:00:46.28,0:00:49.28,Default,,0,0,0,,Бұл жақсы мүмкіндік. Сіз тыңдағыңыз келе ме? ➡
Dialogue: 0,0:00:49.28,0:00:51.78,Default,,0,0,0,,Blackout қалай пайда болды?
Dialogue: 0,0:00:51.78,0:00:53.78,Default,,0,0,0,,Мен оны естігім келеді!
Dialogue: 0,0:00:53.78,0:00:55.78,Default,,0,0,0,,Хехе...басында жай ғана ➡ болды
Dialogue: 0,0:00:55.78,0:00:57.79,Default,,0,0,0,,Бұл Миёконың идеясы болды.
Dialogue: 0,0:00:57.79,0:00:59.76,Default,,0,0,0,,Хахаха...! Дұрыс➡
Dialogue: 0,0:00:59.76,0:01:03.26,Default,,0,0,0,,Барлығы осы жерден басталды.
Dialogue: 0,0:01:15.30,0:01:18.74,Default,,0,0,0,,((Haa….
Dialogue: 0,0:01:18.74,0:01:21.31,Default,,0,0,0,,Томарин! Un?
Dialogue: 0,0:01:21.31,0:01:23.75,Default,,0,0,0,,Ойын-сауық саябағына барайық!
Dialogue: 0,0:01:23.75,0:01:26.25,Default,,0,0,0,,Не? Такамин келсе жарайды деді➡
Dialogue: 0,0:01:26.25,0:01:28.72,Default,,0,0,0,,Ғажайып төбе! Сәлем...
Dialogue: 0,0:01:28.72,0:01:31.25,Default,,0,0,0,,Сіз шынымен жақсы түсіндіңіз➡
Dialogue: 0,0:01:31.25,0:01:33.26,Default,,0,0,0,,Сонымен... қашан барасыз?
Dialogue: 0,0:01:33.26,0:01:35.26,Default,,0,0,0,,Бұл қазірдің өзінде шешілді➡
Dialogue: 0,0:01:35.26,0:01:38.76,Default,,0,0,0,,Бүгін түнде! Этмарин Мүмкін➡
Dialogue: 0,0:01:38.76,0:01:40.73,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:01:40.73,0:01:43.23,Default,,0,0,0,,Бұл шешілмеген...
Dialogue: 0,0:01:43.23,0:01:45.73,Default,,0,0,0,,Керемет... ынталы!
Dialogue: 0,0:01:45.73,0:01:48.74,Default,,0,0,0,,Ваа... Томарин! Уау...!
Dialogue: 0,0:01:48.74,0:01:51.24,Default,,0,0,0,,Мен сені жақсы көремін!
Dialogue: 0,0:01:55.74,0:01:58.75,Default,,0,0,0,,Мұнда керемет атмосфера бар. Маған ұнайды!
Dialogue: 0,0:01:58.75,0:02:02.25,Default,,0,0,0,,Ал... Таками ше?
Dialogue: 0,0:02:02.25,0:02:05.75,Default,,0,0,0,,Хмм... сіз алға бара жатырсыз дедіңіз.
Dialogue: 0,0:02:06.72,0:02:08.72,Default,,0,0,0,,Ым?
Dialogue: 0,0:02:09.73,0:02:11.73,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:02:12.76,0:02:14.73,Default,,0,0,0,,Күдікті адам табылды! ➡
Dialogue: 0,0:02:14.73,0:02:16.73,Default,,0,0,0,,Сіз кімсіз! Ittete... Бер!
Dialogue: 0,0:02:17.73,0:02:19.77,Default,,0,0,0,,Itte～➡
Dialogue: 0,0:02:19.77,0:02:23.74,Default,,0,0,0,,Сіз кенеттен не істеп жатырсыз? Мұнда кіруге рұқсат жоқ.
Dialogue: 0,0:02:23.74,0:02:25.77,Default,,0,0,0,,Жақсысыңдар ма?
Dialogue: 0,0:02:25.77,0:02:28.24,Default,,0,0,0,,Бізде тиісті рұқсат бар.
Dialogue: 0,0:02:28.24,0:02:31.21,Default,,0,0,0,,Шықсаң жарайды.
Dialogue: 0,0:02:31.21,0:02:33.25,Default,,0,0,0,,Е...бұл не?
Dialogue: 0,0:02:33.25,0:02:35.22,Default,,0,0,0,,Сіз қашқынсыз ба? ➡
Dialogue: 0,0:02:35.22,0:02:37.22,Default,,0,0,0,,Сіз осында лагерьде болдыңыз ба?
Dialogue: 0,0:02:37.22,0:02:40.26,Default,,0,0,0,,A...? Маған бұл маңызды емес!
Dialogue: 0,0:02:40.26,0:02:42.72,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:02:42.72,0:02:44.73,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:02:48.73,0:02:51.70,Default,,0,0,0,,Сонымен... маңызды емес.
Dialogue: 0,0:02:53.24,0:02:55.30,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:02:55.30,0:03:05.21,Default,,0,0,0,,🎵～
Dialogue: 0,0:03:05.21,0:03:08.22,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:03:17.73,0:03:19.73,Default,,0,0,0,,O~i➡
Dialogue: 0,0:03:19.73,0:03:21.73,Default,,0,0,0,,Электр қуаты қосулы➡
Dialogue: 0,0:03:21.73,0:03:24.20,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:03:26.74,0:03:28.74,Default,,0,0,0,,Мен Мияко Лукамын➡
Dialogue: 0,0:03:28.74,0:03:31.34,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:03:31.34,0:03:33.31,Default,,0,0,0,,Мен...
Dialogue: 0,0:03:35.74,0:03:37.75,Default,,0,0,0,,Жарайды...бұл маңызды емес➡
Dialogue: 0,0:03:37.75,0:03:39.75,Default,,0,0,0,,Эй, сен менімен карта төбелескің келе ме?
Dialogue: 0,0:03:39.75,0:03:43.25,Default,,0,0,0,,Ха...? Сіз Vanguard ойнайсыз, солай ма?
Dialogue: 0,0:03:43.25,0:03:47.22,Default,,0,0,0,,Болса да, неге күресу керек?
Dialogue: 0,0:03:47.22,0:03:49.26,Default,,0,0,0,,Тегін деп айтпаңыз! ➡
Dialogue: 0,0:03:49.26,0:03:51.23,Default,,0,0,0,,Ұтылып қалсаңыз, жеңімпаз не дейді➡
Dialogue: 0,0:03:51.23,0:03:54.73,Default,,0,0,0,,Мен сенен бір нәрсе сұрайын деп отырмын, ал сен қалай ойлайсың?
Dialogue: 0,0:03:54.73,0:03:58.20,Default,,0,0,0,,Қайтадан басталды. Хех... әдеттегідей.
Dialogue: 0,0:04:03.24,0:04:05.21,Default,,0,0,0,,Бауырым, кешігіп қалдың...
Dialogue: 0,0:04:06.24,0:04:08.24,Default,,0,0,0,,Жеңімпаз...! ➡
Dialogue: 0,0:04:08.24,0:04:10.21,Default,,0,0,0,,Лука Мияко!
Dialogue: 0,0:04:11.71,0:04:14.22,Default,,0,0,0,,Күш...және➡
Dialogue: 0,0:04:14.22,0:04:16.72,Default,,0,0,0,,Не айта аламын...
Dialogue: 0,0:04:19.22,0:04:21.26,Default,,0,0,0,,Уәделеріңізді орындаңыз➡
Dialogue: 0,0:04:21.26,0:04:23.73,Default,,0,0,0,,Айтар бір сөзің болса, тыңдаймын.
Dialogue: 0,0:04:23.73,0:04:26.76,Default,,0,0,0,,Мен... жаңа ғана ойға келдім➡
Dialogue: 0,0:04:26.76,0:04:29.76,Default,,0,0,0,,Мен Авангард командасын жасағым келеді!
Dialogue: 0,0:04:30.77,0:04:33.80,Default,,0,0,0,,Ха...? Вондерхиллдің әңгімесін тыңдап болған соң➡
Dialogue: 0,0:04:33.80,0:04:35.74,Default,,0,0,0,,Бір қызық іспен айналыссам екен➡
Dialogue: 0,0:04:35.74,0:04:38.24,Default,,0,0,0,,Көптен бері ойланып жүрмін➡
Dialogue: 0,0:04:38.24,0:04:40.24,Default,,0,0,0,,Мен сен сияқты адамды қалаймын➡
Dialogue: 0,0:04:40.24,0:04:42.74,Default,,0,0,0,,Адамдар күлетіндей орын жасағым келеді.
Dialogue: 0,0:04:42.74,0:04:44.71,Default,,0,0,0,,Күн сайын кешке жиналып, Vanguard➡ ойнаңыз
Dialogue: 0,0:04:44.71,0:04:46.72,Default,,0,0,0,,Үйге күліп қайтуға болады➡
Dialogue: 0,0:04:46.72,0:04:48.75,Default,,0,0,0,,Мен дәл осындай жер болғанын қалаймын!
Dialogue: 0,0:04:48.75,0:04:51.72,Default,,0,0,0,,Сол себепті командама қосылғыңыз келеді➡
Dialogue: 0,0:04:51.72,0:04:53.72,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:04:54.72,0:04:58.26,Default,,0,0,0,,Неліктен...? Қонатын жеріңіз жоқ емес пе?
Dialogue: 0,0:04:58.26,0:05:01.73,Default,,0,0,0,,Бұрынғы жекпе-жек маған ұнады➡
Dialogue: 0,0:05:01.73,0:05:04.73,Default,,0,0,0,,Ал сіз ше? а….
Dialogue: 0,0:05:04.73,0:05:06.74,Default,,0,0,0,,Ах! Түсіндім➡
Dialogue: 0,0:05:06.74,0:05:09.74,Default,,0,0,0,,Уәде - уәде, мен кіремін!
Dialogue: 0,0:05:09.74,0:05:12.24,Default,,0,0,0,,Иә! Белгілі бір себептермен➡
Dialogue: 0,0:05:12.24,0:05:15.24,Default,,0,0,0,,Бос болмайсыңдар, бейбақтар!
Dialogue: 0,0:05:15.24,0:05:17.71,Default,,0,0,0,,Бізге қазірдің өзінде мүшелер ретінде қаралған.
Dialogue: 0,0:05:17.71,0:05:19.71,Default,,0,0,0,,Әлі де тегін.
Dialogue: 0,0:05:20.72,0:05:23.29,Default,,0,0,0,,Миёко - осындай адам➡
Dialogue: 0,0:05:23.29,0:05:25.29,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған хабарлаңыз. ))
Dialogue: 0,0:05:27.26,0:05:30.73,Default,,0,0,0,,Осыдан кейін мен тұратын жермен және жұмыспен таныстырылды➡
Dialogue: 0,0:05:30.73,0:05:33.23,Default,,0,0,0,,Таками маған көп қамқорлық жасады.
Dialogue: 0,0:05:33.23,0:05:35.23,Default,,0,0,0,,Ха... бұл шынымен ностальгия.
Dialogue: 0,0:05:35.23,0:05:37.73,Default,,0,0,0,,Міне осылай болды!
Dialogue: 0,0:05:37.73,0:05:40.24,Default,,0,0,0,,Ең қызықтысы да осы➡
Dialogue: 0,0:05:40.24,0:05:42.20,Default,,0,0,0,,Басталғалы жатыр.
Dialogue: 0,0:05:49.74,0:05:52.25,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:05:52.25,0:05:54.75,Default,,0,0,0,,Полярлық жарық жауынгері Руби Кримсон ханшайымы!
Dialogue: 0,0:05:54.75,0:05:57.75,Default,,0,0,0,,Рэйсент, жұмаққа келген қонақ.
Dialogue: 0,0:05:57.75,0:06:01.22,Default,,0,0,0,,Менің кезегім Кируна Кобальтпен жүр! ➡
Dialogue: 0,0:06:01.22,0:06:03.26,Default,,0,0,0,,Палубадан шеберлікпен➡
Dialogue: 0,0:06:03.26,0:06:06.23,Default,,0,0,0,,Галактикалық мәңгілік түрме Галактраз жиынтығы! ➡
Dialogue: 0,0:06:06.23,0:06:08.23,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:06:08.23,0:06:11.23,Default,,0,0,0,,Менің кезегім Джотильге барамын➡
Dialogue: 0,0:06:11.23,0:06:14.24,Default,,0,0,0,,Шабуыл! Күзетші жоқ.
Dialogue: 0,0:06:14.24,0:06:17.24,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім ➡
Dialogue: 0,0:06:17.24,0:06:19.24,Default,,0,0,0,,Рисат шабдалысына міну➡
Dialogue: 0,0:06:19.24,0:06:21.28,Default,,0,0,0,,Шеберлікпен 1 картаны салыңыз➡
Dialogue: 0,0:06:21.28,0:06:24.21,Default,,0,0,0,,Сіздің қарсыласыңыздың қолында бір карта бар. Жоқ!
Dialogue: 0,0:06:24.21,0:06:26.75,Default,,0,0,0,,Галактикалық мәңгілік түрмеге➡
Dialogue: 0,0:06:26.75,0:06:28.72,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:06:28.72,0:06:31.32,Default,,0,0,0,,Менің жапырақ қауырсыным!
Dialogue: 0,0:06:31.32,0:06:33.22,Default,,0,0,0,,Флорес Лайлаға қоңырау шалыңыз!
Dialogue: 0,0:06:33.22,0:06:35.22,Default,,0,0,0,,1 картаны шеберлікпен түсіру➡
Dialogue: 0,0:06:35.22,0:06:37.23,Default,,0,0,0,,1 картаны сал!
Dialogue: 0,0:06:37.23,0:06:39.23,Default,,0,0,0,,Оны арқанға сал!
Dialogue: 0,0:06:39.23,0:06:41.23,Default,,0,0,0,,Боу! Бұл әділетсіз қамауға алу.
Dialogue: 0,0:06:41.23,0:06:43.23,Default,,0,0,0,,Риссат шабдалымен шабуыл.
Dialogue: 0,0:06:43.23,0:06:46.23,Default,,0,0,0,,Күзетші жоқ. шабуыл.
Dialogue: 0,0:06:46.23,0:06:48.74,Default,,0,0,0,,Күзетші! Соңына бұрылу.
Dialogue: 0,0:06:48.74,0:06:51.74,Default,,0,0,0,,Ноктран менің кезегіме дейін жүр.
Dialogue: 0,0:06:51.74,0:06:54.24,Default,,0,0,0,,Жанның Йотилін шақыр.
Dialogue: 0,0:06:54.24,0:06:56.21,Default,,0,0,0,,Мен оны қазір беремін.
Dialogue: 0,0:06:56.21,0:06:58.71,Default,,0,0,0,,Құны бар➡
Dialogue: 0,0:06:58.71,0:07:01.25,Default,,0,0,0,,Жапырақтары...
Dialogue: 0,0:07:01.25,0:07:03.22,Default,,0,0,0,,Қоңырау шалыңыз!
Dialogue: 0,0:07:03.22,0:07:05.72,Default,,0,0,0,,Диантаны да шеберлікпен шақырыңыз➡
Dialogue: 0,0:07:05.72,0:07:08.22,Default,,0,0,0,,Келіңіздер, джейлбрейк...!
Dialogue: 0,0:07:08.22,0:07:10.76,Default,,0,0,0,,Хе! Галактраз дағдылары➡
Dialogue: 0,0:07:10.76,0:07:13.73,Default,,0,0,0,,Қоршау бөлімі шақырылғанда жан заряды.
Dialogue: 0,0:07:13.73,0:07:16.23,Default,,0,0,0,,Тағы біреуі қауырсын қалдырады➡
Dialogue: 0,0:07:16.23,0:07:18.23,Default,,0,0,0,,Джейлбрейк!
Dialogue: 0,0:07:18.23,0:07:21.24,Default,,0,0,0,,Ахаха...! біз боспыз➡
Dialogue: 0,0:07:21.24,0:07:24.77,Default,,0,0,0,,Мен ешкімге байланысты емеспін!
Dialogue: 0,0:07:24.77,0:07:27.78,Default,,0,0,0,,Мен шығынды төлеп, досымды түрмеден құтқардым!
Dialogue: 0,0:07:27.78,0:07:30.71,Default,,0,0,0,,Кепіл төлеп, бостандыққа шыққандай.
Dialogue: 0,0:07:30.71,0:07:32.71,Default,,0,0,0,,Ол бұл джейлбрейк екенін айтты.
Dialogue: 0,0:07:32.71,0:07:34.72,Default,,0,0,0,,Пара...?
Dialogue: 0,0:07:35.72,0:07:39.22,Default,,0,0,0,,Жапырақ қауырсынымен шабуыл! Күзетші жоқ.
Dialogue: 0,0:07:39.22,0:07:41.22,Default,,0,0,0,,Шабуыл! күзетші!
Dialogue: 0,0:07:41.22,0:07:43.76,Default,,0,0,0,,Шабуыл! күзетші!
Dialogue: 0,0:07:43.76,0:07:45.76,Default,,0,0,0,,Кезеңнің соңы! ➡
Dialogue: 0,0:07:45.76,0:07:48.23,Default,,0,0,0,,Хмм... қызық! ➡
Dialogue: 0,0:07:48.23,0:07:51.23,Default,,0,0,0,,Бұрынғы күндерді еске түсіреді! Дұрыс➡
Dialogue: 0,0:07:51.23,0:07:54.24,Default,,0,0,0,,Біз сансыз соғыстық.
Dialogue: 0,0:07:56.30,0:07:58.24,Default,,0,0,0,,((Сәлеметсіз бе... маған мұны істеуді өтінді.
Dialogue: 0,0:07:58.24,0:08:00.24,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:08:01.78,0:08:05.21,Default,,0,0,0,,Ұят болды~ Табан астындағы кесу~.
Dialogue: 0,0:08:05.21,0:08:07.22,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:08:07.22,0:08:09.22,Default,,0,0,0,,Бұл дүниеде қайғылы түрде шашылып жатсаңыз да➡
Dialogue: 0,0:08:09.22,0:08:11.22,Default,,0,0,0,,Егер шытырлақ шырылдаса, бұл Меруерт түн➡
Dialogue: 0,0:08:11.22,0:08:13.72,Default,,0,0,0,,Жауынгерлер жиналса, түн қызады!
Dialogue: 0,0:08:13.72,0:08:15.76,Default,,0,0,0,,О, түсіндім!
Dialogue: 0,0:08:15.76,0:08:17.73,Default,,0,0,0,,Жоқ, олай емес. Мүлдем емес.
Dialogue: 0,0:08:17.73,0:08:20.26,Default,,0,0,0,,Сондықтан➡
Dialogue: 0,0:08:20.26,0:08:22.73,Default,,0,0,0,,Ақыры ту көтерілді!
Dialogue: 0,0:08:22.73,0:08:25.20,Default,,0,0,0,,Біздің топтың аты Блэкут!
Dialogue: 0,0:08:26.23,0:08:28.24,Default,,0,0,0,,Өшіру?
Dialogue: 0,0:08:28.24,0:08:30.24,Default,,0,0,0,,Электр қуатын өшіру? Қараңғылық?
Dialogue: 0,0:08:30.24,0:08:33.74,Default,,0,0,0,,Әртүрлі түстер араласқанда олар қара болады➡
Dialogue: 0,0:08:33.74,0:08:36.71,Default,,0,0,0,,Қараңғылыққа еріп, бір бол.
Dialogue: 0,0:08:36.71,0:08:39.75,Default,,0,0,0,,Ол кезде енді ешкім жалғыз емес.
Dialogue: 0,0:08:39.75,0:08:42.72,Default,,0,0,0,,Барлығын жұтып, құшақтайды➡
Dialogue: 0,0:08:42.72,0:08:45.72,Default,,0,0,0,,Қарадан қара, ағынды қара түнек.
Dialogue: 0,0:08:46.72,0:08:48.79,Default,,0,0,0,,Қараңғылық.
Dialogue: 0,0:08:48.79,0:08:51.76,Default,,0,0,0,,О! Бұл туралы шындап ойлайтыным сирек.
Dialogue: 0,0:08:51.76,0:08:55.73,Default,,0,0,0,,Сіз әрқашан байсалдысыз ба? Миёко-сан күткендей! ➡
Dialogue: 0,0:08:55.73,0:08:58.73,Default,,0,0,0,,Йо... Әпке, харизматикалық көшбасшы!
Dialogue: 0,0:08:58.73,0:09:02.24,Default,,0,0,0,,Хаха! Сен маған әбден үйреніп қалдың.
Dialogue: 0,0:09:02.24,0:09:04.24,Default,,0,0,0,,Аты шешілгеннен кейін, ақырында➡
Dialogue: 0,0:09:04.24,0:09:07.24,Default,,0,0,0,,Біз де дұрыс жалауша жасауымыз керек. Дұрыс! ➡
Dialogue: 0,0:09:07.24,0:09:09.74,Default,,0,0,0,,Топтар арасындағы ту үшін шайқаста➡
Dialogue: 0,0:09:09.74,0:09:11.75,Default,,0,0,0,,Ту – жан!
Dialogue: 0,0:09:11.75,0:09:14.75,Default,,0,0,0,,О! Анонимді Гон Чан да ынталы.
Dialogue: 0,0:09:14.75,0:09:17.72,Default,,0,0,0,,Бірақ сіз әрқашан Гон Чан боласыз...
Dialogue: 0,0:09:17.72,0:09:21.22,Default,,0,0,0,,Хм... атыңды айтатын кез келді.
Dialogue: 0,0:09:23.73,0:09:25.76,Default,,0,0,0,,Данжи➡
Dialogue: 0,0:09:25.76,0:09:28.73,Default,,0,0,0,,Туды қорғап, Қаға жолбарысы➡
Dialogue: 0,0:09:28.73,0:09:31.23,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:31.23,0:09:33.20,Default,,0,0,0,,Бұл Данжи Момояма!
Dialogue: 0,0:09:34.24,0:09:36.24,Default,,0,0,0,,Тағы да рахмет➡
Dialogue: 0,0:09:36.24,0:09:39.24,Default,,0,0,0,,Данжи! О!
Dialogue: 0,0:09:39.24,0:09:42.28,Default,,0,0,0,,Blackout қалыптасуын еске алу➡
Dialogue: 0,0:09:42.28,0:09:45.78,Default,,0,0,0,,Неліктен қазіргі сезімдеріңізді шәйнекке ойып түсірмеске?
Dialogue: 0,0:09:45.78,0:10:00.26,Default,,0,0,0,,🎵～
Dialogue: 0,0:10:00.26,0:10:03.73,Default,,0,0,0,,Blackout➡ қолданбасына жаңа ережелер қосылды
Dialogue: 0,0:10:03.73,0:10:06.73,Default,,0,0,0,,Қақтығыс болған кезде... карта төбелес!
Dialogue: 0,0:10:07.80,0:10:09.77,Default,,0,0,0,,Өшіру➡
Dialogue: 0,0:10:09.77,0:10:12.27,Default,,0,0,0,,Мен Миёконың не айтқысы келгенін түсіндім деп ойлаймын.
Dialogue: 0,0:10:12.27,0:10:15.74,Default,,0,0,0,,Дұрыс... Ол бала өз сөзіне ереді➡
Dialogue: 0,0:10:15.74,0:10:18.38,Default,,0,0,0,,Мен жүгіре бастасам, тоқтай алмаймын.
Dialogue: 0,0:10:18.38,0:10:22.22,Default,,0,0,0,,Мен үнемі айналамдағы адамдарды ренжітемін➡
Dialogue: 0,0:10:22.22,0:10:24.72,Default,,0,0,0,,Өзіңізге ұнайтын адамды ренжітіңіз➡
Dialogue: 0,0:10:24.72,0:10:27.29,Default,,0,0,0,,Мен мұнда қашып кеттім➡
Dialogue: 0,0:10:27.29,0:10:30.76,Default,,0,0,0,,Мен енді біреумен карта төбелесіп қызық көрген емеспін➡
Dialogue: 0,0:10:30.76,0:10:32.73,Default,,0,0,0,,Мен жоқ деп ойладым.
Dialogue: 0,0:10:36.73,0:10:38.80,Default,,0,0,0,,Мен ризамын.
Dialogue: 0,0:10:38.80,0:10:42.27,Default,,0,0,0,,Мұны тікелей сол балаға айтыңыз. ))
Dialogue: 0,0:10:45.24,0:10:48.24,Default,,0,0,0,,Бұл ең жақсы... Қараңғылық!
Dialogue: 0,0:10:48.24,0:10:51.21,Default,,0,0,0,,Йоша~! Менің кезегім ➡
Dialogue: 0,0:10:51.21,0:10:53.75,Default,,0,0,0,,Ғаламда жарқыраған әділет нұры➡
Dialogue: 0,0:10:53.75,0:10:56.25,Default,,0,0,0,,Біз барлық жаман балаларды ұстаймыз, солай ма? ➡
Dialogue: 0,0:10:56.25,0:10:58.72,Default,,0,0,0,,Жүр!
Dialogue: 0,0:10:58.72,0:11:01.22,Default,,0,0,0,,Гокуко Сенки➡
Dialogue: 0,0:11:01.22,0:11:03.22,Default,,0,0,0,,Seras Clear Light!
Dialogue: 0,0:11:08.30,0:11:10.70,Default,,0,0,0,,Қанша қашсаң да қамауға аласың...! ➡
Dialogue: 0,0:11:10.70,0:11:12.73,Default,,0,0,0,,Серас шеберлігін белсендіру➡
Dialogue: 0,0:11:12.73,0:11:14.70,Default,,0,0,0,,Құрамында жапырақ қауырсыны бар! ➡
Dialogue: 0,0:11:14.70,0:11:16.70,Default,,0,0,0,,Қоңырау парағын➡
Dialogue: 0,0:11:16.70,0:11:18.71,Default,,0,0,0,,Осы дағдыны тағы бір картаны сақтау үшін пайдаланыңыз➡
Dialogue: 0,0:11:18.71,0:11:20.74,Default,,0,0,0,,Флореске қоңырау шалыңыз➡
Dialogue: 0,0:11:20.74,0:11:24.21,Default,,0,0,0,,Сонымен қатар, құлағаннан бір картаны сақтау дағдысын пайдаланыңыз!
Dialogue: 0,0:11:24.21,0:11:26.71,Default,,0,0,0,,Seras Clear Light көмегімен шабуыл! ➡
Dialogue: 0,0:11:26.71,0:11:29.72,Default,,0,0,0,,Қуат плюс 10 000 және жүргізу плюс 1 дағдылары бар!
Dialogue: 0,0:11:29.72,0:11:31.72,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:11:31.72,0:11:35.22,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:11:35.22,0:11:38.23,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:11:38.23,0:11:40.23,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:11:40.23,0:11:42.23,Default,,0,0,0,,Критикалық триггер! ➡
Dialogue: 0,0:11:42.23,0:11:44.23,Default,,0,0,0,,Мінсіз қуат плюс 10000➡
Dialogue: 0,0:11:44.23,0:11:46.23,Default,,0,0,0,,Серастың сыни плюс 1!
Dialogue: 0,0:11:46.23,0:11:48.70,Default,,0,0,0,,Oyoyo...Kits~!
Dialogue: 0,0:11:48.70,0:11:51.21,Default,,0,0,0,,Мінсіз шабуыл! күзетші!
Dialogue: 0,0:11:51.21,0:11:53.71,Default,,0,0,0,,Басқа мінсіз шабуыл!
Dialogue: 0,0:11:53.71,0:11:56.24,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:11:56.24,0:11:59.75,Default,,0,0,0,,Бұрылыстың соңы. Мен олардың бәрін ұстай алмадым.
Dialogue: 0,0:11:59.75,0:12:04.22,Default,,0,0,0,,Уайымдама, келесі жолы бәріңді қамауға аламын.
Dialogue: 0,0:12:04.22,0:12:07.22,Default,,0,0,0,,Иә! Кочитора Осындай шағын түрмеде➡
Dialogue: 0,0:12:07.22,0:12:09.19,Default,,0,0,0,,Біз сыймаймыз!
Dialogue: 0,0:12:10.23,0:12:12.23,Default,,0,0,0,,Түнді бояйтын әдемі гүлдер➡
Dialogue: 0,0:12:12.23,0:12:15.73,Default,,0,0,0,,Дүние жүзінде еркін жел➡
Dialogue: 0,0:12:15.73,0:12:18.20,Default,,0,0,0,,Жүр!
Dialogue: 0,0:12:18.20,0:12:20.24,Default,,0,0,0,,Жұмаққа апарушы➡
Dialogue: 0,0:12:20.24,0:12:22.20,Default,,0,0,0,,Нанакрил!
Dialogue: 0,0:12:23.20,0:12:25.21,Default,,0,0,0,,Филандерге шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:12:25.21,0:12:27.24,Default,,0,0,0,,Жүріңдер, бәрі үйлеріне қайтсын!
Dialogue: 0,0:12:27.24,0:12:30.25,Default,,0,0,0,,Құрамында Ривзфэзер және Уиллсрен шақырылады.
Dialogue: 0,0:12:31.21,0:12:35.22,Default,,0,0,0,,Ал...қараңғыдан өткеннен кейін➡
Dialogue: 0,0:12:35.22,0:12:37.22,Default,,0,0,0,,Жоғалған балалар жиналғанда➡
Dialogue: 0,0:12:37.22,0:12:39.22,Default,,0,0,0,,Гүл жұмағы пайда болады.
Dialogue: 0,0:12:39.22,0:12:41.19,Default,,0,0,0,,Осы жерден➡
Dialogue: 0,0:12:41.19,0:12:43.19,Default,,0,0,0,,Бұл менің әлемім!
Dialogue: 0,0:12:53.23,0:12:56.24,Default,,0,0,0,,Жұмаққа 3 немесе одан да көп адам келген кезде➡
Dialogue: 0,0:12:56.24,0:12:59.21,Default,,0,0,0,,Менің әлемім адасатын баққа айналады.
Dialogue: 0,0:13:00.21,0:13:02.21,Default,,0,0,0,,Әдемі….
Dialogue: 0,0:13:02.21,0:13:04.21,Default,,0,0,0,,Cade Miele күшін қолданыңыз.
Dialogue: 0,0:13:04.21,0:13:07.22,Default,,0,0,0,,Уиллдің линзаның қуаты плюс 5000.
Dialogue: 0,0:13:07.22,0:13:09.22,Default,,0,0,0,,Уилл Ленмен шабуыл!
Dialogue: 0,0:13:09.22,0:13:11.22,Default,,0,0,0,,Флореспен жолығады! ➡
Dialogue: 0,0:13:11.22,0:13:13.19,Default,,0,0,0,,Шеберлікпен +5000 қалқан!
Dialogue: 0,0:13:13.19,0:13:15.19,Default,,0,0,0,,Нанакрилмен шабуыл! ➡
Dialogue: 0,0:13:15.19,0:13:17.19,Default,,0,0,0,,Вильзуренге шеберлікпен тұрыңыз➡
Dialogue: 0,0:13:17.19,0:13:19.19,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:13:19.19,0:13:21.20,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:13:21.20,0:13:23.20,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:13:23.20,0:13:26.70,Default,,0,0,0,,Триггерді тартыңыз! Will's Len Пауэр Plus 10000➡
Dialogue: 0,0:13:26.70,0:13:29.24,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:13:29.24,0:13:31.21,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:13:31.21,0:13:33.24,Default,,0,0,0,,Критикалық триггер! ➡
Dialogue: 0,0:13:33.24,0:13:37.21,Default,,0,0,0,,Уиллдің Рен күші плюс 10 000 Нанакрилдің критикалық плюс 1!
Dialogue: 0,0:13:37.21,0:13:39.21,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:13:39.21,0:13:41.22,Default,,0,0,0,,Әлі жоқ! ➡
Dialogue: 0,0:13:41.22,0:13:43.22,Default,,0,0,0,,Уилл Ленмен шабуыл!
Dialogue: 0,0:13:43.22,0:13:45.22,Default,,0,0,0,,Күзетші! ➡
Dialogue: 0,0:13:45.22,0:13:47.19,Default,,0,0,0,,Кесу!
Dialogue: 0,0:13:47.19,0:13:49.19,Default,,0,0,0,,Жапырақ қауырсынымен шабуыл!
Dialogue: 0,0:13:49.19,0:13:51.19,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:13:51.19,0:13:53.19,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:13:54.73,0:13:57.70,Default,,0,0,0,,Егер сіз оны бұрышта қалдым деп ойласаңыз, онда жоқ.
Dialogue: 0,0:13:57.70,0:14:00.20,Default,,0,0,0,,Міне, бұл өте қызықты болады.
Dialogue: 0,0:14:00.20,0:14:02.20,Default,,0,0,0,,Мен білемін➡
Dialogue: 0,0:14:02.20,0:14:04.71,Default,,0,0,0,,Томар мінгенде ➡
Dialogue: 0,0:14:04.71,0:14:06.71,Default,,0,0,0,,Бұл өте қауіпті!
Dialogue: 0,0:14:09.28,0:14:13.72,Default,,0,0,0,,(((Томаридің ызылдағаны)
Dialogue: 0,0:14:13.72,0:14:15.72,Default,,0,0,0,,Сәлем Томари.
Dialogue: 0,0:14:15.72,0:14:17.72,Default,,0,0,0,,Хмм...не?
Dialogue: 0,0:14:17.72,0:14:20.72,Default,,0,0,0,,Томариге айтайын дегенім бар.
Dialogue: 0,0:14:23.22,0:14:26.23,Default,,0,0,0,,Сен барасың ба? Кага секіру.
Dialogue: 0,0:14:27.23,0:14:30.23,Default,,0,0,0,,Біз қанша жылдан бері жақсы доспыз деп ойлайсыңдар?
Dialogue: 0,0:14:30.23,0:14:32.20,Default,,0,0,0,,Мен сені ұстамаймын➡
Dialogue: 0,0:14:32.20,0:14:34.20,Default,,0,0,0,,Мен оны бәрібір тоқтатсам да кететініне сенімдімін.
Dialogue: 0,0:14:34.20,0:14:36.70,Default,,0,0,0,,Хаха...білемін➡
Dialogue: 0,0:14:36.70,0:14:40.21,Default,,0,0,0,,Өшіруді сізге қалдыра аламын ба?
Dialogue: 0,0:14:40.21,0:14:42.21,Default,,0,0,0,,Бұл шын мәнінде өзіңізге байланысты➡
Dialogue: 0,0:14:42.21,0:14:44.25,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:44.25,0:14:47.22,Default,,0,0,0,,Мен мұндай еркіндікке тәнтімін.
Dialogue: 0,0:14:49.22,0:14:51.22,Default,,0,0,0,,Томалин….
Dialogue: 0,0:14:51.22,0:14:54.69,Default,,0,0,0,,Томарин! Қандай тітіркендіргіш...!
Dialogue: 0,0:14:54.69,0:14:56.72,Default,,0,0,0,,Өшіруді бізге қалдырмаңыз➡
Dialogue: 0,0:14:56.72,0:14:58.69,Default,,0,0,0,,Мен сені қорғаймын.
Dialogue: 0,0:14:58.69,0:15:02.20,Default,,0,0,0,,Сақшы Құдай... Томари-сама құдайы!
Dialogue: 0,0:15:02.20,0:15:04.20,Default,,0,0,0,,Ал... солай➡
Dialogue: 0,0:15:04.20,0:15:06.20,Default,,0,0,0,,Келесі көшбасшы кім болады?
Dialogue: 0,0:15:07.20,0:15:09.74,Default,,0,0,0,,Ха...? Неге мен?➡
Dialogue: 0,0:15:09.74,0:15:13.24,Default,,0,0,0,,Таками Томари... Тағы біреу лайықтырақ!
Dialogue: 0,0:15:13.24,0:15:16.21,Default,,0,0,0,,Себебі мен Окура тобына мұрагер болу позициясындамын➡
Dialogue: 0,0:15:16.21,0:15:18.71,Default,,0,0,0,,Ақырында Blackout-тан шығатын адам.
Dialogue: 0,0:15:18.71,0:15:21.72,Default,,0,0,0,,Мен шынымен де көшбасшы емеспін.
Dialogue: 0,0:15:21.72,0:15:23.72,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:23.72,0:15:26.72,Default,,0,0,0,,Бұл қазір сіздің орныңыз, солай ма?
Dialogue: 0,0:15:26.72,0:15:29.69,Default,,0,0,0,,Әрине, ұнамаса, жоқ➡ деуге болады
Dialogue: 0,0:15:29.69,0:15:31.69,Default,,0,0,0,,Сен мықтысың➡
Dialogue: 0,0:15:31.69,0:15:34.30,Default,,0,0,0,,Авангард және қарулар да➡
Dialogue: 0,0:15:34.30,0:15:37.27,Default,,0,0,0,,Бірақ менің жүрегім күшті емес.
Dialogue: 0,0:15:38.73,0:15:42.74,Default,,0,0,0,,Сіздің арқаңызда мейірімді көшбасшы бола аласыз➡
Dialogue: 0,0:15:42.74,0:15:44.71,Default,,0,0,0,,Сіз мейірімді топ құра аласыз.
Dialogue: 0,0:15:46.74,0:15:50.24,Default,,0,0,0,,Мен сенің немен айналысып жатқаныңды білмеймін.
Dialogue: 0,0:15:50.24,0:15:54.25,Default,,0,0,0,,Өткен бір күні сенен кейін келуі мүмкін➡
Dialogue: 0,0:15:54.25,0:15:58.22,Default,,0,0,0,,Бірақ содан кейін, сіз мұны қазір айналдырғаныңызға сенімдімін➡
Dialogue: 0,0:15:58.22,0:16:00.69,Default,,0,0,0,,Ол сізге көмектеседі.
Dialogue: 0,0:16:00.69,0:16:04.19,Default,,0,0,0,,Blackout сізге көмектеседі.
Dialogue: 0,0:16:05.69,0:16:08.70,Default,,0,0,0,,Мен баяғыда құтқарылдым...
Dialogue: 0,0:16:09.73,0:16:11.70,Default,,0,0,0,,Түсіндім➡
Dialogue: 0,0:16:11.70,0:16:14.70,Default,,0,0,0,,Көшбасшы қабылдаңыз!
Dialogue: 0,0:16:14.70,0:16:16.74,Default,,0,0,0,,Сайып келгенде, жалау жаңа болады➡
Dialogue: 0,0:16:16.74,0:16:20.21,Default,,0,0,0,,Бірақ кейбір нәрселер міндетті түрде өзгеріссіз қалады.
Dialogue: 0,0:16:20.21,0:16:22.21,Default,,0,0,0,,Алдағы жарықты өшіру туралы жақсы тілектер➡
Dialogue: 0,0:16:22.21,0:16:24.31,Default,,0,0,0,,Данжи Момояма!
Dialogue: 0,0:16:24.31,0:16:26.28,Default,,0,0,0,,О! ))
Dialogue: 0,0:16:30.22,0:16:32.22,Default,,0,0,0,,Гүл жақсы әйелге жақсы көрінеді.
Dialogue: 0,0:16:32.22,0:16:34.22,Default,,0,0,0,,Дәл сіз сияқты.
Dialogue: 0,0:16:34.22,0:16:36.22,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:36.22,0:16:38.26,Default,,0,0,0,,Мен Сето Томари➡
Dialogue: 0,0:16:38.26,0:16:42.20,Default,,0,0,0,,Ол түнгі аспанда жарқыраған жұлдыздармен жақсы көрінетін әлемдегі ең керемет әйел!
Dialogue: 0,0:16:42.20,0:16:44.20,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:16:44.20,0:16:47.20,Default,,0,0,0,,Айқай Теккен, Әділдік сөйле! ➡
Dialogue: 0,0:16:47.20,0:16:50.20,Default,,0,0,0,,Бұл үлкен аулаудың басы!
Dialogue: 0,0:16:50.20,0:16:52.21,Default,,0,0,0,,Жүр!
Dialogue: 0,0:16:53.21,0:16:55.71,Default,,0,0,0,,Гокукорэкихиме➡
Dialogue: 0,0:16:55.71,0:16:57.68,Default,,0,0,0,,Серас таза жарық!
Dialogue: 0,0:16:58.71,0:17:00.72,Default,,0,0,0,,Seras Purelight дағдылары➡
Dialogue: 0,0:17:00.72,0:17:03.25,Default,,0,0,0,,Soulblast Seras Clearlight➡
Dialogue: 0,0:17:03.25,0:17:06.72,Default,,0,0,0,,Қолында 2 карта, 2 артқы қорғаушы және 1 жан бар!
Dialogue: 0,0:17:06.72,0:17:08.72,Default,,0,0,0,,Уф...!
Dialogue: 0,0:17:08.72,0:17:11.73,Default,,0,0,0,,Сонымен қатар, жан жарылған Айқын Жарық шеберлігі➡
Dialogue: 0,0:17:11.73,0:17:14.76,Default,,0,0,0,,Келесі қарсыластың кезегі аяқталғанша➡
Dialogue: 0,0:17:14.76,0:17:18.20,Default,,0,0,0,,Түрмеден шақырылған бөлімшелердің автоматты қабілеттері іске қосылмайды!
Dialogue: 0,0:17:18.20,0:17:20.74,Default,,0,0,0,,Үгеге~ Қандай бұзық!
Dialogue: 0,0:17:20.74,0:17:23.24,Default,,0,0,0,,Құрамында 1 Жапырақ дағдысы бар➡
Dialogue: 0,0:17:23.24,0:17:25.21,Default,,0,0,0,,Қоңырау бұрышы➡
Dialogue: 0,0:17:25.21,0:17:27.21,Default,,0,0,0,,Шеберлікпен тағы бір бөлікті алыңыз!
Dialogue: 0,0:17:27.21,0:17:29.71,Default,,0,0,0,,Басқа бұрыш шақырылды.
Dialogue: 0,0:17:29.71,0:17:31.71,Default,,0,0,0,,Бір бөлікті шеберлікпен орналастырыңыз!
Dialogue: 0,0:17:31.71,0:17:34.72,Default,,0,0,0,,Жаңартқыш парағын шақыру➡
Dialogue: 0,0:17:34.72,0:17:37.22,Default,,0,0,0,,Серас Clearlight-қа қоңырау шалыңыз! ➡
Dialogue: 0,0:17:37.22,0:17:39.72,Default,,0,0,0,,Осы дағдымен Джотильді қамтиды!
Dialogue: 0,0:17:39.72,0:17:42.69,Default,,0,0,0,,А... Барлығы қамауға алынды!
Dialogue: 0,0:17:42.69,0:17:45.73,Default,,0,0,0,,Шабада ауа жақсы болды ма?
Dialogue: 0,0:17:45.73,0:17:48.70,Default,,0,0,0,,A~Менің сүйкімді қашып кеткен тұтқындарым~!
Dialogue: 0,0:17:48.70,0:17:51.70,Default,,0,0,0,,Орналастырылған парақтар саны енді 10➡ болғандықтан
Dialogue: 0,0:17:51.70,0:17:53.73,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 25 000➡
Dialogue: 0,0:17:53.73,0:17:55.70,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:17:55.70,0:17:58.71,Default,,0,0,0,,Үгегеге~! Бұрышта шабуыл!
Dialogue: 0,0:17:58.71,0:18:00.71,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:18:00.71,0:18:03.28,Default,,0,0,0,,Әділдік орнайтын кез келді!
Dialogue: 0,0:18:03.28,0:18:07.21,Default,,0,0,0,,Seras Pure Light көмегімен Авангардқа шабуыл жасаңыз! ➡
Dialogue: 0,0:18:07.21,0:18:09.28,Default,,0,0,0,,Шеберлікпен бұрышта тұр!
Dialogue: 0,0:18:09.28,0:18:11.32,Default,,0,0,0,,((мен көрдім!➡
Dialogue: 0,0:18:11.32,0:18:14.82,Default,,0,0,0,,Менің жеңіске жету жолым... Бұл ойындағы бетбұрыс! ))
Dialogue: 0,0:18:15.72,0:18:17.73,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:18:17.73,0:18:20.19,Default,,0,0,0,,Егер сіз сыни соққы алсаңыз, бәрі бітті, бірақ бұл шынымен жақсы ма?
Dialogue: 0,0:18:20.19,0:18:23.73,Default,,0,0,0,,Сіз білесіз бе? Бұл жерде шайқас басталады➡
Dialogue: 0,0:18:23.73,0:18:26.23,Default,,0,0,0,,Мен...жеңілмеймін.
Dialogue: 0,0:18:26.23,0:18:28.70,Default,,0,0,0,,Иә, білемін.
Dialogue: 0,0:18:28.70,0:18:30.71,Default,,0,0,0,,Бірақ бүгін мен жеңемін!
Dialogue: 0,0:18:30.71,0:18:34.21,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:18:34.21,0:18:36.21,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:18:36.21,0:18:38.21,Default,,0,0,0,,Алдыңғы триггер!
Dialogue: 0,0:18:38.21,0:18:40.21,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 10 000!
Dialogue: 0,0:18:40.21,0:18:42.22,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:18:42.22,0:18:44.22,Default,,0,0,0,,Емдеу триггері! ➡
Dialogue: 0,0:18:44.22,0:18:46.22,Default,,0,0,0,,Бұрыш қуаты плюс 10 000!
Dialogue: 0,0:18:47.19,0:18:49.69,Default,,0,0,0,,Йоша~Қауіпсіз!
Dialogue: 0,0:18:49.69,0:18:52.23,Default,,0,0,0,,Әлі де шабуылдар бар!
Dialogue: 0,0:18:52.23,0:18:54.20,Default,,0,0,0,,Бұрыштағы шабуыл!
Dialogue: 0,0:18:54.20,0:18:56.20,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:18:56.20,0:19:00.23,Default,,0,0,0,,Seras Clear Light көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:00.23,0:19:02.24,Default,,0,0,0,,Не?!
Dialogue: 0,0:19:02.24,0:19:06.21,Default,,0,0,0,,Super кісен Big Bang! ➡
Dialogue: 0,0:19:06.21,0:19:08.21,Default,,0,0,0,,Банг және банг!
Dialogue: 0,0:19:08.21,0:19:10.18,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:19:11.25,0:19:14.22,Default,,0,0,0,,Ұрыс соңында Серас Клирлайтты жаныңызға орналастырыңыз➡
Dialogue: 0,0:19:14.22,0:19:17.22,Default,,0,0,0,,1 картаны салыңыз Кезеңнің соңы.
Dialogue: 0,0:19:17.22,0:19:19.22,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:19.22,0:19:21.69,Default,,0,0,0,,Егер сіз авангардты қорғамаған болсаңыз➡
Dialogue: 0,0:19:21.69,0:19:23.69,Default,,0,0,0,,Бұл шынымен де ең жақсы болып шықты!
Dialogue: 0,0:19:23.69,0:19:25.69,Default,,0,0,0,,Бұл табандылық.
Dialogue: 0,0:19:25.69,0:19:27.80,Default,,0,0,0,,Қорқынышты бәсекелестік инстинкттер➡
Dialogue: 0,0:19:27.80,0:19:29.70,Default,,0,0,0,,Әдеттегідей, Миёко-сан.
Dialogue: 0,0:19:29.70,0:19:31.70,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:19:31.70,0:19:34.20,Default,,0,0,0,,Мяко, кеттік!
Dialogue: 0,0:19:34.20,0:19:36.70,Default,,0,0,0,,Persona Ride Nanakryl! ➡
Dialogue: 0,0:19:36.70,0:19:38.71,Default,,0,0,0,,Fralus шеберлігін түсіру➡ арқылы белсендіріңіз
Dialogue: 0,0:19:38.71,0:19:42.21,Default,,0,0,0,,Nanacryl мінгенде өзіңізге қоңырау шалыңыз➡
Dialogue: 0,0:19:42.21,0:19:44.71,Default,,0,0,0,,Уиллсренге шеберлікпен қоңырау шалыңыз!
Dialogue: 0,0:19:44.71,0:19:47.21,Default,,0,0,0,,Қамауда отырған Ноктран мен Виллсренді шақырыңыз➡
Dialogue: 0,0:19:47.21,0:19:49.22,Default,,0,0,0,,Енді қайтадан➡
Dialogue: 0,0:19:49.22,0:19:52.22,Default,,0,0,0,,Менің әлемім адасатын баққа айналады.
Dialogue: 0,0:19:56.69,0:19:59.23,Default,,0,0,0,,Түрмедегі Филандаға қоңырау шалыңыз! ➡
Dialogue: 0,0:19:59.23,0:20:01.23,Default,,0,0,0,,Уилл Ленмен шабуыл!
Dialogue: 0,0:20:01.23,0:20:03.23,Default,,0,0,0,,Бұл айналымда Фралустың шеберлігімен➡
Dialogue: 0,0:20:03.23,0:20:06.23,Default,,0,0,0,,Виллсреннің күші плюс 5000!
Dialogue: 0,0:20:06.23,0:20:08.20,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:20:08.20,0:20:10.24,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:20:10.24,0:20:12.21,Default,,0,0,0,,Нанакрилмен….
Dialogue: 0,0:20:12.21,0:20:14.21,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:20:14.21,0:20:17.18,Default,,0,0,0,,Жүр!
Dialogue: 0,0:20:18.71,0:20:21.72,Default,,0,0,0,,Алдын алу мүмкін емес….
Dialogue: 0,0:20:21.72,0:20:24.22,Default,,0,0,0,,Күзетші жоқ...!
Dialogue: 0,0:20:24.22,0:20:27.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:29.22,0:20:31.19,Default,,0,0,0,,Жеңімпаз! ➡
Dialogue: 0,0:20:31.19,0:20:33.23,Default,,0,0,0,,Мен~!
Dialogue: 0,0:20:33.23,0:20:37.23,Default,,0,0,0,,Мм...мына айтқым келгені!
Dialogue: 0,0:20:38.27,0:20:40.77,Default,,0,0,0,,Бұл жақсы жекпе-жек болды. Рука Мияко➡
Dialogue: 0,0:20:40.77,0:20:43.77,Default,,0,0,0,,Күшті ғой... Мм...
Dialogue: 0,0:20:43.77,0:20:48.28,Default,,0,0,0,,((Ертең мен ол адаммен төбелесемін➡
Dialogue: 0,0:20:48.28,0:20:51.25,Default,,0,0,0,,Осындай ғажайып күрескермен... ))
Dialogue: 0,0:20:52.71,0:20:56.22,Default,,0,0,0,,Сізбен күресу өте қызық.
Dialogue: 0,0:20:56.22,0:20:58.22,Default,,0,0,0,,Хмм...мен де!
Dialogue: 0,0:21:00.92,0:21:02.72,Default,,0,0,0,,((суық тигізбеңіз.
Dialogue: 0,0:21:02.72,0:21:05.69,Default,,0,0,0,,Анда-санда қайтып кел. Un➡
Dialogue: 0,0:21:05.69,0:21:07.70,Default,,0,0,0,,Барлығы жақсы деп үміттенемін.
Dialogue: 0,0:21:16.24,0:21:18.21,Default,,0,0,0,,Миёко-сан!
Dialogue: 0,0:21:19.21,0:21:22.21,Default,,0,0,0,,Барлығы үшін көп рахмет!
Dialogue: 0,0:21:24.21,0:21:27.72,Default,,0,0,0,,Әй... қолыңнан келгенін істе, көсем!
Dialogue: 0,0:21:27.72,0:21:29.75,Default,,0,0,0,,О, бұл да!
Dialogue: 0,0:21:29.75,0:21:32.72,Default,,0,0,0,,Дүние жүзіндегі әртүрлі адамдармен төбелесу➡
Dialogue: 0,0:21:32.72,0:21:35.76,Default,,0,0,0,,Сіздің мақсатыңыз бар ма? Un! ➡
Dialogue: 0,0:21:35.76,0:21:38.69,Default,,0,0,0,,Vanguard➡ арқылы бүкіл әлемдегі адамдармен байланысыңыз
Dialogue: 0,0:21:38.69,0:21:40.76,Default,,0,0,0,,Басқаша айтқанда….
Dialogue: 0,0:21:40.76,0:21:43.26,Default,,0,0,0,,Махаббат пен Бейбітшілік! ))
Dialogue: 0,0:23:15.69,0:23:17.73,Default,,0,0,0,,Мм...! Хмм...?
Dialogue: 0,0:23:17.73,0:23:20.73,Default,,0,0,0,,Бұл Юйю Кондо, солай ма?
Dialogue: 0,0:23:20.73,0:23:23.70,Default,,0,0,0,,Менің атым Акина Мейдо.
Dialogue: 0,0:23:23.70,0:23:25.70,Default,,0,0,0,,Мен және ➡
Dialogue: 0,0:23:25.70,0:23:28.20,Default,,0,0,0,,Күресіңіз!
