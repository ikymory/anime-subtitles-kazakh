Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.24,0:00:16.25,Default,,0,0,0,,Сәлем G-Is! ➡
Dialogue: 0,0:00:16.25,0:00:18.25,Default,,0,0,0,,Келіңіздер...! ➡
Dialogue: 0,0:00:18.25,0:00:20.75,Default,,0,0,0,,Уақыт келді!
Dialogue: 0,0:00:20.75,0:00:23.25,Default,,0,0,0,,Ең күштінің орнын алған адам➡
Dialogue: 0,0:00:23.25,0:00:25.79,Default,,0,0,0,,Бұл екеуі! ➡
Dialogue: 0,0:00:25.79,0:00:29.26,Default,,0,0,0,,Тағдырдың қанаты асқақ биіктерге...
Dialogue: 0,0:00:41.27,0:00:43.24,Default,,0,0,0,,Акина Мейдо~!
Dialogue: 0,0:00:43.24,0:00:45.27,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:45.27,0:00:50.28,Default,,0,0,0,,Жыласаң да, күлсең де үшінші мықты ақыры анықталады! ➡
Dialogue: 0,0:00:50.28,0:00:52.75,Default,,0,0,0,,Балалар! Бір сәтке де емес➡
Dialogue: 0,0:00:52.75,0:00:55.25,Default,,0,0,0,,Оны жіберіп алмаңыз!
Dialogue: 0,0:02:30.25,0:02:33.25,Default,,0,0,0,,Керемет~ Қазіргі жас ұрпақ➡
Dialogue: 0,0:02:33.25,0:02:35.72,Default,,0,0,0,,Бәсекелестікке түсетін адамдардың көп болғанына қуану керек.
Dialogue: 0,0:02:35.72,0:02:37.75,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:02:37.75,0:02:40.72,Default,,0,0,0,,Бірақ мен кімге қарсы шыға аламын?➡
Dialogue: 0,0:02:40.72,0:02:43.23,Default,,0,0,0,,Кагецу Якумо...тек сенсің.
Dialogue: 0,0:02:43.23,0:02:45.26,Default,,0,0,0,,Бұл үшін рахмет.
Dialogue: 0,0:02:45.26,0:02:47.70,Default,,0,0,0,,Финалды тамашалаған соң жасайық➡
Dialogue: 0,0:02:47.70,0:02:49.80,Default,,0,0,0,,Біздің шайқас.
Dialogue: 0,0:02:49.80,0:02:52.20,Default,,0,0,0,,Ах! Тек менің басқа эго➡
Dialogue: 0,0:02:52.20,0:02:54.24,Default,,0,0,0,,Мен қышидым.
Dialogue: 0,0:02:54.24,0:02:56.20,Default,,0,0,0,,Төрт жалын жын айдаһарын қолданып көріңіз.
Dialogue: 0,0:02:56.20,0:02:58.21,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:58.21,0:03:01.71,Default,,0,0,0,,Хаа….
Dialogue: 0,0:03:01.71,0:03:03.71,Default,,0,0,0,,Уау, әке! ➡
Dialogue: 0,0:03:03.71,0:03:05.71,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:03:05.71,0:03:08.22,Default,,0,0,0,,Бұл дерлік қалды. Кешіріңіз...!
Dialogue: 0,0:03:08.22,0:03:10.19,Default,,0,0,0,,Жүр, тез кетейік! а….
Dialogue: 0,0:03:11.25,0:03:14.22,Default,,0,0,0,,Үлкен аға, финалға өттіңіз➡
Dialogue: 0,0:03:14.22,0:03:16.22,Default,,0,0,0,,Бір-бірімізге дұрыс қолдау көрсетейік!
Dialogue: 0,0:03:16.22,0:03:18.23,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:27.70,0:03:31.24,Default,,0,0,0,,Акина!
Dialogue: 0,0:03:31.24,0:03:34.21,Default,,0,0,0,,Хикари?
Dialogue: 0,0:03:34.21,0:03:36.71,Default,,0,0,0,,Жоқ, Эрика Миоджо.
Dialogue: 0,0:03:36.71,0:03:38.71,Default,,0,0,0,,Олар ұқсас.
Dialogue: 0,0:03:38.71,0:03:41.75,Default,,0,0,0,,Дұрыс... хаха! ➡
Dialogue: 0,0:03:41.75,0:03:45.22,Default,,0,0,0,,Дүниеде бір-біріне дәл ұқсайтын үш адам бар дейді➡
Dialogue: 0,0:03:45.22,0:03:47.22,Default,,0,0,0,,Бұл мені таң қалдырды.
Dialogue: 0,0:03:48.22,0:03:50.76,Default,,0,0,0,,Уәде етілгендей, бұл финал!
Dialogue: 0,0:03:50.76,0:03:53.70,Default,,0,0,0,,Ум! Кім жеңсе де, өшпенділік болмайды!
Dialogue: 0,0:03:53.70,0:03:55.70,Default,,0,0,0,,Мен не істеуім керек?➡
Dialogue: 0,0:03:55.70,0:03:57.73,Default,,0,0,0,,Жеңілсең бір-екі реніш айт➡
Dialogue: 0,0:03:57.73,0:03:59.70,Default,,0,0,0,,Мен мұны айта аламын.
Dialogue: 0,0:03:59.70,0:04:01.70,Default,,0,0,0,,Онда жүр!
Dialogue: 0,0:04:01.70,0:04:05.21,Default,,0,0,0,,Хэхе...! Кек сақтамаңыз.
Dialogue: 0,0:04:05.21,0:04:07.21,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:04:07.21,0:04:09.21,Default,,0,0,0,,Таку….
Dialogue: 0,0:04:09.21,0:04:11.21,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:11.21,0:04:13.18,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:04:15.25,0:04:19.25,Default,,0,0,0,,Көптеген кескілескен шайқастар болған Deluxe! ➡
Dialogue: 0,0:04:19.25,0:04:23.73,Default,,0,0,0,,3 күн алдын ала және 2 күн финал ➡
Dialogue: 0,0:04:23.73,0:04:25.69,Default,,0,0,0,,Күлкі мен көз жасы ➡
Dialogue: 0,0:04:25.69,0:04:28.70,Default,,0,0,0,,Өте қызықты тәжірибе! ➡
Dialogue: 0,0:04:28.70,0:04:31.20,Default,,0,0,0,,Бұл соңғы жекпе-жек➡
Dialogue: 0,0:04:31.20,0:04:33.20,Default,,0,0,0,,Бұл ақыры басталды! ➡
Dialogue: 0,0:04:33.20,0:04:36.20,Default,,0,0,0,,Өткізілетін жердегі толқу дәл болды➡
Dialogue: 0,0:04:36.20,0:04:38.71,Default,,0,0,0,,Жыланбалық көтеріледі!
Dialogue: 0,0:04:39.71,0:04:43.21,Default,,0,0,0,,Олай болса! 3-ші люкс➡
Dialogue: 0,0:04:43.21,0:04:46.18,Default,,0,0,0,,Финал... Фай!
Dialogue: 0,0:04:50.29,0:04:52.72,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:04:52.72,0:04:55.29,Default,,0,0,0,,Сыбызғышы Бирниста.
Dialogue: 0,0:04:55.29,0:04:57.73,Default,,0,0,0,,Амбиция қанаттары Соел.
Dialogue: 0,0:04:57.73,0:05:00.20,Default,,0,0,0,,Менің кезегім Адольф➡
Dialogue: 0,0:05:00.20,0:05:02.20,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:05:02.20,0:05:05.70,Default,,0,0,0,,Менің кезегім Бентестаға міну... Шабуыл.
Dialogue: 0,0:05:05.70,0:05:08.70,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:05:08.70,0:05:10.74,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:05:10.74,0:05:12.71,Default,,0,0,0,,Эльгенияға міну➡
Dialogue: 0,0:05:12.71,0:05:14.74,Default,,0,0,0,,Қызметшіге қоңырау шалыңыз және Almove➡
Dialogue: 0,0:05:14.74,0:05:16.71,Default,,0,0,0,,Almove көмегімен шабуыл жасаңыз!
Dialogue: 0,0:05:16.71,0:05:18.71,Default,,0,0,0,,Күзет. шабуыл.
Dialogue: 0,0:05:18.71,0:05:20.72,Default,,0,0,0,,Күзетші! шабуыл!
Dialogue: 0,0:05:20.72,0:05:23.72,Default,,0,0,0,,Күзетші! Соңына бұрылу.
Dialogue: 0,0:05:23.72,0:05:25.72,Default,,0,0,0,,Эй, мен сені қорғаймын.
Dialogue: 0,0:05:25.72,0:05:27.72,Default,,0,0,0,,Мүмкіндігінше қорғаңыз.
Dialogue: 0,0:05:27.72,0:05:29.72,Default,,0,0,0,,Шабуыл жасаған кезде шабуыл жасаңыз!
Dialogue: 0,0:05:29.72,0:05:31.73,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:05:31.73,0:05:33.70,Default,,0,0,0,,Азенсиорға бару.
Dialogue: 0,0:05:33.70,0:05:35.73,Default,,0,0,0,,Бентестаға шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:05:35.73,0:05:38.70,Default,,0,0,0,,Өткізбейтін Нилберис Соелге қоңырау шалыңыз.
Dialogue: 0,0:05:38.70,0:05:40.70,Default,,0,0,0,,Өткізбейтін шабуыл!
Dialogue: 0,0:05:40.70,0:05:42.70,Default,,0,0,0,,Күзетші. шабуыл!
Dialogue: 0,0:05:42.70,0:05:44.71,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:05:44.71,0:05:46.71,Default,,0,0,0,,Шабуыл! күзетші.
Dialogue: 0,0:05:46.71,0:05:48.71,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:05:48.71,0:05:50.71,Default,,0,0,0,,Бар күшіңізбен қорғаңыз және шабуыл жасаңыз...
Dialogue: 0,0:05:50.71,0:05:52.71,Default,,0,0,0,,Бұл сізге карточкалар жеткіліксіз дегенді білдірмей ме?
Dialogue: 0,0:05:52.71,0:05:54.72,Default,,0,0,0,,Бұл өзара.
Dialogue: 0,0:05:54.72,0:05:56.72,Default,,0,0,0,,Ұқсас адамдар бар ма?
Dialogue: 0,0:05:56.72,0:05:58.72,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:05:58.72,0:06:00.72,Default,,0,0,0,,Хмм... солай шығар!
Dialogue: 0,0:06:00.72,0:06:02.72,Default,,0,0,0,,Міне!
Dialogue: 0,0:06:02.72,0:06:05.19,Default,,0,0,0,,Мен бірінші барамын... менің кезегім! ➡
Dialogue: 0,0:06:05.19,0:06:08.73,Default,,0,0,0,,Тағдырдың қанаты Болашақтан Мұнда! ➡
Dialogue: 0,0:06:08.73,0:06:12.23,Default,,0,0,0,,Риэл Дракониске, Қасиетті уақыттың тағдыры➡
Dialogue: 0,0:06:12.23,0:06:14.20,Default,,0,0,0,,Жүр!
Dialogue: 0,0:06:20.71,0:06:23.71,Default,,0,0,0,,Діни шақыру Гурагаон➡
Dialogue: 0,0:06:23.71,0:06:26.72,Default,,0,0,0,,Drive Plus 1➡ катушкасының шеберлігі
Dialogue: 0,0:06:26.72,0:06:28.75,Default,,0,0,0,,Қызметшімен шабуыл!
Dialogue: 0,0:06:28.75,0:06:31.72,Default,,0,0,0,,Кесу. Діндармен шабуыл!
Dialogue: 0,0:06:31.72,0:06:33.72,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:06:33.72,0:06:35.72,Default,,0,0,0,,Драконис барабанымен шабуыл!
Dialogue: 0,0:06:35.72,0:06:37.73,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:06:37.73,0:06:40.70,Default,,0,0,0,,Діни шақыру. Күзетші жоқ.
Dialogue: 0,0:06:40.70,0:06:43.73,Default,,0,0,0,,➡
Dialogue: 0,0:06:43.73,0:06:46.74,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:06:46.74,0:06:48.70,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:06:48.70,0:06:51.71,Default,,0,0,0,,Триггерді тарту Діни қуат плюс 10000!
Dialogue: 0,0:06:53.21,0:06:55.24,Default,,0,0,0,,Дінге шабуыл!
Dialogue: 0,0:06:55.24,0:06:57.25,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:06:57.25,0:07:00.22,Default,,0,0,0,,Бұрылыстың соңы. Енді менің кезегім.
Dialogue: 0,0:07:00.22,0:07:02.22,Default,,0,0,0,,Енді маған көрсетіңіз➡
Dialogue: 0,0:07:02.22,0:07:04.25,Default,,0,0,0,,Мен бәрін сақтап қалдым деп үміттенемін➡
Dialogue: 0,0:07:04.25,0:07:07.72,Default,,0,0,0,,Керемет кереметті қолдайтын бас періште!
Dialogue: 0,0:07:07.72,0:07:09.76,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:07:09.76,0:07:11.73,Default,,0,0,0,,Құтқару қанаттары көктен!
Dialogue: 0,0:07:11.73,0:07:13.70,Default,,0,0,0,,Ғажайып тағдыр Резаэльге➡
Dialogue: 0,0:07:13.70,0:07:15.70,Default,,0,0,0,,Жүр!
Dialogue: 0,0:07:21.20,0:07:23.20,Default,,0,0,0,,Новияға шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:07:23.20,0:07:25.24,Default,,0,0,0,,Сол дағдымен Гаругаонға қоңырау шалыңыз➡
Dialogue: 0,0:07:25.24,0:07:27.21,Default,,0,0,0,,Novia-мен шабуыл!
Dialogue: 0,0:07:27.21,0:07:29.21,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:07:29.21,0:07:31.21,Default,,0,0,0,,Резаэльмен шабуыл!
Dialogue: 0,0:07:31.21,0:07:34.22,Default,,0,0,0,,Нилберис пен Саврусты шеберлікпен шақыр.
Dialogue: 0,0:07:34.22,0:07:36.22,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:07:36.22,0:07:39.22,Default,,0,0,0,,➡
Dialogue: 0,0:07:39.22,0:07:41.26,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:07:41.26,0:07:44.73,Default,,0,0,0,,Алдыңғы триггер Алдыңғы қатардағы қуат плюс 10 000!
Dialogue: 0,0:07:44.73,0:07:46.70,Default,,0,0,0,,Өткізбейтін шабуыл!
Dialogue: 0,0:07:46.70,0:07:48.73,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:07:48.73,0:07:51.20,Default,,0,0,0,,Нилбериспен шабуыл. Күзетші жоқ.
Dialogue: 0,0:07:51.20,0:07:53.20,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:07:53.20,0:07:55.24,Default,,0,0,0,,Сәлем Эрика.
Dialogue: 0,0:07:55.24,0:07:58.24,Default,,0,0,0,,Не? Не айтарымды ойланып қалдым➡
Dialogue: 0,0:07:58.24,0:08:00.71,Default,,0,0,0,,Бірақ мен оны жасырғаным дұрыс емес сияқты➡
Dialogue: 0,0:08:00.71,0:08:02.74,Default,,0,0,0,,Мен айтайын.
Dialogue: 0,0:08:02.74,0:08:05.21,Default,,0,0,0,,Бүгін мені көруге әкем келеді.
Dialogue: 0,0:08:05.21,0:08:08.22,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:08:08.22,0:08:10.22,Default,,0,0,0,,Акина Хаса➡
Dialogue: 0,0:08:10.22,0:08:12.22,Default,,0,0,0,,Әкең туралы не ойлайсың?
Dialogue: 0,0:08:12.22,0:08:14.72,Default,,0,0,0,,Мен сені батыр деп ойлаймын.
Dialogue: 0,0:08:14.72,0:08:17.73,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:08:17.73,0:08:19.69,Default,,0,0,0,,Мен де.
Dialogue: 0,0:08:19.69,0:08:22.20,Default,,0,0,0,,Ағам жоғалып кеткеннен кейін➡
Dialogue: 0,0:08:22.20,0:08:24.23,Default,,0,0,0,,Әкеңе де қиын болса керек➡
Dialogue: 0,0:08:24.23,0:08:27.20,Default,,0,0,0,,Інімді іздеу және менің уайымдарым➡
Dialogue: 0,0:08:27.20,0:08:29.74,Default,,0,0,0,,Қолынан келгеннің бәрін жасады.
Dialogue: 0,0:08:29.74,0:08:33.21,Default,,0,0,0,,Ол біз үшін бір күн демалмады.
Dialogue: 0,0:08:33.21,0:08:35.71,Default,,0,0,0,,Бірақ мен➡
Dialogue: 0,0:08:35.71,0:08:37.71,Default,,0,0,0,,Ол кезде ағамнан басқаны ойламайтынмын➡
Dialogue: 0,0:08:37.71,0:08:39.71,Default,,0,0,0,,Мен сізге назар аудара алмаймын➡
Dialogue: 0,0:08:39.71,0:08:41.72,Default,,0,0,0,,Мен бұл жерге өзімнің сылтауыма қарамай келдім.
Dialogue: 0,0:08:41.72,0:08:44.72,Default,,0,0,0,,Мен кеткеннен кейін әкеме не болды?➡
Dialogue: 0,0:08:44.72,0:08:46.72,Default,,0,0,0,,Бұл туралы ойламаңыз...
Dialogue: 0,0:08:46.72,0:08:48.72,Default,,0,0,0,,Бұл... Мен білемін!
Dialogue: 0,0:08:48.72,0:08:50.73,Default,,0,0,0,,Болашақ өзгерді.
Dialogue: 0,0:08:50.73,0:08:52.73,Default,,0,0,0,,Сонда менің әлемім кетті ме?➡
Dialogue: 0,0:08:52.73,0:08:54.73,Default,,0,0,0,,Мен әлі де жалғасып жатқанын білмеймін.
Dialogue: 0,0:08:54.73,0:08:56.70,Default,,0,0,0,,Буца➡
Dialogue: 0,0:08:56.70,0:08:58.73,Default,,0,0,0,,Мен ойлағандай…
Dialogue: 0,0:08:58.73,0:09:00.70,Default,,0,0,0,,Кешіріңіз➡
Dialogue: 0,0:09:00.70,0:09:02.74,Default,,0,0,0,,Жылағым келетін кездер болады.
Dialogue: 0,0:09:02.74,0:09:05.21,Default,,0,0,0,,A…. Енді мен➡
Dialogue: 0,0:09:05.21,0:09:07.74,Default,,0,0,0,,Міне, осындай таңдау жасау керек➡
Dialogue: 0,0:09:07.74,0:09:10.21,Default,,0,0,0,,Мен оны ешқашан ұмытпаймын деп ойлаймын.
Dialogue: 0,0:09:10.21,0:09:12.71,Default,,0,0,0,,Осы дүниеде толық өмір сүріңіз➡
Dialogue: 0,0:09:12.71,0:09:14.72,Default,,0,0,0,,Не істегіңіз келсе, соны жасаңыз➡
Dialogue: 0,0:09:14.72,0:09:17.72,Default,,0,0,0,,Күліп, көңіл көтеріңіз➡
Dialogue: 0,0:09:17.72,0:09:20.72,Default,,0,0,0,,Мен қазір бақыттымын!
Dialogue: 0,0:09:20.72,0:09:22.72,Default,,0,0,0,,Әкеме жететіндей➡
Dialogue: 0,0:09:22.72,0:09:25.19,Default,,0,0,0,,Мен жарқырай беремін!
Dialogue: 0,0:09:26.69,0:09:28.70,Default,,0,0,0,,Біріншіден, люкс жеңімпазы!
Dialogue: 0,0:09:28.70,0:09:30.73,Default,,0,0,0,,Мен де!
Dialogue: 0,0:09:30.73,0:09:33.23,Default,,0,0,0,,Қасиетті күш пен уақыт құдіреті➡
Dialogue: 0,0:09:33.23,0:09:35.20,Default,,0,0,0,,Мен сізге сол қос спиралды көрсетемін! ➡
Dialogue: 0,0:09:35.20,0:09:37.24,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:09:37.24,0:09:39.21,Default,,0,0,0,,Persona Ride! ➡
Dialogue: 0,0:09:39.21,0:09:41.71,Default,,0,0,0,,Драконис барабаны!
Dialogue: 0,0:09:41.71,0:09:45.21,Default,,0,0,0,,Қызметкерді шеберлікпен және жетекпен +1 байланыстырыңыз.
Dialogue: 0,0:09:45.21,0:09:47.72,Default,,0,0,0,,Қызметшіге шеберлікпен қоңырау шалыңыз!
Dialogue: 0,0:09:47.72,0:09:49.75,Default,,0,0,0,,Almove-ге қоңырау шалыңыз!
Dialogue: 0,0:09:49.75,0:09:53.22,Default,,0,0,0,,Сіз соңғы кезекте Құдайдың шеберлігін пайдаланбадыңыз.
Dialogue: 0,0:09:53.22,0:09:55.72,Default,,0,0,0,,Ол кереметсіз өмір сүре ала ма?
Dialogue: 0,0:09:55.72,0:09:57.73,Default,,0,0,0,,Мен шыдаймын!
Dialogue: 0,0:09:57.73,0:09:59.69,Default,,0,0,0,,Иә! Ешқандай ерекшелеу ➡ болмаса да
Dialogue: 0,0:09:59.69,0:10:02.20,Default,,0,0,0,,Өкінбе!
Dialogue: 0,0:10:02.20,0:10:04.23,Default,,0,0,0,,Қызметшімен шабуыл!
Dialogue: 0,0:10:04.23,0:10:07.20,Default,,0,0,0,,Күзетші! Reel Draconis-пен шабуыл жасаңыз!
Dialogue: 0,0:10:07.20,0:10:10.21,Default,,0,0,0,,Қасиетті айдаһар Габриэлиус шеберлікпен➡
Dialogue: 0,0:10:10.21,0:10:12.71,Default,,0,0,0,,Қоңырау шалыңыз!
Dialogue: 0,0:10:12.71,0:10:14.71,Default,,0,0,0,,Кейін қалсаң, капитан мені сөгіп тастайды.
Dialogue: 0,0:10:17.25,0:10:19.71,Default,,0,0,0,,Тағдырлы шайқас сияқты. Ах!
Dialogue: 0,0:10:21.22,0:10:23.22,Default,,0,0,0,,Акина Акина.
Dialogue: 0,0:10:23.22,0:10:25.72,Default,,0,0,0,,Габуэлий!
Dialogue: 0,0:10:25.72,0:10:28.76,Default,,0,0,0,,Е...Ақина да естіп тұр ма?
Dialogue: 0,0:10:28.76,0:10:32.69,Default,,0,0,0,,Бұл біздің жүрегіміздің күрес арқылы шексіз жақындасуының нәтижесі болса керек.
Dialogue: 0,0:10:32.69,0:10:34.73,Default,,0,0,0,,Иә...бұл жігіт➡
Dialogue: 0,0:10:34.73,0:10:38.20,Default,,0,0,0,,Ішімдегі енот иттей ұйықтап жатырмын.
Dialogue: 0,0:10:38.20,0:10:41.20,Default,,0,0,0,,Бірақ қазір мен осылай сөйлей аламын.
Dialogue: 0,0:10:41.20,0:10:44.24,Default,,0,0,0,,Түсіндім... бұл жақсы.
Dialogue: 0,0:10:44.24,0:10:47.21,Default,,0,0,0,,Рахмет... Габуэлиус!
Dialogue: 0,0:10:48.24,0:10:51.71,Default,,0,0,0,,Маған ештеңе қалмады➡
Dialogue: 0,0:10:51.71,0:10:55.22,Default,,0,0,0,,Енді сенің күресіңді тамашалайық.
Dialogue: 0,0:10:55.22,0:10:58.22,Default,,0,0,0,,Эрика Миоджо Акина Мейдо➡
Dialogue: 0,0:10:58.22,0:11:01.72,Default,,0,0,0,,Менің күшімді барынша пайдаланыңыз!
Dialogue: 0,0:11:01.72,0:11:04.23,Default,,0,0,0,,Әрине! аа!
Dialogue: 0,0:11:04.23,0:11:06.69,Default,,0,0,0,,Габуэлиустың шеберлігі іске қосылды!
Dialogue: 0,0:11:06.69,0:11:08.70,Default,,0,0,0,,Палубаның жоғарғы жағына қараңыз➡
Dialogue: 0,0:11:08.70,0:11:10.70,Default,,0,0,0,,Қою.
Dialogue: 0,0:11:10.70,0:11:12.70,Default,,0,0,0,,Бұл... күзетші!
Dialogue: 0,0:11:12.70,0:11:15.70,Default,,0,0,0,,➡
Dialogue: 0,0:11:15.70,0:11:18.71,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:11:18.71,0:11:21.24,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:11:21.24,0:11:23.21,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:11:23.21,0:11:27.22,Default,,0,0,0,,Габуэлийдің күші плюс 10000 критикалық плюс 1!
Dialogue: 0,0:11:27.22,0:11:29.72,Default,,0,0,0,,Тағдырдың жетелеуі, Заманның негізгі ағымы➡
Dialogue: 0,0:11:29.72,0:11:32.25,Default,,0,0,0,,Мәні өткенге секіру! ➡
Dialogue: 0,0:11:32.25,0:11:35.76,Default,,0,0,0,,Уақыт өзгереді, Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:11:36.72,0:11:39.69,Default,,0,0,0,,Қондырғышқа мініп, жетекті 1-ге орнатыңыз.
Dialogue: 0,0:11:39.69,0:11:41.80,Default,,0,0,0,,Міне!
Dialogue: 0,0:11:41.80,0:11:43.70,Default,,0,0,0,,Габриэлиуспен шабуыл!
Dialogue: 0,0:11:43.70,0:11:45.70,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:11:45.70,0:11:47.70,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:11:47.70,0:11:50.21,Default,,0,0,0,,Алдыңғы триггер Алдыңғы қатардағы қуат плюс 10 000!
Dialogue: 0,0:11:50.21,0:11:52.21,Default,,0,0,0,,Ух...!
Dialogue: 0,0:11:52.21,0:11:55.71,Default,,0,0,0,,Reel көмегімен қайтадан шабуыл жасаңыз!
Dialogue: 0,0:11:59.21,0:12:01.22,Default,,0,0,0,,Ха~!
Dialogue: 0,0:12:01.22,0:12:03.22,Default,,0,0,0,,Соэлдің шеберлігі іске қосылды!
Dialogue: 0,0:12:03.22,0:12:05.22,Default,,0,0,0,,Резаэлдің күші плюс 5000!
Dialogue: 0,0:12:05.22,0:12:07.22,Default,,0,0,0,,Көбірек сақ болыңыз!
Dialogue: 0,0:12:10.23,0:12:12.69,Default,,0,0,0,,Бір ғана триггермен ену...!
Dialogue: 0,0:12:12.69,0:12:15.70,Default,,0,0,0,,Мына күзетшіге сал!
Dialogue: 0,0:12:15.70,0:12:18.70,Default,,0,0,0,,Drive➡
Dialogue: 0,0:12:18.70,0:12:20.70,Default,,0,0,0,,Тексеру...!
Dialogue: 0,0:12:23.24,0:12:25.71,Default,,0,0,0,,Триггер жоқ. Жақсы!
Dialogue: 0,0:12:25.71,0:12:27.71,Default,,0,0,0,,Ку...әлі емес! ➡
Dialogue: 0,0:12:27.71,0:12:29.71,Default,,0,0,0,,Габриэлиуспен шабуыл!
Dialogue: 0,0:12:29.71,0:12:31.71,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:12:31.71,0:12:33.72,Default,,0,0,0,,Дінге шабуыл!
Dialogue: 0,0:12:33.72,0:12:35.72,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:12:35.72,0:12:38.22,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:12:38.22,0:12:40.22,Default,,0,0,0,,Керемет шабуыл мен қорғаныс!
Dialogue: 0,0:12:40.22,0:12:42.26,Default,,0,0,0,,Бұл жақын қоңырау болды.
Dialogue: 0,0:12:42.26,0:12:45.23,Default,,0,0,0,,Стратегия мен сәттілік... екеуінің арасындағы шайқас!
Dialogue: 0,0:12:45.23,0:12:47.20,Default,,0,0,0,,Қызық болып барады.
Dialogue: 0,0:12:48.20,0:12:50.20,Default,,0,0,0,,Мен бұған шыдадым. Мен жасаймын.
Dialogue: 0,0:12:50.20,0:12:52.20,Default,,0,0,0,,Осындай қызықты жекпе-жек➡
Dialogue: 0,0:12:52.20,0:12:54.20,Default,,0,0,0,,Бұл жерде аяқталуға әлі ерте!
Dialogue: 0,0:12:54.20,0:12:56.27,Default,,0,0,0,,(Буши) «Маған қара!» (Эмими) «Маған қара!»
Dialogue: 0,0:12:56.27,0:12:58.74,Default,,0,0,0,,Мен Нао-сенпайға уәде бердім➡
Dialogue: 0,0:12:58.74,0:13:01.74,Default,,0,0,0,,Міндетті түрде жеңіп, профессионал➡ бол
Dialogue: 0,0:13:01.74,0:13:04.71,Default,,0,0,0,,Қарсыластармен бір сахнада жарысу!
Dialogue: 0,0:13:04.71,0:13:08.22,Default,,0,0,0,,Акина осылай істегісі келеді.
Dialogue: 0,0:13:08.22,0:13:10.22,Default,,0,0,0,,Ах! Бірақ➡
Dialogue: 0,0:13:10.22,0:13:12.72,Default,,0,0,0,,Нао-сан да менің мақсатым.
Dialogue: 0,0:13:12.72,0:13:15.26,Default,,0,0,0,,Мен де сол жерді көздеп отырмын.
Dialogue: 0,0:13:15.26,0:13:18.23,Default,,0,0,0,,Бұл біздің бірдей нәрсеге қол жеткізіп жатқанымызды білдіреді!
Dialogue: 0,0:13:18.23,0:13:20.73,Default,,0,0,0,,Ум! Бірақ➡
Dialogue: 0,0:13:20.73,0:13:23.20,Default,,0,0,0,,Мен оны бірінші болып ұстаймын!
Dialogue: 0,0:13:23.20,0:13:25.23,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:13:25.23,0:13:28.20,Default,,0,0,0,,Тағдырдың тілегі, Байлау патшасы➡
Dialogue: 0,0:13:28.20,0:13:31.21,Default,,0,0,0,,Өміріңді ақ қанатпен басқар!
Dialogue: 0,0:13:31.21,0:13:33.21,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:13:36.24,0:13:39.25,Default,,0,0,0,,Король Резаэль Витаның ғажайып тағдыры!
Dialogue: 0,0:13:43.72,0:13:45.69,Default,,0,0,0,,Гаругаонға қоңырау шалыңыз.
Dialogue: 0,0:13:45.69,0:13:47.69,Default,,0,0,0,,Және….
Dialogue: 0,0:13:47.69,0:13:49.69,Default,,0,0,0,,Құтқарылу қанаттарымен ұшыңдар➡
Dialogue: 0,0:13:49.69,0:13:52.73,Default,,0,0,0,,Айдан шыққан нағыз аң➡
Dialogue: 0,0:13:52.73,0:13:56.70,Default,,0,0,0,,Аспанда жарқыраған тағы бір керемет!
Dialogue: 0,0:13:56.70,0:13:58.73,Default,,0,0,0,,Қоңырау шалыңыз! ➡
Dialogue: 0,0:13:58.73,0:14:01.70,Default,,0,0,0,,Ғажайып иллюзиондық аң Рифистор!
Dialogue: 0,0:14:04.67,0:14:06.67,Default,,0,0,0,,Ғажайып келу! ➡
Dialogue: 0,0:14:06.67,0:14:09.71,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:14:09.71,0:14:12.68,Default,,0,0,0,,Барлық түсірілген маңызды триггерлерді палубаға қайтарыңыз➡
Dialogue: 0,0:14:12.68,0:14:14.68,Default,,0,0,0,,Жүргізу плюс 1!
Dialogue: 0,0:14:15.68,0:14:17.69,Default,,0,0,0,,Корпус мүшелеріне бір-біріне негізсіз қылыш кезенуге мүлде болмайды!
Dialogue: 0,0:14:17.69,0:14:19.69,Default,,0,0,0,,Қалаған жерде!
Dialogue: 0,0:14:19.69,0:14:21.69,Default,,0,0,0,,Гаргаонмен шабуыл! күзетші.
Dialogue: 0,0:14:21.69,0:14:24.19,Default,,0,0,0,,Рифистормен шабуыл!
Dialogue: 0,0:14:24.19,0:14:27.70,Default,,0,0,0,,Бір кесек болса да алға... Қол соз!
Dialogue: 0,0:14:27.70,0:14:31.23,Default,,0,0,0,,Блиц ордені Аспан жарығы!
Dialogue: 0,0:14:31.23,0:14:34.70,Default,,0,0,0,,Ах...! Палубаның жоғарғы картасына қараңыз➡
Dialogue: 0,0:14:34.70,0:14:38.17,Default,,0,0,0,,Оны күзет пен қалқанға қой, плюс 10 000!
Dialogue: 0,0:14:38.17,0:14:40.17,Default,,0,0,0,,Көбірек сақ болыңыз!
Dialogue: 0,0:14:40.17,0:14:43.18,Default,,0,0,0,,Резаэль Витамен шабуыл!
Dialogue: 0,0:14:43.18,0:14:46.18,Default,,0,0,0,,Габуэлиус пен Соелді шеберлікпен шақырыңыз!
Dialogue: 0,0:14:46.18,0:14:49.22,Default,,0,0,0,,Сонымен қатар, Рифисторға қоңырау шалыңыз!
Dialogue: 0,0:14:49.22,0:14:51.69,Default,,0,0,0,,Бірге күресетін достар!
Dialogue: 0,0:14:51.69,0:14:54.69,Default,,0,0,0,,Менде қазір осы ғана!
Dialogue: 0,0:14:54.69,0:14:56.69,Default,,0,0,0,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:14:56.69,0:14:58.69,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:14:58.69,0:15:01.70,Default,,0,0,0,,➡
Dialogue: 0,0:15:01.70,0:15:04.70,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:15:04.70,0:15:06.70,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:15:06.70,0:15:08.70,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:15:08.70,0:15:10.74,Default,,0,0,0,,Бір бөлік жеткіліксіз!
Dialogue: 0,0:15:10.74,0:15:14.68,Default,,0,0,0,,Сонда Габуэлийдің күші плюс 10 000, ал критикалық плюс 1!
Dialogue: 0,0:15:14.68,0:15:17.18,Default,,0,0,0,,Габриэлиуспен шабуыл!
Dialogue: 0,0:15:17.18,0:15:19.71,Default,,0,0,0,,Күзетші! Reel Amorta.
Dialogue: 0,0:15:19.71,0:15:22.18,Default,,0,0,0,,Шабуылдар шеберлікпен соқпайды!
Dialogue: 0,0:15:22.18,0:15:24.22,Default,,0,0,0,,Drive➡
Dialogue: 0,0:15:24.22,0:15:26.19,Default,,0,0,0,,Тексеріңіз!
Dialogue: 0,0:15:26.19,0:15:28.22,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:15:28.22,0:15:31.19,Default,,0,0,0,,Жоқ...! Рефистордың қуаты плюс 10000➡
Dialogue: 0,0:15:31.19,0:15:33.83,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:15:33.83,0:15:36.80,Default,,0,0,0,,⸨Мен енді оған кедергі жасай алмаймын! ⸩
Dialogue: 0,0:15:37.70,0:15:40.67,Default,,0,0,0,,Авангардқа Рефистормен шабуыл жасаңыз!
Dialogue: 0,0:15:41.70,0:15:44.17,Default,,0,0,0,,Онда осы жерде бөлісейік.
Dialogue: 0,0:15:44.17,0:15:47.68,Default,,0,0,0,,Жүр!
Dialogue: 0,0:15:48.71,0:15:50.68,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:15:56.22,0:15:58.19,Default,,0,0,0,,Зақымдануды тексеру➡
Dialogue: 0,0:15:58.19,0:16:00.19,Default,,0,0,0,,Бірінші тармақ….
Dialogue: 0,0:16:02.19,0:16:04.19,Default,,0,0,0,,Екінші тармақ➡
Dialogue: 0,0:16:04.19,0:16:06.69,Default,,0,0,0,,Ах...хехе.
Dialogue: 0,0:16:06.69,0:16:10.20,Default,,0,0,0,,Керемет уақыт!
Dialogue: 0,0:16:10.20,0:16:13.20,Default,,0,0,0,,Триггерді жеңіңіз!
Dialogue: 0,0:16:13.20,0:16:15.24,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:16:15.24,0:16:18.21,Default,,0,0,0,,Хохо~! Мен бұл дамуды бұрын көрдім.
Dialogue: 0,0:16:19.21,0:16:21.68,Default,,0,0,0,,Фу Бұл керемет...
Dialogue: 0,0:16:21.68,0:16:23.71,Default,,0,0,0,,Көктегі жарықта➡
Dialogue: 0,0:16:23.71,0:16:26.21,Default,,0,0,0,,Карточкаларды қазып жатқандықтан келді.
Dialogue: 0,0:16:28.18,0:16:31.22,Default,,0,0,0,,Ахаха...! Хехе...!
Dialogue: 0,0:16:31.22,0:16:33.69,Default,,0,0,0,,Бұл жолы мен оны ұстадым!
Dialogue: 0,0:16:33.69,0:16:36.19,Default,,0,0,0,,Есіңде жоқ! Сол кездегі ұрыс.
Dialogue: 0,0:16:36.19,0:16:38.23,Default,,0,0,0,,Un.
Dialogue: 0,0:16:38.23,0:16:41.20,Default,,0,0,0,,Ол кезде екеуміз де бір-біріміз үшін соғысатынбыз.
Dialogue: 0,0:16:41.20,0:16:43.20,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:43.20,0:16:45.23,Default,,0,0,0,,Бірақ бүгін➡
Dialogue: 0,0:16:45.23,0:16:48.24,Default,,0,0,0,,Сіз басқа ешкім үшін емес, өзіңіз үшін күресіп жатырсыз.
Dialogue: 0,0:16:48.24,0:16:51.17,Default,,0,0,0,,Ах! Орындағыңыз келетін тілектеріңіз үшін.
Dialogue: 0,0:16:51.17,0:16:53.67,Default,,0,0,0,,Соңына дейін күтіңіз.
Dialogue: 0,0:16:53.67,0:16:56.21,Default,,0,0,0,,Қолыңызда бардың бәрін беріңіз.
Dialogue: 0,0:16:56.21,0:16:58.21,Default,,0,0,0,,Қолыңызды созыңыз!
Dialogue: 0,0:16:58.21,0:17:01.68,Default,,0,0,0,,Ойымыз басқа болса да, істеген ісіміз сол қалпында қалады!
Dialogue: 0,0:17:01.68,0:17:04.72,Default,,0,0,0,,Сәлем Эрика! Кеттік, Акина!
Dialogue: 0,0:17:04.72,0:17:06.69,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:17:06.69,0:17:09.19,Default,,0,0,0,,Қызметші Арунусты шақыр!
Dialogue: 0,0:17:09.19,0:17:11.69,Default,,0,0,0,,Ролдың шеберлік дискісі плюс 1.
Dialogue: 0,0:17:11.69,0:17:13.69,Default,,0,0,0,,Дінге шабуыл!
Dialogue: 0,0:17:13.69,0:17:15.70,Default,,0,0,0,,Соелмен бірге қуат плюс 5000!
Dialogue: 0,0:17:15.70,0:17:17.70,Default,,0,0,0,,Көбірек сақ болыңыз!
Dialogue: 0,0:17:17.70,0:17:19.70,Default,,0,0,0,,Роликпен шабуыл!
Dialogue: 0,0:17:19.70,0:17:22.20,Default,,0,0,0,,Габуэлийді шеберлікпен шақырыңыз!
Dialogue: 0,0:17:22.20,0:17:24.67,Default,,0,0,0,,Бір бөлік үшін болса да, алға!
Dialogue: 0,0:17:24.67,0:17:27.71,Default,,0,0,0,,Блиц ордені Аспан жарығы!
Dialogue: 0,0:17:27.71,0:17:29.74,Default,,0,0,0,,Бұл да?
Dialogue: 0,0:17:29.74,0:17:32.21,Default,,0,0,0,,Палубаның жоғарғы картасын күзетшіге қойыңыз.
Dialogue: 0,0:17:32.21,0:17:34.18,Default,,0,0,0,,Көбірек сақ болыңыз!
Dialogue: 0,0:17:34.18,0:17:36.18,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:17:36.18,0:17:38.69,Default,,0,0,0,,Менің тілегім➡
Dialogue: 0,0:17:38.69,0:17:40.69,Default,,0,0,0,,Оны жүзеге асыру үшін!
Dialogue: 0,0:17:40.69,0:17:42.69,Default,,0,0,0,,Мұның аяқталуына жол бермеңіз!
Dialogue: 0,0:17:42.69,0:17:44.69,Default,,0,0,0,,Менің тілегім➡
Dialogue: 0,0:17:44.69,0:17:46.69,Default,,0,0,0,,Оны жүзеге асыру үшін!
Dialogue: 0,0:17:49.20,0:17:52.20,Default,,0,0,0,,Draw Trigger алыңыз!
Dialogue: 0,0:17:52.20,0:17:54.17,Default,,0,0,0,,Ролдың қуаты плюс 10 000!
Dialogue: 0,0:17:55.70,0:17:57.67,Default,,0,0,0,,Әлі емес...!
Dialogue: 0,0:17:59.17,0:18:01.18,Default,,0,0,0,,Оны алыңыз! ➡
Dialogue: 0,0:18:01.18,0:18:03.21,Default,,0,0,0,,Емдеу триггері! ➡
Dialogue: 0,0:18:03.21,0:18:05.18,Default,,0,0,0,,Ролдың күші +10 000 артық!
Dialogue: 0,0:18:06.71,0:18:10.18,Default,,0,0,0,,Бұл туралы не деуге болады!
Dialogue: 0,0:18:21.70,0:18:24.20,Default,,0,0,0,,Кішкене болса да жарық➡
Dialogue: 0,0:18:24.20,0:18:26.20,Default,,0,0,0,,Тек қолын созғандарға ➡
Dialogue: 0,0:18:26.20,0:18:28.70,Default,,0,0,0,,Ғажайыптар түседі.
Dialogue: 0,0:18:28.70,0:18:30.67,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:30.67,0:18:32.67,Default,,0,0,0,,Хаа….
Dialogue: 0,0:18:32.67,0:18:34.68,Default,,0,0,0,,Зақым➡
Dialogue: 0,0:18:34.68,0:18:36.68,Default,,0,0,0,,Тексеріңіз!
Dialogue: 0,0:18:45.19,0:18:47.19,Default,,0,0,0,,Керемет екінші рет келеді!
Dialogue: 0,0:18:49.22,0:18:53.69,Default,,0,0,0,,Триггер 6-зақымда пайда болған кезде➡
Dialogue: 0,0:18:53.69,0:18:55.66,Default,,0,0,0,,Зақымдануды қалпына келтіріңіз!
Dialogue: 0,0:18:57.20,0:18:59.20,Default,,0,0,0,,Қолыңызды созатын жер➡
Dialogue: 0,0:18:59.20,0:19:01.20,Default,,0,0,0,,Ғажайып….
Dialogue: 0,0:19:01.20,0:19:03.67,Default,,0,0,0,,Әлі біткен жоқ! Сосын...! ➡
Dialogue: 0,0:19:03.67,0:19:06.67,Default,,0,0,0,,Габриэлиуспен шабуыл!
Dialogue: 0,0:19:06.67,0:19:09.18,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:19:10.68,0:19:13.68,Default,,0,0,0,,Көлікті тексеру!
Dialogue: 0,0:19:13.68,0:19:15.72,Default,,0,0,0,,Тағы бір триггер ойыны.
Dialogue: 0,0:19:15.72,0:19:18.19,Default,,0,0,0,,Мұның бәрі сіздің тағдырыңызды шешетін тексерулер туралы.
Dialogue: 0,0:19:18.19,0:19:20.19,Default,,0,0,0,,Осылай! Қанша жүрегің болса да➡
Dialogue: 0,0:19:20.19,0:19:22.19,Default,,0,0,0,,Мотанай!
Dialogue: 0,0:19:23.76,0:19:25.69,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:19:25.69,0:19:27.70,Default,,0,0,0,,Күзет сәтті өтті!
Dialogue: 0,0:19:27.70,0:19:29.70,Default,,0,0,0,,Габриэлиуспен шабуыл!
Dialogue: 0,0:19:29.70,0:19:32.17,Default,,0,0,0,,Толығымен... Күзетші!
Dialogue: 0,0:19:33.77,0:19:35.70,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:19:35.70,0:19:37.71,Default,,0,0,0,,Мен де ұстадым.
Dialogue: 0,0:19:37.71,0:19:40.67,Default,,0,0,0,,Мен де...бір керемет нәтиже бермесе ➡
Dialogue: 0,0:19:40.67,0:19:42.68,Default,,0,0,0,,Мен саған екінші кереметті қалай алуға болатынын көрсетемін!
Dialogue: 0,0:19:44.18,0:19:46.18,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:19:47.25,0:19:49.22,Default,,0,0,0,,⸨Резаэль….
Dialogue: 0,0:19:49.22,0:19:52.25,Default,,0,0,0,,Мен мұны Витаның шеберлігі үшін пайдалануым керек пе?➡
Dialogue: 0,0:19:52.25,0:19:54.26,Default,,0,0,0,,Немесе... ⸩
Dialogue: 0,0:19:59.73,0:20:02.70,Default,,0,0,0,,Құтқару қанаттары көктен осында!
Dialogue: 0,0:20:02.70,0:20:05.70,Default,,0,0,0,,Ғажайып тағдыр Резаэльге➡
Dialogue: 0,0:20:05.70,0:20:07.67,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:20:09.70,0:20:11.71,Default,,0,0,0,,Резаэль...!
Dialogue: 0,0:20:11.71,0:20:13.67,Default,,0,0,0,,Шеберлікпен 1 ​​картаны сал.
Dialogue: 0,0:20:15.21,0:20:17.68,Default,,0,0,0,,Pro Robi және Imprevious телефондарына қоңырау шалыңыз!
Dialogue: 0,0:20:17.68,0:20:20.68,Default,,0,0,0,,Ку...! Импервиуспен шабуыл жасаңыз!
Dialogue: 0,0:20:20.68,0:20:23.18,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:20:23.18,0:20:25.69,Default,,0,0,0,,Жарайды, маңызды триггер!
Dialogue: 0,0:20:25.69,0:20:28.19,Default,,0,0,0,,Ролдың қуаты плюс 10 000!
Dialogue: 0,0:20:28.19,0:20:31.19,Default,,0,0,0,,Шынымен! Әлі де осы жерден!
Dialogue: 0,0:20:31.19,0:20:33.69,Default,,0,0,0,,Габриэлиуспен шабуыл!
Dialogue: 0,0:20:33.69,0:20:35.70,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:20:35.70,0:20:37.70,Default,,0,0,0,,Менің ауыспалы эго➡
Dialogue: 0,0:20:37.70,0:20:39.70,Default,,0,0,0,,Тағдырымды өзгертті➡
Dialogue: 0,0:20:39.70,0:20:41.70,Default,,0,0,0,,Бастапқы карта.
Dialogue: 0,0:20:41.70,0:20:44.21,Default,,0,0,0,,Қанаттарыңызды соғыңыз...
Dialogue: 0,0:20:44.21,0:20:46.67,Default,,0,0,0,,Ғажайып тағдыр!
Dialogue: 0,0:20:46.67,0:20:49.68,Default,,0,0,0,,Резаэльмен шабуылдаңыз!
Dialogue: 0,0:20:49.68,0:20:51.68,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:20:51.68,0:20:54.18,Default,,0,0,0,,Егер жолыңызға бірдеңе кедергі болса, итеріңіз!
Dialogue: 0,0:20:54.18,0:20:57.18,Default,,0,0,0,,Қарсылас кім болса да, берілме!
Dialogue: 0,0:20:57.18,0:20:59.69,Default,,0,0,0,,Армандарыңызды қолдарыңызда ұстаңыз!
Dialogue: 0,0:20:59.69,0:21:01.69,Default,,0,0,0,,Өзіңіздің идеалды болыңыз!
Dialogue: 0,0:21:01.69,0:21:03.69,Default,,0,0,0,,Мен жеңіліске шыдай алмаймын!
Dialogue: 0,0:21:03.69,0:21:05.69,Default,,0,0,0,,Мен жеңіліске жол бере алмаймын!
Dialogue: 0,0:21:05.69,0:21:07.70,Default,,0,0,0,,Мен...!
Dialogue: 0,0:21:07.70,0:21:09.70,Default,,0,0,0,,Мен...!
Dialogue: 0,0:21:09.70,0:21:11.70,Default,,0,0,0,,Сөзсіз жеңіңіз! ➡
Dialogue: 0,0:21:11.70,0:21:16.17,Default,,0,0,0,,Шулы!
Dialogue: 0,0:21:18.17,0:21:20.67,Default,,0,0,0,,Оны алыңыз! ➡
Dialogue: 0,0:21:20.67,0:21:23.18,Default,,0,0,0,,Емдеу...Триггер!
Dialogue: 0,0:21:25.18,0:21:27.18,Default,,0,0,0,,Кя...!
Dialogue: 0,0:21:27.18,0:21:30.18,Default,,0,0,0,,Жеткізу!
Dialogue: 0,0:21:35.19,0:21:37.16,Default,,0,0,0,,Керемет...
Dialogue: 0,0:21:44.70,0:21:50.20,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:21:50.20,0:21:53.17,Default,,0,0,0,,Кері айналдырудан кейін кері айналдыру! ➡
Dialogue: 0,0:21:53.17,0:21:55.71,Default,,0,0,0,,Еріктердің керемет қақтығысы➡
Dialogue: 0,0:21:55.71,0:21:57.71,Default,,0,0,0,,Кім жеңді➡
Dialogue: 0,0:21:57.71,0:22:01.68,Default,,0,0,0,,Құтқарылу қанаттары Акина Мейдо~!
Dialogue: 0,0:22:01.68,0:22:04.72,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:22:04.72,0:22:07.19,Default,,0,0,0,,Екеуің де жақсы орындадыңдар.
Dialogue: 0,0:22:07.19,0:22:09.16,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз.
Dialogue: 0,0:22:09.16,0:22:11.69,Default,,0,0,0,,Акина...құттықтаймын.
Dialogue: 0,0:22:11.69,0:22:14.66,Default,,0,0,0,,Екеуі де керемет болды!
Dialogue: 0,0:22:16.20,0:22:18.20,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:22:18.20,0:22:20.20,Default,,0,0,0,,Шайқас ➡
Dialogue: 0,0:22:20.20,0:22:22.20,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:22:24.21,0:22:26.17,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:22:31.18,0:22:33.68,Default,,0,0,0,,Жеңісіңіз құтты болсын... Акина!
Dialogue: 0,0:22:33.68,0:22:36.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:38.22,0:22:40.69,Default,,0,0,0,,3-ші люкс….
Dialogue: 0,0:22:42.19,0:22:45.69,Default,,0,0,0,,Күшті ұстағанға➡
Dialogue: 0,0:22:45.69,0:22:48.16,Default,,0,0,0,,Үлкен ду қол шапалақтау!
Dialogue: 0,0:22:56.67,0:22:59.67,Default,,0,0,0,,Сіз мұны істедіңіз! Акикун.
Dialogue: 0,0:22:59.67,0:23:01.68,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:23:01.68,0:23:04.21,Default,,0,0,0,,Нао-сенпай...
Dialogue: 0,0:23:04.21,0:23:08.18,Default,,0,0,0,,Бұл жеңіс кәсіби маман болуға үлкен қадам болары сөзсіз➡
Dialogue: 0,0:23:08.18,0:23:11.19,Default,,0,0,0,,Бірақ бұл тек бастамасы ғана.
Dialogue: 0,0:23:11.19,0:23:13.19,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:23:13.19,0:23:16.19,Default,,0,0,0,,Мен қол созамын!
Dialogue: 0,0:23:16.19,0:23:18.73,Default,,0,0,0,,Ум! Мен күтемін➡
Dialogue: 0,0:23:18.73,0:23:21.20,Default,,0,0,0,,Болашақ қарсылас! жоғары!
Dialogue: 0,0:23:22.76,0:23:25.77,Default,,0,0,0,,⸨Акина...Авангард Жаңадан бастасаңыз да➡
Dialogue: 0,0:23:25.77,0:23:27.70,Default,,0,0,0,,Мен бақыттымын➡
Dialogue: 0,0:23:27.70,0:23:30.74,Default,,0,0,0,,Ол сондай керемет адамға айналды...
Dialogue: 0,0:23:30.74,0:23:33.24,Default,,0,0,0,,Менің де жеңілуге шамасы жоқ. ⸩
Dialogue: 0,0:23:38.18,0:23:40.18,Default,,0,0,0,,О, жарайды➡
Dialogue: 0,0:23:40.18,0:23:42.18,Default,,0,0,0,,Уақыты келгенде➡
Dialogue: 0,0:23:42.18,0:23:44.18,Default,,0,0,0,,Мен бар күшімді саламын.
Dialogue: 0,0:23:57.20,0:23:59.20,Default,,0,0,0,,Идеал әлем үшін➡
Dialogue: 0,0:23:59.20,0:24:01.20,Default,,0,0,0,,Осыны шешейік.
