Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.30,0:00:10.27,Default,,0,0,0,,(Екінші қолдың дыбысы)
Dialogue: 0,0:00:11.37,0:00:14.81,Default,,0,0,0,,((Неліктен Deluxe-де ұтқыңыз келеді?
Dialogue: 0,0:00:14.81,0:00:16.78,Default,,0,0,0,,Кәсіби маман болу➡
Dialogue: 0,0:00:16.78,0:00:18.78,Default,,0,0,0,,Өйткені мен өз күшіммен өмір сүргім келеді.
Dialogue: 0,0:00:18.78,0:00:21.35,Default,,0,0,0,,Хо~ Түсіндім!
Dialogue: 0,0:00:21.35,0:00:24.35,Default,,0,0,0,,Бірақ сіз кәсіпқой болмасаңыз да мұны істей алмайсыз ба? ))
Dialogue: 0,0:00:27.29,0:00:30.29,Default,,0,0,0,,Сәлем, Габриэлиус.
Dialogue: 0,0:00:30.29,0:00:32.83,Default,,0,0,0,,Сіз тыңдайсыз ба?
Dialogue: 0,0:00:32.83,0:00:35.83,Default,,0,0,0,,Адамдар менімен жиі сөйлескені мені мазалайды➡
Dialogue: 0,0:00:35.83,0:00:39.30,Default,,0,0,0,,Мен саған айттым ғой, сенің өміріңе араласатын ойым жоқ...
Dialogue: 0,0:00:52.28,0:00:54.78,Default,,0,0,0,,Менің ойыма ештеңе келмейді...
Dialogue: 0,0:00:54.78,0:00:57.32,Default,,0,0,0,,Сонымен, егер сіз Vanguard кәсіпқойы болсаңыз➡
Dialogue: 0,0:00:57.32,0:00:59.82,Default,,0,0,0,,Мен соған жетуді ұйғардым.
Dialogue: 0,0:00:59.82,0:01:02.79,Default,,0,0,0,,Менің жасымды ескерсек, бұл жыл менің соңғы мүмкіндігім.
Dialogue: 0,0:01:02.79,0:01:04.79,Default,,0,0,0,,Бірақ басқа да нұсқалар бар➡
Dialogue: 0,0:01:04.79,0:01:06.80,Default,,0,0,0,,Мүмкін мен оны көрмей жүрген шығармын➡
Dialogue: 0,0:01:06.80,0:01:09.80,Default,,0,0,0,,Мен бұл туралы тіпті ойладым. Хмм….
Dialogue: 0,0:01:09.80,0:01:12.80,Default,,0,0,0,,Мен асығыспын деп ойлайсың ба?
Dialogue: 0,0:01:12.80,0:01:14.80,Default,,0,0,0,,Ал, адамның сезім мүшелері➡
Dialogue: 0,0:01:14.80,0:01:16.81,Default,,0,0,0,,Мен түсінбейтін нәрселер көп.
Dialogue: 0,0:01:16.81,0:01:18.81,Default,,0,0,0,,Дегенмен, мен бір ұсыныс айта аламын.
Dialogue: 0,0:01:18.81,0:01:20.84,Default,,0,0,0,,Не?
Dialogue: 0,0:01:20.84,0:01:23.78,Default,,0,0,0,,Өзіңізден сұрасаңыз қалай болады?
Dialogue: 0,0:01:23.78,0:01:26.78,Default,,0,0,0,,Е! Бұл тек сіздің қолыңыздан келетін қулық.
Dialogue: 0,0:01:29.35,0:01:34.29,Default,,0,0,0,,📱
Dialogue: 0,0:01:34.29,0:01:36.29,Default,,0,0,0,,Ым?
Dialogue: 0,0:03:08.78,0:03:10.79,Default,,0,0,0,,Хмм! ➡
Dialogue: 0,0:03:10.79,0:03:14.26,Default,,0,0,0,,Бүгін де тамаша күн!
Dialogue: 0,0:03:15.79,0:03:18.29,Default,,0,0,0,,Иә. Жаңа~! ➡
Dialogue: 0,0:03:18.29,0:03:21.30,Default,,0,0,0,,Барлығына! Мен бүгін сені сүйем.
Dialogue: 0,0:03:21.30,0:03:23.30,Default,,0,0,0,,Мен де.
Dialogue: 0,0:03:23.30,0:03:25.30,Default,,0,0,0,,Мен де, Миёко-сан.
Dialogue: 0,0:03:25.30,0:03:27.30,Default,,0,0,0,,Үшеуіне де рахмет!
Dialogue: 0,0:03:27.30,0:03:30.81,Default,,0,0,0,,Мақсат – жеңіске жету! Ол сенімді.
Dialogue: 0,0:03:30.81,0:03:32.77,Default,,0,0,0,,Осынша жанып тұрған нәрсе ➡
Dialogue: 0,0:03:32.77,0:03:34.78,Default,,0,0,0,,Бұл ұзақ сапардың ең жақсы бөлігі болуы мүмкін.
Dialogue: 0,0:03:34.78,0:03:37.31,Default,,0,0,0,,Айтпақшы, саяхатыңыз қалай өтті?
Dialogue: 0,0:03:37.31,0:03:40.28,Default,,0,0,0,,Ұрыс арқылы көп адамдармен дос болдым! ➡
Dialogue: 0,0:03:40.28,0:03:42.28,Default,,0,0,0,,Менің арманым – дүние жүзіндегі адамдармен бірге болу➡
Dialogue: 0,0:03:42.28,0:03:44.29,Default,,0,0,0,,Бұл Vanguard-пен байланысу туралы!
Dialogue: 0,0:03:44.29,0:03:46.32,Default,,0,0,0,,Сіз шынымен де тайсалмайсыз.
Dialogue: 0,0:03:46.32,0:03:48.79,Default,,0,0,0,,Мен оған барымды беруге шешім қабылдадым!
Dialogue: 0,0:03:48.79,0:03:51.29,Default,,0,0,0,,Ху...Миёко сияқты.
Dialogue: 0,0:03:51.29,0:03:53.30,Default,,0,0,0,,Әлем шынымен де үлкен! ➡
Dialogue: 0,0:03:53.30,0:03:55.30,Default,,0,0,0,,Сіз ойлағаннан да көп адамдар бар➡
Dialogue: 0,0:03:55.30,0:03:58.33,Default,,0,0,0,,Өмір бар, тарих бар!
Dialogue: 0,0:03:58.33,0:04:02.34,Default,,0,0,0,,Ой мен парасаттылық әр түрлі, дегенмен➡
Dialogue: 0,0:04:02.34,0:04:05.81,Default,,0,0,0,,Сіз Vanguard ойынын ойнау арқылы осындай адамдармен дос бола аласыз! ➡
Dialogue: 0,0:04:05.81,0:04:08.28,Default,,0,0,0,,Сіз де сол нәрсеге әуестеніп кетуіңіз мүмкін! ➡
Dialogue: 0,0:04:08.28,0:04:10.78,Default,,0,0,0,,Мен ешқашан соншалықты көңілді болған емеспін!
Dialogue: 0,0:04:10.78,0:04:13.78,Default,,0,0,0,,А...Мен шынымен солай ойлаймын.
Dialogue: 0,0:04:13.78,0:04:17.32,Default,,0,0,0,,Сондықтан мен Қағаға қайтып келгенше➡
Dialogue: 0,0:04:17.32,0:04:20.29,Default,,0,0,0,,Мен Deluxe-ді тек соның бір бөлігі деп ойладым.
Dialogue: 0,0:04:20.29,0:04:23.79,Default,,0,0,0,,Маған бәрібір жеңгенім немесе жеңілгенім➡
Dialogue: 0,0:04:23.79,0:04:25.79,Default,,0,0,0,,Мен әлі кездеспеген адаммен ұрысу арқылы➡
Dialogue: 0,0:04:25.79,0:04:27.80,Default,,0,0,0,,Бұл көңілді деп үміттенемін.
Dialogue: 0,0:04:28.80,0:04:31.80,Default,,0,0,0,,Қазір басқаша ма? Ешқандай айырмашылық жоқ ➡
Dialogue: 0,0:04:31.80,0:04:34.34,Default,,0,0,0,,Blackout қолданбасындағы барлығымен қазір дос болыңыз➡
Dialogue: 0,0:04:34.34,0:04:38.31,Default,,0,0,0,,Үшеуіңді қайта көріп, осылайша қошемет көрсету➡
Dialogue: 0,0:04:38.31,0:04:41.78,Default,,0,0,0,,Мен жеңгім келетіндей сезінемін.
Dialogue: 0,0:04:45.28,0:04:48.32,Default,,0,0,0,,Хаа….
Dialogue: 0,0:04:48.32,0:04:50.29,Default,,0,0,0,,A…. Мен бүгін таңертең дайындаған бұқтырма➡
Dialogue: 0,0:04:50.29,0:04:52.29,Default,,0,0,0,,Мен әкелдім.
Dialogue: 0,0:04:52.29,0:04:54.32,Default,,0,0,0,,Әлі де жылы. Қазірдің өзінде➡
Dialogue: 0,0:04:54.32,0:04:57.33,Default,,0,0,0,,Менің ойымша, бүгінгі күні өзіңізге назар аударған дұрыс.
Dialogue: 0,0:04:57.33,0:05:00.30,Default,,0,0,0,,Бірақ сіз оны жейсіз, солай ма? жеу.
Dialogue: 0,0:05:03.80,0:05:07.30,Default,,0,0,0,,Ам... ммм! ➡
Dialogue: 0,0:05:07.30,0:05:09.30,Default,,0,0,0,,Хаа...дәмді!
Dialogue: 0,0:05:09.30,0:05:11.27,Default,,0,0,0,,Жақсы. мм.
Dialogue: 0,0:05:12.27,0:05:15.28,Default,,0,0,0,,Мен Мичиру Мавариманы жеңемін.
Dialogue: 0,0:05:15.28,0:05:19.31,Default,,0,0,0,,Мен сенемін. Сонымен➡
Dialogue: 0,0:05:19.31,0:05:22.78,Default,,0,0,0,,Алдымен жеңіп, күтіңіз!
Dialogue: 0,0:05:22.78,0:05:24.79,Default,,0,0,0,,Әрине!
Dialogue: 0,0:05:26.29,0:05:28.29,Default,,0,0,0,,Балалар! ➡
Dialogue: 0,0:05:28.29,0:05:30.79,Default,,0,0,0,,Ең мықтыны көргіңіз келе ме?
Dialogue: 0,0:05:30.79,0:05:33.80,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:33.80,0:05:35.80,Default,,0,0,0,,3-ші люкс те ұзақ болды➡
Dialogue: 0,0:05:35.80,0:05:37.80,Default,,0,0,0,,Соңында соңғы күн!
Dialogue: 0,0:05:37.80,0:05:39.80,Default,,0,0,0,,Ал бүгінге дейін аман қалғаны ➡
Dialogue: 0,0:05:39.80,0:05:41.87,Default,,0,0,0,,Мына төртеуі!
Dialogue: 0,0:05:41.87,0:05:50.28,Default,,0,0,0,,🎵～
Dialogue: 0,0:05:50.28,0:05:52.31,Default,,0,0,0,,Акина мен Эрика➡
Dialogue: 0,0:05:52.31,0:05:54.78,Default,,0,0,0,,Біз үшін қолыңнан келгеннің бәрін жасауың керек.
Dialogue: 0,0:05:54.78,0:05:57.29,Default,,0,0,0,,Әрине.
Dialogue: 0,0:05:58.32,0:06:01.79,Default,,0,0,0,,Бар күшімізбен қолдаймыз! Егер сіз осы уақытқа дейін жетсеңіз, сіз жеңдіңіз!
Dialogue: 0,0:06:01.79,0:06:04.79,Default,,0,0,0,,Әй, дауыстап айтуды маған қалдыр!
Dialogue: 0,0:06:04.79,0:06:06.80,Default,,0,0,0,,Мм? ➡
Dialogue: 0,0:06:06.80,0:06:08.80,Default,,0,0,0,,Хикари-чан, жақсысың ба?
Dialogue: 0,0:06:08.80,0:06:10.80,Default,,0,0,0,,А...жоқ, бұл ештеңе емес! ➡
Dialogue: 0,0:06:10.80,0:06:12.77,Default,,0,0,0,,Мен де сені қолдаймын!
Dialogue: 0,0:06:15.30,0:06:18.81,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіздің арманыңыз қандай кезең?
Dialogue: 0,0:06:18.81,0:06:21.28,Default,,0,0,0,,Келесі жолы мен міндетті түрде сонда тұрамын➡
Dialogue: 0,0:06:21.28,0:06:23.31,Default,,0,0,0,,Мотивация алыңыз!
Dialogue: 0,0:06:23.31,0:06:25.78,Default,,0,0,0,,Ой, бұл сіздің ниетіңіз.
Dialogue: 0,0:06:25.78,0:06:27.82,Default,,0,0,0,,Егер Кагецу жеңсе➡
Dialogue: 0,0:06:27.82,0:06:30.29,Default,,0,0,0,,Мотивациям жоғарырақ болса екен. Қарғыс атқыр...
Dialogue: 0,0:06:30.29,0:06:32.32,Default,,0,0,0,,Әзіл! ➡
Dialogue: 0,0:06:32.32,0:06:35.79,Default,,0,0,0,,Менің ойымша, Кагецу ең күшті!
Dialogue: 0,0:06:35.79,0:06:37.79,Default,,0,0,0,,Ендеше, бар күшіңізді салып, маған үйрете беріңіз➡
Dialogue: 0,0:06:37.79,0:06:40.80,Default,,0,0,0,,Сенсей! Сіз қолыңыздан келгеннің бәрін жасайсыз.
Dialogue: 0,0:06:40.80,0:06:42.80,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:06:44.93,0:06:46.90,Default,,0,0,0,,)
Dialogue: 0,0:06:49.30,0:06:51.31,Default,,0,0,0,,Сәлем. Un?
Dialogue: 0,0:06:51.31,0:06:54.78,Default,,0,0,0,,Сіз Эрика Миоджо туралы бірдеңе білесіз бе?
Dialogue: 0,0:06:54.78,0:06:57.28,Default,,0,0,0,,Мен онша егжей-тегжейлі білмеймін.
Dialogue: 0,0:06:57.28,0:06:59.28,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:00.35,0:07:02.28,Default,,0,0,0,,((Эрика Миоджо➡
Dialogue: 0,0:07:02.28,0:07:04.39,Default,,0,0,0,,Аты бөлек болса да➡
Dialogue: 0,0:07:04.39,0:07:06.32,Default,,0,0,0,,Бірақ... ))
Dialogue: 0,0:07:06.32,0:07:10.29,Default,,0,0,0,,Енді жартылай финалды бастайық! ➡
Dialogue: 0,0:07:10.29,0:07:12.29,Default,,0,0,0,,Ең алдымен, осы екеуі! ➡
Dialogue: 0,0:07:12.29,0:07:16.30,Default,,0,0,0,,Лука Мияко VS Эрика Миоджо!
Dialogue: 0,0:07:16.30,0:07:18.80,Default,,0,0,0,,Танысқаныма қуаныштымын. жоғары! ➡
Dialogue: 0,0:07:18.80,0:07:21.80,Default,,0,0,0,,Мен сені жеңемін.
Dialogue: 0,0:07:21.80,0:07:23.77,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:07:23.77,0:07:27.28,Default,,0,0,0,,Содан кейін люкс жартылай финалы➡
Dialogue: 0,0:07:27.28,0:07:31.28,Default,,0,0,0,,1-ші матч...Фай!
Dialogue: 0,0:07:35.78,0:07:37.79,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:07:37.79,0:07:40.29,Default,,0,0,0,,Райсент, жұмаққа қонақ.
Dialogue: 0,0:07:40.29,0:07:42.79,Default,,0,0,0,,Ысқырушы Бирниста.
Dialogue: 0,0:07:42.79,0:07:44.79,Default,,0,0,0,,Менің кезегім Джотильге барамын➡
Dialogue: 0,0:07:44.79,0:07:46.80,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:07:46.80,0:07:49.30,Default,,0,0,0,,Менің кезегім Адольф➡
Dialogue: 0,0:07:49.30,0:07:51.77,Default,,0,0,0,,Шабуыл. Күзетші жоқ.
Dialogue: 0,0:07:51.77,0:07:54.30,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім ➡
Dialogue: 0,0:07:54.30,0:07:56.30,Default,,0,0,0,,Ноктоланға бару.
Dialogue: 0,0:07:56.30,0:07:59.27,Default,,0,0,0,,Иотильді шеберлікпен шақырыңыз, әрі қарай жүрейік! ➡
Dialogue: 0,0:07:59.27,0:08:01.78,Default,,0,0,0,,Leavesfeather шақырыңыз.
Dialogue: 0,0:08:01.78,0:08:04.28,Default,,0,0,0,,Вильзюренге осындай шеберлікпен қоңырау шалыңыз!
Dialogue: 0,0:08:04.28,0:08:06.78,Default,,0,0,0,,Шабуыл! Күзет жоқ!
Dialogue: 0,0:08:06.78,0:08:10.79,Default,,0,0,0,,Шабуыл! күзетші!
Dialogue: 0,0:08:10.79,0:08:12.85,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:08:12.85,0:08:15.36,Default,,0,0,0,,((Егер екінші тарап шабуылдаса, кері шабуыл жасаңыз➡
Dialogue: 0,0:08:15.36,0:08:18.79,Default,,0,0,0,,Оны ерте кезеңнен бастап бөлшектеңіз және оны еркін орындауға мүмкіндік бермеңіз. ))
Dialogue: 0,0:08:18.79,0:08:22.30,Default,,0,0,0,,Менің кезегім Эльгенияға мін!
Dialogue: 0,0:08:22.30,0:08:24.80,Default,,0,0,0,,Парнацетра Селивант➡
Dialogue: 0,0:08:24.80,0:08:26.80,Default,,0,0,0,,Almove-ге қоңырау шалыңыз!
Dialogue: 0,0:08:26.80,0:08:29.30,Default,,0,0,0,,Шабуыл! Кесу!
Dialogue: 0,0:08:29.30,0:08:32.31,Default,,0,0,0,,Шабуыл! Күзет жоқ!
Dialogue: 0,0:08:32.31,0:08:35.28,Default,,0,0,0,,Шабуыл! Мұнда да күзетші жоқ!
Dialogue: 0,0:08:35.28,0:08:37.78,Default,,0,0,0,,Бұрылыстың соңы. Ұнады~➡
Dialogue: 0,0:08:37.78,0:08:39.78,Default,,0,0,0,,Түзу және өткір ➡
Dialogue: 0,0:08:39.78,0:08:41.78,Default,,0,0,0,,Бірақ ол мейірімділікке толы.
Dialogue: 0,0:08:41.78,0:08:44.29,Default,,0,0,0,,Ал сенің ішіңде бірдеңе бар➡
Dialogue: 0,0:08:44.29,0:08:47.79,Default,,0,0,0,,Мен де сенен басқа нәрселерді сезінемін. Ха!
Dialogue: 0,0:08:47.79,0:08:50.26,Default,,0,0,0,,Мен бір уақытта екі адаммен айналысатын сияқтымын➡
Dialogue: 0,0:08:50.26,0:08:52.29,Default,,0,0,0,,Бұл жақсы келісім болуы мүмкін!
Dialogue: 0,0:08:52.29,0:08:54.30,Default,,0,0,0,,Сенің де сезінгеніңді қалаймын➡
Dialogue: 0,0:08:54.30,0:08:56.30,Default,,0,0,0,,Мен туралы.
Dialogue: 0,0:08:56.30,0:08:58.80,Default,,0,0,0,,Көбірек көңіл көтерейік! ➡
Dialogue: 0,0:08:58.80,0:09:01.34,Default,,0,0,0,,Біздің авангардымыз!
Dialogue: 0,0:09:01.34,0:09:04.27,Default,,0,0,0,,Менің кезегім Түнді бояйтын әдемі гүл! ➡
Dialogue: 0,0:09:04.27,0:09:07.28,Default,,0,0,0,,Дүние жүзінде еркін жел! ➡
Dialogue: 0,0:09:07.28,0:09:09.28,Default,,0,0,0,,Жүр!
Dialogue: 0,0:09:10.28,0:09:12.28,Default,,0,0,0,,Жұмаққа апарушы➡
Dialogue: 0,0:09:12.28,0:09:14.28,Default,,0,0,0,,Нанакрил!
Dialogue: 0,0:09:16.28,0:09:18.79,Default,,0,0,0,,Ноктранға шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:09:18.79,0:09:21.29,Default,,0,0,0,,Фралусты да шеберлікпен шақырыңыз!
Dialogue: 0,0:09:21.29,0:09:24.29,Default,,0,0,0,,Қараңғылықтың арғы жағында➡
Dialogue: 0,0:09:24.29,0:09:26.29,Default,,0,0,0,,Жоғалған балалар жиналғанда➡
Dialogue: 0,0:09:26.29,0:09:28.80,Default,,0,0,0,,Гүл жұмағы пайда болады.
Dialogue: 0,0:09:28.80,0:09:31.27,Default,,0,0,0,,Бұл менің әлемім!
Dialogue: 0,0:09:34.30,0:09:36.27,Default,,0,0,0,,Кух….
Dialogue: 0,0:09:37.27,0:09:39.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:41.78,0:09:44.28,Default,,0,0,0,,Менің әлемім➡
Dialogue: 0,0:09:44.28,0:09:46.88,Default,,0,0,0,,Ол адасатын баққа айналады!
Dialogue: 0,0:09:46.88,0:09:49.28,Default,,0,0,0,,Керемет….
Dialogue: 0,0:09:49.28,0:09:52.29,Default,,0,0,0,,Келіңіздер! Нанакрил дағдылары➡
Dialogue: 0,0:09:52.29,0:09:55.29,Default,,0,0,0,,Жұмаққа қонаққа келген Белноаға қоңырау шалыңыз!
Dialogue: 0,0:09:55.29,0:09:57.29,Default,,0,0,0,,Уилл Ленмен шабуыл!
Dialogue: 0,0:09:57.29,0:10:00.80,Default,,0,0,0,,Белнордың күші +5000 Фрарус шеберлігімен!
Dialogue: 0,0:10:00.80,0:10:02.80,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:10:02.80,0:10:06.30,Default,,0,0,0,,Белноамен шабуыл! Күзет жоқ!
Dialogue: 0,0:10:06.30,0:10:08.30,Default,,0,0,0,,Нанакрилмен шабуыл! ➡
Dialogue: 0,0:10:08.30,0:10:10.77,Default,,0,0,0,,Бельнуаға шебер тұр!
Dialogue: 0,0:10:10.77,0:10:13.78,Default,,0,0,0,,Күзетші жоқ! Бірінші тексеру.
Dialogue: 0,0:10:14.78,0:10:16.78,Default,,0,0,0,,Екінші тексеру.
Dialogue: 0,0:10:17.81,0:10:19.78,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:10:19.78,0:10:21.82,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:10:21.82,0:10:23.79,Default,,0,0,0,,Белнордың қуаты плюс 10000➡
Dialogue: 0,0:10:23.79,0:10:25.79,Default,,0,0,0,,Нанакрилдің сыни плюс 1!
Dialogue: 0,0:10:27.79,0:10:31.29,Default,,0,0,0,,Tsk…. Мен оны бұрышқа қойдым.
Dialogue: 0,0:10:31.29,0:10:33.29,Default,,0,0,0,,Белнормен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:10:33.29,0:10:35.30,Default,,0,0,0,,Қабілетпен тұрсаң➡
Dialogue: 0,0:10:35.30,0:10:37.30,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:10:37.30,0:10:39.30,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:10:39.30,0:10:42.30,Default,,0,0,0,,Ұрыс соңында Белнуар Жанға барады.
Dialogue: 0,0:10:42.30,0:10:44.27,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:10:45.77,0:10:49.28,Default,,0,0,0,,Қалай... маған деген сезімде болдыңыз ба?
Dialogue: 0,0:10:49.28,0:10:52.78,Default,,0,0,0,,Сәлем... өте әдемі жекпе-жек.
Dialogue: 0,0:10:52.78,0:10:54.82,Default,,0,0,0,,Хехе...Рахмет.
Dialogue: 0,0:10:54.82,0:10:56.82,Default,,0,0,0,,Мен де осында барамын.
Dialogue: 0,0:10:56.82,0:11:00.29,Default,,0,0,0,,Менің күресім – тағдырды төңкеру➡
Dialogue: 0,0:11:00.29,0:11:02.29,Default,,0,0,0,,Анықтаудың өзі!
Dialogue: 0,0:11:02.29,0:11:04.79,Default,,0,0,0,,Габриэлиус... кеттік!
Dialogue: 0,0:11:04.79,0:11:07.30,Default,,0,0,0,,Ах! Қарғыс атқыр...
Dialogue: 0,0:11:07.30,0:11:10.80,Default,,0,0,0,,Тағдыр қанаттары Болашақтан Мұнда!
Dialogue: 0,0:11:10.80,0:11:12.80,Default,,0,0,0,,Қасиетті уақыттың тағдыры➡
Dialogue: 0,0:11:12.80,0:11:14.80,Default,,0,0,0,,Драконисті айналдыру➡
Dialogue: 0,0:11:14.80,0:11:16.87,Default,,0,0,0,,Жүр!
Dialogue: 0,0:11:16.87,0:11:25.35,Default,,0,0,0,,🎵～
Dialogue: 0,0:11:27.75,0:11:29.75,Default,,0,0,0,,Парнасетра дағдылары➡
Dialogue: 0,0:11:29.75,0:11:32.29,Default,,0,0,0,,Өзіңді байлап, 1 картаны сал.
Dialogue: 0,0:11:32.29,0:11:34.29,Default,,0,0,0,,Дінге қоңырау шалыңыз➡
Dialogue: 0,0:11:34.29,0:11:38.26,Default,,0,0,0,,Драконисті қолыңызға алу үшін осы дағдыны пайдаланыңыз.
Dialogue: 0,0:11:38.26,0:11:40.76,Default,,0,0,0,,Қызметшіге Almove➡ қоңырау шалыңыз
Dialogue: 0,0:11:40.76,0:11:42.76,Default,,0,0,0,,Reel шеберлігі іске қосылды!
Dialogue: 0,0:11:42.76,0:11:44.90,Default,,0,0,0,,Жүргізу плюс 1!
Dialogue: 0,0:11:44.90,0:11:46.87,Default,,0,0,0,,)
Dialogue: 0,0:11:47.77,0:11:49.77,Default,,0,0,0,,Осы жерден өтіңіз! ➡
Dialogue: 0,0:11:49.77,0:11:52.81,Default,,0,0,0,,Дінге шабуыл! күзетші!
Dialogue: 0,0:11:52.81,0:11:56.78,Default,,0,0,0,,Өткізу дағдысы Алдыңғы қатардағы артқы қорғаныс күші +5000! ➡
Dialogue: 0,0:11:56.78,0:11:58.78,Default,,0,0,0,,Дракониспен шабуыл!
Dialogue: 0,0:11:58.78,0:12:00.75,Default,,0,0,0,,Дағды іске қосылды! ➡
Dialogue: 0,0:12:00.75,0:12:02.75,Default,,0,0,0,,Дінге қоңырау шалыңыз➡
Dialogue: 0,0:12:02.75,0:12:05.25,Default,,0,0,0,,Reel-Amorta-ны қолыңызға алу үшін осы дағдыны пайдаланыңыз!
Dialogue: 0,0:12:05.25,0:12:07.26,Default,,0,0,0,,...
Dialogue: 0,0:12:08.26,0:12:10.33,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:12:10.33,0:12:13.29,Default,,0,0,0,,Триггерді тартыңыз! Қызметшінің күші плюс 10 000!
Dialogue: 0,0:12:14.76,0:12:17.77,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:12:17.77,0:12:19.77,Default,,0,0,0,,Үшінші тексеру….
Dialogue: 0,0:12:19.77,0:12:22.27,Default,,0,0,0,,Жарайды, күзет сәтті!
Dialogue: 0,0:12:22.27,0:12:24.27,Default,,0,0,0,,Әлі де осы жерден! Ах...
Dialogue: 0,0:12:24.27,0:12:26.27,Default,,0,0,0,,Тағдыр: Сізге бағыт беретін уақыт ағыны! ➡
Dialogue: 0,0:12:26.27,0:12:28.78,Default,,0,0,0,,Мәні өткенге секіру! ➡
Dialogue: 0,0:12:28.78,0:12:30.78,Default,,0,0,0,,Уақыт, артқа бұрыл! ➡
Dialogue: 0,0:12:30.78,0:12:33.31,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:12:33.31,0:12:36.25,Default,,0,0,0,,Ұрыс соңында тамшы роликті➡ мініңіз
Dialogue: 0,0:12:36.25,0:12:38.29,Default,,0,0,0,,1-ге дейін жүріңіз.
Dialogue: 0,0:12:38.29,0:12:41.76,Default,,0,0,0,,Қызметшімен шабуыл! Күзет жоқ!
Dialogue: 0,0:12:41.76,0:12:43.76,Default,,0,0,0,,Тағы да!
Dialogue: 0,0:12:43.76,0:12:45.76,Default,,0,0,0,,Роликпен шабуыл!
Dialogue: 0,0:12:45.76,0:12:47.76,Default,,0,0,0,,Қызметкерді шеберлікпен байлау➡
Dialogue: 0,0:12:47.76,0:12:50.26,Default,,0,0,0,,Қасиетті Айдаһар Габуэлийді шақыр!
Dialogue: 0,0:12:50.26,0:12:52.77,Default,,0,0,0,,Қызметшіге байланысты дағдылар➡
Dialogue: 0,0:12:52.77,0:12:54.74,Default,,0,0,0,,Өзіңізге қоңырау шалыңыз!
Dialogue: 0,0:12:55.77,0:12:58.74,Default,,0,0,0,,Ха~!
Dialogue: 0,0:13:00.27,0:13:02.28,Default,,0,0,0,,Әрине! ➡
Dialogue: 0,0:13:02.28,0:13:04.78,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:13:04.78,0:13:07.85,Default,,0,0,0,,Драйверді тексеру…Критикалық триггер!
Dialogue: 0,0:13:07.85,0:13:09.75,Default,,0,0,0,,Габуэлиус қуаты плюс 10000➡
Dialogue: 0,0:13:09.75,0:13:11.75,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:13:11.75,0:13:14.76,Default,,0,0,0,,Авангардқа Габриэлиуспен бірге шабуыл жасаңыз!
Dialogue: 0,0:13:14.76,0:13:17.76,Default,,0,0,0,,Дағдыларды пайдалана отырып, көлікті тексеруді орындаңыз!
Dialogue: 0,0:13:17.76,0:13:19.76,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:13:19.76,0:13:21.76,Default,,0,0,0,,Тағы бір маңызды карта алыңыз!
Dialogue: 0,0:13:21.76,0:13:23.77,Default,,0,0,0,,Бұл жақсы...! ➡
Dialogue: 0,0:13:23.77,0:13:26.27,Default,,0,0,0,,Бірақ мұндай бәсекелестік үлкен мәселе➡
Dialogue: 0,0:13:26.27,0:13:29.24,Default,,0,0,0,,Мен жеңілмеймін, солай ма?
Dialogue: 0,0:13:31.27,0:13:33.24,Default,,0,0,0,,Көлікті тексеру!
Dialogue: 0,0:13:35.78,0:13:37.75,Default,,0,0,0,,Кух….
Dialogue: 0,0:13:38.78,0:13:40.75,Default,,0,0,0,,Триггер жоқ….
Dialogue: 0,0:13:41.75,0:13:43.75,Default,,0,0,0,,Дінге шабуыл!
Dialogue: 0,0:13:43.75,0:13:45.75,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:13:45.75,0:13:49.29,Default,,0,0,0,,Байланыс қызметшісі шеберлікпен шақырылады➡
Dialogue: 0,0:13:49.29,0:13:51.26,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:13:52.29,0:13:55.80,Default,,0,0,0,,Әй, қандай ұят! Мен оны жеткілікті түрде қысқарттым, бірақ...
Dialogue: 0,0:13:56.76,0:13:59.30,Default,,0,0,0,,Миёко-сан, сен жақсы қабылдадың.
Dialogue: 0,0:13:59.30,0:14:02.77,Default,,0,0,0,,Ұрыс кезінде итеруді және тартуды интуитивті түрде реттеуге болады➡
Dialogue: 0,0:14:02.77,0:14:04.74,Default,,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:14:06.31,0:14:09.78,Default,,0,0,0,,Жеңіске деген құштарлықты анық сезе аласыз➡
Dialogue: 0,0:14:09.78,0:14:13.28,Default,,0,0,0,,Сіз кәсіпқой болуды мақсат етесіз бе? жоғары.
Dialogue: 0,0:14:13.28,0:14:15.75,Default,,0,0,0,,Сүйікті ісімен айналысып ақша табу керемет➡
Dialogue: 0,0:14:15.75,0:14:17.75,Default,,0,0,0,,Мүмкін мұның бәрі жақсы емес шығар?
Dialogue: 0,0:14:17.75,0:14:19.75,Default,,0,0,0,,Жасағым келеді➡
Dialogue: 0,0:14:19.75,0:14:22.26,Default,,0,0,0,,Егер мен бірдеңе жасамасам, бәрі өзгереді.
Dialogue: 0,0:14:22.26,0:14:24.76,Default,,0,0,0,,Қалай өмір сүру мен өзіңе ұнайтын нәрсенің айырмашылығы➡
Dialogue: 0,0:14:24.76,0:14:26.76,Default,,0,0,0,,Махаббат сезімін бағалаңыз➡
Dialogue: 0,0:14:26.76,0:14:28.76,Default,,0,0,0,,Құралдар туралы да түсінік бар.
Dialogue: 0,0:14:29.83,0:14:32.77,Default,,0,0,0,,((Авангард сіздің күнделікті өміріңізге түс қосады➡
Dialogue: 0,0:14:32.77,0:14:35.77,Default,,0,0,0,,Мен үшін маңызды нәрсе.
Dialogue: 0,0:14:36.84,0:14:39.81,Default,,0,0,0,,Сондықтан мен кәсіби маман болуды мақсат етпеймін. ))
Dialogue: 0,0:14:41.78,0:14:44.28,Default,,0,0,0,,Мен мұны да түсіндім деп ойлаймын.
Dialogue: 0,0:14:44.28,0:14:46.31,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:46.31,0:14:50.25,Default,,0,0,0,,Авангардпен қалай әрекет етесің, Лука?
Dialogue: 0,0:14:50.25,0:14:52.25,Default,,0,0,0,,Мен~➡
Dialogue: 0,0:14:52.25,0:14:54.76,Default,,0,0,0,,Маған Vanguard ойынын еркін ойнаған ұнайды.
Dialogue: 0,0:14:54.76,0:14:56.76,Default,,0,0,0,,Бостандық…. иә! ➡
Dialogue: 0,0:14:56.76,0:14:59.76,Default,,0,0,0,,Дүниедегі кез келген адаммен еркін!
Dialogue: 0,0:14:59.76,0:15:01.76,Default,,0,0,0,,Ол үшін сізге ➡ қажет
Dialogue: 0,0:15:01.76,0:15:04.27,Default,,0,0,0,,Мен анда-санда басқарамын.
Dialogue: 0,0:15:04.27,0:15:06.73,Default,,0,0,0,,Мен шынымен де көп нәрсе жасадым.
Dialogue: 0,0:15:07.77,0:15:10.77,Default,,0,0,0,,Мен кез келген нәрсені сынап көретін адаммын.
Dialogue: 0,0:15:12.27,0:15:14.28,Default,,0,0,0,,Тіпті бұл сізді шаршатып жіберсе де➡
Dialogue: 0,0:15:14.28,0:15:16.28,Default,,0,0,0,,Авангард және бәрі ұшып кетеді➡
Dialogue: 0,0:15:16.28,0:15:19.28,Default,,0,0,0,,Сіз басқа адаммен жақсы аралассаңыз, одан да жақсы болар еді!
Dialogue: 0,0:15:19.28,0:15:23.35,Default,,0,0,0,,Мен «Авангардпен» күн көру үшін айналыспаймын! ➡
Dialogue: 0,0:15:23.35,0:15:25.82,Default,,0,0,0,,Өйткені мен Авангард үшін өмір сүремін!
Dialogue: 0,0:15:25.82,0:15:29.29,Default,,0,0,0,,Ха...! Бұл мен таңдаған өмір! ➡
Dialogue: 0,0:15:29.29,0:15:31.26,Default,,0,0,0,,Мен үшін Авангард – ➡
Dialogue: 0,0:15:31.26,0:15:33.76,Default,,0,0,0,,Бостандыққа жеткізетін жел!
Dialogue: 0,0:15:33.76,0:15:36.26,Default,,0,0,0,,Кеттік! Менің кезегім ➡
Dialogue: 0,0:15:36.26,0:15:38.77,Default,,0,0,0,,Persona Ride Nanakryl!
Dialogue: 0,0:15:38.77,0:15:41.30,Default,,0,0,0,,Фралусты шеберлікпен шақырыңыз➡
Dialogue: 0,0:15:41.30,0:15:44.27,Default,,0,0,0,,Менің дүнием қайта адасатын баққа айналады.
Dialogue: 0,0:15:47.78,0:15:50.28,Default,,0,0,0,,Ривзфзерді шеберлікпен шақырыңыз➡
Dialogue: 0,0:15:50.28,0:15:52.78,Default,,0,0,0,,Бельнуарға осындай шеберлікпен қоңырау шалыңыз.
Dialogue: 0,0:15:52.78,0:15:55.25,Default,,0,0,0,,Жапырақ қауырсынымен шабуыл!
Dialogue: 0,0:15:55.25,0:15:57.75,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:15:57.75,0:15:59.75,Default,,0,0,0,,Белноамен шабуыл!
Dialogue: 0,0:15:59.75,0:16:02.26,Default,,0,0,0,,Reel Amorta бар күзет!
Dialogue: 0,0:16:02.26,0:16:04.76,Default,,0,0,0,,Екі байлау картасын палубаның төменгі жағына қайтарыңыз➡
Dialogue: 0,0:16:04.76,0:16:07.26,Default,,0,0,0,,Шабуыл тимейді! Оййо! ➡
Dialogue: 0,0:16:07.26,0:16:09.76,Default,,0,0,0,,Бірақ әлі біткен жоқ!
Dialogue: 0,0:16:09.76,0:16:12.77,Default,,0,0,0,,Нанакрилмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:16:12.77,0:16:14.74,Default,,0,0,0,,Бұл туралы не деуге болады!
Dialogue: 0,0:16:17.27,0:16:19.27,Default,,0,0,0,,Тағы да күзет! ➡
Dialogue: 0,0:16:19.27,0:16:21.24,Default,,0,0,0,,Reel Amorta!
Dialogue: 0,0:16:23.28,0:16:26.28,Default,,0,0,0,,Мен көремін. Бұл Парнасетра.
Dialogue: 0,0:16:26.28,0:16:28.25,Default,,0,0,0,,Аа, сол шеберлікпен➡
Dialogue: 0,0:16:28.25,0:16:30.25,Default,,0,0,0,,Байланыстың артуы арқасында...
Dialogue: 0,0:16:30.25,0:16:32.75,Default,,0,0,0,,Эрика-сан - Роль-Аморта➡
Dialogue: 0,0:16:32.75,0:16:35.76,Default,,0,0,0,,Мен оны екі рет қолдана алдым.
Dialogue: 0,0:16:35.76,0:16:37.76,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:16:37.76,0:16:39.76,Default,,0,0,0,,Ұнады! ➡
Dialogue: 0,0:16:39.76,0:16:41.76,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:16:43.76,0:16:45.77,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:16:45.77,0:16:47.77,Default,,0,0,0,,Критикалық триггер! ➡
Dialogue: 0,0:16:47.77,0:16:49.77,Default,,0,0,0,,Белнор қуаты плюс 10000➡
Dialogue: 0,0:16:49.77,0:16:51.77,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:16:51.77,0:16:53.77,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:16:53.77,0:16:56.78,Default,,0,0,0,,Критикалық триггер! Белноа қуаты плюс 10000➡
Dialogue: 0,0:16:56.78,0:16:58.78,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:16:58.78,0:17:00.75,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:17:00.75,0:17:02.75,Default,,0,0,0,,Белнормен бірге Авангардқа шабуыл жасаңыз! ➡
Dialogue: 0,0:17:02.75,0:17:05.25,Default,,0,0,0,,Дағдылармен қосымша 10 000 қуат қосыңыз!
Dialogue: 0,0:17:06.25,0:17:08.76,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:17:09.76,0:17:11.76,Default,,0,0,0,,Ку~ Қандай ұят! ➡
Dialogue: 0,0:17:11.76,0:17:14.30,Default,,0,0,0,,Кезеңнің соңы!
Dialogue: 0,0:17:14.30,0:17:16.80,Default,,0,0,0,,Мен шыдадым! Керемет Эрика!
Dialogue: 0,0:17:18.27,0:17:21.27,Default,,0,0,0,,Маған Луканың өмір сүру тәсілі де ұнайды.
Dialogue: 0,0:17:21.27,0:17:24.27,Default,,0,0,0,,Содан кейін маған таңдаған жолыңызды айтыңыз.
Dialogue: 0,0:17:24.27,0:17:26.81,Default,,0,0,0,,Мен үшін өткен түн➡
Dialogue: 0,0:17:26.81,0:17:29.78,Default,,0,0,0,,Мен кәсіпқой болу дегенді ойладым.
Dialogue: 0,0:17:31.35,0:17:34.82,Default,,0,0,0,,((Эй, сіз Vanguard кәсіпқойы болуға қалай қарайсыз?
Dialogue: 0,0:17:34.82,0:17:36.75,Default,,0,0,0,,📱Хаа... Кенет не болды? ➡
Dialogue: 0,0:17:36.75,0:17:38.99,Default,,0,0,0,,Оны кесуге бола ма? Бір минут күте тұрыңыз.
Dialogue: 0,0:17:38.99,0:17:41.26,Default,,0,0,0,,📱Сіз нені айтасыз?
Dialogue: 0,0:17:41.26,0:17:43.29,Default,,0,0,0,,Сіз про➡ боламын дедіңіз
Dialogue: 0,0:17:43.29,0:17:45.26,Default,,0,0,0,,Бірақ бұл басқа опциялардың бар екенін білдіреді➡
Dialogue: 0,0:17:45.26,0:17:47.83,Default,,0,0,0,,Мен оны көрмеймін деп ойлаймын➡
Dialogue: 0,0:17:47.83,0:17:50.26,Default,,0,0,0,,Мен бұл туралы біраз уақыт ойладым. 📱Бұл не?
Dialogue: 0,0:17:50.26,0:17:53.33,Default,,0,0,0,,Сізді уайымдайтын жалғыз нәрсе осы ма?
Dialogue: 0,0:17:53.33,0:17:55.30,Default,,0,0,0,,📱Ха? Сен кімсің?
Dialogue: 0,0:17:56.27,0:17:58.84,Default,,0,0,0,,Неліктен сіз «Авангардты» бастадыңыз?
Dialogue: 0,0:17:58.84,0:18:00.78,Default,,0,0,0,,📱Себебі бұл көңілді көрінді.
Dialogue: 0,0:18:00.78,0:18:02.84,Default,,0,0,0,,Бұқтырылғанды ​​кім жақсы көреді?
Dialogue: 0,0:18:02.84,0:18:04.85,Default,,0,0,0,,📱Өйткені ол дәмді.
Dialogue: 0,0:18:04.85,0:18:06.75,Default,,0,0,0,,📱Сенің ағаңды кім құтқарғысы келді?
Dialogue: 0,0:18:06.75,0:18:08.82,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:18:08.82,0:18:12.25,Default,,0,0,0,,Өйткені мен ағамды жақсы көремін. 📱Дұрыс!
Dialogue: 0,0:18:12.25,0:18:14.82,Default,,0,0,0,,Мұның бәрі бар.
Dialogue: 0,0:18:14.82,0:18:17.76,Default,,0,0,0,,📱Қызықты болғандықтан жасаңыз, дәмді болғандықтан жеңіз➡
Dialogue: 0,0:18:17.76,0:18:19.76,Default,,0,0,0,,Көмектесіңіз, өйткені мен оны жақсы көремін! ➡
Dialogue: 0,0:18:19.76,0:18:22.26,Default,,0,0,0,,Біз әрқашан осылай істейміз.
Dialogue: 0,0:18:23.26,0:18:26.40,Default,,0,0,0,,Кәсіби маман болуға не түрткі болды?
Dialogue: 0,0:18:26.40,0:18:28.37,Default,,0,0,0,,📱Неге? ))
Dialogue: 0,0:18:29.77,0:18:32.77,Default,,0,0,0,,Маман болуға шешім қабылдау себебім➡
Dialogue: 0,0:18:32.77,0:18:35.28,Default,,0,0,0,,Тәуелсіз болу, әрине.
Dialogue: 0,0:18:35.28,0:18:37.81,Default,,0,0,0,,Бірақ бұл бәрі емес!
Dialogue: 0,0:18:37.81,0:18:42.25,Default,,0,0,0,,Менің айналамда кәсіби әлемде белсенді адамдар бар➡
Dialogue: 0,0:18:42.25,0:18:44.25,Default,,0,0,0,,Тайзо-сан және Киома-сан➡
Dialogue: 0,0:18:44.25,0:18:46.29,Default,,0,0,0,,Және Нао-сан.
Dialogue: 0,0:18:46.29,0:18:49.26,Default,,0,0,0,,Мен кәсіби түрде күресетін адамдарды керемет деп ойладым➡
Dialogue: 0,0:18:49.26,0:18:51.79,Default,,0,0,0,,Мен бұл керемет деп ойладым!
Dialogue: 0,0:18:51.79,0:18:54.76,Default,,0,0,0,,Сондықтан мен де сондай болғым келеді➡
Dialogue: 0,0:18:54.76,0:18:56.76,Default,,0,0,0,,Себебі мен сені қатты жақсы көрдім!
Dialogue: 0,0:18:56.76,0:18:59.73,Default,,0,0,0,,Мен кәсіби маман боламын деп ойладым!
Dialogue: 0,0:19:04.27,0:19:06.77,Default,,0,0,0,,Бұл сіздің авангардыңыз.
Dialogue: 0,0:19:06.77,0:19:08.78,Default,,0,0,0,,Сәлем! ➡
Dialogue: 0,0:19:08.78,0:19:11.78,Default,,0,0,0,,Бұл жекпе-жекті жеңіп, финалда да жеңіске жет➡
Dialogue: 0,0:19:11.78,0:19:14.28,Default,,0,0,0,,Біз міндетті түрде жеңеміз!
Dialogue: 0,0:19:14.28,0:19:18.25,Default,,0,0,0,,Себебі мен таңдаған болашақ осы!
Dialogue: 0,0:19:18.25,0:19:21.26,Default,,0,0,0,,Un. Менің кезегім ➡
Dialogue: 0,0:19:21.26,0:19:23.26,Default,,0,0,0,,Алпақты шақырыңыз➡
Dialogue: 0,0:19:23.26,0:19:26.26,Default,,0,0,0,,Drop Сервиантты катушка шеберлігімен байлау➡
Dialogue: 0,0:19:26.26,0:19:28.80,Default,,0,0,0,,Жүргізу плюс 1!
Dialogue: 0,0:19:28.80,0:19:32.27,Default,,0,0,0,,Қызметшіге шеберлікпен қоңырау шалыңыз!
Dialogue: 0,0:19:32.27,0:19:35.27,Default,,0,0,0,,Келіңіздер, сіздің болашағыңызға қауіп төніп тұр!
Dialogue: 0,0:19:35.27,0:19:37.27,Default,,0,0,0,,Кеттік! ➡
Dialogue: 0,0:19:37.27,0:19:40.27,Default,,0,0,0,,Габриэлиуспен шабуыл! күзетші!
Dialogue: 0,0:19:40.27,0:19:43.28,Default,,0,0,0,,Дракониспен авангардқа шабуыл жасаңыз! ➡
Dialogue: 0,0:19:43.28,0:19:45.28,Default,,0,0,0,,Габуэлий шеберлігі бар➡
Dialogue: 0,0:19:45.28,0:19:47.25,Default,,0,0,0,,Қоңырау шалыңыз!
Dialogue: 0,0:19:48.25,0:19:50.75,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:54.36,0:19:56.32,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:19:57.26,0:19:59.36,Default,,0,0,0,,➡
Dialogue: 0,0:19:59.36,0:20:01.26,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:20:01.26,0:20:03.26,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:20:03.26,0:20:05.77,Default,,0,0,0,,Габуэлийдің күші плюс 10 000! ➡
Dialogue: 0,0:20:05.77,0:20:07.77,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:20:07.77,0:20:09.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:10.77,0:20:14.78,Default,,0,0,0,,Ғажайып... терең қараңғылықты жарықтандыруға жеткілікті ➡
Dialogue: 0,0:20:14.78,0:20:16.74,Default,,0,0,0,,Жарқыраған жарық!
Dialogue: 0,0:20:18.78,0:20:21.75,Default,,0,0,0,,Кеттік! Un!
Dialogue: 0,0:20:21.75,0:20:25.25,Default,,0,0,0,,Авангардқа Габриэлиуспен бірге шабуыл жасаңыз!
Dialogue: 0,0:20:26.25,0:20:28.26,Default,,0,0,0,,Таң атқан аспанда қалықтаған жұлдыздар➡
Dialogue: 0,0:20:28.26,0:20:30.76,Default,,0,0,0,,Сол нұрдың алдында тұрғандар➡
Dialogue: 0,0:20:30.76,0:20:33.26,Default,,0,0,0,,Менің құпия техникаммен сілкіп алайық➡
Dialogue: 0,0:20:33.26,0:20:36.26,Default,,0,0,0,,Қабыл ал, мен оған шешімімді қойдым➡
Dialogue: 0,0:20:36.26,0:20:38.23,Default,,0,0,0,,Тағдыр ұшқыны!
Dialogue: 0,0:20:40.27,0:20:43.27,Default,,0,0,0,,Өтіп кетсін!
Dialogue: 0,0:20:43.27,0:20:45.24,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:20:46.27,0:20:48.28,Default,,0,0,0,,Көлікті тексеру!
Dialogue: 0,0:20:48.28,0:20:51.25,Default,,0,0,0,,Триггерді емдеңіз!
Dialogue: 0,0:21:06.26,0:21:09.80,Default,,0,0,0,,Жеңімпаз... Эрика Миоджо!
Dialogue: 0,0:21:09.80,0:21:19.27,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:23.78,0:21:27.25,Default,,0,0,0,,Рахмет, Лука!
Dialogue: 0,0:21:27.25,0:21:29.25,Default,,0,0,0,,Тіпті жеңіліп қалсаңыз да➡
Dialogue: 0,0:21:29.25,0:21:32.25,Default,,0,0,0,,Қызық тартыс болып жатыр.
Dialogue: 0,0:21:32.25,0:21:34.26,Default,,0,0,0,,Бұл жолы жеңіске жетуге себеп болды➡
Dialogue: 0,0:21:34.26,0:21:37.26,Default,,0,0,0,,Бұл әдеттегіден гөрі көңілсіз.
Dialogue: 0,0:21:37.26,0:21:39.29,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:39.29,0:21:41.76,Default,,0,0,0,,Бұл өте қызық болды!
Dialogue: 0,0:21:41.76,0:21:44.27,Default,,0,0,0,,Сәлем... мен де!
Dialogue: 0,0:21:45.77,0:21:47.77,Default,,0,0,0,,Жарайды, келесі мен.
Dialogue: 0,0:21:47.77,0:21:50.77,Default,,0,0,0,,О! Кәне. жоғары! ➡
Dialogue: 0,0:21:50.77,0:21:53.24,Default,,0,0,0,,Мен одан міндетті түрде асып түсемін!
Dialogue: 0,0:21:54.78,0:21:58.28,Default,,0,0,0,,Ал... кеттік.
