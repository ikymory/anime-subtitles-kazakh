Dialogue: 0,0:16:19.41,0:16:23.00,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:16:23.00,0:16:24.92,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:16:24.92,0:16:26.92,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:16:26.92,0:16:29.44,Default,,0,0,0,,Юумашад қуаты плюс 10000➡
Dialogue: 0,0:16:29.44,0:16:31.41,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:16:31.41,0:16:33.91,Default,,0,0,0,,Екі Маю Машад шеберлікпен тұр.
Dialogue: 0,0:16:33.91,0:16:36.43,Default,,0,0,0,,Қосымша Зам-Падру дағдылары➡
Dialogue: 0,0:16:36.43,0:16:39.41,Default,,0,0,0,,Сіз тұрғанда сол бағандағы артқы қорғаушы тұрғанда ➡
Dialogue: 0,0:16:39.42,0:16:42.92,Default,,0,0,0,,Джишиннің өзі де тұр, қуат плюс 5000!
Dialogue: 0,0:16:42.92,0:16:45.44,Default,,0,0,0,,Югмашадпен шабуыл!
Dialogue: 0,0:16:45.44,0:16:47.92,Default,,0,0,0,,Толығымен қорғалған
Dialogue: 0,0:16:47.92,0:16:50.46,Default,,0,0,0,,Шурёжи Ку…Ұрыстың соңында➡
Dialogue: 0,0:16:50.46,0:16:53.91,Default,,0,0,0,,Хитоцуду Зам-Паддлдың тағы бір дағдысы іске қосылды!➡
Dialogue: 0,0:16:53.91,0:16:57.42,Default,,0,0,0,,Джишинмайдың өзін жанға салып, 1 картаны сал
Dialogue: 0,0:16:57.42,0:16:59.42,Default,,0,0,0,,Югмашадпен шабуыл!
Dialogue: 0,0:16:59.42,0:17:01.42,Default,,0,0,0,,Күзетші жоқ
Dialogue: 0,0:17:01.42,0:17:03.46,Default,,0,0,0,,Май дағдысымен 1 картаны сал
Dialogue: 0,0:17:03.46,0:17:06.46,Default,,0,0,0,,Шуроджидің кезегі аяқталғанда, Дияваны тамшыға қойыңыз.
Dialogue: 0,0:17:07.41,0:17:09.41,Default,,0,0,0,,Бұл керемет шабуыл болды➡
Dialogue: 0,0:17:09.41,0:17:11.41,Default,,0,0,0,,Мен аман қалдым
Dialogue: 0,0:17:11.41,0:17:13.92,Default,,0,0,0,,Келесі жолы, жарайды. Мен келесі жолы жеңемін.
Dialogue: 0,0:17:13.92,0:17:15.92,Default,,0,0,0,,Сенің жаның сирек.
Dialogue: 0,0:17:15.92,0:17:17.94,Default,,0,0,0,,Жанды жан?
Dialogue: 0,0:17:17.94,0:17:20.92,Default,,0,0,0,,Менің жалғыз жаным бар, сондықтан адамдардың жанын көремін➡
Dialogue: 0,0:17:20.92,0:17:23.91,Default,,0,0,0,,Сізде екі түс бар, солай ма?
Dialogue: 0,0:17:23.91,0:17:26.91,Default,,0,0,0,,Сіздің түсіңіз нәзік, жарқыраған көк➡
Dialogue: 0,0:17:26.91,0:17:29.92,Default,,0,0,0,,Мокуро қаһарлы және жанып тұрған қара.
Dialogue: 0,0:17:29.92,0:17:31.92,Default,,0,0,0,,Не айтып тұрсыз?➡
Dialogue: 0,0:17:31.92,0:17:34.42,Default,,0,0,0,,Шынымды айтсам, ➡ дегенді түсінбеймін
Dialogue: 0,0:17:34.42,0:17:37.41,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:17:37.41,0:17:39.91,Default,,0,0,0,,Мен олардың сәйкес келетініне қуаныштымын.
Dialogue: 0,0:17:39.91,0:17:41.96,Default,,0,0,0,,Бавсағара➡
Dialogue: 0,0:17:41.96,0:17:43.96,Default,,0,0,0,,Такао Такао мен оның құрбысының да екі беті бар дейді.
Dialogue: 0,0:17:44.91,0:17:46.95,Default,,0,0,0,,Қызықты➡
Dialogue: 0,0:17:46.95,0:17:49.45,Default,,0,0,0,,Сондықтан Vanguard Fight өте қызықты.
Dialogue: 0,0:17:50.92,0:17:54.42,Default,,0,0,0,,Мен де бар күшімді саламын...
Dialogue: 0,0:17:55.41,0:17:57.46,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:17:57.46,0:17:59.91,Default,,0,0,0,,Кайшиджи айдау кезеңінің басында Дора Джевелд шеберлігін пайдаланыңыз ➡
Dialogue: 0,0:17:59.91,0:18:02.93,Default,,0,0,0,,Май тамшысынан 2 картаны жанға сал
Dialogue: 0,0:18:02.93,0:18:05.93,Default,,0,0,0,,Ары қарай қарама, төрт от, қараңғылықты нұрландыр.
Dialogue: 0,0:18:05.93,0:18:08.93,Default,,0,0,0,,Persona Ride Dorajueld Magnus!
Dialogue: 0,0:18:12.41,0:18:14.41,Default,,0,0,0,,geordraul➡ қоңырау шалыңыз
Dialogue: 0,0:18:14.41,0:18:16.91,Default,,0,0,0,,Ридос Агулды шеберлікпен шақыр
Dialogue: 0,0:18:16.91,0:18:19.45,Default,,0,0,0,,Форкаролға қоңырау шалыңыз
Dialogue: 0,0:18:19.45,0:18:22.45,Default,,0,0,0,,Ұрыс кезеңінің басында алдыңғы қатардың күші +5000
Dialogue: 0,0:18:23.92,0:18:27.41,Default,,0,0,0,,Ридос Агулмен шабуыл. Күзетші!
Dialogue: 0,0:18:27.41,0:18:30.41,Default,,0,0,0,,Dora Jeweld көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:31.91,0:18:34.41,Default,,0,0,0,,Soul➡-тен әртүрлі дәрежедегі карталар
Dialogue: 0,0:18:34.41,0:18:36.41,Default,,0,0,0,,Жанды жару арқылы 4 дана...
Dialogue: 0,0:18:39.95,0:18:41.95,Default,,0,0,0,,Қарсыластың Авангард күшін ашып, 0... дейін азайтыңыз.
Dialogue: 0,0:18:45.49,0:18:47.44,Default,,0,0,0,,Джишиннің өзіндік сыни плюс 1➡
Dialogue: 0,0:18:47.44,0:18:50.94,Default,,0,0,0,,Сиқырлы айдаһар мен 1 сиқырлы қазына айдаһарына жаңа дағды береді.
Dialogue: 0,0:18:53.92,0:18:55.92,Default,,0,0,0,,Буданато дағдылары➡
Dialogue: 0,0:18:55.92,0:18:58.42,Default,,0,0,0,,Бавсагараның күші плюс 20000!
Dialogue: 0,0:18:59.42,0:19:01.42,Default,,0,0,0,,Көбірек күзет!
Dialogue: 0,0:19:03.91,0:19:05.91,Default,,0,0,0,,Bifrons Boost➡
Dialogue: 0,0:19:05.91,0:19:08.91,Default,,0,0,0,,Джеордралмен бірге Авангардқа шабуыл➡
Dialogue: 0,0:19:08.91,0:19:11.45,Default,,0,0,0,,Ehatsudo Dora Jeweled➡-тен алынған дағдыларды белсендіру
Dialogue: 0,0:19:11.45,0:19:14.45,Default,,0,0,0,,Шабуыл жасағанда қолыңыздағы бір картаны тастаңыз.➡
Dialogue: 0,0:19:14.45,0:19:17.94,Default,,0,0,0,,Белсенді дискіні 1-ге орнатып, дискіні тексеру➡ орындаңыз
Dialogue: 0,0:19:17.94,0:19:21.93,Default,,0,0,0,,Дегенмен, Джеордралдың дискісі өз шеберлігін пайдаланып 2-ге оралады.
Dialogue: 0,0:19:21.93,0:19:23.93,Default,,0,0,0,,Көлікті тексеру?
Dialogue: 0,0:19:24.98,0:19:28.50,Default,,0,0,0,,Нококай｟Қалған екі шабуылдың алдын алу мүмкін емес➡
Dialogue: 0,0:19:28.50,0:19:30.94,Default,,0,0,0,,Ал егер!｠
Dialogue: 0,0:19:30.94,0:19:32.92,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:19:32.92,0:19:35.42,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:19:35.42,0:19:39.41,Default,,0,0,0,,Жылдам тексеру➡
Dialogue: 0,0:19:39.41,0:19:41.41,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:19:41.41,0:19:43.42,Default,,0,0,0,,Критикалық триггер➡
Dialogue: 0,0:19:43.42,0:19:45.92,Default,,0,0,0,,Геордраулдың критикалық +1
Dialogue: 0,0:19:49.92,0:19:51.92,Default,,0,0,0,,Гүлдей жанып
Dialogue: 0,0:19:59.92,0:20:01.92,Default,,0,0,0,,Триггер жоқ…
Dialogue: 0,0:20:03.42,0:20:06.94,Default,,0,0,0,,Шошахазама жеңімпазы Мичиру Маварима!
Dialogue: 0,0:20:06.94,0:20:09.91,Default,,0,0,0,,Кансей (қуаныш)
Dialogue: 0,0:20:09.91,0:20:11.93,Default,,0,0,0,,Un?
Dialogue: 0,0:20:11.93,0:20:14.41,Default,,0,0,0,,Куяниден көңілім қалды! Мен ағамды қайтарамын➡
Dialogue: 0,0:20:14.41,0:20:16.42,Default,,0,0,0,,Бұл мүмкіндік болды!
Dialogue: 0,0:20:16.42,0:20:18.42,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:20:19.42,0:20:22.92,Default,,0,0,0,,Тіпті... өте қызық болды!➡
Dialogue: 0,0:20:22.92,0:20:25.41,Default,,0,0,0,,Тағы да күресейік!
Dialogue: 0,0:20:25.41,0:20:27.41,Default,,0,0,0,,Хэхе...әрине
Dialogue: 0,0:20:29.41,0:20:32.91,Default,,0,0,0,,Цюйо Мирей...Мен одан да күштірек боламын.
Dialogue: 0,0:20:33.93,0:20:36.93,Default,,0,0,0,,Күтілгендей, Мичиру шектен шыққан.
Dialogue: 0,0:20:38.42,0:20:40.42,Default,,0,0,0,,Мен сені міндетті түрде қуып жетемін.
Dialogue: 0,0:20:42.41,0:20:44.91,Default,,0,0,0,,Керемет... Күткендей.
Dialogue: 0,0:20:45.94,0:20:49.97,Default,,0,0,0,,Медежитен➡ бірінші бұрылысында сыни триггер пайда болғаннан кейін
Dialogue: 0,0:20:49.97,0:20:54.00,Default,,0,0,0,,Коукоумэ Мамирай екінші шабуылдың 3-кезеңінде жеңілетінін бірден білді.
Dialogue: 0,0:20:54.00,0:20:55.92,Default,,0,0,0,,Ең басынан бастап?
Dialogue: 0,0:20:55.92,0:20:58.41,Default,,0,0,0,,Сонымен Бифрон және Форкарол➡
Dialogue: 0,0:20:58.41,0:21:00.46,Default,,0,0,0,,Тарақты білезік тетігін толық пайдаланыңыз➡
Dialogue: 0,0:21:00.46,0:21:02.96,Default,,0,0,0,,Ол қорғаныс белгілерін жинағандай қозғалды.
Dialogue: 0,0:21:02.96,0:21:06.57,Default,,0,0,0,,Сондай-ақ, Minae Kougeki Fuse Medicine Bag Мирейдің шабуылына тосқауыл қойған Over Trigger➡
Dialogue: 0,0:21:06.57,0:21:09.92,Default,,0,0,0,,Олардың да тамаша күзетшілерді жинағанына сенімдімін.
Dialogue: 0,0:21:09.92,0:21:11.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:11.95,0:21:15.91,Default,,0,0,0,,Жеңілген үлгіні бұзыңыз немесе ұтқан үлгісін жасаңыз
Dialogue: 0,0:21:15.91,0:21:17.94,Default,,0,0,0,,А…
Dialogue: 0,0:21:17.94,0:21:20.91,Default,,0,0,0,,Кун Акина, сенің жолыңда тұрған нәрсе➡
Dialogue: 0,0:21:20.91,0:21:23.41,Default,,0,0,0,,Тагучжоужин - бұл адамнан жоғары адам.
Dialogue: 0,0:21:25.43,0:21:27.43,Default,,0,0,0,,Кундо?Аки-кун
Dialogue: 0,0:21:28.92,0:21:30.92,Default,,0,0,0,,Кун Аки-кун?
Dialogue: 0,0:21:31.92,0:21:33.91,Default,,0,0,0,,Дораджуэлдо…
Dialogue: 0,0:21:33.91,0:21:35.94,Default,,0,0,0,,Өйткені нөлдік қуат 0➡ болады
Dialogue: 0,0:21:35.94,0:21:38.95,Default,,0,0,0,,Алдымен зиян келтірген дұрыс емес...
Dialogue: 0,0:21:38.95,0:21:41.92,Default,,0,0,0,,Бірақ мен енді сыни 2 шабуылға төтеп бере алмаймын...
Dialogue: 0,0:21:41.92,0:21:43.92,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:43.92,0:21:45.92,Default,,0,0,0,,Сіз шынымен мотивация алған сияқтысыз.
Dialogue: 0,0:21:46.92,0:21:49.46,Default,,0,0,0,,Мичиру Хазама Маварима
Dialogue: 0,0:21:49.46,0:21:52.46,Default,,0,0,0,,Юшо чемпионатында жеңіске жету үшін еңсеру керек қабырғалар
Dialogue: 0,0:21:53.91,0:21:56.91,Default,,0,0,0,,Бүгінгі күннің ең мықты жауынгері!
