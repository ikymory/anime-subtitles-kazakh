Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.96,0:00:06.41,Default,,0,0,0,,Бірінші матчтың жеңімпазы - Мияко Мияко Рука!➡
Dialogue: 0,0:00:06.41,0:00:08.41,Default,,0,0,0,,Бірінші жекпе-жектен керемет тартыс➡
Dialogue: 0,0:00:08.41,0:00:11.41,Default,,0,0,0,,Сен маған мұны көрсеттің, Конояро!➡
Dialogue: 0,0:00:11.41,0:00:14.00,Default,,0,0,0,,Бұл финалдық турнир!➡
Dialogue: 0,0:00:14.00,0:00:17.50,Default,,0,0,0,,Мен келесі матчты күте алмаймын!
Dialogue: 0,0:00:18.94,0:00:22.94,Default,,0,0,0,,Кансей (қуаныш)
Dialogue: 0,0:00:24.98,0:00:27.95,Default,,0,0,0,,Цюэ｟Мирей күшті
Dialogue: 0,0:00:27.95,0:00:31.42,Default,,0,0,0,,Саған да оңай болмайды деп ойлаймын.
Dialogue: 0,0:00:31.42,0:00:33.50,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:00:33.50,0:00:36.00,Default,,0,0,0,,Неге сонша бақытты көрінесіз?｠
Dialogue: 0,0:00:48.02,0:00:51.02,Default,,0,0,0,,｟Дұрыс... аа!
Dialogue: 0,0:00:53.42,0:00:55.49,Default,,0,0,0,,Ашуланғанда➡
Dialogue: 0,0:00:55.49,0:00:57.99,Default,,0,0,0,,Өте қорқынышты.｠
Dialogue: 0,0:02:32.93,0:02:34.93,Default,,0,0,0,,Кеш
Dialogue: 0,0:02:35.92,0:02:38.42,Default,,0,0,0,,Бетіңді көрсетуге кеш.
Dialogue: 0,0:02:38.42,0:02:41.92,Default,,0,0,0,,Ол маған келіп, олай айтпауымды айтты.➡
Dialogue: 0,0:02:41.92,0:02:44.91,Default,,0,0,0,,Америкадан ұшақпен.
Dialogue: 0,0:02:44.91,0:02:48.95,Default,,0,0,0,,Хазамакаре Хейки, Мичиру Маварима, ол жақсы ма?
Dialogue: 0,0:02:48.95,0:02:52.95,Default,,0,0,0,,Мен күшімді толық қалпына келтірген жоқпын, бірақ жақсымын➡
Dialogue: 0,0:02:52.95,0:02:56.92,Default,,0,0,0,,Канвангардқа келетін болсақ, ол бұрынғыдан да жарқырайды.
Dialogue: 0,0:02:56.92,0:02:59.94,Default,,0,0,0,,Бұл өте дұрыс... саған да қиын болған шығар.
Dialogue: 0,0:02:59.94,0:03:03.43,Default,,0,0,0,,Хмм...бұл ерекше ештеңе емес.
Dialogue: 0,0:03:03.43,0:03:06.45,Default,,0,0,0,,Осылайша➡
Dialogue: 0,0:03:06.45,0:03:09.92,Default,,0,0,0,,Жауапкершілікті өз мойнына алу керек.
Dialogue: 0,0:03:09.92,0:03:11.92,Default,,0,0,0,,E?
Dialogue: 0,0:03:12.92,0:03:14.95,Default,,0,0,0,,Цу~н
Dialogue: 0,0:03:14.95,0:03:17.91,Default,,0,0,0,,Көріп отырғаныңыздай Мисс Милленің көңіл-күйі нашар➡
Dialogue: 0,0:03:17.91,0:03:19.91,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:03:19.91,0:03:23.91,Default,,0,0,0,,Мен қандаймын? Мен бе? Бұл анық ➡
Dialogue: 0,0:03:23.91,0:03:25.92,Default,,0,0,0,,Мираи-сама ➡ деген адам тұрғанда
Dialogue: 0,0:03:25.92,0:03:28.42,Default,,0,0,0,,Ер адам адамға басып кірді.
Dialogue: 0,0:03:28.42,0:03:31.45,Default,,0,0,0,,Жалған мәлімдемелер жасамаңыз және қолданбаңыз!
Dialogue: 0,0:03:31.45,0:03:34.49,Default,,0,0,0,,Қандай себеп болса да, Мирейді жалғыз қалдыруымның себебі➡ болды
Dialogue: 0,0:03:34.49,0:03:36.41,Default,,0,0,0,,Шынында да дұрыс емес
Dialogue: 0,0:03:36.41,0:03:38.49,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:03:38.49,0:03:40.93,Default,,0,0,0,,Мен шай дайындаймын.
Dialogue: 0,0:03:40.93,0:03:42.92,Default,,0,0,0,,А...ой!
Dialogue: 0,0:03:42.92,0:03:44.93,Default,,0,0,0,,Қашпа➡
Dialogue: 0,0:03:44.93,0:03:44.94,Default,,0,0,0,,Әдеттегідей қашпа➡
Dialogue: 0,0:03:44.94,0:03:47.43,Default,,0,0,0,,Әдеттегідей.
Dialogue: 0,0:03:48.92,0:03:51.92,Default,,0,0,0,,Қалағаныңды айта аласың...
Dialogue: 0,0:03:54.41,0:03:57.41,Default,,0,0,0,,Вару Мирей Бұл... жаман болды.
Dialogue: 0,0:03:57.41,0:03:59.42,Default,,0,0,0,,Цу~н
Dialogue: 0,0:03:59.42,0:04:01.92,Default,,0,0,0,,Сізге мұңды жүзімді кеш көрсеткенім үшін кешіріңіз...
Dialogue: 0,0:04:01.92,0:04:03.92,Default,,0,0,0,,Цу...
Dialogue: 0,0:04:03.92,0:04:06.91,Default,,0,0,0,,Мичируға назар аударғаным үшін кешірім сұраймын...
Dialogue: 0,0:04:06.91,0:04:08.91,Default,,0,0,0,,Бұл рас...Е?
Dialogue: 0,0:04:08.91,0:04:10.91,Default,,0,0,0,,Түн!
Dialogue: 0,0:04:10.91,0:04:13.41,Default,,0,0,0,,Мен сені кешіруге қалай мәжбүрлей аламын...?
Dialogue: 0,0:04:13.41,0:04:16.42,Default,,0,0,0,,Бұл туралы өзім де ойладым.
Dialogue: 0,0:04:16.42,0:04:18.45,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:04:18.45,0:04:22.45,Default,,0,0,0,,Мен және менің жұмысым Daybreak жұмысында қатты жұмыс істедік.
Dialogue: 0,0:04:23.94,0:04:27.44,Default,,0,0,0,,Қазір маған Минаеке дәрі сөмкесінің отбасы жауапты.
Dialogue: 0,0:04:27.44,0:04:30.91,Default,,0,0,0,,Хмм, мен де Yosen Toppa Deluxe➡ үшін алдын ала дайындықтан өттім.
Dialogue: 0,0:04:30.91,0:04:32.93,Default,,0,0,0,,Не керек, бұл толық жеңіс!
Dialogue: 0,0:04:32.93,0:04:34.93,Default,,0,0,0,,О...о?
Dialogue: 0,0:04:36.92,0:04:39.44,Default,,0,0,0,,Білмейтініңізге сенімдісіз бе?
Dialogue: 0,0:04:39.44,0:04:41.91,Default,,0,0,0,,Сәттілік... тамаша орындадың!➡
Dialogue: 0,0:04:41.91,0:04:43.91,Default,,0,0,0,,Сен өте кереметсің~Мирей!
Dialogue: 0,0:04:43.91,0:04:45.91,Default,,0,0,0,,Келіңіздер!➡
Dialogue: 0,0:04:45.91,0:04:47.91,Default,,0,0,0,,Тория!
Dialogue: 0,0:04:47.91,0:04:49.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:50.92,0:04:52.92,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:04:52.92,0:04:55.42,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:04:55.42,0:04:58.91,Default,,0,0,0,,Әрі қарай мен Мичиру-санмен жекпе-жекке шығамын.
Dialogue: 0,0:04:58.91,0:05:01.43,Default,,0,0,0,,О, мен білемін.
Dialogue: 0,0:05:01.43,0:05:04.91,Default,,0,0,0,,Кімді қолдайсың, ағайын?
Dialogue: 0,0:05:04.91,0:05:07.42,Default,,0,0,0,,Е…?Мен?➡
Dialogue: 0,0:05:07.42,0:05:09.92,Default,,0,0,0,,Әлде Мичиру-сан ба?
Dialogue: 0,0:05:09.92,0:05:13.41,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:13.41,0:05:15.41,Default,,0,0,0,,Un!
Dialogue: 0,0:05:15.41,0:05:19.41,Default,,0,0,0,,Екі жаққа да қолдау көрсетуге бола ма?
Dialogue: 0,0:05:23.42,0:05:26.42,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз. Шай...
Dialogue: 0,0:05:26.42,0:05:33.92,Default,,0,0,0,,Идиот...!
Dialogue: 0,0:05:34.98,0:05:36.91,Default,,0,0,0,,Бір себеп➡
Dialogue: 0,0:05:36.91,0:05:40.50,Default,,0,0,0,,Шиаиоре Чуурицуконың кездесуі Мен бейтараппын!
Dialogue: 0,0:05:40.50,0:05:42.42,Default,,0,0,0,,Өтірік болса да Оуен Мирейді қолдаймын ➡
Dialogue: 0,0:05:42.42,0:05:45.42,Default,,0,0,0,,Ештеңе айтпауы Данжиге тән.
Dialogue: 0,0:05:45.42,0:05:49.43,Default,,0,0,0,,Арзан өтірік айтпайтын ер!
Dialogue: 0,0:05:49.43,0:05:51.43,Default,,0,0,0,,Сіз әдетте шешімсізсіз.
Dialogue: 0,0:05:51.43,0:05:53.43,Default,,0,0,0,,Ерік күші әлсіз
Dialogue: 0,0:05:54.96,0:05:58.92,Default,,0,0,0,,Қиын ойында аяғын баспайтын адам – ер!
Dialogue: 0,0:05:58.92,0:06:02.46,Default,,0,0,0,,Бұл Данжи. Бұл Данжи.
Dialogue: 0,0:06:02.46,0:06:05.91,Default,,0,0,0,,Жартылай мейірім-адамды ренжітетін бірінші нәрсе➡
Dialogue: 0,0:06:05.91,0:06:08.91,Default,,0,0,0,,Бұл туралы өте маңызды адам айтты.
Dialogue: 0,0:06:08.91,0:06:10.91,Default,,0,0,0,,Балалар...
Dialogue: 0,0:06:12.42,0:06:14.42,Default,,0,0,0,,Ол жақта өмір қалай?
Dialogue: 0,0:06:14.42,0:06:16.92,Default,,0,0,0,,Бірте-бірте үйреніп барамын.
Dialogue: 0,0:06:16.92,0:06:20.44,Default,,0,0,0,,Рюгаку Масака Сіз Парижде шетелге оқуға барасыз➡
Dialogue: 0,0:06:20.44,0:06:23.43,Default,,0,0,0,,Есімде дұрыс болса, ол дұрыс киінуді үйренді.
Dialogue: 0,0:06:23.43,0:06:26.91,Default,,0,0,0,,Сәлем! Мияко Париж сән астанасы➡
Dialogue: 0,0:06:26.91,0:06:30.45,Default,,0,0,0,,Мен Жапонияда оқуды жақсы өткізіп жатырмын.
Dialogue: 0,0:06:30.45,0:06:33.42,Default,,0,0,0,,Мен шынымен де айқыш киінуге мәжбүр болғым келмеді, бірақ➡
Dialogue: 0,0:06:33.42,0:06:35.94,Default,,0,0,0,,Маған Fukusu киімдері ұнайды, солай ма?
Dialogue: 0,0:06:35.94,0:06:37.99,Default,,0,0,0,,Айқас кию?
Dialogue: 0,0:06:37.99,0:06:40.49,Default,,0,0,0,,А...ол үшін уайымдамаңыз!➡
Dialogue: 0,0:06:40.49,0:06:42.96,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:42.96,0:06:45.92,Default,,0,0,0,,Айтпақшы, сен өз жолыңмен алға жылжып келе жатырсың.
Dialogue: 0,0:06:45.92,0:06:47.95,Default,,0,0,0,,Е...?
Dialogue: 0,0:06:47.95,0:06:51.42,Default,,0,0,0,,Мен де Кенцукенді кәсіби маман ретінде зерттеймін деп ойладым, бірақ➡
Dialogue: 0,0:06:51.42,0:06:53.41,Default,,0,0,0,,Сонда да мен жеңілдім.
Dialogue: 0,0:06:53.41,0:06:55.49,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:06:55.49,0:06:57.41,Default,,0,0,0,,Kekka Pro-да нәтиже - бәрі.
Dialogue: 0,0:06:57.41,0:07:00.00,Default,,0,0,0,,Менде дәл қазір біліктілік жоқ еді➡
Dialogue: 0,0:07:00.00,0:07:02.42,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:07:02.42,0:07:05.42,Default,,0,0,0,,Тодаға...Тұра алмаймын➡
Dialogue: 0,0:07:05.42,0:07:07.42,Default,,0,0,0,,Мен Каашио Цузуны жылдам қарқынмен қууым керек➡
Dialogue: 0,0:07:07.42,0:07:10.42,Default,,0,0,0,,Мичиру-сан қалдырды
Dialogue: 0,0:07:10.42,0:07:12.41,Default,,0,0,0,,Лейка мырза...
Dialogue: 0,0:07:12.41,0:07:14.44,Default,,0,0,0,,Армандар мен арман қуушылар➡
Dialogue: 0,0:07:14.44,0:07:18.43,Default,,0,0,0,,Ол жерге кім бірінші жететінін білу үшін нағыз жарыс.
Dialogue: 0,0:07:18.43,0:07:21.43,Default,,0,0,0,,Барымызды бірге жасайық!
Dialogue: 0,0:07:22.42,0:07:26.92,Default,,0,0,0,,Жарайсыңдар, балалар мені күттіріп қойдыңдар!
Dialogue: 0,0:07:26.92,0:07:30.91,Default,,0,0,0,,Енді екінші ойынды бастайық!
Dialogue: 0,0:07:30.91,0:07:32.91,Default,,0,0,0,,Кансей (қуаныш)
Dialogue: 0,0:07:32.91,0:07:35.95,Default,,0,0,0,,Біздің Патша қайтып келді!➡
Dialogue: 0,0:07:35.95,0:07:39.94,Default,,0,0,0,,Жауынгерлердің ең күшті және жеңілмейтін патшасы!➡
Dialogue: 0,0:07:39.94,0:07:41.94,Default,,0,0,0,,Мичиру Хазама Маварима!
Dialogue: 0,0:07:43.42,0:07:45.44,Default,,0,0,0,,➡ қарсы не істеу керек
Dialogue: 0,0:07:45.44,0:07:49.41,Default,,0,0,0,,Мирё Нихонджу, бүкіл Жапонияны баурап алатын харизматикалық күрескер➡
Dialogue: 0,0:07:49.41,0:07:53.42,Default,,0,0,0,,Акацуки Мико Таа, таңның ғибадатхана қызы Бұл Атай туралы➡
Dialogue: 0,0:07:53.42,0:07:55.42,Default,,0,0,0,,Таңертеңгі топ жетекшісі➡
Dialogue: 0,0:07:55.42,0:07:57.42,Default,,0,0,0,,Minae дәрі сөмкесі Мираи!
Dialogue: 0,0:07:57.42,0:08:02.92,Default,,0,0,0,,Кансей (қуаныш)
Dialogue: 0,0:08:03.94,0:08:06.41,Default,,0,0,0,,Екі мұғалім де жеңілмеген.
Dialogue: 0,0:08:06.41,0:08:08.45,Default,,0,0,0,,Кім жеңеді деп ойлайсың?
Dialogue: 0,0:08:08.45,0:08:12.47,Default,,0,0,0,,Рёхо... екеуі де әбден қабілетті ➡
Dialogue: 0,0:08:12.47,0:08:15.97,Default,,0,0,0,,Осыдан кейін сіріңкенің өтуін кім басқара алады?
Dialogue: 0,0:08:17.94,0:08:21.41,Default,,0,0,0,,Мен сенімен күресуді асыға күттім.
Dialogue: 0,0:08:21.41,0:08:23.41,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:08:23.41,0:08:25.93,Default,,0,0,0,,Ани-нии маған үнемі қамқорлық жасайды!
Dialogue: 0,0:08:25.93,0:08:28.94,Default,,0,0,0,,Токусевао да оған ерекше қамқорлық танытпайды деп ойлаймын...
Dialogue: 0,0:08:28.94,0:08:31.42,Default,,0,0,0,,Өйткені бұл ирониялық!
Dialogue: 0,0:08:31.42,0:08:33.41,Default,,0,0,0,,Окоун...сен шынымен ашулысың ба?
Dialogue: 0,0:08:33.41,0:08:36.41,Default,,0,0,0,,Мен ашуланбаймын, бұл жай...
Dialogue: 0,0:08:36.41,0:08:38.41,Default,,0,0,0,,Сәлем сегіз!
Dialogue: 0,0:08:39.91,0:08:42.42,Default,,0,0,0,,Хехехехе.Келіңіздер!➡
Dialogue: 0,0:08:42.42,0:08:45.49,Default,,0,0,0,,Финалдық турнирдің 2-матчы!➡
Dialogue: 0,0:08:45.49,0:08:47.99,Default,,0,0,0,,Келейік...фай!
Dialogue: 0,0:08:52.43,0:08:54.91,Default,,0,0,0,,Тұрақты Авангард
Dialogue: 0,0:08:54.91,0:08:57.41,Default,,0,0,0,,Jewelius Dracokid Glow
Dialogue: 0,0:08:57.41,0:08:59.43,Default,,0,0,0,,Хоенрю итбалығы Айдаһар Ахинса Суул
Dialogue: 0,0:08:59.43,0:09:01.42,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:09:01.42,0:09:03.97,Default,,0,0,0,,Айдаһар жарқыраған асыл тасқа мініңіз
