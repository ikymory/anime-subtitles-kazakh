Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.96,0:00:05.96,Default,,0,0,0,,Жалғастыруда! Келесі...
Dialogue: 0,0:00:24.04,0:00:27.98,Default,,0,0,0,,Менің әлемім менің әлемімнен бөлек.
Dialogue: 0,0:00:27.98,0:00:31.48,Default,,0,0,0,,Бұл сіз соншалықты жек көретін адам болмауы мүмкін.
Dialogue: 0,0:00:31.48,0:00:33.69,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:33.69,0:00:36.19,Default,,0,0,0,,Мен мәңгі жек көретін жігіт!｠
Dialogue: 0,0:02:25.10,0:02:27.60,Default,,0,0,0,,｟Жоқ!｠
Dialogue: 0,0:02:28.54,0:02:30.44,Default,,0,0,0,,｟Ха...!
Dialogue: 0,0:02:30.44,0:02:34.94,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:37.97,0:02:39.95,Default,,0,0,0,,Тағы да…
Dialogue: 0,0:02:39.95,0:02:42.54,Default,,0,0,0,,Ағамды алып кеткен адам
Dialogue: 0,0:02:42.54,0:02:45.54,Default,,0,0,0,,Мен оны кие алмаймын...! Тыныштал, мен.
Dialogue: 0,0:02:50.95,0:02:53.97,Default,,0,0,0,,Эй...Габуэлиус➡
Dialogue: 0,0:02:53.97,0:02:56.47,Default,,0,0,0,,Мен, мен...не істеуім керек?
Dialogue: 0,0:02:58.45,0:03:01.47,Default,,0,0,0,,Өзің ғана болуың керек емес пе?
Dialogue: 0,0:03:01.47,0:03:03.96,Default,,0,0,0,,Е...? Апыр-ай!
Dialogue: 0,0:03:03.96,0:03:06.46,Default,,0,0,0,,Ах... жай ғана
Dialogue: 0,0:03:06.46,0:03:09.47,Default,,0,0,0,,E! Габуэлиус?
Dialogue: 0,0:03:09.47,0:03:12.97,Default,,0,0,0,,Накакакатаа... бұл сенің ішіңнен сөйлеп тұр.
Dialogue: 0,0:03:12.97,0:03:15.97,Default,,0,0,0,,Менің ішімнен?
Dialogue: 0,0:03:15.97,0:03:18.47,Default,,0,0,0,,Сіз ояусыз ба?➡
Dialogue: 0,0:03:18.47,0:03:20.96,Default,,0,0,0,,Маған неге айтпадың!
Dialogue: 0,0:03:20.96,0:03:23.96,Default,,0,0,0,,Мен сенің өміріңдегі бөгде адаммын➡
Dialogue: 0,0:03:23.96,0:03:26.50,Default,,0,0,0,,Эйкё және басқалары әртүрлі әсер етеді.
Dialogue: 0,0:03:26.50,0:03:29.52,Default,,0,0,0,,Мимамото Цузудан бері мен оны үнсіз бақылап отыруды шештім.
Dialogue: 0,0:03:29.52,0:03:33.46,Default,,0,0,0,,Кешіріңіз... бірақ сіз өткен өміріңізге алаңдап едіңіз.
Dialogue: 0,0:03:33.46,0:03:35.47,Default,,0,0,0,,Жаңа ғана шықты.
Dialogue: 0,0:03:35.47,0:03:37.44,Default,,0,0,0,,Шындығында, Марио — Цезардың ер адамға қоятын идеалы еді
Dialogue: 0,0:03:37.44,0:03:39.96,Default,,0,0,0,,Сенің жараларың менің де күнәларым➡
Dialogue: 0,0:03:39.96,0:03:42.95,Default,,0,0,0,,Сен... маған кек сақтамайсың ба?
Dialogue: 0,0:03:42.95,0:03:44.97,Default,,0,0,0,,Бұл...!
Dialogue: 0,0:03:44.97,0:03:47.54,Default,,0,0,0,,Ұлы тағдыр соғысын жүргізген менмін➡
Dialogue: 0,0:03:47.54,0:03:49.49,Default,,0,0,0,,Ани сенің де ағаң➡
Dialogue: 0,0:03:49.49,0:03:53.59,Default,,0,0,0,,Тағдыр соғысының барлық қатысушылары, оны шақыру жалғасуда ➡
Dialogue: 0,0:03:53.59,0:03:56.95,Default,,0,0,0,,Мен, Тамако, мен және Сивилт арасындағы шайқаста құрбан болдым деп айтуға болады.
Dialogue: 0,0:03:56.95,0:03:58.95,Default,,0,0,0,,Мүмкін солай шығар... бірақ
Dialogue: 0,0:03:58.95,0:04:01.47,Default,,0,0,0,,Мен ренішімді қайда бағыттауым керек?➡
Dialogue: 0,0:04:01.47,0:04:04.47,Default,,0,0,0,,Ең алдымен кек сақтау дұрыс па, білмеймін.
Dialogue: 0,0:04:04.47,0:04:08.01,Default,,0,0,0,,Сезім – бақылауға келмейтін нәрселер ➡
Dialogue: 0,0:04:08.01,0:04:11.46,Default,,0,0,0,,Көп өмір сүрген мен де өз сезімімді сезінемін➡
Dialogue: 0,0:04:11.46,0:04:13.96,Default,,0,0,0,,Жауап бере алмайтын жағдайлар көп.
Dialogue: 0,0:04:13.96,0:04:15.95,Default,,0,0,0,,Олай болса, не істеуім керек...!
Dialogue: 0,0:04:15.95,0:04:18.45,Default,,0,0,0,,Оны сол күйінде қалдырыңыз.E?
Dialogue: 0,0:04:18.45,0:04:20.99,Default,,0,0,0,,Өзіңізді заттарды ұйымдастыруға мәжбүрлеудің қажеті жоқ➡
Dialogue: 0,0:04:20.99,0:04:24.97,Default,,0,0,0,,Дәл қазір сезіп тұрған шындықты айту жақсы идея емес пе?
Dialogue: 0,0:04:24.97,0:04:26.99,Default,,0,0,0,,Бұл қалай?
Dialogue: 0,0:04:26.99,0:04:29.99,Default,,0,0,0,,Жарайды, бізде бәрі жақсы...біз келдік.
Dialogue: 0,0:04:40.96,0:04:43.46,Default,,0,0,0,,Ролик…
Dialogue: 0,0:04:43.46,0:04:45.96,Default,,0,0,0,,Ол да, мен де бірдей сезінеміз.
Dialogue: 0,0:04:45.96,0:04:47.96,Default,,0,0,0,,E?
Dialogue: 0,0:04:50.95,0:04:53.45,Default,,0,0,0,,Біз сізді қолдаймыз!
Dialogue: 0,0:05:01.03,0:05:03.46,Default,,0,0,0,,Бар күшіңмен соғып алсаң жақсы болар еді.｠
Dialogue: 0,0:05:03.46,0:05:05.53,Default,,0,0,0,,Un
Dialogue: 0,0:05:05.53,0:05:07.47,Default,,0,0,0,,｟Ол әлі қандай➡
Dialogue: 0,0:05:07.47,0:05:09.95,Default,,0,0,0,,Мен мүмкіндігінше араласпауға тырыстым.
Dialogue: 0,0:05:09.95,0:05:12.96,Default,,0,0,0,,Себебі мен саған тиісерімді білмедім.
Dialogue: 0,0:05:12.96,0:05:16.04,Default,,0,0,0,,Бір-бірімізге қарсы тұрайық...
Dialogue: 0,0:05:16.04,0:05:17.94,Default,,0,0,0,,Келесі қоңырауға Суоға қоңырау шалыңыз!｠
Dialogue: 0,0:05:17.94,0:05:19.94,Default,,0,0,0,,A...!
Dialogue: 0,0:05:23.45,0:05:26.48,Default,,0,0,0,,Ямихикари, керемет қараңғылық пен жарық...
Dialogue: 0,0:05:26.49,0:05:29.49,Default,,0,0,0,,Джинсэй қандай өмір сүрді деп ойлаймын...
Dialogue: 0,0:05:33.96,0:05:36.50,Default,,0,0,0,,Жарайды, Суо... жақсысың ба?
Dialogue: 0,0:05:36.50,0:05:39.53,Default,,0,0,0,,Басқа болашақта не болғанын естігенде➡
Dialogue: 0,0:05:39.53,0:05:42.03,Default,,0,0,0,,Таңданудың орнына, көңілім толды.
Dialogue: 0,0:05:43.95,0:05:45.95,Default,,0,0,0,,Сондықтан біз бір-бірімізге қарсы тұрамыз! А...
Dialogue: 0,0:05:45.95,0:05:48.47,Default,,0,0,0,,Басқа әлемнен болса да➡
Dialogue: 0,0:05:48.47,0:05:51.47,Default,,0,0,0,,Менің қателіктерім менікі.
Dialogue: 0,0:05:55.46,0:05:57.47,Default,,0,0,0,,Өзіңізді қатты итермеңіз.
Dialogue: 0,0:05:57.47,0:05:59.48,Default,,0,0,0,,Жарайды, жарайды➡
Dialogue: 0,0:05:59.48,0:05:59.49,Default,,0,0,0,,Бұл мен және оның болашаққа қадам басуы үшін қажет күрес. Жарайды➡
Dialogue: 0,0:05:59.49,0:06:03.98,Default,,0,0,0,,Бұл мен және оның болашаққа қадам басуы үшін қажет күрес.
Dialogue: 0,0:06:05.47,0:06:07.49,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса!➡
Dialogue: 0,0:06:07.49,0:06:10.99,Default,,0,0,0,,Қандай жағдай болса да, сен қайтып келетін жер осы.
Dialogue: 0,0:06:12.95,0:06:14.95,Default,,0,0,0,,Мен келемін!
Dialogue: 0,0:06:18.97,0:06:21.49,Default,,0,0,0,,Жеңіске жетуіңізді өтінемін.
Dialogue: 0,0:06:21.49,0:06:24.96,Default,,0,0,0,,Юшо Суо жеңеді деп үміттенемін.
Dialogue: 0,0:06:24.96,0:06:27.96,Default,,0,0,0,,Жалғыз адам ретінде... Сузуне
Dialogue: 0,0:06:29.45,0:06:31.45,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:06:34.00,0:06:37.47,Default,,0,0,0,,Мені өзгерту үшін жауапкершілікті өз мойныңызға алуыңызды өтінемін.
Dialogue: 0,0:06:37.47,0:06:39.47,Default,,0,0,0,,Шулы...
Dialogue: 0,0:06:39.47,0:06:42.48,Default,,0,0,0,,Кансей (қуаныш)
Dialogue: 0,0:06:42.48,0:06:45.46,Default,,0,0,0,,Енді тартысты бастайық!➡
Dialogue: 0,0:06:45.46,0:06:48.96,Default,,0,0,0,,Жаттығудың бірінші қадамы ойыншылардың кіруі!
Dialogue: 0,0:06:50.49,0:06:54.01,Default,,0,0,0,,Тағдырынан бас тартпай қолына алған Шоджо Destiny қызы!➡
Dialogue: 0,0:06:54.01,0:06:57.96,Default,,0,0,0,,Жеңіске қол жеткізетін болашақ болмысыңыздың алдында не тұр?➡
Dialogue: 0,0:06:57.96,0:06:59.96,Default,,0,0,0,,Миоджо Миоджо Эрика!
Dialogue: 0,0:07:03.95,0:07:06.54,Default,,0,0,0,,Егер Мидың көзі сізге тап болса, қашып құтыла алмайсыз➡
Dialogue: 0,0:07:06.54,0:07:09.00,Default,,0,0,0,,Kyomgi Void Yoriyoshi Atsuji Slash Fighter➡
Dialogue: 0,0:07:09.00,0:07:13.50,Default,,0,0,0,,Хонджицуемоно Нөл Каэ, бүгінгі олжаны нөлге қайтарыңыз!
Dialogue: 0,0:07:20.47,0:07:22.95,Default,,0,0,0,,Мен көптен бері аулақ жүрдім➡
Dialogue: 0,0:07:22.95,0:07:26.51,Default,,0,0,0,,Бүгінгі күн басқа, бірақ бүгінгі күн басқа. Мен де.
Dialogue: 0,0:07:26.51,0:07:30.96,Default,,0,0,0,,Бірге жасайық, сосын финалдық турнирдің үшінші ойыны!➡
Dialogue: 0,0:07:30.96,0:07:33.46,Default,,0,0,0,,Келейік... Фай!
Dialogue: 0,0:07:37.47,0:07:39.95,Default,,0,0,0,,Тұр... Авангард!
Dialogue: 0,0:07:39.95,0:07:42.45,Default,,0,0,0,,Марисия қуысы
Dialogue: 0,0:07:42.45,0:07:44.97,Default,,0,0,0,,Билниста, флейташы
Dialogue: 0,0:07:44.97,0:07:46.96,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:07:46.96,0:07:49.94,Default,,0,0,0,,Шұңқырлы Рапторға мініңіз... Бұрылыңыз
Dialogue: 0,0:07:49.95,0:07:51.96,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:07:51.96,0:07:54.95,Default,,0,0,0,,Адольфке міну...Адольфқа шабуыл
Dialogue: 0,0:07:54.95,0:07:56.95,Default,,0,0,0,,Күзетші жоқ
Dialogue: 0,0:07:56.95,0:07:58.97,Default,,0,0,0,,Бұрылыс ұшы
Dialogue: 0,0:07:58.97,0:08:00.97,Default,,0,0,0,,Менің әлемімнен әңгімелер
Dialogue: 0,0:08:02.49,0:08:05.96,Default,,0,0,0,,Ағам менің денемді емдеуге келді➡
Dialogue: 0,0:08:05.96,0:08:08.00,Default,,0,0,0,,Тағдыр соғысына қатысқан Унмей Исен мырза ➡
Dialogue: 0,0:08:08.00,0:08:11.45,Default,,0,0,0,,Қоңырау жалғасып, Судың қалауымен жоғалып кетті.
Dialogue: 0,0:08:11.45,0:08:13.50,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:13.50,0:08:17.96,Default,,0,0,0,,Мен Суды шын жүректен жек көрдім.
Dialogue: 0,0:08:17.96,0:08:20.64,Default,,0,0,0,,Бірақ...түсіндім➡
Dialogue: 0,0:08:20.64,0:08:22.94,Default,,0,0,0,,Бұл сіздің қазіргі адамыңыздан басқаша➡
Dialogue: 0,0:08:22.94,0:08:26.46,Default,,0,0,0,,Басқа әлемнен болсаң да
Dialogue: 0,0:08:26.47,0:08:29.47,Default,,0,0,0,,Шынымен, шынымен... шынымен бе? А?
Dialogue: 0,0:08:29.47,0:08:31.95,Default,,0,0,0,,Мейкимори Юу, сенің сезінуіңнің себебі➡
Dialogue: 0,0:08:31.95,0:08:34.97,Default,,0,0,0,,Мен мұны шешуге болатын нәрсе ме деп сұрадым.
Dialogue: 0,0:08:34.97,0:08:36.96,Default,,0,0,0,,А…
Dialogue: 0,0:08:36.96,0:08:38.94,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:08:38.94,0:08:40.95,Default,,0,0,0,,Бос азуға міну➡
Dialogue: 0,0:08:40.95,0:08:42.96,Default,,0,0,0,,Ведрокқа қоңырау шалыңыз➡
Dialogue: 0,0:08:42.96,0:08:42.97,Default,,0,0,0,,Замург➡ Ведрокқа қоңырау шалу➡ үшін шеберлікті пайдаланыңыз
Dialogue: 0,0:08:42.97,0:08:44.95,Default,,0,0,0,,Заммугты шеберлікпен шақырыңыз➡
Dialogue: 0,0:08:44.95,0:08:46.95,Default,,0,0,0,,Ведрокпен шабуыл!
Dialogue: 0,0:08:46.95,0:08:48.95,Default,,0,0,0,,Күзетші жоқ
Dialogue: 0,0:08:48.95,0:08:50.97,Default,,0,0,0,,Азумен шабуыл
Dialogue: 0,0:08:50.97,0:08:53.46,Default,,0,0,0,,Күзетші. Замургпен шабуыл
Dialogue: 0,0:08:53.46,0:08:56.95,Default,,0,0,0,,Күзетші. Озамгуды жанға салыңыз➡
Dialogue: 0,0:08:56.95,0:08:58.95,Default,,0,0,0,,Бұрылудың соңы
Dialogue: 0,0:08:58.95,0:09:01.97,Default,,0,0,0,,Жанұяңның отбасыңнан айырылғанына ашу - өшпенділік ➡
Dialogue: 0,0:09:01.97,0:09:03.97,Default,,0,0,0,,Солай ма? У...!
Dialogue: 0,0:09:03.97,0:09:05.95,Default,,0,0,0,,Сіз!
Dialogue: 0,0:09:05.95,0:09:07.95,Default,,0,0,0,,Неге олай істеді...
Dialogue: 0,0:09:10.04,0:09:12.01,Default,,0,0,0,,｟Суо…
Dialogue: 0,0:09:12.01,0:09:13.96,Default,,0,0,0,,Жақсы ма?｠
Dialogue: 0,0:09:13.96,0:09:16.95,Default,,0,0,0,,Мен, менің кезегім, Эльгенияға мінемін➡
Dialogue: 0,0:09:16.95,0:09:19.47,Default,,0,0,0,,Эльгениямен шабуыл!
Dialogue: 0,0:09:19.47,0:09:22.99,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу
Dialogue: 0,0:09:22.99,0:09:25.96,Default,,0,0,0,,Егер сіз маған айтып жатсаңыз, мені жек көру керек пе, жоқ па білмейсіз ➡
Dialogue: 0,0:09:25.96,0:09:27.96,Default,,0,0,0,,Мен сізге бір нәрсе айтайын.
Dialogue: 0,0:09:27.96,0:09:29.94,Default,,0,0,0,,Мен ол кезде➡
Dialogue: 0,0:09:29.95,0:09:32.00,Default,,0,0,0,,Тағдыр соғысында жеңіп кетсем ше?
Dialogue: 0,0:09:32.00,0:09:35.45,Default,,0,0,0,,Егер қателессеңіз, сіздің әлеміңіз бен сіздікі бірдей нәрсеге үміттенгеніне сенімдімін.
Dialogue: 0,0:09:35.45,0:09:38.45,Default,,0,0,0,,Саған керек нәрсенің бәрі маған керек емес...маған керек емес➡
Dialogue: 0,0:09:38.45,0:09:41.01,Default,,0,0,0,,Мен сенің жоқтыққа оралуыңды қалаймын...!
Dialogue: 0,0:09:41.01,0:09:44.01,Default,,0,0,0,,Мен Акина Мейдоны өлтірдім.
Dialogue: 0,0:09:45.44,0:09:47.95,Default,,0,0,0,,Келесі қоңырауға Суоу~ қоңырау шалыңыз!
Dialogue: 0,0:09:47.95,0:09:49.97,Default,,0,0,0,,Жек көрушілікті жасырма➡
Dialogue: 0,0:09:49.97,0:09:51.95,Default,,0,0,0,,Мен және Благмайр➡
Dialogue: 0,0:09:51.95,0:09:54.97,Default,,0,0,0,,Не десең де, ағаңның жауымын.
Dialogue: 0,0:09:54.97,0:09:58.47,Default,,0,0,0,,Бәрін өшіретін біздің жоқтығымыз➡
Dialogue: 0,0:09:58.47,0:10:01.04,Default,,0,0,0,,Өз көзіңмен қара!
Dialogue: 0,0:10:01.04,0:10:03.95,Default,,0,0,0,,Барлық заттардың түбіне апаратын барлық заттардың жоқтығы
Dialogue: 0,0:10:03.95,0:10:05.95,Default,,0,0,0,,Жүріңіз...!
Dialogue: 0,0:10:06.95,0:10:09.45,Default,,0,0,0,,Нөл Унмейша Нөлдің тағдыры➡
Dialogue: 0,0:10:09.45,0:10:13.04,Default,,0,0,0,,Мақтаншақ
Dialogue: 0,0:10:13.04,0:10:15.97,Default,,0,0,0,,Бомбалау жонглері шеберіне➡ қоңырау шалыңыз
Dialogue: 0,0:10:15.97,0:10:18.44,Default,,0,0,0,,Сондай-ақ алхимикті➡ шақырыңыз
Dialogue: 0,0:10:18.44,0:10:20.95,Default,,0,0,0,,Барлығын ештеңеге айналдырыңыз➡
Dialogue: 0,0:10:20.95,0:10:23.47,Default,,0,0,0,,Мақтанған батпақпен шабуыл!
Dialogue: 0,0:10:23.47,0:10:25.47,Default,,0,0,0,,Хатсудо дағдыларын белсендіру
Dialogue: 0,0:10:27.95,0:10:30.96,Default,,0,0,0,,Байлау 4 Майура жанды төмен қаратыңыз➡
Dialogue: 0,0:10:30.96,0:10:34.94,Default,,0,0,0,,Ал Брегедмирдің күші плюс 10000
Dialogue: 0,0:10:34.94,0:10:36.95,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:10:36.95,0:10:38.96,Default,,0,0,0,,Жылдам тексеру➡
Dialogue: 0,0:10:38.96,0:10:40.97,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:10:40.97,0:10:44.47,Default,,0,0,0,,Триггерді тартыңыз! Жонглер күші плюс 10000
Dialogue: 0,0:10:45.99,0:10:47.97,Default,,0,0,0,,Жонглермен шабуыл➡
Dialogue: 0,0:10:47.97,0:10:49.98,Default,,0,0,0,,Дағды қуаты +10000
Dialogue: 0,0:10:49.98,0:10:52.49,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:10:52.49,0:10:55.46,Default,,0,0,0,,Шурёджио шайқасының соңында Жонгллерді жанға орналастырыңыз➡
Dialogue: 0,0:10:55.46,0:10:57.95,Default,,0,0,0,,Артқы дағдылар арқылы сахна артын байланыстырыңыз➡
Dialogue: 0,0:10:57.95,0:11:00.45,Default,,0,0,0,,Ведроктың қуаты +5000➡
Dialogue: 0,0:11:00.45,0:11:02.95,Default,,0,0,0,,Ведрокпен шабуыл
Dialogue: 0,0:11:02.95,0:11:02.96,Default,,0,0,0,,Күзетші! Сиқыршы шеберлігі ➡ Ведрокпен шабуыл
Dialogue: 0,0:11:02.96,0:11:05.47,Default,,0,0,0,,Күзетші! Шебер дағдыларымен➡
Dialogue: 0,0:11:05.47,0:11:07.96,Default,,0,0,0,,Қолыңызға Майтефудакува жанының 1 картасын қосыңыз➡
Dialogue: 0,0:11:07.96,0:11:10.48,Default,,0,0,0,,Бұрылудың соңы
Dialogue: 0,0:11:10.48,0:11:14.45,Default,,0,0,0,,Мен сенімен қалай бетпе-бет келуді ойладым ➡
Dialogue: 0,0:11:14.45,0:11:17.50,Default,,0,0,0,,Мен Йоби Цуги Кира Казоку Сууды жек көремін➡
Dialogue: 0,0:11:17.50,0:11:22.46,Default,,0,0,0,,Бұл сіздің көзқарасыңыз бойынша мүлдем негізсіз болуы мүмкін➡
Dialogue: 0,0:11:22.46,0:11:24.96,Default,,0,0,0,,Досым Акина екеуің доссыңдар➡
Dialogue: 0,0:11:24.96,0:11:27.96,Default,,0,0,0,,Ешқандай қиындық тудырғым келмейді...!➡
Dialogue: 0,0:11:27.96,0:11:29.97,Default,,0,0,0,,Бірақ!➡
Dialogue: 0,0:11:29.97,0:11:33.95,Default,,0,0,0,,Қаласаңыз, Энрио ұстамайды➡
Dialogue: 0,0:11:33.95,0:11:36.97,Default,,0,0,0,,Сіздің білуіңіз қисынсыз болуы мүмкін, солай ма?
Dialogue: 0,0:11:36.97,0:11:38.97,Default,,0,0,0,,Ниба ағамды алып кетті➡
Dialogue: 0,0:11:38.97,0:11:40.96,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:11:40.96,0:11:43.45,Default,,0,0,0,,Басынан бастап мұны істеудің қажеті жоқ.
Dialogue: 0,0:11:43.45,0:11:46.45,Default,,0,0,0,,Келесі қоңырауға қоңырау шалған Суохты жек көру ➡
Dialogue: 0,0:11:46.45,0:11:48.95,Default,,0,0,0,,Мен барлық сегізаяқтарды ұрамын!
Dialogue: 0,0:11:50.04,0:11:52.54,Default,,0,0,0,,｟Габуэлиус барабаны➡
Dialogue: 0,0:11:52.54,0:11:55.47,Default,,0,0,0,,Мені артқа итеріңіз...!｠
Dialogue: 0,0:11:55.47,0:11:57.47,Default,,0,0,0,,Томоюаа, бірге барайық!
Dialogue: 0,0:12:00.45,0:12:03.50,Default,,0,0,0,,Унмей Цубасамирай Тағдыр қанаттары Болашақтан, міне!➡
Dialogue: 0,0:12:03.50,0:12:06.47,Default,,0,0,0,,Драконисті айналдыру, Қасиетті уақыттың тағдыры➡
Dialogue: 0,0:12:06.47,0:12:08.47,Default,,0,0,0,,Жүр!
Dialogue: 0,0:12:22.54,0:12:25.46,Default,,0,0,0,,Келіңіздер! Егер солай болса, мен сені міндетті түрде талқандаймын!
Dialogue: 0,0:12:25.46,0:12:27.95,Default,,0,0,0,,Айдыласқа➡ қоңырау шалыңыз
Dialogue: 0,0:12:27.95,0:12:29.96,Default,,0,0,0,,Хатсуду катушкасының шеберлігін белсендіру!➡
Dialogue: 0,0:12:29.96,0:12:29.97,Default,,0,0,0,,Артқы күзетші Айдыласты байлау➡ Хатсуду катушкасының шеберлігін белсендіріңіз!➡
Dialogue: 0,0:12:29.97,0:12:31.97,Default,,0,0,0,,Артқы күзетшінің Айдилусын➡ байлаңыз
Dialogue: 0,0:12:31.97,0:12:34.95,Default,,0,0,0,,Қолыңыздан бір картаны алып тастаңыз да, плюс 1➡ жүргізіңіз
Dialogue: 0,0:12:34.95,0:12:37.97,Default,,0,0,0,,Және шектелген Айдилус шеберлігімен➡
Dialogue: 0,0:12:37.97,0:12:39.96,Default,,0,0,0,,1 картаны салыңыз➡
Dialogue: 0,0:12:39.96,0:12:42.03,Default,,0,0,0,,Almove➡ қоңырау шалыңыз
Dialogue: 0,0:12:42.03,0:12:44.98,Default,,0,0,0,,Идилусты діни деп атаңыз!➡
Dialogue: 0,0:12:44.98,0:12:47.98,Default,,0,0,0,,Tefudakuwa шеберлігімен Reel Amorta-ны қолыңызға қосыңыз!
Dialogue: 0,0:12:49.45,0:12:51.47,Default,,0,0,0,,Идилуспен шабуыл!
Dialogue: 0,0:12:51.47,0:12:53.97,Default,,0,0,0,,Күзетші. Шурёжи шайқасының соңында➡
Dialogue: 0,0:12:53.97,0:12:56.01,Default,,0,0,0,,Ұсқынсыз сауытты жаныңа сал➡
Dialogue: 0,0:12:56.01,0:12:59.96,Default,,0,0,0,,Чууконың толық алдыңғы қатардағы артқы қорғаныс қуаты және бұрылыс кезінде 5000
Dialogue: 0,0:12:59.96,0:13:01.96,Default,,0,0,0,,Бәрі керек емес пе?➡
Dialogue: 0,0:13:01.96,0:13:04.00,Default,,0,0,0,,Ақымақ болма!➡
Dialogue: 0,0:13:04.00,0:13:06.47,Default,,0,0,0,,Менің асыл адамымды осылай алып кеткеніңізді қалаймын!➡
Dialogue: 0,0:13:06.47,0:13:10.46,Default,,0,0,0,,Драконистің көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:13:10.46,0:13:12.97,Default,,0,0,0,,Угото Кичиден көшіңіз! Уақыттың күші➡
Dialogue: 0,0:13:12.97,0:13:15.99,Default,,0,0,0,,Хатсудо шеберлігі іске қосылды! Ыдыласты байлау➡
Dialogue: 0,0:13:15.99,0:13:19.46,Default,,0,0,0,,Ямафуда палубасындағы байлаудағы картамен бірдей карта➡
Dialogue: 0,0:13:19.46,0:13:21.97,Default,,0,0,0,,Басқа Идилусқа қоңырау шалыңыз
Dialogue: 0,0:13:21.97,0:13:23.97,Default,,0,0,0,,Күзетші жоқ
Dialogue: 0,0:13:23.97,0:13:25.95,Default,,0,0,0,,Жылдам тексеру➡
Dialogue: 0,0:13:25.95,0:13:27.97,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:13:27.97,0:13:29.96,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:13:29.96,0:13:32.96,Default,,0,0,0,,Critical Trigger!Religial Пауэр Plus 10000➡
Dialogue: 0,0:13:32.96,0:13:35.46,Default,,0,0,0,,Ролдың сыни плюс 1
Dialogue: 0,0:13:36.97,0:13:38.97,Default,,0,0,0,,Идилуспен шабуыл!
Dialogue: 0,0:13:38.97,0:13:41.97,Default,,0,0,0,,Күзетші. Діндармен шабуыл!
Dialogue: 0,0:13:41.97,0:13:44.96,Default,,0,0,0,,Күзет. Бұрылудың соңы
Dialogue: 0,0:13:44.96,0:13:47.44,Default,,0,0,0,,Қайтарыңыз... қайтарыңыз!➡
Dialogue: 0,0:13:47.44,0:13:50.95,Default,,0,0,0,,Маған отбасымды қайтарыңыз... ағамды қайтарыңыз!
Dialogue: 0,0:13:50.95,0:13:54.50,Default,,0,0,0,,Ұрлағаныңды маған қайтар!
Dialogue: 0,0:13:54.50,0:13:57.97,Default,,0,0,0,,Ағамды жоғалтқаныма қанша уақыт кеткенін айтпа...
Dialogue: 0,0:13:57.97,0:14:00.47,Default,,0,0,0,,Маекана, мен сіздің мұңыңызды түсінемін.
Dialogue: 0,0:14:00.47,0:14:02.47,Default,,0,0,0,,Га?
Dialogue: 0,0:14:02.47,0:14:05.46,Default,,0,0,0,,Отбасы мүшесін жоғалтудың қайғысы ➡
Dialogue: 0,0:14:05.46,0:14:07.96,Default,,0,0,0,,Мен бір рет шыдай алмадым.
Dialogue: 0,0:14:07.96,0:14:10.45,Default,,0,0,0,,U…｡Бірақ➡
Dialogue: 0,0:14:10.45,0:14:12.45,Default,,0,0,0,,Қазір біз басқашамыз!
Dialogue: 0,0:14:12.45,0:14:15.50,Default,,0,0,0,,Мен қазір кім екенімді білмеймін, бірақ мен бұл мұңды қабылдаймын➡
Dialogue: 0,0:14:15.50,0:14:19.47,Default,,0,0,0,,Мен сенің өшпенділігіңді қабылдап, алға ұмтыламын.
Dialogue: 0,0:14:19.47,0:14:22.46,Default,,0,0,0,,Нөл Susushime Нөлден бастауға болатынын көрсетіңіз!
Dialogue: 0,0:14:22.46,0:14:25.96,Default,,0,0,0,,Міне, мен келе жатқан жол!
Dialogue: 0,0:14:27.47,0:14:29.47,Default,,0,0,0,,Суо мырза
Dialogue: 0,0:14:31.47,0:14:34.47,Default,,0,0,0,,Жоқтан пайда болатын ғаламның бірі➡
Dialogue: 0,0:14:34.47,0:14:36.97,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:14:38.44,0:14:40.96,Default,,0,0,0,,Нөл Аюмо Нөлден жүретін адам➡
Dialogue: 0,0:14:40.96,0:14:43.96,Default,,0,0,0,,Braggedmire Nexus!
Dialogue: 0,0:14:45.47,0:14:47.47,Default,,0,0,0,,Хатсудо шеберлігі іске қосылды!
Dialogue: 0,0:14:50.97,0:14:53.49,Default,,0,0,0,,Байлау 4 Майура жанды төмен қаратыңыз➡
Dialogue: 0,0:14:53.49,0:14:56.49,Default,,0,0,0,,Егер ол ашық болса, қарсылас екі артқы қорғаушыны төмен қаратып байлайды.
Dialogue: 0,0:14:58.96,0:15:02.95,Default,,0,0,0,,Менің күшім плюс 25000!
Dialogue: 0,0:15:02.95,0:15:05.95,Default,,0,0,0,,Сондай-ақ bind➡ арқылы Замугқа қоңырау шалыңыз
Dialogue: 0,0:15:05.95,0:15:08.46,Default,,0,0,0,,Мачаханың 2 бөлігін шақырыңыз➡
Dialogue: 0,0:15:08.46,0:15:10.46,Default,,0,0,0,,Заммугпен шабуыл!
Dialogue: 0,0:15:10.46,0:15:12.44,Default,,0,0,0,,Дағдылары бар қуат +5000➡
Dialogue: 0,0:15:12.44,0:15:14.45,Default,,0,0,0,,Сыни плюс 1
Dialogue: 0,0:15:14.45,0:15:16.45,Default,,0,0,0,,Толығымен қорғалған!
Dialogue: 0,0:15:18.97,0:15:20.97,Default,,0,0,0,,Бірге барайық➡
Dialogue: 0,0:15:20.97,0:15:23.97,Default,,0,0,0,,Braggedmire Nexus көмегімен шабуыл➡
Dialogue: 0,0:15:23.97,0:15:27.53,Default,,0,0,0,,Алхимик шеберлігі бар Замург стенді➡
Dialogue: 0,0:15:27.53,0:15:29.96,Default,,0,0,0,,Нөлге оралу, нөлге оралу➡
Dialogue: 0,0:15:29.96,0:15:32.46,Default,,0,0,0,,Құдайдың шеберлігі➡
Dialogue: 0,0:15:32.46,0:15:34.47,Default,,0,0,0,,Хатсуген көрінісі...!
Dialogue: 0,0:15:34.47,0:15:36.97,Default,,0,0,0,,Благмирдің сыни плюс 1
Dialogue: 0,0:15:39.47,0:15:42.01,Default,,0,0,0,,Келесі қарсыластың кезегі аяқталғанша жалғастырыңыз➡
Dialogue: 0,0:15:42.01,0:15:44.94,Default,,0,0,0,,Қарсыластың авангарды барлық жалқау қабілеттерін жоғалтады➡
Dialogue: 0,0:15:44.94,0:15:47.45,Default,,0,0,0,,Сіз мінсіз күзетшіні мүлде пайдалана алмайсыз.
Dialogue: 0,0:15:47.45,0:15:49.46,Default,,0,0,0,,Бұл➡
Dialogue: 0,0:15:49.46,0:15:52.46,Default,,0,0,0,,Аюмичики Хиратсуругидің семсері, оның жүруіне жол ашады!
Dialogue: 0,0:15:53.47,0:15:55.47,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:15:56.45,0:15:59.54,Default,,0,0,0,,Уақыт тағдыры, Рол Аморта!
Dialogue: 0,0:15:59.54,0:16:02.94,Default,,0,0,0,,Сол шеберліктің арқасында шабуыл соқпайды!
Dialogue: 0,0:16:02.94,0:16:04.95,Default,,0,0,0,,Жылдам тексеру➡
Dialogue: 0,0:16:04.95,0:16:07.00,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:16:07.00,0:16:10.97,Default,,0,0,0,,Критикалық триггер! Vedroke's Пауэр Plus 10000➡
Dialogue: 0,0:16:10.97,0:16:13.45,Default,,0,0,0,,Сыни плюс 1
Dialogue: 0,0:16:13.45,0:16:15.46,Default,,0,0,0,,Заммугпен шабуыл
Dialogue: 0,0:16:15.46,0:16:17.46,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:16:17.46,0:16:19.44,Default,,0,0,0,,Ведрокпен шабуыл
Dialogue: 0,0:16:19.44,0:16:21.94,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу
Dialogue: 0,0:16:23.97,0:16:26.45,Default,,0,0,0,,Мен сіздің жағдайыңызды түсінемін, Джижо.
Dialogue: 0,0:16:26.45,0:16:28.97,Default,,0,0,0,,Жас кезімде отбасымнан айырылдым.
Dialogue: 0,0:16:28.97,0:16:31.01,Default,,0,0,0,,Кез келген нәрсе Бұл не?➡
Dialogue: 0,0:16:31.01,0:16:34.46,Default,,0,0,0,,Олай болса, ағаңды алып кеткенім үшін кешіресің бе?➡
Dialogue: 0,0:16:34.46,0:16:36.94,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:16:36.94,0:16:36.95,Default,,0,0,0,,Мен де, мені де кешіргім келмейді. Мен солай ойламаймын.
Dialogue: 0,0:16:36.95,0:16:39.95,Default,,0,0,0,,Мен де, мені де кешіргім келмейді.
Dialogue: 0,0:16:39.95,0:16:43.47,Default,,0,0,0,,А... Бізде бұл жақсы.
Dialogue: 0,0:16:43.47,0:16:46.45,Default,,0,0,0,,Әлі де жаралар мен күнәларды арқалап жүр➡
Dialogue: 0,0:16:46.45,0:16:48.46,Default,,0,0,0,,Жақсы өмір сүру деген нені білдіреді?
Dialogue: 0,0:16:48.46,0:16:51.94,Default,,0,0,0,,Дұрыс. Мичисаки, бұл жолдың соңында не бар?
Dialogue: 0,0:16:51.94,0:16:54.95,Default,,0,0,0,,Мен түсінбеймін. Болды➡
Dialogue: 0,0:16:54.95,0:16:57.47,Default,,0,0,0,,Сіз тек тыртықпен жабылғандықтан абдырап қалдыңыз.
Dialogue: 0,0:16:57.47,0:16:59.97,Default,,0,0,0,,Жол жалғасады, бірақ жол жалғасады.
Dialogue: 0,0:16:59.97,0:17:01.97,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:01.97,0:17:04.61,Default,,0,0,0,,Шатастыруға болмайды.А...
Dialogue: 0,0:17:04.61,0:17:09.44,Default,,0,0,0,,Какосео өзінің өткенін алып жүруге тырысады және өзі сенетін болашаққа қол созады.
Dialogue: 0,0:17:09.44,0:17:11.44,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:17:13.45,0:17:15.48,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:15.48,0:17:19.00,Default,,0,0,0,,Мен сені ұрсам да Акинамен төбелескім келеді.
Dialogue: 0,0:17:19.00,0:17:22.99,Default,,0,0,0,,Мен сені жеңіп, чемпион болғым келеді.
Dialogue: 0,0:17:22.99,0:17:27.46,Default,,0,0,0,,Онда бар болғанын салып, алдыңдағы жігітті жең!
Dialogue: 0,0:17:27.46,0:17:29.95,Default,,0,0,0,,Сізбен келісетініме сене алар емеспін➡
Dialogue: 0,0:17:29.95,0:17:31.95,Default,,0,0,0,,Ең нашар!
Dialogue: 0,0:17:32.95,0:17:34.99,Default,,0,0,0,,Бүгінгі жағдай қиын➡
Dialogue: 0,0:17:34.99,0:17:39.01,Default,,0,0,0,,Оның қолы немесе артқы қорғаушысы ғана емес, тіпті Нәрлендіретін Авангардтың қабілеті де жоғалып кетті.
Dialogue: 0,0:17:39.01,0:17:42.44,Default,,0,0,0,,Бұл жағдайды шеше алатын карта...
Dialogue: 0,0:17:42.44,0:17:44.98,Default,,0,0,0,,Persona Ride... дұрыс па?
Dialogue: 0,0:17:44.98,0:17:48.48,Default,,0,0,0,,Егер сіз қайтадан атқа мінсеңіз, сіздің қабілеттеріңіз қайта оралады.
Dialogue: 0,0:17:50.47,0:17:52.47,Default,,0,0,0,,Өтінемін➡
Dialogue: 0,0:17:52.47,0:17:54.47,Default,,0,0,0,,Ролик...!
Dialogue: 0,0:17:57.44,0:18:00.45,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:18:00.45,0:18:02.45,Default,,0,0,0,,Ұтыс!
Dialogue: 0,0:18:08.00,0:18:12.96,Default,,0,0,0,,Сен менің тағдырымды өзгерту үшін күресіп жүрсің ғой, солай ма?
Dialogue: 0,0:18:12.96,0:18:15.96,Default,,0,0,0,,Дегенмен шайқас аяқталды.
Dialogue: 0,0:18:15.96,0:18:18.96,Default,,0,0,0,,Мен шынымен жеңілгім келмейтін адам бар ➡
Dialogue: 0,0:18:18.96,0:18:21.95,Default,,0,0,0,,Жарайды, мен жеңілгім келмейтін жекпе-жек бар.
Dialogue: 0,0:18:21.95,0:18:23.97,Default,,0,0,0,,Тағы бір рет, тағы бір рет➡
Dialogue: 0,0:18:23.97,0:18:25.97,Default,,0,0,0,,Маған күшіңді бер!
Dialogue: 0,0:18:38.45,0:18:40.45,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:18:40.45,0:18:42.45,Default,,0,0,0,,Persona Ride➡
Dialogue: 0,0:18:42.45,0:18:44.45,Default,,0,0,0,,Драконис барабаны!
Dialogue: 0,0:18:47.94,0:18:50.45,Default,,0,0,0,,А…
Dialogue: 0,0:18:50.45,0:18:52.96,Default,,0,0,0,,Эгретке➡ қоңырау шалыңыз
Dialogue: 0,0:18:52.96,0:18:54.97,Default,,0,0,0,,Хатсуду катушкасының шеберлігін белсендіру!➡
Dialogue: 0,0:18:54.97,0:18:58.97,Default,,0,0,0,,Drop Габелиусты байлап, плюс 1 жүргізіңіз!
Dialogue: 0,0:18:58.97,0:19:01.47,Default,,0,0,0,,Егретпен шабуыл!
Dialogue: 0,0:19:01.47,0:19:04.44,Default,,0,0,0,,Күзетші. Reel көмегімен шабуыл жасаңыз!
Dialogue: 0,0:19:04.44,0:19:06.46,Default,,0,0,0,,Хатсудо дағдыларын белсендіру➡
Dialogue: 0,0:19:06.46,0:19:09.96,Default,,0,0,0,,Эгретті байлап, Габриэлиусты шақыр!
Dialogue: 0,0:19:14.50,0:19:17.00,Default,,0,0,0,,Бар күшіңді жұмсауыңды қалаймын!
Dialogue: 0,0:19:18.47,0:19:21.96,Default,,0,0,0,,Хатсудо Ямафудаэми дағдысы іске қосылды Палубаның жоғарғы жағына қараңыз ➡
Dialogue: 0,0:19:21.96,0:19:23.96,Default,,0,0,0,,Жоғарыға оралу
Dialogue: 0,0:19:24.95,0:19:26.96,Default,,0,0,0,,Толығымен қорғалған!
Dialogue: 0,0:19:26.96,0:19:26.97,Default,,0,0,0,,Бірінші тексеру➡ Толығымен қорғалған!
Dialogue: 0,0:19:26.97,0:19:28.97,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:19:28.97,0:19:32.45,Default,,0,0,0,,Триггер Габуэлиустың қуатына плюс 10000 сызыңыз!
Dialogue: 0,0:19:32.45,0:19:34.97,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:19:34.97,0:19:36.97,Default,,0,0,0,,Үшінші тексеру
Dialogue: 0,0:19:36.97,0:19:39.47,Default,,0,0,0,,Бір ғана кесек... Мен әлі осындамын!
Dialogue: 0,0:19:40.44,0:19:42.46,Default,,0,0,0,,Қиын-қыстау кезеңдегі тағдырлы козир➡
Dialogue: 0,0:19:42.46,0:19:44.98,Default,,0,0,0,,Шинзуикакочоякудың мәні - өткенге секіру!➡
Dialogue: 0,0:19:44.98,0:19:48.98,Default,,0,0,0,,Токисакама хатсуду уақыты, кері жел...Құдай шеберлігі іске қосылды!
Dialogue: 0,0:19:49.99,0:19:54.96,Default,,0,0,0,,Шурёжи шайқасы аяқталғаннан кейін, түсірілген роликке мініп, Drive-ты 1-ге қойыңыз
Dialogue: 0,0:19:54.96,0:19:57.96,Default,,0,0,0,,Габриэлиуспен шабуыл!
Dialogue: 0,0:19:57.96,0:20:00.95,Default,,0,0,0,,Күзетші жоқ. Көлікті тексеру➡
Dialogue: 0,0:20:00.95,0:20:02.95,Default,,0,0,0,,Триггер жоқ
Dialogue: 0,0:20:02.95,0:20:04.97,Default,,0,0,0,,Тағы да!
Dialogue: 0,0:20:04.97,0:20:06.95,Default,,0,0,0,,Драконис барабанында➡
Dialogue: 0,0:20:06.95,0:20:09.46,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:20:09.46,0:20:11.96,Default,,0,0,0,,Жарайды, мен сенен ұтыла алмаймын!➡
Dialogue: 0,0:20:11.96,0:20:15.46,Default,,0,0,0,,Мен нөлмін, бірақ менде бар нәрсемен нөлге соғамын!
Dialogue: 0,0:20:16.45,0:20:18.45,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:20:21.45,0:20:23.49,Default,,0,0,0,,Өтпеңіз!
Dialogue: 0,0:20:23.49,0:20:25.46,Default,,0,0,0,,Сізге➡
Dialogue: 0,0:20:25.46,0:20:28.46,Default,,0,0,0,,Мен жеңілуге шыдай алмаймын!
Dialogue: 0,0:20:28.46,0:20:31.96,Default,,0,0,0,,Критикалық триггерді алыңыз!
Dialogue: 0,0:20:42.96,0:20:44.94,Default,,0,0,0,,Жеңімпаз!➡
Dialogue: 0,0:20:44.94,0:20:47.03,Default,,0,0,0,,Миоджо Миоджо Эрика~!
Dialogue: 0,0:20:47.03,0:20:59.01,Default,,0,0,0,,Кансей (қуаныш)
Dialogue: 0,0:20:59.01,0:21:02.51,Default,,0,0,0,,Тағдырды өзгертетін күрескерлер...?
Dialogue: 0,0:21:11.47,0:21:14.46,Default,,0,0,0,,Мен сені өмір бойы жек көремін.
Dialogue: 0,0:21:14.46,0:21:16.49,Default,,0,0,0,,О
Dialogue: 0,0:21:16.49,0:21:20.44,Default,,0,0,0,,Тек Миноның оған назар аудармаудан басқа амалы жоқ, себебі ол Акинаның досы.
Dialogue: 0,0:21:20.44,0:21:22.46,Default,,0,0,0,,О
Dialogue: 0,0:21:22.46,0:21:24.95,Default,,0,0,0,,Егер Акина Кодама болғандықтан қиыншылыққа тап болса➡
Dialogue: 0,0:21:24.95,0:21:26.95,Default,,0,0,0,,Уақыты келгенде көмектесіңізші.
Dialogue: 0,0:21:26.95,0:21:28.95,Default,,0,0,0,,Әрине
Dialogue: 0,0:21:32.96,0:21:34.96,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:21:34.96,0:21:36.96,Default,,0,0,0,,Бұл жақсы жекпе-жек болды
Dialogue: 0,0:21:38.46,0:21:41.47,Default,,0,0,0,,Енді, келесі жолы... сіздің кезегіңіз.
Dialogue: 0,0:21:41.47,0:21:43.47,Default,,0,0,0,,А...сәлем!
Dialogue: 0,0:21:45.47,0:21:47.97,Default,,0,0,0,,Ха~! Көшбасшының жекпе-жегі➡
Dialogue: 0,0:21:47.97,0:21:49.96,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,0:21:49.96,0:21:53.46,Default,,0,0,0,,Мен жеңемін. Мен де Лукамен жұдырықтасқым келеді.
Dialogue: 0,0:21:53.46,0:21:55.46,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:21:55.46,0:21:58.46,Default,,0,0,0,,Юшо Мен жеңімпаз боламын!
Dialogue: 0,0:21:59.96,0:22:05.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory