Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.11,0:00:16.96,Default,,0,0,0,,｟〓
Dialogue: 0,0:00:16.96,0:00:19.03,Default,,0,0,0,,Шындығында, Марио — Цезардың ер адамға қоятын идеалы еді
Dialogue: 0,0:00:19.03,0:00:22.09,Default,,0,0,0,,〓
Dialogue: 0,0:00:22.09,0:00:24.09,Default,,0,0,0,,Нему〓Қайырлы таң! Жақсы ұйықтадың ба?｠
Dialogue: 0,0:00:39.97,0:00:41.97,Default,,0,0,0,,Бүгін не болады?
Dialogue: 0,0:02:15.49,0:02:19.49,Default,,0,0,0,,Ыкүсенқұманға
Dialogue: 0,0:02:19.49,0:02:22.96,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:02:22.96,0:02:25.97,Default,,0,0,0,,Бірінші күрес дененің шегінен тыс➡
Dialogue: 0,0:02:25.97,0:02:28.49,Default,,0,0,0,,Қалыпты адам болу шегінен тыс➡
Dialogue: 0,0:02:28.49,0:02:32.46,Default,,0,0,0,,Мен өзімді Авангардтың шындығына тап болғандай сезіндім>
Dialogue: 0,0:02:32.46,0:02:34.96,Default,,0,0,0,,Хайоккю<Төбелесуге деген шексіз құштарлық➡
Dialogue: 0,0:02:34.96,0:02:36.99,Default,,0,0,0,,Мен, Мен ➡
Dialogue: 0,0:02:36.99,0:02:39.96,Default,,0,0,0,,Жалғыздық сізді адам еместер әлеміне апарады>
Dialogue: 0,0:02:39.96,0:02:41.97,Default,,0,0,0,,<Бірақ әлі жоқ➡
Dialogue: 0,0:02:41.97,0:02:44.47,Default,,0,0,0,,Мен көбірек...>
Dialogue: 0,0:02:50.46,0:02:53.99,Default,,0,0,0,,Бұл өте ұят~➡
Dialogue: 0,0:02:53.99,0:02:58.00,Default,,0,0,0,,Сіз білесіз бе? Қымбатты Құдай, адамдар құдай бола алмайды.
Dialogue: 0,0:02:58.00,0:03:00.93,Default,,0,0,0,,Мен Такацу Авангардты толық ойнағым келеді.
Dialogue: 0,0:03:00.93,0:03:03.95,Default,,0,0,0,,Міне. Ұнады!➡
Dialogue: 0,0:03:03.95,0:03:06.96,Default,,0,0,0,,Мен келесі жекпе-жекті асыға күтемін.
Dialogue: 0,0:03:06.96,0:03:08.94,Default,,0,0,0,,Un?
Dialogue: 0,0:03:08.94,0:03:11.50,Default,,0,0,0,,Кизумичирун да байқады, солай ма?➡
Dialogue: 0,0:03:11.50,0:03:14.97,Default,,0,0,0,,Бұл бала тек шикі тас емес.
Dialogue: 0,0:03:14.97,0:03:16.98,Default,,0,0,0,,Миодо Акина➡
Dialogue: 0,0:03:16.98,0:03:19.95,Default,,0,0,0,,Мен мұндай жанды бірінші рет көруім.
Dialogue: 0,0:03:19.95,0:03:21.95,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,0:03:25.53,0:03:27.49,Default,,0,0,0,,｟Соңында➡
Dialogue: 0,0:03:27.49,0:03:27.50,Default,,0,0,0,,Такато Хазамата мен Мичиру Маваримамен күресетін уақыт келді. ｟Соңында➡
Dialogue: 0,0:03:27.50,0:03:30.00,Default,,0,0,0,,Такатака Хазамата мен Мичиру Маваримамен күресетін уақыт келді.
Dialogue: 0,0:03:30.00,0:03:32.53,Default,,0,0,0,,Кесшосусу Эрика да финалға өтті.
Dialogue: 0,0:03:32.53,0:03:35.03,Default,,0,0,0,,Мен де финалға барамын!｠
Dialogue: 0,0:03:36.02,0:03:38.94,Default,,0,0,0,,｟E? Мичиру-сан...
Dialogue: 0,0:03:38.94,0:03:41.46,Default,,0,0,0,,Маетатакахай...бұрын ұрысқанбыз ғой?
Dialogue: 0,0:03:41.46,0:03:43.99,Default,,0,0,0,,Сіз қандай адамсыз?
Dialogue: 0,0:03:43.99,0:03:47.97,Default,,0,0,0,,Менің ойымша, бұл Авангардты бәрінен де жақсы көретін адам...
Dialogue: 0,0:03:47.97,0:03:50.98,Default,,0,0,0,,Мен Ай Авангардты жақсы көремін...
Dialogue: 0,0:03:50.98,0:03:50.99,Default,,0,0,0,,Әлем Мичиру-санды ең күшті деп атайды, бірақ ➡ Мен Ай Авангардты жақсы көремін...
Dialogue: 0,0:03:50.99,0:03:53.99,Default,,0,0,0,,Әлем Мичируді ең күшті деп атайды, бірақ➡
Dialogue: 0,0:03:53.99,0:03:57.96,Default,,0,0,0,,Мичиру Хонниннің өзі Авангардтың алыс биігіне барады➡
Dialogue: 0,0:03:57.96,0:04:00.96,Default,,0,0,0,,Мен жай ғана тік қолымды соза беремін➡
Dialogue: 0,0:04:00.96,0:04:03.00,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:04:03.00,0:04:06.95,Default,,0,0,0,,Бұл таңқаларлық. Себебі ол сондай адам ➡
Dialogue: 0,0:04:06.95,0:04:09.94,Default,,0,0,0,,Маған басқаларға қарағанда Cardfight ұнайды➡
Dialogue: 0,0:04:09.94,0:04:12.46,Default,,0,0,0,,Зенрёку Акина-сан да бар күшімен соққы жасады➡
Dialogue: 0,0:04:12.46,0:04:14.53,Default,,0,0,0,,Соңына дейін ләззат алыңыз!
Dialogue: 0,0:04:14.53,0:04:17.53,Default,,0,0,0,,Менің айта алатыным осы ғана.｠
Dialogue: 0,0:04:18.95,0:04:20.96,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе...!
Dialogue: 0,0:04:20.96,0:04:20.97,Default,,0,0,0,,Дешима Сононың шәкірті! Мені күтіңіз~. Мен барымды саламын...!
Dialogue: 0,0:04:20.97,0:04:23.95,Default,,0,0,0,,Дешимасо шәкірті! Мені күтіңіз~
Dialogue: 0,0:04:23.95,0:04:25.95,Default,,0,0,0,,Сенпай Нао-сенпай?
Dialogue: 0,0:04:25.95,0:04:27.96,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:27.96,0:04:30.46,Default,,0,0,0,,Kouhai haa… Unstoppable Junior➡-ға
Dialogue: 0,0:04:30.46,0:04:33.96,Default,,0,0,0,,Мен айтуды ұмытып кеткен бір нәрсе бар...
Dialogue: 0,0:04:33.96,0:04:36.95,Default,,0,0,0,,Кун Аки-кун, егер ол сен болсаң➡
Dialogue: 0,0:04:36.95,0:04:38.97,Default,,0,0,0,,Мен жеңетінімізге сенемін!
Dialogue: 0,0:04:38.97,0:04:40.95,Default,,0,0,0,,Мичиру Хазамата Охомакиді жеңіңіз!
Dialogue: 0,0:04:40.95,0:04:43.45,Default,,0,0,0,,А…
Dialogue: 0,0:04:43.45,0:04:45.95,Default,,0,0,0,,Таохай...сені құлатамын!
Dialogue: 0,0:04:47.99,0:04:51.48,Default,,0,0,0,,Келіңдер, балалар~! Үлкен шайқастың екінші жартылай финалы ➡
Dialogue: 0,0:04:51.48,0:04:54.97,Default,,0,0,0,,Бұл да… Катсуай!➡
Dialogue: 0,0:04:54.97,0:04:58.97,Default,,0,0,0,,Медамами мен Эйедаманың көздеріне қарайық!
Dialogue: 0,0:05:02.99,0:05:06.46,Default,,0,0,0,,Шинобу-чанның да таңғаларлық сүйкімді жағы бар~
Dialogue: 0,0:05:06.46,0:05:08.46,Default,,0,0,0,,Шулы!➡
Dialogue: 0,0:05:08.46,0:05:10.96,Default,,0,0,0,,Бұл жақын жерде болды!
Dialogue: 0,0:05:10.96,0:05:10.97,Default,,0,0,0,,Уау, бұл Масанори! Бұл жай ғана жақын жерде болды!
Dialogue: 0,0:05:10.97,0:05:12.95,Default,,0,0,0,,Уау, бұл Масанори!
Dialogue: 0,0:05:12.95,0:05:15.49,Default,,0,0,0,,Арара~!➡
Dialogue: 0,0:05:15.49,0:05:19.96,Default,,0,0,0,,Кайгай Охиса~! Сіз шетелден келгенсіз.
Dialogue: 0,0:05:19.96,0:05:22.96,Default,,0,0,0,,Мен алдын ала сында Мичирудан жеңіліп қалдым➡
Dialogue: 0,0:05:22.96,0:05:24.95,Default,,0,0,0,,Мен Митодо жекпе-жегін көруге келдім➡
Dialogue: 0,0:05:24.95,0:05:27.48,Default,,0,0,0,,Мен де Асоякусоку Урарамен ойнауға уәде бердім!
Dialogue: 0,0:05:27.48,0:05:30.50,Default,,0,0,0,,Мичиру Хазама Маварима киберәлемнен оралады (Софи) ➡
Dialogue: 0,0:05:30.50,0:05:33.45,Default,,0,0,0,,Джицуриёкуми бұрынғыдан да шебер болды➡
Dialogue: 0,0:05:33.45,0:05:35.46,Default,,0,0,0,,Бүгін сізді қызықтырады, солай ма?
Dialogue: 0,0:05:35.46,0:05:37.46,Default,,0,0,0,,Жоқ деп айт! Ол рас➡
Dialogue: 0,0:05:37.46,0:05:39.46,Default,,0,0,0,,Райка-чанды көруге келмедің бе?
Dialogue: 0,0:05:39.46,0:05:41.46,Default,,0,0,0,,Хэхе➡
Dialogue: 0,0:05:41.46,0:05:43.45,Default,,0,0,0,,Мен бүгін ол итке қызықпаймын➡
Dialogue: 0,0:05:43.45,0:05:45.97,Default,,0,0,0,,Жеңілгеннің айқайын тыңдау
Dialogue: 0,0:05:45.97,0:05:47.95,Default,,0,0,0,,Жаман емес
Dialogue: 0,0:05:47.95,0:05:49.95,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:05:49.95,0:05:51.94,Default,,0,0,0,,Ендеше шық!➡
Dialogue: 0,0:05:51.94,0:05:53.96,Default,,0,0,0,,Бұл турнир әлі жеңілмеген!➡
Dialogue: 0,0:05:53.96,0:05:57.46,Default,,0,0,0,,Бүгінгі күннің ең мықты жауынгері Мичиру Маварима!➡
Dialogue: 0,0:05:57.46,0:06:00.96,Default,,0,0,0,,Бүгінгі күннің ғажайыбын қабылдап, ең мықты болуға шақырыңыз!➡
Dialogue: 0,0:06:00.96,0:06:00.97,Default,,0,0,0,,Myodo Miracle Boy Akina Meido~! Бүгінгі күннің ғажайыбын қабылдаңыз және ең мықты болуға шақырыңыз!➡
Dialogue: 0,0:06:00.97,0:06:03.96,Default,,0,0,0,,Myodo Miracle Boy Akina Meido~!
Dialogue: 0,0:06:06.45,0:06:08.46,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:08.46,0:06:11.44,Default,,0,0,0,,Мен жекпе-жекті асыға күттім.
Dialogue: 0,0:06:11.44,0:06:14.44,Default,,0,0,0,,Бүгін мен сені жеңу үшін келдім➡
Dialogue: 0,0:06:14.44,0:06:16.46,Default,,0,0,0,,Хазама Маварима-сан!
Dialogue: 0,0:06:16.46,0:06:18.50,Default,,0,0,0,,Фу... Мичиру жақсы.
Dialogue: 0,0:06:18.50,0:06:21.43,Default,,0,0,0,,Ах... Мен де сені жеңу үшін келдім➡
Dialogue: 0,0:06:21.44,0:06:24.45,Default,,0,0,0,,Миоду Акина Мейдомен күресейік
Dialogue: 0,0:06:24.45,0:06:24.46,Default,,0,0,0,,Сәлем Мичиру-сан! Миоду Акина Мейдомен күресейік
Dialogue: 0,0:06:24.46,0:06:27.11,Default,,0,0,0,,Сәлем Мичиру-сан!
Dialogue: 0,0:06:27.11,0:06:29.96,Default,,0,0,0,,Танысайық, сосын екінші жартылай финалдық ойын!➡
Dialogue: 0,0:06:29.96,0:06:31.96,Default,,0,0,0,,Фай!
Dialogue: 0,0:06:35.97,0:06:38.45,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:06:38.45,0:06:40.94,Default,,0,0,0,,Jewelius Dracokid Glow
Dialogue: 0,0:06:40.94,0:06:43.46,Default,,0,0,0,,Taibou Tsubasa Wings of Ambition Soel!
Dialogue: 0,0:06:43.46,0:06:45.44,Default,,0,0,0,,Менің кезегім
Dialogue: 0,0:06:45.44,0:06:47.96,Default,,0,0,0,,Зергерлік өзекке міну... бұрылыс ұшы
Dialogue: 0,0:06:47.96,0:06:49.96,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:06:49.96,0:06:52.97,Default,,0,0,0,,Бентестаға мініңіз...Шабуыл!
Dialogue: 0,0:06:52.97,0:06:54.94,Default,,0,0,0,,Күзетші жоқ
Dialogue: 0,0:06:54.94,0:06:56.95,Default,,0,0,0,,Бұрылудың соңы. Менің кезегім
Dialogue: 0,0:06:56.95,0:06:58.94,Default,,0,0,0,,Зергер Нилге міну➡
Dialogue: 0,0:06:58.94,0:07:00.96,Default,,0,0,0,,Май Форкаролдың 2 данасын шақырыңыз ➡
Dialogue: 0,0:07:00.96,0:07:02.96,Default,,0,0,0,,Форкаролмен шабуыл
Dialogue: 0,0:07:02.96,0:07:05.45,Default,,0,0,0,,Күзетші! Зергер Нилмен шабуыл
Dialogue: 0,0:07:05.45,0:07:07.46,Default,,0,0,0,,Күзетші жоқ
Dialogue: 0,0:07:07.46,0:07:09.47,Default,,0,0,0,,Шабуыл. Күзетші
Dialogue: 0,0:07:09.47,0:07:11.44,Default,,0,0,0,,Бұрылудың соңы
Dialogue: 0,0:07:11.44,0:07:13.95,Default,,0,0,0,,Мичиру-сан 3 рет шабуыл жасайды...
Dialogue: 0,0:07:13.95,0:07:15.96,Default,,0,0,0,,Ол қырылып тасталады...
Dialogue: 0,0:07:15.96,0:07:17.94,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:07:17.94,0:07:19.94,Default,,0,0,0,,Азенсиорға бару➡
Dialogue: 0,0:07:19.94,0:07:21.96,Default,,0,0,0,,Жан Вентесаға қоңырау шалыңыз!
Dialogue: 0,0:07:21.96,0:07:23.96,Default,,0,0,0,,My Impervious➡ 2 данасын шақырыңыз
Dialogue: 0,0:07:23.96,0:07:26.45,Default,,0,0,0,,Айдаһардың қанаттары мен рельеф қанаты, Соэл➡
Dialogue: 0,0:07:26.45,0:07:28.44,Default,,0,0,0,,Қоңырау шалыңыз!
Dialogue: 0,0:07:28.44,0:07:30.45,Default,,0,0,0,,Соел?
Dialogue: 0,0:07:30.45,0:07:32.49,Default,,0,0,0,,Азенсиормен шабуыл!
Dialogue: 0,0:07:32.49,0:07:34.96,Default,,0,0,0,,Күзетші. Импервиуспен шабуыл жасаңыз!
Dialogue: 0,0:07:34.96,0:07:37.46,Default,,0,0,0,,Күзетші жоқ. Шабуыл!
Dialogue: 0,0:07:37.46,0:07:39.50,Default,,0,0,0,,Күзетші жоқ
Dialogue: 0,0:07:39.50,0:07:41.97,Default,,0,0,0,,Бұрылудың соңы. Сіздің жаныңыз ➡
Dialogue: 0,0:07:41.97,0:07:43.97,Default,,0,0,0,,Шынымен де, таң қалдырады
Dialogue: 0,0:07:43.97,0:07:46.45,Default,,0,0,0,,Бұл жан ма...?
Dialogue: 0,0:07:46.45,0:07:48.46,Default,,0,0,0,,Ум!
Dialogue: 0,0:07:48.46,0:07:50.96,Default,,0,0,0,,Жарық жарқырап, әдемі.
Dialogue: 0,0:07:50.96,0:07:52.96,Default,,0,0,0,,Және➡
Dialogue: 0,0:07:52.96,0:07:56.46,Default,,0,0,0,,Бұл еш ойланбайтын тікелей Авангард.
Dialogue: 0,0:07:56.46,0:07:58.47,Default,,0,0,0,,А…
Dialogue: 0,0:07:58.47,0:08:00.98,Default,,0,0,0,,Мичиру Даре басқаларға қарағанда қарапайым➡
Dialogue: 0,0:08:00.98,0:08:03.45,Default,,0,0,0,,Мен Муахито Авангардпен бетпе-бет келген адамдар бар деп естідім.
Dialogue: 0,0:08:03.45,0:08:05.46,Default,,0,0,0,,А... Меніңше, солай ма?
Dialogue: 0,0:08:05.46,0:08:07.49,Default,,0,0,0,,Айтыңызшы!➡
Dialogue: 0,0:08:07.49,0:08:10.96,Default,,0,0,0,,Авангард сіз үшін нені білдіреді, Мичиру?
Dialogue: 0,0:08:10.96,0:08:12.96,Default,,0,0,0,,А…
Dialogue: 0,0:08:12.96,0:08:15.47,Default,,0,0,0,,Мен үшін Авангард – ➡
Dialogue: 0,0:08:15.47,0:08:18.45,Default,,0,0,0,,Мен туралы барлығы
Dialogue: 0,0:08:18.45,0:08:21.46,Default,,0,0,0,,А...!Менің кезегім
