Dialogue: 0,0:15:03.96,0:15:05.97,Default,,0,0,0,,Әрі қарай сақ болыңыз!
Dialogue: 0,0:15:05.97,0:15:07.97,Default,,0,0,0,,Кесу!
Dialogue: 0,0:15:10.95,0:15:12.96,Default,,0,0,0,,Soel…
Dialogue: 0,0:15:12.96,0:15:14.96,Default,,0,0,0,,Soel бұл➡
Dialogue: 0,0:15:14.96,0:15:17.96,Default,,0,0,0,,Бұл мен үшін маңызды бірлік.
Dialogue: 0,0:15:17.96,0:15:19.96,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:19.96,0:15:22.97,Default,,0,0,0,,Ұнады! Twin Drive➡
Dialogue: 0,0:15:22.97,0:15:24.98,Default,,0,0,0,,Жылдам тексеру➡
Dialogue: 0,0:15:24.98,0:15:24.99,Default,,0,0,0,,Draw Trigger Ravena Jada Пауэр Plus 10000➡ Жылдам тексеру➡
Dialogue: 0,0:15:24.99,0:15:28.44,Default,,0,0,0,,Ravena Jada Пауэр Plus 10000➡ триггерін тарту
Dialogue: 0,0:15:28.44,0:15:30.46,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:15:30.46,0:15:32.46,Default,,0,0,0,,Триггер жоқ
Dialogue: 0,0:15:32.46,0:15:34.46,Default,,0,0,0,,Фусеши! Алдын алды
Dialogue: 0,0:15:34.46,0:15:36.46,Default,,0,0,0,,Әлі жоқ➡
Dialogue: 0,0:15:36.46,0:15:38.46,Default,,0,0,0,,Равенажадамен шабуыл
Dialogue: 0,0:15:38.46,0:15:40.97,Default,,0,0,0,,Атадора зергерге берілген шеберліктің арқасында➡
Dialogue: 0,0:15:40.97,0:15:42.95,Default,,0,0,0,,Қосымша диск тексерулерін орындаңыз
Dialogue: 0,0:15:42.95,0:15:45.44,Default,,0,0,0,,Толығымен қорғалған!
Dialogue: 0,0:15:45.44,0:15:47.49,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:15:47.49,0:15:50.46,Default,,0,0,0,,Критикалық триггер Ридос Агурдың Пауэр Plus 10000➡
Dialogue: 0,0:15:50.46,0:15:52.46,Default,,0,0,0,,Сыни плюс 1
Dialogue: 0,0:15:52.46,0:15:54.96,Default,,0,0,0,,Ридос Агулмен шабуыл
Dialogue: 0,0:15:54.96,0:15:54.97,Default,,0,0,0,,Тағы да толықтай сақ болыңыз! Ридос Агулмен шабуыл
Dialogue: 0,0:15:54.97,0:15:57.97,Default,,0,0,0,,Тағы да толықтай күзет!
Dialogue: 0,0:15:57.97,0:15:59.95,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:15:59.95,0:16:01.96,Default,,0,0,0,,Бұрылыс ұшы
Dialogue: 0,0:16:01.96,0:16:03.96,Default,,0,0,0,,Коугеки Мичирудың шабуылы...
Dialogue: 0,0:16:03.96,0:16:05.94,Default,,0,0,0,,Ісінудің алдын алды!
Dialogue: 0,0:16:05.94,0:16:07.96,Default,,0,0,0,,Ku~! Жасайық~
Dialogue: 0,0:16:07.96,0:16:09.95,Default,,0,0,0,,Акина-сан...
Dialogue: 0,0:16:09.95,0:16:12.00,Default,,0,0,0,,Басынан➡
Dialogue: 0,0:16:12.00,0:16:14.62,Default,,0,0,0,,Бар күшімді алуға ниет еттім.
Dialogue: 0,0:16:14.62,0:16:17.99,Default,,0,0,0,,Нилберис➡ көмегімен құдайдың шеберлігін растау
Dialogue: 0,0:16:17.99,0:16:20.99,Default,,0,0,0,,Жақын су өткізбейтін➡ қалқан мәнін бекіту
Dialogue: 0,0:16:20.99,0:16:24.49,Default,,0,0,0,,Цукаджошо мен...Соэлдің көмегімен қуатты арттыру
Dialogue: 0,0:16:25.96,0:16:29.50,Default,,0,0,0,,Барлығы осы бұрылыс үшін болды.
Dialogue: 0,0:16:29.50,0:16:32.45,Default,,0,0,0,,Кеше Юйю Кондомен соғысқаннан кейін➡
Dialogue: 0,0:16:32.45,0:16:34.45,Default,,0,0,0,,Мен солай ойладым.Хехе~➡
Dialogue: 0,0:16:34.45,0:16:37.46,Default,,0,0,0,,Кондо Юйю Кондомен бірге? Сәлем!
Dialogue: 0,0:16:37.46,0:16:39.46,Default,,0,0,0,,Кәдімгі қолдар мен кесулерден басқа➡
Dialogue: 0,0:16:39.46,0:16:41.95,Default,,0,0,0,,Қорғаныс үшін пайдалануға болатын карталар бар➡
Dialogue: 0,0:16:41.95,0:16:44.00,Default,,0,0,0,,Егер сіз осы заттардың барлығын қолдансаңыз➡
Dialogue: 0,0:16:44.00,0:16:47.47,Default,,0,0,0,,Менің ойымша, ол Коугеки Дораджуэлдтің шабуылдарына өте жақсы қарсы тұра алады.
Dialogue: 0,0:16:47.47,0:16:49.47,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:16:52.96,0:16:54.94,Default,,0,0,0,,Сіз шынымен де шынайысыз➡
Dialogue: 0,0:16:54.94,0:16:57.46,Default,,0,0,0,,Сізге карта ойыны ұнай ма?
Dialogue: 0,0:16:57.46,0:17:00.00,Default,,0,0,0,,Бұл қызық!
Dialogue: 0,0:17:00.00,0:17:02.48,Default,,0,0,0,,Канандоши Косакуды жеңу үшін біз көп рет қателесуіміз керек ➡
Dialogue: 0,0:17:02.48,0:17:05.45,Default,,0,0,0,,Жекпе-жек алдында палубаны ойлап көріңіз➡
Dialogue: 0,0:17:05.45,0:17:07.49,Default,,0,0,0,,Тамеқан талпынады, ойланады
Dialogue: 0,0:17:07.49,0:17:10.96,Default,,0,0,0,,Чука Хинака жекпе-жегі кезінде де өз ойыныңызды іштей ойлаңыз.
Dialogue: 0,0:17:10.96,0:17:13.99,Default,,0,0,0,,Бұл туралы ойлану қызық!
Dialogue: 0,0:17:13.99,0:17:16.46,Default,,0,0,0,,Сәтсіздік пен сәттіліктің мәңгілік қозғалыс машинасы!
Dialogue: 0,0:17:16.46,0:17:18.97,Default,,0,0,0,,Сондықтан мен карта ойынын тоқтата алмаймын!
Dialogue: 0,0:17:18.97,0:17:20.97,Default,,0,0,0,,Сенпай Нао-сенпайдың айтқаны➡
Dialogue: 0,0:17:20.97,0:17:23.45,Default,,0,0,0,,Мен қазір бәрін түсінемін!
Dialogue: 0,0:17:23.45,0:17:26.94,Default,,0,0,0,,Карточка төбелестері өте қызықты!
Dialogue: 0,0:17:26.94,0:17:28.94,Default,,0,0,0,,Кун Аки…
Dialogue: 0,0:17:34.46,0:17:36.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:42.46,0:17:44.96,Default,,0,0,0,,Күресуге деген шексіз құштарлық...
Dialogue: 0,0:17:44.96,0:17:46.99,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:17:46.99,0:17:49.96,Default,,0,0,0,,Жан дүниеңнің неліктен тамсанғанын түсіндім.
Dialogue: 0,0:17:49.96,0:17:51.97,Default,,0,0,0,,E?
Dialogue: 0,0:17:51.97,0:17:54.45,Default,,0,0,0,,Үнемі толып жатыр сенен➡
Dialogue: 0,0:17:54.45,0:17:57.45,Default,,0,0,0,,Таноки де жекпе-жектен ләззат алады.
Dialogue: 0,0:17:57.45,0:17:59.46,Default,,0,0,0,,Ұрыс...
Dialogue: 0,0:17:59.46,0:18:01.49,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:18:01.49,0:18:04.44,Default,,0,0,0,,Алдымен бұл қажеттіліктен болды.
Dialogue: 0,0:18:04.44,0:18:06.50,Default,,0,0,0,,Бірақ...!
Dialogue: 0,0:18:06.50,0:18:09.50,Default,,0,0,0,,Мен Авангардты жақсы көремін!
Dialogue: 0,0:18:14.95,0:18:17.46,Default,,0,0,0,,Мен хехе... Мен де.
Dialogue: 0,0:18:17.46,0:18:19.49,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:18:19.49,0:18:21.96,Default,,0,0,0,,Біз бір-бірімізден ұтыла алмаймыз.Хай!
Dialogue: 0,0:18:21.96,0:18:25.47,Default,,0,0,0,,Мен сені жеңгім келеді!
Dialogue: 0,0:18:25.47,0:18:27.98,Default,,0,0,0,,Менің кезегім
Dialogue: 0,0:18:27.98,0:18:30.45,Default,,0,0,0,,Тағдырдың саған тілегі, Байлау патша➡
Dialogue: 0,0:18:30.45,0:18:34.46,Default,,0,0,0,,Өмірге ақ қанатыңмен жол көрсет!
Dialogue: 0,0:18:34.46,0:18:36.46,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:18:39.50,0:18:42.00,Default,,0,0,0,,Тағдырдың ғажайып патшасы Резаэль Вита!
Dialogue: 0,0:18:43.95,0:18:45.95,Default,,0,0,0,,Нилберис Соелге қоңырау шалыңыз!
Dialogue: 0,0:18:45.95,0:18:47.95,Default,,0,0,0,,Нилбериспен шабуыл!
Dialogue: 0,0:18:47.95,0:18:50.46,Default,,0,0,0,,Күзетші. Соелмен шабуыл жасаңыз!
Dialogue: 0,0:18:50.46,0:18:52.46,Default,,0,0,0,,Күзетші
Dialogue: 0,0:18:52.46,0:18:55.46,Default,,0,0,0,,Резаэль Витамен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:55.46,0:18:58.46,Default,,0,0,0,,Саблс пен Рифисторды шеберлікпен шақырыңыз➡
Dialogue: 0,0:18:58.46,0:19:00.97,Default,,0,0,0,,Алдыңғы қатардың қуаты плюс 5000!
Dialogue: 0,0:19:00.97,0:19:02.97,Default,,0,0,0,,Күзетші жоқ
Dialogue: 0,0:19:02.97,0:19:05.96,Default,,0,0,0,,Мичиру-сан шабуылдаса да, оның қолы жіңішке.
Dialogue: 0,0:19:05.96,0:19:07.96,Default,,0,0,0,,Уэкоконың оны қабылдаудан басқа амалы жоқ.
Dialogue: 0,0:19:07.96,0:19:10.96,Default,,0,0,0,,Кунку Акина-кун, сен осы уақытқа дейін жеттің.
Dialogue: 0,0:19:10.96,0:19:12.96,Default,,0,0,0,,Тағы бір итеру жеткіліксіз
Dialogue: 0,0:19:12.96,0:19:14.96,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:19:14.96,0:19:17.47,Default,,0,0,0,,-де сыни соққы алғанша...!
Dialogue: 0,0:19:17.47,0:19:19.45,Default,,0,0,0,,Тіпті аз мөлшердегі жарық➡
Dialogue: 0,0:19:19.45,0:19:21.95,Default,,0,0,0,,Тек қолын созғандарға➡
Dialogue: 0,0:19:21.95,0:19:21.96,Default,,0,0,0,,Кисекимао Ғажайыптар түседі! Тек қолын созғандарға➡
Dialogue: 0,0:19:21.96,0:19:24.46,Default,,0,0,0,,Кисекимао кереметі төмендейді!
Dialogue: 0,0:19:24.46,0:19:27.46,Default,,0,0,0,,Келіңіздер! Барайық!
Dialogue: 0,0:19:41.94,0:19:43.94,Default,,0,0,0,,Көлікті тексеру!
Dialogue: 0,0:19:45.46,0:19:47.95,Default,,0,0,0,,Критикалық триггерді алыңыз!
Dialogue: 0,0:19:47.95,0:19:50.45,Default,,0,0,0,,Резаэльдің сыншылдығы ➡
Dialogue: 0,0:19:50.45,0:19:52.45,Default,,0,0,0,,Plus 1!
Dialogue: 0,0:19:55.96,0:19:58.46,Default,,0,0,0,,Шынымен... шынымен➡
Dialogue: 0,0:19:58.46,0:20:00.46,Default,,0,0,0,,Қызықты.
Dialogue: 0,0:20:07.97,0:20:09.95,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:20:09.95,0:20:12.96,Default,,0,0,0,,Сіз жеңдіңіз, Акина Мейдо.
Dialogue: 0,0:20:12.96,0:20:15.46,Default,,0,0,0,,А…
Dialogue: 0,0:20:15.46,0:20:17.46,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:18.96,0:20:20.96,Default,,0,0,0,,Жеңімпаз➡
Dialogue: 0,0:20:20.96,0:20:23.95,Default,,0,0,0,,Миодо Акина~!
Dialogue: 0,0:20:23.95,0:20:25.95,Default,,0,0,0,,Кансей (қуаныш)
Dialogue: 0,0:20:25.95,0:20:27.95,Default,,0,0,0,,Йоша!
Dialogue: 0,0:20:27.95,0:20:30.96,Default,,0,0,0,,Үлкен аға! Уау, өте жақсы!
Dialogue: 0,0:20:30.96,0:20:33.96,Default,,0,0,0,,Сен істедің... Акина-сан!
Dialogue: 0,0:20:33.96,0:20:36.96,Default,,0,0,0,,Мичиру шынымен ән айту... бұл өте қызық сияқты
Dialogue: 0,0:20:36.96,0:20:40.53,Default,,0,0,0,,Маған Vanguard өте ұнайды!
Dialogue: 0,0:20:40.53,0:20:43.45,Default,,0,0,0,,Юушоми, сенің жеңгеніңді көргім келді➡
Dialogue: 0,0:20:43.45,0:20:45.96,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:45.96,0:20:47.96,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:20:47.96,0:20:50.53,Default,,0,0,0,,Дүние қалай болып жатыр? Шынайы әлем де➡
Dialogue: 0,0:20:50.53,0:20:53.50,Default,,0,0,0,,Сен оны әлі лақтырған жоқсың... Мичиру
Dialogue: 0,0:20:53.50,0:20:57.50,Default,,0,0,0,,Сіз шынымен керемет жасадыңыз!➡
Dialogue: 0,0:20:57.50,0:21:01.00,Default,,0,0,0,,Миодо Кесшо Сеншин Шуцу Мейдо Акина финалға шықты~!
Dialogue: 0,0:21:02.02,0:21:03.94,Default,,0,0,0,,Кун｟Сен кереметсің, Аки-кун➡
Dialogue: 0,0:21:03.94,0:21:07.03,Default,,0,0,0,,Егер сіз Созоко болсаңыз...бұл әркімнің қиялынан тыс➡
Dialogue: 0,0:21:07.03,0:21:09.96,Default,,0,0,0,,Сіз ең жақсы жауынгер бола аласыз.｠
Dialogue: 0,0:21:09.96,0:21:12.47,Default,,0,0,0,,Мен де жеңілмеймін!
Dialogue: 0,0:21:12.47,0:21:14.47,Default,,0,0,0,,Не қорқынышты? Мен қорқып тұрмын.
Dialogue: 0,0:21:15.43,0:21:17.93,Default,,0,0,0,,Болашақ осында
Dialogue: 0,0:21:18.96,0:21:20.96,Default,,0,0,0,,Тағы да ұрысайық
Dialogue: 0,0:21:20.96,0:21:22.99,Default,,0,0,0,,А…
Dialogue: 0,0:21:22.99,0:21:24.99,Default,,0,0,0,,Иә, әрине!
Dialogue: 0,0:21:27.95,0:21:30.97,Default,,0,0,0,,Кансей (қуаныш)
Dialogue: 0,0:21:30.97,0:21:33.97,Default,,0,0,0,,Цюйо керемет... тым күшті! Акина
Dialogue: 0,0:21:40.99,0:21:43.49,Default,,0,0,0,,Біз Миодо Кесшосен (Мейдо Терумицу) финалына жеткен сияқтымыз.
Dialogue: 0,0:21:51.95,0:21:53.96,Default,,0,0,0,,Көптен бері көрмегелі...
Dialogue: 0,0:21:53.96,0:21:55.96,Default,,0,0,0,,Бауырлар ұрысып жатыр!
Dialogue: 0,0:21:57.46,0:22:03.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory