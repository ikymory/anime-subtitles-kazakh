Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.26,0:00:16.93,Default,,0,0,0,,(цикада дыбысы)
Dialogue: 0,0:00:18.93,0:00:23.52,Default,,0,0,0,,(Шие) Аоцута тұрғын үй кешені Біз 305
Dialogue: 0,0:00:24.23,0:00:29.15,Default,,0,0,0,,Көк даланың үстінде аспанда қалқып тұрған күн
Dialogue: 0,0:00:35.78,0:00:41.16,Default,,0,0,0,,(Шие) Судың бетінде қалдыратын толқындар ма?
Dialogue: 0,0:00:44.62,0:00:49.84,Default,,0,0,0,,Жазғы киімдер күріш алқабынан ерекшеленетін жергілікті жер ме?
Dialogue: 0,0:00:59.43,0:01:03.56,Default,,0,0,0,,Хмм…
Dialogue: 0,0:01:07.31,0:01:08.48,Default,,0,0,0,,Хм! ‬
Dialogue: 0,0:01:08.56,0:01:12.07,Default,,0,0,0,,Хмм…
Dialogue: 0,0:01:18.74,0:01:19.74,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:01:23.87,0:01:24.95,Default,,0,0,0,,(Мари Юри) Иә? ‬
Dialogue: 0,0:01:40.80,0:01:41.89,Default,,0,0,0,,Хехехе
Dialogue: 0,0:01:42.39,0:01:44.64,Default,,0,0,0,,Мен үшін күлімде! ‬
Dialogue: 0,0:01:45.35,0:01:50.36,Default,,0,0,0,,♪～
Dialogue: 0,0:03:15.73,0:03:19.65,Default,,0,0,0,,～♪
Dialogue: 0,0:03:20.57,0:03:23.62,Default,,0,0,0,,(Бауырсақ қанатының дыбысы)
Dialogue: 0,0:03:23.70,0:03:24.91,Default,,0,0,0,,(Шие) Ах.
Dialogue: 0,0:03:26.66,0:03:27.99,Default,,0,0,0,,(Кенет тежеу ​​дыбысы) (Шие) Уа! ‬
Dialogue: 0,0:03:30.91,0:03:34.04,Default,,0,0,0,,Хмм…
Dialogue: 0,0:03:34.13,0:03:35.84,Default,,0,0,0,,(Шиенің жүгірген тынысы)
Dialogue: 0,0:03:35.92,0:03:37.67,Default,,0,0,0,,(Шие) Фудзияма-сан
Dialogue: 0,0:03:39.71,0:03:41.13,Default,,0,0,0,,Фудзияма мырза
Dialogue: 0,0:03:42.80,0:03:44.59,Default,,0,0,0,,Фудзияма-сан! ‬
Dialogue: 0,0:03:44.68,0:03:48.89,Default,,0,0,0,,(дауыспен) О, Шие бала! ‬
Dialogue: 0,0:03:48.97,0:03:50.23,Default,,0,0,0,,Оны таптыңыз ба? ‬
Dialogue: 0,0:03:50.31,0:03:51.60,Default,,0,0,0,,Хохо
Dialogue: 0,0:03:51.68,0:03:54.60,Default,,0,0,0,,Түсіндім, қайтайық.
Dialogue: 0,0:03:54.69,0:03:55.90,Default,,0,0,0,,Хмм…
Dialogue: 0,0:04:21.46,0:04:23.38,Default,,0,0,0,,(Тіс дәрігері) Иә, «Е» деп айтыңыз.
Dialogue: 0,0:04:23.47,0:04:24.38,Default,,0,0,0,,Е
Dialogue: 0,0:04:24.47,0:04:26.14,Default,,0,0,0,,(Тіс дәрігері) Оны ашыңыз.
Dialogue: 0,0:04:26.22,0:04:27.85,Default,,0,0,0,,(Тіс дәрігері) E жабыңыз
Dialogue: 0,0:04:27.93,0:04:29.47,Default,,0,0,0,,(Тіс дәрігері) Өзіңізді жайсыз сезінесіз бе? ‬
Dialogue: 0,0:04:29.56,0:04:30.39,Default,,0,0,0,,Иә
Dialogue: 0,0:04:30.47,0:04:32.27,Default,,0,0,0,,(Тіс дәрігері) Бүгінгі күні осы.
Dialogue: 0,0:04:32.35,0:04:34.02,Default,,0,0,0,,Маған тісімді тазалау қиынға соғады.
Dialogue: 0,0:04:34.10,0:04:37.48,Default,,0,0,0,,Мұндай жағдайларда дезинфекциялық ерітіндімен жиі шайыңыз.
Dialogue: 0,0:04:37.56,0:04:38.40,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:39.19,0:04:41.90,Default,,0,0,0,,(Тіс дәрігері) Келесі кезекті тексеруде кездескенше.
Dialogue: 0,0:04:42.49,0:04:43.86,Default,,0,0,0,,(Қабылдау) Сау болыңыз
Dialogue: 0,0:04:56.29,0:04:58.67,Default,,0,0,0,,Мм... Мм...
Dialogue: 0,0:04:59.71,0:05:01.09,Default,,0,0,0,,Жақсы! ‬
Dialogue: 0,0:05:07.55,0:05:09.76,Default,,0,0,0,,Бәрің мені ести аласыңдар ма?
Dialogue: 0,0:05:09.85,0:05:12.68,Default,,0,0,0,,Иә, сіз күнде күлесіз бе?
Dialogue: 0,0:05:12.77,0:05:15.23,Default,,0,0,0,,Барлығының жарқыраған пұт әпкелері
Dialogue: 0,0:05:15.31,0:05:18.31,Default,,0,0,0,,Қызғылт сары күн сәулесі
Dialogue: 0,0:05:18.40,0:05:20.69,Default,,0,0,0,,Мен үшін күлімде!
Dialogue: 0,0:05:21.90,0:05:24.82,Default,,0,0,0,,Уау, ``Бұл жақсы.'' Бұл өте көп!
Dialogue: 0,0:05:24.90,0:05:27.20,Default,,0,0,0,,Әдеттегідей барлығыңызға рахмет.
Dialogue: 0,0:05:27.28,0:05:29.74,Default,,0,0,0,,Түсініктеме тым ерте
Dialogue: 0,0:05:30.24,0:05:32.12,Default,,0,0,0,,Мен де бүгін сүйкімді нәрсе таптым⸺
Dialogue: 0,0:05:32.20,0:05:33.75,Default,,0,0,0,,Сіздерді таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:05:33.83,0:05:35.41,Default,,0,0,0,,Егер сіз бәрі де сүйкімді деп ойласаңыз
Dialogue: 0,0:05:35.50,0:05:37.21,Default,,0,0,0,,Маған лайк басуыңызды өтінемін.
Dialogue: 0,0:05:37.29,0:05:38.12,Default,,0,0,0,,Айтпақшы⸺
Dialogue: 0,0:05:41.38,0:05:43.71,Default,,0,0,0,,Бүгін жергілікті сауда орталығында
Dialogue: 0,0:05:46.22,0:05:49.30,Default,,0,0,0,,Бұл жазғы демалыс, сондықтан адамдар көп болуы мүмкін.
Dialogue: 0,0:05:53.89,0:05:56.77,Default,,0,0,0,,Бір-біріңе соқтығысып қалмау үшін абай болу керек.
Dialogue: 0,0:05:56.85,0:05:59.23,Default,,0,0,0,,Олай болса бәріміз жиналайық...
Dialogue: 0,0:05:59.31,0:06:02.07,Default,,0,0,0,,Күлімсіре! ‬
Dialogue: 0,0:06:02.98,0:06:04.57,Default,,0,0,0,,А, қараңдар, қараңдар!
Dialogue: 0,0:06:04.65,0:06:07.07,Default,,0,0,0,,Кішкентай сауда автоматы сүйкімді
Dialogue: 0,0:06:07.70,0:06:08.91,Default,,0,0,0,,Арба пойызы
Dialogue: 0,0:06:08.99,0:06:10.82,Default,,0,0,0,,Хикарунның стендиі
Dialogue: 0,0:06:10.91,0:06:12.78,Default,,0,0,0,,Дарума! иә? ‬
Dialogue: 0,0:06:13.45,0:06:16.79,Default,,0,0,0,,Иә? Дарума сүйкімді
Dialogue: 0,0:06:21.38,0:06:24.05,Default,,0,0,0,,(Күзетші) Толып барады, Мотопури мырза.
Dialogue: 0,0:06:24.13,0:06:25.67,Default,,0,0,0,,(бұрынғы пури) Шираи
Dialogue: 0,0:06:26.38,0:06:29.13,Default,,0,0,0,,Жазғы демалысқа байланысты студенттік тұтынушылардың көбеюіне байланысты...
Dialogue: 0,0:06:29.22,0:06:30.18,Default,,0,0,0,,(Бұрынғы Пури/Қауіпсіздік сақшысы) Иә? ‬
Dialogue: 0,0:06:30.26,0:06:31.84,Default,,0,0,0,,(Бұрынғы Пури) Ол қозғалды ма? ‬
Dialogue: 0,0:06:31.93,0:06:33.18,Default,,0,0,0,,(Күзетші) Хикарун? ‬
Dialogue: 0,0:06:33.26,0:06:34.26,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:34.35,0:06:35.18,Default,,0,0,0,,(2 адам) Ах! ‬
Dialogue: 0,0:06:37.89,0:06:39.19,Default,,0,0,0,,Құндыз! ‬
Dialogue: 0,0:06:44.15,0:06:46.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:46.15,0:06:47.40,Default,,0,0,0,,Ах
Dialogue: 0,0:06:47.49,0:06:50.28,Default,,0,0,0,,Бұл тағы да Ска емес пе?
Dialogue: 0,0:06:50.95,0:06:53.07,Default,,0,0,0,,Хикарунның Сиректері Сіз байсалдысыз ба?
Dialogue: 0,0:06:53.16,0:06:54.24,Default,,0,0,0,,(Бала) Эй, бұл менмін! ‬
Dialogue: 0,0:06:54.33,0:06:56.37,Default,,0,0,0,,(Құндыз) Жапон Кун
Dialogue: 0,0:06:56.45,0:06:58.20,Default,,0,0,0,,Иә? Жоқ! ‬
Dialogue: 0,0:06:58.29,0:07:00.87,Default,,0,0,0,,Тотото... Өмірдегідей Хикарун! ‬
Dialogue: 0,0:07:00.96,0:07:02.67,Default,,0,0,0,,Хехехе түсіндім
Dialogue: 0,0:07:02.75,0:07:05.96,Default,,0,0,0,,Бұл ең жақсысы ма?
Dialogue: 0,0:07:06.05,0:07:07.21,Default,,0,0,0,,(Құндыз) Бұл қайтарылмайтын зат емес пе? ‬
Dialogue: 0,0:07:07.30,0:07:08.63,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:07:08.71,0:07:11.63,Default,,0,0,0,,(Күзетші) Эй, сен дүкеннің керек-жарақтарын қайтадан алып шықтың.
Dialogue: 0,0:07:11.72,0:07:14.10,Default,,0,0,0,,(Күзетші) Үлкенге тіл тигізсең, жараласың.
Dialogue: 0,0:07:14.18,0:07:15.01,Default,,0,0,0,,Яббе! ‬
Dialogue: 0,0:07:15.10,0:07:17.10,Default,,0,0,0,,(Күзетші) Ой... кешіріңіз.
Dialogue: 0,0:07:17.60,0:07:19.98,Default,,0,0,0,,(Құндыз) Хехехе (Қауіпсіздік) Мынау! ‬
Dialogue: 0,0:07:20.06,0:07:21.48,Default,,0,0,0,,Ахо! ‬
Dialogue: 0,0:07:22.40,0:07:23.65,Default,,0,0,0,,(Құндыз) Йотто
Dialogue: 0,0:07:25.06,0:07:26.23,Default,,0,0,0,,(Күзетші) Түсіңіз.
Dialogue: 0,0:07:26.32,0:07:28.94,Default,,0,0,0,,(Құндыз) Хе хе хе.
Dialogue: 0,0:07:29.44,0:07:30.49,Default,,0,0,0,,(Күзетші) Уау.
Dialogue: 0,0:07:30.57,0:07:31.61,Default,,0,0,0,,(құндыз) хехехехе
Dialogue: 0,0:07:31.70,0:07:33.57,Default,,0,0,0,,Біраз уақытқа қарызға алайық! ‬
Dialogue: 0,0:07:33.66,0:07:35.62,Default,,0,0,0,,(Тапсырыс беруші) Уау (Құндыз) Хехехе
Dialogue: 0,0:07:36.28,0:07:38.04,Default,,0,0,0,,(Балалар) Уау! Ахаха
Dialogue: 0,0:07:38.12,0:07:39.87,Default,,0,0,0,,(Құндыз) Хооу! (Тұтынушы) Уау!
Dialogue: 0,0:07:42.62,0:07:44.92,Default,,0,0,0,,(Құндыз) Негізгі құпия! ‬
Dialogue: 0,0:07:45.42,0:07:46.75,Default,,0,0,0,,Құндыз! ‬
Dialogue: 0,0:07:46.84,0:07:47.88,Default,,0,0,0,,Бұрынғы пури!?
Dialogue: 0,0:07:47.96,0:07:49.67,Default,,0,0,0,,(Бұрынғы Пури) Эй! (Құндыз) Гах! ‬
Dialogue: 0,0:07:51.47,0:07:52.30,Default,,0,0,0,,(Тұтынушы) О!
Dialogue: 0,0:07:53.80,0:07:55.14,Default,,0,0,0,,(Қонақтар) Уау!
Dialogue: 0,0:07:55.22,0:07:56.22,Default,,0,0,0,,Ой...
Dialogue: 0,0:07:56.30,0:07:58.47,Default,,0,0,0,,(Тұтынушы) Ооо! ‬
Dialogue: 0,0:07:58.56,0:08:01.23,Default,,0,0,0,,(Құндыз) Уау! ‬
Dialogue: 0,0:08:01.31,0:08:03.98,Default,,0,0,0,,Уау Уау...
Dialogue: 0,0:08:04.06,0:08:05.73,Default,,0,0,0,,Кет! ‬
Dialogue: 0,0:08:07.44,0:08:09.32,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:08:10.90,0:08:11.90,Default,,0,0,0,,(Модератор) Келіңіздер! ‬
Dialogue: 0,0:08:11.99,0:08:14.57,Default,,0,0,0,,Ақырында жорғалау жарысы басталады
Dialogue: 0,0:08:14.66,0:08:17.53,Default,,0,0,0,,Орын туралы Жарайды...
Dialogue: 0,0:08:17.62,0:08:19.70,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:08:19.79,0:08:22.79,Default,,0,0,0,,Біз әлі бастаған жоқпыз. А... сәл күте тұрыңыз.
Dialogue: 0,0:08:22.87,0:08:24.62,Default,,0,0,0,,Сәлем, ұшу! ‬
Dialogue: 0,0:08:24.71,0:08:27.79,Default,,0,0,0,,Тіпті ұшу! ‬
Dialogue: 0,0:08:28.38,0:08:30.21,Default,,0,0,0,,F.L.I.N.G.
Dialogue: 0,0:08:30.71,0:08:32.59,Default,,0,0,0,,F.L.I.N.G…
Dialogue: 0,0:08:37.64,0:08:40.97,Default,,0,0,0,,Фу… Фу…
Dialogue: 0,0:08:42.35,0:08:44.19,Default,,0,0,0,,(Қонақтар қолдайды) А? ‬
Dialogue: 0,0:08:45.39,0:08:46.56,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:08:46.65,0:08:49.94,Default,,0,0,0,,Жүгіру жарысы! Бұл сүйкімді
Dialogue: 0,0:08:50.65,0:08:52.78,Default,,0,0,0,,(Бұрынғы пуридің тынысы)
Dialogue: 0,0:08:54.74,0:08:57.07,Default,,0,0,0,,Уау, қаншама адам
Dialogue: 0,0:08:58.66,0:09:00.70,Default,,0,0,0,,(шие) ұшады
Dialogue: 0,0:09:00.79,0:09:03.37,Default,,0,0,0,,... маусымдық сөз емес.
Dialogue: 0,0:09:04.50,0:09:06.54,Default,,0,0,0,,Ммм...
Dialogue: 0,0:09:06.62,0:09:07.92,Default,,0,0,0,,(Құндыз) Хе ха! ‬
Dialogue: 0,0:09:08.00,0:09:09.34,Default,,0,0,0,,Хэхехе
Dialogue: 0,0:09:10.88,0:09:11.75,Default,,0,0,0,,Құндыз! ‬
Dialogue: 0,0:09:11.84,0:09:13.51,Default,,0,0,0,,Ха! (Құндыз) Хехе
Dialogue: 0,0:09:13.59,0:09:14.76,Default,,0,0,0,,Уау! Эй! ‬
Dialogue: 0,0:09:14.84,0:09:15.68,Default,,0,0,0,,Ах! ‬
Dialogue: 0,0:09:21.60,0:09:23.02,Default,,0,0,0,,(Шие) Ах... у...
Dialogue: 0,0:09:29.98,0:09:31.02,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:09:33.90,0:09:34.94,Default,,0,0,0,,(Шие) Иә? ‬
Dialogue: 0,0:09:45.08,0:09:46.41,Default,,0,0,0,,Түзеткіш…
Dialogue: 0,0:09:46.50,0:09:47.62,Default,,0,0,0,,Ха! ‬
Dialogue: 0,0:10:00.68,0:10:02.05,Default,,0,0,0,,(Бұрынғы Пури) Құндыз! ‬
Dialogue: 0,0:10:02.14,0:10:04.27,Default,,0,0,0,,(Құндыз) Ой (Күзетшілер) Әй! ‬
Dialogue: 0,0:10:04.35,0:10:07.18,Default,,0,0,0,,(Құндыз) Адиеу (Бұрынғы Пури) Күт, Құндыз! ‬
Dialogue: 0,0:10:09.06,0:10:11.69,Default,,0,0,0,,‪（）････‬
Dialogue: 0,0:10:12.36,0:10:15.23,Default,,0,0,0,,Кио, У, Се, И, Ки...
Dialogue: 0,0:10:20.36,0:10:22.70,Default,,0,0,0,,(Қатты бала) Аспаз…
Dialogue: 0,0:10:22.78,0:10:26.20,Default,,0,0,0,,Құндыз бейбақ...
Dialogue: 0,0:10:27.71,0:10:29.17,Default,,0,0,0,,Мияу
Dialogue: 0,0:10:29.87,0:10:32.42,Default,,0,0,0,,(Қатаң бала) Мен сені бұрқыратамын! ‬
Dialogue: 0,0:10:48.73,0:10:50.02,Default,,0,0,0,,(Есікті автоматты түрде ашу дыбысы)
Dialogue: 0,0:10:50.10,0:10:51.56,Default,,0,0,0,,(Шие) қайтып оралды
Dialogue: 0,0:10:51.65,0:10:53.94,Default,,0,0,0,,О, Шие, жақсы жұмыс.
Dialogue: 0,0:10:55.44,0:10:57.28,Default,,0,0,0,,Фудзияма-чан да қош келдіңіз
Dialogue: 0,0:10:57.36,0:10:58.74,Default,,0,0,0,,Хохо
Dialogue: 0,0:10:58.82,0:11:02.03,Default,,0,0,0,,(Танака) Сакура, көп рахмет.
Dialogue: 0,0:11:02.11,0:11:04.08,Default,,0,0,0,,(Шие) Жоқ, олай емес.
Dialogue: 0,0:11:04.16,0:11:06.66,Default,,0,0,0,,Фудзияма-чанды таптыңыз ба? ‬
Dialogue: 0,0:11:06.74,0:11:07.79,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:11.92,0:11:13.71,Default,,0,0,0,,Хохоу
Dialogue: 0,0:11:14.67,0:11:16.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:18.26,0:11:20.01,Default,,0,0,0,,Шие
Dialogue: 0,0:11:20.51,0:11:21.76,Default,,0,0,0,,Толық емес жұмыс уақытында
Dialogue: 0,0:11:21.84,0:11:22.84,Default,,0,0,0,,Ах
Dialogue: 0,0:11:24.26,0:11:25.64,Default,,0,0,0,,(Акико) Нами-сан
Dialogue: 0,0:11:25.72,0:11:28.77,Default,,0,0,0,,Фудзияма-чан үнемі нені іздейді? ‬
Dialogue: 0,0:11:28.85,0:11:31.98,Default,,0,0,0,,Мен олардың жазбаларды іздеп жатқанын естідім.
Dialogue: 0,0:11:32.06,0:11:33.56,Default,,0,0,0,,Жазба дегеніміз не?
Dialogue: 0,0:11:33.65,0:11:35.36,Default,,0,0,0,,Сізде әрқашан бар ма? ‬
Dialogue: 0,0:11:35.44,0:11:37.27,Default,,0,0,0,,Сол заттың мазмұны
Dialogue: 0,0:11:37.36,0:11:40.15,Default,,0,0,0,,(Танака) Сіз оны қайда қойғаныңызды ұмытып кеткен шығарсыз.
Dialogue: 0,0:11:40.24,0:11:42.53,Default,,0,0,0,,Бұл сауда орталығында ма? ‬
Dialogue: 0,0:11:42.61,0:11:43.82,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:44.70,0:11:48.87,Default,,0,0,0,,Эмоциялар! Бала теңізден көтеріледі
Dialogue: 0,0:11:48.95,0:11:50.25,Default,,0,0,0,,Даусыңыз үлкен деп айтыңыз
Dialogue: 0,0:11:50.33,0:11:54.96,Default,,0,0,0,,Эмоциялар мен ұлдар теңізінен көтерілу
Dialogue: 0,0:11:55.04,0:11:56.79,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:56.88,0:11:59.17,Default,,0,0,0,,Сетцу Сетцу Юкихико
Dialogue: 0,0:11:59.26,0:12:00.46,Default,,0,0,0,,Хоухоу
Dialogue: 0,0:12:00.55,0:12:03.59,Default,,0,0,0,,Сетцудың хайкусына біртүрлі қозғалыс бар.
Dialogue: 0,0:12:03.68,0:12:08.47,Default,,0,0,0,,Декорацияға дыбысты қалай қосуға болады
Dialogue: 0,0:12:08.56,0:12:10.43,Default,,0,0,0,,Көрініс пен дыбыс? ‬
Dialogue: 0,0:12:12.02,0:12:15.44,Default,,0,0,0,,Ах... Фудзияма мырза, келесі жолы даусыңыз сәл баяу болады...
Dialogue: 0,0:12:15.52,0:12:17.40,Default,,0,0,0,,Бұл туралы не деуге болады? ‬
Dialogue: 0,0:12:17.48,0:12:19.65,Default,,0,0,0,,(Шие) Дауыс... не? ‬
Dialogue: 0,0:12:20.15,0:12:21.24,Default,,0,0,0,,А... Жарайды.
Dialogue: 0,0:12:21.32,0:12:23.40,Default,,0,0,0,,(Есіктің автоматты ашылған дыбысы) (Қатты бала) Эй, Шие! ‬
Dialogue: 0,0:12:23.49,0:12:24.57,Default,,0,0,0,,Құндыз жігіт қайда...
Dialogue: 0,0:12:24.66,0:12:25.74,Default,,0,0,0,,(Акико) Ах! ‬
Dialogue: 0,0:12:25.82,0:12:27.66,Default,,0,0,0,,Қатал бала осында! ‬
Dialogue: 0,0:12:27.74,0:12:31.16,Default,,0,0,0,,Ах... Сәлем Акико-сан.
Dialogue: 0,0:12:31.25,0:12:33.21,Default,,0,0,0,,(Акико) Фуфуфуфу (Танака) Фудзияма-сан!
Dialogue: 0,0:12:33.29,0:12:36.08,Default,,0,0,0,,Немерең сені алып кетуге келді.
Dialogue: 0,0:12:37.59,0:12:39.42,Default,,0,0,0,,Акико-сан…
Dialogue: 0,0:12:40.84,0:12:43.42,Default,,0,0,0,,Әй, құндыз жігіт қайда?
Dialogue: 0,0:12:43.51,0:12:44.43,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:12:44.51,0:12:47.22,Default,,0,0,0,,Менің көлігімдегі граффити.
Dialogue: 0,0:12:47.30,0:12:48.93,Default,,0,0,0,,Келіңіз бе?
Dialogue: 0,0:12:49.01,0:12:53.27,Default,,0,0,0,,Ей, Шие бала, сен әбігерге түсіп жатырсың.
Dialogue: 0,0:12:53.35,0:12:55.02,Default,,0,0,0,,(Шие) Атын қойма.
Dialogue: 0,0:12:56.06,0:12:57.35,Default,,0,0,0,,(тілді басу)
Dialogue: 0,0:13:00.27,0:13:04.53,Default,,0,0,0,,Егер мен ол жігітті кездестірсем, мен оған қатты қиналамын.
Dialogue: 0,0:13:07.70,0:13:10.99,Default,,0,0,0,,(Танака) Сакура-сан, бүгін бітуге жақын.
Dialogue: 0,0:13:11.08,0:13:13.00,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:13:15.04,0:13:16.29,Default,,0,0,0,,(Уақыт картасын таңбалау дыбысы)
Dialogue: 0,0:13:17.63,0:13:19.13,Default,,0,0,0,,(Жабдық менеджері) Еңбегіңіз үшін рахмет.
Dialogue: 0,0:13:19.21,0:13:21.13,Default,,0,0,0,,(Шие) Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:13:23.80,0:13:24.88,Default,,0,0,0,,Ах
Dialogue: 0,0:13:25.72,0:13:26.63,Default,,0,0,0,,Құндыз жігіт...
Dialogue: 0,0:13:46.78,0:13:50.28,Default,,0,0,0,,Хмм…
Dialogue: 0,0:13:50.37,0:13:53.99,Default,,0,0,0,,Мен бұл түзеткіш деп айттым! ‬
Dialogue: 0,0:13:54.08,0:13:56.87,Default,,0,0,0,,А, маска жоқ! ‬
Dialogue: 0,0:13:58.96,0:14:00.33,Default,,0,0,0,,Я~
Dialogue: 0,0:14:01.29,0:14:02.88,Default,,0,0,0,,Хмм…
Dialogue: 0,0:14:11.10,0:14:12.18,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:14:12.26,0:14:14.81,Default,,0,0,0,,Неліктен? Бұл кімдікі?
Dialogue: 0,0:14:15.56,0:14:16.39,Default,,0,0,0,,Ах
Dialogue: 0,0:14:18.81,0:14:20.31,Default,,0,0,0,,Құлаққап…
Dialogue: 0,0:14:24.40,0:14:27.28,Default,,0,0,0,,Сөздік... Кана
Dialogue: 0,0:14:29.24,0:14:32.12,Default,,0,0,0,,Смартфон! Не істеуім керек?
Dialogue: 0,0:14:32.20,0:14:33.28,Default,,0,0,0,,Ах
Dialogue: 0,0:15:04.61,0:15:08.49,Default,,0,0,0,,(Құндыз) Жапан-кун, бұл Хикарун.
Dialogue: 0,0:15:08.57,0:15:10.86,Default,,0,0,0,,Ақыры кездестік.
Dialogue: 0,0:15:10.95,0:15:12.95,Default,,0,0,0,,Хикарун өте жалғыз...
Dialogue: 0,0:15:13.03,0:15:14.07,Default,,0,0,0,,Ах
Dialogue: 0,0:15:14.74,0:15:16.54,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:17.75,0:15:19.54,Default,,0,0,0,,Ең нашар?
Dialogue: 0,0:15:20.92,0:15:22.46,Default,,0,0,0,,Мәміле жоқ.
Dialogue: 0,0:15:22.54,0:15:23.88,Default,,0,0,0,,Ей, ақымақ болма! ‬
Dialogue: 0,0:15:23.96,0:15:26.25,Default,,0,0,0,,Басыңнан айырылдым деп ойламайсың ба, ақымақ? ‬
Dialogue: 0,0:15:26.34,0:15:27.67,Default,,0,0,0,,Оның да денесі бар! ‬
Dialogue: 0,0:15:27.76,0:15:30.80,Default,,0,0,0,,Мәселе бұл емес! ‬
Dialogue: 0,0:15:30.88,0:15:33.80,Default,,0,0,0,,Хикарун...
Dialogue: 0,0:15:33.89,0:15:35.10,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:38.18,0:15:40.56,Default,,0,0,0,,(Құндыз) А-а-а-а...
Dialogue: 0,0:15:40.64,0:15:43.40,Default,,0,0,0,,Эй Шие, кешіріңіз.
Dialogue: 0,0:15:43.48,0:15:44.52,Default,,0,0,0,,(шие) бөлек
Dialogue: 0,0:15:44.61,0:15:48.19,Default,,0,0,0,,Бұрынғы пури бейбақ, табанды бол.
Dialogue: 0,0:15:48.28,0:15:51.07,Default,,0,0,0,,(Шие) Жарайды, Қатты бала мені іздеді.
Dialogue: 0,0:15:51.15,0:15:52.91,Default,,0,0,0,,Қатал бала осында! ‬
Dialogue: 0,0:15:52.99,0:15:55.70,Default,,0,0,0,,Мен оның көлігіне жаздым.
Dialogue: 0,0:15:55.78,0:15:57.49,Default,,0,0,0,,(Шие) Жүріңдер. (Құндыз) Иә? ‬
Dialogue: 0,0:15:57.58,0:16:00.29,Default,,0,0,0,,«төменде» емес «жоғарыда»
Dialogue: 0,0:16:00.37,0:16:02.79,Default,,0,0,0,,«Қатты бала мұнда кел».
Dialogue: 0,0:16:02.87,0:16:04.71,Default,,0,0,0,,(Құндыз) Мен жаздым! ‬
Dialogue: 0,0:16:08.21,0:16:09.17,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:16:09.25,0:16:10.92,Default,,0,0,0,,(Sae/Kanta) Қайта қош келдіңіз
Dialogue: 0,0:16:11.01,0:16:13.38,Default,,0,0,0,,(Канта) Юки Үйдің ішіне жүгірме! ‬
Dialogue: 0,0:16:13.47,0:16:14.55,Default,,0,0,0,,Иә
Dialogue: 0,0:16:17.97,0:16:20.31,Default,,0,0,0,,Мари-чан, маған көмектес
Dialogue: 0,0:16:20.81,0:16:24.52,Default,,0,0,0,,Юки-чан, тыныш бол, ертең сынақ емтиханым бар.
Dialogue: 0,0:16:25.02,0:16:26.81,Default,,0,0,0,,Иә? Мари ше? ‬
Dialogue: 0,0:16:26.90,0:16:27.94,Default,,0,0,0,,Не? ‬
Dialogue: 0,0:16:28.52,0:16:29.82,Default,,0,0,0,,Не болды? ‬
Dialogue: 0,0:16:29.90,0:16:32.36,Default,,0,0,0,,Мари-чан! ‬
Dialogue: 0,0:16:32.44,0:16:33.36,Default,,0,0,0,,А... уау
Dialogue: 0,0:16:33.45,0:16:36.41,Default,,0,0,0,,Смартфон менікі! қайда екенін табыңыз
Dialogue: 0,0:16:36.49,0:16:37.32,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:37.41,0:16:39.28,Default,,0,0,0,,Бұл менікі емес.
Dialogue: 0,0:16:40.33,0:16:41.54,Default,,0,0,0,,ше? ‬
Dialogue: 0,0:16:41.62,0:16:44.92,Default,,0,0,0,,(Құндыз) Хмм... иә.
Dialogue: 0,0:16:45.92,0:16:48.46,Default,,0,0,0,,Хехе, жақсы болып барады.
Dialogue: 0,0:16:48.54,0:16:50.71,Default,,0,0,0,,Бұлардың барлығы шие хайкусы, солай ма? ‬
Dialogue: 0,0:16:50.80,0:16:51.67,Default,,0,0,0,,(Құндыз) Иә.
Dialogue: 0,0:16:51.76,0:16:53.55,Default,,0,0,0,,Ол ақсап, оқылмайды.
Dialogue: 0,0:16:53.63,0:16:55.30,Default,,0,0,0,,(Құндыз) Белгілеп жатыр, Бака.
Dialogue: 0,0:16:55.38,0:16:58.26,Default,,0,0,0,,Шие хайкусымен жапон тілін үйреніңіз
Dialogue: 0,0:16:58.35,0:16:59.22,Default,,0,0,0,,Сіз сөйлесе аласыз.
Dialogue: 0,0:16:59.30,0:17:00.97,Default,,0,0,0,,Мен жаза алмаймын
Dialogue: 0,0:17:01.06,0:17:03.52,Default,,0,0,0,,Менің әкем де тек испанша жаза алады.
Dialogue: 0,0:17:03.60,0:17:04.44,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:04.52,0:17:07.52,Default,,0,0,0,,Менің хайкума сауда орталығында белгі қойылып жатыр.
Dialogue: 0,0:17:07.60,0:17:09.44,Default,,0,0,0,,Мен оны тұрғын үй кешеніне қалдырдым.
Dialogue: 0,0:17:09.52,0:17:11.73,Default,,0,0,0,,Тоқта, бұл ұят.
Dialogue: 0,0:17:11.82,0:17:14.99,Default,,0,0,0,,Неліктен? Шие лаймы салқын.
Dialogue: 0,0:17:15.07,0:17:17.28,Default,,0,0,0,,рифма емес, Хайку
Dialogue: 0,0:17:30.67,0:17:32.34,Default,,0,0,0,,(Шие) Ымырт...
Dialogue: 0,0:17:33.34,0:17:34.92,Default,,0,0,0,,Ымырт кезінде...
Dialogue: 0,0:17:35.01,0:17:36.38,Default,,0,0,0,,Қандай жаңалық бар? ‬
Dialogue: 0,0:17:36.47,0:17:37.30,Default,,0,0,0,,Бөлек
Dialogue: 0,0:17:38.68,0:17:41.81,Default,,0,0,0,,‪･･･… !?‬
Dialogue: 0,0:17:41.89,0:17:43.64,Default,,0,0,0,,Бұл не? Кімнің? ‬
Dialogue: 0,0:17:43.72,0:17:44.56,Default,,0,0,0,,Ах
Dialogue: 0,0:17:46.48,0:17:48.73,Default,,0,0,0,,Түзеткіш
Dialogue: 0,0:17:48.81,0:17:50.44,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:50.52,0:17:52.69,Default,,0,0,0,,Смартфонды жоғалту - қорқынышты. Сен өлесің.
Dialogue: 0,0:17:52.78,0:17:54.49,Default,,0,0,0,,Өлемін өлмеймін
Dialogue: 0,0:17:54.57,0:17:56.53,Default,,0,0,0,,Менде смартфон жоқ. Мен өлемін. Әдетте.
Dialogue: 0,0:17:56.61,0:17:57.45,Default,,0,0,0,,Өлу
Dialogue: 0,0:17:57.53,0:18:00.32,Default,,0,0,0,,Бүгін қайтарып алмасам, өлемін! ‬
Dialogue: 0,0:18:00.41,0:18:01.62,Default,,0,0,0,,Міне болды! Шынымен бе? ‬
Dialogue: 0,0:18:02.49,0:18:04.75,Default,,0,0,0,,Бұл... сауда орталығы ма? ‬
Dialogue: 0,0:18:04.83,0:18:06.54,Default,,0,0,0,,Сауда орталығы! болды ма? ‬
Dialogue: 0,0:18:06.62,0:18:08.17,Default,,0,0,0,,Мен тіпті сауда орталығына барамын.
Dialogue: 0,0:18:08.25,0:18:09.08,Default,,0,0,0,,Келіңіздер! ‬
Dialogue: 0,0:18:09.17,0:18:11.13,Default,,0,0,0,,Неге маған бәрібір қоңырау шалмайсың? ‬
Dialogue: 0,0:18:11.21,0:18:13.75,Default,,0,0,0,,Сондықтан ол сауда орталығында.
Dialogue: 0,0:18:13.84,0:18:16.09,Default,,0,0,0,,Қоңырау шалсаң, көмектесер.
Dialogue: 0,0:18:17.42,0:18:18.68,Default,,0,0,0,,(Құндыз) Сен оны араластырдың ба? ‬
Dialogue: 0,0:18:18.76,0:18:20.51,Default,,0,0,0,,Мүмкін бір-бірімізді соқтығысқан кезде
Dialogue: 0,0:18:20.59,0:18:21.72,Default,,0,0,0,,Не? Менің кінәм ба? ‬
Dialogue: 0,0:18:21.80,0:18:23.85,Default,,0,0,0,,(Смартфонның қоңырау үні) Маған қоңырау келіп жатыр.
Dialogue: 0,0:18:23.93,0:18:26.14,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек? ‬
Dialogue: 0,0:18:26.23,0:18:27.35,Default,,0,0,0,,Бар болғаны шығу керек.
Dialogue: 0,0:18:27.43,0:18:29.14,Default,,0,0,0,,(Шие) Менің қолымнан келмейді (Құндыз) А...
Dialogue: 0,0:18:29.23,0:18:30.90,Default,,0,0,0,,(Шие) Сәлем! (Құндыз) Міне, келдің.
Dialogue: 0,0:18:30.98,0:18:32.23,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:18:33.02,0:18:34.32,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:18:34.40,0:18:36.44,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,0:18:36.53,0:18:37.82,Default,,0,0,0,,Ммм (Құндыз) Иә? ‬
Dialogue: 0,0:18:37.90,0:18:39.57,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:18:39.66,0:18:41.57,Default,,0,0,0,,Мен шықтым, бірақ менімен сөйлеспедің.
Dialogue: 0,0:18:41.66,0:18:43.12,Default,,0,0,0,,Тез сөйле
Dialogue: 0,0:18:43.20,0:18:44.37,Default,,0,0,0,,(Шие) Ой...
Dialogue: 0,0:18:44.45,0:18:45.37,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:18:46.33,0:18:47.91,Default,,0,0,0,,Ах! маска
Dialogue: 0,0:18:48.00,0:18:49.67,Default,,0,0,0,,Кенеттен не болып жатыр?
Dialogue: 0,0:18:52.33,0:18:53.88,Default,,0,0,0,,(Шие) Ах! Өйткені, ол адам
Dialogue: 0,0:18:53.96,0:18:54.80,Default,,0,0,0,,А... бұл
Dialogue: 0,0:18:54.88,0:18:57.01,Default,,0,0,0,,Бұл смартфон менікі.
Dialogue: 0,0:18:57.09,0:18:59.22,Default,,0,0,0,,Мен үшін күлімде! Уау
Dialogue: 0,0:18:59.30,0:19:00.68,Default,,0,0,0,,Иә? (Құндыз) Әй, кетті.
Dialogue: 0,0:19:00.76,0:19:03.01,Default,,0,0,0,,Қазір біздің тыңдаушыларымыз қандай? ‬
Dialogue: 0,0:19:03.10,0:19:05.18,Default,,0,0,0,,Эй, Джури-чан, сен телефонды қойдың.
Dialogue: 0,0:19:05.26,0:19:07.56,Default,,0,0,0,,Кешіріңіз, мен қатты қысымдамын.
Dialogue: 0,0:19:07.64,0:19:10.23,Default,,0,0,0,,Міне, сіздің күлімсіреуіңіз, шын мәнінде! ‬
Dialogue: 0,0:19:10.31,0:19:11.90,Default,,0,0,0,,Күлімсіреу деп аталады.
Dialogue: 0,0:19:11.98,0:19:14.65,Default,,0,0,0,,Белгілі белсенді Дж.Кьюриос.
Dialogue: 0,0:19:14.73,0:19:16.44,Default,,0,0,0,,Сіз Черриді білесіз бе? (Шие) Уф.
Dialogue: 0,0:19:16.53,0:19:19.57,Default,,0,0,0,,Бақа! Ол Curio Live арнасында өте танымал бейне хост.
Dialogue: 0,0:19:19.65,0:19:21.61,Default,,0,0,0,,1 миллион жалпы кіру... (смартфон қоңырау үні)
Dialogue: 0,0:19:21.70,0:19:22.70,Default,,0,0,0,,Шық, шық, шық! ‬
Dialogue: 0,0:19:22.78,0:19:24.28,Default,,0,0,0,,(Шие) Жоқ, мүмкін емес. (Құндыз) Эй.
Dialogue: 0,0:19:24.37,0:19:25.45,Default,,0,0,0,,(Шие) Эй (Юри Мари) Гах! ‬
Dialogue: 0,0:19:25.53,0:19:28.41,Default,,0,0,0,,А, жоқ, қазір... қазір басқаша.
Dialogue: 0,0:19:29.16,0:19:32.50,Default,,0,0,0,,Ах... мм... кешіріңіз.
Dialogue: 0,0:19:39.55,0:19:42.13,Default,,0,0,0,,Смартфоныңызды қайтарып алғаныңыз жақсы.
Dialogue: 0,0:19:42.22,0:19:45.89,Default,,0,0,0,,Өте жақсы болды, ары қарай не болар екен деп ойладым.
Dialogue: 0,0:19:45.97,0:19:47.81,Default,,0,0,0,,Сіз өлген жоқсыз.
Dialogue: 0,0:19:47.89,0:19:49.06,Default,,0,0,0,,Иә
Dialogue: 0,0:19:49.60,0:19:50.81,Default,,0,0,0,,(Мари Юри) Иә? ‬
Dialogue: 0,0:19:52.56,0:19:53.73,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:57.98,0:19:59.15,Default,,0,0,0,,Ветчина
Dialogue: 0,0:19:59.23,0:20:01.99,Default,,0,0,0,,Тамақтану тәсілі қандай? ‬
Dialogue: 0,0:20:02.07,0:20:03.41,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:06.45,0:20:07.91,Default,,0,0,0,,(Есікті автоматты түрде ашу дыбысы)
Dialogue: 0,0:20:07.99,0:20:09.62,Default,,0,0,0,,(Акико) Қош келдіңіз.
Dialogue: 0,0:20:09.70,0:20:12.00,Default,,0,0,0,,Сәлем, Шие Миюки-сенсэй.
Dialogue: 0,0:20:12.08,0:20:14.37,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:20:17.96,0:20:19.76,Default,,0,0,0,,Қазір тазалаңыз.
Dialogue: 0,0:20:19.84,0:20:20.96,Default,,0,0,0,,(Акико) Сәлем.
Dialogue: 0,0:20:21.05,0:20:22.63,Default,,0,0,0,,(Танака) А... (Нами/Акико) Иә? ‬
Dialogue: 0,0:20:22.72,0:20:23.80,Default,,0,0,0,,Бастық, не болды? ‬
Dialogue: 0,0:20:24.51,0:20:27.14,Default,,0,0,0,,(Танака) Обоннан кейін не істеуіміз керек?
Dialogue: 0,0:20:27.22,0:20:29.89,Default,,0,0,0,,Shift Әлі де толтырылмай жатыр ма? ‬
Dialogue: 0,0:20:29.97,0:20:32.39,Default,,0,0,0,,(Танака) Маған толық емес жұмыс күнін ауыстыру керек.
Dialogue: 0,0:20:32.48,0:20:35.02,Default,,0,0,0,,Біз жалдауды шындап бастауымыз керек.
Dialogue: 0,0:20:35.10,0:20:36.31,Default,,0,0,0,,(Танака) Иә.
Dialogue: 0,0:20:41.78,0:20:44.91,Default,,0,0,0,,(Генда) Әй, қарағым, осындай нәрсені қолдануға болады.
Dialogue: 0,0:20:44.99,0:20:45.91,Default,,0,0,0,,(Ямамото) Қандай...
Dialogue: 0,0:20:54.46,0:20:56.38,Default,,0,0,0,,Сіз шынымен көрінгенді жек көресіз бе? ‬
Dialogue: 0,0:20:56.46,0:20:58.25,Default,,0,0,0,,Жоқ, бұл өрескел.
Dialogue: 0,0:20:58.34,0:21:01.30,Default,,0,0,0,,Ол меха қыз Юки-чан, ал Китеру одан сайын танымал болады...
Dialogue: 0,0:21:01.38,0:21:02.80,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:21:02.88,0:21:03.72,Default,,0,0,0,,Текаса‎⸺
Dialogue: 0,0:21:04.76,0:21:08.35,Default,,0,0,0,,Кішкентай кезіңізде бұл сіздің сүйкімді жеріңіз емес пе еді? тістері
Dialogue: 0,0:21:08.43,0:21:09.55,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:21:09.64,0:21:11.39,Default,,0,0,0,,Дұрыс, сүйкімді.
Dialogue: 0,0:21:11.47,0:21:13.23,Default,,0,0,0,,Бұл да тыңдармандардың көңілінен шықты.
Dialogue: 0,0:21:13.31,0:21:14.56,Default,,0,0,0,,Құндыз күлкі
Dialogue: 0,0:21:14.64,0:21:16.19,Default,,0,0,0,,Бұл құндыз емес
Dialogue: 0,0:21:17.06,0:21:19.48,Default,,0,0,0,,Өзіңізге ұнамады ма? ‬
Dialogue: 0,0:21:20.52,0:21:23.86,Default,,0,0,0,,Маған ұнады, бірақ әйтеуір...
Dialogue: 0,0:22:17.58,0:22:18.75,Default,,0,0,0,,Бұл сүйкімді емес.
Dialogue: 0,0:22:19.42,0:22:21.17,Default,,0,0,0,,Бұл жастық шақ.
Dialogue: 0,0:22:21.25,0:22:23.17,Default,,0,0,0,,Сізге жақшалар ұнамай ма? Маған ұнамайды
Dialogue: 0,0:22:23.25,0:22:26.01,Default,,0,0,0,,Жарайды, сүйкімді екен, мехаға ұқсайды.
Dialogue: 0,0:22:26.09,0:22:27.55,Default,,0,0,0,,Мари-чан
Dialogue: 0,0:22:27.63,0:22:31.01,Default,,0,0,0,,Бір күні мен кенеттен сырт келбетімді жек көре бастадым‎⸺
Dialogue: 0,0:22:31.09,0:22:32.89,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:22:32.97,0:22:34.26,Default,,0,0,0,,Юри де сонда болды ма? ‬
Dialogue: 0,0:22:34.35,0:22:36.27,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:22:36.35,0:22:37.68,Default,,0,0,0,,А? ‬
Dialogue: 0,0:22:37.77,0:22:39.23,Default,,0,0,0,,(Юри Мари) Ха! Анау, сол адам
Dialogue: 0,0:22:39.31,0:22:41.10,Default,,0,0,0,,Бұған дейін
Dialogue: 0,0:22:43.07,0:22:44.19,Default,,0,0,0,,(Юри Мари) Иә? ‬
Dialogue: 0,0:22:46.32,0:22:47.99,Default,,0,0,0,,Хмм? ‬
Dialogue: 0,0:22:48.65,0:22:50.99,Default,,0,0,0,,Сізге үлкен кісілер ұнайды ма? ‬
Dialogue: 0,0:22:51.82,0:22:54.53,Default,,0,0,0,,Қарым-қатынаста қиналған сияқты болса да, оның сүйген қызы бар ма?
Dialogue: 0,0:22:54.62,0:22:57.00,Default,,0,0,0,,Мүмкін олар ағайынды шығар. Жоқ, олар бір-біріне ұқсамайды.
Dialogue: 0,0:22:58.58,0:22:59.75,Default,,0,0,0,,Ах (Юри Мари) Иә? ‬
Dialogue: 0,0:23:04.25,0:23:05.38,Default,,0,0,0,,(Юри Мари) Ах.
Dialogue: 0,0:23:06.05,0:23:08.63,Default,,0,0,0,,Хехехе... Ахаха
Dialogue: 0,0:23:25.98,0:23:27.78,Default,,0,0,0,,(Смартфонның хабарландыру дыбысы) (Шие) Иә? ‬
Dialogue: 0,0:23:32.36,0:23:33.99,Default,,0,0,0,,Хмм…
Dialogue: 0,0:23:34.07,0:23:38.70,Default,,0,0,0,,Енді гингио орындап, жасаған хайкуымызды ұсынайық.
Dialogue: 0,0:23:38.79,0:23:43.83,Default,,0,0,0,,Мен бұрын таратқан қағаз жолағына хайку жазу үшін қылқаламды пайдаланыңыз.
Dialogue: 0,0:23:46.50,0:23:49.09,Default,,0,0,0,,Мұғалімге ұқсайды ма? ‬
Dialogue: 0,0:23:49.17,0:23:50.38,Default,,0,0,0,,Сіз не істеп жатырсыз? ‬
Dialogue: 0,0:23:51.42,0:23:52.26,Default,,0,0,0,,Иә
Dialogue: 0,0:23:52.34,0:23:55.93,Default,,0,0,0,,Алдымен толтырылған заттарды жинаймыз.
Dialogue: 0,0:23:58.10,0:23:59.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:59.98,0:24:01.23,Default,,0,0,0,,Хмм…
Dialogue: 0,0:24:09.53,0:24:10.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:15.41,0:24:20.12,Default,,0,0,0,,Иә, мен баяндауыш қызметін атқарғым келеді.
Dialogue: 0,0:24:24.12,0:24:28.96,Default,,0,0,0,,Манекендер юката киген сауда орталығы.
Dialogue: 0,0:24:29.55,0:24:33.93,Default,,0,0,0,,Манекендер юката киген сауда орталығы.
Dialogue: 0,0:24:34.55,0:24:38.10,Default,,0,0,0,,Өйткені дүкеннің алдындағы манекен юката киіп алған.
Dialogue: 0,0:24:38.18,0:24:43.69,Default,,0,0,0,,Әй, қазір жаз, сеземін мезгілін.
Dialogue: 0,0:24:44.52,0:24:46.94,Default,,0,0,0,,Бұл Сасакидің жұмысы
Dialogue: 0,0:24:47.02,0:24:48.27,Default,,0,0,0,,(Сасаки) Хахаха...
Dialogue: 0,0:24:48.36,0:24:50.86,Default,,0,0,0,,Әрі қарай жалғастырайық.
Dialogue: 0,0:24:52.44,0:24:53.53,Default,,0,0,0,,Ах
Dialogue: 0,0:24:54.03,0:24:55.28,Default,,0,0,0,,Шие мырза
Dialogue: 0,0:24:55.36,0:24:56.41,Default,,0,0,0,,Иә
Dialogue: 0,0:24:56.91,0:24:59.66,Default,,0,0,0,,Мен мұнда бір секундқа келе аламын ба? ‬
Dialogue: 0,0:25:07.04,0:25:08.13,Default,,0,0,0,,(Шие) Иә? ‬
Dialogue: 0,0:25:13.55,0:25:15.38,Default,,0,0,0,,Бұл менікі...
Dialogue: 0,0:25:17.09,0:25:19.30,Default,,0,0,0,,Ақын рөлін беріңізші
Dialogue: 0,0:25:19.39,0:25:20.68,Default,,0,0,0,,Иә!?
Dialogue: 0,0:25:20.76,0:25:22.31,Default,,0,0,0,,Жоқ? ‬
Dialogue: 0,0:25:22.39,0:25:24.27,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:25:24.77,0:25:28.06,Default,,0,0,0,,Көпшілік алдында ән айту туралы аздап.
Dialogue: 0,0:25:28.15,0:25:30.44,Default,,0,0,0,,Бұл стиль емес...
Dialogue: 0,0:25:30.52,0:25:32.69,Default,,0,0,0,,Бірақ мұны бәрі естігісі келеді.
Dialogue: 0,0:25:33.61,0:25:34.95,Default,,0,0,0,,(Қарттар) Иә.
Dialogue: 0,0:25:35.03,0:25:37.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:38.03,0:25:39.03,Default,,0,0,0,,А...
Dialogue: 0,0:25:39.12,0:25:43.54,Default,,0,0,0,,Мұны барлығына Шиенің керемет дауысымен жеткізіңіз.
Dialogue: 0,0:26:01.97,0:26:03.14,Default,,0,0,0,,Көрсету…
Dialogue: 0,0:26:05.31,0:26:08.35,Default,,0,0,0,,(терең тыныс)
Dialogue: 0,0:26:09.85,0:26:11.44,Default,,0,0,0,,(сыбырлап) сауда үйі
Dialogue: 0,0:26:15.57,0:26:17.40,Default,,0,0,0,,Күннің батуына қарай еру
Dialogue: 0,0:26:17.49,0:26:19.24,Default,,0,0,0,,(Қарттар) А? ‬
Dialogue: 0,0:26:19.32,0:26:22.58,Default,,0,0,0,,Шие мырза, сәл қаттырақ.
Dialogue: 0,0:26:27.46,0:26:30.92,Default,,0,0,0,,(терең тыныс)
Dialogue: 0,0:26:32.84,0:26:34.80,Default,,0,0,0,,Сауда орталығы Күн батқанда еріген
Dialogue: 0,0:26:36.63,0:26:40.05,Default,,0,0,0,,(Қарттар) А...
Dialogue: 0,0:26:40.14,0:26:41.89,Default,,0,0,0,,Хехехе
Dialogue: 0,0:26:51.48,0:26:53.36,Default,,0,0,0,,Рахмет
Dialogue: 0,0:27:00.53,0:27:02.12,Default,,0,0,0,,(Шие) Хайку деген не... (Қарттар) А? ‬
Dialogue: 0,0:27:02.91,0:27:05.04,Default,,0,0,0,,Хат өнері болса да
Dialogue: 0,0:27:08.12,0:27:10.37,Default,,0,0,0,,Дауыстап ән айтпасаң да
Dialogue: 0,0:27:13.04,0:27:14.34,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:27:14.42,0:27:19.88,Default,,0,0,0,,Бірақ тек дауыстап жеткізуге болатын кейбір көріністер бар деп ойламайсыз ба? ‬
Dialogue: 0,0:27:19.97,0:27:20.84,Default,,0,0,0,,Ха! ‬
Dialogue: 0,0:27:21.93,0:27:25.43,Default,,0,0,0,,Дауыстап айтпасаңыз да, маған хабарлаңыз
Dialogue: 0,0:27:26.93,0:27:32.19,Default,,0,0,0,,Цикада дауысы! Тіпті маскасын шеше алмай жүрген қызға да
Dialogue: 0,0:27:32.27,0:27:36.44,Default,,0,0,0,,Тіпті цикаданың даусы шығып, маскасын шеше алмаған қыз
Dialogue: 0,0:27:36.52,0:27:37.48,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:27:37.57,0:27:39.99,Default,,0,0,0,,(ренжіген дауыс)
Dialogue: 0,0:27:40.07,0:27:41.07,Default,,0,0,0,,Ах
Dialogue: 0,0:27:41.57,0:27:44.32,Default,,0,0,0,,(Күлімнің үрейлі дауыстары)
Dialogue: 0,0:27:51.04,0:27:53.50,Default,,0,0,0,,Бұл бір деңгей жоғары, Сакура-сан.
Dialogue: 0,0:27:53.58,0:27:56.09,Default,,0,0,0,,(Шие) Солай сияқты.
Dialogue: 0,0:27:58.46,0:28:00.30,Default,,0,0,0,,Ах, сондықтан шие.
Dialogue: 0,0:28:00.38,0:28:02.72,Default,,0,0,0,,(Шие) Иә? Сакура аты
Dialogue: 0,0:28:02.80,0:28:04.18,Default,,0,0,0,,(Шие) А... а
Dialogue: 0,0:28:04.26,0:28:06.55,Default,,0,0,0,,Шие сүйкімді болуы мүмкін
Dialogue: 0,0:28:06.64,0:28:08.26,Default,,0,0,0,,Шие мырза...
Dialogue: 0,0:28:09.22,0:28:11.56,Default,,0,0,0,,Менің ойымша, бұл Черри-кун ғой, солай ма? ‬
Dialogue: 0,0:28:14.77,0:28:16.52,Default,,0,0,0,,Сіз не тыңдадыңыз? ‬
Dialogue: 0,0:28:16.61,0:28:17.77,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:28:17.86,0:28:19.23,Default,,0,0,0,,Жоқ… жоқ…
Dialogue: 0,0:28:20.78,0:28:23.53,Default,,0,0,0,,Қатты дыбыстар Мен олармен үнемі қиналдым.
Dialogue: 0,0:28:23.61,0:28:25.74,Default,,0,0,0,,Негізі мен ештеңе тыңдаған жоқпын.
Dialogue: 0,0:28:25.82,0:28:26.66,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:28:26.74,0:28:30.41,Default,,0,0,0,,Осылайша, адамдар сізбен сөйлесуге мәжбүр болмайды.
Dialogue: 0,0:28:30.50,0:28:33.08,Default,,0,0,0,,Оның ақылды екені сөзсіз.
Dialogue: 0,0:28:40.17,0:28:42.05,Default,,0,0,0,,(Шие) Жаздың салқыны? иә? ‬
Dialogue: 0,0:28:44.01,0:28:46.34,Default,,0,0,0,,Ха! Міне... мынау...
Dialogue: 0,0:28:46.43,0:28:49.60,Default,,0,0,0,,А, Черри-кунның смартфонында неге сөздік бар? ‬
Dialogue: 0,0:28:49.68,0:28:51.93,Default,,0,0,0,,(Шие) Иә? Ах Сайджики
Dialogue: 0,0:28:52.02,0:28:52.85,Default,,0,0,0,,Сайджики? ‬
Dialogue: 0,0:28:53.98,0:28:56.48,Default,,0,0,0,,(Шие) Хайку сөздігі сияқты
Dialogue: 0,0:28:57.56,0:29:02.36,Default,,0,0,0,,Қолданба нұсқасы да бар, бірақ кітап жақсырақ.
Dialogue: 0,0:29:03.15,0:29:05.24,Default,,0,0,0,,Мен хайкуды жақсы көремін
Dialogue: 0,0:29:06.07,0:29:10.66,Default,,0,0,0,,Хайкуды жақсы сөзбен жеткізуге болады... осындай нәрсе.
Dialogue: 0,0:29:11.49,0:29:16.21,Default,,0,0,0,,Жарайды, мен көпшілік алдында ән айтуда онша шебер емеспін.
Dialogue: 0,0:29:18.79,0:29:22.09,Default,,0,0,0,,Қызығушылығын арттыру
Dialogue: 0,0:29:22.17,0:29:23.05,Default,,0,0,0,,Мен түсінемін!
Dialogue: 0,0:29:24.01,0:29:27.30,Default,,0,0,0,,Оны көбірек адамдар желіде қарайтын сияқты, солай ма? ‬
Dialogue: 0,0:29:27.39,0:29:29.60,Default,,0,0,0,,Мен толық түсінемін.
Dialogue: 0,0:29:41.73,0:29:43.78,Default,,0,0,0,,(Шие) Кім қарап отыр?
Dialogue: 0,0:29:44.99,0:29:47.03,Default,,0,0,0,,Бұл бірден ойға келе ме? (Cherry) Huh? ‬
Dialogue: 0,0:29:47.66,0:29:48.99,Default,,0,0,0,,Хайку
Dialogue: 0,0:29:49.07,0:29:50.87,Default,,0,0,0,,(Шие) Іс жақсы болған кезде
Dialogue: 0,0:29:50.95,0:29:53.24,Default,,0,0,0,,Керемет, сосын жасап көріңіз.
Dialogue: 0,0:29:53.33,0:29:55.08,Default,,0,0,0,,Енді ше? ‬
Dialogue: 0,0:29:56.04,0:29:59.67,Default,,0,0,0,,Ah, sorry, I might have been a little too presumptuous.
Dialogue: 0,0:30:05.26,0:30:06.17,Default,,0,0,0,,Ах
Dialogue: 0,0:30:11.64,0:30:13.18,Default,,0,0,0,,Summer light‎…
Dialogue: 0,0:30:13.26,0:30:14.47,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:30:25.57,0:30:27.99,Default,,0,0,0,,(deep breath)
Dialogue: 0,0:30:30.91,0:30:36.00,Default,,0,0,0,,Ымыртқа қарай ұшатын жаз шамдары
Dialogue: 0,0:30:42.88,0:30:48.42,Default,,0,0,0,,Ымыртқа қарай ұшатын жазғы шамдар...
Dialogue: 0,0:30:51.14,0:30:54.06,Default,,0,0,0,,Нацутоши дегеніміз не? ‬
Dialogue: 0,0:30:55.22,0:30:58.48,Default,,0,0,0,,(Cherry)‎Лайт‎Rinoko Summer season word
Dialogue: 0,0:30:59.06,0:31:00.35,Default,,0,0,0,,Seasonal words…
Dialogue: 0,0:31:04.86,0:31:09.61,Default,,0,0,0,,Ымыртқа қарай ұшатын жаз шамдары
Dialogue: 0,0:31:13.24,0:31:14.53,Default,,0,0,0,,Өте сүйкімді! ‬
Dialogue: 0,0:31:20.50,0:31:21.88,Default,,0,0,0,,(Cherry) Cute? ‬
Dialogue: 0,0:31:21.96,0:31:23.04,Default,,0,0,0,,Иә
Dialogue: 0,0:31:24.63,0:31:25.63,Default,,0,0,0,,(Шие) Қайда? ‬
Dialogue: 0,0:31:25.71,0:31:27.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:31:28.01,0:31:31.55,Default,,0,0,0,,Flying meku? Осыны айтып тұрсың ба?
Dialogue: 0,0:31:32.43,0:31:33.51,Default,,0,0,0,,Also...
Dialogue: 0,0:31:36.43,0:31:37.27,Default,,0,0,0,,Voice
Dialogue: 0,0:31:37.35,0:31:38.47,Default,,0,0,0,,(Шие) Ха! ‬
Dialogue: 0,0:31:42.27,0:31:43.35,Default,,0,0,0,,Дауыс? ‬
Dialogue: 0,0:31:43.44,0:31:47.19,Default,,0,0,0,,Менің ойымша, Черридің дауысы сүйкімді
Dialogue: 0,0:31:50.82,0:31:52.86,Default,,0,0,0,,(Шие) Өте сүйкімді‎⸺
Dialogue: 0,0:31:52.95,0:31:54.78,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:32:16.51,0:32:17.93,Default,,0,0,0,,(Cherry) Okay.
Dialogue: 0,0:32:39.54,0:32:40.75,Default,,0,0,0,,(Шие) Фу…
Dialogue: 0,0:32:52.97,0:32:54.30,Default,,0,0,0,,Уф! ‬
Dialogue: 0,0:32:54.38,0:32:57.18,Default,,0,0,0,,Itatatata...
Dialogue: 0,0:32:57.26,0:32:58.64,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:32:58.72,0:33:00.43,Default,,0,0,0,,(Койчи) Мен үйдемін.
Dialogue: 0,0:33:00.52,0:33:01.39,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:33:11.40,0:33:13.03,Default,,0,0,0,,Әке, мен жүктерімді сонда қалдыра аламын ба? ‬
Dialogue: 0,0:33:13.11,0:33:15.70,Default,,0,0,0,,(Койчи) Иә? А, жарайды, бірақ
Dialogue: 0,0:33:23.41,0:33:25.67,Default,,0,0,0,,Әлі ерте емес пе? дайындық
Dialogue: 0,0:33:25.75,0:33:28.54,Default,,0,0,0,,Мен келесі айда көшемін.
Dialogue: 0,0:33:28.63,0:33:31.59,Default,,0,0,0,,Бәрібір соңғы минутта әбігер болады.
Dialogue: 0,0:33:31.67,0:33:34.01,Default,,0,0,0,,Қазір жалғастырған дұрыс.
Dialogue: 0,0:33:34.09,0:33:36.05,Default,,0,0,0,,(Койчи) Бұл рас.
Dialogue: 0,0:33:36.72,0:33:38.43,Default,,0,0,0,,Сіздің беліңіз ше? Сенімен бәрі жақсы ма? ‬
Dialogue: 0,0:33:38.51,0:33:40.30,Default,,0,0,0,,Иә... әлі біраз.
Dialogue: 0,0:33:40.39,0:33:43.52,Default,,0,0,0,,(Койчи) Өзіңізді қатты итермеңіз. Мен саған үй шаруасына көмектесемін.
Dialogue: 0,0:33:43.60,0:33:44.89,Default,,0,0,0,,Пайдалы
Dialogue: 0,0:33:44.98,0:33:46.81,Default,,0,0,0,,Маған таңғы ас дайындағаныңды қалаймын.
Dialogue: 0,0:33:46.89,0:33:48.65,Default,,0,0,0,,Пісіру мүмкін емес
Dialogue: 0,0:33:48.73,0:33:50.65,Default,,0,0,0,,Сіз маған көмектесемін дедіңіз.
Dialogue: 0,0:33:50.73,0:33:53.53,Default,,0,0,0,,(Койчи) Тазалық, сауда және т.б.
Dialogue: 0,0:33:53.61,0:33:55.65,Default,,0,0,0,,Бұл да көмектеседі
Dialogue: 0,0:33:55.74,0:33:59.95,Default,,0,0,0,,Ах, Юи, біз жақында тамақтанамыз.
Dialogue: 0,0:34:00.03,0:34:01.16,Default,,0,0,0,,(Шие) Мм.
Dialogue: 0,0:34:03.16,0:34:04.37,Default,,0,0,0,,Фу…
Dialogue: 0,0:34:06.62,0:34:07.62,Default,,0,0,0,,Кірейік
Dialogue: 0,0:34:07.71,0:34:08.83,Default,,0,0,0,,(Шие) Мм.
Dialogue: 0,0:34:35.32,0:34:38.45,Default,,0,0,0,,Бұл маусымдық күнтізбені пайдалану оңай.
Dialogue: 0,0:34:38.53,0:34:39.61,Default,,0,0,0,,(Шие) Мм.
Dialogue: 0,0:34:41.70,0:34:44.20,Default,,0,0,0,,Бұл менің әкемдікі ғой.
Dialogue: 0,0:34:44.29,0:34:45.79,Default,,0,0,0,,Оны мұқият пайдаланыңыз
Dialogue: 0,0:34:45.87,0:34:47.58,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:34:50.67,0:34:53.29,Default,,0,0,0,,(Койчи) Юи қозғалуды жек көрмейді ме? ‬
Dialogue: 0,0:34:53.38,0:34:54.21,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:34:54.30,0:34:56.30,Default,,0,0,0,,(Койчи) Мен барған сайын жинап жатырмын.
Dialogue: 0,0:34:58.63,0:35:00.68,Default,,0,0,0,,Ол еш жерде өзгермейді
Dialogue: 0,0:35:00.76,0:35:02.30,Default,,0,0,0,,Смартфоныңыз болса
Dialogue: 0,0:35:03.97,0:35:08.14,Default,,0,0,0,,Анамның үлесін қосқаныңызға рахмет.
Dialogue: 0,0:35:08.23,0:35:09.14,Default,,0,0,0,,(шие) бөлек
Dialogue: 0,0:35:09.23,0:35:11.85,Default,,0,0,0,,Сіз де абай болғаныңыз жөн.
Dialogue: 0,0:35:11.94,0:35:13.06,Default,,0,0,0,,(Шие) Мм.
Dialogue: 0,0:35:13.90,0:35:15.23,Default,,0,0,0,,Бұл тамақ.
Dialogue: 0,0:35:15.32,0:35:16.40,Default,,0,0,0,,(Шие) Ммм...
Dialogue: 0,0:35:29.75,0:35:31.92,Default,,0,0,0,,Әй, бұрынғы хайку
Dialogue: 0,0:35:34.13,0:35:35.38,Default,,0,0,0,,Хехе
Dialogue: 0,0:35:36.13,0:35:37.76,Default,,0,0,0,,(Сае) Юки
Dialogue: 0,0:35:37.84,0:35:39.09,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:35:39.17,0:35:41.30,Default,,0,0,0,,Тамақтану кезінде смартфондарға рұқсат етілмейді
Dialogue: 0,0:35:41.38,0:35:42.59,Default,,0,0,0,,Иә
Dialogue: 0,0:35:44.30,0:35:45.35,Default,,0,0,0,,(Sae) Хмм...
Dialogue: 0,0:35:45.97,0:35:47.60,Default,,0,0,0,,(Сае) Әке де! (Канта) Иә? ‬
Dialogue: 0,0:35:50.85,0:35:52.10,Default,,0,0,0,,(Шие) Ана
Dialogue: 0,0:35:52.19,0:35:53.15,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:35:53.23,0:35:55.69,Default,,0,0,0,,(Шие) Шынайы, тоқтатыңыз, маған тәтті беріңіз.
Dialogue: 0,0:35:55.77,0:35:58.15,Default,,0,0,0,,Неге?
Dialogue: 0,0:35:58.23,0:36:01.53,Default,,0,0,0,,Мен ғана ұнатамын ба?
Dialogue: 0,0:36:01.61,0:36:03.07,Default,,0,0,0,,Huh hun (смартфон хабарландыру дыбысы)
Dialogue: 0,0:36:07.20,0:36:08.58,Default,,0,0,0,,(Шие) Иә! (Мария/Койчи) Иә? ‬
Dialogue: 0,0:36:08.66,0:36:10.00,Default,,0,0,0,,(Шие) А... Ах.
Dialogue: 0,0:36:10.08,0:36:12.37,Default,,0,0,0,,Тамақтану кезінде смартфонды пайдалануды тоқтатыңыз
Dialogue: 0,0:36:12.46,0:36:14.04,Default,,0,0,0,,(Шие) Жоқ, сәл күте тұрыңыз.
Dialogue: 0,0:36:16.42,0:36:17.71,Default,,0,0,0,,Күлімсіреу…
Dialogue: 0,0:36:20.09,0:36:20.92,Default,,0,0,0,,(Смартфон хабарландыру дыбысы)
Dialogue: 0,0:36:21.84,0:36:22.84,Default,,0,0,0,,(Шие) Не...? ‬
Dialogue: 0,0:36:22.93,0:36:26.05,Default,,0,0,0,,Юки-чан, мен түсінбеймін. Маған осындай нәрсе істеу керек. Ах! Эй Мари!
Dialogue: 0,0:36:26.14,0:36:28.06,Default,,0,0,0,,Екеуің де жеулерің керек! ‬
Dialogue: 0,0:36:28.14,0:36:33.39,Default,,0,0,0,,(Шие) Бұл... бұл менің артымнан жүру керек дегенді білдіре ме? ‬
Dialogue: 0,0:36:37.23,0:36:38.07,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:36:38.15,0:36:39.69,Default,,0,0,0,,Жауап жіберілді
Dialogue: 0,0:36:39.78,0:36:41.03,Default,,0,0,0,,Джури-чан әлдеқашан (смартфонның хабарландыру дыбысы)
Dialogue: 0,0:36:41.11,0:36:42.49,Default,,0,0,0,,А, менің артымнан ерді.
Dialogue: 0,0:36:42.57,0:36:43.70,Default,,0,0,0,,Өтірік! Апыр-ай! ‬
Dialogue: 0,0:36:43.78,0:36:44.95,Default,,0,0,0,,(Мари Юри) Ах.
Dialogue: 0,0:36:46.16,0:36:48.08,Default,,0,0,0,,(Сае) Ммм... (Канта) А? ‬
Dialogue: 0,0:36:48.62,0:36:50.66,Default,,0,0,0,,(Мари Юри) Хэхехехе... (Канта) Хэ~
Dialogue: 0,0:36:50.75,0:36:51.87,Default,,0,0,0,,Хехе
Dialogue: 0,0:36:51.95,0:36:53.29,Default,,0,0,0,,(Смартфон хабарландыру дыбысы)
Dialogue: 0,0:36:56.08,0:36:57.08,Default,,0,0,0,,(шие) табан
Dialogue: 0,0:36:57.88,0:37:02.88,Default,,0,0,0,,♪～
Dialogue: 0,0:39:27.65,0:39:33.45,Default,,0,0,0,,～♪
Dialogue: 0,0:39:57.10,0:40:00.35,Default,,0,0,0,,♪ «Одаяма Дарума Ондо»
Dialogue: 0,0:40:17.87,0:40:22.16,Default,,0,0,0,,Биыл тағы да сауда орталығының жазғы фестивалінде Daruma Ondo әнін орындаймыз.
Dialogue: 0,0:40:22.75,0:40:24.92,Default,,0,0,0,,Барлығымыз қолымыздан келгеннің бәрін жасайық
Dialogue: 0,0:40:25.00,0:40:26.79,Default,,0,0,0,,(Барлығы) Иә.
Dialogue: 0,0:40:27.50,0:40:29.76,Default,,0,0,0,,Мен мұны көптен бері ойлап жүрдім.
Dialogue: 0,0:40:29.84,0:40:32.51,Default,,0,0,0,,Бұл ән тым ақсақ емес пе? ‬
Dialogue: 0,0:40:32.59,0:40:36.80,Default,,0,0,0,,Әй, бұл растикалық...
Dialogue: 0,0:40:36.89,0:40:38.39,Default,,0,0,0,,Нами-сан!?
Dialogue: 0,0:40:38.47,0:40:39.56,Default,,0,0,0,,(Акико) Иә? ‬
Dialogue: 0,0:40:39.64,0:40:40.60,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:40:40.68,0:40:45.65,Default,,0,0,0,,Уф... бұл әнді тыңдағанда көптеген естеліктер оралады.
Dialogue: 0,0:40:46.86,0:40:49.11,Default,,0,0,0,,Не болды? ‬
Dialogue: 0,0:40:49.19,0:40:52.65,Default,,0,0,0,,Таза таза еді...
Dialogue: 0,0:40:56.99,0:41:00.08,Default,,0,0,0,,Фудзияма-чан, бүгін шаттл көлігі күні.
Dialogue: 0,0:41:00.16,0:41:01.50,Default,,0,0,0,,Хохо
Dialogue: 0,0:41:01.58,0:41:03.08,Default,,0,0,0,,Шие жымиды
Dialogue: 0,0:41:03.16,0:41:07.25,Default,,0,0,0,,Акико көлігін артқы есікке қойды, сондықтан Фудзияма-чан жүр!
Dialogue: 0,0:41:07.33,0:41:08.50,Default,,0,0,0,,Иә (шие) иә
Dialogue: 0,0:41:32.57,0:41:35.57,Default,,0,0,0,,Фудзияма жазбалары? ‬
Dialogue: 0,0:41:36.20,0:41:37.32,Default,,0,0,0,,(Күлімсіреу Шие) Ах.
Dialogue: 0,0:41:54.13,0:41:55.76,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:41:57.26,0:42:00.76,Default,,0,0,0,,Таңқаларлық, бұл не?
Dialogue: 0,0:42:24.79,0:42:28.58,Default,,0,0,0,,Бұл жазбалардың барлығы ма? ‬
Dialogue: 0,0:42:28.67,0:42:30.08,Default,,0,0,0,,Мұнда бірінші рет келіп тұрсыз ба? ‬
Dialogue: 0,0:42:30.17,0:42:32.13,Default,,0,0,0,,(Шие) Ішке не кірді
Dialogue: 0,0:42:40.22,0:42:46.64,Default,,0,0,0,,Бұл жазба мен ең көп тыңдаған жазба.
Dialogue: 0,0:42:48.89,0:42:53.27,Default,,0,0,0,,қайта-қайта
Dialogue: 0,0:42:58.78,0:43:02.03,Default,,0,0,0,,Мен оны қайта тыңдағым келеді
Dialogue: 0,0:43:03.53,0:43:05.58,Default,,0,0,0,,Қайта тыңдасаңыз‎⸺
Dialogue: 0,0:43:07.12,0:43:08.66,Default,,0,0,0,,Есте сақтау
Dialogue: 0,0:43:09.46,0:43:10.42,Default,,0,0,0,,Не? ‬
Dialogue: 0,0:43:14.46,0:43:16.46,Default,,0,0,0,,Ұмытқым келмейді
Dialogue: 0,0:43:18.42,0:43:20.43,Default,,0,0,0,,Мен есімде жоқ
Dialogue: 0,0:43:22.18,0:43:23.51,Default,,0,0,0,,(2 адам) Ха! ‬
Dialogue: 0,0:43:23.60,0:43:25.68,Default,,0,0,0,,Мен есімде жоқ...
Dialogue: 0,0:43:36.03,0:43:37.28,Default,,0,0,0,,Рахмет
Dialogue: 0,0:43:40.15,0:43:42.20,Default,,0,0,0,,«ЯМАЗАКУРА»
Dialogue: 0,0:43:42.82,0:43:44.33,Default,,0,0,0,,Тесік бар
Dialogue: 0,0:43:46.91,0:43:47.95,Default,,0,0,0,,Ах
Dialogue: 0,0:43:48.62,0:43:50.21,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:43:51.21,0:43:52.04,Default,,0,0,0,,Ха! ‬
Dialogue: 0,0:43:53.21,0:43:54.63,Default,,0,0,0,,Ішінде бірдеңе бар
Dialogue: 0,0:43:59.97,0:44:01.13,Default,,0,0,0,,Бұл...
Dialogue: 0,0:44:03.43,0:44:04.26,Default,,0,0,0,,Ах
Dialogue: 0,0:44:05.30,0:44:08.81,Default,,0,0,0,,Қоштасу ешқашан айтылмайды
Dialogue: 0,0:44:08.89,0:44:10.27,Default,,0,0,0,,Сакура биі
Dialogue: 0,0:44:11.23,0:44:12.44,Default,,0,0,0,,Хайку? ‬
Dialogue: 0,0:44:13.27,0:44:17.90,Default,,0,0,0,,Қоштасу ешқашан айтылмайды...
Dialogue: 0,0:44:18.53,0:44:20.90,Default,,0,0,0,,Сакура биі
Dialogue: 0,0:44:28.99,0:44:29.95,Default,,0,0,0,,Мен оны іздеймін
Dialogue: 0,0:44:30.04,0:44:31.12,Default,,0,0,0,,Фудзияма мырза
Dialogue: 0,0:44:31.21,0:44:32.16,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:44:32.25,0:44:34.96,Default,,0,0,0,,Мен де жазбаларды іздеймін.
Dialogue: 0,0:44:36.63,0:44:37.84,Default,,0,0,0,,Мен де
Dialogue: 0,0:44:39.00,0:44:40.51,Default,,0,0,0,,Мен сізге тыңдауға рұқсат еткім келеді.
Dialogue: 0,0:44:41.84,0:44:43.76,Default,,0,0,0,,Есте сақтағаныңызды қалаймын
Dialogue: 0,0:44:43.84,0:44:47.47,Default,,0,0,0,,Фудзияманың атасы туралы құнды естеліктер
Dialogue: 0,0:44:50.31,0:44:52.06,Default,,0,0,0,,А... а
Dialogue: 0,0:44:52.69,0:44:54.40,Default,,0,0,0,,Жақсысың ба? не болды? ‬
Dialogue: 0,0:44:54.48,0:44:56.69,Default,,0,0,0,,Фудзияманың атасы? ‬
Dialogue: 0,0:44:56.77,0:44:58.65,Default,,0,0,0,,Фудзияманың атасы! ‬
Dialogue: 0,0:44:58.73,0:44:59.65,Default,,0,0,0,,Әке? ‬
Dialogue: 0,0:45:00.78,0:45:02.28,Default,,0,0,0,,Әке! ‬
Dialogue: 0,0:45:18.25,0:45:21.51,Default,,0,0,0,,Амансың ба, Фудзияма ата?
Dialogue: 0,0:45:22.13,0:45:23.22,Default,,0,0,0,,(Шие) Иә.
Dialogue: 0,0:45:24.93,0:45:27.93,Default,,0,0,0,,Фудзияманың атасы іздеп жүрген жазба қандай?
Dialogue: 0,0:45:28.68,0:45:30.89,Default,,0,0,0,,Бұл дүкенде емес пе? ‬
Dialogue: 0,0:45:32.14,0:45:33.23,Default,,0,0,0,,(Шие) Иә.
Dialogue: 0,0:45:34.73,0:45:39.06,Default,,0,0,0,,Бірақ сіз неге үнемі сауда орталығының айналасында іздедіңіз?
Dialogue: 0,0:45:42.28,0:45:44.40,Default,,0,0,0,,Бұл мен...
Dialogue: 0,0:45:44.49,0:45:45.78,Default,,0,0,0,,Бұл туралы айтатын болсақ
Dialogue: 0,0:45:47.99,0:45:49.74,Default,,0,0,0,,Соңғы кездері киген жоқпын.
Dialogue: 0,0:45:54.75,0:45:55.79,Default,,0,0,0,,Иә
Dialogue: 0,0:45:57.37,0:45:58.79,Default,,0,0,0,,Бұл қажет емес...
Dialogue: 0,0:45:58.88,0:45:59.92,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:46:00.42,0:46:01.63,Default,,0,0,0,,(Шие) Ой-оу.
Dialogue: 0,0:46:07.09,0:46:08.14,Default,,0,0,0,,Йо
Dialogue: 0,0:46:16.39,0:46:18.69,Default,,0,0,0,,«ЯМАЗАКУРА»
Dialogue: 0,0:46:31.49,0:46:33.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:36.16,0:46:37.41,Default,,0,0,0,,Бұл жазба‎⸺
Dialogue: 0,0:46:38.04,0:46:40.83,Default,,0,0,0,,Қыздың күртешедегі киімі сүйкімді болды.
Dialogue: 0,0:46:40.92,0:46:42.54,Default,,0,0,0,,Мен суретті іздеуге тырыстым
Dialogue: 0,0:46:44.21,0:46:46.55,Default,,0,0,0,,Шамамен 50 жыл бұрын танымал болған киімдерге ұқсайды
Dialogue: 0,0:46:46.63,0:46:48.59,Default,,0,0,0,,(Шие) Демек, жазбалар да сол дәуірден? ‬
Dialogue: 0,0:46:49.22,0:46:52.05,Default,,0,0,0,,Сіз Фудзияма мырза туралы айтып отырсыз ба?
Dialogue: 0,0:46:52.14,0:46:55.85,Default,,0,0,0,,Бұрын осында жұмыс істеген көрінеді.
Dialogue: 0,0:46:55.93,0:46:57.14,Default,,0,0,0,,Сауда орталығында? ‬
Dialogue: 0,0:46:57.23,0:46:58.52,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:46:58.60,0:47:02.61,Default,,0,0,0,,(Hyodo) Бұл бұрын рекордтық престеу зауыты болған.
Dialogue: 0,0:47:02.69,0:47:03.90,Default,,0,0,0,,(2 адам) Ха! ‬
Dialogue: 0,0:47:26.96,0:47:29.05,Default,,0,0,0,,Бұл Дарума фестивалінің постері.
Dialogue: 0,0:47:30.80,0:47:33.10,Default,,0,0,0,,Бірінші шоудан бастап біз отшашуды жасап жатырмыз.
Dialogue: 0,0:47:33.18,0:47:34.30,Default,,0,0,0,,(Шие) Дұрыс.
Dialogue: 0,0:47:34.89,0:47:37.64,Default,,0,0,0,,Биыл 56-шы рет...
Dialogue: 0,0:47:37.72,0:47:40.06,Default,,0,0,0,,Бұл шамамен 50 жыл бойы жалғасуда.
Dialogue: 0,0:47:40.14,0:47:41.27,Default,,0,0,0,,Ах
Dialogue: 0,0:47:42.52,0:47:45.32,Default,,0,0,0,,(Бұрынғы Пури) Пресс зауытында жұмыс істеген адам...
Dialogue: 0,0:47:45.98,0:47:47.19,Default,,0,0,0,,? ‬
Dialogue: 0,0:47:47.28,0:47:50.24,Default,,0,0,0,,Өткенді білетін адам бар ма?
Dialogue: 0,0:47:50.32,0:47:51.49,Default,,0,0,0,,(Бұрынғы Пури) Хмм...
Dialogue: 0,0:47:52.07,0:47:53.78,Default,,0,0,0,,Білетіндер бар ма? ‬
Dialogue: 0,0:47:53.87,0:47:55.16,Default,,0,0,0,,(Күзетші) Ал...
Dialogue: 0,0:47:55.24,0:47:56.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:57.33,0:47:58.66,Default,,0,0,0,,(Күзетші) Ойланып көріңізші.
Dialogue: 0,0:47:58.75,0:48:01.54,Default,,0,0,0,,Неге үшінші қабаттағы тапсыруға бармайсың? ‬
Dialogue: 0,0:48:01.62,0:48:04.79,Default,,0,0,0,,Олар сол жерде пайдаланылған жазбаларды сатады, солай ма?
Dialogue: 0,0:48:05.63,0:48:09.55,Default,,0,0,0,,Менде «ЯМАЗАКУРА» жазбасы жоқ.
Dialogue: 0,0:48:09.63,0:48:11.51,Default,,0,0,0,,Мен...
Dialogue: 0,0:48:11.59,0:48:13.14,Default,,0,0,0,,Әй, бірақ! ‬
Dialogue: 0,0:48:13.22,0:48:17.56,Default,,0,0,0,,Мүмкін бұл жазба сурет шығарылымы шығар.
Dialogue: 0,0:48:17.64,0:48:18.93,Default,,0,0,0,,Сурет дискісі? ‬
Dialogue: 0,0:48:19.73,0:48:21.69,Default,,0,0,0,,Мынадай.
Dialogue: 0,0:48:21.77,0:48:23.56,Default,,0,0,0,,Мынау не деген сүйкімді?
Dialogue: 0,0:48:23.65,0:48:24.94,Default,,0,0,0,,Дұрыс! ‬
Dialogue: 0,0:48:25.02,0:48:27.90,Default,,0,0,0,,Бұл Хикарунның шектеулі басылымы жазбасы.
Dialogue: 0,0:48:28.65,0:48:30.69,Default,,0,0,0,,Сурет дискілері үшін курткадағы тесікті тесіңіз‎⸺
Dialogue: 0,0:48:30.78,0:48:33.91,Default,,0,0,0,,Мазмұны жиі көрінеді.
Dialogue: 0,0:48:34.49,0:48:37.87,Default,,0,0,0,,Сол суреттегінің де ортасында тесік бар.
Dialogue: 0,0:48:37.95,0:48:39.49,Default,,0,0,0,,көремін.
Dialogue: 0,0:48:39.58,0:48:41.20,Default,,0,0,0,,Жапония мырза керемет
Dialogue: 0,0:48:41.29,0:48:42.37,Default,,0,0,0,,Ал, хахаха...
Dialogue: 0,0:48:42.46,0:48:45.00,Default,,0,0,0,,Не? Қазына іздеу? ‬
Dialogue: 0,0:48:45.08,0:48:46.46,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:48:46.54,0:48:48.92,Default,,0,0,0,,Е! Мен де мен де! ‬
Dialogue: 0,0:48:49.80,0:48:50.96,Default,,0,0,0,,Сурет дискінің қандай түріне жатады?
Dialogue: 0,0:48:51.05,0:48:52.97,Default,,0,0,0,,Бұл рекорд сияқты.
Dialogue: 0,0:48:54.47,0:48:56.64,Default,,0,0,0,,Біреу біледі ме?
Dialogue: 0,0:49:02.81,0:49:06.19,Default,,0,0,0,,Хмм, мен әлі түсінбеймін.
Dialogue: 0,0:49:09.44,0:49:10.65,Default,,0,0,0,,(Шие) А...
Dialogue: 0,0:49:10.73,0:49:12.99,Default,,0,0,0,,Мабусе тауындағы радио мұнарасы? ‬
Dialogue: 0,0:49:56.91,0:49:58.45,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:50:00.83,0:50:01.83,Default,,0,0,0,,Ах
Dialogue: 0,0:50:03.58,0:50:04.62,Default,,0,0,0,,Бұл
Dialogue: 0,0:50:04.71,0:50:05.79,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:50:06.46,0:50:07.29,Default,,0,0,0,,Ах! ‬
Dialogue: 0,0:50:16.22,0:50:17.05,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:50:18.84,0:50:22.43,Default,,0,0,0,,«Ода қаласынан келген әнші-композитор»
Dialogue: 0,0:50:22.51,0:50:25.52,Default,,0,0,0,,«Фудзияма Сакура-сан, 22 жаста»
Dialogue: 0,0:50:26.06,0:50:28.98,Default,,0,0,0,,«Соңғы жазба «ЯМАЗАКУРА»»
Dialogue: 0,0:50:29.86,0:50:31.98,Default,,0,0,0,,Бұл адамның тегі...
Dialogue: 0,0:50:32.07,0:50:33.07,Default,,0,0,0,,Иә
Dialogue: 0,0:50:34.03,0:50:35.44,Default,,0,0,0,,Фудзияма…
Dialogue: 0,0:50:37.11,0:50:38.57,Default,,0,0,0,,Ана
Dialogue: 0,0:50:40.57,0:50:45.66,Default,,0,0,0,,Сонымен, бұл Фудзияманың атасының әйелі ме? ‬
Dialogue: 0,0:50:45.75,0:50:46.62,Default,,0,0,0,,Иә
Dialogue: 0,0:50:47.96,0:50:52.38,Default,,0,0,0,,Сіздің анаңыз шынымен де музыкант болған емес пе?
Dialogue: 0,0:50:53.59,0:50:55.84,Default,,0,0,0,,Мына Сакура-сан ше? ‬
Dialogue: 0,0:50:56.63,0:51:01.01,Default,,0,0,0,,Ол мені босанғаннан кейін көп ұзамай аурудан қайтыс болды.
Dialogue: 0,0:51:01.09,0:51:05.27,Default,,0,0,0,,Бұл есіме түспес бұрын болды, сондықтан мен мүлде жоқ едім.
Dialogue: 0,0:51:07.43,0:51:09.90,Default,,0,0,0,,Әкемнің дүкені де.
Dialogue: 0,0:51:09.98,0:51:13.40,Default,,0,0,0,,Ол мұны анасының жазбаларын сату үшін бастағанын айтты.
Dialogue: 0,0:51:13.48,0:51:14.82,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:51:17.36,0:51:20.86,Default,,0,0,0,,Негізі мен осы демалыс күндері дүкенді жабамын.
Dialogue: 0,0:51:22.91,0:51:26.29,Default,,0,0,0,,Өйткені ол ескіреді және ешкім иемденбейді.
Dialogue: 0,0:51:26.95,0:51:30.21,Default,,0,0,0,,Дәл қазір Ясуюки жинап жатыр.
Dialogue: 0,0:51:32.75,0:51:34.88,Default,,0,0,0,,Қарғыс атсын, Далли.
Dialogue: 0,0:51:34.96,0:51:36.30,Default,,0,0,0,,Мияу
Dialogue: 0,0:51:36.38,0:51:37.88,Default,,0,0,0,,Ол ілгерілеуде ме? ‬
Dialogue: 0,0:51:37.96,0:51:39.88,Default,,0,0,0,,(Қатты бала) Ол дұрыс істеп жатыр.
Dialogue: 0,0:51:39.97,0:51:41.43,Default,,0,0,0,,Иә? Балалар сендер
Dialogue: 0,0:51:41.51,0:51:43.30,Default,,0,0,0,,Не болды?
Dialogue: 0,0:51:43.89,0:51:45.22,Default,,0,0,0,,(Шие) Эй
Dialogue: 0,0:51:45.31,0:51:46.97,Default,,0,0,0,,Бір сәт? ‬
Dialogue: 0,0:51:55.52,0:51:57.48,Default,,0,0,0,,Фудзияманың атасы
Dialogue: 0,0:51:58.90,0:52:01.49,Default,,0,0,0,,Сакура-санның дауысын естігің келеді деп ойлаймын.
Dialogue: 0,0:52:02.49,0:52:05.24,Default,,0,0,0,,Сондықтан мен жазбаларды іздедім.
Dialogue: 0,0:52:09.87,0:52:11.25,Default,,0,0,0,,(шие) бұл
Dialogue: 0,0:52:11.87,0:52:12.96,Default,,0,0,0,,Мен...
Dialogue: 0,0:52:16.09,0:52:19.71,Default,,0,0,0,,Жазбаларды біріктіруге болады ма? ‬
Dialogue: 0,0:52:19.80,0:52:21.63,Default,,0,0,0,,Не? (Қатты бала) Иә? ‬
Dialogue: 0,0:52:21.72,0:52:23.43,Default,,0,0,0,,Мүмкін осында
Dialogue: 0,0:52:23.51,0:52:26.10,Default,,0,0,0,,Фудзияма мырза іздеп жүрген жазба болуы мүмкін.
Dialogue: 0,0:52:26.18,0:52:28.22,Default,,0,0,0,,(Қатты бала) Ей, эй, күте тұр... мен де! ‬
Dialogue: 0,0:52:28.31,0:52:29.64,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:52:35.15,0:52:36.65,Default,,0,0,0,,Іс жүзінде
Dialogue: 0,0:52:39.40,0:52:41.11,Default,,0,0,0,,Мен де іздедім
Dialogue: 0,0:52:43.78,0:52:45.82,Default,,0,0,0,,Бірақ мен оны таба алмаймын
Dialogue: 0,0:52:49.12,0:52:51.08,Default,,0,0,0,,Бәріміз іздесек...
Dialogue: 0,0:52:51.71,0:52:53.33,Default,,0,0,0,,Сіз оны таба аласыз ба?
Dialogue: 0,0:52:54.96,0:52:56.04,Default,,0,0,0,,Иә
Dialogue: 0,0:52:56.96,0:52:59.09,Default,,0,0,0,,Бізге де Бивер мен Жапониядан көмек сұрайық.
Dialogue: 0,0:52:59.17,0:53:00.17,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:53:00.26,0:53:01.67,Default,,0,0,0,,(Қатал бала) Эй, сәл күте тұрыңыз.
Dialogue: 0,0:53:02.26,0:53:05.47,Default,,0,0,0,,Ата қандай жазба іздейді?
Dialogue: 0,0:53:06.22,0:53:08.10,Default,,0,0,0,,Сіз де естігіңіз келеді, солай ма? ‬
Dialogue: 0,0:53:08.18,0:53:10.31,Default,,0,0,0,,Әженің дауысы
Dialogue: 0,0:53:19.19,0:53:22.11,Default,,0,0,0,,(цикада дыбысы)
Dialogue: 0,0:53:43.88,0:53:45.18,Default,,0,0,0,,А...
Dialogue: 0,0:53:47.05,0:53:49.43,Default,,0,0,0,,Хмм... ыстық.
Dialogue: 0,0:53:49.51,0:53:50.89,Default,,0,0,0,,Шынымен
Dialogue: 0,0:53:50.97,0:53:52.56,Default,,0,0,0,,(құндыз) қатты ериді
Dialogue: 0,0:53:52.64,0:53:54.06,Default,,0,0,0,,(Қатты бала) Оған көмектесу мүмкін емес.
Dialogue: 0,0:53:54.14,0:53:56.19,Default,,0,0,0,,Кондиционер толығымен бұзылған.
Dialogue: 0,0:53:56.27,0:53:58.69,Default,,0,0,0,,Желдеткішті пайдаланыңыз
Dialogue: 0,0:53:58.77,0:54:00.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:00.94,0:54:02.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:54:03.53,0:54:04.95,Default,,0,0,0,,(Шие) Оны алып тастасам ше? ‬
Dialogue: 0,0:54:06.53,0:54:08.41,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:54:08.49,0:54:10.83,Default,,0,0,0,,Хо... шаң керемет емес пе? ‬
Dialogue: 0,0:54:10.91,0:54:11.95,Default,,0,0,0,,(Шие) Иә...
Dialogue: 0,0:54:12.04,0:54:15.12,Default,,0,0,0,,Барлығы кеспе алуға келді.
Dialogue: 0,0:54:15.21,0:54:16.83,Default,,0,0,0,,Меши! ‬
Dialogue: 0,0:54:16.92,0:54:19.33,Default,,0,0,0,,(кеспенің шырылдаған дыбысы)
Dialogue: 0,0:54:23.00,0:54:25.26,Default,,0,0,0,,Мына күлімсіреу ше? ‬
Dialogue: 0,0:54:25.34,0:54:27.80,Default,,0,0,0,,Мен диетадамын деп ойлаймын.
Dialogue: 0,0:54:43.07,0:54:46.74,Default,,0,0,0,,Ах~ Мен өмірге қайта оралдым
Dialogue: 0,0:54:46.82,0:54:48.28,Default,,0,0,0,,(іштің айқайлауы)
Dialogue: 0,0:54:55.37,0:54:57.66,Default,,0,0,0,,Жазба жоқ
Dialogue: 0,0:54:58.62,0:55:00.58,Default,,0,0,0,,(Шие) Әлі жартысы қалды.
Dialogue: 0,0:55:18.56,0:55:19.98,Default,,0,0,0,,(Шие) А...
Dialogue: 0,0:55:38.20,0:55:39.41,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:55:57.06,0:55:57.89,Default,,0,0,0,,Ах
Dialogue: 0,0:55:58.93,0:56:00.48,Default,,0,0,0,,«Ямазакура»
Dialogue: 0,0:56:02.73,0:56:05.98,Default,,0,0,0,,«Өйткені жапырақтар гүлден бұрын пайда болады»
Dialogue: 0,0:56:06.07,0:56:10.82,Default,,0,0,0,,«Тіс тістері бар адамдарды Ямазакура деп атайды».
Dialogue: 0,0:56:28.67,0:56:32.51,Default,,0,0,0,,Сакура-сан не ойлады?
Dialogue: 0,0:56:38.14,0:56:38.97,Default,,0,0,0,,Ах
Dialogue: 0,0:56:39.85,0:56:41.98,Default,,0,0,0,,Черри-кунның жаңа хайкусы
Dialogue: 0,0:57:57.64,0:58:00.47,Default,,0,0,0,,(Құндыз) А-а-а мм? ‬
Dialogue: 0,0:58:02.31,0:58:04.98,Default,,0,0,0,,(Құндыз) Ах Ах Ах (Қатты бала) Иа...
Dialogue: 0,0:58:14.57,0:58:15.74,Default,,0,0,0,,(Құндыз) Уа
Dialogue: 0,0:58:19.57,0:58:21.53,Default,,0,0,0,,(Барлығы) А...
Dialogue: 0,0:58:23.20,0:58:25.75,Default,,0,0,0,,(Қатал бала) Өйткені, солай емес пе?
Dialogue: 0,0:58:36.47,0:58:39.05,Default,,0,0,0,,Рахмет, Черри-кун
Dialogue: 0,0:58:39.14,0:58:40.85,Default,,0,0,0,,Смайл-чан да
Dialogue: 0,0:58:54.98,0:58:56.74,Default,,0,0,0,,(дыбысты өшіру)
Dialogue: 0,0:58:56.82,0:58:58.03,Default,,0,0,0,,Мияу
Dialogue: 0,0:58:58.11,0:58:59.86,Default,,0,0,0,,Ясуюки
Dialogue: 0,0:58:59.95,0:59:02.53,Default,,0,0,0,,Тоңазытқыш пен желдеткішті де тазалай аласыз ба? ‬
Dialogue: 0,0:59:02.62,0:59:04.29,Default,,0,0,0,,(Қатты бала) Иә? ‬
Dialogue: 0,0:59:04.37,0:59:05.91,Default,,0,0,0,,Ертең ақыры
Dialogue: 0,0:59:06.00,0:59:07.37,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:59:10.63,0:59:11.67,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:59:25.22,0:59:26.52,Default,,0,0,0,,(Шие) солай емес пе?
Dialogue: 0,0:59:33.94,0:59:35.15,Default,,0,0,0,,Боқ
Dialogue: 0,0:59:41.82,0:59:42.87,Default,,0,0,0,,Ах
Dialogue: 0,0:59:42.95,0:59:44.99,Default,,0,0,0,,(Шие) Ха! иә? ‬
Dialogue: 0,0:59:45.08,0:59:46.54,Default,,0,0,0,,Не болды? ‬
Dialogue: 0,0:59:53.04,0:59:54.50,Default,,0,0,0,,(Шие күлімсірейді) Ах! (Құндыздар) Иә? ‬
Dialogue: 0,0:59:56.92,0:59:57.96,Default,,0,0,0,,Міне болды! ‬
Dialogue: 0,1:00:00.80,1:00:02.43,Default,,0,0,0,,(Шие) Иә, болды.
Dialogue: 0,1:00:03.01,1:00:04.26,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:00:04.35,1:00:06.85,Default,,0,0,0,,әке әке
Dialogue: 0,1:00:06.93,1:00:08.18,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:00:17.82,1:00:18.86,Default,,0,0,0,,Сакура…
Dialogue: 0,1:00:18.94,1:00:20.15,Default,,0,0,0,,Хехе
Dialogue: 0,1:00:20.24,1:00:22.24,Default,,0,0,0,,Мен оны Жапония мырзаға шақырамын.
Dialogue: 0,1:00:24.62,1:00:25.95,Default,,0,0,0,,Рахмет
Dialogue: 0,1:00:26.03,1:00:27.66,Default,,0,0,0,,Хмм...
Dialogue: 0,1:00:28.66,1:00:30.66,Default,,0,0,0,,Динамик коды дегеніміз не? ‬
Dialogue: 0,1:00:30.75,1:00:32.96,Default,,0,0,0,,(Шие) А, бұл подъезде болуы мүмкін.
Dialogue: 0,1:00:40.88,1:00:41.92,Default,,0,0,0,,Ах
Dialogue: 0,1:00:44.30,1:00:45.47,Default,,0,0,0,,Хехе
Dialogue: 0,1:00:47.14,1:00:48.26,Default,,0,0,0,,(шие) болды
Dialogue: 0,1:00:49.14,1:00:50.31,Default,,0,0,0,,Сәлем
Dialogue: 0,1:00:50.85,1:00:52.23,Default,,0,0,0,,Қараңыз және қараңыз
Dialogue: 0,1:00:55.10,1:00:56.36,Default,,0,0,0,,(шие) отшашуы…
Dialogue: 0,1:00:57.11,1:00:58.48,Default,,0,0,0,,Сүйкімді емес пе? ‬
Dialogue: 0,1:00:58.57,1:01:00.36,Default,,0,0,0,,(Шие) Сүйкімді ме? ‬
Dialogue: 0,1:01:00.44,1:01:01.61,Default,,0,0,0,,Иә! ‬
Dialogue: 0,1:01:06.16,1:01:07.70,Default,,0,0,0,,Дарума фестивалі…
Dialogue: 0,1:01:10.95,1:01:12.08,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,1:01:12.16,1:01:13.37,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:17.00,1:01:18.50,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:01:22.13,1:01:23.38,Default,,0,0,0,,Отшашу…
Dialogue: 0,1:01:28.01,1:01:30.39,Default,,0,0,0,,Бірге барып көрейік пе? ‬
Dialogue: 0,1:01:42.94,1:01:44.15,Default,,0,0,0,,(шие) бұл
Dialogue: 0,1:01:49.91,1:01:50.95,Default,,0,0,0,,(Шие) Мен... Шие! ‬
Dialogue: 0,1:01:51.04,1:01:54.50,Default,,0,0,0,,Кодты тез әкеліңізші.
Dialogue: 0,1:01:54.58,1:01:57.29,Default,,0,0,0,,А, м...
Dialogue: 0,1:01:58.13,1:02:00.50,Default,,0,0,0,,Мен... мен барамын.
Dialogue: 0,1:02:08.30,1:02:10.14,Default,,0,0,0,,Ах! ‬
Dialogue: 0,1:02:10.22,1:02:13.43,Default,,0,0,0,,Уфуфуфуфуфуфуфу…
Dialogue: 0,1:02:13.52,1:02:15.48,Default,,0,0,0,,Ах! ‬
Dialogue: 0,1:02:18.44,1:02:19.44,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:02:22.36,1:02:24.78,Default,,0,0,0,,Толқындар бар ма? ‬
Dialogue: 0,1:02:28.91,1:02:30.24,Default,,0,0,0,,Өйткені
Dialogue: 0,1:02:31.12,1:02:33.45,Default,,0,0,0,,Мен мұны дұрыс ести аламын ба? ‬
Dialogue: 0,1:02:39.54,1:02:40.84,Default,,0,0,0,,Ах! ‬
Dialogue: 0,1:02:45.42,1:02:46.97,Default,,0,0,0,,Өтірік...
Dialogue: 0,1:02:48.76,1:02:50.64,Default,,0,0,0,,(Шие) Күлімсіре! ‬
Dialogue: 0,1:02:51.26,1:02:52.68,Default,,0,0,0,,(Жарылған дыбыс)
Dialogue: 0,1:02:56.02,1:02:57.35,Default,,0,0,0,,Жазбалар туралы не деуге болады? ‬
Dialogue: 0,1:02:57.94,1:02:59.35,Default,,0,0,0,,Не болды? ‬
Dialogue: 0,1:03:21.63,1:03:23.09,Default,,0,0,0,,Қорытынды
Dialogue: 0,1:03:23.17,1:03:26.67,Default,,0,0,0,,Сәлем беру үшін кешке күнге барамын.
Dialogue: 0,1:03:26.76,1:03:28.93,Default,,0,0,0,,Бастыққа да айтыңыз.
Dialogue: 0,1:03:29.55,1:03:30.68,Default,,0,0,0,,(Шие) Иә.
Dialogue: 0,1:03:33.26,1:03:35.68,Default,,0,0,0,,♪ «Одаяма Дарума Ондо»
Dialogue: 0,1:03:45.65,1:03:47.07,Default,,0,0,0,,(Акико/Нами) Иә? ‬
Dialogue: 0,1:03:49.90,1:03:53.87,Default,,0,0,0,,Ал, ертең сағат 7-де біз шатырдың сахнасында өнер көрсетеміз.
Dialogue: 0,1:03:53.95,1:03:55.45,Default,,0,0,0,,(Барлығы) Иә.
Dialogue: 0,1:03:57.62,1:03:58.45,Default,,0,0,0,,Шие-кун
Dialogue: 0,1:04:02.46,1:04:06.30,Default,,0,0,0,,Осыдан кейін мен сенімен бірге келе аламын ба? ‬
Dialogue: 0,1:04:07.42,1:04:13.72,Default,,0,0,0,,Мен Фудзияманың атасынан тағы да кешірім сұрағым келеді.
Dialogue: 0,1:04:15.64,1:04:17.72,Default,,0,0,0,,(Шие) Иә, әрине.
Dialogue: 0,1:04:17.81,1:04:19.23,Default,,0,0,0,,Рахмет
Dialogue: 0,1:04:22.90,1:04:24.06,Default,,0,0,0,,Бұл
Dialogue: 0,1:04:27.57,1:04:28.57,Default,,0,0,0,,Негізі мен де...
Dialogue: 0,1:04:28.65,1:04:30.28,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,1:04:30.36,1:04:31.86,Default,,0,0,0,,О, Мария
Dialogue: 0,1:04:31.95,1:04:34.24,Default,,0,0,0,,(Акико) Көп уақыт өтті.
Dialogue: 0,1:04:34.32,1:04:36.28,Default,,0,0,0,,Көптен бері көрмедім.
Dialogue: 0,1:04:36.37,1:04:39.25,Default,,0,0,0,,(Танака) Беліңіз ше? Қазір жақсысың ба? ‬
Dialogue: 0,1:04:39.33,1:04:41.41,Default,,0,0,0,,Иә, сізге рахмет.
Dialogue: 0,1:04:43.29,1:04:44.88,Default,,0,0,0,,Бұл адам кім? ‬
Dialogue: 0,1:04:44.96,1:04:48.55,Default,,0,0,0,,Менің анам
Dialogue: 0,1:04:49.71,1:04:53.97,Default,,0,0,0,,Баршаңызға, баламды бағып-қаққандарыңызға рахмет.
Dialogue: 0,1:04:55.43,1:04:59.93,Default,,0,0,0,,Сакура-сан, бүгінгі күн үшін көп рахмет.
Dialogue: 0,1:05:00.02,1:05:02.85,Default,,0,0,0,,Марияның шымшуы тамаша болды.
Dialogue: 0,1:05:02.94,1:05:07.15,Default,,0,0,0,,(Акико) Дарума Ондо Бірге билей алмайтынымыз ұят.
Dialogue: 0,1:05:22.33,1:05:23.87,Default,,0,0,0,,(Шие) Жылжыту туралы‎⸺
Dialogue: 0,1:05:24.50,1:05:26.71,Default,,0,0,0,,Үндемегенім үшін кешіріңіз.
Dialogue: 0,1:05:30.71,1:05:32.67,Default,,0,0,0,,Қашан шешілді? ‬
Dialogue: 0,1:05:34.68,1:05:37.60,Default,,0,0,0,,Жазғы демалыс қашан басталады
Dialogue: 0,1:05:45.35,1:05:47.31,Default,,0,0,0,,Ал отшашу туралы не деуге болады? (Шие) А? ‬
Dialogue: 0,1:05:48.56,1:05:50.69,Default,,0,0,0,,Ертең бірге тамашалайық.
Dialogue: 0,1:05:55.24,1:05:56.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:06:06.58,1:06:07.63,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:06:12.67,1:06:16.26,Default,,0,0,0,,Олай болса, сау болыңыз.
Dialogue: 0,1:06:22.64,1:06:23.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:23.93,1:06:27.94,Default,,0,0,0,,(бақа мен құстың дыбысы)
Dialogue: 0,1:06:29.90,1:06:31.19,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:06:40.78,1:06:44.83,Default,,0,0,0,,(жылау)
Dialogue: 0,1:06:50.92,1:06:55.84,Default,,0,0,0,,(Шиенің айқайы)
Dialogue: 0,1:07:13.69,1:07:15.78,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:07:15.86,1:07:17.19,Default,,0,0,0,,Фудзияманың атасы
Dialogue: 0,1:07:17.28,1:07:18.11,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:08:07.04,1:08:08.37,Default,,0,0,0,,Хехе
Dialogue: 0,1:08:17.55,1:08:18.63,Default,,0,0,0,,Ах
Dialogue: 0,1:08:45.49,1:08:46.58,Default,,0,0,0,,Ах
Dialogue: 0,1:09:16.65,1:09:17.90,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:20.02,1:09:25.03,Default,,0,0,0,,(жылау)
Dialogue: 0,1:09:40.96,1:09:45.51,Default,,0,0,0,,(Күлімнің жылауы)
Dialogue: 0,1:09:49.97,1:09:51.47,Default,,0,0,0,,(Сигнал отшашуы)
Dialogue: 0,1:09:57.90,1:10:02.90,Default,,0,0,0,,(Мерекелік музыка)
Dialogue: 0,1:10:08.24,1:10:09.70,Default,,0,0,0,,(Мэр) Олай болса.
Dialogue: 0,1:10:09.78,1:10:15.08,Default,,0,0,0,,Біз 56-шы Одаяма Дарума фестивалін ашық деп жариялаймыз.
Dialogue: 0,1:10:20.04,1:10:22.67,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:10:23.80,1:10:25.01,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:10:31.68,1:10:33.31,Default,,0,0,0,,Ақыры оянды
Dialogue: 0,1:10:37.69,1:10:38.81,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:10:44.53,1:10:45.74,Default,,0,0,0,,Рахмет
Dialogue: 0,1:10:49.91,1:10:50.95,Default,,0,0,0,,Хехе
Dialogue: 0,1:10:51.03,1:10:53.41,Default,,0,0,0,,(жүгіру)
Dialogue: 0,1:10:53.49,1:10:55.12,Default,,0,0,0,,(Есіктің ашылған дыбысы) Эй! ‬
Dialogue: 0,1:10:55.75,1:10:58.33,Default,,0,0,0,,Кел, кел! Хехехе
Dialogue: 0,1:11:00.17,1:11:01.29,Default,,0,0,0,,Ура! ‬
Dialogue: 0,1:11:05.42,1:11:06.76,Default,,0,0,0,,Хехехе
Dialogue: 0,1:11:08.34,1:11:09.59,Default,,0,0,0,,Аха~
Dialogue: 0,1:11:10.22,1:11:11.35,Default,,0,0,0,,Ах
Dialogue: 0,1:11:25.82,1:11:26.94,Default,,0,0,0,,‪‬
Dialogue: 0,1:11:27.03,1:11:28.20,Default,,0,0,0,,О
Dialogue: 0,1:11:29.57,1:11:31.16,Default,,0,0,0,,Иә
Dialogue: 0,1:11:31.24,1:11:33.49,Default,,0,0,0,,(Бизнес-оператор) Arakawa Hikkoshi орталығы
Dialogue: 0,1:11:34.03,1:11:36.00,Default,,0,0,0,,Мен сені күттім.
Dialogue: 0,1:11:36.08,1:11:38.00,Default,,0,0,0,,(Жеткізушілер) Рахмет.
Dialogue: 0,1:12:06.03,1:12:07.86,Default,,0,0,0,,Фу…
Dialogue: 0,1:12:10.28,1:12:11.78,Default,,0,0,0,,Иә
Dialogue: 0,1:12:15.28,1:12:18.12,Default,,0,0,0,,Мені шынымен кешіріңіз
Dialogue: 0,1:12:18.66,1:12:20.21,Default,,0,0,0,,Жоқ
Dialogue: 0,1:12:21.67,1:12:24.17,Default,,0,0,0,,Бұл рекорд.
Dialogue: 0,1:12:26.55,1:12:27.84,Default,,0,0,0,,Рахмет
Dialogue: 0,1:12:28.71,1:12:31.30,Default,,0,0,0,,Иә, керемет
Dialogue: 0,1:12:31.80,1:12:34.47,Default,,0,0,0,,(Акико) Жазбалар...? ‬
Dialogue: 0,1:12:35.68,1:12:39.52,Default,,0,0,0,,Мен мұны бұрын көргендей сезінемін...
Dialogue: 0,1:12:39.60,1:12:40.73,Default,,0,0,0,,(Акико) Ах.
Dialogue: 0,1:12:41.27,1:12:44.98,Default,,0,0,0,,Барлығы, уақыт таяп қалды. Өткізілетін орынға барайық.
Dialogue: 0,1:12:45.06,1:12:45.90,Default,,0,0,0,,Ах! ‬
Dialogue: 0,1:12:45.98,1:12:47.61,Default,,0,0,0,,(Барлығы) Ха! ‬
Dialogue: 0,1:12:47.69,1:12:49.32,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:12:50.36,1:12:54.62,Default,,0,0,0,,Хмм... мм? ‬
Dialogue: 0,1:13:19.43,1:13:21.18,Default,,0,0,0,,Жазу? ‬
Dialogue: 0,1:13:21.73,1:13:22.98,Default,,0,0,0,,Керемет! ‬
Dialogue: 0,1:13:24.06,1:13:28.02,Default,,0,0,0,,Шие де, мен бүгін көшуім керек.
Dialogue: 0,1:13:28.11,1:13:31.07,Default,,0,0,0,,Барлығымыз бірге жазбаларды тыңдай алдық.
Dialogue: 0,1:13:51.76,1:13:54.17,Default,,0,0,0,,Барлығыңыз өтінемін
Dialogue: 0,1:13:54.26,1:13:55.72,Default,,0,0,0,,(Барлығы) Иә? ‬
Dialogue: 0,1:14:20.12,1:14:21.62,Default,,0,0,0,,(Смартфон хабарландыру дыбысы)
Dialogue: 0,1:14:44.10,1:14:46.14,Default,,0,0,0,,(Жүргізуші) Енді, келесі.
Dialogue: 0,1:14:46.23,1:14:50.19,Default,,0,0,0,,Күндізгі қызмет Хидамаридегі барлығының би орындауы.
Dialogue: 0,1:14:50.98,1:14:54.61,Default,,0,0,0,,«Одаяма Дарума Ондомен» бірге ләззат алыңыз
Dialogue: 0,1:15:13.63,1:15:17.47,Default,,0,0,0,,♪「ЯМАЗАКУРА」
Dialogue: 0,1:15:17.55,1:15:20.22,Default,,0,0,0,,Не? Ән басқа
Dialogue: 0,1:15:21.22,1:15:22.51,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:15:33.73,1:15:39.70,Default,,0,0,0,,♪ Еске алып, есінен танып қалу
Dialogue: 0,1:15:40.36,1:15:44.99,Default,,0,0,0,,♪ Тірі болған сол күндер
Dialogue: 0,1:15:46.70,1:15:53.59,Default,,0,0,0,,♪ Мен сізбен кездесе алдым
Dialogue: 0,1:15:53.67,1:15:57.67,Default,,0,0,0,,♪ Бұл дүниенің кереметтері
Dialogue: 0,1:16:00.38,1:16:05.76,Default,,0,0,0,,♪ Сол күні сол үй
Dialogue: 0,1:16:05.85,1:16:14.69,Default,,0,0,0,,♪ Найзағайдай ғашық болдым
Dialogue: 0,1:16:17.03,1:16:23.57,Default,,0,0,0,,♪ Жүрегіңнің есігін ашатын кілт
Dialogue: 0,1:16:23.66,1:16:28.83,Default,,0,0,0,,♪ Тек бір кілт
Dialogue: 0,1:16:30.12,1:16:35.67,Default,,0,0,0,,♪ Бұл бостандықтың қанаты
Dialogue: 0,1:16:35.75,1:16:45.80,Default,,0,0,0,,♪ Мен жіберген арман кемпірқосақтың шетіне айналады
Dialogue: 0,1:16:48.35,1:16:53.35,Default,,0,0,0,,♪～
Dialogue: 0,1:16:57.23,1:16:58.78,Default,,0,0,0,,Бұл ән...
Dialogue: 0,1:16:59.40,1:17:01.15,Default,,0,0,0,,Фудзияма рекорды? ‬
Dialogue: 0,1:17:16.08,1:17:17.17,Default,,0,0,0,,(Қатты бала) Ах.
Dialogue: 0,1:17:20.38,1:17:23.30,Default,,0,0,0,,(жүгіру)
Dialogue: 0,1:17:25.64,1:17:27.51,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:17:31.64,1:17:35.40,Default,,0,0,0,,‪（）････‬
Dialogue: 0,1:17:35.48,1:17:40.28,Default,,0,0,0,,Қ.Қ.С.Т.А.С.Н.А.
Dialogue: 0,1:17:40.36,1:17:44.03,Default,,0,0,0,,I/K/HA/S/KI
Dialogue: 0,1:17:46.20,1:17:47.87,Default,,0,0,0,,Хехехе
Dialogue: 0,1:18:00.25,1:18:01.38,Default,,0,0,0,,(Шие) Әке, тоқтатыңыз.
Dialogue: 0,1:18:01.46,1:18:02.38,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:18:08.01,1:18:10.60,Default,,0,0,0,,Эй Юи, не болып жатыр? ‬
Dialogue: 0,1:18:10.68,1:18:12.06,Default,,0,0,0,,(Шие) Бірдеңені жоғалтып алды! ‬
Dialogue: 0,1:18:13.43,1:18:16.40,Default,,0,0,0,,Тезірек, Шие! ‬
Dialogue: 0,1:18:16.48,1:18:17.85,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,1:18:18.44,1:18:19.31,Default,,0,0,0,,Канджи
Dialogue: 0,1:18:19.40,1:18:21.23,Default,,0,0,0,,Мұны Тough Boy жазған.
Dialogue: 0,1:18:21.32,1:18:24.61,Default,,0,0,0,,Сәлем! Мен дәл сіз айтқандай жаздым деп ойлаймын! ‬
Dialogue: 0,1:18:25.36,1:18:26.82,Default,,0,0,0,,(Шие) Мен қателеспеймін.
Dialogue: 0,1:18:26.91,1:18:29.66,Default,,0,0,0,,Хаха қайсысы?
Dialogue: 0,1:18:29.74,1:18:33.37,Default,,0,0,0,,(Шиенің жүгірген тынысы)
Dialogue: 0,1:19:14.91,1:19:18.25,Default,,0,0,0,,Сіз шие жігітіне қарап тұрсыз ба?
Dialogue: 0,1:19:18.33,1:19:20.08,Default,,0,0,0,,Мен оның қарап тұрғанына сенімдімін.
Dialogue: 0,1:19:31.09,1:19:32.05,Default,,0,0,0,,Ах
Dialogue: 0,1:19:32.14,1:19:37.10,Default,,0,0,0,,Эмоциялар! Бала теңізден көтеріледі
Dialogue: 0,1:19:38.69,1:19:44.32,Default,,0,0,0,,Сезімдер мен ұлдар теңізінен көтерілу
Dialogue: 0,1:19:48.86,1:19:50.16,Default,,0,0,0,,(Шие) Кешіріңіз.
Dialogue: 0,1:19:54.16,1:19:58.79,Default,,0,0,0,,(Барлығы қолдайды)
Dialogue: 0,1:20:10.55,1:20:12.01,Default,,0,0,0,,Ах! Черри-кун! ‬
Dialogue: 0,1:20:12.09,1:20:14.39,Default,,0,0,0,,Китар! ‬
Dialogue: 0,1:20:28.74,1:20:33.62,Default,,0,0,0,,(Шие) Ымыртқа қарай ұшатын жаз шамдары
Dialogue: 0,1:20:35.24,1:20:40.21,Default,,0,0,0,,Он жетінші шілде Мен сені кездестіремін
Dialogue: 0,1:20:42.12,1:20:47.80,Default,,0,0,0,,``күнбағыс‎'' немесе ''сүйкімді'' сөздерінің мағынасын сөздіктен сұраңыз.
Dialogue: 0,1:20:48.80,1:20:53.09,Default,,0,0,0,,Сөздер сидр сияқты төгіледі
Dialogue: 0,1:20:53.18,1:20:54.18,Default,,0,0,0,,Ха! ‬
Dialogue: 0,1:20:59.22,1:21:01.14,Default,,0,0,0,,(Шие) Сөздер күн күркіреген дыбысты беруге арналған.
Dialogue: 0,1:20:59.85,1:21:01.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:21:01.14,1:21:03.65,Default,,0,0,0,,(Шие) Сөздер күн күркіреген дыбысты беруге арналған.
Dialogue: 0,1:21:05.36,1:21:08.57,Default,,0,0,0,,Саған бірдеңе айтқым келеді, Юдзи.
Dialogue: 0,1:21:06.73,1:21:08.57,Default,,0,0,0,,(отшашудың дыбысы)
Dialogue: 0,1:21:08.57,1:21:10.90,Default,,0,0,0,,Саған бірдеңе айтқым келеді, Юдзи.
Dialogue: 0,1:21:11.95,1:21:17.33,Default,,0,0,0,,Қолыңа ыстық желдің бір бөлігі
Dialogue: 0,1:21:18.58,1:21:23.62,Default,,0,0,0,,Жаздың аяғында бар жүрегіммен айқайлаймын
Dialogue: 0,1:21:27.13,1:21:32.09,Default,,0,0,0,,Ямазакура жасырын жапырақтары Маған ұнайды
Dialogue: 0,1:21:33.59,1:21:38.81,Default,,0,0,0,,Ямазакура Маған бұл сүйкімді тістер ұнайды
Dialogue: 0,1:21:40.60,1:21:45.65,Default,,0,0,0,,Ямазакура жасырын жапырақтары Маған ұнайды
Dialogue: 0,1:21:47.02,1:21:52.57,Default,,0,0,0,,Ямазакура Маған бұл сүйкімді тістер ұнайды
Dialogue: 0,1:21:54.07,1:21:58.99,Default,,0,0,0,,Ямазакура сүйкімді сөздер Маған да ұнайды
Dialogue: 0,1:22:00.49,1:22:06.54,Default,,0,0,0,,Ямазакура сүйкімді отшашу Маған да ұнайды
Dialogue: 0,1:22:06.63,1:22:12.38,Default,,0,0,0,,Ямазакура сүйкімді күлкі Маған ұнайды
Dialogue: 0,1:22:13.76,1:22:18.85,Default,,0,0,0,,Ямазакура Смайл Маған ұнайды
Dialogue: 0,1:22:20.56,1:22:24.39,Default,,0,0,0,,Мен сені жақсы көремін! ‬
Dialogue: 0,1:22:50.63,1:22:55.63,Default,,0,0,0,,~♪
Dialogue: 0,1:23:00.72,1:23:07.06,Default,,0,0,0,,♪ Жақсы жүрмейтін нәрселер көп.
Dialogue: 0,1:23:07.14,1:23:10.06,Default,,0,0,0,,♪ салбыраған басы
Dialogue: 0,1:23:10.15,1:23:18.82,Default,,0,0,0,,♪ Жазғы аспан астында мен бірдеңе жасағым келеді
Dialogue: 0,1:23:18.91,1:23:23.45,Default,,0,0,0,,♪ Мен сыбырладым, жарқырап тұр
Dialogue: 0,1:23:23.54,1:23:28.75,Default,,0,0,0,,♪ Климакс жеткізілді
Dialogue: 0,1:23:28.83,1:23:35.01,Default,,0,0,0,,♪ Сөздер сидр сияқты көпіршеді
Dialogue: 0,1:23:35.09,1:23:38.30,Default,,0,0,0,,♪ Мен сізге айтқым келеді
Dialogue: 0,1:23:38.38,1:23:42.10,Default,,0,0,0,,♪ Араластырып тастаған дұрыс.
Dialogue: 0,1:23:42.18,1:23:49.60,Default,,0,0,0,,♪ Бұл сезім, тура ұш! ‬
Dialogue: 0,1:23:57.07,1:24:06.49,Default,,0,0,0,,♪ Кім екенің маңызды емес, мойындайсың ба?
Dialogue: 0,1:24:06.58,1:24:15.30,Default,,0,0,0,,♪ Көзіңе қарап, шынын айтсам
Dialogue: 0,1:24:15.38,1:24:20.05,Default,,0,0,0,,♪ Мен уайымдаймын, бірақ мен мұны істей аламын деп ойлаймын.
Dialogue: 0,1:24:20.13,1:24:25.22,Default,,0,0,0,,♪ Басқалардан артық жарқыра
Dialogue: 0,1:24:25.31,1:24:31.52,Default,,0,0,0,,♪ Сөздер сидр сияқты жақсы шығады
Dialogue: 0,1:24:31.60,1:24:34.77,Default,,0,0,0,,♪ Мен сізге айтқым келеді
Dialogue: 0,1:24:34.86,1:24:38.61,Default,,0,0,0,,♪ Өзің сияқты болған дұрыс.
Dialogue: 0,1:24:38.69,1:24:46.03,Default,,0,0,0,,♪ Асыл сезімдер ешқашан өшпейді
Dialogue: 0,1:25:04.84,1:25:09.47,Default,,0,0,0,,♪ Егер тоқтатылған ине қозғала бастаса
Dialogue: 0,1:25:09.56,1:25:14.15,Default,,0,0,0,,♪ Дәл сол кездегідей болды.
Dialogue: 0,1:25:14.23,1:25:18.86,Default,,0,0,0,,♪ Жұмсақ және жұмсақ
Dialogue: 0,1:25:18.94,1:25:24.07,Default,,0,0,0,,♪ Көзіңнен жас ағып кетеді
Dialogue: 0,1:25:24.16,1:25:30.33,Default,,0,0,0,,♪ Сөздер сидрдей ағып жатыр
Dialogue: 0,1:25:30.41,1:25:33.58,Default,,0,0,0,,♪ Мен сізге айтқым келеді
Dialogue: 0,1:25:33.67,1:25:37.42,Default,,0,0,0,,♪ Араластырып тастаған дұрыс.
Dialogue: 0,1:25:37.50,1:25:42.92,Default,,0,0,0,,♪ Бұл сезім, тура ұш! ‬
Dialogue: 0,1:25:43.01,1:25:49.18,Default,,0,0,0,,♪ Сөздер сидрдей ағып жатыр
Dialogue: 0,1:25:49.26,1:25:52.39,Default,,0,0,0,,♪ Мен сізге айтқым келеді
Dialogue: 0,1:25:52.48,1:25:56.23,Default,,0,0,0,,♪ Өзіңдей болған дұрыс.
Dialogue: 0,1:25:56.31,1:26:03.74,Default,,0,0,0,,♪ Асыл сезімдер ешқашан өшпейді
Dialogue: 0,1:26:12.66,1:26:17.67,Default,,0,0,0,,～♪
