Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.16,0:00:07.17,Default,,0,0,0,,♪〜
Dialogue: 0,0:01:21.87,0:01:27.87,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:43.22,0:01:46.23,Default,,0,0,0,,Менің зәр алғым келеді...
Dialogue: 0,0:01:47.69,0:01:50.56,Default,,0,0,0,,Ал мен өз шегімдемін
Dialogue: 0,0:01:51.15,0:01:55.11,Default,,0,0,0,,Мен дәретхана табу үшін адамдар көп қала орталығына бардым, бірақ...
Dialogue: 0,0:01:55.49,0:01:59.24,Default,,0,0,0,,Мектепке әкелген шайды ыстық болды деп жұтып қоймауым керек еді.
Dialogue: 0,0:02:01.03,0:02:02.62,Default,,0,0,0,,Уф… гүрс…
Dialogue: 0,0:02:03.12,0:02:04.62,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:02:05.08,0:02:07.50,Default,,0,0,0,,Егер сіз жіберіп алсаңыз, бұл қауіпті!
Dialogue: 0,0:02:07.96,0:02:09.37,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:10.00,0:02:11.79,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:02:12.63,0:02:14.21,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:02:15.26,0:02:17.92,Default,,0,0,0,,Ng! Гугг…
Dialogue: 0,0:02:18.63,0:02:20.05,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:02:22.60,0:02:24.31,Default,,0,0,0,,Гудда… жоқ.
Dialogue: 0,0:02:24.43,0:02:26.77,Default,,0,0,0,,(жүрек соғу дыбысы)
Dialogue: 0,0:02:27.06,0:02:28.02,Default,,0,0,0,,Хааа да…
Dialogue: 0,0:02:30.40,0:02:33.15,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:34.15,0:02:36.23,Default,,0,0,0,,Уф! Уф! Уф!
Dialogue: 0,0:02:36.57,0:02:38.78,Default,,0,0,0,,Сіз өз шегіңіздесіз!
Dialogue: 0,0:02:40.57,0:02:44.78,Default,,0,0,0,,SAN мәні әр қадам сайын азайып барады.
Dialogue: 0,0:02:49.29,0:02:50.96,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:02:51.08,0:02:53.92,Default,,0,0,0,,Егер бұлай болса, айналадағы қараңғылықта.
Dialogue: 0,0:02:54.09,0:02:55.25,Default,,0,0,0,,Ах
Dialogue: 0,0:02:56.50,0:02:59.17,Default,,0,0,0,,Жарайсыңдар, жануарлар.
Dialogue: 0,0:02:59.30,0:03:02.47,Default,,0,0,0,,Сіз дәретхананы кез келген уақытта және кез келген жерде пайдалана аласыз.
Dialogue: 0,0:03:03.30,0:03:05.10,Default,,0,0,0,,Иә? Бұл...
Dialogue: 0,0:03:08.77,0:03:10.85,Default,,0,0,0,,Бұл қуықтағы барлық нәрсе...
Dialogue: 0,0:03:13.69,0:03:14.81,Default,,0,0,0,,Бәс тігу!
Dialogue: 0,0:03:15.65,0:03:17.86,Default,,0,0,0,,Ах, дәретхана!
Dialogue: 0,0:03:18.07,0:03:20.70,Default,,0,0,0,,Мен мұндай жер бар екенін білмедім...
Dialogue: 0,0:03:21.28,0:03:22.45,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:03:22.74,0:03:24.32,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:03:24.57,0:03:25.74,Default,,0,0,0,,Хмф!
Dialogue: 0,0:03:26.91,0:03:28.45,Default,,0,0,0,,Ах... Қауіп! Шығады!
Dialogue: 0,0:03:28.58,0:03:32.42,Default,,0,0,0,,- бұл... екінші жағы! Әй, керісінше, екінші жағы!
Dialogue: 0,0:03:32.54,0:03:36.34,Default,,0,0,0,,(ономатопеялық құрылғы дыбысы)
Dialogue: 0,0:03:40.38,0:03:43.51,Default,,0,0,0,,Хаа~ Ах~!
Dialogue: 0,0:03:44.39,0:03:47.43,Default,,0,0,0,,Бұл қауіпті болды~
Dialogue: 0,0:03:48.10,0:03:53.31,Default,,0,0,0,,Соңғы шара ретінде мен оны пластик бөтелкеге ​​тығып қоюды ойладым.
Dialogue: 0,0:03:53.56,0:03:56.19,Default,,0,0,0,,Ішінің түсі де әдемі.
Dialogue: 0,0:03:56.44,0:03:57.40,Default,,0,0,0,,Бірақ
Dialogue: 0,0:03:57.86,0:03:59.61,Default,,0,0,0,,Мен оны қолданбағаныма қуаныштымын!
Dialogue: 0,0:03:59.94,0:04:01.24,Default,,0,0,0,,Енді ештеңені жоғалтпау үшін
Dialogue: 0,0:04:08.45,0:04:11.37,Default,,0,0,0,,Бұл ерлердің дәретханасы.
Dialogue: 0,0:04:11.91,0:04:14.00,Default,,0,0,0,,Өйткені бұл шек болды.
Dialogue: 0,0:04:14.12,0:04:16.21,Default,,0,0,0,,Ал, мен жақынырақ кірейін.
Dialogue: 0,0:04:17.00,0:04:18.46,Default,,0,0,0,,Басқа таңдау жоқ.
Dialogue: 0,0:04:21.46,0:04:22.67,Default,,0,0,0,,Әй, біреу келді.
Dialogue: 0,0:04:23.55,0:04:26.05,Default,,0,0,0,,Мен көрші үйге кірдім.
Dialogue: 0,0:04:26.18,0:04:27.60,Default,,0,0,0,,(Шалбарды шешу дыбысы)
Dialogue: 0,0:04:27.72,0:04:30.14,Default,,0,0,0,,Нуаааааааааааааааааааааааааааааа!
Dialogue: 0,0:04:30.27,0:04:32.14,Default,,0,0,0,,Не? (1-ағай) Уау!
Dialogue: 0,0:04:32.27,0:04:34.14,Default,,0,0,0,,Жуынатын бөлмеге бара жатырмын, солай ма?
Dialogue: 0,0:04:34.48,0:04:38.44,Default,,0,0,0,,Не болып жатыр? Не...
Dialogue: 0,0:04:38.56,0:04:39.86,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:04:39.98,0:04:42.53,Default,,0,0,0,,Ерлер дәретханасы Бұл қорқынышты!
Dialogue: 0,0:04:42.65,0:04:45.57,Default,,0,0,0,,♪ Hmph~n
Dialogue: 0,0:04:47.28,0:04:50.41,Default,,0,0,0,,Уф... Мен тез қашуым керек.
Dialogue: 0,0:04:51.95,0:04:54.46,Default,,0,0,0,,Кіре берісте бір-біріңізбен кездесіп қалмаңыз
Dialogue: 0,0:04:54.79,0:04:56.29,Default,,0,0,0,,Мұндай жағдайда...
Dialogue: 0,0:04:58.04,0:05:02.63,Default,,0,0,0,,Денеңіздің барлық чакраларын көзіңізге жинаңыз.
Dialogue: 0,0:05:03.30,0:05:05.59,Default,,0,0,0,,Алтыншы сезімді босату!
Dialogue: 0,0:05:08.43,0:05:10.47,Default,,0,0,0,,Нағыз қабырға бұзу!
Dialogue: 0,0:05:11.39,0:05:14.31,Default,,0,0,0,,Қабырғаны бұзу дегеніміз не? Интернет ойындары және т.б.
Dialogue: 0,0:05:14.43,0:05:16.64,Default,,0,0,0,,Әдетте көрінбейтін қабырғаның екінші жағындағы жау кейіпкерлері
Dialogue: 0,0:05:16.77,0:05:19.86,Default,,0,0,0,,Оны экранда көрсету - алдау
Dialogue: 0,0:05:20.23,0:05:21.23,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:05:21.40,0:05:23.99,Default,,0,0,0,,Осылай сызып тастаңыз!
Dialogue: 0,0:05:24.44,0:05:27.45,Default,,0,0,0,,Уау, топтама терге түсіп кетті.
Dialogue: 0,0:05:27.57,0:05:33.20,Default,,0,0,0,,♪ Төбенің бұзылуы мені ынталандырады
Dialogue: 0,0:05:33.33,0:05:36.12,Default,,0,0,0,,Түйсікпен жүру жақсы емес пе?
Dialogue: 0,0:05:36.33,0:05:37.33,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:05:38.08,0:05:40.42,Default,,0,0,0,,Кірген кезім есіме түскенде
Dialogue: 0,0:05:41.25,0:05:44.01,Default,,0,0,0,,Менің ойымша, дәретхананың алдында аялдама бар еді.
Dialogue: 0,0:05:45.17,0:05:48.93,Default,,0,0,0,,Әдетте есіктің артында көлік көп болады.
Dialogue: 0,0:05:49.72,0:05:52.39,Default,,0,0,0,,Сенің ішке кіріп кеткенің керемет болды.
Dialogue: 0,0:05:52.89,0:05:56.10,Default,,0,0,0,,Қашу жолы –...
Dialogue: 0,0:05:59.15,0:06:00.02,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:06:03.44,0:06:05.40,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:06:07.11,0:06:09.11,Default,,0,0,0,,Бұл жабдықтың жағдайы болды ма?
Dialogue: 0,0:06:09.45,0:06:12.45,Default,,0,0,0,,Есіктің құрылымы басқаша деп ойладым.
Dialogue: 0,0:06:12.66,0:06:13.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:14.58,0:06:16.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:18.66,0:06:20.00,Default,,0,0,0,,Ах~
Dialogue: 0,0:06:20.21,0:06:23.00,Default,,0,0,0,,〜 〜 （）
Dialogue: 0,0:06:23.13,0:06:25.96,Default,,0,0,0,,О? Арх...
Dialogue: 0,0:06:32.51,0:06:33.72,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:37.64,0:06:39.94,Default,,0,0,0,,Қастандық ойыны осылай болуы мүмкін бе?
Dialogue: 0,0:06:40.27,0:06:41.52,Default,,0,0,0,,Бірдеңе болатын сияқты
Dialogue: 0,0:06:41.65,0:06:44.44,Default,,0,0,0,,Қыз намысын қорғауға барайын ба?
Dialogue: 0,0:06:44.57,0:06:46.03,Default,,0,0,0,,Сіз түрмеге түскіңіз келе ме?
Dialogue: 0,0:06:46.44,0:06:48.28,Default,,0,0,0,,Бұл не ақымақ нәрсе?
Dialogue: 0,0:06:48.86,0:06:52.07,Default,,0,0,0,,Бірақ қолдануға болатын басқа нәрсе бар ма?
Dialogue: 0,0:06:52.41,0:06:54.70,Default,,0,0,0,,Иә? Бұл...
Dialogue: 0,0:06:54.87,0:06:58.87,Default,,0,0,0,,Әйелдер дәретханасынан көрген емеспін, бірақ ол қандай құрал?
Dialogue: 0,0:06:59.75,0:07:03.92,Default,,0,0,0,,А, егер сіз мұны жақсы пайдалансаңыз, қашып кетуіңіз мүмкін.
Dialogue: 0,0:07:04.21,0:07:05.71,Default,,0,0,0,,Біраз уақыт сатып алсам ғой!
Dialogue: 0,0:07:05.84,0:07:08.59,Default,,0,0,0,,♪ Төбе бекітілгенде, ол тыныштандырады.
Dialogue: 0,0:07:10.51,0:07:13.80,Default,,0,0,0,,Алдымен мына нәрсені мұқият орнатыңыз.
Dialogue: 0,0:07:14.55,0:07:17.64,Default,,0,0,0,,Ал шығу екінші жағында!
Dialogue: 0,0:07:17.93,0:07:20.44,Default,,0,0,0,,Иә, көзіме шағылысқан сәуле
Dialogue: 0,0:07:20.56,0:07:23.40,Default,,0,0,0,,Бұл үміт есігі!
Dialogue: 0,0:07:32.78,0:07:35.99,Default,,0,0,0,,Жарайды, бұл жолда трафик әлдеқайда аз.
Dialogue: 0,0:07:38.49,0:07:39.87,Default,,0,0,0,,Бірақ әлі жоқ
Dialogue: 0,0:07:42.21,0:07:44.00,Default,,0,0,0,,Нашар жағдайлар
Dialogue: 0,0:07:44.58,0:07:45.42,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:07:45.79,0:07:47.04,Default,,0,0,0,,А, тазалау!
Dialogue: 0,0:07:47.17,0:07:49.21,Default,,0,0,0,,Шынайы ма? Ол ағып кететін сияқты!
Dialogue: 0,0:07:49.55,0:07:52.84,Default,,0,0,0,,Апай апа, мен бір сәт ішке кірсем бола ма?
Dialogue: 0,0:07:52.97,0:07:53.80,Default,,0,0,0,,Мен кіремін
Dialogue: 0,0:07:54.30,0:07:56.89,Default,,0,0,0,,Бұл төтенше жағдай.
Dialogue: 0,0:07:57.10,0:07:59.72,Default,,0,0,0,,Тұзақ іске қосылды!
Dialogue: 0,0:07:59.89,0:08:01.64,Default,,0,0,0,,Уф, бұл...
Dialogue: 0,0:08:02.02,0:08:05.56,Default,,0,0,0,,Пи... зәрмен жабылған, бұл апат емес пе!
Dialogue: 0,0:08:08.15,0:08:11.32,Default,,0,0,0,,А... Апай, мен сенімдімін.
Dialogue: 0,0:08:11.99,0:08:13.57,Default,,0,0,0,,Уақытты сатып алудың сәттілігі!
Dialogue: 0,0:08:13.95,0:08:16.45,Default,,0,0,0,,Мен шайды көп төгіп алдым деп ойлаймын.
Dialogue: 0,0:08:16.57,0:08:18.20,Default,,0,0,0,,Тазалағандарға: Кешіріңіз!
Dialogue: 0,0:08:18.95,0:08:21.58,Default,,0,0,0,,Енді сырттағы жағдай қандай...
Dialogue: 0,0:08:21.91,0:08:23.25,Default,,0,0,0,,Аа, бұл реттеу
Dialogue: 0,0:08:23.92,0:08:26.17,Default,,0,0,0,,Мини юбка қыз, оның айналасындағылардың бәрі қарт адамдар!
Dialogue: 0,0:08:26.96,0:08:30.55,Default,,0,0,0,,Мүмкіндік! Бұл күтуге тұрарлық болды!
Dialogue: 0,0:08:30.84,0:08:33.93,Default,,0,0,0,,Сыртта қабырғада әлгі жігіт болуы керек.
Dialogue: 0,0:08:34.05,0:08:36.09,Default,,0,0,0,,(Киё) Танжиро-сан, сен барынша тырысып жатырсың. (Суми) Иә!
Dialogue: 0,0:08:37.39,0:08:40.43,Default,,0,0,0,,Жабдық бөліміндегі жұмбақ түрлі-түсті шар!
Dialogue: 0,0:08:42.35,0:08:43.23,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:08:43.60,0:08:46.90,Default,,0,0,0,,Ой, бұл сұмдық, бұл апат емес пе?
Dialogue: 0,0:08:47.23,0:08:49.07,Default,,0,0,0,,Уа, барлық оқ атылды!
Dialogue: 0,0:08:54.86,0:08:56.45,Default,,0,0,0,,100 иенге дәмді тәттілер...
Dialogue: 0,0:08:56.57,0:08:57.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:01.20,0:09:03.12,Default,,0,0,0,,Уау! (1-қыз) Бұл мысық!
Dialogue: 0,0:09:03.62,0:09:07.58,Default,,0,0,0,,Уау! Бұл сондай сүйкімді болса да
Dialogue: 0,0:09:07.83,0:09:10.21,Default,,0,0,0,,Кинофильм түсірейік (Қыздар 2) Иә!
Dialogue: 0,0:09:10.59,0:09:12.38,Default,,0,0,0,,Оны сыныптағылардың барлығына жіберейік.
Dialogue: 0,0:09:14.22,0:09:16.72,Default,,0,0,0,,Маған қарашы, сен сүйкімдісің~
Dialogue: 0,0:09:17.80,0:09:19.22,Default,,0,0,0,,Сол жерде дүниеге келген...
Dialogue: 0,0:09:20.18,0:09:21.31,Default,,0,0,0,,Соқыр нүкте!
Dialogue: 0,0:09:22.52,0:09:23.43,Default,,0,0,0,,Дәл сол сәтте,
Dialogue: 0,0:09:24.98,0:09:27.69,Default,,0,0,0,,Енді сіздің мүмкіндігіңіз!
Dialogue: 0,0:09:27.98,0:09:30.48,Default,,0,0,0,,Маған тағы да бұрылсаңыз екен.
Dialogue: 0,0:09:30.73,0:09:33.53,Default,,0,0,0,,Кішкене көп, сәл артық, біраз...
Dialogue: 0,0:09:35.57,0:09:38.36,Default,,0,0,0,,Иә? Ugggggg...
Dialogue: 0,0:09:38.82,0:09:41.41,Default,,0,0,0,,Аа, мен одан құтыла алмаймын. Мен салмақ қостым ба?
Dialogue: 0,0:09:41.58,0:09:43.79,Default,,0,0,0,,Уау! Қазір ең нашар!
Dialogue: 0,0:09:46.62,0:09:47.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.37,0:09:51.67,Default,,0,0,0,,Жоқ! Ахх!
Dialogue: 0,0:09:51.79,0:09:52.88,Default,,0,0,0,,Уау (қыздар) О!
Dialogue: 0,0:09:54.84,0:09:57.72,Default,,0,0,0,,Гу... ауырады~
Dialogue: 0,0:09:57.97,0:10:02.43,Default,,0,0,0,,Ол кенеттен маған ұшып келгенде, мен қатты таң қалдым.
Dialogue: 0,0:10:02.56,0:10:04.52,Default,,0,0,0,,Бұл үлкен серпін болды.
Dialogue: 0,0:10:04.64,0:10:05.73,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:10:05.85,0:10:07.98,Default,,0,0,0,,Дәлірек айтсақ, қайдан шыққан?
Dialogue: 0,0:10:08.10,0:10:09.27,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:10:09.40,0:10:12.19,Default,,0,0,0,,Джиджи... Джордж!
Dialogue: 0,0:10:12.44,0:10:14.86,Default,,0,0,0,,Джордж! Ақыры таптым
Dialogue: 0,0:10:14.98,0:10:18.07,Default,,0,0,0,,А, сен үйден қашып, осында қалдың ғой, солай ма?
Dialogue: 0,0:10:18.20,0:10:20.28,Default,,0,0,0,,Мен таң қалғаным сонша, ойланбастан ішке кіріп кеттім.
Dialogue: 0,0:10:20.41,0:10:22.78,Default,,0,0,0,,Мен... Мен секірмей тұра алмадым!
Dialogue: 0,0:10:24.24,0:10:25.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:25.20,0:10:26.91,Default,,0,0,0,,Джордж! күтіңіз Джордж
Dialogue: 0,0:10:27.04,0:10:28.75,Default,,0,0,0,,Ең болмағанда рахмет...
Dialogue: 0,0:10:30.75,0:10:33.25,Default,,0,0,0,,Мен өзімді мысық адамдай сезінемін.
Dialogue: 0,0:10:35.25,0:10:37.38,Default,,0,0,0,,Мен түсіндім~
Dialogue: 0,0:10:37.59,0:10:40.05,Default,,0,0,0,,Дәлірек айтқанда, бұл доптың иісі жақсы.
Dialogue: 0,0:10:40.18,0:10:42.97,Default,,0,0,0,,Османт иісі? Бұл
Dialogue: 0,0:10:43.10,0:10:44.68,Default,,0,0,0,,Біртүрлі ойыншықтар
Dialogue: 0,0:10:44.89,0:10:46.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:46.93,0:10:48.60,Default,,0,0,0,,Ер адамдар ойлады
Dialogue: 0,0:10:48.73,0:10:49.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:49.69,0:10:52.06,Default,,0,0,0,,Ерлердің зәрінде жатқан мынау емес пе?
Dialogue: 0,0:10:52.19,0:10:54.02,Default,,0,0,0,,Бұл менің қиялым ғана ма?
Dialogue: 0,0:10:54.32,0:10:57.23,Default,,0,0,0,,Уф, мен бірдеңе ойлап едім, мені мазалай бастады.
Dialogue: 0,0:10:57.36,0:10:59.61,Default,,0,0,0,,Арғы жағында дәретхана болғанына сенімдімін.
Dialogue: 0,0:11:03.12,0:11:05.37,Default,,0,0,0,,Бұл апат!
Dialogue: 0,0:11:10.87,0:11:13.71,Default,,0,0,0,,Әй, қалтамда бір жұмбақ доп қалды.
Dialogue: 0,0:11:13.83,0:11:14.79,Default,,0,0,0,,Ах
Dialogue: 0,0:11:16.84,0:11:18.46,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:11:18.59,0:11:19.80,Default,,0,0,0,,(Камо) Һм. (Фушигиро) Ұф.
Dialogue: 0,0:11:20.42,0:11:23.26,Default,,0,0,0,,Я, мен не болып жатқанын білмеймін.
Dialogue: 0,0:11:23.55,0:11:25.76,Default,,0,0,0,,Мектепте оғаш ойыншықтар тым көп...
Dialogue: 0,0:11:25.89,0:11:26.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:27.22,0:11:28.43,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:11:30.43,0:11:32.40,Default,,0,0,0,,Мен Момо Шинозукамын
Dialogue: 0,0:11:32.52,0:11:35.44,Default,,0,0,0,,Мен Samejima Academy студенттік кеңесінің тәртіптік комитетінің мүшесімін.
Dialogue: 0,0:11:40.95,0:11:43.36,Default,,0,0,0,,Мектептің моральдық тәртібі бұзылуда.
Dialogue: 0,0:11:43.86,0:11:45.91,Default,,0,0,0,,Соңғы уақытта оқушы өзін нашар ұстаса.
Dialogue: 0,0:11:46.03,0:11:49.29,Default,,0,0,0,,Маған көршілер бірнеше рет қоңырау шалды.
Dialogue: 0,0:11:49.54,0:11:52.00,Default,,0,0,0,,Біздің көзімізден таса сияқты
Dialogue: 0,0:11:52.12,0:11:54.79,Default,,0,0,0,,Кейбір оқушылар тым ойнақы сияқты.
Dialogue: 0,0:11:55.29,0:11:57.71,Default,,0,0,0,,Егер сізде қандай да бір ақпарат болса, хабарлаңыз.
Dialogue: 0,0:11:58.42,0:11:59.63,Default,,0,0,0,,және осы адаммен шайқасуға рұқсат етті—
Dialogue: 0,0:12:00.26,0:12:02.93,Default,,0,0,0,,Бұл сіздің профессор Готоға көмектесу мүмкіндігіңіз.
Dialogue: 0,0:12:05.59,0:12:08.18,Default,,0,0,0,,Бүгін таңертең мен айналма жолмен шықтым.
Dialogue: 0,0:12:08.31,0:12:11.35,Default,,0,0,0,,Мен ақпарат болған аймақты қарап жатырмын...
Dialogue: 0,0:12:11.60,0:12:15.77,Default,,0,0,0,,Хмм, мәселе жоқ. Өте тыныш.
Dialogue: 0,0:12:15.90,0:12:19.98,Default,,0,0,0,,Ақпарат шынымен біздің мектептен алынды ма?
Dialogue: 0,0:12:21.53,0:12:24.82,Default,,0,0,0,,Алдымызда келе жатқан екеуің де біздің мектептің оқушылары сияқтысыңдар.
Dialogue: 0,0:12:24.95,0:12:26.87,Default,,0,0,0,,Қарапайымды және әйелдік...
Dialogue: 0,0:12:27.24,0:12:31.66,Default,,0,0,0,,Күтілгендей, Самедзима Гакуэн студенттерінің мінез-құлқы жақсы.
Dialogue: 0,0:12:32.00,0:12:33.66,Default,,0,0,0,,Охохохо (Манана) Уфуфуфу
Dialogue: 0,0:12:34.96,0:12:35.96,Default,,0,0,0,,Ах
Dialogue: 0,0:12:36.58,0:12:37.84,Default,,0,0,0,,Гүлдер...
Dialogue: 0,0:12:38.09,0:12:41.13,Default,,0,0,0,,Хм, сіз де бетбелгі жасайсыз ба?
Dialogue: 0,0:12:44.88,0:12:46.26,Default,,0,0,0,,Сей! (Манана) Атта!
Dialogue: 0,0:12:48.43,0:12:49.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:49.72,0:12:53.52,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:12:53.93,0:12:54.98,Default,,0,0,0,,Ах! Ха!
Dialogue: 0,0:12:55.10,0:12:56.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:56.48,0:12:57.31,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:12:58.02,0:12:59.73,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:13:00.02,0:13:03.65,Default,,0,0,0,,Мынау... мектебіміздің қыздары осындай ма?
Dialogue: 0,0:13:04.07,0:13:07.20,Default,,0,0,0,,Оны ораңыз ба? Сіз оны осылай пайдаланасыз ...
Dialogue: 0,0:13:07.32,0:13:08.16,Default,,0,0,0,,Сәлем! (Манана) Ах.
Dialogue: 0,0:13:14.21,0:13:17.08,Default,,0,0,0,,Не... ештеңе болмағандай.
Dialogue: 0,0:13:17.46,0:13:18.71,Default,,0,0,0,,Ішің ауырды ма?
Dialogue: 0,0:13:18.83,0:13:19.84,Default,,0,0,0,,〜
Dialogue: 0,0:13:21.13,0:13:24.72,Default,,0,0,0,,Эй, мен мұны қарастыруым керек.
Dialogue: 0,0:13:26.05,0:13:28.80,Default,,0,0,0,,Жоқ, жоқ, қараңыз, сіз мұны түсінесіз, солай ма?
Dialogue: 0,0:13:28.93,0:13:30.51,Default,,0,0,0,,Не? сурет?
Dialogue: 0,0:13:30.89,0:13:32.14,Default,,0,0,0,,Мені бір нәрсе тоқтатты...
Dialogue: 0,0:13:32.26,0:13:34.35,Default,,0,0,0,,Мүлдем жоқ! Жоқ! (Шабдалы) Біраз қиналдың ба?
Dialogue: 0,0:13:34.48,0:13:35.68,Default,,0,0,0,,Ахаха
Dialogue: 0,0:13:35.81,0:13:37.56,Default,,0,0,0,,Иә? Сен ақымақсың ба?
Dialogue: 0,0:13:37.77,0:13:40.02,Default,,0,0,0,,Мен сізді онша естімеймін... Ах.
Dialogue: 0,0:13:40.19,0:13:41.65,Default,,0,0,0,,Ах~Шабуыл
Dialogue: 0,0:13:41.77,0:13:43.19,Default,,0,0,0,,Мен сөмкемді бердім.
Dialogue: 0,0:13:43.32,0:13:45.24,Default,,0,0,0,,Сөмкеңіз үшін рахмет (Манана) Иә, иә.
Dialogue: 0,0:13:45.36,0:13:47.03,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:13:47.49,0:13:50.82,Default,,0,0,0,,Алдағы жол еңіспен жалғанғанына сенімдімін.
Dialogue: 0,0:13:51.49,0:13:53.41,Default,,0,0,0,,Амал жоқ, болмайды, бұл оқушы
Dialogue: 0,0:13:54.12,0:13:56.37,Default,,0,0,0,,Мектепке барар жолда төте жолдарды қолданасыз ба?
Dialogue: 0,0:13:56.96,0:13:59.17,Default,,0,0,0,,Бірақ неге алаңдайсыз?
Dialogue: 0,0:13:59.79,0:14:02.46,Default,,0,0,0,,Бұл студентте өте шұғыл нәрсе бар ма?
Dialogue: 0,0:14:02.71,0:14:05.92,Default,,0,0,0,,Жоқ, бірақ қалыпты жүру жылдамырақ.
Dialogue: 0,0:14:06.38,0:14:07.72,Default,,0,0,0,,Табиғи нәтиже!
Dialogue: 0,0:14:08.18,0:14:11.55,Default,,0,0,0,,Студент достарым да көмектеспейтін сияқты.
Dialogue: 0,0:14:11.72,0:14:13.22,Default,,0,0,0,,Қашпа! Тікелей айтшы!
Dialogue: 0,0:14:13.85,0:14:16.73,Default,,0,0,0,,Шын мәнінде мақсат қандай?
Dialogue: 0,0:14:17.60,0:14:21.40,Default,,0,0,0,,Жоқ, бірінші кезекте осы екеуі
Dialogue: 0,0:14:23.15,0:14:25.44,Default,,0,0,0,,Біз бір-бірімізді шынымен дос деп атай аламыз ба?
Dialogue: 0,0:14:26.03,0:14:27.70,Default,,0,0,0,,Бұл өте...
Dialogue: 0,0:14:28.20,0:14:29.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:29.32,0:14:30.82,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:14:30.95,0:14:31.91,Default,,0,0,0,,Бұл су
Dialogue: 0,0:14:32.83,0:14:34.41,Default,,0,0,0,,Оны дос етіңіз...
Dialogue: 0,0:14:37.29,0:14:38.62,Default,,0,0,0,,Оны маған бермейсің бе?
Dialogue: 0,0:14:40.42,0:14:42.08,Default,,0,0,0,,А~ха~!
Dialogue: 0,0:14:42.75,0:14:45.05,Default,,0,0,0,,Күтілгендей, бұл екі...
Dialogue: 0,0:14:46.46,0:14:47.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:48.05,0:14:49.97,Default,,0,0,0,,Аа... соншалықты
Dialogue: 0,0:14:50.51,0:14:51.34,Default,,0,0,0,,Манана!
Dialogue: 0,0:14:52.60,0:14:55.26,Default,,0,0,0,,Әй, бұл әдемі...
Dialogue: 0,0:14:55.89,0:14:57.73,Default,,0,0,0,,Хмф! (Шабдалы) Міне осында!
Dialogue: 0,0:14:59.77,0:15:03.19,Default,,0,0,0,,Достардан гүлге басымдық бердім.
Dialogue: 0,0:15:03.31,0:15:04.98,Default,,0,0,0,,Манана!
Dialogue: 0,0:15:05.11,0:15:06.44,Default,,0,0,0,,А, мен ашуландым!
Dialogue: 0,0:15:06.57,0:15:07.65,Default,,0,0,0,,Неге...
Dialogue: 0,0:15:07.78,0:15:10.70,Default,,0,0,0,,О... тоқта! Сен не істеп жатырсың? Мұнда!
Dialogue: 0,0:15:11.91,0:15:14.24,Default,,0,0,0,,Тағы бір ұрыс басталды.
Dialogue: 0,0:15:14.87,0:15:18.41,Default,,0,0,0,,Бұл Самедзима академиясының деңгейі ме?
Dialogue: 0,0:15:19.33,0:15:23.75,Default,,0,0,0,,Профессор Гото және біз әкелетін нәтижелер
Dialogue: 0,0:15:27.50,0:15:29.88,Default,,0,0,0,,Бұл ұсқынсыз фигура
Dialogue: 0,0:15:33.18,0:15:35.35,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:15:36.51,0:15:38.60,Default,,0,0,0,,Балалар, тоқтаңдар!
Dialogue: 0,0:15:38.72,0:15:39.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:40.27,0:15:43.85,Default,,0,0,0,,Мен Самедзима Гакуэн студенттік кеңесінің 2-курс тәртіптік комитетінің мүшесімін.
Dialogue: 0,0:15:43.98,0:15:45.31,Default,,0,0,0,,...
Dialogue: 0,0:15:45.48,0:15:47.86,Default,,0,0,0,,Қоғамдық мораль комитетінің мүшесі ретінде мен сізге кеңес бергім келеді.
Dialogue: 0,0:15:48.36,0:15:50.95,Default,,0,0,0,,Танысуды тоқтату керек!
Dialogue: 0,0:15:53.36,0:15:55.37,Default,,0,0,0,,…
Dialogue: 0,0:15:55.49,0:15:58.12,Default,,0,0,0,,…
Dialogue: 0,0:15:58.66,0:16:02.71,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге ертерек еруім керек еді.
Dialogue: 0,0:16:02.96,0:16:05.00,Default,,0,0,0,,...
Dialogue: 0,0:16:05.25,0:16:07.80,Default,,0,0,0,,Жарға өрмелеп бара жатқан адамды да тоқтатпай (Манана) А?
Dialogue: 0,0:16:08.13,0:16:09.71,Default,,0,0,0,,...
Dialogue: 0,0:16:10.13,0:16:10.97,Default,,0,0,0,,Уф
Dialogue: 0,0:16:11.22,0:16:14.59,Default,,0,0,0,,Сендер бір-біріңе кері әсер етесіңдер.
Dialogue: 0,0:16:15.22,0:16:16.26,Default,,0,0,0,,♪ Вуф-вуф, вуф-вуф
Dialogue: 0,0:16:16.39,0:16:18.81,Default,,0,0,0,,Дос дегеніміз не? Бір-бірімізді көтереміз.
Dialogue: 0,0:16:18.93,0:16:22.23,Default,,0,0,0,,...
Dialogue: 0,0:16:25.60,0:16:27.61,Default,,0,0,0,,...
Dialogue: 0,0:16:27.73,0:16:30.78,Default,,0,0,0,,Өлім ортасында мен сенетін жалғыз адам...
Dialogue: 0,0:16:30.90,0:16:31.86,Default,,0,0,0,,Бұл
Dialogue: 0,0:16:32.28,0:16:34.82,Default,,0,0,0,,Сіздің ағаңыздың достары жоқ сияқты.
Dialogue: 0,0:16:35.20,0:16:36.03,Default,,0,0,0,,шықты
Dialogue: 0,0:16:36.28,0:16:37.83,Default,,0,0,0,,...
Dialogue: 0,0:16:38.20,0:16:42.79,Default,,0,0,0,,«Менің идеал досым» - достары жоқ адамның сөзі.
Dialogue: 0,0:16:43.46,0:16:46.83,Default,,0,0,0,,Бастауыш сыныптан бері осындай болдық.
Dialogue: 0,0:16:47.33,0:16:51.21,Default,,0,0,0,,...
Dialogue: 0,0:16:51.59,0:16:54.63,Default,,0,0,0,,Өйткені Чио Чан Самедзиманы қабылдайтынын айтты.
Dialogue: 0,0:16:54.97,0:16:56.51,Default,,0,0,0,,...
Dialogue: 0,0:16:58.30,0:16:59.72,Default,,0,0,0,,...
Dialogue: 0,0:16:59.85,0:17:02.73,Default,,0,0,0,,Мен көретіндей достығыңды дәлелде.
Dialogue: 0,0:17:03.06,0:17:04.35,Default,,0,0,0,,...
Dialogue: 0,0:17:04.48,0:17:09.02,Default,,0,0,0,,Біз бұрын растаған қауіпті әрекеттердің саны студенттік кеңес отырысында мәселе ретінде көтеріледі.
Dialogue: 0,0:17:10.19,0:17:11.03,Default,,0,0,0,,Иә
Dialogue: 0,0:17:11.15,0:17:13.94,Default,,0,0,0,,Мәселе мынада: біз жай ғана доспыз, солай ма?
Dialogue: 0,0:17:14.65,0:17:17.74,Default,,0,0,0,,Біз бір-бірімізді 10 жыл бойы білеміз, маған жаман қарады...
Dialogue: 0,0:17:19.87,0:17:21.99,Default,,0,0,0,,...
Dialogue: 0,0:17:22.83,0:17:24.83,Default,,0,0,0,,...
Dialogue: 0,0:17:24.96,0:17:26.00,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:17:26.67,0:17:28.38,Default,,0,0,0,,...
Dialogue: 0,0:17:28.50,0:17:31.21,Default,,0,0,0,,Жоқ, бұл жағдайда тіпті танысы да істей алады.
Dialogue: 0,0:17:31.34,0:17:33.80,Default,,0,0,0,,...
Dialogue: 0,0:17:34.13,0:17:36.63,Default,,0,0,0,,…
Dialogue: 0,0:17:36.76,0:17:38.43,Default,,0,0,0,,（）
Dialogue: 0,0:17:39.22,0:17:41.10,Default,,0,0,0,,...
Dialogue: 0,0:17:41.97,0:17:42.97,Default,,0,0,0,,«Бұл»?
Dialogue: 0,0:17:44.06,0:17:46.85,Default,,0,0,0,,…
Dialogue: 0,0:17:46.98,0:17:48.06,Default,,0,0,0,,Сен өлесің!
Dialogue: 0,0:17:50.81,0:17:52.48,Default,,0,0,0,,...
Dialogue: 0,0:17:54.44,0:17:56.53,Default,,0,0,0,,Қарашы, сенпай.
Dialogue: 0,0:17:57.36,0:17:58.66,Default,,0,0,0,,...
Dialogue: 0,0:17:58.78,0:18:01.78,Default,,0,0,0,,Біз мұны бастауыш мектептегі дене шынықтыру сабағында бірге жасадық.
Dialogue: 0,0:18:01.91,0:18:03.45,Default,,0,0,0,,Шығармашылық би
Dialogue: 0,0:18:07.58,0:18:08.67,Default,,0,0,0,,Тақырып
Dialogue: 0,0:18:09.08,0:18:10.58,Default,,0,0,0,,«Мананачио»
Dialogue: 0,0:18:12.80,0:18:14.46,Default,,0,0,0,,болуы тиіс
Dialogue: 0,0:18:14.88,0:18:15.71,Default,,0,0,0,,Не!
Dialogue: 0,0:18:16.17,0:18:17.88,Default,,0,0,0,,♪ Няняняня Няняня~ня
Dialogue: 0,0:18:18.01,0:18:20.18,Default,,0,0,0,,♪ Ня~ня~
Dialogue: 0,0:18:20.30,0:18:23.64,Default,,0,0,0,,♪ Ня ла ла ла ня ла ла ня ~ ла ла
Dialogue: 0,0:18:23.76,0:18:25.31,Default,,0,0,0,,♪ Няняняня Нянян~ня
Dialogue: 0,0:18:25.43,0:18:27.64,Default,,0,0,0,,♪ Ня~няня~
Dialogue: 0,0:18:27.77,0:18:31.06,Default,,0,0,0,,♪ Ня ла ла ла ня ла ла ня ~ ла ла
Dialogue: 0,0:18:31.19,0:18:33.69,Default,,0,0,0,,♪ Хэхехехехехехехехе~
Dialogue: 0,0:18:33.98,0:18:34.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:37.74,0:18:40.16,Default,,0,0,0,,Ня~
Dialogue: 0,0:18:40.28,0:18:41.95,Default,,0,0,0,,♪ Няняняня Няняня~ня
Dialogue: 0,0:18:42.07,0:18:44.37,Default,,0,0,0,,♪ Ня~ня~
Dialogue: 0,0:18:45.45,0:18:47.33,Default,,0,0,0,,♪ Ня~ня~ Ня~няняня
Dialogue: 0,0:18:47.45,0:18:51.29,Default,,0,0,0,,♪ Ня~Ня~ Ня~Ня~
Dialogue: 0,0:18:53.17,0:18:54.55,Default,,0,0,0,,♪ Маня-нято
Dialogue: 0,0:18:54.67,0:18:56.05,Default,,0,0,0,,♪ Чионья де
Dialogue: 0,0:18:56.17,0:18:59.01,Default,,0,0,0,,♪ Маниятчио!
Dialogue: 0,0:19:04.76,0:19:05.60,Default,,0,0,0,,Бұл!
Dialogue: 0,0:19:05.72,0:19:07.18,Default,,0,0,0,,Бұл аяқталды!
Dialogue: 0,0:19:07.93,0:19:09.73,Default,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:19:09.85,0:19:11.06,Default,,0,0,0,,Жылап жатырсыз ба?
Dialogue: 0,0:19:11.48,0:19:15.57,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:19:15.69,0:19:18.69,Default,,0,0,0,,Уф, мен көрдім...
Dialogue: 0,0:19:22.53,0:19:24.87,Default,,0,0,0,,Уәде етілгендей, сұрақтар қойылмаған.
Dialogue: 0,0:19:24.99,0:19:27.49,Default,,0,0,0,,А, онда орындайық.
Dialogue: 0,0:19:27.62,0:19:29.54,Default,,0,0,0,,Мен мұны істегеніме біраз уақыт болды.
Dialogue: 0,0:19:29.66,0:19:30.87,Default,,0,0,0,,Естеріңізде.
Dialogue: 0,0:19:31.00,0:19:33.83,Default,,0,0,0,,Мм... Ақырында, жақсы ма?
Dialogue: 0,0:19:35.13,0:19:37.38,Default,,0,0,0,,Томо… жоқ.
Dialogue: 0,0:19:37.63,0:19:42.05,Default,,0,0,0,,Маған ұнайтын адамдармен дос болу үшін не істеуім керек?
Dialogue: 0,0:19:44.85,0:19:47.47,Default,,0,0,0,,Сіз Гото мырзаны айтасыз ба?
Dialogue: 0,0:19:47.60,0:19:48.47,Default,,0,0,0,,Ұш!
Dialogue: 0,0:19:48.60,0:19:50.02,Default,,0,0,0,,Ал, солай шығар.
Dialogue: 0,0:19:50.23,0:19:54.65,Default,,0,0,0,,Жоқ, бұл оқушы мен мұғалімнің махаббаты сияқты үлкен мәселе.
Dialogue: 0,0:19:54.90,0:19:56.65,Default,,0,0,0,,Жартылай мойындау сияқты.
Dialogue: 0,0:19:57.23,0:19:58.07,Default,,0,0,0,,Аға
Dialogue: 0,0:19:58.61,0:19:59.82,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:20:00.11,0:20:02.61,Default,,0,0,0,,Ұстазыма ғашық болып, қиналып қалсам ше?
Dialogue: 0,0:20:02.74,0:20:04.78,Default,,0,0,0,,Мұның барлығы мұғалімнің міндеті.
Dialogue: 0,0:20:04.91,0:20:05.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:05.87,0:20:08.49,Default,,0,0,0,,Сондықтан қарт адамдар мүмкіндігінше бару керек!
Dialogue: 0,0:20:08.74,0:20:10.95,Default,,0,0,0,,А... Манананың көңілі көтеріліп барады.
Dialogue: 0,0:20:11.08,0:20:13.08,Default,,0,0,0,,Бұл өте жақсы!
Dialogue: 0,0:20:13.79,0:20:16.17,Default,,0,0,0,,Солай ма...?
Dialogue: 0,0:20:16.29,0:20:17.13,Default,,0,0,0,,Міне!
Dialogue: 0,0:20:17.38,0:20:21.51,Default,,0,0,0,,Қарсы болмасаңыз, менің кеңесшім бола аласыз ба?
Dialogue: 0,0:20:21.63,0:20:22.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:22.67,0:20:24.68,Default,,0,0,0,,Сіз сенімдісіз бе? Қарсыластарыңызды бақылауда ұстаңыз! иә!
Dialogue: 0,0:20:24.80,0:20:25.64,Default,,0,0,0,,Тексеріңіз!
Dialogue: 0,0:20:26.39,0:20:29.26,Default,,0,0,0,,Ал Сенпай: «Әйелдер жұмбақ».
Dialogue: 0,0:20:29.39,0:20:30.60,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:20:30.72,0:20:34.48,Default,,0,0,0,,Ах~ Әйелдер жұмбақ... Мысалы, не?
Dialogue: 0,0:20:36.94,0:20:38.57,Default,,0,0,0,,Барлығы есеп үшін.
Dialogue: 0,0:20:38.77,0:20:41.40,Default,,0,0,0,,«Ешқандай ауытқу жоқ»?
Dialogue: 0,0:20:42.28,0:20:45.49,Default,,0,0,0,,Дегенмен, жалғыз әрекет етуден аулақ болыңыз.
Dialogue: 0,0:20:45.61,0:20:46.45,Default,,0,0,0,,Иә
Dialogue: 0,0:20:46.70,0:20:49.53,Default,,0,0,0,,Айтпақшы, сенің жаның сәл босаған.
Dialogue: 0,0:20:49.66,0:20:50.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:51.25,0:20:54.58,Default,,0,0,0,,Сіздің патрульдік қызметіңізде жақсы нәрсе болды ма?
Dialogue: 0,0:20:55.21,0:20:58.09,Default,,0,0,0,,А-а-а-а.
Dialogue: 0,0:20:58.34,0:20:59.71,Default,,0,0,0,,Осындай кезде мен сенімдімін...
Dialogue: 0,0:20:59.84,0:21:00.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:01.67,0:21:03.26,Default,,0,0,0,,Бұл құпия
Dialogue: 0,0:21:03.92,0:21:05.43,Default,,0,0,0,,О~
Dialogue: 0,0:21:11.47,0:21:13.18,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:21:13.31,0:21:17.19,Default,,0,0,0,,Гото-чан, мені тыңда.
Dialogue: 0,0:21:17.31,0:21:18.69,Default,,0,0,0,,Ең алдымен сәлемдесу.
Dialogue: 0,0:21:18.81,0:21:19.65,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:20.02,0:21:21.86,Default,,0,0,0,,деді Нономура мырза
Dialogue: 0,0:21:21.98,0:21:23.78,Default,,0,0,0,,Қарсыластарыңызды бақылауда ұстаңыз!
Dialogue: 0,0:21:25.74,0:21:27.03,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:21:27.16,0:21:30.08,Default,,0,0,0,,Егер сіз қоғамдық моральдық комитеттің кеңесшісі Гото-сенсэймен сөйлескіңіз келсе.
Dialogue: 0,0:21:30.20,0:21:32.12,Default,,0,0,0,,Өзіңізге жақсырақ қамқорлық жасаңыз.
Dialogue: 0,0:21:35.08,0:21:37.33,Default,,0,0,0,,Ах фу~ (шабдалы) Иә?
Dialogue: 0,0:21:37.58,0:21:39.38,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:21:39.50,0:21:42.88,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,0:21:43.01,0:21:44.92,Default,,0,0,0,,Түсіндірсем
Dialogue: 0,0:21:45.22,0:21:47.76,Default,,0,0,0,,Оның өте жойқын күші бар.
Dialogue: 0,0:21:48.18,0:21:50.43,Default,,0,0,0,,Таңба Бұл сәйкес пе?
Dialogue: 0,0:21:51.89,0:21:53.06,Default,,0,0,0,,Уф уф... (Сетояма) Хехехе
Dialogue: 0,0:21:53.18,0:21:56.56,Default,,0,0,0,,Хехехехехехехехе
Dialogue: 0,0:21:57.02,0:21:58.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:58.94,0:22:04.94,Default,,0,0,0,,♪〜
Dialogue: 0,0:23:18.93,0:23:24.94,Default,,0,0,0,,〜♪
Dialogue: 0,0:23:28.99,0:23:30.90,Default,,0,0,0,,Келесі жолы «Чио-чанның мектеп жолы»
Dialogue: 0,0:23:31.32,0:23:32.86,Default,,0,0,0,,«Әр жол»
Dialogue: 0,0:23:32.99,0:23:35.33,Default,,0,0,0,,«Элуд Чио-чан» 2 бөлімі болады.
Dialogue: 0,0:23:35.49,0:23:36.83,Default,,0,0,0,,Ләззат алыңыз... ♪ Няняняня
Dialogue: 0,0:23:36.95,0:23:40.25,Default,,0,0,0,,♪ Няня~Ня Ня~Няня~
Dialogue: 0,0:23:41.75,0:23:47.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory