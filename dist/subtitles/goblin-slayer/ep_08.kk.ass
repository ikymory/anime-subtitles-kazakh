Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:06.54,Default,,0,0,0,,♪~
Dialogue: 0,0:01:25.75,0:01:30.92,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.46,0:01:33.84,Default,,0,0,0,,(Боранның дыбысы)
Dialogue: 0,0:01:34.67,0:01:35.67,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:01:35.80,0:01:38.01,Default,,0,0,0,,Бүгін не істеуім керек?
Dialogue: 0,0:01:38.13,0:01:40.01,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:01:40.18,0:01:42.10,Default,,0,0,0,,Сен мүлде ақымақсың!
Dialogue: 0,0:01:42.64,0:01:44.39,Default,,0,0,0,,Уф! (Фермер) Мен соққыға түстім!
Dialogue: 0,0:01:44.52,0:01:46.77,Default,,0,0,0,,Сондықтан мен кері соққы бердім! Гоблиндер!
Dialogue: 0,0:01:47.19,0:01:52.19,Default,,0,0,0,,Раушан гүлдер ақылды. Сіз гоблинді өлтіре аласыз ба?
Dialogue: 0,0:01:52.40,0:01:53.48,Default,,0,0,0,,өлтіру
Dialogue: 0,0:01:53.61,0:01:55.28,Default,,0,0,0,,(Даладағы адамдардың күлкісі)
Dialogue: 0,0:01:55.74,0:01:58.91,Default,,0,0,0,,Менің асыл әпкем гоблиннің ойыншығы ретінде пайдаланылып жатқанда...
Dialogue: 0,0:01:59.03,0:02:01.78,Default,,0,0,0,,Сіз жай ғана үнсіз қарап тұрдыңыз ба?
Dialogue: 0,0:02:02.03,0:02:04.95,Default,,0,0,0,,Сен неге жай ғана секіріп, гоблинді ұрмадың?
Dialogue: 0,0:02:05.08,0:02:07.58,Default,,0,0,0,,Әпкеңмен бірге қашып кеткен жоқсың ба?
Dialogue: 0,0:02:08.25,0:02:09.37,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:02:09.96,0:02:13.17,Default,,0,0,0,,Қолында күші жоқ деп ештеңе істемеген...
Dialogue: 0,0:02:13.29,0:02:17.51,Default,,0,0,0,,Сіз күш алған бойда бірдеңе істей аламын деп ойладыңыз ба?
Dialogue: 0,0:02:17.63,0:02:19.97,Default,,0,0,0,,Мүмкін болса да, жабатын еді.
Dialogue: 0,0:02:20.09,0:02:22.30,Default,,0,0,0,,Бірден қабыршақтанып, құлап кетті!
Dialogue: 0,0:02:23.97,0:02:26.93,Default,,0,0,0,,Бірақ оны өзіңіз шешесіз.
Dialogue: 0,0:02:27.56,0:02:32.52,Default,,0,0,0,,Сіз бірдеңе істеуге шешім қабылдап, оны айналдыра салсаңыз, сіз жеңесіз.
Dialogue: 0,0:02:34.19,0:02:37.90,Default,,0,0,0,,Сәттілік даналығы Бұл жігер
Dialogue: 0,0:02:38.03,0:02:42.37,Default,,0,0,0,,Жаса немесе жасама, бұл бірінші нәрсе! Жай ғана орында!
Dialogue: 0,0:02:42.49,0:02:43.74,Default,,0,0,0,,Иә мырза
Dialogue: 0,0:02:43.87,0:02:45.37,Default,,0,0,0,,Жоғарыға қараңыз!
Dialogue: 0,0:02:46.08,0:02:48.20,Default,,0,0,0,,Бұл жұмбақ! Жұмбақ!
Dialogue: 0,0:02:48.41,0:02:50.87,Default,,0,0,0,,Өлгің келмесе, тез жауап бер.
Dialogue: 0,0:02:51.37,0:02:52.92,Default,,0,0,0,,Иә мырза
Dialogue: 0,0:02:53.04,0:02:54.17,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:02:54.75,0:02:57.96,Default,,0,0,0,,Тәңірлерден гөрі әділеттілік! Жамандықтан да жамандық!
Dialogue: 0,0:02:58.09,0:03:00.43,Default,,0,0,0,,Ауқатты адамдарға қажет! Кедейлерге керек емес!
Dialogue: 0,0:03:00.55,0:03:01.76,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:03:02.14,0:03:05.31,Default,,0,0,0,,Ал, абай бол, езіліп қаласың.
Dialogue: 0,0:03:06.72,0:03:09.35,Default,,0,0,0,,Ештеңе Жауап ештеңе емес!
Dialogue: 0,0:03:09.48,0:03:11.77,Default,,0,0,0,,Иә! Мынау ше?
Dialogue: 0,0:03:11.90,0:03:15.69,Default,,0,0,0,,Ол сізге әрқашан кез келген уақытта көрінеді.
Dialogue: 0,0:03:16.23,0:03:17.82,Default,,0,0,0,,Мен сені ешқашан жібермеймін
Dialogue: 0,0:03:18.36,0:03:20.28,Default,,0,0,0,,Онымен сөйлесуге де болмайды.
Dialogue: 0,0:03:20.90,0:03:23.74,Default,,0,0,0,,Міне, сенің жаныңда! Бас тартыңыз!
Dialogue: 0,0:03:29.25,0:03:31.04,Default,,0,0,0,,Жауап - өлім... өлім!
Dialogue: 0,0:03:34.96,0:03:38.09,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:03:39.59,0:03:44.26,Default,,0,0,0,,Соңында менің қалтамда не бар деп жауап беріңдерші?
Dialogue: 0,0:03:44.39,0:03:45.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:45.80,0:03:47.85,Default,,0,0,0,,Бізде не бар?
Dialogue: 0,0:03:47.97,0:03:51.52,Default,,0,0,0,,(Боранның дыбысы)
Dialogue: 0,0:04:03.15,0:04:04.57,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:05.28,0:04:07.58,Default,,0,0,0,,Ух... Ммм... (Гоблин өлтіруші) А...
Dialogue: 0,0:04:08.53,0:04:15.00,Default,,0,0,0,,(Әулие әйелдің тынысы)
Dialogue: 0,0:04:15.88,0:04:17.17,Default,,0,0,0,,Я...
Dialogue: 0,0:04:18.09,0:04:20.71,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:04:23.80,0:04:25.59,Default,,0,0,0,,Сіз ояу сияқтысыз.
Dialogue: 0,0:04:32.02,0:04:38.36,Default,,0,0,0,,Қалай болды? Мен және онымен төсек бөлісіңіз
Dialogue: 0,0:04:38.94,0:04:40.69,Default,,0,0,0,,Бұл жаман болған жоқ.
Dialogue: 0,0:04:41.36,0:04:43.74,Default,,0,0,0,,Бұл қыз некенің кереметі
Dialogue: 0,0:04:44.28,0:04:45.20,Default,,0,0,0,,Қайта тірілу?
Dialogue: 0,0:04:45.66,0:04:48.49,Default,,0,0,0,,О, сен мұны білдің.
Dialogue: 0,0:04:48.62,0:04:50.41,Default,,0,0,0,,Білім ретінде емес
Dialogue: 0,0:04:52.08,0:04:57.54,Default,,0,0,0,,Дегенмен, мен енді тазамын деп айта алмаймын...
Dialogue: 0,0:04:58.38,0:04:59.59,Default,,0,0,0,,Гоблин?
Dialogue: 0,0:04:59.71,0:05:03.55,Default,,0,0,0,,Иә, 10 жыл өтті.
Dialogue: 0,0:05:04.26,0:05:07.93,Default,,0,0,0,,Гоблиндер үңгірде ұстап алды
Dialogue: 0,0:05:08.39,0:05:11.51,Default,,0,0,0,,Не істегеніңізді сұрасам болады ма?
Dialogue: 0,0:05:11.85,0:05:12.93,Default,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:05:13.06,0:05:14.02,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:14.52,0:05:19.36,Default,,0,0,0,,«Ауады, ауырады» Балаша жыладым...
Dialogue: 0,0:05:21.32,0:05:24.19,Default,,0,0,0,,Бірақ сіз оны көре аласыз.
Dialogue: 0,0:05:24.32,0:05:28.16,Default,,0,0,0,,Бұлыңғыр болса да, сіздің көлеңкеңізге ұқсайды
Dialogue: 0,0:05:28.74,0:05:29.70,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:05:30.45,0:05:33.62,Default,,0,0,0,,Олар барлық жерде, бірақ егер сіз олардан көзіңізді алсаңыз ...
Dialogue: 0,0:05:33.75,0:05:37.42,Default,,0,0,0,,Көлеңке тәрізді, кенет жоғалып кеткен адам.
Dialogue: 0,0:05:38.37,0:05:42.21,Default,,0,0,0,,Адамдар... әйелдер әлсіз.
Dialogue: 0,0:05:43.21,0:05:46.59,Default,,0,0,0,,Мен уайымдаймын, қорқамын.
Dialogue: 0,0:05:46.72,0:05:48.22,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,0:05:48.97,0:05:55.10,Default,,0,0,0,,Қылыш қызы деуге болатын әйел әр түнде қорқып, үрейленетін.
Dialogue: 0,0:05:55.35,0:05:57.48,Default,,0,0,0,,Бұл қайтымсыз.
Dialogue: 0,0:05:58.56,0:06:03.44,Default,,0,0,0,,Бұл дүние, қанша нәрсе көмектессе де...
Dialogue: 0,0:06:03.86,0:06:06.82,Default,,0,0,0,,Басқа адамдар түсінбейтін шығар, бірақ
Dialogue: 0,0:06:06.94,0:06:07.78,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:06:08.45,0:06:09.61,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:12.37,0:06:15.91,Default,,0,0,0,,«Мен көремін»...хехе
Dialogue: 0,0:06:16.20,0:06:17.25,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:18.08,0:06:20.67,Default,,0,0,0,,Бұл біртүрлі емес пе?
Dialogue: 0,0:06:20.79,0:06:24.84,Default,,0,0,0,,Мен бір кезде жынды бағындырған әйелмін.
Dialogue: 0,0:06:25.46,0:06:29.68,Default,,0,0,0,,Бұл әсерлерден қорқатындықтан...
Dialogue: 0,0:06:30.72,0:06:31.84,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:06:32.89,0:06:37.14,Default,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 0,0:06:38.48,0:06:39.85,Default,,0,0,0,,(тұру дыбысы)
Dialogue: 0,0:06:39.98,0:06:41.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:43.65,0:06:46.94,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:47.07,0:06:48.07,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:48.65,0:06:49.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:50.53,0:06:51.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:52.57,0:06:53.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:54.20,0:06:57.62,Default,,0,0,0,,Ах! О... Сондай-ақ... Мм...
Dialogue: 0,0:06:58.04,0:07:01.21,Default,,0,0,0,,Ми... көрдің бе!? (Гоблин өлтіруші) О
Dialogue: 0,0:07:02.33,0:07:03.92,Default,,0,0,0,,Уайымдама (Діни әйел)...
Dialogue: 0,0:07:04.59,0:07:06.17,Default,,0,0,0,,Шрамы қалмады
Dialogue: 0,0:07:07.51,0:07:08.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:10.63,0:07:14.60,Default,,0,0,0,,Жарақатыңыз жақсы ма?
Dialogue: 0,0:07:15.01,0:07:16.01,Default,,0,0,0,,О
Dialogue: 0,0:07:16.81,0:07:19.85,Default,,0,0,0,,Goblin Slayer дегеніміз не?
Dialogue: 0,0:07:20.35,0:07:21.64,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:07:23.19,0:07:25.65,Default,,0,0,0,,Сіз ақылға сыймайтын нәрсе істеп жатырсыз ба?
Dialogue: 0,0:07:26.52,0:07:28.11,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:07:30.36,0:07:33.41,Default,,0,0,0,,Бір нәрсе әдеттегіден басқаша сияқты...
Dialogue: 0,0:07:34.41,0:07:35.66,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:07:36.45,0:07:38.62,Default,,0,0,0,,Ештеңе өзгермейді.
Dialogue: 0,0:07:40.20,0:07:43.42,Default,,0,0,0,,Мм... Гоблин өлтіруші ме?
Dialogue: 0,0:07:43.54,0:07:45.08,Default,,0,0,0,,Міне! (есіктің ашылған дыбысы)
Dialogue: 0,0:07:45.54,0:07:48.50,Default,,0,0,0,,Екеуің де! Мен сенің оянғаныңды естідім!
Dialogue: 0,0:07:48.63,0:07:50.17,Default,,0,0,0,,Амансың ба? Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:50.30,0:07:54.30,Default,,0,0,0,,Маңызды емес сияқты, Камикиримарудың қызы бар.
Dialogue: 0,0:07:54.43,0:07:58.10,Default,,0,0,0,,Ота дер кезінде жасалғанына қуаныштымын.
Dialogue: 0,0:07:58.60,0:08:01.18,Default,,0,0,0,,Хм, бәрі қауіпсіз бе?
Dialogue: 0,0:07:58.60,0:08:01.18,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:08:01.31,0:08:04.06,Default,,0,0,0,,Оркборг осылай дейді?
Dialogue: 0,0:08:04.19,0:08:05.40,Default,,0,0,0,,Канариялар ше?
Dialogue: 0,0:08:05.52,0:08:06.69,Default,,0,0,0,,Жақсы болғаны дұрыс
Dialogue: 0,0:08:07.61,0:08:11.19,Default,,0,0,0,,Дәлірек айтсақ, ең қауіптісі Орқболға болды.
Dialogue: 0,0:08:11.74,0:08:13.70,Default,,0,0,0,,Ол оянған бойда
Dialogue: 0,0:08:13.82,0:08:17.16,Default,,0,0,0,,«Мистер Гоблин өлтіруші!?» Мен жылай бастадым, бұл өте қиын болды~
Dialogue: 0,0:08:17.28,0:08:19.37,Default,,0,0,0,,Уау! Күте тұрыңыз... бір сәт
Dialogue: 0,0:08:19.49,0:08:20.70,Default,,0,0,0,,Айтпауға уәде бер...
Dialogue: 0,0:08:20.83,0:08:22.29,Default,,0,0,0,,Айтпасаң, түсіне алмайсың, солай ма?
Dialogue: 0,0:08:22.41,0:08:23.29,Default,,0,0,0,,Хмм! (Кесіртке монах)
Dialogue: 0,0:08:23.54,0:08:25.63,Default,,0,0,0,,Қалай болғанда да, енді сіз алаңдамай зерттей аласыз.
Dialogue: 0,0:08:25.75,0:08:29.09,Default,,0,0,0,,Жалғастыруға болады, солай ма?
Dialogue: 0,0:08:29.80,0:08:33.80,Default,,0,0,0,,Оған дейін бірнеше қаруға тапсырыс берген дұрыс...
Dialogue: 0,0:08:33.93,0:08:38.43,Default,,0,0,0,,Бака, таразылар! Алдымен тамақ ішіп алайық.
Dialogue: 0,0:08:38.55,0:08:40.18,Default,,0,0,0,,Ой, мен мұны істедім!
Dialogue: 0,0:08:40.56,0:08:42.60,Default,,0,0,0,,(Кесіртке монах пен кенші адамның күлкісі)
Dialogue: 0,0:08:42.73,0:08:45.14,Default,,0,0,0,,Ешкім тамақ жеген жоқ па?
Dialogue: 0,0:08:45.48,0:08:48.86,Default,,0,0,0,,Иә, уәде бердіңіз.
Dialogue: 0,0:08:48.98,0:08:52.40,Default,,0,0,0,,Таудан өткен соң бәріміз бірге тамақтанайық.
Dialogue: 0,0:08:52.53,0:08:53.36,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:08:54.07,0:08:57.11,Default,,0,0,0,,Мен уәдемді орындауым керек, солай ма?
Dialogue: 0,0:08:59.74,0:09:03.00,Default,,0,0,0,,(канар айқайы)
Dialogue: 0,0:09:05.62,0:09:06.87,Default,,0,0,0,,Бұл дәмді!
Dialogue: 0,0:09:07.12,0:09:09.29,Default,,0,0,0,,Қарны ашқандар үшін бұл тосынсый!
Dialogue: 0,0:09:09.42,0:09:13.13,Default,,0,0,0,,Бірге жеген ас та ерекше.
Dialogue: 0,0:09:16.13,0:09:17.55,Default,,0,0,0,,Содан кейін Орқболғ және басқалары...
Dialogue: 0,0:09:17.68,0:09:18.80,Default,,0,0,0,,Демалыңыз!
Dialogue: 0,0:09:19.39,0:09:22.01,Default,,0,0,0,,Біз жер астының арғы жағына қараймыз!
Dialogue: 0,0:09:22.14,0:09:23.10,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:09:23.52,0:09:27.23,Default,,0,0,0,,Құрал-жабдығы жоқ жауынгерді өзімен бірге алып кету өте қауіпті.
Dialogue: 0,0:09:28.02,0:09:29.61,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:30.36,0:09:31.44,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:09:32.90,0:09:33.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:35.90,0:09:36.86,Default,,0,0,0,,Сізде бар ма?
Dialogue: 0,0:09:36.99,0:09:39.24,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:09:39.37,0:09:40.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:43.70,0:09:46.41,Default,,0,0,0,,Бәріңіз, бәріңіз жақсы болатыныңызға сенімдімін.
Dialogue: 0,0:09:47.33,0:09:48.33,Default,,0,0,0,,О
Dialogue: 0,0:09:48.75,0:09:51.21,Default,,0,0,0,,Жарақатыңыз жақсы ма?
Dialogue: 0,0:09:51.34,0:09:52.17,Default,,0,0,0,,О
Dialogue: 0,0:09:52.30,0:09:54.71,Default,,0,0,0,,Сіз ақылсыз ештеңе істемеуіңіз керек.
Dialogue: 0,0:09:54.84,0:09:55.84,Default,,0,0,0,,О
Dialogue: 0,0:09:59.43,0:10:00.26,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:00.39,0:10:02.26,Default,,0,0,0,,Бұл «Не болды?» емес.
Dialogue: 0,0:10:02.97,0:10:04.27,Default,,0,0,0,,Гоблин өлтіруші
Dialogue: 0,0:10:04.39,0:10:06.98,Default,,0,0,0,,Сіз үнемі «ах» деп айтасыз!
Dialogue: 0,0:10:07.10,0:10:08.06,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:10:08.19,0:10:09.23,Default,,0,0,0,,Бұл Зенитсудың дауысы!
Dialogue: 0,0:10:09.90,0:10:10.81,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:10.94,0:10:13.23,Default,,0,0,0,,«Мен көремін» дегендер де көп.
Dialogue: 0,0:10:13.36,0:10:14.19,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:10:14.78,0:10:16.19,Default,,0,0,0,,Жақсылық жасайық
Dialogue: 0,0:10:16.32,0:10:19.03,Default,,0,0,0,,Өтінемін, солай істеңіз, хехе
Dialogue: 0,0:10:20.78,0:10:24.08,Default,,0,0,0,,Сонымен, сіз дүкенге барғыңыз келетінін айттыңыз...
Dialogue: 0,0:10:24.20,0:10:25.66,Default,,0,0,0,,Ах (Діни әйел) Ммм.
Dialogue: 0,0:10:26.62,0:10:29.21,Default,,0,0,0,,Мен қару-жарақ пен сауыт-сайманға қараймын.
Dialogue: 0,0:10:29.33,0:10:30.88,Default,,0,0,0,,Өйткені ол бұзылған
Dialogue: 0,0:10:31.08,0:10:32.17,Default,,0,0,0,,Не істейсің?
Dialogue: 0,0:10:32.67,0:10:38.51,Default,,0,0,0,,Менің шынжырлы поштам да жыртылды, сондықтан оны жөндейтін дүкен болса екен...
Dialogue: 0,0:10:39.01,0:10:40.80,Default,,0,0,0,,Жаңасын сатып алу жылдамырақ болар еді
Dialogue: 0,0:10:40.93,0:10:43.72,Default,,0,0,0,,Маған бұл ұнамайды. (Гоблин өлтіруші) Неліктен?
Dialogue: 0,0:10:44.51,0:10:46.89,Default,,0,0,0,,Өйткені бұл Гоблин өлтіруші.
Dialogue: 0,0:10:47.02,0:10:49.10,Default,,0,0,0,,Маған бірінші мақтағаныңыз осы емес пе?
Dialogue: 0,0:10:50.31,0:10:51.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:54.11,0:10:55.52,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:10:57.23,0:10:59.20,Default,,0,0,0,,Бұл қазірдің өзінде тесік.
Dialogue: 0,0:10:59.40,0:11:01.24,Default,,0,0,0,,Жаңасын алған жақсы емес пе?
Dialogue: 0,0:11:01.36,0:11:03.70,Default,,0,0,0,,Жоқ, мен жөндеу жұмыстарын сұрағым келеді...
Dialogue: 0,0:11:04.24,0:11:07.24,Default,,0,0,0,,Иә, иә, жөндеп көрейік.
Dialogue: 0,0:11:07.66,0:11:08.54,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:09.37,0:11:11.58,Default,,0,0,0,,Оны қайта жасағыңыз келе ме?
Dialogue: 0,0:11:11.71,0:11:13.75,Default,,0,0,0,,Эй... жақсы!
Dialogue: 0,0:11:13.88,0:11:15.92,Default,,0,0,0,,Гуфуфу... Уау!
Dialogue: 0,0:11:17.00,0:11:18.21,Default,,0,0,0,,Жөндеу.
Dialogue: 0,0:11:18.76,0:11:20.80,Default,,0,0,0,,G... Күміс сұрыпты...
Dialogue: 0,0:11:21.30,0:11:24.64,Default,,0,0,0,,Былғары сауыт және дөңгелек қалқан, асығыңыздар.
Dialogue: 0,0:11:24.76,0:11:27.35,Default,,0,0,0,,Сіздің желілік поштаңызбен біріктірілген.
Dialogue: 0,0:11:27.47,0:11:30.39,Default,,0,0,0,,Арнайы баға болса, бағасы жақсы...
Dialogue: 0,0:11:30.68,0:11:31.85,Default,,0,0,0,,Харизма!
Dialogue: 0,0:11:32.19,0:11:35.02,Default,,0,0,0,,А... Сізге көп рахмет!
Dialogue: 0,0:11:35.15,0:11:36.15,Default,,0,0,0,,Мен саған қылышты көрсетемін.
Dialogue: 0,0:11:36.27,0:11:37.44,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:11:39.65,0:11:40.74,Default,,0,0,0,,Мынаны алыңыз
Dialogue: 0,0:11:40.86,0:11:43.07,Default,,0,0,0,,Біраз ұзын, бірақ мен оны өзім ысқылаймын.
Dialogue: 0,0:11:43.20,0:11:44.24,Default,,0,0,0,,Мен иілгіш тасты қарызға аламын.
Dialogue: 0,0:11:44.62,0:11:48.29,Default,,0,0,0,,Бірақ тұтынушы, егер сіз сондай болсаңыз, сіз ең көп дегенде кішкентай жынсыз...
Dialogue: 0,0:11:48.41,0:11:49.95,Default,,0,0,0,,Импульстарды жою үшін қолданылады
Dialogue: 0,0:11:50.08,0:11:51.08,Default,,0,0,0,,Иә!?
Dialogue: 0,0:11:57.42,0:11:58.59,Default,,0,0,0,,Қош келдіңіз, қош келдіңіз.
Dialogue: 0,0:11:57.42,0:11:58.59,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:11:58.59,0:11:59.67,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:11:59.92,0:12:02.72,Default,,0,0,0,,Жүр, «Исукурин» сенің жағаңды ерітеді.
Dialogue: 0,0:12:02.84,0:12:05.05,Default,,0,0,0,,Дәмді, дәмді балмұздақ!
Dialogue: 0,0:12:05.30,0:12:06.14,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:12:06.26,0:12:08.68,Default,,0,0,0,,Балмұздақ? Бұл не?
Dialogue: 0,0:12:09.47,0:12:10.85,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:12:10.98,0:12:15.15,Default,,0,0,0,,Балалардың жиналғанын көргенде, бұл кәмпиттің бір түрі шығар деп ойлаймын.
Dialogue: 0,0:12:17.36,0:12:18.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:19.36,0:12:20.57,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:12:20.69,0:12:23.65,Default,,0,0,0,,Иә, рахмет!
Dialogue: 0,0:12:34.00,0:12:35.75,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:12:36.00,0:12:39.55,Default,,0,0,0,,Керемет! Бұл суық және тәтті!
Dialogue: 0,0:12:39.67,0:12:41.88,Default,,0,0,0,,Жақсы ма? (Әулие әйел) Иә, өте!
Dialogue: 0,0:12:42.59,0:12:43.80,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:43.92,0:12:47.55,Default,,0,0,0,,Хмм, бұл мұз кәмпит деп аталады.
Dialogue: 0,0:12:48.14,0:12:51.35,Default,,0,0,0,,Бұл сиқырдың бір түрі емес. Сіз оны қалай жасайсыз?
Dialogue: 0,0:12:51.47,0:12:52.52,Default,,0,0,0,,Иә
Dialogue: 0,0:12:52.64,0:12:56.27,Default,,0,0,0,,Бір бойдақ отты эликсирді суға құйғанда...
Dialogue: 0,0:12:56.40,0:12:59.48,Default,,0,0,0,,Суықтың жақсы болатынын біліңіз (Гоблин өлтіруші)
Dialogue: 0,0:13:00.02,0:13:02.11,Default,,0,0,0,,Бір нәрсе: мен сиыр сүтін мұздатып көрдім...
Dialogue: 0,0:13:02.23,0:13:03.61,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:13:04.45,0:13:06.32,Default,,0,0,0,,Көрдім, жақсы сөздер естідім.
Dialogue: 0,0:13:07.11,0:13:08.53,Default,,0,0,0,,Балық аулау жақсы, маған біреуін беріңіз.
Dialogue: 0,0:13:08.66,0:13:10.16,Default,,0,0,0,,Әй, әр жолы!
Dialogue: 0,0:13:10.83,0:13:13.04,Default,,0,0,0,,Фуфу (Гоблин өлтіруші) Бұл не?
Dialogue: 0,0:13:13.45,0:13:15.62,Default,,0,0,0,,Жоқ, Гоблин өлтіруші.
Dialogue: 0,0:13:15.75,0:13:19.25,Default,,0,0,0,,Неліктен көп нәрсені білетінімді енді түсіндім.
Dialogue: 0,0:13:22.13,0:13:23.63,Default,,0,0,0,,Біртүрлі екен, солай емес пе?
Dialogue: 0,0:13:24.42,0:13:29.09,Default,,0,0,0,,Ешкім аяқтарының астында гоблин бар деп ойламайды.
Dialogue: 0,0:13:29.93,0:13:30.93,Default,,0,0,0,,О
Dialogue: 0,0:13:31.35,0:13:33.56,Default,,0,0,0,,Әрине, зиян болды...
Dialogue: 0,0:13:33.68,0:13:37.65,Default,,0,0,0,,Менің ойымша, бәрі қорқынышты деп ойлайды...
Dialogue: 0,0:13:39.06,0:13:40.11,Default,,0,0,0,,Мен кішкентай кезімде...
Dialogue: 0,0:13:40.52,0:13:41.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:42.15,0:13:45.28,Default,,0,0,0,,Бір қадам басқанда, жер опырылып түсті...
Dialogue: 0,0:13:45.40,0:13:48.53,Default,,0,0,0,,Шұңқырға түсіп өліп қалам ба деп қорқамын. (Әулие әйел) Иә?
Dialogue: 0,0:13:49.16,0:13:50.57,Default,,0,0,0,,Мен солай ойладым...
Dialogue: 0,0:13:50.70,0:13:53.20,Default,,0,0,0,,Тіпті жүруге де екіленетін кезім болды.
Dialogue: 0,0:13:54.08,0:13:55.79,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:13:55.91,0:13:58.83,Default,,0,0,0,,Бірақ бұған ешкім мән бермейді.
Dialogue: 0,0:14:00.29,0:14:02.00,Default,,0,0,0,,Маған бұл біртүрлі болды.
Dialogue: 0,0:14:03.17,0:14:05.38,Default,,0,0,0,,Тіпті апам екеуі маған күлді...
Dialogue: 0,0:14:05.51,0:14:09.34,Default,,0,0,0,,Қорқынышты болса да жүруден басқа амалым жоқ екенін түсінгеніме көп уақыт кетті.
Dialogue: 0,0:14:10.47,0:14:12.76,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:13.68,0:14:15.47,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:14:16.39,0:14:20.15,Default,,0,0,0,,Бірақ мен әлі де қорқамын
Dialogue: 0,0:14:20.94,0:14:23.94,Default,,0,0,0,,Мен сіздің көмегіңізді бағалаймын.
Dialogue: 0,0:14:24.32,0:14:27.65,Default,,0,0,0,,Бірақ маған сенің көмегің керек емес.
Dialogue: 0,0:14:32.66,0:14:33.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:36.04,0:14:38.87,Default,,0,0,0,,Мен қалағанымды істеймін деп айтпадым ба?
Dialogue: 0,0:14:39.79,0:14:41.08,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:41.42,0:14:42.92,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:14:45.75,0:14:48.13,Default,,0,0,0,,Ол шынымен де дәрменсіз адам.
Dialogue: 0,0:14:51.18,0:14:52.39,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:14:52.55,0:14:55.31,Default,,0,0,0,,Мен мұны естігім келмейді.
Dialogue: 0,0:14:55.81,0:14:56.89,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:14:57.56,0:14:59.81,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:15:00.19,0:15:02.48,Default,,0,0,0,,Мен тіпті қорқынышты нәрселерден қорқамын...
Dialogue: 0,0:15:02.61,0:15:04.77,Default,,0,0,0,,Суық! Ку~
Dialogue: 0,0:15:07.19,0:15:11.57,Default,,0,0,0,,Ммм... Мм... Уф.
Dialogue: 0,0:15:13.99,0:15:15.53,Default,,0,0,0,,Олай болса, барамыз ба?
Dialogue: 0,0:15:15.70,0:15:17.12,Default,,0,0,0,,Гоблин өлтіруші… (найза пайдаланушы) Гоблин өлтіруші
Dialogue: 0,0:15:17.24,0:15:18.20,Default,,0,0,0,,Онда!
Dialogue: 0,0:15:18.37,0:15:21.50,Default,,0,0,0,,Біреуге хат жіберуге тырысыңыз.
Dialogue: 0,0:15:21.62,0:15:23.42,Default,,0,0,0,,Мен қабылдаушыға айтамын!
Dialogue: 0,0:15:23.79,0:15:24.63,Default,,0,0,0,,Не?
Dialogue: 0,0:15:24.75,0:15:26.92,Default,,0,0,0,,Ол баламен ойнап жүрді!
Dialogue: 0,0:15:27.05,0:15:29.26,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:15:29.38,0:15:32.13,Default,,0,0,0,,Мен шақырылдым.
Dialogue: 0,0:15:32.55,0:15:34.80,Default,,0,0,0,,Ах... мм...
Dialogue: 0,0:15:34.93,0:15:36.51,Default,,0,0,0,,Сіз жақсы көрінесіз.
Dialogue: 0,0:15:37.26,0:15:38.81,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:15:39.02,0:15:40.18,Default,,0,0,0,,А... иә!
Dialogue: 0,0:15:40.89,0:15:45.61,Default,,0,0,0,,Менің бір ісім бар, менімен бірге жүр.
Dialogue: 0,0:15:46.69,0:15:49.61,Default,,0,0,0,,Қараңдар (найза пайдаланушы) Уф, иә...
Dialogue: 0,0:15:49.74,0:15:51.45,Default,,0,0,0,,Уф, міне келдің.
Dialogue: 0,0:15:51.90,0:15:53.74,Default,,0,0,0,,Кешіріңіз, мен құтқарылдым.
Dialogue: 0,0:15:53.86,0:15:56.28,Default,,0,0,0,,Өйткені, мен экспедитор емеспін.
Dialogue: 0,0:15:56.41,0:15:58.91,Default,,0,0,0,,Маған мұндай нәрсені алып жүруге рұқсат етпеңіз.
Dialogue: 0,0:15:59.24,0:16:02.54,Default,,0,0,0,,Бірақ неге алаңдау керек?
Dialogue: 0,0:16:02.67,0:16:05.67,Default,,0,0,0,,Оны осы қаладан да алуға болады, солай ма?
Dialogue: 0,0:16:05.79,0:16:07.21,Default,,0,0,0,,Бұл тармақ жарамсыз.
Dialogue: 0,0:16:08.05,0:16:09.96,Default,,0,0,0,,Ол ұсақ түйіршікті болуы керек.
Dialogue: 0,0:16:10.34,0:16:11.17,Default,,0,0,0,,Иә
Dialogue: 0,0:16:11.30,0:16:13.09,Default,,0,0,0,,Ол не үшін қолданылады? Болды
Dialogue: 0,0:16:13.59,0:16:14.93,Default,,0,0,0,,Бұл шешім қабылданған болуы керек.
Dialogue: 0,0:16:15.97,0:16:17.55,Default,,0,0,0,,Гоблиндерді жою
Dialogue: 0,0:16:21.02,0:16:23.14,Default,,0,0,0,,Бүгін де үйге келмедің.
Dialogue: 0,0:16:23.73,0:16:25.27,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:25.81,0:16:27.27,Default,,0,0,0,,Қазір неше күн болды?
Dialogue: 0,0:16:27.77,0:16:30.57,Default,,0,0,0,,Ал, бұл алыс қала деді.
Dialogue: 0,0:16:30.69,0:16:32.99,Default,,0,0,0,,Қандай да бір себеп болуы керек.
Dialogue: 0,0:16:33.11,0:16:34.41,Default,,0,0,0,,Я...
Dialogue: 0,0:16:34.66,0:16:38.95,Default,,0,0,0,,Осылай кезекпен шығып, гоблиндерді үзіліссіз жою.
Dialogue: 0,0:16:39.79,0:16:43.71,Default,,0,0,0,,Қайтып келмейтін уақыт келеді...
Dialogue: 0,0:16:43.83,0:16:45.50,Default,,0,0,0,,Мен қайтамын (Сиыршы қыздың ағасы) А...
Dialogue: 0,0:16:46.25,0:16:48.71,Default,,0,0,0,,Міндетті түрде қайтып келеді
Dialogue: 0,0:16:49.34,0:16:55.09,Default,,0,0,0,,Бұл ол үшін де, мен үшін де маңызды орын.
Dialogue: 0,0:16:55.43,0:16:56.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:56.39,0:17:01.56,Default,,0,0,0,,Сондықтан мен сен қайтып келгенше осында күткім келеді.
Dialogue: 0,0:17:05.14,0:17:08.65,Default,,0,0,0,,Камикиримару толық қаруланған Яну
Dialogue: 0,0:17:08.77,0:17:11.57,Default,,0,0,0,,Сәл салқынырақ болса екен.
Dialogue: 0,0:17:11.69,0:17:13.36,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:13.82,0:17:18.24,Default,,0,0,0,,Дұрыс, Гоблин өлтіруші мырза, сіз дулығаңызға қанаттар қосқыңыз келе ме?
Dialogue: 0,0:17:18.37,0:17:19.37,Default,,0,0,0,,Қызық емес
Dialogue: 0,0:17:19.49,0:17:23.25,Default,,0,0,0,,Оркборг Ойланып қарасаңыз, біз бүгін алауларды қолданып жатқан жоқпыз ба?
Dialogue: 0,0:17:23.37,0:17:26.04,Default,,0,0,0,,Мен бір нәрсені байқап көргім келеді. Өрт - бұл қолайсыздық.
Dialogue: 0,0:17:26.87,0:17:29.08,Default,,0,0,0,,Сонымен, қиындық неде?
Dialogue: 0,0:17:29.50,0:17:30.50,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:32.76,0:17:33.71,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:33.84,0:17:35.88,Default,,0,0,0,,(Үлкен көз алмасы)
Dialogue: 0,0:17:36.43,0:17:39.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:39.18,0:17:43.93,Default,,0,0,0,,Мен білмеймін, бірақ менің ойымша, бұл маңызды сәт.
Dialogue: 0,0:17:45.10,0:17:48.02,Default,,0,0,0,,Сыртынан қарағанда, ол аралас нәсілдің ұрпағы болса керек.
Dialogue: 0,0:17:48.15,0:17:48.98,Default,,0,0,0,,(Үлкен көз алмасы)
Dialogue: 0,0:17:49.94,0:17:55.11,Default,,0,0,0,,Оны атын атама, мынау құбыжықтың түрі ғой, солай емес пе?
Dialogue: 0,0:17:55.24,0:17:58.61,Default,,0,0,0,,Жұмбақ атау кез келген нәрсе болуы мүмкін, тіпті «үлкен көз алмасы»
Dialogue: 0,0:17:59.07,0:18:02.16,Default,,0,0,0,,Сіз мүлдем бейхабарсыз.
Dialogue: 0,0:18:02.28,0:18:06.33,Default,,0,0,0,,Бірақ қылышымды жұтып қойған сол көз алмалары...
Dialogue: 0,0:18:08.42,0:18:11.79,Default,,0,0,0,,(Үлкен көз алмасы шайқас айқайы)
Dialogue: 0,0:18:13.34,0:18:15.71,Default,,0,0,0,,Бұл шынымен де «ыдыраудың» жаман көзі
Dialogue: 0,0:18:16.26,0:18:20.26,Default,,0,0,0,,Бұл жағдайда мен Рюга солдатын шақырдым, бірақ сол алып көз алмасы маған жалт қараған кезде...
Dialogue: 0,0:18:20.39,0:18:23.68,Default,,0,0,0,,Қарғыстан құтылдым, сиқыр жойылды.
Dialogue: 0,0:18:23.81,0:18:26.93,Default,,0,0,0,,Бөлшектеу және ажырату Бұл, әрине, қиын.
Dialogue: 0,0:18:27.06,0:18:29.23,Default,,0,0,0,,Бөлмеге кірмегенше...
Dialogue: 0,0:18:29.35,0:18:32.06,Default,,0,0,0,,Олар маған шабуыл жасап жатқан сияқты емес.
Dialogue: 0,0:18:32.65,0:18:36.82,Default,,0,0,0,,Мүмкін сіз оны көре алмасаңыз, кереметтер болуы мүмкін.
Dialogue: 0,0:18:37.28,0:18:39.20,Default,,0,0,0,,Бірақ жақындасаңыз, көре аласыз.
Dialogue: 0,0:18:39.32,0:18:40.53,Default,,0,0,0,,Сиқырды қолдана алмайды
Dialogue: 0,0:18:40.66,0:18:43.91,Default,,0,0,0,,Жылу сәулесі Бикабика Екінші жағында көп қиындық бар
Dialogue: 0,0:18:44.03,0:18:48.33,Default,,0,0,0,,Мен мұнда қадалған жоқпын, мəңгі осында қалдым.
Dialogue: 0,0:18:48.46,0:18:51.17,Default,,0,0,0,,Жоқ, мен қолданып көргім келетін әдіс бар.
Dialogue: 0,0:18:51.38,0:18:56.13,Default,,0,0,0,,Мен сізге айтамын, от шабуылы, су шабуылы және улы шабуылдың пайдасы жоқ.
Dialogue: 0,0:18:56.26,0:18:57.55,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:18:58.55,0:19:01.59,Default,,0,0,0,,Тек растау үшін, қаладан тыс жерде болған дұрыс па?
Dialogue: 0,0:19:01.72,0:19:03.10,Default,,0,0,0,,Мен біраз жүрдім.
Dialogue: 0,0:19:03.22,0:19:05.31,Default,,0,0,0,,Өзі ұнаса да, ол бір-бірінен өте алыс.
Dialogue: 0,0:19:06.64,0:19:09.10,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:19:09.64,0:19:11.35,Default,,0,0,0,,(Үлкен көз алмасы)
Dialogue: 0,0:19:11.56,0:19:12.94,Default,,0,0,0,,(Үлкен көз алмасының ұрыс айқайы)
Dialogue: 0,0:19:14.98,0:19:16.94,Default,,0,0,0,,Міне! Келді, келді, келді!
Dialogue: 0,0:19:18.90,0:19:20.49,Default,,0,0,0,,(Үлкен көз алмасы)
Dialogue: 0,0:19:23.57,0:19:25.83,Default,,0,0,0,,Іш, ән айт, рух
Dialogue: 0,0:19:25.95,0:19:28.41,Default,,0,0,0,,Ән айт, биле, ұйықта
Dialogue: 0,0:19:28.58,0:19:31.87,Default,,0,0,0,,Маған ішу арманын көрсетіңіз
Dialogue: 0,0:19:32.83,0:19:35.75,Default,,0,0,0,,Маған қадалып қарамасаң, дәл осылай.
Dialogue: 0,0:19:36.17,0:19:37.21,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:42.97,0:19:45.01,Default,,0,0,0,,Оркборг Не?
Dialogue: 0,0:19:45.14,0:19:46.89,Default,,0,0,0,,Бұл ұн, оны жұтпа.
Dialogue: 0,0:19:47.18,0:19:49.39,Default,,0,0,0,,Заклинание тозуға жақын!
Dialogue: 0,0:19:49.73,0:19:50.77,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:19:53.52,0:19:54.27,Default,,0,0,0,,(Ертегі садақшының ауыр тыныс алуы)
Dialogue: 0,0:19:54.77,0:19:56.44,Default,,0,0,0,,Оған жебені ат
Dialogue: 0,0:19:56.57,0:19:57.90,Default,,0,0,0,,Тек болжаңыз.
Dialogue: 0,0:19:58.11,0:20:00.32,Default,,0,0,0,,Дереу кіреберіске қорғаныс қолданыңыз.
Dialogue: 0,0:20:00.44,0:20:03.16,Default,,0,0,0,,Сіз кілтсіз. Егер сәтсіздікке ұшырасаңыз, сіз өлесіз.
Dialogue: 0,0:20:03.28,0:20:04.36,Default,,0,0,0,,Иә
Dialogue: 0,0:20:06.33,0:20:08.24,Default,,0,0,0,,Аса мейірімді Жер-ана құдайы
Dialogue: 0,0:20:08.37,0:20:12.75,Default,,0,0,0,,Бізді жердің күші бар әлсіздерді қорғай гөр!
Dialogue: 0,0:20:15.63,0:20:19.46,Default,,0,0,0,,Опа тығыздалған... Эй, болмайды!
Dialogue: 0,0:20:19.59,0:20:21.76,Default,,0,0,0,,Құлағыңызды жауып, аузыңызды ашыңыз, үйрек!
Dialogue: 0,0:20:22.22,0:20:25.76,Default,,0,0,0,,(Үлкен көз алмасының ыңырануы)
Dialogue: 0,0:20:26.97,0:20:29.26,Default,,0,0,0,,(Үлкен көз алмасының айқайы)
Dialogue: 0,0:20:29.51,0:20:30.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:44.20,0:20:45.66,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:20:47.07,0:20:48.74,Default,,0,0,0,,Мұны істеу қиын
Dialogue: 0,0:20:49.20,0:20:52.41,Default,,0,0,0,,Гоблин өлтіруші, сен не істедің?
Dialogue: 0,0:20:52.87,0:20:55.12,Default,,0,0,0,,Мен канареяның тарихын білгенде...
Dialogue: 0,0:20:55.25,0:20:56.92,Default,,0,0,0,,Көміршіден естіген
Dialogue: 0,0:20:57.04,0:21:01.21,Default,,0,0,0,,Тар кеңістікте ұсақ шаң шашылып, ұшқындар ұшқанда...
Dialogue: 0,0:21:01.34,0:21:03.17,Default,,0,0,0,,Жалын жайылып, жарылып кететін сияқты.
Dialogue: 0,0:21:03.84,0:21:06.97,Default,,0,0,0,,дайындау мен күткеннен қиынырақ.
Dialogue: 0,0:21:07.09,0:21:09.05,Default,,0,0,0,,Сондай-ақ тұтану және жарылыс ықтималдығы жоғары.
Dialogue: 0,0:21:10.18,0:21:12.43,Default,,0,0,0,,Мұны гоблиндерге қарсы қолдануға болмайды.
Dialogue: 0,0:21:12.56,0:21:14.52,Default,,0,0,0,,Дәлірек айтсақ, жарылыс!
Dialogue: 0,0:21:14.64,0:21:18.23,Default,,0,0,0,,Бұл өрт шабуылы, су шабуылы немесе улы ауа емес, солай ма?
Dialogue: 0,0:21:18.36,0:21:23.24,Default,,0,0,0,,Мәселе бұл емес... А, жетеді.
Dialogue: 0,0:21:23.65,0:21:27.91,Default,,0,0,0,,Ол жарылып кетпесе не істер едің?
Dialogue: 0,0:21:28.03,0:21:29.70,Default,,0,0,0,,Садақ пен жебені өткелден ат
Dialogue: 0,0:21:29.83,0:21:31.79,Default,,0,0,0,,Өзіңе келгенше қаш
Dialogue: 0,0:21:31.91,0:21:34.08,Default,,0,0,0,,Мұны өлгенше қайталаңыз
Dialogue: 0,0:21:34.20,0:21:35.54,Default,,0,0,0,,Бұл қиын, бірақ сенімді.
Dialogue: 0,0:21:35.71,0:21:39.00,Default,,0,0,0,,Мен үшін ең қиыны осы емес пе?
Dialogue: 0,0:21:39.13,0:21:42.05,Default,,0,0,0,,Бұл сен үшін өмір мен өлім мәселесі.
Dialogue: 0,0:21:42.17,0:21:45.92,Default,,0,0,0,,Қанша семірмесең, Мәңгі бақи боп қаласың.
Dialogue: 0,0:21:46.05,0:21:48.43,Default,,0,0,0,,Негізі ергежейлілер аздап арықтау керек!
Dialogue: 0,0:21:48.97,0:21:51.89,Default,,0,0,0,,Әй, Бақа, сен ергежейлісің!
Dialogue: 0,0:21:48.97,0:21:51.89,Default,,0,0,0,,Хмм... га...
Dialogue: 0,0:21:52.10,0:21:53.35,Default,,0,0,0,,Иә? Қай жағынан қарасаңыз да...
Dialogue: 0,0:21:52.10,0:21:53.35,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:21:53.47,0:21:55.48,Default,,0,0,0,,Толқын немесе толық емес! (Шахтер) А!?
Dialogue: 0,0:21:56.02,0:22:00.65,Default,,0,0,0,,Енді мені қызықтыратыны мынау.
Dialogue: 0,0:22:06.40,0:22:11.41,Default,,0,0,0,,♪~
Dialogue: 0,0:23:30.90,0:23:35.91,Default,,0,0,0,,~♪
Dialogue: 0,0:23:37.41,0:23:43.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory