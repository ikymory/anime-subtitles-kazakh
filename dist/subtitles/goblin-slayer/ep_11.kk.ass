Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.58,0:00:06.58,Default,,0,0,0,,♪~
Dialogue: 0,0:01:25.75,0:01:30.92,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.50,0:01:36.63,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:01:37.30,0:01:41.14,Default,,0,0,0,,(Сиыр қыздың гуілдеуі)
Dialogue: 0,0:01:44.56,0:01:47.73,Default,,0,0,0,,Иә, қайырлы таң!
Dialogue: 0,0:01:48.31,0:01:51.40,Default,,0,0,0,,Күте тұрыңыз, мен қазір таңғы ас дайындаймын.
Dialogue: 0,0:01:51.52,0:01:52.36,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:01:53.07,0:01:54.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:54.65,0:01:56.24,Default,,0,0,0,,...Неге?
Dialogue: 0,0:01:56.74,0:01:59.74,Default,,0,0,0,,Не болды? Кенеттен
Dialogue: 0,0:01:59.86,0:02:01.70,Default,,0,0,0,,Аяқ іздері болды
Dialogue: 0,0:02:07.75,0:02:09.04,Default,,0,0,0,,Бұл гоблин.
Dialogue: 0,0:02:09.17,0:02:13.17,Default,,0,0,0,,Бірақ сіз оны жеңе алмайсыз ба? Егер ол сен болсаң
Dialogue: 0,0:02:13.63,0:02:14.84,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:02:15.88,0:02:17.30,Default,,0,0,0,,Ха...
Dialogue: 0,0:02:17.88,0:02:19.76,Default,,0,0,0,,100 болса да...
Dialogue: 0,0:02:19.88,0:02:23.05,Default,,0,0,0,,Үңгірдің ішінде болса, мен жеңемін
Dialogue: 0,0:02:23.72,0:02:26.47,Default,,0,0,0,,Еш нәрсеге қарамастан жеңіңіз
Dialogue: 0,0:02:27.52,0:02:28.69,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:02:30.52,0:02:33.31,Default,,0,0,0,,10 аяқ ізі болды.
Dialogue: 0,0:02:34.02,0:02:36.61,Default,,0,0,0,,Табында көсем бар екені анық.
Dialogue: 0,0:02:39.49,0:02:41.95,Default,,0,0,0,,Хоб бақсы…
Dialogue: 0,0:02:42.24,0:02:46.70,Default,,0,0,0,,Жоқ, таразыға қарағанда, бұл...
Dialogue: 0,0:02:50.00,0:02:52.17,Default,,0,0,0,,Жау – Гоблин патшасы.
Dialogue: 0,0:02:53.29,0:02:54.75,Default,,0,0,0,,Гоблин Лорд
Dialogue: 0,0:02:57.80,0:03:00.22,Default,,0,0,0,,Шабуыл бүгін немесе ертең түнде болады.
Dialogue: 0,0:03:00.34,0:03:03.39,Default,,0,0,0,,Мырзалар мен елдерден көмек сұрауға уақыт жоқ.
Dialogue: 0,0:03:03.51,0:03:07.02,Default,,0,0,0,,Мұнда бірден 100-ден астам топ шабуыл жасайды.
Dialogue: 0,0:03:07.14,0:03:09.23,Default,,0,0,0,,Гоблиндер тобы?
Dialogue: 0,0:03:11.60,0:03:15.48,Default,,0,0,0,,Неліктен бұл жерде ...
Dialogue: 0,0:03:16.57,0:03:19.11,Default,,0,0,0,,Мүмкін осында негізделген...
Dialogue: 0,0:03:19.24,0:03:21.45,Default,,0,0,0,,Олар қалаға шабуыл жасайтын шығар.
Dialogue: 0,0:03:22.91,0:03:24.95,Default,,0,0,0,,Мен платина емеспін.
Dialogue: 0,0:03:25.45,0:03:27.58,Default,,0,0,0,,Батыр... жоқ
Dialogue: 0,0:03:28.24,0:03:32.87,Default,,0,0,0,,Жазық далада 100-ден астам құбыжықпен бетпе-бет келу...
Dialogue: 0,0:03:33.00,0:03:34.71,Default,,0,0,0,,Қолдар жеткіліксіз
Dialogue: 0,0:03:35.59,0:03:37.17,Default,,0,0,0,,Қуат жоқ
Dialogue: 0,0:03:38.30,0:03:41.05,Default,,0,0,0,,Мен алмаймын...
Dialogue: 0,0:03:43.55,0:03:45.51,Default,,0,0,0,,Ендеше қашасың ба?
Dialogue: 0,0:03:45.60,0:03:46.51,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:46.97,0:03:49.93,Default,,0,0,0,,Сіз мұны қазір жасай аламын деп ойлайсыз ба?
Dialogue: 0,0:03:50.02,0:03:50.89,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:59.69,0:04:00.74,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:01.61,0:04:03.57,Default,,0,0,0,,Сіз шештіңіз бе? (Сиыр қыз) Иә.
Dialogue: 0,0:04:04.20,0:04:06.49,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:04:06.78,0:04:09.29,Default,,0,0,0,,Кешіріңіз, мен қашпаймын.
Dialogue: 0,0:04:10.04,0:04:13.37,Default,,0,0,0,,Өйткені сен қалғысы келетін адамсың.
Dialogue: 0,0:04:15.42,0:04:18.46,Default,,0,0,0,,Қараңызшы, мен оны білдім! Қиналғанда аузыңды жапасың
Dialogue: 0,0:04:18.54,0:04:20.05,Default,,0,0,0,,Ежелгі заманнан бері
Dialogue: 0,0:04:22.42,0:04:23.26,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:26.22,0:04:28.18,Default,,0,0,0,,Тек өлу жеткіліксіз
Dialogue: 0,0:04:28.30,0:04:30.85,Default,,0,0,0,,Иә, менің ойымша.
Dialogue: 0,0:04:31.68,0:04:33.60,Default,,0,0,0,,Мен қарап отырдым
Dialogue: 0,0:04:33.73,0:04:34.73,Default,,0,0,0,,Иә
Dialogue: 0,0:04:35.40,0:04:37.36,Default,,0,0,0,,Бұл көмектеседі деп ойлаймын.
Dialogue: 0,0:04:37.73,0:04:39.19,Default,,0,0,0,,Тіпті аман қалуыңыз мүмкін болса да
Dialogue: 0,0:04:39.65,0:04:41.03,Default,,0,0,0,,Менің жүрегім өледі
Dialogue: 0,0:04:43.49,0:04:44.49,Default,,0,0,0,,Ендеше қаш.
Dialogue: 0,0:04:44.61,0:04:47.07,Default,,0,0,0,,Сондықтан!
Dialogue: 0,0:04:48.74,0:04:50.08,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:04:51.62,0:04:53.37,Default,,0,0,0,,Екінші рет жоқ
Dialogue: 0,0:04:55.42,0:04:59.92,Default,,0,0,0,,Қайта оралуға болатын жер қайтадан жоғалады.
Dialogue: 0,0:05:00.21,0:05:02.80,Default,,0,0,0,,Және...көрдіңіз бе?
Dialogue: 0,0:05:03.21,0:05:09.18,Default,,0,0,0,,Көшірсең де, малың, сиырың, қойың жоғалады...
Dialogue: 0,0:05:09.68,0:05:13.39,Default,,0,0,0,,Қараңдаршы, одан кейін не болады...
Dialogue: 0,0:05:14.31,0:05:15.52,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:15.89,0:05:18.73,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:05:18.81,0:05:23.61,Default,,0,0,0,,Мен өзімшіл екенімді де білемін.
Dialogue: 0,0:05:26.95,0:05:28.66,Default,,0,0,0,,Бұл бетті жасама
Dialogue: 0,0:05:34.50,0:05:37.42,Default,,0,0,0,,Қолыңнан келгенін істе
Dialogue: 0,0:05:37.62,0:05:38.46,Default,,0,0,0,,Иә
Dialogue: 0,0:05:39.08,0:05:41.21,Default,,0,0,0,,(Сиыршы қыздың айқайы)
Dialogue: 0,0:05:41.34,0:05:42.46,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:05:46.92,0:05:51.51,Default,,0,0,0,,«Қыздарды қорғау керек»?
Dialogue: 0,0:05:51.64,0:05:52.81,Default,,0,0,0,,Эй
Dialogue: 0,0:05:53.85,0:05:55.85,Default,,0,0,0,,Жай ғана сәлем айтыңыз
Dialogue: 0,0:05:56.48,0:05:58.85,Default,,0,0,0,,Кешіріңіз, бұл...
Dialogue: 0,0:05:58.98,0:06:01.06,Default,,0,0,0,,Бұл бала жақсы бала.
Dialogue: 0,0:06:03.78,0:06:06.94,Default,,0,0,0,,Сен мені жақсы бала етіп өсірдің.
Dialogue: 0,0:06:07.03,0:06:09.82,Default,,0,0,0,,Сондықтан мені жылатпа
Dialogue: 0,0:06:10.07,0:06:12.83,Default,,0,0,0,,Мен күш саламын...
Dialogue: 0,0:06:19.33,0:06:22.00,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:06:25.21,0:06:26.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:27.80,0:06:28.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:29.51,0:06:30.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:32.39,0:06:34.35,Default,,0,0,0,,Гоблин өлтіруші
Dialogue: 0,0:06:35.60,0:06:37.52,Default,,0,0,0,,Сіз қалай аман қалдыңыз?
Dialogue: 0,0:06:38.27,0:06:39.23,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:06:41.31,0:06:43.44,Default,,0,0,0,,Кешіріңіз, мені тыңдаңыз.
Dialogue: 0,0:06:44.77,0:06:45.69,Default,,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:06:46.07,0:06:47.78,Default,,0,0,0,,Гоблин өлтірушінің өтініші?
Dialogue: 0,0:06:47.90,0:06:49.65,Default,,0,0,0,,Ол жалғыз емес пе еді?
Dialogue: 0,0:06:49.74,0:06:52.99,Default,,0,0,0,,Жоқ, ол соңғы уақытта бірнеше адаммен жұмыс істеген сияқты.
Dialogue: 0,0:06:53.12,0:06:54.03,Default,,0,0,0,,Хоо?
Dialogue: 0,0:06:54.58,0:06:56.24,Default,,0,0,0,,Гоблиндер ордасы келе жатыр.
Dialogue: 0,0:06:56.37,0:06:58.45,Default,,0,0,0,,Қала сыртындағы ранчода.
Dialogue: 0,0:06:58.96,0:07:01.83,Default,,0,0,0,,Бүгін түнде шығар, нөмірін білмеймін.
Dialogue: 0,0:07:02.38,0:07:04.42,Default,,0,0,0,,Не, бұл гоблин ғой?
Dialogue: 0,0:07:04.54,0:07:06.59,Default,,0,0,0,,Гоблиндердің үйірленуі қалыпты жағдай.
Dialogue: 0,0:07:06.71,0:07:08.88,Default,,0,0,0,,Барлаушылардың іздерінің санына қарай...
Dialogue: 0,0:07:09.01,0:07:10.80,Default,,0,0,0,,Лорд болуы керек.
Dialogue: 0,0:07:10.93,0:07:13.05,Default,,0,0,0,,Сонымен, 100 балық - бұл сұмдық.
Dialogue: 0,0:07:13.14,0:07:14.72,Default,,0,0,0,,Ха! (Авантюрист) 100!?
Dialogue: 0,0:07:14.80,0:07:15.93,Default,,0,0,0,,100 гоблин? (Авантюрист) Мырза?
Dialogue: 0,0:07:16.06,0:07:17.10,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:07:17.18,0:07:18.31,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:07:18.43,0:07:21.23,Default,,0,0,0,,Бұл не? (Шытырманшы) Эй, сен не айтып тұрсың?
Dialogue: 0,0:07:22.02,0:07:24.19,Default,,0,0,0,,Жол дегеніміз не? (Әулие шәкірт) Жүріңіз...
Dialogue: 0,0:07:24.27,0:07:27.53,Default,,0,0,0,,Лорд – көшбасшылыққа маманданған нұсқа.
Dialogue: 0,0:07:27.65,0:07:29.86,Default,,0,0,0,,Гоблиндердің ең жоғары класы деп айтуға болады.
Dialogue: 0,0:07:29.99,0:07:31.57,Default,,0,0,0,,Үздік?
Dialogue: 0,0:07:31.70,0:07:32.91,Default,,0,0,0,,Сол адамды басқаратын топ...
Dialogue: 0,0:07:33.36,0:07:35.58,Default,,0,0,0,,Жақында келеді уақытым жоқ
Dialogue: 0,0:07:36.16,0:07:37.91,Default,,0,0,0,,Үңгірде бәрібір...
Dialogue: 0,0:07:38.04,0:07:40.12,Default,,0,0,0,,Далалық шайқастарға келгенде, мен өзіме жетпеймін.
Dialogue: 0,0:07:43.17,0:07:45.71,Default,,0,0,0,,Маған көмектесулеріңізді қалаймын.
Dialogue: 0,0:07:50.38,0:07:52.55,Default,,0,0,0,,Не істеу керек? (Авантюрист) Мен не істерімді білмеймін...
Dialogue: 0,0:07:52.63,0:07:53.97,Default,,0,0,0,,Гоблин
Dialogue: 0,0:07:54.09,0:07:55.55,Default,,0,0,0,,Неліктен мұны өзіңіз жасамасқа?
Dialogue: 0,0:07:56.10,0:07:57.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:57.64,0:08:00.35,Default,,0,0,0,,Ол жігіттер маған да кір.
Dialogue: 0,0:08:00.48,0:08:01.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:02.60,0:08:03.64,Default,,0,0,0,,Эй
Dialogue: 0,0:08:05.73,0:08:08.36,Default,,0,0,0,,Сіз бір нәрсені дұрыс түсінбедіңіз бе?
Dialogue: 0,0:08:09.28,0:08:13.03,Default,,0,0,0,,Бұл авантюристер гильдиясы, ал біз авантюристерміз, солай ма?
Dialogue: 0,0:08:14.20,0:08:16.12,Default,,0,0,0,,Менен жақсылық сұрауға ешқандай себеп жоқ.
Dialogue: 0,0:08:16.66,0:08:17.87,Default,,0,0,0,,Сұраныс жіберу
Dialogue: 0,0:08:17.99,0:08:19.54,Default,,0,0,0,,Басқаша айтқанда, «сыйақы»
Dialogue: 0,0:08:19.62,0:08:20.45,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:20.79,0:08:23.33,Default,,0,0,0,,Woohoo (Шытырманшылардың шуы)
Dialogue: 0,0:08:23.83,0:08:26.58,Default,,0,0,0,,Ха... Эй! Бұл не!
Dialogue: 0,0:08:26.71,0:08:27.92,Default,,0,0,0,,Ұзын құлақ
Dialogue: 0,0:08:28.04,0:08:30.38,Default,,0,0,0,,Қазір кетсеңіз, жағдай күрделене түседі.
Dialogue: 0,0:08:30.51,0:08:32.26,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:08:32.38,0:08:33.42,Default,,0,0,0,,Әзірше күтіңіз.
Dialogue: 0,0:08:33.55,0:08:35.47,Default,,0,0,0,,Эй... жібер!
Dialogue: 0,0:08:35.59,0:08:36.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:37.18,0:08:39.39,Default,,0,0,0,,А, бұл дұрыс пікір.
Dialogue: 0,0:08:39.51,0:08:41.47,Default,,0,0,0,,О, онда айт!
Dialogue: 0,0:08:41.60,0:08:44.60,Default,,0,0,0,,Маған 100 гоблинмен күрескенім үшін «сыйлық» беріңіз!
Dialogue: 0,0:08:45.19,0:08:46.94,Default,,0,0,0,,Барлығы (Спирмен) А?
Dialogue: 0,0:08:47.27,0:08:48.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:48.81,0:08:52.15,Default,,0,0,0,,Менде бар нәрсенің бәрі сыйлық
Dialogue: 0,0:08:52.28,0:08:53.49,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:53.61,0:08:57.37,Default,,0,0,0,,Менің заттарым өз қалауым бойынша тегін.
Dialogue: 0,0:08:57.49,0:09:02.04,Default,,0,0,0,,Менің жабдықтарым, активтерім, қабілеттерім, уақытым және...
Dialogue: 0,0:09:02.29,0:09:03.12,Default,,0,0,0,,Өмір?
Dialogue: 0,0:09:03.75,0:09:06.58,Default,,0,0,0,,Иә, өмір де.
Dialogue: 0,0:09:06.67,0:09:09.17,Default,,0,0,0,,Сонда мен өлсем ше?
Dialogue: 0,0:09:09.38,0:09:11.13,Default,,0,0,0,,Жоқ, бұл мүмкін емес.
Dialogue: 0,0:09:11.25,0:09:11.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:12.55,0:09:16.30,Default,,0,0,0,,Мен өлгенде жылайтын адамдар бар.
Dialogue: 0,0:09:16.76,0:09:18.72,Default,,0,0,0,,Сені жылатпа деді.
Dialogue: 0,0:09:19.51,0:09:24.23,Default,,0,0,0,,Сондықтан менің өмірім менің бақылауымнан тыс сияқты.
Dialogue: 0,0:09:24.35,0:09:25.18,Default,,0,0,0,,Я...
Dialogue: 0,0:09:25.94,0:09:29.27,Default,,0,0,0,,Мен сенің не ойлап тұрғаныңды білмеймін...
Dialogue: 0,0:09:29.81,0:09:32.40,Default,,0,0,0,,Мен сізді байсалды деп айта аламын.
Dialogue: 0,0:09:32.53,0:09:34.69,Default,,0,0,0,,О, мен байсалдымын.
Dialogue: 0,0:09:36.99,0:09:39.62,Default,,0,0,0,,Дочикушюме (тілді басу)
Dialogue: 0,0:09:42.58,0:09:45.71,Default,,0,0,0,,Өз өміріңді ойлайсың ба, бейбақ?
Dialogue: 0,0:09:45.91,0:09:47.46,Default,,0,0,0,,Маған кейін сусын сатып ал!
Dialogue: 0,0:09:49.04,0:09:50.96,Default,,0,0,0,,Не! Нарықтық баға болса да!
Dialogue: 0,0:09:51.50,0:09:52.75,Default,,0,0,0,,Күміс дәрежелі авантюрист...
Dialogue: 0,0:09:52.88,0:09:55.01,Default,,0,0,0,,Ол гоблиндерді құртамын дейді.
Dialogue: 0,0:09:55.13,0:09:56.92,Default,,0,0,0,,Қуаныңыз, клиент!
Dialogue: 0,0:09:57.68,0:09:58.63,Default,,0,0,0,,О
Dialogue: 0,0:09:59.22,0:10:00.43,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:10:01.72,0:10:03.85,Default,,0,0,0,,Рахмет (найза қолданушысы) Сау болыңыз
Dialogue: 0,0:10:03.97,0:10:06.39,Default,,0,0,0,,Осы жолды жеңгеннен кейін айтыңыз!
Dialogue: 0,0:10:06.52,0:10:08.19,Default,,0,0,0,,Мен де! (Барлығы) О!
Dialogue: 0,0:10:08.31,0:10:10.23,Default,,0,0,0,,Мен де гоблиндерді өлтіремін!
Dialogue: 0,0:10:10.69,0:10:12.86,Default,,0,0,0,,Оның орнына менімен бірге қайта кел!
Dialogue: 0,0:10:13.98,0:10:17.24,Default,,0,0,0,,Бұл жолы мен сізге нағыз шытырман оқиғаға жол беремін!
Dialogue: 0,0:10:18.45,0:10:19.57,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:10:19.70,0:10:22.78,Default,,0,0,0,,Мен бір кесе айтпаймын, Камикиримару.
Dialogue: 0,0:10:23.41,0:10:25.20,Default,,0,0,0,,Маған бөшкені беріңіз
Dialogue: 0,0:10:25.29,0:10:26.83,Default,,0,0,0,,Жарайды, реттейік.
Dialogue: 0,0:10:26.91,0:10:30.12,Default,,0,0,0,,Сіздің шытырман оқиғаңызға еріп баруға бола ма?
Dialogue: 0,0:10:30.25,0:10:31.08,Default,,0,0,0,,Ұзын құлақ
Dialogue: 0,0:10:31.58,0:10:33.34,Default,,0,0,0,,Әрине! Сіз дос емессіз бе?
Dialogue: 0,0:10:34.05,0:10:37.47,Default,,0,0,0,,Егер солай болса, менің монахымның барудан басқа амалы жоқ.
Dialogue: 0,0:10:37.55,0:10:40.30,Default,,0,0,0,,Маған бәрібір, бұл достың өтініші.
Егер
Dialogue: 0,0:10:40.43,0:10:43.26,Default,,0,0,0,,марапат болса...
Dialogue: 0,0:10:43.39,0:10:44.26,Default,,0,0,0,,Сыр?
Dialogue: 0,0:10:44.39,0:10:46.85,Default,,0,0,0,,Хмм, мүмкін болса...
Dialogue: 0,0:10:46.97,0:10:48.02,Default,,0,0,0,,Балмұздақ?
Dialogue: 0,0:10:48.14,0:10:52.69,Default,,0,0,0,,Охохо, иә, бұл өте дәмді.
Dialogue: 0,0:10:52.81,0:10:54.36,Default,,0,0,0,,Менікі емес
Dialogue: 0,0:10:54.48,0:10:57.28,Default,,0,0,0,,екеуі де фермада жасалған.
Dialogue: 0,0:10:57.90,0:11:00.53,Default,,0,0,0,,Сосын жер түбінен жорғалап шыққан жындар
Dialogue: 0,0:11:00.66,0:11:03.16,Default,,0,0,0,,Мені кешіруге ешқандай себеп жоқ. Ха!
Dialogue: 0,0:11:03.82,0:11:05.70,Default,,0,0,0,,Бұл 5 адам?
Dialogue: 0,0:11:05.83,0:11:08.16,Default,,0,0,0,,№6 адам (найза қолданушы) А?
Dialogue: 0,0:11:09.79,0:11:11.58,Default,,0,0,0,,Инфрамара
Dialogue: 0,0:11:11.71,0:11:15.84,Default,,0,0,0,,Мүмкін жетінші адам шығар.
Dialogue: 0,0:11:15.96,0:11:17.84,Default,,0,0,0,,Сәлем... бәріңе! (Барлығы) О?
Dialogue: 0,0:11:17.92,0:11:21.34,Default,,0,0,0,,Gi… Тіпті гильдиядан! Гильдиядан да өтінішіміз бар!
Dialogue: 0,0:11:21.76,0:11:25.35,Default,,0,0,0,,Біз әр гоблинге 1 алтын тиын сыйақы береміз!
Dialogue: 0,0:11:25.47,0:11:27.22,Default,,0,0,0,,Бұл сіздің мүмкіндігіңіз!
Dialogue: 0,0:11:27.35,0:11:30.27,Default,,0,0,0,,Сіз байсалдысыз ба!? (Авантюрист) 1 гоблинге 1 алтын тиын!?
Dialogue: 0,0:11:31.44,0:11:32.94,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,0:11:33.06,0:11:35.23,Default,,0,0,0,,Күміс дәрежелі авантюрист ақпараты.
Dialogue: 0,0:11:35.82,0:11:38.28,Default,,0,0,0,,Мәселе жоқ және...
Dialogue: 0,0:11:38.65,0:11:41.86,Default,,0,0,0,,Маған бұлай ынта-ықыласпен жақындамауы керек еді.
Dialogue: 0,0:11:43.16,0:11:46.16,Default,,0,0,0,,Цк. (Әйел рыцарь) Сіз барасыз ба?
Dialogue: 0,0:11:46.58,0:11:48.08,Default,,0,0,0,,Мен Гоблин өлтірушімін.
Dialogue: 0,0:11:48.20,0:11:51.46,Default,,0,0,0,,Маған ұнамайды, бірақ... Айлық алатын болсам ғой.
Dialogue: 0,0:11:51.58,0:11:53.87,Default,,0,0,0,,Сіз шыншыл емессіз.
Dialogue: 0,0:11:54.33,0:11:55.38,Default,,0,0,0,,Айтсам ба?
Dialogue: 0,0:11:56.34,0:11:59.92,Default,,0,0,0,,Өйткені ол сенің ауылыңда пайда болған гоблиндерді жойған.
Dialogue: 0,0:12:00.21,0:12:02.88,Default,,0,0,0,,Жоқ! Қандай тітіркендіргіш! Жарайды
Dialogue: 0,0:12:03.01,0:12:05.72,Default,,0,0,0,,Импульсті өлтіріп, бір алтын тиын алыңыз!
Dialogue: 0,0:12:05.85,0:12:07.93,Default,,0,0,0,,Менің де қасиетті рыцарь болғым келеді.
Dialogue: 0,0:12:08.01,0:12:10.60,Default,,0,0,0,,Көмек сұрасаң, өкінбейсің.
Dialogue: 0,0:12:10.73,0:12:11.73,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:12:11.85,0:12:14.23,Default,,0,0,0,,Ағам мен әпкем барса, біз де барамыз ба?
Dialogue: 0,0:12:14.40,0:12:15.48,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:15.60,0:12:16.94,Default,,0,0,0,,Менің басқа амалым жоқ
Dialogue: 0,0:12:17.98,0:12:20.03,Default,,0,0,0,,Эй (Әулие шәкірт) Не?
Dialogue: 0,0:12:20.15,0:12:23.45,Default,,0,0,0,,Мен гоблиндерді әлі жойған жоқпын.
Dialogue: 0,0:12:23.57,0:12:25.20,Default,,0,0,0,,Мен қауіпті деп естідім.
Dialogue: 0,0:12:25.28,0:12:28.33,Default,,0,0,0,,Бірақ мен бұл туралы ойланатын кез келді.
Dialogue: 0,0:12:28.45,0:12:30.66,Default,,0,0,0,,Иә, олар маған көмектесті.
Dialogue: 0,0:12:30.75,0:12:34.08,Default,,0,0,0,,Себебі мен сол жігітпен бір күнде шытырманшы болдым.
Dialogue: 0,0:12:34.21,0:12:35.62,Default,,0,0,0,,Бұл да байланыс па?
Dialogue: 0,0:12:35.75,0:12:38.29,Default,,0,0,0,,Мені күнде гоблин дейтін ешкім болмаса...
Dialogue: 0,0:12:38.42,0:12:39.25,Default,,0,0,0,,Мен өзімді біртүрлі сезінемін.
Dialogue: 0,0:12:39.38,0:12:41.38,Default,,0,0,0,,Иә, гильдия мамандығы?
Dialogue: 0,0:12:41.46,0:12:43.17,Default,,0,0,0,,Декорация? Бұл солай.
Dialogue: 0,0:12:43.30,0:12:44.51,Default,,0,0,0,,Бұл тітіркендіргіш, бірақ...
Dialogue: 0,0:12:44.63,0:12:45.63,Default,,0,0,0,,Онда болма... Эй?
Dialogue: 0,0:12:46.01,0:12:50.10,Default,,0,0,0,,Мен бұрын-соңды мұндай қитұрқы клиентті кездестірген емеспін.
Dialogue: 0,0:12:50.18,0:12:51.68,Default,,0,0,0,,Уау
Dialogue: 0,0:12:52.31,0:12:55.06,Default,,0,0,0,,Біз жолдас немесе дос емеспіз.
Dialogue: 0,0:12:55.64,0:12:57.52,Default,,0,0,0,,Себебі мен авантюристпін!
Dialogue: 0,0:12:57.81,0:13:01.28,Default,,0,0,0,,Оны шытырман оқиғаға қалдырыңыз!
Dialogue: 0,0:13:01.40,0:13:05.74,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:05.86,0:13:06.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:09.41,0:13:10.79,Default,,0,0,0,,Аня нәжіске батты.
Dialogue: 0,0:13:11.08,0:13:11.91,Default,,0,0,0,,О
Dialogue: 0,0:13:12.04,0:13:14.25,Default,,0,0,0,,Әрине, мен саған еремін.
Dialogue: 0,0:13:14.96,0:13:15.92,Default,,0,0,0,,О
Dialogue: 0,0:13:27.26,0:13:29.68,Default,,0,0,0,,(Гоблин айқайы)
Dialogue: 0,0:13:37.23,0:13:39.61,Default,,0,0,0,,(Гоблиннің сөйлейтін дауысы)
Dialogue: 0,0:13:39.73,0:13:41.94,Default,,0,0,0,,(Гоблин Лордтың арылдауы)
Dialogue: 0,0:13:44.28,0:13:50.16,Default,,0,0,0,,(Гоблин шуы)
Dialogue: 0,0:13:52.87,0:13:56.46,Default,,0,0,0,,(шу)
Dialogue: 0,0:13:56.54,0:13:58.17,Default,,0,0,0,,(Гоблин лордтарының шайқас айқайы)
Dialogue: 0,0:13:58.29,0:14:01.04,Default,,0,0,0,,(Гоблин шайқасы айқайы)
Dialogue: 0,0:14:01.34,0:14:03.17,Default,,0,0,0,,(Гоблин лордтарының шайқас айқайы)
Dialogue: 0,0:14:05.71,0:14:08.09,Default,,0,0,0,,(Гоблин Лордтың арылдауы)
Dialogue: 0,0:14:08.59,0:14:10.55,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:14:13.76,0:14:18.52,Default,,0,0,0,,(канар айқайы)
Dialogue: 0,0:14:18.64,0:14:20.48,Default,,0,0,0,,Жарайды (Сиыршы қыз) Ха!
Dialogue: 0,0:14:22.82,0:14:24.23,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:24.36,0:14:24.82,Default,,0,0,0,,(Гоблин айқайы)
Dialogue: 0,0:14:24.82,0:14:26.53,Default,,0,0,0,,(Гоблин айқайы)
Dialogue: 0,0:14:24.82,0:14:26.53,Default,,0,0,0,,Хмм... Сәлем! (Авантюрист)
Dialogue: 0,0:14:26.53,0:14:29.36,Default,,0,0,0,,(Гоблин айқайы)
Dialogue: 0,0:14:30.57,0:14:32.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:38.66,0:14:40.96,Default,,0,0,0,,Келді ме? (Авантюрист) Хмм...
Dialogue: 0,0:14:43.63,0:14:44.46,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:47.88,0:14:51.43,Default,,0,0,0,,(Гоблин күлкі)
Dialogue: 0,0:15:01.48,0:15:06.48,Default,,0,0,0,,(Гоблин Моан)
Dialogue: 0,0:15:13.95,0:15:14.87,Default,,0,0,0,,Мас
Dialogue: 0,0:15:15.33,0:15:16.49,Default,,0,0,0,,Ұйқы
Dialogue: 0,0:15:16.58,0:15:19.87,Default,,0,0,0,,Ұйқы, ұйықта, гоблиндер
Dialogue: 0,0:15:20.00,0:15:21.96,Default,,0,0,0,,Қазір! (Авантюристер) Ух...
Dialogue: 0,0:15:22.54,0:15:24.84,Default,,0,0,0,,Гоблиндер туралы алаңдамаңыз!
Dialogue: 0,0:15:25.29,0:15:26.59,Default,,0,0,0,,Қалқанды жинаңыз!
Dialogue: 0,0:15:26.71,0:15:28.13,Default,,0,0,0,,(Гоблин шуы)
Dialogue: 0,0:15:28.21,0:15:30.59,Default,,0,0,0,,Асығыңыз! Жабу, жақын!
Dialogue: 0,0:15:34.14,0:15:37.26,Default,,0,0,0,,Дәл... бұл қалқан.
Dialogue: 0,0:15:37.72,0:15:39.64,Default,,0,0,0,,Мен жаман дәмді қаламаймын.
Dialogue: 0,0:15:40.56,0:15:42.35,Default,,0,0,0,,(Гоблин Моан)
Dialogue: 0,0:15:42.44,0:15:44.19,Default,,0,0,0,,Бұл соңғы қалқан!
Dialogue: 0,0:15:44.31,0:15:46.52,Default,,0,0,0,,Сиқыршы көргеннің бәрін жойып жіберді!
Dialogue: 0,0:15:46.65,0:15:47.44,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:55.07,0:15:56.37,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:15:56.99,0:15:58.83,Default,,0,0,0,,Ақша табудың уақыты келді!
Dialogue: 0,0:15:59.45,0:16:02.21,Default,,0,0,0,,Қаттөбе! (Авантюристер) Уау!
Dialogue: 0,0:16:03.29,0:16:04.46,Default,,0,0,0,,(Ауыр жауынгердің айқайы)
Dialogue: 0,0:16:05.75,0:16:07.21,Default,,0,0,0,,Сәлем! (Шытырманшы) Әй!
Dialogue: 0,0:16:10.30,0:16:14.47,Default,,0,0,0,,Хаха! Алтын тиындар арғы жақтан келеді!
Dialogue: 0,0:16:14.76,0:16:17.22,Default,,0,0,0,,Таку Осыншама көп болса...
Dialogue: 0,0:16:20.35,0:16:21.98,Default,,0,0,0,,Мен одан ауырдым
Dialogue: 0,0:16:24.23,0:16:27.61,Default,,0,0,0,,Гоблин өлтіруші де сәтсіздікке ұшырады.
Dialogue: 0,0:16:29.23,0:16:31.61,Default,,0,0,0,,Әрине.
Dialogue: 0,0:16:31.90,0:16:34.32,Default,,0,0,0,,Жоқ, жоқ, сен қорқыныштысың.
Dialogue: 0,0:16:38.33,0:16:40.12,Default,,0,0,0,,Gui? Жақсы!
Dialogue: 0,0:16:43.33,0:16:46.13,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:16:46.25,0:16:50.17,Default,,0,0,0,,Дефлекторлы ракетадан шықпаңыз.
Dialogue: 0,0:16:52.55,0:16:54.93,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:55.05,0:16:56.30,Default,,0,0,0,,(жекпе-жек дауысы)
Dialogue: 0,0:16:56.43,0:16:58.01,Default,,0,0,0,,Оны итеріңіз!
Dialogue: 0,0:16:59.01,0:17:01.68,Default,,0,0,0,,Мен де сонда баруым керек еді.
Dialogue: 0,0:17:01.81,0:17:03.56,Default,,0,0,0,,Жоқ, бұл! (Бала барлаушы) Иә?
Dialogue: 0,0:17:08.06,0:17:10.61,Default,,0,0,0,,Бұл Шабандоз, ол шынымен де келді!
Dialogue: 0,0:17:11.90,0:17:13.78,Default,,0,0,0,,Мен олардың ізі, тырнақ іздері немесе нәжістерін көріп тұрған жоқпын.
Dialogue: 0,0:17:13.90,0:17:16.99,Default,,0,0,0,,Атты әскер! Атты әскер келді! (Авантюрист) Атты әскер!
Dialogue: 0,0:17:17.11,0:17:18.70,Default,,0,0,0,,(Гоблин Моан)
Dialogue: 0,0:17:18.82,0:17:20.87,Default,,0,0,0,,Жарайды, белгіленген орынға жүгір!
Dialogue: 0,0:17:21.29,0:17:22.95,Default,,0,0,0,,Дайын болған кезде, сапқа тұр!
Dialogue: 0,0:17:23.08,0:17:26.54,Default,,0,0,0,,Артқы қатар алдыңғы қатардың арасында тұрып, олардың қылыштарын арғы жақтан арақашықтықта тартады!
Dialogue: 0,0:17:26.92,0:17:30.88,Default,,0,0,0,,Жылқыдан төмен және кішірек Оны шегіне дейін тарт!
Dialogue: 0,0:17:32.38,0:17:33.21,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:17:34.51,0:17:35.51,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:17:38.01,0:17:40.05,Default,,0,0,0,,Қазір! Дайын бол!
Dialogue: 0,0:17:40.14,0:17:44.02,Default,,0,0,0,,(барлық күш айқайлары)
Dialogue: 0,0:17:44.68,0:17:45.68,Default,,0,0,0,,Бога!
Dialogue: 0,0:17:53.28,0:17:54.90,Default,,0,0,0,,(Қасқырлардың ыңылдауы)
Dialogue: 0,0:17:57.82,0:17:59.74,Default,,0,0,0,,Әрбіріңіз!
Dialogue: 0,0:17:59.87,0:18:02.95,Default,,0,0,0,,Оу!
Dialogue: 0,0:18:09.00,0:18:10.71,Default,,0,0,0,,Уау... керемет
Dialogue: 0,0:18:10.83,0:18:13.05,Default,,0,0,0,,А... уф
Dialogue: 0,0:18:13.50,0:18:15.26,Default,,0,0,0,,Кофе ме?
Dialogue: 0,0:18:15.63,0:18:17.51,Default,,0,0,0,,А... иә?
Dialogue: 0,0:18:19.30,0:18:20.39,Default,,0,0,0,,Олардың аурасы ұқсас қой, иә? Олар әпкелер ме?
Dialogue: 0,0:18:20.47,0:18:22.10,Default,,0,0,0,,Жақсы (жаңадан шыққан жауынгер) Уф
Dialogue: 0,0:18:22.22,0:18:24.01,Default,,0,0,0,,Соншалықты ақымақ болма, жаңадан келген бала!
Dialogue: 0,0:18:24.10,0:18:26.31,Default,,0,0,0,,Бар болғанын бер!
Dialogue: 0,0:18:26.56,0:18:28.39,Default,,0,0,0,,Ах... (Шәкірт Әулие) Жақсысың ба?
Dialogue: 0,0:18:28.98,0:18:30.27,Default,,0,0,0,,О
Dialogue: 0,0:18:30.65,0:18:32.61,Default,,0,0,0,,Құрыш Мен оны сатып алғаныма қуаныштымын
Dialogue: 0,0:18:34.19,0:18:36.03,Default,,0,0,0,,Бұл өте көп ақша.
Dialogue: 0,0:18:36.15,0:18:37.57,Default,,0,0,0,,А, бірақ...
Dialogue: 0,0:18:38.32,0:18:41.74,Default,,0,0,0,,Оның барлық тактикасы нәтиже берді деуге болады.
Dialogue: 0,0:18:41.87,0:18:42.78,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:18:43.58,0:18:44.87,Default,,0,0,0,,Тұтқындау
Dialogue: 0,0:18:45.49,0:18:49.00,Default,,0,0,0,,Олар тосын шабуыл жасауға дағдыланған, бірақ шабуылға үйренбеген.
Dialogue: 0,0:18:49.87,0:18:52.13,Default,,0,0,0,,Олар ет қалқандарын пайдаланады
Dialogue: 0,0:18:52.25,0:18:56.05,Default,,0,0,0,,Ұйықтау заклинасын жасап, оны құтқару мүмкіндігін пайдаланыңыз.
Dialogue: 0,0:18:56.26,0:18:58.51,Default,,0,0,0,,Ұйқыдағы гоблиндермен араласпа
Dialogue: 0,0:18:58.63,0:19:00.18,Default,,0,0,0,,Ояну қиын.
Dialogue: 0,0:19:01.30,0:19:03.93,Default,,0,0,0,,Үйір өскен кезде қасқырды өсіріп, мінеді.
Dialogue: 0,0:19:05.22,0:19:09.39,Default,,0,0,0,,20-дан 30-ға дейін адам болуы мүмкін, бірақ бұл санмен біз оларды найзамен ұрғанша ұстай аламыз.
Dialogue: 0,0:19:10.39,0:19:12.02,Default,,0,0,0,,Қару оларды өлтіруі мүмкін
Dialogue: 0,0:19:12.73,0:19:14.48,Default,,0,0,0,,Қарумен жасай алмайтын нәрсені заклинание арқылы жасаңыз.
Dialogue: 0,0:19:15.27,0:19:19.44,Default,,0,0,0,,Ал бірінші болып жаудың сиқыршысын талқандаңыз.
Dialogue: 0,0:19:20.65,0:19:22.70,Default,,0,0,0,,(Гоблин Лордтың арылдауы)
Dialogue: 0,0:19:22.82,0:19:26.12,Default,,0,0,0,,(Гоблин чемпионының шайқас айқайы)
Dialogue: 0,0:19:26.87,0:19:30.08,Default,,0,0,0,,Бұл оның сыртқы түрі болса да күміс дегенді білдіре ме?
Dialogue: 0,0:19:31.58,0:19:33.33,Default,,0,0,0,,Мұндай жерге...
Dialogue: 0,0:19:33.46,0:19:37.25,Default,,0,0,0,,Ол ақырын қашып барады (Гоблин ыңырсыды)
Dialogue: 0,0:19:37.38,0:19:38.55,Default,,0,0,0,,Эй, ол туралы не деуге болады?
Dialogue: 0,0:19:41.18,0:19:43.05,Default,,0,0,0,,А... а...
Dialogue: 0,0:19:43.14,0:19:44.97,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:19:45.30,0:19:46.51,Default,,0,0,0,,О? (найза пайдаланушы) Не?
Dialogue: 0,0:19:46.60,0:19:49.02,Default,,0,0,0,,Сізге бірдеңе ұшып келеді! Сақ болыңыз!
Dialogue: 0,0:19:49.14,0:19:50.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:51.64,0:19:53.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:53.44,0:19:54.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:54.48,0:19:55.90,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:56.44,0:19:58.03,Default,,0,0,0,,(қатты аяқ дыбыстары)
Dialogue: 0,0:19:58.15,0:20:00.07,Default,,0,0,0,,Ой... уау!
Dialogue: 0,0:20:00.15,0:20:03.16,Default,,0,0,0,,(Гоблин айқайлау)
Dialogue: 0,0:20:03.28,0:20:04.36,Default,,0,0,0,,Гоа!
Dialogue: 0,0:20:04.70,0:20:06.28,Default,,0,0,0,,Бұл жолы пісіріңіз!?
Dialogue: 0,0:20:06.41,0:20:07.70,Default,,0,0,0,,Жоқ... (Авантюристер) Ха!
Dialogue: 0,0:20:08.91,0:20:10.45,Default,,0,0,0,,Үлкен жігіттер оны жек көреді.
Dialogue: 0,0:20:13.62,0:20:15.42,Default,,0,0,0,,Гоблин чемпионы
Dialogue: 0,0:20:15.96,0:20:17.09,Default,,0,0,0,,Олардың екеуі де.
Dialogue: 0,0:20:17.54,0:20:21.01,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:20:21.47,0:20:24.51,Default,,0,0,0,,Айтпақшы, мен кішкентай шабақтармен айналысудан шаршадым.
Dialogue: 0,0:20:25.14,0:20:28.10,Default,,0,0,0,,Менің негізгі жұмысым үлкен ойын жеу.
Dialogue: 0,0:20:28.22,0:20:29.51,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:20:29.64,0:20:33.73,Default,,0,0,0,,Мен қазір өлтірген гоблиндердің басын санаумен айналысып жатырмын.
Dialogue: 0,0:20:33.85,0:20:35.23,Default,,0,0,0,,Жарайды, араласайық!
Dialogue: 0,0:20:35.31,0:20:36.86,Default,,0,0,0,,Эй, артқа тұр.
Dialogue: 0,0:20:36.98,0:20:38.90,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:39.02,0:20:43.45,Default,,0,0,0,,Ондай жағдайда менің монахым мысықтың басын шетінен ұшырып жібереді.
Dialogue: 0,0:20:44.15,0:20:46.41,Default,,0,0,0,,Бұдан былай ардагерлердің майдан даласы!
Dialogue: 0,0:20:46.82,0:20:49.12,Default,,0,0,0,,Егер сіз өз дағдыларыңызға сенімді болмасаңыз, артта қалыңыз!
Dialogue: 0,0:20:51.58,0:20:56.50,Default,,0,0,0,,(Ауыр жауынгердің айқайы)
Dialogue: 0,0:20:57.29,0:20:58.84,Default,,0,0,0,,(Гоблин чемпионының шайқас айқайы)
Dialogue: 0,0:20:59.54,0:21:00.88,Default,,0,0,0,,Мұны істеме...
Dialogue: 0,0:21:01.05,0:21:02.84,Default,,0,0,0,,Маған су ішуге бола ма?
Dialogue: 0,0:21:02.97,0:21:04.22,Default,,0,0,0,,А... иә!
Dialogue: 0,0:21:04.30,0:21:06.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:06.26,0:21:09.18,Default,,0,0,0,,Менімен бірге болмайсың ба?
Dialogue: 0,0:21:10.35,0:21:12.02,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:21:12.14,0:21:18.94,Default,,0,0,0,,Шындығында, бұл қарапайым гоблиндермен айналысқаннан әлдеқайда жақсы.
Dialogue: 0,0:21:19.06,0:21:20.11,Default,,0,0,0,,Гоблин...
Dialogue: 0,0:21:20.23,0:21:23.11,Default,,0,0,0,,А, енді ойлап қарасам, ол кісі қайда?
Dialogue: 0,0:21:23.24,0:21:27.99,Default,,0,0,0,,О? Сіз оның кім екенін білесіз, солай ма?
Dialogue: 0,0:21:28.12,0:21:28.95,Default,,0,0,0,,Иә (жеңіл қылышшы) Ах...
Dialogue: 0,0:21:30.24,0:21:31.29,Default,,0,0,0,,Бұл шешілді, солай ма?
Dialogue: 0,0:21:34.96,0:21:40.54,Default,,0,0,0,,(Гоблин Лордтың ауыр тыныс алуы)
Dialogue: 0,0:21:45.51,0:21:46.34,Default,,0,0,0,,Я...
Dialogue: 0,0:21:49.34,0:21:50.30,Default,,0,0,0,,Гоблин-
Dialogue: 0,0:21:52.60,0:21:54.85,Default,,0,0,0,,Мен Срейге бардым.
Dialogue: 0,0:21:56.60,0:21:58.48,Default,,0,0,0,,(Гоблин лордының арылдауы)
Dialogue: 0,0:22:06.40,0:22:11.41,Default,,0,0,0,,♪~
Dialogue: 0,0:23:30.86,0:23:35.87,Default,,0,0,0,,~♪
