Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.99,0:00:39.62,op,NTP,0000,0000,0000,,Бұрмаланған оянуда
Dialogue: 0,0:00:39.67,0:00:44.16,op,NTP,0000,0000,0000,,Қызыл түн оянғанда
Dialogue: 0,0:00:44.54,0:00:49.00,op,NTP,0000,0000,0000,,Қара түнек мәңгі ұйқы
Dialogue: 0,0:00:49.24,0:00:53.79,op,NTP,0000,0000,0000,,Ай сәулесінен қорқады
Dialogue: 0,0:00:54.19,0:00:58.63,op,NTP,0000,0000,0000,,Жалындар мені орап жатыр
Dialogue: 0,0:00:58.83,0:01:03.83,op,NTP,0000,0000,0000,,Дүниені өртеп жіберсем де
Dialogue: 0,0:01:04.03,0:01:08.14,op,NTP,0000,0000,0000,,Тек дұға етуді жалғастырыңыз
Dialogue: 0,0:01:08.18,0:01:14.39,op,NTP,0000,0000,0000,,Ертеңге біз достармен бөлістік
Dialogue: 0,0:01:14.81,0:01:24.95,op,NTP,0000,0000,0000,,Толқыған жас қамал арқылы жаңғырық, ұмытылған семсерге қарай
Dialogue: 0,0:01:24.99,0:01:34.40,op,NTP,0000,0000,0000,,Өтпелілікке батқан жан, қалқыған нұр
Dialogue: 0,0:01:34.47,0:01:39.05,op,NTP,0000,0000,0000,,Аспанды қиып ал
Dialogue: 0,0:01:39.05,0:01:47.06,op,NTP,0000,0000,0000,,Бұл дүниеде үмітпен өлейік
Dialogue: 0,0:00:34.99,0:00:39.62,ed,NTP,0000,0000,0000,,Бұрмаланған ояту
Dialogue: 0,0:00:39.67,0:00:44.16,ed,NTP,0000,0000,0000,,Қызыл түн оянады
Dialogue: 0,0:00:44.54,0:00:49.00,ed,NTP,0000,0000,0000,,Лак қара мәңгілік ұйқы
Dialogue: 0,0:00:49.24,0:00:53.79,ed,NTP,0000,0000,0000,,Үздіксіз айдың көлеңкелі зынданы
Dialogue: 0,0:00:54.19,0:00:58.63,ed,NTP,0000,0000,0000,,Жалынға ұшыраған әлемге тікелей елші
Dialogue: 0,0:00:58.83,0:01:03.83,ed,NTP,0000,0000,0000,,Бірден жану қажет
Dialogue: 0,0:01:04.03,0:01:08.14,ed,NTP,0000,0000,0000,,Кездесуді жалғастыру үшін дұға
Dialogue: 0,0:01:08.18,0:01:14.39,ed,NTP,0000,0000,0000,,Ертең достармен өзара келісімге келу үшін
Dialogue: 0,0:01:14.81,0:01:24.95,ed,NTP,0000,0000,0000,,Толық көз жасы, Қамал бойы ұмытылу қылыш
Dialogue: 0,0:01:24.99,0:01:34.40,ed,NTP,0000,0000,0000,,Ал сəтке сіңген жан, Жүзіп өткен нұр
Dialogue: 0,0:01:34.47,0:01:39.05,ed,NTP,0000,0000,0000,,Көк аспанның жарылуы
Dialogue: 0,0:01:39.05,0:01:47.06,ed,NTP,0000,0000,0000,,Дүниедегі үміттің өлімі
Dialogue: 0,0:23:19.36,0:23:28.42,op,NTP,0000,0000,0000,,Дүниені бұзатын бөлшектер өте жеңіл.
Dialogue: 0,0:23:28.66,0:23:37.91,op,NTP,0000,0000,0000,,Күнімді өткізетін бұрышта тығылып қалдым
Dialogue: 0,0:23:38.23,0:23:42.18,op,NTP,0000,0000,0000,,Сізге ұзартылған екі жүзде не бейнеленген
Dialogue: 0,0:23:42.20,0:23:46.59,op,NTP,0000,0000,0000,,Қазір көздерің мұңды
Dialogue: 0,0:23:47.34,0:23:50.64,op,NTP,0000,0000,0000,,Қорғайтын бір ғана нәрсе бар
Dialogue: 0,0:23:50.66,0:23:53.90,op,NTP,0000,0000,0000,,Иә, сіз.
Dialogue: 0,0:23:54.74,0:23:58.68,op,NTP,0000,0000,0000,,Толып жатқан сезімдеріңізді орындаңыз
Dialogue: 0,0:23:58.82,0:24:04.36,op,NTP,0000,0000,0000,,Кәфарат түнінде де мен сені сүйемін
Dialogue: 0,0:24:04.52,0:24:12.85,op,NTP,0000,0000,0000,,Қараңғылық қанша терең болса да, ол бізді біріктіреді
Dialogue: 0,0:24:12.95,0:24:18.14,op,NTP,0000,0000,0000,,Дірілдеп, артына қарамай
Dialogue: 0,0:24:18.16,0:24:22.63,op,NTP,0000,0000,0000,,Мен ертең сол үшінмін
Dialogue: 0,0:24:22.70,0:24:29.28,op,NTP,0000,0000,0000,,Мен сені құшақтап, көремін дедім.
Dialogue: 0,0:24:29.37,0:24:34.85,op,NTP,0000,0000,0000,,Әлі көрінбейтін шындық
Dialogue: 0,0:23:19.36,0:23:28.42,ed,NTP,0000,0000,0000,,Дүние жүзіндегі бейбітшілікті бұзу, бұл өте қарапайым.
Dialogue: 0,0:23:28.66,0:23:37.91,ed,NTP,0000,0000,0000,,Күнделікті өмірдің бұрыштық бұрыштары
Dialogue: 0,0:23:38.23,0:23:42.18,ed,NTP,0000,0000,0000,,Кеңейтілген екі жақты пышақ проекциялық жарықтандыру
Dialogue: 0,0:23:42.20,0:23:46.59,ed,NTP,0000,0000,0000,,Бұл Қананың мұңды көзқарасы
Dialogue: 0,0:23:47.34,0:23:50.64,ed,NTP,0000,0000,0000,,Орынды тек бір адам қорғай алады.
Dialogue: 0,0:23:50.66,0:23:53.90,ed,NTP,0000,0000,0000,,Шатасу
Dialogue: 0,0:23:54.74,0:23:58.68,ed,NTP,0000,0000,0000,,Толып жатқан тілектер орындалады
Dialogue: 0,0:23:58.82,0:24:04.36,ed,NTP,0000,0000,0000,,Үздіксіз өтеудің түнгі қаласы келеді
Dialogue: 0,0:24:04.52,0:24:12.85,ed,NTP,0000,0000,0000,,Әрине қараңғы және қараңғы.
Dialogue: 0,0:24:12.95,0:24:18.14,ed,NTP,0000,0000,0000,,Биік тұрып, артқа қайта қарау
Dialogue: 0,0:24:18.16,0:24:22.63,ed,NTP,0000,0000,0000,,Ертеңгі күн ертең сияқты
Dialogue: 0,0:24:22.70,0:24:29.28,ed,NTP,0000,0000,0000,,Өзара кездесу, сәл құшақтау
Dialogue: 0,0:24:29.37,0:24:34.85,ed,NTP,0000,0000,0000,,Расталмаған ақиқат
Dialogue: 0,0:02:25.73,0:02:26.74,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:02:27.32,0:02:28.41,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:02:36.93,0:02:37.77,jp,NTP,0000,0000,0000,,Аудио: zwx & Tsurou; Аударма: Pulsar & Basugi; Өңдеу: Xiao Ke & Ariake no Tsuki; Уақыт белгісі: Фэн Ше; Дәстүрлі қытайшаға аудару: incot; Кодтау: Джинсу
Dialogue: 0,0:03:01.75,0:03:02.78,jp,NTP,0000,0000,0000,,Жарақат бар ма?
Dialogue: 0,0:03:06.12,0:03:07.97,jp,NTP,0000,0000,0000,,Жақсы сияқтысың, жақсы.
Dialogue: 0,0:03:12.88,0:03:13.88,jp,NTP,0000,0000,0000,,Мен тастап кеткен құралдар—
Dialogue: 0,0:03:16.90,0:03:17.96,jp,NTP,0000,0000,0000,,Дәл сол сәтте қоңырау соғылады.
Dialogue: 0,0:03:18.05,0:03:19.11,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:03:26.59,0:03:28.32,jp,NTP,0000,0000,0000,,Не? Бұл
Dialogue: 0,0:03:37.15,0:03:38.55,jp,NTP,0000,0000,0000,,Бұл мүмкін емес қой?
Dialogue: 0,0:03:54.78,0:03:55.85,jp,NTP,0000,0000,0000,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:03:57.50,0:03:58.71,jp,NTP,0000,0000,0000,,Радуга мектебі?
Dialogue: 0,0:03:58.87,0:04:01.29,jp,NTP,0000,0000,0000,,Балалар, сендер де соны көргілерің келеді.
Dialogue: 0,0:04:08.11,0:04:09.56,jp,NTP,0000,0000,0000,,Тұқым немесе құрылғы жоқ
Dialogue: 0,0:04:10.87,0:04:12.16,jp,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:04:13.14,0:04:16.24,jp,NTP,0000,0000,0000,,Менің атым Мисузу Кусакабе, мен Ниджи мектебінің үшінші курс студентімін.
Dialogue: 0,0:04:16.76,0:04:18.92,jp,NTP,0000,0000,0000,,Бұл Какеру Сацуки. Бұл бала
Dialogue: 0,0:04:18.98,0:04:20.25,jp,NTP,0000,0000,0000,,Бұл Юка Минасе.
Dialogue: 0,0:04:20.90,0:04:22.26,jp,NTP,0000,0000,0000,,Біз екінші курс студенттеріміз
Dialogue: 0,0:04:22.76,0:04:24.37,jp,NTP,0000,0000,0000,,Түсіндім, рахмет
Dialogue: 0,0:04:25.00,0:04:26.46,jp,NTP,0000,0000,0000,,Алдын ала рахмет.
Dialogue: 0,0:04:26.93,0:04:28.08,jp,NTP,0000,0000,0000,,Әдептілік сияқты жақсы емес
Dialogue: 0,0:04:28.43,0:04:29.87,jp,NTP,0000,0000,0000,,Бұл табиғи болды.
Dialogue: 0,0:04:30.67,0:04:33.57,jp,NTP,0000,0000,0000,,Құсақабе-сенпай, бұл дүние қандай?
Dialogue: 0,0:04:34.13,0:04:35.39,jp,NTP,0000,0000,0000,,Мен де білмеймін
Dialogue: 0,0:04:37.57,0:04:42.22,jp,NTP,0000,0000,0000,,Бір нәрсе анық: бұл дүние әдейі жаратылған.
Dialogue: 0,0:04:42.82,0:04:43.91,jp,NTP,0000,0000,0000,,Декорация бірдей болғанымен
Dialogue: 0,0:04:44.40,0:04:47.59,jp,NTP,0000,0000,0000,,Қазіргі әлемнен өзгеше уақыт пен кеңістікте бар
Dialogue: 0,0:04:48.72,0:04:50.41,jp,NTP,0000,0000,0000,,Әртүрлі кеңістік-уақыт
Dialogue: 0,0:04:50.86,0:04:55.75,jp,NTP,0000,0000,0000,,Мына қызыл түнде не үшін келдік?
Dialogue: 0,0:04:56.16,0:04:57.29,jp,NTP,0000,0000,0000,,Қызыл түн?
Dialogue: 0,0:04:57.81,0:04:59.42,jp,NTP,0000,0000,0000,,Бұл жаман ат емес.
Dialogue: 0,0:05:00.68,0:05:03.75,jp,NTP,0000,0000,0000,,Мен шын мағынасын білмеймін, бірақ оның мағынасы болуы керек.
Dialogue: 0,0:05:04.51,0:05:05.74,jp,NTP,0000,0000,0000,,Сонымен қатар таңдалған мағына
Dialogue: 0,0:05:06.28,0:05:07.32,jp,NTP,0000,0000,0000,,Таңдалған?
Dialogue: 0,0:05:07.80,0:05:10.00,jp,NTP,0000,0000,0000,,Балалар сендерде де күш бар ма?
Dialogue: 0,0:05:10.37,0:05:11.31,jp,NTP,0000,0000,0000,,Күш?
Dialogue: 0,0:05:12.27,0:05:14.13,jp,NTP,0000,0000,0000,,Көргің келген Құсақабе-сенпай ма?
Dialogue: 0,0:05:14.72,0:05:16.91,jp,NTP,0000,0000,0000,,Бізде ондай ештеңе жоқ.
Dialogue: 0,0:05:21.65,0:05:22.61,jp,NTP,0000,0000,0000,,Бұл олар.
Dialogue: 0,0:05:23.59,0:05:24.53,jp,NTP,0000,0000,0000,,Олар?
Dialogue: 0,0:05:25.28,0:05:27.30,jp,NTP,0000,0000,0000,,Мен үйге барғым келеді, Какеру-кун.
Dialogue: 0,0:05:28.14,0:05:29.17,jp,NTP,0000,0000,0000,,Барлық жауынгерлер келгенше
Dialogue: 0,0:05:26.41,0:05:31.41,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:05:36.54,0:05:37.85,jp,NTP,0000,0000,0000,,Бұл жерде ме?
Dialogue: 0,0:05:39.17,0:05:41.94,jp,NTP,0000,0000,0000,,Бұл хрусталь мұнара қуатты Qi-мен толтырылған.
Dialogue: 0,0:05:42.67,0:05:45.82,jp,NTP,0000,0000,0000,,Мүмкін ол жер дүниенің орталығы шығар.
Dialogue: 0,0:05:46.84,0:05:49.53,jp,NTP,0000,0000,0000,,Мен мұнараға барамын, сендер тығылып тұрсыңдар.
Dialogue: 0,0:05:49.69,0:05:50.65,jp,NTP,0000,0000,0000,,Мен де барамын
Dialogue: 0,0:05:50.81,0:05:53.24,jp,NTP,0000,0000,0000,,Каку-кун, жоқ, бұл қауіпті.
Dialogue: 0,0:05:53.85,0:05:55.78,jp,NTP,0000,0000,0000,,Құсақабе-сенпай, мен де сенімен біргемін.
Dialogue: 0,0:05:56.23,0:05:57.20,jp,NTP,0000,0000,0000,,Бұл кедергі
Dialogue: 0,0:05:58.23,0:06:02.06,jp,NTP,0000,0000,0000,,Сіз бірдеңе істей аласыз, сізде күш жоқ.
Dialogue: 0,0:06:07.43,0:06:07.99,jp,NTP,0000,0000,0000,,Шимада
Dialogue: 0,0:06:15.07,0:06:18.02,jp,NTP,0000,0000,0000,,Доюки Тачибана Райкири
Dialogue: 0,0:06:25.75,0:06:26.63,jp,NTP,0000,0000,0000,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:06:55.45,0:06:56.81,jp,NTP,0000,0000,0000,,Сол мұнараға барайық.
Dialogue: 0,0:06:56.96,0:06:57.89,jp,NTP,0000,0000,0000,,Какеру-кун?
Dialogue: 0,0:06:58.04,0:06:59.24,jp,NTP,0000,0000,0000,,Өлгің келе ме?
Dialogue: 0,0:06:59.72,0:07:02.66,jp,NTP,0000,0000,0000,,Қызыл түн біткенше қашу керек.
Dialogue: 0,0:07:03.29,0:07:04.45,jp,NTP,0000,0000,0000,,Ол сағат нешеде аяқталады?
Dialogue: 0,0:07:05.24,0:07:07.38,jp,NTP,0000,0000,0000,,Оның аяқталуына қандай кепілдік бар?
Dialogue: 0,0:07:07.88,0:07:09.79,jp,NTP,0000,0000,0000,,Бұл уақыт аяқталмауы мүмкін
Dialogue: 0,0:07:10.51,0:07:12.40,jp,NTP,0000,0000,0000,,Бұл мәңгілікке осылай қалуы мүмкін, солай ма?
Dialogue: 0,0:07:13.11,0:07:16.31,jp,NTP,0000,0000,0000,,Егер бұл мұнараның потенциалы болса
Dialogue: 0,0:07:16.70,0:07:17.80,jp,NTP,0000,0000,0000,,Менің барғым келеді
Dialogue: 0,0:07:21.42,0:07:22.81,jp,NTP,0000,0000,0000,,Балаға көмектескіңіз келе ме?
Dialogue: 0,0:07:23.20,0:07:24.17,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:07:24.33,0:07:25.55,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:07:26.23,0:07:28.78,jp,NTP,0000,0000,0000,,Қашсаң да, ұрыссаң да нәтиже бірдей ме?
Dialogue: 0,0:07:29.70,0:07:30.91,jp,NTP,0000,0000,0000,,Жарайды, түсіндім.
Dialogue: 0,0:07:31.36,0:07:34.11,jp,NTP,0000,0000,0000,,Алайда мен ол мұнарада не бар екенін білмеймін.
Dialogue: 0,0:07:34.60,0:07:36.05,jp,NTP,0000,0000,0000,,Біз сізді қорғай алмауымыз мүмкін.
Dialogue: 0,0:07:36.57,0:07:37.70,jp,NTP,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:07:37.84,0:07:38.81,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:07:39.09,0:07:40.98,jp,NTP,0000,0000,0000,,Юка Юка бір жерде
Dialogue: 0,0:07:41.20,0:07:43.23,jp,NTP,0000,0000,0000,,Мен де барамын, мені тастама.
Dialogue: 0,0:07:46.14,0:07:48.42,jp,NTP,0000,0000,0000,,Қандай жағдай болса да, мен сені әрқашан қорғаймын.
Dialogue: 0,0:07:48.70,0:07:49.12,jp,NTP,0000,0000,0000,,Қазір
Dialogue: 0,0:07:55.99,0:07:57.09,jp,NTP,0000,0000,0000,,Тырнақтарыңды қадалама.
Dialogue: 0,0:08:01.55,0:08:01.95,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:08:03.25,0:08:03.76,jp,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:08:04.78,0:08:05.43,jp,NTP,0000,0000,0000,,Көздер
Dialogue: 0,0:08:10.70,0:08:11.47,jp,NTP,0000,0000,0000,,Барсам болады ма?
Dialogue: 0,0:08:12.01,0:08:12.58,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:08:32.01,0:08:34.08,jp,NTP,0000,0000,0000,,Мен сені бұл жерден жібермеймін.
Dialogue: 0,0:08:34.94,0:08:36.72,jp,NTP,0000,0000,0000,,Сөйлей алатын адамдар бар ма?
Dialogue: 0,0:08:39.07,0:08:40.01,jp,NTP,0000,0000,0000,,Әрі қарай жол бермеу деген нені білдіреді?
Dialogue: 0,0:08:40.01,0:08:44.50,jp,NTP,0000,0000,0000,,Ішінде қорғауға болатын маңызды нәрсе бар.
Dialogue: 0,0:08:45.36,0:08:46.76,jp,NTP,0000,0000,0000,,Маған хабарлағаныңыз үшін рахмет.
Dialogue: 0,0:08:56.28,0:08:58.33,jp,NTP,0000,0000,0000,,Күшті Мен ешқандай қозғалысты көрмедім.
Dialogue: 0,0:09:13.34,0:09:15.09,jp,NTP,0000,0000,0000,,Сол қыз ғой
Dialogue: 0,0:09:38.77,0:09:39.90,jp,NTP,0000,0000,0000,,Саған тағы біраз көрсеткім келетін, бірақ…
Dialogue: 0,0:09:41.81,0:09:42.58,jp,NTP,0000,0000,0000,,Бұл мүмкін емес қой?
Dialogue: 0,0:09:45.02,0:09:45.69,jp,NTP,0000,0000,0000,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:09:47.85,0:09:48.31,jp,NTP,0000,0000,0000,,Сіздің атыңыз кім?
Dialogue: 0,0:09:49.21,0:09:50.35,jp,NTP,0000,0000,0000,,Мен Лизетпін
Dialogue: 0,0:09:51.11,0:09:52.43,jp,NTP,0000,0000,0000,,Неліктен көмек сұрау керек?
Dialogue: 0,0:09:52.93,0:09:55.51,jp,NTP,0000,0000,0000,,Мен тұзаққа түстім, көмектесіңізші
Dialogue: 0,0:09:55.98,0:09:57.06,jp,NTP,0000,0000,0000,,Мені бұл жерден кетіріңіз
Dialogue: 0,0:09:58.23,0:09:58.77,jp,NTP,0000,0000,0000,,18-ші эпизод: Венецияға!
Dialogue: 0,0:10:00.64,0:10:02.31,jp,NTP,0000,0000,0000,,Лизетта – рухтың шебері.
Dialogue: 0,0:10:03.67,0:10:06.69,jp,NTP,0000,0000,0000,,Бұл қызыл түнді неден жаратса керек
Dialogue: 0,0:10:07.38,0:10:08.00,jp,NTP,0000,0000,0000,,Түсіндім, Лизет.
Dialogue: 0,0:10:10.42,0:10:12.22,jp,NTP,0000,0000,0000,,Сіз бізді осында әкелдіңіз
Dialogue: 0,0:10:12.92,0:10:13.86,jp,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:10:14.73,0:10:15.99,jp,NTP,0000,0000,0000,,Мен емес
Dialogue: 0,0:10:16.34,0:10:17.26,jp,NTP,0000,0000,0000,,Бұл өтірік
Dialogue: 0,0:10:18.72,0:10:21.50,jp,NTP,0000,0000,0000,,Оны қайтар, бізді бастапқы әлемге қайтар.
Dialogue: 0,0:10:22.39,0:10:23.15,jp,NTP,0000,0000,0000,,Өтінемін
Dialogue: 0,0:10:25.51,0:10:26.67,jp,NTP,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:10:28.14,0:10:29.46,jp,NTP,0000,0000,0000,,Санасыз ба?
Dialogue: 0,0:10:30.31,0:10:31.98,jp,NTP,0000,0000,0000,,Лизеттің ішінде бірдеңе
Dialogue: 0,0:10:32.51,0:10:35.25,jp,NTP,0000,0000,0000,,Бейсаналық белсендірілген, осы дүниені дүниеге әкелген
Dialogue: 0,0:10:35.60,0:10:38.35,jp,NTP,0000,0000,0000,,Олар бізді кіргізген болуы мүмкін.
Dialogue: 0,0:10:39.85,0:10:40.97,jp,NTP,0000,0000,0000,,Көмектесейік
Dialogue: 0,0:10:41.24,0:10:42.19,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:10:42.69,0:10:43.28,jp,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:10:43.70,0:10:46.39,jp,NTP,0000,0000,0000,,Мен қиналып жатырмын, өтінемін, Какеру-кун.
Dialogue: 0,0:10:47.33,0:10:48.95,jp,NTP,0000,0000,0000,,Егер Юка солай айтса
Dialogue: 0,0:10:49.53,0:10:51.44,jp,NTP,0000,0000,0000,,Қандай жұмсақ адам!
Dialogue: 0,0:10:52.64,0:10:55.50,jp,NTP,0000,0000,0000,,Оның біз естіп жүрген Верардқа еш ұқсастығы жоқ.
Dialogue: 0,0:11:27.58,0:11:28.38,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:11:35.44,0:11:36.14,jp,NTP,0000,0000,0000,,Сен жай ғана... отты қайта тұтаттың, иә?
Dialogue: 0,0:11:36.76,0:11:40.40,jp,NTP,0000,0000,0000,,Сіздің техникаларыңызды бұл сарайда қолдануға болмайды.
Dialogue: 0,0:11:41.99,0:11:44.72,jp,NTP,0000,0000,0000,,Енді мен сенен жоғалуыңды сұрауым керек пе?
Dialogue: 0,0:11:46.61,0:11:50.23,jp,NTP,0000,0000,0000,,Сіз қорғаушыларсыз ба әлде билеуші ​​ме?
Dialogue: 0,0:11:50.23,0:11:53.72,jp,NTP,0000,0000,0000,,Жоғалған бөліктерге жауап берудің қажеті жоқ.
Dialogue: 0,0:11:54.60,0:11:55.41,jp,NTP,0000,0000,0000,,Фрагмент?
Dialogue: 0,0:11:56.11,0:11:59.07,jp,NTP,0000,0000,0000,,Сіз болмауыңыз керек.
Dialogue: 0,0:11:59.54,0:12:01.22,jp,NTP,0000,0000,0000,,Әсіресе сіз
Dialogue: 0,0:12:02.13,0:12:03.31,jp,NTP,0000,0000,0000,,Invidia
Dialogue: 0,0:12:07.33,0:12:08.26,jp,NTP,0000,0000,0000,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:12:08.65,0:12:09.36,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:12:09.59,0:12:10.34,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:12:17.92,0:12:18.98,jp,NTP,0000,0000,0000,,Ол бос па?
Dialogue: 0,0:12:19.57,0:12:20.02,jp,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:12:23.17,0:12:25.35,jp,NTP,0000,0000,0000,,Не, үйге бармадың ба?
Dialogue: 0,0:12:30.05,0:12:31.15,jp,NTP,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,0:12:31.41,0:12:32.32,jp,NTP,0000,0000,0000,,Бөлек
Dialogue: 0,0:12:33.07,0:12:34.44,jp,NTP,0000,0000,0000,,Сені жұбатуымды қалайсың ба?
Dialogue: 0,0:12:35.04,0:12:36.34,jp,NTP,0000,0000,0000,,Олай емес.
Dialogue: 0,0:12:38.22,0:12:39.62,jp,NTP,0000,0000,0000,,Өйткені сіз шыншыл емессіз.
Dialogue: 0,0:13:11.55,0:13:12.93,jp,NTP,0000,0000,0000,,Аздап тынышталдыңыз ба?
Dialogue: 0,0:13:14.11,0:13:15.07,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:15.28,0:13:16.22,jp,NTP,0000,0000,0000,,Минасе-кун
Dialogue: 0,0:13:16.69,0:13:17.58,jp,NTP,0000,0000,0000,,әйтеуір
Dialogue: 0,0:13:17.86,0:13:21.46,jp,NTP,0000,0000,0000,,Мүлдем
Dialogue: 0,0:13:24.71,0:13:25.55,jp,NTP,0000,0000,0000,,Мені жақсы жын ойнап тұрғандай сезінемін, әр уақытта.
Dialogue: 0,0:13:26.94,0:13:29.07,jp,NTP,0000,0000,0000,,Маған ұнағандықтан таңдалмаса да.
Dialogue: 0,0:13:29.33,0:13:30.17,jp,NTP,0000,0000,0000,,Олар
Dialogue: 0,0:13:30.59,0:13:35.65,jp,NTP,0000,0000,0000,,Құсақабе-сенпай бұларды айтты
Dialogue: 0,0:13:36.34,0:13:37.48,jp,NTP,0000,0000,0000,,Қызыл түнде бізден басқа адамдар бар ма?
Dialogue: 0,0:13:38.80,0:13:41.04,jp,NTP,0000,0000,0000,,А, міне сен.
Dialogue: 0,0:13:41.85,0:13:43.87,jp,NTP,0000,0000,0000,,Кем дегенде тағы үшеуі бар.
Dialogue: 0,0:13:44.73,0:13:48.04,jp,NTP,0000,0000,0000,,Бірақ мен тек бір адамның түрін көрдім
Dialogue: 0,0:13:48.72,0:13:49.67,jp,NTP,0000,0000,0000,,Қалған екеуін алыстан көріп қалдым.
Dialogue: 0,0:13:50.36,0:13:54.38,jp,NTP,0000,0000,0000,,Олар қандай адамдар?
Dialogue: 0,0:13:55.14,0:13:57.30,jp,NTP,0000,0000,0000,,Үшеуі де Радуга мектебінің оқушылары, екі қыз және бір ұл.
Dialogue: 0,0:13:57.60,0:14:00.27,jp,NTP,0000,0000,0000,,Сіз олардан қашып кеттіңіз бе?
Dialogue: 0,0:14:00.82,0:14:01.61,jp,NTP,0000,0000,0000,,Жоқ, мен жындармен соғыстым.
Dialogue: 0,0:14:03.25,0:14:07.47,jp,NTP,0000,0000,0000,,Жын?
Dialogue: 0,0:14:03.25,0:14:07.47,jp,NTP,0000,0000,0000,,Онмиодода барлық зұлым жандар жындар деп аталады.
Dialogue: 0,0:14:08.42,0:14:10.55,jp,NTP,0000,0000,0000,,Құсақабе-сенпай онмиодзи ғой, солай ма?
Dialogue: 0,0:14:11.25,0:14:12.41,jp,NTP,0000,0000,0000,,Дайо на
Dialogue: 0,0:14:12.85,0:14:15.66,jp,NTP,0000,0000,0000,,Олар формулалар емес еді
Dialogue: 0,0:14:16.00,0:14:18.72,jp,NTP,0000,0000,0000,,Оны жын деуден гөрі, қараңғылықта өмір сүретін рухани болмыс.
Dialogue: 0,0:14:19.55,0:14:21.76,jp,NTP,0000,0000,0000,,Мүмкін мен оны қара рух деп атағаным жөн болар.
Dialogue: 0,0:14:22.56,0:14:23.48,jp,NTP,0000,0000,0000,,Қара рух
Dialogue: 0,0:14:24.15,0:14:27.33,jp,NTP,0000,0000,0000,,Мм, қалғандары қайда?
Dialogue: 0,0:14:27.91,0:14:31.49,jp,NTP,0000,0000,0000,,Мен сені кездесуге рұқсат етемін. Мен көрген адам үшінші курс студенті еді.
Dialogue: 0,0:14:32.21,0:14:33.24,jp,NTP,0000,0000,0000,,Мен де есімін білемін
Dialogue: 0,0:14:33.87,0:14:37.53,jp,NTP,0000,0000,0000,,Егер сіз шайқасқан болсаңыз, бұл сізде қандай да бір күш бар дегенді білдіре ме?
Dialogue: 0,0:14:38.18,0:14:39.41,jp,NTP,0000,0000,0000,,Сіз онмиодзисіз бе?
Dialogue: 0,0:14:39.97,0:14:40.93,jp,NTP,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:14:41.82,0:14:44.88,jp,NTP,0000,0000,0000,,Онымен кездескенде оның құдіреті туралы сұраңыз.
Dialogue: 0,0:14:48.90,0:14:51.00,jp,NTP,0000,0000,0000,,Менде де күш бар ма?
Dialogue: 0,0:14:51.48,0:14:52.47,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:14:52.68,0:14:55.12,jp,NTP,0000,0000,0000,,Сол кезде қара рыцарь
Dialogue: 0,0:15:00.83,0:15:01.59,jp,NTP,0000,0000,0000,,Сатсуки-кун
Dialogue: 0,0:15:02.06,0:15:03.92,jp,NTP,0000,0000,0000,,Сіз оны шешіп, қарап шыға аласыз ба?
Dialogue: 0,0:15:05.84,0:15:06.81,jp,NTP,0000,0000,0000,,Менің оң көзім?
Dialogue: 0,0:15:07.55,0:15:08.21,jp,NTP,0000,0000,0000,,Менің жеңуімнің себебі…
Dialogue: 0,0:15:08.88,0:15:13.17,jp,NTP,0000,0000,0000,,Бірақ сол жолы хрусталь мұнараға жақын болғаныңызда, сіз ауырсынуды сезінген боларсыз.
Dialogue: 0,0:15:14.23,0:15:18.36,jp,NTP,0000,0000,0000,,Ойлап қарасам, қызыл түнге ұшсам да, Оң көзім ауырады.
Dialogue: 0,0:15:19.13,0:15:20.04,jp,NTP,0000,0000,0000,,Маған көрсет
Dialogue: 0,0:15:20.37,0:15:21.39,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:15:34.74,0:15:36.74,jp,NTP,0000,0000,0000,,Сенпай, не болды?
Dialogue: 0,0:15:37.86,0:15:40.50,jp,NTP,0000,0000,0000,,Минасэ-кун, сен ештеңе сезбейсің бе?
Dialogue: 0,0:15:42.06,0:15:43.14,jp,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:15:43.45,0:15:44.89,jp,NTP,0000,0000,0000,,Жетеді, рахмет
Dialogue: 0,0:15:56.57,0:15:58.55,jp,NTP,0000,0000,0000,,Сіз әлі оянған жоқсыз.
Dialogue: 0,0:15:59.09,0:16:01.06,jp,NTP,0000,0000,0000,,Оның қандай күш екенін білмеймін, бірақ
Dialogue: 0,0:16:01.59,0:16:04.03,jp,NTP,0000,0000,0000,,Маған сол көздер туралы мәлімет берейін.
Dialogue: 0,0:16:05.32,0:16:06.78,jp,NTP,0000,0000,0000,,Менің де күшім бар
Dialogue: 0,0:16:07.15,0:16:09.33,jp,NTP,0000,0000,0000,,Менде де солай болады.
Dialogue: 0,0:16:10.53,0:16:13.23,jp,NTP,0000,0000,0000,,Сондықтан болар мені де таңдады.
Dialogue: 0,0:16:20.58,0:16:22.22,jp,NTP,0000,0000,0000,,Осыны айту дұрыс па?
Dialogue: 0,0:16:25.03,0:16:27.00,jp,NTP,0000,0000,0000,,Бізді өлтіреді
Dialogue: 0,0:16:28.57,0:16:30.92,jp,NTP,0000,0000,0000,,Өтінемін, мен өлсем жанымда болшы
Dialogue: 0,0:16:30.99,0:16:32.76,jp,NTP,0000,0000,0000,,Олай айтпа, ақымақ.
Dialogue: 0,0:16:33.42,0:16:34.41,jp,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,0:16:34.67,0:16:37.83,jp,NTP,0000,0000,0000,,Мен Юканы қорғаймын, міндетті түрде қорғаймын.
Dialogue: 0,0:16:52.07,0:16:54.53,jp,NTP,0000,0000,0000,,Какуми, сен не істеп жатырсың?
Dialogue: 0,0:16:54.87,0:16:57.53,jp,NTP,0000,0000,0000,,Қолыңды айқастырып ғашықсың ба?
Dialogue: 0,0:16:58.08,0:16:59.07,jp,NTP,0000,0000,0000,,Такаши-кун
Dialogue: 0,0:16:59.30,0:17:01.44,jp,NTP,0000,0000,0000,,Мен оны тоқтата алмадым.
Dialogue: 0,0:17:01.83,0:17:02.75,jp,NTP,0000,0000,0000,,Каори-чан
Dialogue: 0,0:17:05.42,0:17:07.32,jp,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:07.61,0:17:09.26,jp,NTP,0000,0000,0000,,Кенеттен құлап кетпеңіз.
Dialogue: 0,0:17:09.52,0:17:10.68,jp,NTP,0000,0000,0000,,Басыңнан айырылдың ба?
Dialogue: 0,0:17:10.92,0:17:11.58,jp,NTP,0000,0000,0000,,Райнер, кейін кездескенше.
Dialogue: 0,0:17:11.82,0:17:12.70,jp,NTP,0000,0000,0000,,Менің мұрным бітелді.
Dialogue: 0,0:17:12.94,0:17:14.49,jp,NTP,0000,0000,0000,,Мен мұрынды қалай ұруға болады?
Dialogue: 0,0:17:14.76,0:17:16.07,jp,NTP,0000,0000,0000,,Жақсы, мен соқтым деп ойлаймын.
Dialogue: 0,0:17:16.88,0:17:17.87,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:17:20.01,0:17:21.13,jp,NTP,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:17:21.59,0:17:24.34,jp,NTP,0000,0000,0000,,Каориді оят, мен саған печенье беремін.
Dialogue: 0,0:17:25.26,0:17:27.53,jp,NTP,0000,0000,0000,,Мен жұмыс істейтін жануармын ба?
Dialogue: 0,0:17:34.01,0:17:35.51,jp,NTP,0000,0000,0000,,Не болды, Какеру?
Dialogue: 0,0:17:38.54,0:17:39.67,jp,NTP,0000,0000,0000,,Шиори-сан
Dialogue: 0,0:17:42.26,0:17:43.35,jp,NTP,0000,0000,0000,,болды
Dialogue: 0,0:17:44.34,0:17:47.42,jp,NTP,0000,0000,0000,,Мен сенен Аяме Нииді көрсетуіңді өтіндім, сондықтан оны осында алып келдім.
Dialogue: 0,0:17:47.75,0:17:48.78,jp,NTP,0000,0000,0000,,Жоғалып кетті
Dialogue: 0,0:17:55.98,0:17:58.97,jp,NTP,0000,0000,0000,,Шиори-чан, мені оятшы О... Шикато
Dialogue: 0,0:18:02.06,0:18:03.95,jp,NTP,0000,0000,0000,,Сіз қайда болдыңыз? Мен сені іздедім.
Dialogue: 0,0:18:04.43,0:18:06.68,jp,NTP,0000,0000,0000,,Мен мысық қуып жүріп адасып қалдым.
Dialogue: 0,0:18:07.59,0:18:08.50,jp,NTP,0000,0000,0000,,Мысық па?
Dialogue: 0,0:18:08.97,0:18:11.82,jp,NTP,0000,0000,0000,,Каори, мені оят, екі печенье бер.
Dialogue: 0,0:18:12.42,0:18:15.63,jp,NTP,0000,0000,0000,,Бұл тітіркендіргіш. Мені оятуыңды қалаймын. Өтінемін, шығарыңыз.
Dialogue: 0,0:18:16.14,0:18:17.07,jp,NTP,0000,0000,0000,,Жын келіншек
Dialogue: 0,0:18:17.34,0:18:18.69,jp,NTP,0000,0000,0000,,Әйелі кім?
Dialogue: 0,0:18:19.18,0:18:21.45,jp,NTP,0000,0000,0000,,Сенің әйелің болғаным неліктен жаман?
Dialogue: 0,0:18:21.52,0:18:22.36,jp,NTP,0000,0000,0000,,Тоқта
Dialogue: 0,0:18:30.10,0:18:31.84,jp,NTP,0000,0000,0000,,Мен бүгін толық емес жұмыс күнімнен демалыс аламын.
Dialogue: 0,0:18:32.55,0:18:33.79,jp,NTP,0000,0000,0000,,Шебермен амандасып болған соң
Dialogue: 0,0:18:34.04,0:18:35.01,jp,NTP,0000,0000,0000,,Мен сені үйге апарамын
Dialogue: 0,0:18:35.37,0:18:36.84,jp,NTP,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:18:37.44,0:18:38.29,jp,NTP,0000,0000,0000,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:18:40.64,0:18:41.97,jp,NTP,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:18:47.75,0:18:49.89,jp,NTP,0000,0000,0000,,Иә, бұл жаңа толық емес жұмыс күні.
Dialogue: 0,0:18:50.22,0:18:50.93,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:51.19,0:18:54.75,jp,NTP,0000,0000,0000,,Шебер жақында дүкеннен оралады деп күтілуде.
Dialogue: 0,0:18:55.29,0:18:55.73,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:56.71,0:18:59.32,jp,NTP,0000,0000,0000,,Білесің бе, мен сені бұрын еш жерден көрген емеспін.
Dialogue: 0,0:19:01.11,0:19:02.42,jp,NTP,0000,0000,0000,,Мүмкін.
Dialogue: 0,0:19:02.81,0:19:03.98,jp,NTP,0000,0000,0000,,Өйткені біз бір мектепте оқимыз
Dialogue: 0,0:19:05.12,0:19:06.29,jp,NTP,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:19:10.88,0:19:14.51,jp,NTP,0000,0000,0000,,Мен дәл қазір біраз ебедейсіз бала болдым, өйткені мен бұл туралы өте күлкілі болдым.
Dialogue: 0,0:19:15.25,0:19:17.51,jp,NTP,0000,0000,0000,,Бірақ уайымдама, бәрібір.
Dialogue: 0,0:19:19.79,0:19:24.75,jp,NTP,0000,0000,0000,,Менің атым Юкико Хирохара, С сыныбы, Ниджирёкан академиясының 1 курсы.
Dialogue: 0,0:19:25.24,0:19:26.78,jp,NTP,0000,0000,0000,,Мені Юкипон деп атаңыз.
Dialogue: 0,0:19:28.65,0:19:29.59,jp,NTP,0000,0000,0000,,Юкипон?
Dialogue: 0,0:19:30.09,0:19:30.92,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:19:31.15,0:19:34.82,jp,NTP,0000,0000,0000,,Сонымен, Сацуки-сенпай мен Минасе-сенпайды қалай атауға болады?
Dialogue: 0,0:19:35.59,0:19:38.63,jp,NTP,0000,0000,0000,,Жоқ, жай Сатсуки-сенпай жақсы.
Dialogue: 0,0:19:38.63,0:19:41.68,jp,NTP,0000,0000,0000,,Бұл жақсы емес. Бұл басқа адамның мінез-құлқы емес пе?
Dialogue: 0,0:19:42.35,0:19:43.20,jp,NTP,0000,0000,0000,,Бұл басқа біреу
Dialogue: 0,0:19:44.13,0:19:45.25,jp,NTP,0000,0000,0000,,? Ол бірдеңе деді
Dialogue: 0,0:19:45.72,0:19:46.86,jp,NTP,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:19:47.44,0:19:48.64,jp,NTP,0000,0000,0000,,Юка киюге қарсы емеспін.
Dialogue: 0,0:19:48.90,0:19:50.11,jp,NTP,0000,0000,0000,,Усу, түсіндім.
Dialogue: 0,0:19:50.46,0:19:52.41,jp,NTP,0000,0000,0000,,Сонымен Минасэ-сенпай - Юка-сан.
Dialogue: 0,0:19:53.09,0:19:54.83,jp,NTP,0000,0000,0000,,-де Сатсуки-сенпай
Dialogue: 0,0:19:55.78,0:19:56.77,jp,NTP,0000,0000,0000,,Содан кейін Качан.
Dialogue: 0,0:19:57.25,0:19:59.05,jp,NTP,0000,0000,0000,,Тым болмаса мені Кәкера-сенпай қыл.
Dialogue: 0,0:19:59.32,0:20:00.54,jp,NTP,0000,0000,0000,,Біз, түсіндім.
Dialogue: 0,0:20:00.81,0:20:03.33,jp,NTP,0000,0000,0000,,Онда мен кофе дайындаймын.
Dialogue: 0,0:20:03.80,0:20:07.79,jp,NTP,0000,0000,0000,,Yukiko Special, мен оны жаңа ғана әзірледім, бұл ақымақ.
Dialogue: 0,0:20:08.48,0:20:09.48,jp,NTP,0000,0000,0000,,Сәл күтіңіз.
Dialogue: 0,0:20:18.54,0:20:22.20,jp,NTP,0000,0000,0000,,Мен Юкико-чанмен араласқанда, уақыт осылай аяқталды.
Dialogue: 0,0:20:22.71,0:20:25.50,jp,NTP,0000,0000,0000,,Жарайды, телефонды анама салып, сонда қалдырамын.
Dialogue: 0,0:20:26.47,0:20:27.24,jp,NTP,0000,0000,0000,,Келесің бе?
Dialogue: 0,0:20:27.90,0:20:29.45,jp,NTP,0000,0000,0000,,Жоқ, мен бүгін үйге барамын.
Dialogue: 0,0:20:29.66,0:20:30.48,jp,NTP,0000,0000,0000,,Мен шаршадым
Dialogue: 0,0:20:30.93,0:20:31.60,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:20:32.65,0:20:34.85,jp,NTP,0000,0000,0000,,Біз ғана қиналғанымызға қуаныштымын
Dialogue: 0,0:20:36.00,0:20:37.32,jp,NTP,0000,0000,0000,,Ертең кездескенше
Dialogue: 0,0:20:41.54,0:20:44.15,jp,NTP,0000,0000,0000,,Бұл елес
Dialogue: 0,0:20:47.09,0:20:47.75,jp,NTP,0000,0000,0000,,Кикури мырза
Dialogue: 0,0:20:51.01,0:20:52.92,jp,NTP,0000,0000,0000,,Сондықтан бұл туралы алаңдамағаныңыз жөн.
Dialogue: 0,0:20:54.34,0:20:56.16,jp,NTP,0000,0000,0000,,Иә, рахмет
Dialogue: 0,0:20:58.97,0:21:00.71,jp,NTP,0000,0000,0000,,Қызыл түн қайта келсе
Dialogue: 0,0:21:01.63,0:21:03.61,jp,NTP,0000,0000,0000,,Мен келгенше қозғалма, жарай ма?
Dialogue: 0,0:21:05.14,0:21:06.18,jp,NTP,0000,0000,0000,,Түсіндім
Dialogue: 0,0:21:15.92,0:21:17.31,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:21:17.59,0:21:18.77,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:21:22.38,0:21:25.64,jp,NTP,0000,0000,0000,,Сіз шынымен Юканы қорғай аласыз ба?
Dialogue: 0,0:21:27.11,0:21:31.31,jp,NTP,0000,0000,0000,,Мен сені қорғағым келеді, бірақ қазір мен үшін
Dialogue: 0,0:22:02.85,0:22:04.04,jp,NTP,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:22:22.03,0:22:23.12,jp,NTP,0000,0000,0000,,Бұл мүмкін емес қой?
Dialogue: 0,0:22:24.40,0:22:24.76,jp,NTP,0000,0000,0000,,Колла
Dialogue: 0,0:22:26.31,0:22:27.14,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:22:27.18,0:22:27.93,jp,NTP,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:22:28.21,0:22:30.46,jp,NTP,0000,0000,0000,,Сіз үндемей, жоғалып кеткеніңіз үшін шошып кеттім.
Dialogue: 0,0:22:31.62,0:22:32.48,jp,NTP,0000,0000,0000,,Гомен
Dialogue: 0,0:22:33.55,0:22:34.47,jp,NTP,0000,0000,0000,,Мен оны қарап шықтым.
Dialogue: 0,0:22:34.91,0:22:38.50,jp,NTP,0000,0000,0000,,Менің жауабым жоқ деп ойлаймын, бірақ мен бірдеңе істемей тұра алмаймын.
Dialogue: 0,0:22:39.26,0:22:40.09,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:22:40.52,0:22:42.20,jp,NTP,0000,0000,0000,,Олай болса мен сенімен бірге тексеремін.
Dialogue: 0,0:22:42.81,0:22:43.29,jp,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:22:48.30,0:22:49.35,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:22:50.89,0:22:51.75,jp,NTP,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:22:52.21,0:22:53.30,jp,NTP,0000,0000,0000,,Иллюзия емес
Dialogue: 0,0:22:54.33,0:22:58.10,jp,NTP,0000,0000,0000,,Мен сонда болдым, қазір апам осында болды.
Dialogue: 0,0:23:02.00,0:23:03.09,jp,NTP,0000,0000,0000,,Ой, аралы тен
Dialogue: 0,0:23:04.84,0:23:05.30,jp,NTP,0000,0000,0000,,Көздер
Dialogue: 0,0:23:05.53,0:23:06.32,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:24:41.99,0:24:43.06,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:24:54.38,0:24:56.54,jp,NTP,0000,0000,0000,,Қара…Ай
Dialogue: 0,0:25:02.12,0:25:04.37,jp,NTP,0000,0000,0000,,Келесі жолы Жалғыз мақтаныш
Dialogue: 0,0:25:05.37,0:25:08.15,jp,NTP,0000,0000,0000,,Қорқыныштың соңында жауап бар ма?
Dialogue: 0,0:25:09.65,0:25:15.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory