Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:12.65,0:02:13.86,jp,NTP,0000,0000,0000,,Қара ай
Dialogue: 0,0:02:15.25,0:02:16.99,jp,NTP,0000,0000,0000,,Неліктен? неге
Dialogue: 0,0:02:18.45,0:02:19.60,jp,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:02:20.43,0:02:24.97,jp,NTP,0000,0000,0000,,Мен білмеймін, бірақ бұл жақсы белгі емес.
Dialogue: 0,0:02:42.26,0:02:46.35,jp,NTP,0000,0000,0000,,Болашақта сені қызыл түнге апарғанда, мектепке жиналайық.
Dialogue: 0,0:02:46.68,0:02:47.07,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:02:47.71,0:02:49.98,jp,NTP,0000,0000,0000,,Сондай-ақ мен сенімен таныстырамын деген қызды.
Dialogue: 0,0:02:50.16,0:02:52.15,jp,NTP,0000,0000,0000,,Сезімімді әлі шеше алмай жүрген сияқтымын.
Dialogue: 0,0:02:53.26,0:02:54.33,jp,NTP,0000,0000,0000,,Мен сені көргім келмейді
Dialogue: 0,0:02:54.83,0:02:57.47,jp,NTP,0000,0000,0000,,Менің ойымша, біз бірге болсақ қауіпсіз болар еді.
Dialogue: 0,0:02:58.08,0:02:59.67,jp,NTP,0000,0000,0000,,Әр адамның өз жағдайлары болады.
Dialogue: 0,0:03:00.24,0:03:01.20,jp,NTP,0000,0000,0000,,Тағы біраз күтіңіз.
Dialogue: 0,0:03:01.76,0:03:02.63,jp,NTP,0000,0000,0000,,Түсінікті
Dialogue: 0,0:03:05.22,0:03:05.75,jp,NTP,0000,0000,0000,,Жақында кездескенше
Dialogue: 0,0:03:06.59,0:03:07.41,jp,NTP,0000,0000,0000,,Құсақабе сенпай
Dialogue: 0,0:03:08.85,0:03:10.19,jp,NTP,0000,0000,0000,,Бұл не, Сатсуки-кун?
Dialogue: 0,0:03:10.55,0:03:11.12,jp,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:03:13.14,0:03:14.88,jp,NTP,0000,0000,0000,,Менің кейінірек талқылайтын нәрсем бар.
Dialogue: 0,0:03:15.18,0:03:18.87,jp,NTP,0000,0000,0000,,Жарайды, түскі үзілісте сыныпқа кел.
Dialogue: 0,0:03:19.32,0:03:19.75,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:03:22.14,0:03:24.34,jp,NTP,0000,0000,0000,,Какеру мырза, кеңес беру дегеніміз не?
Dialogue: 0,0:03:24.79,0:03:25.71,jp,NTP,0000,0000,0000,,Уф
Dialogue: 0,0:03:26.16,0:03:27.86,jp,NTP,0000,0000,0000,,Енді сабақ басталады.
Dialogue: 0,0:03:30.78,0:03:31.74,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:03:43.64,0:03:47.12,jp,NTP,0000,0000,0000,,Шайтанды оятқан сенсің.
Dialogue: 0,0:03:48.80,0:03:49.63,jp,NTP,0000,0000,0000,,Ібіліс…
Dialogue: 0,0:03:52.12,0:03:52.89,jp,NTP,0000,0000,0000,,...?
Dialogue: 0,0:03:53.88,0:03:55.48,jp,NTP,0000,0000,0000,,Сонда сіз...
Dialogue: 0,0:03:58.63,0:04:00.04,jp,NTP,0000,0000,0000,,Бұл менмін
Dialogue: 0,0:04:00.92,0:04:04.31,jp,NTP,0000,0000,0000,,Олай болса, Юка мен басқалары мен үшін қызыл түнде.
Dialogue: 0,0:04:05.84,0:04:06.58,jp,NTP,0000,0000,0000,,Мен үшін
Dialogue: 0,0:04:08.18,0:04:09.79,jp,NTP,0000,0000,0000,,Келесі, Сатсуки-кун.
Dialogue: 0,0:04:12.34,0:04:13.30,jp,NTP,0000,0000,0000,,Сатсуки-кун
Dialogue: 0,0:04:13.66,0:04:14.24,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:04:14.79,0:04:15.48,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:04:18.12,0:04:19.35,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:04:19.69,0:04:22.02,jp,NTP,0000,0000,0000,,Мен сабақтамын, сіз сабақтан тыс емессіз бе?
Dialogue: 0,0:04:22.27,0:04:22.95,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:04:23.56,0:04:25.45,jp,NTP,0000,0000,0000,,Какеру, қарашы
Dialogue: 0,0:04:25.77,0:04:27.88,jp,NTP,0000,0000,0000,,Сонда сіз бірдеңе істеп жатырсыз ба?
Dialogue: 0,0:04:28.11,0:04:28.88,jp,NTP,0000,0000,0000,,Экхи
Dialogue: 0,0:04:32.69,0:04:35.77,jp,NTP,0000,0000,0000,,Каори-сан, сені оқулықпен ұрғандар бағадан қалып қояды.
Dialogue: 0,0:04:36.18,0:04:39.69,jp,NTP,0000,0000,0000,,Мұғалім, осы сөйлейтін қоқысты дереу тастаңыз.
Dialogue: 0,0:04:39.76,0:04:41.66,jp,NTP,0000,0000,0000,,Қорқынышты қоқыс дегеніміз не?
Dialogue: 0,0:04:41.90,0:04:43.58,jp,NTP,0000,0000,0000,,Иә Иә Дәл солай
Dialogue: 0,0:04:43.83,0:04:45.77,jp,NTP,0000,0000,0000,,Үзіліс кезінде ойнаңыз
Dialogue: 0,0:05:03.20,0:05:03.87,jp,NTP,0000,0000,0000,,Қуат
Dialogue: 0,0:05:04.23,0:05:09.63,jp,NTP,0000,0000,0000,,Иә, мен оянбаймын. Менің ішімде ұйықтап жатқандай бір күш бар.
Dialogue: 0,0:05:10.69,0:05:11.93,jp,NTP,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:05:12.32,0:05:13.93,jp,NTP,0000,0000,0000,,Маған қалай күресу керектігін айтыңызшы
Dialogue: 0,0:05:14.44,0:05:16.85,jp,NTP,0000,0000,0000,,Ұйқыдағы күш жауынгерлік күш болса
Dialogue: 0,0:05:17.33,0:05:19.19,jp,NTP,0000,0000,0000,,Төбелессең, оянып кетуің мүмкін.
Dialogue: 0,0:05:19.44,0:05:21.31,jp,NTP,0000,0000,0000,,Жоқ, оның оянатынына сенімдімін.
Менің ойымша,
Dialogue: 0,0:05:23.39,0:05:24.47,jp,NTP,0000,0000,0000,,жақсы болар еді.
Dialogue: 0,0:05:26.28,0:05:28.56,jp,NTP,0000,0000,0000,,Мен Юка Минасені қорғауға деген ұмтылысты түсінемін.
Dialogue: 0,0:05:28.95,0:05:31.34,jp,NTP,0000,0000,0000,,Бірақ асығыс қателеседі.
Dialogue: 0,0:05:31.92,0:05:34.83,jp,NTP,0000,0000,0000,,Бір түнде ештеңе болмайды.
Dialogue: 0,0:05:35.07,0:05:37.82,jp,NTP,0000,0000,0000,,Мен білемін, бірақ мен мұны істегім келеді.
Dialogue: 0,0:05:38.48,0:05:40.68,jp,NTP,0000,0000,0000,,Жоқ, мен мұны істеуім керек.
Dialogue: 0,0:05:41.53,0:05:42.55,jp,NTP,0000,0000,0000,,Мен үшін
Dialogue: 0,0:05:45.89,0:05:47.64,jp,NTP,0000,0000,0000,,Өтінемін, Құсақабе-сенпай.
Dialogue: 0,0:05:47.99,0:05:50.00,jp,NTP,0000,0000,0000,,Өтінемін, маған қылыш өнерін үйретіңізші
Dialogue: 0,0:05:54.83,0:05:55.43,jp,NTP,0000,0000,0000,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:05:57.97,0:05:59.78,jp,NTP,0000,0000,0000,,Сенпай, күте тұрыңыз.
Dialogue: 0,0:06:04.60,0:06:05.61,jp,NTP,0000,0000,0000,,Нене, сонда тамақтанайық.
Dialogue: 0,0:06:05.91,0:06:06.55,jp,NTP,0000,0000,0000,,Ой, шынымен бе? Қызық екен.
Dialogue: 0,0:06:12.65,0:06:14.23,jp,NTP,0000,0000,0000,,Юка-санға қара.
Dialogue: 0,0:06:15.02,0:06:16.04,jp,NTP,0000,0000,0000,,Юкико-чан
Dialogue: 0,0:06:16.89,0:06:19.53,jp,NTP,0000,0000,0000,,Дәмді көрінеді. Мен тістеп аламын ба?
Dialogue: 0,0:06:25.05,0:06:28.33,jp,NTP,0000,0000,0000,,Авока мен асшаян? Бұл жақсы.
Dialogue: 0,0:06:28.55,0:06:29.90,jp,NTP,0000,0000,0000,,дәмді дәмді
Dialogue: 0,0:06:32.31,0:06:33.68,jp,NTP,0000,0000,0000,,Ас үшін рахмет.
Dialogue: 0,0:06:34.22,0:06:35.51,jp,NTP,0000,0000,0000,,Бір тістеу
Dialogue: 0,0:06:36.27,0:06:39.03,jp,NTP,0000,0000,0000,,Кешіріңіз, бұл соншалықты дәмді емес еді.
Dialogue: 0,0:06:41.34,0:06:41.98,jp,NTP,0000,0000,0000,,Кешіріңізші!
Dialogue: 0,0:06:43.08,0:06:47.30,jp,NTP,0000,0000,0000,,Мұнда не болып жатыр? Толық жегенім үшін ұрысып кете жаздадым.
Dialogue: 0,0:06:48.19,0:06:50.16,jp,NTP,0000,0000,0000,,Ол уланған болуы мүмкін бе?
Dialogue: 0,0:06:51.38,0:06:55.13,jp,NTP,0000,0000,0000,,Жоқ, Юкико-чанның күлкісін көргенде мен өзімді жақсы сезіндім.
Dialogue: 0,0:06:55.88,0:06:57.32,jp,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:06:59.18,0:07:00.46,jp,NTP,0000,0000,0000,,Осыны айтып тұрсыз ба?
Dialogue: 0,0:07:00.97,0:07:02.67,jp,NTP,0000,0000,0000,,Сонда мен одан бетер күлемін
Dialogue: 0,0:07:11.04,0:07:11.55,jp,NTP,0000,0000,0000,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:07:12.32,0:07:14.51,jp,NTP,0000,0000,0000,,Мұндай көркем әдебиетті оқудың еш мәні жоқ.
Dialogue: 0,0:07:41.30,0:07:43.90,jp,NTP,0000,0000,0000,,Ол адам Юкиконың танысы.
Dialogue: 0,0:07:45.43,0:07:46.10,jp,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:07:47.66,0:07:48.62,jp,NTP,0000,0000,0000,,Жер
Dialogue: 0,0:07:49.76,0:07:50.85,jp,NTP,0000,0000,0000,,Сізге ұнайтын адам
Dialogue: 0,0:07:53.73,0:07:56.23,jp,NTP,0000,0000,0000,,Жоқ, сен не айтып тұрсың?
Dialogue: 0,0:07:56.26,0:07:57.69,jp,NTP,0000,0000,0000,,Жоқ, Юка-сан.
Dialogue: 0,0:07:59.77,0:08:01.72,jp,NTP,0000,0000,0000,,Жоқ, кешіріңіз.
Dialogue: 0,0:08:04.85,0:08:07.88,jp,NTP,0000,0000,0000,,Мен ол адам туралы жақсы ештеңе айта алмаймын.
Dialogue: 0,0:08:08.46,0:08:09.49,jp,NTP,0000,0000,0000,,Дәл солай
Dialogue: 0,0:08:10.87,0:08:13.57,jp,NTP,0000,0000,0000,,Ол кісі де қиналып жатыр.
Dialogue: 0,0:08:14.78,0:08:15.89,jp,NTP,0000,0000,0000,,Юкико-чан
Dialogue: 0,0:08:23.46,0:08:26.48,jp,NTP,0000,0000,0000,,Юка-сан, сенің жүрегің ойлағаннан да көп.
Dialogue: 0,0:08:27.81,0:08:29.08,jp,NTP,0000,0000,0000,,Мен мұнда жүктеме болғым келмейді.
Dialogue: 0,0:08:30.51,0:08:32.33,jp,NTP,0000,0000,0000,,Эй, эй, Юкико-чан
Dialogue: 0,0:08:42.64,0:08:43.60,jp,NTP,0000,0000,0000,,Мен оны көрдім.
Dialogue: 0,0:08:43.93,0:08:44.67,jp,NTP,0000,0000,0000,,Не
Dialogue: 0,0:08:45.44,0:08:47.32,jp,NTP,0000,0000,0000,,Бұл жарқын және сүйкімді емес пе?
Dialogue: 0,0:08:47.72,0:08:48.82,jp,NTP,0000,0000,0000,,Егер сізге қамқорлық болса
Dialogue: 0,0:08:48.85,0:08:50.37,jp,NTP,0000,0000,0000,,Олай емес.
Dialogue: 0,0:08:51.38,0:08:54.24,jp,NTP,0000,0000,0000,,Егер сіздің ойыңызда бірдеңе болса, оны айту керек деп ойлаймын.
Dialogue: 0,0:08:54.67,0:08:57.56,jp,NTP,0000,0000,0000,,Ештеңе айтпай өкіну тәнге зиян.
Dialogue: 0,0:09:00.82,0:09:02.14,jp,NTP,0000,0000,0000,,Себебі мен ебедейсізмін
Dialogue: 0,0:09:05.55,0:09:07.51,jp,NTP,0000,0000,0000,,Жарайды, Шиори-чан, бұған ше?
Dialogue: 0,0:09:08.23,0:09:10.83,jp,NTP,0000,0000,0000,,Сіз жынды сияқтысыз.
Dialogue: 0,0:09:11.78,0:09:16.19,jp,NTP,0000,0000,0000,,Бұл толық жинақ. Неліктен 1 томның жанында 5 том бар?
Dialogue: 0,0:09:17.58,0:09:18.10,jp,NTP,0000,0000,0000,,Бұл рас
Dialogue: 0,0:09:19.19,0:09:23.47,jp,NTP,0000,0000,0000,,Сан тігінен бекітілмеген. Түзетіңізші.
Dialogue: 0,0:09:24.72,0:09:25.64,jp,NTP,0000,0000,0000,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:09:26.04,0:09:28.12,jp,NTP,0000,0000,0000,,Шиори-чан кітапхана комитетінің мүшесі болды.
Dialogue: 0,0:09:28.42,0:09:31.05,jp,NTP,0000,0000,0000,,Сосын Тадаши көмектескім келетінін айтты, солай болды.
Dialogue: 0,0:09:31.40,0:09:32.45,jp,NTP,0000,0000,0000,,Осыны айтып тұрсыз ба?
Dialogue: 0,0:09:33.05,0:09:33.87,jp,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,0:09:34.62,0:09:36.33,jp,NTP,0000,0000,0000,,Жарайды, бұл тамаша.
Dialogue: 0,0:09:37.38,0:09:40.27,jp,NTP,0000,0000,0000,,Өйткені, толық жинақты бір саты төмен қоямыз.
Dialogue: 0,0:09:42.14,0:09:43.88,jp,NTP,0000,0000,0000,,Тез арада
Dialogue: 0,0:09:44.73,0:09:45.72,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:09:46.67,0:09:47.94,jp,NTP,0000,0000,0000,,Тадаши, қолыңнан келгеннің бәрін істе
Dialogue: 0,0:10:05.30,0:10:06.21,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:10:08.44,0:10:09.12,jp,NTP,0000,0000,0000,,Аға
Dialogue: 0,0:10:13.06,0:10:15.05,jp,NTP,0000,0000,0000,,Мисузу Кусакабе?
Dialogue: 0,0:10:23.15,0:10:29.09,jp,NTP,0000,0000,0000,,Біздің Кусакабе отбасы – ұрпақтар бойы ел мен халықты қорғап келген Онмиодзи отбасыларының бірі.
Dialogue: 0,0:10:30.27,0:10:34.41,jp,NTP,0000,0000,0000,,Сондықтан мен өзімнің онмиодзи болатыныма күмәнданбадым.
Dialogue: 0,0:10:34.93,0:10:37.75,jp,NTP,0000,0000,0000,,Ал мен күшті болғым келді.
Dialogue: 0,0:10:46.37,0:10:47.23,jp,NTP,0000,0000,0000,,Қол пломбасы
Dialogue: 0,0:10:47.57,0:10:48.20,jp,NTP,0000,0000,0000,,Қол мөрі?
Dialogue: 0,0:10:48.56,0:10:52.96,jp,NTP,0000,0000,0000,,Құсақабе әулетінің барлық құнды қылыштары менде.
Dialogue: 0,0:10:53.79,0:10:56.78,jp,NTP,0000,0000,0000,,Ол күшке қарсы күшті сиқырлы семсер болғандықтан, қарапайымды жауып тастайды.
Dialogue: 0,0:10:57.09,0:10:59.43,jp,NTP,0000,0000,0000,,Мен оны қажет кезде шақыруға тырысамын.
Dialogue: 0,0:11:09.25,0:11:12.19,jp,NTP,0000,0000,0000,,Когарасума Аспан Хиромицу Кашакири
Dialogue: 0,0:11:12.57,0:11:15.81,jp,NTP,0000,0000,0000,,Ұшақпен кесу Нагамицу Тачибана жолындағы қар күркіреуін кесу
Dialogue: 0,0:11:16.25,0:11:18.78,jp,NTP,0000,0000,0000,,Және Ясуцуна Дожикири
Dialogue: 0,0:11:19.75,0:11:21.72,jp,NTP,0000,0000,0000,,Кусакабе отбасы, діни қызметкерлер мен онмиодзи,
Dialogue: 0,0:11:22.10,0:11:24.55,jp,NTP,0000,0000,0000,,Құдіретті адамға асыл қылышты тапсыру
Dialogue: 0,0:11:25.03,0:11:27.76,jp,NTP,0000,0000,0000,,Қандас туыстар арасындағы байсалды кездесу
Dialogue: 0,0:11:28.12,0:11:30.27,jp,NTP,0000,0000,0000,,Жеңімпазға семсерді бір сермеу
Dialogue: 0,0:11:30.29,0:11:31.25,jp,NTP,0000,0000,0000,,Мен оны саған сеніп тапсырдым.
Dialogue: 0,0:11:31.92,0:11:34.10,jp,NTP,0000,0000,0000,,Бұл жерде бесінші сынып бар деген сөз.
Dialogue: 0,0:11:34.21,0:11:36.98,jp,NTP,0000,0000,0000,,Сіздің үлкендеріңіз бәрін жеңді. Бұл керемет.
Dialogue: 0,0:11:37.59,0:11:40.85,jp,NTP,0000,0000,0000,,Бастапқыда билікті орталықтандыруды болдырмау үшін
Dialogue: 0,0:11:41.15,0:11:44.58,jp,NTP,0000,0000,0000,,Бір адамға бір тербелу деген үнсіз келісім бар.
Dialogue: 0,0:11:45.26,0:11:47.64,jp,NTP,0000,0000,0000,,Оған көмектесу мүмкін емес, себебі бұл заңды сәйкестік нәтижесі.
Dialogue: 0,0:11:48.23,0:11:52.15,jp,NTP,0000,0000,0000,,Міне, сондықтан мен туған жерімнен кетуге тура келді.
Dialogue: 0,0:11:52.31,0:11:52.93,jp,NTP,0000,0000,0000,,Қалалық
Dialogue: 0,0:11:53.36,0:11:54.50,jp,NTP,0000,0000,0000,,Сонда бұл үй
Dialogue: 0,0:11:55.07,0:11:56.27,jp,NTP,0000,0000,0000,,Бұл менің анамның вилласы.
Dialogue: 0,0:11:56.81,0:11:59.06,jp,NTP,0000,0000,0000,,Өйткені мені негізгі отбасының адамдары өлтірмекші.
Dialogue: 0,0:11:59.82,0:12:02.92,jp,NTP,0000,0000,0000,,Туыстарынан бөлініп, осылай жалғыз тұрады
Dialogue: 0,0:12:03.45,0:12:05.26,jp,NTP,0000,0000,0000,,Сіздің өміріңіз мақсатқа сай ма?
Dialogue: 0,0:12:05.52,0:12:09.27,jp,NTP,0000,0000,0000,,Неліктен? Сіз семсерді заңды матчта алдыңыз деп ойлаймын.
Dialogue: 0,0:12:09.99,0:12:11.34,jp,NTP,0000,0000,0000,,Құсақабе – атақты отбасы.
Dialogue: 0,0:12:11.96,0:12:14.03,jp,NTP,0000,0000,0000,,Атақты әулеттен шыққандықтан, жүзін құрметтейді.
Dialogue: 0,0:12:14.79,0:12:20.00,jp,NTP,0000,0000,0000,,Жас әйелдің барлық асыл қылыштарымен туылуы үшін.
Dialogue: 0,0:12:20.35,0:12:22.28,jp,NTP,0000,0000,0000,,Мен сіздің үлкендеріңізге де қызық болмайтынына сенімдімін.
Dialogue: 0,0:12:23.43,0:12:25.99,jp,NTP,0000,0000,0000,,Ал соңғы ойында И
Dialogue: 0,0:12:32.98,0:12:34.59,jp,NTP,0000,0000,0000,,Мұның бәрі менің жеке әңгімем туралы.
Dialogue: 0,0:12:35.15,0:12:36.71,jp,NTP,0000,0000,0000,,Енді бастайық.
Dialogue: 0,0:12:38.43,0:12:38.92,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:07.95,0:13:09.18,jp,NTP,0000,0000,0000,,Мен ойлағаннан да ауыр шығар.
Dialogue: 0,0:13:10.04,0:13:10.50,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:11.59,0:13:12.37,jp,NTP,0000,0000,0000,,Байқап көріңіз және қараңыз.
Dialogue: 0,0:13:12.96,0:13:13.42,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:19.90,0:13:20.46,jp,NTP,0000,0000,0000,,Шығып бара жатырсың ба?
Dialogue: 0,0:13:20.94,0:13:21.43,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:31.48,0:13:35.89,jp,NTP,0000,0000,0000,,көремін. Какеру Сатсуки екеуің мекемеде бірге болдыңдар ма?
Dialogue: 0,0:13:36.22,0:13:36.75,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:38.81,0:13:39.55,jp,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:13:40.60,0:13:42.59,jp,NTP,0000,0000,0000,,Түнде қара айды көре алмайсың
Dialogue: 0,0:13:45.22,0:13:46.88,jp,NTP,0000,0000,0000,,Қалай ойлайсың, Какеру?
Dialogue: 0,0:13:47.63,0:13:49.14,jp,NTP,0000,0000,0000,,Менде қылыш өнері жоқ.
Dialogue: 0,0:13:51.02,0:13:53.31,jp,NTP,0000,0000,0000,,Бірақ бұл ештеңе істемегеннен жақсы.
Dialogue: 0,0:13:54.16,0:13:56.80,jp,NTP,0000,0000,0000,,Сіздің күшіңіз оянады ма?
Dialogue: 0,0:13:58.29,0:14:01.23,jp,NTP,0000,0000,0000,,Сәті түсіп жатса, жауап ретінде қалдырамын.
Dialogue: 0,0:14:10.56,0:14:11.92,jp,NTP,0000,0000,0000,,Соңғы матч
Dialogue: 0,0:14:13.21,0:14:15.27,jp,NTP,0000,0000,0000,,Сіз бұрын айтқан сөзіңізді тоқтаттыңыз, солай ма?
Dialogue: 0,0:14:15.73,0:14:16.84,jp,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:14:19.25,0:14:21.83,jp,NTP,0000,0000,0000,,Сіз сөйлескіңіз келмегендіктен тоқтадыңыз.
Dialogue: 0,0:14:22.56,0:14:23.26,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:14:24.90,0:14:25.86,jp,NTP,0000,0000,0000,,Менің әкемді кесіңіз
Dialogue: 0,0:14:27.47,0:14:31.33,jp,NTP,0000,0000,0000,,Доджи Кири Ясуцунаның соңғы құнды қылыш үшін матчта
Dialogue: 0,0:14:31.98,0:14:35.22,jp,NTP,0000,0000,0000,,Құсақабе руының басшысы әкемді өлтірдім.
Dialogue: 0,0:14:36.70,0:14:38.09,jp,NTP,0000,0000,0000,,Бұл заңды сәйкестік болса да
Dialogue: 0,0:14:38.95,0:14:40.81,jp,NTP,0000,0000,0000,,Шәкірттерім мені кешірмейді
Dialogue: 0,0:14:41.84,0:14:42.81,jp,NTP,0000,0000,0000,,Аға
Dialogue: 0,0:14:43.81,0:14:45.53,jp,NTP,0000,0000,0000,,Ол әкесімен араздасып қалды.
Dialogue: 0,0:14:46.16,0:14:50.73,jp,NTP,0000,0000,0000,,Әкем менің бір адамға сүйсінгенім ұнамады.
Dialogue: 0,0:14:51.13,0:14:52.19,jp,NTP,0000,0000,0000,,Адам
Dialogue: 0,0:14:53.65,0:14:57.52,jp,NTP,0000,0000,0000,,Мисао Кусакабе Әйел онмиодзи ең күшті деп айтты.
Dialogue: 0,0:14:58.30,0:15:01.52,jp,NTP,0000,0000,0000,,Алайда ол тыйымды бұзып, Құсақабе руынан шығарылды.
Dialogue: 0,0:15:01.94,0:15:03.08,jp,NTP,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,0:15:04.02,0:15:05.45,jp,NTP,0000,0000,0000,,Шетелдік құқық қолданушысы болды.
Dialogue: 0,0:15:06.28,0:15:07.08,jp,NTP,0000,0000,0000,,Шетел құқығы
Dialogue: 0,0:15:08.12,0:15:14.77,jp,NTP,0000,0000,0000,,Бұл әдіс эзотерикалық буддизмнің және тіпті батыс магиясының әдістерін біріктіретін Кусакабе стилінен ауытқу болып табылады.
Dialogue: 0,0:15:15.65,0:15:16.34,jp,NTP,0000,0000,0000,,Айтпақшы
Dialogue: 0,0:15:17.29,0:15:18.76,jp,NTP,0000,0000,0000,,Бұл да шетел құқығының бір түрі
Dialogue: 0,0:15:20.02,0:15:22.04,jp,NTP,0000,0000,0000,,Енді манипуляция жасайтын уақыт
Dialogue: 0,0:15:22.86,0:15:24.89,jp,NTP,0000,0000,0000,,Ол жетпіс жыл бұрын діннен шығарылған.
Dialogue: 0,0:15:25.87,0:15:27.20,jp,NTP,0000,0000,0000,,Олай болса
Dialogue: 0,0:15:28.22,0:15:28.62,jp,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:15:30.04,0:15:30.88,jp,NTP,0000,0000,0000,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:15:34.32,0:15:37.23,jp,NTP,0000,0000,0000,,Мүмкін сол жерде кездесерміз
Dialogue: 0,0:15:38.01,0:15:40.03,jp,NTP,0000,0000,0000,,Мына жақта қызыл түн бе?
Dialogue: 0,0:15:41.50,0:15:42.21,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:15:45.81,0:15:46.47,jp,NTP,0000,0000,0000,,Бұл мүмкін болды ма?
Dialogue: 0,0:15:49.78,0:15:52.07,jp,NTP,0000,0000,0000,,Қолымнан келгенше істеймін. Қайтып келу.
Dialogue: 0,0:15:52.26,0:15:54.33,jp,NTP,0000,0000,0000,,Мұны істеудің қажеті жоқ.
Dialogue: 0,0:15:55.56,0:15:56.83,jp,NTP,0000,0000,0000,,Маған тәжірибе жүзінде айтып беріңізші
Dialogue: 0,0:15:57.35,0:15:58.85,jp,NTP,0000,0000,0000,,Жоқ, әлі ерте.
Dialogue: 0,0:15:59.18,0:16:00.70,jp,NTP,0000,0000,0000,,Маған тезірек хабарлаңыз.
Dialogue: 0,0:16:01.27,0:16:02.20,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:16:02.75,0:16:03.81,jp,NTP,0000,0000,0000,,Менің уақытым жоқ
Dialogue: 0,0:16:04.36,0:16:06.33,jp,NTP,0000,0000,0000,,Мен мұны істеп жатқанда,
Dialogue: 0,0:16:06.84,0:16:07.51,jp,NTP,0000,0000,0000,,Артқа оралу
Dialogue: 0,0:16:07.73,0:16:09.30,jp,NTP,0000,0000,0000,,Құсақабе-сенпай, И
Dialogue: 0,0:16:26.02,0:16:26.67,jp,NTP,0000,0000,0000,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:16:27.30,0:16:29.56,jp,NTP,0000,0000,0000,,Көздің Иесі оянады.
Dialogue: 0,0:16:30.11,0:16:32.16,jp,NTP,0000,0000,0000,,Фрагменттерді жоюға басымдық беріңіз
Dialogue: 0,0:16:32.65,0:16:33.29,jp,NTP,0000,0000,0000,,Растау
Dialogue: 0,0:16:33.77,0:16:35.03,jp,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,0:16:42.37,0:16:45.97,jp,NTP,0000,0000,0000,,Сізден тағы біраз уақыт ұйықтау сұралады.
Dialogue: 0,0:16:46.47,0:16:50.72,jp,NTP,0000,0000,0000,,70 жыл, мүмкін бұл жолы 100 жыл.
Dialogue: 0,0:16:51.01,0:16:52.56,jp,NTP,0000,0000,0000,,Қапқан бақсы
Dialogue: 0,0:16:52.90,0:16:54.97,jp,NTP,0000,0000,0000,,Мен оны қаламаймын, мені шығарыңызшы.
Dialogue: 0,0:16:55.37,0:16:58.93,jp,NTP,0000,0000,0000,,Байғұс, өлсем ғой.
Dialogue: 0,0:17:03.32,0:17:04.28,jp,NTP,0000,0000,0000,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:17:07.35,0:17:07.89,jp,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:17:08.53,0:17:09.14,jp,NTP,0000,0000,0000,,Жарайды, келіңіз.
Dialogue: 0,0:17:18.00,0:17:20.29,jp,NTP,0000,0000,0000,,Бір кішкентай шабақтарды жеңіп алмаңыз.
Dialogue: 0,0:17:23.07,0:17:23.68,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:17:40.71,0:17:41.42,jp,NTP,0000,0000,0000,,Қара рыцарь
Dialogue: 0,0:17:42.31,0:17:44.36,jp,NTP,0000,0000,0000,,Жақсы көрінеді.
Dialogue: 0,0:17:44.64,0:17:46.99,jp,NTP,0000,0000,0000,,Бұл, әрине, мені оятады.
Dialogue: 0,0:17:49.51,0:17:52.45,jp,NTP,0000,0000,0000,,Біреуді осылай қорғау сізді тек ұстап қалады.
Dialogue: 0,0:17:52.88,0:17:53.99,jp,NTP,0000,0000,0000,,Ерте өлгің келе ме?
Dialogue: 0,0:17:54.40,0:17:55.39,jp,NTP,0000,0000,0000,,Менің өлгім келмейді
Dialogue: 0,0:17:56.92,0:18:01.99,jp,NTP,0000,0000,0000,,Сіз адам өмірінен бас тартқан бізден де аянышты, күлкілісіз.
Dialogue: 0,0:18:02.06,0:18:06.11,jp,NTP,0000,0000,0000,,Адам денесі? Сендер бастапқыда адам болдыңдар.
Dialogue: 0,0:18:06.20,0:18:07.24,jp,NTP,0000,0000,0000,,Егер солай болса
Dialogue: 0,0:18:07.77,0:18:09.26,jp,NTP,0000,0000,0000,,Неліктен олай көрінесің?
Dialogue: 0,0:18:11.14,0:18:13.61,jp,NTP,0000,0000,0000,,Бұл үзінді сияқты сөйлесу туралы емес.
Dialogue: 0,0:18:14.64,0:18:15.02,jp,NTP,0000,0000,0000,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:18:15.39,0:18:16.26,jp,NTP,0000,0000,0000,,Тіпті менің ағам
Dialogue: 0,0:18:16.53,0:18:18.05,jp,NTP,0000,0000,0000,,Қажетсіз төбелесуге тырыспаңыз
Dialogue: 0,0:18:18.62,0:18:21.24,jp,NTP,0000,0000,0000,,Юка Минасені қорғағыңыз келсе, қазір қашыңыз.
Dialogue: 0,0:18:22.27,0:18:23.71,jp,NTP,0000,0000,0000,,Өл
Dialogue: 0,0:18:24.00,0:18:24.65,jp,NTP,0000,0000,0000,,Уууууууу!!
Dialogue: 0,0:18:27.84,0:18:29.09,jp,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:18:34.11,0:18:34.61,jp,NTP,0000,0000,0000,,Босатпаңыз
Dialogue: 0,0:18:38.72,0:18:41.19,jp,NTP,0000,0000,0000,,Юка Какерудан қашу
Dialogue: 0,0:18:54.14,0:18:54.81,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:18:54.89,0:18:56.66,jp,NTP,0000,0000,0000,,Артқа қарама, жүгір
Dialogue: 0,0:19:04.67,0:19:05.62,jp,NTP,0000,0000,0000,,Жасырын ба?
Dialogue: 0,0:19:08.97,0:19:09.55,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:20:15.61,0:20:17.22,jp,NTP,0000,0000,0000,,Жарайды, мен кеттім.
Dialogue: 0,0:20:19.69,0:20:20.27,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:20:25.69,0:20:26.37,jp,NTP,0000,0000,0000,,Ақымақ
Dialogue: 0,0:20:26.44,0:20:26.95,jp,NTP,0000,0000,0000,,Жақсы емес
Dialogue: 0,0:20:27.58,0:20:29.72,jp,NTP,0000,0000,0000,,Мен сені тартқанша қаш.
Dialogue: 0,0:20:29.73,0:20:33.16,jp,NTP,0000,0000,0000,,Сізді өлтіреді. Каку-кунның да қолынан келмейді. Ол өледі.
Dialogue: 0,0:20:50.84,0:20:52.42,jp,NTP,0000,0000,0000,,Мен сені осылай жаншып аламын
Dialogue: 0,0:21:09.14,0:21:11.16,jp,NTP,0000,0000,0000,,Кітаптардың кез келген саны үшін бірдей нәрсе
Dialogue: 0,0:21:21.28,0:21:24.07,jp,NTP,0000,0000,0000,,Өшіру, үзінділер.
Dialogue: 0,0:21:44.99,0:21:46.97,jp,NTP,0000,0000,0000,,Маған көмектескеніңіз үшін рахмет
Dialogue: 0,0:21:52.14,0:21:54.37,jp,NTP,0000,0000,0000,,Мен гламурды қалдырдым.
Dialogue: 0,0:21:54.79,0:21:56.94,jp,NTP,0000,0000,0000,,Мүмкін сол онмиодзи.
Dialogue: 0,0:21:57.68,0:21:58.61,jp,NTP,0000,0000,0000,,Аня Форджер
Dialogue: 0,0:22:25.69,0:22:28.17,jp,NTP,0000,0000,0000,,Кикури-ни-сан
Dialogue: 0,0:24:19.89,0:24:20.37,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:24:20.80,0:24:21.59,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:24:22.62,0:24:24.77,jp,NTP,0000,0000,0000,,Ал, мен қайтып келдім.
Dialogue: 0,0:24:28.14,0:24:29.16,jp,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:24:30.91,0:24:31.55,jp,NTP,0000,0000,0000,,Гомен
Dialogue: 0,0:24:35.35,0:24:36.17,jp,NTP,0000,0000,0000,,Мен байқадым.
Dialogue: 0,0:24:36.87,0:24:40.10,jp,NTP,0000,0000,0000,,Құсақабе-сенпай, уайымдағаныңыз үшін кешіріңіз.
Dialogue: 0,0:24:40.88,0:24:42.00,jp,NTP,0000,0000,0000,,Аман-есен болғаныңызға қуаныштымын.
Dialogue: 0,0:24:44.21,0:24:46.62,jp,NTP,0000,0000,0000,,Сатсуки-кун мен Юка-кунды таныстыру
Dialogue: 0,0:24:46.93,0:24:47.95,jp,NTP,0000,0000,0000,,Жаңа дос
Dialogue: 0,0:25:01.78,0:25:03.97,jp,NTP,0000,0000,0000,,Келесі жолы маскалы күлімсіреу
Dialogue: 0,0:25:04.95,0:25:08.21,jp,NTP,0000,0000,0000,,Қорқыныштың соңында жауап бар ма?
