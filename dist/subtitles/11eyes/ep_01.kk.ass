Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:09.79,0:01:14.50,jp,NTP,0000,0000,0000,,Бұрмаланған оянуда
Dialogue: 0,0:01:14.68,0:01:19.18,jp,NTP,0000,0000,0000,,Қызыл түн оянғанда
Dialogue: 0,0:01:19.46,0:01:23.98,jp,NTP,0000,0000,0000,,Қараңғы қараңғылық және анау
Dialogue: 0,0:01:24.23,0:01:28.76,jp,NTP,0000,0000,0000,,Мен ай сәулесінен қорықтым
Dialogue: 0,0:01:29.09,0:01:33.52,jp,NTP,0000,0000,0000,,Жалындар мені орап жатыр
Dialogue: 0,0:01:33.75,0:01:38.58,jp,NTP,0000,0000,0000,,Бәрін өртеп жіберсем де
Dialogue: 0,0:01:39.03,0:01:43.03,jp,NTP,0000,0000,0000,,Тек дұға етуді жалғастырыңыз
Dialogue: 0,0:01:43.13,0:01:49.12,jp,NTP,0000,0000,0000,,«Ертеңге» досымен алмасты
Dialogue: 0,0:01:49.77,0:01:55.32,jp,NTP,0000,0000,0000,,Толып жатқан көз жасы бүкіл сарайда жаңғырық
Dialogue: 0,0:01:55.48,0:01:59.79,jp,NTP,0000,0000,0000,,Ұмыту семсеріне
Dialogue: 0,0:01:59.89,0:02:04.87,jp,NTP,0000,0000,0000,,Мұңға батқан жан
Dialogue: 0,0:02:05.02,0:02:09.35,jp,NTP,0000,0000,0000,,Қалқымалы жарық
Dialogue: 0,0:02:09.47,0:02:13.89,jp,NTP,0000,0000,0000,,Аспанды қиып ал
Dialogue: 0,0:02:14.06,0:02:21.71,jp,NTP,0000,0000,0000,,Бұл дүниеде үмітті құшақтайық
Dialogue: 0,0:00:00.00,0:00:00.00,jp,NTP,0000,0000,0000,,--------OP-----------
Dialogue: 0,0:00:06.08,0:00:07.64,jp,NTP,0000,0000,0000,,Кешіріңіз, Какеру.
Dialogue: 0,0:00:24.49,0:00:26.97,jp,NTP,0000,0000,0000,,Мұны істеудің жалғыз жолы
Dialogue: 0,0:00:27.35,0:00:28.97,jp,NTP,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:00:41.92,0:00:43.78,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:00:51.46,0:00:53.68,jp,NTP,0000,0000,0000,,Мен оны жек көремін!
Dialogue: 0,0:03:34.87,0:03:35.63,jp,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:03:36.78,0:03:39.50,jp,NTP,0000,0000,0000,,Сіз ол адаммен кездесуге болады дейсіз бе?
Dialogue: 0,0:04:06.86,0:04:09.31,jp,NTP,0000,0000,0000,,Жел соншалықты қатты, Маған енді ұнамайды.
Dialogue: 0,0:04:09.56,0:04:10.12,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:04:11.53,0:04:14.30,jp,NTP,0000,0000,0000,,Ол жоғалып кеткеннен бері мен оны іздедім, Кәкеру.
Dialogue: 0,0:04:14.69,0:04:16.49,jp,NTP,0000,0000,0000,,Мен бірінші үйге бармағаныма қуаныштымын.
Dialogue: 0,0:04:20.41,0:04:21.45,jp,NTP,0000,0000,0000,,Сіз не қарап тұрсыз?
Dialogue: 0,0:04:26.01,0:04:26.64,jp,NTP,0000,0000,0000,,Бұлттар?
Dialogue: 0,0:04:27.28,0:04:27.80,jp,NTP,0000,0000,0000,,Ай
Dialogue: 0,0:04:28.17,0:04:29.60,jp,NTP,0000,0000,0000,,Ай? қайда?
Dialogue: 0,0:04:32.01,0:04:32.71,jp,NTP,0000,0000,0000,,Бұл рас
Dialogue: 0,0:04:34.60,0:04:35.70,jp,NTP,0000,0000,0000,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:04:42.71,0:04:43.26,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:04:48.36,0:04:51.92,jp,NTP,0000,0000,0000,,Жеті жыл бұрын апам өз өмірін қиды.
Dialogue: 0,0:04:53.09,0:04:56.85,jp,NTP,0000,0000,0000,,Мекемеде өскен әпкем менің жалғыз отбасым болды.
Dialogue: 0,0:04:57.69,0:05:01.72,jp,NTP,0000,0000,0000,,Сол себепті мен бұл оқиғаны қабылдай алмай, жүрегімді жауып тастадым.
Dialogue: 0,0:05:02.93,0:05:08.43,jp,NTP,0000,0000,0000,,Менімен бір мекемеден келген Юка ғана маған күлімдеп қарайтын.
Dialogue: 0,0:05:09.06,0:05:11.03,jp,NTP,0000,0000,0000,,Қасымда болып, күлдірді.
Dialogue: 0,0:05:13.38,0:05:16.26,jp,NTP,0000,0000,0000,,Юка болмағанда менімен не болар еді?
Dialogue: 0,0:05:18.79,0:05:20.18,jp,NTP,0000,0000,0000,,Не болды, Какеру?
Dialogue: 0,0:05:23.03,0:05:24.78,jp,NTP,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:05:26.16,0:05:27.04,jp,NTP,0000,0000,0000,,Үйге қайтайық?
Dialogue: 0,0:05:33.96,0:05:36.17,jp,NTP,0000,0000,0000,,Бірақ мен
Dialogue: 0,0:05:49.32,0:05:50.34,jp,NTP,0000,0000,0000,,Каку
Dialogue: 0,0:05:50.60,0:05:51.36,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:05:52.29,0:05:54.01,jp,NTP,0000,0000,0000,,Каори-чан Тадаши-кун
Dialogue: 0,0:05:54.84,0:05:56.69,jp,NTP,0000,0000,0000,,Сен таптың, Какеру-кун.
Dialogue: 0,0:05:57.43,0:05:59.02,jp,NTP,0000,0000,0000,,Мен төбеде айды бақылап отырдым
Dialogue: 0,0:06:00.04,0:06:00.69,jp,NTP,0000,0000,0000,,Ай?
Dialogue: 0,0:06:01.04,0:06:03.70,jp,NTP,0000,0000,0000,,Осы уақытқа дейін екеуің төбеде жалғыз болдыңдар ма?
Dialogue: 0,0:06:04.99,0:06:05.54,jp,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:06:05.94,0:06:07.18,jp,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:07.27,0:06:08.62,jp,NTP,0000,0000,0000,,Не? бөлек
Dialogue: 0,0:06:09.29,0:06:13.23,jp,NTP,0000,0000,0000,,Бұл таңғаларлық оқиға емес пе, Какеру мырза?
Dialogue: 0,0:06:13.50,0:06:16.89,jp,NTP,0000,0000,0000,,Олай десеңіз, маған фото жіберуіңіз керек. . Фото пошта!
Dialogue: 0,0:06:18.21,0:06:20.41,jp,NTP,0000,0000,0000,,Сенде қандай оғаш адасушылықтар бар, ақымақ?
Dialogue: 0,0:06:21.10,0:06:21.79,jp,NTP,0000,0000,0000,,Такаши
Dialogue: 0,0:06:22.23,0:06:24.19,jp,NTP,0000,0000,0000,,Каори-чан, сен тым көп істеп жатырсың.
Dialogue: 0,0:06:26.72,0:06:30.08,jp,NTP,0000,0000,0000,,Сіз мені байсалды етіп жіберген сияқтысыз.
Dialogue: 0,0:06:30.16,0:06:34.59,jp,NTP,0000,0000,0000,,Ішімдегі нағыз мені ояттың.
Dialogue: 0,0:06:34.95,0:06:36.48,jp,NTP,0000,0000,0000,,Мен оны қазір тоқтата алмаймын
Dialogue: 0,0:06:37.42,0:06:38.84,jp,NTP,0000,0000,0000,,Сені айтпа
Dialogue: 0,0:06:41.70,0:06:43.32,jp,NTP,0000,0000,0000,,Цу…күшті
Dialogue: 0,0:06:43.79,0:06:46.36,jp,NTP,0000,0000,0000,,Құрметті мырза, аңыз не дейді...
Dialogue: 0,0:06:46.36,0:06:48.82,jp,NTP,0000,0000,0000,,Мен Юкадан басқа ешкіммен сөйлеспеймін.
Dialogue: 0,0:06:49.07,0:06:52.14,jp,NTP,0000,0000,0000,,Мені тек Тадаши мен Каори ғана шақырды.
Dialogue: 0,0:06:52.93,0:06:56.90,jp,NTP,0000,0000,0000,,Екі көңілді адаммен бірге болу, әрине, сізді тыныштандырады.
Dialogue: 0,0:07:01.69,0:07:02.41,jp,NTP,0000,0000,0000,,Сатылым?
Dialogue: 0,0:07:02.47,0:07:02.73,jp,NTP,0000,0000,0000,,Иә, бүгін және ертең Аянаста екі күн.
Dialogue: 0,0:07:03.32,0:07:07.22,*Default,NTP,0000,0000,0000,,Оларда сауда нүктесі бар.
Dialogue: 0,0:07:08.09,0:07:08.98,jp,NTP,0000,0000,0000,,Аянаста
Dialogue: 0,0:07:09.69,0:07:11.07,jp,NTP,0000,0000,0000,,Қандай розетка?
Dialogue: 0,0:07:11.44,0:07:14.33,jp,NTP,0000,0000,0000,,Киім-кешек, әр түрлі заттар сияқты әртүрлі заттар.
Dialogue: 0,0:07:14.44,0:07:16.80,jp,NTP,0000,0000,0000,,Кішкене гравюралық фотокітап немесе бір нәрсе
Dialogue: 0,0:07:18.93,0:07:20.53,jp,NTP,0000,0000,0000,,Қарғыс атсын, Эро Тадаши.
Dialogue: 0,0:07:21.89,0:07:24.60,jp,NTP,0000,0000,0000,,Эй, біз қазір кетеміз, бізбен бірге келер ме едің?
Dialogue: 0,0:07:25.01,0:07:26.64,jp,NTP,0000,0000,0000,,Шынымен бе? Көңілді сияқты
Dialogue: 0,0:07:29.20,0:07:32.10,jp,NTP,0000,0000,0000,,Жоқ, мен көп адамдарды ұнатпаймын.
Dialogue: 0,0:07:33.05,0:07:35.76,jp,NTP,0000,0000,0000,,Келіңіздер, мен бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:07:37.92,0:07:39.96,jp,NTP,0000,0000,0000,,Кешіріңіз, келесі жолы қайталаймын.
Dialogue: 0,0:07:44.11,0:07:48.17,jp,NTP,0000,0000,0000,,Юканы Мінәсекең бастауыш сыныпқа барған кезде қабылдады.
Dialogue: 0,0:07:48.97,0:07:52.98,jp,NTP,0000,0000,0000,,Баласы жоқ Минас жұбы Юканы жылы қарсы алды.
Dialogue: 0,0:07:53.46,0:07:54.79,jp,NTP,0000,0000,0000,,Сіз, Басшының орынбасары, қазір тергеу штабында қанша адам қалғанын білесіз ғой.
Dialogue: 0,0:08:05.54,0:08:06.13,jp,NTP,0000,0000,0000,,Джейн
Dialogue: 0,0:08:14.54,0:08:15.02,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:08:16.73,0:08:18.35,jp,NTP,0000,0000,0000,,Баруым керек пе?
Dialogue: 0,0:08:19.90,0:08:20.82,jp,NTP,0000,0000,0000,,Аянас
Dialogue: 0,0:08:33.93,0:08:34.62,jp,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:08:35.67,0:08:37.09,jp,NTP,0000,0000,0000,,Себебі мен бақыттымын.
Dialogue: 0,0:08:39.43,0:08:40.05,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:09:49.51,0:09:51.90,jp,NTP,0000,0000,0000,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:09:52.70,0:09:54.52,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:09:59.48,0:10:01.17,jp,NTP,0000,0000,0000,,Қара ай?
Dialogue: 0,0:10:14.48,0:10:15.58,jp,NTP,0000,0000,0000,,Хокс та керемет болды.
Dialogue: 0,0:10:16.74,0:10:18.96,jp,NTP,0000,0000,0000,,Какеру-кун, не болып жатыр? Эй
Dialogue: 0,0:10:20.15,0:10:21.77,jp,NTP,0000,0000,0000,,Маған да не болды?
Dialogue: 0,0:10:22.57,0:10:26.02,jp,NTP,0000,0000,0000,,Онда ешкім жоқ, бәрі бір жерге кетіп қалды
Dialogue: 0,0:10:27.05,0:10:28.57,jp,NTP,0000,0000,0000,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:10:34.58,0:10:35.12,jp,NTP,0000,0000,0000,,Мұнда емес.
Dialogue: 0,0:10:37.45,0:10:37.96,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:10:49.79,0:10:50.58,jp,NTP,0000,0000,0000,,Онда не бар?
Dialogue: 0,0:10:52.08,0:10:52.58,jp,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,0:10:58.38,0:10:59.12,jp,NTP,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:11:02.92,0:11:04.84,jp,NTP,0000,0000,0000,,Иә, мектепке барайық.
Dialogue: 0,0:11:05.29,0:11:05.89,jp,NTP,0000,0000,0000,,Бірақ бұл өте шынайы емес.
Dialogue: 0,0:11:06.37,0:11:08.47,jp,NTP,0000,0000,0000,,Мүмкін біреу бар шығар
Dialogue: 0,0:11:12.18,0:11:13.69,jp,NTP,0000,0000,0000,,Бұл не...?
Dialogue: 0,0:11:17.70,0:11:18.26,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:11:21.62,0:11:22.13,jp,NTP,0000,0000,0000,,Кенеттен татами төсегі жарылып кетті.
Dialogue: 0,0:11:34.19,0:11:36.60,jp,NTP,0000,0000,0000,,Мен оны жек көремін!
Dialogue: 0,0:11:59.65,0:12:01.03,jp,NTP,0000,0000,0000,,Қайтып келдіңіз бе?
Dialogue: 0,0:00:03.90,0:00:03.90,jp,NTP,0000,0000,0000,,----------Орташа---------
Dialogue: 0,0:12:36.68,0:12:38.55,jp,NTP,0000,0000,0000,,Амансың ба? Какеру-кун
Dialogue: 0,0:12:39.62,0:12:40.32,jp,NTP,0000,0000,0000,,Юка?
Dialogue: 0,0:12:42.61,0:12:44.22,jp,NTP,0000,0000,0000,,Сіз жаман түс көрдіңіз.
Dialogue: 0,0:12:45.46,0:12:46.97,jp,NTP,0000,0000,0000,,Бірақ неге юка?
Dialogue: 0,0:12:47.29,0:12:49.21,jp,NTP,0000,0000,0000,,Мен сені алып кетуге келгенде есік ашық болды.
Dialogue: 0,0:12:49.79,0:12:52.44,jp,NTP,0000,0000,0000,,Мен не болды деп жоғарыға көтерілдім.
Dialogue: 0,0:12:52.91,0:12:53.68,jp,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:12:54.28,0:12:56.65,jp,NTP,0000,0000,0000,,Кеше үйге келсем, ессіз қалдым.
Dialogue: 0,0:12:57.35,0:12:59.22,jp,NTP,0000,0000,0000,,Юка жақсы ма?
Dialogue: 0,0:12:59.61,0:13:01.33,jp,NTP,0000,0000,0000,,Мен кеше түнде ұйықтай алмадым
Dialogue: 0,0:13:01.65,0:13:02.35,jp,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:13:02.53,0:13:07.24,jp,NTP,0000,0000,0000,,Көзімді жұмуға қорқамын, қатты қорқамын
Dialogue: 0,0:13:08.03,0:13:08.84,jp,NTP,0000,0000,0000,,О, мен де.
Dialogue: 0,0:13:10.18,0:13:12.08,jp,NTP,0000,0000,0000,,Мен де ұйықтай алмадым
Dialogue: 0,0:13:15.31,0:13:17.51,jp,NTP,0000,0000,0000,,Мен ұйықтаған жоқпын, солай ма?
Dialogue: 0,0:13:18.68,0:13:20.78,jp,NTP,0000,0000,0000,,Соңында
Dialogue: 0,0:13:34.45,0:13:35.62,jp,NTP,0000,0000,0000,,Есіңде ме?
Dialogue: 0,0:13:38.24,0:13:39.38,jp,NTP,0000,0000,0000,,Күте тұрыңыз
Dialogue: 0,0:13:52.62,0:13:53.19,jp,NTP,0000,0000,0000,,Юка?
Dialogue: 0,0:13:57.31,0:13:59.25,jp,NTP,0000,0000,0000,,Бұл қайталана ма?
Dialogue: 0,0:14:01.22,0:14:03.47,jp,NTP,0000,0000,0000,,Сол қызыл түн
Dialogue: 0,0:14:11.48,0:14:12.51,jp,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:14:12.94,0:14:16.02,jp,NTP,0000,0000,0000,,Сен мектепке достық кездесуге барасың ба?
Dialogue: 0,0:14:16.02,0:14:18.03,jp,NTP,0000,0000,0000,,Мен қажетсіз ештеңе айтпаймын.
Dialogue: 0,0:14:23.15,0:14:24.28,jp,NTP,0000,0000,0000,,Мен сені қорғаймын
Dialogue: 0,0:14:26.15,0:14:29.34,jp,NTP,0000,0000,0000,,Тағы бірдеңе болып қалса, мен Юканы қорғаймын.
Dialogue: 0,0:14:30.00,0:14:31.15,jp,NTP,0000,0000,0000,,Сондықтан уайымдамаңыз
Dialogue: 0,0:14:32.13,0:14:33.30,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:14:37.88,0:14:38.50,jp,NTP,0000,0000,0000,,Мен бақыттымын
Dialogue: 0,0:14:39.66,0:14:40.92,jp,NTP,0000,0000,0000,,Мен шынымен бақыттымын
Dialogue: 0,0:14:41.01,0:14:42.19,jp,NTP,0000,0000,0000,,Қазір мұнда болған оқиға полиция тарапынан жай ғана апат ретінде қарастырылады.
Dialogue: 0,0:14:42.86,0:14:45.93,jp,NTP,0000,0000,0000,,Ондай жерде жылама, сені дұрыс түсінбейді.
Dialogue: 0,0:14:47.08,0:14:48.11,jp,NTP,0000,0000,0000,,Не... жылаттым.
Dialogue: 0,0:14:48.70,0:14:50.79,jp,NTP,0000,0000,0000,,Таңертең қызды жылатып
Dialogue: 0,0:14:52.17,0:14:52.79,jp,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:14:54.24,0:14:54.96,jp,NTP,0000,0000,0000,,Гомен
Dialogue: 0,0:14:59.75,0:15:00.27,jp,NTP,0000,0000,0000,,Кірейік
Dialogue: 0,0:15:10.45,0:15:13.08,jp,NTP,0000,0000,0000,,Баршаңызға, мен ауысатын студентті таныстырғым келеді.
Dialogue: 0,0:15:13.77,0:15:15.36,jp,NTP,0000,0000,0000,,Бұл Шиори Хьякуно.
Dialogue: 0,0:15:16.35,0:15:18.29,jp,NTP,0000,0000,0000,,Ка... сүйкімді Мо
Dialogue: 0,0:15:18.76,0:15:22.20,jp,NTP,0000,0000,0000,,Момуно мырза Италиядан оралған.
Dialogue: 0,0:15:22.50,0:15:24.87,jp,NTP,0000,0000,0000,,Италия? Керемет
Dialogue: 0,0:15:25.64,0:15:28.24,jp,NTP,0000,0000,0000,,Олай болса, Хякуно мырза, сәлем беріңізші.
Dialogue: 0,0:15:29.17,0:15:30.51,jp,NTP,0000,0000,0000,,(Масато) Юджи Итадориге көз салып тұрып—
Dialogue: 0,0:15:33.22,0:15:34.86,jp,NTP,0000,0000,0000,,(Масато) Юджи Итадориге көз салып тұрып—
Dialogue: 0,0:15:50.05,0:15:50.95,jp,NTP,0000,0000,0000,,Эй, сенің хоббиің қандай?
Dialogue: 0,0:15:50.96,0:15:51.84,jp,NTP,0000,0000,0000,,Үй қай жерде?
Dialogue: 0,0:15:52.93,0:15:54.56,jp,NTP,0000,0000,0000,,Иә, иә, иә
Dialogue: 0,0:15:54.95,0:15:59.28,jp,NTP,0000,0000,0000,,Сұрақтарыңызды ретімен қойыңыз. Ең алдымен, үш өлшем.
Dialogue: 0,0:16:00.21,0:16:01.03,jp,NTP,0000,0000,0000,,Өл
Dialogue: 0,0:16:05.37,0:16:10.23,jp,NTP,0000,0000,0000,,Мені сізге қызықтырмайды, сондықтан араласпаңыз.
Dialogue: 0,0:16:12.80,0:16:13.34,jp,NTP,0000,0000,0000,,Біраз
Dialogue: 0,0:16:20.05,0:16:20.71,jp,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:16:24.18,0:16:25.54,jp,NTP,0000,0000,0000,,2-эпизод: Буггарати келеді
Dialogue: 0,0:16:29.76,0:16:30.24,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:16:31.23,0:16:31.71,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:16:37.20,0:16:40.05,jp,NTP,0000,0000,0000,,Какеру-кун енді жүре алады.
Dialogue: 0,0:16:40.09,0:16:40.66,jp,NTP,0000,0000,0000,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:16:41.23,0:16:44.48,jp,NTP,0000,0000,0000,,Ұйқының аздығынан болса, жарайды.
Dialogue: 0,0:16:47.77,0:16:49.02,jp,NTP,0000,0000,0000,,Бұл ұят.
Dialogue: 0,0:17:00.44,0:17:01.14,jp,NTP,0000,0000,0000,,Артқа кетіңіз
Dialogue: 0,0:17:02.50,0:17:03.68,jp,NTP,0000,0000,0000,,Бұл кедергі.
Dialogue: 0,0:17:04.54,0:17:06.35,jp,NTP,0000,0000,0000,,Сіз көрмейсіз бе? Сіз ауру адамсыз.
Dialogue: 0,0:17:06.63,0:17:07.39,jp,NTP,0000,0000,0000,,Ауру адам?
Dialogue: 0,0:17:15.55,0:17:16.25,jp,NTP,0000,0000,0000,,Сол жігіт
Dialogue: 0,0:17:16.61,0:17:17.43,jp,NTP,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:17:22.14,0:17:23.32,jp,NTP,0000,0000,0000,,Ой, ханшайым
Dialogue: 0,0:17:24.24,0:17:27.31,jp,NTP,0000,0000,0000,,Жоқ, кешіріңіз.
Dialogue: 0,0:17:35.35,0:17:37.91,jp,NTP,0000,0000,0000,,Бұл жай ғана анемия. Уайымдама.
Dialogue: 0,0:17:38.19,0:17:38.90,jp,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:17:39.27,0:17:40.89,jp,NTP,0000,0000,0000,,Сонда мен қайтып орала аламын.
Dialogue: 0,0:17:42.50,0:17:44.40,jp,NTP,0000,0000,0000,,Рахмет сізге Какеру-кун
Dialogue: 0,0:17:44.76,0:17:45.98,jp,NTP,0000,0000,0000,,Біраз ұйықтаңыз.
Dialogue: 0,0:17:46.98,0:17:49.37,jp,NTP,0000,0000,0000,,Бұл Сатсуки болатын.
Dialogue: 0,0:17:49.60,0:17:50.13,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:17:51.18,0:17:52.51,jp,NTP,0000,0000,0000,,Бұл көздерге не болды?
Dialogue: 0,0:17:55.59,0:17:57.15,jp,NTP,0000,0000,0000,,Айтқың келмесе, жарайды.
Dialogue: 0,0:17:57.83,0:17:59.41,jp,NTP,0000,0000,0000,,Бұл туа біткен.
Dialogue: 0,0:17:59.55,0:18:00.17,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:00.77,0:18:01.70,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:18:09.40,0:18:10.17,jp,NTP,0000,0000,0000,,Минас
Dialogue: 0,0:18:10.35,0:18:12.58,jp,NTP,0000,0000,0000,,Какеру, мен оң жақтан көрмеймін.
Dialogue: 0,0:18:12.84,0:18:14.87,jp,NTP,0000,0000,0000,,Сондықтан олардың көзінің түсі де әртүрлі.
Dialogue: 0,0:18:14.93,0:18:15.77,jp,NTP,0000,0000,0000,,Көз патч
Dialogue: 0,0:18:16.57,0:18:17.56,jp,NTP,0000,0000,0000,,Морио қаласы керемет орын.
Dialogue: 0,0:18:18.51,0:18:19.93,jp,NTP,0000,0000,0000,,Бұл сенің жігітің бе?
Dialogue: 0,0:18:21.01,0:18:22.39,jp,NTP,0000,0000,0000,,Мұғалім Се
Dialogue: 0,0:18:22.55,0:18:25.36,jp,NTP,0000,0000,0000,,көремін. Әлі сол кезеңде ме?
Dialogue: 0,0:18:41.92,0:18:42.78,jp,NTP,0000,0000,0000,,Яғни
Dialogue: 0,0:18:50.40,0:18:52.06,jp,NTP,0000,0000,0000,,көремін. Сіз ұйықтадыңыз ба?
Dialogue: 0,0:18:52.89,0:18:54.31,jp,NTP,0000,0000,0000,,Енді бәрі жақсы
Dialogue: 0,0:18:55.24,0:18:57.07,jp,NTP,0000,0000,0000,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:18:58.46,0:19:00.84,jp,NTP,0000,0000,0000,,Егер бұл физикалық ауыртпалық болмаса, мен барар ма едім?
Dialogue: 0,0:19:01.92,0:19:04.15,jp,NTP,0000,0000,0000,,Аянас кеше бара алмадым.
Dialogue: 0,0:19:04.79,0:19:06.77,jp,NTP,0000,0000,0000,,Бүгінгі күнге дейін сату нүктесі
Dialogue: 0,0:19:07.45,0:19:08.46,jp,NTP,0000,0000,0000,,Какеру-кун?
Dialogue: 0,0:19:18.51,0:19:22.57,jp,NTP,0000,0000,0000,,Дұрыс, анам мен әкем кейде тамақ ішу үшін сол жерде қалдырады.
Dialogue: 0,0:19:23.52,0:19:24.18,jp,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:19:24.75,0:19:26.46,jp,NTP,0000,0000,0000,,Бүгін үйге бара жатқанда тоқтайсыз ба?
Dialogue: 0,0:19:26.77,0:19:28.52,jp,NTP,0000,0000,0000,,Жоқ, келесі жолы қайталаймын.
Dialogue: 0,0:19:29.12,0:19:31.23,jp,NTP,0000,0000,0000,,Одан да, менде әрқашан бар.
Dialogue: 0,0:19:31.33,0:19:32.08,jp,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:19:34.05,0:19:34.98,jp,NTP,0000,0000,0000,,Пенцо мырза
Dialogue: 0,0:19:35.44,0:19:37.21,jp,NTP,0000,0000,0000,,Пенцо мырза?
Dialogue: 0,0:19:37.71,0:19:39.48,jp,NTP,0000,0000,0000,,Пенцо мырза керемет.
Dialogue: 0,0:19:46.26,0:19:46.79,jp,NTP,0000,0000,0000,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:19:48.85,0:19:49.78,jp,NTP,0000,0000,0000,,Бұл таңқаларлық
Dialogue: 0,0:19:49.85,0:19:50.43,jp,NTP,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:20:03.94,0:20:05.88,jp,NTP,0000,0000,0000,,Осы жерден тоқтаңыз
Dialogue: 0,0:20:47.40,0:20:48.42,jp,NTP,0000,0000,0000,,Бұл қызықты болды
Dialogue: 0,0:20:48.73,0:20:51.33,jp,NTP,0000,0000,0000,,Мен шынымен ештеңе сатып алудың қажеті жоқ па?
Dialogue: 0,0:20:51.59,0:20:52.08,jp,NTP,0000,0000,0000,,Та-да!
Dialogue: 0,0:20:52.77,0:20:55.92,jp,NTP,0000,0000,0000,,Егер сіз Какерумен бірге болсаңыз, оны көру қызық.
Dialogue: 0,0:20:57.42,0:20:58.44,jp,NTP,0000,0000,0000,,Келгеніңізге қуаныштымын
Dialogue: 0,0:20:59.22,0:21:01.97,jp,NTP,0000,0000,0000,,Мен кешегі үрей мен уайымнан әлі арыла алмаған сияқтымын.
Dialogue: 0,0:21:02.68,0:21:04.04,jp,NTP,0000,0000,0000,,Бұл күлімде өтірік жоқ
Dialogue: 0,0:21:06.25,0:21:08.09,jp,NTP,0000,0000,0000,,Сәлем Какеру-кун
Dialogue: 0,0:21:09.36,0:21:11.18,jp,NTP,0000,0000,0000,,Біз мұны істейміз бе?
Dialogue: 0,0:21:17.36,0:21:17.89,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:21:18.75,0:21:19.64,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:21:20.01,0:21:20.57,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:21:22.59,0:21:23.43,jp,NTP,0000,0000,0000,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:21:33.34,0:21:36.31,jp,NTP,0000,0000,0000,,Маған оның не болғаны маңызды емес.
Dialogue: 0,0:21:37.49,0:21:40.76,jp,NTP,0000,0000,0000,,Мен Юкариді бұдан былай ауыртқым келмейді.
Dialogue: 0,0:21:42.07,0:21:44.89,jp,NTP,0000,0000,0000,,Бұл қайталанбағанша, бұл жақсы.
Dialogue: 0,0:21:46.89,0:21:48.15,jp,NTP,0000,0000,0000,,Тыныш.
Dialogue: 0,0:21:50.38,0:21:52.06,jp,NTP,0000,0000,0000,,Мәңгі осылай қалады деп үміттенемін.
Dialogue: 0,0:22:00.24,0:22:01.81,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:22:08.78,0:22:10.60,jp,NTP,0000,0000,0000,,Кикури мырза?
Dialogue: 0,0:22:37.48,0:22:38.39,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:22:38.49,0:22:39.66,jp,NTP,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,0:22:40.22,0:22:42.08,jp,NTP,0000,0000,0000,,Менің әпкем неге істеді
Dialogue: 0,0:22:51.63,0:22:52.41,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:22:52.77,0:22:53.60,jp,NTP,0000,0000,0000,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:23:03.14,0:23:05.00,jp,NTP,0000,0000,0000,,Сол бала
Dialogue: 0,0:24:54.33,0:24:54.97,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:25:00.95,0:25:03.52,jp,NTP,0000,0000,0000,,Келесі жолы Кристал қыз
Dialogue: 0,0:25:04.29,0:25:07.29,jp,NTP,0000,0000,0000,,Қорқыныштың соңында жауап бар ма?
Dialogue: 0,0:25:08.79,0:25:14.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory