Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:27.13,0:00:29.13,Default,,0000,0000,0000,,Бұл менің соңғы өтінішім
Dialogue: 0,0:00:27.13,0:00:29.13,Default,,0000,0000,0000,,Ха ха ха ха...
Dialogue: 0,0:00:29.13,0:00:35.14,Default,,0000,0000,0000,,Ха! Ха ха ха ха ха...
Dialogue: 0,0:00:35.14,0:00:37.14,Default,,0000,0000,0000,,
Dialogue: 0,0:00:37.14,0:00:39.14,Default,,0000,0000,0000,,Такаги
Dialogue: 0,0:00:37.14,0:00:39.14,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:00:39.14,0:00:42.14,Default,,0000,0000,0000,,Мицухико
Dialogue: 0,0:00:39.14,0:00:42.14,Default,,0000,0000,0000,,Бір күні мұндай күн келеді деп ойламаппын
Dialogue: 0,0:00:39.14,0:00:42.14,Default,,0000,0000,0000,,Мен солай ойладым.
Dialogue: 0,0:00:42.14,0:00:45.15,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:00:42.14,0:00:45.15,Default,,0000,0000,0000,,Сіз мұны ақырында жасадыңыз Детектив Такаги!
Dialogue: 0,0:00:45.15,0:00:47.15,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:00:45.15,0:00:47.15,Default,,0000,0000,0000,,(Гента)
Dialogue: 0,0:00:45.15,0:00:47.15,Default,,0000,0000,0000,,Бірақ бұл кенеттен шешілді.
Dialogue: 0,0:00:47.15,0:00:50.15,Default,,0000,0000,0000,,Тікенектер
Dialogue: 0,0:00:47.15,0:00:50.15,Default,,0000,0000,0000,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:00:47.15,0:00:50.15,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:00:50.15,0:00:52.15,Default,,0000,0000,0000,,Казами
Dialogue: 0,0:00:50.15,0:00:52.15,Default,,0000,0000,0000,,Келетініңізге сенімдісіз бе?
Dialogue: 0,0:00:52.15,0:00:55.16,Default,,0000,0000,0000,,Амуро
Dialogue: 0,0:00:52.15,0:00:55.16,Default,,0000,0000,0000,,(Амуро)
Dialogue: 0,0:00:52.15,0:00:55.16,Default,,0000,0000,0000,,Бұл анонимді кеңес. Үміт аз.
Dialogue: 0,0:00:55.16,0:00:59.13,Default,,0000,0000,0000,,Фуруя
Dialogue: 0,0:00:55.16,0:00:59.13,Default,,0000,0000,0000,,Бұл жігіт, солай ма?
Dialogue: 0,0:00:55.16,0:00:59.13,Default,,0000,0000,0000,,Фуруя мырзаның синхрондау...
Dialogue: 0,0:01:01.16,0:01:03.16,Default,,0000,0000,0000,,Артық кеткені үшін кешірім сұраймыз.
Dialogue: 0,0:01:03.16,0:01:05.17,Default,,0000,0000,0000,,Мен кептеліп қалдым.
Dialogue: 0,0:01:03.16,0:01:05.17,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:01:05.17,0:01:07.17,Default,,0000,0000,0000,,Бомбаларды бір шетте білу➡️
Dialogue: 0,0:01:07.17,0:01:10.17,Default,,0000,0000,0000,,Қашуды жоспарлау
Dialogue: 0,0:01:07.17,0:01:10.17,Default,,0000,0000,0000,,Орындау мүмкіндігі➡️
Dialogue: 0,0:01:10.17,0:01:12.11,Default,,0000,0000,0000,,Менің ойымша, бұл адамда жоқ.
Dialogue: 0,0:01:12.11,0:01:15.11,Default,,0000,0000,0000,,Мен оларға мүлде қызықпаймын—
Dialogue: 0,0:01:12.11,0:01:15.11,Default,,0000,0000,0000,,…бірақ ол құламайды!
Dialogue: 0,0:01:15.11,0:01:17.11,Default,,0000,0000,0000,,(есік дыбысы)
Dialogue: 0,0:01:15.11,0:01:17.11,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:01:17.11,0:01:20.11,Default,,0000,0000,0000,,♪ (Жабық музыка)
Dialogue: 0,0:01:17.11,0:01:20.11,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:01:20.11,0:01:23.12,Default,,0000,0000,0000,,(Шапалақтау)
Dialogue: 0,0:01:23.12,0:01:27.09,Default,,0000,0000,0000,,Сато
Dialogue: 0,0:01:23.12,0:01:27.09,Default,,0000,0000,0000,,(Мицухико)
Dialogue: 0,0:01:23.12,0:01:27.09,Default,,0000,0000,0000,,Детектив Сато Бұл өте әдемі!
Dialogue: 0,0:01:30.12,0:01:32.13,Default,,0000,0000,0000,,жүгірді
Dialogue: 0,0:01:30.12,0:01:32.13,Default,,0000,0000,0000,,《Мен де, бір күні Ранмен бірге...》
Dialogue: 0,0:01:32.13,0:01:35.13,Default,,0000,0000,0000,,Иә? Не болды? Конан-кун
Dialogue: 0,0:01:35.13,0:01:37.13,Default,,0000,0000,0000,,Хе! ? А... бұл ештеңе емес.
Dialogue: 0,0:01:37.13,0:01:40.13,Default,,0000,0000,0000,,Онда
Dialogue: 0,0:01:37.13,0:01:40.13,Default,,0000,0000,0000,,Мына жырау
Dialogue: 0,0:01:37.13,0:01:40.13,Default,,0000,0000,0000,,Ол Ранның әйелі болғанын қалайды➡️
Dialogue: 0,0:01:40.13,0:01:42.14,Default,,0000,0000,0000,,Сіз ойлағаныңыз осы емес пе?
Dialogue: 0,0:01:40.13,0:01:42.14,Default,,0000,0000,0000,,Е!
Dialogue: 0,0:01:42.14,0:01:47.14,Default,,0000,0000,0000,,Жоқ! Фуфуфуфу…
Dialogue: 0,0:01:42.14,0:01:47.14,Default,,0000,0000,0000,,《Дұрыс》
Dialogue: 0,0:01:47.14,0:01:51.11,Default,,0000,0000,0000,,…   …
Dialogue: 0,0:01:53.15,0:01:57.15,Default,,0000,0000,0000,,Крест
Dialogue: 0,0:01:53.15,0:01:57.15,Default,,0000,0000,0000,,Ватару Такаги
Dialogue: 0,0:01:53.15,0:01:57.15,Default,,0000,0000,0000,,Сен өмір бойысың➡️
Dialogue: 0,0:01:57.15,0:01:59.15,Default,,0000,0000,0000,,Мивако
Dialogue: 0,0:01:57.15,0:01:59.15,Default,,0000,0000,0000,,Миваконы қорғауды жалғастырыңыз➡️
Dialogue: 0,0:01:59.15,0:02:05.16,Default,,0000,0000,0000,,Күліп жүріңіз
Dialogue: 0,0:01:59.15,0:02:05.16,Default,,0000,0000,0000,,Сіз оны бақытты етуге уәде бересіз бе?
Dialogue: 0,0:02:05.16,0:02:09.16,Default,,0000,0000,0000,,Иә, ант етемін!
Dialogue: 0,0:02:09.16,0:02:11.10,Default,,0000,0000,0000,,Мивако-сан➡️
Dialogue: 0,0:02:11.10,0:02:13.10,Default,,0000,0000,0000,,Сіз әрқашан
Dialogue: 0,0:02:11.10,0:02:13.10,Default,,0000,0000,0000,,Маған көмектесіңізші...
Dialogue: 0,0:02:13.10,0:02:16.10,Default,,0000,0000,0000,,Бұл не! ?
Dialogue: 0,0:02:13.10,0:02:16.10,Default,,0000,0000,0000,,Ватару-санды қолдау
Dialogue: 0,0:02:16.10,0:02:19.11,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:02:16.10,0:02:19.11,Default,,0000,0000,0000,,Сізді өмір бойы жақсы көру ➡️
Dialogue: 0,0:02:19.11,0:02:22.08,Default,,0000,0000,0000,,Сіз ант бересіз бе?
Dialogue: 0,0:02:19.11,0:02:22.08,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:02:25.11,0:02:28.11,Default,,0000,0000,0000,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:02:25.11,0:02:28.11,Default,,0000,0000,0000,,Мивако~!
Dialogue: 0,0:02:28.11,0:02:31.12,Default,,0000,0000,0000,,Сондай адамға үйленгің келсе
Dialogue: 0,0:02:28.11,0:02:31.12,Default,,0000,0000,0000,,Өлтіремін!
Dialogue: 0,0:02:31.12,0:02:33.12,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:33.12,0:02:36.12,Default,,0000,0000,0000,,Мегур
Dialogue: 0,0:02:33.12,0:02:36.12,Default,,0000,0000,0000,,Қауіпсіз!
Dialogue: 0,0:02:33.12,0:02:36.12,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:02:36.12,0:02:38.12,Default,,0000,0000,0000,,Когоро
Dialogue: 0,0:02:36.12,0:02:38.12,Default,,0000,0000,0000,,Ммм
Dialogue: 0,0:02:36.12,0:02:38.12,Default,,0000,0000,0000,,Ағай! ?
Dialogue: 0,0:02:38.12,0:02:40.13,Default,,0000,0000,0000,,Жолдан кет! Түскі түс!
Dialogue: 0,0:02:40.13,0:02:42.13,Default,,0000,0000,0000,,Торя!
Dialogue: 0,0:02:40.13,0:02:42.13,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:42.13,0:02:46.13,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:42.13,0:02:46.13,Default,,0000,0000,0000,,Гува! Эй
Dialogue: 0,0:02:46.13,0:02:48.13,Default,,0000,0000,0000,,Райнер, кейін кездескенше.
Dialogue: 0,0:02:46.13,0:02:48.13,Default,,0000,0000,0000,,Ауырды! Эй ақымақ!
Dialogue: 0,0:02:48.13,0:02:50.10,Default,,0000,0000,0000,,Мынау несі? ?
Dialogue: 0,0:02:52.14,0:02:56.14,Default,,0000,0000,0000,,Чиге
Dialogue: 0,0:02:52.14,0:02:56.14,Default,,0000,0000,0000,,Қарғыс атсын! Ол кетті! Дұрыс емес аяқ киім
Dialogue: 0,0:02:56.14,0:02:58.14,Default,,0000,0000,0000,,Ах…
Dialogue: 0,0:02:56.14,0:02:58.14,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:02:58.14,0:03:00.15,Default,,0000,0000,0000,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:02:58.14,0:03:00.15,Default,,0000,0000,0000,,Казами, кет!
Dialogue: 0,0:03:00.15,0:03:04.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:00.15,0:03:04.12,Default,,0000,0000,0000,,Маған көмектесіңізші...
Dialogue: 0,0:03:06.15,0:03:09.12,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:03:06.15,0:03:09.12,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:11.09,0:03:14.09,Default,,0000,0000,0000,,Қазақ
Dialogue: 0,0:03:11.09,0:03:14.09,Default,,0000,0000,0000,,Уф... Жақсысың ба? Казе…
Dialogue: 0,0:03:14.09,0:03:16.06,Default,,0000,0000,0000,,Ух... Ха!
Dialogue: 0,0:03:19.10,0:03:22.10,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:03:22.10,0:03:25.10,Default,,0000,0000,0000,,Казами…
Dialogue: 0,0:03:25.10,0:03:29.11,Default,,0000,0000,0000,,Хмм... Ха!
Dialogue: 0,0:03:25.10,0:03:29.11,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:03:29.11,0:03:33.11,Default,,0000,0000,0000,,Ha
Dialogue: 0,0:03:29.11,0:03:33.11,Default,,0000,0000,0000,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,0:03:33.11,0:03:35.11,Default,,0000,0000,0000,,Уф…
Dialogue: 0,0:03:33.11,0:03:35.11,Default,,0000,0000,0000,,Такаги-кун!
Dialogue: 0,0:03:35.11,0:03:38.12,Default,,0000,0000,0000,,Ах... Ах...
Dialogue: 0,0:03:38.12,0:03:41.12,Default,,0000,0000,0000,,Жаттығу аяқталды!
Dialogue: 0,0:03:38.12,0:03:41.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:41.12,0:03:44.12,Default,,0000,0000,0000,,Не? Сіз соққы алдыңыз ба?
Dialogue: 0,0:03:41.12,0:03:44.12,Default,,0000,0000,0000,,Бір айдан кейін
Dialogue: 0,0:03:44.12,0:03:47.13,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:03:44.12,0:03:47.13,Default,,0000,0000,0000,,Күйеу жігітті атып тастады!
Dialogue: 0,0:03:47.13,0:03:51.13,Default,,0000,0000,0000,,Қауіпсіздік жүйесін қайта қарау керек!
Dialogue: 0,0:03:47.13,0:03:51.13,Default,,0000,0000,0000,,Ааа...
Dialogue: 0,0:03:51.13,0:03:53.13,Default,,0000,0000,0000,,Бояу дегеніміз не?
Dialogue: 0,0:03:51.13,0:03:53.13,Default,,0000,0000,0000,,Ол құламайды, солай ма?
Dialogue: 0,0:03:53.13,0:03:56.14,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:03:53.13,0:03:56.14,Default,,0000,0000,0000,,Не болды? Сато мырза
Dialogue: 0,0:03:56.14,0:04:00.14,Default,,0000,0000,0000,,А... бұл ештеңе емес.
Dialogue: 0,0:04:00.14,0:04:04.14,Default,,0000,0000,0000,,Бұл нені білдіреді? ?
Dialogue: 0,0:04:00.14,0:04:04.14,Default,,0000,0000,0000,,Аударма Мен түсінбеймін.
Dialogue: 0,0:04:04.14,0:04:08.15,Default,,0000,0000,0000,,Детектив Такаги және детектив Сато
Dialogue: 0,0:04:04.14,0:04:08.15,Default,,0000,0000,0000,,Той емес пе еді?
Dialogue: 0,0:04:08.15,0:04:10.15,Default,,0000,0000,0000,,Жоқ, кешіріңіз, кешіріңіз.
Dialogue: 0,0:04:08.15,0:04:10.15,Default,,0000,0000,0000,,Нақты нәрсе сияқты ➡️
Dialogue: 0,0:04:10.15,0:04:14.09,Default,,0000,0000,0000,,Жаттығу мақсатында, балалар.
Dialogue: 0,0:04:10.15,0:04:14.09,Default,,0000,0000,0000,,Мен сізге ештеңе айтқан жоқпын.
Dialogue: 0,0:04:14.09,0:04:16.09,Default,,0000,0000,0000,,Е! ?
Dialogue: 0,0:04:14.09,0:04:16.09,Default,,0000,0000,0000,,《Әй...》
Dialogue: 0,0:04:16.09,0:04:20.09,Default,,0000,0000,0000,,Цутому Муранака
Dialogue: 0,0:04:16.09,0:04:20.09,Default,,0000,0000,0000,,Шын мәнінде, бұл жолы Цутому Муранака, полицияның бұрынғы бастығы,
Dialogue: 0,0:04:16.09,0:04:20.09,Default,,0000,0000,0000,,Мен үйленетін болдым.
Dialogue: 0,0:04:20.09,0:04:25.10,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,0:04:20.09,0:04:25.10,Default,,0000,0000,0000,,Морикун екеуміз тойды күзетеміз.
Dialogue: 0,0:04:20.09,0:04:25.10,Default,,0000,0000,0000,,Мені басқарды.
Dialogue: 0,0:04:25.10,0:04:27.10,Default,,0000,0000,0000,,Сенің әкең білді ме?
Dialogue: 0,0:04:25.10,0:04:27.10,Default,,0000,0000,0000,,《Олай болса➡️
Dialogue: 0,0:04:27.10,0:04:29.10,Default,,0000,0000,0000,,Сіз алға шыға алдыңыз ба?
Dialogue: 0,0:04:29.10,0:04:33.11,Default,,0000,0000,0000,,Бұрынғы басшы Муранака сенімді.
Dialogue: 0,0:04:29.10,0:04:33.11,Default,,0000,0000,0000,,Ол инспектормен бір уақытта емес пе еді?
Dialogue: 0,0:04:33.11,0:04:35.11,Default,,0000,0000,0000,,Әй, мен бірінші көтерілдім.
Dialogue: 0,0:04:35.11,0:04:38.11,Default,,0000,0000,0000,,Бірнеше жыл бұрын мен ауыр жарақат алдым.
Dialogue: 0,0:04:35.11,0:04:38.11,Default,,0000,0000,0000,,Мен зейнетке шықтым➡️
Dialogue: 0,0:04:38.11,0:04:42.12,Default,,0000,0000,0000,,Ауруханада
Dialogue: 0,0:04:38.11,0:04:42.12,Default,,0000,0000,0000,,Тағдырлы кездесу болған сияқты.
Dialogue: 0,0:04:42.12,0:04:46.12,Default,,0000,0000,0000,,Зейнеткерлікке шыққаннан кейін байланыс жоқ
Dialogue: 0,0:04:42.12,0:04:46.12,Default,,0000,0000,0000,,Мен уайымдадым.
Dialogue: 0,0:04:46.12,0:04:48.12,Default,,0000,0000,0000,,Шынымды айтсам, таң қалдым.
Dialogue: 0,0:04:46.12,0:04:48.12,Default,,0000,0000,0000,,Я~
Dialogue: 0,0:04:48.12,0:04:51.12,Default,,0000,0000,0000,,Бірақ тойдағы күзет неге?
Dialogue: 0,0:04:48.12,0:04:51.12,Default,,0000,0000,0000,,Бірінші тергеу бөлімі мұны істей ме?
Dialogue: 0,0:04:51.12,0:04:55.13,Default,,0000,0000,0000,,Ауылда
Dialogue: 0,0:04:51.12,0:04:55.13,Default,,0000,0000,0000,,Мен қорқытқан хат алдым.
Dialogue: 0,0:04:55.13,0:04:59.13,Default,,0000,0000,0000,,Белсенді кезең
Dialogue: 0,0:04:55.13,0:04:59.13,Default,,0000,0000,0000,,Ол көптеген қылмыскерлерді ұстады
Dialogue: 0,0:04:59.13,0:05:02.14,Default,,0000,0000,0000,,Көптеген адамдар әлі күнге дейін кек сақтайды
Dialogue: 0,0:04:59.13,0:05:02.14,Default,,0000,0000,0000,,Бұл өшпенділік дегенді білдіре ме?
Dialogue: 0,0:05:02.14,0:05:05.14,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:02.14,0:05:05.14,Default,,0000,0000,0000,,Сондықтан мен сені күзетуге рұқсат беруіңді өтіндім➡️
Dialogue: 0,0:05:05.14,0:05:08.14,Default,,0000,0000,0000,,Мұнда басыңыз
Dialogue: 0,0:05:05.14,0:05:08.14,Default,,0000,0000,0000,,Мен жоғары жаққа өтініш жасадым.
Dialogue: 0,0:05:08.14,0:05:12.08,Default,,0000,0000,0000,,Мұранака тұтқындағандардың да жүзін көрдік.
Dialogue: 0,0:05:08.14,0:05:12.08,Default,,0000,0000,0000,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:05:12.08,0:05:16.08,Default,,0000,0000,0000,,Төтенше жағдайда
Dialogue: 0,0:05:12.08,0:05:16.08,Default,,0000,0000,0000,,Мен оны жеңе аламын деп ойладым...
Dialogue: 0,0:05:16.08,0:05:19.09,Default,,0000,0000,0000,,Юми
Dialogue: 0,0:05:16.08,0:05:19.09,Default,,0000,0000,0000,,Амансың ба? Мивако
Dialogue: 0,0:05:16.08,0:05:19.09,Default,,0000,0000,0000,,Мен саған су әкелемін.
Dialogue: 0,0:05:19.09,0:05:23.09,Default,,0000,0000,0000,,3 жыл болды.
Dialogue: 0,0:05:19.09,0:05:23.09,Default,,0000,0000,0000,,Бұл сіз болдыңыз ба?
Dialogue: 0,0:05:23.09,0:05:26.09,Default,,0000,0000,0000,,Қашып кетсеңіз, мен шығамын.
Dialogue: 0,0:05:26.09,0:05:29.10,Default,,0000,0000,0000,,Сіз оны осылай оқыдыңыз, солай ма?
Dialogue: 0,0:05:29.10,0:05:32.10,Default,,0000,0000,0000,,Не болды? Детектив Сато
Dialogue: 0,0:05:32.10,0:05:35.10,Default,,0000,0000,0000,,Конан-кун... бұл ештеңе емес.
Dialogue: 0,0:05:35.10,0:05:39.11,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:05:35.10,0:05:39.11,Default,,0000,0000,0000,,Сіз оны дәл көресіз бе?
Dialogue: 0,0:05:39.11,0:05:42.08,Default,,0000,0000,0000,,Такаги-кун бұрын құлаған кезде...
Dialogue: 0,0:05:44.11,0:05:48.11,Default,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:05:44.11,0:05:48.11,Default,,0000,0000,0000,,Сіз мұны көрдіңіз...
Dialogue: 0,0:05:48.11,0:05:51.12,Default,,0000,0000,0000,,Иә? Бұл не?
Dialogue: 0,0:05:51.12,0:05:53.12,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:05:53.12,0:05:56.12,Default,,0000,0000,0000,,(Сато)
Dialogue: 0,0:05:53.12,0:05:56.12,Default,,0000,0000,0000,,Такаги-кунды алуға тырысу➡️
Dialogue: 0,0:05:56.12,0:05:58.12,Default,,0000,0000,0000,,Шинигами
Dialogue: 0,0:05:56.12,0:05:58.12,Default,,0000,0000,0000,,Қылмыскер
Dialogue: 0,0:05:58.12,0:06:11.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:11.07,0:06:14.07,Default,,0000,0000,0000,,Шиничи
Dialogue: 0,0:06:11.07,0:06:14.07,Default,,0000,0000,0000,,Құрмет
Dialogue: 0,0:06:11.07,0:06:14.07,Default,,0000,0000,0000,,(Шиничи)
Dialogue: 0,0:06:11.07,0:06:14.07,Default,,0000,0000,0000,,<Мен орта мектептің детективімін Шиничи Кудо>
Dialogue: 0,0:06:14.07,0:06:18.08,Default,,0000,0000,0000,,<Бала күнгі досы және сыныптасы Ран Моримен
Dialogue: 0,0:06:14.07,0:06:18.08,Default,,0000,0000,0000,,Ойын-сауық саябағына бару➡️
Dialogue: 0,0:06:18.08,0:06:23.08,Default,,0000,0000,0000,,Қара киінген адам
Dialogue: 0,0:06:18.08,0:06:23.08,Default,,0000,0000,0000,,Мен күдікті транзакция көрінісіне куә болдым＞
Dialogue: 0,0:06:23.08,0:06:25.08,Default,,0000,0000,0000,,<Транзакцияларды көру үшін
Dialogue: 0,0:06:23.08,0:06:25.08,Default,,0000,0000,0000,,Мен оған әуес болдым➡️
Dialogue: 0,0:06:25.08,0:06:28.09,Default,,0000,0000,0000,,Артынан жақындау
Dialogue: 0,0:06:25.08,0:06:28.09,Default,,0000,0000,0000,,Басқа серігін байқамадым>
Dialogue: 0,0:06:28.09,0:06:31.09,Default,,0000,0000,0000,,(соққы дыбысы)
Dialogue: 0,0:06:28.09,0:06:31.09,Default,,0000,0000,0000,,(Құлау дыбысы)
Dialogue: 0,0:06:31.09,0:06:34.09,Default,,0000,0000,0000,,<Ол кісі маған у ішті➡️
Dialogue: 0,0:06:34.09,0:06:36.06,Default,,0000,0000,0000,,Мен оянғанда...＞
Dialogue: 0,0:06:40.10,0:06:43.10,Default,,0000,0000,0000,,<Менің денем кішірейіп кетті! ＞
Dialogue: 0,0:06:43.10,0:06:46.11,Default,,0000,0000,0000,,<Егер Шиничи Кудо тірі болса
Dialogue: 0,0:06:43.10,0:06:46.11,Default,,0000,0000,0000,,Егер олар білсе➡️
Dialogue: 0,0:06:46.11,0:06:50.11,Default,,0000,0000,0000,,Менің өмірімдегі тағы бір әрекет
Dialogue: 0,0:06:46.11,0:06:50.11,Default,,0000,0000,0000,,Айналаңыздағы адамдарға да қауіп төніп тұр>
Dialogue: 0,0:06:50.11,0:06:54.11,Default,,0000,0000,0000,,Агаса
Dialogue: 0,0:06:50.11,0:06:54.11,Default,,0000,0000,0000,,<Доктор Агасаның кеңесі бойынша
Dialogue: 0,0:06:50.11,0:06:54.11,Default,,0000,0000,0000,,Мен өзімнің шынайы болмысымды жасыруды шештім➡️
Dialogue: 0,0:06:54.11,0:06:57.12,Default,,0000,0000,0000,,Ран менің атымды сұрағанда, мен бірден айттым➡️
Dialogue: 0,0:06:57.12,0:07:00.12,Default,,0000,0000,0000,,Эдогава
Dialogue: 0,0:06:57.12,0:07:00.12,Default,,0000,0000,0000,,Өзін «Эдогава Конан» деп атаған➡️
Dialogue: 0,0:07:00.12,0:07:03.12,Default,,0000,0000,0000,,Олар туралы ақпарат алу
Dialogue: 0,0:07:00.12,0:07:03.12,Default,,0000,0000,0000,,Менің әкем детектив➡️
Dialogue: 0,0:07:03.12,0:07:06.09,Default,,0000,0000,0000,,Ранның үйіне кіріп кетті＞
Dialogue: 0,0:07:08.13,0:07:11.06,Default,,0000,0000,0000,,<Бұл жігіттер Гента Мицухико Аюми>
Dialogue: 0,0:07:11.06,0:07:14.07,Default,,0000,0000,0000,,<Бұл менің кішірейіп кеткен сыныптасым>
Dialogue: 0,0:07:14.07,0:07:16.07,Default,,0000,0000,0000,,Ай
Dialogue: 0,0:07:14.07,0:07:16.07,Default,,0000,0000,0000,,<Ол Ай Хайбара>
Dialogue: 0,0:07:16.07,0:07:18.07,Default,,0000,0000,0000,,<Қара киінген ұйымның ғалымы➡️
Dialogue: 0,0:07:18.07,0:07:22.07,Default,,0000,0000,0000,,Апотоксин
Dialogue: 0,0:07:18.07,0:07:22.07,Default,,0000,0000,0000,,Улы препараттарға мысалдар
Dialogue: 0,0:07:18.07,0:07:22.07,Default,,0000,0000,0000,,APTX4869＞ әзірлеушісі
Dialogue: 0,0:07:22.07,0:07:24.08,Default,,0000,0000,0000,,＜Алайда, әпкем
Dialogue: 0,0:07:22.07,0:07:24.08,Default,,0000,0000,0000,,Өйткені ол кісі өлтірілді ➡️
Dialogue: 0,0:07:24.08,0:07:26.08,Default,,0000,0000,0000,,Ұйымға қарсы
Dialogue: 0,0:07:24.08,0:07:26.08,Default,,0000,0000,0000,,Өмірді аяқтау➡️
Dialogue: 0,0:07:26.08,0:07:30.08,Default,,0000,0000,0000,,Мен дәрі қабылдаған кезде
Dialogue: 0,0:07:26.08,0:07:30.08,Default,,0000,0000,0000,,Менің денем кішірейіп кетті>
Dialogue: 0,0:07:30.08,0:07:34.05,Default,,0000,0000,0000,,＜Әзірше олардың көзінен қашу үшін.
Dialogue: 0,0:07:30.08,0:07:34.05,Default,,0000,0000,0000,,Доктор Агасаның үйінде тұру＞
Dialogue: 0,0:07:36.09,0:07:38.09,Default,,0000,0000,0000,,<Сол қара ұйымның
Dialogue: 0,0:07:36.09,0:07:38.09,Default,,0000,0000,0000,,Мүшелердің бірі➡️
Dialogue: 0,0:07:38.09,0:07:41.09,Default,,0000,0000,0000,,Тору
Dialogue: 0,0:07:38.09,0:07:41.09,Default,,0000,0000,0000,,Бұл адам Тору Амуро>
Dialogue: 0,0:07:41.09,0:07:45.10,Default,,0000,0000,0000,,<Бірақ оның шынайы тұлғасы қандай?
Dialogue: 0,0:07:41.09,0:07:45.10,Default,,0000,0000,0000,,Қоғамдық қауіпсіздік полициясына ➡️ бұйрық беріңіз
Dialogue: 0,0:07:45.10,0:07:47.10,Default,,0000,0000,0000,,Ұлттық полиция агенттігінің қауіпсіздік бюросының құпия ұйымы➡️
Dialogue: 0,0:07:47.10,0:07:49.10,Default,,0000,0000,0000,,«Нөлге» жатады
Dialogue: 0,0:07:47.10,0:07:49.10,Default,,0000,0000,0000,,Полиция қызметкері ретінде➡️
Dialogue: 0,0:07:49.10,0:07:51.10,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:07:49.10,0:07:51.10,Default,,0000,0000,0000,,Шын аты - Рей Фуруя>
Dialogue: 0,0:07:51.10,0:07:54.11,Default,,0000,0000,0000,,<Ұйымның ішкі жұмысын білу
Dialogue: 0,0:07:51.10,0:07:54.11,Default,,0000,0000,0000,,Инфильтрация＞
Dialogue: 0,0:07:54.11,0:07:58.11,Default,,0000,0000,0000,,<Детектив Такагимен танысу
Dialogue: 0,0:07:54.11,0:07:58.11,Default,,0000,0000,0000,,Детектив Сатоның бірінші мерзіміне дейін➡️
Dialogue: 0,0:07:58.11,0:08:00.11,Default,,0000,0000,0000,,Полиция академиясын бітірген студенттер➡️
Dialogue: 0,0:08:00.11,0:08:03.12,Default,,0000,0000,0000,,Бұзық дос
Dialogue: 0,0:08:00.11,0:08:03.12,Default,,0000,0000,0000,,Шамасы, тағы төрт адам...>
Dialogue: 0,0:08:03.12,0:08:05.12,Default,,0000,0000,0000,,Сәлем Конан!
Dialogue: 0,0:08:05.12,0:08:07.12,Default,,0000,0000,0000,,Әй, сен тым көп сөйлейсің!
Dialogue: 0,0:08:07.12,0:08:09.12,Default,,0000,0000,0000,,Түсінікті болу үшін бұл спойлер!
Dialogue: 0,0:08:09.12,0:08:12.06,Default,,0000,0000,0000,,Тез
Dialogue: 0,0:08:09.12,0:08:12.06,Default,,0000,0000,0000,,Әрқашан айтатыныңызды айтыңыз.
Dialogue: 0,0:08:12.06,0:08:14.06,Default,,0000,0000,0000,,Мықтырақ!
Dialogue: 0,0:08:14.06,0:08:17.06,Default,,0000,0000,0000,,Кішірейсең де, миың сол күйінде қалады
Dialogue: 0,0:08:17.06,0:08:20.07,Default,,0000,0000,0000,,Лабиринті жоқ детектив
Dialogue: 0,0:08:20.07,0:08:23.04,Default,,0000,0000,0000,,Әрқашан бір ақиқат бар!
Dialogue: 0,0:08:35.08,0:08:43.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:45.09,0:08:49.06,Default,,0000,0000,0000,,Mazda Jinpei…
Dialogue: 0,0:08:45.09,0:08:49.06,Default,,0000,0000,0000,, (Хабар рингтоны)
Dialogue: 0,0:08:51.10,0:08:53.07,Default,,0000,0000,0000,, (Хабар рингтоны)
Dialogue: 0,0:08:55.10,0:08:59.11,Default,,0000,0000,0000,,🔊 (бағдаршамның бағыттаушы дыбысы)
Dialogue: 0,0:08:59.11,0:09:01.11,Default,,0000,0000,0000,,Ааа
Dialogue: 0,0:09:01.11,0:09:03.11,Default,,0000,0000,0000,,Той жегім келді.
Dialogue: 0,0:09:01.11,0:09:03.11,Default,,0000,0000,0000,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:09:03.11,0:09:07.11,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:09:03.11,0:09:07.11,Default,,0000,0000,0000,,Мен мұны жаттығу деп ойламадым.
Dialogue: 0,0:09:07.11,0:09:11.05,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:09:07.11,0:09:11.05,Default,,0000,0000,0000,,Детектив Сато, әдемі болды, солай емес пе?
Dialogue: 0,0:09:11.05,0:09:14.05,Default,,0000,0000,0000,,Әйелдерге арналған
Dialogue: 0,0:09:11.05,0:09:14.05,Default,,0000,0000,0000,,Өйткені қалыңдықтың көйлегі ерекше
Dialogue: 0,0:09:14.05,0:09:19.06,Default,,0000,0000,0000,,Эдогава-кун да біреудің қалыңдығындай киінген
Dialogue: 0,0:09:14.05,0:09:19.06,Default,,0000,0000,0000,,Мен оны елестетіп тұрған сияқтымын.
Dialogue: 0,0:09:19.06,0:09:21.06,Default,,0000,0000,0000,,Ех! ?
Dialogue: 0,0:09:19.06,0:09:21.06,Default,,0000,0000,0000,,Е! Біреу кім? ?
Dialogue: 0,0:09:21.06,0:09:23.06,Default,,0000,0000,0000,,Кобаяши
Dialogue: 0,0:09:21.06,0:09:23.06,Default,,0000,0000,0000,,Жоқ, бұл тек қана тәжірибе.
Dialogue: 0,0:09:21.06,0:09:23.06,Default,,0000,0000,0000,,Кобаяши мырза?
Dialogue: 0,0:09:23.06,0:09:25.06,Default,,0000,0000,0000,,Не? Неге...
Dialogue: 0,0:09:25.06,0:09:28.07,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:28.07,0:09:30.07,Default,,0000,0000,0000,,(Мицухико)
Dialogue: 0,0:09:28.07,0:09:30.07,Default,,0000,0000,0000,,Бұл Хэллоуинге арналған косплей костюмі.
Dialogue: 0,0:09:30.07,0:09:33.07,Default,,0000,0000,0000,,Мынаны киіп, бірге көңіл көтер
Dialogue: 0,0:09:30.07,0:09:33.07,Default,,0000,0000,0000,,Хехе, әрине➡️
Dialogue: 0,0:09:33.07,0:09:35.07,Default,,0000,0000,0000,,Конан мен Хайбара да!
Dialogue: 0,0:09:33.07,0:09:35.07,Default,,0000,0000,0000,,Ха! ?
Dialogue: 0,0:09:35.07,0:09:37.08,Default,,0000,0000,0000,,Эй, сәл күте тұрыңыз!
Dialogue: 0,0:09:35.07,0:09:37.08,Default,,0000,0000,0000,,Мен сондаймын...
Dialogue: 0,0:09:37.08,0:09:40.08,Default,,0000,0000,0000,,⚟ (соққы дыбысы)
Dialogue: 0,0:09:37.08,0:09:40.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:40.08,0:09:42.08,Default,,0000,0000,0000,,Бұл не? ?
Dialogue: 0,0:09:40.08,0:09:42.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:42.08,0:09:45.08,Default,,0000,0000,0000,,Тоттттттттттттттттттттттттттттт!
Dialogue: 0,0:09:45.08,0:09:49.09,Default,,0000,0000,0000,,Жоқ! ? Бұл қандай тесік? ?
Dialogue: 0,0:09:49.09,0:09:51.09,Default,,0000,0000,0000,,Райнер, кейін кездескенше.
Dialogue: 0,0:09:49.09,0:09:51.09,Default,,0000,0000,0000,,Ауырды...
Dialogue: 0,0:09:49.09,0:09:51.09,Default,,0000,0000,0000,,Дәрігер!
Dialogue: 0,0:09:51.09,0:09:54.09,Default,,0000,0000,0000,,Жоқ, кешіріңіз, кешіріңіз.
Dialogue: 0,0:09:51.09,0:09:54.09,Default,,0000,0000,0000,,Сізді не таң қалдырды?
Dialogue: 0,0:09:54.09,0:09:58.10,Default,,0000,0000,0000,,Бұл жолы не істеп жүрсің?
Dialogue: 0,0:09:54.09,0:09:58.10,Default,,0000,0000,0000,,Міне
Dialogue: 0,0:09:58.10,0:10:01.10,Default,,0000,0000,0000,,Бұл дегеніміз…
Dialogue: 0,0:09:58.10,0:10:01.10,Default,,0000,0000,0000,,Конанның белбеуі қай жерде доп шығады?
Dialogue: 0,0:10:01.10,0:10:04.10,Default,,0000,0000,0000,,Өте үлкен доп
Dialogue: 0,0:10:01.10,0:10:04.10,Default,,0000,0000,0000,,Енді атуға болады➡️
Dialogue: 0,0:10:04.10,0:10:07.11,Default,,0000,0000,0000,,Қазіргі уақытта жетілдірілуде
Dialogue: 0,0:10:04.10,0:10:07.11,Default,,0000,0000,0000,,Жақсы емес.
Dialogue: 0,0:10:07.11,0:10:10.11,Default,,0000,0000,0000,,Аяқтауға жақын.
Dialogue: 0,0:10:10.11,0:10:12.11,Default,,0000,0000,0000,,Беттік серпімділік және
Dialogue: 0,0:10:10.11,0:10:12.11,Default,,0000,0000,0000,,Күш тепе-теңдігі ➡️
Dialogue: 0,0:10:12.11,0:10:15.11,Default,,0000,0000,0000,,Егер сіз...
Dialogue: 0,0:10:12.11,0:10:15.11,Default,,0000,0000,0000,,Құлау➡️
Dialogue: 0,0:10:15.11,0:10:17.12,Default,,0000,0000,0000,,Сіз зардап шеге жаздады!
Dialogue: 0,0:10:15.11,0:10:17.12,Default,,0000,0000,0000,, (Хабар рингтоны)
Dialogue: 0,0:10:17.12,0:10:19.12,Default,,0000,0000,0000,,(Агаса)
Dialogue: 0,0:10:17.12,0:10:19.12,Default,,0000,0000,0000,,Аа, кешіріңіз, жақсысыз ба?
Dialogue: 0,0:10:19.12,0:10:22.12,Default,,0000,0000,0000,,...
Dialogue: 0,0:10:19.12,0:10:22.12,Default,,0000,0000,0000,,(Genta)
Dialogue: 0,0:10:19.12,0:10:22.12,Default,,0000,0000,0000,,Мен сені кешірмеймін! Маған жыланбалық жеуге рұқсат етіңіз!
Dialogue: 0,0:10:22.12,0:10:24.12,Default,,0000,0000,0000,,Бұл аз
Dialogue: 0,0:10:22.12,0:10:24.12,Default,,0000,0000,0000,,Ашуланба~
Dialogue: 0,0:10:24.12,0:10:26.13,Default,,0000,0000,0000,,Аха…
Dialogue: 0,0:10:24.12,0:10:26.13,Default,,0000,0000,0000,,Егер адам сізді бірден тамақтандыруы мүмкін болса ➡️
Dialogue: 0,0:10:26.13,0:10:28.09,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:10:26.13,0:10:28.09,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:31.13,0:10:34.13,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:10:31.13,0:10:34.13,Default,,0000,0000,0000,,Қалжың емес!
Dialogue: 0,0:10:34.13,0:10:37.14,Default,,0000,0000,0000,,Неліктен мен бұл балаларды таңдадым?
Dialogue: 0,0:10:34.13,0:10:37.14,Default,,0000,0000,0000,,Мен сені емдеуім керек! ?
Dialogue: 0,0:10:37.14,0:10:40.14,Default,,0000,0000,0000,,Жарайды, жарайды, кейде.
Dialogue: 0,0:10:37.14,0:10:40.14,Default,,0000,0000,0000,,Мен гочи боламын!
Dialogue: 0,0:10:40.14,0:10:43.14,Default,,0000,0000,0000,,Цк, кешегі оқуға қатысты.
Dialogue: 0,0:10:40.14,0:10:43.14,Default,,0000,0000,0000,,Елордалық полиция департаменті, мен барамын➡️
Dialogue: 0,0:10:43.14,0:10:46.15,Default,,0000,0000,0000,,Түскі асты осы жерде ішейік.
Dialogue: 0,0:10:43.14,0:10:46.15,Default,,0000,0000,0000,,Жаңа ғана айттым!
Dialogue: 0,0:10:46.15,0:10:49.15,Default,,0000,0000,0000,,Сондықтан бірге тамақтанған дұрыс
Dialogue: 0,0:10:46.15,0:10:49.15,Default,,0000,0000,0000,,Бұл дәмді емес пе?
Dialogue: 0,0:10:49.15,0:10:51.15,Default,,0000,0000,0000,,Мен темпура жегім келеді
Dialogue: 0,0:10:49.15,0:10:51.15,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:10:51.15,0:10:53.15,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:10:51.15,0:10:53.15,Default,,0000,0000,0000,,Мен өте ауырмын!
Dialogue: 0,0:10:53.15,0:10:55.15,Default,,0000,0000,0000,,Жыланбалықты жеңіз!
Dialogue: 0,0:10:53.15,0:10:55.15,Default,,0000,0000,0000,,Бұл жақсы~
Dialogue: 0,0:10:55.15,0:10:58.16,Default,,0000,0000,0000,,(Когоро)
Dialogue: 0,0:10:55.15,0:10:58.16,Default,,0000,0000,0000,,Сәлем! Уайымдама!
Dialogue: 0,0:10:58.16,0:11:01.16,Default,,0000,0000,0000,,Иә? Эй
Dialogue: 0,0:10:58.16,0:11:01.16,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:01.16,0:11:03.16,Default,,0000,0000,0000,,Мен мұны тастадым.
Dialogue: 0,0:11:03.16,0:11:05.13,Default,,0000,0000,0000,,О...
Dialogue: 0,0:11:12.10,0:11:14.11,Default,,0000,0000,0000,,️ (электрондық дыбыс)
Dialogue: 0,0:11:14.11,0:11:17.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:17.11,0:11:20.11,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:11:17.11,0:11:20.11,Default,,0000,0000,0000,,Кяах! !
Dialogue: 0,0:11:20.11,0:11:23.12,Default,,0000,0000,0000,,Хайбар!
Dialogue: 0,0:11:20.11,0:11:23.12,Default,,0000,0000,0000,,Әй, әке!
Dialogue: 0,0:11:23.12,0:11:25.12,Default,,0000,0000,0000,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:11:23.12,0:11:25.12,Default,,0000,0000,0000,,
Dialogue: 0,0:11:25.12,0:11:27.09,Default,,0000,0000,0000,,Уф…
Dialogue: 0,0:11:25.12,0:11:27.09,Default,,0000,0000,0000,,(Соқтығыс дыбысы)
Dialogue: 0,0:11:29.12,0:11:32.12,Default,,0000,0000,0000,,Ағай! Хайбар!
Dialogue: 0,0:11:29.12,0:11:32.12,Default,,0000,0000,0000,,Ағай, мықты болыңыз!
Dialogue: 0,0:11:32.12,0:11:36.13,Default,,0000,0000,0000,,Ағай! Мен жақсымын, бірақ...
Dialogue: 0,0:11:36.13,0:11:39.13,Default,,0000,0000,0000,,Ағай!
Dialogue: 0,0:11:36.13,0:11:39.13,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:39.13,0:11:43.10,Default,,0000,0000,0000,,Ран-ничан! Жедел жәрдем шақырыңыз!
Dialogue: 0,0:11:39.13,0:11:43.10,Default,,0000,0000,0000,,Ух... иә
Dialogue: 0,0:11:49.14,0:11:52.14,Default,,0000,0000,0000,,Қауіпті! Әй! Әй!
Dialogue: 0,0:11:49.14,0:11:52.14,Default,,0000,0000,0000,,Уф! Уф!
Dialogue: 0,0:11:52.14,0:11:56.15,Default,,0000,0000,0000,,Оны тез өшіріңіз!
Dialogue: 0,0:11:52.14,0:11:56.15,Default,,0000,0000,0000,,Шүкір, мен жақындай алмаймын!
Dialogue: 0,0:11:56.15,0:11:59.12,Default,,0000,0000,0000,,(Тікұшақтың дыбысы)
Dialogue: 0,0:11:56.15,0:11:59.12,Default,,0000,0000,0000,,
Dialogue: 0,0:12:01.15,0:12:03.16,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:12:01.15,0:12:03.16,Default,,0000,0000,0000,,Мен орнында тексеруді аяқтағаннан кейін➡️
Dialogue: 0,0:12:03.16,0:12:07.13,Default,,0000,0000,0000,,Мен доктор Агасада тұрамын.
Dialogue: 0,0:12:03.16,0:12:07.13,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:10.16,0:12:13.10,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:12:10.16,0:12:13.10,Default,,0000,0000,0000,,Сіз кенет көз алдыңызда отқа оранды, солай ма?
Dialogue: 0,0:12:13.10,0:12:15.10,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:13.10,0:12:15.10,Default,,0000,0000,0000,,Хайбара➡️
Dialogue: 0,0:12:15.10,0:12:18.10,Default,,0000,0000,0000,,Сіз соңғы минутта жазбаны алдыңыз.
Dialogue: 0,0:12:15.10,0:12:18.10,Default,,0000,0000,0000,,Мен оны саған беруге бардым.
Dialogue: 0,0:12:18.10,0:12:22.11,Default,,0000,0000,0000,,Иә, жазылғандай.
Dialogue: 0,0:12:18.10,0:12:22.11,Default,,0000,0000,0000,,Мен оны көрген жоқпын.
Dialogue: 0,0:12:22.11,0:12:25.11,Default,,0000,0000,0000,,Сол кезде
Dialogue: 0,0:12:22.11,0:12:25.11,Default,,0000,0000,0000,,Сізде әңгіме болды ма?
Dialogue: 0,0:12:25.11,0:12:27.11,Default,,0000,0000,0000,,Аа... ммм➡️
Dialogue: 0,0:12:27.11,0:12:30.12,Default,,0000,0000,0000,,«Алғаныңызға рахмет.
Dialogue: 0,0:12:27.11,0:12:30.12,Default,,0000,0000,0000,,Мен біреуге айтқым келеді ➡️
Dialogue: 0,0:12:30.12,0:12:34.12,Default,,0000,0000,0000,,Бұл өте маңызды естелік''
Dialogue: 0,0:12:30.12,0:12:34.12,Default,,0000,0000,0000,,Орыс тілінде айтты.
Dialogue: 0,0:12:34.12,0:12:37.12,Default,,0000,0000,0000,,Маңызды ескерту...
Dialogue: 0,0:12:34.12,0:12:37.12,Default,,0000,0000,0000,,Керемет! Сіз орысша түсінесіз бе?
Dialogue: 0,0:12:37.12,0:12:39.13,Default,,0000,0000,0000,,Аз ғана
Dialogue: 0,0:12:37.12,0:12:39.13,Default,,0000,0000,0000,,《Кем дегенде қара киінген ұйым➡️
Dialogue: 0,0:12:39.13,0:12:41.13,Default,,0000,0000,0000,,Хайбара
Dialogue: 0,0:12:39.13,0:12:41.13,Default,,0000,0000,0000,,Ол мұны мақсат етпейтін сияқты.
Dialogue: 0,0:12:41.13,0:12:45.13,Default,,0000,0000,0000,,Апаттар мен табиғат құбылыстары дегеніміз не?
Dialogue: 0,0:12:41.13,0:12:45.13,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:12:45.13,0:12:47.13,Default,,0000,0000,0000,,Қылмыс жәбірленушіге бағытталған болуы керек.
Dialogue: 0,0:12:47.13,0:12:50.14,Default,,0000,0000,0000,,Менде болған планшет
Dialogue: 0,0:12:47.13,0:12:50.14,Default,,0000,0000,0000,,Жарылыс көзі болуы мүмкін
Dialogue: 0,0:12:50.14,0:12:52.14,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:52.14,0:12:55.14,Default,,0000,0000,0000,,Әй, сөмкеңнің қалтасында.
Dialogue: 0,0:12:52.14,0:12:55.14,Default,,0000,0000,0000,,Ішінде бірдеңе бар.
Dialogue: 0,0:12:55.14,0:12:57.14,Default,,0000,0000,0000,,Иә? Әрине
Dialogue: 0,0:12:57.14,0:12:59.15,Default,,0000,0000,0000,,Визиткаға ұқсайды.
Dialogue: 0,0:12:59.15,0:13:01.15,Default,,0000,0000,0000,,Эй, бұл...
Dialogue: 0,0:13:01.15,0:13:06.15,Default,,0000,0000,0000,,Мен бәрін естідім.
Dialogue: 0,0:13:01.15,0:13:06.15,Default,,0000,0000,0000,,Иә? Не болды?
Dialogue: 0,0:13:06.15,0:13:08.15,Default,,0000,0000,0000,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:13:08.15,0:13:13.09,Default,,0000,0000,0000,,Ах! ?
Dialogue: 0,0:13:08.15,0:13:13.09,Default,,0000,0000,0000,,Сонымен… бұл…
Dialogue: 0,0:13:13.09,0:13:15.09,Default,,0000,0000,0000,,Цзиньпэй Мацуда
Dialogue: 0,0:13:13.09,0:13:15.09,Default,,0000,0000,0000,,<Цзиньпэй Мацуда>
Dialogue: 0,0:13:15.09,0:13:20.10,Default,,0000,0000,0000,,Түпнұсқа
Dialogue: 0,0:13:15.09,0:13:20.10,Default,,0000,0000,0000,,<Бұрынғы қалалық полиция департаментінің қылмыстық бөлімі
Dialogue: 0,0:13:15.09,0:13:20.10,Default,,0000,0000,0000,,Бірінші тергеу бөлімінің детективі, мәжбүрлі қылмыстар 3-бөлім＞
Dialogue: 0,0:13:20.10,0:13:24.10,Default,,0000,0000,0000,,<Үш жыл бұрын белгілі бір оқиғаға байланысты
Dialogue: 0,0:13:20.10,0:13:24.10,Default,,0000,0000,0000,,Бірінші тергеу бөліміне ауыстырылдым➡️
Dialogue: 0,0:13:24.10,0:13:27.11,Default,,0000,0000,0000,,Сериялық жарылыстарды тергеу➡️
Dialogue: 0,0:13:27.11,0:13:30.11,Default,,0000,0000,0000,,Қылмыскер жасаған бомба жарылып, ол қызметтік міндетін атқару кезінде қаза тапты>
Dialogue: 0,0:13:30.11,0:13:32.11,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:13:32.11,0:13:35.11,Default,,0000,0000,0000,,《Визиткада жазылған аффилиирленген
Dialogue: 0,0:13:32.11,0:13:35.11,Default,,0000,0000,0000,,Бірінші тергеу бөлімі》
Dialogue: 0,0:13:35.11,0:13:39.12,Default,,0000,0000,0000,,《Есімде қате болса, ол бірінші бөлімде болды.
Dialogue: 0,0:13:35.11,0:13:39.12,Default,,0000,0000,0000,,Бұл бар болғаны бір апта болуы керек》
Dialogue: 0,0:13:39.12,0:13:43.12,Default,,0000,0000,0000,,《Жәбірленуші қашан және қайда?
Dialogue: 0,0:13:39.12,0:13:43.12,Default,,0000,0000,0000,,Сіз визитка алдыңыз ба? 》
Dialogue: 0,0:13:43.12,0:13:47.13,Default,,0000,0000,0000,,Бұл шынымен де сіздің алдыңызда.
Dialogue: 0,0:13:43.12,0:13:47.13,Default,,0000,0000,0000,,Полицияға наразылық білдіру?
Dialogue: 0,0:13:47.13,0:13:49.13,Default,,0000,0000,0000,,Қорықпа
Dialogue: 0,0:13:47.13,0:13:49.13,Default,,0000,0000,0000,,Маған демалыс беріңізші➡️
Dialogue: 0,0:13:49.13,0:13:52.13,Default,,0000,0000,0000,,Міне, солай сезіледі.
Dialogue: 0,0:13:52.13,0:13:56.14,Default,,0000,0000,0000,,(Мегур)
Dialogue: 0,0:13:52.13,0:13:56.14,Default,,0000,0000,0000,,Сондықтан жәбірленушінің кім екені белгісіз.
Dialogue: 0,0:13:56.14,0:14:00.14,Default,,0000,0000,0000,,Балалардың айғақтары негізінде
Dialogue: 0,0:13:56.14,0:14:00.14,Default,,0000,0000,0000,,Мен оларға портреттер салғанымен...
Dialogue: 0,0:14:00.14,0:14:04.14,Default,,0000,0000,0000,,Чиба
Dialogue: 0,0:14:00.14,0:14:04.14,Default,,0000,0000,0000,,Жәбірленуші түсірген жазбалар
Dialogue: 0,0:14:00.14,0:14:04.14,Default,,0000,0000,0000,,Сіз оны көрмедіңіз бе?
Dialogue: 0,0:14:04.14,0:14:09.15,Default,,0000,0000,0000,,Жану жолы, естелік те.
Dialogue: 0,0:14:04.14,0:14:09.15,Default,,0000,0000,0000,,Оны өрттен қирату ықтималдығы жоғары.
Dialogue: 0,0:14:09.15,0:14:13.09,Default,,0000,0000,0000,,Әзірге анықтамалар
Dialogue: 0,0:14:09.15,0:14:13.09,Default,,0000,0000,0000,,Бұл жалғыз визит карточкасы болады.
Dialogue: 0,0:14:13.09,0:14:16.09,Default,,0000,0000,0000,,Мацуда-сан деген кім?
Dialogue: 0,0:14:13.09,0:14:16.09,Default,,0000,0000,0000,,Ол осылай көрінді.
Dialogue: 0,0:14:16.09,0:14:20.09,Default,,0000,0000,0000,,көремін. Чиба-кунның тағайындалуы...
Dialogue: 0,0:14:16.09,0:14:20.09,Default,,0000,0000,0000,,Бұл Мацуда қызметтік міндетін орындау кезінде қайтыс болғаннан кейін болды.
Dialogue: 0,0:14:20.09,0:14:24.10,Default,,0000,0000,0000,,Шынымен де, көзіңді жауып алсаң
Dialogue: 0,0:14:20.09,0:14:24.10,Default,,0000,0000,0000,,Такаги-санға ұқсауы мүмкін
Dialogue: 0,0:14:24.10,0:14:27.10,Default,,0000,0000,0000,,Ширатори
Dialogue: 0,0:14:24.10,0:14:27.10,Default,,0000,0000,0000,,О
Dialogue: 0,0:14:24.10,0:14:27.10,Default,,0000,0000,0000,,Такаги-кун басын жасырған кезде➡️
Dialogue: 0,0:14:27.10,0:14:30.10,Default,,0000,0000,0000,,Ол Мацуда-санға тура ұқсайтын.
Dialogue: 0,0:14:30.10,0:14:32.10,Default,,0000,0000,0000,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:14:30.10,0:14:32.10,Default,,0000,0000,0000,,Кез келген жағдайда➡️
Dialogue: 0,0:14:32.10,0:14:34.11,Default,,0000,0000,0000,,Күнделікті сол кездегі есепті де алып келдім.
Dialogue: 0,0:14:34.11,0:14:38.11,Default,,0000,0000,0000,,Қазіргі уақытта Сато мырза тағайындалды
Dialogue: 0,0:14:34.11,0:14:38.11,Default,,0000,0000,0000,,Мацуда-кунмен жұмыс істеген сіз болдыңыз.
Dialogue: 0,0:14:38.11,0:14:40.11,Default,,0000,0000,0000,,Сіз бірдеңе ойлап таба аласыз ба?
Dialogue: 0,0:14:40.11,0:14:43.12,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:14:40.11,0:14:43.12,Default,,0000,0000,0000,,Егер сіз визиткаңызды шетелдік адамға берсеңіз➡️
Dialogue: 0,0:14:43.12,0:14:45.12,Default,,0000,0000,0000,,Сіздің есіңізде деп ойлаймын...
Dialogue: 0,0:14:45.12,0:14:48.12,Default,,0000,0000,0000,,(Мегур)
Dialogue: 0,0:14:45.12,0:14:48.12,Default,,0000,0000,0000,,Сұрақ қоюды басқа біреуге қалдырыңыз➡️
Dialogue: 0,0:14:48.12,0:14:51.12,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:14:48.12,0:14:51.12,Default,,0000,0000,0000,,Сол күндерді еске түсіруге тырысыңыз.
Dialogue: 0,0:14:51.12,0:14:53.09,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:15:00.13,0:15:03.14,Default,,0000,0000,0000,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:15:00.13,0:15:03.14,Default,,0000,0000,0000,,Мен байқамадым деп ойладың ба?
Dialogue: 0,0:15:03.14,0:15:05.14,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:15:05.14,0:15:08.14,Default,,0000,0000,0000,,Мұның бәрі сіз туралы.
Dialogue: 0,0:15:05.14,0:15:08.14,Default,,0000,0000,0000,,Сіз тыңдадыңыз, солай ма?
Dialogue: 0,0:15:08.14,0:15:12.08,Default,,0000,0000,0000,,Ух... иә
Dialogue: 0,0:15:08.14,0:15:12.08,Default,,0000,0000,0000,,Кіріңіз
Dialogue: 0,0:15:12.08,0:15:15.08,Default,,0000,0000,0000,,Сіз мұндай ештеңе көрмесеңіз де
Dialogue: 0,0:15:12.08,0:15:15.08,Default,,0000,0000,0000,,Онымен бір апта➡️
Dialogue: 0,0:15:15.08,0:15:18.08,Default,,0000,0000,0000,,№
Dialogue: 0,0:15:15.08,0:15:18.08,Default,,0000,0000,0000,,Менің есімде
Dialogue: 0,0:15:15.08,0:15:18.08,Default,,0000,0000,0000,,Такаги-кунға айтпа.
Dialogue: 0,0:15:18.08,0:15:22.09,Default,,0000,0000,0000,,Ол тамаша детектив еді, солай емес пе?
Dialogue: 0,0:15:18.08,0:15:22.09,Default,,0000,0000,0000,,Детектив Мацуда
Dialogue: 0,0:15:22.09,0:15:27.09,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:15:22.09,0:15:27.09,Default,,0000,0000,0000,,Мінезі үлкен, аузы нашар...
Dialogue: 0,0:15:27.09,0:15:30.10,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:15:27.09,0:15:30.10,Default,,0000,0000,0000,,Қаласаңыз➡️
Dialogue: 0,0:15:30.10,0:15:33.10,Default,,0000,0000,0000,,Маған айта аласыз ба?
Dialogue: 0,0:15:30.10,0:15:33.10,Default,,0000,0000,0000,,Детектив Мацуда туралы
Dialogue: 0,0:15:33.10,0:15:35.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:33.10,0:15:35.10,Default,,0000,0000,0000,,Біз сөйлесіп жатқанда➡️
Dialogue: 0,0:15:35.10,0:15:39.10,Default,,0000,0000,0000,,Мен бәрібір жақсы боламын. Бар күшімді саламын
Dialogue: 0,0:15:35.10,0:15:39.10,Default,,0000,0000,0000,,Есіңізде болар, солай ма?
Dialogue: 0,0:15:39.10,0:15:43.11,Default,,0000,0000,0000,,Иә... Иә.
Dialogue: 0,0:15:43.11,0:15:45.11,Default,,0000,0000,0000,,Ол
Dialogue: 0,0:15:43.11,0:15:45.11,Default,,0000,0000,0000,,Мен бірінші тергеу бөліміне тағайындалдым➡️
Dialogue: 0,0:15:45.11,0:15:47.11,Default,,0000,0000,0000,,3 жыл бұрын 1 қараша
Dialogue: 0,0:15:47.11,0:15:50.12,Default,,0000,0000,0000,,Өйткені бұл Хэллоуиннен кейінгі күн болатын.
Dialogue: 0,0:15:47.11,0:15:50.12,Default,,0000,0000,0000,,Менің есімде
Dialogue: 0,0:15:50.12,0:15:54.12,Default,,0000,0000,0000,,Бірақ бұл кенеттен орын ауыстыру болды.
Dialogue: 0,0:15:50.12,0:15:54.12,Default,,0000,0000,0000,,Мен визиткамды уақытында ала алмадым.
Dialogue: 0,0:15:54.12,0:15:57.12,Default,,0000,0000,0000,,Мен оны 4 қараша күні таңертең бере алдым.
Dialogue: 0,0:15:57.12,0:16:00.13,Default,,0000,0000,0000,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:15:57.12,0:16:00.13,Default,,0000,0000,0000,,Бұл мерекеден кейін болғандықтан есімде.
Dialogue: 0,0:16:00.13,0:16:03.13,Default,,0000,0000,0000,,Детектив Мацуда 7 қарашада қызметтік міндетін атқару кезінде қайтыс болды.
Dialogue: 0,0:16:03.13,0:16:07.13,Default,,0000,0000,0000,,Менің визит карточкамды тапсыру мүмкіндігі болды.
Dialogue: 0,0:16:03.13,0:16:07.13,Default,,0000,0000,0000,,Соңғы төрт күн.
Dialogue: 0,0:16:07.13,0:16:09.13,Default,,0000,0000,0000,,(Сато)
Dialogue: 0,0:16:07.13,0:16:09.13,Default,,0000,0000,0000,,Бірақ 4-ші күні толық жұмыс күнім болды➡️
Dialogue: 0,0:16:09.13,0:16:13.07,Default,,0000,0000,0000,,5 күн эскорт миссиясында
Dialogue: 0,0:16:09.13,0:16:13.07,Default,,0000,0000,0000,,Тергеу изоляторы мен уақытша ұстау изоляторы арасындағы барумен аяқталады
Dialogue: 0,0:16:13.07,0:16:18.08,Default,,0000,0000,0000,,7-ші қайтыс болғанға дейін болды.
Dialogue: 0,0:16:13.07,0:16:18.08,Default,,0000,0000,0000,,Себебі мен сериялық бомбалаушыны аңдыдым...
Dialogue: 0,0:16:18.08,0:16:21.08,Default,,0000,0000,0000,,Рычаг сізге визиткаңызды беруге мүмкіндік береді.
Dialogue: 0,0:16:18.08,0:16:21.08,Default,,0000,0000,0000,,Онда...
Dialogue: 0,0:16:21.08,0:16:24.08,Default,,0000,0000,0000,,Иә, тек 6 қарашада
Dialogue: 0,0:16:24.08,0:16:28.09,Default,,0000,0000,0000,,Бірақ жұмыс біткен соң
Dialogue: 0,0:16:24.08,0:16:28.09,Default,,0000,0000,0000,,Сіз оны басқа біреуге берген боларсыз, солай ма?
Dialogue: 0,0:16:28.09,0:16:32.09,Default,,0000,0000,0000,,Біздің бөлімге келгеннен бері.
Dialogue: 0,0:16:28.09,0:16:32.09,Default,,0000,0000,0000,,Бір апта бойы жатақханаға оралмау➡️
Dialogue: 0,0:16:32.09,0:16:34.09,Default,,0000,0000,0000,,Мен кеңседе қалдым.
Dialogue: 0,0:16:34.09,0:16:37.10,Default,,0000,0000,0000,,Қазір бұл туралы ойлану
Dialogue: 0,0:16:34.09,0:16:37.10,Default,,0000,0000,0000,,Сериялық бомбалау оқиғасы туралы ➡️
Dialogue: 0,0:16:37.10,0:16:39.10,Default,,0000,0000,0000,,Менің ойымша, сіз оны қарап шықтыңыз.
Dialogue: 0,0:16:39.10,0:16:43.10,Default,,0000,0000,0000,,Бірақ ерекше нәрсе болды.
Dialogue: 0,0:16:39.10,0:16:43.10,Default,,0000,0000,0000,,Сіздің жадыңыз жоқ, солай ма?
Dialogue: 0,0:16:43.10,0:16:45.10,Default,,0000,0000,0000,,Қарақшыны ұстаңыз
Dialogue: 0,0:16:43.10,0:16:45.10,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:45.10,0:16:48.11,Default,,0000,0000,0000,,Сіз автобусты басқара алмай тоқтадыңыз.
Dialogue: 0,0:16:45.10,0:16:48.11,Default,,0000,0000,0000,,Хех хех хех. Пфу.
Dialogue: 0,0:16:48.11,0:16:50.11,Default,,0000,0000,0000,,Сонымен қатар, тежегіш секіргіштер
Dialogue: 0,0:16:48.11,0:16:50.11,Default,,0000,0000,0000,,Ах…
Dialogue: 0,0:16:50.11,0:16:52.11,Default,,0000,0000,0000,,(Сато)
Dialogue: 0,0:16:50.11,0:16:52.11,Default,,0000,0000,0000,,Таңертең солай болды ма деп ойлаймын.
Dialogue: 0,0:16:52.11,0:16:54.11,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:54.11,0:16:57.12,Default,,0000,0000,0000,,Түстен кейін мен жауапты болған іс бойынша сұхбат алдым.
Dialogue: 0,0:16:57.12,0:17:00.12,Default,,0000,0000,0000,,｟Тоқта, не?
Dialogue: 0,0:16:57.12,0:17:00.12,Default,,0000,0000,0000,,Бұрынғыдан сендіру әдісі｠
Dialogue: 0,0:17:00.12,0:17:03.12,Default,,0000,0000,0000,,｜Мен сізге көмектесе алғаныма қуаныштымын.
Dialogue: 0,0:17:00.12,0:17:03.12,Default,,0000,0000,0000,,Мен есеңгіреп қалған кезде➡️
Dialogue: 0,0:17:03.12,0:17:07.13,Default,,0000,0000,0000,,Мен секіремін бе деп қорқамын
Dialogue: 0,0:17:03.12,0:17:07.13,Default,,0000,0000,0000,,Мен қатты қорықтым｠
Dialogue: 0,0:17:07.13,0:17:10.13,Default,,0000,0000,0000,,｟Аздап
Dialogue: 0,0:17:07.13,0:17:10.13,Default,,0000,0000,0000,,Менің айтқанымды тыңда...｠
Dialogue: 0,0:17:10.13,0:17:12.06,Default,,0000,0000,0000,,｟Электрондық пошта? Бұл жылдам｠
Dialogue: 0,0:17:12.06,0:17:15.07,Default,,0000,0000,0000,,｟Ах
Dialogue: 0,0:17:12.06,0:17:15.07,Default,,0000,0000,0000,,Менің саусақ ұштарым адамдарға қарағанда епті｠
Dialogue: 0,0:17:15.07,0:17:17.07,Default,,0000,0000,0000,,｟Мүмкін ол ол шығар? ｠
Dialogue: 0,0:17:17.07,0:17:19.07,Default,,0000,0000,0000,,｟Жоқ, мен оны негрге жаздым｠
Dialogue: 0,0:17:19.07,0:17:22.07,Default,,0000,0000,0000,,｟Олар оны мен жіберсем де алмайды.
Dialogue: 0,0:17:19.07,0:17:22.07,Default,,0000,0000,0000,,Менің ең жақын досыма...｠
Dialogue: 0,0:17:22.07,0:17:24.08,Default,,0000,0000,0000,,Иә? Сіз оны қабылдамайсыз ба? ｠
Dialogue: 0,0:17:24.08,0:17:27.08,Default,,0000,0000,0000,,｟Бұл төрт жыл бұрын болды.
Dialogue: 0,0:17:24.08,0:17:27.08,Default,,0000,0000,0000,,Себебі ол мені ұшырып жіберді｠
Dialogue: 0,0:17:27.08,0:17:29.08,Default,,0000,0000,0000,,｟Иә? ｠
Dialogue: 0,0:17:27.08,0:17:29.08,Default,,0000,0000,0000,,(Радионы қабылдау дыбысы)
Dialogue: 0,0:17:29.08,0:17:31.08,Default,,0000,0000,0000,,Бейкачо
Dialogue: 0,0:17:29.08,0:17:31.08,Default,,0000,0000,0000,,(Радио: полиция қызметкері)
Dialogue: 0,0:17:29.08,0:17:31.08,Default,,0000,0000,0000,,｟Бейкачо 3-чомеде кісі өлтіру оқиғасы орын алды｜
Dialogue: 0,0:17:31.08,0:17:34.09,Default,,0000,0000,0000,,｟Қылмыскер мотоциклмен қашып жүр｜
Dialogue: 0,0:17:34.09,0:17:37.09,Default,,0000,0000,0000,,｟Түсіндім, мен оны қадағалаймын! ｠
Dialogue: 0,0:17:37.09,0:17:40.09,Default,,0000,0000,0000,,｟Күтілгендей
Dialogue: 0,0:17:37.09,0:17:40.09,Default,,0000,0000,0000,,Бұл қала қалыпты емес｠
Dialogue: 0,0:17:40.09,0:17:43.10,Default,,0000,0000,0000,,Егер мәселе тыңдалса
Dialogue: 0,0:17:40.09,0:17:43.10,Default,,0000,0000,0000,,Сағат 15:00-ге дейін уақыт кетті➡️
Dialogue: 0,0:17:43.10,0:17:46.10,Default,,0000,0000,0000,,Сакурадамон
Dialogue: 0,0:17:43.10,0:17:46.10,Default,,0000,0000,0000,,Осыдан кейін мен Сакурадамонға оралдым.
Dialogue: 0,0:17:46.10,0:17:50.10,Default,,0000,0000,0000,,Әй, тыңда.
Dialogue: 0,0:17:46.10,0:17:50.10,Default,,0000,0000,0000,,Сіз детектив Мацудамен бірге тест тапсырдыңыз ба?
Dialogue: 0,0:17:50.10,0:17:52.07,Default,,0000,0000,0000,,Жоқ, бөлек...
Dialogue: 0,0:17:54.11,0:17:56.11,Default,,0000,0000,0000,,｜Күттіргенім үшін кешіріңіз｠
Dialogue: 0,0:17:56.11,0:17:59.11,Default,,0000,0000,0000,,｟Қайда болдың?
Dialogue: 0,0:17:56.11,0:17:59.11,Default,,0000,0000,0000,,Сағат 6-дан асып кетті｠
Dialogue: 0,0:17:59.11,0:18:01.11,Default,,0000,0000,0000,,｟Аздап｠
Dialogue: 0,0:17:59.11,0:18:01.11,Default,,0000,0000,0000,,Иә? ｠
Dialogue: 0,0:18:01.11,0:18:03.12,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:18:03.12,0:18:07.12,Default,,0000,0000,0000,,Увааах! Уф!
Dialogue: 0,0:18:03.12,0:18:07.12,Default,,0000,0000,0000,,Жаңа ғана есіме түсті, Мацуда-кун➡️
Dialogue: 0,0:18:07.12,0:18:10.12,Default,,0000,0000,0000,,Менің қалтамда тәспі бар еді.
Dialogue: 0,0:18:07.12,0:18:10.12,Default,,0000,0000,0000,,Намаз моншақтары?
Dialogue: 0,0:18:10.12,0:18:12.06,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:10.12,0:18:12.06,Default,,0000,0000,0000,,Детектив Мацуда бұрын айтылған➡️
Dialogue: 0,0:18:12.06,0:18:14.06,Default,,0000,0000,0000,,Электрондық поштаны жазып жатқан адам...
Dialogue: 0,0:18:14.06,0:18:18.06,Default,,0000,0000,0000,,Онымен бір уақытта шығар
Dialogue: 0,0:18:14.06,0:18:18.06,Default,,0000,0000,0000,,Жарылғыш заттарды залалсыздандыру отрядының мүшесі болды➡️
Dialogue: 0,0:18:18.06,0:18:20.07,Default,,0000,0000,0000,,Кенджи Хагивара
Dialogue: 0,0:18:18.06,0:18:20.07,Default,,0000,0000,0000,,Кенджи Хагивара
Dialogue: 0,0:18:20.07,0:18:24.07,Default,,0000,0000,0000,,Жеті жыл бұрын
Dialogue: 0,0:18:20.07,0:18:24.07,Default,,0000,0000,0000,,Ол қызметтік міндетін атқару кезінде бомбаны залалсыздандыру кезінде қаза тапқанға ұқсайды.
Dialogue: 0,0:18:24.07,0:18:26.07,Default,,0000,0000,0000,,Адамның қайтыс болған күні неше жыл?
Dialogue: 0,0:18:26.07,0:18:29.07,Default,,0000,0000,0000,,Дәл өзі сияқты қарашаның 7-сі!
Dialogue: 0,0:18:29.07,0:18:33.08,Default,,0000,0000,0000,,Өлімінің 7-ші күні
Dialogue: 0,0:18:29.07,0:18:33.08,Default,,0000,0000,0000,,Сериялық бомбалаушы маған хабарласқан күні
Dialogue: 0,0:18:33.08,0:18:37.08,Default,,0000,0000,0000,,Детектив Мацуда сол хабарламаны алғанша күтеді.
Dialogue: 0,0:18:33.08,0:18:37.08,Default,,0000,0000,0000,,Ол барлық уақытта бас кеңседе болды, солай ма?
Dialogue: 0,0:18:37.08,0:18:40.09,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:18:37.08,0:18:40.09,Default,,0000,0000,0000,,Мен сол күні қабірге бара алмаймын.
Dialogue: 0,0:18:40.09,0:18:43.09,Default,,0000,0000,0000,,Сол үшін 6-ға барған жоқсың ба?
Dialogue: 0,0:18:43.09,0:18:48.09,Default,,0000,0000,0000,,Шибуя
Dialogue: 0,0:18:43.09,0:18:48.09,Default,,0000,0000,0000,,Хагивара мырзаның бейіті
Dialogue: 0,0:18:43.09,0:18:48.09,Default,,0000,0000,0000,,Бұл Шибуяның дәл қасындағы ғибадатхана екеніне сенімдімін.
Dialogue: 0,0:18:48.09,0:18:52.10,Default,,0000,0000,0000,,Не болды? Сато мырза
Dialogue: 0,0:18:48.09,0:18:52.10,Default,,0000,0000,0000,,Өтінемін!
Dialogue: 0,0:18:52.10,0:18:54.10,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:18:52.10,0:18:54.10,Default,,0000,0000,0000,,Ах Такаги-сан!
Dialogue: 0,0:18:54.10,0:18:57.10,Default,,0000,0000,0000,,《Сұхбат қашан аяқталды
Dialogue: 0,0:18:54.10,0:18:57.10,Default,,0000,0000,0000,,15:00》
Dialogue: 0,0:18:57.10,0:19:01.11,Default,,0000,0000,0000,,《Сыныптастарының зиратына бару
Dialogue: 0,0:18:57.10,0:19:01.11,Default,,0000,0000,0000,,Шибуядағы ғибадатханаға барсаңыз да➡️
Dialogue: 0,0:19:01.11,0:19:03.11,Default,,0000,0000,0000,,Үйге кешкі 6-дан кейін ➡️ келсең
Dialogue: 0,0:19:03.11,0:19:06.11,Default,,0000,0000,0000,,Кез келген сома
Dialogue: 0,0:19:03.11,0:19:06.11,Default,,0000,0000,0000,,Бұл тым көп уақыт алып жатыр》
Dialogue: 0,0:19:06.11,0:19:09.11,Default,,0000,0000,0000,,《Сол үш сағатта
Dialogue: 0,0:19:06.11,0:19:09.11,Default,,0000,0000,0000,,Не болды? 》
Dialogue: 0,0:19:09.11,0:19:12.05,Default,,0000,0000,0000,,Сен мұнда не үшін келдің? ?
Dialogue: 0,0:19:09.11,0:19:12.05,Default,,0000,0000,0000,,Конан-кун
Dialogue: 0,0:19:12.05,0:19:14.05,Default,,0000,0000,0000,,Ах, ах…
Dialogue: 0,0:19:14.05,0:19:19.06,Default,,0000,0000,0000,,Иә, иә, олар туралы.
Dialogue: 0,0:19:14.05,0:19:19.06,Default,,0000,0000,0000,,Менің есімде өте жақсы.
Dialogue: 0,0:19:19.06,0:19:22.06,Default,,0000,0000,0000,,Осыдан бірнеше жыл бұрын
Dialogue: 0,0:19:19.06,0:19:22.06,Default,,0000,0000,0000,,Төрт адам келді.
Dialogue: 0,0:19:22.06,0:19:24.06,Default,,0000,0000,0000,,Төрт адам! ?
Dialogue: 0,0:19:22.06,0:19:24.06,Default,,0000,0000,0000,,Барлығына➡️
Dialogue: 0,0:19:24.06,0:19:27.07,Default,,0000,0000,0000,,Хагивара-санның замандастары
Dialogue: 0,0:19:24.06,0:19:27.07,Default,,0000,0000,0000,,деді
Dialogue: 0,0:19:27.07,0:19:30.07,Default,,0000,0000,0000,,3 жыл бұрын келгенімде не болды
Dialogue: 0,0:19:27.07,0:19:30.07,Default,,0000,0000,0000,,Есіңде ме?
Dialogue: 0,0:19:30.07,0:19:32.07,Default,,0000,0000,0000,,Сіз сағат нешеде келдіңіз?
Dialogue: 0,0:19:32.07,0:19:35.07,Default,,0000,0000,0000,,Жыл сайын түстен кейін
Dialogue: 0,0:19:32.07,0:19:35.07,Default,,0000,0000,0000,,Менің ойымша, сағат 3-тер шамасында болды.
Dialogue: 0,0:19:35.07,0:19:37.08,Default,,0000,0000,0000,,Әйтеуір➡️
Dialogue: 0,0:19:37.08,0:19:39.08,Default,,0000,0000,0000,,Соңғы уақытта
Dialogue: 0,0:19:37.08,0:19:39.08,Default,,0000,0000,0000,,Қасиетті зиярат етушілер саны азайып келеді➡️
Dialogue: 0,0:19:39.08,0:19:43.08,Default,,0000,0000,0000,,Өткен жылы мен жалғыз болдым...
Dialogue: 0,0:19:39.08,0:19:43.08,Default,,0000,0000,0000,,Мен жалғызбын
Dialogue: 0,0:19:43.08,0:19:47.09,Default,,0000,0000,0000,,Соңғысының аты
Dialogue: 0,0:19:43.08,0:19:47.09,Default,,0000,0000,0000,,Түсінесіз бе?
Dialogue: 0,0:19:47.09,0:19:49.09,Default,,0000,0000,0000,,Аты... Иә➡️ екеніне сенімдімін
Dialogue: 0,0:19:49.09,0:19:53.06,Default,,0000,0000,0000,,Фуруя мырза
Менің ойымша, бұл
Dialogue: 0,0:19:49.09,0:19:53.06,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:58.10,0:20:00.10,Default,,0000,0000,0000,,…бірақ ол құламайды!
Dialogue: 0,0:19:58.10,0:20:00.10,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:20:00.10,0:20:03.10,Default,,0000,0000,0000,,Уккикики
Dialogue: 0,0:20:00.10,0:20:03.10,Default,,0000,0000,0000,,«Фуруяреи»
Dialogue: 0,0:20:03.10,0:20:05.07,Default,,0000,0000,0000,,(тінтуірді басу дыбысы)
Dialogue: 0,0:20:07.11,0:20:09.11,Default,,0000,0000,0000,,Қанша қарасаң да осындай.
Dialogue: 0,0:20:09.11,0:20:12.11,Default,,0000,0000,0000,,Сіз шынымен де сондасыз ба?
Dialogue: 0,0:20:09.11,0:20:12.11,Default,,0000,0000,0000,,Фуруя деген жігіт
Dialogue: 0,0:20:12.11,0:20:14.11,Default,,0000,0000,0000,,Мацуда-кунның сыныптасы болған адам.
Dialogue: 0,0:20:14.11,0:20:18.12,Default,,0000,0000,0000,,Сіз полициядан кеткен болсаңыз да
Dialogue: 0,0:20:14.11,0:20:18.12,Default,,0000,0000,0000,,Деректер қалуы керек
Dialogue: 0,0:20:18.12,0:20:21.12,Default,,0000,0000,0000,,Сержант Такаги лейтенант Сатоға
Dialogue: 0,0:20:21.12,0:20:23.12,Default,,0000,0000,0000,,Е! ?
Dialogue: 0,0:20:21.12,0:20:23.12,Default,,0000,0000,0000,,Сіз сенімдісіз бе...
Dialogue: 0,0:20:23.12,0:20:28.09,Default,,0000,0000,0000,,Бұл елордалық полиция департаментінің қоғамдық қауіпсіздік бөлімінің қызметкері Казами.
Dialogue: 0,0:20:23.12,0:20:28.09,Default,,0000,0000,0000,,Бір сәтке кешіріңіз?
Dialogue: 0,0:20:30.13,0:20:32.13,Default,,0000,0000,0000,,Тергеуді тоқтатуымыз керек пе?
Dialogue: 0,0:20:32.13,0:20:35.13,Default,,0000,0000,0000,,(казами)
Dialogue: 0,0:20:32.13,0:20:35.13,Default,,0000,0000,0000,,Бұл іспен қоғамдық қауіпсіздік айналысады.
Dialogue: 0,0:20:35.13,0:20:38.14,Default,,0000,0000,0000,,Ақылсыз сөз айтпа!
Dialogue: 0,0:20:35.13,0:20:38.14,Default,,0000,0000,0000,,Бұл біздің яма!
Dialogue: 0,0:20:38.14,0:20:41.14,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:20:38.14,0:20:41.14,Default,,0000,0000,0000,,Сізге
Dialogue: 0,0:20:38.14,0:20:41.14,Default,,0000,0000,0000,,Сізге ұнайтын нәрсені айтуға құқығыңыз жоқ.
Dialogue: 0,0:20:41.14,0:20:45.14,Default,,0000,0000,0000,,Бұл сұрау емес, бұйрық.
Dialogue: 0,0:20:45.14,0:20:48.11,Default,,0000,0000,0000,,Әзірше осы.
Dialogue: 0,0:20:45.14,0:20:48.11,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:20:51.15,0:20:55.15,Default,,0000,0000,0000,,Мен қалжыңдамаймын!
Dialogue: 0,0:20:51.15,0:20:55.15,Default,,0000,0000,0000,,Мен мұндай озбырлықты қабылдай алмаймын!
Dialogue: 0,0:20:55.15,0:20:58.16,Default,,0000,0000,0000,,Жарайды, назар аударыңыздар
Dialogue: 0,0:20:58.16,0:21:01.16,Default,,0000,0000,0000,,Кешіріңіз, бірақ
Dialogue: 0,0:20:58.16,0:21:01.16,Default,,0000,0000,0000,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:21:01.16,0:21:03.16,Default,,0000,0000,0000,,Мен сабырлымын, оғаш ештеңе айтпа!
Dialogue: 0,0:21:03.16,0:21:05.16,Default,,0000,0000,0000,,Бірақ... Бірақ...
Dialogue: 0,0:21:05.16,0:21:10.17,Default,,0000,0000,0000,,Жоғарыдағылармен аздап әрекеттеседі.
Dialogue: 0,0:21:05.16,0:21:10.17,Default,,0000,0000,0000,,Ах... Сато мырза!
Dialogue: 0,0:21:10.17,0:21:12.10,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:21:12.10,0:21:14.11,Default,,0000,0000,0000,,《Неге сонша ыстық болады?
Dialogue: 0,0:21:12.10,0:21:14.11,Default,,0000,0000,0000,,Күтілгендей...》
Dialogue: 0,0:21:14.11,0:21:17.11,Default,,0000,0000,0000,,Өйткені бұл іске Мацуда мырза қатысты
Dialogue: 0,0:21:14.11,0:21:17.11,Default,,0000,0000,0000,,Ол сабырлы емес
Dialogue: 0,0:21:17.11,0:21:19.11,Default,,0000,0000,0000,,Ширатори мырза!
Dialogue: 0,0:21:19.11,0:21:22.11,Default,,0000,0000,0000,,Сіз сондайсыз.
Dialogue: 0,0:21:22.11,0:21:24.12,Default,,0000,0000,0000,,Eh... yeah...
Dialogue: 0,0:21:24.12,0:21:27.12,Default,,0000,0000,0000,,Мацуда мырзаның визиткасына қараған соң
Dialogue: 0,0:21:24.12,0:21:27.12,Default,,0000,0000,0000,,Сато мырза➡️
Dialogue: 0,0:21:27.12,0:21:31.12,Default,,0000,0000,0000,,Мен өзімді айналамды көре алмайтындай сезінемін...
Dialogue: 0,0:21:31.12,0:21:34.13,Default,,0000,0000,0000,,Ширатори мырза, мен мұны бұрын да айтқанмын.
Dialogue: 0,0:21:34.13,0:21:37.13,Default,,0000,0000,0000,,Ол детектив Мацуда туралы айтты.
Dialogue: 0,0:21:34.13,0:21:37.13,Default,,0000,0000,0000,,Сіз оны сүйреп апарғаныңызша➡️
Dialogue: 0,0:21:37.13,0:21:39.13,Default,,0000,0000,0000,,Олар біздің жеңу мүмкіндігіміз жоқ дейді.
Dialogue: 0,0:21:39.13,0:21:43.14,Default,,0000,0000,0000,,О
Dialogue: 0,0:21:39.13,0:21:43.14,Default,,0000,0000,0000,,Бірақ бұл қате болды.
Dialogue: 0,0:21:43.14,0:21:46.14,Default,,0000,0000,0000,,Жеңіске мүмкіндігі жоқ жалғыз мен болдым.
Dialogue: 0,0:21:43.14,0:21:46.14,Default,,0000,0000,0000,,Мені алаңдатқаны — Кираны оның отбасы байқап қалуы мүмкін —
Dialogue: 0,0:21:46.14,0:21:48.14,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:48.14,0:21:52.14,Default,,0000,0000,0000,,Бірақ бұл әлі де жақсы емес.
Dialogue: 0,0:21:48.14,0:21:52.14,Default,,0000,0000,0000,,Мен емес...
Dialogue: 0,0:21:52.14,0:21:56.15,Default,,0000,0000,0000,,Бірақ сіз де ұзақ жолдан өттіңіз.
Dialogue: 0,0:21:52.14,0:21:56.15,Default,,0000,0000,0000,,Шуш! Сәттілік! ?
Dialogue: 0,0:21:56.15,0:22:00.15,Default,,0000,0000,0000,,Өз өміріне қауіп төндіру
Dialogue: 0,0:21:56.15,0:22:00.15,Default,,0000,0000,0000,,Көп адамның өмірін сақтап қалған аты аңызға айналған детективке➡️
Dialogue: 0,0:22:00.15,0:22:02.15,Default,,0000,0000,0000,,Себебі мен қызғанамын
Dialogue: 0,0:22:02.15,0:22:04.16,Default,,0000,0000,0000,,Жоқ, мен қызғанбаймын...
Dialogue: 0,0:22:04.16,0:22:06.16,Default,,0000,0000,0000,,Детектив Мацуданың бұған еш қатысы жоқ.
Dialogue: 0,0:22:06.16,0:22:10.16,Default,,0000,0000,0000,,Егер іс ұрланған болса
Dialogue: 0,0:22:06.16,0:22:10.16,Default,,0000,0000,0000,,Тек оны қайтарыңыз.
Dialogue: 0,0:22:10.16,0:22:14.10,Default,,0000,0000,0000,,Біз асығуымыз керек, Сато мырза.
Dialogue: 0,0:22:10.16,0:22:14.10,Default,,0000,0000,0000,,Мен өзім қоғамдық қауіпсіздікке айғайлаймын.
Dialogue: 0,0:22:14.10,0:22:19.10,Default,,0000,0000,0000,,Ах... Кешіріңіз.
Dialogue: 0,0:22:14.10,0:22:19.10,Default,,0000,0000,0000,,Сізге көп рахмет!
Dialogue: 0,0:22:19.10,0:22:21.11,Default,,0000,0000,0000,,《Ал, сенің махаббат жолың➡️
Dialogue: 0,0:22:21.11,0:22:23.11,Default,,0000,0000,0000,,Қатты алаңдатты
Dialogue: 0,0:22:21.11,0:22:23.11,Default,,0000,0000,0000,,Себебі менде теріс нүкте бар》
Dialogue: 0,0:22:23.11,0:22:25.11,Default,,0000,0000,0000,, (Әдіс режимі)
Dialogue: 0,0:22:25.11,0:22:27.08,Default,,0000,0000,0000,,А, Кобаяши мырза
Dialogue: 0,0:22:29.11,0:22:34.12,Default,,0000,0000,0000,,Сүйектері сынбаған.
Dialogue: 0,0:22:29.11,0:22:34.12,Default,,0000,0000,0000,,Мен басымды қатты ұрған сияқтымын.
Dialogue: 0,0:22:34.12,0:22:38.12,Default,,0000,0000,0000,,Ертең мені басқа ауруханаға ауыстырады.
Dialogue: 0,0:22:34.12,0:22:38.12,Default,,0000,0000,0000,,Маған егжей-тегжейлі тексеруден өтетінін айтты.
Dialogue: 0,0:22:38.12,0:22:40.13,Default,,0000,0000,0000,,《Аға…》
Dialogue: 0,0:22:38.12,0:22:40.13,Default,,0000,0000,0000,,⚟
Dialogue: 0,0:22:40.13,0:22:43.13,Default,,0000,0000,0000,,…бірақ ол құламайды!
Dialogue: 0,0:22:40.13,0:22:43.13,Default,,0000,0000,0000,,⚟Иә
Dialogue: 0,0:22:43.13,0:22:46.13,Default,,0000,0000,0000,,А, сен қайсысысың?
Dialogue: 0,0:22:46.13,0:22:49.13,Default,,0000,0000,0000,,Менің атым Цутому Муранака.
Dialogue: 0,0:22:46.13,0:22:49.13,Default,,0000,0000,0000,,Бұл менің күйеуімнің...
Dialogue: 0,0:22:49.13,0:22:52.14,Default,,0000,0000,0000,,(Кристина)
Dialogue: 0,0:22:49.13,0:22:52.14,Default,,0000,0000,0000,,Мен Кристин Ричардпын.
Dialogue: 0,0:22:52.14,0:22:54.14,Default,,0000,0000,0000,,Муранака мырза мен Кристин мырза...
Dialogue: 0,0:22:54.14,0:22:58.11,Default,,0000,0000,0000,,Ах, кешегі тренинг!
Dialogue: 0,0:22:54.14,0:22:58.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:00.15,0:23:02.15,Default,,0000,0000,0000,,Мегур осындай нәрсе жасады...
Dialogue: 0,0:23:02.15,0:23:04.15,Default,,0000,0000,0000,,Бұл барлығына да қатысты.
Dialogue: 0,0:23:02.15,0:23:04.15,Default,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз➡️
Dialogue: 0,0:23:04.15,0:23:06.15,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:23:04.15,0:23:06.15,Default,,0000,0000,0000,,Аа жоқ➡️
Dialogue: 0,0:23:06.15,0:23:08.15,Default,,0000,0000,0000,,Бірлесіп әрекет етіп жатыр ма?
Dialogue: 0,0:23:08.15,0:23:10.16,Default,,0000,0000,0000,,Кішкене ғана
Dialogue: 0,0:23:08.15,0:23:10.16,Default,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:23:10.16,0:23:12.09,Default,,0000,0000,0000,,Шынында да, сен бөлексің…
Dialogue: 0,0:23:10.16,0:23:12.09,Default,,0000,0000,0000,,Мен де кешірім сұраймын.
Dialogue: 0,0:23:12.09,0:23:17.10,Default,,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:23:12.09,0:23:17.10,Default,,0000,0000,0000,,А, сен жапон тілін жақсы білесің.
Dialogue: 0,0:23:17.10,0:23:19.10,Default,,0000,0000,0000,,Менің ата-анам да француз➡️
Dialogue: 0,0:23:19.10,0:23:22.10,Default,,0000,0000,0000,,Хатачи
Dialogue: 0,0:23:19.10,0:23:22.10,Default,,0000,0000,0000,,Жиырма жасымнан
Dialogue: 0,0:23:19.10,0:23:22.10,Default,,0000,0000,0000,,Жапонияда тұру
Dialogue: 0,0:23:22.10,0:23:27.11,Default,,0000,0000,0000,,Мен оны ауруханада кездестірдім.
Dialogue: 0,0:23:22.10,0:23:27.11,Default,,0000,0000,0000,,Иық жарақатымен ауруханаға түскенде.
Dialogue: 0,0:23:27.11,0:23:29.11,Default,,0000,0000,0000,,I
Dialogue: 0,0:23:27.11,0:23:29.11,Default,,0000,0000,0000,,Медициналық картаңызды жоғалтып алып, қиындыққа тап болсаңыз➡️
Dialogue: 0,0:23:29.11,0:23:31.11,Default,,0000,0000,0000,,Ол маған тапты.
Dialogue: 0,0:23:31.11,0:23:34.11,Default,,0000,0000,0000,,Ху~ Қандай тағдырлы кездесу!
Dialogue: 0,0:23:34.11,0:23:37.12,Default,,0000,0000,0000,,Міне, солай деп ойлаймын.
Dialogue: 0,0:23:37.12,0:23:39.12,Default,,0000,0000,0000,,Бүгін мұнда не үшін келдің?
Dialogue: 0,0:23:39.12,0:23:44.12,Default,,0000,0000,0000,,Шындығында, қабылдауда, детектив Мори
Dialogue: 0,0:23:39.12,0:23:44.12,Default,,0000,0000,0000,,Маған баяндама жасау тапсырылды.
Dialogue: 0,0:23:44.12,0:23:47.13,Default,,0000,0000,0000,,Мен және ол
Dialogue: 0,0:23:44.12,0:23:47.13,Default,,0000,0000,0000,,Өйткені мен Немури но Когороның үлкен жанкүйерімін.
Dialogue: 0,0:23:47.13,0:23:49.13,Default,,0000,0000,0000,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:23:49.13,0:23:53.13,Default,,0000,0000,0000,,Мен мұны мүлдем кешіре алмаймын.
Dialogue: 0,0:23:49.13,0:23:53.13,Default,,0000,0000,0000,,Детектив Мориді нысанаға алу?
Dialogue: 0,0:23:53.13,0:23:56.13,Default,,0000,0000,0000,,Ah No
Dialogue: 0,0:23:53.13,0:23:56.13,Default,,0000,0000,0000,,Менің әкем көздеген жоқ.
Dialogue: 0,0:23:56.13,0:23:59.14,Default,,0000,0000,0000,,Бомба жарылысынан
Dialogue: 0,0:23:56.13,0:23:59.14,Default,,0000,0000,0000,,Баланы қорғау мақсатында...
Dialogue: 0,0:23:59.14,0:24:01.14,Default,,0000,0000,0000,,Не...
Dialogue: 0,0:24:01.14,0:24:04.14,Default,,0000,0000,0000,,Жәбірленушінің жоғалтқан заттары үшін
Dialogue: 0,0:24:01.14,0:24:04.14,Default,,0000,0000,0000,,Бала байқап қалып, көтеріп алды➡️
Dialogue: 0,0:24:04.14,0:24:06.14,Default,,0000,0000,0000,,Мен оны тапсыруға тырысқанда-ақ
Dialogue: 0,0:24:04.14,0:24:06.14,Default,,0000,0000,0000,,Жалын болды.
Dialogue: 0,0:24:06.14,0:24:09.15,Default,,0000,0000,0000,,Әкем көмектесуге тырысты
Dialogue: 0,0:24:09.15,0:24:12.08,Default,,0000,0000,0000,,Сонда баланы құтқарған батыр сенсің.
Dialogue: 0,0:24:09.15,0:24:12.08,Default,,0000,0000,0000,,Ұйқыдағы Когоро
Dialogue: 0,0:24:12.08,0:24:14.09,Default,,0000,0000,0000,,That's right.
Dialogue: 0,0:24:14.09,0:24:17.09,Default,,0000,0000,0000,,Қиын кезде алға ұмтылу
Dialogue: 0,0:24:14.09,0:24:17.09,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:24:17.09,0:24:21.09,Default,,0000,0000,0000,,Мен оянсам, детектив Мори де
Dialogue: 0,0:24:17.09,0:24:21.09,Default,,0000,0000,0000,,Маған өз сәлеміңізді білдіріңіз.
Dialogue: 0,0:24:21.09,0:24:23.09,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:24:21.09,0:24:23.09,Default,,0000,0000,0000,,
Dialogue: 0,0:24:23.09,0:24:25.10,Default,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:24:23.09,0:24:25.10,Default,,0000,0000,0000,,Бұл туралы айтатын болсақ➡️
Dialogue: 0,0:24:25.10,0:24:28.10,Default,,0000,0000,0000,,Дұрыс айтпадым ба, Крюгер мырза?
Dialogue: 0,0:24:25.10,0:24:28.10,Default,,0000,0000,0000,,Салтанатты шара өткен жер өте әдемі болды.
Dialogue: 0,0:24:25.10,0:24:28.10,Default,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:24:28.10,0:24:31.10,Default,,0000,0000,0000,,Сіз бүкіл Шибуя қаласын көре аласыз
Dialogue: 0,0:24:28.10,0:24:31.10,Default,,0000,0000,0000,,Мен мұны бір көргеннен шештім.
Dialogue: 0,0:24:31.10,0:24:34.11,Default,,0000,0000,0000,,Әй, кеше ауа-райы нашар болды...
Dialogue: 0,0:24:34.11,0:24:37.11,Default,,0000,0000,0000,,Бұл тұман
Dialogue: 0,0:24:34.11,0:24:37.11,Default,,0000,0000,0000,,Сіз жақсы көре алмадыңыз, солай ма?
Dialogue: 0,0:24:37.11,0:24:41.11,Default,,0000,0000,0000,,Ал... Олай болса, ертең бәріңмен кездесеміз.
Dialogue: 0,0:24:37.11,0:24:41.11,Default,,0000,0000,0000,,Сіз экскурсияға келгіңіз келе ме?
Dialogue: 0,0:24:41.11,0:24:44.12,Default,,0000,0000,0000,,Әй, қойшы енді.
Dialogue: 0,0:24:41.11,0:24:44.12,Default,,0000,0000,0000,,Детектив Моури...
Dialogue: 0,0:24:44.12,0:24:47.12,Default,,0000,0000,0000,,Ааа Хэллоуиннің декорациялары
Dialogue: 0,0:24:44.12,0:24:47.12,Default,,0000,0000,0000,,Өте жақсы болса да➡️
Dialogue: 0,0:24:47.12,0:24:51.12,Default,,0000,0000,0000,,Көре алмағаныма өкінемін.
Dialogue: 0,0:24:47.12,0:24:51.12,Default,,0000,0000,0000,,Жақсы емес пе?
Dialogue: 0,0:24:51.12,0:24:54.13,Default,,0000,0000,0000,,Олай десеңіз...
Dialogue: 0,0:24:54.13,0:24:56.09,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:24:54.13,0:24:56.09,Default,,0000,0000,0000,,Аха…
Dialogue: 0,0:24:58.13,0:25:00.10,Default,,0000,0000,0000,,Сіз, Басшының орынбасары, қазір тергеу штабында қанша адам қалғанын білесіз ғой.
Dialogue: 0,0:25:03.13,0:25:05.14,Default,,0000,0000,0000,,Әкем айтты➡️
Dialogue: 0,0:25:05.14,0:25:07.14,Default,,0000,0000,0000,,Муранака мырза
Dialogue: 0,0:25:05.14,0:25:07.14,Default,,0000,0000,0000,,Ол бұрын өте қатал адам еді➡️
Dialogue: 0,0:25:07.14,0:25:11.08,Default,,0000,0000,0000,,Жын-шайтандардың ауылы қорқады деген.
Dialogue: 0,0:25:11.08,0:25:13.08,Default,,0000,0000,0000,,Солай ма? Қазір Муранака мырзадан ➡️
Dialogue: 0,0:25:13.08,0:25:15.08,Default,,0000,0000,0000,,Мен оны елестете алмаймын.
Dialogue: 0,0:25:15.08,0:25:17.08,Default,,0000,0000,0000,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:25:15.08,0:25:17.08,Default,,0000,0000,0000,,Кристинге рахмет➡️
Dialogue: 0,0:25:17.08,0:25:19.08,Default,,0000,0000,0000,,Сіз мейірімді болдыңыз.
Dialogue: 0,0:25:19.08,0:25:24.09,Default,,0000,0000,0000,,Аа, осынша уақыт болды.
Dialogue: 0,0:25:19.08,0:25:24.09,Default,,0000,0000,0000,,Тезірек үйге баруымыз керек пе?
Dialogue: 0,0:25:24.09,0:25:28.09,Default,,0000,0000,0000,,Ран-ничан, мен
Dialogue: 0,0:25:24.09,0:25:28.09,Default,,0000,0000,0000,,Мен доктор Агасамен бірге боламын➡️
Dialogue: 0,0:25:28.09,0:25:31.10,Default,,0000,0000,0000,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,0:25:28.09,0:25:31.10,Default,,0000,0000,0000,,Ағаңның қасында бол
Dialogue: 0,0:25:31.10,0:25:35.10,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:25:31.10,0:25:35.10,Default,,0000,0000,0000,,Мен өзім жақсымын.
Dialogue: 0,0:25:35.10,0:25:38.10,Default,,0000,0000,0000,,Рахмет, онда сақ болыңыз.
Dialogue: 0,0:25:38.10,0:25:40.07,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:25:46.11,0:25:49.11,Default,,0000,0000,0000,,Сіз сондасыз, солай емес пе?
Dialogue: 0,0:25:46.11,0:25:49.11,Default,,0000,0000,0000,,Менен бірдеңе керек пе?
Dialogue: 0,0:25:49.11,0:25:52.08,Default,,0000,0000,0000,,Хмм! ? Хмм...
Dialogue: 0,0:25:56.12,0:25:59.09,Default,,0000,0000,0000,,Жақсы жұмыс~
Dialogue: 0,0:25:56.12,0:25:59.09,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:26:03.13,0:26:06.13,Default,,0000,0000,0000,,Мен... мен де көмектесемін.
Dialogue: 0,0:26:06.13,0:26:10.10,Default,,0000,0000,0000,,Өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:26:06.13,0:26:10.10,Default,,0000,0000,0000,,Мен өзімді мәжбүрлеп жатқан жоқпын.
Dialogue: 0,0:26:13.07,0:26:16.07,Default,,0000,0000,0000,,Қылмыскер
Dialogue: 0,0:26:13.07,0:26:16.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:26:16.07,0:26:18.08,Default,,0000,0000,0000,,(Сато)
Dialogue: 0,0:26:16.07,0:26:18.08,Default,,0000,0000,0000,,Сол сериялы бомбалау оқиғасы сияқты➡️
Dialogue: 0,0:26:18.08,0:26:21.08,Default,,0000,0000,0000,,Сондай-ақ жақында
Dialogue: 0,0:26:18.08,0:26:21.08,Default,,0000,0000,0000,,Қасқыр жыпылықтай бастайды...
Dialogue: 0,0:26:21.08,0:26:25.08,Default,,0000,0000,0000,,Демек, дұрыс айтасыз.
Dialogue: 0,0:26:21.08,0:26:25.08,Default,,0000,0000,0000,,Мүмкін тым қызып кеткен шығар.
Dialogue: 0,0:26:25.08,0:26:28.09,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:26:25.08,0:26:28.09,Default,,0000,0000,0000,,Сато мырза...
Dialogue: 0,0:26:28.09,0:26:31.09,Default,,0000,0000,0000,,Мен өзімді осылай сезінгенді қалаймын.
Dialogue: 0,0:26:28.09,0:26:31.09,Default,,0000,0000,0000,,Детектив болуды тез тастаңыз➡️
Dialogue: 0,0:26:31.09,0:26:35.09,Default,,0000,0000,0000,,Такагидің әйеліне
Dialogue: 0,0:26:31.09,0:26:35.09,Default,,0000,0000,0000,,Мен... боламын ба деп ойлаймын.
Dialogue: 0,0:26:35.09,0:26:38.10,Default,,0000,0000,0000,,Мұндай қайғылы нәрсе
Dialogue: 0,0:26:35.09,0:26:38.10,Default,,0000,0000,0000,,Өтінемін, айтпа
Dialogue: 0,0:26:38.10,0:26:40.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:26:38.10,0:26:40.10,Default,,0000,0000,0000,,Детектив істі тастайды➡️
Dialogue: 0,0:26:40.10,0:26:43.10,Default,,0000,0000,0000,,Егер сіз жұмыстан шығып жатырмын десеңіз
Dialogue: 0,0:26:40.10,0:26:43.10,Default,,0000,0000,0000,,Бұл шығын емес пе?
Dialogue: 0,0:26:43.10,0:26:45.10,Default,,0000,0000,0000,,Такаги-кун…
Dialogue: 0,0:26:45.10,0:26:48.11,Default,,0000,0000,0000,,Сато мырзаның жеңілгеніне бәрібір.
Dialogue: 0,0:26:45.10,0:26:48.11,Default,,0000,0000,0000,,Мен оны көргім келмейді
Dialogue: 0,0:26:48.11,0:26:53.11,Default,,0000,0000,0000,,Мен сені жақсы көремін
Dialogue: 0,0:26:48.11,0:26:53.11,Default,,0000,0000,0000,,Менің аңсайтыным…➡️
Dialogue: 0,0:26:53.11,0:26:56.11,Default,,0000,0000,0000,,Ол Мивако Сато, детектив!
Dialogue: 0,0:26:56.11,0:27:00.12,Default,,0000,0000,0000,,А... дұрыс.
Dialogue: 0,0:27:00.12,0:27:02.12,Default,,0000,0000,0000,,Кезбе...
Dialogue: 0,0:27:02.12,0:27:05.12,Default,,0000,0000,0000,,А, бірақ бұл басқа әңгіме.
Dialogue: 0,0:27:02.12,0:27:05.12,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:27:05.12,0:27:10.13,Default,,0000,0000,0000,,Сонымен… бұл…
Dialogue: 0,0:27:05.12,0:27:10.13,Default,,0000,0000,0000,,Сен менің әйелім боласың.
Dialogue: 0,0:27:10.13,0:27:12.00,Default,,0000,0000,0000,,Ондай нәрсе жоқ!
Dialogue: 0,0:27:15.07,0:27:18.04,Default,,0000,0000,0000,,(Көлік есігінің дыбысы)
Dialogue: 0,0:27:20.07,0:27:22.04,Default,,0000,0000,0000,,Түсіңіз.
Dialogue: 0,0:27:35.09,0:27:38.06,Default,,0000,0000,0000,,Nnnnnnn…
Dialogue: 0,0:27:41.09,0:27:46.10,Default,,0000,0000,0000,,☎ (рингтон)
Dialogue: 0,0:27:46.10,0:27:48.10,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:27:48.10,0:27:52.10,Default,,0000,0000,0000,,☎ (Қоңырау үні)
Dialogue: 0,0:27:52.10,0:27:56.11,Default,,0000,0000,0000,,☎Мені осындай жерге әкеліңіз
Dialogue: 0,0:27:52.10,0:27:56.11,Default,,0000,0000,0000,,Нақты нені айтасыз?
Dialogue: 0,0:27:56.11,0:27:59.11,Default,,0000,0000,0000,,Амуро мырза
Dialogue: 0,0:27:59.11,0:28:01.11,Default,,0000,0000,0000,,☎Сен оны біліп қойдың ғой.
Dialogue: 0,0:28:01.11,0:28:04.12,Default,,0000,0000,0000,,Оқиға қалалық полиция департаментінің алдында болды
Dialogue: 0,0:28:01.11,0:28:04.12,Default,,0000,0000,0000,,Шетелдіктердің өртеніп кеткен өлімін тергеу➡️
Dialogue: 0,0:28:04.12,0:28:07.12,Default,,0000,0000,0000,,Ол тоқтатылды.
Dialogue: 0,0:28:04.12,0:28:07.12,Default,,0000,0000,0000,,Себебі мен оны естідім.
Dialogue: 0,0:28:07.12,0:28:11.06,Default,,0000,0000,0000,,Мұны кім жасай алады?
Dialogue: 0,0:28:07.12,0:28:11.06,Default,,0000,0000,0000,,Сіз өте күшті адамсыз ба немесе...
Dialogue: 0,0:28:11.06,0:28:13.06,Default,,0000,0000,0000,,☎(Amuro) Қоғамдық қауіпсіздік
Dialogue: 0,0:28:13.06,0:28:18.06,Default,,0000,0000,0000,,☎Ол осы оқиғада қызметтік міндетін атқару кезінде қаза тапты.
Dialogue: 0,0:28:13.06,0:28:18.06,Default,,0000,0000,0000,,Детектив Мацуда қатысады➡️
Dialogue: 0,0:28:18.06,0:28:21.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:28:18.06,0:28:21.07,Default,,0000,0000,0000,,Мен онымен бір уақытта полиция академиясында болдым.
Dialogue: 0,0:28:21.07,0:28:24.07,Default,,0000,0000,0000,,☎Сонымен қатар, осы мәселе бойынша
Dialogue: 0,0:28:21.07,0:28:24.07,Default,,0000,0000,0000,,Бірінші тергеу бөлімінің детективі Сато➡️
Dialogue: 0,0:28:24.07,0:28:26.07,Default,,0000,0000,0000,,Детектив Такаги қозғала бастады.
Dialogue: 0,0:28:26.07,0:28:29.07,Default,,0000,0000,0000,,☎ Жағдайды қарастыру
Dialogue: 0,0:28:26.07,0:28:29.07,Default,,0000,0000,0000,,Жауап жақын арада келеді.
Dialogue: 0,0:28:29.07,0:28:32.08,Default,,0000,0000,0000,,Осы уақытқа дейін оқығаннан кейін,
Dialogue: 0,0:28:29.07,0:28:32.08,Default,,0000,0000,0000,,Әдейі жалғыз болу➡️
Dialogue: 0,0:28:32.08,0:28:36.08,Default,,0000,0000,0000,,Біздің ұсталуымызға мүмкіндік туғызды.
Dialogue: 0,0:28:36.08,0:28:41.09,Default,,0000,0000,0000,,☎Сіз кімсіз?
Dialogue: 0,0:28:36.08,0:28:41.09,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:28:41.09,0:28:44.09,Default,,0000,0000,0000,,Одан да көп
Dialogue: 0,0:28:41.09,0:28:44.09,Default,,0000,0000,0000,,Бұл қандай нысан?
Dialogue: 0,0:28:44.09,0:28:46.09,Default,,0000,0000,0000,,☎ (Амуро)
Dialogue: 0,0:28:44.09,0:28:46.09,Default,,0000,0000,0000,,Қоғамдық қауіпсіздікке тиесілі жерасты баспанасы
Dialogue: 0,0:28:46.09,0:28:50.10,Default,,0000,0000,0000,,☎Мені мен сені ажырататын шыны
Dialogue: 0,0:28:46.09,0:28:50.10,Default,,0000,0000,0000,,Арнайы шыңдалған шыны
Dialogue: 0,0:28:50.10,0:28:52.10,Default,,0000,0000,0000,,☎ Сондай-ақ радиотолқындарды блоктайды
Dialogue: 0,0:28:52.10,0:28:54.10,Default,,0000,0000,0000,,☎Осында
Dialogue: 0,0:28:52.10,0:28:54.10,Default,,0000,0000,0000,,Үлкен жарылыс болса да ➡️
Dialogue: 0,0:28:54.10,0:28:59.10,Default,,0000,0000,0000,,Сіз зиянсызсыз, жер бетінде басқа ешкім жоқ
Dialogue: 0,0:28:54.10,0:28:59.10,Default,,0000,0000,0000,,Бұл туралы білмеймін
Dialogue: 0,0:28:59.10,0:29:01.11,Default,,0000,0000,0000,,☎Ол жаға тәрізді нәрсе...
Dialogue: 0,0:29:01.11,0:29:03.11,Default,,0000,0000,0000,,Иә, бұл бомба.
Dialogue: 0,0:29:03.11,0:29:06.11,Default,,0000,0000,0000,,Оның уақыттық түрі немесе сымсыз түрі екені белгісіз.
Dialogue: 0,0:29:06.11,0:29:08.11,Default,,0000,0000,0000,,Мен оны қалай бөлшектеу керектігін де білмеймін.
Dialogue: 0,0:29:08.11,0:29:11.05,Default,,0000,0000,0000,,Кешіріңіз, бірақ кешіріңіз.
Dialogue: 0,0:29:11.05,0:29:13.05,Default,,0000,0000,0000,,Бірінші тергеу бөлімінің детективтері➡️
Dialogue: 0,0:29:13.05,0:29:15.05,Default,,0000,0000,0000,,Мені көргіңіз келетін нәрсе
Dialogue: 0,0:29:13.05,0:29:15.05,Default,,0000,0000,0000,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:29:15.05,0:29:18.06,Default,,0000,0000,0000,,☎Бірақ бұл
Dialogue: 0,0:29:15.05,0:29:18.06,Default,,0000,0000,0000,,Біз кездесе алмаймыз, солай ма?
Dialogue: 0,0:29:18.06,0:29:21.06,Default,,0000,0000,0000,,☎Және...
Dialogue: 0,0:29:18.06,0:29:21.06,Default,,0000,0000,0000,,Беттері сынғанда➡️
Dialogue: 0,0:29:21.06,0:29:24.06,Default,,0000,0000,0000,,Жасырын тергеу де сәтсіз.
Dialogue: 0,0:29:21.06,0:29:24.06,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:29:24.06,0:29:27.07,Default,,0000,0000,0000,,«Пуаро» да толық емес жұмыс күні
Dialogue: 0,0:29:24.06,0:29:27.07,Default,,0000,0000,0000,,Маған шығуға тура келеді
Dialogue: 0,0:29:27.07,0:29:29.07,Default,,0000,0000,0000,,☎Сол үшін мені шақырдыңыз
Dialogue: 0,0:29:29.07,0:29:32.07,Default,,0000,0000,0000,,Мен білетін ақпарат
Dialogue: 0,0:29:29.07,0:29:32.07,Default,,0000,0000,0000,,Барлығын айт
Dialogue: 0,0:29:32.07,0:29:35.07,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:29:32.07,0:29:35.07,Default,,0000,0000,0000,,1-ші бөлімнің тергеуімен ынтымақтасуыңызды сұраймыз.
Dialogue: 0,0:29:35.07,0:29:38.08,Default,,0000,0000,0000,,3 жыл бұрын 6 қарашада➡️
Dialogue: 0,0:29:38.08,0:29:41.08,Default,,0000,0000,0000,,Амуро мырза
Dialogue: 0,0:29:38.08,0:29:41.08,Default,,0000,0000,0000,,Сіз детектив Мацуданы кездестірдіңіз, солай ма?
Dialogue: 0,0:29:41.08,0:29:43.08,Default,,0000,0000,0000,,☎Аа, мен сені кездестірдім.
Dialogue: 0,0:29:43.08,0:29:46.05,Default,,0000,0000,0000,,4 адаммен бірге болғанымызға біраз болды.
Dialogue: 0,0:29:55.09,0:29:58.10,Default,,0000,0000,0000,,Күні
Dialogue: 0,0:29:55.09,0:29:58.10,Default,,0000,0000,0000,,｟О, менің...｠
Dialogue: 0,0:29:55.09,0:29:58.10,Default,,0000,0000,0000,,｜Сіз кешіктіңіз｠
Dialogue: 0,0:29:58.10,0:30:01.10,Default,,0000,0000,0000,,Морофуши
Dialogue: 0,0:29:58.10,0:30:01.10,Default,,0000,0000,0000,,(Моробуши)
Dialogue: 0,0:29:58.10,0:30:01.10,Default,,0000,0000,0000,,｟Мен сені Мацуда келмейді деп ойладым｠
Dialogue: 0,0:30:01.10,0:30:03.10,Default,,0000,0000,0000,,｟жаман жаман
Dialogue: 0,0:30:01.10,0:30:03.10,Default,,0000,0000,0000,,Оқиғадағы оқиға➡️
Dialogue: 0,0:30:03.10,0:30:05.10,Default,,0000,0000,0000,,Мен қашып құтыла алмаймын｠
Dialogue: 0,0:30:05.10,0:30:08.11,Default,,0000,0000,0000,,Соичи
Dialogue: 0,0:30:05.10,0:30:08.11,Default,,0000,0000,0000,,｟Мен оның Соичиге көшкенін естідім.
Dialogue: 0,0:30:05.10,0:30:08.11,Default,,0000,0000,0000,,Өзіңізді қалай сезінесіз? ｠
Dialogue: 0,0:30:08.11,0:30:10.11,Default,,0000,0000,0000,,(Мацуда)
Dialogue: 0,0:30:08.11,0:30:10.11,Default,,0000,0000,0000,,｟Солай｠
Dialogue: 0,0:30:10.11,0:30:13.11,Default,,0000,0000,0000,,｟Мен де келесі айда бастаймын
Dialogue: 0,0:30:10.11,0:30:13.11,Default,,0000,0000,0000,,Себебі мен қалалық полиция департаментіне тағайындалдым➡️
Dialogue: 0,0:30:13.11,0:30:16.11,Default,,0000,0000,0000,,Нашар орындаңыз
Dialogue: 0,0:30:13.11,0:30:16.11,Default,,0000,0000,0000,,Қуып кетпе, Сенпай! ｠
Dialogue: 0,0:30:16.11,0:30:20.12,Default,,0000,0000,0000,,｟Ба-ка Детектив ретінде
Dialogue: 0,0:30:16.11,0:30:20.12,Default,,0000,0000,0000,,Сен менің ағам болсаң да.
Dialogue: 0,0:30:20.12,0:30:24.12,Default,,0000,0000,0000,,｟Бірақ Мацуда келді.
Dialogue: 0,0:30:20.12,0:30:24.12,Default,,0000,0000,0000,,Хагивара да бақытты｠
Dialogue: 0,0:30:24.12,0:30:26.12,Default,,0000,0000,0000,,｟Ол келмеуі мүмкін емес｠
Dialogue: 0,0:30:26.12,0:30:30.09,Default,,0000,0000,0000,,Жоқ… бүгін маған қалдыр.
Dialogue: 0,0:30:26.12,0:30:30.09,Default,,0000,0000,0000,,｟Мен бұл жігіттен кек алуға уәде беремін➡️
Dialogue: 0,0:30:32.13,0:30:35.13,Default,,0000,0000,0000,,Өйткені мен оны әлі орындаған жоқпын.
Dialogue: 0,0:30:35.13,0:30:39.14,Default,,0000,0000,0000,,Келесі күні
Dialogue: 0,0:30:35.13,0:30:39.14,Default,,0000,0000,0000,,Мен мұндай нәрсе болатынына сене алмаймын...
Dialogue: 0,0:30:39.14,0:30:42.14,Default,,0000,0000,0000,,☎Бұл бәрі емес, солай ма?
Dialogue: 0,0:30:39.14,0:30:42.14,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:30:42.14,0:30:44.14,Default,,0000,0000,0000,,Осыдан кейін
Dialogue: 0,0:30:42.14,0:30:44.14,Default,,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:30:44.14,0:30:46.14,Default,,0000,0000,0000,,Бомбаларға қатысты істер
Dialogue: 0,0:30:46.14,0:30:48.15,Default,,0000,0000,0000,,☎Неге олай ойлайсың?
Dialogue: 0,0:30:48.15,0:30:50.15,Default,,0000,0000,0000,,Мен кішкене зерттеу жүргіздім.
Dialogue: 0,0:30:50.15,0:30:53.15,Default,,0000,0000,0000,,Мола орналасқан ғибадатхана
Dialogue: 0,0:30:50.15,0:30:53.15,Default,,0000,0000,0000,,Бұл Шибуяның жанында болды, солай ма?
Dialogue: 0,0:30:53.15,0:30:58.16,Default,,0000,0000,0000,,Сол күні үш жыл бұрын, Шибуядағы көп пәтерлі үйде.
Dialogue: 0,0:30:53.15,0:30:58.16,Default,,0000,0000,0000,,Газдың ағу оқиғасы болды.
Dialogue: 0,0:30:58.16,0:31:02.16,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:30:58.16,0:31:02.16,Default,,0000,0000,0000,,Сіз ойлағандай, сол күні...
Dialogue: 0,0:31:02.16,0:31:06.16,Default,,0000,0000,0000,,｟Мені Шибуя станциясына апарып тастаңыз.
Dialogue: 0,0:31:02.16,0:31:06.16,Default,,0000,0000,0000,,Осыдан кейін мен үйге жалғыз барамын｠
Dialogue: 0,0:31:06.16,0:31:09.17,Default,,0000,0000,0000,,｟Кешіріңіз
Dialogue: 0,0:31:06.16,0:31:09.17,Default,,0000,0000,0000,,Оны тек станцияның алдына жіберіңіз.
Dialogue: 0,0:31:09.17,0:31:11.10,Default,,0000,0000,0000,,｟Иә, дәл Моробуши➡️ сияқты
Dialogue: 0,0:31:11.10,0:31:14.11,Default,,0000,0000,0000,,Көпшіліктің көз алдында болма
Dialogue: 0,0:31:11.10,0:31:14.11,Default,,0000,0000,0000,,Бұл менің ұстанымым болды…｠
Dialogue: 0,0:31:14.11,0:31:17.11,Default,,0000,0000,0000,,｟Бұл жұмыс сияқты.
Dialogue: 0,0:31:14.11,0:31:17.11,Default,,0000,0000,0000,,Детектив
Dialogue: 0,0:31:17.11,0:31:20.11,Default,,0000,0000,0000,,｟ Қандай күн! ｠
Dialogue: 0,0:31:20.11,0:31:23.11,Default,,0000,0000,0000,,Мен және Мацуда
Dialogue: 0,0:31:20.11,0:31:23.11,Default,,0000,0000,0000,,Онда барып әңгіме тыңдағанда➡️
Dialogue: 0,0:31:23.11,0:31:26.12,Default,,0000,0000,0000,,Шамасы
Dialogue: 0,0:31:23.11,0:31:26.12,Default,,0000,0000,0000,,Біреу қараусыз қалған ғимаратқа жасырын кіріп кетті➡️
Dialogue: 0,0:31:26.12,0:31:28.12,Default,,0000,0000,0000,,Ол жабайы жүгіріп бара жатқан сияқты.
Dialogue: 0,0:31:26.12,0:31:28.12,Default,,0000,0000,0000,,Айтыңыз.
Dialogue: 0,0:31:28.12,0:31:31.12,Default,,0000,0000,0000,,Осының алдында қасымда болғандар
Dialogue: 0,0:31:28.12,0:31:31.12,Default,,0000,0000,0000,,Мен сізді қолдауға шақырдым➡️
Dialogue: 0,0:31:31.12,0:31:35.13,Default,,0000,0000,0000,,Олар келгенге дейін
Dialogue: 0,0:31:31.12,0:31:35.13,Default,,0000,0000,0000,,Әзірге бұл мен және Мацуда➡️
Dialogue: 0,0:31:35.13,0:31:38.10,Default,,0000,0000,0000,,Ішінде не бар екенін көрейік.
Dialogue: 0,0:31:35.13,0:31:38.10,Default,,0000,0000,0000,,...
Dialogue: 0,0:31:40.13,0:31:42.10,Default,,0000,0000,0000,,｟Ах! ｠
Dialogue: 0,0:31:44.14,0:31:47.14,Default,,0000,0000,0000,,｜Ол есін жоғалтқан сияқты｠
Dialogue: 0,0:31:47.14,0:31:49.14,Default,,0000,0000,0000,,｟Жапон емес｠
Dialogue: 0,0:31:49.14,0:31:51.14,Default,,0000,0000,0000,,｟Жақсысың ба? ｠
Dialogue: 0,0:31:49.14,0:31:51.14,Default,,0000,0000,0000,,｟Уу... Ах
Dialogue: 0,0:31:51.14,0:31:53.14,Default,,0000,0000,0000,,｟Ааааааааа｠
Dialogue: 0,0:31:53.14,0:31:55.15,Default,,0000,0000,0000,,｟Тынышталыңыз, біз детективпіз｠
Dialogue: 0,0:31:55.15,0:31:59.15,Default,,0000,0000,0000,,｟Детектив
Dialogue: 0,0:31:55.15,0:31:59.15,Default,,0000,0000,0000,,Ке-и-джи! Түсінесіз бе? ｠
Dialogue: 0,0:31:59.15,0:32:01.15,Default,,0000,0000,0000,,(орыс)
Dialogue: 0,0:32:01.15,0:32:03.15,Default,,0000,0000,0000,,｟О? ｠
Dialogue: 0,0:32:01.15,0:32:03.15,Default,,0000,0000,0000,,｜Орыс｠
Dialogue: 0,0:32:03.15,0:32:05.16,Default,,0000,0000,0000,,｜Саған қашу айтқызу｠
Dialogue: 0,0:32:03.15,0:32:05.16,Default,,0000,0000,0000,,｟Алдымен төмен түсіңіз｠
Dialogue: 0,0:32:05.16,0:32:09.16,Default,,0000,0000,0000,,｟Егер сізді полиция тоқтатса
Dialogue: 0,0:32:05.16,0:32:09.16,Default,,0000,0000,0000,,Маған осы визитканы көрсет｠
Dialogue: 0,0:32:09.16,0:32:12.03,Default,,0000,0000,0000,,(орыс)
Dialogue: 0,0:32:15.10,0:32:17.10,Default,,0000,0000,0000,,《Оның күші одан сайын артуда》
Dialogue: 0,0:32:15.10,0:32:17.10,Default,,0000,0000,0000,,｟A｠
Dialogue: 0,0:32:17.10,0:32:19.10,Default,,0000,0000,0000,,《Оның күші одан сайын артуда》
Dialogue: 0,0:32:19.10,0:32:22.07,Default,,0000,0000,0000,,｟Әлі жоқ
Dialogue: 0,0:32:19.10,0:32:22.07,Default,,0000,0000,0000,,Тұтынушы бар сияқты.
Dialogue: 0,0:32:28.11,0:32:34.12,Default,,0000,0000,0000,,｟Күтілгендей
Dialogue: 0,0:32:28.11,0:32:34.12,Default,,0000,0000,0000,,Өзіңізбен бірге ештеңе әкелмеңіз. Қоғамдық қауіпсіздік дегеніміз
Dialogue: 0,0:32:34.12,0:32:36.09,Default,,0000,0000,0000,,｟Қозғалмаңыз! ｠
Dialogue: 0,0:32:43.13,0:32:46.13,Default,,0000,0000,0000,,｟Жаман｠
Dialogue: 0,0:32:43.13,0:32:46.13,Default,,0000,0000,0000,,｟Не? ｠
Dialogue: 0,0:32:46.13,0:32:48.13,Default,,0000,0000,0000,,｟Оның артында бомба бар｠
Dialogue: 0,0:32:48.13,0:32:50.13,Default,,0000,0000,0000,,｟Нашар атсаңыз
Dialogue: 0,0:32:48.13,0:32:50.13,Default,,0000,0000,0000,,Бум мүмкіндігі｠
Dialogue: 0,0:32:50.13,0:32:52.14,Default,,0000,0000,0000,,｟Бұл өлшем
Dialogue: 0,0:32:50.13,0:32:52.14,Default,,0000,0000,0000,,Егер мен осы ғимаратта болсам➡️
Dialogue: 0,0:32:52.14,0:32:54.14,Default,,0000,0000,0000,,Біріншіден, бұл Одабутсу.
Dialogue: 0,0:32:54.14,0:32:57.14,Default,,0000,0000,0000,,｟Оны тоқтатуға бола ма? ｠
Dialogue: 0,0:32:54.14,0:32:57.14,Default,,0000,0000,0000,,｜Оны тоқтату мүмкін емес деп ойлайсыз ба? ｠
Dialogue: 0,0:32:57.14,0:33:00.14,Default,,0000,0000,0000,,｟Хмм… мен оны сұрадым｠
Dialogue: 0,0:33:00.14,0:33:03.11,Default,,0000,0000,0000,,｟Tsk! ｠
Dialogue: 0,0:33:00.14,0:33:03.11,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:33:05.15,0:33:07.12,Default,,0000,0000,0000,,｟ Күте тұрыңыз! ｠
Dialogue: 0,0:33:09.15,0:33:12.09,Default,,0000,0000,0000,,｟Мен оны қуып келемін
Dialogue: 0,0:33:09.15,0:33:12.09,Default,,0000,0000,0000,,Мацуда, бомбаны тез босат! ｠
Dialogue: 0,0:33:12.09,0:33:15.06,Default,,0000,0000,0000,,｟Аа, мен соны сұраймын｠
Dialogue: 0,0:33:12.09,0:33:15.06,Default,,0000,0000,0000,,｟Иә｠
Dialogue: 0,0:33:20.10,0:33:24.10,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:33:24.10,0:33:27.11,Default,,0000,0000,0000,,｟Уау! ｠
Dialogue: 0,0:33:27.11,0:33:30.07,Default,,0000,0000,0000,,(Құлау дыбысы)
Dialogue: 0,0:33:27.11,0:33:30.07,Default,,0000,0000,0000,,(Көлік терезесінің сынған дыбысы)
Dialogue: 0,0:33:39.12,0:33:41.12,Default,,0000,0000,0000,,｟Сіз төмен түстіңіз бе? Ха! ｠
Dialogue: 0,0:33:41.12,0:33:43.12,Default,,0000,0000,0000,,｟Жаман! Мақсат Матсуда ма? ｠
Dialogue: 0,0:33:43.12,0:33:47.13,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:33:43.12,0:33:47.13,Default,,0000,0000,0000,,Иә? ｠
Dialogue: 0,0:33:47.13,0:33:51.13,Default,,0000,0000,0000,,｟Темее... көңілді, көңілді
Dialogue: 0,0:33:47.13,0:33:51.13,Default,,0000,0000,0000,,Бомба бөлшектеліп жатса да➡️
Dialogue: 0,0:33:51.13,0:33:55.13,Default,,0000,0000,0000,,Мазалама! ｠
Dialogue: 0,0:33:51.13,0:33:55.13,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:33:55.13,0:33:57.14,Default,,0000,0000,0000,,｟Топ жетекшісі! ｠
Dialogue: 0,0:33:57.14,0:34:00.10,Default,,0000,0000,0000,,｟Қарусыз, мылтық ұстаған
Dialogue: 0,0:33:57.14,0:34:00.10,Default,,0000,0000,0000,,Бұл керемет! ｠
Dialogue: 0,0:34:04.14,0:34:06.14,Default,,0000,0000,0000,,｟Хиро! ｠
Dialogue: 0,0:34:04.14,0:34:06.14,Default,,0000,0000,0000,,｟Нөл қауіпсіз! ? ｠
Dialogue: 0,0:34:06.14,0:34:08.15,Default,,0000,0000,0000,,｟Кешіріңіз, бұл пайдалы болды! ｠
Dialogue: 0,0:34:08.15,0:34:10.15,Default,,0000,0000,0000,,｟Ол оны жойды.
Dialogue: 0,0:34:08.15,0:34:10.15,Default,,0000,0000,0000,,Маған көліктің есігін әкеліңіз➡️
Dialogue: 0,0:34:10.15,0:34:12.02,Default,,0000,0000,0000,,Бұл дұрыс жауап болды｠
Dialogue: 0,0:34:14.09,0:34:17.09,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:34:14.09,0:34:17.09,Default,,0000,0000,0000,,｟Күтіңіз! ｠
Dialogue: 0,0:34:17.09,0:34:19.06,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:34:22.09,0:34:24.10,Default,,0000,0000,0000,,｟ Қарғыс атсын! Қат! ｠
Dialogue: 0,0:34:22.09,0:34:24.10,Default,,0000,0000,0000,,｟Уау...｠
Dialogue: 0,0:34:24.10,0:34:27.10,Default,,0000,0000,0000,,｟Екеуіңнен де қашыңдар!
Dialogue: 0,0:34:24.10,0:34:27.10,Default,,0000,0000,0000,,Мен сенің қашып кетуіңе жол бермеймін｠
Dialogue: 0,0:34:27.10,0:34:29.07,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:34:34.11,0:34:37.11,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:34:34.11,0:34:37.11,Default,,0000,0000,0000,,｟Tsk! ｠
Dialogue: 0,0:34:37.11,0:34:39.11,Default,,0000,0000,0000,,｟Топ жетекшісі! сұраңыз! ｠
Dialogue: 0,0:34:39.11,0:34:41.11,Default,,0000,0000,0000,,｟Аа... Шынымен! ｠
Dialogue: 0,0:34:41.11,0:34:43.11,Default,,0000,0000,0000,,｟Ух! ｠
Dialogue: 0,0:34:43.11,0:34:54.13,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:34:54.13,0:34:57.13,Default,,0000,0000,0000,,｟Бұл өте дөрекі...｠
Dialogue: 0,0:34:54.13,0:34:57.13,Default,,0000,0000,0000,,｟Hiro тобының жетекшісі! ｠
Dialogue: 0,0:34:57.13,0:35:00.13,Default,,0000,0000,0000,,｟Бұл жігіттің достары әлі де осында.
Dialogue: 0,0:34:57.13,0:35:00.13,Default,,0000,0000,0000,,жасырынып қалуы мүмкін｠
Dialogue: 0,0:35:00.13,0:35:02.13,Default,,0000,0000,0000,,｟Мацуданы сұра! ｠
Dialogue: 0,0:35:00.13,0:35:02.13,Default,,0000,0000,0000,,｟Оо｠
Dialogue: 0,0:35:02.13,0:35:04.14,Default,,0000,0000,0000,,｟Сіз де абай болғаныңыз жөн! ｠
Dialogue: 0,0:35:02.13,0:35:04.14,Default,,0000,0000,0000,,｟Ах! ｠
Dialogue: 0,0:35:04.14,0:35:07.14,Default,,0000,0000,0000,,｟Топ жетекшісі Мен нөлді қолдаймын｠
Dialogue: 0,0:35:07.14,0:35:09.14,Default,,0000,0000,0000,,｟Ол қарапайым адам емес｠
Dialogue: 0,0:35:09.14,0:35:11.08,Default,,0000,0000,0000,,｜Біреумен жалғыз айналысу
Dialogue: 0,0:35:09.14,0:35:11.08,Default,,0000,0000,0000,,Менің ойымша, бұл қиын｠
Dialogue: 0,0:35:11.08,0:35:15.05,Default,,0000,0000,0000,,｟Жарайды, өтінемін! ｠
Dialogue: 0,0:35:11.08,0:35:15.05,Default,,0000,0000,0000,,｟Ах｠
Dialogue: 0,0:35:36.10,0:35:39.07,Default,,0000,0000,0000,,Шурюдан
Dialogue: 0,0:35:36.10,0:35:39.07,Default,,0000,0000,0000,,《Ха! Граната! 》
Dialogue: 0,0:35:40.10,0:35:44.11,Default,,0000,0000,0000,,｟Дә! Ха! ｠
Dialogue: 0,0:35:44.11,0:35:46.11,Default,,0000,0000,0000,,｜Сіз әлі қашып жүрсіз бе? ｠
Dialogue: 0,0:35:46.11,0:35:48.11,Default,,0000,0000,0000,,｜Сіздің достарыңыз бар шығар｠
Dialogue: 0,0:35:48.11,0:35:50.11,Default,,0000,0000,0000,,｟Жоқ｠
Dialogue: 0,0:35:48.11,0:35:50.11,Default,,0000,0000,0000,,｟Иә? ｠
Dialogue: 0,0:35:50.11,0:35:52.12,Default,,0000,0000,0000,,Егер ｟
Dialogue: 0,0:35:50.11,0:35:52.12,Default,,0000,0000,0000,,Сен мені өлтіру үшін қайтып келмейсің.
Dialogue: 0,0:35:52.12,0:35:54.12,Default,,0000,0000,0000,,｟Сонымен... бұл дұрыс｠
Dialogue: 0,0:35:54.12,0:35:58.12,Default,,0000,0000,0000,,｟Hu…
Dialogue: 0,0:35:54.12,0:35:58.12,Default,,0000,0000,0000,,Топ жетекшісі, сізде сағыз бар ма? ｠
Dialogue: 0,0:35:58.12,0:36:00.12,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:35:58.12,0:36:00.12,Default,,0000,0000,0000,,｜Шайнау зейінді жинақтауға көмектеседі｠
Dialogue: 0,0:36:00.12,0:36:02.13,Default,,0000,0000,0000,,｟Бұл жігіттің бәрі…｠
Dialogue: 0,0:36:02.13,0:36:04.13,Default,,0000,0000,0000,,｟Мен енді топ жетекшісі емеспін.
Dialogue: 0,0:36:04.13,0:36:06.13,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:36:04.13,0:36:06.13,Default,,0000,0000,0000,,｟Na! ｠
Dialogue: 0,0:36:06.13,0:36:16.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:36:16.07,0:36:18.04,Default,,0000,0000,0000,,｟Уф…｠
Dialogue: 0,0:36:23.08,0:36:25.05,Default,,0000,0000,0000,,｟Жақсы…｠
Dialogue: 0,0:36:27.08,0:36:29.05,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:36:33.09,0:36:38.10,Default,,0000,0000,0000,,｟Ха ха ха ха ха...｠
Dialogue: 0,0:36:38.10,0:36:43.10,Default,,0000,0000,0000,,｟Хахаха... Нөл, жақсысың ба? ｠
Dialogue: 0,0:36:43.10,0:36:45.10,Default,,0000,0000,0000,,｟Сәлем… Хиро…｠
Dialogue: 0,0:36:45.10,0:36:47.10,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:36:47.10,0:36:49.11,Default,,0000,0000,0000,,｟Бақыт! ｠
Dialogue: 0,0:36:49.11,0:36:55.11,Default,,0000,0000,0000,,｟Күте тұрыңыз Хиро, ол жарақат алды.
Dialogue: 0,0:36:49.11,0:36:55.11,Default,,0000,0000,0000,,Қалғанын қолдау қызметіне қалдырыңыз｠
Dialogue: 0,0:36:55.11,0:36:59.12,Default,,0000,0000,0000,,｟Жақсысың ба? Нөл｠
Dialogue: 0,0:36:55.11,0:36:59.12,Default,,0000,0000,0000,,｟Ах, сен мені құтқардың, Хиро｠
Dialogue: 0,0:36:59.12,0:37:02.12,Default,,0000,0000,0000,,｟Тіпті аз
Dialogue: 0,0:36:59.12,0:37:02.12,Default,,0000,0000,0000,,Егер сіз оны шайқасаңыз немесе еңкейтсеңіз➡️
Dialogue: 0,0:37:02.12,0:37:04.12,Default,,0000,0000,0000,,Сұйықтық ағып кетті, ол соққы болды.
Dialogue: 0,0:37:04.12,0:37:06.12,Default,,0000,0000,0000,,｟Кешіріңіз
Dialogue: 0,0:37:04.12,0:37:06.12,Default,,0000,0000,0000,,Мен оны сағындым｠
Dialogue: 0,0:37:06.12,0:37:08.13,Default,,0000,0000,0000,,｟Уау! Сенімен бәрі жақсы ма? Нөл
Dialogue: 0,0:37:08.13,0:37:10.13,Default,,0000,0000,0000,,｟Уайымдамаңыз. Жағдай қандай? ｠
Dialogue: 0,0:37:10.13,0:37:13.06,Default,,0000,0000,0000,,｟Бұл да жақсы емес｠
Dialogue: 0,0:37:13.06,0:37:16.07,Default,,0000,0000,0000,,｟Мұны маған қалдырыңыз
Dialogue: 0,0:37:13.06,0:37:16.07,Default,,0000,0000,0000,,Айналадағы адамдарды эвакуациялау｠
Dialogue: 0,0:37:16.07,0:37:18.07,Default,,0000,0000,0000,,｟…бірақ｠
Dialogue: 0,0:37:16.07,0:37:18.07,Default,,0000,0000,0000,,｟Жарайды, алға｠
Dialogue: 0,0:37:18.07,0:37:20.07,Default,,0000,0000,0000,,｜3 минут қалды｠
Dialogue: 0,0:37:20.07,0:37:24.08,Default,,0000,0000,0000,,｟Газдың ағуы немесе басқа қолайлы себеп
Dialogue: 0,0:37:20.07,0:37:24.08,Default,,0000,0000,0000,,Осы ғимараттың айналасын эвакуациялаңыз＠
Dialogue: 0,0:37:24.08,0:37:27.08,Default,,0000,0000,0000,,｟Жарайды, кеттік, Хиро｠
Dialogue: 0,0:37:27.08,0:37:30.08,Default,,0000,0000,0000,,｟Топ жетекшісі де｠
Dialogue: 0,0:37:27.08,0:37:30.08,Default,,0000,0000,0000,,｟Tsk… түсіндім｠
Dialogue: 0,0:37:30.08,0:37:36.09,Default,,0000,0000,0000,,｟Мацуда мен төменде күтемін｠
Dialogue: 0,0:37:36.09,0:37:39.09,Default,,0000,0000,0000,,｟Ааа, мен ешқандай уәде бере алмаймын｠
Dialogue: 0,0:37:39.09,0:37:41.09,Default,,0000,0000,0000,,｟Тез арада кетіңіз! ｠
Dialogue: 0,0:37:41.09,0:38:01.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:38:01.11,0:38:03.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:38:07.12,0:38:10.99,Default,,0000,0000,0000,,｟Ааа... Жоқ...｠
Dialogue: 0,0:38:13.06,0:38:16.03,Default,,0000,0000,0000,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:38:18.06,0:38:21.03,Default,,0000,0000,0000,,｟Na! Ол қашықтан ба? Қат! ｠
Dialogue: 0,0:38:23.07,0:38:26.07,Default,,0000,0000,0000,,《Осындай кезде, егер сіз Хагиді қолдансаңыз...
Dialogue: 0,0:38:23.07,0:38:26.07,Default,,0000,0000,0000,,Ол не істер еді...》
Dialogue: 0,0:38:26.07,0:38:28.07,Default,,0000,0000,0000,,｟Цзиньпэй-чан телефонда! ｠
Dialogue: 0,0:38:28.07,0:38:30.04,Default,,0000,0000,0000,,｟Ха! ｠
Dialogue: 0,0:38:34.08,0:38:37.05,Default,,0000,0000,0000,,(Ұялы телефонның сенсорлық дыбысы)
Dialogue: 0,0:38:41.09,0:38:43.09,Default,,0000,0000,0000,,(Ұялы телефонның сынған дыбысы)
Dialogue: 0,0:38:43.09,0:38:45.09,Default,,0000,0000,0000,,｟Бұл мені қатты суытты...｠
Dialogue: 0,0:38:45.09,0:38:47.09,Default,,0000,0000,0000,,｟Хаги рахмет｠
Dialogue: 0,0:38:47.09,0:38:52.06,Default,,0000,0000,0000,,｟Сіз бұрыннан не істедіңіз
Dialogue: 0,0:38:47.09,0:38:52.06,Default,,0000,0000,0000,,Кенет есіме түсті｠
Dialogue: 0,0:38:55.10,0:38:57.10,Default,,0000,0000,0000,,｟Мен оған бірден еліктедім
Dialogue: 0,0:38:55.10,0:38:57.10,Default,,0000,0000,0000,,Жақсы өтті｠
Dialogue: 0,0:38:57.10,0:38:59.10,Default,,0000,0000,0000,,｟Фу…｠
Dialogue: 0,0:38:59.10,0:39:02.11,Default,,0000,0000,0000,,｟Қабірге келгеніңізге рахмет? ｠
Dialogue: 0,0:39:02.11,0:39:13.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:39:13.05,0:39:19.06,Default,,0000,0000,0000,,Бл…ээ…!!
Dialogue: 0,0:39:13.05,0:39:19.06,Default,,0000,0000,0000,,Бұл төртеуміз бірге болған соңғы күні болды.
Dialogue: 0,0:39:19.06,0:39:22.06,Default,,0000,0000,0000,,Басқаша айтқанда, бұл құрбан болды
Dialogue: 0,0:39:22.06,0:39:24.06,Default,,0000,0000,0000,,☎(Амуро) Сөз жоқ.
Dialogue: 0,0:39:22.06,0:39:24.06,Default,,0000,0000,0000,,Бірақ➡️
Dialogue: 0,0:39:24.06,0:39:27.06,Default,,0000,0000,0000,,Ер адам кім болды?
Dialogue: 0,0:39:24.06,0:39:27.06,Default,,0000,0000,0000,,Менің жеңуімнің себебі…
Dialogue: 0,0:39:27.06,0:39:30.07,Default,,0000,0000,0000,,Іс
Dialogue: 0,0:39:27.06,0:39:30.07,Default,,0000,0000,0000,,Бұл туралы мүлде хабарланған жоқ.
Dialogue: 0,0:39:30.07,0:39:33.07,Default,,0000,0000,0000,,Газ ағып кету апаты ретінде жойылды
Dialogue: 0,0:39:33.07,0:39:37.07,Default,,0000,0000,0000,,☎(Амуро) Қоғамдық қауіпсіздік араласты.
Dialogue: 0,0:39:33.07,0:39:37.07,Default,,0000,0000,0000,,Барлық ақпаратты басшылар мөрмен жауып тастады.
Dialogue: 0,0:39:37.07,0:39:39.08,Default,,0000,0000,0000,,Табылған бомбаға не болды?
Dialogue: 0,0:39:39.08,0:39:42.08,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:39:42.08,0:39:46.08,Default,,0000,0000,0000,,☎(Амуро) Бомба талдауға арналған.
Dialogue: 0,0:39:42.08,0:39:46.08,Default,,0000,0000,0000,,Баспаналардың біріне әкелінді
Dialogue: 0,0:39:46.08,0:39:50.09,Default,,0000,0000,0000,,☎Бірақ компоненттерді талдамас бұрын т.б.
Dialogue: 0,0:39:46.08,0:39:50.09,Default,,0000,0000,0000,,Жұмбақ жарылыс болды➡️
Dialogue: 0,0:39:50.09,0:39:53.09,Default,,0000,0000,0000,,Кім қатысты?
Dialogue: 0,0:39:50.09,0:39:53.09,Default,,0000,0000,0000,,Барлығы қайтыс болды.
Dialogue: 0,0:39:53.09,0:39:56.09,Default,,0000,0000,0000,, (Пошта қоңырау үні)
Dialogue: 0,0:39:53.09,0:39:56.09,Default,,0000,0000,0000,,☎Тергеу үшін қажет болуы мүмкін➡️
Dialogue: 0,0:39:56.09,0:39:59.10,Default,,0000,0000,0000,,Сіз оны тек осы жолы пайдалана аласыз.
Dialogue: 0,0:39:56.09,0:39:59.10,Default,,0000,0000,0000,,Kazami байланыс ақпараты
Dialogue: 0,0:39:59.10,0:40:02.10,Default,,0000,0000,0000,,☎Және
Dialogue: 0,0:39:59.10,0:40:02.10,Default,,0000,0000,0000,,Ол кезде Мацуда оны бөлшектеп жатқан болатын➡️
Dialogue: 0,0:40:02.10,0:40:04.10,Default,,0000,0000,0000,,Бомбаның суреті мен құрылымы
Dialogue: 0,0:40:04.10,0:40:07.10,Default,,0000,0000,0000,,☎Сонымен қатар, менің төрт әріптесім
Dialogue: 0,0:40:04.10,0:40:07.10,Default,,0000,0000,0000,,Мен сізге фото жіберемін
Dialogue: 0,0:40:07.10,0:40:10.11,Default,,0000,0000,0000,,☎Солдан: Морофуши, Мацуда, Күн➡️
Dialogue: 0,0:40:10.11,0:40:12.11,Default,,0000,0000,0000,,Арасында менімен Хагивара.
Dialogue: 0,0:40:12.11,0:40:16.11,Default,,0000,0000,0000,,《Иә? Бұл адам қайда...?
Dialogue: 0,0:40:16.11,0:40:18.12,Default,,0000,0000,0000,,☎ (Амуро)
Dialogue: 0,0:40:16.11,0:40:18.12,Default,,0000,0000,0000,,Қоштасатын уақыт та қалған сияқты.
Dialogue: 0,0:40:18.12,0:40:23.12,Default,,0000,0000,0000,,☎Жау сіз ойлағаннан да қауіпті және қорқынышты.
Dialogue: 0,0:40:18.12,0:40:23.12,Default,,0000,0000,0000,,Сенің де білгеніңді қалаймын.
Dialogue: 0,0:40:23.12,0:40:26.12,Default,,0000,0000,0000,,☎Мен осындаймын
Dialogue: 0,0:40:23.12,0:40:26.12,Default,,0000,0000,0000,,Мен қозғала алмаймын
Dialogue: 0,0:40:26.12,0:40:28.09,Default,,0000,0000,0000,,☎Сәттілік тілеймін
Dialogue: 0,0:40:30.13,0:40:34.13,Default,,0000,0000,0000,,Уау, бұл керемет!
Dialogue: 0,0:40:30.13,0:40:34.13,Default,,0000,0000,0000,,Мен соңғы рет келдім ➡️
Dialogue: 0,0:40:34.13,0:40:37.13,Default,,0000,0000,0000,,Ауа райы қолайсыз
Dialogue: 0,0:40:34.13,0:40:37.13,Default,,0000,0000,0000,,Мен өте жақсы көре алмадым.
Dialogue: 0,0:40:37.13,0:40:39.14,Default,,0000,0000,0000,,А, бар!
Dialogue: 0,0:40:39.14,0:40:41.14,Default,,0000,0000,0000,,Дәмді көрінетін заттарды сататын дүкен бар.
Dialogue: 0,0:40:39.14,0:40:41.14,Default,,0000,0000,0000,,Мен оны көріп тұрмын!
Dialogue: 0,0:40:41.14,0:40:43.14,Default,,0000,0000,0000,,Қайда, қайда?
Dialogue: 0,0:40:43.14,0:40:47.14,Default,,0000,0000,0000,,Шу үшін кешіріңіз.
Dialogue: 0,0:40:43.14,0:40:47.14,Default,,0000,0000,0000,,Бұл жанды және жақсы.
Dialogue: 0,0:40:47.14,0:40:49.15,Default,,0000,0000,0000,,Детектив Моридің жағдайы қалай?
Dialogue: 0,0:40:49.15,0:40:54.15,Default,,0000,0000,0000,,Бүгін таңертең ес жидым.
Dialogue: 0,0:40:49.15,0:40:54.15,Default,,0000,0000,0000,,Мені жақын маңдағы ауруханаға ауыстырды.
Dialogue: 0,0:40:54.15,0:40:56.15,Default,,0000,0000,0000,,Райнер, кейін кездескенше.
Dialogue: 0,0:40:54.15,0:40:56.15,Default,,0000,0000,0000,,Гёи! Ол аурады!
Dialogue: 0,0:40:56.15,0:40:58.16,Default,,0000,0000,0000,,Бірдеңе істе!
Dialogue: 0,0:40:58.16,0:41:01.16,Default,,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:40:58.16,0:41:01.16,Default,,0000,0000,0000,,Анестезия осы уақытқа дейін күшіне енуі керек еді...
Dialogue: 0,0:41:01.16,0:41:03.16,Default,,0000,0000,0000,,Ол да төзімді ме?
Dialogue: 0,0:41:03.16,0:41:06.16,Default,,0000,0000,0000,,Ауырсынуды басатын дәрі тозып кетеді.
Dialogue: 0,0:41:03.16,0:41:06.16,Default,,0000,0000,0000,,Баладай шулап жатырмын.
Dialogue: 0,0:41:06.16,0:41:08.17,Default,,0000,0000,0000,,Хахаха
Dialogue: 0,0:41:06.16,0:41:08.17,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,0:41:08.17,0:41:11.10,Default,,0000,0000,0000,,Қараңдаршы!
Dialogue: 0,0:41:08.17,0:41:11.10,Default,,0000,0000,0000,,Тікұшақ жақын жерде!
Dialogue: 0,0:41:11.10,0:41:15.11,Default,,0000,0000,0000,,Міне, Хикари төбесінде
Dialogue: 0,0:41:11.10,0:41:15.11,Default,,0000,0000,0000,,Сондай-ақ тікұшақ алаңы бар.
Dialogue: 0,0:41:15.11,0:41:18.11,Default,,0000,0000,0000,,Қабылдау аяқталғаннан кейін
Dialogue: 0,0:41:15.11,0:41:18.11,Default,,0000,0000,0000,,Тікұшақпен Токио үстінде➡️
Dialogue: 0,0:41:18.11,0:41:20.11,Default,,0000,0000,0000,,Шуқай
Dialogue: 0,0:41:18.11,0:41:20.11,Default,,0000,0000,0000,,Айналайын деп жатырмын.
Dialogue: 0,0:41:18.11,0:41:20.11,Default,,0000,0000,0000,, (Әдіс режимі)
Dialogue: 0,0:41:20.11,0:41:22.11,Default,,0000,0000,0000,,Я~
Dialogue: 0,0:41:20.11,0:41:22.11,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:41:22.11,0:41:24.11,Default,,0000,0000,0000,,Өте романтикалық!
Dialogue: 0,0:41:22.11,0:41:24.11,Default,,0000,0000,0000,, (Әдіс режимі)
Dialogue: 0,0:41:24.11,0:41:27.12,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:41:24.11,0:41:27.12,Default,,0000,0000,0000,,Иә, не болды?
Dialogue: 0,0:41:27.12,0:41:30.12,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:41:30.12,0:41:34.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:41:30.12,0:41:34.12,Default,,0000,0000,0000,,Мм, осыдан кейін кездесуім бар.
Dialogue: 0,0:41:34.12,0:41:38.13,Default,,0000,0000,0000,,Сәлеметсіз бе? сәлем?
Dialogue: 0,0:41:34.12,0:41:38.13,Default,,0000,0000,0000,,Қарт әже, кіріп келемін.
Dialogue: 0,0:41:38.13,0:41:40.13,Default,,0000,0000,0000,,Менің досым қатты қалайды
Dialogue: 0,0:41:38.13,0:41:40.13,Default,,0000,0000,0000,,Менің сізге бергім келетін бір нәрсем бар➡️
Dialogue: 0,0:41:40.13,0:41:43.13,Default,,0000,0000,0000,,Ол Шибуяда және сенің келгеніңді қалайды.
Dialogue: 0,0:41:43.13,0:41:45.14,Default,,0000,0000,0000,,Бұл проблема болар еді.
Dialogue: 0,0:41:45.14,0:41:48.14,Default,,0000,0000,0000,,Осыдан кейін модератормен
Dialogue: 0,0:41:45.14,0:41:48.14,Default,,0000,0000,0000,,Менің кездесуім бар...
Dialogue: 0,0:41:48.14,0:41:50.14,Default,,0000,0000,0000,,Мен осылай дедім...
Dialogue: 0,0:41:48.14,0:41:50.14,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:41:50.14,0:41:53.14,Default,,0000,0000,0000,,Барамыз ба?
Dialogue: 0,0:41:50.14,0:41:53.14,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:41:53.14,0:41:55.15,Default,,0000,0000,0000,,Бұл жақын жерде, солай ма?
Dialogue: 0,0:41:55.15,0:41:57.15,Default,,0000,0000,0000,,«қаһарман» мамандығы пайда болды
Dialogue: 0,0:41:55.15,0:41:57.15,Default,,0000,0000,0000,,Мені жалғыз қалдырыңыз!
Dialogue: 0,0:41:57.15,0:42:00.15,Default,,0000,0000,0000,,Баламын деп мені кемсітпе!
Dialogue: 0,0:42:00.15,0:42:02.15,Default,,0000,0000,0000,,Сұралған жағдайда
Dialogue: 0,0:42:00.15,0:42:02.15,Default,,0000,0000,0000,,Біз бәрін шешеміз!
Dialogue: 0,0:42:02.15,0:42:06.16,Default,,0000,0000,0000,,Біз ең мықты бірінші сынып оқушыларымыз!
Dialogue: 0,0:42:06.16,0:42:09.16,Default,,0000,0000,0000,,Детектив жігіттер осында!
Dialogue: 0,0:42:09.16,0:42:12.10,Default,,0000,0000,0000,,《Бір кезде
Dialogue: 0,0:42:09.16,0:42:12.10,Default,,0000,0000,0000,,Мен ең күшті болдым》
Dialogue: 0,0:42:12.10,0:42:14.10,Default,,0000,0000,0000,,Мен сізге бір жақсылық сұрасам болады ма?
Dialogue: 0,0:42:14.10,0:42:17.10,Default,,0000,0000,0000,,Мен жаңа ғана картаны электрондық пошта арқылы алдым.
Dialogue: 0,0:42:14.10,0:42:17.10,Default,,0000,0000,0000,,Мен оны қағазға саламын.
Dialogue: 0,0:42:17.10,0:42:20.10,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:42:17.10,0:42:20.10,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:42:20.10,0:42:22.11,Default,,0000,0000,0000,,Барлығына жарай ма?
Dialogue: 0,0:42:22.11,0:42:25.11,Default,,0000,0000,0000,,Менің де барғым келеді.
Dialogue: 0,0:42:22.11,0:42:25.11,Default,,0000,0000,0000,,Мен қайтадан ауруханаға баруым керек.
Dialogue: 0,0:42:25.11,0:42:28.11,Default,,0000,0000,0000,,Бұл таңғы асқа жетеді.
Dialogue: 0,0:42:28.11,0:42:31.12,Default,,0000,0000,0000,,Иә, бұл карта
Dialogue: 0,0:42:28.11,0:42:31.12,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:42:31.12,0:42:34.12,Default,,0000,0000,0000,,Конан-кун да... Иә?
Dialogue: 0,0:42:34.12,0:42:36.12,Default,,0000,0000,0000,,Қайда бара жатырсың? Конан-кун Ай-чан
Dialogue: 0,0:42:36.12,0:42:38.09,Default,,0000,0000,0000,,Гику!
Dialogue: 0,0:42:42.13,0:42:45.13,Default,,0000,0000,0000,,N... міне.
Dialogue: 0,0:42:45.13,0:42:47.13,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:42:47.13,0:42:51.14,Default,,0000,0000,0000,,Ал... мен ойлағаннан басқаша.
Dialogue: 0,0:42:51.14,0:42:55.14,Default,,0000,0000,0000,,Бірақ мен сенімдімін
Dialogue: 0,0:42:51.14,0:42:55.14,Default,,0000,0000,0000,,Бұл 6-қабат.
Dialogue: 0,0:42:55.14,0:42:59.11,Default,,0000,0000,0000,,Жарайды, бәрібір кеттік.
Dialogue: 0,0:42:55.14,0:42:59.11,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:43:03.15,0:43:06.15,Default,,0000,0000,0000,,Ах…
Dialogue: 0,0:43:06.15,0:43:09.15,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:43:06.15,0:43:09.15,Default,,0000,0000,0000,,О
Dialogue: 0,0:43:09.15,0:43:13.09,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:43:09.15,0:43:13.09,Default,,0000,0000,0000,,Кристин атынан➡️
Dialogue: 0,0:43:13.09,0:43:16.09,Default,,0000,0000,0000,,Сыйлық
Dialogue: 0,0:43:13.09,0:43:16.09,Default,,0000,0000,0000,,Оны алуға келген менмін...
Dialogue: 0,0:43:16.09,0:43:19.10,Default,,0000,0000,0000,,Біреу бар ма?
Dialogue: 0,0:43:19.10,0:43:22.10,Default,,0000,0000,0000,,Ешкімнен белгі жоқ.
Dialogue: 0,0:43:22.10,0:43:25.10,Default,,0000,0000,0000,,«Сыйлық жабылған матаның ішінде»
Dialogue: 0,0:43:25.10,0:43:27.10,Default,,0000,0000,0000,,(Гента)
Dialogue: 0,0:43:25.10,0:43:27.10,Default,,0000,0000,0000,,Әй, сіз айтып отырғаныңыз осы емес пе?
Dialogue: 0,0:43:27.10,0:43:30.11,Default,,0000,0000,0000,,Бұл үлкен...
Dialogue: 0,0:43:27.10,0:43:30.11,Default,,0000,0000,0000,,Мен барамын
Dialogue: 0,0:43:30.11,0:43:32.11,Default,,0000,0000,0000,,Балалар, осында күтіңдер.
Dialogue: 0,0:43:30.11,0:43:32.11,Default,,0000,0000,0000,,Ух... иә
Dialogue: 0,0:43:32.11,0:43:34.08,Default,,0000,0000,0000,,Сақ болыңыз
Dialogue: 0,0:43:38.12,0:43:41.12,Default,,0000,0000,0000,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:43:41.12,0:43:44.12,Default,,0000,0000,0000,,Иә? О! ?
Dialogue: 0,0:43:44.12,0:43:48.13,Default,,0000,0000,0000,,Бұл сыйлық па?
Dialogue: 0,0:43:44.12,0:43:48.13,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:43:48.13,0:43:50.13,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:43:50.13,0:43:53.10,Default,,0000,0000,0000,,Бұл бомба! Қазір қашып кет!
Dialogue: 0,0:43:50.13,0:43:53.10,Default,,0000,0000,0000,,Е! ?
Dialogue: 0,0:43:55.13,0:43:57.13,Default,,0000,0000,0000,,біз алғаш рет шетелдік жоғары лауазымды тұлғаны қарсы аламыз…
Dialogue: 0,0:43:55.13,0:43:57.13,Default,,0000,0000,0000,,《Бұл мүлдем тұзақ! 》
Dialogue: 0,0:43:57.13,0:43:59.14,Default,,0000,0000,0000,,Жарылысқа 2 минуттан аз уақыт қалды!
Dialogue: 0,0:43:59.14,0:44:01.14,Default,,0000,0000,0000,,⚟Әйтеуір қашып кетемін
Dialogue: 0,0:43:59.14,0:44:01.14,Default,,0000,0000,0000,,Алдымен түсіңіз!
Dialogue: 0,0:44:01.14,0:44:04.14,Default,,0000,0000,0000,,Бірақ... Бірақ...
Dialogue: 0,0:44:01.14,0:44:04.14,Default,,0000,0000,0000,,⚟Жарайды, тез жүр!
Dialogue: 0,0:44:04.14,0:44:06.14,Default,,0000,0000,0000,,Барайық
Dialogue: 0,0:44:04.14,0:44:06.14,Default,,0000,0000,0000,,Е! ?
Dialogue: 0,0:44:06.14,0:44:08.15,Default,,0000,0000,0000,,Сіз Конанды артта қалдырасыз ба?
Dialogue: 0,0:44:08.15,0:44:12.08,Default,,0000,0000,0000,,Енді мен Эдогава-кунның айтқанын тыңдаймын.
Dialogue: 0,0:44:08.15,0:44:12.08,Default,,0000,0000,0000,,Сенуден басқа амалың жоқ.
Dialogue: 0,0:44:12.08,0:44:14.08,Default,,0000,0000,0000,,Асығыңыз! Менің уақытым жоқ!
Dialogue: 0,0:44:12.08,0:44:14.08,Default,,0000,0000,0000,,Қат!
Dialogue: 0,0:44:14.08,0:44:17.09,Default,,0000,0000,0000,,Конан-кун
Dialogue: 0,0:44:14.08,0:44:17.09,Default,,0000,0000,0000,,Міндетті түрде қашыңыз!
Dialogue: 0,0:44:17.09,0:44:19.09,Default,,0000,0000,0000,,⚟Ах!
Dialogue: 0,0:44:19.09,0:44:22.09,Default,,0000,0000,0000,,(Ысырма дыбысы)
Dialogue: 0,0:44:22.09,0:44:24.06,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:44:28.10,0:44:30.10,Default,,0000,0000,0000,,《Егер сіз осы құбырдан өтсеңіз
Dialogue: 0,0:44:28.10,0:44:30.10,Default,,0000,0000,0000,,Әйтеуір...》
Dialogue: 0,0:44:30.10,0:44:32.07,Default,,0000,0000,0000,,Ах…
Dialogue: 0,0:44:35.11,0:44:38.11,Default,,0000,0000,0000,,《Бомбаның құрылымы дерлік бірдей.
Dialogue: 0,0:44:35.11,0:44:38.11,Default,,0000,0000,0000,,Бара аласыз ба! ? 》
Dialogue: 0,0:44:38.11,0:44:41.11,Default,,0000,0000,0000,,(Гента)
Dialogue: 0,0:44:38.11,0:44:41.11,Default,,0000,0000,0000,,Бұл не болып жатыр!
Dialogue: 0,0:44:41.11,0:44:44.11,Default,,0000,0000,0000,,《Эдогава-кун…》
Dialogue: 0,0:44:41.11,0:44:44.11,Default,,0000,0000,0000,,Сондықтан енді сыртқа шықпаймын.
Dialogue: 0,0:44:44.11,0:44:48.12,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:44:44.11,0:44:48.12,Default,,0000,0000,0000,,Бір нәрсе құлады.
Dialogue: 0,0:44:48.12,0:44:51.12,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:44:51.12,0:44:54.12,Default,,0000,0000,0000,,Барлығыңыз бірлесіп әрекет етіңіздер!
Dialogue: 0,0:44:51.12,0:44:54.12,Default,,0000,0000,0000,,Конан-кун!
Dialogue: 0,0:44:54.12,0:44:56.13,Default,,0000,0000,0000,,Сіз нені айтасыз! ?
Dialogue: 0,0:44:54.12,0:44:56.13,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:44:56.13,0:44:58.13,Default,,0000,0000,0000,,Кәстрөл?
Dialogue: 0,0:44:56.13,0:44:58.13,Default,,0000,0000,0000,,Оны жылжытыңыз!
Dialogue: 0,0:44:58.13,0:45:01.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:44:58.13,0:45:01.10,Default,,0000,0000,0000,,Сізге тек сол мата керек!
Dialogue: 0,0:45:04.13,0:45:07.14,Default,,0000,0000,0000,,Не айтсаң да, сен—
Dialogue: 0,0:45:07.14,0:45:10.14,Default,,0000,0000,0000,,Эдогава-кун
Dialogue: 0,0:45:07.14,0:45:10.14,Default,,0000,0000,0000,,Мүмкіндігінше төмен түс!
Dialogue: 0,0:45:10.14,0:45:13.08,Default,,0000,0000,0000,,Сол биіктікте
Dialogue: 0,0:45:10.14,0:45:13.08,Default,,0000,0000,0000,,Егер сіз оны қабылдасаңыз, бұл көмектеспейді!
Dialogue: 0,0:45:13.08,0:45:16.08,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:45:13.08,0:45:16.08,Default,,0000,0000,0000,,Өтінемін, асығыңыз!
Dialogue: 0,0:45:16.08,0:45:18.08,Default,,0000,0000,0000,,Цубаки горилла емес—
Dialogue: 0,0:45:18.08,0:45:20.08,Default,,0000,0000,0000,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:45:20.08,0:45:23.09,Default,,0000,0000,0000,,(балалар шу шығарады)
Dialogue: 0,0:45:23.09,0:45:26.09,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:45:26.09,0:45:30.09,Default,,0000,0000,0000,,Эдогава-кун!
Dialogue: 0,0:45:26.09,0:45:30.09,Default,,0000,0000,0000,,Атсуши! Керемет...
Dialogue: 0,0:45:30.09,0:45:35.10,Default,,0000,0000,0000,,Ооо... Ооо... Ооооооо! !
Dialogue: 0,0:45:35.10,0:45:37.10,Default,,0000,0000,0000,,Конан!
Dialogue: 0,0:45:35.10,0:45:37.10,Default,,0000,0000,0000,,Мұнда!
Dialogue: 0,0:45:37.10,0:45:41.11,Default,,0000,0000,0000,,Ух... нх!
Dialogue: 0,0:45:41.11,0:45:44.11,Default,,0000,0000,0000,,Иә! иә...
Dialogue: 0,0:45:44.11,0:45:46.11,Default,,0000,0000,0000,,Күте тұрыңыз, осылай!
Dialogue: 0,0:45:46.11,0:45:49.11,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:45:49.11,0:45:52.12,Default,,0000,0000,0000,,Аа... Уау! !
Dialogue: 0,0:45:52.12,0:45:55.12,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:45:52.12,0:45:55.12,Default,,0000,0000,0000,,Камераларға түспейді ғой, иә?
Dialogue: 0,0:45:55.12,0:45:59.12,Default,,0000,0000,0000,,Жақсысың ба? ?
Dialogue: 0,0:45:55.12,0:45:59.12,Default,,0000,0000,0000,,Ах... рахмет.
Dialogue: 0,0:45:59.12,0:46:01.13,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:45:59.12,0:46:01.13,Default,,0000,0000,0000,,Асығыңыз! Жүгіріп кету!
Dialogue: 0,0:46:01.13,0:46:03.13,Default,,0000,0000,0000,,Райнер, кейін кездескенше.
Dialogue: 0,0:46:01.13,0:46:03.13,Default,,0000,0000,0000,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:46:01.13,0:46:03.13,Default,,0000,0000,0000,,Ауырды...
Dialogue: 0,0:46:03.13,0:46:08.10,Default,,0000,0000,0000,,
Dialogue: 0,0:46:03.13,0:46:08.10,Default,,0000,0000,0000,,
Dialogue: 0,0:46:10.13,0:46:12.07,Default,,0000,0000,0000,,А, бұл қауіпті болды...
Dialogue: 0,0:46:12.07,0:46:16.07,Default,,0000,0000,0000,,Бұл жақын қоңырау болды.
Dialogue: 0,0:46:12.07,0:46:16.07,Default,,0000,0000,0000,,Конан-кун, сенің аман болғаныңа қуаныштымын!
Dialogue: 0,0:46:16.07,0:46:18.08,Default,,0000,0000,0000,,Конан-кун, бәріңе!
Dialogue: 0,0:46:18.08,0:46:20.08,Default,,0000,0000,0000,,Ран-нечан
Dialogue: 0,0:46:20.08,0:46:24.08,Default,,0000,0000,0000,,Сіз жарақат алдыңыз ба? Барлығы қауіпсіз! ?
Dialogue: 0,0:46:20.08,0:46:24.08,Default,,0000,0000,0000,,Иә, қалай болғанда да.
Dialogue: 0,0:46:24.08,0:46:27.08,Default,,0000,0000,0000,,Олар бомба қойылғанын айтады.
Dialogue: 0,0:46:24.08,0:46:27.08,Default,,0000,0000,0000,,Бұл рас па? ?
Dialogue: 0,0:46:27.08,0:46:29.09,Default,,0000,0000,0000,,Бұл рас!
Dialogue: 0,0:46:27.08,0:46:29.09,Default,,0000,0000,0000,,Бұл рас! Мен➡️
Dialogue: 0,0:46:29.09,0:46:31.09,Default,,0000,0000,0000,,Мен оны анық көрдім!
Dialogue: 0,0:46:29.09,0:46:31.09,Default,,0000,0000,0000,,Конан-кун бөлмеде...
Dialogue: 0,0:46:31.09,0:46:34.09,Default,,0000,0000,0000,,Бір минут күтіңіз
Dialogue: 0,0:46:31.09,0:46:34.09,Default,,0000,0000,0000,,Бірден олай сөйлеме.
Dialogue: 0,0:46:34.09,0:46:38.06,Default,,0000,0000,0000,,Мен әр адамды мұқият тыңдаймын...
Dialogue: 0,0:46:34.09,0:46:38.06,Default,,0000,0000,0000,, (Әдіс режимі)
Dialogue: 0,0:46:46.10,0:46:48.07,Default,,0000,0000,0000,,Ах…
Dialogue: 0,0:46:52.11,0:46:56.11,Default,,0000,0000,0000,,Сіздің қауіпсіз болғаныңызға өте қуаныштымын.
Dialogue: 0,0:46:52.11,0:46:56.11,Default,,0000,0000,0000,,Өрт шыққан жер➡️
Dialogue: 0,0:46:56.11,0:46:58.12,Default,,0000,0000,0000,,Міне, балалар сендер бардыңдар.
Dialogue: 0,0:46:56.11,0:46:58.12,Default,,0000,0000,0000,,Оны естігенде➡️
Dialogue: 0,0:46:58.12,0:47:01.12,Default,,0000,0000,0000,,Бұл менің қанымды суытып жіберді.
Dialogue: 0,0:47:01.12,0:47:04.12,Default,,0000,0000,0000,,Мен қорықтым
Dialogue: 0,0:47:01.12,0:47:04.12,Default,,0000,0000,0000,,Ол су төгетін құбырға түсті.
Dialogue: 0,0:47:04.12,0:47:06.12,Default,,0000,0000,0000,,Хаа, бұл таңқаларлық.
Dialogue: 0,0:47:06.12,0:47:09.13,Default,,0000,0000,0000,,Сенде менен қарағанда батыл бар.
Dialogue: 0,0:47:06.12,0:47:09.13,Default,,0000,0000,0000,,Хахаха
Dialogue: 0,0:47:09.13,0:47:11.06,Default,,0000,0000,0000,,Ух... Ой...
Dialogue: 0,0:47:09.13,0:47:11.06,Default,,0000,0000,0000,,Иә? Ах
Dialogue: 0,0:47:11.06,0:47:15.07,Default,,0000,0000,0000,,Кристин
Dialogue: 0,0:47:11.06,0:47:15.07,Default,,0000,0000,0000,,Өйткені бізде бәрі жақсы➡️
Dialogue: 0,0:47:15.07,0:47:17.07,Default,,0000,0000,0000,,Көп уайымдамаңыз
Dialogue: 0,0:47:17.07,0:47:19.07,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:47:19.07,0:47:21.07,Default,,0000,0000,0000,,Конан-кун➡️ бойынша
Dialogue: 0,0:47:21.07,0:47:23.07,Default,,0000,0000,0000,,Таймер бомбасы
Dialogue: 0,0:47:21.07,0:47:23.07,Default,,0000,0000,0000,,Кенет іске қосылды ➡️
Dialogue: 0,0:47:23.07,0:47:25.08,Default,,0000,0000,0000,,Бөлменің есігі жабылған кезде
Dialogue: 0,0:47:23.07,0:47:25.08,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:47:25.08,0:47:30.08,Default,,0000,0000,0000,,Кіретін адамдардың болуын қамтамасыз етіңіз
Dialogue: 0,0:47:25.08,0:47:30.08,Default,,0000,0000,0000,,Ол мені өлтірмекші болған шығар.
Dialogue: 0,0:47:30.08,0:47:34.08,Default,,0000,0000,0000,,Кристинге де солай.
Dialogue: 0,0:47:30.08,0:47:34.08,Default,,0000,0000,0000,,Сізбен хабарласқан шақырылғандар кім?
Dialogue: 0,0:47:34.08,0:47:39.09,Default,,0000,0000,0000,,Мен тексердім.
Dialogue: 0,0:47:34.08,0:47:39.09,Default,,0000,0000,0000,,Мен мұндай байланыс жасағаным есімде жоқ...
Dialogue: 0,0:47:39.09,0:47:41.09,Default,,0000,0000,0000,,(Такаги)
Dialogue: 0,0:47:39.09,0:47:41.09,Default,,0000,0000,0000,,Біз сізден сайттың айналасы туралы сұраймыз.
Dialogue: 0,0:47:41.09,0:47:46.10,Default,,0000,0000,0000,,Бомбаны әкелген адам
Dialogue: 0,0:47:41.09,0:47:46.10,Default,,0000,0000,0000,,Біреу қарап тұрған болуы мүмкін
Dialogue: 0,0:47:46.10,0:47:49.10,Default,,0000,0000,0000,,Онда бәрібір.
Dialogue: 0,0:47:46.10,0:47:49.10,Default,,0000,0000,0000,,Чиба мұны істеп жатыр
Dialogue: 0,0:47:49.10,0:47:53.10,Default,,0000,0000,0000,,Шибуя деп аталса да
Dialogue: 0,0:47:49.10,0:47:53.10,Default,,0000,0000,0000,,Бұл жерде адамдар көп емес.
Dialogue: 0,0:47:53.10,0:47:56.11,Default,,0000,0000,0000,,Куәгердің үміті төмен ме?
Dialogue: 0,0:47:56.11,0:47:58.11,Default,,0000,0000,0000,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:47:58.11,0:48:02.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:47:58.11,0:48:02.11,Default,,0000,0000,0000,,Эй, жақсысың ба?
Dialogue: 0,0:48:02.11,0:48:04.11,Default,,0000,0000,0000,,Ах! ? Гах...
Dialogue: 0,0:48:04.11,0:48:07.08,Default,,0000,0000,0000,,Жоқ! ? Сен не істеп жатырсың?
Dialogue: 0,0:48:09.12,0:48:12.06,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:48:09.12,0:48:12.06,Default,,0000,0000,0000,,Дея!
Dialogue: 0,0:48:12.06,0:48:16.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:48:12.06,0:48:16.06,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:48:16.06,0:48:19.03,Default,,0000,0000,0000,,(соққы дыбысы)
Dialogue: 0,0:48:16.06,0:48:19.03,Default,,0000,0000,0000,,Уф! Гаха…
Dialogue: 0,0:48:26.07,0:48:30.07,Default,,0000,0000,0000,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:48:26.07,0:48:30.07,Default,,0000,0000,0000,,Егер тағы бірдеңе білсеңіз, маған хабарлаңыз.
Dialogue: 0,0:48:30.07,0:48:35.08,Default,,0000,0000,0000,,Кешіріңіз, Мегур
Dialogue: 0,0:48:30.07,0:48:35.08,Default,,0000,0000,0000,,Маған қазір үйге баруға рұқсат бере аласыз ба?
Dialogue: 0,0:48:35.08,0:48:37.08,Default,,0000,0000,0000,,Ол қатты ренжіді
Dialogue: 0,0:48:37.08,0:48:40.08,Default,,0000,0000,0000,,А, бұл үшін кешіріңіз.
Dialogue: 0,0:48:40.08,0:48:44.09,Default,,0000,0000,0000,,Аа, үйге барсаң болды.
Dialogue: 0,0:48:40.08,0:48:44.09,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:48:44.09,0:48:46.09,Default,,0000,0000,0000,,《Бомба қойылды》
Dialogue: 0,0:48:46.09,0:48:51.09,Default,,0000,0000,0000,,《Бұл үш жыл бұрын Амуро-сан және т.б
Dialogue: 0,0:48:46.09,0:48:51.09,Default,,0000,0000,0000,,Бұл шығарылғанға өте ұқсас болды》
Dialogue: 0,0:48:51.09,0:48:54.10,Default,,0000,0000,0000,,《Бомбада оны жасаған адамның аты бар.
Dialogue: 0,0:48:51.09,0:48:54.10,Default,,0000,0000,0000,,Даралық шығады дейді》
Dialogue: 0,0:48:54.10,0:48:56.10,Default,,0000,0000,0000,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:48:54.10,0:48:56.10,Default,,0000,0000,0000,,《Екі оқиға➡️
Dialogue: 0,0:48:56.10,0:48:58.10,Default,,0000,0000,0000,,Бір қылмыс жасау мүмкіндігі жоғары》
Dialogue: 0,0:48:58.10,0:49:02.11,Default,,0000,0000,0000,,Оған
Dialogue: 0,0:48:58.10,0:49:02.11,Default,,0000,0000,0000,,Мүмкін сізге психикалық күтім керек шығар
Dialogue: 0,0:49:02.11,0:49:04.11,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:49:02.11,0:49:04.11,Default,,0000,0000,0000,,Бұл Чиба-куннан.
Dialogue: 0,0:49:04.11,0:49:06.11,Default,,0000,0000,0000,,Сәлеметсіз бе?
Dialogue: 0,0:49:06.11,0:49:09.08,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:49:06.11,0:49:09.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:49:11.05,0:49:15.05,Default,,0000,0000,0000,,🔊 (дауысты өзгертуші дауыс) Қайта айтыңыз
Dialogue: 0,0:49:11.05,0:49:15.05,Default,,0000,0000,0000,,Детектив Чиба қамауда.
Dialogue: 0,0:49:15.05,0:49:18.06,Default,,0000,0000,0000,,🔊Егер аман-есен оралғанын қаласаңыз
Dialogue: 0,0:49:15.05,0:49:18.06,Default,,0000,0000,0000,,Детектив Цзиньпэй Мацуданы әкеліңіз.
Dialogue: 0,0:49:18.06,0:49:21.06,Default,,0000,0000,0000,,Детектив Мацуда! ?
Dialogue: 0,0:49:18.06,0:49:21.06,Default,,0000,0000,0000,,Мақсаты қандай?
Dialogue: 0,0:49:21.06,0:49:23.06,Default,,0000,0000,0000,,Чиба аман деп үміттенемін! ?
Dialogue: 0,0:49:23.06,0:49:26.06,Default,,0000,0000,0000,,🔊 (дауысты өзгертуші дауыс) Маған қайта хабарласыңыз
Dialogue: 0,0:49:23.06,0:49:26.06,Default,,0000,0000,0000,,🔊 (кесу дыбысы)
Dialogue: 0,0:49:26.06,0:49:28.07,Default,,0000,0000,0000,,Ах…
Dialogue: 0,0:49:28.07,0:49:30.07,Default,,0000,0000,0000,,Ол мені алып кеткісі келсе де...
Dialogue: 0,0:49:30.07,0:49:35.07,Default,,0000,0000,0000,,《Қылмыскердің мақсаты қандай?
Dialogue: 0,0:49:30.07,0:49:35.07,Default,,0000,0000,0000,,Детектив Мацуданы неге қазір шақырып жатырсың...?
Dialogue: 0,0:49:35.07,0:49:37.07,Default,,0000,0000,0000,,《Әрине, бұл жарылыс оқиғасы➡️
Dialogue: 0,0:49:37.07,0:49:40.08,Default,,0000,0000,0000,,Полиция қызметкері қызметтік міндетін атқару кезінде қаза тапты.
Dialogue: 0,0:49:37.07,0:49:40.08,Default,,0000,0000,0000,,Бұл туралы хабарланғандықтан➡️
Dialogue: 0,0:49:40.08,0:49:43.08,Default,,0000,0000,0000,,Детектив Мацуданың аты-жөні
Dialogue: 0,0:49:40.08,0:49:43.08,Default,,0000,0000,0000,,Әлемге шығарылмаған》
Dialogue: 0,0:49:43.08,0:49:46.08,Default,,0000,0000,0000,,《Басқаша айтқанда, оның өлімі
Dialogue: 0,0:49:43.08,0:49:46.08,Default,,0000,0000,0000,,Егер ол белгілі болса...》
Dialogue: 0,0:49:46.08,0:49:51.09,Default,,0000,0000,0000,,Не істеуім керек...
Dialogue: 0,0:49:46.08,0:49:51.09,Default,,0000,0000,0000,,Осылай жалғаса берсе, Чибаның өмірі жойылады.
Dialogue: 0,0:49:51.09,0:49:53.09,Default,,0000,0000,0000,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,0:49:51.09,0:49:53.09,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:49:53.09,0:49:57.09,Default,,0000,0000,0000,,Менің бір ойым бар.
Dialogue: 0,0:49:57.09,0:49:59.10,Default,,0000,0000,0000,,Бірінші тергеу бөлімінің детективі
Dialogue: 0,0:49:57.09,0:49:59.10,Default,,0000,0000,0000,,Ұрлау деген нені білдіреді?➡️
Dialogue: 0,0:49:59.10,0:50:01.10,Default,,0000,0000,0000,,Бұл күтпеген жағдай болды.
Dialogue: 0,0:50:01.10,0:50:04.10,Default,,0000,0000,0000,,☎Конан есімді бала
Dialogue: 0,0:50:01.10,0:50:04.10,Default,,0000,0000,0000,,Суретке түсірілген
Dialogue: 0,0:50:04.10,0:50:08.11,Default,,0000,0000,0000,,☎Мұны көргенше
Dialogue: 0,0:50:04.10,0:50:08.11,Default,,0000,0000,0000,,Үш жыл бұрынғы бомбаға өте ұқсас
Dialogue: 0,0:50:08.11,0:50:11.11,Default,,0000,0000,0000,,Бұл оның бірдей қылмыс екенін білдіре ме?
Dialogue: 0,0:50:11.11,0:50:13.11,Default,,0000,0000,0000,,☎(Казами) Ол туралы материалдар
Dialogue: 0,0:50:11.11,0:50:13.11,Default,,0000,0000,0000,,Қазірдің өзінде сіздің қолыңызда ма?
Dialogue: 0,0:50:13.11,0:50:18.12,Default,,0000,0000,0000,,Жоғарғы басшылық өте шыдамдылық танытты.
Dialogue: 0,0:50:13.11,0:50:18.12,Default,,0000,0000,0000,,Жаңа ғана келді.
Dialogue: 0,0:50:18.12,0:50:21.12,Default,,0000,0000,0000,,☎Конан жинаған
Dialogue: 0,0:50:18.12,0:50:21.12,Default,,0000,0000,0000,,Сұйық мылтық ше?
Dialogue: 0,0:50:21.12,0:50:23.12,Default,,0000,0000,0000,,Қазіргі уақытта талдау жүргізілуде
Dialogue: 0,0:50:23.12,0:50:26.12,Default,,0000,0000,0000,,Ол аяқтала салысымен
Dialogue: 0,0:50:23.12,0:50:26.12,Default,,0000,0000,0000,,Бейтараптандырғышты жасауды бастаңыз
Dialogue: 0,0:50:26.12,0:50:29.13,Default,,0000,0000,0000,,(Амуро)
Dialogue: 0,0:50:26.12,0:50:29.13,Default,,0000,0000,0000,,Өз өмірін қатерге тігіп, оны жинап алды ➡️
Dialogue: 0,0:50:29.13,0:50:31.13,Default,,0000,0000,0000,,Босауға болмайды
Dialogue: 0,0:50:31.13,0:50:34.13,Default,,0000,0000,0000,,Енді не істейсіз?
Dialogue: 0,0:50:31.13,0:50:34.13,Default,,0000,0000,0000,,☎(Amuro) 1-бөліммен➡️ бірлесіп
Dialogue: 0,0:50:34.13,0:50:37.13,Default,,0000,0000,0000,,Ұрланған детектив
Dialogue: 0,0:50:34.13,0:50:37.13,Default,,0000,0000,0000,,Оны аман-есен қайтарыңыз.
Dialogue: 0,0:50:37.13,0:50:41.14,Default,,0000,0000,0000,,☎The information we have is
Dialogue: 0,0:50:37.13,0:50:41.14,Default,,0000,0000,0000,,Сіз бәрін аша аласыз.
Dialogue: 0,0:50:41.14,0:50:44.14,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:50:44.14,0:50:47.14,Default,,0000,0000,0000,,《Әзірге
Dialogue: 0,0:50:44.14,0:50:47.14,Default,,0000,0000,0000,,We also tried our best.
Dialogue: 0,0:50:47.14,0:50:50.15,Default,,0000,0000,0000,,《Енді, сен қалай қозғаласың? 》
Dialogue: 0,0:50:50.15,0:50:53.15,Default,,0000,0000,0000,,Сіз байсалдысыз ба? ? Бұл өте қауіпті!
Dialogue: 0,0:50:53.15,0:50:58.16,Default,,0000,0000,0000,,Мен тәуекелдерді білемін.
Dialogue: 0,0:50:53.15,0:50:58.16,Default,,0000,0000,0000,,Сонымен қатар жасырын микрофон мен таратқышты қосыңыз.
Dialogue: 0,0:50:58.16,0:51:00.16,Default,,0000,0000,0000,,If something happens, immediately
Dialogue: 0,0:50:58.16,0:51:00.16,Default,,0000,0000,0000,,Біз асығу үшін...
Dialogue: 0,0:51:00.16,0:51:03.16,Default,,0000,0000,0000,,Уақытында үлгермесеңіз
Dialogue: 0,0:51:00.16,0:51:03.16,Default,,0000,0000,0000,,Сіз не істемексіз? ?
Dialogue: 0,0:51:03.16,0:51:08.17,Default,,0000,0000,0000,,Үш жыл бұрынғыдай қайталанса...
Dialogue: 0,0:51:03.16,0:51:08.17,Default,,0000,0000,0000,,Сато-кун!
Dialogue: 0,0:51:08.17,0:51:13.10,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:51:08.17,0:51:13.10,Default,,0000,0000,0000,,I have relatively bad luck.
Dialogue: 0,0:51:13.10,0:51:19.11,Default,,0000,0000,0000,,What can help Chiba in this situation?
Dialogue: 0,0:51:13.10,0:51:19.11,Default,,0000,0000,0000,,Бұл мен ғана
Dialogue: 0,0:51:19.11,0:51:23.11,Default,,0000,0000,0000,,Now from Mr. Kazami of Public Security.
Dialogue: 0,0:51:19.11,0:51:23.11,Default,,0000,0000,0000,,Request for cooperation in investigation
Dialogue: 0,0:51:23.11,0:51:26.12,Default,,0000,0000,0000,,Осыдан кейін
Dialogue: 0,0:51:23.11,0:51:26.12,Default,,0000,0000,0000,,Will work jointly with public security
Dialogue: 0,0:51:26.12,0:51:29.12,Default,,0000,0000,0000,,Чиба кез келген жағдайда
Dialogue: 0,0:51:26.12,0:51:29.12,Default,,0000,0000,0000,,We'll get it back safely!
Dialogue: 0,0:51:29.12,0:51:32.12,Default,,0000,0000,0000,,Иә! кеттік
Dialogue: 0,0:51:29.12,0:51:32.12,Default,,0000,0000,0000,,Хмм
Dialogue: 0,0:51:32.12,0:51:35.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:32.12,0:51:35.13,Default,,0000,0000,0000,,Мен сенің өлуіңе ешқашан жол бермеймін
Dialogue: 0,0:51:35.13,0:51:37.13,Default,,0000,0000,0000,,Hey Detective Sato
Dialogue: 0,0:51:35.13,0:51:37.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:37.13,0:51:41.13,Default,,0000,0000,0000,,Бұл қалалық полиция департаментінің алдында болды.
Dialogue: 0,0:51:37.13,0:51:41.13,Default,,0000,0000,0000,,Evidence from the bombing incident?
Dialogue: 0,0:51:41.13,0:51:43.13,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:51:41.13,0:51:43.13,Default,,0000,0000,0000,,Кейінірек бұталарда➡️
Dialogue: 0,0:51:43.13,0:51:47.14,Default,,0000,0000,0000,,I think I found it.
Dialogue: 0,0:51:43.13,0:51:47.14,Default,,0000,0000,0000,,Бұл қандай да бір естелік ме деп ойлаймын.
Dialogue: 0,0:51:47.14,0:51:51.14,Default,,0000,0000,0000,,｟«Мен біреуге айтқым келеді
Dialogue: 0,0:51:47.14,0:51:51.14,Default,,0000,0000,0000,,Бұл өте маңызды естелік''
Dialogue: 0,0:51:51.14,0:51:56.15,Default,,0000,0000,0000,,《Мен детектив Мацудаға осыны көрсеткім келді.
Dialogue: 0,0:51:51.14,0:51:56.15,Default,,0000,0000,0000,,Хабар? 》
Dialogue: 0,0:51:56.15,0:51:58.11,Default,,0000,0000,0000,,(Russian for Elenika)
Dialogue: 0,0:52:00.15,0:52:02.15,Default,,0000,0000,0000,,(Орыс Григорий)
Dialogue: 0,0:52:02.15,0:52:04.12,Default,,0000,0000,0000,,
Dialogue: 0,0:52:10.16,0:52:14.10,Default,,0000,0000,0000,,So gather them in a place like this.
Dialogue: 0,0:52:10.16,0:52:14.10,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:52:14.10,0:52:16.10,Default,,0000,0000,0000,,Information exchange
Dialogue: 0,0:52:16.10,0:52:19.10,Default,,0000,0000,0000,,Huh~ To a man named Furuya
Dialogue: 0,0:52:16.10,0:52:19.10,Default,,0000,0000,0000,,Сізбен кездесуге рұқсат етесіз бе?
Dialogue: 0,0:52:19.10,0:52:23.11,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:52:19.10,0:52:23.11,Default,,0000,0000,0000,,He is now in an isolated facility.
Dialogue: 0,0:52:23.11,0:52:26.11,Default,,0000,0000,0000,,Өйткені оның мойнында бомба бар.
Dialogue: 0,0:52:23.11,0:52:26.11,Default,,0000,0000,0000,,…бірақ ол құламайды!
Dialogue: 0,0:52:26.11,0:52:29.11,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:52:29.11,0:52:33.12,Default,,0000,0000,0000,,Капипа
Dialogue: 0,0:52:29.11,0:52:33.12,Default,,0000,0000,0000,,The serial bomber you arrested➡️
Dialogue: 0,0:52:33.12,0:52:36.12,Default,,0000,0000,0000,,Escaped with someone's guidance
Dialogue: 0,0:52:36.12,0:52:40.12,Default,,0000,0000,0000,,Furuya is pursuing this man.
Dialogue: 0,0:52:36.12,0:52:40.12,Default,,0000,0000,0000,,Attacked by someone➡️
Dialogue: 0,0:52:40.12,0:52:42.13,Default,,0000,0000,0000,,Collar-shaped bomb attached
Dialogue: 0,0:52:42.13,0:52:44.13,Default,,0000,0000,0000,,So who was the man who ran away?
Dialogue: 0,0:52:44.13,0:52:49.13,Default,,0000,0000,0000,,Those worn with Furuya
Dialogue: 0,0:52:44.13,0:52:49.13,Default,,0000,0000,0000,,Бір типті бомба жарылып, ол қаза тапты.
Dialogue: 0,0:52:49.13,0:52:51.13,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:52:49.13,0:52:51.13,Default,,0000,0000,0000,,The series of movements is ➡️
Dialogue: 0,0:52:51.13,0:52:54.14,Default,,0000,0000,0000,,It's a trap set by someone.
Dialogue: 0,0:52:51.13,0:52:54.14,Default,,0000,0000,0000,,Біз қарап отырамыз
Dialogue: 0,0:52:54.14,0:52:56.14,Default,,0000,0000,0000,,Фуруяны азғыру
Dialogue: 0,0:52:56.14,0:52:59.14,Default,,0000,0000,0000,,Analysis results Collar bombs have ➡️
Dialogue: 0,0:52:59.14,0:53:03.15,Default,,0000,0000,0000,,Two-component special explosives
Dialogue: 0,0:52:59.14,0:53:03.15,Default,,0000,0000,0000,,I found out that it was used.
Dialogue: 0,0:53:03.15,0:53:07.15,Default,,0000,0000,0000,,Ұқсас бомбалар
Dialogue: 0,0:53:03.15,0:53:07.15,Default,,0000,0000,0000,,Also used in an incident three years ago
Dialogue: 0,0:53:07.15,0:53:12.09,Default,,0000,0000,0000,,Hmm... So who are you?
Dialogue: 0,0:53:07.15,0:53:12.09,Default,,0000,0000,0000,,Are you guys finding out?
Dialogue: 0,0:53:12.09,0:53:17.09,Default,,0000,0000,0000,,An unknown killer.
Dialogue: 0,0:53:12.09,0:53:17.09,Default,,0000,0000,0000,,Nationality Gender Age All unknown
Dialogue: 0,0:53:17.09,0:53:21.10,Default,,0000,0000,0000,,Although we are active all over the world
Dialogue: 0,0:53:17.09,0:53:21.10,Default,,0000,0000,0000,,Based in Russia➡️
Dialogue: 0,0:53:21.10,0:53:24.10,Default,,0000,0000,0000,,Прамья деп аталады
Dialogue: 0,0:53:21.10,0:53:24.10,Default,,0000,0000,0000,,қорқады
Dialogue: 0,0:53:24.10,0:53:27.10,Default,,0000,0000,0000,,Сәлем, Прамя.
Dialogue: 0,0:53:24.10,0:53:27.10,Default,,0000,0000,0000,,It means flame in Russian.
Dialogue: 0,0:53:27.10,0:53:32.11,Default,,0000,0000,0000,,Ол адам қандай жарылғыш заттарды пайдаланады?
Dialogue: 0,0:53:27.10,0:53:32.11,Default,,0000,0000,0000,,What does it feel like when it explodes?
Dialogue: 0,0:53:32.11,0:53:35.11,Default,,0000,0000,0000,,The boy too
Dialogue: 0,0:53:32.11,0:53:35.11,Default,,0000,0000,0000,,Did you bring me here?
Dialogue: 0,0:53:35.11,0:53:38.11,Default,,0000,0000,0000,,Күдікті бомба
Dialogue: 0,0:53:35.11,0:53:38.11,Default,,0000,0000,0000,,I've seen it twice➡️
Dialogue: 0,0:53:38.11,0:53:41.12,Default,,0000,0000,0000,,It's better to bring
Dialogue: 0,0:53:38.11,0:53:41.12,Default,,0000,0000,0000,,I thought it was early.
Dialogue: 0,0:53:41.12,0:53:43.12,Default,,0000,0000,0000,,So what does a bomb look like?
Dialogue: 0,0:53:43.12,0:53:47.12,Default,,0000,0000,0000,,Жану қуаты да, жарылғыш қуаты да өте күшті.
Dialogue: 0,0:53:47.12,0:53:51.13,Default,,0000,0000,0000,,The moment the liquids mix, they explode.
Dialogue: 0,0:53:47.12,0:53:51.13,Default,,0000,0000,0000,,Өрт тез таралады
Dialogue: 0,0:53:51.13,0:53:55.13,Default,,0000,0000,0000,,Міне, біз көрдік.
Dialogue: 0,0:53:51.13,0:53:55.13,Default,,0000,0000,0000,,Шетелдік болған кездегіге өте ұқсас.
Dialogue: 0,0:53:55.13,0:53:58.13,Default,,0000,0000,0000,,Ол қалалық полиция бөлімінің алдында өлтірілді ме?
Dialogue: 0,0:53:55.13,0:53:58.13,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:53:58.13,0:54:01.14,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:53:58.13,0:54:01.14,Default,,0000,0000,0000,,Неліктен елордалық полиция департаментінің алдында алаңдау керек?
Dialogue: 0,0:54:01.14,0:54:04.14,Default,,0000,0000,0000,,Ойланып қарашы, жәбірленуші
Dialogue: 0,0:54:01.14,0:54:04.14,Default,,0000,0000,0000,,Қалалық полиция бөліміне не үшін бардыңыз➡️
Dialogue: 0,0:54:04.14,0:54:07.14,Default,,0000,0000,0000,,Белгісіз болып қалады
Dialogue: 0,0:54:04.14,0:54:07.14,Default,,0000,0000,0000,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:54:07.14,0:54:09.15,Default,,0000,0000,0000,,Бұл визит карточкасы емес пе?
Dialogue: 0,0:54:09.15,0:54:12.08,Default,,0000,0000,0000,,Мацуда-кун?
Dialogue: 0,0:54:09.15,0:54:12.08,Default,,0000,0000,0000,,Сол шетелдік➡️
Dialogue: 0,0:54:12.08,0:54:14.08,Default,,0000,0000,0000,,Детектив Мацудаға
Dialogue: 0,0:54:12.08,0:54:14.08,Default,,0000,0000,0000,,Мені көруге келмедің бе?
Dialogue: 0,0:54:14.08,0:54:18.09,Default,,0000,0000,0000,,Тәуекелде
Dialogue: 0,0:54:14.08,0:54:18.09,Default,,0000,0000,0000,,Детектив Мацуданың ынтымақтастығы қажет болды
Dialogue: 0,0:54:18.09,0:54:20.09,Default,,0000,0000,0000,,Яғни...
Dialogue: 0,0:54:20.09,0:54:23.09,Default,,0000,0000,0000,,Сол құрбан және осы жолы
Dialogue: 0,0:54:20.09,0:54:23.09,Default,,0000,0000,0000,,Чибаны ұрлап кеткен қылмыскерлер...
Dialogue: 0,0:54:23.09,0:54:25.10,Default,,0000,0000,0000,,Байланыстың қандай да бір түрі
Dialogue: 0,0:54:25.10,0:54:28.10,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:54:25.10,0:54:28.10,Default,,0000,0000,0000,,Бүгінгі көп пәтерлі үйдегі жарылыс оқиғасы➡️
Dialogue: 0,0:54:28.10,0:54:31.10,Default,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:54:28.10,0:54:31.10,Default,,0000,0000,0000,,Прамья қолданған арнайы бомба➡️
Dialogue: 0,0:54:31.10,0:54:34.10,Default,,0000,0000,0000,,Қолданылуы мүмкін
Dialogue: 0,0:54:31.10,0:54:34.10,Default,,0000,0000,0000,,Қымбат екені айтылады.
Dialogue: 0,0:54:34.10,0:54:36.11,Default,,0000,0000,0000,,(Сато)
Dialogue: 0,0:54:34.10,0:54:36.11,Default,,0000,0000,0000,,Конан және басқалары келді➡️
Dialogue: 0,0:54:36.11,0:54:39.11,Default,,0000,0000,0000,,Тіпті Прамья үшін
Dialogue: 0,0:54:36.11,0:54:39.11,Default,,0000,0000,0000,,Бұл күтпеген жағдай болды.
Dialogue: 0,0:54:39.11,0:54:41.11,Default,,0000,0000,0000,,Негізінде, Мұранака мырза мен ханым сонда болды...
Dialogue: 0,0:54:41.11,0:54:44.11,Default,,0000,0000,0000,,Үйлену тойында
Dialogue: 0,0:54:41.11,0:54:44.11,Default,,0000,0000,0000,,Қорқытқан хат келді.
Dialogue: 0,0:54:44.11,0:54:48.12,Default,,0000,0000,0000,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:54:44.11,0:54:48.12,Default,,0000,0000,0000,,Прамьяның нысанасы - Муранака мырза мен ханым...
Dialogue: 0,0:54:48.12,0:54:51.12,Default,,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:54:48.12,0:54:51.12,Default,,0000,0000,0000,,Чибадағы шетелдіктің өртеніп өлу оқиғасы және ұрлау ➡️
Dialogue: 0,0:54:51.12,0:54:54.12,Default,,0000,0000,0000,,Ол қалай қатысады?
Dialogue: 0,0:54:51.12,0:54:54.12,Default,,0000,0000,0000,,Мен әлі білмеймін
Dialogue: 0,0:54:54.12,0:54:57.13,Default,,0000,0000,0000,,Ал Прамя
Dialogue: 0,0:54:54.12,0:54:57.13,Default,,0000,0000,0000,,Фуруя есімді біреу туралы жаңалық бар➡️
Dialogue: 0,0:54:57.13,0:54:59.13,Default,,0000,0000,0000,,Менің білуімше➡️
Dialogue: 0,0:54:59.13,0:55:03.13,Default,,0000,0000,0000,,Мен детектив Мацуданың қызметтік міндетін атқару кезінде қайтыс болғанына сенімдімін.
Dialogue: 0,0:54:59.13,0:55:03.13,Default,,0000,0000,0000,,Менің ойымша, сіз білесіз...
Dialogue: 0,0:55:03.13,0:55:06.14,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:55:03.13,0:55:06.14,Default,,0000,0000,0000,,Фуруя бір топ адамдардан екен➡️
Dialogue: 0,0:55:06.14,0:55:08.14,Default,,0000,0000,0000,,Төрт адам өлді, солай ма?
Dialogue: 0,0:55:08.14,0:55:12.08,Default,,0000,0000,0000,,Детектив Мацудамен
Dialogue: 0,0:55:08.14,0:55:12.08,Default,,0000,0000,0000,,Жарылғыш заттарды залалсыздандыру тобының мүшесі Хагивара➡️
Dialogue: 0,0:55:12.08,0:55:16.08,Default,,0000,0000,0000,,Бомбаны залалсыздандыру кезінде
Dialogue: 0,0:55:12.08,0:55:16.08,Default,,0000,0000,0000,,Детектив Дата жол-көлік оқиғасына ұшырады
Dialogue: 0,0:55:16.08,0:55:18.08,Default,,0000,0000,0000,,Моробуси қандай болды?
Dialogue: 0,0:55:18.08,0:55:20.08,Default,,0000,0000,0000,,《Моробуши? 》
Dialogue: 0,0:55:18.08,0:55:20.08,Default,,0000,0000,0000,,☎(Казами) Кешіріңіз➡️
Dialogue: 0,0:55:20.08,0:55:22.09,Default,,0000,0000,0000,,Бұл өте құпия
Dialogue: 0,0:55:22.09,0:55:24.09,Default,,0000,0000,0000,,☎ (Сато)
Dialogue: 0,0:55:22.09,0:55:24.09,Default,,0000,0000,0000,,Сіз бұрынғыдай құпиясыз.
Dialogue: 0,0:55:24.09,0:55:28.09,Default,,0000,0000,0000,,☎(Казами) Менің айтарым осы ғана.
Dialogue: 0,0:55:24.09,0:55:28.09,Default,,0000,0000,0000,,Бұл іске қатысы жоқ
Dialogue: 0,0:55:28.09,0:55:31.09,Default,,0000,0000,0000,,Менің сенгенімді қалайсың ба?
Dialogue: 0,0:55:28.09,0:55:31.09,Default,,0000,0000,0000,,Бұл апат апат па, әлде бір зұлымның бүлігі ме
Dialogue: 0,0:55:31.09,0:55:34.10,Default,,0000,0000,0000,,Дәл қазір Чиба-кунды құтқару – біздің басты міндетіміз.
Dialogue: 0,0:55:34.10,0:55:38.10,Default,,0000,0000,0000,,Такаги-кун, бұл бомбаны қалай бөлшектеуге болады.
Dialogue: 0,0:55:34.10,0:55:38.10,Default,,0000,0000,0000,,Оны өз басыңызда сақтаңыз
Dialogue: 0,0:55:38.10,0:55:40.10,Default,,0000,0000,0000,,Сіз оны талдап жатырсыз ба?
Dialogue: 0,0:55:40.10,0:55:43.11,Default,,0000,0000,0000,,Материалдарды дереу дайындаңыз
Dialogue: 0,0:55:40.10,0:55:43.11,Default,,0000,0000,0000,,Уау, түсіндім.
Мен айтқым келеді
Dialogue: 0,0:55:43.11,0:55:47.11,Default,,0000,0000,0000,,...
Dialogue: 0,0:55:43.11,0:55:47.11,Default,,0000,0000,0000,,Хмм, шын мәнінде бұл мен➡️
Dialogue: 0,0:55:47.11,0:55:51.11,Default,,0000,0000,0000,,Мен ғылым мен инженерияда мүлде жақсы емеспін.
Dialogue: 0,0:55:47.11,0:55:51.11,Default,,0000,0000,0000,,Оның үстіне мен ебедейсізмін.
Dialogue: 0,0:55:51.11,0:55:54.12,Default,,0000,0000,0000,,Өте жақсы
Dialogue: 0,0:55:51.11,0:55:54.12,Default,,0000,0000,0000,,Мацуда-кун болсам ғой...
Dialogue: 0,0:55:54.12,0:55:59.12,Default,,0000,0000,0000,,Умм, атап айтқанда Мацуда мырза.
Dialogue: 0,0:55:54.12,0:55:59.12,Default,,0000,0000,0000,,Ол қандай болды?
Dialogue: 0,0:55:59.12,0:56:02.13,Default,,0000,0000,0000,,Хмм, бұл жабайы.
Dialogue: 0,0:55:59.12,0:56:02.13,Default,,0000,0000,0000,,Таңқаларлық мейірімді➡️
Dialogue: 0,0:56:02.13,0:56:05.13,Default,,0000,0000,0000,,Шибайну
Dialogue: 0,0:56:02.13,0:56:05.13,Default,,0000,0000,0000,,Шиба Ину мен Доберманды қосу
Dialogue: 0,0:56:02.13,0:56:05.13,Default,,0000,0000,0000,,Менің ойымша, бұл 2-ге бөлінген сияқты.
Dialogue: 0,0:56:05.13,0:56:07.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:56:05.13,0:56:07.13,Default,,0000,0000,0000,, (Әдіс режимі)
Dialogue: 0,0:56:07.13,0:56:11.07,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:56:07.13,0:56:11.07,Default,,0000,0000,0000,, (Әдіс режимі)
Dialogue: 0,0:56:11.07,0:56:13.07,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:56:11.07,0:56:13.07,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:56:13.07,0:56:16.07,Default,,0000,0000,0000,,Сәлеметсіз бе?
Dialogue: 0,0:56:13.07,0:56:16.07,Default,,0000,0000,0000,,🔊 (Дауысты өзгертуші дауыс) Мацуда ауыстырды
Dialogue: 0,0:56:16.07,0:56:19.08,Default,,0000,0000,0000,,Бұл қандай жаман иіс?
Dialogue: 0,0:56:16.07,0:56:19.08,Default,,0000,0000,0000,,Даусыңды естуге рұқсат етесің бе, Чиба-кун?
Dialogue: 0,0:56:19.08,0:56:21.08,Default,,0000,0000,0000,,🔊 (Дауысты өзгертуші дауыс)
Dialogue: 0,0:56:19.08,0:56:21.08,Default,,0000,0000,0000,,Мацуданың орнына бірінші
Dialogue: 0,0:56:21.08,0:56:26.08,Default,,0000,0000,0000,,🔊Түсініп отырғанымда мына тергеушінің даусын естідім.
Dialogue: 0,0:56:21.08,0:56:26.08,Default,,0000,0000,0000,,Сіз оны ешқашан тыңдай алмайсыз.
Dialogue: 0,0:56:26.08,0:56:28.08,Default,,0000,0000,0000,,Сәлеметсіз бе?
Dialogue: 0,0:56:26.08,0:56:28.08,Default,,0000,0000,0000,,🔊 (Дауысты өзгертуші дауыс) Бұдан былай ➡️
Dialogue: 0,0:56:28.08,0:56:30.09,Default,,0000,0000,0000,,Біраз уақытқа
Dialogue: 0,0:56:28.08,0:56:30.09,Default,,0000,0000,0000,,Айтқаныңызды орындаңыз
Dialogue: 0,0:56:30.09,0:56:33.09,Default,,0000,0000,0000,,Мияшита саябағы
Dialogue: 0,0:56:30.09,0:56:33.09,Default,,0000,0000,0000,,🔊 Бірден
Dialogue: 0,0:56:30.09,0:56:33.09,Default,,0000,0000,0000,,MIYASHITA PARK алдына барыңыз
Dialogue: 0,0:56:33.09,0:56:36.09,Default,,0000,0000,0000,,🔊Қайта қоңырау шалыңыз
Dialogue: 0,0:56:33.09,0:56:36.09,Default,,0000,0000,0000,,🔊 (кесу дыбысы)
Dialogue: 0,0:56:36.09,0:56:38.09,Default,,0000,0000,0000,,Кеттік
Dialogue: 0,0:56:36.09,0:56:38.09,Default,,0000,0000,0000,,(Қашықтан басқару пультінің дыбысы)
Dialogue: 0,0:56:38.09,0:56:41.10,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:56:38.09,0:56:41.10,Default,,0000,0000,0000,,Балалар
Dialogue: 0,0:56:38.09,0:56:41.10,Default,,0000,0000,0000,,Бетінде жарылған болуы мүмкін.
Dialogue: 0,0:56:41.10,0:56:44.10,Default,,0000,0000,0000,,Біз оны қуу үшін қоғамдық қауіпсіздік тергеушілерін пайдаланамыз.
Dialogue: 0,0:56:44.10,0:56:48.07,Default,,0000,0000,0000,,Сержант Такагиден басқа
Dialogue: 0,0:56:44.10,0:56:48.07,Default,,0000,0000,0000,,Қашықтан монитордан тексеру
Dialogue: 0,0:56:52.11,0:56:55.08,Default,,0000,0000,0000,,(Тіндерді таратып жатқан әйел)
Dialogue: 0,0:56:52.11,0:56:55.08,Default,,0000,0000,0000,,Өтінемін, өтінемін.
Dialogue: 0,0:57:01.12,0:57:04.12,Default,,0000,0000,0000,,(казами)
Dialogue: 0,0:57:01.12,0:57:04.12,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Күдікті біреу бар ма?
Dialogue: 0,0:57:04.12,0:57:07.12,Default,,0000,0000,0000,,Жоқ, әзірше ештеңе жоқ.
Dialogue: 0,0:57:07.12,0:57:09.13,Default,,0000,0000,0000,,Сақ бол.
Dialogue: 0,0:57:09.13,0:57:11.06,Default,,0000,0000,0000,,Наннин
Dialogue: 0,0:57:09.13,0:57:11.06,Default,,0000,0000,0000,,Кіммен?
Dialogue: 0,0:57:09.13,0:57:11.06,Default,,0000,0000,0000,,Біз қанша адам екенін білмейміз.
Dialogue: 0,0:57:11.06,0:57:13.06,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:57:13.06,0:57:15.06,Default,,0000,0000,0000,,Алдау немесе емдеу!
Dialogue: 0,0:57:15.06,0:57:17.07,Default,,0000,0000,0000,,
Dialogue: 0,0:57:15.06,0:57:17.07,Default,,0000,0000,0000,,Алдау немесе емдеу!
Dialogue: 0,0:57:17.07,0:57:22.07,Default,,0000,0000,0000,,Алдау немесе емдеу!
Dialogue: 0,0:57:17.07,0:57:22.07,Default,,0000,0000,0000,,Алдау немесе емдеу!
Dialogue: 0,0:57:22.07,0:57:27.08,Default,,0000,0000,0000,,Алдау немесе емдеу!
Dialogue: 0,0:57:22.07,0:57:27.08,Default,,0000,0000,0000,,Алдау немесе емдеу!
Dialogue: 0,0:57:27.08,0:57:29.08,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:57:27.08,0:57:29.08,Default,,0000,0000,0000,,Хэллоуин оқиғасы?
Dialogue: 0,0:57:29.08,0:57:32.08,Default,,0000,0000,0000,,
Dialogue: 0,0:57:29.08,0:57:32.08,Default,,0000,0000,0000,,Алдау немесе емдеу~!
Dialogue: 0,0:57:32.08,0:57:34.08,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:57:34.08,0:57:37.09,Default,,0000,0000,0000,,Уау, тәттілер!
Dialogue: 0,0:57:34.08,0:57:37.09,Default,,0000,0000,0000,,Оны маған беріңіз!
Dialogue: 0,0:57:37.09,0:57:42.09,Default,,0000,0000,0000,,А, бұл жаңа өнім!
Dialogue: 0,0:57:37.09,0:57:42.09,Default,,0000,0000,0000,,Сіз оны тегін ала алмайсыз! ?
Dialogue: 0,0:57:42.09,0:57:44.09,Default,,0000,0000,0000,,(Мегур)
Dialogue: 0,0:57:42.09,0:57:44.09,Default,,0000,0000,0000,,Бұл Хэллоуин оқиғасы! ?
Dialogue: 0,0:57:44.09,0:57:46.10,Default,,0000,0000,0000,,Сіз тыңдамайсыз!
Dialogue: 0,0:57:44.09,0:57:46.10,Default,,0000,0000,0000,,Тезірек тоқтатыңыз!
Dialogue: 0,0:57:46.10,0:57:49.10,Default,,0000,0000,0000,,Көп нәрсе құлап жатыр!
Dialogue: 0,0:57:46.10,0:57:49.10,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:57:49.10,0:57:52.10,Default,,0000,0000,0000,,Дәмді!
Dialogue: 0,0:57:52.10,0:57:54.07,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:57:58.11,0:58:00.11,Default,,0000,0000,0000,,…бірақ ол құламайды!
Dialogue: 0,0:57:58.11,0:58:00.11,Default,,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,0:58:00.11,0:58:02.11,Default,,0000,0000,0000,,Тез бас!
Dialogue: 0,0:58:00.11,0:58:02.11,Default,,0000,0000,0000,,Бұл... Уф➡️
Dialogue: 0,0:58:02.11,0:58:07.12,Default,,0000,0000,0000,,Адамдар өте көп!
Dialogue: 0,0:58:02.11,0:58:07.12,Default,,0000,0000,0000,,Асығыңыз! Мен сені жоғалтамын!
Dialogue: 0,0:58:07.12,0:58:09.12,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:58:09.12,0:58:20.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:58:20.06,0:58:22.07,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:58:20.06,0:58:22.07,Default,,0000,0000,0000,,Іс-шарадағы толық емес жұмыс уақыты➡️
Dialogue: 0,0:58:22.07,0:58:25.07,Default,,0000,0000,0000,,Ынтымақтаса аласыз ба?
Dialogue: 0,0:58:22.07,0:58:25.07,Default,,0000,0000,0000,,Иә, өйткені ол ақша табады➡️
Dialogue: 0,0:58:25.07,0:58:28.07,Default,,0000,0000,0000,,Менімен біраз уақыт жұмыс істеуіңізді өтінемін.
Dialogue: 0,0:58:28.07,0:58:31.07,Default,,0000,0000,0000,,Лейтенант Сато, мынаны қараңыз.
Dialogue: 0,0:58:31.07,0:58:34.08,Default,,0000,0000,0000,,Оны сержант Такаги киген.
Dialogue: 0,0:58:34.08,0:58:36.05,Default,,0000,0000,0000,,(тықылдаған дыбыс)
Dialogue: 0,0:58:34.08,0:58:36.05,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:58:38.08,0:58:41.08,Default,,0000,0000,0000,,Полиция итін әкеліңіз
Dialogue: 0,0:58:38.08,0:58:41.08,Default,,0000,0000,0000,,Иістерді қадағалаңыз
Dialogue: 0,0:58:41.08,0:58:44.05,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:58:41.08,0:58:44.05,Default,,0000,0000,0000,,О
Dialogue: 0,0:58:57.10,0:58:59.07,Default,,0000,0000,0000,,(есік дыбысы)
Dialogue: 0,0:59:03.11,0:59:05.11,Default,,0000,0000,0000,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:59:05.11,0:59:08.08,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:59:05.11,0:59:08.08,Default,,0000,0000,0000,,(Құлау дыбысы)
Dialogue: 0,0:59:16.05,0:59:19.06,Default,,0000,0000,0000,,(есік дыбысы)
Dialogue: 0,0:59:19.06,0:59:23.03,Default,,0000,0000,0000,,Жер асты су қоймасы...
Dialogue: 0,0:59:26.06,0:59:29.07,Default,,0000,0000,0000,,Сен сол 13 жылды жалғыз өзің күтесің, иә!
Dialogue: 0,0:59:26.06,0:59:29.07,Default,,0000,0000,0000,,Бас киіміңізді шешіңіз
Dialogue: 0,0:59:29.07,0:59:34.07,Default,,0000,0000,0000,,(Такаги)
Dialogue: 0,0:59:29.07,0:59:34.07,Default,,0000,0000,0000,,Уау, қандай Хэллоуин!
Dialogue: 0,0:59:34.07,0:59:37.07,Default,,0000,0000,0000,,《Шиба Ину және Доберман Пиншер
Dialogue: 0,0:59:34.07,0:59:37.07,Default,,0000,0000,0000,,Шиба Ину және Доберман! 》
Dialogue: 0,0:59:37.07,0:59:39.08,Default,,0000,0000,0000,,Детектив Мацуда.
Dialogue: 0,0:59:39.08,0:59:41.04,Default,,0000,0000,0000,,Чибаның қауіпсіз екенін растауға рұқсат етіңіз...
Dialogue: 0,0:59:39.08,0:59:41.04,Default,,0000,0000,0000,,Мұнда кел
Dialogue: 0,0:59:43.08,0:59:45.08,Default,,0000,0000,0000,,(Құлау дыбысы)
Dialogue: 0,0:59:43.08,0:59:45.08,Default,,0000,0000,0000,,Уф…
Dialogue: 0,0:59:45.08,0:59:49.09,Default,,0000,0000,0000,,《Анестезия немесе бір нәрсе ме?
Dialogue: 0,0:59:45.08,0:59:49.09,Default,,0000,0000,0000,,Сізді жаңа ғана ұйықтатып жатыр ма?
Dialogue: 0,0:59:49.09,0:59:53.09,Default,,0000,0000,0000,,Түсінемін, түсінемін
Dialogue: 0,0:59:49.09,0:59:53.09,Default,,0000,0000,0000,,Олай болса, бірдеңе сұрайын➡️
Dialogue: 0,0:59:53.09,0:59:56.09,Default,,0000,0000,0000,,Әзірге
Dialogue: 0,0:59:53.09,0:59:56.09,Default,,0000,0000,0000,,Мені неге шақырдың?
Dialogue: 0,0:59:56.09,0:59:59.10,Default,,0000,0000,0000,,Қатал әрекет еткеніме менің кінәм болды.
Dialogue: 0,0:59:56.09,0:59:59.10,Default,,0000,0000,0000,,Кешірім сұрау
Dialogue: 0,0:59:59.10,1:00:03.10,Default,,0000,0000,0000,,Дека
Dialogue: 0,0:59:59.10,1:00:03.10,Default,,0000,0000,0000,,Ха, детективті ұрлап ал.
Dialogue: 0,0:59:59.10,1:00:03.10,Default,,0000,0000,0000,,Мұны қай ауыз айтады?
Dialogue: 0,1:00:03.10,1:00:06.10,Default,,0000,0000,0000,,Детектив Мацуда
Dialogue: 0,1:00:03.10,1:00:06.10,Default,,0000,0000,0000,,Түсінуімді сұрама
Dialogue: 0,1:00:06.10,1:00:10.11,Default,,0000,0000,0000,,Бірақ бізде бар
Dialogue: 0,1:00:06.10,1:00:10.11,Default,,0000,0000,0000,,Бұл жалғыз нұсқа
Dialogue: 0,1:00:10.11,1:00:13.08,Default,,0000,0000,0000,,(Григори)
Dialogue: 0,1:00:17.11,1:00:20.12,Default,,0000,0000,0000,,
Dialogue: 0,1:00:17.11,1:00:20.12,Default,,0000,0000,0000,,Мен Еленика Лаврентчевамын
Dialogue: 0,1:00:20.12,1:00:23.12,Default,,0000,0000,0000,,Прамядан кейін
Dialogue: 0,1:00:20.12,1:00:23.12,Default,,0000,0000,0000,,Жапонияға Ресейден келген
Dialogue: 0,1:00:23.12,1:00:25.09,Default,,0000,0000,0000,,(Григори)
Dialogue: 0,1:00:30.13,1:00:32.13,Default,,0000,0000,0000,,(Такаги)
Dialogue: 0,1:00:30.13,1:00:32.13,Default,,0000,0000,0000,,Түсіндім, солай болды➡️
Dialogue: 0,1:00:32.13,1:00:36.13,Default,,0000,0000,0000,,Мен сені тыңдамауға шамасы жоқ.
Dialogue: 0,1:00:36.13,1:00:39.14,Default,,0000,0000,0000,,Батырдың аты: Ол Майт
Dialogue: 0,1:00:36.13,1:00:39.14,Default,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,1:00:39.14,1:00:41.14,Default,,0000,0000,0000,,Біраз
Dialogue: 0,1:00:39.14,1:00:41.14,Default,,0000,0000,0000,,Көп адам жиналды➡️
Dialogue: 0,1:00:41.14,1:00:43.14,Default,,0000,0000,0000,,Тәттілердің иісі мені мазалайды...
Dialogue: 0,1:00:43.14,1:00:45.14,Default,,0000,0000,0000,,Біз мүмкіндігінше тезірек жетуіміз керек.
Dialogue: 0,1:00:43.14,1:00:45.14,Default,,0000,0000,0000,, (Әдіс режимі)
Dialogue: 0,1:00:45.14,1:00:47.14,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:00:45.14,1:00:47.14,Default,,0000,0000,0000,, (Қоңырау үні)
Dialogue: 0,1:00:47.14,1:00:49.15,Default,,0000,0000,0000,, (Сато) Сәлеметсіз бе?
Dialogue: 0,1:00:47.14,1:00:49.15,Default,,0000,0000,0000,,Мен орынды таптым!
Dialogue: 0,1:00:49.15,1:00:51.15,Default,,0000,0000,0000,,Бұл жер астындағы су қоймасы!
Dialogue: 0,1:00:49.15,1:00:51.15,Default,,0000,0000,0000,,(Сато) Бұл не? ?
Dialogue: 0,1:00:51.15,1:00:53.15,Default,,0000,0000,0000,,Дереккөз белгісіз➡️
Dialogue: 0,1:00:53.15,1:00:56.15,Default,,0000,0000,0000,,Кенеттен бақылау экранында
Dialogue: 0,1:00:53.15,1:00:56.15,Default,,0000,0000,0000,,Оқиға орнына суреттер кірді.
Dialogue: 0,1:00:56.15,1:00:59.16,Default,,0000,0000,0000,,Прамя бұл
Dialogue: 0,1:00:56.15,1:00:59.16,Default,,0000,0000,0000,,Арнайы сұйық мылтық ➡️ қолданыңыз
Dialogue: 0,1:00:59.16,1:01:01.16,Default,,0000,0000,0000,,Ол қорқынышты террорист.
Dialogue: 0,1:01:01.16,1:01:05.16,Default,,0000,0000,0000,,Оның қолынан өлтірілгендер
Dialogue: 0,1:01:01.16,1:01:05.16,Default,,0000,0000,0000,,Сансыз
Dialogue: 0,1:01:05.16,1:01:08.16,Default,,0000,0000,0000,,Менің отбасымды да ол өлтірді.
Dialogue: 0,1:01:08.16,1:01:12.10,Default,,0000,0000,0000,,Барлығы осында
Dialogue: 0,1:01:08.16,1:01:12.10,Default,,0000,0000,0000,,Сол қарғыс атқыр бомбамен➡️
Dialogue: 0,1:01:12.10,1:01:15.10,Default,,0000,0000,0000,,Отбасы және жақындары
Dialogue: 0,1:01:12.10,1:01:15.10,Default,,0000,0000,0000,,Қаза тапқандар
Dialogue: 0,1:01:15.10,1:01:21.11,Default,,0000,0000,0000,,Т…!!
Dialogue: 0,1:01:15.10,1:01:21.11,Default,,0000,0000,0000,,Прамьядан кек алуға ант берді.
Dialogue: 0,1:01:15.10,1:01:21.11,Default,,0000,0000,0000,,Біз бірге тұрған жолдастармыз.
Dialogue: 0,1:01:21.11,1:01:23.08,Default,,0000,0000,0000,,(Григори)
Dialogue: 0,1:01:27.12,1:01:29.09,Default,,0000,0000,0000,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,1:01:27.12,1:01:29.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:01:35.12,1:01:38.13,Default,,0000,0000,0000,,Жасау
Dialogue: 0,1:01:35.12,1:01:38.13,Default,,0000,0000,0000,,Біз өз бетімізше
Dialogue: 0,1:01:35.12,1:01:38.13,Default,,0000,0000,0000,,Прамяға ұмтылу
Dialogue: 0,1:01:38.13,1:01:43.13,Default,,0000,0000,0000,,《Солай ма?
Dialogue: 0,1:01:38.13,1:01:43.13,Default,,0000,0000,0000,,Олар бейбіт тұрғындар тобы.
Dialogue: 0,1:01:43.13,1:01:46.14,Default,,0000,0000,0000,,《Себебі
Dialogue: 0,1:01:43.13,1:01:46.14,Default,,0000,0000,0000,,Қол жетімді ақпарат шектеулі➡️
Dialogue: 0,1:01:46.14,1:01:48.14,Default,,0000,0000,0000,,Детектив Мацуданың қызметтік міндетін орындау кезінде өлімі
Dialogue: 0,1:01:46.14,1:01:48.14,Default,,0000,0000,0000,,Мен білмедім.
Dialogue: 0,1:01:48.14,1:01:52.14,Default,,0000,0000,0000,,Мен жағдайды түсінемін.
Dialogue: 0,1:01:48.14,1:01:52.14,Default,,0000,0000,0000,,Сонымен не істегенімді қалайсың?
Dialogue: 0,1:01:52.14,1:01:56.15,Default,,0000,0000,0000,,Прамья жасаған бомба туралы
Dialogue: 0,1:01:52.14,1:01:56.15,Default,,0000,0000,0000,,Мен білгім келеді
Dialogue: 0,1:01:56.15,1:01:58.15,Default,,0000,0000,0000,,Сіз 3 жыл бұрын➡️
Dialogue: 0,1:01:58.15,1:02:00.15,Default,,0000,0000,0000,,Ғимаратта орнатылған бомба
Dialogue: 0,1:01:58.15,1:02:00.15,Default,,0000,0000,0000,,Шығарылды
Dialogue: 0,1:02:00.15,1:02:04.15,Default,,0000,0000,0000,,Бомбаның құрылымы
Dialogue: 0,1:02:00.15,1:02:04.15,Default,,0000,0000,0000,,Бізге хабарлаңыз
Dialogue: 0,1:02:04.15,1:02:06.16,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:02:04.15,1:02:06.16,Default,,0000,0000,0000,,Сипаттамаларды түсінгеннен кейін➡️
Dialogue: 0,1:02:06.16,1:02:09.16,Default,,0000,0000,0000,,Қай жерге отырғызу керек
Dialogue: 0,1:02:06.16,1:02:09.16,Default,,0000,0000,0000,,Алдын ала болжауға болады
Dialogue: 0,1:02:09.16,1:02:14.10,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,1:02:09.16,1:02:14.10,Default,,0000,0000,0000,,Мүмкін біз оны ұстап алармыз.
Dialogue: 0,1:02:14.10,1:02:17.10,Default,,0000,0000,0000,,Полицияға
Dialogue: 0,1:02:14.10,1:02:17.10,Default,,0000,0000,0000,,Сіз ынтымақтастықты жоспарламайсыз ба?
Dialogue: 0,1:02:17.10,1:02:21.10,Default,,0000,0000,0000,,Полицияға сенуге болмайды
Dialogue: 0,1:02:21.10,1:02:27.11,Default,,0000,0000,0000,,Елордалық полиция басқармасының алдында қайтыс болған шетелдік
Dialogue: 0,1:02:21.10,1:02:27.11,Default,,0000,0000,0000,,Ол да сенің достарыңның бірі ме?
Dialogue: 0,1:02:27.11,1:02:31.11,Default,,0000,0000,0000,,Ол менің ағам Олег.
Dialogue: 0,1:02:27.11,1:02:31.11,Default,,0000,0000,0000,,Ha
Dialogue: 0,1:02:31.11,1:02:33.12,Default,,0000,0000,0000,,Прамяда бар
Dialogue: 0,1:02:31.11,1:02:33.12,Default,,0000,0000,0000,,Бір ереже бар.
Dialogue: 0,1:02:33.12,1:02:37.12,Default,,0000,0000,0000,,Жарылыс жасамас бұрын
Dialogue: 0,1:02:33.12,1:02:37.12,Default,,0000,0000,0000,,Дайындық үшін пайдаланылатын жасырынуға от қойыңыз➡️
Dialogue: 0,1:02:37.12,1:02:39.12,Default,,0000,0000,0000,,Дәлелдемелерді жою
Dialogue: 0,1:02:39.12,1:02:42.13,Default,,0000,0000,0000,,Бірнеше ай бұрын
Dialogue: 0,1:02:39.12,1:02:42.13,Default,,0000,0000,0000,,Інім жасырынған жерді тауып алды➡️
Dialogue: 0,1:02:42.13,1:02:45.13,Default,,0000,0000,0000,,Мен жалғыз бардым
Dialogue: 0,1:02:45.13,1:02:47.13,Default,,0000,0000,0000,,｟Аа…｠
Dialogue: 0,1:02:47.13,1:02:51.13,Default,,0000,0000,0000,,Менің ағамның планшеті бар.
Dialogue: 0,1:02:47.13,1:02:51.13,Default,,0000,0000,0000,,Сәтті шығарылды
Dialogue: 0,1:02:51.13,1:02:55.14,Default,,0000,0000,0000,,Лестер, Джованни және Миками
Dialogue: 0,1:02:51.13,1:02:55.14,Default,,0000,0000,0000,,Бомба сызбасына ұқсайтын нәрсе ➡️
Dialogue: 0,1:02:55.14,1:02:58.14,Default,,0000,0000,0000,,Токиоға қатысты заттар
Dialogue: 0,1:02:55.14,1:02:58.14,Default,,0000,0000,0000,,Ол көрініс тапқан сияқты.
Dialogue: 0,1:02:58.14,1:03:00.14,Default,,0000,0000,0000,,Бірақ экран бірнеше секундтан кейін жоғалып кетті➡️
Dialogue: 0,1:03:00.14,1:03:04.15,Default,,0000,0000,0000,,Содан бастап
Dialogue: 0,1:03:00.14,1:03:04.15,Default,,0000,0000,0000,,Ол жауапсыз қалғанын айтты.
Dialogue: 0,1:03:04.15,1:03:08.15,Default,,0000,0000,0000,,Сонымен Токио ше?
Dialogue: 0,1:03:04.15,1:03:08.15,Default,,0000,0000,0000,,Токиодағы біреуден сұраған дұрыс болар ➡️
Dialogue: 0,1:03:08.15,1:03:11.09,Default,,0000,0000,0000,,Мен елордалық полиция бөліміне бардым.
Dialogue: 0,1:03:11.09,1:03:15.09,Default,,0000,0000,0000,,《Бұл планшет
Dialogue: 0,1:03:11.09,1:03:15.09,Default,,0000,0000,0000,,Кішкене күйіп қалды ма?》
Dialogue: 0,1:03:15.09,1:03:17.09,Default,,0000,0000,0000,,《Бірақ оны өлтірген бомба➡️
Dialogue: 0,1:03:17.09,1:03:19.10,Default,,0000,0000,0000,,Сол планшетте
Dialogue: 0,1:03:17.09,1:03:19.10,Default,,0000,0000,0000,,Ол орнатылды》
Dialogue: 0,1:03:19.10,1:03:24.10,Default,,0000,0000,0000,,《Басқаша айтқанда, алып кетеді деп болжанған.
Dialogue: 0,1:03:19.10,1:03:24.10,Default,,0000,0000,0000,,Бұл тұзақ болды》
Dialogue: 0,1:03:24.10,1:03:26.10,Default,,0000,0000,0000,,Мен жағдайды түсінемін.
Dialogue: 0,1:03:26.10,1:03:30.11,Default,,0000,0000,0000,,Бірақ сенің ағаң
Dialogue: 0,1:03:26.10,1:03:30.11,Default,,0000,0000,0000,,Мен де үш жыл бұрын оқиға орнында болдым.
Dialogue: 0,1:03:30.11,1:03:32.11,Default,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,1:03:32.11,1:03:35.11,Default,,0000,0000,0000,,Яғни
Dialogue: 0,1:03:32.11,1:03:35.11,Default,,0000,0000,0000,,Бұл біз орнатқан стратегия болды.
Dialogue: 0,1:03:35.11,1:03:37.11,Default,,0000,0000,0000,,Прамьядан ғимаратты жаруды сұраңыз➡️
Dialogue: 0,1:03:37.11,1:03:40.12,Default,,0000,0000,0000,,Оқиға орнында
Dialogue: 0,1:03:37.11,1:03:40.12,Default,,0000,0000,0000,,Мен оны ұстап алмақ болдым.
Dialogue: 0,1:03:40.12,1:03:43.12,Default,,0000,0000,0000,,Бірақ мен сәтсіздікке ұшырадым және қашып кеттім.
Dialogue: 0,1:03:43.12,1:03:47.12,Default,,0000,0000,0000,,Біз бұл бөксені сүртеміз.
Dialogue: 0,1:03:43.12,1:03:47.12,Default,,0000,0000,0000,,Сонда сіз мұны істеуге мәжбүр болдыңыз ба?
Dialogue: 0,1:03:47.12,1:03:49.13,Default,,0000,0000,0000,,Ағам үнемі айтатын
Dialogue: 0,1:03:49.13,1:03:52.13,Default,,0000,0000,0000,,Мацуда есімді детективке
Dialogue: 0,1:03:49.13,1:03:52.13,Default,,0000,0000,0000,,Мен сені қайта көргім келеді
Dialogue: 0,1:03:52.13,1:03:56.13,Default,,0000,0000,0000,,Ол біз үшін мұны істей алмады.
Dialogue: 0,1:03:52.13,1:03:56.13,Default,,0000,0000,0000,,Ол Прамьяның бомбасын тоқтатқанын айтты.
Dialogue: 0,1:03:56.13,1:03:59.14,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,1:03:56.13,1:03:59.14,Default,,0000,0000,0000,,Біз сізге қараймыз➡️
Dialogue: 0,1:03:59.14,1:04:03.14,Default,,0000,0000,0000,,Ескі бет суреттері және т.б.
Dialogue: 0,1:03:59.14,1:04:03.14,Default,,0000,0000,0000,,Кішкене ақпарат алды
Dialogue: 0,1:04:03.14,1:04:06.14,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,1:04:03.14,1:04:06.14,Default,,0000,0000,0000,,Мен сені осында шақырдым.
Dialogue: 0,1:04:06.14,1:04:08.14,Default,,0000,0000,0000,,Бұл құрмет.
Dialogue: 0,1:04:08.14,1:04:12.08,Default,,0000,0000,0000,,Менің отбасым өмірімнен де маңызды.
Dialogue: 0,1:04:08.14,1:04:12.08,Default,,0000,0000,0000,,Ол өлтірілді.
Dialogue: 0,1:04:12.08,1:04:14.08,Default,,0000,0000,0000,,Мен не қажет болса да істеймін
Dialogue: 0,1:04:14.08,1:04:18.09,Default,,0000,0000,0000,,Әңгіменің соңы
Dialogue: 0,1:04:14.08,1:04:18.09,Default,,0000,0000,0000,,Тез жазайын.
Dialogue: 0,1:04:18.09,1:04:21.09,Default,,0000,0000,0000,,Мен оны жазғым келмейді.
Dialogue: 0,1:04:18.09,1:04:21.09,Default,,0000,0000,0000,,Ех!
Dialogue: 0,1:04:21.09,1:04:24.09,Default,,0000,0000,0000,,Сіздің жеке кекіңіз үшін.
Dialogue: 0,1:04:21.09,1:04:24.09,Default,,0000,0000,0000,,Мен сенімен араласа алмаймын.
Dialogue: 0,1:04:24.09,1:04:26.06,Default,,0000,0000,0000,,(Дмитрий орыс)
Dialogue: 0,1:04:30.10,1:04:34.10,Default,,0000,0000,0000,,Детектив Мацуда Сіздің таңдауыңыз жоқ.
Dialogue: 0,1:04:34.10,1:04:36.11,Default,,0000,0000,0000,,Детектив Чибаға не болғаны маңызды ма?
Dialogue: 0,1:04:36.11,1:04:39.11,Default,,0000,0000,0000,,Бұл сенсің.
Dialogue: 0,1:04:36.11,1:04:39.11,Default,,0000,0000,0000,,Бұл ауыр жүк екенін айтты.
Dialogue: 0,1:04:39.11,1:04:43.11,Default,,0000,0000,0000,,Оны дұрыс ұстаңыз
Dialogue: 0,1:04:39.11,1:04:43.11,Default,,0000,0000,0000,,Сіз жаза аласыз➡️
Dialogue: 0,1:04:43.11,1:04:47.12,Default,,0000,0000,0000,,Мен саған полицияға қалдыр дедім!
Dialogue: 0,1:04:47.12,1:04:51.12,Default,,0000,0000,0000,,Не? Ал... Мацуда мырза! ?
Dialogue: 0,1:04:47.12,1:04:51.12,Default,,0000,0000,0000,,Өтірік! Мен өлдім! ?
Dialogue: 0,1:04:51.12,1:04:54.12,Default,,0000,0000,0000,,Өлді! ?
Dialogue: 0,1:04:51.12,1:04:54.12,Default,,0000,0000,0000,,Ал, Мацуда мырза➡️
Dialogue: 0,1:04:54.12,1:04:57.09,Default,,0000,0000,0000,,Ол баяғыда қызмет бабында қайтыс болды...
Dialogue: 0,1:04:54.12,1:04:57.09,Default,,0000,0000,0000,,Идиот! Чиба…
Dialogue: 0,1:05:02.13,1:05:06.10,Default,,0000,0000,0000,,Полиция! Барлығы, ол жаққа көшпеңдер!
Dialogue: 0,1:05:08.14,1:05:11.07,Default,,0000,0000,0000,,Гү!
Dialogue: 0,1:05:08.14,1:05:11.07,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:05:11.07,1:05:13.08,Default,,0000,0000,0000,,Неліктен бұлай қалдырмасқа?
Dialogue: 0,1:05:13.08,1:05:17.08,Default,,0000,0000,0000,,Әрқайсысының төбелесуі
Dialogue: 0,1:05:13.08,1:05:17.08,Default,,0000,0000,0000,,Ең көп пайда көретін адам - Прамья.
Dialogue: 0,1:05:17.08,1:05:19.08,Default,,0000,0000,0000,,…бірақ ол құламайды!
Dialogue: 0,1:05:17.08,1:05:19.08,Default,,0000,0000,0000,,Конан-кун!
Dialogue: 0,1:05:19.08,1:05:22.05,Default,,0000,0000,0000,,Сонымен, дәл қазір бейнеде сіз бе?
Dialogue: 0,1:05:28.09,1:05:33.06,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,1:05:28.09,1:05:33.06,Default,,0000,0000,0000,,Бұл балаларға арналған орын емес.
Dialogue: 0,1:05:38.10,1:05:40.10,Default,,0000,0000,0000,,…бірақ ол құламайды!
Dialogue: 0,1:05:38.10,1:05:40.10,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:05:40.10,1:05:43.11,Default,,0000,0000,0000,,Кук
Dialogue: 0,1:05:40.10,1:05:43.11,Default,,0000,0000,0000,,Бірден жарық алыңыз!
Dialogue: 0,1:05:43.11,1:05:46.11,Default,,0000,0000,0000,,(Амон) Нагачика? (Хайд) Ах, Амон-сан.
Dialogue: 0,1:05:43.11,1:05:46.11,Default,,0000,0000,0000,,Жоғары! Біз тұрмыз!
Dialogue: 0,1:05:46.11,1:05:48.08,Default,,0000,0000,0000,,Мені қу!
Dialogue: 0,1:05:50.11,1:05:52.11,Default,,0000,0000,0000,,Ә? Рика?
Dialogue: 0,1:05:52.11,1:05:56.12,Default,,0000,0000,0000,,(орысша Еленика)
Dialogue: 0,1:05:56.12,1:05:59.12,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:05:56.12,1:05:59.12,Default,,0000,0000,0000,,Қуат көзін табыңыз!
Dialogue: 0,1:05:59.12,1:06:01.12,Default,,0000,0000,0000,,Жүгір!
Dialogue: 0,1:05:59.12,1:06:01.12,Default,,0000,0000,0000,,Кепілге алынғандар аман ба? ?
Dialogue: 0,1:06:01.12,1:06:04.13,Default,,0000,0000,0000,,Эй!
Dialogue: 0,1:06:01.12,1:06:04.13,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,1:06:04.13,1:06:06.13,Default,,0000,0000,0000,,Міне!
Dialogue: 0,1:06:06.13,1:06:08.13,Default,,0000,0000,0000,,Такаги-кун! Сенімен бәрі жақсы ма?
Dialogue: 0,1:06:08.13,1:06:11.07,Default,,0000,0000,0000,,Хмм... Иә, қалай болғанда да.
Dialogue: 0,1:06:11.07,1:06:16.07,Default,,0000,0000,0000,,Макадами сыйлығының ортасына дейін
Dialogue: 0,1:06:11.07,1:06:16.07,Default,,0000,0000,0000,,Мен мұны әрекет деп ойладым.
Dialogue: 0,1:06:16.07,1:06:18.07,Default,,0000,0000,0000,,Соңында...
Dialogue: 0,1:06:18.07,1:06:21.04,Default,,0000,0000,0000,,Әйтеуір, сенің аман болғаныңа қуаныштымын.
Dialogue: 0,1:06:23.08,1:06:27.08,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,1:06:23.08,1:06:27.08,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,1:06:27.08,1:06:30.09,Default,,0000,0000,0000,,
Dialogue: 0,1:06:30.09,1:06:33.06,Default,,0000,0000,0000,,Ұлы…
Dialogue: 0,1:06:35.09,1:06:38.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:06:38.09,1:06:41.10,Default,,0000,0000,0000,,Миике
Dialogue: 0,1:06:38.09,1:06:41.10,Default,,0000,0000,0000,,(Мике)
Dialogue: 0,1:06:38.09,1:06:41.10,Default,,0000,0000,0000,,Қазірдің өзінде! Себебі мен уайымдадым! !
Dialogue: 0,1:06:41.10,1:06:44.10,Default,,0000,0000,0000,,Наэко
Dialogue: 0,1:06:41.10,1:06:44.10,Default,,0000,0000,0000,,Сәлем! Не... Наэко-чан
Dialogue: 0,1:06:41.10,1:06:44.10,Default,,0000,0000,0000,,Өйткені менің жағдайым жақсы
Dialogue: 0,1:06:44.10,1:06:46.10,Default,,0000,0000,0000,,Уау...
Dialogue: 0,1:06:44.10,1:06:46.10,Default,,0000,0000,0000,,Ммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,1:06:46.10,1:06:49.11,Default,,0000,0000,0000,,Мен... Кешіріңіз.
Dialogue: 0,1:06:46.10,1:06:49.11,Default,,0000,0000,0000,,Уууу…
Dialogue: 0,1:06:49.11,1:06:51.11,Default,,0000,0000,0000,,(есік дыбысы)
Dialogue: 0,1:06:51.11,1:06:54.11,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,1:06:51.11,1:06:54.11,Default,,0000,0000,0000,,Қашып кеткен топқа не болды?
Dialogue: 0,1:06:54.11,1:06:57.11,Default,,0000,0000,0000,,Мен оны қууға бар күшімді салып жатырмын, бірақ...
Dialogue: 0,1:06:57.11,1:07:01.12,Default,,0000,0000,0000,,Рәсімнен бас тартайық. Әр адамның қауіпсіздігі бірінші орында.
Dialogue: 0,1:07:01.12,1:07:05.12,Default,,0000,0000,0000,,Бірақ Прамя
Dialogue: 0,1:07:01.12,1:07:05.12,Default,,0000,0000,0000,,Олардың сізді нысанаға алып жатқаны күмәнсіз.
Dialogue: 0,1:07:05.12,1:07:07.12,Default,,0000,0000,0000,,Бұдан былай екеуінің күзетшілері болады.
Dialogue: 0,1:07:05.12,1:07:07.12,Default,,0000,0000,0000,, (Әдіс режимі)
Dialogue: 0,1:07:07.12,1:07:09.13,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,1:07:09.13,1:07:13.06,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:07:09.13,1:07:13.06,Default,,0000,0000,0000,,Сіз, бұл хабар
Dialogue: 0,1:07:13.06,1:07:15.06,Default,,0000,0000,0000,,Ах! ?
Dialogue: 0,1:07:15.06,1:07:17.07,Default,,0000,0000,0000,,«Той жоспарланғандай өтуі керек».
Dialogue: 0,1:07:17.07,1:07:19.07,Default,,0000,0000,0000,,«Егер біз бас тартсақ, ➡️
Dialogue: 0,1:07:19.07,1:07:23.07,Default,,0000,0000,0000,,Көбірек құрбандар
Dialogue: 0,1:07:19.07,1:07:23.07,Default,,0000,0000,0000,,Ол шығады».
Dialogue: 0,1:07:23.07,1:07:25.04,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,1:07:27.08,1:07:29.08,Default,,0000,0000,0000,,Біз той жасаймыз ғой.
Dialogue: 0,1:07:29.08,1:07:32.08,Default,,0000,0000,0000,,Иә, енді мұны істеуден басқа амалым жоқ.
Dialogue: 0,1:07:32.08,1:07:35.08,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,1:07:32.08,1:07:35.08,Default,,0000,0000,0000,,Прамьяға өзіне ұнайтын нәрсені істеуге мүмкіндік бермеңіз.
Dialogue: 0,1:07:35.08,1:07:37.09,Default,,0000,0000,0000,,Мен сені міндетті түрде ұстаймын.
Dialogue: 0,1:07:37.09,1:07:40.09,Default,,0000,0000,0000,,《Неге? Неліктен Прамья?
Dialogue: 0,1:07:37.09,1:07:40.09,Default,,0000,0000,0000,,Осындай әрекетті орындаңыз...》
Dialogue: 0,1:07:40.09,1:07:43.09,Default,,0000,0000,0000,,《Мистер Мұранаканың тойы өтті
Dialogue: 0,1:07:40.09,1:07:43.09,Default,,0000,0000,0000,,Тіпті жойылса да ➡️
Dialogue: 0,1:07:43.09,1:07:46.10,Default,,0000,0000,0000,,Басқа жерді көздеңіз》
Dialogue: 0,1:07:46.10,1:07:49.10,Default,,0000,0000,0000,,《Неге?
Dialogue: 0,1:07:46.10,1:07:49.10,Default,,0000,0000,0000,,Тойға ерекше көңіл бөлесіз бе? 》
Dialogue: 0,1:07:49.10,1:07:51.10,Default,,0000,0000,0000,,Не болды? Конан-кун
Dialogue: 0,1:07:49.10,1:07:51.10,Default,,0000,0000,0000,,Қорқынышты көрінеді
Dialogue: 0,1:07:51.10,1:07:53.10,Default,,0000,0000,0000,,А, бұл ештеңе емес.
Dialogue: 0,1:07:51.10,1:07:53.10,Default,,0000,0000,0000,, (Әдіс режимі)
Dialogue: 0,1:07:53.10,1:07:56.11,Default,,0000,0000,0000,,А, телефон қоңырауы болып жатыр. Мен үйге барамын.
Dialogue: 0,1:07:56.11,1:07:59.11,Default,,0000,0000,0000,,Үйге қайтқанда абай болыңыз.
Dialogue: 0,1:07:56.11,1:07:59.11,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:07:59.11,1:08:03.11,Default,,0000,0000,0000,,Ааа, менімен хабарласады деп ойламадым.
Dialogue: 0,1:07:59.11,1:08:03.11,Default,,0000,0000,0000,,Мен олай ойламадым.
Dialogue: 0,1:08:03.11,1:08:06.12,Default,,0000,0000,0000,,Мен сізге тезірек айтқым келеді.
Dialogue: 0,1:08:06.12,1:08:10.12,Default,,0000,0000,0000,,Прамьяны қудалайтын ұйым туралы ақпарат.
Dialogue: 0,1:08:06.12,1:08:10.12,Default,,0000,0000,0000,,Мен оны ұстадым.
Dialogue: 0,1:08:10.12,1:08:13.06,Default,,0000,0000,0000,,Ұйым қалай аталады?
Dialogue: 0,1:08:10.12,1:08:13.06,Default,,0000,0000,0000,,«Нада Unititojiti»
Dialogue: 0,1:08:13.06,1:08:16.06,Default,,0000,0000,0000,,Ресейден Еуропаға
Dialogue: 0,1:08:13.06,1:08:16.06,Default,,0000,0000,0000,,Желі бар➡️
Dialogue: 0,1:08:16.06,1:08:18.06,Default,,0000,0000,0000,,дербес
Dialogue: 0,1:08:16.06,1:08:18.06,Default,,0000,0000,0000,,Ол Прамьяны аңдып жүрген сияқты.
Dialogue: 0,1:08:18.06,1:08:22.06,Default,,0000,0000,0000,,《Нада Юничитожити...
Dialogue: 0,1:08:18.06,1:08:22.06,Default,,0000,0000,0000,,«Мен тыныс алуды тоқтатуым керек».
Dialogue: 0,1:08:22.06,1:08:24.07,Default,,0000,0000,0000,,《Прамьяның тыныс алуының тамыры
Dialogue: 0,1:08:22.06,1:08:24.07,Default,,0000,0000,0000,,Сонымен?》
Dialogue: 0,1:08:24.07,1:08:27.07,Default,,0000,0000,0000,, (Амуро)
Dialogue: 0,1:08:24.07,1:08:27.07,Default,,0000,0000,0000,,Жетекші - Еленика есімді әйел.
Dialogue: 0,1:08:27.07,1:08:30.07,Default,,0000,0000,0000,,Бетімде күйік іздері бар.
Dialogue: 0,1:08:30.07,1:08:33.08,Default,,0000,0000,0000,,Прамьяға дейін қайнау мүмкін емес
Dialogue: 0,1:08:30.07,1:08:33.08,Default,,0000,0000,0000,,Әр елдегі полицияның жауаптары➡️
Dialogue: 0,1:08:33.08,1:08:38.08,Default,,0000,0000,0000,,Олар ашуланды
Dialogue: 0,1:08:33.08,1:08:38.08,Default,,0000,0000,0000,,Кек алу үшін ұйым аштым.
Dialogue: 0,1:08:38.08,1:08:41.08,Default,,0000,0000,0000,,Жеке ұйым болса да➡️
Dialogue: 0,1:08:41.08,1:08:44.09,Default,,0000,0000,0000,,Прамья үшін
Dialogue: 0,1:08:41.08,1:08:44.09,Default,,0000,0000,0000,,Ол өте жағымсыз қарсылас.
Dialogue: 0,1:08:44.09,1:08:48.09,Default,,0000,0000,0000,,Мені әлемнің кез келген жерінде орындаңыз
Dialogue: 0,1:08:44.09,1:08:48.09,Default,,0000,0000,0000,,Өйткені ол жұмысқа кедергі келтіреді.
Dialogue: 0,1:08:48.09,1:08:52.09,Default,,0000,0000,0000,,Жапонияда болған жарылыс оқиғалары
Dialogue: 0,1:08:48.09,1:08:52.09,Default,,0000,0000,0000,,Мүмкін байланысты шығар?
Dialogue: 0,1:08:52.09,1:08:55.10,Default,,0000,0000,0000,,Шетелдіктер көп пәтерлі үйлерде өртеніп, бомбалар жарылды
Dialogue: 0,1:08:55.10,1:08:58.10,Default,,0000,0000,0000,,(Амуро) ғимаратындағы бомба туралы.
Dialogue: 0,1:08:55.10,1:08:58.10,Default,,0000,0000,0000,,Мен біраз тұрып қалдым.
Dialogue: 0,1:08:58.10,1:09:01.10,Default,,0000,0000,0000,,Мен болсам
Dialogue: 0,1:08:58.10,1:09:01.10,Default,,0000,0000,0000,,Уақыты белгіленген жүйенің орнына сымсыз жүйені пайдаланыңыз
Dialogue: 0,1:09:01.10,1:09:03.11,Default,,0000,0000,0000,,Бұл сенімдірек.
Dialogue: 0,1:09:03.11,1:09:05.11,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,1:09:03.11,1:09:05.11,Default,,0000,0000,0000,,Бұл жолы мен арғы жақтан келу үшін жолдан шығамын➡️
Dialogue: 0,1:09:05.11,1:09:08.11,Default,,0000,0000,0000,,Мен полицияға хабарластым.
Dialogue: 0,1:09:08.11,1:09:10.11,Default,,0000,0000,0000,,Прамяда бар
Dialogue: 0,1:09:08.11,1:09:10.11,Default,,0000,0000,0000,,Қандай да бір ниет болуы керек
Dialogue: 0,1:09:10.11,1:09:15.05,Default,,0000,0000,0000,,☎Тағы бір нәрсе: Амуроға жағалы бомба беріңіз.
Dialogue: 0,1:09:10.11,1:09:15.05,Default,,0000,0000,0000,,Не үшін кигенімді де білмеймін.
Dialogue: 0,1:09:15.05,1:09:18.05,Default,,0000,0000,0000,,☎Үш жыл бұрын болған оқиға үшін кек алғыңыз келсе
Dialogue: 0,1:09:15.05,1:09:18.05,Default,,0000,0000,0000,,Мен сені азғырған сол жерде➡️
Dialogue: 0,1:09:18.05,1:09:20.06,Default,,0000,0000,0000,,Сіз мені бірден өлтіруіңіз керек, солай ма?
Dialogue: 0,1:09:20.06,1:09:23.06,Default,,0000,0000,0000,,Бұл туралы
Dialogue: 0,1:09:20.06,1:09:23.06,Default,,0000,0000,0000,,Мен де бұл туралы ойладым.
Dialogue: 0,1:09:23.06,1:09:26.06,Default,,0000,0000,0000,,☎Сіз өртену оқиғасының айғақтарының жадынамасын көрдіңіз бе?
Dialogue: 0,1:09:23.06,1:09:26.06,Default,,0000,0000,0000,,О
Dialogue: 0,1:09:26.06,1:09:29.06,Default,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,1:09:26.06,1:09:29.06,Default,,0000,0000,0000,,Мен әлі білмеймін
Dialogue: 0,1:09:29.06,1:09:31.07,Default,,0000,0000,0000,,Бірақ қазірдің өзінде
Dialogue: 0,1:09:29.06,1:09:31.07,Default,,0000,0000,0000,,Тойға дейінгі уақыт...
Dialogue: 0,1:09:31.07,1:09:34.07,Default,,0000,0000,0000,,(Амуро) Мұны маған досым айтты.
Dialogue: 0,1:09:34.07,1:09:37.07,Default,,0000,0000,0000,,Сабырсыздық - ең үлкен тұзақ
Dialogue: 0,1:09:37.07,1:09:42.08,Default,,0000,0000,0000,,Сіз дағдарыстың мұндай деңгейіне талай рет тап болдыңыз.
Dialogue: 0,1:09:37.07,1:09:42.08,Default,,0000,0000,0000,,Сіз оны жеңдіңіз, солай емес пе?
Dialogue: 0,1:09:42.08,1:09:45.05,Default,,0000,0000,0000,,Сәттілік тілеп дұға ет
Dialogue: 0,1:09:42.08,1:09:45.05,Default,,0000,0000,0000,, (кесу дыбысы)
Dialogue: 0,1:09:47.08,1:09:49.08,Default,,0000,0000,0000,,Кеш болды.
Dialogue: 0,1:09:49.08,1:09:52.09,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,1:09:49.08,1:09:52.09,Default,,0000,0000,0000,,Мен мұнда болудан шаршадым.
Dialogue: 0,1:09:52.09,1:09:56.09,Default,,0000,0000,0000,,Мен мұны сұрадым, Казами.
Dialogue: 0,1:09:56.09,1:10:00.06,Default,,0000,0000,0000,,<Және үйлену күні>
Dialogue: 0,1:10:06.10,1:10:08.10,Default,,0000,0000,0000,,Хэллоуин мерекесі құтты болсын!
Dialogue: 0,1:10:08.10,1:10:13.08,Default,,0000,0000,0000,,
Dialogue: 0,1:10:18.11,1:10:21.08,Default,,0000,0000,0000,,(Дмитрий)
Dialogue: 0,1:10:34.13,1:10:36.10,Default,,0000,0000,0000,,
Dialogue: 0,1:10:47.14,1:10:50.11,Default,,0000,0000,0000,,｟Уау! ! ｠
Dialogue: 0,1:10:52.15,1:10:56.15,Default,,0000,0000,0000,,｟Кирилл!
Dialogue: 0,1:10:52.15,1:10:56.15,Default,,0000,0000,0000,,Ах! Апыр-ай! ! ｠
Dialogue: 0,1:10:56.15,1:10:58.12,Default,,0000,0000,0000,,(Дмитрий)
Dialogue: 0,1:11:09.16,1:11:14.04,Default,,0000,0000,0000,,(Дмитрий)
Dialogue: 0,1:11:09.16,1:11:14.04,Default,,0000,0000,0000,,Ах... Ах Гехогехогехогехо...
Dialogue: 0,1:11:16.11,1:11:20.11,Default,,0000,0000,0000,,Қандай да бір себепті,
Dialogue: 0,1:11:16.11,1:11:20.11,Default,,0000,0000,0000,,Бір қорқынышты нәрсе болды.
Dialogue: 0,1:11:20.11,1:11:23.11,Default,,0000,0000,0000,,Иә... Той Мұранака мырзамен ➡️ болды
Dialogue: 0,1:11:23.11,1:11:25.11,Default,,0000,0000,0000,,жалғыз Кристин
Dialogue: 0,1:11:23.11,1:11:25.11,Default,,0000,0000,0000,,Орындаңыз
Dialogue: 0,1:11:25.11,1:11:30.12,Default,,0000,0000,0000,,Қарасам, ерекше той екен.
Dialogue: 0,1:11:25.11,1:11:30.12,Default,,0000,0000,0000,,Нашар...
Dialogue: 0,1:11:30.12,1:11:33.12,Default,,0000,0000,0000,,
Dialogue: 0,1:11:33.12,1:11:35.12,Default,,0000,0000,0000,,Бұл алаңсыз.
Dialogue: 0,1:11:35.12,1:11:38.13,Default,,0000,0000,0000,,Иә? Бұл не меморандум?
Dialogue: 0,1:11:38.13,1:11:42.13,Default,,0000,0000,0000,,Иә?О
Dialogue: 0,1:11:38.13,1:11:42.13,Default,,0000,0000,0000,,Елордалық полиция басқармасының алдында жарылыс болған кезде➡️
Dialogue: 0,1:11:42.13,1:11:44.13,Default,,0000,0000,0000,,Ол менің алдымда құлады
Dialogue: 0,1:11:42.13,1:11:44.13,Default,,0000,0000,0000,,Жазбаны есте сақтаңыз➡️
Dialogue: 0,1:11:44.13,1:11:47.14,Default,,0000,0000,0000,,Мен аздап жаздым
Dialogue: 0,1:11:44.13,1:11:47.14,Default,,0000,0000,0000,,Ран-ни-чан, мен жазбаны көрдім! ?
Dialogue: 0,1:11:47.14,1:11:49.14,Default,,0000,0000,0000,,Көрсем де, бұл бір ғана көз ілмек.
Dialogue: 0,1:11:49.14,1:11:52.14,Default,,0000,0000,0000,,Бұл ағылшынша емес сияқты.
Dialogue: 0,1:11:49.14,1:11:52.14,Default,,0000,0000,0000,,Мен бір нәрсені түсінбеймін.
Dialogue: 0,1:11:52.14,1:11:56.15,Default,,0000,0000,0000,,Әкем оянғанда
Dialogue: 0,1:11:52.14,1:11:56.15,Default,,0000,0000,0000,,Мен сұрауды ойладым.
Dialogue: 0,1:11:56.15,1:11:58.15,Default,,0000,0000,0000,,《Бұл шеңбер белгісі емес》
Dialogue: 0,1:11:58.15,1:12:03.15,Default,,0000,0000,0000,,《Бұл пішін бір жерде... Ха! 》
Dialogue: 0,1:12:03.15,1:12:06.12,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:12:03.15,1:12:06.12,Default,,0000,0000,0000,,Конан-кун! ?
Dialogue: 0,1:12:08.16,1:12:11.09,Default,,0000,0000,0000,,Ууууууууууууууууууууууууууууууууу...
Dialogue: 0,1:12:11.09,1:12:15.10,Default,,0000,0000,0000,,｟Мұранаканың орнында
Dialogue: 0,1:12:11.09,1:12:15.10,Default,,0000,0000,0000,,Мен қорқытқан хат алдым｠
Dialogue: 0,1:12:15.10,1:12:18.10,Default,,0000,0000,0000,,｟Мм... «Мен біреуге айтқым келеді
Dialogue: 0,1:12:15.10,1:12:18.10,Default,,0000,0000,0000,,Бұл өте маңызды естелік''
Dialogue: 0,1:12:18.10,1:12:20.10,Default,,0000,0000,0000,,(Кристина)
Dialogue: 0,1:12:18.10,1:12:20.10,Default,,0000,0000,0000,,｜Мен Жапонияда тұрамын｠
Dialogue: 0,1:12:20.10,1:12:24.11,Default,,0000,0000,0000,,｟Мен оны ауруханада кездестірдім.
Dialogue: 0,1:12:20.10,1:12:24.11,Default,,0000,0000,0000,,Мен иық жарақатымен ауруханаға түскенде｠
Dialogue: 0,1:12:24.11,1:12:27.11,Default,,0000,0000,0000,,｟Уау~ Қандай тағдырлы кездесу! ｠
Dialogue: 0,1:12:27.11,1:12:29.11,Default,,0000,0000,0000,,｟Жақсы, мен солай деп ойлаймын｠
Dialogue: 0,1:12:27.11,1:12:29.11,Default,,0000,0000,0000,,｟Жәбірленушілердің жоғалған заттары үшін➡️
Dialogue: 0,1:12:29.11,1:12:31.11,Default,,0000,0000,0000,,Бала байқап қалып, көтеріп алды➡️
Dialogue: 0,1:12:31.11,1:12:33.12,Default,,0000,0000,0000,,Мен оны тапсыруға тырысқанда-ақ
Dialogue: 0,1:12:31.11,1:12:33.12,Default,,0000,0000,0000,,Жалын шықты｠
Dialogue: 0,1:12:33.12,1:12:37.12,Default,,0000,0000,0000,,｟Менің досым шынымен қалайды
Dialogue: 0,1:12:33.12,1:12:37.12,Default,,0000,0000,0000,,Менің саған бір нәрсе бергім келеді...｠
Dialogue: 0,1:12:37.12,1:12:39.12,Default,,0000,0000,0000,,｟Мен детектив Мацудаға осыны көрсеткім келді.
Dialogue: 0,1:12:37.12,1:12:39.12,Default,,0000,0000,0000,,Хабар? ｠
Dialogue: 0,1:12:39.12,1:12:41.12,Default,,0000,0000,0000,,｟Конан жігіттері
Dialogue: 0,1:12:39.12,1:12:41.12,Default,,0000,0000,0000,,Не келді ➡️
Dialogue: 0,1:12:41.12,1:12:43.13,Default,,0000,0000,0000,,Тіпті Прамья үшін
Dialogue: 0,1:12:41.12,1:12:43.13,Default,,0000,0000,0000,,Бұл күтпеген болды｠
Dialogue: 0,1:12:43.13,1:12:45.13,Default,,0000,0000,0000,,｟Негізі Муранака мырза мен ханым сонда болды...｠
Dialogue: 0,1:12:45.13,1:12:47.13,Default,,0000,0000,0000,,
Dialogue: 0,1:12:45.13,1:12:47.13,Default,,0000,0000,0000,,｟Прамьядан кек алуға ант берді➡️
Dialogue: 0,1:12:47.13,1:12:49.13,Default,,0000,0000,0000,,Біз бірге тұрған жолдастармыз.
Dialogue: 0,1:12:49.13,1:12:53.14,Default,,0000,0000,0000,,(Муранака)
Dialogue: 0,1:12:49.13,1:12:53.14,Default,,0000,0000,0000,,｟«Той жоспарланғандай өтуі керек»｠
Dialogue: 0,1:12:53.14,1:12:56.14,Default,,0000,0000,0000,,｟«Егер біз бас тартсақ, ➡️
Dialogue: 0,1:12:56.14,1:13:00.11,Default,,0000,0000,0000,,Көбірек құрбандар
Dialogue: 0,1:12:56.14,1:13:00.11,Default,,0000,0000,0000,,Ол шығатын шығар.»｠
Dialogue: 0,1:13:02.14,1:13:06.15,Default,,0000,0000,0000,,Міне... міне, жауап.
Dialogue: 0,1:13:06.15,1:13:10.15,Default,,0000,0000,0000,,Конан-кун!
Dialogue: 0,1:13:06.15,1:13:10.15,Default,,0000,0000,0000,,А... не болды?
Dialogue: 0,1:13:10.15,1:13:12.09,Default,,0000,0000,0000,,Мынаны қараңыз
Dialogue: 0,1:13:10.15,1:13:12.09,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:13:12.09,1:13:15.09,Default,,0000,0000,0000,,Хэллоуин күні
Dialogue: 0,1:13:12.09,1:13:15.09,Default,,0000,0000,0000,,Бұл көлік қозғалысы шектелген аймақ.
Dialogue: 0,1:13:15.09,1:13:18.09,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,1:13:15.09,1:13:18.09,Default,,0000,0000,0000,,Вайдзиро
Dialogue: 0,1:13:15.09,1:13:18.09,Default,,0000,0000,0000,,Миямасузака
Dialogue: 0,1:13:15.09,1:13:18.09,Default,,0000,0000,0000,,Догензака астындағы Y-қиылысынан
Dialogue: 0,1:13:15.09,1:13:18.09,Default,,0000,0000,0000,,Миямасузакаға қарай ➡️
Dialogue: 0,1:13:18.09,1:13:20.10,Default,,0000,0000,0000,,Жол ұзақ, солай ма?
Dialogue: 0,1:13:18.09,1:13:20.10,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:13:20.10,1:13:22.10,Default,,0000,0000,0000,,Джингуу
Dialogue: 0,1:13:20.10,1:13:22.10,Default,,0000,0000,0000,,Алдымен Цзингу көшесі сол жерден қиылысады.
Dialogue: 0,1:13:22.10,1:13:26.10,Default,,0000,0000,0000,,Мэйдзи
Dialogue: 0,1:13:22.10,1:13:26.10,Default,,0000,0000,0000,,Шибуя станциясындағы күзетшіден өтті
Dialogue: 0,1:13:22.10,1:13:26.10,Default,,0000,0000,0000,,Мэйдзи Дори да қиылысады
Dialogue: 0,1:13:26.10,1:13:28.10,Default,,0000,0000,0000,,Егер сіз оны 90 градусқа бұрсаңыз
Dialogue: 0,1:13:28.10,1:13:30.11,Default,,0000,0000,0000,,Бұл иендік белгі болады.
Dialogue: 0,1:13:30.11,1:13:32.11,Default,,0000,0000,0000,,Мен көрген жанбаған естелік➡️ болды
Dialogue: 0,1:13:32.11,1:13:34.11,Default,,0000,0000,0000,,Мұндағы сызық
Dialogue: 0,1:13:32.11,1:13:34.11,Default,,0000,0000,0000,,Өйткені ол жай ғана жанып тұрды➡️
Dialogue: 0,1:13:34.11,1:13:37.11,Default,,0000,0000,0000,,Мен оны иен белгісімен қателестім.
Dialogue: 0,1:13:37.11,1:13:40.12,Default,,0000,0000,0000,,Бірақ Муранака және т.б
Dialogue: 0,1:13:37.11,1:13:40.12,Default,,0000,0000,0000,,Хикари той жасап жатыр➡️
Dialogue: 0,1:13:40.12,1:13:45.12,Default,,0000,0000,0000,,Ол Шибуяда.
Dialogue: 0,1:13:40.12,1:13:45.12,Default,,0000,0000,0000,,Мұндай суретті салудың қажеті жоқ.
Dialogue: 0,1:13:45.12,1:13:47.12,Default,,0000,0000,0000,,Жоқ, бұл жай ғана Хикари емес.
Dialogue: 0,1:13:47.12,1:13:50.09,Default,,0000,0000,0000,,Мүмкін тіпті айнала...
Dialogue: 0,1:13:52.13,1:13:55.13,Default,,0000,0000,0000,,Конан-кун
Dialogue: 0,1:13:52.13,1:13:55.13,Default,,0000,0000,0000,,Сіз Шиничи сияқты сөздер айтасыз.
Dialogue: 0,1:13:55.13,1:13:58.13,Default,,0000,0000,0000,,Ех! Болды
Dialogue: 0,1:13:55.13,1:13:58.13,Default,,0000,0000,0000,,Маған Шиничидің ағасы айтты
Dialogue: 0,1:13:58.13,1:14:01.14,Default,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,1:13:58.13,1:14:01.14,Default,,0000,0000,0000,,Оқиға туралы Шиничимен кеңестіңіз бе?
Dialogue: 0,1:14:01.14,1:14:03.14,Default,,0000,0000,0000,,Ух... иә және ➡️
Dialogue: 0,1:14:03.14,1:14:06.14,Default,,0000,0000,0000,,Тағы бір жұмбақ шешілді
Dialogue: 0,1:14:03.14,1:14:06.14,Default,,0000,0000,0000,,деді
Dialogue: 0,1:14:06.14,1:14:09.14,Default,,0000,0000,0000,,Мен оған ілініп кете жаздадым.
Dialogue: 0,1:14:06.14,1:14:09.14,Default,,0000,0000,0000,,Ғимараттың жарылысы➡️
Dialogue: 0,1:14:09.14,1:14:12.08,Default,,0000,0000,0000,,Өйткені, бұл Мұранака мырза еді.
Dialogue: 0,1:14:09.14,1:14:12.08,Default,,0000,0000,0000,,Менің көздегенім бұл емес еді.
Dialogue: 0,1:14:12.08,1:14:14.08,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,1:14:14.08,1:14:16.08,Default,,0000,0000,0000,,Яғни
Dialogue: 0,1:14:14.08,1:14:16.08,Default,,0000,0000,0000,,Ол бізді әу бастан нысанаға алды.
Dialogue: 0,1:14:16.08,1:14:20.09,Default,,0000,0000,0000,,Осы дәлелдемелердің ескертулері
Dialogue: 0,1:14:16.08,1:14:20.09,Default,,0000,0000,0000,,Көрген болуы мүмкін адамдар➡️
Dialogue: 0,1:14:20.09,1:14:22.09,Default,,0000,0000,0000,,Кінәлі оны өшірмек болды.
Dialogue: 0,1:14:22.09,1:14:24.09,Default,,0000,0000,0000,,Аа, тоқта, неге кінәлі?➡️
Dialogue: 0,1:14:24.09,1:14:27.10,Default,,0000,0000,0000,,Балалар сол көп пәтерлі үйде болды.
Dialogue: 0,1:14:24.09,1:14:27.10,Default,,0000,0000,0000,,Баратыныңызды білдіңіз бе?
Dialogue: 0,1:14:27.10,1:14:29.10,Default,,0000,0000,0000,,Бомба
Dialogue: 0,1:14:27.10,1:14:29.10,Default,,0000,0000,0000,,Бұл таймер түрі болды, солай ма?
Dialogue: 0,1:14:29.10,1:14:32.10,Default,,0000,0000,0000,,Ол алдын ала орнатылған.
Dialogue: 0,1:14:29.10,1:14:32.10,Default,,0000,0000,0000,,Мен оны естідім.
Dialogue: 0,1:14:32.10,1:14:36.10,Default,,0000,0000,0000,,Барлығы сонда барсын
Dialogue: 0,1:14:32.10,1:14:36.10,Default,,0000,0000,0000,,Оны орнатқан адам болуы керек, солай ма?
Dialogue: 0,1:14:36.10,1:14:41.11,Default,,0000,0000,0000,,Ех! Кездесу болады деп ойламадым.
Dialogue: 0,1:14:36.10,1:14:41.11,Default,,0000,0000,0000,,Мен бұл ... ішінде екенін айттым.
Dialogue: 0,1:14:41.11,1:14:44.11,Default,,0000,0000,0000,,Қылмыскер бет пішінін өзгертті.
Dialogue: 0,1:14:41.11,1:14:44.11,Default,,0000,0000,0000,,Жапонияда жасырыну
Dialogue: 0,1:14:44.11,1:14:47.12,Default,,0000,0000,0000,,Қоғамдық қауіпсіздік детективі осылай деді.
Dialogue: 0,1:14:47.12,1:14:49.12,Default,,0000,0000,0000,,｟Бұл проблема болар еді｠
Dialogue: 0,1:14:49.12,1:14:53.12,Default,,0000,0000,0000,,｟Осыдан кейін модератормен
Dialogue: 0,1:14:49.12,1:14:53.12,Default,,0000,0000,0000,,Менің кездесуім бар...｠
Dialogue: 0,1:14:53.12,1:14:56.12,Default,,0000,0000,0000,,Нағыз тұлға - Цутому Муранака! ?
Dialogue: 0,1:14:56.12,1:15:00.13,Default,,0000,0000,0000,,Біраз уақыттан бері зейнеткерлікке шыққаным рас.
Dialogue: 0,1:14:56.12,1:15:00.13,Default,,0000,0000,0000,,Егер сіз зейнеткерлікке шыққан болсаңыз➡️
Dialogue: 0,1:15:00.13,1:15:03.13,Default,,0000,0000,0000,,Орын ауыстыру мүмкіндігі
Dialogue: 0,1:15:00.13,1:15:03.13,Default,,0000,0000,0000,,Бұл ➡️ болуы мүмкін
Dialogue: 0,1:15:03.13,1:15:05.13,Default,,0000,0000,0000,,Ол полицияның түлегі!
Dialogue: 0,1:15:05.13,1:15:07.14,Default,,0000,0000,0000,,｟Жәбірленушінің жоғалған мүлкі үшін
Dialogue: 0,1:15:05.13,1:15:07.14,Default,,0000,0000,0000,,Байқаған бала➡️
Dialogue: 0,1:15:07.14,1:15:09.14,Default,,0000,0000,0000,,Мен оны алып, саған беруге тырыстым...｠
Dialogue: 0,1:15:09.14,1:15:13.08,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:15:09.14,1:15:13.08,Default,,0000,0000,0000,,Себебі мен сол кезде сөйледім...
Dialogue: 0,1:15:13.08,1:15:16.08,Default,,0000,0000,0000,,Сол кезде Ран-ни-чан
Dialogue: 0,1:15:13.08,1:15:16.08,Default,,0000,0000,0000,,Баланың атын атамау
Dialogue: 0,1:15:16.08,1:15:20.08,Default,,0000,0000,0000,,Сонымен оны қай бала көтерді?
Dialogue: 0,1:15:16.08,1:15:20.08,Default,,0000,0000,0000,,Мен түсінбедім.
Dialogue: 0,1:15:20.08,1:15:23.09,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,1:15:20.08,1:15:23.09,Default,,0000,0000,0000,,Барлығы бомбамен өлтірмек болды
Dialogue: 0,1:15:23.09,1:15:26.09,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,1:15:23.09,1:15:26.09,Default,,0000,0000,0000,,Бұл Шиничидің ағасының теориясы.
Dialogue: 0,1:15:26.09,1:15:28.09,Default,,0000,0000,0000,,Қорқынышты...
Dialogue: 0,1:15:28.09,1:15:31.09,Default,,0000,0000,0000,,《Осы кейіпкер ғана қалды.
Dialogue: 0,1:15:28.09,1:15:31.09,Default,,0000,0000,0000,,Бұл ағылшынша емес, орысша.
Dialogue: 0,1:15:31.09,1:15:34.10,Default,,0000,0000,0000,,《Жоғарыда Пуглия болуы мүмкін》
Dialogue: 0,1:15:34.10,1:15:36.10,Default,,0000,0000,0000,,《Оқ мағынасында...》
Dialogue: 0,1:15:36.10,1:15:39.10,Default,,0000,0000,0000,,《Төменде бұл не?
Dialogue: 0,1:15:36.10,1:15:39.10,Default,,0000,0000,0000,,40 саны... Ах! 》
Dialogue: 0,1:15:39.10,1:15:43.11,Default,,0000,0000,0000,,Ран-ничан! бұл туралы маған
Dialogue: 0,1:15:39.10,1:15:43.11,Default,,0000,0000,0000,,Мен бәріне хабарлаймын!
Dialogue: 0,1:15:43.11,1:15:45.11,Default,,0000,0000,0000,,А, күте тұрыңыз!
Dialogue: 0,1:15:43.11,1:15:45.11,Default,,0000,0000,0000,,Сосын Мұранака мырза➡️
Dialogue: 0,1:15:45.11,1:15:48.11,Default,,0000,0000,0000,,Өлім қаупін өзіңіз жасаңыз
Dialogue: 0,1:15:45.11,1:15:48.11,Default,,0000,0000,0000,,шықты! ?
Dialogue: 0,1:15:48.11,1:15:51.08,Default,,0000,0000,0000,,Шиничи не айтты?
Dialogue: 0,1:15:48.11,1:15:51.08,Default,,0000,0000,0000,,Конан-кун!
Dialogue: 0,1:15:55.12,1:15:57.12,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,1:15:55.12,1:15:57.12,Default,,0000,0000,0000,,Ах…
Dialogue: 0,1:15:57.12,1:16:00.12,Default,,0000,0000,0000,,Шынымды айтсам, қорқамын.
Dialogue: 0,1:16:00.12,1:16:03.13,Default,,0000,0000,0000,,Біз сізді міндетті түрде қорғаймыз!
Dialogue: 0,1:16:03.13,1:16:06.13,Default,,0000,0000,0000,,Жапонияда қазірдің өзінде
Dialogue: 0,1:16:03.13,1:16:06.13,Default,,0000,0000,0000,,Сіз екі адамды өлтірдіңіз, солай ма?
Dialogue: 0,1:16:06.13,1:16:09.13,Default,,0000,0000,0000,,Юкине-кун, барсың ба?
Dialogue: 0,1:16:06.13,1:16:09.13,Default,,0000,0000,0000,,Сол ғимаратқа қойылған бомба...
Dialogue: 0,1:16:09.13,1:16:13.07,Default,,0000,0000,0000,,Прамяға бәрібір.
Dialogue: 0,1:16:09.13,1:16:13.07,Default,,0000,0000,0000,,Мен саған бір саусақпен тигізуге рұқсат бермеймін.
Dialogue: 0,1:16:13.07,1:16:16.07,Default,,0000,0000,0000,,🔊♪～
Dialogue: 0,1:16:16.07,1:16:19.07,Default,,0000,0000,0000,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,1:16:16.07,1:16:19.07,Default,,0000,0000,0000,,Қауіпті!
Dialogue: 0,1:16:19.07,1:16:22.08,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:16:22.08,1:16:26.08,Default,,0000,0000,0000,,️ (Репортер) Шибуяда осы жерді басыңыз
Dialogue: 0,1:16:22.08,1:16:26.08,Default,,0000,0000,0000,,Осы жылы Хэллоуинді тағы да тамашалайық...
Dialogue: 0,1:16:26.08,1:16:28.08,Default,,0000,0000,0000,,Хэллоуин болса да➡️
Dialogue: 0,1:16:28.08,1:16:32.09,Default,,0000,0000,0000,,Чи
Dialogue: 0,1:16:28.08,1:16:32.09,Default,,0000,0000,0000,,Бұл дәрігердің үйі~ Қызық...
Dialogue: 0,1:16:32.09,1:16:35.09,Default,,0000,0000,0000,,Ааа
Dialogue: 0,1:16:32.09,1:16:35.09,Default,,0000,0000,0000,,Аюми де Шибуяға барғысы келді.
Dialogue: 0,1:16:35.09,1:16:40.10,Default,,0000,0000,0000,,Бізде өзімізден басқа амал жоқ.
Dialogue: 0,1:16:35.09,1:16:40.10,Default,,0000,0000,0000,,Мен бара алмаймын.
Dialogue: 0,1:16:40.10,1:16:42.10,Default,,0000,0000,0000,,Ересектер
Dialogue: 0,1:16:40.10,1:16:42.10,Default,,0000,0000,0000,,Олай емес сияқты.
Dialogue: 0,1:16:42.10,1:16:44.10,Default,,0000,0000,0000,,Тыныш болыңыз
Dialogue: 0,1:16:44.10,1:16:46.10,Default,,0000,0000,0000,,Джажан!
Dialogue: 0,1:16:44.10,1:16:46.10,Default,,0000,0000,0000,,Сәлем Сәлем Хэллоуин ➡️
Dialogue: 0,1:16:46.10,1:16:48.10,Default,,0000,0000,0000,,Бұл қызықты викторина!
Dialogue: 0,1:16:48.10,1:16:50.11,Default,,0000,0000,0000,,Уф...
Dialogue: 0,1:16:50.11,1:16:52.11,Default,,0000,0000,0000,,Аяқ, аяқ, аяқ!
Dialogue: 0,1:16:52.11,1:16:54.11,Default,,0000,0000,0000,,Зәулім ғимараттарға толы үлкен қала➡️
Dialogue: 0,1:16:54.11,1:16:59.11,Default,,0000,0000,0000,,Сол түндегі көріністі қорғау үшін
Dialogue: 0,1:16:54.11,1:16:59.11,Default,,0000,0000,0000,,Ортада полиция қызу жұмыс істеп жатыр.
Dialogue: 0,1:16:59.11,1:17:02.12,Default,,0000,0000,0000,,Төмендегілердің қайсысы?
Dialogue: 0,1:17:02.12,1:17:05.12,Default,,0000,0000,0000,,Синдзюку
Dialogue: 0,1:17:02.12,1:17:05.12,Default,,0000,0000,0000,,Синджуку полициясы Шибуя полициясы ➡️
Dialogue: 0,1:17:05.12,1:17:10.13,Default,,0000,0000,0000,,Шинагава
Dialogue: 0,1:17:05.12,1:17:10.13,Default,,0000,0000,0000,,Икебукуро
Dialogue: 0,1:17:05.12,1:17:10.13,Default,,0000,0000,0000,,Шинагава полициясы
Dialogue: 0,1:17:05.12,1:17:10.13,Default,,0000,0000,0000,,Икебукуро полициясы
Dialogue: 0,1:17:10.13,1:17:12.06,Default,,0000,0000,0000,,Енді викторина
Dialogue: 0,1:17:10.13,1:17:12.06,Default,,0000,0000,0000,,Мен оны шешкім келмейді.
Dialogue: 0,1:17:12.06,1:17:15.06,Default,,0000,0000,0000,,Басыңды пайдалансаң, қарның аш болады.
Dialogue: 0,1:17:15.06,1:17:17.07,Default,,0000,0000,0000,,Мен Шибуяға барғым келді...
Dialogue: 0,1:17:17.07,1:17:20.07,Default,,0000,0000,0000,,О, Аюми-чан, дұрыс айтасың!
Dialogue: 0,1:17:20.07,1:17:22.07,Default,,0000,0000,0000,,Жауап: Шибуя полициясы
Dialogue: 0,1:17:22.07,1:17:25.07,Default,,0000,0000,0000,,Дәл ортасында түнгі көрініс бар!
Dialogue: 0,1:17:25.07,1:17:27.08,Default,,0000,0000,0000,,Я...
Dialogue: 0,1:17:25.07,1:17:27.08,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,1:17:27.08,1:17:30.08,Default,,0000,0000,0000,,Мен бұл туралы ойлануға уақыт тапсам да.
Dialogue: 0,1:17:27.08,1:17:30.08,Default,,0000,0000,0000,, (Әдіс режимі)
Dialogue: 0,1:17:30.08,1:17:33.08,Default,,0000,0000,0000,,Иә, иә, бұл не?
Dialogue: 0,1:17:30.08,1:17:33.08,Default,,0000,0000,0000,,Не? Не! Не? ?
Dialogue: 0,1:17:33.08,1:17:37.09,Default,,0000,0000,0000,,Жоқ, бірақ әлі емес...
Dialogue: 0,1:17:33.08,1:17:37.09,Default,,0000,0000,0000,,Не болды? дәрігер
Dialogue: 0,1:17:37.09,1:17:39.09,Default,,0000,0000,0000,,Е! ?
Dialogue: 0,1:17:37.09,1:17:39.09,Default,,0000,0000,0000,,Электрондық пошта кімнен? Аа ➡️
Dialogue: 0,1:17:39.09,1:17:41.09,Default,,0000,0000,0000,,Мүмкін Конан-кун шығар?
Dialogue: 0,1:17:39.09,1:17:41.09,Default,,0000,0000,0000,,Не? А, жоқ, жоқ ➡️
Dialogue: 0,1:17:41.09,1:17:45.09,Default,,0000,0000,0000,,Жоқ, жоқ! Тек осы~
Dialogue: 0,1:17:41.09,1:17:45.09,Default,,0000,0000,0000,,Не айтайын... хахаха...
Dialogue: 0,1:17:45.09,1:17:48.10,Default,,0000,0000,0000,,Сіз бірдеңені жасырып тұрсыз ба?
Dialogue: 0,1:17:48.10,1:17:53.10,Default,,0000,0000,0000,,♪ (Жабық музыка)
Dialogue: 0,1:17:53.10,1:18:09.12,Default,,0000,0000,0000,,♪~
Dialogue: 0,1:18:09.12,1:18:13.99,Default,,0000,0000,0000,,♪~
Dialogue: 0,1:18:15.06,1:18:17.03,Default,,0000,0000,0000,,(Григори)
Dialogue: 0,1:18:19.06,1:18:21.06,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:18:19.06,1:18:21.06,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,1:18:21.06,1:18:24.07,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,1:18:21.06,1:18:24.07,Default,,0000,0000,0000,,Сіз мұны қайдан білдіңіз?
Dialogue: 0,1:18:24.07,1:18:27.07,Default,,0000,0000,0000,,Артыңыздағы адамға орамал киген кезде
Dialogue: 0,1:18:24.07,1:18:27.07,Default,,0000,0000,0000,,Аз ғана.
Dialogue: 0,1:18:27.07,1:18:29.07,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:18:29.07,1:18:31.07,Default,,0000,0000,0000,,Сол кезде!
Dialogue: 0,1:18:31.07,1:18:33.04,Default,,0000,0000,0000,,Мен сенімен сөйлесуім керек, Еленика.
Dialogue: 0,1:18:36.08,1:18:39.08,Default,,0000,0000,0000,,Бүгін түнде бұл жерде қауіпті.
Dialogue: 0,1:18:36.08,1:18:39.08,Default,,0000,0000,0000,,Үйге тез қайт
Dialogue: 0,1:18:39.08,1:18:42.08,Default,,0000,0000,0000,,(орыс)
Dialogue: 0,1:18:42.08,1:18:45.09,Default,,0000,0000,0000,,(Григори)
Dialogue: 0,1:18:45.09,1:18:48.09,Default,,0000,0000,0000,,Енді сақиналарды алмастырайық.
Dialogue: 0,1:18:48.09,1:18:58.10,Default,,0000,0000,0000,,♪~
Dialogue: 0,1:18:58.10,1:19:00.10,Default,,0000,0000,0000,,Әй, не болды! ?
Dialogue: 0,1:18:58.10,1:19:00.10,Default,,0000,0000,0000,,Инспектор: Бұл қиын!
Dialogue: 0,1:19:00.10,1:19:04.11,Default,,0000,0000,0000,,Ол жерде іздеуде жүрген топ бар.
Dialogue: 0,1:19:00.10,1:19:04.11,Default,,0000,0000,0000,,Баланы кепілге алу...
Dialogue: 0,1:19:04.11,1:19:06.11,Default,,0000,0000,0000,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:19:06.11,1:19:08.11,Default,,0000,0000,0000,,Прамя! Дайын бол!
Dialogue: 0,1:19:08.11,1:19:12.05,Default,,0000,0000,0000,,Қозғалмаңыз! Баланың басы ұшып кетеді
Dialogue: 0,1:19:12.05,1:19:14.05,Default,,0000,0000,0000,,Конан-кун!
Dialogue: 0,1:19:12.05,1:19:14.05,Default,,0000,0000,0000,,Бұл жігітті шын мәнінде өлтіру керек.
Dialogue: 0,1:19:14.05,1:19:18.05,Default,,0000,0000,0000,,Қарғыс атқыр... осылай істе
Dialogue: 0,1:19:14.05,1:19:18.05,Default,,0000,0000,0000,,(Норияки) Онда Үндістанмен қоштасу уақыты келді
Dialogue: 0,1:19:18.05,1:19:20.06,Default,,0000,0000,0000,,
Dialogue: 0,1:19:18.05,1:19:20.06,Default,,0000,0000,0000,,Прамьяның шынайы тұлғасы ашылды.
Dialogue: 0,1:19:20.06,1:19:23.06,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,1:19:23.06,1:19:25.06,Default,,0000,0000,0000,,Алдында екі адам, алыстаңыз.
Dialogue: 0,1:19:25.06,1:19:29.06,Default,,0000,0000,0000,,Арттағы детектив
Dialogue: 0,1:19:25.06,1:19:29.06,Default,,0000,0000,0000,,Кіру есігін жабыңыз және бекітіңіз.
Dialogue: 0,1:19:29.06,1:19:31.03,Default,,0000,0000,0000,,Ә? Рика?
Dialogue: 0,1:19:34.07,1:19:36.04,Default,,0000,0000,0000,,(Құлыптың жабылу дыбысы)
Dialogue: 0,1:19:44.08,1:19:49.08,Default,,0000,0000,0000,,Қолыңды көтер, Прамя.
Dialogue: 0,1:19:44.08,1:19:49.08,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,1:19:49.08,1:19:52.09,Default,,0000,0000,0000,,Не айтып тұрсың!
Dialogue: 0,1:19:49.08,1:19:52.09,Default,,0000,0000,0000,,Оны нысанаға алып жатыр!
Dialogue: 0,1:19:52.09,1:19:54.09,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:19:52.09,1:19:54.09,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:19:54.09,1:19:57.09,Default,,0000,0000,0000,,Уф…
Dialogue: 0,1:19:54.09,1:19:57.09,Default,,0000,0000,0000,,А... сен кінәлісің бе?
Dialogue: 0,1:19:57.09,1:20:01.10,Default,,0000,0000,0000,,Цк, жоқ!
Dialogue: 0,1:19:57.09,1:20:01.10,Default,,0000,0000,0000,,Мен неге өзімді қорқытпақпын...
Dialogue: 0,1:20:01.10,1:20:04.10,Default,,0000,0000,0000,,
Dialogue: 0,1:20:01.10,1:20:04.10,Default,,0000,0000,0000,,Қозғалмаңыз! Келін де, күйеу де
Dialogue: 0,1:20:04.10,1:20:07.07,Default,,0000,0000,0000,,Тез, қолдарыңды көтер.
Dialogue: 0,1:20:09.10,1:20:14.11,Default,,0000,0000,0000,,Не болды? қалыңдық
Dialogue: 0,1:20:09.10,1:20:14.11,Default,,0000,0000,0000,,Қолдарыңызды да көтеріңіз.
Dialogue: 0,1:20:14.11,1:20:17.11,Default,,0000,0000,0000,,(Танжиро) Тұр, тұр! Тоқта, Иносукэ~!
Dialogue: 0,1:20:14.11,1:20:17.11,Default,,0000,0000,0000,,Ол 3 жыл бұрын жарақат алған➡️
Dialogue: 0,1:20:17.11,1:20:20.12,Default,,0000,0000,0000,,Жол-көлік оқиғасының салдары
Dialogue: 0,1:20:17.11,1:20:20.12,Default,,0000,0000,0000,,Оң иығымды көтере алмаймын!
Dialogue: 0,1:20:20.12,1:20:23.12,Default,,0000,0000,0000,,Жол-көлік оқиғасы? Ха
Dialogue: 0,1:20:23.12,1:20:26.12,Default,,0000,0000,0000,,3 жыл бұрын жапондық детектив
Dialogue: 0,1:20:23.12,1:20:26.12,Default,,0000,0000,0000,,Себебі мені мылтықпен атып тастады➡️
Dialogue: 0,1:20:26.12,1:20:28.12,Default,,0000,0000,0000,,Оң қолыңызды көтере алмайсыз, солай ма?
Dialogue: 0,1:20:28.12,1:20:31.13,Default,,0000,0000,0000,,Сәлем Кристин Ричард
Dialogue: 0,1:20:31.13,1:20:34.13,Default,,0000,0000,0000,,Жоқ, Прамя!
Dialogue: 0,1:20:34.13,1:20:36.13,Default,,0000,0000,0000,,Мен... кінәлі мен бе?
Dialogue: 0,1:20:36.13,1:20:40.14,Default,,0000,0000,0000,,Уайымдамаңыз!
Dialogue: 0,1:20:36.13,1:20:40.14,Default,,0000,0000,0000,,Неліктен ол кінәлі деп ойлайсыз?
Dialogue: 0,1:20:40.14,1:20:42.14,Default,,0000,0000,0000,,Ах! бұл?
Dialogue: 0,1:20:42.14,1:20:44.14,Default,,0000,0000,0000,,Металл іздегіш.
Dialogue: 0,1:20:44.14,1:20:48.14,Default,,0000,0000,0000,,Прамьяның иығында Причо бар
Dialogue: 0,1:20:44.14,1:20:48.14,Default,,0000,0000,0000,,Bullet Pullia жерленген
Dialogue: 0,1:20:48.14,1:20:52.15,Default,,0000,0000,0000,,Егер сіз оны жақындатсаңыз, ол әрекет етуі керек.
Dialogue: 0,1:20:48.14,1:20:52.15,Default,,0000,0000,0000,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,1:20:52.15,1:20:54.15,Default,,0000,0000,0000,,Хирургияда
Dialogue: 0,1:20:52.15,1:20:54.15,Default,,0000,0000,0000,,Оның құрамында металл болттар бар!
Dialogue: 0,1:20:54.15,1:20:56.15,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,1:20:54.15,1:20:56.15,Default,,0000,0000,0000,,Ойланып қарашы, сен➡️
Dialogue: 0,1:20:56.15,1:20:59.15,Default,,0000,0000,0000,,Дәл қазір, күту залында, Прамя
Dialogue: 0,1:20:56.15,1:20:59.15,Default,,0000,0000,0000,,Сіз екі адамды өлтірдім дедіңіз.
Dialogue: 0,1:20:59.15,1:21:02.16,Default,,0000,0000,0000,,Қашып кеткен сериялық бомбалаушыны өлтіру➡️
Dialogue: 0,1:21:02.16,1:21:05.16,Default,,0000,0000,0000,,Мәселе мынада
Dialogue: 0,1:21:02.16,1:21:05.16,Default,,0000,0000,0000,,Ресми түрде жарияланбаса да➡️
Dialogue: 0,1:21:05.16,1:21:08.16,Default,,0000,0000,0000,,Сіз
Dialogue: 0,1:21:05.16,1:21:08.16,Default,,0000,0000,0000,,Неліктен екі адам?
Dialogue: 0,1:21:05.16,1:21:08.16,Default,,0000,0000,0000,,Тіпті сен! ?
Dialogue: 0,1:21:08.16,1:21:10.17,Default,,0000,0000,0000,,Толық қауіпсіздікпен тойымыз➡️
Dialogue: 0,1:21:10.17,1:21:12.10,Default,,0000,0000,0000,,Ол сізді қорғайды.
Dialogue: 0,1:21:10.17,1:21:12.10,Default,,0000,0000,0000,,Болмады ма? ?
Dialogue: 0,1:21:12.10,1:21:15.10,Default,,0000,0000,0000,,Және де
Dialogue: 0,1:21:12.10,1:21:15.10,Default,,0000,0000,0000,,Интрузияға оңай рұқсат беру➡️
Dialogue: 0,1:21:15.10,1:21:20.11,Default,,0000,0000,0000,,Қылмыскер ретінде қаралды
Dialogue: 0,1:21:15.10,1:21:20.11,Default,,0000,0000,0000,,Үйлену тойы дау-дамай!
Dialogue: 0,1:21:20.11,1:21:24.11,Default,,0000,0000,0000,,Кешіріңіз Кристин
Dialogue: 0,1:21:20.11,1:21:24.11,Default,,0000,0000,0000,,Күн шуақты сахна...
Dialogue: 0,1:21:24.11,1:21:30.12,Default,,0000,0000,0000,,Иа... хех
Dialogue: 0,1:21:24.11,1:21:30.12,Default,,0000,0000,0000,,Хехехе... хехехе...
Dialogue: 0,1:21:30.12,1:21:35.12,Default,,0000,0000,0000,,Маған не болды
Dialogue: 0,1:21:30.12,1:21:35.12,Default,,0000,0000,0000,,Мен мұны жасадым.
Dialogue: 0,1:21:35.12,1:21:37.09,Default,,0000,0000,0000,,Кристин? Не дейсіз...
Dialogue: 0,1:21:41.13,1:21:43.13,Default,,0000,0000,0000,,(Кристина)
Dialogue: 0,1:21:41.13,1:21:43.13,Default,,0000,0000,0000,,А, шулы, шулы...
Dialogue: 0,1:21:43.13,1:21:46.13,Default,,0000,0000,0000,,К...Крис
Dialogue: 0,1:21:43.13,1:21:46.13,Default,,0000,0000,0000,,Толық шулы
Dialogue: 0,1:21:46.13,1:21:49.14,Default,,0000,0000,0000,,Балалар сендер шыбын сияқтысыңдар.
Dialogue: 0,1:21:46.13,1:21:49.14,Default,,0000,0000,0000,,Ах! ?
Dialogue: 0,1:21:49.14,1:21:51.14,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:21:51.14,1:21:54.14,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,1:21:54.14,1:21:56.14,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:21:56.14,1:21:59.15,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:21:59.15,1:22:01.15,Default,,0000,0000,0000,,О
Dialogue: 0,1:21:59.15,1:22:01.15,Default,,0000,0000,0000,,Бәрің, тезірек тығылыңдар!
Dialogue: 0,1:22:01.15,1:22:03.15,Default,,0000,0000,0000,,Конан-кун! ?
Dialogue: 0,1:22:01.15,1:22:03.15,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,1:22:03.15,1:22:05.15,Default,,0000,0000,0000,,Уау, түсіндім!
Dialogue: 0,1:22:05.15,1:22:11.09,Default,,0000,0000,0000,,Менің шынайы болмысымды білетіндер
Dialogue: 0,1:22:05.15,1:22:11.09,Default,,0000,0000,0000,,Ешкімді құтқару мүмкін емес!
Dialogue: 0,1:22:11.09,1:22:14.10,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:22:14.10,1:22:17.10,Default,,0000,0000,0000,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,1:22:14.10,1:22:17.10,Default,,0000,0000,0000,,Хахаха!
Dialogue: 0,1:22:17.10,1:22:20.07,Default,,0000,0000,0000,,(Мұранака)
Dialogue: 0,1:22:17.10,1:22:20.07,Default,,0000,0000,0000,,Тоқта, Кристин!
Dialogue: 0,1:22:22.10,1:22:25.11,Default,,0000,0000,0000,,Ах…
Dialogue: 0,1:22:22.10,1:22:25.11,Default,,0000,0000,0000,,Муранака~! !
Dialogue: 0,1:22:25.11,1:22:27.11,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:22:25.11,1:22:27.11,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:22:27.11,1:22:30.11,Default,,0000,0000,0000,,Инспектор Мегур! Жарайды! ?
Dialogue: 0,1:22:27.11,1:22:30.11,Default,,0000,0000,0000,,Тез осында жасырын!
Dialogue: 0,1:22:30.11,1:22:32.08,Default,,0000,0000,0000,,Уф…
Dialogue: 0,1:22:43.12,1:22:45.13,Default,,0000,0000,0000,,Келін кінәлі! Екінші қабаттағы өткелде!
Dialogue: 0,1:22:45.13,1:22:49.13,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:22:45.13,1:22:49.13,Default,,0000,0000,0000,,Хахаха! Ахаха!
Dialogue: 0,1:22:49.13,1:22:51.13,Default,,0000,0000,0000,,Басқа подъезден барайық!
Dialogue: 0,1:22:51.13,1:22:53.13,Default,,0000,0000,0000,,Мұранака, берік бол!
Dialogue: 0,1:22:53.13,1:22:57.14,Default,,0000,0000,0000,,Мегуре Кешіріңіз.
Dialogue: 0,1:22:53.13,1:22:57.14,Default,,0000,0000,0000,,Мен шынымен ақымақпын...
Dialogue: 0,1:22:57.14,1:23:00.14,Default,,0000,0000,0000,,Ақымақ! Мұндай нәрсе
Dialogue: 0,1:22:57.14,1:23:00.14,Default,,0000,0000,0000,,Бұл жаңалық емес.
Dialogue: 0,1:23:00.14,1:23:02.14,Default,,0000,0000,0000,,Егер мен қазір бұл туралы алаңдасам, не істеуім керек?
Dialogue: 0,1:23:02.14,1:23:07.15,Default,,0000,0000,0000,,Дене басынан бұрын интуиция негізінде қозғалады.
Dialogue: 0,1:23:02.14,1:23:07.15,Default,,0000,0000,0000,,Жын ауылы!
Dialogue: 0,1:23:07.15,1:23:09.15,Default,,0000,0000,0000,,Мегур…
Dialogue: 0,1:23:09.15,1:23:11.09,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:23:09.15,1:23:11.09,Default,,0000,0000,0000,,Сато мырза! ?
Dialogue: 0,1:23:11.09,1:23:13.09,Default,,0000,0000,0000,,Сато-кун!
Dialogue: 0,1:23:11.09,1:23:13.09,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:23:13.09,1:23:15.09,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:23:15.09,1:23:17.09,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:23:15.09,1:23:17.09,Default,,0000,0000,0000,,Қауіпті!
Dialogue: 0,1:23:17.09,1:23:19.09,Default,,0000,0000,0000,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:23:17.09,1:23:19.09,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:23:19.09,1:23:23.10,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:23:23.10,1:23:25.10,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,1:23:25.10,1:23:28.10,Default,,0000,0000,0000,,Такаги-кун, бұл ауыр! Мен сені қуамын!
Dialogue: 0,1:23:25.10,1:23:28.10,Default,,0000,0000,0000,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,1:23:28.10,1:23:30.11,Default,,0000,0000,0000,,Ол шатырға бет алған болуы керек!
Dialogue: 0,1:23:28.10,1:23:30.11,Default,,0000,0000,0000,,Ол➡️
Dialogue: 0,1:23:30.11,1:23:32.11,Default,,0000,0000,0000,,Сіз тікұшақпен қашуды жоспарлап отырсыз ба?
Dialogue: 0,1:23:32.11,1:23:34.11,Default,,0000,0000,0000,,Неке қию рәсімі ретінде
Dialogue: 0,1:23:32.11,1:23:34.11,Default,,0000,0000,0000,,Жалға алынған тікұшақ.
Dialogue: 0,1:23:34.11,1:23:36.08,Default,,0000,0000,0000,,Бізге асығу керек
Dialogue: 0,1:23:58.13,1:24:00.14,Default,,0000,0000,0000,,Цк... кешігіп қалдыңыз.
Dialogue: 0,1:24:00.14,1:24:04.14,Default,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,1:24:00.14,1:24:04.14,Default,,0000,0000,0000,,Менің ойымша, бас тартқан дұрыс.
Dialogue: 0,1:24:04.14,1:24:07.11,Default,,0000,0000,0000,,Кристин
Dialogue: 0,1:24:09.14,1:24:14.08,Default,,0000,0000,0000,,Прамья дегеніміз не?
Dialogue: 0,1:24:09.14,1:24:14.08,Default,,0000,0000,0000,,Қоңырау шалған дұрыс сияқты.
Dialogue: 0,1:24:14.08,1:24:17.09,Default,,0000,0000,0000,,Сен кімсің?
Dialogue: 0,1:24:17.09,1:24:21.09,Default,,0000,0000,0000,,Конан Эдогава детективі
Dialogue: 0,1:24:21.09,1:24:23.06,Default,,0000,0000,0000,,Ха ха ха…
Dialogue: 0,1:24:25.09,1:24:28.10,Default,,0000,0000,0000,,Өтірік Ол ашылмайды...
Dialogue: 0,1:24:25.09,1:24:28.10,Default,,0000,0000,0000,,Детектив?
Dialogue: 0,1:24:28.10,1:24:34.10,Default,,0000,0000,0000,,Жоспарыңыз орындалмады.
Dialogue: 0,1:24:28.10,1:24:34.10,Default,,0000,0000,0000,,Олардың барлығын бірге өлтіру жоспары.
Dialogue: 0,1:24:34.10,1:24:37.11,Default,,0000,0000,0000,,Еленика және т.б
Dialogue: 0,1:24:34.10,1:24:37.11,Default,,0000,0000,0000,,Нада Юничитожити - ➡️
Dialogue: 0,1:24:37.11,1:24:40.11,Default,,0000,0000,0000,,Сізден кейін
Dialogue: 0,1:24:37.11,1:24:40.11,Default,,0000,0000,0000,,Мен әлемнің кез келген жерінде болдым
Dialogue: 0,1:24:40.11,1:24:42.11,Default,,0000,0000,0000,,Прамя күткендей
Dialogue: 0,1:24:40.11,1:24:42.11,Default,,0000,0000,0000,,Бұрышталған
Dialogue: 0,1:24:42.11,1:24:45.11,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,1:24:42.11,1:24:45.11,Default,,0000,0000,0000,,Мен өзімді тірілту үшін жоспар құрдым.
Dialogue: 0,1:24:45.11,1:24:50.12,Default,,0000,0000,0000,,Оларды бір жерге жинаңыз
Dialogue: 0,1:24:45.11,1:24:50.12,Default,,0000,0000,0000,,Оны сүйікті бомбамен жарып жіберіңіз
Dialogue: 0,1:24:50.12,1:24:52.12,Default,,0000,0000,0000,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,1:24:52.12,1:24:56.12,Default,,0000,0000,0000,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,1:24:52.12,1:24:56.12,Default,,0000,0000,0000,,Өзіңізді детектив деп атасаңыз жеткілікті.
Dialogue: 0,1:24:56.12,1:24:58.13,Default,,0000,0000,0000,,Дұрыс айтасың, балам.
Dialogue: 0,1:24:58.13,1:25:02.13,Default,,0000,0000,0000,,(Есік ашылу дыбысы)
Dialogue: 0,1:24:58.13,1:25:02.13,Default,,0000,0000,0000,,I бірінші
Dialogue: 0,1:24:58.13,1:25:02.13,Default,,0000,0000,0000,,Зейнеткерлікке шығады деген қауесет тарату➡️
Dialogue: 0,1:25:02.13,1:25:04.13,Default,,0000,0000,0000,,Сосын ауылға жақындадық.
Dialogue: 0,1:25:04.13,1:25:08.14,Default,,0000,0000,0000,,Ал Муранака мырзаны біреу өлтірді.
Dialogue: 0,1:25:04.13,1:25:08.14,Default,,0000,0000,0000,,Мен нысанаға алған әңгімені құрастырдым
Dialogue: 0,1:25:08.14,1:25:12.07,Default,,0000,0000,0000,,Егер Прамья қатысты болса
Dialogue: 0,1:25:08.14,1:25:12.07,Default,,0000,0000,0000,,Олар батылдықпен келеді
Dialogue: 0,1:25:12.07,1:25:16.08,Default,,0000,0000,0000,,Мені ұстап ал
Dialogue: 0,1:25:12.07,1:25:16.08,Default,,0000,0000,0000,,Бұл менің соңғы мүмкіндігім деп қорқамын
Dialogue: 0,1:25:16.08,1:25:21.08,Default,,0000,0000,0000,,Сізде басқа мақсат болды.
Dialogue: 0,1:25:16.08,1:25:21.08,Default,,0000,0000,0000,,Куәларды жою
Dialogue: 0,1:25:21.08,1:25:24.09,Default,,0000,0000,0000,,Сіз Прамья ретіндесіз
Dialogue: 0,1:25:21.08,1:25:24.09,Default,,0000,0000,0000,,Мені көрген адам➡️
Dialogue: 0,1:25:24.09,1:25:27.09,Default,,0000,0000,0000,,Мен олардың бәрін өлтірдім, бірақ...
Dialogue: 0,1:25:27.09,1:25:33.09,Default,,0000,0000,0000,,Иә, мен бір кездері Жапонияда болдым.
Dialogue: 0,1:25:27.09,1:25:33.09,Default,,0000,0000,0000,,Мен өзімді қорланғандай сезіндім.
Dialogue: 0,1:25:33.09,1:25:36.10,Default,,0000,0000,0000,,Осы төрт полиция қызметкерімен!
Dialogue: 0,1:25:36.10,1:25:39.10,Default,,0000,0000,0000,,Мақсат...
Dialogue: 0,1:25:36.10,1:25:39.10,Default,,0000,0000,0000,,Танымал жауаптар
Dialogue: 0,1:25:39.10,1:25:43.10,Default,,0000,0000,0000,,Елордалық полиция департаментіндегі терең тергеу нәтижелері
Dialogue: 0,1:25:39.10,1:25:43.10,Default,,0000,0000,0000,,Мацуда қызмет бабында қайтыс болған➡️
Dialogue: 0,1:25:43.10,1:25:46.11,Default,,0000,0000,0000,,Күні де жол апатынан қайтыс болды.
Dialogue: 0,1:25:46.11,1:25:49.11,Default,,0000,0000,0000,,Қалған нәрсе
Dialogue: 0,1:25:46.11,1:25:49.11,Default,,0000,0000,0000,,Екі адам Нөл Хиро деп атады
Dialogue: 0,1:25:49.11,1:25:52.11,Default,,0000,0000,0000,,Тек Моробуши Фуруя есімі
Dialogue: 0,1:25:49.11,1:25:52.11,Default,,0000,0000,0000,,Түсіндім, бірақ➡️
Dialogue: 0,1:25:52.11,1:25:54.12,Default,,0000,0000,0000,,Қанша іздесеңіз де➡️
Dialogue: 0,1:25:54.12,1:25:57.12,Default,,0000,0000,0000,,Сол екі адам туралы ақпарат
Dialogue: 0,1:25:54.12,1:25:57.12,Default,,0000,0000,0000,,Шықпа
Dialogue: 0,1:25:57.12,1:26:01.12,Default,,0000,0000,0000,,Детектив Мацуда қызметтік міндетін атқару кезінде қаза тапты.
Dialogue: 0,1:25:57.12,1:26:01.12,Default,,0000,0000,0000,,Бомбардирлерді пайдалану➡️
Dialogue: 0,1:26:01.12,1:26:03.12,Default,,0000,0000,0000,,Сіз мені еліктірмек болдыңыз, солай емес пе?
Dialogue: 0,1:26:03.12,1:26:06.13,Default,,0000,0000,0000,,(Прамя)
Dialogue: 0,1:26:03.12,1:26:06.13,Default,,0000,0000,0000,,Иә, егер ол кісінің қашып кетуіне жол берсем➡️
Dialogue: 0,1:26:06.13,1:26:09.13,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,1:26:06.13,1:26:09.13,Default,,0000,0000,0000,,Асығыс
Dialogue: 0,1:26:06.13,1:26:09.13,Default,,0000,0000,0000,,Тесіктен жорғалап шығады дейді.
Dialogue: 0,1:26:09.13,1:26:13.07,Default,,0000,0000,0000,,Күтілгендей, Фуруя пайда болады.
Dialogue: 0,1:26:09.13,1:26:13.07,Default,,0000,0000,0000,,Бомба сәтті орнатылды
Dialogue: 0,1:26:13.07,1:26:16.07,Default,,0000,0000,0000,,Егер сіз соншалықты алысқа барсаңыз
Dialogue: 0,1:26:13.07,1:26:16.07,Default,,0000,0000,0000,,Тағы біреуі міндетті түрде болады.
Dialogue: 0,1:26:16.07,1:26:18.07,Default,,0000,0000,0000,,Оқығаным➡️
Dialogue: 0,1:26:18.07,1:26:21.08,Default,,0000,0000,0000,,Осы уақытқа дейін барсаң да
Dialogue: 0,1:26:18.07,1:26:21.08,Default,,0000,0000,0000,,Шықпаса...➡️
Dialogue: 0,1:26:21.08,1:26:24.08,Default,,0000,0000,0000,,Ол өлді, солай ма?
Dialogue: 0,1:26:24.08,1:26:27.08,Default,,0000,0000,0000,,Елениканың ағасы Олег
Dialogue: 0,1:26:24.08,1:26:27.08,Default,,0000,0000,0000,,Менде болған планшет
Dialogue: 0,1:26:27.08,1:26:30.08,Default,,0000,0000,0000,,Бұл да тұзақ болды, солай ма?
Dialogue: 0,1:26:27.08,1:26:30.08,Default,,0000,0000,0000,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,1:26:30.08,1:26:32.09,Default,,0000,0000,0000,,Әдейі ұрлау үшін жасалған
Dialogue: 0,1:26:30.08,1:26:32.09,Default,,0000,0000,0000,,Планшетті ұстаңыз➡️
Dialogue: 0,1:26:32.09,1:26:36.09,Default,,0000,0000,0000,,Достарына қайтып келсе
Dialogue: 0,1:26:32.09,1:26:36.09,Default,,0000,0000,0000,,Оны сол жерде жарыңыз➡️
Dialogue: 0,1:26:36.09,1:26:39.09,Default,,0000,0000,0000,,Нада Unititojiti
Dialogue: 0,1:26:36.09,1:26:39.09,Default,,0000,0000,0000,,Ұшып кетуі мүмкін
Dialogue: 0,1:26:39.09,1:26:41.10,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,1:26:39.09,1:26:41.10,Default,,0000,0000,0000,,Ол достарымен ешқашан кездеспеген➡️
Dialogue: 0,1:26:41.10,1:26:43.10,Default,,0000,0000,0000,,Жалғыз әрекет етуді жалғастырыңыз➡️
Dialogue: 0,1:26:43.10,1:26:47.10,Default,,0000,0000,0000,,Матсудамен кездесу
Dialogue: 0,1:26:43.10,1:26:47.10,Default,,0000,0000,0000,,Мен бәрін айтып беруге тырыстым.
Dialogue: 0,1:26:47.10,1:26:51.11,Default,,0000,0000,0000,,Мацуда әлдеқашан өлген болса да.
Dialogue: 0,1:26:47.10,1:26:51.11,Default,,0000,0000,0000,,Сонымен➡️
Dialogue: 0,1:26:51.11,1:26:54.11,Default,,0000,0000,0000,,Планшетте GPS орнатылған
Dialogue: 0,1:26:51.11,1:26:54.11,Default,,0000,0000,0000,,Сіз оны белгілегенсіз➡️
Dialogue: 0,1:26:54.11,1:26:57.11,Default,,0000,0000,0000,,Елордалық полиция бөліміне жеткізілмес бұрын
Dialogue: 0,1:26:54.11,1:26:57.11,Default,,0000,0000,0000,,Сіз бомбаны іске қостыңыз, солай ма?
Dialogue: 0,1:26:57.11,1:27:01.12,Default,,0000,0000,0000,,Мен оны планшетімде сақтадым.
Dialogue: 0,1:26:57.11,1:27:01.12,Default,,0000,0000,0000,,Tokyo➡️ кілт сөзі
Dialogue: 0,1:27:01.12,1:27:04.12,Default,,0000,0000,0000,,Нада Юнититоити
Dialogue: 0,1:27:01.12,1:27:04.12,Default,,0000,0000,0000,,Олар➡️
Dialogue: 0,1:27:04.12,1:27:06.12,Default,,0000,0000,0000,,Әдемі түсті.
Dialogue: 0,1:27:06.12,1:27:09.12,Default,,0000,0000,0000,,Бірақ бұл адам
Dialogue: 0,1:27:06.12,1:27:09.12,Default,,0000,0000,0000,,Иығымдағы оқ туралы➡️
Dialogue: 0,1:27:09.12,1:27:13.06,Default,,0000,0000,0000,,Мен білген қате есеп болды.
Dialogue: 0,1:27:13.06,1:27:16.06,Default,,0000,0000,0000,,Олег қалдырған жазбада
Dialogue: 0,1:27:13.06,1:27:16.06,Default,,0000,0000,0000,,байқадым
Dialogue: 0,1:27:16.06,1:27:18.07,Default,,0000,0000,0000,,Оқ пен иық
Dialogue: 0,1:27:18.07,1:27:21.07,Default,,0000,0000,0000,,3 жыл бұрын Прамя
Dialogue: 0,1:27:18.07,1:27:21.07,Default,,0000,0000,0000,,Оқ менің иығыма да тиді.
Dialogue: 0,1:27:21.07,1:27:23.07,Default,,0000,0000,0000,,Егер сіз оны шығарып алғыңыз келсе
Dialogue: 0,1:27:21.07,1:27:23.07,Default,,0000,0000,0000,,Нервтердің зақымдануы➡️
Dialogue: 0,1:27:23.07,1:27:26.07,Default,,0000,0000,0000,,Қол қимылдары
Dialogue: 0,1:27:23.07,1:27:26.07,Default,,0000,0000,0000,,Маған қиындық тудыратынын айтты.
Dialogue: 0,1:27:26.07,1:27:30.08,Default,,0000,0000,0000,,Күрделі бомбалар жасайтындар үшін
Dialogue: 0,1:27:26.07,1:27:30.08,Default,,0000,0000,0000,,Бұл өлімге әкеледі
Dialogue: 0,1:27:30.08,1:27:34.08,Default,,0000,0000,0000,,Сондықтан мен оны шығарудан бас тарттым.
Dialogue: 0,1:27:30.08,1:27:34.08,Default,,0000,0000,0000,,Оның орнына➡️
Dialogue: 0,1:27:34.08,1:27:37.09,Default,,0000,0000,0000,,Оң қолды енді көтеру мүмкін емес
Dialogue: 0,1:27:34.08,1:27:37.09,Default,,0000,0000,0000,,дұрыс па?
Dialogue: 0,1:27:37.09,1:27:40.09,Default,,0000,0000,0000,,Сіз қойған бомба қайда?
Dialogue: 0,1:27:40.09,1:27:42.09,Default,,0000,0000,0000,,(Прамя)
Dialogue: 0,1:27:40.09,1:27:42.09,Default,,0000,0000,0000,,Сіз бұл туралы білгеннен кейін не істейсіз?
Dialogue: 0,1:27:42.09,1:27:46.09,Default,,0000,0000,0000,,Сіздің шынайы тұлғаңыз – полиция.
Dialogue: 0,1:27:42.09,1:27:46.09,Default,,0000,0000,0000,,Соның ішінде Nada Unititojiti➡️
Dialogue: 0,1:27:46.09,1:27:48.10,Default,,0000,0000,0000,,көптеген адамдарға белгілі болды
Dialogue: 0,1:27:48.10,1:27:51.10,Default,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,1:27:48.10,1:27:51.10,Default,,0000,0000,0000,,Оны жарудың қажеті жоқ.
Dialogue: 0,1:27:51.10,1:27:54.10,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:27:51.10,1:27:54.10,Default,,0000,0000,0000,,Мен мұны ертерек айтуым керек еді.
Dialogue: 0,1:27:54.10,1:27:59.11,Default,,0000,0000,0000,,«Кім менің шын болмысымды білсе
Dialogue: 0,1:27:54.10,1:27:59.11,Default,,0000,0000,0000,,Ешкімді аман алып қалу мүмкін емес».
Dialogue: 0,1:27:59.11,1:28:02.11,Default,,0000,0000,0000,,Бұл жігіттердің бәрі ақымақ.
Dialogue: 0,1:28:02.11,1:28:05.11,Default,,0000,0000,0000,,Хэллоуин мерекесін жандандыру
Dialogue: 0,1:28:02.11,1:28:05.11,Default,,0000,0000,0000,,Тек безендіру үшін➡️
Dialogue: 0,1:28:05.11,1:28:08.12,Default,,0000,0000,0000,,Менің ойымша, сіз олай ойламайсыз.
Dialogue: 0,1:28:05.11,1:28:08.12,Default,,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,1:28:08.12,1:28:10.12,Default,,0000,0000,0000,,Бұл Ранран ба!
Dialogue: 0,1:28:10.12,1:28:12.05,Default,,0000,0000,0000,,(Прамя)
Dialogue: 0,1:28:10.12,1:28:12.05,Default,,0000,0000,0000,,Сұйық мылтық, оның ішінде муляждар ➡️
Dialogue: 0,1:28:12.05,1:28:16.06,Default,,0000,0000,0000,,Догензака, Миямасузака, т.б.
Dialogue: 0,1:28:12.05,1:28:16.06,Default,,0000,0000,0000,,Орналастырылды
Dialogue: 0,1:28:16.06,1:28:18.06,Default,,0000,0000,0000,,Сұйықтық ең төменгі орында➡️
Dialogue: 0,1:28:18.06,1:28:22.06,Default,,0000,0000,0000,,Басқаша айтқанда, шифрлы қиылысу
Dialogue: 0,1:28:18.06,1:28:22.06,Default,,0000,0000,0000,,Мақсатқа қарай төмен қарай ағу
Dialogue: 0,1:28:22.06,1:28:26.07,Default,,0000,0000,0000,,Мен көремін. Шибуядағы биіктік айырмашылығы.
Dialogue: 0,1:28:22.06,1:28:26.07,Default,,0000,0000,0000,,Сіз оны қолдандыңыз ба?
Dialogue: 0,1:28:26.07,1:28:29.07,Default,,0000,0000,0000,,(Шырақтың сынған дыбысы)
Dialogue: 0,1:28:26.07,1:28:29.07,Default,,0000,0000,0000,,(Айқай)
Dialogue: 0,1:28:29.07,1:28:32.07,Default,,0000,0000,0000,,(Прамя)
Dialogue: 0,1:28:29.07,1:28:32.07,Default,,0000,0000,0000,,Аралас сұйық бомбалардың көп мөлшері ➡️
Dialogue: 0,1:28:32.07,1:28:35.08,Default,,0000,0000,0000,,Бұрынғыдан да көп
Dialogue: 0,1:28:32.07,1:28:35.08,Default,,0000,0000,0000,,Үлкен жарылыс тудырады
Dialogue: 0,1:28:35.08,1:28:41.08,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:28:41.08,1:28:43.08,Default,,0000,0000,0000,,(Прамя)
Dialogue: 0,1:28:41.08,1:28:43.08,Default,,0000,0000,0000,,Ал менің шынайы болмысымды білетіндер➡️
Dialogue: 0,1:28:43.08,1:28:46.09,Default,,0000,0000,0000,,Бұл дүниеден бәрі жойылады.
Dialogue: 0,1:28:46.09,1:28:51.09,Default,,0000,0000,0000,,Фуфуфу… Ахахаха!
Dialogue: 0,1:28:51.09,1:28:55.10,Default,,0000,0000,0000,,Ахаха!
Dialogue: 0,1:28:51.09,1:28:55.10,Default,,0000,0000,0000,,Менің де естігім келгені осы еді.
Dialogue: 0,1:28:55.10,1:28:58.10,Default,,0000,0000,0000,,…бірақ ол құламайды!
Dialogue: 0,1:28:55.10,1:28:58.10,Default,,0000,0000,0000,,Тай!
Dialogue: 0,1:28:58.10,1:29:02.10,Default,,0000,0000,0000,,Гуах! ! Уф...
Dialogue: 0,1:29:02.10,1:29:05.11,Default,,0000,0000,0000,,Сіз...
Dialogue: 0,1:29:05.11,1:29:07.11,Default,,0000,0000,0000,,Фуруя нөл!
Dialogue: 0,1:29:07.11,1:29:11.05,Default,,0000,0000,0000,,Мен сені ұстағым келсе
Dialogue: 0,1:29:07.11,1:29:11.05,Default,,0000,0000,0000,,Кез келген уақытта орындалуы мүмкін
Dialogue: 0,1:29:11.05,1:29:13.05,Default,,0000,0000,0000,,Бомбаның орнын анықтау үшін➡️
Dialogue: 0,1:29:13.05,1:29:16.05,Default,,0000,0000,0000,,Мен сені әдейі сонша жүзуге мәжбүр еттім.
Dialogue: 0,1:29:16.05,1:29:18.05,Default,,0000,0000,0000,,《Ал, сол белгімен.
Dialogue: 0,1:29:16.05,1:29:18.05,Default,,0000,0000,0000,,Болжамдар➡️
Dialogue: 0,1:29:18.05,1:29:20.05,Default,,0000,0000,0000,,Бұл орындалды》
Dialogue: 0,1:29:20.05,1:29:22.06,Default,,0000,0000,0000,,Мен қабілетті жігітпін!
Dialogue: 0,1:29:20.05,1:29:22.06,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:29:22.06,1:29:24.03,Default,,0000,0000,0000,,Прамя!
Dialogue: 0,1:29:22.06,1:29:24.03,Default,,0000,0000,0000,,Енді қаша алмайсың!
Dialogue: 0,1:29:26.06,1:29:28.06,Default,,0000,0000,0000,,(Иықтың тарсылдаған дыбысы)
Dialogue: 0,1:29:26.06,1:29:28.06,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:29:28.06,1:29:33.07,Default,,0000,0000,0000,,Ха ха ха... Мен де... Болды...
Dialogue: 0,1:29:33.07,1:29:35.07,Default,,0000,0000,0000,,Жүр, қолыңды көтер.
Dialogue: 0,1:29:35.07,1:29:38.07,Default,,0000,0000,0000,,Оны бастың артына бұраңыз
Dialogue: 0,1:29:38.07,1:29:42.08,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,1:29:42.08,1:29:44.08,Default,,0000,0000,0000,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,1:29:42.08,1:29:44.08,Default,,0000,0000,0000,,Хахаха!
Dialogue: 0,1:29:44.08,1:29:47.08,Default,,0000,0000,0000,,Оның артында қандай себеп тұрса да,
Dialogue: 0,1:29:44.08,1:29:47.08,Default,,0000,0000,0000,,Мүмкіндігінше көп адам әкеліңіз!
Dialogue: 0,1:29:47.08,1:29:49.05,Default,,0000,0000,0000,,Тс!
Dialogue: 0,1:29:54.09,1:29:58.06,Default,,0000,0000,0000,,Алға! !
Dialogue: 0,1:30:04.10,1:30:06.10,Default,,0000,0000,0000,,…бірақ ол құламайды!
Dialogue: 0,1:30:04.10,1:30:06.10,Default,,0000,0000,0000,,Дәл тимеді!
Dialogue: 0,1:30:06.10,1:30:08.07,Default,,0000,0000,0000,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,1:30:12.11,1:30:17.08,Default,,0000,0000,0000,,Жеңіс! Фейерверк добы! !
Dialogue: 0,1:30:19.11,1:30:22.12,Default,,0000,0000,0000,,
Dialogue: 0,1:30:19.11,1:30:22.12,Default,,0000,0000,0000,,(отшашулардың дыбысы)
Dialogue: 0,1:30:22.12,1:30:24.09,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:30:27.12,1:30:30.12,Default,,0000,0000,0000,,Фу…
Dialogue: 0,1:30:27.12,1:30:30.12,Default,,0000,0000,0000,,(ротордың айналу дыбысы)
Dialogue: 0,1:30:30.12,1:30:34.13,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:30:30.12,1:30:34.13,Default,,0000,0000,0000,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,1:30:34.13,1:30:37.13,Default,,0000,0000,0000,,Ах, Мацуда екен.
Dialogue: 0,1:30:34.13,1:30:37.13,Default,,0000,0000,0000,,Сізде бос орын болуы керек.
Dialogue: 0,1:30:37.13,1:30:39.13,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:30:37.13,1:30:39.13,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,1:30:39.13,1:30:42.14,Default,,0000,0000,0000,,Сізден
Dialogue: 0,1:30:39.13,1:30:42.14,Default,,0000,0000,0000,,Мен сені тезірек о дүниеге жіберемін.
Dialogue: 0,1:30:42.14,1:30:47.14,Default,,0000,0000,0000,,Сол жағалы бомбамен! Хахаха!
Dialogue: 0,1:30:47.14,1:30:53.15,Default,,0000,0000,0000,,Хахаха! Ахахха!
Dialogue: 0,1:30:53.15,1:30:56.15,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:30:53.15,1:30:56.15,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:30:56.15,1:30:58.15,Default,,0000,0000,0000,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,1:30:56.15,1:30:58.15,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:30:58.15,1:31:00.15,Default,,0000,0000,0000,,Осындай жағдай болуы мүмкін бе деп ойлаймын➡️
Dialogue: 0,1:31:00.15,1:31:04.16,Default,,0000,0000,0000,,Мен сіздің сыйлығыңызды қайтардым.
Dialogue: 0,1:31:04.16,1:31:06.13,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:31:08.16,1:31:11.10,Default,,0000,0000,0000,,Бұл манекен! ?
Dialogue: 0,1:31:08.16,1:31:11.10,Default,,0000,0000,0000,,Фу…
Dialogue: 0,1:31:11.10,1:31:15.10,Default,,0000,0000,0000,,Бомба сұйықтығы
Dialogue: 0,1:31:11.10,1:31:15.10,Default,,0000,0000,0000,,Толық талдап, бейтараптандырғышты жасаңыз➡️
Dialogue: 0,1:31:15.10,1:31:20.11,Default,,0000,0000,0000,,Мен одан аулақ болдым.
Dialogue: 0,1:31:15.10,1:31:20.11,Default,,0000,0000,0000,,Менің тамаша бағыныштым бойынша.
Dialogue: 0,1:31:20.11,1:31:24.11,Default,,0000,0000,0000,,Сұйықтық осында жасалған.
Dialogue: 0,1:31:20.11,1:31:24.11,Default,,0000,0000,0000,,Сізге ұнады ма?
Dialogue: 0,1:31:24.11,1:31:27.08,Default,,0000,0000,0000,,Фуруя~!
Dialogue: 0,1:31:33.12,1:31:36.12,Default,,0000,0000,0000,,Төменде күтіңіз!
Dialogue: 0,1:31:33.12,1:31:36.12,Default,,0000,0000,0000,,Амуро-сан!
Dialogue: 0,1:31:36.12,1:31:38.09,Default,,0000,0000,0000,,Тея!
Dialogue: 0,1:31:40.13,1:31:42.13,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:31:42.13,1:31:46.13,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:31:42.13,1:31:46.13,Default,,0000,0000,0000,,Бұл жолы қашып кетуге жол бермеймін
Dialogue: 0,1:31:46.13,1:31:49.14,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:31:46.13,1:31:49.14,Default,,0000,0000,0000,,Мен табанды еркектерді жек көремін!
Dialogue: 0,1:31:49.14,1:31:51.14,Default,,0000,0000,0000,,Ти!
Dialogue: 0,1:31:49.14,1:31:51.14,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:31:51.14,1:31:53.11,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:31:55.14,1:31:57.14,Default,,0000,0000,0000,,Қандай ысырап!
Dialogue: 0,1:31:55.14,1:31:57.14,Default,,0000,0000,0000,,Тікұшақпен секіру➡️
Dialogue: 0,1:31:57.14,1:32:01.15,Default,,0000,0000,0000,,Қылмыскермен күрес...
Dialogue: 0,1:31:57.14,1:32:01.15,Default,,0000,0000,0000,,Конан-кун, бір-біріңді танисыңдар ма?
Dialogue: 0,1:32:01.15,1:32:03.15,Default,,0000,0000,0000,,Қылмыскерден жасыру
Dialogue: 0,1:32:01.15,1:32:03.15,Default,,0000,0000,0000,,Мен оны көре алмадым.
Dialogue: 0,1:32:03.15,1:32:05.15,Default,,0000,0000,0000,,Төмен түсейік!
Dialogue: 0,1:32:03.15,1:32:05.15,Default,,0000,0000,0000,,А, күте тұрыңыз!
Dialogue: 0,1:32:05.15,1:32:07.15,Default,,0000,0000,0000,,Бұл ұшқыш кім? ?
Dialogue: 0,1:32:07.15,1:32:10.16,Default,,0000,0000,0000,,Шынайы ма? Бұл
Dialogue: 0,1:32:07.15,1:32:10.16,Default,,0000,0000,0000,,Жаман емес пе?
Dialogue: 0,1:32:10.16,1:32:15.03,Default,,0000,0000,0000,,
Dialogue: 0,1:32:23.10,1:32:26.07,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:32:23.10,1:32:26.07,Default,,0000,0000,0000,,Иә! Ха!
Dialogue: 0,1:32:28.11,1:32:31.11,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:32:28.11,1:32:31.11,Default,,0000,0000,0000,,Ха! Хмф!
Dialogue: 0,1:32:31.11,1:32:33.11,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:32:31.11,1:32:33.11,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:32:33.11,1:32:35.12,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:32:33.11,1:32:35.12,Default,,0000,0000,0000,,(соққы дыбысы)
Dialogue: 0,1:32:35.12,1:32:39.12,Default,,0000,0000,0000,,Ооо... ә!
Dialogue: 0,1:32:35.12,1:32:39.12,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:32:39.12,1:32:41.12,Default,,0000,0000,0000,,Кук
Dialogue: 0,1:32:41.12,1:32:45.13,Default,,0000,0000,0000,,(Айқай)
Dialogue: 0,1:32:45.13,1:32:47.13,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:32:47.13,1:32:51.13,Default,,0000,0000,0000,,Уф... жіберші сені, бейбақ!
Dialogue: 0,1:32:51.13,1:32:53.13,Default,,0000,0000,0000,,Кана
Dialogue: 0,1:32:51.13,1:32:53.13,Default,,0000,0000,0000,,Сіздің үміттеріңіз енді орындалмайды.
Dialogue: 0,1:32:53.13,1:32:55.14,Default,,0000,0000,0000,,Қ–… Сен, порноман!
Dialogue: 0,1:32:55.14,1:32:59.11,Default,,0000,0000,0000,,Ах! Қарғыс атсын! !
Dialogue: 0,1:33:01.14,1:33:03.14,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:33:03.14,1:33:07.15,Default,,0000,0000,0000,,
Dialogue: 0,1:33:07.15,1:33:10.15,Default,,0000,0000,0000,,🔊 (полиция қызметкері)
Dialogue: 0,1:33:07.15,1:33:10.15,Default,,0000,0000,0000,,Тезірек Шибуядан кетіңіз!
Dialogue: 0,1:33:10.15,1:33:13.09,Default,,0000,0000,0000,,🔊(Офицер) Терроризм болуы мүмкін.
Dialogue: 0,1:33:10.15,1:33:13.09,Default,,0000,0000,0000,,Тез арада эвакуациялаңыз!
Dialogue: 0,1:33:13.09,1:33:17.09,Default,,0000,0000,0000,,Станциядан мүмкіндігінше алыс болыңыз!
Dialogue: 0,1:33:13.09,1:33:17.09,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,1:33:17.09,1:33:21.10,Default,,0000,0000,0000,,
Dialogue: 0,1:33:17.09,1:33:21.10,Default,,0000,0000,0000,,(Когороның қорылдауы)
Dialogue: 0,1:33:21.10,1:33:23.06,Default,,0000,0000,0000,,Не шу?
Dialogue: 0,1:33:26.10,1:33:29.10,Default,,0000,0000,0000,,Бұл жағдайда жүру жылдамырақ болар еді.
Dialogue: 0,1:33:29.10,1:33:31.11,Default,,0000,0000,0000,,Конанның электрондық поштасында➡️
Dialogue: 0,1:33:31.11,1:33:35.11,Default,,0000,0000,0000,,Шибуя қиылысының ортасында күтіңіз.
Онда
Dialogue: 0,1:33:31.11,1:33:35.11,Default,,0000,0000,0000,,жазылған, солай ма?
Dialogue: 0,1:33:35.11,1:33:37.11,Default,,0000,0000,0000,,Оны алыңыз
Dialogue: 0,1:33:37.11,1:33:40.08,Default,,0000,0000,0000,,Дәрігер, жарай ма?
Dialogue: 0,1:33:37.11,1:33:40.08,Default,,0000,0000,0000,,А... а...
Dialogue: 0,1:33:42.12,1:33:45.12,Default,,0000,0000,0000,,Менің жүгіруден басқа амалым жоқ!
Dialogue: 0,1:33:45.12,1:33:49.09,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:33:45.12,1:33:49.09,Default,,0000,0000,0000,,Өте сақ болыңыз!
Dialogue: 0,1:33:51.13,1:33:54.13,Default,,0000,0000,0000,,Уф…
Dialogue: 0,1:33:54.13,1:33:57.10,Default,,0000,0000,0000,,Бұл жарылыстың алдын ала ала ма?
Dialogue: 0,1:34:01.14,1:34:03.14,Default,,0000,0000,0000,,Сіз үшін...
Dialogue: 0,1:34:03.14,1:34:08.14,Default,,0000,0000,0000,,Сіз үшін
Dialogue: 0,1:34:03.14,1:34:08.14,Default,,0000,0000,0000,,Менің жоспарларым бұзылды!
Dialogue: 0,1:34:08.14,1:34:10.14,Default,,0000,0000,0000,,Ә? Рика?
Dialogue: 0,1:34:10.14,1:34:14.02,Default,,0000,0000,0000,,Өл! !
Dialogue: 0,1:34:19.09,1:34:21.09,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:34:21.09,1:34:25.09,Default,,0000,0000,0000,,Бұрынғы детектив ретінде Енді жоқ
Dialogue: 0,1:34:21.09,1:34:25.09,Default,,0000,0000,0000,,Қылмысты назардан тыс қалдыруға болмайды
Dialogue: 0,1:34:25.09,1:34:27.09,Default,,0000,0000,0000,,Сіз
Dialogue: 0,1:34:25.09,1:34:27.09,Default,,0000,0000,0000,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,1:34:25.09,1:34:27.09,Default,,0000,0000,0000,,Сіз тез➡️
Dialogue: 0,1:34:27.09,1:34:29.10,Default,,0000,0000,0000,,Бұл жерден кет
Dialogue: 0,1:34:27.09,1:34:29.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:34:29.10,1:34:31.10,Default,,0000,0000,0000,,Мен осында болсам
Dialogue: 0,1:34:29.10,1:34:31.10,Default,,0000,0000,0000,,Бұл жаман емес пе?
Dialogue: 0,1:34:31.10,1:34:34.10,Default,,0000,0000,0000,,Сіз қоғамдық қауіпсіздік қызметкерісіз, солай ма?
Dialogue: 0,1:34:31.10,1:34:34.10,Default,,0000,0000,0000,,Неге олай! ?
Dialogue: 0,1:34:34.10,1:34:37.10,Default,,0000,0000,0000,,(Муранака)
Dialogue: 0,1:34:34.10,1:34:37.10,Default,,0000,0000,0000,,Мен ұзақ уақыт тергеуші болып жұмыс істедім➡️
Dialogue: 0,1:34:37.10,1:34:39.11,Default,,0000,0000,0000,,Мен түйсік арқылы білемін.
Dialogue: 0,1:34:39.11,1:34:43.11,Default,,0000,0000,0000,,Ал, менің күйеуіме.
Dialogue: 0,1:34:39.11,1:34:43.11,Default,,0000,0000,0000,,Бұл болжам жұмыс істемеген сияқты.
Dialogue: 0,1:34:43.11,1:34:48.12,Default,,0000,0000,0000,,Жарайды, мен Мегуреден және басқалардан аузымды жұмамын.
Dialogue: 0,1:34:43.11,1:34:48.12,Default,,0000,0000,0000,,Тірі болса ғой.
Dialogue: 0,1:34:48.12,1:34:51.12,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:34:48.12,1:34:51.12,Default,,0000,0000,0000,,(Шырақтың сынған дыбысы)
Dialogue: 0,1:34:51.12,1:35:02.13,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:35:02.13,1:35:11.91,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:35:23.08,1:35:26.09,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:35:23.08,1:35:26.09,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:35:26.09,1:35:28.09,Default,,0000,0000,0000,,Атпа, Еленика!
Dialogue: 0,1:35:28.09,1:35:31.09,Default,,0000,0000,0000,,Жолдан кет, балам!
Dialogue: 0,1:35:28.09,1:35:31.09,Default,,0000,0000,0000,,Жолыма бөгет болсаң, мен де сені атып тастаймын!
Dialogue: 0,1:35:31.09,1:35:33.09,Default,,0000,0000,0000,,Прамьяны түсіргеннен кейін➡️
Dialogue: 0,1:35:33.09,1:35:36.10,Default,,0000,0000,0000,,Менің ұлым қайтып келмейді.
Dialogue: 0,1:35:33.09,1:35:36.10,Default,,0000,0000,0000,,Ах…
Dialogue: 0,1:35:36.10,1:35:38.10,Default,,0000,0000,0000,,Не білесің!
Dialogue: 0,1:35:38.10,1:35:42.10,Default,,0000,0000,0000,,Менің ұлым, күйеуім және ағам
Dialogue: 0,1:35:38.10,1:35:42.10,Default,,0000,0000,0000,,Барлығын ол өлтірді!
Dialogue: 0,1:35:42.10,1:35:47.11,Default,,0000,0000,0000,,Мен бұрынғы өміріме орала алмаймын.
Dialogue: 0,1:35:42.10,1:35:47.11,Default,,0000,0000,0000,,Мен көп жамандық жасадым!
Dialogue: 0,1:35:47.11,1:35:49.11,Default,,0000,0000,0000,,Оны өлтіру үшін!
Dialogue: 0,1:35:49.11,1:35:52.11,Default,,0000,0000,0000,,Бәрінің құнына
Dialogue: 0,1:35:49.11,1:35:52.11,Default,,0000,0000,0000,,Біз осы уақытқа дейін жеттік!
Dialogue: 0,1:35:52.11,1:35:56.12,Default,,0000,0000,0000,,Мен сені өз қолыммен өлтіруім керек.
Dialogue: 0,1:35:52.11,1:35:56.12,Default,,0000,0000,0000,,Мен көмектесе алмаймын! Жолдан кет, балам!
Dialogue: 0,1:35:56.12,1:35:58.09,Default,,0000,0000,0000,,Уф…
Dialogue: 0,1:36:00.12,1:36:03.12,Default,,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,1:36:00.12,1:36:03.12,Default,,0000,0000,0000,,Оны өлтіру керек пе?
Dialogue: 0,1:36:03.12,1:36:05.13,Default,,0000,0000,0000,,Менің күйеуім полиция қызметкері➡️
Dialogue: 0,1:36:05.13,1:36:10.13,Default,,0000,0000,0000,,Кісі өлтіру ісіне қатысы бар саясаткердің баласы
Dialogue: 0,1:36:05.13,1:36:10.13,Default,,0000,0000,0000,,Жаңа ғана күдіктіні қамауға алды.
Dialogue: 0,1:36:10.13,1:36:13.07,Default,,0000,0000,0000,,Егер сіз сотта бұл туралы куәлік етуге тырыссаңыз,
Dialogue: 0,1:36:10.13,1:36:13.07,Default,,0000,0000,0000,,өшірілді
Dialogue: 0,1:36:13.07,1:36:15.07,Default,,0000,0000,0000,,Ұлымен бірге
Dialogue: 0,1:36:15.07,1:36:18.07,Default,,0000,0000,0000,,Күйеуі мен ұлы
Dialogue: 0,1:36:15.07,1:36:18.07,Default,,0000,0000,0000,,Мен бірдеңені дұрыс істемедім бе?
Dialogue: 0,1:36:18.07,1:36:21.08,Default,,0000,0000,0000,,Эй, айтшы... Ха!
Dialogue: 0,1:36:21.08,1:36:26.08,Default,,0000,0000,0000,,Ооо... Ооооооооо... Ааа!
Dialogue: 0,1:36:26.08,1:36:31.09,Default,,0000,0000,0000,,Ах! Уф...
Dialogue: 0,1:36:31.09,1:36:35.09,Default,,0000,0000,0000,,Уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,1:36:35.09,1:36:42.10,Default,,0000,0000,0000,,Бұл адам жазалануы керек.
Dialogue: 0,1:36:35.09,1:36:42.10,Default,,0000,0000,0000,,Сондықтан жапон полициясына сенулеріңізді қалаймын.
Dialogue: 0,1:36:42.10,1:36:44.10,Default,,0000,0000,0000,,Еленика, ынтымақтасуыңызды өтінемін.
Dialogue: 0,1:36:44.10,1:36:47.10,Default,,0000,0000,0000,,Тоқтаңдар, екеуің де
Dialogue: 0,1:36:44.10,1:36:47.10,Default,,0000,0000,0000,,Қайғылы оқиғалардың алдын алу үшін➡️
Dialogue: 0,1:36:47.10,1:36:49.10,Default,,0000,0000,0000,,Бізге сіздің көмегіңіз қажет.
Dialogue: 0,1:36:49.10,1:36:52.07,Default,,0000,0000,0000,,Нада Unititojiti
Dialogue: 0,1:36:55.11,1:36:57.11,Default,,0000,0000,0000,,Конан!
Dialogue: 0,1:36:57.11,1:36:59.11,Default,,0000,0000,0000,,Конан!
Dialogue: 0,1:36:57.11,1:36:59.11,Default,,0000,0000,0000,,Қайдасың?!
Dialogue: 0,1:36:59.11,1:37:02.12,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:36:59.11,1:37:02.12,Default,,0000,0000,0000,,Сен мұнда не үшін келдің? ?
Dialogue: 0,1:37:02.12,1:37:05.12,Default,,0000,0000,0000,,Мен әңгімені дәрігерге қалдырдым.
Dialogue: 0,1:37:05.12,1:37:09.12,Default,,0000,0000,0000,,Иә, бұл жаңа белбеу.
Dialogue: 0,1:37:05.12,1:37:09.12,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,1:37:09.12,1:37:14.06,Default,,0000,0000,0000,,Шүкір, бізде уақыт жоқ!
Dialogue: 0,1:37:09.12,1:37:14.06,Default,,0000,0000,0000,,А, бұл да
Dialogue: 0,1:37:14.06,1:37:18.07,Default,,0000,0000,0000,,Менің дәрігерге жіберген электрондық поштадан басқа амалым жоқ.
Dialogue: 0,1:37:14.06,1:37:18.07,Default,,0000,0000,0000,,Мен оны көрдім. Сіз жасай аласыз ба?
Dialogue: 0,1:37:18.07,1:37:22.07,Default,,0000,0000,0000,,Иә, бұл аспалардың ұштары.
Dialogue: 0,1:37:18.07,1:37:22.07,Default,,0000,0000,0000,,Тасымалдау және жүгіру
Dialogue: 0,1:37:22.07,1:37:25.07,Default,,0000,0000,0000,,Қорғау және т.б.
Dialogue: 0,1:37:22.07,1:37:25.07,Default,,0000,0000,0000,,Оны бағдаршамға немесе басқа нәрсеге байлап қою керек.
Dialogue: 0,1:37:25.07,1:37:27.07,Default,,0000,0000,0000,,Бұл оңай жеңіс.
Dialogue: 0,1:37:27.07,1:37:30.08,Default,,0000,0000,0000,,Байлаудан кейін
Dialogue: 0,1:37:27.07,1:37:30.08,Default,,0000,0000,0000,,Детектив белгісімен Эдогаваға сигнал беріңіз
Dialogue: 0,1:37:30.08,1:37:32.05,Default,,0000,0000,0000,,Жақсы, барлығына.
Dialogue: 0,1:37:30.08,1:37:32.05,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:37:34.08,1:37:36.05,Default,,0000,0000,0000,,
Dialogue: 0,1:37:55.10,1:37:58.11,Default,,0000,0000,0000,,Муранака~!
Dialogue: 0,1:37:55.10,1:37:58.11,Default,,0000,0000,0000,,Мегур! Мен дұрыс жерге келдім
Dialogue: 0,1:37:58.11,1:38:01.11,Default,,0000,0000,0000,,Сіз оны ұстадыңыз! ?
Dialogue: 0,1:37:58.11,1:38:01.11,Default,,0000,0000,0000,,Әй, қалғанын өзім шешемін.
Dialogue: 0,1:38:01.11,1:38:03.11,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,1:38:01.11,1:38:03.11,Default,,0000,0000,0000,,Менің де баруым керек.
Dialogue: 0,1:38:03.11,1:38:06.08,Default,,0000,0000,0000,,Не? Қайда?
Dialogue: 0,1:38:03.11,1:38:06.08,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:38:11.05,1:38:13.05,Default,,0000,0000,0000,,《Ток жылдам, асығыңыз! 》
Dialogue: 0,1:38:13.05,1:38:16.06,Default,,0000,0000,0000,,Ммм! Және сәл ғана...
Dialogue: 0,1:38:16.06,1:38:19.06,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:38:16.06,1:38:19.06,Default,,0000,0000,0000,,Мен саған көмектесемін
Dialogue: 0,1:38:19.06,1:38:21.03,Default,,0000,0000,0000,,Мен оны сонда байлауым керек пе?
Dialogue: 0,1:38:23.06,1:38:25.07,Default,,0000,0000,0000,,Көмегің үшін рахмет.
Dialogue: 0,1:38:25.07,1:38:28.07,Default,,0000,0000,0000,,Дайын!
Dialogue: 0,1:38:25.07,1:38:28.07,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,1:38:28.07,1:38:42.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:38:42.08,1:38:44.05,Default,,0000,0000,0000,,О!
Dialogue: 0,1:38:51.09,1:38:54.09,Default,,0000,0000,0000,,Конан-кун... Кя!
Dialogue: 0,1:38:54.09,1:38:56.10,Default,,0000,0000,0000,,Осы уақытқа дейін!
Dialogue: 0,1:38:54.09,1:38:56.10,Default,,0000,0000,0000,,(Тұтқаның сықырлаған дыбысы)
Dialogue: 0,1:38:56.10,1:39:01.10,Default,,0000,0000,0000,,Асығыңыз...
Dialogue: 0,1:38:56.10,1:39:01.10,Default,,0000,0000,0000,,Кяах!
Dialogue: 0,1:39:01.10,1:39:06.11,Default,,0000,0000,0000,,Уау! Кяах!
Dialogue: 0,1:39:06.11,1:39:10.08,Default,,0000,0000,0000,,Аюми!
Dialogue: 0,1:39:06.11,1:39:10.08,Default,,0000,0000,0000,,Уау! Уф... Уау!
Dialogue: 0,1:39:12.05,1:39:15.05,Default,,0000,0000,0000,,Аюми Күтіңіз! Керемет...
Dialogue: 0,1:39:15.05,1:39:20.05,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:39:15.05,1:39:20.05,Default,,0000,0000,0000,,Хмм, жақсысың ба? ? Уф...
Dialogue: 0,1:39:20.05,1:39:23.06,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:39:20.05,1:39:23.06,Default,,0000,0000,0000,,Уф... Уф...
Dialogue: 0,1:39:23.06,1:39:26.06,Default,,0000,0000,0000,,Уф... уф!
Dialogue: 0,1:39:23.06,1:39:26.06,Default,,0000,0000,0000,,Ауыр жарақат!
Dialogue: 0,1:39:26.06,1:39:28.06,Default,,0000,0000,0000,,Неге үндемедің? ?
Dialogue: 0,1:39:28.06,1:39:30.06,Default,,0000,0000,0000,,Мен қазір бұл жерден кете алмаймын...
Dialogue: 0,1:39:30.06,1:39:33.07,Default,,0000,0000,0000,,Мен мұны басуым керек... Уау!
Dialogue: 0,1:39:33.07,1:39:36.07,Default,,0000,0000,0000,,Енді мен білемін!
Dialogue: 0,1:39:33.07,1:39:36.07,Default,,0000,0000,0000,,Эдогава-кун!
Dialogue: 0,1:39:36.07,1:39:39.07,Default,,0000,0000,0000,,Үлкенірек болса жаман болар еді!
Dialogue: 0,1:39:36.07,1:39:39.07,Default,,0000,0000,0000,,Төзімді тіректер➡️
Dialogue: 0,1:39:39.07,1:39:41.08,Default,,0000,0000,0000,,Мен оны қайтадан байлауым керек!
Dialogue: 0,1:39:41.08,1:39:44.08,Default,,0000,0000,0000,,Біз мұны жалғыз жасай алмаймыз!
Dialogue: 0,1:39:41.08,1:39:44.08,Default,,0000,0000,0000,,Оның күші одан сайын артып барады.
Dialogue: 0,1:39:44.08,1:39:47.08,Default,,0000,0000,0000,,《Қәлемет!
Dialogue: 0,1:39:44.08,1:39:47.08,Default,,0000,0000,0000,,Бізге көбірек адамдар керек! 》
Dialogue: 0,1:39:47.08,1:39:50.08,Default,,0000,0000,0000,,Ой...
Dialogue: 0,1:39:47.08,1:39:50.08,Default,,0000,0000,0000,,Такаги-кун!
Dialogue: 0,1:39:50.08,1:39:52.09,Default,,0000,0000,0000,,《Барлығы
Dialogue: 0,1:39:50.08,1:39:52.09,Default,,0000,0000,0000,,Біз көшірдік, ешкім қалмады! 》
Dialogue: 0,1:39:52.09,1:39:56.09,Default,,0000,0000,0000,,《Егер бұлай жалғаса берсе,
Dialogue: 0,1:39:52.09,1:39:56.09,Default,,0000,0000,0000,,Шибуя от теңізінде...》
Dialogue: 0,1:39:56.09,1:39:58.09,Default,,0000,0000,0000,,《Жүгірдім! 》
Dialogue: 0,1:39:58.09,1:40:00.09,Default,,0000,0000,0000,,Шиничи?
Dialogue: 0,1:40:00.09,1:40:03.10,Default,,0000,0000,0000,,Мықты болыңыз! Такаги-кун!
Dialogue: 0,1:40:03.10,1:40:06.10,Default,,0000,0000,0000,,Хмм! Уф...
Dialogue: 0,1:40:06.10,1:40:08.07,Default,,0000,0000,0000,,(Сергейдің орысшасы)
Dialogue: 0,1:40:11.11,1:40:14.07,Default,,0000,0000,0000,,(мүше орыс)
Dialogue: 0,1:40:24.12,1:40:27.09,Default,,0000,0000,0000,,(барлығы)
Dialogue: 0,1:40:29.12,1:40:32.13,Default,,0000,0000,0000,,(барлығы)
Dialogue: 0,1:40:32.13,1:40:34.09,Default,,0000,0000,0000,,Ууууууууууууууууууууууу...
Dialogue: 0,1:40:40.13,1:40:42.14,Default,,0000,0000,0000,,Қазір жақсы болуы керек.
Dialogue: 0,1:40:42.14,1:40:45.14,Default,,0000,0000,0000,,Мен де осыны қайталадым.
Dialogue: 0,1:40:42.14,1:40:45.14,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,1:40:45.14,1:40:47.11,Default,,0000,0000,0000,,Миссия аяқталды!
Dialogue: 0,1:40:49.14,1:40:52.11,Default,,0000,0000,0000,,Рахмет, балалар!
Dialogue: 0,1:40:55.15,1:41:01.12,Default,,0000,0000,0000,,Сіз кімсіз? Сол бала...
Dialogue: 0,1:40:55.15,1:41:01.12,Default,,0000,0000,0000,,Конан! !
Dialogue: 0,1:41:05.16,1:41:11.10,Default,,0000,0000,0000,,Алға! !
Dialogue: 0,1:41:11.10,1:41:13.07,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:41:11.10,1:41:13.07,Default,,0000,0000,0000,,(дыбысты ауыстыру)
Dialogue: 0,1:41:16.10,1:41:18.07,Default,,0000,0000,0000,,Ах…
Dialogue: 0,1:41:23.11,1:41:26.08,Default,,0000,0000,0000,,Ах! Ааа!
Dialogue: 0,1:41:36.12,1:41:38.13,Default,,0000,0000,0000,,Fa...
Dialogue: 0,1:41:38.13,1:41:40.13,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:41:40.13,1:41:42.10,Default,,0000,0000,0000,,Ах…
Dialogue: 0,1:41:40.13,1:41:42.10,Default,,0000,0000,0000,,Я...
Dialogue: 0,1:41:44.13,1:41:47.13,Default,,0000,0000,0000,,А... Иә
Dialogue: 0,1:41:47.13,1:41:51.14,Default,,0000,0000,0000,,А... Тоқтады...
Dialogue: 0,1:41:51.14,1:41:56.14,Default,,0000,0000,0000,,
Dialogue: 0,1:41:51.14,1:41:56.14,Default,,0000,0000,0000,,(Тікұшақтың дыбысы)
Dialogue: 0,1:41:56.14,1:42:08.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:42:08.16,1:42:11.09,Default,,0000,0000,0000,,Сен мұнда болғансың ғой.
Dialogue: 0,1:42:08.16,1:42:11.09,Default,,0000,0000,0000,,Дәл солай ма?
Dialogue: 0,1:42:11.09,1:42:16.10,Default,,0000,0000,0000,,Бір сағаттан кейін.
Dialogue: 0,1:42:11.09,1:42:16.10,Default,,0000,0000,0000,,Шамасы, оны толығымен бейтараптандыруға болады.
Dialogue: 0,1:42:16.10,1:42:19.10,Default,,0000,0000,0000,,Қоғамдық қауіпсіздік күткендей, жұмыс жылдам.
Dialogue: 0,1:42:19.10,1:42:22.10,Default,,0000,0000,0000,,Күтілгендей, бұл сізсіз.
Dialogue: 0,1:42:19.10,1:42:22.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:42:22.10,1:42:24.10,Default,,0000,0000,0000,,(Амуро)
Dialogue: 0,1:42:22.10,1:42:24.10,Default,,0000,0000,0000,,Мен бұл қимыл туралы жиі ойлайтынмын.
Dialogue: 0,1:42:24.10,1:42:27.11,Default,,0000,0000,0000,,Біреу маған түсініктеме берді.
Dialogue: 0,1:42:24.10,1:42:27.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:42:27.11,1:42:29.11,Default,,0000,0000,0000,,Бұл баяғыда болды, бірақ...
Dialogue: 0,1:42:29.11,1:42:32.11,Default,,0000,0000,0000,,(Су дыбысы)
Dialogue: 0,1:42:29.11,1:42:32.11,Default,,0000,0000,0000,,｟Ууууууууууууууууууууууууууууууууу
Dialogue: 0,1:42:32.11,1:42:36.12,Default,,0000,0000,0000,,｟Уу... Шиничи...
Dialogue: 0,1:42:32.11,1:42:36.12,Default,,0000,0000,0000,,Доп бейтаныс жерлерге тиді...｠
Dialogue: 0,1:42:36.12,1:42:39.12,Default,,0000,0000,0000,,(Шиничи)
Dialogue: 0,1:42:36.12,1:42:39.12,Default,,0000,0000,0000,,｟Жылама, жүгір, бәрібір｠
Dialogue: 0,1:42:39.12,1:42:41.12,Default,,0000,0000,0000,,｟Уау! ｠
Dialogue: 0,1:42:39.12,1:42:41.12,Default,,0000,0000,0000,,｟Ааа…｠
Dialogue: 0,1:42:41.12,1:42:43.12,Default,,0000,0000,0000,,｟ Қарғыс атсын! ｠
Dialogue: 0,1:42:41.12,1:42:43.12,Default,,0000,0000,0000,,｟Міне, садақтар! ｠
Dialogue: 0,1:42:43.12,1:42:45.13,Default,,0000,0000,0000,,｟Иә? ｠
Dialogue: 0,1:42:45.13,1:42:47.13,Default,,0000,0000,0000,,｟Теме әйел
Dialogue: 0,1:42:45.13,1:42:47.13,Default,,0000,0000,0000,,Мені жылатпа｠
Dialogue: 0,1:42:47.13,1:42:51.13,Default,,0000,0000,0000,,｟Хааа! ? Эх...｠
Dialogue: 0,1:42:51.13,1:42:53.13,Default,,0000,0000,0000,,｟Аа...｠
Dialogue: 0,1:42:53.13,1:42:56.14,Default,,0000,0000,0000,,｟Тоқтатылды! ｠
Dialogue: 0,1:42:56.14,1:42:58.14,Default,,0000,0000,0000,,｟фу｠
Dialogue: 0,1:42:58.14,1:43:00.14,Default,,0000,0000,0000,,｟Хаги сен не істеп жатырсың? ｠
Dialogue: 0,1:43:00.14,1:43:03.14,Default,,0000,0000,0000,,｟Цзиньпэй-чан! Телефон су бюросы! ｠
Dialogue: 0,1:43:03.14,1:43:05.15,Default,,0000,0000,0000,,｟О? неге? ｠
Dialogue: 0,1:43:05.15,1:43:08.15,Default,,0000,0000,0000,,Кенет есіме түсті.
Dialogue: 0,1:43:08.15,1:43:12.09,Default,,0000,0000,0000,,Егер сіз сол қолды қолдансаңыз, ол жарылып кетеді.
Dialogue: 0,1:43:08.15,1:43:12.09,Default,,0000,0000,0000,,Ол тоқтатылуы мүмкін.
Dialogue: 0,1:43:12.09,1:43:16.09,Default,,0000,0000,0000,,Ол қандай адам?
Dialogue: 0,1:43:12.09,1:43:16.09,Default,,0000,0000,0000,,Хагивара адамға ұқсайды, солай ма?
Dialogue: 0,1:43:16.09,1:43:21.09,Default,,0000,0000,0000,,Не? Не болды?
Dialogue: 0,1:43:21.09,1:43:24.06,Default,,0000,0000,0000,,Әлеуметтік жиналыс, ә? Қандай әлем екен ол?
Dialogue: 0,1:43:26.10,1:43:29.10,Default,,0000,0000,0000,,(Аюми)
Dialogue: 0,1:43:26.10,1:43:29.10,Default,,0000,0000,0000,,Иә? Мен бір сәт бұрын сонда болдым ...
Dialogue: 0,1:43:29.10,1:43:31.10,Default,,0000,0000,0000,,Сен қайда бардың?
Dialogue: 0,1:43:31.10,1:43:34.11,Default,,0000,0000,0000,,Өйткені ол адамдар сонда болды
Dialogue: 0,1:43:31.10,1:43:34.11,Default,,0000,0000,0000,,Біз құтқарылдық!
Dialogue: 0,1:43:34.11,1:43:38.11,Default,,0000,0000,0000,,Егер жоқ болса
Dialogue: 0,1:43:34.11,1:43:38.11,Default,,0000,0000,0000,,Шибуя осы уақытқа дейін от теңізі болар еді.
Dialogue: 0,1:43:38.11,1:43:40.11,Default,,0000,0000,0000,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:43:40.11,1:43:42.12,Default,,0000,0000,0000,,Такаги-кун! Өз-өзіңді күт!
Dialogue: 0,1:43:42.12,1:43:44.12,Default,,0000,0000,0000,,Ах... Сато мырза...
Dialogue: 0,1:43:44.12,1:43:46.12,Default,,0000,0000,0000,,⚟ (төтенше жағдай қызметкерлері)
Dialogue: 0,1:43:44.12,1:43:46.12,Default,,0000,0000,0000,,Эй, маған көмектес!
Dialogue: 0,1:43:46.12,1:43:48.12,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:43:46.12,1:43:48.12,Default,,0000,0000,0000,,Сато мырза➡️
Dialogue: 0,1:43:48.12,1:43:50.12,Default,,0000,0000,0000,,Осыдан кейін мүмкін➡️
Dialogue: 0,1:43:50.12,1:43:53.13,Default,,0000,0000,0000,,Операцияға келгенде
Dialogue: 0,1:43:50.12,1:43:53.13,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,1:43:53.13,1:43:56.13,Default,,0000,0000,0000,,Сонымен... дұрыс.
Dialogue: 0,1:43:53.13,1:43:56.13,Default,,0000,0000,0000,,Жақсы өтеді деп үміттенемін➡️
Dialogue: 0,1:43:56.13,1:43:59.13,Default,,0000,0000,0000,,Зали...
Dialogue: 0,1:43:56.13,1:43:59.13,Default,,0000,0000,0000,,Заклинание?
Dialogue: 0,1:43:59.13,1:44:03.14,Default,,0000,0000,0000,,⚟(Жедел жәрдем сиренасы)
Dialogue: 0,1:44:03.14,1:44:08.14,Default,,0000,0000,0000,,Егер сізде осындай энергия болса...
Dialogue: 0,1:44:03.14,1:44:08.14,Default,,0000,0000,0000,,Айтайын дегенім, мен бұл туралы ештеңе білмеймін.
Dialogue: 0,1:44:08.14,1:44:10.14,Default,,0000,0000,0000,,Сато мырза...
Dialogue: 0,1:44:10.14,1:44:15.08,Default,,0000,0000,0000,,Куфуфуфуфу
Dialogue: 0,1:44:10.14,1:44:15.08,Default,,0000,0000,0000,,О!
Dialogue: 0,1:44:15.08,1:44:35.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
