Dialogue: 0,1:48:55.10,1:49:12.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:49:12.05,1:49:16.02,Default,,0000,0000,0000,,Бұл менің соңғы өтінішім
Dialogue: 0,1:49:12.05,1:49:16.02,Default,,0000,0000,0000,,(Сутра оқу)
Dialogue: 0,1:49:18.05,1:49:21.02,Default,,0000,0000,0000,,Ух... Ой...
Dialogue: 0,1:49:24.06,1:49:26.06,Default,,0000,0000,0000,,Такаги~!
Dialogue: 0,1:49:26.06,1:49:29.06,Default,,0000,0000,0000,,Не, сен жаңа ғана өлдің бе?
Dialogue: 0,1:49:26.06,1:49:29.06,Default,,0000,0000,0000,,Ақымақ!
Dialogue: 0,1:49:29.06,1:49:31.06,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:49:31.06,1:49:34.07,Default,,0000,0000,0000,,Оны қорғаңыз!
Dialogue: 0,1:49:34.07,1:49:39.07,Default,,0000,0000,0000,,(Қақтығыс дауыстары)
Dialogue: 0,1:49:39.07,1:49:42.08,Default,,0000,0000,0000,,Қаскөй! иә!
Dialogue: 0,1:49:42.08,1:49:46.08,Default,,0000,0000,0000,,Жүр! Жарайды, бар!
Dialogue: 0,1:49:42.08,1:49:46.08,Default,,0000,0000,0000,,О!
Dialogue: 0,1:49:46.08,1:49:49.08,Default,,0000,0000,0000,,(Такаги)
Dialogue: 0,1:49:46.08,1:49:49.08,Default,,0000,0000,0000,,Гохо гохо гохо гохо…
Dialogue: 0,1:49:49.08,1:49:53.09,Default,,0000,0000,0000,,Біраз
Dialogue: 0,1:49:49.08,1:49:53.09,Default,,0000,0000,0000,,Мен ауруханада ұйықтап жатыр едім, енді ше?
Dialogue: 0,1:49:53.09,1:49:56.09,Default,,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,1:49:53.09,1:49:56.09,Default,,0000,0000,0000,,Бұл жолы облыс басшысы ➡️
Dialogue: 0,1:49:56.09,1:50:00.09,Default,,0000,0000,0000,,Әжеңіздің жерлеуіне шабуыл жасау
Dialogue: 0,1:49:56.09,1:50:00.09,Default,,0000,0000,0000,,Хабарлама болды!
Dialogue: 0,1:50:00.09,1:50:03.10,Default,,0000,0000,0000,,Жаттығу деп босаңсуға болмайды!
Dialogue: 0,1:50:00.09,1:50:03.10,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:50:03.10,1:50:08.10,Default,,0000,0000,0000,,Мм... мен
Dialogue: 0,1:50:03.10,1:50:08.10,Default,,0000,0000,0000,,Бұлай киінудің пайдасы бар ма?
Dialogue: 0,1:50:08.10,1:50:12.07,Default,,0000,0000,0000,,Сәлем! Эй! !
