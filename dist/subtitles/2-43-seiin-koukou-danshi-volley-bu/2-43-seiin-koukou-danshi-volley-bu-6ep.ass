Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:08.80,0:02:15.80,Default,,0,0,0,,(қолдау)
Dialogue: 0,0:02:15.80,0:02:18.81,Default,,0,0,0,,Бақылау! (Еркек) Өтінемін, Тонг!
Dialogue: 0,0:02:18.81,0:02:20.81,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:20.81,0:02:22.81,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:02:25.81,0:02:27.81,Default,,0,0,0,,Оны әкел!
Dialogue: 0,0:02:32.82,0:02:35.82,Default,,0,0,0,,Томоки
Dialogue: 0,0:02:35.82,0:02:38.83,Default,,0,0,0,,Маған бəрін əкелсең, жарайсың!
Dialogue: 0,0:02:38.83,0:02:40.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:40.83,0:02:42.83,Default,,0,0,0,,《Мен әлі де кете аламын...》
Dialogue: 0,0:02:42.83,0:02:44.83,Default,,0,0,0,,《Мен мұны әлі де істей аламын! 》
Dialogue: 0,0:02:46.84,0:02:50.84,Default,,0,0,0,,Мұғалім, мен жеңгім келеді.
Dialogue: 0,0:02:50.84,0:02:52.84,Default,,0,0,0,,Әрине
Dialogue: 0,0:02:54.84,0:02:56.84,Default,,0,0,0,,Томоки!
Dialogue: 0,0:03:04.45,0:03:06.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:12.79,0:03:14.80,Default,,0,0,0,,Жүр! Бақылау!
Dialogue: 0,0:03:14.80,0:03:16.80,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:18.80,0:03:21.80,Default,,0,0,0,,Фукуби техникалық орта мектебі
Dialogue: 0,0:03:21.80,0:03:25.81,Default,,0,0,0,,Жазғы жалпы және қысқы көктемгі орта мектеп 7 жыл қатарынан өкілдік етті
Dialogue: 0,0:03:25.81,0:03:28.81,Default,,0,0,0,,7 жыл...бастауыш сыныпта оқып жүргенімізге
Dialogue: 0,0:03:28.81,0:03:31.81,Default,,0,0,0,,Сіз әлі де ұтып жатырсыз ба? (Ода) Хойя
Dialogue: 0,0:03:31.81,0:03:33.82,Default,,0,0,0,,Бақытты араны жеңгенше, сіз әрқашан жеңесіз.
Dialogue: 0,0:03:33.82,0:03:37.82,Default,,0,0,0,,Біз Көктем орта мектебінің Фукуй өкілі бола алмаймыз.
Dialogue: 0,0:03:37.82,0:03:39.82,Default,,0,0,0,,Мен Мимураны жеңгенше.
Dialogue: 0,0:03:39.82,0:03:42.82,Default,,0,0,0,,Мимура деген кім?
Dialogue: 0,0:03:42.82,0:03:46.83,Default,,0,0,0,,Осаму Мимура. Бақытты аралардың абсолютті ацы
Dialogue: 0,0:03:46.83,0:03:48.83,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:03:48.83,0:03:51.83,Default,,0,0,0,,Лақап аты шайтанның базукасы
Dialogue: 0,0:03:51.83,0:03:55.84,Default,,0,0,0,,Префектурадағы бірінші спикер
Dialogue: 0,0:03:55.84,0:03:59.84,Default,,0,0,0,,Мұны ұмытпаңыз
Dialogue: 0,0:03:59.84,0:04:01.84,Default,,0,0,0,,Очи жеңіледі...
Dialogue: 0,0:04:01.84,0:04:03.78,Default,,0,0,0,,Келесі - Харутака.
Dialogue: 0,0:04:03.78,0:04:07.78,Default,,0,0,0,,Сіз мені орталық сотқа апарасыз, солай ма?
Dialogue: 0,0:04:07.78,0:04:09.78,Default,,0,0,0,,Оңай айтпа.
Dialogue: 0,0:04:09.78,0:04:12.79,Default,,0,0,0,,Жарайды, мен сені өзіммен бірге алып кетемін.
Dialogue: 0,0:04:12.79,0:04:14.79,Default,,0,0,0,,Сапқа тұрыңыз!
Dialogue: 0,0:04:14.79,0:04:17.79,Default,,0,0,0,,Келесі жылы да сонда боласыз, солай ма?
Dialogue: 0,0:04:17.79,0:04:20.80,Default,,0,0,0,,Мен сізді беймаза көрінді деп ойладым.
Dialogue: 0,0:04:20.80,0:04:24.80,Default,,0,0,0,,Соңында шешім қабылдап, үйге қайтайық!
Dialogue: 0,0:04:24.80,0:04:34.80,Default,,0,0,0,,Сен
Dialogue: 0,0:08:16.80,0:08:18.80,Default,,0,0,0,,Озу орта мектебінің мұғалімімен жаттығу матчының видеосы
Dialogue: 0,0:08:18.80,0:08:21.80,Default,,0,0,0,,Мен оны өңдедім. (Хата) Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:08:21.80,0:08:23.81,Default,,0,0,0,,Оны көргенде не ойладың?
Dialogue: 0,0:08:23.81,0:08:25.81,Default,,0,0,0,,Сол жақ өріске мықтап жабысты.
Dialogue: 0,0:08:25.81,0:08:28.81,Default,,0,0,0,,Сызық өте ұсталды.
Dialogue: 0,0:08:28.81,0:08:31.81,Default,,0,0,0,,Оның ұтылған ұпайларға қатысы жоқ, бірақ солай сезіледі.
Dialogue: 0,0:08:31.81,0:08:33.82,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:33.82,0:08:36.82,Default,,0,0,0,,Аудио-визуалды бөлмеге сенбі күні тапсырыс бере аласыз ба?
Dialogue: 0,0:08:36.82,0:08:38.82,Default,,0,0,0,,Иә
Dialogue: 0,0:08:40.82,0:08:44.83,Default,,0,0,0,,Ах, Очи, менеджердің ауысуына қатысты...
Dialogue: 0,0:08:44.83,0:08:46.83,Default,,0,0,0,,Мен әлі зейнеткерлікке шыққан жоқпын.
Dialogue: 0,0:08:46.83,0:08:49.83,Default,,0,0,0,,Сіз сенімдісіз бе? Сіз университетке барасыз ба?
Dialogue: 0,0:08:49.83,0:08:53.83,Default,,0,0,0,,Тонг көнбесе, мен де істеймін.
Dialogue: 0,0:08:55.84,0:08:58.84,Default,,0,0,0,,《Бірінші курстың жазында жарақат алдым》
Dialogue: 0,0:08:58.84,0:09:00.84,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:09:00.84,0:09:02.84,Default,,0,0,0,,《Жаттығу кезіндегі жарақат》
Dialogue: 0,0:09:05.78,0:09:10.79,Default,,0,0,0,,《Фукуидің харизматикалық Осаму Мимурасымен бір орта мектепке оқуға түсті
Dialogue: 0,0:09:10.79,0:09:14.79,Default,,0,0,0,,Менің арманым – бүкіл елді бірге мақсат ету...》
Dialogue: 0,0:09:21.80,0:09:24.80,Default,,0,0,0,,《Сіз менеджерсіз бе? 》
Dialogue: 0,0:09:24.80,0:09:27.80,Default,,0,0,0,,《Үшінші курс студенті Кида орта мектептен кейін қабылдау емтиханын тапсырады.
Dialogue: 0,0:09:27.80,0:09:31.81,Default,,0,0,0,,Мен зейнеткерлікке шығып, бар ойымды оқуға аударғым келеді.
Dialogue: 0,0:09:31.81,0:09:34.81,Default,,0,0,0,,《Мен тек жарақат алдым деп менеджерді сұрамаймын.》
Dialogue: 0,0:09:34.81,0:09:38.81,Default,,0,0,0,,《Очи, себебі мен сені жұмысқа лайықты адам деп ойладым》
Dialogue: 0,0:09:38.81,0:09:42.82,Default,,0,0,0,,Аа... кенет мені менеджер десеңіз де.
Dialogue: 0,0:09:42.82,0:09:45.82,Default,,0,0,0,,...
Dialogue: 0,0:09:45.82,0:09:47.82,Default,,0,0,0,,Қалай? жағдай
Dialogue: 0,0:09:47.82,0:09:51.83,Default,,0,0,0,,Мимура... неге?
Dialogue: 0,0:09:51.83,0:09:53.83,Default,,0,0,0,,Мимура мырза дегеніміз не?
Dialogue: 0,0:09:53.83,0:09:55.83,Default,,0,0,0,,Ереже
Dialogue: 0,0:09:55.83,0:09:58.83,Default,,0,0,0,,Тонг! Барлығы осылай атайды
Dialogue: 0,0:09:58.83,0:10:01.84,Default,,0,0,0,,А... иә. (Мимура) Мен де.
Dialogue: 0,0:10:01.84,0:10:03.77,Default,,0,0,0,,Олар мұны орта мектепте оқиды. (Очи) Иә?
Dialogue: 0,0:10:03.77,0:10:06.77,Default,,0,0,0,,Екеуіне де екі операция
Dialogue: 0,0:10:06.77,0:10:10.78,Default,,0,0,0,,Операция қашан? Сіз әрқашан турнирде болдыңыз, солай емес пе?
Dialogue: 0,0:10:10.78,0:10:15.78,Default,,0,0,0,,Хмм, екінші рет үшінші курсқа дейін көктемгі демалыста болды.
Dialogue: 0,0:10:15.78,0:10:18.79,Default,,0,0,0,,Біріншісі бір жыл бұрын болған.
Dialogue: 0,0:10:18.79,0:10:20.79,Default,,0,0,0,,Бұл әлі де солай ма?
Dialogue: 0,0:10:20.79,0:10:22.79,Default,,0,0,0,,Бүгінгі күн тек жоспарлы тексеру.
Dialogue: 0,0:10:22.79,0:10:25.79,Default,,0,0,0,,Ұқыпты пайдалансаң, еш қиындық болмайды дейді.
Dialogue: 0,0:10:25.79,0:10:28.80,Default,,0,0,0,,Бұл қазір қиынырақ.
Dialogue: 0,0:10:28.80,0:10:34.80,Default,,0,0,0,,Маған 4 ай реанимацияда болатынымды айтты.
Dialogue: 0,0:10:34.80,0:10:36.80,Default,,0,0,0,,Бұл ұзақ...
Dialogue: 0,0:10:36.80,0:10:40.81,Default,,0,0,0,,Бұл аздап қорқынышты, бірақ бәрі ойдағыдай болса, мен жаңа ойыншылар сайысына уақытында үлгеремін.
Dialogue: 0,0:10:40.81,0:10:44.81,Default,,0,0,0,,Жаңа ойыншылар шайқасы... Мұның бәрі түзетілді.
Dialogue: 0,0:10:44.81,0:10:47.82,Default,,0,0,0,,Мен қарапайыммын. (Мимура) Кез келген адамның мүмкіндігі болуы мүмкін...
Dialogue: 0,0:10:47.82,0:10:50.82,Default,,0,0,0,,Жоқ Мимура-кун түсінбейді.
Dialogue: 0,0:10:50.82,0:10:53.82,Default,,0,0,0,,Мен жарақат алған бойда мұғалім менің қолымнан келе ме деп сұрады.
Dialogue: 0,0:10:53.82,0:10:56.82,Default,,0,0,0,,Егер сіз Мимура-кун болсаңыз, сізге ешқашан ештеңе айтудың қажеті жоқ!
Dialogue: 0,0:10:56.82,0:10:58.83,Default,,0,0,0,,Ондайлар түсінбейді.
Dialogue: 0,0:10:58.83,0:11:00.83,Default,,0,0,0,,Күте тұрыңыз, Очи! Эй!
Dialogue: 0,0:11:04.77,0:11:06.77,Default,,0,0,0,,Сегіз соққы...
Dialogue: 0,0:11:06.77,0:11:08.77,Default,,0,0,0,,(лифттің келу дыбысы)
Dialogue: 0,0:11:19.78,0:11:21.78,Default,,0,0,0,,Қандай да бір себепті,
Dialogue: 0,0:11:23.78,0:11:25.79,Default,,0,0,0,,Эй... тізе!
Dialogue: 0,0:11:25.79,0:11:27.79,Default,,0,0,0,,Үйге не үшін бара жатырсың?
Dialogue: 0,0:11:27.79,0:11:30.79,Default,,0,0,0,,Бұл әлі әңгіменің ортасында.
Dialogue: 0,0:11:30.79,0:11:32.79,Default,,0,0,0,,Не болды? Кейін түсіндіремін!
Dialogue: 0,0:11:32.79,0:11:37.80,Default,,0,0,0,,Ми... Мен шынымен Мимура-кунды керемет деп ойлаймын.
Dialogue: 0,0:11:37.80,0:11:43.80,Default,,0,0,0,,Хойя, менің жоғарыда айтқаным жай ғана менің пікірім еді...
Dialogue: 0,0:11:43.80,0:11:47.81,Default,,0,0,0,,Ой... Мен Мимура-кун сияқты ойлауға дағдыланбадым.
Dialogue: 0,0:11:47.81,0:11:52.81,Default,,0,0,0,,Ештеңені ойламаңыз, сауықтыру үшін бар күшіңізді салыңыз және тек волейбол ойнауды жалғастырыңыз.
Dialogue: 0,0:11:52.81,0:11:56.82,Default,,0,0,0,,Мен білемін, бірақ мен бұл туралы көп ойладым.
Dialogue: 0,0:11:56.82,0:11:58.82,Default,,0,0,0,,Мен терең шұңқырға кептелдім...
Dialogue: 0,0:11:58.82,0:12:03.82,Default,,0,0,0,,Сіз өкінесіз бе? Фукубиге не болды
Dialogue: 0,0:12:03.82,0:12:06.83,Default,,0,0,0,,Мен жеңілдеп қалдым, бірақ қазір Бақытты арадан басқа ештеңе жоқ.
Dialogue: 0,0:12:06.83,0:12:10.83,Default,,0,0,0,,Менің префектурамда ұлттық деңгейдегі билікке ие команда жоқ.
Dialogue: 0,0:12:10.83,0:12:13.83,Default,,0,0,0,,Сондықтан мен Фукубиді таңдадым. Шынымен бе?
Dialogue: 0,0:12:15.84,0:12:18.84,Default,,0,0,0,,Менеджер: Тырысып көрсеңіз жақсы емес пе?
Dialogue: 0,0:12:18.84,0:12:20.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:20.51,0:12:23.84,Default,,0,0,0,,Жанып тұрса, Менеджер, көріңіз.
Dialogue: 0,0:12:23.84,0:12:25.85,Default,,0,0,0,,Мен сені міндетті түрде орындыққа отырғызамын.
Dialogue: 0,0:12:25.85,0:12:27.85,Default,,0,0,0,,《Иә? Бұл қандай теория?
Dialogue: 0,0:12:27.85,0:12:32.85,Default,,0,0,0,,Очи көктемі орта мектебінің орталық сотына барғыңыз келе ме?
Dialogue: 0,0:12:32.85,0:12:34.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:34.86,0:12:37.86,Default,,0,0,0,,Сіз қалай ойлайсыз? Барғың келе ме, жоқ па?
Dialogue: 0,0:12:37.86,0:12:42.86,Default,,0,0,0,,Мен... Барғым келеді, әрине. Бірақ...
Dialogue: 0,0:12:42.86,0:12:44.87,Default,,0,0,0,,Бұлай жалқау болма
Dialogue: 0,0:12:44.87,0:12:47.87,Default,,0,0,0,,Аш қал, үш жылыңды маған қалдыр.
Dialogue: 0,0:12:47.87,0:12:52.87,Default,,0,0,0,,Мен сені Көктем орта мектебінің орталық сотының менеджері етіп тағайындаймын.
Dialogue: 0,0:12:52.87,0:12:57.87,Default,,0,0,0,,Елестетіп көріңізші. Ол сөзсіз ерекшеленеді және керемет болады!
Dialogue: 0,0:13:00.88,0:13:02.82,Default,,0,0,0,,Озу орта мектебіндегі әйелге еліктеуші
Dialogue: 0,0:13:02.82,0:13:05.82,Default,,0,0,0,,Тору-сенпайдан қолтаңба алуға келмедің бе?
Dialogue: 0,0:13:05.82,0:13:09.82,Default,,0,0,0,,Әлгі кішкентай қыз капитанның құрбысы.
Dialogue: 0,0:13:09.82,0:13:12.83,Default,,0,0,0,,Әй, бұл шаш өте тар.
Dialogue: 0,0:13:12.83,0:13:14.83,Default,,0,0,0,,Бұл емдік түрі сияқты.
Dialogue: 0,0:13:14.83,0:13:18.83,Default,,0,0,0,,Мен сені кешіре алмаймын! Ей... Бірлескен мектеп әлсіз.
Dialogue: 0,0:13:18.83,0:13:21.84,Default,,0,0,0,,Инженерлер ~ Біз сонымен бірге бірлескен білім аламыз ~
Dialogue: 0,0:13:21.84,0:13:24.84,Default,,0,0,0,,Ой... Сенпай, мен де әйел менеджер алғым келеді.
Dialogue: 0,0:13:24.84,0:13:26.84,Default,,0,0,0,,Сәл әлсіреп қалсам, жарайды.
Dialogue: 0,0:13:26.84,0:13:29.84,Default,,0,0,0,,Әйелдерге еліктеушілер сондай жақсы болса
Dialogue: 0,0:13:29.84,0:13:32.85,Default,,0,0,0,,Бар, Озутака. (Тоқура) Әй... Очи-сенпай...
Dialogue: 0,0:13:32.85,0:13:34.85,Default,,0,0,0,,Сенпай, осында келші.
Dialogue: 0,0:13:34.85,0:13:38.85,Default,,0,0,0,,Менің келесі жаттығуым бар, сондықтан мен қазір барамын. (Яном) О, мен де.
Dialogue: 0,0:13:38.85,0:13:41.86,Default,,0,0,0,,Томоки таспасы және суық спрей
Dialogue: 0,0:13:41.86,0:13:44.86,Default,,0,0,0,,Ол сенбі күні келеді деп жоспарланған, сондықтан оны маған соған дейін алуға рұқсат етіңіз.
Dialogue: 0,0:13:44.86,0:13:46.86,Default,,0,0,0,,Иә, түсіндім!
Dialogue: 0,0:13:46.86,0:13:49.86,Default,,0,0,0,,Ақыр соңында... әлсіз болудан пайда жоқ.
Dialogue: 0,0:13:49.86,0:13:51.87,Default,,0,0,0,,Менің мақсатым қандай?
Dialogue: 0,0:13:51.87,0:13:54.87,Default,,0,0,0,,Кешіріңіз, мен Очи-сенпай болғаныма көнемін.
Dialogue: 0,0:13:54.87,0:13:56.87,Default,,0,0,0,,О? (Тоқура) Очи-сенпай керемет!
Dialogue: 0,0:13:56.87,0:13:58.87,Default,,0,0,0,,Бұл ең жақсы...
Dialogue: 0,0:13:58.87,0:14:00.88,Default,,0,0,0,,Ешкім Очиден емделгісі келмейді.
Dialogue: 0,0:14:00.88,0:14:02.81,Default,,0,0,0,,Оны асыға күтпеңіз.
Dialogue: 0,0:14:02.81,0:14:05.81,Default,,0,0,0,,Маған сары лебіздер жіберсеңіз, қиын болар еді.
Dialogue: 0,0:14:05.81,0:14:07.82,Default,,0,0,0,,Мен бәрібір әдемі емеспін
Dialogue: 0,0:14:07.82,0:14:09.82,Default,,0,0,0,,Очиде Очидің жұмысы бар, солай ма?
Dialogue: 0,0:14:09.82,0:14:12.82,Default,,0,0,0,,Хойя Томо айтқандай.
Dialogue: 0,0:14:12.82,0:14:16.82,Default,,0,0,0,,Очи менеджер болғаннан бері, жауды талдау күрделірек болды.
Dialogue: 0,0:14:16.82,0:14:18.83,Default,,0,0,0,,Бейне Оны бүктеу арқылы көру оңай.
Dialogue: 0,0:14:18.83,0:14:21.83,Default,,0,0,0,,Мен өте қызық нәрсе айтқаным үшін кешірім сұраймын.
Dialogue: 0,0:14:21.83,0:14:25.83,Default,,0,0,0,,Инженер Мен десерт алғым келеді.
Dialogue: 0,0:14:25.83,0:14:28.84,Default,,0,0,0,,Иә, мен оны сатып аламын!
Dialogue: 0,0:14:28.84,0:14:32.84,Default,,0,0,0,,Үлкен шоколад пудингі. Олай болмаса, жақсы.
Dialogue: 0,0:14:32.84,0:14:35.84,Default,,0,0,0,,Мен оны міндетті түрде аламын!
Dialogue: 0,0:14:35.84,0:14:39.51,Default,,0,0,0,,Екiншi курста да өз ұрпағымның жiбiн тартқандай сезiнемiн.
Dialogue: 0,0:14:39.51,0:14:42.85,Default,,0,0,0,,Қайырлы таң. (Канно) Сызық тым үлкен.
Dialogue: 0,0:14:42.85,0:14:45.85,Default,,0,0,0,,Біздің буыннан төмен волейболды кім ойнайды?
Dialogue: 0,0:14:45.85,0:14:47.86,Default,,0,0,0,,Барлығы Цунэнің жанкүйері.
Dialogue: 0,0:14:47.86,0:14:51.86,Default,,0,0,0,,Әңгіме дегеніміз не? Жақында түстен кейінгі сабақ басталады...
Dialogue: 0,0:14:51.86,0:14:56.86,Default,,0,0,0,,Т: Өткен күні Озу орта мектебімен қандай ойын болды?
Dialogue: 0,0:14:56.86,0:14:58.87,Default,,0,0,0,,Сіз не істеп жатырсыз? Сен не істеп жатырсың?
Dialogue: 0,0:14:58.87,0:15:01.87,Default,,0,0,0,,Барлығы тым шала. Сіз мотивациясыз ба?
Dialogue: 0,0:15:01.87,0:15:04.81,Default,,0,0,0,,Ұлттық саясатты менсінбеймін деп айтпа.
Dialogue: 0,0:15:04.81,0:15:06.81,Default,,0,0,0,,Мен қазір олай айтпаймын.
Dialogue: 0,0:15:06.81,0:15:08.81,Default,,0,0,0,,Оған жеңіл қарамаңыз
Dialogue: 0,0:15:08.81,0:15:11.81,Default,,0,0,0,,Тек алданып қалмаңыз. Сіз бақытты ара жеңген сияқты емес.
Dialogue: 0,0:15:11.81,0:15:14.82,Default,,0,0,0,,Олар префектураны арқаларында көтеріп жүр, солай ма?
Dialogue: 0,0:15:14.82,0:15:16.82,Default,,0,0,0,,Сіз де префектураның ойыншысысыз!
Dialogue: 0,0:15:16.82,0:15:18.82,Default,,0,0,0,,Префектураның ацы?
Dialogue: 0,0:15:18.82,0:15:21.82,Default,,0,0,0,,Inter-High алаңында сөйлеген адамның алғашқы сөзі
Dialogue: 0,0:15:21.82,0:15:24.83,Default,,0,0,0,,Сірә, «Фукуи қайда?»
Dialogue: 0,0:15:24.83,0:15:27.83,Default,,0,0,0,,Мұндай бос сөзбен өзіңізді құртпаңыз.
Dialogue: 0,0:15:27.83,0:15:30.83,Default,,0,0,0,,Орталық кортқа барсаң, ұнамаса да атақты боласың.
Dialogue: 0,0:15:30.83,0:15:34.84,Default,,0,0,0,,Фукуйдің осында екенін түсінгеніңізге көз жеткізіңіз!
Dialogue: 0,0:15:34.84,0:15:37.84,Default,,0,0,0,,Енді мен бастық болып, құлағымды қағып алатын күйдемін.
Dialogue: 0,0:15:37.84,0:15:41.84,Default,,0,0,0,,Ауруханада жылап жатқан адам
Dialogue: 0,0:15:41.84,0:15:45.85,Default,,0,0,0,,Ах...｡ Кешіріңіз, қазір ештеңе жоқ.
Dialogue: 0,0:15:45.85,0:15:48.85,Default,,0,0,0,,А... Жарайды.
Dialogue: 0,0:15:48.85,0:15:51.85,Default,,0,0,0,,Маған сенің айтқаның бәрібір.
Dialogue: 0,0:15:51.85,0:15:53.85,Default,,0,0,0,,Сабаққа барайық
Dialogue: 0,0:15:55.86,0:15:57.86,Default,,0,0,0,,Очи
Dialogue: 0,0:15:57.86,0:16:02.80,Default,,0,0,0,,Көктем орта мектебінің орталық сотына барғыңыз келе ме?
Dialogue: 0,0:16:02.80,0:16:04.80,Default,,0,0,0,,Мен мұны бұрын айтқанмын.
Dialogue: 0,0:16:04.80,0:16:06.80,Default,,0,0,0,,Маған дұрыс айтыңыз
Dialogue: 0,0:16:06.80,0:16:11.81,Default,,0,0,0,,«Мені Көктем орта мектебінің орталық сотының менеджері етіңіз».
Dialogue: 0,0:16:11.81,0:16:15.81,Default,,0,0,0,,Әй, сен мені осы арманға айналдырдың.
Dialogue: 0,0:16:15.81,0:16:18.81,Default,,0,0,0,,Жауапкершілікті алып, мені Көктем орта мектебінің орталық сотына апарыңыз.
Dialogue: 0,0:16:18.81,0:16:20.81,Default,,0,0,0,,Менеджер болыңыз
Dialogue: 0,0:16:20.81,0:16:23.81,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:18:48.80,0:18:51.80,Default,,0,0,0,,Мен Интер-Хайда үздік 16-ға кірдім.
Dialogue: 0,0:18:51.80,0:18:54.80,Default,,0,0,0,,Көктем орта мектебінде бұдан да жақсы нәтижелерге қол жеткізе аламын деп үміттенемін.
Dialogue: 0,0:18:54.80,0:18:58.81,Default,,0,0,0,,Мен топ болып жұмыс істегім келеді.
Dialogue: 0,0:18:58.81,0:19:03.74,Default,,0,0,0,,Мен Токун Мимура, Фукуби техникалық орта мектебінің ұлдар волейбол командасының капитаны болдым.
Dialogue: 0,0:19:03.74,0:19:05.75,Default,,0,0,0,,Сізге көп рахмет. (Оператор) мырза.
Dialogue: 0,0:19:05.75,0:19:09.75,Default,,0,0,0,,Менің ойымша, Фукуби биыл да фаворит, бірақ сізді қызықтыратын басқа командалар бар ма?
Dialogue: 0,0:19:09.75,0:19:12.75,Default,,0,0,0,,Бұл сізді қызықтыратын команда ма? (Оператор) Әй, білмеймін бе?
Dialogue: 0,0:19:12.75,0:19:16.76,Default,,0,0,0,,Биыл Seiin Omossie командасын құрады.
Dialogue: 0,0:19:16.76,0:19:19.76,Default,,0,0,0,,Чутара Сейкин Күзгі университетте жартылай финалдан шығып қалды ма?
Dialogue: 0,0:19:19.76,0:19:23.76,Default,,0,0,0,,Дұрыс. Бұл дұрыс. Менің септерім тек бірінші курс студенті.
Dialogue: 0,0:19:23.76,0:19:27.77,Default,,0,0,0,,Ол Токиодағы орта мектептің үздік 6 оқушысы болды.
Dialogue: 0,0:19:27.77,0:19:30.77,Default,,0,0,0,,иә~ Токио?
Dialogue: 0,0:19:30.77,0:19:32.77,Default,,0,0,0,,О, Томо-кунның да қызығатынына сенімдімін.
Dialogue: 0,0:19:32.77,0:19:37.78,Default,,0,0,0,,Бақытты аралар сақтық шараларын сақтауы керек, әйтпесе ренжіс болуы мүмкін.
Dialogue: 0,0:19:37.78,0:19:40.78,Default,,0,0,0,,Фукуби әрқашан ең күшті болғаны қызық.
Dialogue: 0,0:19:43.78,0:19:46.79,Default,,0,0,0,,Не? Жеңілгеніміз қызық болар еді.
Dialogue: 0,0:19:46.79,0:19:49.79,Default,,0,0,0,,Сұхбат алуға келмеңіз.
Dialogue: 0,0:19:49.79,0:19:53.79,Default,,0,0,0,,Әдемі екен... Әйтеуір қызу тақырыпқа айналып бара жатқан сияқты.
Dialogue: 0,0:19:53.79,0:19:57.80,Default,,0,0,0,,Сейін туралы айтсам, капитан қазір Ода, солай ма?
Dialogue: 0,0:19:57.80,0:19:59.80,Default,,0,0,0,,Оның соншалықты жақсы болғаны есімде жоқ.
Dialogue: 0,0:19:59.80,0:20:02.74,Default,,0,0,0,,Хойя, Интер-Жоғары дайындыққа дейін емес.
Dialogue: 0,0:20:02.74,0:20:05.74,Default,,0,0,0,,Бұл жай ғана Күзгі университетте пайда болды.
Dialogue: 0,0:20:05.74,0:20:08.74,Default,,0,0,0,,Бірінші жыл эйс пен сетер ойнайды.
Dialogue: 0,0:20:08.74,0:20:12.75,Default,,0,0,0,,Токиодағы ең үздік 6 студент - Хайдзима 1 курс
Dialogue: 0,0:20:12.75,0:20:14.75,Default,,0,0,0,,Токиодағы орта мектептегі канто турнирі
Dialogue: 0,0:20:14.75,0:20:16.75,Default,,0,0,0,,Үздік төрттікке енген командалар
Dialogue: 0,0:20:16.75,0:20:18.75,Default,,0,0,0,,Сетер ретінде ойнаған ойыншы
Dialogue: 0,0:20:18.75,0:20:21.76,Default,,0,0,0,,Ол екінші курста оқып жүргенде үздік алтылықты жеңіп алған сияқты.
Dialogue: 0,0:20:21.76,0:20:24.76,Default,,0,0,0,,Орта мектептің 2 курсындағы үздік 6...
Dialogue: 0,0:20:24.76,0:20:28.76,Default,,0,0,0,,Сен Фукуиде туған қазынасың.
Dialogue: 0,0:20:28.76,0:20:32.77,Default,,0,0,0,,Мен сені ұстағанымды мақтан тұтамын.
Dialogue: 0,0:20:32.77,0:20:37.77,Default,,0,0,0,,Хайдзима сенен екі жас кіші, бірақ ол қазір Фукуйде болса керек.
Dialogue: 0,0:20:37.77,0:20:39.77,Default,,0,0,0,,Тағы бір данышпан
Dialogue: 0,0:20:43.78,0:20:46.78,Default,,0,0,0,,Соңындағы митингте жылдам шабуыл ма? (Саруватари) Және В рұқсатымен бе?
Dialogue: 0,0:20:46.78,0:20:49.78,Default,,0,0,0,,Қандай жүйкені жұқартушы.
Dialogue: 0,0:20:54.79,0:20:58.79,Default,,0,0,0,,Қандай да бір себептермен бұл Цингин Акихиро жартылай финалдық шешімнен бас тартты.
Dialogue: 0,0:20:58.79,0:21:02.73,Default,,0,0,0,,Көктемгі орта мектептің алдын ала бақылау кеңесіне эдвайзер қатысты.
Dialogue: 0,0:21:02.73,0:21:04.73,Default,,0,0,0,,Ол шығып жатыр.
Dialogue: 0,0:21:04.73,0:21:07.73,Default,,0,0,0,,180 жастан асқан 5 адам бар.
Dialogue: 0,0:21:07.73,0:21:10.74,Default,,0,0,0,,Ол қайдан пайда болды?
Dialogue: 0,0:21:10.74,0:21:13.74,Default,,0,0,0,,Күзгі университет кезінде Сейін мүшелері болды
Dialogue: 0,0:21:13.74,0:21:16.74,Default,,0,0,0,,Сол жақ өріс №1 Ода және №7 Куробане.
Dialogue: 0,0:21:16.74,0:21:22.75,Default,,0,0,0,,Ода капитан және оның 163-і бар, бірақ Куроба бір жылда 184-ке ие болды.
Dialogue: 0,0:21:22.75,0:21:26.75,Default,,0,0,0,,Райт саны 4. 2 жылда 181
Dialogue: 0,0:21:26.75,0:21:31.76,Default,,0,0,0,,Ортаңғы блокаторлар 2 және 10, 193 және 187 болып табылады
Dialogue: 0,0:21:31.76,0:21:34.76,Default,,0,0,0,,Барлығында №2 Аоки туралы әсер бар.
Dialogue: 0,0:21:34.76,0:21:38.77,Default,,0,0,0,,10 саны – Окума, екінші курс студенті. Мен де оны бірінші рет көріп тұрмын.
Dialogue: 0,0:21:38.77,0:21:40.77,Default,,0,0,0,,Содан кейін 8-саны, кім қызмет көрсетеді,
Dialogue: 0,0:21:40.77,0:21:42.77,Default,,0,0,0,,Бұл мысал орнатушы.
Dialogue: 0,0:21:42.77,0:21:45.77,Default,,0,0,0,,О, сонымен қатар, бұл шыбық қызмет етеді.
Dialogue: 0,0:21:45.77,0:21:50.78,Default,,0,0,0,,181 биік қондырушы 1 курс Хайдзима
Dialogue: 0,0:21:50.78,0:21:54.78,Default,,0,0,0,,Менің сұрағым бар, бұл жігіт менің үйіме не үшін келеді?
Dialogue: 0,0:21:54.78,0:21:57.78,Default,,0,0,0,,Мұғалім, сіз жыл сайын бүкіл префектураны көруге барасыз, солай ма?
Dialogue: 0,0:21:57.78,0:21:59.79,Default,,0,0,0,,Хойя
Dialogue: 0,0:21:59.79,0:22:03.79,Default,,0,0,0,,Матчты бірінші рет көргенде мен де Хайдзимаға қызық болдым.
Dialogue: 0,0:22:03.79,0:22:07.79,Default,,0,0,0,,Хойя, бірақ командада Цунэ 3 жасқа толғанда.
Dialogue: 0,0:22:07.79,0:22:09.80,Default,,0,0,0,,Мен бұл ойыншыны қалай сыйғызарымды білмедім.
Dialogue: 0,0:22:09.80,0:22:11.80,Default,,0,0,0,,Адал орын
Dialogue: 0,0:22:11.80,0:22:14.80,Default,,0,0,0,,Мен оны Тачимен бір командада қолданып көргенімде не болды?
Dialogue: 0,0:22:14.80,0:22:17.80,Default,,0,0,0,,Мен оны көргім келді, бірақ...
Dialogue: 0,0:22:17.80,0:22:21.81,Default,,0,0,0,,Міне! Біз жетпейміз дейсің бе, Сенсей?
Dialogue: 0,0:22:21.81,0:22:23.81,Default,,0,0,0,,Жоқ, олай болған жоқ.
Dialogue: 0,0:22:23.81,0:22:26.81,Default,,0,0,0,,Адамдар осылай ойлайды.
Dialogue: 0,0:22:26.81,0:22:28.82,Default,,0,0,0,,Іс жүзінде бұқаралық ақпарат құралдарындағы адамдар
Dialogue: 0,0:22:28.82,0:22:33.82,Default,,0,0,0,,Соңғы жеті жыл бойы мен өз үйімнен басқа елге бара алмадым.
Dialogue: 0,0:22:33.82,0:22:35.82,Default,,0,0,0,,Мен басқа жерге баруға тырыстым.
Dialogue: 0,0:22:35.82,0:22:37.82,Default,,0,0,0,,Мен шыңға дейін жеңемін бе деп ойлаймын
Dialogue: 0,0:22:37.82,0:22:39.83,Default,,0,0,0,,Сен солай ойласаң да мен көмектесе алмаймын.
Dialogue: 0,0:22:39.83,0:22:41.83,Default,,0,0,0,,Ту-сенпай…
Dialogue: 0,0:22:45.83,0:22:48.84,Default,,0,0,0,,Кешіріңіз! Бұл енді менің кінәм.
Dialogue: 0,0:22:48.84,0:22:50.84,Default,,0,0,0,,Циньин белгісін белгілеңіз.
Dialogue: 0,0:22:50.84,0:22:53.84,Default,,0,0,0,,Қажет болғаннан артық сақ болудың қажеті жоқ.
Dialogue: 0,0:22:53.84,0:22:56.84,Default,,0,0,0,,Жаттығу сағат 9-да басталады! (барлығы) иә
Dialogue: 0,0:23:16.80,0:23:18.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:18.80,0:23:20.80,Default,,0,0,0,,Әй... Очи-сенпай
Dialogue: 0,0:23:20.80,0:23:25.81,Default,,0,0,0,,Асқазанға жаттығу. Біраз демалып алғаныңызды ескерсек, жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:23:25.81,0:23:29.81,Default,,0,0,0,,Сейннің тәжірибесін көрейік...
Dialogue: 0,0:23:29.81,0:23:32.81,Default,,0,0,0,,Бұл туралы алаңдамай, жеңетінін немесе жеңетінін білмейтін команда.
Dialogue: 0,0:23:32.81,0:23:34.82,Default,,0,0,0,,Менің қазір басқа істерім бар.
Dialogue: 0,0:23:34.82,0:23:37.82,Default,,0,0,0,,Бұл... дұрыс.
Dialogue: 0,0:23:37.82,0:23:41.82,Default,,0,0,0,,Ха... мен де барамын. (Токура) Иә?
Dialogue: 0,0:23:41.82,0:23:46.83,Default,,0,0,0,,Алдын ала қарау кезінде адамдар менің қасымдағы сотты ғана байқаса, бұл қиын болар еді.
Dialogue: 0,0:23:46.83,0:23:50.83,Default,,0,0,0,,Кешіріңіз. Бұл жерде еркек барр жаттығады.
Dialogue: 0,0:23:50.83,0:23:52.83,Default,,0,0,0,,Сіз қайда екенін білесіз бе?
Dialogue: 0,0:23:52.83,0:23:54.84,Default,,0,0,0,,Бізді ер адам ұстады ма?
Dialogue: 0,0:23:54.84,0:23:56.84,Default,,0,0,0,,Ондай нәрсе болмағандықтан емес пе?
Dialogue: 0,0:23:56.84,0:24:00.84,Default,,0,0,0,,Менің ойымша, бұл гимназия немесе сыртқы корт.
Dialogue: 0,0:24:00.84,0:24:04.78,Default,,0,0,0,,Кіші орта мектептегі дене шынықтыру сабағын сырт алаңда өткізу әдеттегідей ме?
Dialogue: 0,0:24:04.78,0:24:08.78,Default,,0,0,0,,Ал, кеттік. Мен гимназияны тексеремін.
Dialogue: 0,0:24:08.78,0:24:11.79,Default,,0,0,0,,Егер сізде сырттағы сот болса, оны тексеріп көріңіз.
Dialogue: 0,0:24:11.79,0:24:13.79,Default,,0,0,0,,Иә
Dialogue: 0,0:24:17.79,0:24:20.79,Default,,0,0,0,,Мм... ерлердің білгені ше?
Dialogue: 0,0:24:20.79,0:24:22.80,Default,,0,0,0,,Бүгін - сыртқы күн. А, бірақ
Dialogue: 0,0:24:22.80,0:24:25.80,Default,,0,0,0,,Менің ойымша, олар біраз уақыттан кейін оралады.
Dialogue: 0,0:24:25.80,0:24:28.80,Default,,0,0,0,,Маған оны сағат 6-дан бастап пайдалануға рұқсат беру керек.
Dialogue: 0,0:24:28.80,0:24:31.81,Default,,0,0,0,,Спортзалды күнде пайдалана аламын ба?
Dialogue: 0,0:24:31.81,0:24:34.81,Default,,0,0,0,,Иә. Жақында ерлер мен әйелдер арасында волейболдан турнир өтеді.
Dialogue: 0,0:24:34.81,0:24:36.81,Default,,0,0,0,,Енді ғана, басқа бөлімшелер шығып кеткеннен кейін
Dialogue: 0,0:24:36.81,0:24:39.81,Default,,0,0,0,,Мен оны 7:30-ға дейін пайдалануға рұқсат етемін.
Dialogue: 0,0:24:39.81,0:24:43.82,Default,,0,0,0,,Мм... сіз әйел барраның менеджерісіз бе?
Dialogue: 0,0:24:43.82,0:24:45.82,Default,,0,0,0,,Жоқ, мен ерлер клубының мүшесімін.
Dialogue: 0,0:24:45.82,0:24:48.82,Default,,0,0,0,,Сырттағы сотқа барсаңыз...
Dialogue: 0,0:24:48.82,0:24:50.82,Default,,0,0,0,,《Бұл жігіт 2-ші жыл табыт алаңы》
Dialogue: 0,0:24:50.82,0:24:52.83,Default,,0,0,0,,Бұл менен бір саты төмен.
Dialogue: 0,0:24:52.83,0:24:54.83,Default,,0,0,0,,｡ ()!?
Dialogue: 0,0:24:54.83,0:24:56.83,Default,,0,0,0,,()
Dialogue: 0,0:24:56.83,0:24:58.83,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:24:58.83,0:25:01.84,Default,,0,0,0,,Инженер! Сен не істеп жатырсың!
Dialogue: 0,0:25:01.84,0:25:04.77,Default,,0,0,0,,Сенпай! (Очи) Инженерлер! сен...!
Dialogue: 0,0:25:04.77,0:25:06.77,Default,,0,0,0,,Очи-сенпай...
Dialogue: 0,0:25:06.77,0:25:09.78,Default,,0,0,0,,Мен бұл жігіттің маған жасырын түрде барлау үшін келгеніне сене алар емеспін.
Dialogue: 0,0:25:09.78,0:25:12.78,Default,,0,0,0,,Бақытты араны елеусіз қалдырмаңыз!
Dialogue: 0,0:25:12.78,0:25:16.78,Default,,0,0,0,,Бұл үлкен мәселе емес деп айта алмаймын.
Dialogue: 0,0:25:16.78,0:25:19.79,Default,,0,0,0,,Бақытты ара да жерге құлады!
Dialogue: 0,0:25:19.79,0:25:21.79,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:25:21.79,0:25:24.79,Default,,0,0,0,,Ах!? Сіз қандайсыз?
Dialogue: 0,0:25:24.79,0:25:27.79,Default,,0,0,0,,3 курс Очи. Фукубидің менеджері және
Dialogue: 0,0:25:27.79,0:25:29.80,Default,,0,0,0,,Менеджер?
Dialogue: 0,0:25:29.80,0:25:33.80,Default,,0,0,0,,Адамның басқарушысы болу қызық емес пе?
Dialogue: 0,0:25:33.80,0:25:36.80,Default,,0,0,0,,Сен... тіпті мені мазақ етесің...! (Аоки) Оны сол жерге қояйық.
Dialogue: 0,0:25:36.80,0:25:39.81,Default,,0,0,0,,Аоки?
Dialogue: 0,0:25:39.81,0:25:45.81,Default,,0,0,0,,Мен мұны кім жасады деп ойладым, Очи?
Dialogue: 0,0:25:45.81,0:25:50.82,Default,,0,0,0,,Бұл бейбақ екеуіңнің арасындағы зорлық-зомбылық әрекеттері түсіріліп жатыр.
Dialogue: 0,0:25:50.82,0:25:54.82,Default,,0,0,0,,Егер мұндай нәрсе жалпыға мәлім болса, бұл үлкен мәселе болар еді.
Dialogue: 0,0:25:54.82,0:25:56.82,Default,,0,0,0,,Ах... өте жауыз!
Dialogue: 0,0:25:56.82,0:25:58.83,Default,,0,0,0,,Мені арандатқан сол клубтың мүшесі болды!
Dialogue: 0,0:25:58.83,0:26:00.83,Default,,0,0,0,,Сыпайы болу керек...
Dialogue: 0,0:26:00.83,0:26:02.76,Default,,0,0,0,,...
Dialogue: 0,0:26:02.76,0:26:04.77,Default,,0,0,0,,Су... Суба... Ру...
Dialogue: 0,0:26:04.77,0:26:08.77,Default,,0,0,0,,Неге...
Dialogue: 0,0:26:08.77,0:26:13.77,Default,,0,0,0,,Аа... Болды. Ол еңіс үстінде қайтыс болды.
Dialogue: 0,0:26:13.77,0:26:17.78,Default,,0,0,0,,Кешіріңіз! Бұл жай ғана әңгіме болуы мүмкін емес пе?
Dialogue: 0,0:26:17.78,0:26:20.78,Default,,0,0,0,,Жанжал тудыруға мүмкіндік жоқ.
Dialogue: 0,0:26:20.78,0:26:23.78,Default,,0,0,0,,Мен мүшемнің абайсыздығы үшін шын жүректен кешірім сұраймын.
Dialogue: 0,0:26:23.78,0:26:27.79,Default,,0,0,0,,Бұл жерде менің бетімді елемеуіңізге болады ма? Ода
Dialogue: 0,0:26:27.79,0:26:30.79,Default,,0,0,0,,Тоқта! Кешірім сұрасаңыз, біз...
Dialogue: 0,0:26:30.79,0:26:34.80,Default,,0,0,0,,Аузыңды жап! Балалар, бастарыңды имей тұра алмайсыңдар!
Dialogue: 0,0:26:34.80,0:26:36.80,Default,,0,0,0,,Өтінемін, Ода. Осындай бос сөзбен.
Dialogue: 0,0:26:36.80,0:26:39.80,Default,,0,0,0,,Мені шеттетсе, ұят болар еді.
Dialogue: 0,0:26:39.80,0:26:42.80,Default,,0,0,0,,Фукубидің тарихы осылай үзілсе ше?
Dialogue: 0,0:26:42.80,0:26:45.81,Default,,0,0,0,,Сіз үлкендеріңізбен бетпе-бет келе алмайсыз.
Dialogue: 0,0:26:45.81,0:26:47.81,Default,,0,0,0,,Уақыты келген жоқ па?
Dialogue: 0,0:26:47.81,0:26:49.81,Default,,0,0,0,,Жалғыз мен кінәлімін!
Dialogue: 0,0:26:49.81,0:26:52.81,Default,,0,0,0,,Егер мен клубтан жай ғана кететін болсам, болды!
Dialogue: 0,0:26:52.81,0:26:54.82,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:26:54.82,0:26:56.82,Default,,0,0,0,,Мен соншалықты қатал болғым келмейді.
Dialogue: 0,0:26:56.82,0:26:59.82,Default,,0,0,0,,Тұрыңыз.
Dialogue: 0,0:26:59.82,0:27:02.76,Default,,0,0,0,,Мимура: Мен де үлкен мәміле жасағым келмейді.
Dialogue: 0,0:27:02.76,0:27:05.76,Default,,0,0,0,,Мен ақымақ нәрсе айттым деп ойлаймын, сондықтан кешіріңіз.
Dialogue: 0,0:27:05.76,0:27:08.76,Default,,0,0,0,,Окума! (Окума) Жақсы...
Dialogue: 0,0:27:08.76,0:27:11.77,Default,,0,0,0,,Кешіріңіз, Фукуби-сан!
Dialogue: 0,0:27:11.77,0:27:14.77,Default,,0,0,0,,Aoki бейнесін өшіру
Dialogue: 0,0:27:14.77,0:27:18.77,Default,,0,0,0,,Уайымдамаңыз, сіз суретке түсіре аласыз.
Dialogue: 0,0:27:18.77,0:27:21.78,Default,,0,0,0,,алғыс айту
Dialogue: 0,0:27:21.78,0:27:23.78,Default,,0,0,0,,Менің практикамды көруге келдің.
Dialogue: 0,0:27:23.78,0:27:25.78,Default,,0,0,0,,Қарсы болмасаңыз, қараңызшы.
Dialogue: 0,0:27:25.78,0:27:28.78,Default,,0,0,0,,Жоқ, мен де бүгін сараң болдым.
Dialogue: 0,0:27:28.78,0:27:30.78,Default,,0,0,0,,Мен мына жігіттердің мойнынан ұстап үйге барамын.
Dialogue: 0,0:27:30.78,0:27:33.79,Default,,0,0,0,,Балама қандай?
Dialogue: 0,0:27:33.79,0:27:36.79,Default,,0,0,0,,Жаттығу матчын өткізейік пе?
Dialogue: 0,0:27:38.79,0:27:41.80,Default,,0,0,0,,Не? Мен сенің кеудеңді алғым келеді
Dialogue: 0,0:27:41.80,0:27:43.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:43.46,0:27:45.13,Default,,0,0,0,,《Бұл жігіт...》
Dialogue: 0,0:27:45.13,0:27:48.80,Default,,0,0,0,,《Бүгін Фукуидегі тағы бір данышпан》
Dialogue: 0,0:27:48.80,0:27:51.81,Default,,0,0,0,,《Бұл... Хайдзима》
Dialogue: 0,0:27:51.81,0:27:53.81,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:27:53.81,0:27:56.81,Default,,0,0,0,,Жомарт болудың қажеті жоқ
Dialogue: 0,0:27:56.81,0:28:01.82,Default,,0,0,0,,Біз үшін уайымдамай тұра алмайтын сияқтысыз.
Dialogue: 0,0:28:01.82,0:28:11.82,Default,,0,0,0,,Сен
Dialogue: 0,0:28:13.32,0:28:19.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
