Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:08.79,0:02:12.46,Default,,0,0,0,,Солға апарыңыз!
Dialogue: 0,0:02:12.46,0:02:14.47,Default,,0,0,0,,Өте өкінішті!
Dialogue: 0,0:02:14.47,0:02:16.77,Default,,0,0,0,,《Ешқандай өкінбеймін》
Dialogue: 0,0:02:21.14,0:02:23.74,Default,,0,0,0,,《сол жақта тағы 3 карта ашық》
Dialogue: 0,0:02:32.82,0:02:35.82,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:35.82,0:02:37.82,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:02:42.83,0:02:45.43,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:47.50,0:02:49.50,Default,,0,0,0,,Кесілген тағамды ұсыныңыз! Түсіңіз!
Dialogue: 0,0:02:52.84,0:02:54.84,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:56.84,0:02:59.85,Default,,0,0,0,,《Тек ата-аналар қауымдастығын жеңіп, олардың аузын жауып таста》
Dialogue: 0,0:02:59.85,0:03:02.78,Default,,0,0,0,,《Оның үйірме жұмыстарына келмейтін себебі - Сутаның мәселесі.》
Dialogue: 0,0:03:02.78,0:03:04.78,Default,,0,0,0,,《Мен қателескен жоқпын》
Dialogue: 0,0:03:04.78,0:03:06.79,Default,,0,0,0,,《Ештеңе! 》
Dialogue: 0,0:03:06.79,0:03:09.46,Default,,0,0,0,,[Сыртында: 6D5AA3FF99A144BD5138562787F58590] (діріл дыбысы)
Dialogue: 0,0:03:09.46,0:03:11.79,Default,,0,0,0,,Сәлеметсіз бе. Біз қазір ойын ойнаймыз...
Dialogue: 0,0:03:11.79,0:03:13.79,Default,,0,0,0,,Не? аурухана?
Dialogue: 0,0:03:13.79,0:03:15.79,Default,,0,0,0,,Бұл Сота Йошино ма?
Dialogue: 0,0:03:15.79,0:03:18.79,Default,,0,0,0,,Сута үйде...
Dialogue: 0,0:03:33.81,0:03:43.81,Default,,0,0,0,,Сен
Dialogue: 0,0:07:25.78,0:07:28.78,Default,,0,0,0,,Хаха...
Dialogue: 0,0:07:28.78,0:07:30.78,Default,,0,0,0,,Чика... Чика!
Dialogue: 0,0:07:30.78,0:07:33.79,Default,,0,0,0,,Uni…
Dialogue: 0,0:07:33.79,0:07:38.79,Default,,0,0,0,,Ал... Сіздің Токиоға баратыныңыз рас па? Қайта кездесе аламыз ба?
Dialogue: 0,0:07:38.79,0:07:41.79,Default,,0,0,0,,Иә... ұмытып кетіппін...
Dialogue: 0,0:07:41.79,0:07:44.80,Default,,0,0,0,,Uni туралы ұмытпаңыз!
Dialogue: 0,0:07:44.80,0:07:49.80,Default,,0,0,0,,Мен де Чиканы ешқашан ұмытпаймын!
Dialogue: 0,0:07:49.80,0:07:54.81,Default,,0,0,0,,《Шынында мен сенімен мәңгі бірге болғым келеді, бірақ...》
Dialogue: 0,0:07:54.81,0:07:57.81,Default,,0,0,0,,《Қош бол... Uni...》
Dialogue: 0,0:08:04.75,0:08:06.75,Default,,0,0,0,,Оқушыны ауыстыру. (Куроба) Уа!
Dialogue: 0,0:08:06.75,0:08:08.75,Default,,0,0,0,,Келу Кешіріңіз, кешігіп қалдыңыз.
Dialogue: 0,0:08:08.75,0:08:12.76,Default,,0,0,0,,Керемет пе? Бұл керемет деп үміттенемін~
Dialogue: 0,0:08:12.76,0:08:16.76,Default,,0,0,0,,Бұл қалыпты бет. Мүмкін қалыптыдан сәл аз.
Dialogue: 0,0:08:16.76,0:08:19.77,Default,,0,0,0,,Юхито мұны балабақшаға келгенше ғана білген, солай ма?
Dialogue: 0,0:08:19.77,0:08:22.43,Default,,0,0,0,,Бұл керемет шығар.
Dialogue: 0,0:08:22.43,0:08:24.44,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:08:24.44,0:08:26.77,Default,,0,0,0,,Көзілдірікті кішкентай жігіттің жолы болмайтынына сенімдімін.
Dialogue: 0,0:08:26.77,0:08:29.78,Default,,0,0,0,,Не? Сіз бір нәрсеге қайғырасыз ба?
Dialogue: 0,0:08:29.78,0:08:32.78,Default,,0,0,0,,Сен шынымен баласың. Уайымдама!
Dialogue: 0,0:08:32.78,0:08:35.78,Default,,0,0,0,,Үлкен апа сияқты әрекет етуді доғар. Өз сыныбыңызға қайтыңыз.
Dialogue: 0,0:08:35.78,0:08:39.79,Default,,0,0,0,,Иә, иә. Мен көмектесе алмаймын, Яно.
Dialogue: 0,0:08:39.79,0:08:43.79,Default,,0,0,0,,Мен іш шалбар киіп жүрмін, сондықтан қарап шығудың қажеті жоқ.
Dialogue: 0,0:08:43.79,0:08:46.79,Default,,0,0,0,,Жүннен жасалған шалбар?
Dialogue: 0,0:08:46.79,0:08:49.80,Default,,0,0,0,,Мен бұлай салқын болуға тырысудың мағынасын түсінбеймін.
Dialogue: 0,0:08:49.80,0:08:51.80,Default,,0,0,0,,Сән - бұл жүрек туралы
Dialogue: 0,0:08:51.80,0:08:54.80,Default,,0,0,0,,Балаларға әлі ерте ме?
Dialogue: 0,0:08:54.80,0:08:58.14,Default,,0,0,0,,Сізді немере ағаңыз Генко-чан тағы мазақ етіп жатыр ма? Юхито
Dialogue: 0,0:08:58.14,0:09:00.14,Default,,0,0,0,,Сіз ренжідіңіз, үндемеңіз...
Dialogue: 0,0:09:00.14,0:09:02.74,Default,,0,0,0,,Трансфер оқушы: Сіз бала кезден доссыз ба?
Dialogue: 0,0:09:02.74,0:09:04.74,Default,,0,0,0,,Балабақша
Dialogue: 0,0:09:04.74,0:09:06.75,Default,,0,0,0,,Сізге кездесу ұнады ма?
Dialogue: 0,0:09:06.75,0:09:10.75,Default,,0,0,0,,Сен ақымақсың ба? Бұл ер адам.
Dialogue: 0,0:09:10.75,0:09:15.75,Default,,0,0,0,,《Жеміс күттім》
Dialogue: 0,0:09:15.75,0:09:17.76,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:09:17.76,0:09:20.76,Default,,0,0,0,,Мен қысқы каникулда көшуді аяқтауым керек еді.
Dialogue: 0,0:09:20.76,0:09:22.76,Default,,0,0,0,,Маған бетіңді көрсетпе...
Dialogue: 0,0:09:25.76,0:09:31.76,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:37.78,0:09:39.78,Default,,0,0,0,,Чика!
Dialogue: 0,0:09:43.78,0:09:46.79,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:46.79,0:09:49.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:52.79,0:09:54.79,Default,,0,0,0,,《Иә?》
Dialogue: 0,0:09:54.79,0:09:59.80,Default,,0,0,0,,《Чика? Мені түсінбедің бе? 》
Dialogue: 0,0:09:59.80,0:10:03.74,Default,,0,0,0,,Токиодан келген Хайдзима Косэй-кун
Dialogue: 0,0:10:03.74,0:10:06.74,Default,,0,0,0,,Менің атамның үйі қалада.
Dialogue: 0,0:10:06.74,0:10:09.74,Default,,0,0,0,,Ол балабақшаға дейін Сузунаши қаласында тұрса керек.
Dialogue: 0,0:10:09.74,0:10:12.41,Default,,0,0,0,,《Ол елемей қойды》 (Мұғалім) Куроба-кун
Dialogue: 0,0:10:12.41,0:10:15.08,Default,,0,0,0,,Иә!? Хайдзима-кун, сенің бұрынғы мектебіңде.
Dialogue: 0,0:10:15.08,0:10:18.75,Default,,0,0,0,,Сенің волейбол ойнайтыныңды естіп, волейбол үйірмесіне қосылдым.
Dialogue: 0,0:10:18.75,0:10:21.75,Default,,0,0,0,,Үйірме жұмыстары туралы айтып беріңізші.
Dialogue: 0,0:10:21.75,0:10:26.75,Default,,0,0,0,,Хайдзима-кун. Куроба-кунның алдында отыр.
Dialogue: 0,0:10:30.76,0:10:32.76,Default,,0,0,0,,Сіздің ұстанымыңыз қандай? иә?
Dialogue: 0,0:10:32.76,0:10:34.77,Default,,0,0,0,,Позиция. Бұл волейбол клубы, солай ма?
Dialogue: 0,0:10:34.77,0:10:37.44,Default,,0,0,0,,Аа, позициясы осындай.
Dialogue: 0,0:10:37.44,0:10:40.77,Default,,0,0,0,,Менің ойымша, бұл анық емес.
Dialogue: 0,0:10:40.77,0:10:44.78,Default,,0,0,0,,Әлі шешілген жоқ. Матч кезінде не істейсіз?
Dialogue: 0,0:10:44.78,0:10:47.78,Default,,0,0,0,,Мен ешқашан дұрыс матчта болған емеспін.
Dialogue: 0,0:10:47.78,0:10:49.78,Default,,0,0,0,,Тәжірибе күндері де орынды.
Dialogue: 0,0:10:49.78,0:10:53.79,Default,,0,0,0,,Бұл тек атымен ғана тиесілі адамдардан тұратын клуб.
Dialogue: 0,0:10:53.79,0:10:55.79,Default,,0,0,0,,Үйге қара.
Dialogue: 0,0:10:55.79,0:10:57.79,Default,,0,0,0,,Егер сіз қандай да бір клубқа қосылмасаңыз, бұл міндетті.
Dialogue: 0,0:10:57.79,0:10:59.79,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:10:59.79,0:11:04.73,Default,,0,0,0,,Мүмкін сіздің мектебіңіз күшті болған шығар?
Dialogue: 0,0:11:04.73,0:11:07.73,Default,,0,0,0,,Цк... Бұл қажетсіз үлкен бе?
Dialogue: 0,0:11:07.73,0:11:12.74,Default,,0,0,0,,《Не... Нана... Мынау не жігіт! 》
Dialogue: 0,0:11:12.74,0:11:14.74,Default,,0,0,0,,Чика?
Dialogue: 0,0:11:14.74,0:11:17.74,Default,,0,0,0,,Әй, бұл жұртшылықтың анты ғой. Бұл есімде.
Dialogue: 0,0:11:17.74,0:11:20.75,Default,,0,0,0,,Хояро? Есіңізде болса, бұл Рай Чан.
Dialogue: 0,0:11:20.75,0:11:23.75,Default,,0,0,0,,Өйткені, ол шынымен де сонда болды.
Dialogue: 0,0:11:23.75,0:11:26.75,Default,,0,0,0,,Сіз оны елес деп ойладыңыз ба?
Dialogue: 0,0:11:26.75,0:11:28.75,Default,,0,0,0,,Ах, Яну, әдеттегідей.
Dialogue: 0,0:11:28.75,0:11:31.76,Default,,0,0,0,,Неліктен Токиоға көшті?
Dialogue: 0,0:11:31.76,0:11:33.76,Default,,0,0,0,,Рай-чан, сен білесің бе?
Dialogue: 0,0:11:33.76,0:11:35.76,Default,,0,0,0,,Менің анам қайтыс болды, солай ма?
Dialogue: 0,0:11:35.76,0:11:39.76,Default,,0,0,0,,Қартымның жерлеуге бара жатқаны есімде.
Dialogue: 0,0:11:39.76,0:11:44.77,Default,,0,0,0,,Менің әкем Токиодан болған.
Dialogue: 0,0:11:44.77,0:11:49.77,Default,,0,0,0,,Неліктен бұл жерге қайта келдің?
Dialogue: 0,0:11:49.77,0:11:52.78,Default,,0,0,0,,Сіз білесіз бе? Адамның өзінен сұра.
Dialogue: 0,0:11:52.78,0:11:56.78,Default,,0,0,0,,Егер мен мұны істей алсам, менде қиындық болмайды.
Dialogue: 0,0:11:56.78,0:11:59.78,Default,,0,0,0,,Ол үнемі тосқауыл қояды.
Dialogue: 0,0:11:59.78,0:12:03.79,Default,,0,0,0,,Эй, мен қажетсіз үлкенмін бе?
Dialogue: 0,0:12:03.79,0:12:05.79,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:12:05.79,0:12:07.79,Default,,0,0,0,,Бұл үлкен ысырап... [Сыртында: 6D5AA3FF99A144BD5138562787F58590] (діріл дыбысы)
Dialogue: 0,0:12:07.79,0:12:11.80,Default,,0,0,0,,Мен сияқты сөздерді айтпа. Сіз әлі жарты адамсыз.
Dialogue: 0,0:12:11.80,0:12:13.80,Default,,0,0,0,,А? Мен бастық болуға тырыспасам да...
Dialogue: 0,0:12:13.80,0:12:15.80,Default,,0,0,0,,Қараңыз. [Сыртта: 6D5AA3FF99A144BD5138562787F58590] (Генко) Юхито?
Dialogue: 0,0:12:15.80,0:12:19.80,Default,,0,0,0,,Тәтем тамақ ішетін уақыт болды деді. Үйге ерте қайт.
Dialogue: 0,0:12:19.80,0:12:24.81,Default,,0,0,0,,Менің сонда екенімді қайдан білдің?
Dialogue: 0,0:12:24.81,0:12:27.81,Default,,0,0,0,,Демек, сен ақымақсың.
Dialogue: 0,0:12:27.81,0:12:29.81,Default,,0,0,0,,Ол осы мамандық атауын беруге тікелей шабыт болған —
Dialogue: 0,0:12:31.82,0:12:33.82,Default,,0,0,0,,Куробане. Чика...
Dialogue: 0,0:12:33.82,0:12:36.82,Default,,0,0,0,,Хайдзима: Сен не істеп жаттың? Осы уақытқа дейін
Dialogue: 0,0:12:36.82,0:12:40.83,Default,,0,0,0,,Клуб қызметі. Клуб қызметі... волейбол ма?
Dialogue: 0,0:12:40.83,0:12:42.83,Default,,0,0,0,,Бүгін жаттығу күні, солай ма?
Dialogue: 0,0:12:42.83,0:12:46.50,Default,,0,0,0,,Барсам да ешкім келмейтін. Ах.
Dialogue: 0,0:12:46.50,0:12:49.83,Default,,0,0,0,,Сіз мұны жалғыз жасадыңыз ба? О
Dialogue: 0,0:12:49.83,0:12:51.84,Default,,0,0,0,,О, сен ақымақсың.
Dialogue: 0,0:12:51.84,0:12:54.84,Default,,0,0,0,,Кішкентай үлкен болып өсті.
Dialogue: 0,0:12:54.84,0:12:56.84,Default,,0,0,0,,Бұл шамамен Юхитомен бірдей.
Dialogue: 0,0:12:56.84,0:12:59.84,Default,,0,0,0,,Лай-чан. Сенің есіңде ме?
Dialogue: 0,0:12:59.84,0:13:02.78,Default,,0,0,0,,Нағашым атаммен шоги ойнауға келді.
Dialogue: 0,0:13:02.78,0:13:05.78,Default,,0,0,0,,есімде. Сонымен?
Dialogue: 0,0:13:09.79,0:13:13.79,Default,,0,0,0,,Куробане, сен қызықсыз істер істеп жатырсың.
Dialogue: 0,0:13:13.79,0:13:16.80,Default,,0,0,0,,Не... Қызық емес пе?
Dialogue: 0,0:13:16.80,0:13:19.80,Default,,0,0,0,,Сіз күлкілі болуға тырысасыз ба? иә?
Dialogue: 0,0:13:19.80,0:13:21.80,Default,,0,0,0,,Мен істеймін
Dialogue: 0,0:13:23.80,0:13:27.81,Default,,0,0,0,,Құдай-ау, әлгі жігіт мені қатты қинады.
Dialogue: 0,0:13:27.81,0:13:30.81,Default,,0,0,0,,Мектепте де солай, толқыдым.
Dialogue: 0,0:13:33.81,0:13:35.81,Default,,0,0,0,,Сызықша. (мүше) Иә
Dialogue: 0,0:13:35.81,0:13:37.82,Default,,0,0,0,,Келесі. (мүше) Иә.
Dialogue: 0,0:13:37.82,0:13:53.83,Default,,0,0,0,,Сен
Dialogue: 0,0:13:53.83,0:13:55.83,Default,,0,0,0,,Ha
Dialogue: 0,0:14:04.78,0:14:11.78,Default,,0,0,0,,Сен
Dialogue: 0,0:14:11.78,0:14:15.79,Default,,0,0,0,,Спайк қызмет етеді... керемет
Dialogue: 0,0:14:15.79,0:14:19.79,Default,,0,0,0,,Әй, ауысатын студент. Сен де бүгін жалғызсың ба?
Dialogue: 0,0:14:19.79,0:14:23.80,Default,,0,0,0,,Көріп отырғаныңыздай, бұл бір-біріне тығыз оралған.
Dialogue: 0,0:14:23.80,0:14:25.80,Default,,0,0,0,,Егер сіз жалғыз ойнасаңыз
Dialogue: 0,0:14:25.80,0:14:27.80,Default,,0,0,0,,Бұрышқа барсаң жақсы емес пе?
Dialogue: 0,0:14:27.80,0:14:30.80,Default,,0,0,0,,Екінші жағын пайдалана алсаңыз, жаттығуды тиімдірек орындауға болады.
Dialogue: 0,0:14:30.80,0:14:33.81,Default,,0,0,0,,Бір бетсіз жаттығуға болмайды.
Dialogue: 0,0:14:33.81,0:14:35.81,Default,,0,0,0,,Адам саны маңызды емес
Dialogue: 0,0:14:35.81,0:14:39.48,Default,,0,0,0,,Егер сізде жаттығуға арналған орын жеткіліксіз болса, кеңесшіңізбен кеңесіңіз.
Dialogue: 0,0:14:39.48,0:14:41.48,Default,,0,0,0,,Сіз қандайсыз?
Dialogue: 0,0:14:41.48,0:14:43.82,Default,,0,0,0,,｡
Dialogue: 0,0:14:43.82,0:14:47.82,Default,,0,0,0,,Жалғыз болмасаң, шағым айта алмайсың.
Dialogue: 0,0:14:47.82,0:14:51.82,Default,,0,0,0,,Ой... Кешіріңіз, кешігіп қалдым...
Dialogue: 0,0:14:51.82,0:14:53.83,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:14:53.83,0:14:55.83,Default,,0,0,0,,Мен оны көруге келдім.
Dialogue: 0,0:14:55.83,0:14:59.83,Default,,0,0,0,,Менің істегенім қызықсыз, сасық.
Dialogue: 0,0:14:59.83,0:15:03.77,Default,,0,0,0,,Мен сізді шынымен қызықты нәрсе істеп жатырсыз деп ойладым.
Dialogue: 0,0:15:03.77,0:15:06.77,Default,,0,0,0,,Хояде, мен саған көмектесу үшін келген жоқпын.
Dialogue: 0,0:15:06.77,0:15:09.77,Default,,0,0,0,,Бұл бұрын болған оқиға.
Dialogue: 0,0:15:09.77,0:15:11.78,Default,,0,0,0,,1-ден 20-ға дейін тым көп.
Dialogue: 0,0:15:11.78,0:15:16.78,Default,,0,0,0,,2-20 болса да, бұл өте көңіл көншітерлік емес.
Dialogue: 0,0:15:16.78,0:15:18.78,Default,,0,0,0,,Сіз сүйкімді емессіз.
Dialogue: 0,0:15:18.78,0:15:23.79,Default,,0,0,0,,Сіз осындай сөздерді айтып, достарыңыздан айырыласыз.
Dialogue: 0,0:15:23.79,0:15:26.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:26.79,0:15:30.80,Default,,0,0,0,,Мен оны көрдім. Таңғажайып спик қызметі.
Dialogue: 0,0:15:30.80,0:15:34.80,Default,,0,0,0,,Маған дәлдікті жақсарту керек, мен оны әлі матчтарда пайдалана алмаймын.
Dialogue: 0,0:15:34.80,0:15:37.80,Default,,0,0,0,,Аа, мен жай ғана сервистерді ұрып жатырмын.
Dialogue: 0,0:15:37.80,0:15:41.14,Default,,0,0,0,,Бұл сіз жалғыз жасай алатын жалғыз нәрсе.
Dialogue: 0,0:15:41.14,0:15:44.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:44.48,0:15:48.48,Default,,0,0,0,,Менде жейде жоқ, бірақ менімен бірге шығуға болады.
Dialogue: 0,0:15:48.48,0:15:50.82,Default,,0,0,0,,Мен бүгін Лай-чанға уәде бердім.
Dialogue: 0,0:15:50.82,0:15:55.82,Default,,0,0,0,,Бірақ мен оны жақсы білмеймін. Мен сенімен жаттығу жасай алмайтын шығармын.
Dialogue: 0,0:15:55.82,0:15:59.82,Default,,0,0,0,,Жалғыз істегенім дұрыс болса, қазір келемін.
Dialogue: 0,0:16:02.43,0:16:04.43,Default,,0,0,0,,Не? Жер бетінде ше?
Dialogue: 0,0:16:04.43,0:16:06.43,Default,,0,0,0,,Сәл күтіңіз. Мен оны контактілерге ауыстырамын.
Dialogue: 0,0:16:06.43,0:16:08.77,Default,,0,0,0,,Не? Неліктен? Өйткені мен бәрібір жалғызбын
Dialogue: 0,0:16:08.77,0:16:10.77,Default,,0,0,0,,Негізі мен жалқау болдым.
Dialogue: 0,0:16:10.77,0:16:14.77,Default,,0,0,0,,Сондай-ақ, оны жүктеп салу тәсілі мүлдем пайдасыз.
Dialogue: 0,0:16:14.77,0:16:16.77,Default,,0,0,0,,Мен созылудан басынан бастаймын.
Dialogue: 0,0:16:16.77,0:16:18.77,Default,,0,0,0,,Күтіңіз. иә?
Dialogue: 0,0:18:41.79,0:18:46.79,Default,,0,0,0,,Математика 95 балл Әлеуметтік ғылым 99 балл
Dialogue: 0,0:18:46.79,0:18:49.79,Default,,0,0,0,,Янони жапон тілі 30 ұпай
Dialogue: 0,0:18:49.79,0:18:52.80,Default,,0,0,0,,Шу шығармаңыз. Сіз басқалардың жауаптарын мазақ ете бересіз.
Dialogue: 0,0:18:52.80,0:18:54.80,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:18:54.80,0:18:59.80,Default,,0,0,0,,Бұл сенсің, математикадан 42 ұпай, қоғамтанудан 55 ұпай.
Dialogue: 0,0:18:59.80,0:19:02.74,Default,,0,0,0,,Егер бәрібір айту керек болса, жапон тіліндегі ұпайыңызды айтыңыз.
Dialogue: 0,0:19:02.74,0:19:06.74,Default,,0,0,0,,Керемет 87... ауырады!
Dialogue: 0,0:19:06.74,0:19:08.75,Default,,0,0,0,,Аа, қатты...
Dialogue: 0,0:19:08.75,0:19:11.75,Default,,0,0,0,,Күтілгендей, бұл атақты мектепте қолданылатын қыздыруға ұқсас.
Dialogue: 0,0:19:11.75,0:19:14.75,Default,,0,0,0,,Куробане, қазір бойыңыз неше сантиметр?
Dialogue: 0,0:19:14.75,0:19:17.76,Default,,0,0,0,,Иә? 173 Өртену?
Dialogue: 0,0:19:17.76,0:19:19.76,Default,,0,0,0,,Сіз оны қашан өлшедіңіз?
Dialogue: 0,0:19:19.76,0:19:22.76,Default,,0,0,0,,Хм, меніңше, күз болды ма?
Dialogue: 0,0:19:25.76,0:19:28.77,Default,,0,0,0,,175.0
Dialogue: 0,0:19:28.77,0:19:31.77,Default,,0,0,0,,О~ Ол 2 см-ге өсті.
Dialogue: 0,0:19:31.77,0:19:34.77,Default,,0,0,0,,Келесі жолы I
Dialogue: 0,0:19:34.77,0:19:37.78,Default,,0,0,0,,172.7
Dialogue: 0,0:19:37.78,0:19:40.78,Default,,0,0,0,,Мен де өстім. 2 см айырмашылық?
Dialogue: 0,0:19:40.78,0:19:44.45,Default,,0,0,0,,2,3 см айырмашылық. Сіз орнатушысыз.
Dialogue: 0,0:19:44.45,0:19:46.78,Default,,0,0,0,,Бойыңыз туралы көп уайымдаудың қажеті жоқ.
Dialogue: 0,0:19:46.78,0:19:49.79,Default,,0,0,0,,Маған ұнайтын ойыншы бар...
Dialogue: 0,0:19:49.79,0:19:54.79,Default,,0,0,0,,Абэ Бүкіл Жапония үшін де таңдалды. Ол сетер, бірақ 191 бар.
Dialogue: 0,0:19:54.79,0:19:57.80,Default,,0,0,0,,Өлшем неғұрлым үлкен болса, орнату орны соғұрлым жоғары болады.
Dialogue: 0,0:19:57.80,0:20:00.80,Default,,0,0,0,,Торға жақын доптарға қарсы күшейеді
Dialogue: 0,0:20:00.80,0:20:02.73,Default,,0,0,0,,Сондай-ақ, ол екі жақты және сол жақ екіде жақсы ойнайды.
Dialogue: 0,0:20:02.73,0:20:07.74,Default,,0,0,0,,Иә? Айтпақшы, сен де екі қолыңмен ұрдың.
Dialogue: 0,0:20:07.74,0:20:10.74,Default,,0,0,0,,Сіз екі жақтысыз ба? Мен оны екі жақты етіп жасадым.
Dialogue: 0,0:20:10.74,0:20:15.75,Default,,0,0,0,,Сіз екі жақты болуға шындап қарайсыз ба?
Dialogue: 0,0:20:15.75,0:20:17.75,Default,,0,0,0,,Рё, не болды?
Dialogue: 0,0:20:17.75,0:20:19.75,Default,,0,0,0,,Ах Юхито...
Dialogue: 0,0:20:19.75,0:20:22.75,Default,,0,0,0,,Мен волейбол үйірмесі жаттығады деп естідім...
Dialogue: 0,0:20:22.75,0:20:24.76,Default,,0,0,0,,О, онда... Істейміз!
Dialogue: 0,0:20:24.76,0:20:28.76,Default,,0,0,0,,Үш адам болса, орындалатын жаттығулардың саны айтарлықтай артады.
Dialogue: 0,0:20:28.76,0:20:48.78,Default,,0,0,0,,Сен
Dialogue: 0,0:20:48.78,0:21:08.73,Default,,0,0,0,,Сен
Dialogue: 0,0:21:08.73,0:21:24.75,Default,,0,0,0,,Сен
Dialogue: 0,0:21:24.75,0:21:27.75,Default,,0,0,0,,Куробанеса ойын тәжірибесі кезінде
Dialogue: 0,0:21:27.75,0:21:30.75,Default,,0,0,0,,Блокқа қараңдар, крест пен түзуді ажырата аласыңдар.
Dialogue: 0,0:21:30.75,0:21:33.76,Default,,0,0,0,,Айқас және түзу...
Dialogue: 0,0:21:33.76,0:21:36.76,Default,,0,0,0,,Аа, ортаға тура соғу түзу.
Dialogue: 0,0:21:36.76,0:21:38.76,Default,,0,0,0,,Крест – сыртқа сәл бұралған доп.
Dialogue: 0,0:21:38.76,0:21:40.76,Default,,0,0,0,,Керісінше, ақымақ.
Dialogue: 0,0:21:40.76,0:21:43.43,Default,,0,0,0,,Корт крестінен диагональ бойынша өтетін шыбықтар
Dialogue: 0,0:21:43.43,0:21:46.77,Default,,0,0,0,,Бүйір сызыққа параллель өтетін түзу.
Dialogue: 0,0:21:46.77,0:21:48.77,Default,,0,0,0,,Авангардқа соққы бергенде
Dialogue: 0,0:21:48.77,0:21:52.44,Default,,0,0,0,,Себебі менде интернеттің алдында тұрып, итермелейтін әдетім бар.
Dialogue: 0,0:21:52.44,0:21:54.78,Default,,0,0,0,,Адал соқса, крестке айналады.
Dialogue: 0,0:21:54.78,0:21:57.78,Default,,0,0,0,,Сыртқа қарай бұрау ниетімен соқса, түзу болады.
Dialogue: 0,0:21:57.78,0:22:01.79,Default,,0,0,0,,Бұл күрделі. Бұл әсіресе күрделі емес.
Dialogue: 0,0:22:01.79,0:22:03.79,Default,,0,0,0,,Жарайды. Жүр, дайында.
Dialogue: 0,0:22:03.79,0:22:06.79,Default,,0,0,0,,Дайындалуда...
Dialogue: 0,0:22:06.79,0:22:08.79,Default,,0,0,0,,Басыңызда білмесеңіз де
Dialogue: 0,0:22:08.79,0:22:11.80,Default,,0,0,0,,Менің көру қабілетім жақсы, сондықтан мен блоктармен күресемін.
Dialogue: 0,0:22:11.80,0:22:13.80,Default,,0,0,0,,Өзіңізді қаншалықты жақсы пайдаланасыз
Dialogue: 0,0:22:13.80,0:22:16.80,Default,,0,0,0,,Иықтың жұмсақтығы және жоғарыдан күту мүмкіндігі
Dialogue: 0,0:22:16.80,0:22:20.80,Default,,0,0,0,,Мүмкін бұл сізде бар қасиет шығар.
Dialogue: 0,0:22:20.80,0:22:23.81,Default,,0,0,0,,Сіз жақсарасыз.
Dialogue: 0,0:22:23.81,0:22:25.81,Default,,0,0,0,,Егер сіз мұны дұрыс жасасаңыз, қысқа уақыт ішінде
Dialogue: 0,0:22:25.81,0:22:27.81,Default,,0,0,0,,Бойың да өседі.
Dialogue: 0,0:22:27.81,0:22:29.81,Default,,0,0,0,,Бұл да қызба ма?
Dialogue: 0,0:22:29.81,0:22:31.82,Default,,0,0,0,,Не? Мен біртүрлі нәрсе айттым ба?
Dialogue: 0,0:22:31.82,0:22:34.82,Default,,0,0,0,,Сіз әрқашан бастықсыз.
Dialogue: 0,0:22:34.82,0:22:36.82,Default,,0,0,0,,Біреуді осылай мақтау.
Dialogue: 0,0:22:36.82,0:22:39.82,Default,,0,0,0,,Мойындамайсың деп ойладым.
Dialogue: 0,0:22:39.82,0:22:43.83,Default,,0,0,0,,Егер сізде мойындайтын нәрсе болса, оны мойындау табиғи нәрсе.
Dialogue: 0,0:22:43.83,0:22:46.83,Default,,0,0,0,,Волейболға қабілетің болса да...
Dialogue: 0,0:22:46.83,0:22:49.83,Default,,0,0,0,,Өте танымал емес.
Dialogue: 0,0:22:51.84,0:22:54.84,Default,,0,0,0,,Хайдзима: Сен орта мектеп туралы не істейсің?
Dialogue: 0,0:22:54.84,0:22:58.84,Default,,0,0,0,,Сіз оны осында апарасыз ба? Менің ойымша, бұл ...
Dialogue: 0,0:22:58.84,0:23:01.85,Default,,0,0,0,,Бірақ? Қандай да бір шарттар бар ма?
Dialogue: 0,0:23:01.85,0:23:05.78,Default,,0,0,0,,Одан гөрі сәуір келгенде бір жыл болады.
Dialogue: 0,0:23:05.78,0:23:09.79,Default,,0,0,0,,О, уау. Мен үлкен үміт күтпеуім керек.
Dialogue: 0,0:23:09.79,0:23:11.79,Default,,0,0,0,,Бір немесе екі адамды ұстай аласыз ба?
Dialogue: 0,0:23:11.79,0:23:14.46,Default,,0,0,0,,Мүшелер көбейсе, мен турнирге қатысқым келеді.
Dialogue: 0,0:23:14.46,0:23:17.79,Default,,0,0,0,,Мен бұл турнир кестесі туралы білмеймін.
Dialogue: 0,0:23:17.79,0:23:20.80,Default,,0,0,0,,Жазда Зенчу алдында префектуралық турнир болуы керек.
Dialogue: 0,0:23:20.80,0:23:24.80,Default,,0,0,0,,Сіз көріне алсаңыз да, біздің деңгейде жеңіске жете алмайсыз деп ойлаймын...
Dialogue: 0,0:23:24.80,0:23:27.80,Default,,0,0,0,,Ойнамасаң қызық емес.
Dialogue: 0,0:23:27.80,0:23:30.81,Default,,0,0,0,,Мен сіріңке ойнағым келеді
Dialogue: 0,0:23:30.81,0:23:34.81,Default,,0,0,0,,Мен бәріңді дайындаймын, сонда жазға дейін формада боласыңдар.
Dialogue: 0,0:23:34.81,0:23:36.81,Default,,0,0,0,,Қалғанын мен шешемін
Dialogue: 0,0:23:36.81,0:23:39.82,Default,,0,0,0,,Мен түсіндім. Турнирге барасыз ба?
Dialogue: 0,0:23:39.82,0:23:41.82,Default,,0,0,0,,Кеңесші қиналып жатқан жоқ па?
Dialogue: 0,0:23:41.82,0:23:43.82,Default,,0,0,0,,Ертең барып тыңдайық.
Dialogue: 0,0:23:43.82,0:23:46.82,Default,,0,0,0,,Әй, түпнұсқа Бонмен бармайсың ба?
Dialogue: 0,0:23:46.82,0:23:48.83,Default,,0,0,0,,Сәлем. Біраз уақыт өтті.
Dialogue: 0,0:23:48.83,0:23:51.83,Default,,0,0,0,,Ах, Рай-чан
Dialogue: 0,0:23:51.83,0:23:53.83,Default,,0,0,0,,Сіздің аға буындарыңыз қайтып келді ме?
Dialogue: 0,0:23:53.83,0:23:55.83,Default,,0,0,0,,Университетте де көктемгі демалыс бар.
Dialogue: 0,0:23:55.83,0:23:58.84,Default,,0,0,0,,Bon. Бүгін сізде қанша бар?
Dialogue: 0,0:23:58.84,0:24:01.84,Default,,0,0,0,,Аа, менде аз ғана өзгеріс бар.
Dialogue: 0,0:24:01.84,0:24:04.78,Default,,0,0,0,,Соңғы кездері үйірме жұмыстары кезінде сөмкемді қараусыз қалдыратын болдым.
Dialogue: 0,0:24:04.78,0:24:07.78,Default,,0,0,0,,Клуб қызметі? (Досым) Көрдім.
Dialogue: 0,0:24:07.78,0:24:11.78,Default,,0,0,0,,Йоримичидің айтқаны осы ма? (Досым) Сіз Барибо ойнадыңыз ба?
Dialogue: 0,0:24:11.78,0:24:13.78,Default,,0,0,0,,Тек байқап көріңіз.
Dialogue: 0,0:24:13.78,0:24:15.79,Default,,0,0,0,,Қараңызшы, сіз қабылдауды орындадыңыз ба?
Dialogue: 0,0:24:15.79,0:24:18.79,Default,,0,0,0,,Сіз не істедіңіз? Мен оны да ұмыттым
Dialogue: 0,0:24:18.79,0:24:21.79,Default,,0,0,0,,Мм... Менің ойымша, бұл солай.
Dialogue: 0,0:24:21.79,0:24:23.79,Default,,0,0,0,,О, құдайым
Dialogue: 0,0:24:23.79,0:24:26.80,Default,,0,0,0,,Хайкюу сияқты, керемет Бон
Dialogue: 0,0:24:26.80,0:24:28.80,Default,,0,0,0,,Хайдзима?
Dialogue: 0,0:24:28.80,0:24:30.80,Default,,0,0,0,,Мен мұны көңіл көтеру үшін істеп жатқан жоқпын.
Dialogue: 0,0:24:30.80,0:24:33.80,Default,,0,0,0,,Менімен кездеспе. Түсінемін, мені тартып алма.
Dialogue: 0,0:24:33.80,0:24:35.81,Default,,0,0,0,,Ойнайық. Юхито
Dialogue: 0,0:24:35.81,0:24:37.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:37.81,0:24:40.81,Default,,0,0,0,,Жоқ, мен Споне Чика-чаннан бөртпе алдым
Dialogue: 0,0:24:40.81,0:24:42.81,Default,,0,0,0,,Сіз байыпты емессіз, солай ма?
Dialogue: 0,0:24:42.81,0:24:45.82,Default,,0,0,0,,Тоқта... Рай-чан, бір нәрсеге ашуланып тұрсың ба?
Dialogue: 0,0:24:45.82,0:24:48.82,Default,,0,0,0,,Жақында кездеспегеніме менің кінәм болды.
Dialogue: 0,0:24:48.82,0:24:50.82,Default,,0,0,0,,Көктемгі демалыста тағы ойнайық.
Dialogue: 0,0:24:50.82,0:24:52.82,Default,,0,0,0,,Көктемгі демалыста да жаттығу
Dialogue: 0,0:24:52.82,0:24:55.83,Default,,0,0,0,,Сіз мұны күнде жасай алмайсыз, солай ма?
Dialogue: 0,0:24:55.83,0:24:59.83,Default,,0,0,0,,Жазғы турнирге барсам, әлі де уақытында өте алмаймын.
Dialogue: 0,0:24:59.83,0:25:02.77,Default,,0,0,0,,Шынымен...｡ (Йоримичи) Юхито
Dialogue: 0,0:25:02.77,0:25:06.77,Default,,0,0,0,,Түсіндіңіз. Мен оны саған мәжбүрлей алмаймын.
Dialogue: 0,0:25:06.77,0:25:10.77,Default,,0,0,0,,Тек көңіл көтеру үшін тоқтау ұят болар еді.
Dialogue: 0,0:25:10.77,0:25:15.78,Default,,0,0,0,,Менің де ойым ұзақ емес. Мен көп күте алмаймын.
Dialogue: 0,0:25:15.78,0:25:19.78,Default,,0,0,0,,Әй, олай айтпа. Сіз байсалды емессіз, солай ма?
Dialogue: 0,0:25:19.78,0:25:22.79,Default,,0,0,0,,О~ Танымал Bon
Dialogue: 0,0:25:22.79,0:25:26.79,Default,,0,0,0,,Біреуін таңдасаңыз, екіншісінен бөлінесіз.
Dialogue: 0,0:25:26.79,0:25:28.79,Default,,0,0,0,,Мен... түсіндім.
Dialogue: 0,0:25:28.79,0:25:31.80,Default,,0,0,0,,Менің де Рай Чанның қаны бар.
Dialogue: 0,0:25:31.80,0:25:34.80,Default,,0,0,0,,Ол оңай қызады және оңай суытады.
Dialogue: 0,0:25:34.80,0:25:37.80,Default,,0,0,0,,Волейболда да бір кезде жалығып қалатын шығармын.
Dialogue: 0,0:25:37.80,0:25:39.80,Default,,0,0,0,,Ах. иә?
Dialogue: 0,0:25:39.80,0:25:43.81,Default,,0,0,0,,Сіз байсалдысыз ба? Жоқ... жақсы...
Dialogue: 0,0:25:43.81,0:25:45.81,Default,,0,0,0,,А, енді тоқтат.
Dialogue: 0,0:25:45.81,0:25:48.81,Default,,0,0,0,,Бұл кенеттен секірмесе де.
Dialogue: 0,0:25:48.81,0:25:50.81,Default,,0,0,0,,Турнир Мен оны шатастырғым келмейді
Dialogue: 0,0:25:50.81,0:25:54.82,Default,,0,0,0,,Бәле екен... Жанжал үшін кешірім сұраймын.
Dialogue: 0,0:25:54.82,0:25:58.82,Default,,0,0,0,,Мен ойында болғым келеді! Ах...
Dialogue: 0,0:25:58.82,0:26:01.83,Default,,0,0,0,,Хаха! Сіз өзіңіздің шынайы болмысыңызды аштыңыз!
Dialogue: 0,0:26:01.83,0:26:05.76,Default,,0,0,0,,Әлемде беделі жоғары данышпан бапкер
Dialogue: 0,0:26:05.76,0:26:09.77,Default,,0,0,0,,Сіз тек өз қалауыңызды орындауды ойлайсыз.
Dialogue: 0,0:26:09.77,0:26:12.77,Default,,0,0,0,,Рай-чан... сен не айтып тұрсың? ол
Dialogue: 0,0:26:12.77,0:26:15.77,Default,,0,0,0,,Білгісі келген сен едің, Юхито.
Dialogue: 0,0:26:15.77,0:26:18.78,Default,,0,0,0,,Чика мұнда неге оралды?
Dialogue: 0,0:26:18.78,0:26:21.78,Default,,0,0,0,,Мен Хойя туралы біраз зерттеу жүргіздім.
Dialogue: 0,0:26:21.78,0:26:25.78,Default,,0,0,0,,Ой, сен Юхитоны кінәлайтын жерде дұрыс емессің.
Dialogue: 0,0:26:25.78,0:26:28.79,Default,,0,0,0,,Ол тот басқан жігіт.
Dialogue: 0,0:26:28.79,0:26:30.79,Default,,0,0,0,,Рай-чан. Дойтоке Юхито
Dialogue: 0,0:26:30.79,0:26:34.46,Default,,0,0,0,,Мектептің аты атамнан қалған.
Dialogue: 0,0:26:34.46,0:26:37.79,Default,,0,0,0,,Мен оны сенен және мына қарттан оңай аламын.
Dialogue: 0,0:26:37.79,0:26:40.80,Default,,0,0,0,,Интернетте жылдам іздеу жасасаңыз
Dialogue: 0,0:26:40.80,0:26:42.80,Default,,0,0,0,,Мен кетемін мен кетемін
Dialogue: 0,0:26:42.80,0:26:45.80,Default,,0,0,0,,Өткен жылға дейін ол жоғары билік етті
Dialogue: 0,0:26:45.80,0:26:47.80,Default,,0,0,0,,Кемеңгердің жаман сөздері
Dialogue: 0,0:26:47.80,0:26:52.81,Default,,0,0,0,,Сізді шынымен жек көреді.
Dialogue: 0,0:26:52.81,0:26:55.81,Default,,0,0,0,,Юхито. иә? Иә...
Dialogue: 0,0:26:55.81,0:26:58.82,Default,,0,0,0,,Менің де Чикаға тікелей ренішім жоқ.
Dialogue: 0,0:26:58.82,0:27:02.75,Default,,0,0,0,,Бұл маңызды емес. Мұның бәрі сен үшін.
Dialogue: 0,0:27:02.75,0:27:04.75,Default,,0,0,0,,Жаман сөз айтпа
Dialogue: 0,0:27:04.75,0:27:07.09,Default,,0,0,0,,Волейболға көп араласпаңыз.
Dialogue: 0,0:27:07.09,0:27:09.76,Default,,0,0,0,,Неге...｡ Бұл жігіт волейбол үшін жасады.
Dialogue: 0,0:27:09.76,0:27:14.76,Default,,0,0,0,,Мен бәрін істеймін. Мен бәрін істеймін.
Dialogue: 0,0:27:14.76,0:27:16.77,Default,,0,0,0,,《Дұрыс орында! 》
Dialogue: 0,0:27:16.77,0:27:18.77,Default,,0,0,0,,《Сол жақтағы ойыншының рөлі қабылдау》
Dialogue: 0,0:27:18.77,0:27:20.77,Default,,0,0,0,,《Сіздің жұмысыңыз маған орнатушы ретінде қосылу》
Dialogue: 0,0:27:20.77,0:27:23.77,Default,,0,0,0,,《Жәй ғана көтер деп тұрсың.》
Dialogue: 0,0:27:23.77,0:27:28.78,Default,,0,0,0,,《Мен де қолынан келмейтін адамды шаншып тастамаймын! 》
Dialogue: 0,0:27:28.78,0:27:31.78,Default,,0,0,0,,《Ол ертеңгі ойынға негізгі құрамнан шығарылады》
Dialogue: 0,0:27:31.78,0:27:35.79,Default,,0,0,0,,《Әзірше Йошино және басқалар, сонымен қатар аналар.
Dialogue: 0,0:27:35.79,0:27:38.46,Default,,0,0,0,,Өйткені ішу деңгейі төмендейді》
Dialogue: 0,0:27:38.46,0:27:40.46,Default,,0,0,0,,《Аа, аурухана? 》
Dialogue: 0,0:27:40.46,0:27:43.46,Default,,0,0,0,,《Соута Йошино ше!?》
Dialogue: 0,0:27:43.46,0:27:47.46,Default,,0,0,0,,《Үйдегі сута...》
Dialogue: 0,0:27:47.46,0:27:50.80,Default,,0,0,0,,Жарайсың ба? Юхито. Бұл жігіт
Dialogue: 0,0:27:50.80,0:27:54.80,Default,,0,0,0,,Сізді тыңдамайтын клуб мүшелерін бұраңыз
Dialogue: 0,0:27:54.80,0:27:57.80,Default,,0,0,0,,Сіз мені өз-өзіне қол жұмсауға мәжбүр еттіңіз.
Dialogue: 0,0:28:01.81,0:28:11.81,Default,,0,0,0,,Сен
Dialogue: 0,0:28:13.31,0:28:19.31,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
