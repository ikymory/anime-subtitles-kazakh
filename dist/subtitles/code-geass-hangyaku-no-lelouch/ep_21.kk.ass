Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.26,0:00:05.23,Default,,0,0,0,,Жағдай өзгере бастайды.
Dialogue: 0,0:00:05.33,0:00:08.10,Default,,0,0,0,,Жеке ниетіне қарамастан--
Dialogue: 0,0:00:08.74,0:00:10.54,Default,,0,0,0,,Уақыт өтіп жатыр.
Dialogue: 0,0:00:11.14,0:00:13.54,Default,,0,0,0,,Адамдардың күресінен басқа...
Dialogue: 0,0:00:14.48,0:00:17.21,Default,,0,0,0,,Сонда Лелуш бақытты болуы керек.
Dialogue: 0,0:00:18.18,0:00:22.58,Default,,0,0,0,,Кем дегенде, сіз өз күшіңізбен әлемді шеше аласыз.
Dialogue: 0,0:00:23.75,0:00:28.26,Default,,0,0,0,,Кез келген қарсыласқа пәрмен беруге мүмкіндік беретін абсолютті бағыну күші.
Dialogue: 0,0:00:28.46,0:00:29.52,Default,,0,0,0,,Геассқа сүйену
Dialogue: 0,0:00:30.33,0:00:36.33,Default,,0,0,0,,♪～
Dialogue: 0,0:00:38.23,0:00:42.07,Default,,0,0,0,,♪Мен армандаған арман
Dialogue: 0,0:00:42.17,0:00:45.77,Default,,0,0,0,,♪Шексіз және алыс
Dialogue: 0,0:00:46.07,0:00:52.41,Default,,0,0,0,,♪Құрғақ күндерде көк аспан, Қолымда
Dialogue: 0,0:00:53.82,0:00:57.49,Default,,0,0,0,,♪Дыбыстағы біркелкі сынама және қателік
Dialogue: 0,0:00:57.59,0:01:02.79,Default,,0,0,0,,♪Уақытсыз және интервалсыз кеңістік
Dialogue: 0,0:01:04.46,0:01:06.69,Default,,0,0,0,,♪Өмірлік өлшем шу шығарады
Dialogue: 0,0:01:06.80,0:01:09.53,Default,,0,0,0,,♪Мен өз бетімді жасаймын
Dialogue: 0,0:01:09.63,0:01:13.07,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:01:13.64,0:01:17.54,Default,,0,0,0,,♪Қолыма түсті
Dialogue: 0,0:01:17.64,0:01:21.41,Default,,0,0,0,,♪Шіріген алма
Dialogue: 0,0:01:21.51,0:01:25.45,Default,,0,0,0,,♪Айнада бейнеленген
Dialogue: 0,0:01:25.55,0:01:29.42,Default,,0,0,0,,♪Біздің арғы жағымызға
Dialogue: 0,0:01:29.52,0:01:33.22,Default,,0,0,0,,♪Дистанциялық сезім Адамдар арасындағы сынақ пен қателік
Dialogue: 0,0:01:33.32,0:01:38.39,Default,,0,0,0,,♪Уақытсыз және сезімсіз кеңістік
Dialogue: 0,0:01:40.13,0:01:42.40,Default,,0,0,0,,♪Бас пен дене тырнақтарын жоғары көтеріп тұру
Dialogue: 0,0:01:42.50,0:01:45.33,Default,,0,0,0,,♪Бетімді қырып алайын деп жатырмын
Dialogue: 0,0:01:45.43,0:01:51.14,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:01:52.64,0:01:59.65,Default,,0,0,0,,♪-Қашықтық сезімі
Dialogue: 0,0:02:05.62,0:02:07.79,Default,,0,0,0,,Әрине, Қытай Федерациясының араласуы...
Dialogue: 0,0:02:07.89,0:02:10.19,Default,,0,0,0,,Қара рыцарьлар жасаған лаңкестік әрекеттерге байланысты...
Dialogue: 0,0:02:10.29,0:02:12.33,Default,,0,0,0,,Дүниеде шу көп.
Dialogue: 0,0:02:12.56,0:02:15.46,Default,,0,0,0,,Бірақ! Ал бұл басқа мәселе.
Dialogue: 0,0:02:15.56,0:02:17.73,Default,,0,0,0,,Қатысуға күндердің аздығы бұл факт! ―
Dialogue: 0,0:02:18.37,0:02:19.67,Default,,0,0,0,,Сіздің бағаларыңыз қаншалықты жақсы болса да...
Dialogue: 0,0:02:19.73,0:02:21.90,Default,,0,0,0,,Евфемия-сама қанша рыцарь болса да...
Dialogue: 0,0:02:22.27,0:02:25.34,Default,,0,0,0,,Егер сіз жеткілікті күндерге бармасаңыз, жылды қайталаудан басқа амалыңыз қалмайды!
Dialogue: 0,0:02:25.44,0:02:27.18,Default,,0,0,0,,Әлі де біраз уақыт қажет сияқты.
Dialogue: 0,0:02:27.28,0:02:28.88,Default,,0,0,0,,Бүгін түнде аяқталады ма?
Dialogue: 0,0:02:29.44,0:02:30.45,Default,,0,0,0,,Я...
Dialogue: 0,0:02:30.85,0:02:33.58,Default,,0,0,0,,Өйткені, Нөл біздің құтқарушымыз!
Dialogue: 0,0:02:33.82,0:02:35.65,Default,,0,0,0,,Тіпті он бір адам да жоғарылай алады.
Dialogue: 0,0:02:35.75,0:02:37.82,Default,,0,0,0,,Мына Сузаку Куруругиге қараңыз.
Dialogue: 0,0:02:38.29,0:02:39.59,Default,,0,0,0,,Егер Нөл болмаса, Кюсю болатын еді
Dialogue: 0,0:02:39.69,0:02:41.66,Default,,0,0,0,,Оны Қытай Федерациясы ұрлаған?
Dialogue: 0,0:02:41.86,0:02:43.89,Default,,0,0,0,,Бірақ жаңалық олай емес...
Dialogue: 0,0:02:44.19,0:02:45.93,Default,,0,0,0,,Британия бұл туралы есеп бере алмайды!
Dialogue: 0,0:02:46.33,0:02:48.50,Default,,0,0,0,,Бейбіт болғанша бәрі жақсы.
Dialogue: 0,0:02:48.70,0:02:52.33,Default,,0,0,0,,Құлдар үшін бейбітшілік, солай ма? Куруруги не істеп жатыр!
Dialogue: 0,0:02:52.83,0:02:55.20,Default,,0,0,0,,) Тіпті геттода да пікірлер екіге бөлінеді?
Dialogue: 0,0:02:55.30,0:02:57.24,Default,,0,0,0,,Конформистер мен көтерілісшілер.
Dialogue: 0,0:02:57.34,0:02:59.54,Default,,0,0,0,,Бірақ бәрі таң қалады...
Dialogue: 0,0:02:59.64,0:03:01.88,Default,,0,0,0,,Нөлдің ел салуды жоспарлап жүргенін білгенде
Dialogue: 0,0:03:02.18,0:03:03.81,Default,,0,0,0,,Дұрыс, бұл абсурд.
Dialogue: 0,0:03:03.91,0:03:05.35,Default,,0,0,0,,Сәл шынайырақ...
Dialogue: 0,0:03:05.71,0:03:07.58,Default,,0,0,0,,Мен нөлмен келісемін.
Dialogue: 0,0:03:07.68,0:03:09.72,Default,,0,0,0,,Не? (Тамаки) Солай емес пе?
Dialogue: 0,0:03:09.82,0:03:12.69,Default,,0,0,0,,Оған ерсең, өмірің мүлде өзгереді.
Dialogue: 0,0:03:12.79,0:03:14.49,Default,,0,0,0,,Менің арманым - бюрократ болу.
Dialogue: 0,0:03:14.59,0:03:16.36,Default,,0,0,0,,Бюрократия?Шынайы ма?
Dialogue: 0,0:03:16.46,0:03:18.96,Default,,0,0,0,,Менің де арманым бар еді...
Dialogue: 0,0:03:19.26,0:03:22.53,Default,,0,0,0,,Мен Қара Рыцарларға қосылу керек деп шештім, тіпті егер бұл қазірге дейін Рефраин болса да.
Dialogue: 0,0:03:22.63,0:03:25.23,Default,,0,0,0,,Ах! (Йошида) Рефрень сіз...
Dialogue: 0,0:03:25.87,0:03:29.50,Default,,0,0,0,,Қайтыс болса өткен, Нөлдің шын тұлғасы...
Dialogue: 0,0:03:29.60,0:03:31.84,Default,,0,0,0,,Бірақ егер сіз білсеңіз не істейсіз? мен...
Dialogue: 0,0:03:31.94,0:03:33.68,Default,,0,0,0,,Оуги мырза (Оуги) Ах!
Dialogue: 0,0:03:33.78,0:03:35.28,Default,,0,0,0,,Мысал ретінде,
Dialogue: 0,0:03:35.38,0:03:38.31,Default,,0,0,0,,Мен нұсқауларды сұрауға тырыстым, бірақ мен Zero-мен байланыса алмадым.
Dialogue: 0,0:03:38.41,0:03:39.91,Default,,0,0,0,,Содан кейін мен жоспарлағандай...
Dialogue: 0,0:03:40.22,0:03:41.82,Default,,0,0,0,,Оны тұзақ деп те ойламаңыз.
Dialogue: 0,0:03:41.92,0:03:44.22,Default,,0,0,0,,Бірақ бізге ақпараттық маршрут керек пе? ―
Dialogue: 0,0:03:44.45,0:03:46.92,Default,,0,0,0,,Ол жақта қосылғысы келетіндер бар дейді.
Dialogue: 0,0:03:47.22,0:03:50.66,Default,,0,0,0,,Сонымен қатар, Диетард жасаған қашу жолын пайдалануға болады.
Dialogue: 0,0:03:50.76,0:03:52.26,Default,,0,0,0,,Тек ертең...
Dialogue: 0,0:03:52.33,0:03:54.60,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:03:54.66,0:03:55.56,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:03:55.66,0:03:56.70,Default,,0,0,0,,Күткеніңізге рахмет! ―
Dialogue: 0,0:03:57.23,0:03:59.73,Default,,0,0,0,,Бұдан былай ең ашық Токио концессиясы.
Dialogue: 0,0:03:59.83,0:04:02.90,Default,,0,0,0,,Эшфорд академиясының мектеп фестивалі басталады!
Dialogue: 0,0:04:03.34,0:04:05.64,Default,,0,0,0,,Бастау сигналы осы бір дауыстан келеді
Dialogue: 0,0:04:05.74,0:04:07.58,Default,,0,0,0,,Ум... жақсысың ба?
Dialogue: 0,0:04:07.68,0:04:08.54,Default,,0,0,0,,Та-да!
Dialogue: 0,0:04:08.64,0:04:10.01,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:04:10.71,0:04:12.28,Default,,0,0,0,,Мияу~
Dialogue: 0,0:04:12.38,0:04:14.38,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:04:17.82,0:04:19.82,Default,,0,0,0,,) Бүгін шулы...
Dialogue: 0,0:04:19.95,0:04:21.69,Default,,0,0,0,,Қош келдіңіз, қош келдіңіз
Dialogue: 0,0:04:21.79,0:04:23.93,Default,,0,0,0,,Britannia roll!
Dialogue: 0,0:04:24.03,0:04:26.73,Default,,0,0,0,,Таңқаларлық даулы жұмыс Document Zero!Қазір көрсетілуде!
Dialogue: 0,0:04:26.83,0:04:29.26,Default,,0,0,0,,Кловис мырзаның суреті бар.
Dialogue: 0,0:04:31.97,0:04:33.27,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:04:33.37,0:04:35.70,Default,,0,0,0,,Савазаки мен оның достары да оны пайдалы деп тапты.
Dialogue: 0,0:04:35.80,0:04:37.94,Default,,0,0,0,,Қазір шарттар өте анық.
Dialogue: 0,0:04:38.04,0:04:40.98,Default,,0,0,0,,Иә Әр аймақта төтенше жағдайды жою шаралары қандай?
Dialogue: 0,0:04:41.28,0:04:43.34,Default,,0,0,0,,Мәліметтерде барлығы қалды
Dialogue: 0,0:04:43.41,0:04:44.28,Default,,0,0,0,,Хмм... БАҚ?
Dialogue: 0,0:04:44.38,0:04:46.31,Default,,0,0,0,,Әр компания үшін күн батареялары
Dialogue: 0,0:04:46.58,0:04:49.55,Default,,0,0,0,,Біз сондай-ақ байланысты энергия сақтау қоймасын бақылауға алдық.
Dialogue: 0,0:04:49.65,0:04:50.92,Default,,0,0,0,,Жер асты серіктесі...
Dialogue: 0,0:04:51.45,0:04:55.79,Default,,0,0,0,,Маған жетеді. Мен оны 72%-ға дейін толтырдым.
Dialogue: 0,0:04:55.89,0:04:56.92,Default,,0,0,0,,Todo туралы не деуге болады?
Dialogue: 0,0:04:57.03,0:04:58.93,Default,,0,0,0,,Хабар тарату станциялары сияқты кәсіптік мақсаттар -
Dialogue: 0,0:04:59.03,0:05:00.86,Default,,0,0,0,,Біз тізім жасап жатырмыз.
Dialogue: 0,0:05:00.96,0:05:02.93,Default,,0,0,0,,Киотоға арналған манекен жоспарымен бірге.
Dialogue: 0,0:05:03.03,0:05:05.37,Default,,0,0,0,,Мен чек сұрағым келеді.
Dialogue: 0,0:05:05.47,0:05:07.67,Default,,0,0,0,,Түсіндім, ертең тексеремін
Dialogue: 0,0:05:07.77,0:05:10.37,Default,,0,0,0,,О, мен есеп беруге кешігіп қалдым...
Dialogue: 0,0:05:10.54,0:05:12.07,Default,,0,0,0,,Нөлдік отрядқа қатысты, командирдің орынбасары Оги...
Dialogue: 0,0:05:12.37,0:05:15.48,Default,,0,0,0,,Мен қысылып қалдым!Үлкен шымшым!
Dialogue: 0,0:05:15.58,0:05:17.41,Default,,0,0,0,,Мен сізге кейінірек қоңырау шаламын (дыбысты қою)
Dialogue: 0,0:05:17.51,0:05:19.08,Default,,0,0,0,,Иә?шымшу?
Dialogue: 0,0:05:19.65,0:05:22.85,Default,,0,0,0,,Неге босаңсып жатырсың? Лелуш атқарушы комитеттің төрағасы, солай ма?
Dialogue: 0,0:05:23.35,0:05:25.55,Default,,0,0,0,,Орындауда ешқандай проблема жоқ.
Dialogue: 0,0:05:25.79,0:05:28.66,Default,,0,0,0,,Оның үстіне бұл төрағаның міндеті, солай ма? ―
Dialogue: 0,0:05:28.76,0:05:30.46,Default,,0,0,0,,Өткен жылға дейін 2 метр болатын...
Dialogue: 0,0:05:30.56,0:05:33.66,Default,,0,0,0,,Сіз кенеттен диаметрі 12 метрлік пицца жасаймын деп айта бастайсыз.
Dialogue: 0,0:05:33.76,0:05:35.00,Default,,0,0,0,,Хмм, бұл керемет емес пе? ―
Dialogue: 0,0:05:35.10,0:05:37.47,Default,,0,0,0,,Аяқталғаннан кейін ол әлемдегі ең жақсы түрі болады.
Dialogue: 0,0:05:37.57,0:05:40.07,Default,,0,0,0,,Тұмшапеш пен ингредиенттердің өзі үлкен мәселе.
Dialogue: 0,0:05:40.64,0:05:42.07,Default,,0,0,0,,Теледидар станцияларынан басқа
Dialogue: 0,0:05:42.37,0:05:44.87,Default,,0,0,0,,Сіз білесіз бе? Бетімізді көрсете алмаймыз
Dialogue: 0,0:05:44.97,0:05:46.97,Default,,0,0,0,,Мен пиццаның есебін жүргізуім керек.
Dialogue: 0,0:05:47.08,0:05:48.41,Default,,0,0,0,,Сіз кабинада тұра аласыз.
Dialogue: 0,0:05:48.51,0:05:50.11,Default,,0,0,0,,Эй, Төрағаның бұйрығы
Dialogue: 0,0:05:50.38,0:05:51.88,Default,,0,0,0,,Иә!Тоқта!
Dialogue: 0,0:05:51.98,0:05:54.02,Default,,0,0,0,,Қарсылас!Бұл аяқталды!
Dialogue: 0,0:05:54.12,0:05:55.72,Default,,0,0,0,,О, сенің көңіл-күйің жақсы.
Dialogue: 0,0:05:55.82,0:05:58.09,Default,,0,0,0,,Жақсы нәрсе болды ма? (Нина) Иә, аздап.
Dialogue: 0,0:05:59.59,0:06:02.46,Default,,0,0,0,,Кешіріңіз, он бір геттодан жалғыз шыққанда...
Dialogue: 0,0:06:02.56,0:06:03.42,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:03.52,0:06:05.39,Default,,0,0,0,,Британия қорқынышты болып көрінсе...
Dialogue: 0,0:06:05.49,0:06:07.56,Default,,0,0,0,,Көп уайымдамаңыз
Dialogue: 0,0:06:07.66,0:06:11.53,Default,,0,0,0,,Ең бастысы, бұл сіздің жұмысыңызға көмектеседі ме?
Dialogue: 0,0:06:11.63,0:06:12.77,Default,,0,0,0,,О
Dialogue: 0,0:06:13.07,0:06:15.37,Default,,0,0,0,,Өйткені біз даму жоспары үшін деректерді жинап жатырмыз.
Dialogue: 0,0:06:15.84,0:06:17.84,Default,,0,0,0,,Мен көремін. Жақсы.
Dialogue: 0,0:06:18.07,0:06:19.04,Default,,0,0,0,,Ахаха
Dialogue: 0,0:06:19.41,0:06:21.54,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:06:21.71,0:06:24.71,Default,,0,0,0,,Мүмкін болса, мен оны полицияға немесе ауруханаға апарар едім...
Dialogue: 0,0:06:24.81,0:06:26.41,Default,,0,0,0,,Жоқ, бұл жақсы емес.
Dialogue: 0,0:06:26.51,0:06:29.65,Default,,0,0,0,,Егер менің ақпаратым шығып кетсе, басқалардың бәрі қатысады.
Dialogue: 0,0:06:29.75,0:06:32.12,Default,,0,0,0,,Сондықтан мен одан құтыламын...
Dialogue: 0,0:06:32.42,0:06:33.42,Default,,0,0,0,,Маған...
Dialogue: 0,0:06:34.56,0:06:35.56,Default,,0,0,0,,Міне, солай ма?
Dialogue: 0,0:06:35.72,0:06:36.89,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:36.99,0:06:38.06,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:06:38.16,0:06:41.70,Default,,0,0,0,,Мен мектепте мұғалім болып жұмыс істегенмін, сондықтан мен ностальгия сезінемін.
Dialogue: 0,0:06:41.80,0:06:43.73,Default,,0,0,0,,Неліктен бас тарттыңыз?
Dialogue: 0,0:06:44.90,0:06:47.47,Default,,0,0,0,,Менің бала кезімнен жақын досым бар.
Dialogue: 0,0:06:47.57,0:06:49.17,Default,,0,0,0,,Бірақ ол қайтыс болды...
Dialogue: 0,0:06:49.57,0:06:51.87,Default,,0,0,0,,Мен оның орнын сол арманда аламын...
Dialogue: 0,0:06:52.14,0:06:56.11,Default,,0,0,0,,Аха, бұл арман маған сәл ауыр...
Dialogue: 0,0:06:57.18,0:06:58.61,Default,,0,0,0,,Жоқ! (Вилетта) Кірейік.
Dialogue: 0,0:06:58.71,0:07:02.45,Default,,0,0,0,,Не? Жарайды... бұл кішкене іштей... және он бір...
Dialogue: 0,0:07:02.55,0:07:03.99,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:07:04.09,0:07:05.12,Default,,0,0,0,,Біздің үй ашық!
Dialogue: 0,0:07:05.42,0:07:06.69,Default,,0,0,0,,Екеуің, асыға күтіңдер!
Dialogue: 0,0:07:06.79,0:07:08.76,Default,,0,0,0,,Ей...эй, қонағым!
Dialogue: 0,0:07:14.66,0:07:16.10,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:07:16.80,0:07:19.13,Default,,0,0,0,,Мен сені енді мектепке келмейсің деп ойладым.
Dialogue: 0,0:07:19.43,0:07:20.64,Default,,0,0,0,,Сонымен, әдейі?
Dialogue: 0,0:07:21.07,0:07:23.87,Default,,0,0,0,,Неге ешкімге айтпайсың? Менің шынайы болмысым...
Dialogue: 0,0:07:24.01,0:07:27.18,Default,,0,0,0,,Сіз қазір Карен Стадтфельдсіз, солай ма?
Dialogue: 0,0:07:27.48,0:07:28.68,Default,,0,0,0,,Карен Акацуки емес
Dialogue: 0,0:07:29.04,0:07:30.01,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:30.71,0:07:33.01,Default,,0,0,0,,Сіз мені жеңуге тырысасыз ба?
Dialogue: 0,0:07:33.11,0:07:35.58,Default,,0,0,0,,Майданда кездессек, мен саған оңайлықпен бармаймын.
Dialogue: 0,0:07:35.68,0:07:37.59,Default,,0,0,0,,Бірақ мен сізді көндіруді жалғастырғым келеді.
Dialogue: 0,0:07:38.09,0:07:40.86,Default,,0,0,0,,Мен бұл ережелерге қайшы екенін білемін, бірақ
Dialogue: 0,0:07:40.96,0:07:43.99,Default,,0,0,0,,Мектепте төбелескеннен гөрі сендіруді жақсы көремін.
Dialogue: 0,0:07:45.59,0:07:47.56,Default,,0,0,0,,Сізбен бір нәрсе өзгерді.
Dialogue: 0,0:07:47.66,0:07:48.70,Default,,0,0,0,,Ах! (Лелуш) Созаку
Dialogue: 0,0:07:48.80,0:07:50.10,Default,,0,0,0,,Жүк көлігі ірімшікпен келді...
Dialogue: 0,0:07:51.57,0:07:52.63,Default,,0,0,0,,Мектепте?
Dialogue: 0,0:07:52.73,0:07:54.00,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:07:54.10,0:07:55.67,Default,,0,0,0,,Мен де өзімді жақсы сезінбеймін.
Dialogue: 0,0:07:56.04,0:07:59.77,Default,,0,0,0,,Карен, бұрын болған оқиғаның мектепке еш қатысы жоқ.
Dialogue: 0,0:07:59.87,0:08:00.74,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:08:00.88,0:08:01.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:03.01,0:08:06.01,Default,,0,0,0,,Қарсы болмасаң, Карен, сабаққа бара аласың ба?
Dialogue: 0,0:08:06.11,0:08:07.75,Default,,0,0,0,,Қолдары жетпейтін сияқты.
Dialogue: 0,0:08:07.85,0:08:09.78,Default,,0,0,0,,Аа, егер бәрі осы болса ...
Dialogue: 0,0:08:09.88,0:08:11.72,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:08:11.82,0:08:13.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:14.22,0:08:17.23,Default,,0,0,0,,Ашуланбаңыз, бұл солай.
Dialogue: 0,0:08:17.73,0:08:19.59,Default,,0,0,0,,Қалай болғанда да, Лелуш...
Dialogue: 0,0:08:19.99,0:08:23.26,Default,,0,0,0,,Бұл қорқынышты үй болса, оны қорқынышты үй деп түсіндіріңіз.
Dialogue: 0,0:08:23.53,0:08:24.20,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:24.50,0:08:27.74,Default,,0,0,0,,Маған бұйрық бере алатын жалғыз адам - ​​Нөл.
Dialogue: 0,0:08:28.20,0:08:30.67,Default,,0,0,0,,Уау, тағы да жұп?
Dialogue: 0,0:08:30.77,0:08:34.74,Default,,0,0,0,,Егер сіз механиканы осындай жерде қолданғыңыз келсе, мұның бәрін жасауыңыз керек.
Dialogue: 0,0:08:34.84,0:08:39.05,Default,,0,0,0,,Бұл Глазгоның ерте үлгілері сияқты жеңіл, бірақ ыстық.
Dialogue: 0,0:08:39.15,0:08:41.55,Default,,0,0,0,,Тез... тез...
Dialogue: 0,0:08:42.02,0:08:43.08,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:08:43.15,0:08:44.62,Default,,0,0,0,,Ах! (жанкүйер) Уау!
Dialogue: 0,0:08:44.82,0:08:47.26,Default,,0,0,0,,Иә? Оуги мырза?
Dialogue: 0,0:08:48.29,0:08:51.13,Default,,0,0,0,,Не? Жақсы болды ма?
Dialogue: 0,0:08:51.83,0:08:52.99,Default,,0,0,0,,«Алдау?» Оны алдау үшін не істемексің?
Dialogue: 0,0:08:53.66,0:08:56.96,Default,,0,0,0,,Ехехехехехехехехехе қызық Мектеп мерекесі...
Dialogue: 0,0:08:57.80,0:08:59.00,Default,,0,0,0,,Уау (ер студент) Уау
Dialogue: 0,0:08:59.73,0:09:02.70,Default,,0,0,0,,Сіз нысанаға алынған Ллойд мырзаға ұқсамайсыз ба?
Dialogue: 0,0:09:02.80,0:09:04.91,Default,,0,0,0,,Саған тек оның қамқорлығы болса...
Dialogue: 0,0:09:05.01,0:09:05.97,Default,,0,0,0,,Бұл қатыгездік болды.
Dialogue: 0,0:09:06.11,0:09:08.21,Default,,0,0,0,,Иә, пицца түстен кейін беріледі.
Dialogue: 0,0:09:08.31,0:09:08.94,Default,,0,0,0,,Хмм, қазір мұндай нәрсені жасайтын уақыт емес.
Dialogue: 0,0:09:08.94,0:09:11.78,Default,,0,0,0,,Хм, қазір мұндай нәрсені жасайтын уақыт емес.
Dialogue: 0,0:09:08.94,0:09:11.78,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:09:11.88,0:09:12.88,Default,,0,0,0,,Иә
Dialogue: 0,0:09:13.01,0:09:14.55,Default,,0,0,0,,Драма клубы?
Dialogue: 0,0:09:14.78,0:09:16.22,Default,,0,0,0,,Мен EIKEN-мен сөйлесіп қойғанмын.
Dialogue: 0,0:09:16.32,0:09:17.18,Default,,0,0,0,,(Ұялы телефонның өшіп тұрған дыбысы)
Dialogue: 0,0:09:17.72,0:09:19.32,Default,,0,0,0,,Қазір төңкеріске дайындық...
Dialogue: 0,0:09:19.62,0:09:20.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:21.22,0:09:23.72,Default,,0,0,0,,Кешіріңіз! Тұтқаны сынып қалды
Dialogue: 0,0:09:23.89,0:09:25.13,Default,,0,0,0,,Тіпті әскери қызметкерлер-
Dialogue: 0,0:09:25.23,0:09:26.59,Default,,0,0,0,,Бұл өте тыныш.
Dialogue: 0,0:09:26.79,0:09:28.96,Default,,0,0,0,,О? Сен, Созаку...
Dialogue: 0,0:09:29.06,0:09:30.77,Default,,0,0,0,,Эй, сен бе?
Dialogue: 0,0:09:30.87,0:09:34.00,Default,,0,0,0,,Әлемдегі ең жақсы пиццаны қайдан алуға болады?
Dialogue: 0,0:09:34.10,0:09:35.00,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:35.10,0:09:36.67,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:09:37.77,0:09:40.21,Default,,0,0,0,,Жарайсың, түнде 18-аймақтан.
Dialogue: 0,0:09:40.31,0:09:42.18,Default,,0,0,0,,Корнелияның әскері тамаша.
Dialogue: 0,0:09:42.28,0:09:43.84,Default,,0,0,0,,Төтенше
Dialogue: 0,0:09:43.95,0:09:47.92,Default,,0,0,0,,Себебі ағам менің орныма өзінің тұрақты әскерін жіберді.
Dialogue: 0,0:09:48.32,0:09:50.05,Default,,0,0,0,,Бұл өте анық.
Dialogue: 0,0:09:50.35,0:09:53.29,Default,,0,0,0,,Өз елінде күтіп тұрған Гластон Найтстары да бізге қосылды.
Dialogue: 0,0:09:53.59,0:09:56.96,Default,,0,0,0,,Біздің армия қазір қандай болуы керек.
Dialogue: 0,0:09:57.16,0:09:59.19,Default,,0,0,0,,Сондай-ақ Глостерде Sattelbuffet бар.
Dialogue: 0,0:09:59.66,0:10:00.90,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:10:01.00,0:10:04.60,Default,,0,0,0,,Сол картаны Қытай Федерациясымен келіссөздерде қолданайық.
Dialogue: 0,0:10:04.70,0:10:05.90,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:06.00,0:10:07.74,Default,,0,0,0,,Бұл құрмет (Корнелия) Иә?
Dialogue: 0,0:10:07.84,0:10:10.67,Default,,0,0,0,,Ұрыс даласында Корнелия ханшайымының теңдесі жоқ...
Dialogue: 0,0:10:10.77,0:10:12.74,Default,,0,0,0,,Мұны сұрағаныңызға сене алар емеспін.
Dialogue: 0,0:10:12.84,0:10:14.21,Default,,0,0,0,,Мазаламау
Dialogue: 0,0:10:14.61,0:10:15.71,Default,,0,0,0,,Шындық
Dialogue: 0,0:10:15.81,0:10:19.18,Default,,0,0,0,,Сіз шайқас алаңындағы кез келген гүлден де, балдағы көбелектен де жақсысыз.
Dialogue: 0,0:10:19.28,0:10:21.08,Default,,0,0,0,,Ол әдемі жарқырап тұр
Dialogue: 0,0:10:21.18,0:10:23.02,Default,,0,0,0,,Иә, жарқыл сияқты.
Dialogue: 0,0:10:23.12,0:10:24.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:24.72,0:10:27.29,Default,,0,0,0,,Тоқташы, сен мен сияқтысың...
Dialogue: 0,0:10:27.39,0:10:29.69,Default,,0,0,0,,Юффи қайда кетті?
Dialogue: 0,0:10:29.79,0:10:31.76,Default,,0,0,0,,Менің ағам кетіп бара жатса да
Dialogue: 0,0:10:31.89,0:10:34.30,Default,,0,0,0,,Мен Юффимен сөйлестім.
Dialogue: 0,0:10:34.40,0:10:36.26,Default,,0,0,0,,Юбе? Иә-
Dialogue: 0,0:10:36.63,0:10:39.40,Default,,0,0,0,,О, бұл мәселені Батли басқарады.
Dialogue: 0,0:10:39.70,0:10:41.70,Default,,0,0,0,,О, мен қарсы емеспін.
Dialogue: 0,0:10:41.80,0:10:43.67,Default,,0,0,0,,Бұл шынымен де пайдалану құндылығы бар ма?
Dialogue: 0,0:10:47.31,0:10:49.78,Default,,0,0,0,,Сонымен әлемдегі ең жақсы пицца...
Dialogue: 0,0:10:49.88,0:10:51.75,Default,,0,0,0,,Мен оны өзіңізбен бірге алып кетемін, сондықтан бөлмеңізге барыңыз.
Dialogue: 0,0:10:51.85,0:10:53.35,Default,,0,0,0,,Өйткені сен өтірікшісің
Dialogue: 0,0:10:53.65,0:10:55.92,Default,,0,0,0,,Мұндай айла-амалдарды қолданбаңыз.
Dialogue: 0,0:10:56.02,0:10:58.95,Default,,0,0,0,,Әскери қызметкерлер мен бұқаралық ақпарат құралдары бар. Олар табылса не істейсің?
Dialogue: 0,0:10:59.15,0:11:01.96,Default,,0,0,0,,Ең жақсысы жаңа пісірілген. Бетперделеу құралдарын әкеліңіз.
Dialogue: 0,0:11:02.12,0:11:04.96,Default,,0,0,0,,Дәл қазір мен мектеп фестиваліне және мемлекеттік төңкеріске жауаптымын...
Dialogue: 0,0:11:05.06,0:11:05.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:06.06,0:11:07.90,Default,,0,0,0,,Неліктен мектеп ішінде?
Dialogue: 0,0:11:08.00,0:11:09.36,Default,,0,0,0,,Ах... мен...
Dialogue: 0,0:11:09.66,0:11:11.03,Default,,0,0,0,,Сіз кімсіз?сен
Dialogue: 0,0:11:11.37,0:11:13.83,Default,,0,0,0,,Қазір он бір емес, солай ма? Сенің атың кім?
Dialogue: 0,0:11:13.93,0:11:15.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:16.34,0:11:18.07,Default,,0,0,0,,Бұл адам...
Dialogue: 0,0:11:18.41,0:11:19.41,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,0:11:20.31,0:11:21.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:21.28,0:11:23.34,Default,,0,0,0,,Карен? Бұл қатысы барлардан басқалардың барлығына арналған.
Dialogue: 0,0:11:23.41,0:11:25.08,Default,,0,0,0,,Кіруге тыйым салынған, сыртқа асығыңыз...
Dialogue: 0,0:11:25.28,0:11:26.41,Default,,0,0,0,,Жанкүйер!
Dialogue: 0,0:11:29.35,0:11:30.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:30.68,0:11:33.15,Default,,0,0,0,,Мен Сузакумен бір нәрсе туралы сөйлескім келеді...
Dialogue: 0,0:11:33.25,0:11:34.19,Default,,0,0,0,,О... жоқ
Dialogue: 0,0:11:35.42,0:11:38.33,Default,,0,0,0,,Юффи Менің ойымша, бұл идея керемет.
Dialogue: 0,0:11:38.39,0:11:39.99,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:11:40.09,0:11:42.86,Default,,0,0,0,,Сен сенген жолмен жүру керек.
Dialogue: 0,0:11:43.46,0:11:45.70,Default,,0,0,0,,Мен Корнелияға айтамын.
Dialogue: 0,0:11:46.33,0:11:47.47,Default,,0,0,0,,Созаку
Dialogue: 0,0:11:47.77,0:11:50.77,Default,,0,0,0,,Оны ағам мақұлдады, енді...
Dialogue: 0,0:11:50.87,0:11:52.21,Default,,0,0,0,,Ах! (Айналайын) А...
Dialogue: 0,0:11:52.37,0:11:54.48,Default,,0,0,0,,Кешіріңіз. Сенімен бәрі жақсы ма?
Dialogue: 0,0:11:54.78,0:11:56.21,Default,,0,0,0,,Оң қолымен теңдеулерді шешіп отыр
Dialogue: 0,0:11:56.31,0:11:58.11,Default,,0,0,0,,Әй?Нуннал?
Dialogue: 0,0:11:58.21,0:11:59.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:59.31,0:12:01.08,Default,,0,0,0,,Мен бұл дауысты ешқашан күтпедім...
Dialogue: 0,0:12:06.42,0:12:09.29,Default,,0,0,0,,Уф... Енді мен Оги-санды көрдім...
Dialogue: 0,0:12:09.49,0:12:11.49,Default,,0,0,0,,Нашар Егер сіз C.C. мұнда...
Dialogue: 0,0:12:11.49,0:12:12.16,Default,,0,0,0,,Нашар Егер сіз C.C. мұнда...
Dialogue: 0,0:12:11.49,0:12:12.16,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:12.16,0:12:12.26,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:12.26,0:12:13.13,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:12.26,0:12:13.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:13.26,0:12:15.23,Default,,0,0,0,,Бұл оттық цилиндрі, солай ма? ―
Dialogue: 0,0:12:15.33,0:12:17.26,Default,,0,0,0,,Мен қосалқы заттың артында тұрғанына сенімдімін...
Dialogue: 0,0:12:17.36,0:12:18.77,Default,,0,0,0,,Иә? (Шерли) Карен?
Dialogue: 0,0:12:18.87,0:12:21.04,Default,,0,0,0,,А... у... Сәлем.
Dialogue: 0,0:12:21.40,0:12:24.87,Default,,0,0,0,,Онда сізде қосалқы баллон бар ма?Қарсылас іздейді...
Dialogue: 0,0:12:24.94,0:12:26.94,Default,,0,0,0,,А... Менің ойымша, бұл басқа жақта?
Dialogue: 0,0:12:27.04,0:12:28.24,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:28.34,0:12:30.04,Default,,0,0,0,,Өте қиын...
Dialogue: 0,0:12:30.14,0:12:31.95,Default,,0,0,0,,Сіз Geass пайдалана аласыз, солай ма?
Dialogue: 0,0:12:32.21,0:12:33.88,Default,,0,0,0,,Жанкүйерді түсінбейтіндерге...
Dialogue: 0,0:12:33.98,0:12:35.78,Default,,0,0,0,,Пайдалану қауіпті
Dialogue: 0,0:12:35.85,0:12:38.35,Default,,0,0,0,,Ал басқа мүшелер қолданылған.
Dialogue: 0,0:12:38.85,0:12:41.26,Default,,0,0,0,,Бұл менің кінәм, өйткені мен оны оңай пайдаланамын.
Dialogue: 0,0:12:41.36,0:12:43.99,Default,,0,0,0,,Сіз... қазіргі жағдай! (Шерли) Лелуч?
Dialogue: 0,0:12:44.09,0:12:45.96,Default,,0,0,0,,Ах! (Шерли) Сіз сондасыз ба?
Dialogue: 0,0:12:46.06,0:12:47.90,Default,,0,0,0,,Олай болса мен бір нәрсе туралы айтқым келеді...
Dialogue: 0,0:12:48.13,0:12:50.46,Default,,0,0,0,,Әзірше қашып кет.
Dialogue: 0,0:12:50.80,0:12:52.53,Default,,0,0,0,,Ширли, мүмкін кейінірек?
Dialogue: 0,0:12:53.10,0:12:55.47,Default,,0,0,0,,Мен шу шығарамын...
Dialogue: 0,0:12:55.54,0:12:57.17,Default,,0,0,0,,Не, енді...?
Dialogue: 0,0:12:57.27,0:12:59.21,Default,,0,0,0,,Осындай уақытта болмаса да, кездесе алмаймыз.
Dialogue: 0,0:12:59.34,0:13:00.77,Default,,0,0,0,,Ах! (Сузаку Ширли) А?
Dialogue: 0,0:13:01.11,0:13:02.18,Default,,0,0,0,,Қатты!Панель!
Dialogue: 0,0:13:02.48,0:13:04.18,Default,,0,0,0,,Қаш! (Шерли) О, менің!
Dialogue: 0,0:13:04.28,0:13:06.51,Default,,0,0,0,,Міне! Онда қатып қалмаңыз! (Лелуш) Ширли! ―
Dialogue: 0,0:13:06.81,0:13:07.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:09.25,0:13:11.25,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:13:17.83,0:13:19.29,Default,,0,0,0,,Ах... м...
Dialogue: 0,0:13:19.56,0:13:20.83,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:20.93,0:13:22.43,Default,,0,0,0,,Егер бәрі жақсы болса...
Dialogue: 0,0:13:22.53,0:13:24.06,Default,,0,0,0,,Бірақ бұл түтін ше?
Dialogue: 0,0:13:24.17,0:13:27.97,Default,,0,0,0,,Бұл газдың ағып кетуін анықтауға арналған болуы мүмкін. Клапан босап қалған сияқты.
Dialogue: 0,0:13:28.07,0:13:31.34,Default,,0,0,0,,Оның орнына біреу маған көмектесе алады ма?
Dialogue: 0,0:13:31.44,0:13:33.31,Default,,0,0,0,,Не болды? Менің аяғымда -
Dialogue: 0,0:13:33.41,0:13:35.28,Default,,0,0,0,,Таныс сезім
Dialogue: 0,0:13:35.41,0:13:38.31,Default,,0,0,0,,Сізді біртүрлі нәрсеге түсіргенім үшін кешіріңіз.
Dialogue: 0,0:13:38.41,0:13:40.48,Default,,0,0,0,,Жоқ, бұл қызықты болды.
Dialogue: 0,0:13:41.35,0:13:43.58,Default,,0,0,0,,Мен бұлай толқып жүргеніме біраз болды.
Dialogue: 0,0:13:46.55,0:13:48.89,Default,,0,0,0,,Сіз шыққыңыз келе ме?аудан 11
Dialogue: 0,0:13:48.99,0:13:51.86,Default,,0,0,0,,Осылайша сізді атқан адам артыңыздан келмейді.
Dialogue: 0,0:13:52.26,0:13:55.03,Default,,0,0,0,,Оги-сан, мен бұрын болған мен...
Dialogue: 0,0:13:55.13,0:13:57.93,Default,,0,0,0,,Сіз қазіргіден бақытты болдыңыз ба?
Dialogue: 0,0:13:58.10,0:13:59.83,Default,,0,0,0,,Сонымен... (жанкүйер) Иә?
Dialogue: 0,0:14:00.43,0:14:04.27,Default,,0,0,0,,Бұрын айтқаныңызды жалғастыра аласыз ба?
Dialogue: 0,0:14:04.41,0:14:05.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:06.17,0:14:09.94,Default,,0,0,0,,«Бұл адам менікі...» Не?
Dialogue: 0,0:14:10.18,0:14:12.51,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:14:12.91,0:14:16.45,Default,,0,0,0,,Мен он бір бола аламын.
Dialogue: 0,0:14:20.02,0:14:21.96,Default,,0,0,0,,Өтінемін, тыныш отыра аласыз ба?
Dialogue: 0,0:14:22.06,0:14:23.99,Default,,0,0,0,,Мен және ағам туралы...
Dialogue: 0,0:14:24.23,0:14:25.99,Default,,0,0,0,,Бірақ бұл осылай қала берсе...
Dialogue: 0,0:14:26.09,0:14:29.30,Default,,0,0,0,,Мен сенімен бірге болғанша, маған керегі осы...
Dialogue: 0,0:14:29.60,0:14:31.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:32.53,0:14:36.24,Default,,0,0,0,,Екеуіңіздің сол кезде төбелескеніңіз есіңізде ме?
Dialogue: 0,0:14:36.34,0:14:39.07,Default,,0,0,0,,Қайсысы ағаңның әйелі болады?
Dialogue: 0,0:14:39.54,0:14:40.94,Default,,0,0,0,,Соңғы үш күнде, әдеттегідей, әр түнде түн ортасынан кейін бір бет.
Dialogue: 0,0:14:41.04,0:14:44.48,Default,,0,0,0,,Сіз Лелуштан бүгін кешке қайсысымен жүру керектігін шешуді сұрадыңыз.
Dialogue: 0,0:14:44.58,0:14:46.15,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:14:46.25,0:14:48.05,Default,,0,0,0,,Енді? (Эфемия) А?
Dialogue: 0,0:14:48.92,0:14:51.25,Default,,0,0,0,,Сіздің ағаңыз әлі бар ма?
Dialogue: 0,0:14:55.16,0:14:57.42,Default,,0,0,0,,Келіңіздер! жақын арада! ―
Dialogue: 0,0:14:57.52,0:14:59.49,Default,,0,0,0,,Жақында! ―
Dialogue: 0,0:14:59.59,0:15:01.90,Default,,0,0,0,,Әлемдегі ең жақсы пиццаны жасаңыз! ―
Dialogue: 0,0:15:02.00,0:15:04.43,Default,,0,0,0,,Айтпақшы, менің аяғымда не күтіп тұр...
Dialogue: 0,0:15:04.53,0:15:07.17,Default,,0,0,0,,Бұл дәл осы жағдайға арналған арнайы пеш! ―
Dialogue: 0,0:15:07.27,0:15:08.67,Default,,0,0,0,,Бюджетті ысырап ету
Dialogue: 0,0:15:09.10,0:15:12.44,Default,,0,0,0,,Мен білемін, Ширли, мен оған уақыт табамын.
Dialogue: 0,0:15:12.54,0:15:15.01,Default,,0,0,0,,Сондықтан сахнада маған көмектесу үшін Биханы пайдаландым.
Dialogue: 0,0:15:15.54,0:15:17.11,Default,,0,0,0,,Иә (телефонды қою дыбысы)
Dialogue: 0,0:15:17.65,0:15:19.95,Default,,0,0,0,,Хмм, қандай жеңіл...
Dialogue: 0,0:15:20.28,0:15:23.62,Default,,0,0,0,,Қателессең де ешкім өлмейді.
Dialogue: 0,0:15:24.62,0:15:25.65,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:15:25.95,0:15:27.62,Default,,0,0,0,,Уақытында келемін деп ойламайсыз ба?
Dialogue: 0,0:15:27.92,0:15:30.22,Default,,0,0,0,,Жақында мен адамдарды қалай пайдалану керектігін білдім.
Dialogue: 0,0:15:30.52,0:15:32.63,Default,,0,0,0,,Бірақ барлығының көңіл-күйлері жақсы.
Dialogue: 0,0:15:33.56,0:15:37.03,Default,,0,0,0,,Қытай Федерациясы жақында ғана шабуыл жасаған болса да.
Dialogue: 0,0:15:37.23,0:15:38.63,Default,,0,0,0,,Сондықтан емес (Лелух) Иә?
Dialogue: 0,0:15:39.13,0:15:43.57,Default,,0,0,0,,Фестиваль әркімге, кез келген уақытта қажет...
Dialogue: 0,0:15:43.67,0:15:45.17,Default,,0,0,0,,Сізде әлі көп жол бар.
Dialogue: 0,0:15:45.27,0:15:47.64,Default,,0,0,0,,А, мен көп нәрсені үйрендім.
Dialogue: 0,0:15:47.94,0:15:49.94,Default,,0,0,0,,Үлкен аға (Лелуч) Нунналли пицца...
Dialogue: 0,0:15:50.04,0:15:50.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:53.41,0:15:55.22,Default,,0,0,0,,Бір сәт кешіріңіз...
Dialogue: 0,0:15:55.32,0:15:57.72,Default,,0,0,0,,Егер бірдеңе болса, маған хабарласыңыз.
Dialogue: 0,0:15:58.02,0:16:00.62,Default,,0,0,0,,Материалдар дайын сияқты! ―
Dialogue: 0,0:16:00.69,0:16:02.72,Default,,0,0,0,,Енді таныстырайық! ―
Dialogue: 0,0:16:03.02,0:16:05.46,Default,,0,0,0,,Flying - Эшфорд отбасынан шыққан Ганимед!
Dialogue: 0,0:16:05.59,0:16:06.69,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:16:06.99,0:16:09.30,Default,,0,0,0,,Бұл жеткілікті классикалық...
Dialogue: 0,0:16:09.40,0:16:10.26,Default,,0,0,0,,Бірақ! ―
Dialogue: 0,0:16:10.36,0:16:13.13,Default,,0,0,0,,Ұшқыш менің студенттік кеңесімнің тәртіптік комитеті болады.
Dialogue: 0,0:16:13.23,0:16:14.47,Default,,0,0,0,,Жоғары мәртебелі рыцарь Эфемия! ―
Dialogue: 0,0:16:14.57,0:16:17.10,Default,,0,0,0,,Сузаку Куруруги!
Dialogue: 0,0:16:17.30,0:16:19.44,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:16:19.64,0:16:21.61,Default,,0,0,0,,Иә?Мүмкін?
Dialogue: 0,0:16:21.71,0:16:24.48,Default,,0,0,0,,Иә, көптеген он бірлер де келеді.
Dialogue: 0,0:16:24.58,0:16:27.98,Default,,0,0,0,,Бұл ашық мектеп фестивалі және Созаку-санның мектебі осында.
Dialogue: 0,0:16:28.08,0:16:30.02,Default,,0,0,0,,Барлығы осы ма? (Сакиоко) Иә...
Dialogue: 0,0:16:30.12,0:16:33.22,Default,,0,0,0,,Созаку-сан, бұл он бірдің үміт жұлдызы, солай ма?
Dialogue: 0,0:16:34.19,0:16:35.16,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:16:35.26,0:16:38.16,Default,,0,0,0,,Үшінші буын кошмар Ганимед
Dialogue: 0,0:16:38.26,0:16:41.13,Default,,0,0,0,,Бұл Flash-тен Марианна пайдаланған машина емес пе?
Dialogue: 0,0:16:41.46,0:16:45.10,Default,,0,0,0,,Тек негізгі жақтау. Бұл оқиғаға арналған қуыршақ.
Dialogue: 0,0:16:45.20,0:16:50.50,Default,,0,0,0,,Марианнаның кетуіне байланысты келесі ұрпақ жарысынан шығарылған еретикалық машина.
Dialogue: 0,0:16:50.60,0:16:53.17,Default,,0,0,0,,Некенің мақсаты осы болды ма?
Dialogue: 0,0:16:53.27,0:16:54.58,Default,,0,0,0,,Түсінді ме?
Dialogue: 0,0:16:54.68,0:16:57.41,Default,,0,0,0,,Бұл адамның қарама-қарсы жынысты болу сезімі жоқ.
Dialogue: 0,0:16:57.51,0:17:00.78,Default,,0,0,0,,Бұл ұят. Мен тұжырымдаманы білемін.
Dialogue: 0,0:17:01.08,0:17:01.42,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:17:01.42,0:17:03.32,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:17:01.42,0:17:03.32,Default,,0,0,0,,Керемет! ―
Dialogue: 0,0:17:03.38,0:17:05.35,Default,,0,0,0,,Сіз оны қаншалықты үлкен етіп жасай аласыз! ―
Dialogue: 0,0:17:05.45,0:17:07.69,Default,,0,0,0,,Сузаку-кун, мен оны асыға күтемін!
Dialogue: 0,0:17:08.12,0:17:12.13,Default,,0,0,0,,Бұл менің былтырғы рөлім болды, бірақ бұл менің нақты жұмысыма сәйкес келмейді.
Dialogue: 0,0:17:12.33,0:17:14.46,Default,,0,0,0,,Бүгінгі күн тосын сыйларға толы
Dialogue: 0,0:17:14.56,0:17:17.33,Default,,0,0,0,,Лелуч пен Нанналли өте жақын
Dialogue: 0,0:17:17.43,0:17:19.60,Default,,0,0,0,,Және ол Созакудың досы болды.
Dialogue: 0,0:17:20.23,0:17:22.14,Default,,0,0,0,,Сіз не істеп жатырсыз?сол адам
Dialogue: 0,0:17:22.80,0:17:25.34,Default,,0,0,0,,Қызым, қазір жалықтыратын уақыт емес!
Dialogue: 0,0:17:25.47,0:17:28.64,Default,,0,0,0,,Мен барлығының бақытты болғанын қаламаймын.
Dialogue: 0,0:17:28.74,0:17:31.15,Default,,0,0,0,,Бірақ бүгін біз соңғы рет кездесеміз.
Dialogue: 0,0:17:31.25,0:17:33.51,Default,,0,0,0,,Жоқ, мен жақсырақ жол таптым.
Dialogue: 0,0:17:33.61,0:17:35.35,Default,,0,0,0,,Леру... Ух...
Dialogue: 0,0:17:35.72,0:17:36.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:40.35,0:17:42.39,Default,,0,0,0,,Не? Эфемия ханым?
Dialogue: 0,0:17:42.66,0:17:44.69,Default,,0,0,0,,О? (Оқушы қыз) Эфемия-сама деген кім?
Dialogue: 0,0:17:44.79,0:17:46.33,Default,,0,0,0,,Әй?не болды?
Dialogue: 0,0:17:46.43,0:17:47.29,Default,,0,0,0,,Бұл сол ма?
Dialogue: 0,0:17:47.39,0:17:49.20,Default,,0,0,0,,Бұл рас! Бұл Эфемия!
Dialogue: 0,0:17:49.30,0:17:50.53,Default,,0,0,0,,Эфемия-сама?
Dialogue: 0,0:17:50.66,0:17:52.37,Default,,0,0,0,,Лелуш!Ерекше!
Dialogue: 0,0:17:52.47,0:17:53.63,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге мұны істеуге рұқсат етемін!
Dialogue: 0,0:17:53.73,0:17:56.40,Default,,0,0,0,,Әй, лейтенант-губернатор басты кіреберістің қасында тұрған сияқты.
Dialogue: 0,0:17:56.60,0:17:58.64,Default,,0,0,0,,Жарайды, мен күту тобын да ұйымдастырамын.
Dialogue: 0,0:17:58.74,0:18:00.54,Default,,0,0,0,,Оны камера студиясына қосыңыз!
Dialogue: 0,0:18:00.64,0:18:01.51,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:18:01.61,0:18:02.74,Default,,0,0,0,,Леди Эфемия келе жатыр.
Dialogue: 0,0:18:02.84,0:18:03.71,Default,,0,0,0,,Өтірік? Неліктен?
Dialogue: 0,0:18:03.81,0:18:05.35,Default,,0,0,0,,Қайда?сен қайдасың?
Dialogue: 0,0:18:05.51,0:18:08.68,Default,,0,0,0,,Қауіпті! Жүгірме! Ол құлаған кезде...
Dialogue: 0,0:18:09.45,0:18:10.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:13.29,0:18:14.32,Default,,0,0,0,,Ах! ―
Dialogue: 0,0:18:17.76,0:18:18.63,Default,,0,0,0,,Пицца…
Dialogue: 0,0:18:19.16,0:18:21.56,Default,,0,0,0,,Мен мұны кәсіпқойларға тапсыруым керек пе еді?
Dialogue: 0,0:18:21.66,0:18:25.13,Default,,0,0,0,,Мүмкін бұл бас тартуды білдіреді. Әртүрлі заттар.
Dialogue: 0,0:18:25.23,0:18:26.27,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:27.50,0:18:28.70,Default,,0,0,0,,Уайымдамаңыз! ―
Dialogue: 0,0:18:29.14,0:18:30.47,Default,,0,0,0,,Сіз не істеп жатырсыз? ―
Dialogue: 0,0:18:30.57,0:18:33.54,Default,,0,0,0,,Басқа адам - ​​губернатордың орынбасары және оның ұлы мәртебелі Үшінші ханшайым!
Dialogue: 0,0:18:34.21,0:18:36.54,Default,,0,0,0,,Ынтымақтастық үшін рахмет. Қалғанын өзіміз шешеміз.
Dialogue: 0,0:18:36.64,0:18:38.28,Default,,0,0,0,,Ах! (Репортер) Бұл Сәлем ТВ!
Dialogue: 0,0:18:38.38,0:18:39.78,Default,,0,0,0,,Бір сөз!Тіпті бір ауыз сөз!
Dialogue: 0,0:18:40.28,0:18:42.85,Default,,0,0,0,,Құрметті Эфемия! Бұл Нина! Осы жерден паналаңыз...
Dialogue: 0,0:18:43.15,0:18:44.32,Default,,0,0,0,,Уф... иә
Dialogue: 0,0:18:44.45,0:18:46.49,Default,,0,0,0,,Бұл... бұл біраз...
Dialogue: 0,0:18:46.59,0:18:48.42,Default,,0,0,0,,Ақыл-есіңді сақта.
Dialogue: 0,0:18:51.46,0:18:52.79,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:52.89,0:18:57.23,Default,,0,0,0,,Жоқ, егер сіз өз бетіңізше қашып құтыла алсаңыз, бұл жақсы идея, командирдің орынбасары.
Dialogue: 0,0:18:57.33,0:18:58.63,Default,,0,0,0,,Бұл әлі
Dialogue: 0,0:18:58.73,0:19:00.47,Default,,0,0,0,,Иә (дыбысты қою)
Dialogue: 0,0:19:00.57,0:19:03.30,Default,,0,0,0,,Релелік фургондағы жабдық орны босқа кетті.
Dialogue: 0,0:19:03.64,0:19:06.44,Default,,0,0,0,,Енді нөлдік дивизия капитанының қашуының қажеті жоқ.
Dialogue: 0,0:19:06.54,0:19:07.67,Default,,0,0,0,,Бірақ сіз үшін...
Dialogue: 0,0:19:07.77,0:19:10.68,Default,,0,0,0,,Құпия ретінде Концессияда қалуыңызды қалаймын.
Dialogue: 0,0:19:10.78,0:19:12.71,Default,,0,0,0,,Мен сізді нөлмен таныстырамын.
Dialogue: 0,0:19:12.81,0:19:14.15,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:19:14.25,0:19:15.88,Default,,0,0,0,,Не? (Бәсекелес) Жоқ
Dialogue: 0,0:19:16.75,0:19:18.45,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:19:18.82,0:19:20.65,Default,,0,0,0,,Жақсысың ба? Құрметті Эфемия
Dialogue: 0,0:19:20.82,0:19:21.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:21.79,0:19:23.16,Default,,0,0,0,,Рахмет сізге Сузаку
Dialogue: 0,0:19:23.76,0:19:26.39,Default,,0,0,0,,Амансың ба? Nunnally (Nunally) Иә.
Dialogue: 0,0:19:26.49,0:19:27.79,Default,,0,0,0,,Юффи апа ше?
Dialogue: 0,0:19:27.90,0:19:29.80,Default,,0,0,0,,Сіз қауіпсізсіз. Созаку сені құтқарды.
Dialogue: 0,0:19:29.90,0:19:31.70,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:31.80,0:19:33.90,Default,,0,0,0,,Әй, аға (Лелух), иә?
Dialogue: 0,0:19:34.20,0:19:38.24,Default,,0,0,0,,Юффи апа: Мен Сузаку-санмен жақсы болғанын естідім.
Dialogue: 0,0:19:38.34,0:19:39.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:39.84,0:19:42.91,Default,,0,0,0,,Екеуің бірге жақсы көрінесіңдер...
Dialogue: 0,0:19:43.21,0:19:45.31,Default,,0,0,0,,Сіз...
Dialogue: 0,0:19:45.45,0:19:46.58,Default,,0,0,0,,Қу!
Dialogue: 0,0:19:51.19,0:19:51.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:53.62,0:19:55.59,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:19:55.92,0:19:59.19,Default,,0,0,0,,Құрметті Эфемия!Пікір қалдырыңыз!
Dialogue: 0,0:19:59.29,0:20:02.50,Default,,0,0,0,,Бұл бейнені бүкіл аймаққа қоса аласыз ба?
Dialogue: 0,0:20:02.60,0:20:03.96,Default,,0,0,0,,Не?Тікелей ме?
Dialogue: 0,0:20:04.26,0:20:05.27,Default,,0,0,0,,Юффи?
Dialogue: 0,0:20:05.37,0:20:07.20,Default,,0,0,0,,Бізде маңызды хабарландыру бар!
Dialogue: 0,0:20:07.30,0:20:08.20,Default,,0,0,0,,Хмм?
Dialogue: 0,0:20:08.30,0:20:10.44,Default,,0,0,0,,Мәртебелі! Эфемия-сама!
Dialogue: 0,0:20:10.54,0:20:12.37,Default,,0,0,0,,Тағы бірдеңе жасадыңыз ба?
Dialogue: 0,0:20:12.74,0:20:13.91,Default,,0,0,0,,Төтенше релеге ауысыңыз
Dialogue: 0,0:20:14.94,0:20:16.68,Default,,0,0,0,,Қасиетті Британ империясы
Dialogue: 0,0:20:16.78,0:20:19.38,Default,,0,0,0,,Бұл Эфемия, 11-аймақ губернаторының орынбасары.
Dialogue: 0,0:20:20.25,0:20:23.75,Default,,0,0,0,,Бүгін мен сізге бір нәрсе айтқым келеді.
Dialogue: 0,0:20:23.85,0:20:27.22,Default,,0,0,0,,Не?Кішкентай қыз асыра айтып отыр
Dialogue: 0,0:20:27.59,0:20:29.99,Default,,0,0,0,,I, Euphemia li Britannia,
Dialogue: 0,0:20:30.29,0:20:34.33,Default,,0,0,0,,Фудзисан төңірегінде Жапонияның арнайы әкімшілік аймағын құру
Dialogue: 0,0:20:34.43,0:20:35.60,Default,,0,0,0,,Біз мәлімдейміз!
Dialogue: 0,0:20:35.80,0:20:37.43,Default,,0,0,0,,Не?Британия?
Dialogue: 0,0:20:37.83,0:20:39.90,Default,,0,0,0,,Сіз Жапонияны танисыз ба?
Dialogue: 0,0:20:40.27,0:20:43.27,Default,,0,0,0,,Жоқ!Сізде бұл қол болды ма?
Dialogue: 0,0:20:43.37,0:20:44.94,Default,,0,0,0,,Оның аймақтық шектеулері болса да...
Dialogue: 0,0:20:45.47,0:20:47.47,Default,,0,0,0,,Жапониядағы бұл арнайы әкімшілік аймақ-
Dialogue: 0,0:20:47.61,0:20:51.58,Default,,0,0,0,,Он бір өзінің жапондық атын қайтарады.
Dialogue: 0,0:20:52.35,0:20:55.42,Default,,0,0,0,,11 ережелері және британдықтардың артықшылықтары...
Dialogue: 0,0:20:55.75,0:20:57.68,Default,,0,0,0,,Арнайы аймақ Жапонияда жоқ.
Dialogue: 0,0:20:58.42,0:21:00.49,Default,,0,0,0,,Британдықтар да, он бір...
Dialogue: 0,0:21:01.26,0:21:02.99,Default,,0,0,0,,Бұл теңдік әлемі!
Dialogue: 0,0:21:03.29,0:21:05.93,Default,,0,0,0,,Тоқта, Юффи, мен бұл істі ойладым.
Dialogue: 0,0:21:06.03,0:21:08.70,Default,,0,0,0,,Бірақ... бұл жай ғана арман.
Dialogue: 0,0:21:08.80,0:21:10.40,Default,,0,0,0,,Сіз мені ести аласыз ба?нөл!
Dialogue: 0,0:21:10.50,0:21:11.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:11.83,0:21:16.00,Default,,0,0,0,,Маған сіздің өткеніңіз немесе бұл масканың астында не жатқаны маңызды емес.
Dialogue: 0,0:21:16.30,0:21:19.51,Default,,0,0,0,,Сондықтан Жапониядағы арнайы аймақ ретінде бізге қосылыңыз.
Dialogue: 0,0:21:19.61,0:21:21.28,Default,,0,0,0,,Нөл? (Ер студент) Мүмкін емес...
Dialogue: 0,0:21:21.38,0:21:22.61,Default,,0,0,0,,Мәртебелі Хловиспен не болады?
Dialogue: 0,0:21:22.84,0:21:24.71,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:21:24.88,0:21:26.78,Default,,0,0,0,,Менімен нөл-
Dialogue: 0,0:21:26.88,0:21:29.68,Default,,0,0,0,,Британияда жаңа болашақты құрайық!
Dialogue: 0,0:21:29.78,0:21:32.72,Default,,0,0,0,,Құрметті Эфемия, Банзай!
Dialogue: 0,0:21:33.72,0:21:34.96,Default,,0,0,0,,Тіпті жапондықтар
Dialogue: 0,0:21:35.06,0:21:35.96,Default,,0,0,0,,Қазір тым кеш пе?
Dialogue: 0,0:21:36.06,0:21:38.33,Default,,0,0,0,,Қарашы, Он бір менің сүйіктім.
Dialogue: 0,0:21:38.79,0:21:40.39,Default,,0,0,0,,Мен жеңілдім! ―
Dialogue: 0,0:21:40.49,0:21:43.46,Default,,0,0,0,,Бұл жағдайда қай опцияны таңдасаңыз да, Қара рыцарьлар талқандалады.
Dialogue: 0,0:21:43.86,0:21:45.57,Default,,0,0,0,,Болмыстың мәні жойылады.
Dialogue: 0,0:21:45.67,0:21:48.07,Default,,0,0,0,,Мұны істеу оңай болады деп ойламаппын...
Dialogue: 0,0:21:49.94,0:21:53.51,Default,,0,0,0,,Сіз бәрін осылай аласыз ба? ―
Dialogue: 0,0:21:53.71,0:21:56.08,Default,,0,0,0,,Тіпті біздің орналасқан жеріміз де...
Dialogue: 0,0:21:56.98,0:22:01.42,Default,,0,0,0,,Сонда сен ештеңе көрмейсің, естімейсің! ―
Dialogue: 0,0:22:01.52,0:22:04.45,Default,,0,0,0,,Мен жүзі жасырын террористпін...
Dialogue: 0,0:22:04.55,0:22:05.79,Default,,0,0,0,,Ал сен...
Dialogue: 0,0:22:07.45,0:22:10.36,Default,,0,0,0,,Лелуч Бұл қайтадан бұрынғы күндер сияқты...
Dialogue: 0,0:22:10.72,0:22:13.73,Default,,0,0,0,,Бұл басқаша. Бұрынғыдай емес...
Dialogue: 0,0:22:14.06,0:22:16.33,Default,,0,0,0,,Эфемия!
Dialogue: 0,0:22:18.03,0:22:21.70,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:22:21.80,0:22:25.51,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:22:25.61,0:22:32.61,Default,,0,0,0,,♪Сіз маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:22:41.12,0:22:48.13,Default,,0,0,0,,♪Бұлай болуы мүмкін емес,-деп ойланып ұйықтап қалдым
Dialogue: 0,0:22:48.63,0:22:51.90,Default,,0,0,0,,♪Мен оянсам, әдеттегідей
Dialogue: 0,0:22:52.00,0:22:56.40,Default,,0,0,0,,♪ Өзгеріссіз бос жүріс
Dialogue: 0,0:22:56.50,0:23:01.68,Default,,0,0,0,,♪ Мағынасыз қайталанады
Dialogue: 0,0:23:02.54,0:23:06.55,Default,,0,0,0,,♪Мозаикалық үзінділер жанды түрде бейнеленген
Dialogue: 0,0:23:06.65,0:23:09.72,Default,,0,0,0,,♪Бұрынғы өтірік пен қателіктер
Dialogue: 0,0:23:09.82,0:23:16.82,Default,,0,0,0,,♪Оны өшіргім келген сайын, ол туралы көбірек ойлаймын
Dialogue: 0,0:23:17.39,0:23:18.63,Default,,0,0,0,,♪Артқа қарап
Dialogue: 0,0:23:18.73,0:23:21.93,Default,,0,0,0,,♪Бастау сызығы бар
Dialogue: 0,0:23:22.03,0:23:24.53,Default,,0,0,0,,♪Әлі прогресс жоқ
Dialogue: 0,0:23:24.63,0:23:31.64,Default,,0,0,0,,♪Қане армандарымызды қайта жинайық
Dialogue: 0,0:23:32.01,0:23:35.58,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:23:35.68,0:23:39.18,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:23:39.48,0:23:46.49,Default,,0,0,0,,♪Сіз маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:23:49.19,0:23:50.96,Default,,0,0,0,,Арнайы әкімшілік аймақ Жапония
Dialogue: 0,0:23:51.06,0:23:53.03,Default,,0,0,0,,Ынтымақтастық жасасаң, қолың алынады.
Dialogue: 0,0:23:53.13,0:23:55.86,Default,,0,0,0,,Қарсы болсаң халықты жау етесің.
Dialogue: 0,0:23:55.96,0:23:58.53,Default,,0,0,0,,Қара рыцарлар осында қосыла алады.
Dialogue: 0,0:23:58.87,0:24:00.03,Default,,0,0,0,,Эфемия! ―
Dialogue: 0,0:24:00.13,0:24:02.57,Default,,0,0,0,,Өзінің ақ ниетін жазықсыз көрсеткен үшінші ханшайым! ―
Dialogue: 0,0:24:03.10,0:24:04.44,Default,,0,0,0,,Мен және Нуналли үшін
Dialogue: 0,0:24:04.84,0:24:07.74,Default,,0,0,0,,Сенің бар болуың онсыз да күнә
Dialogue: 0,0:24:09.24,0:24:15.24,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory