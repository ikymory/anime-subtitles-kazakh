Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.06,0:00:04.33,Default,,0,0,0,,Лелуч, Британдық бала...
Dialogue: 0,0:00:04.43,0:00:07.67,Default,,0,0,0,,Жұмбақ қыздан ерекше қуат алды.
Dialogue: 0,0:00:07.77,0:00:09.17,Default,,0,0,0,,«Геасс»―
Dialogue: 0,0:00:09.27,0:00:13.27,Default,,0,0,0,,Кез келген қарсыласқа пәрмен беруге мүмкіндік беретін абсолютті бағыну күші.
Dialogue: 0,0:00:14.31,0:00:16.71,Default,,0,0,0,,Лелух бұл «Геассты» қару ретінде пайдаланады...
Dialogue: 0,0:00:17.08,0:00:19.18,Default,,0,0,0,,Британ империясын жоюға бел байлады.
Dialogue: 0,0:00:20.45,0:00:22.08,Default,,0,0,0,,Анамның жауларынан кек ал.
Dialogue: 0,0:00:22.18,0:00:26.32,Default,,0,0,0,,Менің әпкем Нуналли бақытты өмір сүретін әлемді құру.
Dialogue: 0,0:00:26.72,0:00:28.12,Default,,0,0,0,,Сізді одан әрі не күтіп тұр...
Dialogue: 0,0:00:28.22,0:00:31.63,Default,,0,0,0,,Мен әкемнің Британ императоры екенін білсем де...
Dialogue: 0,0:00:32.36,0:00:33.23,Default,,0,0,0,,Ең болмағанда—
Dialogue: 0,0:00:33.33,0:00:36.33,Default,,0,0,0,,Бұл Лелуштың сол кездегі тілегі еді.
Dialogue: 0,0:00:36.43,0:00:42.44,Default,,0,0,0,,♪～
Dialogue: 0,0:00:45.04,0:00:48.74,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:00:49.04,0:00:52.31,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:00:52.41,0:00:58.19,Default,,0,0,0,,♪Сәт әрқашан жаныңда...
Dialogue: 0,0:01:00.22,0:01:06.53,Default,,0,0,0,,♪ Тітіркенуді жасыра алмайды
Dialogue: 0,0:01:07.26,0:01:13.54,Default,,0,0,0,,♪ Бір орында тұрып өзіңе қара
Dialogue: 0,0:01:13.64,0:01:17.14,Default,,0,0,0,,♪ойланып отырып, уайымдап
Dialogue: 0,0:01:17.24,0:01:20.54,Default,,0,0,0,,♪Өкінішпен шешім қабылдау керек.
Dialogue: 0,0:01:20.64,0:01:24.15,Default,,0,0,0,,♪Сен маған берген бір сөз
Dialogue: 0,0:01:24.25,0:01:27.78,Default,,0,0,0,,♪Менің шатасуым жоғалады
Dialogue: 0,0:01:28.08,0:01:34.29,Default,,0,0,0,,♪Бос бөлмеме нұр түсті.
Dialogue: 0,0:01:34.62,0:01:37.83,Default,,0,0,0,,♪Мен қараған аспан
Dialogue: 0,0:01:38.16,0:01:41.70,Default,,0,0,0,,♪Ашық және көгілдір болып барады
Dialogue: 0,0:01:41.80,0:01:48.27,Default,,0,0,0,,♪Мен жабық терезені ашуды жөн көрдім.
Dialogue: 0,0:01:48.50,0:01:52.37,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:01:52.47,0:01:55.51,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:01:55.88,0:02:02.38,Default,,0,0,0,,♪Сәтті сезін, осында және қазір...
Dialogue: 0,0:02:13.29,0:02:15.30,Default,,0,0,0,,Сіз бұл мылтық не екенін білесіз бе? ―
Dialogue: 0,0:02:15.73,0:02:16.83,Default,,0,0,0,,Сузаку Куруруги
Dialogue: 0,0:02:17.70,0:02:20.24,Default,,0,0,0,,Ол князь Кловийді өлтіру үшін қолданылған.
Dialogue: 0,0:02:20.34,0:02:22.47,Default,,0,0,0,,Жол белгілері де расталды
Dialogue: 0,0:02:22.57,0:02:25.21,Default,,0,0,0,,Сондай-ақ, мен зерттедім.
Dialogue: 0,0:02:25.31,0:02:29.38,Default,,0,0,0,,Сіз Жапонияның соңғы премьер-министрі және оның заңды баласы екеніңізді естідім.
Dialogue: 0,0:02:29.48,0:02:31.31,Default,,0,0,0,,Жеткілікті мотивация
Dialogue: 0,0:02:31.45,0:02:32.88,Default,,0,0,0,,Эй, Йор-сан.
Dialogue: 0,0:02:33.18,0:02:34.72,Default,,0,0,0,,Мен мұндай мылтықты бұрын-соңды көрген емеспін.
Dialogue: 0,0:02:35.18,0:02:36.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:36.85,0:02:39.32,Default,,0,0,0,,Саусақ іздері анықталды.
Dialogue: 0,0:02:39.72,0:02:42.66,Default,,0,0,0,,Сіз сондай-ақ SS мүшесін өлтірді деп күдіктенесіз.
Dialogue: 0,0:02:42.76,0:02:43.76,Default,,0,0,0,,Оны мойындаңыз.
Dialogue: 0,0:02:43.86,0:02:45.36,Default,,0,0,0,,Енді он бірдің орнына
Dialogue: 0,0:02:45.46,0:02:47.86,Default,,0,0,0,,Сіз құрметті британдық ретінде бағаланасыз ба?
Dialogue: 0,0:02:48.33,0:02:50.50,Default,,0,0,0,,Мен... мен мұны істеген жоқпын!
Dialogue: 0,0:02:50.60,0:02:51.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:52.73,0:02:54.64,Default,,0,0,0,,Эй, бұл Сузаку-сан, солай ма? ―
Dialogue: 0,0:02:54.74,0:02:55.90,Default,,0,0,0,,Алдыңғы жаңалықтар
Dialogue: 0,0:02:56.20,0:02:58.57,Default,,0,0,0,,Әй, Созаку, сен тірісің.
Dialogue: 0,0:02:58.67,0:03:00.41,Default,,0,0,0,,Иә, соғыстан кейін
Dialogue: 0,0:03:00.51,0:03:02.31,Default,,0,0,0,,Жаңа ғана қоштасқанбыз...
Dialogue: 0,0:03:02.51,0:03:03.88,Default,,0,0,0,,Тіпті біз...
Dialogue: 0,0:03:05.28,0:03:06.25,Default,,0,0,0,,Үлкен аға?
Dialogue: 0,0:03:06.35,0:03:07.42,Default,,0,0,0,,Не?
Dialogue: 0,0:03:07.52,0:03:09.45,Default,,0,0,0,,Бұл өтірік емес пе? Жаңалықтар...
Dialogue: 0,0:03:09.55,0:03:10.69,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:03:10.95,0:03:13.29,Default,,0,0,0,,Созакудың мұндай әрекетке баруы мүмкін емес.
Dialogue: 0,0:03:13.39,0:03:14.86,Default,,0,0,0,,Бұл қандай да бір қателік.
Dialogue: 0,0:03:14.96,0:03:16.59,Default,,0,0,0,,Иә... бұл дұрыс.
Dialogue: 0,0:03:16.69,0:03:19.33,Default,,0,0,0,,А, сондықтан...
Dialogue: 0,0:03:20.23,0:03:22.20,Default,,0,0,0,,Қайырлы түн Нуннали
Dialogue: 0,0:03:22.40,0:03:24.97,Default,,0,0,0,,Сондықтан тез арада мәлімдеме жасауым керек еді! ―
Dialogue: 0,0:03:25.27,0:03:26.90,Default,,0,0,0,,Бұл біздің кінәміз.
Dialogue: 0,0:03:27.20,0:03:27.87,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:03:30.97,0:03:32.84,Default,,0,0,0,,) Хаа Наото…――
Dialogue: 0,0:03:33.78,0:03:37.51,Default,,0,0,0,,Көшбасшы болуым мүмкін емес.
Dialogue: 0,0:03:38.28,0:03:40.75,Default,,0,0,0,,Аа, бәрі тапсырыс бойынша болуы керек.
Dialogue: 0,0:03:40.85,0:03:43.85,Default,,0,0,0,,―
Dialogue: 0,0:03:43.95,0:03:46.25,Default,,0,0,0,,Слайд жүйесі де расталды -
Dialogue: 0,0:03:47.66,0:03:49.36,Default,,0,0,0,,Енді барлық дәлелдерді өшіріңіз
Dialogue: 0,0:03:49.46,0:03:51.43,Default,,0,0,0,,...
Dialogue: 0,0:03:53.93,0:03:56.76,Default,,0,0,0,,Бұл өте ауыр оқиға болды.
Dialogue: 0,0:03:56.86,0:03:59.50,Default,,0,0,0,,11-ауданның губернаторы
Dialogue: 0,0:03:59.60,0:04:03.64,Default,,0,0,0,,―
Dialogue: 0,0:04:03.74,0:04:07.88,Default,,0,0,0,,―
Dialogue: 0,0:04:07.98,0:04:09.38,Default,,0,0,0,,Сонымен… сол Квинке туралы екеуің не дейсіңдер?
Dialogue: 0,0:04:07.98,0:04:09.38,Default,,0,0,0,,...
Dialogue: 0,0:04:09.38,0:04:10.85,Default,,0,0,0,,...
Dialogue: 0,0:04:11.55,0:04:12.28,Default,,0,0,0,,Хмм, қазірдің өзінде...
Dialogue: 0,0:04:12.38,0:04:14.72,Default,,0,0,0,,...
Dialogue: 0,0:04:14.82,0:04:16.45,Default,,0,0,0,,Сіз бұл туралы бірдеңе істей алмайсыз ба?
Dialogue: 0,0:04:16.55,0:04:18.89,Default,,0,0,0,,―
Dialogue: 0,0:04:18.99,0:04:20.86,Default,,0,0,0,,Менің мүшелігім соншалықты қатал, мен қозғала алмаймын ...
Dialogue: 0,0:04:21.32,0:04:24.26,Default,,0,0,0,,―
Dialogue: 0,0:04:24.69,0:04:29.26,Default,,0,0,0,,Мен мұны айттым ба? Қалыпты жұмыс жылдамдығы: 94% Ауыстыру бөлшектері...
Dialogue: 0,0:04:29.43,0:04:32.33,Default,,0,0,0,,...
Dialogue: 0,0:04:32.43,0:04:34.60,Default,,0,0,0,,Ол құрметті британдық, солай ма?
Dialogue: 0,0:04:34.70,0:04:38.71,Default,,0,0,0,,...
Dialogue: 0,0:04:39.37,0:04:40.78,Default,,0,0,0,,Таза қандылар туралы не деуге болады?
Dialogue: 0,0:04:40.91,0:04:43.34,Default,,0,0,0,,...
Dialogue: 0,0:04:43.44,0:04:44.95,Default,,0,0,0,,Құратындар
Dialogue: 0,0:04:45.31,0:04:46.48,Default,,0,0,0,,Олардың көзқарасы бойынша-
Dialogue: 0,0:04:46.58,0:04:49.58,Default,,0,0,0,,―
Dialogue: 0,0:04:49.95,0:04:53.62,Default,,0,0,0,,―
Dialogue: 0,0:04:53.72,0:04:57.89,Default,,0,0,0,,11-аймақтағы құрметті британдық жүйені жоюға мүмкіндік береді.
Dialogue: 0,0:04:58.49,0:05:00.03,Default,,0,0,0,,Сосын, Созаку-кун...
Dialogue: 0,0:05:00.33,0:05:02.00,Default,,0,0,0,,Жазықсыз деген нәрсе жоқ.
Dialogue: 0,0:05:02.30,0:05:03.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:03.73,0:05:04.67,Default,,0,0,0,,Лелуш!
Dialogue: 0,0:05:04.77,0:05:06.00,Default,,0,0,0,,Әрі қарай не істеуіміз керек?
Dialogue: 0,0:05:06.30,0:05:09.97,Default,,0,0,0,,...
Dialogue: 0,0:05:10.37,0:05:11.61,Default,,0,0,0,,Жоқ, құмар ойындар!
Dialogue: 0,0:05:11.81,0:05:13.64,Default,,0,0,0,,Ауыр сөздер айтпа
Dialogue: 0,0:05:13.74,0:05:15.54,Default,,0,0,0,,Дұрыс, мен қазір тоқтаймын.
Dialogue: 0,0:05:15.64,0:05:16.51,Default,,0,0,0,,Не!
Dialogue: 0,0:05:16.61,0:05:19.01,Default,,0,0,0,,Мен одан да қорқынышты нәрсе таптым (Ширли) Иә? ―
Dialogue: 0,0:05:19.61,0:05:20.48,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:20.58,0:05:22.55,Default,,0,0,0,,Олай болса, мені де тістеу керек!
Dialogue: 0,0:05:22.65,0:05:23.58,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:05:23.69,0:05:26.49,Default,,0,0,0,,...
Dialogue: 0,0:05:27.96,0:05:30.59,Default,,0,0,0,,Британдық армияның басым жеңісі...
Dialogue: 0,0:05:30.69,0:05:33.33,Default,,0,0,0,,Жапон бұрынғы бұлыңғыр үкіметіне...
Dialogue: 0,0:05:33.43,0:05:35.80,Default,,0,0,0,,Мені иерархиядан хабардар етті.
Dialogue: 0,0:05:35.90,0:05:38.87,Default,,0,0,0,,бастап Империя мен Он бір қол біріктіреді...
Dialogue: 0,0:05:38.97,0:05:41.47,Default,,0,0,0,,Біз қалпына келтіру жолын бастадық.
Dialogue: 0,0:05:41.84,0:05:43.91,Default,,0,0,0,,Tokyo Tower 16:00 -
Dialogue: 0,0:05:44.01,0:05:45.64,Default,,0,0,0,,Осындай жерде
Dialogue: 0,0:05:46.04,0:05:48.68,Default,,0,0,0,,Сізге хабарласқан адам Сузаку Куруруги болды, солай ма?
Dialogue: 0,0:05:48.78,0:05:49.98,Default,,0,0,0,,Шешуші болмаңыз.
Dialogue: 0,0:05:50.45,0:05:53.55,Default,,0,0,0,,Бірақ ол Каренге қоңырау шалғаннан кейін ұсталған шығар...
Dialogue: 0,0:05:53.65,0:05:55.88,Default,,0,0,0,,Олай болса, бұл жер тым қауіпті.
Dialogue: 0,0:05:55.98,0:05:57.75,Default,,0,0,0,,Эшфорд академиясынан келген.
Dialogue: 0,0:05:57.85,0:06:00.89,Default,,0,0,0,,Құрметті Карен Стадтфельд, мен сіздің жоғалған затыңызды алдым.
Dialogue: 0,0:06:00.99,0:06:01.89,Default,,0,0,0,,Бақылау алаңы
Dialogue: 0,0:06:01.99,0:06:03.73,Default,,0,0,0,,Қызмет көрсету үстеліне келіңіз.
Dialogue: 0,0:06:03.99,0:06:06.06,Default,,0,0,0,,Біз мұны тұтынушыларымызға қайталаймыз.
Dialogue: 0,0:06:06.73,0:06:09.00,Default,,0,0,0,,Мұның дұрыс екеніне сенімдісіз бе?
Dialogue: 0,0:06:12.80,0:06:14.70,Default,,0,0,0,,Ум... бұл сіздің тұтынушыңыз, солай ма?
Dialogue: 0,0:06:14.80,0:06:17.77,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:06:18.07,0:06:19.57,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:06:19.67,0:06:21.81,Default,,0,0,0,,Жоғары мәртебелі Хловистің арқасында бәрі ойдағыдай өтті.
Dialogue: 0,0:06:22.68,0:06:23.98,Default,,0,0,0,,Себебі мен Британиядан көмек алдым...
Dialogue: 0,0:06:24.08,0:06:25.51,Default,,0,0,0,,Иә? ―
Dialogue: 0,0:06:27.42,0:06:28.58,Default,,0,0,0,,«Нөл»?
Dialogue: 0,0:06:31.95,0:06:33.86,Default,,0,0,0,,(Курокири) Шигараки, күткен нәтижеңді алдың ба?
Dialogue: 0,0:06:33.96,0:06:37.59,Default,,0,0,0,,Loop Route 5 сыртқы циклін алыңыз. Достарыңыз сізбен бірге болады.
Dialogue: 0,0:06:37.69,0:06:38.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:39.09,0:06:42.43,Default,,0,0,0,,Мәртебелін еске алу бағдарламасы жақсы өтті.
Dialogue: 0,0:06:42.53,0:06:44.47,Default,,0,0,0,,Мен сені аздап жылатып тұрған сияқтымын...
Dialogue: 0,0:06:44.70,0:06:47.87,Default,,0,0,0,,Мәртебелі, жұртшылық көз жасын қалайды.
Dialogue: 0,0:06:48.57,0:06:50.74,Default,,0,0,0,,Бұл теледидар дүкеніне тән идея.
Dialogue: 0,0:06:50.84,0:06:55.54,Default,,0,0,0,,Алайда мен мойындауым керек, бұл уақыт ішінде...
Dialogue: 0,0:06:55.84,0:06:57.01,Default,,0,0,0,,Жоғары мәртебелі өлімі сияқты.
Dialogue: 0,0:06:57.11,0:06:59.15,Default,,0,0,0,,Сіз мұны алдын ала білген сияқтысыз.
Dialogue: 0,0:06:59.45,0:07:02.08,Default,,0,0,0,,Маңызды адамдарды еске алу бағдарламасы таң қалдырады...
Dialogue: 0,0:07:02.18,0:07:04.02,Default,,0,0,0,,Әрқашан қолжетімді
Dialogue: 0,0:07:04.12,0:07:05.75,Default,,0,0,0,,Менде де бар ма?
Dialogue: 0,0:07:05.85,0:07:07.12,Default,,0,0,0,,Осы мәселе бойынша, Мәртебелі...
Dialogue: 0,0:07:07.42,0:07:08.89,Default,,0,0,0,,Тізімде болуы мүмкін
Dialogue: 0,0:07:09.52,0:07:12.49,Default,,0,0,0,,Бұл оның осы уақытқа дейін рейтингсіз болғанын білдіре ме?
Dialogue: 0,0:07:12.59,0:07:13.53,Default,,0,0,0,,Адал
Dialogue: 0,0:07:13.63,0:07:15.46,Default,,0,0,0,,Ой... Кешіріңіз.
Dialogue: 0,0:07:15.56,0:07:17.03,Default,,0,0,0,,Әскерге барғың келе ме? ―
Dialogue: 0,0:07:17.13,0:07:18.73,Default,,0,0,0,,Баспасөз қызметкерлері жеткіліксіз
Dialogue: 0,0:07:18.83,0:07:22.04,Default,,0,0,0,,Мықты емес екенімді білемін, бірақ жасымда...
Dialogue: 0,0:07:22.60,0:07:26.94,Default,,0,0,0,,Сіз коммерциялық хабар таратуды ұнатасыз ба? Жарайды, мен сенен басқа жұмыс сұрайын деп едім.
Dialogue: 0,0:07:27.88,0:07:31.48,Default,,0,0,0,,Ертең түнде Сузаку Куруруги әскери сотқа беріледі.
Dialogue: 0,0:07:31.75,0:07:32.65,Default,,0,0,0,,Жол бойында-
Dialogue: 0,0:07:32.75,0:07:35.08,Default,,0,0,0,,Патриоттық британдықтарды бағыттаңыз
Dialogue: 0,0:07:35.52,0:07:39.95,Default,,0,0,0,,Бұл тез сөйлеуге көмектеседі. Жолсерік сіздің бетіңізді анық көреді.
Dialogue: 0,0:07:40.05,0:07:41.06,Default,,0,0,0,,сэр Еремия-
Dialogue: 0,0:07:41.16,0:07:45.23,Default,,0,0,0,,Он бір адам қатардағы Куруругиді батыр деп санайды.
Dialogue: 0,0:07:45.53,0:07:47.73,Default,,0,0,0,,Қайтып алуды ойлайтын топ бар ма екен...
Dialogue: 0,0:07:48.06,0:07:50.80,Default,,0,0,0,,Мен өзімді Сазерлендте алып барамын.
Dialogue: 0,0:07:50.90,0:07:54.57,Default,,0,0,0,,Егер ол шықса, сені сол жерде өлтіреді.
Dialogue: 0,0:07:57.47,0:07:59.74,Default,,0,0,0,,Біздің тұтынушыларымызға рахмет -
Dialogue: 0,0:07:59.84,0:08:02.61,Default,,0,0,0,,Көлік ішінде күдікті зат болса -
Dialogue: 0,0:08:02.71,0:08:03.51,Default,,0,0,0,,Дереу жергілікті домофонға қоңырау шалыңыз...
Dialogue: 0,0:08:03.51,0:08:04.85,Default,,0,0,0,,Бірден ең жақын домофонда...
Dialogue: 0,0:08:03.51,0:08:04.85,Default,,0,0,0,,Ах
Dialogue: 0,0:08:04.95,0:08:06.68,Default,,0,0,0,,Сәлем (жанкүйер) иә?
Dialogue: 0,0:08:09.18,0:08:13.99,Default,,0,0,0,,Қозғалыс бағытында оңға қара. Сіз не көріп тұрсыз?
Dialogue: 0,0:08:14.52,0:08:15.79,Default,,0,0,0,,Бұл британдықтардың қаласы.
Dialogue: 0,0:08:16.66,0:08:20.06,Default,,0,0,0,,Біздің құрбандықтарымызға салынған қарақшылар қаласы
Dialogue: 0,0:08:20.16,0:08:21.16,Default,,0,0,0,,Сонда сол жақ ше?
Dialogue: 0,0:08:23.06,0:08:24.80,Default,,0,0,0,,Бұл біздің қала.
Dialogue: 0,0:08:25.70,0:08:28.90,Default,,0,0,0,,Британия сорған қоқыс қаласы
Dialogue: 0,0:08:29.00,0:08:29.97,Default,,0,0,0,,Жақсы жауап.
Dialogue: 0,0:08:30.67,0:08:33.04,Default,,0,0,0,,Енді жетекші көлікке келіңіз!
Dialogue: 0,0:08:33.54,0:08:34.51,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:34.71,0:08:35.21,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:35.74,0:08:39.58,Default,,0,0,0,,Келесі аялдама – Окубо Оокубо.
Dialogue: 0,0:08:39.68,0:08:41.22,Default,,0,0,0,,Сызық орталығы…
Dialogue: 0,0:08:46.25,0:08:47.59,Default,,0,0,0,,Жолдың ортасы -
Dialogue: 0,0:08:47.69,0:08:49.72,Default,,0,0,0,,Sobu пайдаланатын тұтынушылар үшін -
Dialogue: 0,0:08:49.82,0:08:51.93,Default,,0,0,0,,Келесі станцияда ауыстырыңыз
Dialogue: 0,0:08:56.23,0:08:56.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:00.97,0:09:02.77,Default,,0,0,0,,Сіз...?
Dialogue: 0,0:09:05.57,0:09:07.17,Default,,0,0,0,,Бұл тұзақ емес... солай емес пе?
Dialogue: 0,0:09:10.71,0:09:12.55,Default,,0,0,0,,Эй, Шинджуку ше?
Dialogue: 0,0:09:12.65,0:09:14.05,Default,,0,0,0,,Атысты тоқтату туралы бұйрық берген сен бе?
Dialogue: 0,0:09:14.15,0:09:16.72,Default,,0,0,0,,Эй, бірдеңе айт.
Dialogue: 0,0:09:18.85,0:09:19.72,Default,,0,0,0,,О
Dialogue: 0,0:09:20.05,0:09:22.66,Default,,0,0,0,,Концессиялық тур туралы не ойлайсыз?
Dialogue: 0,0:09:23.06,0:09:23.99,Default,,0,0,0,,Тур?
Dialogue: 0,0:09:24.13,0:09:26.23,Default,,0,0,0,,Эй, сен осылай әрекет еттің бе?
Dialogue: 0,0:09:26.76,0:09:29.16,Default,,0,0,0,,Мен сенің дұрыс түсінгеніңді қалаймын.
Dialogue: 0,0:09:29.26,0:09:31.57,Default,,0,0,0,,Концессиялар мен геттолар
Dialogue: 0,0:09:32.00,0:09:36.60,Default,,0,0,0,,Шынында да, біз бен Британия арасындағы айырмашылық бар, үмітсіз айырмашылық.
Dialogue: 0,0:09:36.70,0:09:38.11,Default,,0,0,0,,Сонымен қарсылық ретінде
Dialogue: 0,0:09:38.21,0:09:39.61,Default,,0,0,0,,№ (желдеткіш) Ах.
Dialogue: 0,0:09:39.84,0:09:41.94,Default,,0,0,0,,Британияны терроризммен жеңу мүмкін емес.
Dialogue: 0,0:09:42.24,0:09:43.04,Default,,0,0,0,,Жеңіліс пе?
Dialogue: 0,0:09:43.24,0:09:45.98,Default,,0,0,0,,Терроризм – бұл балаларды қудалаудан басқа ештеңе емес.
Dialogue: 0,0:09:46.08,0:09:46.85,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:09:46.95,0:09:48.65,Default,,0,0,0,,Біз баламыз ба?
Dialogue: 0,0:09:48.75,0:09:52.02,Default,,0,0,0,,Қарсыласыңды жаңылтпа. Жау британдық емес.
Dialogue: 0,0:09:52.12,0:09:52.95,Default,,0,0,0,,Бұл Британия!
Dialogue: 0,0:09:53.05,0:09:54.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:54.16,0:09:57.02,Default,,0,0,0,,Егер сіз мұны істегіңіз келсе, бұл соғыс. Азаматтарды тартпаңыз.
Dialogue: 0,0:09:57.73,0:09:59.96,Default,,0,0,0,,Дайын болыңыз! Әділдік жаса!
Dialogue: 0,0:10:01.76,0:10:02.90,Default,,0,0,0,,Хе... Ақымақ болма.
Dialogue: 0,0:10:03.63,0:10:04.83,Default,,0,0,0,,Сіз аузыңызбен кез келген нәрсені айта аласыз.
Dialogue: 0,0:10:05.30,0:10:08.17,Default,,0,0,0,,Бет-жүзін де көрсете алмайтын адамның сөзіне сене аласыз ба?
Dialogue: 0,0:10:08.27,0:10:09.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:09.24,0:10:10.34,Default,,0,0,0,,Масканы шешіңіз!
Dialogue: 0,0:10:10.64,0:10:13.11,Default,,0,0,0,,Эй, сен маған бетіңді көрсете аласың ба?
Dialogue: 0,0:10:13.21,0:10:14.88,Default,,0,0,0,,Жарайды, көрсетейін.
Dialogue: 0,0:10:15.68,0:10:16.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:16.84,0:10:19.98,Default,,0,0,0,,Әйтсе де, сенің көрсеткен жүзің емес... бұл сенің күшің! ―
Dialogue: 0,0:10:20.78,0:10:25.32,Default,,0,0,0,,Егер сіз мүмкін емес нәрсені мүмкін ете алсаңыз, адамдар оған аздап сенеді.
Dialogue: 0,0:10:25.92,0:10:27.99,Default,,0,0,0,,Британ ханзадасын өлтірді.
Dialogue: 0,0:10:28.09,0:10:29.32,Default,,0,0,0,,Сузаку Куруругиге батыр ретінде қарау керек...
Dialogue: 0,0:10:29.79,0:10:31.39,Default,,0,0,0,,Бірақ ол құрметті британдық.
Dialogue: 0,0:10:31.69,0:10:33.86,Default,,0,0,0,,Бұл премьер-министр Куруругидің ұмытылған естелігі емес пе?
Dialogue: 0,0:10:33.96,0:10:37.77,Default,,0,0,0,,Жапонияны тастап кеткен адам Халық оның бар екенін де білмеген.
Dialogue: 0,0:10:37.97,0:10:40.97,Default,,0,0,0,,Синдзюку оқиғасы Акацуки тобына қатысты.
Dialogue: 0,0:10:41.07,0:10:44.01,Default,,0,0,0,,Иә, қазір Оги деген адам билікке келеді.
Dialogue: 0,0:10:45.07,0:10:48.31,Default,,0,0,0,,Хмм, Куруругидің негізгі отбасы бірдеңе деді ме?
Dialogue: 0,0:10:48.41,0:10:52.08,Default,,0,0,0,,Жоқ, әскерге келгеннен кейін мерзімі біткен сияқты.
Dialogue: 0,0:10:52.35,0:10:53.38,Default,,0,0,0,,Сіз қалай ойлайсыз? Тодо
Dialogue: 0,0:10:54.22,0:10:57.12,Default,,0,0,0,,Ашық өлім жазасына қатысуға ешқандай себеп жоқ.
Dialogue: 0,0:10:57.25,0:10:59.15,Default,,0,0,0,,Хмм (Кусакабе) Бұл аю.
Dialogue: 0,0:10:59.25,0:11:01.29,Default,,0,0,0,,Ғажайып Тодо деп атауға болатын адам
Dialogue: 0,0:11:01.69,0:11:04.16,Default,,0,0,0,,Мен ғажайыптарды абайсыздықпен шатастырғым келмейді.
Dialogue: 0,0:11:04.96,0:11:06.73,Default,,0,0,0,,Құттықтаймыз! Ха...
Dialogue: 0,0:11:06.83,0:11:10.73,Default,,0,0,0,,Сіз сұраған екі адам өлілер тізімінде жоқ еді.
Dialogue: 0,0:11:10.83,0:11:11.40,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:11.90,0:11:13.77,Default,,0,0,0,,Бірақ сіз қолайсызсыз...
Dialogue: 0,0:11:13.87,0:11:16.90,Default,,0,0,0,,Сотта ешкім сіздің тарапыңызда болмайды.
Dialogue: 0,0:11:17.00,0:11:20.04,Default,,0,0,0,,Бірақ сот залы шындықтың ашылатын жері.
Dialogue: 0,0:11:20.67,0:11:23.28,Default,,0,0,0,,Ашылмаған дүниелер көп деп ойлаймын.
Dialogue: 0,0:11:23.38,0:11:25.31,Default,,0,0,0,,Шындық дегеніміз не?
Dialogue: 0,0:11:25.41,0:11:30.02,Default,,0,0,0,,Дүние солай болса, өкінбеймін.
Dialogue: 0,0:11:35.92,0:11:37.09,Default,,0,0,0,,Жақында -
Dialogue: 0,0:11:37.19,0:11:38.76,Default,,0,0,0,,Уақыт аяқталуға жақын.
Dialogue: 0,0:11:39.19,0:11:42.80,Default,,0,0,0,,Қараңдаршы, жол жиегіне толып жатқан адамдар! ―
Dialogue: 0,0:11:42.90,0:11:44.43,Default,,0,0,0,,Барлығы күтіп тұр...
Dialogue: 0,0:11:44.73,0:11:46.43,Default,,0,0,0,,Князь Кловисті өлтірді деген күдікті -
Dialogue: 0,0:11:46.73,0:11:49.77,Default,,0,0,0,,Құрметті британдық Сузаку Куруруги өтіп бара жатыр! ―
Dialogue: 0,0:11:49.87,0:11:53.04,Default,,0,0,0,,Мен бұрынғы он бірді күтемін!
Dialogue: 0,0:11:53.14,0:11:54.71,Default,,0,0,0,,Камера нөмірі 5, ол баяу.
Dialogue: 0,0:11:54.81,0:11:57.41,Default,,0,0,0,,Чарльз Топты реттеуді аяқтадыңыз ба?
Dialogue: 0,0:11:57.78,0:12:00.48,Default,,0,0,0,,О? студия? Мені күте тұрыңыз
Dialogue: 0,0:12:00.78,0:12:03.42,Default,,0,0,0,,Ешқандай итермелеу жоқ, бәрі жоспарланғандай.
Dialogue: 0,0:12:03.75,0:12:04.99,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:12:05.29,0:12:06.92,Default,,0,0,0,,О, мен оны көріп тұрмын.
Dialogue: 0,0:12:07.02,0:12:08.22,Default,,0,0,0,,Күдікті Куруруги.
Dialogue: 0,0:12:08.32,0:12:10.22,Default,,0,0,0,,Сузаку Куруруги жақында осында болады
Dialogue: 0,0:12:10.46,0:12:12.06,Default,,0,0,0,,Ура
Dialogue: 0,0:12:12.49,0:12:15.96,Default,,0,0,0,,Хмф, осындай сәтті жарыс...Мен де құладым.
Dialogue: 0,0:12:16.16,0:12:17.33,Default,,0,0,0,,Ешкім! (Еркек) Шүкір!
Dialogue: 0,0:12:17.43,0:12:18.73,Default,,0,0,0,,Он бір! (Еркек) Қарғыс атсын!
Dialogue: 0,0:12:18.83,0:12:20.00,Default,,0,0,0,,Мәртебелі Хловисті қайтарыңыз!
Dialogue: 0,0:12:20.10,0:12:21.10,Default,,0,0,0,,Бұл адам өлтіруші!
Dialogue: 0,0:12:23.04,0:12:26.27,Default,,0,0,0,,Созаку-кунның жазықсыз екенін білсек те...
Dialogue: 0,0:12:26.37,0:12:29.51,Default,,0,0,0,,Сот біздің айғақтарымызды қабылдамау туралы шешім қабылдады.
Dialogue: 0,0:12:29.81,0:12:30.98,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:12:31.08,0:12:31.98,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:32.08,0:12:34.35,Default,,0,0,0,,Әй, бұл қайырымдылық па? Гуманизм?
Dialogue: 0,0:12:34.45,0:12:36.38,Default,,0,0,0,,Бұл сөз ойыны ма?
Dialogue: 0,0:12:37.18,0:12:38.32,Default,,0,0,0,,Тағы бір нәрсе істеу керек пе? ―
Dialogue: 0,0:12:38.99,0:12:41.26,Default,,0,0,0,,Сіз бұл жағдайды білесіз...
Dialogue: 0,0:12:41.52,0:12:44.13,Default,,0,0,0,,Саммитте ол адаммен байланыса алмаймын...
Dialogue: 0,0:12:44.23,0:12:46.19,Default,,0,0,0,,Менің бас тартудан басқа амалым жоқ.
Dialogue: 0,0:12:46.49,0:12:49.50,Default,,0,0,0,,Реніш үні... Ашу үні көтеріліп келеді.
Dialogue: 0,0:12:49.80,0:12:51.40,Default,,0,0,0,,Мәртебелі қаншалықты жақсы көретін...
Dialogue: 0,0:12:51.50,0:12:52.53,Default,,0,0,0,,Бұл айғақ дауысы.
Dialogue: 0,0:12:52.83,0:12:55.07,Default,,0,0,0,,Террористерді соттайтын әділдіктің үні.
Dialogue: 0,0:12:55.54,0:12:56.50,Default,,0,0,0,,Сузаку мырза!
Dialogue: 0,0:12:59.27,0:13:00.51,Default,,0,0,0,,Істі шешу үшін көп еңбек етті.
Dialogue: 0,0:13:00.81,0:13:02.31,Default,,0,0,0,,Марграв Еремияның өзі...
Dialogue: 0,0:13:02.41,0:13:04.88,Default,,0,0,0,,Консул орынбасарының міндетін атқарушы
Dialogue: 0,0:13:10.28,0:13:12.79,Default,,0,0,0,,Мұны үш адаммен ғана жасауға болмайды.
Dialogue: 0,0:13:14.42,0:13:18.36,Default,,0,0,0,,Бірақ ол мүмкін емес нәрсені мүмкін ететінін айтты...
Dialogue: 0,0:13:20.13,0:13:21.13,Default,,0,0,0,,Әлгі адам...
Dialogue: 0,0:13:21.46,0:13:23.50,Default,,0,0,0,,Мен Сузаку Куруругиді құтқарамын!
Dialogue: 0,0:13:24.20,0:13:28.37,Default,,0,0,0,,Дұрыс. Артқа бұруға жол жоқ...
Dialogue: 0,0:13:30.30,0:13:31.84,Default,,0,0,0,,Консулдың міндетін атқарушы Еремия
Dialogue: 0,0:13:31.94,0:13:32.81,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:32.91,0:13:35.84,Default,,0,0,0,,Үшінші көшеден негізгі жолға қарай келе жатқан көлік бар.
Dialogue: 0,0:13:35.94,0:13:37.55,Default,,0,0,0,,Нұсқау бойынша оны бақылаусыз қалдырдым.
Dialogue: 0,0:13:38.05,0:13:40.41,Default,,0,0,0,,Сіздің ойыңызша бұл нысан террористтерге тиесілі ме?
Dialogue: 0,0:13:40.51,0:13:43.52,Default,,0,0,0,,… …
Dialogue: 0,0:13:43.82,0:13:44.95,Default,,0,0,0,,Мәртебелі?
Dialogue: 0,0:13:45.42,0:13:49.52,Default,,0,0,0,,Бұл жай ғана әзіл. Маған бәрі бір. Тек өтіп кетсін.
Dialogue: 0,0:13:49.86,0:13:50.99,Default,,0,0,0,,Барлық күштер тоқтады!
Dialogue: 0,0:13:51.19,0:13:52.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:52.26,0:13:53.89,Default,,0,0,0,,Шынымен тоқтадыңыз ба?
Dialogue: 0,0:13:53.99,0:13:55.86,Default,,0,0,0,,Эй, бұл жай ғана болды.
Dialogue: 0,0:13:55.96,0:13:59.93,Default,,0,0,0,,Бірақ Еремияның әрекеттері өзін-өзі көрсетуге деген қатты құштарлығын көрсетеді...
Dialogue: 0,0:14:00.03,0:14:00.60,Default,,0,0,0,,Кездейсоқ
Dialogue: 0,0:14:01.30,0:14:02.50,Default,,0,0,0,,Осы жерде тоқтау дегеніміз...
Dialogue: 0,0:14:02.60,0:14:03.47,Default,,0,0,0,,Жоспарланбаған -
Dialogue: 0,0:14:03.57,0:14:05.61,Default,,0,0,0,,Бұл қандай да бір апат болды ма?
Dialogue: 0,0:14:05.91,0:14:08.98,Default,,0,0,0,,Бұл 5-тармақ. Онда көлік келе жатыр.
Dialogue: 0,0:14:09.14,0:14:10.08,Default,,0,0,0,,Иә
Dialogue: 0,0:14:10.28,0:14:11.25,Default,,0,0,0,,Эй, бұл-
Dialogue: 0,0:14:11.35,0:14:13.91,Default,,0,0,0,,Бұл тек Жоғары Мәртебелі Хловиске арналған корольдік вагон. Сіз оны көре аласыз ба?
Dialogue: 0,0:14:14.01,0:14:15.88,Default,,0,0,0,,Ақымақ, бас.
Dialogue: 0,0:14:16.45,0:14:17.92,Default,,0,0,0,,Не істеуді жоспарлап отырсың, әлгі жігіт?
Dialogue: 0,0:14:20.29,0:14:22.32,Default,,0,0,0,,Шынында да, осындай жазбамен...
Dialogue: 0,0:14:27.96,0:14:29.96,Default,,0,0,0,,Түсіндім, бұл тек сендер ме?
Dialogue: 0,0:14:30.06,0:14:31.00,Default,,0,0,0,,Кешіріңіз-
Dialogue: 0,0:14:31.10,0:14:34.27,Default,,0,0,0,,Маған тағы біраз уақыт бере аласыз ба? Сен дұрыс сөйлесең, басқалардың бәрі де...
Dialogue: 0,0:14:34.37,0:14:36.34,Default,,0,0,0,,Жоқ, екі адам жеткілікті.
Dialogue: 0,0:14:36.44,0:14:37.27,Default,,0,0,0,,На
Dialogue: 0,0:14:37.37,0:14:40.11,Default,,0,0,0,,Ақымақ болма. Сізде қанша адам бар деп ойлайсыз?
Dialogue: 0,0:14:40.37,0:14:42.28,Default,,0,0,0,,Егер бәріңіз бірлесіп жұмыс жасасаңыздар--
Dialogue: 0,0:14:42.38,0:14:45.01,Default,,0,0,0,,Шарттар тазаланғандай жақсы.
Dialogue: 0,0:14:45.11,0:14:49.12,Default,,0,0,0,,Мұны ертеңге дейін жасаңыз. Тек сыртынан солай көріну керек.
Dialogue: 0,0:14:49.22,0:14:50.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:51.65,0:14:52.62,Default,,0,0,0,,Шық! ―
Dialogue: 0,0:14:52.92,0:14:55.19,Default,,0,0,0,,Мәртебелі патшалық арбаны қорлайтын, жеткізбейтін адам бар!
Dialogue: 0,0:14:59.59,0:15:00.63,Default,,0,0,0,,Иә? (Көрермендер) О!
Dialogue: 0,0:15:01.63,0:15:03.96,Default,,0,0,0,,Мен нөлмін
Dialogue: 0,0:15:04.20,0:15:04.90,Default,,0,0,0,,Нөл?
Dialogue: 0,0:15:05.20,0:15:06.50,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:06.60,0:15:07.50,Default,,0,0,0,,Бұл адам кім? ―
Dialogue: 0,0:15:07.60,0:15:11.14,Default,,0,0,0,,Ол өзін Нөл деп атайды және конвойдың алдында тұрады.
Dialogue: 0,0:15:11.41,0:15:12.47,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:12.91,0:15:13.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:13.91,0:15:15.34,Default,,0,0,0,,Ол не істемекші?
Dialogue: 0,0:15:15.61,0:15:16.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:17.61,0:15:19.11,Default,,0,0,0,,Ха ха...
Dialogue: 0,0:15:19.21,0:15:20.38,Default,,0,0,0,,Өзін Нөл деп атайтын адам...
Dialogue: 0,0:15:20.48,0:15:21.45,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:21.98,0:15:24.39,Default,,0,0,0,,Нөл... сіз ештеңе айтпайсыз ба?
Dialogue: 0,0:15:25.09,0:15:26.39,Default,,0,0,0,,Сіз террористсіз бе? ―
Dialogue: 0,0:15:26.49,0:15:29.19,Default,,0,0,0,,Бірақ егер солай болса, бұл өте ақымақтық.
Dialogue: 0,0:15:29.62,0:15:31.29,Default,,0,0,0,,Он бір?
Dialogue: 0,0:15:32.09,0:15:34.40,Default,,0,0,0,,Созаку, мен сенің қарызыңды өтеймін.
Dialogue: 0,0:15:34.50,0:15:36.13,Default,,0,0,0,,Жетеді, нөл.
Dialogue: 0,0:15:36.23,0:15:38.67,Default,,0,0,0,,Көрсетілім уақытыңыз аяқталды.
Dialogue: 0,0:15:41.97,0:15:43.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:45.71,0:15:48.68,Default,,0,0,0,,Енді алдымен масканы шешіп алайын.
Dialogue: 0,0:15:52.01,0:15:53.01,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:15:56.98,0:15:57.69,Default,,0,0,0,,Не?
Dialogue: 0,0:15:57.99,0:15:59.22,Default,,0,0,0,,Сэр Жеремия Міне, солай!
Dialogue: 0,0:15:59.99,0:16:01.36,Default,,0,0,0,,Иә, Еремия.
Dialogue: 0,0:16:01.69,0:16:05.69,Default,,0,0,0,,Ішінде не бар екенін көрмегендер үшін бұл улы газ капсуласы.
Dialogue: 0,0:16:06.06,0:16:08.13,Default,,0,0,0,,Жоқ, бұл... арғ
Dialogue: 0,0:16:08.23,0:16:09.06,Default,,0,0,0,,Йокогама Токионың бір бөлігі ғой!
Dialogue: 0,0:16:09.16,0:16:11.30,Default,,0,0,0,,Барлығы теледидардың алдында, сіз оны көре аласыз ба? ―
Dialogue: 0,0:16:11.40,0:16:14.34,Default,,0,0,0,,Бұл машинаның бір түрі сияқты көрінеді, бірақ оның мақсаты белгісіз.
Dialogue: 0,0:16:14.44,0:16:17.00,Default,,0,0,0,,Террорист деп есептелген адамның мәлімдемесін күтеміз.
Dialogue: 0,0:16:17.10,0:16:18.31,Default,,0,0,0,,Сәл күте тұрыңыз
Dialogue: 0,0:16:18.67,0:16:20.24,Default,,0,0,0,,Эй, мына жігіт-
Dialogue: 0,0:16:20.57,0:16:23.71,Default,,0,0,0,,Мұндағы Британияның барлық азаматтары кепілге алынды.
Dialogue: 0,0:16:24.55,0:16:27.48,Default,,0,0,0,,Бұл да кепілге алынғандарға ескертпестен.
Dialogue: 0,0:16:27.58,0:16:28.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:28.58,0:16:31.42,Default,,0,0,0,,Мен оны сынап көрейін бе? Түсіну керек.
Dialogue: 0,0:16:31.52,0:16:33.15,Default,,0,0,0,,6-топ Дыбысты қабылда
Dialogue: 0,0:16:33.25,0:16:35.36,Default,,0,0,0,,Камера тікелей жақындауы керек.
Dialogue: 0,0:16:35.46,0:16:37.36,Default,,0,0,0,,Бірақ бұл әйтеуір қауіпті.
Dialogue: 0,0:16:37.46,0:16:39.43,Default,,0,0,0,,Tsk әуесқой
Dialogue: 0,0:16:41.50,0:16:43.46,Default,,0,0,0,,Жарайды, не сұрайсыз?
Dialogue: 0,0:16:43.56,0:16:46.17,Default,,0,0,0,,Осы жігіт пен Сузаку Куруругиді алмастырайық.
Dialogue: 0,0:16:46.30,0:16:47.30,Default,,0,0,0,,Күлуді тоқтатыңыз
Dialogue: 0,0:16:48.00,0:16:50.57,Default,,0,0,0,,Бұл адам князь Кловистен бас тартқан сатқын.
Dialogue: 0,0:16:51.14,0:16:52.47,Default,,0,0,0,,Оны тапсыруға мүмкіндік жоқ.
Dialogue: 0,0:16:52.57,0:16:55.61,Default,,0,0,0,,Жоқ, сен қателесесің, Еремия.
Dialogue: 0,0:16:55.71,0:16:57.41,Default,,0,0,0,,Бұл кінәлі емес.
Dialogue: 0,0:16:57.71,0:16:59.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:59.68,0:17:01.15,Default,,0,0,0,,Хловисті кім өлтірді?
Dialogue: 0,0:17:02.45,0:17:03.52,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:17:03.68,0:17:04.58,Default,,0,0,0,,Өтірік...
Dialogue: 0,0:17:04.69,0:17:06.15,Default,,0,0,0,,Ол? (Еркек) Бұл рас па...
Dialogue: 0,0:17:06.25,0:17:07.25,Default,,0,0,0,,Хо
Dialogue: 0,0:17:07.35,0:17:09.32,Default,,0,0,0,,Жоқ, бұл нағыз кінәлі.
Dialogue: 0,0:17:09.59,0:17:11.43,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:11.53,0:17:13.39,Default,,0,0,0,,Өзін Нөл деп атайтын бетперде киген адам...
Dialogue: 0,0:17:13.49,0:17:16.03,Default,,0,0,0,,Жоқ, мен жынысын білмеймін, бірақ...
Dialogue: 0,0:17:16.33,0:17:18.30,Default,,0,0,0,,Ол өзін нағыз кінәлі деп алға тартты.
Dialogue: 0,0:17:18.40,0:17:21.70,Default,,0,0,0,,Енді тұтқынға алынған қатардағы Куруруги не болады?
Dialogue: 0,0:17:22.30,0:17:24.07,Default,,0,0,0,,Бұл тым көп, мен қашып құтыла алмаймын!
Dialogue: 0,0:17:24.34,0:17:25.64,Default,,0,0,0,,Мен енді мұны істей алмаймын.
Dialogue: 0,0:17:26.07,0:17:27.27,Default,,0,0,0,,Бір он бір...
Dialogue: 0,0:17:27.37,0:17:30.28,Default,,0,0,0,,Көптеген бағалы британдықтардың өмірін сақтап қалуға болады.
Dialogue: 0,0:17:30.78,0:17:32.81,Default,,0,0,0,,Менің ойымша, бұл жаман мәміле емес.
Dialogue: 0,0:17:33.25,0:17:36.05,Default,,0,0,0,,Бұл жігіт оқиғаны шоуға айналдыруды жоспарлап отыр ма?
Dialogue: 0,0:17:36.15,0:17:37.72,Default,,0,0,0,,Бұл жігіт жынды
Dialogue: 0,0:17:37.82,0:17:41.39,Default,,0,0,0,,Жоғары мәртебелі императордың корольдік арбасын жасырып, оны мазақ ету қылмысы үшін кешірім!
Dialogue: 0,0:17:42.49,0:17:45.53,Default,,0,0,0,,Жарайды ма?Мен апельсинді жариялаймын.
Dialogue: 0,0:17:45.63,0:17:46.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:46.79,0:17:49.10,Default,,0,0,0,,Не? Апельсин? (Солдат) Жүріңдер?
Dialogue: 0,0:17:53.50,0:17:56.44,Default,,0,0,0,,Бұл мен өлген кезде жария болуы керек.
Dialogue: 0,0:17:56.54,0:17:58.14,Default,,0,0,0,,Бұның болғанын қаламасаңыз...
Dialogue: 0,0:17:58.24,0:18:00.44,Default,,0,0,0,,Сіз нені айтасыз? сен не айтып тұрсың?
Dialogue: 0,0:18:00.77,0:18:05.25,Default,,0,0,0,,Бізді, тіпті ол жігітті де сағыну үшін бар күшіңді сал!
Dialogue: 0,0:18:13.79,0:18:16.79,Default,,0,0,0,,Хмф, жарайды, маған сол жігітті беріңіз.
Dialogue: 0,0:18:17.12,0:18:17.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:18.13,0:18:19.86,Default,,0,0,0,,Еремия сэр, енді ше?
Dialogue: 0,0:18:20.16,0:18:21.56,Default,,0,0,0,,Маған адамды бер!
Dialogue: 0,0:18:21.66,0:18:22.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:22.63,0:18:24.50,Default,,0,0,0,,... жақсы ма? (Солдат) Бірақ...
Dialogue: 0,0:18:24.67,0:18:26.70,Default,,0,0,0,,Оны маған бер!Сізге ешкімнің қол тигізуіне жол бермеңіз
Dialogue: 0,0:18:26.80,0:18:29.20,Default,,0,0,0,,Мұндай жоспар дегенді қалай түсінесіңдер?
Dialogue: 0,0:18:29.30,0:18:30.17,Default,,0,0,0,,Лорд Куэлл-
Dialogue: 0,0:18:30.54,0:18:32.24,Default,,0,0,0,,Бұл бұйрық
Dialogue: 0,0:18:32.74,0:18:35.11,Default,,0,0,0,,Мен бұл жерден не болғанын айта алмаймын, бірақ...
Dialogue: 0,0:18:35.21,0:18:37.58,Default,,0,0,0,,Сузаку Куруругидің шектеулері алынып тасталатын сияқты.
Dialogue: 0,0:18:37.68,0:18:39.61,Default,,0,0,0,,(Көрермендердің ашулы дыбыстары)
Dialogue: 0,0:18:39.71,0:18:42.45,Default,,0,0,0,,Бұл адам қылмыскер. Ол не істеп жатыр?
Dialogue: 0,0:18:42.55,0:18:43.45,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:44.69,0:18:46.45,Default,,0,0,0,,Сіз кімсіз? Уф
Dialogue: 0,0:18:46.85,0:18:49.56,Default,,0,0,0,,Дауысымды шығара алмайтын сияқтымын.
Dialogue: 0,0:18:54.19,0:18:56.40,Default,,0,0,0,,Уф, егер біз олардың осында қашуына рұқсат етсек, біз...
Dialogue: 0,0:18:57.13,0:18:58.27,Default,,0,0,0,,Нөлдік уақыт.
Dialogue: 0,0:18:58.37,0:18:59.90,Default,,0,0,0,,Ал, кейінірек сөйлесейік.
Dialogue: 0,0:19:01.24,0:19:03.34,Default,,0,0,0,,(Көрермендердің айқайлары)
Dialogue: 0,0:19:03.50,0:19:05.54,Default,,0,0,0,,Эй, он бір, хехе!
Dialogue: 0,0:19:05.64,0:19:06.91,Default,,0,0,0,,Еремия сэр Неліктен?
Dialogue: 0,0:19:07.21,0:19:08.88,Default,,0,0,0,,Мен саған тиіспе дедім.
Dialogue: 0,0:19:12.78,0:19:14.75,Default,,0,0,0,,Сіз секірдіңіз бе?Өйткені, менің достарым
Dialogue: 0,0:19:21.32,0:19:23.36,Default,,0,0,0,,Мен мұны істедім. Енді... Уф...
Dialogue: 0,0:19:24.79,0:19:27.46,Default,,0,0,0,,Ақымақ!Қауіпсіздік желісінің ортасында
Dialogue: 0,0:19:27.56,0:19:28.16,Default,,0,0,0,,Лорд Кьюэлл
Dialogue: 0,0:19:28.16,0:19:28.66,Default,,0,0,0,,Лорд Кьюэлл
Dialogue: 0,0:19:28.16,0:19:28.66,Default,,0,0,0,,Га
Dialogue: 0,0:19:28.86,0:19:30.90,Default,,0,0,0,,Менің бұйрықтарымды орындай алмайсың ба? ―
Dialogue: 0,0:19:31.20,0:19:33.43,Default,,0,0,0,,Әрі қарайғы әрекеттер жазаға тартылады.
Dialogue: 0,0:19:33.53,0:19:35.84,Default,,0,0,0,,Жақсы, барлық бірліктердің мұқият екеніне көз жеткізіңіз.
Dialogue: 0,0:19:36.24,0:19:38.44,Default,,0,0,0,,Оларды сағыну үшін бар күшіңізді салыңыз
Dialogue: 0,0:19:43.68,0:19:45.78,Default,,0,0,0,,Мен сені шынымен құтқарады деп ойламадым.
Dialogue: 0,0:19:45.88,0:19:47.65,Default,,0,0,0,,Бұл не? Ол жігіт
Dialogue: 0,0:19:47.75,0:19:48.78,Default,,0,0,0,,Бұл күлкілі.
Dialogue: 0,0:19:48.88,0:19:51.59,Default,,0,0,0,,Бұл блеф неше рет жұмыс істейді?
Dialogue: 0,0:19:51.69,0:19:53.92,Default,,0,0,0,,Бірақ мен мойындауым керек (Тамаки) Иә?
Dialogue: 0,0:19:54.62,0:19:56.56,Default,,0,0,0,,Мұны одан басқа кім жасай алады? ―
Dialogue: 0,0:19:57.62,0:20:02.43,Default,,0,0,0,,Мұны тіпті Жапон азаттық майданы да жасай алмайды, ең болмағанда мен емес.
Dialogue: 0,0:20:03.23,0:20:04.70,Default,,0,0,0,,Барлығы мүмкін емес деп ойлады...
Dialogue: 0,0:20:04.80,0:20:06.97,Default,,0,0,0,,Тіпті Британиямен соғыс...
Dialogue: 0,0:20:07.27,0:20:09.47,Default,,0,0,0,,Ол мұны істеуі мүмкін.
Dialogue: 0,0:20:09.57,0:20:10.74,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:20:12.37,0:20:14.91,Default,,0,0,0,,Сізге өте дөрекі қараған сияқты.
Dialogue: 0,0:20:15.21,0:20:18.55,Default,,0,0,0,,Сіз олардың не істеп жатқанын білесіз, қатардағы Куруруги.
Dialogue: 0,0:20:18.68,0:20:20.55,Default,,0,0,0,,Британия шірік.
Dialogue: 0,0:20:20.65,0:20:23.75,Default,,0,0,0,,Егер сіз әлемді өзгерткіңіз келсе, маған қосылыңыз.
Dialogue: 0,0:20:23.85,0:20:25.29,Default,,0,0,0,,Сен…
Dialogue: 0,0:20:25.39,0:20:27.92,Default,,0,0,0,,Князь Хловиісті шынымен өлтірдің бе?
Dialogue: 0,0:20:28.22,0:20:32.49,Default,,0,0,0,,Бұл соғыс.Жау генералын түсіруге негіз бар ма?
Dialogue: 0,0:20:32.93,0:20:35.46,Default,,0,0,0,,Улы газ туралы не деуге болады? бейбіт тұрғындарды кепілге алу
Dialogue: 0,0:20:35.76,0:20:37.83,Default,,0,0,0,,Әрбір келіссөзде блюфинг сөзсіз.
Dialogue: 0,0:20:37.93,0:20:39.87,Default,,0,0,0,,Ақырында ешкім өлмеді.
Dialogue: 0,0:20:40.33,0:20:43.60,Default,,0,0,0,,Нәтиже? Иә, бұл идея
Dialogue: 0,0:20:44.34,0:20:44.94,Default,,0,0,0,,Иә
Dialogue: 0,0:20:45.47,0:20:47.31,Default,,0,0,0,,Маған келіңіз -
Dialogue: 0,0:20:47.41,0:20:50.58,Default,,0,0,0,,Британия сіздің қызметіңізге лайық емес ел.
Dialogue: 0,0:20:50.68,0:20:52.58,Default,,0,0,0,,Мүмкін солай шығар, бірақ...
Dialogue: 0,0:20:53.28,0:20:56.38,Default,,0,0,0,,Сол үшін елге қадірлі боламын.
Dialogue: 0,0:20:56.48,0:20:57.62,Default,,0,0,0,,Британиядан
Dialogue: 0,0:20:57.85,0:20:58.69,Default,,0,0,0,,Өзгерту?
Dialogue: 0,0:20:59.55,0:21:01.72,Default,,0,0,0,,Оны дұрыс емес жолмен алу нәтижесінде...
Dialogue: 0,0:21:01.82,0:21:03.39,Default,,0,0,0,,Өйткені, менің ойымша, бұл оған тұрарлық емес
Dialogue: 0,0:21:03.49,0:21:04.86,Default,,0,0,0,,Күте тұрыңыз, қайда барасыз?
Dialogue: 0,0:21:04.96,0:21:07.49,Default,,0,0,0,,Бір сағаттан кейін әскери трибунал басталады.
Dialogue: 0,0:21:07.66,0:21:09.60,Default,,0,0,0,,Ба... Сен ақымақсың ба? ―
Dialogue: 0,0:21:09.70,0:21:10.50,Default,,0,0,0,,Бұл сот-
Dialogue: 0,0:21:10.60,0:21:12.87,Default,,0,0,0,,Бұл сізді қылмыскер ету үшін орнатылған.
Dialogue: 0,0:21:12.97,0:21:14.97,Default,,0,0,0,,Прокурорлар, судьялар және қорғаушылар
Dialogue: 0,0:21:15.40,0:21:17.50,Default,,0,0,0,,Дегенмен, бұл ережелер.
Dialogue: 0,0:21:17.60,0:21:21.01,Default,,0,0,0,,Бармасам, Eleven және құрметті британдықтар...
Dialogue: 0,0:21:21.31,0:21:22.41,Default,,0,0,0,,Репрессия басталады
Dialogue: 0,0:21:22.58,0:21:23.98,Default,,0,0,0,,Бірақ сен өлесің.
Dialogue: 0,0:21:24.28,0:21:24.91,Default,,0,0,0,,Маңызды емес
Dialogue: 0,0:21:25.01,0:21:26.68,Default,,0,0,0,,осы уақыт желісіндегі нақты соңғы мерзімді
Dialogue: 0,0:21:26.98,0:21:30.82,Default,,0,0,0,,Баяғыда достарым маған: «Ақымақ» дейтін.
Dialogue: 0,0:21:30.92,0:21:31.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:32.39,0:21:34.32,Default,,0,0,0,,Бұл менің кінәм деп ойлаймын.
Dialogue: 0,0:21:34.62,0:21:38.43,Default,,0,0,0,,Мен сені ұстағым келеді, бірақ бұл жерде кек алу шабуылы шығар.
Dialogue: 0,0:21:38.53,0:21:42.03,Default,,0,0,0,,Мен бәрібір өлтіретін болсам, мен бәрі үшін өлгім келеді.
Dialogue: 0,0:21:42.53,0:21:43.50,Default,,0,0,0,,Бірақ-
Dialogue: 0,0:21:43.86,0:21:46.60,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:21:52.94,0:21:54.78,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:21:56.71,0:21:59.08,Default,,0,0,0,,Сізбен күдікті Куруруги хабарласқан сияқты.
Dialogue: 0,0:21:59.38,0:22:01.38,Default,,0,0,0,,Нөл оны шығарғанын көру дұрыс емес пе?
Dialogue: 0,0:22:01.48,0:22:03.82,Default,,0,0,0,,Бірақ бастапқы адам өлтірді деген айып...
Dialogue: 0,0:22:03.92,0:22:05.92,Default,,0,0,0,,Негіз бұлыңғыр болды...
Dialogue: 0,0:22:06.02,0:22:08.92,Default,,0,0,0,,Қатардағы Куруруги Бұл үшін ақталу мүмкіндігі бар...
Dialogue: 0,0:22:09.36,0:22:10.02,Default,,0,0,0,,Сізге жақсы
Dialogue: 0,0:22:10.32,0:22:11.79,Default,,0,0,0,,Заңды түсіндіру дегеніміз не? ―
Dialogue: 0,0:22:11.89,0:22:12.99,Default,,0,0,0,,Түсіндіру…
Dialogue: 0,0:22:13.09,0:22:14.59,Default,,0,0,0,,Сакиоко-сан?
Dialogue: 0,0:22:17.73,0:22:21.40,Default,,0,0,0,,♪～
Dialogue: 0,0:22:21.50,0:22:25.04,Default,,0,0,0,,♪ Мен кеттім, бірақ мен арыстан мен жолбарыстың арылдаған жолмен жүріп келемін
Dialogue: 0,0:22:25.34,0:22:28.91,Default,,0,0,0,,♪Қызыл аспанның арғы жағында, Махороба
Dialogue: 0,0:22:29.01,0:22:32.71,Default,,0,0,0,,♪Тұтқынның жалғыздығында қаңғыған жас
Dialogue: 0,0:22:32.81,0:22:36.55,Default,,0,0,0,,♪Әлсіздік пен ашу көзге көрінбейтін жау ма?
Dialogue: 0,0:22:36.65,0:22:42.02,Default,,0,0,0,,♪Әке, мен өзімді әлі білмеймін.
Dialogue: 0,0:22:44.06,0:22:48.10,Default,,0,0,0,,♪Алдыңғы ағайындар
Dialogue: 0,0:22:48.40,0:22:51.80,Default,,0,0,0,,♪Көрінбейтін арқаңа ерсең
Dialogue: 0,0:22:51.90,0:22:58.87,Default,,0,0,0,,♪Таң жұлдызы сізді адасқан түнге шақырады
Dialogue: 0,0:22:59.54,0:23:02.98,Default,,0,0,0,,♪Өліммен бітпейді
Dialogue: 0,0:23:03.08,0:23:06.78,Default,,0,0,0,,♪Арманымды аңсасам да
Dialogue: 0,0:23:06.88,0:23:10.62,Default,,0,0,0,,♪Сенімді адам сенсің
Dialogue: 0,0:23:10.72,0:23:14.59,Default,,0,0,0,,♪Менің өмірім
Dialogue: 0,0:23:14.69,0:23:18.49,Default,,0,0,0,,♪Қатты жел айдалада, Көбелектер мен гүлдермен өмір сүремін.
Dialogue: 0,0:23:18.59,0:23:22.16,Default,,0,0,0,,♪Мәңгілік көктемде гүлдеген дәмді елес
Dialogue: 0,0:23:22.46,0:23:26.00,Default,,0,0,0,,♪Бұл дене лас болса да лайдың тазалығы
Dialogue: 0,0:23:26.10,0:23:29.87,Default,,0,0,0,,♪Жүрегіңіздің сырына сеніңіз
Dialogue: 0,0:23:29.97,0:23:35.58,Default,,0,0,0,,♪Анашым, көз жасымды көрсетпесем де.
Dialogue: 0,0:23:35.74,0:23:40.41,Default,,0,0,0,,♪Аяғымның астындағы шөпте
Dialogue: 0,0:23:40.51,0:23:45.85,Default,,0,0,0,,♪Шық ешқашан кетпейді
Dialogue: 0,0:23:49.72,0:23:50.89,Default,,0,0,0,,Тым тәтті...
Dialogue: 0,0:23:50.99,0:23:53.63,Default,,0,0,0,,Созаку түсінеді деп ойладым...
Dialogue: 0,0:23:53.73,0:23:55.63,Default,,0,0,0,,Жүйені ішінен өзгертеміз бе? ―
Dialogue: 0,0:23:55.73,0:23:56.53,Default,,0,0,0,,Ақымақ! ―
Dialogue: 0,0:23:56.63,0:23:58.57,Default,,0,0,0,,Тек сол жүйеге кіріңіз.
Dialogue: 0,0:23:58.67,0:23:59.93,Default,,0,0,0,,Тек өлтіріңіз.
Dialogue: 0,0:24:00.13,0:24:02.87,Default,,0,0,0,,Бата мен зекет алатындай өмір сүру қалай...
Dialogue: 0,0:24:02.97,0:24:04.14,Default,,0,0,0,,Мен таңдамаймын
Dialogue: 0,0:24:04.44,0:24:07.84,Default,,0,0,0,,Өйткені маған енді ондай бақылау қажет емес.
Dialogue: 0,0:24:09.34,0:24:15.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory