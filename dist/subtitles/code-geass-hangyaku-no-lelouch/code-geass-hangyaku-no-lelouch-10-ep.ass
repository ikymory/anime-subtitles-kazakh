Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.26,0:00:04.27,Default,,0,0,0,,Лелуч, Британдық бала...
Dialogue: 0,0:00:04.37,0:00:06.37,Default,,0,0,0,,Екі өкілеттігі бар.
Dialogue: 0,0:00:06.47,0:00:08.17,Default,,0,0,0,,Бірі – Геасс-
Dialogue: 0,0:00:08.27,0:00:11.71,Default,,0,0,0,,Кез келген қарсыласқа пәрмен беруге мүмкіндік беретін абсолютті бағыну күші.
Dialogue: 0,0:00:12.71,0:00:14.68,Default,,0,0,0,,Бірі - Қара рыцарьлар.
Dialogue: 0,0:00:14.78,0:00:19.71,Default,,0,0,0,,Әкесі басқарған Британ империясын жою үшін оның әскері.
Dialogue: 0,0:00:20.38,0:00:23.45,Default,,0,0,0,,Zero кодтық атауын пайдаланып, Лелуш қозғала бастайды.
Dialogue: 0,0:00:24.65,0:00:26.42,Default,,0,0,0,,Анамның жауынан кек алу үшін...
Dialogue: 0,0:00:26.52,0:00:31.26,Default,,0,0,0,,Менің сіңілім Нуналли бақытты өмір сүретін жер жасау үшін...
Dialogue: 0,0:00:31.73,0:00:35.56,Default,,0,0,0,,Бұл әрекет қандай нәтиже береді? ―
Dialogue: 0,0:00:35.73,0:00:38.37,Default,,0,0,0,,Әлі ешкім білмейді
Dialogue: 0,0:00:38.60,0:00:44.61,Default,,0,0,0,,♪～
Dialogue: 0,0:00:47.21,0:00:51.11,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:00:51.21,0:00:54.48,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:00:54.58,0:01:00.36,Default,,0,0,0,,♪Сәт әрқашан жаныңда...
Dialogue: 0,0:01:02.39,0:01:08.70,Default,,0,0,0,,♪ Тітіркенуді жасыра алмайды
Dialogue: 0,0:01:09.43,0:01:15.70,Default,,0,0,0,,♪ Бір орында тұрып өзіңе қара
Dialogue: 0,0:01:15.84,0:01:19.31,Default,,0,0,0,,♪ойланып отырып, уайымдап
Dialogue: 0,0:01:19.41,0:01:22.71,Default,,0,0,0,,♪Өкінішпен шешім қабылдау керек.
Dialogue: 0,0:01:22.81,0:01:26.38,Default,,0,0,0,,♪Сен маған берген бір сөз
Dialogue: 0,0:01:26.48,0:01:30.19,Default,,0,0,0,,♪Менің шатасуым жоғалады
Dialogue: 0,0:01:30.29,0:01:36.46,Default,,0,0,0,,♪Бос бөлмеме нұр түсті.
Dialogue: 0,0:01:36.69,0:01:39.69,Default,,0,0,0,,♪Мен қараған аспан
Dialogue: 0,0:01:39.79,0:01:43.87,Default,,0,0,0,,♪Ашық және көгілдір болып барады
Dialogue: 0,0:01:44.17,0:01:50.44,Default,,0,0,0,,♪Мен жабық терезені ашуды жөн көрдім.
Dialogue: 0,0:01:50.67,0:01:54.54,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:01:54.64,0:01:57.68,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:01:58.28,0:02:04.55,Default,,0,0,0,,♪Сәтті сезін, осында және қазір...
Dialogue: 0,0:02:23.61,0:02:25.84,Default,,0,0,0,,Иә? Британдық...
Dialogue: 0,0:02:26.21,0:02:29.68,Default,,0,0,0,,Шпион үшін бұл әсерлі. Сіз принципшісіз бе?
Dialogue: 0,0:02:29.78,0:02:33.28,Default,,0,0,0,,) Бұл тамаша нәрсе. Қосылғысы келетіндер көбейді.
Dialogue: 0,0:02:33.38,0:02:34.85,Default,,0,0,0,,Мен ойлағаннан да оңай болды.
Dialogue: 0,0:02:35.62,0:02:36.89,Default,,0,0,0,,Мен Британияны жек көремін, бірақ...
Dialogue: 0,0:02:37.19,0:02:39.45,Default,,0,0,0,,Терроризм әдісімен келіспеймін.
Dialogue: 0,0:02:39.55,0:02:41.89,Default,,0,0,0,,Бұл он бір көпшіліктің пікірі.
Dialogue: 0,0:02:42.19,0:02:45.73,Default,,0,0,0,,Сондықтан он бірлердің көпшілігі Қара рыцарьларды қолдайды.
Dialogue: 0,0:02:46.19,0:02:49.33,Default,,0,0,0,,Осының арқасында топта әрекет ету оңайырақ болды.
Dialogue: 0,0:02:49.43,0:02:52.77,Default,,0,0,0,,Халық тек режимге хабар бермесе, үлкен көмек болар еді.
Dialogue: 0,0:02:52.87,0:02:54.80,Default,,0,0,0,,Киото деген топ та бар.
Dialogue: 0,0:02:54.90,0:02:57.44,Default,,0,0,0,,Олар Nightmare-ді айналдырады дейді.
Dialogue: 0,0:02:57.54,0:02:59.81,Default,,0,0,0,,Ақпараттық қамтамасыз ету де жеделдетілген қарқынмен өсуде.
Dialogue: 0,0:03:00.48,0:03:03.41,Default,,0,0,0,,Жапондықтар төбелеске қарсы әлсіз.
Dialogue: 0,0:03:03.51,0:03:05.81,Default,,0,0,0,,Біз растай алатын кеңістікті жасағанша
Dialogue: 0,0:03:05.91,0:03:07.88,Default,,0,0,0,,Сіз осы мақсат үшін әділдіктің одақтасысыз ба?
Dialogue: 0,0:03:08.48,0:03:11.49,Default,,0,0,0,,Оны бәрі жақсы көреді, солай ма?Әділдік одақтастары
Dialogue: 0,0:03:11.59,0:03:15.49,Default,,0,0,0,,Хехе, бұл әділдік одақтасының жүзі емес.
Dialogue: 0,0:03:16.19,0:03:17.33,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:03:17.53,0:03:19.59,Default,,0,0,0,,Мен төмендетілдім.
Dialogue: 0,0:03:19.69,0:03:21.23,Default,,0,0,0,,Дәл сіз сияқты
Dialogue: 0,0:03:21.33,0:03:21.86,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:21.96,0:03:24.47,Default,,0,0,0,,Сондықтан мен сенің күшіңді қарызға алғым келеді.
Dialogue: 0,0:03:24.57,0:03:26.80,Default,,0,0,0,,Біздің бұлай аяқтау ниетіміз жоқ.
Dialogue: 0,0:03:26.90,0:03:27.87,Default,,0,0,0,,Сіз де, солай ма?
Dialogue: 0,0:03:27.97,0:03:29.50,Default,,0,0,0,,Ал, сіз қалай ойлайсыз?
Dialogue: 0,0:03:29.84,0:03:31.44,Default,,0,0,0,,Мен нөлге қатысты анықтаманы таптым!
Dialogue: 0,0:03:31.54,0:03:32.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:32.67,0:03:34.84,Default,,0,0,0,,Жеке Эшфорд академиясы
Dialogue: 0,0:03:34.94,0:03:37.55,Default,,0,0,0,,Мен сізден сол жердегі студент жігітті тергеуіңізді қалаймын.
Dialogue: 0,0:03:37.65,0:03:39.71,Default,,0,0,0,,Нөлдің серіктесі сияқты.
Dialogue: 0,0:03:39.81,0:03:41.25,Default,,0,0,0,,Біз әскери қызмет үшін
Dialogue: 0,0:03:41.55,0:03:44.22,Default,,0,0,0,,Мен Нарита тау жотасына баруым керек...
Dialogue: 0,0:03:44.32,0:03:44.99,Default,,0,0,0,,Бұл арада…
Dialogue: 0,0:03:45.52,0:03:47.32,Default,,0,0,0,,Хмм, Нарита? ―
Dialogue: 0,0:03:47.62,0:03:51.59,Default,,0,0,0,,Жапон азаттық майданының штаб-пәтері болуы мүмкін немесе болмауы мүмкін деген қауесет бар...
Dialogue: 0,0:03:51.69,0:03:53.60,Default,,0,0,0,,Бұл тым қысқартылған болса да ескеру керек.
Dialogue: 0,0:03:54.23,0:03:55.70,Default,,0,0,0,,Ол тым қалың.
Dialogue: 0,0:03:58.70,0:03:59.63,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:59.93,0:04:01.44,Default,,0,0,0,,Бұл Глазго ма?
Dialogue: 0,0:04:01.54,0:04:03.74,Default,,0,0,0,,Бурай: Оны Жапония өзгерткен.
Dialogue: 0,0:04:03.84,0:04:05.67,Default,,0,0,0,,Мен мұндай нәрсені бірінші рет көріп тұрмын!
Dialogue: 0,0:04:05.77,0:04:07.01,Default,,0,0,0,,Сізде күш бар.
Dialogue: 0,0:04:07.31,0:04:08.48,Default,,0,0,0,,Қара рыцарлар күткендей (мүше)
Dialogue: 0,0:04:08.58,0:04:10.51,Default,,0,0,0,,Қабылдау емтиханы да оңай болған жоқ.
Dialogue: 0,0:04:10.61,0:04:12.88,Default,,0,0,0,,Бұл біздің элитамыз дегенді білдіре ме? элита?
Dialogue: 0,0:04:12.98,0:04:14.28,Default,,0,0,0,,Ол жанып жатыр.
Dialogue: 0,0:04:14.65,0:04:17.29,Default,,0,0,0,,Киото халқы, осы уақытқа дейін.
Dialogue: 0,0:04:17.58,0:04:20.45,Default,,0,0,0,,Бұл жапондықтардың керемет түні!
Dialogue: 0,0:04:20.56,0:04:21.69,Default,,0,0,0,,Гүрен 2-ші стиль
Dialogue: 0,0:04:21.79,0:04:22.89,Default,,0,0,0,,Сіз нұсқаулықты көрдіңіз бе?
Dialogue: 0,0:04:22.99,0:04:25.46,Default,,0,0,0,,Радиациялық толқындар, солай ма?Бұл тамаша қару
Dialogue: 0,0:04:25.56,0:04:27.53,Default,,0,0,0,,Хехехе, мен өте қуаныштымын.
Dialogue: 0,0:04:27.83,0:04:29.33,Default,,0,0,0,,Киотоның ұлылары да-
Dialogue: 0,0:04:29.43,0:04:31.70,Default,,0,0,0,,Бұл біз Қара Рыцарларды таныдық дегенді білдіреді.
Dialogue: 0,0:04:31.80,0:04:33.00,Default,,0,0,0,,Сенпай! (Тамаки) А?
Dialogue: 0,0:04:33.30,0:04:35.27,Default,,0,0,0,,Бұл жабдықты қалай пайдалануым керек?
Dialogue: 0,0:04:35.37,0:04:37.61,Default,,0,0,0,,А, мен қазір барамын. Сәл күте тұрыңыз.
Dialogue: 0,0:04:37.71,0:04:40.28,Default,,0,0,0,,Оған көмектесу мүмкін емес, жаңадан келген.
Dialogue: 0,0:04:42.84,0:04:45.91,Default,,0,0,0,,Тамаки былай тұрсын, тіпті Иноуэ де, басқалары да қобалжыды.
Dialogue: 0,0:04:46.28,0:04:47.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:47.35,0:04:48.82,Default,,0,0,0,,Киотода бірнеше қарсылық бар...
Dialogue: 0,0:04:48.92,0:04:50.72,Default,,0,0,0,,Олар сізді қолдап жатқанын естідім.
Dialogue: 0,0:04:50.82,0:04:53.76,Default,,0,0,0,,Иә, олар бізді ішке кіргізді.
Dialogue: 0,0:04:53.92,0:04:56.59,Default,,0,0,0,,Жоқ, сен қателесесің, Карен.
Dialogue: 0,0:04:56.69,0:04:58.79,Default,,0,0,0,,Бұл жай ғана сынақ
Dialogue: 0,0:04:58.89,0:05:00.43,Default,,0,0,0,,Сіз осылай ойласаңыз да...
Dialogue: 0,0:05:00.53,0:05:01.70,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:05:01.80,0:05:03.00,Default,,0,0,0,,Бұл оң.
Dialogue: 0,0:05:03.36,0:05:04.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:05.90,0:05:06.77,Default,,0,0,0,,Бұл…
Dialogue: 0,0:05:07.04,0:05:09.67,Default,,0,0,0,,Екінші Гурен стилі сізге тиесілі, Карен.
Dialogue: 0,0:05:09.90,0:05:12.54,Default,,0,0,0,,Мен? Бірақ қазір адамдар көбейіп кетті
Dialogue: 0,0:05:12.64,0:05:14.84,Default,,0,0,0,,Ал егер сізде Гуреннің қорғаныс күші болса, онда сіз ...
Dialogue: 0,0:05:14.94,0:05:16.71,Default,,0,0,0,,Сіз ұшқышсыз.
Dialogue: 0,0:05:16.81,0:05:18.38,Default,,0,0,0,,Мен командирмін.
Dialogue: 0,0:05:18.48,0:05:21.48,Default,,0,0,0,,Мен төбелесімді қолданамын, бірақ сіз шайқаста жалғыз қозырсыз.
Dialogue: 0,0:05:21.58,0:05:23.85,Default,,0,0,0,,Оның үстіне... ұрысуға себеп бар.
Dialogue: 0,0:05:23.95,0:05:24.99,Default,,0,0,0,,Ах
Dialogue: 0,0:05:26.02,0:05:27.02,Default,,0,0,0,,Иә
Dialogue: 0,0:05:27.82,0:05:29.49,Default,,0,0,0,,) Нөл, қарсы боласың ба? иә?
Dialogue: 0,0:05:29.92,0:05:33.56,Default,,0,0,0,,Бірге қосылғысы келетін британиялықтан біртүрлі ақпарат келді.
Dialogue: 0,0:05:33.66,0:05:34.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:35.03,0:05:37.80,Default,,0,0,0,,Бізді сыртқа шығаратын тұзақ емес пе? ―
Dialogue: 0,0:05:37.90,0:05:42.47,Default,,0,0,0,,Артынан өткіңіз келсе де, бұл адамға абайсызда жақындау қауіпті.
Dialogue: 0,0:05:42.57,0:05:44.74,Default,,0,0,0,,Бірақ оны елемеу үшін тым көп ақпарат.
Dialogue: 0,0:05:44.84,0:05:46.34,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:05:46.84,0:05:48.44,Default,,0,0,0,,Мүмкін мен демалыс күндері жаяу серуендейтін шығармын.
Dialogue: 0,0:05:48.54,0:05:51.01,Default,,0,0,0,,А? (Лелуш) Нарита тауларына
Dialogue: 0,0:05:51.11,0:05:52.05,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:05:54.85,0:05:55.92,Default,,0,0,0,,Сакиоко
Dialogue: 0,0:05:56.02,0:05:58.35,Default,,0,0,0,,Маған таңғы ас керек емес.
Dialogue: 0,0:05:58.45,0:05:59.95,Default,,0,0,0,,Сіз шығасыз ба?
Dialogue: 0,0:06:00.05,0:06:02.56,Default,,0,0,0,,Мен бүгіннен бастап үш күнге жуық сапарға шығамын.
Dialogue: 0,0:06:02.79,0:06:03.93,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:04.03,0:06:07.66,Default,,0,0,0,,Соңғы кездері көшеге жиі шығып жүрсің. Бұл сіздің дос қызыңызбен бе?
Dialogue: 0,0:06:07.76,0:06:10.50,Default,,0,0,0,,А... солай шығар.
Dialogue: 0,0:06:13.77,0:06:15.90,Default,,0,0,0,,5-бөлім Аномалиялар жоқ.
Dialogue: 0,0:06:16.00,0:06:18.77,Default,,0,0,0,,Иә, келесі жоспарланған контакт 2 сағаттан кейін болады.
Dialogue: 0,0:06:19.64,0:06:21.78,Default,,0,0,0,,Ешқандай ауытқу болуы мүмкін емес.
Dialogue: 0,0:06:21.88,0:06:24.95,Default,,0,0,0,,Бұл біздің Жапон азаттық майданының ықпал ету аймағы.
Dialogue: 0,0:06:24.95,0:06:25.58,Default,,0,0,0,,Бұл біздің Жапония азат ету майданының ықпал ету аймағы.
Dialogue: 0,0:06:24.95,0:06:25.58,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:25.58,0:06:25.71,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:25.71,0:06:26.38,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:25.71,0:06:26.38,Default,,0,0,0,,Иә? (Байқау) А.
Dialogue: 0,0:06:26.38,0:06:26.71,Default,,0,0,0,,Иә? (Байқау) А.
Dialogue: 0,0:06:27.65,0:06:29.08,Default,,0,0,0,,Нөл! (Лелуш) Тынышталыңыз.
Dialogue: 0,0:06:29.38,0:06:30.72,Default,,0,0,0,,Мен жаңа ғана сөйлесуге келдім.
Dialogue: 0,0:06:31.42,0:06:33.12,Default,,0,0,0,,Балалар, оны елемеуге болады.
Dialogue: 0,0:06:33.42,0:06:34.69,Default,,0,0,0,,Барлық ауытқулар
Dialogue: 0,0:06:41.16,0:06:42.63,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:06:42.73,0:06:43.83,Default,,0,0,0,,Ей, сенің кезегің.
Dialogue: 0,0:06:44.13,0:06:47.84,Default,,0,0,0,,Асықпа, мен әскери борышын өтеп жатырмын.
Dialogue: 0,0:06:52.71,0:06:54.51,Default,,0,0,0,,Мен сигналды нөлден растадым.
Dialogue: 0,0:06:54.61,0:06:56.11,Default,,0,0,0,,々２
Dialogue: 0,0:06:58.48,0:07:01.15,Default,,0,0,0,,Нөл жігіт, сен неге сенімсіз радионы қолданбайсың?
Dialogue: 0,0:07:01.45,0:07:04.45,Default,,0,0,0,,Жаяу жүру дегенді қалай түсінесіз?
Dialogue: 0,0:07:04.65,0:07:05.99,Default,,0,0,0,,Әскери дайындық, солай ма?
Dialogue: 0,0:07:06.09,0:07:08.16,Default,,0,0,0,,Тек нөл басқа жерде ме?
Dialogue: 0,0:07:08.46,0:07:09.92,Default,,0,0,0,,Олар ыстық бұлақтарды қазбай ма?
Dialogue: 0,0:07:10.02,0:07:12.96,Default,,0,0,0,,А, мен бұл экскаватордың осы мақсатқа арналған екенін түсіндім.
Dialogue: 0,0:07:13.06,0:07:14.83,Default,,0,0,0,,Карен, сен ештеңе естіген жоқсың ба?
Dialogue: 0,0:07:14.93,0:07:16.63,Default,,0,0,0,,А... келіңдер.
Dialogue: 0,0:07:16.83,0:07:17.73,Default,,0,0,0,,Желдеткіш туралы не деуге болады?
Dialogue: 0,0:07:17.83,0:07:19.50,Default,,0,0,0,,Жарайды, осы сұраққа жауап…
Dialogue: 0,0:07:20.47,0:07:22.97,Default,,0,0,0,,Нөл байланыс арқылы кері анықтаудан аулақ болды.
Dialogue: 0,0:07:23.54,0:07:24.87,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:07:25.11,0:07:27.84,Default,,0,0,0,,Корнелия Бұл күн де ​​келді.
Dialogue: 0,0:07:27.94,0:07:28.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:29.18,0:07:30.45,Default,,0,0,0,,Ах
Dialogue: 0,0:07:31.05,0:07:32.01,Default,,0,0,0,,Осы салада-
Dialogue: 0,0:07:32.11,0:07:34.92,Default,,0,0,0,,Жапон азаттық майданының штаб-пәтері бар екені анық.
Dialogue: 0,0:07:35.78,0:07:38.85,Default,,0,0,0,,４７
Dialogue: 0,0:07:39.62,0:07:43.79,Default,,0,0,0,,Губернатордың белгісін күткеннен кейін біз қоршауды тез тарылтып, оларды жойып жібердік.
Dialogue: 0,0:07:44.19,0:07:45.49,Default,,0,0,0,,Қоршаудың сыртынан
Dialogue: 0,0:07:45.59,0:07:47.50,Default,,0,0,0,,Жаулар болады ма?
Dialogue: 0,0:07:47.60,0:07:48.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:48.50,0:07:49.56,Default,,0,0,0,,Нөл?
Dialogue: 0,0:07:49.66,0:07:55.04,Default,,0,0,0,,Уайымдамаңыз, операция басталған бойда айналадағы жолдар мен тау жолдарын жабамыз.
Dialogue: 0,0:07:55.14,0:07:56.00,Default,,0,0,0,,Югун да бар.
Dialogue: 0,0:07:56.70,0:08:00.24,Default,,0,0,0,,Егер ол нашар көрінсе, бұл Нөлдің соңғы сәті болады.
Dialogue: 0,0:08:00.54,0:08:01.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:01.61,0:08:04.71,Default,,0,0,0,,Танысқым келеді десем де, түсінесің бе? ―
Dialogue: 0,0:08:04.91,0:08:07.18,Default,,0,0,0,,Мына жерде ханшайым, мынау қарапайым халық.
Dialogue: 0,0:08:07.48,0:08:09.85,Default,,0,0,0,,Бұл Джек қонақ үйімен қандай байланыс?
Dialogue: 0,0:08:09.95,0:08:11.12,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:11.22,0:08:14.72,Default,,0,0,0,,Евфемияға... рахмет айтпадым...
Dialogue: 0,0:08:14.82,0:08:16.22,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:08:16.52,0:08:18.89,Default,,0,0,0,,Бұрын біз дәл осылай жасай алдық...
Dialogue: 0,0:08:19.49,0:08:22.83,Default,,0,0,0,,Әй, төрағаның немересі қандай әлеуметтік мәртебеге ие?
Dialogue: 0,0:08:22.93,0:08:24.67,Default,,0,0,0,,Хмм, солай ма?
Dialogue: 0,0:08:24.77,0:08:26.50,Default,,0,0,0,,… …
Dialogue: 0,0:08:27.00,0:08:29.97,Default,,0,0,0,,C.C. Сен не істеп жатырсың? Осындай жерде
Dialogue: 0,0:08:30.07,0:08:32.14,Default,,0,0,0,,Сіз мені қорғайтыныңызды айттыңыз, солай ма?
Dialogue: 0,0:08:32.24,0:08:33.77,Default,,0,0,0,,Қамқоршы болып көріну
Dialogue: 0,0:08:34.54,0:08:37.18,Default,,0,0,0,,Лелуш, сен неге Лелушсың?
Dialogue: 0,0:08:37.28,0:08:39.98,Default,,0,0,0,,Философия туралы айтуға уақытым жоқ.
Dialogue: 0,0:08:40.18,0:08:45.82,Default,,0,0,0,,Фамилия Ламперуге өзгертілді, бірақ Лелуш есімі қалды.
Dialogue: 0,0:08:46.75,0:08:49.06,Default,,0,0,0,,Бұл аңғалдық. Мен өткенді қоя алмаймын.
Dialogue: 0,0:08:49.16,0:08:51.19,Default,,0,0,0,,Сондықтан да С.С. тым алысқа барады.
Dialogue: 0,0:08:51.29,0:08:52.69,Default,,0,0,0,,Адам есімі емес
Dialogue: 0,0:08:53.73,0:08:54.63,Default,,0,0,0,,Ах
Dialogue: 0,0:08:59.57,0:09:03.17,Default,,0,0,0,,Лелуш Қардың неге ақ екенін білесіз бе?
Dialogue: 0,0:09:03.27,0:09:04.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:04.81,0:09:08.61,Default,,0,0,0,,Өйткені мен қандай түсті екенімді ұмытып қалдым
Dialogue: 0,0:09:09.28,0:09:10.91,Default,,0,0,0,,Барлық қызметкерлер тағайындалды
Dialogue: 0,0:09:11.15,0:09:12.05,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:09:12.15,0:09:14.92,Default,,0,0,0,,Euphemia жоспарланғандай G-1 жүйесінде логистикалық қолдау көрсетеді.
Dialogue: 0,0:09:15.02,0:09:16.72,Default,,0,0,0,,Маған гигиеналық топты басқаруға рұқсат етіңіз.
Dialogue: 0,0:09:16.82,0:09:18.05,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:09:18.75,0:09:19.79,Default,,0,0,0,,Құрметті Корнелия
Dialogue: 0,0:09:19.89,0:09:22.79,Default,,0,0,0,,Гилфорд? Юффи дейсіз бе?
Dialogue: 0,0:09:22.89,0:09:26.13,Default,,0,0,0,,Иә Ол мемлекеттік кеңседе болуы керек емес пе?
Dialogue: 0,0:09:26.23,0:09:28.26,Default,,0,0,0,,Бұл таңқаларлық қыңыр.
Dialogue: 0,0:09:29.00,0:09:31.93,Default,,0,0,0,,Ол нақты шайқасты көргісі келетінін айтты.
Dialogue: 0,0:09:32.17,0:09:33.03,Default,,0,0,0,,А? ―
Dialogue: 0,0:09:33.33,0:09:35.80,Default,,0,0,0,,Арттағы сол әскерлер қандай?
Dialogue: 0,0:09:35.90,0:09:38.17,Default,,0,0,0,,Он бір ұшқышы бар әскери күш.
Dialogue: 0,0:09:38.27,0:09:40.04,Default,,0,0,0,,Иә? Бұл Ланселот па?
Dialogue: 0,0:09:40.14,0:09:42.74,Default,,0,0,0,,Сандардың қалай қозғалатынының жұмбақ түні
Dialogue: 0,0:09:42.84,0:09:44.88,Default,,0,0,0,,Әдетте бұған жол берілмейді.
Dialogue: 0,0:09:45.05,0:09:47.95,Default,,0,0,0,,Ол бірлік екінші князьдің бауырынан құралған.
Dialogue: 0,0:09:48.05,0:09:50.79,Default,,0,0,0,,Біздің адам құқықтарымыз бізге таралмайды.
Dialogue: 0,0:09:50.89,0:09:54.16,Default,,0,0,0,,Дегенмен, маған жекпе-жек жаттықтыруға мүмкіндігінше көбірек мүмкіндік берілгенін қалаймын.
Dialogue: 0,0:09:56.09,0:09:57.93,Default,,0,0,0,,Эй, сен шынымен мұны істейсің бе?
Dialogue: 0,0:09:58.03,0:09:59.59,Default,,0,0,0,,Қарсылас Корнелия.
Dialogue: 0,0:09:59.69,0:10:02.16,Default,,0,0,0,,Бұл Британиядағы ең қуатты әскери күштердің бірі.
Dialogue: 0,0:10:02.26,0:10:04.87,Default,,0,0,0,,Сондықтан біз Жапон азаттық майданымен ынтымақтастық...
Dialogue: 0,0:10:04.97,0:10:06.00,Default,,0,0,0,,Қазір тым кеш пе? ―
Dialogue: 0,0:10:06.10,0:10:08.84,Default,,0,0,0,,Оуги Маған сене алмайсыз ба?
Dialogue: 0,0:10:08.94,0:10:11.81,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мен мұны істеуді сұрадым.
Dialogue: 0,0:10:11.91,0:10:13.17,Default,,0,0,0,,Мен сенің көшбасшы болғаныңды қалаймын
Dialogue: 0,0:10:13.61,0:10:15.24,Default,,0,0,0,,Сонда бір ғана жауап бар.
Dialogue: 0,0:10:15.34,0:10:17.01,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:10:17.65,0:10:19.21,Default,,0,0,0,,Губернатор, уақыт келді.
Dialogue: 0,0:10:19.31,0:10:21.25,Default,,0,0,0,,Жарайды, операцияны бастаңыз!
Dialogue: 0,0:10:23.85,0:10:25.39,Default,,0,0,0,,Жапония азат ету майданы-
Dialogue: 0,0:10:26.89,0:10:29.32,Default,,0,0,0,,Кейде артта қалғандар...
Dialogue: 0,0:10:29.62,0:10:31.96,Default,,0,0,0,,Өзін жақсы көруді ұмытқандар...
Dialogue: 0,0:10:32.06,0:10:35.86,Default,,0,0,0,,Қазір Махоробаның арманымен бірге ыдырап, жойылатын уақыт.
Dialogue: 0,0:10:39.37,0:10:40.23,Default,,0,0,0,,Жау шабуылы ма?
Dialogue: 0,0:10:40.70,0:10:41.67,Default,,0,0,0,,Британ әскері
Dialogue: 0,0:10:41.77,0:10:44.01,Default,,0,0,0,,Ол бүкіл Нарита тауларын қоршап жатыр.
Dialogue: 0,0:10:44.11,0:10:45.87,Default,,0,0,0,,100
Dialogue: 0,0:10:48.08,0:10:50.11,Default,,0,0,0,,Бұл басталды (жанкүйер) Ах...
Dialogue: 0,0:10:50.21,0:10:51.98,Default,,0,0,0,,Әзіл...
Dialogue: 0,0:10:52.08,0:10:53.81,Default,,0,0,0,,Қалжың емес! Нөл
Dialogue: 0,0:10:53.91,0:10:56.18,Default,,0,0,0,,Ондай бірдеңе келсе, бізді толығымен қоршап алады! ―
Dialogue: 0,0:10:56.28,0:10:57.22,Default,,0,0,0,,Тіпті үйге қайтар жолда...
Dialogue: 0,0:10:57.32,0:10:58.95,Default,,0,0,0,,Ол әлдеқашан құлыпталған.
Dialogue: 0,0:10:59.29,0:11:02.26,Default,,0,0,0,,Тірі қалудың жалғыз жолы - бұл жерде соғысу.
Dialogue: 0,0:11:02.36,0:11:04.33,Default,,0,0,0,,… …
Dialogue: 0,0:11:04.89,0:11:07.90,Default,,0,0,0,,Біз төбелесуіміз керек дейсіз бе?Мен қоршалғанмын!
Dialogue: 0,0:11:08.00,0:11:11.97,Default,,0,0,0,,Оның үстіне қарсыласы Корнелия армиясы, ол бұрынғыдан әлдеқайда көп күш.
Dialogue: 0,0:11:12.20,0:11:13.07,Default,,0,0,0,,Ах-
Dialogue: 0,0:11:13.17,0:11:15.00,Default,,0,0,0,,Осы жолмен жеңсек, бұл керемет болар еді.
Dialogue: 0,0:11:15.10,0:11:16.10,Default,,0,0,0,,Нөл! қазір!
Dialogue: 0,0:11:16.67,0:11:18.37,Default,,0,0,0,,Тіпті Мәсіхтің өзі керемет жасауы керек...
Dialogue: 0,0:11:18.67,0:11:20.14,Default,,0,0,0,,Танылмаған.
Dialogue: 0,0:11:20.24,0:11:23.04,Default,,0,0,0,,Егер солай болса, бізге де ғажайып керек.
Dialogue: 0,0:11:23.21,0:11:26.98,Default,,0,0,0,,Көрдіңіз бе, ғажайыптар арзанға сатылмайды!
Dialogue: 0,0:11:27.08,0:11:29.88,Default,,0,0,0,,Көшбасшы бола алмайсың ғой! Мен солмын...
Dialogue: 0,0:11:30.22,0:11:31.99,Default,,0,0,0,,О... (Тамаки) Уф.
Dialogue: 0,0:11:35.16,0:11:36.22,Default,,0,0,0,,Ах... (Лелух) Қазірдің өзінде...
Dialogue: 0,0:11:36.32,0:11:37.76,Default,,0,0,0,,Қашу жолы кесілді.
Dialogue: 0,0:11:37.86,0:11:43.20,Default,,0,0,0,,Менсіз жеңемін деп ойлаған адам мені атып таста!
Dialogue: 0,0:11:43.46,0:11:45.20,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:11:46.73,0:11:47.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:48.77,0:11:49.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:50.07,0:11:50.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:51.97,0:11:53.27,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:11:53.87,0:11:55.78,Default,,0,0,0,,Мен Қара Рыцарларға қосылғаннан бері...
Dialogue: 0,0:11:55.88,0:11:57.31,Default,,0,0,0,,Тек екі нұсқа бар -
Dialogue: 0,0:11:57.95,0:12:01.05,Default,,0,0,0,,Менімен бірге өмір сүр немесе менімен бірге өл!
Dialogue: 0,0:12:06.82,0:12:08.76,Default,,0,0,0,,Бізді толығымен қоршап алды -
Dialogue: 0,0:12:08.86,0:12:11.26,Default,,0,0,0,,Бір уақытта астыртын серіктестер де қамауға алынған сияқты.
Dialogue: 0,0:12:11.36,0:12:12.33,Default,,0,0,0,,Генерал-майор Катасе
Dialogue: 0,0:12:12.43,0:12:15.23,Default,,0,0,0,,Маған Корнелияның әскерінен берілуімді өтінген хабарлама келді.
Dialogue: 0,0:12:15.40,0:12:19.43,Default,,0,0,0,,Ақымақ! Егер біз осы жерден түссек, Жапонияның қарсыласу әрекеттері аяқталады!
Dialogue: 0,0:12:19.87,0:12:20.80,Default,,0,0,0,,Сонымен, генерал-майор.
Dialogue: 0,0:12:20.90,0:12:23.37,Default,,0,0,0,,Сіз оны ұрасыз ба?Немесе қорғаныс стратегиясын алыңыз
Dialogue: 0,0:12:23.47,0:12:25.94,Default,,0,0,0,,Тодоға не болды? Тодоға не болды?
Dialogue: 0,0:12:26.04,0:12:28.41,Default,,0,0,0,,Бурай Кайды алу үшін Киотоға барыңыз.
Dialogue: 0,0:12:28.51,0:12:30.74,Default,,0,0,0,,Төрт қасиетті қылыш та бірге әрекет етеді.
Dialogue: 0,0:12:30.85,0:12:33.01,Default,,0,0,0,,Жоспарларым бойынша мен жақын арада оралуым керек.
Dialogue: 0,0:12:35.12,0:12:36.85,Default,,0,0,0,,Тодо уақытында орындалмайды.
Dialogue: 0,0:12:36.95,0:12:38.09,Default,,0,0,0,,Бурай Сортқа дайындық
Dialogue: 0,0:12:38.19,0:12:40.86,Default,,0,0,0,,Қоршаудың бір бұрышын бұзып, қашыңыз
Dialogue: 0,0:12:41.12,0:12:44.99,Default,,0,0,0,,Өзіңіздің жапондық мақтаныш пен жігеріңізді қатарға қойыңыз! Қайту уақыты келді
Dialogue: 0,0:12:47.39,0:12:49.76,Default,,0,0,0,,Жаудың тірегі тауда болуы керек...
Dialogue: 0,0:12:49.86,0:12:51.47,Default,,0,0,0,,Мен нақты нүктені білмеймін.
Dialogue: 0,0:12:51.97,0:12:54.44,Default,,0,0,0,,Бірлескен мүшелердің тізімін алу үшін...
Dialogue: 0,0:12:54.54,0:12:56.94,Default,,0,0,0,,Біз әуе соққыларымен бүкіл базаны жоя алмаймыз.
Dialogue: 0,0:12:57.94,0:13:00.14,Default,,0,0,0,,Жау әскеріміздің қоршау желісіне қарсы...
Dialogue: 0,0:13:00.24,0:13:02.01,Default,,0,0,0,,Олар ішінара серпіліс жасауға ұмтылады.
Dialogue: 0,0:13:02.11,0:13:04.01,Default,,0,0,0,,Сол жерден негізгі базаны болжаңыз
Dialogue: 0,0:13:04.11,0:13:06.21,Default,,0,0,0,,Біздің армияда үш фронттық күш бар.
Dialogue: 0,0:13:06.31,0:13:07.52,Default,,0,0,0,,Генерал Далтон -
Dialogue: 0,0:13:07.82,0:13:08.48,Default,,0,0,0,,Генерал Алекс
Dialogue: 0,0:13:08.78,0:13:11.39,Default,,0,0,0,,Ал губернатор Корнелия бастаған әскерлер...
Dialogue: 0,0:13:11.49,0:13:13.02,Default,,0,0,0,,Қанат күші ретінде...
Dialogue: 0,0:13:13.29,0:13:14.39,Default,,0,0,0,,А? (Эфемия) А?
Dialogue: 0,0:13:14.49,0:13:16.22,Default,,0,0,0,,ＥＣＭ
Dialogue: 0,0:13:16.96,0:13:19.06,Default,,0,0,0,,Жақын арада жау әскерлері пайда болуы керек.
Dialogue: 0,0:13:19.16,0:13:23.06,Default,,0,0,0,,Бұл ECCM кеңейтеді Арнаны Альфа 4 (төрт) жүйесіне қосыңыз
Dialogue: 0,0:13:23.23,0:13:25.43,Default,,0,0,0,,Жаудың... қалай айту керек...
Dialogue: 0,0:13:25.53,0:13:26.43,Default,,0,0,0,,Сіз сенімсізсіз бе?
Dialogue: 0,0:13:26.53,0:13:29.34,Default,,0,0,0,,О, тек Глазго имитацияларынан сақ болыңыз.
Dialogue: 0,0:13:29.44,0:13:30.80,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:13:34.54,0:13:37.21,Default,,0,0,0,,Хо, бұл тау бекініске айналды ма?
Dialogue: 0,0:13:37.38,0:13:38.58,Default,,0,0,0,,Мәртебелі, артқа шегініңіз.
Dialogue: 0,0:13:38.88,0:13:42.45,Default,,0,0,0,,Гилфорд Мені ол қыздармен араластырмаңыз.
Dialogue: 0,0:13:44.22,0:13:45.09,Default,,0,0,0,,Мәртебелі Корнелия!
Dialogue: 0,0:13:45.35,0:13:46.82,Default,,0,0,0,,Жоқ! (Жауынгерлік) Корнелия!
Dialogue: 0,0:13:46.92,0:13:48.42,Default,,0,0,0,,Қорқытпаңыз!Генералдың басы!
Dialogue: 0,0:13:48.92,0:13:49.86,Default,,0,0,0,,Елес!
Dialogue: 0,0:13:51.99,0:13:52.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:59.57,0:14:01.07,Default,,0,0,0,,Біздің таңдауымыз жоқ.
Dialogue: 0,0:14:01.17,0:14:02.14,Default,,0,0,0,,Қолдау көрсету
Dialogue: 0,0:14:02.24,0:14:03.14,Default,,0,0,0,,Hmph.
Dialogue: 0,0:14:03.57,0:14:07.41,Default,,0,0,0,,Жүр, Корнелия осында!Маған қарсы шығатын ешкім жоқ па?
Dialogue: 0,0:14:08.08,0:14:10.84,Default,,0,0,0,,Не болды?мені сынап, жеңіңіз
Dialogue: 0,0:14:11.91,0:14:13.38,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:14:13.48,0:14:15.18,Default,,0,0,0,,А, сен көшбасшысың.
Dialogue: 0,0:14:16.38,0:14:18.95,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:14:19.05,0:14:21.16,Default,,0,0,0,,Бұл аймаққа эвакуациялау туралы бұйрық шығарылды.
Dialogue: 0,0:14:21.26,0:14:24.53,Default,,0,0,0,,Егер әлі де біреу қалса, дереу эвакуациялаңыз.
Dialogue: 0,0:14:24.63,0:14:26.39,Default,,0,0,0,,Осы аймақта қайталау...
Dialogue: 0,0:14:26.49,0:14:28.46,Default,,0,0,0,,Неліктен бұл жерді таңдадыңыз?
Dialogue: 0,0:14:29.16,0:14:32.40,Default,,0,0,0,,Егер әскерилер Code R эксперименттік деректерін анықтаса, бәрі аяқталды.
Dialogue: 0,0:14:32.50,0:14:34.47,Default,,0,0,0,,Террористік ықпал ету аймағында
Dialogue: 0,0:14:34.57,0:14:37.20,Default,,0,0,0,,Олар тергеу қиын екенін айтты.
Dialogue: 0,0:14:37.30,0:14:39.31,Default,,0,0,0,,Шешімді генерал Батли қабылдады.
Dialogue: 0,0:14:39.41,0:14:41.01,Default,,0,0,0,,Қазір айтсам да...
Dialogue: 0,0:14:44.21,0:14:45.45,Default,,0,0,0,,Тым нәзік
Dialogue: 0,0:14:46.28,0:14:48.25,Default,,0,0,0,,Мұнда жау күштері шоғырланған.
Dialogue: 0,0:14:48.35,0:14:50.15,Default,,0,0,0,,Сіз дұрыс шығарсыз.
Dialogue: 0,0:14:50.25,0:14:51.42,Default,,0,0,0,,Тараңдар!
Dialogue: 0,0:14:54.66,0:14:56.96,Default,,0,0,0,,Жоқ! Екінші шабуыл да жұмыс істемейді!
Dialogue: 0,0:14:57.49,0:14:59.49,Default,,0,0,0,,Не деген басатын күш!
Dialogue: 0,0:15:00.03,0:15:01.10,Default,,0,0,0,,Генерал Далтон -
Dialogue: 0,0:15:01.20,0:15:03.33,Default,,0,0,0,,Қарсылас әрекетінің мақсаттарын талдау нәтижелерінен -
Dialogue: 0,0:15:03.43,0:15:05.50,Default,,0,0,0,,Жапон азаттық майданының штаб-пәтеріне кіреберіс.
Dialogue: 0,0:15:05.60,0:15:07.67,Default,,0,0,0,,Сол тау үйіне айналады деп болжанған.
Dialogue: 0,0:15:08.10,0:15:10.91,Default,,0,0,0,,Бинго… бұл сіздің айтқыңыз келгені ме?Бұл жағдайда
Dialogue: 0,0:15:11.01,0:15:12.47,Default,,0,0,0,,… …
Dialogue: 0,0:15:12.57,0:15:15.01,Default,,0,0,0,,Бірге жинаңдар, адал адамдар.
Dialogue: 0,0:15:17.98,0:15:20.08,Default,,0,0,0,,Бұл... Далтон ба?
Dialogue: 0,0:15:20.35,0:15:22.42,Default,,0,0,0,,Жаудың базасы сонда болды ма?
Dialogue: 0,0:15:22.52,0:15:24.65,Default,,0,0,0,,Жарайды, біз осында дайындаламыз.
Dialogue: 0,0:15:24.95,0:15:26.15,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:15:26.65,0:15:29.46,Default,,0,0,0,,Менің қарамағымдағылардан несие ұрлау хоббиім жоқ.
Dialogue: 0,0:15:29.56,0:15:31.66,Default,,0,0,0,,Запастағы әскерлерді Дальтон жағына жылжытыңыз.
Dialogue: 0,0:15:31.96,0:15:33.26,Default,,0,0,0,,Тағы да медальдар болады
Dialogue: 0,0:15:34.40,0:15:37.20,Default,,0,0,0,,Корнелия күткендей, бұл логикалық құрам.
Dialogue: 0,0:15:37.46,0:15:40.37,Default,,0,0,0,,Дегенмен, ол өте жақсы болғандықтан, оқуға оңай.
Dialogue: 0,0:15:40.47,0:15:42.14,Default,,0,0,0,,Тіпті сіздің орналасқан жеріңіз де емес
Dialogue: 0,0:15:42.97,0:15:45.67,Default,,0,0,0,,Запастағы әскерлер генерал Дальтонның қол астында жиналмай ма?
Dialogue: 0,0:15:46.04,0:15:47.51,Default,,0,0,0,,Иә, бірақ біздің команда...
Dialogue: 0,0:15:47.61,0:15:49.64,Default,,0,0,0,,Губернатор Корнелияның артында дайындалыңыз.
Dialogue: 0,0:15:49.94,0:15:53.01,Default,,0,0,0,,Бұл артқы жағы ма? Негізгі майданның шеті де шеті
Dialogue: 0,0:15:53.11,0:15:56.45,Default,,0,0,0,,Осындай жерде атымды қалай өшіре аламын?
Dialogue: 0,0:15:58.29,0:15:59.95,Default,,0,0,0,,Накамура отрядының байланысын жоғалту
Dialogue: 0,0:16:00.05,0:16:01.52,Default,,0,0,0,,Үшінші бөлім Жауап жоқ
Dialogue: 0,0:16:01.62,0:16:02.69,Default,,0,0,0,,Майор Табата соғыс кезінде қаза тапты
Dialogue: 0,0:16:02.99,0:16:04.26,Default,,0,0,0,,Курода мен Курата да жеңілді.
Dialogue: 0,0:16:04.36,0:16:06.23,Default,,0,0,0,,Нағайға не болды?
Dialogue: 0,0:16:06.53,0:16:08.10,Default,,0,0,0,,Егер орындалатын болса...
Dialogue: 0,0:16:08.20,0:16:11.03,Default,,0,0,0,,Тодо болғанша, камикадзе соғады...
Dialogue: 0,0:16:11.13,0:16:13.30,Default,,0,0,0,,Ицукусима кереметі тағы да...
Dialogue: 0,0:16:13.47,0:16:14.54,Default,,0,0,0,,Уау! (Солдат) Уау!
Dialogue: 0,0:16:16.44,0:16:18.37,Default,,0,0,0,,Бұл тым итермелеу емес пе?Тодо мырза
Dialogue: 0,0:16:18.47,0:16:19.71,Default,,0,0,0,,Асахина Чиба
Dialogue: 0,0:16:20.01,0:16:21.51,Default,,0,0,0,,Бурайкайға (Асахина) дайындық
Dialogue: 0,0:16:21.61,0:16:23.58,Default,,0,0,0,,Мұны менің артымдағы Урабе Сенбаға айт.
Dialogue: 0,0:16:23.68,0:16:26.01,Default,,0,0,0,,Нарита айналасындағы қозғалысты бақылау
Dialogue: 0,0:16:26.11,0:16:28.22,Default,,0,0,0,,Іс басталып кетті! ―
Dialogue: 0,0:16:28.32,0:16:30.15,Default,,0,0,0,,Мен оны уақытында жасай аламын деп үміттенемін...
Dialogue: 0,0:16:37.39,0:16:40.26,Default,,0,0,0,,Енді 11-аймақтағы көтерілісшілер...
Dialogue: 0,0:16:40.43,0:16:42.16,Default,,0,0,0,,Бітті.
Dialogue: 0,0:16:42.26,0:16:44.63,Default,,0,0,0,,Жақсы! Барлығы дайын! ―
Dialogue: 0,0:16:45.13,0:16:47.30,Default,,0,0,0,,Қара рыцарьлар сұрыптауға дайын!
Dialogue: 0,0:16:48.64,0:16:51.27,Default,,0,0,0,,Шүкір, менде мұны істеуден басқа амал жоқ. (Мүше) Мен өле аламын ба?
Dialogue: 0,0:16:51.37,0:16:53.04,Default,,0,0,0,,Мен керемет жасаймын!
Dialogue: 0,0:16:53.14,0:16:54.41,Default,,0,0,0,,Бізде нөл бар!
Dialogue: 0,0:16:54.64,0:16:56.34,Default,,0,0,0,,Бұдан былай, менің Қара рыцарларым...
Dialogue: 0,0:16:56.44,0:16:59.68,Default,,0,0,0,,Таудың басынан британдық әскерге күтпеген шабуыл.
Dialogue: 0,0:17:00.31,0:17:01.58,Default,,0,0,0,,Менің нұсқауларымды орындаңыз-
Dialogue: 0,0:17:01.68,0:17:03.65,Default,,0,0,0,,Бірден үшінші нүктеге қарай жүгіріңіз.
Dialogue: 0,0:17:04.39,0:17:08.32,Default,,0,0,0,,Операцияның мақсаты - Британияның екінші ханшайымы Корнелияны қорғау.
Dialogue: 0,0:17:08.52,0:17:11.29,Default,,0,0,0,,Басқыншылық жолды ашатын Гурен 2 стилі.
Dialogue: 0,0:17:13.46,0:17:17.20,Default,,0,0,0,,Карен Өткізгіш электрод үшін 3 нөмірін пайдаланыңыз. Бір соққымен шеше алмайсың ба?
Dialogue: 0,0:17:17.30,0:17:18.17,Default,,0,0,0,,Иә
Dialogue: 0,0:17:20.50,0:17:24.04,Default,,0,0,0,,Шығысты растау Сәулелену толқынының механизмі Төтенше жағдайды сақтау
Dialogue: 0,0:17:26.77,0:17:29.18,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:17:29.28,0:17:30.38,Default,,0,0,0,,Құрыш жеңінің беріліс қорабы
Dialogue: 0,0:17:40.32,0:17:41.59,Default,,0,0,0,,Я...
Dialogue: 0,0:17:46.49,0:17:47.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:58.44,0:18:00.51,Default,,0,0,0,,Уау! (Катасе) Не болып жатыр?
Dialogue: 0,0:18:00.74,0:18:02.21,Default,,0,0,0,,Эй, бұл жер сілкінісі ме?
Dialogue: 0,0:18:02.31,0:18:03.74,Default,,0,0,0,,Осындай кездер... Арх!
Dialogue: 0,0:18:04.34,0:18:05.35,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:18:06.41,0:18:07.28,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:18:07.45,0:18:09.75,Default,,0,0,0,,Ақымақ, сондай үлкен көшкін.
Dialogue: 0,0:18:10.18,0:18:12.15,Default,,0,0,0,,Осы қарқынмен Алекс командасы мен Далтонның командасы...
Dialogue: 0,0:18:12.25,0:18:13.12,Default,,0,0,0,,Жою керек
Dialogue: 0,0:18:13.39,0:18:15.46,Default,,0,0,0,,Өрмелеңіз!Курсқа көшіңіз!
Dialogue: 0,0:18:16.49,0:18:17.42,Default,,0,0,0,,Жағдайды қалай түсінесіз?
Dialogue: 0,0:18:17.52,0:18:19.79,Default,,0,0,0,,Тексеруде. Мәртебелі, артқа шегініңіз.
Dialogue: 0,0:18:20.09,0:18:20.76,Default,,0,0,0,,Ол жерде қауіпті!
Dialogue: 0,0:18:20.86,0:18:24.57,Default,,0,0,0,,Алекс туралы маған бәрібір? Далтонның қайда екенін тексеріңіз!
Dialogue: 0,0:18:25.63,0:18:27.27,Default,,0,0,0,,Бұл жерде өмір сүре ала ма?
Dialogue: 0,0:18:27.37,0:18:28.87,Default,,0,0,0,,Орталықта, әйтеуір...
Dialogue: 0,0:18:29.17,0:18:32.44,Default,,0,0,0,,Жоқ, осы қарқынмен біз тау етегіне дейін барамыз.
Dialogue: 0,0:18:32.67,0:18:34.27,Default,,0,0,0,,Қалыпты емес жылу реакциясы
Dialogue: 0,0:18:34.37,0:18:37.21,Default,,0,0,0,,Біреу әдейі будың жарылуына себеп болуы мүмкін бе?
Dialogue: 0,0:18:37.31,0:18:38.65,Default,,0,0,0,,Ракшата болмайды...
Dialogue: 0,0:18:38.75,0:18:41.42,Default,,0,0,0,,Егер сіз оларды қолданбайынша, тіпті сәулелі толқындар да мүмкін емес.
Dialogue: 0,0:18:41.52,0:18:42.65,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:42.75,0:18:44.85,Default,,0,0,0,,Аа, оның маған қатысы жоқ.
Dialogue: 0,0:18:45.15,0:18:47.42,Default,,0,0,0,,Сіз сонда қалып, күте тұрыңыз.
Dialogue: 0,0:18:47.62,0:18:48.66,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:18:52.26,0:18:53.53,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:18:54.60,0:18:57.46,Default,,0,0,0,,Хмм, бұл мен күткеннен де жойқын күш.
Dialogue: 0,0:18:58.23,0:19:00.37,Default,,0,0,0,,Біз Корнелия отрядын оқшаулай алдық...
Dialogue: 0,0:19:00.47,0:19:02.77,Default,,0,0,0,,Кішкене мұқият болу керек пе?
Dialogue: 0,0:19:02.87,0:19:05.31,Default,,0,0,0,,Физика мұғалімі... Әй, жоқ-
Dialogue: 0,0:19:05.41,0:19:08.18,Default,,0,0,0,,Нинадан маған, соның ішінде ықтималдық теориясын үйретуін сұрауым керек пе?
Dialogue: 0,0:19:08.48,0:19:10.81,Default,,0,0,0,,Таудың басынан расталған жаңа әскерлер.
Dialogue: 0,0:19:10.91,0:19:13.25,Default,,0,0,0,,Кариус отряды тосқауыл қоюға бет алды.
Dialogue: 0,0:19:13.51,0:19:16.18,Default,,0,0,0,,Хмф, сіз шатасуды пайдаланғыңыз келе ме?
Dialogue: 0,0:19:16.28,0:19:17.48,Default,,0,0,0,,Кариус отрядының шұғыл хабарламасы
Dialogue: 0,0:19:17.58,0:19:18.45,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:18.62,0:19:20.39,Default,,0,0,0,,Жапонияны азат ету майданы емес.
Dialogue: 0,0:19:20.49,0:19:22.66,Default,,0,0,0,,Қарсылас қара рыцарьлар сияқты!
Dialogue: 0,0:19:22.76,0:19:23.72,Default,,0,0,0,,Не! ? Сонымен...
Dialogue: 0,0:19:23.82,0:19:24.76,Default,,0,0,0,,Нөл! ―
Dialogue: 0,0:19:24.86,0:19:27.23,Default,,0,0,0,,Көргеніңіз үшін рахмет!нөл!
Dialogue: 0,0:19:27.43,0:19:29.53,Default,,0,0,0,,Еремия мырза!Постыңызды рұқсатсыз қалдырмаңыз!
Dialogue: 0,0:19:29.63,0:19:33.70,Default,,0,0,0,,Бұл төтенше жағдай. Табысты болғың келсе, маған жазыл.
Dialogue: 0,0:19:34.20,0:19:36.50,Default,,0,0,0,,Корнелияға арналған күшейтулер шектеулі.
Dialogue: 0,0:19:36.60,0:19:37.67,Default,,0,0,0,,Бірден алға!
Dialogue: 0,0:19:37.77,0:19:40.31,Default,,0,0,0,,О!Егер бұл орын алса, мен мұны істеймін!
Dialogue: 0,0:19:41.58,0:19:46.48,Default,,0,0,0,,Жарайсың ба? Біздің рөліміз - нөлді және басқаларды артқы жағынан қорғау. Ат!
Dialogue: 0,0:19:50.25,0:19:52.55,Default,,0,0,0,,Кариус отряды жойылды ма?Tsk
Dialogue: 0,0:19:52.65,0:19:54.62,Default,,0,0,0,,Нөл Мәртебелі Корнелиямен байланысқанға дейін
Dialogue: 0,0:19:54.72,0:19:56.29,Default,,0,0,0,,Біз мәселені шешуіміз керек.
Dialogue: 0,0:19:56.39,0:19:57.42,Default,,0,0,0,,Еремия сэр
Dialogue: 0,0:19:57.52,0:19:59.69,Default,,0,0,0,,Виллетта! Келдің бе?
Dialogue: 0,0:20:00.26,0:20:02.63,Default,,0,0,0,,Артқы судың пайда болуы және кері түсу-
Dialogue: 0,0:20:02.73,0:20:05.57,Default,,0,0,0,,Мен классикалық тактиканың соншалықты тиімді екенін білмедім.
Dialogue: 0,0:20:05.80,0:20:06.80,Default,,0,0,0,,Нөл!
Dialogue: 0,0:20:06.90,0:20:09.24,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:10.64,0:20:11.94,Default,,0,0,0,,Нөл бар ма? ―
Dialogue: 0,0:20:12.24,0:20:15.74,Default,,0,0,0,,Егер сіз сонда болсаңыз, мен және Жеремия Готвальдпен шайқасыңыз!
Dialogue: 0,0:20:16.34,0:20:18.55,Default,,0,0,0,,Әй, біраз уақыт болды.
Dialogue: 0,0:20:18.65,0:20:20.35,Default,,0,0,0,,Сіз әлі де әскери қызметтесіз бе?
Dialogue: 0,0:20:20.71,0:20:24.42,Default,,0,0,0,,Бірақ дәл қазір саған уақытым жоқ.
Dialogue: 0,0:20:24.52,0:20:25.59,Default,,0,0,0,,Апельсин-кун
Dialogue: 0,0:20:25.69,0:20:28.59,Default,,0,0,0,,О... ой...
Dialogue: 0,0:20:28.69,0:20:30.26,Default,,0,0,0,,Бұл қызғылт сары! ―
Dialogue: 0,0:20:30.36,0:20:31.66,Default,,0,0,0,,Өлме! ―
Dialogue: 0,0:20:33.76,0:20:34.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:36.96,0:20:37.83,Default,,0,0,0,,Еремия мырза!
Dialogue: 0,0:20:37.93,0:20:40.73,Default,,0,0,0,,Маған тиіспе!Бұл менің дуэлім!
Dialogue: 0,0:20:40.90,0:20:42.00,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:20:42.30,0:20:44.34,Default,,0,0,0,,Бұл мен көрген қорқынышты түстердің бірінші түрі.
Dialogue: 0,0:20:44.44,0:20:45.71,Default,,0,0,0,,Мен он бірді күтпедім...
Dialogue: 0,0:20:45.81,0:20:48.68,Default,,0,0,0,,Eleven стилінде мұндай технология бар ма?
Dialogue: 0,0:20:51.68,0:20:52.68,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:20:55.25,0:20:58.29,Default,,0,0,0,,Бұл... бұл сен бе?Бұл жігіт Кариустың бөлімшесі!
Dialogue: 0,0:20:58.55,0:20:59.82,Default,,0,0,0,,Көрдіңіз бе? Британия!
Dialogue: 0,0:20:59.92,0:21:02.92,Default,,0,0,0,,Ақырында... Мен сендермен тең дәрежеде күресе аламын.
Dialogue: 0,0:21:03.02,0:21:07.43,Default,,0,0,0,,Бұл екінші Гурен рәсімі біздің қарсы шабуылымыздың басы!
Dialogue: 0,0:21:07.66,0:21:09.33,Default,,0,0,0,,Мына оң қол нашар...
Dialogue: 0,0:21:09.43,0:21:10.63,Default,,0,0,0,,Бірдеңе бар
Dialogue: 0,0:21:10.73,0:21:12.00,Default,,0,0,0,,Уақытыңызды алғанша...
Dialogue: 0,0:21:13.30,0:21:14.33,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:21:18.91,0:21:19.77,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:22.91,0:21:23.78,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:21:31.45,0:21:33.32,Default,,0,0,0,,Уф, бұл не...
Dialogue: 0,0:21:33.59,0:21:34.86,Default,,0,0,0,,Еремия мырза!Қашу!
Dialogue: 0,0:21:35.02,0:21:37.39,Default,,0,0,0,,Сіз мұны істей аласыз ба! Нөл менің алдымда! ―
Dialogue: 0,0:21:37.59,0:21:38.93,Default,,0,0,0,,Егер нөл болса...
Dialogue: 0,0:21:39.93,0:21:40.96,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:21:41.06,0:21:42.73,Default,,0,0,0,,Қарғыс атсын!Бұл автоматты!
Dialogue: 0,0:21:42.83,0:21:45.07,Default,,0,0,0,,Іске қоспаңыз!Әлі емес...
Dialogue: 0,0:21:45.37,0:21:48.67,Default,,0,0,0,,… …
Dialogue: 0,0:21:57.78,0:21:58.78,Default,,0,0,0,,Мен оларды дәл қазір толықтай сіңіріп алдым.
Dialogue: 0,0:21:58.88,0:22:01.55,Default,,0,0,0,,Егер бұл менің... Guren 2 стилі болса!
Dialogue: 0,0:22:02.72,0:22:04.72,Default,,0,0,0,,Еремия жеңілді...
Dialogue: 0,0:22:04.82,0:22:07.49,Default,,0,0,0,,Қара рыцарьлар... Бұл жігіттер кімдер?
Dialogue: 0,0:22:08.59,0:22:10.52,Default,,0,0,0,,Барлық шарттар жойылды.
Dialogue: 0,0:22:10.92,0:22:12.03,Default,,0,0,0,,Бөлшектердің барлығы дайын.
Dialogue: 0,0:22:12.33,0:22:15.63,Default,,0,0,0,,Қарсыластың негізгі базасын тексеру ғана қалды.
Dialogue: 0,0:22:15.73,0:22:16.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:17.73,0:22:21.37,Default,,0,0,0,,♪～
Dialogue: 0,0:22:21.47,0:22:25.01,Default,,0,0,0,,♪Мен жүрмін, бірақ мен арыстан мен жолбарыстың арылдаған жолмен жүріп келемін
Dialogue: 0,0:22:25.11,0:22:28.88,Default,,0,0,0,,♪Қызыл аспанның арғы жағында, Махороба
Dialogue: 0,0:22:28.98,0:22:32.68,Default,,0,0,0,,♪Тұтқынның оңашалығында қаңғыған жас
Dialogue: 0,0:22:32.78,0:22:36.52,Default,,0,0,0,,♪Әлсіздік пен ашу көзге көрінбейтін жау ма?
Dialogue: 0,0:22:36.62,0:22:41.99,Default,,0,0,0,,♪Әке, мен өзімді әлі білмеймін.
Dialogue: 0,0:22:44.02,0:22:48.06,Default,,0,0,0,,♪Алдыңғы ағайындар
Dialogue: 0,0:22:48.36,0:22:51.77,Default,,0,0,0,,♪Көрінбейтін арқаңа ерсең
Dialogue: 0,0:22:51.87,0:22:58.84,Default,,0,0,0,,♪Таң жұлдызы сізді адасқан түнге шақырады
Dialogue: 0,0:22:59.51,0:23:02.94,Default,,0,0,0,,♪Өліммен бітпейді
Dialogue: 0,0:23:03.04,0:23:06.75,Default,,0,0,0,,♪Арманымды аңсасам да
Dialogue: 0,0:23:06.85,0:23:10.58,Default,,0,0,0,,♪Сенімді адам сенсің
Dialogue: 0,0:23:10.68,0:23:14.55,Default,,0,0,0,,♪Менің өмірім
Dialogue: 0,0:23:14.65,0:23:18.46,Default,,0,0,0,,♪Қатты жел айдалада, Көбелектер мен гүлдермен өмір сүремін.
Dialogue: 0,0:23:18.56,0:23:22.13,Default,,0,0,0,,♪Мәңгілік көктемде гүлдеген дәмді елес
Dialogue: 0,0:23:22.43,0:23:25.97,Default,,0,0,0,,♪Бұл дененің лас болса да лайдың тазалығы
Dialogue: 0,0:23:26.07,0:23:29.84,Default,,0,0,0,,♪Жүрегіңіздің сырына сеніңіз
Dialogue: 0,0:23:29.94,0:23:35.54,Default,,0,0,0,,♪Анашым, көз жасымды көрсетпесем де.
Dialogue: 0,0:23:35.71,0:23:40.18,Default,,0,0,0,,♪Аяғымның астындағы шөпте
Dialogue: 0,0:23:40.48,0:23:45.82,Default,,0,0,0,,♪Шық ешқашан жоғалмайды
Dialogue: 0,0:23:49.09,0:23:50.66,Default,,0,0,0,,Енді шешілді.
Dialogue: 0,0:23:50.76,0:23:51.73,Default,,0,0,0,,Корнелия болса да...
Dialogue: 0,0:23:51.83,0:23:53.13,Default,,0,0,0,,Егер сіз одақтастарыңызды қысқарта алсаңыз ...
Dialogue: 0,0:23:53.43,0:23:54.43,Default,,0,0,0,,Жеңіске жету мүмкіндігі төмен.
Dialogue: 0,0:23:54.53,0:23:56.50,Default,,0,0,0,,Мұнда Гурен 2 стилі де бар.
Dialogue: 0,0:23:56.60,0:23:57.76,Default,,0,0,0,,Оны қамауға алуды ұмытпаңыз.
Dialogue: 0,0:23:57.86,0:24:00.47,Default,,0,0,0,,Анамның қашан қайтыс болғаны туралы шындықты айтайын.
Dialogue: 0,0:24:00.57,0:24:01.43,Default,,0,0,0,,Және...
Dialogue: 0,0:24:01.54,0:24:03.77,Default,,0,0,0,,Мен оны тұтқынға алсам, мен жеңемін.
Dialogue: 0,0:24:03.87,0:24:07.44,Default,,0,0,0,,Егер тәртіпсіздіктер болмаса, менің қара рыцарларым...
Dialogue: 0,0:24:08.94,0:24:14.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory