Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.60,0:00:06.03,Default,,0,0,0,,Бұл дүниеде жақсы ниеттен туған жамандық бар.
Dialogue: 0,0:00:06.13,0:00:08.27,Default,,0,0,0,,Жамандықтан туған ізгі ниет бар.
Dialogue: 0,0:00:09.14,0:00:12.11,Default,,0,0,0,,Лелуш нақты не істеді?
Dialogue: 0,0:00:12.17,0:00:14.18,Default,,0,0,0,,Бұл қабылдау керек нәрсе ме? ―
Dialogue: 0,0:00:14.61,0:00:17.28,Default,,0,0,0,,Үкім дүниенің еріксіздігі ме?
Dialogue: 0,0:00:18.75,0:00:19.65,Default,,0,0,0,,Геасс
Dialogue: 0,0:00:20.05,0:00:22.65,Default,,0,0,0,,Адамгершілікке жатпайтын күшті пайдаланатын бұл адам...
Dialogue: 0,0:00:22.75,0:00:25.35,Default,,0,0,0,,Жүрегімде жалғыздықты еріксіз тудырды.
Dialogue: 0,0:00:25.79,0:00:29.16,Default,,0,0,0,,Жақсы ниет пен жаман ниеттің арасында қалу.
Dialogue: 0,0:00:30.09,0:00:31.69,Default,,0,0,0,,Алайда, егер-
Dialogue: 0,0:00:31.76,0:00:34.73,Default,,0,0,0,,Егер ол жерден біреу көтерілсе...
Dialogue: 0,0:00:35.06,0:00:35.73,Default,,0,0,0,,Иә-
Dialogue: 0,0:00:36.03,0:00:40.30,Default,,0,0,0,,Ол кісі қолында белгілі бір патшаның ыдысын ұстаса керек.
Dialogue: 0,0:00:40.37,0:00:46.37,Default,,0,0,0,,♪～
Dialogue: 0,0:00:48.14,0:00:51.78,Default,,0,0,0,,♪Мен көрген түс
Dialogue: 0,0:00:52.08,0:00:55.68,Default,,0,0,0,,♪Шексіз және алыс
Dialogue: 0,0:00:55.78,0:01:02.32,Default,,0,0,0,,♪Құрғақ күндерде көк аспан, Қолымда
Dialogue: 0,0:01:03.73,0:01:07.40,Default,,0,0,0,,♪Дыбыстағы біркелкі сынама және қателік
Dialogue: 0,0:01:07.50,0:01:12.70,Default,,0,0,0,,♪Уақытсыз және интервалсыз кеңістік
Dialogue: 0,0:01:14.37,0:01:16.60,Default,,0,0,0,,♪Өмірлік өлшем шу шығарады
Dialogue: 0,0:01:16.70,0:01:19.44,Default,,0,0,0,,♪Мен өз бетімді жасаймын
Dialogue: 0,0:01:19.54,0:01:22.78,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:01:23.55,0:01:27.45,Default,,0,0,0,,♪Қолыма түсті
Dialogue: 0,0:01:27.55,0:01:31.32,Default,,0,0,0,,♪Шіріген алма
Dialogue: 0,0:01:31.42,0:01:35.36,Default,,0,0,0,,♪Айнада бейнеленген
Dialogue: 0,0:01:35.46,0:01:39.33,Default,,0,0,0,,♪Біздің арғы жағымызға
Dialogue: 0,0:01:39.43,0:01:43.13,Default,,0,0,0,,♪Дистанциялық сезім Адамдар арасындағы сынақ пен қателік
Dialogue: 0,0:01:43.23,0:01:48.30,Default,,0,0,0,,♪Уақытсыз және сезімсіз кеңістік
Dialogue: 0,0:01:49.84,0:01:52.31,Default,,0,0,0,,♪Бас пен дене тырнақтарын жоғары көтеріп тұру
Dialogue: 0,0:01:52.41,0:01:55.24,Default,,0,0,0,,♪Бетімді қырып алайын деп жатырмын
Dialogue: 0,0:01:55.34,0:02:00.85,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:02:02.55,0:02:09.56,Default,,0,0,0,,♪-Қашықтықты сезу
Dialogue: 0,0:02:16.63,0:02:18.43,Default,,0,0,0,,Мен алдымен растағым келеді.
Dialogue: 0,0:02:18.53,0:02:21.44,Default,,0,0,0,,Сен менің жауымсың ба?Сіз мен жақтасыз ба?
Dialogue: 0,0:02:21.50,0:02:23.17,Default,,0,0,0,,) Қазір не істеп жатырсың?
Dialogue: 0,0:02:23.24,0:02:24.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:24.37,0:02:25.74,Default,,0,0,0,,Мао деген адам
Dialogue: 0,0:02:25.84,0:02:28.88,Default,,0,0,0,,Геастың басқа адамдардың ойын оқи алатын қабілеті бар.
Dialogue: 0,0:02:29.18,0:02:30.41,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:02:30.48,0:02:31.71,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:02:31.81,0:02:34.65,Default,,0,0,0,,Геасс адамға байланысты әр түрлі көрінеді.
Dialogue: 0,0:02:35.52,0:02:36.62,Default,,0,0,0,,Мао жағдайында -
Dialogue: 0,0:02:36.72,0:02:41.22,Default,,0,0,0,,500 ―
Dialogue: 0,0:02:41.32,0:02:44.19,Default,,0,0,0,,―
Dialogue: 0,0:02:44.29,0:02:47.56,Default,,0,0,0,,Егер сен басыңмен соғысатын адам болсаң, сен сенің қас жауыңсың.
Dialogue: 0,0:02:47.66,0:02:48.73,Default,,0,0,0,,500 метр…
Dialogue: 0,0:02:49.73,0:02:51.80,Default,,0,0,0,,Мен оны елестетіп едім...
Dialogue: 0,0:02:51.90,0:02:54.74,Default,,0,0,0,,―
Dialogue: 0,0:02:55.47,0:02:57.57,Default,,0,0,0,,Ол да сізбен келісім-шарт жасады ма?
Dialogue: 0,0:02:57.67,0:02:59.24,Default,,0,0,0,,11
Dialogue: 0,0:02:59.34,0:03:01.54,Default,,0,0,0,,Хан, сен керемет ағасың.
Dialogue: 0,0:03:01.64,0:03:04.55,Default,,0,0,0,,Сонымен?Бұл үлкен аға менің жауым ба?
Dialogue: 0,0:03:04.65,0:03:08.62,Default,,0,0,0,,Маоның мақсаты мен. Жау болсақ та, ол менің өмірімді мақсат тұтпайды...
Dialogue: 0,0:03:08.68,0:03:10.52,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:03:10.62,0:03:14.92,Default,,0,0,0,,Бұл жағдайда сізге әскери немесе полиция қызметкерлеріне Нөлдің кім екенін айту жеткілікті.
Dialogue: 0,0:03:15.22,0:03:17.23,Default,,0,0,0,,Бірақ тек Ширли үшін...
Dialogue: 0,0:03:17.33,0:03:18.56,Default,,0,0,0,,Оның қабілеттілік шарттары қандай?
Dialogue: 0,0:03:19.63,0:03:21.83,Default,,0,0,0,,Маоның Геассы күшті
Dialogue: 0,0:03:21.93,0:03:26.73,Default,,0,0,0,,Сізден айырмашылығы, көзге қараудың рет саны немесе шектеулері бойынша шектеулер жоқ.
Dialogue: 0,0:03:26.83,0:03:28.84,Default,,0,0,0,,Оның әлсіз жақтары бар ма?
Dialogue: 0,0:03:29.20,0:03:32.77,Default,,0,0,0,,Мао мәжбүр болса, өз қабілеттерін өшіре алмайды.
Dialogue: 0,0:03:32.87,0:03:35.88,Default,,0,0,0,,Мен әрқашан айналамдағы ішкі дауыстарды ести аламын.
Dialogue: 0,0:03:35.98,0:03:38.38,Default,,0,0,0,,Адамның қалауы немесе қаламауы
Dialogue: 0,0:03:38.51,0:03:39.48,Default,,0,0,0,,Мен мектепті осылай өткізіп жіберемін деп қорқамын.
Dialogue: 0,0:03:39.58,0:03:41.68,Default,,0,0,0,,Әй, осындай жерде шу шығар.
Dialogue: 0,0:03:41.78,0:03:43.82,Default,,0,0,0,,Менімен қашан ажырасасың деп ойлаймын
Dialogue: 0,0:03:43.92,0:03:44.82,Default,,0,0,0,,Толық емес жұмыс күнін алуым керек пе?
Dialogue: 0,0:03:44.92,0:03:46.52,Default,,0,0,0,,Менің ата-анам да ақсүйектер болса ғой.
Dialogue: 0,0:03:46.62,0:03:47.49,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:47.59,0:03:50.29,Default,,0,0,0,,Ақырында ақша, ақша, ақша...
Dialogue: 0,0:03:50.43,0:03:51.79,Default,,0,0,0,,Қуа…
Dialogue: 0,0:03:52.53,0:03:53.46,Default,,0,0,0,,Менің ойымша, үйге баратын уақыт келді.
Dialogue: 0,0:03:53.46,0:03:54.36,Default,,0,0,0,,Менің ойымша, үйге баратын уақыт жақындап қалды.
Dialogue: 0,0:03:53.46,0:03:54.36,Default,,0,0,0,,Куу…
Dialogue: 0,0:03:54.43,0:03:55.30,Default,,0,0,0,,Ах, қарным ашты.
Dialogue: 0,0:03:55.40,0:03:56.86,Default,,0,0,0,,Неліктен биыл?
Dialogue: 0,0:03:56.97,0:03:58.60,Default,,0,0,0,,Мен мұндай жерде уақытты өлтіруім керек.
Dialogue: 0,0:03:58.67,0:04:00.70,Default,,0,0,0,,Мен бұл жолы міндетті түрде жеңемін!
Dialogue: 0,0:04:00.80,0:04:02.54,Default,,0,0,0,,Куу... Уф
Dialogue: 0,0:04:02.80,0:04:04.47,Default,,0,0,0,,Мен білемін, Мао.
Dialogue: 0,0:04:04.54,0:04:05.84,Default,,0,0,0,,Уайымдама, Мао.
Dialogue: 0,0:04:05.94,0:04:07.94,Default,,0,0,0,,Мен өлмеймін.
Dialogue: 0,0:04:08.24,0:04:09.74,Default,,0,0,0,,Мао Мао
Dialogue: 0,0:04:09.84,0:04:11.71,Default,,0,0,0,,Сіз ояндыңыз ба?Мао
Dialogue: 0,0:04:11.81,0:04:14.55,Default,,0,0,0,,C.C. Бұл сіз болуыңыз керек.
Dialogue: 0,0:04:14.65,0:04:16.65,Default,,0,0,0,,Мені күтіңіз... Мен қазір сізге барамын.
Dialogue: 0,0:04:19.29,0:04:21.72,Default,,0,0,0,,Мао менің ойларымды оқи алса...
Dialogue: 0,0:04:21.82,0:04:24.53,Default,,0,0,0,,Ол менің ең әлсіз жерімді көздеу керек.
Dialogue: 0,0:04:25.29,0:04:27.83,Default,,0,0,0,,Мен ағаммен оңаша жүргеніме біраз болды!
Dialogue: 0,0:04:28.26,0:04:31.37,Default,,0,0,0,,Менің ойымша, Сакиоко-сан анда-санда үзіліс жасап тұруы керек.
Dialogue: 0,0:04:31.73,0:04:34.47,Default,,0,0,0,,Бүгіннен бастап мен біраз уақыт үйде боламын.
Dialogue: 0,0:04:34.57,0:04:38.31,Default,,0,0,0,,Бауырым, соңғы кездері үйден көп кетіп қалдың.
Dialogue: 0,0:04:38.41,0:04:40.91,Default,,0,0,0,,Сіз ойнауға қызықты нәрсе таптыңыз ба?
Dialogue: 0,0:04:40.98,0:04:44.28,Default,,0,0,0,,Менің келесі қарсыласым сәл қаталырақ.
Dialogue: 0,0:04:44.38,0:04:45.05,Default,,0,0,0,,Аха
Dialogue: 0,0:04:45.65,0:04:48.95,Default,,0,0,0,,Ағаңнан бұлай айтуды қандай адам сұрар едің? ―
Dialogue: 0,0:04:49.05,0:04:51.55,Default,,0,0,0,,Шнайзел-нии-самадан бері емес пе?
Dialogue: 0,0:04:54.52,0:04:57.36,Default,,0,0,0,,Кешіріңіз, бірақ рұқсатсыз сата алмайсыз.
Dialogue: 0,0:04:57.46,0:04:59.89,Default,,0,0,0,,Сіздің тұтынушыңыз Қытай Федерациясынан, солай емес пе?
Dialogue: 0,0:04:59.99,0:05:02.66,Default,,0,0,0,,Эй, олар оны Қара рыцарларға сатады, солай ма? ―
Dialogue: 0,0:05:02.86,0:05:03.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:03.50,0:05:03.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:03.50,0:05:03.83,Default,,0,0,0,,Өткен сейсенбіде сағат 23:00 Басқа адамның аты... Қасқыр.
Dialogue: 0,0:05:03.83,0:05:07.47,Default,,0,0,0,,Өткен сейсенбіде сағат 23:00 Басқа адамның аты... Қасқыр.
Dialogue: 0,0:05:07.57,0:05:09.77,Default,,0,0,0,,Әрине, бұл жалған есім.
Dialogue: 0,0:05:09.87,0:05:12.97,Default,,0,0,0,,Сізді... орналастыруға болады, солай ма?
Dialogue: 0,0:05:13.07,0:05:14.34,Default,,0,0,0,,Көрінгендей, бар
Dialogue: 0,0:05:15.68,0:05:16.54,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:05:16.88,0:05:21.68,Default,,0,0,0,,Әпкеңді қорғау керек екені рас, бірақ күте алмайсың...
Dialogue: 0,0:05:21.78,0:05:23.79,Default,,0,0,0,,Қара рыцарьлар оны іздеп жатыр.
Dialogue: 0,0:05:24.02,0:05:25.32,Default,,0,0,0,,Гетто емес-
Dialogue: 0,0:05:25.42,0:05:27.52,Default,,0,0,0,,Егер сіз Токио концессиясында болсаңыз не істер едіңіз?
Dialogue: 0,0:05:27.62,0:05:28.92,Default,,0,0,0,,Бұл уақытты босқа өткізу
Dialogue: 0,0:05:29.02,0:05:31.49,Default,,0,0,0,,Одан гөрі мені жем ретінде пайдалан.
Dialogue: 0,0:05:31.59,0:05:33.83,Default,,0,0,0,,Маоның мақсаты мен. мен...
Dialogue: 0,0:05:33.90,0:05:37.07,Default,,0,0,0,,Эй, егер мен Геассты қолдана берсем, мен де солай боламын ба?
Dialogue: 0,0:05:37.33,0:05:38.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:38.73,0:05:39.60,Default,,0,0,0,,Әлде…
Dialogue: 0,0:05:39.70,0:05:42.94,Default,,0,0,0,,Бұл сізбен келісім-шартымды орындамағандықтан болды ма?
Dialogue: 0,0:05:43.04,0:05:46.61,Default,,0,0,0,,Geass пайдаланған сайын қуаты артады.
Dialogue: 0,0:05:46.71,0:05:47.74,Default,,0,0,0,,Жеңе алмайтындар
Dialogue: 0,0:05:47.84,0:05:50.81,Default,,0,0,0,,Өз күшімен жұтылуы
Dialogue: 0,0:05:50.91,0:05:54.12,Default,,0,0,0,,Сіз мұны біліп, келісімшартқа отыруды ұсындыңыз ба?
Dialogue: 0,0:05:54.42,0:05:55.62,Default,,0,0,0,,Мен және Мао үшін де!
Dialogue: 0,0:05:55.68,0:05:56.82,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:56.92,0:05:58.52,Default,,0,0,0,,Ол қорқынышты әйел.
Dialogue: 0,0:05:58.62,0:06:00.96,Default,,0,0,0,,Мені кім қуып бара жатқанын білмеймін.
Dialogue: 0,0:06:01.76,0:06:04.03,Default,,0,0,0,,Мао келісім-шартын орындай алмады.
Dialogue: 0,0:06:04.13,0:06:05.63,Default,,0,0,0,,Сол себепті лақтырдың ба? ―
Dialogue: 0,0:06:08.40,0:06:10.47,Default,,0,0,0,,Шарттың мазмұны қандай? (C.C.) Хмм...
Dialogue: 0,0:06:10.87,0:06:11.77,Default,,0,0,0,,Сен жексұрынсың!
Dialogue: 0,0:06:11.83,0:06:13.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:13.13,0:06:15.57,Default,,0,0,0,,Сен оны лақтырып жібергенде неге тастамадың? ―
Dialogue: 0,0:06:15.67,0:06:18.51,Default,,0,0,0,,Билікті тартып алу, өмірді алу...
Dialogue: 0,0:06:18.61,0:06:20.54,Default,,0,0,0,,Сол жарымжандықтан, Ширли!
Dialogue: 0,0:06:23.81,0:06:26.91,Default,,0,0,0,,Менің ойымша, біз Маоға қатысты басқаша әрекет етуіміз керек.
Dialogue: 0,0:06:27.01,0:06:28.62,Default,,0,0,0,,Бүгіннен бастап келесі ғимаратқа көшемін.
Dialogue: 0,0:06:28.98,0:06:30.45,Default,,0,0,0,,Көрші үй?
Dialogue: 0,0:06:30.55,0:06:32.12,Default,,0,0,0,,Студенттік кеңес және мәдени клуб бөлмелері...
Dialogue: 0,0:06:32.42,0:06:33.69,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:06:33.79,0:06:36.12,Default,,0,0,0,,Пост-өңдеу туралы бірдеңе жасаңыз.
Dialogue: 0,0:06:36.66,0:06:38.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:40.53,0:06:41.86,Default,,0,0,0,,Медициналық тексеру?
Dialogue: 0,0:06:41.96,0:06:43.40,Default,,0,0,0,,Nightmare ұшқышы үшін-
Dialogue: 0,0:06:43.50,0:06:45.00,Default,,0,0,0,,Міндетті
Dialogue: 0,0:06:45.10,0:06:45.97,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:06:46.17,0:06:48.67,Default,,0,0,0,,Ал, ертең сабақтан кейін
Dialogue: 0,0:06:48.74,0:06:49.67,Default,,0,0,0,,Иә-
Dialogue: 0,0:06:49.77,0:06:50.97,Default,,0,0,0,,Ах, Сесил-сан.
Dialogue: 0,0:06:51.07,0:06:54.08,Default,,0,0,0,,Мәртебелі ханшайым Эфемиямен кездесудің жолы бар ма?
Dialogue: 0,0:06:54.18,0:06:55.78,Default,,0,0,0,,Иә? Менімен кездескіңіз келе ме?
Dialogue: 0,0:06:55.88,0:06:57.01,Default,,0,0,0,,Бұл мүмкін емес, солай ма?
Dialogue: 0,0:06:57.11,0:06:59.85,Default,,0,0,0,,Аудитория рыцарь дәрежесінен жоғары.
Dialogue: 0,0:06:59.95,0:07:02.45,Default,,0,0,0,,Жоғары мәртебелі граф мұны істей алмас па еді?
Dialogue: 0,0:07:02.85,0:07:04.49,Default,,0,0,0,,Мен? Иә
Dialogue: 0,0:07:04.55,0:07:05.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:05.92,0:07:08.16,Default,,0,0,0,,Ллойд мырза... ол граф болды ма?
Dialogue: 0,0:07:08.42,0:07:11.43,Default,,0,0,0,,Ахаха... Уау, ұят болды~
Dialogue: 0,0:07:11.53,0:07:14.93,Default,,0,0,0,,Адасқан ақсүйек, сен ойын мен жұмыстың айырмашылығын білмейсің.
Dialogue: 0,0:07:15.00,0:07:16.60,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:17.73,0:07:19.20,Default,,0,0,0,,Оған бірнеше күн ғана қажет.
Dialogue: 0,0:07:19.50,0:07:22.74,Default,,0,0,0,,Егер сіз клуб үйін біраз уақытқа тыйым салсаңыз.
Dialogue: 0,0:07:22.84,0:07:25.17,Default,,0,0,0,,Бұл мүмкін емес, бірақ...
Dialogue: 0,0:07:25.44,0:07:27.61,Default,,0,0,0,,Эй, мен оның ханзада екеніне сенбеймін...
Dialogue: 0,0:07:27.84,0:07:29.58,Default,,0,0,0,,Мен білмедім.
Dialogue: 0,0:07:29.78,0:07:32.68,Default,,0,0,0,,Менің тірі екенімді Эшфорд отбасы ғана біледі.
Dialogue: 0,0:07:32.78,0:07:34.02,Default,,0,0,0,,Сәлем Эшфорд
Dialogue: 0,0:07:34.12,0:07:36.45,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:07:36.75,0:07:37.85,Default,,0,0,0,,Лелуш
Dialogue: 0,0:07:37.95,0:07:42.06,Default,,0,0,0,,Мен бұл жолы қашып құтыла алмайтын шығармын.
Dialogue: 0,0:07:42.16,0:07:43.93,Default,,0,0,0,,Эй, мен не істеуім керек?
Dialogue: 0,0:07:43.99,0:07:45.89,Default,,0,0,0,,… …
Dialogue: 0,0:07:47.66,0:07:48.83,Default,,0,0,0,,Төраға! иә?
Dialogue: 0,0:07:48.90,0:07:49.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:49.80,0:07:49.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:49.80,0:07:49.93,Default,,0,0,0,,Ширли? Таңертеңгілік жаттығу қайта жанданады ма?
Dialogue: 0,0:07:49.93,0:07:52.23,Default,,0,0,0,,Ширли? Таңертеңгілік жаттығу қайта жанданады ма?
Dialogue: 0,0:07:52.50,0:07:55.70,Default,,0,0,0,,Иә, мен бүгіннен бастап қайта депрессияға түссем, көмектесе алмаймын.
Dialogue: 0,0:07:55.80,0:07:56.87,Default,,0,0,0,,Аха
Dialogue: 0,0:07:56.97,0:07:59.81,Default,,0,0,0,,Мен шәкірт болуға тым қызығамын ба?сіздің әрекет күшіңіз
Dialogue: 0,0:07:59.91,0:08:03.54,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Төраға...
Dialogue: 0,0:08:03.64,0:08:07.88,Default,,0,0,0,,Иә? Сіз өткен күні... бұл менің мектебімде болды!
Dialogue: 0,0:08:07.98,0:08:10.65,Default,,0,0,0,,Не қалжыңдап тұрсың? (Лелуш) Біз бір сыныпта оқимыз, солай ма?
Dialogue: 0,0:08:11.05,0:08:14.19,Default,,0,0,0,,Не? Бұл болуы керек... хмм? ―
Dialogue: 0,0:08:14.59,0:08:15.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:15.79,0:08:16.76,Default,,0,0,0,,Жетеді, солай ма?
Dialogue: 0,0:08:16.82,0:08:18.86,Default,,0,0,0,,Ширли! Басталғалы жатыр
Dialogue: 0,0:08:19.19,0:08:20.50,Default,,0,0,0,,Енді жүр!
Dialogue: 0,0:08:20.60,0:08:23.10,Default,,0,0,0,,Кездескенше, төраға! Иә
Dialogue: 0,0:08:24.73,0:08:25.97,Default,,0,0,0,,Мен жай ғана жеңіске жету мақсатымен келдім—
Dialogue: 0,0:08:26.07,0:08:27.64,Default,,0,0,0,,Тек... күрес.
Dialogue: 0,0:08:27.70,0:08:31.77,Default,,0,0,0,,Сонымен, сіз басқа біреуді ойнайсыз ба?Бұл сүйкімді ойын
Dialogue: 0,0:08:32.24,0:08:35.71,Default,,0,0,0,,Кешіріңіз, бірақ сіз маған тең келе аласыз ба?Шаң суығанша
Dialogue: 0,0:08:35.81,0:08:38.71,Default,,0,0,0,,Жақсы, бірақ бұл көп уақытты алатын сияқты ма?
Dialogue: 0,0:08:38.81,0:08:40.68,Default,,0,0,0,,Иә, мүмкін
Dialogue: 0,0:08:43.22,0:08:44.12,Default,,0,0,0,,Гуааа
Dialogue: 0,0:08:44.52,0:08:47.19,Default,,0,0,0,,Менің іздеп жүргенім - рефрен дилері емес.
Dialogue: 0,0:08:47.29,0:08:49.99,Default,,0,0,0,,Мен оның Мао есімді шығыстық екенін айттым ғой!
Dialogue: 0,0:08:50.09,0:08:54.13,Default,,0,0,0,,Концессияда шығыстықпын десең, тек қызметші болып жұмыс істейсің! ―
Dialogue: 0,0:08:54.23,0:08:55.86,Default,,0,0,0,,Полицияға барыңыз...
Dialogue: 0,0:08:56.06,0:08:57.67,Default,,0,0,0,,Мен полицияны жек көремін!
Dialogue: 0,0:08:57.77,0:09:00.30,Default,,0,0,0,,Олай болса... Қара рыцарлардан сұраңыз...
Dialogue: 0,0:09:00.60,0:09:04.27,Default,,0,0,0,,Егер бұл кері бағыт болса, Концессия да, Гетто да дәл қазір ең күшті.
Dialogue: 0,0:09:04.57,0:09:06.57,Default,,0,0,0,,Барлығы бірдей жауап береді!
Dialogue: 0,0:09:06.67,0:09:07.81,Default,,0,0,0,,Әрине!
Dialogue: 0,0:09:07.88,0:09:08.94,Default,,0,0,0,,Құт
Dialogue: 0,0:09:10.01,0:09:12.61,Default,,0,0,0,,Иә, бұл біртүрлі.
Dialogue: 0,0:09:12.68,0:09:14.12,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:09:14.22,0:09:16.28,Default,,0,0,0,,Не іздедіңіз?
Dialogue: 0,0:09:16.58,0:09:20.02,Default,,0,0,0,,Мен күнделігімді таба алмай жатырмын...
Dialogue: 0,0:09:20.12,0:09:22.26,Default,,0,0,0,,Иә?Сіз оны сыртқа шығардыңыз ба?
Dialogue: 0,0:09:22.56,0:09:23.89,Default,,0,0,0,,Маасака
Dialogue: 0,0:09:29.13,0:09:33.03,Default,,0,0,0,,Иә, кешіріңіз. Нөл, Мао деген адам әлі...
Dialogue: 0,0:09:33.13,0:09:34.17,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:34.57,0:09:36.27,Default,,0,0,0,,Сіз Киотоның ақпараттық желісін де пайдаланасыз ба?
Dialogue: 0,0:09:36.57,0:09:40.91,Default,,0,0,0,,Жоқ, тек Kanto блогы жақсы. Егер сіз желіге түсіп қалсаңыз, маған хабарласыңыз.
Dialogue: 0,0:09:41.01,0:09:41.94,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:09:42.04,0:09:44.08,Default,,0,0,0,,Уақытында тағы кездескенше.
Dialogue: 0,0:09:45.75,0:09:49.82,Default,,0,0,0,,Егер сіз 500 метрге жақындасаңыз, Мао сіздің ойыңызды оқиды.
Dialogue: 0,0:09:49.92,0:09:54.02,Default,,0,0,0,,Бірақ екінші жағынан, бұл оның қолын оқудың шартына айналады.
Dialogue: 0,0:09:54.69,0:09:55.69,Default,,0,0,0,,Цк, иә!
Dialogue: 0,0:09:55.79,0:09:57.69,Default,,0,0,0,,１…
Dialogue: 0,0:09:57.79,0:09:59.59,Default,,0,0,0,,Жеткіліксіз бе?
Dialogue: 0,0:09:59.99,0:10:03.03,Default,,0,0,0,,Шамасы, біз де солай ойлаймыз.
Dialogue: 0,0:10:03.60,0:10:04.93,Default,,0,0,0,,Олардың тәрбиесіне байланысты
Dialogue: 0,0:10:05.03,0:10:07.87,Default,,0,0,0,,Біз ынтымақтастық жасай аламыз деп ойлайсыз ба?
Dialogue: 0,0:10:07.97,0:10:08.07,Default,,0,0,0,,Ах-
Dialogue: 0,0:10:08.07,0:10:08.94,Default,,0,0,0,,Ах-
Dialogue: 0,0:10:08.07,0:10:08.94,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:10:08.94,0:10:09.04,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:10:09.04,0:10:10.04,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:10:09.04,0:10:10.04,Default,,0,0,0,,Иә? ―
Dialogue: 0,0:10:10.04,0:10:11.14,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:10:13.98,0:10:15.01,Default,,0,0,0,,Хун
Dialogue: 0,0:10:16.21,0:10:17.21,Default,,0,0,0,,Иә
Dialogue: 0,0:10:17.65,0:10:19.21,Default,,0,0,0,,Бұл менмін, Лулу.
Dialogue: 0,0:10:19.28,0:10:21.68,Default,,0,0,0,,Сіз сондасыз ба? C.C.-
Dialogue: 0,0:10:21.78,0:10:24.79,Default,,0,0,0,,Мен сенімен жалғыз сөйлескім келеді, менің орныма өтінемін.
Dialogue: 0,0:10:29.69,0:10:30.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:31.39,0:10:33.16,Default,,0,0,0,,) Байқадыңыз ба?
Dialogue: 0,0:10:33.33,0:10:34.76,Default,,0,0,0,,Иә
Dialogue: 0,0:10:34.93,0:10:37.30,Default,,0,0,0,,Неліктен ол жерде жатты? ―
Dialogue: 0,0:10:38.07,0:10:39.17,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:10:39.27,0:10:40.97,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:41.67,0:10:42.64,Default,,0,0,0,,Сол түнде толық ай болды
Dialogue: 0,0:10:42.70,0:10:43.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:43.90,0:10:45.31,Default,,0,0,0,,Не?
Dialogue: 0,0:10:45.84,0:10:47.71,Default,,0,0,0,,Мен есімде қалғаныма сене алар емеспін...
Dialogue: 0,0:10:47.81,0:10:50.01,Default,,0,0,0,,Нөл туралы не деуге болады? Сіз ол кезде болдыңыз!
Dialogue: 0,0:10:50.11,0:10:50.98,Default,,0,0,0,,Нөл дегеніміз не?
Dialogue: 0,0:10:51.08,0:10:52.01,Default,,0,0,0,,Ах! ―
Dialogue: 0,0:10:52.98,0:10:54.42,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:10:54.72,0:10:56.88,Default,,0,0,0,,Тіпті опасыздық жасадың, солай болды.
Dialogue: 0,0:10:57.15,0:10:58.42,Default,,0,0,0,,Өйткені... білмеймін.
Dialogue: 0,0:10:58.72,0:11:00.09,Default,,0,0,0,,Ха... уф!
Dialogue: 0,0:11:00.32,0:11:01.22,Default,,0,0,0,,Мен оны Солтүстік-Шығыс әскери театрдан алдым.
Dialogue: 0,0:11:01.66,0:11:03.76,Default,,0,0,0,,Кешіріңіз, бұл...
Dialogue: 0,0:11:03.86,0:11:07.73,Default,,0,0,0,,Мен оны көзімді жұмып шеше аламын, ал киюге келетін болсақ...
Dialogue: 0,0:11:08.16,0:11:11.33,Default,,0,0,0,,Бірақ... Мен бөлмені жылытып қойдым, сондықтан жақсы деп ойлаймын.
Dialogue: 0,0:11:11.43,0:11:13.27,Default,,0,0,0,,Ой, жақсы.
Dialogue: 0,0:11:13.70,0:11:14.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:14.70,0:11:17.41,Default,,0,0,0,,Әзірше мені жақсы адам көтеріп алған сияқты.
Dialogue: 0,0:11:17.71,0:11:18.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:19.11,0:11:20.11,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:11:21.71,0:11:25.11,Default,,0,0,0,,Қуан, Лелуч, сен екеуміз осында қоштасамыз.
Dialogue: 0,0:11:25.21,0:11:26.01,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:26.01,0:11:26.15,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:26.01,0:11:26.15,Default,,0,0,0,,Мен Маодан бастауды шештім.
Dialogue: 0,0:11:26.15,0:11:28.35,Default,,0,0,0,,Мен Маодан бастауды шештім.
Dialogue: 0,0:11:28.45,0:11:29.45,Default,,0,0,0,,Маған опасыздық жасайсың ба?
Dialogue: 0,0:11:29.92,0:11:31.19,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:11:31.89,0:11:34.36,Default,,0,0,0,,Менің сенімен дос болайын деген ойым болған жоқ.
Dialogue: 0,0:11:34.46,0:11:36.26,Default,,0,0,0,,Жай сыбайлас
Dialogue: 0,0:11:36.36,0:11:37.39,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:38.43,0:11:42.13,Default,,0,0,0,,Бұл таң қалдырады. Сонда бұл Мао сияқты.
Dialogue: 0,0:11:43.26,0:11:47.40,Default,,0,0,0,,C.C. Сіз мен туралы тым көп білесіз
Dialogue: 0,0:11:47.70,0:11:50.10,Default,,0,0,0,,Мен сені бұлай жібере алмаймын.
Dialogue: 0,0:11:51.41,0:11:55.84,Default,,0,0,0,,Барма, менімен қал! C.C.
Dialogue: 0,0:11:58.75,0:11:59.91,Default,,0,0,0,,Иә
Dialogue: 0,0:12:00.15,0:12:03.18,Default,,0,0,0,,Мен сізге Geass маған жұмыс істемейтінін айттым, солай ма?
Dialogue: 0,0:12:03.25,0:12:04.42,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:04.99,0:12:08.49,Default,,0,0,0,,Уайымдама, мен сен туралы айтпаймын.
Dialogue: 0,0:12:09.06,0:12:10.32,Default,,0,0,0,,Геасс өзгеріссіз қалады.
Dialogue: 0,0:12:11.09,0:12:14.86,Default,,0,0,0,,Тіпті Мао енді ешқашан сіздің алдыңыздан шықпайды.
Dialogue: 0,0:12:14.96,0:12:16.90,Default,,0,0,0,,Енді кедергі жойылды.
Dialogue: 0,0:12:17.00,0:12:19.17,Default,,0,0,0,,Құттықтаймыз Қош бол
Dialogue: 0,0:12:19.33,0:12:21.04,Default,,0,0,0,,(Автоматты есіктің жабылу дыбысы)
Dialogue: 0,0:12:29.04,0:12:31.18,Default,,0,0,0,,Сынақ нәтижелері жақсы.
Dialogue: 0,0:12:31.28,0:12:33.51,Default,,0,0,0,,Тәртіп пен өмір тармақтарына қатысты.
Dialogue: 0,0:12:33.81,0:12:36.18,Default,,0,0,0,,Сандар тым көп сияқты.
Dialogue: 0,0:12:36.25,0:12:38.12,Default,,0,0,0,,Маңызды ма?
Dialogue: 0,0:12:38.22,0:12:40.89,Default,,0,0,0,,Өте жақсы, солдат ретінде...
Dialogue: 0,0:12:41.02,0:12:44.19,Default,,0,0,0,,Сіз өзіңізді әкеңізбен санасыз түрде салыстырасыз ба?
Dialogue: 0,0:12:44.19,0:12:44.53,Default,,0,0,0,,Сіз өзіңізді әкеңізбен санасыз түрде салыстырасыз ба?
Dialogue: 0,0:12:44.19,0:12:44.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:44.53,0:12:45.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:45.23,0:12:45.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:45.23,0:12:45.39,Default,,0,0,0,,Мүмкін сізді дәл осылай анықтайды...
Dialogue: 0,0:12:45.39,0:12:48.06,Default,,0,0,0,,Мүмкін бұл сізді анықтайды...
Dialogue: 0,0:12:48.40,0:12:51.80,Default,,0,0,0,,Бұл атақты ата-ананың балаларында жиі кездеседі ме?
Dialogue: 0,0:12:51.87,0:12:55.07,Default,,0,0,0,,Гэнбу Куруруги Жапонияның бұрынғы премьер-министрі
Dialogue: 0,0:12:55.17,0:12:56.54,Default,,0,0,0,,Ол жақсы адам болған көрінеді.
Dialogue: 0,0:12:57.94,0:12:59.94,Default,,0,0,0,,Кеш болды, Урабе және басқалар.
Dialogue: 0,0:13:00.21,0:13:03.28,Default,,0,0,0,,Қалай болғанда да, бұл ирониялық кездесу орны.
Dialogue: 0,0:13:03.38,0:13:05.78,Default,,0,0,0,,Премьер-министр Куруругидің кенотафы дегеніміз не?
Dialogue: 0,0:13:05.88,0:13:09.88,Default,,0,0,0,,Мұқият қарсылық көрсетуді жақтаса да бірінші болып өз-өзіне қол жұмсаған сатқын.
Dialogue: 0,0:13:10.08,0:13:10.99,Default,,0,0,0,,) Келіңіздер!
Dialogue: 0,0:13:11.09,0:13:15.06,Default,,0,0,0,,Бұдан артық кез келген нәрсе тіпті өз-өзіне қол жұмсаған генерал-майор Катаседен бас тартуды білдіреді.
Dialogue: 0,0:13:17.09,0:13:20.46,Default,,0,0,0,,Жасырын әрекет табылды. Әр команда оны қорғауға дайындалады.
Dialogue: 0,0:13:20.56,0:13:22.10,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:13:24.33,0:13:27.40,Default,,0,0,0,,Мен Қара рыцарьлардың қайта құру жоспарын оқыдым.
Dialogue: 0,0:13:29.10,0:13:31.31,Default,,0,0,0,,Мен түзетілгенін көргім келетін кейбір бөліктер бар.
Dialogue: 0,0:13:31.41,0:13:33.04,Default,,0,0,0,,Мен негізінен түсіндім.
Dialogue: 0,0:13:33.14,0:13:35.28,Default,,0,0,0,,Ойларыңызды да желдеткіш арқылы өткізейік.
Dialogue: 0,0:13:35.54,0:13:37.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:37.18,0:13:39.48,Default,,0,0,0,,Топ ретіндегі жасушалардың күтілетін функционалдық диаграммасы -
Dialogue: 0,0:13:39.58,0:13:42.05,Default,,0,0,0,,Мен Next Take қолданбасының оны қосқанын қалаймын.
Dialogue: 0,0:13:42.15,0:13:43.18,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:43.28,0:13:46.02,Default,,0,0,0,,Бұл соңғы сынақ па?
Dialogue: 0,0:13:46.45,0:13:48.16,Default,,0,0,0,,Диетард
Dialogue: 0,0:13:48.26,0:13:51.49,Default,,0,0,0,,Ол британдық, бірақ ол мен күткеннен де пайдалырақ болатын сияқты.
Dialogue: 0,0:13:51.59,0:13:54.90,Default,,0,0,0,,Мен шпион болу мүмкіндігін әлі де жоққа шығара алмаймын.
Dialogue: 0,0:13:55.00,0:13:56.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:56.40,0:13:58.90,Default,,0,0,0,,Маоның телефон қоңырауы
Dialogue: 0,0:14:07.01,0:14:10.21,Default,,0,0,0,,(ойын-сауық саябағы музыкасы)
Dialogue: 0,0:14:16.42,0:14:18.09,Default,,0,0,0,,Ｃ.Ｃ.―
Dialogue: 0,0:14:18.19,0:14:20.52,Default,,0,0,0,,Сіз қандай тынышсыз! ―
Dialogue: 0,0:14:20.59,0:14:23.06,Default,,0,0,0,,Мен сіздің ойыңызды оқи алмаймын
Dialogue: 0,0:14:23.59,0:14:25.43,Default,,0,0,0,,Сен ең жақсысың
Dialogue: 0,0:14:26.13,0:14:27.60,Default,,0,0,0,,Сен әлі баласың.
Dialogue: 0,0:14:27.86,0:14:30.33,Default,,0,0,0,,Мені ақ боз атты ханзадасы деп атағаныңызды қалаймын.
Dialogue: 0,0:14:30.87,0:14:32.87,Default,,0,0,0,,Мен сені алып кетуге келдім.
Dialogue: 0,0:14:33.30,0:14:35.47,Default,,0,0,0,,Хаха...
Dialogue: 0,0:14:35.57,0:14:37.40,Default,,0,0,0,,Сіз бақыттысыз ба? C.C.
Dialogue: 0,0:14:37.47,0:14:40.24,Default,,0,0,0,,Мао Мен мұны бұрын айттым деп ойлаймын.
Dialogue: 0,0:14:40.34,0:14:41.34,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:41.41,0:14:43.28,Default,,0,0,0,,Бұл өтірік, өтірік
Dialogue: 0,0:14:43.38,0:14:45.65,Default,,0,0,0,,Өйткені C.C. мені сүйеді.
Dialogue: 0,0:14:46.58,0:14:48.22,Default,,0,0,0,,Маоға рахмет
Dialogue: 0,0:14:48.32,0:14:49.22,Default,,0,0,0,,Мао Мао
Dialogue: 0,0:14:49.22,0:14:49.58,Default,,0,0,0,,Мао Мао
Dialogue: 0,0:14:49.22,0:14:49.58,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:14:49.58,0:14:50.45,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:14:50.65,0:14:52.32,Default,,0,0,0,,Шулы!
Dialogue: 0,0:14:53.32,0:14:57.12,Default,,0,0,0,,Уайымдама, менің дауысымды тыңда
Dialogue: 0,0:14:57.22,0:14:58.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:58.33,0:14:59.59,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:00.26,0:15:02.96,Default,,0,0,0,,Менің жүрегім естімесе...
Dialogue: 0,0:15:03.06,0:15:05.57,Default,,0,0,0,,Тек екеуіңіз ғана тынышталсаңыз...
Dialogue: 0,0:15:06.23,0:15:08.64,Default,,0,0,0,,Мен әрқашан сенің жаныңдамын -
Dialogue: 0,0:15:09.64,0:15:11.04,Default,,0,0,0,,Ах-
Dialogue: 0,0:15:11.17,0:15:13.14,Default,,0,0,0,,Мен осындамын -
Dialogue: 0,0:15:13.47,0:15:15.24,Default,,0,0,0,,Сондықтан уайымдамаңыз
Dialogue: 0,0:15:15.48,0:15:17.38,Default,,0,0,0,,C.C. Тек сен ғана.
Dialogue: 0,0:15:17.95,0:15:20.15,Default,,0,0,0,,Мен қалаған жалғыз нәрсе сенсің
Dialogue: 0,0:15:20.25,0:15:23.32,Default,,0,0,0,,Сіз келгенше, Лелуш маған бәрібір.
Dialogue: 0,0:15:23.38,0:15:24.95,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:15:25.22,0:15:26.35,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:28.22,0:15:30.66,Default,,0,0,0,,Бұл басынан бері жасалуы керек еді.
Dialogue: 0,0:15:30.93,0:15:32.59,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:33.93,0:15:35.40,Default,,0,0,0,,Бұл мен С.С.
Dialogue: 0,0:15:35.50,0:15:36.63,Default,,0,0,0,,Мао
Dialogue: 0,0:15:37.03,0:15:38.50,Default,,0,0,0,,Кловис жерінде күту-
Dialogue: 0,0:15:38.60,0:15:40.03,Default,,0,0,0,,Жалғыз кел
Dialogue: 0,0:15:40.13,0:15:43.00,Default,,0,0,0,,Ха, бәрібір бір жақты.
Dialogue: 0,0:15:43.10,0:15:44.10,Default,,0,0,0,,Келмесең...
Dialogue: 0,0:15:44.20,0:15:46.47,Default,,0,0,0,,Лелуштың шынайы тұлғасын ашыңыз, жарай ма? ―
Dialogue: 0,0:15:46.57,0:15:49.64,Default,,0,0,0,,Сіз оны әрқашан өлтіре аласыз.
Dialogue: 0,0:15:50.41,0:15:54.05,Default,,0,0,0,,Қуан, Лелух, сен екеуміз осында қоштасамыз.
Dialogue: 0,0:15:55.28,0:15:56.55,Default,,0,0,0,,мүлдем-
Dialogue: 0,0:15:56.65,0:15:59.25,Default,,0,0,0,,Рұқсатсыз қайтып келу немесе кету.
Dialogue: 0,0:15:59.35,0:16:01.62,Default,,0,0,0,,Бір жақты әйелді түсіну қиын.
Dialogue: 0,0:16:03.09,0:16:03.96,Default,,0,0,0,,Стейннен алған жарақаттарым әлі толық жазылмағандықтан—
Dialogue: 0,0:16:04.33,0:16:05.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:05.43,0:16:08.20,Default,,0,0,0,,Өйткені, C.C. мені ата алмады.
Dialogue: 0,0:16:08.30,0:16:10.16,Default,,0,0,0,,C.C. мені ұнатады.
Dialogue: 0,0:16:10.26,0:16:12.50,Default,,0,0,0,,Аха…
Dialogue: 0,0:16:12.57,0:16:15.20,Default,,0,0,0,,Жоқ! Мен сені ғана пайдаланып едім!
Dialogue: 0,0:16:15.50,0:16:19.37,Default,,0,0,0,,Не? Сен не туралы айтып тұрсың? Өтірік айтпа, өтірік
Dialogue: 0,0:16:19.67,0:16:21.01,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:21.18,0:16:22.68,Default,,0,0,0,,Өтірік жақсы емес
Dialogue: 0,0:16:22.74,0:16:23.61,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:16:23.71,0:16:25.28,Default,,0,0,0,,Уф! Ах! Уф!
Dialogue: 0,0:16:25.68,0:16:27.01,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:16:27.68,0:16:29.15,Default,,0,0,0,,Себебі мен түсінемін
Dialogue: 0,0:16:29.38,0:16:30.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:32.02,0:16:34.15,Default,,0,0,0,,C.C. Мен.
Dialogue: 0,0:16:34.25,0:16:36.66,Default,,0,0,0,,Мен Австралияда үй салдым.
Dialogue: 0,0:16:36.76,0:16:39.49,Default,,0,0,0,,Ақ, әдемі, өте тыныш үй
Dialogue: 0,0:16:39.99,0:16:41.43,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:16:41.76,0:16:43.63,Default,,0,0,0,,Бірақ Австралияға бару
Dialogue: 0,0:16:43.73,0:16:46.53,Default,,0,0,0,,Мен ұшаққа отыруым керек.
Dialogue: 0,0:16:47.00,0:16:49.30,Default,,0,0,0,,Бірақ С.С. ұшаққа...
Dialogue: 0,0:16:49.40,0:16:51.04,Default,,0,0,0,,Кішкене тым үлкен
Dialogue: 0,0:16:51.14,0:16:52.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:52.24,0:16:53.64,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:16:55.38,0:16:57.18,Default,,0,0,0,,Мен оны жинақтаймын.
Dialogue: 0,0:16:57.44,0:16:59.55,Default,,0,0,0,,Бұл қысқа уақытта орындалады!
Dialogue: 0,0:17:01.35,0:17:03.65,Default,,0,0,0,,Сіз мені жазалағыңыз келе ме?Маған...
Dialogue: 0,0:17:04.32,0:17:08.09,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:17:09.06,0:17:10.76,Default,,0,0,0,,Бұл алғыс сезімі.
Dialogue: 0,0:17:11.06,0:17:12.66,Default,,0,0,0,,Ол сонда болды ма?
Dialogue: 0,0:17:13.16,0:17:14.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:14.19,0:17:16.63,Default,,0,0,0,,Басқа адамдардың дауысы кедергі келтірмейтін жер -
Dialogue: 0,0:17:16.73,0:17:18.80,Default,,0,0,0,,Орынды автоматты түрде тарылтпаңыз.
Dialogue: 0,0:17:19.10,0:17:19.80,Default,,0,0,0,,Лелуш
Dialogue: 0,0:17:20.07,0:17:20.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:21.24,0:17:24.77,Default,,0,0,0,,Geass-тың тиімді қашықтығы 500 метрге дейін.
Dialogue: 0,0:17:25.07,0:17:27.17,Default,,0,0,0,,Біз бұл Токио мұнарасына жете алмаймыз.
Dialogue: 0,0:17:27.47,0:17:28.48,Default,,0,0,0,,Хаха
Dialogue: 0,0:17:28.58,0:17:30.11,Default,,0,0,0,,Шынында да, әрине-
Dialogue: 0,0:17:30.34,0:17:33.45,Default,,0,0,0,,Бірақ эй, сен бұл туралы не істейсің? ―
Dialogue: 0,0:17:33.55,0:17:36.68,Default,,0,0,0,,Сіз көп бұзу және ауыр жұмыс жасаған сияқтысыз...
Dialogue: 0,0:17:36.78,0:17:41.42,Default,,0,0,0,,Басқа ойыншықтарды қашықтан басқарып, маған шабуыл жасайсыз ба? ―
Dialogue: 0,0:17:41.52,0:17:45.49,Default,,0,0,0,,Әлде шебер аузыңмен жеңесің бе? ―
Dialogue: 0,0:17:46.53,0:17:48.83,Default,,0,0,0,,Эй, сен бұл жолы Данмарисің бе? ―
Dialogue: 0,0:17:49.13,0:17:51.10,Default,,0,0,0,,Егер сіз С.С.-ны қаласаңыз, сіз де...
Dialogue: 0,0:17:51.20,0:17:54.30,Default,,0,0,0,,Мао, мені С.С. деп атайды деп ойламадым.
Dialogue: 0,0:17:54.40,0:17:56.74,Default,,0,0,0,,Сіз бұл сіздің шын есіміңіз деп ойлайтын шығарсыз, солай емес пе?
Dialogue: 0,0:17:56.80,0:17:57.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:58.11,0:17:58.77,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:18:02.21,0:18:05.65,Default,,0,0,0,,Мен сенің шын атыңды білемін.
Dialogue: 0,0:18:07.11,0:18:11.72,Default,,0,0,0,,Солай ма? C.C. Сен маған айтпадың.
Dialogue: 0,0:18:11.82,0:18:13.45,Default,,0,0,0,,Мұндай адам қалай...
Dialogue: 0,0:18:13.55,0:18:16.52,Default,,0,0,0,,Түсіндіңіз бе? C.C. менікі.
Dialogue: 0,0:18:17.52,0:18:20.46,Default,,0,0,0,,C.C. енді менікі, Мао.
Dialogue: 0,0:18:20.79,0:18:21.70,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:21.80,0:18:24.20,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ, жоқ, жоқ!
Dialogue: 0,0:18:24.30,0:18:26.67,Default,,0,0,0,,Бұл менің жалғыз CC болды. узақ уақытқа!
Dialogue: 0,0:18:27.27,0:18:29.87,Default,,0,0,0,,Мен C.C туралы бәрін білдім.
Dialogue: 0,0:18:30.17,0:18:32.64,Default,,0,0,0,,Соның ішінде сіз ешқашан көрмеген бөліктер
Dialogue: 0,0:18:32.71,0:18:33.74,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:33.74,0:18:34.17,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:33.74,0:18:34.17,Default,,0,0,0,,Барлығы
Dialogue: 0,0:18:34.17,0:18:34.61,Default,,0,0,0,,Барлығы
Dialogue: 0,0:18:34.61,0:18:35.44,Default,,0,0,0,,Барлығы
Dialogue: 0,0:18:34.61,0:18:35.44,Default,,0,0,0,,Лелуш!
Dialogue: 0,0:18:35.44,0:18:37.38,Default,,0,0,0,,Лелуш!
Dialogue: 0,0:18:37.44,0:18:38.31,Default,,0,0,0,,(Араның дыбысы)
Dialogue: 0,0:18:38.51,0:18:41.18,Default,,0,0,0,,Шық! Лелуш! ―
Dialogue: 0,0:18:41.25,0:18:45.52,Default,,0,0,0,,Мұнда кел, менің ішіме кір! Мен саған бір қарап алайын! ―
Dialogue: 0,0:18:46.25,0:18:48.46,Default,,0,0,0,,Бұл! Өтірікші!
Dialogue: 0,0:18:48.52,0:18:51.53,Default,,0,0,0,,Мао, сен жеңілдің.
Dialogue: 0,0:18:52.33,0:18:53.76,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:53.86,0:18:57.26,Default,,0,0,0,,Бұл жеткілікті. Мен С.С.-мен біргемін... Уф...
Dialogue: 0,0:18:57.33,0:18:58.57,Default,,0,0,0,,(Адамдардың жүрек үні)
Dialogue: 0,0:18:58.67,0:18:59.57,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:18:59.67,0:19:00.87,Default,,0,0,0,,Мунк…
Dialogue: 0,0:19:01.17,0:19:03.17,Default,,0,0,0,,Мен де Масэ Накаяманы кездестіргім келеді...
Dialogue: 0,0:19:03.24,0:19:05.44,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:19:05.54,0:19:08.34,Default,,0,0,0,,Лелуч? Бірақ қашықтық...
Dialogue: 0,0:19:08.44,0:19:09.88,Default,,0,0,0,,Әрекет ету...
Dialogue: 0,0:19:10.18,0:19:11.55,Default,,0,0,0,,Және...
Dialogue: 0,0:19:12.15,0:19:13.18,Default,,0,0,0,,Көп пе?
Dialogue: 0,0:19:13.25,0:19:16.15,Default,,0,0,0,,Міне! Қаруларыңызды тастап, беріліңіздер!
Dialogue: 0,0:19:16.22,0:19:17.65,Default,,0,0,0,,А... олар не?
Dialogue: 0,0:19:18.39,0:19:19.25,Default,,0,0,0,,Һм? Бұл не?
Dialogue: 0,0:19:19.92,0:19:22.92,Default,,0,0,0,,Ұрлаушыға айт! Қаруларыңызды тастап, беріліңіздер!
Dialogue: 0,0:19:23.69,0:19:25.73,Default,,0,0,0,,Ке... полиция?
Dialogue: 0,0:19:26.23,0:19:27.43,Default,,0,0,0,,Оны кім хабарлады?
Dialogue: 0,0:19:32.47,0:19:33.47,Default,,0,0,0,,Уф
Dialogue: 0,0:19:34.47,0:19:37.50,Default,,0,0,0,,А... Лелуш, сен мұнда неге келдің?
Dialogue: 0,0:19:37.74,0:19:41.24,Default,,0,0,0,,Бұл өтірік! Өйткені, сіз дәл қазір мұнарада болдыңыз!
Dialogue: 0,0:19:42.34,0:19:45.85,Default,,0,0,0,,Сен ақымақсың ба? Әзірге бұл жазба.
Dialogue: 0,0:19:46.31,0:19:47.18,Default,,0,0,0,,Бұл өтірік! ―
Dialogue: 0,0:19:47.55,0:19:50.38,Default,,0,0,0,,Өйткені... өйткені сен менімен сөйлесіп тұрдың!
Dialogue: 0,0:19:50.48,0:19:52.59,Default,,0,0,0,,Сіздің ойыңыз тым қарапайым.
Dialogue: 0,0:19:52.69,0:19:54.52,Default,,0,0,0,,Ақыл оқи білу менің лақап атыма айналды.
Dialogue: 0,0:19:54.79,0:19:57.36,Default,,0,0,0,,Менің жауабымды болжадың ба?
Dialogue: 0,0:19:57.46,0:19:59.46,Default,,0,0,0,,Блять сені, брат! ―
Dialogue: 0,0:19:59.56,0:20:01.76,Default,,0,0,0,,Полиция мені ұстаса да, мен бірден шығамын!
Dialogue: 0,0:20:02.46,0:20:04.33,Default,,0,0,0,,Сіз не айттыңыз? (Офицер) Өзімен өзі сөйлесе ме?
Dialogue: 0,0:20:04.36,0:20:06.60,Default,,0,0,0,,Сен жындысың ба? (Офицер) Сіз біртүрлі әрекет етесіз.
Dialogue: 0,0:20:06.60,0:20:07.47,Default,,0,0,0,,Сен жындысың ба? (Офицер) Сіз біртүрлі әрекет етесіз.
Dialogue: 0,0:20:06.60,0:20:07.47,Default,,0,0,0,,Қаруыңызды қойыңыз
Dialogue: 0,0:20:07.47,0:20:07.57,Default,,0,0,0,,Қаруыңызды қойыңыз
Dialogue: 0,0:20:07.57,0:20:07.77,Default,,0,0,0,,Қаруыңызды қойыңыз
Dialogue: 0,0:20:07.57,0:20:07.77,Default,,0,0,0,,Хабарланғандай, мен Рефраинге тәуелдімін деп ойлаймын.
Dialogue: 0,0:20:07.77,0:20:10.27,Default,,0,0,0,,Хабарланғандай, мен Рефраинге тәуелдімін деп ойлаймын.
Dialogue: 0,0:20:10.34,0:20:13.41,Default,,0,0,0,,Шулы, мен туралы жаман сөз айтпа!
Dialogue: 0,0:20:13.97,0:20:16.74,Default,,0,0,0,,Huh, C.C. маған айтты -
Dialogue: 0,0:20:17.24,0:20:19.21,Default,,0,0,0,,Geass қолданбасын өшіре алмайсыз.
Dialogue: 0,0:20:19.31,0:20:22.22,Default,,0,0,0,,Дегенмен, тиімді диапазон концентрацияға байланысты.
Dialogue: 0,0:20:22.32,0:20:25.42,Default,,0,0,0,,Сіз мені алаңдату үшін мониторды пайдаландыңыз ба?
Dialogue: 0,0:20:25.52,0:20:29.86,Default,,0,0,0,,Бірақ... Менде әлі де сені жеңетін жолым бар!
Dialogue: 0,0:20:29.96,0:20:32.76,Default,,0,0,0,,Сіз мұны істегенде, бұл сіздің соңғы.
Dialogue: 0,0:20:33.36,0:20:35.70,Default,,0,0,0,,Күте тұрыңыз, Лелуч, егер дұрыс сөйлесеңіз!
Dialogue: 0,0:20:35.76,0:20:37.63,Default,,0,0,0,,Соңы не болды?
Dialogue: 0,0:20:37.73,0:20:41.94,Default,,0,0,0,,Полиция, мұқият тыңдаңыз! Мына жақтағы жігіт террорист!
Dialogue: 0,0:20:42.00,0:20:42.87,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:20:46.81,0:20:47.67,Default,,0,0,0,,Мао!
Dialogue: 0,0:20:47.84,0:20:50.64,Default,,0,0,0,,А... а...
Dialogue: 0,0:20:50.74,0:20:52.28,Default,,0,0,0,,Нөл…
Dialogue: 0,0:20:55.75,0:21:00.72,Default,,0,0,0,,Келісімшарт жасаған кезде Мао небәрі 6 жаста және жетім бала еді.
Dialogue: 0,0:21:01.32,0:21:06.33,Default,,0,0,0,,Мен оқу мен жазу туралы, ата-анамның махаббаты туралы, дұрыс пен бұрыс туралы ештеңе білмедім.
Dialogue: 0,0:21:06.69,0:21:07.76,Default,,0,0,0,,Бұл Үш жаңғырық
Dialogue: 0,0:21:07.86,0:21:10.00,Default,,0,0,0,,Жоспар бойынша геттодағы кепілге алынғандарды босатты.
Dialogue: 0,0:21:10.30,0:21:12.57,Default,,0,0,0,,Не? Ауруханаға тасымалдау қалай...
Dialogue: 0,0:21:13.00,0:21:15.40,Default,,0,0,0,,Мен берген Геастың күші...
Dialogue: 0,0:21:15.50,0:21:17.60,Default,,0,0,0,,Ол адамдарды Маодан алыстатты.
Dialogue: 0,0:21:18.04,0:21:22.04,Default,,0,0,0,,Сондықтан мен Маоның ең жақын досы және сүйіктісімін...
Dialogue: 0,0:21:22.41,0:21:23.81,Default,,0,0,0,,Бұл бейтаныс адам еді
Dialogue: 0,0:21:25.01,0:21:28.28,Default,,0,0,0,,Мао үшін жалғыз адам мен болдым.
Dialogue: 0,0:21:28.58,0:21:30.48,Default,,0,0,0,,Бұл дүниедегі барлық нәрсе болды
Dialogue: 0,0:21:32.65,0:21:33.79,Default,,0,0,0,,Ｃ.Ｃ.―
Dialogue: 0,0:21:34.32,0:21:36.49,Default,,0,0,0,,Мен Геасстан жеңілмеймін.
Dialogue: 0,0:21:36.59,0:21:39.59,Default,,0,0,0,,Мен бұл билікті басқарамын және оны толық пайдаланамын.
Dialogue: 0,0:21:39.73,0:21:41.90,Default,,0,0,0,,Осы әлемді өзгертейік -
Dialogue: 0,0:21:42.63,0:21:46.33,Default,,0,0,0,,Тілегімді де, сенің де тілегіңді орындаймын.
Dialogue: 0,0:21:46.53,0:21:51.00,Default,,0,0,0,,Мен ол орындай алмаған шартты орындаймын, сондықтан...
Dialogue: 0,0:21:51.31,0:21:51.97,Default,,0,0,0,,Лелуш
Dialogue: 0,0:21:52.44,0:21:53.31,Default,,0,0,0,,Ах
Dialogue: 0,0:21:53.51,0:21:57.91,Default,,0,0,0,,Жайлылық?Өкінішті ме?Немесе...
Dialogue: 0,0:21:58.01,0:21:59.05,Default,,0,0,0,,Оңбау?
Dialogue: 0,0:22:01.52,0:22:05.59,Default,,0,0,0,,Бұл келісім-шарт, бұл жолы меннен сізге.
Dialogue: 0,0:22:07.32,0:22:08.66,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:22:08.76,0:22:10.92,Default,,0,0,0,,Сол келісім-шартты жасайық
Dialogue: 0,0:22:17.73,0:22:21.40,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:22:21.50,0:22:25.01,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:22:25.11,0:22:32.11,Default,,0,0,0,,♪Сіз маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:22:40.82,0:22:47.83,Default,,0,0,0,,♪Бұлай болуы мүмкін емес,-деп ойланып ұйықтап қалдым
Dialogue: 0,0:22:48.13,0:22:51.60,Default,,0,0,0,,♪Мен оянсам, әдеттегідей
Dialogue: 0,0:22:51.70,0:22:55.90,Default,,0,0,0,,♪ Өзгеріссіз бос жүріс
Dialogue: 0,0:22:56.00,0:23:01.37,Default,,0,0,0,,♪ Мағынасыз қайталанады
Dialogue: 0,0:23:02.04,0:23:06.05,Default,,0,0,0,,♪Мозаикалық үзінділер жанды түрде бейнеленген
Dialogue: 0,0:23:06.15,0:23:09.42,Default,,0,0,0,,♪Бұрынғы өтірік пен қателіктер
Dialogue: 0,0:23:09.52,0:23:16.52,Default,,0,0,0,,♪Оны өшіргім келген сайын, ол туралы көбірек ойлаймын
Dialogue: 0,0:23:16.89,0:23:18.13,Default,,0,0,0,,♪Артқа қарап
Dialogue: 0,0:23:18.43,0:23:21.63,Default,,0,0,0,,♪Бастау сызығы бар
Dialogue: 0,0:23:21.73,0:23:24.03,Default,,0,0,0,,♪Әлі прогресс жоқ
Dialogue: 0,0:23:24.13,0:23:31.14,Default,,0,0,0,,♪Тағыда арманымызды жинайық
Dialogue: 0,0:23:31.71,0:23:35.08,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:23:35.18,0:23:38.88,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:23:38.98,0:23:45.99,Default,,0,0,0,,♪Сен маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:23:48.92,0:23:50.42,Default,,0,0,0,,Енді алға жылжу уақыты келді -
Dialogue: 0,0:23:50.52,0:23:52.76,Default,,0,0,0,,Корнелиямен танысып, одан шындықты сұраңыз.
Dialogue: 0,0:23:52.86,0:23:55.63,Default,,0,0,0,,Және Nunnally үшін орын жасаңыз.
Dialogue: 0,0:23:55.73,0:23:58.50,Default,,0,0,0,,Кішігірім ұрыс даласында енді ешқандай мағына жоқ.
Dialogue: 0,0:23:58.60,0:24:00.53,Default,,0,0,0,,Мен Токио концессиясын бақылауға аламын.
Dialogue: 0,0:24:00.63,0:24:02.84,Default,,0,0,0,,Ол үшін біз әскери күшімізді арттыруымыз керек.
Dialogue: 0,0:24:02.94,0:24:04.77,Default,,0,0,0,,Сыртқы күштер де қолданылады.
Dialogue: 0,0:24:04.84,0:24:07.74,Default,,0,0,0,,Барлық қолжетімді бөліктерді пайдаланыңыз
Dialogue: 0,0:24:09.24,0:24:15.24,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory