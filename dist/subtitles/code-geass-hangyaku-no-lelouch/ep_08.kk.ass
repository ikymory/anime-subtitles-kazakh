Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.33,0:00:06.50,Default,,0,0,0,,Лелуч, Британдық бала...
Dialogue: 0,0:00:06.60,0:00:10.17,Default,,0,0,0,,Жұмбақ қыздан ерекше қабілет алған С.С.
Dialogue: 0,0:00:11.11,0:00:12.31,Default,,0,0,0,,Геасс...
Dialogue: 0,0:00:12.41,0:00:16.31,Default,,0,0,0,,Кез келген қарсыласқа пәрмен беруге мүмкіндік беретін абсолютті бағыну күші.
Dialogue: 0,0:00:17.35,0:00:18.55,Default,,0,0,0,,Менің әпкем Нуналли үшін
Dialogue: 0,0:00:18.65,0:00:22.62,Default,,0,0,0,,Лелух Қасиетті Британ империясының жойылуын жоспарлайды.
Dialogue: 0,0:00:23.32,0:00:26.25,Default,,0,0,0,,Осы уақытта оның досы Сузаку Куруруги...
Dialogue: 0,0:00:26.35,0:00:29.42,Default,,0,0,0,,Ол империяның ішінде тірек тұрғызды.
Dialogue: 0,0:00:30.06,0:00:34.36,Default,,0,0,0,,Қазірдің өзінде осы сәтте болашақтың тағдыры сөзсіз...
Dialogue: 0,0:00:34.46,0:00:36.46,Default,,0,0,0,,Мүмкін бұл уәде етілген.
Dialogue: 0,0:00:41.57,0:00:47.58,Default,,0,0,0,,♪～
Dialogue: 0,0:00:50.18,0:00:54.08,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:00:54.18,0:00:57.45,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:00:57.55,0:01:03.32,Default,,0,0,0,,♪Сәт әрқашан жаныңда...
Dialogue: 0,0:01:05.36,0:01:11.67,Default,,0,0,0,,♪Жасырынбаған тітіркену
Dialogue: 0,0:01:12.40,0:01:18.67,Default,,0,0,0,,♪ Бір орында тұрып өзіңе қара
Dialogue: 0,0:01:18.77,0:01:22.28,Default,,0,0,0,,♪ойланып отырып, уайымдап
Dialogue: 0,0:01:22.38,0:01:25.68,Default,,0,0,0,,♪Өкінішпен шешім қабылдау керек.
Dialogue: 0,0:01:25.78,0:01:29.28,Default,,0,0,0,,♪Сен маған берген бір сөз
Dialogue: 0,0:01:29.38,0:01:33.12,Default,,0,0,0,,♪Менің шатасуым жоғалады
Dialogue: 0,0:01:33.22,0:01:39.43,Default,,0,0,0,,♪Бос бөлмеме нұр түсті
Dialogue: 0,0:01:39.76,0:01:43.16,Default,,0,0,0,,♪Мен қараған аспан
Dialogue: 0,0:01:43.30,0:01:46.84,Default,,0,0,0,,♪Көк түс анық және айқын болады
Dialogue: 0,0:01:47.14,0:01:53.41,Default,,0,0,0,,♪Мен жабық терезені ашуды шештім.
Dialogue: 0,0:01:53.64,0:01:57.51,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:01:57.61,0:02:00.65,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:02:01.22,0:02:07.52,Default,,0,0,0,,♪Сәтті сезін, осында және қазір...
Dialogue: 0,0:02:13.63,0:02:17.63,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:02:29.21,0:02:30.88,Default,,0,0,0,,Мен Токио концессиясынан шығамын.
Dialogue: 0,0:02:31.18,0:02:32.51,Default,,0,0,0,,Бұл менің бірінші рет.
Dialogue: 0,0:02:32.61,0:02:34.45,Default,,0,0,0,,Лелуштың да келуін қалаймын.
Dialogue: 0,0:02:34.55,0:02:35.42,Default,,0,0,0,,Не!
Dialogue: 0,0:02:35.52,0:02:39.25,Default,,0,0,0,,Ал, түні бойы сөйлесейік.
Dialogue: 0,0:02:39.35,0:02:41.46,Default,,0,0,0,,Өзімізге ұнайтын ұлдарды бір-бірімізге үйретейік
Dialogue: 0,0:02:41.56,0:02:43.69,Default,,0,0,0,,Сіз сондасыз ба?Төраға ретінде осындай адам
Dialogue: 0,0:02:43.79,0:02:45.16,Default,,0,0,0,,Хе, эй.
Dialogue: 0,0:02:46.66,0:02:47.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:50.40,0:02:51.53,Default,,0,0,0,,Жарайды
Dialogue: 0,0:02:51.63,0:02:55.47,Default,,0,0,0,,Кавагучи көлі қауіпсіз деп саналады, өйткені британдық туристер көп.
Dialogue: 0,0:02:55.57,0:02:58.27,Default,,0,0,0,,Бұл гетто (Нина) сияқты қорқынышты емес, бірақ...
Dialogue: 0,0:02:59.47,0:03:02.88,Default,,0,0,0,,Мен сенімен бірге боламын, сондықтан бұл жолы сені жалғыз қалдырмаймын.
Dialogue: 0,0:03:03.38,0:03:04.81,Default,,0,0,0,,Ум...
Dialogue: 0,0:03:09.52,0:03:10.45,Default,,0,0,0,,Уау
Dialogue: 0,0:03:13.82,0:03:14.86,Default,,0,0,0,,) Ой...
Dialogue: 0,0:03:14.96,0:03:17.56,Default,,0,0,0,,Не болды? Ерте кіріңіз -
Dialogue: 0,0:03:18.59,0:03:20.90,Default,,0,0,0,,Бұдан былай бұл біздің жасырынатын жеріміз.
Dialogue: 0,0:03:21.20,0:03:24.60,Default,,0,0,0,,Сіз бізбен бірлесесіз деп болжауға бола ма?
Dialogue: 0,0:03:24.70,0:03:26.73,Default,,0,0,0,,Аа, біз доспыз.
Dialogue: 0,0:03:26.83,0:03:30.54,Default,,0,0,0,,Бұл таңқаларлық. Бұл не? Бұл
Dialogue: 0,0:03:31.54,0:03:33.27,Default,,0,0,0,,Жер бетінде мұндай нәрсе қалай болуы мүмкін ...
Dialogue: 0,0:03:33.54,0:03:35.28,Default,,0,0,0,,Мен сұрағанымда берді.
Dialogue: 0,0:03:35.48,0:03:36.91,Default,,0,0,0,,Азғын ақсүйек
Dialogue: 0,0:03:37.21,0:03:39.51,Default,,0,0,0,,Сұрау өте оңай...
Dialogue: 0,0:03:39.61,0:03:41.75,Default,,0,0,0,,Жарайды, мен аяғымды ұстай алмаймын.
Dialogue: 0,0:03:42.25,0:03:43.79,Default,,0,0,0,,Ей, екінші қабат та бар.
Dialogue: 0,0:03:43.89,0:03:45.62,Default,,0,0,0,,Бұл көлік тым үлкен ме?
Dialogue: 0,0:03:45.72,0:03:48.72,Default,,0,0,0,,Бірақ екінші жағынан, бұл соқыр нүкте болуы мүмкін.
Dialogue: 0,0:03:48.82,0:03:51.23,Default,,0,0,0,,Тіпті теледидар қосулы.
Dialogue: 0,0:03:51.46,0:03:53.26,Default,,0,0,0,,Сайттағы жағдай қандай?
Dialogue: 0,0:03:51.46,0:03:53.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:53.36,0:03:54.23,Default,,0,0,0,,Не?
Dialogue: 0,0:03:54.33,0:03:54.96,Default,,0,0,0,,Бұл Кавагучи көлі
Dialogue: 0,0:03:55.26,0:03:56.90,Default,,0,0,0,,Convention Center қонақүйінің алдында
Dialogue: 0,0:03:57.00,0:03:59.87,Default,,0,0,0,,Қонақ үй иесі өзін Жапонияны азат ету майданы деп атайды...
Dialogue: 0,0:03:59.97,0:04:01.60,Default,,0,0,0,,Иә? (жанкүйер) Не болса да
Dialogue: 0,0:04:01.67,0:04:02.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:02.00,0:04:02.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:02.00,0:04:02.67,Default,,0,0,0,,Сакурадитті бөлу кеңесінің мүшелерімен-
Dialogue: 0,0:04:02.67,0:04:03.94,Default,,0,0,0,,Сакурадитті бөлу кеңесінің мүшелерімен-
Dialogue: 0,0:04:04.34,0:04:05.47,Default,,0,0,0,,Келген туристер -
Dialogue: 0,0:04:04.34,0:04:05.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:05.67,0:04:08.64,Default,,0,0,0,,және бірнеше қызметкер кепілде.
Dialogue: 0,0:04:08.74,0:04:10.95,Default,,0,0,0,,Бұл қылмыскер жіберген бейне.
Dialogue: 0,0:04:11.25,0:04:14.28,Default,,0,0,0,,Төраға Джеймстен басқа студенттерді де көруге болады.
Dialogue: 0,0:04:14.48,0:04:16.28,Default,,0,0,0,,Е, студенттік кеңес...
Dialogue: 0,0:04:16.38,0:04:17.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:17.32,0:04:18.65,Default,,0,0,0,,Қылмыстық топтың жетекшісі -
Dialogue: 0,0:04:18.75,0:04:20.76,Default,,0,0,0,,Мен подполковник Кусакабе есімді Жапонияның бұрынғы әскери офицерімін.
Dialogue: 0,0:04:20.86,0:04:22.56,Default,,0,0,0,,О, ақымақ!
Dialogue: 0,0:04:22.92,0:04:25.59,Default,,0,0,0,,Жоғары температуралы асқын өткізгіштерді өндіру үшін таптырмас
Dialogue: 0,0:04:25.69,0:04:26.69,Default,,0,0,0,,Сакурадит -
Dialogue: 0,0:04:26.86,0:04:30.77,Default,,0,0,0,,Әлемдік қауіпсіздікке тікелей қатысты маңызды стратегиялық материалдар.
Dialogue: 0,0:04:30.87,0:04:34.77,Default,,0,0,0,,11-аудан - әлемдегі ең ірі сакурадит өндірушісі.
Dialogue: 0,0:04:34.87,0:04:39.01,Default,,0,0,0,,Нарыққа ұсыныс 70%-ға жетеді.
Dialogue: 0,0:04:39.44,0:04:42.91,Default,,0,0,0,,Жыл сайын осында өткізілетін сакурадитті өндіруші елдер конференциясында-
Dialogue: 0,0:04:43.01,0:04:46.01,Default,,0,0,0,,Сакурадиттің халықаралық таралу жылдамдығын анықтаңыз -
Dialogue: 0,0:04:46.31,0:04:48.05,Default,,0,0,0,,Нәтиже – менің Британиям...
Dialogue: 0,0:04:48.35,0:04:52.05,Default,,0,0,0,,Басқа елдермен күштердің ара салмағы десек, артық айтқандық емес.
Dialogue: 0,0:04:52.35,0:04:53.42,Default,,0,0,0,,Террористер –
Dialogue: 0,0:04:53.52,0:04:55.56,Default,,0,0,0,,Бұл конференцияға халықаралық қоғамдық пікір қаншалықты қызығушылық танытып отыр?
Dialogue: 0,0:04:55.66,0:04:59.86,Default,,0,0,0,,Осыны ескере отырып, ол қонақүйді тонау деген шектен шыққан әрекетке барған сияқты.
Dialogue: 0,0:05:00.53,0:05:03.00,Default,,0,0,0,,Бұл Жапон азаттық майданының шөпті қабырғасы.
Dialogue: 0,0:05:03.30,0:05:06.43,Default,,0,0,0,,Біз Жапонияның тәуелсіздігі мен азаттығы үшін шықтық.
Dialogue: 0,0:05:06.73,0:05:09.67,Default,,0,0,0,,Сіз әскери қызметкер емессіз, бірақ британдықсыз.
Dialogue: 0,0:05:09.77,0:05:11.67,Default,,0,0,0,,Бізді басқаратын.
Dialogue: 0,0:05:11.94,0:05:13.74,Default,,0,0,0,,Сабыр сақтағанша...
Dialogue: 0,0:05:14.01,0:05:15.31,Default,,0,0,0,,Әйтпесе...
Dialogue: 0,0:05:15.41,0:05:16.31,Default,,0,0,0,,Лулу…
Dialogue: 0,0:05:16.54,0:05:17.91,Default,,0,0,0,,Ол қозғалады.
Dialogue: 0,0:05:18.01,0:05:21.38,Default,,0,0,0,,Бұл Жапониядағы британдыққа қарсы ең үлкен күш.
Dialogue: 0,0:05:21.48,0:05:22.55,Default,,0,0,0,,Оның өз ниеті бар шығар.
Dialogue: 0,0:05:22.65,0:05:23.52,Default,,0,0,0,,Бізге?
Dialogue: 0,0:05:23.62,0:05:24.52,Default,,0,0,0,,Мен осындамын, мама
Dialogue: 0,0:05:24.62,0:05:25.59,Default,,0,0,0,,Қуану керек пе, қайғыру керек пе?
Dialogue: 0,0:05:25.59,0:05:27.32,Default,,0,0,0,,Қуану керек пе, қайғыру керек пе?
Dialogue: 0,0:05:25.59,0:05:27.32,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:05:27.32,0:05:27.42,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:05:27.42,0:05:29.42,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:05:27.42,0:05:29.42,Default,,0,0,0,,Бұл әзілден басқа ештеңе болмас еді.
Dialogue: 0,0:05:29.52,0:05:30.39,Default,,0,0,0,,Қарсылас
Dialogue: 0,0:05:30.66,0:05:32.73,Default,,0,0,0,,Әй, Лелуш! О...
Dialogue: 0,0:05:32.93,0:05:36.43,Default,,0,0,0,,Бұл Лелуш. Үн шыққаннан кейін хабарлама жіберіңіз.
Dialogue: 0,0:05:36.53,0:05:38.80,Default,,0,0,0,,Осындай уақытта не істеп жатырсың?
Dialogue: 0,0:05:39.47,0:05:41.97,Default,,0,0,0,,Мен білемін, бірақ...
Dialogue: 0,0:05:43.04,0:05:44.57,Default,,0,0,0,,Қонақ үйге апаратын көпір -
Dialogue: 0,0:05:44.67,0:05:47.34,Default,,0,0,0,,Негізгіден басқасының барлығы алынып тасталды.
Dialogue: 0,0:05:47.44,0:05:50.71,Default,,0,0,0,,Әуе және су астындағы жақындау сәтсіз аяқталды.
Dialogue: 0,0:05:51.11,0:05:55.45,Default,,0,0,0,,Кепілге алынғандарды құтқару операциясына бір ғана жол қалды.
Dialogue: 0,0:05:55.55,0:05:56.58,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:56.68,0:05:58.85,Default,,0,0,0,,Конгрес орталығы Қонақ үйдің дәл астында орналасқан.
Dialogue: 0,0:05:58.95,0:06:02.56,Default,,0,0,0,,Құтқару желісі туннелі Егер сіз мұны пайдалансаңыз, ол жоспарға сәйкес жүреді.
Dialogue: 0,0:06:02.66,0:06:06.09,Default,,0,0,0,,Сіз іргетас блоктарын бұзу арқылы қонақүйді суға батыра аласыз.
Dialogue: 0,0:06:06.63,0:06:09.40,Default,,0,0,0,,Бұл туннель сонымен қатар қорларды тасымалдау үшін көлік қызметін атқарады.
Dialogue: 0,0:06:09.50,0:06:11.60,Default,,0,0,0,,Сазерлендке кіруге болады.
Dialogue: 0,0:06:11.70,0:06:14.50,Default,,0,0,0,,Жау дайын болуы керек, бірақ проблема жоқ.
Dialogue: 0,0:06:16.60,0:06:17.47,Default,,0,0,0,,Жүр!
Dialogue: 0,0:06:17.64,0:06:21.44,Default,,0,0,0,,Қарсыластың осы уақытқа дейін пайдаланған қаруының деңгейімен ол толығымен қашып құтылады.
Dialogue: 0,0:06:22.11,0:06:22.98,Default,,0,0,0,,Қарсыластың көлеңкесін түсіру
Dialogue: 0,0:06:23.54,0:06:25.68,Default,,0,0,0,,Болжағандай ол жерасты туннелі арқылы қозғалады.
Dialogue: 0,0:06:25.78,0:06:27.78,Default,,0,0,0,,Түсінікті! Найзағай 2-ші белсендіру
Dialogue: 0,0:06:27.88,0:06:29.42,Default,,0,0,0,,Бекітілген сол және оң төрт аяқты -
Dialogue: 0,0:06:29.78,0:06:32.59,Default,,0,0,0,,Супер электромагниттік шолақ мылтық ауыр артиллериялық кернеуді тексеру
Dialogue: 0,0:06:36.16,0:06:38.16,Default,,0,0,0,,Қауіпсіздікке қарсы Бұл мылтық сияқты.
Dialogue: 0,0:06:38.46,0:06:39.96,Default,,0,0,0,,Жайылып жатқанда бұзыңыз
Dialogue: 0,0:06:40.39,0:06:42.06,Default,,0,0,0,,Өте электромагниттік шолақ мылтық ауыр артиллерия
Dialogue: 0,0:06:42.73,0:06:43.80,Default,,0,0,0,,Өрт!
Dialogue: 0,0:06:45.90,0:06:47.00,Default,,0,0,0,,Не?
Dialogue: 0,0:06:49.90,0:06:51.64,Default,,0,0,0,,Иә! (Мүше) Бір соққы!
Dialogue: 0,0:06:51.74,0:06:53.61,Default,,0,0,0,,Найзағай қолдануға болады!
Dialogue: 0,0:06:53.71,0:06:55.78,Default,,0,0,0,,Британияның шошқаларын көрдіңіз бе?
Dialogue: 0,0:06:55.98,0:06:56.84,Default,,0,0,0,,Толығымен жойылды ма?
Dialogue: 0,0:06:57.18,0:06:58.85,Default,,0,0,0,,Жау Глазгоды қайта құрды —
Dialogue: 0,0:06:58.95,0:07:00.92,Default,,0,0,0,,Сызықтық канон орнатылған сияқты.
Dialogue: 0,0:07:01.02,0:07:03.55,Default,,0,0,0,,Бұл бұзып өту мүмкін емес дегенді білдіре ме?
Dialogue: 0,0:07:03.65,0:07:05.95,Default,,0,0,0,,Сіз не істейсіз? Саяси тұтқындарды босату талабы бойынша...
Dialogue: 0,0:07:06.05,0:07:08.16,Default,,0,0,0,,Террористерге өз әлсіздігіңізді көрсетпеңіз!
Dialogue: 0,0:07:08.46,0:07:10.59,Default,,0,0,0,,Дегенмен, Эфемия-сама
Dialogue: 0,0:07:11.06,0:07:11.93,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:07:12.03,0:07:14.83,Default,,0,0,0,,Мәселе әлі байқалмаған болуы керек.
Dialogue: 0,0:07:15.56,0:07:18.50,Default,,0,0,0,,Евфемия-саманың кепілге алынғандар арасында екенін білсек...
Dialogue: 0,0:07:18.60,0:07:20.97,Default,,0,0,0,,Мен олар оны келіссөздерде қолданатынына сенімдімін...
Dialogue: 0,0:07:21.07,0:07:23.04,Default,,0,0,0,,Мен тек жиналысқа қатыстым...
Dialogue: 0,0:07:23.14,0:07:25.61,Default,,0,0,0,,Ол тіпті мүшелер тізімінде де жоқ.
Dialogue: 0,0:07:28.74,0:07:30.18,Default,,0,0,0,,Уау
Dialogue: 0,0:07:30.48,0:07:32.55,Default,,0,0,0,,О, мен білемін
Dialogue: 0,0:07:32.65,0:07:34.45,Default,,0,0,0,,Мен бұл жолы жақсырақ істеймін
Dialogue: 0,0:07:34.55,0:07:37.02,Default,,0,0,0,,Бірақ мен сенің қамқоршың емеспін.
Dialogue: 0,0:07:38.92,0:07:42.86,Default,,0,0,0,,Біздің тілшілер құтқару операциясына қатыса алмайды ма?
Dialogue: 0,0:07:42.96,0:07:44.63,Default,,0,0,0,,Мен өтініш бердім, бірақ...
Dialogue: 0,0:07:44.73,0:07:47.73,Default,,0,0,0,,Біздің командалар тізбегі әртүрлі және тұрақты емес.
Dialogue: 0,0:07:47.83,0:07:48.93,Default,,0,0,0,,Және...
Dialogue: 0,0:07:50.47,0:07:53.17,Default,,0,0,0,,Операцияны он бірге қалдыра алмаймыз.
Dialogue: 0,0:07:53.70,0:07:54.77,Default,,0,0,0,,Мәртебелі Корнелия
Dialogue: 0,0:07:54.87,0:07:58.51,Default,,0,0,0,,Мен британдықтар мен сандарды анық ажырата алатын адам емеспін.
Dialogue: 0,0:07:58.71,0:08:01.61,Default,,0,0,0,,Қабылдау әлі жеткіліксіз.
Dialogue: 0,0:08:01.71,0:08:02.68,Default,,0,0,0,,Бірақ содан кейін
Dialogue: 0,0:08:02.78,0:08:05.75,Default,,0,0,0,,Құрметті Британдық жүйе не үшін қажет?
Dialogue: 0,0:08:05.85,0:08:07.11,Default,,0,0,0,,Ширли әке...
Dialogue: 0,0:08:07.22,0:08:08.22,Default,,0,0,0,,Мұны қайда қою керек?
Dialogue: 0,0:08:08.52,0:08:10.08,Default,,0,0,0,,Ана жақта жүргізуші орнында
Dialogue: 0,0:08:10.18,0:08:12.09,Default,,0,0,0,,Эй, мен осында қалдырған қорап ше?
Dialogue: 0,0:08:12.19,0:08:13.75,Default,,0,0,0,,Бұл жай ғана көрікті жерлерді аралау.
Dialogue: 0,0:08:14.72,0:08:17.99,Default,,0,0,0,,Мен әлі студент болсам да, лаңкестер маған еріксіз шабуыл жасайды...
Dialogue: 0,0:08:18.09,0:08:18.96,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:08:19.23,0:08:21.83,Default,,0,0,0,,Ширли... Менің қызым жақсы ма? ―
Dialogue: 0,0:08:22.70,0:08:25.23,Default,,0,0,0,,Ол бала ешнәрсе істемесе де...
Dialogue: 0,0:08:25.63,0:08:28.67,Default,,0,0,0,,Британиямен күресу үшін ұйым қажет.
Dialogue: 0,0:08:28.77,0:08:30.71,Default,,0,0,0,,Бірақ әлі ерте...
Dialogue: 0,0:08:30.91,0:08:33.14,Default,,0,0,0,,Бірақ мен оны осылай қалдыра алмаймын...
Dialogue: 0,0:08:33.24,0:08:36.14,Default,,0,0,0,,Егер бұл Корнелияның жеке басы болса, кепілге алынғандарды елемеңіз...
Dialogue: 0,0:08:36.24,0:08:40.15,Default,,0,0,0,,А, онда неге ол жұмыс істемейді? Амал жоқ...
Dialogue: 0,0:08:40.25,0:08:41.12,Default,,0,0,0,,Нөл (Лелух) Ах
Dialogue: 0,0:08:41.72,0:08:43.65,Default,,0,0,0,,Кепілге алынғандар не болады?
Dialogue: 0,0:08:44.95,0:08:46.15,Default,,0,0,0,,Алайда, жапондар әлі де примитивті өмір салтын кешіп жүрген кезде—
Dialogue: 0,0:08:46.25,0:08:48.76,Default,,0,0,0,,Британдықтарды тірі қалдыруға ешқандай себеп жоқ.
Dialogue: 0,0:08:49.02,0:08:51.53,Default,,0,0,0,,Иә... бұл дұрыс.
Dialogue: 0,0:08:51.63,0:08:52.76,Default,,0,0,0,,Сәлем Нөл
Dialogue: 0,0:08:52.86,0:08:54.66,Default,,0,0,0,,Мен мұны барлығына бере аламын ба?
Dialogue: 0,0:08:55.73,0:08:58.17,Default,,0,0,0,,Менің ойымша, бұл тамаша.
Dialogue: 0,0:08:58.27,0:08:59.87,Default,,0,0,0,,Біз қарсыласпыз...
Dialogue: 0,0:08:59.97,0:09:01.60,Default,,0,0,0,,Жоқ (желдеткіш) Ах.
Dialogue: 0,0:09:01.70,0:09:03.84,Default,,0,0,0,,Біз қарсылық емеспіз
Dialogue: 0,0:09:03.94,0:09:04.97,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:09:05.24,0:09:08.64,Default,,0,0,0,,Біздің мақсатымыз ...
Dialogue: 0,0:09:08.74,0:09:10.65,Default,,0,0,0,,Мен әділдіктің одақтасымын.
Dialogue: 0,0:09:10.75,0:09:13.65,Default,,0,0,0,,Арнайы снайперлік взводқа жету Ағымдағы жағдай сақталады-
Dialogue: 0,0:09:13.75,0:09:15.28,Default,,0,0,0,,Әрбір взвод командирі хабарламаны тексеруі керек.
Dialogue: 0,0:09:15.58,0:09:18.92,Default,,0,0,0,,Кепілге алынған студенттер студенттік кеңестің мүшелері ме? ―
Dialogue: 0,0:09:19.02,0:09:21.12,Default,,0,0,0,,Келіссөздер әлі жалғасуда...
Dialogue: 0,0:09:21.22,0:09:22.82,Default,,0,0,0,,Мен ұйымшылмын.
Dialogue: 0,0:09:23.32,0:09:26.29,Default,,0,0,0,,Ұйымдық логикаға жеке сезімдерден басымдық беріңіз
Dialogue: 0,0:09:26.86,0:09:28.26,Default,,0,0,0,,Ах... а-
Dialogue: 0,0:09:28.56,0:09:29.56,Default,,0,0,0,,Сесил мырза
Dialogue: 0,0:09:29.66,0:09:31.13,Default,,0,0,0,,(Косей) Аа, дұрыс. Шыны мен ауыстыратын киім—
Dialogue: 0,0:09:31.23,0:09:32.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:32.20,0:09:34.07,Default,,0,0,0,,Барымтаға алмаңыз...
Dialogue: 0,0:09:34.94,0:09:36.20,Default,,0,0,0,,Тоқта...
Dialogue: 0,0:09:36.67,0:09:39.27,Default,,0,0,0,,... Тоқта!
Dialogue: 0,0:09:41.01,0:09:44.98,Default,,0,0,0,,Біздің сұрауымызға жауап берілмесе.
Dialogue: 0,0:09:45.08,0:09:47.75,Default,,0,0,0,,Әр 30 минут сайын бір адам ұшсын
Dialogue: 0,0:09:47.85,0:09:50.89,Default,,0,0,0,,Біз кепілге алынғандар үшін шынайы жауап күтеміз.
Dialogue: 0,0:09:51.15,0:09:53.29,Default,,0,0,0,,Мысал қандай... Сіз варварсыз ба?
Dialogue: 0,0:09:53.59,0:09:54.62,Default,,0,0,0,,Келісуге болады -
Dialogue: 0,0:09:54.72,0:09:56.69,Default,,0,0,0,,Неге алдымен әйелдер мен балаларды босатуға болмайды?
Dialogue: 0,0:09:56.79,0:09:57.79,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:09:57.89,0:09:59.63,Default,,0,0,0,,Егер сіз келіссөздерді бір рет болса да қабылдасаңыз
Dialogue: 0,0:09:59.73,0:10:01.66,Default,,0,0,0,,Бұл терроризм әдісін растайтын еді.
Dialogue: 0,0:10:01.90,0:10:03.36,Default,,0,0,0,,Сонымен күшті шабуыл стратегиясы туралы не деуге болады?
Dialogue: 0,0:10:03.66,0:10:05.27,Default,,0,0,0,,Бұл Эфемияның қауіпсіздігі туралы.
Dialogue: 0,0:10:05.37,0:10:07.30,Default,,0,0,0,,Қамтамасыз етілгеннен кейін солай болған жоқ па?
Dialogue: 0,0:10:07.60,0:10:11.07,Default,,0,0,0,,Уф Юффи мен...
Dialogue: 0,0:10:11.94,0:10:13.07,Default,,0,0,0,,Губернатор Нөл
Dialogue: 0,0:10:13.17,0:10:15.71,Default,,0,0,0,,Уф (бағыныңқы) Маған нөлден қоңырау түсті.
Dialogue: 0,0:10:15.81,0:10:19.11,Default,,0,0,0,,Не?№3 көлікті нөл ұрлады ма?
Dialogue: 0,0:10:19.21,0:10:20.98,Default,,0,0,0,,Гибсон не істеп жүрді?
Dialogue: 0,0:10:21.08,0:10:23.72,Default,,0,0,0,,Мен бір нәрсені байқасам, ол алынды.
Dialogue: 0,0:10:23.82,0:10:26.29,Default,,0,0,0,,Иә?Ал үшінші көлік ше?
Dialogue: 0,0:10:26.39,0:10:27.86,Default,,0,0,0,,Әскердің ортасына
Dialogue: 0,0:10:27.96,0:10:28.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:30.79,0:10:33.16,Default,,0,0,0,,Расталды, бұл нөл. Снайп алғыңыз келе ме?
Dialogue: 0,0:10:33.26,0:10:36.83,Default,,0,0,0,,Осы күйде күтіңіз және қоршау аяқталғаннан кейін қамауға алыңыз.
Dialogue: 0,0:10:37.00,0:10:40.94,Default,,0,0,0,,Әй, ол әділдік деп нені меңзеп тұр?
Dialogue: 0,0:10:41.04,0:10:44.71,Default,,0,0,0,,Келіңіздер, бірақ оған дейін өлтірілуі мүмкін...
Dialogue: 0,0:10:44.81,0:10:47.01,Default,,0,0,0,,Менің артымдағылардың да қашатын жері жоқ.
Dialogue: 0,0:10:47.41,0:10:49.78,Default,,0,0,0,,Неліктен бұл тіркемені қолданбайсыз?
Dialogue: 0,0:10:49.88,0:10:52.11,Default,,0,0,0,,Мен жасырынған жерімді көпшілікке көрсетсем, не істеуім керек?
Dialogue: 0,0:10:52.21,0:10:53.15,Default,,0,0,0,,О
Dialogue: 0,0:10:53.25,0:10:56.15,Default,,0,0,0,,Саған шынымен сене аламын ба? Нөл деген жігіт
Dialogue: 0,0:10:56.25,0:10:58.35,Default,,0,0,0,,Сондықтан мен күдікті дедім...
Dialogue: 0,0:10:58.65,0:11:01.02,Default,,0,0,0,,Егер бұл шынымен де болса, мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:11:06.39,0:11:07.83,Default,,0,0,0,,Корнелия
Dialogue: 0,0:11:07.93,0:11:09.96,Default,,0,0,0,,Мен осы жерде қарызымды өтегім келеді...
Dialogue: 0,0:11:10.06,0:11:12.40,Default,,0,0,0,,Сіздің пайдалануыңыз алда.
Dialogue: 0,0:11:12.70,0:11:15.17,Default,,0,0,0,,Егер мен оны дұрыс оқысам, Geass қолданбасын пайдаланудың қажеті жоқ.
Dialogue: 0,0:11:16.80,0:11:18.11,Default,,0,0,0,,Қайта танысқаныма қуаныштымын, Нөл.
Dialogue: 0,0:11:18.84,0:11:22.04,Default,,0,0,0,,Жапон азаттық майданының мүшесі болдыңыз ба? ―
Dialogue: 0,0:11:22.14,0:11:24.01,Default,,0,0,0,,Немесе сіз ынтымақтасу ниетіңіз бар ма? ―
Dialogue: 0,0:11:24.11,0:11:27.42,Default,,0,0,0,,Бірақ әзірше мен өзімнің ыңғайлылығыма басымдық беремін.
Dialogue: 0,0:11:27.72,0:11:29.88,Default,,0,0,0,,Қайын інісі Хловистің жауы
Dialogue: 0,0:11:29.98,0:11:32.02,Default,,0,0,0,,Сені осы жерде өлтіруге рұқсат ет
Dialogue: 0,0:11:32.35,0:11:33.32,Default,,0,0,0,,Корнелия
Dialogue: 0,0:11:33.42,0:11:35.22,Default,,0,0,0,,Сіз қайсысын таңдар едіңіз? (Корнелия) А?
Dialogue: 0,0:11:35.32,0:11:37.93,Default,,0,0,0,,Өлі Хловис және тірі Эфемия
Dialogue: 0,0:11:38.03,0:11:38.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:39.23,0:11:43.43,Default,,0,0,0,,Жарайды, солай деп ойлаймын. Бірінші шарт жойылды.
Dialogue: 0,0:11:43.73,0:11:45.83,Default,,0,0,0,,Әдеттегідей, Корнелия.
Dialogue: 0,0:11:46.10,0:11:50.81,Default,,0,0,0,,Сіз Евфемияға көптен бері қызыққансыз, сондықтан қозғала алмайсыз...
Dialogue: 0,0:11:50.91,0:11:53.07,Default,,0,0,0,,Махаббаттың құйрығы жолға түседі
Dialogue: 0,0:11:53.17,0:11:54.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:54.34,0:11:56.14,Default,,0,0,0,,Евфемияны құтқарайық.
Dialogue: 0,0:11:56.24,0:11:57.45,Default,,0,0,0,,Мен (Корнелия) О...
Dialogue: 0,0:11:58.35,0:12:01.98,Default,,0,0,0,,Нөл Не айтып тұрғаныңызды білмеймін.
Dialogue: 0,0:12:02.08,0:12:04.15,Default,,0,0,0,,Мен сені құтқарамын!Мен үшін!
Dialogue: 0,0:12:04.25,0:12:05.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.32,0:12:06.19,Default,,0,0,0,,Егер ол нөл болса ше?
Dialogue: 0,0:12:06.29,0:12:08.72,Default,,0,0,0,,Иә, менімен британдық әскерилер хабарласты.
Dialogue: 0,0:12:08.82,0:12:10.99,Default,,0,0,0,,Барлық әскерлерге жетіңіз, нөлден өтіңіз.
Dialogue: 0,0:12:11.09,0:12:13.09,Default,,0,0,0,,Қайталау өту нөлі
Dialogue: 0,0:12:20.43,0:12:24.34,Default,,0,0,0,,Жапонияны азат ету майданы мені жолдас ретінде қабылдай ма?
Dialogue: 0,0:12:24.44,0:12:26.97,Default,,0,0,0,,Әлде мен сені мазалаймын ба?
Dialogue: 0,0:12:27.74,0:12:30.85,Default,,0,0,0,,Кез келген жағдайда, Нөлді қарсы алу азғыруы
Dialogue: 0,0:12:30.95,0:12:35.25,Default,,0,0,0,,Жүрегіңіздің бұл қозғалысын жеңу мүмкін емес...
Dialogue: 0,0:12:37.22,0:12:41.79,Default,,0,0,0,,Жарайды, стратегияның барлық алғышарттары тазартылды.
Dialogue: 0,0:12:42.32,0:12:44.06,Default,,0,0,0,,Сіз не істегіңіз келеді? губернатор
Dialogue: 0,0:12:44.16,0:12:45.79,Default,,0,0,0,,Нөлге қарай -
Dialogue: 0,0:12:45.89,0:12:49.20,Default,,0,0,0,,Кепілге алынған адамды өлтіруден бұрын біраз бос уақыт болуы керек.
Dialogue: 0,0:12:49.30,0:12:53.80,Default,,0,0,0,,Онда бұл жақсы мүмкіндік! Ол сондай-ақ барлық нөлдерді бірге соғады.
Dialogue: 0,0:12:53.90,0:12:54.84,Default,,0,0,0,,Иә
Dialogue: 0,0:12:54.94,0:12:57.51,Default,,0,0,0,,Мені ұсынғаныңызға рахмет... Хахаха...
Dialogue: 0,0:12:57.81,0:13:00.51,Default,,0,0,0,,Сіз Ланселотты алып шығуға болатынын айттыңыз, иә?
Dialogue: 0,0:13:00.81,0:13:02.34,Default,,0,0,0,,Туннель ішінде сызықтық канонға қарай -
Dialogue: 0,0:13:02.44,0:13:03.81,Default,,0,0,0,,Оны жай ғана итеріңіз.
Dialogue: 0,0:13:03.91,0:13:04.78,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:13:04.88,0:13:07.45,Default,,0,0,0,,Бұл саңылау жасау үшін бізді жем ретінде пайдаланып жатқаныңызды білдіре ме?
Dialogue: 0,0:13:07.55,0:13:11.39,Default,,0,0,0,,Хм, SS шатасу мен шабуылды пайдаланатын сияқты.
Dialogue: 0,0:13:11.49,0:13:12.52,Default,,0,0,0,,Менің қалағаным осы...
Dialogue: 0,0:13:12.82,0:13:14.09,Default,,0,0,0,,Сесил-сан, а?
Dialogue: 0,0:13:14.39,0:13:16.42,Default,,0,0,0,,Мен мұны істеймін! Маған орындауға рұқсат етіңіз! ―
Dialogue: 0,0:13:17.02,0:13:18.83,Default,,0,0,0,,Оның барлығына көмектесу мүмкіндігі бар...
Dialogue: 0,0:13:18.99,0:13:21.23,Default,,0,0,0,,Егер Ланселот екеумізге қазір керек болса...
Dialogue: 0,0:13:21.33,0:13:22.36,Default,,0,0,0,,Сізге керек-
Dialogue: 0,0:13:22.46,0:13:25.13,Default,,0,0,0,,Алаяқ болса да
Dialogue: 0,0:13:36.91,0:13:39.85,Default,,0,0,0,,Ордер Куруруги Мен операцияның жоспарын түсіндіремін.
Dialogue: 0,0:13:39.95,0:13:42.98,Default,,0,0,0,,Prime Search мәліметтері бойынша кепілге алынғандар қонақүйдің орта қабатында болған.
Dialogue: 0,0:13:43.08,0:13:45.59,Default,,0,0,0,,Ол азық-түлік қоймасында қамалған сияқты.
Dialogue: 0,0:13:45.89,0:13:48.19,Default,,0,0,0,,Жетекші қару Z-01 (G Zero One) Ланселот -
Dialogue: 0,0:13:48.29,0:13:51.53,Default,,0,0,0,,Қонақ үйдің жертөлесіне өту үшін құтқару құбырының туннелін пайдаланыңыз.
Dialogue: 0,0:13:51.83,0:13:55.46,Default,,0,0,0,,Сайтқа келгеннен кейін іргетас блоктарын бұзып, қонақүйді суға батырыңыз.
Dialogue: 0,0:13:55.56,0:13:58.87,Default,,0,0,0,,Кепілге алынғандар тұрған жер 8 минутқа созылады деп есептелінеді.
Dialogue: 0,0:13:58.97,0:14:02.50,Default,,0,0,0,,Террористерді құтқару және тазарту үшін жеке бөлімше жауапты болады.
Dialogue: 0,0:14:02.97,0:14:05.14,Default,,0,0,0,,Іргетасты жою үшін Валисті пайдаланыңыз.
Dialogue: 0,0:14:05.24,0:14:07.14,Default,,0,0,0,,Соққы рельсі материалға қарсы.
Dialogue: 0,0:14:07.24,0:14:08.84,Default,,0,0,0,,3-деңгейге орнату (үш)
Dialogue: 0,0:14:09.01,0:14:11.25,Default,,0,0,0,,Мәселе туннель ішінде күтіп тұр.
Dialogue: 0,0:14:11.35,0:14:13.01,Default,,0,0,0,,Бұл сызықтық канон, солай ма?
Dialogue: 0,0:14:13.11,0:14:17.85,Default,,0,0,0,,47.8％
Dialogue: 0,0:14:18.12,0:14:19.39,Default,,0,0,0,,Сіз мұны шынымен жасайсыз ба?
Dialogue: 0,0:14:19.49,0:14:22.52,Default,,0,0,0,,Иә, қолайлы жерге оралыңыз.
Dialogue: 0,0:14:22.62,0:14:25.13,Default,,0,0,0,,Мен Ланселотты жоя алмаймын.
Dialogue: 0,0:14:25.33,0:14:26.43,Default,,0,0,0,,Сәйкес орын?
Dialogue: 0,0:14:26.53,0:14:27.46,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:29.06,0:14:30.00,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:30.63,0:14:31.57,Default,,0,0,0,,Сузаку-кун
Dialogue: 0,0:14:31.87,0:14:35.14,Default,,0,0,0,,Келесі жексенбіде мен төраға мен Нинамен бірге Кавагучи көліне барамын.
Dialogue: 0,0:14:35.24,0:14:36.10,Default,,0,0,0,,Менімен бірге барғың келе ме?
Dialogue: 0,0:14:36.20,0:14:38.97,Default,,0,0,0,,Кешіріңіз, сол күні менің жұмысым бар.
Dialogue: 0,0:14:39.07,0:14:42.18,Default,,0,0,0,,А, түсіндім. Сонда оған көмектесу мүмкін емес.
Dialogue: 0,0:14:42.38,0:14:47.88,Default,,0,0,0,,Бірақ рахмет, мені шақырғаныңызға өте қуаныштымын.
Dialogue: 0,0:14:48.28,0:14:51.99,Default,,0,0,0,,Операцияның басталуына 12 минут қалды, кері санақ басталады.
Dialogue: 0,0:14:52.09,0:14:54.32,Default,,0,0,0,,Ааа... а...
Dialogue: 0,0:14:54.42,0:14:55.62,Default,,0,0,0,,Он бір
Dialogue: 0,0:14:55.92,0:14:58.16,Default,,0,0,0,,Әй, сен не айттың? (Нина) Уф
Dialogue: 0,0:14:58.39,0:15:00.90,Default,,0,0,0,,Eleven туралы не деуге болады?біз жапонбыз
Dialogue: 0,0:15:01.00,0:15:03.16,Default,,0,0,0,,Мен білемін, сондықтан тоқтатыңыз!
Dialogue: 0,0:15:03.26,0:15:05.50,Default,,0,0,0,,Түзетіңіз!біз он бір емеспіз
Dialogue: 0,0:15:05.60,0:15:07.20,Default,,0,0,0,,Мен оны түзетемін.
Dialogue: 0,0:15:07.30,0:15:09.14,Default,,0,0,0,,Мұны қалай айтасыз! ―
Dialogue: 0,0:15:09.24,0:15:12.41,Default,,0,0,0,,Балалар, көрші үйге келіңдер! Мен саған мұқият үйретемін!
Dialogue: 0,0:15:12.51,0:15:14.64,Default,,0,0,0,,Жоқ! О, жоқ!
Dialogue: 0,0:15:14.94,0:15:15.91,Default,,0,0,0,,Ах
Dialogue: 0,0:15:16.01,0:15:16.94,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:17.38,0:15:18.65,Default,,0,0,0,,Тұр!
Dialogue: 0,0:15:18.95,0:15:21.45,Default,,0,0,0,,Жоқ...жоқ! О, жоқ!
Dialogue: 0,0:15:21.55,0:15:23.22,Default,,0,0,0,,Хмм, тоқтатыңыз.
Dialogue: 0,0:15:23.32,0:15:24.25,Default,,0,0,0,,Не? Сіз
Dialogue: 0,0:15:24.35,0:15:25.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:25.95,0:15:28.19,Default,,0,0,0,,Мен сіздің көшбасшыңызды қарсы алуға рұқсат етіңіз
Dialogue: 0,0:15:28.29,0:15:29.12,Default,,0,0,0,,Не?
Dialogue: 0,0:15:29.22,0:15:30.52,Default,,0,0,0,,Жоқ, лейтенант губернатор.
Dialogue: 0,0:15:30.93,0:15:35.36,Default,,0,0,0,,Мен Евфемия ли Британиямын, Британияның үшінші ханшайымымын.
Dialogue: 0,0:15:35.46,0:15:36.30,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:38.13,0:15:40.40,Default,,0,0,0,,Амансың ба? Сіз жарақат алдыңыз ба?
Dialogue: 0,0:15:40.50,0:15:42.37,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:15:43.70,0:15:45.61,Default,,0,0,0,,Менімен күш біріктіруді жоспарлайсыз ба?
Dialogue: 0,0:15:46.11,0:15:48.51,Default,,0,0,0,,Олай болса мен саған өзімнің шынайы бетімді көрсетейін, Нөл.
Dialogue: 0,0:15:48.61,0:15:49.58,Default,,0,0,0,,Бұл дөрекі болар еді
Dialogue: 0,0:15:49.68,0:15:53.45,Default,,0,0,0,,Жарайды, бірақ бұған дейін мен сенен бірнәрсе сұрайын деп едім.
Dialogue: 0,0:15:53.55,0:15:56.65,Default,,0,0,0,,Осы әрекеттің соңында не іздейсіз?
Dialogue: 0,0:15:56.95,0:15:58.25,Default,,0,0,0,,Мен не білдім...
Dialogue: 0,0:15:58.35,0:16:01.69,Default,,0,0,0,,Жапон халқының әлі өлмегені ел ішінде де, шетелде де белгілі болсын.
Dialogue: 0,0:16:01.99,0:16:04.02,Default,,0,0,0,,Бұл ескі (Құсақабе) Хм.
Dialogue: 0,0:16:04.12,0:16:07.43,Default,,0,0,0,,Балалар, сендер қартайдыңдар, енді құтқарыла алмайсыңдар.
Dialogue: 0,0:16:07.53,0:16:09.50,Default,,0,0,0,,Жүр, сен!
Dialogue: 0,0:16:09.60,0:16:12.10,Default,,0,0,0,,Бұл нені білдіреді?нөл
Dialogue: 0,0:16:13.20,0:16:14.40,Default,,0,0,0,,ME Boost
Dialogue: 0,0:16:14.50,0:16:16.07,Default,,0,0,0,,Ланселот ұшады!
Dialogue: 0,0:16:18.67,0:16:20.71,Default,,0,0,0,,Реакцияны растау Enemy Nightmare 1
Dialogue: 0,0:16:21.01,0:16:22.44,Default,,0,0,0,,Қозғалыс жылдамдығы шамамен екі есе
Dialogue: 0,0:16:22.54,0:16:24.48,Default,,0,0,0,,Маған бәрібір, бәрі бірдей!
Dialogue: 0,0:16:24.58,0:16:26.65,Default,,0,0,0,,Өте электромагниттік шолақ мылтық ауыр артиллерия
Dialogue: 0,0:16:27.11,0:16:27.98,Default,,0,0,0,,Өрт!
Dialogue: 0,0:16:29.68,0:16:30.55,Default,,0,0,0,,Құт
Dialogue: 0,0:16:36.59,0:16:38.26,Default,,0,0,0,,Сондықтан мен айттым!
Dialogue: 0,0:16:38.36,0:16:41.10,Default,,0,0,0,,Иә, мен сізге жем бермеймін, мен оны аяқтаймын.
Dialogue: 0,0:16:45.30,0:16:46.20,Default,,0,0,0,,Подполковниктің қол астында
Dialogue: 0,0:16:46.30,0:16:49.24,Default,,0,0,0,,Мен жоғарыда айтқан кепілді алып кетті.
Dialogue: 0,0:16:49.34,0:16:51.07,Default,,0,0,0,,Оның аты Эфемия.
Dialogue: 0,0:16:51.17,0:16:55.14,Default,,0,0,0,,Хмм (Кусакабе) Нөл Енді сұрақтар мен жауаптар жоқ!
Dialogue: 0,0:16:55.24,0:16:56.51,Default,,0,0,0,,Өл
Dialogue: 0,0:16:58.38,0:16:59.25,Default,,0,0,0,,Өрт!
Dialogue: 0,0:17:03.75,0:17:05.39,Default,,0,0,0,,Га
Dialogue: 0,0:17:05.49,0:17:06.75,Default,,0,0,0,,Подполковник! Ах
Dialogue: 0,0:17:08.02,0:17:09.32,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:17:10.22,0:17:11.16,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:17:11.26,0:17:13.13,Default,,0,0,0,,Подполковниктер өз-өзіне қол жұмсады.
Dialogue: 0,0:17:13.73,0:17:16.06,Default,,0,0,0,,Мен өз әрекеттерімнің мағынасыздығын түсіндім.
Dialogue: 0,0:17:16.16,0:17:17.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:17.50,0:17:18.67,Default,,0,0,0,,Эфемия
Dialogue: 0,0:17:18.77,0:17:21.54,Default,,0,0,0,,Халық үшін барымта сатып алдың ба? ―
Dialogue: 0,0:17:21.64,0:17:23.27,Default,,0,0,0,,Әдеттегідей (Эфемия) Иә?
Dialogue: 0,0:17:23.54,0:17:25.64,Default,,0,0,0,,Не?Ерекше кошмар?
Dialogue: 0,0:17:25.74,0:17:28.48,Default,,0,0,0,,Иә, осылай жүре берсек, бәлкім бұзып алармыз.
Dialogue: 0,0:17:28.58,0:17:31.11,Default,,0,0,0,,Хмм. Мен үлкен үміт күтуім керек пе?
Dialogue: 0,0:17:33.18,0:17:35.48,Default,,0,0,0,,Жарайды, мен бұл жойқын күшке төтеп бере аламын.
Dialogue: 0,0:17:37.35,0:17:40.12,Default,,0,0,0,,5-ші ату да бұзылды. Мен сене алар емеспін.
Dialogue: 0,0:17:40.22,0:17:43.16,Default,,0,0,0,,Қорықпа! Төрт жақты мұнара да орналастырылған.
Dialogue: 0,0:17:43.52,0:17:46.19,Default,,0,0,0,,Бұл абсолютті қорғаныс сызығы!Мен оны өлгенше қорғаймын!
Dialogue: 0,0:17:46.29,0:17:48.50,Default,,0,0,0,,Эй Сесиль, мен Валисті осында пайдаланғалы жатырмын.
Dialogue: 0,0:17:48.60,0:17:50.83,Default,,0,0,0,,Иә?Күте тұрыңыз, бұл қауіпті.
Dialogue: 0,0:17:52.20,0:17:55.70,Default,,0,0,0,,Әрекет ету аймағы тарылды. Жарылысқа дайын болыңыз!
Dialogue: 0,0:18:00.74,0:18:01.81,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:02.71,0:18:04.21,Default,,0,0,0,,Балалар...
Dialogue: 0,0:18:05.25,0:18:08.15,Default,,0,0,0,,Мен сізді лейтенант губернатор етіп тағайындағаныңызды естідім.
Dialogue: 0,0:18:08.25,0:18:10.15,Default,,0,0,0,,Жоғары мәртебелі ханшайым Эфемия
Dialogue: 0,0:18:10.35,0:18:12.22,Default,,0,0,0,,Бұл қуану туралы емес.
Dialogue: 0,0:18:12.32,0:18:15.49,Default,,0,0,0,,Иә, өйткені Хловис қайтыс болды.
Dialogue: 0,0:18:15.59,0:18:16.86,Default,,0,0,0,,(Сувенир дүкенінің иесі) Хмм… (Турист 1) Ә?
Dialogue: 0,0:18:17.16,0:18:17.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:18.13,0:18:21.36,Default,,0,0,0,,Соңына дейін маған жалынып, жанын сұрады.
Dialogue: 0,0:18:21.46,0:18:24.33,Default,,0,0,0,,Он бірді өлтіруді бұйырған сол ауыз
Dialogue: 0,0:18:24.43,0:18:26.83,Default,,0,0,0,,Бауырыңды өлтірдің бе?
Dialogue: 0,0:18:27.13,0:18:28.44,Default,,0,0,0,,Жоқ (Эфемия) Неліктен?
Dialogue: 0,0:18:28.60,0:18:31.71,Default,,0,0,0,,Өйткені бұл адам Британ императорының ұлы.
Dialogue: 0,0:18:32.21,0:18:33.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:33.31,0:18:36.58,Default,,0,0,0,,Ойланып қарасам, сен де солай болғансың.
Dialogue: 0,0:18:37.54,0:18:40.48,Default,,0,0,0,,Толық шығу! Мылтық оқпанының зақымданғанына бәрібір.
Dialogue: 0,0:18:40.85,0:18:44.89,Default,,0,0,0,,Міндетті түрде өлгенше қорған!Шат!
Dialogue: 0,0:18:46.55,0:18:47.42,Default,,0,0,0,,Құт
Dialogue: 0,0:18:59.73,0:19:00.77,Default,,0,0,0,,Сол он бір...
Dialogue: 0,0:19:07.81,0:19:08.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:13.21,0:19:14.48,Default,,0,0,0,,Сіз оны аяқтадыңыз ба?
Dialogue: 0,0:19:14.58,0:19:15.82,Default,,0,0,0,,Гилдфорд! (Гильфорд) Ха!
Dialogue: 0,0:19:18.52,0:19:19.82,Default,,0,0,0,,Олай емес
Dialogue: 0,0:19:23.36,0:19:25.29,Default,,0,0,0,,Бұл сол кездегі ақ дулыға ма?
Dialogue: 0,0:19:27.26,0:19:27.93,Default,,0,0,0,,Ах
Dialogue: 0,0:19:29.60,0:19:30.73,Default,,0,0,0,,Юффи!
Dialogue: 0,0:19:31.53,0:19:32.87,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:19:33.33,0:19:34.80,Default,,0,0,0,,Жарайды, прапорщик Куруруги!
Dialogue: 0,0:19:38.81,0:19:40.57,Default,,0,0,0,,№3 камера туралы не деуге болады?
Dialogue: 0,0:19:40.67,0:19:41.84,Default,,0,0,0,,Сізді нөл алды...
Dialogue: 0,0:19:41.94,0:19:44.24,Default,,0,0,0,,Сондықтан мен реакцияны қалаймын!
Dialogue: 0,0:19:44.75,0:19:46.48,Default,,0,0,0,,Не болды? Нөл
Dialogue: 0,0:19:46.91,0:19:51.45,Default,,0,0,0,,Сол себепті емес пе? Ол пайдалануға арналған...
Dialogue: 0,0:19:58.93,0:20:00.59,Default,,0,0,0,,Сузаку-кун!
Dialogue: 0,0:20:00.69,0:20:02.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:07.57,0:20:09.50,Default,,0,0,0,,Мен сені құтқара алмадым.
Dialogue: 0,0:20:10.54,0:20:12.97,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:13.47,0:20:14.58,Default,,0,0,0,,(Киришима & Сейро) Хахаха… Шынымен бе? Шынымен бе? Бакуго!
Dialogue: 0,0:20:20.31,0:20:21.22,Default,,0,0,0,,келді
Dialogue: 0,0:20:21.32,0:20:22.75,Default,,0,0,0,,Не? Бұл не? ―
Dialogue: 0,0:20:22.85,0:20:23.92,Default,,0,0,0,,Нөл.
Dialogue: 0,0:20:24.22,0:20:25.59,Default,,0,0,0,,Британдықтар...
Dialogue: 0,0:20:25.75,0:20:27.42,Default,,0,0,0,,Қозғалмаңыз.
Dialogue: 0,0:20:27.52,0:20:31.33,Default,,0,0,0,,Қонақ үйдегі кепілге алынғандардың барлығы құтқарылды.
Dialogue: 0,0:20:31.66,0:20:34.43,Default,,0,0,0,,Оны сізге қайтарайық
Dialogue: 0,0:20:35.00,0:20:35.86,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:20:35.96,0:20:37.60,Default,,0,0,0,,Сізге жақсы
Dialogue: 0,0:20:37.83,0:20:39.73,Default,,0,0,0,,Көбінесе «Нүкенүре» деп аталады.
Dialogue: 0,0:20:39.93,0:20:43.87,Default,,0,0,0,,Егер мен сенімен аралассам, сені қайтадан барымтаға айналдыратын шығармын.
Dialogue: 0,0:20:46.94,0:20:48.44,Default,,0,0,0,,Адамдар! ―
Dialogue: 0,0:20:48.54,0:20:50.98,Default,,0,0,0,,Бізден қорқып, іздеңіз...
Dialogue: 0,0:20:51.28,0:20:53.68,Default,,0,0,0,,Біздің атымыз... Қара рыцарьлар!
Dialogue: 0,0:20:54.38,0:20:55.52,Default,,0,0,0,,Рыцарлар…
Dialogue: 0,0:20:55.62,0:20:59.29,Default,,0,0,0,,Террористтің өзін рыцарь деп атауы ирониялық.
Dialogue: 0,0:20:59.52,0:21:01.49,Default,,0,0,0,,Біз, Қара рыцарлар...
Dialogue: 0,0:21:01.59,0:21:04.42,Default,,0,0,0,,Қарусыздардың бәрімен доспын.
Dialogue: 0,0:21:04.69,0:21:08.30,Default,,0,0,0,,Сіз 11 жаста болсаңыз да, британдық болсаңыз да...
Dialogue: 0,0:21:08.70,0:21:10.46,Default,,0,0,0,,Жапон азаттық майданы -
Dialogue: 0,0:21:10.56,0:21:13.53,Default,,0,0,0,,Британдық бейбіт тұрғындарды қорқақтықпен кепілге алу.
Dialogue: 0,0:21:13.63,0:21:15.04,Default,,0,0,0,,Айуандықпен өлтірілді.
Dialogue: 0,0:21:15.67,0:21:19.57,Default,,0,0,0,,Бұл мағынасыз әрекет, сондықтан санкцияны қолдандық.
Dialogue: 0,0:21:19.84,0:21:20.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:20.81,0:21:23.44,Default,,0,0,0,,Әрине, біз оны осылай қалдыруымыз керек.
Dialogue: 0,0:21:23.54,0:21:26.41,Default,,0,0,0,,Жауапкершілік?Мен ол затты аламын
Dialogue: 0,0:21:26.68,0:21:29.05,Default,,0,0,0,,Бұл бұрынғы губернатор Кловиске де қатысты.
Dialogue: 0,0:21:29.35,0:21:31.95,Default,,0,0,0,,Қарусыз он бірлерді өлтіруге бұйрық берді.
Dialogue: 0,0:21:32.49,0:21:35.66,Default,,0,0,0,,Біз мұндай зұлымдықтарды елеусіз қалдыра алмаймыз.
Dialogue: 0,0:21:35.76,0:21:38.29,Default,,0,0,0,,Сол себепті біз санкциялар салдық.
Dialogue: 0,0:21:38.53,0:21:40.43,Default,,0,0,0,,Мен ұрысты жоққа шығармаймын.
Dialogue: 0,0:21:40.53,0:21:44.56,Default,,0,0,0,,Алайда күштінің әлсізді біржақты өлтіруі үшін...
Dialogue: 0,0:21:44.67,0:21:45.83,Default,,0,0,0,,Мен бұған ешқашан жол бермеймін.
Dialogue: 0,0:21:46.73,0:21:48.30,Default,,0,0,0,,Кім ата алады?
Dialogue: 0,0:21:48.40,0:21:50.30,Default,,0,0,0,,Тек атуға дайын болғандар.
Dialogue: 0,0:21:50.84,0:21:51.84,Default,,0,0,0,,Біз-
Dialogue: 0,0:21:51.94,0:21:56.54,Default,,0,0,0,,Ол күшті күшсізге шабуыл жасағанда қайта пайда болады.
Dialogue: 0,0:21:56.64,0:22:00.61,Default,,0,0,0,,Жау қаншалықты күшті болса да,
Dialogue: 0,0:22:00.71,0:22:03.85,Default,,0,0,0,,Әділдік одақтасы ма?
Dialogue: 0,0:22:04.79,0:22:08.06,Default,,0,0,0,,Менен қорқыңдар, құдіреттілер.
Dialogue: 0,0:22:08.89,0:22:11.73,Default,,0,0,0,,Мені ізде, әлгі күш-қуатсыз.
Dialogue: 0,0:22:12.43,0:22:17.53,Default,,0,0,0,,Біз, Қара рыцарьлар, әлемді соттаймыз!
Dialogue: 0,0:22:17.73,0:22:21.37,Default,,0,0,0,,♪～
Dialogue: 0,0:22:21.47,0:22:25.01,Default,,0,0,0,,♪Мен жүрмін, бірақ мен арыстан мен жолбарыстың арылдаған жолмен жүріп келемін
Dialogue: 0,0:22:25.11,0:22:28.88,Default,,0,0,0,,♪Қызыл аспанның арғы жағында, Махороба
Dialogue: 0,0:22:28.98,0:22:32.68,Default,,0,0,0,,♪Тұтқынның жалғыздығында қаңғыған жас
Dialogue: 0,0:22:32.78,0:22:36.52,Default,,0,0,0,,♪Әлсіздік пен ашу көзге көрінбейтін жау ма?
Dialogue: 0,0:22:36.62,0:22:41.99,Default,,0,0,0,,♪Әке, мен өзімді әлі білмеймін.
Dialogue: 0,0:22:44.02,0:22:48.06,Default,,0,0,0,,♪Алдыңғы ағалар
Dialogue: 0,0:22:48.36,0:22:51.77,Default,,0,0,0,,♪Көрінбейтін арқаңа ерсең
Dialogue: 0,0:22:51.87,0:22:58.84,Default,,0,0,0,,♪Таң жұлдызы сізді адасқан түнге шақырады
Dialogue: 0,0:22:59.51,0:23:02.94,Default,,0,0,0,,♪Өліммен бітпейді
Dialogue: 0,0:23:03.04,0:23:06.75,Default,,0,0,0,,♪Арманға ұмтылсам да
Dialogue: 0,0:23:06.85,0:23:10.58,Default,,0,0,0,,♪Сіз сенімді адамсыз
Dialogue: 0,0:23:10.68,0:23:14.55,Default,,0,0,0,,♪Менің өмірім
Dialogue: 0,0:23:14.65,0:23:18.46,Default,,0,0,0,,♪Қатты жел айдалада, Көбелектер мен гүлдермен өмір сүремін.
Dialogue: 0,0:23:18.56,0:23:22.13,Default,,0,0,0,,♪Мәңгілік көктемде гүлдеген дәмді елес
Dialogue: 0,0:23:22.43,0:23:25.97,Default,,0,0,0,,♪Бұл дененің лас болса да лайдың тазалығы
Dialogue: 0,0:23:26.07,0:23:29.84,Default,,0,0,0,,♪Жүрегіңіздің сырына сеніңіз
Dialogue: 0,0:23:29.94,0:23:35.54,Default,,0,0,0,,♪Анашым, көз жасымды көрсетпесем де.
Dialogue: 0,0:23:35.71,0:23:40.18,Default,,0,0,0,,♪Аяғымның астындағы шөпте
Dialogue: 0,0:23:40.48,0:23:45.82,Default,,0,0,0,,♪Шық ешқашан кетпейді
Dialogue: 0,0:23:48.99,0:23:51.56,Default,,0,0,0,,Tweeting: Аспан мен жағында болды.
Dialogue: 0,0:23:51.99,0:23:55.50,Default,,0,0,0,,Мен Корнелияның әлсіздігі тұтқын деп ешқашан ойламадым...
Dialogue: 0,0:23:55.60,0:23:57.50,Default,,0,0,0,,Эфемия деп аталатын әлсіздік – бұл...
Dialogue: 0,0:23:57.60,0:24:00.00,Default,,0,0,0,,Міне, қара рыцарьлар...
Dialogue: 0,0:24:00.10,0:24:01.17,Default,,0,0,0,,Бұл менің қарсы шабуылым.
Dialogue: 0,0:24:02.10,0:24:03.74,Default,,0,0,0,,Мені тұзаққа түсірген әлемде
Dialogue: 0,0:24:03.84,0:24:07.64,Default,,0,0,0,,Бұл менің жүрегімде қозғалмады
Dialogue: 0,0:24:09.14,0:24:15.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory