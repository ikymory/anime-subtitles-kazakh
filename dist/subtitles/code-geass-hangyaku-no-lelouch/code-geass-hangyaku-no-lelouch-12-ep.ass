Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.26,0:00:04.27,Default,,0,0,0,,Лелуч, Британдық бала...
Dialogue: 0,0:00:04.37,0:00:06.33,Default,,0,0,0,,Екі өкілеттігі бар.
Dialogue: 0,0:00:06.43,0:00:07.57,Default,,0,0,0,,Бірі – Геасс-
Dialogue: 0,0:00:08.30,0:00:11.71,Default,,0,0,0,,Кез келген қарсыласқа пәрмен беруге мүмкіндік беретін абсолютті бағыну күші.
Dialogue: 0,0:00:12.71,0:00:14.71,Default,,0,0,0,,Бірі - Қара рыцарьлар.
Dialogue: 0,0:00:15.14,0:00:19.51,Default,,0,0,0,,Әкесі басқарған Британ империясын жою үшін оның әскері.
Dialogue: 0,0:00:20.38,0:00:23.75,Default,,0,0,0,,Zero кодтық атауын пайдаланып, Лелуш қозғала бастайды.
Dialogue: 0,0:00:24.52,0:00:26.45,Default,,0,0,0,,Анамның жауынан кек алу үшін...
Dialogue: 0,0:00:26.55,0:00:30.49,Default,,0,0,0,,Менің сіңілім Нуналли бақытты өмір сүретін жер жасау үшін...
Dialogue: 0,0:00:31.73,0:00:35.53,Default,,0,0,0,,Бұл әрекет қандай нәтиже береді? ―
Dialogue: 0,0:00:35.73,0:00:38.37,Default,,0,0,0,,Әлі ешкім білмейді
Dialogue: 0,0:00:38.70,0:00:44.71,Default,,0,0,0,,♪～
Dialogue: 0,0:00:47.18,0:00:51.08,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:00:51.18,0:00:54.45,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:00:54.55,0:01:00.32,Default,,0,0,0,,♪Сәт әрқашан жаныңда...
Dialogue: 0,0:01:02.36,0:01:08.66,Default,,0,0,0,,♪ Тітіркенуді жасыра алмайды
Dialogue: 0,0:01:09.40,0:01:15.74,Default,,0,0,0,,♪ Бір орында тұрып өзіңе қара
Dialogue: 0,0:01:15.84,0:01:19.31,Default,,0,0,0,,♪ойланып отырып, уайымдап
Dialogue: 0,0:01:19.41,0:01:22.71,Default,,0,0,0,,♪Өкінішпен шешім қабылдау керек.
Dialogue: 0,0:01:22.81,0:01:26.38,Default,,0,0,0,,♪Сен маған берген бір сөз
Dialogue: 0,0:01:26.48,0:01:30.12,Default,,0,0,0,,♪Менің шатасуым жоғалады
Dialogue: 0,0:01:30.29,0:01:36.42,Default,,0,0,0,,♪Бос бөлмеме нұр түсті.
Dialogue: 0,0:01:36.69,0:01:39.69,Default,,0,0,0,,♪Мен қараған аспан
Dialogue: 0,0:01:39.79,0:01:43.83,Default,,0,0,0,,♪Ашық және көгілдір болып барады
Dialogue: 0,0:01:44.13,0:01:50.41,Default,,0,0,0,,♪Мен жабық терезені ашуды жөн көрдім.
Dialogue: 0,0:01:50.64,0:01:54.51,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:01:54.61,0:01:57.65,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:01:58.28,0:02:04.52,Default,,0,0,0,,♪Сәтті сезін, осында және қазір...
Dialogue: 0,0:02:14.13,0:02:15.36,Default,,0,0,0,,Губернатор операциясында -
Dialogue: 0,0:02:15.46,0:02:18.47,Default,,0,0,0,,Жапон азаттық майданы жойылып кете жаздады.
Dialogue: 0,0:02:18.57,0:02:21.60,Default,,0,0,0,,Қашып жүрген мүшелер бірінен соң бірі тұтқынға алынуда.
Dialogue: 0,0:02:21.70,0:02:23.37,Default,,0,0,0,,Бұл сарказм ба?
Dialogue: 0,0:02:23.47,0:02:25.61,Default,,0,0,0,,Біздің әскерді қалпына келтіру үшін қысым жасалуда.
Dialogue: 0,0:02:25.71,0:02:27.48,Default,,0,0,0,,А, жоқ, мен олай айтқым келген жоқ.
Dialogue: 0,0:02:27.81,0:02:29.48,Default,,0,0,0,,Бірінші кезекте оккупациядан кейінгі саясат... болды.
Dialogue: 0,0:02:29.58,0:02:31.18,Default,,0,0,0,,Мен қателестім бе? ―
Dialogue: 0,0:02:31.28,0:02:35.72,Default,,0,0,0,,Неліктен 11-аймақтағы метро жүйесі мен шахталық туннельдер қараусыз қалды? ―
Dialogue: 0,0:02:35.82,0:02:38.85,Default,,0,0,0,,Геттода отбасы тізілімін басқару және әртүрлі меншік құқықтары екіұшты болып қалады.
Dialogue: 0,0:02:39.49,0:02:42.19,Default,,0,0,0,,Үкіметке қарсы әрекеттің ошағы қараусыз қалды
Dialogue: 0,0:02:42.56,0:02:43.89,Default,,0,0,0,,Ал, метро
Dialogue: 0,0:02:44.19,0:02:46.73,Default,,0,0,0,,Елдің барлық жерінде дерлік таралған.
Dialogue: 0,0:02:46.83,0:02:49.63,Default,,0,0,0,,Бюджет концессияға жатпайтын бос орындарды толтыру үшін тым аз.
Dialogue: 0,0:02:49.73,0:02:50.77,Default,,0,0,0,,Террористік базалар...
Dialogue: 0,0:02:50.87,0:02:53.17,Default,,0,0,0,,Бұл қашу жолы болатынын білсеңіз де!
Dialogue: 0,0:02:53.27,0:02:54.74,Default,,0,0,0,,Ку... Жоғары мәртебелі Хловистің нұсқауымен.
Dialogue: 0,0:02:54.87,0:02:55.74,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:02:55.84,0:02:59.84,Default,,0,0,0,,Әй, қатты шықса азамат соғысы болады.
Dialogue: 0,0:02:59.94,0:03:02.71,Default,,0,0,0,,Қытай Федерациясына ашылуды берсеңіз
Dialogue: 0,0:03:02.81,0:03:07.42,Default,,0,0,0,,Берілген Нөлдің күші күшейіп келеді.
Dialogue: 0,0:03:07.52,0:03:08.68,Default,,0,0,0,,Тұрақты хатшы-
Dialogue: 0,0:03:08.78,0:03:12.19,Default,,0,0,0,,Осы аймақтың автономиясын басқаратын Ішкі істер министрлігінің бақылауында.
Dialogue: 0,0:03:12.29,0:03:16.36,Default,,0,0,0,,Он бір топтың өкілдері болды, бірақ ҰАК деп аталатын топтың өкілдері де болды.
Dialogue: 0,0:03:16.46,0:03:17.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:17.46,0:03:21.60,Default,,0,0,0,,Өткен күнгі операцияда мен ҰАК-ның құйрығынан ұстағым келді.
Dialogue: 0,0:03:21.70,0:03:25.97,Default,,0,0,0,,Материал құм астында, бірақ күшті күдік бар.
Dialogue: 0,0:03:26.27,0:03:27.64,Default,,0,0,0,,Алдымен осыны бассаңыз
Dialogue: 0,0:03:28.70,0:03:34.28,Default,,0,0,0,,Хмм. Бұл беделді отбасылар мен конгломераттардың жинағы өткеннің реликті ме?
Dialogue: 0,0:03:34.38,0:03:35.68,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:03:35.78,0:03:39.25,Default,,0,0,0,,Бұл жай қауесет, ешқандай дәлел жоқ.
Dialogue: 0,0:03:39.78,0:03:41.92,Default,,0,0,0,,Оларды бассақ, Он бірдің шаруашылығы өседі.
Dialogue: 0,0:03:42.22,0:03:43.48,Default,,0,0,0,,Жалғастыруға рұқсат етілмейді
Dialogue: 0,0:03:43.59,0:03:46.29,Default,,0,0,0,,Бұл өз еліндегі салық жинауға да әсер етеді.
Dialogue: 0,0:03:46.59,0:03:47.69,Default,,0,0,0,,Сандар...
Dialogue: 0,0:03:47.79,0:03:50.26,Default,,0,0,0,,Сандар өзі шешеді...
Dialogue: 0,0:03:50.36,0:03:51.86,Default,,0,0,0,,Империяның ұлы принциптері
Dialogue: 0,0:03:51.96,0:03:53.96,Default,,0,0,0,,Қара рыцарьлардың тергеуі туралы не деуге болады?
Dialogue: 0,0:03:54.26,0:03:56.00,Default,,0,0,0,,Хмм... Қалған қалқан машинасынан-
Dialogue: 0,0:03:56.30,0:03:57.00,Default,,0,0,0,,Наритаға қатысты...
Dialogue: 0,0:03:57.30,0:03:59.60,Default,,0,0,0,,Оны Нөл жасаған екен...
Dialogue: 0,0:03:59.70,0:04:02.54,Default,,0,0,0,,Топ мүшелерінің органдарынан басқа ақпарат жоқ.
Dialogue: 0,0:04:02.64,0:04:04.37,Default,,0,0,0,,Киотоға қол тигізбеңіз.
Dialogue: 0,0:04:04.47,0:04:06.57,Default,,0,0,0,,Нөлді бұрышқа бұру мүмкін емес.
Dialogue: 0,0:04:06.67,0:04:11.78,Default,,0,0,0,,Сіз білесіз бе? Нәтиже көрмеген адамдарды қабілетсіз деп атайды.
Dialogue: 0,0:04:12.38,0:04:15.45,Default,,0,0,0,,Британ ханшайымы ешқашан мұндай ұлы болған емес.
Dialogue: 0,0:04:15.55,0:04:20.56,Default,,0,0,0,,Азаттық майданы екіге бөлініп, жапон алауы сөнді.
Dialogue: 0,0:04:21.02,0:04:22.29,Default,,0,0,0,,Күте тұрыңыз! ―
Dialogue: 0,0:04:22.39,0:04:25.73,Default,,0,0,0,,Ол қашып жүрсе де, Тодо әлі тірі, жақсы.
Dialogue: 0,0:04:25.83,0:04:29.66,Default,,0,0,0,,Дегенмен Бурай Кайдың да адасып қалғанын естідім.
Dialogue: 0,0:04:29.76,0:04:31.30,Default,,0,0,0,,Енді үміт жоқ
Dialogue: 0,0:04:31.40,0:04:32.77,Default,,0,0,0,,) Иә, қаласаңыз.
Dialogue: 0,0:04:32.87,0:04:35.27,Default,,0,0,0,,О (Кирихара) Қара рыцарьлар?
Dialogue: 0,0:04:35.54,0:04:39.54,Default,,0,0,0,,Гурен 2 үшін де солай, бірақ Сузаку Куруругиді құтқару оқиғасынан бері...
Dialogue: 0,0:04:39.64,0:04:41.51,Default,,0,0,0,,Сіз нөлге құмарсыз.
Dialogue: 0,0:04:42.94,0:04:44.85,Default,,0,0,0,,Трафальгардың жеңіліске ұшырауына байланысты -
Dialogue: 0,0:04:44.95,0:04:47.78,Default,,0,0,0,,Елизавета III революциялық күшке айналады.
Dialogue: 0,0:04:47.88,0:04:50.05,Default,,0,0,0,,Эдинбург қоршауға алынды...
Dialogue: 0,0:04:50.55,0:04:52.05,Default,,0,0,0,,Әкесі
Dialogue: 0,0:04:52.35,0:04:56.62,Default,,0,0,0,,... отаршыл Американың күш-жігерінің арқасында қазір біз...
Dialogue: 0,0:05:00.36,0:05:01.53,Default,,0,0,0,,Умм...
Dialogue: 0,0:05:02.00,0:05:03.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:04.07,0:05:05.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:06.07,0:05:07.40,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:05:07.50,0:05:08.74,Default,,0,0,0,,Иә? ―
Dialogue: 0,0:05:09.37,0:05:13.57,Default,,0,0,0,,Не болды?Қиын бетпен іш қатып жатырсыз ба?Екінші күн?
Dialogue: 0,0:05:13.68,0:05:14.81,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:05:14.91,0:05:16.94,Default,,0,0,0,,Сонымен, Лелушты сағындың ба?
Dialogue: 0,0:05:17.05,0:05:18.05,Default,,0,0,0,,Ах
Dialogue: 0,0:05:18.95,0:05:22.95,Default,,0,0,0,,Айтайын дегенім, Карен де жоқ. Сондай-ақ...
Dialogue: 0,0:05:23.05,0:05:24.75,Default,,0,0,0,,Соншалықты алаңсыз.
Dialogue: 0,0:05:24.85,0:05:27.86,Default,,0,0,0,,Күні кеше дүние Нарита дүбіріне толы болса да...
Dialogue: 0,0:05:28.52,0:05:30.99,Default,,0,0,0,,Соған байланысты бүгін Созакудың да демалысы бар.
Dialogue: 0,0:05:31.09,0:05:32.66,Default,,0,0,0,,Мен білемін! ―
Dialogue: 0,0:05:32.76,0:05:35.83,Default,,0,0,0,,Бірақ менің Лулу мен Каренмен проблемаларым көп!
Dialogue: 0,0:05:35.93,0:05:40.07,Default,,0,0,0,,Уууу, бұл жақсы, Ширлиге бұл ұнайды.
Dialogue: 0,0:05:40.37,0:05:41.04,Default,,0,0,0,,Га
Dialogue: 0,0:05:41.34,0:05:42.67,Default,,0,0,0,,Шатаспаңыз!
Dialogue: 0,0:05:42.84,0:05:44.04,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:05:44.44,0:05:46.97,Default,,0,0,0,,Мен жай ғана айта алғым келеді.
Dialogue: 0,0:05:47.38,0:05:48.48,Default,,0,0,0,,«Мен сені сүйемін»
Dialogue: 0,0:05:48.68,0:05:51.75,Default,,0,0,0,,Бұл жақсы емес! Міне бітті!
Dialogue: 0,0:05:51.85,0:05:52.98,Default,,0,0,0,,Өйткені егер...
Dialogue: 0,0:05:53.08,0:05:54.98,Default,,0,0,0,,Қабылданбаған жағдайда не істеуім керек?
Dialogue: 0,0:05:55.45,0:05:58.02,Default,,0,0,0,,Мүмкін енді дос бола алмайтын шығармыз
Dialogue: 0,0:05:58.12,0:05:59.92,Default,,0,0,0,,сол әйелдің еркі еді, иә?
Dialogue: 0,0:06:00.02,0:06:03.76,Default,,0,0,0,,Мен онша күлген жоқпын...
Dialogue: 0,0:06:03.86,0:06:05.59,Default,,0,0,0,,Бұл өте ыңғайлы.
Dialogue: 0,0:06:05.69,0:06:08.83,Default,,0,0,0,,Енді, осы жерде, осы жерде, біз бармыз
Dialogue: 0,0:06:08.93,0:06:10.57,Default,,0,0,0,,Шынында да солай емес пе?
Dialogue: 0,0:06:10.67,0:06:13.10,Default,,0,0,0,,Бірақ аздап дайындалған дұрыс.
Dialogue: 0,0:06:13.67,0:06:16.07,Default,,0,0,0,,Бұрынғыдай болып қалатын ештеңе жоқ.
Dialogue: 0,0:06:16.37,0:06:17.11,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:06:17.41,0:06:20.81,Default,,0,0,0,,Кешіріңіз, онша байыпты болмаңыз.
Dialogue: 0,0:06:20.91,0:06:25.58,Default,,0,0,0,,Аа, егер шынымен алаңдасаңыз, неге одан сұрамайсыз?
Dialogue: 0,0:06:25.88,0:06:27.55,Default,,0,0,0,,Эй, ол туралы ше?
Dialogue: 0,0:06:27.65,0:06:28.72,Default,,0,0,0,,Не? ―
Dialogue: 0,0:06:29.52,0:06:32.15,Default,,0,0,0,,Лулу... Лулу!Бүгін сенің демалыс күнің бе?
Dialogue: 0,0:06:32.45,0:06:34.16,Default,,0,0,0,,Нунналидің қызуы аздап көтерілді.
Dialogue: 0,0:06:34.69,0:06:36.79,Default,,0,0,0,,Сакиоко да түске дейін бірдеңе жасайтынын айтты.
Dialogue: 0,0:06:36.89,0:06:40.83,Default,,0,0,0,,О... дұрыс, Нана-чан, қазір өзіңді жақсы сезінесің бе?
Dialogue: 0,0:06:40.93,0:06:43.80,Default,,0,0,0,,Ал, төраға, құжат үлгісі.
Dialogue: 0,0:06:43.97,0:06:47.70,Default,,0,0,0,,Аа, әр баға бойынша сынып бойынша сұрыптаңыз.
Dialogue: 0,0:06:47.80,0:06:48.94,Default,,0,0,0,,Иә, иә -
Dialogue: 0,0:06:49.04,0:06:50.81,Default,,0,0,0,,Сіз әлі де адамдармен дөрекісіз.
Dialogue: 0,0:06:50.91,0:06:53.14,Default,,0,0,0,,Хехе, қабілетті бағыныңқысы болғанына қуанамын.
Dialogue: 0,0:06:53.54,0:06:56.94,Default,,0,0,0,,Бағыныңқы?Иә... солай болады.
Dialogue: 0,0:06:58.48,0:07:03.75,Default,,0,0,0,,Төраға, бұл сіздің жүрегіңізге жаман. Мұндай нәрсе... Иә? ―
Dialogue: 0,0:07:03.85,0:07:04.92,Default,,0,0,0,,Иә?билет
Dialogue: 0,0:07:05.02,0:07:05.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:07.66,0:07:08.56,Default,,0,0,0,,Лулу!
Dialogue: 0,0:07:08.82,0:07:09.82,Default,,0,0,0,,Не?
Dialogue: 0,0:07:09.92,0:07:10.99,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:07:11.09,0:07:13.83,Default,,0,0,0,,Менің хатым сол құжатпен араласып кеткен жоқ па?
Dialogue: 0,0:07:13.93,0:07:14.80,Default,,0,0,0,,Не? ―
Dialogue: 0,0:07:15.00,0:07:17.00,Default,,0,0,0,,О, бұл жаман.
Dialogue: 0,0:07:17.53,0:07:19.20,Default,,0,0,0,,Иә?what up?
Dialogue: 0,0:07:21.57,0:07:22.44,Default,,0,0,0,,Лулу!
Dialogue: 0,0:07:22.54,0:07:23.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:23.47,0:07:24.44,Default,,0,0,0,,) Әй?
Dialogue: 0,0:07:34.62,0:07:36.58,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:07:37.02,0:07:40.46,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес. Мен үшін ол жігіт...
Dialogue: 0,0:07:45.99,0:07:51.97,Default,,0,0,0,,Хаха... мен жасадым мен жасадым
Dialogue: 0,0:07:52.13,0:07:57.54,Default,,0,0,0,,Не істеуім керек? Ол келеді. Ол жоқ деп айтқан жоқ, бірақ...
Dialogue: 0,0:07:57.74,0:08:01.01,Default,,0,0,0,,Жоқ, біз бірге концертке барамыз.
Dialogue: 0,0:08:01.68,0:08:05.08,Default,,0,0,0,,Егер бұл жай ғана болса, бұл үлкен мәселе емес, бірақ бұл мүмкіндік.
Dialogue: 0,0:08:05.85,0:08:07.92,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,0:08:07.92,0:08:08.48,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,0:08:07.92,0:08:08.48,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:08:08.48,0:08:10.85,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:08:10.85,0:08:11.92,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:08:10.85,0:08:11.92,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:11.92,0:08:12.92,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:08:15.22,0:08:17.66,Default,,0,0,0,,) Киото маған Guren 2 стилін сәтті қолданғанымды айтты...
Dialogue: 0,0:08:17.76,0:08:18.99,Default,,0,0,0,,Мені мақтады.
Dialogue: 0,0:08:19.09,0:08:20.06,Default,,0,0,0,,Бұл әсерлі болды.
Dialogue: 0,0:08:20.16,0:08:21.73,Default,,0,0,0,,Бірақ сол ақ дулыға...
Dialogue: 0,0:08:21.83,0:08:24.63,Default,,0,0,0,,Уайымдама, бұл тең ойын, солай ма? Сурет салу -
Dialogue: 0,0:08:24.73,0:08:26.80,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:08:26.90,0:08:29.84,Default,,0,0,0,,Не болып жатыр, кенет Ширли?
Dialogue: 0,0:08:29.94,0:08:32.04,Default,,0,0,0,,Әкем жалғыз жұмыс істеген.
Dialogue: 0,0:08:32.14,0:08:36.18,Default,,0,0,0,,Бірақ олар маған ұнау үшін осындай нәрселерді жиі жібереді.
Dialogue: 0,0:08:36.28,0:08:38.01,Default,,0,0,0,,Сонда не?
Dialogue: 0,0:08:38.21,0:08:39.65,Default,,0,0,0,,Бұл (Лелуш)? ―
Dialogue: 0,0:08:39.75,0:08:40.62,Default,,0,0,0,,(Камо) Һм. (Фушигиро) Ұф.
Dialogue: 0,0:08:40.72,0:08:42.98,Default,,0,0,0,,Махаббат хаты (Лелуч) иә? Сіз...
Dialogue: 0,0:08:43.08,0:08:46.89,Default,,0,0,0,,Кяхахаха Бұл жігіт әзілдерді қабылдай алмайды.
Dialogue: 0,0:08:46.99,0:08:48.09,Default,,0,0,0,,Тамаки тым көп күледі
Dialogue: 0,0:08:48.69,0:08:52.29,Default,,0,0,0,,Бұл Киотодан келген императорлық хат. Ол бізбен бетпе-бет кездескісі келеді.
Dialogue: 0,0:08:52.59,0:08:53.93,Default,,0,0,0,,Осындай шу шығаруға тұрарлық па?
Dialogue: 0,0:08:54.26,0:08:56.20,Default,,0,0,0,,Бұл Киото, солай ма?
Dialogue: 0,0:08:56.63,0:08:59.57,Default,,0,0,0,,Егер мақұлданса, сіз қаржылық қолдау ала аласыз.
Dialogue: 0,0:08:59.67,0:09:00.94,Default,,0,0,0,,Біздің қиын қаржы...
Dialogue: 0,0:09:01.04,0:09:02.84,Default,,0,0,0,,Қаржы? (жанкүйер) А
Dialogue: 0,0:09:02.94,0:09:04.57,Default,,0,0,0,,Егер бұл менің бюджетіме сәйкес болса...
Dialogue: 0,0:09:04.67,0:09:06.31,Default,,0,0,0,,Мәселе болмауы керек пе еді?
Dialogue: 0,0:09:06.61,0:09:07.28,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:09:07.58,0:09:11.11,Default,,0,0,0,,Ей, бұл менің кінәм емес, біз қазір үлкен ұйымбыз.
Dialogue: 0,0:09:11.65,0:09:13.18,Default,,0,0,0,,Адамдар саны көбейсе, жоспарланбаған
Dialogue: 0,0:09:13.28,0:09:16.62,Default,,0,0,0,,Жаңадан келгендерді үнемі үлкен атаққа айналдырып, емдеу жоспардан тыс па?
Dialogue: 0,0:09:16.72,0:09:17.59,Default,,0,0,0,,Міне, бастаймыз!
Dialogue: 0,0:09:17.69,0:09:20.66,Default,,0,0,0,,Мен сенің қайда бара жатқаныңды білемін.
Dialogue: 0,0:09:20.76,0:09:21.96,Default,,0,0,0,,Эх!Солай ма?
Dialogue: 0,0:09:23.09,0:09:25.89,Default,,0,0,0,,Әзірге бухгалтерлік есеппен Ougi айналыссын.
Dialogue: 0,0:09:25.99,0:09:26.86,Default,,0,0,0,,Күте тұрыңыз! ―
Dialogue: 0,0:09:26.96,0:09:29.90,Default,,0,0,0,,Ақшаны ұстамағаныма көп болды.
Dialogue: 0,0:09:30.00,0:09:33.13,Default,,0,0,0,,Егер сізге сенімді болғыңыз келсе, сәйкес нәтижелерді көрсетіңіз.
Dialogue: 0,0:09:33.23,0:09:34.87,Default,,0,0,0,,Не! Соны айтасыз ба? ―
Dialogue: 0,0:09:34.97,0:09:36.94,Default,,0,0,0,,Доспын деп, бетін де көрсетпейтін жігіт...
Dialogue: 0,0:09:37.67,0:09:39.14,Default,,0,0,0,,Не болды, Нөл!а?
Dialogue: 0,0:09:40.07,0:09:41.71,Default,,0,0,0,,Күте тұрыңыз, болды.
Dialogue: 0,0:09:41.81,0:09:43.34,Default,,0,0,0,,Мен Нольдің шынайы тұлғасы қандай екені қызық...
Dialogue: 0,0:09:43.64,0:09:44.71,Default,,0,0,0,,Бұл маңызды емес, солай ма? ―
Dialogue: 0,0:09:45.01,0:09:47.82,Default,,0,0,0,,Нөлдің Корнелиядан айласы болатын.
Dialogue: 0,0:09:47.92,0:09:50.05,Default,,0,0,0,,Біз Қара рыцарьлардың көсеміміз бе? ―
Dialogue: 0,0:09:50.28,0:09:52.19,Default,,0,0,0,,Сізге тағы не керек?
Dialogue: 0,0:09:52.29,0:09:53.35,Default,,0,0,0,,Цк
Dialogue: 0,0:09:53.85,0:09:59.86,Default,,0,0,0,,♪～
Dialogue: 0,0:10:09.84,0:10:11.97,Default,,0,0,0,,Нина-сан...? ―
Dialogue: 0,0:10:12.07,0:10:13.74,Default,,0,0,0,,Өзіңізді нашар сезінсеңіз...
Dialogue: 0,0:10:13.98,0:10:17.61,Default,,0,0,0,,Жоқ, бұл ештеңе емес, бұл ештеңе емес.
Dialogue: 0,0:10:17.71,0:10:19.18,Default,,0,0,0,,Ей, не істеуіміз керек?
Dialogue: 0,0:10:19.28,0:10:20.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:20.65,0:10:22.88,Default,,0,0,0,,Біз бастапқыда Наотоның командасы болдық.
Dialogue: 0,0:10:22.98,0:10:25.19,Default,,0,0,0,,Мен Карен әпкемге қарсы емеспін.
Dialogue: 0,0:10:25.29,0:10:27.79,Default,,0,0,0,,Сендер, екінші ұрпақ, басшылықты тапсырасыңдар.
Dialogue: 0,0:10:27.89,0:10:29.72,Default,,0,0,0,,Нарита болғанда, бәрі де
Dialogue: 0,0:10:29.82,0:10:32.16,Default,,0,0,0,,Бірақ бұл дерлік қауіп сияқты болды.
Dialogue: 0,0:10:32.26,0:10:34.76,Default,,0,0,0,,Бұл тіпті басшыларға да құпия.
Dialogue: 0,0:10:34.86,0:10:36.10,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:10:37.13,0:10:40.30,Default,,0,0,0,,Мүмкін болатын 12 адамға дейін қысқартылды.
Dialogue: 0,0:10:40.40,0:10:43.04,Default,,0,0,0,,Бұл тек қай карта ұтып алатыны ғана...
Dialogue: 0,0:10:43.27,0:10:45.67,Default,,0,0,0,,Импровизация қажет бола ма?
Dialogue: 0,0:10:45.67,0:10:45.91,Default,,0,0,0,,Импровизация қажет бола ма?
Dialogue: 0,0:10:46.34,0:10:46.77,Default,,0,0,0,,А, бұл кім?
Dialogue: 0,0:10:46.77,0:10:47.81,Default,,0,0,0,,А, бұл кім?
Dialogue: 0,0:10:48.38,0:10:49.64,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,0:10:49.74,0:10:52.08,Default,,0,0,0,,Мм, сіз тым ерте шықтым дедіңіз...
Dialogue: 0,0:10:52.18,0:10:54.08,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:10:54.18,0:10:57.75,Default,,0,0,0,,Карен Сіз де менің шынайы жүзімді білгіңіз келе ме?
Dialogue: 0,0:10:57.95,0:10:58.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:01.12,0:11:03.42,Default,,0,0,0,,Ол адам біледі...
Dialogue: 0,0:11:05.06,0:11:06.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:06.66,0:11:09.13,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:11:19.07,0:11:19.94,Default,,0,0,0,,Үлкен аға?
Dialogue: 0,0:11:20.04,0:11:21.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:23.28,0:11:25.28,Default,,0,0,0,,Қызбаңыз түсіп кеткен сияқты.
Dialogue: 0,0:11:25.38,0:11:27.75,Default,,0,0,0,,Бәлкім, мен жай ғана ренжідім.
Dialogue: 0,0:11:27.85,0:11:29.45,Default,,0,0,0,,Сунеру? (Нақтырақ) Уху
Dialogue: 0,0:11:29.75,0:11:34.12,Default,,0,0,0,,Соңғы кездері ағам біраз алыстап кеткендей.
Dialogue: 0,0:11:34.22,0:11:35.42,Default,,0,0,0,,Мен солай сезінемін
Dialogue: 0,0:11:35.72,0:11:36.46,Default,,0,0,0,,Уф
Dialogue: 0,0:11:37.36,0:11:39.96,Default,,0,0,0,,Хехе, сондықтан менің денем өздігінен әрекет етеді...
Dialogue: 0,0:11:40.19,0:11:43.23,Default,,0,0,0,,Мүмкін ол адамдардың өзіне назар аударуын қалаған шығар.
Dialogue: 0,0:11:44.80,0:11:47.74,Default,,0,0,0,,Мен өзгермеймін деп ант етемін.
Dialogue: 0,0:11:47.84,0:11:51.94,Default,,0,0,0,,Қандай жағдай болса да, мен әрқашан жаныңда боламын, Нуналли.
Dialogue: 0,0:11:52.14,0:11:55.31,Default,,0,0,0,,Сонымен, өзімшіл болу дұрыс па?
Dialogue: 0,0:11:55.41,0:11:59.05,Default,,0,0,0,,Қолымды сәл ғана ұстаңыз.
Dialogue: 0,0:11:59.15,0:12:00.78,Default,,0,0,0,,Осылай жалғыз ұйықтай берсем...
Dialogue: 0,0:12:01.25,0:12:04.35,Default,,0,0,0,,Мен сол арманымды қайта көретін сияқтымын
Dialogue: 0,0:12:11.89,0:12:14.83,Default,,0,0,0,,Сіз байсалдысыз ба? Сізден сұрайтыным сол
Dialogue: 0,0:12:14.96,0:12:18.40,Default,,0,0,0,,Аа, мен сіз берген кеңесті қолданғым келеді.
Dialogue: 0,0:12:19.10,0:12:23.30,Default,,0,0,0,,Киотоның ниеті қандай болса да, мен олардың билігін алғым келеді.
Dialogue: 0,0:12:23.40,0:12:28.98,Default,,0,0,0,,Бұл сенің тілегің, өмір сүру мақсатың, қажет болса қол ұшын соза аламын.
Dialogue: 0,0:12:29.08,0:12:30.31,Default,,0,0,0,,Қалайша біз жеңілгенімізді мойындап, басымызды иеміз?
Dialogue: 0,0:12:30.85,0:12:33.05,Default,,0,0,0,,C.C. Сіз
Dialogue: 0,0:12:35.22,0:12:37.15,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:12:37.25,0:12:39.45,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым. (Лелуш) О.
Dialogue: 0,0:12:40.32,0:12:41.99,Default,,0,0,0,,Мен ұмытып кеткен болуым керек
Dialogue: 0,0:12:42.09,0:12:43.86,Default,,0,0,0,,Бүгін үйге қашан бара алатынымды білмеймін...
Dialogue: 0,0:12:44.13,0:12:46.53,Default,,0,0,0,,Жоқ деп саған телефон соғатын болдым.
Dialogue: 0,0:12:46.83,0:12:47.50,Default,,0,0,0,,Келісімшартыңызды сақтай аласыз ба?
Dialogue: 0,0:12:47.50,0:12:48.80,Default,,0,0,0,,Келісімшартыңызды сақтай аласыз ба?
Dialogue: 0,0:12:47.50,0:12:48.80,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:12:48.80,0:12:48.90,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:12:48.90,0:12:49.86,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:12:48.90,0:12:49.86,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:12:50.90,0:12:52.00,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:12:52.50,0:12:54.47,Default,,0,0,0,,А, бұл дұрыс болды, шын мәнінде.
Dialogue: 0,0:12:54.77,0:12:56.14,Default,,0,0,0,,Ум?Лулу
Dialogue: 0,0:12:56.24,0:12:57.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:57.20,0:12:59.04,Default,,0,0,0,,Бүгінгі уәде...
Dialogue: 0,0:12:59.14,0:13:00.77,Default,,0,0,0,,Кешіктірілуі мүмкін
Dialogue: 0,0:13:01.18,0:13:02.21,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:02.31,0:13:06.85,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін. Иә, мен міндетті түрде барамын.
Dialogue: 0,0:13:14.32,0:13:16.29,Default,,0,0,0,,Басқа басшыларды да әкеліңіз.
Dialogue: 0,0:13:16.39,0:13:18.16,Default,,0,0,0,,Маған бұл туралы Ұстаз айтты
Dialogue: 0,0:13:18.26,0:13:21.53,Default,,0,0,0,,Төтенше жағдай кезінде айналаңызға сақ болыңыз.
Dialogue: 0,0:13:21.83,0:13:24.87,Default,,0,0,0,,Мен сізге бірден қоңырау шаламын, бірақ оған дейін
Dialogue: 0,0:13:26.33,0:13:29.07,Default,,0,0,0,,Егер дене қатты зақымданса, екінші шатырға барыңыз.
Dialogue: 0,0:13:29.17,0:13:31.11,Default,,0,0,0,,Егер артта қалған заттар болса, оларды анықтауға асығыңыз.
Dialogue: 0,0:13:31.41,0:13:33.91,Default,,0,0,0,,Бетін анықтауға болатындар бірінші шатырға барады.
Dialogue: 0,0:13:34.01,0:13:36.51,Default,,0,0,0,,Құжатта табылған жері мен уақытын көрсетіңіз.
Dialogue: 0,0:13:36.81,0:13:39.38,Default,,0,0,0,,Жақында екінші медициналық бригада келеді.
Dialogue: 0,0:13:39.48,0:13:41.52,Default,,0,0,0,,Тасымалдау қызметкерлері дереу уақытша шатырға баруы керек.
Dialogue: 0,0:13:41.82,0:13:43.48,Default,,0,0,0,,Ол шынымен де сонда болды ма?
Dialogue: 0,0:13:43.58,0:13:46.49,Default,,0,0,0,,Ол сонда...
Dialogue: 0,0:13:48.92,0:13:51.43,Default,,0,0,0,,Оны ұмытыңыз, ол деректерде де жоқ.
Dialogue: 0,0:13:53.93,0:13:56.50,Default,,0,0,0,,Сіз әлі де қанағаттанасыз ба?Мәйітті қазу
Dialogue: 0,0:13:56.60,0:13:57.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:57.87,0:14:01.50,Default,,0,0,0,,Мүмкін болса, маған тағы да құтқару жұмыстарын жүргізуге рұқсат етіңіз.
Dialogue: 0,0:14:01.60,0:14:04.07,Default,,0,0,0,,Содан кейін өзіңізге ұнағанша жалғастырыңыз.
Dialogue: 0,0:14:04.17,0:14:07.17,Default,,0,0,0,,Бұл сондай-ақ Мәртебелі Корнелияның бұйрығы.
Dialogue: 0,0:14:07.27,0:14:08.31,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:14:09.11,0:14:11.35,Default,,0,0,0,,Ллойд мырза, Нөл
Dialogue: 0,0:14:11.45,0:14:13.55,Default,,0,0,0,,Қара рыцарлар не істемекші? ―
Dialogue: 0,0:14:14.35,0:14:17.52,Default,,0,0,0,,Мұндай құрбандықпен не істеуге болады деп ойлайсыз?
Dialogue: 0,0:14:17.62,0:14:21.29,Default,,0,0,0,,Сіз әділдік жағындасыз ба?Өз сөзімен
Dialogue: 0,0:14:21.46,0:14:22.92,Default,,0,0,0,,Бұл әділдік пе?
Dialogue: 0,0:14:23.02,0:14:25.33,Default,,0,0,0,,Эй, эй, мен әділдіктің не екеніне сенбеймін...
Dialogue: 0,0:14:25.43,0:14:28.63,Default,,0,0,0,,Менің ойымша, сіз ұятқа қалдыратын дау қозғамайсыз.
Dialogue: 0,0:14:28.93,0:14:31.20,Default,,0,0,0,,Біз солдатпыз, солай ма? Ах...
Dialogue: 0,0:14:33.23,0:14:34.30,Default,,0,0,0,,Ах
Dialogue: 0,0:14:34.50,0:14:37.87,Default,,0,0,0,,Бұл аяқталды! Энергия толтырғышты ауыстыру
Dialogue: 0,0:14:37.97,0:14:39.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:42.61,0:14:43.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:47.38,0:14:48.55,Default,,0,0,0,,Сесил
Dialogue: 0,0:14:48.65,0:14:51.42,Default,,0,0,0,,Таза қанды ұшақтарды да зерттедім.
Dialogue: 0,0:14:51.59,0:14:53.39,Default,,0,0,0,,Өйткені, бұл
Dialogue: 0,0:14:53.62,0:14:55.42,Default,,0,0,0,,Иә, бұл сәулелі толқын.
Dialogue: 0,0:14:55.52,0:14:58.43,Default,,0,0,0,,Жаумен қалай ынтымақтасасың?
Dialogue: 0,0:14:58.53,0:15:00.09,Default,,0,0,0,,Сол Ракшата
Dialogue: 0,0:15:00.19,0:15:02.30,Default,,0,0,0,,Жаудың ұшқыштары да эйс-класс.
Dialogue: 0,0:15:02.40,0:15:05.17,Default,,0,0,0,,Қазір Созакудың психикалық тұрақтылығынан үміт жоқ.
Dialogue: 0,0:15:05.27,0:15:07.43,Default,,0,0,0,,Егер мен бұл қарсыласпен қайтадан жекпе-жек өткізсем
Dialogue: 0,0:15:07.53,0:15:09.34,Default,,0,0,0,,Сіз жеңе алмаймын дейсіз бе? ―
Dialogue: 0,0:15:09.44,0:15:11.41,Default,,0,0,0,,Менің Ланселот туралы не айтасыз?
Dialogue: 0,0:15:15.21,0:15:17.31,Default,,0,0,0,,Көп уақыт өтті, бірақ сіз әлі жүгіріп жүрсіз бе?
Dialogue: 0,0:15:17.41,0:15:20.31,Default,,0,0,0,,Неге аздап тынышталмайсың?Әдепсіз
Dialogue: 0,0:15:20.41,0:15:21.98,Default,,0,0,0,,Хмм! Не?
Dialogue: 0,0:15:24.22,0:15:25.92,Default,,0,0,0,,Жоғары көтерілу
Dialogue: 0,0:15:34.13,0:15:35.93,Default,,0,0,0,,Келтірілген қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:15:36.03,0:15:38.10,Default,,0,0,0,,Мастер сізді күтуде.
Dialogue: 0,0:15:42.00,0:15:43.17,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:15:43.64,0:15:44.67,Default,,0,0,0,,Ах
Dialogue: 0,0:15:45.37,0:15:46.41,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:15:46.51,0:15:48.11,Default,,0,0,0,,Фудзи кеніші!
Dialogue: 0,0:15:48.44,0:15:52.01,Default,,0,0,0,,Бұл өтірік болуы керек Эй! Сіз осындай жерге келе аласыз ...
Dialogue: 0,0:15:52.11,0:15:55.08,Default,,0,0,0,,Бірақ сөзсіз!Бұл тауда осындай пішін бар!
Dialogue: 0,0:15:55.42,0:15:57.95,Default,,0,0,0,,Яғни... Сакурадит осыдан төмен...
Dialogue: 0,0:15:58.05,0:16:00.02,Default,,0,0,0,,Соғысты бастаған қазына ғой, солай ма? ―
Dialogue: 0,0:16:00.19,0:16:03.22,Default,,0,0,0,,Келген адамды жауапсыз атып өлтірді.
Dialogue: 0,0:16:03.49,0:16:06.16,Default,,0,0,0,,Құдіреттің мұндай жерге жеткеніне сене алар емеспін...
Dialogue: 0,0:16:06.26,0:16:07.46,Default,,0,0,0,,Киото күткендей керемет
Dialogue: 0,0:16:07.56,0:16:09.26,Default,,0,0,0,,Бұл ұсқынсыз ба? (Оуги/Карен) Ха
Dialogue: 0,0:16:10.10,0:16:11.70,Default,,0,0,0,,Бір кезде, Саншисүймей
Dialogue: 0,0:16:12.00,0:16:16.60,Default,,0,0,0,,Фудзи тауы суы тұнық, жасыл желекті киелі тау ретінде танымал.
Dialogue: 0,0:16:16.97,0:16:20.74,Default,,0,0,0,,Енді мен империяға бағындым және оның мейіріміне байланысты бұзылуды жалғастырамын.
Dialogue: 0,0:16:21.04,0:16:23.68,Default,,0,0,0,,Біздің еліміздің, Жапонияның бейнесі.
Dialogue: 0,0:16:23.98,0:16:25.55,Default,,0,0,0,,Саған қасіретке...
Dialogue: 0,0:16:27.51,0:16:30.42,Default,,0,0,0,,Бетімізді көрсетпегеніміз үшін кешірім сұрайық.
Dialogue: 0,0:16:30.52,0:16:33.55,Default,,0,0,0,,Бірақ... Нөл Сізге де солай.
Dialogue: 0,0:16:34.22,0:16:39.09,Default,,0,0,0,,Мен сенің кім екеніңді білуім керек...
Dialogue: 0,0:16:39.33,0:16:42.43,Default,,0,0,0,,Саған шынайы бет-бейнесін көрсетейін
Dialogue: 0,0:16:44.30,0:16:45.23,Default,,0,0,0,,Ах
Dialogue: 0,0:16:49.17,0:16:51.01,Default,,0,0,0,,Ха, күте тұрыңыз!
Dialogue: 0,0:16:51.11,0:16:53.51,Default,,0,0,0,,Нөл бізге күш пен жеңіс сыйлады! ―
Dialogue: 0,0:16:53.74,0:16:56.04,Default,,0,0,0,,Мынау... (Кирихара) Тыныш! ―
Dialogue: 0,0:16:56.14,0:16:57.41,Default,,0,0,0,,Оуги деп аталатын бұл адам кім?
Dialogue: 0,0:16:57.51,0:16:59.58,Default,,0,0,0,,А... иә, бұл менмін.
Dialogue: 0,0:16:59.68,0:17:02.15,Default,,0,0,0,,Нөлдік масканы шешіңіз
Dialogue: 0,0:17:02.38,0:17:04.08,Default,,0,0,0,,FB… FB!
Dialogue: 0,0:17:07.55,0:17:08.49,Default,,0,0,0,,Оуги-сан!
Dialogue: 0,0:17:08.59,0:17:12.73,Default,,0,0,0,,Кешіріңіз, Нөл, бірақ мен де сізге сенгім келеді.
Dialogue: 0,0:17:13.13,0:17:16.30,Default,,0,0,0,,Ендеше, иман келтірейін.
Dialogue: 0,0:17:16.53,0:17:17.56,Default,,0,0,0,,Ах (жанкүйер) Уф
Dialogue: 0,0:17:18.73,0:17:20.03,Default,,0,0,0,,Әй... әйел! ?
Dialogue: 0,0:17:20.13,0:17:21.07,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:17:21.17,0:17:22.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:23.04,0:17:25.51,Default,,0,0,0,,Бұл адам нөл емес!Мен көрдім!
Dialogue: 0,0:17:25.61,0:17:27.37,Default,,0,0,0,,Нөл бұл адаммен бірге болды.
Dialogue: 0,0:17:27.57,0:17:30.31,Default,,0,0,0,,Бұл әйел Макото ма?
Dialogue: 0,0:17:30.58,0:17:31.58,Default,,0,0,0,,О
Dialogue: 0,0:17:31.68,0:17:35.18,Default,,0,0,0,,Ал сен жапон емессің.
Dialogue: 0,0:17:35.28,0:17:37.52,Default,,0,0,0,,Иә, Киото өкілі.
Dialogue: 0,0:17:38.39,0:17:40.05,Default,,0,0,0,,Тайзо Кирихара
Dialogue: 0,0:17:40.15,0:17:40.82,Default,,0,0,0,,Не...
Dialogue: 0,0:17:41.12,0:17:43.39,Default,,0,0,0,,Сіздің жеке басыңызды білетін адамды тірі қалдыруға болмайды!
Dialogue: 0,0:17:43.59,0:17:45.73,Default,,0,0,0,,Жапондықтармен бұлай болмаса, бәрі жақсы!
Dialogue: 0,0:17:45.83,0:17:49.50,Default,,0,0,0,,Күте тұрыңыз! Менің оған қатысым жоқ!
Dialogue: 0,0:17:53.43,0:17:54.30,Default,,0,0,0,,Ах
Dialogue: 0,0:17:55.40,0:17:58.81,Default,,0,0,0,,Жылы, ал әдістері мен ойлау тәсілі ескі.
Dialogue: 0,0:17:59.24,0:18:00.11,Default,,0,0,0,,(Кирихараның ырылдауы)
Dialogue: 0,0:18:00.67,0:18:03.21,Default,,0,0,0,,Сондықтан сіз жеңе алмайсыз!
Dialogue: 0,0:18:03.31,0:18:04.18,Default,,0,0,0,,Нөл?
Dialogue: 0,0:18:04.28,0:18:06.18,Default,,0,0,0,,Бізге тез сүңгуді үйретіңізші.
Dialogue: 0,0:18:06.28,0:18:07.18,Default,,0,0,0,,Құт (күзет) Тоқта! ―
Dialogue: 0,0:18:07.65,0:18:11.32,Default,,0,0,0,,Сізді алыстан атып өлтіреді!Жақсы, ешкімнің қолын тигізбе!
Dialogue: 0,0:18:12.72,0:18:14.66,Default,,0,0,0,,Тайзо Кирихара
Dialogue: 0,0:18:15.29,0:18:17.62,Default,,0,0,0,,Сакурадитті өндіру жұмыстарына жауапты.
Dialogue: 0,0:18:17.72,0:18:19.86,Default,,0,0,0,,Кирихара Сангио негізін қалаушы ретінде...
Dialogue: 0,0:18:20.16,0:18:22.63,Default,,0,0,0,,Куруруги режимінің артында тұрған адам
Dialogue: 0,0:18:22.73,0:18:25.43,Default,,0,0,0,,Алайда, жеңіліске ұшыраған соң, бұрылды...
Dialogue: 0,0:18:25.53,0:18:28.50,Default,,0,0,0,,Отаршылдық кезінде белсенді серіктес болу.
Dialogue: 0,0:18:28.60,0:18:31.47,Default,,0,0,0,,Әдетте сатқын Кирихара ретінде белгілі.
Dialogue: 0,0:18:31.57,0:18:35.84,Default,,0,0,0,,Дегенмен, оның бүкіл елдегі қарсылықты біріктіретіні шындық.
Dialogue: 0,0:18:36.14,0:18:40.55,Default,,0,0,0,,Киотоның алты кланының маңызды мүшесі, ол мойынсұнғыш... Бұл арзан.
Dialogue: 0,0:18:40.65,0:18:42.32,Default,,0,0,0,,Сен! Сезімдерің
Dialogue: 0,0:18:42.42,0:18:43.62,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:43.72,0:18:44.75,Default,,0,0,0,,―
Dialogue: 0,0:18:44.85,0:18:47.15,Default,,0,0,0,,Сіз ойладыңыз ...
Dialogue: 0,0:18:47.25,0:18:50.12,Default,,0,0,0,,Мен жапон емеспін!
Dialogue: 0,0:18:50.22,0:18:51.33,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:18:51.43,0:18:52.36,Default,,0,0,0,,Шынайы ма?...
Dialogue: 0,0:18:52.69,0:18:55.23,Default,,0,0,0,,Жарайды, бетіңді көрсете алмауың керек.
Dialogue: 0,0:18:55.43,0:19:00.73,Default,,0,0,0,,Егер сен жапон болсаң, неге төбелесесің?саған не керек?
Dialogue: 0,0:19:00.83,0:19:02.57,Default,,0,0,0,,Британияның құлауы
Dialogue: 0,0:19:02.67,0:19:07.47,Default,,0,0,0,,Осындай нәрсені жасауға бола ма? Негізінен
Dialogue: 0,0:19:07.57,0:19:08.58,Default,,0,0,0,,Сіз аласыз! ―
Dialogue: 0,0:19:08.68,0:19:09.74,Default,,0,0,0,,Себебі-
Dialogue: 0,0:19:09.84,0:19:13.21,Default,,0,0,0,,Өйткені мұны істеуге себебім бар.
Dialogue: 0,0:19:13.31,0:19:16.28,Default,,0,0,0,,Ха, иә... Сенің менің серігім болғаныңа қуаныштымын.
Dialogue: 0,0:19:16.45,0:19:19.22,Default,,0,0,0,,Хмм, Мырза...
Dialogue: 0,0:19:19.45,0:19:22.32,Default,,0,0,0,,Біраз уақыт болды, лорд Кирихара.
Dialogue: 0,0:19:22.42,0:19:27.29,Default,,0,0,0,,Мен күткендей сегіз жыл бұрын сол үйде адам құрбандығы ретінде ұсталды.
Dialogue: 0,0:19:27.39,0:19:30.46,Default,,0,0,0,,Иә, мен ол кезде сізге қарыздар едім.
Dialogue: 0,0:19:30.56,0:19:34.50,Default,,0,0,0,,Егер мен болмасам, сіз оны кепілге алғыңыз келді ме?
Dialogue: 0,0:19:34.60,0:19:39.67,Default,,0,0,0,,Менің қолымнан келетіні – сұрау.
Dialogue: 0,0:19:40.74,0:19:44.28,Default,,0,0,0,,8 жыл бұрынғы тұқымдар гүлдей ме?
Dialogue: 0,0:19:44.38,0:19:47.88,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:19:48.18,0:19:49.28,Default,,0,0,0,,Қарғыс атсын! Мен көре алмаймын -
Dialogue: 0,0:19:49.38,0:19:50.28,Default,,0,0,0,,Ах (Кирихара) Оуги!
Dialogue: 0,0:19:50.55,0:19:51.89,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:19:52.19,0:19:54.92,Default,,0,0,0,,Бұл адам Британияның нағыз жауы.
Dialogue: 0,0:19:55.22,0:19:58.36,Default,,0,0,0,,Оның шынайы бет-бейнесін көрсетпеуінің себебі де нанымды.
Dialogue: 0,0:19:58.46,0:20:01.76,Default,,0,0,0,,Мен сізге кепілдік беремін, Нөлге ілесіңіз.
Dialogue: 0,0:20:01.86,0:20:06.57,Default,,0,0,0,,Біз ақпаратты жасыру және негіздерді табу бойынша ынтымақтасатын боламыз.
Dialogue: 0,0:20:06.67,0:20:08.34,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:20:08.44,0:20:09.84,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:10.40,0:20:12.77,Default,,0,0,0,,Рахмет сізге, Лорд Кирихара.
Dialogue: 0,0:20:13.21,0:20:15.51,Default,,0,0,0,,Біз барамыз ба?Шура жолы
Dialogue: 0,0:20:15.94,0:20:19.41,Default,,0,0,0,,Егер бұл менің тағдырым болса
Dialogue: 0,0:20:19.51,0:20:23.25,Default,,0,0,0,,2-5-7-8-9-взвод...
Dialogue: 0,0:20:23.35,0:20:24.75,Default,,0,0,0,,Жалғасы әкімшілік штабта…
Dialogue: 0,0:20:24.85,0:20:26.42,Default,,0,0,0,,Хмм... аа
Dialogue: 0,0:20:26.52,0:20:28.72,Default,,0,0,0,,Феннет осылай жазылады ма?
Dialogue: 0,0:20:28.82,0:20:29.72,Default,,0,0,0,,Бәрі де солай.
Dialogue: 0,0:20:30.32,0:20:32.76,Default,,0,0,0,,Кешіріңіз, бірақ бұл жағдайда.
Dialogue: 0,0:20:32.93,0:20:34.26,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:20:34.36,0:20:36.66,Default,,0,0,0,,растаңыз.
Dialogue: 0,0:20:37.56,0:20:38.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:40.50,0:20:43.40,Default,,0,0,0,,(телефонның қоңырау үні)
Dialogue: 0,0:20:44.30,0:20:46.34,Default,,0,0,0,,Мен оның кеткеніне сенімдімін.
Dialogue: 0,0:20:49.34,0:20:55.28,Default,,0,0,0,,(әншінің ән айту дауысы)
Dialogue: 0,0:20:55.45,0:20:58.42,Default,,0,0,0,,Қалай болғанда да, бұдан былай Қара рыцарьлар...
Dialogue: 0,0:20:58.52,0:21:01.46,Default,,0,0,0,,Бұдан былай ол шынымен мен ойлаған ұйымға айналады.
Dialogue: 0,0:21:01.56,0:21:02.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:09.30,0:21:12.00,Default,,0,0,0,,Кешіккенім үшін кешіріңіз.
Dialogue: 0,0:21:12.30,0:21:14.03,Default,,0,0,0,,Ол әлдеқашан кетіп қалды ма деп ойлаймын...
Dialogue: 0,0:21:16.70,0:21:21.64,Default,,0,0,0,,Жоқ, одан гөрі жаңбырдан пана алатын жерге барыңыз.
Dialogue: 0,0:21:21.74,0:21:24.28,Default,,0,0,0,,Сәлем Лулу
Dialogue: 0,0:21:24.38,0:21:27.41,Default,,0,0,0,,Нөл – әлсіздердің одақтасы, солай ма?
Dialogue: 0,0:21:27.51,0:21:30.58,Default,,0,0,0,,А... а, сен солай айттың.
Dialogue: 0,0:21:30.68,0:21:31.92,Default,,0,0,0,,If...
Dialogue: 0,0:21:32.02,0:21:34.89,Default,,0,0,0,,Әкемді неге өлтірдің?
Dialogue: 0,0:21:34.99,0:21:35.86,Default,,0,0,0,,Не!
Dialogue: 0,0:21:37.06,0:21:42.30,Default,,0,0,0,,Әкем мейірімді, мені ешқашан ұрмайтын.
Dialogue: 0,0:21:42.66,0:21:45.70,Default,,0,0,0,,Бұл жерде ештеңе жоқ... Бірақ...
Dialogue: 0,0:21:45.80,0:21:49.90,Default,,0,0,0,,Жерленген... Тыныс алу қиын...
Dialogue: 0,0:21:50.00,0:21:52.91,Default,,0,0,0,,Неліктен? Әке, мен неге...?
Dialogue: 0,0:21:54.41,0:21:57.38,Default,,0,0,0,,Мен мұны қаламаймын! Жоқ...-
Dialogue: 0,0:21:57.48,0:21:58.81,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:21:58.91,0:22:02.38,Default,,0,0,0,,(Шерли жылайды)
Dialogue: 0,0:22:03.32,0:22:05.62,Default,,0,0,0,,Лулу өтінемін
Dialogue: 0,0:22:06.75,0:22:08.46,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:22:17.73,0:22:21.37,Default,,0,0,0,,♪～
Dialogue: 0,0:22:21.47,0:22:25.01,Default,,0,0,0,,♪Мен жаяу жүрмін, бірақ мен арыстан мен жолбарыстың арылдаған жолмен жүріп келемін
Dialogue: 0,0:22:25.11,0:22:28.88,Default,,0,0,0,,♪Қызыл аспанның арғы жағында, Махороба
Dialogue: 0,0:22:28.98,0:22:32.68,Default,,0,0,0,,♪Тұтқынның оңашалығында қаңғыған жас
Dialogue: 0,0:22:32.78,0:22:36.52,Default,,0,0,0,,♪Әлсіздік пен ашу көзге көрінбейтін жау ма?
Dialogue: 0,0:22:36.62,0:22:41.99,Default,,0,0,0,,♪Әке, мен өзімді әлі білмеймін.
Dialogue: 0,0:22:44.02,0:22:48.06,Default,,0,0,0,,♪Алдыңғы ағайындар
Dialogue: 0,0:22:48.36,0:22:51.77,Default,,0,0,0,,♪Көзге көрінбейтін артқа ерсең
Dialogue: 0,0:22:51.87,0:22:58.84,Default,,0,0,0,,♪Таң жұлдызы сізді адасқан түнге шақырады
Dialogue: 0,0:22:59.51,0:23:02.94,Default,,0,0,0,,♪Өліммен бітпейді
Dialogue: 0,0:23:03.04,0:23:06.75,Default,,0,0,0,,♪Арманымды аңсасам да
Dialogue: 0,0:23:06.85,0:23:10.58,Default,,0,0,0,,♪Сенімді адам сенсің
Dialogue: 0,0:23:10.68,0:23:14.55,Default,,0,0,0,,♪Менің өмірім
Dialogue: 0,0:23:14.65,0:23:18.46,Default,,0,0,0,,♪Қатты жел айдалада, Көбелектер мен гүлдермен өмір сүремін.
Dialogue: 0,0:23:18.56,0:23:22.13,Default,,0,0,0,,♪Мәңгілік көктемде гүлдеген дәмді елес
Dialogue: 0,0:23:22.43,0:23:25.97,Default,,0,0,0,,♪Бұл денені кірлетсе де, бұлыңғырлықтың тазалығы
Dialogue: 0,0:23:26.07,0:23:29.84,Default,,0,0,0,,♪Жүрегіңіздің сырына сеніңіз
Dialogue: 0,0:23:29.94,0:23:35.54,Default,,0,0,0,,♪Анашым, көз жасымды көрсетпесем де
Dialogue: 0,0:23:35.71,0:23:40.18,Default,,0,0,0,,♪Аяғымның астындағы шөпте
Dialogue: 0,0:23:40.48,0:23:45.82,Default,,0,0,0,,♪Шық жоғалады
Dialogue: 0,0:23:49.69,0:23:50.92,Default,,0,0,0,,А, мен білемін
Dialogue: 0,0:23:51.02,0:23:52.79,Default,,0,0,0,,Іс-әрекеттердің нәтижелері туралы.
Dialogue: 0,0:23:52.89,0:23:56.56,Default,,0,0,0,,А, мен мұны білдім, бірақ неге...
Dialogue: 0,0:23:56.66,0:23:58.53,Default,,0,0,0,,Сахнадан жоғалып кету оңай.
Dialogue: 0,0:23:58.63,0:24:00.60,Default,,0,0,0,,Тек нөлдің бар екенін тастаңыз.
Dialogue: 0,0:24:00.70,0:24:02.07,Default,,0,0,0,,Кирихара мөрленгенше...
Dialogue: 0,0:24:02.17,0:24:03.57,Default,,0,0,0,,Мен Лелуш Ламперужмын.
Dialogue: 0,0:24:03.67,0:24:04.77,Default,,0,0,0,,Қайта алады-
Dialogue: 0,0:24:05.51,0:24:07.84,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:24:09.34,0:24:15.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory