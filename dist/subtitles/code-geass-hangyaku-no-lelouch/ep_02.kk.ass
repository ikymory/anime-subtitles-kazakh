Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.10,0:00:07.20,Default,,0,0,0,,Императорлық күнтізбе 2010 жылғы 10 тамыз -
Dialogue: 0,0:00:07.30,0:00:11.74,Default,,0,0,0,,Қасиетті Британ империясы Жапонияға соғыс жариялады.
Dialogue: 0,0:00:12.71,0:00:16.51,Default,,0,0,0,,Британияның соңғы қаруы Nightmare Frame алдында -
Dialogue: 0,0:00:16.61,0:00:19.71,Default,,0,0,0,,Жапония ештеңені ұстанбай жеңілді...
Dialogue: 0,0:00:20.02,0:00:26.45,Default,,0,0,0,,Бостандық пен дәстүр, құқық пен мақтаныш, есімнен айырылған.
Dialogue: 0,0:00:27.76,0:00:33.36,Default,,0,0,0,,Он бір Бұл сан жаңа жапон атауы болды.
Dialogue: 0,0:00:33.46,0:00:39.47,Default,,0,0,0,,♪～
Dialogue: 0,0:00:42.04,0:00:45.74,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:00:46.04,0:00:49.31,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:00:49.41,0:00:55.18,Default,,0,0,0,,♪Сәт әрқашан жаныңда...
Dialogue: 0,0:00:57.22,0:01:03.53,Default,,0,0,0,,♪ Тітіркенуді жасыра алмайды
Dialogue: 0,0:01:04.26,0:01:10.53,Default,,0,0,0,,♪ Бір орында тұрып өзіңе қара
Dialogue: 0,0:01:10.63,0:01:14.14,Default,,0,0,0,,♪ойланып отырып, уайымдап
Dialogue: 0,0:01:14.24,0:01:17.54,Default,,0,0,0,,♪Өкінішпен шешім қабылдау керек.
Dialogue: 0,0:01:17.64,0:01:21.14,Default,,0,0,0,,♪Сен маған берген бір сөз
Dialogue: 0,0:01:21.24,0:01:24.78,Default,,0,0,0,,♪Менің шатасуым жоғалады
Dialogue: 0,0:01:25.08,0:01:31.29,Default,,0,0,0,,♪Бос бөлмеме жарық түсті.
Dialogue: 0,0:01:31.62,0:01:34.82,Default,,0,0,0,,♪Мен қараған аспан
Dialogue: 0,0:01:35.16,0:01:38.69,Default,,0,0,0,,♪Ашық және көгілдір болып барады
Dialogue: 0,0:01:38.79,0:01:45.27,Default,,0,0,0,,♪Мен жабық терезені ашуды шештім.
Dialogue: 0,0:01:45.50,0:01:49.37,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:01:49.47,0:01:52.51,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:01:52.87,0:01:59.38,Default,,0,0,0,,♪Сәтті сезін, осында және қазір...
Dialogue: 0,0:02:11.19,0:02:13.56,Default,,0,0,0,,Эй, сен...
Dialogue: 0,0:02:13.66,0:02:16.16,Default,,0,0,0,,Менің не істегенімді қаладың? ―
Dialogue: 0,0:02:16.50,0:02:19.33,Default,,0,0,0,,Маған біртүрлі күштер беріңіз
Dialogue: 0,0:02:22.54,0:02:23.57,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:02:23.67,0:02:24.81,Default,,0,0,0,,Ах
Dialogue: 0,0:02:35.88,0:02:38.45,Default,,0,0,0,,Уф... неге SS?
Dialogue: 0,0:02:42.66,0:02:44.16,Default,,0,0,0,,Мұнда не болды? ―
Dialogue: 0,0:02:44.26,0:02:46.63,Default,,0,0,0,,Неліктен Britannia студенттері осындай жерде?
Dialogue: 0,0:02:46.86,0:02:48.76,Default,,0,0,0,,Маған жауап беріңіз немесе...
Dialogue: 0,0:02:49.20,0:02:49.73,Default,,0,0,0,,Цк
Dialogue: 0,0:02:52.37,0:02:53.74,Default,,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 0,0:02:53.84,0:02:56.74,Default,,0,0,0,,Қазір сол жерден түс.
Dialogue: 0,0:02:57.17,0:03:00.48,Default,,0,0,0,,Уф, сіз нені меңзеп тұрсыз?
Dialogue: 0,0:03:00.84,0:03:05.21,Default,,0,0,0,,Қарғыс атсын, түсіндім. Өйткені, сіз оны тікелей көруіңіз керек.
Dialogue: 0,0:03:06.28,0:03:07.75,Default,,0,0,0,,Менің атым Алан Спейсер.
Dialogue: 0,0:03:07.85,0:03:09.22,Default,,0,0,0,,Менің әкем герцог.
Dialogue: 0,0:03:09.58,0:03:10.69,Default,,0,0,0,,Герцог…
Dialogue: 0,0:03:10.79,0:03:13.56,Default,,0,0,0,,Ішкі қалтада жеке куәлік бар.
Dialogue: 0,0:03:13.66,0:03:15.79,Default,,0,0,0,,Тексергеннен кейін қорғауды сұрағым келеді.
Dialogue: 0,0:03:15.89,0:03:16.93,Default,,0,0,0,,Уф
Dialogue: 0,0:03:23.23,0:03:24.63,Default,,0,0,0,,Қолдарыңызды жоғары ұстаңыз...
Dialogue: 0,0:03:24.77,0:03:26.23,Default,,0,0,0,,Мен сізге жеке куәлікті беремін.
Dialogue: 0,0:03:26.40,0:03:29.37,Default,,0,0,0,,Маған қорқынышты түсіңді бер
Dialogue: 0,0:03:38.55,0:03:43.35,Default,,0,0,0,,Түсіндім, сандар XG2 (екі) және IG2D4 (төрт).
Dialogue: 0,0:03:44.82,0:03:45.92,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:48.89,0:03:53.26,Default,,0,0,0,,Уф, мен қандаймын...
Dialogue: 0,0:03:53.70,0:03:55.43,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:03:55.66,0:03:56.97,Default,,0,0,0,,Бұл ұят болды!
Dialogue: 0,0:03:57.37,0:03:57.93,Default,,0,0,0,,Ах
Dialogue: 0,0:03:58.60,0:04:01.84,Default,,0,0,0,,Сіз көкке баруды сағындыңыз, қатардағы Куруруги.
Dialogue: 0,0:04:01.94,0:04:04.67,Default,,0,0,0,,Ум... А, бұл қайда?
Dialogue: 0,0:04:04.87,0:04:07.41,Default,,0,0,0,,Иә? Әй, бұл әлі Шинджуку геттосы
Dialogue: 0,0:04:08.41,0:04:09.94,Default,,0,0,0,,Жоғары мәртебелі Хловистің жанында болғандықтан...
Dialogue: 0,0:04:10.25,0:04:12.31,Default,,0,0,0,,Бұл ең қауіпсіз жер.
Dialogue: 0,0:04:12.41,0:04:14.92,Default,,0,0,0,,Сузаку-кун, сені қорғаған осы болды.
Dialogue: 0,0:04:15.02,0:04:18.72,Default,,0,0,0,,Бұл оқтың қорғаныс костюмінің ішіне секіріп өтуіне жол бермеді.
Dialogue: 0,0:04:18.82,0:04:20.29,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:04:20.42,0:04:21.92,Default,,0,0,0,,(Кёко) Қыз ба? (Юки) Ұл ба?
Dialogue: 0,0:04:22.02,0:04:24.59,Default,,0,0,0,,Он бір Құдайдың заттарда тұратынын айтады.
Dialogue: 0,0:04:24.69,0:04:26.43,Default,,0,0,0,,Сенім бар сияқты. Осындай нәрселер...
Dialogue: 0,0:04:26.53,0:04:27.90,Default,,0,0,0,,Сол Лулу...
Dialogue: 0,0:04:29.30,0:04:30.93,Default,,0,0,0,,Жағдайға не болды?
Dialogue: 0,0:04:31.03,0:04:32.93,Default,,0,0,0,,Улы газ тараған сияқты.
Dialogue: 0,0:04:33.53,0:04:36.00,Default,,0,0,0,,Он бір адам көп шығынға ұшырады.
Dialogue: 0,0:04:36.30,0:04:38.47,Default,,0,0,0,,Кінәлі әлі табылмаған сияқты.
Dialogue: 0,0:04:38.57,0:04:39.94,Default,,0,0,0,,Шынымен бе? Әлі емес...
Dialogue: 0,0:04:40.04,0:04:41.51,Default,,0,0,0,,Жеке Куруруги-
Dialogue: 0,0:04:41.61,0:04:44.55,Default,,0,0,0,,Nightmare Frame міну тәжірибесі бар ма?
Dialogue: 0,0:04:44.65,0:04:46.41,Default,,0,0,0,,Не? Амал жоқ...-
Dialogue: 0,0:04:46.51,0:04:48.95,Default,,0,0,0,,Он бір тобының адамдары рыцарь бола алмайды.
Dialogue: 0,0:04:49.05,0:04:50.42,Default,,0,0,0,,Егер сіз бір бола алсаңыз, ол не болар еді?
Dialogue: 0,0:04:50.59,0:04:51.32,Default,,0,0,0,,А...
Dialogue: 0,0:04:51.59,0:04:52.75,Default,,0,0,0,,Құттықтаймыз! ―
Dialogue: 0,0:04:52.85,0:04:55.99,Default,,0,0,0,,Дүниедегі жалғыз қорқынышты түс сені күтіп тұр.
Dialogue: 0,0:04:56.29,0:04:59.86,Default,,0,0,0,,Егер сіз оны мінсеңіз, сіз және сіздің әлем өзгереді.
Dialogue: 0,0:05:00.36,0:05:02.60,Default,,0,0,0,,Қаласаңыз да, қаламасаңыз да
Dialogue: 0,0:05:03.06,0:05:03.87,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:03.97,0:05:04.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:09.40,0:05:11.01,Default,,0,0,0,,Сәлем Британия!
Dialogue: 0,0:05:11.31,0:05:13.31,Default,,0,0,0,,) Карен! Глазго әлі жұмыс істеп жатыр ма?
Dialogue: 0,0:05:13.41,0:05:13.98,Default,,0,0,0,,Жарайды! ―
Dialogue: 0,0:05:14.51,0:05:15.74,Default,,0,0,0,,Себебі мен саған жем боламын...
Dialogue: 0,0:05:15.84,0:05:17.95,Default,,0,0,0,,Оги-сан, мұндағылар қашып кетсін...
Dialogue: 0,0:05:18.05,0:05:20.08,Default,,0,0,0,,Тек біз, Қарсылық, тұтқынға түседі!
Dialogue: 0,0:05:20.38,0:05:23.45,Default,,0,0,0,,Мен білемін! Бірақ егер мені осыншама қоршап алса...
Dialogue: 0,0:05:23.55,0:05:26.55,Default,,0,0,0,,Ахаха...
Dialogue: 0,0:05:26.65,0:05:28.89,Default,,0,0,0,,Мұндай жағдайда, егер...
Dialogue: 0,0:05:28.99,0:05:31.33,Default,,0,0,0,,Жоқ, сіз салмақ қосқандықтан батып кетесіз дейді.
Dialogue: 0,0:05:31.43,0:05:32.49,Default,,0,0,0,,Бұл мен тамақ ішкендіктен емес.
Dialogue: 0,0:05:32.59,0:05:33.49,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:34.06,0:05:35.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:38.63,0:05:40.70,Default,,0,0,0,,Лулу? Қазір не болды?
Dialogue: 0,0:05:40.80,0:05:41.90,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,0:05:42.37,0:05:43.67,Default,,0,0,0,,Егер сіз үнемі бос жүрсеңіз, сіз бағаны қайталайсыз...
Dialogue: 0,0:05:43.77,0:05:45.51,Default,,0,0,0,,Онда теледидар бар ма?
Dialogue: 0,0:05:45.61,0:05:46.37,Default,,0,0,0,,Ах… Оу
Dialogue: 0,0:05:46.77,0:05:48.61,Default,,0,0,0,,Кешіріңіз, бұл маңызды.
Dialogue: 0,0:05:49.04,0:05:49.74,Default,,0,0,0,,Бес рет қолдануға жеткілікті мөлшерін тазалау үшін бір ай кетеді.
Dialogue: 0,0:05:50.41,0:05:52.95,Default,,0,0,0,,Бір минут күтіңіз. Кешіріңіз. Мынаны маған қарызға бер.
Dialogue: 0,0:05:53.05,0:05:53.78,Default,,0,0,0,,Не?
Dialogue: 0,0:05:54.08,0:05:56.48,Default,,0,0,0,,Жаңалықтар, Синджукуда бірдеңе болып жатыр ма?
Dialogue: 0,0:05:56.58,0:05:58.52,Default,,0,0,0,,Жаңалықтар? Ал...
Dialogue: 0,0:05:58.79,0:06:00.92,Default,,0,0,0,,Тек жол қозғалысын реттеу, басқа ештеңе жоқ.
Dialogue: 0,0:06:01.46,0:06:02.56,Default,,0,0,0,,Реттеудің себебі неде?
Dialogue: 0,0:06:02.66,0:06:04.89,Default,,0,0,0,,Білмеймін, ол ерекше пайда болған жоқ.
Dialogue: 0,0:06:05.43,0:06:06.39,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:06.49,0:06:10.40,Default,,0,0,0,,Сіз бәрі аяқталғаннан кейін әскерге қолайлы түрде есеп беруді жоспарлайсыз ба?
Dialogue: 0,0:06:10.53,0:06:11.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:11.80,0:06:14.90,Default,,0,0,0,,Эй, менің ойымша, сіз тағы бір оғаш құмар ойынын ойнап жатырсыз.
Dialogue: 0,0:06:15.00,0:06:16.94,Default,,0,0,0,,Бұрын айтқанымдай, бұл қауіпті...
Dialogue: 0,0:06:17.04,0:06:18.97,Default,,0,0,0,,Мүмкін сіз, мырза, сөгіс естігенді ұнататын сол қиын мінезді жандардың бірісіз бе?
Dialogue: 0,0:06:19.07,0:06:19.97,Default,,0,0,0,,О, және
Dialogue: 0,0:06:20.11,0:06:23.04,Default,,0,0,0,,Әпкеме үйге кеш келемін деп айт.
Dialogue: 0,0:06:23.98,0:06:27.48,Default,,0,0,0,,Ах! Неге үнемі бір жақты...
Dialogue: 0,0:06:27.58,0:06:30.45,Default,,0,0,0,,Сіз қоңырау шалған телефон нөмірі қазір...
Dialogue: 0,0:06:30.55,0:06:31.95,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:06:33.55,0:06:35.12,Default,,0,0,0,,Ақпарат құпия сақталса -
Dialogue: 0,0:06:35.42,0:06:36.99,Default,,0,0,0,,Арматураны ашық шақыру қиын.
Dialogue: 0,0:06:37.09,0:06:39.69,Default,,0,0,0,,Басқаша айтқанда, бұл тақтадағы жалғыз бөліктер.
Dialogue: 0,0:06:40.13,0:06:44.07,Default,,0,0,0,,Алайда мұндай қоршаудан жалғыз өту қиын.
Dialogue: 0,0:06:44.17,0:06:46.47,Default,,0,0,0,,Қорғаныс іздеу өте қауіпті...
Dialogue: 0,0:06:51.47,0:06:53.88,Default,,0,0,0,,Маған қатысты қарызды қайтарғанымды қалайсыз ба?
Dialogue: 0,0:06:56.04,0:06:56.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:56.88,0:06:58.11,Default,,0,0,0,,Бұл Глазго ма?
Dialogue: 0,0:07:04.72,0:07:06.89,Default,,0,0,0,,… 30
Dialogue: 0,0:07:06.99,0:07:07.76,Default,,0,0,0,,Батыс шығысы
Dialogue: 0,0:07:07.86,0:07:08.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:08.69,0:07:10.86,Default,,0,0,0,,Батыс шығысқа өту үшін темір жолдарды пайдаланыңыз.
Dialogue: 0,0:07:10.96,0:07:13.13,Default,,0,0,0,,Бұл кім? Сіз бұл кодты қайдан білесіз?
Dialogue: 0,0:07:13.59,0:07:16.56,Default,,0,0,0,,Кім екенің маңызды емес, Жеңгің келсе маған сен.
Dialogue: 0,0:07:16.70,0:07:17.47,Default,,0,0,0,,Жеңіс…
Dialogue: 0,0:07:22.87,0:07:24.61,Default,,0,0,0,,Эй, енді не істеуім керек?
Dialogue: 0,0:07:26.51,0:07:28.44,Default,,0,0,0,,Бейшара он бір
Dialogue: 0,0:07:28.54,0:07:31.58,Default,,0,0,0,,Тек қашу сізді аң аулауға мәжбүрлемейтін шығар.
Dialogue: 0,0:07:33.88,0:07:34.58,Default,,0,0,0,,Га
Dialogue: 0,0:07:34.88,0:07:37.02,Default,,0,0,0,,Маған сенетіндіктен, мен сені жеңуге мүмкіндік беремін.
Dialogue: 0,0:07:37.49,0:07:38.59,Default,,0,0,0,,Бұған өтіңіз
Dialogue: 0,0:07:38.69,0:07:39.45,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:07:42.16,0:07:44.09,Default,,0,0,0,,Сіз бұл жұмыс істейді деп ойладыңыз ба?
Dialogue: 0,0:07:44.89,0:07:46.23,Default,,0,0,0,,Мұндай стратегия...
Dialogue: 0,0:07:46.53,0:07:47.90,Default,,0,0,0,,Глазгоға еру керек.
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Иса менің Ием!
Dialogue: 0,0:07:50.10,0:07:50.80,Default,,0,0,0,,Не?
Dialogue: 0,0:07:54.60,0:07:56.24,Default,,0,0,0,,Қандай... өзара шабуыл
Dialogue: 0,0:07:56.54,0:07:57.81,Default,,0,0,0,,Сіз қай бөлімшедесіз? ―
Dialogue: 0,0:07:57.94,0:07:58.87,Default,,0,0,0,,Жаудың бір қолы бар!
Dialogue: 0,0:08:00.14,0:08:01.74,Default,,0,0,0,,Жоқ, террорист.
Dialogue: 0,0:08:04.71,0:08:06.88,Default,,0,0,0,,Ки... Ки... Сен!
Dialogue: 0,0:08:06.98,0:08:08.88,Default,,0,0,0,,Сен барып қарап кел.
Dialogue: 0,0:08:09.02,0:08:10.18,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,0:08:11.22,0:08:11.95,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:13.09,0:08:14.02,Default,,0,0,0,,Уф
Dialogue: 0,0:08:19.63,0:08:23.20,Default,,0,0,0,,Мен құтқарылдым, бірақ мен Сазерлендті қалай аламын...
Dialogue: 0,0:08:23.53,0:08:25.70,Default,,0,0,0,,Иә? Қайда...
Dialogue: 0,0:08:25.97,0:08:29.14,Default,,0,0,0,,Сәлем Карен! Бұрынғы байланыс қандай болды?
Dialogue: 0,0:08:29.24,0:08:30.91,Default,,0,0,0,,Не? Оугиге және басқаларға да?
Dialogue: 0,0:08:31.01,0:08:33.61,Default,,0,0,0,,Ах, Йошида және басқалары жақында келеді...
Dialogue: 0,0:08:33.71,0:08:34.84,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:34.94,0:08:35.91,Default,,0,0,0,,Сіз көшбасшысыз ба?
Dialogue: 0,0:08:36.01,0:08:37.25,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:08:37.88,0:08:40.98,Default,,0,0,0,,Сол жерде тоқтаған пойыздағы жүкті берейік.
Dialogue: 0,0:08:41.08,0:08:42.22,Default,,0,0,0,,Бұл жеңіске жету құралы.
Dialogue: 0,0:08:42.92,0:08:45.89,Default,,0,0,0,,Осыны пайдаланып жеңгіңіз келсе, мені әмірім астына қойыңыз.
Dialogue: 0,0:08:45.99,0:08:47.26,Default,,0,0,0,,Га
Dialogue: 0,0:08:49.26,0:08:50.56,Default,,0,0,0,,Бұл да осында.
Dialogue: 0,0:08:50.66,0:08:51.86,Default,,0,0,0,,Бұл да
Dialogue: 0,0:08:51.96,0:08:53.06,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:08:53.16,0:08:54.80,Default,,0,0,0,,Сіз жай ғана ертегіні тыңдағыңыз келе ме?
Dialogue: 0,0:08:54.96,0:08:57.23,Default,,0,0,0,,Сонымен... қалай?
Dialogue: 0,0:08:57.53,0:08:58.53,Default,,0,0,0,,Глазгодағы әйел
Dialogue: 0,0:08:58.63,0:08:59.60,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:08:59.70,0:09:03.07,Default,,0,0,0,,Сіз қандай болсаңыз, солай қаласыз. Бұл ұшақ бұзылуға жарамды.
Dialogue: 0,0:09:03.17,0:09:04.27,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:09:04.57,0:09:05.71,Default,,0,0,0,,Энергия толтырғыштар туралы не деуге болады?
Dialogue: 0,0:09:05.81,0:09:07.01,Default,,0,0,0,,15
Dialogue: 0,0:09:07.11,0:09:09.18,Default,,0,0,0,,Содан кейін оны жаңа бума ретінде сақтаңыз.
Dialogue: 0,0:09:09.28,0:09:11.58,Default,,0,0,0,,Келесі нұсқаулар 10 минуттан кейін беріледі.
Dialogue: 0,0:09:12.98,0:09:15.82,Default,,0,0,0,,Хмм... таңқаларлықтай шаршатады.
Dialogue: 0,0:09:16.58,0:09:19.65,Default,,0,0,0,,Бірақ оны көру үшін сізге батылдық қажет.
Dialogue: 0,0:09:20.12,0:09:22.99,Default,,0,0,0,,Бұл өз өміріңізге қауіп төндіретін ойын.
Dialogue: 0,0:09:23.96,0:09:25.29,Default,,0,0,0,,Жалпы он бірмен араластыру
Dialogue: 0,0:09:25.59,0:09:28.16,Default,,0,0,0,,Террористер біраз қарсылық көрсетіп жатқан сияқты...
Dialogue: 0,0:09:28.83,0:09:31.70,Default,,0,0,0,,Біздің әскеріміздің басымдылығында ешқандай өзгеріс жоқ.
Dialogue: 0,0:09:31.80,0:09:33.83,Default,,0,0,0,,Әрине, одан да көп.
Dialogue: 0,0:09:33.94,0:09:36.64,Default,,0,0,0,,Мен түсінемін, газ капсуласы...
Dialogue: 0,0:09:36.74,0:09:38.04,Default,,0,0,0,,Шамасы
Dialogue: 0,0:09:38.14,0:09:40.17,Default,,0,0,0,,Иә, ол жалғастырады
Dialogue: 0,0:09:40.27,0:09:43.21,Default,,0,0,0,,Хмм... ол тірі немесе өлі болса да.
Dialogue: 0,0:09:44.05,0:09:46.15,Default,,0,0,0,,Эй, сен өзіңнің жақсы екеніне сенімдісің бе? ―
Dialogue: 0,0:09:46.25,0:09:49.18,Default,,0,0,0,,IFF жойылды, сондықтан жаудың тұзағы болмайды.
Dialogue: 0,0:09:49.62,0:09:52.29,Default,,0,0,0,,Қарсы тарап соғыстың барлық аспектілерінде артықшылыққа ие.
Dialogue: 0,0:09:52.59,0:09:53.75,Default,,0,0,0,,Тұзақтардың қажеті жоқ.
Dialogue: 0,0:09:54.29,0:09:55.86,Default,,0,0,0,,Сіз де көрсетілген нүктелерге өтіңіз...
Dialogue: 0,0:09:55.96,0:09:59.96,Default,,0,0,0,,Ｐ１
Dialogue: 0,0:10:00.83,0:10:01.70,Default,,0,0,0,,Сіз кімсіз? ―
Dialogue: 0,0:10:01.96,0:10:02.93,Default,,0,0,0,,Тек аты
Dialogue: 0,0:10:03.03,0:10:03.80,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:10:04.20,0:10:06.27,Default,,0,0,0,,Егер сіздің хабарламаларыңыз ұсталып қалса, сіз не істер едіңіз?
Dialogue: 0,0:10:06.37,0:10:08.24,Default,,0,0,0,,Егер 1-тоқсан жоспарланғандай өтсе...
Dialogue: 0,0:10:08.34,0:10:11.77,Default,,0,0,0,,Жау Сазерленд 23 секундта сонда болады... мүмкін екі.
Dialogue: 0,0:10:12.04,0:10:13.31,Default,,0,0,0,,Қабырға арқылы ату
Dialogue: 0,0:10:13.87,0:10:15.28,Default,,0,0,0,,Ke! Сен не айтып тұрсың?
Dialogue: 0,0:10:16.34,0:10:18.08,Default,,0,0,0,,Барлығы сіздің қаруыңызды тексереді.
Dialogue: 0,0:10:18.61,0:10:19.88,Default,,0,0,0,,Эй! Шын айтасың ба?
Dialogue: 0,0:10:21.32,0:10:23.18,Default,,0,0,0,,F31 нүктесіндегі жаудың көлеңкесі (үш-бір)
Dialogue: 0,0:10:23.32,0:10:25.75,Default,,0,0,0,,Бұл бұрыс немесе маймылдың даналығы.
Dialogue: 0,0:10:26.15,0:10:27.96,Default,,0,0,0,,Ласлоудың командасы алға қарай жалғастырады.
Dialogue: 0,0:10:28.06,0:10:30.89,Default,,0,0,0,,Евген мен Валериге барып, оларды арттарынан ұрсын.
Dialogue: 0,0:10:31.93,0:10:35.63,Default,,0,0,0,,3.2.1 Ату!
Dialogue: 0,0:10:37.67,0:10:38.67,Default,,0,0,0,,Уф, не!
Dialogue: 0,0:10:43.24,0:10:45.87,Default,,0,0,0,,Сэр Евген мен сэр Валери екеуі де жеңілді
Dialogue: 0,0:10:46.07,0:10:47.81,Default,,0,0,0,,Иә?Ambuscade?
Dialogue: 0,0:10:48.34,0:10:52.35,Default,,0,0,0,,Хехе... Сәйкестендіру сигналдары екі жүзді қылыш.
Dialogue: 0,0:10:52.81,0:10:56.15,Default,,0,0,0,,Ал егер террористер менің нұсқауларымды орындаса...
Dialogue: 0,0:10:56.25,0:10:58.19,Default,,0,0,0,,Шарттар тазартылған сияқты.
Dialogue: 0,0:10:59.22,0:11:02.16,Default,,0,0,0,,P1 P4 (төрт) P7 100 метр оңға жылжу-
Dialogue: 0,0:11:02.26,0:11:04.09,Default,,0,0,0,,Харкенді сағат 3-ке қарай қиғаш етіңіз
Dialogue: 0,0:11:04.36,0:11:06.26,Default,,0,0,0,,Жарайды, мына дауысты орындаңыз!
Dialogue: 0,0:11:06.93,0:11:08.43,Default,,0,0,0,,Басқа таңдау жоқ...
Dialogue: 0,0:11:08.73,0:11:09.86,Default,,0,0,0,,Ｐ５
Dialogue: 0,0:11:09.96,0:11:12.67,Default,,0,0,0,,Уф, мені бұл оғаш атпен атама!
Dialogue: 0,0:11:13.67,0:11:15.27,Default,,0,0,0,,Уф, аһ, екінші тарап бір.
Dialogue: 0,0:11:17.24,0:11:19.14,Default,,0,0,0,,Жаудың көлеңкесі G28-ге (екі сегіз) көшіңіз!
Dialogue: 0,0:11:19.24,0:11:21.81,Default,,0,0,0,,Ласлоудың отрядын бұрыңыз... жоқ, Глаубты бұрыңыз!
Dialogue: 0,0:11:22.38,0:11:25.35,Default,,0,0,0,,Әйтеуір... біздің әскери ұшағымыз террористке айналды
Dialogue: 0,0:11:33.72,0:11:35.46,Default,,0,0,0,,Лорд Глаубтың қашуы Ұшақ жоғалды
Dialogue: 0,0:11:35.76,0:11:38.26,Default,,0,0,0,,Режимді өзгертіңіз!Байланыстар ұсталып жатыр
Dialogue: 0,0:11:38.36,0:11:40.06,Default,,0,0,0,,Мен мұны 4 рет жасадым
Dialogue: 0,0:11:40.16,0:11:41.03,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:11:41.13,0:11:42.93,Default,,0,0,0,,Қандай қателік!
Dialogue: 0,0:11:43.03,0:11:44.43,Default,,0,0,0,,Мен де кешірім сұраймын...
Dialogue: 0,0:11:44.73,0:11:45.80,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:45.90,0:11:47.77,Default,,0,0,0,,Не? жұмыс кезінде
Dialogue: 0,0:11:47.87,0:11:50.70,Default,,0,0,0,,Арнайы жасақтың жетекші қаруының уақыты келді...
Dialogue: 0,0:11:50.84,0:11:52.41,Default,,0,0,0,,Қазір емес!
Dialogue: 0,0:11:53.94,0:11:55.71,Default,,0,0,0,,R2 Анкерлік ұшыру-
Dialogue: 0,0:11:57.04,0:11:58.38,Default,,0,0,0,,Ｂ７ ＵＮ
Dialogue: 0,0:12:00.08,0:12:02.02,Default,,0,0,0,,N тобы алға қарай жалғастырады.
Dialogue: 0,0:12:03.98,0:12:06.75,Default,,0,0,0,,Он бір! Қарғыс атсын!
Dialogue: 0,0:12:07.02,0:12:08.86,Default,,0,0,0,,Ласлоудың реакциясы жоғалып кетті.
Dialogue: 0,0:12:09.06,0:12:11.43,Default,,0,0,0,,Қазір Квинси әскерлерін көтеру уақыты.
Dialogue: 0,0:12:11.73,0:12:13.39,Default,,0,0,0,,Мәртебелі, содан кейін қоршау...
Dialogue: 0,0:12:13.99,0:12:17.30,Default,,0,0,0,,Енді жаудың бес мүмкіндігі бар.
Dialogue: 0,0:12:17.80,0:12:20.47,Default,,0,0,0,,Сіз өткен тесікке қорғаныс күштеріңізді жібере аласыз.
Dialogue: 0,0:12:20.77,0:12:23.27,Default,,0,0,0,,Қазір мұнда бір топ жау бар екені анық.
Dialogue: 0,0:12:27.04,0:12:28.88,Default,,0,0,0,,Олар формацияны бұзады ма?
Dialogue: 0,0:12:29.04,0:12:31.45,Default,,0,0,0,,Не... сен ең ақымақ қадам жасадың.
Dialogue: 0,0:12:32.78,0:12:35.02,Default,,0,0,0,,Ｑ１
Dialogue: 0,0:12:35.12,0:12:38.79,Default,,0,0,0,,Ах, ескі қала, бірақ оны көзбен көрмей-ақ.
Dialogue: 0,0:12:38.89,0:12:39.49,Default,,0,0,0,,Жеткілікті
Dialogue: 0,0:12:39.95,0:12:42.19,Default,,0,0,0,,Жарайды, Елс пен басқалар да кетсін!
Dialogue: 0,0:12:42.46,0:12:43.92,Default,,0,0,0,,№3 тапсырма
Dialogue: 0,0:12:44.06,0:12:46.06,Default,,0,0,0,,Өзіңізді қоршай отырып, күштеріңізді шоғырландырыңыз!
Dialogue: 0,0:12:46.29,0:12:47.36,Default,,0,0,0,,Сіз дайынсыз ба?
Dialogue: 0,0:12:47.80,0:12:50.33,Default,,0,0,0,,Терроршылардың негізгі күштері орталықта
Dialogue: 0,0:12:50.93,0:12:52.07,Default,,0,0,0,,Оны сындырыңыз!
Dialogue: 0,0:12:52.43,0:12:53.20,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:58.07,0:12:59.51,Default,,0,0,0,,Не?Жаулар жоқ
Dialogue: 0,0:13:05.21,0:13:07.11,Default,,0,0,0,,Енді тексеріңіз
Dialogue: 0,0:13:15.92,0:13:16.82,Default,,0,0,0,,Не!
Dialogue: 0,0:13:19.19,0:13:22.26,Default,,0,0,0,,Хахаха... Сенің қолыңнан келеді! ―
Dialogue: 0,0:13:22.90,0:13:26.23,Default,,0,0,0,,Сіз мұны істей аласыз! Сіз жасай аласыз! Британияны жеңу
Dialogue: 0,0:13:28.44,0:13:32.91,Default,,0,0,0,,Кім... Мен кіммен ұрысамын?
Dialogue: 0,0:13:33.04,0:13:35.54,Default,,0,0,0,,Бұл жігіт Тододан жақсы.
Dialogue: 0,0:13:35.94,0:13:36.51,Default,,0,0,0,,Ллойд!
Dialogue: 0,0:13:36.81,0:13:38.11,Default,,0,0,0,,Иә
Dialogue: 0,0:13:38.25,0:13:40.95,Default,,0,0,0,,Біз жеңе аламыз ба?Егер бұл сіздің ойыншығыңыз болса
Dialogue: 0,0:13:41.05,0:13:45.15,Default,,0,0,0,,Мәртебелі, мені Ланселот деп атаңыз.
Dialogue: 0,0:13:50.86,0:13:52.89,Default,,0,0,0,,Басқарылатын қару Z-01 (G Zero One)
Dialogue: 0,0:13:52.99,0:13:55.56,Default,,0,0,0,,Ланселот іске қосылды Ланселот іске қосылды -
Dialogue: 0,0:13:56.26,0:13:57.57,Default,,0,0,0,,Люкті ашу -
Dialogue: 0,0:13:57.87,0:14:00.27,Default,,0,0,0,,Z-01 Ланселот іске қосудың күту режимі
Dialogue: 0,0:14:00.37,0:14:02.24,Default,,0,0,0,,Паллетті айналдыруды бастау
Dialogue: 0,0:14:03.27,0:14:04.04,Default,,0,0,0,,Нұсқаулық туралы не деуге болады?
Dialogue: 0,0:14:04.14,0:14:05.14,Default,,0,0,0,,Шамамен
Dialogue: 0,0:14:05.24,0:14:06.17,Default,,0,0,0,,Күтілгендей-
Dialogue: 0,0:14:06.27,0:14:09.18,Default,,0,0,0,,Бұл тренажер болса да, тек жоғары сыныпта қолжетімді нәрселер бар.
Dialogue: 0,0:14:09.28,0:14:12.15,Default,,0,0,0,,Ум... мен бұрын айтқан нәрсе туралы.
Dialogue: 0,0:14:12.31,0:14:13.88,Default,,0,0,0,,Не? Ах...
Dialogue: 0,0:14:14.08,0:14:16.58,Default,,0,0,0,,Бұл мүмкін, бірақ ықтималдық нөлге жақын.
Dialogue: 0,0:14:16.88,0:14:19.15,Default,,0,0,0,,Бірақ бұл нөл емес, солай емес пе?
Dialogue: 0,0:14:20.99,0:14:24.56,Default,,0,0,0,,Бұл дұрыс, бірақ мен сіздің қисынсыз болғаныңызды қаламаймын.
Dialogue: 0,0:14:24.86,0:14:27.29,Default,,0,0,0,,Жаңа жүйе escape функциясын жояды.
Dialogue: 0,0:14:27.39,0:14:30.30,Default,,0,0,0,,Иә, түсінемін, Сесил мырза.
Dialogue: 0,0:14:33.47,0:14:34.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:34.57,0:14:38.01,Default,,0,0,0,,Иә, біз, Арнайы диспетчерлік басшылықтың техникалық бөлімі...
Dialogue: 0,0:14:38.11,0:14:40.17,Default,,0,0,0,,Ланселот ұшқыш қаруының прототипі
Dialogue: 0,0:14:41.01,0:14:44.35,Default,,0,0,0,,Әлемдегі жалғыз 7-ші буын Nightmare кадры.
Dialogue: 0,0:14:44.51,0:14:48.08,Default,,0,0,0,,Ал, Сузаку-кун, қазір бастапқы іске қосуды бастайық.
Dialogue: 0,0:14:48.25,0:14:51.09,Default,,0,0,0,,Бастапқы іске қосу 20-кезеңнен бастау -
Dialogue: 0,0:14:51.22,0:14:53.05,Default,,0,0,0,,Энергия толтырғышты орнату
Dialogue: 0,0:14:53.15,0:14:55.59,Default,,0,0,0,,Іске қосу алдындағы растау Қуат толтырғышының шығыс рейтингі -
Dialogue: 0,0:14:55.89,0:14:57.89,Default,,0,0,0,,Кернеудің критикалық деңгейіне жету үшін 30 секунд
Dialogue: 0,0:14:58.06,0:14:59.43,Default,,0,0,0,,Негізгі фазалық ауысу Yggdrasil…
Dialogue: 0,0:15:00.06,0:15:01.60,Default,,0,0,0,,Құрылғыны орнату
Dialogue: 0,0:15:01.93,0:15:05.03,Default,,0,0,0,,Құрылғының Z-01 жазбасын растаңыз.
Dialogue: 0,0:15:05.13,0:15:08.04,Default,,0,0,0,,Жеке сәйкестендіру ақпаратын тіркеу аяқталды -
Dialogue: 0,0:15:08.14,0:15:10.20,Default,,0,0,0,,Адам мен машина интерфейсін орнатуды растау -
Dialogue: 0,0:15:10.40,0:15:13.34,Default,,0,0,0,,Yggdrasil резонансын растау қабылдамау реакциясы әлсіз -
Dialogue: 0,0:15:13.51,0:15:15.31,Default,,0,0,0,,Құрылғының кернеу реакциясы әлсіз -
Dialogue: 0,0:15:15.48,0:15:17.21,Default,,0,0,0,,Барлығы рұқсат етілген ауқымда
Dialogue: 0,0:15:17.41,0:15:19.15,Default,,0,0,0,,Осы уақытқа дейін деректер деректерге сәйкес келеді.
Dialogue: 0,0:15:19.25,0:15:20.31,Default,,0,0,0,,Барлық жасыл күй-
Dialogue: 0,0:15:20.41,0:15:21.95,Default,,0,0,0,,Сақтық көшірме…―
Dialogue: 0,0:15:22.05,0:15:23.12,Default,,0,0,0,,Күйді мақұлдау -
Dialogue: 0,0:15:23.22,0:15:25.22,Default,,0,0,0,,Екінші қайта растау аяқталды
Dialogue: 0,0:15:33.23,0:15:35.66,Default,,0,0,0,,Ланселот ME Boost
Dialogue: 0,0:15:37.63,0:15:40.23,Default,,0,0,0,,Ланселот ұшады!
Dialogue: 0,0:15:43.64,0:15:46.51,Default,,0,0,0,,Хахаха! Кенеттен толық дроссель болды ма?
Dialogue: 0,0:15:48.64,0:15:50.24,Default,,0,0,0,,Нұсқаулықтан да артық.
Dialogue: 0,0:15:50.34,0:15:51.98,Default,,0,0,0,,Бұл болса... уф уф
Dialogue: 0,0:15:52.11,0:15:53.65,Default,,0,0,0,,А? Бұл не?
Dialogue: 0,0:15:54.25,0:15:55.42,Default,,0,0,0,,Сазерленд жасайық...
Dialogue: 0,0:15:57.65,0:16:01.72,Default,,0,0,0,,Хаха... Тағы бір итеру бақылау пунктін бұзады.
Dialogue: 0,0:16:02.02,0:16:04.26,Default,,0,0,0,,Бұл В тобы. Қарсыластың көлеңкесін тексеріңіз.
Dialogue: 0,0:16:04.36,0:16:08.03,Default,,0,0,0,,Иә? Күшейткіштер? Шынайы шайқас басқаша.
Dialogue: 0,0:16:08.13,0:16:08.66,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:16:09.23,0:16:10.33,Default,,0,0,0,,Барлығы қашып құтылса да...
Dialogue: 0,0:16:10.43,0:16:12.03,Default,,0,0,0,,Төрт ұшақ әп-сәтте бірге ұшты...
Dialogue: 0,0:16:12.13,0:16:13.03,Default,,0,0,0,,Қанша жау бар?
Dialogue: 0,0:16:13.13,0:16:14.17,Default,,0,0,0,,１ １
Dialogue: 0,0:16:14.17,0:16:14.47,Default,,0,0,0,,１ １
Dialogue: 0,0:16:14.17,0:16:14.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:14.47,0:16:14.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:14.57,0:16:15.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:14.57,0:16:15.10,Default,,0,0,0,,Бұл жаңа үлгі емес пе? ―
Dialogue: 0,0:16:15.10,0:16:15.74,Default,,0,0,0,,Бұл жаңа үлгі емес пе? ―
Dialogue: 0,0:16:16.04,0:16:18.57,Default,,0,0,0,,Мұндай түрді бірінші рет көруім... Уау!
Dialogue: 0,0:16:18.67,0:16:19.64,Default,,0,0,0,,500 метр радиустағы тұрғындар да көшірілді.
Dialogue: 0,0:16:28.65,0:16:29.52,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:16:32.22,0:16:33.75,Default,,0,0,0,,Не?Сіз тірі оқпен ойнайсыз ба?
Dialogue: 0,0:16:34.05,0:16:35.39,Default,,0,0,0,,А, мен не істеуім керек...
Dialogue: 0,0:16:35.49,0:16:37.42,Default,,0,0,0,,Ишида! Уау...
Dialogue: 0,0:16:37.52,0:16:39.39,Default,,0,0,0,,Ол пайдасыз террорист.
Dialogue: 0,0:16:40.03,0:16:42.56,Default,,0,0,0,,Егер сіз оны бір ғана бірлікпен итерсеңіз...
Dialogue: 0,0:16:45.67,0:16:46.40,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:51.14,0:16:52.34,Default,,0,0,0,,Жарайды, мен істей аламын.
Dialogue: 0,0:16:52.44,0:16:54.21,Default,,0,0,0,,Осы Ланселотпен... бірден!
Dialogue: 0,0:16:54.61,0:16:56.61,Default,,0,0,0,,N4 N5 Тоқта...
Dialogue: 0,0:16:56.71,0:16:58.41,Default,,0,0,0,,Келесі жасақтар келгенде, оларды қоршаңыз.
Dialogue: 0,0:16:58.51,0:16:59.21,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:05.32,0:17:07.19,Default,,0,0,0,,Мен оны тоқтата алмаймын!
Dialogue: 0,0:17:10.19,0:17:11.23,Default,,0,0,0,,500 метр радиустағы тұрғындар да көшірілді.
Dialogue: 0,0:17:11.32,0:17:12.79,Default,,0,0,0,,(Радиодыбыс)
Dialogue: 0,0:17:13.09,0:17:15.43,Default,,0,0,0,,Не? не болып жатыр
Dialogue: 0,0:17:15.60,0:17:17.16,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:17:17.26,0:17:20.23,Default,,0,0,0,,Мен ағама қажетсіз қарыз болдым.
Dialogue: 0,0:17:20.47,0:17:21.57,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:17:25.61,0:17:26.41,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:17:28.34,0:17:29.68,Default,,0,0,0,,P1 Не болды? ―
Dialogue: 0,0:17:30.48,0:17:33.38,Default,,0,0,0,,Расында бір ғана жау бар ма?
Dialogue: 0,0:17:36.38,0:17:38.22,Default,,0,0,0,,Бұл сан күткеннен жоғары.
Dialogue: 0,0:17:38.32,0:17:41.79,Default,,0,0,0,,О, және ол бұл туралы байыпты, солай емес пе?
Dialogue: 0,0:17:46.46,0:17:50.06,Default,,0,0,0,,Егер мен түнгі түндердің бәрін тоқтатсам, шайқас аяқталады.
Dialogue: 0,0:17:50.16,0:17:52.77,Default,,0,0,0,,Мен Лелуш пен сол баланы не болса да құтқаруым керек.
Dialogue: 0,0:17:53.57,0:17:54.37,Default,,0,0,0,,Ах
Dialogue: 0,0:17:58.81,0:17:59.51,Default,,0,0,0,,Ах
Dialogue: 0,0:18:03.51,0:18:05.38,Default,,0,0,0,,Эй, менің стратегиямды айт!
Dialogue: 0,0:18:08.45,0:18:09.65,Default,,0,0,0,,Сіз командирсіз, солай ма?
Dialogue: 0,0:18:11.52,0:18:13.75,Default,,0,0,0,,Тек ұшқыш жақсы!
Dialogue: 0,0:18:18.66,0:18:20.66,Default,,0,0,0,,Бұл жерде қашудан басқа амалымыз жоқ.
Dialogue: 0,0:18:25.33,0:18:26.27,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:30.27,0:18:32.27,Default,,0,0,0,,Ей, мен саған қайтарамын! (Лелух) Ах
Dialogue: 0,0:18:33.37,0:18:33.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:36.54,0:18:37.41,Default,,0,0,0,,Осы уақытқа дейін?
Dialogue: 0,0:18:43.78,0:18:47.19,Default,,0,0,0,,Мен үйренуім керек. Адамдар нақты шайқастың кілті ме?
Dialogue: 0,0:18:47.29,0:18:48.16,Default,,0,0,0,,Ах
Dialogue: 0,0:18:58.30,0:18:59.73,Default,,0,0,0,,Бұл не құбыжық?
Dialogue: 0,0:19:02.14,0:19:04.64,Default,,0,0,0,,Бұл жігіт ... залалды қажетсіз көбейту.
Dialogue: 0,0:19:04.74,0:19:05.91,Default,,0,0,0,,Ах
Dialogue: 0,0:19:06.21,0:19:07.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:13.35,0:19:15.58,Default,,0,0,0,,Ұрыс кезінде біреуге көмектесу деген нені білдіреді?
Dialogue: 0,0:19:15.68,0:19:20.49,Default,,0,0,0,,Хмф, мен сізге қанша қаласаңыз, сонша тактикалық жеңістер беремін, бірақ
Dialogue: 0,0:19:24.32,0:19:25.89,Default,,0,0,0,,Иә?Адамдарға көмектесу?
Dialogue: 0,0:19:26.19,0:19:27.69,Default,,0,0,0,,ұқсайды
Dialogue: 0,0:19:27.79,0:19:30.50,Default,,0,0,0,,Хмм, бұл біртүрлі.
Dialogue: 0,0:19:30.63,0:19:31.87,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:19:33.20,0:19:33.77,Default,,0,0,0,,Бұл жаңа топ па әлде бірдеңе ме?
Dialogue: 0,0:19:34.20,0:19:34.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:35.20,0:19:36.20,Default,,0,0,0,,Сузаку-кун
Dialogue: 0,0:19:36.47,0:19:38.64,Default,,0,0,0,,Шаршадыңыз ба? Оны тезірек аяқтаймыз ба?
Dialogue: 0,0:19:39.24,0:19:41.71,Default,,0,0,0,,Жоқ, мен істеймін, рұқсат етіңізші.
Dialogue: 0,0:19:41.88,0:19:44.28,Default,,0,0,0,,Жұмыс уақытына абай болыңыз~
Dialogue: 0,0:19:44.38,0:19:45.55,Default,,0,0,0,,Иә
Dialogue: 0,0:19:45.65,0:19:48.62,Default,,0,0,0,,Ол ең жақсы бөлік...
Dialogue: 0,0:19:49.62,0:19:51.55,Default,,0,0,0,,ＩＤ
Dialogue: 0,0:19:51.92,0:19:54.25,Default,,0,0,0,,Міне, Мәртебелі Хловис қонып жатыр.
Dialogue: 0,0:19:54.35,0:19:57.82,Default,,0,0,0,,Тексеру ақыры жоспарланғандай өтті.
Dialogue: 0,0:19:57.93,0:19:58.66,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:19:58.76,0:20:01.33,Default,,0,0,0,,А, мен сенің осы жерден өткеніңді қалаймын.
Dialogue: 0,0:20:02.33,0:20:03.76,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,0:20:05.47,0:20:08.67,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:20:08.77,0:20:09.64,Default,,0,0,0,,Карен
Dialogue: 0,0:20:09.84,0:20:12.61,Default,,0,0,0,,Бұл сіз Британияға қарсы шыққаныңыз үшін.
Dialogue: 0,0:20:12.71,0:20:15.38,Default,,0,0,0,,Не? Қарсылық көрсетуге батылы жетпеген адам
Dialogue: 0,0:20:15.54,0:20:17.54,Default,,0,0,0,,Қанша адам өлді деп ойлайсың?
Dialogue: 0,0:20:17.64,0:20:20.95,Default,,0,0,0,,Шулы!Осы жерде де көп ұсталып өлтірілдім...
Dialogue: 0,0:20:21.25,0:20:22.72,Default,,0,0,0,,Жылама!
Dialogue: 0,0:20:22.82,0:20:24.85,Default,,0,0,0,,Оги-сан, бұл дауыс...
Dialogue: 0,0:20:25.49,0:20:26.62,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:20:26.72,0:20:28.79,Default,,0,0,0,,Ол менің қоңырауыма жауап бермеді, мен өлген болуым мүмкін.
Dialogue: 0,0:20:29.92,0:20:31.56,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:20:31.66,0:20:32.43,Default,,0,0,0,,Га
Dialogue: 0,0:20:32.63,0:20:33.53,Default,,0,0,0,,Ах
Dialogue: 0,0:20:33.63,0:20:34.56,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:20:34.66,0:20:36.50,Default,,0,0,0,,Мен түсінбейтін адамның соңынан ергенім жөн.
Dialogue: 0,0:20:36.60,0:20:38.33,Default,,0,0,0,,Олар улы газды қолдануы керек еді.
Dialogue: 0,0:20:38.43,0:20:39.40,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:20:39.50,0:20:40.70,Default,,0,0,0,,Нагата сен ақымақ!
Dialogue: 0,0:20:43.37,0:20:45.24,Default,,0,0,0,,Сіз осындай жерге қашып кеттіңіз бе?
Dialogue: 0,0:20:45.34,0:20:46.77,Default,,0,0,0,,Он бір
Dialogue: 0,0:20:46.94,0:20:48.54,Default,,0,0,0,,Түсіру әдісі Дайындық
Dialogue: 0,0:20:48.78,0:20:49.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:51.31,0:20:51.98,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:20:52.65,0:20:54.48,Default,,0,0,0,,Ату... А?
Dialogue: 0,0:20:52.65,0:20:54.48,Default,,0,0,0,,Барлық әскерлерге хабарландыру!
Dialogue: 0,0:20:54.58,0:20:56.25,Default,,0,0,0,,Тез арада атысты тоқтату!
Dialogue: 0,0:20:56.48,0:20:56.98,Default,,0,0,0,,Ах
Dialogue: 0,0:20:57.42,0:20:58.29,Default,,0,0,0,,Татуласу?
Dialogue: 0,0:20:58.45,0:21:01.49,Default,,0,0,0,,11-аймақ губернаторы және үшінші князь.
Dialogue: 0,0:21:01.59,0:21:04.32,Default,,0,0,0,,Мен сізге Кловис Ла Британия атынан бұйрық беремін.
Dialogue: 0,0:21:04.83,0:21:06.96,Default,,0,0,0,,Барлық күштер, атысты дереу тоқтатыңыз.
Dialogue: 0,0:21:07.69,0:21:10.73,Default,,0,0,0,,Ғимараттарға қарсы деструктивті әрекеттерді тоқтату және т.б.
Dialogue: 0,0:21:10.83,0:21:15.30,Default,,0,0,0,,Зардап шеккендер британдықтар, он бірге қарамастан, оларды құтқарыңыз.
Dialogue: 0,0:21:15.40,0:21:17.70,Default,,0,0,0,,Мен сізге Кловис Ла Британия атынан бұйрық беремін.
Dialogue: 0,0:21:18.31,0:21:22.68,Default,,0,0,0,,Тез арада атысты тоқтату. Бұдан әрі ұрысқа жол берілмейді.
Dialogue: 0,0:21:23.81,0:21:24.98,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:21:25.28,0:21:26.98,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:21:27.28,0:21:32.05,Default,,0,0,0,,Енді не болады?Ән айтқыңыз келе ме?Немесе тіпті шахмат серіктесі ме?
Dialogue: 0,0:21:32.35,0:21:33.75,Default,,0,0,0,,Соншалықты ностальгиялық...
Dialogue: 0,0:21:33.92,0:21:34.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:37.76,0:21:41.70,Default,,0,0,0,,Екеуміздің бірге шахмат ойнағанымыз есіңде жоқ па?
Dialogue: 0,0:21:41.80,0:21:43.76,Default,,0,0,0,,Мен әрқашан жеңдім.
Dialogue: 0,0:21:43.86,0:21:44.93,Default,,0,0,0,,Не?
Dialogue: 0,0:21:45.03,0:21:47.70,Default,,0,0,0,,Қараңызшы, Овен сарайында.
Dialogue: 0,0:21:47.87,0:21:50.67,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:21:51.04,0:21:53.34,Default,,0,0,0,,Біраз уақыт болды, ағайын.
Dialogue: 0,0:21:53.71,0:21:54.47,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:54.74,0:21:57.44,Default,,0,0,0,,Марқұм императрица Марианна - балалардың үлкені.
Dialogue: 0,0:21:57.54,0:22:02.08,Default,,0,0,0,,Мен Лелух ви Британиямын, тағының 17-ші мұрагерімін.
Dialogue: 0,0:22:02.38,0:22:04.65,Default,,0,0,0,,Лелуч... Бірақ сен...
Dialogue: 0,0:22:04.75,0:22:07.02,Default,,0,0,0,,Өлу керек пе еді...?
Dialogue: 0,0:22:07.49,0:22:09.99,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:22:11.46,0:22:14.36,Default,,0,0,0,,Мен қайтып келдім, Мәртебелі.
Dialogue: 0,0:22:15.33,0:22:17.63,Default,,0,0,0,,Барлығын өзгерту
Dialogue: 0,0:22:17.73,0:22:21.40,Default,,0,0,0,,♪～
Dialogue: 0,0:22:21.50,0:22:25.04,Default,,0,0,0,,♪Мен жаяу жүрмін, бірақ мен арыстан мен жолбарыстың арылдаған жолмен жүріп келемін
Dialogue: 0,0:22:25.34,0:22:28.91,Default,,0,0,0,,♪Қызыл аспанның арғы жағында, Махороба
Dialogue: 0,0:22:29.01,0:22:32.71,Default,,0,0,0,,♪Тұтқынның оңашалығында қаңғыған жас
Dialogue: 0,0:22:32.81,0:22:36.55,Default,,0,0,0,,♪Әлсіздік пен ашу көзге көрінбейтін жау ма?
Dialogue: 0,0:22:36.65,0:22:42.02,Default,,0,0,0,,♪Әке, мен өзімді әлі білмеймін.
Dialogue: 0,0:22:44.06,0:22:48.10,Default,,0,0,0,,♪Алдыңғы ағайындар
Dialogue: 0,0:22:48.40,0:22:51.80,Default,,0,0,0,,♪Көрінбейтін арқаңа ерсең
Dialogue: 0,0:22:51.90,0:22:58.87,Default,,0,0,0,,♪Таң жұлдызы сізді адасқан түнге шақырады
Dialogue: 0,0:22:59.54,0:23:02.98,Default,,0,0,0,,♪Өліммен бітпейді
Dialogue: 0,0:23:03.08,0:23:06.78,Default,,0,0,0,,♪Арманымды аңсасам да
Dialogue: 0,0:23:06.88,0:23:10.62,Default,,0,0,0,,♪Сіз сенімді адамсыз
Dialogue: 0,0:23:10.72,0:23:14.59,Default,,0,0,0,,♪Менің өмірім
Dialogue: 0,0:23:14.69,0:23:18.49,Default,,0,0,0,,♪Қатты жел айдалада, Көбелектер мен гүлдермен өмір сүремін.
Dialogue: 0,0:23:18.59,0:23:22.16,Default,,0,0,0,,♪Мәңгілік көктемде гүлдеген дәмді елес
Dialogue: 0,0:23:22.46,0:23:26.00,Default,,0,0,0,,♪Бұл дененің лас болса да лайдың тазалығы
Dialogue: 0,0:23:26.10,0:23:29.87,Default,,0,0,0,,♪Жүрегіңіздің сырына сеніңіз
Dialogue: 0,0:23:29.97,0:23:35.58,Default,,0,0,0,,♪Көз жасымды көрсетпесем де, анашым
Dialogue: 0,0:23:35.74,0:23:40.41,Default,,0,0,0,,♪Аяғымның астындағы шөпте
Dialogue: 0,0:23:40.51,0:23:45.85,Default,,0,0,0,,♪Шық ешқашан кетпейді
Dialogue: 0,0:23:51.09,0:23:52.83,Default,,0,0,0,,Мен бұл мүмкін емес деп ойладым.
Dialogue: 0,0:23:52.93,0:23:55.63,Default,,0,0,0,,Жай студент әлемді қалай басқара алады?
Dialogue: 0,0:23:55.93,0:23:57.56,Default,,0,0,0,,Шынайы емес.
Dialogue: 0,0:23:57.66,0:23:59.83,Default,,0,0,0,,Ойлан, сонда түсінесің.
Dialogue: 0,0:23:59.93,0:24:02.97,Default,,0,0,0,,Бірақ мүмкіндік болса...
Dialogue: 0,0:24:03.87,0:24:07.84,Default,,0,0,0,,Мүмкін мен таңдау керек шығар...
Dialogue: 0,0:24:09.34,0:24:15.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory