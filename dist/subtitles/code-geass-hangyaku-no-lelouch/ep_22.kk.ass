Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.76,0:00:05.13,Default,,0,0,0,,Арнайы әкімшілік аймақ Жапония
Dialogue: 0,0:00:05.23,0:00:08.67,Default,,0,0,0,,Корольдік Мәртебелі ханшайым Эфемия туралы жаман қауесеттер бар...
Dialogue: 0,0:00:09.10,0:00:10.57,Default,,0,0,0,,Бұл Каминеджима туралы, солай ма? ―
Dialogue: 0,0:00:10.67,0:00:12.57,Default,,0,0,0,,Ол Нөлмен байланыста болды...
Dialogue: 0,0:00:12.67,0:00:15.41,Default,,0,0,0,,Олар жоғарғы деңгейде қосылған болуы мүмкін бе?
Dialogue: 0,0:00:15.61,0:00:16.71,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:00:17.01,0:00:19.41,Default,,0,0,0,,Сұрақты тек губернатор қойған жоқ.
Dialogue: 0,0:00:19.51,0:00:22.15,Default,,0,0,0,,Қалай болғанда да, ол жермен қарым-қатынас...
Dialogue: 0,0:00:22.25,0:00:24.12,Default,,0,0,0,,А, мен оны кесіп тастауым керек.
Dialogue: 0,0:00:24.22,0:00:25.29,Default,,0,0,0,,Тым кеш болды.
Dialogue: 0,0:00:25.39,0:00:26.55,Default,,0,0,0,,Ах! (Кеңесші) Әй... Әй!
Dialogue: 0,0:00:26.72,0:00:29.62,Default,,0,0,0,,Бізде барлық дәлелдер бар, Тұрақты хатшы.
Dialogue: 0,0:00:29.72,0:00:32.13,Default,,0,0,0,,NAC табысы
Dialogue: 0,0:00:32.23,0:00:34.30,Default,,0,0,0,,Рақмет сізге, генерал Далтон.
Dialogue: 0,0:00:35.10,0:00:35.76,Default,,0,0,0,,Енді...
Dialogue: 0,0:00:36.77,0:00:38.57,Default,,0,0,0,,Енді бізде Мәртебелі Хловис келді...
Dialogue: 0,0:00:38.67,0:00:41.80,Default,,0,0,0,,Сізді аңдыған адамдарды тазарта аласыз.
Dialogue: 0,0:00:42.10,0:00:43.20,Default,,0,0,0,,Хэхехе…―
Dialogue: 0,0:00:43.64,0:00:46.57,Default,,0,0,0,,Императорлық Мәртебелі ханшайым Эфемияның ерекше аймақ тұжырымдамасы-
Dialogue: 0,0:00:46.67,0:00:50.51,Default,,0,0,0,,Мен ойлағаннан да үрейленген егеуқұйрықтар көп болды.
Dialogue: 0,0:00:54.72,0:00:58.42,Default,,0,0,0,,Жапонияда 200 000-нан астам адам арнайы аймақтарға өтініш берді.
Dialogue: 0,0:00:58.52,0:01:00.56,Default,,0,0,0,,Егер ол осылай көрінсе, ол одан әрі арта береді.
Dialogue: 0,0:01:00.76,0:01:02.12,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:01:02.22,0:01:03.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:03.19,0:01:05.79,Default,,0,0,0,,Сіз жапон халқының өкілі болғандықтан...
Dialogue: 0,0:01:06.23,0:01:08.76,Default,,0,0,0,,Бұған сенуге болады.
Dialogue: 0,0:01:09.06,0:01:10.10,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:10.20,0:01:13.40,Default,,0,0,0,,Оның Король Мәртебелі, бәлкім, өзінің мәлімдемесіне байланысты.
Dialogue: 0,0:01:13.50,0:01:15.84,Default,,0,0,0,,Мен оны шынымен бағалаймын...
Dialogue: 0,0:01:16.30,0:01:18.27,Default,,0,0,0,,Бұл менмін...
Dialogue: 0,0:01:19.07,0:01:21.48,Default,,0,0,0,,Маған көптеген жолдармен көмектесуді жалғастырыңыз.
Dialogue: 0,0:01:21.71,0:01:23.31,Default,,0,0,0,,Иә, сен... (Эфемия) Қазірдің өзінде...
Dialogue: 0,0:01:23.41,0:01:25.48,Default,,0,0,0,,А... иә
Dialogue: 0,0:01:26.28,0:01:27.42,Default,,0,0,0,,Уау
Dialogue: 0,0:01:27.48,0:01:33.49,Default,,0,0,0,,♪～
Dialogue: 0,0:01:35.39,0:01:39.23,Default,,0,0,0,,♪Мен көрген түс
Dialogue: 0,0:01:39.33,0:01:43.13,Default,,0,0,0,,♪Шексіз және алыс
Dialogue: 0,0:01:43.23,0:01:49.57,Default,,0,0,0,,♪Құрғақ күндерде көк аспан, Қолымда
Dialogue: 0,0:01:51.17,0:01:54.64,Default,,0,0,0,,♪Дыбыстағы біркелкі сынама және қателік
Dialogue: 0,0:01:54.74,0:02:00.15,Default,,0,0,0,,♪Уақытсыз және интервалсыз кеңістік
Dialogue: 0,0:02:01.62,0:02:03.85,Default,,0,0,0,,♪Өмірлік өлшем шу шығарады
Dialogue: 0,0:02:04.15,0:02:06.69,Default,,0,0,0,,♪Мен өз бетімді жасаймын
Dialogue: 0,0:02:06.79,0:02:10.22,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:02:10.79,0:02:14.70,Default,,0,0,0,,♪Менің қолыма түсті
Dialogue: 0,0:02:14.80,0:02:18.57,Default,,0,0,0,,♪Шіріген алма
Dialogue: 0,0:02:18.67,0:02:22.60,Default,,0,0,0,,♪Айнада бейнеленген
Dialogue: 0,0:02:22.70,0:02:26.57,Default,,0,0,0,,♪Біздің арғы жағымызға
Dialogue: 0,0:02:26.67,0:02:30.38,Default,,0,0,0,,♪Дистанциялық сезім Адамдар арасындағы сынақ пен қателік
Dialogue: 0,0:02:30.48,0:02:35.55,Default,,0,0,0,,♪Уақыт пен сезімсіз кеңістік
Dialogue: 0,0:02:37.29,0:02:39.55,Default,,0,0,0,,♪Бас пен дене тырнақтарын жоғары көтеріп тұру
Dialogue: 0,0:02:39.65,0:02:42.49,Default,,0,0,0,,♪Бетімді қырып алайын деп жатырмын
Dialogue: 0,0:02:42.59,0:02:48.30,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:02:49.80,0:02:56.80,Default,,0,0,0,,♪-Қашықтық сезімі
Dialogue: 0,0:03:03.95,0:03:06.45,Default,,0,0,0,,Бұл Британияның бірінші әрекеті болады.
Dialogue: 0,0:03:06.51,0:03:08.22,Default,,0,0,0,,Бұл арнайы әкімшілік аймақ Жапония болып табылады-
Dialogue: 0,0:03:08.32,0:03:11.65,Default,,0,0,0,,Бұл Мәртебелі ханшайым Эфемияның жеке идеясы болды.
Dialogue: 0,0:03:11.75,0:03:13.59,Default,,0,0,0,,Романның идеясы –
Dialogue: 0,0:03:13.69,0:03:17.29,Default,,0,0,0,,Бұл жоғары мәртебелі мырзаның соңғы уақытқа дейін студент болғанына қатысы жоқ сияқты.
Dialogue: 0,0:03:17.39,0:03:20.73,Default,,0,0,0,,Өйткені Ефемия-сама осылай деді, мен де солаймын...
Dialogue: 0,0:03:21.63,0:03:25.30,Default,,0,0,0,,Ертеңгі рәсім бүкіл әлемге таратылады.
Dialogue: 0,0:03:25.43,0:03:27.47,Default,,0,0,0,,Бұл үлкен мәселе, Юффи...
Dialogue: 0,0:03:27.57,0:03:31.87,Default,,0,0,0,,Осымен 11-аймақтағы террористік ұйым халықтың қолдауынан айырылып, күйреді.
Dialogue: 0,0:03:31.97,0:03:33.37,Default,,0,0,0,,Қауіпсіздік те тұрақтандырылады.
Dialogue: 0,0:03:33.64,0:03:35.48,Default,,0,0,0,,Өз басым бұған қарсымын.
Dialogue: 0,0:03:35.58,0:03:37.78,Default,,0,0,0,,Бірақ сіз де білетіндіктен...
Dialogue: 0,0:03:37.88,0:03:40.25,Default,,0,0,0,,Сіз Далтонды көмекші ретінде жалдадыңыз, солай ма?
Dialogue: 0,0:03:40.35,0:03:42.78,Default,,0,0,0,,Үлкен саясатты қалпына келтіру
Dialogue: 0,0:03:42.88,0:03:44.79,Default,,0,0,0,,Бұл губернатордың табиғи әрекеті.
Dialogue: 0,0:03:45.22,0:03:46.29,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:46.62,0:03:50.29,Default,,0,0,0,,Ол Юффидің болашағын қарапайым адам ретінде қабылдағаны үшін бе?
Dialogue: 0,0:03:50.43,0:03:51.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:52.66,0:03:55.36,Default,,0,0,0,,Жапонияның арнайы аймағы… Бұл жаман оқиға емес.
Dialogue: 0,0:03:55.46,0:03:58.97,Default,,0,0,0,,Жапонияда бізге берілген құндылық бар ма?
Dialogue: 0,0:03:59.27,0:04:01.60,Default,,0,0,0,,Бұл жеңілдікке не себеп болды?
Dialogue: 0,0:04:01.70,0:04:03.91,Default,,0,0,0,,Бұл біздің қарсылығымыздың нәтижесі.
Dialogue: 0,0:04:04.01,0:04:05.34,Default,,0,0,0,,Ұят болма
Dialogue: 0,0:04:05.51,0:04:06.87,Default,,0,0,0,,Кирихара мырза -
Dialogue: 0,0:04:06.98,0:04:08.98,Default,,0,0,0,,Сакурадит өндірумен айналысасыз ба?
Dialogue: 0,0:04:09.28,0:04:12.48,Default,,0,0,0,,Сізге арнайы аймақта қызметке уәде етілгенін естідім?
Dialogue: 0,0:04:12.58,0:04:16.25,Default,,0,0,0,,Ешқандай болжам жоқ, тек рәсімге қатысу туралы өтініш
Dialogue: 0,0:04:16.35,0:04:17.85,Default,,0,0,0,,Жақсы сылтау
Dialogue: 0,0:04:17.95,0:04:18.92,Default,,0,0,0,,Лорд және басқалар…
Dialogue: 0,0:04:18.99,0:04:20.32,Default,,0,0,0,,) Нөл туралы не деуге болады?
Dialogue: 0,0:04:20.72,0:04:22.82,Default,,0,0,0,,Қара рыцарлармен не болады?
Dialogue: 0,0:04:24.63,0:04:27.50,Default,,0,0,0,,Жағдай күрделі және тек қолдаушылар үшін ғана емес.
Dialogue: 0,0:04:28.26,0:04:31.37,Default,,0,0,0,,Кейбір мүшелер арнайы аймаққа қосылуда.
Dialogue: 0,0:04:31.50,0:04:33.37,Default,,0,0,0,,Қара рыцарлардан айырмашылығы
Dialogue: 0,0:04:33.47,0:04:35.67,Default,,0,0,0,,Жапонияда ерекше аймақ ретінде қауіп жоқ.
Dialogue: 0,0:04:35.74,0:04:38.44,Default,,0,0,0,,Және құрметті ханшайыммен.
Dialogue: 0,0:04:38.54,0:04:40.58,Default,,0,0,0,,Бетперде киген белгісіз адам
Dialogue: 0,0:04:40.68,0:04:42.98,Default,,0,0,0,,Қалай қарасаңыз да, ол осылай жақсырақ көрінеді.
Dialogue: 0,0:04:43.44,0:04:45.68,Default,,0,0,0,,Киото басқа тараппен де ынтымақтасады деп айтылады.
Dialogue: 0,0:04:45.78,0:04:46.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:46.95,0:04:48.82,Default,,0,0,0,,Бұл теңдік деп айтуыңыз мүмкін.
Dialogue: 0,0:04:48.95,0:04:51.72,Default,,0,0,0,,Тек айта отырып, теңдікке сенуге болмайды!
Dialogue: 0,0:04:51.82,0:04:53.42,Default,,0,0,0,,Келісемін Ах...
Dialogue: 0,0:04:53.62,0:04:56.72,Default,,0,0,0,,Бірақ қазір біз тез арада жауап беруіміз керек.
Dialogue: 0,0:04:57.59,0:04:59.56,Default,,0,0,0,,) Арнайы аймаққа қатысқыңыз келе ме?
Dialogue: 0,0:04:59.66,0:05:00.66,Default,,0,0,0,,Сол жерде...
Dialogue: 0,0:05:00.76,0:05:04.47,Default,,0,0,0,,Britannia және Eleven шектеулері маңызды емес.
Dialogue: 0,0:05:04.60,0:05:05.50,Default,,0,0,0,,Эй, Леон, қарашы.
Dialogue: 0,0:05:05.97,0:05:07.80,Default,,0,0,0,,Эфемия ұсынғандай -
Dialogue: 0,0:05:07.90,0:05:10.34,Default,,0,0,0,,Бүкіл Қара рыцарьлар қатысуы мүмкін емес пе?
Dialogue: 0,0:05:10.64,0:05:12.81,Default,,0,0,0,,Сонымен, Британияның уәдесі...
Dialogue: 0,0:05:12.91,0:05:14.64,Default,,0,0,0,,Нөл не айтып жатыр және
Dialogue: 0,0:05:14.74,0:05:16.94,Default,,0,0,0,,Арнайы аймаққа қатысу қайшы емес, солай емес пе?
Dialogue: 0,0:05:17.55,0:05:19.95,Default,,0,0,0,,Бірақ бұл... (Чиба Нагиса) Біріншіден, бейбітшілік үшін.
Dialogue: 0,0:05:20.05,0:05:21.68,Default,,0,0,0,,Сізді қарусыздандыруға рұқсат етпеңіз
Dialogue: 0,0:05:21.82,0:05:23.52,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:05:23.62,0:05:26.92,Default,,0,0,0,,Жүйеге сіңіп, тәуелсіздігімізден айырылдық.
Dialogue: 0,0:05:27.02,0:05:28.69,Default,,0,0,0,,Бірақ егер сіз қатыспасаңыз
Dialogue: 0,0:05:28.79,0:05:30.66,Default,,0,0,0,,Бостандық пен теңдіктің жауы болу
Dialogue: 0,0:05:30.76,0:05:32.36,Default,,0,0,0,,Содан кейін алдымен қосылыңыз...
Dialogue: 0,0:05:32.46,0:05:34.00,Default,,0,0,0,,Кепілдіксіз бе?
Dialogue: 0,0:05:34.40,0:05:36.06,Default,,0,0,0,,Бірақ оны елемеуге болмайды!
Dialogue: 0,0:05:37.87,0:05:40.33,Default,,0,0,0,,Өкініштісі, мен айналма жолмен жүруге тура келді.
Dialogue: 0,0:05:40.44,0:05:42.70,Default,,0,0,0,,Мен одан дүкенге баруын өтіндім...
Dialogue: 0,0:05:42.80,0:05:44.97,Default,,0,0,0,,Мен сіздің Ширлимен кездесіп жатқаныңызды естідім.
Dialogue: 0,0:05:45.37,0:05:47.61,Default,,0,0,0,,Қарсы жақ бәрібір сатып алатын шығар.
Dialogue: 0,0:05:47.71,0:05:50.68,Default,,0,0,0,,Арнайы әкімшілік аймақтың басталуына байланысты тым көп шу бар.
Dialogue: 0,0:05:50.91,0:05:51.81,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:05:51.91,0:05:54.88,Default,,0,0,0,,Маған Ширлимен тезірек татуласу керек.
Dialogue: 0,0:05:54.98,0:05:56.52,Default,,0,0,0,,Арнайы әкімшілік аудан дегеніміз не?
Dialogue: 0,0:05:56.82,0:05:59.95,Default,,0,0,0,,Көмек дегеніміз не? Сіз бір нәрсеге қол қоясыз ба?
Dialogue: 0,0:06:00.05,0:06:02.82,Default,,0,0,0,,Арара, сен асылсың ба?
Dialogue: 0,0:06:02.96,0:06:04.89,Default,,0,0,0,,Біз қазір теңдей сезінесіз бе?
Dialogue: 0,0:06:04.99,0:06:08.10,Default,,0,0,0,,Төменгілер жай ғана мойынсұнып, басшыларына бағынулары керек!
Dialogue: 0,0:06:08.40,0:06:12.73,Default,,0,0,0,,Шынында да, бұл губернатордың ізгіліктілігінің шынайы сипаты.
Dialogue: 0,0:06:12.83,0:06:14.14,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:06:14.44,0:06:18.57,Default,,0,0,0,,Бұлай жоғарыдан қарау үлкен сезім болса керек.
Dialogue: 0,0:06:18.67,0:06:20.71,Default,,0,0,0,,Міне, студент, артқа шегін.
Dialogue: 0,0:06:20.94,0:06:23.61,Default,,0,0,0,,Тез үйге бару керек.
Dialogue: 0,0:06:23.71,0:06:24.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:29.38,0:06:30.59,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:06:30.69,0:06:32.89,Default,,0,0,0,,Олай болса мен мұны (еркек) не істеймін? ―
Dialogue: 0,0:06:32.99,0:06:34.62,Default,,0,0,0,,Әй... Әй, сен не айтып тұрсың?
Dialogue: 0,0:06:34.69,0:06:35.79,Default,,0,0,0,,Неге қайтып оралмайсың?
Dialogue: 0,0:06:35.89,0:06:38.06,Default,,0,0,0,,Не болды?Дворян
Dialogue: 0,0:06:38.73,0:06:42.13,Default,,0,0,0,,Қарызға алынған өкілеттіктерді өз қабілеттерімен қателесу
Dialogue: 0,0:06:42.43,0:06:45.53,Default,,0,0,0,,Жасырын өлетін сияқты... Уф...
Dialogue: 0,0:06:45.67,0:06:47.87,Default,,0,0,0,,Жарайды, осы жерде қал.
Dialogue: 0,0:06:47.97,0:06:49.94,Default,,0,0,0,,Неге бір ауыз кешірім сұрамайсың?
Dialogue: 0,0:06:50.04,0:06:51.87,Default,,0,0,0,,U... Дөрекі! мен...
Dialogue: 0,0:06:52.04,0:06:53.88,Default,,0,0,0,,Жоғал! (Ер) Ух...
Dialogue: 0,0:06:53.98,0:06:55.44,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:55.54,0:06:57.58,Default,,0,0,0,,Мм... Рахмет.
Dialogue: 0,0:06:57.68,0:06:58.65,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:06:59.75,0:07:02.52,Default,,0,0,0,,Он бірге көмектескен Нөл болса да...
Dialogue: 0,0:07:02.62,0:07:04.15,Default,,0,0,0,,Жоқ... өйткені ол нөлге тең бе? ―
Dialogue: 0,0:07:04.45,0:07:07.56,Default,,0,0,0,,Олай болса... сен неге Эфемия-самамен жүрсің? ―
Dialogue: 0,0:07:08.06,0:07:11.06,Default,,0,0,0,,Жоқ... тым тереңге барсаңыз қауіпті болуы мүмкін.
Dialogue: 0,0:07:13.56,0:07:15.76,Default,,0,0,0,,NAC No...-
Dialogue: 0,0:07:15.86,0:07:19.20,Default,,0,0,0,,Оны террористердің арасында Киото деп атаса керек.
Dialogue: 0,0:07:19.50,0:07:21.97,Default,,0,0,0,,Ертеңгі рәсімнен кейін, Фудзиден тараңыз.
Dialogue: 0,0:07:22.60,0:07:26.44,Default,,0,0,0,,Егер тапсыру қансыз болса, кінәні мойындау туралы мәміле туралы айтуға болады.
Dialogue: 0,0:07:26.51,0:07:27.48,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:27.58,0:07:30.81,Default,,0,0,0,,Әрине, Қара рыцарьларға көмек аяқталды.
Dialogue: 0,0:07:31.01,0:07:34.12,Default,,0,0,0,,Ертең нөл келе ме, келмесе...
Dialogue: 0,0:07:34.18,0:07:37.08,Default,,0,0,0,,Ол кісінің жеңілетіні енді анық.
Dialogue: 0,0:07:37.19,0:07:38.05,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:39.19,0:07:40.82,Default,,0,0,0,,Иә? (Лелуш) Мен үйдемін
Dialogue: 0,0:07:40.92,0:07:43.06,Default,,0,0,0,,Қош келдің, ағайын.
Dialogue: 0,0:07:43.16,0:07:44.13,Default,,0,0,0,,Ширли ше?
Dialogue: 0,0:07:44.23,0:07:46.73,Default,,0,0,0,,Жоқ, ол келген жоқ.
Dialogue: 0,0:07:46.83,0:07:48.03,Default,,0,0,0,,Мен тіпті сізбен байланыса алмаймын.
Dialogue: 0,0:07:48.20,0:07:49.96,Default,,0,0,0,,Кішкене кек болуы мүмкін
Dialogue: 0,0:07:50.06,0:07:52.17,Default,,0,0,0,,Соңғы кездері күн суытқан сияқты.
Dialogue: 0,0:07:52.53,0:07:54.84,Default,,0,0,0,,Солай ма?Мен бұл туралы ойланамын
Dialogue: 0,0:07:54.94,0:07:57.24,Default,,0,0,0,,О, Сакийоко-сан, сен маған шай дайындап бере аласың ба?
Dialogue: 0,0:07:57.54,0:07:59.87,Default,,0,0,0,,Иә, мен ақылдымын.
Dialogue: 0,0:08:03.58,0:08:04.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:04.55,0:08:06.75,Default,,0,0,0,,Сіз бір нәрсеге алаңдайсыз ба?
Dialogue: 0,0:08:06.85,0:08:09.82,Default,,0,0,0,,Не? (Айналайын) Юффи апа ше?
Dialogue: 0,0:08:10.62,0:08:13.52,Default,,0,0,0,,Мен өзімшіл болмаймын және сені қайта көргім келеді.
Dialogue: 0,0:08:13.62,0:08:16.89,Default,,0,0,0,,Менің ағам мен әпкем Юффиге қиындық тудыратын нәрсе.
Dialogue: 0,0:08:17.63,0:08:19.09,Default,,0,0,0,,Сізге Юффи ұнай ма?
Dialogue: 0,0:08:19.19,0:08:22.06,Default,,0,0,0,,Иә, саған да ұнайды, солай емес пе?
Dialogue: 0,0:08:22.16,0:08:23.03,Default,,0,0,0,,Ах-
Dialogue: 0,0:08:23.76,0:08:24.97,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:08:27.60,0:08:29.10,Default,,0,0,0,,Мұнда басыңыз Арнайы әкімшілік аймақ Жапония -
Dialogue: 0,0:08:29.20,0:08:31.21,Default,,0,0,0,,Бұл ашылу салтанатының өтетін орны.
Dialogue: 0,0:08:31.51,0:08:33.67,Default,,0,0,0,,Өтетін жерде он бірлер көп...
Dialogue: 0,0:08:33.77,0:08:36.21,Default,,0,0,0,,Жоқ, ол жапондықтарға толы.
Dialogue: 0,0:08:36.51,0:08:40.82,Default,,0,0,0,,Кіре алмаған жапондықтардың көп бөлігі де өтетін орынның сыртында жиналды.
Dialogue: 0,0:08:40.91,0:08:44.09,Default,,0,0,0,,Лесли мырза, Нөл шығады ма?
Dialogue: 0,0:08:44.19,0:08:47.12,Default,,0,0,0,,Жоқ... осы уақытқа дейін байланыс болмаған сияқты.
Dialogue: 0,0:08:47.62,0:08:48.69,Default,,0,0,0,,Хэхехе...―
Dialogue: 0,0:08:48.79,0:08:50.79,Default,,0,0,0,,Не келе жатыр? Нөл және т.
Dialogue: 0,0:08:50.89,0:08:52.29,Default,,0,0,0,,Оның пайда болуы мүмкін емес.
Dialogue: 0,0:08:52.69,0:08:56.23,Default,,0,0,0,,Олар туралы қолымызда бар деректер рас болса.
Dialogue: 0,0:09:05.27,0:09:07.21,Default,,0,0,0,,Құрметті Эфемия, уақыт келді.
Dialogue: 0,0:09:07.31,0:09:08.18,Default,,0,0,0,,Иә-
Dialogue: 0,0:09:12.11,0:09:13.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:13.71,0:09:15.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:19.29,0:09:20.15,Default,,0,0,0,,Нөл…
Dialogue: 0,0:09:20.22,0:09:22.72,Default,,0,0,0,,Нөл! (Еркек) Нөл пайда болды!
Dialogue: 0,0:09:22.89,0:09:24.19,Default,,0,0,0,,Сонымен сіз келдіңіз.
Dialogue: 0,0:09:26.09,0:09:27.66,Default,,0,0,0,,Сіз жеңілгеніңізді мойындадыңыз ба?
Dialogue: 0,0:09:29.00,0:09:30.87,Default,,0,0,0,,Сіз нені айтасыз? ―
Dialogue: 0,0:09:30.97,0:09:34.64,Default,,0,0,0,,Сенің шынайы болмысың мен бейітіме өзіммен бірге апаруды жоспарлаған...
Dialogue: 0,0:09:35.14,0:09:39.04,Default,,0,0,0,,Егер олар Нөлдің Британия ханзадасы екенін білсе, бәрі бітеді.
Dialogue: 0,0:09:39.14,0:09:41.64,Default,,0,0,0,,Британдықтар фарс деп түсінді.
Dialogue: 0,0:09:42.14,0:09:44.78,Default,,0,0,0,,Тіпті бұл арнайы әкімшілік аймақ аяқталады.
Dialogue: 0,0:09:45.01,0:09:47.62,Default,,0,0,0,,Қарсылас нөлге тең. Күдікті қозғалыстар жасасаңыз...
Dialogue: 0,0:09:47.72,0:09:50.28,Default,,0,0,0,,Мені дереу атып таста (Бағыныштылар) Иә, Раббым.
Dialogue: 0,0:09:50.59,0:09:53.75,Default,,0,0,0,,Қош келдіңіз Zero! Жапонияның арнайы әкімшілік аймақтары
Dialogue: 0,0:09:54.02,0:09:55.96,Default,,0,0,0,,Евфемия li Британия
Dialogue: 0,0:09:56.06,0:09:58.76,Default,,0,0,0,,Мен кіріп, сізбен бірдеңе туралы сөйлескім келеді.
Dialogue: 0,0:09:58.86,0:09:59.99,Default,,0,0,0,,Менімен бе?
Dialogue: 0,0:10:00.09,0:10:02.73,Default,,0,0,0,,Иә, тек мен және сен
Dialogue: 0,0:10:02.90,0:10:04.33,Default,,0,0,0,,Бір қорқынышты нәрсе болды.
Dialogue: 0,0:10:04.63,0:10:07.07,Default,,0,0,0,,Нөл керемет түрде пайда болды.
Dialogue: 0,0:10:07.34,0:10:10.77,Default,,0,0,0,,Енді мен Жоғары мәртебелі Эфемияның басшылығымен G-1 (G-1) бөліміне бара жатырмын.
Dialogue: 0,0:10:11.11,0:10:13.87,Default,,0,0,0,,Біздің де баруымыз керек емес пе еді?
Dialogue: 0,0:10:13.94,0:10:15.68,Default,,0,0,0,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:10:15.78,0:10:18.85,Default,,0,0,0,,Егер Ланселот күтіп тұрса, Нөл келмеуі мүмкін.
Dialogue: 0,0:10:18.95,0:10:20.18,Default,,0,0,0,,Өйткені бәрі солай айтады.
Dialogue: 0,0:10:21.98,0:10:23.72,Default,,0,0,0,,Ешқандай проблема жоқ сияқты.
Dialogue: 0,0:10:23.85,0:10:25.02,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,0:10:25.12,0:10:26.22,Default,,0,0,0,,Құрметті Эфемия
Dialogue: 0,0:10:26.32,0:10:29.12,Default,,0,0,0,,Бұл кісімен жалғыз қалу қауіпті ғой.
Dialogue: 0,0:10:29.22,0:10:30.83,Default,,0,0,0,,Кем дегенде өзім...
Dialogue: 0,0:10:30.99,0:10:33.93,Default,,0,0,0,,Жарайды, маған сеніңіз.
Dialogue: 0,0:10:34.03,0:10:34.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:38.23,0:10:41.24,Default,,0,0,0,,Әй, біз мұнда қанша тұруымыз керек?
Dialogue: 0,0:10:41.67,0:10:44.24,Default,,0,0,0,,Нөл маған осы жерде күтуімді айтты, бірақ сенбейсің бе?
Dialogue: 0,0:10:44.41,0:10:45.77,Default,,0,0,0,,Өйткені
Dialogue: 0,0:10:46.01,0:10:48.88,Default,,0,0,0,,Барлығы Британияның шынайы ниетін растағаннан кейін келеді.
Dialogue: 0,0:10:48.98,0:10:49.84,Default,,0,0,0,,Командирдің орынбасары
Dialogue: 0,0:10:49.94,0:10:50.85,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:10:51.18,0:10:53.38,Default,,0,0,0,,Өйткені мен шын мағынасын білемін...
Dialogue: 0,0:10:53.68,0:10:55.65,Default,,0,0,0,,Бүкіл әскер жан-жақта жатыр емес пе?
Dialogue: 0,0:10:55.75,0:10:56.92,Default,,0,0,0,,Бекіту қауіпті.
Dialogue: 0,0:10:57.35,0:11:00.05,Default,,0,0,0,,Тіпті Диетард пен Ракшата да күтуге мәжбүр болды.
Dialogue: 0,0:11:00.35,0:11:03.39,Default,,0,0,0,,Нөл, бәлкім, Эфемияны алды...
Dialogue: 0,0:11:04.26,0:11:05.93,Default,,0,0,0,,Сіз абайсыз.
Dialogue: 0,0:11:06.03,0:11:08.06,Default,,0,0,0,,Камера өшірілген болса да...
Dialogue: 0,0:11:08.16,0:11:11.93,Default,,0,0,0,,Мен ұзақ уақыт бойы жасырынып жүргендіктен, әлдебір империяның кесірінен...
Dialogue: 0,0:11:12.73,0:11:15.67,Default,,0,0,0,,Керамика мен бамбуктан жасалған инелі мылтық
Dialogue: 0,0:11:15.77,0:11:17.77,Default,,0,0,0,,Мұны детектор анықтай алмайды
Dialogue: 0,0:11:17.94,0:11:20.88,Default,,0,0,0,,Лелуш, сен атпайсың, солай ма?
Dialogue: 0,0:11:20.94,0:11:23.44,Default,,0,0,0,,Иә, мен атпаймын.
Dialogue: 0,0:11:23.74,0:11:25.71,Default,,0,0,0,,Атқан сенсің, Юффи.
Dialogue: 0,0:11:25.78,0:11:26.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:26.95,0:11:29.75,Default,,0,0,0,,Жақсысың ба?Нөлмен жалғыз қалу...
Dialogue: 0,0:11:29.85,0:11:31.35,Default,,0,0,0,,Бірақ сіздің тапсырыстарыңыз...
Dialogue: 0,0:11:31.45,0:11:34.19,Default,,0,0,0,,Мен сізге төтенше жағдайда қоңырау шалу үшін қосқыш бердім.
Dialogue: 0,0:11:35.19,0:11:36.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:40.46,0:11:41.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:49.04,0:11:49.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:49.97,0:11:51.94,Default,,0,0,0,,Иә? (Қамқоршы) Не болды?
Dialogue: 0,0:11:52.14,0:11:54.08,Default,,0,0,0,,Неліктен нөл сияқты нәрсемен бірге ...
Dialogue: 0,0:11:54.88,0:11:56.41,Default,,0,0,0,,) Көріп тұрған сияқтысың.
Dialogue: 0,0:11:56.71,0:12:00.21,Default,,0,0,0,,Жанама байланыс пен Каминеджима оқиғасы триггер болды ма?
Dialogue: 0,0:12:00.98,0:12:02.92,Default,,0,0,0,,Әлде ол ма? ―
Dialogue: 0,0:12:03.02,0:12:04.15,Default,,0,0,0,,Хмм. Нацу-кун, сен жақсы көрінесің.
Dialogue: 0,0:12:11.83,0:12:14.83,Default,,0,0,0,,Бұл рәсім бүкіл әлемге таратылуда.
Dialogue: 0,0:12:14.93,0:12:18.20,Default,,0,0,0,,Міне, сен, Британия ханшайымы, Нөлді түсір.
Dialogue: 0,0:12:18.30,0:12:19.73,Default,,0,0,0,,Не болады деп ойлайсыз?
Dialogue: 0,0:12:19.90,0:12:21.87,Default,,0,0,0,,Қызық, бүлік бола ма?
Dialogue: 0,0:12:22.00,0:12:24.31,Default,,0,0,0,,Әй, алдап атып түсіріп алсаң...
Dialogue: 0,0:12:24.41,0:12:26.04,Default,,0,0,0,,Нөл шейіт болады...
Dialogue: 0,0:12:26.14,0:12:28.34,Default,,0,0,0,,Сіздің беделіңіз жерге түседі
Dialogue: 0,0:12:28.78,0:12:32.21,Default,,0,0,0,,Не қалжыңдап тұрсың? Менімен Жапонияға саяхат...
Dialogue: 0,0:12:32.31,0:12:34.38,Default,,0,0,0,,Егер сіз оны жоғарыдан біржақты мәжбүрлеп жатсаңыз...
Dialogue: 0,0:12:34.48,0:12:36.48,Default,,0,0,0,,Хловис (Эвфемия) сияқты, иә?
Dialogue: 0,0:12:37.05,0:12:40.12,Default,,0,0,0,,Барлық шарттар енді жойылды.
Dialogue: 0,0:12:40.22,0:12:43.89,Default,,0,0,0,,Нөл өмір мен өлім арасында адасып, ғажайып қайта тірілтіп, мадақталады.
Dialogue: 0,0:12:44.19,0:12:47.83,Default,,0,0,0,,Адамдар логикаға емес, ғажайыптарға әлсіз.
Dialogue: 0,0:12:48.33,0:12:49.96,Default,,0,0,0,,Жүріңіз, алыңыз.
Dialogue: 0,0:12:50.06,0:12:51.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:51.43,0:12:53.87,Default,,0,0,0,,Бір Мәсіх болуы керек.
Dialogue: 0,0:12:53.97,0:12:56.07,Default,,0,0,0,,Егер адамдар сіздің жалған екеніңізді білсе...
Dialogue: 0,0:12:56.17,0:12:57.07,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:57.97,0:12:59.77,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:12:59.84,0:13:02.94,Default,,0,0,0,,Бір ғана сұраққа жауап беріңіз. Сіз... Уф!
Dialogue: 0,0:13:03.04,0:13:04.45,Default,,0,0,0,,Гууууууу...
Dialogue: 0,0:13:04.51,0:13:05.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:07.01,0:13:08.35,Default,,0,0,0,,Жоқ... қазірдің өзінде...
Dialogue: 0,0:13:08.55,0:13:09.88,Default,,0,0,0,,Әй, не болды? ―
Dialogue: 0,0:13:10.08,0:13:10.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:11.05,0:13:12.15,Default,,0,0,0,,Ах, а...―
Dialogue: 0,0:13:16.52,0:13:17.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:18.03,0:13:20.16,Default,,0,0,0,,А... а...
Dialogue: 0,0:13:21.00,0:13:22.86,Default,,0,0,0,,Майор Куруруги! (Қамқоршы) Сен! ―
Dialogue: 0,0:13:22.93,0:13:24.23,Default,,0,0,0,,Не істедің! (C.C.)
Dialogue: 0,0:13:25.37,0:13:27.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:28.47,0:13:30.30,Default,,0,0,0,,Лелуш! (Лелуш) Тоқта! ―
Dialogue: 0,0:13:30.40,0:13:32.27,Default,,0,0,0,,Енді мені аяма!
Dialogue: 0,0:13:32.47,0:13:33.54,Default,,0,0,0,,Мен садақа қабылдамаймын! ―
Dialogue: 0,0:13:34.14,0:13:36.48,Default,,0,0,0,,Мен оны өз күшіммен алуға тырысамын! ―
Dialogue: 0,0:13:37.01,0:13:39.08,Default,,0,0,0,,Сол үшін де сені кірлетемін! ―
Dialogue: 0,0:13:39.18,0:13:41.85,Default,,0,0,0,,Евфемия li Britannia!
Dialogue: 0,0:13:42.08,0:13:43.55,Default,,0,0,0,,Аты қайтарылды!
Dialogue: 0,0:13:43.85,0:13:44.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:45.52,0:13:48.32,Default,,0,0,0,,Бір күні сіздің еліңізден хабарландыру болады деп ойлаймын.
Dialogue: 0,0:13:48.42,0:13:50.52,Default,,0,0,0,,Император тағына құқықты қайтарды
Dialogue: 0,0:13:51.23,0:13:52.46,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:13:53.19,0:13:55.10,Default,,0,0,0,,Ол нөлді қабылдағаны үшін бе?
Dialogue: 0,0:13:55.53,0:13:58.13,Default,,0,0,0,,Өйткені менің өзімшілдігімді тыңдағаныңды қалаймын.
Dialogue: 0,0:13:58.23,0:14:00.13,Default,,0,0,0,,Белгілі бір мөлшерде өтемақы қажет, солай емес пе?
Dialogue: 0,0:14:00.23,0:14:01.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:02.10,0:14:05.31,Default,,0,0,0,,Сізді оңай лақтыруға болады...
Dialogue: 0,0:14:05.41,0:14:07.04,Default,,0,0,0,,Мен үшін деп айтасыз ба?
Dialogue: 0,0:14:07.14,0:14:09.61,Default,,0,0,0,,Ууу, сен бұрынғыдай сенімдісің.
Dialogue: 0,0:14:09.91,0:14:12.18,Default,,0,0,0,,Нунелли (Лелуч) үшін...
Dialogue: 0,0:14:12.28,0:14:13.55,Default,,0,0,0,,Сол қыз айтты
Dialogue: 0,0:14:13.85,0:14:18.15,Default,,0,0,0,,«Егер мен сенімен бірге бола алсам, маған басқа ештеңе керек емес».
Dialogue: 0,0:14:18.89,0:14:19.85,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:20.49,0:14:22.92,Default,,0,0,0,,Мен осылай шешім қабылдадым.
Dialogue: 0,0:14:23.39,0:14:27.49,Default,,0,0,0,,Мен үшін шынымен не маңызды?
Dialogue: 0,0:14:27.60,0:14:28.90,Default,,0,0,0,,Сонымен Лелуч? ―
Dialogue: 0,0:14:29.00,0:14:33.53,Default,,0,0,0,,Мен шынымен маңызды ештеңені тастаған жоқпын.
Dialogue: 0,0:14:33.63,0:14:34.60,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:14:34.90,0:14:37.27,Default,,0,0,0,,Сіз туралы ешкім білмейді... (Лелуш) Хмм...
Dialogue: 0,0:14:37.64,0:14:39.94,Default,,0,0,0,,Хахаха... Корнелия ше?
Dialogue: 0,0:14:40.04,0:14:42.64,Default,,0,0,0,,Бұл қайта кездесе алмаймыз деген сөз емес.
Dialogue: 0,0:14:42.94,0:14:45.01,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:14:45.11,0:14:46.18,Default,,0,0,0,,Сен үлкен ақымақсың.
Dialogue: 0,0:14:46.28,0:14:48.32,Default,,0,0,0,,Ойын ойнай ма, сабақ оқи ма...
Dialogue: 0,0:14:48.42,0:14:51.19,Default,,0,0,0,,Мен Лелучты ешқашан жеңген емеспін.
Dialogue: 0,0:14:51.29,0:14:57.02,Default,,0,0,0,,Алайда, бұл ойланбайтын әдіс болса да, ол бәрін алады ...
Dialogue: 0,0:14:57.39,0:15:01.96,Default,,0,0,0,,Ойлап қарасаңыз, бұрын сіз әрқашан лейтенант губернатор немесе Мәртебелі ханшайым болғансыз...
Dialogue: 0,0:15:02.06,0:15:04.03,Default,,0,0,0,,Бұл жай ғана Юффи болатын.
Dialogue: 0,0:15:04.13,0:15:06.60,Default,,0,0,0,,Егер сен жай Юффи болсаң, менімен жұмыс істеуге дайынсың ба?
Dialogue: 0,0:15:08.10,0:15:09.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:12.17,0:15:13.27,Default,,0,0,0,,Сіз-
Dialogue: 0,0:15:13.91,0:15:17.08,Default,,0,0,0,,Ол менің ең қас жауым болды.
Dialogue: 0,0:15:18.41,0:15:19.38,Default,,0,0,0,,Сіз жеңдіңіз.
Dialogue: 0,0:15:19.48,0:15:20.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:21.15,0:15:22.48,Default,,0,0,0,,Осы арнайы әкімшілік аймақты барынша пайдалану үшін -
Dialogue: 0,0:15:22.58,0:15:24.12,Default,,0,0,0,,Жоспар құрайық (Эфемия) А!
Dialogue: 0,0:15:24.22,0:15:26.35,Default,,0,0,0,,Әй, сен менің бағынушым болмайсың ғой, солай ма?
Dialogue: 0,0:15:26.45,0:15:27.42,Default,,0,0,0,,Иә
Dialogue: 0,0:15:27.52,0:15:30.29,Default,,0,0,0,,Бірақ сен маған сенбейсің, иә? (Лелуш)
Dialogue: 0,0:15:30.39,0:15:31.46,Default,,0,0,0,,Мені қорқытқаны үшін...
Dialogue: 0,0:15:31.56,0:15:33.99,Default,,0,0,0,,Лелушты түсіремін деп ойладың ба?
Dialogue: 0,0:15:34.09,0:15:35.66,Default,,0,0,0,,О, бұл дұрыс емес.
Dialogue: 0,0:15:36.43,0:15:40.07,Default,,0,0,0,,Мен байыпты бұйрық берсем, ешкім бағынбай алмайды.
Dialogue: 0,0:15:40.17,0:15:42.67,Default,,0,0,0,,Мені атып, Созакуды жібер.
Dialogue: 0,0:15:42.97,0:15:44.37,Default,,0,0,0,,Кез келген тапсырыстар
Dialogue: 0,0:15:44.47,0:15:47.07,Default,,0,0,0,,Бұл жай ғана біртүрлі әзілдер
Dialogue: 0,0:15:47.17,0:15:48.28,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:15:48.38,0:15:52.18,Default,,0,0,0,,Мысалы, мен саған жапондықтарды өлтіріңдер десем, ниетіңе қарамастан...
Dialogue: 0,0:15:54.95,0:15:55.62,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:56.38,0:15:59.19,Default,,0,0,0,,Мен оны жек көремін... Мен... жек көремін...
Dialogue: 0,0:15:59.25,0:16:00.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:01.36,0:16:03.36,Default,,0,0,0,,Мен сені өлтіргім келмейді! ―
Dialogue: 0,0:16:04.69,0:16:06.03,Default,,0,0,0,,Мен оны жек көремін...
Dialogue: 0,0:16:06.13,0:16:08.53,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:16:08.60,0:16:10.26,Default,,0,0,0,,Жоқ... болмайды!
Dialogue: 0,0:16:12.07,0:16:14.67,Default,,0,0,0,,Иә, біз жапондарды өлтіруіміз керек.
Dialogue: 0,0:16:15.17,0:16:16.14,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:16.37,0:16:20.04,Default,,0,0,0,,Мао сияқты мен де Геассты қоса немесе өшіре алмаймын...
Dialogue: 0,0:16:20.24,0:16:22.44,Default,,0,0,0,,Қарғыс атсын, бұл бұйрықты ұмыт! ―
Dialogue: 0,0:16:22.54,0:16:23.68,Default,,0,0,0,,Юффи! ―
Dialogue: 0,0:16:24.51,0:16:26.31,Default,,0,0,0,,А... күте тұрыңыз!Юффи!
Dialogue: 0,0:16:27.05,0:16:30.22,Default,,0,0,0,,Аа, мен Қытай Федерациясымен сөйлестім.
Dialogue: 0,0:16:30.32,0:16:31.99,Default,,0,0,0,,Мен бүгін өз еліме қайтамын.
Dialogue: 0,0:16:32.05,0:16:35.16,Default,,0,0,0,,Сонымен, бұл жерде тәжірибе жасауға жарамды тірі ағзалар әлі бар ма?
Dialogue: 0,0:16:35.26,0:16:37.02,Default,,0,0,0,,Иә, интеллект туралы не деуге болады?
Dialogue: 0,0:16:37.09,0:16:39.46,Default,,0,0,0,,11-аймақтың өз шегі бар.
Dialogue: 0,0:16:39.56,0:16:40.63,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:40.73,0:16:43.53,Default,,0,0,0,,Розенберг институтымен сөйлесейік.
Dialogue: 0,0:16:43.73,0:16:47.63,Default,,0,0,0,,Маған хабарлассаңыз, сол эксперименталды машинасы бар жинақты жібере аласыз ба?
Dialogue: 0,0:16:47.74,0:16:51.34,Default,,0,0,0,,Жарайды, ал Каминеджима қирандылары...
Dialogue: 0,0:16:51.44,0:16:54.44,Default,,0,0,0,,11-аймақтағы қауіпсіздік жағдайы тұрақтанғаннан кейін.
Dialogue: 0,0:16:54.54,0:16:56.14,Default,,0,0,0,,Осы мақсатқа арналған арнайы әкімшілік аймақтар.
Dialogue: 0,0:16:56.38,0:16:57.64,Default,,0,0,0,,Мен сізге алғыс айтуым керек.
Dialogue: 0,0:16:58.18,0:17:02.05,Default,,0,0,0,,Эфемияның арқасында бәрі жақсы жүріп жатқан сияқты.
Dialogue: 0,0:17:02.35,0:17:03.75,Default,,0,0,0,,Лейтенант губернатор!Ал нөл туралы не деуге болады?
Dialogue: 0,0:17:04.05,0:17:06.29,Default,,0,0,0,,Өздерін жапон деп атайтындардың бәрі -
Dialogue: 0,0:17:06.49,0:17:09.52,Default,,0,0,0,,Менің сізге өтінішім бар. Өтінемін, өле аласыз ба?
Dialogue: 0,0:17:09.62,0:17:11.29,Default,,0,0,0,,Не? (Еркек) Жаңа ғана не айттыңыз?
Dialogue: 0,0:17:11.39,0:17:12.56,Default,,0,0,0,,Бұл өтірік, солай ма? (Еркек) Жай әзіл...
Dialogue: 0,0:17:13.13,0:17:14.50,Default,,0,0,0,,Әй, Созаку! ―
Dialogue: 0,0:17:15.76,0:17:17.26,Default,,0,0,0,,Сіз жай ғана ес-түссіз жатырсыз ба?
Dialogue: 0,0:17:17.36,0:17:18.56,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:17:18.67,0:17:20.07,Default,,0,0,0,,Эрм (Лелух) Ах!
Dialogue: 0,0:17:20.33,0:17:22.24,Default,,0,0,0,,Мен сенің өз-өзіңе қол жұмсауыңды қаладым...
Dialogue: 0,0:17:22.34,0:17:23.44,Default,,0,0,0,,Жақсы емес пе? ―
Dialogue: 0,0:17:23.67,0:17:27.47,Default,,0,0,0,,Олай болса, сарбаздар, олардың бәрін өлтіріңдер.
Dialogue: 0,0:17:27.57,0:17:28.61,Default,,0,0,0,,Бұл қырғын!
Dialogue: 0,0:17:28.71,0:17:30.24,Default,,0,0,0,,Жоқ! Шын айтасың ба?
Dialogue: 0,0:17:30.44,0:17:31.71,Default,,0,0,0,,Микрофон мен камераны өшіріңіз!
Dialogue: 0,0:17:32.35,0:17:33.21,Default,,0,0,0,,Тоқта!Юффи!
Dialogue: 0,0:17:33.35,0:17:34.82,Default,,0,0,0,,Тоқта! (Лелуш) Жолдан кет!
Dialogue: 0,0:17:35.08,0:17:36.18,Default,,0,0,0,,Террористер!
Dialogue: 0,0:17:36.55,0:17:37.52,Default,,0,0,0,,Докунда! (мылтық)
Dialogue: 0,0:17:37.62,0:17:38.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:45.69,0:17:46.69,Default,,0,0,0,,Оянып қалдым да, бүкіл денем ауырады~!
Dialogue: 0,0:17:47.06,0:17:49.26,Default,,0,0,0,,Келіңіздер!Тезірек, сарбаздар!
Dialogue: 0,0:17:49.36,0:17:50.46,Default,,0,0,0,,Құрметті Эфемия! ―
Dialogue: 0,0:17:50.70,0:17:52.33,Default,,0,0,0,,Жер бетінде не болды?
Dialogue: 0,0:17:52.47,0:17:54.37,Default,,0,0,0,,Өтінемін, бұлай етпеңіз... (мылтық ату)
Dialogue: 0,0:17:54.47,0:17:56.67,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:17:56.80,0:17:58.51,Default,,0,0,0,,Жалпы! (Лелух) Ух...
Dialogue: 0,0:17:59.31,0:18:00.74,Default,,0,0,0,,Кешіріңіз-
Dialogue: 0,0:18:00.84,0:18:04.24,Default,,0,0,0,,Бірақ барлық жапондықтар жойылуы керек.
Dialogue: 0,0:18:04.34,0:18:06.65,Default,,0,0,0,,Келіңіздер! Британиядағы барлығы
Dialogue: 0,0:18:07.65,0:18:08.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:08.72,0:18:11.55,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:11.62,0:18:14.15,Default,,0,0,0,,Он бірді өлтіріңіз, барлық күштер, он бірді жойыңыз.
Dialogue: 0,0:18:14.52,0:18:15.56,Default,,0,0,0,,Бір адам болса да қашып кетпесін.
Dialogue: 0,0:18:16.46,0:18:17.62,Default,,0,0,0,,Тоқта! Не істеу керек! ―
Dialogue: 0,0:18:18.16,0:18:20.86,Default,,0,0,0,,Мен Сузаку Куруругимін, Британ армиясының құрметті кавалерімін!
Dialogue: 0,0:18:21.16,0:18:23.13,Default,,0,0,0,,Қазір соғысуды тоқтатыңыз!
Dialogue: 0,0:18:24.30,0:18:27.20,Default,,0,0,0,,Бұйрық барлық жапондықтарды жою.
Dialogue: 0,0:18:27.30,0:18:28.84,Default,,0,0,0,,Эфемия-сама тікелей
Dialogue: 0,0:18:29.24,0:18:31.17,Default,,0,0,0,,Не?Эфемия-сама?
Dialogue: 0,0:18:31.47,0:18:32.37,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:18:32.47,0:18:33.84,Default,,0,0,0,,Сіз де жапон едіңіз.
Dialogue: 0,0:18:34.14,0:18:34.81,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:36.58,0:18:38.21,Default,,0,0,0,,Не... не? (Әйел) Ішінде бірдеңе болды ма?
Dialogue: 0,0:18:38.31,0:18:40.21,Default,,0,0,0,,Мылтықпен сәлемдесу? (Еркек) Бұл рас болуы мүмкін емес...
Dialogue: 0,0:18:40.31,0:18:41.85,Default,,0,0,0,,Теледидар ше? (Әйел) Эфир үзілді...
Dialogue: 0,0:18:43.45,0:18:45.42,Default,,0,0,0,,Тоқта! Юффи! ―
Dialogue: 0,0:18:47.75,0:18:48.89,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:49.19,0:18:50.42,Default,,0,0,0,,Менің Geass...
Dialogue: 0,0:18:50.52,0:18:52.16,Default,,0,0,0,,Зе… Нөл… (Лелуш) Уф.
Dialogue: 0,0:18:52.26,0:18:53.79,Default,,0,0,0,,Бізге…
Dialogue: 0,0:18:53.89,0:18:56.86,Default,,0,0,0,,Жапония… Құтқарушы…
Dialogue: 0,0:18:57.66,0:18:58.87,Default,,0,0,0,,Тоқта...
Dialogue: 0,0:18:59.17,0:19:01.20,Default,,0,0,0,,Мен құтқарушымын...
Dialogue: 0,0:19:01.30,0:19:02.74,Default,,0,0,0,,Ол Мәсіх емес...
Dialogue: 0,0:19:03.17,0:19:04.81,Default,,0,0,0,,Үміт…
Dialogue: 0,0:19:04.91,0:19:07.51,Default,,0,0,0,,Сіз... тек...
Dialogue: 0,0:19:08.38,0:19:09.31,Default,,0,0,0,,Тоқта...
Dialogue: 0,0:19:09.58,0:19:10.44,Default,,0,0,0,,Маған...
Dialogue: 0,0:19:11.18,0:19:12.58,Default,,0,0,0,,Маған өзіңізді күштемеңіз...
Dialogue: 0,0:19:12.81,0:19:14.48,Default,,0,0,0,,Күнәларыңызды кешіргіңіз келе ме? ―
Dialogue: 0,0:19:14.58,0:19:16.42,Default,,0,0,0,,Оны арқама көтеріп жүруім керек пе? ―
Dialogue: 0,0:19:16.52,0:19:17.72,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,0:19:18.75,0:19:19.65,Default,,0,0,0,,Нөл…
Dialogue: 0,0:19:19.75,0:19:23.46,Default,,0,0,0,,Қарғыс атсын... сен... сен Евфемия-самаға не істедің?
Dialogue: 0,0:19:23.72,0:19:25.79,Default,,0,0,0,,Андреас Далтон
Dialogue: 0,0:19:26.16,0:19:29.20,Default,,0,0,0,,Ол Корнелияның ең жақын көмекшілерінің бірі болды.
Dialogue: 0,0:19:29.40,0:19:31.40,Default,,0,0,0,,Не?Өткізілетін жерде не болды?
Dialogue: 0,0:19:31.50,0:19:32.80,Default,,0,0,0,,Мен оны қазір тексеріп жатырмын!
Dialogue: 0,0:19:32.90,0:19:35.24,Default,,0,0,0,,Ал, мен үйдемін... өтетін орынмен...
Dialogue: 0,0:19:35.34,0:19:36.57,Default,,0,0,0,,Эстафета жақсы өтуде...
Dialogue: 0,0:19:36.74,0:19:37.87,Default,,0,0,0,,Неліктен ол ауыспайды?
Dialogue: 0,0:19:38.17,0:19:40.47,Default,,0,0,0,,Бұл бір жерден бұзылған.
Dialogue: 0,0:19:40.57,0:19:42.68,Default,,0,0,0,,Тоқта!Ол бүкіл әлемде ағып жатыр!
Dialogue: 0,0:19:43.68,0:19:45.95,Default,,0,0,0,,Хабар тарату жақын арада үзіледі.
Dialogue: 0,0:19:46.25,0:19:47.48,Default,,0,0,0,,Интернетке деректерді жүктеп салыңыз
Dialogue: 0,0:19:47.58,0:19:49.18,Default,,0,0,0,,Өйткені (бағыныңқы) Иә.
Dialogue: 0,0:19:49.28,0:19:52.52,Default,,0,0,0,,Қызметкер! С.С. бас қолбасшымен кездесті.
Dialogue: 0,0:19:52.62,0:19:54.82,Default,,0,0,0,,Жарайды!Енді мәселе жойылды
Dialogue: 0,0:19:55.56,0:19:58.83,Default,,0,0,0,,Мен олардың бұл жағдайды қалай жасағанын білмеймін, бірақ...
Dialogue: 0,0:19:58.93,0:20:01.80,Default,,0,0,0,,Бұл жоспардан гөрі айла, Нөл.
Dialogue: 0,0:20:01.90,0:20:03.50,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:20:04.77,0:20:05.80,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:05.93,0:20:08.27,Default,,0,0,0,,Сенің осы уақытқа дейін баратыныңа таң қалдым.
Dialogue: 0,0:20:08.37,0:20:09.34,Default,,0,0,0,,Мен емес
Dialogue: 0,0:20:09.44,0:20:10.37,Default,,0,0,0,,Не? Ах
Dialogue: 0,0:20:10.74,0:20:12.94,Default,,0,0,0,,Менде Геасс жоқ.
Dialogue: 0,0:20:13.24,0:20:15.58,Default,,0,0,0,,Жоқ, мен қоңырау шалғым келмеді.
Dialogue: 0,0:20:16.48,0:20:18.98,Default,,0,0,0,,Байқадым, бұрынғы...
Dialogue: 0,0:20:19.41,0:20:21.82,Default,,0,0,0,,Мен мұны біле тұра келісім-шартқа қол қойдым.
Dialogue: 0,0:20:21.92,0:20:24.52,Default,,0,0,0,,Менің айтарым, бұл қауіпті күш...
Dialogue: 0,0:20:24.62,0:20:25.49,Default,,0,0,0,,Ал дегенмен!
Dialogue: 0,0:20:25.65,0:20:29.76,Default,,0,0,0,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,0:20:29.86,0:20:32.69,Default,,0,0,0,,Ол жігіт!Сіз оны аяқтадыңыз ба?
Dialogue: 0,0:20:33.23,0:20:35.40,Default,,0,0,0,,Ах... Бұл не...
Dialogue: 0,0:20:35.66,0:20:37.40,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:20:38.87,0:20:40.53,Default,,0,0,0,,Күте тұрыңыз! Құрметті Корнелия!
Dialogue: 0,0:20:40.67,0:20:42.74,Default,,0,0,0,,Тек соңынан ерген адамдар келсін!
Dialogue: 0,0:20:42.87,0:20:44.30,Default,,0,0,0,,Юффи!
Dialogue: 0,0:20:45.54,0:20:47.44,Default,,0,0,0,,Сіз оны таптыңыз ба?Сен қайдасың!
Dialogue: 0,0:20:47.61,0:20:48.78,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:20:48.88,0:20:51.61,Default,,0,0,0,,Мен генерал Далтонмен де байланыса алмаймын.
Dialogue: 0,0:20:51.75,0:20:53.25,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:20:53.35,0:20:55.42,Default,,0,0,0,,Бұл бұрынғы Эфемиядан тым өзгеше.
Dialogue: 0,0:20:55.62,0:20:57.68,Default,,0,0,0,,Келіссөзге орын болса жақсы болар еді.
Dialogue: 0,0:20:57.78,0:20:59.39,Default,,0,0,0,,Мен Кирихарамен де қосыла алмаймын.
Dialogue: 0,0:20:59.49,0:21:01.69,Default,,0,0,0,,Иә... Әзірге біз ғана болсақ та.
Dialogue: 0,0:21:01.79,0:21:03.96,Default,,0,0,0,,Қош бол, кәдесыйлар...
Dialogue: 0,0:21:04.26,0:21:05.63,Default,,0,0,0,,Аянышты (ерлер) Иә?
Dialogue: 0,0:21:05.69,0:21:07.96,Default,,0,0,0,,Басқаша айтқанда, бұл мен үшін маңызды ма?
Dialogue: 0,0:21:08.50,0:21:10.86,Default,,0,0,0,,Императордың ауызы өтті.
Dialogue: 0,0:21:10.96,0:21:13.63,Default,,0,0,0,,Біз Жапония үшін қалуымыз керек.
Dialogue: 0,0:21:13.73,0:21:15.84,Default,,0,0,0,,Жалғыз біз қалсақ, не істейміз?
Dialogue: 0,0:21:15.94,0:21:18.67,Default,,0,0,0,,Қарапайым!Кагурая!Onago тек үйдің дәрежесіне арналған!
Dialogue: 0,0:21:18.74,0:21:21.04,Default,,0,0,0,,Қазір қозғалма! Киото не үшін?
Dialogue: 0,0:21:21.88,0:21:25.45,Default,,0,0,0,,Юффи қырғынға бұйрық бере алмайды! ―
Dialogue: 0,0:21:25.55,0:21:28.02,Default,,0,0,0,,Қандай жағдай болмасын, оны табыңыз! Юффи!
Dialogue: 0,0:21:28.42,0:21:29.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:32.79,0:21:35.72,Default,,0,0,0,,Әй, британ әскері алаңның сыртында пайда болды.
Dialogue: 0,0:21:35.82,0:21:37.92,Default,,0,0,0,,Аа, егер бұл орын алса, Эфемия...
Dialogue: 0,0:21:38.03,0:21:40.46,Default,,0,0,0,,Бізде оны барынша пайдаланудан басқа амал жоқ.
Dialogue: 0,0:21:40.56,0:21:42.56,Default,,0,0,0,,Бұл... кем дегенде...
Dialogue: 0,0:21:42.83,0:21:44.36,Default,,0,0,0,,Мм... Ах!
Dialogue: 0,0:21:44.43,0:21:45.70,Default,,0,0,0,,Нөлге хабарлаңыз! ―
Dialogue: 0,0:21:45.80,0:21:47.57,Default,,0,0,0,,Бұл ұшақты тапсырыңыз! ―
Dialogue: 0,0:21:47.63,0:21:49.47,Default,,0,0,0,,Бұл ұшақ біздің әскерге тиесілі...
Dialogue: 0,0:21:50.77,0:21:52.51,Default,,0,0,0,,Қара рыцарьлардың барлық мүшелеріне айтыңыз! ―
Dialogue: 0,0:21:53.37,0:21:54.94,Default,,0,0,0,,Эфемия жауға айналды! ―
Dialogue: 0,0:21:55.04,0:21:56.64,Default,,0,0,0,,Жапонияның арнайы әкімшілік аймағы –
Dialogue: 0,0:21:56.74,0:21:59.68,Default,,0,0,0,,Бұл бізді қуып жіберген жасырын тұзақ болды! ―
Dialogue: 0,0:21:59.95,0:22:03.82,Default,,0,0,0,,Еркін жауынгерлік броньды атты әскер бөлімі салтанатты түрде салтанатты түрде өтуі керек! ―
Dialogue: 0,0:22:03.95,0:22:08.46,Default,,0,0,0,,Британдық әскерді жойып, жапондарды құтқарыңыз! ―
Dialogue: 0,0:22:08.56,0:22:09.42,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:22:11.79,0:22:14.36,Default,,0,0,0,,Мүлдем... Сөзсіз Юффи...
Dialogue: 0,0:22:14.46,0:22:16.80,Default,,0,0,0,,Оны тауып, өлтір!
Dialogue: 0,0:22:18.03,0:22:21.70,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:22:21.80,0:22:25.51,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:22:25.61,0:22:32.61,Default,,0,0,0,,♪Сен маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:22:41.12,0:22:48.13,Default,,0,0,0,,♪Бұлай болуы мүмкін емес,-деп іштей ойланып ұйықтап қалдым
Dialogue: 0,0:22:48.63,0:22:51.90,Default,,0,0,0,,♪Мен оянсам, әдеттегідей
Dialogue: 0,0:22:52.00,0:22:56.40,Default,,0,0,0,,♪ Өзгеріссіз бос жүріс
Dialogue: 0,0:22:56.50,0:23:01.68,Default,,0,0,0,,♪ Мағынасыз қайталанады
Dialogue: 0,0:23:02.54,0:23:06.55,Default,,0,0,0,,♪Мозаикалық үзінділер жанды түрде бейнеленген
Dialogue: 0,0:23:06.65,0:23:09.72,Default,,0,0,0,,♪Бұрынғы өтірік пен қателіктер
Dialogue: 0,0:23:09.82,0:23:16.82,Default,,0,0,0,,♪Ол туралы көбірек ойлаған сайын, оны өшіргім келеді
Dialogue: 0,0:23:17.39,0:23:18.63,Default,,0,0,0,,♪Артқа қарап
Dialogue: 0,0:23:18.73,0:23:21.93,Default,,0,0,0,,♪Бастау сызығы бар
Dialogue: 0,0:23:22.03,0:23:24.53,Default,,0,0,0,,♪Әлі прогресс жоқ
Dialogue: 0,0:23:24.63,0:23:31.64,Default,,0,0,0,,♪Тағыда армандарымызды жинайық
Dialogue: 0,0:23:32.01,0:23:35.58,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:23:35.68,0:23:39.18,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:23:39.48,0:23:46.49,Default,,0,0,0,,♪Сіз маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:23:49.79,0:23:51.16,Default,,0,0,0,,Оны кім жасады? ―
Dialogue: 0,0:23:51.42,0:23:53.03,Default,,0,0,0,,Бұл жағдай-
Dialogue: 0,0:23:53.09,0:23:55.73,Default,,0,0,0,,Кім кінәлі? Бұл трагедия –
Dialogue: 0,0:23:55.83,0:23:58.90,Default,,0,0,0,,Оны кім қалайды? Бұл шайқас-
Dialogue: 0,0:23:59.00,0:24:02.14,Default,,0,0,0,,Ол кімдікі? Бұл дүние-
Dialogue: 0,0:24:02.44,0:24:04.20,Default,,0,0,0,,А, мен білемін
Dialogue: 0,0:24:04.50,0:24:07.67,Default,,0,0,0,,Бірақ, бірақ... бәрібір мен
Dialogue: 0,0:24:09.17,0:24:15.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory