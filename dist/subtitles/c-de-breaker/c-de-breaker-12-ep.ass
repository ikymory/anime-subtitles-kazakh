Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.11,JP-SUB,,0,0,0,,Келдің бе? Код ажыратқыш
Dialogue: 0,0:00:02.04,0:00:03.24,JP-SUB,,0,0,0,,Хайке отбасымен не болды?
Dialogue: 0,0:00:03.93,0:00:07.11,JP-SUB,,0,0,0,,Сол сатқынды желге ұшырған мен едім.
Dialogue: 0,0:00:07.44,0:00:10.95,JP-SUB,,0,0,0,,Одан да жақсы, Премьер-министр мырза.
Dialogue: 0,0:00:11.53,0:00:12.53,JP-SUB,,0,0,0,,Қандай ұят.
Dialogue: 0,0:00:12.86,0:00:14.69,JP-SUB,,0,0,0,,Бұл мағынасыз.
Dialogue: 0,0:00:15.06,0:00:18.42,JP-SUB,,0,0,0,,Білсеңдер мені тез шешіңдерші.
Dialogue: 0,0:00:18.98,0:00:21.93,JP-SUB,,0,0,0,,Мен тек жақсы көретіндіктен мұндай жерде жүрген сияқты емеспін.
Dialogue: 0,0:00:23.55,0:00:24.26,JP-SUB,,0,0,0,,Не болды?
Dialogue: 0,0:00:25.40,0:00:28.80,JP-SUB,,0,0,0,,Сізден осылай бас тарту мүмкіндігі бар ма?
Dialogue: 0,0:00:30.44,0:00:31.46,JP-SUB,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:00:55.97,0:00:59.85,OP JP,,0,0,0,,Неліктен жұмбақ шешу керек
Dialogue: 0,0:01:00.14,0:01:03.25,OP JP,,0,0,0,,Соңғы бөлім
Dialogue: 0,0:01:03.40,0:01:07.25,OP JP,,0,0,0,,Іздейтін жерде емес
Dialogue: 0,0:01:07.58,0:01:10.53,OP JP,,0,0,0,,Қорқыныштан қашып кету
Dialogue: 0,0:01:10.66,0:01:14.19,OP JP,,0,0,0,,Айнымас жойылуға
Dialogue: 0,0:01:14.39,0:01:17.84,OP JP,,0,0,0,,Сенімсіз өзін-өзі бағалау
Dialogue: 0,0:01:18.21,0:01:21.69,OP JP,,0,0,0,,тірі қал мен жете алмаймын
Dialogue: 0,0:01:21.97,0:01:27.66,OP JP,,0,0,0,,Жасырын естеліктердің кейінгі бейнесінде
Dialogue: 0,0:01:28.16,0:01:32.33,OP JP,,0,0,0,,Шексіз ҚАРА ҰЯТТЫ босатыңыз
Dialogue: 0,0:01:32.58,0:01:36.06,OP JP,,0,0,0,,Осы нәзік дүниенің соңы
Dialogue: 0,0:01:36.23,0:01:40.41,OP JP,,0,0,0,,Ұмытқан тынысым - үнсіздік
Dialogue: 0,0:01:40.41,0:01:44.06,OP JP,,0,0,0,,Көз алдымызға жайылған лас
Dialogue: 0,0:01:44.06,0:01:47.14,OP JP,,0,0,0,,Қараңғыда жерленген
Dialogue: 0,0:01:47.29,0:01:50.38,OP JP,,0,0,0,,Тексерілді, біз білеміз
Dialogue: 0,0:01:50.90,0:01:56.79,OP JP,,0,0,0,,Өтпелі екпінділікте
Dialogue: 0,0:01:57.26,0:02:01.44,OP JP,,0,0,0,,Еркін қараңыз
Dialogue: 0,0:02:14.22,0:02:16.98,JP-SUB,,0,0,0,,Мен сендерге табиғаттан тыс күші бар балаларды бермеймін.
Dialogue: 0,0:02:17.38,0:02:20.98,JP-SUB,,0,0,0,,Сіз өмір бойы торда өмір сүремін дейсіз бе?
Dialogue: 0,0:02:21.62,0:02:23.75,JP-SUB,,0,0,0,,Хитоми сіздің көшбасшыңыз болды.
Dialogue: 0,0:02:23.91,0:02:26.15,JP-SUB,,0,0,0,,Одан аулақ болғың келетін сияқты.
Dialogue: 0,0:02:26.73,0:02:28.75,JP-SUB,,0,0,0,,Балалар, сендермен осы жерден кету дегенді білдіреді
Dialogue: 0,0:02:29.04,0:02:31.11,JP-SUB,,0,0,0,,өмір бойы қуу дегенді білдіреді
Dialogue: 0,0:02:31.40,0:02:32.44,JP-SUB,,0,0,0,,Қылмыскер ретінде
Dialogue: 0,0:02:34.13,0:02:35.62,JP-SUB,,0,0,0,,Хитоми айтты
Dialogue: 0,0:02:36.00,0:02:38.44,JP-SUB,,0,0,0,,Мені ұлттық ит ретінде өсіргенді жөн көремін.
Dialogue: 0,0:02:38.75,0:02:40.89,JP-SUB,,0,0,0,,Айдалада аман қалған жақсы
Dialogue: 0,0:02:42.44,0:02:43.71,JP-SUB,,0,0,0,,Ит болмау
Dialogue: 0,0:02:44.04,0:02:45.64,JP-SUB,,0,0,0,,Біз бұған жол бермейміз.
Dialogue: 0,0:02:45.95,0:02:48.26,JP-SUB,,0,0,0,,Бұл басқалардан бас тартуды білдіреді ме?
Dialogue: 0,0:02:50.69,0:02:51.42,JP-SUB,,0,0,0,,уақытша
Dialogue: 0,0:02:53.20,0:02:55.86,JP-SUB,,0,0,0,,Уақытша келісімшарт бойынша Хитоми мырзаның соңынан еріп жүрген сізге.
Dialogue: 0,0:02:56.20,0:02:57.20,JP-SUB,,0,0,0,,Біз не білеміз?
Dialogue: 0,0:03:03.84,0:03:07.26,JP-SUB,,0,0,0,,Табиғаттан тыс балаларды және Хитомиді де құтқарыңыз
Dialogue: 0,0:03:07.93,0:03:09.62,JP-SUB,,0,0,0,,Мен ешкімді ешқашан тастамаймын
Dialogue: 0,0:03:13.42,0:03:16.53,JP-SUB,,0,0,0,,Неге сонша тырысып жатырсың, Огами-кун?
Dialogue: 0,0:03:16.93,0:03:19.02,JP-SUB,,0,0,0,,Хитоми бомбасын тоқтатыңыз
Dialogue: 0,0:03:19.33,0:03:20.82,JP-SUB,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:03:20.98,0:03:23.00,JP-SUB,,0,0,0,,Менің еркіне қарамастан
Dialogue: 0,0:03:23.09,0:03:25.22,JP-SUB,,0,0,0,,Уақыты келгенде жарылыңыз
Dialogue: 0,0:03:25.62,0:03:27.49,JP-SUB,,0,0,0,,Бұл осылай жұмыс істейді
Dialogue: 0,0:03:31.58,0:03:32.86,JP-SUB,,0,0,0,,Хитоми-сенпай-доно
Dialogue: 0,0:03:34.15,0:03:38.13,JP-SUB,,0,0,0,,Әлемнің өзгеретін сәтіне бірге куә болайық.
Dialogue: 0,0:03:38.66,0:03:43.15,JP-SUB,,0,0,0,,Адамдар қорқады және бізді табиғаттан тыс тіршілік иелеріне ұмтылады.
Dialogue: 0,0:03:43.38,0:03:44.75,JP-SUB,,0,0,0,,Сол сәт
Dialogue: 0,0:03:46.38,0:03:50.75,JP-SUB,,0,0,0,,Енді ешкім жалғыз өлуі керек.
Dialogue: 0,0:03:51.55,0:03:55.35,JP-SUB,,0,0,0,,Күн сәулесінің астында өмір сүретін әлем келе жатыр.
Dialogue: 0,0:03:57.09,0:03:59.20,JP-SUB,,0,0,0,,Мен отставкаға кетемін, Хитоми-сенпай.
Dialogue: 0,0:04:02.24,0:04:05.11,JP-SUB,,0,0,0,,О, сен сүйкімді бүлікші екенсің.
Dialogue: 0,0:04:06.51,0:04:07.24,JP-SUB,,0,0,0,,Күшік
Dialogue: 0,0:04:07.69,0:04:10.06,JP-SUB,,0,0,0,,Огами-кун, отырыңыз, қараңызшы.
Dialogue: 0,0:04:11.18,0:04:11.93,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:04:14.06,0:04:15.00,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:04:15.53,0:04:16.86,JP-SUB,,0,0,0,,Сіз әлі де мотивациясыз ба?
Dialogue: 0,0:04:17.40,0:04:18.62,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:04:19.11,0:04:21.18,JP-SUB,,0,0,0,,Сен неге тұрасың?
Dialogue: 0,0:04:21.73,0:04:23.00,JP-SUB,,0,0,0,,Мен айттым
Dialogue: 0,0:04:23.00,0:04:25.00,JP-SUB,,0,0,0,,Бомбаны енді тоқтата алмаймыз дейді.
Dialogue: 0,0:04:25.13,0:04:31.06,JP-SUB,,0,0,0,,Хитоми: Бомба көп адамды өлтіреді.
Dialogue: 0,0:04:32.04,0:04:35.80,JP-SUB,,0,0,0,,Бұл сізсіз, бұл кодты ажыратқыштың нөлдік коды
Dialogue: 0,0:04:36.04,0:04:37.24,JP-SUB,,0,0,0,,Сіз адамдарға қарайсыз ба?
Dialogue: 0,0:04:37.53,0:04:39.15,JP-SUB,,0,0,0,,Мен білетін адамдар
Dialogue: 0,0:04:40.82,0:04:41.53,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:04:41.53,0:04:43.42,JP-SUB,,0,0,0,,Кодты ажыратқыш?
Dialogue: 0,0:04:44.06,0:04:45.29,JP-SUB,,0,0,0,,Бұл қоқыс
Dialogue: 0,0:04:46.38,0:04:49.33,JP-SUB,,0,0,0,,Огами-кун, байқаған боларсың.
Dialogue: 0,0:04:49.86,0:04:51.80,JP-SUB,,0,0,0,,Едем бұйырған өлтіру
Dialogue: 0,0:04:52.00,0:04:55.98,JP-SUB,,0,0,0,,Сайып келгенде, бұл әрқашан елге және Едемге тиімді болады.
Dialogue: 0,0:04:56.93,0:04:59.20,JP-SUB,,0,0,0,,Сіз өртеп жіберген бандиттер
Dialogue: 0,0:04:59.71,0:05:02.91,JP-SUB,,0,0,0,,Олар маған көмектескендіктен байқалды.
Dialogue: 0,0:05:04.33,0:05:06.78,JP-SUB,,0,0,0,,Сұмдық жасайтын банда.
Dialogue: 0,0:05:07.26,0:05:08.93,JP-SUB,,0,0,0,,Басқа да көп
Dialogue: 0,0:05:09.86,0:05:11.04,JP-SUB,,0,0,0,,Бұл өрістерге де қатысты.
Dialogue: 0,0:05:11.53,0:05:14.53,JP-SUB,,0,0,0,,Ол маған ақпарат беріп жатқандықтан өлтірілді.
Dialogue: 0,0:05:15.02,0:05:17.11,JP-SUB,,0,0,0,,G Falcon жігіттерімен де солай.
Dialogue: 0,0:05:17.58,0:05:21.09,JP-SUB,,0,0,0,,Гангстерлерді ескерту үшін үлгі ретінде таңдалды.
Dialogue: 0,0:05:21.95,0:05:23.69,JP-SUB,,0,0,0,,Көп зұлымдықты елемеу
Dialogue: 0,0:05:23.98,0:05:27.13,JP-SUB,,0,0,0,,Едемге ыңғайсыз нәрселерді таңдап, оларды жамандық деп атайды
Dialogue: 0,0:05:28.15,0:05:30.26,JP-SUB,,0,0,0,,Ал біз қолымызды таза ұстаймыз
Dialogue: 0,0:05:30.49,0:05:33.02,JP-SUB,,0,0,0,,Өлтіру үшін кодты ажыратқышты пайдалану
Dialogue: 0,0:05:34.26,0:05:36.44,JP-SUB,,0,0,0,,Сіз мақтанасыз ба?
Dialogue: 0,0:05:36.98,0:05:40.93,JP-SUB,,0,0,0,,Эден сатып алған кодты бұзушы болу
Dialogue: 0,0:05:41.18,0:05:42.11,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:05:43.33,0:05:45.53,JP-SUB,,0,0,0,,Қарғыс атқан ұрық метаморфозға ұшыраған жағдайда—
Dialogue: 0,0:05:45.62,0:05:46.73,JP-SUB,,0,0,0,,Толық өмір сүріңіз
Dialogue: 0,0:05:46.84,0:05:47.69,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:05:47.80,0:05:50.13,JP-SUB,,0,0,0,,Жын болсаң да, Әке - әке
Dialogue: 0,0:05:50.13,0:05:51.55,JP-SUB,,0,0,0,,Хинотаманның идиоты
Dialogue: 0,0:05:51.55,0:05:52.71,JP-SUB,,0,0,0,,Кел мені өлтір
Dialogue: 0,0:05:52.71,0:05:54.04,JP-SUB,,0,0,0,,Чиса Кешіріңіз
Dialogue: 0,0:05:54.66,0:05:55.64,JP-SUB,,0,0,0,,Жану
Dialogue: 0,0:05:56.58,0:05:57.73,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:05:58.71,0:06:01.13,JP-SUB,,0,0,0,,Огами-кун, бірге күресейік
Dialogue: 0,0:06:04.24,0:06:05.71,JP-SUB,,0,0,0,,Бірге күресейік
Dialogue: 0,0:06:08.13,0:06:08.91,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:06:09.93,0:06:12.38,JP-SUB,,0,0,0,,Табиғаттан тыс жаратылыстар әлемінде бірге әділеттілік
Dialogue: 0,0:06:15.13,0:06:15.93,JP-SUB,,0,0,0,,Шығып бара жатырсың ба?
Dialogue: 0,0:06:17.18,0:06:17.89,JP-SUB,,0,0,0,,бірге
Dialogue: 0,0:06:22.75,0:06:23.66,JP-SUB,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:06:24.51,0:06:25.73,JP-SUB,,0,0,0,,Едем - зұлымдық
Dialogue: 0,0:06:26.69,0:06:27.53,JP-SUB,,0,0,0,,Тек адамдарға қарау
Dialogue: 0,0:06:28.18,0:06:30.71,JP-SUB,,0,0,0,,Ыңғайлы себептермен өлтіргендер
Dialogue: 0,0:06:31.09,0:06:32.06,JP-SUB,,0,0,0,,Сізге де солай.
Dialogue: 0,0:06:33.69,0:06:35.40,JP-SUB,,0,0,0,,Жазықсыз адамдарды өлтірдің
Dialogue: 0,0:06:36.09,0:06:38.89,JP-SUB,,0,0,0,,«Бір нәрсені қорғау, бірақ оны бермеу» сияқты өзімшілдік сөздерді айту
Dialogue: 0,0:06:39.13,0:06:42.02,JP-SUB,,0,0,0,,Өз мақсатына жету үшін көптеген адамдарды өлтірді
Dialogue: 0,0:06:44.53,0:06:45.62,JP-SUB,,0,0,0,,Сен зұлымсың
Dialogue: 0,0:06:46.60,0:06:47.62,JP-SUB,,0,0,0,,Мен де
Dialogue: 0,0:06:48.04,0:06:50.71,JP-SUB,,0,0,0,,Көп жамандықты өлтірген зұлымдық.
Dialogue: 0,0:06:51.38,0:06:51.91,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:06:52.71,0:06:53.98,JP-SUB,,0,0,0,,Дәл сол зұлымдық болса
Dialogue: 0,0:06:54.24,0:06:58.71,JP-SUB,,0,0,0,,Мен адамдарды қорғау үшін соңғы сәтке дейін күресемін.
Dialogue: 0,0:06:58.86,0:07:02.60,JP-SUB,,0,0,0,,Мен біреуді соңғы сәтке дейін құтқаратын адам болғым келеді.
Dialogue: 0,0:07:04.89,0:07:06.84,JP-SUB,,0,0,0,,Мен сенімен ұрыспаймын
Dialogue: 0,0:07:07.55,0:07:09.89,JP-SUB,,0,0,0,,Мен кодты бұзушымын
Dialogue: 0,0:07:10.95,0:07:12.80,JP-SUB,,0,0,0,,Бұл ұят, Огами-кун.
Dialogue: 0,0:07:14.80,0:07:16.86,JP-SUB,,0,0,0,,Ең болмаса өз қолыммен жіберейін.
Dialogue: 0,0:07:18.51,0:07:19.22,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:07:24.35,0:07:25.73,JP-SUB,,0,0,0,,Пайдасыз заттар
Dialogue: 0,0:07:26.78,0:07:28.20,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:07:29.62,0:07:30.42,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:07:31.66,0:07:33.86,JP-SUB,,0,0,0,,Не болды, Огами-кун?
Dialogue: 0,0:07:34.33,0:07:36.29,JP-SUB,,0,0,0,,Жалын енді пайдалануға жарамсыз ба?
Dialogue: 0,0:07:40.15,0:07:40.89,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:07:44.98,0:07:47.69,JP-SUB,,0,0,0,,Бұл жоғалды, Огами-кун.
Dialogue: 0,0:07:48.51,0:07:49.09,JP-SUB,,0,0,0,,Жоғалған
Dialogue: 0,0:07:50.66,0:07:52.78,JP-SUB,,0,0,0,,Ауырды ма, Огами-кун?
Dialogue: 0,0:07:53.84,0:07:54.73,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:07:55.44,0:07:58.22,JP-SUB,,0,0,0,,Табиғаттан тыс жандардың азабы, тағдыры
Dialogue: 0,0:07:59.04,0:08:00.29,JP-SUB,,0,0,0,,Бірақ Едем
Dialogue: 0,0:08:01.22,0:08:02.18,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:08:02.18,0:08:04.35,JP-SUB,,0,0,0,,Күте тұрыңыз, Хитоми-сенпай.
Dialogue: 0,0:08:06.18,0:08:08.58,JP-SUB,,0,0,0,,Оками сені өлтіруге рұқсат бермейді
Dialogue: 0,0:08:10.60,0:08:12.26,JP-SUB,,0,0,0,,Сен өте жақсы қызсың
Dialogue: 0,0:08:13.04,0:08:15.18,JP-SUB,,0,0,0,,Сіз жақсы ата-ананың қолында өскенсіз, солай емес пе?
Dialogue: 0,0:08:18.35,0:08:22.58,JP-SUB,,0,0,0,,Бастық, олар шынымен жарылыс сигналын жіберді.
Dialogue: 0,0:08:23.38,0:08:25.31,JP-SUB,,0,0,0,,Бомба да картада болды.
Dialogue: 0,0:08:26.04,0:08:27.15,JP-SUB,,0,0,0,,Сөз жоқ
Dialogue: 0,0:08:33.42,0:08:34.40,JP-SUB,,0,0,0,,Иә, бар.
Dialogue: 0,0:08:34.55,0:08:35.82,JP-SUB,,0,0,0,,Уақыт жоқ, асығайық
Dialogue: 0,0:08:41.22,0:08:42.44,JP-SUB,,0,0,0,,Неліктен балалар?
Dialogue: 0,0:08:42.69,0:08:44.82,JP-SUB,,0,0,0,,Менің ойымша, біз мұны істей аламыз ба?
Dialogue: 0,0:08:45.29,0:08:47.38,JP-SUB,,0,0,0,,Хитоми мырза араласпа деді.
Dialogue: 0,0:08:48.11,0:08:50.24,JP-SUB,,0,0,0,,Табиғаттан тыс күштері бар барлық адамдар үшін
Dialogue: 0,0:08:50.24,0:08:53.82,JP-SUB,,0,0,0,,Қараңдаршы, біз мұнда не үшін келдік?
Dialogue: 0,0:08:54.09,0:08:55.29,JP-SUB,,0,0,0,,Бұл қауіпті, аулақ болыңыз.
Dialogue: 0,0:08:55.29,0:08:55.93,JP-SUB,,0,0,0,,Жақынбаңыз
Dialogue: 0,0:08:57.86,0:08:58.78,JP-SUB,,0,0,0,,Дайсуке-сан
Dialogue: 0,0:09:02.73,0:09:04.42,JP-SUB,,0,0,0,,Огами-кунмен және басқалармен бірдей күш
Dialogue: 0,0:09:15.20,0:09:16.26,JP-SUB,,0,0,0,,Шығу
Dialogue: 0,0:09:17.44,0:09:18.91,JP-SUB,,0,0,0,,Мен қазір жұмыстан шығамын
Dialogue: 0,0:09:21.31,0:09:24.26,JP-SUB,,0,0,0,,Мен қазір тастаймын, Хитоми-сенпай.
Dialogue: 0,0:09:25.42,0:09:27.55,JP-SUB,,0,0,0,,Огами-кунды өзің қорғайсың ба?
Dialogue: 0,0:09:28.11,0:09:29.46,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:09:29.95,0:09:32.98,JP-SUB,,0,0,0,,Мен өзімді сондай таза сезінемін, бұл керемет деп ойлаймын.
Dialogue: 0,0:09:33.98,0:09:34.73,JP-SUB,,0,0,0,,Бірақ
Dialogue: 0,0:09:37.53,0:09:39.98,JP-SUB,,0,0,0,,Мұндай нәрселер әлемді өзгертпейді.
Dialogue: 0,0:09:45.02,0:09:46.84,JP-SUB,,0,0,0,,Жолыма бөгет болсаң, мен аямаймын.
Dialogue: 0,0:09:49.93,0:09:53.95,JP-SUB,,0,0,0,,Табиғаттан тыс күштер сізге әсер етпейтіндіктен, мұны істеудің жалғыз жолы.
Dialogue: 0,0:09:54.62,0:09:55.95,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:09:56.09,0:09:57.22,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:09:57.42,0:10:00.75,JP-SUB,,0,0,0,,Дәл қазір бұл балаға көмектесуге күшің жетпейді.
Dialogue: 0,0:10:01.18,0:10:02.02,JP-SUB,,0,0,0,,Қуатсыз
Dialogue: 0,0:10:02.71,0:10:04.71,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:10:05.24,0:10:07.02,JP-SUB,,0,0,0,,Жарылыс уақыты жақын.
Dialogue: 0,0:10:07.66,0:10:10.62,JP-SUB,,0,0,0,,Маған тезірек Code Breaker көмектесіңізші
Dialogue: 0,0:10:11.98,0:10:15.31,JP-SUB,,0,0,0,,Сіз мені жалғыз қалдыруды жоспарлап отырсыз ба?
Dialogue: 0,0:10:17.38,0:10:22.78,JP-SUB,,0,0,0,,Премьер-министрдің өліміне және 50 000 адамның қырылуына куә болған соң, мен бұл баланы өлтіремін.
Dialogue: 0,0:10:24.58,0:10:28.86,JP-SUB,,0,0,0,,Мен көптеген код бұзушылардың өлгенін көрдім.
Dialogue: 0,0:10:29.00,0:10:30.35,JP-SUB,,0,0,0,,Сіз де білуіңіз керек.
Dialogue: 0,0:10:31.62,0:10:34.22,JP-SUB,,0,0,0,,Өзін дәрменсіз сезіну және қорғай алмау
Dialogue: 0,0:10:34.62,0:10:37.22,JP-SUB,,0,0,0,,Хитоми-сенпай-доно, бұл жақсы емес.
Dialogue: 0,0:10:37.82,0:10:41.51,JP-SUB,,0,0,0,,Бұндай заттарды жарып жібермеңіз
Dialogue: 0,0:10:42.98,0:10:48.11,JP-SUB,,0,0,0,,Табиғаттан тыс тіршілік иелері күн сәулесінің астында өмір сүре алатын дәуір басталады.
Dialogue: 0,0:10:49.75,0:10:53.42,JP-SUB,,0,0,0,,Ешкімге білмей ажал тағдырынан құтылу
Dialogue: 0,0:10:54.42,0:10:56.11,JP-SUB,,0,0,0,,Жалғыз күндер аяқталады
Dialogue: 0,0:10:57.62,0:10:59.80,JP-SUB,,0,0,0,,Бұл біздің жеңісіміз.
Dialogue: 0,0:11:14.24,0:11:16.00,JP-SUB,,0,0,0,,Сіз оны тоқтаттыңыз ба?
Dialogue: 0,0:11:18.02,0:11:18.91,JP-SUB,,0,0,0,,Бітті ме?
Dialogue: 0,0:11:19.24,0:11:20.49,JP-SUB,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:21.91,0:11:22.71,JP-SUB,,0,0,0,,Жарайды
Dialogue: 0,0:11:23.02,0:11:24.35,JP-SUB,,0,0,0,,Жоқ, әйтеуір
Dialogue: 0,0:11:29.20,0:11:30.18,JP-SUB,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:11:30.62,0:11:32.11,JP-SUB,,0,0,0,,Маған қол соғуға рұқсат берілді.
Dialogue: 0,0:11:33.06,0:11:33.84,JP-SUB,,0,0,0,,Хайке
Dialogue: 0,0:11:34.91,0:11:35.78,JP-SUB,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:11:41.33,0:11:43.02,JP-SUB,,0,0,0,,Бітті, екінші нөмір.
Dialogue: 0,0:11:44.91,0:11:47.80,JP-SUB,,0,0,0,,Менің нұсқауым бойынша Юки-кун мен үшін жұмыс істеді.
Dialogue: 0,0:11:48.44,0:11:50.73,JP-SUB,,0,0,0,,Мен табиғаттан тыс күші бар балаларға берілмеймін.
Dialogue: 0,0:11:55.78,0:11:56.71,JP-SUB,,0,0,0,,«Мен… мен адаммын.»
Dialogue: 0,0:12:00.58,0:12:02.31,JP-SUB,,0,0,0,,Жарылыс болған жоқ
Dialogue: 0,0:12:02.71,0:12:04.40,JP-SUB,,0,0,0,,Операция сәтсіз болды ма?
Dialogue: 0,0:12:07.93,0:12:08.51,JP-SUB,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:12:16.18,0:12:19.73,JP-SUB,,0,0,0,,Хейкенің нұсқауымен балалар басқа жерге көшірілді.
Dialogue: 0,0:12:20.62,0:12:23.35,JP-SUB,,0,0,0,,Сіз бұл үшін уақытты сатып аласыз.
Dialogue: 0,0:12:24.22,0:12:26.29,JP-SUB,,0,0,0,,Мен өлтірілгендей кейіп таныттым.
Dialogue: 0,0:12:26.66,0:12:29.40,JP-SUB,,0,0,0,,Хитоми мырза жоспарды бұзу үшін алдап жатыр.
Dialogue: 0,0:12:29.75,0:12:31.53,JP-SUB,,0,0,0,,Барлығы Хайкенің бақылауында.
Dialogue: 0,0:12:32.29,0:12:32.91,JP-SUB,,0,0,0,,Сонымен
Dialogue: 0,0:12:35.86,0:12:38.49,JP-SUB,,0,0,0,,Не, Юкинко, сен әлі осындасың ба?
Dialogue: 0,0:12:42.29,0:12:43.20,JP-SUB,,0,0,0,,Сау болыңыз Юки
Dialogue: 0,0:12:43.53,0:12:44.29,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:12:47.98,0:12:49.40,JP-SUB,,0,0,0,,Сіз қашып кеттіңіз бе...?
Dialogue: 0,0:12:54.15,0:12:56.62,JP-SUB,,0,0,0,,Мен көремін. Солай ма?
Dialogue: 0,0:12:57.29,0:12:58.11,JP-SUB,,0,0,0,,Хайке
Dialogue: 0,0:12:59.15,0:13:02.06,JP-SUB,,0,0,0,,Мен бұл стратегияны қалай ойлап таптым?
Dialogue: 0,0:13:03.02,0:13:05.51,JP-SUB,,0,0,0,,Бұл табиғаттан тыс күштерге ие адамдарды құтқару үшін болса да.
Dialogue: 0,0:13:05.80,0:13:07.53,JP-SUB,,0,0,0,,Эйс бітті
Dialogue: 0,0:13:09.22,0:13:09.98,JP-SUB,,0,0,0,,Хайке
Dialogue: 0,0:13:14.71,0:13:18.91,JP-SUB,,0,0,0,,Эйс Егер сіз өзіңіздің табиғаттан тыс қабілеттеріңізді соншалықты көп пайдалансаңыз, сіз оларды жоғалтасыз.
Dialogue: 0,0:13:19.62,0:13:21.62,JP-SUB,,0,0,0,,Тым көп күш қолданбаңыз
Dialogue: 0,0:13:22.04,0:13:25.22,JP-SUB,,0,0,0,,Сізде әлі бір нәрсе істеу керек.
Dialogue: 0,0:13:25.31,0:13:28.00,JP-SUB,,0,0,0,,Мен жеңілмеймін
Dialogue: 0,0:13:32.09,0:13:33.93,JP-SUB,,0,0,0,,Сен не айттың, Эйс?
Dialogue: 0,0:13:39.33,0:13:40.00,JP-SUB,,0,0,0,,Эйс
Dialogue: 0,0:13:44.55,0:13:47.80,JP-SUB,,0,0,0,,Сіз қазір жеңдім деп ойлайсыз ба, Хайке?
Dialogue: 0,0:13:50.04,0:13:53.24,JP-SUB,,0,0,0,,Енді сіз бүкіл ел бойынша бомбаларды жара алмайсыз
Dialogue: 0,0:13:53.80,0:13:55.98,JP-SUB,,0,0,0,,Премьер-министрді Токи-кун құтқарып жатыр.
Dialogue: 0,0:13:56.18,0:13:58.06,JP-SUB,,0,0,0,,Сіздің жоспарыңыз орындалмады.
Dialogue: 0,0:13:58.06,0:14:00.06,JP-SUB,,0,0,0,,Мен сіз өзіңізді жеңдім деп ойлайсыз ба деп сұраймын.
Dialogue: 0,0:14:01.29,0:14:05.00,JP-SUB,,0,0,0,,Неліктен мен Sky Tower-ті соңғы орын ретінде таңдадым деп ойлайсыз?
Dialogue: 0,0:14:05.42,0:14:06.06,JP-SUB,,0,0,0,,осында
Dialogue: 0,0:14:06.80,0:14:08.26,JP-SUB,,0,0,0,,Мені тістеп алса да
Dialogue: 0,0:14:08.73,0:14:12.40,JP-SUB,,0,0,0,,Жоспардың бұрмаланбауын қамтамасыз ету үшін соңғы шара қалды
Dialogue: 0,0:14:14.42,0:14:15.15,JP-SUB,,0,0,0,,Иә.
Dialogue: 0,0:14:15.66,0:14:19.58,JP-SUB,,0,0,0,,Мен өзімнің электр қуатыммен осы аспан мұнарасынан радиотолқындар шығарамын.
Dialogue: 0,0:14:19.69,0:14:21.62,JP-SUB,,0,0,0,,Елдің барлық жерінде бомбаларды жару
Dialogue: 0,0:14:22.13,0:14:25.24,JP-SUB,,0,0,0,,Бұл менің соңғы шайқасым.
Dialogue: 0,0:14:25.46,0:14:27.15,JP-SUB,,0,0,0,,Тоқта, Эйс.
Dialogue: 0,0:14:29.00,0:14:34.15,JP-SUB,,0,0,0,,Мүмкін болса, мен бұл әдісті пайдаланғым келмеді.Хейке
Dialogue: 0,0:14:35.22,0:14:36.80,JP-SUB,,0,0,0,,Жоқ, сен
Dialogue: 0,0:14:37.18,0:14:38.58,JP-SUB,,0,0,0,,Бітті
Dialogue: 0,0:14:48.24,0:14:49.93,JP-SUB,,0,0,0,,Ашуланбаңыз, Премьер-министр.
Dialogue: 0,0:14:50.38,0:14:54.82,JP-SUB,,0,0,0,,Мені қорқытқаны үшін, бірақ мен жарылыстың алдын алған сияқтымын.
Dialogue: 0,0:14:55.13,0:14:56.44,JP-SUB,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:14:57.15,0:14:59.66,JP-SUB,,0,0,0,,Тез шешіп беріңізші.
Dialogue: 0,0:15:01.93,0:15:02.78,JP-SUB,,0,0,0,,Не болды?
Dialogue: 0,0:15:03.26,0:15:06.22,JP-SUB,,0,0,0,,Оның тағдыры енді менің қолымда.
Dialogue: 0,0:15:07.09,0:15:10.13,JP-SUB,,0,0,0,,Мен бұл жігітті өлтірсем, апам босады.
Dialogue: 0,0:15:11.15,0:15:13.95,JP-SUB,,0,0,0,,Сіз не істеп жатырсыз? Мені тез шеш.
Dialogue: 0,0:15:17.11,0:15:18.98,JP-SUB,,0,0,0,,Уақыт Қандай еліктеу?
Dialogue: 0,0:15:19.46,0:15:20.93,JP-SUB,,0,0,0,,Камера сынған
Dialogue: 0,0:15:21.46,0:15:23.62,JP-SUB,,0,0,0,,Бұл көріністі мен ғана көріп отырмын.
Dialogue: 0,0:15:24.02,0:15:26.93,JP-SUB,,0,0,0,,Басыңа не түссе де, шындықты ешкім білмейді.
Dialogue: 0,0:15:26.93,0:15:28.40,JP-SUB,,0,0,0,,тоқтау уақыты
Dialogue: 0,0:15:29.91,0:15:31.82,JP-SUB,,0,0,0,,Құлап қалсаң өлесің.
Dialogue: 0,0:15:32.15,0:15:33.24,JP-SUB,,0,0,0,,Оны тоқтатыңыз.
Dialogue: 0,0:15:33.62,0:15:34.73,JP-SUB,,0,0,0,,Уақыт сұраңыз
Dialogue: 0,0:15:35.33,0:15:37.51,JP-SUB,,0,0,0,,o күзгі күз
Dialogue: 0,0:15:38.40,0:15:41.09,JP-SUB,,0,0,0,,Асыққан дұрыс емес.
Dialogue: 0,0:15:42.22,0:15:43.20,JP-SUB,,0,0,0,,Бұл не болып жатыр өзі?!
Dialogue: 0,0:15:47.75,0:15:50.91,JP-SUB,,0,0,0,,Мен кейде осы дәрежеде моксибусты қолдануға тура келеді.
Dialogue: 0,0:15:53.80,0:15:57.93,JP-SUB,,0,0,0,,Сіз қалай ойлайсыз? Сіз ішкеніңізге көңіліңіз толды ма?
Dialogue: 0,0:15:59.20,0:16:01.58,JP-SUB,,0,0,0,,Бұл тамаша қойылым болар еді.
Dialogue: 0,0:16:02.09,0:16:04.82,JP-SUB,,0,0,0,,Бірақ бұл мүмкіндікті неге пайдаланбасқа?
Dialogue: 0,0:16:05.00,0:16:06.58,JP-SUB,,0,0,0,,Бұл үй жануары ма?
Dialogue: 0,0:16:07.51,0:16:11.26,JP-SUB,,0,0,0,,Жарылысты пайдаланып, мені тастап кетсеңіз де
Dialogue: 0,0:16:11.26,0:16:13.69,JP-SUB,,0,0,0,,Сіз өз қолыңызбен бір нәрсе жасауға қорқасыз ба?
Dialogue: 0,0:16:14.31,0:16:16.42,JP-SUB,,0,0,0,,Сіз шынымен де жақсы емессіз.
Dialogue: 0,0:16:16.95,0:16:20.82,JP-SUB,,0,0,0,,Нене дыбысын кодты ажыратқыш ретінде пайдалануым керек пе?
Dialogue: 0,0:16:20.82,0:16:23.73,JP-SUB,,0,0,0,,Мына қарғыс атқыр әке
Dialogue: 0,0:16:24.00,0:16:25.98,JP-SUB,,0,0,0,,Мен әкеммен дүкен аралауға барамын.
Dialogue: 0,0:16:28.02,0:16:29.95,JP-SUB,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:16:30.35,0:16:34.93,JP-SUB,,0,0,0,,Нененің адамдарды өлтіруін қаламасаң, мойынсұн.
Dialogue: 0,0:16:35.69,0:16:37.29,JP-SUB,,0,0,0,,Бұл уәде.
Dialogue: 0,0:16:37.75,0:16:41.69,JP-SUB,,0,0,0,,Кодты ажыратқыш коды 04
Dialogue: 0,0:16:47.98,0:16:49.86,JP-SUB,,0,0,0,,Қызық енді басталады
Dialogue: 0,0:16:50.09,0:16:51.09,JP-SUB,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:16:52.13,0:16:53.78,JP-SUB,,0,0,0,,Сізге тағы бір нәрсе керек пе?
Dialogue: 0,0:16:54.62,0:16:57.38,JP-SUB,,0,0,0,,Мен сені кез келген уақытта өлтіре аламын.
Dialogue: 0,0:16:57.64,0:16:58.84,JP-SUB,,0,0,0,,Бірақ өлтірме
Dialogue: 0,0:16:59.49,0:17:01.20,JP-SUB,,0,0,0,,Меніңше, сенің өлтіруге батылың жетпейді.
Dialogue: 0,0:17:01.35,0:17:03.35,JP-SUB,,0,0,0,,Мен сен сияқты болып қалмас үшін.
Dialogue: 0,0:17:04.20,0:17:04.98,JP-SUB,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:17:05.78,0:17:08.66,JP-SUB,,0,0,0,,Мен өзім үшін кодты бұзушымын
Dialogue: 0,0:17:09.46,0:17:13.29,JP-SUB,,0,0,0,,Мен оны өз қалауларың үшін пайдаланатын сендер сияқты болмаймын.
Dialogue: 0,0:17:14.04,0:17:15.09,JP-SUB,,0,0,0,,Алдану
Dialogue: 0,0:17:15.55,0:17:16.29,JP-SUB,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:17:19.00,0:17:20.66,JP-SUB,,0,0,0,,Жоқ, Эйс
Dialogue: 0,0:17:24.22,0:17:26.22,JP-SUB,,0,0,0,,Жоқ, Хитоми-сенпай.
Dialogue: 0,0:17:32.98,0:17:34.98,JP-SUB,,0,0,0,,Енді... не?
Dialogue: 0,0:17:42.64,0:17:44.09,JP-SUB,,0,0,0,,Міне, Хитоми-сан.
Dialogue: 0,0:17:47.80,0:17:50.33,JP-SUB,,0,0,0,,Ханзада, аман-есенсің деп үміттенемін.
Dialogue: 0,0:17:50.42,0:17:54.13,JP-SUB,,0,0,0,,Айтайын дегенім, Юки, бүкіл велосипедті ұшырып әкететіндей абайсызда болма.
Dialogue: 0,0:17:54.51,0:17:57.66,JP-SUB,,0,0,0,,Жоқ, мен уақытында үлгермеймін.
Dialogue: 0,0:17:57.93,0:17:58.71,JP-SUB,,0,0,0,,Юки-кун
Dialogue: 0,0:18:00.73,0:18:03.06,JP-SUB,,0,0,0,,Хитоми мырза, мен сізге енді бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:18:04.04,0:18:06.29,JP-SUB,,0,0,0,,Жолыма бөгет болсаңдар, алдымен сендерді өлтіремін.
Dialogue: 0,0:18:08.49,0:18:09.13,JP-SUB,,0,0,0,,№ 5
Dialogue: 0,0:18:14.60,0:18:16.55,JP-SUB,,0,0,0,,Тоқта, №1
Dialogue: 0,0:18:19.04,0:18:20.95,JP-SUB,,0,0,0,,Неліктен сонша өзгерді?
Dialogue: 0,0:18:21.31,0:18:23.58,JP-SUB,,0,0,0,,Қайда барсаң да, ескі No.
Dialogue: 0,0:18:26.82,0:18:27.69,JP-SUB,,0,0,0,,Эйс
Dialogue: 0,0:18:28.40,0:18:29.13,JP-SUB,,0,0,0,,Хитоми мырза
Dialogue: 0,0:18:30.49,0:18:32.62,JP-SUB,,0,0,0,,Сіз мұндай нәрсені жасайтын адам емессіз.
Dialogue: 0,0:18:32.98,0:18:33.84,JP-SUB,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:18:34.06,0:18:36.78,JP-SUB,,0,0,0,,Не болды? Айтыңызшы. №1.
Dialogue: 0,0:18:38.04,0:18:40.13,JP-SUB,,0,0,0,,Сіз ештеңе білмейсіз.
Dialogue: 0,0:18:40.98,0:18:44.53,JP-SUB,,0,0,0,,Адамдардың бірігіп, бір-біріне көмектесіп жатқанын көру керемет.
Dialogue: 0,0:18:45.53,0:18:46.46,JP-SUB,,0,0,0,,Мен оны сағындым
Dialogue: 0,0:18:46.95,0:18:49.38,JP-SUB,,0,0,0,,Мен де бір кездері сол шеңберде болдым.
Dialogue: 0,0:18:50.29,0:18:53.02,JP-SUB,,0,0,0,,Бірақ Иденде кодты ажыратқыш бар.
Dialogue: 0,0:18:53.73,0:18:56.15,JP-SUB,,0,0,0,,Сіз табиғаттан тыс күштері бар адамдарды басқаруды жалғастыра бергенше
Dialogue: 0,0:18:56.44,0:18:59.33,JP-SUB,,0,0,0,,Қатардағы өлім тағдыры өзгеріссіз қалады.
Dialogue: 0,0:19:00.18,0:19:04.20,JP-SUB,,0,0,0,,Иден достарыңызға деген қамқорлық сезімін пайдаланады.
Dialogue: 0,0:19:10.53,0:19:11.95,JP-SUB,,0,0,0,,Сіздің әрекеттеріңіз
Dialogue: 0,0:19:12.58,0:19:14.75,JP-SUB,,0,0,0,,Табиғаттан тыс күшке ие адамдардың болашағы жабық.
Dialogue: 0,0:19:14.75,0:19:16.13,JP-SUB,,0,0,0,,Неге байқамайсың?
Dialogue: 0,0:19:16.51,0:19:20.00,JP-SUB,,0,0,0,,Бұл жазықсыз адамдарды тартуға болмайды дегенді білдірмейді.
Dialogue: 0,0:19:20.00,0:19:20.73,JP-SUB,,0,0,0,,Кінәлі
Dialogue: 0,0:19:21.86,0:19:26.55,JP-SUB,,0,0,0,,Мен қорғауға тырысқан адамдар күнәға толы.
Dialogue: 0,0:19:27.91,0:19:29.24,JP-SUB,,0,0,0,,Олар білмейді
Dialogue: 0,0:19:29.46,0:19:33.29,JP-SUB,,0,0,0,,Олардың тыныштығы үшін өз өмірімізді қатерге тіккеніміз.
Dialogue: 0,0:19:50.84,0:19:52.22,JP-SUB,,0,0,0,,Олар білмейді
Dialogue: 0,0:19:53.11,0:19:55.89,JP-SUB,,0,0,0,,Қанша кодты бұзушы қайтыс болды?
Dialogue: 0,0:19:58.75,0:20:00.71,JP-SUB,,0,0,0,,Бейбітшілікті білмей ләззат алу
Dialogue: 0,0:20:01.26,0:20:03.33,JP-SUB,,0,0,0,,Бейбіт өмірін жалғастырады
Dialogue: 0,0:20:04.15,0:20:05.98,JP-SUB,,0,0,0,,Сіз өзіңізді қорғап жатқаныңызды да байқамайсыз.
Dialogue: 0,0:20:07.20,0:20:09.44,JP-SUB,,0,0,0,,Бұл күнә болмаса ше?
Dialogue: 0,0:20:15.89,0:20:17.53,JP-SUB,,0,0,0,,Қазір бәрі кеш
Dialogue: 0,0:20:18.02,0:20:19.64,JP-SUB,,0,0,0,,Едемнен қуылған күннен бастап
Dialogue: 0,0:20:19.84,0:20:21.29,JP-SUB,,0,0,0,,Әлем өзгерді
Dialogue: 0,0:20:21.49,0:20:22.24,JP-SUB,,0,0,0,,Хитоми мырза
Dialogue: 0,0:20:22.66,0:20:24.11,JP-SUB,,0,0,0,,Мен қарап отырдым
Dialogue: 0,0:20:24.64,0:20:26.46,JP-SUB,,0,0,0,,Хитоми-санның жекпе-жегін көру
Dialogue: 0,0:20:26.84,0:20:29.58,JP-SUB,,0,0,0,,Мен сенің қаншама адамды қорғап тұрғаныңды көрдім.
Dialogue: 0,0:20:29.66,0:20:32.86,JP-SUB,,0,0,0,,Маған көмектескеніңіз есімде.
Dialogue: 0,0:20:39.06,0:20:42.11,JP-SUB,,0,0,0,,Бұлай жасамаңыз.
Dialogue: 0,0:20:42.11,0:20:42.98,JP-SUB,,0,0,0,,Хитоми мырза
Dialogue: 0,0:20:43.84,0:20:46.24,JP-SUB,,0,0,0,,Сіз мұны істемеуіңіз керек.
Dialogue: 0,0:20:52.18,0:20:54.98,JP-SUB,,0,0,0,,Тоқта, Хитоми-сенпай.
Dialogue: 0,0:20:55.82,0:20:56.44,JP-SUB,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:20:57.62,0:20:59.66,JP-SUB,,0,0,0,,Ол саған соңына дейін кедергі жасайды.
Dialogue: 0,0:21:00.42,0:21:02.40,JP-SUB,,0,0,0,,Тоқта, Хитоми-сан.
Dialogue: 0,0:21:05.42,0:21:08.09,JP-SUB,,0,0,0,,Бұл елдің халқы тыныштыққа бөленді.
Dialogue: 0,0:21:08.20,0:21:10.29,JP-SUB,,0,0,0,,Біз жойсақ та
Dialogue: 0,0:21:10.80,0:21:13.38,JP-SUB,,0,0,0,,Мен табиғаттан тыс күштері бар адамдарды босатамын.
Dialogue: 0,0:21:15.15,0:21:16.24,JP-SUB,,0,0,0,,Көзге көз
Dialogue: 0,0:21:17.15,0:21:18.46,JP-SUB,,0,0,0,,Тіске арналған тіс
Dialogue: 0,0:21:19.58,0:21:21.09,JP-SUB,,0,0,0,,Зұлымдыққа зұлымдық
Dialogue: 0,0:21:21.89,0:21:24.26,JP-SUB,,0,0,0,,Сіз өзгердіңіз
Dialogue: 0,0:21:25.62,0:21:26.26,JP-SUB,,0,0,0,,Хитоми
Dialogue: 0,0:21:29.58,0:21:30.26,JP-SUB,,0,0,0,,Бітті
Dialogue: 0,0:21:33.20,0:21:33.71,JP-SUB,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:21:42.09,0:21:43.04,JP-SUB,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:21:47.93,0:21:48.80,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:21:49.58,0:21:51.82,JP-SUB,,0,0,0,,Мәңгілікке зұлымдыққа түскен адам
Dialogue: 0,0:21:52.26,0:21:55.69,JP-SUB,,0,0,0,,Мен сені өртеп жіберемін
Dialogue: 0,0:21:56.66,0:21:59.93,JP-SUB,,0,0,0,,Керемет бұл...құдірет
Dialogue: 0,0:22:02.24,0:22:04.68,ED JP-B,,0,0,0,,Сен де бір күні түсінесің
Dialogue: 0,0:22:04.68,0:22:07.09,ED JP-B,,0,0,0,,Ақ қарға қайда барады
Dialogue: 0,0:22:07.09,0:22:09.77,ED JP-B,,0,0,0,,Ешкімді танымай ұшамыз
Dialogue: 0,0:22:09.77,0:22:12.41,ED JP-B,,0,0,0,,Гүлденген қала
Dialogue: 0,0:22:23.19,0:22:27.32,ED JP-G,,0,0,0,,Тек өмір сүруге себеп іздеу
Dialogue: 0,0:22:27.32,0:22:29.53,ED JP-G,,0,0,0,,Менің бос өзім
Dialogue: 0,0:22:29.53,0:22:32.51,ED JP-G,,0,0,0,,Өйткені бұл ұят
Dialogue: 0,0:22:32.79,0:22:37.63,ED JP-G,,0,0,0,,Біз әлем белгілеген ережелерді ұстанамыз
Dialogue: 0,0:22:37.63,0:22:42.31,ED JP-G,,0,0,0,,Өзіңізді жіберіп, күліңіз.
Dialogue: 0,0:22:43.32,0:22:47.77,ED JP-B,,0,0,0,,Жалаңаш болып, ішкі түйсігіңмен жүр
Dialogue: 0,0:22:47.95,0:22:52.00,ED JP-B,,0,0,0,,Көзден жасырылған шындық
Dialogue: 0,0:22:52.05,0:22:54.46,ED JP-B,,0,0,0,,Ешкім үшін емес
Dialogue: 0,0:22:54.46,0:22:56.57,ED JP-B,,0,0,0,,Шешім қабылданды
Dialogue: 0,0:22:56.57,0:23:01.44,ED JP-B,,0,0,0,,Қара киімдеріңді тастап, тұрыңдар.
Dialogue: 0,0:23:01.69,0:23:03.93,ED JP-B,,0,0,0,,Таза тілек
Dialogue: 0,0:23:03.93,0:23:07.96,ED JP-B,,0,0,0,,Қанатымыз енді жоғалды
Dialogue: 0,0:23:07.96,0:23:10.89,ED JP-B,,0,0,0,,Оны сілкіп таста да, қанатыңды ат
Dialogue: 0,0:23:10.89,0:23:13.25,ED JP-B,,0,0,0,,Қорықпа
Dialogue: 0,0:23:13.37,0:23:18.72,ED JP-B,,0,0,0,,Жауап қараңғылықтан тыс болса
Dialogue: 0,0:23:31.64,0:23:32.42,JP-SUB,,0,0,0,,Токикун
Dialogue: 0,0:23:32.75,0:23:33.46,JP-SUB,,0,0,0,,Юки-кун
Dialogue: 0,0:23:34.02,0:23:34.75,JP-SUB,,0,0,0,,Ханзада сарайы
Dialogue: 0,0:23:35.15,0:23:36.15,JP-SUB,,0,0,0,,Хайке Сенпай
Dialogue: 0,0:23:36.66,0:23:37.80,JP-SUB,,0,0,0,,Хитоми-сенпай-доно
Dialogue: 0,0:23:38.64,0:23:41.06,JP-SUB,,0,0,0,,Келесі кодты бұзушы 13-эпизод
Dialogue: 0,0:23:41.55,0:23:42.80,JP-SUB,,0,0,0,,Құдаймен бірге гүлдейтін гүлдер
Dialogue: 0,0:23:43.51,0:23:45.24,JP-SUB,,0,0,0,,Қоштасу Оками
Dialogue: 0,0:23:46.74,0:23:52.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory