Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.87,0:00:36.75,OP JP,,0,0,0,,Неліктен жұмбақ шешу керек
Dialogue: 0,0:00:37.04,0:00:40.15,OP JP,,0,0,0,,Соңғы бөлім
Dialogue: 0,0:00:40.30,0:00:44.15,OP JP,,0,0,0,,Сіз іздеген жерде емес
Dialogue: 0,0:00:44.48,0:00:47.43,OP JP,,0,0,0,,Қорқыныш сезіміне бой алдыру
Dialogue: 0,0:00:47.56,0:00:51.09,OP JP,,0,0,0,,Айнымас жойылуға
Dialogue: 0,0:00:51.29,0:00:54.74,OP JP,,0,0,0,,Сенімсіз өзін-өзі бағалау
Dialogue: 0,0:00:55.11,0:00:58.59,OP JP,,0,0,0,,тірі қал Мен жете алмаймын
Dialogue: 0,0:00:58.87,0:01:04.56,OP JP,,0,0,0,,Жасырын естеліктердің кейінгі бейнесінде
Dialogue: 0,0:01:05.06,0:01:09.23,OP JP,,0,0,0,,Шексіз ҚАРА ҰЯТТЫ босатыңыз
Dialogue: 0,0:01:09.48,0:01:12.96,OP JP,,0,0,0,,Осы нәзік дүниенің соңы
Dialogue: 0,0:01:13.13,0:01:17.31,OP JP,,0,0,0,,Ұмытқан тынысым - үнсіздік
Dialogue: 0,0:01:17.31,0:01:20.96,OP JP,,0,0,0,,Көз алдымда арам тарады
Dialogue: 0,0:01:20.96,0:01:24.04,OP JP,,0,0,0,,Қараңғыда жерленген
Dialogue: 0,0:01:24.19,0:01:27.28,OP JP,,0,0,0,,Тексерілді, біз білеміз
Dialogue: 0,0:01:27.80,0:01:33.69,OP JP,,0,0,0,,Өтпелі екпінділікте
Dialogue: 0,0:01:34.16,0:01:38.34,OP JP,,0,0,0,,Еркін қараңыз
Dialogue: 0,0:01:53.67,0:01:55.16,JP-SUB,,0,0,0,,Тағы бір жарылыс болды.
Dialogue: 0,0:01:55.44,0:01:56.64,JP-SUB,,0,0,0,,Бұл жолы Киншичо.
Dialogue: 0,0:01:57.27,0:01:59.76,JP-SUB,,0,0,0,,Канда-чан, сен Огамиден естідің бе?
Dialogue: 0,0:02:00.07,0:02:01.18,JP-SUB,,0,0,0,,Әлі ештеңе жоқ
Dialogue: 0,0:02:03.70,0:02:04.70,JP-SUB,,0,0,0,,Хитоми сонда болды ма?
Dialogue: 0,0:02:04.87,0:02:05.56,JP-SUB,,0,0,0,,Оран
Dialogue: 0,0:02:05.81,0:02:07.67,JP-SUB,,0,0,0,,Eden туралы ақпарат пайдалы.
Dialogue: 0,0:02:17.70,0:02:20.84,JP-SUB,,0,0,0,,Қазіргі уақытта Жапонияда көптеген жарылыс болып жатыр.
Dialogue: 0,0:02:21.24,0:02:23.84,JP-SUB,,0,0,0,,Егер сіз сыртта болсаңыз, адам көп жиналатын жерлерден аулақ болыңыз.
Dialogue: 0,0:02:23.98,0:02:25.44,JP-SUB,,0,0,0,,Тезірек үйге қайтыңыз
Dialogue: 0,0:02:27.16,0:02:28.93,JP-SUB,,0,0,0,,Неше айла бар?
Dialogue: 0,0:02:29.33,0:02:31.21,JP-SUB,,0,0,0,,Ең болмаса бомбаның қайда екенін білсек.
Dialogue: 0,0:02:31.38,0:02:33.24,JP-SUB,,0,0,0,,Мен өңдеу тобын жіберемін.
Dialogue: 0,0:02:55.21,0:02:56.27,JP-SUB,,0,0,0,,Ақан
Dialogue: 0,0:02:56.44,0:02:59.61,JP-SUB,,0,0,0,,Көптеген бомбалар қойылды.
Dialogue: 0,0:02:59.98,0:03:02.36,JP-SUB,,0,0,0,,Орналасқан жері белгілі болса да, 1500 орын бар
Dialogue: 0,0:03:03.01,0:03:06.33,JP-SUB,,0,0,0,,Барлығын бір сағатта шешу мүмкін емес.
Dialogue: 0,0:03:06.90,0:03:12.21,JP-SUB,,0,0,0,,Иә, халықтың қирау уақытын қорқып күтуден басқа амалы жоқ.
Dialogue: 0,0:03:12.96,0:03:14.56,JP-SUB,,0,0,0,,және құмар
Dialogue: 0,0:03:15.10,0:03:17.50,JP-SUB,,0,0,0,,Кодексті бұзушы әділеттілік
Dialogue: 0,0:03:21.16,0:03:24.07,JP-SUB,,0,0,0,,Бастық: Хират-гуми ғимараты жарылғалы тұр.
Dialogue: 0,0:03:24.16,0:03:25.56,JP-SUB,,0,0,0,,Кисуги-гуми қауіпсіз.
Dialogue: 0,0:03:25.84,0:03:28.18,JP-SUB,,0,0,0,,Сакура-чанның ұялы телефоны әлі істемей ме?
Dialogue: 0,0:03:28.36,0:03:30.90,JP-SUB,,0,0,0,,Мен көп рет қоңырау шалдым, бірақ ол әлі жұмыс істемейді.
Dialogue: 0,0:03:32.16,0:03:34.90,JP-SUB,,0,0,0,,Жас келіншектің ұялы телефонының GPS ақпараты алынды.
Dialogue: 0,0:03:36.01,0:03:37.30,JP-SUB,,0,0,0,,Sky Tower
Dialogue: 0,0:03:41.84,0:03:42.90,JP-SUB,,0,0,0,,Бомба орналасқан жер
Dialogue: 0,0:03:44.27,0:03:45.76,JP-SUB,,0,0,0,,Бірақ шие гүлдейді
Dialogue: 0,0:03:48.93,0:03:52.38,JP-SUB,,0,0,0,,Така-сан, бүкіл ел бойынша бастықтармен байланысыңыз. Асығыңыз.
Dialogue: 0,0:03:52.87,0:03:55.96,JP-SUB,,0,0,0,,Тағы да, мұны кім жіберді?
Dialogue: 0,0:03:58.41,0:03:59.81,JP-SUB,,0,0,0,,Дереккөзді табыңыз
Dialogue: 0,0:04:00.41,0:04:02.50,JP-SUB,,0,0,0,,Иә, карта да, бейне де.
Dialogue: 0,0:04:02.90,0:04:05.64,JP-SUB,,0,0,0,,Tokyo Tower Tsutenkaku Sapporo TV Tower Sky Tower
Dialogue: 0,0:04:06.18,0:04:07.44,JP-SUB,,0,0,0,,Шетінен соққы
Dialogue: 0,0:04:08.07,0:04:09.90,JP-SUB,,0,0,0,,Бұл бірден радиотолқындарды тарата алатын қондырғы.
Dialogue: 0,0:04:10.01,0:04:11.36,JP-SUB,,0,0,0,,Релелік базаны да назардан тыс қалдырмаңыз.
Dialogue: 0,0:04:11.50,0:04:13.61,JP-SUB,,0,0,0,,Бұл аспан мұнарасы емес пе?
Dialogue: 0,0:04:13.81,0:04:14.36,JP-SUB,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:14.64,0:04:16.27,JP-SUB,,0,0,0,,Мен оны тексеру үшін көтерілдім.
Dialogue: 0,0:04:16.61,0:04:17.84,JP-SUB,,0,0,0,,Мына төбедегідей орын
Dialogue: 0,0:04:18.13,0:04:19.18,JP-SUB,,0,0,0,,Жарайды, абайлайық.
Dialogue: 0,0:04:20.04,0:04:21.13,JP-SUB,,0,0,0,,Түсінемін
Dialogue: 0,0:04:21.36,0:04:24.50,JP-SUB,,0,0,0,,Токи мырза, премьер-министрдің Sky Tower-те болуы мүмкін.
Dialogue: 0,0:04:25.01,0:04:25.87,JP-SUB,,0,0,0,,Бұл рас па?
Dialogue: 0,0:04:25.98,0:04:28.07,JP-SUB,,0,0,0,,Бұл дереу көмекке бару туралы бұйрық.
Dialogue: 0,0:04:29.50,0:04:32.44,JP-SUB,,0,0,0,,Мен оның не екенін білмеймін, бірақ бұл маңызды сияқты.
Dialogue: 0,0:04:33.47,0:04:35.27,JP-SUB,,0,0,0,,Хитоми мен Хайке бейбақтары да сонда болса керек.
Dialogue: 0,0:04:35.47,0:04:37.50,JP-SUB,,0,0,0,,Бұл сәт сізді желпіндіреді
Dialogue: 0,0:04:37.78,0:04:39.81,JP-SUB,,0,0,0,,Канда-чан, Огамиге де хабарласыңыз.
Dialogue: 0,0:04:39.93,0:04:40.33,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:04:40.67,0:04:44.16,JP-SUB,,0,0,0,,Огамиден келген жігіт өздігінен секірді.
Dialogue: 0,0:04:47.81,0:04:48.93,JP-SUB,,0,0,0,,Юкиге не болды?
Dialogue: 0,0:04:54.44,0:04:56.61,JP-SUB,,0,0,0,,4 саны Алға.
Dialogue: 0,0:04:57.41,0:04:59.10,JP-SUB,,0,0,0,,Мен бомба туралы бірдеңе істеймін.
Dialogue: 0,0:04:59.18,0:04:59.76,JP-SUB,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:00.04,0:05:00.78,JP-SUB,,0,0,0,,Бірақ
Dialogue: 0,0:05:00.96,0:05:02.18,JP-SUB,,0,0,0,,Мен білемін
Dialogue: 0,0:05:02.87,0:05:04.38,JP-SUB,,0,0,0,,Өйткені мұнда тау бар.
Dialogue: 0,0:05:04.38,0:05:06.93,JP-SUB,,0,0,0,,Егер сіз оларды бір-бірлеп басып алсаңыз, уақытында үлгермеуіңіз мүмкін.
Dialogue: 0,0:05:07.90,0:05:09.18,JP-SUB,,0,0,0,,Бірақ оны жалғыз қалдырмаңыз
Dialogue: 0,0:05:09.70,0:05:12.41,JP-SUB,,0,0,0,,Оны жай қалдырсақ, көп адамдар зардап шегеді.
Dialogue: 0,0:05:13.61,0:05:15.73,JP-SUB,,0,0,0,,Сіз мұны істей аласыз ба? №3
Dialogue: 0,0:05:16.36,0:05:19.76,JP-SUB,,0,0,0,,Юки-саманың бұл ерекше дыбыстық қабілетін бағаламаңыз.
Dialogue: 0,0:05:24.01,0:05:27.53,JP-SUB,,0,0,0,,Жарайды, солай істедің бе?
Dialogue: 0,0:05:36.33,0:05:37.73,JP-SUB,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:42.33,0:05:44.07,JP-SUB,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:45.78,0:05:49.96,JP-SUB,,0,0,0,,Не, сіз зиянкестерді тексердіңіз бе?
Dialogue: 0,0:05:50.56,0:05:51.87,JP-SUB,,0,0,0,,Мен саған көмектесемін, Хейке.
Dialogue: 0,0:05:52.13,0:05:54.67,JP-SUB,,0,0,0,,Көмек көрсету үлкен мәртебе, Эйс.
Dialogue: 0,0:05:56.56,0:06:00.67,JP-SUB,,0,0,0,,Сағыныш, сенімен осылай болу
Dialogue: 0,0:06:00.96,0:06:04.58,JP-SUB,,0,0,0,,Мен кодты бұзушылар ретінде бірге шайқасқанымыз есімде.
Dialogue: 0,0:06:05.01,0:06:06.04,JP-SUB,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:09.16,0:06:09.90,JP-SUB,,0,0,0,,Хайке
Dialogue: 0,0:06:10.24,0:06:10.98,JP-SUB,,0,0,0,,Бұл не?
Dialogue: 0,0:06:12.27,0:06:13.10,JP-SUB,,0,0,0,,Рахмет
Dialogue: 0,0:06:15.56,0:06:16.53,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:06:17.78,0:06:19.18,JP-SUB,,0,0,0,,Оны шешуге рұқсат етіңіз.
Dialogue: 0,0:06:19.67,0:06:21.27,JP-SUB,,0,0,0,,Жоқ, бұл оған жақындамайды.
Dialogue: 0,0:06:22.04,0:06:23.87,JP-SUB,,0,0,0,,Жоқ, Эйстің өзі
Dialogue: 0,0:06:24.16,0:06:27.84,JP-SUB,,0,0,0,,Әй, Огами-кун өткен күні жоғалып кетті.
Dialogue: 0,0:06:28.36,0:06:30.84,JP-SUB,,0,0,0,,Кемелді Огами-кунның құдіретін көргім келеді.
Dialogue: 0,0:06:31.44,0:06:33.58,JP-SUB,,0,0,0,,Өзгеріс жоқ, Эйс.
Dialogue: 0,0:06:34.10,0:06:37.98,JP-SUB,,0,0,0,,Онда мен Эйстің шайқасына араласпаймын.
Dialogue: 0,0:06:38.10,0:06:39.81,JP-SUB,,0,0,0,,Қорғаныстарыңызды күшейтіңіз
Dialogue: 0,0:06:48.30,0:06:49.10,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:06:50.76,0:06:52.78,JP-SUB,,0,0,0,,Сакуракоджи мырза, жақсысыз ба?
Dialogue: 0,0:06:53.07,0:06:56.44,JP-SUB,,0,0,0,,Мұны қайдан білдің, Огами-кун?
Dialogue: 0,0:06:56.87,0:06:58.47,JP-SUB,,0,0,0,,Кештен бері анау-мынау араладым.
Dialogue: 0,0:06:58.93,0:07:00.33,JP-SUB,,0,0,0,,Мен де сол өзен жағасына бардым.
Dialogue: 0,0:07:00.56,0:07:02.56,JP-SUB,,0,0,0,,Мен сенімен бірге уақыт өткізген барлық жерде
Dialogue: 0,0:07:02.76,0:07:04.21,JP-SUB,,0,0,0,,Мен жан-жақты іздендім
Dialogue: 0,0:07:05.01,0:07:06.47,JP-SUB,,0,0,0,,Мен мұнда боламын деп ешқашан ойламадым.
Dialogue: 0,0:07:08.24,0:07:09.33,JP-SUB,,0,0,0,,Сіз айттыңыз
Dialogue: 0,0:07:10.04,0:07:11.27,JP-SUB,,0,0,0,,Бұл аяқталған кезде
Dialogue: 0,0:07:11.61,0:07:14.44,JP-SUB,,0,0,0,,Көптеген адамдар отбасымен және ғашықтарымен келеді.
Dialogue: 0,0:07:15.53,0:07:16.58,JP-SUB,,0,0,0,,Мұнда ешкім жоқ.
Dialogue: 0,0:07:17.53,0:07:19.56,JP-SUB,,0,0,0,,А, бұл ирониялық.
Dialogue: 0,0:07:20.13,0:07:22.93,JP-SUB,,0,0,0,,Мен де бейбіт жағдайда келгім келді.
Dialogue: 0,0:07:24.61,0:07:27.56,JP-SUB,,0,0,0,,Хитоми-сенпай, бомбаны тоқтат.
Dialogue: 0,0:07:28.24,0:07:30.70,JP-SUB,,0,0,0,,Неліктен Токикунмен және басқалармен хабарласпайсың?
Dialogue: 0,0:07:31.13,0:07:32.96,JP-SUB,,0,0,0,,Хайкемен шайқасқанда бұзылды
Dialogue: 0,0:07:34.78,0:07:39.36,JP-SUB,,0,0,0,,Олай болса мен сенімен біраз уақыт алаңдамай сөйлесе аламын.
Dialogue: 0,0:07:40.24,0:07:42.41,JP-SUB,,0,0,0,,Жарылысты қалай тоқтату керектігін айтыңыз
Dialogue: 0,0:07:45.73,0:07:47.84,JP-SUB,,0,0,0,,Бұл табиғаттан тыс күштері бар нәрсені қорғау үшін болса да.
Dialogue: 0,0:07:48.07,0:07:49.87,JP-SUB,,0,0,0,,Адам өлтіру дұрыс емес.
Dialogue: 0,0:07:50.56,0:07:53.64,JP-SUB,,0,0,0,,Хитоми, сенің істеп жүргенің дұрыс емес.
Dialogue: 0,0:07:53.96,0:07:57.36,JP-SUB,,0,0,0,,Сен әділдіктің одақтасы сияқтысың, Огами-кун.
Dialogue: 0,0:07:57.50,0:07:58.81,JP-SUB,,0,0,0,,Әділдік бір нәрсе емес
Dialogue: 0,0:07:59.04,0:08:02.10,JP-SUB,,0,0,0,,Мен көп адамды өлтірдім. Мен зұлыммын.
Dialogue: 0,0:08:03.73,0:08:06.21,JP-SUB,,0,0,0,,Мен сізге жарылысты қалай тоқтату керектігін айтпаймын.
Dialogue: 0,0:08:08.16,0:08:11.96,JP-SUB,,0,0,0,,Онда мен сені жеңіп, менен сұрауға мәжбүрлеймін.
Dialogue: 0,0:08:15.84,0:08:17.04,JP-SUB,,0,0,0,,Көзге көз
Dialogue: 0,0:08:17.41,0:08:18.73,JP-SUB,,0,0,0,,Тіске арналған тіс
Dialogue: 0,0:08:19.18,0:08:20.81,JP-SUB,,0,0,0,,Жамандыққа зұлымдық
Dialogue: 0,0:08:22.87,0:08:23.87,JP-SUB,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,0:08:26.04,0:08:27.36,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:08:29.93,0:08:32.41,JP-SUB,,0,0,0,,Огами-кун, сен не істеп жатырсың?
Dialogue: 0,0:08:43.64,0:08:44.58,JP-SUB,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:48.67,0:08:52.24,JP-SUB,,0,0,0,,Электр тогының соғуын қылышпен жауып, ток соғудан сақтандыңыз.
Dialogue: 0,0:08:52.78,0:08:56.76,JP-SUB,,0,0,0,,Және электр тогын өткізетін жалын арқылы.
Dialogue: 0,0:08:56.87,0:08:59.87,JP-SUB,,0,0,0,,Сонда сіз менің электр тогының еденге түсуіне жол бердіңіз бе?
Dialogue: 0,0:09:00.41,0:09:02.38,JP-SUB,,0,0,0,,Сіз бұл туралы ойладыңыз, Огами-кун.
Dialogue: 0,0:09:02.84,0:09:05.84,JP-SUB,,0,0,0,,Бірақ бұл мені жеңе алмайды
Dialogue: 0,0:09:09.90,0:09:12.73,JP-SUB,,0,0,0,,Бір уақытта әртүрлі бағыттан шабуылға ұшырау
Dialogue: 0,0:09:12.73,0:09:15.24,JP-SUB,,0,0,0,,Сіз оны жалынмен тоқтата алмайсыз
Dialogue: 0,0:09:19.93,0:09:20.70,JP-SUB,,0,0,0,,Сондай-ақ
Dialogue: 0,0:09:26.76,0:09:27.56,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:09:30.98,0:09:32.96,JP-SUB,,0,0,0,,Тәтті, тіпті мына арқан да...
Dialogue: 0,0:09:33.90,0:09:36.38,JP-SUB,,0,0,0,,Күшік арқанды жұлып алады
Dialogue: 0,0:09:39.38,0:09:41.16,JP-SUB,,0,0,0,,Сәттілік күшік
Dialogue: 0,0:09:42.56,0:09:43.44,JP-SUB,,0,0,0,,Үлкен
Dialogue: 0,0:09:53.70,0:09:55.84,JP-SUB,,0,0,0,,Ол жоғалды.
Dialogue: 0,0:10:00.47,0:10:01.33,JP-SUB,,0,0,0,,Күшік
Dialogue: 0,0:10:01.96,0:10:03.24,JP-SUB,,0,0,0,,Мұндай жағдайда...
Dialogue: 0,0:10:10.38,0:10:11.50,JP-SUB,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:10:12.33,0:10:15.38,JP-SUB,,0,0,0,,Сіз мені жоғалтып алуды күтесіз бе?
Dialogue: 0,0:10:16.07,0:10:18.04,JP-SUB,,0,0,0,,Мен жеңілмеймін
Dialogue: 0,0:10:18.41,0:10:21.93,JP-SUB,,0,0,0,,Бірдеңе болса, алдымен сіз жоғаласыз.
Dialogue: 0,0:10:22.70,0:10:26.44,JP-SUB,,0,0,0,,Әлде алдымен электр тогына күйіп қалуым мүмкін бе?
Dialogue: 0,0:10:27.96,0:10:29.21,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:10:29.70,0:10:32.93,JP-SUB,,0,0,0,,Жарайды, өлгің келмесе, беріл.
Dialogue: 0,0:10:38.16,0:10:40.10,JP-SUB,,0,0,0,,Олай етпесең, өлесің.
Dialogue: 0,0:10:41.36,0:10:43.30,JP-SUB,,0,0,0,,Берілуге болмайды
Dialogue: 0,0:11:04.53,0:11:06.90,JP-SUB,,0,0,0,,Неліктен күресу үшін соншалықты ұзаққа бару керек?
Dialogue: 0,0:11:08.78,0:11:11.18,JP-SUB,,0,0,0,,Код бұзушыларға адалдық таныту
Dialogue: 0,0:11:11.90,0:11:13.21,JP-SUB,,0,0,0,,Премьер-министр туралы бірдеңе
Dialogue: 0,0:11:15.16,0:11:16.10,JP-SUB,,0,0,0,,Сол күні
Dialogue: 0,0:11:18.44,0:11:20.78,JP-SUB,,0,0,0,,Неліктен олар премьер-министрді өлтірмек болды?
Dialogue: 0,0:11:21.87,0:11:22.96,JP-SUB,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:23.33,0:11:25.76,JP-SUB,,0,0,0,,Менің ойымша, бұл әңгіме.
Dialogue: 0,0:11:26.04,0:11:26.87,JP-SUB,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:27.04,0:11:29.33,JP-SUB,,0,0,0,,Мен сөйлесуге бардым.
Dialogue: 0,0:11:31.27,0:11:33.87,JP-SUB,,0,0,0,,Бірақ оны премьер-министр қабылдамады
Dialogue: 0,0:11:34.18,0:11:36.04,JP-SUB,,0,0,0,,Ал мені қуып жіберді.
Dialogue: 0,0:11:37.24,0:11:39.96,JP-SUB,,0,0,0,,Мен айтқанымнан қайтпаған соң
Dialogue: 0,0:11:41.84,0:11:43.81,JP-SUB,,0,0,0,,Маған кенет шабуыл жасалды.
Dialogue: 0,0:11:44.21,0:11:45.64,JP-SUB,,0,0,0,,Агенттерге.
Dialogue: 0,0:11:50.56,0:11:55.16,JP-SUB,,0,0,0,,Қашу барысында агенттердің өлтірілгені өкінішті болды.
Dialogue: 0,0:11:55.16,0:11:57.64,JP-SUB,,0,0,0,,Сонымен премьер-министрге шабуыл жасау нені білдіреді?
Dialogue: 0,0:11:57.98,0:12:00.38,JP-SUB,,0,0,0,,Бұл Иден таратқан жалған ақпарат.
Dialogue: 0,0:12:00.78,0:12:05.04,JP-SUB,,0,0,0,,Сіз мені зұлым етіп, кодты бұзушылардан аластаттыңыз.
Dialogue: 0,0:12:05.67,0:12:06.50,JP-SUB,,0,0,0,,Неге...
Dialogue: 0,0:12:06.81,0:12:11.58,JP-SUB,,0,0,0,,Менің өтінішім жай ғана қабылданбады.
Dialogue: 0,0:12:12.36,0:12:15.33,JP-SUB,,0,0,0,,Кодты бұзушылар қоғамда адам ретінде өмір сүреді
Dialogue: 0,0:12:16.84,0:12:20.44,JP-SUB,,0,0,0,,Бұл кодты ажыратқыштардың бар екенін әлемге мәлім етуді білдіреді.
Dialogue: 0,0:12:21.10,0:12:24.58,JP-SUB,,0,0,0,,Осындай бірдеңе болса, әлем дүр сілкінуі мүмкін.
Dialogue: 0,0:12:25.07,0:12:26.84,JP-SUB,,0,0,0,,Еден одан қорықты.
Dialogue: 0,0:12:28.98,0:12:31.56,JP-SUB,,0,0,0,,Мені қуып жіберді
Dialogue: 0,0:12:33.47,0:12:37.44,JP-SUB,,0,0,0,,Эдемді өзгертудің жалғыз жолы - сырттан қысым жасау.
Dialogue: 0,0:12:37.90,0:12:41.21,JP-SUB,,0,0,0,,Бірақ бұл мен бұл әдісті қолданамын дегенді білдірмейді.
Dialogue: 0,0:12:41.50,0:12:43.16,JP-SUB,,0,0,0,,Бұл, әрине, қорқынышты.
Dialogue: 0,0:12:43.67,0:12:45.84,JP-SUB,,0,0,0,,Бірақ басқа амал жоқ.
Dialogue: 0,0:12:46.84,0:12:47.47,JP-SUB,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:12:49.01,0:12:52.10,JP-SUB,,0,0,0,,Кодты ажыратқыштар туралы ғана ойламаңыз.
Dialogue: 0,0:13:12.27,0:13:13.33,JP-SUB,,0,0,0,,Ол өтсін
Dialogue: 0,0:13:16.67,0:13:19.67,JP-SUB,,0,0,0,,Бізге табиғаттан тыс күштері бар балалар беріледі.
Dialogue: 0,0:13:20.76,0:13:22.98,JP-SUB,,0,0,0,,Ел табиғаттан тыс қабілетке ие адамдарды оқшаулайды.
Dialogue: 0,0:13:23.58,0:13:25.61,JP-SUB,,0,0,0,,Зерттеу нысаны болды
Dialogue: 0,0:13:26.64,0:13:30.38,JP-SUB,,0,0,0,,Кодты бұзушылар ретінде қабілеті жоғары адамдар алынды.
Dialogue: 0,0:13:30.61,0:13:34.27,JP-SUB,,0,0,0,,Мемлекеттің итіндей өлтіру дегенді білдіреді
Dialogue: 0,0:13:35.58,0:13:37.50,JP-SUB,,0,0,0,,Ол үкіметтің бақылауында болғанша
Dialogue: 0,0:13:37.61,0:13:40.16,JP-SUB,,0,0,0,,Табиғаттан тыс күшке ие адамдарда еркіндік жоқ.
Dialogue: 0,0:13:42.67,0:13:45.81,JP-SUB,,0,0,0,,Мен Огами-кун мен Токи-кун ғана емес, сонымен қатар кодты бұзушымын.
Dialogue: 0,0:13:46.58,0:13:50.21,JP-SUB,,0,0,0,,Мен табиғаттан тыс күштермен туатындардың барлығын құтқарғым келеді.
Dialogue: 0,0:13:51.67,0:13:54.58,JP-SUB,,0,0,0,,Мен сіз табиғаттан тыс күшке ие адамдар туралы ойлағаныңызды түсіндім.
Dialogue: 0,0:13:55.18,0:13:57.13,JP-SUB,,0,0,0,,Балалар Чиса-чанды ұнатады
Dialogue: 0,0:13:57.38,0:13:58.93,JP-SUB,,0,0,0,,Егер сізде солай болса
Dialogue: 0,0:13:59.10,0:14:03.13,JP-SUB,,0,0,0,,Менің де адамдар бақытты өмір сүретін әлем құруға деген ұмтылыс бар.
Dialogue: 0,0:14:04.04,0:14:05.36,JP-SUB,,0,0,0,,Бірақ жоқ
Dialogue: 0,0:14:09.56,0:14:10.53,JP-SUB,,0,0,0,,Бұл өте жауапсыздық.
Dialogue: 0,0:14:11.56,0:14:13.50,JP-SUB,,0,0,0,,Мұны істеуге болмайды.
Dialogue: 0,0:14:17.13,0:14:20.78,JP-SUB,,0,0,0,,Бұл маған енді жалғыз жол қалды.
Dialogue: 0,0:14:22.07,0:14:25.36,JP-SUB,,0,0,0,,Мемлекет пайдаланған, өлгендердің кек
Dialogue: 0,0:14:26.16,0:14:27.96,JP-SUB,,0,0,0,,Сіз білмейсіз
Dialogue: 0,0:14:29.24,0:14:31.07,JP-SUB,,0,0,0,,Хитоми-сенпай-доно айтқандай.
Dialogue: 0,0:14:31.24,0:14:33.44,JP-SUB,,0,0,0,,Мен ешқашан білмеймін
Dialogue: 0,0:14:34.04,0:14:36.84,JP-SUB,,0,0,0,,Бірақ неге мұны істейсің?
Dialogue: 0,0:14:37.04,0:14:39.33,JP-SUB,,0,0,0,,Сіз бір кездері қорғауға тырысқан адамдарға
Dialogue: 0,0:14:40.78,0:14:43.47,JP-SUB,,0,0,0,,Өйткені олар қорғайды, бірақ бермейді.
Dialogue: 0,0:14:49.18,0:14:50.50,JP-SUB,,0,0,0,,Не болды, Ю-чан?
Dialogue: 0,0:14:50.90,0:14:52.76,JP-SUB,,0,0,0,,Аспанда адамдар ұшып бара жатты.
Dialogue: 0,0:14:59.50,0:15:00.93,JP-SUB,,0,0,0,,Сажия
Dialogue: 0,0:15:03.44,0:15:05.21,JP-SUB,,0,0,0,,Кем дегенде бір затты бұзбаңыз.
Dialogue: 0,0:15:07.78,0:15:08.50,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:15:09.67,0:15:10.64,JP-SUB,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:12.50,0:15:14.24,JP-SUB,,0,0,0,,Лифт жұмыс істеп тұр, солай емес пе?
Dialogue: 0,0:15:14.93,0:15:17.53,JP-SUB,,0,0,0,,Радиотолқындар бүкіл Жапонияға таралады.
Dialogue: 0,0:15:17.84,0:15:19.27,JP-SUB,,0,0,0,,Хитоми мырза басқару бөлмесінде.
Dialogue: 0,0:15:19.76,0:15:20.56,JP-SUB,,0,0,0,,Мүмкін.
Dialogue: 0,0:15:22.18,0:15:23.76,JP-SUB,,0,0,0,,О, міне, осында
Dialogue: 0,0:15:28.61,0:15:29.30,JP-SUB,,0,0,0,,Мистер Хайке
Dialogue: 0,0:15:29.47,0:15:32.13,JP-SUB,,0,0,0,,Сен мұнда не үшін келдің? Токи-кун
Dialogue: 0,0:15:33.61,0:15:36.30,JP-SUB,,0,0,0,,Мен Хитомиді жарып, бомбаны тоқтату үшін келдім.
Dialogue: 0,0:15:36.44,0:15:38.44,JP-SUB,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:15:39.27,0:15:40.73,JP-SUB,,0,0,0,,Мен сізге кедергі келтірмеймін.
Dialogue: 0,0:15:41.44,0:15:45.50,JP-SUB,,0,0,0,,Демек, сен маған шынымен опасыздық жасадың, Хейке-сенпай.
Dialogue: 0,0:15:45.76,0:15:48.30,JP-SUB,,0,0,0,,Мен өз жұмысымды істеп жатырмын.
Dialogue: 0,0:15:48.67,0:15:51.73,JP-SUB,,0,0,0,,Адамдарды бомбамен өлтіру код бұзушының міндеті ме?
Dialogue: 0,0:15:54.21,0:15:57.36,JP-SUB,,0,0,0,,Мен сені әрқашан жұмбақ адам деп ойлайтынмын.
Dialogue: 0,0:15:57.96,0:16:01.64,JP-SUB,,0,0,0,,Бірақ кодты бұзушы ретінде зұлымдықты жоюға келгенде,
Dialogue: 0,0:16:01.93,0:16:03.61,JP-SUB,,0,0,0,,Менде мақтаныш бар деп ойладым.
Dialogue: 0,0:16:04.18,0:16:04.96,JP-SUB,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:16:06.13,0:16:07.27,JP-SUB,,0,0,0,,Токи мырза
Dialogue: 0,0:16:08.56,0:16:13.04,JP-SUB,,0,0,0,,Токи-кун, сенің мен туралы сонша ойлайтыныңды білмедім.
Dialogue: 0,0:16:13.64,0:16:16.67,JP-SUB,,0,0,0,,Бірақ менің таңдауым жоқ. мен...
Dialogue: 0,0:16:22.78,0:16:24.50,JP-SUB,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:16:24.76,0:16:29.33,JP-SUB,,0,0,0,,Бұл сізді жеңу арқылы код 02 бола алатынымды білдіреді.
Dialogue: 0,0:16:29.33,0:16:30.13,JP-SUB,,0,0,0,,не?
Dialogue: 0,0:16:30.47,0:16:32.33,JP-SUB,,0,0,0,,Рахмет, Хейке-сенпай
Dialogue: 0,0:16:32.50,0:16:34.10,JP-SUB,,0,0,0,,Ал қош бол
Dialogue: 0,0:16:34.27,0:16:35.98,JP-SUB,,0,0,0,,Мен үшін өл
Dialogue: 0,0:16:36.56,0:16:37.84,JP-SUB,,0,0,0,,Көзге көз
Dialogue: 0,0:16:38.18,0:16:39.38,JP-SUB,,0,0,0,,Тіске арналған тіс
Dialogue: 0,0:16:39.67,0:16:41.90,JP-SUB,,0,0,0,,Зұлымдықтың әділет балғасы
Dialogue: 0,0:16:42.10,0:16:44.81,JP-SUB,,0,0,0,,Бұл көрсетілім уақытының басы
Dialogue: 0,0:16:48.27,0:16:49.24,JP-SUB,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:16:49.36,0:16:51.04,JP-SUB,,0,0,0,,Токи-сан Хайке-сан
Dialogue: 0,0:17:00.98,0:17:03.78,JP-SUB,,0,0,0,,Тікелей жуу
Dialogue: 0,0:17:04.64,0:17:05.24,JP-SUB,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:17:06.50,0:17:10.67,JP-SUB,,0,0,0,,Енді, Токи мырза, мен сізді қалай ренжітейін?
Dialogue: 0,0:17:11.10,0:17:12.56,JP-SUB,,0,0,0,,Бұл садист жігіт
Dialogue: 0,0:17:12.70,0:17:14.18,JP-SUB,,0,0,0,,Аузың нашар.
Dialogue: 0,0:17:14.61,0:17:15.90,JP-SUB,,0,0,0,,Жаза
Dialogue: 0,0:17:16.07,0:17:18.21,JP-SUB,,0,0,0,,Он триллион Хейке кландары
Dialogue: 0,0:17:20.47,0:17:24.41,JP-SUB,,0,0,0,,Жарық ақпарат Extreme арқылы көшіріледі
Dialogue: 0,0:17:24.53,0:17:28.07,JP-SUB,,0,0,0,,Демек, күш пен табиғаттан тыс қабілет тең.
Dialogue: 0,0:17:30.58,0:17:31.30,JP-SUB,,0,0,0,,Ақымақ
Dialogue: 0,0:17:31.96,0:17:34.01,JP-SUB,,0,0,0,,Не болды, Токикун?
Dialogue: 0,0:17:34.10,0:17:34.90,JP-SUB,,0,0,0,,Ақымақ
Dialogue: 0,0:17:35.24,0:17:39.96,JP-SUB,,0,0,0,,Мені үрлеп, 02 коды болмайсың ба?
Dialogue: 0,0:17:40.16,0:17:44.10,JP-SUB,,0,0,0,,Әй, мына жылтыр шашты үрлеп жіберсем
Dialogue: 0,0:17:44.30,0:17:46.47,JP-SUB,,0,0,0,,Мен сені тікелей ұрамын
Dialogue: 0,0:17:47.50,0:17:50.21,JP-SUB,,0,0,0,,Мен шештім, бұзықсың.
Dialogue: 0,0:17:50.33,0:17:52.98,JP-SUB,,0,0,0,,Бұл жерде әдемі ештеңе жоқ, Токи-кун.
Dialogue: 0,0:17:53.16,0:17:54.01,JP-SUB,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:17:59.10,0:18:00.30,JP-SUB,,0,0,0,,Жылау
Dialogue: 0,0:18:00.41,0:18:01.38,JP-SUB,,0,0,0,,Бұл сол адам үшін бірдеңе жасағың келуі туралы—
Dialogue: 0,0:18:01.73,0:18:05.24,JP-SUB,,0,0,0,,Бірақ жарық жылдамдығымен салыстырғанда
Dialogue: 0,0:18:05.38,0:18:07.01,JP-SUB,,0,0,0,,Баяу
Dialogue: 0,0:18:16.41,0:18:20.41,JP-SUB,,0,0,0,,Токи мырза магнит өрісі, ал Хейке мырза жарықтың күшімен ұшып келеді.
Dialogue: 0,0:18:22.58,0:18:25.16,JP-SUB,,0,0,0,,Қорғайтындар, бірақ бермейтіндер
Dialogue: 0,0:18:25.70,0:18:27.98,JP-SUB,,0,0,0,,Иә, ақымақ адамдар.
Dialogue: 0,0:18:28.44,0:18:30.98,JP-SUB,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:18:31.07,0:18:33.07,JP-SUB,,0,0,0,,Олар ақымақ адамдар емес.
Dialogue: 0,0:18:34.70,0:18:36.90,JP-SUB,,0,0,0,,Әй, тез келме.
Dialogue: 0,0:18:39.04,0:18:40.33,JP-SUB,,0,0,0,,Мынау болды.
Dialogue: 0,0:18:42.41,0:18:43.30,JP-SUB,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:18:43.53,0:18:45.16,JP-SUB,,0,0,0,,Қыз, жақсысың ба?
Dialogue: 0,0:18:46.21,0:18:48.47,JP-SUB,,0,0,0,,Енді оны әпкеме тапсыруым керек шығар.
Dialogue: 0,0:18:48.87,0:18:50.90,JP-SUB,,0,0,0,,Не істеу керек
Dialogue: 0,0:18:53.01,0:18:54.44,JP-SUB,,0,0,0,,Мұнда бомба бар.
Dialogue: 0,0:18:54.73,0:18:56.47,JP-SUB,,0,0,0,,Қашан жарылатынын білмеймін.
Dialogue: 0,0:18:56.78,0:18:58.67,JP-SUB,,0,0,0,,Сен қауіптісің, менен аулақ жүр.
Dialogue: 0,0:19:01.04,0:19:03.13,JP-SUB,,0,0,0,,Әй, полиция да қозғалды ма?
Dialogue: 0,0:19:03.61,0:19:04.90,JP-SUB,,0,0,0,,Неге балалар?
Dialogue: 0,0:19:05.70,0:19:09.13,JP-SUB,,0,0,0,,Токионың бір жерінде қызым барын салып жүр.
Dialogue: 0,0:19:09.73,0:19:12.61,JP-SUB,,0,0,0,,Егер солай болса, біз де өзімізді дайындаймыз.
Dialogue: 0,0:19:19.13,0:19:22.70,JP-SUB,,0,0,0,,Бұл жерде қауіпті. Үшінші көшедегі саябаққа көшіңіз.
Dialogue: 0,0:19:23.81,0:19:25.04,JP-SUB,,0,0,0,,Көзіңізді жоғалтпаңыз
Dialogue: 0,0:19:25.84,0:19:29.13,JP-SUB,,0,0,0,,Қалай ойлайсыңдар, біз бұл жұмысты не үшін жасаймыз?
Dialogue: 0,0:19:39.33,0:19:41.93,JP-SUB,,0,0,0,,Бұл жер қауіпті. Өтінемін, сыртқа шығыңыз.
Dialogue: 0,0:19:43.30,0:19:44.10,JP-SUB,,0,0,0,,Өңдеу тобы
Dialogue: 0,0:19:44.38,0:19:47.53,JP-SUB,,0,0,0,,Жоқ, орындар тым көп, бізде қызметкерлер жетіспейді.
Dialogue: 0,0:19:47.87,0:19:50.16,JP-SUB,,0,0,0,,Уақыт таяп қалды
Dialogue: 0,0:19:52.10,0:19:54.87,JP-SUB,,0,0,0,,Бейбітшілік үшін аянбай еңбек етіп жүрген адамдар бар.
Dialogue: 0,0:19:55.61,0:20:00.98,JP-SUB,,0,0,0,,Бірақ қорғау үшін бермейтін адам үшін өз өміріңді қатерге тігу ақымақтық.
Dialogue: 0,0:20:01.16,0:20:04.36,JP-SUB,,0,0,0,,Неліктен қорғау үшін бірдеңе бермейсің?
Dialogue: 0,0:20:04.58,0:20:06.70,JP-SUB,,0,0,0,,Сіз мұны түсінбейсіз бе?
Dialogue: 0,0:20:06.96,0:20:11.13,JP-SUB,,0,0,0,,Енді асықпасаң, жарылыс уақыты келеді.
Dialogue: 0,0:20:13.70,0:20:16.76,JP-SUB,,0,0,0,,Уақыты келгенде Премьер-министр де өледі.
Dialogue: 0,0:20:17.47,0:20:18.90,JP-SUB,,0,0,0,,Менің ойымша, бұл шулы.
Dialogue: 0,0:20:18.90,0:20:21.50,JP-SUB,,0,0,0,,Премьер-министрге не үшін көмектесесіз?
Dialogue: 0,0:20:21.64,0:20:23.81,JP-SUB,,0,0,0,,Бұл кодты ажыратқыш болғандықтан ба?
Dialogue: 0,0:20:24.01,0:20:26.24,JP-SUB,,0,0,0,,Бұл маңызды емес шығар.
Dialogue: 0,0:20:27.18,0:20:28.10,JP-SUB,,0,0,0,,Бұл туралы сен бәрінен жақсы білуің керек
Dialogue: 0,0:20:31.47,0:20:33.81,JP-SUB,,0,0,0,,Сен ренжідің, Токикун.
Dialogue: 0,0:20:33.93,0:20:35.58,JP-SUB,,0,0,0,,Сіз шатастырдыңыз ба?
Dialogue: 0,0:20:36.53,0:20:38.96,JP-SUB,,0,0,0,,Уайымдама, жылтыраған бейбақ.
Dialogue: 0,0:20:40.50,0:20:42.36,JP-SUB,,0,0,0,,Айтқыңыз келгені осы ма?
Dialogue: 0,0:20:43.50,0:20:47.21,JP-SUB,,0,0,0,,Сіз қорғамақ болған адамдар
Dialogue: 0,0:20:47.84,0:20:50.58,JP-SUB,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:20:51.01,0:20:53.96,JP-SUB,,0,0,0,,Иә, ақымақтар.
Dialogue: 0,0:20:54.36,0:20:55.98,JP-SUB,,0,0,0,,Мақұлдамаймын
Dialogue: 0,0:20:58.98,0:21:00.16,JP-SUB,,0,0,0,,Сізге бұл ұнайды
Dialogue: 0,0:21:00.41,0:21:02.27,JP-SUB,,0,0,0,,Мен мұны ешқашан мойындамаймын
Dialogue: 0,0:21:06.90,0:21:09.36,JP-SUB,,0,0,0,,Сіз өзіңіздің табиғаттан тыс қабілеттеріңізді біршама пайдаландыңыз.
Dialogue: 0,0:21:09.36,0:21:11.36,JP-SUB,,0,0,0,,Ол жоғалады.
Dialogue: 0,0:21:12.78,0:21:15.53,JP-SUB,,0,0,0,,Токи-кун, бітуге жақын.
Dialogue: 0,0:21:15.84,0:21:18.44,JP-SUB,,0,0,0,,Енді аяқтау уақыты келді.
Dialogue: 0,0:21:19.53,0:21:23.30,JP-SUB,,0,0,0,,Royal Straight Flush
Dialogue: 0,0:21:23.84,0:21:25.24,JP-SUB,,0,0,0,,Жылау
Dialogue: 0,0:21:30.04,0:21:31.76,JP-SUB,,0,0,0,,Ой, солай.
Dialogue: 0,0:21:32.96,0:21:36.07,JP-SUB,,0,0,0,,Сен қалағаныңды істедің, Юкихина.
Dialogue: 0,0:21:36.90,0:21:38.16,JP-SUB,,0,0,0,,Бірақ бәрі аяқталды.
Dialogue: 0,0:21:41.27,0:21:43.93,JP-SUB,,0,0,0,,Енді мен осындамын, мен міндетті түрде осындамын.
Dialogue: 0,0:21:44.58,0:21:46.13,JP-SUB,,0,0,0,,Сен тірісің бе?
Dialogue: 0,0:21:51.13,0:21:53.78,JP-SUB,,0,0,0,,Мен тозақтан оралдым
Dialogue: 0,0:21:56.02,0:21:58.46,ED JP-B,,0,0,0,,Сен де бір күні түсінерсің
Dialogue: 0,0:21:58.46,0:22:00.87,ED JP-B,,0,0,0,,Ақ қарға қайда барады
Dialogue: 0,0:22:00.87,0:22:03.55,ED JP-B,,0,0,0,,Ешкімді танымай ұшамыз
Dialogue: 0,0:22:03.55,0:22:06.19,ED JP-B,,0,0,0,,Жанды қала
Dialogue: 0,0:22:16.97,0:22:21.10,ED JP-G,,0,0,0,,Тек өмір сүруге себеп іздеу
Dialogue: 0,0:22:21.10,0:22:23.31,ED JP-G,,0,0,0,,Менің бос адамым
Dialogue: 0,0:22:23.31,0:22:26.29,ED JP-G,,0,0,0,,Өйткені бұл ұят
Dialogue: 0,0:22:26.57,0:22:31.41,ED JP-G,,0,0,0,,Біз әлем белгілеген ережелерді ұстанамыз
Dialogue: 0,0:22:31.41,0:22:36.09,ED JP-G,,0,0,0,,Жай ғана беріліңіз және күліңіз.
Dialogue: 0,0:22:37.10,0:22:41.55,ED JP-B,,0,0,0,,Жалаңаш болып, ішкі түйсігіңмен жүр
Dialogue: 0,0:22:41.73,0:22:45.78,ED JP-B,,0,0,0,,Көзден жасырылған шындық
Dialogue: 0,0:22:45.83,0:22:48.24,ED JP-B,,0,0,0,,Ешкім үшін емес
Dialogue: 0,0:22:48.24,0:22:50.35,ED JP-B,,0,0,0,,Шешім қабылданды
Dialogue: 0,0:22:50.35,0:22:55.22,ED JP-B,,0,0,0,,Қара киімдеріңді тастап, тұрыңдар.
Dialogue: 0,0:22:55.47,0:22:57.71,ED JP-B,,0,0,0,,Таза тілек
Dialogue: 0,0:22:57.71,0:23:01.74,ED JP-B,,0,0,0,,Қанатымыз енді жоғалды
Dialogue: 0,0:23:01.74,0:23:04.67,ED JP-B,,0,0,0,,Оны сілкіп таста да, қанатыңды ат
Dialogue: 0,0:23:04.67,0:23:07.03,ED JP-B,,0,0,0,,Қорықпа
Dialogue: 0,0:23:07.15,0:23:12.50,ED JP-B,,0,0,0,,Жауап қараңғылықтан тыс болса
Dialogue: 0,0:23:25.67,0:23:28.44,JP-SUB,,0,0,0,,Келесі кодты бұзушы 12-эпизод
Dialogue: 0,0:23:28.93,0:23:30.73,JP-SUB,,0,0,0,,Жын патша Құдай мен адам
Dialogue: 0,0:23:31.50,0:23:32.44,JP-SUB,,0,0,0,,Шие гүлдерін тамашалау
Dialogue: 0,0:23:33.78,0:23:36.50,JP-SUB,,0,0,0,,Мен мұның бәрін аяқтау үшін келдім
Dialogue: 0,0:23:37.30,0:23:38.07,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:23:39.57,0:23:45.57,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory