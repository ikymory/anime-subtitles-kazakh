Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.31,0:00:15.19,OP JP,,0,0,0,,Неліктен жұмбақ шешу керек
Dialogue: 0,0:00:15.48,0:00:18.59,OP JP,,0,0,0,,Соңғы бөлім
Dialogue: 0,0:00:18.74,0:00:22.59,OP JP,,0,0,0,,Сіз іздеген жерде емес
Dialogue: 0,0:00:22.92,0:00:25.87,OP JP,,0,0,0,,Қорқыныш сезіміне бой алдыру
Dialogue: 0,0:00:26.00,0:00:29.53,OP JP,,0,0,0,,Айнымас жойылуға
Dialogue: 0,0:00:29.73,0:00:33.18,OP JP,,0,0,0,,Сенімсіз өзін-өзі бағалау
Dialogue: 0,0:00:33.55,0:00:37.03,OP JP,,0,0,0,,тірі қал Мен жете алмаймын
Dialogue: 0,0:00:37.31,0:00:43.00,OP JP,,0,0,0,,Жасырын естеліктердің кейінгі бейнесінде
Dialogue: 0,0:00:43.50,0:00:47.67,OP JP,,0,0,0,,Шексіз ҚАРА ҰЯТТЫ босатыңыз
Dialogue: 0,0:00:47.92,0:00:51.40,OP JP,,0,0,0,,Осы нәзік дүниенің соңы
Dialogue: 0,0:00:51.57,0:00:55.75,OP JP,,0,0,0,,Ұмытқан тынысым - үнсіздік
Dialogue: 0,0:00:55.75,0:00:59.40,OP JP,,0,0,0,,Көз алдымда арам тарады
Dialogue: 0,0:00:59.40,0:01:02.48,OP JP,,0,0,0,,Қараңғыда жерленген
Dialogue: 0,0:01:02.63,0:01:05.72,OP JP,,0,0,0,,Тексерілді, біз білеміз
Dialogue: 0,0:01:06.24,0:01:12.13,OP JP,,0,0,0,,Өтпелі екпінділікте
Dialogue: 0,0:01:12.60,0:01:16.78,OP JP,,0,0,0,,Еркін қараңыз
Dialogue: 0,0:01:32.29,0:01:33.23,JP-SUB,,0,0,0,,Хиноман
Dialogue: 0,0:01:33.79,0:01:35.01,JP-SUB,,0,0,0,,Чиса да күшейе түсті
Dialogue: 0,0:01:35.71,0:01:38.45,JP-SUB,,0,0,0,,Хинотамандай әділдіктің батыры боламын
Dialogue: 0,0:01:55.01,0:01:57.17,JP-SUB,,0,0,0,,Күтілгендей, бірақ
Dialogue: 0,0:02:03.77,0:02:06.43,JP-SUB,,0,0,0,,Енді балалар
Dialogue: 0,0:02:07.99,0:02:09.15,JP-SUB,,0,0,0,,Не
Dialogue: 0,0:02:09.41,0:02:10.31,JP-SUB,,0,0,0,,Сіз оны пайдалана алмайсыз.
Dialogue: 0,0:02:11.01,0:02:12.71,JP-SUB,,0,0,0,,Қарашы, сен неге қашып барасың?
Dialogue: 0,0:02:12.71,0:02:13.29,JP-SUB,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:02:21.45,0:02:23.55,JP-SUB,,0,0,0,,Бұл пайдалы емес.
Dialogue: 0,0:02:25.95,0:02:26.63,JP-SUB,,0,0,0,,Табата мырза
Dialogue: 0,0:02:27.35,0:02:29.95,JP-SUB,,0,0,0,,Кодты бұзушы учаскеге кірді.
Dialogue: 0,0:02:30.77,0:02:32.61,JP-SUB,,0,0,0,,Шайтан болса да
Dialogue: 0,0:02:33.45,0:02:34.61,JP-SUB,,0,0,0,,Мазаламау
Dialogue: 0,0:02:36.09,0:02:37.09,JP-SUB,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:02:37.41,0:02:40.65,JP-SUB,,0,0,0,,Неліктен мемлекеттік мекемеде табиғаттан тыс күштерге зерттеу жүргізіп жатырсыз?
Dialogue: 0,0:02:41.67,0:02:42.47,JP-SUB,,0,0,0,,Цука?
Dialogue: 0,0:02:42.63,0:02:44.93,JP-SUB,,0,0,0,,Кодты бұзушылар да мемлекеттік органдар болып табылады.
Dialogue: 0,0:02:45.35,0:02:46.07,JP-SUB,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:02:46.51,0:02:50.13,JP-SUB,,0,0,0,,Огами екеуміз де премьер-министрдің бұйрығын орындаймыз.
Dialogue: 0,0:02:50.21,0:02:51.79,JP-SUB,,0,0,0,,Премьер-министр
Dialogue: 0,0:02:52.41,0:02:53.61,JP-SUB,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:02:54.15,0:02:56.65,JP-SUB,,0,0,0,,Сонымен, саясаткерлер немесе полиция.
Dialogue: 0,0:02:56.91,0:02:58.99,JP-SUB,,0,0,0,,Жамандық ешқашан құтыла алмайды
Dialogue: 0,0:03:08.33,0:03:09.35,JP-SUB,,0,0,0,,Бұл балалар
Dialogue: 0,0:03:09.77,0:03:12.83,JP-SUB,,0,0,0,,Табиғаттан тыс күші бар балалар шығар.
Dialogue: 0,0:03:14.57,0:03:16.33,JP-SUB,,0,0,0,,Жапонияның түкпір-түкпірінен жиналған
Dialogue: 0,0:03:16.77,0:03:18.53,JP-SUB,,0,0,0,,Көптеген нәрселер зерттелуде.
Dialogue: 0,0:03:20.85,0:03:23.87,JP-SUB,,0,0,0,,Үкімет не істеуге тырысады?
Dialogue: 0,0:03:24.33,0:03:25.45,JP-SUB,,0,0,0,,Олай болса.
Dialogue: 0,0:03:26.11,0:03:28.39,JP-SUB,,0,0,0,,Жарайды, мен сені қорғап тұрған сияқтымын.
Dialogue: 0,0:03:28.39,0:03:29.41,JP-SUB,,0,0,0,,Жарайды.
Dialogue: 0,0:03:36.11,0:03:36.87,JP-SUB,,0,0,0,,Не болды?
Dialogue: 0,0:03:37.57,0:03:40.25,JP-SUB,,0,0,0,,Жоқ, бұрынғы екі үлкен адам.
Dialogue: 0,0:03:40.71,0:03:43.15,JP-SUB,,0,0,0,,Күшім неге жарты жолда таусылды деп ойлаймын.
Dialogue: 0,0:03:43.57,0:03:45.21,JP-SUB,,0,0,0,,Ол жоғалған болуы керек.
Dialogue: 0,0:03:46.97,0:03:48.17,JP-SUB,,0,0,0,,Мен бұрын айтқанымдай
Dialogue: 0,0:03:48.45,0:03:49.65,JP-SUB,,0,0,0,,Жоғалған не?
Dialogue: 0,0:03:49.93,0:03:51.77,JP-SUB,,0,0,0,,А, жоғалдың ба?
Dialogue: 0,0:03:55.11,0:03:56.13,JP-SUB,,0,0,0,,Не болды?
Dialogue: 0,0:03:58.39,0:03:59.27,JP-SUB,,0,0,0,,Күшік
Dialogue: 0,0:04:12.55,0:04:13.99,JP-SUB,,0,0,0,,Аурухана сияқты
Dialogue: 0,0:04:18.11,0:04:20.31,JP-SUB,,0,0,0,,Ал, ақпарат дұрыс.
Dialogue: 0,0:04:25.37,0:04:27.81,JP-SUB,,0,0,0,,Бұл аурухана үшін әдеттен тыс.
Dialogue: 0,0:04:29.77,0:04:32.83,JP-SUB,,0,0,0,,Міне, кодты ажыратқыштар.
Dialogue: 0,0:04:33.83,0:04:34.63,JP-SUB,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:04:36.13,0:04:37.73,JP-SUB,,0,0,0,,Бұл Табата-сан, солай ма?
Dialogue: 0,0:04:38.11,0:04:39.61,JP-SUB,,0,0,0,,Табиғаттан тыс қабілеттерді зерттеу алға жылжуда
Dialogue: 0,0:04:40.07,0:04:42.77,JP-SUB,,0,0,0,,Бұрынғы бұлшық ет ақымақтары сіздің зерттеуіңіздің нәтижесі, солай ма?
Dialogue: 0,0:04:43.05,0:04:47.11,JP-SUB,,0,0,0,,Нақты кодты ажыратқыш сияқты жақсы емес.
Dialogue: 0,0:04:48.15,0:04:50.11,JP-SUB,,0,0,0,,Бұл Шигеру Табата, диетаның мүшесі.
Dialogue: 0,0:04:50.73,0:04:52.71,JP-SUB,,0,0,0,,Сіз бұл есімді бұрын естіген шығарсыз.
Dialogue: 0,0:04:53.19,0:04:55.71,JP-SUB,,0,0,0,,Бұл жігіт зерттеуге жауапты адам.
Dialogue: 0,0:04:56.37,0:04:58.57,JP-SUB,,0,0,0,,Сонымен, үкімет шынымен де
Dialogue: 0,0:04:58.97,0:05:00.97,JP-SUB,,0,0,0,,Мәселе осы жерден басталады.
Dialogue: 0,0:05:12.35,0:05:13.25,JP-SUB,,0,0,0,,Ой...
Dialogue: 0,0:05:13.69,0:05:16.53,JP-SUB,,0,0,0,,Әй, тек мүшелер ғана кеткен.
Dialogue: 0,0:05:17.59,0:05:20.19,JP-SUB,,0,0,0,,Mr. Tabata, Eden is crazy.
Dialogue: 0,0:05:20.19,0:05:21.61,JP-SUB,,0,0,0,,Ол мені рұқсатсыз өлтірді.
Dialogue: 0,0:05:22.35,0:05:24.91,JP-SUB,,0,0,0,,Бізге органдарды сатып алуды немесе сатуды айтпады, солай ма?
Dialogue: 0,0:05:26.19,0:05:27.93,JP-SUB,,0,0,0,,Неліктен бұлай істедің?
Dialogue: 0,0:05:28.55,0:05:31.37,JP-SUB,,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,0:05:31.99,0:05:34.29,JP-SUB,,0,0,0,,Бұл сияқты нәрсені атауға болатын ұзақ жол.
Dialogue: 0,0:05:35.11,0:05:38.41,JP-SUB,,0,0,0,,Біз жасайтын нәрсе – адамдарға көмектесу.
Dialogue: 0,0:05:38.75,0:05:40.79,JP-SUB,,0,0,0,,Табиғаттан тыс күші төмен бала ше?
Dialogue: 0,0:05:41.13,0:05:43.21,JP-SUB,,0,0,0,,Пайдасыз қажетсіз бала
Dialogue: 0,0:05:43.47,0:05:45.29,JP-SUB,,0,0,0,,Солай ма?
Dialogue: 0,0:05:46.85,0:05:49.69,JP-SUB,,0,0,0,,Ең болмаса мүшелерді пайдаланған дұрыс.
Dialogue: 0,0:05:49.99,0:05:52.59,JP-SUB,,0,0,0,,Дүние үшін, солай емес пе?
Dialogue: 0,0:05:53.03,0:05:53.99,JP-SUB,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:05:54.45,0:05:56.63,JP-SUB,,0,0,0,,Бұған жол берілмейді.
Dialogue: 0,0:05:56.81,0:05:59.13,JP-SUB,,0,0,0,,Ой, қандай көңілді қыз.
Dialogue: 0,0:05:59.41,0:06:01.55,JP-SUB,,0,0,0,,Кішкене бөлшектеп көрейік.
Dialogue: 0,0:06:02.47,0:06:07.03,JP-SUB,,0,0,0,,Әрине, бұл пайдалы болмаса, маған қажет емес.
Dialogue: 0,0:06:07.27,0:06:09.65,JP-SUB,,0,0,0,,Әй, сен менің не айтып тұрғанымды білесің.
Dialogue: 0,0:06:09.93,0:06:11.97,JP-SUB,,0,0,0,,Маған пайдаң бар ма?
Dialogue: 0,0:06:12.53,0:06:13.23,JP-SUB,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:14.77,0:06:17.65,JP-SUB,,0,0,0,,Егер ол пайдалы болмаса, сізге қажет емес.
Dialogue: 0,0:06:19.53,0:06:21.85,JP-SUB,,0,0,0,,But I don't need your organs.
Dialogue: 0,0:06:22.95,0:06:25.55,JP-SUB,,0,0,0,,Әлемге де, адамдарға да жақсы болу міндетті емес.
Dialogue: 0,0:06:26.57,0:06:28.11,JP-SUB,,0,0,0,,Тек күйіп кетіңіз
Dialogue: 0,0:06:33.73,0:06:35.27,JP-SUB,,0,0,0,,Субару, бірдеңе дұрыс емес пе?
Dialogue: 0,0:06:45.87,0:06:47.51,JP-SUB,,0,0,0,,Егер буланған болса
Dialogue: 0,0:06:47.79,0:06:48.65,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:06:49.41,0:06:50.65,JP-SUB,,0,0,0,,Сакура-чан, артқа тұрыңыз.
Dialogue: 0,0:06:50.81,0:06:51.75,JP-SUB,,0,0,0,,Субару, бірдеңе дұрыс емес пе?
Dialogue: 0,0:06:59.17,0:07:00.49,JP-SUB,,0,0,0,,О, не деген ұят
Dialogue: 0,0:07:00.59,0:07:02.49,JP-SUB,,0,0,0,,Мен сені тасқа айналдырдым
Dialogue: 0,0:07:02.73,0:07:04.21,JP-SUB,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:07:04.57,0:07:06.75,JP-SUB,,0,0,0,,In the first place, there's no use for you guys.
Dialogue: 0,0:07:07.19,0:07:10.01,JP-SUB,,0,0,0,,There's no way you'll come back alive if you see that.
Dialogue: 0,0:07:17.31,0:07:18.99,JP-SUB,,0,0,0,,Чи қиын
Dialogue: 0,0:07:23.85,0:07:26.59,JP-SUB,,0,0,0,,Ішкі ағзаларыңды аламын.
Dialogue: 0,0:07:33.13,0:07:36.71,JP-SUB,,0,0,0,,It's unfortunate that the code breaker escapes.
Dialogue: 0,0:07:36.71,0:07:39.09,JP-SUB,,0,0,0,,Қарғыс атқыр, бұл біртүрлі қабілет.
Dialogue: 0,0:07:39.51,0:07:41.77,JP-SUB,,0,0,0,,Токи-кун, әлгі жігіт біртүрлі екен.
Dialogue: 0,0:07:42.99,0:07:45.71,JP-SUB,,0,0,0,,Why are you carrying something so heavy on your back?
Dialogue: 0,0:07:55.71,0:07:57.97,JP-SUB,,0,0,0,,Кодты ажыратқыш күткендей.
Dialogue: 0,0:07:58.11,0:08:01.05,JP-SUB,,0,0,0,,Сіз не істеп жатырсыз? Күшіңізді пайдаланғаныңызға сенімді болыңыз.
Dialogue: 0,0:08:01.15,0:08:02.63,JP-SUB,,0,0,0,,Баламен не болады?
Dialogue: 0,0:08:02.63,0:08:03.77,JP-SUB,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:08:06.95,0:08:10.15,JP-SUB,,0,0,0,,Бұл күтпеген шабуыл немесе қорқақтық емес.
Dialogue: 0,0:08:10.43,0:08:12.35,JP-SUB,,0,0,0,,Кодты ажыратқыш
Dialogue: 0,0:08:16.83,0:08:19.43,JP-SUB,,0,0,0,,Маған сіздің ұсақ шабуылдарыңыз ұнамайды.
Dialogue: 0,0:08:20.47,0:08:24.07,JP-SUB,,0,0,0,,I guess there's some trick to what he's carrying on his back.
Dialogue: 0,0:08:24.43,0:08:27.23,JP-SUB,,0,0,0,,Содан кейін оны тікелей жойыңыз.
Dialogue: 0,0:08:28.25,0:08:29.23,JP-SUB,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:08:30.61,0:08:32.07,JP-SUB,,0,0,0,,Бұл не?
Dialogue: 0,0:08:33.47,0:08:34.63,JP-SUB,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:08:34.91,0:08:37.29,JP-SUB,,0,0,0,,Көміртекті талшықтан жасалған.
Dialogue: 0,0:08:37.63,0:08:40.67,JP-SUB,,0,0,0,,Your supernatural ability can't destroy it.
Dialogue: 0,0:08:42.91,0:08:45.81,JP-SUB,,0,0,0,,Эй, сен байсалдысың.
Dialogue: 0,0:08:50.65,0:08:53.57,JP-SUB,,0,0,0,,She really doesn't like being seen from behind.
Dialogue: 0,0:08:55.51,0:08:57.49,JP-SUB,,0,0,0,,Күшіңізді пайдаланғаныңызға көз жеткізіңіз
Dialogue: 0,0:08:57.81,0:09:00.01,JP-SUB,,0,0,0,,Мен сенің ағаңдай әрекет етемін.
Dialogue: 0,0:09:00.21,0:09:00.93,JP-SUB,,0,0,0,,Үлкен аға
Dialogue: 0,0:09:00.93,0:09:02.41,JP-SUB,,0,0,0,,Басқа жерден іздеңіз.
Dialogue: 0,0:09:06.51,0:09:07.61,JP-SUB,,0,0,0,,Бітті
Dialogue: 0,0:09:14.59,0:09:15.47,JP-SUB,,0,0,0,,Балалар
Dialogue: 0,0:09:26.39,0:09:27.49,JP-SUB,,0,0,0,,Қуат таусылды ма?
Dialogue: 0,0:09:29.55,0:09:31.41,JP-SUB,,0,0,0,,Шынымен керексіз бала.
Dialogue: 0,0:09:37.31,0:09:38.79,JP-SUB,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:09:39.21,0:09:42.03,JP-SUB,,0,0,0,,Братандар мүлдем жоқ.
Dialogue: 0,0:09:42.21,0:09:44.49,JP-SUB,,0,0,0,,Жақында қуат таусылады.
Dialogue: 0,0:09:44.91,0:09:47.37,JP-SUB,,0,0,0,,Маған шынымен керек емессің.
Dialogue: 0,0:09:50.15,0:09:52.13,JP-SUB,,0,0,0,,Күте тұрыңыз, жақсысыз ба?
Dialogue: 0,0:09:52.57,0:09:54.95,JP-SUB,,0,0,0,,Оларды өлтіріңіз
Dialogue: 0,0:09:56.05,0:09:59.03,JP-SUB,,0,0,0,,Өйткені олар әлсіз
Dialogue: 0,0:09:59.45,0:10:02.85,JP-SUB,,0,0,0,,Менің ағамды кесіп тастаңыз
Dialogue: 0,0:10:04.79,0:10:08.13,JP-SUB,,0,0,0,,Мен бір дауысты естідім, апамның дауысы.
Dialogue: 0,0:10:08.45,0:10:09.73,JP-SUB,,0,0,0,,Маған көмектес
Dialogue: 0,0:10:10.29,0:10:12.97,JP-SUB,,0,0,0,,Бірақ мен енді естімеймін
Dialogue: 0,0:10:13.73,0:10:16.21,JP-SUB,,0,0,0,,Мен енді апамның даусын ести алмаймын.
Dialogue: 0,0:10:16.83,0:10:20.81,JP-SUB,,0,0,0,,Оларды өлтір, інімнің өшін ал.
Dialogue: 0,0:10:22.65,0:10:24.93,JP-SUB,,0,0,0,,Өтінемін, мені өлтіріңіз.
Dialogue: 0,0:10:25.37,0:10:27.49,JP-SUB,,0,0,0,,Менің әпкемді өлтіргендер
Dialogue: 0,0:10:28.43,0:10:29.31,JP-SUB,,0,0,0,,Достар...?
Dialogue: 0,0:10:39.27,0:10:39.91,JP-SUB,,0,0,0,,Ақымақ
Dialogue: 0,0:10:41.55,0:10:42.35,JP-SUB,,0,0,0,,Тоқта
Dialogue: 0,0:10:42.55,0:10:43.67,JP-SUB,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:10:45.53,0:10:48.13,JP-SUB,,0,0,0,,Көзге көз, тіске тіс
Dialogue: 0,0:10:48.13,0:10:50.63,JP-SUB,,0,0,0,,Зұлымдықтың әділет балғасы
Dialogue: 0,0:10:59.47,0:11:00.71,JP-SUB,,0,0,0,,Рахмет
Dialogue: 0,0:11:02.73,0:11:06.11,JP-SUB,,0,0,0,,О, ағайын
Dialogue: 0,0:11:07.55,0:11:12.41,JP-SUB,,0,0,0,,Ей, эй, жоқ, оян, эй.
Dialogue: 0,0:11:14.13,0:11:16.71,JP-SUB,,0,0,0,,Біріншіден, 4-деңгей—ағаш таяқ та жеткілікті.
Dialogue: 0,0:11:24.03,0:11:25.91,JP-SUB,,0,0,0,,Жоқ, тоқтатыңыз.
Dialogue: 0,0:11:25.91,0:11:26.95,JP-SUB,,0,0,0,,Жану
Dialogue: 0,0:11:36.83,0:11:38.19,JP-SUB,,0,0,0,,Рахмет
Dialogue: 0,0:11:38.71,0:11:40.21,JP-SUB,,0,0,0,,Әдептілік қажет емес
Dialogue: 0,0:11:40.59,0:11:43.15,JP-SUB,,0,0,0,,Өйткені, мен зұлымдықты өлтіретіндей зұлыммын.
Dialogue: 0,0:11:43.81,0:11:45.99,JP-SUB,,0,0,0,,Мен сіздің қасіретіңізді алып тастай алмаймын
Dialogue: 0,0:11:46.45,0:11:48.35,JP-SUB,,0,0,0,,Өлген адам қайта тірілмейді.
Dialogue: 0,0:11:49.55,0:11:52.71,JP-SUB,,0,0,0,,Сонда да рахмет
Dialogue: 0,0:11:56.07,0:11:57.93,JP-SUB,,0,0,0,,Тәтті
Dialogue: 0,0:11:58.09,0:11:59.21,JP-SUB,,0,0,0,,Екіжүздісің
Dialogue: 0,0:12:08.37,0:12:09.29,JP-SUB,,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:12:11.67,0:12:12.43,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:12:12.43,0:12:14.25,JP-SUB,,0,0,0,,Жоқ, Сакура-чан
Dialogue: 0,0:12:14.37,0:12:17.03,JP-SUB,,0,0,0,,Бірақ мен басқа адамдарды өлтіре алмаймын.
Dialogue: 0,0:12:17.35,0:12:21.33,JP-SUB,,0,0,0,,Сакура-чан Неге батыр жеткілікті?
Dialogue: 0,0:12:21.69,0:12:23.09,JP-SUB,,0,0,0,,Мен бұл туралы ойладым
Dialogue: 0,0:12:23.25,0:12:24.11,JP-SUB,,0,0,0,,Не
Dialogue: 0,0:12:24.97,0:12:26.09,JP-SUB,,0,0,0,,Батыр
Dialogue: 0,0:12:26.29,0:12:29.97,JP-SUB,,0,0,0,,Әділдік үшін жамандарды өлтіретін ол батыр.
Dialogue: 0,0:12:31.67,0:12:34.73,JP-SUB,,0,0,0,,Оның үстіне Сакура-чанның сөзі де екіленіп тұр.
Dialogue: 0,0:12:34.95,0:12:36.63,JP-SUB,,0,0,0,,Ол Окамиге жетпейді.
Dialogue: 0,0:12:36.95,0:12:37.91,JP-SUB,,0,0,0,,Жоғалған және т.б.
Dialogue: 0,0:12:38.19,0:12:40.01,JP-SUB,,0,0,0,,Ағамды кесіп таста
Dialogue: 0,0:12:40.51,0:12:42.65,JP-SUB,,0,0,0,,Оларды өлтіріңіз
Dialogue: 0,0:12:43.03,0:12:44.47,JP-SUB,,0,0,0,,Рахмет
Dialogue: 0,0:12:48.13,0:12:49.93,JP-SUB,,0,0,0,,Сен не білесің?
Dialogue: 0,0:12:50.19,0:12:51.35,JP-SUB,,0,0,0,,Сізге
Dialogue: 0,0:12:53.49,0:12:56.55,JP-SUB,,0,0,0,,Менің қасіретімді білмейтіндерге
Dialogue: 0,0:12:56.65,0:12:57.69,JP-SUB,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:13:00.41,0:13:02.59,JP-SUB,,0,0,0,,Әке, не болды?
Dialogue: 0,0:13:02.87,0:13:04.39,JP-SUB,,0,0,0,,Бұл адамдар кім?
Dialogue: 0,0:13:04.65,0:13:05.29,JP-SUB,,0,0,0,,Киса
Dialogue: 0,0:13:05.97,0:13:07.59,JP-SUB,,0,0,0,,Егіс қызы
Dialogue: 0,0:13:08.31,0:13:11.99,JP-SUB,,0,0,0,,Чиса-чан, бұл ағамыз әділдіктің батыры.
Dialogue: 0,0:13:13.27,0:13:13.99,JP-SUB,,0,0,0,,Шынымен бе?
Dialogue: 0,0:13:14.39,0:13:16.11,JP-SUB,,0,0,0,,Сіздің ағаңыз Хинотаман ба?
Dialogue: 0,0:13:16.37,0:13:18.27,JP-SUB,,0,0,0,,Сіз шынымен келдіңіз.
Dialogue: 0,0:13:18.59,0:13:20.07,JP-SUB,,0,0,0,,Әкем айтты
Dialogue: 0,0:13:20.21,0:13:22.41,JP-SUB,,0,0,0,,Чисаның ауруы Хинотаманнан келді.
Dialogue: 0,0:13:22.41,0:13:25.51,JP-SUB,,0,0,0,,Менің асқазанымның нашар жерін жақсыға ауыстырамын деді.
Dialogue: 0,0:13:25.91,0:13:28.13,JP-SUB,,0,0,0,,Хиноман, келгеніңіз үшін рахмет
Dialogue: 0,0:13:28.49,0:13:29.73,JP-SUB,,0,0,0,,Ауру айыққанда
Dialogue: 0,0:13:29.97,0:13:32.77,JP-SUB,,0,0,0,,Мен Чисамохиден шыққан Таманг сияқты батыр боламын
Dialogue: 0,0:13:33.17,0:13:36.11,JP-SUB,,0,0,0,,Табата менің қызым болады деп ешқашан ойламадым.
Dialogue: 0,0:13:36.11,0:13:38.35,JP-SUB,,0,0,0,,Үйлесімді мүшелерді табу
Dialogue: 0,0:13:38.81,0:13:42.65,JP-SUB,,0,0,0,,Бақытымызға орай, маған табиғаттан тыс күштерді зерттеуді басқару бұйырды.
Dialogue: 0,0:13:43.03,0:13:46.83,JP-SUB,,0,0,0,,Сонда сіз қызыңызға сай орган алуды ойладыңыз ба?
Dialogue: 0,0:13:47.47,0:13:48.97,JP-SUB,,0,0,0,,Бірақ Табата мырза
Dialogue: 0,0:13:49.45,0:13:51.55,JP-SUB,,0,0,0,,Өйткені менің алдымда мен қалайтын нәрсе бар
Dialogue: 0,0:13:51.75,0:13:53.07,JP-SUB,,0,0,0,,Бұл жаман, солай ма?
Dialogue: 0,0:13:53.23,0:13:54.05,JP-SUB,,0,0,0,,Үндетпе
Dialogue: 0,0:13:54.61,0:13:56.61,JP-SUB,,0,0,0,,Чисаға мүшелер қажет.
Dialogue: 0,0:13:57.11,0:14:00.51,JP-SUB,,0,0,0,,Сіз донор пайда болғанша жылдар мен жылдар күте аласыз ба?
Dialogue: 0,0:14:00.63,0:14:03.57,JP-SUB,,0,0,0,,Қызыңыздың орнына басқа баланы өлтірер ме едіңіз?
Dialogue: 0,0:14:04.05,0:14:05.51,JP-SUB,,0,0,0,,Бұл сізге байланысты.
Dialogue: 0,0:14:06.65,0:14:07.87,JP-SUB,,0,0,0,,Үніңді өшір
Dialogue: 0,0:14:08.09,0:14:09.71,JP-SUB,,0,0,0,,Олай деуге негіз жоқ
Dialogue: 0,0:14:10.03,0:14:12.23,JP-SUB,,0,0,0,,Бәрің де кісі өлтіруші емессіңдер ме?
Dialogue: 0,0:14:12.71,0:14:15.67,JP-SUB,,0,0,0,,Адамдарды үнемі өлтіру үшін табиғаттан тыс күштерді қолданса да.
Dialogue: 0,0:14:16.21,0:14:18.55,JP-SUB,,0,0,0,,Иә, ол балалар да.
Dialogue: 0,0:14:18.87,0:14:22.45,JP-SUB,,0,0,0,,Мемлекеттің иті болғандықтан, ол үнемі адамдарды өлтіруі мүмкін.
Dialogue: 0,0:14:22.93,0:14:23.95,JP-SUB,,0,0,0,,Содан кейін
Dialogue: 0,0:14:24.15,0:14:27.85,JP-SUB,,0,0,0,,Адамдарды құтқару үшін органдарды пайдаланған әлдеқайда жақсы емес пе?
Dialogue: 0,0:14:29.11,0:14:30.95,JP-SUB,,0,0,0,,Чисаның аман қалуы үшін
Dialogue: 0,0:14:31.13,0:14:33.01,JP-SUB,,0,0,0,,Итті құрбандыққа шалудың несі айып?
Dialogue: 0,0:14:34.63,0:14:36.85,JP-SUB,,0,0,0,,Мен Чисаға көмектескім келеді.
Dialogue: 0,0:14:37.45,0:14:38.93,JP-SUB,,0,0,0,,Менде бар нәрсе - Чиса
Dialogue: 0,0:14:39.49,0:14:40.71,JP-SUB,,0,0,0,,Менің қызым үшін
Dialogue: 0,0:14:40.71,0:14:42.65,JP-SUB,,0,0,0,,Қызыма болса да
Dialogue: 0,0:14:45.31,0:14:48.45,JP-SUB,,0,0,0,,Бұл сіздің қанішер екеніңізді өзгертпейді.
Dialogue: 0,0:14:49.07,0:14:51.63,JP-SUB,,0,0,0,,Сізде адамның жүрегі жоқ па?
Dialogue: 0,0:14:52.41,0:14:53.47,JP-SUB,,0,0,0,,Өртену
Dialogue: 0,0:15:00.33,0:15:01.39,JP-SUB,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:15:02.27,0:15:03.99,JP-SUB,,0,0,0,,Сол бала өз ағасын өлтірді.
Dialogue: 0,0:15:04.29,0:15:06.49,JP-SUB,,0,0,0,,Қиналғаным сонша, біреу өлсе екен деп қалдым.
Dialogue: 0,0:15:07.47,0:15:09.75,JP-SUB,,0,0,0,,Қызыма қанша болса да.
Dialogue: 0,0:15:10.01,0:15:11.29,JP-SUB,,0,0,0,,Басқаларды таптау
Dialogue: 0,0:15:11.53,0:15:12.81,JP-SUB,,0,0,0,,құрбандық
Dialogue: 0,0:15:14.79,0:15:17.47,JP-SUB,,0,0,0,,Сіз, сіз және т.б.
Dialogue: 0,0:15:18.87,0:15:22.25,JP-SUB,,0,0,0,,Сіз, сіз және т.б.
Dialogue: 0,0:15:23.93,0:15:24.65,JP-SUB,,0,0,0,,Достар...?
Dialogue: 0,0:15:24.65,0:15:26.75,JP-SUB,,0,0,0,,Сіз
Dialogue: 0,0:15:32.71,0:15:33.91,JP-SUB,,0,0,0,,Сіз
Dialogue: 0,0:15:35.59,0:15:38.03,JP-SUB,,0,0,0,,Әлгі қыз жылы еді.
Dialogue: 0,0:15:39.55,0:15:42.01,JP-SUB,,0,0,0,,Мен жүрегімнің дүрсілдегенін естідім.
Dialogue: 0,0:15:43.57,0:15:46.37,JP-SUB,,0,0,0,,Бірақ күн суытып бара жатты.
Dialogue: 0,0:15:47.33,0:15:49.69,JP-SUB,,0,0,0,,Менің жүрегім барған сайын әлсірей бастады.
Dialogue: 0,0:15:51.35,0:15:53.75,JP-SUB,,0,0,0,,Өмір жойылғанда солай болады.
Dialogue: 0,0:15:54.57,0:15:55.89,JP-SUB,,0,0,0,,Сен де жылысың
Dialogue: 0,0:15:56.91,0:15:58.81,JP-SUB,,0,0,0,,Сол қыз сияқты жылы.
Dialogue: 0,0:16:00.83,0:16:01.79,JP-SUB,,0,0,0,,Мен тірі болсам да
Dialogue: 0,0:16:02.49,0:16:04.01,JP-SUB,,0,0,0,,Өлудің мәні жоқ.
Dialogue: 0,0:16:04.51,0:16:06.19,JP-SUB,,0,0,0,,Өлтіруге ешқандай себеп жоқ.
Dialogue: 0,0:16:09.41,0:16:10.11,JP-SUB,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:16:14.79,0:16:16.03,JP-SUB,,0,0,0,,Сонымен Оками
Dialogue: 0,0:16:16.43,0:16:17.57,JP-SUB,,0,0,0,,Мені өлтірме
Dialogue: 0,0:16:18.09,0:16:19.75,JP-SUB,,0,0,0,,Бұл жігіт әлі тірі
Dialogue: 0,0:16:20.09,0:16:21.51,JP-SUB,,0,0,0,,Мені өлтірме
Dialogue: 0,0:16:24.39,0:16:25.81,JP-SUB,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:26.81,0:16:28.31,JP-SUB,,0,0,0,,Қандай себеп болса да
Dialogue: 0,0:16:29.19,0:16:31.09,JP-SUB,,0,0,0,,Мен сені өлтірмеуім керек еді.
Dialogue: 0,0:16:36.21,0:16:38.73,JP-SUB,,0,0,0,,Мен қызымды сұраймын
Dialogue: 0,0:16:46.53,0:16:47.99,JP-SUB,,0,0,0,,Хиноман шықты
Dialogue: 0,0:16:48.37,0:16:50.35,JP-SUB,,0,0,0,,Жау – жын.
Dialogue: 0,0:16:52.05,0:16:55.03,JP-SUB,,0,0,0,,Талай адамды қинадым, өлтірдім.
Dialogue: 0,0:16:55.03,0:16:56.11,JP-SUB,,0,0,0,,Жаман ба?
Dialogue: 0,0:16:56.93,0:16:58.27,JP-SUB,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:16:59.03,0:16:59.69,JP-SUB,,0,0,0,,Табата
Dialogue: 0,0:16:59.81,0:17:00.91,JP-SUB,,0,0,0,,Әке не?
Dialogue: 0,0:17:03.33,0:17:04.99,JP-SUB,,0,0,0,,Чиса, кешіріңіз.
Dialogue: 0,0:17:06.27,0:17:09.03,JP-SUB,,0,0,0,,Әкем өз қалауы үшін адамдарды өлтірді.
Dialogue: 0,0:17:09.51,0:17:11.25,JP-SUB,,0,0,0,,Мен жынға айналдым.
Dialogue: 0,0:17:11.47,0:17:12.95,JP-SUB,,0,0,0,,Әкем өтірік айтады
Dialogue: 0,0:17:13.83,0:17:15.53,JP-SUB,,0,0,0,,Хинотаманның ағасы
Dialogue: 0,0:17:16.03,0:17:18.03,JP-SUB,,0,0,0,,Мен әкемнен құтылуға келдім.
Dialogue: 0,0:17:20.05,0:17:22.55,JP-SUB,,0,0,0,,Жүр, өл, Хиноман.
Dialogue: 0,0:17:27.75,0:17:29.41,JP-SUB,,0,0,0,,Жоқ, Оками
Dialogue: 0,0:17:31.89,0:17:33.01,JP-SUB,,0,0,0,,Өртену
Dialogue: 0,0:17:41.51,0:17:42.77,JP-SUB,,0,0,0,,Чи Чиса
Dialogue: 0,0:17:48.17,0:17:48.77,JP-SUB,,0,0,0,,Табата
Dialogue: 0,0:17:50.63,0:17:52.47,JP-SUB,,0,0,0,,Хинотаманның идиоты
Dialogue: 0,0:17:54.27,0:17:55.05,JP-SUB,,0,0,0,,Чиса-чан
Dialogue: 0,0:17:55.31,0:17:57.67,JP-SUB,,0,0,0,,Сәттілік, әке.
Dialogue: 0,0:17:59.67,0:18:02.39,JP-SUB,,0,0,0,,Мен жын болсам да, әкем менің әкем.
Dialogue: 0,0:18:03.39,0:18:05.61,JP-SUB,,0,0,0,,Мен Хинотаманды жек көремін.
Dialogue: 0,0:18:05.93,0:18:06.89,JP-SUB,,0,0,0,,Өлу
Dialogue: 0,0:18:07.63,0:18:09.27,JP-SUB,,0,0,0,,Өлу
Dialogue: 0,0:18:10.95,0:18:11.49,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:18:14.95,0:18:16.33,JP-SUB,,0,0,0,,Өлу
Dialogue: 0,0:18:24.71,0:18:25.41,JP-SUB,,0,0,0,,Сіз ренжідіңіз бе?
Dialogue: 0,0:18:26.15,0:18:28.69,JP-SUB,,0,0,0,,Көңілің қалса, тірі қал, мені өлтір.
Dialogue: 0,0:18:30.11,0:18:31.05,JP-SUB,,0,0,0,,Мен оны есімде сақтаймын
Dialogue: 0,0:18:32.67,0:18:35.47,JP-SUB,,0,0,0,,Мен сені ешқашан ұмытпаймын
Dialogue: 0,0:18:41.65,0:18:42.53,JP-SUB,,0,0,0,,Чиса-чан
Dialogue: 0,0:18:43.59,0:18:45.37,JP-SUB,,0,0,0,,Мен жай ғана ес-түссіз жатырмын.
Dialogue: 0,0:18:45.77,0:18:47.85,JP-SUB,,0,0,0,,Сіз ауырып тұрсаңыз да, өзіңізді қатты итермеледіңіз, солай ма?
Dialogue: 0,0:18:48.65,0:18:50.73,JP-SUB,,0,0,0,,Мен медициналық топпен байланысамын, сондықтан бәрі жақсы.
Dialogue: 0,0:18:52.01,0:18:53.17,JP-SUB,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:54.97,0:18:55.55,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:18:56.59,0:18:58.99,JP-SUB,,0,0,0,,Сіз адамдар сізді жек көретіндей бірдеңе айттыңыз.
Dialogue: 0,0:18:59.81,0:19:03.61,JP-SUB,,0,0,0,,Сіз бұл баланың өмірінің мәні жеккөрінішті болады деп ойладыңыз ба?
Dialogue: 0,0:19:07.87,0:19:09.21,JP-SUB,,0,0,0,,Әдіс – мәселе
Dialogue: 0,0:19:10.31,0:19:11.19,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:19:12.13,0:19:13.73,JP-SUB,,0,0,0,,Бұл батырдың әрекеті
Dialogue: 0,0:19:14.75,0:19:17.05,JP-SUB,,0,0,0,,Сіз өзіңізді зұлым дейсіз
Dialogue: 0,0:19:17.21,0:19:18.39,JP-SUB,,0,0,0,,Мен зұлыммын
Dialogue: 0,0:19:20.13,0:19:22.75,JP-SUB,,0,0,0,,Басқа адам қаншалықты жаман болса да
Dialogue: 0,0:19:23.29,0:19:26.89,JP-SUB,,0,0,0,,Біреуді өлтірсең, енді әділет батыры болмайсың.
Dialogue: 0,0:19:33.71,0:19:35.65,JP-SUB,,0,0,0,,Иә, егістіктер жойылды.
Dialogue: 0,0:19:36.29,0:19:37.33,JP-SUB,,0,0,0,,Иә, бәрібір.
Dialogue: 0,0:19:37.65,0:19:39.15,JP-SUB,,0,0,0,,Зерттеу деректері әдеттегідей
Dialogue: 0,0:19:40.73,0:19:43.25,JP-SUB,,0,0,0,,Мүмкіндігі шектеулі балалар туралы зерттеу деректері
Dialogue: 0,0:19:43.75,0:19:45.83,JP-SUB,,0,0,0,,Оны кімге беріп жатырсың?
Dialogue: 0,0:19:46.39,0:19:47.77,JP-SUB,,0,0,0,,Хатшы Цуно-кун
Dialogue: 0,0:19:48.75,0:19:49.75,JP-SUB,,0,0,0,,Кодты ажыратқыш
Dialogue: 0,0:19:50.03,0:19:52.89,JP-SUB,,0,0,0,,Ұйымдастырушы телефонның арғы жағында тұрған сияқты.
Dialogue: 0,0:19:54.09,0:19:56.15,JP-SUB,,0,0,0,,Сіз маған ұялы телефоныңызды бере аласыз ба?
Dialogue: 0,0:19:57.13,0:19:59.39,JP-SUB,,0,0,0,,Маған көмектесіңізші, кодты бұзушы
Dialogue: 0,0:19:59.91,0:20:01.55,JP-SUB,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:20:10.27,0:20:12.11,JP-SUB,,0,0,0,,Сіздің келесі баратын жеріңіз — Сан-Джорджо-Маджоре аралы
Dialogue: 0,0:20:12.71,0:20:14.99,JP-SUB,,0,0,0,,Мұны маған да қойдыңыз ба?
Dialogue: 0,0:20:15.39,0:20:17.71,JP-SUB,,0,0,0,,Дегенмен, мен олардың сезімін түсінемін.
Dialogue: 0,0:20:18.41,0:20:19.29,JP-SUB,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:20:28.23,0:20:29.83,JP-SUB,,0,0,0,,Цуно өз-өзіне қол жұмсады.
Dialogue: 0,0:20:30.45,0:20:31.59,JP-SUB,,0,0,0,,Бұл сіздің әрекетіңіз болды ма?
Dialogue: 0,0:20:32.35,0:20:33.71,JP-SUB,,0,0,0,,Эй, Токи-кун
Dialogue: 0,0:20:34.15,0:20:35.33,JP-SUB,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:20:36.05,0:20:37.99,JP-SUB,,0,0,0,,Күтілгендей, код нөл бірінші
Dialogue: 0,0:20:38.61,0:20:39.23,JP-SUB,,0,0,0,,Қарап тұрған адамдар
Dialogue: 0,0:20:39.95,0:20:42.81,JP-SUB,,0,0,0,,Мен сенімен кездесуді асыға күтемін, Токикун.
Dialogue: 0,0:20:43.29,0:20:44.09,JP-SUB,,0,0,0,,Джейн
Dialogue: 0,0:20:51.11,0:20:53.85,JP-SUB,,0,0,0,,Премьер-министр, балаларды әскерлер қамтамасыз етті.
Dialogue: 0,0:20:54.47,0:20:56.15,JP-SUB,,0,0,0,,Қазіргі уақытта Төртінші ғылыми-зерттеу институтына ауыстырылуда
Dialogue: 0,0:20:56.87,0:20:57.71,JP-SUB,,0,0,0,,Жарайды.
Dialogue: 0,0:20:58.31,0:20:59.57,JP-SUB,,0,0,0,,​​Еңбегіңіз үшін рахмет.
Dialogue: 0,0:21:04.95,0:21:05.85,JP-SUB,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:21:06.85,0:21:10.79,JP-SUB,,0,0,0,,Табатаға табиғаттан тыс күштерді зерттеуді басқаруға рұқсат беру қателік болды.
Dialogue: 0,0:21:11.75,0:21:15.41,JP-SUB,,0,0,0,,Мен оның қызына бұлай жасайды деп ойламаппын.
Dialogue: 0,0:21:16.19,0:21:18.29,JP-SUB,,0,0,0,,Мен оны мүлдем түсінбеймін.
Dialogue: 0,0:21:21.15,0:21:24.41,JP-SUB,,0,0,0,,Табиғаттан тыс күштері бар нәрселерге босқа қарамаңыз.
Dialogue: 0,0:21:27.67,0:21:31.33,JP-SUB,,0,0,0,,Күйеуің де қызық па деп ойлаймын.
Dialogue: 0,0:21:31.89,0:21:33.61,JP-SUB,,0,0,0,,Ерекше қабілеті бар балаларға
Dialogue: 0,0:21:55.57,0:21:58.01,ED JP-B,,0,0,0,,Сен де бір күні түсінесің
Dialogue: 0,0:21:58.01,0:22:00.42,ED JP-B,,0,0,0,,Ақ қарға қайда барады
Dialogue: 0,0:22:00.42,0:22:03.10,ED JP-B,,0,0,0,,Ешкімді танымай ұшамыз
Dialogue: 0,0:22:03.10,0:22:05.74,ED JP-B,,0,0,0,,Гүлденген қала
Dialogue: 0,0:22:16.52,0:22:20.65,ED JP-G,,0,0,0,,Тек өмір сүруге себеп іздеу
Dialogue: 0,0:22:20.65,0:22:22.86,ED JP-G,,0,0,0,,Менің бос өзім
Dialogue: 0,0:22:22.86,0:22:25.84,ED JP-G,,0,0,0,,Өйткені бұл ұят
Dialogue: 0,0:22:26.12,0:22:30.96,ED JP-G,,0,0,0,,Біз әлем белгілеген ережелерді ұстанамыз
Dialogue: 0,0:22:30.96,0:22:35.64,ED JP-G,,0,0,0,,Өзіңізді жіберіп, күліңіз.
Dialogue: 0,0:22:36.65,0:22:41.10,ED JP-B,,0,0,0,,Жалаңаш болып, ішкі түйсігіңмен жүр
Dialogue: 0,0:22:41.28,0:22:45.33,ED JP-B,,0,0,0,,Көзден жасырылған шындық
Dialogue: 0,0:22:45.38,0:22:47.79,ED JP-B,,0,0,0,,Ешкім үшін емес
Dialogue: 0,0:22:47.79,0:22:49.90,ED JP-B,,0,0,0,,Шешім қабылданды
Dialogue: 0,0:22:49.90,0:22:54.77,ED JP-B,,0,0,0,,Қара киімдеріңді тастап, тұрыңдар.
Dialogue: 0,0:22:55.02,0:22:57.26,ED JP-B,,0,0,0,,Таза тілек
Dialogue: 0,0:22:57.26,0:23:01.29,ED JP-B,,0,0,0,,Қанатымыз енді жоғалды
Dialogue: 0,0:23:01.29,0:23:04.22,ED JP-B,,0,0,0,,Оны сілкіп таста да, қанатыңды ат
Dialogue: 0,0:23:04.22,0:23:06.58,ED JP-B,,0,0,0,,Қорықпа
Dialogue: 0,0:23:06.70,0:23:12.05,ED JP-B,,0,0,0,,Жауап қараңғылықтан тыс болса
Dialogue: 0,0:23:25.47,0:23:27.51,JP-SUB,,0,0,0,,Егер бірдеңе ақырында жоғалып кетсе
Dialogue: 0,0:23:27.93,0:23:29.41,JP-SUB,,0,0,0,,Ең алдымен оның болмағаны жақсы
Dialogue: 0,0:23:30.57,0:23:32.71,JP-SUB,,0,0,0,,Келесі код: Breaker 6-эпизод
Dialogue: 0,0:23:33.25,0:23:34.13,JP-SUB,,0,0,0,,Жоғалған адам
Dialogue: 0,0:23:34.79,0:23:37.19,JP-SUB,,0,0,0,,Бұл біздің тағдырымыз
Dialogue: 0,0:23:38.69,0:23:44.69,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory