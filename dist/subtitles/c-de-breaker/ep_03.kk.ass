Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.23,JP-SUB,,0,0,0,,Жамандыққа ашу реквиемі
Dialogue: 0,0:00:00.00,0:00:03.40,JP-SUB,,0,0,0,,Көзге көз, тіске тіс
Dialogue: 0,0:00:05.20,0:00:06.32,JP-SUB,,0,0,0,,Кедергі жоқ
Dialogue: 0,0:00:34.51,0:00:35.40,JP-SUB,,0,0,0,,Мен қашып кеттім
Dialogue: 0,0:00:37.84,0:00:39.05,JP-SUB,,0,0,0,,Сен мені өлтірмексің бе?
Dialogue: 0,0:01:01.85,0:01:05.73,OP JP,,0,0,0,,Неліктен жұмбақ шешу керек
Dialogue: 0,0:01:06.02,0:01:09.13,OP JP,,0,0,0,,Соңғы бөлім
Dialogue: 0,0:01:09.28,0:01:13.13,OP JP,,0,0,0,,Сіз іздеген жерде емес
Dialogue: 0,0:01:13.46,0:01:16.41,OP JP,,0,0,0,,Қорқынышпен қозғалу
Dialogue: 0,0:01:16.54,0:01:20.07,OP JP,,0,0,0,,Айнымас жойылуға
Dialogue: 0,0:01:20.27,0:01:23.72,OP JP,,0,0,0,,Сенімсіз өзін-өзі бағалау
Dialogue: 0,0:01:24.09,0:01:27.57,OP JP,,0,0,0,,тірі қал Мен жете алмаймын
Dialogue: 0,0:01:27.85,0:01:33.54,OP JP,,0,0,0,,Жасырын естеліктердің кейінгі бейнесінде
Dialogue: 0,0:01:34.04,0:01:38.21,OP JP,,0,0,0,,Шексіз ҚАРА ҰЯТТЫ босатыңыз
Dialogue: 0,0:01:38.46,0:01:41.94,OP JP,,0,0,0,,Осы нәзік дүниенің соңы
Dialogue: 0,0:01:42.11,0:01:46.29,OP JP,,0,0,0,,Ұмытқан тынысым - үнсіздік
Dialogue: 0,0:01:46.29,0:01:49.94,OP JP,,0,0,0,,Көз алдымда арам тарады
Dialogue: 0,0:01:49.94,0:01:53.02,OP JP,,0,0,0,,Қараңғыда жерленген
Dialogue: 0,0:01:53.17,0:01:56.26,OP JP,,0,0,0,,Тексерілді, біз білеміз
Dialogue: 0,0:01:56.78,0:02:02.67,OP JP,,0,0,0,,Өтпелі екпінділікте
Dialogue: 0,0:02:03.14,0:02:07.32,OP JP,,0,0,0,,Еркін қараңыз
Dialogue: 0,0:02:20.98,0:02:22.27,JP-SUB,,0,0,0,,Сакура мен барамын
Dialogue: 0,0:02:25.46,0:02:26.77,JP-SUB,,0,0,0,,Мен түсінбейтін нәрселер өте көп.
Dialogue: 0,0:02:31.25,0:02:33.96,JP-SUB,,0,0,0,,Бірақ бір нәрсе анық
Dialogue: 0,0:02:35.87,0:02:38.21,JP-SUB,,0,0,0,,Оның істеп жатқаны жаман.
Dialogue: 0,0:02:41.61,0:02:43.80,JP-SUB,,0,0,0,,Қайырлы таң, Сакуракоджи-сан
Dialogue: 0,0:02:44.69,0:02:46.33,JP-SUB,,0,0,0,,Сіз мені бақылауды жоспарлап отырсыз ба?
Dialogue: 0,0:02:46.93,0:02:49.04,JP-SUB,,0,0,0,,Жоқ, бұл бақылау.
Dialogue: 0,0:02:50.23,0:02:52.37,JP-SUB,,0,0,0,,Оками, мен оны ұмытпаймын.
Dialogue: 0,0:02:53.22,0:02:55.28,JP-SUB,,0,0,0,,Мен де сені бақылайтын боламын.
Dialogue: 0,0:03:13.30,0:03:14.05,JP-SUB,,0,0,0,,Аоба
Dialogue: 0,0:03:14.49,0:03:15.51,JP-SUB,,0,0,0,,Қайырлы таң Сакура
Dialogue: 0,0:03:16.31,0:03:17.82,JP-SUB,,0,0,0,,Мен де бүгін қомақты соманы алдым.
Dialogue: 0,0:03:21.50,0:03:24.98,JP-SUB,,0,0,0,,Эй Сакура, сен бүгін Огами-кунмен мектепке бардың ғой, солай ма?
Dialogue: 0,0:03:26.12,0:03:27.04,JP-SUB,,0,0,0,,Аоба
Dialogue: 0,0:03:27.37,0:03:29.13,JP-SUB,,0,0,0,,Мен білемін
Dialogue: 0,0:03:29.53,0:03:31.07,JP-SUB,,0,0,0,,Ештеңе айтудың қажеті жоқ
Dialogue: 0,0:03:38.20,0:03:39.45,JP-SUB,,0,0,0,,Кешіріңіз Аоба
Dialogue: 0,0:03:40.29,0:03:42.38,JP-SUB,,0,0,0,,Бұдан былай мен Огамимен бірге мектепке барамын және қайтамын.
Dialogue: 0,0:03:43.50,0:03:45.26,JP-SUB,,0,0,0,,Бұрынғыдай бірге
Dialogue: 0,0:03:48.69,0:03:50.03,JP-SUB,,0,0,0,,Сакура Құттықтаймыз
Dialogue: 0,0:03:50.41,0:03:52.35,JP-SUB,,0,0,0,,Жоқ, мен онша бақытты емеспін.
Dialogue: 0,0:03:52.79,0:03:55.15,JP-SUB,,0,0,0,,Олар сізді күні бойы бақылап отыратын сияқты емес.
Dialogue: 0,0:03:56.99,0:03:59.08,JP-SUB,,0,0,0,,Шие гүліне келгенде мен аздап қызғанамын.
Dialogue: 0,0:04:00.22,0:04:04.08,JP-SUB,,0,0,0,,Шынымен де, күні бойы Огами-кунға қарағым келеді.
Dialogue: 0,0:04:04.57,0:04:07.16,JP-SUB,,0,0,0,,Хмм, мен мұны істей алсам, жеңілдеп қалар едім.
Dialogue: 0,0:04:08.97,0:04:11.48,JP-SUB,,0,0,0,,Огами-кун, Сакураға қамқорлық жасашы.
Dialogue: 0,0:04:11.98,0:04:12.85,JP-SUB,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:04:13.10,0:04:15.11,JP-SUB,,0,0,0,,Ах, бірақ абай болу керек.
Dialogue: 0,0:04:16.63,0:04:21.57,JP-SUB,,0,0,0,,Огами, Сакуракожи Сакура, кетіңдер.
Dialogue: 0,0:04:21.80,0:04:24.36,JP-SUB,,0,0,0,,Сіз шие гүлдегеннен кейін келе жатқан ұлдардың көзіне түсесіз.
Dialogue: 0,0:04:33.65,0:04:34.90,JP-SUB,,0,0,0,,Мына жігітпен араласпа
Dialogue: 0,0:04:35.49,0:04:37.73,JP-SUB,,0,0,0,,Егер сіз қимыл жасағыңыз келсе, мен сізге қарсылас болуға рұқсат етіңіз.
Dialogue: 0,0:04:38.10,0:04:40.84,JP-SUB,,0,0,0,,Сакура керемет
Dialogue: 0,0:04:44.76,0:04:49.49,JP-SUB,,0,0,0,,Сакура Бұл Огами-кун туралы.
Dialogue: 0,0:04:51.52,0:04:55.43,JP-SUB,,0,0,0,,Сакуракоджи-сан, мені қорғамасаң жақсы.
Dialogue: 0,0:04:56.20,0:04:57.64,JP-SUB,,0,0,0,,Өйткені мен күштімін
Dialogue: 0,0:05:04.37,0:05:05.27,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:05:06.49,0:05:08.70,JP-SUB,,0,0,0,,Огами-кунның ертеңгі міндеті.
Dialogue: 0,0:05:08.85,0:05:11.68,JP-SUB,,0,0,0,,Кезекшілік күнделігі Оны алу үшін студенттер кеңесінің бөлмесіне барыңыз.
Dialogue: 0,0:05:12.13,0:05:13.12,JP-SUB,,0,0,0,,Студенттік кеңес бөлмесі
Dialogue: 0,0:05:13.59,0:05:15.83,JP-SUB,,0,0,0,,Түсіндім, сен әлі білмейсің.
Dialogue: 0,0:05:16.35,0:05:16.90,JP-SUB,,0,0,0,,Шынында да, осы дүкенде…
Dialogue: 0,0:05:17.15,0:05:18.44,JP-SUB,,0,0,0,,Маған жол көрсетуге рұқсат етіңіз
Dialogue: 0,0:05:22.59,0:05:24.55,JP-SUB,,0,0,0,,Сіз шынымен алаңдаушысыз.
Dialogue: 0,0:05:25.67,0:05:27.49,JP-SUB,,0,0,0,,Біртүрлі әрекет жасамасаңыз
Dialogue: 0,0:05:27.86,0:05:29.49,JP-SUB,,0,0,0,,Мен мектепте ештеңе істемеймін.
Dialogue: 0,0:05:30.10,0:05:31.96,JP-SUB,,0,0,0,,Мен де қиындықтан аулақ болғым келеді.
Dialogue: 0,0:05:33.53,0:05:35.81,JP-SUB,,0,0,0,,Мен де сен жоқта.
Dialogue: 0,0:05:35.99,0:05:38.35,JP-SUB,,0,0,0,,Біреуге сырыңды айттың ба деп қорқамын.
Dialogue: 0,0:05:38.57,0:05:39.91,JP-SUB,,0,0,0,,Мені дұрыс түсінгім келмейді.
Dialogue: 0,0:05:40.41,0:05:41.33,JP-SUB,,0,0,0,,Сонымен...
Dialogue: 0,0:05:42.10,0:05:45.95,JP-SUB,,0,0,0,,Хиитан мен Митан Мен оны таптым.
Dialogue: 0,0:05:46.10,0:05:51.32,JP-SUB,,0,0,0,,Фудзивара-сенпай, менің кеудеме ат қоюды доғарғаныңызды қалаймын.
Dialogue: 0,0:05:51.79,0:05:54.83,JP-SUB,,0,0,0,,А, мен түсіндім. Оң жақ кеудесі - Миитан.
Dialogue: 0,0:05:55.40,0:05:57.39,JP-SUB,,0,0,0,,Сол жақ кеудесі хитан.
Dialogue: 0,0:05:58.11,0:05:59.39,JP-SUB,,0,0,0,,Өзіңізді тым байыппен қабылдамаңыз
Dialogue: 0,0:06:00.59,0:06:02.93,JP-SUB,,0,0,0,,Маған өзімді ұнатамын
Dialogue: 0,0:06:02.93,0:06:03.63,JP-SUB,,0,0,0,,Аға
Dialogue: 0,0:06:04.22,0:06:04.89,T-JP-SUB,,0,0,0,,Хиитан
Dialogue: 0,0:06:04.25,0:06:04.84,JP-SUB,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:06:05.74,0:06:06.46,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:06:07.30,0:06:09.12,JP-SUB,,0,0,0,,Огами-кун да солай ойлайды.
Dialogue: 0,0:06:10.19,0:06:10.63,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:06:11.40,0:06:13.29,JP-SUB,,0,0,0,,Огами-кун да дос.
Dialogue: 0,0:06:13.54,0:06:16.75,JP-SUB,,0,0,0,,Ненене Огами-кун маған да ұнай бастады.
Dialogue: 0,0:06:17.10,0:06:17.92,JP-SUB,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:06:18.79,0:06:23.63,JP-SUB,,0,0,0,,Нене дыбысының сырын Огами-кунға арнайы айтуым керек шығар.
Dialogue: 0,0:06:28.78,0:06:30.19,JP-SUB,,0,0,0,,Көздің әртүрлі түстері
Dialogue: 0,0:06:35.89,0:06:36.86,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:06:45.55,0:06:48.61,JP-SUB,,0,0,0,,Кешіріңіз, Сенпай, бұл дұрыс емес адам болды.
Dialogue: 0,0:06:50.20,0:06:52.84,JP-SUB,,0,0,0,,Оками Окамиді күтіңіз
Dialogue: 0,0:06:53.04,0:06:54.58,JP-SUB,,0,0,0,,Бұл дұрыс емес адам болса, біз шеше алмаймыз.
Dialogue: 0,0:06:56.17,0:06:57.66,JP-SUB,,0,0,0,,А, не?
Dialogue: 0,0:07:01.26,0:07:04.42,JP-SUB,,0,0,0,,Мен онымен жұмыс істегім келеді. Бұл жақсы.
Dialogue: 0,0:07:08.00,0:07:09.64,JP-SUB,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:07:20.35,0:07:20.95,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:07:21.42,0:07:24.05,JP-SUB,,0,0,0,,Мен бүгін кешке дайынмын.
Dialogue: 0,0:07:24.75,0:07:27.98,JP-SUB,,0,0,0,,Кілтті себетке қалдырыңыз.
Dialogue: 0,0:07:28.48,0:07:30.29,JP-SUB,,0,0,0,,А, мен білемін.
Dialogue: 0,0:07:33.08,0:07:35.44,JP-SUB,,0,0,0,,Бұл не үшін, Сакуракоджи мырза?
Dialogue: 0,0:07:37.60,0:07:38.77,JP-SUB,,0,0,0,,Қазір телефоныңыз қандай?
Dialogue: 0,0:07:39.24,0:07:41.95,JP-SUB,,0,0,0,,Мен сенің тағы бір жаман нәрсе ойлап жатқаныңа сенімдімін.
Dialogue: 0,0:07:43.74,0:07:47.12,JP-SUB,,0,0,0,,Бұл не? Біртүрлі нәрсе.
Dialogue: 0,0:07:55.22,0:07:55.59,JP-SUB,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:07:56.14,0:07:57.41,JP-SUB,,0,0,0,,Әлгі иттің баласы.
Dialogue: 0,0:07:58.38,0:08:00.14,JP-SUB,,0,0,0,,Оның баласы болды ма?
Dialogue: 0,0:08:02.85,0:08:05.39,JP-SUB,,0,0,0,,Бұл бет дәл сол жігітке ұқсайды.
Dialogue: 0,0:08:08.09,0:08:10.01,JP-SUB,,0,0,0,,Қорқақтық та осыған ұқсас.
Dialogue: 0,0:08:12.57,0:08:15.33,JP-SUB,,0,0,0,,Түсіндім, сен оның баласысың ба?
Dialogue: 0,0:08:23.18,0:08:23.90,JP-SUB,,0,0,0,,Сол жігіт
Dialogue: 0,0:08:27.23,0:08:30.64,JP-SUB,,0,0,0,,Кешіріңіз, мен қаттырақ болғанымды қалаймын.
Dialogue: 0,0:08:32.53,0:08:35.04,JP-SUB,,0,0,0,,Сенің анаң мені қорғайды
Dialogue: 0,0:09:05.61,0:09:07.02,JP-SUB,,0,0,0,,Бұл тыныш.
Dialogue: 0,0:09:07.52,0:09:10.30,JP-SUB,,0,0,0,,Шартты бітім жасалды.
Dialogue: 0,0:09:10.63,0:09:11.25,JP-SUB,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:12.62,0:09:13.46,JP-SUB,,0,0,0,,Жарайды ма?
Dialogue: 0,0:09:14.18,0:09:15.55,JP-SUB,,0,0,0,,Менімен бірге келсең
Dialogue: 0,0:09:15.97,0:09:18.51,JP-SUB,,0,0,0,,Мен бұл бейбіт дүниеге қайта алмаймын.
Dialogue: 0,0:09:19.15,0:09:20.47,JP-SUB,,0,0,0,,Енді не айтуым керек?
Dialogue: 0,0:09:20.94,0:09:23.28,JP-SUB,,0,0,0,,Әрине, мен үшін бейбіт дүние жоқ.
Dialogue: 0,0:09:33.49,0:09:36.05,JP-SUB,,0,0,0,,Есікті құлыпсыз қалдыру абайсызда.
Dialogue: 0,0:09:38.64,0:09:41.37,JP-SUB,,0,0,0,,Не, сенің үйің?
Dialogue: 0,0:09:43.14,0:09:45.10,JP-SUB,,0,0,0,,Сіз шынымен менімен бірге келесіз бе?
Dialogue: 0,0:09:45.65,0:09:49.05,JP-SUB,,0,0,0,,Мм, сенің қалай өмір сүретініңді көрейік.
Dialogue: 0,0:09:52.03,0:09:52.53,JP-SUB,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:09:55.76,0:09:57.28,JP-SUB,,0,0,0,,Оками Хетай
Dialogue: 0,0:10:00.11,0:10:01.55,JP-SUB,,0,0,0,,Бұл не?
Dialogue: 0,0:10:02.32,0:10:05.56,JP-SUB,,0,0,0,,Бұл якуза кеңсесі.
Dialogue: 0,0:10:06.82,0:10:08.96,JP-SUB,,0,0,0,,Бұл күтпеген жағдай
Dialogue: 0,0:10:10.15,0:10:12.27,JP-SUB,,0,0,0,,Оками - якудза
Dialogue: 0,0:10:17.73,0:10:21.51,JP-SUB,,0,0,0,,Огами: Полиция келеді емес пе?
Dialogue: 0,0:10:21.91,0:10:24.07,JP-SUB,,0,0,0,,Сіздің кезегіңіз бүгін қолжетімді емес сияқты.
Dialogue: 0,0:10:26.23,0:10:29.07,JP-SUB,,0,0,0,,Сакуракоджи мырза, полиция да гурулар.
Dialogue: 0,0:10:29.34,0:10:29.76,JP-SUB,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:10:30.66,0:10:34.71,JP-SUB,,0,0,0,,Ей, ағайын, сенің ерік-жігерің жоқ.
Dialogue: 0,0:10:35.08,0:10:37.00,JP-SUB,,0,0,0,,Мен осындай нәрседен құтыла аламын деп ойладым...
Dialogue: 0,0:10:37.05,0:10:38.04,JP-SUB,,0,0,0,,Бұл мен күткеннен аз.
Dialogue: 0,0:10:38.56,0:10:40.04,JP-SUB,,0,0,0,,Бұл көп күш жұмсамайтын сияқты.
Dialogue: 0,0:10:40.04,0:10:42.44,JP-SUB,,0,0,0,,Ой, не деген әурешілік.
Dialogue: 0,0:10:42.51,0:10:43.48,JP-SUB,,0,0,0,,Бұл шешім қабылданған болуы керек.
Dialogue: 0,0:10:44.48,0:10:46.12,JP-SUB,,0,0,0,,Балалар, сендерді өлтіру қиын.
Dialogue: 0,0:10:47.19,0:10:48.50,JP-SUB,,0,0,0,,Бұл не?
Dialogue: 0,0:10:48.50,0:10:50.54,JP-SUB,,0,0,0,,Сен жақсы болуға тырыспайсың, балам.
Dialogue: 0,0:10:50.54,0:10:51.93,JP-SUB,,0,0,0,,Сенің таң қалғың келе ме?
Dialogue: 0,0:10:51.93,0:10:54.24,JP-SUB,,0,0,0,,Өз ұстанымыңды түсінесің бе, салбыраған бейбақ?
Dialogue: 0,0:10:54.24,0:10:55.96,JP-SUB,,0,0,0,,Will you be quiet?
Dialogue: 0,0:10:57.90,0:11:00.38,JP-SUB,,0,0,0,,Бауырым, сен қай топтансың?
Dialogue: 0,0:11:01.08,0:11:02.60,JP-SUB,,0,0,0,,First year Class B
Dialogue: 0,0:11:04.73,0:11:08.34,JP-SUB,,0,0,0,,Сол пікір мені қатты ренжітті, аға.
Dialogue: 0,0:11:09.03,0:11:11.74,JP-SUB,,0,0,0,,Сонда да біреуді өлтіру өте жұмсақ емес.
Dialogue: 0,0:11:12.26,0:11:14.03,JP-SUB,,0,0,0,,Маған аудармасын бере аласыз ба?
Dialogue: 0,0:11:14.48,0:11:17.31,JP-SUB,,0,0,0,,Себебі мен G-Falcon-ты жоғалттым
Dialogue: 0,0:11:17.41,0:11:20.02,JP-SUB,,0,0,0,,Тікелей сатып алу және сату керек пе?
Dialogue: 0,0:11:20.42,0:11:21.81,JP-SUB,,0,0,0,,Бұл азап болса керек.
Dialogue: 0,0:11:22.08,0:11:23.05,JP-SUB,,0,0,0,,Сіз
Dialogue: 0,0:11:23.45,0:11:25.59,JP-SUB,,0,0,0,,Бұлай ашық айтпаңыз.
Dialogue: 0,0:11:26.95,0:11:29.04,JP-SUB,,0,0,0,,Сен маған үндеме деп тұрсың ба?
Dialogue: 0,0:11:29.16,0:11:30.38,JP-SUB,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:32.02,0:11:34.28,JP-SUB,,0,0,0,,Сізде блеф жасауға батылдық бар.
Dialogue: 0,0:11:34.68,0:11:36.94,JP-SUB,,0,0,0,,Сату алаңы ретінде бұл жақсы.
Dialogue: 0,0:11:37.29,0:11:40.60,JP-SUB,,0,0,0,,А, жарайды, маған жұмысқа кел.
Dialogue: 0,0:11:41.24,0:11:43.58,JP-SUB,,0,0,0,,Ағам айтқандай, G Falcon кетті.
Dialogue: 0,0:11:43.58,0:11:44.92,JP-SUB,,0,0,0,,Қолым жетпейді
Dialogue: 0,0:11:45.25,0:11:47.68,JP-SUB,,0,0,0,,Иә, бұл жақсы жұмыс па?
Dialogue: 0,0:11:47.86,0:11:48.60,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:11:49.02,0:11:50.39,JP-SUB,,0,0,0,,Мен сұрасам болады ма?
Dialogue: 0,0:11:51.91,0:11:54.17,JP-SUB,,0,0,0,,Иә, бұл жақсы жұмыс.
Dialogue: 0,0:11:56.78,0:12:00.26,JP-SUB,,0,0,0,,Мен мұны сата аламын, бірақ қазіргі заманда.
Dialogue: 0,0:12:00.41,0:12:02.30,JP-SUB,,0,0,0,,Айналмалы қорлар тез таусылады
Dialogue: 0,0:12:02.84,0:12:04.68,JP-SUB,,0,0,0,,Сондықтан оны жем ретінде пайдаланады.
Dialogue: 0,0:12:07.24,0:12:09.75,JP-SUB,,0,0,0,,Тамақ адам деген тілектен.
Dialogue: 0,0:12:10.70,0:12:13.98,JP-SUB,,0,0,0,,Егер сіз бұл жігіттен сіз үшін барлық қауіпті жұмыстарды орындауды сұрасаңыз,
Dialogue: 0,0:12:13.98,0:12:16.46,JP-SUB,,0,0,0,,Егер дұрыс пайдаланбасаңыз, ол жоғалды.
Dialogue: 0,0:12:17.08,0:12:18.20,JP-SUB,,0,0,0,,Міне болды
Dialogue: 0,0:12:18.50,0:12:19.22,JP-SUB,,0,0,0,,Отбасы
Dialogue: 0,0:12:19.57,0:12:24.84,JP-SUB,,0,0,0,,Иә, әйелдер мен қыздар жақсы ақша табады.
Dialogue: 0,0:12:25.53,0:12:26.23,JP-SUB,,0,0,0,,Ұрлау?
Dialogue: 0,0:12:26.68,0:12:29.59,JP-SUB,,0,0,0,,G Falcon жігіттері дөрекі.
Dialogue: 0,0:12:29.66,0:12:31.18,JP-SUB,,0,0,0,,Ешқандай тыртық қалдырмаңыз.
Dialogue: 0,0:12:31.67,0:12:33.34,JP-SUB,,0,0,0,,Осы орайда, ағайын
Dialogue: 0,0:12:33.41,0:12:36.30,JP-SUB,,0,0,0,,Еріксіз ұрлауға жарамды.
Dialogue: 0,0:12:36.94,0:12:39.05,JP-SUB,,0,0,0,,Жоспарланған неше отбасы бар?
Dialogue: 0,0:12:39.45,0:12:40.60,JP-SUB,,0,0,0,,Төлемдер жоғары
Dialogue: 0,0:12:45.94,0:12:48.90,JP-SUB,,0,0,0,,Мен көремін. Ал полиция басқарады.
Dialogue: 0,0:12:50.41,0:12:51.58,JP-SUB,,0,0,0,,That's it.
Dialogue: 0,0:12:51.81,0:12:53.58,JP-SUB,,0,0,0,,Ұстап қалудың қажеті жоқ
Dialogue: 0,0:12:53.79,0:12:55.33,JP-SUB,,0,0,0,,Като мырза
Dialogue: 0,0:12:55.33,0:12:55.83,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:12:56.15,0:12:59.26,JP-SUB,,0,0,0,,Өзіңді алдама, сен әлі бандитсің бе?
Dialogue: 0,0:12:59.44,0:12:59.93,JP-SUB,,0,0,0,,Иә?
Dialogue: 0,0:13:00.50,0:13:04.16,JP-SUB,,0,0,0,,Сізге де солай. Полиция қызметкерлері адамдарды қорғауы керек.
Dialogue: 0,0:13:04.38,0:13:06.67,JP-SUB,,0,0,0,,Сіз бұл сызықтан тыс деп ойламайсыз ба?
Dialogue: 0,0:13:09.15,0:13:10.64,JP-SUB,,0,0,0,,Адамның жолы келді
Dialogue: 0,0:13:10.97,0:13:12.01,JP-SUB,,0,0,0,,Не болды?
Dialogue: 0,0:13:12.36,0:13:16.21,JP-SUB,,0,0,0,,Гаки, қазір мұндай нәрсе танымал емес.
Dialogue: 0,0:13:16.53,0:13:20.09,JP-SUB,,0,0,0,,Қыз бала, жыланның жолы – жылан.
Dialogue: 0,0:13:20.59,0:13:24.09,JP-SUB,,0,0,0,,Ересектер әлемі осылай жұмыс істейді.
Dialogue: 0,0:13:24.31,0:13:26.40,JP-SUB,,0,0,0,,Өскенде түсінерсің
Dialogue: 0,0:13:26.58,0:13:27.87,JP-SUB,,0,0,0,,Дегенмен, Нитта мырза
Dialogue: 0,0:13:28.51,0:13:31.52,JP-SUB,,0,0,0,,Енді мен оны көргенде, мен оны қайтара алмаймын.
Dialogue: 0,0:13:31.94,0:13:34.13,JP-SUB,,0,0,0,,Саған бұл қыз керек емес.
Dialogue: 0,0:13:36.07,0:13:37.34,JP-SUB,,0,0,0,,Балалар
Dialogue: 0,0:13:40.59,0:13:41.51,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:13:42.38,0:13:46.04,JP-SUB,,0,0,0,,Сакуракоджи мырза, бұл жігіттерге сөз жеткізу мүмкін емес.
Dialogue: 0,0:13:46.43,0:13:48.12,JP-SUB,,0,0,0,,Жалғыз жол - оны күштеп түсіру
Dialogue: 0,0:13:48.45,0:13:48.99,JP-SUB,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:13:50.66,0:13:52.37,JP-SUB,,0,0,0,,Бұл не жалын?
Dialogue: 0,0:13:53.49,0:13:56.23,JP-SUB,,0,0,0,,Көзге көз, тіске тіс
Dialogue: 0,0:13:56.53,0:13:58.12,JP-SUB,,0,0,0,,Жамандыққа зұлымдық
Dialogue: 0,0:14:00.45,0:14:01.69,JP-SUB,,0,0,0,,Өртену
Dialogue: 0,0:14:04.45,0:14:05.27,JP-SUB,,0,0,0,,Оны тоқтатыңыз.
Dialogue: 0,0:14:06.57,0:14:07.46,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:14:10.20,0:14:10.72,JP-SUB,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:14:12.41,0:14:13.13,JP-SUB,,0,0,0,,Хмм, осылайша бәрі жоспар бойынша жүреді.
Dialogue: 0,0:14:14.99,0:14:16.71,JP-SUB,,0,0,0,,Басыңды жұм
Dialogue: 0,0:14:16.71,0:14:17.58,JP-SUB,,0,0,0,,Хмм, осылайша бәрі жоспар бойынша жүреді.
Dialogue: 0,0:14:19.27,0:14:20.63,JP-SUB,,0,0,0,,Мына жерде
Dialogue: 0,0:14:20.81,0:14:22.50,JP-SUB,,0,0,0,,Өтінемін, өшіріңіз.
Dialogue: 0,0:14:22.50,0:14:23.52,JP-SUB,,0,0,0,,Алыс болыңыз
Dialogue: 0,0:14:24.06,0:14:24.69,JP-SUB,,0,0,0,,Хмм, осылайша бәрі жоспар бойынша жүреді.
Dialogue: 0,0:14:26.50,0:14:28.56,JP-SUB,,0,0,0,,Тоқта, Огами, тоқта.
Dialogue: 0,0:14:31.37,0:14:32.59,JP-SUB,,0,0,0,,Отбасымнан алыста~!
Dialogue: 0,0:14:36.47,0:14:37.53,JP-SUB,,0,0,0,,Белгі
Dialogue: 0,0:14:38.43,0:14:39.53,JP-SUB,,0,0,0,,Бұл не жалын?
Dialogue: 0,0:14:40.04,0:14:41.36,JP-SUB,,0,0,0,,Бұл не?
Dialogue: 0,0:14:45.02,0:14:47.33,JP-SUB,,0,0,0,,Бұл құбыжық па?
Dialogue: 0,0:14:51.18,0:14:52.40,JP-SUB,,0,0,0,,Көзге көз
Dialogue: 0,0:14:53.37,0:14:54.34,JP-SUB,,0,0,0,,Тіске арналған тіс
Dialogue: 0,0:14:55.40,0:14:56.80,JP-SUB,,0,0,0,,Жамандыққа зұлымдық
Dialogue: 0,0:15:32.56,0:15:34.72,JP-SUB,,0,0,0,,Офицер Като, кешігіп қалдыңыз.
Dialogue: 0,0:15:36.81,0:15:39.45,JP-SUB,,0,0,0,,Меніңше, ол тағы да әйелдерге жамандық жасап жатыр.
Dialogue: 0,0:15:40.64,0:15:41.76,JP-SUB,,0,0,0,,Вокзалға оралғыңыз келе ме?
Dialogue: 0,0:15:42.58,0:15:45.54,JP-SUB,,0,0,0,,Хитоми - бұл жоспардың соңғы нүктесі болғандықтан.
Dialogue: 0,0:15:54.58,0:15:55.20,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:15:58.88,0:15:59.63,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:16:00.97,0:16:01.72,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:16:02.29,0:16:05.99,JP-SUB,,0,0,0,,Мен оны өлтірген жоқпын. Оны өлтірместен амалы болған шығар.
Dialogue: 0,0:16:07.28,0:16:08.63,JP-SUB,,0,0,0,,Қандай әдіс?
Dialogue: 0,0:16:10.59,0:16:12.45,JP-SUB,,0,0,0,,Қандай әдіс болды?
Dialogue: 0,0:16:13.20,0:16:17.20,JP-SUB,,0,0,0,,Оларды өлтірмегенде, олардың құрбаны бола беретін еді.
Dialogue: 0,0:16:17.60,0:16:18.24,JP-SUB,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:16:18.37,0:16:19.96,JP-SUB,,0,0,0,,Оны маған беріңіз.
Dialogue: 0,0:16:21.43,0:16:23.76,JP-SUB,,0,0,0,,Маған беріңіз
Dialogue: 0,0:16:24.61,0:16:27.94,JP-SUB,,0,0,0,,Оның үстіне сөзің жамандарға жетпеді.
Dialogue: 0,0:16:28.51,0:16:30.47,JP-SUB,,0,0,0,,Мұндай нәрсе танымал емес.
Dialogue: 0,0:16:30.47,0:16:33.31,JP-SUB,,0,0,0,,Ересектер әлемі осылай жұмыс істейді
Dialogue: 0,0:16:33.31,0:16:34.67,JP-SUB,,0,0,0,,Сізге бұл қажет емес.
Dialogue: 0,0:16:35.02,0:16:37.75,JP-SUB,,0,0,0,,Зұлым адамдардың күшпен құлатудан басқа амалы жоқ.
Dialogue: 0,0:16:40.46,0:16:41.06,JP-SUB,,0,0,0,,Бірақ
Dialogue: 0,0:16:44.37,0:16:45.19,JP-SUB,,0,0,0,,Бірақ
Dialogue: 0,0:16:48.86,0:16:49.83,JP-SUB,,0,0,0,,Күшік
Dialogue: 0,0:16:54.46,0:16:56.92,JP-SUB,,0,0,0,,Күте тұрыңыз, қазір бәрі жақсы болады.
Dialogue: 0,0:16:57.79,0:16:59.30,JP-SUB,,0,0,0,,Амансың ба?
Dialogue: 0,0:16:59.55,0:17:02.63,JP-SUB,,0,0,0,,Дұрыс, бұл жерден бірге кетейік. Үй қайда?
Dialogue: 0,0:17:03.48,0:17:04.45,JP-SUB,,0,0,0,,Үй?
Dialogue: 0,0:17:05.91,0:17:08.45,JP-SUB,,0,0,0,,Жоқ, мен үйге бара алмаймын.
Dialogue: 0,0:17:09.92,0:17:12.23,JP-SUB,,0,0,0,,Бұл менің басымнан өтті
Dialogue: 0,0:17:13.92,0:17:16.28,JP-SUB,,0,0,0,,Мен енді үйге бара алмаймын
Dialogue: 0,0:17:17.57,0:17:18.47,JP-SUB,,0,0,0,,әкенің кім екенін біледі: ол тыңшы
Dialogue: 0,0:17:18.59,0:17:22.47,JP-SUB,,0,0,0,,Өмірім тоз-тоз, Ата-анам да сондай.
Dialogue: 0,0:17:23.54,0:17:27.54,JP-SUB,,0,0,0,,Енді жоқ, ұнамайды, бітті.
Dialogue: 0,0:17:28.48,0:17:30.05,JP-SUB,,0,0,0,,Мен өлгенімді жақсы көремін
Dialogue: 0,0:17:30.87,0:17:33.23,JP-SUB,,0,0,0,,Өлген жақсы
Dialogue: 0,0:17:33.23,0:17:34.62,JP-SUB,,0,0,0,,Не деген ақымақ?
Dialogue: 0,0:17:36.04,0:17:36.83,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:17:39.84,0:17:40.86,JP-SUB,,0,0,0,,Содан кейін өл.
Dialogue: 0,0:17:40.86,0:17:42.28,JP-SUB,,0,0,0,,Тоқта, Огами
Dialogue: 0,0:17:44.24,0:17:45.76,JP-SUB,,0,0,0,,Тоқта, Огами.
Dialogue: 0,0:17:46.28,0:17:47.17,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:17:47.62,0:17:48.56,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:17:52.94,0:17:59.21,JP-SUB,,0,0,0,,Соғыс алаңындағы сарбаздар—
Dialogue: 0,0:18:02.59,0:18:06.11,JP-SUB,,0,0,0,,Қиналсаң, ұнатпайсың, өлгің келеді.
Dialogue: 0,0:18:06.99,0:18:09.77,JP-SUB,,0,0,0,,Себебі сен тірісің.
Dialogue: 0,0:18:10.95,0:18:12.49,JP-SUB,,0,0,0,,Өлгің келмесе, жайбарақат болма.
Dialogue: 0,0:18:13.59,0:18:16.12,JP-SUB,,0,0,0,,Ауырсыну арқылы жорғалау
Dialogue: 0,0:18:17.58,0:18:18.76,JP-SUB,,0,0,0,,Толық өмір сүріңіз
Dialogue: 0,0:18:20.11,0:18:23.27,JP-SUB,,0,0,0,,Әлі де өле алмасаң, маған кел.
Dialogue: 0,0:18:24.75,0:18:25.83,JP-SUB,,0,0,0,,Э? Қайда?
Dialogue: 0,0:18:39.53,0:18:42.70,JP-SUB,,0,0,0,,Огами, неге соншалықты ұзаққа бардың?
Dialogue: 0,0:18:44.13,0:18:47.61,JP-SUB,,0,0,0,,Сіз қаншалықты зұлымсыз? Қаншалықты...
Dialogue: 0,0:18:51.72,0:18:52.31,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:18:57.31,0:18:59.11,JP-SUB,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:18:59.68,0:19:03.56,JP-SUB,,0,0,0,,Оками, мен сенің жылуыңды сеземін.
Dialogue: 0,0:19:04.28,0:19:06.53,JP-SUB,,0,0,0,,Сакуракоджи мырза, не?
Dialogue: 0,0:19:07.41,0:19:10.79,JP-SUB,,0,0,0,,Бұл құшақтау. Бұл дене-дене сөйлесуді қамтитын құшақтау.
Dialogue: 0,0:19:13.94,0:19:15.70,JP-SUB,,0,0,0,,Мен сенің ұрысып жатқаныңды білемін
Dialogue: 0,0:19:16.25,0:19:17.92,JP-SUB,,0,0,0,,Сіздің өз себептеріңіз болуы мүмкін.
Dialogue: 0,0:19:19.68,0:19:21.66,JP-SUB,,0,0,0,,Бірақ мен мұны мойындай алмаймын.
Dialogue: 0,0:19:22.28,0:19:23.60,JP-SUB,,0,0,0,,Сондықтан мен де ұрысамын.
Dialogue: 0,0:19:24.30,0:19:27.49,JP-SUB,,0,0,0,,Сөзім саған жеткенше, Қайта-қайта саған қарай бет алам.
Dialogue: 0,0:19:28.81,0:19:30.02,JP-SUB,,0,0,0,,Өзгерген нәрселер
Dialogue: 0,0:19:31.19,0:19:33.83,JP-SUB,,0,0,0,,Сирек кездесетін түр болғандықтан ба?
Dialogue: 0,0:19:35.15,0:19:37.50,JP-SUB,,0,0,0,,Сонымен, бұл сирек кездесетін түр дегеніміз не?
Dialogue: 0,0:19:39.79,0:19:42.17,JP-SUB,,0,0,0,,Сакуракоджи мырза, кешіріңіз.
Dialogue: 0,0:19:42.58,0:19:45.97,JP-SUB,,0,0,0,,Мені ешкім түсіне алмайды, түсінгім де келмейді.
Dialogue: 0,0:19:46.41,0:19:46.79,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:19:55.10,0:19:59.46,JP-SUB,,0,0,0,,Бұл менмін. Маған сол жетер. Сакуракоджи мырзаны шығарып алыңыз.
Dialogue: 0,0:20:05.71,0:20:07.03,JP-SUB,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:20:07.62,0:20:12.92,JP-SUB,,0,0,0,,Бұл Такада, полиция бастығы. Кешіріңіз, бірақ мен сіздің барлық достарыңызды өлтірдім.
Dialogue: 0,0:20:14.90,0:20:17.72,JP-SUB,,0,0,0,,Сіз маған араласып жүрген адамыңыздың қайда екенін айта аласыз ба?
Dialogue: 0,0:20:18.42,0:20:20.73,JP-SUB,,0,0,0,,Сіз кодты бұзушысыз ба?
Dialogue: 0,0:20:21.22,0:20:22.47,JP-SUB,,0,0,0,,Хитоми қайда орналасқан?
Dialogue: 0,0:20:30.35,0:20:34.17,JP-SUB,,0,0,0,,Хитоми-сан, маған көмектесші. Мені кодты бұзушы қуып жатыр.
Dialogue: 0,0:20:34.35,0:20:36.04,JP-SUB,,0,0,0,,Бұл қиын.
Dialogue: 0,0:20:36.95,0:20:39.52,JP-SUB,,0,0,0,,Маған көмектесіңізші. Мен ынтымақтасатын едім.
Dialogue: 0,0:20:39.72,0:20:42.25,JP-SUB,,0,0,0,,Иә, рахмет, бұл пайдалы болды.
Dialogue: 0,0:20:43.06,0:20:47.13,JP-SUB,,0,0,0,,Бірақ қазір істеп жатқан ісіңіз сыныпсыз, маған ұнамайды.
Dialogue: 0,0:20:48.14,0:20:50.48,JP-SUB,,0,0,0,,Қош бол, жауыз бастық.
Dialogue: 0,0:20:52.10,0:20:53.91,JP-SUB,,0,0,0,,Хитоми мырза
Dialogue: 0,0:20:54.22,0:20:58.77,JP-SUB,,0,0,0,,Мен сенімен қызметтес болсам да Жоспарыңмен ынтымақтассам да
Dialogue: 0,0:21:04.45,0:21:04.95,JP-SUB,,0,0,0,,Столкер… не болып жатыр өзі?
Dialogue: 0,0:21:10.50,0:21:15.09,JP-SUB,,0,0,0,,Көзге көз, тіске тіс, зұлымдыққа зұлымдық
Dialogue: 0,0:21:22.97,0:21:23.45,JP-SUB,,0,0,0,,...
Dialogue: 0,0:21:27.35,0:21:30.63,JP-SUB,,0,0,0,,Көзге көз, тіске тіс
Dialogue: 0,0:21:38.30,0:21:40.64,JP-SUB,,0,0,0,,Зұлымдықтың әділет балғасы
Dialogue: 0,0:21:46.84,0:21:48.05,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:21:49.26,0:21:53.51,JP-SUB,,0,0,0,,Сіз бұл шебердің ашылу актісісіз.
Dialogue: 0,0:21:55.85,0:21:58.29,ED JP-B,,0,0,0,,Сен де бір күні түсінесің
Dialogue: 0,0:21:58.29,0:22:00.70,ED JP-B,,0,0,0,,Ақ қарға қайда барады
Dialogue: 0,0:22:00.70,0:22:03.38,ED JP-B,,0,0,0,,Ешкімді танымай ұшамыз
Dialogue: 0,0:22:03.38,0:22:06.02,ED JP-B,,0,0,0,,Гүлденген қала
Dialogue: 0,0:22:16.80,0:22:20.93,ED JP-G,,0,0,0,,Тек өмір сүруге себеп іздеу
Dialogue: 0,0:22:20.93,0:22:23.14,ED JP-G,,0,0,0,,Менің бос өзім
Dialogue: 0,0:22:23.14,0:22:26.12,ED JP-G,,0,0,0,,Өйткені бұл ұят
Dialogue: 0,0:22:26.40,0:22:31.24,ED JP-G,,0,0,0,,Біз әлем шешкен ережелерді ұстанамыз
Dialogue: 0,0:22:31.24,0:22:35.92,ED JP-G,,0,0,0,,Жай ғана беріліңіз және күліңіз.
Dialogue: 0,0:22:36.93,0:22:41.38,ED JP-B,,0,0,0,,Жалаңаш, Түйсіктерім мені алып кеткендей
Dialogue: 0,0:22:41.56,0:22:45.61,ED JP-B,,0,0,0,,Көзімнен қашқан шындық
Dialogue: 0,0:22:45.66,0:22:48.07,ED JP-B,,0,0,0,,Ешкім үшін емес
Dialogue: 0,0:22:48.07,0:22:50.18,ED JP-B,,0,0,0,,Шешім қабылданды
Dialogue: 0,0:22:50.18,0:22:55.05,ED JP-B,,0,0,0,,Қара киімдеріңді тастап, тұрыңдар.
Dialogue: 0,0:22:55.30,0:22:57.54,ED JP-B,,0,0,0,,Таза тілек
Dialogue: 0,0:22:57.54,0:23:01.57,ED JP-B,,0,0,0,,Қанатымыз енді жоғалды
Dialogue: 0,0:23:01.57,0:23:04.50,ED JP-B,,0,0,0,,Оны сілкіп таста да, қанатыңды ат
Dialogue: 0,0:23:04.50,0:23:06.86,ED JP-B,,0,0,0,,Қорықпа
Dialogue: 0,0:23:06.98,0:23:12.33,ED JP-B,,0,0,0,,Жауап қараңғылықтан тыс болса
Dialogue: 0,0:23:25.51,0:23:29.51,JP-SUB,,0,0,0,,Келесі кодты бұзушы 4-эпизод Уақыт дауысы
Dialogue: 0,0:23:30.88,0:23:32.90,JP-SUB,,0,0,0,,Жалғыз болмасаңыз, өзіңізді қауіпсіз сезінесіз.
Dialogue: 0,0:23:33.54,0:23:35.59,JP-SUB,,0,0,0,,Сенің достарың бар, Огами.
Dialogue: 0,0:23:37.09,0:23:43.09,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory