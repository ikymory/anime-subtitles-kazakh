Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.86,0:00:15.74,OP JP,,0,0,0,,Неліктен жұмбақ шешу керек
Dialogue: 0,0:00:16.03,0:00:19.14,OP JP,,0,0,0,,Соңғы бөлім
Dialogue: 0,0:00:19.29,0:00:23.14,OP JP,,0,0,0,,Сіз іздеген жерде емес
Dialogue: 0,0:00:23.47,0:00:26.42,OP JP,,0,0,0,,Қорқыныш сезіміне бой алдыру
Dialogue: 0,0:00:26.55,0:00:30.08,OP JP,,0,0,0,,Айнымас жойылуға
Dialogue: 0,0:00:30.28,0:00:33.73,OP JP,,0,0,0,,Сенімсіз өзін-өзі бағалау
Dialogue: 0,0:00:34.10,0:00:37.58,OP JP,,0,0,0,,тірі қал Мен жете алмаймын
Dialogue: 0,0:00:37.86,0:00:43.55,OP JP,,0,0,0,,Жасырын естеліктердің кейінгі бейнесінде
Dialogue: 0,0:00:44.05,0:00:48.22,OP JP,,0,0,0,,Шексіз ҚАРА ҰЯТТЫ босатыңыз
Dialogue: 0,0:00:48.47,0:00:51.95,OP JP,,0,0,0,,Осы нәзік дүниенің соңы
Dialogue: 0,0:00:52.12,0:00:56.30,OP JP,,0,0,0,,Ұмытқан тынысым - үнсіздік
Dialogue: 0,0:00:56.30,0:00:59.95,OP JP,,0,0,0,,Көз алдымда арам тарады
Dialogue: 0,0:00:59.95,0:01:03.03,OP JP,,0,0,0,,Қараңғыда жерленген
Dialogue: 0,0:01:03.18,0:01:06.27,OP JP,,0,0,0,,Тексерілді, біз білеміз
Dialogue: 0,0:01:06.79,0:01:12.68,OP JP,,0,0,0,,Өтпелі екпінділікте
Dialogue: 0,0:01:13.15,0:01:17.33,OP JP,,0,0,0,,Еркін қараңыз
Dialogue: 0,0:01:31.88,0:01:36.26,JP-SUB,,0,0,0,,Бүгін ерте Diet мүшесі Шигеру Табатаның үйінде өрт болды.
Dialogue: 0,0:01:36.98,0:01:40.08,JP-SUB,,0,0,0,,Өрт жатын бөлмені және дәліздің бір бөлігін шарпыды, бірақ сөндірілді.
Dialogue: 0,0:01:40.16,0:01:43.54,JP-SUB,,0,0,0,,Өртенген қирандылардан Табата мырзаның денесі табылды.
Dialogue: 0,0:01:43.98,0:01:45.36,JP-SUB,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:01:45.90,0:01:50.10,JP-SUB,,0,0,0,,Мен Табата-кун болашақта көбірек жұмыс істейді деп үміттендім.
Dialogue: 0,0:01:50.86,0:01:54.12,JP-SUB,,0,0,0,,Өрттің шығуына жатын бөлмесінде ұйықтап жатқанда темекі шегу себеп болған деген сенім бар.
Dialogue: 0,0:01:54.36,0:01:55.80,JP-SUB,,0,0,0,,Сіз әдетте көп темекі шегетінсіз бе?
Dialogue: 0,0:01:56.64,0:01:59.26,JP-SUB,,0,0,0,,Мен сізді темекі шегетін адам деп естідім.
Dialogue: 0,0:02:00.14,0:02:02.04,JP-SUB,,0,0,0,,Бәрібір ұят.
Dialogue: 0,0:02:04.74,0:02:05.22,JP-SUB,,0,0,0,,Премьер-министр
Dialogue: 0,0:02:05.54,0:02:07.26,JP-SUB,,0,0,0,,Токисама пайда болды
Dialogue: 0,0:02:08.30,0:02:09.62,JP-SUB,,0,0,0,,Жарайды, өтсін.
Dialogue: 0,0:02:11.14,0:02:14.16,JP-SUB,,0,0,0,,Сізді осында көргеніме қуаныштымын.
Dialogue: 0,0:02:15.42,0:02:16.84,JP-SUB,,0,0,0,,Кеше түнде қиын болды.
Dialogue: 0,0:02:17.08,0:02:18.36,JP-SUB,,0,0,0,,Орынға отырыңыз.
Dialogue: 0,0:02:18.76,0:02:19.32,JP-SUB,,0,0,0,,Келіңіздер
Dialogue: 0,0:02:20.92,0:02:22.64,JP-SUB,,0,0,0,,Әй, біраз уақыт болды.
Dialogue: 0,0:02:22.74,0:02:24.50,JP-SUB,,0,0,0,,Таңғы асты бірге ішейік
Dialogue: 0,0:02:24.86,0:02:26.20,JP-SUB,,0,0,0,,Табиғаттан тыс қабілеттерді зерттеу
Dialogue: 0,0:02:27.26,0:02:29.40,JP-SUB,,0,0,0,,Сіз өте тентек әрекеттер жасап жатырсыз.
Dialogue: 0,0:02:29.86,0:02:30.50,JP-SUB,,0,0,0,,Премьер-министр
Dialogue: 0,0:02:31.12,0:02:33.48,JP-SUB,,0,0,0,,Бұлай айтпа.
Dialogue: 0,0:02:34.14,0:02:37.80,JP-SUB,,0,0,0,,Мұны тек Премьер-министр жасаса, бұл проблема болар еді.
Dialogue: 0,0:02:43.06,0:02:43.86,JP-SUB,,0,0,0,,Премьер-министр
Dialogue: 0,0:02:45.60,0:02:46.58,JP-SUB,,0,0,0,,Аз да болса
Dialogue: 0,0:02:50.44,0:02:54.48,JP-SUB,,0,0,0,,Мен сізге код бұзғыштардағы жүктемені аз да болса азайта алғым келеді.
Dialogue: 0,0:02:54.48,0:02:55.92,JP-SUB,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:02:57.00,0:02:58.92,JP-SUB,,0,0,0,,Мен саған қиналып тұрмын.
Dialogue: 0,0:02:59.48,0:03:02.68,JP-SUB,,0,0,0,,Мен әке ретінде бұл туралы көбірек білемін.
Dialogue: 0,0:03:03.72,0:03:07.10,JP-SUB,,0,0,0,,Мен әкелік іспен айналысқым келді, осылай істедім.
Dialogue: 0,0:03:07.28,0:03:08.82,JP-SUB,,0,0,0,,Мен кодты бұзушымын
Dialogue: 0,0:03:09.66,0:03:11.94,JP-SUB,,0,0,0,,Сіз ата-ана да, бала да емессіз.
Dialogue: 0,0:03:14.02,0:03:17.32,JP-SUB,,0,0,0,,Сен әлі Ненеге ашулысың.
Dialogue: 0,0:03:18.80,0:03:21.18,JP-SUB,,0,0,0,,Мен де ауырып тұрмын.
Dialogue: 0,0:03:21.90,0:03:24.80,JP-SUB,,0,0,0,,Сол баланы сол күйге қою, т.б.
Dialogue: 0,0:03:25.68,0:03:26.58,JP-SUB,,0,0,0,,Бұл уәде.
Dialogue: 0,0:03:27.44,0:03:29.06,JP-SUB,,0,0,0,,Мен сенің итің боламын
Dialogue: 0,0:03:29.30,0:03:30.76,JP-SUB,,0,0,0,,Жаман адамдарды жою
Dialogue: 0,0:03:31.26,0:03:32.68,JP-SUB,,0,0,0,,Әпкеңді жайына қалдыр
Dialogue: 0,0:03:33.34,0:03:34.20,JP-SUB,,0,0,0,,Сіз солай шештіңіз.
Dialogue: 0,0:03:34.78,0:03:35.60,JP-SUB,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:03:36.20,0:03:38.06,JP-SUB,,0,0,0,,Сен оны көруге үнсіз барған сияқтысың.
Dialogue: 0,0:03:39.26,0:03:41.34,JP-SUB,,0,0,0,,Нене қалай болдыңыз?
Dialogue: 0,0:04:02.66,0:04:04.10,JP-SUB,,0,0,0,,Қорқақ
Dialogue: 0,0:04:11.68,0:04:13.94,JP-SUB,,0,0,0,,Бұл да үкімет билігіне байланысты ма?
Dialogue: 0,0:04:22.72,0:04:25.00,JP-SUB,,0,0,0,,Үкімет кодты ажыратқышты күшейтеді
Dialogue: 0,0:04:26.24,0:04:27.64,JP-SUB,,0,0,0,,Ешкім білмейді.
Dialogue: 0,0:04:28.22,0:04:30.14,JP-SUB,,0,0,0,,Осындай істер жасалып жатқанымен
Dialogue: 0,0:04:36.36,0:04:36.98,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:04:40.86,0:04:44.06,JP-SUB,,0,0,0,,Эй, сендер бір-біріңді білесіңдер ме?
Dialogue: 0,0:04:45.76,0:04:47.74,JP-SUB,,0,0,0,,Қымбаттым, менің сенен бір жақсылығым бар.
Dialogue: 0,0:04:49.06,0:04:49.68,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:04:50.04,0:04:52.18,JP-SUB,,0,0,0,,Сіз оны біраз уақытқа алып тастай аласыз ба?
Dialogue: 0,0:04:56.82,0:05:00.90,JP-SUB,,0,0,0,,Едемде сіз Сакуракоджи Сакураны Табата резиденциясына әкелдіңіз.
Dialogue: 0,0:05:01.18,0:05:03.36,JP-SUB,,0,0,0,,Өзіңізді тәуекелге қоюдан ыңғайсыздау
Dialogue: 0,0:05:04.16,0:05:05.98,JP-SUB,,0,0,0,,Иден Сакуракоджи мырза туралы айтты.
Dialogue: 0,0:05:07.06,0:05:08.44,JP-SUB,,0,0,0,,Едемнен келген бұйрық
Dialogue: 0,0:05:09.18,0:05:11.30,JP-SUB,,0,0,0,,Сен ол баланы қорға.
Dialogue: 0,0:05:14.28,0:05:15.16,JP-SUB,,0,0,0,,Неге мен?
Dialogue: 0,0:05:16.10,0:05:17.22,JP-SUB,,0,0,0,,Мен адамдарға қараймын
Dialogue: 0,0:05:19.70,0:05:21.48,JP-SUB,,0,0,0,,Мұны жай ғана айтпаңыз.
Dialogue: 0,0:05:21.96,0:05:23.96,JP-SUB,,0,0,0,,Ерінбей еңбек ет
Dialogue: 0,0:05:24.54,0:05:25.22,JP-SUB,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:05:28.30,0:05:31.08,JP-SUB,,0,0,0,,Сенің Эйденді ұнатпайтыныңды білемін.
Dialogue: 0,0:05:31.78,0:05:33.50,JP-SUB,,0,0,0,,Шынымды айтсам, маған да ұнамайды.
Dialogue: 0,0:05:34.60,0:05:36.74,JP-SUB,,0,0,0,,Бірақ ашық көрсетсең де
Dialogue: 0,0:05:36.98,0:05:38.42,JP-SUB,,0,0,0,,Бұл жай ғана қозғалуды қиындатады.
Dialogue: 0,0:05:39.52,0:05:41.64,JP-SUB,,0,0,0,,Бұл қыз туралы толығырақ мына жерден қараңыз.
Dialogue: 0,0:05:42.36,0:05:43.22,JP-SUB,,0,0,0,,Сирек кездесетін түр болғанымен
Dialogue: 0,0:05:43.68,0:05:47.36,JP-SUB,,0,0,0,,Олардың күзетшілеріне кодты ажыратқыштарды бекітуге баратын себебі болуы керек.
Dialogue: 0,0:05:51.26,0:05:52.66,JP-SUB,,0,0,0,,Бет-әлпетің мен екпінің—
Dialogue: 0,0:05:55.24,0:05:55.70,JP-SUB,,0,0,0,,Нөл
Dialogue: 0,0:06:00.56,0:06:02.94,JP-SUB,,0,0,0,,Соңғы уақытта сіз толық емес жұмыс күнімен жұмыс істеп жатырсыз.
Dialogue: 0,0:06:03.82,0:06:05.84,JP-SUB,,0,0,0,,Жақында жоғалады деп ойлаймын
Dialogue: 0,0:06:06.80,0:06:07.54,JP-SUB,,0,0,0,,Абайлаңыз
Dialogue: 0,0:06:16.80,0:06:18.36,JP-SUB,,0,0,0,,Ол әдемі адам.
Dialogue: 0,0:06:19.34,0:06:21.46,JP-SUB,,0,0,0,,Бұл адам да кодты бұзушы ма?
Dialogue: 0,0:06:23.06,0:06:25.42,JP-SUB,,0,0,0,,Маған Токи-кун ұнайды, Маған қазіргі адам ұнайды.
Dialogue: 0,0:06:26.00,0:06:29.64,JP-SUB,,0,0,0,,Ogami, you have quite a few friends too.
Dialogue: 0,0:06:30.38,0:06:31.50,JP-SUB,,0,0,0,,Менің достарым жоқ
Dialogue: 0,0:06:32.10,0:06:35.02,JP-SUB,,0,0,0,,Мен жоқпын. Мен кодты бұзушымын.
Dialogue: 0,0:06:35.28,0:06:36.58,JP-SUB,,0,0,0,,Бұл жақсы
Dialogue: 0,0:06:37.02,0:06:38.08,JP-SUB,,0,0,0,,Мен өзімді жеңіл сезіндім.
Dialogue: 0,0:06:38.38,0:06:41.52,JP-SUB,,0,0,0,,Сізге қамқорлық жасайтын адамның болуы маңызды.
Dialogue: 0,0:06:45.92,0:06:49.18,JP-SUB,,0,0,0,,Оками: Кодты бұзушы достар ғана емес.
Dialogue: 0,0:06:49.54,0:06:52.18,JP-SUB,,0,0,0,,Егер бірдеңе болса, сыныптағы барлық адамдармен тіл табысуға тырысыңыз.
Dialogue: 0,0:06:52.78,0:06:54.08,JP-SUB,,0,0,0,,Бұл қызықтырақ
Dialogue: 0,0:06:54.74,0:06:55.78,JP-SUB,,0,0,0,,(Масато) Юджи Итадориге көз салып тұрып—
Dialogue: 0,0:06:56.78,0:06:58.22,JP-SUB,,0,0,0,,Сыныптастарыңмен жақсы аралассаң да
Dialogue: 0,0:06:58.98,0:07:01.78,JP-SUB,,0,0,0,,They contribute nothing to my purpose
Dialogue: 0,0:07:02.82,0:07:03.98,JP-SUB,,0,0,0,,It's a waste of time
Dialogue: 0,0:07:04.54,0:07:05.76,JP-SUB,,0,0,0,,Тым тартылды
Dialogue: 0,0:07:06.08,0:07:08.20,JP-SUB,,0,0,0,,Менің жеке тұлғамның белгілі болуы ақымақтық.
Dialogue: 0,0:07:08.92,0:07:11.92,JP-SUB,,0,0,0,,Or code breakers are not friends
Dialogue: 0,0:07:12.56,0:07:14.68,JP-SUB,,0,0,0,,Олар тек мүдделері бірдей әріптестер.
Dialogue: 0,0:07:17.74,0:07:18.68,JP-SUB,,0,0,0,,Асығыңыз!
Dialogue: 0,0:07:24.98,0:07:27.06,JP-SUB,,0,0,0,,О, шие ерте гүлдейді
Dialogue: 0,0:07:27.20,0:07:28.16,JP-SUB,,0,0,0,,Не болды?
Dialogue: 0,0:07:28.16,0:07:30.40,JP-SUB,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:07:30.72,0:07:31.28,JP-SUB,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:07:32.42,0:07:33.44,JP-SUB,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:07:33.76,0:07:35.40,JP-SUB,,0,0,0,,Ештеңе
Dialogue: 0,0:07:39.86,0:07:42.96,JP-SUB,,0,0,0,,Әй, менің үстелімді бүлдірме.
Dialogue: 0,0:07:42.96,0:07:44.12,JP-SUB,,0,0,0,,Wariiwarii
Dialogue: 0,0:07:44.30,0:07:46.00,JP-SUB,,0,0,0,,Class will start soon.
Dialogue: 0,0:07:49.38,0:07:50.66,JP-SUB,,0,0,0,,Басып шығаруды бұраңыз
Dialogue: 0,0:07:51.20,0:07:52.44,JP-SUB,,0,0,0,,Уақыт отыз минут.
Dialogue: 0,0:08:07.52,0:08:08.70,JP-SUB,,0,0,0,,Қараңызшы, Сакуракоджи
Dialogue: 0,0:08:08.70,0:08:09.72,JP-SUB,,0,0,0,,Do not look around
Dialogue: 0,0:08:09.72,0:08:10.90,JP-SUB,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:08:11.18,0:08:12.06,JP-SUB,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:30.40,0:08:34.16,JP-SUB,,0,0,0,,Не болып жатқанын ешкім білмейді.
Dialogue: 0,0:08:35.80,0:08:37.60,JP-SUB,,0,0,0,,Сырыңды айтсаң
Dialogue: 0,0:08:38.64,0:08:41.64,JP-SUB,,0,0,0,,Мен сенің досыңды өртеуден тайынбас едім
Dialogue: 0,0:08:42.56,0:08:43.94,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:08:46.20,0:08:50.54,JP-SUB,,0,0,0,,Қараңғыда бала демін басып, тығылды.
Dialogue: 0,0:08:51.28,0:08:55.20,JP-SUB,,0,0,0,,Күдікті бала әйелдің бөлмесінің қараңғылығына жасырын кіріп кетті.
Dialogue: 0,0:08:55.54,0:08:58.06,JP-SUB,,0,0,0,,Мен шындықты көруге тырыстым
Dialogue: 0,0:08:58.76,0:09:00.40,JP-SUB,,0,0,0,,Миши Миши
Dialogue: 0,0:09:01.40,0:09:03.24,JP-SUB,,0,0,0,,Әйелдің бөлмесіндегі еден сықырлайды.
Dialogue: 0,0:09:04.10,0:09:06.76,JP-SUB,,0,0,0,,Бала тақтадағы сәл ашылған саңылау арқылы қарады.
Dialogue: 0,0:09:07.04,0:09:09.00,JP-SUB,,0,0,0,,Бөлмеге қарады
Dialogue: 0,0:09:09.82,0:09:14.80,JP-SUB,,0,0,0,,Бала төсекте жатқан әйелді көрді.
Dialogue: 0,0:09:17.10,0:09:20.58,JP-SUB,,0,0,0,,Ал қолында өрескел арқанмен жақындап келе жатқан әйел мұғалімнің бейнесі.
Dialogue: 0,0:09:21.28,0:09:24.14,JP-SUB,,0,0,0,,Ұстаз әйел сиқырлы мағынамен айтты.
Dialogue: 0,0:09:24.84,0:09:25.98,JP-SUB,,0,0,0,,Хайке-кун
Dialogue: 0,0:09:29.08,0:09:30.52,JP-SUB,,0,0,0,,О, Канда мырза
Dialogue: 0,0:09:31.26,0:09:34.92,JP-SUB,,0,0,0,,Дәлізде эротикалық романдарды дауыстап оқуды доғарыңыз.
Dialogue: 0,0:09:34.92,0:09:36.28,JP-SUB,,0,0,0,,Эротикалық емес
Dialogue: 0,0:09:36.74,0:09:38.90,JP-SUB,,0,0,0,,Бұл нәзіктік деп аталатын өнер.
Dialogue: 0,0:09:38.90,0:09:40.90,JP-SUB,,0,0,0,,Иә, сондай қатты дауыспен
Dialogue: 0,0:09:41.52,0:09:42.70,JP-SUB,,0,0,0,,Бұл үшін кешіріңіз.
Dialogue: 0,0:09:43.04,0:09:47.90,JP-SUB,,0,0,0,,Өнерге деген шексіз берілгендігімді баса алмадым.
Dialogue: 0,0:09:55.22,0:09:56.04,JP-SUB,,0,0,0,,Огами-кун
Dialogue: 0,0:09:57.10,0:09:59.54,JP-SUB,,0,0,0,,Сіз өлі аймақты көре аласыз.
Dialogue: 0,0:10:12.96,0:10:13.74,JP-SUB,,0,0,0,,Сакуракоджи мырза
Dialogue: 0,0:10:14.44,0:10:16.60,JP-SUB,,0,0,0,,Мен сөмкемді алу үшін сыныпқа кіргім келеді.
Dialogue: 0,0:10:17.14,0:10:18.82,JP-SUB,,0,0,0,,Әлі кірмеңіз.
Dialogue: 0,0:10:20.48,0:10:21.82,JP-SUB,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:22.88,0:10:24.64,JP-SUB,,0,0,0,,Джу маңызды нәрсені істеп жатыр
Dialogue: 0,0:10:25.26,0:10:26.24,JP-SUB,,0,0,0,,Тағы біраз күтіңіз
Dialogue: 0,0:10:27.06,0:10:28.24,JP-SUB,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:10:28.36,0:10:29.56,JP-SUB,,0,0,0,,Мен шынымен таң қалдым.
Dialogue: 0,0:10:29.82,0:10:31.24,JP-SUB,,0,0,0,,Белгілі болудан аулақ болу керек
Dialogue: 0,0:10:31.60,0:10:33.84,JP-SUB,,0,0,0,,Мен туралы, Сакуракоджи мырза
Dialogue: 0,0:10:34.76,0:10:35.94,JP-SUB,,0,0,0,,Оками сыртта
Dialogue: 0,0:10:36.46,0:10:38.98,JP-SUB,,0,0,0,,Барлығы
Dialogue: 0,0:10:41.96,0:10:43.28,JP-SUB,,0,0,0,,Күте тұрыңыз, Огами
Dialogue: 0,0:10:44.60,0:10:46.32,JP-SUB,,0,0,0,,Оками Оками
Dialogue: 0,0:10:46.32,0:10:47.46,JP-SUB,,0,0,0,,Нені жасыру керек
Dialogue: 0,0:10:51.54,0:10:55.62,JP-SUB,,0,0,0,,Огами-кун, 1Б сыныбына қош келдіңіз.
Dialogue: 0,0:11:04.42,0:11:06.70,JP-SUB,,0,0,0,,Қош келдіңіз кеші үшін кешіріңіз.
Dialogue: 0,0:11:06.82,0:11:08.74,JP-SUB,,0,0,0,,Сонымен қатар, үйірме жұмыстары аяқталғаннан кейін.
Dialogue: 0,0:11:08.74,0:11:10.06,JP-SUB,,0,0,0,,Уақыт осылай келді
Dialogue: 0,0:11:10.34,0:11:12.30,JP-SUB,,0,0,0,,Толық емес жұмыс әлі де жақсы, солай ма?
Dialogue: 0,0:11:12.46,0:11:14.74,JP-SUB,,0,0,0,,Саса Бұны киген құрметті қонақ.
Dialogue: 0,0:11:17.42,0:11:18.82,JP-SUB,,0,0,0,,Барлығымыз дайындалдық, бірақ
Dialogue: 0,0:11:18.92,0:11:21.44,JP-SUB,,0,0,0,,Бұл жылдам, сондықтан сүйкімді емес.
Dialogue: 0,0:11:22.24,0:11:24.22,JP-SUB,,0,0,0,,Қара, Оками, бұл сыйлық.
Dialogue: 0,0:11:26.82,0:11:28.60,JP-SUB,,0,0,0,,Менің атымды есте сақтаңыз.
Dialogue: 0,0:11:30.24,0:11:31.48,JP-SUB,,0,0,0,,Неліктен бұлай істедің?
Dialogue: 0,0:11:31.68,0:11:32.78,JP-SUB,,0,0,0,,Бұл шешілді
Dialogue: 0,0:11:33.04,0:11:35.56,JP-SUB,,0,0,0,,Бір жыл бойы бір сыныпта оқыдық.
Dialogue: 0,0:11:35.94,0:11:37.66,JP-SUB,,0,0,0,,Мұны істегенде көңілді болған дұрыс
Dialogue: 0,0:11:37.84,0:11:40.92,JP-SUB,,0,0,0,,Ал Огами-кун үнемі күлімдеп жүреді.
Dialogue: 0,0:11:41.12,0:11:44.04,JP-SUB,,0,0,0,,Шие гүлінен басқа нәрсе туралы айту қиын сияқты.
Dialogue: 0,0:11:44.16,0:11:46.32,JP-SUB,,0,0,0,,Менің ойымша, сіз өзіңізді күлуге мәжбүр еттіңіз.
Dialogue: 0,0:11:46.40,0:11:48.14,JP-SUB,,0,0,0,,Барлығы уайымдады.
Dialogue: 0,0:11:48.30,0:11:49.70,JP-SUB,,0,0,0,,Танысқаныма қуаныштымын, Огами-кун
Dialogue: 0,0:11:49.70,0:11:50.32,JP-SUB,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:11:50.32,0:11:51.02,JP-SUB,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:11:57.06,0:11:58.70,JP-SUB,,0,0,0,,Мен де бүгін таңертең білдім.
Dialogue: 0,0:11:59.44,0:12:00.54,JP-SUB,,0,0,0,,Дайын бол
Dialogue: 0,0:12:00.74,0:12:03.68,JP-SUB,,0,0,0,,Маған сені сыныпқа жақындатпауды өтінді.
Dialogue: 0,0:12:04.02,0:12:04.90,JP-SUB,,0,0,0,,Нитта Яги
Dialogue: 0,0:12:05.98,0:12:07.02,JP-SUB,,0,0,0,,Юса Ватанабе
Dialogue: 0,0:12:08.04,0:12:10.16,JP-SUB,,0,0,0,,Барлығы да көңіл бөледі.
Dialogue: 0,0:12:10.78,0:12:13.20,JP-SUB,,0,0,0,,Сәл жарасып қалсаң да жазаланбайсың.
Dialogue: 0,0:12:14.02,0:12:14.72,JP-SUB,,0,0,0,,Мұндағы Окаринді
Dialogue: 0,0:12:19.40,0:12:21.02,JP-SUB,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:12:21.70,0:12:23.62,JP-SUB,,0,0,0,,Барлығы сіз үшін осында
Dialogue: 0,0:12:25.82,0:12:27.24,JP-SUB,,0,0,0,,Мен заттарды жек көремін
Dialogue: 0,0:12:28.76,0:12:30.58,JP-SUB,,0,0,0,,Адамдар өлсе де заттар қалады
Dialogue: 0,0:12:32.06,0:12:34.44,JP-SUB,,0,0,0,,Сондықтан мен алдымен оны тазалағым келеді.
Dialogue: 0,0:12:36.24,0:12:37.00,JP-SUB,,0,0,0,,Такеши Аоки
Dialogue: 0,0:12:37.32,0:12:38.38,JP-SUB,,0,0,0,,Ойын орталығына барайық
Dialogue: 0,0:12:38.52,0:12:39.32,JP-SUB,,0,0,0,,Юкио Аояма
Dialogue: 0,0:12:39.70,0:12:40.54,JP-SUB,,0,0,0,,Менің хоббиім тауға өрмелеу
Dialogue: 0,0:12:40.84,0:12:41.76,JP-SUB,,0,0,0,,Акира Ижуин
Dialogue: 0,0:12:42.08,0:12:42.78,JP-SUB,,0,0,0,,Аққұба махаббат
Dialogue: 0,0:12:43.44,0:12:44.38,JP-SUB,,0,0,0,,Мое Уэсуги
Dialogue: 0,0:12:44.68,0:12:45.98,JP-SUB,,0,0,0,,Маған ағылшын тілін үйретіңізші
Dialogue: 0,0:12:47.60,0:12:49.64,JP-SUB,,0,0,0,,Тізімдегі барлық мәліметтерді жаттап алдым.
Dialogue: 0,0:12:50.86,0:12:53.16,JP-SUB,,0,0,0,,Сол жігіттер ұмытып қалсаң табанды сияқты.
Dialogue: 0,0:12:54.00,0:12:54.76,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:12:55.50,0:12:56.54,JP-SUB,,0,0,0,,Мен ұмытпаймын
Dialogue: 0,0:12:57.58,0:12:58.38,JP-SUB,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,0:13:00.22,0:13:03.44,JP-SUB,,0,0,0,,Оками, сен жалғыз емессің.
Dialogue: 0,0:13:04.54,0:13:06.44,JP-SUB,,0,0,0,,Жоқ деген ұғым жоқ.
Dialogue: 0,0:13:07.30,0:13:07.86,JP-SUB,,0,0,0,,Бірақ
Dialogue: 0,0:13:08.90,0:13:10.40,JP-SUB,,0,0,0,,Маған әзірге достар керек емес.
Dialogue: 0,0:13:11.76,0:13:14.94,JP-SUB,,0,0,0,,Сіз шыншыл емессіз.
Dialogue: 0,0:13:25.88,0:13:26.86,JP-SUB,,0,0,0,,Уау
Dialogue: 0,0:13:28.44,0:13:29.70,JP-SUB,,0,0,0,,Уау
Dialogue: 0,0:13:40.00,0:13:42.32,JP-SUB,,0,0,0,,Мен мұның бұлай тез болатынын ешқашан күтпеген едім.
Dialogue: 0,0:13:42.46,0:13:43.16,JP-SUB,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:13:56.86,0:14:01.86,JP-SUB,,0,0,0,,Агент Кавамура нысанды тапқанын хабарлаған соң, онымен байланыс үзілді.
Dialogue: 0,0:14:03.56,0:14:07.54,JP-SUB,,0,0,0,,Бұл жоғалған агенттер санын 43-ке жеткізеді.
Dialogue: 0,0:14:08.00,0:14:10.28,JP-SUB,,0,0,0,,Бұрынғы кодты бұзушы Хитоми
Dialogue: 0,0:14:10.94,0:14:11.98,JP-SUB,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:14:13.70,0:14:16.56,JP-SUB,,0,0,0,,01 кодынан күткендей.
Dialogue: 0,0:14:17.20,0:14:20.52,JP-SUB,,0,0,0,,Енді келесі шабуылды қалай жасаймыз?
Dialogue: 0,0:14:25.40,0:14:27.66,JP-SUB,,0,0,0,,Эй, қайырлы таң Юкихина
Dialogue: 0,0:14:33.50,0:14:35.22,JP-SUB,,0,0,0,,Көп адам жиналды.
Dialogue: 0,0:14:37.12,0:14:38.64,JP-SUB,,0,0,0,,Ол не үшін қолданылады?
Dialogue: 0,0:14:51.40,0:14:53.70,JP-SUB,,0,0,0,,Жаңа әлемді бастау
Dialogue: 0,0:15:01.90,0:15:04.30,JP-SUB,,0,0,0,,Огами-кун, бақытты болдың ба?
Dialogue: 0,0:15:04.94,0:15:07.48,JP-SUB,,0,0,0,,Сіз оның мимикасын шынымен көре алмайсыз.
Dialogue: 0,0:15:07.84,0:15:08.82,JP-SUB,,0,0,0,,Дұрыс па?
Dialogue: 0,0:15:09.46,0:15:12.36,JP-SUB,,0,0,0,,Қызық, Сакура жақсы жүр ме?
Dialogue: 0,0:15:13.26,0:15:15.38,JP-SUB,,0,0,0,,Мен сені жалғыз қалдыру үшін қиындық көрдім.
Dialogue: 0,0:15:15.74,0:15:17.78,JP-SUB,,0,0,0,,Жақсылық жасамасаң көңілім қалады.
Dialogue: 0,0:15:18.90,0:15:21.52,JP-SUB,,0,0,0,,Түсінемін, екеуміз де шатырдамыз.
Dialogue: 0,0:15:22.22,0:15:23.88,JP-SUB,,0,0,0,,Мүмкін қазір...
Dialogue: 0,0:15:24.24,0:15:25.18,JP-SUB,,0,0,0,,Қазір...
Dialogue: 0,0:15:27.78,0:15:29.40,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:15:29.56,0:15:35.54,JP-SUB,,0,0,0,,Сакуракоджи-санды қуантпасам, бұл жетпейді.
Dialogue: 0,0:15:37.18,0:15:40.12,JP-SUB,,0,0,0,,Оками барлығының атын есте сақтайды.
Dialogue: 0,0:15:40.30,0:15:41.44,JP-SUB,,0,0,0,,Мәселе шешілді.
Dialogue: 0,0:15:41.96,0:15:43.58,JP-SUB,,0,0,0,,Мен жинап келейін. Иә.
Dialogue: 0,0:15:45.30,0:15:46.50,JP-SUB,,0,0,0,,Кішкене ғана
Dialogue: 0,0:15:46.66,0:15:48.40,JP-SUB,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:48.72,0:15:50.66,JP-SUB,,0,0,0,,Жоқ, кіріңіз.
Dialogue: 0,0:16:00.02,0:16:01.36,JP-SUB,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:16:05.44,0:16:07.50,JP-SUB,,0,0,0,,Бұл балалар күткендей
Dialogue: 0,0:16:14.58,0:16:16.36,JP-SUB,,0,0,0,,Күте тұрыңыз, Оками, жоқ.
Dialogue: 0,0:16:16.36,0:16:16.82,JP-SUB,,0,0,0,,Иә…♡
Dialogue: 0,0:16:17.24,0:16:18.68,JP-SUB,,0,0,0,,Бұл жігіттер өліп қалды.
Dialogue: 0,0:16:19.18,0:16:19.94,JP-SUB,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:16:24.10,0:16:25.74,JP-SUB,,0,0,0,,Мәйітті жаңа ғана манипуляциялауда.
Dialogue: 0,0:16:28.82,0:16:30.46,JP-SUB,,0,0,0,,Мұны не істеуге болады?
Dialogue: 0,0:16:34.74,0:16:35.54,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:16:37.90,0:16:41.32,JP-SUB,,0,0,0,,Өйткені, бұл дұрыс әрекет болды.
Dialogue: 0,0:16:42.14,0:16:44.14,JP-SUB,,0,0,0,,Не болды, Оками?
Dialogue: 0,0:16:46.22,0:16:47.54,JP-SUB,,0,0,0,,Осындай кездерде
Dialogue: 0,0:17:08.02,0:17:08.88,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:17:10.24,0:17:10.98,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:17:20.78,0:17:22.56,JP-SUB,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:17:25.38,0:17:26.80,JP-SUB,,0,0,0,,Ками Канда Сенсей
Dialogue: 0,0:17:32.20,0:17:34.22,JP-SUB,,0,0,0,,Бұл Хитомидің күші
Dialogue: 0,0:17:34.54,0:17:36.30,JP-SUB,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:17:36.60,0:17:37.40,JP-SUB,,0,0,0,,Бұл туралы кейінірек
Dialogue: 0,0:17:37.88,0:17:38.84,JP-SUB,,0,0,0,,Мен қашып кетемін.
Dialogue: 0,0:17:41.50,0:17:43.34,JP-SUB,,0,0,0,,Мектеп ғимаратына бармаңыз
Dialogue: 0,0:17:47.92,0:17:50.42,JP-SUB,,0,0,0,,Әркімнің сізді сынауына жол бермеңіз.
Dialogue: 0,0:17:52.52,0:17:53.18,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:17:53.78,0:17:56.26,JP-SUB,,0,0,0,,Канда Сакуракоджи-санды қорға
Dialogue: 0,0:17:56.50,0:17:57.20,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:17:57.48,0:17:58.18,JP-SUB,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:18:12.88,0:18:15.92,JP-SUB,,0,0,0,,Кімде-кім бұл жалыннан өтсе, мен оларды өртеймін.
Dialogue: 0,0:18:21.74,0:18:22.94,JP-SUB,,0,0,0,,Көзге көз
Dialogue: 0,0:18:26.86,0:18:28.02,JP-SUB,,0,0,0,,Тіске арналған тіс
Dialogue: 0,0:18:29.84,0:18:31.38,JP-SUB,,0,0,0,,Жамандыққа зұлымдық
Dialogue: 0,0:18:35.06,0:18:35.86,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:18:47.02,0:18:47.80,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:18:48.54,0:18:52.72,JP-SUB,,0,0,0,,Сіз мұны бәрінен де маңызды деп ойламайсыз ба?
Dialogue: 0,0:18:53.20,0:18:54.18,JP-SUB,,0,0,0,,Барлығы туралы
Dialogue: 0,0:19:18.30,0:19:18.96,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:19:19.28,0:19:19.78,JP-SUB,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:19:20.14,0:19:21.46,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:19:26.46,0:19:28.12,JP-SUB,,0,0,0,,№ 6
Dialogue: 0,0:19:28.78,0:19:31.66,JP-SUB,,0,0,0,,Мен көмектесуге келдім.
Dialogue: 0,0:19:46.40,0:19:48.08,JP-SUB,,0,0,0,,Ю...ки
Dialogue: 0,0:19:48.48,0:19:50.28,JP-SUB,,0,0,0,,Бұл кім?
Dialogue: 0,0:19:51.22,0:19:53.08,JP-SUB,,0,0,0,,Осы дәрежеде бұрышта болу
Dialogue: 0,0:19:53.30,0:19:56.18,JP-SUB,,0,0,0,,Сіз ұпай шегеретін боласыз, Огами-кун.
Dialogue: 0,0:19:56.54,0:19:57.58,JP-SUB,,0,0,0,,Хайке Сенпай
Dialogue: 0,0:19:58.08,0:19:59.22,JP-SUB,,0,0,0,,Және Юки-кун
Dialogue: 0,0:19:59.96,0:20:01.72,JP-SUB,,0,0,0,,Уақытында келді деп үміттенемін.
Dialogue: 0,0:20:02.64,0:20:04.72,JP-SUB,,0,0,0,,Сіз жалқау жұмысшысыз.
Dialogue: 0,0:20:04.72,0:20:05.24,JP-SUB,,0,0,0,,Не?
Dialogue: 0,0:20:10.62,0:20:11.98,JP-SUB,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:20:12.46,0:20:14.54,JP-SUB,,0,0,0,,Қазірдің өзінде өлі аймақта
Dialogue: 0,0:20:21.48,0:20:22.64,JP-SUB,,0,0,0,,Көзге көз
Dialogue: 0,0:20:23.10,0:20:24.12,JP-SUB,,0,0,0,,Тіске арналған тіс
Dialogue: 0,0:20:24.26,0:20:28.02,JP-SUB,,0,0,0,,Өлгендерге мәңгілік ұйқы
Dialogue: 0,0:20:35.98,0:20:38.28,JP-SUB,,0,0,0,,Жарықтың күші ғажап
Dialogue: 0,0:20:38.94,0:20:42.40,JP-SUB,,0,0,0,,Хайке-сенпай да кодты бұзушы ма?
Dialogue: 0,0:20:44.66,0:20:45.62,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:21:00.02,0:21:00.80,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:21:01.70,0:21:02.52,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:21:02.72,0:21:03.98,JP-SUB,,0,0,0,,Огами, мықты бол.
Dialogue: 0,0:21:04.68,0:21:05.42,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:21:11.16,0:21:11.92,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:21:12.90,0:21:15.20,JP-SUB,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:21:17.24,0:21:19.18,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:21:19.56,0:21:20.52,JP-SUB,,0,0,0,,Жоғалған
Dialogue: 0,0:21:24.26,0:21:25.12,JP-SUB,,0,0,0,,Жоғалған
Dialogue: 0,0:21:25.64,0:21:26.08,JP-SUB,,0,0,0,,Иә
Dialogue: 0,0:21:27.04,0:21:29.24,JP-SUB,,0,0,0,,Біздің кодты бұзушылардың тағдыры
Dialogue: 0,0:21:30.24,0:21:32.10,JP-SUB,,0,0,0,,Сөзсіз
Dialogue: 0,0:21:33.40,0:21:34.14,JP-SUB,,0,0,0,,Бос уақытқа таяп қалды—
Dialogue: 0,0:21:56.12,0:21:58.56,ED JP-B,,0,0,0,,Сен де бір күні түсінерсің
Dialogue: 0,0:21:58.56,0:22:00.97,ED JP-B,,0,0,0,,Ақ қарға қайда барады
Dialogue: 0,0:22:00.97,0:22:03.65,ED JP-B,,0,0,0,,Ешкімді танымай ұшамыз
Dialogue: 0,0:22:03.65,0:22:06.29,ED JP-B,,0,0,0,,Гүлденген қала
Dialogue: 0,0:22:17.07,0:22:21.20,ED JP-G,,0,0,0,,Тек өмір сүруге себеп іздеу
Dialogue: 0,0:22:21.20,0:22:23.41,ED JP-G,,0,0,0,,Менің бос өзім
Dialogue: 0,0:22:23.41,0:22:26.39,ED JP-G,,0,0,0,,Өйткені бұл ұят
Dialogue: 0,0:22:26.67,0:22:31.51,ED JP-G,,0,0,0,,Біз әлем белгілеген ережелерді ұстанамыз
Dialogue: 0,0:22:31.51,0:22:36.19,ED JP-G,,0,0,0,,Жай ғана беріліңіз және күліңіз.
Dialogue: 0,0:22:37.20,0:22:41.65,ED JP-B,,0,0,0,,Жалаңаш болып, ішкі түйсігіңмен жүр
Dialogue: 0,0:22:41.83,0:22:45.88,ED JP-B,,0,0,0,,Көзімнен қашқан шындық
Dialogue: 0,0:22:45.93,0:22:48.34,ED JP-B,,0,0,0,,Ешкім үшін емес
Dialogue: 0,0:22:48.34,0:22:50.45,ED JP-B,,0,0,0,,Шешім қабылдау
Dialogue: 0,0:22:50.45,0:22:55.32,ED JP-B,,0,0,0,,Қара киімдеріңді тастап, тұрыңдар.
Dialogue: 0,0:22:55.57,0:22:57.81,ED JP-B,,0,0,0,,Таза тілек
Dialogue: 0,0:22:57.81,0:23:01.84,ED JP-B,,0,0,0,,Қанаттарымыз енді жоғалды
Dialogue: 0,0:23:01.84,0:23:04.77,ED JP-B,,0,0,0,,Оны сілкіп таста да, қанатыңды ат
Dialogue: 0,0:23:04.77,0:23:07.13,ED JP-B,,0,0,0,,Қорықпа
Dialogue: 0,0:23:07.25,0:23:12.60,ED JP-B,,0,0,0,,Жауап қараңғылықтан тыс болса
Dialogue: 0,0:23:25.64,0:23:28.22,JP-SUB,,0,0,0,,Ешкім болмас тағдыр болса да
Dialogue: 0,0:23:28.78,0:23:30.22,JP-SUB,,0,0,0,,Қабылданбайды
Dialogue: 0,0:23:31.12,0:23:33.22,JP-SUB,,0,0,0,,Келесі код: Breaker 7-эпизод
Dialogue: 0,0:23:33.50,0:23:35.02,JP-SUB,,0,0,0,,Жарықта шие гүлдейді
Dialogue: 0,0:23:36.02,0:23:36.72,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:23:37.48,0:23:38.20,JP-SUB,,0,0,0,,Оками
Dialogue: 0,0:23:39.70,0:23:45.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory