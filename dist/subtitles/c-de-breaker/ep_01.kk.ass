Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:59.95,0:03:09.96,STAFF,,0000,0000,0000,,---Сөздік субтитрлері--- Жапон: KING & Ayu Аудармасы: JOAH Жапон мектебі: Эйю мектебі: Ариаке но Цуки Уақыты: Xiaoyong Жүйесі: Naxia
Dialogue: 0,0:02:59.95,0:03:09.96,STAFF,,0000,0000,0000,,Бұл субтитр субтитрлер мен алмасулардың тіркесімі болып табылады.
Dialogue: 0,0:00:13.24,0:00:15.23,JP-SUB,,0000,0000,0000,,Мен саған бүгін тамақ бере алмаймын.
Dialogue: 0,0:00:39.76,0:00:40.51,JP-SUB,,0000,0000,0000,,Тоқта.
Dialogue: 0,0:00:41.68,0:00:44.83,JP-SUB,,0000,0000,0000,,Келесі аялдама дәл бұрышта. Отырыңыз және күтіңіз.
Dialogue: 0,0:00:44.83,0:00:47.84,JP-SUB,,0000,0000,0000,,Біреуді өртеп жіберді. 110 нөміріне қоңырау шалыңыз. Асығыңыз.
Dialogue: 0,0:00:52.01,0:00:53.90,JP-SUB,,0000,0000,0000,,Офицер, адам
Dialogue: 0,0:01:06.11,0:01:08.57,JP-SUB,,0000,0000,0000,,Адамдарды өртеп жіберді дедің.
Dialogue: 0,0:01:09.16,0:01:13.12,JP-SUB,,0000,0000,0000,,Оны кәдімгі жалынмен ешқандай сынықтарсыз өртеу мүмкін емес.
Dialogue: 0,0:01:13.74,0:01:14.91,JP-SUB,,0000,0000,0000,,Сіз мұны армандаған жоқсыз ба?
Dialogue: 0,0:01:15.80,0:01:20.08,JP-SUB,,0000,0000,0000,,Бұл, әрине, мен
Dialogue: 0,0:01:21.19,0:01:25.15,JP-SUB,,0000,0000,0000,,Бұл өртенген қалдықтар – үйсіз адам тұтанған оттың қалдықтары.
Dialogue: 0,0:01:26.09,0:01:26.91,JP-SUB,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:03:13.61,0:03:14.83,JP-SUB,,0000,0000,0000,,Эй, мен оны көрмеймін.
Dialogue: 0,0:03:14.83,0:03:15.95,JP-SUB,,0000,0000,0000,,Жолдан шығыңыз
Dialogue: 0,0:03:19.67,0:03:20.84,JP-SUB,,0000,0000,0000,,Бір бөтелке сол жерде
Dialogue: 0,0:03:23.38,0:03:24.79,JP-SUB,,0000,0000,0000,,Дұрыс, орамалыңды да ал.
Dialogue: 0,0:03:24.79,0:03:25.64,JP-SUB,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:03:26.14,0:03:27.10,JP-SUB,,0000,0000,0000,,Келесі Сато
Dialogue: 0,0:03:27.45,0:03:28.94,JP-SUB,,0000,0000,0000,,Иә, өтінемін
Dialogue: 0,0:03:29.24,0:03:30.14,JP-SUB,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:03:34.21,0:03:38.51,JP-SUB,,0000,0000,0000,,Кеше түнде не болды?
Dialogue: 0,0:03:39.61,0:03:40.87,JP-SUB,,0000,0000,0000,,Кеуде
Dialogue: 0,0:03:42.99,0:03:44.38,JP-SUB,,0000,0000,0000,,Бір бөтелке сол жерде
Dialogue: 0,0:03:45.89,0:03:46.69,JP-SUB,,0000,0000,0000,,Тамаша жұмыс
Dialogue: 0,0:03:47.16,0:03:48.70,JP-SUB,,0000,0000,0000,,Сакуракоджи Кешіріңіз.
Dialogue: 0,0:03:49.15,0:03:51.19,JP-SUB,,0000,0000,0000,,Әлсіз және кішкентай клубтан сізге еріп жүруін сұраңыз
Dialogue: 0,0:03:51.64,0:03:55.91,JP-SUB,,0000,0000,0000,,Жоқ, клуб мүшелерінің дайындығы керемет.
Dialogue: 0,0:03:57.38,0:03:59.69,JP-SUB,,0000,0000,0000,,Сакуракоджи-сан, сен кереметсің.
Dialogue: 0,0:03:59.84,0:04:01.69,JP-SUB,,0000,0000,0000,,Маған әдеттегідей таза атмосфера ұнайды.
Dialogue: 0,0:04:01.93,0:04:04.78,JP-SUB,,0000,0000,0000,,Айкидомен айналысып жатқанын көру керемет.
Dialogue: 0,0:04:05.08,0:04:07.42,JP-SUB,,0000,0000,0000,,Сонымен қатар, менің бағаларым әрқашан жоғарыда.
Dialogue: 0,0:04:07.69,0:04:09.70,JP-SUB,,0000,0000,0000,,Сакуракоджи-санмен шықсам
Dialogue: 0,0:04:09.80,0:04:11.92,JP-SUB,,0000,0000,0000,,Дүниені өзіңе дұшпан қылсаң жақсы.
Dialogue: 0,0:04:12.96,0:04:17.06,JP-SUB,,0000,0000,0000,,Яхо, қайырлы таң, шие гүлі
Dialogue: 0,0:04:19.37,0:04:21.06,JP-SUB,,0000,0000,0000,,Қайырлы таң, Аоба
Dialogue: 0,0:04:22.41,0:04:25.39,JP-SUB,,0000,0000,0000,,Не болды, Сакура, сен ондай емессің?
Dialogue: 0,0:04:26.28,0:04:30.31,JP-SUB,,0000,0000,0000,,Иә, жоқ, ерекше мәселе жоқ.
Dialogue: 0,0:04:33.02,0:04:34.36,JP-SUB,,0000,0000,0000,,Бұл жақсы болар еді.
Dialogue: 0,0:04:34.96,0:04:37.19,JP-SUB,,0000,0000,0000,,Ах, профессор Канда, қайырлы таң.
Dialogue: 0,0:04:38.06,0:04:40.65,JP-SUB,,0000,0000,0000,,Қайырлы таң, Такацу мырза мен Сакуракоджи мырза.
Dialogue: 0,0:04:41.22,0:04:42.41,JP-SUB,,0000,0000,0000,,Яғни, бұл
Dialogue: 0,0:04:42.71,0:04:47.06,JP-SUB,,0000,0000,0000,,Аа, мен бүгіннен бастап бір сыныпта оқитын ауыспалы студентпін. Сенің атың кім?
Dialogue: 0,0:04:50.94,0:04:53.99,JP-SUB,,0000,0000,0000,,Мен Рей Огамимін. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:04:54.64,0:04:57.75,JP-SUB,,0000,0000,0000,,Сәл салқын емес, Огами-кун.
Dialogue: 0,0:04:58.00,0:05:01.58,JP-SUB,,0000,0000,0000,,Салқын, сәл жұмбақ атмосфера, биік нүктелер
Dialogue: 0,0:05:01.67,0:05:03.12,JP-SUB,,0000,0000,0000,,Иә, иә, тыныш
Dialogue: 0,0:05:03.51,0:05:04.51,JP-SUB,,0000,0000,0000,,Огами-кун
Dialogue: 0,0:05:04.81,0:05:09.16,JP-SUB,,0000,0000,0000,,Ата-анамның жұмысына байланысты жаңа мектепке өзім ауысуға тура келді.
Dialogue: 0,0:05:09.55,0:05:11.59,JP-SUB,,0000,0000,0000,,Бәріміз жақсы араласайық.
Dialogue: 0,0:05:12.24,0:05:14.28,JP-SUB,,0000,0000,0000,,Бұл сөзсіз ол.
Dialogue: 0,0:05:14.97,0:05:17.13,JP-SUB,,0000,0000,0000,,Бұл кеше түнгі жігіт.
Dialogue: 0,0:05:22.23,0:05:25.39,JP-SUB,,0000,0000,0000,,Сіз шетелдесіз бе? Ағылшын тілі еркін.
Dialogue: 0,0:05:25.51,0:05:26.78,JP-SUB,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:05:27.03,0:05:28.12,JP-SUB,,0000,0000,0000,,Сіз қай елге бардыңыз?
Dialogue: 0,0:05:28.47,0:05:30.90,JP-SUB,,0000,0000,0000,,Соңғы жылдары Еуропада адамдар көп болды.
Dialogue: 0,0:05:33.29,0:05:37.07,JP-SUB,,0000,0000,0000,,Не, Сакура Огами-кунға қызық.
Dialogue: 0,0:05:37.59,0:05:38.73,JP-SUB,,0000,0000,0000,,Бұл олай емес
Dialogue: 0,0:05:43.70,0:05:44.32,JP-SUB,,0000,0000,0000,,Оками
Dialogue: 0,0:05:47.16,0:05:48.95,JP-SUB,,0000,0000,0000,,Бұл не, Сакураджи-сан?
Dialogue: 0,0:05:49.79,0:05:52.48,JP-SUB,,0000,0000,0000,,Мен жалғыз сөйлескім келеді. Біраз отырайық.
Dialogue: 0,0:05:53.40,0:05:54.09,JP-SUB,,0000,0000,0000,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:05:54.54,0:05:56.45,JP-SUB,,0000,0000,0000,,Иә
Dialogue: 0,0:05:56.85,0:06:01.03,JP-SUB,,0000,0000,0000,,Бұл қиын. Сакуракожи мырза ауысқан студентті мойындады
Dialogue: 0,0:06:01.03,0:06:01.67,JP-SUB,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:02.10,0:06:03.29,JP-SUB,,0000,0000,0000,,Бұл өтірік
Dialogue: 0,0:06:03.79,0:06:04.36,JP-SUB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:06:04.36,0:06:06.05,JP-SUB,,0000,0000,0000,,Менің жүрегімнің келіні
Dialogue: 0,0:06:06.27,0:06:08.43,JP-SUB,,0000,0000,0000,,Сакура сондай батыл
Dialogue: 0,0:06:08.43,0:06:11.49,JP-SUB,,0000,0000,0000,,Бірақ бұл екеуі тамаша жұп емес.
Dialogue: 0,0:06:12.11,0:06:13.53,JP-SUB,,0000,0000,0000,,Жер бетінде ол қандай?
Dialogue: 0,0:06:13.53,0:06:14.87,JP-SUB,,0000,0000,0000,,Тікелей сұрау
Dialogue: 0,0:06:15.54,0:06:17.48,JP-SUB,,0000,0000,0000,,Кеше түнде қайда және не істедің?
Dialogue: 0,0:06:19.24,0:06:20.21,JP-SUB,,0000,0000,0000,,Менің толық емес жұмыс күнім бар.
Dialogue: 0,0:06:20.56,0:06:21.33,JP-SUB,,0000,0000,0000,,Егер бұл толық емес жұмыс күні болса
Dialogue: 0,0:06:21.90,0:06:26.05,JP-SUB,,0000,0000,0000,,Сұраймын, кеше түнде сол қолғаптар саябақта бір адамды өлтірді.
Dialogue: 0,0:06:26.38,0:06:29.24,JP-SUB,,0000,0000,0000,,Отты қойғанда алған күйіктерін жасырып тұрған жоқ па?
Dialogue: 0,0:06:29.73,0:06:32.02,JP-SUB,,0000,0000,0000,,Не? Мен оны ести алмаймын.
Dialogue: 0,0:06:32.27,0:06:35.08,JP-SUB,,0000,0000,0000,,Не болды? Егер олай болмаса, қолғап киіңіз.
Dialogue: 0,0:06:38.16,0:06:39.45,JP-SUB,,0000,0000,0000,,Күйік жоқ
Dialogue: 0,0:06:40.45,0:06:42.26,JP-SUB,,0000,0000,0000,,Бұл бойтұмар.
Dialogue: 0,0:06:42.93,0:06:46.46,JP-SUB,,0000,0000,0000,,Бала кезімде қолыммен біреуді ренжіткенмін.
Dialogue: 0,0:06:47.53,0:06:49.91,JP-SUB,,0000,0000,0000,,Бұның қайталануына жол берме.
Dialogue: 0,0:06:50.29,0:06:51.53,JP-SUB,,0000,0000,0000,,Оны маған біреу берді.
Dialogue: 0,0:06:52.92,0:06:53.94,JP-SUB,,0000,0000,0000,,Барлығы осы ма?
Dialogue: 0,0:06:54.64,0:06:55.85,JP-SUB,,0000,0000,0000,,Иә, бәрі осы.
Dialogue: 0,0:06:56.13,0:06:57.37,JP-SUB,,0000,0000,0000,,Бірақ кеше
Dialogue: 0,0:06:57.67,0:06:58.24,JP-SUB,,0000,0000,0000,,Басқалар
Dialogue: 0,0:07:00.08,0:07:02.74,JP-SUB,,0000,0000,0000,,Аа, көп уақыт алғаным үшін кешіріңіз.
Dialogue: 0,0:07:03.14,0:07:04.74,JP-SUB,,0000,0000,0000,,Жоқ, жақсы.
Dialogue: 0,0:07:05.60,0:07:10.67,JP-SUB,,0000,0000,0000,,Сакуракоджи мырза, бұдан былай сыныптастар ретінде араласайық.
Dialogue: 0,0:07:12.21,0:07:15.09,JP-SUB,,0000,0000,0000,,Сәлем Сакура, не болды?
Dialogue: 0,0:07:16.04,0:07:19.14,JP-SUB,,0000,0000,0000,,Хмм, бұл күтпеген оқиға болды.
Dialogue: 0,0:07:21.03,0:07:27.42,JP-SUB,,0000,0000,0000,,Иә, иә, мені тастап кеткен шығар.
Dialogue: 0,0:07:28.56,0:07:32.04,JP-SUB,,0000,0000,0000,,Сакуракоджи мырзаны тастап кетуіңіз мүмкін емес.
Dialogue: 0,0:07:32.14,0:07:34.04,JP-SUB,,0000,0000,0000,,Сіздің ниетіңіз қандай, Огами Нөл?
Dialogue: 0,0:07:34.04,0:07:36.59,JP-SUB,,0000,0000,0000,,Сакура-санды қайғырып жатырсың ба? Бұл мүмкін емес.
Dialogue: 0,0:07:36.59,0:07:39.57,JP-SUB,,0000,0000,0000,,Оками, сен әлемді жау қылдың.
Dialogue: 0,0:07:43.23,0:07:49.09,JP-SUB,,0000,0000,0000,,Мен ашуланамын, бірақ мен берілмеймін.
Dialogue: 0,0:07:50.73,0:07:54.01,JP-SUB,,0000,0000,0000,,Сакура: Мен бірінші рет еркекпен сонша араласып тұрған жоқпын.
Dialogue: 0,0:07:54.68,0:07:57.84,JP-SUB,,0000,0000,0000,,Міндетті түрде айдаһардың құйрығын басып, оны ұстаңыз.
Dialogue: 0,0:07:59.83,0:08:03.28,JP-SUB,,0000,0000,0000,,Десе де, әдеттегідей, жейтін тағамның мөлшері сізді таң қалдырады.
Dialogue: 0,0:08:12.08,0:08:14.49,JP-SUB,,0000,0000,0000,,Огами-кун керемет
Dialogue: 0,0:08:46.65,0:08:48.79,JP-SUB,,0000,0000,0000,,Сен шын берілгенсің, солай емес пе, Сакура?
Dialogue: 0,0:08:49.36,0:08:52.82,JP-SUB,,0000,0000,0000,,А, мен одан көзімді ала алмаймын.
Dialogue: 0,0:08:54.24,0:08:55.78,JP-SUB,,0000,0000,0000,,Иә, иә, Огами-кун мейірімді көрінеді.
Dialogue: 0,0:08:56.45,0:08:58.68,JP-SUB,,0000,0000,0000,,Сізге шие гүлдері ұнайтыны таңқаларлық емес.
Dialogue: 0,0:08:58.83,0:09:00.15,JP-SUB,,0000,0000,0000,,түрі
Dialogue: 0,0:09:08.05,0:09:08.92,JP-SUB,,0000,0000,0000,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:09:20.08,0:09:23.34,JP-SUB,,0000,0000,0000,,Кінәлі оқиға орнына қайта оралды.
Dialogue: 0,0:09:25.97,0:09:27.12,JP-SUB,,0000,0000,0000,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:09:29.28,0:09:30.50,JP-SUB,,0000,0000,0000,,Күте алсаңыз
Dialogue: 0,0:09:34.28,0:09:36.29,JP-SUB,,0000,0000,0000,,Адам шынымен күйіп қалды ма?
Dialogue: 0,0:09:37.58,0:09:39.82,JP-SUB,,0000,0000,0000,,Бұл иллюзия болды ма?
Dialogue: 0,0:09:46.13,0:09:47.40,JP-SUB,,0000,0000,0000,,Жеп алайық.
Dialogue: 0,0:09:48.09,0:09:50.16,JP-SUB,,0000,0000,0000,,Кешіріңіз, мен оны кеше алып келмегенмін.
Dialogue: 0,0:09:56.89,0:09:59.83,JP-SUB,,0000,0000,0000,,Қартты тамақтандырып жатқанда,
Dialogue: 0,0:10:02.01,0:10:04.57,JP-SUB,,0000,0000,0000,,Сіз жақсы араласамын деп ойламайсыз ба?
Dialogue: 0,0:10:06.19,0:10:06.88,JP-SUB,,0000,0000,0000,,Оками
Dialogue: 0,0:10:07.36,0:10:11.63,JP-SUB,,0000,0000,0000,,Өйткені, бұл сіздің әркіммен қалай сөйлесетініңізге байланысты.
Dialogue: 0,0:10:12.65,0:10:16.28,JP-SUB,,0000,0000,0000,,Жоқ, мен оны жауынгер сияқты қатып сөйледі деп ойладым.
Dialogue: 0,0:10:16.85,0:10:19.09,JP-SUB,,0000,0000,0000,,Не, оның суреттен айырмашылығы бар ма?
Dialogue: 0,0:10:19.76,0:10:23.31,JP-SUB,,0000,0000,0000,,Жоқ, бұл мақтанарлық емес еді. Мен бұл керемет деп ойладым.
Dialogue: 0,0:10:24.98,0:10:26.52,JP-SUB,,0000,0000,0000,,Салқын және т.б.
Dialogue: 0,0:10:27.29,0:10:30.07,JP-SUB,,0000,0000,0000,,Біздің үй сәл басқаша.
Dialogue: 0,0:10:34.42,0:10:36.49,JP-SUB,,0000,0000,0000,,Ит адамдармен онша таныс емес.
Dialogue: 0,0:10:36.49,0:10:37.13,JP-SUB,,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:10:43.67,0:10:44.36,JP-SUB,,0000,0000,0000,,Маған сен!
Dialogue: 0,0:10:45.16,0:10:47.79,JP-SUB,,0000,0000,0000,,Адамдар бұған сенбеді.
Dialogue: 0,0:10:49.31,0:10:51.03,JP-SUB,,0000,0000,0000,,Өтінемін, мені бұлай жалай берме
Dialogue: 0,0:10:53.81,0:10:55.40,JP-SUB,,0000,0000,0000,,Огами-кун мейірімді көрінеді.
Dialogue: 0,0:10:55.62,0:10:57.91,JP-SUB,,0000,0000,0000,,Сыныптас болып тату болайық
Dialogue: 0,0:10:58.95,0:11:00.67,JP-SUB,,0000,0000,0000,,Мұнда
Dialogue: 0,0:11:01.74,0:11:03.78,JP-SUB,,0000,0000,0000,,Ол жаман адам емес пе?
Dialogue: 0,0:11:04.87,0:11:08.57,JP-SUB,,0000,0000,0000,,Сакуракоджи мырза, бұл иттің аты кім?
Dialogue: 0,0:11:09.09,0:11:09.62,JP-SUB,,0000,0000,0000,,Ит
Dialogue: 0,0:11:11.68,0:11:13.22,JP-SUB,,0000,0000,0000,,Бұл жақсы есім.
Dialogue: 0,0:11:17.02,0:11:17.92,JP-SUB,,0000,0000,0000,,Бұл қаңғыбас ит пе?
Dialogue: 0,0:11:20.05,0:11:23.09,JP-SUB,,0000,0000,0000,,Жоқ, иесі, қаңғыбас қария,
Dialogue: 0,0:11:24.13,0:11:25.40,JP-SUB,,0000,0000,0000,,Ол өлтірілді.
Dialogue: 0,0:11:26.59,0:11:28.48,JP-SUB,,0000,0000,0000,,Кінәлі – G-Falcon деп аталатын топ.
Dialogue: 0,0:11:29.72,0:11:31.81,JP-SUB,,0000,0000,0000,,Өйткені оның денесінде сұңқар татуировкасы бар.
Dialogue: 0,0:11:32.01,0:11:33.38,JP-SUB,,0000,0000,0000,,Өзін солай атаса керек.
Dialogue: 0,0:11:34.54,0:11:36.21,JP-SUB,,0000,0000,0000,,Олар қылмыс жасаса да
Dialogue: 0,0:11:36.71,0:11:39.22,JP-SUB,,0000,0000,0000,,Соның бәрін басты ұйымдасқан қылмыстық топ жабады.
Dialogue: 0,0:11:39.91,0:11:41.45,JP-SUB,,0000,0000,0000,,Әкем осылай деді.
Dialogue: 0,0:11:42.47,0:11:43.27,JP-SUB,,0000,0000,0000,,Әке
Dialogue: 0,0:11:44.51,0:11:46.60,JP-SUB,,0000,0000,0000,,Ешкім соттай алмайды
Dialogue: 0,0:11:47.99,0:11:50.08,JP-SUB,,0000,0000,0000,,Тіпті полицейлер де көз жұмады
Dialogue: 0,0:11:51.22,0:11:53.83,JP-SUB,,0000,0000,0000,,Қылмыскерлерден кек алғың келе ме?
Dialogue: 0,0:11:55.40,0:11:58.80,JP-SUB,,0000,0000,0000,,Әділдік болып, балғаны түсіргің келе ме?
Dialogue: 0,0:12:01.78,0:12:02.48,JP-SUB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:12:03.00,0:12:03.80,JP-SUB,,0000,0000,0000,,Мен жай ғана
Dialogue: 0,0:12:05.07,0:12:08.62,JP-SUB,,0000,0000,0000,,Әлгі қарт ешкім білмей өмір сүрді.
Dialogue: 0,0:12:09.59,0:12:11.33,JP-SUB,,0000,0000,0000,,Ешкім білмей қайтыс болды.
Dialogue: 0,0:12:12.35,0:12:13.79,JP-SUB,,0000,0000,0000,,Мен оны аяқтай алмаймын.
Dialogue: 0,0:12:21.67,0:12:24.63,JP-SUB,,0000,0000,0000,,Сакуракожи мырза есіне түсіреді деп үміттенемін.
Dialogue: 0,0:12:25.87,0:12:29.42,JP-SUB,,0000,0000,0000,,Дүниеде бәрі ұмытса да, сен есіңде болсаң.
Dialogue: 0,0:12:30.42,0:12:31.78,JP-SUB,,0000,0000,0000,,Мен ұмытпаймын
Dialogue: 0,0:12:32.90,0:12:34.97,JP-SUB,,0000,0000,0000,,Не болса да, әрқашан
Dialogue: 0,0:12:42.05,0:12:45.21,JP-SUB,,0000,0000,0000,,Ал мұндай адамдарды соттау.
Dialogue: 0,0:12:45.50,0:12:47.64,JP-SUB,,0000,0000,0000,,Бұл елдің заңдары қажет емес
Dialogue: 0,0:12:49.55,0:12:54.05,JP-SUB,,0000,0000,0000,,Көзге көз, тіске тіс, зұлымдыққа зұлымдық
Dialogue: 0,0:12:58.75,0:13:00.09,JP-SUB,,0000,0000,0000,,Хамнави коды?
Dialogue: 0,0:13:00.99,0:13:03.47,JP-SUB,,0000,0000,0000,,«Зұлымдыққа зұлымдық» артық Оками болар еді
Dialogue: 0,0:13:04.07,0:13:05.61,JP-SUB,,0000,0000,0000,,Ақыры күлдіңіз.
Dialogue: 0,0:13:06.83,0:13:08.72,JP-SUB,,0000,0000,0000,,Мен сені жек көреді деп ойладым.
Dialogue: 0,0:13:10.73,0:13:12.27,JP-SUB,,0000,0000,0000,,Кешіріңіз, Оками
Dialogue: 0,0:13:13.09,0:13:14.53,JP-SUB,,0000,0000,0000,,Мен көп нәрседен күдіктендім.
Dialogue: 0,0:13:15.58,0:13:18.34,JP-SUB,,0000,0000,0000,,Ogami Zero не болып жатыр?
Dialogue: 0,0:13:19.03,0:13:20.08,JP-SUB,,0000,0000,0000,,Орналастыру аяқталды
Dialogue: 0,0:13:20.80,0:13:22.81,JP-SUB,,0000,0000,0000,,Жұмысты бастау ғана қалды, Премьер-министр.
Dialogue: 0,0:13:23.53,0:13:26.84,JP-SUB,,0000,0000,0000,,Иә, жақсы, жоспарланғандай.
Dialogue: 0,0:13:40.21,0:13:41.92,JP-SUB,,0000,0000,0000,,Егер бұл Оками болмаса
Dialogue: 0,0:13:42.10,0:13:43.09,JP-SUB,,0000,0000,0000,,Адамдар сіздерді «тағдыр жібімен» байланып қойған деп айтады ғой?
Dialogue: 0,0:13:43.69,0:13:45.23,JP-SUB,,0000,0000,0000,,Бұл әлі де елес пе?
Dialogue: 0,0:13:45.53,0:13:47.91,JP-SUB,,0000,0000,0000,,Огами-кун, мен сенімен караокеге бармаймын.
Dialogue: 0,0:13:48.83,0:13:49.90,JP-SUB,,0000,0000,0000,,Шие гүлдері де келе жатыр
Dialogue: 0,0:13:50.37,0:13:52.26,JP-SUB,,0000,0000,0000,,Жоқ, менің бір ісім бар.
Dialogue: 0,0:13:53.88,0:13:56.06,JP-SUB,,0000,0000,0000,,Эй, бұл кімге арналған деп ойлайсың?
Dialogue: 0,0:13:56.24,0:13:56.74,JP-SUB,,0000,0000,0000,,Га
Dialogue: 0,0:13:57.33,0:13:58.50,JP-SUB,,0000,0000,0000,,Хаха, солай емес пе?
Dialogue: 0,0:13:58.60,0:14:01.21,JP-SUB,,0000,0000,0000,,Кешіріңіз, мен бүгін толық емес жұмыс күнім бар.
Dialogue: 0,0:14:01.66,0:14:02.87,JP-SUB,,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:14:04.34,0:14:07.40,JP-SUB,,0000,0000,0000,,Огами Ойланып қарасам, толық емес жұмыс күніңде не істеп жүрсің?
Dialogue: 0,0:14:07.92,0:14:09.91,JP-SUB,,0000,0000,0000,,Мен тазалаушымын. Қоқыс тазалау
Dialogue: 0,0:14:10.18,0:14:12.32,JP-SUB,,0000,0000,0000,,Түсінемін, бұл әсерлі.
Dialogue: 0,0:14:13.71,0:14:16.15,JP-SUB,,0000,0000,0000,,Қараңдар, мен сені қазір шақырғым келеді.
Dialogue: 0,0:14:16.99,0:14:20.37,JP-SUB,,0000,0000,0000,,Әй, сен қашан дос болдың?
Dialogue: 0,0:14:21.47,0:14:23.80,JP-SUB,,0000,0000,0000,,Бұл жай ғана өзара әрекеттесу емес пе?
Dialogue: 0,0:14:23.80,0:14:26.34,JP-SUB,,0000,0000,0000,,Өтірік өтірік Олар өте тез жақындап келеді.
Dialogue: 0,0:14:27.53,0:14:27.98,JP-SUB,,0000,0000,0000,,Не?
Dialogue: 0,0:14:28.70,0:14:30.14,JP-SUB,,0000,0000,0000,,Бүгінгі жұмыс туралы.
Dialogue: 0,0:14:30.98,0:14:33.77,JP-SUB,,0000,0000,0000,,Жоспарланғандай қоқысты тазалаңыз.
Dialogue: 0,0:14:34.86,0:14:38.12,JP-SUB,,0000,0000,0000,,Сакуракоджи Сакура, сен не істейсің?
Dialogue: 0,0:14:45.18,0:14:48.66,JP-SUB,,0000,0000,0000,,Бұрынғыдай ештеңе жоқ.
Dialogue: 0,0:14:49.97,0:14:51.27,JP-SUB,,0000,0000,0000,,Тек оны өшіріңіз.
Dialogue: 0,0:15:01.70,0:15:04.14,JP-SUB,,0000,0000,0000,,Оған қашан үйренесің?
Dialogue: 0,0:15:05.63,0:15:06.43,JP-SUB,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:15:07.54,0:15:08.66,JP-SUB,,0000,0000,0000,,Бұл мүмкін емес қой?
Dialogue: 0,0:15:08.99,0:15:09.81,JP-SUB,,0000,0000,0000,,Не?
Dialogue: 0,0:15:13.04,0:15:18.23,JP-SUB,,0000,0000,0000,,Сол себепті өткен түннен бері достарымызбен хабарласа алмадық.
Dialogue: 0,0:15:18.88,0:15:20.62,JP-SUB,,0000,0000,0000,,Балалар сендер осында тығылып отырсыңдар ғой, солай ма?
Dialogue: 0,0:15:20.89,0:15:23.13,JP-SUB,,0000,0000,0000,,Менен бірдеңе көргім келе ме деп сұрайсың ба?
Dialogue: 0,0:15:23.53,0:15:24.97,JP-SUB,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:15:25.09,0:15:26.31,JP-SUB,,0000,0000,0000,,(Фушигиро) Неге мұнда жүрсің, Зэн'ин-сенпай?
Dialogue: 0,0:15:27.73,0:15:28.62,JP-SUB,,0000,0000,0000,,Оны пайдалану мүмкін емес
Dialogue: 0,0:15:30.29,0:15:31.65,JP-SUB,,0000,0000,0000,,Маған көмектес
Dialogue: 0,0:15:32.75,0:15:33.59,JP-SUB,,0000,0000,0000,,Тоқта
Dialogue: 0,0:15:35.90,0:15:39.83,JP-SUB,,0000,0000,0000,,Мен 110 нөмірін тердім. Жақында полиция келеді.
Dialogue: 0,0:15:42.76,0:15:43.61,JP-SUB,,0000,0000,0000,,Қыз бала…
Dialogue: 0,0:15:45.02,0:15:46.12,JP-SUB,,0000,0000,0000,,Полиция.
Dialogue: 0,0:15:55.19,0:15:56.43,JP-SUB,,0000,0000,0000,,Hawk татуировкасы
Dialogue: 0,0:15:57.23,0:15:58.07,JP-SUB,,0000,0000,0000,,Бұл жігіттер...
Dialogue: 0,0:16:00.38,0:16:01.38,JP-SUB,,0000,0000,0000,,G-Falcon
Dialogue: 0,0:16:01.73,0:16:03.59,JP-SUB,,0000,0000,0000,,Сол қартты өлтіргендер
Dialogue: 0,0:16:03.94,0:16:08.54,JP-SUB,,0000,0000,0000,,Кішкентай қыз, әр нәрсеге мұрынды тықпа.
Dialogue: 0,0:16:09.13,0:16:13.56,JP-SUB,,0000,0000,0000,,Біз мұнда жоғалып кеткен достарымызға алаңдаймыз.
Dialogue: 0,0:16:15.60,0:16:17.43,JP-SUB,,0000,0000,0000,,Міне... жоғалып кетті ме?
Dialogue: 0,0:16:17.76,0:16:20.09,JP-SUB,,0000,0000,0000,,Ой, бұл не, жас ханым?
Dialogue: 0,0:16:20.47,0:16:21.73,JP-SUB,,0000,0000,0000,,Сіз бірдеңе білесіз бе?
Dialogue: 0,0:16:22.16,0:16:24.79,JP-SUB,,0000,0000,0000,,Өткен түн? Менің достарым жоғалып кетті
Dialogue: 0,0:16:28.00,0:16:30.51,JP-SUB,,0000,0000,0000,,Сіз шынымен білетін сияқтысыз. Эй.
Dialogue: 0,0:16:33.79,0:16:36.30,JP-SUB,,0000,0000,0000,,Енді толығырақ айтып берейін.
Dialogue: 0,0:16:37.99,0:16:40.38,JP-SUB,,0000,0000,0000,,Өткен түнде жоғалып кетті.
Dialogue: 0,0:16:41.34,0:16:42.76,JP-SUB,,0000,0000,0000,,Сонымен не болды?
Dialogue: 0,0:16:44.25,0:16:46.94,JP-SUB,,0000,0000,0000,,Не деп күбірлеп тұрсың? Білетініңді тез айт.
Dialogue: 0,0:16:50.02,0:16:52.53,JP-SUB,,0000,0000,0000,,Егер сіз бұл оқиғаның болғанын білсеңіз, бұл жақсы.
Dialogue: 0,0:16:53.03,0:16:55.41,JP-SUB,,0000,0000,0000,,Менің саған айтар сөзім жоқ.
Dialogue: 0,0:16:59.86,0:17:00.78,JP-SUB,,0000,0000,0000,,(JoJo) Дүрбелең шығарма!
Dialogue: 0,0:17:06.30,0:17:07.79,JP-SUB,,0000,0000,0000,,Мойынсұнумен полицияға барыңыз
Dialogue: 0,0:17:12.93,0:17:16.36,JP-SUB,,0000,0000,0000,,Жауап бермесең, менің денемнен тікелей сұраудан басқа амалым жоқ.
Dialogue: 0,0:17:17.78,0:17:19.60,JP-SUB,,0000,0000,0000,,Әлде менің денем ұйып қалды.
Dialogue: 0,0:17:24.42,0:17:26.43,JP-SUB,,0000,0000,0000,,Ей, бұл сенің белдігің, мені байлап қой.
Dialogue: 0,0:17:28.79,0:17:32.69,JP-SUB,,0000,0000,0000,,Ол ақымақ әйел. Ол үйсіздерді жалғыз қалдыруы керек.
Dialogue: 0,0:17:32.79,0:17:36.60,JP-SUB,,0000,0000,0000,,Мен көмектесуге тырысқаным үшін осындай жағдайға тап болдым.
Dialogue: 0,0:17:41.86,0:17:43.06,JP-SUB,,0000,0000,0000,,Егер солай болса, Мелло Нианы айналып өтіп, дәптерді қолға түсіру үшін барын салған болар еді
Dialogue: 0,0:17:44.65,0:17:45.37,JP-SUB,,0000,0000,0000,,Маған сен!
Dialogue: 0,0:17:45.64,0:17:46.79,JP-SUB,,0000,0000,0000,,Шулы
Dialogue: 0,0:17:51.38,0:17:52.65,JP-SUB,,0000,0000,0000,,Ақымақ болма.
Dialogue: 0,0:17:54.29,0:17:55.58,JP-SUB,,0000,0000,0000,,Мен оны жеймін бе?
Dialogue: 0,0:17:58.96,0:17:59.71,JP-SUB,,0000,0000,0000,,Тоқта
Dialogue: 0,0:18:01.87,0:18:02.89,JP-SUB,,0000,0000,0000,,Жақсы тамаша
Dialogue: 0,0:18:03.46,0:18:04.26,JP-SUB,,0000,0000,0000,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:18:04.33,0:18:05.20,JP-SUB,,0000,0000,0000,,Бір минут күтіңіз.
Dialogue: 0,0:18:10.79,0:18:13.33,JP-SUB,,0000,0000,0000,,Тоқтат енді, бұл жігіттің бұған қатысы жоқ.
Dialogue: 0,0:18:13.70,0:18:14.85,JP-SUB,,0000,0000,0000,,Мен сенің қарсыласыңмын
Dialogue: 0,0:18:15.96,0:18:17.46,JP-SUB,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:17.90,0:18:19.97,JP-SUB,,0000,0000,0000,,Егер сіз итіңіз үшін алаңдасаңыз.
Dialogue: 0,0:18:33.31,0:18:35.40,JP-SUB,,0000,0000,0000,,Күте тұрыңыз, мені дереу ауруханаға апарыңыз.
Dialogue: 0,0:18:38.93,0:18:40.79,JP-SUB,,0000,0000,0000,,Не деген жиіркенішті әйел.
Dialogue: 0,0:18:42.33,0:18:46.19,JP-SUB,,0000,0000,0000,,Осылай қорлансаң, мен сенің қалағаныңды істеймін.
Dialogue: 0,0:18:47.36,0:18:50.01,JP-SUB,,0000,0000,0000,,Егер сіз естігенді тыңдасаңыз, сіз көп нәрсе аласыз.
Dialogue: 0,0:18:51.65,0:18:53.35,JP-SUB,,0000,0000,0000,,Бұл ауырады ма?
Dialogue: 0,0:18:57.37,0:18:58.17,JP-SUB,,0000,0000,0000,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:18:58.96,0:18:59.58,JP-SUB,,0000,0000,0000,,Оками
Dialogue: 0,0:19:00.38,0:19:05.75,JP-SUB,,0000,0000,0000,,Денедегі ішкі мүшелер мен сүйектерді бұдан былай сақтау мүмкін емес.
Dialogue: 0,0:19:06.32,0:19:07.98,JP-SUB,,0000,0000,0000,,Мен әлі тірі екенмін
Dialogue: 0,0:19:09.72,0:19:12.48,JP-SUB,,0000,0000,0000,,Сакуракоджи-санды қорғағыңыз келді, солай ма?
Dialogue: 0,0:19:13.38,0:19:14.48,JP-SUB,,0000,0000,0000,,Сіз тамаша жұмыс жасадыңыз
Dialogue: 0,0:19:14.89,0:19:16.93,JP-SUB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:19:16.93,0:19:19.64,JP-SUB,,0000,0000,0000,,Огами, тезірек оны ауруханаға апар.
Dialogue: 0,0:19:22.80,0:19:24.34,JP-SUB,,0000,0000,0000,,Огами, өтінемін
Dialogue: 0,0:19:26.60,0:19:29.18,JP-SUB,,0000,0000,0000,,Мен сізге қазір жеңілдетемін.
Dialogue: 0,0:19:35.37,0:19:36.02,JP-SUB,,0000,0000,0000,,Оками?
Dialogue: 0,0:19:49.64,0:19:52.70,JP-SUB,,0000,0000,0000,,Оками сен
Dialogue: 0,0:19:59.98,0:20:02.37,JP-SUB,,0000,0000,0000,,Не, сен мені өлтірдің бе?
Dialogue: 0,0:20:02.59,0:20:04.03,JP-SUB,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:20:04.40,0:20:07.63,JP-SUB,,0000,0000,0000,,Егер сіз оны өлтірсеңіз, ешқандай реакция болмайды, сондықтан бұл жерде қызық болмайды.
Dialogue: 0,0:20:07.63,0:20:12.70,JP-SUB,,0000,0000,0000,,Көзге көз, тіске тіс, зұлымдыққа зұлымдық
Dialogue: 0,0:20:12.70,0:20:14.64,JP-SUB,,0000,0000,0000,,А? Сен не айтып тұрсың?
Dialogue: 0,0:20:15.26,0:20:16.21,JP-SUB,,0000,0000,0000,,Өртену
Dialogue: 0,0:20:29.83,0:20:31.15,JP-SUB,,0000,0000,0000,,Бұл басталды ма?
Dialogue: 0,0:20:41.01,0:20:43.62,JP-SUB,,0000,0000,0000,,Мен сені күтемін, Огами-кун.
Dialogue: 0,0:20:53.99,0:20:55.28,JP-SUB,,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,0:20:56.92,0:21:00.13,JP-SUB,,0000,0000,0000,,Не? Бұл қоқыс тазалаушы ретінде толық емес жұмыс күні.
Dialogue: 0,0:21:01.87,0:21:03.21,JP-SUB,,0000,0000,0000,,Соңғы сұрақ
Dialogue: 0,0:21:04.03,0:21:06.54,JP-SUB,,0000,0000,0000,,Мен өзім келіп, жауапқа тартыла аламын ба?
Dialogue: 0,0:21:06.96,0:21:08.48,JP-SUB,,0000,0000,0000,,Әлде осында өлесің бе?
Dialogue: 0,0:21:09.10,0:21:10.07,JP-SUB,,0000,0000,0000,,Қайсысы жақсы?
Dialogue: 0,0:21:10.37,0:21:12.80,JP-SUB,,0000,0000,0000,,Ақымақ болма, өлесің.
Dialogue: 0,0:21:12.80,0:21:15.61,JP-SUB,,0000,0000,0000,,Көрдім, сонда осында өл.
Dialogue: 0,0:21:18.79,0:21:23.39,JP-SUB,,0000,0000,0000,,Көзге көз, тіске тіс, зұлымдыққа зұлымдық
Dialogue: 0,0:21:26.52,0:21:29.26,JP-SUB,,0000,0000,0000,,Оками, бұл сенсің.
Dialogue: 0,0:21:49.51,0:21:52.97,JP-SUB,,0000,0000,0000,,Мен сыныптастардай араласуымыз керек дедім.
Dialogue: 0,0:21:55.63,0:21:56.67,JP-SUB,,0000,0000,0000,,Өртену
Dialogue: 0,0:23:33.38,0:23:35.71,JP-SUB,,0000,0000,0000,,Келесі код: Breaker 2-эпизод
Dialogue: 0,0:23:36.41,0:23:38.37,JP-SUB,,0000,0000,0000,,Жанып тұрған спираль тәрізді көк гүл
Dialogue: 0,0:23:40.01,0:23:44.21,JP-SUB,,0000,0000,0000,,Осы өмір біткенше бәрін өртеп жіберемін
