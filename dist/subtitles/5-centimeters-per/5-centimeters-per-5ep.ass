Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.93,0:00:02.77,*Default-ja,NTP,0,0,0,,Amaka Subtitles Co., Ltd.
Dialogue: 0,0:00:00.93,0:00:02.77,*Default-ja,NTP,0,0,0,,t x s u b
Dialogue: 0,0:00:11.13,0:00:12.08,Default,,0,0,0,,Эй...
Dialogue: 0,0:00:11.16,0:00:12.35,*Default-ja,NTP,0,0,0,,Эй
Dialogue: 0,0:00:12.49,0:00:14.88,Default,,0,0,0,,Олар секундына бес сантиметр дейді.
Dialogue: 0,0:00:12.86,0:00:14.65,*Default-ja,NTP,0,0,0,,Бұл секундына 5 сантиметр.
Dialogue: 0,0:00:14.76,0:00:16.52,*Default-ja,NTP,0,0,0,,Не?
Dialogue: 0,0:00:14.91,0:00:16.42,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:00:16.63,0:00:21.00,*Default-ja,NTP,0,0,0,,Шие гүлінің түсу жылдамдығы секундына 5 сантиметр.
Dialogue: 0,0:00:16.67,0:00:21.03,Default,,0,0,0,,Шие гүлінің түсу жылдамдығы. Бұл секундына бес сантиметр.
Dialogue: 0,0:00:21.10,0:00:22.50,*Default-ja,NTP,0,0,0,,Тек осы екі қарапайым белгіні есте сақта.
Dialogue: 0,0:00:22.77,0:00:25.33,Default,,0,0,0,,Сен осындай көп нәрсені білетінсің, Акари.
Dialogue: 0,0:00:22.83,0:00:25.23,*Default-ja,NTP,0,0,0,,Акари Сіз мұны өте жақсы білесіз.
Dialogue: 0,0:00:25.37,0:00:26.17,*Default-ja,NTP,0,0,0,,Фуфун
Dialogue: 0,0:00:27.61,0:00:31.82,Default,,0,0,0,,Айтыңызшы... бұл қар сияқты емес пе?
Dialogue: 0,0:00:27.64,0:00:31.44,*Default-ja,NTP,0,0,0,,Әй, бұл қарға ұқсайды, солай емес пе?
Dialogue: 0,0:00:31.85,0:00:33.28,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:00:31.91,0:00:33.21,*Default-ja,NTP,0,0,0,,Маған қызық
Dialogue: 0,0:00:33.35,0:00:34.07,*Default-ja,NTP,0,0,0,,Ах
Dialogue: 0,0:00:34.18,0:00:35.91,*Default-ja,NTP,0,0,0,,Хахаха
Dialogue: 0,0:00:36.24,0:00:38.49,Default,,0,0,0,,Сәлем! Күте тұрыңыз!
Dialogue: 0,0:00:36.25,0:00:36.91,*Default-ja,NTP,0,0,0,,Эй!
Dialogue: 0,0:00:37.45,0:00:39.11,*Default-ja,NTP,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:00:45.26,0:00:46.05,*Default-ja,NTP,0,0,0,,Акари!
Dialogue: 0,0:00:45.27,0:00:46.09,Default,,0,0,0,,Акари!
Dialogue: 0,0:00:46.17,0:00:46.97,Default,,0,0,0,,Такаки-кун!
Dialogue: 0,0:00:46.26,0:00:46.92,*Default-ja,NTP,0,0,0,,Такаки-кун
Dialogue: 0,0:00:49.69,0:00:53.99,*Default-ja,NTP,0,0,0,,Келесі жылы шие гүлдерін бірге көреміз деп сенемін!
Dialogue: 0,0:00:49.75,0:00:53.72,Default,,0,0,0,,Келесі жылы шие гүлдерін бірге көрсек, тамаша болар еді.
Dialogue: 0,0:01:07.21,0:01:11.24,*Default-ja,NTP,0,0,0,,Құрметті Такаки Тоно, қолайсыздықтар үшін кешірім сұраймын.
Dialogue: 0,0:01:07.22,0:01:08.64,Default,,0,0,0,,«Тоно Такаки-самаға».
Dialogue: 0,0:01:09.11,0:01:11.27,Default,,0,0,0,,«Бұл шынымен ұзақ уақыт болды».
Dialogue: 0,0:01:16.22,0:01:18.42,*Default-ja,NTP,0,0,0,,Бұл жерде жазда да ыстық.
Dialogue: 0,0:01:16.29,0:01:21.86,Default,,0,0,0,,«Бұл жерде жаз өте ыстық, бірақ Токиомен салыстырғанда ол әлдеқайда жұмсақ».
Dialogue: 0,0:01:18.86,0:01:22.22,*Default-ja,NTP,0,0,0,,Токиомен салыстырғанда бұл әлдеқайда ыңғайлы.
Dialogue: 0,0:01:22.33,0:01:27.70,*Default-ja,NTP,0,0,0,,Бірақ қазір ойлап қарасам, мен де Токиодағы ыстық жазды жақсы көретінмін.
Dialogue: 0,0:01:22.36,0:01:27.91,Default,,0,0,0,,«Бірақ мен ойласам, Токионың ыстық, ылғалды жазы да ұнады».
Dialogue: 0,0:01:28.07,0:01:32.90,*Default-ja,NTP,0,0,0,,Ыстық асфальт еріп кететін сияқты, ал ыстық тұманның арғы жағындағы зәулім ғимараттар
Dialogue: 0,0:01:28.13,0:01:30.54,Default,,0,0,0,,«Еріген ыстық асфальт»,
Dialogue: 0,0:01:30.69,0:01:32.93,Default,,0,0,0,,«Ыстықта жарқыраған алыстағы зәулім үйлер»,
Dialogue: 0,0:01:32.96,0:01:36.46,Default,,0,0,0,,«және әмбебап дүкендердегі және метродағы мұздатылған кондиционер».
Dialogue: 0,0:01:33.00,0:01:36.41,*Default-ja,NTP,0,0,0,,Әмбебап дүкендер мен метродағы кондиционер жеткілікті салқын.
Dialogue: 0,0:01:36.82,0:01:41.35,Default,,0,0,0,,«Соңғы рет бастауыш мектепті бітіру кешінде бірге болдық».
Dialogue: 0,0:01:37.11,0:01:41.55,*Default-ja,NTP,0,0,0,,Соңғы рет бастауыш мектепті бітіру кешінде кездестік.
Dialogue: 0,0:01:41.54,0:01:43.35,Default,,0,0,0,,«Одан бері жарты жыл өтті».
Dialogue: 0,0:01:41.65,0:01:43.84,*Default-ja,NTP,0,0,0,,Содан бері жарты жыл өтті.
Dialogue: 0,0:01:44.29,0:01:46.16,Default,,0,0,0,,«Сонымен, Такаки-кун...»
Dialogue: 0,0:01:44.32,0:01:46.72,*Default-ja,NTP,0,0,0,,Сәлем Такаки-кун
Dialogue: 0,0:01:46.87,0:01:49.89,Default,,0,0,0,,«...сен мені әлі есіңде ме?»
Dialogue: 0,0:01:46.92,0:01:50.18,*Default-ja,NTP,0,0,0,,Мені есіңізде ме?
Dialogue: 0,0:01:53.86,0:01:56.55,*Default-ja,NTP,0,0,0,,Такаки-кунға алғы сөз түсірілген
Dialogue: 0,0:01:53.87,0:01:56.21,Default,,0,0,0,,«Құрметті Такаки-кун...»
Dialogue: 0,0:01:56.66,0:01:59.86,*Default-ja,NTP,0,0,0,,Жауабыңызға рахмет, бұл өте қуанышты болды.
Dialogue: 0,0:01:56.69,0:01:57.91,Default,,0,0,0,,«Жауап бергеніңізге рахмет».
Dialogue: 0,0:01:57.98,0:01:59.50,Default,,0,0,0,,«Бұл мені қатты қуантты».
Dialogue: 0,0:02:00.37,0:02:05.06,*Default-ja,NTP,0,0,0,,Қазірдің өзінде күз. Мұнда күзгі жапырақтар әдемі.
Dialogue: 0,0:02:00.44,0:02:04.71,Default,,0,0,0,,«Күз келді, жапырақтар әдемі түске боялады».
Dialogue: 0,0:02:05.16,0:02:09.38,Default,,0,0,0,,«Мен биыл бірінші рет кешегі күні жемпірді шығаруға тура келді».
Dialogue: 0,0:02:05.17,0:02:08.30,*Default-ja,NTP,0,0,0,,Мен кешегі жылдың бірінші жемпірін шығардым.
Dialogue: 0,0:02:10.14,0:02:11.07,*Default-ja,NTP,0,0,0,,Тоно-кун!
Dialogue: 0,0:02:10.17,0:02:10.97,Default,,0,0,0,,Тохно-кун.
Dialogue: 0,0:02:11.04,0:02:12.01,Default,,0,0,0,,Сенпай.
Dialogue: 0,0:02:11.18,0:02:12.37,*Default-ja,NTP,0,0,0,,Аға
Dialogue: 0,0:02:12.48,0:02:14.24,*Default-ja,NTP,0,0,0,,Не? Abletter?
Dialogue: 0,0:02:12.49,0:02:14.01,Default,,0,0,0,,Бұл не? Махаббат хаты ма?
Dialogue: 0,0:02:14.33,0:02:15.24,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:02:14.35,0:02:15.24,*Default-ja,NTP,0,0,0,,Жоқ!
Dialogue: 0,0:02:15.28,0:02:17.09,Default,,0,0,0,,Осының бәрін орындауды сұрағаным үшін кешіріңіз.
Dialogue: 0,0:02:15.35,0:02:16.97,*Default-ja,NTP,0,0,0,,Барлығын сұрағаным үшін кешіріңіз.
Dialogue: 0,0:02:17.08,0:02:18.28,*Default-ja,NTP,0,0,0,,Жоқ, ол көп ұзамай аяқталды.
Dialogue: 0,0:02:17.12,0:02:18.42,Default,,0,0,0,,Мәселе жоқ, мен тез бітірдім.
Dialogue: 0,0:02:18.38,0:02:21.08,*Default-ja,NTP,0,0,0,,Рахмет. Мектептерді ауыстырып жатқаныңыз рас па?
Dialogue: 0,0:02:18.46,0:02:21.17,Default,,0,0,0,,Рахмет. Сонымен, сіз мектептерді ауыстыратыныңыз рас па?
Dialogue: 0,0:02:21.19,0:02:23.35,*Default-ja,NTP,0,0,0,,Иә, үшінші семестр толық.
Dialogue: 0,0:02:21.20,0:02:23.36,Default,,0,0,0,,А, иә, жылдың аяғында.
Dialogue: 0,0:02:23.46,0:02:24.29,*Default-ja,NTP,0,0,0,,Қайда?
Dialogue: 0,0:02:23.47,0:02:24.29,Default,,0,0,0,,Қайда?
Dialogue: 0,0:02:24.36,0:02:26.72,Default,,0,0,0,,Кагосима. Ата-анамның арқасында.
Dialogue: 0,0:02:24.39,0:02:26.62,*Default-ja,NTP,0,0,0,,Кагосима. Ата-анамның жағдайына байланысты.
Dialogue: 0,0:02:26.72,0:02:28.52,*Default-ja,NTP,0,0,0,,Көремін, жалғыз қаламын.
Dialogue: 0,0:02:26.76,0:02:28.72,Default,,0,0,0,,Түсінемін... сенсіз бұл жерде жалғыз болады.
Dialogue: 0,0:02:28.63,0:02:34.29,*Default-ja,NTP,0,0,0,,Соңғы кездері үйірме жұмыстарына байланысты таңертең ерте болатынмын, сондықтан бұл хатты пойызда жазып отырмын.
Dialogue: 0,0:02:28.76,0:02:34.31,Default,,0,0,0,,«Мен бұл хатты пойызда жазып отырмын, өйткені соңғы уақытта жаттығу өте ерте басталды».
Dialogue: 0,0:02:34.40,0:02:36.73,*Default-ja,NTP,0,0,0,,Өткен күні шашымды алдырдым.
Dialogue: 0,0:02:34.43,0:02:36.59,Default,,0,0,0,,«Мен кеше шашымды алдырдым».
Dialogue: 0,0:02:36.81,0:02:39.00,Default,,0,0,0,,«Оның қысқа болғаны сонша, тіпті құлағым да көрінеді...»
Dialogue: 0,0:02:36.84,0:02:38.89,*Default-ja,NTP,0,0,0,,Мен оны қысқа етіп кесіп тастадым, сондықтан құлағым сыртқа шығады.
Dialogue: 0,0:02:39.47,0:02:41.97,*Default-ja,NTP,0,0,0,,Біз кездессек те, мені танымайтын шығарсың.
Dialogue: 0,0:02:39.50,0:02:43.36,Default,,0,0,0,,«... сондықтан мені көрсеңдер, мені танымайтын шығарсыңдар».
Dialogue: 0,0:02:43.41,0:02:44.10,*Default-ja,NTP,0,0,0,,Мен келдім!
Dialogue: 0,0:02:43.55,0:02:44.16,Default,,0,0,0,,Аякаши оны кесіп өте алмайды
Dialogue: 0,0:02:44.21,0:02:45.20,*Default-ja,NTP,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:02:44.29,0:02:45.17,Default,,0,0,0,,Үйге қош келдіңіз.
Dialogue: 0,0:02:54.22,0:02:59.18,*Default-ja,NTP,0,0,0,,Такаки-кунның да бірте-бірте өзгеретініне сенімдімін.
Dialogue: 0,0:02:54.23,0:02:58.99,Default,,0,0,0,,«Сіз де бірте-бірте өзгеріп жатқаныңызға сенімдімін, Такаки-кун».
Dialogue: 0,0:03:13.53,0:03:14.70,Default,,0,0,0,,«Құрметті Такаки-кун...»
Dialogue: 0,0:03:13.54,0:03:18.41,*Default-ja,NTP,0,0,0,,Құрметті мырза немесе ханым, суық күндер жалғасуда, қалдарыңыз қалай?
Dialogue: 0,0:03:14.94,0:03:18.39,Default,,0,0,0,,«Осы суық күндері жақсы болдыңыз ба?»
Dialogue: 0,0:03:23.18,0:03:25.74,*Default-ja,NTP,0,0,0,,Мұнда бірнеше рет қар жауды.
Dialogue: 0,0:03:23.21,0:03:25.82,Default,,0,0,0,,«Бұл жерде бірнеше рет қар жауды».
Dialogue: 0,0:03:25.85,0:03:30.22,*Default-ja,NTP,0,0,0,,Әр жолы мен мектепке өте ауыр техникамен барамын.
Dialogue: 0,0:03:25.99,0:03:30.26,Default,,0,0,0,,«Әр кезде мен мектепке барғанда қабат-қабат киімге оранамын».
Dialogue: 0,0:03:30.89,0:03:33.82,*Default-ja,NTP,0,0,0,,Токиода қар әлі жауып жатыр емес пе?
Dialogue: 0,0:03:30.94,0:03:33.87,Default,,0,0,0,,«Токиоға қар әлі жауған жоқ, солай ма?»
Dialogue: 0,0:03:33.90,0:03:36.12,Default,,0,0,0,,«Мен көшіп кетсем де...»
Dialogue: 0,0:03:33.93,0:03:36.02,*Default-ja,NTP,0,0,0,,Мен көшіп келгеннен кейін де бұл әдетке айналды.
Dialogue: 0,0:03:36.23,0:03:39.39,*Default-ja,NTP,0,0,0,,Мен тіпті Токионың ауа райы болжамын да қараймын.
Dialogue: 0,0:03:36.23,0:03:39.51,Default,,0,0,0,,«...Мен әлі күнге дейін әдеттен тыс Токионың ауа райы болжамын қараймын».
Dialogue: 0,0:03:41.33,0:03:42.30,*Default-ja,NTP,0,0,0,,Хахаха
Dialogue: 0,0:03:43.74,0:03:45.50,*Default-ja,NTP,0,0,0,,Жаңбыр жаумай ма деп ойлаймын
Dialogue: 0,0:03:43.80,0:03:45.63,Default,,0,0,0,,Күндердің бірінде жаңбыр жауса екен...
Dialogue: 0,0:03:45.60,0:03:47.70,*Default-ja,NTP,0,0,0,,Бірақ үйде де қиын
Dialogue: 0,0:03:45.66,0:03:47.63,Default,,0,0,0,,Үй ішінде жақсырақ болмас еді.
Dialogue: 0,0:03:47.81,0:03:50.87,*Default-ja,NTP,0,0,0,,Эй, сен Точигиде болдың ба?
Dialogue: 0,0:03:47.86,0:03:51.09,Default,,0,0,0,,Айтыңызшы... балалар, Точигиде болдыңыз ба?
Dialogue: 0,0:03:50.98,0:03:52.31,*Default-ja,NTP,0,0,0,,Иә? қайда?
Dialogue: 0,0:03:51.12,0:03:52.22,Default,,0,0,0,,Иә? Қайда?
Dialogue: 0,0:03:52.40,0:03:53.01,Default,,0,0,0,,Точиги.
Dialogue: 0,0:03:52.41,0:03:53.14,*Default-ja,NTP,0,0,0,,Точиги
Dialogue: 0,0:03:53.23,0:03:53.87,Default,,0,0,0,,Ах, бұл – өзін өзгелерден бөліп тұратын сызық екен
Dialogue: 0,0:03:53.24,0:03:54.18,*Default-ja,NTP,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:03:54.28,0:03:55.91,*Default-ja,NTP,0,0,0,,Біз оған қалай жетеміз?
Dialogue: 0,0:03:54.51,0:03:55.73,Default,,0,0,0,,Маған қызық, сіз оған қалай жетесіз...
Dialogue: 0,0:03:56.01,0:03:58.74,*Default-ja,NTP,0,0,0,,Енді... Шинкансен?
Dialogue: 0,0:03:56.15,0:03:56.89,Default,,0,0,0,,Капыпа
Dialogue: 0,0:03:57.03,0:03:58.81,Default,,0,0,0,,Поезд па, әлде бір нәрсе ме?
Dialogue: 0,0:03:59.15,0:04:00.58,*Default-ja,NTP,0,0,0,,Ол алыс.
Dialogue: 0,0:03:59.23,0:04:00.20,Default,,0,0,0,,Бұл ұзақ жол...
Dialogue: 0,0:04:02.65,0:04:03.38,*Default-ja,NTP,0,0,0,,Бір жыл!
Dialogue: 0,0:04:02.69,0:04:03.53,Default,,0,0,0,,Бірінші курс студенттері!
Dialogue: 0,0:04:03.49,0:04:04.75,*Default-ja,NTP,0,0,0,,Сәлем!
Dialogue: 0,0:04:03.54,0:04:04.15,Default,,0,0,0,,Иә?!
Dialogue: 0,0:04:05.22,0:04:08.43,Default,,0,0,0,,Соңғы үш айналымға! Ұрыс! Ұрыс!
Dialogue: 0,0:04:05.26,0:04:06.69,*Default-ja,NTP,0,0,0,,Соңғы үш айналым!
Dialogue: 0,0:04:06.79,0:04:08.28,*Default-ja,NTP,0,0,0,,Ұрыс! О! Ұрыс! О!
Dialogue: 0,0:04:08.39,0:04:13.19,*Default-ja,NTP,0,0,0,,Такаки-кунның бұл жолы мектептерді ауыстыру туралы шешім қабылдағанын білгенде таң қалдым.
Dialogue: 0,0:04:08.44,0:04:13.32,Default,,0,0,0,,«Бұл жолы мектептерді ауыстырған сенің екеніңді естігенде таң қалдым».
Dialogue: 0,0:04:13.30,0:04:17.23,*Default-ja,NTP,0,0,0,,Екеуміз де көптен бері мектептерді ауыстыруға үйреніп қалғанбыз.
Dialogue: 0,0:04:13.80,0:04:17.34,Default,,0,0,0,,«Кішкентай кезімізде екеуіміз де мектепті ауыстыруға үйренгенбіз..»
Dialogue: 0,0:04:17.34,0:04:19.46,*Default-ja,NTP,0,0,0,,Сонда да бұл Кагосима.
Dialogue: 0,0:04:17.37,0:04:22.12,Default,,0,0,0,,«Бірақ сонда да... Кагосима. Бұл біршама алыс, солай емес пе?
Dialogue: 0,0:04:19.57,0:04:22.80,*Default-ja,NTP,0,0,0,,%Бұл жолы сәл алыс.
Dialogue: 0,0:04:23.64,0:04:25.04,*Default-ja,NTP,0,0,0,,Төтенше жағдайда
Dialogue: 0,0:04:23.73,0:04:28.75,Default,,0,0,0,,«Бұл енді пойызға секіріп, сені қалаған кезде көретін қашықтық емес...»
Dialogue: 0,0:04:25.14,0:04:28.77,*Default-ja,NTP,0,0,0,,Қашықтық енді біреуді қарсы алу үшін пойызға отыратындай емес.
Dialogue: 0,0:04:28.78,0:04:33.13,Default,,0,0,0,,«Сонымен... Менің ойымша... бұл мені аздап жалғыз сезінеді».
Dialogue: 0,0:04:28.88,0:04:30.04,*Default-ja,NTP,0,0,0,,Күтілгендей...
Dialogue: 0,0:04:30.15,0:04:31.27,*Default-ja,NTP,0,0,0,,Кішкене...
Dialogue: 0,0:04:31.52,0:04:34.21,*Default-ja,NTP,0,0,0,,Мен өзімді аздап жалғыз сезінемін.
Dialogue: 0,0:04:34.32,0:04:38.35,*Default-ja,NTP,0,0,0,,Өтінемін, Такаки-кунның жағдайы жақсы деп үміттенемін.
Dialogue: 0,0:04:34.34,0:04:38.01,Default,,0,0,0,,«Сау бол, Такаки-кун».
Dialogue: 0,0:04:52.67,0:04:55.23,*Default-ja,NTP,0,0,0,,Такаки-кунға алғы сөз түсірілген
Dialogue: 0,0:04:52.72,0:04:54.92,Default,,0,0,0,,«Құрметті Такаки-кун...»
Dialogue: 0,0:04:56.07,0:04:59.74,*Default-ja,NTP,0,0,0,,4 наурызға уәде Мен өте қуаныштымын.
Dialogue: 0,0:04:56.15,0:04:59.69,Default,,0,0,0,,«Мен 4 наурызда бір-бірімізді көретінімізге өте қуаныштымын».
Dialogue: 0,0:04:59.84,0:05:02.57,*Default-ja,NTP,0,0,0,,Танысқанымызға бір жыл болды.
Dialogue: 0,0:04:59.93,0:05:02.54,Default,,0,0,0,,«Соңғы кездескенімізге бір жылдай ғана болады, солай емес пе?»
Dialogue: 0,0:05:02.68,0:05:05.00,Default,,0,0,0,,«Мен қандай да бір себептермен қобалжыдым».
Dialogue: 0,0:05:02.68,0:05:05.38,*Default-ja,NTP,0,0,0,,Мен қобалжыдым.
Dialogue: 0,0:05:12.26,0:05:15.42,*Default-ja,NTP,0,0,0,,Менің үйімнің жанында үлкен шие ағашы бар.
Dialogue: 0,0:05:12.32,0:05:17.85,Default,,0,0,0,,«Менің үйімнің жанында шынымен үлкен шие ағашы бар, сондықтан көктемде ...»
Dialogue: 0,0:05:15.53,0:05:17.93,*Default-ja,NTP,0,0,0,,Көктемде бар шығар
Dialogue: 0,0:05:18.03,0:05:21.76,*Default-ja,NTP,0,0,0,,Гүл жапырақтары секундына 5 сантиметр жылдамдықпен жерге түсіп жатыр.
Dialogue: 0,0:05:18.13,0:05:21.58,Default,,0,0,0,,«...жапырақшалар секундына бес сантиметр жылдамдықпен түседі».
Dialogue: 0,0:05:23.03,0:05:25.13,*Default-ja,NTP,0,0,0,,Такаки-кунмен
Dialogue: 0,0:05:23.30,0:05:28.60,Default,,0,0,0,,«Сол күні көктем сенімен бірге келеді деп үміттенемін, Такаки-кун».
Dialogue: 0,0:05:25.24,0:05:29.07,*Default-ja,NTP,0,0,0,,Көктем де келеді деп үміттенемін.
Dialogue: 0,0:05:46.60,0:05:48.17,Default,,0,0,0,,Үйге барар жолда бір жерге тоқтағың келе ме?
Dialogue: 0,0:05:48.20,0:05:49.75,Default,,0,0,0,,Ал... жаңбыр жауып тұр.
Dialogue: 0,0:05:49.78,0:05:52.04,Default,,0,0,0,,Болжам бойынша бүгін түнде қар жауады деп болжануда.
Dialogue: 0,0:05:49.86,0:05:52.39,*Default-ja,NTP,0,0,0,,Болжам бойынша кешке қар жауады.
Dialogue: 0,0:05:52.18,0:05:54.10,Default,,0,0,0,,Шынымен бе? Мен суық болды деп ойладым.
Dialogue: 0,0:05:52.50,0:05:55.83,*Default-ja,NTP,0,0,0,,Уау, наурыз айы болса да салқын деп ойладым.
Dialogue: 0,0:05:54.22,0:05:56.01,Default,,0,0,0,,Біз наурыздамыз...
Dialogue: 0,0:05:55.93,0:05:57.49,*Default-ja,NTP,0,0,0,,Сіз суық тиетін сияқтысыз.
Dialogue: 0,0:05:56.31,0:05:59.59,Default,,0,0,0,,Иә, суық тиетін сияқтымын.
Dialogue: 0,0:05:57.60,0:06:00.90,*Default-ja,NTP,0,0,0,,Ей, жылы бірдеңе ішейік. Шимокитадан түсіңіз.
Dialogue: 0,0:05:59.62,0:06:00.80,Default,,0,0,0,,Біз Шимокитадан түсе аламыз.
Dialogue: 0,0:06:01.01,0:06:01.97,*Default-ja,NTP,0,0,0,,That's right.
Dialogue: 0,0:06:01.17,0:06:02.01,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:06:02.44,0:06:03.53,*Default-ja,NTP,0,0,0,,Тоно
Dialogue: 0,0:06:02.60,0:06:05.11,Default,,0,0,0,,Тохно, жаттығуға кірісейік.
Dialogue: 0,0:06:04.01,0:06:05.00,*Default-ja,NTP,0,0,0,,Үйірме жұмыстарына барайық
Dialogue: 0,0:06:05.11,0:06:06.24,*Default-ja,NTP,0,0,0,,Ах
Dialogue: 0,0:06:05.14,0:06:05.88,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:06:07.85,0:06:10.58,*Default-ja,NTP,0,0,0,,Білесің бе, мен бүгін үйірме жұмыстарын жасай алмаймын.
Dialogue: 0,0:06:07.99,0:06:10.69,Default,,0,0,0,,Бұл туралы... Мен бүгін үлгере алмаймын деп ойлаймын.
Dialogue: 0,0:06:10.68,0:06:11.84,*Default-ja,NTP,0,0,0,,Сіз көшуге дайындалып жатырсыз ба?
Dialogue: 0,0:06:10.72,0:06:11.89,Default,,0,0,0,,Көшуге дайынсыз ба?
Dialogue: 0,0:06:11.92,0:06:13.06,Default,,0,0,0,,Осындай нәрсе.
Dialogue: 0,0:06:11.95,0:06:14.01,*Default-ja,NTP,0,0,0,,Бұл жаман.
Dialogue: 0,0:06:13.09,0:06:13.91,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:14.12,0:06:18.28,*Default-ja,NTP,0,0,0,,Менің бекетіме келсеңіз үлкен көмек болар еді.
Dialogue: 0,0:06:14.31,0:06:18.54,Default,,0,0,0,,«Сіз маған ең жақын станцияға дейін келе жатқаныңызға қуаныштымын...»
Dialogue: 0,0:06:18.59,0:06:21.85,*Default-ja,NTP,0,0,0,,Ол алыс, сондықтан абай болыңыз.
Dialogue: 0,0:06:18.61,0:06:21.52,Default,,0,0,0,,"...бірақ бұл ұзақ сапар, сондықтан абай болыңыз."
Dialogue: 0,0:06:22.29,0:06:26.09,*Default-ja,NTP,0,0,0,,Мен уәде етілгендей кешкі сағат 19.00-де вокзалдың күту залында күтемін.
Dialogue: 0,0:06:22.44,0:06:26.16,Default,,0,0,0,,«Мен сені сол түні сағат 7:00-де вокзалдың күту залында күтемін».
Dialogue: 0,0:06:45.65,0:06:50.95,*Default-ja,NTP,0,0,0,,Акаримен уәделескен күні түстен кейін қар жауа бастады.
Dialogue: 0,0:06:45.67,0:06:50.81,Default,,0,0,0,,Акари екеуміз кездесетін күні түсте жаңбыр қарға айналды.
Dialogue: 0,0:06:53.12,0:06:55.49,*Default-ja,NTP,0,0,0,,Әй, Такаки-кун!
Dialogue: 0,0:06:54.06,0:06:55.43,Default,,0,0,0,,Эй, Такаки-кун.
Dialogue: 0,0:06:55.59,0:06:57.42,*Default-ja,NTP,0,0,0,,Мысық! Бұл Чоби!
Dialogue: 0,0:06:55.62,0:06:57.48,Default,,0,0,0,,Бұл мысық, Чоби.
Dialogue: 0,0:06:57.60,0:06:59.76,*Default-ja,NTP,0,0,0,,Бұл жігіт үнемі осында.
Dialogue: 0,0:06:57.68,0:06:59.86,Default,,0,0,0,,Ол үнемі осында жатады.
Dialogue: 0,0:06:59.86,0:07:01.86,*Default-ja,NTP,0,0,0,,Бірақ мен бүгін жалғыз қалғандай сезінемін
Dialogue: 0,0:06:59.91,0:07:01.90,Default,,0,0,0,,Бірақ ол бүгін жалғыз қалған сияқты.
Dialogue: 0,0:07:01.97,0:07:05.83,*Default-ja,NTP,0,0,0,,Мимиге не болды? Жалғыз болу жалғыздық
Dialogue: 0,0:07:02.07,0:07:05.61,Default,,0,0,0,,Досың Мимиге не болды? Бұл жалғыздық болуы керек, иә?
Dialogue: 0,0:07:09.61,0:07:12.13,*Default-ja,NTP,0,0,0,,Хахаха
Dialogue: 0,0:07:16.51,0:07:17.85,*Default-ja,NTP,0,0,0,,Бұл кітап туралы не ойлайсыз?
Dialogue: 0,0:07:16.91,0:07:17.88,Default,,0,0,0,,Бұл кітап әзірге қалай?
Dialogue: 0,0:07:17.95,0:07:21.48,*Default-ja,NTP,0,0,0,,Мен кеше бір түнде 4 миллиард жылды оқыдым!
Dialogue: 0,0:07:17.99,0:07:19.17,Default,,0,0,0,,Маған қатты ұнайды.
Dialogue: 0,0:07:19.22,0:07:21.59,Default,,0,0,0,,Кеше түнде мен төрт миллиард жылдық эволюцияны оқыдым.
Dialogue: 0,0:07:21.59,0:07:22.35,*Default-ja,NTP,0,0,0,,Қайда?
Dialogue: 0,0:07:21.67,0:07:22.56,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:07:22.45,0:07:24.32,*Default-ja,NTP,0,0,0,,Anomalocaris пайда болатын жердің айналасында
Dialogue: 0,0:07:22.58,0:07:24.55,Default,,0,0,0,,Anomalocaris қашан пайда болады.
Dialogue: 0,0:07:24.42,0:07:25.48,*Default-ja,NTP,0,0,0,,Кембрий!
Dialogue: 0,0:07:24.62,0:07:25.55,Default,,0,0,0,,Кембрий дәуірі!
Dialogue: 0,0:07:27.06,0:07:30.60,Default,,0,0,0,,Маған Галлюцигения қатты ұнайды. Олар осылай көрінеді!
Dialogue: 0,0:07:27.06,0:07:30.65,*Default-ja,NTP,0,0,0,,Маған Галлюцигения ұнайды.
Dialogue: 0,0:07:30.76,0:07:31.99,*Default-ja,NTP,0,0,0,,Бұл ұқсас болуы мүмкін.
Dialogue: 0,0:07:30.83,0:07:32.17,Default,,0,0,0,,Иә, осындай нәрсе...
Dialogue: 0,0:07:32.10,0:07:33.72,*Default-ja,NTP,0,0,0,,Такаки-кун қандай жанкүйер?
Dialogue: 0,0:07:32.33,0:07:33.81,Default,,0,0,0,,Саған қайсысы ұнайды, Такаки-кун?
Dialogue: 0,0:07:33.83,0:07:34.80,*Default-ja,NTP,0,0,0,,Бұл Опабиния ма?
Dialogue: 0,0:07:33.88,0:07:35.52,Default,,0,0,0,,Опабиния, мүмкін?
Dialogue: 0,0:07:34.90,0:07:37.49,*Default-ja,NTP,0,0,0,,Әй, бұл бес көзді адам ғой!
Dialogue: 0,0:07:35.56,0:07:37.61,Default,,0,0,0,,Бес көзді, солай ма?
Dialogue: 0,0:07:37.60,0:07:42.06,*Default-ja,NTP,0,0,0,,Менің ойымша, Акари екеуміз ақыл-ой жағынан ұқсас едік.
Dialogue: 0,0:07:37.65,0:07:41.80,Default,,0,0,0,,Менің ойымша, Акари екеуміз бір-біріне ұқсайтынбыз.
Dialogue: 0,0:07:43.43,0:07:43.45,Default,,0,0,0,,Мен Токиоға ауысқаннан кейін тура бір жылдан кейін...
Dialogue: 0,0:07:43.44,0:07:45.97,*Default-ja,NTP,0,0,0,,Мен Токиоға ауысқаннан кейін бір жылдан кейін...
Dialogue: 0,0:07:43.47,0:07:46.45,Default,,0,0,0,,Біздің мектепке жаңа досым ауысты. Бұл Тоно Такаки-кун.
Dialogue: 0,0:07:46.31,0:07:49.44,*Default-ja,NTP,0,0,0,,Акари сол сыныпқа ауыстырылды.
Dialogue: 0,0:07:46.48,0:07:46.72,Default,,0,0,0,,...Акари менің сыныбыма ауысты.
Dialogue: 0,0:07:46.76,0:07:49.92,Default,,0,0,0,,Бүгіннен бастап Синохара Акари-сан біздің сыныпқа қосылады.
Dialogue: 0,0:07:50.42,0:07:53.61,*Default-ja,NTP,0,0,0,,Біз әлі кішкентай едік және жиі ауыратынбыз.
Dialogue: 0,0:07:50.61,0:07:53.66,Default,,0,0,0,,Өйткені біздің денеміз әлі кішкентай, әлсіз және ауруға бейім болатын...
Dialogue: 0,0:07:53.70,0:07:56.58,Default,,0,0,0,,...екеуміз спорт алаңында ойнаудан гөрі кітапхананы артық көрдік.
Dialogue: 0,0:07:53.72,0:07:56.28,*Default-ja,NTP,0,0,0,,Маған үлкен кітапханадан гөрі кітапхана ұнайды.
Dialogue: 0,0:07:56.62,0:07:59.15,*Default-ja,NTP,0,0,0,,Сондықтан біз табиғи түрде дос болдық.
Dialogue: 0,0:07:56.65,0:07:58.95,Default,,0,0,0,,Әрине, біз дос болдық...
Dialogue: 0,0:07:59.26,0:08:02.92,*Default-ja,NTP,0,0,0,,Сол себепті сыныптастарым мені кейде мазақтайтын.
Dialogue: 0,0:07:59.29,0:08:03.84,Default,,0,0,0,,...соған байланысты сыныптастарымыз бізді мазақтайтын кездер болды. Бірақ...
Dialogue: 0,0:08:01.33,0:08:03.41,Default,,0,0,0,,Бұл екеуі әрқашан бірге.
Dialogue: 0,0:08:03.03,0:08:03.93,*Default-ja,NTP,0,0,0,,Бірақ...
Dialogue: 0,0:08:05.24,0:08:05.60,Default,,0,0,0,,Ой! Міне, ол!
Dialogue: 0,0:08:05.43,0:08:11.56,*Default-ja,NTP,0,0,0,,Бір қызығы, біз бірге болған кезде мұндай нәрселер соншалықты қорқынышты емес еді.
Dialogue: 0,0:08:05.64,0:08:10.72,Default,,0,0,0,,Екеуміз бірге болғанша, бір қызығы, мұндай нәрселер бізді қорқытпады.
Dialogue: 0,0:08:10.75,0:08:12.20,Default,,0,0,0,,Ой, қандай жақсы жігіт!
Dialogue: 0,0:08:12.25,0:08:13.29,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:08:16.01,0:08:18.70,*Default-ja,NTP,0,0,0,,Бір күні бәріміз бір орта мектепке барамыз.
Dialogue: 0,0:08:16.04,0:08:18.77,Default,,0,0,0,,Дегенмен, неге екені белгісіз, мен бір орта мектепте оқимыз деп ойладым...
Dialogue: 0,0:08:18.80,0:08:20.90,Default,,0,0,0,,...және біз сияқты бірге болыңыз ...
Dialogue: 0,0:08:18.81,0:08:21.01,*Default-ja,NTP,0,0,0,,Біз мәңгі бірге боламыз
Dialogue: 0,0:08:21.11,0:08:24.38,*Default-ja,NTP,0,0,0,,Неліктен? Мен солай ойладым.
Dialogue: 0,0:08:21.21,0:08:24.19,Default,,0,0,0,,...осы сәттен бастап.
Dialogue: 0,0:08:28.24,0:08:32.02,Default,,0,0,0,,Шиндзюку, Шиндзюку, соңғы аялдама. Жолаушылар үшін...
Dialogue: 0,0:08:28.49,0:08:31.15,*Default-ja,NTP,0,0,0,,Шиндзюку Синдзюку – соңғы аялдама.
Dialogue: 0,0:08:31.26,0:08:32.65,*Default-ja,NTP,0,0,0,,Сыйлық алатын тұтынушылар...
Dialogue: 0,0:08:34.73,0:08:38.35,*Default-ja,NTP,0,0,0,,JR желісі, Кейо желісі, метро үшін ауыстырыңыз...
Dialogue: 0,0:08:34.75,0:08:38.49,Default,,0,0,0,,...JR Line, Heiou Line, метро...
Dialogue: 0,0:08:41.77,0:08:44.86,*Default-ja,NTP,0,0,0,,Мен Синджуку станциясына бірінші рет жалғыз келдім.
Dialogue: 0,0:08:41.85,0:08:45.09,Default,,0,0,0,,Мен Шиндзюку станциясына бірінші рет жалғыз бардым...
Dialogue: 0,0:08:45.10,0:08:49.13,*Default-ja,NTP,0,0,0,,Мен жүремін деп жүрген маршруттардың бәрі мен үшін жаңа.
Dialogue: 0,0:08:45.13,0:08:49.24,Default,,0,0,0,,...жақында мен мінетін барлық жолдар да мен үшін алғашқылар болар еді.
Dialogue: 0,0:08:53.88,0:08:54.94,*Default-ja,NTP,0,0,0,,Иә...
Dialogue: 0,0:08:55.81,0:08:58.15,*Default-ja,NTP,0,0,0,,Менің жүрегім дүрсілдеп кетті
Dialogue: 0,0:08:55.94,0:08:57.93,Default,,0,0,0,,Жүрегім дүрсілдеп кетті.
Dialogue: 0,0:09:01.05,0:09:04.82,*Default-ja,NTP,0,0,0,,Енді мен Акаримен кездесуге барамын.
Dialogue: 0,0:09:01.15,0:09:04.39,Default,,0,0,0,,Мен Акариді тағы көретін болдым.
Dialogue: 0,0:09:10.63,0:09:12.56,*Default-ja,NTP,0,0,0,,Бала соңғы рет қалай болды?
Dialogue: 0,0:09:10.72,0:09:12.70,Default,,0,0,0,,Ол жігітпен қалай болды?
Dialogue: 0,0:09:12.66,0:09:13.53,*Default-ja,NTP,0,0,0,,Who?
Dialogue: 0,0:09:12.74,0:09:13.49,Default,,0,0,0,,Кім?
Dialogue: 0,0:09:13.63,0:09:14.66,*Default-ja,NTP,0,0,0,,Қараңыз, Western Commercial!
Dialogue: 0,0:09:13.66,0:09:15.12,Default,,0,0,0,,Білесің бе, Нисшоу баласы.
Dialogue: 0,0:09:14.77,0:09:16.10,*Default-ja,NTP,0,0,0,,Иә? Оның дәмі нашар емес пе?
Dialogue: 0,0:09:15.16,0:09:16.10,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба? Оның талғамы сәл дөрекі болды...
Dialogue: 0,0:09:16.14,0:09:20.11,Default,,0,0,0,,Жақында Мусаши-Ураваға жетеміз. Тағы да, бұл Мусаши-Урава.
Dialogue: 0,0:09:20.23,0:09:23.02,Default,,0,0,0,,Біздің келесі аялдамада, Мусаши-Урава, жедел пойызға қосылу үшін...
Dialogue: 0,0:09:23.01,0:09:27.71,*Default-ja,NTP,0,0,0,,...Жылдам пойыз Бұл пойыз кездесуге 4 минуттай тоқтайды.
Dialogue: 0,0:09:23.05,0:09:27.33,Default,,0,0,0,,Жедел пойызға қосылу үшін бұл пойыз 4 минут тоқтайды.
Dialogue: 0,0:09:27.75,0:09:31.27,Default,,0,0,0,,Йонохонмачи мен Оомияға тез жетуді қалайтын жолаушылар мініңіз...
Dialogue: 0,0:09:27.81,0:09:31.54,*Default-ja,NTP,0,0,0,,Йонохонмачи Омияға жетуге асығып жатсаңыз, ол көшенің арғы жағында...
Dialogue: 0,0:09:53.44,0:09:56.27,*Default-ja,NTP,0,0,0,,Мм...менің атым Шинохара.
Dialogue: 0,0:09:53.53,0:09:56.32,Default,,0,0,0,,Мм... бұл Шинохара.
Dialogue: 0,0:09:56.64,0:09:59.54,*Default-ja,NTP,0,0,0,,Бұл Такаки-кун сонда ма?
Dialogue: 0,0:09:56.69,0:09:59.57,Default,,0,0,0,,Умм, Такаки-кун сонда ма?
Dialogue: 0,0:10:00.24,0:10:01.47,*Default-ja,NTP,0,0,0,,Акари-чан
Dialogue: 0,0:10:00.41,0:10:01.54,Default,,0,0,0,,Бұл Акари-чан.
Dialogue: 0,0:10:02.88,0:10:05.28,*Default-ja,NTP,0,0,0,,Е...тасымалдау?
Dialogue: 0,0:10:03.07,0:10:05.08,Default,,0,0,0,,Иә? Сіз мектептерді ауыстырып жатырсыз ба?
Dialogue: 0,0:10:06.28,0:10:10.12,*Default-ja,NTP,0,0,0,,Нишинака ше? Емтихан тапсырсам да
Dialogue: 0,0:10:06.30,0:10:10.12,Default,,0,0,0,,Ниши орта мектебі туралы не деуге болады? Қабылдау үшін сіз барлық қиындықтан өттіңіз.
Dialogue: 0,0:10:10.66,0:10:14.22,*Default-ja,NTP,0,0,0,,Точиги мемлекеттік кеңсесіне өтініш беру...
Dialogue: 0,0:10:10.90,0:10:14.62,Default,,0,0,0,,Олар мені Точигидегі мемлекеттік мектепке ауыстыру құжаттарын реттейтіндерін айтты...
Dialogue: 0,0:10:14.36,0:10:15.88,*Default-ja,NTP,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:14.63,0:10:15.45,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:10:16.43,0:10:19.52,*Default-ja,NTP,0,0,0,,Жоқ... Акари кешірім сұрамауы керек.
Dialogue: 0,0:10:16.62,0:10:19.51,Default,,0,0,0,,Жоқ... кешірім сұрауға негіз жоқ.
Dialogue: 0,0:10:19.63,0:10:23.09,*Default-ja,NTP,0,0,0,,Кацушикадағы тәтем мектепке келгісі келетінін айтты.
Dialogue: 0,0:10:19.64,0:10:23.14,Default,,0,0,0,,Мен оларға әлі де Кацушикадағы тәтемнің үйінен кеткім келетінін айттым, бірақ...
Dialogue: 0,0:10:23.41,0:10:27.03,Default,,0,0,0,,...қартайғанша алмаймын деді.
Dialogue: 0,0:10:23.47,0:10:27.27,*Default-ja,NTP,0,0,0,,Ол қартаймайынша жұмыс істемейді...
Dialogue: 0,0:10:28.54,0:10:29.47,*Default-ja,NTP,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:10:28.57,0:10:30.66,Default,,0,0,0,,Түсіндім... басқа ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:10:29.57,0:10:30.60,*Default-ja,NTP,0,0,0,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:10:31.18,0:10:32.57,*Default-ja,NTP,0,0,0,,Жетеді
Dialogue: 0,0:10:31.34,0:10:32.44,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:10:35.58,0:10:36.98,*Default-ja,NTP,0,0,0,,Кешіріңіз...
Dialogue: 0,0:10:35.79,0:10:36.99,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:10:38.38,0:10:41.65,*Default-ja,NTP,0,0,0,,Ресивер арқылы мен оны қатты басқаным сонша, құлағым ауырды.
Dialogue: 0,0:10:38.57,0:10:41.70,Default,,0,0,0,,Ресивер арқылы құлағыма қатты басылды...
Dialogue: 0,0:10:42.05,0:10:46.25,*Default-ja,NTP,0,0,0,,Мен Акаридің жараланғанын айта аламын, бірақ...
Dialogue: 0,0:10:42.09,0:10:45.41,Default,,0,0,0,,...Акаридің өз ауыруы сезілді.
Dialogue: 0,0:10:45.60,0:10:48.34,Default,,0,0,0,,Бірақ... қолымнан ештеңе келмеді.
Dialogue: 0,0:10:46.96,0:10:49.09,*Default-ja,NTP,0,0,0,,Мен ештеңе істей алмадым
Dialogue: 0,0:10:55.01,0:10:56.22,Default,,0,0,0,,Бұл өте жақсы болды, иә?
Dialogue: 0,0:10:56.25,0:10:57.17,Default,,0,0,0,,Иә. Кейінірек кездесеміз!
Dialogue: 0,0:10:57.03,0:11:01.47,*Default-ja,NTP,0,0,0,,Тасымалдауға арналған терминал станциясы үйлеріне жол бастаған адамдарға лық толы болды.
Dialogue: 0,0:10:57.21,0:11:01.51,Default,,0,0,0,,Мен ауыстырған терминал үйге бара жатқан адамдарға толы болды...
Dialogue: 0,0:11:01.57,0:11:04.63,*Default-ja,NTP,0,0,0,,Барлығының аяқ киімдері қардан дымқыл болды.
Dialogue: 0,0:11:01.75,0:11:05.01,Default,,0,0,0,,...ал барлығының аяқ киімдері қардан сіңіп қалыпты.
Dialogue: 0,0:11:05.11,0:11:06.10,*Default-ja,NTP,0,0,0,,Ауа
Dialogue: 0,0:11:05.25,0:11:10.18,Default,,0,0,0,,Суық ауа қарлы қала күнінің классикалық иісіне қаныққан.
Dialogue: 0,0:11:06.21,0:11:10.01,*Default-ja,NTP,0,0,0,,Қарлы күні қала салқын, ерекше иіске бөленді.
Dialogue: 0,0:11:10.38,0:11:12.54,*Default-ja,NTP,0,0,0,,Біз сізге хабарлаймыз
Dialogue: 0,0:11:10.55,0:11:12.34,Default,,0,0,0,,Барлық жолаушылар назар аударыңыз.
Dialogue: 0,0:11:12.65,0:11:15.92,*Default-ja,NTP,0,0,0,,Уцуномия линиясы Ояма пойызы Уцуномияға барады
Dialogue: 0,0:11:12.71,0:11:16.16,Default,,0,0,0,,Қарлы ауа райы жағдайына байланысты Уцуномия линиясы Оомия мен Уцуномияға қатынайтын пойыздар...
Dialogue: 0,0:11:16.02,0:11:19.18,*Default-ja,NTP,0,0,0,,Қарға байланысты біздің келуіміз шамамен 8 минутқа кешіктіріледі.
Dialogue: 0,0:11:16.19,0:11:19.35,Default,,0,0,0,,...келуде 8 минуттық кешігу болады.
Dialogue: 0,0:11:19.36,0:11:22.29,*Default-ja,NTP,0,0,0,,Тұтынушыларымызға келтірілген қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:11:19.39,0:11:22.38,Default,,0,0,0,,Қарбалас күніңізде орын алған қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:11:22.39,0:11:26.42,*Default-ja,NTP,0,0,0,,Осы уақытқа дейін мен пойыздың кешігіп қалу мүмкіндігін ешқашан ойлаған емеспін.
Dialogue: 0,0:11:22.42,0:11:28.41,Default,,0,0,0,,Осы уақытқа дейін мен пойыздарымның бірінің кешігіп қалу мүмкіндігін ойлаған да емеспін.
Dialogue: 0,0:11:26.53,0:11:28.50,*Default-ja,NTP,0,0,0,,ойыма да келмеген
Dialogue: 0,0:11:28.60,0:11:31.97,*Default-ja,NTP,0,0,0,,Мазасыздық кенет күшейді
Dialogue: 0,0:11:28.74,0:11:31.96,Default,,0,0,0,,Менің мазасыздануым кенет күшейе түсті.
Dialogue: 0,0:11:36.14,0:11:40.98,*Default-ja,NTP,0,0,0,,Бұл пойыз қазір қарға байланысты шамамен 10 минутқа кешігіп жүр.
Dialogue: 0,0:11:36.27,0:11:41.04,Default,,0,0,0,,Қазіргі уақытта бұл пойыз қарлы ауа райы жағдайына байланысты 10 минутқа кешігіп жүр.
Dialogue: 0,0:11:41.15,0:11:44.64,*Default-ja,NTP,0,0,0,,Пойызыңыздың кешігуі үшін кешірім сұраймыз.
Dialogue: 0,0:11:41.19,0:11:44.55,Default,,0,0,0,,Қарбалас күніңізде орын алған қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:11:47.39,0:11:50.68,*Default-ja,NTP,0,0,0,,Біраз уақыттан кейін Омия станциясынан өткеннен кейін
Dialogue: 0,0:11:47.64,0:11:50.22,Default,,0,0,0,,Оомия станциясынан сәл өткен соң...
Dialogue: 0,0:11:50.46,0:11:53.89,Default,,0,0,0,,...өтіп жатқан ғимараттардың барлығы дерлік кенет көзден ғайып болды.
Dialogue: 0,0:11:50.79,0:11:54.85,*Default-ja,NTP,0,0,0,,Ғимараттар ландшафттан тез жоғалып кетті.
Dialogue: 0,0:12:05.97,0:12:08.58,Default,,0,0,0,,Келесі аялдама – Куки. Куки.
Dialogue: 0,0:12:06.00,0:12:08.67,*Default-ja,NTP,0,0,0,,Келесіде Куки Куки
Dialogue: 0,0:12:10.11,0:12:13.60,*Default-ja,NTP,0,0,0,,Өте кеш келгеніміз үшін кешірім сұраймыз.
Dialogue: 0,0:12:10.24,0:12:13.54,Default,,0,0,0,,Өте кеш келгеніміз үшін кешірім сұраймыз.
Dialogue: 0,0:12:14.45,0:12:19.01,*Default-ja,NTP,0,0,0,,Егер сіз Tobu Isesaki желісіне ауыстырып жатсаңыз, 5-шығысқа өтіңіз.
Dialogue: 0,0:12:14.57,0:12:18.39,Default,,0,0,0,,Тобу Исесаки желісіне ауысатын жолаушылар №5 шығысқа қарай жүріңіз.
Dialogue: 0,0:12:20.72,0:12:22.52,*Default-ja,NTP,0,0,0,,Себебі келесі пойыз кешігіп жатыр
Dialogue: 0,0:12:20.83,0:12:25.91,Default,,0,0,0,,Келесі пойыздың кешігуіне байланысты бұл пойыз келесі 10 минутқа осы станцияда тоқтайды.
Dialogue: 0,0:12:22.62,0:12:26.02,*Default-ja,NTP,0,0,0,,Бұл пойыз келу станциясында шамамен 10 минут тоқтайды.
Dialogue: 0,0:12:26.39,0:12:28.98,*Default-ja,NTP,0,0,0,,Қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:12:26.67,0:12:32.20,Default,,0,0,0,,Қарбалас күніңізде орын алған қолайсыздықтар үшін кешірім сұраймыз және түсіністікпен қарағаныңызға алғысымызды білдіреміз.
Dialogue: 0,0:12:29.09,0:12:32.49,*Default-ja,NTP,0,0,0,,Шыдамдылығыңыз үшін рахмет.
Dialogue: 0,0:12:34.30,0:12:35.46,*Default-ja,NTP,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:34.55,0:12:35.48,Default,,0,0,0,,Бұл үшін кешіріңіз.
Dialogue: 0,0:12:35.57,0:12:37.23,*Default-ja,NTP,0,0,0,,Себебі келесі пойыз кешікті
Dialogue: 0,0:12:35.62,0:12:40.65,Default,,0,0,0,,Келесі пойыздың кешігуіне байланысты бұл пойыз келесі 10 минутқа осы станцияда тоқтайды.
Dialogue: 0,0:12:37.33,0:12:40.70,*Default-ja,NTP,0,0,0,,Бұл пойыз келу станциясында шамамен 10 минут тоқтайды.
Dialogue: 0,0:12:41.09,0:12:44.84,Default,,0,0,0,,Қарбалас күніңізде орын алған қолайсыздықтар үшін кешірім сұраймыз және...
Dialogue: 0,0:12:41.11,0:12:43.90,*Default-ja,NTP,0,0,0,,Қолайсыздық үшін кешірім сұраймыз, бірақ...
Dialogue: 0,0:13:06.76,0:13:09.23,*Default-ja,NTP,0,0,0,,Ноги Ноги
Dialogue: 0,0:13:06.92,0:13:08.56,Default,,0,0,0,,Бұл Ноги. Ноги.
Dialogue: 0,0:13:09.43,0:13:12.13,*Default-ja,NTP,0,0,0,,Біз бас тартамыз және тұтынушыларымыздан кешірім сұраймыз.
Dialogue: 0,0:13:09.54,0:13:12.18,Default,,0,0,0,,Барлық жолаушылардан терең кешірім сұраймыз.
Dialogue: 0,0:13:12.22,0:13:16.61,Default,,0,0,0,,Келесі пойыздың кешігуіне байланысты бұл пойыз осы станцияда ұзақ уақыт тоқтайды.
Dialogue: 0,0:13:12.24,0:13:16.54,*Default-ja,NTP,0,0,0,,Келесі пойыздың кешігуіне байланысты бұл пойыз осы станцияда біраз уақыт тоқтайды.
Dialogue: 0,0:13:16.64,0:13:17.73,*Default-ja,NTP,0,0,0,,Қолайсыздық үшін кешірім сұраймыз...
Dialogue: 0,0:13:16.64,0:13:22.13,Default,,0,0,0,,Қарбалас күніңізде орын алған қолайсыздықтар үшін кешірім сұраймыз және түсіністікпен қарағаныңызға алғысымызды білдіреміз.
Dialogue: 0,0:13:17.84,0:13:22.18,*Default-ja,NTP,0,0,0,,Станциялар арасындағы қашықтық адам сенгісіз.
Dialogue: 0,0:13:22.28,0:13:27.48,*Default-ja,NTP,0,0,0,,Пойыз әр аялдамада керемет ұзақ тоқтады.
Dialogue: 0,0:13:22.39,0:13:27.32,Default,,0,0,0,,...және пойыз әр станцияда өте ұзақ уақыт тоқтайтын.
Dialogue: 0,0:13:27.61,0:13:31.83,Default,,0,0,0,,Курихаши > Кога > Ноги > Мамада > Ояма
Dialogue: 0,0:13:31.87,0:13:37.04,Default,,0,0,0,,Омоигава > Точиги > Охирашита > Ивафунэ > Сано
Dialogue: 0,0:13:48.11,0:13:52.41,*Default-ja,NTP,0,0,0,,Терезенің сыртында мен бұрын-соңды көрмеген қар жауып, шөл дала.
Dialogue: 0,0:13:48.21,0:13:52.58,Default,,0,0,0,,Терезенің ар жағындағы шөл дала мен бұрын-соңды бастан кешірмегендей көрінді.
Dialogue: 0,0:13:52.51,0:13:56.88,*Default-ja,NTP,0,0,0,,Уақыт баяу өтіп, азапты аштық
Dialogue: 0,0:13:52.64,0:13:54.81,Default,,0,0,0,,Баяу жылжу уақыты...
Dialogue: 0,0:13:54.89,0:13:56.72,Default,,0,0,0,,...және менің аштық азабым...
Dialogue: 0,0:13:56.98,0:14:00.01,*Default-ja,NTP,0,0,0,,Бұл мені одан сайын алаңдатты.
Dialogue: 0,0:13:57.07,0:13:59.77,Default,,0,0,0,,...менің көңіл-күйімді түсіре берді.
Dialogue: 0,0:14:01.79,0:14:03.98,*Default-ja,NTP,0,0,0,,Белгіленген уақыттан кейін
Dialogue: 0,0:14:02.12,0:14:04.13,Default,,0,0,0,,Біз кездесуді жоспарлаған уақыт өтіп кетті...
Dialogue: 0,0:14:04.09,0:14:08.62,*Default-ja,NTP,0,0,0,,Менің ойымша, Акари қазір қобалжи бастаған шығар.
Dialogue: 0,0:14:04.20,0:14:08.25,Default,,0,0,0,,...сондықтан менде Акари алаңдай бастағандай болды.
Dialogue: 0,0:14:13.00,0:14:16.40,*Default-ja,NTP,0,0,0,,Сол күні...сол телефон соғылған күн.
Dialogue: 0,0:14:13.01,0:14:14.24,Default,,0,0,0,,Сол күні...
Dialogue: 0,0:14:14.80,0:14:16.51,Default,,0,0,0,,...ол қоңырау шалған күні...
Dialogue: 0,0:14:16.63,0:14:20.47,*Default-ja,NTP,0,0,0,,Маған қарағанда көбірек уайымдайтын Акари үшін.
Dialogue: 0,0:14:16.76,0:14:24.33,Default,,0,0,0,,...Акари маған қарағанда әлдеқайда ашулы және ренжіген болуы керек, бірақ мен оны жұбатуға сөз таба алмадым.
Dialogue: 0,0:14:20.57,0:14:24.13,*Default-ja,NTP,0,0,0,,Жылы сөз айта алмадым.
Dialogue: 0,0:14:24.31,0:14:27.21,*Default-ja,NTP,0,0,0,,Мен қатты ұялдым.
Dialogue: 0,0:14:24.36,0:14:26.46,Default,,0,0,0,,Мен өзімнен қатты ұялдым.
Dialogue: 0,0:14:27.37,0:14:37.67,Default,,0,0,0,,Өткенге көз жүгіртсек, ұстаздарымызға жасаған барлық істері үшін алғыс айтамыз.
Dialogue: 0,0:14:28.08,0:14:32.41,*Default-ja,NTP,0,0,0,,If you raise it, it will be honored...
Dialogue: 0,0:14:33.92,0:14:34.98,*Default-ja,NTP,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:14:35.25,0:14:37.85,*Default-ja,NTP,0,0,0,,...
Dialogue: 0,0:14:37.70,0:14:37.88,Default,,0,0,0,,Олай болса бүгіннен кейін... бұл қоштасу.
Dialogue: 0,0:14:38.78,0:14:40.44,Default,,0,0,0,,Жазғы демалыс жоспарлары бар ма?
Dialogue: 0,0:14:40.39,0:14:44.35,*Default-ja,NTP,0,0,0,,Ақалидың бірінші хаты алты айдан кейін келді.
Dialogue: 0,0:14:40.46,0:14:44.38,Default,,0,0,0,,Мен Акариден бірінші хатты жарты жылдан кейін алдым...
Dialogue: 0,0:14:44.76,0:14:46.82,*Default-ja,NTP,0,0,0,,Бұл менің орта мектептің бірінші жылының жазы болатын.
Dialogue: 0,0:14:44.78,0:14:47.06,Default,,0,0,0,,...орта мектептің бірінші жылының жазында.
Dialogue: 0,0:14:47.42,0:14:51.29,Default,,0,0,0,,Оның әрбір соңғы сөзі есімде.
Dialogue: 0,0:14:47.43,0:14:51.27,*Default-ja,NTP,0,0,0,,...
Dialogue: 0,0:14:51.61,0:14:53.94,Default,,0,0,0,,Біз кездесуге екі апта қалғанда...
Dialogue: 0,0:14:51.77,0:14:53.90,*Default-ja,NTP,0,0,0,,Уәде етілген күнге дейін екі апта өтті
Dialogue: 0,0:14:54.69,0:14:57.79,Default,,0,0,0,,...Мен оған беретін хатты жазумен уақытымды өткіздім.
Dialogue: 0,0:14:54.71,0:14:57.73,*Default-ja,NTP,0,0,0,,Мен Акариге беру үшін хат жаздым.
Dialogue: 0,0:14:58.13,0:15:00.47,Default,,0,0,0,,Ол мен оған айта алатын барлық нәрселерге толы болды.
Dialogue: 0,0:14:58.14,0:15:01.74,*Default-ja,NTP,0,0,0,,Мен Акариге не айтуым керек Мен оның естігенін қалаймын
Dialogue: 0,0:15:00.51,0:15:01.77,Default,,0,0,0,,Мен оның естігенін қалаймын.
Dialogue: 0,0:15:02.04,0:15:04.95,Default,,0,0,0,,Көп болды.
Dialogue: 0,0:15:02.08,0:15:04.88,*Default-ja,NTP,0,0,0,,I really had a lot.
Dialogue: 0,0:15:04.98,0:15:09.51,*Default-ja,NTP,0,0,0,,Сізді күткенім үшін кешіріңіз. Жақында пойыз Уцуномияға жол тартады.
Dialogue: 0,0:15:05.02,0:15:06.86,Default,,0,0,0,,Күткеніміз үшін кешірім сұраймыз.
Dialogue: 0,0:15:06.90,0:15:09.54,Default,,0,0,0,,Бұл пойыз жақында Уцуномияға қарай жол тартады.
Dialogue: 0,0:15:22.47,0:15:24.34,Default,,0,0,0,,Бұл Ояма. Ойама.
Dialogue: 0,0:15:22.47,0:15:24.37,*Default-ja,NTP,0,0,0,,Кояма Кояма
Dialogue: 0,0:15:24.36,0:15:27.30,Default,,0,0,0,,Тохоку оқ-дәрі пойызына ауысатын жолаушылар үшін осы жерге ауысыңыз.
Dialogue: 0,0:15:24.47,0:15:27.27,*Default-ja,NTP,0,0,0,,Тохоку Шинкансенді пайдалансаңыз, осы жерден өзгертіңіз.
Dialogue: 0,0:15:28.57,0:15:32.89,Default,,0,0,0,,Мориокаға қарай жүретін Тохоку Bullet пойызы төмен пойызға ауысатын жолаушылар 1-жолға ауысуларыңызды сұраймыз.
Dialogue: 0,0:15:28.71,0:15:32.84,*Default-ja,NTP,0,0,0,,Тохоку Синкансеннен Мориокаға ауысатын болсаңыз, 1-платформаны алыңыз.
Dialogue: 0,0:15:33.18,0:15:37.50,Default,,0,0,0,,Токиоға баратын пойызға ауысатын жолаушылар 5-жолға ауысуларыңызды сұраймыз.
Dialogue: 0,0:15:33.21,0:15:37.67,*Default-ja,NTP,0,0,0,,Егер сіз Токиоға келетін кіріс тасымалдайтын болсаңыз, 5-платформаға өтіңіз.
Dialogue: 0,0:15:37.61,0:15:40.57,Default,,0,0,0,,Mito Line-ге ауысатын жолаушылар
Dialogue: 0,0:15:38.58,0:15:40.88,*Default-ja,NTP,0,0,0,,...
Dialogue: 0,0:15:40.92,0:15:46.34,Default,,0,0,0,,Қарлы ауа райы жағдайына байланысты Ryomo Line қазір айтарлықтай кешігуді бастан кешіруде.
Dialogue: 0,0:15:40.99,0:15:46.39,*Default-ja,NTP,0,0,0,,Қазіргі уақытта Ryomo Line қарға байланысты айтарлықтай кідірістермен жұмыс істейді.
Dialogue: 0,0:15:46.79,0:15:49.99,*Default-ja,NTP,0,0,0,,Тұтынушыларымызға келтірілген қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:15:46.85,0:15:50.11,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:15:50.49,0:15:53.95,*Default-ja,NTP,0,0,0,,Пойыз келгенше біраз күтіңіз.
Dialogue: 0,0:15:50.49,0:15:54.49,Default,,0,0,0,,Пойыз келгенше шыдамдылық танытып, сәл күтуіңізді сұраймыз.
Dialogue: 0,0:15:54.68,0:15:57.75,Default,,0,0,0,,Келесі пойыз
Dialogue: 0,0:15:55.60,0:15:57.62,*Default-ja,NTP,0,0,0,,Қалай болғанда да
Dialogue: 0,0:15:57.74,0:16:01.73,*Default-ja,NTP,0,0,0,,Менің Акари күтіп тұрған станцияға барудан басқа амалым қалмады.
Dialogue: 0,0:15:57.75,0:16:01.34,Default,,0,0,0,,...Акари күтіп тұрған вокзалға қарай жүре беруден басқа амалым қалмады.
Dialogue: 0,0:16:55.46,0:17:00.60,Default,,0,0,0,,Бұл жолда Ашикага мен Маэбашиден өтіп бара жатқан Такасакиге қарай жүретін 8-жол.
Dialogue: 0,0:16:55.53,0:17:00.52,*Default-ja,NTP,0,0,0,,8-платформа Ашикага. Маэбаши бағытында Такасакиге қатынайтын пойыз бар.
Dialogue: 0,0:17:00.63,0:17:03.96,*Default-ja,NTP,0,0,0,,Ақ жолдың ішіне өтіңіз...
Dialogue: 0,0:17:00.71,0:17:02.80,Default,,0,0,0,,Ақ жолдың артында тұрыңыз.
Dialogue: 0,0:17:34.51,0:17:36.73,Default,,0,0,0,,Барлық жолаушылар, назар аударыңыз.
Dialogue: 0,0:17:34.53,0:17:36.73,*Default-ja,NTP,0,0,0,,Біз тұтынушыларға хабарлаймыз
Dialogue: 0,0:17:36.83,0:17:41.60,*Default-ja,NTP,0,0,0,,Қар жаууына байланысты кестенің бұзылуына байланысты біз қысқа аялдама жасаймыз.
Dialogue: 0,0:17:36.96,0:17:41.74,Default,,0,0,0,,Қалың жауған қардан кестенің бұзылуына байланысты бұл пойыз уақытша тоқтайды.
Dialogue: 0,0:17:41.71,0:17:44.04,*Default-ja,NTP,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:17:41.91,0:17:44.20,Default,,0,0,0,,Қарбалас күніңізде орын алған қолайсыздық үшін кешірім сұраймыз...
Dialogue: 0,0:17:44.14,0:17:46.74,*Default-ja,NTP,0,0,0,,Қазіргі уақытта қалпына келтіру перспективасы жоқ.
Dialogue: 0,0:17:44.22,0:17:46.78,Default,,0,0,0,,...бірақ қазіргі уақытта қалыпты қызметті қалпына келтіре алмаймыз.
Dialogue: 0,0:17:47.28,0:17:48.90,*Default-ja,NTP,0,0,0,,Қайталаңыз
Dialogue: 0,0:17:47.63,0:17:48.79,Default,,0,0,0,,Қайталап айтамын...
Dialogue: 0,0:17:49.01,0:17:53.61,*Default-ja,NTP,0,0,0,,Қар жаууына байланысты кестенің бұзылуына байланысты біз қысқа аялдама жасаймыз.
Dialogue: 0,0:17:53.78,0:17:55.78,*Default-ja,NTP,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:17:55.99,0:17:59.44,*Default-ja,NTP,0,0,0,,Қазіргі уақытта қалпына келтіру перспективасы жоқ.
Dialogue: 0,0:18:03.14,0:18:03.96,Default,,0,0,0,,«Құрметті Такаки-кун...»
Dialogue: 0,0:18:03.16,0:18:06.03,*Default-ja,NTP,0,0,0,,Такаки-кун, жағдайың қалай?
Dialogue: 0,0:18:03.99,0:18:05.53,Default,,0,0,0,,«Қалайсың?»
Dialogue: 0,0:18:06.52,0:18:10.74,Default,,0,0,0,,«Мен бұл хатты пойызда жазып отырмын, өйткені соңғы уақытта жаттығу өте ерте басталды».
Dialogue: 0,0:18:06.56,0:18:10.76,*Default-ja,NTP,0,0,0,,Мен бұл хатты пойызда жазып отырмын, себебі үйірме жұмыстарына байланысты таңертең ерте шықтым.
Dialogue: 0,0:18:10.82,0:18:13.18,Default,,0,0,0,,Мен Акариді оның хаттарынан суреттеуге тырысқан сайын...
Dialogue: 0,0:18:10.87,0:18:16.24,*Default-ja,NTP,0,0,0,,Неге екені белгісіз, хаттан елестеткен Акари үнемі жалғыз болатын.
Dialogue: 0,0:18:13.21,0:18:16.28,Default,,0,0,0,,...ол қандай да бір себептермен үнемі жалғыз болатын.
Dialogue: 0,0:18:19.77,0:18:26.31,Default,,0,0,0,,Соңында пойыз екі сағат бойы тақыр далада тоқтап қалды.
Dialogue: 0,0:18:19.88,0:18:22.11,*Default-ja,NTP,0,0,0,,Пойыз...
Dialogue: 0,0:18:22.31,0:18:26.04,*Default-ja,NTP,0,0,0,,Біз екі сағат бойы бос далаға тоқтадық.
Dialogue: 0,0:18:26.82,0:18:29.80,Default,,0,0,0,,Әр минут мәңгіліктей сезілді.
Dialogue: 0,0:18:26.88,0:18:30.22,*Default-ja,NTP,0,0,0,,Бір минут өте ұзақ.
Dialogue: 0,0:18:29.83,0:18:32.78,Default,,0,0,0,,Маған деген өшпенділікпен...
Dialogue: 0,0:18:30.32,0:18:33.26,*Default-ja,NTP,0,0,0,,Уақыттың анық зұлымдығы бар
Dialogue: 0,0:18:33.19,0:18:36.30,Default,,0,0,0,,...уақыт менің айналамда баяу алға жылжи берді.
Dialogue: 0,0:18:33.36,0:18:36.66,*Default-ja,NTP,0,0,0,,Мен жоғарыдан жайлап ағып кеттім
Dialogue: 0,0:18:37.11,0:18:39.50,Default,,0,0,0,,Мен тісімді бір-біріне қатты қыстым...
Dialogue: 0,0:18:37.16,0:18:39.76,*Default-ja,NTP,0,0,0,,Мен тісімді қатты қысамын
Dialogue: 0,0:18:39.86,0:18:44.86,*Default-ja,NTP,0,0,0,,Тек жыламауға тырыстым.
Dialogue: 0,0:18:39.90,0:18:44.32,Default,,0,0,0,,...және азапқа шыдап, көз жасымды ұстаудан басқа ештеңе істей алмады.
Dialogue: 0,0:18:46.18,0:18:47.31,Default,,0,0,0,,Акари...
Dialogue: 0,0:18:46.24,0:18:47.73,*Default-ja,NTP,0,0,0,,Акали...
Dialogue: 0,0:18:48.62,0:18:49.50,Default,,0,0,0,,Айтыңызшы...
Dialogue: 0,0:18:48.67,0:18:50.83,*Default-ja,NTP,0,0,0,,Өтінемін... енді жоқ...
Dialogue: 0,0:18:49.87,0:18:51.67,Default,,0,0,0,,...сіз бұрыннан...
Dialogue: 0,0:18:51.01,0:18:52.13,*Default-ja,NTP,0,0,0,,Үйде...
Dialogue: 0,0:18:54.40,0:18:56.80,Default,,0,0,0,,...үйге оралды.
Dialogue: 0,0:18:54.41,0:18:57.68,*Default-ja,NTP,0,0,0,,Қайтып келгеніңізді қалаймын...
Dialogue: 0,0:19:11.11,0:19:16.07,Default,,0,0,0,,Такасакиге қарай 3-ші жол, жолда Ашикага мен Маэбашиден өтіп, жақында ғана келді.
Dialogue: 0,0:19:11.13,0:19:16.12,*Default-ja,NTP,0,0,0,,3-платформа Ашикага. Маэбаши мен Такасакиге бара жатқан пойыз келеді.
Dialogue: 0,0:19:18.23,0:19:21.59,Default,,0,0,0,,Қарлы ауа райы жағдайына байланысты бұл пойыз уақытша тоқтайды.
Dialogue: 0,0:19:18.30,0:19:21.53,*Default-ja,NTP,0,0,0,,Бұл пойыз қарға байланысты біраз уақыт тоқтайды.
Dialogue: 0,0:19:41.89,0:19:42.59,*Default-ja,NTP,0,0,0,,Әй
Dialogue: 0,0:19:45.83,0:19:47.16,*Default-ja,NTP,0,0,0,,U...
Dialogue: 0,0:19:58.58,0:19:59.88,Default,,0,0,0,,Акари...
Dialogue: 0,0:19:58.68,0:20:00.17,*Default-ja,NTP,0,0,0,,Акали
Dialogue: 0,0:20:29.54,0:20:31.01,*Default-ja,NTP,0,0,0,,Дәмді
Dialogue: 0,0:20:29.65,0:20:31.02,Default,,0,0,0,,Дәмі жақсы.
Dialogue: 0,0:20:31.64,0:20:34.11,*Default-ja,NTP,0,0,0,,Иә? Бұл қалыпты қожа
Dialogue: 0,0:20:31.74,0:20:32.45,Default,,0,0,0,,Мен бір қолымда оқ жалғанған винтовка ұстап тұрмын
Dialogue: 0,0:20:32.61,0:20:34.27,Default,,0,0,0,,Бұл жай ғана ыстық қуырылған шай.
Dialogue: 0,0:20:34.21,0:20:37.11,*Default-ja,NTP,0,0,0,,Ходжича? Мен оны бірінші рет іштім
Dialogue: 0,0:20:34.31,0:20:35.52,Default,,0,0,0,,Қуырылған шай?
Dialogue: 0,0:20:36.06,0:20:37.14,Default,,0,0,0,,Мен оны бірінші рет көріп тұрмын...
Dialogue: 0,0:20:37.18,0:20:39.66,Default,,0,0,0,,Сіз қалжыңдап тұрсыз. Бұған дейін сізде болғанына сенімдімін.
Dialogue: 0,0:20:37.21,0:20:39.58,*Default-ja,NTP,0,0,0,,Өтірік Мен оны міндетті түрде іштім!
Dialogue: 0,0:20:39.68,0:20:40.45,*Default-ja,NTP,0,0,0,,Солай ма?
Dialogue: 0,0:20:39.79,0:20:40.63,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:20:40.55,0:20:41.92,*Default-ja,NTP,0,0,0,,Дұрыс!
Dialogue: 0,0:20:40.65,0:20:41.73,Default,,0,0,0,,Сізде болуы керек.
Dialogue: 0,0:20:42.59,0:20:48.05,*Default-ja,NTP,0,0,0,,Ал мынау... Дәміне кепілдік бере алмайтындай етіп жасадым.
Dialogue: 0,0:20:42.63,0:20:48.16,Default,,0,0,0,,Және... мен мұны жасағандықтан, оның қаншалықты дәмді болатынына кепілдік бере алмаймын, бірақ...
Dialogue: 0,0:20:48.33,0:20:50.12,*Default-ja,NTP,0,0,0,,Қаласаң же.
Dialogue: 0,0:20:48.41,0:20:50.29,Default,,0,0,0,,Қаласаңыз, алыңыз.
Dialogue: 0,0:20:50.23,0:20:51.69,*Default-ja,NTP,0,0,0,,Рахмет
Dialogue: 0,0:20:50.41,0:20:51.84,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:20:52.86,0:20:54.88,Default,,0,0,0,,Менің қарным қатты ашты.
Dialogue: 0,0:20:52.86,0:20:55.46,*Default-ja,NTP,0,0,0,,Менің қарным қатты ашты.
Dialogue: 0,0:20:58.79,0:20:59.64,Default,,0,0,0,,Бұл қалай?
Dialogue: 0,0:20:58.80,0:20:59.60,*Default-ja,NTP,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:03.97,0:21:07.14,*Default-ja,NTP,0,0,0,,Мен жеген ең жақсы нәрсе
Dialogue: 0,0:21:04.05,0:21:07.09,Default,,0,0,0,,Бұл мен көрген ең дәмді күріш шары.
Dialogue: 0,0:21:07.24,0:21:08.51,*Default-ja,NTP,0,0,0,,Бұл асыра сілтеу.
Dialogue: 0,0:21:07.32,0:21:08.66,Default,,0,0,0,,Сіз асыра айтып отырсыз!
Dialogue: 0,0:21:08.61,0:21:09.58,*Default-ja,NTP,0,0,0,,Ой…
Dialogue: 0,0:21:08.69,0:21:09.43,Default,,0,0,0,,Бұл шынымен де!
Dialogue: 0,0:21:09.66,0:21:11.55,Default,,0,0,0,,Бұл сіздің аш болғаныңыз үшін шығар.
Dialogue: 0,0:21:09.68,0:21:11.38,*Default-ja,NTP,0,0,0,,Оның аш болғанына сенімдімін.
Dialogue: 0,0:21:11.48,0:21:12.54,*Default-ja,NTP,0,0,0,,Суука?
Dialogue: 0,0:21:11.59,0:21:12.48,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:21:12.60,0:21:13.55,Default,,0,0,0,,Бұл болуы керек.
Dialogue: 0,0:21:12.65,0:21:13.58,*Default-ja,NTP,0,0,0,,Дұрыс.
Dialogue: 0,0:21:13.68,0:21:15.98,*Default-ja,NTP,0,0,0,,Мен де жеймін
Dialogue: 0,0:21:13.73,0:21:15.44,Default,,0,0,0,,Мен де тістеп аламын деп ойлаймын.
Dialogue: 0,0:21:20.26,0:21:22.64,Default,,0,0,0,,Сонымен... сіз жақында көшіп келесіз, солай ма?
Dialogue: 0,0:21:20.32,0:21:22.66,*Default-ja,NTP,0,0,0,,Жақында көшу келеді, солай емес пе?
Dialogue: 0,0:21:22.75,0:21:24.32,Default,,0,0,0,,Иә. Келесі апта.
Dialogue: 0,0:21:22.76,0:21:24.23,*Default-ja,NTP,0,0,0,,Иә, келесі аптада
Dialogue: 0,0:21:24.33,0:21:25.85,Default,,0,0,0,,Кагосима, иә?
Dialogue: 0,0:21:24.33,0:21:25.85,*Default-ja,NTP,0,0,0,,Кагосима, иә?
Dialogue: 0,0:21:25.96,0:21:26.69,*Default-ja,NTP,0,0,0,,Ол алыс
Dialogue: 0,0:21:25.96,0:21:26.89,Default,,0,0,0,,Бұл өте алыс.
Dialogue: 0,0:21:26.80,0:21:27.99,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:21:26.92,0:21:27.55,Default,,0,0,0,,Иә...
Dialogue: 0,0:21:28.60,0:21:30.26,*Default-ja,NTP,0,0,0,,Точиги де алыста еді.
Dialogue: 0,0:21:28.76,0:21:31.01,Default,,0,0,0,,Точигиге бұл сапар да өте алыс деп ойладым.
Dialogue: 0,0:21:30.37,0:21:33.46,*Default-ja,NTP,0,0,0,,Хехе, мен қазір үйге бара алмаймын.
Dialogue: 0,0:21:31.05,0:21:32.78,Default,,0,0,0,,Енді бүгін үйге де бара алмайсың ғой.
Dialogue: 0,0:21:36.14,0:21:39.44,*Default-ja,NTP,0,0,0,,Жабуға жақын. Енді пойыздар жоқ.
Dialogue: 0,0:21:36.19,0:21:39.31,Default,,0,0,0,,Жақында жабыламыз. Енді келе жатқан немесе кететін пойыздар жоқ.
Dialogue: 0,0:21:39.54,0:21:40.34,*Default-ja,NTP,0,0,0,,Жоғары
Dialogue: 0,0:21:39.56,0:21:40.38,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:21:40.44,0:21:42.50,*Default-ja,NTP,0,0,0,,Шынымен қар жауып тұр, абай болыңыз.
Dialogue: 0,0:21:40.58,0:21:42.64,Default,,0,0,0,,Мына қарда үйге бара жатқанда абай болыңыз.
Dialogue: 0,0:21:42.61,0:21:43.41,*Default-ja,NTP,0,0,0,,Сәлем!
Dialogue: 0,0:21:42.65,0:21:43.44,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:22:07.36,0:22:09.34,Default,,0,0,0,,Ағашты көріп тұрсың ба?
Dialogue: 0,0:22:07.37,0:22:09.57,*Default-ja,NTP,0,0,0,,Сіз оны көре аласыз ба? Сол ағаш
Dialogue: 0,0:22:09.67,0:22:11.00,*Default-ja,NTP,0,0,0,,Әріптер ағашы?
Dialogue: 0,0:22:09.72,0:22:11.04,Default,,0,0,0,,Бұл сіздің хаттарыңыздағы ағаш па?
Dialogue: 0,0:22:11.08,0:22:13.16,Default,,0,0,0,,Иә. Бұл шие ағашы.
Dialogue: 0,0:22:11.11,0:22:13.91,*Default-ja,NTP,0,0,0,,Иә, шие ағашы
Dialogue: 0,0:22:20.38,0:22:21.78,*Default-ja,NTP,0,0,0,,Эй
Dialogue: 0,0:22:20.47,0:22:21.36,Default,,0,0,0,,Тек сен ғана, Хиёри-чан, осы жаққа келуге рұқсат
Dialogue: 0,0:22:22.49,0:22:25.05,*Default-ja,NTP,0,0,0,,Бұл... қар сияқты, солай емес пе?
Dialogue: 0,0:22:22.49,0:22:25.06,Default,,0,0,0,,...қалай ойлайсыз, бұл қарға ұқсайды емес пе?
Dialogue: 0,0:22:32.66,0:22:34.26,*Default-ja,NTP,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:22:32.84,0:22:33.91,Default,,0,0,0,,Бұл сөзсіз.
Dialogue: 0,0:22:44.21,0:22:45.80,*Default-ja,NTP,0,0,0,,Сол сәт
Dialogue: 0,0:22:44.23,0:22:45.86,Default,,0,0,0,,Сол сәтте...
Dialogue: 0,0:22:46.58,0:22:50.51,*Default-ja,NTP,0,0,0,,Мәңгілік, жүрек, жан қайда?
Dialogue: 0,0:22:46.68,0:22:52.14,Default,,0,0,0,,...Мәңгілік, жүрегіміз бен жанымыз қайда жатқанын білетіндей болдым.
Dialogue: 0,0:22:50.61,0:22:52.21,*Default-ja,NTP,0,0,0,,Мен түсіндім деп ойладым.
Dialogue: 0,0:22:52.75,0:22:56.98,Default,,0,0,0,,Мен өзімнің 13 жылымның барлық тәжірибелерімен бөліскендей болдым.
Dialogue: 0,0:22:52.78,0:22:56.95,*Default-ja,NTP,0,0,0,,Мен 13 жыл бойы өмір сүргенімнің бәрін бөліскендей сезінемін.
Dialogue: 0,0:22:57.05,0:22:59.75,*Default-ja,NTP,0,0,0,,Содан кейін келесі сәт
Dialogue: 0,0:22:57.12,0:22:59.79,Default,,0,0,0,,Содан кейін... келесі сәтте...
Dialogue: 0,0:23:00.36,0:23:01.42,*Default-ja,NTP,0,0,0,,Төзгісіз...
Dialogue: 0,0:23:00.39,0:23:02.96,Default,,0,0,0,,...Мен кенет шыдамас мұңға бөлендім.
Dialogue: 0,0:23:01.53,0:23:03.58,*Default-ja,NTP,0,0,0,,Мен мұңайдым.
Dialogue: 0,0:23:04.96,0:23:08.23,Default,,0,0,0,,Акаридің жылуы... және оның жаны...
Dialogue: 0,0:23:05.06,0:23:08.73,*Default-ja,NTP,0,0,0,,Ақәлінің жылуы, жан дүниесі
Dialogue: 0,0:23:08.75,0:23:12.59,Default,,0,0,0,,Оларды қалай қабылдауға болады және қайда әкелуге болады?
Dialogue: 0,0:23:08.83,0:23:12.46,*Default-ja,NTP,0,0,0,,Мен оны қалай өңдеуім керек? Мен оны қайда апаруым керек?
Dialogue: 0,0:23:12.74,0:23:15.26,Default,,0,0,0,,Менде бұл жауаптар болмағандықтан қайғылы болдым.
Dialogue: 0,0:23:12.77,0:23:15.47,*Default-ja,NTP,0,0,0,,Себебі мен мұны түсінбедім.
Dialogue: 0,0:23:18.12,0:23:23.60,Default,,0,0,0,,Мен сол кезден бастап біз мәңгі бірге болмайтынымызды анық білдім.
Dialogue: 0,0:23:18.21,0:23:21.74,*Default-ja,NTP,0,0,0,,Біз мәңгі бірге бола алмаймыз
Dialogue: 0,0:23:21.85,0:23:23.75,*Default-ja,NTP,0,0,0,,Бұл түсінікті болды
Dialogue: 0,0:23:24.53,0:23:27.42,Default,,0,0,0,,Алдағы өміріміздің ауыр салмағы...
Dialogue: 0,0:23:24.61,0:23:27.98,*Default-ja,NTP,0,0,0,,Алдымызда әлі үлкен өмір күтіп тұр.
Dialogue: 0,0:23:28.02,0:23:32.31,Default,,0,0,0,,...және уақыттың белгісіздігі бізді басып қалды.
Dialogue: 0,0:23:28.09,0:23:32.89,*Default-ja,NTP,0,0,0,,Елсіз уақыт шарасыз жатты
Dialogue: 0,0:23:35.28,0:23:38.63,Default,,0,0,0,,Бірақ... мені басып алған уайым...
Dialogue: 0,0:23:35.29,0:23:36.59,*Default-ja,NTP,0,0,0,,Бірақ...
Dialogue: 0,0:23:36.69,0:23:41.53,*Default-ja,NTP,0,0,0,,Мені басып алған уайым ақырында баяу еріді.
Dialogue: 0,0:23:39.01,0:23:41.54,Default,,0,0,0,,...жақында бірте-бірте еріп кететін.
Dialogue: 0,0:23:41.63,0:23:46.69,*Default-ja,NTP,0,0,0,,Акаридің жұмсақ ерндері ғана қалды.
Dialogue: 0,0:23:41.67,0:23:46.46,Default,,0,0,0,,Ал Акаридің жұмсақ ернінің сезімі ғана қалады.
Dialogue: 0,0:24:04.16,0:24:09.68,Default,,0,0,0,,Біз сол түнді егіс жағасындағы лашықта өткіздік.
Dialogue: 0,0:24:04.22,0:24:05.78,*Default-ja,NTP,0,0,0,,Сол түн
Dialogue: 0,0:24:05.89,0:24:10.59,*Default-ja,NTP,0,0,0,,Егіннің жанындағы шағын қорада тұрдық.
Dialogue: 0,0:24:11.36,0:24:15.28,Default,,0,0,0,,Ескі көрпеге оранып, әңгіме-дүкен құрдық...
Dialogue: 0,0:24:11.40,0:24:15.23,*Default-ja,NTP,0,0,0,,Ескі көрпеге оранып, ұзақ сөйлеседі
Dialogue: 0,0:24:15.33,0:24:17.96,*Default-ja,NTP,0,0,0,,Мен білмей тұрып ұйықтап қалдым.
Dialogue: 0,0:24:15.47,0:24:17.99,Default,,0,0,0,,...соңында біз қатарлас ұйықтап қалдық.
Dialogue: 0,0:24:19.00,0:24:22.27,*Default-ja,NTP,0,0,0,,Таңертең жүріп келе жатқан пойызға отырдым.
Dialogue: 0,0:24:19.02,0:24:22.30,Default,,0,0,0,,Келесі күні таңертең мен жүрісін қайта бастаған пойызға отырғанымда...
Dialogue: 0,0:24:22.37,0:24:25.64,*Default-ja,NTP,0,0,0,,Мен Акаримен ажырастым
Dialogue: 0,0:24:22.38,0:24:24.58,Default,,0,0,0,,...Мен Акаримен қоштастым..
Dialogue: 0,0:24:27.61,0:24:29.01,*Default-ja,NTP,0,0,0,,Біз кесіп өтетін нәрсе – ақымақтық сызығы
Dialogue: 0,0:24:27.89,0:24:30.16,Default,,0,0,0,,Умм... Такаки-кун...
Dialogue: 0,0:24:29.41,0:24:30.38,*Default-ja,NTP,0,0,0,,Такаки-кун...
Dialogue: 0,0:24:30.32,0:24:30.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:30.48,0:24:31.41,*Default-ja,NTP,0,0,0,,А...?
Dialogue: 0,0:24:32.18,0:24:34.12,*Default-ja,NTP,0,0,0,,Такаки-кун...
Dialogue: 0,0:24:32.43,0:24:33.98,Default,,0,0,0,,Такаки-кун...
Dialogue: 0,0:24:34.89,0:24:38.48,*Default-ja,NTP,0,0,0,,Бұдан былай бәрі жақсы болатынына сенімдімін!
Dialogue: 0,0:24:34.91,0:24:37.78,Default,,0,0,0,,...Бұдан былай бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:24:37.82,0:24:38.52,Default,,0,0,0,,Мен оны білемін!
Dialogue: 0,0:24:38.92,0:24:40.48,*Default-ja,NTP,0,0,0,,Рахмет
Dialogue: 0,0:24:38.98,0:24:39.98,Default,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:24:41.46,0:24:42.79,*Default-ja,NTP,0,0,0,,Акари де жақсы жүр!
Dialogue: 0,0:24:41.50,0:24:42.82,Default,,0,0,0,,Акари, сен де сау бол!
Dialogue: 0,0:24:43.53,0:24:45.19,*Default-ja,NTP,0,0,0,,Хат жаз! Телефон да!
Dialogue: 0,0:24:43.57,0:24:44.55,Default,,0,0,0,,Мен сізге жазамын!
Dialogue: 0,0:24:44.57,0:24:45.33,Default,,0,0,0,,Мен де хабарласамын!
Dialogue: 0,0:24:58.68,0:25:01.58,*Default-ja,NTP,0,0,0,,Мен Ақалиға хатты жоғалтып алдым.
Dialogue: 0,0:24:58.69,0:25:03.66,Default,,0,0,0,,Мен Акариге бергім келген хатымды жоғалтып алғанымды ешқашан айтқан емеспін.
Dialogue: 0,0:25:01.68,0:25:03.87,*Default-ja,NTP,0,0,0,,Мен Акариге айтқан жоқпын
Dialogue: 0,0:25:05.83,0:25:12.99,Default,,0,0,0,,Өйткені мен сол сүйістен кейін менің әлемім мүлде өзгергенін сезіндім.
Dialogue: 0,0:25:05.88,0:25:08.01,*Default-ja,NTP,0,0,0,,Осы сүйіспеншілікке дейін және кейін
Dialogue: 0,0:25:08.62,0:25:13.68,*Default-ja,NTP,0,0,0,,Өйткені дүниеде бәрі өзгергендей болды.
Dialogue: 0,0:25:20.80,0:25:25.33,*Default-ja,NTP,0,0,0,,Мен оны қорғайтын күшке ие болғым келді.
Dialogue: 0,0:25:20.80,0:25:25.37,Default,,0,0,0,,Мен оны қорғайтын күш-қуатты қалаймын.
Dialogue: 0,0:25:25.99,0:25:33.35,Default,,0,0,0,,Осы оймен мен терезенің арғы жағындағы пейзажға қарап отыра бердім... мәңгілікке.
Dialogue: 0,0:25:26.00,0:25:29.37,*Default-ja,NTP,0,0,0,,Мен бұл туралы мәңгі ойлайтын боламын
Dialogue: 0,0:25:29.91,0:25:33.87,*Default-ja,NTP,0,0,0,,Терезенің сыртындағы табиғатқа қарай бердім.
Dialogue: 0,0:27:01.87,0:27:04.07,Default,,0,0,0,,Кана, сен де сабақтан кейін барасың ба?
Dialogue: 0,0:27:01.96,0:27:03.99,*Default-ja,NTP,0,0,0,,Кана, сен сабақтан кейін барасың ба?
Dialogue: 0,0:27:04.10,0:27:05.59,*Default-ja,NTP,0,0,0,,Иә, әпкеңнің жағдайы жақсы ма?
Dialogue: 0,0:27:04.10,0:27:05.60,Default,,0,0,0,,Иә, мұның бәрі жақсы ма, Они-чан?
Dialogue: 0,0:27:05.70,0:27:08.33,*Default-ja,NTP,0,0,0,,Жарайды, бірақ сіз де жақсы оқыңыз.
Dialogue: 0,0:27:05.83,0:27:08.31,Default,,0,0,0,,Жақсы. Бірақ оқуыңызға да жетуді ұмытпаңыз.
Dialogue: 0,0:27:08.44,0:27:09.45,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:27:08.44,0:27:09.70,*Default-ja,NTP,0,0,0,,Yes
Dialogue: 0,0:27:38.97,0:27:40.46,*Default-ja,NTP,0,0,0,,А...Жарайды.
Dialogue: 0,0:27:39.84,0:27:40.51,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:27:54.92,0:27:56.14,*Default-ja,NTP,0,0,0,,Қайырлы таң
Dialogue: 0,0:27:55.22,0:27:56.20,Default,,0,0,0,,Таң.
Dialogue: 0,0:27:56.70,0:27:58.24,Default,,0,0,0,,Қайырлы таң, Тохно-кун.
Dialogue: 0,0:27:56.75,0:27:59.88,*Default-ja,NTP,0,0,0,,Қайырлы таң Тонокун, бүгін де таң ерте.
Dialogue: 0,0:27:58.59,0:27:59.89,Default,,0,0,0,,Сіз шынымен де бүгін таңертең ерте келдіңіз, иә?
Dialogue: 0,0:27:59.93,0:28:02.30,Default,,0,0,0,,Сен де, Сумида. Сіз қайтадан жағажайға бардыңыз, солай ма?
Dialogue: 0,0:27:59.99,0:28:02.39,*Default-ja,NTP,0,0,0,,Сумита да теңізге кетті, солай ма?
Dialogue: 0,0:28:02.34,0:28:02.95,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:28:03.59,0:28:04.45,*Default-ja,NTP,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасайсыз.
Dialogue: 0,0:28:03.59,0:28:05.20,Default,,0,0,0,,Сіз қатты жаттығып жатырсыз.
Dialogue: 0,0:28:06.29,0:28:08.99,Default,,0,0,0,,Мен олай айтпас едім...
Dialogue: 0,0:28:06.43,0:28:08.79,*Default-ja,NTP,0,0,0,,Онша емес... хехехе
Dialogue: 0,0:28:09.02,0:28:10.67,Default,,0,0,0,,Кездескенше, Тохно-кун.
Dialogue: 0,0:28:09.06,0:28:10.53,*Default-ja,NTP,0,0,0,,Жақында кездескенше! Тоно-кун
Dialogue: 0,0:28:10.70,0:28:11.38,Default,,0,0,0,,Кейінірек.
Dialogue: 0,0:28:13.96,0:28:16.64,Default,,0,0,0,,Түсіндіңіз бе? Таңдауларыңызды жасауды бастайтын уақыт келді.
Dialogue: 0,0:28:14.03,0:28:16.56,*Default-ja,NTP,0,0,0,,Жарайсың ба? Шешетін уақыт келді
Dialogue: 0,0:28:16.78,0:28:18.78,Default,,0,0,0,,Дүйсенбіге дейін міндетті түрде тапсырыңыз, жарай ма?
Dialogue: 0,0:28:16.84,0:28:18.74,*Default-ja,NTP,0,0,0,,Оны дүйсенбіге дейін жіберіңіз.
Dialogue: 0,0:28:19.02,0:28:21.96,Default,,0,0,0,,Бұл туралы бұрын ата-анаңызбен сөйлесуді ұмытпаңыз.
Dialogue: 0,0:28:19.11,0:28:21.77,*Default-ja,NTP,0,0,0,,Жазбас бұрын отбасыңызбен кеңесіңіз.
Dialogue: 0,0:28:23.14,0:28:26.30,Default,,0,0,0,,Сасаки-сан Токиодағы колледжге баратын сияқты.
Dialogue: 0,0:28:23.78,0:28:26.25,*Default-ja,NTP,0,0,0,,Сасаки-сан, мен Токиодағы университетке түскім келеді.
Dialogue: 0,0:28:26.32,0:28:30.02,Default,,0,0,0,,Бұл жерде таң қаларлық емес. Мен Кумамотодағы 2 жылдық колледжге барамын деп ойладым.
Dialogue: 0,0:28:26.61,0:28:30.17,*Default-ja,NTP,0,0,0,,Менің Кумамотодағы кіші колледжімнен күткендей~
Dialogue: 0,0:28:30.05,0:28:31.36,Default,,0,0,0,,Сен ше, Кана?
Dialogue: 0,0:28:30.28,0:28:31.44,*Default-ja,NTP,0,0,0,,Кана ше?
Dialogue: 0,0:28:31.39,0:28:33.49,Default,,0,0,0,,Иә? мм...
Dialogue: 0,0:28:31.55,0:28:33.61,*Default-ja,NTP,0,0,0,,Не? Хмм...
Dialogue: 0,0:28:33.66,0:28:35.07,Default,,0,0,0,,Жұмыс табасыз ба?
Dialogue: 0,0:28:33.72,0:28:34.91,*Default-ja,NTP,0,0,0,,Сіз жұмысқа тұрасыз ба?
Dialogue: 0,0:28:35.02,0:28:36.42,*Default-ja,NTP,0,0,0,,Хмм...
Dialogue: 0,0:28:35.10,0:28:36.19,Default,,0,0,0,,Умм...
Dialogue: 0,0:28:36.48,0:28:38.59,Default,,0,0,0,,Сіз бұл туралы мүлдем ойлаған жоқсыз, иә?
Dialogue: 0,0:28:36.52,0:28:38.99,*Default-ja,NTP,0,0,0,,Сіз шынымен ештеңе туралы ойламайсыз, солай ма?
Dialogue: 0,0:28:38.62,0:28:40.66,Default,,0,0,0,,Сіздің ойыңыздағы жалғыз нәрсе - Тохно-кун, солай ма?
Dialogue: 0,0:28:39.09,0:28:40.72,*Default-ja,NTP,0,0,0,,Тоно-кун туралы.
Dialogue: 0,0:28:40.70,0:28:43.08,Default,,0,0,0,,Ол міндетті түрде Токиода сүйіктісін тастап кетті, мен саған айтамын.
Dialogue: 0,0:28:40.83,0:28:42.85,*Default-ja,NTP,0,0,0,,Оның шынымен Токиода қызы бар.
Dialogue: 0,0:28:42.96,0:28:43.93,*Default-ja,NTP,0,0,0,,Дұрыс!
Dialogue: 0,0:28:43.11,0:28:44.37,Default,,0,0,0,,Жылдам бол, мен қазір ойнағым келеді!
Dialogue: 0,0:28:44.03,0:28:45.29,*Default-ja,NTP,0,0,0,,Уфуфуфу
Dialogue: 0,0:29:11.90,0:29:13.63,Default,,0,0,0,,Сіз үшін әлі де жақсы емес пе?
Dialogue: 0,0:29:11.96,0:29:13.76,*Default-ja,NTP,0,0,0,,Әлі жұмыс істемейсіз бе?
Dialogue: 0,0:29:13.76,0:29:15.93,Default,,0,0,0,,Иә... маған не болып жатыр?
Dialogue: 0,0:29:13.86,0:29:16.66,*Default-ja,NTP,0,0,0,,Иә, маған не болды...
Dialogue: 0,0:29:16.81,0:29:20.78,Default,,0,0,0,,Бұл туралы көп ойланбағаныңыз жақсы. Біраз уақыттан кейін қайтадан серфинг жасай аласыз, мен уәде беремін.
Dialogue: 0,0:29:16.86,0:29:20.80,*Default-ja,NTP,0,0,0,,Көп уайымдамау керек, жақын арада қайта мінуге болады.
Dialogue: 0,0:29:20.90,0:29:23.23,*Default-ja,NTP,0,0,0,,Сіз әпкеңізді жеңілдете аласыз.
Dialogue: 0,0:29:20.97,0:29:23.03,Default,,0,0,0,,Бір нәрсені оңай қабылдау жақсы болуы керек, Они-чан.
Dialogue: 0,0:29:23.06,0:29:24.83,Default,,0,0,0,,Сіз не үшін сонша асықсыз?
Dialogue: 0,0:29:23.34,0:29:25.20,*Default-ja,NTP,0,0,0,,Неге асығасың?
Dialogue: 0,0:29:26.71,0:29:29.94,*Default-ja,NTP,0,0,0,,Осы қарқынмен оқу бітіргенше ештеңе айта алмаймын.
Dialogue: 0,0:29:26.75,0:29:30.59,Default,,0,0,0,,Осы қарқынмен оқу біткенше айта алмаймын...
Dialogue: 0,0:29:49.13,0:29:50.81,Default,,0,0,0,,Рахмет, Они Чан.
Dialogue: 0,0:29:49.33,0:29:50.85,*Default-ja,NTP,0,0,0,,Рахмет, әпке
Dialogue: 0,0:29:50.85,0:29:51.92,Default,,0,0,0,,Мен де сені үйге апара аламын...
Dialogue: 0,0:29:50.96,0:29:51.93,*Default-ja,NTP,0,0,0,,Мен оны сізге жіберемін.
Dialogue: 0,0:29:51.96,0:29:54.19,Default,,0,0,0,,Бұл туралы алаңдамаңыз. Мен велосипедімді үйге апарамын.
Dialogue: 0,0:29:52.10,0:29:54.16,*Default-ja,NTP,0,0,0,,Жоқ, мен үйге шалқанмен барамын!
Dialogue: 0,0:30:21.36,0:30:23.52,*Default-ja,NTP,0,0,0,,Аа, Сумита, сен қазір үйге келесің бе?
Dialogue: 0,0:30:21.85,0:30:23.57,Default,,0,0,0,,Сумида, үйге бара жатырсың ба?
Dialogue: 0,0:30:23.66,0:30:24.41,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:30:23.83,0:30:25.92,*Default-ja,NTP,0,0,0,,Иә, Тоно-кун да?
Dialogue: 0,0:30:24.87,0:30:25.84,Default,,0,0,0,,Сен де, Тохно-кун?
Dialogue: 0,0:30:25.87,0:30:26.64,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:30:26.03,0:30:27.12,*Default-ja,NTP,0,0,0,,Ах...
Dialogue: 0,0:30:27.19,0:30:28.47,Default,,0,0,0,,Үйге бірге барғыңыз келе ме?
Dialogue: 0,0:30:27.30,0:30:28.96,*Default-ja,NTP,0,0,0,,Менімен бірге үйге барғың келе ме?
Dialogue: 0,0:30:29.49,0:30:32.19,Default,,0,0,0,,Иттей құйрығым болса...
Dialogue: 0,0:30:29.50,0:30:32.17,*Default-ja,NTP,0,0,0,,Иттей құйрығым болса
Dialogue: 0,0:30:32.57,0:30:36.77,*Default-ja,NTP,0,0,0,,Қуанғанымды жасыра алмай, басымды шайқадым.
Dialogue: 0,0:30:32.60,0:30:37.17,Default,,0,0,0,,...Мен оның дәл қазір алға-артқа тербелетініне сенімдімін, өйткені мен қуанышымды жасыра алмаймын.
Dialogue: 0,0:30:37.39,0:30:42.47,Default,,0,0,0,,Мен жеңілдеп қалдым да, ішімнен: «Шүкір, мен шынымен ит емеспін...» деп ойладым.
Dialogue: 0,0:30:37.44,0:30:42.31,*Default-ja,NTP,0,0,0,,Әй, мен ит емеспін деп қуанып қалдым.
Dialogue: 0,0:30:42.48,0:30:46.32,*Default-ja,NTP,0,0,0,,Мен мұны естігенде ақымақ болғаныма таң қалдым.
Dialogue: 0,0:30:42.49,0:30:46.35,Default,,0,0,0,,...және мен бұрын не істегенімді ойлағаным үшін ақымақ болғаныма таң қалдым.
Dialogue: 0,0:30:46.38,0:30:50.53,Default,,0,0,0,,Бірақ сонда да Тохно-кунмен үйге бару өте бақытты болды.
Dialogue: 0,0:30:46.42,0:30:47.39,*Default-ja,NTP,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:30:47.49,0:30:50.92,*Default-ja,NTP,0,0,0,,Тонокунмен үйге бару жолы бақытты болды.
Dialogue: 0,0:30:53.59,0:30:59.40,*Default-ja,NTP,0,0,0,,Басынан бастап Тоно-кун басқа ұлдардан сәл ерекшеленді.
Dialogue: 0,0:30:53.72,0:30:59.44,Default,,0,0,0,,Басынан бастап Тохно-кун басқа балалардан сәл ерекшеленетін сияқты.
Dialogue: 0,0:31:00.47,0:31:01.87,*Default-ja,NTP,0,0,0,,Бұл Такаки Тоно.
Dialogue: 0,0:31:00.51,0:31:01.80,Default,,0,0,0,,Мен Тохно Такакимін.
Dialogue: 0,0:31:01.84,0:31:03.90,Default,,0,0,0,,Мен ата-анамның жұмысына байланысты мектептерді ауыстыруға үйреніп қалғанмын...
Dialogue: 0,0:31:01.97,0:31:06.84,*Default-ja,NTP,0,0,0,,Мен ата-анамның жұмысына байланысты мектеп ауыстыруға үйренгенмін, бірақ мен бұл аралға әлі үйренбегенмін.
Dialogue: 0,0:31:04.58,0:31:06.63,Default,,0,0,0,,...бірақ мен бұл аралға әлі үйренген жоқпын.
Dialogue: 0,0:31:06.77,0:31:08.22,Default,,0,0,0,,Барлықтарыңызбен танысқаныма қуаныштымын.
Dialogue: 0,0:31:06.94,0:31:08.20,*Default-ja,NTP,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:31:08.26,0:31:12.85,Default,,0,0,0,,Мен сол күні орта мектептің екінші курсында бір көргеннен ғашық болып, онымен бір орта мектепке барғым келді...
Dialogue: 0,0:31:08.31,0:31:12.51,*Default-ja,NTP,0,0,0,,Мен оны сол күні орта мектептің екінші курсында жақсы көріп, онымен бір орта мектепке барғым келді.
Dialogue: 0,0:31:13.24,0:31:16.39,Default,,0,0,0,,...сондықтан мен қатты оқыдым, әйтеуір қабылданды...
Dialogue: 0,0:31:13.38,0:31:16.37,*Default-ja,NTP,0,0,0,,Мен өте қатты оқып, әйтеуір емтиханнан өттім.
Dialogue: 0,0:31:16.58,0:31:21.86,Default,,0,0,0,,...және мен оны көрген сайын оған одан сайын ғашық болдым.
Dialogue: 0,0:31:16.68,0:31:21.85,*Default-ja,NTP,0,0,0,,Сонда да Тохно-кунды көрген сайын оған одан сайын ғашық болып кетем.
Dialogue: 0,0:31:21.88,0:31:24.99,Default,,0,0,0,,Бірақ бұл өте қорқынышты және күнделікті азапты.
Dialogue: 0,0:31:22.02,0:31:25.01,*Default-ja,NTP,0,0,0,,Мен одан қорқамын, әр күнім азапты.
Dialogue: 0,0:31:25.03,0:31:27.34,Default,,0,0,0,,Бірақ мен оны көрген сайын бақытқа бөленемін...
Dialogue: 0,0:31:25.13,0:31:27.32,*Default-ja,NTP,0,0,0,,Бірақ мен сені көрген сайын қуанамын
Dialogue: 0,0:31:27.38,0:31:30.24,Default,,0,0,0,,...мен не істерімді білмей қалдым.
Dialogue: 0,0:31:27.43,0:31:30.36,*Default-ja,NTP,0,0,0,,Мен бұл туралы ештеңе істей алмадым.
Dialogue: 0,0:31:31.89,0:31:34.24,Default,,0,0,0,,Тохно-кун, міне, дәл солай сатып аласың.
Dialogue: 0,0:31:32.13,0:31:33.83,*Default-ja,NTP,0,0,0,,Тоно-кун, тағы да солай.
Dialogue: 0,0:31:33.93,0:31:36.20,*Default-ja,NTP,0,0,0,,Хехе, бұл дәмді.
Dialogue: 0,0:31:34.46,0:31:35.80,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:31:36.27,0:31:39.62,Default,,0,0,0,,Сумида, сіз әрқашан өз шешімдеріңізді мұқият ойлайсыз, солай емес пе?
Dialogue: 0,0:31:36.30,0:31:39.47,*Default-ja,NTP,0,0,0,,Сумита әрқашан өте байсалды.
Dialogue: 0,0:31:39.57,0:31:40.94,*Default-ja,NTP,0,0,0,,Иә!
Dialogue: 0,0:31:39.65,0:31:40.50,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:31:42.82,0:31:44.05,Default,,0,0,0,,Мен сыртта боламын.
Dialogue: 0,0:31:42.94,0:31:44.50,*Default-ja,NTP,0,0,0,,Мен алдамын
Dialogue: 0,0:31:44.62,0:31:45.43,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:31:44.81,0:31:45.68,*Default-ja,NTP,0,0,0,,Иә...
Dialogue: 0,0:31:46.01,0:31:47.17,*Default-ja,NTP,0,0,0,,Өтінемін
Dialogue: 0,0:31:46.14,0:31:47.19,Default,,0,0,0,,Тек осы, өтінемін.
Dialogue: 0,0:31:47.25,0:31:48.92,Default,,0,0,0,,Бұл 90 иен болады.
Dialogue: 0,0:31:47.35,0:31:48.91,*Default-ja,NTP,0,0,0,,90 иен.
Dialogue: 0,0:31:49.14,0:31:49.89,Default,,0,0,0,,Міне, келдіңіз.
Dialogue: 0,0:31:49.15,0:31:49.84,*Default-ja,NTP,0,0,0,,Жоғары
Dialogue: 0,0:31:49.93,0:31:51.27,Default,,0,0,0,,Әдеттегідей рахмет.
Dialogue: 0,0:31:49.95,0:31:51.21,*Default-ja,NTP,0,0,0,,Әдеттегідей рахмет
Dialogue: 0,0:31:54.52,0:31:55.18,*Default-ja,NTP,0,0,0,,Ха!
Dialogue: 0,0:32:02.10,0:32:04.15,*Default-ja,NTP,0,0,0,,Қайта қош келдіңіз Сіз не сатып алдыңыз?
Dialogue: 0,0:32:02.14,0:32:03.01,Default,,0,0,0,,Қайтадан қош келдіңіз.
Dialogue: 0,0:32:03.17,0:32:04.23,Default,,0,0,0,,Сіз не сатып алдыңыз?
Dialogue: 0,0:32:04.26,0:32:05.60,*Default-ja,NTP,0,0,0,,Иә, мен абдырап қалдым...
Dialogue: 0,0:32:04.27,0:32:05.63,Default,,0,0,0,,Таңдау қиын болды, бірақ мен мұнымен бардым.
Dialogue: 0,0:32:05.67,0:32:09.21,Default,,0,0,0,,Кейде Тохно-кун мәтіндік хабарлама жазатын еді...
Dialogue: 0,0:32:05.70,0:32:09.10,*Default-ja,NTP,0,0,0,,Тоно-кун кейде біреуге хабарлама жібереді.
Dialogue: 0,0:32:09.20,0:32:14.37,*Default-ja,NTP,0,0,0,,Мен мұны істеген сайын, мен үшін болғанын қалаймын.
Dialogue: 0,0:32:09.24,0:32:11.50,Default,,0,0,0,,...және ол жасаған сайын мен әрқашан...
Dialogue: 0,0:32:11.53,0:32:13.76,Default,,0,0,0,,...ол жазып жатқан мәтіндік хабарлама...
Dialogue: 0,0:32:14.57,0:32:18.34,*Default-ja,NTP,0,0,0,,Мен бұл туралы үнемі ойламай тұра алмаймын.
Dialogue: 0,0:32:14.73,0:32:18.24,Default,,0,0,0,,...маған арналады.
Dialogue: 0,0:32:23.55,0:32:24.81,*Default-ja,NTP,0,0,0,,Бір!
Dialogue: 0,0:32:25.99,0:32:27.75,*Default-ja,NTP,0,0,0,,Уф уф! бір!
Dialogue: 0,0:32:28.01,0:32:29.34,Default,,0,0,0,,Кабу, мен үйдемін!
Dialogue: 0,0:32:28.09,0:32:29.32,*Default-ja,NTP,0,0,0,,Шалғам! Мен үйдемін!
Dialogue: 0,0:32:29.49,0:32:30.71,Default,,0,0,0,,Кабу, Кабу!
Dialogue: 0,0:32:29.69,0:32:32.39,*Default-ja,NTP,0,0,0,,Кабукабу Мен қайтып келдім!
Dialogue: 0,0:32:30.97,0:32:32.40,Default,,0,0,0,,Аякаши оны кесіп өте алмайды
Dialogue: 0,0:32:32.63,0:32:33.68,*Default-ja,NTP,0,0,0,,Wahoo
Dialogue: 0,0:32:52.78,0:32:58.24,*Default-ja,NTP,0,0,0,,Қалалық әкімдік хабарламасы Келесі кезекші стенд Сақай ауылшаруашылық кооперативінің жанар-жағар май құю...
Dialogue: 0,0:32:52.83,0:32:55.11,Default,,0,0,0,,Бұл сіздің қала әкімшілігіңіздің хабарламасы.
Dialogue: 0,0:32:55.15,0:32:58.27,Default,,0,0,0,,Келесі қалыпты ашық жанармай қоймасы Сақай ауылшаруашылық кооперативінің жанармай құю станциясында болады.
Dialogue: 0,0:32:58.50,0:33:01.08,Default,,0,0,0,,3-1 сынып оқушысы Сумида Канаэ-сан...
Dialogue: 0,0:32:58.59,0:33:01.02,*Default-ja,NTP,0,0,0,,Канаэ Сумита, 3 курс 1 сынып
Dialogue: 0,0:33:01.22,0:33:03.95,*Default-ja,NTP,0,0,0,,Сізге Ито мырза қоңырау шалып жатыр. Студенттік бағыттағы кабинетке келіңіз.
Dialogue: 0,0:33:01.29,0:33:02.82,Default,,0,0,0,,...Сені Иту-сенсэй шақырып жатыр.
Dialogue: 0,0:33:02.86,0:33:04.68,Default,,0,0,0,,Анықтамалық кеңесшінің кеңсесіне хабарлаңыз.
Dialogue: 0,0:33:04.06,0:33:05.96,*Default-ja,NTP,0,0,0,,Тононың құрбысы
Dialogue: 0,0:33:04.71,0:33:05.75,Default,,0,0,0,,Бұл сенің қызың Тохно.
Dialogue: 0,0:33:06.00,0:33:07.46,Default,,0,0,0,,Ол менің құрбым емес.
Dialogue: 0,0:33:06.06,0:33:07.36,*Default-ja,NTP,0,0,0,,Бұл қыз немесе басқа нәрсе емес.
Dialogue: 0,0:33:11.05,0:33:13.73,Default,,0,0,0,,Сыныпта біреуін толтырмаған жалғыз сенсің.
Dialogue: 0,0:33:11.16,0:33:13.69,*Default-ja,NTP,0,0,0,,Сумита – сыныпта тапсырмаған жалғыз адам.
Dialogue: 0,0:33:13.88,0:33:15.09,Default,,0,0,0,,Мұнда.
Dialogue: 0,0:33:13.97,0:33:15.46,*Default-ja,NTP,0,0,0,,Кешіріңіз...
Dialogue: 0,0:33:15.32,0:33:18.13,Default,,0,0,0,,Қараңызшы, бұл менің орнымдағы біреу айтуы керек нәрсе емес...
Dialogue: 0,0:33:15.57,0:33:20.27,*Default-ja,NTP,0,0,0,,You know, I don't know what to say, but it's not something that worries me that much.
Dialogue: 0,0:33:18.14,0:33:20.60,Default,,0,0,0,,...but this isn't really something you have to wrack your brain over.
Dialogue: 0,0:33:20.63,0:33:22.77,Default,,0,0,0,,Сумида-сенсэй бірдеңе деді ме?
Dialogue: 0,0:33:20.71,0:33:22.83,*Default-ja,NTP,0,0,0,,Сумита мырза не айтып тұр?
Dialogue: 0,0:33:22.82,0:33:23.93,Default,,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,0:33:22.94,0:33:24.14,*Default-ja,NTP,0,0,0,,Жоқ...
Dialogue: 0,0:33:24.61,0:33:25.77,*Default-ja,NTP,0,0,0,,Иә...
Dialogue: 0,0:33:26.77,0:33:30.56,Default,,0,0,0,,If you really can't decide, then how about a 2-year college within the prefecture?
Dialogue: 0,0:33:26.88,0:33:30.61,*Default-ja,NTP,0,0,0,,If you really can't decide, what about junior colleges within the prefecture?
Dialogue: 0,0:33:30.72,0:33:32.01,*Default-ja,NTP,0,0,0,,Кешігіп қалғаным үшін кешірім сұраймын.
Dialogue: 0,0:33:30.78,0:33:31.46,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:33:33.59,0:33:35.94,Default,,0,0,0,,Они-чанның бұған қатысы жоқ...
Dialogue: 0,0:33:33.59,0:33:36.32,*Default-ja,NTP,0,0,0,,Even though your sister has nothing to do with it...
Dialogue: 0,0:33:53.57,0:33:54.67,*Default-ja,NTP,0,0,0,,Өйткені...
Dialogue: 0,0:33:53.76,0:33:54.71,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:33:56.51,0:33:59.34,*Default-ja,NTP,0,0,0,,I started surfing because I begged my sister.
Dialogue: 0,0:33:56.55,0:33:59.37,Default,,0,0,0,,...surfing, even after I pestered my sister so much to teach me...
Dialogue: 0,0:33:59.69,0:34:02.68,Default,,0,0,0,,...and the most important guy who takes up all of my thoughts...
Dialogue: 0,0:33:59.71,0:34:02.65,*Default-ja,NTP,0,0,0,,Also about that person I think is most important.
Dialogue: 0,0:34:02.85,0:34:06.25,*Default-ja,NTP,0,0,0,,Мен әлі де...
Dialogue: 0,0:34:02.92,0:34:05.93,Default,,0,0,0,,... мен әлі де жақсы емес екі нәрсе.
Dialogue: 0,0:34:31.21,0:34:33.04,*Default-ja,NTP,0,0,0,,Әдеттегідей рахмет
Dialogue: 0,0:34:31.24,0:34:32.83,Default,,0,0,0,,Әдеттегідей рахмет.
Dialogue: 0,0:34:33.04,0:34:35.77,Default,,0,0,0,,Мүлде жоқ. Келесі кездескенше.
Dialogue: 0,0:34:33.15,0:34:35.74,*Default-ja,NTP,0,0,0,,Жоқ, кездескенше.
Dialogue: 0,0:35:04.04,0:35:06.47,Default,,0,0,0,,Мен Тохно-кун жатқан жерге барған сайын...
Dialogue: 0,0:35:04.18,0:35:06.44,*Default-ja,NTP,0,0,0,,Тоно-кун жатқан жерге келгенде
Dialogue: 0,0:35:06.48,0:35:10.30,Default,,0,0,0,,...deep down, my heart... it clenches up... just a little.
Dialogue: 0,0:35:06.55,0:35:10.45,*Default-ja,NTP,0,0,0,,Deep inside my chest... it feels a little painful.
Dialogue: 0,0:35:11.05,0:35:11.98,*Default-ja,NTP,0,0,0,,Тоно-кун!
Dialogue: 0,0:35:11.18,0:35:12.04,Default,,0,0,0,,Тохно-кун.
Dialogue: 0,0:35:12.19,0:35:15.02,*Default-ja,NTP,0,0,0,,Сумита? Мен не болып жатқанын түсінемін.
Dialogue: 0,0:35:12.25,0:35:15.08,Default,,0,0,0,,Сумида, не болды? Мені осы жерден тапқаныңызға таң қалдым.
Dialogue: 0,0:35:15.12,0:35:20.15,*Default-ja,NTP,0,0,0,,Hehehe I came because I saw Tono-kun's motorcycle. Бұл жақсы ма?
Dialogue: 0,0:35:16.17,0:35:19.29,Default,,0,0,0,,I saw your bike, so I decided to come on by.
Dialogue: 0,0:35:19.50,0:35:20.05,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:35:20.09,0:35:22.55,Default,,0,0,0,,Түсіндім. Сені көргеніме қуаныштымын.
Dialogue: 0,0:35:20.26,0:35:22.56,*Default-ja,NTP,0,0,0,,Иә, түсіндім, мен бақыттымын.
Dialogue: 0,0:35:22.80,0:35:25.56,*Default-ja,NTP,0,0,0,,I couldn't meet you at the motorcycle lot today.
Dialogue: 0,0:35:22.86,0:35:25.47,Default,,0,0,0,,We didn't run into each other at the bike shed today.
Dialogue: 0,0:35:25.67,0:35:26.93,*Default-ja,NTP,0,0,0,,Мен де!
Dialogue: 0,0:35:25.73,0:35:26.87,Default,,0,0,0,,Мен де қуаныштымын.
Dialogue: 0,0:35:27.03,0:35:28.66,*Default-ja,NTP,0,0,0,,Ол мейірімді
Dialogue: 0,0:35:27.05,0:35:28.43,Default,,0,0,0,,Ол өте мейірімді.
Dialogue: 0,0:35:29.16,0:35:33.12,Default,,0,0,0,,So kind that sometimes it feels like I'm going to cry.
Dialogue: 0,0:35:29.24,0:35:32.73,*Default-ja,NTP,0,0,0,,Кейде жылағым келеді
Dialogue: 0,0:35:35.39,0:35:37.48,Default,,0,0,0,,Эй, сен колледжге түсу үшін тест тапсырасың ба?
Dialogue: 0,0:35:35.48,0:35:37.44,*Default-ja,NTP,0,0,0,,Эй, Тоно-кун, сен қабылдау емтиханын тапсырып жатырсың ба?
Dialogue: 0,0:35:37.60,0:35:40.40,Default,,0,0,0,,Иә. Мен Токиодағы кейбір университеттерге бірнеше оқуға түсемін.
Dialogue: 0,0:35:37.71,0:35:40.34,*Default-ja,NTP,0,0,0,,Иә, Токиодағы университетке түс.
Dialogue: 0,0:35:40.58,0:35:43.15,Default,,0,0,0,,Токио... Түсіндім.
Dialogue: 0,0:35:40.71,0:35:45.28,*Default-ja,NTP,0,0,0,,Токио...Түсіндім, мен солай ойладым.
Dialogue: 0,0:35:43.19,0:35:45.61,Default,,0,0,0,,Мен солай болуы мүмкін деп ойладым.
Dialogue: 0,0:35:45.83,0:35:46.89,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:35:45.95,0:35:47.04,*Default-ja,NTP,0,0,0,,Неліктен?
Dialogue: 0,0:35:46.99,0:35:49.99,Default,,0,0,0,,Сіз бұл жерден алыс кеткіңіз келетін сияқтысыз, неге екені белгісіз...
Dialogue: 0,0:35:47.15,0:35:50.09,*Default-ja,NTP,0,0,0,,Әйтеуір алысқа кеткен сияқтысың
Dialogue: 0,0:35:50.60,0:35:51.78,Default,,0,0,0,,Сен ше, Сумида?
Dialogue: 0,0:35:50.66,0:35:51.75,*Default-ja,NTP,0,0,0,,Сумита ше?
Dialogue: 0,0:35:51.93,0:35:52.91,*Default-ja,NTP,0,0,0,,Хмм...
Dialogue: 0,0:35:53.17,0:35:56.58,Default,,0,0,0,,Мен тіпті ертең не болатынын білмеймін.
Dialogue: 0,0:35:53.26,0:35:56.63,*Default-ja,NTP,0,0,0,,Мен ертең туралы білмеймін.
Dialogue: 0,0:35:56.61,0:35:58.55,Default,,0,0,0,,Барлығы бірдей.
Dialogue: 0,0:35:56.73,0:35:58.56,*Default-ja,NTP,0,0,0,,Барлығында солай шығар.
Dialogue: 0,0:35:58.58,0:36:00.38,Default,,0,0,0,,Жоқ! Сен де, Тохно-кун?
Dialogue: 0,0:35:58.67,0:36:00.50,*Default-ja,NTP,0,0,0,,Бір! Тоно-кун да?
Dialogue: 0,0:36:00.55,0:36:01.46,Default,,0,0,0,,Әрине.
Dialogue: 0,0:36:00.60,0:36:01.43,*Default-ja,NTP,0,0,0,,Әрине
Dialogue: 0,0:36:02.34,0:36:05.40,Default,,0,0,0,,Сізде алаңдайтын ештеңе жоқ сияқты.
Dialogue: 0,0:36:02.37,0:36:04.93,*Default-ja,NTP,0,0,0,,Ешқандай тартыну жоқ сияқты.
Dialogue: 0,0:36:05.34,0:36:08.21,*Default-ja,NTP,0,0,0,,Жоқ, мен жай ғана абдырап қалдым.
Dialogue: 0,0:36:05.44,0:36:08.47,Default,,0,0,0,,О, мұны тоқтатыңыз. Мен уайымнан басқа ештеңеге толы емеспін.
Dialogue: 0,0:36:08.65,0:36:12.10,Default,,0,0,0,,Мен үлгеру үшін қолымнан келгеннің бәрін істеп жатырмын. Менде тыныс алатын бөлме жоқ.
Dialogue: 0,0:36:08.71,0:36:12.04,*Default-ja,NTP,0,0,0,,Қолымнан келгенін істеп жатырмын, қолымнан келмейді
Dialogue: 0,0:36:12.78,0:36:13.79,Default,,0,0,0,,Мен бір қолымда оқ жалғанған винтовка ұстап тұрмын
Dialogue: 0,0:36:12.81,0:36:13.78,*Default-ja,NTP,0,0,0,,Мен көремін...
Dialogue: 0,0:36:14.92,0:36:16.19,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:36:15.05,0:36:16.57,*Default-ja,NTP,0,0,0,,Бұл дұрыс
Dialogue: 0,0:36:23.68,0:36:24.77,Default,,0,0,0,,Ұшақ?
Dialogue: 0,0:36:23.76,0:36:24.95,*Default-ja,NTP,0,0,0,,Ұшақ?
Dialogue: 0,0:36:25.02,0:36:25.77,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:37:16.32,0:37:17.33,Default,,0,0,0,,Қате айтасың!
Dialogue: 0,0:37:16.34,0:37:17.93,*Default-ja,NTP,0,0,0,,..ғажайып
Dialogue: 0,0:37:18.82,0:37:20.50,Default,,0,0,0,,Олар сағатына бес шақырым жылдамдықпен жүреді дейді.
Dialogue: 0,0:37:18.88,0:37:20.28,*Default-ja,NTP,0,0,0,,Бұл 5км/сағ.
Dialogue: 0,0:37:20.51,0:37:21.45,*Default-ja,NTP,0,0,0,,Иә?
Dialogue: 0,0:37:22.28,0:37:24.46,Default,,0,0,0,,Ол Минамитан ұшыру қондырғысына барады.
Dialogue: 0,0:37:22.38,0:37:24.35,*Default-ja,NTP,0,0,0,,Минамитан ұшыру алаңына
Dialogue: 0,0:37:24.45,0:37:25.58,*Default-ja,NTP,0,0,0,,Ах...
Dialogue: 0,0:37:25.71,0:37:29.05,Default,,0,0,0,,Осы жылы іске қосылатын сияқты. Біраз уақыттан кейін бірінші рет.
Dialogue: 0,0:37:25.85,0:37:28.69,*Default-ja,NTP,0,0,0,,Биылғы жылы іске қосылғанымызға көп уақыт болды.
Dialogue: 0,0:37:28.79,0:37:32.35,*Default-ja,NTP,0,0,0,,А, біз күн жүйесіне өте алысқа барамыз.
Dialogue: 0,0:37:29.08,0:37:32.39,Default,,0,0,0,,Иә. Ол күн жүйесінің алыс шетіне баруы керек.
Dialogue: 0,0:37:32.42,0:37:34.05,Default,,0,0,0,,Қанша жыл өтсе де...
Dialogue: 0,0:37:32.46,0:37:34.05,*Default-ja,NTP,0,0,0,,Жылдар бойы
Dialogue: 0,0:37:53.44,0:37:57.24,Default,,0,0,0,,Эй... сен Канамен оның болашақ жоспарлары туралы шынымен сөйлесуің керек.
Dialogue: 0,0:37:53.55,0:37:57.35,*Default-ja,NTP,0,0,0,,Сіз Канэймен оның мансап жолы туралы кеңесуіңіз керек.
Dialogue: 0,0:37:57.40,0:37:59.06,Default,,0,0,0,,Сіз оның қаншалықты беймаза екенін білесіз.
Dialogue: 0,0:37:57.45,0:37:59.01,*Default-ja,NTP,0,0,0,,Ол – санасыз бала.
Dialogue: 0,0:37:59.10,0:38:02.46,Default,,0,0,0,,Ол жақсы болады. Ол енді бала сияқты емес.
Dialogue: 0,0:37:59.12,0:38:02.42,*Default-ja,NTP,0,0,0,,Жарайды, ол енді бала емес.
Dialogue: 0,0:38:06.36,0:38:08.47,Default,,0,0,0,,Мен дәл осылай болған кезім есімде, баяғыда...
Dialogue: 0,0:38:06.46,0:38:08.43,*Default-ja,NTP,0,0,0,,Мен де солай едім...
Dialogue: 0,0:38:10.33,0:38:14.51,Default,,0,0,0,,Мұны естідің бе, Кабу? Тохно-кун да ертең не боларын білмейтін сияқты.
Dialogue: 0,0:38:10.43,0:38:14.42,*Default-ja,NTP,0,0,0,,Эй Кабу, Тоно-кун да түсінбейді.
Dialogue: 0,0:38:14.52,0:38:16.97,Default,,0,0,0,,Екеуміз де бірдейміз. Тохно-кун және мен.
Dialogue: 0,0:38:14.60,0:38:18.06,*Default-ja,NTP,0,0,0,,Біз біргеміз...Тоно-кун да.
Dialogue: 0,0:38:18.11,0:38:20.25,Default,,0,0,0,,Бұл шынымен де болуы керек...
Dialogue: 0,0:38:18.37,0:38:20.60,*Default-ja,NTP,0,0,0,,Бұл шынымен...
Dialogue: 0,0:38:20.91,0:38:24.47,*Default-ja,NTP,0,0,0,,Бұл елестете алмайтын жалғыз саяхат болуы керек.
Dialogue: 0,0:38:20.95,0:38:24.41,Default,,0,0,0,,...ешкім елестете алмайтын жалғыз саяхат.
Dialogue: 0,0:38:25.40,0:38:28.85,Default,,0,0,0,,Шынайы күңгірт қараңғылықта алға басу үшін...
Dialogue: 0,0:38:25.51,0:38:28.81,*Default-ja,NTP,0,0,0,,Нағыз қараңғы сарайдың ішінде серуендеу
Dialogue: 0,0:38:28.88,0:38:31.98,Default,,0,0,0,,Тіпті бір ғана сутегі атомын әрең кездестіру...
Dialogue: 0,0:38:28.92,0:38:32.58,*Default-ja,NTP,0,0,0,,Біз тіпті жалғыз сутегі атомын да сирек кездестіреміз
Dialogue: 0,0:38:33.22,0:38:35.81,Default,,0,0,0,,Сіз ашуға жақындайтыныңызға шын жүректен сене отырып...
Dialogue: 0,0:38:33.22,0:38:38.89,*Default-ja,NTP,0,0,0,,Мен тұңғиықта жатқан дүниенің құпияларына жақындағым келеді.
Dialogue: 0,0:38:35.84,0:38:39.04,Default,,0,0,0,,...кеңістіктің терең тұңғиығындағы ғаламның құпиялары.
Dialogue: 0,0:38:44.11,0:38:47.57,Default,,0,0,0,,Мен қаншалықты алыс жүруіміз керек деп ойлаймын...
Dialogue: 0,0:38:44.20,0:38:48.07,*Default-ja,NTP,0,0,0,,Осылай қанша уақытқа барамыз?
Dialogue: 0,0:38:48.34,0:38:50.67,Default,,0,0,0,,Біз қаншалықты алыс жүре аламыз?
Dialogue: 0,0:38:48.47,0:38:51.23,*Default-ja,NTP,0,0,0,,Біз қаншалықты алыс жүре аламыз?
Dialogue: 0,0:39:10.05,0:39:14.50,Default,,0,0,0,,Қызық, мен қашан ешкімге хат жазуды әдетке айналдырдым?
Dialogue: 0,0:39:10.19,0:39:14.82,*Default-ja,NTP,0,0,0,,Мен мақсатсыз хаттарды жіберуді қашан әдетке айналдырдым?
Dialogue: 0,0:39:51.83,0:39:54.27,Default,,0,0,0,,Кана, сен болашақта не істейтініңді шештің бе?
Dialogue: 0,0:39:52.10,0:39:54.26,*Default-ja,NTP,0,0,0,,Кана, сен мансап жолыңды шештің бе?
Dialogue: 0,0:39:54.30,0:39:56.94,Default,,0,0,0,,Жоқ. Мен ойлағандай, мен әлі де сенімді емеспін ...
Dialogue: 0,0:39:54.37,0:39:59.24,*Default-ja,NTP,0,0,0,,Жоқ, мен әлі білмеймін, бірақ мен бұл дұрыс деп шештім!
Dialogue: 0,0:39:56.98,0:40:01.61,Default,,0,0,0,,Бірақ бәрі жақсы! Мен бәрін бір уақытта қабылдаймын деп шештім.
Dialogue: 0,0:39:59.44,0:40:03.27,*Default-ja,NTP,0,0,0,,Қолымнан келгенді бір-бірлеп жасаймын!
Dialogue: 0,0:40:01.76,0:40:02.68,Default,,0,0,0,,Мен кетемін!
Dialogue: 0,0:40:20.32,0:40:24.21,Default,,0,0,0,,Сол күннен бастап көптеген тайфундар өтті...
Dialogue: 0,0:40:20.46,0:40:24.59,*Default-ja,NTP,0,0,0,,Сол күннен бері бірнеше тайфун өтті.
Dialogue: 0,0:40:24.50,0:40:28.13,Default,,0,0,0,,...және арал суыған сайын салқындайды.
Dialogue: 0,0:40:24.70,0:40:28.22,*Default-ja,NTP,0,0,0,,Әр жолы арал сәл салқындай бастады.
Dialogue: 0,0:40:30.11,0:40:33.57,Default,,0,0,0,,Қант қамысы арқылы соққан жел аздап салқындап кетті...
Dialogue: 0,0:40:30.20,0:40:33.54,*Default-ja,NTP,0,0,0,,Қантты тербеткен жел аздап салқындайды.
Dialogue: 0,0:40:33.60,0:40:35.82,Default,,0,0,0,,...ал аспан сәл жоғарырақ көрінеді.
Dialogue: 0,0:40:33.64,0:40:35.80,*Default-ja,NTP,0,0,0,,Аспан сәл биік
Dialogue: 0,0:40:35.86,0:40:38.37,Default,,0,0,0,,Бұлттардың шеттері жұмсақ болды...
Dialogue: 0,0:40:35.98,0:40:38.31,*Default-ja,NTP,0,0,0,,Бұлттардың контурлары жұмсақ болады.
Dialogue: 0,0:40:38.41,0:40:42.85,*Default-ja,NTP,0,0,0,,Балапандарды мінетін сыныптастарым жұқа шампер кие бастады.
Dialogue: 0,0:40:38.41,0:40:43.25,Default,,0,0,0,,...ал менің сыныптастарым ауа-райының өзгеруіне байланысты велосипед теуіп жүргенде жеңіл күртеше кие бастады.
Dialogue: 0,0:40:58.34,0:41:01.77,Default,,0,0,0,,Толқындарды қайта айдап үлгергенімде, алты ай өтті.
Dialogue: 0,0:40:58.40,0:41:01.66,*Default-ja,NTP,0,0,0,,Жарты жыл ішінде мен алғаш рет толқын үстінде тұрдым
Dialogue: 0,0:41:01.77,0:41:06.07,*Default-ja,NTP,0,0,0,,Қазан айының ортасы болатын, ал жаз бұл жерде әрең болды.
Dialogue: 0,0:41:01.81,0:41:07.23,Default,,0,0,0,,Қазан айының ортасы болса да, біраз жаз артта қалғандай болды.
Dialogue: 0,0:41:17.22,0:41:21.88,*Default-ja,NTP,0,0,0,,Бүгін кешке дейін күн ашық болады, желдің жылдамдығы 8 м-ге жетеді деп күтілуде.
Dialogue: 0,0:41:17.33,0:41:22.49,Default,,0,0,0,,Бүгінгі түнге арналған ауа райы болжамы секундына сегіз метрге дейін жел соғатын ашық кешті көрсетеді.
Dialogue: 0,0:41:21.99,0:41:25.08,*Default-ja,NTP,0,0,0,,Сасаки мырза, Ямада оны мойындаған сияқты.
Dialogue: 0,0:41:22.52,0:41:25.19,Default,,0,0,0,,Осылайша мен Ямада Сасаки-санға мойындағанын естідім.
Dialogue: 0,0:41:25.28,0:41:26.77,Default,,0,0,0,,Бұл жерде таң қаларлық емес.
Dialogue: 0,0:41:25.29,0:41:27.09,*Default-ja,NTP,0,0,0,,Күтілгендей
Dialogue: 0,0:41:27.10,0:41:29.57,Default,,0,0,0,,Иә? Кана, сен бүгін өте бақытты сияқтысың.
Dialogue: 0,0:41:27.19,0:41:29.68,*Default-ja,NTP,0,0,0,,Иә? Кана бүгін бақытты сияқты.
Dialogue: 0,0:41:29.61,0:41:31.65,Default,,0,0,0,,Тохно-кун екеуіңнің арасында жақсы нәрсе болды ма?
Dialogue: 0,0:41:29.80,0:41:31.63,*Default-ja,NTP,0,0,0,,Тоно-кунмен бірдеңе болды ма?
Dialogue: 0,0:41:32.99,0:41:33.92,Default,,0,0,0,,Жылдам бол, мен қазір ойнағым келеді!
Dialogue: 0,0:41:33.07,0:41:33.86,*Default-ja,NTP,0,0,0,,Бір!
Dialogue: 0,0:41:35.58,0:41:39.58,Default,,0,0,0,,Бүгін мен де Тохно-кунды мойындаймын.
Dialogue: 0,0:41:35.60,0:41:37.93,*Default-ja,NTP,0,0,0,,Бүгін мен үшін күн...
Dialogue: 0,0:41:38.04,0:41:40.23,*Default-ja,NTP,0,0,0,,Тоно-кунды мойындау.
Dialogue: 0,0:41:44.83,0:41:47.14,Default,,0,0,0,,Бүгін айтпасам, толқынды қайта мінген күні...
Dialogue: 0,0:41:44.84,0:41:47.11,*Default-ja,NTP,0,0,0,,Толқынды міндім деп бүгін айтуым керек.
Dialogue: 0,0:41:47.17,0:41:50.02,Default,,0,0,0,,...Мен ешқашан қолымнан келмейтініне сенімдімін.
Dialogue: 0,0:41:47.21,0:41:50.88,*Default-ja,NTP,0,0,0,,Бұдан былай мен сенімдімін... Мәңгі айта алмаймын.
Dialogue: 0,0:42:00.59,0:42:01.49,*Default-ja,NTP,0,0,0,,Сумита
Dialogue: 0,0:42:00.65,0:42:01.56,Default,,0,0,0,,Сумида.
Dialogue: 0,0:42:01.59,0:42:02.47,Default,,0,0,0,,Кімге-
Dialogue: 0,0:42:01.79,0:42:02.78,*Default-ja,NTP,0,0,0,,Және...
Dialogue: 0,0:42:03.82,0:42:05.00,Default,,0,0,0,,Тохно-кун.
Dialogue: 0,0:42:03.83,0:42:05.39,*Default-ja,NTP,0,0,0,,Тоно-кун...
Dialogue: 0,0:42:05.48,0:42:06.23,Default,,0,0,0,,Үйге бара жатырсыз ба?
Dialogue: 0,0:42:05.50,0:42:06.23,*Default-ja,NTP,0,0,0,,Енді үйге барасың ба?
Dialogue: 0,0:42:06.26,0:42:06.95,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:42:07.47,0:42:08.30,*Default-ja,NTP,0,0,0,,Мен көремін.
Dialogue: 0,0:42:07.54,0:42:08.31,Default,,0,0,0,,Б... бір сызық
Dialogue: 0,0:42:08.50,0:42:10.41,Default,,0,0,0,,Олай болса, үйге бірге барайық.
Dialogue: 0,0:42:08.50,0:42:10.99,*Default-ja,NTP,0,0,0,,Олай болса үйге бірге барайық.
Dialogue: 0,0:42:33.14,0:42:35.75,Default,,0,0,0,,Әй, Сумида? Бүгін шешім қабылдадыңыз ба?
Dialogue: 0,0:42:33.16,0:42:35.59,*Default-ja,NTP,0,0,0,,Эй, Сумита, бүгін шешілді ме?
Dialogue: 0,0:42:35.78,0:42:36.48,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:42:47.87,0:42:48.57,*Default-ja,NTP,0,0,0,,Не болды?
Dialogue: 0,0:42:47.89,0:42:48.62,Default,,0,0,0,,Не болды?
Dialogue: 0,0:42:56.05,0:42:57.38,*Default-ja,NTP,0,0,0,,...оны нашарлатпаңыз
Dialogue: 0,0:42:56.12,0:42:57.44,Default,,0,0,0,,...маған ...
Dialogue: 0,0:42:57.48,0:42:58.47,*Default-ja,NTP,0,0,0,,Иә?
Dialogue: 0,0:43:00.17,0:43:03.30,Default,,0,0,0,,Жоқ... Кешіріңіз. Ештеңе етпейді.
Dialogue: 0,0:43:01.69,0:43:04.16,*Default-ja,NTP,0,0,0,,Кешіріңіз... бұл ештеңе емес.
Dialogue: 0,0:43:11.60,0:43:12.86,*Default-ja,NTP,0,0,0,,Өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:43:11.60,0:43:12.88,Default,,0,0,0,,Велосипедіңіз қозғалып жатыр ма?
Dialogue: 0,0:43:12.92,0:43:14.87,Default,,0,0,0,,Иә... бұл біртүрлі.
Dialogue: 0,0:43:12.97,0:43:14.87,*Default-ja,NTP,0,0,0,,Иә, бұл біртүрлі.
Dialogue: 0,0:43:16.33,0:43:17.20,Default,,0,0,0,,Ол сынған ба?
Dialogue: 0,0:43:16.34,0:43:17.17,*Default-ja,NTP,0,0,0,,Жоқ?
Dialogue: 0,0:43:17.22,0:43:20.34,Default,,0,0,0,,Иә... Менің ойымша, оталдырғыш сөніп қалды.
Dialogue: 0,0:43:17.27,0:43:21.76,*Default-ja,NTP,0,0,0,,Иә...Қызық, бұл розетканың қызмет ету мерзіміне байланысты ма.
Dialogue: 0,0:43:20.76,0:43:22.02,Default,,0,0,0,,Бұл қолма-қол жұмыс болды ма?
Dialogue: 0,0:43:21.87,0:43:23.10,*Default-ja,NTP,0,0,0,,Иә, сіздің әпкеңіздікі
Dialogue: 0,0:43:22.06,0:43:23.25,Default,,0,0,0,,Иә. Бұл Они Чандікі еді.
Dialogue: 0,0:43:23.21,0:43:24.90,*Default-ja,NTP,0,0,0,,Сіз үдеуден дем алған жоқсыз ба?
Dialogue: 0,0:43:23.29,0:43:25.08,Default,,0,0,0,,Сіз жылдамдатуға тырысқанда ол тоқтап қалды ма?
Dialogue: 0,0:43:25.01,0:43:26.57,*Default-ja,NTP,0,0,0,,Мен мұны істеген болармын.
Dialogue: 0,0:43:25.11,0:43:26.56,Default,,0,0,0,,Бұл шын мәнінде...
Dialogue: 0,0:43:27.56,0:43:29.31,Default,,0,0,0,,Бүгінге осында қалдырайық.
Dialogue: 0,0:43:27.68,0:43:32.01,*Default-ja,NTP,0,0,0,,Бүгінге қалдырыңыз, үйдегілер оны кейінірек келіп алып кетсін.
Dialogue: 0,0:43:29.70,0:43:31.99,Default,,0,0,0,,Оны кейінірек үйіңізден біреу алып кетуіне болады.
Dialogue: 0,0:43:32.12,0:43:33.42,*Default-ja,NTP,0,0,0,,Бүгін серуендейміз
Dialogue: 0,0:43:32.17,0:43:33.38,Default,,0,0,0,,Бүгін серуендеп қайтайық.
Dialogue: 0,0:43:33.45,0:43:35.81,Default,,0,0,0,,Иә? Мен өзім жүремін!
Dialogue: 0,0:43:33.52,0:43:37.79,*Default-ja,NTP,0,0,0,,Е, мен жалғыз жүремін! Тоно-кун, алдымен үйге бар.
Dialogue: 0,0:43:35.90,0:43:37.57,Default,,0,0,0,,Сіз әрі қарай жүріңіз.
Dialogue: 0,0:43:37.92,0:43:39.80,Default,,0,0,0,,Біз сонша алыстамыз, ал сенің жерің жақын, сондықтан...
Dialogue: 0,0:43:37.96,0:43:39.75,*Default-ja,NTP,0,0,0,,Осы уақытқа дейін жетсең, жақынсың.
Dialogue: 0,0:43:39.96,0:43:43.02,*Default-ja,NTP,0,0,0,,Ал мен жай ғана... жаяу жүргім келеді.
Dialogue: 0,0:43:39.97,0:43:42.45,Default,,0,0,0,,Ал... Мен бүгін жаяу жүргім келеді.
Dialogue: 0,0:44:18.06,0:44:19.29,*Default-ja,NTP,0,0,0,,Тоно-кун...
Dialogue: 0,0:44:18.14,0:44:20.86,Default,,0,0,0,,Тохно-кун, өтінемін...
Dialogue: 0,0:44:19.60,0:44:20.86,*Default-ja,NTP,0,0,0,,Өтінемін...
Dialogue: 0,0:44:31.94,0:44:32.93,*Default-ja,NTP,0,0,0,,Не болды! ?
Dialogue: 0,0:44:31.94,0:44:32.95,Default,,0,0,0,,Құдайым, маған көмектес
Dialogue: 0,0:44:32.98,0:44:33.96,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:44:33.05,0:44:36.41,*Default-ja,NTP,0,0,0,,Кешіріңіз, бұл ештеңе емес.
Dialogue: 0,0:44:34.82,0:44:36.03,Default,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:44:36.41,0:44:37.17,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:44:36.52,0:44:37.91,*Default-ja,NTP,0,0,0,,Кешіріңіз...
Dialogue: 0,0:44:39.78,0:44:40.71,Default,,0,0,0,,Сумида...
Dialogue: 0,0:44:39.85,0:44:40.68,*Default-ja,NTP,0,0,0,,Сумита...
Dialogue: 0,0:44:42.90,0:44:45.32,Default,,0,0,0,,Өтінемін... өтінемін...
Dialogue: 0,0:44:42.96,0:44:45.55,*Default-ja,NTP,0,0,0,,Өтінемін... қазірдің өзінде...
Dialogue: 0,0:44:45.66,0:44:46.82,*Default-ja,NTP,0,0,0,,Маған...
Dialogue: 0,0:44:45.71,0:44:49.22,Default,,0,0,0,,...маған жақсылық жасама!
Dialogue: 0,0:44:47.56,0:44:49.15,*Default-ja,NTP,0,0,0,,Оңай болма....!
Dialogue: 0,0:46:23.89,0:46:27.98,Default,,0,0,0,,Біз адамдар, амалсыз және абайсызда аспанның басына қолымызды созғанымыздай...
Dialogue: 0,0:46:24.06,0:46:27.96,*Default-ja,NTP,0,0,0,,Аспанға қол созу
Dialogue: 0,0:46:28.06,0:46:30.89,*Default-ja,NTP,0,0,0,,Осындай үлкен катамариді ұшыру
Dialogue: 0,0:46:28.07,0:46:30.92,Default,,0,0,0,,...және осындай масса мен өлшемдегі нәрсені ауаға ұшырды...
Dialogue: 0,0:46:30.94,0:46:34.74,Default,,0,0,0,,...біздің арманымыздан әлдеқайда алыс бір нәрсеге алысқа қарау...
Dialogue: 0,0:46:31.00,0:46:34.86,*Default-ja,NTP,0,0,0,,Мен есінен танып қалғанша артымдағы бірдеңеге қарап тұру
Dialogue: 0,0:46:39.71,0:46:45.71,Default,,0,0,0,,...Мен Тоно-кунның басқа балалардан неге ерекшеленетінін түсінгендей болдым.
Dialogue: 0,0:46:39.74,0:46:43.27,*Default-ja,NTP,0,0,0,,Тоно-кунның басқа адамдардан ерекшеленуінің себебі
Dialogue: 0,0:46:43.38,0:46:45.54,*Default-ja,NTP,0,0,0,,Мен аздап түсінгендей болдым.
Dialogue: 0,0:46:45.87,0:46:47.63,Default,,0,0,0,,Сонымен бірге...
Dialogue: 0,0:46:45.98,0:46:47.64,*Default-ja,NTP,0,0,0,,және бір уақытта
Dialogue: 0,0:46:47.90,0:46:53.80,Default,,0,0,0,,...Мен Тохно-кунның маған қарамайтынын анық түсіндім.
Dialogue: 0,0:46:48.08,0:46:51.38,*Default-ja,NTP,0,0,0,,Мен Тонокунның маған қарамай тұрғанын түсіндім.
Dialogue: 0,0:46:51.48,0:46:53.82,*Default-ja,NTP,0,0,0,,Мен анық байқадым
Dialogue: 0,0:46:58.10,0:47:02.52,Default,,0,0,0,,Сол себепті мен Тохно-кунға бір ауыз сөз айта алмадым.
Dialogue: 0,0:46:58.16,0:47:02.75,*Default-ja,NTP,0,0,0,,Сондықтан мен сол күні Тоно-куныма ештеңе айта алмадым.
Dialogue: 0,0:47:16.36,0:47:18.59,Default,,0,0,0,,Тохно-кун шынымен мейірімді, бірақ...
Dialogue: 0,0:47:16.54,0:47:18.98,*Default-ja,NTP,0,0,0,,Тоно-кун мейірімді, бірақ
Dialogue: 0,0:47:18.63,0:47:20.83,Default,,0,0,0,,Ол өте мейірімді, бірақ...
Dialogue: 0,0:47:19.15,0:47:21.11,*Default-ja,NTP,0,0,0,,Өте мейірімді болса да
Dialogue: 0,0:47:22.25,0:47:23.31,*Default-ja,NTP,0,0,0,,Бірақ...
Dialogue: 0,0:47:22.27,0:47:26.90,Default,,0,0,0,,Бірақ Тохно-кун әрқашан меннен алысқа қарайтын.
Dialogue: 0,0:47:23.42,0:47:25.01,*Default-ja,NTP,0,0,0,,Тоно-кун әрқашан
Dialogue: 0,0:47:25.12,0:47:29.78,*Default-ja,NTP,0,0,0,,Менен алыс... одан да алыс бірдеңеге қарап.
Dialogue: 0,0:47:26.93,0:47:30.45,Default,,0,0,0,,Менен алыс, алыстағы бір нәрсеге.
Dialogue: 0,0:47:40.43,0:47:44.26,Default,,0,0,0,,Мен Тохно-кунға оның шын қалағанын бере алмайтыныма сенімдімін.
Dialogue: 0,0:47:40.57,0:47:44.66,*Default-ja,NTP,0,0,0,,Тоно-кунға тілегім орындалмайды.
Dialogue: 0,0:47:44.71,0:47:48.14,Default,,0,0,0,,Бірақ бәрібір... соған қарамастан...
Dialogue: 0,0:47:44.77,0:47:46.47,*Default-ja,NTP,0,0,0,,Әлі де...
Dialogue: 0,0:47:46.64,0:47:49.51,*Default-ja,NTP,0,0,0,,Сонда да мен Тоно-кун туралы ойлаймын.
Dialogue: 0,0:47:48.23,0:47:51.80,Default,,0,0,0,,Ертең, келесі күні, тіпті одан кейін де...
Dialogue: 0,0:47:49.61,0:47:51.87,*Default-ja,NTP,0,0,0,,Әрине, ертең, арғы күні және одан әрі
Dialogue: 0,0:47:51.84,0:47:54.59,Default,,0,0,0,,...Мен оған әлі де дәрменсіз ғашық болатынымды білемін.
Dialogue: 0,0:47:51.98,0:47:54.61,*Default-ja,NTP,0,0,0,,Мен сені еш нәрсеге қарамастан сүйемін деп ойлаймын.
Dialogue: 0,0:47:57.27,0:48:03.12,Default,,0,0,0,,Тохно-кунды ғана ойлап, жылап ұйықтадым.
Dialogue: 0,0:47:57.32,0:48:00.22,*Default-ja,NTP,0,0,0,,Тоно-кунды ғана ойлау
Dialogue: 0,0:48:00.52,0:48:03.51,*Default-ja,NTP,0,0,0,,Жылап отырып, көзімді аштым
Dialogue: 0,0:49:29.48,0:49:31.70,Default,,0,0,0,,Мен қатты сезіндім...
Dialogue: 0,0:49:29.54,0:49:31.56,*Default-ja,NTP,0,0,0,,Қазір артқа қарасақ
Dialogue: 0,0:49:31.79,0:49:33.68,Default,,0,0,0,,...егер мен қазір артқа қарасам...
Dialogue: 0,0:49:31.91,0:49:36.04,*Default-ja,NTP,0,0,0,,Мен ол кісіге қайта қарағанымда, менде күшті сезім пайда болғанына сенімдімін.
Dialogue: 0,0:49:34.03,0:49:35.82,Default,,0,0,0,,...ол да артына қарар еді.
Dialogue: 0,0:49:49.35,0:49:53.64,Default,,0,0,0,,Токиоға баратын соңғы Чуо пойызы енді келіп жатыр.
Dialogue: 0,0:49:49.49,0:49:53.93,*Default-ja,NTP,0,0,0,,Чуо.Собу Токиоға бара жатқан соңғы пойыз келді
Dialogue: 0,0:51:09.63,0:51:11.73,Default,,0,0,0,,Жаңа жылға дейін тұру керек.
Dialogue: 0,0:51:09.67,0:51:11.70,*Default-ja,NTP,0,0,0,,Жаңа жыл болғанын қалаймын
Dialogue: 0,0:51:11.84,0:51:14.72,Default,,0,0,0,,Мен білемін, бірақ менде миллиондаған нәрсе бар.
Dialogue: 0,0:51:11.98,0:51:14.94,*Default-ja,NTP,0,0,0,,Иә...бірақ түрлі дайындықтар да бар.
Dialogue: 0,0:51:14.91,0:51:16.22,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:51:15.05,0:51:18.54,*Default-ja,NTP,0,0,0,,Дұрыс, оған жақсы нәрсе жасаңыз.
Dialogue: 0,0:51:16.39,0:51:18.35,Default,,0,0,0,,Оған міндетті түрде жақсы тамақ пісіріңіз, естідіңіз бе?
Dialogue: 0,0:51:18.61,0:51:19.16,Default,,0,0,0,,Вентиляциялық тесік
Dialogue: 0,0:51:19.32,0:51:22.18,Default,,0,0,0,,Егер мәселе туындаса, бізге қоңырау шалудан тартынба, Акари.
Dialogue: 0,0:51:19.55,0:51:22.38,*Default-ja,NTP,0,0,0,,Егер саған бірдеңе керек болса, маған хабарлас, Акари.
Dialogue: 0,0:51:22.41,0:51:23.56,Default,,0,0,0,,Ято ақша әкелмейтіндіктен, жартылай жұмыс, жартылай жұмыс.
Dialogue: 0,0:51:22.49,0:51:27.05,*Default-ja,NTP,0,0,0,,Жарайды. Келесі айда салтанатты жағдайда кездесеміз, көп уайымдамаңыз.
Dialogue: 0,0:51:23.75,0:51:27.10,Default,,0,0,0,,Келесі айда тойда көреміз, көп уайымдамаңыз.
Dialogue: 0,0:51:27.86,0:51:29.90,Default,,0,0,0,,Үйге барғаныңыз жөн. Суық
Dialogue: 0,0:51:27.96,0:51:30.02,*Default-ja,NTP,0,0,0,,Күн суық, енді қайтайық.
Dialogue: 0,0:51:50.29,0:51:53.46,Default,,0,0,0,,Кеше түнде мен алыстағы бір нәрсені түсіндім.
Dialogue: 0,0:51:50.55,0:51:53.91,*Default-ja,NTP,0,0,0,,Мен ескі түс көрдім
Dialogue: 0,0:51:54.68,0:51:58.14,*Default-ja,NTP,0,0,0,,Ол екеуміз әлі бала едік.
Dialogue: 0,0:51:54.73,0:51:58.19,Default,,0,0,0,,Ол да, мен де бала кезімізде.
Dialogue: 0,0:51:58.66,0:52:01.99,*Default-ja,NTP,0,0,0,,Кеше тапқан хаттың арқасы екеніне сенімдімін.
Dialogue: 0,0:51:58.67,0:52:01.89,Default,,0,0,0,,Кеше тапқан хаттың арқасы екеніне сенімдімін.
Dialogue: 0,0:52:55.63,0:52:56.38,Default,,0,0,0,,Мизуно-сан.
Dialogue: 0,0:52:55.75,0:52:56.68,*Default-ja,NTP,0,0,0,,Мизуно мырза
Dialogue: 0,0:52:56.39,0:52:57.49,Default,,0,0,0,,Иә, сэр?
Dialogue: 0,0:52:56.78,0:52:57.64,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:52:57.53,0:52:58.53,Default,,0,0,0,,Сол кездесуге уақытыңыз бар ма?
Dialogue: 0,0:52:57.75,0:52:58.77,*Default-ja,NTP,0,0,0,,Жиналыс өткізуге болады ма?
Dialogue: 0,0:52:58.64,0:52:59.61,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:52:58.88,0:52:59.97,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:53:08.25,0:53:13.41,Default,,0,0,0,,Өмір сүру әрекетінің өзі арқылы мұң бір жерде, бірде үйіліп жатыр.
Dialogue: 0,0:53:08.36,0:53:13.59,*Default-ja,NTP,0,0,0,,Тек өмір сүрген сайын мұң мен жерде жиналады.
Dialogue: 0,0:53:14.50,0:53:16.39,Default,,0,0,0,,Күнге кептіру үшін ілулі тұрған жаймаларда...
Dialogue: 0,0:53:14.80,0:53:18.23,*Default-ja,NTP,0,0,0,,Жуынатын бөлмеде кептірілген парақтарда да, тіс щеткаларында да.
Dialogue: 0,0:53:16.43,0:53:18.62,Default,,0,0,0,,... ваннаңыздағы жалғыз тіс щеткасы...
Dialogue: 0,0:53:18.66,0:53:20.82,Default,,0,0,0,,...немесе ұялы телефоныңыздың тарих журналдары.
Dialogue: 0,0:53:18.74,0:53:20.79,*Default-ja,NTP,0,0,0,,Сондай-ақ ұялы телефон тарихында
Dialogue: 0,0:53:42.98,0:53:46.11,Default,,0,0,0,,«Қазір де мен сені жақсы көремін...»
Dialogue: 0,0:53:43.13,0:53:46.06,*Default-ja,NTP,0,0,0,,Мен сені әлі де жақсы көремін
Dialogue: 0,0:53:46.12,0:53:50.69,Default,,0,0,0,,Мен үш жыл бірге жүрген қыз электронды пошта арқылы осылай деді.
Dialogue: 0,0:53:46.16,0:53:50.19,*Default-ja,NTP,0,0,0,,Мен үш жыл кездескен әйел электронды поштаға осылай жазды.
Dialogue: 0,0:53:51.17,0:53:55.87,Default,,0,0,0,,«Бірақ біз 1000 мәтіндік хабарламаны алға-артқа жазсақ та...»
Dialogue: 0,0:53:51.20,0:53:55.73,*Default-ja,NTP,0,0,0,,Бірақ біз мың рет хат алмасатын шығармыз.
Dialogue: 0,0:53:55.84,0:54:01.04,*Default-ja,NTP,0,0,0,,Мүмкін біздің жүрегіміз 1 сантиметрдей жақын болған шығар.
Dialogue: 0,0:53:55.88,0:54:00.21,Default,,0,0,0,,«... біздің жүрегіміз 1 сантиметрге де жақындамас еді.»
Dialogue: 0,0:54:08.69,0:54:12.05,*Default-ja,NTP,0,0,0,,Соңғы бірнеше жылда мен тек алға ұмтылғым келді.
Dialogue: 0,0:54:08.72,0:54:14.76,Default,,0,0,0,,Соңғы бірнеше жылда мен тек алға жылжып, қолым жетпеген нәрсеге қол жеткізгім келді...
Dialogue: 0,0:54:12.16,0:54:17.02,*Default-ja,NTP,0,0,0,,Мен қолым жетпейтін нәрсені ұстағым келеді, бірақ бұл нені білдіреді?
Dialogue: 0,0:54:14.79,0:54:17.06,Default,,0,0,0,,...бірақ мен оның не екенін ешқашан нақты анықтай алмадым.
Dialogue: 0,0:54:17.17,0:54:24.57,Default,,0,0,0,,Сол қиналған ойлардың қайдан шыққанын білмей, жұмысымды жалғастырдым.
Dialogue: 0,0:54:17.53,0:54:20.33,*Default-ja,NTP,0,0,0,,Бұл сезімді қорқыту деп атауға болады.
Dialogue: 0,0:54:20.43,0:54:24.56,*Default-ja,NTP,0,0,0,,Мен оның қайдан шыққанын білмей жұмыс істей беремін.
Dialogue: 0,0:54:24.61,0:54:29.29,Default,,0,0,0,,Сосын бір күні жүрегімнің солып бара жатқанын, оның ішінде ауырсынудан басқа ештеңе жоқ екенін түсіндім.
Dialogue: 0,0:54:24.67,0:54:29.54,*Default-ja,NTP,0,0,0,,Мен білмей тұрып, жүрегім күннен-күнге икемділігін жоғалтып, тек ауыратын болды.
Dialogue: 0,0:54:31.00,0:54:32.83,Default,,0,0,0,,Сосын, бір күні таңертең...
Dialogue: 0,0:54:31.07,0:54:32.80,*Default-ja,NTP,0,0,0,,Және бір таң
Dialogue: 0,0:54:32.87,0:54:38.87,Default,,0,0,0,,...баяғыдан бері байыпты және өткір сезімдерімді мүлде жоғалтқанымды түсінгенде...
Dialogue: 0,0:54:32.91,0:54:35.94,*Default-ja,NTP,0,0,0,,Менің сезімдерім бір кездері соншалықты салмақты және шынайы болды.
Dialogue: 0,0:54:36.05,0:54:38.95,*Default-ja,NTP,0,0,0,,Мен оның мүлдем жоғалғанын түсіндім
Dialogue: 0,0:54:39.27,0:54:41.59,Default,,0,0,0,,...Мен өзімнің шегімде екенімді білдім...
Dialogue: 0,0:54:39.35,0:54:41.61,*Default-ja,NTP,0,0,0,,Сіз өз шегіңізге жеткеніңізді білсеңіз
Dialogue: 0,0:54:41.68,0:54:43.42,Default,,0,0,0,,...жұмысымды тастадым.
Dialogue: 0,0:54:41.72,0:54:43.48,*Default-ja,NTP,0,0,0,,Компаниядан шығу
Dialogue: 0,0:55:09.26,0:55:11.66,Default,,0,0,0,,Кеше мен түс көрдім.
Dialogue: 0,0:55:09.38,0:55:11.68,*Default-ja,NTP,0,0,0,,Мен кеше түс көрдім
Dialogue: 0,0:55:11.82,0:55:14.00,Default,,0,0,0,,Бұрынғы арман.
Dialogue: 0,0:55:12.02,0:55:14.25,*Default-ja,NTP,0,0,0,,Бұрынғы арман
Dialogue: 0,0:55:14.37,0:55:18.33,Default,,0,0,0,,Түсімде екеуміз әлі он үште едік...
Dialogue: 0,0:55:14.48,0:55:18.32,*Default-ja,NTP,0,0,0,,Сол түсте біз небәрі 13 жаста едік
Dialogue: 0,0:55:18.37,0:55:22.71,Default,,0,0,0,,...көз көргендей қар жамылған кең далада тұрып.
Dialogue: 0,0:55:18.59,0:55:22.68,*Default-ja,NTP,0,0,0,,Қар басқан кең дала еді.
Dialogue: 0,0:55:22.75,0:55:26.96,Default,,0,0,0,,Алыстан үйлерде жарқыраған шамдар сирек, алыс және кең түрде орнатылды.
Dialogue: 0,0:55:22.79,0:55:26.92,*Default-ja,NTP,0,0,0,,Үйлердің шамдары алыстан ғана сирек көрінеді.
Dialogue: 0,0:55:27.03,0:55:32.37,*Default-ja,NTP,0,0,0,,Жаңа жауған қарда біз басып өткен із ғана қалды.
Dialogue: 0,0:55:27.12,0:55:32.13,Default,,0,0,0,,Жаңа жауған қарда біздің ізіміз ғана қалды.
Dialogue: 0,0:55:32.40,0:55:33.56,Default,,0,0,0,,Дәл солай...
Dialogue: 0,0:55:32.47,0:55:33.77,*Default-ja,NTP,0,0,0,,Осылайша
Dialogue: 0,0:55:33.87,0:55:37.36,*Default-ja,NTP,0,0,0,,Бір күні шие гүлін бірге көреміз деп үміттенемін.
Dialogue: 0,0:55:33.90,0:55:37.42,Default,,0,0,0,,...біз ойланбастан, бір күні...
Dialogue: 0,0:55:37.43,0:55:39.18,Default,,0,0,0,,...екеуміздің қолымыздан келеді...
Dialogue: 0,0:55:37.47,0:55:40.88,*Default-ja,NTP,0,0,0,,Ол да, мен де іркілмейміз.
Dialogue: 0,0:55:39.22,0:55:42.54,Default,,0,0,0,,...шиенің қайтадан бірге гүлдегенін көру.
Dialogue: 0,0:55:40.98,0:55:42.71,*Default-ja,NTP,0,0,0,,Мен солай ойладым
Dialogue: 0,0:55:42.85,0:55:50.00,*Default-ja,NTP,0,0,0,,Мен сені үнемі бір жерден іздеймін
Dialogue: 0,0:55:43.13,0:55:50.18,Default,,0,0,0,,Іздеймін өзіңді, Іздеймін фигураңды.
Dialogue: 0,0:55:50.20,0:55:53.70,*Default-ja,NTP,0,0,0,,Қарсы платформа, артқы аллеядағы терезе
Dialogue: 0,0:55:50.41,0:55:53.83,Default,,0,0,0,,Қарсы платформада немесе артқы аллеядағы терезе арқылы.
Dialogue: 0,0:55:53.86,0:55:57.34,*Default-ja,NTP,0,0,0,,Мен бұл жерде болмауым керек
Dialogue: 0,0:55:54.09,0:55:57.53,Default,,0,0,0,,Сенің ол жерде бола алмайтыныңды білсем де.
Dialogue: 0,0:55:57.80,0:56:04.81,*Default-ja,NTP,0,0,0,,Тілегім орындалса, мен саған дәл қазір келемін
Dialogue: 0,0:55:57.86,0:56:04.84,Default,,0,0,0,,Тілегім орындалса, мен сенің жаныңда болар едім.
Dialogue: 0,0:56:04.82,0:56:08.40,*Default-ja,NTP,0,0,0,,Менің қолымнан келмейтін іс жоқ
Dialogue: 0,0:56:05.08,0:56:08.48,Default,,0,0,0,,Менің қолымнан келмейтін іс болмас еді.
Dialogue: 0,0:56:08.42,0:56:14.81,*Default-ja,NTP,0,0,0,,Қолда бардың бәрін беремін
Dialogue: 0,0:56:08.67,0:56:14.86,Default,,0,0,0,,Мен сені құшақтау үшін бәріне тәуекел етер едім.
Dialogue: 0,0:56:23.68,0:56:30.91,*Default-ja,NTP,0,0,0,,Жалғыздығыңызды жеңілдету үшін мұны кез келген адам жасай алады.
Dialogue: 0,0:56:23.81,0:56:30.93,Default,,0,0,0,,Жалғыздықтан аулақ болу үшін, кез келген адам жасайды.
Dialogue: 0,0:56:31.18,0:56:38.18,*Default-ja,NTP,0,0,0,,Жұлдыздар құлағалы тұрған түн, сондықтан мен өзімді кінәлай алмаймын
Dialogue: 0,0:56:31.42,0:56:38.32,Default,,0,0,0,,Аспаннан жұлдыздар түсетіндей көрінетін бұл түнде мен өзімді өтірік айта алмаймын.
Dialogue: 0,0:56:38.19,0:56:45.47,*Default-ja,NTP,0,0,0,,Тағы бір маусым, жалықпа
Dialogue: 0,0:56:38.35,0:56:45.72,Default,,0,0,0,,Тағы бір рет, өшпесін, жыл мезгілдері.
Dialogue: 0,0:56:45.86,0:56:52.80,*Default-ja,NTP,0,0,0,,Тағы бір рет Ойнайтын кез келді
Dialogue: 0,0:56:46.09,0:56:52.99,Default,,0,0,0,,Тағы бір рет, мен бірге алданып қалған кезді қалаймын.
Dialogue: 0,0:56:53.20,0:57:00.30,*Default-ja,NTP,0,0,0,,Мен сені әрқашан бір жерден іздеймін
Dialogue: 0,0:56:53.48,0:57:00.52,Default,,0,0,0,,Іздеймін сені, Іздеймін бетіңнен.
Dialogue: 0,0:57:00.54,0:57:03.89,*Default-ja,NTP,0,0,0,,Жол қиылысында, Түсінде де
Dialogue: 0,0:57:00.81,0:57:04.26,Default,,0,0,0,,Қиылыста, Түсімде.
Dialogue: 0,0:57:04.15,0:57:07.52,*Default-ja,NTP,0,0,0,,Мен бұл жерде болмауым керек
Dialogue: 0,0:57:04.43,0:57:07.98,Default,,0,0,0,,Сенің ол жерде бола алмайтыныңды білсем де.
Dialogue: 0,0:57:07.91,0:57:15.07,*Default-ja,NTP,0,0,0,,Егер бір ғажайып орын алатын болса, мен оны дәл қазір көрсеткім келеді.
Dialogue: 0,0:57:08.23,0:57:15.21,Default,,0,0,0,,Егер кереметтер орын алса, мен дәл қазір көрсеткім келеді
Dialogue: 0,0:57:15.13,0:57:18.57,*Default-ja,NTP,0,0,0,,Жаңа таң, менің болашақ өзім
Dialogue: 0,0:57:15.37,0:57:18.87,Default,,0,0,0,,жаңа таң, мен енді кім боламын,
Dialogue: 0,0:57:18.72,0:57:24.82,*Default-ja,NTP,0,0,0,,Мен айта алмаған «Мен сені сүйемін» сөзі
Dialogue: 0,0:57:18.98,0:57:24.96,Default,,0,0,0,,және мен ешқашан айтпаған «Мен сені сүйемін» деген сөздер.
Dialogue: 0,0:57:33.98,0:57:40.00,*Default-ja,NTP,0,0,0,,Жазғы естеліктер айналаға келеді
Dialogue: 0,0:57:34.19,0:57:38.48,Default,,0,0,0,,Жаз туралы естеліктер айналамда
Dialogue: 0,0:57:41.89,0:57:47.86,*Default-ja,NTP,0,0,0,,Кенет өшіп қалған жүрек соғысы
Dialogue: 0,0:57:42.14,0:57:47.94,Default,,0,0,0,,және кенет тоқтап қалған жүрек соғысы.
Dialogue: 0,0:57:48.94,0:57:56.43,*Default-ja,NTP,0,0,0,,Мен сені үнемі бір жерден іздеймін
Dialogue: 0,0:57:49.15,0:57:56.60,Default,,0,0,0,,Іздеймін сені, Іздеймін ылғи фигураңды.
Dialogue: 0,0:57:56.71,0:58:00.37,Default,,0,0,0,,Қалада таң ата, Сакураги-чода.
Dialogue: 0,0:57:56.75,0:58:00.03,*Default-ja,NTP,0,0,0,,Таң атқанда Сакурагичо қаласында
Dialogue: 0,0:58:00.25,0:58:03.72,*Default-ja,NTP,0,0,0,,Мен мұндай жерге келмеуім керек еді.
Dialogue: 0,0:58:00.53,0:58:03.97,Default,,0,0,0,,Сенің ол жерде бола алмайтыныңды білсем де.
Dialogue: 0,0:58:04.08,0:58:11.10,*Default-ja,NTP,0,0,0,,Тілегім орындалса, дәл қазір саған келемін
Dialogue: 0,0:58:04.28,0:58:11.35,Default,,0,0,0,,Тілегім орындалса, жаныңда болар едім.
Dialogue: 0,0:58:11.25,0:58:14.72,*Default-ja,NTP,0,0,0,,Менің қолымнан келмейтін іс жоқ
Dialogue: 0,0:58:11.56,0:58:15.02,Default,,0,0,0,,Менің қолымнан келмейтін іс болмас еді.
Dialogue: 0,0:58:14.84,0:58:18.42,*Default-ja,NTP,0,0,0,,Қолда бардың бәрін беремін
Dialogue: 0,0:58:15.12,0:58:18.61,Default,,0,0,0,,Мен сені құшақтау үшін бәріне тәуекел етер едім.
Dialogue: 0,0:58:18.64,0:58:25.67,*Default-ja,NTP,0,0,0,,Мен әрқашан сіздің шығармаларыңызды бір жерден іздеймін.
Dialogue: 0,0:58:19.03,0:58:25.90,Default,,0,0,0,,Іздеймін сені, Үнемі бір үзіндің болса да іздеймін.
Dialogue: 0,0:58:25.79,0:58:29.27,*Default-ja,NTP,0,0,0,,Саяхат дүкені Газет бұрышы
Dialogue: 0,0:58:26.10,0:58:29.52,Default,,0,0,0,,Мен баратын дүкенде, газеттің бұрышында.
Dialogue: 0,0:58:29.40,0:58:32.82,*Default-ja,NTP,0,0,0,,Бұндай жерде болуы мүмкін емес.
Dialogue: 0,0:58:29.75,0:58:33.12,Default,,0,0,0,,Сенің ол жерде бола алмайтыныңды білсем де.
Dialogue: 0,0:58:33.15,0:58:40.21,*Default-ja,NTP,0,0,0,,Егер бір ғажайып орын алса, мен оны дәл қазір көрсеткім келеді.
Dialogue: 0,0:58:33.56,0:58:40.41,Default,,0,0,0,,Егер кереметтер орын алса, мен дәл қазір көрсеткім келеді
Dialogue: 0,0:58:40.23,0:58:43.77,*Default-ja,NTP,0,0,0,,Жаңа таң, менің болашақ өзім
Dialogue: 0,0:58:40.61,0:58:44.05,Default,,0,0,0,,жаңа таң, мен енді кім боламын,
Dialogue: 0,0:58:43.89,0:58:47.46,*Default-ja,NTP,0,0,0,,Мен айта алмаған «Сүйемін» деген сөз
Dialogue: 0,0:58:44.27,0:58:47.75,Default,,0,0,0,,және мен ешқашан айтпаған «Мен сені сүйемін» деген сөздер.
Dialogue: 0,0:58:47.81,0:58:54.86,*Default-ja,NTP,0,0,0,,Мен сенің күлкіңді бір жерден іздеймін
Dialogue: 0,0:58:48.12,0:58:55.16,Default,,0,0,0,,Мен сенің күлкіңді бір жерден іздеймін.
Dialogue: 0,0:58:55.07,0:58:58.46,*Default-ja,NTP,0,0,0,,Темір жол өткелінде жедел пойыз күтіп тұр
Dialogue: 0,0:58:55.37,0:58:58.83,Default,,0,0,0,,Темір жол өткелінде экспресстің өтуін күту.
Dialogue: 0,0:58:58.60,0:59:02.12,*Default-ja,NTP,0,0,0,,Мен бұл жерде болмауым керек
Dialogue: 0,0:58:59.05,0:59:02.38,Default,,0,0,0,,Сенің ол жерде бола алмайтыныңды білсем де.
Dialogue: 0,0:59:02.29,0:59:09.47,*Default-ja,NTP,0,0,0,,Өмір қайталанса, Мен саған қайта-қайта келемін
Dialogue: 0,0:59:02.60,0:59:09.86,Default,,0,0,0,,Егер мен өмірді қайта өмір сүре алсам, мен әрқашан сенің жаныңда болар едім.
Dialogue: 0,0:59:09.70,0:59:13.38,*Default-ja,NTP,0,0,0,,Енді маған ештеңе керек емес
Dialogue: 0,0:59:10.09,0:59:13.67,Default,,0,0,0,,Өйткені мен ештеңе қаламас едім
Dialogue: 0,0:59:13.55,0:59:20.34,*Default-ja,NTP,0,0,0,,Сізден басқа маңызды нәрселер бар.
Dialogue: 0,0:59:13.93,0:59:20.50,Default,,0,0,0,,сенен қымбат.
Dialogue: 0,1:02:37.77,1:02:43.73,Default,,0,0,0,,Соңы
