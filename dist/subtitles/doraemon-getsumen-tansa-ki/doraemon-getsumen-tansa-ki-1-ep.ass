Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.48,0:00:27.81,Default,,0,0,0,,(сықырлау дыбысы)
Dialogue: 0,0:00:47.17,0:00:51.17,Default,,0,0,0,,(дыбыстық сигнал дыбысы)
Dialogue: 0,0:01:17.95,0:01:19.28,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:01:19.45,0:01:20.16,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:01:23.95,0:01:25.46,Default,,0,0,0,,Нобита!
Dialogue: 0,0:01:27.21,0:01:29.25,Default,,0,0,0,,Чикокуда Чикокуда!
Dialogue: 0,0:01:29.42,0:01:31.63,Default,,0,0,0,,Ой...
Dialogue: 0,0:01:31.75,0:01:33.21,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:36.30,0:01:39.14,Default,,0,0,0,,Тозақ! тозақ!
Dialogue: 0,0:01:39.26,0:01:41.97,Default,,0,0,0,,Келесі кезекте айдың жұмбағы.
Dialogue: 0,0:01:42.85,0:01:47.44,Default,,0,0,0,,Жапонияның Айға жіберген ай зонды Nayotake
Dialogue: 0,0:01:47.56,0:01:50.15,Default,,0,0,0,,Камераға жұмбақ ақ көлеңке түсірілді.
Dialogue: 0,0:01:50.98,0:01:52.94,Default,,0,0,0,,Міне бейне
Dialogue: 0,0:01:53.69,0:01:55.61,Default,,0,0,0,,Қаңырап қалған айда
Dialogue: 0,0:01:55.74,0:01:58.32,Default,,0,0,0,,Тоцуджо Ақ көлеңке пайда болады
Dialogue: 0,0:01:58.70,0:01:59.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:00.45,0:02:02.49,Default,,0,0,0,,Бұл бейне соңғы болып табылады
Dialogue: 0,0:02:02.66,0:02:05.29,Default,,0,0,0,,Nayotake-пен байланыс тоқтатылды.
Dialogue: 0,0:02:05.41,0:02:08.67,Default,,0,0,0,,Мамандар арасында күн алауынан туындаған магниттік дауылдар...
Dialogue: 0,0:02:08.83,0:02:10.38,Default,,0,0,0,,Мүмкін қазір...
Dialogue: 0,0:02:10.50,0:02:11.67,Default,,0,0,0,,Нобита!
Dialogue: 0,0:02:13.13,0:02:15.34,Default,,0,0,0,,Сіз теледидар көріп отырсыз ба?
Dialogue: 0,0:02:15.63,0:02:18.84,Default,,0,0,0,,Иә, иә, кеттік!
Dialogue: 0,0:02:19.01,0:02:23.43,Default,,0,0,0,,Сенпай, тоқта!
Dialogue: 0,0:02:31.52,0:02:33.19,Default,,0,0,0,,Бұл бөтен планета екені сөзсіз!
Dialogue: 0,0:02:33.69,0:02:36.48,Default,,0,0,0,,Бұл бөтен адам! Бұл дұрыс!
Dialogue: 0,0:02:36.82,0:02:39.70,Default,,0,0,0,,Бұл линзаның шаңы. Бұл дұрыс!
Dialogue: 0,0:02:40.20,0:02:42.20,Default,,0,0,0,,Эктоплазма!
Dialogue: 0,0:02:42.70,0:02:44.53,Default,,0,0,0,,Эктоплазма дегеніміз не?
Dialogue: 0,0:02:44.70,0:02:46.87,Default,,0,0,0,,Сіз жат планеталықпын дедіңіз!
Dialogue: 0,0:02:47.20,0:02:49.16,Default,,0,0,0,,Я, мен оны уақытында жасадым~
Dialogue: 0,0:02:49.29,0:02:51.04,Default,,0,0,0,,Нобита-сан (Нобита) иә?
Dialogue: 0,0:02:51.25,0:02:52.75,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:02:52.88,0:02:56.21,Default,,0,0,0,,Ай жаңалықтары, Ай зонды туралы.
Dialogue: 0,0:02:56.38,0:02:58.59,Default,,0,0,0,,А, солай.
Dialogue: 0,0:02:59.01,0:02:59.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:00.01,0:03:02.39,Default,,0,0,0,,Тіпті шетелдіктер де... (Нобита) Иә!
Dialogue: 0,0:03:04.85,0:03:09.10,Default,,0,0,0,,Жұмбақ ақ көлеңке. Оның шынайы тұлғасы қандай?
Dialogue: 0,0:03:09.64,0:03:11.35,Default,,0,0,0,,Бұл ай қояны!
Dialogue: 0,0:03:12.73,0:03:14.27,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:03:14.90,0:03:17.23,Default,,0,0,0,,Иә! Не... неге?
Dialogue: 0,0:03:17.48,0:03:20.82,Default,,0,0,0,,Айда қоян бар дейді, солай ма?
Dialogue: 0,0:03:21.57,0:03:23.99,Default,,0,0,0,,Күріш тортын осылай жейсің...
Dialogue: 0,0:03:24.20,0:03:25.24,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:26.66,0:03:28.12,Default,,0,0,0,,Ноби-кун
Dialogue: 0,0:03:28.49,0:03:31.58,Default,,0,0,0,,Дәлізде тұр!
Dialogue: 0,0:03:32.00,0:03:34.21,Default,,0,0,0,,Баршаңызға қайырлы таң
Dialogue: 0,0:03:34.33,0:03:36.50,Default,,0,0,0,,Жасау… Жасау…
Dialogue: 0,0:03:36.75,0:03:39.71,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:03:39.80,0:03:44.80,Default,,0,0,0,,♪～
Dialogue: 0,0:05:03.92,0:05:09.18,Default,,0,0,0,,～♪
Dialogue: 0,0:05:10.05,0:05:11.68,Default,,0,0,0,,Айдағы қоян?
Dialogue: 0,0:05:11.85,0:05:14.35,Default,,0,0,0,,Хя~ха! Хахахаха
Dialogue: 0,0:05:14.52,0:05:16.69,Default,,0,0,0,,Бұл мүлдем Нобита-кунға ұқсайды.
Dialogue: 0,0:05:16.89,0:05:20.11,Default,,0,0,0,,Ах! Тіпті Дораэмон-ды мазақ етіңіз!
Dialogue: 0,0:05:20.23,0:05:21.40,Default,,0,0,0,,Жер
Dialogue: 0,0:05:21.52,0:05:23.94,Default,,0,0,0,,Барлығы мені мазақ ету керек.
Dialogue: 0,0:05:24.49,0:05:25.36,Default,,0,0,0,,Тіпті ересектер
Dialogue: 0,0:05:25.53,0:05:28.03,Default,,0,0,0,,Айда қоян бар деді.
Dialogue: 0,0:05:28.20,0:05:29.95,Default,,0,0,0,,Сіз қашан жоғалып кетуді шештіңіз?
Dialogue: 0,0:05:30.70,0:05:32.95,Default,,0,0,0,,Өз көзіммен көргенше
Dialogue: 0,0:05:33.08,0:05:35.54,Default,,0,0,0,,Мен ай қоянына сенемін!
Dialogue: 0,0:05:35.71,0:05:38.83,Default,,0,0,0,,Хмм, әрине.
Dialogue: 0,0:05:38.96,0:05:41.67,Default,,0,0,0,,Айырмашылық жоқ деп айтуға болмайды.
Dialogue: 0,0:05:41.79,0:05:42.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:44.09,0:05:47.18,Default,,0,0,0,,Исецу клубының мүшелерінің төсбелгісі!
Dialogue: 0,0:05:47.93,0:05:49.18,Default,,0,0,0,,Ұятсыз ба?
Dialogue: 0,0:05:49.59,0:05:53.14,Default,,0,0,0,,Дүниеде әртүрлі идеялары бар адамдар бар.
Dialogue: 0,0:05:53.26,0:05:57.19,Default,,0,0,0,,Бұл белгіні тағу кезінде сіз пікірлестерге қосыласыз.
Dialogue: 0,0:05:57.31,0:05:59.10,Default,,0,0,0,,Әртүрлі ойлар дегеніміз не?
Dialogue: 0,0:05:59.56,0:06:00.40,Default,,0,0,0,,Бұл шексіз тұйық
Dialogue: 0,0:06:00.52,0:06:04.07,Default,,0,0,0,,Жер дөңгелек және күнді айналады.
Dialogue: 0,0:06:04.23,0:06:06.24,Default,,0,0,0,,Мұны бәрі біледі, солай ма?
Dialogue: 0,0:06:06.40,0:06:08.07,Default,,0,0,0,,Тіпті Нобита-кун
Dialogue: 0,0:06:08.24,0:06:10.82,Default,,0,0,0,,Саето дегеніміз не? Sae дегеніміз не?
Dialogue: 0,0:06:10.95,0:06:11.82,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:06:12.53,0:06:16.29,Default,,0,0,0,,Дегенмен, бұрын бұл гелиоцентрлік теория деп аталды.
Dialogue: 0,0:06:16.41,0:06:19.25,Default,,0,0,0,,Бұл қате пікір болып саналды.
Dialogue: 0,0:06:19.87,0:06:21.08,Default,,0,0,0,,Одан да ертерек
Dialogue: 0,0:06:21.21,0:06:24.59,Default,,0,0,0,,Жер тегіс және ғаламның орталығында болса
Dialogue: 0,0:06:24.71,0:06:29.76,Default,,0,0,0,,Күн, ай және жұлдыздар оның айналасында айналады деп есептелді.
Dialogue: 0,0:06:30.05,0:06:32.26,Default,,0,0,0,,Бұл геоцентрлік теория деп аталады.
Dialogue: 0,0:06:32.55,0:06:36.43,Default,,0,0,0,,Ахахха! Қарт адамдар ақымақ
Dialogue: 0,0:06:36.77,0:06:39.73,Default,,0,0,0,,Мен өзім туралы жиі айтамын.
Dialogue: 0,0:06:40.44,0:06:41.40,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:06:41.52,0:06:43.73,Default,,0,0,0,,Геоцентристік теория дұрыс!
Dialogue: 0,0:06:44.02,0:06:45.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:46.11,0:06:47.99,Default,,0,0,0,,Осы белгіні тағыңыз
Dialogue: 0,0:06:49.20,0:06:50.36,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:55.79,0:06:59.46,Default,,0,0,0,,Келіңіздер! Дүниенің ақырын көрейік!
Dialogue: 0,0:07:02.04,0:07:03.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:10.97,0:07:12.22,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:12.34,0:07:14.30,Default,,0,0,0,,Тек төсбелгі таққандар үшін
Dialogue: 0,0:07:14.47,0:07:17.10,Default,,0,0,0,,Басқаша айтқанда, тек Isetsu клубының мүшелері үшін.
Dialogue: 0,0:07:17.22,0:07:19.89,Default,,0,0,0,,Бұл геоцентрлік әлем болады.
Dialogue: 0,0:07:21.64,0:07:23.73,Default,,0,0,0,,Ах! Кеме құлап жатыр!
Dialogue: 0,0:07:23.86,0:07:25.44,Default,,0,0,0,,Ах! Жарайды
Dialogue: 0,0:07:25.57,0:07:28.73,Default,,0,0,0,,Басқалар үшін бұл гелиоцентрлік әлем.
Dialogue: 0,0:07:28.86,0:07:30.45,Default,,0,0,0,,Белгіңізді шешіңіз
Dialogue: 0,0:07:36.16,0:07:38.83,Default,,0,0,0,,Не? Бұл тек теңіз бе?
Dialogue: 0,0:07:38.95,0:07:40.08,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:42.83,0:07:45.00,Default,,0,0,0,,Бұл қызық болды!
Dialogue: 0,0:07:45.13,0:07:46.59,Default,,0,0,0,,Эй, мысалы
Dialogue: 0,0:07:46.71,0:07:50.13,Default,,0,0,0,,Кейбір адамдар Цучиноко мен Юкиоға сенеді.
Dialogue: 0,0:07:50.26,0:07:52.80,Default,,0,0,0,,Мен бармын десем, ол мен бар әлемге айнала ма?
Dialogue: 0,0:07:53.01,0:07:54.34,Default,,0,0,0,,Мен түсінемін, бірақ...
Dialogue: 0,0:07:54.47,0:07:57.76,Default,,0,0,0,,Мен Цучинокомен ойнайтын құралдарды шығарған жоқпын!
Dialogue: 0,0:07:58.51,0:07:59.77,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:07:59.89,0:08:03.27,Default,,0,0,0,,Ай қоянды мазақ еткеніңе ренжідің бе?
Dialogue: 0,0:08:03.39,0:08:05.19,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:08:05.94,0:08:07.44,Default,,0,0,0,,Жоғарыда айтқанымдай
Dialogue: 0,0:08:07.57,0:08:11.36,Default,,0,0,0,,Мен де Нобитаның ойы қате деп айта алмаймын.
Dialogue: 0,0:08:11.49,0:08:15.20,Default,,0,0,0,,Бұрын «Айдың қараңғы жағы, өркениет теориясы» деген теория болған.
Dialogue: 0,0:08:16.41,0:08:19.16,Default,,0,0,0,,Нағыз миниатюралық энциклопедия!
Dialogue: 0,0:08:19.41,0:08:21.79,Default,,0,0,0,,Айдың айналуы және айналуы!
Dialogue: 0,0:08:24.33,0:08:27.04,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:08:28.63,0:08:29.63,Default,,0,0,0,,​​О?
Dialogue: 0,0:08:29.75,0:08:33.17,Default,,0,0,0,,Мынау күн, мынау жер мен ай
Dialogue: 0,0:08:33.72,0:08:38.05,Default,,0,0,0,,Ай әрқашан жерге бір жағын көрсетеді.
Dialogue: 0,0:08:38.22,0:08:43.14,Default,,0,0,0,,Сондықтан зымыран айға ұшпай тұрып, арғы жағында не бар екенін көре алмадық.
Dialogue: 0,0:08:43.77,0:08:45.65,Default,,0,0,0,,Айдың артында ауа бар
Dialogue: 0,0:08:45.77,0:08:50.40,Default,,0,0,0,,Кейбір адамдар Айдағы адамдар өркениетке зиян келтіреді деп ойлады.
Dialogue: 0,0:08:50.57,0:08:52.32,Default,,0,0,0,,Қызық емес!
Dialogue: 0,0:08:52.44,0:08:54.65,Default,,0,0,0,,Біздің де айда өмір сүре алатынымызға сенейік!
Dialogue: 0,0:08:54.78,0:08:56.57,Default,,0,0,0,,Олай болса, бастайық!
Dialogue: 0,0:08:56.82,0:08:58.99,Default,,0,0,0,,Айдың артында ауа бар
Dialogue: 0,0:08:59.12,0:09:00.70,Default,,0,0,0,,Мұнда тірі заттар өмір сүре алады!
Dialogue: 0,0:09:05.62,0:09:09.29,Default,,0,0,0,,Хаха! Сізде скафандр болмаса да, уайымдамаңыз!
Dialogue: 0,0:09:09.42,0:09:12.42,Default,,0,0,0,,Гравитация да Жердегідей!
Dialogue: 0,0:09:12.76,0:09:13.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:17.01,0:09:18.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:25.85,0:09:27.35,Default,,0,0,0,,Иә? Жер...
Dialogue: 0,0:09:27.48,0:09:29.77,Default,,0,0,0,,Айдың қараңғы жағының шетінде.
Dialogue: 0,0:09:30.48,0:09:32.78,Default,,0,0,0,,Айдың екінші жағы бүгін түн
Dialogue: 0,0:09:32.94,0:09:36.45,Default,,0,0,0,,Жерден айырмашылығы ол жүздеген сағатқа созылады.
Dialogue: 0,0:09:36.90,0:09:40.12,Default,,0,0,0,,өтіңіз! Мен сенің қанша ұйықтайтыныңды қызғанамын
Dialogue: 0,0:09:40.24,0:09:41.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:41.45,0:09:45.33,Default,,0,0,0,,Бірақ қоян жоқ, ал...
Dialogue: 0,0:09:45.50,0:09:46.75,Default,,0,0,0,,Бұзушылық!
Dialogue: 0,0:09:47.83,0:09:49.42,Default,,0,0,0,,Қараңғы және суық емес пе?
Dialogue: 0,0:09:49.83,0:09:51.63,Default,,0,0,0,,Шамды қазір қосыңыз
Dialogue: 0,0:09:52.46,0:09:54.59,Default,,0,0,0,,Пиккаригоке!
Dialogue: 0,0:09:55.80,0:09:59.09,Default,,0,0,0,,Аздап себіңіз, ол тастарға жабысып, көбейеді.
Dialogue: 0,0:10:04.02,0:10:06.64,Default,,0,0,0,,Уау, жарқырап барады!
Dialogue: 0,0:10:08.31,0:10:12.44,Default,,0,0,0,,Мүк жақсы, бірақ мен жасыл түсті де қалаймын.
Dialogue: 0,0:10:12.57,0:10:14.98,Default,,0,0,0,,Оны өмір сүруге қолайлы жерге айналдырайық!
Dialogue: 0,0:10:16.15,0:10:19.49,Default,,0,0,0,,Сол кратерде қоян патшалығын құрайық!
Dialogue: 0,0:10:20.78,0:10:23.58,Default,,0,0,0,,Өсімдіктерге ауа мен күн сәулесінен басқа қажет
Dialogue: 0,0:10:23.70,0:10:25.66,Default,,0,0,0,,Маған су керек
Dialogue: 0,0:10:26.50,0:10:28.66,Default,,0,0,0,,Ягучи кез келген жерде!
Dialogue: 0,0:10:29.00,0:10:30.00,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:10:30.17,0:10:31.63,Default,,0,0,0,,Міне!
Dialogue: 0,0:10:31.92,0:10:33.17,Default,,0,0,0,,Келесі…
Dialogue: 0,0:10:33.54,0:10:36.09,Default,,0,0,0,,Жылдам өсімдік тұқымын себіңіз!
Dialogue: 0,0:10:37.42,0:10:39.01,Default,,0,0,0,,Ол қандай өсімдік?
Dialogue: 0,0:10:39.43,0:10:42.68,Default,,0,0,0,,Хехе, есейген соң асыға күт!
Dialogue: 0,0:10:47.02,0:10:47.89,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:10:48.02,0:10:50.48,Default,,0,0,0,,Керемет! Олар қазірдің өзінде өсіп жатыр!
Dialogue: 0,0:10:50.60,0:10:52.19,Default,,0,0,0,,Аяқтау...
Dialogue: 0,0:10:53.48,0:10:55.69,Default,,0,0,0,,Күмбезді іске қосыңыз!
Dialogue: 0,0:10:56.07,0:10:58.03,Default,,0,0,0,,Кет, кет!
Dialogue: 0,0:11:02.78,0:11:04.95,Default,,0,0,0,,(Бум! дыбысы)
Dialogue: 0,0:11:05.91,0:11:07.91,Default,,0,0,0,,Метеорит құласа да
Dialogue: 0,0:11:08.04,0:11:10.37,Default,,0,0,0,,Күмбез патшалықты қорғайды
Dialogue: 0,0:11:11.00,0:11:13.83,Default,,0,0,0,,Дораемон Қоянды да жасайық!
Dialogue: 0,0:11:13.96,0:11:15.38,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:11:16.38,0:11:18.84,Default,,0,0,0,,Жануарларға арналған балшық!
Dialogue: 0,0:11:19.01,0:11:21.30,Default,,0,0,0,,Қоян! қоян!
Dialogue: 0,0:11:21.43,0:11:23.22,Default,,0,0,0,,Қоян! қоян!
Dialogue: 0,0:11:24.14,0:11:25.14,Default,,0,0,0,,Дайын!
Dialogue: 0,0:11:25.26,0:11:27.06,Default,,0,0,0,,О~ Қайсысы?
Dialogue: 0,0:11:27.22,0:11:28.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:30.89,0:11:32.31,Default,,0,0,0,,Құбыжық?
Dialogue: 0,0:11:32.44,0:11:33.81,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:34.73,0:11:36.48,Default,,0,0,0,,Қайта құрастырайық
Dialogue: 0,0:11:37.82,0:11:39.40,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:11:39.99,0:11:41.90,Default,,0,0,0,,Бұл өте жақсы емес пе?
Dialogue: 0,0:11:42.03,0:11:45.53,Default,,0,0,0,,Мен ат қойғым келеді, өйткені бұл ай қоян...
Dialogue: 0,0:11:45.66,0:11:48.04,Default,,0,0,0,,Мм...Ай мен қоян...
Dialogue: 0,0:11:48.16,0:11:49.79,Default,,0,0,0,,Moobit туралы не деуге болады?
Dialogue: 0,0:11:49.91,0:11:50.75,Default,,0,0,0,,Һм… Ха-ха-ха
Dialogue: 0,0:11:51.08,0:11:52.75,Default,,0,0,0,,Moovit туралы шешім қабылданды!
Dialogue: 0,0:11:54.88,0:11:55.71,Default,,0,0,0,,Ммммм!
Dialogue: 0,0:11:55.84,0:11:56.75,Default,,0,0,0,,Ара!
Dialogue: 0,0:11:57.29,0:11:59.00,Default,,0,0,0,,Уау, қозғалды!
Dialogue: 0,0:11:59.13,0:12:01.67,Default,,0,0,0,,Ай әлеміндегі Адам мен Хауа.
Dialogue: 0,0:12:01.80,0:12:03.72,Default,,0,0,0,,Мен оны Сунео мен Джанға көрсетсем ше?
Dialogue: 0,0:12:04.22,0:12:05.22,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:05.55,0:12:09.27,Default,,0,0,0,,Бірдеңе болса, патшалықты ол әдемі болғаннан кейін көрсетіңізші.
Dialogue: 0,0:12:09.39,0:12:11.18,Default,,0,0,0,,Мен сізді таң қалдырғым келеді.
Dialogue: 0,0:12:11.73,0:12:15.40,Default,,0,0,0,,Дұрыс, үйге қайтайық!
Dialogue: 0,0:12:16.94,0:12:18.57,Default,,0,0,0,,Мен патшалықты сұрадым!
Dialogue: 0,0:12:18.69,0:12:19.78,Default,,0,0,0,,Ммммм!
Dialogue: 0,0:12:19.94,0:12:21.36,Default,,0,0,0,,Ара!
Dialogue: 0,0:12:21.61,0:12:22.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:22.74,0:12:25.57,Default,,0,0,0,,Қояндар патшалығын құру үшін қанша уақыт қажет?
Dialogue: 0,0:12:25.70,0:12:28.95,Default,,0,0,0,,Тезірек көмектесейік.
Dialogue: 0,0:12:29.08,0:12:29.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:30.04,0:12:32.04,Default,,0,0,0,,Ноби-чан Дора-чан
Dialogue: 0,0:12:32.96,0:12:35.04,Default,,0,0,0,,Иә? Қазір бастайсыз ба?
Dialogue: 0,0:12:35.46,0:12:37.33,Default,,0,0,0,,Бүгін Джугоя, солай ма?
Dialogue: 0,0:12:37.46,0:12:40.96,Default,,0,0,0,,Мен айды көруге арналған тұшпара мен пампа шөптерін алғым келеді.
Dialogue: 0,0:12:41.30,0:12:43.17,Default,,0,0,0,,А... Мен Одангомын!
Dialogue: 0,0:12:43.30,0:12:44.88,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,0:12:45.01,0:12:47.76,Default,,0,0,0,,Ноби-чан, маған 5-6 пампа шөп ағашын беріңізші.
Dialogue: 0,0:12:47.93,0:12:50.47,Default,,0,0,0,,Пампа шөптері қайда?
Dialogue: 0,0:12:50.64,0:12:54.06,Default,,0,0,0,,Артқы тауда өседі, солай ма? Сусуки, Сусуки...
Dialogue: 0,0:12:54.19,0:12:55.98,Default,,0,0,0,,Бұл тым алыс
Dialogue: 0,0:12:56.15,0:12:59.15,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:13:09.49,0:13:11.83,Default,,0,0,0,,Дораэмонның бір Оданго жағы
Dialogue: 0,0:13:11.95,0:13:14.41,Default,,0,0,0,,Мен де Дораяки сатып алуды жоспарлап отырмын.
Dialogue: 0,0:13:14.54,0:13:15.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:16.00,0:13:16.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:23.26,0:13:24.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:25.17,0:13:26.01,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:28.84,0:13:31.35,Default,,0,0,0,,Сен де пампа шөбін жинауға келдің бе?
Dialogue: 0,0:13:45.36,0:13:46.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:51.03,0:13:54.04,Default,,0,0,0,,(жәндіктердің дауысы)
Dialogue: 0,0:13:56.50,0:13:58.33,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:13:58.46,0:14:00.29,Default,,0,0,0,,Баяғыдан
Dialogue: 0,0:14:00.42,0:14:03.63,Default,,0,0,0,,Адамдар айға қарап өмір сүрген.
Dialogue: 0,0:14:04.21,0:14:05.97,Default,,0,0,0,,Біртүрлі.
Dialogue: 0,0:14:06.26,0:14:10.55,Default,,0,0,0,,Кагуяхиме 1000 жыл бұрынғы оқиға болса да.
Dialogue: 0,0:14:11.30,0:14:15.31,Default,,0,0,0,,Бәлкім, бір күні мен айға саяхаттайтын шығармын
Dialogue: 0,0:14:15.72,0:14:17.60,Default,,0,0,0,,Иә? Ахххх
Dialogue: 0,0:14:17.73,0:14:18.89,Default,,0,0,0,,Дора-чан
Dialogue: 0,0:14:19.06,0:14:22.40,Default,,0,0,0,,Тек тамақ жесең, айды көре алмайсың, солай ма?
Dialogue: 0,0:14:22.86,0:14:25.73,Default,,0,0,0,,Өйткені мен айды көп көрдім.
Dialogue: 0,0:14:25.86,0:14:28.53,Default,,0,0,0,,Сіз әдетте оған мұқият қарамайсыз, солай ма?
Dialogue: 0,0:14:28.78,0:14:31.45,Default,,0,0,0,,Жоқ, мен жаңа ғана айға бардым.
Dialogue: 0,0:14:31.57,0:14:33.91,Default,,0,0,0,,Тағы біртүрлі ештеңе айтпа, Дора-чан.
Dialogue: 0,0:14:34.08,0:14:35.49,Default,,0,0,0,,Айға қарайық
Dialogue: 0,0:14:35.62,0:14:38.66,Default,,0,0,0,,Иә, мүлде хахаха
Dialogue: 0,0:14:41.04,0:14:44.92,Default,,0,0,0,,Сенпай, тоқта!
Dialogue: 0,0:14:45.30,0:14:47.88,Default,,0,0,0,,Баршаңызға қайырлы таң
Dialogue: 0,0:14:48.01,0:14:49.93,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:14:50.38,0:14:53.05,Default,,0,0,0,,Аа, үй бөлмесі басталды.
Dialogue: 0,0:14:53.18,0:14:54.39,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:54.72,0:14:57.85,Default,,0,0,0,,Бүгін мен ауысатын студентті таныстырамын.
Dialogue: 0,0:14:57.98,0:15:00.19,Default,,0,0,0,,Енді өзіңізді таныстырыңыз.
Dialogue: 0,0:15:04.11,0:15:07.23,Default,,0,0,0,,Менің атым Рука Цукино. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:15:07.36,0:15:08.36,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:15:08.49,0:15:10.28,Default,,0,0,0,,Сол бала кеше...
Dialogue: 0,0:15:10.53,0:15:13.78,Default,,0,0,0,,Неге, анау жігіт! Мен қалпақ киемін
Dialogue: 0,0:15:13.91,0:15:16.24,Default,,0,0,0,,Шынымен де жиіркенішті.
Dialogue: 0,0:15:16.62,0:15:19.46,Default,,0,0,0,,Артқы орынға отырыңыз.
Dialogue: 0,0:15:19.62,0:15:20.71,Default,,0,0,0,,Иә
Dialogue: 0,0:15:21.50,0:15:23.04,Default,,0,0,0,,Шығу, шығу
Dialogue: 0,0:15:25.25,0:15:27.63,Default,,0,0,0,,Ихихихихихи
Dialogue: 0,0:15:29.63,0:15:30.63,Default,,0,0,0,,Ах
Dialogue: 0,0:15:31.13,0:15:32.80,Default,,0,0,0,,Иә? Уау...
Dialogue: 0,0:15:36.14,0:15:37.47,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:15:37.64,0:15:39.31,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:41.23,0:15:42.81,Default,,0,0,0,,Ағымдағы жарық...
Dialogue: 0,0:15:43.40,0:15:46.40,Default,,0,0,0,,Не? Ноби Чикоку ма?
Dialogue: 0,0:15:48.03,0:15:51.20,Default,,0,0,0,,Орналасқан жері туралы
Dialogue: 0,0:15:51.49,0:15:52.49,Default,,0,0,0,,（）
Dialogue: 0,0:15:56.16,0:15:57.41,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:16:01.12,0:16:02.67,Default,,0,0,0,,Бұл керемет, Лука-кун!
Dialogue: 0,0:16:02.79,0:16:05.00,Default,,0,0,0,,Сіз қандай жаттығу жасап жатырсыз?
Dialogue: 0,0:16:05.25,0:16:07.46,Default,,0,0,0,,Эстафеталық якорь Бұл анық!
Dialogue: 0,0:16:07.59,0:16:10.13,Default,,0,0,0,,Менің алыптарыма қосылғың келе ме?
Dialogue: 0,0:16:10.55,0:16:13.47,Default,,0,0,0,,Иә! (Харуо) Нигеро!
Dialogue: 0,0:16:15.26,0:16:17.43,Default,,0,0,0,,Менің суым жетпеген шығар...
Dialogue: 0,0:16:19.10,0:16:20.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:21.31,0:16:22.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:27.86,0:16:28.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:30.65,0:16:31.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:33.99,0:16:37.87,Default,,0,0,0,,Сенпай, тоқта!
Dialogue: 0,0:16:41.20,0:16:42.37,Default,,0,0,0,,Лука-кун
Dialogue: 0,0:16:42.87,0:16:44.87,Default,,0,0,0,,Жаңа мектептегі алғашқы күніңіз қалай өтті?
Dialogue: 0,0:16:45.50,0:16:47.33,Default,,0,0,0,,Ол бұрынғы мектептен айтарлықтай ерекшеленеді ме?
Dialogue: 0,0:16:47.96,0:16:49.67,Default,,0,0,0,,Бұрынғы мектеп?
Dialogue: 0,0:16:50.13,0:16:51.30,Default,,0,0,0,,Ах (Декисуги) Иә?
Dialogue: 0,0:16:52.80,0:16:55.26,Default,,0,0,0,,Көремін, көремін... Иә.
Dialogue: 0,0:16:56.89,0:16:58.93,Default,,0,0,0,,Бұл жерде де өте қызық.
Dialogue: 0,0:16:59.05,0:17:00.22,Default,,0,0,0,,А... иә
Dialogue: 0,0:17:00.35,0:17:01.97,Default,,0,0,0,,♪ Сосола Сола Сола
Dialogue: 0,0:17:02.10,0:17:03.73,Default,,0,0,0,,♪ Қоянның биі
Dialogue: 0,0:17:04.23,0:17:07.23,Default,,0,0,0,,♪ Талатта ратта ратта пиокко пиокко…
Dialogue: 0,0:17:07.94,0:17:10.86,Default,,0,0,0,,Айдағы қоян нағыз!
Dialogue: 0,0:17:10.98,0:17:13.07,Default,,0,0,0,,Бұл не? Онда маған дәлелді көрсет!
Dialogue: 0,0:17:13.19,0:17:14.24,Default,,0,0,0,,Маған көрсет!
Dialogue: 0,0:17:14.40,0:17:15.90,Default,,0,0,0,,Қайтадан орындау
Dialogue: 0,0:17:16.61,0:17:19.41,Default,,0,0,0,,Айда тірі заттар бар деп ойлайсың ба?
Dialogue: 0,0:17:19.91,0:17:24.37,Default,,0,0,0,,Не? Менің ойымша, бұл романтикалық болады
Dialogue: 0,0:17:24.50,0:17:26.75,Default,,0,0,0,,Онда тірі заттардың өмір сүруі мүмкін емес.
Dialogue: 0,0:17:28.58,0:17:29.67,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:29.79,0:17:33.71,Default,,0,0,0,,Кейін қателессең де, кеш!
Dialogue: 0,0:17:34.92,0:17:36.18,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:17:37.09,0:17:39.89,Default,,0,0,0,,Қояндар патшалығында не болып жатыр?
Dialogue: 0,0:17:40.01,0:17:43.27,Default,,0,0,0,,Жақсы! Барып көрейік
Dialogue: 0,0:17:43.39,0:17:44.77,Default,,0,0,0,,Хмм... Йотто
Dialogue: 0,0:17:44.93,0:17:46.94,Default,,0,0,0,,Айдың арғы бетіне!
Dialogue: 0,0:17:47.10,0:17:47.94,Default,,0,0,0,,О!
Dialogue: 0,0:17:48.06,0:17:49.61,Default,,0,0,0,,Ал оған дейін... (Нобита) Әй!
Dialogue: 0,0:17:52.11,0:17:53.61,Default,,0,0,0,,Белгіні тағу керек
Dialogue: 0,0:17:53.73,0:17:54.57,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:54.69,0:17:56.28,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:17:56.53,0:17:57.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:12.63,0:18:14.96,Default,,0,0,0,,Ей, жер бетінде тасбақалар да бар...
Dialogue: 0,0:18:15.30,0:18:16.47,Default,,0,0,0,,Ммм
Dialogue: 0,0:18:16.63,0:18:18.93,Default,,0,0,0,,Жердің тілі - Танджун.
Dialogue: 0,0:18:19.05,0:18:20.97,Default,,0,0,0,,Сіз оны тез меңгеретін сияқтысыз
Dialogue: 0,0:18:21.30,0:18:23.93,Default,,0,0,0,,Ха~ Мені шошытпа
Dialogue: 0,0:18:30.06,0:18:31.23,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:18:31.40,0:18:32.98,Default,,0,0,0,,Тасбақалар қандай баяу!
Dialogue: 0,0:18:33.15,0:18:35.65,Default,,0,0,0,,Менің аяғымның жылдамдығын бағаламайсың ба?
Dialogue: 0,0:18:36.99,0:18:38.74,Default,,0,0,0,,Мозо! Эй!
Dialogue: 0,0:18:38.86,0:18:40.61,Default,,0,0,0,,Иә, иә, тыныш бол.
Dialogue: 0,0:18:44.28,0:18:45.83,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:18:47.62,0:18:48.66,Default,,0,0,0,,Ай?
Dialogue: 0,0:18:48.83,0:18:50.50,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:18:50.67,0:18:51.75,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:18:52.75,0:18:55.42,Default,,0,0,0,,Лұқа! Есікті тез жабыңыз!
Dialogue: 0,0:18:55.55,0:18:57.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:57.84,0:18:59.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:00.88,0:19:02.01,Default,,0,0,0,,Ай…
Dialogue: 0,0:19:02.55,0:19:03.80,Default,,0,0,0,,Я...
Dialogue: 0,0:19:04.01,0:19:07.47,Default,,0,0,0,,Эй, Мозо, бұл керемет деп ойламайсың ба?
Dialogue: 0,0:19:07.60,0:19:09.02,Default,,0,0,0,,Егер бұл бала болса, мен сенімдімін...
Dialogue: 0,0:19:09.18,0:19:10.85,Default,,0,0,0,,Нобита? Ах!
Dialogue: 0,0:19:11.40,0:19:13.11,Default,,0,0,0,,Үйдесің бе?
Dialogue: 0,0:19:13.40,0:19:14.44,Default,,0,0,0,,Мозо!
Dialogue: 0,0:19:16.86,0:19:19.53,Default,,0,0,0,,«Мен үйдемін» деп те айтпайсың.
Dialogue: 0,0:19:21.78,0:19:23.95,Default,,0,0,0,,Иә? Әй
Dialogue: 0,0:19:24.78,0:19:27.45,Default,,0,0,0,,Сіз ойнауға шығып үлгердіңіз.
Dialogue: 0,0:19:28.58,0:19:31.37,Default,,0,0,0,,Мен тамақ күтіп тұрдым.
Dialogue: 0,0:19:36.88,0:19:38.01,Default,,0,0,0,,Тағам…
Dialogue: 0,0:19:38.46,0:19:40.47,Default,,0,0,0,,Не болды, Лука?
Dialogue: 0,0:19:40.97,0:19:43.51,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,0:19:53.19,0:19:56.23,Default,,0,0,0,,Керемет! Көл мен арал пайда болды!
Dialogue: 0,0:19:56.40,0:19:57.90,Default,,0,0,0,,Аралды зерттейік!
Dialogue: 0,0:19:58.03,0:19:59.48,Default,,0,0,0,,Иә! Хехехе
Dialogue: 0,0:20:03.24,0:20:04.87,Default,,0,0,0,,Бамбук жарқырайды
Dialogue: 0,0:20:04.99,0:20:06.70,Default,,0,0,0,,Бұл Пиккари Даке.
Dialogue: 0,0:20:06.83,0:20:09.87,Default,,0,0,0,,Сіз тез өсетін өсімдік тұқымын септіңіз, солай ма?
Dialogue: 0,0:20:10.00,0:20:10.70,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:20:11.41,0:20:14.58,Default,,0,0,0,,Бірақ маңызды Мобит қайда?
Dialogue: 0,0:20:14.75,0:20:15.58,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:15.71,0:20:17.42,Default,,0,0,0,,Бибибиб…
Dialogue: 0,0:20:17.59,0:20:18.59,Default,,0,0,0,,Ах! (Нобита) Иә?
Dialogue: 0,0:20:19.13,0:20:20.46,Default,,0,0,0,,Би~ Би!
Dialogue: 0,0:20:20.59,0:20:21.88,Default,,0,0,0,,Ара~
Dialogue: 0,0:20:22.01,0:20:22.84,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:20:23.05,0:20:24.89,Default,,0,0,0,,Бит! Б-б-б-б-б-б-б-б…
Dialogue: 0,0:20:25.01,0:20:26.76,Default,,0,0,0,,Нигер! Күте тұрыңыз!
Dialogue: 0,0:20:26.93,0:20:28.56,Default,,0,0,0,,Бибибибибиби…
Dialogue: 0,0:20:30.35,0:20:31.60,Default,,0,0,0,,Эй!
Dialogue: 0,0:20:31.73,0:20:34.27,Default,,0,0,0,,Бізді ұмыттыңыз ба?
Dialogue: 0,0:20:34.52,0:20:36.36,Default,,0,0,0,,Б-Б-Б-Б-Б-Б-Б-Б
Dialogue: 0,0:20:36.48,0:20:37.77,Default,,0,0,0,,Бибібі…
Dialogue: 0,0:20:37.94,0:20:40.57,Default,,0,0,0,,Бибібибі...
Dialogue: 0,0:20:41.11,0:20:41.94,Default,,0,0,0,,Ашық!?
Dialogue: 0,0:20:42.57,0:20:45.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:47.95,0:20:50.04,Default,,0,0,0,,Қызық, қайда бардың...
Dialogue: 0,0:20:50.16,0:20:52.04,Default,,0,0,0,,Уф! Дораемон!
Dialogue: 0,0:20:52.16,0:20:53.79,Default,,0,0,0,,Бұл! сурет?
Dialogue: 0,0:20:55.29,0:20:56.29,Default,,0,0,0,,Хмм?
Dialogue: 0,0:20:56.50,0:20:59.17,Default,,0,0,0,,Ой, бала туды.
Dialogue: 0,0:20:59.34,0:21:01.26,Default,,0,0,0,,Өте сүйкімді~
Dialogue: 0,0:21:01.96,0:21:03.84,Default,,0,0,0,,Үңгір тым кішкентай сияқты.
Dialogue: 0,0:21:03.97,0:21:06.55,Default,,0,0,0,,Үй салуды үйретейін
Dialogue: 0,0:21:06.68,0:21:07.72,Default,,0,0,0,,Ұнады!
Dialogue: 0,0:21:08.47,0:21:10.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:10.93,0:21:12.14,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:21:12.43,0:21:13.81,Default,,0,0,0,,Бамбукты біріктіру
Dialogue: 0,0:21:13.98,0:21:15.73,Default,,0,0,0,,Төбені жапырақтармен жабыңыз
Dialogue: 0,0:21:15.85,0:21:17.52,Default,,0,0,0,,Ой-ау!
Dialogue: 0,0:21:18.23,0:21:19.11,Default,,0,0,0,,Уф
Dialogue: 0,0:21:19.73,0:21:23.07,Default,,0,0,0,,Сондай-ақ, өртті қалай жағу керек...
Dialogue: 0,0:21:24.15,0:21:26.99,Default,,0,0,0,,Көптеген Moovits жиналады.
Dialogue: 0,0:21:27.86,0:21:28.99,Default,,0,0,0,,Ара!
Dialogue: 0,0:21:29.62,0:21:32.49,Default,,0,0,0,,Егер сіз оны қалай қолданғаныңызға мұқият болсаңыз, бұл қорқынышты емес.
Dialogue: 0,0:21:32.62,0:21:33.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:34.54,0:21:36.92,Default,,0,0,0,,Мочицуки жиынтығы!
Dialogue: 0,0:21:41.50,0:21:42.84,Default,,0,0,0,,Хаха хехехе
Dialogue: 0,0:21:43.17,0:21:45.34,Default,,0,0,0,,Виви~! Ммм~!
Dialogue: 0,0:21:46.17,0:21:47.84,Default,,0,0,0,,Дәмді Дәмді!
Dialogue: 0,0:21:48.01,0:21:51.31,Default,,0,0,0,,Өйткені, айдағы қоян мочиді соғуы керек.
Dialogue: 0,0:21:54.85,0:21:56.27,Default,,0,0,0,,Ммм~
Dialogue: 0,0:21:56.64,0:21:59.44,Default,,0,0,0,,Дәмді көрінеді! Сізге көп рахмет
Dialogue: 0,0:21:59.56,0:22:01.19,Default,,0,0,0,,Тек мен үшін бе?
Dialogue: 0,0:22:01.36,0:22:02.19,Default,,0,0,0,,Ммм?
Dialogue: 0,0:22:02.52,0:22:05.36,Default,,0,0,0,,Мен де сені жараттым.
Dialogue: 0,0:22:05.53,0:22:06.53,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:07.57,0:22:08.86,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:22:08.99,0:22:10.57,Default,,0,0,0,,Нобиби? (Нобита) Қайтарыңыз!
Dialogue: 0,0:22:10.70,0:22:13.20,Default,,0,0,0,,Мен адам заттарына қызығамын.
Dialogue: 0,0:22:13.37,0:22:14.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:14.54,0:22:16.16,Default,,0,0,0,,Нобиби~
Dialogue: 0,0:22:16.54,0:22:17.62,Default,,0,0,0,,Сәлем
Dialogue: 0,0:22:17.75,0:22:21.38,Default,,0,0,0,,Дораэмон Құдай туралы және ол өте қу!
Dialogue: 0,0:22:56.87,0:22:59.54,Default,,0,0,0,,Диаволо мырза жақында келді.
Dialogue: 0,0:23:00.54,0:23:02.63,Default,,0,0,0,,Капитан Годарт
Dialogue: 0,0:23:02.92,0:23:06.09,Default,,0,0,0,,Еспалды әлі таппадың ба?
Dialogue: 0,0:23:06.59,0:23:09.42,Default,,0,0,0,,Иә, мүмкін жұлдыздар
Dialogue: 0,0:23:09.55,0:23:11.59,Default,,0,0,0,,Мен бірдеңе іздедім...
Dialogue: 0,0:23:11.72,0:23:13.26,Default,,0,0,0,,Хе хехе
Dialogue: 0,0:23:13.39,0:23:16.26,Default,,0,0,0,,Бұрыштарды кесіп жатқандай емес.
Dialogue: 0,0:23:16.43,0:23:17.85,Default,,0,0,0,,Эфир радары
Dialogue: 0,0:23:17.97,0:23:20.73,Default,,0,0,0,,Саған беріп тұрсам да.
Dialogue: 0,0:23:21.44,0:23:24.94,Default,,0,0,0,,Сіз айтқандай, бұл радар жауап бермейді.
Dialogue: 0,0:23:25.15,0:23:27.90,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:23:28.82,0:23:29.86,Default,,0,0,0,,Уау
Dialogue: 0,0:23:30.61,0:23:31.70,Default,,0,0,0,,Осы шөлдеген таулардың тереңінде—
Dialogue: 0,0:23:33.62,0:23:35.28,Default,,0,0,0,,Менің дөрекілігімді кешіріңіз.
Dialogue: 0,0:23:36.03,0:23:39.12,Default,,0,0,0,,Жарайды, мына жұлдызды алыңыз
Dialogue: 0,0:23:39.29,0:23:41.79,Default,,0,0,0,,Эфирдің күші өте маңызды
Dialogue: 0,0:23:41.96,0:23:46.71,Default,,0,0,0,,Еспалды міндетті түрде ұстап алып, менің алдыма әкел!
Dialogue: 0,0:23:47.42,0:23:50.47,Default,,0,0,0,,Бұл сіздің соңғы мүмкіндігіңіз
Dialogue: 0,0:23:50.63,0:23:51.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:55.85,0:23:59.98,Default,,0,0,0,,Капитан Годар, Диаволо мырза ше?
Dialogue: 0,0:24:00.10,0:24:02.64,Default,,0,0,0,,Біз сияқты жүк әскерлері үшін,
Dialogue: 0,0:24:02.81,0:24:05.11,Default,,0,0,0,,Бұл сіздің соңғы мүмкіндігіңіз сияқты.
Dialogue: 0,0:24:05.40,0:24:06.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:06.86,0:24:08.28,Default,,0,0,0,,Бірақ капитан
Dialogue: 0,0:24:08.40,0:24:11.24,Default,,0,0,0,,Шынында да S-Pal деген нәрсе бар ма?
Dialogue: 0,0:24:11.36,0:24:14.32,Default,,0,0,0,,Бұл мифтік тіршілік иесі ғой...
Dialogue: 0,0:24:14.49,0:24:17.33,Default,,0,0,0,,Ол ескі әңгімелерден құтқарушы, солай ма?
Dialogue: 0,0:24:17.49,0:24:19.66,Default,,0,0,0,,Ол бәрібір адам ғой.
Dialogue: 0,0:24:19.83,0:24:23.83,Default,,0,0,0,,Тіпті адам ғана емес, жын да деген аңыз бар.
Dialogue: 0,0:24:23.96,0:24:25.67,Default,,0,0,0,,Қалай болғанда да, сіз таба алмайтын нәрсе
Dialogue: 0,0:24:25.79,0:24:27.84,Default,,0,0,0,,Бұл біздің кінәміз емес!
Dialogue: 0,0:24:28.55,0:24:29.80,Default,,0,0,0,,Олай айтпа
Dialogue: 0,0:24:30.13,0:24:32.84,Default,,0,0,0,,Espal іздеу - біздің міндетіміз.
Dialogue: 0,0:24:32.97,0:24:34.59,Default,,0,0,0,,Кез келген легенда
Dialogue: 0,0:24:34.72,0:24:37.26,Default,,0,0,0,,От жоқ жерде түтін болмайды.
Dialogue: 0,0:24:38.31,0:24:41.68,Default,,0,0,0,,Пайғамбарлықтың уақыты жақындап қалды.
Dialogue: 0,0:24:42.18,0:24:43.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:43.19,0:24:45.02,Default,,0,0,0,,Енді кеттік.
Dialogue: 0,0:24:45.19,0:24:46.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:25:05.29,0:25:07.33,Default,,0,0,0,,Не жақсы?
Dialogue: 0,0:25:07.46,0:25:09.84,Default,,0,0,0,,Егер ол лайық болмаса, мен оны қабылдамаймын!
Dialogue: 0,0:25:10.67,0:25:11.80,Default,,0,0,0,,Джажан~н!
Dialogue: 0,0:25:12.21,0:25:13.63,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:25:13.76,0:25:16.72,Default,,0,0,0,,Бұл Ай қоян патшалығына шақыру!
Dialogue: 0,0:25:17.09,0:25:18.39,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:25:18.51,0:25:21.06,Default,,0,0,0,,Қояндар патшалығында қояндар бар ма?
Dialogue: 0,0:25:21.22,0:25:23.06,Default,,0,0,0,,Сіз ол жерде болуыңыз мүмкін емес.
Dialogue: 0,0:25:23.23,0:25:25.73,Default,,0,0,0,,Айда тірі организмдер өмір сүре алмайды.
Dialogue: 0,0:25:26.02,0:25:29.48,Default,,0,0,0,,Бұл міндетті емес.
Dialogue: 0,0:25:29.77,0:25:31.23,Default,,0,0,0,,Мені де қосуыңызды өтінемін.
Dialogue: 0,0:25:31.36,0:25:32.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:32.98,0:25:34.07,Default,,0,0,0,,Лука-кун!
Dialogue: 0,0:25:35.90,0:25:37.32,Default,,0,0,0,,Лука жақсы.
Dialogue: 0,0:25:38.07,0:25:39.32,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:25:39.74,0:25:42.08,Default,,0,0,0,,Ай патшалығы дегеніміз не?
Dialogue: 0,0:25:44.41,0:25:45.54,Default,,0,0,0,,(Кашиваги) Олай деу дұрыс па?
Dialogue: 0,0:25:46.37,0:25:47.42,Default,,0,0,0,,Дегенмен, менің ойымша, бұл жақсы жоспар.
Dialogue: 0,0:25:47.54,0:25:49.04,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:25:49.17,0:25:51.54,Default,,0,0,0,,Әлі де тамаша бөлме
Dialogue: 0,0:25:51.67,0:25:53.38,Default,,0,0,0,,Шулы
Dialogue: 0,0:25:54.17,0:25:56.22,Default,,0,0,0,,Иә? сен?
Dialogue: 0,0:25:56.34,0:26:00.72,Default,,0,0,0,,Бұл Лука, ауыспалы студент. Оны ай қызықтырады.
Dialogue: 0,0:26:00.93,0:26:01.93,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:26:02.10,0:26:03.93,Default,,0,0,0,,I Дораемон
Dialogue: 0,0:26:04.06,0:26:06.06,Default,,0,0,0,,Маған бидғат клубына қосылуға рұқсат етіңіз
Dialogue: 0,0:26:06.18,0:26:07.35,Default,,0,0,0,,​​Итомо!
Dialogue: 0,0:26:07.85,0:26:10.06,Default,,0,0,0,,Бұл мүшенің белгісі.
Dialogue: 0,0:26:12.57,0:26:13.82,Default,,0,0,0,,Хаха хехехе~
Dialogue: 0,0:26:13.94,0:26:16.07,Default,,0,0,0,,Барлықтарыңыз төсбелгіңізді тағып көрдіңіздер ме?
Dialogue: 0,0:26:16.32,0:26:17.45,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:26:17.57,0:26:19.03,Default,,0,0,0,,Бұл жеткілікті!
Dialogue: 0,0:26:19.28,0:26:20.45,Default,,0,0,0,,Секір!!
Dialogue: 0,0:26:20.57,0:26:23.66,Default,,0,0,0,,Айдағы қоян патшалығына!
Dialogue: 0,0:26:29.29,0:26:31.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:40.22,0:26:42.47,Default,,0,0,0,,Бұл қоян патшалығы ма?
Dialogue: 0,0:26:42.64,0:26:44.81,Default,,0,0,0,,Бұл Кагуяхиме әлемі сияқты!
Dialogue: 0,0:26:44.93,0:26:46.14,Default,,0,0,0,,Өтірікші!
Dialogue: 0,0:26:46.27,0:26:49.98,Default,,0,0,0,,Айдың тартылыс күші Жердікінен әлдеқайда аз болуы керек!
Dialogue: 0,0:26:50.10,0:26:52.65,Default,,0,0,0,,Енді ойлап қарасам... Хохохохохо
Dialogue: 0,0:26:52.98,0:26:55.82,Default,,0,0,0,,Ал, егжей-тегжейге алаңдамаңыз.
Dialogue: 0,0:26:55.98,0:26:57.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:04.62,0:27:06.12,Default,,0,0,0,,Ммм~
Dialogue: 0,0:27:07.16,0:27:10.25,Default,,0,0,0,,У... Қоян? (Сунео) Міне... болды!
Dialogue: 0,0:27:10.37,0:27:11.58,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:27:11.88,0:27:14.79,Default,,0,0,0,,Эй, эй, шық, Гокуроу.
Dialogue: 0,0:27:14.92,0:27:18.01,Default,,0,0,0,,Хаха, бәрі қалай болды?
Dialogue: 0,0:27:19.05,0:27:20.47,Default,,0,0,0,,Хехехехе~
Dialogue: 0,0:27:20.59,0:27:23.43,Default,,0,0,0,,Тек Дораемон, Құдайдың емі
Dialogue: 0,0:27:51.54,0:27:53.88,Default,,0,0,0,,Қала үлкейіп барады!
Dialogue: 0,0:27:54.08,0:27:56.21,Default,,0,0,0,,Сіз көптеген жетістіктерге жеттіңіз.
Dialogue: 0,0:27:56.38,0:27:57.88,Default,,0,0,0,,Б-Б-Хмм?
Dialogue: 0,0:27:58.05,0:28:00.47,Default,,0,0,0,,Б-Б-Б-Б-Б-Б
Dialogue: 0,0:28:05.35,0:28:07.22,Default,,0,0,0,,Ара!
Dialogue: 0,0:28:07.39,0:28:11.14,Default,,0,0,0,,Конфеттиге қараңдар! Көптеген!
Dialogue: 0,0:28:12.23,0:28:15.06,Default,,0,0,0,,Олар бізді қарсы алады!
Dialogue: 0,0:28:17.82,0:28:19.73,Default,,0,0,0,,Иә? Джан!
Dialogue: 0,0:28:19.90,0:28:20.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:21.57,0:28:24.49,Default,,0,0,0,,Күріштен жасалған кірпіштен үй салу!
Dialogue: 0,0:28:26.57,0:28:28.66,Default,,0,0,0,,Мынау мочи бетоны ма?
Dialogue: 0,0:28:29.16,0:28:32.08,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:28:32.25,0:28:33.25,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:28:33.67,0:28:34.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:36.42,0:28:37.42,Default,,0,0,0,,Бибі…
Dialogue: 0,0:28:38.09,0:28:39.25,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:28:41.26,0:28:42.26,Default,,0,0,0,,Сен оны білесің бе, Аводөл? (Аводөл) Ах… өте
Dialogue: 0,0:28:43.22,0:28:44.26,Default,,0,0,0,,Сен оны білесің бе, Аводөл? (Аводөл) Ах… өте
Dialogue: 0,0:28:44.38,0:28:45.93,Default,,0,0,0,,Б-Б-Б…
Dialogue: 0,0:28:46.26,0:28:50.06,Default,,0,0,0,,Ммм! Бибі! Ммм! Бибі!
Dialogue: 0,0:28:50.39,0:28:52.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:52.43,0:28:54.35,Default,,0,0,0,,Керемет мереке!
Dialogue: 0,0:28:54.48,0:28:56.52,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:29:00.94,0:29:02.44,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:29:04.45,0:29:08.45,Default,,0,0,0,,Ахаха! Бамбук өсіндісі мен сәбіз смузи
Dialogue: 0,0:29:11.12,0:29:13.46,Default,,0,0,0,,Пуха~ Уми!
Dialogue: 0,0:29:13.58,0:29:15.42,Default,,0,0,0,,Күріш торттары мен балмұздақ жеуге болады!
Dialogue: 0,0:29:16.29,0:29:17.67,Default,,0,0,0,,Тіпті оның есту қабілетінен айырылғаны туралы қауесет те бар
Dialogue: 0,0:29:20.75,0:29:21.80,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,0:29:21.92,0:29:24.84,Default,,0,0,0,,Сол сәбіз тәрізді мұнараға барайық.
Dialogue: 0,0:29:24.97,0:29:26.30,Default,,0,0,0,,Бибі!
Dialogue: 0,0:29:27.51,0:29:28.60,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:29:28.72,0:29:31.10,Default,,0,0,0,,Қазірдің өзінде! Бұл қауіпті емес пе?
Dialogue: 0,0:29:31.56,0:29:32.56,Default,,0,0,0,,Бибі!
Dialogue: 0,0:29:32.68,0:29:34.98,Default,,0,0,0,,Бұл бала Нобита-санға бара жатыр.
Dialogue: 0,0:29:35.14,0:29:38.48,Default,,0,0,0,,Елеусіз бөліктер дәл солай.
Dialogue: 0,0:29:38.61,0:29:40.32,Default,,0,0,0,,Оны Nobit деп атаңыз.
Dialogue: 0,0:29:40.48,0:29:42.57,Default,,0,0,0,,Дәмді! (Нобита) Ех!
Dialogue: 0,0:29:42.98,0:29:45.61,Default,,0,0,0,,Иә? Сіз болуы мүмкін...
Dialogue: 0,0:29:46.45,0:29:49.12,Default,,0,0,0,,Мовит менің көзілдірігіме қарап тұрды ма?
Dialogue: 0,0:29:49.24,0:29:50.07,Default,,0,0,0,,Жаңа?
Dialogue: 0,0:29:50.45,0:29:52.91,Default,,0,0,0,,Көзілдірікті өзіңіз жасадыңыз ба?
Dialogue: 0,0:29:53.04,0:29:53.95,Default,,0,0,0,,Тіпті оның есту қабілетінен айырылғаны туралы қауесет те бар
Dialogue: 0,0:29:54.08,0:29:55.33,Default,,0,0,0,,Жоқ, мен қорқамын...
Dialogue: 0,0:29:55.46,0:29:56.50,Default,,0,0,0,,Ааа...
Dialogue: 0,0:29:56.96,0:30:00.34,Default,,0,0,0,,Бұл не... көріну қиын.
Dialogue: 0,0:30:00.50,0:30:04.13,Default,,0,0,0,,Көзілдірік – заттарды анық көруге арналған құрал.
Dialogue: 0,0:30:04.26,0:30:06.34,Default,,0,0,0,,Бұл құрал емес пе?
Dialogue: 0,0:30:06.51,0:30:08.59,Default,,0,0,0,,Хахаха Нови!
Dialogue: 0,0:30:09.39,0:30:10.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:30:10.97,0:30:12.18,Default,,0,0,0,,Нобби!
Dialogue: 0,0:30:12.35,0:30:13.64,Default,,0,0,0,,Нобит-чан
Dialogue: 0,0:30:14.22,0:30:17.39,Default,,0,0,0,,Сен маған қоян патшалығын көрсете аласың ба?
Dialogue: 0,0:30:17.64,0:30:18.48,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:30:20.19,0:30:21.44,Default,,0,0,0,,Ноббиби~!
Dialogue: 0,0:30:21.86,0:30:23.36,Default,,0,0,0,,Нобиноби!
Dialogue: 0,0:30:24.03,0:30:26.24,Default,,0,0,0,,Иә? (Нобита) Оның жағдайы жақсы.
Dialogue: 0,0:30:26.36,0:30:27.78,Default,,0,0,0,,Мен кітабымды ұмытып қалдым.
Dialogue: 0,0:30:27.90,0:30:29.45,Default,,0,0,0,,Бұл сөзсіз Нобит.
Dialogue: 0,0:30:34.87,0:30:39.12,Default,,0,0,0,,♪ Сосола Сола Сола қоян биі
Dialogue: 0,0:30:39.29,0:30:43.46,Default,,0,0,0,,♪ Талатта ратта ратта ратта ратта ратта ла
Dialogue: 0,0:30:43.59,0:30:47.47,Default,,0,0,0,,♪ Аяқпен теуіп, тепкіңіз Пёкко Пёкко биі
Dialogue: 0,0:30:48.05,0:30:52.22,Default,,0,0,0,,♪ Құлақтағы бас бау Latta Latta Latta La
Dialogue: 0,0:31:04.57,0:31:07.99,Default,,0,0,0,,♪ Sosola sola sola сүйкімді би
Dialogue: 0,0:31:08.15,0:31:11.49,Default,,0,0,0,,♪ Талатта ратта ратта ратта ратта ратта ла
Dialogue: 0,0:31:11.61,0:31:14.95,Default,,0,0,0,,♪ Жоғары-төмен секір, Пиокко Пиокко, биле
Dialogue: 0,0:31:15.08,0:31:18.66,Default,,0,0,0,,♪ Аяғымдағы қызыл туфли Латта Латта Латта Ла
Dialogue: 0,0:31:20.25,0:31:21.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:21.54,0:31:22.92,Default,,0,0,0,,Биге барайық!
Dialogue: 0,0:31:23.04,0:31:24.00,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:31:24.17,0:31:25.00,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:31:25.13,0:31:26.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:28.76,0:31:30.93,Default,,0,0,0,,Бұл қызық болды!
Dialogue: 0,0:31:31.22,0:31:33.22,Default,,0,0,0,,Нобит-чанға рахмет
Dialogue: 0,0:31:33.34,0:31:36.06,Default,,0,0,0,,Қоян патшалығы - ең жақсы!
Dialogue: 0,0:31:36.89,0:31:40.69,Default,,0,0,0,,Бірақ бәрібір біртүрлі, Айдағы қоян.
Dialogue: 0,0:31:40.81,0:31:42.52,Default,,0,0,0,,Жақсы көр!
Dialogue: 0,0:31:42.65,0:31:45.86,Default,,0,0,0,,Ай қоянына сенбейтін адамды мен кешірмеймін!
Dialogue: 0,0:31:45.98,0:31:49.03,Default,,0,0,0,,Түсіндім! Мен бармын десем жарамайды ма?
Dialogue: 0,0:31:49.28,0:31:50.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:31:50.78,0:31:53.45,Default,,0,0,0,,Енді менің теориям дәлелденді!
Dialogue: 0,0:31:54.28,0:31:57.62,Default,,0,0,0,,Айда неге сонша бай ел бар?
Dialogue: 0,0:31:57.79,0:32:00.79,Default,,0,0,0,,Шындығында, бұл белгінің күші.
Dialogue: 0,0:32:01.66,0:32:05.29,Default,,0,0,0,,Дүниеде әдеттегідей қабылданған қалыптасқан теориядан айырмашылығы.
Dialogue: 0,0:32:05.42,0:32:08.55,Default,,0,0,0,,Бұл басқа әлемді жүзеге асыру құралы.
Dialogue: 0,0:32:08.96,0:32:12.09,Default,,0,0,0,,Неліктен? Бұл Дораэмон құралы ма?
Dialogue: 0,0:32:12.22,0:32:14.34,Default,,0,0,0,,Сондықтан мен бұл біртүрлі дедім!
Dialogue: 0,0:32:14.47,0:32:16.39,Default,,0,0,0,,Бірақ бұл романтикалық
Dialogue: 0,0:32:16.60,0:32:18.97,Default,,0,0,0,,Айдағы қоянның шынайы екеніне сене алар емеспін.
Dialogue: 0,0:32:19.14,0:32:19.97,Default,,0,0,0,,Иә, иә! Ахаха
Dialogue: 0,0:32:20.73,0:32:24.48,Default,,0,0,0,,Бұл белгімен бір нәрсеге қол жеткізуге бола ма?
Dialogue: 0,0:32:24.77,0:32:26.90,Default,,0,0,0,,Жоқ, қол жеткізуге болатын нәрсе
Dialogue: 0,0:32:27.02,0:32:31.11,Default,,0,0,0,,Бұл көптен бері сеніп келген басқа теория.
Dialogue: 0,0:32:31.24,0:32:35.45,Default,,0,0,0,,Бұл сіздің ойыңыз бен тілектеріңізді жүзеге асыратын құрал емес.
Dialogue: 0,0:32:35.87,0:32:37.41,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:32:37.87,0:32:39.49,Default,,0,0,0,,Барлығың мұқият тыңдаңдар.
Dialogue: 0,0:32:39.66,0:32:43.41,Default,,0,0,0,,Осы белгінің арқасында Айда ауа бар.
Dialogue: 0,0:32:43.54,0:32:46.33,Default,,0,0,0,,Белгімді жоғалтып алсам, тыныс ала алмаймын.
Dialogue: 0,0:32:46.50,0:32:48.34,Default,,0,0,0,,Оны ешқашан алып тастамаңыз!
Dialogue: 0,0:32:48.63,0:32:50.34,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:32:50.92,0:32:55.51,Default,,0,0,0,,Сонымен төсбелгісіз адамдар Қоян патшалығын көре алмайды ма?
Dialogue: 0,0:32:55.64,0:32:57.43,Default,,0,0,0,,Нобит-чанның фигурасы ше?
Dialogue: 0,0:32:57.55,0:32:58.68,Default,,0,0,0,,Нобиби?
Dialogue: 0,0:32:58.85,0:32:59.68,Default,,0,0,0,,Иә
Dialogue: 0,0:32:59.81,0:33:03.35,Default,,0,0,0,,Сіз басқа әлемде жасалған заттарды көре алмайсыз.
Dialogue: 0,0:33:04.31,0:33:05.52,Default,,0,0,0,,Фильм
Dialogue: 0,0:33:05.69,0:33:07.11,Default,,0,0,0,,Фильм
Dialogue: 0,0:33:10.19,0:33:12.03,Default,,0,0,0,,Н... Бибі!?
Dialogue: 0,0:33:12.53,0:33:14.53,Default,,0,0,0,,Бибібибі...
Dialogue: 0,0:33:15.70,0:33:17.53,Default,,0,0,0,,Гуо!
Dialogue: 0,0:33:17.70,0:33:18.99,Default,,0,0,0,,Бибі~
Dialogue: 0,0:33:20.54,0:33:22.66,Default,,0,0,0,,Керемет!
Dialogue: 0,0:33:23.41,0:33:24.46,Default,,0,0,0,,Бит?
Dialogue: 0,0:33:24.83,0:33:25.67,Default,,0,0,0,,Бибі…
Dialogue: 0,0:33:27.29,0:33:28.13,Default,,0,0,0,,Мугаби!
Dialogue: 0,0:33:28.29,0:33:29.84,Default,,0,0,0,,Бибібибі!
Dialogue: 0,0:33:31.05,0:33:32.88,Default,,0,0,0,,Ммм, Бибі!
Dialogue: 0,0:33:35.63,0:33:37.55,Default,,0,0,0,,Мугаби!
Dialogue: 0,0:33:38.05,0:33:40.22,Default,,0,0,0,,Иә? Бұл сергітетін түрі.
Dialogue: 0,0:33:40.39,0:33:41.72,Default,,0,0,0,,Спорт күні?
Dialogue: 0,0:33:44.39,0:33:46.23,Default,,0,0,0,,Мугаби!
Dialogue: 0,0:33:46.56,0:33:47.85,Default,,0,0,0,,А... бұл!
Dialogue: 0,0:33:47.98,0:33:50.40,Default,,0,0,0,,Мен жасаған қоян құбыжығы!
Dialogue: 0,0:33:50.57,0:33:52.53,Default,,0,0,0,,♪ Нобби ноби…
Dialogue: 0,0:33:53.15,0:33:53.99,Default,,0,0,0,,Нобит!
Dialogue: 0,0:34:01.24,0:34:02.08,Default,,0,0,0,,Бит!
Dialogue: 0,0:34:02.24,0:34:03.08,Default,,0,0,0,,Ара!
Dialogue: 0,0:34:03.58,0:34:04.58,Default,,0,0,0,,Муга~!
Dialogue: 0,0:34:05.08,0:34:06.08,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:34:06.25,0:34:08.79,Default,,0,0,0,,Лука қауіпті, сондықтан осында күтіңіз!
Dialogue: 0,0:34:09.33,0:34:10.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:15.97,0:34:18.93,Default,,0,0,0,,Сәлем! Nobit-ті босатыңыз!
Dialogue: 0,0:34:19.18,0:34:20.51,Default,,0,0,0,,Му-га!
Dialogue: 0,0:34:24.06,0:34:25.27,Default,,0,0,0,,Бибібі…
Dialogue: 0,0:34:25.39,0:34:26.56,Default,,0,0,0,,Виви!
Dialogue: 0,0:34:26.98,0:34:31.02,Default,,0,0,0,,Нашар! Мм, супер қолғап!
Dialogue: 0,0:34:33.73,0:34:34.78,Default,,0,0,0,,Әй!
Dialogue: 0,0:34:35.07,0:34:36.28,Default,,0,0,0,,Бит!
Dialogue: 0,0:34:37.03,0:34:38.49,Default,,0,0,0,,Виви!
Dialogue: 0,0:34:40.24,0:34:42.95,Default,,0,0,0,,Аа, мен уақытында әрең жеттім.
Dialogue: 0,0:34:46.16,0:34:47.91,Default,,0,0,0,,Ара! Ара!
Dialogue: 0,0:34:48.16,0:34:50.29,Default,,0,0,0,,Хахаха... аа
Dialogue: 0,0:34:50.46,0:34:52.46,Default,,0,0,0,,Нобита-сан жоқ.
Dialogue: 0,0:34:55.67,0:34:56.59,Default,,0,0,0,,Муга?
Dialogue: 0,0:34:58.67,0:35:01.59,Default,,0,0,0,,Му-га? Жоқ-би! Ноббиби…
Dialogue: 0,0:35:01.76,0:35:04.97,Default,,0,0,0,,Му... Муга Ммм... Муга!
Dialogue: 0,0:35:05.56,0:35:06.81,Default,,0,0,0,,Мугаби!
Dialogue: 0,0:35:07.14,0:35:08.27,Default,,0,0,0,,Нобит!
Dialogue: 0,0:35:08.73,0:35:12.06,Default,,0,0,0,,Хмм? Takecopter!
Dialogue: 0,0:35:13.98,0:35:16.28,Default,,0,0,0,,Бит... Мугаби!
Dialogue: 0,0:35:17.15,0:35:19.28,Default,,0,0,0,,Жақсы, жақсы!
Dialogue: 0,0:35:19.99,0:35:21.99,Default,,0,0,0,,Уф... аа!
Dialogue: 0,0:35:22.32,0:35:24.41,Default,,0,0,0,,Уау... уау
Dialogue: 0,0:35:25.33,0:35:26.16,Default,,0,0,0,,Кохокохо
Dialogue: 0,0:35:26.87,0:35:28.33,Default,,0,0,0,,Му-га!
Dialogue: 0,0:35:28.50,0:35:29.91,Default,,0,0,0,,Ммм
Dialogue: 0,0:35:30.16,0:35:31.62,Default,,0,0,0,,Муга…
Dialogue: 0,0:35:34.00,0:35:36.42,Default,,0,0,0,,Return Nobit!
Dialogue: 0,0:35:37.05,0:35:38.59,Default,,0,0,0,,Нобби!
Dialogue: 0,0:35:39.09,0:35:41.51,Default,,0,0,0,,Мен оны қайтармаймын...
Dialogue: 0,0:35:41.84,0:35:43.47,Default,,0,0,0,,Каа!
Dialogue: 0,0:35:45.47,0:35:47.52,Default,,0,0,0,,Муга? Муга…
Dialogue: 0,0:35:48.64,0:35:49.48,Default,,0,0,0,,Не?
Dialogue: 0,0:35:50.10,0:35:52.52,Default,,0,0,0,,Му~га Му~га...
Dialogue: 0,0:35:55.69,0:35:57.02,Default,,0,0,0,,Мұғат Мұға…
Dialogue: 0,0:35:57.19,0:35:59.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:02.82,0:36:03.95,Default,,0,0,0,,Нобиби! Бибибі…
Dialogue: 0,0:36:04.07,0:36:05.83,Default,,0,0,0,,Ноби-би-би-би-би-би-би…
Dialogue: 0,0:36:06.37,0:36:08.49,Default,,0,0,0,,Уф! Ха...
Dialogue: 0,0:36:08.62,0:36:09.45,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:36:10.41,0:36:13.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:13.37,0:36:15.17,Default,,0,0,0,,Нобиби~!
Dialogue: 0,0:36:22.13,0:36:25.05,Default,,0,0,0,,Кун Кун Кун Кун Кун! Кункун... о!
Dialogue: 0,0:36:25.18,0:36:26.39,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:36:26.89,0:36:29.35,Default,,0,0,0,,Осы жерде Нобита-кунның иісі тоқтайды.
Dialogue: 0,0:36:29.64,0:36:31.48,Default,,0,0,0,,Бұл еш жерде емес.
Dialogue: 0,0:36:31.60,0:36:34.02,Default,,0,0,0,,Сіз бұл құралды не үшін пайдаланасыз?
Dialogue: 0,0:36:34.23,0:36:36.81,Default,,0,0,0,,Полиция итінің жалған мұрнына сеніңіз!
Dialogue: 0,0:36:39.78,0:36:41.90,Default,,0,0,0,,А, бұл! Нобитаныкі емес пе?
Dialogue: 0,0:36:42.11,0:36:43.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:43.24,0:36:45.91,Default,,0,0,0,,Өйткені, Нобита-сан осында!
Dialogue: 0,0:36:46.45,0:36:48.87,Default,,0,0,0,,Уау! (Қоян құбыжық) Муга~!
Dialogue: 0,0:36:48.99,0:36:50.29,Default,,0,0,0,,Неліктен Нобита емес?
Dialogue: 0,0:36:50.41,0:36:51.91,Default,,0,0,0,,Мына жігіт сонда ма?
Dialogue: 0,0:36:52.04,0:36:53.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:54.42,0:36:58.79,Default,,0,0,0,,Осындай кездерде Момотаро мөрі жоқ.
Dialogue: 0,0:36:58.92,0:36:59.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:37:00.30,0:37:02.26,Default,,0,0,0,,Мені ұмыт!
Dialogue: 0,0:37:04.55,0:37:08.35,Default,,0,0,0,,Мен бұл шөптің иісін сезгенде, мен бәрін ұмытамын.
Dialogue: 0,0:37:08.47,0:37:10.39,Default,,0,0,0,,Иә? О?
Dialogue: 0,0:37:10.72,0:37:13.98,Default,,0,0,0,,Қоян? Мен не істеп жүр едім?
Dialogue: 0,0:37:14.10,0:37:15.10,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:37:15.23,0:37:16.35,Default,,0,0,0,,Едепсіз құбыжық!
Dialogue: 0,0:37:17.86,0:37:20.82,Default,,0,0,0,,Мугаби!
Dialogue: 0,0:37:20.94,0:37:21.78,Default,,0,0,0,,Әй!
Dialogue: 0,0:37:23.90,0:37:24.74,Default,,0,0,0,,Ах
Dialogue: 0,0:37:25.49,0:37:27.70,Default,,0,0,0,,Фуга Фуга…
Dialogue: 0,0:37:28.24,0:37:31.24,Default,,0,0,0,,Ұстап қалсаң жақсы емес.
Dialogue: 0,0:37:31.45,0:37:34.29,Default,,0,0,0,,Бұдан былай мен бәрімен тіл табысамын.
Dialogue: 0,0:37:34.41,0:37:35.62,Default,,0,0,0,,Фугаби~
Dialogue: 0,0:37:36.79,0:37:38.79,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:37:38.96,0:37:40.63,Default,,0,0,0,,Ештеңе жасамаңыз
Dialogue: 0,0:37:40.84,0:37:42.09,Default,,0,0,0,,Нобиби!
Dialogue: 0,0:37:42.21,0:37:44.59,Default,,0,0,0,,Міне! Нобит-чан?
Dialogue: 0,0:37:45.84,0:37:47.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:47.93,0:37:49.55,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:37:51.85,0:37:53.06,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:37:53.18,0:37:55.77,Default,,0,0,0,,А... Менде төсбелгі жоқ!
Dialogue: 0,0:37:56.10,0:37:58.98,Default,,0,0,0,,Дем ала алмаймын... Тыныс ала алмаймын.
Dialogue: 0,0:37:59.11,0:38:00.98,Default,,0,0,0,,Бұл ауырады~
Dialogue: 0,0:38:01.11,0:38:02.40,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:38:03.28,0:38:06.70,Default,,0,0,0,,Жарайды, ендеше терең дем ал.
Dialogue: 0,0:38:07.57,0:38:09.16,Default,,0,0,0,,Бұл жарық...
Dialogue: 0,0:38:09.53,0:38:10.74,Default,,0,0,0,,Ха~
Dialogue: 0,0:38:11.87,0:38:13.16,Default,,0,0,0,,Ауа бар!
Dialogue: 0,0:38:15.25,0:38:16.62,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,0:38:17.37,0:38:19.58,Default,,0,0,0,,Сен... сен!
Dialogue: 0,0:38:19.83,0:38:22.50,Default,,0,0,0,,Нобиноби! Нобибиби…
Dialogue: 0,0:38:23.09,0:38:24.17,Default,,0,0,0,,Бұл...
Dialogue: 0,0:38:24.30,0:38:26.51,Default,,0,0,0,,Нобита-кунның төс белгісі!
Dialogue: 0,0:38:26.63,0:38:30.51,Default,,0,0,0,,Аа, төсбелгіні алған кезде мен ауасыз қалдым...
Dialogue: 0,0:38:31.01,0:38:33.85,Default,,0,0,0,,Ах! Нобита-кун!
Dialogue: 0,0:38:34.27,0:38:35.43,Default,,0,0,0,,Бұл Декү.
Dialogue: 0,0:38:35.56,0:38:37.18,Default,,0,0,0,,Сіз тым кеш дейсіз бе?
Dialogue: 0,0:38:37.31,0:38:40.60,Default,,0,0,0,,Бұл шындық болуы мүмкін емес! Мен сенімдімін Нобита-сан
Dialogue: 0,0:38:40.73,0:38:44.86,Default,,0,0,0,,Уф! Бұзылғаным үшін кешірім сұраймын!
Dialogue: 0,0:38:44.98,0:38:46.11,Default,,0,0,0,,Дора-чан!
Dialogue: 0,0:38:46.57,0:38:48.36,Default,,0,0,0,,Олай етпе!
Dialogue: 0,0:38:48.49,0:38:50.99,Default,,0,0,0,,Эй!
Dialogue: 0,0:38:52.70,0:38:54.79,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:38:55.58,0:38:57.71,Default,,0,0,0,,Бұл Нобита-кунның дауысы екеніне күмәнім жоқ!
Dialogue: 0,0:38:58.25,0:39:00.88,Default,,0,0,0,,Керемет! Жақсы болды.
Dialogue: 0,0:39:01.00,0:39:02.71,Default,,0,0,0,,Аняру!
Dialogue: 0,0:39:02.84,0:39:05.46,Default,,0,0,0,,Бірақ менде төсбелгі жоқ болса ше?
Dialogue: 0,0:39:06.42,0:39:09.09,Default,,0,0,0,,Әйтеуір, төменге түсейік.
Dialogue: 0,0:39:12.55,0:39:14.56,Default,,0,0,0,,Жоқ~Vivi~?
Dialogue: 0,0:39:15.39,0:39:17.89,Default,,0,0,0,,Сіз өте тереңге түстіңіз.
Dialogue: 0,0:39:18.56,0:39:21.52,Default,,0,0,0,,Айда мұндай тік тесік бар екеніне сене алар емеспін
Dialogue: 0,0:39:22.02,0:39:23.98,Default,,0,0,0,,Эй!
Dialogue: 0,0:39:24.44,0:39:26.40,Default,,0,0,0,,Бұл жерден шыққан
Dialogue: 0,0:39:28.36,0:39:31.07,Default,,0,0,0,,Аяқ астындағы жер кедір-бұдыр, сақ бол...
Dialogue: 0,0:39:31.20,0:39:32.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:32.57,0:39:34.03,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:39:34.28,0:39:36.20,Default,,0,0,0,,Ах! Буха…
Dialogue: 0,0:39:36.33,0:39:38.58,Default,,0,0,0,,Бубубу... Даха!
Dialogue: 0,0:39:41.42,0:39:43.71,Default,,0,0,0,,Итататата...
Dialogue: 0,0:39:44.09,0:39:45.63,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:39:45.75,0:39:46.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:47.38,0:39:48.59,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,0:39:48.88,0:39:50.42,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:39:50.55,0:39:53.01,Default,,0,0,0,,Аман болыңыз! Банзай!
Dialogue: 0,0:39:53.14,0:39:55.14,Default,,0,0,0,,Банзай! Банзай!
Dialogue: 0,0:39:55.26,0:39:56.56,Default,,0,0,0,,Бәріне сәлем
Dialogue: 0,0:39:58.64,0:40:01.60,Default,,0,0,0,,Біздің колонияға қош келдіңіз
Dialogue: 0,0:40:01.98,0:40:02.90,Default,,0,0,0,,Лука!?
Dialogue: 0,0:40:03.02,0:40:04.19,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:40:04.31,0:40:05.27,Default,,0,0,0,,Атацу…
Dialogue: 0,0:40:05.44,0:40:09.53,Default,,0,0,0,,Түсіндіргеннен гөрі мұны істеу жылдамырақ деп ойлаймын.
Dialogue: 0,0:40:10.36,0:40:11.78,Default,,0,0,0,,(Зеницу) Незуко-чан, Танжиро~ (Танжиро) Тоқтат! Зенцу!
Dialogue: 0,0:40:14.70,0:40:17.79,Default,,0,0,0,,Шынайы тұлғамды жасырғаным үшін кешірім сұраймын.
Dialogue: 0,0:40:18.12,0:40:20.25,Default,,0,0,0,,У... Қоян!
Dialogue: 0,0:40:20.83,0:40:23.58,Default,,0,0,0,,Хмм, мұнда тұтынушылар жоқ.
Dialogue: 0,0:40:23.71,0:40:25.21,Default,,0,0,0,,Бұл менің бірінші рет.
Dialogue: 0,0:40:27.13,0:40:28.13,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:40:28.25,0:40:29.13,Default,,0,0,0,,Тасбақа?
Dialogue: 0,0:40:30.80,0:40:32.05,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:40:32.17,0:40:36.05,Default,,0,0,0,,Мен Мозо, жапон тасбақасымын.
Dialogue: 0,0:40:36.18,0:40:38.14,Default,,0,0,0,,Кейінірек кездескенше
Dialogue: 0,0:40:38.26,0:40:40.52,Default,,0,0,0,,Ай әлеміне барыңыз...
Dialogue: 0,0:40:40.64,0:40:42.31,Default,,0,0,0,,Қоян да емес...
Dialogue: 0,0:40:42.48,0:40:44.48,Default,,0,0,0,,Тасбақа да болды ма?
Dialogue: 0,0:40:44.65,0:40:49.57,Default,,0,0,0,,(Лунаның гуілдеуі)
Dialogue: 0,0:40:51.74,0:40:53.20,Default,,0,0,0,,(Нұрудың ыңылдаған дауысы)
Dialogue: 0,0:40:53.32,0:40:54.99,Default,,0,0,0,,Лука-нии-чан!
Dialogue: 0,0:40:55.91,0:40:57.20,Default,,0,0,0,,Барлығы қазір
Dialogue: 0,0:40:57.32,0:40:58.58,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:40:58.70,0:41:00.24,Default,,0,0,0,,Сіз біртүрлі нәрсе киіп жүрсіз.
Dialogue: 0,0:41:01.91,0:41:02.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:03.50,0:41:04.50,Default,,0,0,0,,Әй!
Dialogue: 0,0:41:04.75,0:41:07.04,Default,,0,0,0,,Хе, аа... эй
Dialogue: 0,0:41:07.17,0:41:10.67,Default,,0,0,0,,Лұқа! Ол рұқсатсыз жоғалып кетті, мен уайымдадым!
Dialogue: 0,0:41:11.26,0:41:13.01,Default,,0,0,0,,Миста, бізді аңдап жүрген жоқ па?
Dialogue: 0,0:41:13.17,0:41:15.63,Default,,0,0,0,,Ең бастысы, жер бетіндегі барлық адамдар.
Dialogue: 0,0:41:16.30,0:41:17.39,Default,,0,0,0,,Сәлем (Сунео) Мен сені жақсы көремін.
Dialogue: 0,0:41:17.51,0:41:18.60,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:41:19.18,0:41:20.85,Default,,0,0,0,,Жер құдығы!
Dialogue: 0,0:41:21.02,0:41:24.35,Default,,0,0,0,,Алыс жерден қош келдіңіз.
Dialogue: 0,0:41:24.48,0:41:27.19,Default,,0,0,0,,Менің атым Луна, Луканың әпкесі.
Dialogue: 0,0:41:28.23,0:41:31.36,Default,,0,0,0,,Ағаң сені сонда ертіп апармады ма?
Dialogue: 0,0:41:31.48,0:41:33.11,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:41:33.24,0:41:34.78,Default,,0,0,0,,Мен Дораемонмын!
Dialogue: 0,0:41:35.86,0:41:38.41,Default,,0,0,0,,Бұл Айдың магма жолы.
Dialogue: 0,0:41:38.82,0:41:41.87,Default,,0,0,0,,Бұл лава түтігін өзгерту арқылы салынған колония.
Dialogue: 0,0:41:42.87,0:41:45.21,Default,,0,0,0,,Сіз айдағы адамдарсыз ба?
Dialogue: 0,0:41:45.71,0:41:49.17,Default,,0,0,0,,Хмм, дәл емес.
Dialogue: 0,0:41:50.13,0:41:53.13,Default,,0,0,0,,Біз Күн жүйесінен алыспыз.
Dialogue: 0,0:41:54.05,0:41:56.76,Default,,0,0,0,,Біз Кагуя деген планетада туылған нәсілбіз.
Dialogue: 0,0:41:57.68,0:41:59.60,Default,,0,0,0,,Сонда бөтен Кагуя?
Dialogue: 0,0:42:00.51,0:42:02.93,Default,,0,0,0,,Бұл емес...
Dialogue: 0,0:42:03.06,0:42:06.52,Default,,0,0,0,,Бізді әке мен ана жаратты.
Dialogue: 0,0:42:06.85,0:42:08.19,Default,,0,0,0,,Ечен!
Dialogue: 0,0:42:08.31,0:42:12.07,Default,,0,0,0,,Кагуя планетасының тарихындағы ең көрнекті данышпан биолог.
Dialogue: 0,0:42:12.23,0:42:14.49,Default,,0,0,0,,Доктор және Годар ханым.
Dialogue: 0,0:42:14.61,0:42:19.74,Default,,0,0,0,,Лука мен оның достары - Эспал деп аталатын ғаламда бар болғаны 11 адамнан тұратын нәсіл.
Dialogue: 0,0:42:20.16,0:42:21.74,Default,,0,0,0,,Espal?
Dialogue: 0,0:42:21.99,0:42:22.83,Default,,0,0,0,,Луна
Dialogue: 0,0:42:22.95,0:42:23.83,Default,,0,0,0,,Иә
Dialogue: 0,0:42:27.25,0:42:28.25,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:42:32.59,0:42:34.13,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:42:34.26,0:42:36.01,Default,,0,0,0,,Гүлдер билеп жатыр!
Dialogue: 0,0:42:36.55,0:42:38.09,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:42:38.59,0:42:39.76,Default,,0,0,0,,эфирлік
Dialogue: 0,0:42:40.76,0:42:43.39,Default,,0,0,0,,Денеміз өндіретін энергия
Dialogue: 0,0:42:43.97,0:42:49.10,Default,,0,0,0,,Өсімдіктерді жандандыруға және заттарды жылжытуға болады.
Dialogue: 0,0:42:51.40,0:42:55.94,Default,,0,0,0,,Егер сіз оған бүкіл денеңізді орап алсаңыз, ол ғарыштық костюм ретінде қызмет ете алады.
Dialogue: 0,0:42:56.11,0:42:58.90,Default,,0,0,0,,Керемет! Бұл супер күш!
Dialogue: 0,0:42:59.03,0:43:01.53,Default,,0,0,0,,Мүмкін ол жылдам жүгірді?
Dialogue: 0,0:43:02.12,0:43:04.24,Default,,0,0,0,,Бір кезде құрғақ болған гүлдер қайтадан гүлдеді ме?
Dialogue: 0,0:43:04.70,0:43:06.91,Default,,0,0,0,,Хехе, сізді таң қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:43:07.04,0:43:08.29,Default,,0,0,0,,Жақсы! Апыр-ай!
Dialogue: 0,0:43:08.41,0:43:12.59,Default,,0,0,0,,Егер Лұқа мұны істесе ше? Мен ағам үшін қатты өкінемін!
Dialogue: 0,0:43:12.96,0:43:17.13,Default,,0,0,0,,Айтпақшы, балалар, сендер Жер тілінде қалай сөйлей аласыңдар?
Dialogue: 0,0:43:17.97,0:43:19.63,Default,,0,0,0,,Телепатиялық оқу
Dialogue: 0,0:43:19.80,0:43:21.26,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:43:21.39,0:43:22.14,Default,,0,0,0,,Уау
Dialogue: 0,0:43:23.39,0:43:25.85,Default,,0,0,0,,Бұдан былай менің тек балаларым бар.
Dialogue: 0,0:43:25.97,0:43:27.10,Default,,0,0,0,,Үлкендер ше?
Dialogue: 0,0:43:27.77,0:43:31.56,Default,,0,0,0,,Эспалдың денесі жас кезінде өсуін тоқтатады.
Dialogue: 0,0:43:32.27,0:43:34.02,Default,,0,0,0,,Демек, ересектер жоқ.
Dialogue: 0,0:43:34.98,0:43:38.49,Default,,0,0,0,,Бір минут күтіңіз, Лука мен басқалары нешеде?
Dialogue: 0,0:43:39.32,0:43:42.16,Default,,0,0,0,,Мен Кагуя планетасында 10 жылдай болдым...
Dialogue: 0,0:43:43.16,0:43:44.83,Default,,0,0,0,,Шамамен 1010 жыл
Dialogue: 0,0:43:44.99,0:43:46.95,Default,,0,0,0,,1010 жаста!?
Dialogue: 0,0:43:47.08,0:43:49.41,Default,,0,0,0,,Өте қарт!
Dialogue: 0,0:43:49.54,0:43:52.29,Default,,0,0,0,,Мәңгілік өмір сүре алатынымды қызғанамын!
Dialogue: 0,0:43:53.25,0:43:54.50,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:43:54.63,0:43:59.26,Default,,0,0,0,,Айтпақшы, мен 2000 жастамын, тасбақалар мәңгі өмір сүреді.
Dialogue: 0,0:43:59.92,0:44:02.18,Default,,0,0,0,,Алдымен мен Жерде өмір сүру туралы ойладым.
Dialogue: 0,0:44:02.34,0:44:04.76,Default,,0,0,0,,Мен не болып жатқанын көру үшін бардым.
Dialogue: 0,0:44:05.55,0:44:07.68,Default,,0,0,0,,Өйткені өркениет әлдеқашан бүлінген
Dialogue: 0,0:44:07.81,0:44:09.18,Default,,0,0,0,,Мен айды таңдадым
Dialogue: 0,0:44:09.73,0:44:13.35,Default,,0,0,0,,Осыдан 1000 жыл бұрын Жапония Хэйан кезеңінде болған.
Dialogue: 0,0:44:13.52,0:44:16.19,Default,,0,0,0,,Мүмкін Кагуяхиме туралы аңыз...
Dialogue: 0,0:44:16.61,0:44:18.65,Default,,0,0,0,,А, бұл менмін!
Dialogue: 0,0:44:19.40,0:44:21.28,Default,,0,0,0,,Даха!
Dialogue: 0,0:44:21.40,0:44:23.36,Default,,0,0,0,,Химеда болу үлкен мәртебе.
Dialogue: 0,0:44:26.62,0:44:29.95,Default,,0,0,0,,Айдың астында мұндай кеңістік бар екеніне сене алар емеспін.
Dialogue: 0,0:44:30.08,0:44:32.33,Default,,0,0,0,,Топырақ пен ауа ше?
Dialogue: 0,0:44:32.87,0:44:35.21,Default,,0,0,0,,Жерден топырақ әкелінді
Dialogue: 0,0:44:35.67,0:44:37.84,Default,,0,0,0,,Ауа ай мұзынан жасалған
Dialogue: 0,0:44:37.96,0:44:39.21,Default,,0,0,0,,Мұз?
Dialogue: 0,0:44:39.42,0:44:40.80,Default,,0,0,0,,Мен саған қазір айналаны көрсетемін.
Dialogue: 0,0:44:41.34,0:44:42.76,Default,,0,0,0,,Йотто фуми
Dialogue: 0,0:44:42.88,0:44:44.72,Default,,0,0,0,,Иә? Не болды, Дораемон?
Dialogue: 0,0:44:45.09,0:44:46.68,Default,,0,0,0,,Егер сізде эфирдің күші болса
Dialogue: 0,0:44:46.80,0:44:50.10,Default,,0,0,0,,Мен ыңғайлырақ өмір сүре алсам да...
Dialogue: 0,0:44:50.39,0:44:54.73,Default,,0,0,0,,Люк пен оның достарының айға келуінің себебі бар шығар.
Dialogue: 0,0:45:00.23,0:45:02.82,Default,,0,0,0,,Бұл Кагуядан келген ғарыш кемесі ме?
Dialogue: 0,0:45:02.95,0:45:06.16,Default,,0,0,0,,Иә, бұл біз келген кеме.
Dialogue: 0,0:45:06.91,0:45:09.45,Default,,0,0,0,,Бұған жүктелген сұйық азот
Dialogue: 0,0:45:09.79,0:45:12.29,Default,,0,0,0,,Айдың тұрақты көлеңкесінде мұзды пайдалану
Dialogue: 0,0:45:12.41,0:45:13.58,Default,,0,0,0,,Ауа жасау
Dialogue: 0,0:45:13.96,0:45:17.63,Default,,0,0,0,,Сол себепті Нобита-кунның төсбелгісі шешілді ме?
Dialogue: 0,0:45:17.75,0:45:19.75,Default,,0,0,0,,Поэ!
Dialogue: 0,0:45:19.92,0:45:21.59,Default,,0,0,0,,Не? (Сунео) Ай сілкінісі ме?
Dialogue: 0,0:45:24.01,0:45:25.34,Default,,0,0,0,,Баа!
Dialogue: 0,0:45:25.47,0:45:26.51,Default,,0,0,0,,Хехе
Dialogue: 0,0:45:27.18,0:45:29.26,Default,,0,0,0,,Қайтадан қош келдіңіз, Лука-нии-тан!
Dialogue: 0,0:45:29.51,0:45:32.43,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:45:32.98,0:45:34.27,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:45:34.52,0:45:37.94,Default,,0,0,0,,Үйімде ән айтсам, Луна апа маған ашуланады.
Dialogue: 0,0:45:38.11,0:45:38.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:39.73,0:45:41.78,Default,,0,0,0,,Кім? Сол адамдар...
Dialogue: 0,0:45:42.07,0:45:44.95,Default,,0,0,0,,Жарайды, Жер тұрғындары.
Dialogue: 0,0:45:45.95,0:45:49.83,Default,,0,0,0,,Эй, бұл қазір сен бе? Маған қайталап көріңіз
Dialogue: 0,0:45:49.95,0:45:50.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:51.12,0:45:52.24,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:45:52.37,0:45:54.12,Default,,0,0,0,,Мен аздап қарсы емеспін.
Dialogue: 0,0:45:54.41,0:45:55.50,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:45:56.87,0:46:00.46,Default,,0,0,0,,По~!
Dialogue: 0,0:46:06.09,0:46:08.93,Default,,0,0,0,,Әлдің қабілеттері біртүрлі екен.
Dialogue: 0,0:46:10.01,0:46:13.39,Default,,0,0,0,,Жер бетінде бұл қабілетті пайдалана алатын адамдар бар.
Dialogue: 0,0:46:13.56,0:46:15.31,Default,,0,0,0,,Керемет!
Dialogue: 0,0:46:16.10,0:46:17.56,Default,,0,0,0,,Сіз данышпансыз!
Dialogue: 0,0:46:17.69,0:46:20.65,Default,,0,0,0,,Менімен бірге әнші ретінде дебют жасағыңыз келе ме?
Dialogue: 0,0:46:20.98,0:46:22.65,Default,,0,0,0,,Иә!?
Dialogue: 0,0:46:25.86,0:46:27.82,Default,,0,0,0,,Уау, жақсы иіс
Dialogue: 0,0:46:27.95,0:46:29.20,Default,,0,0,0,,Ай гүлі шайы
Dialogue: 0,0:46:29.32,0:46:31.58,Default,,0,0,0,,Ах, рахмет
Dialogue: 0,0:46:31.70,0:46:32.58,Default,,0,0,0,,Баа! Ооо
Dialogue: 0,0:46:33.24,0:46:34.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:38.46,0:46:39.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:40.13,0:46:43.13,Default,,0,0,0,,Бұл адамдар сенің әкең мен шешең бе?
Dialogue: 0,0:46:43.34,0:46:45.46,Default,,0,0,0,,Қоянның құлағы жоқ.
Dialogue: 0,0:46:46.09,0:46:48.01,Default,,0,0,0,,Бұл құлақ емес
Dialogue: 0,0:46:48.38,0:46:51.93,Default,,0,0,0,,Менің ойымша, бұл эфирді қолдануға арналған антенна сияқты.
Dialogue: 0,0:46:54.68,0:46:57.31,Default,,0,0,0,,Олар нағыз ата-ана емес...
Dialogue: 0,0:46:57.43,0:46:58.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:59.52,0:47:00.85,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:47:01.19,0:47:05.36,Default,,0,0,0,,Ей, мен жаңалықтардан көрген жұмбақ ақ көлеңке...
Dialogue: 0,0:47:05.53,0:47:07.95,Default,,0,0,0,,Ал Айдың жақын жағына барды
Dialogue: 0,0:47:08.07,0:47:10.82,Default,,0,0,0,,Мені зонд ашты, сондықтан менде басқа амал қалмады...
Dialogue: 0,0:47:11.20,0:47:12.20,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:47:12.32,0:47:15.70,Default,,0,0,0,,Аққан жұлдызды көремін деп болжаған.
Dialogue: 0,0:47:15.83,0:47:16.79,Default,,0,0,0,,Пайғамбарлық?
Dialogue: 0,0:47:17.66,0:47:20.08,Default,,0,0,0,,Әлде сол әнге қоса тағы бір нәрсе бар.
Dialogue: 0,0:47:20.21,0:47:22.25,Default,,0,0,0,,Менің болашақты болжауға күшім жетеді.
Dialogue: 0,0:47:22.38,0:47:23.21,Default,,0,0,0,,Иә!?
Dialogue: 0,0:47:23.46,0:47:25.34,Default,,0,0,0,,Бұл рас па? Хехехе
Dialogue: 0,0:47:25.46,0:47:26.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:26.88,0:47:30.01,Default,,0,0,0,,Олай болса, менің болашағымды болжаңыз.
Dialogue: 0,0:47:30.13,0:47:31.51,Default,,0,0,0,,Иә! иә?
Dialogue: 0,0:47:32.22,0:47:34.22,Default,,0,0,0,,Al! Хехехе
Dialogue: 0,0:47:34.35,0:47:37.60,Default,,0,0,0,,Сіз өз еркіңізбен пайғамбарлық жасай алмайсыз.
Dialogue: 0,0:47:37.72,0:47:40.48,Default,,0,0,0,,Бір күні кенет шертті.
Dialogue: 0,0:47:40.98,0:47:43.06,Default,,0,0,0,,Айтпақшы, Лұқа неліктен
Dialogue: 0,0:47:43.19,0:47:45.94,Default,,0,0,0,,Сіз Нобита-кунның мектебіне ауыстыңыз ба?
Dialogue: 0,0:47:46.07,0:47:47.40,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:47:48.15,0:47:51.41,Default,,0,0,0,,Айдың арғы жағы да байқала бастады.
Dialogue: 0,0:47:51.57,0:47:55.41,Default,,0,0,0,,Біздің барымызды ашатын кез келді деп ойладым.
Dialogue: 0,0:47:56.03,0:47:58.37,Default,,0,0,0,,Үлкендер маған сенбейді
Dialogue: 0,0:47:58.87,0:48:01.37,Default,,0,0,0,,Бала сізге сенуі мүмкін.
Dialogue: 0,0:48:02.04,0:48:04.84,Default,,0,0,0,,Мен Нобитамен кездескенде солай ойладым
Dialogue: 0,0:48:05.25,0:48:09.26,Default,,0,0,0,,Нобита ай қоянына шындап сенді.
Dialogue: 0,0:48:10.05,0:48:12.43,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:48:12.63,0:48:16.56,Default,,0,0,0,,Нобитаның қиялы осы кездесуге әкелді.
Dialogue: 0,0:48:16.68,0:48:18.27,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,0:48:18.68,0:48:20.81,Default,,0,0,0,,Шизука-чан айтқандай
Dialogue: 0,0:48:21.06,0:48:23.85,Default,,0,0,0,,Галилей гелиоцентрлік теорияны ұсынған кезде де
Dialogue: 0,0:48:23.98,0:48:27.40,Default,,0,0,0,,Алғашында мұны күпірлік деп ешкім сенбеді.
Dialogue: 0,0:48:27.52,0:48:30.86,Default,,0,0,0,,Бірақ қазір бұл қалыптасқан теория.
Dialogue: 0,0:48:30.99,0:48:35.74,Default,,0,0,0,,Адамзат тарихы әртүрлі теориялармен ойып жасалған.
Dialogue: 0,0:48:35.95,0:48:38.62,Default,,0,0,0,,Бірақ жердегі бидғат қорқынышты!
Dialogue: 0,0:48:38.79,0:48:41.71,Default,,0,0,0,,Тасбақалар қояндарға қарағанда баяу!
Dialogue: 0,0:48:41.83,0:48:44.71,Default,,0,0,0,,Менің аяғымның жылдамдығын бағаламайсың ба?
Dialogue: 0,0:48:45.13,0:48:46.71,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:48:46.84,0:48:48.63,Default,,0,0,0,,Ахахха! сурет?
Dialogue: 0,0:48:52.67,0:48:54.64,Default,,0,0,0,,Ғарыштық арба!
Dialogue: 0,0:48:54.93,0:48:55.97,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:48:58.89,0:49:02.56,Default,,0,0,0,,3 топқа бөлініп, Айда жарысайық!
Dialogue: 0,0:49:02.93,0:49:04.48,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:49:08.52,0:49:10.44,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:49:12.15,0:49:13.32,Default,,0,0,0,,Жарайды
Dialogue: 0,0:49:14.82,0:49:15.91,Default,,0,0,0,,Дон!
Dialogue: 0,0:49:17.07,0:49:19.99,Default,,0,0,0,,Жүр! Жүр, жүр!
Dialogue: 0,0:49:20.54,0:49:24.54,Default,,0,0,0,,Бұл машина менің аяғыма жақсы сәйкес келуі мүмкін.
Dialogue: 0,0:49:24.67,0:49:27.21,Default,,0,0,0,,Нобибиби…
Dialogue: 0,0:49:27.33,0:49:28.71,Default,,0,0,0,,Тасбақа!
Dialogue: 0,0:49:31.21,0:49:33.76,Default,,0,0,0,,Би? Нобби…
Dialogue: 0,0:49:34.30,0:49:36.51,Default,,0,0,0,,Бұл «Нобби» емес!
Dialogue: 0,0:49:36.68,0:49:39.35,Default,,0,0,0,,Менің қабығым ғаламдағы ең қиыны болмаса
Dialogue: 0,0:49:39.51,0:49:41.35,Default,,0,0,0,,Сіз ауыр жарақат алмақсыз.
Dialogue: 0,0:49:41.52,0:49:42.64,Default,,0,0,0,,Нобиби…
Dialogue: 0,0:49:44.23,0:49:46.10,Default,,0,0,0,,Бұл сіздің машинаңыз ба?
Dialogue: 0,0:49:46.23,0:49:47.60,Default,,0,0,0,,Новиноби
Dialogue: 0,0:49:48.81,0:49:50.52,Default,,0,0,0,,Кішкене ескірген болса да
Dialogue: 0,0:49:50.69,0:49:52.86,Default,,0,0,0,,Өте жақсы орындалған.
Dialogue: 0,0:49:53.11,0:49:57.03,Default,,0,0,0,,Жақсы! Мен сені айдаймын.
Dialogue: 0,0:49:57.61,0:49:59.53,Default,,0,0,0,,Кету барысы!
Dialogue: 0,0:50:00.08,0:50:01.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:50:01.58,0:50:03.95,Default,,0,0,0,,Неліктен артқа кетесің?
Dialogue: 0,0:50:04.08,0:50:06.29,Default,,0,0,0,,Мынау Әбекөбе!
Dialogue: 0,0:50:09.21,0:50:11.17,Default,,0,0,0,,Тұтқасы да дірілдеп тұр!
Dialogue: 0,0:50:14.21,0:50:15.30,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:50:15.55,0:50:18.89,Default,,0,0,0,,Неліктен тек біздің арбамыз баяу?
Dialogue: 0,0:50:19.26,0:50:22.56,Default,,0,0,0,,А, бұл қызық екен.
Dialogue: 0,0:50:23.56,0:50:27.06,Default,,0,0,0,,Негізі мен әрқашан Жерге барғым келетін.
Dialogue: 0,0:50:28.23,0:50:30.52,Default,,0,0,0,,Барлығы қауіпті деп қарсылық білдірді.
Dialogue: 0,0:50:30.90,0:50:33.61,Default,,0,0,0,,Мен жерді көптен бері бақылап жүрмін...
Dialogue: 0,0:50:37.45,0:50:40.91,Default,,0,0,0,,Менің ойымша, Люк достарын қалайды.
Dialogue: 0,0:50:41.07,0:50:43.74,Default,,0,0,0,,Достар? Дос деген не?
Dialogue: 0,0:50:43.91,0:50:46.33,Default,,0,0,0,,Не, сіз достарды білмейсіз бе?
Dialogue: 0,0:50:46.46,0:50:48.67,Default,,0,0,0,,S-Pal-да барлығы бар ма?
Dialogue: 0,0:50:48.79,0:50:49.83,Default,,0,0,0,,Иә
Dialogue: 0,0:50:51.38,0:50:55.76,Default,,0,0,0,,Достар – дос. Достар достық арқылы байланысады.
Dialogue: 0,0:50:56.21,0:50:59.76,Default,,0,0,0,,Достарым мұңайса, мен де мұңаямын.
Dialogue: 0,0:51:00.01,0:51:02.18,Default,,0,0,0,,Бақытты болсаң, бірге бақытты бол.
Dialogue: 0,0:51:02.55,0:51:04.10,Default,,0,0,0,,Достар сияқты
Dialogue: 0,0:51:04.22,0:51:06.77,Default,,0,0,0,,Бұл көмектесуге жақсы себеп.
Dialogue: 0,0:51:10.77,0:51:11.94,Default,,0,0,0,,Достар…
Dialogue: 0,0:51:12.86,0:51:14.48,Default,,0,0,0,,(дыбыстық сигнал дыбысы)
Dialogue: 0,0:51:14.61,0:51:16.78,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:51:19.99,0:51:22.62,Default,,0,0,0,,Батареяны ауыстырыңыз
Dialogue: 0,0:51:26.91,0:51:28.29,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:51:28.79,0:51:31.92,Default,,0,0,0,,Дораэмонның құралдары әрқашан осылай.
Dialogue: 0,0:51:33.75,0:51:35.09,Default,,0,0,0,,Оны түзетуге бола ма?
Dialogue: 0,0:51:36.30,0:51:39.05,Default,,0,0,0,,Мен батареяны ауыстыру сияқты бірдеңе істей аламын.
Dialogue: 0,0:51:44.14,0:51:44.97,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:51:45.81,0:51:49.98,Default,,0,0,0,,Иә? Мүмкін осында? Амал жоқ, ашыңыз!
Dialogue: 0,0:51:50.23,0:51:51.98,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:51:54.82,0:51:55.94,Default,,0,0,0,,Лука... Иә?
Dialogue: 0,0:51:56.82,0:52:00.70,Default,,0,0,0,,Лұқа әкесі мен анасын есіне алды ма?
Dialogue: 0,0:52:02.74,0:52:04.78,Default,,0,0,0,,Иә, сіз қалай ойлайсыз?
Dialogue: 0,0:52:05.95,0:52:09.83,Default,,0,0,0,,Кагуя планетасынан кеткенімізге 1000 жыл болды.
Dialogue: 0,0:52:12.83,0:52:16.00,Default,,0,0,0,,Менің ойымша, екінші тарап оны тез ұмытып кетті.
Dialogue: 0,0:52:16.13,0:52:18.17,Default,,0,0,0,,Бұл дұрыс емес, иә?
Dialogue: 0,0:52:18.51,0:52:21.05,Default,,0,0,0,,Олар нағыз ата-ана мен бала болмаса да
Dialogue: 0,0:52:21.42,0:52:24.26,Default,,0,0,0,,Бұл сенің әкең мен шешең, солай ма?
Dialogue: 0,0:52:24.93,0:52:28.18,Default,,0,0,0,,Мен оның Лука және басқалар туралы ойлағанына сенімдімін.
Dialogue: 0,0:52:28.77,0:52:29.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:32.69,0:52:35.06,Default,,0,0,0,,Иә?Бұл біртүрлі
Dialogue: 0,0:52:35.44,0:52:36.98,Default,,0,0,0,,Маған орындауға рұқсат етіңіз
Dialogue: 0,0:52:37.27,0:52:38.65,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:52:41.36,0:52:42.20,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:52:47.24,0:52:49.45,Default,,0,0,0,,Гехо Гехо...
Dialogue: 0,0:52:50.54,0:52:52.66,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:52:53.04,0:52:55.42,Default,,0,0,0,,А, анау бет... кір...
Dialogue: 0,0:52:57.09,0:52:58.71,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:53:02.72,0:53:05.34,Default,,0,0,0,,Yaho! Бірінші болыңыз!
Dialogue: 0,0:53:06.93,0:53:09.31,Default,,0,0,0,,Бұл ойын сияқты және көңілді!
Dialogue: 0,0:53:10.14,0:53:12.23,Default,,0,0,0,,Эй, Сунео, орнына жүр!
Dialogue: 0,0:53:12.39,0:53:14.31,Default,,0,0,0,,Джиан үшін бұл мүмкін емес.
Dialogue: 0,0:53:14.44,0:53:16.65,Default,,0,0,0,,Не! (Сунео) Эй...
Dialogue: 0,0:53:16.77,0:53:18.48,Default,,0,0,0,,Шағымданба және өзгерме!
Dialogue: 0,0:53:18.61,0:53:19.90,Default,,0,0,0,,Тоқта, бұл қауіпті!
Dialogue: 0,0:53:20.03,0:53:21.90,Default,,0,0,0,,Уф... аа!
Dialogue: 0,0:53:22.24,0:53:23.36,Default,,0,0,0,,Бұрын! бұрын!
Dialogue: 0,0:53:23.49,0:53:24.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:24.45,0:53:25.86,Default,,0,0,0,,Гах! (Сунео) Анашым!
Dialogue: 0,0:53:26.91,0:53:28.20,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:53:33.50,0:53:35.67,Default,,0,0,0,,Кя~! қауіпті!
Dialogue: 0,0:53:36.88,0:53:37.88,Default,,0,0,0,,Не?
Dialogue: 0,0:53:38.50,0:53:39.59,Default,,0,0,0,,Al!
Dialogue: 0,0:53:41.21,0:53:43.26,Default,,0,0,0,,Капитан! Капитан Годдард!
Dialogue: 0,0:53:45.47,0:53:46.68,Default,,0,0,0,,Рыцарь Рейнхарт.
Dialogue: 0,0:53:46.97,0:53:47.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:50.39,0:53:51.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:53:52.93,0:53:54.18,Default,,0,0,0,,О...
Dialogue: 0,0:53:54.64,0:53:56.39,Default,,0,0,0,,Ғарыш картасы?
Dialogue: 0,0:53:58.06,0:54:00.32,Default,,0,0,0,,Күн жүйесіндегі үшінші планетаның серігінен
Dialogue: 0,0:54:00.44,0:54:02.11,Default,,0,0,0,,Күшті реакция бар
Dialogue: 0,0:54:02.40,0:54:05.24,Default,,0,0,0,,S-PAL ырым емес пе?
Dialogue: 0,0:54:05.45,0:54:07.78,Default,,0,0,0,,Мен де өтірікшімін деп ойладым.
Dialogue: 0,0:54:08.20,0:54:11.79,Default,,0,0,0,,Барлық мүшелер! Бірден бұраңыз.
Dialogue: 0,0:54:12.45,0:54:13.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:54:14.08,0:54:16.12,Default,,0,0,0,,Ой... жақсы...
Dialogue: 0,0:54:16.25,0:54:18.04,Default,,0,0,0,,Оны ашық ұстаңыз...
Dialogue: 0,0:54:18.17,0:54:19.46,Default,,0,0,0,,Ол сақталды ма?
Dialogue: 0,0:54:19.58,0:54:21.13,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:54:22.17,0:54:24.05,Default,,0,0,0,,Аль, жақсысың ба?
Dialogue: 0,0:54:24.97,0:54:26.22,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:54:26.72,0:54:29.09,Default,,0,0,0,,Күшті күш жақсы болмаса да...
Dialogue: 0,0:54:30.64,0:54:32.06,Default,,0,0,0,,Al!
Dialogue: 0,0:54:32.97,0:54:33.85,Default,,0,0,0,,Al!
Dialogue: 0,0:54:33.97,0:54:36.48,Default,,0,0,0,,Лука-нии-тан! Луна әпке!
Dialogue: 0,0:54:37.81,0:54:40.61,Default,,0,0,0,,Құдіретімді босатқаным жақсы емес пе?
Dialogue: 0,0:54:40.73,0:54:42.98,Default,,0,0,0,,Кешіріңіз! мен…
Dialogue: 0,0:54:43.40,0:54:46.07,Default,,0,0,0,,Сәлем! Әл жаман емес
Dialogue: 0,0:54:46.61,0:54:48.49,Default,,0,0,0,,Ол бізге көмектесті.
Dialogue: 0,0:54:48.66,0:54:50.95,Default,,0,0,0,,Біз көлік жүргізетінбіз.
Dialogue: 0,0:54:51.45,0:54:53.03,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:54:53.54,0:54:57.25,Default,,0,0,0,,Мәселе мынада: Ал күшті күш қолданған.
Dialogue: 0,0:54:57.66,0:55:00.67,Default,,0,0,0,,Мен мұны осы уақыт бойы жасырып жүрсем де...
Dialogue: 0,0:55:01.17,0:55:04.17,Default,,0,0,0,,Люк, сендер қандайсыңдар...
Dialogue: 0,0:55:04.30,0:55:06.13,Default,,0,0,0,,Сіз біреуден қашып жүрсіз бе?
Dialogue: 0,0:55:08.17,0:55:09.59,Default,,0,0,0,,Бөтен планеталық Кагуя
Dialogue: 0,0:55:09.97,0:55:10.80,Default,,0,0,0,,Не!
Dialogue: 0,0:55:11.18,0:55:12.01,Default,,0,0,0,,Не!
Dialogue: 0,0:55:12.64,0:55:15.85,Default,,0,0,0,,1000 жыл бұрын Кагуя планетасының әскерилері...
Dialogue: 0,0:55:16.02,0:55:20.52,Default,,0,0,0,,Біз өз күшімізді қолданатын қуатты жойқын қару жасадық.
Dialogue: 0,0:55:24.19,0:55:27.28,Default,,0,0,0,,Ал өз күшіңді көрсету үшін
Dialogue: 0,0:55:27.40,0:55:30.32,Default,,0,0,0,,Мен Кагуя планетасының айын жоюға тырыстым, бірақ...
Dialogue: 0,0:55:32.87,0:55:36.62,Default,,0,0,0,,Жарылған айдың фрагменттері Кагуя планетасына да шашыранды.
Dialogue: 0,0:55:36.75,0:55:38.71,Default,,0,0,0,,Байланыс немесе жарылу орын алды
Dialogue: 0,0:55:40.42,0:55:42.58,Default,,0,0,0,,Аспанды түтін басып тұр
Dialogue: 0,0:55:42.71,0:55:46.21,Default,,0,0,0,,Жарықсыз түн әлеміне айналды.
Dialogue: 0,0:55:47.21,0:55:48.30,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:55:49.30,0:55:50.47,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:55:52.14,0:55:53.97,Default,,0,0,0,,Әке мен ана
Dialogue: 0,0:55:54.10,0:55:57.39,Default,,0,0,0,,Біздің күшіміз енді теріс пайдаланылмауы үшін.
Dialogue: 0,0:55:57.60,0:55:59.81,Default,,0,0,0,,Мен оны ғарыш кемесіне түсірдім
Dialogue: 0,0:56:01.23,0:56:03.48,Default,,0,0,0,,Жоқ! Мен де қаламын!
Dialogue: 0,0:56:03.94,0:56:05.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:08.61,0:56:10.65,Default,,0,0,0,,Лұқа, түсініңізші.
Dialogue: 0,0:56:11.24,0:56:13.91,Default,,0,0,0,,Оған көмектесу мүмкін емес... Ах.
Dialogue: 0,0:56:14.45,0:56:16.87,Default,,0,0,0,,Жоқ, жоқ! Жоқ!
Dialogue: 0,0:56:19.12,0:56:20.16,Default,,0,0,0,,Ах
Dialogue: 0,0:56:20.83,0:56:22.25,Default,,0,0,0,,Тезірек кемеге мін!
Dialogue: 0,0:56:22.75,0:56:23.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:25.29,0:56:27.13,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:56:29.92,0:56:31.01,Default,,0,0,0,,Луна
Dialogue: 0,0:56:33.51,0:56:36.93,Default,,0,0,0,,Лұқа... Мен барлығы үшін дұға еттім.
Dialogue: 0,0:56:37.26,0:56:38.10,Default,,0,0,0,,Иә
Dialogue: 0,0:56:39.27,0:56:40.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:41.43,0:56:44.10,Default,,0,0,0,,(дауыс жоқ)
Dialogue: 0,0:56:45.52,0:56:47.07,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:56:51.19,0:56:52.53,Default,,0,0,0,,Міне болды! Ұстаңыз!
Dialogue: 0,0:56:52.90,0:56:56.03,Default,,0,0,0,,Мозо, желкенді жібер, бізді мазалама!
Dialogue: 0,0:56:56.37,0:56:58.08,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:57:00.66,0:57:02.54,Default,,0,0,0,,Күте тұрыңыз! Тістемеңіз!
Dialogue: 0,0:57:02.66,0:57:03.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:04.37,0:57:06.71,Default,,0,0,0,,Кешір мені, Лука!
Dialogue: 0,0:57:11.38,0:57:14.01,Default,,0,0,0,,Кагуя жұлдызы күн энергиясын жоғалтты.
Dialogue: 0,0:57:14.13,0:57:16.14,Default,,0,0,0,,Қатты орта болуы керек
Dialogue: 0,0:57:16.80,0:57:19.47,Default,,0,0,0,,Бұл мәселені шешу үшін бізге әлі де қажет
Dialogue: 0,0:57:19.64,0:57:22.06,Default,,0,0,0,,Мүмкін мен іздеймін.
Dialogue: 0,0:57:22.27,0:57:24.52,Default,,0,0,0,,Жұлдыздарды өзіміз жояық...
Dialogue: 0,0:57:24.64,0:57:26.48,Default,,0,0,0,,Бұл тым өзімшілдік!
Dialogue: 0,0:57:26.73,0:57:29.73,Default,,0,0,0,,Бұл сіздің артыңыздан жаман адамдар келеді дегенді білдіре ме?
Dialogue: 0,0:57:29.86,0:57:31.57,Default,,0,0,0,,Мен бұл туралы естіген жоқпын!
Dialogue: 0,0:57:31.69,0:57:34.61,Default,,0,0,0,,Ақымақ болайық! Бұл 1000 жыл бұрын болды.
Dialogue: 0,0:57:35.45,0:57:37.99,Default,,0,0,0,,Мен бәрін алаңдатқым келмеді.
Dialogue: 0,0:57:38.66,0:57:42.08,Default,,0,0,0,,Қалай болғанда да, мен колонияға тезірек оралуым керек.
Dialogue: 0,0:57:42.20,0:57:44.41,Default,,0,0,0,,(сықырлы дыбыс)
Dialogue: 0,0:57:59.64,0:58:03.60,Default,,0,0,0,,Әдемі... Кәрі Кагуя жұлдызына қарап тұрғандай.
Dialogue: 0,0:58:03.73,0:58:08.40,Default,,0,0,0,,Хехехехе Бұл байлық пен жарықтың қазынасы емес пе?
Dialogue: 0,0:58:08.73,0:58:11.44,Default,,0,0,0,,Тезірек Диаволо мырзаға есеп берейік!
Dialogue: 0,0:58:11.57,0:58:15.53,Default,,0,0,0,,Жоқ, күтіңіз, алдымен Эспалды алғаныңыз дұрыс.
Dialogue: 0,0:58:15.65,0:58:16.86,Default,,0,0,0,,Бірақ... Бірақ!
Dialogue: 0,0:58:18.16,0:58:19.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:20.03,0:58:23.41,Default,,0,0,0,,Кешіріңіз, мен берілмеді деп ойлаймын.
Dialogue: 0,0:58:25.54,0:58:26.37,Default,,0,0,0,,О!
Dialogue: 0,0:58:26.54,0:58:30.04,Default,,0,0,0,,Ұзын ақ құлақ Аңыз бойынша.
Dialogue: 0,0:58:30.21,0:58:31.21,Default,,0,0,0,,Балалар?
Dialogue: 0,0:58:31.54,0:58:33.34,Default,,0,0,0,,Сырт көзге алданып қалмаңыз!
Dialogue: 0,0:58:33.46,0:58:36.97,Default,,0,0,0,,Шын мәнінде ол 1000 жылдан астам өмір сүрді.
Dialogue: 0,0:58:37.72,0:58:39.76,Default,,0,0,0,,Барлық мүшелер шайқасады!
Dialogue: 0,0:58:39.97,0:58:42.89,Default,,0,0,0,,Қонған бойда Эспалды тірі қалдырыңыз!
Dialogue: 0,0:58:43.06,0:58:43.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:58:44.10,0:58:46.73,Default,,0,0,0,,Эфирге қарсы шара қолдануды ұмытпаңыз!
Dialogue: 0,0:58:49.56,0:58:50.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:51.06,0:58:52.94,Default,,0,0,0,,Колония алқабына асығыңыз!
Dialogue: 0,0:58:54.69,0:58:57.57,Default,,0,0,0,,Лука-нии-чан! Луна әпке!
Dialogue: 0,0:58:57.90,0:58:59.07,Default,,0,0,0,,Не болды?
Dialogue: 0,0:58:59.24,0:59:01.07,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:59:01.41,0:59:02.49,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:59:02.70,0:59:03.70,Default,,0,0,0,,Келме!
Dialogue: 0,0:59:15.55,0:59:18.88,Default,,0,0,0,,Ағымдағы оқтарды қолданбаңыз! соққы сәулесін қолданыңыз
Dialogue: 0,0:59:19.05,0:59:20.68,Default,,0,0,0,,Бүгін түстен кейін мектеп әлеуметтік жиналысқа жабық болады.
Dialogue: 0,0:59:21.26,0:59:22.10,Default,,0,0,0,,Ах
Dialogue: 0,0:59:22.30,0:59:24.47,Default,,0,0,0,,Жаман! Уте!
Dialogue: 0,0:59:26.93,0:59:27.77,Default,,0,0,0,,Хмф!
Dialogue: 0,0:59:28.60,0:59:29.77,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:59:29.89,0:59:30.73,Default,,0,0,0,,Әй!
Dialogue: 0,0:59:30.85,0:59:32.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:33.61,0:59:35.23,Default,,0,0,0,,Ммм
Dialogue: 0,0:59:35.36,0:59:36.19,Default,,0,0,0,,Эй!
Dialogue: 0,0:59:36.44,0:59:37.53,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:59:37.65,0:59:39.36,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:59:39.57,0:59:40.53,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:59:40.66,0:59:41.78,Default,,0,0,0,,Бұл эфир...
Dialogue: 0,0:59:42.37,0:59:45.29,Default,,0,0,0,,Мен эфирге қарсы шараларды ұмытпа деп айттым!
Dialogue: 0,0:59:45.87,0:59:47.95,Default,,0,0,0,,Aethermuter іске қосыңыз!
Dialogue: 0,0:59:53.21,0:59:54.38,Default,,0,0,0,,Өте!
Dialogue: 0,1:00:04.18,1:00:05.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:05.31,1:00:06.18,Default,,0,0,0,,Не?
Dialogue: 0,1:00:06.31,1:00:07.56,Default,,0,0,0,,Құмды жаңбыр?
Dialogue: 0,1:00:07.97,1:00:10.98,Default,,0,0,0,,Бұл не екенін білесің бе?
Dialogue: 0,1:00:11.52,1:00:12.77,Default,,0,0,0,,Ах!
Dialogue: 0,1:00:13.10,1:00:14.61,Default,,0,0,0,,Луна! (Сунео) Луна-чан!
Dialogue: 0,1:00:15.02,1:00:16.52,Default,,0,0,0,,Егер ол адам болса, мені кісі өлтіру айыбымен айыптайтын еді—
Dialogue: 0,1:00:16.65,1:00:18.07,Default,,0,0,0,,Al! Тұрақты!
Dialogue: 0,1:00:18.99,1:00:22.03,Default,,0,0,0,,Эфир... Эфирді пайдалану мүмкін емес.
Dialogue: 0,1:00:22.16,1:00:22.99,Default,,0,0,0,,Не!
Dialogue: 0,1:00:23.62,1:00:26.20,Default,,0,0,0,,Эфирсіз сен баласың!
Dialogue: 0,1:00:26.53,1:00:28.49,Default,,0,0,0,,Оны бортқа отырғызыңыз!
Dialogue: 0,1:00:28.62,1:00:30.33,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,1:00:30.96,1:00:33.25,Default,,0,0,0,,Барлығың ғарыш арбасына мініңдер!
Dialogue: 0,1:00:33.37,1:00:35.29,Default,,0,0,0,,Уау... аа!
Dialogue: 0,1:00:37.30,1:00:39.05,Default,,0,0,0,,Басқа S-Pals туралы не деуге болады?
Dialogue: 0,1:00:39.17,1:00:40.84,Default,,0,0,0,,Менің сізге кейінірек көмектесуден басқа амалым жоқ!
Dialogue: 0,1:00:44.34,1:00:45.35,Default,,0,0,0,,Әй!
Dialogue: 0,1:00:45.93,1:00:47.60,Default,,0,0,0,,Chase! Тістемеңіз!
Dialogue: 0,1:00:51.56,1:00:53.02,Default,,0,0,0,,Лука, мықты бол!
Dialogue: 0,1:00:53.35,1:00:54.52,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:55.15,1:00:56.73,Default,,0,0,0,,Уф... Мен сені қуып келемін!
Dialogue: 0,1:00:56.86,1:00:57.94,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:59.57,1:01:01.86,Default,,0,0,0,,(дыбыстық сигнал дыбысы)
Dialogue: 0,1:01:02.20,1:01:03.82,Default,,0,0,0,,Итадаки!
Dialogue: 0,1:01:05.37,1:01:06.20,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:07.28,1:01:08.70,Default,,0,0,0,,Al!
Dialogue: 0,1:01:11.20,1:01:13.08,Default,,0,0,0,,Уау...
Dialogue: 0,1:01:13.21,1:01:14.62,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:16.96,1:01:19.55,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:19.88,1:01:21.01,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:01:22.26,1:01:23.97,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,1:01:26.22,1:01:27.85,Default,,0,0,0,,Уф! Өтінемін қашып кет!
Dialogue: 0,1:01:27.97,1:01:29.22,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,1:01:29.60,1:01:30.97,Default,,0,0,0,,Луна-чан!
Dialogue: 0,1:01:31.10,1:01:32.23,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:01:32.81,1:01:34.39,Default,,0,0,0,,Артқа, Дораемон!
Dialogue: 0,1:01:34.52,1:01:35.90,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,1:01:36.23,1:01:38.40,Default,,0,0,0,,Мен оны басқара алмаймын!
Dialogue: 0,1:01:39.73,1:01:40.90,Default,,0,0,0,,Ах... Лука!
Dialogue: 0,1:01:41.23,1:01:43.86,Default,,0,0,0,,Жоқ! Қазір қайтсем де, ұстап аламын!
Dialogue: 0,1:01:44.40,1:01:47.32,Default,,0,0,0,,Ақымақ болайық! Жаман ештеңе жасама
Dialogue: 0,1:01:47.87,1:01:51.74,Default,,0,0,0,,Нобита, сен айға келген есікке қайта аласың ба?
Dialogue: 0,1:01:51.87,1:01:53.41,Default,,0,0,0,,Сіз барлық жерде есіктер туралы айтасыз ба?
Dialogue: 0,1:01:53.62,1:01:56.29,Default,,0,0,0,,Түсіндім! Егер мен Жерге кез келген жерде есікпен орала алсам ...
Dialogue: 0,1:01:56.42,1:01:57.25,Default,,0,0,0,,Иә
Dialogue: 0,1:01:57.75,1:01:59.63,Default,,0,0,0,,Клуб ісігі
Dialogue: 0,1:02:01.13,1:02:03.05,Default,,0,0,0,,Сіз барлық эспальдарды басып алдыңыз ба?
Dialogue: 0,1:02:03.30,1:02:05.22,Default,,0,0,0,,Тағы бір пики болуы керек!
Dialogue: 0,1:02:06.93,1:02:11.43,Default,,0,0,0,,Сол қоян шынымен де мені көп қиындыққа ұшыратты.
Dialogue: 0,1:02:11.89,1:02:15.44,Default,,0,0,0,,Егер солай болса, мен де жарысқа қатысар едім.
Dialogue: 0,1:02:16.89,1:02:17.90,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:19.36,1:02:20.86,Default,,0,0,0,,Мотоциклді қолданғандағыдай, ол—
Dialogue: 0,1:02:21.15,1:02:22.78,Default,,0,0,0,,Уа! Тасбақа!
Dialogue: 0,1:02:26.24,1:02:29.74,Default,,0,0,0,,брррррррррррррррррррррррррррррррррррррррррррррррррррррррррррррррррррррррррр есік алдында болды! тез!
Dialogue: 0,1:02:34.04,1:02:36.00,Default,,0,0,0,,Нобита-кунның бөлмесіне!
Dialogue: 0,1:02:38.46,1:02:39.29,Default,,0,0,0,,Лұқа!
Dialogue: 0,1:02:39.83,1:02:41.46,Default,,0,0,0,,Мен қала беремін
Dialogue: 0,1:02:42.17,1:02:44.30,Default,,0,0,0,,Сіз достарыңызды қалдыра алмайсыз.
Dialogue: 0,1:02:44.71,1:02:47.76,Default,,0,0,0,,Олай болса мен де сенің досыңмын!
Dialogue: 0,1:02:50.22,1:02:51.72,Default,,0,0,0,,Өйткені біз доспыз
Dialogue: 0,1:02:51.89,1:02:53.31,Default,,0,0,0,,Нигасука!
Dialogue: 0,1:02:53.93,1:02:54.93,Default,,0,0,0,,Лұқа!
Dialogue: 0,1:02:57.14,1:02:57.98,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:58.56,1:02:59.94,Default,,0,0,0,,Гехехехе…
Dialogue: 0,1:03:00.06,1:03:01.27,Default,,0,0,0,,Ақымақ нәрсе!
Dialogue: 0,1:03:02.44,1:03:04.48,Default,,0,0,0,,Егер сізді S-Pal қағып кетсе, не істеу керек
Dialogue: 0,1:03:04.65,1:03:05.65,Default,,0,0,0,,Міне!
Dialogue: 0,1:03:06.07,1:03:07.65,Default,,0,0,0,,Мм... tsk!
Dialogue: 0,1:03:08.65,1:03:11.12,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:12.62,1:03:13.99,Default,,0,0,0,,Ақыры сені кездестірдім.
Dialogue: 0,1:03:14.12,1:03:16.29,Default,,0,0,0,,Сол жылы тағы бір үрей басталды
Dialogue: 0,1:03:19.50,1:03:22.71,Default,,0,0,0,,Бұл ысырап. Жасыратын жер жоқ.
Dialogue: 0,1:03:25.13,1:03:25.96,Default,,0,0,0,,Ах
Dialogue: 0,1:03:31.01,1:03:32.93,Default,,0,0,0,,Сіз не қарап тұрсыз? сурет?
Dialogue: 0,1:03:33.05,1:03:35.35,Default,,0,0,0,,Қараңғы шөл далада достар бар ма?
Dialogue: 0,1:03:36.31,1:03:37.14,Default,,0,0,0,,Ha
Dialogue: 0,1:03:38.98,1:03:42.31,Default,,0,0,0,,Мына оғаш дүниеде не жаратылғанын көре алмаймын.
Dialogue: 0,1:03:45.61,1:03:46.44,Default,,0,0,0,,Әй!
Dialogue: 0,1:03:48.95,1:03:50.95,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:51.11,1:03:53.37,Default,,0,0,0,,Айда есік бұзылды!
Dialogue: 0,1:03:53.53,1:03:56.54,Default,,0,0,0,,Міне! Айға қайта орала алмаймыз ба?
Dialogue: 0,1:03:56.70,1:03:58.20,Default,,0,0,0,,Nnu!
Dialogue: 0,1:03:58.37,1:04:01.71,Default,,0,0,0,,Бұл рас па? Біз ғана көмектесе алатынымызға сене алар емеспін!
Dialogue: 0,1:04:01.87,1:04:03.50,Default,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,1:04:03.63,1:04:06.34,Default,,0,0,0,,Мен мұндай нәрсе болады деп ойламадым.
Dialogue: 0,1:04:06.46,1:04:09.72,Default,,0,0,0,,Иә! Жиренген жоқсың ба!
Dialogue: 0,1:04:10.30,1:04:14.68,Default,,0,0,0,,Бұл ұят, тіпті мен де көмек алдым!
Dialogue: 0,1:04:15.76,1:04:18.02,Default,,0,0,0,,Кем дегенде бір Лұқа қалды
Dialogue: 0,1:04:18.14,1:04:19.73,Default,,0,0,0,,Менің достарым үшін...
Dialogue: 0,1:04:20.56,1:04:22.65,Default,,0,0,0,,Takecopter-ге көмектесейік!
Dialogue: 0,1:04:22.81,1:04:24.52,Default,,0,0,0,,Дөрекі болма!
Dialogue: 0,1:04:24.73,1:04:27.73,Default,,0,0,0,,Жерден Айға дейінгі қашықтық 380 000 км!
Dialogue: 0,1:04:27.90,1:04:30.07,Default,,0,0,0,,Жақын көрінсе де, алыс
Dialogue: 0,1:04:30.49,1:04:32.07,Default,,0,0,0,,Бұл...
Dialogue: 0,1:04:33.07,1:04:34.53,Default,,0,0,0,,Ух... кя!
Dialogue: 0,1:04:36.41,1:04:37.49,Default,,0,0,0,,Мозо!
Dialogue: 0,1:04:37.62,1:04:40.00,Default,,0,0,0,,Айға баратын жол бар!
Dialogue: 0,1:04:40.25,1:04:43.96,Default,,0,0,0,,Бұл жерде Лука екеуміз Жерге келген ғарыш кемесі бар.
Dialogue: 0,1:04:44.08,1:04:44.92,Default,,0,0,0,,Иә!?
Dialogue: 0,1:04:46.38,1:04:49.42,Default,,0,0,0,,Мен Лукамен алғаш рет осы жерде кездестім...
Dialogue: 0,1:04:50.76,1:04:52.88,Default,,0,0,0,,Менің ойымша, бұл ағаштың астында ...
Dialogue: 0,1:04:54.43,1:04:56.93,Default,,0,0,0,,Parpalmozorka Godalunte!
Dialogue: 0,1:05:02.10,1:05:04.81,Default,,0,0,0,,Уау! (Нобита) Бұл шынымен болды!
Dialogue: 0,1:05:06.36,1:05:09.44,Default,,0,0,0,,Ол өте кішкентай, бірақ оны әркім міне ала ма?
Dialogue: 0,1:05:09.61,1:05:13.36,Default,,0,0,0,,Бұл Айдағы ғарыш кемесінен түсірілген тіршілік ұшағы.
Dialogue: 0,1:05:13.78,1:05:18.20,Default,,0,0,0,,Жарайды, өзгертейік! Бұл біраз уақытты алады
Dialogue: 0,1:05:18.33,1:05:21.29,Default,,0,0,0,,Егер сіз 22 ғасыр технологиясын қоссаңыз, сіз бәрін жасай аласыз!
Dialogue: 0,1:05:21.95,1:05:23.79,Default,,0,0,0,,Барлығы үйде демалады
Dialogue: 0,1:05:23.92,1:05:26.33,Default,,0,0,0,,19:00-де осында қайта жиналыңыз!
Dialogue: 0,1:05:26.46,1:05:27.29,Default,,0,0,0,,Иә!
Dialogue: 0,1:05:27.63,1:05:30.42,Default,,0,0,0,,Дегенмен, бұл қауіпті саяхат болады.
Dialogue: 0,1:05:30.63,1:05:33.38,Default,,0,0,0,,Жасына алмасаң, Жерде қалуың керек!
Dialogue: 0,1:05:33.51,1:05:34.26,Default,,0,0,0,,Уф...
Dialogue: 0,1:05:37.26,1:05:42.14,Default,,0,0,0,,♪～
Dialogue: 0,1:07:21.24,1:07:26.33,Default,,0,0,0,,～♪
Dialogue: 0,1:07:26.41,1:07:29.58,Default,,0,0,0,,Кететін уақыт та аз қалды.
Dialogue: 0,1:07:30.25,1:07:33.59,Default,,0,0,0,,Тағы біраз күтіңіз, Сунео әлі осында...
Dialogue: 0,1:07:33.75,1:07:35.71,Default,,0,0,0,,Эй!
Dialogue: 0,1:07:36.76,1:07:39.59,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,1:07:39.76,1:07:42.01,Default,,0,0,0,,Менің шаштарым сәйкес келмейді...
Dialogue: 0,1:07:42.26,1:07:43.55,Default,,0,0,0,,Хахаха
Dialogue: 0,1:07:43.80,1:07:46.27,Default,,0,0,0,,Ақымақ болайық! Сіз кешіктіңіз!
Dialogue: 0,1:07:46.43,1:07:48.43,Default,,0,0,0,,Итататтат!
Dialogue: 0,1:07:49.27,1:07:51.90,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,1:07:52.31,1:07:53.56,Default,,0,0,0,,Хото
Dialogue: 0,1:07:56.19,1:07:58.28,Default,,0,0,0,,Нобита-сан, ай!
Dialogue: 0,1:07:58.44,1:07:59.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:15.38,1:08:17.67,Default,,0,0,0,,Уау?
Dialogue: 0,1:08:18.30,1:08:20.09,Default,,0,0,0,,Төбеге тез шық!
Dialogue: 0,1:08:20.80,1:08:23.51,Default,,0,0,0,,Алдымен соны айт!
Dialogue: 0,1:08:46.78,1:08:50.87,Default,,0,0,0,,Сол шамдардың әрқайсысында біреу өмір сүреді.
Dialogue: 0,1:08:51.00,1:08:52.50,Default,,0,0,0,,Хехехе
Dialogue: 0,1:08:53.04,1:08:54.63,Default,,0,0,0,,Текио жарығы!
Dialogue: 0,1:08:54.75,1:08:58.71,Default,,0,0,0,,Атмосферадан шыққаннан кейін біз жоғары жылдамдықпен жүруге көшеміз.
Dialogue: 0,1:08:58.92,1:09:02.51,Default,,0,0,0,,Айға жету үшін бір күн қажет.
Dialogue: 0,1:09:02.80,1:09:05.47,Default,,0,0,0,,Ішке кіріп демалайық.
Dialogue: 0,1:09:09.10,1:09:10.10,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:10.22,1:09:14.48,Default,,0,0,0,,Ішінде төрт өлшемді кеңістік бар және барлығына арналған жеке бөлмелер бар.
Dialogue: 0,1:09:14.60,1:09:16.15,Default,,0,0,0,,Иә!
Dialogue: 0,1:09:16.52,1:09:17.52,Default,,0,0,0,,Поён!
Dialogue: 0,1:09:19.28,1:09:21.49,Default,,0,0,0,,Күтілгендей монша жоқ.
Dialogue: 0,1:09:22.07,1:09:23.07,Default,,0,0,0,,Мен кінә сезіміне толымын
Dialogue: 0,1:09:23.20,1:09:24.03,Default,,0,0,0,,Иә!?
Dialogue: 0,1:09:27.70,1:09:31.00,Default,,0,0,0,,Жер көрінісі бар монша - сән-салтанат.
Dialogue: 0,1:09:34.21,1:09:36.58,Default,,0,0,0,,Мені күт, Люк.
Dialogue: 0,1:09:42.05,1:09:43.13,Default,,0,0,0,,Лұқа!
Dialogue: 0,1:09:43.26,1:09:44.59,Default,,0,0,0,,Al!
Dialogue: 0,1:09:44.72,1:09:46.05,Default,,0,0,0,,Луна-чан!
Dialogue: 0,1:09:46.47,1:09:48.89,Default,,0,0,0,,Барлығы Кагуя планетасында болса керек...
Dialogue: 0,1:09:49.01,1:09:50.01,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:09:50.14,1:09:52.06,Default,,0,0,0,,(дингі дыбыс)
Dialogue: 0,1:09:56.15,1:09:57.48,Default,,0,0,0,,Нобибиби!
Dialogue: 0,1:09:57.86,1:09:58.86,Default,,0,0,0,,Нобит!
Dialogue: 0,1:09:58.98,1:10:00.15,Default,,0,0,0,,Нобби!
Dialogue: 0,1:10:02.57,1:10:04.53,Default,,0,0,0,,Сізде сөйлесетін нәрсе бар сияқты.
Dialogue: 0,1:10:04.65,1:10:06.03,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:10:09.58,1:10:11.12,Default,,0,0,0,,Knock…bip
Dialogue: 0,1:10:11.24,1:10:12.49,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,1:10:12.70,1:10:15.92,Default,,0,0,0,,Луна-чан! Жақсысың деп үміттенемін!
Dialogue: 0,1:10:16.25,1:10:18.13,Default,,0,0,0,,Барлығына! Ах...
Dialogue: 0,1:10:18.25,1:10:19.92,Default,,0,0,0,,Амансың ба? Ноби бит
Dialogue: 0,1:10:20.54,1:10:23.05,Default,,0,0,0,,Лұқа өз белгісін маған тақты
Dialogue: 0,1:10:23.17,1:10:25.09,Default,,0,0,0,,Ол маған мынаны берді.
Dialogue: 0,1:10:25.42,1:10:28.59,Default,,0,0,0,,Түсіндім! Бөтен планеталық Кагуяда төсбелгі жоқ.
Dialogue: 0,1:10:28.76,1:10:31.10,Default,,0,0,0,,Мен қоян патшалығын көре алмадым.
Dialogue: 0,1:10:31.60,1:10:33.85,Default,,0,0,0,,Менің орнымда Лұқа...
Dialogue: 0,1:10:34.10,1:10:36.06,Default,,0,0,0,,Өйткені мен үнемі ашуланамын
Dialogue: 0,1:10:36.56,1:10:39.31,Default,,0,0,0,,Кагуя келімсектері, мен оларды кешіре алмаймын!
Dialogue: 0,1:10:39.44,1:10:42.57,Default,,0,0,0,,Біз Луканы және басқаларды міндетті түрде құтқарамыз!
Dialogue: 0,1:10:43.19,1:10:44.90,Default,,0,0,0,,Дәрігердің сөмкесі!
Dialogue: 0,1:10:45.03,1:10:48.20,Default,,0,0,0,,Шизука-чан, осында қалып, Лунаға қамқор бол!
Dialogue: 0,1:10:48.32,1:10:49.53,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:10:50.28,1:10:53.95,Default,,0,0,0,,Жәндіктер туралы дабыл және қосалқы қалта!
Dialogue: 0,1:10:54.58,1:10:56.58,Default,,0,0,0,,Кагуя планетасында бірдеңе болса
Dialogue: 0,1:10:56.71,1:10:58.79,Default,,0,0,0,,Жәндіктер туралы хабарландыру дабылы
Dialogue: 0,1:10:58.96,1:11:00.75,Default,,0,0,0,,Қосалқы қалта менің қалтам.
Dialogue: 0,1:11:00.88,1:11:04.71,Default,,0,0,0,,Ол жалғанғандықтан, апаттан құтылу үшін оны сол жерде қалдырыңыз.
Dialogue: 0,1:11:05.01,1:11:06.92,Default,,0,0,0,,Ноби Нобиби!
Dialogue: 0,1:11:07.09,1:11:08.59,Default,,0,0,0,,Нобби...бип
Dialogue: 0,1:11:09.01,1:11:12.47,Default,,0,0,0,,Мочи! Рахмет Нобит
Dialogue: 0,1:11:12.60,1:11:13.43,Default,,0,0,0,,No-Vivi!
Dialogue: 0,1:11:13.97,1:11:17.39,Default,,0,0,0,,Луна-чан, мен міндетті түрде қайтамын!
Dialogue: 0,1:11:17.73,1:11:19.44,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:11:19.56,1:11:21.23,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,1:11:21.65,1:11:22.90,Default,,0,0,0,,Нобиби!
Dialogue: 0,1:11:23.69,1:11:25.32,Default,,0,0,0,,Мозоның нұсқаулығына сәйкес
Dialogue: 0,1:11:25.86,1:11:28.82,Default,,0,0,0,,Кагуя жұлдызына дейін шамамен 40 жарық жылы
Dialogue: 0,1:11:28.99,1:11:31.32,Default,,0,0,0,,Жарық жылдамдығының өзінде 40 жыл қажет
Dialogue: 0,1:11:31.49,1:11:32.32,Default,,0,0,0,,Иә!
Dialogue: 0,1:11:32.57,1:11:34.91,Default,,0,0,0,,Мен бұлай тыныш отыра алмаймын!
Dialogue: 0,1:11:35.04,1:11:37.79,Default,,0,0,0,,Жеткенше қарт боласың!
Dialogue: 0,1:11:38.16,1:11:42.67,Default,,0,0,0,,О? Барлығыңыз warp навигациясы туралы білмейсіз бе?
Dialogue: 0,1:11:42.79,1:11:45.84,Default,,0,0,0,,Егер сіз warp қолдансаңыз, сіз Кагуя планетасында бірден боласыз.
Dialogue: 0,1:11:46.38,1:11:50.18,Default,,0,0,0,,Сол және оң басқару тетіктерін бір уақытта басып көріңіз.
Dialogue: 0,1:11:50.30,1:11:52.26,Default,,0,0,0,,Олай болса, бастайық.
Dialogue: 0,1:11:52.34,1:11:53.35,Default,,0,0,0,,Бұрыс!
Dialogue: 0,1:12:05.40,1:12:06.69,Default,,0,0,0,,Құрметті Диаволо
Dialogue: 0,1:12:06.86,1:12:09.19,Default,,0,0,0,,Біз Эспальдарды басып алдық.
Dialogue: 0,1:12:09.36,1:12:11.20,Default,,0,0,0,,Ол бастық.
Dialogue: 0,1:12:11.86,1:12:12.70,Default,,0,0,0,,Әй!
Dialogue: 0,1:12:13.24,1:12:14.87,Default,,0,0,0,,Бұл үлкен мәселе болды
Dialogue: 0,1:12:15.53,1:12:18.66,Default,,0,0,0,,Өтірік жақсы.
Dialogue: 0,1:12:19.16,1:12:20.00,Default,,0,0,0,,Ха!
Dialogue: 0,1:12:20.66,1:12:24.13,Default,,0,0,0,,Егер сіз Кагуя планетасын эфирдің күшімен алып кетеді деп ойласаңыз
Dialogue: 0,1:12:24.25,1:12:26.38,Default,,0,0,0,,Мен бір нәрсеге сенімдімін: полиция араласқан күнде де өзімді қорғай аламын.
Dialogue: 0,1:12:27.17,1:12:32.05,Default,,0,0,0,,S-PAL қарағанда жақсырақ нәрсе тапқан сияқтысыз.
Dialogue: 0,1:12:32.38,1:12:33.47,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:12:34.22,1:12:37.31,Default,,0,0,0,,Бұл жұлдыз өте әдемі
Dialogue: 0,1:12:37.64,1:12:40.39,Default,,0,0,0,,Бұл ескі Кагуя планетасына ұқсайды.
Dialogue: 0,1:12:40.73,1:12:41.73,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:41.85,1:12:43.40,Default,,0,0,0,,Хехехехе
Dialogue: 0,1:12:45.73,1:12:47.36,Default,,0,0,0,,Хехехе... (Годард) Тараба!
Dialogue: 0,1:12:48.15,1:12:51.40,Default,,0,0,0,,S-PAL күшімен тіпті жою қаруларын да қайта жандандыруға болады.
Dialogue: 0,1:12:51.53,1:12:56.58,Default,,0,0,0,,Егер сіз мұны жасасаңыз, бұл жұлдызды алу оңай болады.
Dialogue: 0,1:12:57.24,1:12:59.95,Default,,0,0,0,,Жер... Сіз Жерді айтасыз ба?
Dialogue: 0,1:13:00.08,1:13:01.25,Default,,0,0,0,,Бұл сіздің алдыңызда!
Dialogue: 0,1:13:02.08,1:13:04.29,Default,,0,0,0,,Фухахахаха
Dialogue: 0,1:13:04.42,1:13:07.00,Default,,0,0,0,,Ол Жер деп аталады ма? Ол планета
Dialogue: 0,1:13:07.63,1:13:09.34,Default,,0,0,0,,Эспалды кім басып алды?
Dialogue: 0,1:13:09.46,1:13:11.92,Default,,0,0,0,,Бұл жұлдыз Кагуяға жарық қайтару үшін ме?
Dialogue: 0,1:13:12.55,1:13:15.26,Default,,0,0,0,,Бұл жұлдыз енді қара емес
Dialogue: 0,1:13:15.76,1:13:18.43,Default,,0,0,0,,Жерді басып ал!
Dialogue: 0,1:13:19.47,1:13:21.31,Default,,0,0,0,,Қаруды қайтаруға дайындық
Dialogue: 0,1:13:21.43,1:13:24.35,Default,,0,0,0,,Эспальдарды түрмеде ұстаңыз!
Dialogue: 0,1:13:25.85,1:13:26.73,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:28.36,1:13:29.61,Default,,0,0,0,,Га
Dialogue: 0,1:13:29.78,1:13:31.57,Default,,0,0,0,,Хахахаха!
Dialogue: 0,1:13:31.94,1:13:35.07,Default,,0,0,0,,Бүгіннен бастап капитан Тараба-сама болады.
Dialogue: 0,1:13:35.20,1:13:38.03,Default,,0,0,0,,Енді бұйрық беруге болмайды!
Dialogue: 0,1:13:39.70,1:13:41.12,Default,,0,0,0,,Нигеро, иә?
Dialogue: 0,1:13:41.58,1:13:43.29,Default,,0,0,0,,Тыңдап тұрсың ба, Годар?
Dialogue: 0,1:13:43.41,1:13:44.25,Default,,0,0,0,,Тох!?
Dialogue: 0,1:13:45.21,1:13:47.08,Default,,0,0,0,,Уф...
Dialogue: 0,1:13:48.92,1:13:49.75,Default,,0,0,0,,Әй!
Dialogue: 0,1:13:50.00,1:13:51.05,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:53.92,1:13:54.80,Default,,0,0,0,,Эй!
Dialogue: 0,1:13:56.18,1:13:58.72,Default,,0,0,0,,А... неге?
Dialogue: 0,1:13:59.35,1:14:02.39,Default,,0,0,0,,Біз сізді қару ретінде пайдалануға жол бере алмаймыз!
Dialogue: 0,1:14:02.81,1:14:03.64,Default,,0,0,0,,Жүр!
Dialogue: 0,1:14:03.93,1:14:04.94,Default,,0,0,0,,Ах
Dialogue: 0,1:14:05.19,1:14:07.10,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:09.40,1:14:11.19,Default,,0,0,0,,Император гвардиясы?
Dialogue: 0,1:14:11.48,1:14:12.48,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:14.61,1:14:15.61,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,1:14:17.66,1:14:20.45,Default,,0,0,0,,Не?!
Dialogue: 0,1:14:21.79,1:14:25.91,Default,,0,0,0,,Ақымақ Годар, құбыжықтың жағында болу?
Dialogue: 0,1:14:26.50,1:14:28.67,Default,,0,0,0,,Ұят болды!
Dialogue: 0,1:14:28.96,1:14:32.34,Default,,0,0,0,,Кагуя планетасын тастап, оны басқа жұлдыздарға таратайық!
Dialogue: 0,1:14:32.55,1:14:33.84,Default,,0,0,0,,Дамаме~!
Dialogue: 0,1:14:36.84,1:14:37.97,Default,,0,0,0,,Аһ!
Dialogue: 0,1:14:38.26,1:14:39.43,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:42.60,1:14:44.35,Default,,0,0,0,,Агу агу…
Dialogue: 0,1:14:44.52,1:14:47.69,Default,,0,0,0,,Енді конняку жейміз.
Dialogue: 0,1:14:48.06,1:14:51.69,Default,,0,0,0,,Кагуя шетелдіктері сіздің тіліңізді түсінбейді.
Dialogue: 0,1:14:51.82,1:14:53.07,Default,,0,0,0,,Шығу!
Dialogue: 0,1:14:55.94,1:14:56.78,Default,,0,0,0,,Уау!
Dialogue: 0,1:15:14.09,1:15:17.22,Default,,0,0,0,,Біз қазір тамақ таратамыз. Сапқа тұрыңыз!
Dialogue: 0,1:15:18.68,1:15:20.01,Default,,0,0,0,,Оны осында беріңіз!
Dialogue: 0,1:15:20.14,1:15:21.55,Default,,0,0,0,,Мен де!
Dialogue: 0,1:15:22.39,1:15:23.22,Default,,0,0,0,,Уф!
Dialogue: 0,1:15:23.35,1:15:26.06,Default,,0,0,0,,Суық көрінеді. (Анашым) Мұнда кел.
Dialogue: 0,1:15:26.98,1:15:29.85,Default,,0,0,0,,Маған көп жұмыс істеуге рұқсат етіңіз. Мынау ма?
Dialogue: 0,1:15:29.98,1:15:31.86,Default,,0,0,0,,Барған сайын аз
Dialogue: 0,1:15:32.73,1:15:34.07,Default,,0,0,0,,Лұқа айтқандай
Dialogue: 0,1:15:34.23,1:15:37.32,Default,,0,0,0,,Азық-түлік пен энергия тапшы.
Dialogue: 0,1:15:37.78,1:15:40.91,Default,,0,0,0,,Қалай болғанда да, мен Лука мен басқаларды тез тауып алуым керек.
Dialogue: 0,1:15:41.07,1:15:42.74,Default,,0,0,0,,Мозо, маған айналаны көрсет.
Dialogue: 0,1:15:43.03,1:15:45.87,Default,,0,0,0,,Мен 1000 жыл бұрын өмір сүрдім.
Dialogue: 0,1:15:45.99,1:15:47.75,Default,,0,0,0,,Маған қазіргі география ұнамайды.
Dialogue: 0,1:15:47.96,1:15:49.62,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,1:15:49.75,1:15:52.71,Default,,0,0,0,,Жақсы! Мен сенен сұрайын
Dialogue: 0,1:15:53.00,1:15:54.21,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,1:15:54.34,1:15:57.84,Default,,0,0,0,,Эй, S-PAL қайда?
Dialogue: 0,1:15:57.97,1:15:58.92,Default,,0,0,0,,Не!
Dialogue: 0,1:15:59.09,1:16:02.43,Default,,0,0,0,,Ол жерде болуы мүмкін емес, бұл аңыз.
Dialogue: 0,1:16:02.84,1:16:06.39,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,1:16:06.68,1:16:09.77,Default,,0,0,0,,Егер ол болса да, ол бәрібір қалыпты адам болар еді, солай ма?
Dialogue: 0,1:16:09.89,1:16:12.35,Default,,0,0,0,,Бұл жағынан Диаволо мырза басқаша.
Dialogue: 0,1:16:12.81,1:16:14.06,Default,,0,0,0,,Мен сені ұзақ уақыттан бері күтіп жүрмін
Dialogue: 0,1:16:14.40,1:16:15.98,Default,,0,0,0,,Өйткені, ол адам
Dialogue: 0,1:16:16.11,1:16:20.53,Default,,0,0,0,,Өйткені бұл планетаны 1000 жыл бойы билеген императордың қаны.
Dialogue: 0,1:16:20.86,1:16:23.28,Default,,0,0,0,,Бұл планета осылай болып шықты.
Dialogue: 0,1:16:23.41,1:16:26.24,Default,,0,0,0,,Бұл императордың бірнеше рет соғысқандығынан болса керек.
Dialogue: 0,1:16:26.37,1:16:29.62,Default,,0,0,0,,Сәлем! Шхх, сен түрмеге түсесің.
Dialogue: 0,1:16:30.08,1:16:34.50,Default,,0,0,0,,Мазаламаймын! Қазірдің өзінде түрмеден еш айырмашылығы жоқ.
Dialogue: 0,1:16:34.67,1:16:38.59,Default,,0,0,0,,Кем дегенде Годар бұл планетаны басқарады...
Dialogue: 0,1:16:39.01,1:16:41.55,Default,,0,0,0,,Лорд Годар, тіпті біз сияқты адамдар үшін.
Dialogue: 0,1:16:41.68,1:16:43.93,Default,,0,0,0,,Маған мейірімді бол
Dialogue: 0,1:16:44.05,1:16:47.31,Default,,0,0,0,,Ол кісі шын мәнінде ұлы тұлға.
Dialogue: 0,1:16:47.89,1:16:51.77,Default,,0,0,0,,Не болса да, үлкен жігіттер ана жақта.
Dialogue: 0,1:16:52.35,1:16:54.31,Default,,0,0,0,,Бұғы сарайында
Dialogue: 0,1:16:59.65,1:17:02.45,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,1:17:03.28,1:17:04.99,Default,,0,0,0,,Ах! (Годард) А...
Dialogue: 0,1:17:06.33,1:17:07.66,Default,,0,0,0,,Түрме?
Dialogue: 0,1:17:08.33,1:17:11.33,Default,,0,0,0,,Сіз тұзаққа түсудің қалай болатынын түсіндіңіз бе?
Dialogue: 0,1:17:12.04,1:17:13.25,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:17:13.50,1:17:17.04,Default,,0,0,0,,Мен сенің осы планета үшін қолыңнан келгеннің барлығын жасауыңды қаладым.
Dialogue: 0,1:17:17.59,1:17:18.84,Default,,0,0,0,,Ешқандай қиындық жоқ.
Dialogue: 0,1:17:19.92,1:17:23.76,Default,,0,0,0,,Сайып келгенде, біз қақтығыс көздерінен басқа ештеңе емеспіз!
Dialogue: 0,1:17:24.01,1:17:25.80,Default,,0,0,0,,Мұны неге білмейсің?
Dialogue: 0,1:17:29.31,1:17:32.98,Default,,0,0,0,,Мен сені жақсы көремін, бірақ мен бұлай туылмадым.
Dialogue: 0,1:17:33.35,1:17:34.85,Default,,0,0,0,,Әкесі мен анасы да
Dialogue: 0,1:17:34.98,1:17:38.19,Default,,0,0,0,,Бізді жасағаныңызға өкінетін шығарсыз.
Dialogue: 0,1:17:39.19,1:17:40.69,Default,,0,0,0,,Лука ағасы
Dialogue: 0,1:17:42.03,1:17:43.24,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:17:45.03,1:17:49.12,Default,,0,0,0,,Ата-бабам сені шаң деп санаған.
Dialogue: 0,1:17:49.62,1:17:51.04,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,1:17:51.87,1:17:52.87,Default,,0,0,0,,Ах
Dialogue: 0,1:17:53.12,1:17:57.04,Default,,0,0,0,,Кейде біз жүрегіміздегі дауыстарды ести аламыз.
Dialogue: 0,1:17:59.00,1:18:00.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:18:04.88,1:18:05.88,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:10.89,1:18:13.85,Default,,0,0,0,,Бұл ұрпақтан-ұрпаққа жалғасып келе жатқан нәрсе.
Dialogue: 0,1:18:15.06,1:18:15.89,Default,,0,0,0,,Иә
Dialogue: 0,1:18:18.56,1:18:19.73,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:20.32,1:18:21.48,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:18:23.24,1:18:24.74,Default,,0,0,0,,Ой
Dialogue: 0,1:18:24.90,1:18:27.20,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,1:18:27.32,1:18:28.41,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:29.24,1:18:31.66,Default,,0,0,0,,Әкең мен анаңды білесің бе?
Dialogue: 0,1:18:32.20,1:18:34.79,Default,,0,0,0,,Мен доктор Годардың ұрпағымын.
Dialogue: 0,1:18:35.12,1:18:38.58,Default,,0,0,0,,Сен туралы ата-бабамыз айтып кеткен.
Dialogue: 0,1:18:39.25,1:18:42.71,Default,,0,0,0,,«Мен сізді ыңғайсыздыққа душар еттім, бірақ қолымнан келсе мұны істейтін едім».
Dialogue: 0,1:18:42.84,1:18:45.55,Default,,0,0,0,,«Мен оны кәдімгі бала сияқты тәрбиелегім келді».
Dialogue: 0,1:18:46.26,1:18:49.01,Default,,0,0,0,,«Эспаль менің өз баламдай болды».
Dialogue: 0,1:18:49.85,1:18:53.01,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,1:18:57.19,1:18:59.48,Default,,0,0,0,,Қаласаңыз, алуға болады.
Dialogue: 0,1:19:01.11,1:19:02.44,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,1:19:02.57,1:19:04.69,Default,,0,0,0,,Бұл оларды бақытты етеді.
Dialogue: 0,1:19:08.24,1:19:11.62,Default,,0,0,0,,Мен тағы бір пайғамбарлық туралы естідім.
Dialogue: 0,1:19:11.95,1:19:12.95,Default,,0,0,0,,Пайғамбарлық?
Dialogue: 0,1:19:14.20,1:19:15.25,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:20.54,1:19:23.46,Default,,0,0,0,,Мен қайда кіремін? Ешқандай кіреберіс жоқ
Dialogue: 0,1:19:23.96,1:19:27.55,Default,,0,0,0,,Мен Лұқа сияқты табиғаттан тыс күштерді қолдана алғым келеді.
Dialogue: 0,1:19:27.67,1:19:31.47,Default,,0,0,0,,Дораемон, табиғаттан тыс күштерді пайдалана алатын құралдар бар ма?
Dialogue: 0,1:19:31.64,1:19:34.43,Default,,0,0,0,,Хмм, бұл рас, бірақ...
Dialogue: 0,1:19:35.14,1:19:37.14,Default,,0,0,0,,Эспер қалпағы!
Dialogue: 0,1:19:37.39,1:19:41.48,Default,,0,0,0,,Егер сіз бұл қалпақшаны қолдансаңыз, сіз үш табиғаттан тыс күшті пайдалана аласыз.
Dialogue: 0,1:19:41.98,1:19:43.11,Default,,0,0,0,,Перспективалық
Dialogue: 0,1:19:43.23,1:19:44.44,Default,,0,0,0,,Телекинез
Dialogue: 0,1:19:44.57,1:19:46.11,Default,,0,0,0,,Телепортация
Dialogue: 0,1:19:46.40,1:19:49.36,Default,,0,0,0,,Керемет! Маған да жасауға рұқсат етіңіз!
Dialogue: 0,1:19:49.49,1:19:53.07,Default,,0,0,0,,Бұл жақсы, бірақ жаттығу жасамайынша меңгере алмайсың.
Dialogue: 0,1:19:53.33,1:19:55.74,Default,,0,0,0,,Жарайды, перспективадан бастайық.
Dialogue: 0,1:19:55.87,1:19:59.00,Default,,0,0,0,,Қара, қара, кіре беріс.
Dialogue: 0,1:19:59.33,1:20:01.00,Default,,0,0,0,,Ммм...нунунуну
Dialogue: 0,1:20:03.04,1:20:06.96,Default,,0,0,0,,Сондықтан бүгінгі күнді мереке деп айтып отырмын.
Dialogue: 0,1:20:07.34,1:20:09.47,Default,,0,0,0,,Бірақ мен қызық, капитан келе ме?
Dialogue: 0,1:20:09.59,1:20:11.97,Default,,0,0,0,,Мен сені өзіммен бірге алып кетемін.
Dialogue: 0,1:20:12.09,1:20:14.01,Default,,0,0,0,,Фуну... Біреу келе жатыр!
Dialogue: 0,1:20:14.14,1:20:16.97,Default,,0,0,0,,Мен S-PAL таптым. Бұл күлкілі емес.
Dialogue: 0,1:20:17.85,1:20:19.98,Default,,0,0,0,,Сонда да, капитан, Осина.
Dialogue: 0,1:20:20.10,1:20:20.94,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:21.06,1:20:22.85,Default,,0,0,0,,Қараңыз, қараңыз
Dialogue: 0,1:20:23.19,1:20:25.36,Default,,0,0,0,,Нобита-кун? Сол ақымақ!
Dialogue: 0,1:20:25.77,1:20:29.11,Default,,0,0,0,,Кіреберіске қара!
Dialogue: 0,1:20:29.61,1:20:32.07,Default,,0,0,0,,Мен көрдім... Иә? Ах
Dialogue: 0,1:20:32.20,1:20:33.99,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,1:20:34.99,1:20:37.99,Default,,0,0,0,,Ах! Бұл жігіт S-PAL-де болды!
Dialogue: 0,1:20:38.12,1:20:39.50,Default,,0,0,0,,Біз мұнда қалай келдік?
Dialogue: 0,1:20:39.75,1:20:42.17,Default,,0,0,0,,Ненене... Телекинез!
Dialogue: 0,1:20:42.62,1:20:44.38,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:20:44.54,1:20:45.88,Default,,0,0,0,,Сәлем Танма!
Dialogue: 0,1:20:46.80,1:20:49.88,Default,,0,0,0,,Бұл жігіт сәтсіздікке ұшырады ма, S-PAL?
Dialogue: 0,1:20:50.22,1:20:52.34,Default,,0,0,0,,Бұл жолы... Хмф!
Dialogue: 0,1:20:53.84,1:20:55.30,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,1:20:56.01,1:20:57.22,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,1:20:57.47,1:20:58.52,Default,,0,0,0,,Не болды!
Dialogue: 0,1:20:58.64,1:21:00.23,Default,,0,0,0,,Әзіл!
Dialogue: 0,1:21:00.73,1:21:02.19,Default,,0,0,0,,Шу… Телепортация!
Dialogue: 0,1:21:02.77,1:21:03.65,Default,,0,0,0,,Фуфуфу!
Dialogue: 0,1:21:04.60,1:21:06.06,Default,,0,0,0,,А... Иә?
Dialogue: 0,1:21:07.40,1:21:09.07,Default,,0,0,0,,Иә? О ла ла ла
Dialogue: 0,1:21:11.32,1:21:12.74,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,1:21:13.07,1:21:15.24,Default,,0,0,0,,Ахх!
Dialogue: 0,1:21:15.95,1:21:17.08,Default,,0,0,0,,Иә? жоғалып кетті
Dialogue: 0,1:21:17.24,1:21:19.41,Default,,0,0,0,,Иә! (2 адам) Хмм... О!
Dialogue: 0,1:21:19.58,1:21:20.41,Default,,0,0,0,,Уф!
Dialogue: 0,1:21:20.83,1:21:23.87,Default,,0,0,0,,Иә! Мен кіреберісті таптым!
Dialogue: 0,1:21:24.25,1:21:25.38,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:21:25.50,1:21:28.84,Default,,0,0,0,,Нәтиже жақсы...
Dialogue: 0,1:21:32.09,1:21:34.26,Default,,0,0,0,,А, тататата...
Dialogue: 0,1:21:38.35,1:21:39.18,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:40.43,1:21:41.27,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,1:21:41.43,1:21:43.10,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,1:21:43.52,1:21:46.10,Default,,0,0,0,,Мен қателессем, мен сені ұрамын!
Dialogue: 0,1:21:46.48,1:21:50.57,Default,,0,0,0,,Ішке бөгде зат кірді ме?
Dialogue: 0,1:21:53.45,1:21:54.95,Default,,0,0,0,,О, жоқ... мүмкін емес
Dialogue: 0,1:21:55.11,1:21:56.03,Default,,0,0,0,,Нигеро!
Dialogue: 0,1:21:58.12,1:21:58.95,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:21:59.08,1:21:59.91,Default,,0,0,0,,Иә!
Dialogue: 0,1:22:03.12,1:22:04.37,Default,,0,0,0,,Иә!
Dialogue: 0,1:22:04.50,1:22:07.21,Default,,0,0,0,,Horizon Tape операциясы сәтті аяқталды!
Dialogue: 0,1:22:07.58,1:22:09.38,Default,,0,0,0,,Сіз қалай ойлайсыз? (Сунео) Жақсы өтті ме?
Dialogue: 0,1:22:09.84,1:22:11.59,Default,,0,0,0,,Ах... бәріңе!
Dialogue: 0,1:22:11.80,1:22:13.38,Default,,0,0,0,,Мен көмектесуге келдім!
Dialogue: 0,1:22:13.51,1:22:15.80,Default,,0,0,0,,Хахаха Джан!
Dialogue: 0,1:22:17.14,1:22:19.97,Default,,0,0,0,,Жылама, Ал, сен керемет істедің.
Dialogue: 0,1:22:20.56,1:22:21.43,Default,,0,0,0,,Нобита!
Dialogue: 0,1:22:21.93,1:22:24.39,Default,,0,0,0,,Мен оның келеді деп ойламаппын...
Dialogue: 0,1:22:24.73,1:22:27.31,Default,,0,0,0,,Мен саған доспыз дедім.
Dialogue: 0,1:22:27.60,1:22:28.65,Default,,0,0,0,,Лұқа!
Dialogue: 0,1:22:28.81,1:22:31.40,Default,,0,0,0,,Мен саған жол сілтеуші едім.
Dialogue: 0,1:22:31.52,1:22:33.32,Default,,0,0,0,,Себебі мен жақсы жүрмін.
Dialogue: 0,1:22:34.44,1:22:35.78,Default,,0,0,0,,Эспалдың досы?
Dialogue: 0,1:22:36.03,1:22:37.78,Default,,0,0,0,,Хмм... О!
Dialogue: 0,1:22:37.91,1:22:40.16,Default,,0,0,0,,Айда бөтен Кагуя қорықты!
Dialogue: 0,1:22:40.33,1:22:41.24,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:22:41.83,1:22:44.91,Default,,0,0,0,,Годарды Диаволо алдап жатыр еді!
Dialogue: 0,1:22:45.16,1:22:49.17,Default,,0,0,0,,Әкем мен шешемнің ұрпағы, біз жақта!
Dialogue: 0,1:22:49.46,1:22:50.92,Default,,0,0,0,,Бұл адам...
Dialogue: 0,1:22:51.04,1:22:52.59,Default,,0,0,0,,Ах
Dialogue: 0,1:22:53.76,1:22:58.13,Default,,0,0,0,,Мың жылдан кейін мен достарыммен билеймін
Dialogue: 0,1:22:58.51,1:23:04.10,Default,,0,0,0,,Мың қоян төгіліп, нұрлы елді қайтарып алады.
Dialogue: 0,1:23:04.56,1:23:06.56,Default,,0,0,0,,Осы пайғамбарлыққа байланысты
Dialogue: 0,1:23:06.69,1:23:09.31,Default,,0,0,0,,Мен Эспалды іздей бердім.
Dialogue: 0,1:23:09.73,1:23:11.19,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:23:11.36,1:23:12.36,Default,,0,0,0,,Хмм.
Dialogue: 0,1:23:12.52,1:23:14.53,Default,,0,0,0,,Тіпті Әлдің өзі түсінбейді.
Dialogue: 0,1:23:14.69,1:23:16.82,Default,,0,0,0,,Мың қоян дегеніміз не?
Dialogue: 0,1:23:16.95,1:23:18.28,Default,,0,0,0,,Бұл S-Pal туралы.
Dialogue: 0,1:23:18.41,1:23:20.49,Default,,0,0,0,,Бар болғаны 11 адам.
Dialogue: 0,1:23:21.03,1:23:23.99,Default,,0,0,0,,Егер сіз пайғамбарлықтың «достары» болсаңыз...
Dialogue: 0,1:23:24.12,1:23:26.25,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:23:26.50,1:23:28.87,Default,,0,0,0,,Фухахахаха!
Dialogue: 0,1:23:29.00,1:23:30.71,Default,,0,0,0,,Ей, сен қирандысың!
Dialogue: 0,1:23:30.88,1:23:33.46,Default,,0,0,0,,Мен Жерден келдім!
Dialogue: 0,1:23:33.59,1:23:34.88,Default,,0,0,0,,Өзіңді көрсет!
Dialogue: 0,1:23:35.21,1:23:36.46,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,1:23:36.59,1:23:38.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:23:38.38,1:23:41.68,Default,,0,0,0,,Сіз жерлессіз бе?
Dialogue: 0,1:23:41.80,1:23:44.89,Default,,0,0,0,,Эспалды алып шығу ыңғайсыз.
Dialogue: 0,1:23:45.14,1:23:46.22,Default,,0,0,0,,Аняру!
Dialogue: 0,1:23:46.39,1:23:50.98,Default,,0,0,0,,Бұл шындық емес. Диаволо жалюзилердің арасында!
Dialogue: 0,1:23:54.90,1:23:55.73,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:56.82,1:23:58.99,Default,,0,0,0,,Енді мен Диаволоны жеңемін!
Dialogue: 0,1:23:59.32,1:24:02.07,Default,,0,0,0,,Ол бар болса, бұл планетаның болашағы жоқ!
Dialogue: 0,1:24:02.74,1:24:03.91,Default,,0,0,0,,Сосын мен де!
Dialogue: 0,1:24:04.62,1:24:06.08,Default,,0,0,0,,Бұл жұлдыз
Dialogue: 0,1:24:06.37,1:24:09.04,Default,,0,0,0,,Өйткені бұл менің әкем мен шешем жақсы көретін жұлдыз
Dialogue: 0,1:24:09.21,1:24:10.33,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:10.54,1:24:13.21,Default,,0,0,0,,Бұл бізді де білдіреді.
Dialogue: 0,1:24:13.38,1:24:15.25,Default,,0,0,0,,Не дедің!
Dialogue: 0,1:24:15.75,1:24:20.05,Default,,0,0,0,,Аль, осында қалып, басқа эспальдарға көмектес.
Dialogue: 0,1:24:20.18,1:24:21.01,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:21.72,1:24:24.01,Default,,0,0,0,,Кеттік! Оу!
Dialogue: 0,1:24:29.18,1:24:30.60,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,1:24:31.14,1:24:32.02,Default,,0,0,0,,Әй!
Dialogue: 0,1:24:35.27,1:24:36.86,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:24:37.11,1:24:37.94,Default,,0,0,0,,Уау!
Dialogue: 0,1:24:40.99,1:24:42.78,Default,,0,0,0,,Хирари плащы!
Dialogue: 0,1:24:46.83,1:24:47.91,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:48.04,1:24:49.79,Default,,0,0,0,,Жасайық, Дораемон!
Dialogue: 0,1:24:49.91,1:24:50.75,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:24:52.46,1:24:54.50,Default,,0,0,0,,Уа! Ешқандай шектеу жоқ
Dialogue: 0,1:24:54.63,1:24:56.13,Default,,0,0,0,,Мен және Сунео осында тоқтаймыз.
Dialogue: 0,1:24:56.29,1:24:56.96,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:57.13,1:24:58.80,Default,,0,0,0,,Барлығы бірінші орында!
Dialogue: 0,1:24:59.30,1:25:00.13,Default,,0,0,0,,Мен мұны сұрадым!
Dialogue: 0,1:25:00.30,1:25:01.59,Default,,0,0,0,,Менің үйімді жинап ал, Сунео!
Dialogue: 0,1:25:01.72,1:25:03.26,Default,,0,0,0,,Үмітсіз!
Dialogue: 0,1:25:08.89,1:25:11.81,Default,,0,0,0,,Дьяволо перделердің артында. Оны жалғыз қалдырмаңыз.
Dialogue: 0,1:25:17.15,1:25:19.48,Default,,0,0,0,,Бұл шайқас, Диаволо! Шығу!
Dialogue: 0,1:25:19.69,1:25:22.99,Default,,0,0,0,,Хмф, бұл әсерлі, Годар.
Dialogue: 0,1:25:23.15,1:25:25.82,Default,,0,0,0,,Мен оны әйеліме кәдесый ретінде беремін.
Dialogue: 0,1:25:25.95,1:25:28.45,Default,,0,0,0,,Менің пішінім!
Dialogue: 0,1:25:30.16,1:25:31.00,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:37.09,1:25:37.92,Default,,0,0,0,,Бұл...
Dialogue: 0,1:25:39.71,1:25:41.84,Default,,0,0,0,,Ди... Диаволо жоқ!
Dialogue: 0,1:25:42.05,1:25:46.09,Default,,0,0,0,,Фухахахахаха!
Dialogue: 0,1:25:56.77,1:25:59.15,Default,,0,0,0,,Мен Диаволомын!
Dialogue: 0,1:25:59.52,1:26:01.23,Default,,0,0,0,,На... кесілген бас!
Dialogue: 0,1:26:01.36,1:26:02.44,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:26:02.82,1:26:06.11,Default,,0,0,0,,Мен жойылу құдайымын
Dialogue: 0,1:26:06.53,1:26:09.16,Default,,0,0,0,,Жою – менің міндетім!
Dialogue: 0,1:26:09.87,1:26:12.91,Default,,0,0,0,,Түсіндім! Диаволоның шынайы тұлғасы
Dialogue: 0,1:26:13.04,1:26:16.21,Default,,0,0,0,,Бұл жасанды интеллекті бар машина болды!
Dialogue: 0,1:26:16.33,1:26:19.13,Default,,0,0,0,,Жою қаруының өзі шығар!
Dialogue: 0,1:26:19.67,1:26:21.75,Default,,0,0,0,,Жарайсың!
Dialogue: 0,1:26:21.88,1:26:25.13,Default,,0,0,0,,Осы жұлдыздың айын жойған адам болса керек
Dialogue: 0,1:26:25.26,1:26:27.55,Default,,0,0,0,,Менің шығармаларым
Dialogue: 0,1:26:28.22,1:26:30.05,Default,,0,0,0,,О, құдай!
Dialogue: 0,1:26:30.68,1:26:34.56,Default,,0,0,0,,Бізді 1000 жыл бойы осындай нәрсе биледі ме?
Dialogue: 0,1:26:35.06,1:26:36.52,Default,,0,0,0,,Кагуя планетасының адамдарынан
Dialogue: 0,1:26:36.64,1:26:38.19,Default,,0,0,0,,Сіз бұл планетаны ұрладыңыз ба?
Dialogue: 0,1:26:38.31,1:26:41.52,Default,,0,0,0,,Жоқ, Убау күлкілі.
Dialogue: 0,1:26:42.11,1:26:45.65,Default,,0,0,0,,Мені Кагуя жат планеталықтар жасаған.
Dialogue: 0,1:26:45.99,1:26:50.74,Default,,0,0,0,,Мысықтың қиялы жойылуды тудырды.
Dialogue: 0,1:26:51.49,1:26:54.70,Default,,0,0,0,,Эспалдың күші де бірдей.
Dialogue: 0,1:26:55.12,1:26:56.37,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:26:56.71,1:27:00.67,Default,,0,0,0,,Қиял – болашақ! Бұл адамдарға қамқорлық жасау туралы!
Dialogue: 0,1:27:01.21,1:27:03.92,Default,,0,0,0,,Елестетуден бас тартқан кезде
Dialogue: 0,1:27:04.09,1:27:05.59,Default,,0,0,0,,Жою туды!
Dialogue: 0,1:27:05.92,1:27:06.93,Default,,0,0,0,,Дамар!
Dialogue: 0,1:27:07.05,1:27:10.22,Default,,0,0,0,,Эфир - менің қаным! Бұл ет!
Dialogue: 0,1:27:10.35,1:27:14.60,Default,,0,0,0,,Жеткізуге кедергі келтіретін адам - ​​Юру-сан!
Dialogue: 0,1:27:21.98,1:27:23.82,Default,,0,0,0,,Ах... уау
Dialogue: 0,1:27:24.28,1:27:25.78,Default,,0,0,0,,О! Нобита-кун!
Dialogue: 0,1:27:26.28,1:27:27.86,Default,,0,0,0,,Мазалама!
Dialogue: 0,1:27:29.28,1:27:30.45,Default,,0,0,0,,Уау!
Dialogue: 0,1:27:30.66,1:27:32.45,Default,,0,0,0,,Уф...
Dialogue: 0,1:27:33.03,1:27:34.62,Default,,0,0,0,,Менде доп таусылды!
Dialogue: 0,1:27:34.74,1:27:36.12,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:27:37.12,1:27:38.92,Default,,0,0,0,,Не? Конняро!
Dialogue: 0,1:27:39.83,1:27:41.13,Default,,0,0,0,,Уау!
Dialogue: 0,1:27:43.38,1:27:44.63,Default,,0,0,0,,Робот!
Dialogue: 0,1:27:44.80,1:27:46.80,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,1:27:47.13,1:27:50.76,Default,,0,0,0,,Фухахахахаха!
Dialogue: 0,1:27:58.64,1:28:03.15,Default,,0,0,0,,Дора-чанның құралдары күткендей, сызаттардың көпшілігі жазылды.
Dialogue: 0,1:28:03.65,1:28:06.36,Default,,0,0,0,,Ара жоқ~
Dialogue: 0,1:28:06.48,1:28:08.49,Default,,0,0,0,,Нобит-чан, сен не істеп жатырсың?
Dialogue: 0,1:28:08.61,1:28:09.78,Default,,0,0,0,,Жоқ! Үлкен!
Dialogue: 0,1:28:09.90,1:28:10.91,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:12.12,1:28:13.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:14.91,1:28:17.20,Default,,0,0,0,,Сонда да бұл біртүрлі белгі.
Dialogue: 0,1:28:19.33,1:28:22.71,Default,,0,0,0,,Онсыз қоян патшалығы да, моовиттер де болмас еді.
Dialogue: 0,1:28:22.83,1:28:24.50,Default,,0,0,0,,Мен оны енді көре алмаймын
Dialogue: 0,1:28:25.09,1:28:26.50,Default,,0,0,0,,Мм... Ах!
Dialogue: 0,1:28:27.42,1:28:28.46,Default,,0,0,0,,Нобит-чан!
Dialogue: 0,1:28:29.01,1:28:31.93,Default,,0,0,0,,Неліктен сен өзіңді ғана көре аласың?
Dialogue: 0,1:28:34.10,1:28:35.93,Default,,0,0,0,,Сол белгі...
Dialogue: 0,1:28:37.64,1:28:40.85,Default,,0,0,0,,Нобит-чан, сіз төсбелгіңізді алып тастай аласыз ба?
Dialogue: 0,1:28:45.11,1:28:46.27,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:46.57,1:28:48.11,Default,,0,0,0,,Әбекөбе…
Dialogue: 0,1:28:49.07,1:28:51.20,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:52.70,1:28:53.70,Default,,0,0,0,,Шизука-сан!
Dialogue: 0,1:28:54.24,1:28:56.08,Default,,0,0,0,,Жәндіктер туралы дабыл!
Dialogue: 0,1:28:56.87,1:28:59.95,Default,,0,0,0,,Қатты! Бірақ мен не істеуім керек ...
Dialogue: 0,1:29:00.79,1:29:01.62,Default,,0,0,0,,Ха!
Dialogue: 0,1:29:06.29,1:29:09.55,Default,,0,0,0,,Не?!
Dialogue: 0,1:29:10.34,1:29:12.63,Default,,0,0,0,,Мақтан тұт
Dialogue: 0,1:29:12.76,1:29:17.22,Default,,0,0,0,,Мен сенің денеңді тараймын және оларды өзімнің бір бөлшегіме айналдырамын.
Dialogue: 0,1:29:17.56,1:29:18.81,Default,,0,0,0,,Тарақ?
Dialogue: 0,1:29:18.93,1:29:20.02,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:24.23,1:29:25.98,Default,,0,0,0,,Сол Косаку Каваджири, иіліп-жығылып, жалтақтайды.
Dialogue: 0,1:29:26.27,1:29:27.61,Default,,0,0,0,,Бұл әзіл емес!
Dialogue: 0,1:29:27.73,1:29:29.90,Default,,0,0,0,,Мен машиналарды жек көремін!
Dialogue: 0,1:29:30.23,1:29:32.61,Default,,0,0,0,,S-Pal мен басқаларын қайда жібердің!
Dialogue: 0,1:29:33.61,1:29:35.32,Default,,0,0,0,,Espal?
Dialogue: 0,1:29:35.66,1:29:38.28,Default,,0,0,0,,Егер бұл Espal болса, ол осында.
Dialogue: 0,1:29:38.41,1:29:40.91,Default,,0,0,0,,Менің етім мен қаным бол.
Dialogue: 0,1:29:41.54,1:29:43.58,Default,,0,0,0,,Не?!
Dialogue: 0,1:29:53.05,1:29:54.26,Default,,0,0,0,,Лұқа!
Dialogue: 0,1:29:54.59,1:29:55.72,Default,,0,0,0,,Al!
Dialogue: 0,1:29:56.05,1:29:57.89,Default,,0,0,0,,Ах~
Dialogue: 0,1:29:58.01,1:30:01.39,Default,,0,0,0,,1000 жылдағы алғашқы эфир соншалықты өзгеше
Dialogue: 0,1:30:01.68,1:30:03.52,Default,,0,0,0,,Мен сізге қайта ораламын!
Dialogue: 0,1:30:03.64,1:30:06.27,Default,,0,0,0,,Олар Луканың эфирін ұрлап жатыр.
Dialogue: 0,1:30:06.44,1:30:08.86,Default,,0,0,0,,Біз оны тез тоқтатуымыз керек... Иә?
Dialogue: 0,1:30:09.52,1:30:11.07,Default,,0,0,0,,Қалта жоқ!
Dialogue: 0,1:30:11.28,1:30:14.57,Default,,0,0,0,,Бұл сіз іздеп жүрген нәрсе ме?
Dialogue: 0,1:30:16.28,1:30:18.28,Default,,0,0,0,,А... Мен білмей тұрып!
Dialogue: 0,1:30:18.53,1:30:21.45,Default,,0,0,0,,Соңғы сөздер бар ма?
Dialogue: 0,1:30:21.95,1:30:25.75,Default,,0,0,0,,Кагуя планетасының адамдары сізді бір күні бұрышқа салады!
Dialogue: 0,1:30:25.92,1:30:28.96,Default,,0,0,0,,Машина ретінде мен ұялдым!
Dialogue: 0,1:30:29.50,1:30:31.63,Default,,0,0,0,,Мен оны жұлып алғым келді
Dialogue: 0,1:30:31.80,1:30:34.80,Default,,0,0,0,,«Ошиши кәменнің» соңғы бөлімін оқымадым.
Dialogue: 0,1:30:34.97,1:30:36.09,Default,,0,0,0,,Мама!
Dialogue: 0,1:30:36.59,1:30:38.68,Default,,0,0,0,,Уақыт толы
Dialogue: 0,1:30:38.97,1:30:40.05,Default,,0,0,0,,Жаса!
Dialogue: 0,1:30:44.27,1:30:46.94,Default,,0,0,0,,Уау...
Dialogue: 0,1:30:47.69,1:30:49.15,Default,,0,0,0,,Ах!
Dialogue: 0,1:30:49.44,1:30:51.15,Default,,0,0,0,,Дораемон, бірдеңе істе!
Dialogue: 0,1:30:51.32,1:30:53.11,Default,,0,0,0,,Мен осылай дедім!
Dialogue: 0,1:30:53.36,1:30:55.07,Default,,0,0,0,,Неге мұны жасап жатырсың?!
Dialogue: 0,1:30:55.82,1:30:59.32,Default,,0,0,0,,Антигектермен қоштасу!
Dialogue: 0,1:31:00.03,1:31:01.99,Default,,0,0,0,,Лұқа!
Dialogue: 0,1:31:02.16,1:31:04.33,Default,,0,0,0,,Мың жылдан кейін
Dialogue: 0,1:31:04.50,1:31:06.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:31:06.12,1:31:08.79,Default,,0,0,0,,Достармен билеу
Dialogue: 0,1:31:09.67,1:31:11.25,Default,,0,0,0,,Не, не... Бұл қандай дауыс?
Dialogue: 0,1:31:11.42,1:31:12.25,Default,,0,0,0,,Ах!
Dialogue: 0,1:31:12.38,1:31:14.80,Default,,0,0,0,,Мың қоян сепкен
Dialogue: 0,1:31:16.13,1:31:18.68,Default,,0,0,0,,Жарық елін қайтарыңыз!
Dialogue: 0,1:31:18.97,1:31:20.01,Default,,0,0,0,,Al!
Dialogue: 0,1:31:20.47,1:31:21.47,Default,,0,0,0,,Пайғамбарлық!
Dialogue: 0,1:31:22.51,1:31:23.85,Default,,0,0,0,,Хмм?
Dialogue: 0,1:31:35.74,1:31:38.20,Default,,0,0,0,,Ара!
Dialogue: 0,1:31:40.49,1:31:41.66,Default,,0,0,0,,Moobit!?
Dialogue: 0,1:31:42.03,1:31:44.04,Default,,0,0,0,,Нобиби!
Dialogue: 0,1:31:44.54,1:31:46.00,Default,,0,0,0,,Нобибибибибі…
Dialogue: 0,1:31:46.20,1:31:47.62,Default,,0,0,0,,Нобби!
Dialogue: 0,1:31:51.71,1:31:52.71,Default,,0,0,0,,Мұғат
Dialogue: 0,1:31:54.25,1:31:56.38,Default,,0,0,0,,Му~Ғаби~!
Dialogue: 0,1:31:56.55,1:31:59.18,Default,,0,0,0,,Барлығына! Мен көмектесуге келдім.
Dialogue: 0,1:32:00.22,1:32:02.55,Default,,0,0,0,,Ахх!
Dialogue: 0,1:32:04.47,1:32:05.81,Default,,0,0,0,,Мугаби!
Dialogue: 0,1:32:06.81,1:32:07.93,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:32:08.06,1:32:09.44,Default,,0,0,0,,Луна-чан! Луна!
Dialogue: 0,1:32:09.56,1:32:11.56,Default,,0,0,0,,Moovits туралы не деуге болады?
Dialogue: 0,1:32:11.94,1:32:13.73,Default,,0,0,0,,Бұл жақсы белгіленген төсбелгі!
Dialogue: 0,1:32:13.94,1:32:16.53,Default,,0,0,0,,Қалыптасқан теория әлеміне келуге бола ма?
Dialogue: 0,1:32:17.15,1:32:19.15,Default,,0,0,0,,Басқа әлемнен?
Dialogue: 0,1:32:19.28,1:32:21.07,Default,,0,0,0,,Иә! Сондықтан
Dialogue: 0,1:32:21.20,1:32:23.07,Default,,0,0,0,,Moovits де күресе алады!
Dialogue: 0,1:32:23.24,1:32:25.08,Default,,0,0,0,,Би-би-би-би!
Dialogue: 0,1:32:25.20,1:32:27.58,Default,,0,0,0,,Уф! Б-б-б-б-б-б-б-б-б
Dialogue: 0,1:32:27.79,1:32:29.08,Default,,0,0,0,,Муби~би!
Dialogue: 0,1:32:30.41,1:32:32.58,Default,,0,0,0,,Уф! Үлкен! Ммм! Үлкен!
Dialogue: 0,1:32:32.75,1:32:34.88,Default,,0,0,0,,Ммммм… мммммм
Dialogue: 0,1:32:38.46,1:32:39.76,Default,,0,0,0,,Фильм!
Dialogue: 0,1:32:43.30,1:32:44.26,Default,,0,0,0,,Бибі!
Dialogue: 0,1:32:44.39,1:32:46.10,Default,,0,0,0,,Ммм... ммм...
Dialogue: 0,1:32:46.26,1:32:47.35,Default,,0,0,0,,Бит!
Dialogue: 0,1:32:47.47,1:32:49.23,Default,,0,0,0,,Фильм
Dialogue: 0,1:32:51.35,1:32:52.19,Default,,0,0,0,,Бит!
Dialogue: 0,1:32:53.10,1:32:54.11,Default,,0,0,0,,Бибі!
Dialogue: 0,1:32:56.27,1:32:58.03,Default,,0,0,0,,Бибібибі...
Dialogue: 0,1:32:59.78,1:33:00.86,Default,,0,0,0,,Виви!
Dialogue: 0,1:33:01.28,1:33:03.36,Default,,0,0,0,,Хм~
Dialogue: 0,1:33:04.12,1:33:05.12,Default,,0,0,0,,Ха!
Dialogue: 0,1:33:10.83,1:33:12.29,Default,,0,0,0,,Виви!
Dialogue: 0,1:33:14.33,1:33:15.54,Default,,0,0,0,,Лұқа!
Dialogue: 0,1:33:16.04,1:33:16.88,Default,,0,0,0,,Луна!
Dialogue: 0,1:33:17.00,1:33:20.88,Default,,0,0,0,,Ннуну, не істеп жатырсың, Аэтермутер...
Dialogue: 0,1:33:21.01,1:33:22.30,Default,,0,0,0,,Гах... Гваа!
Dialogue: 0,1:33:23.13,1:33:25.22,Default,,0,0,0,,Муға~би!
Dialogue: 0,1:33:26.47,1:33:28.26,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:33:28.60,1:33:29.97,Default,,0,0,0,,Керемет (Сунео) Керемет
Dialogue: 0,1:33:30.14,1:33:32.56,Default,,0,0,0,,Маған тек қалтам керек...
Dialogue: 0,1:33:32.69,1:33:34.73,Default,,0,0,0,,Қалта осында!
Dialogue: 0,1:33:35.27,1:33:36.11,Default,,0,0,0,,Мозо!
Dialogue: 0,1:33:36.23,1:33:39.15,Default,,0,0,0,,Бұған жол берме!
Dialogue: 0,1:33:40.48,1:33:42.28,Default,,0,0,0,,Менің аяғымның жылдамдығы...
Dialogue: 0,1:33:42.49,1:33:43.74,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,1:33:44.07,1:33:45.16,Default,,0,0,0,,Бұл да!
Dialogue: 0,1:33:45.70,1:33:47.07,Default,,0,0,0,,Йо (Годард)
Dialogue: 0,1:33:47.20,1:33:48.08,Default,,0,0,0,,Әй!
Dialogue: 0,1:33:49.24,1:33:51.58,Default,,0,0,0,,Көтеріліс басталады! Оу!
Dialogue: 0,1:33:52.71,1:33:54.00,Default,,0,0,0,,～
Dialogue: 0,1:33:54.42,1:33:56.00,Default,,0,0,0,,Хирари плащы!
Dialogue: 0,1:33:57.84,1:33:58.92,Default,,0,0,0,,Бум!
Dialogue: 0,1:34:00.34,1:34:01.59,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,1:34:04.51,1:34:05.51,Default,,0,0,0,,Эй!
Dialogue: 0,1:34:06.84,1:34:08.76,Default,,0,0,0,,Магнит тарту!
Dialogue: 0,1:34:09.18,1:34:12.18,Default,,0,0,0,,Кез келген нәрсені тартыңыз!
Dialogue: 0,1:34:13.23,1:34:14.69,Default,,0,0,0,,Джан!
Dialogue: 0,1:34:14.85,1:34:16.81,Default,,0,0,0,,Al! Барайық!
Dialogue: 0,1:34:16.94,1:34:17.69,Default,,0,0,0,,Иә!
Dialogue: 0,1:34:18.02,1:34:19.27,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:34:19.40,1:34:22.11,Default,,0,0,0,,Бое! По!
Dialogue: 0,1:34:22.49,1:34:24.24,Default,,0,0,0,,Хмф! Ха!
Dialogue: 0,1:34:24.36,1:34:26.20,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,1:34:27.20,1:34:28.03,Default,,0,0,0,,Ах
Dialogue: 0,1:34:28.70,1:34:29.53,Default,,0,0,0,,Қолдар!
Dialogue: 0,1:34:30.20,1:34:31.20,Default,,0,0,0,,Ах!
Dialogue: 0,1:34:32.95,1:34:33.95,Default,,0,0,0,,Міне!
Dialogue: 0,1:34:35.87,1:34:36.87,Default,,0,0,0,,Бұл тек алдын алу тексерісі ғана
Dialogue: 0,1:34:44.30,1:34:45.55,Default,,0,0,0,,Нобби Нобби
Dialogue: 0,1:34:45.67,1:34:47.51,Default,,0,0,0,,Nnnnnnu~!
Dialogue: 0,1:34:48.14,1:34:50.47,Default,,0,0,0,,Егер бұл орын алса, тіпті бір таңдау болса да...
Dialogue: 0,1:34:50.60,1:34:51.64,Default,,0,0,0,,Ха!
Dialogue: 0,1:34:52.64,1:34:53.47,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:53.72,1:34:54.89,Default,,0,0,0,,Бум!
Dialogue: 0,1:34:55.02,1:34:56.19,Default,,0,0,0,,Кя!
Dialogue: 0,1:34:56.44,1:34:59.15,Default,,0,0,0,,Жоқ! Уф...
Dialogue: 0,1:34:59.61,1:35:00.52,Default,,0,0,0,,Луна!
Dialogue: 0,1:35:00.65,1:35:03.48,Default,,0,0,0,,Фухахаха! Мен оны ұнатпаймын!
Dialogue: 0,1:35:03.61,1:35:04.90,Default,,0,0,0,,Луна-чан!
Dialogue: 0,1:35:05.07,1:35:08.03,Default,,0,0,0,,Мұны бәріне қалдырыңыз, біз жоғарыда боламыз!
Dialogue: 0,1:35:08.41,1:35:09.41,Default,,0,0,0,,Иә!
Dialogue: 0,1:35:10.62,1:35:12.08,Default,,0,0,0,,Мен оны сұрадым!
Dialogue: 0,1:35:16.46,1:35:18.00,Default,,0,0,0,,Құрметті сарай!
Dialogue: 0,1:35:19.75,1:35:22.17,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:24.00,1:35:27.01,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:35:29.22,1:35:30.68,Default,,0,0,0,,және басқа да байланыс құралдарын—өшіріп, сол үстелге қойыңыз.
Dialogue: 0,1:35:47.78,1:35:48.95,Default,,0,0,0,,Ах!
Dialogue: 0,1:35:55.49,1:35:57.37,Default,,0,0,0,,Бұл жою қаруы...
Dialogue: 0,1:35:58.46,1:35:59.75,Default,,0,0,0,,Луна ішінде!
Dialogue: 0,1:35:59.87,1:36:04.04,Default,,0,0,0,,Фухахахаха! Енді Кагуя планетасының пайдасы жоқ.
Dialogue: 0,1:36:04.17,1:36:07.30,Default,,0,0,0,,Әрі қарай, сіз сол планетаны басқарасыз.
Dialogue: 0,1:36:07.51,1:36:08.80,Default,,0,0,0,,Бұл жұлдыз?
Dialogue: 0,1:36:08.97,1:36:09.97,Default,,0,0,0,,Бұл Жер.
Dialogue: 0,1:36:10.13,1:36:11.14,Default,,0,0,0,,Е!
Dialogue: 0,1:36:11.47,1:36:14.22,Default,,0,0,0,,Маған рұқсат етіңіз! (Сунео) Луна-чан!
Dialogue: 0,1:36:16.64,1:36:18.89,Default,,0,0,0,,Takecopter қуып жете алмайды
Dialogue: 0,1:36:19.23,1:36:21.81,Default,,0,0,0,,Фухахахахаха!
Dialogue: 0,1:36:22.23,1:36:24.36,Default,,0,0,0,,Бұлтқа тығылсаң, бітті!
Dialogue: 0,1:36:24.48,1:36:26.32,Default,,0,0,0,,Бірдеңе істе, Дораемон!
Dialogue: 0,1:36:26.57,1:36:28.28,Default,,0,0,0,,Мен осылай дедім!
Dialogue: 0,1:36:28.40,1:36:31.78,Default,,0,0,0,,Қош болыңдар, ақымақтар!
Dialogue: 0,1:36:32.07,1:36:34.99,Default,,0,0,0,,Иә? Ооо... неге қозғалмайды!
Dialogue: 0,1:36:35.24,1:36:36.58,Default,,0,0,0,,Бұл жарық...
Dialogue: 0,1:36:37.29,1:36:38.50,Default,,0,0,0,,Ах!
Dialogue: 0,1:36:38.95,1:36:42.33,Default,,0,0,0,,～
Dialogue: 0,1:36:43.00,1:36:44.34,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:36:44.63,1:36:46.84,Default,,0,0,0,,Шатаспаңыз!
Dialogue: 0,1:36:47.00,1:36:49.84,Default,,0,0,0,,Ол Кагуя планетасын да суға батырады!
Dialogue: 0,1:36:52.34,1:36:54.26,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,1:36:55.35,1:36:56.18,Default,,0,0,0,,Луна!
Dialogue: 0,1:36:56.39,1:36:57.43,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:36:58.35,1:37:01.52,Default,,0,0,0,,Ауа шарлары жақсы емес! Осы сияқты көбірек...
Dialogue: 0,1:37:01.64,1:37:03.19,Default,,0,0,0,,Нобиби! Нобиби!
Dialogue: 0,1:37:03.56,1:37:04.69,Default,,0,0,0,,Нови~
Dialogue: 0,1:37:04.81,1:37:07.98,Default,,0,0,0,,Менің қабығым - әлемдегі ең қатты
Dialogue: 0,1:37:08.11,1:37:09.74,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,1:37:10.61,1:37:11.61,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:21.66,1:37:23.04,Default,,0,0,0,,Өл!
Dialogue: 0,1:37:23.62,1:37:25.46,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:25.58,1:37:27.67,Default,,0,0,0,,Луна!
Dialogue: 0,1:37:28.13,1:37:29.13,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:29.88,1:37:30.71,Default,,0,0,0,,Ах
Dialogue: 0,1:37:45.06,1:37:47.06,Default,,0,0,0,,Бұл қандай жарық?
Dialogue: 0,1:37:47.40,1:37:48.23,Default,,0,0,0,,Мен оны көрдім!
Dialogue: 0,1:37:48.65,1:37:49.90,Default,,0,0,0,,Лука Пауэр!
Dialogue: 0,1:37:50.36,1:37:51.36,Default,,0,0,0,,Иә!
Dialogue: 0,1:37:54.07,1:37:55.99,Default,,0,0,0,,Жүр!
Dialogue: 0,1:37:56.12,1:37:57.32,Default,,0,0,0,,Бум!
Dialogue: 0,1:37:57.74,1:37:59.87,Default,,0,0,0,,Тасбақа!
Dialogue: 0,1:38:04.50,1:38:06.42,Default,,0,0,0,,Ой... аа!
Dialogue: 0,1:38:09.38,1:38:10.75,Default,,0,0,0,,Иә!
Dialogue: 0,1:38:11.05,1:38:14.09,Default,,0,0,0,,Мен бұл мен болады деп күтпедім.
Dialogue: 0,1:38:14.26,1:38:16.59,Default,,0,0,0,,Адамдар сияқты...
Dialogue: 0,1:38:16.76,1:38:18.01,Default,,0,0,0,,Арх!
Dialogue: 0,1:38:26.40,1:38:27.69,Default,,0,0,0,,Луна-чан!
Dialogue: 0,1:38:27.81,1:38:30.36,Default,,0,0,0,,Гррр... Луна-чан!
Dialogue: 0,1:38:30.86,1:38:33.03,Default,,0,0,0,,Луна-чан... аа
Dialogue: 0,1:38:33.15,1:38:34.28,Default,,0,0,0,,Сунео-сан!
Dialogue: 0,1:38:34.61,1:38:37.36,Default,,0,0,0,,Мен ұша алмаймын.
Dialogue: 0,1:38:37.49,1:38:39.45,Default,,0,0,0,,Бит Nobi Bit
Dialogue: 0,1:38:39.62,1:38:41.74,Default,,0,0,0,,Қояндар да мұны жақсы жасайды.
Dialogue: 0,1:38:53.96,1:38:55.80,Default,,0,0,0,,Ах...
Dialogue: 0,1:38:56.63,1:38:57.64,Default,,0,0,0,,Уау!
Dialogue: 0,1:39:03.85,1:39:05.73,Default,,0,0,0,,Муға~
Dialogue: 0,1:39:10.56,1:39:11.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:39:12.82,1:39:13.82,Default,,0,0,0,,Ах
Dialogue: 0,1:39:15.32,1:39:17.49,Default,,0,0,0,,Жарық елі
Dialogue: 0,1:39:23.12,1:39:25.41,Default,,0,0,0,,Дәл қазір бұл жарық жер бетінде не болды?
Dialogue: 0,1:39:25.95,1:39:28.83,Default,,0,0,0,,Бұл Пикаригокте емес пе?
Dialogue: 0,1:39:29.17,1:39:30.67,Default,,0,0,0,,Тіпті оның есту қабілетінен айырылғаны туралы қауесет те бар
Dialogue: 0,1:39:31.13,1:39:32.63,Default,,0,0,0,,Аа, бұл рас!
Dialogue: 0,1:39:33.13,1:39:36.38,Default,,0,0,0,,Менікінен өзгеше, бірақ мүк тәрізді өсімдік.
Dialogue: 0,1:39:36.51,1:39:38.22,Default,,0,0,0,,Эфирмен әрекеттеседі
Dialogue: 0,1:39:38.34,1:39:40.59,Default,,0,0,0,,Ол жарылыс болып көбейді.
Dialogue: 0,1:39:41.22,1:39:43.10,Default,,0,0,0,,Неліктен бұл ...
Dialogue: 0,1:39:43.64,1:39:45.56,Default,,0,0,0,,Менің ойымша, ол мұны істеді.
Dialogue: 0,1:39:45.68,1:39:46.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:39:47.23,1:39:49.44,Default,,0,0,0,,1000 жылдан кейін доктор Годар және т.б
Dialogue: 0,1:39:49.56,1:39:52.23,Default,,0,0,0,,Лұқа мен басқалардың қайтып келетінін білдіңіз бе?
Dialogue: 0,1:39:52.52,1:39:55.11,Default,,0,0,0,,Сонда менің жеңілденуім керек еді.
Dialogue: 0,1:39:55.78,1:39:58.53,Default,,0,0,0,,Жұлдыз Кагуя өзінің жарығын қайта ала алуы үшін
Dialogue: 0,1:39:59.20,1:40:00.57,Default,,0,0,0,,Джунби…
Dialogue: 0,1:40:06.41,1:40:08.37,Default,,0,0,0,,Бұл Нобитаның тіскебасарымен бірдей.
Dialogue: 0,1:40:09.21,1:40:10.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:11.21,1:40:12.21,Default,,0,0,0,,Лұқа
Dialogue: 0,1:40:13.88,1:40:15.00,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,1:40:15.34,1:40:17.80,Default,,0,0,0,,Осы планетада бізбен бірге өмір сүргіңіз келе ме?
Dialogue: 0,1:40:17.97,1:40:18.97,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:24.30,1:40:26.39,Default,,0,0,0,,Рахмет, бірақ...
Dialogue: 0,1:40:26.89,1:40:30.27,Default,,0,0,0,,Бізді аңыз ретінде қалдырыңыз.
Dialogue: 0,1:40:30.39,1:40:31.23,Default,,0,0,0,,Не!
Dialogue: 0,1:40:31.56,1:40:34.73,Default,,0,0,0,,А... Жарайды.
Dialogue: 0,1:40:35.36,1:40:38.28,Default,,0,0,0,,Еспалды көрген басқа адамдар бар...
Dialogue: 0,1:40:38.40,1:40:41.24,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,1:40:41.53,1:40:43.41,Default,,0,0,0,,Мен таптым!
Dialogue: 0,1:40:43.53,1:40:46.20,Default,,0,0,0,,Жер бетінде не болып жатыр?
Dialogue: 0,1:40:47.12,1:40:48.87,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,1:40:49.75,1:40:54.04,Default,,0,0,0,,Құрметті жауынгерлер! Тек осында кел!
Dialogue: 0,1:40:54.17,1:40:55.25,Default,,0,0,0,,Ал...
Dialogue: 0,1:40:55.84,1:40:57.59,Default,,0,0,0,,Мені ұмыт!
Dialogue: 0,1:40:57.88,1:40:59.55,Default,,0,0,0,,Сәлем! (2 адам) А...?
Dialogue: 0,1:41:00.22,1:41:02.55,Default,,0,0,0,,Эспал – мифтік тіршілік иесі.
Dialogue: 0,1:41:02.68,1:41:04.93,Default,,0,0,0,,Шынында да жай ғана адам
Dialogue: 0,1:41:05.10,1:41:06.10,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,1:41:06.26,1:41:08.77,Default,,0,0,0,,S-Pal жай ғана бейтаныс адам
Dialogue: 0,1:41:10.10,1:41:12.14,Default,,0,0,0,,Осы шөптің иісін сезсеңіз
Dialogue: 0,1:41:12.27,1:41:14.73,Default,,0,0,0,,S-PAL көру жадын өшіруге болады!
Dialogue: 0,1:41:15.40,1:41:18.03,Default,,0,0,0,,Түсіндім, мен де...
Dialogue: 0,1:41:18.15,1:41:19.19,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:41:20.40,1:41:24.32,Default,,0,0,0,,Бізді тек сен ғана еске аласың
Dialogue: 0,1:41:24.91,1:41:26.41,Default,,0,0,0,,Және бір күні
Dialogue: 0,1:41:27.12,1:41:29.62,Default,,0,0,0,,Маған бай Кагуя планетасын көрсетіңіз
Dialogue: 0,1:41:29.95,1:41:30.79,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:33.96,1:41:35.21,Default,,0,0,0,,ашуланшақ
Dialogue: 0,1:41:35.46,1:41:39.00,Default,,0,0,0,,Сеніміңізге мен де жауап беремін.
Dialogue: 0,1:41:39.59,1:41:40.63,Default,,0,0,0,,Содан кейін
Dialogue: 0,1:41:41.13,1:41:42.38,Default,,0,0,0,,Достық үшін!
Dialogue: 0,1:41:42.51,1:41:44.09,Default,,0,0,0,,Ах!
Dialogue: 0,1:41:51.52,1:41:52.56,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,1:41:52.89,1:41:55.40,Default,,0,0,0,,Нобит-чанның барлық жердегі құралдары.
Dialogue: 0,1:41:55.52,1:41:56.48,Default,,0,0,0,,Нобиби!
Dialogue: 0,1:41:56.86,1:42:00.98,Default,,0,0,0,,Әртүрлі теориялар әлемінен қалыптасқан теория әлеміне қалай келуге болады?
Dialogue: 0,1:42:01.24,1:42:03.45,Default,,0,0,0,,Мүмкін Новит данышпан шығар?
Dialogue: 0,1:42:03.99,1:42:06.41,Default,,0,0,0,,Менің басымнан өткен жайттар бар.
Dialogue: 0,1:42:06.99,1:42:08.83,Default,,0,0,0,,Маған бәрібір...
Dialogue: 0,1:42:09.37,1:42:11.50,Default,,0,0,0,,Кішкентай!
Dialogue: 0,1:42:11.66,1:42:12.83,Default,,0,0,0,,Мугаби?
Dialogue: 0,1:42:16.83,1:42:18.38,Default,,0,0,0,,О, керемет естіледі!
Dialogue: 0,1:42:18.75,1:42:19.75,Default,,0,0,0,,Өтінемін?
Dialogue: 0,1:42:20.25,1:42:22.51,Default,,0,0,0,,Кагуя планетасы туралы басқа теория болды.
Dialogue: 0,1:42:23.01,1:42:25.59,Default,,0,0,0,,Эспал – мифтік тіршілік иесі.
Dialogue: 0,1:42:25.80,1:42:28.18,Default,,0,0,0,,Оның шын мәнінде жай адам екендігі туралы теория
Dialogue: 0,1:42:28.85,1:42:33.56,Default,,0,0,0,,Қартайып, қалыпты түрде өлетін табиғаттан тыс күштері жоқ адамдар
Dialogue: 0,1:42:33.68,1:42:35.19,Default,,0,0,0,,Біз болғымыз келеді!
Dialogue: 0,1:42:36.06,1:42:39.15,Default,,0,0,0,,Біздің бидғатымызды шындыққа айналдыр!
Dialogue: 0,1:42:39.36,1:42:40.40,Default,,0,0,0,,Иә!?
Dialogue: 0,1:42:40.52,1:42:43.03,Default,,0,0,0,,Мен өз күштерімді жоғалтып алсам болады ма?
Dialogue: 0,1:42:43.19,1:42:45.61,Default,,0,0,0,,Сіз мәңгі өмір сүре алатын болсаңыз да?
Dialogue: 0,1:42:46.20,1:42:47.82,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:42:48.28,1:42:50.95,Default,,0,0,0,,Сіздің күшіңіз шектеулі, сондықтан бар күшіңізді салыңыз.
Dialogue: 0,1:42:51.16,1:42:53.91,Default,,0,0,0,,Бұл керемет, өйткені өмір шектеулі.
Dialogue: 0,1:42:54.54,1:42:57.79,Default,,0,0,0,,Барлығымен кездескеннен кейін осылай ойладым.
Dialogue: 0,1:42:58.46,1:43:00.88,Default,,0,0,0,,Мовицтер жасағандай
Dialogue: 0,1:43:01.04,1:43:03.21,Default,,0,0,0,,Айдың артқы жағындағы осы жерде
Dialogue: 0,1:43:03.38,1:43:06.01,Default,,0,0,0,,Біз де отбасымызбен әлем құрғымыз келеді.
Dialogue: 0,1:43:07.89,1:43:10.18,Default,,0,0,0,,Дораемон Иә
Dialogue: 0,1:43:10.76,1:43:12.72,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,1:43:13.64,1:43:17.19,Default,,0,0,0,,Иә
Dialogue: 0,1:43:18.02,1:43:21.40,Default,,0,0,0,,Эспал – аты аңызға айналған тіршілік иесі...
Dialogue: 0,1:43:22.69,1:43:25.03,Default,,0,0,0,,Адамдар бізге ұнайды
Dialogue: 0,1:43:27.78,1:43:28.82,Default,,0,0,0,,Ах!
Dialogue: 0,1:43:29.49,1:43:30.53,Default,,0,0,0,,Ах...
Dialogue: 0,1:43:31.24,1:43:33.45,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:43:34.54,1:43:37.04,Default,,0,0,0,,Ах... хаха
Dialogue: 0,1:43:45.42,1:43:46.42,Default,,0,0,0,,Рахмет
Dialogue: 0,1:43:46.92,1:43:48.76,Default,,0,0,0,,Сізге жақсы Лука
Dialogue: 0,1:43:48.97,1:43:50.93,Default,,0,0,0,,Нобита-кун?
Dialogue: 0,1:43:51.09,1:43:54.26,Default,,0,0,0,,Лұқа мен оның достары бейбіт өмір сүруі үшін.
Dialogue: 0,1:43:54.43,1:43:58.06,Default,,0,0,0,,Ешкімге таппағаны жақсы.
Dialogue: 0,1:43:58.44,1:43:59.90,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:44:00.19,1:44:02.27,Default,,0,0,0,,Исецу клубы - Кай-сан!
Dialogue: 0,1:44:02.44,1:44:05.86,Default,,0,0,0,,Бұл сіздің төсбелгіңізден қазір бас тартуыңыз керек дегенді білдіреді.
Dialogue: 0,1:44:06.15,1:44:07.57,Default,,0,0,0,,Иә!?
Dialogue: 0,1:44:07.69,1:44:09.24,Default,,0,0,0,,Енді бір-бірімізді көрмейміз бе?
Dialogue: 0,1:44:09.36,1:44:10.86,Default,,0,0,0,,Міне!
Dialogue: 0,1:44:21.25,1:44:23.96,Default,,0,0,0,,Ән айту жаттығуын жалғастыру
Dialogue: 0,1:44:24.34,1:44:25.38,Default,,0,0,0,,Уф...
Dialogue: 0,1:44:27.13,1:44:27.97,Default,,0,0,0,,Иә!
Dialogue: 0,1:44:28.42,1:44:30.93,Default,,0,0,0,,Мен Сунео мырзаны ешқашан ұмытпаймын.
Dialogue: 0,1:44:31.05,1:44:32.93,Default,,0,0,0,,Мен де!
Dialogue: 0,1:44:33.39,1:44:35.35,Default,,0,0,0,,Қош бол, Нобит-чан
Dialogue: 0,1:44:35.47,1:44:36.72,Default,,0,0,0,,Нобби!
Dialogue: 0,1:44:36.85,1:44:38.39,Default,,0,0,0,,Муғаби~
Dialogue: 0,1:44:38.73,1:44:41.48,Default,,0,0,0,,Жарайды, өйткені мен сенімен біргемін!
Dialogue: 0,1:44:41.65,1:44:42.81,Default,,0,0,0,,Хехехе
Dialogue: 0,1:44:44.15,1:44:45.32,Default,,0,0,0,,Нобита
Dialogue: 0,1:44:46.48,1:44:47.61,Default,,0,0,0,,Лұқа
Dialogue: 0,1:44:49.49,1:44:51.28,Default,,0,0,0,,Бұл көңілді болды.
Dialogue: 0,1:44:52.32,1:44:55.66,Default,,0,0,0,,Менің досым болғаның үшін рахмет
Dialogue: 0,1:44:56.49,1:44:59.25,Default,,0,0,0,,Мен сені айдан бері қараймын
Dialogue: 0,1:45:01.67,1:45:03.46,Default,,0,0,0,,Миста, бізді аңдап жүрген жоқ па?
Dialogue: 0,1:45:03.92,1:45:07.17,Default,,0,0,0,,Белгіңізді жоғалтып алсаңыз да, менімен әрқашан кездесе аласыз.
Dialogue: 0,1:45:07.96,1:45:11.76,Default,,0,0,0,,Бізде қиял бар!
Dialogue: 0,1:45:12.22,1:45:13.39,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:14.80,1:45:15.80,Default,,0,0,0,,Иә!
Dialogue: 0,1:45:16.93,1:45:18.97,Default,,0,0,0,,Луна-чан! (Нобита) Сау болыңыз!
Dialogue: 0,1:45:19.10,1:45:21.44,Default,,0,0,0,,Сонда кездескенше! Қош бол!
Dialogue: 0,1:45:21.56,1:45:23.27,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:45:26.77,1:45:29.53,Default,,0,0,0,,Ай мен жер қашан болады
Dialogue: 0,1:45:29.69,1:45:32.32,Default,,0,0,0,,Күнге дейін біз әдеттегідей келіп-кетеміз.
Dialogue: 0,1:45:33.20,1:45:34.57,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,1:45:47.63,1:45:52.17,Default,,0,0,0,,Ай зонды Nayotake-мен байланыс бірнеше күннен бері үзілген.
Dialogue: 0,1:45:52.63,1:45:54.51,Default,,0,0,0,,Керемет түрде қалпына келтірілді
Dialogue: 0,1:45:54.63,1:45:56.14,Default,,0,0,0,,Нобита
Dialogue: 0,1:45:56.34,1:45:59.14,Default,,0,0,0,,О? Қызық, ол әлдеқашан шығып кетті ме?
Dialogue: 0,1:46:06.48,1:46:07.56,Default,,0,0,0,,Хехе
Dialogue: 0,1:46:09.57,1:46:10.73,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,1:46:11.28,1:46:12.74,Default,,0,0,0,,Уа (Сунео) Йотто
Dialogue: 0,1:46:15.28,1:46:17.49,Default,,0,0,0,,Иә?
Dialogue: 0,1:46:17.82,1:46:19.33,Default,,0,0,0,,Ах!
Dialogue: 0,1:46:19.91,1:46:22.00,Default,,0,0,0,,Сенпай, тоқта!
Dialogue: 0,1:46:22.41,1:46:24.33,Default,,0,0,0,,Қатты! Мен қиналамын
Dialogue: 0,1:46:24.46,1:46:25.79,Default,,0,0,0,,Өл… жоқ, әйелім мен арбашы қазірдің өзінде қайтыс болды.
Dialogue: 0,1:46:26.29,1:46:28.96,Default,,0,0,0,,А, сәл күте тұрыңыз!
Dialogue: 0,1:46:36.47,1:46:41.47,Default,,0,0,0,,♪～
Dialogue: 0,1:49:53.12,1:49:58.13,Default,,0,0,0,,～♪
Dialogue: 0,1:49:59.63,1:50:05.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory